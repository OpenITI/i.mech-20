ms1691	 ( قولي حين تصبحين : سبحان الله وبحمده ، ولا حول ولا قوة إلا بالله ، ما شاء الله كان ، وما لم يشأ لم يكن ، أعلم أن الله على كل شيء قدير ، وأن الله قد أحاط بكل شيء علما ، فإنه من قالهن حين يصبح حفظ حتى يمسي ، ومن قالهن حين يمسي حفظ حتى يصبح ) )(@)(@@) ( د ) عن بعض بنات النبي ( ز ) .(@)(@@) PageV05P370(@)(@@)(@@)(@@) $ ( 15404 ) قال النبي :(@)(@@) | 30 ( قولي : سبحان الله عدد ما خلق من شيء ) )(@)(@@) ( طب ك ) عن صفية رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 15405 ) قال النبي :(@)(@@) | 30 ( قولي عند آذان المغرب : اللهم هاذا إقبال ليلك ، وإدبار نهارك ، وأصوات دعاتك ، وحضور صلواتك ، أسألك أن تغفر لي ) )(@)(@@) ( ت ) و ابن السني ، ( طب ك هق ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 15406 ) قال النبي :(@)(@@) | 30 ( قولي : لبيك اللهم لبيك ، ومحلي من الأرض حيث تحبسني ، فإن لك على ربك ما استثنيت ) )(@)(@@) ( ن ) عن ابن عباس ، ( حم ) عن ضباعة رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 15407 ) قال النبي :(@)(@@) | 30 ( قوموا إلى جنة عرضها السماوات والأرض ) )(@)(@@) ( حم م ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15408 ) قال النبي :(@)(@@) | 30 ( قوموا إلى سيدكم ) )(@)(@@) ( د ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15409 ) قال النبي :(@)(@@) | 30 ( قوموا فإن للموت فزعا ) )(@)(@@) ( حم ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15410 ) قال النبي :(@)(@@) | 30 ( قوموا لا ترقدوا في المسجد ) )(@)(@@) ( عب ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15411 ) قال النبي :(@)(@@) | 30 ( قولوا خيرا ، قولوا : سبحان الله وبحمده ، فبالواحدة عشرة ، وبالعشرة مائة ، وبالمائة ألف ، ومن زاد زاده الله ، ومن استغفر PageV05P371 غفر الله له ، ومن حالت شفاعته دون حد من حدود الله فقد ضاد الله في ملكه ، ومن أعان على خصومة من غير علم كان في سخط الله حتى ينزع ، ومن بهت مؤمنا أو مؤمنة حبسه الله في ردغة الخبال حتى يأتي بمخرج مما قال ، ومن مات وعليه دين أخذ من حسناته ، ليس ثم دينار ولا درهم ، حافظوا على ركع 2 تي الفجر فإن فيهما رغب الدهر ) )(@)(@@) ( خط 
ms1692	 ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15412 ) قال النبي :(@)(@@) | 30 ( قولوا : اللهم صل على محمد وعلى آل محمد كما صليت على إبراهيم ، وبارك على محمد كما باركت على إبراهيم في العالمين إنك حميد مجيد ، والسلام كما قد علمتم ) )(@)(@@) ( عد ) عن محمد بن عبد الله بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15413 ) قال النبي :(@)(@@) | 30 ( قولوا : اللهم اجعل صلواتك ورحمتك وبركاتك على محمد وعلى آل محمد كما جعلتها على إبراهيم إنك حميد مجيد ) )(@)(@@) ( م ) عن بريدة رضي الله عنه وضعف .(@)(@@)(@@)(@@) |||| ( المنق ط ع )(@)(@@)(@@)(@@) $ ( 15414 ) قال النبي :(@)(@@) | 30 ( ضح بالشاة وتصدق بالدينار ) )(@)(@@) ( د ت ) غريب منقطع ( قط طب ) عن حكيم بن حزام أن رسول الله بعثه يشتري له أضحية بدينار فاشترى أضحيته فربح فيها دينارا فاشترى أخرى مكانها ، فجاء بالأضحية والدينار إلى رسول الله فقال فذكره .(@)(@@)(@@)(@@) $ ( 15415 ) قال النبي :(@)(@@) | 30 ( قولوا : لا إلاه إلا الله والله أكبر ، وسبحان الله ، والحمد لله ، وتبارك الله ، فإنهن خمس لا يعدلهن شيء ، عليهن فطر الله ملائكته ، ومن أجلهن رفع سماءه ، ودحى أرضه ، وبهن جبل إنسه وجنه وفرض عليهم فرائضه ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15416 ) قال النبي :(@)(@@) | 30 ( قولوا : بارك الله لكم وبارك عليكم ) )(@)(@@) الرافعي عن الحسن PageV05P372 عن رجل من الصحابة قال : كنا نقول في الجاهلية : بالرفاء والبنين ، فلما جاء الإسلام علمنا نبينا فقال فذكره .(@)(@@)(@@)(@@) $ ( 15417 ) قال النبي :(@)(@@) | 30 ( قولوا : وعليكم ) )(@)(@@) ( د ) عن أنس رضي الله عنه أنهم قالوا : يا رسول الله إن أهل الكتاب يسلمون علينا فكيف نرد عليهم ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 15418 ) قال النبي :(@)(@@) | 30 ( قولوا : ما شاء الله ثم شئت ، وقولوا : ورب الكعبة ) )(@)(@@) ( ك ) عن قبيلة بنت صيفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15419 ) قال النبي :(@)(@@) | 30 ( قولوا لهم كما يقولون لكم ) )(@)(@@) ( طب ) عن عمار قال : لما هجانا المشركون شكونا إلى رسول الله قال : فذكره .(@)(@@)(@@)(@@) $ ( 15420 ) قال النبي :(@)(@@) | 30 ( قولوا لا رد الله عليك ضالتك ) )(@)(@@) ( طب ) عن عصمة بن مالك قال : نشد رجل ضالته في المسجد فقال رسول الله : فذكره .(@)(@@)(@@)(@@) $ ( 15421 ) قال النبي :(@)(@@) | 30 ( قولي الله 
ms1693	 أكبر عشر مرار ، يقول الله : هاذا لي ، وقولي : سبحان الله عشر مرار ، يقول الله : هاذا لي ، هاذا لي ، وقولي : اللهم اغفر لي ، يقول : قد فعلت ، فتقولين عشر مرار ، ويقول قد فعلت ) )(@)(@@) ( طب ) عن سلمى امرأة أبي رافع رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15422 ) قال النبي :(@)(@@) | 30 ( قولي : اللهم اغفر لي ذنوبي وخطاياي ، وعمدي وإسرافي في أمري ، إنك إن لا تغفر لي تهلكني ) )(@)(@@) ( هب ) عن عبد الأعلى التميمي قال : قالت خديجة بنت خويلد : يا رسول الله ما أقول وأنا أطوف بالبيت ؟ قال : فذكره وقال : هاكذا جاء مرسلا .(@)(@@)(@@)(@@) $ ( 15423 ) قال النبي :(@)(@@) | 30 ( قولي لها : فلتدع الصلاة في كل شهر أيام قرئها ثم لتغتسل في كل يوم غسلا واحدا ثم الطهور عند كل صلاة ، ولتنظف ولتحتش فإنما هوذا عرض أو ركضة من الشيطان ، أو عرق انقطع ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@) PageV05P373(@)(@@)(@@)(@@) $ ( 15424 ) قال النبي :(@)(@@) | 30 ( قولي : الله أكبر مائة مرة فهو خير لك من مائة بدنة مجللة متقبلة ، وقولي : الحمد لله مائة مرة ، فإنه خير لك من مائة فرس مسرجة ملجمة حملتها في سبيل الله ، وقولي : سبحان الله مائة مرة فهو خير لك من مائة رقبة من بني إسماعيل تعتقين لله عز وجل ، وقولي : لا إلاه إلا الله لا يدركك ذنب ولا يسبقه العمل ) )(@)(@@) ( حم ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15425 ) قال النبي :(@)(@@) | 30 ( قولي : اللهم إني أهل بالحج إن أذنت لي به وأعنتني عليه ويسرته لي ، وإن حبستني فعمرة ، وإن حبستني عنهما جميعا فمحلي حيث حبستني ) )(@)(@@) ( هق ) عن ضباعة بنت الزبير رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15426 ) قال النبي :(@)(@@) | 30 ( قولي : اللهم رب السماوات السبع ورب العرش العظيم ، ربنا ورب كل شيء ، منزل التوراة والإنجيل والقرآن ، فالق الحب والنوى ، أعوذ بك من شر كل شيء أنت آخذ بناصيته ، أنت الأول فليس قبلك شيء ، وأنت الآخر فليس بعدك شيء ، وأنت الظاهر فليس فوقك شيء ، وأنت الباطن فليس دونك شيء ، اقض عني الدين وأغنني من الفقر ) )(@)(@@) ( ت ) حسن غريب ( ه حب ) عن أبي هريرة رضي الله 
ms1694	 عنه قال : جاءت فاطمة إلى النبي تسأله خادما فقال فذكره .(@)(@@)(@@)(@@) $ ( 15427 ) قال النبي :(@)(@@) | 30 ( قولي : اللهم إنك عفو تحب العفو فاعف عني ) )(@)(@@) ( ت ) حسن صحيح ( ه ك ) عن عائشة رضي الله عنها قالت : قلت : يا رسول الله إن علمت ليلة القدر ما أقول فيها ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 15428 ) قال النبي :(@)(@@) | 30 ( قولي : سبحان الله مائة مرة تعدل مائة رقبة تعتق لله عز وجل ، واحمدي الله مائة مرة تعدل مائة فرس ملجم يحمل عليها في سبيل الله ، وكبري الله مائة مرة تعدل مائة بدنة مقلدة تهدى إلى بيت الله ، ووحدي الله PageV05P374 مائة مرة لا يدركك ذنب بعد الشرك ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15429 ) قال النبي :(@)(@@) | 30 ( قولي : اللهم رب النبي محمد اغفر لي ذنبي ، وأذهب غيظ قلبي ، وأجرني من مضلات الفتن ) )(@)(@@) الخرائطي في اعتلال القلوب عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15430 ) قال النبي :(@)(@@) | 30 ( قوموا إلى سيدكم ) )(@)(@@) ( خ م ط د طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15431 ) قال النبي :(@)(@@) | 30 ( قوموا فاضربوه بنعالكم ) )(@)(@@) ( طب ) عن عبد الرحمن بن أزهر قال : أتي رسول الله بشارب يوم حنين قال : فذكره .(@)(@@)(@@)(@@) ||| ( القاف مع الياء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15432 ) قال النبي :(@)(@@) | 30 ( قيام الليل فريضة على حامل القرآن ولو ركعتين ) )(@)(@@) ( فر ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15433 ) قال النبي :(@)(@@) | 30 ( قيام ساعة في الصف للقتال في سبيل الله خير من قيام ستين سنة ) )(@)(@@) ( عد ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15434 ) قال النبي :(@)(@@) | 30 ( قيل لبني إسرائيل ادخلوا الباب سجدا ، وقولوا حطة ، فبدلوا فدخلوا يزحفون على أستاههم وقالوا حبة في شعيرة ) )(@)(@@) ( حم ق د ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15435 ) قال النبي :(@)(@@) | 30 ( قيلوا فإن الشياطين لا تقيل ) )(@)(@@) ( طس ) و أبو نعيم في الطب عن أنس رضي الله عنه .(@)(@@) PageV05P375(@)(@@)(@@)(@@) $ ( 15436 ) قال النبي :(@)(@@) | 30 ( قيد وتوكل ) )(@)(@@) ( هب ) عن عمرو بن أمية الضمري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15437 ) قال النبي :(@)(@@) | 30 ( قيدوا العلم بالكتاب ) )(@)(@@) الحكيم 
ms1695	 وسمويه عن أنس ( طب ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15438 ) قال النبي :(@)(@@) | 30 ( قيدها وتوكل ) )(@)(@@) ( خط ) في رواه مالك ، و ابن عساكر ، عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 15439 ) قال النبي :(@)(@@) | 30 ( قيم الدين الصلاة ، وسنام العمل الجهاد ، وأفضل أخلاق الإسلام الصمت حتى يسلم الناس منك ) )(@)(@@) ابن المبارك عن وهب بن منبه مرسلا ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15440 ) قال النبي :(@)(@@) | 30 ( قيام المرء مع أخيه المسلم أفضل من اعتكاف سنة في المسجد ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15441 ) قال النبي :(@)(@@) | 30 ( قيس فرسان الناس يوم الملاحم ، واليمن حي الإسلام ) )(@)(@@) نعيم بن حماد في الفتن عن الأوزاعي بلاغا .(@)(@@)(@@)(@@) $ ( 15442 ) قال النبي :(@)(@@) | 30 ( قيل لي : يا محمد لتنم عينك ، ولتسمع أذنك ، وليع قلبك ، فنامت عيني ، ووعى قلبي ، وسمعت أذني ) )(@)(@@) ابن سعد عن أبي بكر بن عبد الله بن أبي مريم مرسلا .(@)(@@)(@@)(@@) $ ( 15443 ) قال النبي :(@)(@@) | 30 ( قيل لي : لتنم عينك ، وليعقل قلبك ، ولتسمع أذنك ، فنامت عيني ، وعقل قلبي ، وسمعت أذني ، ثم قيل : سيد بنى دارا ، ثم صنع مأدبة وأرسل داعيا ، فمن أجاب الداعي دخل الدار ، وأكل من المأدبة ، ورضي عنه السيد ، ومن لم يجب الداعي ، لم يدخل الدار ، ولم يأكل من PageV05P376 المأدبة ، ولم يرض عنه السيد ، فالله : السيد ، والدار : الإسلام ، والمأدبة : الجنة ، والداعي : محمد ) )(@)(@@) ابن جرير عن أبي قلابة مرسلا ( طب ) عن أبي قلابة عن عطية عن ربيعة الجرشي رضي الله عنه .(@)(@@)(@@)(@@) ||| ( أقضية النبي(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15444 ) قضى النبي :(@)(@@) | 30 ( في سيل مهزور ، الأعلى فوق الأسفل ، يسقى الأعلى إلى الكعبين ، ثم يرسل إلى من هو أسفل منه ) )(@)(@@) ( ه ) عن محمد بن عقبة بن أبي مالك عن عمه ثعلبة بن أبي مالك عن أبيه ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15445 ) قضى النبي :(@)(@@) | 30 ( في سيل مهزور أن يمسك الماء حتى يبلغ الكعبين ، ثم يرسل الأعلى على الأسفل ) )(@)(@@) ( ه د ) عن عمرو بن شعيب عن أبيه عن جده ( طب ) عن عامر بن ربيعة ( عب )