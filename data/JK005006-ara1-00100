ms81	 بن أبي سليمان ( 4 ) عن أبي حنيفة لم يذكر فيه سعدا . PageV01P325(@)(@@) 495 - حديث : ( ^ عسى أن يبعثك ربك مقاما محمودا . . ) ( 1 ) الحديث ( 2 ) .(@)(@@) تفرد به عبد العزيز بن صهيب ( 3 ) عن مصعب عن أبيه . وتفرد به أبو حنيفة عنه .(@)(@@) وتفرد به أحمد بن الحريث النهدي عن محمد بن الحسن ( 4 ) عن أبي حنيفة .(@)(@@) 496 - حديث : ( ( من دعا بدعاء يونس استجيب له . . ) ) الحديث ( 5 ) . PageV01P326(@)(@@) تفرد به المطلب بن عبد الله بن حنطب ( 1 ) عن مصعب .(@)(@@) وتفرد به أبو خالد الأحمر عن كثير بن زيد .(@)(@@) وتفرد به كثير عن المطلب .(@)(@@) 497 - حديث : ( ( أنه ( . . . ) ( 2 ) له فضلا على من دونه . . ) ) الحديث .(@)(@@) غريب من حديث رشيد عن طلحة بن مصرف عنه .(@)(@@) تفرد به محمد بن حميد الرازي ( 3 ) ولم يجود إسناده عنه غير محمد بن إسحاق الصاغاني .(@)(@@) 498 - حديث : ( ( إن في الجنة أعناق الخيل . . ) ) الحديث .(@)(@@) 499 - حديث : ( ( بناء الجنة لبنة من ذهب . . ) ) الحديث ( 4 ) .(@)(@@) تفرد بهما الحسن بن كثير عن عباد بن صهيب عن مسعر عن عبد PageV01P327 الملك بن ميسرة ( 1 ) عن مصعب .(@)(@@) 500 - حديث : ( ( قال رسول الله عليكم بالرمي . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به يحيى بن حماد ، عن أبي عوانة ، عن عبد الملك ، عنه مرفوعا .(@)(@@) 501 - حديث : ( ( خيركم من تعلم القرآن وعلمه . . ) ) الحديث ( 3 ) . PageV01P328(@)(@@) غريب من حديث عاصم بن أبي النجود عن مصعب .(@)(@@) تفرد به الحارث بن نبهان .(@)(@@) 502 - حديث : ( ( المؤمن يطبع على الخلال كلها غير الخيانة . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به إبراهيم الحربي عن عبد الله بن عمر عن أبي داود ، عن الثوري ، عن سلمة ، عن مصعب ، عن أبيه مرفوعا . والمحفوظ عن الثوري ، وشعبة ، عن سلمة موقوفا ورفعه أبو شيبة عن سلمة ( 2 ) . PageV01P329(@)(@@) ورواه أبو إسحاق السبيعي ، عن مصعب وهو غريب من حديثه عنه .(@)(@@) وغريب من حديث الأعمش عن أبي إسحاق .(@)(@@) تفرد به علي بن هاشم ولا نعلم حدث به غير داود بن رشيد ( 1 ) .(@)(@@) 503 - حديث : جاء رجل إلى النبي فقال : ( ( إن القرآن قد أعياني . . ) ) الحديث .(@)(@@) غريب من حديث مسعر ، عن مصعب ، عن أبيه 
ms82	 .(@)(@@) تفرد به سلم بن أبي كريمة عنه .(@)(@@) 504 - حديث : ( ( قال رسول الله / الدنيا ( 2 ) حلوة رطبة . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به زيد بن الحباب عن الثوري عن الزبير بن عدي عن مصعب .(@)(@@) 505 - حديث : ( ( أنزل على رسول الله القرآن فتلاه عليكم . . ) ) الحديث .(@)(@@) تفرد به جلاد بن مسلم الصفار عن عمرو بن قيس عن عمرو بن مرة عنه . PageV01P330(@)(@@) | [ عمر ( 1 ) بن سعد ( 2 ) عن أبيه ](@)(@@) 506 - حديث : إن رسول الله قال : ( ( لو كنت متخذا خليلا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به حيوية واسمه إسحاق بن إسماعيل ( 4 ) ، عن محمد بن أبان ، عن ابن إسحاق ، عن العيزار بن حريث ( 5 ) عن عمرو ( 6 ) . PageV01P331(@)(@@) | سعيد بن المسيب ( 1 ) عن سعد(@)(@@) 507 - حديث : ( ( أنت مني بمنزلة هارون من موسى . . ) ) الحديث ( 2 ) . PageV01P332(@)(@@) غريب من حديث عثمان بن المغيرة الثقفي ( 1 ) وهو أبو المغيرة وهو عثمان بن أبي زرعة وهو عثمان الأعشى عن علي بن زيد بن جدعان ( 2 ) .(@)(@@) تفرد به علي بن عابس عنه .(@)(@@) ورواه قتادة عن سعيد ، وتفرد به جعفر بن سليم عن حرب بن شداد عن قتاده ( 3 ) . PageV01P333(@)(@@) 508 - حديث : ( ( كنا مع رسول الله في بقيع الخيل ( 1 ) فأقبل العباس . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به أبو سهيل بن مالك ( 3 ) عن شعبة عن سعد ولم يروه عنه غير محمد بن PageV01P334 طلحة الطويل ( 1 ) التيمي المدني . وروي عن مالك ولا يصح عنه ( 2 ) .(@)(@@) 509 - حديث : ( ( أنه كان يسافر من الكوفة إلى مكة فلا يجمع . . ) ) الحديث .(@)(@@) غريب من حديث سعيد عنه .(@)(@@) تفرد به يزيد بن الله بن قسيط ( 3 ) عنه .(@)(@@) وتفرد به الزبير بن بكار ( 4 ) عن عامر بن عمرو عن مسور بن عبد الملك ( 5 ) عن يزيد . PageV01P335(@)(@@) | عبد الله بن مليل ( 1 ) عن سعد(@)(@@) 510 - حديث : قابل ( 2 ) أبا معاوية فقال له : ( ( ما منعك أن تخرج معنا . . ) ) الحديث .(@)(@@) وفيه : ( ( أنت مني بمنزلة هارون من موسى ) ) ( 3 ) .(@)(@@) غريب من حديث كثير بن قاروندا ( 4 ) ( النوا ) ( 5 ) أبي إسماعيل الكوفي عن عبد الله بن مليل عن سعد .(@)(@@) تفرد به عمرو 
ms83	 بن القاسم بن حبيب التمار عنه ولم يروه عنه غير عباد بن يعقوب .(@)(@@) | عبد الرحمن بن دينار عن سعد(@)(@@) 511 - حديث : ( ( رفع أهل الكوفة إلى عمر أن سعد لا يحسن ( أن ) ( 6 ) يصلي . . ) ) الحديث ( 7 ) . PageV01P336(@)(@@) تفرد به حفص بن / غياث عن الحسن بن عبيد الله عنه .(@)(@@) | عبد الرحمن بن صالح الحنفي عن سعد(@)(@@) 512 - حديث : ( ( دعا سعد بضعة عشر رجلا . . ) ) الحديث .(@)(@@) وفيه : ( إنما ) ( . . . ) ( 1 ) عن عبد الرحمن ) ) .(@)(@@) تفرد به ياسين الزيات ( 2 ) عن سعيد بن مسروق عن أبي صالح الحنفي .(@)(@@) | عبيد الله بن أبي نهيك عن سعد(@)(@@) 513 - حديث : ( ( ابكوا فإن لم تبكوا فتباكوا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به السري بن عاصم عن سفيان بن عيينة عن عمرو بن دينار عن ابن أبي مليكة عن عبيد الله .(@)(@@) 514 - حديث : ( ( ليس منا من لم يتغن بالقرآن . . ) ) الحديث ( 4 ) . PageV01P337(@)(@@) تفرد به يزيد بن زريع ( 1 ) عن روح بن القاسم عن عمرو بن دينار عن ابن أبي مليكة عنه . PageV01P338(@)(@@) | علقمة عن سعد(@)(@@) 515 - حديث : ( ( علمنا رسول الله الصلاة . . ) ) الحديث ( 1 ) .(@)(@@) وفيه ذكر سعد .(@)(@@) قال : غريب من حديث علقمة عن سعد .(@)(@@) تفرد به عبد الله بن إدريس ( 2 ) عن عاصم بن كليب ( 3 ) عن عبد الرحمن بن الأسود ( 4 ) عن علقمة . PageV01P339(@)(@@) | عائشة أم المؤمنين ( 1 ) عن سعد(@)(@@) 516 - حديث : أنها سمعت النبي يقول : ( ( للوزغ ( 2 ) فويسق . . ) ) الحديث ( 3 ) .(@)(@@) قال : تفرد به يحيى بن أبي أنيسة ( 4 ) ، عن الزهري ، عن عروة عنها ، عن سعد بن أبي وقاص .(@)(@@) | عائشة ( 5 ) بنت سعد عن أبيها(@)(@@) 517 - حدث : ( ( ما بين مصلاي ومسجدي . . ) ) الحديث ( 6 ) .(@)(@@) غريب من حديث سعد عن النبي . تفرد به صالح بن حسين السواق ( 7 ) عن PageV01P340 أبيه عن هياج مولى ليلى ( . . . . ) ( 1 ) بنت سهل وكان نجارا قال : كنت عند عائشة ولم يكن حسين بن صالح يروي غير هذا الحديث .(@)(@@) ورواه محمد بن عوف الحمصي ( 2 ) عن الحسن بن صالح بن حسين بن صالح السواق عن أبيه وقال ابن عوف لم يكن عنده غير هذا الحديث وكانت ( الرحلة 
ms84	 البندقية ) ( 3 ) .(@)(@@) 518 - حديث : ( ( أكثر زهر ( 4 ) أهل الجنة الخيري . . ) ) ( 5 ) الحديث .(@)(@@) غريب من حديث القاسم بن معين عن أخته أمينة عن عائشة .(@)(@@) 519 - حديث : ( ( كان رسول الله إذا أخذ طريق المنزع أهل . . ) ) الحديث ( 7 ) .(@)(@@) تفرد به محمد بن إسحاق عن أبي الزناد عنها .(@)(@@) 520 - حديث : ( ( من قرأ ( ^ قل هو الله أحد ) . . . ) ) الحديث ( 7 ) .(@)(@@) تفرد به سعد بن محمد عن المسور ( 8 ) عن عائشة .(@)(@@) ولم يروه عنه غير زكريا بن عطية . PageV01P341(@)(@@) | / مسند سعيد ( 1 ) طلحة بن عبيد الله بن عوف ( 2 ) عن سعيد(@)(@@) 521 - حديث : ( ( من قتل دون ماله فهو شهيد . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به حسين بن سعيد بن أبي الجهم عن أبيه عن أبي أيوب الإفريقي واسمه عبد الله بن علي ( 4 ) عن صفوان بن سليم ( 5 ) عن الزهري عنه . PageV01P342(@)(@@) | سعيد بن المسيب عن سعيد(@)(@@) 522 - حديث : ( ( عشرة في الجنة . . ) ) الحديث ( 1 ) .(@)(@@) غريب من حديث ابن المسيب عنه ومن حديث قتادة عن سعيد .(@)(@@) تفرد به ابن أبي عروبة عنه .(@)(@@) وعنه عباد بن صهيب ولا نعلم حدث به غير محمد بن خلاد ولم نكتبه إلا عن شيخنا أبي بكر محمد بن موسى البربهاري ( 2 ) .(@)(@@) | عبد الرحمن بن عمرو بن سهل ( 3 ) عن سعيد(@)(@@) 523 - حديث : ( ( من ظلم ( ( شيئا ) ) من الأرض . . ) ) الحديث ( 4 ) . PageV01P343(@)(@@) تفرد به يحيى بن عبد الله بن سالم ( 1 ) ، عن عبيد الله بن عمر ، عن الزهري ، عن طلحة بن عوف ، عن عبد الرحمن .(@)(@@) | عبد الرحمن بن الأخنس ( 2 ) عن سعيد(@)(@@) 524 - حديث : ( ( قال رسول الله أبو بكر في الجنة . . ) ) الحديث ( 3 ) . PageV01P344(@)(@@) تفرد به الحسن بن أبي جعفر ( 1 ) عن محمد بن جحادة ( 2 ) عن الحر بن الصباح ( 3 ) عن عبد الرحمن .(@)(@@) ورواه الحجاج بن أرطأة عن الحر .(@)(@@) وتفرد به أبو شهاب عنه .(@)(@@) | عمرو بن حريث عن سعيد(@)(@@) 525 - حديث : ( ( عشرة في الجنة . . ) ) الحديث ( 4 ) . PageV01P345(@)(@@) غريب من حديث عبد الله بن عمير عن عمرو عنه تفرد به أبو قتادة عبد الله بن واقد الحراني عن أبي حنيفة عنه .(@)(@@) | نوفل 
ms85	 بن مساحق ( 1 ) عن سعيد(@)(@@) 526 - حديث : ( ( إن من أربا الربا استطالة المرء في عرض أخيه . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث صالح بن كيسان ( 3 ) لم نكتبه إلا عن أبي محمد بن الصلت بهذا الإسناد . PageV01P346(@)(@@) | مسند عبد الرحمن سعد بن أبي وقاص عن عبد الرحمن(@)(@@) 527 - حديث : ( ( إن عمر رجع بالناس من ( شرع ) . . ) ) الحديث .(@)(@@) غريب من حديث الزهري عن إسحاق بن مالك بن أوس عن سعيد .(@)(@@) تفرد به يزيد بن أبي ( مسكنة ) .(@)(@@) ولم يروه عنه غير عبد الله / بن لهيعة من رواية عبد الرحمن بن سعيد بن أبي أيوب عنه .(@)(@@) | المسور بن مخرمة ( 1 ) عن عبد الرحمن(@)(@@) 528 - حديث : ( ( لما كانت الليلة التي صبيحتها الخلافة . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به الليث بن سعد عن عبيد الله بن عمر عن الزهري عن المسور عن خاله عبد الرحمن بن عوف ( 3 ) . PageV01P347(@)(@@) | إبراهيم بن عبد الرحمن بن عوف ( 1 ) عن أبيه(@)(@@) 529 - حديث : ( ( كنت ( ريا ) لرسول الله . . ) ) الحديث .(@)(@@) غريب من حديث الزهري عن إبراهيم بن عبد الرحمن عن أبيه .(@)(@@) تفرد به محمد بن عبد العزيز الزهري عن الزهري .(@)(@@) 530 - حديث : ( ( قال الله عز وجل أنا الرحمن . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به سعد بن حسين عن الزهري عنه .(@)(@@) 531 - حديث : ( ( كنا جلوسا فجاء سعد بن معاذ فقال رسول الله هذا سيدكم . . ) ) الحديث ( 3 ) . PageV01P348(@)(@@) غريب من حديث سعد بن إبراهيم عن أبيه عن جده .(@)(@@) تفرد به عائذ بن عبد الرحمن عنه .(@)(@@) وتفرد به صدقة بن عبد الله عن عياض وخالفه محمد بن صالح التمار ( 1 ) عن سعد .(@)(@@) | حميد بن عبد الرحمن بن عوف ( 2 ) عن أبيه(@)(@@) 532 - حديث : أن رسول الله قال : ( ( إن العبد إذا استعمل واحد الحق . . ) ) الحديث .(@)(@@) غريب من حديث عبد الرحمن بن حميد ( 3 ) عن أبيه . PageV01P349(@)(@@) تفرد به عنه سليمان بن سالم .(@)(@@) 533 - حديث : ( ( فقد النبي رجلا من أصحابه . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به سليمان ( 2 ) بمثله .(@)(@@) 534 - حديث : ( ( صلاة الهجير صلاة الليل . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به سليمان ( 4 ) بمثله .(@)(@@) 535 - حديث : ( ( أبو بكر الصديق 
ms86	 في الجنة . . ) ) الحديث ( 5 ) .(@)(@@) تفرد به عبد العزيز بن محمد الدراوردي ( 6 ) عن عبد الرحمن بن حميد عن أبيه . PageV01P350(@)(@@) ورواه سعد بن إبراهيم عن حميد .(@)(@@) تفرد به عمار بن مطر ( 1 ) عن إبراهيم بن سعد ( 2 ) عن أبيه عن حميد .(@)(@@) 536 - حديث : ( ( من صام يوما في سبيل الله عز وجل . . ) ) الحديث ( 3 ) . PageV01P351(@)(@@) تفرد به عبد الله بن لهيعة عن العلاء بن كثير عن صفوان بن سليم عنه .(@)(@@) 537 - حديث : ( ( إن رسول الله كان تخرج له العنزة فيصلي إليها . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به الحسن بن عمارة عن سعد بن إبراهيم عن أبي سلمة وحميد عن أبيهما .(@)(@@) | أبو سلمة بن عبد الرحمن ( 2 ) عن أبيه ( 3 )(@)(@@) 538 - حديث : ( ( اقرؤوا القرآن ولا تأكلوا به . . ) ) الحديث ( 4 ) . PageV01P352(@)(@@) تفرد به حماد بن يحيى الأشج عن يحيى بن أبي كثير عن أبي سلمة / عن أبيه وأول الحديث تفرد به يحيى عن زيد بن سلام ( 1 ) بن أبي سلام عن عبد الرحمن مرسل عن النبي والآخر تفرد به يحيى عن عامر العقيلي ( 3 ) عن أبيه عن أبي هريرة ووهم فيه عن أبي هريرة .(@)(@@) 539 - حديث : ( ( القسامة في الدم . . ) ) الحديث .(@)(@@) غريب من حديث الزهري عن أبي سلمة .(@)(@@) تفرد به عبد الرحمن بن أيمن ( 3 ) عنه ، وعنه يونس بن بكير .(@)(@@) 540 - حديث : مشيت مع النبي حتى وقف على باب المسجد فقال : ( ( يا ابن عوف ألا أعلمك كلمات . . ) ) الحديث ( 4 ) . PageV01P353(@)(@@) غريب من حديث أبي سلمة عن أبيه وغريب من حديث القاسم بن محمد بن أبي بكر عن أبي سلمة تفرد به الحكم بن عبد الله بن سعد الأيلي ولم يروه عنه غير يزيد السمط ( 1 ) .(@)(@@) 541 - حديث : ( ( انطلق رسول الله في طلب رجل من الأنصار . . ) ) الحديث . وفيه الماء من الماء ( 2 ) .(@)(@@) غريب من حديث أبي سلمة عن أبيه تفرد به زيد بن سعد عنه ولم يروه عنه غير يونس بن بكير .(@)(@@) 542 - حديث : ( ( بك أقسم عليهم ما نقص مال من صدقة . . ) ) الحديث ( 3 ) . PageV01P354(@)(@@) تفرد به يونس بن خباب ( 1 ) عن 
ms87	 أبي سلمة عن أبيه .(@)(@@) وتفرد به عمرو بن نجيح عنه .(@)(@@) ورواه منصور بن المعتمر عن يونس واختلف عنه . فقال الثوري عنه عن يونس عن أبي سلمة عن أم سلمة .(@)(@@) وتفرد به علي بن حرب عن القاسم الجرمي ( 2 ) عن الثوري تابعه محمد بن PageV01P355 عمارة القرشي عن الثوري . وتفرد به علي بن حرب عن محمد بن عمارة أيضا وقال وكيع عن الثوري عن يونس عن أبي سلمة ( 1 ) عن النبي مرسلا ، ورواه عمر بن أبي سلمة عن أبيه عن قاضي فلسطين ( 2 ) عن عبد الرحمن بن عوف .(@)(@@) 543 - حديث : ( ( يرفع الله الدنيا . . ) ) الحديث .(@)(@@) تفرد به مصعب بن مصعب بن عبد الرحمن بن عوف ( 39 عن الزهري ، وتفرد به محمد بن إسماعيل بن أبي فديك ( 4 ) عن عبد الملك بن زيد عنه . PageV01P356(@)(@@) 544 - حديث : ( ( إن عمر خرج إلى الشام فسمع بالطاعون . . ) ) الحديث .(@)(@@) غريب من حديث أبي سلمة عن أبيه وغريب من حديث الزهري عنه .(@)(@@) تفرد به عبد الله بن نافع الصايغ ( 1 ) عن هشام بن سعد عن الزهري عن أبي سلمة وغيره يرويه عن حميد بن عبد الرحمن بن عوف .(@)(@@) 545 - حديث : لأبي سلمة حدثني أبي سمعته من أبيك عن رسول الله قال : ( ( حدثني أبي في شهر رمضان / . . ) ) الحديث .(@)(@@) تفرد به النضر بن شيبان عن أبي سلمة عن أبيه وحدث به ( . . . . ) ( 2 ) القاسم بن نصر بن علي الجهضمي الأكبر وأبو عقيل الدورقي بشر بن عقبة .(@)(@@) 546 - حديث : إنه أتى النبي فقال : ( ( إني رجل فمل . . ) ) ( 3 ) الحديث .(@)(@@) تفرد به الوليد وهو ابن عبد الله بن جميع عن أبي سلمة ولا أعلم حدث به غير أشعث بن عطاف .(@)(@@) 547 - حديث : قال : ( ( دعا رسول الله في فتح مكة عليا . . ) ) الحديث . PageV01P357(@)(@@) تفرد به يحيى بن سعيد الفارسي ، عن الزهري عنه .(@)(@@) 548 - حديث : ( ( إنه كان يقول في الصلاة على الميت . . ) ) الحديث .(@)(@@) غريب من حديث أبي سلمة عن أبيه .(@)(@@) تفرد به ابن أبي ليلى ( 1 ) عن أبي نجيح ( 2 ) أو ابن أبي نجيح عن أبي سلمة .(@)(@@) | عبد بن 
ms88	 عمير عنه ( 3 )(@)(@@) 549 - حديث : ( ( بينا عمر يمر في الطريق إذا هو برجل يكلم امرأة . . ) ) الحديث .(@)(@@) غريب من حديث مطر الوراق ( 4 ) ، عن عطاء بن أبي رباح عنه .(@)(@@) تفرد به الفضل بن جبير الوراق بهذا الإسناد .(@)(@@) | عبد الرحمن بن أبي ليلى عن عبد الرحمن(@)(@@) 550 - حديث : ( ( كان رسول الله إذا صلى على جنازة . . ) ) الحديث . PageV01P358(@)(@@) تفرد به ثابت بن صفية ( 1 ) وهو أبو حمزة الثمالي ( 2 ) عنه .(@)(@@) | قاضي فلسطين عن عبد الرحمن(@)(@@) 551 - حديث : قال رسول الله قلت : والذي نفسي بيده إن كنت لحالفا عليهم . . الحديث ( 3 ) . PageV01P359(@)(@@) تفرد به عمر بن أبي سلمة عن أبيه عن قاضي فلسطين ( 1 ) وتفرد به عنه أبو عوانة وقد تقدم له طرق في ترجمة أبي سلمة عن أبيه ( 2 ) . $ عروة بن الزبير عنه ( ( شبه المرسل ) )(@)(@@) 552 - حديث : ( ( قال رسول الله كيف صنعت في استلام الحجر . . ) ) الحديث ( 3 ) . PageV01P360(@)(@@) هكذا رواه أبو مروان يحيى بن أبي زكريا ومحمد بن عبيد ، عن هشام قال محمد بن عبيد لم أسمع من هشام غيره . PageV01P361(@)(@@) | مسند أبي عبيدة(@)(@@) ( 1 )(@)(@@) 553 - حديث : جنادة بن أبي أمية قال : ( ( نزلنا دابق ( 2 ) وعلينا أبو عبيدة بن الجراح فبلغ حبيب بن مسلمة أن منية صاحب قريش . . ) ) الحديث .(@)(@@) وفيه فقال أبو عبيدة : مهلا يا حبيب ( 3 ) فإني سمعت رسول الله يقول : إنما للمرء ما كاتب / به ( قيس ) ( 4 ) صاحبه .(@)(@@) غريب من حديث موسى بن سيار الدمشقي ( 5 ) ، عن مكحول عن جنادة .(@)(@@) تفرد به عمرو بن واقد عنه وفيه قول معاذ وحبيب بن مسلمة وهو غريب من حديث جنادة عن حبيب .(@)(@@) 544 - حديث : ( ( قال عمر لأبي عبيدة هلم أبايعك . . ) ) ( 6 ) الحديث .(@)(@@) وفيه قال أبو عبدة ( ( كيف أصلي . . ) ) الحديث .(@)(@@) تفرد به إسماعيل بن سميع عن مسلم البطين عن أبي البحتري . PageV01P362(@)(@@) | - * باب الألف من اسمه أسامة(@)(@@) - *(@)(@@) | أسامة بن زيد ( 1 ) عبد الله بن عباس عنه(@)(@@) 555 - حديث : إن رسول الله قال : ( ( الربا في النسيئة . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به سليمان القافلاني ( 3 ) عن منصور بن زاذان ، عن عطاء عنه ورواه 
ms89	 عبد العزيز بن قرير ( 4 ) عن عطاء وهو غريب من حديثه لم يروه عنه غير محمد بن ثابت العبدي ( 5 ) ورواه أبو الصهباء عن ابن عباس عن أسامة .(@)(@@) وتفرد بطريقه عثمان بن خرزاذ ( 6 ) عن موسى بن إسماعيل عن حماد بن سلمة PageV01P363 عن داود بن أبي هند عن أبي نضرة عن أبي الصهباء وعطاء هو ابن أبي رباح .(@)(@@) | عبد الله بن ثعلبة بن صعير ( 1 ) عنه(@)(@@) 556 - حديث : إن النبي كان يقرأ في الفجر ( ^ إذا الشمس كورت . . . ) الحديث .(@)(@@) تفرد به محمد بن عمر الواقدي عن ابن أخي الزهري عن أبيه عن عبد الله .(@)(@@) | عمرو بن عثمان ( 2 ) عنه(@)(@@) 557 - حديث : قال : ( ( جاء علي إلى النبي فأخبره بموت أبي طالب . . ) ) الحديث .(@)(@@) تفرد به علي بن أبي علي اللهبي ( 3 ) عن الزهري .(@)(@@) وتفرد به إسحاق الفروي عن علي .(@)(@@) 558 - حديث : ( ( لا يتوارث أهل ملتين . . ) ) الحديث ( 4 ) . PageV01P364(@)(@@) غريب من حديث هشيم عن الزهري ما كتبناه إلا عن أبي حامد محمد بن هارون الحضرمي عن إسحاق بن أبي إسرائيل ( 2 ) عنه . PageV01P365(@)(@@) | عامر بن سعد بن أبي وقاص ( 1 ) عنه(@)(@@) 559 - حديث : قال : ( ( هو رجز يعني الطاعون . . ) ) الحديث ( 2 ) .(@)(@@) غريب من ( حديث ) ( 3 ) صالح بن كيسان عن ابن المنكدر تفرد به إبراهيم بن سعد عنه .(@)(@@) رواه يزيد ( 4 ) بن الهاد عن ابن المنكدر وقال محمد بن المنكدر فحدث بهذا / الحديث عمر بن عبد العزيز فقال : هكذا حدثنيه عامر بن سعد وهو غريب من حديث ابن المنكدر ، عن عمر ، عن عامر .(@)(@@) تفرد به يزيد بن الهاد ( 5 ) عنه وكذلك رواه حيوة بن شريك والليث بن سعد ونافع بن يزيد عن ابن الهاد . PageV01P366(@)(@@) | عامر الشعبي ( 1 ) عنه(@)(@@) 560 - حديث : ( ( أنه أفاض مع رسول الله من عرفة . . ) ) الحديث .(@)(@@) تفرد به همام ، عن قتادة ، عن عروة ، عن الشعبي .(@)(@@) 561 - حديث : ( ( حملت على رجل فقال لا إله إلا الله . . ) ) الحديث .(@)(@@) تفرد به أبو الزناد عن الشعبي عن أسامة .(@)(@@) | عروة بن الزبير ( 2 ) عنه(@)(@@) 562 - حديث : ( ( كنت ردف النبي فلما سمع 
ms90	 حطمة ( 3 ) الناس من خلفه قال : رويدا . . ) ) الحديث . PageV01P367(@)(@@) تفرد به محمد بن إسحاق عن هشام عن أبيه بهذه الألفاظ .(@)(@@) 563 - حديث : ( ( استعملني رسول الله على سرية . . ) ) الحديث .(@)(@@) تفرد به طاهر بن الفضل الحلبي ( 1 ) عن سفيان بن عيينة عن الزهري عن عروة .(@)(@@) | قيس بن أبي حازم ( 2 ) عنه(@)(@@) 564 - حديث : ( ( لما قتل أبي أتيت النبي فوقفت على يديه . . ) ) الحديث .(@)(@@) تفرد به أبو أسامة حماد بن أسامة عن إسماعيل بن أبي خالد عنه ولا أعلم رواه عنه متصلا غير أبي عقيل يحيى بن حبيب بن إسماعيل بن عبد الله بن حبيب بن أبي ثابت .(@)(@@) | مسروق بن الأجدع ( 4 ) عن أسامة بن زيد(@)(@@) 565 - حديث : ( ( قيل لأسامة ألا تكلم عثمان . . ) ) الحديث . PageV01P368(@)(@@) تفرد به خالد بن نزار ( 1 ) ، عن ابن عيينة ، عن الأعمش ، عن شقيق ، عن مسروق ، وغيره لا يذكر مسروقا .(@)(@@) | أبو عثمان النهدي ( 2 ) عن أسامة(@)(@@) 566 - حديث : ( ( من ترك ثلاث جمعات . . ) ) الحديث ( 3 ) .(@)(@@) غريب من حديث أبي عثمان عنه تفرد به محمد بن مسلم عن معمر .(@)(@@) 567 - حديث : ( ( لا ترجعوا بعدي كفارا . . ) ) الحديث ( 4 ) . PageV01P369(@)(@@) غريب من حديث سليمان التيمي وغريب من حديث الثوري ، تفرد به عيسى بن أبي حرب ، عن يحيى بن أبي بكير ، عن الثوري .(@)(@@) 568 - حديث : ( ( إنما يرحم الله من عباده الرحماء . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به الحسن بن عتبة ، عن الحسن بن الخليل بن مرة ، عن أبيه ، عن شعبة ، عن عاصم عنه .(@)(@@) 569 - حديث : ( ( إن رسول الله كان إذا عجل به السير . . ) ) الحديث ( 2 ) . PageV01P370(@)(@@) تفرد به الجريري عنه .(@)(@@) 570 - حديث : ( ( من صنع إليه خيرا . . ) ) الحديث .(@)(@@) تفرد به سعير بن الخمس ( 2 ) ، عن سليمان التيمي عنه ، وتفرد به أبو الجواب الأحوص بن جواب ( 3 ) عنه .(@)(@@) 571 - حديث : ( ( ما تركت بعدي فتنة . . ) ) الحديث ( 4 ) . PageV01P371(@)(@@) تفرد به معاذ بن موسى ، عن السري بن يحيى ، عن سليمان التيمي عنه ، ورواه عاصم الأحوال عنه ، وطريقه في آخر الترجمة .(@)(@@) 572 - حديث : ( ( أمر رسول الله أن يسلم الراكب على الماشي . . ) ) الحديث .(@)(@@) غريب ( ( من حديث التيمي ) ) ( 2 
ms91	 ) ، ومن حديث الثوري عنه .(@)(@@) تفرد به حصين بن مخارق عن الثوري .(@)(@@) 573 - حديث : ( ( أن النبي كانت عنده أم سلمة وفيه ذكر مرثد ( 3 ) ودحية . . ) ) الحديث .(@)(@@) غريب من حديث سليمان التيمي عنه عن أسامة .(@)(@@) تفرد به معتمر ( 4 ) عن أبيه وأخرجه البخاري ومسلم في الصحيح من حديث معتمر . PageV01P372(@)(@@) 547 - حديث : ( ( ما تركت بعدي فتنه . . ) ) الحديث ( 1 ) .(@)(@@) قال ابن صاعد : غريب من حديث عاصم الأحوال ما سمعناه إلا من محمد بن خلف التيمي عن علي بن عبد الحميد عن مندل عن عاصم .(@)(@@) قال الدارقطني : تفرد به مندل ( 2 ) عن عاصم ولم يروه عنه غير علي بن عبد الحميد .(@)(@@) ورواه زياد الجصاص عن النهدي .(@)(@@) وهو غريب من حديث زياد عنه . تفرد به محمد بن خالد الوهبي عنه ورواه خالد الحذاء عن النهدي .(@)(@@) وهو غريب من حديث عنه . تفرد به حيان بن عامر عن بشر بن المفضل عن خالد . PageV01P373(@)(@@) | مسند أسامة بن شريك ( 1 ) زياد بن علاقة عنه(@)(@@) 575 - حديث : ( ( جاءت الأعراب يسألون رسول الله عن أمر الحج . . ) ) الحديث .(@)(@@) وفيه ( ( ما خير ما أعطي الخلق ) ) بألفاظ مختلفة وأسانيد متفرقة .(@)(@@) غريب من حديث مجالد بن سعيد عن زياد .(@)(@@) رواه عن مجالد يحيى بن سعيد الأموي .(@)(@@) ورواه زكريا بن سياه عن زياد مختصرا .(@)(@@) وتفرد به الحسن بن زياد عنه ورواه مسعر والثوري والمسعودي وحماد بن عمرو ويونس بن أبي إسحاق ( 2 ) عن زياد / مختصرا .(@)(@@) وتفرد به الحسن بن زياد عن يونس وحماد بن عمرو الأسدي ورواه زيد بن PageV01P374 أبي أنيسة ( 1 ) عن زياد وهو غريب من حديثه تفرد به عنه عبد الله بن عمرو الرقي .(@)(@@) وتفرد به سلام بن سليم الطويل ( 2 ) عن ورقاء عن ابن عمر .(@)(@@) تفرد به أبو عاصم عن محمد بن بشر بن بشير الأسلمي ( 3 ) عنه وتفرد به عمر بن شيبب ( 4 ) عن عمرو بن قيس عن علقمة بن مرثد عنه .(@)(@@) ورواه عبد الملك بن أبجر ( 5 ) وموسى الجهني ( 6 ) عن زياد وهو غريب من حديثهما عنه .(@)(@@) تفرد به عبد الرحمن بن 
ms92	 عبد الملك ( 7 ) عنهما . PageV01P375(@)(@@) 576 - حديث : ( ( أمك وأباك . . ) ) الحديث ( 1 ) .(@)(@@) وهو محرف منه الألفاظ التي في أوله تفرد بها محمد بن جحادة عن زياد وتفرد به عمران القطان عن محمد ولم يروه عنه غير عمرو بن عاصم .(@)(@@) 577 - حديث : قيل يا رسول الله ما خير ما أعطي المرء قال : حسن الخلق . . . . الحديث .(@)(@@) وهو طرق من الذي تقدم .(@)(@@) تفرد به سويد بن سعيد ، عن إسماعيل بن حماد بن أبي سليمان ( 2 ) ، وعن سعيد بن لقمان كليهما عن زياد .(@)(@@) ورواه الربيع بن الركين ، وعبد الملك بن عبد الرحمن الأصبهاني ( 3 ) ، وعبيد الله بن عبد الله بن عيسى عن زياد وتفرد به عنهم علي بن الربيع بن الركين .(@)(@@) 578 - حديث : ( ( يد الله على الجماعة ) ) ( 4 ) . PageV01P376(@)(@@) غريب من حديث زياد عن أسامة ، ومن حديث أبو إسحاق الشيباني ( 1 ) عن زياد .(@)(@@) تفرد به سلميان العامري عن الشيباني وهو سليمان بن عمرو بن وهب أبو داود النخعي ( 2 ) .(@)(@@) وتفرد به عنه محمد بن يعلى ويعرف بابن زنبوز ( 3 ) . PageV01P377(@)(@@) | مسند أسامة بن عمير ( 1 ) أبنه أبو المليح عنه(@)(@@) 579 - حديث : قال رسول الله ( ( من لا يشكر الناس لا يشكر الله عز وجل ) ) ( 2 ) .(@)(@@) تفرد به عباد بن سعيد ، عن مبشر بن أبي المليح عن أبيه عن جده أسامة بن عمير ، ولم يروه عنه غير يحيى بن أبي زكريا الغساني أبو ( 3 ) أبو مروان .(@)(@@) 580 - حديث : أنه صلى ركعتين وفيه : ( ( اللهم رب جبريل ) ) . . . الحديث . PageV01P378(@)(@@) تفرد به مبشر عن أبيه عن جده .(@)(@@) 581 - حديث : كنا مع النبي فأصابنا بغش ( 1 ) من مطر . . . الحديث ( 2 ) .(@)(@@) قال أحمد بن بشير عن عامر بن عبادة / عن أبي المليح ، وقال أبو أسامة : عن عامر بن عبيد ، وتفرد به أبو أسامة عن أبي عبيدة الباهلي عنه .(@)(@@) ورواه عمران أبو بشر الجلي ( 3 ) عن أبي المليح عامر بن أسامة ، وتفرد به علي بن هاشم بن البريد ( 4 ) . ولا أعلم حدث به عنه غير داود بن عمرو الضبي .(@)(@@) 582 - حديث : رواة قتادة ، عن أبي المليح ولفظه 
ms93	 : ( ( سافرنا مع رسول الله من رمضان لتسع عشرة . . . الحديث .(@)(@@) تفرد به عبد الحميد بن الحسن .(@)(@@) 583 - حديث : كنت ردف النبي فعثر بعيرنا . . . . الحديث ( 5 ) .(@)(@@) غريب من حديث أبي المليح عامر ، وقيل عمير بن أسامة بن عمير ، وغريب من حديث أبي تميمة الهجيمي ( 1 ) عنه . PageV01P379(@)(@@) تفرد به خالد الحذاء وعنه محمد بن حمدان بهذا الإسناد .(@)(@@) 584 - حديث : أنه نهى أن تتخد جلود السباع فرشا . . . الحديث .(@)(@@) تفرد به إسحاق بن إدريس ، عن أبان بن يزيد العطار ( 1 ) عن مطر عنه . PageV01P380(@)(@@) | مسند أبي بن كعب ( 1 ) عبد الله بن عباس عنه(@)(@@) 585 - حديث : قال رسول الله الغلام الذي قتله الخضر . . . . الحديث ( 3 ) .(@)(@@) غريب من حديث الثوري عن معتمر بن سليمان عن أبيه عن رقبة ( 4 ) . PageV01P381(@)(@@) تفرد به محمد بن زكريا عن سويد عن محمد بن الحسن الهمداني ( 1 ) عنه .(@)(@@) وما كتبناه إلا عن أبي بكر محمد بن محمود المعدل بواسط ورقبة .(@)(@@) رواه عن أبي إسحاق عن سعيد بن جببر عن ابن عباس .(@)(@@) 586 - حديث : وذكرهم بآيات الله . . . . الحديث ( 2 ) .(@)(@@) تفرد به حصين بن مخارق عن مسعر وعبد الحميد بن جعفر عن أبي إسحاق عن سعيد بن جبير .(@)(@@) 587 - حديث : اقرأ رسول الله ( ( رجل ( ^ يقص الحق وهو خير الفاصلين ) .(@)(@@) تفرد به شاذان النضر بن سلمة عن أحمد بن أبي مرة من أهل مكة قال : ذهبت أنا ويحيى ابن معين إليه فحدثنا عن داود بن شبل عن أبيه شبل بن عباد ( 4 ) عن عبد الله بن كثير عن مجاهد . PageV01P382(@)(@@) 588 - حديث : أنه كان عند عمر يغمز قدمه . . . الحديث وفيه أقرأينها أبي بن كعب لا أعلم حدث بها عن ابن عون غير حماد بن مسعدة ( 1 ) / .(@)(@@) | الطفيل بن أبي ( 2 ) عن أبيه(@)(@@) 589 - حديث : قوله عز وجل : ( ^ وألزمهم كلمة التقوى ) ( 3 ) . . . . الحديث ( 4 ) .(@)(@@) غريب من حديث الطفيل عن أبيه .(@)(@@) تفرد به ثوير بن أبي فاختة ( 5 ) عن أبيه عنه . PageV01P383(@)(@@) وغريب من حديث شعبة عن ثوير تفرد به سفيان بن جندب عنه .(@)(@@) | عبد الله بن أبي بصير 
ms94	 ( 1 ) عن أبي(@)(@@) 590 - حديث : أثقل الصلوات على المنافقين . . . الحديث ( 2 ) غريب من حديث أبي نوفل علي بن سليمان بن كيسان عن أبي إسحاق السبيعي تفرد به يحيى بن صالح الوحاظي .(@)(@@) 591 - حديث : صلى ( . . . ) رسول الله صلاة الصبح قال : أشاهد فلان . . . الحديث ( 3 ) غريب من حديث أيوب السختياني عن شعبة عن أبي إسحاق عن عبد الله . PageV01P384(@)(@@) تفرد به سعيد بن واصل ( 1 ) عن وهيب عنه .(@)(@@) وتفرد به محمد بن سفيان بن أبي الزرد الأبلي ( 2 ) عن سعيد .(@)(@@) | زر بن حبيش ( 3 ) عن أبي(@)(@@) 592 - حديث : قيل لنا أشياء تكون في آخر هذه الأمة عند اقتراب الساعة . . . . الحديث غريب من حديث أبي قلابة الجرمي عنه . تفرد به الوليد بن بكير أبو جنان ( 4 ) ، عن عبد الله بن محمد العذري ، عن أبي سنان البصري عنه .(@)(@@) 539 - حديث : سألت أبيا عن ليلة القدر . . . الحديث وسألته عن المعوذتين .(@)(@@) تفرد به سعدويه عن ( 6 ) سعيد بن يحيى الأصبهاني عن مسلم بن خالد PageV01P385 الزنجي ( 1 ) عن النعمان بن راشد ( 2 ) عن عاصم عنه .(@)(@@) وروى حديث ليلة القدر إسماعيل بن أبي خالد وأبو إسحاق السبيعي عن زر ، ولم يجمع بينهما عن علي بن عابس عن إسماعيل .(@)(@@) ورواه منصور بن المعتمر عن عاصم .(@)(@@) تفرد به عنه أبو حفص الأبار عمر بن عبد الرحمن .(@)(@@) ورواه الحسن بن عرفة ، عن الأبار فزاد فيه حديثين آخرين .(@)(@@) 594 - حديث : سألت أبيا عن المعوذتين . . . الحديث ( 3 ) .(@)(@@) تفرد به سليمان بن أبي داود عن الحكم بن عتيبة عن زر ، ومن الحديث قبله طريق عاصم عن زر .(@)(@@) ورواه منصور عن عاصم وتفرد به أبو حفص الأبار عنه .(@)(@@) 595 - حديث : أن أبي وعبد الله بن مسعود اختلفا في الصلاة . . . . الحديث ( 4 ) . PageV01P386(@)(@@) وفيه ذكر عمر ، تفرد به الحسن بن أبي جعفر عن عاصم عنه .(@)(@@) 596 - حديث : يعرفني الله عز وجل نفسه / يوم القيامة . . . . . . الحديث ( 1 ) .(@)(@@) تفرد به أبو مريم عبد الغفار بن القاسم الأسدي عن عدي بن ثابت عن زيد ولا اعلم رواه عنه غير يحيى بن 
ms95	 أبي بكير .(@)(@@) 597 - حديث : من صلى على جنازة . . . . الحديث ( 2 ) .(@)(@@) غريب من حديث إسماعيل بن أبي خالد عن عدي بن ثابت عنه .(@)(@@) تفرد به إبراهيم بن أبي يحيى عنه . PageV01P387(@)(@@) 598 - حديث : كم تعدون سورة الأحزاب ؟ . . . . الحديث ( 1 ) .(@)(@@) غريب من حديث إدريس الأودي عن عاصم عنه .(@)(@@) تفرد به علي بن عمار عنه .(@)(@@) 599 - حديث : ( ( الرحم ) ) وهو طرف من حديث ليلة القدر .(@)(@@) غريب من حديث منصور بن المعتمر عن عاصم عنه .(@)(@@) تفرد به أبو حفص عمر بن عبد الرحمن الأبار ( 2 ) عن منصور وعنه الحسن بن عرفة .(@)(@@) | عبد الرحمن بن أبزى ( 3 ) عن أبي(@)(@@) 600 - حديث : الوتر . . . . الحديث . PageV01P388(@)(@@) جود إسناده محمد بن ميسرة أبو سعد الصغاني ( 1 ) عن أبي حنيفة عن زبيد عن ذر عن سعيد عن أبيه وأسنده عن أبي وغيره لا يذكر فيه أبيا .(@)(@@) ورواه أسباط بن محمد عن أبي حنيفة بإسناده .(@)(@@) ولم يذكر فيه أبيا ولا سعيد بن عبد الرحمن فقال : ثنا أبو حنيفة عن ربيد عن ذر عن عبد الرحمن بن أبزى قال : كان رسول الله .(@)(@@) ورواه بشر بن عمر بن ذر ( 2 ) عن أبيه عمر بن ذر وأبو حنيفة عن ذر لم يذكر فيه زبيدا ولا أبي بن كعب . ورواه عزرة عن سعيد بن عبد الرحمن .(@)(@@) تفرد به قتادة عنه .(@)(@@) وهو غريب من حديث قتادة تفرد به المسيب بن واضح ( 3 ) عن عيسى عن ابن أبي عروبة عن قتادة .(@)(@@) ورواه علي بن خشرم عن عيسى عن فطر بن خليفة عن زبيد عن سعيد .(@)(@@) وهو غريب أيضا من حديثه عن زبيد .(@)(@@) تفرد به عيسى وذكر فيه القنوت قبل الركوع وأتى به بتمامه .(@)(@@) ورواه زبيد وسلمة بن كهيل عن عبد الله بن عبد الرحمن بن أبزي عن أبيه عن أبي . وتفرد به بقراد ( 4 ) عبد الرحمن بن غزوان عن أبي مالك النخعي عنهما . PageV01P389(@)(@@) 601 - حديث : لا تسبوا الريح . . . . . الحديث ( 1 ) .(@)(@@) غريب من حديث الأعمش عن حبيب عن ذر عن سعيد عن أبيه . لم يروه عنه بهذا الإسناد غير محمد 
ms96	 بن فضيل وتابعه أسباط بن محمد .(@)(@@) 602 - حديث : إن رسول الله / نسي آية من كتاب الله عز وجل . . . الحديث .(@)(@@) غريب من حديث الثوري عن سلمة بن كهيل .(@)(@@) لم يسنده عن أبي بن كعب غير يحيى بن سعيد القطان ( 2 ) .(@)(@@) وروي عن إسحاق الأزرق ( 3 ) عن الثوري مرسلا ومسندا . PageV01P390(@)(@@) | عبد الرحمن بن أبي ليلى ( 1 ) عن أبي(@)(@@) 603 - حديث : أتى جبريل النبي وهو عند أضاة ( 2 ) بني غفار . . . . الحديث ( 3 ) .(@)(@@) تفرد به عبد الوارث عن محمد بن جحادة عن الحكم بن عتيبة عن مجاهد عنه ورواه زبيد اليامي .(@)(@@) وتفرد به سالم بن عجلان الأفطس ( 4 ) عن زبيد .(@)(@@) وتفرد عنه ابنه عمر بن سالم ولم يروه عنه غير الحسن بن محمد بن أعين .(@)(@@) 604 - حديث : قال : جاء رجلان عند النبي . . . . الحديث .(@)(@@) تفرد به زيد بن أبي الجعد ( 5 ) عن عبد الملك بن عمير عن ابن أبي ليلى PageV01P391 وكذلك رواه الفضل بن موسى الشيباني ( 1 ) عن يزيد وخالفهما عمرو بن عبد الغفار الفقيمي فرواه ، عن يزيد ، عن عبد الرحمن بن عابس بن ربيعة النخعي ، عن ابن أبي ليلى عن أبي .(@)(@@) وهو غريب من حديث عبد الرحمن بن عابس .(@)(@@) تفرد به عمرو بن عبد الغفار عن يزيد بن زياد .(@)(@@) 605 - حديث : أن رجلا من الأنصار قال يا رسول الله من قرأ ( ^ قل هو الله أحد ) ( 2 ) . . . . الحديث تفرد به هشيم ، عن حصين ، عن هلال بن كيسان عنه .(@)(@@) | عبد الرحمن بن الأسود بن عبد يغوث ( 3 ) عن أبي(@)(@@) 606 - حديث : إن من الشعر حكمة . . . . الحديث ( 4 ) .(@)(@@) غريب من حديث عبد الملك بن الخطاب ( 5 ) بن عبيد الله بن أبي بكرة ، PageV01P392 عن إسماعيل بن أمية ، عن الزهري ، عن أبي بكر بن الحارث ، عن مروان بن الحكم ، عن عبد الرحمن تفرد به محمد بن عبد العزيز الرملي ( 1 ) عن عبد الملك .(@)(@@) | سويد بن غفلة ( 29 عن أبي(@)(@@) 607 - حديث : أحبت مائة دينار . . . . الحديث ( 3 ) .(@)(@@) غريب من حديث جابرالجعفي عن سلمة .(@)(@@) تفرد به إبراهيم بن طهمان عنه ولا 
ms97	 أعلم حدث به عن حفص بن عبد الله عنه . PageV01P393(@)(@@) | مسروق ( 1 ) عن أبي(@)(@@) 608 - حديث : قال رسول الله السكران يجلدان . . . . . الحديث ( 2 ) .(@)(@@) غريب من حديث إسماعيل بن أبي خالد عن الشعبي عنه عن أبي تفرد به عمرو بن عبد الغفار عنه .(@)(@@) | قيس بن عباد ( 3 ) غنى عن أبي(@)(@@) 609 - حديث : أن النبي أمرهم أن يلوه / من الصف . . . . الحديث ( 4 ) . PageV01P394(@)(@@) غريب من حديث سليمان التيمي عن أبي مجلز لاحق بن حميد .(@)(@@) تفرد به يوسف بن يعقوب ( 1 ) صاحب السلعة ( 2 ) .(@)(@@) | غنى ( 3 ) عن أبي(@)(@@) 610 - حديث : من سمعتموه يدعو بدعاء الجاهلية فاعضوه . . . الحديث ( 4 ) .(@)(@@) تفرد به معاوية بن حفص الشعبي ( 5 ) عن السري بن يحيى ( 6 ) عن الحسن عن غتى . PageV01P395(@)(@@) | أبو سلمة عن أبي(@)(@@) 611 - حديث : صلى رسول الله فترك آية . . . . الحديث ( 1 ) .(@)(@@) تفرد به سليمان بن أرقم ( 2 ) عن الزهري عنه .(@)(@@) | أبو العالية ( 3 ) عن أ بي(@)(@@) 612 - حديث : كسفت الشمس . . . الحديث ( 4 ) .(@)(@@) تفرد به الربيع بن انس عنه . PageV01P396(@)(@@) وتفرد به أبو جعفر الرازي عن الربيع .(@)(@@) 613 - حديث : بشر هذه الأمة . . . الحديث ( 1 ) .(@)(@@) تفرد به أبو عامر قبيصة بن عقبة عن الثوري عن أيوب عنه .(@)(@@) 614 - حديث : أن المشركين قالوا لرسول الله أنسب لنا ربك . . . الحديث ( 2 ) .(@)(@@) تفرد به أبو سعد الصاغاني محمد بن ميسر عن أبي جعفر الرازي عنه .(@)(@@) 615 - حديث : من قوله عز وجل ( ^ وإن إلى ربك المنتهى ) ( 3 ) قال لا فكرة في الله عز وجل . . . . الحديث ( 4 ) .(@)(@@) تفرد به عباس بن زفر ، عن أبي جعفر الرازي عن الربيع بن أنس عنه .(@)(@@) | صاحب قتادة عن أبي(@)(@@) 616 - حديث : كان آدم عليه السلام طوالا كأنه نخلة سحوق ( 5 ) . . . الحديث .(@)(@@) تفرد به المعتمر بن سليمان عن أبيه عن قتادة عن صاحب له . PageV01P397(@)(@@) | - * ذكر أسماء جماعة من الصحابة من المقلين ذكرناهم قبل أنس بن مالك لكيلا يخفى حديثهم بعده(@)(@@) مسند الأسود بن سريع ( 1 ) $(@)(@@) 617 - حديث : قيل يا رسول الله من في الجنة . . . الحديث ( 2 ) .(@)(@@) تفرد به أبو بكر الهذلي عن 
ms98	 الحسن البصري عنه .(@)(@@) 618 - حديث : أتي النبي بأسير . . . الحديث ( 3 ) .(@)(@@) وفيه ( ( عرف الحق لأهله ) ) .(@)(@@) غريب من حديث الحسن عنه . PageV01P398(@)(@@) تفرد به محمد بن مصعب القرقساني ، عن سلام بن مسكين ومبارك بن فضالة عن الحسن .(@)(@@) 619 - حديث : لما مات عثمان بن مظعون ( 1 ) . . . الحديث .(@)(@@) تفرد به معمر بن يزيد عن الحسن .(@)(@@) | مسند الأسود بن خلف ( 2 )(@)(@@) 620 - حديث : أن النبي / أخذ حسنا فقبله . . . الحديث .(@)(@@) تفرد به معمر بن راشد ، عن ابن خيثم ، عن محمد بن الأسود بن خلف عن أبيه .(@)(@@) | مسند أحمد بن جدي(@)(@@) 621 - حديث : إن كنا ( لنأوي ) ( 3 ) لرسول الله . . . الحديث .(@)(@@) قال ابن صاعد : وهذا الحديث المشهور بروايته عباد بن راشد عن الحسن قال الدار قطني : وهو غريب من حديث عطاء بن عجلان عن الحسن تفرد به مروان بن معاوية الفزاري ( 4 ) عن عطاء . PageV01P399(@)(@@) 622 - حديث : رأيت رسول الله محتبيا في ثوب واحد ( 1 ) . . . الحديث . 3 غريب من حديث الحسن عن أحمد تفرد به عبد الرحمن بن قيس ( 5 ) عن عباد بن راشد عن الحسن .(@)(@@) | مسند أمية بن مخشي ( 3 )(@)(@@) 623 - حديث : أن النبي رأى رجلا يأكل ولم يسم ( 4 ) . . . . الحديث . PageV01P400(@)(@@) لم يسند أمية عن النبي غير هذا الحديث .(@)(@@) تفرد به جابر بن الصبح ( 1 ) عن المثنى بن عبد الرحمن الخزاعي ( 2 ) عن جده أمية .(@)(@@) | مسند أرقم بن الأرقم ( 3 )(@)(@@) 624 - حديث : أن الذي يتخطا رقاب الناس ( 4 ) . . . الحديث .(@)(@@) غريب من حديث الأرقم عن النبي . .(@)(@@) تفرد به أبو القدام هشام بن زياد عن عمار بن سعد عن عثمان بن الأرقم عن أبيه . PageV01P401(@)(@@) | مسند أسيد بن ظهير ( 1 )(@)(@@) 625 - حديث : أنه راح إلى قومه بني حارثة ( 2 ) . . . الحديث من كري المزارع تفرد به عبد الحميد بن حعفر ( 3 ) عن أبيه عن رافع بن أسيد عن أبيه .(@)(@@) | مسند أخضر بن أبي الأخضر ( 4 ) الأنصاري(@)(@@) 626 - حديث : أنا أقاتل على تنزيل القرآن . . . . الحديث .(@)(@@) غريب من حديث الأخضر عن النبي . تفرد به محمد بن كثير PageV01P402 الكوفي ( 1 ) عن الحارث بن حضيرة عن جابر 
ms99	 عن محمد بن علي بن الحسين عن أبيه عنه .(@)(@@) | مسند أبان المحاربي ( 2 ) وكان في وفد عبد القيس(@)(@@) 627 - حديث : ما من مسلم يقول إذا أصبح ( 3 ) . . . . الحديث .(@)(@@) غريب من حديث أبان عن النبي تفرد به سعيد بن عامر ( 4 ) عن أبان بن أبي عياش عن الحكم بن حبان ولا يسند أبان عن النبي غير هذا الحديث . PageV01P403(@)(@@) | مسند ازداد ( 1 )(@)(@@) 628 - حديث : إذا بال أحدكم ( 2 ) / . . . . . . الحديث .(@)(@@) غريب من حديث قرة بن خالد عن سعيد بن صالح تفرد به عباد بن عباد ولم يروه عنه غير مهدي بن عيسى ( 3 ) .(@)(@@) | مسند أفلح بن أبي القعيس ( 4 )(@)(@@) 629 - حديث : أنه أتى عائشة فاحتجبت منه ( 5 ) . . . . الحديث . PageV01P404(@)(@@) غريب من حديث خلف بن السري عن الحكم بن عيبة عن عراك عنه .(@)(@@) تفرد به عبد الله بن موسى . PageV01P405 بسم الله الرحمن الرحيم(@)(@@) | مسند أنس بن مالك الرواة عنه على حروف المعجم(@)(@@) إبراهيم بن محمد بن المنتشر بن الأجدع الهمداني ( 1 ) عن أنس(@)(@@) 630 - حديث : قال : ما أخرج رسول الله ركبته بين يدي جليس له ( 2 ) . . . . الحديث .(@)(@@) غريب من حديث إبراهيم عن أنس تفرد به أبو حنيفة النعمان بن ثابت الفقيه عنه .(@)(@@) إبراهيم بن أبي عبلة ( 3 ) عن أنس(@)(@@) 631 - حديث : قلت له كيف أتوضأ . . . الحديث . PageV02P003(@)(@@) غريب من حديث إبراهيم عن أنس . تفرد به قتادة بن الفضيل ( 1 ) عنه ولا نعلم حدث به غير الزبير بن محمد القرشي الرهاوي ( 2 ) .(@)(@@) إبراهيم التيمي ( 3 ) عن أنس(@)(@@) 632 - حديث : لا ربا في يد بيد والماء من الماء ( 4 ) . . . . الحديث .(@)(@@) تفرد به يعقوب بن كعب الأنطاكي ( 5 ) عن أبي معاوية عن الأعمش عنه . PageV02P004(@)(@@) إبراهيم النخعي ( 1 ) عن أنس(@)(@@) 633 - حديث : قدم وفد من عرينة ( 2 ) . . . . الحديث .(@)(@@) غريب من حديث مغيرة بن مقسم عن إبراهيم عن أنس ما كتبناه إلا عن محمد بن علي الإيلي عن الحسين بن السميدع الأنطاكي ( 3 ) عن العباس بن الهيثم النسائي عن هشيم عن مغيرة .(@)(@@) 634 - حديث : إبراهيم عن أنس وحميد عن أنس ما 
ms100	 شممت مسكة ولا عنبرة ( 4 ) . . . الحديث . PageV02P005(@)(@@) تفرد به محمد بن عبد العزيز الرملي عن أبي خالد الأحمر عن إبراهيم وعن حميد كليهما عن أنس .(@)(@@) إسماعيل بن أبي خالد ( 1 ) عن أنس وأبي جحيفة ( 2 )(@)(@@) 635 - حديث : قالا كان أشبه إلى ( محمد ) ( 3 ) الحسن بن علي ( 4 ) . . . . . الحديث .(@)(@@) تفرد به عمرو بن جرير عن إسماعيل بن أبي خالد عنهما .(@)(@@) إسماعيل بن عبد الرحمن السدي ( 5 ) عن أنس(@)(@@) 636 - حديث : رأيت رسول الله ينصرف عن يمينه فتنحنح ( 6 ) . . . . . PageV02P006 الحديث ( غريب ) ( ! ) من حديث / السدي عن أنس .(@)(@@) وغريب من حديث الحسن بن صالح عنه .(@)(@@) تفرد به حميد بن عبد الرحمن الرواسي ( 1 ) عنه .(@)(@@) 637 - حديث : أهدي إلى رسول الله أطيار ( 2 ) . . . . الحديث . PageV02P007(@)(@@) تفرد به عيسى بن عمر عن السدي .(@)(@@) إسحاق بن عبد الله بن أبي طلحة عن ( 1 ) أنس(@)(@@) 638 - حديث : أن النبي كان لا يطرق أهله ليلا ( 2 ) . . . . الحديث .(@)(@@) غريب من حديث هشام الدستوائي ( 3 ) عن إسحاق . تفرد به أبو سعيد مولى بني PageV02P008 هاشم عنه . وقال ابن صاعد : ما سمعناه إلا من محمد بن ميمون الخياط عن أبي سعيد .(@)(@@) 639 - حديث : رأيت رسول الله يصلي على حمار ( 1 ) . . . الحديث .(@)(@@) تفرد به يحيى بن مسلمة بن قعنب ( 2 ) عن مالك عن إسحاق .(@)(@@) 640 - حديث : أنه قال : صنعت طعاما أكلته بالمدينة . . ( 3 ) الحديث .(@)(@@) تفرد به إبراهيم بن طهمان ( 4 ) عن مالك عنه .(@)(@@) 641 - حديث : كانت بنت عوف ابن عفراء ( 5 ) مضجعة ( 6 ) . . . . الحديث . PageV02P009(@)(@@) غريب تفرد به عكرمة بن عمار عن إسحاق وتفرد به عمر بن يونس اليمامي ( 1 ) عنه .(@)(@@) 642 - حديث : كان أصحاب رسول الله يكرهون جمع القرآن مخافة الصغاين ( 2 ) . . . الحديث .(@)(@@) غريب من حديث محمد بن عبد الرحمن بن أبي ذئب ( 3 ) تفرد به خالد بن عمرو الأموي .(@)(@@) 643 - حديث : كان النبي وأبو بكر وعمر وعثمان يستفتحون القراءة بالحمد لله رب العالمين . . . . الحديث . PageV02P010(@)(@@) تفرد به طاهر بن الفضل بن سعيد أبو الحسن ( 1 ) عن ابن عيينة عنه .(@)(@@) 644 - حديث : قام رسول الله في صلاة 