ms2966	 حب ) و عبد بن حميد والبغوي وابن قانع ( طب ك ض ) عن سهيل بن البيضاء رضي الله عنه .(@)(@@)(@@)(@@) $ 27816 قال النبي :(@)(@@) | 30 ( يا شباب قريش ! لا تزنوا ! ألا من حفظ فرجه فله الجنة ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27817 قال النبي :(@)(@@) | 30 ( يا شداد بن أوس ! إذا رأيت الناس يكنزون الذهب والفضة فاكنز أنت هاؤلاء الكلمات : اللهم إني أسألك الثبات في الأمر ، وأسألك عزيمة الرشد ، وأسألك شكر نعمتك ، وأسألك حسن عبادتك ، وأسألك يقينا صادقا ، PageV09P168 وأسألك قلبا سليما ، ولسانا صادقا ، وأسألك من خير ما تعلم ، وأعوذ بك من شر ما تعلم ، وأستغفرك لما تعلم ، إنك أنت علام الغيوب ) )(@)(@@) ( ش ) و ابن سعد ( حم ع حب طب ك حل ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ 27818 قال النبي :(@)(@@) | 30 ( يا صخر ! إن القوم إذا أسلموا أحرزوا أموالهم ودماءهم ) )(@)(@@) ابن سعد ( حم ) والدارمي ( طب ) والبغوي وابن قانع عن صخر بن العيلة رضي الله عنه .(@)(@@)(@@)(@@) $ 27819 قال النبي :(@)(@@) | 30 ( يا صفية بنت عبد المطلب ! يا فاطمة بنت محمد ! يا بني عبد المطلب ! إني لا أملك لكم من الله شيئا ، سلوني من مالي ما شئتم ) )(@)(@@) ( ت ) حسن غريب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27820 قال النبي :(@)(@@) | 30 ( يا صاحب الطعام ! أسفل هاذا مثل أعلاه من غش المسلمين فليس منهم ) )(@)(@@) ( طب ) عن قيس بن أبي غرزة رضي الله عنه .(@)(@@)(@@)(@@) $ 27821 قال النبي :(@)(@@) | 30 ( يا صفوان ! قرب اللحم من فيك فإنه أهنأ وأمرأ ) )(@)(@@) ( حم طب ك هق ) عن صفوان بن أمية عن أبيه عن جده .(@)(@@)(@@)(@@) $ 27822 قال النبي :(@)(@@) | 30 ( يا صحار بن عياش ! أطب شرابك ، واسق جارك ) )(@)(@@) ابن قانع ( طب ) عن صحار بن عياش رضي الله عنه .(@)(@@)(@@)(@@) $ 27823 قال النبي :(@)(@@) | 30 ( يا طارق ! استعد للموت قبل نزول الموت ) )(@)(@@) ( عق طب ك هب ) عن طارق بن عبد الله المحاربي رضي الله عنه .(@)(@@)(@@)(@@) $ 27824 قال النبي :(@)(@@) | 30 ( يا صاحب المقراة ! لا تخبره هاذا تكلف ، لها ما أخذت في بطونها يعني السباع ولنا ما بقي شراب وطهور 
ms2967	 ) )(@)(@@) الديلمي عن ابن عمر بن عبد الله رضي الله عنه .(@)(@@) PageV09P169(@)(@@)(@@)(@@) $ 27825 قال النبي :(@)(@@) | 30 ( يا طهمان ! إن الصدقة لا تحل لي ولا لأهل بيتي ، وإن مولى القوم من أنفسهم ) )(@)(@@) البغوي والباوردي وابن عساكر عن طهمان مولى رسول الله .(@)(@@)(@@)(@@) $ 27826 قال النبي :(@)(@@) | 30 ( يا طلحة ! هاذا جبريل يقرئك السلام ويقول لك : أنا معك في أهول القيامة حتى أنجيك منها ) )(@)(@@) أبو بكر الشافعي في الغيلانيات والديلمي وابن عساكر عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 27827 قال النبي :(@)(@@) | 30 ( يا طلحة ! أنت ممن قضى نحبه ) )(@)(@@) ابن منده وابن عساكر عن أسماء بنت أبي بكر ، ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27828 قال النبي :(@)(@@) | 30 ( يا طلحة ! إنه ليس في ديننا قطيعة الرحم ، ولاكن أحببت أن لا يكون في دينك ريبة ) )(@)(@@) ( طب ) عن ابن مكين عن طلحة بن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ 27829 قال النبي :(@)(@@) | 30 ( يا طلحة ! إنه ليس من نبي إلا وله رفيق من أمته معه في الجنة ، وإن عثمان بن عفان رفيقي ومعي في الجنة ) )(@)(@@) ( عم ك ) وتعقب عن عثمان وطلحة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ 27830 قال النبي :(@)(@@) | 30 ( يا صهيب ! ليأتين على الناس زمان : كثير أمراؤه ، قليل فقهاؤه ، كذاب خطباؤه ، مراؤون قراؤه ، يتفقهون في غيرالدين ، يأكلون الدنيا كما تأكل النار الحطب ، ألا وإن النار مثوى لهم وبئس للظالمين منزلا ) )(@)(@@) الديلمي عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ 27831 قال النبي :(@)(@@) | 30 ( يا طيبة ، يا سيدة البلدان ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما قال : ما طلع النبي على المدينة قافلا من سفر إلا قال فذكره .(@)(@@)(@@)(@@) $ 27832 قال النبي :(@)(@@) | 30 ( يا عاصم ! ما ذئبان عاديان أصابا فريسة غنم أضاعها ربها بأفسد لها من حب المرء المال والشرف لدينه ) )(@)(@@) الحاكم في الكنى ، ( طب ك ) PageV09P170 عن عاصم بن أبي البداح بن عاصم بن عدي عن أبيه عن جده .(@)(@@)(@@)(@@) $ 27833 قال النبي :(@)(@@) | 30 ( يا عباد الله ! انظروا كيف يصرف الله عني شتم قريش ولعنهم ، يشتمون مذمما وأنا محمد ويلعنون مذمما وأنا محمد ) )(@)(@@) ابن سعد ( هب 
ms2968	 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27834 قال النبي :(@)(@@) | 30 ( يا عبادة ! اسمع وأطع في عسرك ويسرك ، ومنشطك ومكرهك وأثرة عليك وإن أكلوا مالك وضربوا ظهرك إلا أن تكون معصية لله بواحا ) )(@)(@@) ( حب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 27835 قال النبي :(@)(@@) | 30 ( يا عباس ! ثلاثة لا يدعهن قومك : الطعن في النسب ، والنياحة ، والاستمطار بالأنواء ) )(@)(@@) ( طب ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ 27836 قال النبي :(@)(@@) | 30 ( يا عباس ! أنت عمي وصنو أبي ، وخير من أخلف بعدي من أهلي ، إذا كان سنة خمس وثلاثين ومائة فهي لك ولولدك ، منهم السفاح ، ومنهم المنصور ، ومنهم المهدي ) )(@)(@@) الخطيب عن ابن عباس عن أمه أم الفضل رضي الله عنها .(@)(@@)(@@)(@@) $ 27837 قال النبي :(@)(@@) | 30 ( يا عبادة ! اسمع وأطع في عسرك ويسرك ، ومنشطك ومكرهك وأثرة عليك وإن أكلوا مالك وضربوا ظهرك إلا أن تكون معصية بواحا ) )(@)(@@) ( طب ) و ابن عساكر عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 27838 قال النبي :(@)(@@) | 30 ( يا عباس ! إن الله بدأ فتح هاذا الأمر في وسيختمه بغلام من ولدك يملؤها عدلا كما ملئت جورا ، وهو الذي يصلي بعيسى عليه السلام ) )(@)(@@) ( قط ) في الأفراد و الخطيب وابن عساكر عن عمار بن ياسر رضي الله عنه .(@)(@@) PageV09P171(@)(@@)(@@)(@@) $ 27839 قال النبي :(@)(@@) | 30 ( يا عباس ، يا عم النبي ! نفس تنجيها خير من إمارة لا تحصيها ) )(@)(@@) ابن سعد عن الضحاك بن حمزة مرسلا ، ابن سعد ( هق ) عن محمد بن المنكدر مرسلا ، ( هق ) عن ابن عباس عن جابر رضي الله عنهم .(@)(@@)(@@)(@@) $ 27840 قال النبي :(@)(@@) | 30 ( يا عباس ! أنت عمي وإني لا أغني عنك من الله شيئا ، ولاكن سل ربك العفو والعافية في الدنيا والآخرة ) )(@)(@@) ( حم ) و ابن سعد ، ( طب ) عن علي بن عبد ابن عباس عن أبيه عن جده أنه قال يا رسول الله ! علمني شيئا ينفعني الله به ؟ قال فذكره .(@)(@@)(@@)(@@) $ 27841 قال النبي :(@)(@@) | 30 ( يا عباس ! يا عم رسول الله أكثر من الدعاء بالعافية ) )(@)(@@) ( طب ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27842 قال النبي 
ms2969	 :(@)(@@) | 30 ( يا عبد الرحمان ! لا تغلبن على اسم العشاء ) )(@)(@@) ( خ ) في التاريخ عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 27843 قال النبي :(@)(@@) | 30 ( يا عبد الله ! هنيئا لك مريئا خلقت من طينتي وأبوك يطير مع الملائكة في السماء ) )(@)(@@) ابن عساكر عن علي بن عبد الله بن جعفر عن أبيه .(@)(@@)(@@)(@@) $ 27844 قال النبي :(@)(@@) | 30 ( يا عبد الله بن عمرو ! ست خصال كائنة فيكم : قبض نبيكم ، وفيض المال حتى يصير إلى أحدكم ألف دينار فيظل يتسخطها ، وفتنة تكون في بيت كل امرىء منكم ، وموت كقعاص الغنم ، وهدنة تكون بينكم وبين بني الأصفر يجمعون لكم حمل المرأة ويكونون أولى بالعذر منكم ، وفتح المدينة والقسطنطينية ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 27845 قال النبي :(@)(@@) | 30 ( يا عبد الله ! اذهب بهاذا الدم فأهرقه حيث لا يراك أحد ، ثم قال : فلعلك شربته ، ومن أمرك أن تشرب الدم ، ويل لك من الناس وويل للناس منك ) )(@)(@@) الحكيم ( ك ) عن ابن الزبير رضي الله عنه .(@)(@@) PageV09P172(@)(@@)(@@)(@@) $ 27846 قال النبي :(@)(@@) | 30 ( يا عبد الله بن عمر ! كن في الدنيا كأنك غريب أو عابر سبيل ، واعدد نفسك مع الموتى ) )(@)(@@) ( هناد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27847 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان ! لا تغلبن على اسم صلاتكم فإن الله سماها العشاء ، وإنما سماها الأعراب العتمة من أجل إعتام حلب إبلهم ) )(@)(@@) عبد الرزاق عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 27848 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان ! أعاذك الله من أمراء يكونون بعدي ، من دخل عليهم فصدقهم وأعانهم على جورهم فليس مني ولا يرد علي الحوض ، يا عبد الرحمان ! إن الصيام جنة ، والصلاة برهان ، يا عبد الرحمان ! إن الله تعالى أبى علي أن يدخل الجنة لحما نبت من سحت ، النار أولى به ) )(@)(@@) ( ك ) و الخطيب عن عبد الرحمن بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27849 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان ! الدنيا حلوة خضرة وأن الله تعالى مستخلفكم فناظر كيف تعملون ، ألا فاتقوا الدنيا واتقوا النساء ) )(@)(@@) ( طب ) عن عبد الرحمن 
ms2970	 بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27850 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان ! كفاك الله أمر دنيا ، فأما أمر آخرتك فأنا لها ضامن قاله لابن عوف ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 27851 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان ! إن أدخلك الله الجنة كان لك فيها فرس من ياقوتة لها جناح تطير بك في الجنة ) )(@)(@@) أبو نعيم عن عبد الرحمن بن ساعدة رضي الله عنه .(@)(@@)(@@)(@@) $ 27852 قال النبي :(@)(@@) | 30 ( يا عبد الرحمان بن عوف ! إنك من الأغنياء ، ولن تدخل الجنة إلا زحفا ، فأقرض الله يطلق لك قدميك ) )(@)(@@) ابن سعد ( عد طس ك ) وتعقب ( حل هب ) عن إبراهيم بن عبد الرحمن بن عوف عن أبيه .(@)(@@)(@@)(@@) $ 27853 قال النبي :(@)(@@) | 30 ( يا عبيدة ! أنتم أهل البيت لا يصيبنكم خصاصة إلا PageV09P173 فرجها الله عز وجل ) )(@)(@@) أبو نعيم عن عبيدة بن صيفي الجعفي رضي الله عنه .(@)(@@)(@@)(@@) $ 27854 قال النبي :(@)(@@) | 30 ( يا عثمان ! إن الله لم يبعثني بالرهبانية ، وإن خير الدين عند الله الحنيفية السمحة ) )(@)(@@) ابن سعد عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ 27855 قال النبي :(@)(@@) | 30 ( يا عثمان ! أتؤمن بما نؤمن به ؟ فأسوة مالك بنا ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27856 قال النبي :(@)(@@) | 30 ( يا عثمان ! إن الله عز وجل قد أبدلنا بالرهبانية الحنيفية السمحة والتكبير على كل شرف فإن كنت منا فاصنع كما نصنع ) )(@)(@@) ( طب ) عن أبي أمية الطائفي عن جده سعيد بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ 27857 قال النبي :(@)(@@) | 30 ( يا عثمان ! إن الرهبانية لم تكتب علينا ، أما لك في أسوة ، فوالله إني أخشاكم لله وأحفظكم لحدوده لأنا ) )(@)(@@) عبد الرزاق في المصنف ، ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27858 قال النبي :(@)(@@) | 30 ( يا عثمان ! أما لك في أسوة حسنة ؟ تقوم الليل ، وتصوم النهار ، إن لأهلك عليك حقا ، ولجسدك علي حقا ) )(@)(@@) طب ) عن أبي موسى رضي الله عنه .(@)(@@)(@@)(@@) $ 27859 قال النبي :(@)(@@) | 30 ( يا عثمان ! ألا أبشرك ؟ هاذا جبريل يخبرني عن الله : ما من مؤمن يعطس ثلاث عطسات متواليات إلا كان الإيمان في قلبه ثابتا ) )(@)(@@) الحكيم عن 
ms2971	 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27860 قال النبي :(@)(@@) | 30 ( يا ع| ثمان ! إذا اشتريت فاكتل ، وإذا بعت فكل ) )(@)(@@) ( حم هق ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 27861 ) قال النبي :(@)(@@) | 30 ( يا عثمان ! هاذا جبريل يأمرني عن الله أن أزوجك PageV09P174 أختها أم كلثوم على مثل صداقها يعني صداق رقية وعلى مثل عشرتها ) )(@)(@@) ابن منده عن سعيب بن المسيب عن عثمان بن عفان وقال : غريب ، ابن عساكر عن سعيد بن المسيب عن أبي هريرة ، يعقوب بن سفيان ، وابن عساكر عن سعيد بن المسيب مرسلا ، قال ابن عساكر : وهو المحفوظ .(@)(@@)(@@)(@@) $ 27862 قال النبي :(@)(@@) | 30 ( يا عثمان ! إنك ستؤتى الخلافة من بعدي وسيريدك المنافقون على خلعها فلا تخلعها وصم في ذالك اليوم تفطر عندي ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27863 قال النبي :(@)(@@) | 30 ( يا عثمان ! إن الله مقمصك قميصا يريدك الناس على خلعه فلا تخلعه ، فإن أنت خلعته لم ترح رائحة الجنة ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27864 قال النبي :(@)(@@) | 30 ( يا عثمان ! إن كساك الله قميصا فأرادك الناس على خلعه فلا تخلعه ، فوالله لئن خلعته لا ترى الجنة حتى يلج الجمل في سم الخياط ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27865 قال النبي :(@)(@@) | 30 ( يا عثمان ! أم قومك ، ومن أم القوم فليخفف ، فإن فيهم الضعيف والكبير وذا الحاجة ، فإذا صليت لنفسك فصل كيف شئت ) )(@)(@@) ( كر ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ 27866 قال النبي :(@)(@@) | 30 ( يا عثمان ! ما سألني عنها أحد قبلك ، تفسيرها : لا إلاه إلا الله والله أكبر ، وسبحان الله وبحمده ، وأستغفر الله ولا حول ولا قوة إلا بالله ، الأول والآخر والظاهر والباطن بيده الخير يحي ي ويميت وهو على كل شيء قدير يا عثمان ! من قالها إذا أصبح وإذا أمسى عشر مرات أعطاه الله تعالى ست خصال ، أما أولهن : فيحرس من إبليس وجنوده ، وأما الثانية : فيعطى قنطارا من الأجر ، وأما الثالثة : فترفع له درجة في الجنة ، وأما الرابعة : فيزوج من الحور العين ، وأما الخامسة : فيحضرها اثنا عشر 
ms2972	 ألف ملك ، وأما السادسة : فله من الأجر كمن قرأ PageV09P175 القرآن والتوراة والإنجيل والزبور وله مع هاذا يا عثمان من الأجر كمن حج واعتمر وقبلت حجته وعمرته ، فإن مات في يومه طبع بطابع الشهداء ) )(@)(@@) يوسف القاضي في سننه ، ( ع عق ) وابن أبي عاصم وأبو الحسن القطان في الطوالات ، وابن المنذر وابن أبي حاتم وابن السني في عمل يوم وليلة وابن مردويه ( هق ) في الإسماء عن عثمان رضي الله عنه أنه سأل رسول الله عن تفسير قوله تعالى : { له مقاليد السماوات والأرض } قال فذكره ، وأورده ابن الجوزي في الموضوعات وهو غير مسلم له .(@)(@@)(@@)(@@) $ 27867 قال النبي :(@)(@@) | 30 ( يا عثمان بن مظعون ! من صلى صلاة الفجر في جماعة ثم جلس يذكر الله حتى تطلع الشمس كان له في الفردوس سبعون درجة بعد كل درجتين كخصر الفرس الجواد المضمر سبعين سنة ، ومن صلى صلاة الظهر في جماعة كان له في جنات عدن خمسون درجة بعد ما بين كل درجتين كخصر الفرس الجواد المضمر خمسون سنة ، ومن صلى العصر في جماعة كان له كأجر ثمانية من ولد إسماعيل كلهم رب بيت يعتقهم ، ومن صلى المغرب في جماعة فهو كحجة مبرورة ، وعمرة متقبلة ، ومن صلى العشاء في جماعة كان له كقيام ليلة القدر ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27868 قال النبي :(@)(@@) | 30 ( يا عثمان ! أما ترضى ؟ ، إن للجنة ثمانية أبواب وللنار سبعة أبواب ، لا تنتهي إلى باب من أبواب الجنة إلا وجدت ابنك قائما عنده آخذا بحجزتك يشفع لك عند ربك ، قالوا : يا رسول الله ! ولنا في فرطنا مثل ما لعثمان بن مظعون ؟ قال : نعم ، لمن صبر واحتسب ) )(@)(@@) ( ك ) في تاريخه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27869 قال النبي :(@)(@@) | 30 ( يا عدي بن حاتم ! أسلم تسلم ، قال : ما الإسلام ؟ قال : تؤمن بالله وملائكته وكتبه ورسله ، وتؤمن بالقدر خيره وشره ، حلوه PageV09P176 ومره ، يا عدي بن حاتم ! لا تقوم الساعة حتى تفتح خزئن كسرى وقيصر ، يا عدي بن حاتم ! لا تقوم الساعة حتى تأتي الظعينة من الحيرة 
ms2973	 حتى تطوف بهاذه الكعبة بغير خفير ، يا عدي بن حاتم ! لا تقوم الساعة حتى يحمل الرجل جراب المال فيطوف به فلا يجد أحدا يقبله ، فيضرب به الأرض فيقول : ليتك لم تكن ، ليتك كنت ترابا ) )(@)(@@) ( طب ) و الخطيب وابن عساكر عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 27870 قال النبي :(@)(@@) | 30 ( يا ع| دي بن حاتم ! كيف أنت إذا خرجت الظعينة من قصور اليمن حتى تأتي الحيرة لا تخاف إلا الله والذئب على غنمها ، قال : فأين طيء ومقامها ؟ قال : إذن يكفيكها الله وما سواها ) )(@)(@@) ( طب ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 27871 قال النبي :(@)(@@) | 30 ( يا عدي ! لا تذدرين أصحابي لتفتحن كنوز كسرى ، ولتخرجن الظعينة من الحيرة في جوار هاذا البيت وليتشاحنن على هاذا البيت وليتشاحنن على هاذا المال في أول النهار ثم يطرح في آخره فلا يقبله أحد ) )(@)(@@) ( طب ) عن عيد بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 27872 قال النبي :(@)(@@) | 30 ( يا عدي ! ما أفرك أن يقول لا إله إلا الله ، فهل من إله إلا الله ؟ ما أفرك أن يقال : الله أكبر فهل من شيء هو أكبر من الله ؟ إن المغضوب عليهم اليهود ، وإن الضالين النصارى ) )(@)(@@) ( حم طب ) عن عدي بن أبي حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 27873 قال النبي :(@)(@@) | 30 ( يا ع| دي بن حاتم أسلم تسلم ، إنما يمنعك عن الإسلام أنك ترى بمن حولي خصاصة وأنك ترى الناس علينا إلبا هل رأيت الحيرة فليوشكن أن الظعينة ترحل من الحيرة بغير جوار حتى تطوف بالبيت ، وليفتحن علين كنوز كسرى بن هرمز ، ويوشك أن لا يجد الرجل من ماله صدقة ) )(@)(@@) ( حم ك ) عن PageV09P177 عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 27874 قال النبي :(@)(@@) | 30 ( يا عقبة بن عامر ! أمسك عليك لسانك ، وليسعك بيتك ، وابك على خطيئتك ) )(@)(@@) ( حم طب ) و الخطيب عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 27875 قال النبي :(@)(@@) | 30 ( يا عقبة ! ألا أخبرك بأفضل أخلاق أهل الدنيا وأهل الآخرة : تصل من قطعك ، وتعطي من حرمك ، وتعفو عمن ظلمك ، ألا ومن 
ms2974	 أراد أن يبس له في رزقه ويمد له في عمره ، فليتق الله وليصل رحمه ) )(@)(@@) ( حم ) و ابن أبي الدنيا في ذم الغضيب ( طب ك ) عن عقبة بن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 27876 قال النبي :(@)(@@) | 30 ( يا ع| قبة بن عامر ! إنك لن تقرأ بسورة أحب إلى الله ولا أبلغ عنده من أن تقرأ : { قل أعوذ برب الفلق } فإن استطعت أن لا تفوتك في صلاة فافعل ) )(@)(@@) ( حب طب ك هب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 27877 قال النبي :(@)(@@) | 30 ( يا عقيل ! والله إني أحبك لخصلتين : لقرابتك ، ولحب أبي طالب إياك ، وأما أنت يا جعفر فإن خلقك يشبه خلقي ، وأما أنت يا علي ، فأنت مني بمنزلة هاارون من موسى غير أنه لا نبي بعدي ) )(@)(@@) ابن عساكر عن عبد الله بن محمد بن عقيل عن أبيه عن جده عقيل بن أبي طالب .(@)(@@)(@@)(@@) $ 27878 قال النبي :(@)(@@) | 30 ( يا علي ! إن فيك من عيسى مثلا ، أبغضته اليهود حتى بهتوا أمه ، وأحبته النصارى حتى أنزلوه بالمنزلة التي ليس بها ) )(@)(@@) ( عم ) و أبو نعيم في فضائل الصحابة ( ك ) وتعقب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27879 قال النبي :(@)(@@) | 30 ( يا علي ! إن لك كنزا في الجنة وإنك ذو قرنيها ، PageV09P178 فلا تتبعن النظرة نظرة ، فإن لك الأولى وليست لك الآخرة ) )(@)(@@) ( ش حم ) و الحكيم ، ( ك ) وأبو نعيم في المعرفة عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27880 قال النبي :(@)(@@) | 30 ( يا علي ! من فارقني فقد فارق الله ، ومن فارقك فقد فارقني ) )(@)(@@) ( ك ) وتعقب عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27881 قال النبي :(@)(@@) | 30 ( يا علي ! ألا أعلمك كلمات إذا قلتهن غفر لك على أنه مغفور لك : لا إلاه إلا الله العلي العظيم ، لا إله إلا الله الحكيم الكريم ، سبحان الله رب السماوات السبع ، ورب العرش العظيم ، والحمد لله رب العالمين ) )(@)(@@) ( حم ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27882 قال النبي :(@)(@@) | 30 ( يا علي ! مر نساءك أن لا يصلين عطلا ، ومرهن فليغيرن أكفهن بالحناء لا يتشبهن بأكف الرجال ) )(@)(@@) ابن النجار 
ms2975	 عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27883 قال النبي :(@)(@@) | 30 ( يا علي ! كن سخيا فإن الله يحب السخي ، وكن شجاعا فإن الله يحب الشجاع ، وكن غيورا فإن الله يحب الغيور ، وإن امرؤ سألك حاجة فاقضها ، فإن لم يكن لها أهلا كنت أنت لها أهلا ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27884 قال النبي :(@)(@@) | 30 ( يا علي ! إذا تقرب الناس إلى الله في أبواب البر فتقرب إليه بأنواع العقل تسبقهم بالدرجات والزلفى عند الناس في الدنيا ، وعند الله في الآخرة ) )(@)(@@) ( حل بز ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27885 قال النبي :(@)(@@) | 30 ( يا علي ! إن وليت الأمر بعدي فأخرج أهل نجران من جزيرة العرب ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27886 قال النبي :(@)(@@) | 30 ( يا علي ! إني أحب لك ما أحب لنفسي ، وأكره لك PageV09P179 ما أكره لنفسي ، لا تقرأ وأنت راكع ، ولا وأنت ساجد ، ولا تصل وأنت عاقص شعرك فإنه كفل الشيطان ، ولا تقع بين السجدتين ، ولا تعبث بالحصا في الصلاة ، ولا تفترش ذراعيك ، ولا تفتت على الإمام ، ولا تتختم بالذهب ، ولا تلبس القسي ولا المعصفر ، ولا تركب على المياثر الحمر فإنها مراكب الشيطان ) )(@)(@@) عبد الرزاق ، ( هق ) عن علي رضي الله عنه ضعيف .(@)(@@)(@@)(@@) $ 27887 قال النبي :(@)(@@) | 30 ( يا علي ! أخصمك بالنبوة ولا نبوة بعدي ، وتخصم الناس بسبع ولا يحاجك فيه أحد من قريش : أنت أولهم إيمانا بالله ، وأوفاهم بعهد الله ، وأقومهم بأمر الله ، وأقسمهم بالسوية ، وأعدلهم في الرعية ، وأبصرهم بالقضية ، وأعظمهم عند الله مزية ) )(@)(@@) ( حل ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 27888 قال النبي :(@)(@@) | 30 ( يا علي ! لك سبع خصال لا يحاجك فيهن أحد يوم القيامة : أنت أول المؤمنين بالله إيمانا ، وأوفاهم بعهد الله ، وأقومهم بأمر الله ، وأرأفهم بالرعية ، وأقسمهم بالسوية ، وأعلمهم بالقضية ، وأعظمهم مزية يوم القيامة ) )(@)(@@) ( حل ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 27889 قال النبي :(@)(@@) | 30 ( يا علي ! إن الله تعالى قد زينك بزينة لم يزين العباد بزينة أحب إلى الله تعالى منها ، هي زنية الأبرار عند 
ms2976	 الله تعالى : الزهد في الدنيا ، فجعلك لا ترزأ من الدنيا شيئا ، ولا ترزأ الدنيا منك شيئا ، ووهب لك حب المساكين فجعلك ترضى بهم أتباعا ويرضون بك إماما ) )(@)(@@) ( حل ) عن عصار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ 27890 قال النبي :(@)(@@) | 30 ( يا علي ! اتق دعوة المظلوم ، فإنما يسأل الله تعالى حقه ، وإن الله لن يضيع لذي حق حقه ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن علي رضي الله عنه .(@)(@@) PageV09P180(@)(@@)(@@)(@@) $ 27891 قال النبي :(@)(@@) | 30 ( يا علي ! أنت تبين لأمتي ما اختلفوا فيه من بعدي ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27892 قال النبي :(@)(@@) | 30 ( يا علي ! أنت تغسل جثتي وتؤدي ديني ، وتواريني في حفرتي ، وتفي بذمتي ، وأنت صاحب لوائي في الدنيا والآخرة ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 27893 قال النبي :(@)(@@) | 30 ( يا علي ! إذا حزبك أمر فقل : اللهم احرسني بعينك التي لا تنام ، واكنفني بركنك الذي لا يرام ، واغفر لي بقدرتك علي فلا أهلك وأنت رجائي ، رب كم من نعمة أنعمت بها علي قل لك عندها شكري ، وكم من بلية ابتليتني بها قل لك عندها صبري ، فيا من قل عند نعمته شكري فلم يحرمني ، ويا من قل عند بليته صبري فلم يخذلني ، ويا من رآني على الخطايا فلم يفضحني ، يا ذا المعروف الذي لا ينقضي أبدا ، ويا ذا النعماء التي لا تحصى أبدا ، أسألك تصلي على محمد وعلى آل محمد وبك أدرأ في نحور الأعداء والجبارين والطغاة والمتمردين الحديث ) )(@)(@@) ( فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27894 قال النبي :(@)(@@) | 30 ( يا علي ! غط فخذك فإنها من العورة ) )(@)(@@) ( هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27895 قال النبي :(@)(@@) | 30 ( يا علي ! إني أحب لك ما أحب لنفسي ، وأكره لك ما أكره لنفسي ، لا تلبس المعصفر ولا تختم بالذهب ، ولا تلبس القسي ، ولا تركبن على ميثرة حمراء فإنها من مياثر إبليس ) )(@)(@@) القاضي عبد الجبار في أماليه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27896 قال النبي :(@)(@@) | 30 ( يا علي ! يدك في يدي تدخل معي يوم القيامة حيث أدخل ) )(@)(@@) أبو 
ms2977	 بكر الشافعي في الغيلانيات وأبو نعيم في فضائل الصحابة وابن عساكر عن عمر رضي الله عنه .(@)(@@) PageV09P181(@)(@@)(@@)(@@) $ 27897 قال النبي :(@)(@@) | 30 ( يا علي ! الناس رجلان : فعاقل يصلح للعفو ، وجاهل يصلح للعقوبة ) )(@)(@@) ابن عساكر عن علي رضي الله عنه قال : لما أنفذني النبي إلى اليمن قال فذكره .(@)(@@)(@@)(@@) $ 27898 قال النبي :(@)(@@) | 30 ( يا علي ! مثل الذي لا يتم صلاته كمثل حبلى حملت ، فكلما دنا نفاسها أسقطت ، فلا هي ذات حمل ولا هي ذات ولاد ، يا علي ! مثل المصلي كالتاجر لا يخلص له ربحه حتى يأخذ رأس ماله ، كذلك المصلي لا تقبل له نافلة حتى يؤدي الفريضة ) )(@)(@@) الرامهرمزي في الأمثال ، ( هق كر ) وابن النجار عن علي ، وفيه موسى بن عبيدة ضعيف .(@)(@@)(@@)(@@) $ 27899 قال النبي :(@)(@@) | 30 ( يا علي ! سيولد لك ولد بعدي قد نحلته اسمي وكنيتي ) )(@)(@@) ( هق ) و ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27900 قال النبي :(@)(@@) | 30 ( يا علي ! الناس من شجر شتى وأنا وأنت من شجرة واحدة ) )(@)(@@) ( ت ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 27901 قال النبي :(@)(@@) | 30 ( يا علي ! أوصيك بالعرب خيرا ، أوصيك بالعرب خيرا ) )(@)(@@) ( طب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27902 قال النبي :(@)(@@) | 30 ( يا علي ! من هاذا فأصب فإنه أوفق لك ) )(@)(@@) ( ت ) حسن غريب عن أم المنذر رضي الله عنها .(@)(@@)(@@)(@@) $ 27903 قال النبي :(@)(@@) | 30 ( يا علي ! ستقاتلك الفئة الباغية وأنت على الحق ، فمن لم ينصرك يومئذ فليس مني ) )(@)(@@) ابن عساكر عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ 27904 قال النبي :(@)(@@) | 30 ( يا علي ! إن الإسلام عريان : لباسه التقوى ، ورياشه الهدى ، وزينته الحياء ، وعماره الورع ، وملاكه العمل الصالح ، وأساس الإسلام حبي وحب أهل بيتي ) )(@)(@@) ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27905 قال النبي :(@)(@@) | 30 ( يا علي ! ما من أهل بيت كانوا في حبرة إلا ستتبعهم PageV09P182 بعد ذلك عبرة ، يا علي ! كل نعيم يزول إلا نعيم أعل الجنة ، وكل هم منقطع إلا هم أهل النار ، يا علي ! عليك بالصدق وإن ضرك في العاجل كان فرجا لك في الآجل ) )(@)(@@) ابن أبي الدنيا 
ms2978	 وابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27906 قال النبي :(@)(@@) | 30 ( يا علي ! ألا أعلمك دعاء تدعو به ، لو كان عليك مثل عدد الذر ذنوبا لغفرت لك مع أنه مغفور لك قل : اللهم لا إله إلا أنت الحليم الكريم ، تباركت سبحانك رب العرش العظيم ) )(@)(@@) ( طب ) عن عمرو بن رة وزيد بن أرقم رضي الله عنهما معا .(@)(@@)(@@)(@@) $ 27907 قال النبي :(@)(@@) | 30 ( يا علي ! أنت مني بمنزلة هاارون من موسى إلا أنه لا نبي بعدي ) )(@)(@@) ( طب ) عن أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) $ 27908 قال النبي :(@)(@@) | 30 ( يا علي ! أتحب هاذين الشيخين ؟ يعني أبا بكر وعمر أحبهما تدخل الجنة ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27909 قال النبي :(@)(@@) | 30 ( يا علي ! أسبغ الوضوء وإن شق عليك ، ولا تأكل الصدقة ، ولا تنز الخيل على الحمر ، ولا تجالس أصحاب النجوم ) )(@)(@@) ( حم ع ) و الخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27910 قال النبي :(@)(@@) | 30 ( يا علي ! طوبى لمن أحبك وصدق فيك ، وويل لمن أبغضك وكذب فيك ) )(@)(@@) ( طب ك ) وتعقب و الخطيب عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ 27911 قال النبي :(@)(@@) | 30 ( يا علي ! إنك عبقريهم ) )(@)(@@) الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27912 قال النبي :(@)(@@) | 30 ( يا علي ! ما خاب من استخار ولا ندم من استشار ، يا علي ! عليك بالدلجة ، فإن الأرض تطوى بالليل ما لا تطوى بالنهار ، يا علي ! أغد PageV09P183 بسم الله ، فإن الله بارك لأمتي في بكورها ) )(@)(@@) الخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27913 قال النبي :(@)(@@) | 30 ( يا علي ! جزاك الله والإسلام خيرا ، فك الله رهانك يوم القيامة كما فككت رهان أخيك المسلم ، ليس من عبد يقضي عن أخيه دينا إلا فك الله عنه رهانه يوم القيامة ، قيل : يا رسول الله ! ألعلي خاصة ؟ قال : لا بل للمسلمين عامة ) )(@)(@@) ( هق ) وضعفه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27914 قال النبي :(@)(@@) | 30 ( يا علي ! تعلم القرآن وعلمه الناس ، فلك بكل حرف عشر حسنات ، فإن مت مت شهيدا ، يا علي ! تعلم القرآن وعلمه الناس ، فإن 
ms2979	 مت حجت الملائكة إلى قبرك كما يحج الناس إلى بيت الله العتيق ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27915 قال النبي :(@)(@@) | 30 ( يا علي ! كبر في دبر صلاة الفجر من يوم عرفة إلى آخر أيام التشريق صلاة العصر ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27916 قال النبي :(@)(@@) | 30 ( يا علي ! إن جبريل زعم أنه يحبك ، قال : وقد بلغت أنه يحبني جبريل ؟ قال : نعم ، ومن هو خير من جبريل : الله عز وجل يحبك ) )(@)(@@) الحسن بن سفيان عن أبي الضحاك الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ 27917 قال النبي :(@)(@@) | 30 ( يا علي ! سألت الله ثلاثا أن يقدمك ، فأبى علي إلا أن يقدم أبا بكر ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27918 قال النبي :(@)(@@) | 30 ( يا علي ! في العرش مكتوب : أن الله محمد رسولي ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27919 قال النبي :(@)(@@) | 30 ( يا علي ! قص الظفر ، ونتف الإبط ، وحلق العانة ، يوم الخميس ، والطيب واللباس يوم الجمعة ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27920 قال النبي :(@)(@@) | 30 ( يا علي ! مر نساءك لا يصلين عطلا ولو أن يتقلدن PageV09P184 سيراء ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27921 قال النبي :(@)(@@) | 30 ( يا علي ! إن الله أمرني أن أتخذ أبا بكر والدا ، وعمر مشيرا ، وعثمان سندا ، وأنت يا علي ظهيرا ، فأنتم أربعة قد أخذ الله ميثاقكم في أم الكتاب ، لا يحبكم إلا مؤمن ، ولا يبغضكم إلا فاجر ، أنتم خلائف نبوتي ، وعقد ذمتي ، وحجتي على أمتي ، لا تقاطعوا ولا تدابروا وتغافروا ) )(@)(@@) أبو نعيم في فضائل الصحابة وابن عساكر عن علي ، ابن عساكر عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 27922 قال النبي :(@)(@@) | 30 ( يا عمر ! ألا أدلك على ختن خير لك من عثمان ، وأدل عثمان على ختن خير له منك ؟ زوجني ابنتك وأزوج عثمان ابنتي ) )(@)(@@) ( ك هق ) و ابن عساكر عن عثمان ، ابن عساكر عن عثمان ، ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27923 قال النبي :(@)(@@) | 30 ( يا عمر ! إن القرآن كله صواب ما لم يجعل عذاب مغفرة ، ومغفرة 
ms2980	 عذابا ) )(@)(@@) ( حم ) و سمويه عن إسحاق بن عبد الله بن أبي طلحة عن أبيه عن جده .(@)(@@)(@@)(@@) $ 27924 قال النبي :(@)(@@) | 30 ( يا عمر ! أنا وهو كنا أحوج إلى غير هاذا : أن تأمرني بحسن الأداء وتأمره بحسن اتباعه ، اذهب به يا عمر فأعطه حقه وزده عشرين صاعا من تمر مكان ما رعته ) )(@)(@@) ( طب ك ) عن محمد بن حمزة بن يوسف بن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ 27925 قال النبي :(@)(@@) | 30 ( يا عمر ! ارجع فإن غضبك عز ، ورضاك حكم ، إن لله في السماوات السبع ملائكة يصلون له عني عن صلاة فلان ، قال عمر : وما صلاتهم ؟ فلم يرد عليه شيئا ، فأتى جبريل فقال : يا نبي الله ! سألك عمر عن صلاة أهل السماء ، قال : نعم ، فقال : اقرأ على عمر السلام وأخبره أن أهل السماء الدنيا PageV09P185 سجود إلى يوم القيامة يقولون : سبحان ذي الملك والملكوت ، وأهل السماء الثانية ركوع إلى يوم القيامة يقولون : سبحان ذي العزة والجبروت ، وأهل السماء الثالثة قيام إلى يوم القيامة يقولون : سبحان الحي الذي لا يموت ) )(@)(@@) ابن جرير ( حل ) عن سعيد بن جبير مرسلا .(@)(@@)(@@)(@@) $ 27926 قال النبي :(@)(@@) | 30 ( يا عمر إنك رجل قوي لا تزاحم على الحجر فتؤذي الضعيف ، إن وجدت خلوة فاستلمه وإلا فاستقبله فهلل وكبر ) )(@)(@@) ( حم ) و العدني ( هق ) عن عمر رضي الله عنه البغوي عن شيخ من خزاعة .(@)(@@)(@@)(@@) $ 27927 قال النبي :(@)(@@) | 30 ( يا عمر ! وترت قوسك بغير وتر ، ما بين صدقتيكما كما بين كلمتيكما ) )(@)(@@) أبو نعيم عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ 27928 قال النبي :(@)(@@) | 30 ( يا عمر ! إن رأيت عليا قد سلك واديا وسلك الناس واديا غيره فاسلك مع علي ودع الناس ، إنه لن يدلك على رديء ، ولن يخرجك من الهدى ) )(@)(@@) الديلمي عن عمار بن ياسر وعن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ 27929 قال النبي :(@)(@@) | 30 ( يا عمر ! يكون في أمتي في آخر الناس رجل يقال له أويس القرني ، يصيبه بلاء في جسده ، فيدعو الله عز وجل فيذهب به إلا لمعة في جنبه إذا رآها ذكر 