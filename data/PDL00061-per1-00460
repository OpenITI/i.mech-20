ms454	 دل PageV1P0911(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مسلمانان سلامت به چو بتوانید من گفتم %~% دل بیچارگان از خود مرنجانید من گفتم(@)(@@) 2 به مال و جاه چندینی نباید غره گردیدن %~% ز گرد این و آن دامن برافشانید من گفتم(@)(@@) 3 درین بستان که دل بستید اگرتان دسترس باشد %~% برای خود درخت نیک بنشانید من گفتم(@)(@@) 4 به گردد حال ازین سامان که می‌بینید و این آیین %~% شما هم حال‌ها برخود بگردانید من گفتم(@)(@@) 5 پی نام کسان رفتن به عیب انصاف چون باشد %~% نخستین نامه خود را فرو خوانید من گفتم(@)(@@) 6 دل درماندگان خستن خطا باشد که هم در پی %~% شما نیز این چنین یک روز درمانید من گفتم(@)(@@) 7 حدیث اوحدی این بود و تدبیری که می‌داند %~% تمامست این قدر باقی شما دانید من گفتم PageV1P0912(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چشم صاحب دولتان بیدار باشد صبحدم %~% عاشقان را نالهای زار باشد صبحدم(@)(@@) 2 آن جماعت را که در سینه ز شوق آتش بود %~% کارگاه سوز دل بر کار باشد صبحدم(@)(@@) 3 صبحدم باید شدن در کوی او کز شاخ وصل %~% هر گلی کت بشکفد بی‌خار باشد صبحدم(@)(@@) 4 کوی او بی‌زحمت ناجنس باشد صبح‌گاه %~% راه او بی‌زحمت اغیار باشد صبحدم(@)(@@) 5 پرده بردار سعادت وقت صبح از روی و این %~% آن تواند دید کو بیدار باشد صبحدم(@)(@@) 6 مرده دل در خواب نوشینست و دولت در گذار %~% شادمان آندل که دولتیار باشد صبحدم(@)(@@) 7 طالبان پرتو خورشید روی دوست را %~% چشم بر در روی بر دیوار باشد صبحدم(@)(@@) 8 زنده‌داران شب امید را بر در گهش %~% دیدها دریای گوهربار باشد صبحدم(@)(@@) 9 روز اگر با عمرو و با زیدست رازی خلق را %~% راز دل با خالق جبار باشد صبحدم(@)(@@) 10 زنده‌داران شب امید را بر درگهش %~% دیدها دریای گوهر بار باشد صبحدم(@)(@@) 11 از در رحمت به دست آویزی «هل من سائل» %~% سایلان را کوی حضرت بار باشد صبحدم(@)(@@) 12 گر تو می‌خواهی 
ms455	 که بگشاید در احسان او %~% بر در او رفتنت ناچار باشد صبحدم(@)(@@) 13 گرچه کمیابی کسی در صبحدم ناخفته لیک %~% حاضری زانخفتگان بیدار باشد صبحدم(@)(@@) 14 تیر آه دردمندان در کمینگاه دعا %~% از کمان سینه‌ها طیار باشد صبحدم(@)(@@) 15 هر شبت میگویم این و عقل میگوید: بلی %~% پند گیرد خواجه گر هشیار باشد صبحدم(@)(@@) 16 آنکه در خوردن بود روز دراز او به سر %~% خفته بگذارش که بس بیمار باشد صبحدم(@)(@@) 17 در شب شهوت گر از گل بستر و بالین کنی %~% آنچنان بالین و بستر مار باشد صبحدم(@)(@@) 18 دست با هر کس که دادی در میان همچون کمر %~% باز باید کرد کان زنار باشد صبحدم(@)(@@) 19 چرخ با صد دیده می‌بیند ترا جایی چنین %~% آدمی را خود ز خفتن عار باشد صبحدم(@)(@@) 20 اوحدی گر زان شب بیچارگی خوفیت هست %~% چاره کار تو استغفار باشد صبحدم(@)(@@) 21 قصه بیدار شو با خفته‌ای مردانه گو %~% کین سخن با کاهلان دشوار باشد صبحدم PageV1P0913(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 سرم خزینه خوفست و دل سفینه بیم %~% ز کرده خود و اندیشه عذاب الیم(@)(@@) 2 گناه کرده به خروار هیچ طاعت نه %~% مگر ببخشدم از لطف خود خدای کریم(@)(@@) 3 ز راه دور فتادم که غول بود رفیق %~% ز عقل بهره ندیدم که دیو بود ندیم(@)(@@) 4 ادیم روی من از پنجه ندم سیهست %~% بجز ندم نکند کس سیه رخ چو ادیم(@)(@@) 5 بیا به خود مرو این راه را که در پیشست %~% گزندهای درشتست و بندهای عظیم(@)(@@) 6 دونیمه شد دلت اندر میان دین و درم %~% ببین که: برتو چه آید برین دل بدونیم(@)(@@) 7 حیات جان عزیزت به نور ایمان بود %~% عزیز یوسف خود را چرا فروخت به سیم(@)(@@) 8 چو کار خویش نکردی بهیچ رویی راست %~% ضرورتست که روراست میروی به جحیم(@)(@@) 9 ز خط خواجه خود سر نمی‌توان برداشت %~% به حکم او بنه ار بنده‌ای سر تسلیم(@)(@@) 10 بهر حدیث 
ms456	 که خواهی نصیحتت کردم %~% هنوز باز نگشتی تو از ضلال قدیم(@)(@@) 11 منزها به کسانی که وا دل ایشان %~% بجز مقامه ذکر تو نیست هیچ مقیم(@)(@@) 12 که چون مرا هوس و آز من شکنجه کند %~% دلم ز پنجه شهوت برون کشی تو سلیم(@)(@@) 13 مرا به خویشتن و عقل خویش باز مهل %~% که عاجزست ز درمان درد خویش سقیم(@)(@@) 14 ز علم خویشتنم نکته‌ای در آموزان %~% خلاف علم خلافی که کرده‌ام تعلیم(@)(@@) 15 ببخش اگر گنهی کرده‌ام که نیست عجب %~% گنه ز بنده نادان و مغفرت ز حکیم(@)(@@) 16 پس از گناه چنان بنده عذرهای چنین %~% به پایمردی لطف تو میکنم تقدیم(@)(@@) 17 اگر به دو زخم از راه خلت اندازی %~% تفاوتی نکند کآتش است و ابراهیم(@)(@@) 18 تو خود عظیمی اگر گویم ارنه لیکن من %~% به نام پاک تو خود را همی کنم تعظیم(@)(@@) 19 نه سیم خواهم ونی زر ولی چو خاک شوم %~% ز لطف خویش به خاکم همی فرست نسیم(@)(@@) 20 در آن زمان که به حال شکستگان نگری %~% به اوحدی نظری برکن ای کریم و رحیم PageV1P0914(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بار بسیارست و راه دور در پیش ای جوان %~% این زمان از محنت پیری بیندیش ای جوان(@)(@@) 2 کیش بر بستی که نفس دیگری قربان کنی %~% نفس خود قربان کن و بر گرد ازین کیش ای جوان(@)(@@) 3 خویش را بیگانه کردن نیست نیکو بعد ازین %~% جهد آن کن تا کنی بیگانه را خویش ای جوان(@)(@@) 4 گر همی خواهی که باشی پیر عهد دیگری %~% خاطر پیران عهد خود مکن ریش ای جوان(@)(@@) 5 کامرانی کرده‌ای از روز ناکامی منال %~% نوش کم خور تا نباید خوردنت نیش ای جوان(@)(@@) 6 چون زبردستان نکن با زیردستان بد که زود %~% گرگ موذی را بسوزد کشتن میش ای جوان(@)(@@) 7 در دو گیتی محتشم کس را مدان جز کردگار %~% کین دگرها جمله درویشند درویش ای جوان(@)(@@) 8 پیش‌بینان پس‌اندیش 
ms457	 از ملامت فارغند %~% گر پس اندیشیست اینک گفتم از پیش ای جوان(@)(@@) 9 مگذر از فرمان خالق رحم کن برخلق او %~% کاوحدی چیزی نمیدانست زین بیش ای جوان PageV1P0915(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دلخسته همی باشم زین ملک بهم رفته %~% خلقی همه سرگردان دل مرده و دم رفته(@)(@@) 2 یک بنده نمی‌یابم هنجار وفا دیده %~% یک خواجه نمی‌بینم بر صوب کرم رفته(@)(@@) 3 بر صورت انسانند از سبک و ریش اما %~% چون دیو برغم هم درلا و نعم رفته(@)(@@) 4 تن صدق کجا ورزد بر خال به خون عاشق %~% دل راست کجا گردد در زلف به خم رفته(@)(@@) 5 من در حرم گردون ایمن شده و زهردون %~% هرجور که ممکن شد بر صید حرم رفته(@)(@@) 6 راهی نه ز پیش و پس در شهر چنین بی‌کس %~% من خفته و همراهان با طبل و علم رفته(@)(@@) 7 بر لوح جهان نقشی چون نیست به کام من %~% من نیز نهادم سر بر خط قلم رفته(@)(@@) 8 از گفته و کرد من وز محنت و درد من %~% شد چهره زرد من در نیل و بقم رفته(@)(@@) 9 چون چرخ بسی گشته من در پی کام دل %~% وین چرخ به کام من دردا! که چه کم رفته!(@)(@@) 10 لافم نرسید ارچه این راه به سر رفتم %~% تا در چه رسد گویی مرد به قدم رفته(@)(@@) 11 با خلق ز هر جنسی ما را چه وفا بوده %~% وآنگاه ز ناجنسان برما چه ستم رفته(@)(@@) 12 مشنو که: به راه آیند اینها به حدیث ما %~% کی رنگ شفا گیرد جان بالم رفته(@)(@@) 13 در سر مکن این سودا بسیار که خواهی دید %~% از کاسه سر سودا وز کیسه درم رفته(@)(@@) 14 آن روز شوی واقف زین حال که بینی تو %~% از جان نژند تو این روح دژم رفته(@)(@@) 15 گرچشم دلی داری از ماتم دلبندان %~% بس چشم ببینی تو در گریه و نم رفته(@)(@@) 16 در پرده این 
ms458	 بازی بنگر که: پیاپی شد %~% زن‌زاده پسر مرده خال آمده عم رفته(@)(@@) 17 خیل و حشم سلطان دیدی پس ازین بنگر %~% زین مرحله سلطان را بی‌خیل و حشم رفته(@)(@@) 18 در بیم بلا بودن یک چند و به صد حسرت %~% از بوم وجود آخر بر بام عدم رفته(@)(@@) 19 آن سر نشود هرگز لایق به کله داری %~% کو همچو قبا باشد دربند شکم رفته(@)(@@) 20 با اوحدی ارشادی می‌بود کجا گشتی %~% در هر طرفی از وی صد نامه غم رفته(@)(@@) 21 بگذاشت به مسکینی با آنکه تو می‌بینی %~% ذکرش به عرب ظاهر نامش به عجم رفته PageV1P0916(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای صوفی سرد نارسیده %~% چون پیر شدی جهان ندیده(@)(@@) 2 گفتی که: مرید پرورم من %~% آه از سخن نپروریده!(@)(@@) 3 تو عام خری و عامیان خر %~% ایشان زتو خرخری خریده(@)(@@) 4 ببریده ز علم و بهر جاهی %~% با یک دو سه جاهل آرمیده(@)(@@) 5 بر راه منافقی دو چون خود %~% صد دام نفاق گستریده(@)(@@) 6 گه ناله دور از آتش دل %~% گه گریه بی‌سرشک دیده(@)(@@) 7 پشتت به نماز اگر شود خم %~% آن هم به ریا شود خمیده(@)(@@) 8 گفتی که : شراب شوم باشد %~% وآن کس که شراب را مزیده(@)(@@) 9 این خود گویی ولی به خلوت %~% هم درد خوری و هم چکیده(@)(@@) 10 تا کی گویی : فلان چنین گفت %~% اخبار ز دیده کن ز دیده(@)(@@) 11 تو راه بری اگر بدانی %~% نه راهبری نه ره بریده(@)(@@) 12 از پرده برون نیامدی هیچ %~% وانگاه چه پرده‌ها دریده(@)(@@) 13 آن سینه که جای شوق باشد %~% او را تو بنان در آگنیده(@)(@@) 14 در خانه مردمان ز شهوت %~% هم چشمت و هم دهان خزیده(@)(@@) 15 چون خرمگسان بخورده در دم %~% هر شهد که صد مگس بریده(@)(@@) 16 خرمای حرام ظالمان را %~% در شب‌چره چون مویز چیده(@)(@@) 17 برکنده ز هر تنی قبا لیک %~% هم بر تن خویشتن تنیده(@)(@@) 18 خامی تو به شاخ 
ms459	 بر ولی ما %~% افتاده چو میوه رسیده(@)(@@) 19 تو منصب مهتری گرفته %~% ما رندی و عاشقی گزیده(@)(@@) 20 تو صفه زرق درگشاده %~% ما صافی عشق درکشیده(@)(@@) 21 من نوش سخن بر تو برده %~% وز نیش تو عقربم گزیده(@)(@@) 22 چون درفتد این عنان به دستت %~% در هیچ رکاب نادویده(@)(@@) 23 ای کبر تو خارهای هستی %~% در سینه نیستان خلیده(@)(@@) 24 چندان که تو آب خورده باشی %~% ما شربت خون دل چشیده(@)(@@) 25 فردا بینی ترنج برجای %~% وانگاه تو دست خود بریده(@)(@@) 26 تو در پی صید دیگرانی %~% وآن صید که داشتی رمیده(@)(@@) 27 چون پیش قفس رسی بدانی : %~% کان مرغ بجاست یا پریده(@)(@@) 28 این حق بشنو ز من که این هست %~% حق گفته و اوحدی شنیده PageV1P0917(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چو بد کنی و ندانی که : نیک نیست که کردی %~% معاف باش و گر عاقلی معاف نگردی(@)(@@) 2 ترا به باغ حقیقت چه کار و گلشن معنی %~% که فتنه چمن لاله و حدیقه دردی(@)(@@) 3 طریق عشق گرفتی و منهزم ز ملامت %~% تو کز کلوخ حذر می‌کنی چه مرد نبردی(@)(@@) 4 خبر ز کرده مردان شنیده‌ای به تواتر %~% مباش غافل و کاری بکن تو نیز که مردی(@)(@@) 5 گرت کند هوس روی سرخ توبه کن از بد %~% که جز به توبه نشوید کسی ز روی تو زردی(@)(@@) 6 گرفتمت که بکوبم بسی به پتک نصیحت %~% چه آلت از تو توان ساختن که آهن سردی(@)(@@) 7 تو از دو قطره آب آمدی پدید وزین پس %~% چو باد مرگ جهد بر سرت دو دانه گردی(@)(@@) 8 درون دردکشان را ز سوز چاره نباشد %~% تو هیچ سوز نداری مگر نه صاحب دردی(@)(@@) 9 ز پیش خورد غم خوردنت خدای و تو دایم %~% در آن هوس که : نویسی حدیث خوردم و خوردی(@)(@@) 10 چو کعبتین چه سود ار هزار نقش برآری %~% که همچو مهره بد باز در مششدر نردی(@)(@@) 11 چه می‌کنی هوس ای 
ms460	 اوحدی نصیحت مردم %~% چرا بساط هوی و هوس فرو ننوردی(@)(@@) 12 به قول بیهوده‌کاری برون نمی‌رود این‌جا %~% ترا چه کار بکس چون تو نیز کار نکردی PageV1P0918(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای رنج ناکشیده که میراث می‌خوری %~% بنگر که: کیستی تو و مال که می‌بری(@)(@@) 2 او جمع کرد و چون به نمی‌خورد ازو بماند %~% دریاب کز تو باز نماند چو بگذری(@)(@@) 3 مردم به دستگاه توانگر نمی‌شود %~% درویش را چو دست بگیری توانگری(@)(@@) 4 از قوت و خرقه هرچه زیادت بود ترا %~% با ایزدش معامله کن گر مبصری(@)(@@) 5 زر غول مرد باشد و زن غل گردنش %~% در غل غول باشی تا با زن و زری(@)(@@) 6 شوهر کشیست ای پسر این دهر بچه‌خوار %~% برگیر ازو تو مهر و مگیرش به مادری(@)(@@) 7 فرزند بنده‌ایست خدا را غمش مخور %~% کان نیستی که به ز خدا بنده پروری(@)(@@) 8 گر مقبلیست گنج سعادت از آن اوست %~% ور مدبرست رنج زیادت چه می‌بری(@)(@@) 9 ای خواجه ملک را که به دست تو داده‌اند %~% قانون بد منه که به کلی تو می‌خوری(@)(@@) 10 بی‌عدل ملک دیر نماند نگاه دار %~% مال رعیت از ستم و جور لشکری(@)(@@) 11 گرد هوی مگرد که گردد وبال تو %~% گر خود به بال جعفر طیار می‌پری(@)(@@) 12 دریای فتنه این هوس و آرزوی تست %~% در موج او مرو چو ندانی شناوری(@)(@@) 13 این شست و شوی جبه و دستار تا به کی %~% دست از جهان بشوی که آنست گازری(@)(@@) 14 هرگز نباشدت به بد دیگران نظر %~% در فعل خویشتن تو اگر نیک بنگری(@)(@@) 15 پر سرمکش که عاقبت از بهر کشتنت %~% ناگه رسن دراز کند چرخ چنبری(@)(@@) 16 جای خرد به مرتبه بالای چرخهاست %~% رو با خرد نشین که تو از چرخ برتری(@)(@@) 17 بوجهل را ز کعبه به دوزخ کشید جهل %~% پیش خرد نتیجه جهلست کافری(@)(@@) 18 ظلمت خلاف نور بود زان کشید ابر %~% شمشیر برق در رخ 