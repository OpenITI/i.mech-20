ms301	 يطير من الفرح % % 3(@)(@@) % هذا دواء للهموم مجرب % فاسمع نصيحة حازم لك قد نصح % 4(@)(@@) % ودع الزمان فكم نصيح حازم % قد رام إصلاح الزمان فما صلح % PageV01P1134 البحر : - 1(@)(@@) % غرد الطير في الرياض وناحا % % وشكا العشق والغرام وباحا % % 2(@)(@@) % ونسيم الشمال أهدى سحيرا % من شذا الزهر عرفه الفياحا % % 3(@)(@@) % واجتلينا على الندى والتداني % % بكر دن برأسها الشيب لاحا % % 4(@)(@@) % بنت كرم تجلى لكل كريم % % وسنا نورها كسا الأقداحا % % 5(@)(@@) % تجلب الأنس والسرور إلينا % % كيف لا وهي تنشىء الأفراحا % % 6(@)(@@) % كلما أظلم الظلام علينا % % واقتبسنا من نورها مصباحا % % 7(@)(@@) % أشرقت في الكؤوس كالشمس ليلا % فحسبنا المساء منها صباحا % % PageV01P1135 البحر : - 1(@)(@@) % وافى وحياني بكأس وراح % والهم عن قلبي تقضى وراح % 2(@)(@@) % وبات يسقي الخمر في روضة % زينها الورد وزهر الأقاح % 3(@)(@@) % ولم يشفف لي كؤوس الطلا % فقلت يا روحي وزين الملاح % 4(@)(@@) % إن كنت قد عربدت في سكرتي % % فما على السكران أصلا جناح % 5(@)(@@) % أو كنت قد أخطأت في لفظة % فأنت يا مولاي رب السماح % 6(@)(@@) % فبالذي ولاك في مهجتي % % لا تسقني الكاسات إلا طفاح % 7(@)(@@) % وداو بالوصل عليل الهوى % % فطالما أثخنت قلبي جراح % 8(@)(@@) % فالحمد لله الذي قد صفا % % مقامنا من غير واش ولاح % 9(@)(@@) % فافتر عن ثغره باسما % فبان لي الدر بفيه ولاح % PageV01P1136 البحر : - 1(@)(@@) % قيل لي لم ذممت كل البرايا % % وهجوت الأنام هجوا قبيحا % % 2(@)(@@) % قلت هب أنني كذبت عليهم % % فأروني من يستحق المديحا % % PageV01P1137 البحر : - 1(@)(@@) % شهدت لنا كبد ترق كما % % شهدت بذاك لطافة الكشح % PageV01P1138 البحر : - 1(@)(@@) % يا صارخا في جموع ليس تصرخه % للظالمين غدا في النار مصطرخ % 2(@)(@@) % قوم أفاعيلهم من قبحها تصرخه % % كما مواعيدهم من إفكها نفخ % 3(@)(@@) % أقول لابن غياث إذ رأيت له % % شيخا خساسته تخزيه لا الشيخ % 4(@)(@@) % لم أنت أصيد تزهاه نظافته % % ولم أبوك عليه الذل والوسخ % 5(@)(@@) % فقال لا تلحينا في تفاوتنا % % فإننا كتب آباؤنا نسخ % 6(@)(@@) % وقال أيضا وفي الأمثال متسع % قد يخرج النخلة الموصوفة السبخ % PageV01P1139 البحر : - 1(@)(@@) % ما تجزع الشاة إذا شحطت 
ms302	 % من ألم الذبح ولا السلخ % 2(@)(@@) % ولا من التفصيل منكوسة % ولا من الشي ولا الطبخ % % 3(@)(@@) % لكنها تجزع من خلة % تقدح في الأحشاء بالمرخ % 4(@)(@@) % لشفق أن يكتب في جلدها % % شعرك يا ذا القرن والكشخ % PageV01P1140 البحر : - 1(@)(@@) % يقول ابن عمار مقالة مخلص % لسيد تركستان طرا وخزلخ % 2(@)(@@) % إليك أبا عثمان أهدي تحية % ثناء كريحان الجنان المضمخ % 3(@)(@@) % شكرتك أن أوليتني ومنحتني % % عواطف نعمي ماجد منك أبلخ % 4(@)(@@) % رددت لي الإشراع بعد بطوله % فبؤت بعز باذخ كل مبذح % 5(@)(@@) % وأمنت قلبي أن أسام هضيمة % فأفرخ عنه روعه كل مفرخ % 6(@)(@@) % نسخت بمر الحق مظنون شبهة % أخالت ومهما ينسخ الحق ينسخ % 7(@)(@@) % وقد كان مات الحق إلا حشاشة % ولكن نفخت الروح في كل منفخ % 8(@)(@@) % فأضحى يرى بين العداء وبينه % بمنعك منه برزخا أي برزخ % 9(@)(@@) % ولا بدع أن دوخت بالحق باطلا % فكم باطل بالعدل منك مدوخ % 10(@)(@@) % وكان ابن عمار يرجيك للتي % % يقال لها عند الشدائد بخ بخ % % PageV01P1141 11(@)(@@) % وكنت الذي يحنو على مستجيره % بعارفة المولى وعائدة الأخ % % 12(@)(@@) % ولو أن داري حسب همك في العلا % % وفي العرف أضحى صحنها ألف فرسخ % % 13(@)(@@) % فكيف ترى الإضرار بي في جناحها % % أبى ذاك مجد شامخ كل مشمخ % 14(@)(@@) % أقول لعنس أقبلت بمخبها % % على الأين تفري سربخا بعد سربخ % 15(@)(@@) % عليك ابن تكسين فأمي جنابه % % تناخي إليه سهلة المتنوخ % 16(@)(@@) % فتى غير ما علج الخليقة خلفها % % ولا خنث الإتراف مثل المفنخ % 17(@)(@@) % تقابل منه العين عند طلوعه % % ضياء متى يصبب على الليل يسلخ % 18(@)(@@) % جواد يرى تطهير عرض وملبس % % وتدنيس طباخ وتسويد مطبخ % 19(@)(@@) % يوبخه إحسانه أو يتمه % وإن لم يكن في فعله بالموبخ % 20(@)(@@) % إذا ما العلا عدت فأي مصدر % به عن أبي عثمانها ومؤرخ % PageV01P1142 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص . فقلت لهم % % بذاك أمكنني من قفد يافوخه % 2(@)(@@) % أقطعت عرضي أبا حفص وأقطعني % % أن أنزل الدهر أنى شئت في كوخه % PageV01P1143 البحر : - 1(@)(@@) % يا بن حرب كسوتني طيلسانا % يزرع الرفو فيه وهو سباخ 
ms303	 % 2(@)(@@) % عد مليا قد ناطح الدهر حتى % % كل أركانه بهن انفساخ % 3(@)(@@) % مات نساجه ومات بنوهم % % وبدا الشيب في بنيهم وشاخوا % % 4(@)(@@) % طيلسان إذا تداعت خروق % بين أثنائه لهن صراخ % 5(@)(@@) % سرني صوته وقلت لصحبي % % لم يصوت إلا وفيه طباخ % 6(@)(@@) % تستمر الصدوع طولا وعرضا % فيه حتى كأنهن رخاخ % 7(@)(@@) % نسر دهر نسور لقمان والنس % ران إن قستها إليه فراخ % PageV01P1144 البحر : - 1(@)(@@) % بدا الشيب في رأسي فجلى عمايتي % % كما كشفت ريح غماما تطخطخا % % 2(@)(@@) % ولا بد للصبح الجلي إذا بدت % % تباشيره أن يسلخ الليل مسلخا % % 3(@)(@@) % وأضحت قناة الظهر قوس متنها % % وقد كان معدولا وإن عشت فخخا % % 4(@)(@@) % وأحدث نقصان القوى بين ناظري % % وسمعي وبين الشخص والصوت برزخا % % 5(@)(@@) % وكنت إذا فوقت للشخص لمحتي % % طوت دونه سهبا من الأرض سربخا % % 6(@)(@@) % وكنت يناديني المنادي بعفوه % فيغتال سمعي دون مدعاه فرسخا % % 7(@)(@@) % فحالت صروف الدهر تنسخ جدتي % % وما أمليت من قبل إلا لتنسخا % % 8(@)(@@) % واصبحت عما للفتاة موقرا % وقد كنت أيام الشباب لها أخا % % 9(@)(@@) % وما عجب أن كان ذاك فإنه % % إذا المرء أشوته الحوادث شيخا % % 10(@)(@@) % بلى عجب أني جزعت ولم أكن % % جزوعا إذا ما عضه الدهر أخخا % % PageV01P1145 11(@)(@@) % عزاءك فاذكره ولا تنس مدحة % لأبلج يحكي سنة البدر أبلخا % % 12(@)(@@) % له سيمياء بين عيني مبارك % إذا ما اجتلاها روع ذي الروع أفرخا % % 13(@)(@@) % صريخ لو استصرخته يا بن طاهر % على الدهر إذ أخنى عليك لأصرخا % % 14(@)(@@) % من المصعبيين الذين تفرعوا % % شماريخ أطواد من المجد شمخا % % 15(@)(@@) % أناس متى ساءلت نافس حظهم % بأيامهم في الجود والبأس بخبخا % % 16(@)(@@) % إذا ما المساعي أجريت حلباتها % % بدوا غررا في أوجه السبق شدخا % % 17(@)(@@) % بهم جعل المجد التليد مصدرا % وليس بإنسي سواهم مؤرخا % % 18(@)(@@) % تعدى وأسرف في مديح ابن طاهر % % فلست على الإسراف فيه موبخا % % 19(@)(@@) % أبو أحمد ليث البلاد وغيثها % % إذا حطمة لم تبق في العظم منقما % % 20(@)(@@) % فتى لم يزل في رأس علياء دونها % % بمرقبة باض الأنوق وفرخا % % PageV01P1146 21(@)(@@) % إذا راح في ريا 
ms304	 نثاه حسبته % % هنالك بالمسك الذكي مضمخا % % 22(@)(@@) % ينيخ المطي الراغبون ببابه % % ولو لم ينيخوه إذن لتنوخا % % 23(@)(@@) % تظل متى صافحت أسرار كفه % % تمس عيونا من نداهن نضخا % % 24(@)(@@) % إذا وعد اهتزت له الأرض نضرة % وأنبت منها كل ما كان أسبخا % % 25(@)(@@) % وإن أوعد ارتجت فإن تم سخطه % تهاوت جبال الأرض في الأرض سوخا % % 26(@)(@@) % ولست تلاقي عالما ذا براعة % بأبرع منه في العوم وأرسخا % % 27(@)(@@) % ولم تر نارا أوقدت مثل ناره % % لدى الحرب أشوى للأعادي وأطبخا % % 28(@)(@@) % كفى زمنا أدى الأمير وأهله % % به وبهم إن حاول البذخ مبذخا % % 29(@)(@@) % هو الطرف أجرته الملوك ومسحت % % قديما له وجها أغر مشمرخا % % 30(@)(@@) % إذا هو قاد المصعبيين فاغتدوا % % جحاجحة تهدي غطاريف شرخا % % PageV01P1147 31(@)(@@) % فأية دار للعدا شاء جاسها % % وأية أرض للعدا شاء دوخا % % 32(@)(@@) % به أيد الله الخلافة بعدما % % وهي كل وهي ركنها فتفسخا % % 33(@)(@@) % هو الطاهر ابن الطاهرين الألى مضوا % % ولم يلبسوا عرضا مذالا مطيخا % % 34(@)(@@) % ومستمنحي مدحا كمدحيه بعدما % % تمكن إخلاصي له فتمخخا % % 35(@)(@@) % فقلت له عني إليك فلن أرى % % هواك لمثلي في رمادك منفخا % % PageV01P1148 البحر : - 1(@)(@@) % أحمى علينا نخلكم ذيخه % فكيف ما يحمل في ذيخه % 2(@)(@@) % ولم نزل نرجوه كالمرتجي % % طاعة عات قبل تدويخه % % 3(@)(@@) % ثم علمنا علم مستيقن % أن الثريا من شماريخه % % 4(@)(@@) % فاستيأست من خيره أنفس % عزاؤها في طول توبيخه % PageV01P1149 البحر : - 1(@)(@@) % يا ذا الذي ضن بآزاذه % تعرضا منا لتوبيخه % 2(@)(@@) % ما كنت أدري أن آزاذكم % % معتصم بالله في ذيخه % % 3(@)(@@) % حتى علمنا علم مستيقن % أن الثريا من شماريخه % % PageV01P1150 البحر : - 1(@)(@@) % ألا قل لسيدنا قل له % % مقالا إذا قيل لم يفسخ % 2(@)(@@) % رأينا الذي يكتنى بالحسي % ن صنوك ذا الشرف الأبذخ % 3(@)(@@) % أتى من مديحك ما لا يح % % ل يا بن جبال العلا الشمخ % 4(@)(@@) % أليس القوافي بنات الفتى % % إذا صورة الحق لم تمسخ % 5(@)(@@) % فلا تقبلن أماديحه % % حرام نكاح بنات الأخ % 6(@)(@@) % ودونك فتيا أخي غيرة % يغار على سيد أبلخ % 7(@)(@@) % وأنتم أناس متى تذكروا % % يقل من 
ms305	 ذكرتم له بخ بخ % 8(@)(@@) % وما الأطلس الثوب راجيكم % % لعمري ولا الأبيض المطبخ % PageV01P1151 البحر : - 1(@)(@@) % أصغى لما قلت الأصم الأصلخ % حسنا وللحق دواع تصمخ % 2(@)(@@) % أبشر فما قارفته مسبخ % عنك ونيران الصدور بوخ % 3(@)(@@) % إن العلاء للعلا نعم الأخ % لا يفعل السوءى لرضخ يرضخ % 4(@)(@@) % والحسنات عنه لا تمسخ % تفدي الكهول نفسه والشرخ % 5(@)(@@) % فهو المرجى وهو المستصرخ % % للناس والبرزخ إذ لا برزخ % 6(@)(@@) % في كل دهر ينبري وينقخ % % قد أصبحت أنقاؤهم تمخخ % 7(@)(@@) % والروح في الأموات منهم تنفخ % % مذ ساسهم منه أشم أبلخ % 8(@)(@@) % أغر لا تنكره مشمرخ % آباؤه في الملك قدما تنخ % 9(@)(@@) % مصدر بمجدهم مؤرخ % ذو همة تسمو وحلم يرسخ % 10(@)(@@) % آراؤه الحق الذي لا ينسخ % % وعزمه الحتم الذي لا يفسخ % PageV01P1152 11(@)(@@) % فكل صعب راضه مزيخ % % وكل إقليم به مدوخ % 12(@)(@@) % إذا الخطوب طفقت تطخطخ % فاجتابها ظلت دجاها تسلخ % 13(@)(@@) % وعند ذكرى جوده يبخبخ % فالمعتفي جدواه لا يوبخ % 14(@)(@@) % وعرضه العرض الذي لا يلطخ % بالطيخ إذ بعضهم مطيخ % 15(@)(@@) % بل هو من طيب الثنا مضمخ % كأنه بالمسك محضا ينضخ % 16(@)(@@) % ما إن تزال قلص تنوخ % إليه مقطوعا بهن سربخ % 17(@)(@@) % قرم ترى حساده تأخخ % حتى كأن الهام منهم تشدخ % 18(@)(@@) % له من المجد جبال شمخ % يقصر عنها المضرحي الأفتخ % 19(@)(@@) % علت ذراها والأصول رسخ % ما أطوع البذخ له لو يبذخ % PageV01P1153 البحر : - 1(@)(@@) % أرى العصفور يعبث بالفخاخ % % وما لخناقه فيها مراخي % % 2(@)(@@) % وقال الشعر يغرب فيه حتى % % لخيل من اليمامة أو أضاخ % 3(@)(@@) % ولم تجن المسامع منه معنى % % وهل تجنى الثمار من السباخ % 4(@)(@@) % وعرض عرضه عمدا لشعري % % ليغسل عرضه بعد اتساخ % 5(@)(@@) % ولم يك غاسلا ثوبا بار % أخو عقل يعد ولا طباخ % 6(@)(@@) % تسامى الناس في درج المعالي % % وما سوار إلا في مساخ % 7(@)(@@) % وأني بالسمو لذي سفال % مسيخ الطعم من نفر مساخ % 8(@)(@@) % له أنثى تزيف إلى سواه % % وتأخذه بتربية الفراخ % 9(@)(@@) % وقد شاع الحديث بها ولكن % % إخال النغل مسدود الصماخ % 10(@)(@@) % تأملت الرجال فلم أجده 
ms306	 % % من الشاهات ثم ولا الرخاخ % PageV01P1154 11(@)(@@) % تراح اليعملات إذا أنيخت % % وكد ابن المناخة في المناخ % 12(@)(@@) % يبيت إذا أنيخ قعود عبد % يهب عليه كالفحل القلاخ % 13(@)(@@) % تعاهر عرسه في كل بيت % % وما شبق الخبيثة بالمباخ % 14(@)(@@) % ولو في بيته . . . جهارا % لكان كأنه رجل بخاخ % 15(@)(@@) % نعم ولظل يرفع . . . % هناك إلى الصدور عن النخاخ % 16(@)(@@) % وإني قائل فيه مقالا % يغض الحلق بالماء النقاخ % 17(@)(@@) % أبا الفياض دونك محكمات % نظمن على التشاكل والتواخي % % 18(@)(@@) % سوائر ليس يعرو منشديها % % فتور في النشيد ولا تراخي % % 19(@)(@@) % يطول لها صراخك مستغيثا % وأهون ما تكون على الصراخ % PageV01P1155 البحر : - 1(@)(@@) % هل لي على الأيام من صريخ % % مصغ إلى شكيتي مصيخ % 2(@)(@@) % إذ أصبحت صما عن التوبيخ % % مشعوفة بالبارد المسيخ % % 3(@)(@@) % أعني ابن بنت بائع الزرنيخ % % تلك التي تعرف بالتكميخ % % 4(@)(@@) % فصار بعد القفد والتكليخ % بالقرع أحيانا وبالبطيخ % % 5(@)(@@) % عطاردا يأوي إلى مريخ % % PageV01P1156 البحر : - 1(@)(@@) % أإسماعيل من رجل % تعرب بعد ما شاخا % % 2(@)(@@) % فأصبح من بني شيبا % % ن ضخم الشأن بذاخا % % 3(@)(@@) % وصار أبوه بسطاما % وكان أبوه قيباخا % % 4(@)(@@) % وصار يقول قم عنا % % وكان يقول قوهاخا % % 5(@)(@@) % وشيدت القصور له % % وكانت قبل أكواخا % % 6(@)(@@) % وصار أخس من معه % % له عشرون طباخا % % 7(@)(@@) % وكانت أمه كما % % خة وأبوه كماخا % % 8(@)(@@) % عجبت لمن رأى هذا % % بعينيه فما ساخا % % 9(@)(@@) % إلى الله الصراخ فهل % % يحير إلي إصراخا % % 10(@)(@@) % عدمت الملك إن له % % لأوضارا وأوساخا % % PageV01P1157 11(@)(@@) % علته وحشة بهم % وأصبح نوره باخا % % 12(@)(@@) % سأمجد من هجائي في % % ه حفاظا ونساخا % % PageV01P1158 البحر : - 1(@)(@@) % متى عهدك بالكرخ % وبالشبوط والفرخ % 2(@)(@@) % وبالبكر التي لم تش % ق بالنار ولا الطبخ % PageV01P1159 البحر : - 1(@)(@@) % . . . إبراهيم في البربخ % كنفخة النافخ في المنفخ % 2(@)(@@) % ريع لها الأحياء من هولها % % وأفزع الأموات في البرزخ % 3(@)(@@) % لولا دفاع الله قد زلزلت % % بالأرض في أجبالها الشمخ % 4(@)(@@) % قد أحسن الله بأسماعنا % % إذ سلمت منها فلم تصمخ % 5(@)(@@) % أنذرت من في داره مطبخ % . . . إبراهيم من فرسخ % 6(@)(@@) % الريح والنار هما ما هما % % فلتحذر الريح 
ms307	 على المطبخ % 7(@)(@@) % أعاذ من شرهما ربنا % % دار الأمير السيد الأبلخ % 8(@)(@@) % بخ بخ لإبراهيم من . . . % ذي . . . مرهوبة بخ بخ % 9(@)(@@) % يظل من يسمع أهوالها % % من صارخ ذعرا ومستصرخ % 10(@)(@@) % قل لأبي إسحاق بين لنا % % فأنت في العلم من الرسخ % PageV01P1160 11(@)(@@) % ما طائر ذو بيضة ضخمة % لكنه ليس بمستفرخ % 12(@)(@@) % ولم حكيت القرد في قبحه % % والقرد ممسوخ ولم تمسخ % 13(@)(@@) % وما تشاجيك على شاعر % بحشك الأبخر ذي البربخ % % 14(@)(@@) % لي منجنيق كنت في معزل % عنها وعن أحجارها الشدخ % 15(@)(@@) % فلم تعرضت لها طائعا % ولم تلطخت ولم تلطخ % 16(@)(@@) % عرضي كعرض البين يا بن استها % % ذاك الأرث الأنتن الأوسخ % 17(@)(@@) % إن رجع الطرف متى ربتني % % وأنت من عرضك لم تسلخ % % PageV01P1161 البحر : - 1(@)(@@) % وغدير رقت حواشيه حتى % % بان في قاعه الذي كان ساخا % % 2(@)(@@) % فكأن الحمام إذ وردته % من صفا مائه تزق فراخا % % PageV01P1162 البحر : - 1(@)(@@) % م أبين ضلوعي جمرة تتوقدص على ما مضى أم حسرة تتجدد % خليلي ما بعد الشباب رزية % 2(@)(@@) % يجم لها ماء الشؤون ويعتد % فلا تلحيا إن فاض دمع لفقده % % 3(@)(@@) % فقل له بحر من الدمع يثمد % ولا تعجبا للجلد يبكي فربما % % 4(@)(@@) % تفطر عن عين من الماء جلمد % شباب الفتى مجلوده وعزاؤه % % 5(@)(@@) % فكيف وأنى بعده يتجلد % وفقد الشباب الموت يوجد طعمه % 6(@)(@@) % صراحا وطعم الموت بالموت رزئت شبابي عودة بعد بدأة % وهن الرزايا بادئات وعود % 7(@)(@@) % سلبت سواد العارضين وقبله % بياضهما المحمود إذ أنا أمرد % 8(@)(@@) % وبدلت من ذاك البياض وحسنه % % بياضا ذميما لا يزال يسود % % 9(@)(@@) % لشتان ما بين البياضين معجب % أنيق ومشنوء إلى العين أنكد % 10(@)(@@) % تضاحك في أفنان رأسي ولحيتي % % وأقبح ضحاكين شيب وأدرد % PageV01P1163 11(@)(@@) % وكنت جلاء للعيون من القذى % % فقد جعلت تقذي بشيبي وترقد % 12(@)(@@) % هي الأعين النجل التي كنت تشتكي % % مواقعها في القلب والرأس أسود % 13(@)(@@) % فما لك تأسى الآن لما رأيتها % % وقد جعلت مرمى سواك تعمد % 14(@)(@@) % تشكى إذا ما أقصدتك سهامها % % وتأسى إذا نكبن عنك وتكمد % 15(@)(@@) % كذلك تلك النبل 
ms308	 من وقعت به % % ومن صرفت عنه من القوم مقصد % 16(@)(@@) % إذا عدلت عنا وجدنا عدولها % % كموقعها في القلب بل هو أجهد % 17(@)(@@) % تنكب عنا مرة فكأنما % % منكبها عنا إلينا مسدد % 18(@)(@@) % كفى حزنا أن الشباب معجل % قصير الليالي والمشيب مخلد % 19(@)(@@) % إذا حل جارى المرء شأو حياته % % إلى أن يضم المرء والشيب ملحد % 20(@)(@@) % أرى الدهر أجرى ليله ونهاره % % بعدل فلا هذا ولا ذاك سرمد % PageV01P1164 21(@)(@@) % وجار على ليل الشباب فضامه % نهار مشيب سرمد ليس ينفد % 22(@)(@@) % وعزاك عن ليل الشباب معاشر % فقالوا نهار الشيب أهدى وأرشد % 23(@)(@@) % وكان نهار المرء أهدى لسعيه % % ولكن ظل الليل أندى وأبرد % 24(@)(@@) % أأيام لهوي هل مواضيك عود % وهل لشباب ضل بالأمس منشد % 25(@)(@@) % أقول وقد شابت شواتي وقوست % قناتي وأضحت كدنتي تتخدد % 26(@)(@@) % ودب كلال في عظامي أدبني % % جنيب العصا أنأد أو أتأيد % 27(@)(@@) % وبورك طرفي فالشخاص حياله % % قرائن من أدنى مدى وهي فرد % 28(@)(@@) % ولذت أحاديثي الرجال وأعرضت % سليمى وريا عن حديثي ومهدد % 29(@)(@@) % وبدل إعجاب الغواني تعجبا % فهن روان يعتبرن وصدد % 30(@)(@@) % لما تؤذن الدنيا به من صروفها % % يكون بكاء الطفل ساعة يولد % PageV01P1165 31(@)(@@) % وإلا فما يبكيه منها وإنها % % لأفسح مما كان فيه وأرغد % 32(@)(@@) % إذا أبصر الدنيا استهل كأنه % % بما سوف يلقى من أذاها يهدد % 33(@)(@@) % وللنفس أحوال تظل كأنها % % تشاهد فيها كل غيب سيشهد % 34(@)(@@) % رزحت على مر الليالي وكرها % % وهل عن فناء من فناءين عندد % 35(@)(@@) % محار الفتى شيخوخة أو منية % ومرجوع وهاج المصابيح رمدد % 36(@)(@@) % وقد أغتدي للوحش والوحش هجد % ولو نذرت بي لم تبت وهي هجد % 37(@)(@@) % فيشقى بي الثور القصي مكانه % بحيث يراعيه الأصل الخفيدد % 38(@)(@@) % ترى كل ركاع على مرتع % % يخر لرمحي ساجدا بل يسجد % 39(@)(@@) % إذا غازلته بالصريم نعاجه % % كما غازلت زيرا أوانس خرد % 40(@)(@@) % أمرت به رمحا غيورا فخاضه % ذليقا كما شك النقيلة مسرد % PageV01P1166 41(@)(@@) % فخر لروقيه صريعا تخاله % يعصفر من تاموره أو يفرصد % 42(@)(@@) % كأن سناني حين وافاه كوكب % أصيب به 
ms309	 قطع من المزن أقهد % 43(@)(@@) % وقد أشرب الكأس الغريض مزاجها % % على ما تغناه الغريض ومعبد % 44(@)(@@) % يطوف بها للشرب أبيض مخطف % يجود له بالراح أسود أكبد % 45(@)(@@) % بمولية خضراء ينغم وسطها % % ويهدل في أرجائها ويهدهد % 46(@)(@@) % إذا شئت راقت ناظري نظائر % % بمصطبحي والأدم حولي رود % 47(@)(@@) % وصيف وإبريق ودوم ومرشق % على شرف كل الثلاثة أجيد % 48(@)(@@) % وأنجب ما ولدت منه مسرة % إذا ما بنات الصدر ظلت تولد % 49(@)(@@) % حديث نتاج من بني المزن أمه % معنسة مما تعتق صرخد % 50(@)(@@) % وبيضاء يخبو درها من بياضها % % ويذكو له ياقوتها والزبرجد % PageV01P1167 51(@)(@@) % لها سنة كالشمس تبرز تارة % % وطورا يواريها صبير منضد % 52(@)(@@) % إذا ما التقى السكران سكرا شبابها % % وأكوابها كادت من اللين تعقد % 53(@)(@@) % لهوت بها ليلا قصيرا طويله % % ومالي إلا كفها متوسد % 54(@)(@@) % وكم مثلها من ظبية قد تفيأت % ظلالي وأغصان الشبيبة ميد % 55(@)(@@) % لعبت بأولى الدهر فاغتال شرتي % % بأخرى حقود والجرائم تحقد % 56(@)(@@) % فصبرا على ما اشتد منه فإنما % % يقوم لما يشتد من يتشدد % 57(@)(@@) % وما الدهر إلا كابنه فيه بكرة % وهاجرة مسمومة الجو صيخد % 58(@)(@@) % تذيق الفتى طورى رخاء وشدة % % حوادثه والحول بالحول يطرد % 59(@)(@@) % وعزى أناسا أن كل حديقة % وإن أغدفت أفنانها ستخضد % 60(@)(@@) % ومالي عزاء عن شبابي علمته % % سوى أنني من بعده لا أخلد % PageV01P1168 61(@)(@@) % وأن مشيبي واعد بلحاقه % % وإن قال قوم إنه يتوعد % 62(@)(@@) % على أن في المأمول من فضل صاعد % % عزاء جميلا بل شبابا يجدد % 63(@)(@@) % ستظهر نعماه علي فأغتدي % % وغصن شبابي لين المتن أغيد % 64(@)(@@) % وتصطاد لي جدواه ما كنت صائدا % بشرخ الشباب الغض بل هي أصيد % 65(@)(@@) % وأفضل ما صيدت به العين كالدمى % % مهور وأثمان من العين تنقد % 66(@)(@@) % وهل يستوي رام مراميه لحظه % ورام مراميه لجين وعسجد % 67(@)(@@) % وما أملي في المذحجي بمنته % ولكنه كالشيء بلت به اليد % 68(@)(@@) % إلى أين بي عن صاعد وانتجاعه % وقد راده الرواد قبلي فأحمدوا % % 69(@)(@@) % ولي بأبي عيسى إليه وسيلة % يفك بها أصفاد عان ويصفد % 70(@)(@@) % ومالي 
ms310	 لا أغدو وهذان معمدي % % وما لهما إلا العوارف معمد % PageV01P1169 71(@)(@@) % لعمري لئن أضحت وزارة صاعد % % تثنى لقد أضحى كريما يوحدأبين ضلوعي جمرة تتوقد % 72(@)(@@) % على ما مضى أم حسرة تتجدد % خليلي ما بعد الشباب رزية % 73(@)(@@) % يجم لها ماء الشؤون ويعتد % فلا تلحيا إن فاض دمع لفقده % % 74(@)(@@) % فقل له بحر من الدمع يثمد % ولا تعجبا للجلد يبكي فربما % % 75(@)(@@) % تفطر عن عين من الماء جلمد % شباب الفتى مجلوده وعزاؤه % % 76(@)(@@) % فكيف وأنى بعده يتجلد % وفقد الشباب الموت يوجد طعمه % 77(@)(@@) % صراحا وطعم الموت بالموت يفقد % رزئت شبابي عودة بعد بدأة % 78(@)(@@) % وهن الرزايا بادئات وعود % سلبت سواد العارضين وقبله % 79(@)(@@) % بياضهما المحمود إذ أنا أمرد % وبدلت من ذاك البياض وحسنه % % 80(@)(@@) % بياضا ذميما لا يزال يسود % % لشتان ما بين البياضين معجب % PageV01P1170 81(@)(@@) % أنيق ومشنوء إلى العين أنكد % تضاحك في أفنان رأسي ولحيتي % % 82(@)(@@) % وأقبح ضحاكين شيب وأدرد % وكنت جلاء للعيون من القذى % % 83(@)(@@) % فقد جعلت تقذي بشيبي وترقد % هي الأعين النجل التي كنت تشتكي % % 84(@)(@@) % مواقعها في القلب والرأس أسود % فما لك تأسى الآن لما رأيتها % % 85(@)(@@) % وقد جعلت مرمى سواك تعمد % تشكى إذا ما أقصدتك سهامها % % 86(@)(@@) % وتأسى إذا نكبن عنك وتكمد % كذلك تلك النبل من وقعت به % % 87(@)(@@) % ومن صرفت عنه من القوم مقصد % إذا عدلت عنا وجدنا عدولها % % 88(@)(@@) % كموقعها في القلب بل هو أجهد % تنكب عنا مرة فكأنما % % 89(@)(@@) % منكبها عنا إلينا مسدد % كفى حزنا أن الشباب معجل % 90(@)(@@) % قصير الليالي والمشيب مخلد % إذا حل جارى المرء شأو حياته % % PageV01P1171 91(@)(@@) % إلى أن يضم المرء والشيب ملحد % أرى الدهر أجرى ليله ونهاره % % 92(@)(@@) % بعدل فلا هذا ولا ذاك سرمد % وجار على ليل الشباب فضامه % 93(@)(@@) % نهار مشيب سرمد ليس ينفد % وعزاك عن ليل الشباب معاشر % 94(@)(@@) % فقالوا نهار الشيب أهدى وأرشد % وكان نهار المرء أهدى لسعيه % % 95(@)(@@) % ولكن ظل الليل أندى وأبرد % أأيام لهوي هل مواضيك عود % 96(@)(@@) % وهل لشباب ضل بالأمس منشد % أقول وقد شابت 
ms311	 شواتي وقوست % 97(@)(@@) % قناتي وأضحت كدنتي تتخدد % ودب كلال في عظامي أدبني % % 98(@)(@@) % جنيب العصا أنأد أو أتأيد % وبورك طرفي فالشخاص حياله % % 99(@)(@@) % قرائن من أدنى مدى وهي فرد % ولذت أحاديثي الرجال وأعرضت % 100(@)(@@) % سليمى وريا عن حديثي ومهدد % وبدل إعجاب الغواني تعجبا % PageV01P1172 101(@)(@@) % فهن روان يعتبرن وصدد % لما تؤذن الدنيا به من صروفها % % 102(@)(@@) % يكون بكاء الطفل ساعة يولد % وإلا فما يبكيه منها وإنها % % 103(@)(@@) % لأفسح مما كان فيه وأرغد % إذا أبصر الدنيا استهل كأنه % % 104(@)(@@) % بما سوف يلقى من أذاها يهدد % وللنفس أحوال تظل كأنها % % 105(@)(@@) % تشاهد فيها كل غيب سيشهد % رزحت على مر الليالي وكرها % % 106(@)(@@) % وهل عن فناء من فناءين عندد % محار الفتى شيخوخة أو منية % 107(@)(@@) % ومرجوع وهاج المصابيح رمدد % وقد أغتدي للوحش والوحش هجد % 108(@)(@@) % ولو نذرت بي لم تبت وهي هجد % فيشقى بي الثور القصي مكانه % 109(@)(@@) % بحيث يراعيه الأصل الخفيدد % ترى كل ركاع على مرتع % % 110(@)(@@) % يخر لرمحي ساجدا بل يسجد % إذا غازلته بالصريم نعاجه % % PageV01P1173 111(@)(@@) % كما غازلت زيرا أوانس خرد % أمرت به رمحا غيورا فخاضه % 112(@)(@@) % ذليقا كما شك النقيلة مسرد % فخر لروقيه صريعا تخاله % 113(@)(@@) % يعصفر من تاموره أو يفرصد % كأن سناني حين وافاه كوكب % 114(@)(@@) % أصيب به قطع من المزن أقهد % وقد أشرب الكأس الغريض مزاجها % % 115(@)(@@) % على ما تغناه الغريض ومعبد % يطوف بها للشرب أبيض مخطف % 116(@)(@@) % يجود له بالراح أسود أكبد % بمولية خضراء ينغم وسطها % % 117(@)(@@) % ويهدل في أرجائها ويهدهد % إذا شئت راقت ناظري نظائر % % 118(@)(@@) % بمصطبحي والأدم حولي رود % وصيف وإبريق ودوم ومرشق % 119(@)(@@) % على شرف كل الثلاثة أجيد % وأنجب ما ولدت منه مسرة % 120(@)(@@) % إذا ما بنات الصدر ظلت تولد % حديث نتاج من بني المزن أمه % PageV01P1174 121(@)(@@) % معنسة مما تعتق صرخد % وبيضاء يخبو درها من بياضها % % 122(@)(@@) % ويذكو له ياقوتها والزبرجد % لها سنة كالشمس تبرز تارة % % 123(@)(@@) % وطورا يواريها صبير منضد % إذا ما التقى السكران سكرا شبابها % % 124(@)(@@) % وأكوابها كادت من اللين تعقد % لهوت بها 
ms312	 ليلا قصيرا طويله % % 125(@)(@@) % ومالي إلا كفها متوسد % وكم مثلها من ظبية قد تفيأت % 126(@)(@@) % ظلالي وأغصان الشبيبة ميد % لعبت بأولى الدهر فاغتال شرتي % % 127(@)(@@) % بأخرى حقود والجرائم تحقد % فصبرا على ما اشتد منه فإنما % % 128(@)(@@) % يقوم لما يشتد من يتشدد % وما الدهر إلا كابنه فيه بكرة % 129(@)(@@) % وهاجرة مسمومة الجو صيخد % تذيق الفتى طورى رخاء وشدة % % 130(@)(@@) % حوادثه والحول بالحول يطرد % وعزى أناسا أن كل حديقة % PageV01P1175 131(@)(@@) % وإن أغدفت أفنانها ستخضد % ومالي عزاء عن شبابي علمته % % 132(@)(@@) % سوى أنني من بعده لا أخلد % وأن مشيبي واعد بلحاقه % % 133(@)(@@) % وإن قال قوم إنه يتوعد % على أن في المأمول من فضل صاعد % % 134(@)(@@) % عزاء جميلا بل شبابا يجدد % ستظهر نعماه علي فأغتدي % % 135(@)(@@) % وغصن شبابي لين المتن أغيد % وتصطاد لي جدواه ما كنت صائدا % 136(@)(@@) % بشرخ الشباب الغض بل هي أصيد % وأفضل ما صيدت به العين كالدمى % % 137(@)(@@) % مهور وأثمان من العين تنقد % وهل يستوي رام مراميه لحظه % 138(@)(@@) % ورام مراميه لجين وعسجد % وما أملي في المذحجي بمنته % 139(@)(@@) % ولكنه كالشيء بلت به اليد % إلى أين بي عن صاعد وانتجاعه % 140(@)(@@) % وقد راده الرواد قبلي فأحمدوا % % ولي بأبي عيسى إليه وسيلة % PageV01P1176 141(@)(@@) % يفك بها أصفاد عان ويصفد % ومالي لا أغدو وهذان معمدي % % 142(@)(@@) % وما لهما إلا العوارف معمد % لعمري لئن أضحت وزارة صاعد % % 143(@)(@@) % تثنى لقد أضحى كريما يوحد % وزارته شفع وذاك بحقه % 144(@)(@@) % كما أنه وتر إذا عد سؤدد % هو الرجل المشروك في جل ماله % 145(@)(@@) % ولكنه بالخير والحمد مفرد % يقرض إلا أن ما قيل دونه % % 146(@)(@@) % ويوصف إلا أنه لا يحدد % أرق من الماء الذي في حسامه % % 147(@)(@@) % طباعا وأمضى من شباه وأنجد % وأجدى وأندى بطن كف من الحيا % % 148(@)(@@) % وآبى إباء من صفاة وأجمد % وأبهر نورا للعيون من التي % % 149(@)(@@) % تضاهيه في العلياء حين تكبد % وأوقر من رضوى ولو شاء نسفها % % 150(@)(@@) % إذن لم يلقها طرفة العين مركد % طويل التأني لا العجول ولا الذي % % PageV01P1177 151(@)(@@) % إذا طرقته نوبة 
ms313	 يتبلد % له سورة مكتنة في سكينة % 152(@)(@@) % كما اكتن في الغمد الجراز المهند % إذا شامها قرت قلوب مقرها % % 153(@)(@@) % وإن سل منها فالفرائض ترعد % يلاقي العدا والأولياء ابن مخلد % 154(@)(@@) % لقاء امرىء في الله يرضى ويعبد % بجهل كجهل السيف والسيف منتضى % 155(@)(@@) % وحلم كحلم السيف والسيف مغمد % وليس بجهل الأغبياء ذوي العمى % % 156(@)(@@) % ولكنه جهل به الله يعبد % عرام زعيم بالهدى أو فبالردى % % 157(@)(@@) % إذا ما اعتدى قوم عن القصد عند % قرى من ملي بالقرى حين يبتغى % % 158(@)(@@) % كلا نزليه اللذ والكره محمد % عتيد لديه الخير والشر لامرىء % 159(@)(@@) % بغى أو بغى خيرا وللخير أعتد % صموت بلا عي له من بلائه % % 160(@)(@@) % نواطق تستدعي الرجاء وتزأد % كفى الوعد والإبعاد بالقول نفسه % PageV01P1178 161(@)(@@) % بأفعاله والفعل للفعل أشهد % إذا اقتفرت آثاره فعدوه % 162(@)(@@) % ومولاه موعود هناك وموعد % عزيز غدا فوق التودد عزه % 163(@)(@@) % وإحسانه في ظله يتودد % يغض عن السؤال من طرف عينه % % 164(@)(@@) % لكيلا يرى الأحرار كيف تعبد % ويطرق إطراق الذليل وإنه % % 165(@)(@@) % هناك لسامي ناظر العين أصيد % إذا من لم يمنن بمن يمنه % 166(@)(@@) % وقال لنفسي أيها الناس أمهد % وكل امتنان لا يمن فإنه % % 167(@)(@@) % أخف مناطا في الرقاب وأوكد % تجاوز أن يستأنف المجد بالندى % % 168(@)(@@) % وفي كل ما استرفدته فهو أجود % ومن لم يزد في مجده بذل ماله % 169(@)(@@) % وجاد به فهو الجواد المقلد % ترى نائلا من نائل ثم ينتهيأبين ضلوعي جمرة تتوقد % 170(@)(@@) % على ما مضى أم حسرة تتجدد % خليلي ما بعد الشباب رزية % PageV01P1179 171(@)(@@) % يجم لها ماء الشؤون ويعتد % فلا تلحيا إن فاض دمع لفقده % % 172(@)(@@) % فقل له بحر من الدمع يثمد % ولا تعجبا للجلد يبكي فربما % % 173(@)(@@) % تفطر عن عين من الماء جلمد % شباب الفتى مجلوده وعزاؤه % % 174(@)(@@) % فكيف وأنى بعده يتجلد % وفقد الشباب الموت يوجد طعمه % 175(@)(@@) % صراحا وطعم الموت بالموت يفقد % رزئت شبابي عودة بعد بدأة % 176(@)(@@) % وهن الرزايا بادئات وعود % سلبت سواد العارضين وقبله % 177(@)(@@) % بياضهما المحمود إذ أنا أمرد % وبدلت من ذاك 
ms314	 البياض وحسنه % % 178(@)(@@) % بياضا ذميما لا يزال يسود % % لشتان ما بين البياضين معجب % 179(@)(@@) % أنيق ومشنوء إلى العين أنكد % تضاحك في أفنان رأسي ولحيتي % % 180(@)(@@) % وأقبح ضحاكين شيب وأدرد % وكنت جلاء للعيون من القذى % % PageV01P1180 181(@)(@@) % فقد جعلت تقذي بشيبي وترقد % هي الأعين النجل التي كنت تشتكي % % 182(@)(@@) % مواقعها في القلب والرأس أسود % فما لك تأسى الآن لما رأيتها % % 183(@)(@@) % وقد جعلت مرمى سواك تعمد % تشكى إذا ما أقصدتك سهامها % % 184(@)(@@) % وتأسى إذا نكبن عنك وتكمد % كذلك تلك النبل من وقعت به % % 185(@)(@@) % ومن صرفت عنه من القوم مقصد % إذا عدلت عنا وجدنا عدولها % % 186(@)(@@) % كموقعها في القلب بل هو أجهد % تنكب عنا مرة فكأنما % % 187(@)(@@) % منكبها عنا إلينا مسدد % كفى حزنا أن الشباب معجل % 188(@)(@@) % قصير الليالي والمشيب مخلد % إذا حل جارى المرء شأو حياته % % 189(@)(@@) % إلى أن يضم المرء والشيب ملحد % أرى الدهر أجرى ليله ونهاره % % 190(@)(@@) % بعدل فلا هذا ولا ذاك سرمد % وجار على ليل الشباب فضامه % PageV01P1181 191(@)(@@) % نهار مشيب سرمد ليس ينفد % وعزاك عن ليل الشباب معاشر % 192(@)(@@) % فقالوا نهار الشيب أهدى وأرشد % وكان نهار المرء أهدى لسعيه % % 193(@)(@@) % ولكن ظل الليل أندى وأبرد % أأيام لهوي هل مواضيك عود % 194(@)(@@) % وهل لشباب ضل بالأمس منشد % أقول وقد شابت شواتي وقوست % 195(@)(@@) % قناتي وأضحت كدنتي تتخدد % ودب كلال في عظامي أدبني % % 196(@)(@@) % جنيب العصا أنأد أو أتأيد % وبورك طرفي فالشخاص حياله % % 197(@)(@@) % قرائن من أدنى مدى وهي فرد % ولذت أحاديثي الرجال وأعرضت % 198(@)(@@) % سليمى وريا عن حديثي ومهدد % وبدل إعجاب الغواني تعجبا % 199(@)(@@) % فهن روان يعتبرن وصدد % لما تؤذن الدنيا به من صروفها % % 200(@)(@@) % يكون بكاء الطفل ساعة يولد % وإلا فما يبكيه منها وإنها % % PageV01P1182 201(@)(@@) % لأفسح مما كان فيه وأرغد % إذا أبصر الدنيا استهل كأنه % % 202(@)(@@) % بما سوف يلقى من أذاها يهدد % وللنفس أحوال تظل كأنها % % 203(@)(@@) % تشاهد فيها كل غيب سيشهد % رزحت على مر الليالي وكرها % % 204(@)(@@) % وهل عن فناء من فناءين عندد % محار الفتى شيخوخة أو 
ms315	 منية % 205(@)(@@) % ومرجوع وهاج المصابيح رمدد % وقد أغتدي للوحش والوحش هجد % 206(@)(@@) % ولو نذرت بي لم تبت وهي هجد % فيشقى بي الثور القصي مكانه % 207(@)(@@) % بحيث يراعيه الأصل الخفيدد % ترى كل ركاع على مرتع % % 208(@)(@@) % يخر لرمحي ساجدا بل يسجد % إذا غازلته بالصريم نعاجه % % 209(@)(@@) % كما غازلت زيرا أوانس خرد % أمرت به رمحا غيورا فخاضه % 210(@)(@@) % ذليقا كما شك النقيلة مسرد % فخر لروقيه صريعا تخاله % PageV01P1183 211(@)(@@) % يعصفر من تاموره أو يفرصد % كأن سناني حين وافاه كوكب % 212(@)(@@) % أصيب به قطع من المزن أقهد % وقد أشرب الكأس الغريض مزاجها % % 213(@)(@@) % على ما تغناه الغريض ومعبد % يطوف بها للشرب أبيض مخطف % 214(@)(@@) % يجود له بالراح أسود أكبد % بمولية خضراء ينغم وسطها % % 215(@)(@@) % ويهدل في أرجائها ويهدهد % إذا شئت راقت ناظري نظائر % % 216(@)(@@) % بمصطبحي والأدم حولي رود % وصيف وإبريق ودوم ومرشق % 217(@)(@@) % على شرف كل الثلاثة أجيد % وأنجب ما ولدت منه مسرة % 218(@)(@@) % إذا ما بنات الصدر ظلت تولد % حديث نتاج من بني المزن أمه % 219(@)(@@) % معنسة مما تعتق صرخد % وبيضاء يخبو درها من بياضها % % 220(@)(@@) % ويذكو له ياقوتها والزبرجد % لها سنة كالشمس تبرز تارة % % PageV01P1184 221(@)(@@) % وطورا يواريها صبير منضد % إذا ما التقى السكران سكرا شبابها % % 222(@)(@@) % وأكوابها كادت من اللين تعقد % لهوت بها ليلا قصيرا طويله % % 223(@)(@@) % ومالي إلا كفها متوسد % وكم مثلها من ظبية قد تفيأت % 224(@)(@@) % ظلالي وأغصان الشبيبة ميد % لعبت بأولى الدهر فاغتال شرتي % % 225(@)(@@) % بأخرى حقود والجرائم تحقد % فصبرا على ما اشتد منه فإنما % % 226(@)(@@) % يقوم لما يشتد من يتشدد % وما الدهر إلا كابنه فيه بكرة % 227(@)(@@) % وهاجرة مسمومة الجو صيخد % تذيق الفتى طورى رخاء وشدة % % 228(@)(@@) % حوادثه والحول بالحول يطرد % وعزى أناسا أن كل حديقة % 229(@)(@@) % وإن أغدفت أفنانها ستخضد % ومالي عزاء عن شبابي علمته % % 230(@)(@@) % سوى أنني من بعده لا أخلد % وأن مشيبي واعد بلحاقه % % PageV01P1185 231(@)(@@) % وإن قال قوم إنه يتوعد % على أن في المأمول من فضل صاعد % % 232(@)(@@) % عزاء جميلا بل شبابا يجدد % ستظهر نعماه 
ms316	 علي فأغتدي % % 233(@)(@@) % وغصن شبابي لين المتن أغيد % وتصطاد لي جدواه ما كنت صائدا % 234(@)(@@) % بشرخ الشباب الغض بل هي أصيد % وأفضل ما صيدت به العين كالدمى % % 235(@)(@@) % مهور وأثمان من العين تنقد % وهل يستوي رام مراميه لحظه % 236(@)(@@) % ورام مراميه لجين وعسجد % وما أملي في المذحجي بمنته % 237(@)(@@) % ولكنه كالشيء بلت به اليد % إلى أين بي عن صاعد وانتجاعه % 238(@)(@@) % وقد راده الرواد قبلي فأحمدوا % % ولي بأبي عيسى إليه وسيلة % 239(@)(@@) % يفك بها أصفاد عان ويصفد % ومالي لا أغدو وهذان معمدي % % 240(@)(@@) % وما لهما إلا العوارف معمد % لعمري لئن أضحت وزارة صاعد % % PageV01P1186 241(@)(@@) % تثنى لقد أضحى كريما يوحد % وزارته شفع وذاك بحقه % 242(@)(@@) % كما أنه وتر إذا عد سؤدد % هو الرجل المشروك في جل ماله % 243(@)(@@) % ولكنه بالخير والحمد مفرد % يقرض إلا أن ما قيل دونه % % 244(@)(@@) % ويوصف إلا أنه لا يحدد % أرق من الماء الذي في حسامه % % 245(@)(@@) % طباعا وأمضى من شباه وأنجد % وأجدى وأندى بطن كف من الحيا % % 246(@)(@@) % وآبى إباء من صفاة وأجمد % وأبهر نورا للعيون من التي % % 247(@)(@@) % تضاهيه في العلياء حين تكبد % وأوقر من رضوى ولو شاء نسفها % % 248(@)(@@) % إذن لم يلقها طرفة العين مركد % طويل التأني لا العجول ولا الذي % % 249(@)(@@) % إذا طرقته نوبة يتبلد % له سورة مكتنة في سكينة % 250(@)(@@) % كما اكتن في الغمد الجراز المهند % إذا شامها قرت قلوب مقرها % % PageV01P1187 251(@)(@@) % وإن سل منها فالفرائض ترعد % يلاقي العدا والأولياء ابن مخلد % 252(@)(@@) % لقاء امرىء في الله يرضى ويعبد % بجهل كجهل السيف والسيف منتضى % 253(@)(@@) % وحلم كحلم السيف والسيف مغمد % وليس بجهل الأغبياء ذوي العمى % % 254(@)(@@) % ولكنه جهل به الله يعبد % عرام زعيم بالهدى أو فبالردى % % 255(@)(@@) % إذا ما اعتدى قوم عن القصد عند % قرى من ملي بالقرى حين يبتغى % % 256(@)(@@) % كلا نزليه اللذ والكره محمد % عتيد لديه الخير والشر لامرىء % 257(@)(@@) % بغى أو بغى خيرا وللخير أعتد % صموت بلا عي له من بلائه % % 258(@)(@@) % نواطق تستدعي الرجاء وتزأد % كفى الوعد والإبعاد 
ms317	 بالقول نفسه % 259(@)(@@) % بأفعاله والفعل للفعل أشهد % إذا اقتفرت آثاره فعدوه % 260(@)(@@) % ومولاه موعود هناك وموعد % عزيز غدا فوق التودد عزه % PageV01P1188 261(@)(@@) % وإحسانه في ظله يتودد % يغض عن السؤال من طرف عينه % % 262(@)(@@) % لكيلا يرى الأحرار كيف تعبد % ويطرق إطراق الذليل وإنه % % 263(@)(@@) % هناك لسامي ناظر العين أصيد % إذا من لم يمنن بمن يمنه % 264(@)(@@) % وقال لنفسي أيها الناس أمهد % وكل امتنان لا يمن فإنه % % 265(@)(@@) % أخف مناطا في الرقاب وأوكد % تجاوز أن يستأنف المجد بالندى % % 266(@)(@@) % وفي كل ما استرفدته فهو أجود % ومن لم يزد في مجده بذل ماله % 267(@)(@@) % وجاد به فهو الجواد المقلد % ترى نائلا من نائل ثم ينتهي % % 268(@)(@@) % إلى صاعد إسناده حين يسند % كأن أباه يوم سماه صاعدا % 269(@)(@@) % رأى كيف يرقى في المعالي ويصعد % جرى وجرى الأكفاء شأوا ولم يزل % % 270(@)(@@) % منازعه الطولى يضام ويضهد % فلما تناهى من يباريه في العلا % % PageV01P1189 271(@)(@@) % تمادى يباري أمسه اليوم والغد % جواد ثنى غرب الجياد بغربه % 272(@)(@@) % وظل يجاري ظله وهو أوحد % وما أغرق المداح إلا غلابه % 273(@)(@@) % وراء مغالي مدحهم فيه مخلد % وأسلاف صدق من عرانين مذحج % 274(@)(@@) % طوال المساعي ليس فيهم مزند % % بنوا مجده في هضبة مذحجية % 275(@)(@@) % ذؤابتها بين الفراقد فرقد % أولئك أوعال المعالي مسهل % 276(@)(@@) % لهم مرتقى في الوعر منها ومصعد % ألم تر زلفى صاعد عند ربه % % 277(@)(@@) % بلى قد رأى الساهي ومن يتفقد % بدت قبلة الدنيا وللنكر فوقها % % 278(@)(@@) % ظلال وثدي العرف فيها مجدد % فلما تولى الأمر نكر منكر % 279(@)(@@) % وعرف معروف وأصلح مفسد % وأصبح شمل الناس وهو مؤلف % % 280(@)(@@) % وعهدي بشمل الناس وهو مبدد % حماهم وأفشى العرف فيهم فكلهم % PageV01P1190 281(@)(@@) % من الشر ممنوع من الخير ممجد % إذا أحسنوا جوزوا جزاء مضاعفا % 282(@)(@@) % وما اقترفوا من سيىء متعمد % ولما التقى خصب المراد وأمنه % 283(@)(@@) % تيقظ مسبوت ونام مسهد % فلم يمتنع مرعى على متعيش % 284(@)(@@) % ولم ينقطع شرب ولم ينب مرقد % فأضحوا وما في راحة الموت مرغب % 285(@)(@@) % لحي ولا في لذة العيش مزهد 
ms318	 % ليحلل ذراه من تلدد حائرا % 286(@)(@@) % فما في ذراه حائر يتلدد % وطاغ عهدنا أمره وهو حادث % 287(@)(@@) % جليل فأمسى أمره وهو معهد % تمادت به الطغوى ولم يدر أنه % % 288(@)(@@) % يسوغ أكالا له ثم يزرد % فصادف قتال الطغاة بمرصد % 289(@)(@@) % قريب وهل يخلو من الله مرصد % % أتيح له من ذي الغناءين صاعد % 290(@)(@@) % مصاع ومكر أعجمي مولد % فعجمته كتمانه أين عهده % PageV01P1191 291(@)(@@) % وتوليده عرفانه أين يعمد % رماه بحول لا يطاق وقوة % 292(@)(@@) % ولي بكلتا العدتين مؤيد % رأى صيده من أفضل الصيد كله % 293(@)(@@) % على أنه من شر ما يتصيد % فبث له تلك الحبائل حازم % 294(@)(@@) % من القوم كياد قديما مكيد % موفق آراء وزير موفق % 295(@)(@@) % يعاضده والركن بالركن يعضد % إذا ناب عنه في الأمور رأيته % % 296(@)(@@) % كلا مشهديه لا يدانيه مشهد % عطارده ما أخبت الحرب نارها % % 297(@)(@@) % ومريخه ما دامت الحرب توقد % يصول على أعدائه كل صولة % % 298(@)(@@) % يضيق لها منهم مقام ومقعد % تفرق عنه المكائد جنده % 299(@)(@@) % وتزدادهم جندا وجيشك محصد % ولو كنت لم تزدهم وقتلتهم % 300(@)(@@) % لكان له في قتلهم متبرد % ولكن بغى حتى نصرت فلم تكن % PageV01P1192 301(@)(@@) % تنقصه إلاوأنت تزيد % ولابس سيف القرن عند استلابه % 302(@)(@@) % أخر له من كاسريه وأكيد % وما زلت قدما تشفع الكيد للعدا % % 303(@)(@@) % بكيد ومن اللقاء ربك تنجد % نزلت به تأبى القرى غير نفسه % % 304(@)(@@) % وذاك قرى من مثله لك معتد % بأرعن لو يرمى به عرض يذبل % 305(@)(@@) % لأصبح مرسى صخره وهو جدجد % إذا اجتاز بحرا كاد ينزح ماؤه % 306(@)(@@) % وإن ضاف برا كادت الأرض تجرد % فما رمته حتى الستقل برأسه % % 307(@)(@@) % مكان قناة الظهر أسمر وأجود % % تطير عليه لحية منه أصبحت % 308(@)(@@) % له راية يهدي بها الجيش مطرد % تراه عيون الناظرين ودونه % % 309(@)(@@) % حجاب وباب من جهنم مؤصد % يسير له في الدهم رأس معطن % 310(@)(@@) % وجثمانه بالقاع شلو مقدد % مناك له في مقداره فكأنما % % PageV01P1193 311(@)(@@) % تقوض ثهلان عليه وصندد % ولم تأل إنذارا له غير أنه % % 312(@)(@@) % رأى أن متن البحر صرح ممرد 
ms319	 % حدوت به نحو النجاة كأنما % % 313(@)(@@) % محجتها البيضاء سحل ممدد % فلما أيى إلا البوار شللته % 314(@)(@@) % إلى النار بئس المورد المتورد % سكنت سكونا كان رهنا بعدوة % 315(@)(@@) % عماس كذاك الليث للوثب يلبد % وحامى أبو العباس في كل موطن % 316(@)(@@) % على يومه ثوب من الشر مجسد % محاماة مقدام حيود عن الهوى % % 317(@)(@@) % ولكنه عن جانب العار أحيد % وما شبل ذاك الليث إلا شبيهه % 318(@)(@@) % وغير عجيب أن ترى الشبل يأسد % وما بئس عون المرء كان ابن مخلد % 319(@)(@@) % نصيحك والأعداء نحوك صمد % مضى لك إذ كل الحديد من الظبا % % 320(@)(@@) % وحاطك إذ رث النسيج المسرد % وهت كل درع فانثنى كل منصل % PageV01P1194 321(@)(@@) % سوى صاعد والموت للموت ينهد % فلا يبعد الرأي الذي اخترته به % 322(@)(@@) % وقربته بل من أبى ذاك يبعد % أما لئن استبطنته دون من دنت % 323(@)(@@) % إليك بهالقربى وهنبث حسد % لكم داخل بين الخصيمين مصلح % % 324(@)(@@) % كما انغل بين العين والجفن مرود % ترى العين والملمول يبطن جفنها % % 325(@)(@@) % إذا ما غدا إنسانها وهو أرمد % تشكى فلا يجدي عليها لصيقها % % 326(@)(@@) % فتدني الذييجدي وقرباه أبعد % وما زلت مفتوحا عليك بصاعد % 327(@)(@@) % تفوز وتستعلي وتحظى وتسعد % بتدبيره طورا وطورا بيمنه % % 328(@)(@@) % وما قاده التدبير فاليمن أقود % فمن يمنه إن غاب عنك مديدة % 329(@)(@@) % فنالك دون الدرع أزرق مصرد % فلما أراك الله غرة وجهه % 330(@)(@@) % تراءى لك السعد الذي كنت تعهد % برأت به من كل ما أنت ضامن % PageV01P1195 331(@)(@@) % وأنت لشروى تلك منه معود % وبدلت من قرح بقتح مسير % 332(@)(@@) % بأمثاله غاظ الحسود المحسد % ألا ذلك الفتح المبين هناؤه % % 333(@)(@@) % فتم ولاقاه يزيد ومزيد % ومن يمنه أن دمر العبد وابنه % 334(@)(@@) % وملاح قن فالثلاثة همد % وأتبع أهل الفسق من أوليائه % % 335(@)(@@) % فوافاه والباقون فل مشرد % كأني بهم قد قيل عند بوارهم % % 336(@)(@@) % رعوا ظمأهم حتى إذا تم أوردوا % % زروع سقاها الله ريا فأثمرت % % 337(@)(@@) % عتيا فأضحت وهي للنار تحصد % يقول مقالي في نصيحك من مشى % % 338(@)(@@) % ويقدمهم في ذاكمن يتبغدد % وما قيل فيه 
ms320	 من مديح فإنه % % 339(@)(@@) % مديحك والنيات نحوك عمد % إذا ما الأعادي حاولت كيد صاعد % 340(@)(@@) % غدا يتعالى والأعادي توهد % وحارب عن نعمائه ريب دهره % % PageV01P1196 341(@)(@@) % من البر والمعروف جند مجند % وأهل لذاك المذحجي ابن مخلد % 342(@)(@@) % مع الخلد لو أن ابن آدم مخلد % حلفت بمن حلاه كل فضيلة % % 343(@)(@@) % بأمثالها ساد المسود المسود % لقد نال منهاة العلاء وإنه % % 344(@)(@@) % بأن ابنه مثل العلاء لأسعد % ألا ذلك الفوز الذي لا إخاله % % 345(@)(@@) % على غيره من سائر القوم يحشد % فتى الدين والدنيا الذي أذعنا له % % 346(@)(@@) % ففي خنصر منه لصعبين مقود % هو التاج والإكليل في كل محفل % 347(@)(@@) % بل السيف سيف الدولة المتقلد % يزين ويحمي وهو في السلم زينة % 348(@)(@@) % لمن يرتديه وهو في الحرب مزود % وليس بأن يلقى ولكن بأن يرى % % 349(@)(@@) % بآرائه اللاقون والهام تجلد % تراه عن الحرب العوان بمعزل % 350(@)(@@) % وآثاره فيهاوإن غاب شهد % كما احتجب المقدار والحكم حكمه % PageV01P1197 351(@)(@@) % على الناس طرا ليس عنه معرد % إذا ما نبا سيف فلاحظ رأيه % 352(@)(@@) % فموقعه ممن توخى ممهد % فتى روحه ضوء بسيط كيانه % 353(@)(@@) % ومسكن تلك الروح نور مجسد % صفا ونفى عنه القذى فكأنه % 354(@)(@@) % إذا ما استشفه العقول مصعد % فتى هاجر الدنيا وحرم ريقها % % 355(@)(@@) % وهل ريقها إلا الرحيق المورد % ولو طمعت في عطفه ووصاله % 356(@)(@@) % أباحته منها مرشفا لا يصردنه أبين ضلوعي جمرة تتوقد % على ما مضى أم حسرة تتجدد % 357(@)(@@) % خليلي ما بعد الشباب رزية % يجم لها ماء الشؤون ويعتد % 358(@)(@@) % فلا تلحيا إن فاض دمع لفقده % % فقل له بحر من الدمع يثمد % 359(@)(@@) % ولا تعجبا للجلد يبكي فربما % % تفطر عن عين من الماء جلمد % 360(@)(@@) % شباب الفتى مجلوده وعزاؤه % % فكيف وأنى بعده يتجلد % PageV01P1198 361(@)(@@) % وفقد الشباب الموت يوجد طعمه % صراحا وطعم الموت بالموت يفقد % 362(@)(@@) % رزئت شبابي عودة بعد بدأة % وهن الرزايا بادئات وعود % 363(@)(@@) % سلبت سواد العارضين وقبله % بياضهما المحمود إذ أنا أمرد % 364(@)(@@) % وبدلت من ذاك البياض وحسنه % % بياضا ذميما لا يزال يسود % % 365 