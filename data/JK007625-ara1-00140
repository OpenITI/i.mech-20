ms121	 عبثوا % % واشتد بلائي مذ لعهدي نكثوا % % 45(@)(@@) % روحي قصوا ومهجتي قد بعثوا % % والبعث بكتبهم إذا ما بعثوا % % 46(@)(@@) % كم يوسعني رحيب صدري حرجا % % كم تنقصني حظوظ فضلي درجا % % 47(@)(@@) % قد حرت بما أرى لأمري فرجا % % كم من تعب قارب يأسا ورجا % % 48(@)(@@) % ما أحسن ما كنت بكم مبتهجا % % أرجو طيبا وأستطيب الأرجا % % 49(@)(@@) % عودوا دنفا بذكركم ملتهجا % % أمسى فرجا من الهموم الفرجا % % 50(@)(@@) % الآس على وردك من سبحه % % والقلب على وجدك من هيجه % % PageV01P473 51(@)(@@) % أفدي بأبي حسنك ما أبهجه % % من أعجزه الوصل فما أزعجه % % 52(@)(@@) % يا بدر دجى أدر لنا شمس ضحى % % راحا تهدي إلى النفوس الفرجا % % 53(@)(@@) % لا تلح على سكر غرام طفحا % % ما حيلة من لو قلبه صح صحا % % 54(@)(@@) % يا صاح أما تعلم أني صاحي % % صحوي تعبي وراحتي في الراح % % 55(@)(@@) % أهبب ظلم الليل بذا المصباح % % فالراح بها تكامل الأرواح % % 56(@)(@@) % ما أعلم ما أقول للنصاح % % ما يأمل في الهوى فلاحي اللاحي % % 57(@)(@@) % أقصر لأطيل سكرتي يا صاح % % لا صلحك ممكن ولا إصلاحي % % 58(@)(@@) % الشوق على القلب شديد البرح % % والقلب يجل شوقه عن شرح % % 59(@)(@@) % صبرا فعسى سماؤه أن تضحي % % لا بد لكل ليلة من صبح % % 60(@)(@@) % ما تعلم ما حقيقة الأفراح % % ما لم تصف السكر بشرب الراح % % PageV01P474 61(@)(@@) % إشرب وأملأ براحها أقداحي % % فالراح تعيد حدة الأرواح % % 62(@)(@@) % ذا حظك من أي كتاب نسخا % % فالعقل عليه شرعه قد نسخا % % 63(@)(@@) % سل من تهواه عقد صبري فسخا % % لم شح بوصله وبالطيف سخا % % 64(@)(@@) % ذا الحسن أمات كل حسن ونسخ % % والبدر إذا طغا على النجم رسخ % % 65(@)(@@) % بخ لك يا معذب المهجة بخ % % من دل بحسنه تعالى وشمخ % % 66(@)(@@) % الشوق لعقد صبره قد فسخا % % والهم لشرع أنسه قد نسخا % % 67(@)(@@) % لولا شغف بقلبه قد رسخا % % ما شح بوصله وبالطيف سخا % % 68(@)(@@) % في قلبي من شوقك حزن وكمد % % لم يبق على الغرام للقلب جلد % % 69(@)(@@) % الشوق كما بليت لم يبل أحد % % عذب بسوى هجرك فالهجر أشد % % 70(@)(@@) % يا من بالوصل 
ms122	 طال لي موعده % % لو أسعدني لطاب لي مورده % % PageV01P475 71(@)(@@) % حتام تقول في غد أسعده % % فالدهر أراه ليس يغني غده % % 72(@)(@@) % الورد مبشر بطرد الورد % % والقهوة . . . . . . الورد % % 73(@)(@@) % الكاس تحاكي زردا في سرد % . . . . . . . . . . . . . . . . . . % 74(@)(@@) % كم قد حضر الراح وغاب الورد % % حتى عدم الراح فناب الورد % % 75(@)(@@) % لما عبق الراح وطاب الورد % % قلنا جمد الراح وذاب الورد % % 76(@)(@@) % اسمع ما قال عندليب الورد % % والبلبل في الروض خطيب الورد % % 77(@)(@@) % الشرب على الورد نصيب الورد % % فالحسن أن يضيع وقت الورد % % 78(@)(@@) % ما أعلم حكم بينكم كيف نفذ % % أعطاني وحشتي وللأنس أخذ % % 79(@)(@@) % إن أرهف حده لقتلي وشحذ % % فالموت من الحياة في الهجر ألذ % % 80(@)(@@) % يا فجر أفيك أبتلى بالهجر % % يا هجر سلبتني ضياء الفجر % % PageV01P476 81(@)(@@) % صبري فان ودمع عيني يجري % % يا قلبي جل فيك منه أجري % % 82(@)(@@) % من خط لنا على عذار القمر % % خطا بجماله افتتان البشر % % 83(@)(@@) % هبه بيدي تبرؤا من خطري % % يا ناظره السقيم ما أنت بري % % 84(@)(@@) % يا غلبك من صدودك النار النار % % يا غلبك ليس لي على النار قرار % % 85(@)(@@) % يا غلبك في هواك عقلي قد حار % % من يأخذ منك للمعنى بالثار % % 86(@)(@@) % يا قلب لقد غرك بالحسن غرير % % القلب من الحديد والجسم حرير % % 87(@)(@@) % حلو وصدوده كبلواك مرير % % يا طرف متى تكون بالوصل قرير % % 88(@)(@@) % ما أطيب في وصاله أسحاري % % ما أوضح في عذاره إعذاري % % 89(@)(@@) % ما أسكرني وطرفه خماري % % ما أسعدني وهو على إيثاري % % 90(@)(@@) % من رصع حول خدك المحمر % % يا قوتك بالزمرد المخضر % % PageV01P477 91(@)(@@) % جد لي برحيق درك المفتر % % فالخمرة تستباح للمضطر % % 92(@)(@@) % كم يقتلني بطرفه الغماز % % كم يأنف للعزة من إعزازي % % 93(@)(@@) % كم مطل بالديون ذا إعواز % % ما أبعد وعده من الإنجاز % % 94(@)(@@) % لما نظر الطرف إلى الدر أزي % % من سهم جفون حبي القلب عزي % % 95(@)(@@) % ما أسعدني لو كنت بالمحترز % % من عيني فالقلب من العين رزي % % 96(@)(@@) % تفاح الخد من حماه بالآس % % يقظان بعينيه من الغنج نعاس % % 97(@)(@@) % ناديت وقد تاه من العجب وماس 
ms123	 % % ما الاسم فقال لا من الوصل إياس % % 98(@)(@@) % هبت سحرا فهيجت وسواسي % % نشوى خطرت عليلة الأنفاس % % 99(@)(@@) % أهدت أرج الرجاء بعد الياس % % ما أحسن بعد وحشتي إيناسي % % 100(@)(@@) % مولاي تريد أن يقول الناس % % هذا رجل خالطه وسواس % % PageV01P478 101(@)(@@) % حالان كلاهما لجرحي ياسو % % إما طمع فيك وإما ياس % % 102(@)(@@) % كم أذكره وهو لعهدي ناسي % % كم آمله وهو يريني ياسي % % 103(@)(@@) % بالله ترون منصفا في الباس % % من أجلي يستكين هذا الناسي % % 104(@)(@@) % كم أذكر من أراه للعهد نسي % % كم أحسن في الحب إليه ويسي % % 105(@)(@@) % فالقلب من الرضا به يأتسي % % لا بد لكل ظلمة من قبس % % 106(@)(@@) % لمح لحاجتي حذار الواشي % % فافتر ورده بطرف خاشي % % 107(@)(@@) % أخفي سري وهو بدمع فاشي % % لولا الواشي لكنت خلو الجاشي % % 108(@)(@@) % البعد من الحبيب قد أدهشني % % والشوق إلى زلاله أعطشني % % 109(@)(@@) % ما إن فقد عثرت أن تنعشني % % ما أوحشني بعدك ما أوحشني % % 110(@)(@@) % الدهر بيننا لسهميه يريش % % والجاش بنار وجده البرح يجيش % % PageV01P479 111(@)(@@) % إن طشت فذو الحلم من الشرب يطيش % % من فارقه الروح ترى كيف يعيش % % 112(@)(@@) % ما من أحد يزيد إلا نقصا % % إرحم أسفي وداو هذي الغصصا % % 113(@)(@@) % لم تلق فديت مثل قلبي قنصا % % الشوق أطاع فيك والصبر عصى % % 114(@)(@@) % يا من هو في الظلام كالبدر يضي % % إرحم دنفا سيم هوانا فرضي % % 115(@)(@@) % ما أبلغ منيتي وأقضي غرضي % % المسقم أنت من يداوي مرضي % % 116(@)(@@) % يا من سلب الفؤاد أين العوض % % لا بان بكيده لك المعترض % % 117(@)(@@) % أصميت وقلما أصيب الغرض % % الجوهر أنت والأنام العرض % % 118(@)(@@) % يا قلب عليه لا تكن معترضا % % ما يأمره فكن له معترضا % % 119(@)(@@) % إن كان رضاه في دمي فهو رضا % % لا بد من الرضا بما الرب قضى % % 120(@)(@@) % إن ضيعني فإنني أحفظه % % أرضيه بطاقتي ولا أحفظه % % PageV01P480 121(@)(@@) % قد نام الحظ فمن يوقظه % % قد أفلح من حبيبه يلحظه % % 122(@)(@@) % أشرفت فلا تكن غليظا فظا % % لا أقبل قط في حبيب وعظا % % 123(@)(@@) % القلب مذ استشار فيه اللحظا % % لم يترك للسلو فيه حظا % % 124 
ms124	(@)(@@) % الدهر ببيننا كثير الولع % % مغرى بشتات شملنا المجتمع % % 125(@)(@@) % قد سد علي فيك باب الطمع % % يا بدر ترى يعشقك الدهر معي % % 126(@)(@@) % ما أوقعني في الحب غير الطمع % % ما أسعدني لو كنت بالمقتنع % % 127(@)(@@) % مولاي لقد عذبتني بالخدع % % كالسهم مع الغر وكالقوس معي % % 128(@)(@@) % الحب بلية جناها الطمع % % ينضر به الفتى ولا ينتفع % % 129(@)(@@) % فالغر بلمعه له ينخدع % % والشاطر في شباكه لا يقع % % 130(@)(@@) % شيطان هواك مولع بالبزغ % % والعذل عليك في الحشا كاللدغ % % PageV01P481 131(@)(@@) % ويلاه من العذار حول الصدغ % % والعاجم من سواد ذاك الصبغ % % 132(@)(@@) % يا صاح على الصب إلى كم تبغي % % دع لومك لي فإنني لا أصغي % % 133(@)(@@) % سمعي لسوى حديث وجدي ملغي % % إلا لحبيب قلبه لا يبغي % % 134(@)(@@) % ما أكمل حسنه وما أطرفه % % ما أفتر لحظه وما أضعفه % % 135(@)(@@) % ما أنحف خصره وما أهيفه % % من قال هو البدر فما أنصفه % % 136(@)(@@) % الورد بخديك متى أقطفه % % والغصن لعطفيك متى أعطفه % % 137(@)(@@) % والشهد بفيك أشتهي أرشفه % % من لم يذق السكر لا يعرفه % % 138(@)(@@) % هل يتفق الملاح والعشاق % % أم تصطلح القلوب والأحداق % % 139(@)(@@) % لم يؤت الحظ قلبي المشتاق % % والدهر حظوظ أهله أرزاق % % 140(@)(@@) % ما أعلم والحظوظ كالأرزاق % % لم ضن بنظرة على المشتاق % % PageV01P482 141(@)(@@) % كم أحجب والشمس من الإشراق % % لا يحجب نورها على الآفاق % % 142(@)(@@) % هل أنت كما كنت على الميثاق % % لم ملت إلى تلون الأخلاق % % 143(@)(@@) % من بعدك ما أظن أني باقي % % لا رغبة في الحياة للمشتاق % % 144(@)(@@) % الصبر عليك ستره منهتك % % يا من بحبال وده أمتسك % % 145(@)(@@) % هذا قلبي أعز ما أمتكل % % عذبه فما عليك فيه درك % % 146(@)(@@) % أفتاك أبو حنيفه أم مالك % % هل تقتلني كأنني من مالك % % 147(@)(@@) % ما يحسن بالحسان ما يفعله % % هواك وأنت بالجفا تقتله % % 148(@)(@@) % أخلى لك قلبه فكم تشغله % % ما أسعد من حبيبه يقبله % % 149(@)(@@) % في حبك يا ظلوم حالت حالي % % ما العاطل في هواك مثل الحالي % % 150(@)(@@) % يلجأ سفها عليك خل خالي % % ما هام هوى بحسن ذاك الخال % % PageV01P483 151(@)(@@) % من بلبل صدغ قاتلي من 
ms125	 سلسل % % من أودع ثغره رحيقا سلسل % % 152(@)(@@) % من غلغلني في حبه من سلسل % % يا عاذل إن جهلت ما بي سل سل % % 153(@)(@@) % كم أنتظر النجاز من وعدكم % % كم أرتقب الحفاظ في عهدكم % % 154(@)(@@) % بالله أجيروني من بعدكم % % ما أمل أن أعيش من بعدكم % % 155(@)(@@) % الطرة والجبين صبح وظلام % % والريقة والوجنة ورد ومدام % % 156(@)(@@) % والحاجب والمقلة قوس وسهام % % هذا صنم وفيته للإسلام % % 157(@)(@@) % ما البدر كمن هويت حسنا وسنا % % لا يعرف في هواه طرفي وسنا % % 158(@)(@@) % غصن عطف القلب عليه وثنا % % دع عذلك قد رضيته لي وثنا % % 159(@)(@@) % لا زار خيال طيفكم أحيانا % % وهنا فأقام ساعة أحيانا % % 160(@)(@@) % غبتم فحنا رقادي الأجفانا % % نمتم وسهرت أينا أجفانا % % PageV01P484 161(@)(@@) % أفدي سكنا بربع قلبي سكنا % % من أجل ثناياه عبدت الوثنا % % 162(@)(@@) % ينوى ظعنا فيورث القلبق ضنى % % قد أودعنا السقام مذ ودعنا % % 163(@)(@@) % يا من أدعو فيستجيب الدعوى % % هل يحسن بي إلى سواك الشكوى % % 164(@)(@@) % أنت المبلي فكن مزيل البلوى % % ما يسعد للضعيف إلا الأقوى % % 165(@)(@@) % أوهى جلدي بعقد خصر واهي % % أصمى كبدي بسهم لحظ ساهي % % 166(@)(@@) % بالخد معذبي حبيب لاهي % % لا يلجيء من هواه غير الله % % 167(@)(@@) % إن كنت تريد يوسف الحسن فهو % % لا أعرف في الأنام من يشبهه % % 168(@)(@@) % العسجد لا يجوز فيه الشبه % % والخالص بالرديء لا يشتبه % % 169(@)(@@) % القلب على غرامه قد آلى % % أن ليس يطيع في هواكم آلا % % 170(@)(@@) % يا من أضحى ودادهم لي آلا % % هذا جسدي إلى البلى قد آلا % % PageV01P485 171(@)(@@) % من علم أعطف الغصون الميلا % % من صير قلبي رهن هم وبلا % % 172(@)(@@) % من سمع . . . . لسعي العدلا % % ما آن بأن تميل من قولك لا % % 173(@)(@@) % قولا لمنى إسما عيلا % % أنعم بنعم أطلت إسماعي لا % % 174(@)(@@) % شغلت جوائي بالهوى تشغيلا % % أدرك رمقي فإن صبري عيلا % % 175(@)(@@) % إقنع لتقر بالقضا مرتضيا % % لا بعدئذ من مطمع مقتضيا % % 176(@)(@@) % لولا طلب البدر من الشمس ضيا % % ما كان زمان نوره منقضيا % % 177(@)(@@) % لما اضطرمت على يدي ساقيها % % فارتاع لها فهم أن يلقيها % % 178(@)(@@) % قدمت إليه 
ms126	 الماء كي يطفيها % % ألقاه بها فزاد نار فيها % % 179(@)(@@) % يا غاية بغيتي ويا أولاها % % يا سيد سادتي ويا أولاها % % 180(@)(@@) % يا آخر منيتي أولاها % % ما أنصف من يقتلني قد لاها % % PageV01P486 
