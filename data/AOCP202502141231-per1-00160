ms153	 اسعد گنجهای(@)(@@) (@@) 15 ای فتنهآ دلبران یغما چشمت %~% وی بر ده دل مرا به یغما چشمت(@)(@@) (@@) گرمایهآ حسن خواهی، اینک رویت! %~% ورعین نکویی طلبی، ها چشمت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 152 ها! قدش، اگر سرو روان دیده نه ای %~% ها! لعلش، اگر راحت جان دیده نه ای(@)(@@) (@@) در چهرهآ خوب و، چشم مستش بنگر %~% گر مست میان گلستان دیده نه ای(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 152 چشم تو، که جز سحر پرستی نکند %~% الآ به جفا، دراز دستی نکند(@)(@@) (@@) با باده، اگر قصهآ مستیش کنند %~% وله %~% اندر همه عمر، باده مستی نکند!(@)(@@) ~~152 چشمت، که به فتنه در جهان موصوف است بر روی تو، حسن و دلبری موقوف است(@)(@@) (@@) یماری چشم خوشت، از چشم من است %~% وله %~% «(العین حق») آخر خبری معروف است!(@)(@@) (@@) 152 چشم تو، که با زلف توهمدستی کرد %~% تا از من بیدل، طمع هستی کرد(@)(@@) (@@) بد کرد، در این سخن شکی نیست، ولیک %~% جرمش ننهم، چرا که از مستی کرد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~(152 ای خون مرا ریخته مطلق چشمت وی کار مرا برده ز رونق چشمت(@)(@@) ~~ان روی، که سحر نزد خلقان حق است در سحر، همی زند اناالحق چشمت(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1520 چشمت، که به مکر و ساحری نزدیک است وز بیرحمی، به کافری نزدیک است(@)(@@) (@@) گرچه زلبت، به جانفروشی دور است %~% با ابرویت، به دلبری نزدیک است PageV01P299(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0303.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 1530 چشمش، که درید پرده مستوران را %~% بیماری او، بکشت رنجوران را(@)(@@) (@@) گفتم: نظری به کار من در نکنی؟ %~% گفتا که : مده صداع مخموران را!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 1531 ای روی تو آب گل رعنا برده %~% صبر از دل من، غمت به غوغا برده(@)(@@) (@@) در بوالعجبی، هفت فلک را چشمت %~% شش خصل فرو داده و، عذرا برده!(@)(@@) قطب عتیقی(@)(@@) (@@) 1532 پیوسته، از آن سلسله مومی ترسم %~% با اینهمه حسن ولطف، از او می ترسم(@)(@@) (@@) ترس دل هر که هست، از چشم بد است %~% بیچاره من، از چشم نکومی ترسم!(@)(@@)(@@)(@@) | اثیر(@)(@@) (@@) 1533 تا چشم دلی چشمهآ 
ms154	 حیوان دیدهست %~% دشواری عشق، بر دل آسان دیده ست(@)(@@) (@@) جز چشم توبر روی تو، ای چشمهآ نوش %~% کس نرگس تر بر گل خندان دیدهست؟(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1534 دی باز نظر به هرکجا می انداخت %~% سر مستی او، مرا ازپا می انداخت(@)(@@) (@@) ازبند 0000000000000000000000000000 %~% چشمش همه تا بتا به ما می انداخت(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1535 چشمت که فسون سامری [ز] اید از او %~% بر هم چه زنی؟ که بوی خون آید از او(@)(@@) (@@) این نادرهتر، که خون چنان می ریزد %~% کالبته، سر مژه نیالاید از او(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1536 عقل، از گر زلف تو، پرتاب شود %~% هوش، از سخن خوش تو در خواب شود(@)(@@) (@@) تیری، که زغمزهآ تو پرتاب شود %~% گر بر جگر سنگ و سد، آب شود!(@)(@@) ~~1537 جانا، سر زلفت شغب انگیز چراست؟ در کشتن من غمزهآ تو تیز چراست؟(@)(@@) (@@) عیار چوچشم توست، در عالم حسن %~% پس دیدهآ من، همیشه خونریز چراست؟(@)(@@)(@@)(@@) | عبدالرزاق(@)(@@) ~~1538 یارم چو سر زلف به هم برشکند برلاله ومشک، عنبر تر شکند(@)(@@) (@@) هنگام کرشمه، ناوک غمزهآ او %~% دل دوزد و، جان شکافد و، سر شکندا PageV01P300(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0304.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1539 از زلف خوشت، مشک ختن در تاب استوزلعل لبت، تنگ شکر در تاب است(@)(@@) (@@) این خود سهل است، باش تا چشم خوشت %~% الغیره %~% بیدار شود، که فتنه اندر خواب است!(@)(@@) (@@) 1540 گفتم که: دلم، چشم تومی پست کند %~% کو جورکند برو و، پیوست کند(@)(@@) (@@) زلفت، به تعصبش مرا می گوید: %~% مست است، کسی شکایت از مست کند؟(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 1541 دل گفت: چودر چاه زنخدان شدمش %~% ناکام به کام بند و زندان شدمش(@)(@@) (@@) غمزهش، ز پی چه می کشد ترکش تیر؟ %~% لغیره %~% ناکرده کمان به زه، چو قربان شدمش!(@)(@@) (@@) 1542 چون چشم خوشت به باغ، عبهر ناید %~% باتو به ستمگری، فلک بر ناید(@)(@@) (@@) از خار مژه به گرد چشمت، پرچین %~% زان است، که کس به چشمت اندر ناید!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1543 گر لعل لبت، به بوسه سرکش نبود %~% از 
ms155	 دست تو، هیچ دل در آتش نبود(@)(@@) (@@) جانا توبه لب مسیح و، آنگاه به چشم %~% وله %~% کار ملک الموت کنی، خوش نبود!(@)(@@) (@@) 1544 با ماهرخی، که زلف او پرشست است %~% سرو سهی، از شرم قد او پست است(@)(@@) (@@) گفتم که: یکی بوسه بده، گفت: به چشم! %~% لغیره %~% گفتم: نه به لب حواله کن، کومست است!(@)(@@) ~~1545 چشم خوش تو، رهزن جان و خرد است بیچاره کسی، که زخمش از چشم زد است(@)(@@) (@@) گر حال کسی زچشم بد، بد گردد %~% احوال من از چشم نکوی تو، بد است!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1546 آهو برهای، که قصد شیران کند اووزشیر دلی، کار دلیران کند او(@)(@@) (@@) خواهد، که همه خراب و آباد جهان %~% الغیره %~% در چشم زدی، به غمزه و یران کند او!(@)(@@) ~~2542 کم. ردوب مرا یکی کام بده(@)(@@) ~~ور کام من، از لب چو شکرندهی PageV01P301(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0305.jpg)(@)(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) ~~1548 دلدار چو تو، به روزگاری نبود چون من زغم تو، دلفگاری نبود(@)(@@) (@@) زنهار، به خون ریختنم چشمت را %~% بر کار مکن، که هیچ کاری نبود!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1549 خط تو و چشم تو، به هم بنشستند %~% بر خون دلم چو محضری بر بستند(@)(@@) (@@) قاضی، توبدان خط و گوا حکم مکن %~% کان خط مزور و، گواهان مستند!(@)(@@) (@@) 1550 در دولست وصلت، ارز بیکارانیم %~% اوله %~% و اندر نظرت، گر زسبکسارانیم(@)(@@) ~~زلف تو و نرگس تودانند، که ما 1551 گر بر دارم بی تو، سر از بیماری(@)(@@) %~% اوله %~% غمخوارشکستگان و بیمارانیم %~% در پا آیم، چو عبهر از بیماری(@)(@@) (@@) ار پرست چشم بیمارتوام %~% بیمار پرستی، بتر از بیماری!(@)(@@) (@@) 1552 چشم تو، که بیماری او ننهفتهست %~% اوله %~% در خیره کشی، طاق فلک را جفت است(@)(@@) (@@) معذور بود زلف تو، گر آشفتهست %~% زیرا که دو بیمار عزیزش خفته ست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1553 مانند دو چشمیم، من و آن دلبر %~% در نیک و بد زمانه، با هم یاور(@)(@@) (@@) هر شب تا روز، خفته با یکدیگر %~% یک روز، ندیده یکدگر را به نظر! 
ms156	(@)(@@) (@@) 1554 بر چشم تو، هر گه که مرا افتد چشم %~% وله %~% با اشک به رخ فرو دود، بی خود چشم(@)(@@) (@@) بر دیده نهم زعشق چشمت، نرگس 1555 باور نکنی که از من عشوه پرست %~%(@)(@@) اله %~% دارند عزیز، بهر چشمی صد چشم! %~% بر بود دل شکسته آن نرگس مست(@)(@@) (@@) تا راست بگوید این سخن در رویت %~% هم، مردمک دیدهآ توکژ بنشست!(@)(@)PageV01P302(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0306.jpg)(@)(@)(@@) ~~1556 دل را، ز رخ خوب تومی نگزیرد از کژ طبعی، که مردم دیدهآ توست(@)(@@) %~% وله %~% از چشم خوشت، کنارهای می گهرد! %~% چون زلف تو زان، قرار می نپذیرد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1557 زلفت، چوز روی باز پس می افتد چشم تو، که عالمی نیفتد در وی %~%(@)(@@) مست است، از آن بر همه کس می افتد! %~% در پای توچون من، به هوس می افتد(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) (155 خیره کش و مست و جانستان، غمزه توست %~% مرد افکن و سست و ناتوان، غمزهآ توست!(@)(@@) ~~یمار که جان دهد، فراوان باشد ترک است وسیه دل است ومست است آن چشم(@)(@@) 1559 در حسرت آن چشم، مکن جان ای دل %~% وله %~% زو چشم مدار مردمی، هان ای(@)(@@) دل! %~% بیمار که جان ستاند، آن غمزهآ توست! %~% این را، به امید آن مرنجان ای دل(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 156 اشکال دو لعل خود، زدلداران پرس %~% شرح غم وتیمار من، ازیاران پرس(@)(@@) (@@) از نرگس خود پرس، که زلفت چون است %~% آهنگ شب ورا، زبیماران پرس(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1561 ای دل، سخن وفای جانان مشنو %~% کان نیست به جز عشوه و دستان، مشنو(@)(@@) (@@) وربا تو، به مردمی در آید چشمش %~% او مست بود، حدیث مستان مشنو!(@)(@@)(@@)(@@) | عزیز کخال(@)(@@) ~~1561 ترکان، که به قامت خدنگند همهتاراج دهان نام و ننگند همه(@)(@@) (@@) فنبر بویان لاله رنگند همه %~% بی عیب خذاست، چشم تنگند همه!(@)(@@) (@@) 1563 ترکی، که به چهره داد خوبی دادهست %~% الغیره %~% گویی که ز مادر لطافت زادهست(@)(@@) (@@) هر کز به یکی بوسه زما[رخصه] نداد %~% آن ترک، عظیم تنگ چشم افتادهست! 
ms157	(@)(@)PageV01P303(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0307.jpg)(@)(@)(@@)(@@)(@@) | رضیه گنجه ای(@)(@@) (@@) 1564 زلف تو، چو آه من درازی دارد %~% خلق خوش تو، بنده نوازی دارد(@)(@@) (@@) چشم خوش تو، دوست از آن می دارم %~% کز منت سرمه، بی نیازی دارد(@)(@@)(@@)(@@) | نهستی(@)(@@) (@@) 1565 باد آمد و، گل بر سر میخواران ریخت %~% یار آمد و، می در قدح یاران ریخت(@)(@@) (@@) آن عنبرتر، رونق عطاران برد %~% وان نرگس مست، خون هشیاران ریخت!(@)(@@)(@@)(@@) | ولها(@)(@@) (@@) 1566 ای دست تودست من به دستان بسته %~% با زلف تو،عهد بت پرستان بسته(@)(@@) (@@) وی نرگس مست تو، به هنگام صبوح %~% هشیاران را، به جای مستان بسته!(@)(@@) پسر خطیب گنجه(@)(@@) (@@) 1567 با هر که دلم زعشق تو راز کند %~% اول، سخن از هجر تو آغاز کند(@)(@@) (@@) از ناز، دو چشم خود چنان باز کنی %~% کانده زده، لب به خنده ای باز کند(@)(@@)(@@)(@@) | لیانی(@)(@@) (@@) 1568 در پرده نهان آن رخ رخشان چه کنی؟ %~% وزغم، دل وجان خلق بریان چه کنی؟(@)(@@) (@@) خود توبنما، به غمزه عالم ویران %~% وانگه تودر آن عالم و یران چه کنی؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 159 لطفی که در آن لعل شکر بار بود %~% آن داند، کو میانهآ کار بود(@)(@@) (@@) از نرگس خود، درازی زلف بپرس %~% آگه زشب دراز، بیمار بود(@)(@@)(@@)(@@) | عمر گنجه ای(@)(@@) (@@) 1570 ای در دلم از مهر توبازاری خوش %~% جز عشق تو، نیست در جهان کاری خوش(@)(@@) (@@) ناخوش باشد، کسی که بیمار بود %~% این طرفه، که چشم توست بیماری خوش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1571 در پیش خدنگ چشم پر تشو یرش %~% خون شد دل من، نشانه شد دلگیرش(@)(@@) (@@) زان پیش، که او نشانه با تیر زند %~% وله %~% آن دل که نشانه بد، زدم بر تیرش(@)(@@) (@@) 1572 ای خال وخط وعارض ورخسار توخوش %~% وی لعل لب ولفظ شکر بار توخوش(@)(@@) (@@) بوسی زلب لعل، به شکرانه بده %~% زان روی، که شد نرگس بیمار تو خوش!(@)(@)PageV01P304(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0308.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1576 با مشک خط توم مشک بیمقدار است بیش شکر لب تو شکر، خوار است(@)(@@) (@@) لعل لب تو، طبیب هرخسته دل 
ms158	 است %~% چشم تو، نگویی چه سبب بیمار است؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 157 تا چشم خوشت نظر برید از کارم %~% ور زلف تو بست بر میان زنارم(@)(@@) (@@) چون زلف تو، گه شیفته گه پیچانم %~% چون چشم تو گه مست و، گهی بیمارم(@)(@@)(@@)(@@) | اوله(@)(@@) ~~157 ترکی، که مرا به چشم جادو فکند در پای خودم، چوزلف هندو فکند(@)(@@) ~~با رب، که چه چشم تنگ ترکی است کزو بوسی طلبم، گره در ابرو فکند(@)(@@)(@@)(@@) | شمس هروی(@)(@@) (@@) 157 چشم تو، به کین من کمر بگشاید %~% زلف تو، قرار و صبر من بر باید(@)(@@) ~~این دزدی دل می کند، آن غارت جان وین هر دو عمل، زترک و هندو آید!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1571 لعلت، چوبه دشنام شکر خای شود %~% جزعم، ز دو لعل تو گهر زای شود(@)(@@) (@@) هر تیر، که چشم توبه کین اندازد %~% در سینهآ پر درد منش جای شود(@)(@@) (@@) چشم سیهش، به عزم خون ریختنم 157 سر مست بتم، زمی دهان پر کرده %~%(@)(@@) وله %~% اوله %~% وز عربدهآ غمزه، جهان پر کرده %~% می آید، وز دور کمان پر کرده(@)(@@) (@@) 1575 شگر، زلبان می پرستش خیزد %~% دام دل، از آن زلف چو شستش خیزد(@)(@@) (@@) فرفتنه، که در زمانه قایم گردد %~% از عربدهآ نرگس مستش خیزد(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~1580 چشم سیهت، غمزهآ جادو دارد نیشی است، اگرچه نوشدار و دارد(@)(@@) ~~برزخم دل خستهآ من، پیوسته تیر مژه، در کمان ابرو دارد(@)(@@)(@@)(@@) | حسین هزارمرد(@)(@@) (@@) 158 از روی تو، صاحبنظران واگویند %~% %~% وز خال وخطت، همه جهان واگویند PageV01P305(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0309.jpg)(@)(@)(@@)(@@)(@@) | بدرتفلیسی(@)(@@) (@@) 1582 آن کیست، که جان و دل نثارت نکند؟ %~% سر در سر چشم پر خمارت نکند؟(@)(@@) (@@) وان چیست، که در شیوهآ رنگ آمیزی %~% جشم س %~% ه %~% بدکارت نکند؟(@)(@@)(@@)(@@) | جمال گنجه ای(@)(@@) (@@) 1583 با من صنما، به مهر کوشی یا نه؟ %~% وز ما، سخن وفا نیوشی یا نه?(@)(@@) (@@) گیرم، که زلب شکر به من می ندهی %~% بادام، زچشم می فروشی یانه؟(@)(@@) (@@) 1584 جانا، صفت قدم زابروت بپرس %~% شوریدگیم، ز زلف هندوت بپرس 
ms159	(@)(@@) (@@) حال دلم، از دهان تنگم بطلب %~% بیخوابیم، از نرگس جادوت بپرس(@)(@@)(@@)(@@) | ظهیر شفروه(@)(@@) (@@) 1585 ای تازه نسیم زلف عنبر بارش %~% چون برگذری بر طرف گلزارش(@)(@@) (@@) آهسته گذر، که نرگس بیمارش %~% نیره %~% خفتهست، به سایهآ گل رخسارش(@)(@@) (@@) 1586 دل، از قدح درد تو دردی کش باد %~% وان جان که نه خاک توست، برآتش باد(@)(@@) (@@) چشم خوش تو، فتنهآ خفتهست او را %~% گویی که دعاکرد که (رخوابت خوش باد!)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1587 زلفت صنما، به خم گرفتار چراست؟ %~% وان مقبل نیک بی، نگوسار چراست؟(@)(@@) (@@) خط تو مزور است و، لعل توشکر %~% پس نرگس مخمور تو بیمار چراست؟(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 1588 دی، نرگس مست یار می گفت نهفت: %~% فردا، به مراد دل شوی با ما جفت(@)(@@) (@@) امروز خلاف می کند، دوش نخفت %~% مست است، مگریاد ندارد که چه گفت!(@)(@@)(@@)(@@) | مهذب دبیر(@)(@@) (@@) 1589 رفتم، که سمند رحلتم سرکش باد %~% بی روی تو، راه و منزلم آتش باد(@)(@@) (@@) ار کشته شوم، خون من از چشمت خواه %~% کو کشت مرا و، من شدم، شب خوش باد!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1590 گفتم: مشکن پشت دلم از همه روی %~% خاکت شده ام، میفکن از خانه به کوی(@)(@@) (@@) بگداختیم چومو، بترزین چه کنی؟ %~% گفتا که: به تیر غمزه بشکافم موی!(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) (@@) 1591 گر گوی شوم در برت، ای زیباروی %~% زلف تو، به چوگان قضا بازد گوی(@)(@@) (@@) ور موی شوم زعشقت، ای زیبا موی %~% چشم تو، به تیر غمزه بشکافد موی!(@)(@)PageV01P306(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0310.jpg)(@)(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~1592 ورزیدن سودای تو، مشکل کاری است بخریدن بوسهآ تو، خوش بازاری است(@)(@@) (@@) چشم تو، فراز بستر نیکویی %~% انصاف بداد دل، که خوش بیماری است(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 1593 با زلف تو، کو مشک طرازی داند %~% گفتم ««قلبی معک» به بازی داند(@)(@@) (@@) با او تازی برای آن گویم، کو %~% چون چشم خوش تو، تر کتازی داند!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~159 جانا، به غمم سپردهای نیک است این لوح طر بم ستردهای، نیک است این(@)(@@) (@@) از جمله جهان، نیم دلی بود 
ms160	 مرا %~% آن نیز به خشم برده ای، نیک است این(@)(@@)(@@)(@@) | وله(@)(@@) ~~1595 چشم تو، به کینه با جهان می کوشد در کشتن من، خیره از آن می کوشد(@)(@@) (@@) با چشم بگو: به کشتنم رنجه مشو %~% خود چرخ بدین کار، به جان می کوشد(@)(@@)(@@)(@@) | نمط ششم(@)(@@) در تشبیهات گوش و حلقه(@)(@@)(@@)(@@) | [جمال) عبدالرزاق(@)(@@) ~~1593 ای در دل من مهر توشیرین چوامید ی وصل تو شایسته چوعمری جاوید(@)(@@) ~~در گوش تو آن حلقهآ زر، گویی هستآویخته ماه نو، زطرف خورشید(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~1597 چون نیست حدیث وصلت از زرخالیهم نرم کنم تورا، به جنس مالی(@)(@@) ~~زر را بفرستم، که خود او چون حلقهگوشت گیرد، پیش من آرد حالی(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1598 آمد بر من، چودر کفم زرپنداشت چون دید که زر نداشتم، ره بگذاشت(@)(@@) (@@) از حلقهآ گوش او، مرا شد معلوم %~% کانجا که زراست، گوش می باید داشت PageV01P307(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0311.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1599 از حلقهآ گوش تو، دلم با خبر است %~% کاین تندی طبعت، همه از بهر زر است(@)(@@) (@@) از گوش تو، خود قیاس می باید کرد %~% وله %~% کانجا که زر است، پاره ای نرم تراست(@)(@@) (@@) 1600 دی گفت مرا: حدیث من کمتر گوی %~% ورمی گویی، به گوش من اندر گوی(@)(@@) (@@) بنمود مرا، حلقهآ زرین در گوش %~% یعنی که: حدیث وصل من با زر گوی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1601 آن را که چوتو، نگار در خور باشد %~% باید که ز سیم و زر توانگر باشد(@)(@@) (@@) در گوش تو، هر سخن که بی زرباشد %~% از حلقهآ تو، میان تهی تر باشد(@)(@@)(@@)(@@) | شمس هروی(@)(@@) (@@) 1602 از حلقهآ گوش آن بت ماه مثال %~% گویی فلک از بدر، در آویخت هلال(@)(@@) ~~تا لاجرم، آن ماهرخ مشکین خالانگشت نمای عالمی شد، به جمال(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1603 ترکی که به بزم و رزم، تند آمد و رام با دشمن و با دوست کشد، خنجر و جام(@)(@@) (@@) آورد ز زلف و رخ، شب و روز پدید %~% کرد از زر پخته، حلقه در نقرهآ خام 