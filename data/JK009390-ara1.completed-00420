ms419	 والإكرام ) )(@)(@@) ( ت ) عن أنس ( حم ن ك ) عن ربيعة بن عامر رضي الله عنهما .(@)(@@) PageV02P072(@)(@@)(@@)(@@) $ ( 3984 ) قال النبي :(@)(@@) | 30 ( ألق عنك شعر الكفر ثم اختتن ) )(@)(@@) ( حم د ) عن عثيم بن كليب .(@)(@@)(@@)(@@) $ ( 3985 ) قال النبي :(@)(@@) | 30 ( الله الطبيب ) )(@)(@@) ( د ) عن أبي رمثة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3986 ) قال النبي :(@)(@@) | 30 ( الله الله في أصحابي لا تتخذوهم غرضا بعدي فمن أحبهم فبحبي أحبهم ومن أبغضهم فببغضي أبغضهم ، ومن آذاهم فقد آذاني ومن آذاني فقد آذى الله ، ومن آذى الله يوشك أن يأخذه ) )(@)(@@) ( ت ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3987 ) قال النبي :(@)(@@) | 30 ( الله الله فيما ملكت أيمانكم ألبسوا ظهورهم ، وأشبعوا بطونهم ، وألينوا لهم القول ) )(@)(@@) ( ابن سعد طب ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3988 ) قال النبي :(@)(@@) | 30 ( الله الله فيمن ليس له ناصر إلا الله ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3989 ) قال النبي :(@)(@@) | 30 ( الله مع القاضي ما لم يجر ، فإذا جار تخلى الله عنه ولزمه الشيطان ) )(@)(@@) ( ت ) عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3990 ) قال النبي :(@)(@@) | 30 ( الله ورسوله مولى من لا مولى له والخال وارث من لا وارث له ) )(@)(@@) ( ت ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3991 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل أوسع رزقك علي عند كبر سني وانقطاع عمري ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3992 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل بالمدينة ضعفي ما جعلت بمكة من البركة ) )(@)(@@) ( حم ق ) عن أنس رضي الله عنه .(@)(@@) PageV02P073(@)(@@)(@@)(@@) $ ( 3993 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل حبك أحب الأشياء إلي ، واجعل خشيتك أخوف الأشياء عندي ، واقطع عني حاجات الدنيا بالشوق إلى لقائك ، وإذا أقررت أعين أهل الدنيا من دنياهم فأقرر عيني من عبادتك ) )(@)(@@) ( حل ) عن الهيثم بن مالك الطائي .(@)(@@)(@@)(@@) $ ( 3994 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل رزق آل محمد في الدنيا قوتا ) )(@)(@@) ( م ت ه ) .(@)(@@)(@@)(@@) $ ( 3995 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل فناء أمتي قتلا في