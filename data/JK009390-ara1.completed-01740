ms1721	 في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P409(@)(@@)(@@)(@@) $ ( 15618 ) قال النبي :(@)(@@) | 30 ( كان اللواط في قوم لوط في النساء قبل أن يكون في الرجال بأربعين سنة ) )(@)(@@) ابن أبي الدنيا في ذم الملاهي وابن أبي حاتم ( هب كر ) عن أبي صخرة جامع بن شداد مرسلا .(@)(@@)(@@)(@@) $ ( 15619 ) قال النبي :(@)(@@) | 30 ( كان فيمن كان قبلكم رجل قتل تسعة وتسعين نفسا ، فسأل عن أعلم أهل الأرض ، فدل على راهب فأتاه فقال : إنه قتل تسعة وتسعين نفسا فهل له من توبة ؟ فقال : لا ، فقتله وكمل به المائة ، ثم سأل عن أعلم أهل الأرض فدل على رجل ، فقال : إنه قد قتل مائة فهل له من توبة ؟ قال : نعم ، من يحول بينك وبين التوبة ؟ إيت أرض كذا وكذا ، فإن بها ناسا يعبدون الله فاعبد الله ولا ترجع إلى أرضك فإنها أرض سوء ، فانطلق حتى إذا أنصف الطريق أتاه الموت ، فاختصمت فيه ملائكة الرحمة وملائكة العذاب ، فقالت ملائكة الرحمة : جاءنا تائبا مقبلا بقلبه إلى الله ، وقالت ملائكة العذاب : إنه لم يعمل خيرا قط ، فأتاهم ملك في صورة آدمي فجعلوه بينهم ، فقال : قيسوا ما بين الأرضين أيهما كان أقرب فهي له ، فقاسوه فوجدوه أدنى إلى الأرض التي أراد ، فقبضته بها ملائكة الرحمة ) )(@)(@@) ( حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15620 ) قال النبي :(@)(@@) | 30 ( كان الوحي يأتيني على نحوين : يأتيني به جبريل فيلقيه علي كما يلقي الرجل على الرجل فذاك يتفلت مني ، ويأتيني في شيء مثل صوت الجرس حتى يخالط قلبي فذالك الذي لا يتفلت مني ) )(@)(@@) ابن سعد عن عبد العزيز بن عبد الله بن أبي سلمة عن عمه بلاغا .(@)(@@)(@@)(@@) $ ( 15621 ) قال النبي :(@)(@@) | 30 ( كان رجل من بني إسرائيل لا يأتيه أحد يستسلفه شيئا إلا أسلف إياه بكفيل ، فأتاه رجل فقال : أسلفني ستمائة دينار ؟ فقال : ائتني بكفيل ؟ قال : الله كفيلي ، قال : رضيت ، فأعطاه ستمائة دينار وضرب له أجلا ، وخرج الرجل إلى البحر ، فلما جاء الأجل ، جعل الرجل يختلف إلى ساحل البحر PageV05P410 يسأل عن الرجل ، فبينا هو كذالك إذا ألقى 
ms1722	 إليه البحر خشبة ، فأخذها فانطلق بها إلى منزله فكسرها فإذا فيها الدنانير ومعها كتاب : إني قد دفعت الدنانير إلى الكفيل ثم لم يلبث أن قدم الرجل فأتاه فقال : الدنانير ؟ فقال : انطلق حتى أدفعها إليك ، فلما جاء بالدنانير ليدفعها إليه ، قال : أما إن الكفيل قد أداها لي ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15622 ) قال النبي :(@)(@@) | 30 ( كان رجل يصلي فلما سجد أتاه رجل فوطىء على رقبته ، فقال الذي تحته : والله لا يغفر الله لك أبدا ، فقال الله عز وجل : تآلى علي عبدي ، أن لا أغفر لعبدي ؟ فإني قد غفرت له ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15623 ) قال النبي :(@)(@@) | 30 ( كان الكتاب ينزل أول من باب واحد على حرف واحد ، نزل القرآن من سبعة أبواب على سبعة أحرف : زاجر وآمر ، وحلال وحرام ، ومحكم ومتشابه وأمثال ، فأحلوا حلاله ، وحرموا حرامه ، وافعلوا ما أمرتم به ، وانتهوا عما نهيتم عنه ، واعتبروا بأمثاله ، واعملوا بمحكمه ، وآمنوا بمتشابهه ، وقولوا : آمنا به كل من عند ربنا ) )(@)(@@) ابن جرير ( ك ) وأبو نصر السجزي في الإبانة عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15624 ) قال النبي :(@)(@@) | 30 ( كانت شجرة في طريق الناس تؤذي الناس ، فأتاها رجل فعزلها عن طريق الناس ، فلقد رأيته يتقلب في ظلها ) )(@)(@@) ( حم ) و الخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15625 ) قال النبي :(@)(@@) | 30 ( كانت شجرة تؤذي أهل الطريق ، فقطعها رجل نحاها عن الطريق فأدخل الجنة ) )(@)(@@) الرافعي عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P411(@)(@@)(@@)(@@) $ ( 15626 ) قال النبي :(@)(@@) | 30 ( كانت تحية الأمم وخالص ودهم ، وإن أول من عانق ، إبراهيم ) )(@)(@@) ابن أبي الدنيا في كتاب الإخوان عن تميم الداري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15627 ) قال النبي :(@)(@@) | 30 ( كانت حواء لا يعيش لها ولد ، فنذرت لئن عاش لها ولد لتسمينه عبد الحارث ، فعاش لها ولد فسمته عبد الحارث ، وإنما كان ذالك عن وحي الشيطان ) )(@)(@@) ( ك ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15628 ) قال النبي :(@)(@@) | 30 ( كانت للأنبياء كلهم مخصرة يتخصرون بها تواضعا لله عز وجل ) )(@)(@@) أبو 
ms1723	 نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15629 ) قال النبي :(@)(@@) | 30 ( كانت صلاة الضحى أكثر صلاة داود عليه السلام ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15630 ) قال النبي :(@)(@@) | 30 ( كانت مشيئة الله عز وجل في إسلام عمي العباس ، ومشيئتي في إسلام عمي أبي طالب ، فغلبت مشيئة الله مشيئتي ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15631 ) قال النبي :(@)(@@) | 30 ( كانت بنو إسرائيل اتخذوا قبور أنبيائهم مساجد فلعنهم الله تعالى ) )(@)(@@) عبد الرزاق عن عمر وابن دينار قال : ذكروا .(@)(@@)(@@)(@@) ||| ( الكاف مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15632 ) قال النبي :(@)(@@) | 30 ( كبر كبر ) )(@)(@@) ( حم ق د ) عن سهل بن أبي خيثمة PageV05P412 ( حم ) عن رافع بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15633 ) قال النبي :(@)(@@) | 30 ( كبرت الملائكة على آدم أربعا ) )(@)(@@) ( ك ) عن أنس ( حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15634 ) قال النبي :(@)(@@) | 30 ( كبروا على موتاكم بالليل والنهار أربع تكبيرات ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15635 ) قال النبي :(@)(@@) | 30 ( كبري الله مائة مرة ، واحمدي الله مائة مرة ، وسبحي الله مائة مرة ، خير من مائة فرس ملجم مسرج في سبيل الله ، وخير من مائة بدنة ، وخير من مائة رقبة ) )(@)(@@) ( ه ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15636 ) قال النبي :(@)(@@) | 30 ( كبرت خيانة أن تحدث أخاك حديثا هو لك به مصدق ، وأنت له به كاذب ) )(@)(@@) ( خد د ) عن سفيان بن أسيد ( حم طب ) عن النواس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15637 ) قال النبي :(@)(@@) | 30 ( كبر مقتا عند الله : الأكل من غير جوع ، والنوم من غير سهر ، والضحك من غير عجب ، وصوت الرنة عند المصيبة ، والمزمار عند النعمة ) )(@)(@@) ( فر ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الكاف مع التاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15638 ) قال النبي :(@)(@@) | 30 ( كتاب الله القصاص ) )(@)(@@) ( حم ق د ن ه ) عن أنس رضي الله عنه .(@)(@@) PageV05P413(@)(@@)(@@)(@@) $ ( 15639 ) قال النبي :(@)(@@) | 30 ( كتاب الله هو حبل الله الممدود من السماء إلى الأرض ) )(@)(@@) ( ش ) و ابن جرير عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15640 ) قال النبي :(@)(@@) | 30 
ms1724	 ( كتب الله تعالى مقادير الخلائق قبل أن يخلق السماوات والأرض بخمسين ألف سنة وعرشه على الماء ) )(@)(@@) ( م ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15641 ) قال النبي :(@)(@@) | 30 ( كتب ربكم على نفسه بيده قبل أن يخلق الخلق : رحمتي سبقت غضبي ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15642 ) قال النبي :(@)(@@) | 30 ( كتب على ابن آدم نصيبه من الزنا مدرك ذالك لا محالة ، فالعينان : زناهما النظر ، والأذنان : زناهما الاستماع ، واللسان : زناه الكلام ، واليد : زناها البطش ، والرجل : زناها الخطا ، والقلب يهوى ويتمنى ، ويصدق ذالك الفرج ويكذبه ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15643 ) قال النبي :(@)(@@) | 30 ( كتب علي الأضحى ولم يكتب عليكم ، وأمرت بصلاة الضحى ولم تؤمروا بها ) )(@)(@@) ( حم طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15644 ) قال النبي :(@)(@@) | 30 ( كتاب الله وسنتي لن يتفرقا حتى يردا علي الحوض ) )(@)(@@) أبو نصر السجزي في الإبانة وقال غريب جدا عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15645 ) قال النبي :(@)(@@) | 30 ( كتب الله على العباد خمس صلوات ، فمن أتى بهن وقد أدى حقهن كان له عند الله عهد أن يدخله الجنة ، ومن أتى بهن وقد ضيع حقهن استخفافا لم يكن له عهد إن شاء عذبه وإن شاء رحمه ) )(@)(@@) ابن نصر عن أبي هريرة PageV05P414 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15646 ) قال النبي :(@)(@@) | 30 ( كتب لك أجران : أجر السر ، وأجر العلانية ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15647 ) قال النبي :(@)(@@) | 30 ( كتبت له أربع حجج : حجة للذي كتبها ، وحجة للذي أنفذها ، وحجة للذي أخذها ، وحجة للذي أمر بها ) )(@)(@@) ( هق ) وضعفه عن أنس رضي الله عنه في رجل أوصى الحجة .(@)(@@)(@@)(@@) ||| ( الكاف مع الثاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15648 ) قال النبي :(@)(@@) | 30 ( كثرة الحج والعمرة تمنع العيلة ) )(@)(@@) المحاملي في أماليه عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15649 ) قال النبي :(@)(@@) | 30 ( كثرة العرب وإيمانهم قرة عين لي ، ألا فمن أقر بعيني أقر الله بعينه ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الكاف مع 
ms1725	 الخاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15650 ) قال النبي :(@)(@@) | 30 ( كخ كخ إرم بها ، أما شعرت أنا لا نأكل الصدقة ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P415(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15651 ) قال النبي :(@)(@@) | 30 ( كخ كخ إرمها أما شعرت أنا لا نأكل الصدقة ) )(@)(@@) ( خ م ) عن أبي هريرة رضي الله عنه قال : أخذ الحسن بن علي رضي الله عنهما تمرة من تمر الصدقة فجعلها في فيه فقال النبي فذكره .(@)(@@)(@@)(@@) ||| ( الكاف مع الدال(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15652 ) قال النبي & : ' كدتم أن تفعلوا فعل فارس والروم ، يقومون على ملوكهم وهم قعود فلا تفعلوا ، ائتموا بإمامكم ، إذا صلى قائما فصلوا قياما ، وإن صلى قاعدا فصلوا قعودا ' ( حب ) عن جابر رضي الله عنه . $ 3 ( الكاف م ع الذال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15653 ) قال النبي :(@)(@@) | 30 ( كذب النسابون ، قال الله تعالى : وقرونا بين ذالك كثيرا ) )(@)(@@) ابن سعد ، ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15654 ) قال النبي :(@)(@@) | 30 ( كذبت لا يدخلها ، إنه شهد بدرا والحديبية ) )(@)(@@) ( م ت ن ) و البغوي ( طب ) عن جابر أن عبدا لحاطب بن أبي بلتعة جاء يشكو حاطبا فقال : يا نبي الله ليدخلن حاطب النار ؟ قال : فذكره .(@)(@@) PageV05P416(@)(@@)(@@)(@@) $ ( 15655 ) قال النبي :(@)(@@) | 30 ( كذبتم لن يقبل قولكم ، أما آنفا فتثنون عليه من الخير ما أثنيتم ، وأما إذ آمن فكذبتموه وقلتم فيه ما قلتم فلن يقبل قولكم ) )(@)(@@) ( ك ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15656 ) قال النبي :(@)(@@) | 30 ( كذبت يهود ، لو أراد الله أن يخلقه ما استطعت أن تصرفه ) )(@)(@@) ( حم د ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15657 ) قال النبي :(@)(@@) | 30 ( كذبوا ، الآن جاء القتال ، الآن جاء القتال ، لا يزال الله يزيغ قلوب أقوام تقاتلونهم ، ويرزقكم الله منهم حتى يأتي أمر الله وهم على ذالك ، وعقر دار الإسلام بالشام ) )(@)(@@) ابن سعد عن سلمة بن نفيل الحضرمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15658 ) قال النبي :(@)(@@) | 30 ( كذب من قال ذاك ، لكم هجرتان : هاجرتم إلى النجاشي ، وهاجرتم إلي ) )(@)(@@) ( طب ) عن 
ms1726	 أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) ||| ( الكاف مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15659 ) قال النبي :(@)(@@) | 30 ( كرامة الكتاب ختمه ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15660 ) قال النبي :(@)(@@) | 30 ( كرم المرء دينه ، ومروءته عقله ، وحسبه خلقه ) )(@)(@@) ( حم ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P417(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15661 ) قال النبي :(@)(@@) | 30 ( كرم الرجل تقواه ، ومروءته عقله ، وحسبه خلقه ) )(@)(@@) العسكري عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15662 ) قال النبي :(@)(@@) | 30 ( كره لكم عقوق الأمهات ) )(@)(@@) ( خ ) في التاريخ عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15663 ) قال النبي :(@)(@@) | 30 ( كرم الدنيا : الغنى ، وكرم الآخرة : التقوى ، وخلقتم من ذكر وأنثى ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الكاف مع السين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15664 ) قال النبي :(@)(@@) | 30 ( كسب الإماء حرام ) )(@)(@@) الضياء ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15665 ) قال النبي :(@)(@@) | 30 ( كسر عظم الميت ككسر عظم الحي في الإثم ) )(@)(@@) ( ه ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15666 ) قال النبي :(@)(@@) | 30 ( كسر عظم الميت ككسره حيا ) )(@)(@@) ( حم د ه ) عن عائشة رضي الله عنها .(@)(@@) PageV05P418(@)(@@)(@@)(@@) ||| ( الكاف مع العين(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15667 ) قال النبي :(@)(@@) | 30 ( كعكر الزيت ، فإذا قربه إلى وجهه سقطت فروة وجهه فيه ) )(@)(@@) ( حم ) و عبد بن حميد ( ت ع حب ك هق ) في البعث ( ض ) عن أبي سعيد رضي الله عنه في قوله : كالمهل قال : فذكره .(@)(@@)(@@)(@@) ||| ( الكاف مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15668 ) قال النبي :(@)(@@) | 30 ( كفى إثما أن تحبس عمن تملك قوته ) )(@)(@@) ( م ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15669 ) قال النبي :(@)(@@) | 30 ( كفى بالدهر واعظا ، وبالموت مفرقا ) )(@)(@@) ابن السني في عمل