ms3521	 أحجار .(@)(@@) % ( الشافعي ق في المعرفة عن أبي هريرة ) .(@)(@@) 26467 - لا يبل أحدكم مستقبل القبلة .(@)(@@) % ( حم والطحاوي حب طب عن عبد الله بن الحارث الزبيدي ) .(@)(@@) 26468 - لا يتغوط أحدكم لبوله ولا لغيره مستقبل القبلة ولا مستدبرها شرقوا أو غربوا .(@)(@@) % ( الخطيب عن عبد الله بن الحارث الزبيدي ) .(@)(@@) 26469 - لا تستقبل القبلة ولا تستدبرها إذا استنجيت قال : كيف أصنع ؟ قال : اعترض بحجرين وضم الثالث .(@)(@@) % ( ع عن الحضرمي وضعف ) .(@)(@@) 26470 - لا تستقبلوا القبلة ولا تستدبروها لغائط أو بول ولكن شرقوا أو غربوا .(@)(@@) % ( ن طب عن أبي أيوب ) .(@)(@@) PageV09P158(@)(@@) 26471 - لا تستقبلوا القبلة بفروجكم ولا تستدبروها .(@)(@@) % ( سمويه طب عن أبي أيوب ) .(@)(@@) 26472 - لا تستقبلوا القبلة بغائط ولا بول .(@)(@@) % ( ع عن أسامة بن زيد ) .(@)(@@) 26473 - من لم يستقبل القبلة ولم يستدبرها في الغائط كتب له حسنة ومحي عنه سيئة .(@)(@@) % ( طس عن أبي هريرة وحسن ) .(@)(@@) 26474 - من جلس يبول قبالة القبلة فذكر فتحرف عنها إجلالا لها لم يقم من مجلسه حتى يغفر له .(@)(@@) % ( الطبري في تهذيبه عن الحسن مرسلا وفيه كذاب ) .(@)(@@) 26475 - لا يبولن أحدكم في مستحمه ثم يغتسل أو يتوضأ فيه فإن عامة الوسواس منه .(@)(@@) % ( عبد الرزاق حم د ( أخرجه أبو داود كتاب الطهارة باب في البول في المستحم رقم ( 27 ) ص ) ت ن ه حب ك عق عن عبد الله بن مغفل ) .(@)(@@) 26476 - لا يبولن أحدكم في الماء الدائم الذي لا يجري ثم يتوضأ منه .(@)(@@) % ( عبد الرزاق عن أبي هريرة ) .(@)(@@) 26477 - لا يبولن أحدكم في الماء الدائم أو يشرب .(@)(@@) % ( الطحاوي حب عن أبي هريرة ) .(@)(@@) 26478 - لا تبولوا في الماء الناقع .(@)(@@) % ( أبو نعيم عن ابن عمر ) .(@)(@@) 26479 - من تغوط على ضفة نهر يتوضأ منه ويشرب فعليه لعنة الله والملائكة والناس أجمعين .(@)(@@) % ( الخطيب عن أبي هريرة ) .(@)(@@) | 1 ( { البول في الجحر } ) 1(@)(@@) 26480 - نهى أن يبال في الجحر .(@)(@@) % ( د ، ك عن عبد الله ابن سرجس ) ( أخرجه أبو داود كتاب الطهارة باب النهي عن البول في الجحر رقم ( 29 ) ص ) .(@)(@@) 26481 - لا يبولن أحدكم في جحر .(@)(@@) % ( ه ك عن عبد 
ms3522	 الله بن سرجس ) .(@)(@@) | 1 ( { الإكمال } من البول في الجحر ) 1(@)(@@) 26482 - لا يبولن أحدكم في الجحر ، وإن نمتم فأطفئوا السراج فإن الفأرة تأخذ الفتيلة فتحرق أهل البيت ، وأوكوا الأسقية وخمروا الشراب ، وغلقوا الأبواب بالليل .(@)(@@) % ( حم ، ع ، وابن الجارود ، ك ، ص عن عبد الرحمن بن سرجس ) .(@)(@@) | 1 ( { التخلي على القبر من الإكمال } ) 1(@)(@@) 26483 - إياكم والبول على المقابر فإنه يورث البرص .(@)(@@) % ( الديلمي عن أنس ) .(@)(@@) 26484 - من جلس على قبر يبول عليه أو يتغوط فكأنما جلس على جمرة نار .(@)(@@) % ( الروياني عن أبي أمامة وضعف ؛ ابن منيع عن أبي هريرة وضعف ) .(@)(@@) PageV09P159(@)(@@) | 1 ( { التخلي في الطريق والظل } ) 1(@)(@@) 26485 - اتقوا اللاعنين الذي يتخلى في طريق الناس أو في ظلهم .(@)(@@) % ( حم م د عن أبي هريرة ) ( أخرجه مسلم كتاب الطهارة باب النهي عن التخلي في الطرق والظلال رقم ( 269 ) ص ) .(@)(@@) 26486 - من آذى المسلمين في طريقهم وجبت عليه اللعنة .(@)(@@) % ( طب عن حذيفة بن أسيد ) .(@)(@@) 26487 - اتقوا الملاعن الثلاث : البزار في الموارد ، وقارعة الطريق والظل .(@)(@@) % ( طب عن معاذ ) .(@)(@@) 26488 - اتقوا الملاعن الثلاث : أن يقعد أحدكم في ظل يستظل فيه ، أو في طريق ، أو في نقع ماء .(@)(@@) % ( حم عن ابن عباس ) .(@)(@@) 26489 - أبعدوا الآثار إذا ذهبتم للغائط وأعدوا النبل ، واتقوا الملاعن لا يتغوط أحدكم تحت شجرة ينزل تحتها أحد ، ولا عند ماء يشرب منه فيدعون الله عليكم .(@)(@@) % ( عب عن الشعبي مرسلا ) .(@)(@@) | 1 ( { الإكمال } من التخلي في الطريق والظل ) 1(@)(@@) 26490 - اتقوا اللعانين الذي يتخلى في طريق الناس وأفنيتهم .(@)(@@) % ( حب عن أبي هريرة ) .(@)(@@) 26491 - من سل سخيمته ( سخيمته : يعنى الغائط والنجو النهاية [ 2 / 351 ] ب ) على طريق عامر من طرق المسلمين فعليه لعنة الله وملائكته والناس أجمعين .(@)(@@) % ( طس ك عن أبي هريرة ) .(@)(@@) | 1 ( { بول الصبي الذي لم يطعم الطعام } ) 1(@)(@@) 26492 - يغسل من بول الأنثى وينضح من بول الذكر .(@)(@@) % ( حم د ( أخرجه أبو داود كتاب الطهارة باب بول الصبي يصيب الثوب رقم ( 375 و 376 ) ص ) ه ك عن أن الفضل ) .(@)(@@) 26493 - بول الغلام ينضح ، وبول الجارية يغسل 
ms3523	 .(@)(@@) % ( حم ه عن أم كرز ) .(@)(@@) 26494 - إذا كان الغلام لم يطعم الطعام صب على بوله ، وإذا كانت الجارية غسل .(@)(@@) % ( طس عن أم سلمة ) .(@)(@@) 26495 - يغسل من بول الجارية ، ويرش من بول الغلام .(@)(@@) % ( د ن ه عن أبي السمح د ه عن علي ) ( أخرجه أبو داود كتاب الطهارة باب بول الصبي يصيب الثوب رقم ( 375 و 376 ) ص ) .(@)(@@) 26496 - ينضح بول الغلام ، ويغسل بول الجارية .(@)(@@) % ( ت ك عن علي ) .(@)(@@) | 1 ( { الإكمال } من بول الصبي الذي لم يطعم الطعام ) 1(@)(@@) 26497 - دعيه فإنه لم يطعم الطعام ولا تضربونه .(@)(@@) % ( ابن النجار عن عائشة ) .(@)(@@) PageV09P160(@)(@@) 26498 - يصب على بول الغلام ، ويغسل بول الجارية .(@)(@@) % ( طب عن أنس ع عن أم سلمة ) .(@)(@@) 26499 - يغسل بول الجارية وينضح بول الصبي .(@)(@@) % ( عبد الرزاق عن قابوس ابن المخارق ) .(@)(@@) 26500 - أن يصب عليه من الغلام ، ويغسل من الجارية .(@)(@@) % ( ع طب عن زينب بنت جحش ) .(@)(@@) 26501 - إنما يغسل من بول الجارية ، وينضح من بول الغلام .(@)(@@) % ( حم ، د ه ، طب ، ك ، ق عن أم الفضل لبابة بنت الحارث ) . مر برقم [ 26495 ] .(@)(@@) 26502 - إنما يكفيك أن تأخذ كفا من ماء فتنضح به من ثوبك حيث ترى أنه أصابه .(@)(@@) % ( حم والدارمي ع طب وابن خزيمة عب ص عن سهل ابن حنيف ) .(@)(@@) | 1 ( { بول ما يؤكل لحمه من الإكمال } ) 1(@)(@@) 26503 - لا بأس ببول ما أكل لحمه .(@)(@@) % ( قط وضعفه عن البراء ) .(@)(@@) 26504 - لا بأس ببول الحمار ، وكل ما أكل لحمه .(@)(@@) % ( الخطيب عن علي ) .(@)(@@) 26505 - ما أكل لحمه فلا بأس ببوله .(@)(@@) % ( ق وضعفه عن البراء قط ق وضعفاه عن جابر ) .(@)(@@) | 1 ( الفصل الثالث { في ازالة النجاسات } ) 1(@)(@@) 26506 - إذا وطئ أحدكم بنعله الأذى فإن التراب له طهور .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب في الأذى يصيب النعل رقم ( 385 و 386 ) ص ) ك عن أبي هريرة ) .(@)(@@) 26507 - إذا وطيء الأذى بخفيه فطهورهما التراب .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب في الأذى يصيب النعل رقم ( 385 و 386 ) ص ) عن أبي هريرة وعائشة ) .(@)(@@) 26508 - إذا وقعت 
ms3524	 الفأرة في السمن فإن كان جامدا فألقوها وما حولها وإن كان مائعا فلا تقربوه .(@)(@@) % ( د عن أبي هريرة وعن ميمونة ) ( أخرجه أبو داود كتاب الأطعمة باب في الفأرة تقع في السمن رقم ( 2824 ) ص ) .(@)(@@) 26509 - عذاب القبر من أثر البول ، فمن أصابه بول فليغسله فإن لم يجد ماء فليمسحه بتراب طيب .(@)(@@) % ( طب عن ميمونة بنت سعد ) .(@)(@@) 26510 - الدم مقدار الدرهم يغسل وتعاد منه الصلاة .(@)(@@) % ( خط عن أبي هريرة ) .(@)(@@) 26511 - تعاد الصلاة من مقدار الدرهم من الدم .(@)(@@) % ( عد ، هق عن أبي هريرة ) .(@)(@@) | 1 ( { تطهير الأواني } ) 1(@)(@@) 26512 - طهور إناء أحدكم إذا ولغ فيه الكلب أن يغسل سبع مرات أولاهن بالتراب .(@)(@@) % ( د م عن أبي هريرة ) ( أخرجه أبو داود كتاب الطهارة باب الوضوء بسؤر الكلب رقم ( 71 ) ص ) .(@)(@@) PageV09P161(@)(@@) 26513 - طهور إناء أحدكم إذا ولغ فيه الكلب أن يغسل سبعا الأولى بالتراب ، والهر مثل ذلك .(@)(@@) % ( ك عن أبي هريرة ) .(@)(@@) 26514 - إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات .(@)(@@) % ( ن ه عن أبي هريرة ؛ ه عن ابن عمر ؛ البزار عن ابن عباس ) .(@)(@@) 26515 - إذا ولغ الكلب في إناء أحدكم فليرقه ثم ليغسله سبع مرار .(@)(@@) % ( م ن عن أبي هريرة ) ( أخرجه مسلم كتاب الطهارة باب حكم ولوغ الكلب رقم ( 279 و 280 ) ص ) .(@)(@@) 26516 - إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات أولاهن بالتراب .(@)(@@) % ( حم ن عن أبي هريرة ) .(@)(@@) 26517 - إذا ولغ الكلب في الإناء فاغسلوه سبع مرا السابعة بالتراب .(@)(@@) % ( د عن أبي هريرة ) .(@)(@@) 26518 - إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات إحداهن بالبطحاء .(@)(@@) % ( قط عن علي ) .(@)(@@) 26519 - إذا ولغ الكلب في الإناء فاغسلوه سبع مرات ، وعفروه الثامنة بالتراب .(@)(@@) % ( حم م ( أخرجه مسلم كتاب الطهارة باب حكم ولوغ الكلب رقم ( 279 و 280 ) ص ) د ن ه عن عبد الله بن مغفل ) .(@)(@@) 26520 - إذا شرب الكلب في إناء أحدكم فليغسله سبع مرات .(@)(@@) % ( مالك ق ن ه عن أبي هريرة ) ( أخرجه مسلم كتاب الطهارة باب حكم ولوغ الكلب رقم ( 90 ) ص ) .(@)(@@) 26521 
ms3525	 - يغسل الإناء إذا ولغ فيه الكلب سبع مرات أخراهن أو أولاهن بالتراب ، وإذا ولغت فيه الهرة غسل مرة .(@)(@@) % ( ت عن أبي هريرة ) .(@)(@@) 26522 - لا تطبخوا في قدور المشركين ، فإذا لم تجدوا غيرها فارحضوها ( فأرحضوها : أي اغسلوها . والرحض : الغسل . النهاية [ 2 / 208 ] ب ) رحضا حسنا ثم اطبخوا وكلوا .(@)(@@) % ( ه عن أبي ثعلبة الخشني ) .(@)(@@) 26523 - لا يختلجن في صدرك شيء ضارعت ( ضارعت : المضارعة : المشابهة والمقاربة ، وذلك أنه سأله عن طعام النصاري فكأنه أراد : لا يتحركن في قلبك شك أن ما شابهت فيه النصارى حرام أو خبيث أو مكروه النهاية [ 3 / 85 ] ب ) فيه النصرانية .(@)(@@) % ( حم د ت ه ( أخرجه أبو داود كتاب الأطعمة باب كراهية التقذر للطعام رقم ( 3766 ) . راجع عون المعبود ( 10 / 258 ) . والإمام أحمد في مسنده ( 5 / 226 ) . والترمذي كتاب السير باب ما جاء في أحكام المشركين رقم ( 1565 ) وقال : حسن . راجع ذخائر المواريث ( 3 / 124 ) .(@)(@@) هلب : بضم الهاء وسكون اللام : الطائي واسمه يزيد بن جرول .(@)(@@) خلاصة الكمال ( 3 / 125 ) ص ) عن هلب ) .(@)(@@) 26524 - ما كان من فخار فاغلوا فيها الماء ثم أغسلوها ، وما كان من النحاس فاغسلوه ، فالماء طهور لكل شيء .(@)(@@) % ( ك عن عبد الله بن الحارث ) .(@)(@@) 26525 - الطرق تطهر بعضها بعضا .(@)(@@) % ( عد هق عن أبي هريرة ) .(@)(@@) | 1 ( { الإكمال } من تطهير الأواني ) 1(@)(@@) 26526 - إذا ولغ الكلب في الإناء غسل سبع مرات .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26527 - إذا ولغ الكلب في الإناء غسل سبع مرات أولاهن بالتراب ، وإذا ولغ الهرة غسل مرة .(@)(@@) % ( كر عن أبي هريرة ) .(@)(@@) PageV09P162(@)(@@) 26528 - إذا اضطررتم إليها فاغسلوها بالماء ، واطبخوا فيها يعني آنية المجوس .(@)(@@) % ( حم عن ابن عمر ) .(@)(@@) 26529 - أنقوها غسلا واطبخوا فيها .(@)(@@) % ( ت عن أبي ثعلبة الخشني أن رسول الله صلى الله عليه وسلم سئل عن قدر المجوس : فذكره ) ( أخرجه الترمذي كتاب السير باب ما جاء في الانتفاع بآنية المشركين رقم ( 1560 ) قال حسن : صحيح . ص ) .(@)(@@) 26530 - إن وجدتم غير آنيتهم فلا تأكلوا فيها ، فإن لم تجدوا فاغسلوها فكلوا فيها .(@)(@@) % ( ت : حسن صحيح عن أبي 
ms3526	 ثعلبة الخشني أنه قال : يا رسول الله إنا بأرض قوم أهل كتاب أنأكل في آنيتهم ؟ قال : فذكره ) ( أخرجه الترمذي كتاب السير باب ما جاء في الانتفاع بآنية المشركين رقم ( 1560 ) قال حسن : صحيح . ص ) .(@)(@@) 26531 - دعوها ما وجدتم منها بدا ، فإن لم تجدوا منها بدا فارحضوها بالماء اطبخوا فيها وكلوا واشربوا يعني آنية أهل الكتاب .(@)(@@) % ( الشافعي في سنن حرملة ط ك ق عن أبي ثعلبة الخشني ) .(@)(@@) 26532 - لا يختلجن في نفسك شيء ضارعت فيه النصرانية .(@)(@@) % ( حم عن أبي قبيصة ) مر برقم [ 26523 ] .(@)(@@) 26533 - لا تدع شيئا ضارعت فيه النصرانية .(@)(@@) % ( طب عن عدي بن حاتم ) .(@)(@@) | 1 ( { المتفرقات من الإكمال } ) 1(@)(@@) 26534 - استصبحوا به ولا تأكلوه .(@)(@@) % ( قط ق عن أبي سعيد سئل رسول الله صلى الله عليه وسلم عن الفأرة تقع في السمن والزيت قال : فذكره ) .(@)(@@) 26535 - إن كان جامدا فألقوها وما حولها وكلوا ما يبقى ، وإن كان مائعا استصبح به فلا تقربوه .(@)(@@) % ( عبد الرزاق ، طب عن ميمونة أن رسول الله صلى الله عليه وسلم سئل عن الفأرة تقع في السمن قال : فذكره ؛ عبد الرزاق حم عن أبي هريرة مثله ، عبد الرزاق عن أبي سعيد ) .(@)(@@) 26536 - إن كان جامدا خذ ما حولها قدر الكف وكل بقيته .(@)(@@) % ( عبد الرزاق عن عطاء بن يسار مرسلا ) .(@)(@@) 26537 - إن كان جامدا خذ ما حولها قدر الكل ، وإذا وقعت في الزيت استصبح ( استصبح : وفي الحديث ( فأصبحى سراجك ) أي أصلحيها ومنه حديث جابر في شحوم الميتة ( ويستصبح بها الناس ) أي يشعلون بها سرجهم .(@)(@@) النهاية [ 3 / 7 ] ب ) به .(@)(@@) % ( عب عن ابن المسيب مرسلا ) .(@)(@@) 26538 - إن التراب لهما طهور .(@)(@@) % ( البغوي وضعفه عن عائشة سألت النبي صلى الله عليه وسلم عن صلاة الرجل في النعلين وهو يطأ بهما في الآثار قال : فذكره ) .(@)(@@) 26539 - التراب له طهور .(@)(@@) % ( عبد الرزاق عن عائشة أن رسول الله صلى الله عليه وسلم سئل عن الرجل يطأ بنعليه الأذى قال : فذكره ) .(@)(@@) 26540 - يطهره ما بعده .(@)(@@) % ( حم ت ( في الحديث تصحيف في متنه استدركته من الترمذي كتاب 
ms3527	 الطهارة باب ما جاء في الوضوء من الموطاء رقم ( 143 ) والحديث صحيح . ص ) عن أم سلمة أن امرأة قالت : يا رسول الله إني أطيل ذبلي وأمشي في المكان القذر قال : فذكره ) .(@)(@@) PageV09P163(@)(@@) 26541 - يا سلمان كل طعام وشراب وقعت فيه دابة ليس لها دم فماتت فيه فهو الحلال أكله وشربه ووضوءه .(@)(@@) % ( قط وضعفه والخطيب في المتفق والمفترق عن سلمان ) .(@)(@@) 26542 - تحته ( تحته : معنى تحته : تقشره وتحكه وتنحته . ومعنى تقرصه : الدلك بأطراف الأصابع والأظفار مع صب الماء عليه حتى يذهب أثره . ومعنى تنضحه : تغسله .(@)(@@) تعليق صحيح مسلم [ 1 / 240 ] ب ) ثم تقرصه بالماء وتنضحه ثم تصلي فيه .(@)(@@) % ( خ ( أخرجه البخاري كتاب الوضوء باب غسل الدم ( 1 / 66 ) ص ) م د عن أسماء أنها قالت : يا رسول الله أرأيت إحدانا تحيض في الثوب كيف تصنع ؟ قال : فذكره ) .(@)(@@) 26543 - حكيه بضلع ( بضلع : أي بعود ، والأصل فيه ضلع الحيوان فسمي به العود الذي يشبهه . وقد تسكن اللام تخفيفا . النهاية [ 3 / 96 ] ب ) واغسليه بماء وسدر .(@)(@@) % ( عبد الرزاق حم د ( أخرجه أبو داود كتاب الطهارة باب المرأة تغسل ثوبها رقم ( 363 ) ص ) ن ه حب عن أم قيس بنت محصن أنها سألت النبي صلى الله عليه وسلم عن دم الحيض تكون في الثوب قال : فذكره ) .(@)(@@) | 1 ( الباب الرابع { في موجبات الغسل وآدابه } ) 1(@)(@@)(@)(@@) | 1 ( { وآداب دخول الحمام } وفيه فصلان ) 1(@)(@@)(@)(@@) | 1 ( الفصل الأول { في موجبات الغسل } ) 1(@)(@@) 26544 - إذا التقى الختانان فقد وجب الغسل .(@)(@@) % ( ه عن عائشة عن ابن عمر ) .(@)(@@) 26545 - إنما الماء من الماء .(@)(@@) % ( م د عن أبي سعيد ؛ حم ن ه عن أبي أيوب ) ( أخرجه مسلم كتاب الحيض باب إنما الماء من الماء رقم ( 343 ) راجع شرح صحيح مسلم للنووي ( 1 / 646 ) ص ) .(@)(@@) 26546 - لو اغتسلتم من المذي لكان أشد عليكم من الحيض .(@)(@@) % ( العسكري ص في الصحابة عن حسان بن عبد الرحمن الضبعي مرسلا ) .(@)(@@) 26547 - إذا استيقظ أحدكم من نومه فرأى بللا ولم ير أنه احتلم اغتسل ، وإذا رأى أنه قد احتلم ولم ير 
ms3528	 بللا فلا غسل عليه .(@)(@@) % ( عب ، هب عن عائشة ) .(@)(@@) 26548 - إذا التقى الختانان وغابت الحشفة ، فقد وجب الغسل أنزل أو لم ينزل .(@)(@@) % ( طس عن ابن عمر ) .(@)(@@) 26549 - إذا جامع الرجل امرأته ثم أكسل ( أكسل : أكسل الرجل إذا جامع ثم أدركه فتور فلم ينزل ، ومعناه صار ذا كسل ، ومعنى الحديث ليس في الاكسال غسل وإنما فيه الوضوء وهذا على مذهب من رأى أن الغسل لا يجب إلا من الإنزال وهو منسوخ . انتهى . النهاية [ 4 / 175 ] ب ) ، فليغسل ما أصاب المرأة منه ثم ليتوضأ .(@)(@@) % ( حم ق عن أبي بن كعب ) .(@)(@@) 26550 - إذا جلس بين شعبها الأربع ثم جهدها ، فقد وجب عليه الغسل وإن لم ينزل .(@)(@@) % ( حم ق د ه عن أبي هريرة ) ( أخرجه البخاري كتاب الغسل باب غسل ما يصيب من فرج المرأة ( 1 / 80 ) ص ) .(@)(@@) 26551 - إذا جلس بين شعبها الأربع ومس الختان الختان فقد وجب الغسل .(@)(@@) % ( م فر عن عائشة ) .(@)(@@) 26552 - إذا رأت فأنزلت فعليها الغسل .(@)(@@) % ( ه عن أنس ) .(@)(@@) 26553 - إذا جاوز الختان الختان فقد وجب الغسل .(@)(@@) % ( م ( أخرجه مسلم في صحيحه كتاب الحيض باب نسخ الماء من الماء ووجوب الغسل بالتقاء الختانين رقم ( 348 و 349 ) ص ) ت عن عائشة ؛ طب عن أبي أمامة وعن رافع بن خديج ؛ الشيرازي في الألقاب عن معاذ ) .(@)(@@) PageV09P164(@)(@@) 26554 - إذا وجدت المرأة في المنام ما يجد الرجل فلتغتسل .(@)(@@) % ( سمويه عن أنس ) .(@)(@@) 26555 - ليس عليها غسل حتى تنزل كما أنه ليس على الرجل غسل حتى ينزل .(@)(@@) % ( ه عن خولة بنت حكيم ) .(@)(@@) 26556 - من رأت ذلك منكن فأنزلت فلتغتسل .(@)(@@) % ( حم م ( أخرجه مسلم كتاب الحيض باب وجوب الغسل على المرأة بخروج المني منها رقم ( 311 و 312 ) ص ) ن ه عن أنس ) .(@)(@@) 26557 - إن الملائكة لا تحضر الجنب والمتضمخ بالخلوق حتى يغتسلا .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26558 - إن المؤمن لا ينجس .(@)(@@) % ( ق ( أخرجه البخاري في صحيحه كتاب الغسل باب عرق الجنب وأن المسلم لا ينجس ( 1 / 79 ) ص ) 4 عن أبي هريرة ؛ حم م د ن ه 
ms3529	 عن حذيفة عن ابن مسعود ؛ طب عن أبي موسى ) .(@)(@@) 26559 - إذا رأيت المذي فاغتسل ذكرك وتوضأ وضوءك للصلاة وإذا فضخت ( فضخت : في حديث علي ( قال له : إذا رأيت فضخ الماء فاغتسل ) أي دفقه ، يريد المني . النهاية [ 3 / 453 ] ب ) الماء فاغتسل .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب في المذي رقم ( 206 ) ص ) ن حب عن علي ) .(@)(@@) | 1 ( { الإكمال } من موجبات الغسل ) 1(@)(@@) 26560 - إذا جاوز الختان الختان فقد وجب الغسل ، وأما الصلاة في ثوب واحد فتوشح به ، وأما ما يحل من الحائض فإنه يحل منها فوق الإزار ، والاستعفاف عن ذلك أفضل .(@)(@@) % ( طب عن معاذ ) .(@)(@@) 26561 - إذا جاوز الختان الختان أنزل أو لم ينزل وجب الغسل .(@)(@@) % ( قط في الأفراد عن أبي هريرة وابن عباس معا ) .(@)(@@) 26562 - إذا جلس بين فروجها الأربع ، ثم اجتهد فقد وجب الغسل أنزل أو لم ينزل .(@)(@@) % ( ص ش عن أبي هريرة ) .(@)(@@) 26563 - إذا مس الختان الختان فقد وجب الغسل .(@)(@@) % ( عق عن ابن عمر ) .(@)(@@) 26564 - إذا التقى الختانان وتوارت الحشفة فقد وجب الغسل .(@)(@@) % ( حم ه عن عمرو بن شعيب عن أبيه عن جده ) .(@)(@@) 26565 - الماء من الماء .(@)(@@) % ( عبد الرزاق عن أبي أيوب البغوي عن عبان الأنصاري ) .(@)(@@) 26566 - الغسل من أربع : من الجنابة ، والحجامة ، وغسل الميت وغسل الجمعة .(@)(@@) % ( ش عن عائشة ) .(@)(@@) 26567 - يغسل من أربع : من الجنابة ، ويوم الجمعة ، ومن غسل الميت ، والحجامة .(@)(@@) % ( ش حم وابن خزيمة عن ابن الزبير عن عائشة ) .(@)(@@) 26568 - إذا أعجل أحدكم أو أقحط ( أقحط : في الحديث ( من جامع فأقحط فلا غسل عليه ) أي فتر ولم ينزل وهو من أقحط الناس : إذا لم يمطروا ، وهذا كان في أول الإسلام ثم نسخ ، وأوجب الغسل بالإيلاج . النهاية [ 4 / 17 ] ب ) فلا يغتسل .(@)(@@) % ( عب عن أبي سعيد ) .(@)(@@) PageV09P165(@)(@@) 26569 - ليس عليها غسل حتى تنزل كما أنه ليس على الرجل غسل حتى ينزل .(@)(@@) % ( ه عن خولة بنت حكيم أنها سألت رسول الله صلى الله عليه وسلم عن المرأة ترى في منامها ما يرى الرجل قال : فذكره ) .(@)(@@) 26570 - إذا أقحط 
ms3530	 أحدكم أو أكسل فإنما يكفي منه الوضوء .(@)(@@) % ( عب عن رجل من الصحابة ليس في الإكسال إلا الطهور . ش والديلمي عن أبي وهو صحيح ) .(@)(@@) 26571 - إذا اغتسل أحدكم ثم ظهر من ذكره شيء فليتوضأ .(@)(@@) % ( طب عن الحكم بن عمير الثمالي ) .(@)(@@) | 1 ( { اغتسال المرأة من الإكمال } ) 1(@)(@@) 26572 - إذا أنزلت المرأة فلتغتسل .(@)(@@) % ( ن عن أنس أن أم سليم سألت رسول الله صلى الله عليه وسلم عن المرأة تحتلم قال : فذكره ) ( أخرجه النسائي كتاب الطهارة باب غسل المرأة ترى في منامها ما يرى الرجل رقم ( 195 ) ص ) .(@)(@@) 26573 - إذا رأت الماء فلتغتسل .(@)(@@) % ( ن عن خولة بنت الحكيم قالت : سألت رسول الله صلى الله عليه وسلم عن المرأة تحتلم في منامها ، قالت : فذكره ه عن زينب بنت أم سلمة ؛ طس عن سهلة بنت سهل وعن أبي هريرة ) .(@)(@@) 26574 - إذا رأت الماء الأصفر فلتغتسل .(@)(@@) % ( حم طب عن أم سلمة قالت أم سليم : يا رسول الله المرأة تحتلم ، قال : فذكره ) .(@)(@@) 26575 - إذا كان منها ما يكون من الرجل فلتغتسل .(@)(@@) % ( م عن أنس قال سألت امرأة رسول الله صلى الله عليه وسلم عن المرأة ترى في منامها ما يرى الرجل في منامه قال : فذكره ) .(@)(@@) 26576 - إذا نزل الماء الأصفر فلتغتسل .(@)(@@) % ( طب عن أم سلمة ) .(@)(@@) 26577 - إذا وجدت بللا فاغتسلي يا بسرة .(@)(@@) % ( ش عن عمرو بن شعيب عن أبيه عن جده قال : جاءت امرأة يقال بسرة(@)(@@) لها فقالت : يا رسول الله إحدانا ترى أنه يجامعها زوجها في المنام قال : فذكره ) .(@)(@@) 26578 - إذا أنزلت كما ينزل الرجل فعليها الغسل ، وإن لم تنزل فلا شيء عليها .(@)(@@) % ( ق عن أنس ) .(@)(@@) 26579 - ليس عليها شيء كما أن الرجل إذا لم ينزل ليس عليه غسل حتى ينزل .(@)(@@) % ( طب عن خولة بنت حكيم ) .(@)(@@) 26580 - إذا اغتسلت المرأة من حيضها نقضت شعرها نقضا وغسلته بخطمي وأشنان ، وإذا اغتسلت من الجنابة صبت الماء على رأسها وعصرته .(@)(@@) % ( قط في الأفراد ، طب ق ص خط في التلخيص عن أنس ) .(@)(@@) PageV09P166(@)(@@) 26581 - لا يضر المرأة الحائض والجنب أن لا تنقض 
ms3531	 شعرها إذا أصاب الماء شؤون ( شؤون : هي عظامه وطرائقه ومواصل قبائله وهي أربعة بعضها فوق بعض النهاية [ 2 / 437 ] ب ) الرأس .(@)(@@) % ( ص عن جابر ) .(@)(@@) 26582 - لا يضر المرأة الحائض والجنب أن لا تنقض شعرها إذا أصاب الماء شرف الرأس .(@)(@@) % ( الخطابي ص عن جابر ) .(@)(@@) 26583 - لا إنما يكفيك أن تحثي على رأسك ثلاث حثيات ، ثم تفيضين عليك الماء فتطهرين .(@)(@@) % ( م ( أخرجه مسلم كتاب الحيض باب حكم ضفائر المغتسلة رقم ( 330 ) ص ) عن أم سلمة قالت : قلت يا رسول الله إني امرأة أشد ضفر رأسي فأنقضه لغسل الجنابة ؟ قال : فذكره ) .(@)(@@) 26584 - إنما يكفيك أن تحثي على رأسك ثلاث حثيات من ماء ثم تفيضي على سائر جسدك من الماء ، فإذا أنت قد طهرت .(@)(@@) % ( عبد الرزاق حم د ، ت : حسن صحيح ن عن أم سلمة ) .(@)(@@) | 1 ( { آداب الغسل } ) 1(@)(@@) 26585 - من ترك موضع شعرة من جنابة لم يغسلها فعل بها كذا وكذا من النار .(@)(@@) % ( حم د ( أخرجه أبو داود كتاب الطهارة باب في الغسل من الجنابة رقم ( 249 ) ص ) ه عن علي ) .(@)(@@) 26586 - لا يغتسل أحدكم في الماء الدائم وهو جنب .(@)(@@) % ( م ، ن ه عن أبي هريرة ) .(@)(@@) 26587 - أما الرجل فلينثر رأسه فليغسله حتى يبلغ أصول الشعر ، وأما المرأة فلا عليها أن لا تنقضه ، لتغرف على رأسها ثلاث غرفات بكفيها .(@)(@@) % ( د عن ثوبان ) ( أخرجه أبو داود كتاب الطهارة باب في المرأة هل تنفض شعرها عند الغسل رقم ( 255 ) ض ) .(@)(@@) 26588 - إنما يكفيك أن تحثي على رأسك ثلاق حثيات من ماء ثم تفيضي على سائر جسدك من الماء ، فإذا أنت قد طهرت .(@)(@@) % ( حم ، 4 عن أم سلمة ) ( أخرجه مسلم كتاب الحيض باب حكم ضفائر المغتسلة رقم ( 330 ) ض ) .(@)(@@) 26589 - أما أنا فأفيض على رأسي ثلاثا .(@)(@@) % ( حم م عن جابر ) ( أخرجه مسلم كتاب الحيض باب استحباب إفاضة الماء رقم ( 327 و 328 ) ص ) .(@)(@@) 26590 - أما أنا فآخذ بكفي ثلاثا فأصب على رأسي ثم أفيض على سائر جسدي .(@)(@@) % ( حم ق د ن ه عن جبير بن مطعم 
ms3532	 ) ( أخرجه مسلم كتاب الحيض باب استحباب إفاضة الماء رقم ( 327 و 328 ) ص ) .(@)(@@) 26591 - إن الله ينهاكم عن التعري فاستحيوا من ملائكة الله تعالى الذين لا يفارقونكم إلا عند ثلاث حالات : الغائط ، والجنابة ، والغسل ، فإذا اغتسل أحدكم بالعراء فليستتر بثوبه أو بجذمة ( بجذمة : وفي حديث الأذان ( فعلا جذم حائط فأذن ) الجذم : الأصل ، أراد بقية حائط أو قطعة من حائط . النهاية [ 1 / 252 ] ب ) حائط أو ببعيره .(@)(@@) % ( البزار عن ابن عباس ) .(@)(@@) 26592 - ستر بين أعين الجن وبين عورات بني آدم إذا وضع أحدكم ثوبه أن يقول : بسم الله .(@)(@@) % ( طس عن أنس ) .(@)(@@) 26593 - لا يغتسل أحدكم بأرض فلاة ، ولا فوق سطح لا يواريه ، فإن لم يكن يرى فإنه يرى .(@)(@@) % ( ه عن ابن مسعود ) .(@)(@@) PageV09P167(@)(@@) 26594 - وأي وضوء أفضل من الغسل .(@)(@@) % ( ك عن ابن عمر ) .(@)(@@) 26595 - إن تحت كل شعرة جنابة فاغسلوا الشعر وأنقوا البشرة .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب في الغسل من الجنابة رقم ( 248 ) وقال أبو داود : الحارث بن وجيه حديثه منكر وهو ضعيف . ص ) ت ه عن أبي هريرة ) .(@)(@@) 26596 - الغسل صاع ، والوضوء مد .(@)(@@) % ( طس عن ابن عمر ) ( أخرجه أبو داود كتاب الطهارة باب ما يجزيء من الماء في الوضوء رقم ( 92 و 93 ) ص ) .(@)(@@) | 1 ( { الإكمال } من آداب الغسل ) 1(@)(@@) 26597 - أما أنا فأتوضأ وضوئي للصلاة ، ثم آخذ ملء كفي ثلاث مرات فأصب على رأسي ثم أغتسل ، وفي لفظ : ثم أفيض بعد على سائر جسدي .(@)(@@) % ( طب عن جبير بن مطعم قال : ذكرنا عند رسول الله صلى الله عليه وسلم الغسل من الجنابة قال : فذكره ) .(@)(@@) 26598 - إن الله لا يستحيي من الحق أما أنا فإذا فعلت كذا وكذا فأغتسل أتوضأ وضوئي للصلاة أغسل فرجي ، ثم ذكر الغسل ، وأما الماء يكون بعد الماء فذلك المذي ، وكل فحل يمذي فأغسل من ذلك فرجي وأتوضأ ، وأما الصلاة في المسجد والصلاة في بيتي فقد ترى ما أقرب بيتي من المسجد فلأن أصلي في بيتي أحب إلي من أن أصلي في المسجد إلا أن 
ms3533	 تكون صلاة مكتوبة ، وأما مؤاكلة الحائض فأواكلها .(@)(@@) % ( حم وابن خزيمة ق ، ص عن حرام بن حكيم عن عمه عبد الله بن سعد الأنصاري ؛ وروى بعضه : د ، ت ، ه ) .(@)(@@) 26599 - من ترك موضع شعرة من جسده من جنابة لم يغسلها فعل بها كذا وكذا من النار .(@)(@@) % ( ش حم د ه وابن جرير عن علي ) مر برقم [ 26585 ] .(@)(@@) 26600 - تحت كل شعرة جنابة .(@)(@@) % ( ابن جرير عن طلحة بن نافع عن أبي أيوب الأنصاري مرفوعا ؛ ابن جرير عن أبي الدرداء وعن حذيفة موقوفا عليهما ) .(@)(@@) 26601 - تحت كل شعرة جنابة ، فبلوا الشعر وأنقوا البشر .(@)(@@) % ( عب عن الحسن ؛ مرسلا ابن جرير عن الحسن عن أبي هريرة موقوفا ) .(@)(@@) 26602 - يا عائشة إن على كل شعرة جنابة .(@)(@@) % ( حم عن عائشة ) .(@)(@@) 26603 - تبل أصول الشعر وتنقي البشر ، فإن مثل الذين لا يحسنون الغسل كمثل شجرة أصابها ماء فلا ورقها ينبت ، ولا أصلها يروى ، فاتقوا الله وأحسنوا الغسل فإنها من الأمانة التي حملتم ، والسرائر التي استودعتم .(@)(@@) % ( طب عن ميمونة بنت سعد ) .(@)(@@) 26604 - وأي وضوء أفضل من الغسل .(@)(@@) % ( ك عن ابن عمر أن النبي صلى الله عليه وسلم سئل عن الوضوء بعد الغسل قال : فذكره ) .(@)(@@) 26605 - إن الله حيي عليم ستير فإذا اغتسل أحدكم فليستتر ولو بجذم حائط .(@)(@@) % ( ابن عساكر عن بهز بن حكيم عن أبيه عن جده ) .(@)(@@) PageV09P168(@)(@@) 26606 - إن الله حيي يحب الحياء ، ستير يحب الستر ، فإذا اغتسل أحدكم فليتوار .(@)(@@) % ( عبد الرزاق عن عطاء مرسلا ) .(@)(@@) 26607 - يا أيها الناس إن ربكم حيي كريم فإذا اغتسل أحدكم فليستتر .(@)(@@) % ( طب عن يعلى بن منبه ) .(@)(@@) 26608 - لا تدخلوا الماء إلا بمئزر فإن للماء عينين .(@)(@@) % ( الديلمي عن جابر ) .(@)(@@) 26609 - إن موسى بن عمران كان إذا أراد أن يدخل الماء لم يلق ثوبه حتى يواري عورته في الماء .(@)(@@) % ( حم عن أنس ) .(@)(@@) 26610 - لا أراك تستحيي من ربك خذ إجارتك لا حاجة لنا بك .(@)(@@) % ( عبد الرزاق عن ابن جريج قال : بلغني أن النبي صلى الله عليه وسلم خرج فإذا هو بأجير له يغتسل في البر 
ms3534	 قال : فذكره ) .(@)(@@) 26611 - لا يغتسل الرجل من فضل امرأته ولا تغتسل بفضله ولا يبول في مغتسله ولا يتمشط كل يوم .(@)(@@) % ( حم عن رجل من الصحابة ) .(@)(@@) 26612 - يكفي من الجنابة ستة أمداد .(@)(@@) % ( البزار عن أبي هريرة وضعف ) .(@)(@@) 26613 - إذا اغتسل أحدكم فليغسل كل عضو منه ثلاث مرات .(@)(@@) % ( الديلمي عن أم هانئ ) .(@)(@@) 26614 - إن الملائكة لا تحضر جنازة الكافر بخير ، ولا جنبا حتى يغتسل أو يتوضأ وضوءه للصلاة ولا متضمخا بصفرة .(@)(@@) % ( عبد الرزاق طب عن عمار بن ياسر ) .(@)(@@) | 1 ( الفصل الثاني { في دخول الحمام } ) 1(@)(@@) 26615 - اتقوا بيتا يقال له الحمام فمن دخله فليستتر .(@)(@@) % ( طب ك هب عن ابن عباس ) .(@)(@@) 26616 - أف للحمام ، حجاب لا يستر ، وماء لا يطهر ، لا يحل لرجل أن يدخله إلا بمنديل ، مر المسلمين لا يفتنون نساءهم ، الرجال قوامون على النساء علموهم ومروهن بالتسبيح .(@)(@@) % ( هب عن عائشة ) .(@)(@@) 26617 - بئس البيت الحمام ترفع فيه الأصوات وتكشف فيه العورات .(@)(@@) % ( 4 عن ابن عباس ) .(@)(@@) 26618 - بئس البيت الحمام بيت لا يستر وماء لا يطهر .(@)(@@) % ( طب عن عائشة ) .(@)(@@) 26619 - أنشد الله رجال أمتي لا يدخلوا الحمام إلا بمئزر وأنشد الله نساء أمتي لا يدخلن الحمام .(@)(@@) % ( ابن عساكر عن أبي هريرة ) .(@)(@@) PageV09P169(@)(@@) 26620 - تفتح لكم أرض الأعاجم ، وستجدون فيها بيوتا يقال لها الحمامات فلا يدخلها الرجال إلا بإزار ، وامنعوا النساء أن يدخلنها إلا مريضة أو نفساء .(@)(@@) % ( ه عن ابن عمر ) ( أخرجه ابن ماجه كتاب الأدب باب دخول الحمام رقم ( 3748 ) ص ) .(@)(@@) 26621 - من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر .(@)(@@) % ( ن عن جابر ) .(@)(@@) 26622 - الحمام حرام على نساء أمتي .(@)(@@) % ( ك عن عائشة ) .(@)(@@) 26623 - شر البيت الحمام ، تعلو فيه الأصوات وتكشف فيه العورات ، فمن دخله فلا يدخل إلا مستترا .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26624 - من دخل الحمام بغير مئزر لعنه المكان .(@)(@@) % ( الشيرازي عن أنس ) .(@)(@@) 26625 - من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام بغير إزار ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر 
ms3535	 فلا يجلس على مائدة يدار عليها الخمر .(@)(@@) % ( ت ك عن جابر ) ( أخرجه الترمذي كتاب الأدب باب ما جاء في دخول الحمام رقم ( 2801 ) قال : حسن غريب . ص ) .(@)(@@) 26626 - احفظ عورتك إلا من زوجتك أو ما ملكت يمينك قيل : إذا كان القوم بعضهم من بعض ؟ قال : إن استطعت أن لا يراها أحد فلا يراها ، قيل : إذا كان أحدنا خاليا ؟ قال : الله أحق أن يستحيى منه من الناس .(@)(@@) % ( حم 4 ( أخرجه الترمذي كتاب الأدب باب ما جاء في حفظ العورة رقم ( 2794 ) وقال : حسن . ص ) ك هق عن بهز بن حكيم عن أبيه عن جده ) .(@)(@@) 26627 - إن الله تعالى حيي ستير يحب الحياء والستر فإذا اغتسل أحدكم فليستتر .(@)(@@) % ( حم د ن عن يعلى بن أمية ) .(@)(@@) 26628 - إنا نهينا أن ترى عوراتنا .(@)(@@) % ( ك عن جبار بن صخر ) .(@)(@@) 26629 - نهيت عن التعري .(@)(@@) % ( الطيالسي عن ابن عباس ) .(@)(@@) 26630 - نهيت أن أمشي عريانا .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26631 - نهى أن يدخل الماء إلا بمئزر .(@)(@@) % ( ك عن جابر ) .(@)(@@) 26632 - إياكم والتعري فإن معكم من لا يفارقكم إلا عند الغائط وحين يفضي الرجل إلى أهله ، فاستحيوهم وأكرموهم .(@)(@@) % ( ت ( أخرجه الترمذي كتاب الأدب باب ما جاء في الاستستار عند الجماع رقم ( 2800 ) وقال : غريب . ص ) عن ابن عمر ) .(@)(@@) 26633 - أول من دخل الحمامات وصنعت له النورة سليمان بن داود فلما دخله وجد حره وغمه فقال أوه من عذاب الله أوه قبل أن لا تكون أوه .(@)(@@) % ( عق طب عد هق عن أبي موسى ) .(@)(@@) | 1 ( { الإكمال } من دخول الحمام ) 1(@)(@@) 26634 - إذا كان آخر الزمان حرم فيه دخول الحمام على ذكور أمتي بميازرها ، قالوا : يا رسول الله لم ذاك ؟ قال : لأنهم يدخلون على قوم عراة ويدخل عليهم أقوام عراة ، ألا وقد لعن الله الناظر والمنظور إليه .(@)(@@) % ( كر عن الزهري مرسلا ) .(@)(@@) PageV09P170(@)(@@) 26635 - إنكم ستظهرون على الأعاجم فتجدون بيوتا تدعى الحمامات ، فلا يدخل الرجل إلا بإزار ، ولا يدخلها النساء إلا نفساء أو من مرض .(@)(@@) % ( عبد الرزاق طب عن ابن عمرو ) .(@)(@@) 26636 - إنكم ستفتحون 
ms3536	 أفقا فيها بيوت يقال لها الحمامات حرام على أمتي دخولها ، قال يا رسول الله إنها تذهب الوصب وتنقي الدرن قال : فإنها حلال لذكور أمتي في الأزر ، وحرام على أناث أمتي .(@)(@@) % ( طب عن المقدام ) .(@)(@@) 26637 - إنه سيكون حمامات ولا خير في الحمامات للنساء ، وإن دخلت بإزار ودرع وخمار ، وما من امرأة تنزع خمارها في غير بيت زوجها إلا كشفت الستر فيما بينها وبين ربها .(@)(@@) % ( طس عن عائشة ) .(@)(@@) 26638 - إنها ستفتح عليكم الشام وتجدون فيها بيوتا يقال لها الحمامات هي حرام على رجال أمتي إلا بالأزر ، وعلى نساء أمتي إلا نفساء أو سقيمة .(@)(@@) % ( عد ، خط في المتفق ، وأبو القاسم النجار في كتاب الحمام ، كر عن ابن عمر ) .(@)(@@) 26639 - من دخل الحمام منكم فليستتر .(@)(@@) % ( ش عن طاوس مرسلا ) .(@)(@@) 26640 - من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر .(@)(@@) % ( الخطيب عن أنس ؛ ط ش عن ابن عمر ) .(@)(@@) 26641 - من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر فليسع إلى الجمعة ، ومن استغنى عنها بلهو أو تجارة استغنى الله عنه والله غني حميد .(@)(@@) % ( طس عن أبي سعيد ) .(@)(@@) 26642 - من كان يؤمن بالله واليوم الآخر فلا يقعدن على مائدة يدار عليها الخمر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بإزار ، ومن كانت تؤمن بالله واليوم الآخر فلا تدخل الحمام .(@)(@@) % ( حم ع ق عن عمر ) .(@)(@@) 26643 - بيت بالشام لا يحل للمؤمنين أن يدخلوه إلا بمئزر ولا يحل للمؤمنات أن يدخلنه البتة .(@)(@@) % ( الديلمي عن عائشة ) .(@)(@@) 26644 - نعم البيت يدخله الرجل المسلم بيت الحمام وذلك أنه إذا دخله سأل الله الجنة واستعاذ بالله من النار ، وبئس البيت يدخله الرجل المسلم بيت العروس وذلك أنه يرغبه في الدنيا وينسيه الآخرة .(@)(@@) % ( الحكيم وابن السني في عمل يوم وليلة وابن عساكر عن أبي هريرة ) .(@)(@@) PageV09P171(@)(@@) 26645 - شر البيت الحمام تعلو فيه الأصوات وتكشف فيه العورات قيل : يداوي فيه المريض ويذهب 
ms3537	 فيه الوسخ ؟ قال : فمن دخله فلا يدخل إلا مستترا .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26646 - لا تدخل المرأة الحمام بمنديل ولا بغير منديل .(@)(@@) % ( الديلمي عن أبي هريرة ) .(@)(@@) 26647 - أول من صنعت له الحمامات سليمان بن داود .(@)(@@) % ( خ في تاريخه عق عن أبي موسى ) .(@)(@@) | 1 ( الباب الخامس في المياه والتيمم والمسح على الخفين والحيض والاستحاضة والنفاس والدباغة وفيه خمسة فصول ) 1(@)(@@)(@)(@@) | 1 ( الفصل الأول { في المياه } ) 1(@)(@@) 26648 - الماء لا ينجسه شيء .(@)(@@) % ( طس عن عائشة ) .(@)(@@) 26649 - الماء طهور إلا ما غلب على ريحه أو طعمه .(@)(@@) % ( قط عن ثوبان ) .(@)(@@) 26650 - ماء البحر طهور .(@)(@@) % ( ك عن ابن عباس ) ( أخرجه الحاكم في المستدرك كتاب الطهارة ( 1 / 140 ) : وهو صحيح على شرط مسلم ووافقه الذهبي . ص ) .(@)(@@) 26651 - إن الماء طهور لا ينجسه شيء .(@)(@@) % ( حم 3 ( أخرجه الترمذي كتاب الطهارة باب ما جاء أن الماء لا ينجسه شيء رقم ( 66 ) وقال : حسن . ص ) قط هق عن أبي سعيد ) .(@)(@@) 26652 - إن الماء لا ينجسه شيء إلا ما غلب على ريحه أو طعمه .(@)(@@) % ( ه عن أبي أمامة ) .(@)(@@) 26653 - إن الماء لا يجنب .(@)(@@) % ( د ، ت ، ( أخرجه الترمذي كتاب الطهارة باب ما جاء في الرخصة في ذلك رقم ( 65 ) وقال : حسن صحيح . ص ) ه حب ك هق عن ابن عباس ) .(@)(@@) 26654 - ليس على الماء جنابة .(@)(@@) % ( طب عن ميمونة ) .(@)(@@) 26655 - ليس على الماء جنابة ، ولا على الأرض جنابة ، ولا على الثوب جنابة .(@)(@@) % ( قط عن جابر ) .(@)(@@) 26656 - البحر الطهور ماؤه الحل ميتته .(@)(@@) % ( ه عن أبي هريرة ) .(@)(@@) 26657 - من لم يطهره البحر فلا طهره الله .(@)(@@) % ( قط هق عن أبي هريرة ) .(@)(@@) 26658 - إذا بلغ الماء قلتين لم يحمل الخبث .(@)(@@) % ( حم 3 ( أخرجه الترمذي كتاب الطهارة باب منه آخر رقم ( 50 ) ورقم الحديث ( 67 ) ص ) حب ك قط هق عن ابن عمر ) .(@)(@@) 26659 - إذا بلغ الماء قلتين لم ينجسه شيء .(@)(@@) % ( ه عن ابن عمر ) .(@)(@@) PageV09P172(@)(@@) 26660 - إذا بلغ الماء قلتين فما فوق ذلك لم ينجسه شيء .(@)(@@) % ( قط عن أبي هريرة ) .(@)(@@) 26661 - إذا بلغ الماء أربعين قلة فإنه 
ms3538	 لا يحمل الخبث .(@)(@@) % ( عد ( تعقب السيوطي هذا الحديث في كتابه اللآليء ( 2 / 3 ) فقال : لا يصح خلط فيه القاسم ، ثم قال : وورد ذلك أيضا عن أبي هريرة موقوفا أخرجه الدارقطني . ص ) عق قط عن جابر ) .(@)(@@) 26662 - إذا كان الماء قلتين فإنه لا ينجس .(@)(@@) % ( د ، ه ، ك عن ابن عمر ) . مر برقم [ 26658 ] .(@)(@@) 26663 - اغتسلوا من البحر وتوضؤوا به فإنه الطهور ماؤه الحل ميتته .(@)(@@) % ( تخ ك هق في المعرفة عن أبي هريرة ) .(@)(@@) 26664 - إن الماء لا ينجسه شيء .(@)(@@) % ( ه عن جابر ؛ حم ، ن عن ابن عباس ) .(@)(@@) 26665 - إن الماء ليس عليه جنابة ولا ينجسه شيء .(@)(@@) % ( حم عن ميمونة ) .(@)(@@) 26666 - الماء طهور ولا ينجسه شيء .(@)(@@) % ( حم عن أبي سعيد ؛ ن حب ك عن ابن عباس ) .(@)(@@) 26667 - هو الطهور ماءه الحل ميتته .(@)(@@) % ( حم ، 4 ( أخرجه الترمذي كتاب الطهارة باب ما جاء في ماء البحر أنه طهور رقم ( 69 ) وقال : حسن صحيح ) ، حب ، ك عن أبي هريرة حم ه حب ك عن جابر ؛ ه عن ابن الفراسي ) .(@)(@@) | 1 ( { الإكمال } من المياه ) 1(@)(@@) 26668 - إذا كان الماء قلتين أو ثلاثا لم ينجسه شيء .(@)(@@) % ( الشافعي في القديم حم ك ق في المعرفة عن ابن عمر ) .(@)(@@) 26669 - إذا كان الماء قلتين لم يحمل نجسا ولا بأسا .(@)(@@) % ( عب وابن جرير بلاغا ) .(@)(@@) 26670 - لا ينجس الماء إلا ما غير ريحه وطعمه .(@)(@@) % ( طس عن أبي أمامة ؛ عبد الرزاق عن عامر بن سعد مرسلا ) .(@)(@@) 26671 - اسقوا واستقوا فإن الماء يحل ولا يحرم .(@)(@@) % ( مسدد عن شيخ بلاغا ) .(@)(@@) 26672 - البحر طهور ماؤه حلال ميتته .(@)(@@) % ( عب عن أنس وعن سلمان بن موسى مرسلا وعن يحيى بن كثير بلاغا ) .(@)(@@) 26673 - تمرة طيبة وماء طهور .(@)(@@) % ( عبد الرزاق حم د ت وضعفه ه ، هق عن أبي مسعود أن النبي صلى الله عليه وسلم قال له : ليلة الجن ما في أدواتك ؟ قال : نبيذ قال : فذكره ) ( أخرجه الترمذي كتاب الطهارة باب ما جاء في الوضوء بالنبيذ رقم ( 88 ) ص ) .(@)(@@) 26674 - النبيذ وضوء من لم يجد الماء .(@)(@@) % ( قط عن ابن 
