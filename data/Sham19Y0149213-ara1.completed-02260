ms2241	 حذيفة بن اليمان.(@)(@@) روى الأوزاعي، عن يحيى، عن أبي قلابة أن أبا عبد الله قال (7)(@)(@@)(@@)(@@) $ 8277 - [مد]: أبو عبد الدائم (6) الهدادي عبد الملك بن كردوس.(@)(@@) عن: أبي المليح الهذلي.(@)(@@) وعنه: الوليد وخالد ابنا يزيد الهدادي.(@)(@)PageV10P318(@)(@)(@@)(@@)(@@) $ 8278 - [ق]: أبو عبد رب (1) الدمشقي الزاهد، ويقال: أبو عبد ربه،(@)(@@) ويقال: أبو عبد رب العزة قسطنطين الرومي مولى بني عذرة، ويقال:(@)(@@) مولى ثقيف.(@)(@@) عن: أويس القرني مرسلا، ومعاوية، وفضالة بن عبيد، وأم(@)(@@) الدرداء، وغيرهم.(@)(@@) وعنه: ثابت بن ثوبان، وعبد الله بن بجير، ومحمد بن عمر(@)(@@) [الحربي] (2) وعبد الرحمن بن يزيد بن جابر، وسعيد بن عبد العزيز.(@)(@@) قال سعيد بن عبد العزيز: خرج أبو عبد رب من عشرة آلاف دينار(@)(@@) ومن مائة ألف، وكان يقول: لو سألت بردا أمثال الذهب ما كنت أول(@)(@@) الناس يقوم إليها، ولو قيل: إن الموت في هذا العمود، لم يسبقني إليه(@)(@@) أحد إلا بفضل قوة. ونحن نعلم أنه صدق. روى ابن جابر عن أبي عبد(@)(@@) رب نحو ذلك، وزاد: شوقا إلى الله ورسوله. وقال ابن ثوبان:(@)(@@) سمعته يقول لمكحول: يا أبا عبد الله تحب الجنة؟ قال: ومن لا يحب(@)(@@) الجنة! قال: فأحب الموت فإنك لن ترى الجنة حتى تموت. وقال الوليد(@)(@@) ابن مسلم: حدثني ابن جابر: أن أبا عبد رب كان من أكثر أهل دمشق(@)(@@) مالا، فخرج إلى أذربيجان في تجارة، فلما رجع تصدق بصامت ماله،(@)(@@) وجهز في سبيل الله، وباع عقاره فتصدق به إلا دارا له بدمشق، ثم ذكر(@)(@@) أنه باعها بعد ذلك بمال عظيم، وفرقه فكان ذلك مع موته، فما وجدنا(@)(@@) من ثمنها إلا قدر ثمن الكفن.(@)(@@) قيل: توفي سنة اثنتي عشرة ومائة. قاله أبو مسهر.(@)(@)PageV10P319(@)(@)(@@)(@@)(@@) $$$ [د]: أبو عبد الرحمن (1) الأفريقي عبد الله بن عمر.(@)(@@)(@@)(@@) $ 8279 - [ق]: أبو عبد الرحمن (1) التميمي.(@)(@@) عن: عثمان بن عطاء الخراساني.(@)(@@) وعنه: بقية.(@)(@@)(@@)(@@) $ 8280 - [ق]: أبو عبد الرحمن (2) الجهني.(@)(@@) مختلف في صحبته، له حديث (3) رواه عنه أبو الخير مرثد اليزني،(@)(@@) نزل مصر.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو عبد الرحمن (4) الحبلي عبد الله بن يزيد.(@)(@@)(@@)(@@) $$$ [د 
ms2242	 ق]: أبو عبد الرحمن (5) الخراساني إسحاق بن أسيد.(@)(@@)(@@)(@@) $$$ [ع]: أبو عبد الرحمن (6) السلمي عبد الله بن حبيب.(@)(@@)(@@)(@@) $$$ [ت]: أبو عبد الرحمن (6) الفزاري النضر بن منصور.(@)(@@)(@@)(@@) $ 8281 - [د]: أبو عبد الرحمن (7) الفهري له صحبة.(@)(@@) يقال: يزيد بن أنيس، وفيل: الحارث بن هشام، وقيل: عبد، وقيل:(@)(@@) كرز. شهد حنينا.(@)(@)PageV10P320(@)(@)(@@) له في "صلاة النبي - صلى الله عليه وسلم - تجاه الكعبة" (1).(@)(@@) وعنه: عبد الله بن يسار.(@)(@@)(@@)(@@) $$$ [ع]: أبو عبد الرحمن (2) المقرئ عبد الله بن يزيد.(@)(@@)(@@)(@@) $ 8282 - [د]: أبو عبد الرحمن (3).(@)(@@) عن: بلال في "المسح" (4).(@)(@@) وعنه: أبو عبد الله مولى تيم بن مرة.(@)(@@)(@@)(@@) $$$ [بخ م د س]: أبو عبد الرحيم (5) الحراني خالد بن أبي(@)(@@) يزيد صاحب زيد بن أبي أنيسة.(@)(@@)(@@)(@@) $$$ [د]: أبو عبد السلام (5) صالح بن رستم الدمشقي.(@)(@@)(@@)(@@) $$$ [ع]: أبو عبد الصمد (5) العمي عبد العزيز بن عبد الصمد.(@)(@@)(@@)(@@) $$$ [د]: أبو عبد العزيز (6) الأردني يحيى بن عبد العزيز.(@)(@@)(@@)(@@) $ 8283 - [بخ]: أبو عبد العزيز (7) سمع أبا هريرة.(@)(@@) وعنه: أبو جمرة الضبعي.(@)(@@) قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $ 8284 - [بخ]: أبو عبد الملك (7) مولى آل عمر.(@)(@@) عن: مولاته أم مسكين بنت عاصم بن عمر، وأبي هريرة.(@)(@)PageV10P321(@)(@)(@@) وعنه: علي بن العلاء.(@)(@@)(@@)(@@) $ 8285 - [خ ت س]: أبو عبس بن جبر بن عمرو بن زيد بن جشم(@)(@@) الأنصاري [الحارثي] (1)، له صحبة، ورواية، اسمه عبد الرحمن، وقيل:(@)(@@) عبد الله بدري جليل.(@)(@@) يروي عنه: ابنه [زيد] (2)، وحفيده أبو عبس بن محمد، وعباية(@)(@@) ابن رفاعة.(@)(@@) قال ابن عبد البر: مات سنة أربع وثلاثين عن سبعين سنة، وصلى(@)(@@) عليه عثمان، وكان فيمن قتل كعب بن الأشرف. له في الكتب حديث(@)(@@) واحد رواه أحمد فى المسند: حدثنا الوليد سمعت يزيد بن أبي مريم(@)(@@) وقال: "لحقني عباية بن رفاعة، وأنا رائح إلى الجمعة ماشيا وهو راكب(@)(@@) فقال: أبشر فإني سمعت أبا عبس يقول: قال رسول الله - صلى الله عليه وسلم -: من اغبرت(@)(@@) قدماه في سبيل الله حرمهما الله على النار" (3).(@)(@@)(@@)(@@) $$$ أبو عبلة (4).(@)(@@) عن: ابن عجلان، وعنه عراك بن خالد.(@)(@@) كذا في القدر لأبي داود.(@)(@@) والصواب إبراهيم بن أبي عبلة. 
ms2243	(@)(@)PageV10P322(@)(@)(@@)(@@)(@@) $$$ [س]: أبو عبيد الله (1) الأشعري (2) معاوية بن، صالح شيخ النسائي.(@)(@@)(@@)(@@) $$$ [د س ق]: أبو عبيد الله (3) الخزاعي مسلم بن مشكم الدمشقي.(@)(@@)(@@)(@@) $$$ [ت س]: أبو عبيد الله (3) المخزومي سعيد بن عبد الرحمن المكي.(@)(@@)(@@)(@@) $$$ [م]: أبو عبيد الله (3) الوهبي أحمد بن عبد الرحمن بن وهب.(@)(@@)(@@)(@@) $$$ [بخ خد س]: أبو عبيد الله (4) المكي سليم. عن: مجاهد.(@)(@@)(@@)(@@) $$$ أبو عبيد الله (5) حماد بن الحسن الوراق.(@)(@@)(@@)(@@) $$$ أبو عبيد (5) صاحب الكتب القاسم بن سلام.(@)(@@)(@@)(@@) $ 8286 - [صد]: أبو عبيد (5) الزرقي وقيل: أبو عبد الله.(@)(@@) عن: النبي - صلى الله عليه وسلم -. قاله ابن القاري عن ابن أبي عبيد عن أبيه.(@)(@@)(@@)(@@) $ 8287 - [خت م د سي]: أبو عبيد (6) الحاجب المذحجي حي، وقيل:(@)(@@) حوي، وقيل: حعي، وقيل: عبد الملك، حاجب سليمان بن عبد الملك.(@)(@@) عن: عمرو بن عبسة، وأنس، وعطاء بن يزيد، وقيس بن الحارث(@)(@@) المذحجي، وعبادة بن نسي، وجماعة.(@)(@@) وعنه: مسرة بن معبد، وسهيل بن أبي صالح، وعمرو بن الحارث(@)(@@) المصري، وابن عجلان، والأوزاعي، وجماعة.(@)(@@) وثقه أحمد وغيره. وقال بقية عن بشر بن عبد الله قال: لم أر أحدا(@)(@@) قط أعمل بالعلم من أبي عبيد. وقال عبد الرحمن [4/ ق 213 - أ] بن PageV10P323(@)(@@) حسان الكناني: إن أبا عبيد كان يحجب، سليمان بن عبد الملك، فلما(@)(@@) ولي عمر بن عبد العزيز قال له: هذه الطريق إلى فلسطين، وأنت من(@)(@@) أهلها فالحق بها. فقالؤا بعد: يا أمير المؤمنين، لو رأيت أبا عبيد(@)(@@) وتشميره للخير والعبادة. قال: ذاك أحق أن لا يفتنه كانت فيه أبهة(@)(@@) للعامة. أخبرنا أحمد بن هبة الله، أنبأنا المؤيد، أنا أبو محمد السيدي،(@)(@@) أنبأنا أبو عثمان البحيري، أنبأنا زاهر بن أحمد، أنبأنا إبراهيم بن عبد(@)(@@) الصمد، أنبأنا أبو مصعب، حدثنا مالك، عن أبي عبيد مولى سليمان(@)(@@) ابن عبد الملك، عن عطاء بن يزيد الليثي، عن أبي هريرة قال: "من(@)(@@) سبح دبر كل صلاة ثلاثا وثلاثين، وحمد ثلاثا وثلاثين، وكبر ثلاثا(@)(@@) وثلاثين، وختم المائة بلا إله إلا الله وحده لا شريك له، له الملك وله الحمد(@)(@@) وهو على كل شيء قدير، 
ms2244	 غفرت ذنوبه ولو كانت مثل زبد البحر".(@)(@@) س (1)، عن قتيبه، عن مالك، ورواه م (2) من حديث (سهيل) (3)(@)(@@) ابن أبي صالح، عن أبي عبيد فرفعه.(@)(@@)(@@)(@@) $ 8288 - تم: أبو عبيد (4) مولى النبي - صلى الله عليه وسلم - قال له النبي - صلى الله عليه وسلم -: "ناولني(@)(@@) الذراع" (5).(@)(@@) وعنه: شهر بن حوشب من رواية قتادة عنه.(@)(@@)(@@)(@@) $$$ [ع]: أبو عبيد (6) مولى ابن أزهر سعد بن عبيد.(@)(@)PageV10P324(@)(@)(@@)(@@)(@@) $$$ [ع]: أبو عبيدة (1) بن الجراح أمين الأمة عامر بن عبد الله بن الجراح.(@)(@@)(@@)(@@) $ 8289 - [س ق]: أبو عبيدة (2) بن حذيفة بن اليمان.(@)(@@) [عن: أبيه] (3) وأبي موسى، وعدي بن حاتم، وعمته فاطمة بنت(@)(@@) اليمان.(@)(@@) وعنه: ابن سيرين، ويزيد أبو خالد، ويوسف بن ميمون،(@)(@@) وحصين بن عبد الرحمن، وغيرهم.(@)(@@) له عندهما حديثان.(@)(@@)(@@)(@@) $$$ [ت س ق]: أبو عبيدة (4) بن أبي السفر الهمداني أحمد بن عبد الله.(@)(@@)(@@)(@@) $ 8290 - [م د س ق]: أبو عبيدة (5) بن عبد الله بن زمعة القرشي(@)(@@) الأسدي.(@)(@@) عن: أبيه، وأمه زينب بنت أبي سلمة، وجدته أم سلمة،(@)(@@) وغيرهم.(@)(@@) وعنه: ابنه ركيح، والزهري، وابن إسحاق، والأعرج، وموسى(@)(@@) ابن يعقوب الزمعي، وغيرهم.(@)(@@) *ع: أبو عبيدة بن عبد الله بن مسعود (عامر) (6).(@)(@@)(@@)(@@) $ 8291 - [د]: أبو عبيدة (7) بن عبيد الله الأشجعي.(@)(@)PageV10P325(@)(@)(@@) عن: أبيه، وغيره.(@)(@@) وعنه: أحمد بن حنبل، وعيسى بن يونس الطرسوسي، وأبو عمير(@)(@@) (بن) (1) النحاس، وغيرهم.(@)(@@)(@@)(@@) $ 8292 - [م س]: أبو عبيدة (2) بن [عقبة] (3) بن نافع الفهري المصري،(@)(@@) يقال: مرة.(@)(@@) عن: أبيه، وأخيه عياض، وشرحبيل بن السمط، وابن عمر.(@)(@@) وعنه: أبو عقيل زهرة بن معبد، وسليمان بن حميد، وصاعد بن(@)(@@) محمد المصري، وعبد الكريم بن الحارث بن يزيد.(@)(@@) ذكره ابن حبان في الثقات، وولي أبوه إمرة مصر والمغرب.(@)(@@)(@@)(@@) $ 8293 - [4]: أبو عبيدة (4) بن محمد بن عمار بن ياسر(@)(@@) العنسي، أخو سلمة، ويقال: هو سلمة.(@)(@@) عن: أبيه، وجابر، وطلحة بن عبد الله بن عوف، والربيع بنت(@)(@@) معوذ بن عفراء، والوليد بن أبي الوليد، وغيرهم.(@)(@@) وعنه: سعد بن إبراهيم، وعبد الرحمن بن إسحاق المدني، وابن(@)(@@) إسحاق، وجماعة.(@)(@@) وثقه ابن معين. وقال أبو حاتم: [صحيح] (5) الحديث. وقال PageV10P326(@)(@@) منكر 
ms2245	 الحديث.(@)(@@)(@@)(@@) $$$ [م د س ق]: أبو عبيدة (1) بن معن المسعودي عبد الملك.(@)(@@)(@@)(@@) $ 8294 - [ر]: أبو عبيدة (2).(@)(@@) عن: أنس عن النبي - صلى الله عليه وسلم - في "قراءة الظهر" (3).(@)(@@) وعنه: سفيان بن حسين.(@)(@@) قال ابن معين: هو حميد الطويل.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو عبيدة (4) الحداد عبد الواحد بن واصل.(@)(@@)(@@)(@@) $$$ [عس]: أبو عبيدة (4).(@)(@@) عن: عبد الله بن محمد المفلوج.(@)(@@) وعنه: [عس].(@)(@@) هو ابن أبي السفر.(@)(@@)(@@)(@@) $$$ [سي]: أبو عبيدة (5).(@)(@@) عن: عطاء بن يزيد.(@)(@@) قال النسائي: الصواب أبو عبيد وهو الحاجب.(@)(@@)(@@)(@@) $$$ [بخ]: أبو العبيدين (6) الكوفي معاوية بن سبرة.(@)(@@)(@@)(@@) $$$ [م 4]: أبو عتاب (6) الدلال سهل بن حماد.(@)(@)PageV10P327(@)(@)(@@)(@@)(@@) $$$ أبو عتبة (1) الحجازي: أحمد بن الفرج.(@)(@@)(@@)(@@) $ 8295 - [س]: أبو عتبة (1).(@)(@@) عن: عائشة.(@)(@@) وعنه: مسعر، وقيل: بينه وبين عائشة رجل.(@)(@@)(@@)(@@) $ 8296 - [س فق]: أبو عثمان (2) بن سنة الخزاعي الكعبي الدمشقي.(@)(@@) عن: علي، وابن مسعود.(@)(@@) وعنه: الزهري.(@)(@@)(@@)(@@) $$$ [س]: أبو عثمان (3) بن نصر.(@)(@@) عن: أبيه "قصة ماعز" (4).(@)(@@) وعنه: محمد بن إبراهيم التيمي.(@)(@@) والصواب: أبو الهيثم بن نصر بن دهر.(@)(@@)(@@)(@@) $ 8297 - [مد]: أبو عثمان (5) بن يزيد أرسل حديثا.(@)(@@) وعنه: ابن جريج.(@)(@@)(@@)(@@) $ 8298 - [د ت]: أبو عثمان (6) الأنصاري المدني، قاضي مرو، ويقال:(@)(@@) اسمه عمر.(@)(@@) أرسل عن: أبي بن كعب، وعن القاسم بن محمد.(@)(@@) وعنه: مطرف بن طريف، ومهدي بن ميمون، وأبو المنيب عبيد الله PageV10P328(@)(@@) العتكي، والربيع بن صبيح، وغيرهم.(@)(@@) قال أبو داود: ثقة، اسمه عمرو بن سالم.(@)(@@)(@@)(@@) $$$ [خ م د ت س]: أبو عثمان (1) الجعد بن دينار.(@)(@@)(@@)(@@) $ 8299 - [خت د ت س]: أبو عثمان (2) التبان مولى المغيرة بن شعبة(@)(@@) يقال: سعيد، ويقال: عثمان.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: ابنه موسى، ومحصور بن المعتمر، ومغيرة بن مقسم.(@)(@@) أخبرنا إسماعيل بن عبد الرحمن، أنبأنا ابن قدامة، أنبأنا ابن(@)(@@) البطي، أنا رزق الله التميمي، أنبأنا علي بن محمد، أنبأنا محمد بن(@)(@@) عمرو، ثنا سعدان بن نصر، ثنا سفيان، عن أبي الزناد، عن موسى(@)(@@) ابن أبي عثمان، عن أبيه، عن أبي هريرة رفعه قال: "لا يبولن أحدكم(@)(@@) في الماء الدائم ثم يغتسل فيه" (3).(@)(@@)(@@)(@@) $ 8300 - [عس]: أبو عثمان (4) الخراساني.(@)(@@) سمع 
ms2246	 عليا.(@)(@@) [وعنه (5)]: عمارة بن أبي حفصة.(@)(@@)(@@)(@@) $$$ أبو عثمان (6) الصنعاني شراحيل.(@)(@@)(@@)(@@) $$$ [بخ مق د ت ق]: أبو عثمان (6) الطنبذي مسلم بن يسار.(@)(@)PageV10P329(@)(@)(@@)(@@)(@@) $$$ [ع]: أبو عثمان (1) النهدي عبد الرحمن بن مل.(@)(@@)(@@)(@@) $ 8301 - [د س ق]: أبو عثمان (2) وليس بالنهدي يقال: سعد.(@)(@@) عن: [معقل] (3) بن يسار [وقيل: عن أبيه عن معقل بن يسار] (4)(@)(@@) وعن أنس.(@)(@@) وعنه: سليمان التيمي وحده.(@)(@@) قال أبو داود: هو أبو عثمان السلي. وذكره ابن حبان في الثقات،(@)(@@) حديثه عن معقل، عن النبي - صلى الله عليه وسلم -: "اقرءوها على موتاكم- يعني(@)(@@) يس" (5) وله حديث آخر (6) عن أنس.(@)(@@)(@@)(@@) $ 8302 - [م د ت س]: أبو عثمان (7).(@)(@@) عن: [جبير] (8) بن نفير، وأرسل عن: عمر، وغيره.(@)(@@) وعنه: ربيعة بن يزيد، ومعاوية بن صالح.(@)(@@) يقال: هو سعيد بن هانئ.(@)(@@)(@@)(@@) $ 8303 - [س]: أبو عثمان (9).(@)(@)PageV10P330(@)(@)(@@) عن: أنس.(@)(@@) وعنه: إبراهيم بن طهمان. لعله ربيعة أبو الجعد.(@)(@@)(@@)(@@) $ 8304 - [ت]: أبو عثمان (1).(@)(@@) عن: أبي هريرة في "رجلين دخلا النار" (2).(@)(@@) وعنه: عبد الرحمن بن زياد الأفريقي.(@)(@@)(@@)(@@) $$$ [مد]: - أبو عثمان (3).(@)(@@) عن: الحسن.(@)(@@) وعنه: الأوزاعي. لعله جسر بن فرقد.(@)(@@)(@@)(@@) $ 8305 - [ع]: أبو العجفاء (4) السلمي البصري هرم بن نسيب، وقيل:(@)(@@) نسيب بن هرم.(@)(@@) عن: عمر، وعمرو بن العاص، وغيرهما.(@)(@@) وعنه: ابن "سيرين، وابنه عبد الله بن أبي العجفاء، وصالح بن(@)(@@) جبير، وولده محمد بن صالح، وقيل: بين ابن سيرين [وبينه] (5).(@)(@@) رجل.(@)(@@) وثقه ابن معين. وقال البخاري: في حديثه نظر. قال أبو أحمد(@)(@@) الحاكم: حديثه ليس بالقائم. وذكره ابن حبان في الثقات. قال ابن(@)(@@) سيرين: عن أبي العجفاء سمع عمر يقول: "ألا لا تغالوا في صدق PageV10P331(@)(@@) النساء ... " (1) الحديث.(@)(@@)(@@)(@@) $ 8306 - [بخ]: أبو العجلان (2) المحاربي.(@)(@@) عن: ابن عمر.(@)(@@) وعنه: حميد بن أبي غنية، والفضل بن يزيد الثمالي.(@)(@@) وقال (ت): ثنا هناد، ثنا علي بن مسهر، عن الفضل الثمالي،(@)(@@) عن أبي المخارق، عن ابن عمر رفعه "الكافر يسحب لسانه الفرسخ(@)(@@) والفرسخين يتوطأه الناس" (3). وهذا خطأ من نسخ الترمذي أو منه،(@)(@@) رواه علي بن مسهو من حديث منجاب بن الحارث عنه، وأبو عقيل(@)(@@) الثقفي ومروان بن معاوية عن الفضل الثماني، 
ms2247	 عن أبي العجلان(@)(@@) المحاربي، عن ابن عمر.(@)(@@)(@@)(@@) $$$ [د ق]: أبو العدبس (4) يقال: تبيع بن سليمان.(@)(@@)(@@)(@@) $ 8307 - أبو العدبس (5) الأكبر منيع بن سليمان الكوفي.(@)(@@) عن: عمر.(@)(@@) وعنه: عاصم بن بهدلة، وعاصم الأحول، وأبو الورقاء سالم بن(@)(@@) مخراق.(@)(@@) وجعلهما أبو أحمد الحاكم واحدا فوهم.(@)(@)PageV10P332(@)(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $ 8308 - [د ت ق]: أبو عذرة (1).(@)(@@) أدرك النبي - صلى الله عليه وسلم -، وحدث عن: عائشة.(@)(@@) وعنه: عبد الله بن شداد الأعرج الواسطي.(@)(@@)(@@)(@@) $$$ [خ]: أبو العريان (2) النخعي الهيثم بن الأسود.(@)(@@)(@@)(@@) $$$ [بخ قد ت]: أبو عزة (2) الهذلي يسار بن عبد صحابي.(@)(@@)(@@)(@@) $$$ [بخ د س ق]: أبو عشانة (2) المعافري حي بن يؤمن.(@)(@@)(@@)(@@) $ 8309 - [4]: أبو العشراء (3) الدارمي البصري.(@)(@@) عن: أبيه.(@)(@@) وعنه: حماد بن سلمة.(@)(@@) يقال: أسامة بن مالك، وقيل: عطارد بن برز أو بلز، وقيل:(@)(@@) يسار بن بلز بن مسعود، وكان أعرابيا ينزل الجفرة بطريق البصرة، وهو(@)(@@) مجهول، قال أحمد: ما أعرف له [حديثا] (4) غير حديث الذكاة.(@)(@@) وقال البخاري: في حديثه واسمه وسماعه من أبيه نظر. وذكره ابن حبان(@)(@@) في الثقات، قال الميموني: سألت أبا عبد الله عن حديث أبي العشراء(@)(@@) قال: هو عندي غلط ولا يعجبني، ولا أذهب إليه إلا في موضع ضرورة.(@)(@@)(@@)(@@) $ 8310 - [م د ت س]: أبو عصام (5) بصري.(@)(@@) عن: أنس.(@)(@)PageV10P333(@)(@)(@@) وعنه: شعبه، وهشام الدستوائي، وعبد الوارث.(@)(@@) يقال: اسمه ثمامة، وقيل: خالد بن عبيد. وقال أحمد بن سيار(@)(@@) في تاريخ مرو: أبو عصام خالد بن عبيد العتكي، كان شيخا نبيلا،(@)(@@) وكان العلماء يعظمونه ويكرمونه، كان ابن المبارك ربما سوى عليه الثياب(@)(@@) إذا ركب، روى عن أنس ثلاثة أحاديث، وعن الحسن، وابن بريدة،(@)(@@) وعنه ابن المبارك، والفضل السيناني، وأبو تميلة، وبعض الحفاظ فرق(@)(@@) بين أبي عصام، وبين خالد بن عبيد. وقيل: بل هو بصري صار إلى(@)(@@) مرو. ولا يبعد ذلك والله أعلم.(@)(@@)(@@)(@@) $$$ [ت فق]: أبو عصمة (1) نوح بن أبي مريم.(@)(@@)(@@)(@@) $ 8311 - [خ م د ت س]: أبو عطية (2) الوداعي الهمداني الكوفي مالك،(@)(@@) يقال: ابن عامر، ويقال: ابن أبي عامر، ويقال: ابن حمرة، ويقال: ابن(@)(@@) أبي حمرة، وقيل: اسمه 
ms2248	 عمرو بن جندب، وقيل: هما اثنان.(@)(@@) عن: ابن مسعود، وعائشة، وأبي موسى، وغيرهم.(@)(@@) وعنه: محمد بن سيرين، وعمارة بن عمير، وأبو إسحاق(@)(@@) السبيعي، وحصين بن عبد الرحمن [والأعمش] (3) وجماعة.(@)(@@) وثقه ابن معين وغيره.(@)(@@)(@@)(@@) $ 8312 - [د ت س]: أبو عطية (4) مولى بني عقيل.(@)(@@) عن: مالك بن الحويرث.(@)(@@) وعنه: بديل بن ميسرة.(@)(@)PageV10P334(@)(@)(@@) قال أبو حازم: لا يعرف، ولا يسمى. له حديث "من زار قوما(@)(@@) فلا يؤمهم" (1).(@)(@@)(@@)(@@) $$$ ق: أبو عقال (2) مولى أنس هلال بن زيد.(@)(@@)(@@)(@@) $ 8313 - [د ق]: أبو عقبة (3) الفارسي مولى الأنصار، وقيل: ولاؤه لبني(@)(@@) هاشم، قيل: اسمه رشيد.(@)(@@) قال ابن إسحاق: عن داود بن الحصين، عن عبد الرحمن بن أبي(@)(@@) عقبة، عن أبي عقبة، وكان من أهل فارس قال: "شهدت مع رسول الله(@)(@@) - صلى الله عليه وسلم - يوم أحد فضربت رجلا من المشركين فقلت: خذها، وأنا الغلام(@)(@@) الفارسي" (4).(@)(@@)(@@)(@@) $ 8314 - [بخ]: أبو عقبة (5).(@)(@@) حكى عن: ابن عمر.(@)(@@) وعنه: عبد العزيز بن المختار.(@)(@@)(@@)(@@) $ 8315 - [بخ س]: أبو عقرب (6) البكري الكناني صحابي عداده في أهل(@)(@@) البصرة قيل: اسمه خويلد بن (بجير) (7)، وقيل: عويج بن(@)(@@) خويلد.(@)(@)PageV10P335(@)(@)(@@) روى حديثه الأسود بن شيبان عن أبي نوفل بن أبي عقرب عن أبيه.(@)(@@)(@@)(@@) $$$ [4]: أبو عقيل (1) الثقفي عبد الله بن عقيل.(@)(@@)(@@)(@@) $$$ أبو عقيل (1) الجمال يحيى بن حبيب.(@)(@@)(@@)(@@) $$$ [د سي ق]: أبو عقيل (2) الدمشقي هاشم بن بلال.(@)(@@)(@@)(@@) $$$ [خ م مد تم]: أبو عقيل (2) الدورقي بشير بن عقبة.(@)(@@)(@@)(@@) $$$ [مق د]: أبو عقيل (2) صاحب بهية يحيى بن المتوكل.(@)(@@)(@@)(@@) $$$ [خ 4]: أبو عقيل (3) زهرة بن معبد المصري.(@)(@@)(@@)(@@) $ 8316 - [قد]: أبو عقيل (3) مولى عمر.(@)(@@) عن: امرأة عن عائشة "أنها سألت رسول الله - صلى الله عليه وسلم - عن أطفال المشركين(@)(@@) فقال: يتعاوون في النار".(@)(@@) وعنه: سفيان الثوري.(@)(@@)(@@)(@@) $ 8317 - [ق]: أبو عكاشة (4) الهمداني الكوفي مجهول.(@)(@@) عن: رفاعة بن شداد.(@)(@@) وعنه: أبو ليلى عبد الله بن ميسرة.(@)(@@)(@@)(@@) $$$ [بخ م د س]: أبو علقمة (5) الفروي الكبير عبد الله بن محمد.(@)(@@)(@@)(@@) $ 8318 - أبو علقمة (6) الفروي الصغير عبد الله بن هارون بن موسى بن PageV10P336(@)(@@) أبي علقمة الفروي الكبير.(@)(@@) عن: القعنبي، وعبد الله 
ms2249	 بن نافع، ومطرف بن عبد الله، وأبي(@)(@@) غزية محمد بن موسى الأنصاري.(@)(@@) وعنه: ابن قتيبة العسقلاني، وأبي قريش محمد بن جمعة، وعبد(@)(@@) الرحمن بن أبي حازم، وجماعة.(@)(@@) قال ابن عدي: له مناكير. وقال أبو أحمد: منكر الحديث.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $ 8319 - [ر م 4]: أبو علقمة (1) المصري مولى بني هاشم، ويقال:(@)(@@) حليف الأنصار.(@)(@@) عن: عثمان، وابن مسعود، وأبي هريرة، وأبي سعيد، وغيرهم.(@)(@@) وعنه: صالح أبو الخليل، وعبد الله بن عبيد بن عمير، ويعلى بن(@)(@@) عطاء العامري، وأبو الزبير، ويعقوب بن عطاء بن أبي رباح، وعبد(@)(@@) الرحمن بن زياد الأفريقي، وجماعة.(@)(@@) قال أبو حاتم: أحاديثه صحاح. وقال ابن يونس: أبو علقمة(@)(@@) الفارسي مولى ابن عباس كان على قضاء أفريقية وكان أحد الفقهاء الموالي(@)(@@) الذين ذكرهم يزيد بن أبي حبيب.(@)(@@)(@@)(@@) $$$ [د]: أبو علقمة (2) مولى بني أمية.(@)(@@) عن: ابن عمر.(@)(@@) وعنه: عبد العزيز بن عمر بن عبد العزيز.(@)(@@) كذا في رواية اللؤلؤي عن أبي داود، وفي رواية ابن العبد وجماعة PageV10P337(@)(@@) عنه "أبو طعمة" بدل "أبي علقمة" وهو الصواب.(@)(@@)(@@)(@@) $ 8320 - [د ت]: أبو علي (1) الأيلي.(@)(@@) عن: الزهري.(@)(@@) وعنه: أخوه يونس بن يزيد. في الثقات لابن حبان.(@)(@@)(@@)(@@) $ 8321 - [سي]: أبو علي (2) الأزدي.(@)(@@) عن: أبي ذر.(@)(@@) وعنه: منصور.(@)(@@) قاله سفيان الثوري عنه، وقال شعبة: عن منصور عن أبي الفيض.(@)(@@)(@@)(@@) $$$ [م د س ق]: أبو علي (3) الأصبحي ثمامة بن شفي.(@)(@@)(@@)(@@) $$$ [بخ 4]: أبو علي (3) الجنبي عمرو بن مالك.(@)(@@)(@@)(@@) $$$ [ع]: أبو علي (4) الحنفي عبيد الله بن عبد المجيد.(@)(@@)(@@)(@@) $$$ أبو علي (4) الرحبي حسين بن قيس.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو [عمار] (5) الدمشقي (4) شداد بن عبد الله.(@)(@@)(@@)(@@) $$$ [خ م د ت س]: أبو عمار (6) المروزي حسين بن حريث.(@)(@)PageV10P338(@)(@)(@@)(@@)(@@) $$$ [س ق]: أبو عمار (1) الهمداني عريب بن حميد.(@)(@@) عن: قيس بن سعد بن عبادة.(@)(@@)(@@)(@@) $$$ [ق]: أبو عمارة (1) الأنصاري قيس.(@)(@@)(@@)(@@) $$$ [بخ ق]: أبو عمر (2) البزار دينار بن عمر.(@)(@@)(@@)(@@) $$$ [ت عس ق]: أبو عمر (3) البزار القارئ حفص بن سليمان.(@)(@@)(@@)(@@) $$$ [م د س ق]: أبو عمر (3) البهراني يحيى بن عبيد.(@)(@@)(@@)(@@) $$$ [خ د س]: أبو عمر (4) الحوضي حفص بن عمر.(@)(@@)(@@)(@@) $ 8322 
ms2250	 - [س]: أبو عمر (5) الدمشقي، وقيل: أبو عمرو.(@)(@@) عن: عبيد بن (الخشخاش) (6)، وعمر بن عبد العزيز.(@)(@@) وعنه: المسعودي، وحسين الجعفي.(@)(@@) قال الدارقطني: متروك.(@)(@@)(@@)(@@) $$$ [ق]: أبو عمر (5) الدوري حفص بن عمر.(@)(@@)(@@)(@@) $$$ [ت]: أبو عمر (7) الصفار حماد بن واقد.(@)(@@)(@@)(@@) $ 8323 - [سي]: أبو عمر (8) الصيني شامي حديثه في أهل الكوفة، PageV10P339(@)(@@) اسمه نشيط، وقال بعضهم: عمرو الصيني فوهم.(@)(@@) عن: أبي الدرداء، وقيل: عن أم الدرداء عن أبي الدرداء.(@)(@@) وعنه: الحكيم بن عتيبة، وحبيب بن أبي ثابت، وجماعة.(@)(@@)(@@)(@@) $$$ [د]: أبو عمر (1) الضرير حفص بن عمر.(@)(@@) وثم جماعة كنيتهم أبو عمر الضرير كتبوا شي ترجمة أبي عمر هذا.(@)(@@)(@@)(@@) $ 8324 - [د س]: أبو عمر (2) الغداني، وقيل: أبو عمرو، بصري.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: قتادة.(@)(@@) وثقه ابن حبان.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو عمر (3) زاذان الكندي.(@)(@@)(@@)(@@) $ 8325 - [بخ ق]: أبو عمر (4) المنبهي النخعي.(@)(@@) عن: أبي جحيفة.(@)(@@) وعنه: شريك القاضي.(@)(@@)(@@)(@@) $$$ [ع]: أبو عمر (5) مولى أسماء، عبد الله بن كيسان.(@)(@@)(@@)(@@) $ 8326 - [س]: أبو عمرو (6) بن حفص بن المغيرة المخزومي، ابن عم(@)(@@) خالد بن الوليد، وزوج فاطمة بنت قيس، يقال: عبد الحميد، ويقال:(@)(@@) أحمد، وقيل: اسمه كنيته.(@)(@)PageV10P340(@)(@)(@@) أسلم وخرج مع علي إلى اليمن فمات هناك، روى حديثه علي بن(@)(@@) رباح عن ناشرة بن سمي عنه، والحديث (1) يدل على أنه بقي إلى أيام(@)(@@) عمر، وأنه قال لعمر: "والله لقد نزعت عاملا استعمله رسول الله - صلى الله عليه وسلم -(@)(@@) يعني خالد بن الوليد".(@)(@@)(@@)(@@) $$$ [س]: أبو عمرو (2) بن حفص، أو أبو حفص بن عمرو، عبد الله بن(@)(@@) حفص.(@)(@@)(@@)(@@) $ 8327 - [د]: أبو عمرو (3) بن حماس بن عمرو الليثي.(@)(@@) عن: أبيه، وحمزة بن أبي أسيد الساعدي، ومالك بن أوس بن(@)(@@) الحدثان.(@)(@@) وعنه: ابنه شداد، وحمزة بن المغيرة، ومحمد بن عمرو بن(@)(@@) علثمة، وغيرهم.(@)(@@) قال ابن سعد: كان متعبدا مجتهدا يصلي بالليل، وكان شديد النظر(@)(@@) إلى النساء فدعا الله أن يذهب بصره، فعمي فلم يتحمل(@)(@@) العمى فدعا الله تبارك وتعالى فرد عليه بصره، فبينا هو يصلي إذ رفع(@)(@@) رأسه فرأى قناديل المسجد فخر ساجدا شكرا لله وكان يصوم الدهر،(@)(@@) وكان 
ms2251	 بعد إذا رأى المرأة طأطأ رأسه.(@)(@@)(@@)(@@) $ 8328 - [قد فق]: أبو عمرو (4) بن العلاء بن عمار بن العريان، واسمه(@)(@@) عمرو بن عبد الله بن الحصين بن الحارث بن جلهم، أو جلهمة بن خزاعي،(@)(@@) ويقال: جلهم بن حجر بن خزاعي بن مالك بن مازن بن عمرو بن تميم بن PageV10P341(@)(@@) مر التميمي المازني البصري الإمام، أحد القراء السبعة اسمه زبان، وقيل:(@)(@@) العريان، وقيل: يحيى، وقيل: جزء.(@)(@@) قرأ القران على: سعيد بن جبير، ومجاهد، وعكرمة، ويحيى بن(@)(@@) يعمر، وعبد الله بن كثير، وحميد بن قيس الأعرج.(@)(@@) قرأ عليه: يحيى اليزيدي، وعبد الوارث التنوري، ومعاذ بن معاذ،(@)(@@) وهارون الأعور، ويونس بن حبيب، وعلي بن نصر الجهضمي، وعبيد(@)(@@) ابن عقيل الهلالي، وحماد بن زيد، وحسين الجعفي، والعباس بن(@)(@@) الفضل الأنصاري قاضي الموصل، وشجاع بن أبي نصر البلخي، وطائفة(@)(@@) سواهم.(@)(@@) وحدث عن: أنس بن مالك، وأبي رجاء العطاردي، وأبي صالح(@)(@@) ذكوان، والحسن، وابن سيرين، وعطاء بن أبي رباح، ونافع،(@)(@@) والزهري، وطائفة.(@)(@@) وعنه: حماد بن زيد، وشعبة، ومعتمر بن سليمان، ووكيع،(@)(@@) ويعلى بن عبيد، وأبو عمرو الشيباني (1) إسحاق بن مرار، وأبو أسامة،(@)(@@) وشبابة بن سوار، والأصمعي، ومؤرج بن عمرو السدوسي، وآخرون.(@)(@@) وثقه ابن معين، وقال أبو خيثمة: لا بأس به ولكنه لم يحفظ.(@)(@@) وقال شجاع بن أبي نصر: عن أبى عمرو بن العلاء قال: رآني سعيد بن(@)(@@) جبير وأنا جالس مع الشباب فقال: ما يجلسك مع الشباب عليك(@)(@@) بالشيوخ. وقال الأصمعي: سمعت أبا عمرو يقول: كنت رأسا(@)(@@) والحسن حي. وقال: نظرت في هذا العلم قبل أن أختق. وقال أبو(@)(@@) عمرو الشيباني: ما رأينا مثل أبي عمرو. وقال أبو العيناء: عن أبي(@)(@@) عبيدة قال: كان أبو عمرو أعلم الناس بالقرآن والعربية، والعرب PageV10P342(@)(@@) وأيامها، والشعر وأيام الناس، وكان ينزل خلف دار جعفر بن سليمان(@)(@@) الهاشمي، وكانت دفاتره ملء البيت إلى السقف ثم تنسك فأحرقها.(@)(@@) وقال فيه الفرزدف:(@)(@@) ما زلت أفتح أبوابا وأغلقها ... حتى أتيت أبا عمرو بن عمار(@)(@@) وروى أبو العيناء عن الأصمعي قال: قال لي أبو عمرو: لو تهيأ 
ms2252	(@)(@@) لي أن أفرغ ما في صدري من العلم في صدرك لفعلته، لقد حفظت في(@)(@@) علم القرآن أشياء لو كتبت ما قدر الأعمش على حملها، ولولا أن ليس(@)(@@) لي أن أقرأ إلا بما قرأ لقرأت حرف كذا وكذا ... وذكر حروفا. قال(@)(@@) أبو بكر بن مجاهد: كان أبو عمرو مقدما في عصره، عالما بالقراءة(@)(@@) ووجوهها، قدوة في العلم باللغة، إمام الناس في العربية، وكان مع(@)(@@) علمه باللغة وفقهه في العربية متمسكا بالآثار لايكاد يخالف في اختياره ما(@)(@@) جاء عن الأئمة قبله، متواضعا في علمه، قرأ على أهل الحجاز وسلك(@)(@@) في القراءة طريقتهم، ولم تزل العلماء في زمانه تعرف تقدمه وتأتم في(@)(@@) القراءة بمذاهبه، وكان حسن الاختيار سهل القراءة غير متكلف، يؤثر(@)(@@) التخفيف ما وجد إليه السبيل. وقال شجاع بن أبي نصر: رأيت النبي(@)(@@) - صلى الله عليه وسلم - في النوم فعرضت عليه أشياء من قراءة أبي عمرو فما رد علي(@)(@@) إلا حرفين. وروى نصر بن علي الجهضمي عن أبيه قال: قال لي شعبة:(@)(@@) انظر ما يقرأ به أبو عمرو ومما يختار لنفسه فاكتبه فإنه سيصير للناس(@)(@@) أستاذا. وقال إبراهيم الحربي: كان أهل العربية بالبصرة أصحاب هوى(@)(@@) إلا أربعة كانوا أصحاب سنة: أبو عمرو، والخليل، ويونس بن حبيب،(@)(@@) والأصمعي. وقال اليزيدي ومحمد بن حفص: تكلم عمرو بن عبيد في(@)(@@) الوعيد سنة، فقال أبو عمرو: إنك لألكن الفهم إذ صيرت الوعيد في(@)(@@) أعظم شيء مثله في أصغر شيء، فاعلم أن النهي عن الصغير(@)(@@) والكبير ليسا سواء، وإنما نهى الله عنهما ليتم حجته على خلقه، PageV10P343(@)(@@) ولئلا (1) يعدل عن أمره وطاعته، ووراء وعيده عفوه [ووسيع] (2)(@)(@@) كرمه. وأنشد أبو عمرو:(@)(@@) لا يرهب ابن العم ما عشت صولتي ... ولا أختشي من صولة المتهدد(@)(@@) وإني وإن أوعدته ووعدته ... لمخلف إيعادي ومنجز موعدي(@)(@@) فقال له عمرو بن عبيد: صدقت، إن العرب تمتدح بالوفاء بالوعد(@)(@@) دون الوعيد، وقد تمتدح بالوفاء بهما، ألم تسمع قول الشاعر:(@)(@@) إن أبا خالد لمجتمع الرأي ... شريف الأفعال والبيت(@)(@@) لا يخلف الوعد والوعيد ولا ... يبيت من ثأره على 
ms2253	 فوت(@)(@@) وقد وافق هذا قوله تعالى: {ونادى أصحاب الجنة أصحاب النار أن قد(@)(@@) وجدنا ما وعدنا ربنا حقا} (3) الآية. فقال أبو عمرو: قد وافق الأول أخبار(@)(@@) رسول الله - صلى الله عليه وسلم -، والحديث يفسر القرآن. قال الأصمعي: أنشدنا أبو(@)(@@) عمرو قال: سمعت أعرابيا ينشد وقد خرجت إلى ظاهر البصرة متفرجا(@)(@@) مما نالني من طلب الحجاج لي واستخفائي منه:(@)(@@) صبر النفس عند كل ملم ... إن في الصبر حيلة المحتال PageV10P344(@)(@@) لا تضيقن في الأمور فقد يك ... شف لأواؤها بغير احتيال(@)(@@) ربما تجزع النفوس من الأم ... ر له فرجة كحل العقال(@)(@@) قد تصاب الجبال في آخر الصف ... وينجو مقارع الأبطال(@)(@@) فقلت: ما وراءك يا أعرابي قال: مات الحجاج. فلم أدر بأيهما(@)(@@) أفرح بموت الحجاج أو بقوله "فرجة" لأني كنت أطلب شاهدا(@)(@@) لاختياري {إلا من اغترف غرفة بيده} (1). وعن أبي عمرو قال: قيل لرجل(@)(@@) عمر أتحب الموت؟ قال: لا. قيل: فلم وقد ذهب عنك شهوة النساء(@)(@@) والطعام؟ قال: أحب أن أسمع الأعاجيب. (2) وروى محمد بن تميم(@)(@@) النهشلي عن الأصمعي قال: قال أبو عمرو بن العلاء: كنت في ضيعتي(@)(@@) فاشتد علي الحر فبينا أنا أدور فيها وسط النهار إذ سمعت قائلا يقول:(@)(@@) وإن امرءا دنياه أكبر همه ... لمستمسك منها بحبل غرور(@)(@@) قال: فنقشته على خاتمي، فكان نقش خاتمه. وقال زكريا المنقري(@)(@@) عن الأصمعي قال: كان على خاتم أبي عمرو ... فذكر البيت. وقال(@)(@@) محمد بن صالح بن النطاح عن أبي عبيدة: خرج أبو عمرو بن العلاء(@)(@@) إلى دمشق إلى عبد الوهاب بن إبراهيم يجتديه، ثم رجع فمات(@)(@@) بالكوفة، فحدثني يونس أن أبا عمرو كان يغشى عليه ويفيق، فأفاق من(@)(@@) غشية له فإذا ابنه بشر يبكي فقال: ما يبكيك وقد أتت علي أربع وثمانون(@)(@@) سنة. وقال الأصمعي: عاش ستا وثمانين سنة. وقال ابن قتيبة: مات(@)(@@) سنة أربع وخمسين ومائة وقال خليفة: سنة سبع وخمسين(@)(@@) فيها مات أبو عمرو، وأبو سفيان (بن) (3) العلاء.(@)(@@) قلت: الصحيح سنة أربع قاله الأصمعي وغيره.(@)(@)PageV10P345(@)(@)(@@)(@@)(@@) $ 8329 - [د ق]: أبو عمرو (1) بن محمد بن 
ms2254	 حريث، وقيل: أبو محمد(@)(@@) ابن عمرو بن حريث، وقيل: أبو عمرو بن محمد بن عمرو بن حريث(@)(@@) العذري.(@)(@@) عن: جده عن أبي هريرة في سترة المصلي (2).(@)(@@) وعنه: إسماعيل بن أمية، وإبراهيم بن أبي يحيى.(@)(@@) قال الطحاوي: مجهول.(@)(@@)(@@)(@@) $$$ [ع]: أبو عمرو (3) الأوزاعي عبد الرحمن بن عمرو.(@)(@@)(@@)(@@) $ 8330 - [د]: أبو [عمرو] (4) (5) السدوسي، قيل: إنه سعيد بن سلمة(@)(@@) ابن، أبي الحسام.(@)(@@) عن: عبد الله بن أبي بكر بن حزم.(@)(@@) وعنه: أبو عامر العقدي.(@)(@@) قال أبو عبيد الآجري: سألت أبا داود عن سعيد بن سلمة بن أبي(@)(@@) الحسام فذكر كلاما ثم قال: روى عنه أبو عامر العقدي فقال: حدثنا أبو(@)(@@) عمرو المديني يعني: ابن أبي الحسام.(@)(@@)(@@)(@@) $ 8331 - [بخ]: أبو عمرو (6) السيباني الفلسطيني، ويقال: الحمصي،(@)(@@) زرعة والد يحيي، وعم الأوزاعي.(@)(@@) عن: عمر، وأبي الدرداء، وعقبة بن عامر، وأبي هريرة، وابن PageV10P346(@)(@@) عمر.(@)(@@) وعنه: ابنه، وحميد الحمصي، وعمر بن عبد الملك الفلسطيني.(@)(@@) ذكره ابن سميع فيمن أدرك الجاهلية، وذكره يعقوب الفسوي في(@)(@@) ثقات التابعين، وابن حبان.(@)(@@)(@@)(@@) $$$ [ع]: أبو عمرو (1) الشعبي عامر بن شراحيل.(@)(@@)(@@)(@@) $$$ [ع]: أبو عمرو (2) الشيباني الكوفي سعد بن إياس.(@)(@@) عن: ابن مسعود.(@)(@@)(@@)(@@) $ 8332 - [م]: أبو عمرو (3) الشيباني اللغوي إسحاق بن مرار النحوي(@)(@@) الكوفي، نزيل بغداد.(@)(@@) روى عن: أبي عمرو بن العلاء، وركن الشامي.(@)(@@) وعنه: أحمد بن حنبل، وأبو عبيد، وسلمة بن عاصم، وابنه(@)(@@) عمرو بن أبي عمرو.(@)(@@) قال الخطيب (4): قيل: إنه لم يكن شيبانيا، ولكنه كان مؤدبا لأولاد(@)(@@) ناس من بني شيبان فنسب إليهم، وكان من أعلم الناس باللغة موثقا فيما(@)(@@) يحكيه، جمع أشعار العرب ودونها، فحكى عن ولده قال: لما جمع(@)(@@) أبي أشعار العرب كانت نيفا وثمانين قبيلة، فكان كلما عمل منها قبيلة(@)(@@) وأخرجها إلى الناس كتب مصحفا وجعله في مسجد الكوفة حتى كتب PageV10P347(@)(@@) نيفا وثمانين مصحفا بخطه. وقال ثعلب (1): كان مع أبي عمرو(@)(@@) الشيباني من العلم والسماع أضعاف ما كان مع أبي عبيدة، ولم يكن في(@)(@@) أهل العلم مثل أبي عبيدة في السماع والعلم. وقال إبراهيم نفطويه وغيره(@)(@@) عن ثعلب قال: [دخل] (2) أبو 
ms2255	 عمرو الشيباني البادية، ومعه دستجتان(@)(@@) حبرا فما خرج حتى أفناهما يكتب سماعه من العرب إلى أن قال:(@)(@@) والذي قصر به عند العامة أنه كان مشتهرا بشرب النبيذ.(@)(@@) قال أبو جعفر أحمد بن يعقوب الأصبهاني: سمع الناس من عمرو بن(@)(@@) أبي عمرو الشيباني عن أبيه سنين، وأبوه أبو عمرو في الأحياء. وقال أبو(@)(@@) بكر بن الأنباري: كان يقال له: أبو عمرو صاحب ديوان اللغة والشعر،(@)(@@) وكان خيرا فاضلا صدوقا. وقال عبد الله بن أحمد بن حنبل: كان أبي(@)(@@) يلزم مجالس أبي عمرو ويكتب أماليه. وقال أحمد بن حنجل: مات سنة(@)(@@) عشر ومائتين. وقال أحمد: سألت أبا عمرو الشيباني عن أخنع فقال:(@)(@@) أوضع. رواه مسلم (3) في تفسير "أخنع اسم عند الله رجل تسمى بملك(@)(@@) الأملاك".(@)(@@)(@@)(@@) $$$ [س]: أبو عمرو (4) القاص الملائي.(@)(@@) عن: أبيه، عن أبي هريرة.(@)(@@) وعنه: سليمان التيمي.(@)(@@) محمد بن عبد الرحمن بن خالد.(@)(@@)(@@)(@@) $$$ [س ق]: أبو عمرو (5) الندبي بشر بن حرب.(@)(@@)(@@)(@@) $$$ [خ م د س]: أبو عمرو (5) ذكوان مولى عائشة.(@)(@)PageV10P348(@)(@)(@@)(@@)(@@) $ 8333 - [س]: أبو عمرو (1).(@)(@@) عن: رجل.(@)(@@) فيه خلاف مذكور في ترجمة عبد الله بن حفص.(@)(@@)(@@)(@@) $ 8334 - [د]: أبو عمران (1) الأنصاري مولى أم الدرداء وقائدها،(@)(@@) سليمان وقيل: سليم بن عبد الله.(@)(@@) عن: مولاته أم الدرداء، وأبي الدرداء، وعبادة بن الصامت، وذي(@)(@@) الأصابع وله صحبة، وجابر بن عبد الله، وأبي سلام الأسود.(@)(@@) وعنه: ثعلبة بن مسلم، وعاصم بن رجاء بن حيوة، وفروة بن(@)(@@) مجاهد، ومعاوية بن صالح، وجماعة.(@)(@@) قال أبو حازم: صالح الحديث.(@)(@@)(@@)(@@) $$$ [ع]: أبو عمران (2) الجوني عبد الملك بن حبيب.(@)(@@)(@@)(@@) $ 8335 - أبو عمران (2) الجوني شيخ متأخر بصري، صاحب حديث،(@)(@@) اسمه موسى بن سهل بن عبد الحميد، حدث ببغداد.(@)(@@) عن: عبد الواحد بن غياث، ومحمد بن رمح المصري، وهشام(@)(@@) ابن عمار، وطبقتهم.(@)(@@) وعنه: دعلج، والطبراني، وأبو بكر الإسماعيلي، وعلي بن عمر(@)(@@) الحربي، وآخرون.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $ 8336 - [س]: أبو عمرة (3) الأنصاري صحابي من بني النجار.(@)(@)PageV10P349(@)(@)(@@) له حديث (1) في بركة الطعام في بعض غزواته - صلى الله عليه وسلم - رواه عنه ابنه عبد(@)(@@) الرحمن.(@)(@@) قال إبراهيم 
ms2256	 بن المنذر: قتل مع علي بصفين.(@)(@@)(@@)(@@) $ 8337 - [ت س]: أبو عمرة (2) الأنصاري، وقيل: ابن أبي عمرة (م د(@)(@@) ت س ق)، وقيل: عبد الرحمن بن أبي عمرة.(@)(@@) عن: زيد بن خالد [حديث] (3) "ألا أخبركم بخير الشهداء" (4).(@)(@@) وعنه: عبد الله بن عمرو بن عثمان بن عفان.(@)(@@)(@@)(@@) $ 8338 - [د س ق]: أبو عمرة (5).(@)(@@) عن: مولاه زيد بن خالد الجهني.(@)(@@) وعنه: محمد بن يحيى بن حبان.(@)(@@) قلت: هو الذي قبله.(@)(@@)(@@)(@@) $ 8339 - [د]: أبو عمرة (6).(@)(@@) عن: أبيه.(@)(@@) وعنه: المسعودي، وقيل: عن رجل عنه.(@)(@@)(@@)(@@) $ 8340 - [د س ق]: أبو عمير (7) أكبر ولد أنس بن مالك.(@)(@)PageV10P350(@)(@)(@@) عن: عمومة له شى "رؤية الهلال" (1).(@)(@@) وعنه: أبو بشر.(@)(@@) يقال: اسمه عبد الله.(@)(@@)(@@)(@@) $$$ [4]: أبو عمير (2) الحارث بن عمير البصري.(@)(@@)(@@)(@@) $$$ [ع]: أبو العميس (2) عتبة بن عبد الله.(@)(@@)(@@)(@@) $$$ [ت]: أبو العنبس (3) الكوفي عبد الله بن صهبان.(@)(@@)(@@)(@@) $ 8341 - [بخ]: أبو العنبس (4) الثقفي محمد بن عبد الله بن قارب،(@)(@@) وقيل: محمد بن عبد الرحمن بن قارب.(@)(@@) عن: عبد الله بن عمرو، وغيره.(@)(@@) وعنه: عثمان بن المغيرة، وعبد الملك بن عمير، وعمر بن ذر،(@)(@@) وغيرهم.(@)(@@)(@@)(@@) $ 8342 - [د]: أبو العنبس (5) العدوي الكوفي، جد يونس بن بكير لأمه،(@)(@@) اسمه الحارث بن (عبيد) (6) بن كعب.(@)(@@) عن: الأغر أبي مسلم، وأبي العدبس الأصغر، والقاسم بن(@)(@@) محمد، وجماعة.(@)(@)PageV10P351(@)(@)(@@) وعنه: مسعر، وشعبة، وإسرائيل، وأبو عوانة.(@)(@@)(@@)(@@) $ 8343 - [د س]: أبو العنبس (1) الكوفي الأكبر، يقال: عبد الله بن(@)(@@) مروان.(@)(@@) عن: أبي الشعثاء جابر بن زيد.(@)(@@) وعنه: شعبة حديث "جعل فداء أهل بدر أربعمائة" (2).(@)(@@)(@@)(@@) $$$ [بخ مد]: أبو العنبس (3) الكوفي الملائي الأصغر سعيد بن كثير.(@)(@@) عن: أبيه.(@)(@@)(@@)(@@) $ 8344 - أبو العنبس (4) النخعي الكوفي (الأوسط) (5) عمرو بن(@)(@@) مروان.(@)(@@) عن: أبي وائل، وإبراهيم النخعي، والشعبي.(@)(@@) وعنه: حفص بن غياث، ووكيع، وجعفر بن عون، وغيرهم.(@)(@@) ذكر للتمييز، وذكر الثلاثة أبو زرعة وغيره.(@)(@@)(@@)(@@) $ 8345 - [ق]: أبو عنبة (6) الخولاني، مختلف في صحبته اسمه عبد الله(@)(@@) ابن عنبة، وقيل: عمارة، نزل حمص.(@)(@@) أسلم [في] (7) عهد النبي - صلى الله عليه وسلم -، وقيل: صلى معه القبلتين، PageV10P352(@)(@@) وصحب معاذا، وكان أعمى وقد شهد خطبة عمر 
ms2257	 بالجابية، وله عن(@)(@@) النبي - صلى الله عليه وسلم - حديث أو حديثان.(@)(@@) وعنه: أبو الزاهرية حدير بن كريب، و [بكر] (1) بن زرعة،(@)(@@) وطليق بن سمير، ولقمان بن عامر، ومحمد بن زياد الألهاني،(@)(@@) وجماعة.(@)(@@) قال هشام بن عمار: حدثنا الجراح بن مليح، ثنا بكر بن زرعة(@)(@@) سمعت أبا عنبة الخولاني- وكان ممن صلى القبلتين مع رسول الله - صلى الله عليه وسلم -،(@)(@@) وأكل الدم في الجاهلية - قال: سمعت رسول الله - صلى الله عليه وسلم - يقول: "لا يزال(@)(@@) الله يغرس في هذا الدين بغرس يستعملهم بطاعته" (2). قال يحيى بن(@)(@@) معين: في حديثه هذا أهل الشام يقولون: إنه من كبار التابعين، وأنكروا(@)(@@) أن له صحبة وأنه له مددي من أهل اليمن أمدوا بهم في اليرموك. وقال(@)(@@) بقية عن محمد بن زياد: أسلم أبو عنبة والنبي - صلى الله عليه وسلم - حي. وروى لقمان(@)(@@) ابن عامر عن أبي عنبة الخولاني قال: رب كلمة خير من(@)(@@) إعطاء مال. وقال أبو مطيع الأطرابلسي، عن محمد بن زياد، عن أبي(@)(@@) عنبة قال: إن لله آنية في الأرض وهي قلوب عباده الصالحة، فأحبها(@)(@@) إليه أرحمها وألينها. وقال صاحب تاريخ حمص: توفي أبو عنبة في(@)(@@) خلافة عبد الملك. وأما خليفة [بن خياط] (3) فقال: مات أبو عنبة سنة(@)(@@) ثمان عشرة ومائة. وهذا وهم إلا أن يكون آخر كنيته أبو عنبة متأخر.(@)(@@)(@@)(@@) $$$ [بخ]: أبو العوام (4) الباهلي عبد العزيز بن الربيع.(@)(@)PageV10P353(@)(@)(@@) عن: أبي الزبير.(@)(@@)(@@)(@@) $$$ [د سي ق]: أبو العوام (1) الجزار فائد بن كيسان.(@)(@@)(@@)(@@) $$$ [خت 4]: أبو العوام (2) القطان عمران بن داور.(@)(@@)(@@)(@@) $$$ [ع]: أبو عوانة (3) الوضاح بن عبد الله.(@)(@@)(@@)(@@) $ 8346 - [س]: أبو عون (4) الأنصاري الشامي الأعور، يقال: عبد الله(@)(@@) ابن أبي عبد الله.(@)(@@) عن: أبي إدريس الخولاني.(@)(@@) وعنه: أرطاة بن المنذر، وثور بن يزيد.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [خ م د ت س]: أبو عون (5) الثقفي محمد بن عبيد الله.(@)(@@)(@@)(@@) $$$ [ع]: أبو العلاء (6) العامري يزيد بن عبد الله بن الشخير.(@)(@@)(@@)(@@) $$$ [س]: أبو العلاء (7) بن اللجلاج في ترجمة حصين بن اللجلاج.(@)(@@)(@@)(@@) $$$ [4]: أبو العلاء (8) داود بن عبد الله الأودي. 
ms2258	(@)(@@)(@@)(@@) $$$ [ت ق]: أبو العلاء (8) الإسكاف سعد بن طريف، واسمه أشهر.(@)(@)PageV10P354(@)(@)(@@)(@@)(@@) $$$ [ت]: أبو العلاء (1) الخفاف خالد بن طهمان.(@)(@@)(@@)(@@) $$$ [بخ 4]: أبو العلاء (2) الشامي برد بن سنان.(@)(@@)(@@)(@@) $ 8347 - [ت ق]: أبو العلاء (3) الشامي.(@)(@@) عن: أبي أمامة.(@)(@@) وعنه: أصبغ بن زيد. لا يعرف.(@)(@@)(@@)(@@) $$$ [4]: أبو العلاء (4) هلال بن خباب، والاسم أشهر.(@)(@@)(@@)(@@) $$$ [د ت س]: أبو العلاء (5) القصاب أيوب بن مسكين.(@)(@@)(@@)(@@) $$$ [م د س]: أبو العلاء (5) القيسي حيان بن عمير.(@)(@@)(@@)(@@) $ 8348 - [بخ س]: أبو العلانية (6) مسلم.(@)(@@) عن: أبي سعيد الخدري.(@)(@@) وعنه: ابن سيرين، وعبد الكريم أبو أمية.(@)(@@) وثقه أبو داود.(@)(@@) [قلت:(@)(@@)(@@)(@@) $ 8349 - أبو العلانية (7).(@)(@@) عن: ابن أبي أوفى.(@)(@@) اسمه محمد بن أعين.(@)(@)PageV10P355(@)(@)(@@) وعنه: يحيى القطان، وعبد الرحمن بن مهدي، وطالوت بن(@)(@@) عباد.(@)(@@) صالح الحديث وقع لنا حديثه عاليا] (1).(@)(@@)(@@)(@@) $ 8350 - [د س]: أبو العياش (2) الزرقي الأنصاري له صحبة واسمه زيد(@)(@@) ابن الصامت، وقيل: عبيد، وقيل: عبد الرحمن بن معاوية، وهو والد(@)(@@) النعمان.(@)(@@) روى عنه: مجاهد، وأبو صالح الزيات إن كان محفوظا.(@)(@@) يقال: مات بعد الأربعين في خلافة معاوية، حديثه في "صلاة(@)(@@) الخوف" (3).(@)(@@)(@@)(@@) $ 8351 - [د سى ق]: أبو عياش (4)، وقيل: ابن أبى عياش، . وقيل:(@)(@@) ابن عياش.(@)(@@) عن: النبي - صلى الله عليه وسلم - "من قال إذا أصبح: لا إله إلا الله وحده لا شريك(@)(@@) له ... " (5).(@)(@@) روى عنه: أبو صالح ذكوان، وعند النسائي عن أبي عياش الزرقي.(@)(@@)(@@)(@@) $$$ [4]: أبو عياش (6) زيد بن عياش الزرقي، وقيل: المخزومي.(@)(@@) عن: سعد بن أبي وقاص.(@)(@)PageV10P356(@)(@)(@@) وعنه: عبد الله بن يزيد مولى الأسود.(@)(@@)(@@)(@@) $ 8352 - [د ق]: أبو عياش (1) المعافري المصري.(@)(@@) عن: علي، وأبي هريرة وجابر، وسهل بن سعد.(@)(@@) وعنه: يزيد بن أبي حبيب، وخالد بن أبي عمران(@)(@@)(@@)(@@) $$$ [خ م د س ق]: أبو عياض (2) العنسي عمرو بن الأسود، واسمه(@)(@@) أشهر.(@)(@@)(@@)(@@) $ 8353 - [د س]: أبو عياض (3).(@)(@@) عن: ابن مسعود، وعبد الرحمن بن الحارث بن هشام.(@)(@@) وعنه: عبد ربه شيخ قتادة.(@)(@@)(@@)(@@) $ 8354 - [بخ م]: أبو عيسى (4) الأسواري البصري.(@)(@@) عن: أبي سعيد، وابن عمر، وأبي العالية.(@)(@@) وعنه: قتادة، وثابت، وعاصم الأحول.(@)(@@) وثقه الطبراني، وغيره.(@)(@@)(@@)(@@) $ 8355 - [د]: أبو عيسى (5) الخراساني 
ms2259	 التميمي يقال: سليمان، ويقال:(@)(@@) محمد بن عبد الرحمن، وقيل: محمد بن القاسم، وقع إلى مصر.(@)(@@) وروى عن: الضحاك، وعبد الله بن القاسم، وغيرهما.(@)(@@) وعنه: سعيد بن أبي أيوب، وحيوة بن شريح، وابن لهيعة،(@)(@@) وجماعة.(@)(@@) في الثقات لابن حبان.(@)(@)PageV10P357(@)(@)(@@)(@@)(@@) || حرف الغين(@)(@@)(@@)(@@) $ 8356 - [د ت ق]: أبو غالب (1) الباهلي، مولاهم البصري الخياط،(@)(@@) نافع أو رافع.(@)(@@) عن: أنس، والعلاء بن زياد.(@)(@@) وعنه: سلام بن أبي الصهباء، وهمام بن يحيى، وعبد الوارث.(@)(@@) قال ابن معين: صالح.(@)(@@)(@@)(@@) $$$ [ق]: أبو غالب (2) ديلم بن غزوان، واسمه أشهر.(@)(@@)(@@)(@@) $ 8357 - [بخ د ت ق]: أبو غالب (3) صاحب أبي أمامة بصري،(@)(@@) ويقال: أصبهاني حزور، وقيل: نافع، وقيل: سعيد، واختلف في ولائه(@)(@@) فقيل: مولى خالد بن عبد الله القسري، وقيل: مولى خالد بن عبد الله بن(@)(@@) أسيد القرشي، وقيل: غير ذلك.(@)(@@) عن: أبي أمامة، وأنس بن مالك، وأم الدرداء.(@)(@@) وعنه: مالك بن دينار، وعبد العزيز بن صهيب، وهما من أقرانه،(@)(@@) وابن شوذب، وسلام بن مسكين، وحماد بن سلمة، وحسين بن(@)(@@) واقد، وسلم بن زرير، وحجاج بن دينار، وسفيان بن عيينة، وخلق.(@)(@@) قال ابن معين: صالح الحديث. وقال أبو حاتم الرازي: ليس(@)(@@) بالقوي. وقال الدارقطني: ثقة. وأما النسائي فقال: ضعيف. وقال(@)(@@) ابن عدي: أرجو أنه لا بأس به. وقد روى له الترمذي، وصحح PageV10P358(@)(@@) حديثه.(@)(@@)(@@)(@@) $ 8358 - [ق]: أبو غالب (1) نافع، وقيل: رافع.(@)(@@) عن: أبي سعيد الخدري في "حريم البئر" (2).(@)(@@) وعنه: ثابت بن محمد العبدي. فلعله الباهلي.(@)(@@)(@@)(@@) $ 8359 - [سي]: أبو غالب (3).(@)(@@) عن: ابن عمر.(@)(@@) وعنه: نهشل الضبي، وأبو سنان ضرار بن مرة.(@)(@@)(@@)(@@) $$$ [د س]: أبو غانم (4) المروزي يونس بن نافع.(@)(@@) عن: كثير بن زياد.(@)(@@) وعنه: ابن المبارك.(@)(@@)(@@)(@@) $$$ أبو غرارة (5) محمد بن عبد الرحمن المليكي.(@)(@@)(@@)(@@) $$$ [س ق]: أبو الغريف (5) الهمداني عبيد الله بن خليفة.(@)(@@)(@@)(@@) $$$ أبو غسان (5) يوسف بن موسى التستري.(@)(@@)(@@)(@@) $$$ [م د ق]: أبو غسان (5) زنيج محمد بن عمرو الرازي.(@)(@@) *ع: أبو غسان (6) العنبري يحيى بن كثير.(@)(@@)(@@)(@@) $$$ [خ]: أبو غسان (6) الكناني محمد بن يحيى.(@)(@)PageV10P359(@)(@)(@@)(@@)(@@) $$$ [ع]: أبو غسان (1) المدني محمد بن مطرف.(@)(@@)(@@)(@@) $$$ [م د]: أبو غسان 
ms2260	 (2) المسمعي مالك بن عبد الواحد.(@)(@@)(@@)(@@) $$$ [ع]: أبو غسان (3) النهدي مالك بن إسماعيل.(@)(@@)(@@)(@@) $$$ [ي د س]: أبو الغصن (3) المدني ثابت بن قيس.(@)(@@)(@@)(@@) $ 8360 - [د]: أبو الغصن (4).(@)(@@) عن: صخر بن إسحاق.(@)(@@) وعنه: بشر بن عمر الزهراني.(@)(@@) قال أبو حازم: أبو الغصن شامي، سمع شداد بن أوس، وعنه(@)(@@) يحيى بن حسان البكري. كذا في الكمال، وشيخ الزهراني هو ثابت(@)(@@) ابن قيس، وأما صاحب شداد فتابعي قديم.(@)(@@)(@@)(@@) $ 8361 - [م د س ق]: أبو غطفان (5) بن طريف المري، ويقال: ابن(@)(@@) مالك، حجازي، قيل: اسمه سعد.(@)(@@) عن: خزيمة بن ثابت، وسعيد بن زيد، وأبي رافع، وأبي هريرة،(@)(@@) وابن عباس.(@)(@@) وعنه: إسماعيل بن أمية، وعبد الله بن [عبيد الله] (6) بن أبي(@)(@@) رافع، وعمر بن حمزة، وقارظ بن شيبة، وجماعة.(@)(@)PageV10P360(@)(@)(@@) قال ابن سعد: له دار بالثنية عند دار عمر بن عبد العزيز، لزم(@)(@@) عثمان، وكتب له، وكتب أيضا لمروان. وقال النسائي: أبو غطفان(@)(@@) ثقة.(@)(@@)(@@)(@@) $ 8362 - [د ت ق]: أبو غطيف (1) الهذلي، ويقال: غطيف، ويقال:(@)(@@) غضيف.(@)(@@) عن: ابن عمر.(@)(@@) وعنه: عبد الرحمن بن زياد الأفريقي، وبكر بن سوادة.(@)(@@)(@@)(@@) $$$ [بخ د ت س]: أبو غفار (2) المثنى بن سعد أو ابن سعيد.(@)(@@)(@@)(@@) $ 8363 - [ق]: أبو الغوث (3) بن الحصين الخثعمي له صحبة ورواية.(@)(@@) وعنه: عطاء الخراساني.(@)(@@)(@@)(@@) $$$ [ع]: أبو غلاب (3) يونس بن جبير.(@)(@@)(@@)(@@) $$$ [ع]: أبو الغيث (3) سالم مولى ابن مطيع.(@)(@@)(@@)(@@) $$$ [فق]: أبو الغيث (4) عطية بن سليمان.(@)(@)PageV10P361(@)(@)(@@)(@@)(@@) || حرف الفاء(@)(@@)(@@)(@@) $$$ [ت ق]: أبو فاختة (1) والد ثوير، سعيد بن علاقة.(@)(@@)(@@)(@@) $ 8364 - [د س ق]: أبو فاطمة (2) الليثي، ويقال: الدوسي، له صحبة،(@)(@@) أنيس ويقال: عبد الله بن أنيس.(@)(@@) شهد فتح مصر واختط بها دارا ثم سكن الشام.(@)(@@) روى عنه: كثير بن مرة، وكثير بن فليت، وأبو عبد الرحمن(@)(@@) الحبلي. قال الفضل بن غسان الغلابي: أبو فاطمة أزدي، قبره بالشام(@)(@@) إلى جنب قبر فضالة بن عبيد.(@)(@@)(@@)(@@) $ 8365 - [د س]: أبو فراس (3) النهدي.(@)(@@) عن: عمر.(@)(@@) وعنه: أبو نضرة العبدي.(@)(@@) قيل: اسمه الربيع بن زياد. ولا يصح.(@)(@@)(@@)(@@) $$$ [م ق]: أبو فراس (4) مولى عبد الله بن عمرو، يزيد بن رباح المصري. 