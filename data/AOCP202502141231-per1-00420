ms406	 به ناخوشی و سر گردانی %~% از عمر گذشت، آنچه به کاری آمد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 4082 کشتی بقا، رسید بر ساحل عمر %~% حل ناشده، هیچ حرف از مشکل عمر(@)(@@) (@@) یک گام نرفته، شد به سر منزل عمر %~% احسنت، زهی حاصل بیحاصل عمر!(@)(@@) (@@) 4083 دل، در غم تونقش امان جست ونیافت %~% از محنت تو، راحت جان جست و نیافت(@)(@@) (@@) صد لقمهآ زهر یافت، در گام نخست %~% یکساعته کام، در جهان جست و نیافت!(@)(@@) (@@) 4084 دم با که زنم؟ که در جهان همدم نیست %~% غم با که خورم؟ که هیچ کس محرم نیست!(@)(@@) (@@) گفتم که مگر بیابم آسایش را %~% چیزی چه طلب کنم؟ که در عالم نیست!(@)(@@) ~~4085 دلها، همه از گردش گردون بگرفتجانها، همه غم درون و بیرون بگرفت(@)(@@) (@@) هریک، به نشاط بگذراندند دمی %~% %~% چون نوبت ما بود، جهان خون بگرفت!(@)(@@) ~~4086 صبحی به مراد کس، به شامی نرسیدتا از غم ومحنتش، پیامی نرسید(@)(@@) ~~و اندر دهن دهر، که پر باد ززهرالا که زبان، کسی به کامی نرسید!(@)(@@) (@@) 085) سیرم، ز حیات محنت آکندهآ خویش %~% وز ریزهآ روزی پراکندهآ خویش(@)(@@) (@@) صاحبثظری کجاست؟ تا بنمایم %~% صد گریهآ زار، زیریک خندهآ خویش!(@)(@)PageV01P608(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0612.jpg)(@)(@)(@@)(@@)(@@) | خی(@)(@@) (@@) 4088 عمری است، که با یار نخفتیم شبی %~% با او، غم و درد دل نگفتیم شبی(@)(@@) (@@) از پای چرا در افتد، این چرخ کبود؟ %~% گر پنج حریف با هم افتیم شبی.(@)(@@)(@@)(@@) | ظهیر(@)(@@) ~~4089 دوش، این خردم نصیحتی پنهان گفت در گوش دلم گفت و، دلم با جان گفت:(@)(@@) (@@) ما کس غم دل مگوی، زیرا که نماند %~% یک دوست، که با او غم دل بتوان گرفت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 4090 در ده، می لعل لاله گون صافی %~% بگشای ز حلق شیشه، خون صافی(@)(@@) (@@) کامروز، برون زجام می نیست مرا %~% وله %~% یک دوست، که دارد اندرون صافی!(@)(@@) ~~ای چرخ، نه بر مراد من می گردی 4091 چون نیست، در این زمانهآ عهد شکن(@)(@@) 4091 آنم، که فلک به چشم من خوار آید %~% وله %~% از گردش 
ms407	 او، مرا چه تیمار(@)(@@) آید %~% وز تو گله کردنم، همی عار آید! %~% یک دوست، که عاقبت نگردد دشمن(@)(@@) (@@) تنهایی را کنون نهادم گردن %~% باخو یشتنم خوش است، زین پس من ومن!(@)(@@)(@@)(@@) | خاقانی(@)(@@) ~~4092 عالم، زلباس راحتم عریان یافت هر شام که بگذشت، مرا غمگین دید(@)(@@) %~% هر صبح که خندید، مرا گریان یافت! %~% با چشم پر آب و [با] دل بریان یافت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 409 آزاده دلان، گوش به مالش دادند %~% وز حسرت و غم، سینه به نالش دادند(@)(@@) (@@) یشت هنر، آن روز شکستند درست %~% کاین بیهنران، پشت به بالش دادند!(@)(@@)(@@)(@@) | وله(@)(@@) ~~4095 غمها دارم، زقصهآ مشکل خویس(@)(@@) ~~افسوس، که زیر خاک می باید شد PageV01P609(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0613.jpg)(@)(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) 4.96 گر کار فلک، به عدل سنجیده بدی %~% احوال فلک، جمله پسندیده بدی(@)(@@) (@@) ورعدل بدی به کارها در گردون %~% کی خاطر اهل فضل رنجیده بدی؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 4.97 هر یک چندی، یکی بر آید که منم %~% با نعمت و سیم و زر، گزاید که منم(@)(@@) (@@) چون کارک او نظام گیرد، روزی %~% ناگه اجل از کمین در آید که: منم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 4098 بر شاخ امید، اگر بری یافتمی %~% هم رشتهآ خویش را سری یافتمی(@)(@@) (@@) تا چند زتنگنای زندان وجود %~% ای کاش، سوی عدم دری یافتمی!(@)(@@)(@@)(@@) | وله(@)(@@) ~~4099 عمری است مرا تیره و، کاری است نه راست محنت همه افزوده و، راحت کم و کاست(@)(@@) (@@) شکر ایزد را، که آنچه اسباب بلاست %~% ما را زکسی دگر، نمی باید خواست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 4100 عمری نه به عاقلی، به پایان بردم %~% وز عمر نماند صافیی، جز دردم(@)(@@) (@@) هرگز نفسی به کام دل نشمردم %~% فی الجمله، ز دست زندگانی مردم!(@)(@@) (@@) 4101 ای دل، مطلب زدیگران مرهم خویش %~% خود باش به هر درد دلی، محرم خویش(@)(@@) (@@) تنها بنشین و، خود همی خور غم خویش %~% ور همدمت آرزو کند، هم دم خویش!(@)(@@)(@@)(@@) | باخرزی(@)(@@) (@@) 4102 ای دل، پس از این بی رخ زیباخو کن %~% بی غمزه و بی زلف چلیپا خو کن(@)(@@) (@@) چون 
ms408	 می بینی، که از کست روزی نیست %~% بنشین پس کار خویش و، تنها خوکن(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 4103 چون نیست به جنس من، مرا دسترسی %~% ناجنس نخواهم که ببینم، نفسی(@)(@@) (@@) هر چند که با غمم زتنهایی خویش %~% تنهایی به، زیار ناجنس بسی!(@)(@)PageV01P610(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0614.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~4104 ای صبر، برو که غم به سربرده نهای در باقی کن که سیر خود خورده (؟) نه ای(@)(@@) (@@) وی دولت مرد ریگ، یک ره سر خویش %~% وله %~% از خواب گران بر آر، اگر مرده نه ای!(@)(@@) ~~4104 ای عشق، دل مرا وطن ساختهایوی هجر، کنار من چمن ساختهای(@)(@@) ~~هر آفت و محنتی که در عالم هست ای چرخ، مگر برای من ساخته ای؟(@)(@@) ~~4100 هر ذره، که در هوا و در هامون است مغز سر کیقباد و افریدون است(@)(@@) (@@) ازخیره کشی، که گردش گردون است %~% این عالم خاک نیست، طشتی خون است(@)(@@)(@@)(@@) | خ(@)(@@) ~~4101 از گردش چرخ بیخرد می ترسم زان روی، که بر کس اعتمادی بنماند(@)(@@) %~% از همرهی سایهآ خود می ترسم! %~% وز هر حالی، به نیک و بد می ترسم(@)(@@)(@@)(@@) | مسعود(@)(@@) (@@) 4108 بس جور که من ز جور جانان بردم %~% بس دست، که از غصه به دندان بردم(@)(@@) ~~س غصه، که آشکار و پنهان بردمتا، عمر عزیز را به پایان بردم!(@)(@@) (@@) 4109 از طبع، چو آب چشم تر می بینم %~% وزتیغ زبان، آفت سر می بینم(@)(@@) (@@) از ننگ، سزد گر نبرم نام هنر %~% زین بیهنری، که از هنر می بینم(@)(@@)(@@)(@@) | (@)(@@) (@@) 4110 جان من مستمند، فرسود زچرخ %~% یک روز، دلم نبود خشنود زچرخ(@)(@@) (@@) تا عمر مرا، به سرنیاورد فلک %~% ننشست زپا، دمی نیاسود زچرخ!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 11) ای دل، زجهان سفله تمییز مجوی %~% آسایش از این جهان ناچیز مجوی(@)(@@) (@@) آسایش را از این جهان، بسیاران %~% جستند و نیافتند، تو نیز مجوی!(@)(@)PageV01P611(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0615.jpg)(@)(@)(@@) (@@) 4112 آن سنبل گل پرست گلگون چون است؟ %~% وان خال وخط شاهد موزون چون است؟(@)(@@) (@@) از دار بقا، فتاده در خاک فنا %~% گویی تن 
ms409	 نازنینش، اکنون چون است؟(@)(@@)(@@)(@@) | اخر(@)(@@) (@@) 4113 بر دهر مکن تکیه، که لطفش قهر است %~% مستان زجهان لقمه، که نوشش زهر است(@)(@@) (@@) داماد عروس چرخ بدمهر، مشو %~% کاین زانیه را، خون عزیزان مهر است!(@)(@@)(@@)(@@) | اخر(@)(@@) (@@) 4114 یاری، که چوجان ودل وتن داشتمش %~% چون جان عزیز خویشتن، داشتمش(@)(@@) (@@) بر بود زمن زمانه، در خاکش کرد %~% ای خاک، چنان دار که من داشتمش!(@)(@@) (@@) 4115 یارب، گل سیراب جمالش چون است؟ %~% و آن عارض خورشید مثالش چون استم(@)(@@) (@@) ز آن تن، که زبار پیرهن رنجیدی %~% در خاک، بگویید که حالش چون است؟(@)(@@)(@@)(@@) | عزیز(@)(@@) (@@) 4116 لاف از توزند، بلبل غمخوار هنوز %~% بوی تو دهد، صبا به گلزار هنوز(@)(@@) (@@) وان خانه، که اندر او نهادی قدمی %~% بوی تو دمد، زان در و دیوار هنوز!(@)(@@) (@@) 4117 ای سوخته آتش غمت خرمن صبر %~% بدرید دل از مرگ تو، پیراهن صبر(@)(@@) ~~در ماتم تو، چو نالهمان سود نداشت ناچار، زدیم دست در دامن صبر(@)(@@) ~~4118 ای کرده غم تو در دل تنگ اثر نگذاشته اشک بر رخم رنگ اثر(@)(@@) (@@) یم است، که از غصه بسوزد جگرم %~% مرگ تو، که کرد بر دل سنگ اثر(@)(@@)(@@)(@@) | شیخ عبداه(@)(@@) (@@) 11، ای صبح، بر آن نگار مهوش بگری %~% وی دیده، بر آن زلف مشوش بگری(@)(@@) (@@) جون صبح سپید کار، بیهوده مخند %~% چون ابر سیه گلیم، خوش خوش بگری!(@)(@@) ~~وان روی، که تازه تر زگل بود بسی 120) آن چشم پر از نرگس موزون چون(@)(@@) است؟ %~% وان لعل لب پردر مکنون چون است؟ %~% با خاک برآمیخته، اکنون چون است؟(@)(@)PageV01P612(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0616.jpg)(@)(@)(@@) ~~4121 دردا، که دلارام دلم بیش نزیست و رفت و، به زیر خاک در منزل کرد(@)(@@) %~% وز مردن او، چشم جهانی بگریست %~% ای خاک، چه دانی که هم آغوش توکیست!(@)(@@) ~~412 آتش زدلم دم اندر افلاک نهاد گردون، همه غم بر من غمناک نهاد(@)(@@) (@@) دری، که چوجان عزیز می داشتمش %~% اوله %~% بر بود زمن زمانه، برخاک نهاد(@)(@@) ~~من زنده نیم، زنده تویی در فردوس 412 
ms410	 ای گشته زمانه تیره در ماتم تو(@)(@@) %~% تو کشته نه ای، کشته منم در غم تو! %~% بی توچه کنم، چگونه گیرم کم تو؟(@)(@@) (@@) 412 گیرم که بیابم به جهان، عمر دراز %~% و %~% وز عمر عزیز خویشتن، بینم ناز(@)(@@) (@@) آن عمر گذشته را، کجا در یابم؟ %~% یاران قدیم را، کجا یابم باز؟(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 4124 این صاحب افسر و نگین دیر زیاد %~% وین سایهآ حق، شاه زمین دیر زیاد(@)(@@) (@@) آن کس که گذشت، خاک خوش باد بر او %~% شاه شروان، علاء دین دیر زیاد!(@)(@@) این قصیده در مدح(@)(@@) خدایگان عالم خاقان اکبر اکرم شروانشاه معظم(@)(@@) خلد الله سلطانه گوید، وذکر سفینه کند(@)(@@) ~~نگارینا، چو تویاری که را باشد، که را باشد؟(@)(@@)(@@)(@@) | وتوغمخوار و دلداری کجا باشد، کجا باشد؟(@)(@@) ~~عو تو غمخوار و دلداری، چو تویار وفاداری(@)(@@)(@@)(@@) | نه بر روی زمین باشد، نه بر اوج سما باشد(@)(@@) ~~ز مستی چشم مخمورت به غمزه ریخت خون من(@)(@@)(@@)(@@) | نریزد خون من زین سان اگر هشیار وا باشد(@)(@@) ~~کشم بر تن بلای تو، زدل جویم رضای تو(@)(@@)(@@)(@@) | بان دارم وفای تو، اگر در تو وفا باشد PageV01P613(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0617.jpg)(@)(@)(@@) ~~بدان اومید ماندستم چنین زنده، که هم روزی(@)(@@)(@@)(@@) | البت باشد به کام من، دریغا گوییا باشد؟(@)(@@) ~~به هم افتیم یک ساعت من و تودو به دو، نه نه(@)(@@)(@@)(@@) | خطا گفتم خطا گفتم، چنین دولت مرا باشد؟(@)(@@) ~~صبا، آرد مرا گه گه نسیم زلف مشکینت(@)(@@)(@@)(@@) | از آن روی است کانس من زعالم با صبا باشد(@)(@@) ~~بدان کز لعل جانبخشت به کام دل رسد روزی(@)(@@)(@@)(@@) | دل محروم مظلومم همه شب در دعا باشد(@)(@@) ~~مده وعده به روی خود فزونم کانتظار آن(@)(@@)(@@)(@@) | نباشد در خور آن کس را که مرگش در قفا باشد(@)(@@) ~~اگر جان خواهی از من تو، جز آری نشنوی از من(@)(@@)(@@)(@@) | چو بوسی خواهم از تو من، جوابم نه چرا باشد؟(@)(@@) ~~چوراضی گشتهام از توبه دشنامی، چرا ندهی؟(@)(@@)(@@)(@@) | بگو در مذهب خوبان چنینها کی روا باشد؟(@)(@@) ~~خلیل 
ms411	 دلشده یارب گرفتار فراقت باد(@)(@@)(@@)(@@) | اگر چندانکه بتواند ز وصل توجدا باشد(@)(@@) ~~چو گفتم حسب حال خود، کنم مدح شهنشاهی(@)(@@)(@@)(@@) | که جز مدح و ثنای او سخن گفتن خطا باشد(@)(@@) ~~شه شروان علاء الدین [فرا یبرز گزین کورا(@)(@@)(@@)(@@) | اگر جمشید هم خوانی ورافریدون، سزا باشد(@)(@@) ~~فلک هرگز نباشد کور با چندین هزاران چشم(@)(@@)(@@)(@@) | اگر از خاک پای او فلک را توتیا باشد(@)(@@) ~~نگردد هر شبی باری چو روز روشنش گیتی(@)(@@)(@@)(@@) | اگر خورشید انور را چورای اوضیا باشد(@)(@@) ~~عطارد گر شبی آید به بزم جنت آیینش(@)(@@)(@@)(@@) | به پیش پایهآ تختش چومن مدحت سرا باشد(@)(@@) ~~حو راند بر زبان در خواب نام دست او شاید(@)(@@)(@@)(@@) | چو زهره کار و بار او همیشه با نوا باشد PageV01P614(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0618.jpg)(@)(@)(@@) ~~چو سوی عالم علوی کند عزم سفر قدرش(@)(@@)(@@)(@@) | نخستین منزلی او را، حریم کبریا باشد(@)(@@) ~~اگر دعوی کند دوران، که دست اوست دریایی(@)(@@)(@@)(@@) | کف دست گهر بخشش، بر آن دعوی گوا باشد(@)(@@) ~~کسی کآرد در اندیشه خلاف رایش، اول کس(@)(@@)(@@)(@@) | که قصد خون او دارد از این گیتی، قضا باشد(@)(@@) ~~ایا شاهی، که سال و ماه و روز و شب همه جایی(@)(@@)(@@)(@@) | تو را، فتح و ظفر دایم زتأیید خدا باشد(@)(@@) ~~از بهر مجلس خاصت نبشتم این سفینه، زانک(@)(@@)(@@)(@@) | به بزم خرمت گه گه مگریادی زما باشد(@)(@@) ~~سفینه خواندمش، نه نه غلط کردم، که دریایی است(@)(@@)(@@)(@@) | که سنگ و خاک و ریگ او، عقیق و کهربا باشد(@)(@@) ~~اگر در هیچ دریایی، مگر در دست در بخشت(@)(@@)(@@)(@@) | از این گونه سفینه هست، یا بودهست، یا باشد(@)(@@) ~~همه گفتار و کردارم به عالی بارگاه تو(@)(@@)(@@)(@@) | همه ژاز و، همه لحن و، همه حشو وخطا باشد(@)(@@) ~~اگر بنوازدم یک ره قبول تو، خداوندا(@)(@@)(@@)(@@) | بر ارباب هنر، بنده از آن پس پادشا باشد(@)(@@) ~~اگر لفظی خطا باشد دو جا از من خطا مشمر(@)(@@)(@@)(@@) | فخاصه چون تومی دانی که ما را عذرها باشد(@)(@@) ~~همیشه تا که پشت چرخ دون پرور 
