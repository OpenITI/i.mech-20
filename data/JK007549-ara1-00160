ms141	 أهل أبيع بهم أهلي % % 7(@)(@@) % خليلي هيجا عبرة أو قفا بنا % % على منزل بين النقيعة والحبل % 8(@)(@@) % فإني لباقي الدمع إن كنت باكيا % على كل دار ، حلها مرة أهلي % % 9(@)(@@) % تريدين أن نرضى وأنت بخيلة ، % و من ذا الذي يرضي الأحباء بالبخل % 10(@)(@@) % لعمرك لولا اليأس ما انقطع الهوى % % ولولا الهوى ما حن من واله قبلي % % PageV01P491 11(@)(@@) % سقى الرمل جون مستهل ربابه % وما ذاك إلا حب من حل بالرمل % 12(@)(@@) % متى تجمعي منا كثيرا ، ونائلا % قليلا تقطع منك باقية الوصل % 13(@)(@@) % ألا تبتغي حلما فتنهى عن الجهل ، % و تصرم جملا راحة لك من جمل % 14(@)(@@) % فلا تعجبا من سورة الحب وانظرا % % أبا خالد ! لا تشمتن أعاديا % 15(@)(@@) % ألا رب يوم قد شربت بمشرب % سقى الغيم لم يشرب به أحد قبلي % % 16(@)(@@) % وهزة أظعان ، كأن حمولها ، % غداة استقلت بالفروق ، ذرى النخل % 17(@)(@@) % طلبت وريعان الشباب يقودني ، % و قد فتن عيني أو توارين بالهجل % 18(@)(@@) % فلما لحقناهن أبدين صبوة ، % و هن يحاذرن الغيور من الأهل % 19(@)(@@) % على ساعة ليست بساعة منظر ، % رمين قلوب القوم بالحدق النجل % 20(@)(@@) % وما زلن حتى كاد يفطن كاشح % يزيد علينا في الحديث الذي يبلي % % PageV01P492 21(@)(@@) % فلم أر يوما مثل يوم بذي الغضا % % أصبنا به صيدا غزيرا على رجل % 22(@)(@@) % ألذ وأشفى للفؤاد من الجوى % % و أغيظ للواشين منه ذوي المحل % 23(@)(@@) % وهاجد موماة بعثت إلى السرى ، % و للنوم أحلى عنده من جنى النحل % 24(@)(@@) % يكون نزول الركب فيها كلا ولا ، % غشاشا ، ولا يدنون رحلا إلى رحل % 25(@)(@@) % ليوم أتت دون الظلال سمومه ، % وظل المها صورا جماجمها تغلي % % 26(@)(@@) % تمنى رجال من تميم لي الردى ، % و ما ذاد عن أحسابهم ذائد مثلي % % 27(@)(@@) % كأنهم لا يعلمون مواطني ، % و قد علموا أني أنا السابق المبلي % % 28(@)(@@) % فلو شاء قومي كان حلمي فيهم ، % و كان على جهال أعدائهم جهلي % % 31(@)(@@) % لعمري لقد أخزى البعيث مجاشعا ، % وقال ذوو أحسابهم : ساء ما يبلي % % 35(@)(@@) % لعمري لئن كان القيون تواكلوا % % نوار لقد أبت 
ms142	 نوار إلى بعل % PageV01P493 39(@)(@@) % لي الفضل في أفناء عمرو ومالك % % وما زلت مذ جاريت أجري على مهل % 40(@)(@@) % و ترهب يربوع ورائي بالقنا % % و ذاك مقام ليس يزري به فعلي % % 41(@)(@@) % لنعم حماة الحي يخشى وراءهم % % قديما وجيران المخافة والأزل % 42(@)(@@) % لقد قوست أم البعيث ، ولم تزل % تزاحم علجا ثادرين على كفل % 43(@)(@@) % ترى العبس الحولي جونا بكوعها % % لها مسكا في غير عاج ولا ذبل % 45(@)(@@) % ليالي تنتاب النباج ، وتبتغي % % مراعيها بين الجداول والنخل % 46(@)(@@) % وهل أنت إلا نخبة من مجاشع % ترى لحية في غير دين ولا عقل % 47(@)(@@) % بني مالك لا صدق عند مجاشع % و لكن حظا من فياش على دخل % 48(@)(@@) % و قد زعموا أن الفرزدق حية % و ما قتل الحيات من أحد قبلي % % 49(@)(@@) % و ما مارست من ذي ذباب شكيمتي % % فيفلت فوت الموت إلا على خبل % % PageV01P494 50(@)(@@) % و لما ارتقى القين العراقي باسته % فرغت إلى القين المقيد في الحجل % 51(@)(@@) % رأيتك لا تحمي عقالا ولم ترد % قتالا فما لاقيت شر من القتل % 52(@)(@@) % ولو كنت ذا رأي لما لمت عاصما ، % وما كان كفؤا ما لقيت من الفضل % 53(@)(@@) % و لما دعوت العنبري ببلدة % إلى غير ماء لا قريب ، ولا أهل % 54(@)(@@) % ضللت ضلال السامري وقومه % دعاهم فظلوا عاكفين على عجل % 55(@)(@@) % فلما رأى أن العنبري كأنما % % ترى بنسيء العنبري جنى النحل % 56(@)(@@) % فأوردك الأعداد والماء نازح % دليل امرىء أعطى المقادة بالدحل % 57(@)(@@) % ألم تر أني لا تبل رميتي % % فمن أرم لا تخطئ مقاتله نبلى % % 58(@)(@@) % فباتت نوار القين رخوا حقابها % % تنازع ساقي ساقها حلق الحجل % 59(@)(@@) % تقبح ريح القين لما تناولت % مقذ هجان إذ تساوفه فحل % PageV01P495 60(@)(@@) % فأقسمت مالاقيت قبلي من الهوى % و أقسمت ما لاقيت من ذكر مثلي % % 61(@)(@@) % % يودون لو زلت بمهلكة نعلي % % PageV01P496 البحر : بسيط تام 1(@)(@@) % تلقى السليطي والأبطال قد كلموا % % وسط الرجال بطينا وهو مفلول % 2(@)(@@) % لم يركبوا الخيل إلا بعدما هرموا % % فهم ثقال على أكتافها ميل % PageV01P497 البحر : كامل تام 1(@)(@@) % لمن 
ms143	 الديار رسومهن خوالي % % أقفرن بعد تأنس وحلال % 2(@)(@@) % عفى المنازل ، بعد منزلنا بها ، % مطر وعاصف نيرج مجفال % 3(@)(@@) % عادت تقاى على هواي و ربما % % حنت إذا ظعن الخليط جمالي % % 4(@)(@@) % ولقد أرى المتجاورين تزايلوا % % من غير ما ترة ، وغير تقالي % % 5(@)(@@) % إني ، إذا بسط الرماة لغلوهم % عند الحفاظ غلوت كل مغالي % % 6(@)(@@) % رفع المطي بما وسمت مجاشعا % و الزنبري يعوم ذو الأجلال % 7(@)(@@) % في ليلتين إذا حدوت قصيدة % بلغت عمان وطيء الأجبال % 8(@)(@@) % هذا تقدمنا وزجرى مالكا % لا يردينك حين قينك مال % 9(@)(@@) % لما رأوا جم العذاب يصيبهم ، % صار القيون كساقة الأفيال % 10(@)(@@) % يا قرط ! إنكم قرينة خزية ، % واللؤم معتقل قيون عقال % PageV01P498 11(@)(@@) % أمسى الفرزدق للبعيث جنيبة ، % كابن اللبون قرينة المشتال % 12(@)(@@) % أرداك حينك يا فرزدق محلبا ، % ما زاد قومك ذاك غير خبال % 13(@)(@@) % و لقد وسمت مجاشعا بأنوفها % % ولقد كفيتك مدحة ابن جعال % 14(@)(@@) % فانفخ بكيرك يا فرزدق إنني % % في باذخ لمحل بيتك عالي % % 15(@)(@@) % لما وليت لثغر قومي مشهدا ، % آثرت ذاك على بني ومالي % % 16(@)(@@) % إني ندبت فوارسي و فعالهم % و ندبت شر فوارس وفعال % 17(@)(@@) % نحن الولاة لكل حرب تتقي % % إذ أنت محتضر لكيرك صالي % % 18(@)(@@) % من مثل فارس ذي الخمار وقعنب % و الحنتفين لليلة البلبال % 19(@)(@@) % و الردف إذ ملك الملوك ومن له % عظم الدسائع كل يوم فضال % 20(@)(@@) % الذائدون ، إذا النساء تبذلت ، % شهباء ذات قوانس ورعال % % PageV01P499 21(@)(@@) % قوم هم غموا أباك ، وفيهم % و حسب يفوت بني قفيرة عالي % % 22(@)(@@) % إني لتستلب الملوك فوارسي ، % و ينازلون إذا يقال نزال % 23(@)(@@) % من كل أبيض يستضاء بوجهه % نظر الحجيج إلى خروج هلال % 24(@)(@@) % تمضي أسنتنا وتعلم مالك % أن قد منعت حزونتي ورمالي % % 25(@)(@@) % فاسأل بذي نجب فوارس عامر % واسأل عيينة يوم جزع ظلال % 26(@)(@@) % يا رب معضلة دفعنا بعدما % % عي القيون بحيلة المحتال % 27(@)(@@) % إن الجياد يبتن حول قبابنا % % من آل أعوج أو لذي العقال % 28(@)(@@) % من كل مشترف و إن بعد المدى % % ضرم الرقاق مناقل الأجرال % 29 
ms144	(@)(@@) % متقاذف تلع ، كأن عنانه % علق بأجرد من جذوع أوال % 30(@)(@@) % صافي الأديم إذا وضعت جلاله ، % ضافي السبيب ، يبيت غير مذال % PageV01P500 31(@)(@@) % و المقربات نقودهن على الوجى % % بحث السباع مدامع الأوشال % 32(@)(@@) % تلك المكارم يا فرزدق فاعترف % لا سوق بكرك يوم جوف أبال % 33(@)(@@) % أبني قفيرة من يورع وردنا ، % أم من يقود لشدة الأحمال % 34(@)(@@) % أحسبت يومك بالوقيط كيومنا % % يوم الغبيط بقلة الأدحال % % 37(@)(@@) % لا يخفين عليك أن مجاشعا % شبه الرجال وما هم برجال % 40(@)(@@) % أما سبابي ، فالعذاب عليهم ، % و الموت للنخبات عند قتالي % % 41(@)(@@) % كالنيب خرمها الغمائم ، بعدما % % ثلطن عن حرض بجوف أثال % 42(@)(@@) % جوف مجارف للخزير ، وقد أوى % % سلب الزبير إلى بني الذيال % 43(@)(@@) % لاقيت أعين والزبير وجعثنا ، % أعدال مخزية عليك ثقال % 44(@)(@@) % و دعا الزبير مجاشعا فترمزت % للغدر ألأم آنف وسبال % PageV01P501 45(@)(@@) % يا ليت جاركم الزبير وضيفكم % إياي لبس حبله بحبالي % % 46(@)(@@) % ألله يعلم لو تناول ذمة % منا لجزع في النحور عوالي % % 47(@)(@@) % و تقول جعثن إذ رأتك منقبا % قبحت من أسد أبي أشبال % 50(@)(@@) % لا قى الفرزدق ضيعة لم يغنها ؛ % إن الفرزدق عنك في أشغال % 52(@)(@@) % ما بال أمك إذ تسربل درعها ، % و من الحديد مفاضة سربالي % % 53(@)(@@) % حممت وجهك فوق كيرك قائما % وسقيت أمك فضلة الجريال % 54(@)(@@) % شابت قفيرة و هي فائرة النسا % % في الشول بو أصرة وفصال % 56(@)(@@) % قبح الإله بني خضاف ونسوة % كوزا على حنق ورهط بلال % 60(@)(@@) % ولد الفرزدق والصعاصع كلهم % علج كأن وجوههن مقالي % % 61(@)(@@) % يا ضب قد فرغت يميني فاعلموا % % طلقا وما شغل القيون شمالي % % PageV01P502 62(@)(@@) % يا ضب ! إني قد طبخت مجاشعا % طبخا يزيل مجامع الأوصال % 63(@)(@@) % يا ضب ! لولا حينكم ما كنتم % عرضا لنبلي حين جد نضالي % % 64(@)(@@) % يا ضب ! إنكم البكار ، وإنني % % متخمط قطم يخاف صيالي % % 65(@)(@@) % يا ضب علي أن تصيب مواسمي % % تبع إذا عد الصميم موالي % % 66(@)(@@) % يا ضب ! إنكم لسعد حشوة ، % مثل البكار ضممتها الأغفال % 67(@)(@@) % يا ضب ! إن هوى القيون أضلكم % كضلال شيعة أعور الدجال 
ms145	 % 68(@)(@@) % فاتفخ بكيرك يا فرزدق وانتظر % في كرنباء ، هدية القفال % 69(@)(@@) % فضح الكتيبة يوم يضرط قائما ، % سلح النعامة شبة بن عقال % 70(@)(@@) % ما السيد حين ندبت خالك منهم % كبني الأشد ، ولا بني النزال % 71(@)(@@) % خالي الذي اعتسر الهذيل وخيله % في ضيق معترك لها ومجال % PageV01P503 72(@)(@@) % جئني بخالك يا فرزدق واعلمن % أن ليس خالك بالغا أخوالي % % PageV01P504 البحر : كامل تام 1(@)(@@) % ودع أمامة حان منك رحيل ، % إن الوداع إلى الحبيب قليل % 2(@)(@@) % تلك القلوب صواديا تيمنها % % وأرى الشفاء وما إليه سبيل % 3(@)(@@) % أعذرت في طلب النوال إليكم % لو كان من ملك النوال ينيل % 4(@)(@@) % إن كان طبكم الدلال ، فإنه % حسن دلالك ، يا أميم ، جميل % 5(@)(@@) % قال العواذل : قد جهلت بحبها ؛ % بل من يلوم على هواك جهول % 6(@)(@@) % كنقا الكشيب تهيلت أعطافه % والريح تجبر متنه ، وتهيل % 7(@)(@@) % أما الفؤاد فليس ينسى ذكركم % ما دام يهتف في الأراك هذيل % 8(@)(@@) % بقيت طلولك يا أميم على اللي % لا مثل ما بقيت عليه طلول % 9(@)(@@) % نسج الجنوب مع الشمال رسومها % % وصبا مزمزمة الرباب عجول % 10(@)(@@) % أيقيم أهلك بالستار وأصعدت % بين الوريقة والمقاد حمول % PageV01P505 11(@)(@@) % ما كان مثلك يستخف لنظرة % يوم المطي بغربة مرحول % 12(@)(@@) % لا يبعدن أنس تغير بعدهم % طلل ، ببرقة رامتين ، محيل % 13(@)(@@) % ولقد تكون إذا تحل بغبطة ، % أيام أهلك ، بالديار ، حلول % 14(@)(@@) % ولقد تساعفنا الديار ، وعيشنا ، % لو دام ذاك بما نحب ظليل % 15(@)(@@) % فسقي ديارك حيث كنت مجلجل % هزج ومن غر الغمام هطول % 16(@)(@@) % وكأن ليلي ، من تذكري الهوى ، % ليل بأطول ليلة موصول % 17(@)(@@) % أينام ليلك يا أميم و لم ينم % ليل المطي وسيرهن ذميل % 18(@)(@@) % يكفيك إذ سرت الهموم فلم تنم % قلص لواقح كالقسي وحول % 19(@)(@@) % نجب من السر العتيق ، نمى بها % % فوق النجائب شدقم وجديل % 20(@)(@@) % عزت كواهلها العرائك ، بعدما % % لحق الثميل فما لهن ثميل % PageV01P506 21(@)(@@) % مثل القناسحج الثقاف متونه % % 22(@)(@@) % تنجو إذا علم الفلاة رأيته % في الآل يقصر مرة ويطول % 23(@)(@@) % و غذا تقاصرت الظلال تشنعت % وخد النعام وفي النسوع فضول 
ms146	 % 24(@)(@@) % من كل صادقة النجاد كأنها % % قرواء رافعة الشراع جفول % % 25(@)(@@) % كم قد قطعن اليك من متماحل % جذب المعرج ما به تعليل % % 26(@)(@@) % نائي المناهل ، طامس أعلامه ، % ميت الشخوص به يكاد يحول % 27(@)(@@) % ألله طوقك الخلافة والهدى % % والله ليس لما قضى تبديل % 28(@)(@@) % إن الخلافة بالذي أبليتم % فيكم ، فليس لملكها تحويل % 29(@)(@@) % يعاو النج إذا النجى أضجهم % أمر تضيق به الصدور جليل % % 30(@)(@@) % ولي الخلافة و الكرامة أهلها % % فالملك أفيح ، والعطاء جزيل % PageV01P507 31(@)(@@) % فعليك جزية معشر لم يشهدوا % % لله إن محمدا لرسول % 32(@)(@@) % تبعو الضلالة ناكبين عن الهدى % % والتغلبي عمي الفؤاد ضلول % 33(@)(@@) % يقضي الكتاب على الصليب وتغلب % ولكل منزل آية تأويل % 34(@)(@@) % إن الخلافة والنبوة والهدى % % رغم لتغلب في الحياة طويل % 35(@)(@@) % فارقتم سبل النبوة ، فاخضعوا % % بجزا الخليفة ، والذليل ذليل % 36(@)(@@) % منع الأخيطل أن يسامى قرمنا % شرف أجب وغارب مجزول % 37(@)(@@) % قرما لزيد مناة أزهر ، مصعبا ، % فتصول زيد مناة ، حين يصول % 38(@)(@@) % منا فوارس لن تجيء بمثلهم % وبناء مكرمة أشم ، طويل % 39(@)(@@) % فإذا ذكرت من الهذيل وقد شتا % % فينا الهذيل و في شواه كبول % 40(@)(@@) % جر الخليفة بالجنود ، وأنتم ، % بين الساوطح و الفرات فلول % % PageV01P508 41(@)(@@) % و لقد شفتني خيل قيس منكم % فيها الهذيل ، ومالك ، وعقيل % 42(@)(@@) % فإذا رميت بحرب قيس لم يزل % أبدا ، لخيلهم ، عليك دليل % 43(@)(@@) % نعم الحماة إذا الصفائح جردت % للبيض تحت ظباتهن صليل % 44(@)(@@) % لو أن جمهم غداة مخاشن % يرمى به حضن لكاد يزول % 45(@)(@@) % لولا الخليفة يا أخيطل ما نجا % % أيام دجلة ، شلوك المأكول % 46(@)(@@) % قيس تزيد على ربيعة في الحصى % % و جبال خندف بعد ذاك فضول % 47(@)(@@) % كذت الأخيطل ما لنسوة تغلب % حامي الذمار ، وما يغار حليل % 48(@)(@@) % ترك الفوارس من سليم نسوة % عجلا لهن على الرحوب عويل % 49(@)(@@) % إذ ظل يحسب كل شخص فارسنا % % و يرى نعامة ظله فيحول % 50(@)(@@) % رقصت ، بعاجنة الرحوب ، نساؤكم % رقص الرئال ، وما لهن ذيول % PageV01P509 51(@)(@@) % أين الأرقم إذ تجر نساؤهم % يوم الرحوب محارب وسلول % 54(@)(@@) % فسخ العباء ، وريح 
ms147	 نسوة تغلب % عدس يقرقر في البطون وفول % 55(@)(@@) % و إذا تدارك رأس أشهب شارف % في الحاويات ، وحمص مبلول % 56(@)(@@) % نادت بيال محارب ، ويكفها % % عرض كأن نطاقه محلول % 57(@)(@@) % أبناؤهن أقل قوم حرمة % عند الشراب و ما لهن عقول % 58(@)(@@) % سفه الأخيطل إذ يقي بعجوزه % كير القيون ، كأنه منديل % 59(@)(@@) % قد كان في جيف بدجلة حرقت % أو في الذين على الرحوب شغول % 60(@)(@@) % وكأن عافية النسور عليهم % حج بأسفل ذي المجاز نزول % % 61(@)(@@) % أهلكت قومك إذ حضضت عليهم % ثم انتهيت و في العدو ذحول % 62(@)(@@) % قبحت موتورا وطالب دمنة ، % بالحضر ، تشرب تارة وتبول % PageV01P510 64(@)(@@) % قل للأخيطل لا عجوزك أنجبت % في الوالدات و لا أبوك فحيل % 65(@)(@@) % قصرت يداك عن الفعال وطالما % % غالت أباك ، عن المكارم ، غول % 66(@)(@@) % تفد الوفود و تغلب منفية % خلف الزوامل ، والعواتق ميل % 67(@)(@@) % يدعى إذا نزلوا ليأخذ زاده % و يقال إنك للضياع مخيل % 68(@)(@@) % فاجمع أشظتها إلى أقتابها % % واخرج فما لك في الرحال مقيل % 69(@)(@@) % من كل أشمط لا يني مستأجرا ، % ما شم ، تودية الصرار ، فصيل % 70(@)(@@) % حظ الأخيطل من تلمسه الرشا % % في الرأس ، لامعة الفراش ، دحول % PageV01P511 البحر : طويل 1(@)(@@) % ألم تر أن الجهل أقصر باطله ، % و أمسى عماء قد تجلت مخايله % 2(@)(@@) % أجن الهوى أم طائر البين شفني % % بحمد الصفا تنعابه و محاجله % % 2(@)(@@) % و كان محلك من وائل % محل القراد من أست الجمل % 3(@)(@@) % لعلك محزون لعرفان منزل ، % محيل بوادي القريتين منازله % 4(@)(@@) % فإني ، ولو لام العواذل ، مولع % بحب الغضا من حب من لا يزايله % 5(@)(@@) % و ذا مرخ أحببت من حب أهله % وحيث انتهت في الروضتين مسايله % 6(@)(@@) % أتنسى لطول العهد أم أنت ذاكر % خليلك ذا الوصل الكريم شمائله % 7(@)(@@) % لحب بنار أوقدت بين محلب % وفردة لو يدنو من الحبل واصله % 8(@)(@@) % و قد كان أحيانا بي الشوق مولعا % إذا الطرف الظعان ردت حمائله % 9(@)(@@) % فلما التقى الحيان ألقيت العصا ، % و مات الهوى لما أصيبت مقاتله % PageV01P512 10(@)(@@) % لقد طال كتماني أمامة حبها ، % فهذا أوان 
ms148	 الحب تبدو شواكله % % 11(@)(@@) % إذا حليت فالحلي منها بمعقد % مليح و إلا لم تشنها معاطله % % 12(@)(@@) % وقال اللواتي كن فيها يلمنني : % لعل الهوى يوم المغيزل قاتله % % 13(@)(@@) % و قلن تروح لا تكن لك ضيعة % وقلبك لا تشغل وهن شواغله % 14(@)(@@) % و يوم كأبهام القطاة مزين % إلي صباه ، غالب لي باطله % 15(@)(@@) % لهوت بدني عليه سموطه % وإنس مجاليه ، وأنس شمائله % 16(@)(@@) % فما مغزل أدماء تحنو لشادن % كطوق الفتاة لم تشدد مفاصله % % 17(@)(@@) % بأحسن منها يوم قالت : أناظر % إلى الليل بعض النيل أم أنت عاجله % 18(@)(@@) % فلو كان هذا الحب حبا سلوته % و لكنه داء تعود عقابله % 19(@)(@@) % و لم أنس يوما بالعقيق تخايلت % ضحاه و طابت بالعشي أصائله % PageV01P513 20(@)(@@) % رزقنا به الصيد الغزير و لم أكن % كمن نبله محرومة وحبائله % 21(@)(@@) % ثواني أجياد يودعن من صحا % % ومن بثه عن حاجة اللهو شاغله % 22(@)(@@) % فأيهات أيهات العقيق و من به % وأيهات وصل بالعقيق تواصله % 23(@)(@@) % لنا حاجة فانظر وراءك هل ترى % % بروض القطا الحي المروح جامله % 24(@)(@@) % رعان أجا مثل الفوالج دونهم ، % ورمل حبت أنقاؤه وخمائله % 25(@)(@@) % رددنا لشعثاء الرسول و لا ارى % % كيومئذ شيئا ، ترد رسائله % 26(@)(@@) % فلو كنت عندي يوم قو عذرتني % % بيوم زهتني جنه وأخابله % 27(@)(@@) % يقلن إذا ما حل دينك عندنا ، % و خير الذي يقضي من الدين عاجله % 28(@)(@@) % لك الخير لا تفضيك إلا نسيئة % من الدين أو عرضا فهل أنت قابله % 29(@)(@@) % أمن ذكر ليلى والرسوم التي خلت % بنعف المنقى راجع القلب خابله % PageV01P514 30(@)(@@) % عشية بعنا الحلم بالجهل وانتحت % بنا أريحيات الصبا ، ومجاهله % 31(@)(@@) % و ذلك يوم خيره دون شره % تغيب واشيار و أقصر عاذله % 32(@)(@@) % وخرق من الموماة أزور لا ترى % % من البعد إلا بعد خمس مناهله % 33(@)(@@) % قطعت بشجعاء الفؤاد نجيبة % مروح إذا ما النسع غرز فاصله % % 34(@)(@@) % وقد قلصت عن منزل غادرت به % % من الليل جونا لم تفرج غياطله % 35(@)(@@) % و أجلاد مضعوف كأن عظامه % عروق الرخامى لم تشدد مفاصله % 36(@)(@@) % ويدمى أظلاها على 
ms149	 كل حرة ، % إذا استعرضت منها حريزا تناقله % 37(@)(@@) % أنخنا فسبحنا ، ونورت السرى % % بأعراف ورد اللون بلق شوا كله % 38(@)(@@) % وأنصب وجهي للسموم ، ودونها % % شماطيط عرضي تطير رعابله % 39(@)(@@) % لنا إبل لم تستجر غير قومها ، % و غير القنا صما تهز عوامله % PageV01P515 40(@)(@@) % رعت منبت الضمران من سبل المعى % % إلى صلب أعيار ، ترن مساحله % 41(@)(@@) % سقتها الثريا ديمة و استقت بها % % غروب سماكي تهلل وابله % 42(@)(@@) % ترى لحبييه ربابا كأنه % غوادي نعام ينفض الزف جافله % 43(@)(@@) % تراعي مطافيل المها ، ويروعها % % ذباب الندى تغريده وصواهله % 44(@)(@@) % إذا حاول الناس الشؤون وحاذروا % % زلازل أمر لم ترعها زلازله % 45(@)(@@) % يبيح لها عمرو وحنظلة الحمى ، % ويدفع ركن الفزر عنها وكاهله % 46(@)(@@) % بني مالك من كان للحي معقلا % إذا نظر المكروب أين معاقله % 47(@)(@@) % بذي نجب ذدنا و واكل مالك % أخا لم يكن عند الطعان يواكله % 48(@)(@@) % نفس = ش بنو جوخى الخنزير وخيلنا % % تشظي قلال الحزن يوم تناقله % 49(@)(@@) % أقمنا بما بين الشربة و الملا % % تغني ابن ذي الجدين فينا سلاسله % PageV01P516 50(@)(@@) % ونحن صبحنا الموت بشرا ورهطه % صراحا وجاد ابني هجيمة وابله % 51(@)(@@) % ألا تسألون الناس من ينهل القنا % % و من يمنع الثغر المخوف تلاتله % 52(@)(@@) % لنا كل مشبوب يروى بكفه % جناحا سنان ديلمي وعامله % 53(@)(@@) % يقلص بالفضلين : فضل مفاضة ، % و فضل نجاد لم تقطع حمائله % % 54(@)(@@) % و عمى رئيس الدهم يوم قرارقر % فكان لنا مرباعه ونوافله % 55(@)(@@) % وكان لنا خرج مقيم عليهم ، % و أسلاب جبار الملوك و جامله % 56(@)(@@) % أتهجون يربوعا ، وأترك دارما ، % تهدم أعلى جفركم و أسافله % % 57(@)(@@) % ودهم كجنح الليل زرنا به العدى % % له عثير مما تثير قنابله % 58(@)(@@) % غذا سوموا لم تمنع الأرض منهم % حريدا ولم تمنع حريزا معاقله % 59(@)(@@) % نحوط الحمى والخيل عادية بنا % % كما ضربت في يوم طل أجادله % PageV01P517 60(@)(@@) % أغرك أن قيل الفرزدق مرة ؛ % وذو السن يخصى بعدما شق بازله % 61(@)(@@) % فإنك قد جاريت لا متكلفا ، % و لا شنجا يوم الرهان أباجله % % 62(@)(@@) % أنا البدر يعشى طرف عينيك فالتمس % بكفيك 
ms150	 يا بن القين هل أنت نائله % 63(@)(@@) % لبست أداتي ، والفرزدق لعبة ، % عليه وشاحا كرج و جلاجله % 64(@)(@@) % أعدوا مع الحلي الملاب ، فإنما % % جرير لكم بعل وأنتم حلائله % 65(@)(@@) % وأعطوا كما أعطت عوان حليلها ، % % 66(@)(@@) % أنا الدهر يفنني الموت والدهر خالد % فجئني بمثل الدهر شيئا يطاوله % 67(@)(@@) % أمن سفه الأحلام جاؤوا بقردهم % % إلى و ما قرد لقرم يصاوله % % 68(@)(@@) % تغمده آذي بحر ، فغمه ، % وألقاه في الحوت فالحوت آكله % 69(@)(@@) % فإن كنت يا ابن القين رائم عزنا % % فرم حضنا فانظر متى أنت نائله % PageV01P518 70(@)(@@) % بني الخطفي حتى رضينا بناءه % فهل أنت إن لم يرضك القينقاتله % % 71(@)(@@) % بنينا بناء لم تنالوا فروعه % وهدم أعلى ما بنيتم أسافله % 72(@)(@@) % وما بك رد للأوابد ، بعدما % % سبقن كسبق السيف ما قال عاذله % 73(@)(@@) % ستلقى ذبابي طائفا كان يتقي % % وتقطع أضعاف المتون أخايله % 74(@)(@@) % وما هجم الأقيان بيتا ببيتهم ، % و لا القين عن دار المذلة ناقله % % 75(@)(@@) % و ما نحن أعطينا أسيدة حكمها % % لعان أعضت في الحديد سلاسله % 76(@)(@@) % و لسنا بذبح الجيش يوم أوراة % و لم يستبحنا عامر و قنابله % % 77(@)(@@) % عرفتم بني عبس عشية أقرن % فخلي للجيش اللواء وحامله % 78(@)(@@) % وعمران ، يوم الأقرعين ، كأنما % % أناخ بذي قرطين خرس خلاخله % 79(@)(@@) % ولم يبق في سيف الفرزدق محمل ، % و في سيف ذكوان بن عمرو و محامله % % PageV01P519 81(@)(@@) % و يرضع من لاقى و إن يلق مقعدا % يقود بأعمى فالفرزدق سائله % 82(@)(@@) % إذا وضع السربال قالث مجاشع % له منكبا حوض الحمار وكاهله % 84(@)(@@) % على حفر السيدان خزية % ويوم الرحا لم ينق ثوبك غاسله % 91(@)(@@) % أحارث خذ من شءت منا ومنهم % و دعنا نقس مجدا تعد فواضله % 92(@)(@@) % فما في كتاب الله تهديم دارنا ، % بتهديم ماخور خبيث مداخله % 93(@)(@@) % وفي مخدع منه النوار وشربه ، % وفي مخدع أكياره ومراجله % 94(@)(@@) % تميل به شرب الحوانيت رائحا ، % إذا حركت أوتار صنج أنامله % 95(@)(@@) % و لست بذي درء و لا ذي أرومة % و ما تعط من ضيم فانك قابله % 96(@)(@@) % جزعتم إلى صناجة هروية 
ms151	 % على حين لا يلقى مع الجد باطله % 97(@)(@@) % إذا صقلوا سيفا ضربنا بنصله % و عاد الينا جفنه و حمائله % PageV01P520 البحر : طويل 1(@)(@@) % عجبت لرحل من عدي مشمس ، % وفي أي يوم لم تشمس رحالها % % 2(@)(@@) % وفيم عدي عند تيم من العلى ، % وأيامنا اللاتي يعد فعالها % % 3(@)(@@) % مددت بكف من عدي قصيرة % لتدرك من زيد يدا لا تنالها % % 4(@)(@@) % وصية عمي بابن خل فلا ترم % مساعي قوم ليس منك سجالها % % 5(@)(@@) % يماشي عديا لؤمها ما تجنه % من الناس ما ماشت عديا ظلالها % % 6(@)(@@) % فقل لعدي تستعن بنسائها % % علي ، فقد أعيا عديا رجالها % % 7(@)(@@) % أذا الرم قد قلدت قومك رمة ، % بطيا بأيدي المطلقين انحلالها % % 8(@)(@@) % ترى اللؤم ما عاشت عدي مخلدا % سرابيلها منه ، ومنه نعالها % % PageV01P521 البحر : وافر تام 1(@)(@@) % فلا خوف عليك و لن تراعي % % بعقوة مازن وبني هلال % 2(@)(@@) % هما الحيان ، إن فزعا يطيرا % % إلى جرد ، كأمثال السعالي % % 3(@)(@@) % أمازن ، يا ابن كعب ، إن قلبي % % لكم طول الحياة لغير قالي % % 4(@)(@@) % غطاريف يبيت الجار فيهم % قرير العين في أهل و مال % PageV01P522 البحر : بسيط تام 1(@)(@@) % حي الديار كوحي الكاف و الميم % ما حظك اليوم منها غير تسليم % 2(@)(@@) % إذ أنت صاد بنبل الجن مقتتل % و الشرب يمنع من صديان مهيوم % 3(@)(@@) % للموت أروح مما تفعلين بنا % % ومن مواعد من خلف وتأثيم % 4(@)(@@) % قد كنت أصكاد إذدريش القداح بها % % قبل الرماة ، بسهم غير محروم % 5(@)(@@) % ما في بنات ابن قنب ما يرد هوى % % ما كنت أول عبد ضل مغتوم % 6(@)(@@) % يا تيم ! قد طال إنذاري على طرق ، % و عند زائدة الكلبي تقديمي % % 7(@)(@@) % إذ قلت للتيم لا تدنوا فلزكم % من قاطع طبق الأعناق مسموم % 8(@)(@@) % تسمو تميم بسام ذي مراهنة % عند المواطن سباق الأضاميم % 9(@)(@@) % أدعو تميم بن مر ترفدني % % عند المواطن رفدا غير مغموم % 10(@)(@@) % إن الجراثيم كبرها يكون لنا % % لاحق للتيم في تلك الجراثيم % PageV01P523 11(@)(@@) % قالت تميم ألستم يا بني كسع % ريش الذنابي و لستم بالمقاديم % 12(@)(@@) % يا تيم ! ويحك من 
ms152	 جدع له ندب % يبدو بانفك من ذل و ترغيم % 13(@)(@@) % يا تيم ! تمضي عليكم كل مظلمة ، % عادات معترف بالذل نظلوم % % 14(@)(@@) % يا قبح الله عبدا من بني لجأ % يأوى إلى نسوة رصع مداريم % 15(@)(@@) % و ابني شريك شريك اللؤم إذ نزلا % بالجزع أسفل من أطواء موشوم % 16(@)(@@) % عمدا رميت ابن مكحول بدامغة ، % حتى استدار بواهي الرأس مأموم % % 17(@)(@@) % فرعا قريشإذا ما حكموا عدلوا % % فصل القضاء وكانوا أهل تحكيم % 18(@)(@@) % الطيبون من الريحان منبتهم % ومنبت التيم في الكراث والثوم % 19(@)(@@) % تقضي القضاة على تيم و إن رغمت % فاكتب قضاءك و اطبع بالخواتيم % 20(@)(@@) % فاسأل بني عبد شمس قد رضيت بعم % أو هاشم الصيد أو أبناء مخزوم % PageV01P524 21(@)(@@) % يا تيم ! أمكم عمياء مقعدة ، % جاءت بنسل خبيث الريح مجذوم % 23(@)(@@) % ما بين تيم وإسماعيل من نسب % إلا القراية بين الزنج و الروم % 24(@)(@@) % إن ابن تيم لمنسوب لوالده ، % داني القرابة من حام ويحموم % 25(@)(@@) % هذي التي جدعت تيما مواسمها % % ثم اقعدي بعدها يا تيم أو قومي % % PageV01P525 البحر : كامل تام 1(@)(@@) % حي الديار بعاقل فالأنعم % كالوحي في رق الكتاب المعجم % 2(@)(@@) % طلل تجر به الرياح سواريا ، % و المدجنات من السماك المرزم % 3(@)(@@) % عفى المنازل كل جون ماطر ، % أو كل معصفة حصاها يرتمي % % 4(@)(@@) % أصرمت حاجتك التي قضيتها ، % و مع الظعائن حاجة لم تصرم % 5(@)(@@) % بقر أوانس لم تصب غراتها % % نبل الرماة ولا رماح المستمى % % 6(@)(@@) % أخلفن كل متيم منينه ، % و جفون منزلة الرهين المغرم % 7(@)(@@) % إن البغيض له منازل عندنا % % ليست كمنزلة المحب المكرم % 8(@)(@@) % ما نظرة لك يوم تجعل دونها % % فضل الرداء وتتقي بالمعصم % 9(@)(@@) % و لقد قطعت مجاهلا و مناهلا % و جمام آجنها كلون الغدم % 10(@)(@@) % وإذا المطوق باض في أرجائها ، % حسبت نقائضه فلاق الحنتم % PageV01P526 11(@)(@@) % إن الوليد خليفة لخليفة ، % رفع البناء على البناء الأعظم % 12(@)(@@) % فعلا بناؤكم الذي شرفتم ، % ولكم أباطح كل واد مفعم % 13(@)(@@) % كم قد قطعت اليك من ديمومة % يهماء غفل ليلها كالأيهم % 14(@)(@@) % وتركت ناجية المهارى زاحفا ، % بعد 
ms153	 الزورة والجلال الأحزم % 15(@)(@@) % إن الوليد هو الإمام المصطفى ، % بالنصر هز لواؤه ، والمغنم % 16(@)(@@) % ذو العرش قدر أن تكون خليفة ، ، % ملكت فاعل على المنابر واسلم % % 17(@)(@@) % ورث الأعنة والأسنة وانتمى % % في بيت مكرمة رفيع السم % 18(@)(@@) % و رأيت أبنية خوت وتهدمت % وبناء عرشك خالد لم يهدم % 19(@)(@@) % ترك النجاة وحل حيث تمنعت % أعياصه ولكل خير ينتمي % % 20(@)(@@) % عرف البرية أن كل خليفة % من فرع عيصك كالفنيق المقرم % PageV01P527 21(@)(@@) % خزم الأنوف وقاد كل عمارة % صعب القياد مخاطر لم يخزم % 22(@)(@@) % وبنو الوليد من الوليد بمنزل ، % كالبدر حف بواضحات الأنجم % 23(@)(@@) % و لقد سمة ت إلى النصارى سموة % رجفت لوقعتها جبال الديلم % % 24(@)(@@) % إن الكنيسة كان هدم بنائها % % قسرا ، فكان هزيمة للأخرم % 25(@)(@@) % فأراك ربك إذ كسرت صليبهم % نور الهدى وعلمت ما لم نعلم % 26(@)(@@) % و إذا الكتائب أعلمت راياتها % % وكأنهن عتاق طير حوم % 27(@)(@@) % نطح الرؤوس بهامة . . . فتفرقوا % % عنها وعظم فراشها لم يهزم % 28(@)(@@) % مردى الحروب إذا الحروب توقدت ، % وحيا إذا كثرت عماد الرزم % 29(@)(@@) % إني من المتنصفين سجالكم % ينفخن من ثبج الفرات الأعظم % 30(@)(@@) % أرجو سوابق ذي فواضل منهم % وأخاف صولة ذي شبول ضيغم % PageV01P528 31(@)(@@) % أشكو إليك وربما تكفونني % % عض الزمان وثقل دين المغرم % 32(@)(@@) % بر البلاد مسخر بحبي لكم % والبحر سخر بالجواري العوم % 33(@)(@@) % و ترى الجفان يمدها قمع الذري % % مد الجداول بالأتي المفعم % 34(@)(@@) % و القدر تنهم بالمجال وترتمي % % بالزور همهمة الحصان الأدهم % PageV01P529 البحر : وافر تام 1(@)(@@) % عرفت ببرقة الوداء رسما % محيلا ، طاب عهدك من رسوم % 2(@)(@@) % عفا الرسم المحيل بذي العلندي % % مساحج كل مرتجز هزيم % 3(@)(@@) % فليت الظاعنين هم أقاموا % % وفارق بعض ذا الأنس المقيم % 4(@)(@@) % فما العهد الذي عهدت إلينا % % بمنسى البلاء ولا ذميم % % 5(@)(@@) % و زارت فتية ورحال ميس % لدى فتل مرافقهن ، هيم % 6(@)(@@) % يساقطن النقيل وهن خوص % بغبر البيد خاشعة مرافقهن هيم % 7(@)(@@) % يساقطن النقيل وهن خوص % بغبر البيد خاشعة الحزوم % 8(@)(@@) % تعطف ، من توابع كل هجر ، % عصيما بالجلود على عصيم % 9(@)(@@) % سرين الليل 
ms154	 ثم وردن خمسا ، % ولا يسطيع ذاك أخو النعيم % 10(@)(@@) % أعاذل طال ليلك لم تنامي % % ونام العاذلات ، ولم تنيمي % % PageV01P530 11(@)(@@) % إذا ما لمتني ، وعذرت نفسي ، % فلومي ما بدا لك أن تلومي % % 12(@)(@@) % نزلت بغاية الحمق ، اللئيم % شفاء الطارقات من الهموم % 13(@)(@@) % تريح نقادها جشم بن بكر % و ما نطفوا بأنجية الحكوم % 14(@)(@@) % لقد سفهت حلومهم وأجروا % % مع المسبوق حيث جرى المليم % 16(@)(@@) % لهم مر وللنخبات مر % فقد رجعوا بغير شظى سليم % 17(@)(@@) % و قد نال الأخيطل من هجائي % % دحول السبر ، غائرة الهزوم % 18(@)(@@) % و كيف يصول أرصع تغلبي % و ما للعبد من حسب قديم % 19(@)(@@) % سمونا للمكارم ، فاحتوينا % % بلا وغل المقام ، ولا سؤوم % 20(@)(@@) % و قد هجموا الرهان فما كبونا % % و ما أوهى قناتي من وصوم % 21(@)(@@) % ترى الشعراء من صعق مصاب % بصكته ، وآخر مستديم % PageV01P531 22(@)(@@) % لقد وجدوا رشائي مستمرا ، % و دلوي غير واهية الأديم % 23(@)(@@) % ومثلك قد قصدت له فأمسى % % أخا حلم وما هو بالحلم % 24(@)(@@) % يرى حسراته ، ويخاف درئي ، % و يغضي طرفه الحمق اللئيم % 25(@)(@@) % ستعلم أن أصلي خندقي % جبالي أفضل الحسب الكريم % 26(@)(@@) % فنفسي ، والنفوس فداء قوم % بنوا لي فوق مرتقب جسيم % 27(@)(@@) % نزلت بفرع خندف حيث لاقت % شؤون الهام مجتمع الصميم % 28(@)(@@) % أفاضل بالرباب وآل سعد ، % وزيد مناة ، إذ خطرت قرومي % % 29(@)(@@) % وجدنا المجد قد علمت معد % وعز الناس تم إلى تميم % 30(@)(@@) % مطاعيم الشمال إذا استحنت % و في عرواء كل صبا عقيم % 31(@)(@@) % سبقنا العالمين بكل مجد % وبالمستمطرات من النجوم % PageV01P532 32(@)(@@) % إذا نجم تغيب لاح نجم % و ليست بالمحاق ولا الغموم % 33(@)(@@) % سأبسط من يدي عليك فضلا % و نحن القاطعون يد الظلوم % 34(@)(@@) % رأوا أثبية الفهدات وردا % فما عرفوا الأغر من البهيم % 35(@)(@@) % و أعيينا أباك أبا غويث % فأعيا عن مجاهدة الخصوم % 36(@)(@@) % وأدركنا الهذيل بلافظات % دم الأشداق من علك الشكيم % 37(@)(@@) % ضغا في القد آدر تغلبي ، % ضبيح الجلد من أثر الكلوم % 38(@)(@@) % منعنا الجوف والنعم المندى % % و قلنا للنساء به أقيمي % % 39(@)(@@) % و قد هجمت 
ms155	 وأمك خيل قيس % على رعن السلوطح ذي الأورم % 40(@)(@@) % و ما قتلي بني جشم بن بكر % بزاكية الدماء ، ولا اللحوم % 41(@)(@@) % فحسبك أن تنوح بين دن % و باطية وإبريق رذوم % PageV01P533 42(@)(@@) % حكمت بحكم أمك حيث تلقى % % خليطا من صقالبة وروم % 44(@)(@@) % أليس أبوك ذا زمع ثمان ، % وأمك ذات مكتشر ذميم % 45(@)(@@) % لبئس الفحل ، ليلة أشعرته % عباءتها مرقعة بنيم % 46(@)(@@) % فذاك الفحل جاء بشر نجل ، % خبيثات المثابر والمشيم % PageV01P534 البحر : وافر تام 1(@)(@@) % تلاقي في الولاء عليك سعدا ، % ثقال الوزن ، طالعة الخصوم % 2(@)(@@) % وأبناء الضرائر جدعوكم ، % وأنتم فرخ واحدة عقيم % PageV01P535 البحر : كامل تام 1(@)(@@) % أبني أسيدة قد وجدت لمازن % قدما ، وليس لكم قديم يعلم % 2(@)(@@) % فدعوا التكرم والفخار بمازن % إن اللئيم بغيره لا يكرم % PageV01P536 البحر : وافر تام 1(@)(@@) % عرفت الدار بعد بلى الخيام % سقيت نجاء مرتجز ركام % 2(@)(@@) % كأن أخا اليهود يخط وحيا % بكاف في منازلها ولام % 3(@)(@@) % و قاطعت الغواني بعد وصل % فقد نزع الغيور عن اتهامي % % 4(@)(@@) % تنازعنا بجدتها حبالا ، % فنين بلى وصرن إلى رمام % 5(@)(@@) % و قد خبرتهن يقلن فان % فلا ينظرن من خلل القرام % 6(@)(@@) % وقد أقصرت عن طلب الغواني ؛ % وقد آذن حبلي بانصرام % 7(@)(@@) % إذا حدثتهن هزئن مني % % و لا يغشين رحلي في المنام % 8(@)(@@) % لقد نزل الفرزدق دار سعد % ليالي لا يعف ، ولا يحامي % % 9(@)(@@) % إذا ما رمت ، ويل أبيك ، سعدا ، % لقيت صيال مقرمة سوام % 12(@)(@@) % و هم جروا بنات أبيك غصبا % وما تركوا لجارك من ذمام % PageV01P537 13(@)(@@) % و حجزة لو تبين ما رأيتم % بعضرطها لمات من الفحام % 15(@)(@@) % وذا الجدين أزهقت العوالي ، % وكل مقلص قلق الحزام % 16(@)(@@) % رجعن بهانئ وأصبن بشرا % ويوم الصمد يوم لهى عظام % 17(@)(@@) % وعاو قد تعرض لي متاح ، % فدق جبينه حجر المرامي % % 18(@)(@@) % ضغا الشعراء حين رأوا مدلا ، % إذا امتد الأعنة ذا عذام % % 19(@)(@@) % فلما قتل الشعراء غما ، % أضربهم وأمسك بالكظام % 20(@)(@@) % قتلت التغلبي ، وطاح قرد % هوى بين الحوالق والحوامي % % 21(@)(@@) % فقتلنا جبابرة ملوكا ، % و أقصدت البعيث بسهم رامي % % 22(@)(@@) % وأطلعت 
ms156	 القصائد طود سلمى ، % و صدع صاحبي شعبي انتقامي % % 23(@)(@@) % ألسنا نحن ، قد علمت معد ، % نمد مقادة اللجب اللهام % PageV01P538 24(@)(@@) % ن قيم على ثغور بني تميم ، % ونصدع بيضة الملك الهمام % 25(@)(@@) % وكنتم تأمنون ، إذا أقمنا ، % وإن نظعن ، فما لك من مقام % 26(@)(@@) % و نحن الذائدون إذا جبنتم % عن السبي المصبح والسوام % 27(@)(@@) % تفدينا نساؤكم ، إذا ما % % رقصن وقد رفعن عن الخدام % 28(@)(@@) % تنوطون العلاب ولم تعدوا % % ليوم الروع صلصلة اللجام % 29(@)(@@) % و يم الشيطين حباريات % و أسرد بالوقيط من النعام % 30(@)(@@) % ونازلنا ابن كبشة ، قد علمتم ، % وذا القرنين وابن أبي قطام % 31(@)(@@) % % إلى أسيافنا قدر الحمام % 32(@)(@@) % و للهرماس قد تركوا مجرا % لطير يقنعن دم اللحام % 33(@)(@@) % % وأطلقنا الملوك على احتكام % PageV01P539 34(@)(@@) % ستخزي ما حييت ولا يحيا % % إذا ما مت ، قبرك بالسلام % 35(@)(@@) % و لو متنا لشد عليك قبري % % بمسموم مضاربه حسام % 36(@)(@@) % و إن صدى المقر به مقيم % ينادي الذل ، بعد كرى النيام % 37(@)(@@) % سقى جدث الزبير ولا سقاهم % غداة العرق أسفل من سنام % 38(@)(@@) % تلومكم العصاة وآل حرب ، % ورهط محمد ، وبنو هشام % 39(@)(@@) % ولو نزل الزبير بنا لجلى % % زياد فوارسي رهج القتام % 40(@)(@@) % لخافوا أن تلومهم قريش % فردوا الخيل دامية الكلام % 41(@)(@@) % و خالي ابن الأشد سما بسعد % فجاوز يوم ثيتل وهو سامي % % 42(@)(@@) % فأوردهم مسلحتي تياس % حظيظ بالرياسة والغنام % 43(@)(@@) % قفيرة وهي ألأم أم قوم % توفي في الفرزدق سبع آم % PageV01P540 44(@)(@@) % بذا شبه الزبابة في بنيها % % و عرق من قفيرة غير نامي % % 45(@)(@@) % فان مجاشعا فتعرلافوهم % بنو جوخى وخجخج والقذام % 46(@)(@@) % و أمهم خضاف تداركتهم % بذحل في القلوب وفي العظام % 49(@)(@@) % متى تأت الرصافة تخز فيها % % كخزيك في المواسم كل عام % % 50(@)(@@) % تلفت وهي تحتك يا ابن قين % إلى الكيرين والفأس الكهام % 51(@)(@@) % تفدى عام بيع لها جبير % و تزعم أن ذلك خير عام % % 52(@)(@@) % و لم تدرك بقتل أبيك فيهم % ولا بعريش أمكم الحطام % 53(@)(@@) % لقد رحل ابن شعرة ناب سوء % تعض على الموارك والزمام % % PageV01P541 البحر : وافر 
ms157	 تام 1(@)(@@) % أصبح حبل وصلكم رماما ، % وما عهد كعهدك ، يا أماما % % 2(@)(@@) % إذا سفرت ، فمسفرها جميل ، % و يرضى العين مرجعها اللثاما % % 3(@)(@@) % ترى صديان مشرعة شفاء % فجام وليس واردها وحاما % % 4(@)(@@) % أمنيت المنى وخلبت حتى % تركت ضمير قلبي مستهاما % % 5(@)(@@) % سقى الأدمى بمسبلة الغوادي % % وسلمانين مرتجزا ركاما % % 6(@)(@@) % سمعت حمامة طربت بنجد ، % فما هجت العشية يا حماما % % 7(@)(@@) % مطوقة ، ترنم فوق غصن ، % إذا ما قلت مال بها استقاما % % 8(@)(@@) % سقى الله البشام وكل أرض % من الغورين أنبتت البشاما % % 9(@)(@@) % كأنك لم تسر بجنوب قو ، % و لم تعرف بناظرة الخياما % % 10(@)(@@) % عرفت منازلا بجماد قو % فأسبلت الدموع بها سجاما % % PageV01P542 11(@)(@@) % ولا أنسى ضرية والرجاما % % وقد ترك الوقود بهن شاما % % 12(@)(@@) % وقفت على الديار فذكرتني % % عهودا من جعادة أو قطاما % % 13(@)(@@) % أظاعنة جعادة لم تودع % أحب الظاعنين ومن أقاما % % 14(@)(@@) % فقلت لصحبتي وهم عجال % بذي بقر : ألا عوجوا السلاما % % 15(@)(@@) % صلوا كنفي الغداة وشيعوني ، % فان عليكم مني زماما % % 16(@)(@@) % فقالوا : ما تعوج بنا لشيء ، % إذا لم تلقهم إلا لماما % % 17(@)(@@) % من الأدمى أتينك منعلات % يقطعن السرائح ، والخداما % % 18(@)(@@) % فليت العيس قد قطعت بركب % و عالا أو قطعن بنا صواما % % 19(@)(@@) % كأن حداتنا الزجلين هاجوا % % بخبت أو سماوته نعاما % % 20(@)(@@) % تخاطر بالأدلة أم وحش % إذا جازوا تسومهم الظلاما % % PageV01P543 21(@)(@@) % مخفقة تشابه حين يجري % % حباب الماء وارتدت القتاما % % 22(@)(@@) % ترى ركب الفلاة ، إذا علوها ، % على عجل وسيرهم اقتحاما % % 23(@)(@@) % إذا نشز المخارم في ضحاها ، % حسبت رعانها حصنا قياما % % 24(@)(@@) % أبيت الليل أرقب كل نجم ، % مكابدة لهمي واحتماما % % 25(@)(@@) % مشيت على العصا وحنون ظهري % % و ودعت الموارك والزماما % % 26(@)(@@) % و كيف ولا أشد حبال رحل % أروم إلى زيارتك المراما % % 27(@)(@@) % من العيدي في نسب المهاري % % تطير على أخشتها اللغاما % % 28(@)(@@) % وتعرف عتقهن على نحول ، % وقدت لحقت ثمائلها انضماما % % 29(@)(@@) % كأن على مناخرهن قطنا ، % يطير ويعتممن به اعتماما % % 30(@)(@@) % أمير المؤمنين قضى بعدل ، % أحل الحل ، واجتنب الحراما % % PageV01P544 31(@)(@@) % أتم الله نعتمه عليكم % وزاد الله ملككم تماما 
ms158	 % % 32(@)(@@) % و بارك في مسيركم مسيرا % و بارك في مقامكم مقاما % % 33(@)(@@) % بحق المستجير يخاف روعا ، % إذا أمسى بحبلك أن يناما % % 34(@)(@@) % فيا رب البرية أعط شكرا % وعافية ، وأبق لنا هشاما % % 35(@)(@@) % و ثقنا بالنجاح إذا بلغنا % % إمام العدل والملك الهماما % % 36(@)(@@) % عطاء الله ملكك النصارى % % ومن صلى لقبلته ، وصاما % % 37(@)(@@) % تعافي السامعين إذا أطاعوا % % و لكن العصاة لقوا غراما % % 38(@)(@@) % و كان أبوك قد علمت معد % يفرج عنهم الكرب العظاما % % 39(@)(@@) % و قد وجدوك أكرمهم جدودا % إذا نسبوا ، وأثبتهم مقاما % % 40(@)(@@) % و تحرز حين تضرب بالمعلى % % من الحسب الكواهل والسناما % % PageV01P545 41(@)(@@) % إلى المهدي نفزع إن فزعنا % % ونستسقي ، بغرته ، الغماما % % 42(@)(@@) % و ما جعل الكواكب أو سهيلا % كضوء البدر يجتاب الظلاما % % 43(@)(@@) % و حبل الله تعصمكم قواه % فلا تحشى لعروته انفصاما % % 44(@)(@@) % ويحسر من تركت فلم تكلم ، % ويغبط من تراجعه الكلاما % % 45(@)(@@) % رضينا بالخليفة حين كنا % % له تبعا وكان لنا إماما % % 46(@)(@@) % تباشرت البلاد لكم بحكم % أقام لنا الفرائض واستقاما % % 47(@)(@@) % و ريشي منكم وهواي فيكم % وإن كانت زيارتكم لماما % % 48(@)(@@) % و قيت الحتف من عرض المنايا % % و لقيت التحية والسلاما % % 49(@)(@@) % لقد علم البرية ، من قريش % و من قيس مضاربه الكراما % % 50(@)(@@) % نمماك الحارثان وعبد شمس % إلى العليا ، فعزك لن يراما % % PageV01P546 51(@)(@@) % سيوف الخالدين صدعن بيضا % على الأعداء في لجب وهاما % % 52(@)(@@) % وسيف بني المغيرة لم يقصر ؛ % سيوف الله دوخت الأناما % % 53(@)(@@) % رأيت المنجنيق ، إذا أصابت % بناء الكفر ، هدمت الرخاما % % PageV01P547 البحر : وافر تام 1(@)(@@) % ألمت ، وما رفقت بأن تلومي ، % وقلت مقالة الخطل الظلوم % 2(@)(@@) % إذا ما نمت هان عليك ليلي % % و ليل الطارقات من الهموم % % 3(@)(@@) % أهذا الود غرك أن تخافي % % تشمس ذي مباعدة علوم % % 4(@)(@@) % وقفت على الديار وما ذكرنا % % كدار بين تلعة والنظيم % 5(@)(@@) % عرفت المنتأى ، وعرفت منها % % مطايا القدر كالحدإ الجثوم % 6(@)(@@) % أمير المؤمنين ! جمعت دينا ، % وحلما فاضلا لذوي الحلوم % 7(@)(@@) % أمير المؤمنين على صراط ، % إذا اعوج الموارد مستقيم % 8(@)(@@) % له المتخيران أبا وخالا % فأكرم بالخؤولة 
ms159	 والعموم % % 9(@)(@@) % فيا بن المطعمين إذا شتونا % % و يا بن الذائدين لدى الحريم % 10(@)(@@) % وأحرزت المكارم ، كل يوم ، % بغرة سابق وشظا سليم % PageV01P548 11(@)(@@) % نما بك خالد وأبو هشام % مع الأعياص في الحسب الجسيم % 12(@)(@@) % و تنزل من أمية حين تلقى % % شؤون الهام مجتمع الصميم % 13(@)(@@) % و من قيس سما بك فرع نبع % على علياء خالدة الأروم % 14(@)(@@) % وأعداء زويتهم بحرب ، % تكف مسالح الزحف المقيم % 15(@)(@@) % ترى للمسلمين عليك حقا ، % كفعل الوالد الرؤف الرحيم % 16(@)(@@) % وليتم أمرنا ، ولكم علينا % % فضول في الحديث وفي القديم % 17(@)(@@) % إذا بعض السنين تعرقتنا ، % كفى الأيتام فقد أبي اليتيم % 18(@)(@@) % وكم يرجو الخليفة من فقير ، % ومن شعثاء جائله البريم % 19(@)(@@) % وأنت ، إذا نظرت إلى هشام ، % نظرت نجار منتجب كريم % 20(@)(@@) % ولي الحق حين تؤم حجا % صفوفا بين زمزم والحطيم % PageV01P549 21(@)(@@) % تواصت ، من تكرمها ، قريش % برد الخيل دامية الكلوم % 22(@)(@@) % فما الأم التي ولدت أباكم % بمقرفة النجار ولا عقيم % 23(@)(@@) % و ما قرم بأنجب من أبيكم % و ما خال بأكرم من تميم % 24(@)(@@) % سما أولاد برة بنت مر % إلى العلياء في الحسب العظيم % PageV01P550 البحر : طويل 1(@)(@@) % ألا قل لربع بالأفاقين يسلم % يحيا على شحط وإن لم يكلم % 2(@)(@@) % ومن يعط ود الغانيات ، فإنه % غني ، ومن يحرمنه الود يحرم % 3(@)(@@) % ذعرت علينا اليوم وحشا غريرة % و نفرت من أطلالها وحش مستمى % % 4(@)(@@) % بني عبد عمرو ! قد فرغت إليكم ، % و قد طال زجري لونها كم تفدمي % % 5(@)(@@) % بني عبد ! عمرو قد أصاب أكفكم % مشاظي قناة درؤها لم يقوم % 6(@)(@@) % لقد بعثت هزان جفنة وافدا % فآب وأحذى قومه شر مغنم % 7(@)(@@) % فيا راكب القصواء ما أنت صانع % بهزان إذ ألحمتهم شر ملحم % 8(@)(@@) % ن بني هزان لما رديتهم % و بار تضاغت تحت كهف مهدم % 9(@)(@@) % إذا ما علت جوز الفلاة مضرة % على الوبر من هزان لم يترمرم % 11(@)(@@) % عوى عبد هزان شقاء فقد هوى % % من السحق لم تلحق يداه بسلم % PageV01P551 البحر : بسيط تام 1(@)(@@) % هل رام أم لم يرم ذو 
ms160	 السدر فالثلم % ذاك الهوى منك لا دان ولا أمم % 2(@)(@@) % إن طلابك شيئا لست نائله % جهل ، وطول لبانات الهوى سقم % 3(@)(@@) % يا عاذلي أقلا اللوم فبكما % % قال الوشاة ، فمعصي ، ومتهم % 4(@)(@@) % إني ببرقة سلمانين آنفني % % منها غذاة بدت دل ومبتسم % % 5(@)(@@) % ذكرتنا مسك داري ، له أرج ، % و بالحتى خزامى طلها الرهم % 6(@)(@@) % حملت رحلي على الأهوال ناجية % مثب القريع المعني شفه السدم % % 7(@)(@@) % من الطوامح أبصارا إذا خشعت % عنها ذرى علم قالوا : بدا علم % 8(@)(@@) % حتى انتهينا إلى من لن نجاوزه % تجري الأيامن لا بخل ولا عدم % % 9(@)(@@) % إلى الأغر الذي ترجى نوافله % إذا الوفود على أبوابه ازدحموا % % 10(@)(@@) % جاءوا ظماء فقد روى دلاءهم % فيض يمد من التيار مقتسم % PageV01P552 11(@)(@@) % أنهض جناحي في ريشي فقد رجعت % ريش الجناحين من آبائك النعم % 12(@)(@@) % أنت ابن عبد العزيز الخير لا رهق % غمر الشباب ولا أزرى بك القدم % 13(@)(@@) % تدعو قريش وأنصار النبي له % إن يمتعوا بأبي حفص وما ظلموا % % 14(@)(@@) % راحوا يحيون محمودا شمائله % صلت الجبين وفي عرنينه شمم % 15(@)(@@) % يرجون منك ولا يخشون مظلمة % عرفا وتمطر من معروفك الديم % 16(@)(@@) % لم تلق جدا كأجداد يعدهم % مروان ذو النور والفاروق والحكم % 17(@)(@@) % أشبهت من عمر الفاروق سيرته ، % سن الفرائض وائتمت به الأمم % 18(@)(@@) % ألفيت بيتك في العلياء مكنه % أس البناء وما في سوره هدم % 19(@)(@@) % والتف عيصك في الأعياص فوق ربى % تجري لهن سواقي الأبطح العظم % 20(@)(@@) % وفي قضاعة بيت غير مؤتشب ، % نعم القديم إذا ما حصل القدم % PageV01P553 21(@)(@@) % و في تميم له عز قراسية % ذو صولة صلقم أنيابه تمم % 22(@)(@@) % أنتم أئمة من صلى ، وعندكم ، % للطامعين وللجيران ، معتصم % 23(@)(@@) % و المستقاد لهم إما مطاوعة % عفوا ، وإما على كره إذا عزموا % % 24(@)(@@) % يا أعظم الناس ، عند العفو ، عافية % و أرهب الناس صولات إذا انتقموا % % 25(@)(@@) % قد جربت مصر والضحاك أنهم % قوم غذا حربوا في حربهم فحم % 26(@)(@@) % هلا سألت بهم مصر التي نكثت ، % أو راهطا يوم يحمي الراية البهم % 27(@)(@@) % عبد العزيز 