ms3531	 ج 4، ح 417.(@)(@@) * وروى مضمرة، وروى بن أبي عمير، عن بعض أصحابنا، عنه.(@)(@@) التهذيب: ج 7، ح 1792.(@)(@@) * وروى عن أبي عمر المتطبب، وروى عنه ظريف بن ناصح.(@)(@@) الكافي: ج 7، ك 4، ب 32، ذيل ح 9، و ب 38، ح 2، و ب 40، ح 1، و ب 51، ح 9. التهذيب: ج 10، ح 668، 1019، 1148.(@)(@@) * وروى عن أبي يحيى الصنعاني، وروى عنه موسى بن سعدان.(@)(@@) الكافي: ج 1، ك 4، ب 42، ح 1.(@)(@@) * وروى عن الحسين بن عثمان، وروى عنه الحسن بن علي بن فضال.(@)(@@) التهذيب: ج 10، ح 1037. PageV11P440(@)(@@) * وروى عن الحسين الرواسي، وروى عنه ظريف بن ناصح.(@)(@@) الفقيه: ج 4، ح 194.(@)(@@) * وروى عن عبد الله بن هاشم، وروى عنه محمد حذاهي.(@)(@@) الكافي: ج 1، ك 4، ب 80، ح 3.(@)(@@) عبد الله بن بحر * روى عن أبي أيوب الخزاز، وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 1، ك 3، ب 21، ح 4.(@)(@@) * وروى عن ابن أذينة، وروى عنه الحسن بن سعيد.(@)(@@) التهذيب: ج 2، ح 313.(@)(@@) * وروى عن ابن مسكان، وروى عنه الحسن بن سعيد.(@)(@@) الكافي: ج 1، ك 4، ب 53، ح 7، و ج 5، ك 2، ب 156، ح 3. والتهذيب: ج 7، ح 608، 983.(@)(@@) وروى عنه العباس بن معروف.(@)(@@) التهذيب: ج 2، ح 423.(@)(@@) * وروى عن حريز، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 3، ك 1، ب 33، ح 6، و ج 5، ك 3، ب 67، ح 3، و ج 7، ك 2، ب 17، ح 7. والتهذيب: ج 1، ح 355 (الاستبصار: ج 1، ح 393)، و ج 2، ح 655 (الاستبصار: ج 1، ح 1080)، و ج 7، ح 424 (الاستبصار: ج 3، ح 317)، و ج 9، ح 1014.(@)(@@) * وروى عن حريز بن عبد الله، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 1138 (الاستبصار:(@)(@@) ج 1، ح 393، وفيه حريز فقط)، و ج 3، ح 289 (الاستبصار: ج 1، ح 1739).(@)(@@) * وروى عن حماد بن عثمان، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 4، ك 3، ب 191، ح 11.(@)(@@) * وروى عن داود بن علي اليعقوبي، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 5، ح 917.(@)(@@) * وروى عن عبد الله بن مسكان، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 7، ك 6، ب 8، ح 3. والتهذيب:(@)(@@) ج 6، ح 517.(@)(@@) وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 69، ح 6.(@)(@@) * وروى عن كردين المسمعي، وروى عنه 
