ms151	 خثعم.(@)(@@)(@@)(@@) $DIC_NIS$ المغيري (@)(@@) بالضم والكسر إلى المغيرة بن سعيد رأس المغيرية من الشيعة.(@)(@@)(@@)(@@) $DIC_NIS$ المغيلي (@)(@@) بالفتح والكسر إلى مغيلة قبيلة من البربر.(@)(@@)(@@)(@@) || باب الميم والفاء(@)(@@)(@@)(@@) $DIC_NIS$ المفتولي (@)(@@) بسكون الفاء إلى بيع المفتول من الحلفاء.(@)(@@)(@@)(@@) $DIC_NIS$ المفرض (@)(@@) بالضم والسكون إلى علم الفرائض.(@)(@@)(@@)(@@) $DIC_NIS$ المفضلي (@)(@@) بالضم وفتح الفاء والمعجمة المشددة إلى المفضل جد.(@)(@@)(@@)(@@) $DIC_NIS$ المفلحي (@)(@@) إلى مفلح جد.(@)(@@)(@@)(@@) $DIC_NIS$ المفيد (@)(@@) الذي يفيد الناس الحديث من الشيوخ.(@)(@@)(@@)(@@) || باب الميم والقاف(@)(@@)(@@)(@@) $DIC_NIS$ المقابري (@)(@@) بالفتح إلى المقابر.(@)(@@)(@@)(@@) $DIC_NIS$ المقاتلي (@)(@@) بالضم وكسر الفوقية إلى مقاتل جد.(@)(@@)(@@)(@@) $DIC_NIS$ المقاعسي (@)(@@) إلى مقاعس بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ المقانعي (@)(@@) بالفتح إلى بيع المقانع.(@)(@@)(@@)(@@) $DIC_NIS$ المقباسي (@)(@@) بالكسر والسكون وموحدة ومهملة إلى مقباس بطن من سلول.(@)(@@)(@@)(@@) $DIC_NIS$ المقبري (@)(@@) بالفتح والسكون وضم الموحدة إلى المقبرة.(@)(@@)(@@)(@@) $DIC_NIS$ المقتدري (@)(@@) إلى المقتدر الخليفة.(@)(@@)(@@)(@@) $DIC_NIS$ المقدسي (@)(@@) بكسر الدال إلى بيت المقدس.(@)(@@)(@@)(@@) $DIC_NIS$ المقدمي (@)(@@) بالضم وفتح القاف والدال المشددة إلى مقدم جد.(@)(@@)(@@)(@@) $DIC_NIS$ المقدي (@)(@@) بفتحتين وتشديد المهملة إلى حصن مقدية بأذرعات. PageV01P250(@)(@@)(@@)(@@) $DIC_NIS$ المقراضي (@)(@@) بالكسر إلى المقراض جد.(@)(@@)(@@)(@@) $DIC_NIS$ المقرائي (@)(@@) بالضم والسكون وفتح الراء وهمزة ثم ياء النسب إلى مقرا قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ المقنعي (@)(@@) بالضم وفتح القاف والنون المشددة ومهملة لأبو محمد الحسن بن علي الجوهري لأنه أول من تقنع تحت العمامة وبالكسر والسكون والفتح إلى بيع المقنعة.(@)(@@)(@@)(@@) $DIC_NIS$ المقني (@)(@@) بالضم والفتح وتشديد النون إلى حفر القناة.(@)(@@)(@@)(@@) $DIC_NIS$ المقومي (@)(@@) بالضم والفتح وكسر الواو المشددة.(@)(@@)(@@)(@@) $DIC_NIS$ المقلاصي (@)(@@) بالكسر والسمكون ومهملة إلى مقلاص قرية بجرجان وجد. PageV01P251(@)(@@)(@@)(@@) $DIC_NIS$ المقياسي (@)(@@) بوزنه إلى مقياس النيل بمصر.(@)(@@)(@@)(@@) || باب الميم والكاف(@)(@@)(@@)(@@) $DIC_NIS$ المكاري (@)(@@) بالضم إلى كراء الدواب.(@)(@@)(@@)(@@) $DIC_NIS$ المكبر (@)(@@) المبلغ تكبير الإمام.(@)(@@)(@@)(@@) $DIC_NIS$ المكتب (@)(@@) إلى تعليم الصبيان الخط.(@)(@@)(@@)(@@) $DIC_NIS$ المكتومي (@)(@@) بالفتح والسكون وضم الفوقية إلى مكتوم جد.(@)(@@)(@@)(@@) $DIC_NIS$ المكحولي (@)(@@) بوزنه إلى مكحول جد.(@)(@@)(@@)(@@) $DIC_NIS$ المكراني (@)(@@) بالضم والسكون إلى مكران بلد بكرمان.(@)(@@)(@@)(@@) $DIC_NIS$ المكشوفي (@)(@@) إلى جد كان مكشوف الرأس.(@)(@@)(@@)(@@) $DIC_NIS$ المكي (@)(@@) إلى مكة شرفها الله تعالى.(@)(@@)(@@)(@@) || باب الميم واللام(@)(@@)(@@)(@@) $DIC_NIS$ الملبراني (@)(@@) إلى ملبران قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الملحمي (@)(@@) بالضم والسكون وفتح المهملة إلى الملحم نوع من الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms152	 الملحي (@)(@@) بالضم والفتح ومهملة إلى الملح والنوادر وإلى مليح بطن من خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الملحي (@)(@@) بالكسر إلى بيع الملح.(@)(@@)(@@)(@@) $DIC_NIS$ الملطي (@)(@@) بفتحتين إلى ملطية مدينة بالروم.(@)(@@)(@@)(@@) $DIC_NIS$ الملجكاني (@)(@@) بضم الميم والجيم إلى ملجكان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الملقي (@)(@@) بالضم هو معبد الدرس.(@)(@@)(@@)(@@) $DIC_NIS$ الملكاني (@)(@@) بفتحات إلى ملكان بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الملنجي (@)(@@) بالكسر والفتح وسكون النون وجيم إلى ملنجة قرية بأصبهان وبالفتح والكسر وتحتية إلى مليج قرية بمصر وبمهملة آخره إلى..(@)(@@) .. PageV01P252(@)(@@)(@@)(@@) $DIC_NIS$ المليكي (@)(@@) بالتصغير إلى أبي مليكة.(@)(@@)(@@)(@@) || باب الميم والميم(@)(@@)(@@)(@@) $DIC_NIS$ الممسي (@)(@@) بالضم والسكون ومهملة إلى ممسة قرية بالغرب.(@)(@@)(@@)(@@) || باب الميم والنون(@)(@@)(@@)(@@) $DIC_NIS$ المناحي (@)(@@) بالفتح وتشديد النون ومهملة إلى مناح جد.(@)(@@)(@@)(@@) $DIC_NIS$ المناديلي (@)(@@) بالفتح وإلى بيع المناديل.(@)(@@)(@@)(@@) $DIC_NIS$ المنادي (@)(@@) بالضم هو الدلال.(@)(@@)(@@)(@@) $DIC_NIS$ المناري (@)(@@) بالفتح وراء إلى منارة بطن من غافق.(@)(@@)(@@)(@@) $DIC_NIS$ المناشيري (@)(@@) بالفتح إلى عمل المنشار.(@)(@@)(@@)(@@) $DIC_NIS$ المناشر (@)(@@) بالضم إلى عمل الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ المناشكي (@)(@@) بالفتح ومعجمة إلى مناشك محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ المناطقي (@)(@@) بوزنه إلى عمل المنطقة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: المناوي (@)(@@) بالضم إلى منية بني خصيب بلد بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المنبجي (@)(@@) بالفتح وسكون النون وكسر الموحدة وجيم إلى منبج مدينة بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ المنبوزي (@)(@@) بالفتح والسكون وضم الموحدة آخره زاي إلى المنبوز جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنتفقي (@)(@@) بالضم والسكون وفتح الفوقية وفاء وقاف إلى المنتفق قبيلة من عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ المنثوري (@)(@@) بضم المثلثة وراء إلى المنثور جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنجاني (@)(@@) بفتح الميم والجيم وسكون النون الأولى إلى منجان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ المنجم (@)(@@) إلى علم النجوم.(@)(@@)(@@)(@@) $DIC_NIS$ المنجنيقي (@)(@@) بقتح الميم والجيم وسكون النون الأولى وكسر الثانية إلى المنجنيق المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ المنجوراني (@)(@@) بالفتح والسكون وضم الجيم وراء إلى منجوران قرية ببلخ. PageV01P253(@)(@@)(@@)(@@) $DIC_NIS$ المنجوي (@)(@@) بالفتح والسكون والضم إلى منجويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنخلي (@)(@@) بالضم وفتح النون والمعجمة المشددة ولام إلى المنخل بطن من سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ المنذري (@)(@@) بالضم والسكون وكسر المعجمة وراء إلى المنذر جد وبطن من كندة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: المنصفي (@)(@@) بالفتح والسكون إلى منصف قرية ببلنسية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المنصوري (@)(@@) إلى المنصور الخليفة والمنصورة قرية بنواحي ملتان قلت: 
ms153	 وأخرى على النيل بطريق دمياط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المنقري (@)(@@) بالضم والفتح وكسر القاف المشددة وراء إلى منقر بطن من تميم وبالكسر والسكون والفتح إلى منقر بن عبيد بن مقاعس.(@)(@@)(@@)(@@) $DIC_NIS$ المنقي (@)(@@) إلى تنقية الطعامز المنكدري: إلى المنكدر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنواثي (@)(@@) بالفتح والسكون آخره مثلثة إلى منواث قرية من عمل عكا.(@)(@@)(@@)(@@) $DIC_NIS$ المنوي (@)(@@) بالفتح والضم إلى منويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنيحي (@)(@@) بالفتح والكسر وتحتية ومهملة إلى المنيحة قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ المنيعي (@)(@@) بوزنه إلى منيع جد.(@)(@@)(@@)(@@) $DIC_NIS$ المنيني (@)(@@) بوزنه إلى منين قرية بدمشق وبضم أوله إلى منينة جدة.(@)(@@)(@@)(@@) $DIC_NIS$ المنيي (@)(@@) بالضم والسكون وكسر التحتية إلى منية عجيب قرية بالأندلس.(@)(@@)(@@)(@@) || باب الميم والواو(@)(@@)(@@)(@@) $DIC_NIS$ المواني (@)(@@) بالضم والتخفيف ونون إلى موان قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ المواقيتي (@)(@@) إلى علم المواقيت. PageV01P254(@)(@@)(@@)(@@) $DIC_NIS$ المؤدب (@)(@@) إلى تعليم الأدب واللغة.(@)(@@)(@@)(@@) $DIC_NIS$ المودودي (@)(@@) بالضم وفتح المهملة إلى مودا قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ المورياني (@)(@@) بالضم وكسر الراء وتحتية ونون إلى موريان قرية بخوزستان.(@)(@@)(@@)(@@) $DIC_NIS$ الموسوي والموسائي:(@)(@@) إلى موسى جد.(@)(@@)(@@)(@@) $DIC_NIS$ الموسياباذي (@)(@@) بالضم وكسر المهملة وتحتية وموحدة وذال معجمة إلى موسياباذ قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الموشيلي (@)(@@) بالضم وكسر المعجمة ولام إلى موشيلا رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الموصلي (@)(@@) بالفتح والسكون وكسر المهملة إلى الموصل مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الموصلائي (@)(@@) بالضم وفتح المهملة إلى موصلايا جد.(@)(@@)(@@)(@@) $DIC_NIS$ الموفقي (@)(@@) إلى الموفق الخليفة وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الموقاني (@)(@@) بالضم وقاف ونون إلى موقان مدينة بدربند.(@)(@@)(@@)(@@) $DIC_NIS$ الموقري (@)(@@) بالضم وفتح الواو والقاف المشددة وراء إلى موقر حصن بالبلقاء.(@)(@@)(@@)(@@) $DIC_NIS$ الموقفي (@)(@@) بالفتح والسكون وكسر القاف وفائ إلى الموقف محلة بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ المولقاباذي (@)(@@) بالضم وسكون الواو وقاف وموحدة ومعجمة إلى مولقاباذ محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الموني (@)(@@) بالفتح والسكون ونون إلى مونة قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الموهبي (@)(@@) بالفتح والسكون وكسر الهاء وموحدة إلى موهب بطن من المعافر.(@)(@@)(@@)(@@) || باب الميم والهاء(@)(@@)(@@)(@@) $DIC_NIS$ المهاجري (@)(@@) إلى المهاجر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المهذبي (@)(@@) إلى مهذب الدولة.(@)(@@)(@@)(@@) $DIC_NIS$ المهراني (@)(@@) بالكسر والسكون إلى مهران جد.(@)(@@)(@@)(@@) $DIC_NIS$ المهراباناني (@)(@@) بالكسر والسكون وراء وموحدة ونونين بينهما ألف إلى مهرابانان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ المهربندقشائي (@)(@@) بالكسر وسكون الهاء والنون والقاف وفتح الراء والموحدة والدال المهملة 
ms154	 والشين المعجمة إلى مهربندقشاة قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ المهرجاني (@)(@@) بالكسر والسكون وفتح الراء والجيم إلى مهرجان مدينة بإسفراين وجد. PageV01P255(@)(@@)(@@)(@@) $DIC_NIS$ المهرقاني (@)(@@) بكسر الميم والراء وقاف إلى مهرقان قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ المهرواني (@)(@@) بالكسر وفتح الراء إلى مهروان ناحية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ المهريجاني (@)(@@) بكسر الميم والراء وتحتية وجيم إلى مهريجان قرية بمرو وبكازرون أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ المهريجميني (@)(@@) بكسر الميمين والراء والجيم إلى مهريجمين قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ المهري (@)(@@) بالفتح والسكون إلى مهرة قبيلة من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المهزمي (@)(@@) بالكسر والسكون وفتح الزاي إلى مهزم.(@)(@@)(@@)(@@) $DIC_NIS$ المهفيروزي (@)(@@) إلى ماه فيروز بكسر الفاء قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ المهلبي (@)(@@) بفتح الهاء واللام المشددة إلى المهلب بن أبي صفرة.(@)(@@)(@@)(@@) $DIC_NIS$ المهلي (@)(@@) بالضم والكسر وتشديد اللام إلى مهل جد.(@)(@@)(@@)(@@) $DIC_NIS$ المهمتي (@)(@@) بفتح الميمين وسكون الهاء آخره فوقية إلى مهمت جد.(@)(@@)(@@)(@@) || باب الميم واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الملاحي (@)(@@) بالفتح وكسر المهملة إلى الملاحم.(@)(@@)(@@)(@@) $DIC_NIS$ الملامسي (@)(@@) بالضم وكسر الميم ومهملة إلى الملامس بن خزيمة الحضرمي.(@)(@@)(@@)(@@) $DIC_NIS$ الملائي (@)(@@) بالضم إلى بيع الملاءة التي يلتحف بها النساء.(@)(@@)(@@)(@@) || باب الميم والياء(@)(@@)(@@)(@@) $DIC_NIS$ المياحي (@)(@@) بالفتح وتشديد التحتية ومهملة إلى مياح جد.(@)(@@)(@@)(@@) $DIC_NIS$ الميافارقي (@)(@@) إلى ميافارقين مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الميانجي (@)(@@) بالفتح والتحتية وفتح النون وجيم إلى ميانج موضع بالشام وإلى ميانة بلد بأذربيجان. PageV01P256(@)(@@)(@@)(@@) $DIC_NIS$ الميبذي (@)(@@) بالفتح وسكون التحتية وضم والموحدة ومعجمة إلى مبيذ بلد قرب يزد.(@)(@@)(@@)(@@) $DIC_NIS$ الميتمي (@)(@@) بفتح أوله والفوقية بينهما تحتية ساكنة إلى ميتم قبيلة من حمير وبالمثلثة إلى ميثم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الميتي (@)(@@) إلى الميتة جدة.(@)(@@)(@@)(@@) $DIC_NIS$ الميداني (@)(@@) بفتح أوله والمهملة إلى ميدان زياد بنيسابور والميدان محلة بها.(@)(@@)(@@)(@@) $DIC_NIS$ الميرقي (@)(@@) بالفتح وضم التحتية وسكون الراء وقاف إلى ميرقة جزيرة الأندلس الميرهاني: بالكسر وفتح الراء إلى ميرماهان قرية بمرو الميساني: بالفتح والمهملة إلى ميسان الميشجاني: بفتح الميم والمعجمة والجيم إلى ميشجان قرية باسفراين بلدة بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الميشقي (@)(@@) بالكسر وفتح المعجمة وقاف إلى ميشقة قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الميغني (@)(@@) بالكسر وفتح الغين المعجمة ونون إلى ميغن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الميغي (@)(@@) بالكسر ومعجمة إلى ميغ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الميكالي (@)(@@) إلى ميكال رجل.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms155	 الميماسي (@)(@@) بالكسر ومهملة إلى ميماس قرية بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الميمذي (@)(@@) بفتح الميمين ومعجمة إلى ميمذ. PageV01P257(@)(@@)(@@)(@@) $DIC_NIS$ الميموني (@)(@@) إلى ميمون رجل وقرية قرب واسط.(@)(@@)(@@)(@@) $DIC_NIS$ الميهني (@)(@@) بالكسر وفتح الهاء ونون إلى ميهنة قرية بخابران.(@)(@@)(@@)(@@) $DIC_NIS$ الميلاقاني (@)(@@) بالكسر وقاف إلى ميلاقان قرية بمرو.(@)(@@)(@@)(@@) | حرف النون(@)(@@)(@@)(@@) || باب النون والألف(@)(@@)(@@)(@@) $DIC_NIS$ النابتي (@)(@@) إلى نابت جد.(@)(@@)(@@)(@@) $DIC_NIS$ النابغي (@)(@@) بكسر الموحدة ومعجمة إلى النابغة جد.(@)(@@)(@@)(@@) $DIC_NIS$ النابلسي (@)(@@) بضم الموحدة واللام ومهملة إلى نابلس بلد بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الناتلي (@)(@@) بكسر الفوقية ولام إلى ناتل بلد بآمل طبرستان وبطن من الصدف ومن قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الناجي (@)(@@) بالجيم إلى ناحية قبيلة من سامة بن لؤي وبطن من قيس عيلان ومن جعفي وإلى ناجية بنت غزوان أخت عتبة.(@)(@@)(@@)(@@) $DIC_NIS$ الناخلي (@)(@@) إلى نخل الدقيق.(@)(@@)(@@)(@@) $DIC_NIS$ النارناباذي (@)(@@) بفتح الراء ونون وموحدة ومعجمة إلى نارناباذ قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الناري (@)(@@) إلى النار بطن من بني الحارث بن كعب.(@)(@@)(@@)(@@) $DIC_NIS$ الناسري (@)(@@) بكسر المهملة وراء.(@)(@@)(@@)(@@) $DIC_NIS$ الناشري (@)(@@) بكسر المعجمة وراء إلى ناشرة بطن من همدان ومن أسد بن خزيمة.(@)(@@)(@@)(@@) $DIC_NIS$ الناصحي (@)(@@) إلى ناصح جد.(@)(@@)(@@)(@@) $DIC_NIS$ الناضري (@)(@@) بكسر المعجمة وراء إلى ناضرة بطن من سليم.(@)(@@)(@@)(@@) $DIC_NIS$ الناطقي (@)(@@) بكسر الطاء وفاء إلى بيع الناطف.(@)(@@)(@@)(@@) $DIC_NIS$ الناعطي (@)(@@) بكسر المهملة إلى ناعط بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ النافخسي (@)(@@) بفتح الفاء والخاء المعجمة ومهملة إلى نافخس قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ النافعي (@)(@@) إلى نافع جد والمقرىء وابن الأزرق الخارجي رأس النافعية. PageV01P258(@)(@@)(@@)(@@) $DIC_NIS$ النافقاني (@)(@@) بفتح الفاء والقاف إلى نافقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الناقد (@)(@@) إلى نقد الذهب والحديث.(@)(@@)(@@)(@@) $DIC_NIS$ الناقدي (@)(@@) إلى الناقد.(@)(@@)(@@)(@@) $DIC_NIS$ الناقط (@)(@@) إلى نقط المصحف.(@)(@@)(@@)(@@) $DIC_NIS$ الناقمي (@)(@@) إلى ناقم بطن من ربيعة بن نزار.(@)(@@)(@@)(@@) $DIC_NIS$ النامقي (@)(@@) بفتح الميم وقاف قارىء المناشير بالعجمية ونامق بها الكتاب.(@)(@@)(@@)(@@) $DIC_NIS$ النايتي (@)(@@) بكسر التحتية وفوقية إلى نايت ناحية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ النايلي (@)(@@) إلى نائلة جدة.(@)(@@)(@@)(@@) $DIC_NIS$ الناينجي (@)(@@) بفتح التحتية وسكون النون وجيم إلى ناينج بلد بأصبهان.(@)(@@)(@@)(@@) || باب النون والباء (@)PageV01P259(@)(@@)(@@)(@@) $DIC_NIS$ النباتي (@)(@@) بالفتح إلى نابت جد وبالضم إلى نباتة جد الشاعر وغيره.(@)(@@)(@@)(@@) $DIC_NIS$ النباجي (@)(@@) بالكسر وتحفيف الموحدة وجيم إلى النباج قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ النبال 
ms156	 (@)(@@) إلى بيع النبل.(@)(@@)(@@)(@@) $DIC_NIS$ النبري (@)(@@) بالكسر وفتح الموحدة المشددة وراء إلى النبر قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ النبطي (@)(@@) بفتحتين إلى النبط قوم من العجم.(@)(@@)(@@)(@@) $DIC_NIS$ النبقي (@)(@@) بفتحتين وقاف إلى دار النبقة بمكة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ النبلي (@)(@@) بالفتح والسكون إلى بيع النبل.(@)(@@)(@@)(@@) $DIC_NIS$ النبهاني (@)(@@) بالفتح والسكون إلى نبهان بطن من طيء.(@)(@@)(@@)(@@) || باب النون والجيم(@)(@@)(@@)(@@) $DIC_NIS$ النجاحي (@)(@@) إلى نجاح جد.(@)(@@)(@@)(@@) $DIC_NIS$ النجاد (@)(@@) بتشديد الجيم إلى الصنعة المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ النجادي (@)(@@) مثله إلى نجاد جد.(@)(@@)(@@)(@@) $DIC_NIS$ النجار (@)(@@) إلى نجر الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ النجاري (@)(@@) إلى بني النجار قبيلة من الخزرج. ومحلة بني النجار بالكوفة والنجارية من المبتدعة إلى الحسين بن محمد النجار الرازي.(@)(@@)(@@)(@@) $DIC_NIS$ النجانيكثي (@)(@@) بالضم وجيم وكسر النون وتحتية وفتح الكاف ومثلثة إلى نجانيكث بلد بنواحي سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ النجدي (@)(@@) بالفتح والسكون ومهملة إلى نجد أرض بين العراق والحجاز.(@)(@@)(@@)(@@) $DIC_NIS$ النجراني (@)(@@) بالفتح والسكون وراء إلى نجران ناحية بين اليمن وهجر.(@)(@@)(@@)(@@) $DIC_NIS$ النجيحي (@)(@@) إلى نجيح جد.(@)(@@)(@@)(@@) $DIC_NIS$ النجيرمي (@)(@@) بفتح النون والراء وكسرالجيم إلى نجيرم محلة بالبصرة.(@)(@@)(@@)(@@) || باب النون والحاء (@)PageV01P260(@)(@@)(@@)(@@) $DIC_NIS$ النحات (@)(@@) إلى نحت الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ النحاس (@)(@@) إلى بيع النحاس.(@)(@@)(@@)(@@) $DIC_NIS$ النحلي (@)(@@) بالفتح وسكون المهملة إلى نحل قرية ببخارى وبالكسر إلى نحلين قرية بحلب.(@)(@@)(@@)(@@) $DIC_NIS$ النحوي (@)(@@) إلى علم النحو وإلى بطن من الأزد.(@)(@@)(@@)(@@) || باب النون والخاء(@)(@@)(@@)(@@) $DIC_NIS$ النخاس (@)(@@) بتشديد الخاء المعجمة الدلال.(@)(@@)(@@)(@@) $DIC_NIS$ النخالي (@)(@@) بالضم إلى بيع النخالة.(@)(@@)(@@)(@@) $DIC_NIS$ النخاني (@)(@@) بالفتح إلى نخان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ النخدي (@)(@@) بفتحتين ومعجمة إلى أندخود بلد بين بلخ ومرو.(@)(@@)(@@)(@@) $DIC_NIS$ النخري (@)(@@) بالضم والسكون وراء إلى نخرة جد.(@)(@@)(@@)(@@) $DIC_NIS$ النخشبي (@)(@@) بفتح النون والشين المعجمة وسكون الخاء آخره موحدة إلى نخشب وهي نسف.(@)(@@)(@@)(@@) $DIC_NIS$ النخعي (@)(@@) بفتحتين إلى النخع قبيلة من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ النخلي (@)(@@) بالفتح والسكون إلى النخلة قرية عند مكة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ النخلاني (@)(@@) كذلك إلى نخلان فخذ من السلف.(@)(@@)(@@)(@@) || باب النون والدال(@)(@@)(@@)(@@) $DIC_NIS$ الندبي (@)(@@) بفتح النون والمهملة وموحدة إلى الندب بطن من الأزد.(@)(@@)(@@)(@@) || باب النون والذال(@)(@@)(@@)(@@) $DIC_NIS$ النذيري (@)(@@) بالفتح وكسر المعجمة آخره راء إلى نذير بطن من بجيلة وبالتصغير إلى نذير جد.(@)(@@)(@@)(@@) || باب 
ms157	 النون والراء(@)(@@)(@@)(@@) $DIC_NIS$ النرسي (@)(@@) بالفتح والسكون ومهملة إلى نرس نهر بالكوفة عليه عدة قرى. PageV01P261(@)(@@)(@@)(@@) $DIC_NIS$ النرشخي (@)(@@) بفتح النون والشين المعجمة وسكون الراء آخره معجمة إلى نرشخ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ النرمقي (@)(@@) بوزنه وقاف إلى نرمة قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ النريزي (@)(@@) بالفتح وكسر الراء آخره زاي إلى نريز قرية بأذربيجان.(@)(@@)(@@)(@@) || باب النون والسين(@)(@@)(@@)(@@) $DIC_NIS$ النسابة (@)(@@) إلى علم الأنساب.(@)(@@)(@@)(@@) $DIC_NIS$ النساخ (@)(@@) إلى نسخ الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ النسائي (@)(@@) بالفتح والهمز والنسوي إلى نسا مدينة بخراسان.(@)(@@)(@@)(@@) $DIC_NIS$ النسطاسي (@)(@@) بالكسر وسكونه المهملة الأولى إلى نسطاس جد.(@)(@@)(@@)(@@) $DIC_NIS$ النسفي (@)(@@) بفتحتين وفاء إلى نسف مدينة بما وراء النهر ويقال لها نخشب.(@)(@@)(@@)(@@) || باب النون والشين(@)(@@)(@@)(@@) $DIC_NIS$ النشاستجي (@)(@@) بفتح النون والمعجمة والفوقية بعد مهملة قبل جيم إلى النشاستج وهو النشاء المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ النشائي (@)(@@) بفتحتين إلى النشاء المعروف ونشا قرية بريف مصر.(@)(@@)(@@)(@@) $DIC_NIS$ النشتبري (@)(@@) بكسر أوله وثالثه كذا ضبطه الدمياطي رحمه الله فيما نقله أبو جعفر بن الكريك في تذكيرته انتهى. PageV01P262(@)(@@)(@@)(@@) $DIC_NIS$ النشغي (@)(@@) بالفتح والسكون وغين معجمة إلى نشغة بطن من عذرة.(@)(@@)(@@)(@@) $DIC_NIS$ النشكي (@)(@@) بالفتح والسكون إلى نشك قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ النشوي (@)(@@) بفتحتين إلى نشا قرية بأذربيجان وبمصر.(@)(@@)(@@)(@@) || باب النون والصاد(@)(@@)(@@)(@@) $DIC_NIS$ النصراباذي (@)(@@) بفتح النون والراء والموحدة وسكون الصاد المهملة آخره معجمة إلى نصراباذ محلة بنيسابور وبالري أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ النصروي (@)(@@) بالفتح والسكون والضم إلى نصرويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ النصري (@)(@@) إلى نصر قبيلة من هوازن ومن بني أسد بن خزيمة وجد والنصرية محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ النصاح (@)(@@) الخياط.(@)(@@)(@@)(@@) $DIC_NIS$ النصيبي (@)(@@) بالفتح والكسر آخره موحدة إلى نصيبين مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ النصيري (@)(@@) بالتصغير إلى نصير جد ودرب نصير ببغداد ومذهب نصير من الشيعة.(@)(@@)(@@)(@@) || باب النون والضاد(@)(@@)(@@)(@@) $DIC_NIS$ النضاري (@)(@@) بالضم ومعجمة وراء إلى نضار بطن من همدان ومن سليم.(@)(@@)(@@)(@@) $DIC_NIS$ النضروي (@)(@@) بالفتح والسكون والضم إلى نضرويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ النضيري (@)(@@) مكبرا إلى بني النضير قبيلة من اليهود.(@)(@@)(@@)(@@) || باب النون والطاء(@)(@@)(@@)(@@) $DIC_NIS$ النطاحي (@)(@@) بالفتح والتشديد إلى النطاح جد. PageV01P263(@)(@@)(@@)(@@) $DIC_NIS$ النطنزي (@)(@@) بفتحتين وسكون النون ثم زاي إلى نظنز بلد بأصبهان.(@)(@@)(@@)(@@) || باب النون والظاء(@)(@@)(@@)(@@) $DIC_NIS$ النظامية (@)(@@) من المعتزلة بالتشديد إلى النظام إبراهيم بن 
ms158	 سيار.(@)(@@)(@@)(@@) || باب النون والعين(@)(@@)(@@)(@@) $DIC_NIS$ النعالي (@)(@@) بالكسر إلى بيع النعال.(@)(@@)(@@)(@@) $DIC_NIS$ النعماني (@)(@@) بالضم إلى النعمانية بلد بين بغداد وواسط.(@)(@@)(@@)(@@) $DIC_NIS$ النعيتي (@)(@@) بالفتح والكسر وتحتية وفوقية إلى النعيت بطن من سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ النعيلي (@)(@@) بالضم وفتح المهملة إلى نعيلة بنت مليل أخي غفار.(@)(@@)(@@)(@@) $DIC_NIS$ النعيمي (@)(@@) بالفتح والكسر إلى نعيمة بطن من الكلاع وبالتصغير إلى نعيم جد.(@)(@@)(@@)(@@) || باب النون والغين(@)(@@)(@@)(@@) $DIC_NIS$ النغوبي (@)(@@) بالفتح وضم المعجمة وموحدة إلى نغويا قرية.(@)(@@)(@@)(@@) || باب النون والفاء(@)(@@)(@@)(@@) $DIC_NIS$ النفاثي (@)(@@) بالضم وفاء ومثلثة إلى نفاثة بطن من كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ النفاخي (@)(@@) بالفتح والتشديد ومهملة إلى النفاخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ النفاط.(@)(@@) إلى عمل النفط.(@)(@@)(@@)(@@) $DIC_NIS$ النفري (@)(@@) بالكسر وفتح الفاء المشددة وراء إلى نفر بلد على النرس قلت: وبسكون الفاء وزاي إلى نفرة قبيلة من البربر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ النفوسي (@)(@@) بضمتين ومهملة إلى نفوسة قبيلة من البربر.(@)(@@)(@@)(@@) $DIC_NIS$ النفيلي (@)(@@) بالتصغير إلى نفيل جد.(@)(@@)(@@)(@@) || باب النون والقاف(@)(@@)(@@)(@@) $DIC_NIS$ النقادي (@)(@@) بضم النون ومهملة إلى نقادة جد وقرية بفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ النقاش (@)(@@) إلى نقش السقوف ونحوها.(@)(@@)(@@)(@@) $DIC_NIS$ النقاض (@)(@@) بمعجمة إلى عمل الإبريسم وفتله.(@)(@@)(@@)(@@) $DIC_NIS$ النقاط (@)(@@) إلى نقط المصحف.(@)(@@)(@@)(@@) $DIC_NIS$ النقال (@)(@@) إلى نقل الأشياء.(@)(@@)(@@)(@@) $DIC_NIS$ النقبوني (@)(@@) بفتحتين وضم الموحدة ونون إلى نقبون ويقال بالكاف بدل القاف قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ النقري (@)(@@) بضمتين وراء إلى نقر بطن من أحمس.(@)(@@)(@@)(@@) $DIC_NIS$ النقوي (@)(@@) بفتحتين إلى نقوة قرية بصنعاء اليمن. PageV01P264(@)(@@)(@@)(@@) $DIC_NIS$ النقيائي (@)(@@) بفتحات إلى نقيا قرية بالأنبار.(@)(@@)(@@)(@@) $DIC_NIS$ النقيري (@)(@@) بالضم والفتح وتحتية وراء إلى نقيرة جد.(@)(@@)(@@)(@@) $DIC_NIS$ النقيشي (@)(@@) بوزنه ومعجمة إلى نقيش جد.(@)(@@)(@@)(@@) || باب النون والكاف(@)(@@)(@@)(@@) $DIC_NIS$ النكبوني (@)(@@) مر آنفا في النقبوني.(@)(@@)(@@)(@@) $DIC_NIS$ النكري (@)(@@) بالضم والسكون وراء إلى نكرة بطن من عبد القيس ومن أسد بن خزيمة.(@)(@@)(@@)(@@) || باب النون والميم(@)(@@)(@@)(@@) $DIC_NIS$ النماري (@)(@@) بالضم وراء إلى نمارة بطن من لخم وغيره.(@)(@@)(@@)(@@) $DIC_NIS$ النمذاباذي (@)(@@) بفتح النون والميم والمعجمة والموحدة آخره معجمة إلى نمذاباذ محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ النمذياني (@)(@@) بفتح أوله والميم والتحتية وكسر الذال المعجمة إلى نمذيان قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ النمري (@)(@@) بفتحتين وراء إلى النمر بطن من ربيعة بن نزار ومن الأزد ومن قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms159	 النمطي (@)(@@) بفتحتين إلى النمط جد.(@)(@@)(@@)(@@) $DIC_NIS$ النمكباني (@)(@@) بفتحات وبعد الكاف موحدة إلى نمكبان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ النميري (@)(@@) مصغرا إلى نمير بن عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ النميلي (@)(@@) يوزنه إلى نميلة جد.(@)(@@)(@@)(@@) || باب النون والواو(@)(@@)(@@)(@@) $DIC_NIS$ النواء (@)(@@) إلى بيع النوا.(@)(@@)(@@)(@@) $DIC_NIS$ النواسي (@)(@@) بالضم إلى أبي نواس الشاعر.(@)(@@)(@@)(@@) $DIC_NIS$ النواوي (@)(@@) بالفتح إلى نوا قرية بسمرقند قلت: وبالشام مهنا شيخ المذهب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ النوبختي (@)(@@) بالضم وفتح الموحدة وسكون المعجمة وفوقية إلى نوبخت جد. PageV01P265(@)(@@)(@@)(@@) $DIC_NIS$ النوبندجاني (@)(@@) بفتح أوله والموحدة والمهملة والجيم وسكون النون بعد الباء الموحدة إلى النوبندجان بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ النوبي (@)(@@) بالضم وموحدة إلى النوبة نوع من السودان.(@)(@@)(@@)(@@) $DIC_NIS$ النوجاباذي (@)(@@) بفتح أوله والجيم والموحدة ثم معجمة إلى نوجاباذ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ النوحي (@)(@@) بالضم ومهملة إلى نوح جد.(@)(@@)(@@)(@@) $DIC_NIS$ النوخسي (@)(@@) بفتح أوله والخاء المعجمة ثم مهملة إلى نوخس من رستاق بخارى.(@)(@@)(@@)(@@) $DIC_NIS$ النوردي (@)(@@) بالضم والسكون وراء ومهملة إلى نورد بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ النوري (@)(@@) بالضم وراء إلى نور بلد بين بخارى وسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ النوزاباذي (@)(@@) بالضم وفتح الزاي والموحدة ومعجمة إلى نوزاباذ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ النوسي (@)(@@) بالفتح والسكون ومهملة إلى نوس قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ النوشاري (@)(@@) بالضم ومعجمة وراء إلى نوشار قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ االنوشاني (@)(@@) بوزنه إلى نوشان جد.(@)(@@)(@@)(@@) $DIC_NIS$ النوشجاني (@)(@@) بالضم ومعجمة وجيم إلى نوشجان بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ النوشري (@)(@@) بالضم وفتح المعجمة وراء إلى نوشر قرية وجد.(@)(@@)(@@)(@@) $DIC_NIS$ النوفلي (@)(@@) بفتح النون والفاء إلى نوفل بن عبد مناف ونوفل بن الحارث بن عبد المطلب.(@)(@@)(@@)(@@) $DIC_NIS$ النوقاني (@)(@@) بالفتح والسكون وقاف إلى نوقان مدينة بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ النوقدي (@)(@@) بفتح النون والقاف ومهملة إلى نوقد قريتين بنسف وبمعجمة إلى نوقذ. PageV01P266(@)(@@)(@@)(@@) $DIC_NIS$ النوقي (@)(@@) بالضم وقاف إلى نوق قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ النوكدكي (@)(@@) بفتح النون والكاف الأولى والمهملة إلى نوكدك قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ لنوكندي (@)(@@) بفتح أوله والكاف وسكون الواو والنون ومهملة إلى نوكند قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ النوماهوي (@)(@@) بالفتح وضم الهاء قرية بطبس.(@)(@@)(@@)(@@) $DIC_NIS$ النومودي (@)(@@) بفتح النون والميم وسكون الواوين ومهملة إلى نومود جد.(@)(@@)(@@)(@@) $DIC_NIS$ النوندي (@)(@@) بالضم وسكون الواو ومهملة إلى نوند سكة بنيسابور ومحلة بسمرقند. 
ms160	(@)(@@)(@@)(@@) $DIC_NIS$ النووي (@)(@@) ويقال النواوي أيضا وهو تقدم.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: النوبري (@)(@@) بالتصغير وراء إلى النويرة بلد من عمل الهنسا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ النويزي (@)(@@) بالتصغير وزاي إلى نويز. PageV01P267(@)(@@)(@@)(@@) $DIC_NIS$ النوي (@)(@@) بالفتح والتشديد إلى نو قرية بأرهيسان.(@)(@@)(@@)(@@) || باب النون والهاء(@)(@@)(@@)(@@) $DIC_NIS$ النهاري (@)(@@) بالفتح وراء إلى نهار بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ النهاوندي (@)(@@) بالضم وفتح الواو وسكون النون ومهملة إلى نهاوند مدينة من بلاد الجبل.(@)(@@)(@@)(@@) $DIC_NIS$ النهدي (@)(@@) بالفتج والسكون إلى نهد بطن من قضاعة ومن همدان.(@)(@@)(@@)(@@) $DIC_NIS$ النهريبني (@)(@@) بالفتح والسكون وضم الراء وكسر الموحدة وتحتية ونون إلى نهربين قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ النهرتيري (@)(@@) بوزنه وفوقية إلى نهرتير بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ النهرديري (@)(@@) بفتح النون والراء والمهملة وسكون التحتية وراء إلى نهر الدير قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ النهرسابسي (@)(@@) بالفتح ومهملتين وضم الموحدة إلى نهرسابس قرية بالكوفة. PageV01P268(@)(@@)(@@)(@@) $DIC_NIS$ النهرواني (@)(@@) بفتحات وسكون الهاء إلى نهروان بلد قرب بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ النهري (@)(@@) إلى نهر القلابين محلة ببغداد قلت: وإلى درب النهر اسم لموضعين بها انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ النهشلي (@)(@@) بفتح أوله والمعجمة إلى نهشل بطن من تميم ومن كلب.(@)(@@)(@@)(@@) $DIC_NIS$ النهمي (@)(@@) بالكسر والسكون إلى نهم بطن من همدان وبالضم والسكون إلى نهم بطن من بجيلة ومن قضاعة وبالضم والفتح إلى نهم بطن من عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ النهوذي (@)(@@) بالفتح والضم ومعجمة إلى نهوذ بلد بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ النهيكي (@)(@@) بالفتح والكسر إلى نهيك بن عامر بن صعصعة.(@)(@@)(@@)(@@) || باب النون والياء(@)(@@)(@@)(@@) $DIC_NIS$ النيازكي (@)(@@) بالكسر وفتح التحتية والزاي إلى نيازى قرية بين كس ونسف ويقال في النسب إليها نيازي ونيازوي زنيازجي.(@)(@@)(@@)(@@) $DIC_NIS$ النيربي (@)(@@) بفتح النون والراء وموحدة إلى نيرب قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ النيرماني (@)(@@) بالكسر وفتح الراء المهملة إلى نيرمان قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ النيريزي (@)(@@) بالفتح والسكون وكسر الراء آخره زاي إلى نيريز قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ النيري (@)(@@) بالكسر والسكون وراء إلى نير قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ النيزكي (@)(@@) بفتح النون والزاي إلى نيزك جد.(@)(@@)(@@)(@@) $DIC_NIS$ النيسابوري (@)(@@) بالفتح إلى نيسابور أشهر مدن خراسان.(@)(@@)(@@)(@@) $DIC_NIS$ النيظري (@)(@@) بفتح النون والظاء المعجمة وراء إلى نيظر لقب جد. PageV01P269(@)(@@)(@@)(@@) $DIC_NIS$ النيلي (@)(@@) بالكسر إلى بيع النيل وإلى النيل بلد على الفرات.(@)(@@)(@@)(@@) $DIC_NIS$ 