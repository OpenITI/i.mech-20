ms1492	 .(@)(@@)(@@)(@@) $ ( 13453 ) قال النبي :(@)(@@) | 30 ( صاحب العلم يستغفر له كل شيء حتى الحوت في البحر ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13454 ) قال النبي :(@)(@@) | 30 ( صاحب اليمين أمير على صاحب الشمال ، فإذا عمل العبد حسنة كتبها بعشر أمثالها ، وإذا عمل سيئة فأراد صاحب الشمال أن يكتبها قال له صاحب اليمين أمسك فيمسك ست ساعات فإن استغفر الله منها لم يكتب عليه شيئا ، وإن لم يستغفر كتب عليه سيئة واحدة ) )(@)(@@) ( طب هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13455 ) قال النبي :(@)(@@) | 30 ( صالح المؤمنين : أبو بكر وعمر ) )(@)(@@) ( طب ) و ابن مردويه عن ابن مسعود رضي الله عنه .(@)(@@) PageV05P070(@)(@@)(@@)(@@) $ ( 13456 ) قال النبي :(@)(@@) | 30 ( صام نوح الدهر إلا يوم الفطر والأضحى ، وصام داود نصف الدهر ، وصام إبراهيم ثلاثة أيام من كل شهر ، صام الدهر وأفطر الدهر ) )(@)(@@) ( طب هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13457 ) قال النبي :(@)(@@) | 30 ( صام نوح الدهر إلا يوم الفطر ويوم الأضحى ) )(@)(@@) ( ه ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13458 ) قال النبي :(@)(@@) | 30 ( صاحب الأربعين يصرف عنه أنواع البلاء والأمراض والجذام والبرص وما أشبهها ، وصاحب الخمسين يرزق الإنابة ، وصاحب الستين يخفف عنه السيئات ، وصاحب السبعين يحبه الله والملائكة في السماء ، وصاحب الثمانين تكتب حسناته ولا تكتب سيئاته ، وصاحب التسعين أسير الله في الأرض فيشفع في نفسه وفي أهل بيته ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13459 ) قال النبي :(@)(@@) | 30 ( صاحب الفدية يأكل منها ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13460 ) قال النبي :(@)(@@) | 30 ( صاحب البطن لا يعذب في قبره ) )(@)(@@) ( طب ) عن سل يمان بن صرد وخالد بن عرفطة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13461 ) قال النبي :(@)(@@) | 30 ( صائم رمضان في السفر كالمفطر في الحضر ) )(@)(@@) ( ه ) عن عبد الرحمان بن عوف رضي الله عنه ( ن ) عنه موقوفا .(@)(@@) PageV05P071(@)(@@)(@@)(@@) ||| ( الصاد مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13462 ) قال النبي :(@)(@@) | 30 ( صبحوا بالصبح فإنه أعظم للأجر ) )(@)(@@) أبو بكر بن كامل في معجمه وابن النجار عن بلال رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13463 ) قال 
ms1493	 الن بي :(@)(@@) | 30 ( صبيحة ليلة القدر تطلع الشمس لا شعاع لها كأنها طست حتى ترتفع ) )(@)(@@) ( حم م 3 ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13464 ) قال النبي :(@)(@@) | 30 ( صبرا يا أبا ياسر وآل ياسر فإن موعدكم الجنة ) )(@)(@@) الحاكم في الكنى ا عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13465 ) قال النبي :(@)(@@) | 30 ( صبرا آل ياسر فإن مصيركم إلى الجنة ) )(@)(@@) الحارث ( حل ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13466 ) قال النبي :(@)(@@) | 30 ( صبوا علي سبع قرب لم تحلل أوكيتهن لعلي أستريح فأعهد إلى الناس ) )(@)(@@) ( عب ) عن عائشة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الصاد مع الحاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13467 ) قال النبي :(@)(@@) | 30 ( صح جسمك يا خوات ، ف الله بما وعدته ، إنه PageV05P072 ليس من مريض يمرض إلا نذر شيئا أو نوى شيئا من الخير ، فف الله بما وعدته ) )(@)(@@) ابن قانع وابن السني في عمل يوم وليلة ( طب ك ض ) عن خوات بن صالح بن خوات بن جبير عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 13468 ) قال النبي :(@)(@@) | 30 ( صحبهما الله ، إن عثمان لأول من هاجر إلى الله تعالى بأهله بعد لوط ) )(@)(@@) ( ع هق ) عن أنس أن عثمان رضي الله عنه هاجر إلى الحبشة ومعه امرأته فقال النبي فذكره .(@)(@@)(@@)(@@) ||| ( الصاد مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13469 ) قال النبي :(@)(@@) | 30 ( صدق ابن مسعود ، زوجك وولدك أحق من تصدقت به عليهم ) )(@)(@@) ( خ ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13470 ) قال النبي :(@)(@@) | 30 ( صدق الله فصدقه ) )(@)(@@) ( طب ك ) عن شداد بن الهاد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13471 ) قال النبي :(@)(@@) | 30 ( صدق الله ورسوله ، إنما أموالكم وأولادكم فتنة ، نظرت إلى هاذين الصبيين يمشيان ويعثران فلم أصبر حتى قطعت حديثي ورفعتهما ) )(@)(@@) ( حم 4 حب ك ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13472 ) قال النبي :(@)(@@) | 30 ( صدقت ، المسلم أخو المسلم ) )(@)(@@) ( حم ه ك ) عن سويد بن حنظلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13473 ) قال النبي :(@)(@@) | 30 ( صدقة السر تطفىء غضب الرب ) )(@)(@@) ( طص ) عن PageV05P073 عبد الله بن جعفر العسكري في السرائر 
ms1494	 عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13474 ) قال النبي :(@)(@@) | 30 ( صدقة السر تطفىء غضب الرب ، وصلة الرحم تزيد في العمر ، وفعل المعروف يقي مصارع السوء ) )(@)(@@) ( هب ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13475 ) قال النبي :(@)(@@) | 30 ( صدقة الفطر صاع تمر أو صاع شعير عن كل رأس ، أو صاع بر بين اثنين صغير أو كبير ، حر أو عبد ، ذكر أو أنثى ، غني أو فقير ، أما غنيكم فيزكيه الله تعالى ، وأما فقيركم فيرد الله عليه أكثر مما أعطاه ) )(@)(@@) ( حم د ) عن عبد الله بن ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13476 ) قال النبي :(@)(@@) | 30 ( صدقة الفطر صاع من تمر ، أو صاع من شعير ، أو مدان من حنطة عن كل صغير وكبير ، وحر وعبد ) )(@)(@@) ( قط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13477 ) قال النبي :(@)(@@) | 30 ( صدقة الفطر على كل إنسان مدان من دقيق أو قمح ، ومن الشعير صاع ، ومن الحلوى زبيب أو تمر صاع صاع ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13478 ) قال النبي :(@)(@@) | 30 ( صدقة الفطر على كل صغير وكبير ، ذكر وأنثى ، حر أو مملوك : نصف صاع من بر ، أو صاع من تمر ، أو صاع من شعير ) )(@)(@@) ( قط ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13479 ) قال النبي :(@)(@@) | 30 ( صدقة المرء المسلم تزيد في العمر وتمنع ميتة السوء ، ويذهب الله تعالى بها الفخر والكبر ) )(@)(@@) أبو بكر بن مقسم في جزئه عن عمرو بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13480 ) قال النبي :(@)(@@) | 30 ( صدقة تصدق الله بها عليكم فاقبلوا صدقته ) )(@)(@@) PageV05P074 ( ق 4 ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13481 ) قال النبي :(@)(@@) | 30 ( صدقة ذي الرحم على ذي الرحم صدقة وصلة ) )(@)(@@) ( طس ) عن سل مان بن عامر رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13482 ) قال النبي :(@)(@@) | 30 ( صدق أبي فإذا سمعت إمامك يتكلم فانصت حتى يتكلم ) )(@)(@@) ( حم ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13483 ) قال النبي :(@)(@@) | 30 ( صدق ، من أحق بالعدل مني ، لا قدس الله تعالى أمة لا يأخذ ضعيفها حقه من شديدها وهو لا يتعتعه ، يا 
ms1495	 خولة غديه وادهنيه واقضيه ، فإنه ليس من غريم يخرج من عند غريمه راضيا إلا صلت عليه دواب البر ونون البحار ، وليس من غريم يلوي غريمه وهو يجد إلا كتب الله تعالى عليه في كل يوم وليلة إثما ) )(@)(@@) ( طب طس ) عن خولة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13484 ) قال النبي :(@)(@@) | 30 ( صدقت ، أرض تنبت على شدة ولن تهلك بأنهم يعملون بأيديهم ويؤاكلون عبيدهم ) )(@)(@@) ( طب ) عن يزيد بن معبد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13485 ) قال النبي :(@)(@@) | 30 ( صدقت هو أخوك ابن أبيك وأمك آدم وحواء ، لك أجر بيمينك هاذه عظيمة ) )(@)(@@) ابن قانع عن بشر ؛ بن حنظلة الجعفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13486 ) قال النبي :(@)(@@) | 30 ( صدقك وهو كذوب ) )(@)(@@) ( ك ) عن ابن عباس ( طب ) عن أبي أسيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 13487 ) قال النبي :(@)(@@) | 30 ( صدقت أم طليق لو أعطيتها جملك كان في سبيل الله ، ولو أعطيتها ناقتك كان في سبيل الله ، ولو أعطيتها من نفقتك أخلفكها الله ) )(@)(@@) PageV05P075 البغوي عن أبي طليق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13488 ) قال النبي :(@)(@@) | 30 ( صدقة السر تطفىء غضب الله ، وصنائع المعروف تقي مصارع السوء ، وصلة الرحم تزيد في العمر ) )(@)(@@) ابن صصرى في أماليه عن نبيط بن شريط رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13489 ) قال النبي :(@)(@@) | 30 ( صدقة المرء المسلم من سعة كأطيب مسك يوجد ريحه من مسيرة سنة ) )(@)(@@) ( حل ) عن هيبان رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الصاد مع الغين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13490 ) قال النبي :(@)(@@) | 30 ( صغاركم دعاميص الجنة يتلقى أحدهم أباه فيأخذ بثوبه فلا ينتهي حتى يدخله الله وأباه الجنة ) )(@)(@@) ( حم خد م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13491 ) قال النبي :(@)(@@) | 30 ( صغروا الخبز وأكثروا عدده يبارك لكم فيه ) )(@)(@@) الأزدي في الضعفاء والإسماعيلي في معجمه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) ||| ( الصاد مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13492 ) قال النبي :(@)(@@) | 30 ( صفتي أحمد المتوكل ليس بفظ ولا غليظ ، يجزي PageV05P076 بالحسنة الحسنة ولا يكافىء بالسيئة ، مولده بمكة ، ومهاجره طيبة ، وأمته الحمادون ، يأتزرون على أنصافهم ، ويوضئون أطرافهم ، أناجيلهم في صدورهم ، يصفون للصلاة كما يصفون 
ms1496	 للقتال ، قربانهم الذي يتقربون به إلي دماؤهم ، رهبان بالليل ، ليوث بالنهار ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13493 ) قال النبي :(@)(@@) | 30 ( صفوا كما تصف الملائكة عند ربهم ، يقيمون الصفوف ، ويجمعون مناكبهم ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 13494 ) قال النبي :(@)(@@) | 30 ( صفوة الله من أرضه الشام وفيها صفوته من خلقه وعباده ، وليدخلن الجنة من أمتي ثلة لا حساب عليهم ولا عذاب ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الصاد مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13495 ) قال النبي :(@)(@@) | 30 ( صلة الرحم تزيد في العمر ، وصدقة السر تطفىء غضب الرب ) )(@)(@@) القضاعي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13496 ) قال النبي :(@)(@@) | 30 ( صلة الرحم وحسن الخلق ، وحسن الجوار : يعمرن الديار ، ويزدن في الأعمار ) )(@)(@@) ( حم هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13497 ) قال النبي :(@)(@@) | 30 ( صلة القرابة مثراة في المال ، محبة في الأهل ، منسأة في الأجل ) )(@)(@@) ( طس ) عن عمرو بن سهل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13498 ) قال النبي :(@)(@@) | 30 ( صل من قطعك وأحسن إلى من أساء إليك ، وقل الحق ولو على نفسك ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@) PageV05P077(@)(@@)(@@)(@@) $ ( 13499 ) قال النبي :(@)(@@) | 30 ( صلوا قراباتكم ولا تجاوروهم فإن الجوار يورث بينكم الضغائن ) )(@)(@@) ( عق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13500 ) قال النبي :(@)(@@) | 30 ( صل الصبح والضحى فإنها صلاة الأوابين ) )(@)(@@) زاهر بن ظاهر في سداسياته عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13501 ) قال النبي :(@)(@@) | 30 ( صل الصلاة لوقتها ، فإن أدركت الإمام يصلي بهم فصل معهم وقد أحرزت صلاتك ، وإلا فهي نافلة لك ) )(@)(@@) ( ه ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13502 ) قال النبي :(@)(@@) | 30 ( صل الصلاة لوقتها ، فإن أدركت معهم فصل ، ولا تقل إني قد صليت فلا أصلي ) )(@)(@@) ( ن حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13503 ) قال النبي :(@)(@@) | 30 ( صل بالشمس وضحاها ونحوها من السور ) )(@)(@@) ( حم ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13504 ) قال النبي :(@)(@@) | 30 ( صل بصلاة أضعف القوم ولا تتخذ مؤذنا يأخذ على أذانه أجرا ) )(@)(@@) ( طب ) عن المغيرة رضي 
ms1497	 الله عنه .(@)(@@)(@@)(@@) $ ( 13505 ) قال النبي :(@)(@@) | 30 ( صل ركعتين تجوز فيهما ، وإذا جاء أحدكم والإمام يخطب يوم الجمعة فليصل ركعتين وليخففهما ) )(@)(@@) ( طب ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13506 ) قال النبي :(@)(@@) | 30 ( صل صلاة الصبح ثم أقصر عن الصلاة حتى تطلع الشمس حتى ترتفع ، فإنها تطلع حين تطلع بين قرني شيطان ، وحينئذ يسجد لها الكفار ثم صل ، فإن الصلاة مشهودة محضورة حتى يستقل الظل بالرمح ، ثم أقصر عن الصلاة فإن ، حينئذ تسجر جهنم ، فإذا أقبل الفيء فصل فإن الصلاة مشهودة PageV05P078 محضورة حتى تصلي العصر ثم أقصر عن الصلاة حتى تغرب الشمس فإنها تغرب بين قرني شيطان وحينئذ يسجد لها الكفار ) )(@)(@@) ( م ) عن عمرو بن عنبسة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13507 ) قال النبي :(@)(@@) | 30 ( صل صلاة مودع كأنك تراه ، فإن كنت لا تراه فإنه يراك ، وايأس مما في أيدي الناس تعش غنيا ، وإياك وما يعتذر منه ) )(@)(@@) أبو محمد الإبراهيمي في كتاب الصلاة ، وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13508 ) قال النبي :(@)(@@) | 30 ( صل قائما إلا أن تخاف الغرق ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13509 ) قال النبي :(@)(@@) | 30 ( صل قائما ، فإن لم تستطع فعلى جنب ) )(@)(@@) ( حم خ 4 ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13510 ) قال الن بي :(@)(@@) | 30 ( صلت الملائكة على آدم فكبرت عليه أربعا وقالت : هاذه سنتكم يا بني آدم ) )(@)(@@) ( هق ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13511 ) قال النبي :(@)(@@) | 30 ( صلوا أيها الناس في بيوتكم فإن أفضل الصلاة صلاة المرء في بيته إلا المكتوبة ) )(@)(@@) ( خ ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13512 ) قال النبي :(@)(@@) | 30 ( صلوا خلف كل بر وفاجر ، وصلوا على كل بر وفاجر ، وجاهدوا مع كل بر وفاجر ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13513 ) قال النبي :(@)(@@) | 30 ( صلوا ركعتي الضحى بسورتيها : والشمس وضحاها ، والضحى ) )(@)(@@) ( هب فر ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13514 ) قال النبي :(@)(@@) | 30 ( صلوا صلاة المغرب مع سقوط الشمس ، بادروا PageV05P079 بها طلوع النجم ) )(@)(@@) ( طب ) عن أبي أيوب 
ms1498	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13515 ) قال النبي :(@)(@@) | 30 ( صلوا على أطفالكم فإنهم من أفراطكم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13516 ) قال النبي :(@)(@@) | 30 ( صلوا على النبيين إذا ذكرتموني ، فإنهم قد بعثوا كما بعثت ) )(@)(@@) الشاشي وابن عساكر عن وائل بن حجر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13517 ) قال النبي :(@)(@@) | 30 ( صلوا على أنبياء الله ورسله فإن الله بعثهم كما بعثني ) )(@)(@@) ابن أبي عمر ( هب ) عن أبي هريرة ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13518 ) قال النبي :(@)(@@) | 30 ( صلوا على صاحبكم ، إن صاحبكم غل في سبيل الله ) )(@)(@@) ( حم د ه حب ك ) عن زيد بن خالد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13519 ) قال النبي :(@)(@@) | 30 ( صلوا على كل ميت وجاهدوا مع كل أمير ) )(@)(@@) ( ه ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13520 ) قال النبي :(@)(@@) | 30 ( صلوا على من قال لا إلاه إلا الله ، وصلوا وراء من قال لا إلاه إلا الله ) )(@)(@@) ( طب حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13521 ) قال النبي :(@)(@@) | 30 ( صلوا على موتاكم بالليل والنهار ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13522 ) قال النبي :(@)(@@) | 30 ( صلوا علي صلى الله عليكم ) )(@)(@@) ( عد ) عن ابن عمر وأبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 13523 ) قال النبي :(@)(@@) | 30 ( صلوا علي فإن صلاتكم علي زكاة لكم ) )(@)(@@) ( ش ) و ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P080(@)(@@)(@@)(@@) $ ( 13524 ) قال النبي :(@)(@@) | 30 ( صلوا علي واجتهدوا في الدعاء وقولوا : اللهم صل على محمد وعلى آل محمد ، وبارك على محمد وآل محمد كما باركت على إبراهيم وآل إبراهيم إنك حميد مجيد ) )(@)(@@) ( حم ن ) و ابن سعد وسمويه والبغوي والباوردي وابن قانع ( طب ) عن زيد بن خارجة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13525 ) قال النبي :(@)(@@) | 30 ( صلوا في بيوتكم ولا تتخذوا قبورا ) )(@)(@@) ( ت ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13526 ) قال النبي :(@)(@@) | 30 ( صلوا في بيوتكم ولا تتخذوها قبورا ولا تتخذوا بيتي عيدا ، وصلوا علي وسلموا فإن صلاتكم تبلغني حيثما كنتم ) )(@)(@@) ( ع ) و الضياء عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13527 ) قال النبي :(@)(@@) | 30 
ms1499	 ( صلوا في بيوتكم ولا تتركوا النوافل فيها ) )(@)(@@) ( قط ) في الأفراد عن أنس وجابر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13528 ) قال النبي :(@)(@@) | 30 ( صلوا في مرابض الغنم ولا تصلوا في أعطان الإبل ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13529 ) قال النبي :(@)(@@) | 30 ( صلوا في مرابض الغنم ولا تصلوا في أعطان الإبل فإنها خلقت من الشياطين ) )(@)(@@) ( ه ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13530 ) قال النبي :(@)(@@) | 30 ( صلوا في مرابض الغنم ولا توضؤوا من ألبانها ، ولا تصلوا في معاطن الإبل وتوضؤوا من ألبانها ) )(@)(@@) ( طب ) عن أسيد بن حضير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13531 ) قال النبي :(@)(@@) | 30 ( صلوا في مراح الغنم وامسحوا رغامها فإنها من دواب الجنة ) )(@)(@@) ( عد هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13532 ) قال النبي :(@)(@@) | 30 ( صلوا في نعالكم ولا تشبهوا باليهود ) )(@)(@@) ( طب ) عن PageV05P081 شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13533 ) قال النبي :(@)(@@) | 30 ( صلوا قبل المغرب ركعتين صلوا قبل المغرب ركعتين لمن شاء ) )(@)(@@) ( حم د ) عن عبد الله المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13534 ) قال النبي :(@)(@@) | 30 ( صلوا من الليل ولو أربعا ، صلوا ولو ركعتين ، ما من أهل بيت تعرف لهم صلاة من الليل إلا ناداهم مناد ، يا أهل البيت قوموا لصلاتكم ) )(@)(@@) ابن نصر ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 13535 ) قال النبي :(@)(@@) | 30 ( صلي في الحجر إن أردت دخول البيت فإنما هو قطعة من البيت ، ولاكن قومك استقصروه حين بنوا الكعبة فأخرجوه من البيت ) )(@)(@@) ( حم ت ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13536 ) قال النبي :(@)(@@) | 30 ( صلة الرحم مثراة في المال ، محبة في الأهل ، منسأة في الأجل ) )(@)(@@) ( طس ) عن عمرو بن سهل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13537 ) قال النبي :(@)(@@) | 30 ( صلت الملائكة على آدم فكبروا عليه أربعا وسلموا تسليمتين ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13538 ) قال النبي :(@)(@@) | 30 ( صل الصلاة لوقتها ، فإن أدركت الإمام يصلي بهم فصل معهم وقد أحرزت صلاتك وإلا فهي نافلة لك ) )(@)(@@) ( ه ) و الحكيم عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13539 ) قال النبي 
ms1500	 :(@)(@@) | 30 ( صل في القوس واطرح القرن ) )(@)(@@) ( ش طب PageV05P082 ك هق ) عن سل مة بن الأكوع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13540 ) قال النبي :(@)(@@) | 30 ( صل ركعتين خفيفتين قبل أن تجلس ) )(@)(@@) ( حب ) عن جابر رضي الله عنه قال : دخل رجل المسجد والنبي يخطب يوم الجمعة قال له فذكره .(@)(@@)(@@)(@@) $ ( 13541 ) قال النبي :(@)(@@) | 30 ( صل على الأرض إن استطعت وإلا فأومىء إيماء ، واجعل سجودك أخفض من ركوعك ) )(@)(@@) ( هق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13542 ) قال النبي :(@)(@@) | 30 ( صل قائما فهو أفضل ، ومن صلى قاعدا فله نصف أجر القائم ، ومن صلى نائما فله نصف أجر القاعد ) )(@)(@@) ( حب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13543 ) قال النبي :(@)(@@) | 30 ( صل بأصحابك صلاة أضعفهم ، فإن فيهم الضعيف والمريض وذا الحاجة ، واتخذ مؤذنا لا يأخذ على الأذان أجرا ) )(@)(@@) الشيرازي في الألقاب عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13544 ) قال النبي :(@)(@@) | 30 ( صلى في مسجد الخيف سبعون نبيا منهم موسى ، فكأني أنظر إليه وعليه عباءتان قطوانيتان وهو محرم على بعير من إبل شنوءة مخطوم الخطام من ليف وله ضفيرتان ) )(@)(@@) ( طب كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13545 ) قال النبي :(@)(@@) | 30 ( صلوا صلاة الظهر حين تميل الشمس ، وصلوا صلاة العصر بقدر ما يسير الراكب إلى ذي الحليفة لستة أميال ، وصلوا المغرب حين تغيب الشمس ، وصلوا العشاء بعد أن يغيب الشفق بينكم وبين نصف الليل ) )(@)(@@) ( عب ) عن ابن جريج عن سليمان بن موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13546 ) قال النبي :(@)(@@) | 30 ( صلوا على أنبياء الله ورسله كما تصلون علي فإنهم أرسلوا كما أرسلت ) )(@)(@@) أبو الحسين أحمد بن ميمون في فوائد ( خط ) عن أبي هريرة PageV05P083 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13547 ) قال النبي :(@)(@@) | 30 ( صلوا في مراحات الغنم ولا تصلوا في مراحات الإبل ) )(@)(@@) ( حم ) و البغوي ( طب هق ) عن عبد الملك بن الربيع بن سبرة بن معبد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 13548 ) قال النبي :(@)(@@) | 30 ( صلوا علي فإن الصلاة علي زكاة لكم ، وسلوا الله تعالى لي الوسيلة ، قالوا : وما الوسيلة ؟ قال : هي 