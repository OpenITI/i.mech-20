ms1621	 يروي عن عفير بن معدان روى عنه بشر بن آدم بن ابنة أزهر بن السمان يعتبر حديثه من غير روايته عن عفير بن معدان(@)(@@)(@@)(@@) $ 14929 - القاسم بن يزيد بن عبد الله بن قسيط الليثي من أهل المدينة يروي عن أبيه روى عنه الحارث بن عبد الملك(@)(@@)(@@)(@@) $ 14930 - القاسم بن محمد بن حميد المعمري البغدادي كنيته أبو محمد يروي عن عبد الرحمن بن محمد بن حبيب روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 14931 - القاسم بن غزوان يروي عن إسحاق بن راشد الجزري روى عنه شهاب بن خراش الحوشبى PageV09P015(@)(@@)(@@)(@@) $ 14932 - القاسم بن القاسم أبو هاشم يروي عن أبي فاطمة عداده في أهل البصرة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 14933 - القاسم السلمي يروي عن أبي الزناد روى عنه الكوفيون وقد روى عنه مسعر بن كدام الحرف بعد الحرف(@)(@@)(@@)(@@) $ 14934 - القاسم بن الحكم العرني أبو أحمد الكوفي كان على قضاء همدان يروي عن مسعر والمسعودي روى عنه محمد بن عبيد بن عبد الملك وأهل همدان مستقيم الحديث(@)(@@)(@@)(@@) $ 14935 - القاسم بن يزيد الجرمي يروي عن سفيان الثوري روى عنه علي بن حرب الموصلي ربما خالف(@)(@@)(@@)(@@) $ 14936 - القاسم بن عمرو بن محمد العنقزي أبو محمد الكوفي مولى قريش يروي عن وكيع وأبيه روى عنه أحمد بن سعيد الرباطي والكوفيون مات سنة خمس أو ست ومائتين وهو أخو الحسين بن عمرو(@)(@@)(@@)(@@) $ 14937 - القاسم بن موسى يروي عن الأوزاعي روى عنه محمد بن عيسى بن الطباع(@)(@@)(@@)(@@) $ 14938 - القاسم بن سلام أبو عبيد البغدادي مولى بنى أمية وقد قيل مولى الأزد كان من خراسان يروي عن شريك وإسماعيل بن جعفر PageV09P016 روى عنه أهل العراق مات بمكة سنة أربع وعشرين ومائتين وكان أحد أئمة الدنيا صاحب حديث وفقه ودين وورع ومعرفة بالأدب وأيام الناس ممن جمع وصنف واختار وذب عن الحديث ونصره وقمع من خالفه وحاد عنه(@)(@@)(@@)(@@) $ 14939 - القاسم بن مبرور يروي عن يونس بن يزيد الأيلي روى عنه خالد بن نزار الأيلي(@)(@@)(@@)(@@) $ 14940 - القاسم بن زريق شيخ يروي عن أبي 
ms1622	 الأحوص سلام بن سليم روى عنه سعيد بن جناح الزاهد البخاري(@)(@@)(@@)(@@) $ 14941 - القاسم بن عثمان الجوعي من أهل دمشق من المتعبدين يروي عن أبي اليمان وقد كان راويا لابن نافع حدثنا عنه محمد بن المعافي بصيداء وغيره(@)(@@)(@@)(@@) $ 14942 - القاسم بن عبد الوهاب من أهل صور يروي عن أبي معاوية الضرير وأهل العراق روى عنه أهل بلده يغرب حدثني أبو الميمون بصور ثنا القاسم بن عبد الوهاب ثنا أبو معاوية عن هشام بن عروة عن أبيه عن عائشة قالت قال النبي صلى الله عليه وسلم إن من الشعر لحكمة سمعت سعيد بن هاشم بن مرثد بطبرية يقول ثنا القاسم بن عبد الوهاب أبو نصر PageV09P017 بن أخت الحسن بن موسى الأشيب كأنه من بغداد وسكن صور(@)(@@)(@@)(@@) $ 14943 - القاسم بن سلام بن مسكين النميري من أهل البصرة يروي عن أبيه روى عنه عبد الله بن حماد الآملي مستقيم الحديث مات سنة ثمان وعشرين ومائتين(@)(@@)(@@)(@@) $ 14944 - القاسم بن أبي شيبة أخو أبي بكر وعثمان يروي عن وكيع وأبى أسامة ثنا عنه الحسن بن سفيان يخطىء ويخالف(@)(@@)(@@)(@@) $ 14945 - القاسم بن أبي شيبة يحيى الهلالي من أهل بغداد جار محرز بن عون يروي عن إسماعيل بن عياش حدثنا عنه أحمد بن علي بن المثنى مستقيم الحديث(@)(@@)(@@)(@@) $ 14946 - القاسم بن عيسى الطائي من أهل واسط روى عن رحمة بن مصعب وخالد بن عبد الله حدثنا عنه عبد الله بن قحطبة بفم الصلح(@)(@@)(@@)(@@) $ 14947 - القاسم بن زكريا بن دينار القرشي أبو محمد الطحان من أهل الكوفة يروي عن وكيع والكوفيين ثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 14948 - القاسم بن سعيد بن المسيب بن شريك أبو بشر يروي عن عبيد الله بن موسى حدثنا عنه أحمد بن محمد بن الأزهر(@)(@@)(@@)(@@) $ 14949 - القاسم بن محمد بن عباد بن عباد المهلبي من أهل البصرة يروى PageV09P018 عن أبي عاصم وأبيه حدثنا عنه عبد الرحمن بن محمد بن حماد الطهراني وغيره(@)(@@)(@@)(@@) $ 14950 - القاسم بن بشر بن معروف بغدادي يروي عن يزيد بن هارون روى 
ms1623	 عنه أهل العراق حدثنا الثقفي ثنا القاسم بن بشر بن معروف ثنا يزيد بن هارون أنا مالك الأشجعي عن أبيه أنه سمع رسول الله صلى الله عليه وسلم يقول يحسب أصحابى القيل(@)(@@)(@@)(@@) $ 14951 - القاسم بن إسماعيل الهاشمي كوفي يروي عن عبيد الله بن موسى حدثنا عنه محمد بن المنذر بن سعيد(@)(@@)(@@)(@@) $ 14952 - القاسم بن يزيد الأشجعي من أهل الكوفة يروي عن وكيع بن الجراح حدثنا عنه الخضر بن داود(@)(@@)(@@)(@@) $ 14953 - القاسم بن محمد بن حماد الدلال كوفي كنيته أبو محمد يروي عن أبي نعيم كتب عنه أصحابنا(@)(@@)(@@)(@@) $ 14954 - القاسم بن محمد المروزي صاحب كتاب الرد على النعمان يروي عن أبي نعيم وأهل العراق حدثنا عنه الحسن بن محمد بن مصعب بمرو(@)(@@)(@@)(@@) $ 14955 - قتيبة بن قدامة بن عبد الرحمن الرواسي أبو عثمان يروي عن أبيه روى عنه وكيع PageV09P019(@)(@@)(@@)(@@) $ 14956 - قتيبة بن كز البخاري وكز لقب وهو قتيبة بن الحسن يروي عن عباد بن العوام روى عنه محمد بن الحسن البخاري والد إبراهيم وعمر(@)(@@)(@@)(@@) $ 14957 - قتيبة بن مهران أبو عبد الرحمن الأصبهاني يروي عن القراء القراءات روى عنه يونس بن حبيب الأصبهاني(@)(@@)(@@)(@@) $ 14958 - قتيبة بن سعيد بن جميل بن طريف بن عبد الله مولى ثقيف من أهل بغلان كنيته أبو رجاء وكان جده جميل مولى الحجاج بن يوسف وكان مقدما عنده يقعده إذا قعد على كرسي بحذائه ويبعثه في سفارته إلى عبد الملك بن مروان يروي عن الليث بن سعد وبكر بن مضر حدثنا عنه محمد بن إسحاق الثقفي وشيوخنا مات لليلتين خلتا من شعبان سنة أربعين ومائتين وكان مولده سنة خمسين ومائة وكان من المتقنين في الحديث والمتبحرين في السنن وانتحالها كتب عنه أحمد ويحيى وخلف وابن أبي شيبة وأبو خيثمة وأضرابهم من العراقيين(@)(@@)(@@)(@@) $ 14959 - قبيصة بن مروان يروي عن والان عن الحسن روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 14960 - قبيصة بن ليث يروي عن محمد بن سوقة ويزيد بن أبى زياد PageV09P020 روى عنه محمد بن عبيد المحاربي والكوفيون حدثنا أبو يعلى 
ms1624	 ثنا أبو كريب ثنا قبيصة بن ليث عن مصرف عن عطاء عن أم الدرداء عن أبي الدرداء عن النبي صلى الله عليه وسلم قال والذي لا إله غيره ما شيء يوضع في الميزان أفضل من حسن الخلق وصاحب حسن الخلق مع درجة صاحب الصوم والصلاة(@)(@@)(@@)(@@) $ 14961 - قبيصة بن عقبة السوائي من بنى عامر بن صعصعة كنيته أبو عامر من أهل الكوفة يروي عن الثوري ومسعر بن كدام روى عنه عبد الله بن أبي عرابة وأهل العراق مات ليلة الجمعة في شهر محرم سنة خمس عشرة ومائتين(@)(@@)(@@)(@@) $ 14962 - قدامة بن عبد الرحمن الرؤاسي يروي عن الضحاك بن مزاحم روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 14963 - قدامة بن زائدة الكاهلي يروي عن عاصم بن أبي النجود روى عنه ابنه زائدة بن قدامة(@)(@@)(@@)(@@) $ 14964 - قدامة بن شهاب المازني من أهل البصرة يروي عن برد بن سنان روى عنه موسى بن إسماعيل ويوسف بن واضح الهاشمي ربما خالف(@)(@@)(@@)(@@) $ 14965 - قطن بن كعب أبو الهيثم القطعي من أهل البصرة يروي عن PageV09P021 أبي يزيد المدني روى عنه عبد الوارث بن سعيد(@)(@@)(@@)(@@) $ 14966 - قطن بن عبد الله الحداني أبو مرى البصري يروي عن أشعث بن عبد الملك الحمراني روى عنه البصريون وهو الذي يقال له قطرى بن عبد الله(@)(@@)(@@)(@@) $ 14967 - قطن بن عبد الله يروي عن غالب الليثي روى عنه عمار بن شعبة(@)(@@)(@@)(@@) $ 14968 - قطن بن نسير الغبري أبو عباد من أهل البصرة يروي عن جعفر بن سليمان الضبعي وحماد بن زيد حدثنا عنه أحمد بن علي بن المثنى وغيره من شيوخنا(@)(@@)(@@)(@@) $ 14969 - قطن بن إبراهيم من أهل نيسابور يروي عن عبيد الله بن موسى وجعفر بن عبد الرحمن حدثنا عنه أهل نيسابور يخطىء أحيانا يعتبر حديثه إذا حدث من كتابه(@)(@@)(@@)(@@) $ 14970 - قرط أبو توبة يروي عن إبراهيم الهجري روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 14971 - قتادة بن الفضل بن عبد الله الرهاوي يروي عن أبيه روى عن أحمد بن سليمان بن الطيب وأبو الحسين الرهاوي(@)(@@)(@@)(@@) $ 14972 - قتادة 
ms1625	 بن سعيد بن قتادة بن دعامة من أهل البصرة يروي عن PageV09P022 محمد بن سواء حدثنا سعيد بن أبي عروبة أن أيوب السختياني كان عند قتادة فلحن فقال استغفر الله(@)(@@)(@@)(@@) $ 14973 - قران بن تمام الأسدي من أهل الكوفة أبو تمام يروي عن الكوفيين وقد روى عن هشام بن عروة روى عنه حبان بن علي(@)(@@)(@@)(@@) $ 14974 - قعنب اليمامي من العباد المتورعين ليس له حديث يرجع إليه وله الحكايات في الرقائق روى عنه أهل اليمن الحكايات في العبادات(@)(@@)(@@)(@@) $ 14975 - قعنب التميمي يروي عن علقمة بن مرثد روى عنه بن عيينة(@)(@@)(@@)(@@) $ 14976 - قعنب بن محرز بن قعنب من أهل البصرة يروي عن أبي عاصم والبصريين حدثنا عنه محمد بن عبد الكريم الوزان وجماعة من شيوخنا(@)(@@)(@@)(@@) $ 14977 - قعنب بن صفوان يروى عن بن شبرمة عن أبي زرعة عن أبي هريرة لا يشكر الله من لا يشكر الناس حدثناه أحمد بن محمد بن حارث ثنا أحمد بن محمد التبعي ثنا أبو القاسم بن الحكم العرني ثنا قعنب بن صفوان(@)(@@)(@@)(@@) $ 14978 - قراد مولى سليمان يروي عن عمر بن عبد العزيز روى عنه رجاء بن أبي سلمة(@)(@@)(@@)(@@) $ 14979 - قرة بن صالح الباهلي من أهل البصرة يروي عن البصريين روى عنه أهل بلده حدثنا سعيد بن عبد العزيز الحلبي بدمشق ثنا عمران PageV09P023 بن موسى بن أيوب ثنا العباس بن طالب البصري ثنا قرة بن صالح الباهلي ثنا أبو بكر الهذلي قال قلت للحسن يا أبا سعيد أبو بكر كان أفضل أو عمر قال أبو بكر وعمر كان يعرف له ذلك قلت أعمر كان أفضل أو عثمان قال عمر وعثمان كان يعرف له ذلك قلت عثمان كان أفضل أو على قال عثمان وعلى كان يعرف له ذلك قلت أعلى كان أفضل أم معاوية وقال وأين معاوية من المهاجرين الأولين(@)(@@)(@@)(@@) $ 14980 - قرة بن حبيب بن يزيد بن مطر القشيري أبو على القنوي صاحب الرماح يروي عن شعبة روى عنه بندار وأهل البصرة(@)(@@)(@@)(@@) $ 14981 - قريش بن إبراهيم أبو الطيب يروي عن عبد 
ms1626	 الملك بن ميسرة عن إبراهيم بن أبي حرة روى عنه شريح بن يونس(@)(@@)(@@)(@@) $ 14982 - قريش بن سواه من أهل سمرقند يروي عن أبي مقاتل حفص بن مسلم روى عنه السمرقنديون العتكي وغيره(@)(@@)(@@)(@@) $ 14983 - قريش بن إسماعيل بن زكريا شيخ يروي عن الحارث بن عمران عن محمد بن سوقة عن سعيد بن جبير عن بن عباس قال كنت أطوف مع النبي صلى الله عليه وسلم فسمع رجلا يقول اللهم اغفر لفلان فقال مه فقال يا رسول الله رجل حملني أن أدعو له عند الركن والمقام فقال غفر لك ولصاحبك حدثنا بن زهير بتستر ثنا الجراح بن مخلد ثنا قريش بن إسماعيل PageV09P024(@)(@@)(@@)(@@) $ 14984 - قريش بن إبراهيم يروي عن المعتمر بن سليمان روى عنه أحمد بن حنبل(@)(@@)(@@)(@@) $ 14985 - قثم بن أبي قتادة أبو أسامة الحراني يروي عن عتاب بن بشير حدثنا عنه أبو زرعة مات سنة سبع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 14986 - قثم العابد من أهل البصرة يروي عن عبد الواحد بن زيد الرقائق روى عنه روح بن سلمة(@)(@@)(@@)(@@) || (باب الكاف)(@)(@@) قال أبو حاتم وممن روى عن تبع الأتباع من أتباعهم ممن ابتدأ اسمه على الكاف(@)(@@)(@@)(@@) $ 14987 - كثير بن دينار الحمصي يروي عن عمر بن عبد العزيز روى عنه عثمان بن سعيد(@)(@@)(@@)(@@) $ 14988 - كثير بن فائد يروي عن سعيد بن عبيد روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 14989 - كثير بن جعفر بن أبي جعفر أخو إسماعيل ومحمد من أهل المدينة يروي عن علاقة روى عنه إبراهيم بن المنذر الحزامى PageV09P025(@)(@@)(@@)(@@) $ 14990 - كثير بن حميد الأصم يروي عن سالم أبي المهاجر روى عنه موسى بن أيوب النصيبي(@)(@@)(@@)(@@) $ 14991 - كثير بن هشام الكلابي من أهل الرقة كنيته أبو سهل سكن بغداد يروي عن جعفر بن برقان روى عنه قتيبة بن سعيد مات بفم الصلح في شعبان سنة سبع ومائتين يخطىء ويخالف(@)(@@)(@@)(@@) $ 14992 - كثير بن سليمان قال سمعت الضحاك بن مزاحم يقول من أحب أن يلقى الله طاهرا مطهرا فليتزوج الحرائر روى عنه أبو تميلة(@)(@@)(@@)(@@) $ 14993 - كثير بن نباتة يروي 
ms1627	 عن الحكم بن أبان روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 14994 - كثير بن زياد أبو همام من أهل البصرة يروي عن غالب القطان روى عنه علي بن نصر الجهضمي(@)(@@)(@@)(@@) $ 14995 - كثير بن يزيد بن عازب أبو محمد من أهل قنسرين يروي عن عطاء بن مسلم الحلبي روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 14996 - كثير بن يحيى بن النضر أبو مالك صاحب البصري يروي عن حماد بن زيد حدثنا عنه محمد بن يحيى العمى ببغداد وغيره PageV09P026(@)(@@)(@@)(@@) $ 14997 - كثير بن الأزهر الأنصاري يروي عن بن المبارك روى عنه أبو حاتم الرازي(@)(@@)(@@)(@@) $ 14998 - كثير بن أبي صابر القشيري يروي عن عطاء بن مسلم الحلبي حدثنا عنه الحسن بن أحمد بن إبراهيم بن فيل بأنطاكية وأحسبه الذي روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 14999 - كثير بن عبيد بن نمير الحذاء من أهل حمص يروي عن بن عيينة ويحيى بن سليم حدثنا عنه محمد بن عبيد الله بن الفضل الكلاعي وغيره من شيوخنا وكان من خيار الناس كنيته أبو الحسن المذحجي مات سنة خمس وخمسين ومائتين أو قبلها أو بعدها بقليل(@)(@@)(@@)(@@) $ 15000 - كرز بن وبرة الحارثي العابد من أهل الكوفة سكن جرجان يروي عن الثوري وكان بن شبرمة كثير المدح له قدم مكة فاتعب العباد بها وكانت سحابة تظله وإذا دعا أجيب روى عنه بن شبرمة والفضل بن غزوان(@)(@@)(@@)(@@) $ 15001 - كلاب بن جزى من عباد الكوفيين ومتقشفيهم له أخبار في الرقائق وليس له حديث مسند يروي روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 15002 - كهمس بن المنهال السدوسي يروي عن سعيد بن أبى عروبة PageV09P027 روى عنه البصريون وكان يقول بالقدر(@)(@@)(@@)(@@) $ 15003 - كهمس يروي عن القاسم بن عبد الرحمن بن عبد الله بن مسعود روى عنه يعقوب بن القعقاع(@)(@@)(@@)(@@) $ 15004 - كدهر بن سليمان يروي عن عمر بن عبد العزيز روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 15005 - كلثوم بن محمد بن أبي سدرة يروي عن عطاء الخراساني روى عنه إسحاق بن إبراهيم الحنظلي يعتبر حديثه إذا روى عن غير عطاء الخراساني(@)(@@)(@@)(@@) $ 15006 - كلثوم بن 
ms1628	 محمد الرازي يروي عن بن عيينة روى عنه حاتم بن الليث الجوهري(@)(@@)(@@)(@@) $ 15007 - كعب شيخ يروي عن عمر بن عبد العزيز روى عنه حرملة بن عمران(@)(@@)(@@)(@@) $ 15008 - كعب بن سعيد من أهل بخارا يروي عن الفضيل بن عياض روى عنه أبو الليث نصر بن الحسين البخاري(@)(@@)(@@)(@@) $ 15009 - كامل بن طلحة الجحدري أبو يحيى يروي عن الليث بن سعد وابن لهيعة حدثنا عنه محمد بن إبراهيم البزوري وابن منيع وغيرهما من شيوخنا مات سنة إحدى وثلاثين ومائتين في آخرها PageV09P028(@)(@@)(@@)(@@) $ 15010 - الكرماني بن عمرو شيخ يروي عن حماد بن سلمة قال ثنا سماك بن حرب عن أنس بن مالك أن رسول الله صلى الله عليه وسلم لما بلغ ذا الحليفة بعث ببراءة مع أبي بكر فقال لا يخطب بها إلا أنا أو رجل من أهل بيتي فبعث بها مع علي بن أبي طالب رضي الله عنه حدثنا عبد الكبير بن عمر الخطابي ثنا إسحاق بن إبراهيم شاذان ثنا الكرماني بن عمرو ثنا حماد بن سلمة(@)(@@)(@@)(@@) || (باب اللام)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى من الطبقة الرابعة عن أتباع التابعين ممن ابتدأ اسمه على اللام(@)(@@)(@@)(@@) $ 15011 - الليث بن عاصم القتباني أبو زرارة من أهل مصر يروي عن بن جريج روى عنه المصريون كان مولده سنة ثلاثين ومائة ومات سنة ثنتين وثمانين ومائة وكان ياسين بن عبد الأحد القتباني كثير الرواية عنه(@)(@@)(@@)(@@) $ 15012 - الليث بن أبي رقية يروي عن عمر بن عبد العزيز روى عنه محمد بن راشد اليماني(@)(@@)(@@)(@@) $ 15013 - الليث بن هارون أبو عتبة العكلي يروي عن عبيد الله بن موسى وزيد بن الحباب روى عنه الحضرمي PageV09P029(@)(@@)(@@)(@@) $ 15014 - لهيب بن الخندق يروي عن العوام بن حوشب المقاطيع روى عنه أهل العراق(@)(@@)(@@)(@@) $ 15015 - لبيد بن حيان أبو جندل النميري من أهل البصرة يروي عن معبد بن هلال روى عنه التبوذكي(@)(@@)(@@)(@@) || (باب الميم)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى من الطبقة الرابعة ممن ابتدأ اسمه على الميم(@)(@@)(@@)(@@) $ 15016 - محمد بن إدريس 
ms1629	 بن العباس بن عثمان بن الشافع بن السائب بن عبيد بن عبد يزيد بن هاشم بن مطلب بن عبد مناف بن قصي بن كلاب بن مرة بن كعب بن لؤي بن غالب بن فهر بن مالك بن النضر بن كنانة بن خزيمة بن مدركة بن إلياس بن مضر بن نزار بن معد بن عدنان أبو عبد الله الشافعي رحمة الله عليه ورضوانه أسر السائب يوم بدر وهو كافر وأمه الشفا بنت أرقم بن هاشم وأم الشفا خلدة بنت أسد بن هاشم بن عبد مناف وأم عبيد بن عبد يزيد العجلة بنت العجلان بن البياع بن عبد ياليل بن ناشب بن غيرة بن سعد بن ليث بن بكر بن عبد مناة بن كنانة وأم عبد يزيد الشفا بنت هاشم بن عبد مناف PageV09P030 بن قصي وأم هاشم بن المطلب خديجة بنت سعيد بن سعد بن سهم وأم هاشم والمطلب وعبد الشمس بنى عبد مناف عاتكة بنت مرة السلمية يروي عن مالك وابن عيينة وكان مولده بمكة سنة خمسين ومائة في السنة التي مات فيها أبو حنيفة لأن أبا حنيفة مات ببغداد في شهر رجب سنة خمسين ومائة وولد في تلك السنة الشافعي بغزة من بلاد فلسطين ومات عنه أبوه وهو بن سنتين فحملته أمه إلى دارهم بالحجاز في أجياد فنشأ بمكة وترعرع بها وجالس أهل العلم وفتح عليه فيه ما حرم غيره مثله حتى كان مسلم بن خالد الزنجي يحثه على الفتيا يقول سمعت الشافعي يقول قال لي مسلم الزنجي وأنا بن خمس عشرة سنة أفت يا أبا عبد الله فقد آن لك ان تفتى فلم يزل ذلك دأبه يزداد كل يوم دفعة وفي العلم بصيرة وقدوة إلى أن توفي رحمه الله بالفسطاط في شهر ربيع الأول سنة أربع ومائتين ودفن عند معتبر باب الشمس بالفسطاط فرجعوا فرأوا هلال شهر ربيع الآخر وقبره مشهور يزار قد أخرجنا مناقبه من يوم ولد إلى يوم توفي في غير الكتاب فلذلك لم نمعن في ذكر 
ms1630	 الحكايات المروية في شمائله في هذا الكتاب لاقتناعنا بما ذكرناه منا في ذلك الكتاب فان قصدنا في هذا الكتاب الاختصار ولزوم الاقتصار(@)(@@)(@@)(@@) $ 15017 - محمد بن عكرمة بن عبد الرحمن بن الحارث بن هشام المخزومي القرشي أبو عبد الله من أهل المدينة يروى عن محمد بن PageV09P031 عبد الرحمن بن لبيبة روى عنه إبراهيم بن سعد(@)(@@)(@@)(@@) $ 15018 - محمد بن عبد الله بن طاوس بن كيسان يروي عن أبيه روى عنه عمر بن يونس اليمامي(@)(@@)(@@)(@@) $ 15019 - محمد بن إسماعيل بن طريح بن إسماعيل بن عبد بن أسير بن عمرو الثقفي الطائفي يروي عن أبيه عن جده روى عنه الغلاء بن الفضل البصري(@)(@@)(@@)(@@) $ 15020 - محمد بن صبيح بن السماك أبو العباس الكوفي القاص يروي عن الأجلح روى عنه محمد بن آدم المصيصي مستقيم الحديث وكان يعظ الناس في مجالسه(@)(@@)(@@)(@@) $ 15021 - محمد بن عبد الله بن أبى حرة بن أخى حكيم الأسلمي يروي عن أبيه وعمه حكيم بن أبي حرة روى عنه عبد العزيز بن محمد الدراوردي(@)(@@)(@@)(@@) $ 15022 - محمد بن عبد الله بن أبي هدبة المديني يروي عن عمر بن عبد العزيز روى عنه يحيى بن سليم الطائفي(@)(@@)(@@)(@@) $ 15023 - محمد بن عبد الله الصراري من أهل المدينة وصرار موضع PageV09P032 بها يروي عن عبد الله بن عبد الرحمن بن أبي حسين روى عنه يزيد بن عبد الله بن الهاد(@)(@@)(@@)(@@) $ 15024 - محمد بن قيس بن الأحنف يروي عن أبيه روى عنه الحجاج بن أرطاة(@)(@@)(@@)(@@) $ 15025 - محمد بن سعد شيخ يروي عن عبد الله بن عبد الرحمن بن أبي صعصعة روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 15026 - محمد بن خراشة يروي عن عروة بن محمد روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 15027 - محمد بن عبد الله بن عمرو بن هشام العامري يروي عن بكير بن عبد الله بن الأشج روى عنه إبراهيم بن سعد(@)(@@)(@@)(@@) $ 15028 - محمد بن مهزم الشعاب أبو عمرو الوامخ العبدي من أهل البصرة يروي عن محمد بن واسع روى عنه وكيع ووهب بن جرير(@)(@@)(@@)(@@) $ 15029 - محمد بن عبد الله 
ms1631	 بن إنسان يروي عن أبيه عن عروة بن الزبير روى عنه عبد الله بن الحارث المخزومي(@)(@@)(@@)(@@) $ 15030 - محمد بن حصين بن عبد الرحمن بن عمرو بن سعد بن معاذ الأشهلي PageV09P033 الأنصاري الأوسي من أهل المدينة يروي عن أبيه وداود بن الحصين روى عنه محمد بن طلحة التيمي(@)(@@)(@@)(@@) $ 15031 - محمد بن كردوس يروي عن أبيه عن شريح روى عنه منصور بن المعتمر(@)(@@)(@@)(@@) $ 15032 - محمد بن علي بن يزيد بن ركانة بن عبد يزيد يروي عن أبيه روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 15033 - محمد بن هيصم أبو جميل يروي عن وقاء بن إياس عن سعيد بن جبير روى عنه بن فضيل(@)(@@)(@@)(@@) $ 15034 - محمد بن وكيع يروي عن يونس بن عبيد روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 15035 - محمد بن الحارث الثقفي قال رأيت عمر بن عبد العزيز رفع رأسه من السجدة فقعد بين السجدتين قدر عشرين آية روى عنه شبابة بن سوار(@)(@@)(@@)(@@) $ 15036 - محمد بن الحجاج القرشي الدمشقي يروي عن يونس بن PageV09P034 ميسرة بن حلبس روى عنه مروان بن معاوية الفزاري وإسماعيل بن عياش(@)(@@)(@@)(@@) $ 15037 - محمد بن عطية يروي عن عبد الله بن أبي زينب عن أبي إدريس الخولاني عداده في أهل الشام روى عنه إسماعيل بن عياش(@)(@@)(@@)(@@) $ 15038 - محمد بن سليمان البلخي يروي عن الضحاك بن مزاحم روى عنه قتيبة بن سعيد حدثنا قتيبة بن سعيد ثنا محمد بن سليمان البلخي قال قرأت على الضحاك بن مزاحم فقال يا أيها الذين آمنوا لا تقدموا وجاءنا الضحاك بن مزاحم فأخرجني أبي إليه وأنا غلام قد ترعرعت وفي أذني قرطان من ذهب فما أنكر على ذلك(@)(@@)(@@)(@@) $ 15039 - محمد بن يزيد الرحبي الدمشقي يروي عن عروة بن رويم اللخمي روى عنه إسماعيل بن عياش(@)(@@)(@@)(@@) $ 15040 - محمد بن يسار شيخ يروي عن سليم بن مطير روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 15041 - محمد بن سعيد بن رمانة من أهل اليمن يروي عن أبيه عن وهب بن منبه روى عنه عبد الملك بن عبد الرحمن 
ms1632	 الذماري(@)(@@)(@@)(@@) $ 15042 - محمد بن عبد الله بن جبير روى عن أبيه عن جده عن على روى عنه محمد بن معن الغفاري PageV09P035(@)(@@)(@@)(@@) $ 15043 - محمد بن عبد الله أبو عثمان يروى عن بن أبي نجيح روى عنه أبو معاوية الضرير(@)(@@)(@@)(@@) $ 15044 - محمد بن أبي القاسم يروي عن عبد الملك بن سعيد بن جبير عن أبيه روى عنه بن أبي زائدة(@)(@@)(@@)(@@) $ 15045 - محمد بن عبيدة العكي يروي عن يزيد بن رباح روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 15046 - محمد بن أبي إسرائيل يروي عن عبد الملك بن أبي بشير عن علقمة بن وائل روى عنه همام بن يحيى(@)(@@)(@@)(@@) $ 15047 - محمد بن مسور يروي عن قرين بن إبراهيم بن عبد الرحمن روى عنه إبراهيم بن سعد(@)(@@)(@@)(@@) $ 15048 - محمد بن مسلم بن شريك الثقفي يروي عن إسماعيل مولى قريش عن قيس بن أبي حازم روى عنه الوليد بن كثير المخزومي(@)(@@)(@@)(@@) $ 15049 - محمد بن عمرو الأسدي يروي عن سالم الأفطس روى عنه عبد الله بن الأجلح(@)(@@)(@@)(@@) $ 15050 - محمد بن فضاء العبسي يروي عن عمر بن عبد العزيز روى عنه PageV09P036 أيوب بن سويد الرملي وليس هذا بمحمد بن فضاء صاحب التعبير ذاك واه(@)(@@)(@@)(@@) $ 15051 - محمد بن على الجعفي من أهل الكوفة أخو حسين بن علي الجعفي يروي عن جعفر بن محمد عن أبيه قال سألت جابر بن عبد الله عن حجة النبي صلى الله عليه وسلم ثم ذكره بطوله حدثنا(@)(@@)(@@)(@@) $ 15052 - محمد بن إسحاق الثقفي ثنا أبو كريب ثنا عبد الرحيم بن سليمان ثنا محمد بن علي الجعفي(@)(@@)(@@)(@@) $ 15053 - محمد بن عمير بن أبي الغريف الهمداني من أهل الكوفة يروي عن أبيه روى عنه بن نمير وأبو نعيم(@)(@@)(@@)(@@) $ 15054 - محمد بن إبراهيم الهاشمي يروي عن الكوفيين وإدريس الأودي روى عنه حرمي بن عمارة(@)(@@)(@@)(@@) $ 15055 - محمد بن فكهة من أهل البصرة يروي عن حيان الأعرج عن جابر بن زيد روى عنه مهدى بن ميمون(@)(@@)(@@)(@@) $ 15056 - محمد بن راشد التميمي المكفوف من أهل البصرة يروى عن بن عون روى 
ms1633	 عنه حميد بن مسعدة PageV09P037(@)(@@)(@@)(@@) $ 15057 - محمد بن محمد أبو نافع المدني يروي عن القاسم بن عبد الواحد بن أيمن عن عمر بن عبد الله بن عروة عن عروة عن عائشة كنت لك كأبي زرع لأم زرع وقد سمع القاسم بن عبد الواحد من أبي حازم روى عنه الجدي عبد الملك بن إبراهيم(@)(@@)(@@)(@@) $ 15058 - محمد بن إبراهيم بن عبد الله بن معبد بن عباس الهاشمي من أهل المدينة روى عنه إسماعيل بن أبي أويس(@)(@@)(@@)(@@) $ 15059 - محمد بن الحسن القرشي لقبه محبوب كنيته أبو جعفر يروي عن داود بن أبي هند وخالد بن عون روى عنه خلف بن هشام البزاز وأهل العراق(@)(@@)(@@)(@@) $ 15060 - محمد بن بكر بن عثمان البرساني من أهل البصرة يروى عن بن جريج روى عنه إسحاق بن إبراهيم الحنظلي والناس مات سنة ثلاث ومائتين(@)(@@)(@@)(@@) $ 15061 - محمد بن ربيعة الكلابي أبو عبد الله الرؤاسي من أهل الكوفة يروي عن بن جريج وأبى العميس روى عنه بن أبي شيبة وأهل العراق PageV09P038(@)(@@)(@@)(@@) $ 15062 - محمد بن إبراهيم أبو شهاب الكناني يروي عن عاصم بن بهدلة روى عنه مسدد بن مسرهد(@)(@@)(@@)(@@) $ 15063 - محمد بن سويد العبدي شيخ من أهل البصرة يروي عن داود بن أبي هند روى عنه نصر بن علي الجهضمي(@)(@@)(@@)(@@) $ 15064 - محمد بن إبراهيم بن دينار أبو عبد الله الجهني من أهل المدينة يروي عن بن أبي ذئب روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 15065 - محمد بن عبد الرحمن بن أبي الزناد كنيته أبو عبد الله وكان بينه وبين أبيه سبع عشرة سنة وفي الموت إحدى وعشرين ليلة وقد لقى عامة رجال أبيه مات ببغداد سنة أربع وتسعين ومائة وهو بن سبع وخمسين سنة روى عنه الدراوردي(@)(@@)(@@)(@@) $ 15066 - محمد بن عمرو بن حريث المخزومي يروي عن أبيه عن جده عن على روى عنه بن أبي رواد(@)(@@)(@@)(@@) $ 15067 - محمد بن حبيب بن أبي حبيب يروي عن أبيه روى عنه ابنه عبد الرحمن بن محمد PageV09P039(@)(@@)(@@)(@@) $ 15068 - محمد بن سلمة الحراني أبو عبد الله مولى 
ms1634	 باهلة يروي عن بن إسحاق وهشام بن حسان روى عنه أبو جعفر النفيلي وأهل بلده مات سنة إحدى أو اثنتين وسبعين ومائة(@)(@@)(@@)(@@) $ 15069 - محمد بن عمرو اليافعي يروي عن بن جريج عداده في أهل مصر روى عنه بن وهب(@)(@@)(@@)(@@) $ 15070 - محمد بن إسماعيل البجلي يروي عن يوسف بن محمد روى عنه يوسف بن يعقوب الصفار(@)(@@)(@@)(@@) $ 15071 - محمد بن حمران بن عبد العزيز أبو عبد الله القيسي من أهل البصرة يروي عن بن عون روى عنه المعلى بن أسد والبصريون يخطىء(@)(@@)(@@)(@@) $ 15072 - محمد بن عبد الله بن حسن من أهل المدينة يروي عن أبي الزناد إن كان سمع منه روى عنه الدراوردي عداده في أهل المدينة(@)(@@)(@@)(@@) $ 15073 - محمد بن شرحبيل الهمداني يروي عن موسى بن أبي عائشة روى عنه الحسن بن بشر(@)(@@)(@@)(@@) $ 15074 - محمد بن مسلم بن أبي الوضاح أبو سعيد المؤدب يروي عن إبراهيم بن أبي حرة وزيد بن رفيع وزكريا بن أبي زائدة روى عنه PageV09P040 التبوذكي وأبو داود(@)(@@)(@@)(@@) $ 15075 - محمد بن مجاشع بن محمد الثعلبي أبو الربيع يروي عن أبيه روى عنه عيسى بن يونس ووكيع(@)(@@)(@@)(@@) $ 15076 - محمد بن إسماعيل بن رجاء الزبيدي من أهل الكوفة يروي عن سعيد بن حنظلة العائذي روى عنه يحيى بن آدم(@)(@@)(@@)(@@) $ 15077 - محمد بن مروان أبو بكر العقيلي العجلي من أهل البصرة يروي عن يونس بن عبيد وعبد الملك بن أبي نضرة روى عنه عبد الرحمن بن مهدى(@)(@@)(@@)(@@) $ 15078 - محمد بن سعد الأشهلي الأنصاري أبو سعد يروي عن بن عجلان روى عنه العراقيون محمد بن عبد الله المخرمي وغيره وكان أصله من المدينة سكن بغداد مات بعد المائتين(@)(@@)(@@)(@@) $ 15079 - محمد بن الحجاج البجلي يروي عن القاسم بن الوليد الهمداني روى عنه المحاربي PageV09P041(@)(@@)(@@)(@@) $ 15080 - محمد بن مزاحم أخو الضحاك بن مزاحم من أهل بلخ يروي عن الضحاك بن مزاحم روى عنه الوسيم بن جميل عم قتيبة وقد كتب عن أبي مالك الأشجعي(@)(@@)(@@)(@@) $ 15081 - محمد بن سواء السدوسي أبو الخطاب من أهل البصرة يروي عن 
ms1635	 سعيد بن أبى عروبة روى عنه بن أخيه محمد بن ثعلبة بن سواء والبصريون مات سنة سبع وثمانين ومائة(@)(@@)(@@)(@@) $ 15082 - محمد بن إسماعيل بن مسلم بن أبي فديك مولى بنى الدئل كنيته أبو إسماعيل واسم أبي فديك دينار يروي عن عبد الرحمن بن حرملة وابن أبي ذئب روى عنه الحميدي مات سنة مائتين ربما أخطأ وقد قيل إنه مات سنة تسع وتسعين ومائة بالمدينة(@)(@@)(@@)(@@) $ 15083 - محمد بن عثمان المكي يروي عن علي بن مسلم عن مكحول روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 15084 - محمد بن عبد الله بن نمران يروي عن شراحيل بن عمرو روى عنه سليمان بن عبد الرحمن الدمشقي PageV09P042(@)(@@)(@@)(@@) $ 15085 - محمد بن سليمان بن بلال بن أبي الدرداء أبو سليمان الأنصاري من أهل دمشق يروي عن أبيه وأمه روى عنه هشام بن عمار وأهل الشام(@)(@@)(@@)(@@) $ 15086 - محمد بن عمرو المنقري أخو أبي معمر العقدي من أهل البصرة يروي عن إسماعيل بن مسلم روى عنه عقيل بن مسلم السمرقندي(@)(@@)(@@)(@@) $ 15087 - محمد بن عمرو بن حارثة الأنصاري روى عن وهب بن منبه عن أبيه روى عنه مجمع بن يعقوب(@)(@@)(@@)(@@) $ 15088 - محمد بن المعلى بن عبد الكريم اليامي بن أخي العلاء بن عبد الكريم الهمداني من أهل الكوفة يروي عن عبيد الله بن عمر ومحمد بن إسحاق روى عنه الكوفيون(@)(@@)(@@)(@@) $ 15089 - محمد بن عمرو شيخ يروي عن أبيه عن جده عبد الله بن الأسود روى عنه عبد الحميد بن عقبة(@)(@@)(@@)(@@) $ 15090 - محمد بن عيسى بن القاسم بن سميع القرشي كنيته أبو سفيان وقد قيل أبو الحكم من أهل الشام يروي عن بن أبي ذئب وعبيد الله بن عمر روى عنه هشام بن عمار وأهل الشام مستقيم الحديث إذا بين السماع في خبره فأما خبره الذي روى عن بن أبي ذئب عن الزهري عن سعيد بن المسيب في مقتل عثمان لم يسمعه من بن أبي ذئب سمعه من إسماعيل بن يحيى بن عبيد الله التيمى عن بن أبي ذئب فدلس عنه وإسماعيل واه 
ms1636	 PageV09P043(@)(@@)(@@)(@@) $ 15091 - محمد بن هاشم يروي عن أبي الزناد روى عنه يعقوب بن محمد المدني(@)(@@)(@@)(@@) $ 15092 - محمد بن عمرو بن شور يروي عن عبد الله بن حكيم روى عنه محمد بن حمير(@)(@@)(@@)(@@) $ 15093 - محمد بن يحيى بن سهل بن أبي حثمة الأنصاري من أهل المدينة يروي عن أبيه روى عنه محمد بن صدقة(@)(@@)(@@)(@@) $ 15094 - محمد بن يحيى الإسكندراني يروي عن العلاء بن كثير روى عنه يحيى بن عبد الله بن بكير(@)(@@)(@@)(@@) $ 15095 - محمد بن منصور أبو عبد الله الجندي من أهل اليمن يروي عن عمرو بن مسلم والوليد بن سليم روى عنه بشر بن الحكم(@)(@@)(@@)(@@) $ 15096 - محمد بن نفيع يروي عن خاله عن سالم بن عبد الله روى عنه العلاء بن حصين(@)(@@)(@@)(@@) $ 15097 - محمد بن يوسف بن إبراهيم بن محمد بن طلحة بن عبيد الله التيمي القرشي يروي عن أجداده روى عنه ابنه عبد الله بن محمد PageV09P044(@)(@@)(@@)(@@) $ 15098 - محمد بن نعيم مولى آل عمر بن الخطاب يروي عن محمد بن عمر بن علي روى عنه أبو عقيل(@)(@@)(@@)(@@) $ 15099 - أبو سفيان المعمري اسمه محمد بن حميد الحميري يروي عن معمر ومالك روى عنه العراقيون شريح بن يونس وغيره مات يوم الأربعاء لسبع بقين من شعبان سنة اثنتين ومائتين وإنما قيل له المعمري لأنه رحل إلى معمر(@)(@@)(@@)(@@) $ 15100 - محمد بن الصامت كوفي يروي عن عبد الله بن عمر بن علي روى عنه سيف بن عمر الأموي(@)(@@)(@@)(@@) $ 15101 - محمد بن يحيى بن قيس الماربي أبو عمرو يروي عن أبيه روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 15102 - محمد بن يزيد بن صيفي بن صهيب بن سنان الخير الجدعانى من أهل المدينة روى عن أجداده روى عنه ابنه يوسف بن محمد(@)(@@)(@@)(@@) $ 15103 - محمد بن يعقوب بن المغيرة بن الأخنس الثقفي كان ممن PageV09P045 يخشى الله ويتقيه يروي عن عبد الله بن عكرمة بن عبد الرحمن روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 15104 - محمد بن يزيد الحارثي يروي عن مجمع بن عتاب الشقري روى عنه زيد بن حباب(@)(@@)(@@)(@@) $ 15105 
ms1637	 - محمد بن عبد الله البصري يروي عن أيوب بن أبي تميمة السختياني روى عنه محمد بن يزيد بن سنان(@)(@@)(@@)(@@) $ 15106 - محمد بن عبد الرحمن بن عمرو الأوزاعي يروي عن أبيه روى عنه بقية بن الوليد حدثني محمد بن المعافي العابد وعمر بن محمد قالا ثنا عمرو بن عثمان ثنا بقية عن بن الأوزاعي عن أبيه في الطير الميتة يوجد في جوفها الحيتان قال لا بأس بأكلها وفي البعير يأكل القمح فيموت فيخرج القمح من جوفه قال يغسل ويؤكل حدثنا مكحول ثنا يزيد بن عبد الصمد ثنا أبو مسهر حدثني محمد بن الأوزاعي قال قال لي أبي يا بنى لو قبلنا من الناس كل ما يعرضون علينا لأوشك أن نهون عليهم(@)(@@)(@@)(@@) $ 15107 - محمد بن يعقوب شيخ يروي عن يحيى بن أبي كثير روى عنه عنبسة بن عبد الواحد(@)(@@)(@@)(@@) $ 15108 - محمد بن أبي عبيدة بن معن بن عبد الرحمن بن عبد الله بن مسعود PageV09P046 الهذلي من أهل الكوفة يروي عن وكيع وأبيه روى عنه بن أبي شيبة وأهل العراق مات سنة خمس ومائتين(@)(@@)(@@)(@@) $ 15109 - محمد بن زياد بن مروان اليشكري صاحب سنة وفضل من أهل نجار يروي عن عثمان بن عبد الرحمن الوقاصي عن الزهري بنسخة روى عنه جعفر بن داود الربعي النجاري وليس هذا بمحمد بن زياد اليشكري الجزري ذاك واه(@)(@@)(@@)(@@) $ 15110 - محمد بن عمر بن كيسان بن أبي يزيد الصنعاني يروي عن أبيه روى عنه عبد الله بن إبراهيم بن عمر بن كيسان(@)(@@)(@@)(@@) $ 15111 - محمد بن يزيد العطار من أهل الكوفة يروي عن شيخ عن أبيه عن على أنه توضأ فنزع خاتمه روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 15112 - محمد بن يزيد الكلابي وقد قيل كلاعي من أهل واسط كنيته أبو سعيد يروي عن العوام بن حوشب وسفيان بن حسين مات سنة تسعين ومائة وقد قيل سنة تسع وثمانين ومائة روى عنه أحمد بن حنبل وأهل العراق(@)(@@)(@@)(@@) $ 15113 - محمد بن خثيم بن عراك بن مالك الغفاري يروي عن أبيه عن جده 
ms1638	 عن أبي هريرة روى عنه خالد بن مخلد القطواني PageV09P047(@)(@@)(@@)(@@) $ 15114 - محمد بن أبي مروان يروي عن أبيه عن سالم روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 15115 - محمد بن أبى بكر المقرىء من أهل الكوفة يروي عن صدقة بن أبي عمران ثنا إبراهيم بن نصر العنبري بكمشاكث ثنا عبد الله بن عبد الرحمن السمرقندي ثنا محمد بن أبي بكر ثنا صدقة بن أبي عمران عن علقمة بن مرثد عن زاذان أبي عمر عن البراء قال سمعت رسول الله صلى الله عليه وسلم يقول حسنوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا(@)(@@)(@@)(@@) $ 15116 - محمد بن إسماعيل الضبي ختن أبي المعلى العطار من أهل البصرة يروي عن أبي المعلى العطار عن سعيد بن جبير روى عنه علي بن حميد الباهلي(@)(@@)(@@)(@@) $ 15117 - محمد بن سليم البلخي الذي يقال له الخراساني جليس بن عيينة أصله من مصر يروي عن الضحاك بن مزاحم روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 15118 - محمد بن عبد الرحمن بن يحنس يروي عن أبي سفيان الأخنسي روى عنه بن أبي فديك PageV09P048(@)(@@)(@@)(@@) $ 15119 - محمد بن ميمون يروي عن بلال مؤذن مسجد دمشق روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 15120 - محمد بن حنظلة بن محمد بن عباد بن جعفر المخزومي القرشي يروي عن معروف بن مشكان روى عنه إبراهيم بن محمد الشافعي(@)(@@)(@@)(@@) $ 15121 - محمد بن عبد الملك أبو إسماعيل الواسطي يروي عن الحسن بن عبيد الله ويحيى بن أبي كثير روى عنه بقية بن وهب بن بقية يعتبر حديثه إذا بين السماع في خبره في روايته فإنه كان مدلسا يخطىء(@)(@@)(@@)(@@) $ 15122 - محمد بن إسحاق العدني يروي عن سعيد بن زياد عن جابر بن زيد روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 15123 - محمد بن أبي بكر يروي عن أيوب السختياني روى عنه البصريون(@)(@@)(@@)(@@) $ 15124 - محمد بن ميمون السمان يروي عن أمه ميمونة بنت أم سرحان روى عنه مسلم بن إبراهيم الأموي(@)(@@)(@@)(@@) $ 15125 - محمد بن حمزة الأسدي من أهل الكوفة يروي عن جعفر بن برقان روى عنه 
ms1639	 سعيد بن يحيى الأموي PageV09P049(@)(@@)(@@)(@@) $ 15126 - محمد بن حرب الأبرش أبو عبد الله الخولاني الحمصي مولى لقريش يروي عن الزبيدي ومالك روى عنه عمرو بن عثمان وأهل الشام مات سنة اثنتين وتسعين ومائة وكان البحيري يحكي عن عمرو بن عثمان أنه مات سنة أربع وتسعين ومائة(@)(@@)(@@)(@@) $ 15127 - محمد بن جعفر غندر صاحب الكرابيس كنيته أبو عبد الله الهذلي صاحب الطيالسة من أهل البصرة يروي عن شعبة ومعمر روى عنه أحمد بن محمد بن حنبل ويحيى وأهل العراق وكان من خيار عباد الله ومن أصحهم كتابا على غفلة فيه مات في ذي القعدة يوم الجمعة سنة ثلاث وتسعين ومائة في النصف منه وكان بن امرأة شعبة وقيل إنه سمع حميد الطويل وكان مولى هذيل(@)(@@)(@@)(@@) $ 15128 - محمد بن شعيب بن شابور القرشي مولى بنى أمية من أهل الشام يروي عن الأوزاعي وعثمان بن أبي العاتكة روى عنه هشام بن عمار وأهل الشام ولد سنة ست عشرة ومائة ومات سنة مائتين وقد قيل سنة ثمان وتسعين ومائة(@)(@@)(@@)(@@) $ 15129 - محمد بن عقبة الشيباني أخو الوليد بن عقبة يروي عن أبي إسحاق الفزاري كنيته أبو عبد الله روى عنه عثمان بن أبى شيبة PageV09P050(@)(@@)(@@)(@@) $ 15130 - محمد بن سويد من أهل البصرة يروي عن عمران القصير روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 15131 - محمد بن عثمان البصري يروي عن سليمان بن موسى روى عنه بن عياش(@)(@@)(@@)(@@) $ 15132 - محمد بن سهل الأسدي يروي عن ورقاء بن عمر روى عنه الكسائي صاحب القراءات(@)(@@)(@@)(@@) $ 15133 - محمد بن أبي شبابة من أهل البصرة يروي عن عباس بن الأشعث عن الحسن روى عنه محمد بن عقبة(@)(@@)(@@)(@@) $ 15134 - محمد بن عمرو بن مقسم الصنعاني يروي عن عطاء بن مسلم وأهل اليمن روى عنه أهل بلده والغرباء حدثنا أبو خليفة ثنا علي بن المديني ثنا محمد بن عمرو بن مقسم قال سمعت عطاء بن مسلم يقول سمعت وهب بن منبه يقول إن الله كلم موسى في ألف مقام وكان إذا كلمه رئى النور على وجه موسى 
ms1640	 ثلاثة أيام قال فلم يمس موسى امرأة بعدما كلمه ربه(@)(@@)(@@)(@@) $ 15135 - محمد بن سلمة الحراني يروي عن هشام بن حسان روى عنه أهل الجزيرة مات سنة ثنتين وتسعين ومائة PageV09P051(@)(@@)(@@)(@@) $ 15136 - محمد بن أبي أكيزة أبو أيوب من أهل البصرة يروي عن أيوب السختياني وأشعث الحداني روى عنه بشر بن الحكم(@)(@@)(@@)(@@) $ 15137 - محمد بن منيب أبو الحسن يروي عن السرى بن يحيى روى عنه أحمد بن سعيد الدارمي(@)(@@)(@@)(@@) $ 15138 - محمد بن شرحبيل بن جعشم اليماني يروى عن بن جريج روى عنه رجاء بن مرجى المروزي وأهل اليمن مستقيم الحديث(@)(@@)(@@)(@@) $ 15139 - محمد بن سليمان الأصبهاني شيخ من أهل الكوفة يروي عن سهيل بن أبي صالح روى عنه فروة بن أبي المغراء الكندي يخالف ويخطىء(@)(@@)(@@)(@@) $ 15140 - محمد بن العلاء الصهيبي يروي عن جعفر بن محمد روى عنه عبد الله بن الحارث المخزومي(@)(@@)(@@)(@@) $ 15141 - محمد بن عبد الله الأعشى القارىء من أهل المدينة يروي عن عبد الرحمن بن محمد روى عنه إبراهيم بن حمزة الزبيري PageV09P052(@)(@@)(@@)(@@) $ 15142 - محمد بن ميمون بن عجلان الربعي التميمي من أهل البصرة يروي عن أبيه روى عنه محمد بن عقبة السدوسي(@)(@@)(@@)(@@) $ 15143 - محمد بن صالح بن عمر بن نافع أبو عبد الله مولى آل جعونة حليف آل العباس بن عبد المطلب لقبه مكيس يروي عن أبيه روى عنه بشر بن عنبس بن مرحوم العطار(@)(@@)(@@)(@@) $ 15144 - محمد بن موسى بن أبي عبد الله مولى الفطريين من أهل المدينة وقد قيل مخزومي يروي عن سعد بن إسحاق روى عنه الدراوردي وعبد الرحمن بن مهدي(@)(@@)(@@)(@@) $ 15145 - محمد بن سليمان العيذي يروي عن هارون بن سعد الأعور روى عنه إسحاق بن منصور السلولي(@)(@@)(@@)(@@) $ 15146 - محمد بن أبي بكر أبو غاضرة يروي عن غضبان بن حنظلة روى عنه موسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 15147 - محمد بن طلحة بن عبد الرحمن بن طلحة بن عبيد الله بن عثمان بن عمرو بن كعب بن سعد بن تيم بن مرة أبو عبد الله التيمي القرشي الذي PageV09P053 يقال له بن 