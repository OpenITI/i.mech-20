ms41	(@)(@@) 36 ونم بطيفها الساري جواد ، %~% فجنبنا الزيارة والوصالا ،(@)(@@) 37 وأيقظ بالصهيل الركب حتى %~% ظننت صهيله قيلا وقالا(@)(@@) 38 %~% لبات يرى الغزالة والغزالا(@)(@@) 39 يحس ، إذا الخيال دنا إلينا ، %~% فيمنع من تعهدنا الخيالا(@)(@@) 40 سرى برق المعرة بعد وهن ، %~% فبات برامة يصف الكلالا PageV01P266(@)(@@) 41 شجا ركبا وأفراسا وإبلا ، %~% وزاد ، فكاد أن يشجو الرحالا(@)(@@) 42 بها كانت جيادهم مهارا ، %~% وهم مردا ، وبزلهم فصالا .(@)(@@) 43 ومن صحب الليالي علمته %~% خداع الإلف والقيل المحالا ،(@)(@@) 44 وغيرت الخطوب عليه حق %~% تريه الذر يحملن الجبالا ،(@)(@@) 45 فليت شباب قوم كان شيبا ، %~% وليت صباهم كان اكتهالا(@)(@@) 46 صحبنا بالدية من حصين %~% وحصن شر من صحب الرجالا ،(@)(@@) 47 إذا سقيت ضيوف الناس محضا ، %~% سقوا أضيافهم شبما زلالا(@)(@@) 48 ولكن بالعواصم ، من عدي ، %~% أمير لا يكلفنا السؤالا(@)(@@) 49 إذا خفقت لمغربها الثريا ، %~% توقت من أسنته اغتيالا ،(@)(@@) 50 ولو شمس الضحى قدرت لعادت %~% مشرقة ، إذا رأت الزوالا PageV01P267(@)(@@) 51 %~% إذا ما لم يجد فرس مجالا :(@)(@@) 52 لقد جشمت طرفك مثقلات ، %~% فجشمهن أربعة عجالا .(@)(@@) 53 أذال الجري منه زبرجديا ؛(@)(@@) 54 وقد يلفى زبرجده عقيقا ، %~% إذا شهد الأمير به القتالا .(@)(@@) 55 أخف من الوجيه يدا ورجلا ؛ %~% وأكرم في الجياد أبا وخالا(@)(@@) 56 وكل ذؤابة ، في رأس خود ، %~% تمنى أن تكون له شكالا(@)(@@) 57 يود التبر لو أمسى حديدا %~% إذا حذي الحديد له نعالا .(@)(@@) 58 إذا ما الغيم لم يمطر بلادا %~% فإن له على يدك اتكالا ،(@)(@@) 59 ولو أن الرياح تهب غربا %~% وقلت لها : هلا هبت شمالا ،(@)(@@) 60 واقسم ، لو غشبت على ثبير %~% لأزمع عن محلته ارتحالا PageV01P268(@)(@@) 61 فإن عشقت صوارمك الهوادي %~% فلا عدمت بمن تهوى اتصالا ،(@)(@@) 62 ولولا ما بسيفك من نحول ، %~% لقلنا أظهر الكمد انتحالا(@)(@@) 63 سليل النار ، دق ورق ، حتى %~% كأن أباه أورثه السلالا ،(@)(@@) 64 محلى البرد ، تحسبه تردى %~% نجوم الليل ، وانتعل الهلالا(@)(@@) 65 مقيم النصل في طرفي نقيض %~% يكون تباين منه اشتكالا ،(@)(@@) 66 تبين فوقه ضخضاح ماء %~% وتبصر فيه للنار اشتعالا(@)(@@) 67 غراراه لسانا مشرفي %~% يقول غرائب الموت ارتجالا(@)(@@) 68 
ms42	 إذا بصر الأمير وقد نضاه %~% بأعلى الجو ظن عليه آلا ،(@)(@@) 69 ودبت فوقه حمر المنايا ، %~% ولكن بعدما مسخت نمالا(@)(@@) 70 يذيب الرعب منه كل عضب ، %~% فلولا الغمد يمسكه لسالا PageV01P269(@)(@@) 71 ومن يك ذا خليل غير سيف %~% يصادف ، في مودته ، اختلالا(@)(@@) 72 وذي ظمإ ، وليس به حياة ، %~% تيقن طول حامله فطالا ،(@)(@@) 73 توهم كل سابغة غديرا ، %~% فرنق يشرب الحلق الدخالا(@)(@@) 74 ملأت به صدورا من أناس %~% فلاقت ، عن ضغائنها ، اشتغالا(@)(@@) 75 ليهنك في المكارم والمعالي ، %~% كمال علم القمر الكمالا(@)(@@) 76 وأنك لو تعلقت الرزايا %~% بنعلك ما قطعن لها قبالا .(@)(@@) 77 حفظت المسلمين وقد توالت %~% سحائب تحمل النوب الثقالا ،(@)(@@) 78 وصنت عيالهم إذ كل عين %~% تعد سواد ناظرها عيالا(@)(@@) 79 بوقت ، لا يطيق الليث فيه %~% مساورة ، ولا السيد اختتالا(@)(@@) 80 بعودته ، ف %~% فهنيت الجلالا PageV01P270(@)(@@) 81 ومر بفراق شيمتها اليالي %~% تجبك إلى ارادتك امتثالا .(@)PageV01P271(@)(@@) البحر : بسيط تام(@)(@@) 1 يا ساهر البرق أيقظ راقد السمر ، %~% لعل بالجزع أعوانا على السهر(@)(@@) 2 وإن بخلت عن الأحياء كلهم ، %~% فاسق المطر حيا من بني مطر(@)(@@) 3 ويا أسيرة حجليها ! أرى سفها %~% حمل الحلي لمن أعيا عن النظر(@)(@@) 4 ما سرت إلا وطيف منك يصحبني %~% سرى أمامي ، وتأويبا على أثري(@)(@@) 5 في الجفن يطوى على نار ولا نهر %~% ألفيت ثم خيالا منك منتظري(@)(@@) 6 يود أن ظلام الليل دام له %~% وزيد فيه سواد القلب والبصر(@)(@@) 7 لو اختصرتم من الاحنسان زرتكم %~% والعذب يهجر للإفراط في الخصر(@)(@@) 8 أبعد حول تناجي الشوق ناجية ، %~% هلا ونحن على عشر من العشر(@)(@@) 9 خف الورى ، وأقرتكم حلومكم ؛ %~% يستجديانك حسن الدل والحور(@)(@@) 10 فما وهبت الذي يعرفن من خلق ، %~% لكن سمحت بما ينكرن من درر ، PageV01P272(@)(@@) 11 وما تركت ، بذات الضال ، عاطلة %~% من الظباء ولا عار من البقر ،(@)(@@) 12 قلدت كل مهاة عقد غانية %~% وفزت بالشكر في الآرام والعفر(@)(@@) 13 ورب ساحب وشي من جآذرها ، %~% وكان يرفل في ثوب من الوبر ،(@)(@@) 14 حسنت نظم كلام توصفين به ، %~% ومنزلا بك معمورا من الخفر ،(@)(@@) 15 فالحسن 
ms43	 يظهر ، في شيئين ، رونقه : %~% بيت من الشعر ، أو بيت من الشعر(@)(@@) 16 أقول ، والوحش ترميني بأعينها %~% والطير تعجب مني كيف لم أطر :(@)(@@) 17 لمشمعلين كالسيفين تحتهما %~% مثل القناتين من أين ومن ضمر ،(@)(@@) 18 في بلدة مثل ظهر الظبي بت بها ، %~% كأنني فوق روق الظبي من حذر(@)(@@) 19 لا تطويا السر عني يوم نائبة ، %~% فان ذلك ذنب غير مغتفر(@)(@@) 20 والخل كالماء ، يبدي لي ضمائره %~% مع الصفاء ، ويخفيها مع الكدر PageV01P273(@)(@@) 21 يا روع الله سوطي ، كم أروع به %~% فؤاد وجناء مثل الطائر الحذر(@)(@@) 22 باهت بمهرة عدنانا فقلت لها : %~% لولا الفصيصي كان المجد في مضر(@)(@@) 23 وقد تبين قدري أن معرفتي %~% من تعلمين سترضيني عن القدر(@)(@@) 24 القاتل المحل إذا تبدو السماء لنا %~% كأنها من نجيع الجدب في أزر ،(@)(@@) 25 فما يزيد على أيامنا الأخر %~% كقسمة الغيث بين النجم والشجر ،(@)(@@) 26 لما تواضع أقوام على غرر %~% في وصفه معجزات الآي والسور(@)(@@) 27 يبين بالبشر عن إحسان مصطنع %~% كالسيف دل على التأثير بالأثر .(@)(@@) 28 فلا يغرنك بشر من سواه بدا ، %~% ولو أنار ، فكم نور بلا ثمر !(@)(@@) 29 يا ابن الأولى ! غير زجر الخيل ما عرفوا %~% إذ تعرف العرب زجر الشاء والعكر(@)(@@) 30 والقائديها مع الأضياف تتبعها %~% ألافها وألوف اللام والبدر PageV01P274(@)(@@) 31 جمال ذي الأرض ، كانوا في الحياة وهم %~% بعد الممات جمال الكتب والسير(@)(@@) 32 وافقتهم في اختلاف من زمانكم ، %~% والبدر في الوهن مثل البدر في السحر(@)(@@) 33 الموقودون بنجد نار بادية %~% لا يحضرون وفقد العز في الحضر(@)(@@) 34 إذا همى القطر شبتها عبيدهم %~% تحت الغمائم ، للسارين بالقطر(@)(@@) 35 من كل أزهر لم تأشر ضمائره %~% للثم خد ولا تقبيل ذي أشر(@)(@@) 36 لكن يقبل فوه سامعي فرس ، %~% مقابل الخلق بين الشمس والقمر(@)(@@) 37 كأن أذنيه أعطت قلبه خبرا %~% عن السماء ، بما يلقى من الغير(@)(@@) 38 يحس وطء الرزايا ، وهي نازلة ، %~% وإن تخالفن ، أبدال من الزهر(@)(@@) 39 من الجياد اللواتي كان عودها %~% بنو الفصيص ، لقاء الطعن بالثغر(@)(@@) 40 تغنى عن الورد إن سلوا صوارمهم 
ms44	 %~% أمامها ، لاشتباه البيض بالغدر PageV01P275(@)(@@) 41 أعاذ مجدك عبد الله خالقه %~% من أعين الشهب لا من أعين البشر(@)(@@) 42 فالعين يسلم منها ما رأت فنبت %~% عنه ، وتلحق ما تهوى من الصور(@)(@@) 43 فكم فريسة ضرغام ظفرت بها ، %~% فحزتها وهي بين الناب والظفر(@)(@@) 44 ما جت نمير فهاجت منك ذا لبد %~% والليث أفتك أفعالا من النمر(@)(@@) 45 هموا فأموا ، فلما شارفوا وقفوا ، %~% كوقفة العير بين الورد والصدر ،(@)(@@) 46 وأضعف الرعهب أيديهم ، فطعنهم %~% بالسمهرية ، دون الوخز بالإبر(@)(@@) 47 تلقي الغواني حفيظ الدر من جزع %~% عنها وتلقي الرجال السرد من خور(@)(@@) 48 فكم دلاص على البطحاء ساقطة ، %~% وكم جمان ، مع الحصباء ، منتثر(@)(@@) 49 دع اليراع لقوم يفخرون به ، %~% وبالطوال الردينيات فافتخر(@)(@@) 50 فهن أقلامك اللاتي إذا كتبت %~% مجدا ، أتت بمداد من دم هدر . PageV01P276(@)(@@) 51 وكل أبيض هندي ، به شطب ، %~% مثل التكسر في جار بمنحدر(@)PageV01P277(@)(@@) البحر : وافر تام(@)(@@) 1 معان من احبتنا معان %~% تجيب الصاهلات به القيان(@)(@@) 2 وقفت به لصون الود حتى %~% أذلت دموع جفن ما تصان(@)(@@) 3 ولاحت من بروج البدر بعدا %~% بدور مها ، تبرجها اكتنان(@)(@@) 4 فلو سمح الزمان بها لضنت ؛ %~% ولو سمحت لضن بها الزمان ،(@)(@@) 5 رزقن تمكنا من كل قلب %~% فليس لغيرهن به مكان .(@)(@@) 6 وفيت وقد جزيت بمثل فعلي %~% فها أنا لا أخون ولا أخان .(@)(@@) 7 وعيشتي الشباب ، وليس منها %~% صباي ، ولا ذوائبي الهجان ،(@)(@@) 8 وكالنار الحياة ، فمن رماد ، %~% أواخرها وأولها دخان(@)(@@) 9 إلام وفيم تنقلنا ركاب ، %~% وتأمل أن يكون لنا أوان(@)(@@) 10 فنجزيها على الحسنى ، وأهل ، %~% لما ظنت ، خلائقك الحسان PageV01P278(@)(@@) 11 وكانت كالنخيل ، فظل كل ، %~% ومشبهه من الضمر الإهان(@)(@@) 12 تخيلت الصباح معين ماء ، %~% فما صدقت ولا كذب العيان ،(@)(@@) 13 فكاد الفجر تشربه المطايا ، %~% وتملأ منه أسقية شنان(@)(@@) 14 وقد دقت هواديهن ، حتى %~% كأن رقابهن الخيزران(@)(@@) 15 إذا شربت ، رايت الماء فيها %~% أزيرق ، ليس يستره الجران ،(@)(@@) 16 سترجع عنك وهي أعز إبل %~% أحبك في ضمائره ، ونادى(@)(@@) 17 لها فرحا فويق الأرض أرض ، %~% ومن تحت اللجين لها لجان(@)(@@) 18 
ms45	 ترى ، ما نالت الأضياف ، نزرا ، %~% ولو ملئت من الذهب الجفان .(@)(@@) 19 ويطلب منك ما هو فيك طبع ، %~% ومطلوب من اللسن البيان(@)(@@) 20 وممتحن لقاءك ، وهو موت ، %~% وهل ينبي عن الموت امتحان ؟ PageV01P279(@)(@@) 21 ومضطغن عليك ، وليس يجدي %~% ولا يعدي على الشمس اضطغان .(@)(@@) 22 ورب مساتر بهواك عزت %~% سوائره ، وكل هوى هوان ،(@)(@@) 23 أجنك في ضمائره ونادى %~% ليعلنها ، وقد فات العلان ،(@)(@@) 24 وصلى ، ثم أذن مستقيلا ، %~% وقبل صلاته وجب الأذان .(@)(@@) 25 تضمن منك ذي الدنيا مليكا ، %~% كما سلك المضيق الأفعوان(@)(@@) 26 كأن بجارها الحيوان فيها %~% وقربك خلدها ، وهي الجنان(@)(@@) 27 وتعذل حين لم تجنن سرورا ن %~% وتعذر حيث ليس لها جنان ،(@)(@@) 28 ولو طرب الجماد لكان أولى %~% شروب الراح بالطرب الدنان(@)(@@) 29 ولما دالت العرب اغتصابا %~% واضحت جل طاعتها دهان ،(@)(@@) 30 وعادت جاهليتها إليها %~% فصارت لا تدين ولا تدان ، PageV01P280(@)(@@) 31 سطوت ، ففي وظيف الصعب قيد %~% بذاك ، وفي وتيرته عران .(@)(@@) 32 وقد ينمي كبير من صغير %~% وينبت من نوى القسب الليان ،(@)(@@) 33 وعنت ، في سماء بني عدي ، %~% نجوم ما يغبيها عنان(@)(@@) 34 فما عبدت سوى الرحمن ربا ، %~% إذ المعبود نسر والمدان(@)(@@) 35 إذا البرجيس والمريخ راما %~% سوى ما رمت ، خانهما الكيان(@)(@@) 36 هما العبدان إن بغياك غدرا ، %~% فما فعلا إباق أو دفان(@)(@@) 37 تقارن بين أشتات المنايا %~% بضرب ليس يحسنه قران ،(@)(@@) 38 ولولا قولك الخلاق ربي ، %~% لكان لنا بطلعتك افتتان .(@)(@@) 39 تخب بك الجياد كأن جونا %~% على لباتهن الأرجوان ،(@)(@@) 40 مضمرة كأن الحجر منها ، %~% ما آنست فزعا ، حصان PageV01P281(@)(@@) 41 بنات الخيل تعرفها دلوك %~% وصارخة ، وآلس ، واللقان(@)(@@) 42 كان قطاة أعجزها قطاة %~% أديف بمحرجيها الزعفران ،(@)(@@) 43 كأن جناحها قلب المعادي ، %~% وليك كلما اعتكر الجنان ،(@)(@@) 44 معيد مبدئ ، فالآم مما %~% فعلت البكر وابنتها العوان ،(@)(@@) 45 وكائن قد وردت بها غديرا %~% وللمهجات بالري ارتهان(@)(@@) 46 به غرقى النجوم : فبين طاف(@)(@@) 47 أجد به غواني الجن لعبا ، %~% فأعجلها الصباح ، وفيه جان(@)(@@) 48 فصيم نصفه في الماء باد ، %~% ونصف في السماء به تزان(@)(@@) 49 كأن الليل حاربها ففيه 
ms46	 %~% هلال مثل ما انعطف السنان(@)(@@) 50 ومن أم النجوم عليه درع %~% يحاذر أن يمزقها الطعان PageV01P282(@)(@@) 51 وقد بسطت ، غلى الغرب ، الثريا %~% يدا غلقت بأنملها الرهانن(@)(@@) 52 كأن يمينها سرقتك شيئا ، %~% ومقطوع على السراق البنان .(@)(@@) 53 إذا ضربت خيامك في مكان %~% فذلك حيث يلتقط الجمان(@)(@@) 54 %~% وحق لها ادخار واختزان(@)(@@) 55 كلا كفيك ، في سلم وحرب ن %~% يكون الخوف منها والأمان ،(@)(@@) 56 فليس بشاغل اليمنى حسام ، %~% وليس بشاغل اليسرى عنان(@)(@@) 57 فكن في كل نائبة جريئا ،(@)(@@) 58 وسائل من تنطس في التوقي : %~% لأية علة مات الجبان ؟(@)(@@) 59 فإن تعاون الاملاك جهل %~% على ملك يخالقه يعان ،(@)(@@) 60 يعبر سيفه لفظ المنايا ، %~% كما شرح الكلام الترجمان ، PageV01P283(@)(@@) 61 ويسلك رمحه في كل باغ(@)(@@) 62 ويكنى باسمه عن كل مجد ، %~% وكل اسم كنايته فلان ،(@)(@@) 63 ويعدم عنده في الجود مطل ، %~% ومعدوم مع العتق الحران(@)(@@) 64 إذا سميته في أرض جدب %~% نزلت ، وكل رابية خوان(@)(@@) 65 تطاولت الوهاد هوى وشوقا %~% إليه ، كما تقاصرت الرعان(@)(@@) 66 ستفديك المكارم راضيات ، %~% وما منها ، بفديتك ، امتنان(@)(@@) 67 إذا صالت ، فأنت لها يمين ، %~% وإن نطقت ، فأنت لها لسان(@)PageV01P284(@)(@@) البحر : خفيف تام(@)(@@) 1 إبق في نعمة ، بقاء الدهور ، %~% نافذ الأمر في جميع الأمور ،(@)(@@) 2 خاضعات لك الكواكب تختص %~% ص مواليك بالمحل الأثير(@)(@@) 3 لا يؤثرن في الولي ولا الحا %~% سد حتى تشير بالتأثير ،(@)(@@) 4 وتهن النعمى السنية والبس %~% حلل المجد والفعال الخطير ،(@)(@@) 5 وتمتع بنضرة العيش إذا جا %~% ءتك في رونق الزمان النضير(@)(@@) 6 خير أيدي الزمان عند بني الدنيا %~% يا ، أتت في أوان خير الشهور(@)(@@) 7 كنت موسى وافتك بنت شعيب %~% غير أن ليس فيكما من فقير ،(@)(@@) 8 لم يكن قصرك المنيف ليستن %~% زل ، إلا أعلى بنات القصور(@)(@@) 9 رحلت ، من فنائه ، شهب الغل %~% مان خوفا من ضوء فجر منير(@)(@@) 10 كان كالأفق حين همت به %~% الشمس تنادت نجومه بالمسير ، PageV01P285(@)(@@) 11 يا لها نعمة ، وليس ببدع %~% ان تحوز الشموس رق البدور ،(@)(@@) 12 درة من ذراك تسكن بحرا ؛ %~% وكذا الدر ساكن في 
ms47	 البحور ،(@)(@@) 13 أنت شمس الضحى ، فمنك يفيد %~% الصبح ما فيه من ضياء ونور(@)(@@) 14 قد أتاك الربيع بفعل ما تأ %~% مره فعل عبدك المأمور ،(@)(@@) 15 وكسا الأرض ، خدمة لكك يا مو %~% لاه دون الملوك ، خضر الحرير(@)(@@) 16 فهي تختال في زبرجدة خض %~% راء ، تغدى بلؤلؤ منثور(@)(@@) 17 وغدت كل ربوة تشتهي الرق %~% ص بثوب ، من النبات ، قصير(@)(@@) 18 ظل للناس يوم عقدك هذا ال %~% مر عيد سموه : عيد السرور ،(@)(@@) 19 إن يكن عيدهم بغير هلال ، %~% فالهلال المنير وجه الأمير ،(@)(@@) 20 راقهم منظرا ، وهابوه خوفا ، %~% فهو ملء العيون ، ملء الصدور PageV01P286(@)(@@) 21 سر أهل الأمصار والبدو ، حتى %~% جازهم عامدا ، لأهل القبور ،(@)(@@) 22 رد أرواحهم ، فلولا حذار الله %~% قاموا من قبل يوم النشور .(@)(@@) 23 لا تسل عن عداك أين استقروا ، %~% لحق القوم باللطيف الخبير ،(@)(@@) 24 حلب ، للولي ، جنة عدن ، %~% وهي ، للغادرين ، نار سعير(@)(@@) 25 والعظيم العظيم ، يكبر في عينيه ، %~% منها ، قدر الصغير الصغير ،(@)(@@) 26 ففويق ، في أنفس القوم ، بحر %~% وحصاة ، منها ، نظير ثبير(@)(@@) 27 عشت حتى يعود امس لعلمي %~% إنه لا يعود بعد المرور ،(@)(@@) 28 فادعاء الملوك ، غيرك ، إدرا %~% ك المعالي ، دعوى شقاق وزور .(@)PageV01P287(@)(@@) البحر : وافر تام(@)(@@) 1 ألاح ، وقد رأى برقا مليحا ، %~% سرى فأتى الحمى نضوا طليحا(@)(@@) 2 كما أغذى الفتى ليذوق غمضا ، %~% فصادف جفنه جفنا قريحا .(@)(@@) 3 إذا ما اهتاج أحمر مستطيرا %~% حسبت الليل زنجيا جريحا(@)(@@) 4 أقول لصاحبي ، إذا هام وجدا %~% ببرق ، ليس يثبته نزوحا ،(@)(@@) 5 وهاجته الجنوب لوصل حي %~% اقام ، ويمموا دارا طروحا ،(@)(@@) 6 سفاه لوعة النجدي لما %~% تنسم ، من حيال الشأم ، ريحا(@)(@@) 7 وغي لمح عينك شطر نجد %~% إذا ما آنست برقا لموحا(@)(@@) 8 وأمراض المواعيد أعلمتني %~% بأن ، وراءها ، سقما صحيحا(@)(@@) 9 متى نصبح ، وقد فتنا الأعادي ، %~% نقم حتى تقول الشمس روحا ،(@)(@@) 10 بأرض للحمامة أن تغني %~% بها ، ولمن تأسف أن ينوحا . PageV01P288(@)(@@) 11 أعباد المسيح يخاف صحبي ، %~% ولم يحذين من عجل سريحا(@)(@@) 12 رأيتك واحدا أبرحت عزما %~% ومثلك من رأى الرأي النجيحا(@)(@@) 13 فم تؤثر على مهر فصيلا 
ms48	 ، %~% ولم تختر ، على حجر ، لقوحا(@)(@@) 14 ركبت الليل في كيد الأعادي %~% وأعددت الصباح له صبوحا(@)(@@) 15 وأعظم حادث فرس كريم %~% يكون مليكه رجلا شحيحا(@)(@@) 16 تريك له سماء فوق ارض %~% فروج قوائم ، يعددن لوحا(@)(@@) 17 أصيل الجد ، سابقه تراه %~% على الأين المكرر ، مستريحا(@)(@@) 18 كأن غبوقه ، من فرط ري ، %~% أباه جسمه فبدا مسيحا ،(@)(@@) 19 كأن الركض أبدى المحض منه %~% فمج لبانه لبنا صريحا .(@)(@@) 20 وأرباب الجياد بنو علي ، %~% مزيروها الذوابل والصفيحا PageV01P289(@)(@@) 21 وخير الخيل ما ركبوا فجنب %~% غرابا والنعامة والجموحا ،(@)(@@) 22 واحمى العالمين ذمار مجد %~% بنو إسحق إن مجد ابيحا .(@)(@@) 23 ومعرفة ابن أحمد أمنتني %~% فلا أخشى الحقيب ولا النطيحا ،(@)(@@) 24 إذا استبقت خيول المجد يوما %~% جرين بوارحا ، وجرى سنيحا(@)(@@) 25 ولو كتب اسمه ملك هزيم ، %~% على راياته ، وإلى الفتوحا .(@)(@@) 26 فيا ابن محمد ، والمجد رزق ، %~% بقدرك سدت لا قدر أتيحا ،(@)(@@) 27 وما فقد الحسين ولا عليا %~% ولي هدى ، رآك له نصيحا .(@)(@@) 28 هممن بدلجة وخشين جنحا ، %~% فبتنا ، فوق أرجلها ، جنوحا(@)(@@) 29 أشحن وقد أقمن على وفاز %~% ثلاث حنادس ، يرعين شيحا(@)(@@) 30 دجى ، تتشابه الأشباح فيه ، %~% فيجهل جنسها ، حتى يصيحا PageV01P290(@)(@@) 31 فمر العام لم تطرق أنيسا %~% بدارهم ؛ ولم تسمع نبوحا(@)(@@) 32 ولا عبثت بعشب في ربيع %~% ولا وردت على ظمإ نضيحا .(@)(@@) 33 فأقسم ، ما طيور الجو سحما %~% كهن ، ولا نعام الدو روحا ،(@)(@@) 34 ودون لقائك الهضبات شما %~% تفوت الطرف والفلوات فيحا ،(@)(@@) 35 فجاءك كلها بالروح فردا ، %~% وقد سرنا به جسدا وروحا(@)(@@) 36 تبوح بفضلك الدنيا لتحظى %~% بذاك ، وأنت تكره أن تبوحا ،(@)(@@) 37 وما للمسك في أن فاح حظ ، %~% ولكن حظنا في أن يفوحا .(@)(@@) 38 وقد بلغ الضراح وساكنيه %~% ثناك ، وزار من سكن الضريحا ،(@)(@@) 39 يفيض إليك غور الماء شوقا ، %~% ويظهر نفسه ، حتى يسيحا(@)(@@) 40 ولو مرت يخيلك هجن خيل %~% وهبن لعجمها نسبا صريحا ، PageV01P291(@)(@@) 41 ولو رفعت سروجك في ظلام %~% على بهم ، جعلن لها وضوحا(@)(@@) 42 ولو سمعت كلامك بزل شول %~% لعاد هدير بازلها فحيحا .(@)(@@) 43 وقد شرفتني ورفعت إسمي %~% به 
ms49	 ، وأنلتني الحظ الربيحا .(@)(@@) 44 أجل ولو أن علم الغيب عندي %~% لقلت : أفدتني أجلا فسيحا ،(@)(@@) 45 وكون جوابه في الوزن ذنب %~% ولكن لم تزل مولى صفوحا(@)(@@) 46 وذلك أن شعرك طال شعري ، %~% فما نلت النسيب ، ولا المديحا(@)(@@) 47 ومن لم يستطع أعلام رضوى %~% لينزل بعضها ، نزل السفوحا(@)(@@) 48 شققت البحر من أدب وفهم %~% وغرق فكرك الفكر الطموحا(@)(@@) 49 لعبت بسحرنا والشعر سحر ، %~% فتبنا منه توبتنا النصوحا ،(@)(@@) 50 فلو صح التناسخ كنت موسى ، %~% وكان ابوك إسحاق الذبيحا ، PageV01P292(@)(@@) 51 ويوشع رد يوحى بعض يوم ، %~% وأنت متى سفرت رددت يوحى(@)(@@) 52 فنال محبك الدارين فوزا ، %~% وذاق عدوك الموت المريحا ،(@)(@@) 53 ومن لم يأت دارك مستفيدا %~% أتاها ، في عفاتك ، مستميحا(@)(@@) 54 فكن في الملك ، يا خير البرايا ، %~% سليمانا ، وكن في العمر نوحا(@)PageV01P293(@)(@@) البحر : وافر تام(@)(@@) 1 أفوق البدر يوضع لي مهاد %~% أم الجوزاء تحت يدي وساد ؟(@)(@@) 2 قنعت فخلت أن البدر دوني ، %~% وسيان التقنع والجهاد ،(@)(@@) 3 وأطربني الشباب غداة ولي ، %~% فليت سنيه صوت يستعاد(@)(@@) 4 وليس صبا يفاد ، وراء شيب ، %~% بأعوز من أخي ثقة يفاد .(@)(@@) 5 كأني حيث ينشا الدجن تحتي %~% فها أنا لا أطل ولا أجاد ،(@)(@@) 6 رويدك ، ايها العاوي ورائي ، %~% لتخبرني ، متى نطق الجماد ؟(@)(@@) 7 سفاه ذاد عنك الناس حلم %~% وغي فيه منفعة رشاد .(@)(@@) 8 أأحمل ، والنباهة في لفظ ، %~% وأقتر ، والقناعة لي عتاد(@)(@@) 9 وألقى الموت ، لم تخد المطايا %~% بجاجاتي ، ولم تجف الجياد ؟(@)(@@) 10 ولو قيل : اسألوا شرفا ! لقلنا : %~% يعيش لنا الأمير ، ولا نزاد PageV01P294(@)(@@) 11 شكا ، فتشكت الدنيا ، ومادت ، %~% باهليها الغوائر والنجاد ،(@)(@@) 12 وأرعدت القنا ، زمعا وخوفا ، %~% لذلك ، والمهندة الحداد(@)(@@) 13 وكيف يقر قلب في ضلوع %~% وقد رجفت لعلته البلاد ؟(@)(@@) 14 بنى ، من جوهر العلياء ، بيتا ، %~% كأن النيرات له عماد(@)(@@) 15 إذا شمس الضحى نظرت إليه ، %~% أقرت أن حلتها حداد(@)(@@) 16 فلولا الله ، قال الناس : أضحت %~% ثمانية به السبع الشداد(@)(@@) 17 أغر ، نمته من غسان غر ؛ %~% تدين لعزهم إرم وعاد(@)(@@) 18 كأبواب الأراقم ، مزقتها ، %~% إلى الروم اللجاجة والعناد ،(@)(@@) 19 أرادت أن تقيدهم قريش 
ms50	 ، %~% وكانوا ، لا ينال لهم قياد(@)(@@) 20 أقائدها تغص الجو نقعا %~% وفوق الأرض ، من علق ، جساد PageV01P295(@)(@@) 21 وقد أدمت هواديها العوالي ، %~% وأنضبها التطاول والطراد ،(@)(@@) 22 مقلدة بهامات الأعادي ، %~% كما بالدر قلدت الخراد(@)(@@) 23 عليها اللابسون ، لكل هيج ، %~% برودا ، غمض لابسها سهاد(@)(@@) 24 كأثواب الأراقم مزقتها %~% فخطاتها بأعينها الجراد ،(@)(@@) 25 اليك طوى المفاوز كل ركب %~% سما بهم التغرب والبعاد(@)(@@) 26 وإصباح ، فلينا الليل عنه ، %~% كما يفلى ، عن النار ، الرماد(@)(@@) 27 أبل به الدجا من كل سقم %~% وكوكبه مريض ما يعاد ،(@)(@@) 28 ولو طلع الصباح ، لفك عنه %~% من الظلماء ، غل أو صفاد .(@)(@@) 29 تلوذ بنا القطا ، مستجديات ، %~% لما ضمنت من الماء المزاد ،(@)(@@) 30 يكدن يردن من حدق المطايا %~% موادر ، ماؤها ، أبدا ، ثماد PageV01P296(@)(@@) 31 فكم جاوزن من بلد بعيد ، %~% وسائر نطقنا هيد وهاد ،(@)(@@) 32 ومن غلل تحيد الريح عنه %~% مخافة أن يمزقها القتاد ،(@)(@@) 33 وكن يرين نار الزند فيه %~% فلم يبصرن إذا ورت الزناد ،(@)(@@) 34 لو أن بياض عين المرء صبح %~% هنالك ، ما أضاء به السواد(@)(@@) 35 وأرض بت أقري الوحش زادي %~% بها ليثوب لي منهن زاد ،(@)(@@) 36 فأطعمها ، لأجعلها طعامي ؛ %~% ورب قطيعة جلب الوداد(@)(@@) 37 تركت بها الرقاد وزرت أرضا %~% يحاذر أن يلم بها الرقاد(@)(@@) 38 رأيتك ساخطا ما جاء عفوا ، %~% ولو جادتك بالذهب العهاد(@)(@@) 39 فما تعتد مالا ، غير مال %~% حباك به طعان ، أو جلاد(@)(@@) 40 وتنفد كل وفر حزت قسرا ، %~% لعلمك أن آخره نفاد . PageV01P297(@)(@@) 41 ألفت الحرب ، حتى قال قوم : %~% أما لصلاح بينكما فساد ؟(@)(@@) 42 تموت الدرع دونك حنف أنف %~% ويبلى فوق عاتقك النجاد .(@)(@@) 43 ركبت العاصفات فما تجارى ، %~% وسدت العالمين فما تساد(@)(@@) 44 متى أرم السهى لك أنتظمه ، %~% كأن هواك في سهمي سداد ،(@)(@@) 45 تذود علاك شراد المعاني %~% إلي ، فمن زهير أو زياد ؟(@)(@@) 46 إذا ما صدتها ، قالت رجال : %~% ألم تكن الكواكب لا تصاد ؟(@)(@@) 47 من اللاتي أمد بهن طبع ، %~% وهذبهن فكر وانتقاد(@)(@@) 48 ولولا فرط حبك ما ازدهاني ، %~% إلى المدح ، الطريف ولا التلاد .(@)(@@) 49 توري عنك ألسنة الليالي ، %~% كانك 
ms51	 في ضمائرها اعتقاد .(@)(@@) 50 فإن يكن الزمان يريد معنى ، %~% فإنك ذلك المعنى المراد ، PageV01P298(@)(@@) 51 يكاد محين ، لاقى المنايا %~% بسيفك لا يكون له معاد .(@)PageV01P299(@)(@@) البحر : كامل تام(@)(@@) 1 أدنى الفوارس من يغير لمغنم ، %~% فاجعل مغارك للمكارم تكرم ،(@)(@@) 2 وتوق أمر الغانيات ، فإنه %~% أمر ، إذا خالفته لم تندم(@)(@@) 3 أنا أقدم الخلان ، فارض نصيحتي ؛ %~% إن الفضيلة للحسام الأقدم(@)(@@) 4 والحق بتباع الأمير ، فكن له %~% تبعا ، لتصبح بالمحل الأعظم ،(@)(@@) 5 واستزر بالبيض الحسانن ولا يكن %~% لك غير همة صارم أو لهذمس ،(@)(@@) 6 المتقي ، بالخيل ، كل عظيمة ، %~% والمستبيح بهن كل عرمرم ،(@)(@@) 7 ومزيرها الغور ، الذي لو سلمت %~% ريح على أرجائها ، لم تسلم ،(@)(@@) 8 أو بكر الوسمي يطلب أرضه %~% نفد الربيع ، وتربها لم يوسم(@)(@@) 9 لا تستبين الشهب فيه ، تنائيا ، %~% ويلوح فيه البدر مثل الدرهم(@)(@@) 10 هذا ، وكم جبل عصاها أهله ، %~% فهوت عليه مع الطيور الحوم ، PageV01P300(@)(@@) 11 واجازها قاذفات كل منيفة %~% وكر العقاب بها وبيت الأعصم(@)(@@) 12 فوطئن أوكار الأنوق ، وروعت %~% منها ، وبات المهر ضيف الهيثم(@)(@@) 13 علمت ، واضعفها الحذار ، ولم تطر %~% من ضعفها ، فكأنها لم تعلم(@)(@@) 14 وبعيدة الأطراف رعن بماجد %~% يردين فوق أساود لم تطعم ،(@)(@@) 15 ترعى خوافي الربد في حجراتها ، %~% سغبا ، وتعثر بالغطاط النوم(@)(@@) 16 يجمعن أنفسهن كي يبلغن ما %~% يهوى ، فمجفرهن مثل الأهضم ،(@)(@@) 17 ضمرت وشز بها القياد فأصبحت %~% والطرف يركض في مساب الارقم(@)(@@) 18 من كل معطية الأعنة سرجها %~% ترقى فوارسها إليه بسلم(@)(@@) 19 غراء سلهبة ، كأن لجامها %~% نال السماء به بنات الملجم .(@)(@@) 20 ومقابل بين الوجيه ولاحق ، %~% وافاك بين مطهم ومطهم ، PageV01P301(@)(@@) 21 صاغ النهار حجوله ، فكأنما %~% قطعت له الظلماء ثوب الأدهم(@)(@@) 22 قلق السماك لركضه ، ولربما %~% نفض الغبار على جبين المرزم(@)(@@) 23 مثل العرائس ما انثنت من غارة %~% الا مخضبة السنابك بالدمن(@)(@@) 24 سهرت ، وقد هجع الدليل ، بلابس %~% برد الحباب ، معيد فعل الضيغم(@)(@@) 25 أدمت نواجذها الظبى ، فكأنما %~% صبغت شكائمها بمثل العندم ،(@)(@@) 26 وبنت حوافرها قتاما ساطعا ، %~% لولا انقياد عداك لم يتهدم ،(@)(@@) 27 باض النسور به وخيم مصعدا ، %~% حتى 
ms52	 ترعرع فيه فرخ القشعم(@)(@@) 28 وسما إلى حوض الغمام ، فماؤه %~% كدر بمنهال الغبار الأقتم(@)(@@) 29 جاءت بأمثال القداح ، مفيضة ، %~% من كل أشعث ، بالسيوف ، موسم(@)(@@) 30 فوجدن أمضى من سهام الترك ، إذ %~% نفضت ، وأنفد من حراب الديلم PageV01P302(@)(@@) 31 حتى تركن الماء ليس بطاهر ، %~% والترب ليس يحل للمتيمم(@)PageV01P303(@)(@@) البحر : خفيف تام(@)(@@) 1 عللاني ، فإن بيض الأماني %~% فنيت والظلام ليس بفاني(@)(@@) 2 إن تناسيتما وداد أناس ، %~% فاجعلاني من بعض من تذكران(@)(@@) 3 رب ليل ، كأنه الصبح في الحس %~% ن ، وإن كان أسود الطيلسان(@)(@@) 4 قد ركضنا فيه إلى اللهو ، لما %~% وقف النجم وقفة الحيران(@)(@@) 5 كم أردنا ذاك الزمان بمدح %~% فشغلنا بذم هذا الزمان .(@)(@@) 6 ر لما وصفت بالقرآن %~% وشباب الظلماء في عنفوان :(@)(@@) 7 ليلتي هذه عروس من الزن %~% عليها قلائد من جمان ،(@)(@@) 8 هرب النوم عن جفوني فيها ، %~% هرب الأمن عن فؤاد الجبان(@)(@@) 9 وكأن الهلال يهوى الثريا ، %~% فهما للوداع معتنقان .(@)(@@) 10 قال صحبي ، في لجتين من الحن %~% والبيذ إذ بدا الفرقدان : PageV01P304(@)(@@) 11 نحن غرقى ، فكيف ينقذنا نج %~% في حومة الدجى غرقان ؟(@)(@@) 12 وسهيل كوجنة الحب ، في اللو %~% ن ، وقلب المحب في الخفقان(@)(@@) 13 مستبدا ، كأنه الفارس المع %~% لم ، يبدو معارض الفرسان(@)(@@) 14 يسرع اللمح في احمرار كما %~% تسرع في اللمح مقلة الغضبان ،(@)(@@) 15 ضرجته دما سيوف الأعادي ، %~% فبكت رحمة له الشعريان ،(@)(@@) 16 قدماه وراءه وهو في العجز %~% ز ، كساع ، ليست له قدمان(@)(@@) 17 ثم شاب الدجى ، وخاف من الهج %~% فغطى المشيب بالزعفران ،(@)(@@) 18 ونضا فجره على نسره الواقع %~% واقع ، سيفا ، فهم بالطيران(@)(@@) 19 وبلاد وردتها ذنب السر %~% حان ، بين المهاة والسرحان(@)(@@) 20 وعيون الركاب ترمق عينا %~% حولها محجر بلا أجفان PageV01P305(@)(@@) 21 وعلى الدهر ، من دماء الشهيدين %~% ن علي ونجله ، شاهدان(@)(@@) 22 فهما في أواخر الليل فجرا %~% ن ، وفي أولياته شفقان ،(@)(@@) 23 ثبتا في قميصه ليجيء الحشر %~% ر ، مستعديا إلى الرحمن(@)(@@) 24 وجمال الأوان عقب جدود %~% كل جد منهم جمال أوان(@)(@@) 25 يا ابن مستعرض الصفوف ببدر %~% ومبيد الجموع من غطفان ،(@)(@@) 26 
ms53	 أحد الخمسة الذين هم الأغراض %~% راض ، في كل منطق ، والمعاني(@)(@@) 27 والشخوص التي خلقن ضياء %~% قبل خلق المريخ والميزان ،(@)(@@) 28 قبل أن تخلق السموات وتؤ %~% مر أفلاكهن بالدوران ،(@)(@@) 29 لو تأتي لنطحها حمل الشهب %~% تردى عن رأسه السرطان ،(@)(@@) 30 أو أراد السماك طعنا لها ، عا %~% د كسير القناة ، قبل الطعان PageV01P306(@)(@@) 31 أو رمتها قوس الكواكب زال العج %~% س منها ، وخانها الأبهران(@)(@@) 32 أو عصاها حوت النجوم ، سقاه ، %~% حتفه ، صائد من الحدثان(@)(@@) 33 أنت كالشمس في الضياء ، وإن جا %~% وزت كيوان في علو المكان(@)(@@) 34 وافق اسم ابن أحمد اسم رسو %~% رسول الله لما توافق الغرضان(@)(@@) 35 وسجايا محمد أعجزت في الوصف %~% لطف الأفكار والأذهان ،(@)(@@) 36 وجرت ، في الأنام ، أولاده الس %~% جري الأرواح في الأبدان ،(@)(@@) 37 فهم السبعة الطوالع والأصغر ، %~% ب أني سرى بي المرزمان(@)(@@) 38 وبهم فضل المليك بني حوا %~% ء ، حتى سموا على الحيوان(@)(@@) 39 شرفوا بالشراف ، والسمر عيدا %~% ن إذا لم يزن بالخرصان(@)(@@) 40 وإذا الأرض وهي غبراء صارت %~% من دم الطعن وردة كالدهانن PageV01P307(@)(@@) 41 أقبلوا حاملي الجداول في %~% ماد ، مستلئمين بالغدران(@)(@@) 42 يضربون الأقران ضربا يعيد ال %~% السعد نحسا في حكم كل قران ،(@)(@@) 43 وجلوا غمرة الوغى بوجوه ، %~% حسنت ، فهي معدن الإحسان(@)(@@) 44 قد أجبنا قول الشريف بقول %~% وأثبنا الحصى عن المرجان(@)(@@) 45 أطربتنا ألفاظه ، طرب %~% عشاق للمسمعات بالألحان(@)(@@) 46 فاغتبقنا بيضاء كالفضة المحض ، %~% ض ، وعفنا حمراء كالأرجوان(@)(@@) 47 ولو أنا جزنا إلى شربها النهي %~% ي ، عنينا بكل أصهب عان(@)(@@) 48 وهجرنا شرب الكؤوس احتقارا ؛ %~% وشربنا مرة بالدنان .(@)(@@) 49 ايها الدر إنما فضت من بحر %~% مخلى الطريق للجريان ،(@)(@@) 50 ما امرء القيس بالمصلي إذا جا %~% راه في الشعر ، بل سكيت الرهان PageV01P308(@)(@@) 51 فاقتنع بالروي والوزن مني ، %~% فهمومي ثقيلة الأوزان ،(@)(@@) 52 من صروف ملكن فكري ونطقي %~% فهي قيد الفؤاد ، قيد اللسان .(@)(@@) 54 أشرب العالمون حبك ، طبعا ، %~% فهو فرض في سائر الأديان ،(@)(@@) 55 بان للمسلمين منك اعتقاد ، %~% ظفروا منه بالهدى والبيان ،(@)(@@) 56 وحدود الإيمان يقبسها من %~% ويمتاحها أولو الإيمان 
ms54	 .(@)(@@) 57 ومحياك ، للذي يعبد الدهر ، %~% وأهباء طرفك ، الفتيان ،(@)(@@) 58 وإله المجوس سيفكن إن لم %~% يرغبوا عن عبادة النيران .(@)(@@) 59 حلبا حجت المطي ، %~% جمت عنها مالت إلى حران(@)(@@) 60 صليت جمرة الهجير ، نهارا ، %~% ثم باتت تغص بالصليان(@)(@@) 62 عش ! فداء لوجهك القمران ، %~% فهما ، في سناه ، مستصغران .(@)PageV01P309(@)(@@) البحر : طويل(@)(@@) 1 يرومك ، والجوزاء دون مرامه ، %~% عدو يعيب البدر عند تمامه .(@)(@@) 2 فإن يك أضحى القول جما طيروه ، %~% فما تستوي عقبانه بحمامه(@)(@@) 3 وإن يك وادينا من الشعر نبته ، %~% فغير خفي أثله من ثمامه(@)(@@) 4 وليس بجار حق شكرك منعم ، %~% ولو جعل الدنيا قضاء ذمامه ،(@)(@@) 5 فلا تلزمني ، من مديحك ، منطقا ، %~% يقصر فكري عن بلوغ التزامه(@)(@@) 6 حللت من العلياء صهوة باذخ ، %~% تود الضواري أنها من بهامه ،(@)(@@) 7 إذا افتخر المسك الذكين فإنما %~% يقول ، ادعاء ، أنه من رغامه ،(@)(@@) 8 إذا ما طريد المعصم وافى حضيضه %~% تبوأ فيه ، واثقا باعتصامه ،(@)(@@) 9 منازل ، لو رد الحمام ، بعزة ، %~% لما ريع من يحتلها من حمامه(@)(@@) 10 إذا أطلقت كفاك عارض عسجد %~% على سائل ، لم ترضيا برهامه PageV01P310(@)(@@) 11 غمامان مبيضان ، منذ براهما %~% لنا الله ، لم نحفل بسود غمامه(@)(@@) 12 كأنك حوض المزن ، طأطا نفسه %~% إلى ورده ، حتى ارتوى من سجامه ،(@)(@@) 13 كأنك در البحر ، اصبح طافيا %~% على الماء ، فاعتأم الورى من تؤامه ،(@)(@@) 14 كأنك ركن البيت ، أعطي قدرة ، %~% فسار إلى زواره لاستلامه(@)(@@) 15 أفدت جزيل المال ، لما استفدته ؛ %~% وحكمت فيه الدهر ، قبل احتكامه(@)(@@) 16 ولو نال ذو القرنين ما نلت من غنى ، %~% بنى السد من ذوب النضار وسامه .(@)(@@) 17 وهل يدخر الضرغام قوتا ليومه %~% إذا ادخر النمل الطعام لعامه ؟(@)(@@) 18 وكم بلد فارقته متلهفا %~% عليك ، غداة البين ، قلب همامه(@)(@@) 19 يكاد نسيم الريح ، من نحو أرضه ، %~% يخبرنا عن وجده وغرامه(@)(@@) 20 جواد يفوت الخيل من بعد ما ونى ، %~% فكيف يجارى بعد طول جمامه ؟ PageV01P311(@)(@@) 21 هزبر ، تظل الأسد ، من غر قومه ، %~% تحف به ، من خلفه وأمامه(@)(@@) 22 بنو الجلبات الباعثون ، من الندى ، %~% سراياه ، والغازون وسط لهامه(@)(@@) 23 وهل يدعي الليل 
ms55	 الدجوجي أنه %~% يضيء ، ضياء الشمس ، شهب ظلامه(@)(@@) 24 وما كان يغني القرن عن حمل سيفه %~% إذا الحرب شبت كثرة من سهامه ،(@)(@@) 25 ولا يدرك العرب الهجين بجله ، %~% ولا حلية في سرجه ولجامه ،(@)(@@) 26 ومن يبل ، من قبل اللقاء ، سيوفه ، %~% يميز ويعرف عضبه من كهامه(@)(@@) 27 ولولا سعيد بات ندمان كوكب %~% يريق له ، في الأرض ، شطر مدامه(@)(@@) 28 وكانت بقايا نعمة عضدية ، %~% ترد إلى الزوراء بعض اهتمامه ،(@)(@@) 29 سرى نحوه ، والصبح ميت ، كأنما %~% يسائل بالوخد الثرى عن رمامه(@)(@@) 30 ونكب ، إلا عن قويق ، كأنه %~% يظن سواه زائدا في أوامه ، PageV01P312(@)(@@) 31 بعيس تجوب الدهر جونا كأنها %~% مفتشة أحشاءه عن كرامه ،(@)(@@) 32 خفاف ، يباهي كل هجل هبطنه %~% بهن ، على العلات ربد نعامه(@)(@@) 33 إذا أرزمت فيه المهاري ، ولم يجب %~% حوار أجابت عنه أصداء هامه ،(@)(@@) 34 ولو وطئت في سيرها جفن نائم %~% باخفافها ، لم ينته من منامه .(@)(@@) 35 وكل وجيهي ، كأن رؤاله %~% تحدر من عطفيه ، فوق حزامه(@)(@@) 36 وأعيس لو وافى به خرت مخيط ، %~% لأنفده ، من ضمره وانضمامه(@)(@@) 37 يراقب ضوء الصبح من كل مطلع %~% ولا ضوء ، إلا ما بدا من لغامه(@)(@@) 38 تذكرن من ماء العواصم شربة ، %~% وزرق العوالي دون زرق جمامه(@)(@@) 39 فلو نطق الماء النمير ، مسلما %~% عليهن ، لم يرددن رجع سلامه(@)(@@) 40 وملتثم بالغلفق الجعد عرست %~% عليه ، فلم تكشف خفي لثامه PageV01P313(@)(@@) 41 وكم بين ريف الشام والكرخ منهلا %~% موارده ممزوجة بسمامه(@)(@@) 42 كأن الصبا فيه تراقب كامنا ، %~% يثور إليها من خلال إكامهن(@)(@@) 43 يمر به رأد الضحى ، متنكرا ، %~% مخافة أن يغتاله بقتامه ،(@)(@@) 44 نهار ، كأن البدر قاسى هجيره ، %~% فعاد بلون شاحب من سهامه(@)(@@) 45 بلاد يضل النجم فيها سبيله ، %~% ويثني دجاها طيفها عن لمامه ،(@)(@@) 46 ولولا احتقار من علي ، بشانه ، %~% عن المرء ما هم الردي باخترامه(@)(@@) 47 رجا الليل فيها أن يدوم شبابه ، %~% فلما رآها شاب قبل احتلامه(@)(@@) 49 تشق عقيلا وهي خزر عيونها ، %~% بكل كمي ، رزقه من حسامه(@)(@@) 50 ولاقى دوين الورد كل مغيب %~% عن الرشد ، يقتاد الخنا بزمامه(@)(@@) 51 
ms56	 أشد الرزايا عنده عقر تابه ، %~% وأبعد شيء ضيفه من طعامه PageV01P314(@)(@@) 52 أخو طمع ، لا ينزل الركب أرضه ، %~% فيرحل الا موقرا من ملامه ،(@)(@@) 53 إذا أعرضت نار الحباحب في الدجى %~% سعى قابسا من نارها بضرامه ،(@)(@@) 54 وإن ضربت أطنابه بتنوفة ، %~% نأي الضب عنها خفية من عرامه ،(@)(@@) 55 إذا هيض عظم البكر ود لو انه %~% من الإعنات بعض عظامه ،(@)(@@) 56 وما نغم الأوتار ، في سمع أذنه ، %~% باحسن صوتأ من رغاء سوامه .(@)(@@) 57 فيا رب ! لا يمرر بدار يحلها ، %~% من المزن ، إلا خاليات جهامه(@)(@@) 58 وإن كان غيث باعده عن بلاده ، %~% وإن كان موت ، فاسقها من زؤامه(@)(@@) 59 ولولا احتنقار ، من علي بشانه ، %~% لسل عليه الذم سيف انتقامه ،(@)(@@) 60 هو الشهد مجته الخطوب مرارة %~% وقد فغرت أفواهها لالتهامه ،(@)(@@) 61 تهاب الأعادي بأسه وهو ساكن %~% كما هيب مس الجمر قبل اضطرامه PageV01P315(@)(@@) 62 ورب جراز يتقى ، وهو مغمد ، %~% ولج تهال النفس دون اقتحامه(@)(@@) 63 إذا ضحكت عجبا به كل بلدة %~% بكى ما له من ظلمه واهتضامه ،(@)(@@) 64 تحفظ منه ، خيفة من رحيله ، %~% وكم مال ملك ضاع تحت ختامه(@)(@@) 65 وذامته أفناء العراق ، وانما %~% ترحله عنهن اكبر ذامه ،(@)(@@) 66 فكان الصبا إذا لم يجد فيه عائب %~% مقالا لخلق عابه بانصرامه(@)(@@) 67 ولو أن بغداد استطاعت لأشبت %~% عليه الثنايا رغبة في مقامه ،(@)(@@) 68 متى يحبس الدجن المطبق بارقا %~% يجبه ويخرج ساطعا من ركامه .(@)(@@) 69 علي لاملاك البلاد نصيحة %~% يقوم بها دو حسبة في قيامه(@)(@@) 70 أخص بها من كل حي عميده ؛ %~% وأصرفها مستكبرا عن طغامه ،(@)(@@) 71 بأن عليا ، كل من فاز بالغنى %~% فقير ، إذا لم يدخر من كلامه PageV01P316(@)(@@) 72 سننت لارباب القريض امتداحه %~% كما سن ابراهيم حج مقامه ،(@)(@@) 73 فيثني عليه ضيغم بزئيره ؛ %~% ويثني عليه شادن ببغامه ،(@)(@@) 74 وهذا لأهل النطق شرعي ومذهبي ، %~% فمن لم يطعني عق أمر إمامه(@)PageV01P317(@)(@@) البحر : طويل(@)(@@) 1 ألا في سبيل المجد ما أنا فاعل %~% عفاف وإقدام وحزم ونائل(@)(@@) 2 أعندي ، وقد مارست كل خفية ، %~% يصدق واش ، أو يخيب سائل ؟(@)(@@) 3 أقل صدودي 
ms57	 أنني لك مبغض ؛ %~% وأيسر هجري أنني عنك راحل(@)(@@) 4 إذا هبت النكباء بيني وبينكم ، %~% فأهون شيء ما تقول العواذل(@)(@@) 5 تعد ذنوبي ، عند قوم ، كثيرة ، %~% ولا ذنب لي إلا العلى والفواضل(@)(@@) 6 كأني ، إذا طلت الزمان وأهله ، %~% رجعت وعندي لأنام طوائل ،(@)(@@) 7 وقد سار ذكري في البلاد فمن لهم %~% باخفاء شمس ضؤها متكامل ؟(@)(@@) 8 يهم اليالي بعض ما أنا مضمر %~% ويثقل رضوى دون ما أنا حامل(@)(@@) 9 وإني ، وإن كنت الأخير زمانه ، %~% لآت بما لم تستطعه الأوائل(@)(@@) 10 وأغدو ، ولو أن الصباح صوارم %~% وأسري ، ولو أن الظلام جحافل PageV01P318(@)(@@) 11 وإني جواد لم يحل لجامه ، %~% ونضو يمان أغفلته الصياقل ،(@)(@@) 12 وإن كان في لبس الفتى شرف له ، %~% فما السيف إلا غمده والحمائل(@)(@@) 13 ولي منطق لم يرض لي كنه منزلي ، %~% على أنني ، بين السماكين ، نازل(@)(@@) 14 لدى موطن يشتاقه كل سيد %~% ويقصر عن إدراكه المتناول(@)(@@) 15 ولما رأيت الجهل ، في الناس ، فاشيا ، %~% تجاهلت ، حتى ظن أني جاهل(@)(@@) 16 فوا عجبا ! كم يدعي الفضل ناقص ؛ %~% ووا أسفا ، كم يظهر النقص فاضل ،(@)(@@) 17 وكيف تنام الطير في وكناتها ، %~% وقد نصبت للفرقدين الحبائل ؟(@)(@@) 18 ينافس يومي في أمسي تشرفا ، %~% وتحسد أسحاري علي الأصائل(@)(@@) 19 وطال اعترافي بالزمان وصرفه ، %~% فلست أبالي من تغول الغوائل(@)(@@) 20 فلو بان عضدي ما تأسف منكبي ، %~% ولو مات زندي ما بكته الأنامل . PageV01P319(@)(@@) 21 إذا وصف الطائي بالبخل ما در %~% وعير قسا ، بالفهاهة ، باقل(@)(@@) 22 وقال السهى للشمس : أنت خفية ؛ %~% وقال الدجى : يا صبح لونك حائل(@)(@@) 23 وطاولت الأرض السماء سفاهة ، %~% وفاخرت الشهب الحصى والجنادل(@)(@@) 24 فيا موت زر ، أن الحياة ذميمة ، %~% ويا نفس جدي ، إن دهرك هازل ،(@)(@@) 25 وقد أعتدي والليل يبكي تأسفا %~% على نفسه ، والنجم في الغرب مائل ،(@)(@@) 26 بريح أعيرت حافرا من زبر جد %~% لها التبر جسم ، واللجين خلاخل ،(@)(@@) 27 كأن الصبا ألقت إلي عنانها ، %~% تخب بسرجي مرة وتناقل(@)(@@) 28 إذا اشتاقت الخيل المناهل أعرضت %~% عن الماء ، فاشتاقت إليها المناهل(@)(@@) 29 وليلان ، حال بالكواكب جوزه ، %~% وآخر من حلي 
ms58	 الكواكب عاطل ،(@)(@@) 30 كأن دجاه الهجر ، والصبح موعد %~% بوصل ، وضوء الفجر حب مماطل ، PageV01P320(@)(@@) 31 قطعت به بحرا يعب عبابه ، %~% وليس له ، إلا التبلج ، ساحل(@)(@@) 32 ويؤنسني ، في قلب كل مخوفة ، %~% حليف سرى لم تصح منه الشمائل ،(@)(@@) 33 من الزنج كهل شاب مفرق رأسه ، %~% وأوثق ، حتى نهضه متثاقل(@)(@@) 34 كأن الثريا ، والصباح يروعها ، %~% أخو سقطة ، أو ظالع متحامل(@)(@@) 35 إذا أنت أعطيت السعادة لم تبل ، %~% وإن نظرت ، شزرا إليك ، القبائل(@)(@@) 36 تقتك ، على أكتاف أبطالها ، القنا ، %~% وهابتك في أغمادهن المناصل ،(@)(@@) 37 وإن سدد الأعداء نحوك أسهما ، %~% نكصن على افواقهن المعابل .(@)(@@) 38 تحامى الرزايا كل خف ومنسم ؛ %~% وتلقى رداهن الذرى والكواهل ،(@)(@@) 39 وترجع أعقاب الرماح سليمة %~% وقد حطمت في الدارعين العوامل(@)(@@) 40 فإن كنت تبغي العز ، فابغ توسطا ، %~% فعند التناهي يقصر المتطاول . PageV01P321(@)(@@) 41 توقى البدور النقص وهي أهلة ، %~% ويدركها النقصان ، وهي كوامل .(@)PageV01P322(@)(@@) البحر : وافر تام(@)(@@) 1 أرى العنقاء ، تكبر أن تصادا ، %~% فعاند من تطيق له عنادا(@)(@@) 2 وما نهنهت عن طلب ، ولكن %~% هي الأيام لا تعطي قيادا .(@)(@@) 3 فلا تلم السوابق والمطايا ، %~% إذا غرض ، من الأغراض ، حادا(@)(@@) 4 لعلك أن تشن بها مغارا ، %~% فتنجح أو تجشمها طرادا(@)(@@) 5 مقارعة أحجتها العوالي ، %~% مجنبة نواظرها الرقادا ،(@)(@@) 6 نلوم على تبلدها قلوبا %~% تكابد من معيشتها جهادا .(@)(@@) 7 إذا ما النار لم تطعم ضراما %~% فأوشك أن تمر بها رمادا ،(@)(@@) 8 فظن بسائر الإخوان شرا %~% ولا تأمن على سر فؤادا ،(@)(@@) 9 فلو خبرتهم الجوزاء خبري %~% لما طلعت ، مخافة أن تكادا(@)(@@) 10 تجنبت الانام فلا أواخى ، %~% وزدت عن العدو ، فما أعادى PageV01P323(@)(@@) 11 ولما أن تجهمني مرادي %~% جريت مع الزمان ، كما أرادا(@)(@@) 12 وهونت الخطوب علي حتى %~% كأني صرت أمنحها الودادا(@)(@@) 13 أأنكرها ، ومنبتها فؤادي ، %~% وكيف تناكر الأرض القتادا ؟(@)(@@) 14 ولو ملأ السهى عينيه مني %~% أبر على مدى زحل وزادا(@)(@@) 15 أفل نوائب الأيام ، وحدي ، %~% إذا جمعت كتائبها احتشادا(@)(@@) 16 وقد أثبت رجلي في ركاب %~% جعلت من الزماع له بدادا ،(@)(@@) 17 إذا أوطأتها قدمي سهيل %~% فلا سقيت خناصرة العهادا 
ms59	 .(@)(@@) 18 كأن ظماءهن بنات نعش ، %~% يردن إذا وردنا بنا الثمادا ،(@)(@@) 19 ستعجب من تغشمرها ليال %~% تبارينا كوكبها سهادا ،(@)(@@) 20 كأن فجاجها فقدت حبيبا ، %~% فصيرت الظلام لها حدادا PageV01P324(@)(@@) 21 وقد كتب الضريب بها سطورا %~% فخلت الأرض لابسة بجادا .(@)(@@) 22 كأن الزبرقان بها أسير %~% تجنب لا يفك ولا يفادى ،(@)(@@) 23 وبعض الظاعنين كقرن شمس ، %~% يغيب ، فإن أضاء الفجر عادا(@)(@@) 24 ولكني الشباب إذا تولى ، %~% فجهل إن تروم له ارتدادا ،(@)(@@) 25 وأحسب أن قلبي لو عصاني ، %~% فعاود ، ما وجدت له افتقادا .(@)(@@) 26 تذكرت البداوة في أناس ، %~% تخال ربيعهم سنة جمادا(@)(@@) 27 يصيدون الفوارس كل يوم ، %~% كما تتصيد الأسد النقادا ،(@)(@@) 28 فأي الناس أجعله صديقا ؛ %~% واي الأرض أسلكه ارتيادا ؟(@)(@@) 29 ولو أن النجوم لدي مال ، %~% نفت كفاي أكثرها انتقادا .(@)(@@) 30 كأني ، في لسان الدهر ، لفظ ، %~% تضمن منه أغراضا بعادا PageV01P325(@)(@@) 31 يكررني ليفهمني رجال ، %~% كما كررت معنى مستعادا .(@)(@@) 32 ولو أني حبيب الخلد فردا %~% لما أحببت بالخلد انفرادا(@)(@@) 33 فلا هطلت علي ، ولا بأرضي ، %~% سحائب ليس تنتظم البلادا .(@)(@@) 34 وكم من طالب أمدي سيلقى ، %~% دوين مكاني السبع الشدادا ،(@)(@@) 35 يؤجج في شعاع الشمس نارا %~% ويقدح في تلهبها زنادا ،(@)(@@) 36 ويطعن في علاي ، وإن شسعي %~% ليأنف أن يكون له نجادا(@)(@@) 37 ويظهر لي مودته ، مقالا ؛ %~% ويبغضني ضميرا واعتقادا ،(@)(@@) 38 فلا ، وأبيك ، ما أخشى انتفاضا ، %~% ولا وأبيك ، ما أرجو ازديادا(@)(@@) 39 لي الشرف الذي يطأ الثريا %~% مع الفضل الذي بهر العبادا(@)(@@) 40 وكم عين تؤمل أن تراني ، %~% وتفقد عند رؤيتي السوادا PageV01P326(@)(@@) 55 طلعت عليهم واليوم طفل %~% كأن على مشارقه جسادا ،(@)(@@) 56 إذا نزل الضيوف ولم يريحوا %~% كرام سوامهم ، عقروا الجيادا .(@)(@@) 57 بناة الشعر ما أكفوا رويا ، %~% ولا عرفوا الإجازة والسنادا ،(@)(@@) 58 عهدت لأحسن الحيين وجها ، %~% وأوهبهم طريفا ، أو تلادا(@)(@@) 59 وأطولهم ، إذا ركبوا ، قناة ، %~% وأرفعهم ، إذا نزلوا ، عمادا(@)(@@) 60 فتى يهب اللجين المحض جودا ، %~% ويدخر الحديد له عتادا ،(@)(@@) 61 ويلبس ، من جلود عداه سبتا ، %~% ويرفع من رؤوسهم النضادا ،(@)(@@) 62 أبن الغزو مكتهلا وبدرا %~% وعود أن يسود ، ولا 
ms60	 يسادا(@)(@@) 63 جهول بالمناسك ، ليس يدري : %~% أيا بات يفعل ، أم رشادا .(@)(@@) 64 طموح السيف ، لا يخشى إلها ، %~% ولا يرجو القيامة والمعادا PageV01P327(@)(@@) 65 ويغبق أهله لبن الصفايا ، %~% ويمنح قوت مهجته الجوادا(@)(@@) 66 يذود سخاؤه الاذواد عنه %~% ويحسن ، عن حرائبه ، الذيادا(@)(@@) 67 يرد بترسه النكباء عني ، %~% ويجعل درعه ، تحتي ، مهادا(@)(@@) 68 فبت ، وإنما ألقى خيالا ، %~% كمن يلقى الأسنة والصعادا .(@)(@@) 69 أطلس مخلق السربال يبغى %~% نوافلنا صلاحا أو فسادا ،(@)(@@) 70 كأني ، إذ نبذت له عصاما ، %~% وهبت له المطية والمزادا(@)(@@) 71 وبالي الجسم كالذكر اليماني ، %~% أفل به اليمانية الحدادا ،(@)(@@) 72 طرحت له الوضين ، فخلت أني %~% طرحت له الحشية والوسادا(@)(@@) 73 ولي نفس تحل بي الروابي %~% وتأبى أن تحل بي الوهادا ،(@)(@@) 74 تمد لتقبض القمرين كفا ، %~% وتحمل كي تبذ النجم زادا(@)PageV01P328(@)(@@) البحر : طويل(@)(@@) 1 لقد آن آن يثني الجموح لجام %~% وأن يملك الصعب الأبي زمام ،(@)(@@) 2 أيوعدنا بالروم ناس ، وإنما %~% هم النبت والبعض الرقاق سوام ؟(@)(@@) 3 كأن لم يكن ، بين المخاض وحارم ، %~% كتائب يشجين الفلا وخيام !(@)(@@) 4 ولم يجلبوها من وراء ملطية ، %~% تصدع أجبال بها وإكام(@)(@@) 5 كتائب من شرق وغرب تألبت %~% فرادى ، أتاها الموت ، وهي تؤام(@)(@@) 6 غرائب در جمعت ثم ضيعت ، %~% وقد ضم سلك شملها ونظام ،(@)(@@) 7 بيوم ، كأن الشمس فيه خريدة ، %~% عليها ، من النقع الأحم ، لثام(@)(@@) 8 كأنهم سكرى أريق عليهم %~% بقايا كؤوس ، ملؤهن مدام(@)(@@) 9 فأضحوا حديثا كالمنام ، وما انقضى %~% فسيان منه يقظة ومنام(@)(@@) 10 محل بارض الشام يطرد أهله ، %~% ولكنهم ، عما يقول نيام PageV01P329(@)(@@) 11 وقد تنطق الأشياء ، وهي صوامت ، %~% وما كل نطق المخبرين كلام(@)(@@) 12 كفى بخضاب المشرفية مخبرا : %~% بأن رؤوسا قد شقين ، وهام(@)(@@) 13 فإن قعدت عنه الحوادث حقبة %~% فها هي ، فيما لا تشاء ، قيام(@)(@@) 14 مضى زمن ، والعز بان رواقه %~% عليه ، وسيف الدهر عنه كهام ،(@)(@@) 15 وما الدهر إلا دولة ثم صولة ، %~% وما العيش إلا صحة وسقام .(@)(@@) 16 زمان قروا بالمشر في ضيوفهم %~% مآلك قوم ، والكماة صيام ،(@)(@@) 17 ولو دامت الدولات كانوا ، كغيرهم ، %~% وإن كان فيه نخوة وعرام 