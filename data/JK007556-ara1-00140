ms121	 مرىء مسلم ؟ % PageV01P499 البحر : مديد تام 1(@)(@@) % رث حبل الوصل ، و نصرما ، % من حبيب هاج لي سقما % % 2(@)(@@) % كدت أقضي ، إذ رأيت له % منزلا ب لخيف قد طسما % % 3(@)(@@) % لا ترى إلا الرماد به ، % ومغاني القدر ، والحمما % % 4(@)(@@) % ومخط النؤي ، مر به % % مدفع للسيل ، ف نهدما % % PageV01P500 البحر : كامل تام 1(@)(@@) % ما بال قلبك لا يزال يهيجه % % ذكر ، عواقب غيهن سقام % 2(@)(@@) % ذكر التي طرقتك بين ركائب ، % تمشي بمزهرها ، وأنت حرام % 3(@)(@@) % أتريد قتلك ، أم جزاء مودة ؟ % إن الرفيق له عليك ذمام % % 4(@)(@@) % قد ساقني قدر وحين غالب % منها ، وصرف منية ، وحمام % 5(@)(@@) % قد كنت أغنى في السفاهة والصبا ، % عجبا لما تأتي به الأيام ! % 6(@)(@@) % والآن أعذرها ، وأعلم إنما % % سبل الضلالة والهدى أقسام % % 7(@)(@@) % إن تعد داركم ، أزرك ، وإن أمت ، % فعليك مني رحمة وسلام ! % PageV01P501 البحر : رجز تام 1(@)(@@) % يا ذا الذي في الحب يلحى ، أما % % تخشى عقاب لله فينا ، أما % % 2(@)(@@) % تعلم أن الحب داء ، أما % % و لله ، لو حملت منه كما % % 3(@)(@@) % حملت ، من حب رخيم ، لما % % لمت على الحب فدعني وما % % 4(@)(@@) % أطلب ، إني لست أدري بما % % قتلت إلا أنني بينما % % 5(@)(@@) % أنا بباب القصر ، في بعض ما % % أطلب في قصرهم ، إذ رمى % % 6(@)(@@) % شبه غزال بسهام فما % % أخطأ سهماه ، ولكنما % % 7(@)(@@) % عيناه سهمان له ، كلما % % أراد قتلي بهما ، سلما % % PageV01P502 البحر : مجزوء الخفيف 1(@)(@@) % صاح ، قد لمت ظالما ، % ف نظر إن كنت لائما % % 2(@)(@@) % هل ترى مثل ظبية % قلدوها التمائما ؟ % PageV01P503 البحر : خفيف تام 1(@)(@@) % إن طيف الخيال حين ألما % % هاج لي ذكرة وأحدث هما % % 2(@)(@@) % جددي الوصل يا سكين ، وجودي % % لمحب فراقه قد أحما % % 3(@)(@@) % إن تنيلي ، أعش بخير ، وإن لم % % تبذلي الود ، مت بالهم غما % % 4(@)(@@) % ليس دون الحياة والموت إلا % % أحسن اليوم صورة ، وأتما ؟ % 5(@)(@@) % ولقد قلت ، مخفيا ، لغريض % هل ترى ذلك الغزال الأجما ؟ % PageV01P504 البحر : خفيف تام 1(@)(@@) % ثم نبهتها ، فمدت كعابا % طفلة ، ما تبين رجع الكلام % 2(@)(@@) % ساعة ، ثم إنها لي قالت : % ويلتا قد عجلت يا ابن 
ms122	 الكرام ! % PageV01P505 البحر : خفيف تام 1(@)(@@) % من رسولي إلى الثريا ، فإني % % ضافني الهم ، و عترتني الغموم % 2(@)(@@) % يعلم الله أنني مستهام % بهواكم ، وأنني مرحوم % PageV01P506 البحر : كامل تام 1(@)(@@) % حسروا الوجوه بأذرع ومعاصم ، % ورنوا بنجل للقلوب كوالم % 2(@)(@@) % حسروا الأكمة عن سواعد فضة ، % فكأنما انتصبت متون صوارم % % PageV01P507 البحر : كامل تام 1(@)(@@) % يا راكبا نحو المدينة جسرة يا راكبا نحو المدينة جسرة % أجدا ، تلاعب حلقة وزماما % % 2(@)(@@) % إقرأ على أهل البقيع ، من امرىء % كمد ، على أهل البقيع ، سلاما ! % 3(@)(@@) % كم غيبوا فيه كريما ماجدا % شهما ، ومقتبل الشباب غلاما % % 4(@)(@@) % ونفيسة في أهلها ، مرجوة ، % جمعت صاحبة صورة وتماما % % PageV01P508 البحر : مجزوء الخفيف 1(@)(@@) % نام صحبي ، ولم انم ، % من خيال بنا ألم % 2(@)(@@) % طاف بالركب موهنا ، % بين خاخ إلى إضم % 3(@)(@@) % ثم نبهت صاحبا % طيب الخيم والشيم % 4(@)(@@) % أريحيا ، مساعدا ، % غير نكس ، ولا برم % 5(@)(@@) % قلت : يا عمرو شفني % % لاعج الحب والألم % 6(@)(@@) % إئت هندا ، فقل لها : % ليلة الخيف ذي سلم % PageV01P509 البحر : طويل 1(@)(@@) % أشارت إلينا بالبنان تحية ، % فرد عليها مثل ذاك بنان % 2(@)(@@) % فقالت ، واهل الخيف قد حان منهم % خفوف ، وما يبدي المقال لسان % 3(@)(@@) % نوى غربة ، قد كنت أيقنت أنها ، % وجدك ، فيها عن نواك شطان % % 4(@)(@@) % تعال ، فزرنا زورة قبل بيننا ، % فقد غاب عنا من نخاف جبان % 5(@)(@@) % فقلت لها : خير اللقاء ببلدة % من الأرض ، لا يخشى بها الحدثان % % PageV01P510 البحر : طويل 1(@)(@@) % طربت وهاجتك المنازل من جفن ، % ألا ربما يعتادك الشوق بالحزن % 2(@)(@@) % مررت على أطلال زينب بعدها ، % فأعولتها ، لو كان إعوالها يغني % % 3(@)(@@) % وقد أرسلت ، في السر ، أن قد فضحتني ، % وقد بحت ب سمي في النسيب ، ولم تكن % 4(@)(@@) % فسرفني أهلي وجل عشيرتي ، % فإن كان يهنيك الذي جئت ، فليهن % % 5(@)(@@) % أضعت الذي قد كان في السر بيننا ، % وسرك عندي كان في أحصن الحصن % PageV01P511 البحر : طويل 1(@)(@@) % لقد عرضت لي بالمحصب من منى ، % مع الحج ، شمس سترت بيمان % 2(@)(@@) % بدا لي منها معصم يوم جمرت % وكف خضيب زينت ببنان % 3(@)(@@) % فلما لتقينا ب لثنية 
ms123	 سلمت % ونازعني البغل اللعين عناني % % 4(@)(@@) % فوالله ما ادري ، وإني لحاسب ، % بسبع رميت الجمر أم بثمان % % 5(@)(@@) % فقلت لها : عوجي ، فقد كان منزلي % % خصيب ، لكم ناء عن الحدثان % % 6(@)(@@) % فعجنا ، فعاجت ساعة ، فتكلمت % فظلت لها العينان تبتدران % PageV01P512 البحر : كامل تام 1(@)(@@) % يا رب ، إنك قد علمت بأنها % % أهوى عبادك كلهم إنسانا % % 2(@)(@@) % وألذهم نعم إلينا واحدا ، % واحب من نأتي ، ومن حيانا % % 3(@)(@@) % فآجز المحب تحية ، و جز الذي % % يبغي قطيعة حبه هجرانا % % 4(@)(@@) % آمين يا ذا العرش فاسمع واستجب % لما نقول ، ولا تخيب دعانا % % 5(@)(@@) % حملت من حبيك ثقلا فادحا ، % والحب يحدث للفتى أحزانا % % 6(@)(@@) % لو تبذلين لنا دلالك لم نرد % غير الدلال ، وكان ذاك كفانا % % 7(@)(@@) % وأطعت في عواذلا حملنكم ، % وعصيت فيك الأهل والإخوانا % % 8(@)(@@) % أنبئت أنك ، إذا أتاك كتابنا ، % وأشعت عند قراته عصيانا % % 9(@)(@@) % ونبذته كالعود ، حين رأيته ، % فاشتد ذاك علي منك ، وسانا % % 10(@)(@@) % وأخذته بعد الصدود تكرها ، % وأشعث عند قراته عصيانا % % PageV01P513 11(@)(@@) % قالت : لقد كذب الرسول فقدته ! % أبقول زور يرتجي إحسانا ؟ % 12(@)(@@) % كذب الرسول فسل معادة ، هكذا % % كان الحديث ، ولا تكن عجلانا % % 13(@)(@@) % بل جاءني ، فقرأته متهللا % وجهي وبعد تهلل أبكانا % % 14(@)(@@) % قد قلت ، حيت رأيته : لو أنه % % يا بشر منه سوى نصيرة جانا % % 15(@)(@@) % أرسلت أكذب من مشى وأنمه ، % من ليس يكتم سرنا أعدانا % % 16(@)(@@) % ما إن ظلمت بما فعلت ، وإنما % % يجزي العطية من أراب وخانا % % 17(@)(@@) % وصرمت حبلك إذ صرمت لأنني % % اخبرت أنك قد هويت سوانا % % 18(@)(@@) % هذا ، وذنب قبل ذاك جنيته % سل الفؤاد ، ومثله سلانا % % 19(@)(@@) % صرحت فيه ، وما كتمت مجاهرا % بالقول أنك لا تريد لقانا % % 20(@)(@@) % قلت : اسمعي لا تعجلي بقطيعة ، % بالله ، احلف صادقا أيمانا % % PageV01P514 21(@)(@@) % إن لمبلغك الحديث لكاذب % يسعى ليقطع بيننا الأقرانا % % 22(@)(@@) % لا تجمعي صرمي وهجري باطلا ، % وتفهمي ، واستيقني استيقانا % % 23(@)(@@) % إني لمن واددته ووصلته % ألفيت لا مذقا ، ولا منانا % % 24(@)(@@) % أصل الصديق ، إذا أراد وصالنا ، % وأصد مثل صدوده أحيانا % % 25(@)(@@) % إن صد عني كنت أكرم معرض ، % ووجدت عنه مرحلا 
ms124	 ومكانا % % 26(@)(@@) % لا مفشيا ، عند القطيعة ، سره % بل حافظ من ذاك ما استرعانا % % PageV01P515 البحر : كامل تام 1(@)(@@) % ألمم بجور في الصفاح حسان ، % هيجن منك روائع الأحزان % 2(@)(@@) % بيض أوانس قد أصبن مقاتلي ، % يشبهن تلع شوادن الغزلان % % 3(@)(@@) % واذكر لهن جوى بنفسك داخلا ، % قد هاض عظمي حره ، وبراني % % 4(@)(@@) % فكأن قلبك يوم جئت مودعا % بدلالهن ، وربما أضناني % % 5(@)(@@) % وكلفت منهن الغداة بغادة % مجدولة ، جدلت كجدل عنان % 6(@)(@@) % ثقلت عجيزتها فراث قيامها ، % ومشت كمشي الشارب النشوان % 7(@)(@@) % نظرت إليك بمقلتي يعفورة % نظر الربيب الشادن الوسنان % % 8(@)(@@) % ولها محل طيب تقرو به % % بقل التلاع بحافتي عمان % 9(@)(@@) % يا قلب ما لك لا تزال موكلا ، % تهذي بهند عند حين أوان % 10(@)(@@) % ما غن أشدت بذكرها ، لكنه % غلب العزاء ، وبحت ب لكتمان % PageV01P516 11(@)(@@) % لو كنت ، إذ أدنفت من كلف بها % % يوما ، أصبت حديثها ، لشفاني % % 12(@)(@@) % وكأن كافورا ومسكا خالصا % عبقا بها بالجيب والأردان % % 13(@)(@@) % وجلت بشيرة سنة مشهورة % دون الأراك ، وراهن الحوذان % % 14(@)(@@) % شبهتها ، من حسنها ، شمس الضحى % % وهي القتول ، ودمية الرهبان % % PageV01P517 البحر : كامل تام 1(@)(@@) % ذكر البلاط ، وكل ساكن قرية % بعد الهدوء تهيجه أوطانه % 2(@)(@@) % ثم لتقينا ب لمحصب غدوة ، ، % والقلب يخلجه لها أشطانه % % 3(@)(@@) % قالت لأتراب لها شبه الدمى % % قد غاب عن عمر الغداة بيانه % % 4(@)(@@) % ما لي أراه لا يسدد حجة % حتى يسددها له أعوانه % 5(@)(@@) % مثل الذي أبصرت يوم لقيتها % % عي الخطيب به ، وكل لسانه % % 6(@)(@@) % أسعرت نفسك حب هند فالهوى % % حتى تلبس فوقه أكفانه % % 7(@)(@@) % هند ، وهند لا تزال بخيلة ، % والقلب يسعره لها أشجانه % % PageV01P518 البحر : خفيف تام 1(@)(@@) % صاح ، غن الملام ، في حب جمل ، % كاد يقصي الغداة منك مكاني % % 2(@)(@@) % ف نظر اليوم بعض من كنت تهوى % % ف نج من شأنه ، ودعني وشاني % % 3(@)(@@) % فبحسبي أني بذكرة هند % هائم العقل ، دائم الأحزان % 4(@)(@@) % وإذا جئتها ، لأشكو إليها % % بعض ما شفني ، وما قد شجاني % % 5(@)(@@) % هبتها ، وازدهي من الحب عقلي ، % وعصاني بذات نفسي لساني % % 6(@)(@@) % ونسيت الذي جمعت من القول % لديها 
ms125	 ، وغاب عني بياني % % PageV01P519 البحر : هزج 1(@)(@@) % ألا حي التي قامت % على خوف ، تحيينا % % 2(@)(@@) % ففاضت عبرة منها ، % فكاد الدمع يبكينا % % 3(@)(@@) % لئن شطت بها دار % عنوج ب لهوى حينا % % 4(@)(@@) % لقد كنا نؤاتيها ، % وقد كانت تؤاتينا % % 5(@)(@@) % فلا قرب لها يشفي % % وليس البعد يسلينا % % 6(@)(@@) % وقد قالت لتربيها ، % ورجع القول يعنينا % % 7(@)(@@) % ألا يا ليت ما شعري % % وما قد كان يمنينا % % 8(@)(@@) % أموف بالذي قال ، % وما قد كان يعطينا ؟ % 9(@)(@@) % فقالت تربها ظني % % به ان سوف يجزينا % % 10(@)(@@) % ويعصي قول من ينهى % % ومن يعذله فينا % % PageV01P520 11(@)(@@) % كما نعصي إليه ، عن % % د جد القول ، ناهينا % % PageV01P521 البحر : خفيف تام 1(@)(@@) % ثم ما نمت بعدكم من منام ، من لقلب أمسى حزينا معنى % % مستكينا ، قد شفه ما اجنا % % 2(@)(@@) % إثر شخص ، نفسي فدت ذاك شخصا ، % نازح الدار بالمدينة عنا % % 3(@)(@@) % أن أراه ، والله يعلم ، يوما ، % منتهى رغبتي ، وما أتمنى % % 4(@)(@@) % ليت حظي كطرفة العين منها ، % وكثير منها القليل المهنا % % 5(@)(@@) % أو حديث على خلاء يسلي % % ما اجن الضمير منها ومنا % % 6(@)(@@) % أنرى نعمة ، نراها علينا % % منك يوما ، قبل الممات ، ومنا % % 7(@)(@@) % خبرينا بما كتبت إلينا ، % أهو الحق ، أم تهزأت منا ؟ % 8(@)(@@) % ما نرى راكبا يخبر عنكم ، % أو يريد الحجاز إلا حزنا % % 9(@)(@@) % ثم ما نمت بعدكم من منام ، % منذ فارقت أرضكم مطمئنا % % 10(@)(@@) % ثم ما تذكرين للقلب ، إلا % % زيد شوقا إليكم ، و ستجنا % % PageV01P522 11(@)(@@) % ذاك أني ذكرت قيلك يوما % يا صفي الفؤاد لا تنسينا % % PageV01P523 البحر : رمل تام 1(@)(@@) % وغضيض الطرف مكسال الضحى % % أحورش المقلة ، كالريم الأغن % 2(@)(@@) % مر بي في نفر يحففنه % مثلما حف النصارى بالوثن % 3(@)(@@) % راعني منظره ، لما بدا ، % ربما أرتاع ب لشيء الحسن % 4(@)(@@) % قلت : من هذا ؟ فقالت : بعض من % فتن الله بكم ، فيمن فتن % % 5(@)(@@) % بعض من كان أسيرا زمنا ، % ثم أضحى لهواكم قد مجن % % 6(@)(@@) % قلت : حقا ذا ؟ فقالت قولة ، % أورثت في القلب هما وشجن % 7(@)(@@) % يشهد الله على حبي لكم ، % ودموعي شاهد لي ، وحزن % % 8(@)(@@) % قلت : يا سيدتي 
ms126	 ، عذبتني ! % قالت : اللهم عذبني إذن % PageV01P524 البحر : وافر تام 1(@)(@@) % أجد غدا لبينهم القطين % وفاتتنا بهم دار شطون % % 2(@)(@@) % تبعتهم بطرف العين ، حتى % % أتى من دونهم خرق بطين % 3(@)(@@) % فظل الوجد يسعرني ، كأني % % أخو ربع يؤرق أو طعين % 4(@)(@@) % يقول مجالد لما رآني ، % يراجعني الكلام ، فما أبين % 5(@)(@@) % أحقا أن حيا سوف يقضي ، % وقد كثرت بصاحبي الظنون % % 6(@)(@@) % تقربني ، وليس تشك أني ، % عدا فيهن ، بي الداء الدفين % % 7(@)(@@) % إلى ان ذر قرن الشمس ، حتى % % تغيب لودنا منهم حيون % % 8(@)(@@) % أقول لصاحبي ضحى : أنخل % بدا لكما بعمرة أم سفين ؟ % 9(@)(@@) % أم الأظعان يرفعهن ربع % من الرقراق ، جال بها الحرون % 10(@)(@@) % على البغلات أمثال وحور ، % كمثل نواعم البقار ، عين % % PageV01P525 11(@)(@@) % نواعم لم يخالطهن بؤس % ولم يخلط بنعمتهن هون % % PageV01P526 البحر : رمل تام 1(@)(@@) % إن من تهوى مع الفجر ظعن % للهوى والقلب متباع الوطن % 2(@)(@@) % بانت الشمس ، وكانت كلما % % ذكرت للقلب ، عاودت ددن % 3(@)(@@) % نظرت عيني إليها نظرة ، % مهبط الحجاج من بطن يمن % 4(@)(@@) % موهنا ، تمشي بها بغلتها ، % في عثانين من الحج ، ثكن % 5(@)(@@) % فرآها القلب لا شكل لها ، % ربما يعجب ب لشيء الحسن % 6(@)(@@) % قلت : قد صدت فماذا عندكم % احسن الناس لقلب مرتهن % % 7(@)(@@) % ولئن أمست نواها غربة ، % لا تؤاتيني وليست من وطن % 8(@)(@@) % فلقدما قربتني نظرتي % % لعناء ، آخر الدهر ، معن % % 9(@)(@@) % ثم قالت : بل لمن أبغضكم % شقوة العيش ، وتكليف الحزن % % 10(@)(@@) % بل كريم ، علقته نفسه % بكريم ، لو يرى أو لو يدن % PageV01P527 11(@)(@@) % سوف آتي زائرا أرضكم ، % بيقين ، فاعلميه ، غير ظن % % 12(@)(@@) % فأجابت : هذه أمنية ، % ليت أنا نشتريها بثمن % 13(@)(@@) % وهي ، إن شئت ، تسير نحونا ، % لو تريد الوصل ، أو تعقل عن % 14(@)(@@) % نصك العيس إلينا ، أربعا ، % تملك العين ، إذا العاني وهن % PageV01P528 البحر : بسيط تام 1(@)(@@) % قد هاج قلبك بعد السوة الوطن ، % و لشوق يحدثه للنازح الشجن % 2(@)(@@) % من كان يسأل عنا أين منزلنا ، % ف لأقحوانة منا منزل قمن % 3(@)(@@) % وما لدار عفت من بعد ساكنها % % وما لعيش بها ، إذ ذاكم ، ثمن % 4(@)(@@) % إذ الجمار 
ms127	 حرى ممن يسر به ، % و لحج قدما به معروف الثكن % 5(@)(@@) % إذ نلبس العيش صفوا لا يكدره % % جفو الوشاة ، ولا ينبو بنا زمن % 6(@)(@@) % إذا جتمعنا هجرنا كل فاحشة % عند للقاء ، وذاكم مجلس حسن % 7(@)(@@) % فذاك دهر مضت عنا ضلالته % وكل دهر له في سيره سنن % 8(@)(@@) % ليت الهوى لم يقربني إليك ، ولم % % أعرفك ، إذ كان حظي منكم الحزن % % PageV01P529 البحر : مجزوء الكامل 1(@)(@@) % هاج الفؤاد ظعائن % بالجزع من أعلى الحجون % 2(@)(@@) % يحدى بهن ، وفي الظعائن % % ربرب حور العيون % % 3(@)(@@) % فيهن طاوية الحشا ، % جيداء ، واضحة الجبين % % 4(@)(@@) % بيضاء ، ناصعة البياض ، % ض ، كدرة الصدف الكنين % 5(@)(@@) % في المنصب العالي ، وبيت % ت المجد ، في حسب ودين % 6(@)(@@) % إن القتول تقتلت % ب لدل للقلب الرهين % % 7(@)(@@) % حب القتول أحلها % % في القلب منزلة المكين % % 8(@)(@@) % فإذا تجاوب مرة % ورق الحمام على الغصون % % 9(@)(@@) % ذكرنني ما قد نسي % % من الصبابة بعد حين % 10(@)(@@) % إن الحزين يهيجه ، % بعد الذهول بكا الحزين % PageV01P530 11(@)(@@) % ل لنا هوى أخرى المنون % ن وما يمر من السنين % 12(@)(@@) % حب القتول ولا تزا % % هوى لنا اخرى المنون % % PageV01P531 البحر : بسيط تام 1(@)(@@) % هيهات من أمة الوهاب منزلنا % % إذا حللنا بسيف البحر من عدن % 2(@)(@@) % وحل أهلك أجيادا ، فليس لنا % % إلا التذكر ، أو حظ من الحزن % 3(@)(@@) % لا داركم دارنا يا وهب إن نزحت % نواك عنا ، ولا أوطانكم وطني % % 4(@)(@@) % فلست أملك إلا أن أقول ، إذا % % ذكرت : لا يبعدنك الله يا سكني % % 5(@)(@@) % يا وهب إن يك قد شط البعاد بكم ، % وفرق الشمل منا صرف ذا الزمن % % 6(@)(@@) % فكم وكم من حديث قد خلوت به ، % في مسمع منكم ، أو منظر حسن % % 7(@)(@@) % وكم وكم من دلال قد شغفت به % % منكم ، متى يره ذو العقل ، يفتتن % % 8(@)(@@) % بل ما نسيت ببطن الخيف موقفها ، % وموقفي ، وكلانا ثم ذو شجن % 9(@)(@@) % وقولها للثريا يوم ذي خشب ، % و لدمع منها على الخدين ذو سنن % 10(@)(@@) % ب لله قولي له ، في غير معتبة ، % ماذا أردت بطول المكث في اليمن % PageV01P532 11 
ms128	(@)(@@) % إن كنت حاولت دنيا أو نعمت بها % % فما أخذت بترك الحج من ثمن % % 12(@)(@@) % فلو شهدن ، غداة البين ، عبرتنا % % لأن تغرد قمري على فنن % 13(@)(@@) % لاستيقنت غير ما ظنت بصاحبها ، % وأيقنت أن لحجا ليس من وطني % % PageV01P533 البحر : رمل تام 1(@)(@@) % من رسوم باليات ودمن % عاد لي همي ، وعاودت ددن % 2(@)(@@) % يا أبا الحارث قلبي هائم % ف ئتمر أمر رشيد مؤتمن % 3(@)(@@) % نظرت عيني إليها نظرة ، % تركت قلبي لديها مرتهن % 4(@)(@@) % علق القلب غزالا شادنا % يا لقومي من غزال قد شدن % 5(@)(@@) % حسن الوجه ، نقيا لونه ، % طيب النشر ، لذيذ المحتضن % % 6(@)(@@) % أطلبن لي صاح وصلا عنده ، % إن خير الوصل ما ليس يمن % 7(@)(@@) % إن حبي آل ليلى قاتلي % % ظهر الحب بجسمي وبطن % 8(@)(@@) % ليس حب فوق ما أحببته ، % غير أن أقتل نفسي ، أو اجن % % 9(@)(@@) % جعلت للقلب مني حبها % % شجنا ، زاد على كل شجن % % 10(@)(@@) % فإذا ما شطحت ، هام بها ، % وإذا راعت إلى الدار سكن % PageV01P534 البحر : منسرح 1(@)(@@) % إعتادني ، بعد سلوة ، حزني % % طيف حبيب سرى فأرقني % % 2(@)(@@) % من ظبية ب لعقيق ساكنة % قد شفني حبها وعذبني % % 3(@)(@@) % وهي لنا ب لوصال طيبة الن % س ، وربي بها قد اغرمني % % 4(@)(@@) % شطت ديار الحبيب ، فاغتربت ، % هيهات شعب الحبيب من وطني % % 5(@)(@@) % علقتها شقوة ، وبان بها % % مني مليك ، فأصبحت شجني % % 6(@)(@@) % فليتها في الحياة تتبعني ، % وعند موتي يضمها كفني % % 7(@)(@@) % يا نظرة ما نظرت موجعة % لم أرها بعدها ، ولم ترني % % PageV01P535 البحر : بسيط تام 1(@)(@@) % بانت سليمى ، وقد كانت تؤاتيني ، % إن الاحاديث تأتيها وتاتيني % % 2(@)(@@) % فقلت ، لما لتقينا ، وهي معرضة % عني ، ليهنك من تدنينه دوني % % 3(@)(@@) % منيتنا فرجا ، إن كنت صادقة ، % يا بنت مروة ، حقا ما تمنيني ؟ % 4(@)(@@) % ماذا عليك ، وقد أجديته سقما ، % من حضرة الموت نفسي أن تعوديني % % 5(@)(@@) % وتجعلي نطفة في القعب باردة ، % فتغمسي فاك فيها ، ثم تسقيني % % 6(@)(@@) % فهي شفائي ، إذا ما كنت ذا سقم ، % وهي دوائي ، إذا ما الداء يضنيني % % PageV01P536 البحر : خفيف تام 1(@)(@@) % يا خليلي ، من ملام دعاني ، ، % وألما الغداة 
ms129	 بالأظعان % 2(@)(@@) % لا تلوما في اهل زينب ، إن ال % % قلب رهن بآل زينب ، عان % 3(@)(@@) % وهي أهل الصفاء والود مني ، % وإليها الهوى فلا تعذلاني % % 4(@)(@@) % لم تدع للنساء عندي نصيبا ، % غير ما قلت مازحا بلساني % % 5(@)(@@) % ولعمري لحين عمرو إليها % % يوم ذي الشري قادني ودعاني % % 6(@)(@@) % ما أرى ، ما حييت ، أن أذكر % الموقف منها بالخيف ، إلا شجاني % % 7(@)(@@) % ثم قالت لتربها ، ولأخرى ، % من قطين مولد : حدثاني % % 9(@)(@@) % قالتا : نبتغي إليه رسولا ، % ونميت الحديث بالكتمان % % 10(@)(@@) % إن قلبي بعد الذي نال منها ، % كالمعنى عن سائر النسوان % PageV01P537 البحر : خفيف تام 1(@)(@@) % إنني اليوم عادني أحزاني ، % وتذكرت ميعتي في زماني % % 2(@)(@@) % وتذكرت ظبية أم رئم ، % صدع القلب ذكرها ، فشجاني % % 3(@)(@@) % لا تلمني عتيق ، حسبي الذي بي ، % إن بي ، يا عتيق ، ما قد كفاني % % 4(@)(@@) % إن دهرا يلف شملي بسعدى % % لزمان يهم ب لإحسان % 5(@)(@@) % لا تلمني ، وأنت زينتها لي ، % أنت مثل الشيطان للإنسان % % 6(@)(@@) % إن بي داخلا من الحب قد % % لى عظامي مكنونه ، وبراني % % 7(@)(@@) % لو بعينيك ، يا عتيق ، نظرنا % % ليلة السفح قرت العينان % 8(@)(@@) % إذا بدا الكشح ، والوشاح من % % الدر ، وفصل فيه من المرجان % % 9(@)(@@) % وقلى قلبي النساء سواها ، % بعدما كان مغرما بالغواني % % 10(@)(@@) % وأرجي أن يجمع الدهر شملا % بك ، سقيا لذلكم من زمان ! % PageV01P538 11(@)(@@) % ليتني أشتري ، لنفسي منها ، % مثل ودي ، بساعدس وبناني % % 12(@)(@@) % خلجت عيني اليمين بخير ، % تلك عين مأمونة الخلجان % PageV01P539 البحر : خفيف تام 1(@)(@@) % ضحكت أم نوفل ، إذ رأتني % % وزهيرا ، وسالف بن سنان % 2(@)(@@) % عجبت إذ رأت لداتي شابوا ، % وقتيرا من المشيب علاني % % 3(@)(@@) % إن تريني أقصرت عن طلب الغي ، % وطاوعت عاذلي ، إذ نهاني % % 4(@)(@@) % وتركت الصبا ، وأدركني الحلم ، % م ، وحرمت بعض ما قد كفاني % % 5(@)(@@) % ودعاني إلى الرشاد فؤاد % كان للغي ، مرة ، قد دعاني % % 6(@)(@@) % فجوار مستقتلات إلى لله % و حسان كناضر الأغصان % 7(@)(@@) % قتل للرجال يرشقن ب لطر % ف ، حسان كخذل الغزلان % % 8(@)(@@) % بدن ، في خدالة وبهاء ، % طيبات الأعطاف والأردان % 9(@)(@@) % قد دعاني ، وقد دعاهن لله % و شجون 
ms130	 ، من أعجب الأشجان % 10(@)(@@) % ف هتصرنا من الحديث ثمارا ، % حيث لا يجتني ، لعمرك ، جاني % % PageV01P540 11(@)(@@) % ذاك طورا ، وتارة أبعث القي % نة ، وهنا ، بالمزهر الحنان % 12(@)(@@) % وأنص المطي ب لركب ، يطلب % لبن سراعا بواكر الأظعان % % 13(@)(@@) % فنصيد الغرير من بقر الوح % % ش ، ونلهو بلذة الفتيان % 14(@)(@@) % في زمان لو كنت فيه ضجيعي ، % غير شك ، عرفت لي عصياني % % 15(@)(@@) % وتقلبت في الفراش ، ولا تع % رف إلا الظنون أين مكاني % % PageV01P541 البحر : كامل تام 1(@)(@@) % أضحى فؤادك غير ذات أوان % بل لم يرعك تحمل الجيران % 2(@)(@@) % بانوا وصدع بينهم شعب النوى ، % عجبا كذاك تقلب الأزمان % 3(@)(@@) % أخطى الربيع بلادهم ، فتيمنوا ، % ولحبهم أحببت كل يمان % 4(@)(@@) % لله يرجعهم ، وكل مجلجل % واهي العزالي ، معلم الأوطان % 5(@)(@@) % ولقد أبيت ضجيع كل مخضب % رخص الأنامل طيب الأردان % 6(@)(@@) % عبق الثياب من العبير ، مبتل ، % يمشي يميد كمشية النشوان % % 7(@)(@@) % دعص من الأنقاء إن هي ادبرت ، % أو أقبلت ، فكصعدة المران % 8(@)(@@) % يجري عليها كلما غتسلت به % فضل الحميم يجول كالمرجان % 9(@)(@@) % سقيا لدارهم التي كانوا بها % % إذ لا يزال رسولهم يلقاني ! % 10(@)(@@) % ولقد خشيت بأن ألج بهجركم ، % إن الحبيب مذهل الإنسان % % PageV01P542 11(@)(@@) % بل جن قلبك أن بدت لك دارها % % جزعا ، وكدت تبوح بالكتمان % PageV01P543 البحر : خفيف تام 1(@)(@@) % ولقد أشهد المحدث عند ل % د القصر ، فيه تعفف وبيان % 2(@)(@@) % في زمان من المعيشة لذ ، % قد مضى عصره ، وهذا زمان % 3(@)(@@) % نجعل الليل موعدا حين نمسي ، % ثم يخفي حديثنا الكتمان % 4(@)(@@) % أيها الكاشح المعرض ب لصر % م ، تزحزح فما لها الهجران % 5(@)(@@) % لا مطاع في آل زينب فارجع ، % أو تكلم ، حتى يمل اللسان % 6(@)(@@) % لا صديقا كنت اتخذت ، ولا نص % % حك عندي زجر له ميزان % 7(@)(@@) % ف نطلق صاغرا فليس لها الصر % م لدينا ، ولا إليها الهوان % 8(@)(@@) % كيف صبري عن بعض نفسي ، وهل يص % بر عن بعض نفسه الإنسان ؟ % PageV01P544 البحر : خفيف تام 1(@)(@@) % سحرتني الزرقاء من مارون ، % إنما السحر عند زرق العيون % 2(@)(@@) % سحرتني بجيدها ، وشتيت ، % وبوجه ذي بهجة مسنون % % 3 
ms131	(@)(@@) % كأقاح برملة ضربته % % ريح جو بديمة ودجون % % 4(@)(@@) % تردع القلب ذا العزاء ، ويسلي % % برد أنيابها ردوع الحزين % % 5(@)(@@) % وجبين وحاجب لم يصبه % نتف خط ، كأنه خط نون % 6(@)(@@) % فرمتني ، فأقصدتني بسهم ، % شك مني الفؤاد بعد الوتين % 7(@)(@@) % ورمتها يداي مني بنبل % كيف أصطاد عاقلا في حصون ؟ % 8(@)(@@) % تنتحيني فلا ترى ، وترى النا % % س بصعب ممنع مأمون % % 9(@)(@@) % ذي محاريب أحرزت أن تراها % % كل بيضاء سهلة العرنين % PageV01P545 البحر : منسرح 1(@)(@@) % إني ، ومن احرم الحجيج له ، % وموقف الهدي ، بعد ، والبدن % 2(@)(@@) % والبيت ذي الأبطح العتيق ، وما % % جلل من حر عصب ذي اليمن % 3(@)(@@) % والأشعث الطائف المهل ، وما % % بين الصفا والمقام والركن % % 4(@)(@@) % وزمزم و لجمار إذ رميت ، % والجمرتين اللتين بالبطن % % 5(@)(@@) % وما أقر الظباء ب لبيت ، و ل % ق ، إذا ما دعت على فنن % % 6(@)(@@) % ما خنت عهد القتول إذ شطحت ، % ولو أتوها به لتصرمني % % 7(@)(@@) % وموقف الهدي بعد ، والبدن % منكم ، ولم آتها ، ولم أخن % % 8(@)(@@) % لا يكن البخل لي وجودكم ، % يوما لغيري ، وأنتم شجني % % 9(@)(@@) % ما كانت الدار ب لتلاع ولا الأ % جراع ، لولا القتول ، من وطني % % 10(@)(@@) % يا قوم حب القتول أجرضني % % وتاركي هائما بلا دمن % % PageV01P546 11(@)(@@) % قد خط في الزبر ، فاطلبوا بدمي ، % من لم يقدني يوما ، ولم يدني % % 12(@)(@@) % علقتها ناشئا ، وعلقت رجلا % غيري غض الشباب ك لغصن % 13(@)(@@) % وعلقتني أخرى وعلقها % % ناش يصيد القلوب ك لشطن % 14(@)(@@) % ف لشكل منها الغداة مختلف % ذا طلاب الضلال والفتن % 15(@)(@@) % قد قلت ، لما سمعت أمرهم : % يا رب قد شفني وأحزنني % % 16(@)(@@) % إليك أشكو لذي أصبت به % % PageV01P547 البحر : خفيف تام 1(@)(@@) % أصبح القلب في الحبال رهينا ، % مقصدا يوم فارق الظاعنينا % % 2(@)(@@) % عجلت حمة الفراق علينا % % برحيل ، ولم نخف أن تبينا % % 3(@)(@@) % لم يرعني إلا الفتاة ، وإلا % دمعها في الرداء سحا سنينا % % 4(@)(@@) % ولقد قلت ، يوم مكة سرا ، % قبل وشك من بينكم : نولينا % % 5(@)(@@) % أنت أهوى العباد قربا وبعدا ، % لو تنيلين عاشقا محزونا % % 6(@)(@@) % قاده الطرف ، يوم سرنا ، إلى الحي % % ن جهارا ، ولم 
ms132	 يخف أن يحينا % % 7(@)(@@) % فإذا نعجة تراعي نعاجا ، % ومها نجل المناظر ، عينا % % 9(@)(@@) % قلت : من أنتم ؟ فصدت ، وقالت : % أمبد سؤالك العالمينا ؟ % 10(@)(@@) % قلت : بالله ذي الجلالة لما % % ان تبلت الفؤاد أن تصدقينا % % 11(@)(@@) % أي من تجمع المواسم قولي ، % وأبيني لنا ، ولا تكتمينا % % PageV01P548 12(@)(@@) % نحن من ساكني العراق ، وكنا % % قبلها قاطنين مكة حينا % % 13(@)(@@) % قد صدقناك إذ سألت ، فمن أن % ت ؟ عسى أن يجر شأن شؤونا % % 14(@)(@@) % ونرى أننا عرفناك بالنع % % ت بظن ، وما قتلنا يقينا % % 15(@)(@@) % بسواد الثنيتين ، ونعت ، % قد نراه لناظر مستبينا % % PageV01P549 البحر : خفيف تام 1(@)(@@) % أصبح القلب بالقتول حزينا ، % هائم اللب ، لو قضته الديونا % % 2(@)(@@) % قال : أبشر ، لما اتاها رسول ، % قد رأينا منها لك اليوم لينا % % 3(@)(@@) % إن تكن ب لصفاء ، يا صاح ، همت ، % فلقد عنت الفؤاد سنينا % % 4(@)(@@) % أرسلت أننا نخاف شنات ، % آفكات ، من حولنا ، وعيونا % % 5(@)(@@) % إجتنبنا في الأرض ، إن كنت تخشى ، % إن لقيناك مرة ، أن تخونا % % 6(@)(@@) % فلك لله و لأمانة و لمي % % ق ، أن لا نخونكم ما بقينا % % 7(@)(@@) % ثم أن لا يزال من كنت تهوي % ن حبيبا ، ما عشت عندي مكينا % % 8(@)(@@) % ثم لا تحرب الأمانة عندي ، % أغدر الناس من يخون الأمينا % % 9(@)(@@) % ثم أن نصرف المناسيب ، حتى % % نتركك الناس يرجمون الظنونا % % 10(@)(@@) % ثم أن أرفض النساء سواكم ، % ها رضيتم ؟ قالت : نعم قد رضينا % % PageV01P550 البحر : خفيف تام 1(@)(@@) % ارحمينا ، يا نعم ، مما لقينا % % وصلينا ، فانعمي ، أو دعينا % % 2(@)(@@) % عنك إن تسألي ، فدى لك نفسي ، % ثم تأتين غير ما تزعمينا % % 3(@)(@@) % إن خير النساء عندي وصالا ، % من تؤاتي بوصلها ما هوينا % % 4(@)(@@) % و ذكري العهد و لمواثيق منا ، % يوم آليت لا تطيعين فينا % % 5(@)(@@) % قول واش أتاك عنا بصرم ، % أو نصيح يريد أن تقطعينا % % 6(@)(@@) % ويميني بمثل ذلك أني % % لا أصافي سواك في العالمينا % % 7(@)(@@) % ثم غيرت ما فعلت بفعل ، % كان فيه خلاف ما تعدينا % % 8(@)(@@) % فلئن كنت قد تغيرت بعدي ، % ورضيت الغداة أن تصرمينا % % 9(@)(@@) % ونسيت الذي عهدت إلينا % % في أمور خلون أن 
ms133	 تعلمينا % % 10(@)(@@) % لا تزالين آثر الناس عندي ، % فاعلمي ذاك في الهوى ما حيينا % % PageV01P551 البحر : خفيف تام 1(@)(@@) % حدثينا ، قريب ، ما تأمرينا % % إن قلبي أمسى بهند رهينا % % 2(@)(@@) % ما أراه إلا سيقضي عليه % % ناظر الحب ، خشية أن تبينا % % 3(@)(@@) % ثم قالت : وددت أن شفاء % لك ، يحمى منه الغداة ، يقينا % % 4(@)(@@) % إن نأت غربة بهند ، فإنا % % قد خشينا أن لا تقارب حينا % % 5(@)(@@) % فأشارت بأن قلبي مريض % من هواكم يجن وجدا رصينا % % 6(@)(@@) % ف لتمس ناصحا قريبا من النص % ح ، لطيفا ، لما تريد ، مكينا % % 7(@)(@@) % لا يخون الخليل شيئا ، ولكن % ربما يحسب المطيع أمينا % % 8(@)(@@) % فيرى فعله فيسدي إليه ، % وهو في ذاك ب لحرى أن يخونا % % 9(@)(@@) % يعلمث الله أنه لأمين ، % قبحت طينة الخيانة طينا ! % PageV01P552 البحر : خفيف تام 1(@)(@@) % لم ترى العين للثريا شبيها ، % بمسيل التلاع لما لتقينا % % 2(@)(@@) % أعملت طرفها إلي ، وقالت : % حب بالسائرين زورا إلينا % % 3(@)(@@) % ثم قالت لأختها : قد ظلمنا ، % إن رجعناه خئبا ، واعتدينا % % 4(@)(@@) % وضربنا الحديث ظهرا لبطن ، % وأتينا من أمرنا ما شتهينا % % 5(@)(@@) % في خلاء من الأنيس ، وأمن ، % فشفينا غليله ، واشتفينا % % 6(@)(@@) % فلبثنا بذاك عشرا تباعا ، % فقضينا ديوننا ، و قتضينا % % 7(@)(@@) % كان ذا في مسيرنا ، ورجعنا ، % علم الله ، منه ما قد نوينا % % PageV01P553 البحر : خفيف تام 1(@)(@@) % عاودض القلب من تذكر جمل ، % ما يهيج المتيم المحزونا % % 2(@)(@@) % إن ما اورثت من الحب جمل ، % كاد يبدي المجمجم المكنونا % % 3(@)(@@) % ليلة السبت ، إذ نظرت إليها % % نظرة زادت الفؤاد جنونا % % 4(@)(@@) % إن ممشاك دون دار عدي ، % كان للقلب فتنة وفتونا % % 5(@)(@@) % وتراءت على البلاط ، فلما % % واجهتنا كالشمس تعشي العيونا % % 6(@)(@@) % وجلا بردها ، وقد حسرته ، % نور بدر يضيء للناظرينا % % 7(@)(@@) % قال هارون : قف ، فيا ليت أني % % كنت طاوعت ساعة هارونا % % 8(@)(@@) % ونهتني عن النساء ، وحلت % منزلا من حمى الفؤاد مكينا % % 9(@)(@@) % ثم شكت ، فلست أعرف منها % % مقة لي ، ولا قلى مستبينا % % 10(@)(@@) % غير أني أؤمل الوصل منها ، % أمل المرتجي بغيب ظنونا % % PageV01P554 البحر : بسيط تام 1(@)(@@) % هل تعرف الدار والأطلال والدمنا ، % زدن الفؤاد 
ms134	 ، على علاته ، حزنا % % 2(@)(@@) % دار لأسماء قد كانت تحل بها ، % وأنت ، إذ ذاك ، إذ كانت لنا وطنا % % 3(@)(@@) % لم يحبب القلب شيئا مثل حبكم ، % ولم تر العين شيئا بعدكم حسنا % % 4(@)(@@) % ما غن أبالي ، إذا ما الله قربكم ، % من كان شط من الأحباب أو قطنا % % 6(@)(@@) % % وإن تجودي فقد عنيتني زمنا % % 7(@)(@@) % أمسى الفؤاد بكم يا هند مرتهنا % وأنت كنت الهوى و لهم و لوسنا % % 8(@)(@@) % إذ تستبيك بمصقول عوارضه ، % ومقلتي شادن لم يعد أن شدنا % % PageV01P555 البحر : بسيط تام 1(@)(@@) % قل للمنازل بالظهران قد حانا % % أن تنطقي فتبيني اليوم تبيانا % % 2(@)(@@) % ردي علينا بما قلنا تحيتنا % % وحدثينا : متى بان الذي بانا ؟ % 3(@)(@@) % قالت : ومن أنت أذكر ؟ قال : ذو شجن % قد هاج منه نحيب الحب أحزانا % % 4(@)(@@) % قالت : فأنت لذي أرسلت جارية % وهنا إلى الركب تدعى أم سفيانا ؟ % 5(@)(@@) % ثم أنخت وراء العرق أبعرة ، % أتين من ركبه الأعلى ، وركبانا % % 6(@)(@@) % ثم أتيت تخطى الركب مستترا ، % حتى لقيت لدى البطحاء إنسانا % % 7(@)(@@) % قلت : نعم ، فأبيني في محاورة ، % وحدثيني حديث الركب من كانا % % 8(@)(@@) % ذاك الزمان الذي فيه مودتكم ، % فقد تبدل بعد العهد أزمانا % % 9(@)(@@) % وقد مضت حجج من بعد ، أربعة ، % وأشهر و نتفضنا لعام شعبانا % % 10(@)(@@) % فبت ما إن أرى شيئا أسر به ، % إلا الحديث ، وغمز الكف أحيانا % % PageV01P556 11(@)(@@) % حتى إذا الركب ريعوا قمت منصرفا ، % مشي النزيف يكف الدمع تهتانا % % PageV01P557 البحر : كامل تام 1(@)(@@) % قال الخليط : غدا تصدعنا ، % أو بعده ، أفلا تشيعنا ؟ % 2(@)(@@) % أما الرحيل فدون بعد غد ، % فمتى تقول : الدار تجمعنا ؟ % 3(@)(@@) % لتشوقنا هند ، وقد قتلت % علما بأن البين فاجعنا % % 4(@)(@@) % عجبا لموقفها وموقفنا ، % وبسمع تربيها تراجعنا % % 5(@)(@@) % ومقالها : سر ليلة معنا ، % نعهد ، فإن البين شائعنا % % 6(@)(@@) % قلت : العيون كثيرة معكم ، % وأظن أن السير مانعنا % % 7(@)(@@) % لا بل نزوركم بأرضكم ، % فيطاع قائلكم وشافعنا % % 8(@)(@@) % قالت : أشيء أنت فاعله % هذا ، لعمرك ، أم تخادعنا ؟ % 9(@)(@@) % ب لله حدث مانؤمله % واصدق ، فإن الصدق واسعنا % % 10(@)(@@) % إضرب لنا أجلا نعد له % إخلاف موعده تقاطعنا % % PageV01P558 البحر 
ms135	 : خفيف تام 1(@)(@@) % أجمعت خلتي مع الهجر بينا ، % جلل لله ذلك الوجه زينا ! % 2(@)(@@) % أجمعت بينها ، ولم نك منها % % لذة العيش والشباب قضينا % % 3(@)(@@) % فتولت حمولها ، و ستقلت ، % لم تنل طائلا ، ولم نقض دينا % % 4(@)(@@) % فأصابت به فؤادي ، فهاجت % حزنا لي ، مبرحا كان حينا % % 5(@)(@@) % ولقد قلت ، يوم مكة لما % % أرسلت تقرأ السلام علينا : % 6(@)(@@) % أنعم الله بالرسول الذي أر % % سل ، والمرسل الرسالة ، عينا % % PageV01P559 البحر : وافر تام 1(@)(@@) % تقول وليدتي ، لما رأتني % % طربت ، وكنت قد أقصرت حينا : % 2(@)(@@) % أراك اليوم قد أحدثت شوقا % وعاد لك الهوى داء دفينا % % 3(@)(@@) % وكنت زعمت أنك ذو عزاء ، % إذا ما شئت ، فارقت القرينا % % 4(@)(@@) % بربك ، هل أتاك لها رسول ، % فشاقك ، أم لقيت لها خدينا ؟ % 5(@)(@@) % فقلت : شكا إلي أخ محب % كبعض زماننا ، إذ تعلمينا % % 6(@)(@@) % فقص علي ما يلقى بهند % % 7(@)(@@) % فوافق بعض ما قد تعرفينا % % مشوق حين يلقى العاشقينا % % 8(@)(@@) % وكم من خلة أعرضت عنها ، % لغير قلى وكنت بها ضنينا % % 9(@)(@@) % أردت فراقها وصبرت عنها % % ولو جن الفؤاد بها جنونا % % PageV01P560 البحر : خفيف تام 1(@)(@@) % أستعين لذي بكفيه نفعي ، % ورجائي ، على التي قتلتني % % 2(@)(@@) % ولقد كنت قد عرفت ، وأبصر % ت أمورا ، لو أنها نفعتني % % 3(@)(@@) % قلت : إني أهوى شفا ما ألاقي % % من خطوب تتابعت ، فدحتني % % PageV01P561 البحر : وافر تام 1(@)(@@) % أحن إذا رأيت جمال سعدى ، أحن إذا رأيت جمال سعدى ، % وأبكي ، إن رأيت لها قرينا % % 2(@)(@@) % وقد أفد الرحيل فقل لسعدى % % لعمرك ، خبري ما تأمرينا % % 3(@)(@@) % الا ياليل ، إن شفاء نفسي % % نوالك ، إن بخلت ، فزودينا % % PageV01P562 البحر : خفيف تام 1(@)(@@) % أيها الطارق الذي قد عناني ، % بعدما نام سامر الركبان % 2(@)(@@) % زار من نازح بغير دليل ، % يتخطى إلي ، حتى أتاني % % PageV01P563 البحر : خفيف تام 1(@)(@@) % أيها المنكح الثريا سهيلا ، % عمرك لله ، كيف يلتقيان % 2(@)(@@) % هي شامية إذا ما استقلت ، % لو تخوفت جفوة وصدودا ، أ % % PageV01P564 البحر : خفيف تام 1(@)(@@) % أصبح القلب مستهاما معنى % % بفتاة ، من أسوإ الناس ظنا % % 2(@)(@@) % قلت يوما لها وحركت العة % % د بمضرابها ، فغنت ، وغنى % % 3 
ms136	(@)(@@) % ليتني كنت ظهر عودك يوما ، % فإذا ما حتضنتني ، كنت بطنا % % 4(@)(@@) % فبكت ، ثم أعرضت ، ثم قالت : % من بهذا أتاك ، في اليوم ، عنا ؟ % 5(@)(@@) % لو تخوفت جفوة وصدودا ، % ما تطلبت ذا ، لعمرك ، منا % % 6(@)(@@) % قلت لما رأيت : خلك منه ، % بأبي ، ما عليك أن أتمنى ؟ % PageV01P565 البحر : خفيف تام 1(@)(@@) % عاود القلب بعض ما قد شجاه ، % من حبيب أمسى هوانا هواه % 2(@)(@@) % يا لقوم ، وكيف صبري عن من % لا ترى النفس طيب عيش سواه ؟ % 3(@)(@@) % أرسلت ، إذ رأت بعادي ، أن لا % % يقبلن بي محرشا ، إن اتاه % 4(@)(@@) % لا تطع بي ، فدتك نفسي ، عدوا % لحديث على هواه افتراه % 5(@)(@@) % لا تطع بي ، من لو رآني وإيا % % ك أسيري ضرورة ، ما عناه % 6(@)(@@) % واجتنابي بيت الحبيب ، وما الخل % % د بأشهى إلي من أن أراه % % 7(@)(@@) % ما ضراري نفسي بهجرة من لي % % س مسيئا ، ولا بعيدا ثراه % % 8(@)(@@) % دون أن يسمع المعاذر مني ، % أو يرى عاتبا ، فعندي رضاه % % PageV01P566 البحر : رجز تام 1(@)(@@) % خانك من تهوى فلا تخنه % وكن وفيا ، إن سلوت عنه % 2(@)(@@) % و سلك سبيل وصله وصنه % إن كان غدارا فلا تكنه % 3(@)(@@) % عسى تباريح تجيء منه ، % فيرجع الوصل ولم تشنه % PageV01P567 البحر : وافر تام 1(@)(@@) % تأوب عينه وهنا قذاها ، % وداواها الطبيب ، فما شفاها % % 2(@)(@@) % وأحدث قلبه خطرات حب ، % واحدث شوقه حزنا عراها % % 3(@)(@@) % لمن لا داره تدنو ، ولا قد % % عدت ، من دون رؤيته عداها % % 4(@)(@@) % وشاقني المنى للقاء هند ، % وعرض الأرض واسعة سواها % % 5(@)(@@) % فلما أن بدت شمس تجلت % من الأستار ، أبرزها دجاها % % 6(@)(@@) % ذكرت الشوق والأهواء يوما ، % يهيج لنفس متبول مناها % % 7(@)(@@) % وكنت إذا رأيت فتاة ملك % منعمة ، أربت بأن أراها % % 8(@)(@@) % ورمت الوصل ، إن لهن وصلا % شفاء النفس ، إن شيء شفاها % % PageV01P568 البحر : وافر تام 1(@)(@@) % لعائشة بنة التيمي عندي % % حمى في القلب ، ما يرعى حماها % % 2(@)(@@) % يذكرني بنة التيمي ظبي % يرود بروضة سهل رباها % % 3(@)(@@) % فقلت له ، وكادع يراع قلبي : % فلم أر قط كاليوم اشتباها % % 4(@)(@@) % سوى حمش بساقك مستبين ، % وأن شواك لم 
ms137	 يشبه شواها % % 5(@)(@@) % وأنك عاطل ، عار ، وليست % بعارية ، ولا عطل يداها % % 6(@)(@@) % وانك غير أفرع ، وهي تدلي % % على المتنين أسحم قد كساها % % 7(@)(@@) % ولو قعدت ، ولم تكلف بود ، % سوى ما قد كلفت به ، كفاها % % 8(@)(@@) % أظل ، إذا أكلمها ، كأني % % أكلم حية غلبت رقاها % % 9(@)(@@) % تبيت إلي ، بعد النوم ، تسري % % وقد أمسيت لا أخشى سراها % % PageV01P569 البحر : رمل تام 1(@)(@@) % قد صبا القلب صبا غير دني ، % وقضى الاوطار من أم علي % % 2(@)(@@) % وقضى الأوطار منها ، بعدما % % كادت الأوطار أن لا تنقضي % % 3(@)(@@) % ودعاه الحين منه للتي % % تقطع الغلات ب لدل البهي % % 4(@)(@@) % فارعوى عنها بصبر ، بعدما % % كان عنها زمنا لا يرعوي % % 5(@)(@@) % كلما قلت : تناسى ذكرها ، % راجع القلب الذي كان نسي % % 6(@)(@@) % فلها ، وارتاح للخود التي % % تيمت قلبي بذي طعم شهي % % 7(@)(@@) % بارد الطعم ، شتيت نبته % ك لأقاحي ، ناعم النبت ثري % % 8(@)(@@) % واضح ، عذب ، إذا ما ابتسمت ، % لاح لوح البرق في وسط الحبي % % 9(@)(@@) % طيب الريق ، إذا ما ذقته ، % قلت : ثلج ، شيب بالمسك الذكي % % 10(@)(@@) % وبطرف خلته ، حين بدت ، % طرف أم الخشف في عرف ندي % % PageV01P570 11(@)(@@) % وبفرع قد تدلى ، فاحم ، % كتدلي قنو نخل المجتني % % 12(@)(@@) % وبوجه حسن صورته ، % واضح السنة ، ذي ثغر نقي % % 13(@)(@@) % وبجيد أغيد ، زينه % خالص الدر ، وياقوت بهي % % 14(@)(@@) % ولها في القلب مني لوعة ، % كل حين ، هي في القلب تجي % % 15(@)(@@) % من يكن أمسى خليا من هوى ، % ففؤادي ليس منها بخلي % % 16(@)(@@) % أو يكن أمسى تقيا قلبه ، % فلعمري إن قلبي لغوي % % PageV01P571 
