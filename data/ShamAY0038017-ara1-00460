ms441	 عبد الأعلى الثعلبي.(@)(@@)(@@)(@@) ||| AUTO الأسود بن ثعلبة شامي(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: عبادة بن نسي.(@)(@@)(@@)(@@) ||| AUTO الأسود الطائي(@)(@@) يروي عن: عدي بن حاتم، روى عنه: ابنه فياض بن الأسود.(@)(@@)(@@)(@@) ||| AUTO الأسود بن أسامة(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الأعلى بن عامر كأنه بن أبي أسامة أسقط منه " أبي " فإن لم يكن ذلك فهو آخر.(@)(@@)(@@)(@@) ||| AUTO إياس بن جعفر(@)(@@) يروي عن: أنس بن مالك إن كان سمع منه، روى عنه: أبو عمرو بن العلاء.(@)(@@)(@@)(@@) ||| AUTO إياس بن عامر الغافقي(@)(@@) مصري يروي عن: علي بن أبي طالب، PageV01P002 [ج 2: ص 21] وعقبة بن عامر، روى عنه: موسى بن أيوب.(@)(@@)(@@)(@@) ||| AUTO إياس بن عبد الله(@)(@@) شيخ يروي عن: ابن عمر، روى عنه: الأعمش.(@)(@@)(@@)(@@) ||| AUTO إياس بن عبد الله بن أبي ذباب الدوسي(@)(@@) يقال: إن له صحبة، ولا يصح ذلك عندي، روى عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: عبد الله بن عبد الله بن عمر.(@)(@@)(@@)(@@) ||| AUTO إياس بن خليفة(@)(@@) يروي عن: رافع بن خديج، روى عنه: عطاء بن أبي رباح.(@)(@@)(@@)(@@) ||| AUTO إياس بن صبيح الحنفي أبو مريم(@)(@@) يروي عن: عمر وعثمان، روى عنه ابنه عبد الله بن إياس ومحمد ابن سيرين، وهو إياس بن ضبيح بن المحترش بن عبد عمرو بن أبي بن عبيد بن مالك بن عبد الله بن الدول بن حنيفة، ولي قضاء البصرة لعمر بن الخطاب ومات بناحية الأهواز.(@)(@@)(@@)(@@) ||| AUTO إياس بن عفيف الكندي(@)(@@) يروي عن: أبيه وله صحبة، روى عنه: ابنه إسماعيل بن إياس.(@)(@@)(@@)(@@) ||| AUTO إياس بن الحارث بن معيقيب(@)(@@) عن: جده معيقيب بن أبي فاطمة الدوسي حليف قريش، روى عنه: أبو مكين.(@)(@@)(@@)(@@) ||| AUTO إياس بن قتادة(@)(@@) من أهل البصرة، يروي عن: جماعة من الصحابة، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 22] أهل البصرة وكان مقدما في بني تميم نظر يوما إلى شيبة بيضاء في لحيته، فقال: أراني حمير الحاجات لبني تميم وهذا الموت يطلبني، فأتى الشبكة ونزلها متعبدا إلى أن مات، وجانب الرياسات 
ms442	 والولايات.(@)(@@)(@@)(@@) ||| AUTO إياس بن معاوية بن قرة كنيته أبو واثلة(@)(@@) يروي عن: أنس بن مالك، روى عنه: أهل البصرة إن صح سماعه من أنس بن مالك، وإلا فأنا أذكره في أتباع التابعين مات إياس بن معاوية سنة ثنتين وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO إياس بن عامر الغافقي مصري(@)(@@) يروي عن: عقبة بن عامر، روى عنه: موسى بن أيوب المصري ابن أخيه.(@)(@@)(@@)(@@) ||| AUTO إياس بن سلمة بن الأكوع(@)(@@) يروي عن: أبيه، روى عنه: عكرمة بن عمار، وابنه محمد بن إياس، مات بالمدينة سنة تسع عشرة ومائة، وكان كنيته أبا سلمة وكان له يوم مات سبع وسبعون سنة.(@)(@@)(@@)(@@) ||| AUTO إياس بن بيهس الباهلي البصري(@)(@@) يروي عن: أنس بن مالك، روى عنه: قتادة والجريري.(@)(@@)(@@)(@@) ||| AUTO إياس بن أبي رملة الشامي(@)(@@) يروي عن: معاوية بن أبي سفيان، روى عنه: عثمان بن المغيرة الثقفي.(@)PageV01P002(@)(@@) [ج 2: ص 23](@)(@@)(@@)(@@) ||| AUTO إياس بن زهير(@)(@@) يروي عن: علي بن أبي طالب، كنيته أبو طلحة، روى عنه: مسلم بن ندير.(@)(@@)(@@)(@@) ||| AUTO إياس بن سهل بن سعد الساعدي(@)(@@) أخو عباس بن سهل، يروي عن: أبيه، عن النبي صلى الله عليه وسلم قال: " لأن أصلي الصبح، ثم أجلس في مجلسي أذكر الله عز وجل حتى تطلع الشمس أحب إلي من شد على جياد الخيل في سبيل الله. روى عنه: أبو حازم المدني.(@)(@@)(@@)(@@) ||| AUTO إياس بن عمرو الأسلمي(@)(@@) يروي عن: علي، روى عنه: محمد بن أبي يحيى.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أبان بن عثمان بن عفان القرشي الأموي المدني كنيته أبو سعيد(@)(@@) يروي عن: أبيه، وكان من أعلم الناس بالقضاء، روى عنه: الزهري مات في ولاية يزيد بن عبد الملك، وكان قد أفلج، وكان به صمم أم عمرو بنت جندب بن عمرو.(@)(@@)(@@)(@@) ||| AUTO أبان بن طارق القيسي(@)(@@) يروي عن: عقبة بن عامر، روى عنه: عون بن حيان.(@)(@@) أبان(@)(@@) شيخ بصري، يروي عن: ابن عمر، روى شعبة، عن الأزرق بن قيس عنه.(@)(@@) أبان(@)(@@) شيخ، يروي عن: أبي بن كعب، روى عنه: محمد بن جحادة، لا أدرى من هو 
ms443	 ولا بن من هو.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الأزهر بن عبد الله الحرازي الشامي(@)(@@) يروي عن: النعمان بن بشير، روى عنه: صفوان بن عمرو السكسكي.(@)(@@) الأزهر بن عبد الله(@)(@@) يروي عن: عثمان بن عفان، وعبادة بن الصامت، روى عنه PageV01P002 [ج 2: ص 24] الأعشى بن عبد الرحمن بن مكمل.(@)(@@)(@@)(@@) ||| AUTO الأزهر الألهاني(@)(@@) يروي عن: ثوبان، روى عنه: ثور بن يزيد.(@)(@@)(@@)(@@) ||| AUTO الأزهر بن سعيد الحرازي الحمصي المرادي(@)(@@) يروي عن: عمر، وأبي عبيدة بن الجراح، مات سنة تسع وعشرين ومائة، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO الأزهر بن حميضة(@)(@@) يروي عن: أبي بكر، روى عنه: هلال بن يساف.(@)(@@)(@@)(@@) ||| AUTO الأزهر بن يزيد الغطيفي(@)(@@) يروي عن: المقداد بن الأسود، روى عنه: الحارث بن يزيد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الأزهر بن عبد الله(@)(@@) يروي عن: تميم الداري، روى عنه: الخليل بن مرة إن لم يكن الحرازي فلا أدرى من هو.(@)(@@)(@@)(@@) ||| AUTO الأزهر أبو الوليد الهوزني(@)(@@) شامي يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: حريز بن عثمان الرحبي.(@)(@@) الأزهر بن عبد الله(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبد الله بن سالم الأشعري،(@)(@@) (92) -[2: 24] ثنا أحمد بن الحسين بن عبد الجبار، قال: ثنا الهيثم بن خارجة، قال: ثنا عبد الله بن سالم الأشعري، عن أزهر بن عبد الله، قال: كنت في الخيل الذين سبوا أنس بن مالك وكان فيمن يؤلب على الحجاج، وكان مع عبد الرحمن بن الأشعث، فوسم في يده عتيق الحجاج، فقال: لولا أنك خدمت رسول الله صلى الله عليه وسلم لضربت عنقك(@)(@@)(@@)(@@) ||| AUTO أمية بن خالد(@)(@@) يروي المراسيل، روى عنه: أبو إسحاق السبيعي، ومن زعم أن له صحبة فقد وهم.(@)PageV01P002(@)(@@) [ج 2: ص 25](@)(@@)(@@)(@@) ||| AUTO أمية بن عبد الله بن خالد بن أسيد بن أبي العيص بن أمية(@)(@@) يروي عن: ابن عمر، هو أخو خالد بن عبد الله بن أسيد القرشي، روى عنه: السبيعي، مات في طاعون الفتيات سنة ست وثمانين، وإنما سمي طاعون الفتيات لأنه وقع في النساء بدا بهن مدة، ثم في الرجال، 
ms444	 وأم أمية أم حجير بنت شيبة بن عثمان بن طلحة بن أبي طلحة العبدري وهو الذي يروي الزهري، عن عبد الملك بن أبي بكر، عن أمية بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO أمية بن هند(@)(@@) يروي عن: أبي أمامة، روى عنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO أمية بن صفوان بن عبد الله بن صفوان بن أمية الجمحي القرشي المكي(@)(@@) روى عن جده صفوان بن أمية، روى عنه: ابن جريج، ونافع بن عمر، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO أسيد بن أبي أسيد الساعدي الأنصاري المدني(@)(@@) يروي عن: أبيه، ويقال له: أسيد، روى عنه: ابن الغسيل كنيته أبو إبراهيم مات في أول ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO أسيد بن عبد الرحمن بن زيد بن الخطاب العدوي(@)(@@) أخو عبد الحميد بن عبد الرحمن، عن: ابن عمر، وروى عنه: رياح بن عبيدة وعباد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO أسيد بن المتشمس بن معاوية السعدي ابن عم الأحنف بن قيس(@)(@@) يروي عن: أبي موسى، روى عنه: الحسن.(@)(@@)(@@)(@@) ||| AUTO أسيد ابن أخي رافع بن خديج(@)(@@) يروي عن: عمه رافع بن خديج، روى عنه: مجاهد.(@)PageV01P002(@)(@@) [ج 2: ص 26](@)(@@)(@@)(@@) ||| AUTO أسيد الجعفي(@)(@@) يروي المراسيل، روى عنه: الزبير بن عدي.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أوس بن عبد الله بن خالد الربعي أبو الجوزاء البصري(@)(@@) يروي عن: ابن عمر، وابن عباس وكان قد صحب ابن عباس اثنتي عشرة سنة، روى عنه: عمرو بن مالك النكري، قتل في الجماجم سنة ثلاث وثمانين، وكان عابدا فاضلا، وكان يواصل أياما ثم يأخذ على يد الشاب فيكاد يحطمها،(@)(@@) (93) -[2: 26] ثنا محمد بن إسحاق الثقفي، قال: ثنا حاتم بن الليث، قال: ثنا مسلم بن إبراهيم، قال: ثنا سعيد بن زيد، عن عمرو بن مالك، أن أبا الجوزاء لم يكذب قط(@)(@@)(@@)(@@) ||| AUTO أوس بن ضمعج الحضرمي(@)(@@) يروي عن: أبي مسعود، وعائشة، عداده في أهل الكوفة، روى عنه إسماعيل بن رجاء، وأبو إسحاق، مات أوس سنة أربع وسبعين في ولاية بشر بن مروان على العراق.(@)(@@)(@@)(@@) ||| AUTO أوس بن نعام(@)(@@) يروي عن: علي، كنيته أبو سهل، روى عنه: المشمرج. 
ms445	(@)(@@)(@@)(@@) ||| AUTO أوس بن أبي أوس(@)(@@) يروي عن: أبي هريرة، روى عنه: علي بن زيد.(@)(@@) أوس بن عبد الله(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: ابنه عبد الله بن أوس.(@)(@@)(@@)(@@) ||| AUTO أوس بن عبد الله المرادي(@)(@@) من أهل الكوفة، يروي عن: عمر بن الخطاب، روى عنه: أهلها.(@)PageV01P002(@)(@@) [ج 2: ص 27](@)(@@)(@@)(@@) ||| AUTO أوس بن ثريب التغلبي(@)(@@) يروي عن: جرير بن عبد الله، روى عنه: حنظلة والد أبي طلق ويقال ابن ثويب.(@)(@@)(@@)(@@) ||| AUTO أوس بن العمانية(@)(@@) يروي عن: أبي موسى الأشعري، روى عنه: زياد بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO أوس بن خالد(@)(@@) يروي عن: أبي محذورة، وسمرة، وأبي هريرة، روى عنه: علي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO أوس بن بشر المعافري(@)(@@) يروي عن: عقبة بن عامر، عداده في المصريين، روى عنه: واهب بن عبد الله المعافري، ومعافر سكة بمصر.(@)(@@)(@@)(@@) ||| AUTO أوس الكلابي(@)(@@) يروي عن: الضحاك بن سفيان، روى عنه: ابنه حاجب بن أوس.(@)(@@)(@@)(@@) ||| AUTO أسامة بن خريم(@)(@@) يروي عن وله صحبة، روى عنه: عبد الله بن شقيق العقيلي.(@)(@@)(@@)(@@) ||| AUTO أسامة بن سلمان النخعي(@)(@@) عداده في أهل الشام، يروي عن: أبي ذر، وابن مسعود، وروي عنه: عمر بن نعيم من حديث مكحول، منهم من قال: عن مكحول عن أسامة بن سلمان، عن أبي ذر، ومنهم من قال: عن مكحول، عن عمر بن نعيم عن أسامة بن سلمان.(@)(@@)(@@)(@@) ||| AUTO أسلم(@)(@@) مولى عمر بن الخطاب، كنيته أبو خالد القرشي المدني، وقد قيل أبو زيد، يروي عن: عمر، روى عنه: ابنه زيد بن أسلم مات وهو ابن أربع عشرة ومائة سنة وصلى عليه مروان بن الحكم وكان من الأشعريين.(@)PageV01P002(@)(@@) [ج 2: ص 28](@)(@@)(@@)(@@) ||| AUTO أسلم بن زرعة الكلابي بصري(@)(@@) يروي عن: أبي موسى الأشعري، روى عنه: عبد الله بن بريدة.(@)(@@)(@@)(@@) ||| AUTO أسلم بن عمران أبو عمران التجيبي(@)(@@) مولى تجيب، يروي عن: عقبة بن عامر، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO أسلم العجلي الربعي(@)(@@) يروي عن: أبي موسى الأشعري، روى عنه: سليمان التيمي وابنه أشعث بن أسلم.(@)(@@)(@@)(@@) ||| AUTO أسلم بن 
ms446	 سليم المكي(@)(@@) يروي عن: أبي الفضل، روى عنه: عبد الكريم بن هلال الخلقاني الكوفي.(@)(@@)(@@)(@@) ||| AUTO أيمن بن خريم بن فاتك الأسدي(@)(@@) يروي عن: أبيه، روى عنه: الشعبي، وهو الذي قال له عبد الملك بن مروان: إن أباك كانت له صحبة، فخذ هذا المال وانطلق فقاتل بن الزبير، فأبي عليه ذلك وقال:(@)(@@) لست بقاتل رجلا يصلي على سلطان آخر من قريش(@)(@@) له سلطانه وعلي وزري معاذ الله من سفه وطيش(@)(@@) أأقتل مؤمنا وأعيش حيا فلست بنافعي ما عشت عيشي(@)(@@)(@@)(@@) ||| AUTO أيمن بن عبيد الحبشي(@)(@@) مولى لابن أبي عمرو المخزومي، من أهل مكة، يروي عن: عائشة، روى عنه: مجاهد، وعطاء، وابنه عبد الواحد بن أيمن، وهو الذي يقال له: أيمن بن أم أيمن مولاة النبي صلى الله عليه وسلم نسب إلى أمه وكان أخا أسامة بن زيد لأمه، ومن زعم أن له صحبة فقد وهم، حديثه في القطع مرسل.(@)PageV01P002(@)(@@) [ج 2: ص 29](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أيمن بن عبد الله أبو المختار(@)(@@) من ساكني الربذة، يروي عن: أبي ذر، روى عنه: عقبة بن وهب.(@)(@@)(@@)(@@) ||| AUTO أيمن بن ثابت أبو ثابت(@)(@@) مولى بني ثعلبة، يروي عن: ابن عباس، ويعلى بن مرة، روى عنه: أبو يعفور عبد الرحمن بن عبيد الكوفي، والربيع بن عبد الله.(@)(@@) (94) -[2: 29] حدثنا أبو يعلى، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا يحيى بن زكريا، عن أبي يعفور، عن أيمن، قال: سمعت يعلى بن مرة، قال: سمعت النبي صلى الله عليه وسلم يقول: " من أخذ أرضا بغير حقها كلف أن يحمل ترابها إلى الحشر "(@)(@@) أيمن(@)(@@) يروي عن: أبي الدرداء، روى عنه: ابنه الوليد بن أيمن.(@)(@@)(@@)(@@) ||| AUTO أيمن بن مالك الأشعري(@)(@@) يروي عن: أبي أمامة، وأبي هريرة، عن همام، عن قتادة، عن أيمن، عن أبي هريرة، وقاله عبد الله بن موسى، عن همام، عن قتادة، عن أبي أمامة.(@)(@@)(@@)(@@) ||| AUTO أنس ابن سيرين(@)(@@) أخو محمد ابن سيرين مولى أنس بن مالك، يروي عن: ابن عمر وابن عباس، روى عنه: ابن عون، وأيوب، لما ولد 
ms447	 ذهب به إلى أنس بن مالك فسماه أنسا وكناه بأبي حمزة، اسم نفسه وكنية نفسه، مات في ولاية خالد على العراق، وولي خالد على العراق سنة ست ومائة، وعزل سنة عشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO أنس بن أبي أنيس العذري(@)(@@) يروي عن: فضالة بن عبيد، روى عنه: عبد الرحمن بن خشخاش.(@)(@@)(@@)(@@) ||| AUTO أنس بن ظهير بن رافع(@)(@@) أخو أسيد بن ظهير، مدني روى المراسيل، روى عنه: حسين بن ثابت.(@)PageV01P002(@)(@@) [ج 2: ص 30](@)(@@)(@@)(@@) ||| AUTO أنس بن الحارث(@)(@@) قتل مع الحسين بن علي، روى الأشعث بن سليم، عن أبيه عنه.(@)(@@)(@@)(@@) ||| AUTO أنس بن أبي مرثد الأنصاري(@)(@@) روى المراسيل، روى عنه: الحكم بن مسعود النجراني.(@)(@@)(@@)(@@) ||| AUTO أنس بن جندل(@)(@@) يروي عن: أبي موسى، روى عنه: أبو عمران الجوني.(@)(@@)(@@)(@@) ||| AUTO أنس القيسي(@)(@@) يروي عن: ابن عباس، روت عنه أسماء بنت يزيد.(@)(@@)(@@)(@@) ||| AUTO أنس بن عمرو الأسلمي(@)(@@) يروي عن: علي بن أبي طالب، روى محمد بن أبي يحيى، عن أبيه عنه.(@)(@@)(@@)(@@) ||| AUTO أنس بن بيهس الباهلي(@)(@@) يروي عن: أنس بن مالك، روى عنه: قتادة وهو الذي يقال له إياس بن بيهس.(@)(@@)(@@)(@@) ||| AUTO أنس بن حكيم الضبي البصري(@)(@@) يروي عن: أبي هريرة، روى عنه: الحسن.(@)(@@)(@@)(@@) ||| AUTO أنيس أبو العريان المجاشعي(@)(@@) يروي عن: أنس بن مالك، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO أنيس بن عمران أبو يزيد اليافعي(@)(@@) يروي عن: أنس بن مالك إن كان سمع منه، روى عنه: عبد الله بن يزيد المقرئ.(@)(@@)(@@)(@@) ||| AUTO أبي بن عباس بن سهل بن سعد الساعدي(@)(@@) يروي عن: سهل بن PageV01P002 [ج 2: ص 31] سعد، وأبي الطفيل، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO أبي بن قيس(@)(@@) أخو علقمة بن قيس قتل مع علي بصفين، وكان تحت راية أخيه علقمة في ذلك اليوم ليس له حديث مروي يرجع إليه إلا ما يحكى عنه النخعي الحرف بعد الحرف.(@)(@@)(@@)(@@) ||| AUTO آدم بن علي العجلي البكري كوفي(@)(@@) يروي عن: ابن عمر، روى عنه: الثوري وشعبة مات في ولاية هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO آدم بن أبي مريم(@)(@@) يروي عن: أبي 
ms448	 هريرة، روى عنه: عثمان بن الأسود.(@)(@@)(@@)(@@) ||| AUTO إدريس الصنعاني(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ربيعة بن عثمان.(@)(@@)(@@)(@@) ||| AUTO أربدة التميمي(@)(@@) يروي عن: ابن عباس أصله من البصرة من بني تميم كان يجالس البراء، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO الأقرع(@)(@@) مؤذن عمر بن الخطاب، يروي عن: عمر، روى عنه: عبد الله بن شقيق العقيلي.(@)(@@)(@@)(@@) ||| AUTO أويس بن عامر القرني(@)(@@) من اليمن من مراد سكن الكوفة وكان عابدا زاهدا، يروي عن: عمر اختلفوا في موته، فمنهم من يزعم أنه قتل يوم صفين في رجالة علي، ومنهم من زعم أنه مات على جبل أبي قبيس بمكة، ومنهم من زعم أنه مات بدمشق، ويحكون في موته قصصا تشبه المعجزات التي رويت عنه، وقد كان بعض أصحابنا ينكر كونه في الدنيا، ثنا عبد العزيز الرخي، قال: ثنا عباس بن محمد، قال: ثنا قراد أبو نوح: سمعت شعبة، يقول: سألت عمرو بن مرة، وأبا إسحاق، عن أويس القرني فلم يعرفاه.(@)PageV01P002(@)(@@) [ج 2: ص 32](@)(@@)(@@)(@@) ||| AUTO الأغر بن عبد الله أبو مسلم كوفي(@)(@@) يروي عن: أبي هريرة، وأبي سعيد، روى عنه: أبو إسحاق السبيعي، وعطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO الأغر بن سليك الكوفي(@)(@@) وهو الذي يقال له أغر بن حنظلة، يروي المراسيل، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO أوسط بن عمرو البجلي، ويقال أوسط بن عامر وقد قيل أوسط بن إسماعيل(@)(@@) يروي عن: أبي بكر الصديق، روى عنه: سليم بن عامر.(@)(@@)(@@)(@@) ||| AUTO أرقم بن شرحبيل الأودي(@)(@@) أخو هذيل بن شرحبيل كوفي، يروي عن: ابن مسعود، وابن عباس، روى عنه أبو إسحاق السبيعي، وعبد الله بن أبي السفر.(@)(@@)(@@)(@@) ||| AUTO أرقم بن يعقوب كوفي(@)(@@) روى المراسيل، روى عنه أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO أرقم بن أبي الأرقم(@)(@@) يروي عن: ابن عباس، روى عنه: حميد الخياط.(@)(@@)(@@)(@@) ||| AUTO أهبان بن صيفي(@)(@@) ابن أخت أبي ذر، يروي عن: أبي ذر، روى عنه: حميد بن عبد الرحمن، وابنته عديسة، سكن البصرة، وكان من العباد، وأوصى عند موته ألا يكفن في قميص مخيط فكفن في 
ms449	 قميص فلما رجعوا من دفنه ودخلوا داره، فإذا القميص الذي كفنوه فيه موضوع في البيت رأوه بعينه وعرفوه.(@)(@@)(@@)(@@) ||| AUTO أيفع(@)(@@) يروي عن: ابن عمر، روى عنه: أبو حريز.(@)PageV01P002(@)(@@) [ج 2: ص 33](@)(@@)(@@)(@@) ||| AUTO أسيد بن ظهير(@)(@@) ابن أخي رافع بن خديج الأنصاري، يروي عن: عمه، وقد قيل إن له صحبه، ولا يصح ذلك عندي لأن إسناد خبره فيه اضطراب.(@)(@@)(@@)(@@) ||| AUTO الأحنف بن قيس بن معاوية بن حصين بن عبادة بن النزال بن مرة بن عبيد بن الحارث بن عمرو بن كعب بن سعد بن زيد مناة بن تميم السعدي البصري كنيته أبو بحر(@)(@@) وقد قيل أبو عمرو، أمه حيي بنت قرط بن ثعلبة بن قرواش بن زاقي بن سلامة بن عدي، والأحنف كان اسمه صخر، وقد قيل إن اسمه الضحاك، والأحنف لقب لأنه ولد أحنف وكان من عقلاء الناس، وفصحائهم وحكمائهم، يروي عن: عمر، وعثمان، روى عنه الحسن، وأهل البصرة، وقد قيل إن الأحنف ولد ملتصق الإليتين حتى يشق، وكان أعور شهد مع علي بن أبي طالب صفين، ولم يشهد الجمل معه، ومات سنة سبع وستين بالكوفة في إمارة ابن الزبير، وصلى عليه مصعب بن الزبير، ومشى في جنازته بغير رداء، ودفن بالكوفة وقبره بالقرب من قبر زياد بن أبيه.(@)(@@)(@@)(@@) ||| AUTO الأحنف أبو بحر الهلالي العبسي(@)(@@) يروي عن: ابن مسعود، روى عنه: ابنه.(@)(@@)(@@)(@@) ||| AUTO أسد بن وداعة الشامي كنيته أبو العلاء(@)(@@) يروي عن: شداد بن أوس، روى عنه: أهل الشام، وكان عابدا، قتل سنة ست أو سبع وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO أسد بن صفوان(@)(@@) يروي عن: علي، روى عنه: عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO أسد بن عبد الله البجلي(@)(@@) أخو خالد بن عبد الله القسري، كان على خراسان PageV01P002 [ج 2: ص 34] عداده في أهل الكوفة، روى المراسيل.(@)(@@)(@@)(@@) ||| AUTO الأسقع بن الأسلع(@)(@@) يروي عن: سمرة بن جندب، روى عنه: سويد بن حجير.(@)(@@)(@@)(@@) ||| AUTO أعين أبو يحيى البصري(@)(@@) يروي عن: أنس بن مالك، روى عنه: الضحاك بن شرحبيل، وأحسبه الذي يقال له أعين الخوارزمي، الذي روى 
ms450	 عنه: التبوذكي، وكان من سبى خوارزم.(@)(@@)(@@)(@@) ||| AUTO أرطأة بن الحارث النخعي(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: أهل الكوفة، مات سنة إحدى وستين.(@)(@@)(@@)(@@) ||| AUTO أرطأة والد عدي بن أرطأة(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: الحسن، وبكر المزني.(@)(@@)(@@)(@@) ||| AUTO الأصفح(@)(@@) مؤذن أهل المدينة، يروي عن: أبي هريرة، روى عنه: ابنه إبراهيم.(@)(@@)(@@)(@@) ||| AUTO أفلح بن كثير(@)(@@) مولى أبي أيوب الأنصاري من أهل المدينة، يروي عن: عثمان بن عفان، وأبي أيوب، وعبد الله بن سلام، روى عنه ابن سيرين، وأبو بكر بن عمرو بن حزم، قتل يوم الحرة سنة ثلاث وستين.(@)(@@)(@@)(@@) ||| AUTO أسماء بن خارجة بن حصن بن حذيفة بن بدر الفزاري(@)(@@) يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم مات سنة خمس وستين وهو ابن ثمانين سنة.(@)(@@)(@@)(@@) ||| AUTO أسماء بن الحكم الفزاري(@)(@@) يروي عن: علي بن أبي طالب، روى PageV01P002 [ج 2: ص 35] عنه: علي بن ربيعة الوالبي، يخطئ.(@)(@@)(@@)(@@) ||| AUTO أسماء بن عبيد بن مخراق بصري(@)(@@) يروي عن: أنس بن مالك، روى عنه: ابنه جويرية بن أسماء، مات سنة إحدى وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO أسماء بن حارثة(@)(@@) يروي المراسيل، عداده في أهل الكوفة، روى عنه: ابنه مالك بن أسماء.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أذينة بن سلمة العبدي(@)(@@) يروي عن: عمر، روى عنه: ابنه عبد الرحمن بن أذينة.(@)(@@) أذينة(@)(@@) من أهل عمان، يروي عن: ابن عباس، روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO أذينة أبو العالية البراء بصري(@)(@@) وقد قيل إن اسم أبي العالية: زياد بن فيروز، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO أرطبان(@)(@@) مولى مزينة جد بن عون، يروي عن: عمر، روى ابن عون، عن أبيه، عن جده.(@)(@@)(@@)(@@) ||| AUTO أبو رهم السمعي(@)(@@) اسمه أحزاب بن أسيد الظهري، يروي عن: أيوب، روى عنه: مكحول وخالد بن معدان والناس.(@)(@@)(@@)(@@) ||| AUTO الأخنس السدوسي(@)(@@) والد بكير بن الأخنس، يروي عن: ابن مسعود، روى عنه: أبو جناب.(@)(@@)(@@)(@@) ||| AUTO أسير بن جابر العبدي الكوفي(@)(@@) يروي عن: عمرو بن مسعود، روى PageV01P002 [ج 2: ص 36] عنه البصريون: 
ms451	 قتادة، وأبو عمران الجوني، وأبو نضرة، في القلب من روايته من أويس القرني، إلا أنه حكى ما حكى عن إنسان مجهول لا يدرى من هو والقلب أنه ثقة أميل.(@)(@@)(@@)(@@) ||| AUTO أخشن السدوسي(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبد المؤمن بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO أكيل التيمي أبو حبيب(@)(@@) يروي عن: علي بن أبي طالب أنه توضأ من مطهرة، روى عنه: مختار التمار.(@)(@@)(@@)(@@) ||| AUTO الأزرق بن قيس الحارثي(@)(@@) من بلحارث بن كعب بصري، يروي عن: ابن عمر وأنس بن مالك، وأبي برزة، روى عنه سليمان التيمي، وشعبة مات في ولاية خالد على العراق،(@)(@@) (95) -[2: 36] ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر، قال: ثنا أبي، عن الأزرق بن قيس، أن أبا برزة كان " يصلي وهو ممسك دابته، فانفلتت دابته، فمشي إليها فأخذها، ثم عاد إلى صلاته ". فعاب عليه بعضهم حتى عرفوا أنه أبو برزة(@)(@@)(@@)(@@) ||| AUTO الأسلع بن حي الضبي(@)(@@) يروي عن: أبي هريرة، روى عنه: المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO إياد بن لقيط السدوسي(@)(@@) يروي عن: أبي رمثة، والبراء بن عازب، روى عنه: الثوري، ومسعر، وابنه عبيد الله بن إياد.(@)(@@)(@@)(@@) ||| AUTO أثال بن قرة بن حوشب الحنفي(@)(@@) من أهل اليمامة، يروي عن: أم سلمة، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO أبو راشد الحبراني اسمه أخضر(@)(@@) رأى أصحاب النبي صلى الله عليه وسلم عداده في أهل الشام، روى عنه: أهلها.(@)PageV01P002(@)(@@) [ج 2: ص 37](@)(@@)(@@)(@@) ||| AUTO أسماء بنت عبد الرحمن بن أبي بكر الصديق(@)(@@) كانت في حجر عائشة، تروي عن عائشة، يروي عنها عبد الرحمن بن القاسم بن محمد بن أبي بكر الصديق.(@)(@@)(@@)(@@) ||| AUTO آمنة بنت عبد الرحمن بن أبي ليلى(@)(@@) تروي عن جدتها أم ليلى، قالت: " بايعنا رسول الله صلى الله عليه وسلم ". روت عنها بنت أخيها حمادة بنت محمد بن عبد الرحمن بن أبي ليلى.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أنيسة بنت زيد بن أرقم(@)(@@) تروي عن أبيها، عن النبي صلى الله عليه وسلم قال: " الذهب والحرير حل لإناث أمتي، حرام على ذكورها ". روى 
ms452	 عنها ثابت بن زيد بن ثابت بن أرقم.(@)(@@) أنيسة(@)(@@) عن امرأة سمعت النبي صلى الله عليه وسلم يقول: " لا أحل نبيذ حنتم، ولا نقير، ولا مزفت، ولا أحرم إلا ما حرم الله ". رواه عنها جابر بن صبح.(@)(@@)(@@)(@@) || AUTO باب الباء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن أصحاب رسول الله صلى الله عليه وسلم وشافههم ممن ابتدأ اسمه على الباء:(@)(@@)(@@)(@@) ||| AUTO بلال بن أبي الدرداء الأنصاري(@)(@@) كان قاضيا بدمشق، وأول من ولي القضاء بدمشق أبو الدرداء، ثم فضالة بن عبيد، ثم النعمان بن بشير، ثم بلال بن أبي الدرداء فلما استخلف عبد الملك بن مروان عزل بلالا وولي أبا مسلم الخولاني، روى عنه: أهل الشام، ومات بلال بن أبي الدرداء في آخر سنة ثلاث وتسعين.(@)(@@)(@@)(@@) ||| AUTO بلال بن عبد الله بن عمر بن الخطاب(@)(@@) يروي عن: أبيه، روى عنه: كعب بن علقمة.(@)PageV01P002(@)(@@) [ج 2: ص 38](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بلال بن أبي هريرة(@)(@@) يروي عن: أبيه قصة الدجال، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO بلال بن أبي موسى الأشعري(@)(@@) يروي عن: أنس بن مالك، عداده في أهل الكوفة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO بلال أبو علقمة(@)(@@) يروي عن: عائشة، روى عنه: علقمة بن أبي علقمة.(@)(@@)(@@)(@@) ||| AUTO بلال بن عصمة(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO بلال بن سعد القيسي(@)(@@) يروي عن: ميمونة، روى عنه: سعد بن أوس.(@)(@@)(@@)(@@) ||| AUTO بلال بن يحيى العبسي الكوفي(@)(@@) يروي عن: حذيفة، روى عنه: سعد بن أوس وحبيب بن سليم(@)(@@)(@@)(@@) ||| AUTO بلال بن بقطر بصري(@)(@@) يروي عن: أبي بكرة، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO بلال بن سعد بن تميم السكوني الشامي الأشعري العابد(@)(@@) يروي عن: أبيه، ولأبيه صحبة، روى عنه: الأوزاعي، وعمرو بن شراحيل، وكان عابدا زاهدا يقص توفي في ولاية هشام بن عبد الملك.(@)(@@) بلال(@)(@@) مؤذن بيت المقدس، عن: عبادة بن الصامت، روى عنه: محمد بن ميمون.(@)PageV01P002(@)(@@) [ج 2: ص 39](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بشر بن شغاف البصري الضبي(@)(@@) يروي عن: عبد الله بن عمرو، وعبد الله بن سلام، روى 
ms453	 عنه محمد بن عبد الله بن أبي يعقوب، وروى سليمان التيمي، عن أسلم عنه.(@)(@@)(@@)(@@) ||| AUTO بشر بن المحتفز بن أوس بصري(@)(@@) يروي عن: ابن عمر في لبس الحرير، روى عنه: قتادة، وكان والى عمر على السوس، ومنهم من زعم أنه بشر بن المحتفز بن عدي، والأول أصح، وأوس هو أوس بن زياد بن أسحم بن ربيعة بن عدي بن ثعلبة بن ذؤيب بن سعد بن عدي بن عثمان بن عمرو بن أد بن طابخة بن الياس بن مضر.(@)(@@)(@@)(@@) ||| AUTO بشر بن مريح الخولاني(@)(@@) يروي عن: أبي أيوب، روى عنه: جعفر بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO بشر بن قيس التغلبي(@)(@@) يروي عن: عمر، روى عنه: زياد بن علاقة.(@)(@@)(@@)(@@) ||| AUTO بشر بن عائذ المنقري بصري(@)(@@) يروي عن: ابن عمر، روى عنه: قتادة.(@)(@@) بشر(@)(@@) مولى أبان بن عثمان، يروي عن: ابن عمر، روى عنه: سليمان بن بلال.(@)(@@) بشر(@)(@@) يروي عن: عبد الله بن سلام، روى عنه: محمد بن أبي يعقوب أحسبه ابن شغاف.(@)(@@)(@@)(@@) ||| AUTO بشر بن عمر السكوني الكوفي(@)(@@) يروي عن: أبي مسعود، روى عنه: ابنه بشير بن بشر والمسيب بن رافع قتل قبل الجماجم.(@)(@@)(@@)(@@) ||| AUTO بشر بن عاصم(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: يعلى بن عطاء.(@)PageV01P002(@)(@@) [ج 2: ص 40](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بشر بن عاصم الليثي(@)(@@) يروي عن: عقبة بن مالك، روى عنه: حميد بن هلال.(@)(@@) بشر(@)(@@) يروي عن: أبي الدرداء، روى عنه: ابنه قيس بن بشر.(@)(@@)(@@)(@@) ||| AUTO بشر أبو نصر(@)(@@) مولى للحى، يروي عن: معاوية، روى عنه: عبد الله بن بكر السهمي.(@)(@@)(@@)(@@) ||| AUTO بشر بن غالب الأسدي(@)(@@) يروي عن: الحسين بن علي، روى عنه: ابن أشوع، وعبد الله بن شريك، وهو بشر بن غالب بن جنادة بن سفيان بن وهب بن مالك بن ذؤيب بن، والبة بن الحارث بن ثعلبة بن دودان بن أسد بن خزيمة.(@)(@@) بشر(@)(@@) مولى عبد الرحمن القرشي، يروي عن: الحسين بن علي، روى عنه: إسماعيل بن عبد الرحمن السدي.(@)(@@)(@@)(@@) ||| AUTO بشر بن قحيف العامري(@)(@@) يروي عن: عمر 
ms454	 والمغيرة بن شعبة، روى عنه: سماك بن حرب، قال:(@)(@@) (96) -[2: 40] حدثنا أبو يعلى، قال: ثنا أبو معمر، قال: ثنا أبو الأحوص، عن الأشعث بن سليم، عن الأسود بن هلال، وعن سماك، عن بشر بن قحيف، عن المغيرة بن شعبة، أن النبي صلى الله عليه وسلم " توضأ ومسح على خفيه "(@)(@@)(@@)(@@) ||| AUTO بشر بن دينار(@)(@@) يروي عن: أنس بن مالك، روى عنه: ليث بن أبي سليم ومحمد بن عثمان.(@)(@@)(@@)(@@) ||| AUTO بشر بن عروة(@)(@@) يروي عن: ابن أبي أوفى، روى عنه: الحسن بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO بشر بن سعيد ويقال سعد الكندي شامي(@)(@@) يروي عن: واثلة بن الأسقع، وأبي أمامة، روى عنه معاوية بن صالح، مات سنة مائة وكان مولده في سنة اثنتين وعشرين.(@)PageV01P002(@)(@@) [ج 2: ص 41](@)(@@)(@@)(@@) ||| AUTO بشر بن بشير بن معبد الأسلمي(@)(@@) روى عنه ابنه محمد.(@)(@@)(@@)(@@) ||| AUTO بشر بن حيان الخشني(@)(@@) يروي عن: واثلة بن الأسقع، روى عنه: الحسن بن يحيى الخشني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بشير بن زيد(@)(@@) شيخ قديم أدرك الجاهلية، يروي المراسيل، روى عنه: الأشهب الضبعي.(@)(@@)(@@)(@@) ||| AUTO بشير بن أبي مسعود الأنصاري(@)(@@) مدني، يروي عن: أبيه، روى عنه: عروة بن الزبير.(@)(@@)(@@)(@@) ||| AUTO بشير بن نهيك أبو الشعثاء(@)(@@) يروي عن: أبي هريرة، وهو سدوسي من أهل البصرة عن: بشر بن الخصاصية، وله صحبة، روى عنه: خالد بن سمير، كأنه أبو الشعثاء الذي ذكرناه.(@)(@@)(@@)(@@) ||| AUTO بشير بن سلمان(@)(@@) مولى صفية بنت عبد الرحمن، عن: جابر بن عبد الله، روى عنه: ابنه حسين بن بشير.(@)(@@)(@@)(@@) ||| AUTO بشير بن النعمان بن بشير(@)(@@) يروي عن: أبيه، روى عنه: أولاده وأهل المدينة.(@)(@@) بشير بن زيد(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: السدي.(@)(@@)(@@)(@@) ||| AUTO بشير بن أبي بشير(@)(@@) مولى الزبير بن العوام، يروي عن: جابر بن عبد الله، روى عنه: محمد بن إسحاق.(@)PageV01P002(@)(@@) [ج 2: ص 42](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بشير الأودي(@)(@@) يروي عن: ابن مسعود، روى عنه: الشيباني، عن عطاء البزاز.(@)(@@)(@@)(@@) ||| AUTO بشير بن سلمان(@)(@@) مولى صفية بنت عبد الرحمن، يروي عن: جابر بن عبد الله وابن الزبير، روى 
ms455	 عنه ابنه الحسين بن بشير بن سلمان وكأنه ذلك الأول.(@)(@@)(@@)(@@) ||| AUTO بشير بن كعب بن عجرة الأنصاري(@)(@@) يروي عن: أبيه، روى عنه: ابنه أبو بكر بن بشير.(@)(@@)(@@)(@@) ||| AUTO بشير بن عبد الرحمن بن كعب بن مالك الأنصاري(@)(@@) يروي عن: جده كعب بن مالك، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO بشير بن غالب الأسدي(@)(@@) يروي عن: علي، روى عنه: محمد بن قيس الأسدي.(@)(@@) بشير(@)(@@) مولى معاوية، يروي عن: عشرة من أصحاب النبي صلى الله عليه وسلم روى معاوية بن صالح، عن أبي عمرو الأسدي عنه.(@)(@@)(@@)(@@) ||| AUTO بشير السلمي(@)(@@) روى المراسيل، روى عنه: ابنه رافع بن بشير، ومن زعم أن له صحبة فقد وهم.(@)(@@)(@@)(@@) ||| AUTO بشير بن محرز(@)(@@) من التابعين، روى عنه: ابنه عمران.(@)(@@)(@@)(@@) ||| AUTO بشير بن الغوث العنزي(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: سوار بن ميمون.(@)(@@)(@@)(@@) ||| AUTO بشير بن كعب أبو أيوب العدوي(@)(@@) يروي عن: أبي ذر، وأبي الدرداء، روى عنه: العلاء بن زياد، وطلق بن حبيب.(@)PageV01P002(@)(@@) [ج 2: ص 43](@)(@@)(@@)(@@) ||| AUTO بشير بن يسار المدني(@)(@@) مولى الأنصار، يروي عن: أنس، وسويد بن النعمان، وأبي بردة بن نيار، وسهل بن أبي حثمة، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO بشير بن أبي كيسان(@)(@@) من بني حارثة، يروي عن: سهل بن أبي حثمة، روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO بكر بن عبد الله بن عمرو بن هلال المزني البصري(@)(@@) من مضر كنيته أبو عبد الله أدرك ثلاثين من فرسان مزينة منهم عبد الله بن مغفل، ومعقل بن يسار، ويروي عن ابن عمر، وأنس، وكان عابدا فاضلا مات سنة ست ومائة، وقد قيل سنة ثمان ومائة، وهو والد عبد الله بن بكر المزني، روى عنه: سليمان التيمي، وحميد الطويل، وهو أخو علقمة بن عبد الله المزني.(@)(@@)(@@)(@@) ||| AUTO بكر بن قيس أبو الصديق الناجي البصري(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: ثابت البناني مات سنة ثمان ومائة، وقد قيل بكر بن عمرو.(@)(@@)(@@)(@@) ||| AUTO بكر بن أبي الفرات(@)(@@) مولى أشجع، يروي عن: أبي هريرة، روى 
ms456	 عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO بكر بن زرعة الخولاني الشامي(@)(@@) يروي عن: أبي عنبة الخولاني، روى عنه: الجراح بن مليح البهراني(@)(@@) (97) -[2: 43] الصوفي، قال: ثنا الهيثم بن خارجة، قال: ثنا الجراح بن مليح البهراني، قال: سمعت بكر بن زرعة الخولاني، قال: سمعت أبا عنبة الخولاني وهو من أصحاب النبي صلى الله عليه وسلم ممن صلى القبلتين كلتيهما، وأكل الدم في الجاهلية، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: " لا يزال الله يغرس في هذا الدين غرسا يستعملهم بطاعته "(@)PageV01P002(@)(@@) [ج 2: ص 44](@)(@@)(@@)(@@) ||| AUTO بكر بن قرواش(@)(@@) يروي عن: أبي الطفيل، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO بكر بن عبد الرحمن المزني(@)(@@) يروي عن: عبد الله بن عمرو بن هلال المزني وله صحبة، روى عنه: جعفر بن ربيعة وكثير بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO بكر بن سوادة الجذامي(@)(@@) يروي عن: عبد الله بن عمرو عداده في أهل مصر، روى عنه: أهلها، مات في زمن هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO بكير بن عطاء الليثي كوفي(@)(@@) يروي عن: عبد الرحمن بن يعمر الدئلي وله صحبة، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO بكير بن الأخنس(@)(@@) يروي عن: أنس بن مالك، روى عنه: مسعر بن كدام إن كان سمع منه.(@)(@@)(@@)(@@) ||| AUTO بكير بن فيروز(@)(@@) يروي عن: أبي هريرة، روى عنه: يزيد بن سنان.(@)(@@)(@@)(@@) ||| AUTO بكير بن وهب الجزري(@)(@@) يروي عن: أنس بن مالك، روى عنه: سهل أبو أسد الحنفي.(@)(@@)(@@)(@@) ||| AUTO بكار بن سلام الغنوي ويقال العتري(@)(@@) يروي عن: علي، روى عنه: محمد بن قيس.(@)(@@)(@@)(@@) ||| AUTO بكار بن عثمان(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: موسى بن شيبة.(@)PageV01P002(@)(@@) [ج 2: ص 45](@)(@@)(@@)(@@) ||| AUTO البراء بن قيس أبو كبشة السكوني(@)(@@) عداده في أهل الكوفة، يروي عن: حذيفة، وسعد، روى عنه الناس.(@)(@@)(@@)(@@) ||| AUTO البراء بن ناجية الكاهلي(@)(@@) يروي عن: ابن مسعود، روى عنه: ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO البراء بن زيد(@)(@@) ابن ابنة أنس بن مالك، روى عنه: عبد الكريم.(@)(@@)(@@)(@@) ||| AUTO البراء السليطي(@)(@@) يروي عن: نقادة الأسدي، عداده في البصريين، روى عنه: سيار بن سلامة. 
ms457	(@)(@@)(@@)(@@) ||| AUTO البختري بن المختار(@)(@@) يروي عن: علي، روى عنه: وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO البختري بن أبي البختري(@)(@@) يروي المراسيل، روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO البختري بن عزرة(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO البختري الأنصاري(@)(@@) يروي عن: براء بن عازب، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO بسر بن سعيد(@)(@@) مولى الحضرميين من أهل المدينة، يروي عن: أبي هريرة، وزيد بن خالد، وقد جالس سعد بن أبي وقاص، روى عنه: يزيد بن خصيفة، PageV01P002 [ج 2: ص 46] وأهل المدينة، مات سنة مائة وهو ابن ثمان وسبعين سنة، وكان ينزل في دار الحضرميين في جديلة، فنسب إليهم، وكان متعبدا متخليا، مات ولم يخلف كفنا يكفن به حتى كفنه الناس.(@)(@@)(@@)(@@) ||| AUTO بسر بن محجن الديلي(@)(@@) عن: أبيه عداده في أهل الحجاز، روى عنه: زيد بن أسلم، ومن قال: بشر فقد وهم.(@)(@@)(@@)(@@) ||| AUTO بيان بن بشر الأحمسي، كنيته أبو بشر المعلم(@)(@@) من أهل الكوفة، يروي عن: أنس بن مالك، روى عنه: الثوري، وشعبة، والناس.(@)(@@)(@@)(@@) ||| AUTO بيان بن جندب أبو سعيد الرقاشي البصري(@)(@@) يروي عن: أنس بن مالك، روى عنه: شعبة والمعتمر بن سليمان، يخطئ.(@)(@@)(@@)(@@) ||| AUTO بلاد بن عصمة(@)(@@) يروي عن: ابن مسعود: شر الأمور محدثاتها، روى عنه: أسلم المنقري.(@)(@@)(@@)(@@) ||| AUTO باباه(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ابنه عبد الله بن باباه.(@)(@@)(@@)(@@) ||| AUTO البهي(@)(@@) شيخ يروي عن: عمر، روى عنه: ابنه يحيى بن البهي.(@)(@@)(@@)(@@) ||| AUTO بيهس بن صبيرة(@)(@@) يروي عن: أبي هريرة، روى عنه: العرس بن عميرة.(@)(@@)(@@)(@@) ||| AUTO برد(@)(@@) مولى آل الزبير بن العوام، يروي عن: ابن الزبير، روى عنه: جويرية بن أسماء.(@)PageV01P002(@)(@@) [ج 2: ص 47](@)(@@)(@@)(@@) ||| AUTO باب ابن عمير الحنفي(@)(@@) من أهل اليمامة، يروي عن: أنس بن مالك، روى عنه: يحيى بن أبي كثير والأوزاعي وليس هو بجد عمرو بن عبيد.(@)(@@)(@@)(@@) ||| AUTO بسطام(@)(@@) شيخ يروي عن: ابن عمر، روى عنه: ابن عون.(@)(@@)(@@)(@@) ||| AUTO بريدة بن سفيان الأسلمي(@)(@@) روى قصة زيد بن الدثنة، وخبيب بن عدي، روى عنه: عبد الرحمن بن 
ms458	 عبد الله الزهري، وقد قيل إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO بحير بن ريسان(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: أبو سفيان رجل من أهل الشام.(@)(@@)(@@)(@@) ||| AUTO بحير بن ذاخر(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: ابن لهيعة.(@)(@@)(@@)(@@) ||| AUTO بحير بن أوس(@)(@@) يروي المراسيل، روى عنه: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO بدر بن خالد كوفي(@)(@@) يروي عن: عثمان بن عفان، روى عنه: أبو الجويرية.(@)(@@)(@@)(@@) ||| AUTO بجير بن أبي بجير(@)(@@) حجازي يروي عن: عبد الله بن عمرو، روى عنه: إسماعيل بن أمية.(@)(@@)(@@)(@@) ||| AUTO بجير بن سالم أبو عبيد(@)(@@) يروي عن: ابن عمر، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO بجير بن أحمر(@)(@@) يروي عن: ابن عباس، روى عنه: الجريري، وعمران بن حدير.(@)(@@)(@@)(@@) ||| AUTO بريد بن أبي مريم السلولي(@)(@@) واسم أبي مريم مالك بن ربيعة، يروي عن: أنس، PageV01P002 [ج 2: ص 48] روى عنه: أبو إسحاق، وشعبة.(@)(@@)(@@)(@@) ||| AUTO بريد بن أصرم(@)(@@) يروي عن: علي، روى عنه: جعفر بن سليمان الضبعي، عن شيخ له عنه.(@)(@@)(@@)(@@) ||| AUTO بكتل الخولاني بصري(@)(@@) يروي عن: ابن عمر، روى عنه: عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO بابي مولى عباس بن عبد المطلب(@)(@@) يروي عن: العباس، روى عنه: القاسم بن العباس.(@)(@@)(@@)(@@) ||| AUTO بابي أبو عبد الله(@)(@@) مولى عائشة، يروي عن: سعد بن أبي وقاص، وعائشة، روى عنه: ابنه عبد الله بن بابي(@)(@@)(@@)(@@) ||| AUTO بديح(@)(@@) مولى عبد الله بن جعفر، يروي عن: عبد الله بن جعفر، روى عنه: عيسى بن عمر بن موسى.(@)(@@)(@@)(@@) ||| AUTO بجالة بن عبد(@)(@@) ويقال: ابن عبدة، كان كاتبا لجزي بن معاوية، يروي عن: عمران بن حصين، روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO بركة بن الوليد أبو الوليد المجاشعي(@)(@@) يروي عن: ابن عباس، روى عنه: خالد الحذاء.(@)(@@)(@@)(@@) ||| AUTO برير بن ضمرة الباهلي(@)(@@) يروي عن: ابن عباس، روى عنه: حاتم بن أبي صغيرة، ومن زعم أنه بريد فقد وهم.(@)PageV01P002(@)(@@) [ج 2: ص 49](@)(@@)(@@)(@@) ||| AUTO بركان أبو صالح(@)(@@) مولى عثمان بن عفان، يروي عن: أبي هريرة، روى عنه: أبو عقيل.(@)(@@)(@@)(@@) ||| AUTO بعجة بن عبد الله بن 
ms459	 بدر الجهني(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي كثير، وأبو حازم، وكان يقيم مدة بالبادية ومدة بالمدينة، ومات بالمدينة قبل القاسم بن محمد سنة مائة.(@)(@@)(@@)(@@) ||| AUTO بكرة بنت عقبة(@)(@@) تروي عن: عائشة، روى عنها: معلى بن زياد القطعي.(@)(@@)(@@)(@@) || AUTO باب التاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن الصحابة من التابعين ممن ابتدأ اسمه على التاء:(@)(@@)(@@)(@@) ||| AUTO تمام بن العباس بن عبد المطلب الهاشمي(@)(@@) يروي عن: أبيه، روى عنه: ابنه جعفر بن تمام.(@)(@@)(@@)(@@) ||| AUTO تميم بن طرفة الطائي الكوفي المسلي(@)(@@) يروي عن: عدي بن حاتم، وجابر بن سمرة، روى عنه: سماك بن حرب، والمسيب بن رافع، مات سنة ثلاث أو أربع وتسعين.(@)(@@)(@@)(@@) ||| AUTO تميم بن حذلم الضبي، كنيته أبو سلمة(@)(@@) من أهل الكوفة، يروي عن: أبي بكر، PageV01P002 [ج 2: ص 50] وعمر، روى عنه: العلاء بن بدر، وقد قيل: كنيته أبو حذلم.(@)(@@)(@@)(@@) ||| AUTO تميم بن نذير العدوي أبو قتادة البصري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: حميد بن هلال.(@)(@@)(@@)(@@) ||| AUTO تميم بن مسيح الذهلي الغطفاني(@)(@@) يروي عن: علي، روى عنه: الناس.(@)(@@)(@@)(@@) ||| AUTO تميم بن غيلان بن سلمة الثقفي(@)(@@) يروي عن: عبد الرحمن بن عوف، وأبي الدرداء، روى عنه: ابن جريج، ويعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO تميم بن سلمة الكوفي السلمي(@)(@@) وقيل: الخزاعي، يروي عن: عبد الله بن الزبير، روى عنه: الأعمش، مات سنة مائة في خلافة عمر بن عبد العزيز، وهو الذي يروي عن: عبد الرحمن بن هلال، عن جرير.(@)(@@)(@@)(@@) ||| AUTO تميم بن سلمة الخزاعي كوفي(@)(@@) يروي عن: جابر بن سمرة، روى عنه: المسيب بن رافع، وهو الذي يروي عن: عروة بن الزبير، وليس هذا بالأول.(@)(@@)(@@)(@@) ||| AUTO تميم بن حويص الأزدي(@)(@@) يروي عن: ابن عباس عداده في أهل البصرة، روى عنه: شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO تميم بن عبد الله البصري(@)(@@) يروي عن: أبي ذر، روى عنه: ابنه شريك بن تميم.(@)(@@)(@@)(@@) ||| AUTO تميم بن فرع المهري(@)(@@) من أهل مصر، يروي عن: عمرو بن العاص، روى عنه: حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO تميم 
ms460	 بن محمود(@)(@@) يروي عن: عبد الرحمن بن شبل، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 51] جعفر بن عبد الله بن الحكم والد عبد الحميد بن جعفر.(@)(@@)(@@)(@@) ||| AUTO تميم بن عبد الرحمن(@)(@@) يروي عن: عدي بن حاتم، روى عنه: أرطأة بن الحسين الهنائي وقد قيل: إنه تميم بن عبد المؤمن.(@)(@@)(@@)(@@) ||| AUTO تميم بن مسيح الغطفاني(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: ذهل بن أوس.(@)(@@)(@@)(@@) ||| AUTO تميم بن يزيد(@)(@@) مولى بني زمعة، يروي عن: أنس بن مالك، روى عنه: عثمان بن حكيم.(@)(@@)(@@)(@@) ||| AUTO تميم بن أوس الأشعري(@)(@@) يروي عن: عبد الله بن بسر، روى عنه: أهل الشام مات في ولاية هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO تميم بن ذهل الضبي(@)(@@) من بني مبذول، أدرك الجمل، روى عنه: خالد بن مجاهد بن حيان.(@)(@@)(@@)(@@) ||| AUTO تبيع الحجري(@)(@@) يروي عن: عبد الرحمن بن عدس، البلوى، وقد قيل: عديس، وله صحبة، روى عنه: عبد الرحمن بن شماسة.(@)(@@)(@@)(@@) ||| AUTO توبة بن كيسان الباهلي العنبري(@)(@@) بصري، يروي عن: أنس بن مالك، روى عنه: شعبة ومطيع بن راشد.(@)(@@)(@@)(@@) ||| AUTO تعلى أبو عبيد(@)(@@) يروي عن: عبد الرحمن بن خالد بن الوليد، روى عنه: ابنه عبيد بن تعلى من حديث بكير بن الأشج عنه.(@)(@@)(@@)(@@) ||| AUTO تملك الخارفية(@)(@@) امرأة تروي عن: أم سلمة، روى عنها: أبو إسحاق السبيعي،(@)(@@) (98) -[2: 51] حدثنا أبو خليفة، قال: ثنا محمد بن كثير، قال: ثنا سفيان الثوري، عن أبي إسحاق، عن تملك الخارفية، عن أم سلمة، أنها قالت: " ضع سكينا وسم الله وكل ". تعني الجبن PageV01P002 [ج 2: ص 52](@)(@@)(@@)(@@) || AUTO باب الثاء(@)(@@) قال أبو حاتم:(@)(@@) وممن عن الصحابة وشافههم من التابعين ممن ابتدأ اسمه على الثاء:(@)(@@)(@@)(@@) ||| AUTO ثابت بن أسلم البناني البصري أبو محمد(@)(@@) يروي عن: ابن عمر، وابن الزبير، وصحب أنسا أربعين سنة، وكان من أعبد أهل البصرة، وبنانة الذي نسب إليه وهو بنانة بن سعد بن لؤي بن غالب، روى عنه: الناس، مات سنة سبع وعشرين ومائة وهو ابن ست وثمانين سنة وقد قيل: إنه مات سنة ثلاث وعشرين ومائة، ويقال: 