ms241	 حتى يخرجوا من منزله ، وطاعته واجبة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P326(@)(@@)(@@)(@@) $ ( 2233 ) قال النبي :(@)(@@) | 30 ( إذا دخلت على أخيك المسلم فكل من طعامه ولا تسأله واشرب من شرابه ولا تسأله ) )(@)(@@) ( ع ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2234 ) قال النبي :(@)(@@) | 30 ( إذا دخلت منزلك فصل ركعتين تمنعانك مدخل السوء ، وإذا خرجت من منزلك فصل ركعتين تمنعانك مخرج السوء ) )(@)(@@) ( ز ) عن أبي هريرة رضي الله عنه وحسن .(@)(@@)(@@)(@@) $ ( 2235 ) قال النبي :(@)(@@) | 30 ( إذا دخلت المسجد فصل ركعتين قبل أن تجلس ) )(@)(@@) ( ش ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2236 ) قال النبي :(@)(@@) | 30 ( إذا دخلتم بيوتكم فسلموا على أهلها ، وإذا أطعمتم فإذكروا اسم الله ، وإذا سلم أحدكم حين يدخل بيته وذكر اسم الله على طعامه يقول الشيطان لأصحابه : لا مبيت لكم ولا عشاء ، وإذا لم يسلم أحدكم ولم يذكر اسم الله على طعامه يقول الشيطان لأصحابه أدركتم المبيت والعشاء ) )(@)(@@) ( ك ) ويعقب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2237 ) قال النبي :(@)(@@) | 30 ( إذا دخلتم الغائط فقولوا : بسم الله أعوذ بالله من الخبث والخبائث ) )(@)(@@) المعمري في عمل اليوم والليلة عن أنس رضي الله عنه وصحح .(@)(@@)(@@)(@@) $ ( 2238 ) قال النبي :(@)(@@) | 30 ( إذا دعا أحدكم فليعظم الرغبة فإنه لا يتعاظم على الله شيء ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2239 ) قال النبي :(@)(@@) | 30 ( إذا دعا الرجل لأخيه بظهر الغيب ، قالت الملائكة : ولك بمثله ) )(@)(@@) ( م ) عن أم الدرداء الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2240 ) قال النبي :(@)(@@) | 30 ( إذا دعا العبد فأشار باصبعه قال الله : أخلص عبدي ) )(@)(@@) الديلمي عن أنس رضي الله عنه(@)(@@) PageV01P327(@)(@@)(@@)(@@) $ ( 2241 ) قال النبي :(@)(@@) | 30 ( إذا دعا الرجل المسلم بطهوره فغسل وجهه سقطت خطايا وجهه من أطراف لحييه ، وإذا غسل يديه سقطت خطايا يديه من أنامله وأظفاره ، فإذا مسح رأسه سقطت خطايا رأسه من أطراف شعره ، فإذا غسل رجليه سقطت خطايا رجليه من بطون قدميه ، فإن انطلق فصلى في جماعة فقد وقع أجره على الله ، وإن صلى ركعتين يخلص فيهما نيته 
ms242	 لله فهو كفارته ) )(@)(@@) ( ص ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2242 ) قال النبي :(@)(@@) | 30 ( إذا دعاك الداعيان فأجب أقربهما بابا ، فإن أقربهما بابا أقربهما جوارا ، وإن سبق أحدهما فأجب الذي سبق ) )(@)(@@) ابن النجار عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 2243 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم القملة فلا يقتلها في المسجد ولاكن ليصرها في ثوبه فإذا خرج فليقتلها ) )(@)(@@) عبد الرزاق عن يحيى بن أبي كثير بلاغا .(@)(@@)(@@)(@@) $ ( 2244 ) قال النبي :(@)(@@) | 30 ( إذا ذكرها فليصلها وليحسن صلاته وليتوضأ فليحسن وضوءه فذالك كفارته ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2245 ) قال النبي :(@)(@@) | 30 ( إذا ذهب أحدكم إلى الخلاء فلا يستقبل القبلة ولا يستدبرها ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2246 ) قال النبي :(@)(@@) | 30 ( إذا ذهب أحدكم إلى الغائط والبول فلا يستقبل القبلة ولا يستدبرها بفرجه ) )(@)(@@) مالك والشافعي ( طب هق ) في المعرفة عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2247 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم من فضل عليه في الخلق والرزق فلينظر إلى من هو أسفل منه ممن فضل هو عليه ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2248 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم في منامه ما يكره فلينفث عن يساره ثلاثا وليستعذ مما رأى ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@) PageV01P328(@)(@@)(@@)(@@) $ ( 2249 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم أحدا في بلاء فليقل الحمد لله الذي عافاني مما ابتلاه به وفضلني على كثير من عباده تفضيلا ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2250 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم في منامه ما يكره فليقل : أعوذ بما عاذت به ملائكة الله ورسله مما رأيت في منامي هاذا أن يصيبني بلاء في الدنيا والآخرة ، وليتفل عن شماله ثلاثا فإنها لا تضره إن شاء الله تعالى ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2251 ) قال النبي :(@)(@@) | 30 ( إذا رأت الماء فلتغتسل ) )(@)(@@) ( ن ) عن خولة بنت حكيم قالت : سئل رسول الله عن المرأة تحتلم في منامها قال فذكره ( ه ) عن زينب بنت أم 
ms243	 سلمة ( طس ) عن سهلة بنت سهيل وعن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 2252 ) قال النبي :(@)(@@) | 30 ( إذا رأت الماء الأصفر فلتغتسل ) )(@)(@@) ( حم طب ) عن أم سلمة قالت أم سليم رضي الله عنهما يا رسول الله المرأة تحتلم قال فذكره .(@)(@@)(@@)(@@) $ ( 2253 ) قال النبي :(@)(@@) | 30 ( إذا رأيت أخاك مصلوبا أو مقتولا فصل عليه ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2254 ) قال النبي :(@)(@@) | 30 ( إذا رأيت رجلين من أمتي يقتتلان على المال فأعد عند ذالك سيفا من خشب ) )(@)(@@) ( طب ) عن عديسة بنت أهبان رضي الله عنه بن صيفي الغفاري عن أبيهما .(@)(@@)(@@)(@@) $ ( 2255 ) قال النبي :(@)(@@) | 30 ( إذا رأيت الأخوين المسلمين يختصمان في شبر من أرض فاخرج من تلك الأرض ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2256 ) قال النبي :(@)(@@) | 30 ( إذا رأيت البناء قد بلغ سلعا فأغن بالشام فإن لم PageV01P329 تستطع فاسمع وأطع ) )(@)(@@) ابن منده ( كر ) عن أبي أسيد الأنصاري رضي الله عنه ، وقال ( كر ) فاغن يعني : أقم ، قال : وفي رواية : فالحق بالشام .(@)(@@)(@@)(@@) $ ( 2257 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الذين يتبعون ما تشابه منه فأولائك الذين سمى الله ، فاحذروهم ) )(@)(@@) ( حم خ م د ت ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2258 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل يعتاد المساجد فاشهدوا له بالإيمان فإن الله يقول : إنما يعمر مساجد الله من آمن بالله واليوم الآخر ) )(@)(@@) ( حم ) و عبد بن حميد والدارمي ( ت ) حسن غريب ( ه ) وابن خزيمة ( حب ك حل هق ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2259 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم مسجدا أو سمعتم مؤذنا فلا تقتلوا أحدا ) )(@)(@@) ( حم د ) عن ابن عصام المزني عن أبيه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2260 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم معاوية وعمرو بن العاص جميعا ففرقوا بينهما ) )(@)(@@) ( طب ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2261 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم شيئا من هاذه الآيات فإنما هو تخويف من الله ، فإذا رأيتموها فصلوا مثل أحدث صلاة صليتموها ) )(@)(@@) ( طب ) عن قبيصة بن مخارق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2262 
ms244	 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل يلزم المسجد فلا تحرجوا أن تشهدوا أنه مؤمن فإن الله تعالى يقول : إنما يعمر مساجد الله من آمن بالله ) )(@)(@@) ( ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2263 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم أهل الجوع والتفكر فاقتربوا منهم فإنه PageV01P330 تجري الحكمة معهم ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2264 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم شابا يأخذ بزي المسلم بتقصيره وتشميره فذاك من خياركم ، وإذا رأيتم الشيخ الطويل الشاربين يسحب ثيابه فذاك من شراركم ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2265 ) قال النبي :(@)(@@) | 30 ( إذا رجعت إلى بيتك فمرهم فليحسنوا غذاء رباعهم ومرهم فليقلموا أظفارهم ولا يخدشوا بها ضروع مواشيهم إذا حلبوا ) )(@)(@@) ( حم ) و ابن سعد والبغوي والباوردي ( طب هق ض ) عن سوادة بن الربيع الجرمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2266 ) قال النبي :(@)(@@) | 30 ( إذا رفع الإمام رأسه من الركعة الرابعة وأحدث فقد تمت صلاة من خلفه ) )(@)(@@) ابن جرير عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2267 ) قال النبي :(@)(@@) | 30 ( إذا رعف أحدكم في الصلاة أو ذرعه القيء فإن كان قلسا يغسله أو وجد مذيا فلينصرف فليتوضأ ثم يرجع إلى ما بقي من صلاته ولا يستقبلها جديدا وهو مع ذالك لا يتكلم حتى يرجع إلى ما بقي من صلاته ) )(@)(@@) ( طب ) عن ابن جريج عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 2268 ) قال النبي :(@)(@@) | 30 ( إذا رقدت فأغلق بابك ، وأوك سقاءك ، وخمر إناءك ، واطف مصابحك فإن الشيطان لا يفتح بابا ، ولا يحل وكاء ، ولا يكشف غطاء ، وإن الفأرة الفويسقة تحرق على أهل البيت بيتهم ، ولا تأكل بشمالك ، ولا تشرب بشمالك ، ولا تمم في نعل واحدة ، ولا تشتمل الصماء ، ولا تحتب في الدار مغضبا ) )(@)(@@) ( حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2269 ) قال النبي :(@)(@@) | 30 ( إذا ركب العبد الدابة فلم يذكر اسم الله ردفه PageV01P331 الشيطان وقال : تغن ، فإن كان لا يحسن الغناء قال له : تمن ، فلا يزال في أمنيته حتى ينزل ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2270 
ms245	 ) قال النبي :(@)(@@) | 30 ( إذا ركب الناس الخيل ولبسوا القباطي ، وتولوا الشام ، واكتفى الرجال بالرجال ، وال نس اء بالنساء عمهم الله بعقوبة من عنده ) )(@)(@@) ( عد كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2271 ) قال النبي :(@)(@@) | 30 ( إذا ركع أحدكم فليضع يديه على ركبتيه ، ثم يمكث حتى يطمئن كل عظم في مفاصله ، ثم سبح ثلاث مرات فإنه يسبح لله من جسده ثلاثة وثلاثون وثلاثمائة عظم ، وثلاثة وثلاثون وثلاثمائة عرق ، وإذا سجد فليسبح ثلاثا فإنه يسبح من جسده مثل ذالك ) )(@)(@@) الديلمي وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2272 ) قال النبي :(@)(@@) | 30 ( إذا ركعت فضع يديك على ركبتيك وفرج بين أصابعك ) )(@)(@@) عبد الرزاق عن القاسم بن أبي بزة عن رجل .(@)(@@)(@@)(@@) $ ( 2273 ) قال النبي :(@)(@@) | 30 ( إذا رضي الرجل عمل الرجل وهديه وسمته فإنه مثله ) )(@)(@@) ابن النجار والرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2274 ) قال النبي :(@)(@@) | 30 ( إذا رفعت رأسك من السجود فلا تقع كما يقعي الكلب ، ضع إلييك بين قدميك والزق ظاهر قدميك بالأرض ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2275 ) قال النبي :(@)(@@) | 30 ( إذا رقدتم فأطفئوا المصابيح وأوكئوا السقاء ) )(@)(@@) أبو عوانة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2276 ) قال النبي :(@)(@@) | 30 ( إذا ركع أحدكم فليقل : اللهم لك ركعت وبك آمنت ) )(@)(@@) الحسن بن سفيان عن ربيعة بن الحارث بن نوفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2277 ) قال النبي :(@)(@@) | 30 ( إذا رمى الرجل جمرة العقبة وحلق رأسه فقد حل له PageV01P332 كل شيء إلا النساء ) )(@)(@@) ( قط ) في الأفراد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2278 ) قال النبي :(@)(@@) | 30 ( إذا رميتم الجمرة فقد حل لكم كل شيء إلا النساء ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2279 ) قال النبي :(@)(@@) | 30 ( إذا زنت أمة أحدكم فليجلدها ثلاثا بكتاب الله ، فإن عادت فليبعها ولو بحبل من شعر ) )(@)(@@) ( ت ) حسن صحيح عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2280 ) قال النبي :(@)(@@) | 30 ( إذا زنت أمة أحدكم فليجلدها ولا يثرب عليها فإن عادت فليجلدها ، فإن عادت فليبعها ولو بضفير من شعر ) )(@)(@@) ( ش ) عن أبي هريرة 
ms246	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2281 ) قال النبي :(@)(@@) | 30 ( إذا زنت أمة أحدكم فليجلدها ولا يعيرها ولا يفندها ، ثم إذا زنت فليجلدها ولا يعيرها ولا يفندها ، ثم إذا زنت الثالثة فليبعها ولو بحبل من شعر ) )(@)(@@) ( عب ) و ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2282 ) قال النبي :(@)(@@) | 30 ( إذا زوج المرأة الوليان فهي للأول منهما ) )(@)(@@) ( ت ن ه ) عن سمرة بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2283 ) قال النبي :(@)(@@) | 30 ( إذا سأل أحدكم جاره أن يدعم جذعه على حائطه فلا يمنعه ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2284 ) قال النبي :(@)(@@) | 30 ( إذا سألتم الله تعالى فاسألوه الفردوس فإنه سر الجنة ، يقول الرجل منكم الداعية لراعيه : عليك بسر الوادي فإنه أمرعه وأعشبه ) )(@)(@@) ( طب ) عن العرباض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2285 ) قال النبي :(@)(@@) | 30 ( إذا سألتم الله فاعزموا فإن الله لا مستكره له ) )(@)(@@) ( ش ) PageV01P333 عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2286 ) قال النبي :(@)(@@) | 30 ( إذا سألتم الله فاسألوه ببطون أكفكم ثم لا تردوها حتى تمسحوا بها وجوهكم فإن الله جاعل فيها بركة ) )(@)(@@) ابن نصر عن الوليد بن عبد الله بن أبي مغيث مرسلا .(@)(@@)(@@)(@@) $ ( 2287 ) قال النبي :(@)(@@) | 30 ( إذا سافرتم في الخصب فانزلوا عن ظهركم ) )(@)(@@) ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2288 ) قال النبي :(@)(@@) | 30 ( إذا سجد أحدكم فلا يبرك كما يبرك الجمل وليضع يديه على ركبتيه ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2289 ) قال النبي :(@)(@@) | 30 ( إذا سجد أحدكم فليبدأ بركبتيه قبل يديه ولا يبرك بروك الجمل ) )(@)(@@) ( ش هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2290 ) قال النبي :(@)(@@) | 30 ( إذا سقطت لقمة أحدكم فليمسح عنها التراب وليسم الله وليأكلها ) )(@)(@@) الدارمي وأبو عوانة ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2291 ) قال النبي :(@)(@@) | 30 ( إذا سمع أحدكم النداء بالصلاة فكبر المنادي فيكبر ويشهد أن لا إلاه إلا الله ويشهد أن محمدا رسول الله فيشهد علاى ذالك . ويقول اللهم أعط سيدنا محمدا الوسيلة واجعل في العالمين درجته ، وفي المصطفين محبته ، وفي المقربين ذكره إلا وجبت 
ms247	 له الشفاعة مني يوم القيامة ) )(@)(@@) ابن السني عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2292 ) قال النبي :(@)(@@) | 30 ( إذا سمع أحدكم الإقامة فليأت وعليه السكينة فما أدرك فليصل وما فاته فليتم ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2293 ) قال النبي :(@)(@@) | 30 ( إذا سمعت مناديا فأجب وعليك السكينة والوقار والتسبيح والتكبير حتى تبلغ مصلاك ، فإن رأيت فرجة فتقدم ، وإن لم تر فرجة فلا تضيق على أخيك ، وإن قرأت فاقرأ ما تسمع أذنك ولا تؤذ جارك ، وصل صلاة PageV01P334 المودع ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2294 ) قال النبي :(@)(@@) | 30 ( إذا سمعت الإقامة فامم على هينتك ، فما أدركت فصل وما فاتك فاقض ) عبد الرزاق عن أنس رضي الله عنه ( صحيح ) .(@)(@@)(@@)(@@) $ ( 2295 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم المؤذن فقولوا كما يقول ثم صلوا على ) )(@)(@@) ( ش ) و أبو الشيخ في الأذان عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2296 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم بهاذا الوباء ببلد فلا تقدموا عليه ، وإذا وقع وأنتم به فلا تخرجوا فرارا منه ) )(@)(@@) ( طب ) عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2297 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم نهيق حمار أو نباح كلب ، أو صوت ديك بالليل فتعوذوا بالله من شر الشيطان فإنهن يرين ما لا ترون ) )(@)(@@) ابن السني في عمل يوم وليلة وعن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2298 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم الرجل يجهر بالقراءة نهارا فارجموه بالبعر ) )(@)(@@) الديلمي عن بريرة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2299 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم أصوات الديكة فإنها رأت ملكا فاسألوا الله وارغبوا إليه ، وإذا سمعتم نهاق الحمير فإنها رأت شيطانا فاستعيذوا بالله من شر ما رأت ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2300 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم الإقامة فامشوا إلى الصلاة وعليكم بالسكينة والوقار ولا تسرعوا فما أدركتم فصلوا وما فاتكم فأتموا ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2301 ) قال النبي :(@)(@@) | 30 ( إذا سمعتم بناس يأتون من قبل المشرق أو كودها يعجب الناس من ربهم فقد أظلت 
ms248	 الساعة ) )(@)(@@) نعيم بن حماد في الفتن عن حفصة رضي الله عنها .(@)(@@) PageV01P335(@)(@@)(@@)(@@) $ ( 2302 ) قال النبي :(@)(@@) | 30 ( إذا سميتم محمدا فلا تجبهوه ولا تحرموه ولا تقبحوه ، بورك في محمد وفي بيت فيه محمد وبمجلس فيه محمد ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2303 ) قال النبي :(@)(@@) | 30 ( إذا سهى أحدكم في صلاته فلم يدر أزاد أم نقص فليسجد سجدتين وهو جالس ثم يسلم ) )(@)(@@) ( هق ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2304 ) قال النبي :(@)(@@) | 30 ( إذا شبه على أحدكم الشيطان وهو في صلاته فقال أحدثت ، فليقل في نفسه كذبت ، حتى يسمع صوتا بأذنه أو يجد ريحا بأنفه ، وإذا صلى أحدكم فلم يدر أزاد أم نقص فليسجد سجدتين وهو جالس ) )(@)(@@) عبد الرزاق عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 2305 ) قال النبي :(@)(@@) | 30 ( إذا شتم أحدكم أخاه فلا يشتم عشيرته ولا أباه ولا أمه ، ولاكن ليقل إن كان يعلم ذالك إنك لبخيل ، وإنك لجبان ، وإنك لكذوب إن كان يعلم ذالك منه ) )(@)(@@) ابن السنى في عمل يوم وليلة عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 2306 ) قال النبي :(@)(@@) | 30 ( إذا شجاك شيطان أو سلطان فقل : يا من يكفي من كل أحد ولا يكفى منه أحد ، يا أحد من لا أحد له ، يا سند من لا سند له ، انقطع الرجاء إلا منك ، فكني مما أنا فيه ، وأعني على ما أنا عليه مما قد نزل بي ، بجاه وجهك الكريم ، وبحق محمد عليك ، آمين ) )(@)(@@) الديلمي عن عمر وعلي رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 2307 ) قال النبي :(@)(@@) | 30 ( إذا شرب الخمر فاجلدوه ، ثم إذا شرب فاجلدوه ، ثم إذا شرب فاجلدوه ، ثم إذا شرب الرابعة فاضربوا عنقه ) )(@)(@@) ( عب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2308 ) قال النبي :(@)(@@) | 30 ( إذا شربتم فاشربوا بثلاثة أنفاس : فالأول شكر PageV01P336 لشرابه ، والثانية شفاء في جوفه ، والثالثة مطردة للشيطان ، فإذا شربتم فمصوه مصا فإنه أجدر أن يجري مجراه ، وأنه أهنا وأمرأ ) )(@)(@@) الحكيم عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2309 ) قال النبي :(@)(@@) | 30 ( إذا شربوا الخمر فاجلدوهم ، ثم إن شربوها فاجلدوهم ، ثم 
ms249	 إن شربوها فاجلدوهم ، ثم إن شربوها فاقتلوهم ) )(@)(@@) ( حم د ه حب طب هق ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2310 ) قال النبي :(@)(@@) | 30 ( إذا شك أحدكم في الأمر فليسألني عنه ) )(@)(@@) ابن جرير ( طب ) عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2311 ) قال النبي :(@)(@@) | 30 ( إذا شك أحدكم في صلاته فلم يدر زاد أو نقص ، فإن كان شك في الواحدة والثنتين فليجعلهما واحدة حتى يكون الوهم في الزيادة ، ثم يسجد سجدتين وهو جالس قبل أن يسلم ، ثم يسلم ) )(@)(@@) ( ش ) عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2312 ) قال النبي :(@)(@@) | 30 ( إذا شهد الرجل بشهادتين قبلت الأولى وتركت الآخرة وأنزل بمنزلة الغلام ) )(@)(@@) ( عب ) عن ابن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 2313 ) قال النبي :(@)(@@) | 30 ( إذا صلى الرجل المسلم ثم جلس بعد الصلاة صلت عليه الملائكة ما دام في مصلاه ، وصلاتهم عليه : اللهم اغفر له ، اللهم ارحمه ، وإذا جلس ينتظر الصلاة صلت عليه الملائكة وصلاتهم عليه : اللهم اغفر له ، اللهم ارحمه ) )(@)(@@) ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2314 ) قال النبي :(@)(@@) | 30 ( إذا صلى العبد فلم يسأل الله الجنة قالت الجنة : يا ويح هاذا أما كان ينبغي له أن يسأل الله الجنة ، وإذا لم يتعوذ من النار قالت النار : يا ويح هاذا ، أما كان ينبغي له أن يتعوذ بالله من النار ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@) PageV01P337(@)(@@)(@@)(@@) $ ( 2315 ) قال النبي :(@)(@@) | 30 ( إذا صلى الإنسان على الجنازة فقد انقطع ذمامها إلا أن يشاء أن يتبعها ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2316 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلم يدر ثلاثا صلى أم أربعا ؟ فليصل ركعة وليسجد سجدتين قبل السلام ، فإن كانت ثالثة شفعتها السجدتان ، وإن كانت رابعة فالسجدتان ترغيم للشيطان ) ( حب ) عن أ$ بي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2317 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم المكتوبة فأراد أن يتطوع بشيء فليتقدم أو ليتأخر قليلا أو عن يمينه أو عن يساره ) )(@)(@@) ( عب ) عن عبد الرحمن بن سابط مرسلا ، وفيه ليث بن أبي سليم .(@)(@@)(@@)(@@) $ ( 2318 ) قال النبي :(@)(@@) | 30 
ms250	 ( إذا صلى أحدكم فقضى صلاته ثم قعد في مصلاه يذكر الله ، فهو في صلاة ، وإن الملائكة يصلون عليه يقولون : اللهم ارحمه واغفر له ، وإن هو دخل مصلاه ينتظر كان مثل ذالك ) )(@)(@@) ( ش ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 2319 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم ثم ثبت في مجلسه ينتظر الصلاة ، لم تزل الملائكة تصلي عليه ما كان في مجلسه ، اللهم اغفر له ، اللهم ارحمه ما لم يحدث أو يؤذ ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2320 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل إلى سترة ) )(@)(@@) عبد الرزاق عن ابن عيينة عن صفوان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2321 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل إلى سترة وليدن منها ، فإن الشيطان يمر بينه وبينها ) )(@)(@@) عبد الرزاق عن نافع بن جبير مرسلا .(@)(@@)(@@)(@@) $ ( 2322 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم الركعتين ركعتي الفجر قبل صلاة الصبح فليضطجع على جنبه الأيمن ) )(@)(@@) ( د ت ) حسن صحيح غريب ( حب هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2323 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليلبس نعليه أو ليخلعهما بين PageV01P338 رجليه ولا يؤذ بهما غيره ) )(@)(@@) ( حب ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2324 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم على جنازة ولم يمم معها فليقم لها حتى تغيب عنه ، وإن مشى معها فلا يقعد حتى توضع ) )(@)(@@) ابن عساكر والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2325 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يفرش ذراعه ربضة الكلب والسبع ) )(@)(@@) ابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2326 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يبصق بين يديه ولا عن يمينه ، وليبصق عن يساره أو تحت قدمه ) )(@)(@@) ( حم ع حب ض ) عن جابر ( ط ) عن أبي سعيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2327 ) قال النبي :(@)(@@) | 30 ( إذا صلى العبد في العلانية فأحسن في السر قال الله تعالى : أحسن عبدي ) )(@)(@@) الرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2328 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في رحله ثم أدرك الإمام ولم يصل 
ms251	 فليصل معه فإنها له نافلة ) )(@)(@@) عبد الرزاق ( د طب ك هق ) عن جابر بن يزيد بن الأسود عن أبيه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2329 ) قال النبي :(@)(@@) | 30 ( إذا صلى الرجل وليس بين يديه كآخرة الرحل أو كواسطة الرجل قطع صلاته الكلب الأسود والحمار ، قيل : ما بال الكلب الأسود من الأحمر ؟ قال : الكلب الأسود شيطان ) )(@)(@@) ( ت ) حسن صحيح عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2330 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يبزق بين يديه ولا عن يمينه ، ولاكن عن يساره أو تحت قدمه ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P339(@)(@@)(@@)(@@) $ ( 2331 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليقل : اللهم باعد بيني وبين خطيئتي كما باعدت بين المشرق والمغرب ، اللهم أعود بك أن تصد عني وجهك يوم القيامة ، اللهم نقني من خطيئتي كما نقيت الثوب الأبيض من الدنس ، اللهم أحيني مسلما وأمتني مسلما ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2332 ) قال النبي :(@)(@@) | 30 ( إذا صلى العبد في أول الوقت صعدت إلى السماء حتى تنتهي إلى العرش فتستغفر لصاحبها يوم القيامة تقول : حفظك الله كما حفظتني ، وإذا صلى في غير وقتها صعدت لا نور لها فتنتهي إلى السماء فتلف كما تلف الخرقة المبلولة فيضرب بها وجه صاحبها وتقول : ضيعك الله كما ضيعتني ) )(@)(@@) ابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2333 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يدع أحدا يمر بين يديه ) )(@)(@@) الشيرازي في الألقاب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2334 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم إلى شيء فليرهقه ) )(@)(@@) ( قط ) في الإفراد عن طل حة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2335 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فخلع نعليه فلا يخلعهما عن يمينه فيأتم بهما ، ولا من خلفه فيأتم بهما صاحبه ، ولكن ليجعلهما بين ركبتيه ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ 2336 قال النبي :(@)(@@) | 30 ( إذا صلى الرجل المكتوبة في البيت ثم أدرك جماعة فليصل معهم فتكون صلاته في بيته نافلة ) )(@)(@@) ( طب ) عن ابن أبي الخريف عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2337 
ms252	 ) قال النبي :(@)(@@) | 30 ( إذا صلى الناس الصبح فطوفي على بعيرك من وراء الصفوف ثم اخرجي ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2338 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلم يدر كم صلى ثلاثا أو أربعا PageV01P340 فليركع ركعة يحسن ركوعها وسجودها ثم يسجد سجدتين ) )(@)(@@) ( ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2339 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليلبس ثوبيه فإن الله عز وجل أحق من تزين له ، فإن لم يكن له إلا ثوب فليأتزر به إذا صلى ، ولا يشتمل أحدكم في صلاته اشتمال اليهود ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2340 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في رحله ثم جاء إلى الإمام فليصل معه ، وليجعل التي في بيته نافلة ) )(@)(@@) ( هق ) عن جابر بن يزيد عن أبيه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2341 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلم يدر أزاد أم نقص فليسجد سجدتين وهو جالس ثم يسلم ) )(@)(@@) ( ش هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2342 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يبصق أمامه ولا عن يمينه ، ولاكن عن يساره ، فإن لم يفعل فليبصق في طرف ثوبه ، وقال : هاكذا ، وعطف ثوبه فدلكه فيه ) )(@)(@@) عبد الرزاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2343 ) قال النبي :(@)(@@) | 30 ( إذا صلت المرأة خمسها وصامت شهرها ، وحفظت فرجها ، وأطاعت زوجها ، قيل لها ادخلي الجنة من أي أبواب الجنة شئت ) )(@)(@@) ( حب ) عن أبي هريرة ( حم ) عن عبد الرحمن بن عوف عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 2344 ) قال النبي :(@)(@@) | 30 ( إذا صليت الصبح فأقصر عن الصلاة حتى تطلع الشمس ، فإذا طلعت فلا تصل حتى ترتفع فإنها تطلع بين قرني شيطان ، وحينئد يسجد لها الكفار ، فإذا ارتفعت قدر رمح أو رمحين فصل ، فإن الصلاة مشهودة محضورة حتى يستقبل الرمح بالظل ، ثم أقصر عن الصلاة فإنها حينئذ تسجر جهنم ، فإذا فاء الفيء فصل فإن الصلاة مشهودة محضورة حتى تصلي العصر ، ثم أقصر عن PageV01P341 الصلاة حتى تغرب الشمس بين قرني شيطان ، وحيينئذ يسجد لها الكفار ) )(@)(@@) ( حم 
ms253	 طب ) ابن سعد عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2345 ) قال النبي :(@)(@@) | 30 ( إذا صليت وعليك ثوب واحد فإن كان واسعا فالتحف به ، وإن ضيقا فأتزر به ) )(@)(@@) ابن خزيمة ( حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2346 ) قال النبي :(@)(@@) | 30 ( إذا صليت فصل في نعليك ، فإن لم تفعل فضعهما تحت قدميك ولا تضعهما عن يمينك ولا عن يسارك فتؤذي الملائكة والناس ، وإذا وضعتهما بين يديك كأنما بين يديك قبلة ) )(@)(@@) الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2347 ) قال النبي :(@)(@@) | 30 ( إذا صليت بقوم فأقدرهم بأضعفهم ) )(@)(@@) الشيرازي في الألقاب عن عثمان بن أبي العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2348 ) قال النبي :(@)(@@) | 30 ( إذا صليت فسبح دبر كل صلاة ثلاثا وثلاثين ، واحمد ثلاثا وثلاثين ، وكبر أربعا وثلاثين ، وقل لا إلاه إلا الله وحده لا شريك له الملك وله الحمد وهو على كل شيء قدير ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2349 ) قال النبي :(@)(@@) | 30 ( إذا صليت في أهلك ثم جئت إلى المسجد فوجدت الناس يصلون فصل معهم واجعلها نافلة ) )(@)(@@) ( حم طب ك ) عن بشر بن محجن عن أبيه .(@)(@@)(@@)(@@) $ ( 2350 ) قال النبي :(@)(@@) | 30 ( إذا صليت الصبح فأقصر عن الصلاة حتى ترتفع الشمس فإنها تطلع من قرني شيطان ثم الصلاة محضورة متقبلة حتى ينتصف النهار فإذا انتصف النهار فأقصر عن الصلاة حتى تميل الشمس فإنه حينئذ تسعر جهنم ، وشدة الحر من فيح جهنم ، فإذا زالت الشمس فالصلاة مشهودة محضورة متقبلة حتى تصلي العصر ، فإذا صليت العصر فأقصر عن الصلاة حتى تغيب الشمس ، ثم الصلاة مشهودة محضورة متقبلة حتى تصلي الصبح ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P342(@)(@@)(@@)(@@) $ ( 2351 ) قال النبي :(@)(@@) | 30 ( إذا صليت فصل صلاة مودع ولا تتحدثن بكلام تعتذر منه عذرا ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2352 ) قال النبي :(@)(@@) | 30 ( إذا صليتم فاسألوا الله لي الوسيلة ، قيل : وما الوسيلة ؟ قال : أعلى درجة في الجنة لا ينالها إلا رجل واحد وأرجو أن أكون أنا هو ) )(@)(@@) عبد الرزاق ( حم ) عن 
ms254	 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2353 ) قال النبي :(@)(@@) | 30 ( إذا صليتم العصر اجتمعت ملائكة الليل والنهار ، فإذا قضيتم الصلاة صعدت ملائكة النهار ومكثت ملائكة الليل فإذا صليتم الفجر اجتمعوا معكم أيضا ، فإذا قضيتم الصلاة صعدت ملائكة الليل ومكثت ملائكة النهار ، فإذا أتوا الرب تبارك وتعالى سألهم وهو أعلم منهم فيقول : كيف تركتم عبادي ؟ فيقولون أتيناهم وهم يصلون وتركناهم وهم يصلون ، وفيهم عبد لك يعلم أنه لم يصب خيرا قط إلا بك ، ولم يصرف عنه سوء قط إلا بك ، فيقول : زيدوا عبدي ، ثم يتعاهدهم بالمسألة عنه فيقولون مثل ذالك ، فيقول : زيدوا عبدي ، فيقولون : ربنا انتهى المزيد ، فيقول : خوفوا عبدي فينقضوه فيبتلى ، ثم يسألهم عنه فيقول : كيف رأيتم عبدي عند البلاء ؟ فيقولون : ربنا أشكر عبد عند الرخاء ، وأصبره عند البلاء ، فيقول : اكتبوه ممن لا يغير وعلا يبدل حتى يلقاني ) )(@)(@@) ( هناد ) عن عبد الرحمن بن أبي ليلى .(@)(@@)(@@)(@@) $ ( 2354 ) قال النبي :(@)(@@) | 30 ( إذا صليتم على المرسلين فصلوا علي معهم ، فإني رسول من المرسلين ) )(@)(@@) الديلمي عن أنس وروا ابن عاصم عن قتادة مرسلا وسنده حسن .(@)(@@)(@@)(@@) $ ( 2355 ) قال النبي :(@)(@@) | 30 ( إذا صليتم علي فأحسنوا الصلاة فإنكم لا تدرون لعل ذالك يعرض علي ، قولوا : اللهم اجعل صلواتك وبركاتك على سيد المرسلين وإمام PageV01P343 المتقين وخاتم النبيين عبدك ورسولك إمام الخير وقائد الخير ورسول الرحمة ، اللهم ابعثه المقام المحمود الذي يغبطه به الأولون والآخرون ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه قال الحافظ ابن حجر المعروف أنه موقوف عليه كذا رواه .(@)(@@)(@@)(@@) $ ( 2356 ) قال النبي :(@)(@@) | 30 ( إذا صلي مملوك أحدكم طعاما فولي حره وعمله فقربه إليه فليدعه فليأكل ، وإن أبى فليضع في يده مما صنع ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2357 ) قال النبي :(@)(@@) | 30 ( إذا صنعت مرقة فأكثر ماءها ثم انظر أهل بيت من جيرانك فأصبهم منها بمعروف ) )(@)(@@) ابن المبارك ( حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2358 ) قال النبي :(@)(@@) | 30 ( إذا ضاف أحدكم بقوم فلا يصومن إلا باذنهم ) )(@)(@@) ( عد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2359 ) قال 
ms255	 النبي :(@)(@@) | 30 ( إذا ضرب أحدكم خادمه فليجتنب الوجه ) )(@)(@@) ( خ ) في الأدب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2360 ) قال النبي :(@)(@@) | 30 ( إذا ضرب أحدكم فليجتنب الوجه ولا يقل : قبح الله وجهك ووجه من أشبه وجهك ، فإن الله عز وجل خلق آدم على صورته ) )(@)(@@) ( عب حم قط ) في الصفات ( طب ) في السنة ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2361 ) قال النبي :(@)(@@) | 30 ( إذا ضربتم فاتقوا الوجه فإن الله خلق وجه آدم على صورته ) )(@)(@@) ( عب ) عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 2362 ) قال النبي :(@)(@@) | 30 ( إذا ضرب أحدكم فليجتنب الوجه فإن صورة الإنسان على صورة الرحمان ) )(@)(@@) ( قط ) في الصفات عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2363 ) قال النبي :(@)(@@) | 30 ( إذا ضن الناس بالدينار والدرهم وتبايعوا بالعينة ، PageV01P344 وأخذتم أذناب البقر ، ورضيتم بالزرع ، وتركتم الجهاد في سبيل الله ، بعث الله عليكم ذلا لا ينزعه منكم حتى تراجعوا أمر دينكم ، وإن الرجل ليتعلق بجاره يوم القيامة فيقول : إن هاذا أغلق بابه وضن عني بماله ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2364 ) قال النبي :(@)(@@) | 30 ( إذا ضيعت الأمانة فانتظر الساعة ، قيل : كيف إضاعتها ؟ قال : إذا أسند الأمر إلى غير أهله فانتظر الساعة ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2365 ) قال النبي :(@)(@@) | 30 ( إذا طفا السمك على الماء فلا تأكله ، وإذا جزر عنه البحر كله وما كان على حافتيه فكله ) )(@)(@@) ابن مردويه ( هق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2366 ) قال النبي :(@)(@@) | 30 ( إذا طاب قلب المرء طاب جسده وإذا خبث القلب خبث الجسد ) )(@)(@@) ابن السني وأبو نعيم في الطب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2367 ) قال النبي :(@)(@@) | 30 ( إذا طبختم القدر فأكثروا الماء واغرفوا للجيران ) )(@)(@@) أبو الشيخ في الثواب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2368 ) قال النبي :(@)(@@) | 30 ( إذا طبخت قدرا فأكثر مرقتها فإنه أوسع للأهل والجيران ) )(@)(@@) ( حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2369 ) قال النبي :(@)(@@) | 30 ( إذا طعم أحدكم فسقطت لقمته من يده فليمط ما رابه منها وليطعمها ولا يدعها للشيطان ، ولا يمسح 
ms256	 يده بالمنديل حتى يلعق يده ، فإن الرجل لا يدري في أي طعامه يبارك له ، وإن الشيطان يرصد الإنسان على كل شيء حتى عند مطعمه ، ولا يرفع الصحفة حتى يلعقها أو يلعقها ، فإن في آخر الطعام البركة ) )(@)(@@) ( حب هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2370 ) قال النبي :(@)(@@) | 30 ( إذا طعم أحدكم من الطعام فلا يمسح يده حتى يلعق PageV01P345 أصابعه ، فإنه لا يدري في أي طعامه يبارك له ) )(@)(@@) ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2371 ) قال النبي :(@)(@@) | 30 ( إذا طلع الفجر فلا صلاة إلا الركعتين ، فليبلغ الشاهد الغائب ) )(@)(@@) ( طب ) عن ابن عمر ( الديلمي ) عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2372 ) قال النبي :(@)(@@) | 30 ( إذا طلع النجم ارتفعت العاهة من كل بلد ) )(@)(@@) ( حم بز طص ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2373 ) قال النبي :(@)(@@) | 30 ( إذا طلع حاجب الشمس فدعوا الصلاة حتى تبرز ، وإذا غاب حاجب الشمس فدعوا الصلاة حتى تغيب ، ولا تحينوا بصلاتكم طلوع الشمس ولا غروبها فإنها تطلع بين قرني شيطان ) )(@)(@@) ( خ قط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2374 ) قال النبي :(@)(@@) | 30 ( إذا طلعت الشمس من مطلعها كهيئتها لصلاة العصر حين تغرب من مغربها فصلى رجل ركعتين وأربع سجدات كتب له أجر ذالك اليوم وكف عنه خطيئته وإثمه ، فإن مات من يومه دخل الجنة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2375 ) قال النبي :(@)(@@) | 30 ( إذا طلق الرجل امرأته ثلاثا عند الإقراء أو طلقها ثلاثا مبهمة لم تحل له حتى تنكح زوجا غيره ) )(@)(@@) ( طب ) عن الحسن بن علي أو عنه عن أبيه رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2376 ) قال النبي :(@)(@@) | 30 ( إذا ظهر في أمتي خمس حل عليهم الدمار : التلاعن والخمر والحرير والمعازف ، واكتفاء الرجال بالرجال والنساء بالنساء ) )(@)(@@) ( ك ) في التاريخ و الديلمي عن أنس رضي الله عنه .(@)(@@) PageV01P346(@)(@@)(@@)(@@) $ ( 2377 ) قال النبي :(@)(@@) | 30 ( إذا ظهر فيكم مثل ما ظهر في بني إسرائيل : إذا كانت الفاحشة في كباركم ، والملك في صغاركم ، والعلم في رذالكم ) )(@)(@@) ( حم ع ه ) عن أنس قال : قيل : يا رسول 
ms257	 الله متى ندع الأمر بالمعروف والنهي عن المنكر ؟ قال فذكره ، ولفظ ( ع ) ( إذا ظهر الإدهان في خياركم ، والفاحشة في شراركم ، وتحول الملك في صغاركم ، والفقه في رذالكم ) .(@)(@@)(@@)(@@) $ ( 2378 ) قال النبي :(@)(@@) | 30 ( إذا طلعت الشمس من مغربها خر إبليس ساجدا ينادي ويجهد : إلاهي مرني أن أسجد لمن شئت ، فتجتمع إليه زبانيته ، فيقولون : يا سيدهم ما هاذا التضرع ؟ فيقول : إنما سألت ربي عز وجل أن ينظرني إلى الوقت المعلوم ، وهاذا الوقت المعلوم ، ثم تخرج دابة الأرض من صدع في الصفا ، فأول خطوة تضعها بانطاكية فتأتي إبليس فتلطمه ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2379 ) قال النبي :(@)(@@) | 30 ( إذا ظهر السوء فلم ينهوا عنه أنزل الله بهم بأسه ، قيل : وإإن كان فيهم الصالحون ؟ قال : نعم يصيبهم ما أصابهم ثم يصيرون إلى مغفرة الله ورحمته ) ) نعيم بن حماد في الفتن ( ك ) عن مولاة ل رسول الله .(@)(@@)(@@)(@@) $ ( 2380 ) قال النبي :(@)(@@) | 30 ( إذا ظهر القول ، وخزن العمل ، وأكلفت الألسنة ، وتباغضت القلوب ، وقطع كل ذي رحم رحمه ، فعند ذالك لعنهم الله ، فأصمهم وأعمى أبصارهم ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2381 ) قال النبي :(@)(@@) | 30 ( إذا ظهرت المعاصي في أمتي عمهم الله بعذاب من عنده ، قيل : أما في الناس يومئذ صالحون ؟ قال : بلى ، يصيبهم ما أصاب الناس ثم يصيرون إلى مغفرة من الله ورضوان ) )(@)(@@) ( حم طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2382 ) قال النبي :(@)(@@) | 30 ( إذا ظهرت البدع في أمتي ، وشتم أصحابي فليظهر PageV01P347 العالم علمه فإن لم يفعل فعليه لعنة الله ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2383 ) قال النبي :(@)(@@) | 30 ( إذا عاد الرجل أخاه المسلم فإنه في خرافة حتى يرجع ) )(@)(@@) ابن جرير ( هب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2384 ) قال النبي :(@)(@@) | 30 ( إذا عاد الرجل أخاه المريض فهو في مخرفة الجنة ) )(@)(@@) ابن جرير عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2385 ) قال النبي :(@)(@@) | 30 ( إذا عاد الرجل أخاه أو زاره في الله قال الله له : طبت وطاب ممشاك وتبوأت منزلا في الجنة ) )(@)(@@) ( خ ) في 
ms258	 الأدب و ابن أبي الدنيا في كتاب الإخوان ( حب هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2386 ) قال النبي :(@)(@@) | 30 ( إذا عد الصالحون فائت بأبي بكر ، إذا عد المجاهدون فائت بعمر بن الخطاب ، عمر معي حيث حللت ، وأنا مع عمر حيث حل ، ومن أحب عمر فقد أحبني ، ومن أبغض عمر فقد أبغضني ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2387 ) قال النبي :(@)(@@) | 30 ( إذا عزت ربيعة ذل الإسلام ، ولا يزال الله تعالى يعز الإسلام وأهله ، وينقص الشرك وأهله ما عزت مضر واليمن ) )(@)(@@) ابن عساكر عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ 2388 قال النبي :(@)(@@) | 30 ( إذا عسر على المرأة ولدها أخذ إناء نظيف وكتب عليه : { كأنهم يوم يرون ما يوعدون } إلى آخر الآية ، { وكأنهم يوم يرونها لم يلبثوا } الآية ، { لقد كان في قصصهم عبرة لاولي الألباب } ، إلى آخر الآية ، ثم يغسل وتسقى المرأة منه وينضح على بطنها وفرجها ) )(@)(@@) ابن السني عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P348(@)(@@)(@@)(@@) $ ( 2389 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل الحمد لله على كل حال ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2390 ) قال النبي :(@)(@@) | 30 ( إذا عطس العاطس فابدءوه بالحمد ، فإن ذالك دواء من كل داء ومن وجع الخاصرة ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2391 ) قال النبي :(@)(@@) | 30 ( إذا علمت أن سهمك قتله ولم تر فيه أثر سبع فكل ) )(@)(@@) ( ت ) حسن صحيح عن عدي بن حاتم رضي الله عنه قال : قلت : يا رسول الله أرمي الصيد فأجد فيه من الغد سهمي قال فذكره .(@)(@@)(@@)(@@) $ ( 2392 ) قال النبي :(@)(@@) | 30 ( إذا عملت سيئة فاعمل بجنبها حسنة ، السر بالسر ، والعلانية بالعلانية ) )(@)(@@) ابن النجار عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2393 ) قال النبي :(@)(@@) | 30 ( إذا عملت سيئة فأتبعها حسنة تمحها ، قيل : يا رسول الله أمن الحسنات لا إلاه إلا الله ؟ قال : هي أفضل الحسنات ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2394 ) قال النبي :(@)(@@) | 30 ( إذا عملت عشر سيئات فاعمل حسنة تحدوهن بها ، قيل 
ms259	 : أمن الحسنات أن أقول لا إلاه إلا الله ؟ قال : نعم أحسن الحسنات ، إنها تكتب عشر حسنات وتمحو عشر سيئات ) )(@)(@@) ابن عساكر عن عمرو بن الأسود مرسلا .(@)(@@)(@@)(@@) $ ( 2395 ) قال النبي :(@)(@@) | 30 ( إذا عملت إمتي خمسا فعليهم الدمار : إذا ظهر فيهم التلاعن ، وشربوا الخمور ، ولبسوا الحرير واتخذوا القينات ، واكتفى الرجال بالرجال وال نس اء بالنساء ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@) PageV01P349(@)(@@)(@@)(@@) $ ( 2396 ) قال النبي :(@)(@@) | 30 ( إذا غاب الرجل فلا يأتي أهله طروقا ) )(@)(@@) ( ط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2397 ) قال النبي :(@)(@@) | 30 ( إذا غاب الهلال قبل الشفق فهو لليلته ، وإذا غاب بعد الشفق فهو لليلتين ) )(@)(@@) ( ك ) في تاريخه و الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2398 ) قال النبي :(@)(@@) | 30 ( إذا غشي الرجل جارية امرأته فإن استكرهها فهي حرة ولها عليه مثلها ، وإن طاوعته فهي أمة ولها عليه مثلها ) )(@)(@@) ( سمويه حم ) عن سلمة بن المحبق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2399 ) قال النبي :(@)(@@) | 30 ( إذا غشي أحدكم أهله ثم أراد أن يعود فليتوضأ وضوءه للصلاة ) )(@)(@@) ابن جرير في تهذيبه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2400 ) قال النبي :(@)(@@) | 30 ( إذا غضبت فاقعد ، فإن لم يذهب غضبك فاضطجع فإنه سيذهب ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2401 ) قال النبي :(@)(@@) | 30 ( إذا فتح الله على عبد فليدع فإن الله مستجيب له ) )(@)(@@) الحكيم ( ك ) في التاريخ عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2402 ) قال النبي :(@)(@@) | 30 ( إذا فسا أحدكم أو ضرط فليتوضأ فإن الله لا يستحيي من الحق ) )(@)(@@) ( عب ) عن قيس بن طلق .(@)(@@)(@@)(@@) $ ( 2403 ) قال النبي :(@)(@@) | 30 ( إذا فسد أهل الشام فلا خير فيكم ) )(@)(@@) ( كر ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2404 ) قال النبي :(@)(@@) | 30 ( إذا فشا الإسلام في الأنباط واتخذوا فيكم الدور ، وقعدوا في الأفنية فاحذروهم فإن فيهم الدغل والنقل والفتنة ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 2405 ) قال النبي :(@)(@@) | 30 ( إذا فسدت صلاة الإمام فسدت صلاة من خلفه ) PageV01P350 )(@)(@@) الخطيب في المتفق والمفترق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2406 ) قال النبي 
ms260	 :(@)(@@) | 30 ( إذا قاء أحدكم في صلاته أو قلس أو رعف فلينصرف فليتوضأ ثم ليبن على ما مضى من صلاته ما لم يتكلم ) )(@)(@@) ( ض هق ) و الديلمي وابن النجار عن ابن جريج عن ابن أبي مليكة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2407 ) قال النبي :(@)(@@) | 30 ( إذا قاء أحدكم أو قلس أو وجد مذيا وهو في الصلاة فلينصرف فليتوضأ وليرجع وليبن على صلاته ما لم يتكلم ) )(@)(@@) ( ض هق ) في المعرفة و ابن النجار عن ابن جريج عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 2408 ) قال النبي :(@)(@@) | 30 ( إذا قاتل أحدكم فليجتنب الوجه فإن صورة وجه الإنسان على صورة وجه الرحمان ) )(@)(@@) ( طب ) في السنة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2409 ) قال النبي :(@)(@@) | 30 ( إذا قاتل أحدكم أخاه فليتق الوجه فإن الله عز وجل خلق آدم على صورة وجهه ) )(@)(@@) ( طب ) في السنة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2410 ) قال النبي :(@)(@@) | 30 ( إذا قاتل أحدكم فليجتنب الوجه فإن الله تعالى خلق آدم على صورته ) )(@)(@@) ( ه ) عن أبي هريرة عبد بن حميد عن أبي سعيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2411 ) قال النبي :(@)(@@) | 30 ( إذا قاتلتم المشركين فاقتلوا شيوخهم فإن ألينهم قلوبا شيوخهم ) )(@)(@@) ( طب ) عن حبيب بن سليمان بن سمرة عن أبيه عن جده رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2412 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل لأخيه المسلم مرحبا بك ، قالت الملائكة : مرحبا ، وإذا قال لأخيه : لا مرحبا بك ، قالت الملائكة : لا مرحبا بك ، إن العبد ليقطب في وجه أخيه فتلعنه الملائكة ) )(@)(@@) الخطيب في المتفق والمفترق عن أنس رضي الله عنه وفيه مجاشع بن عمر وأبو يوسف .(@)(@@)(@@)(@@) $ ( 2413 ) قال النبي :(@)(@@) | 30 ( إذا قال إمامكم سمع الله لمن حمده ، فقولوا : اللهم ربنا لك الحمد ) )(@)(@@) ( ش ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV01P351(@)(@@)(@@)(@@) $ ( 2414 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل لامرأته أنت طالق إن شاء الله لم تطلق ، وإذا قال لعبده : أنت حر إن شاء الله فإنه حر ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2415 ) قال النبي :(@)(@@) | 30 ( إذا قال العبد أستغفر الله وأتوب إليه 