ms6661	 وجهه وتدخن منخراه ، فقال النبي : لعن الله من فعل هاذا ، لا يسمن أحدكم الوجه ، ولا يضربن أحدكم الوجه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14164 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى النبي عن الضرب في الوجه ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14165 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : انطلقوا بنا إلاى البصير الذي في بني واقف نعوده ، وكان رجلا أعماى ) . ( عد ، هب ، وابن النجار ) . )(@)(@@) PageV19P209(@)(@@)(@@)(@@) $ 14166 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لقيت النبي فقلت : كيف أصبحت يا رسول الله قال : بخير من رجل لم يصبح صائما ، ولم يعد سقيما ) . ( هب ) . )(@)(@@)(@@)(@@) $ 14167 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في سفر ، فبعثني في حاجة ، فجئت وهو يصلي ، فسلمت عليه ، فلم يرد علي السلام ، وفي لفظ : فأشار بيده ) . ( ش ، وابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 14168 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لو مررت بقوم يصلون ما سلمت عليهم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14169 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا سلم علاى النبي وهو يبول ، فقال : إذا رأيتني علاى هاذا فلا تسلم علي ، فإنك إن سلمت علي وأنا علاى هاذا لم أرد عليك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14170 عن عبد الواحد بن أيمن ، عن أبيه قال :(@)(@@) | 30 ( نزل بجابر رضي الله عنه ضيف ، فجاءهم بخبز وخل ، فقال : كلوا ، فإني سمعت رسول الله يقول : نعم الإدام الخل ، هلاك بالقوم أن يحتقروا ما قدم إليهم ، وهلاك بالرجل أن يحتقر ما في بيته يقدمه إلاى أصحابه ) . ( هب ) . )(@)(@@)(@@)(@@) $ 14171 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي مسح علاى الخفين والعمامة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14172 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي توضأ مرة مرة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14173 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( إذا توضأت فلا تمندل ) . ( عب ) . )(@)(@@) PageV19P210(@)(@@)(@@)(@@) $ 14174 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( رأى رسول الله قوما قد توضؤوا ولم يمس أعقابهم الماء ، فقال : ويل للأعقاب من النار ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14175 عن جابر 
ms6662	 بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( أكلت مع رسول الله ومع أبي بكر وعمر وعثمان خبزا ولحما ، فصلوا ولم يتوضؤوا ) . ( ص ، ش ) . )(@)(@@)(@@)(@@) $ 14176 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قرب لرسول الله خبز ولحم ، ثم دعا بوضوء فتوضأ فصلى الظهر ، ثم عاد بفضل طعام فأكل ، ثم قام إلاى الصلاة ولم يتوضأ ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14177 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن امرأة من الأنصار صنعت شاة لرسول الله فدعته في نفر من الصحابة وقربت لهم سورا ، ثم أتتهم بطعام فأكل رسول الله وأكلنا معه ، فدعا بماء فتوضأ ، ثم صلى بنا الظهر ، ثم أتي بفضول طعامهم فأكلنا ثم قام فصلى بنا العصر ولم يتوضأ ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14178 حدثنا فليح بن سليمان قال : سألنا الزهري عما مست النار ؟ فأخبرنا في ذالك بأحاديث أمر فيها بالوضوء عن أبي هريرة ، وعن عمر بن عبد العزيز ، وعن خارجة بن زيد ، وعن سعيد بن خالد ، وعن عبد الملك بن أبي بكر فقلت له : إن هاهنا رجلا من قريش يقال له : عبد الله بن محمد يحدث عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رسول الله خرج إلاى أهل سعد بن الربيع في نفر من أصحابه ، منهم جابر بن عبد الله فأكلنا خبزا ولحما ، ثم صلى بنا رسول الله فصلينا معه وما مس أحد منا وضوءا ، وانصرفت مع أبي بكر في ولايته من المغرب ، فابتغاى عشاء ، فقيل : ليس هاهنا إلا هاذه الشاة ، وقد ولدت PageV19P211 فحلبها ، ثم طبخ لنا لباء ، فأكل وأكلنا معه ، ثم قال : كيف قال رسول الله : إذا جاء مال أعطيتك هاكذا وهاكذا وهاكذا ، فلما جاءه أعطاني ثلاث حفنات ، ثم خرج إلاى المسجد فصلى بالناس ، وما مس من ماء وما مسته ، وكان عمر بن الخطاب رضي الله عنه ربما جفن لنا في ولايته فأكلنا الخبز واللحم فيخرج فيصلي ونصلي معه ، وما يمس أحد منا وضوءا ، وقال الزهري : وأنا أحدثكم أيضا إن كنتم تريدونه ، حدثني علي بن عبد الله ابن عباس : أن ابن عباس 
ms6663	 رضي الله عنهما أخبره أن رسول الله أكل عضوا فصلى ولم يتوضأ ، وحدثني جعفر بن عمرو بن أمية الضمري ، عن أبيه : أنه رأى رسول الله أكل عضوا فصلى ولم يتوضأ ، فقلنا : وما بعد هاذا ؟ فقال : إنه يكون أمر فيكون بعده الأمر ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14179 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( بينا نحن عند رسول الله إذ جاء رسول من عند امرأة من الأنصار فقال : إن فلانة تدعوك ، فقام رسول الله وقمنا معه ، حتى انتهينا ، فبسطت لنا في صورة ، وهو النخل الملتف ، فأتت بشاة مشوية ، وذالك قبيل الظهر ، فأكل رسول الله وأكلنا معه ، ثم قام رسول الله فتوضأ وصلى الظهر ، ثم إنها بعثت فقالت : يا رسول الله ألا أبعث لك ببقية أو بفضلة بقيت من الشاة ؟ قال : بلاى ، فأتي به ، فأكل رسول الله وأكلنا معه ، ثم قام فصلى ولم يتوضأ ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14180 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( رخص رسول الله في جلود الميتة ) . ( عب ، وفيه حجاج بن أرطأة ضعيف ) . )(@)(@@)(@@)(@@) $ 14181 عن سالم بن أبي الجعد ، عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : يجزىء من الغسل صاع ، ومن الوضوء المد ، فقال PageV19P212 رجل : لا يكفيني ، فقال : قد كفاى خيرا منك وأكثر شعرا ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14182 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن وفد ثقيف قالوا : يا رسول الله إن أرضنا أرض باردة ، فكيف بالغسل ؟ قال : أما أنا فأفرغ علاى رأسي ثلاثا ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14183 عن أبي سفيان قال :(@)(@@) | 30 ( سئل جابر بن عبد الله رضي الله عنه قال : أيتوضأ الجنب بعدما يغتسل ؟ قال : يكفيه الغسل ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14184 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله وأزواجه يغتسلون من إناء واحد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14185 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا نستحب أن نأخذ من ماء الغدر ، ونغتسل في ناحية ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14186 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله توضأ بماء أفضلت السباع ) . ( عب ، وهو 
ms6664	 حسن ) . )(@)(@@)(@@)(@@) $ 14187 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا نغزو مع النبي أرض المشركين ، فلا نمتنع أن نأكل من آنيتهم ونشرب في أسقيتهم ( ش )(@)(@@)(@@)(@@) $ 14188 عن أبي عبيدة بن محمد بن عمار :(@)(@@) | 30 ( أنه سأل جابر بن عبد الله رضي الله عنه عن المسح علاى الخفين ؟ قال : هي السنة يا ابن أخي ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14189 عن أبي عبيدة بن محمد بن عمار بن ياسر رضي الله عنه قال :(@)(@@) | 30 ( سئل جابر بن عبد الله رضي الله عنه عن المسح علاى الخفين ؟ فقال : سنة ، فقلت : المسح علاى العمامة ؟ فقال : أمس الماء الشعر ؟ ) . ( ص ) . )(@)(@@) PageV19P213(@)(@@)(@@)(@@) $ 14190 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما طلق حفص بن المغيرة امرأته فاطمة أتت النبي فقال له : أمتعها ولو بصاع ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14191 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( طلقت خالتي فأرادت أن تجد نخلها فزجرها رجل أن تخرج ، فأتت النبي ، فقال : بل جدي نخلك ، فإنك عساى تصدقين أو تفعلين معروفا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14192 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( تعتد المبتوتة والمتوفى عنها زوجها حيث شاءت ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14193 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي أخذ بيد مجذوم فأقعده معه ، فقال : كل ثقة بالله ، وتوكلا عليه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14194 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يبعث العالم والعابد ، فيقال للعابد : ادخل الجنة ، ويقال للعالم : اثبت تشفع للناس كما أحسنت أدبهم ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14195 عن جابر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( اطلع قوم من أهل الجنة علاى قوم من أهل النار ، فقالوا : بم دخلتم النار ، فإنما دخلنا الجنة بتعليمكم ؟ قالوا : إنا كنا نأمر ولا نفعل ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14196 عن جابر بن عبد الله رضي الله عنه قال : $ 30 ( من تولى مولاى رجل مسلم ، أو آواى محدثا ، فعليه غضب الله ، لا يقبل الله منه صرفا ولا عدلا ، وقال : كتب النبي علاى كل بطن عقوله ، ثم كتب : إنه لا يحل أن يتوالاى مولاى رجل مسلم بغير إذنه ، ولعن في صحيفة 
ms6665	 من فعل ذالك ) . ( عب ) .(@)(@@)(@@)(@@) $ 14197 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا نبيع أمهات الأولاد ، والنبي PageV19P214 حي لا يراى بذالك بأسا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14198 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( دبر رجل من الأنصار غلاما له ، ولم يكن له مال غيره ، فباعه النبي ، فاشتراه النحام عبدا قبطيا ) . ( ض ، ش ) . )(@)(@@)(@@)(@@) $ 14199 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( دبر رجل من الأنصار غلاما له لم يكن له مال غيره ، فقال النبي : من يبتاعه مني ؟ فاشتراه رجل من بني عدي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14200 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أعتق أبو مذكور غلاما له ، يقال له : يعقوب القبطي ، عن دبر منه ، فبلغ النبي ، فقال : أله مال غيره ؟ قالوا : لا ، قال : من يشتريه مني ؟ فاشتراه نعيم بن النحام ، ختن عمر بن الخطاب رضي الله عنه بثمانمائة درهم ، فقال النبي : أنفق علاى نفسك ، فإن كان فضل فعلاى أهلك ، فإن كان فضل فعلاى أقاربك ، فإن كان فضل فاقسم هاهنا وهاهنا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14201 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن عبد حاطب ابن أبي بلتعة أتاى رسول الله يشتكي حاطبا ، فقال : يا رسول الله ليدخلن حاطب النار ، فقال رسول الله : كذبت ، لا يدخلها ، إنه قد شهد بدرا والحديبية ) . ( ش ، م ، ت ، ن ، والبغوي ، طب ، وأبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 14202 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنت أمنح أصحابي الماء يوم بدر ) . ( ش ، وأبو نعيم ) . )(@)(@@) PageV19P215(@)(@@)(@@)(@@) $ 14203 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال لي أبي ، عبد الله : أي ابني لولا بنيات أخلفهن من بعدي من أخوات وبنات لأحببت أن أقدمك أمامي ، ولاكن كن في نظاري المدينة ، قال : فلم ألبث أن جاءت بهما عمتي قتيلين يعني : أباه وعمه ، قد عرضتهما علاى بعير ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14204 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( خرجنا إلاى قتلانا يوم أحد ، إذ أجراى معاوية العين ، فاستخرجناهم بعد أربعين سنة لينة أجسادهم ، تثنى أطرافهم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14205 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم الأحزاب ، ورد الله المشركين بغيظهم 
ms6666	 لم ينالوا خيرا ، قال رسول الله : من يحمي أعراض المسلمين ؟ قال كعب بن مالك : أنا يا رسول الله ، وقال ابن رواحة رضي الله عنه : أنا يا رسول الله قال : إنك تحسن الشعر ؟ فقال حسان بن ثابت رضي الله عنه : أنا يا رسول الله قال : نعم ، اهجهم أنت وسيعينك عليهم روح القدس ) . ( ابن منده ، كر ، ورجاله ثقات ) . )(@)(@@)(@@)(@@) $ 14206 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( مكث النبي وأصحابه يحفرون الخندق ثلاثا ما ذاقوا طعاما ، فقالوا : يا رسول الله إن هنا كدية من الجبل ، فقال رسول الله : رشوا عليها الماء فرشوها ، ثم جاء النبي فأخذ المعول أو المسحاة ثم قال : بسم الله ، ثم ضرب ثلاثا فصارت كثيبا ، قال جابر : فحانت مني التفاتة ، فرأيت رسول الله قد شد علاى بطنه حجرا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14207 عن جابر رضي الله عنه قال :(@)(@@) $ 30 ( خرج يوم خيبر مرحب اليهودي وهو يقول :(@)(@@) PageV19P216(@)(@@) قد علمت خيبر أني مرحب %~% شاكي السلاح بطل مجرب(@)(@@) أطعن أحيانا وحينا أضرب % إذا الليوث أقبلت تجرب $ 30(@)(@@) وهو يقول : هل من مبارز ؟ فقال رسول الله : من لهاذا ؟ فقال محمد بن مسلمة رضي الله عنه : أنا له يا رسول الله أنا والله الموتور الثائر ، قتلوا أخي بالأمس ، قال ، فقال : قم إليه ، الله أعنه ، فلما دنا أحدهما من صاحبه ، دخلت بينهما شجرة ، ثم حمل عليه مرحب فضربه بالدرقة ، فوقع سيفه فيها ، فعضت به الدرقة فأمسكته ، فضربه محمد بن مسلمة فقتله ) . ( ع ، وابن جرير ، والبغوي ، كر ) . ) $(@)(@@)(@@)(@@) $ 14208 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان أصحاب الشجرة ألفا وخمسمائة ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 14209 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا يوم الحديبية ألفا وأربعمائة ، فقال لنا رسول الله : أنتم اليوم خير أهل الأرض ) . ( ش ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 14210 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( عطش الناس وهم بالحديبية ، حتى كادت أن تنقطع أعناقهم من شدة العطش ، ففزعوا إلاى رسول الله وقالوا : هلكنا يا رسول الله ، هلكنا ، قال : كلا لن تهلكوا وأنا فيكم ، ثم أدخل يده في 
ms6667	 ثور كان بين يديه ، فيه قريب من مد ماء ، ففرج فيه أصابعه ، فوالذي أكرمه بنبوته ، لرأيت الماء يفور من بين أصابعه كالعيون التي تجري ، فقال : حي باسم الله ، فشربنا وسقينا الركاب ، ثم عمدنا إلاى المزاد والقرب ، فملاءناها حتى صدرنا ، فتبسم رسول الله ثم قال : أشهد أن لا إلاه إلا الله ، وأني نبي الله PageV19P217 ورسوله ، لا يقولها عبد بصدق قلبه ولسانه إلا دخل الجنة ، قيل : كم كنتم يومئذ ؟ قال : أربع عشرة مائة ، ولو شهد ذالك اليوم أهل منى لوسعهم وكفاهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14211 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( دخلنا مع رسول الله مكة ، وفي البيت وحول البيت ثلاثمائة وستون صنما تعبد من دون الله ، فأمر بها رسول الله فكبت كلها لوجوهها ، ثم قال : { جاء الحق وزهق الباطل إن الباطل كان زهوقا } ، ثم دخل رسول الله البيت فصلى فيه ركعتين ، فرأى فيه تمثال إبراهيم وإسماعيل وإسحاق ، قد جعلوا في يد إبراهيم الأزلام يستقسم بها ، فقال رسول الله : قاتلهم الله ما كان إبراهيم يستقسم بالأزلام ، ثم دعا رسول الله بزعفران فلطخه بتلك التماثيل ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14212 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي دخل مكة وعليه عمامة سوداء ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14213 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي نهاى عن الصور في البيت ، وأن النبي أمر عمر بن الخطاب رضي الله عنه زمان الفتح وهو بالبطحاء أن يأتي الكعبة فيمحو كل صورة فيها ، فلم يدخل البيت حتى محيت كل صورة فيها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14214 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان فيمن ثبت مع رسول الله يوم حنين أيمن ابن أم أيمن ، وهو أيمن بن عبيد ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14215 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي قال يوم حنين : الآن حمي الوطيس ، ثم انتحاى ركابه وقال : هزموا ورب الكعبة ) . ( العسكري في الأمثال ) . )(@)(@@) PageV19P218(@)(@@)(@@)(@@) $ 14216 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لقد بعث رسول الله يوم الطائف حنظلة بن الربيع إلاى أهل الطائف فكلمهم ، فاحتملوه ليدخلوه حصنهم ، فقال رسول الله : من لهاؤلاء 
ms6668	 وله مثل أجر غزاتنا هاذه ؟ فلم يقم إلا العباس بن عبد المطلب ، حتى أدركه في أيديهم قد كادوا أن يدخلوه الحصن ، فاحتضنه العباس رضي الله عنه وكان رجلا شديدا ، فاختطفه من أيديهم ، وأمطروا الاى العباس الحجارة من الحصن ، فجعل النبي يدعو له ، حتى انتهاى به إلاى النبي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14217 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( حملني خالي جد بن قيس في السبعين راكبا الذين وفدوا علاى النبي من الأنصار ، فخرج إلينا رسول الله ومعه عمه العباس رضي الله عنه فقال : يا عم خذ لي علاى أخوالك ، فقال له السبعون : سلنا لربك ، وسل لنفسك ما شئت ، قال : أما الذي أسألكم لربي فتعبدونه ولا تشركون به شيئا ، وأما الذي أسألكم لنفسي فتمنعوني مما تمنعون منه أنفسكم وأموالكم ، قالوا : فما لنا إذا فعلنا ذالك ؟ قال : الجنة ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14218 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أبصرت عيناي ، وسمعت أذناي من رسول الله بالجعرانة ، وفي ثوب فضة ورسول الله يقبضها للناس فيعطيهم ، فقال له رجل : يا رسول الله اعدل ، فقال : ويلك ، فمن يعدل إذا لم أعدل ؟ لقد خبت وخسرت إن لم أكن أعدل ، فقال عمر بن الخطاب رضي الله عنه : دعني يا رسول الله فلأقتل هاذا المنافق ، فقال : معا الله أن يتحدث الناس أني أقتل أصحابي ، إن هاذا وأصحابه يقرءون القرآن لا يجاوز تراقيهم ، يمرقون من الدين مروق السهم من الرمية ) . ( م ، ن ، وابن جرير ، طب ) . )(@)(@@)(@@)(@@) $ 14219 عن محمد بن شداد عن أبي الزبير ، عن جابر بن عبد الله رضي الله عنه ، نحو حديث الزهري ، عن أبي سلمة ، قال PageV19P219 جابر رضي الله عنه :(@)(@@) | 30 ( وأشهد لسمعته من رسول الله ، وأشهد أن عليا رضي الله عنه حين قتلهم وأنا معه جيء بالرجل علاى النعت الذي نعته رسول الله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14220 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( لما بنيت الكعبة ، ذهب النبي وعباس ينقلان حجارة ، فقال عباس رضي الله عنه للنبي : اججل إزارك علاى رقبتك من الحجارة ، ففعل فخر علاى 
ms6669	 الأرض ، وطمحت عيناه إلاى السماء ، ثم قام فقال : إزاري إزاري فشد عليه إزاره ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14221 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أصاب الناس عطش يوم الحديبية ، فهش الناس إلاى رسول الله ، فوضع يده في الركوة ، فرأيت الماء مثل العيون ، قيل : كم كنتم ؟ قال : لو كنا مائة ألف لكفانا ، كنا خمس عشرة مائة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14222 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي كان ينقل معهم الحجارة للكعبة وعليه إزاره ، فقال له العباس عمه رضي الله عنه : يا ابن أخي لو حللت إزارك فجعلته علاى منكبيك دون الحجارة قال : فحله فجعله علاى منكبه ، فسقط مغشيا عليه ، فما رئي بعد ذالك اليوم عريانا ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14223 قال ابن عساكر : أخبرني أبو القاسم هبة الله بن عبد الله ، أنبأنا أبو بكر الخطيب ، أنبأنا القاضي أبو بكر محمد بن عمر بن إسماعيل الداودي ، أنبأنا أبو بكر محمد بن عبد الله بن الفتح الصيرفي ، حدثنا أبو بكر بن أبي داود ، حدثنا محمد بن قهزاد ، أخبرنا سلمة بن سليمان ، حدثنا عبد الله بن المبارك ، أنبأنا عمر بن سلمة بن أبي يزيد ، عن أبيه عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن النبي توضأ في طست فأخذته فصببته في بئر لنا ، قال أبو بكر بن داود : كتب عني أبي ثلاثة أحاديث ، هاذا أحدها ، وسمع مني أبي هاذا الحديث ، وكان PageV19P220 يقول : حدثت عن ابن قهزاد ) . )(@)(@@)(@@)(@@) $ 14224 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( بينا رسول الله يوما في مسجد المدينة ، فذكر بعض أصحابه الجنة ، فقال النبي : يا أبا دجانة أما علمت أن من أحبنا وامتحن بمحبتنا أسكنه الله معنا ؟ ثم تلا هاذه الآية : { في مقعد صدق عند مليك مقتدر ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14225 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رأى علاى فاطمة رضي الله عنها كساء من أوبار الإبل وهي تطحن ، فبكاى وقال : يا فاطمة اصبري علاى مرارة الدنيا لنعيم الآخرة غدا ، ونزلت : { ولسوف يعطيك ربك فترضاى } ) . ( ابن لال ، وابن مردويه ، وابن النجار ، والديلمي 
ms6670	 ) . )(@)(@@)(@@)(@@) $ 14226 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( احتبس الوحي عن رسول الله في أول أمره ، وحبب إليه الخلاء ، فجعل يخلو في حراء ، فبينما هو مقبل من حراء قال : إذا أنا بحس فوقي فرفعت رأسي ، فإذا أنا بشيء علاى كرسي فلما رأيته جئثت إلاى الأرض ، فأتيت أهلي بسرعة ، فقلت : دثروني فأتاني جبريل فجعل يقول : { يا أيها المدثر * قم فأنذر * وربك فكبر * وثيابك فطهر * والرجز فاهجر } ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14227 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يعرض نفسه على الناس بالموقف يقول : ألا رجل يعرضني علاى قومه ؟ فإن قريشا قد منعوني أن أبلغ كلام ربي ، فأتاه رجل من همدان ، فقال : وممن أنت ؟ قال : من PageV19P221 همدان ، قال : وعند قومك منعة ؟ قال : نعم ، فذهب الرجل ثم أنه خشي أن يخفره قومه ، فرجع إلاى النبي ، فقال : أذهب فأعرض علاى قومي وآتيك من قابل ، ثم ذهب ، وجاءت وفود الأنصار في رجب ) . ( ش ) . )(@)(@@)(@@)(@@) $ ( 14228 ) عن جابر بن عبد الله رضي الله عنه قال : ' سمعت رسول الله صلى الله عليه وسلم يقول : سدوا الأبواب كلها إلا باب علي وأومأ بيده إلى باب علي ' . ( كر ) .(@)(@@)(@@)(@@) $ 14229 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا بالجحفة بغدير خم ، وثم ناس كثير من جهينة ومزينة وغفار ، فخرج علينا رسول الله من خباء أو فسطاط ، فأشار بيده ثلاثا ، فأخذ بيد علي رضي الله عنه فقال : من كنت مولاه فعلي مولاه ) . ( ز ) . )(@)(@@)(@@)(@@) $ 14230 عن سليمان بن الربيع ، حدثنا كادح بن رحمة الزاهد ، حدثنا مسعر بن كدام ، عن عطية ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : رأيت علاى باب الجنة مكتوبا : لا إلاه إلا الله ، محمد رسول الله ، علي أخو رسول الله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14231 عن جابر رضي الله عنه قال : $ 30 ( لما سأل أهل قباء النبي أن يبني لهم مسجدا ، قال رسول الله : ليقم بعضكم فيركب الناقة ، فقام أبو بكر رضي الله عنه فركبها وحركها فلم تنبعث فرجع فقعد ، فقام عمر رضي الله عنه 
ms6671	 فركبها فحركها فلم تنبعث فرجع فقعد ، فقام علي رضي الله عنه فلما وضع رجله في غرز الركاب وثبت به ، قال رسول الله : يا علي أرخ زمامها ، وابنوا علاى مدارها ، فإنها مأمورة ) . ( طب ) .(@)(@@)(@@)(@@) $ 14232 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إن الله اختار أصحابي علاى جميع العالمين سواى النبيين والمرسلين واختار لي من أصحابي أربعة : أبا بكر وعمر وعثمان وعليا ، فجعلهم خير أصحابي ، كلهم خير ، واختار PageV19P222 أمتي علاى سائر الامم ، واختار من أمتي أربعة قرون بعد أصحابي : القرن الأول والثاني والثالث تتراى ، والرابع فراداى ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14233 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( لقد لبثنا بالمدينة سنتين قبل أن يقدم علينا رسول الله نعمر المساجد ونقيم الصلاة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14234 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( دخلت علاى رسول الله ذات يوم فقال : مرحبا يا جويبر جزاكم الله تعالاى يا معشر الأنصار خيرا آويتموني إذ طردني الناس ، ونصرتموني إذ خذلني الناس ، فجزاكم الله معشر الأنصار خيرا فقلت : بل جزاك الله عنا خيرا بك هدانا الله إلاى الإسلام ، وأنقذنا من شفا حفرة من النار ، وبك نرجو الدرجات العلاى من الجنة ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14235 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( النقباء كلهم من الأنصار منهم البراء بن معرور ، من بني سلمة ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14236 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي حرم كل دافقة أقبلت علاى المدينة من العضد وشيئا آخر قاله إلا لمنشد ضالة ، أو عصا جديدة ينتفع بها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14237 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء أعرابي إلاى النبي فبايعه علاى الإسلام ، فجاء من الغد محموما ، فقال : يا رسول الله أقلني ، فأباى النبي ، فجاءه ثلاثة أيام متوالية ، كل ذالك يقول : يا رسول الله أقلني بيعتي ، فأباى النبي ، قال النبي : إن المدينة تنفي خبثها ، وتنصع طيبها ) . ( عب ) . )(@)(@@) PageV19P223(@)(@@)(@@)(@@) $ 14238 عن الحارث بن رافع بن مكيث الجهني :(@)(@@) | 30 ( أنه سأل جابر بن عبد الله رضي الله عنه فقال : لي غنم وغلمان ، وهم يخبطون علاى 
ms6672	 غنمهم هاذه الثمرة الحبلة وهي ثمرة السمر ، فقال جابر : لا ، ثم لا ، لا يخبط ولا يعضد حماى رسول الله ، ولاكن هشوا هشا ، ثم قال جابر : إن كان رسول الله ليمنع أن يقطع المسد ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14239 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( حرم رسول الله المدينة بريدا عن يمين وشمال من نواحيها ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14240 عن عبد الرحمان بن زياد بن أنعم ، عن عمرو بن جابر الحضرمي ، عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : من سكن دمشق نجا ، فقلت : أعن رسول الله هاذا ؟ قال : أعن رأيي أحدثك ؟ ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14241 عن جابر رضي الله عنه :(@)(@@) | 30 ( أنه سمع النبي يوما وهو علاى المنبر نظر قبل الشام ، فقال : اللهم أقبل بقلوبهم ، اللهم أقبل بقلوبهم ، ونظر قبل العراق ، فقال نحو ذالك ، وقبل كل أفق فقال مثل ذالك ، وقال : اللهم ارزقنا من ثمرات الأرض ، وبارك لنا في مدنا وصاعنا ، وقال : مثل المؤمن كمثل السنبلة ، تخر مرة وتستقيم مرة ، ومثل الكافر كمثل الأرزة ، لا يزال يستقيم حتى يخر ولا يشعر ) . ( ابن عساكر ) . )(@)(@@)(@@)(@@) $ 14242 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله قبل موته بشهر : إن بين يدي الساعة كذابين ، منهم صاحب اليمامة ، ومنهم صاحب PageV19P224 الصنعاء العنسي ، ومنهم صاحب حمير ، ومنهم الدجال ، والدجال أعظمهم فتنة ) . ( نعيم بن حماد ) . )(@)(@@)(@@)(@@) $ 14243 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ما منكم من نفس منفوسة يأتي عليها مائة سنة ، وهي حية يومئذ ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14244 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله لقي ابن صياد ومعه أبو بكر رضي الله عنه ، فقال له رسول الله : أتشهد أني رسول الله ؟ فقال ابن صياد : أتشهد أني رسول الله ؟ فقال رسول الله : آمنت بالله ورسله ، فقال رسول الله : ما تراى ؟ فقال ابن صياد : أراى عرشا علاى الماء ، فقال له رسول الله : تراى عرش إبليس علاى البحر ، قال : ما تراى ؟ قال : أراى صادقين أو كاذبين ، فقال رسول الله : لبس عليه 
ms6673	 فدعوه ، لبس عليه فدعوه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14245 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( فقدنا ابن صياد يوم الحرة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14246 عن جعفر بن محمد ، عن أبيه ، عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : شفاعتي لأهل الكبائر من أمتي ، قلت : ما هاذا يا جابر ؟ قال : نعم يا محمد إنه من زادت حسناته ، فذاك الذي يدخل الجنة بغير حساب ، ومن استوت حسناته وسيئاته فذاك الذي يحاسب حسابا يسيرا ثم يدخل الجنة ، وإنما شفاعة رسول الله لمن أوبق نفسه ، وأثقل ظهره ) . ( هق في البعث ، كر ، ه ) . )(@)(@@)(@@)(@@) $ 14247 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رفع إلاى النبيي رجل طعن رجلا في فخذه بقرن ، فقال الذي طعنت فخذه : أقدني يا رسول الله فقال رسول الله : داوها واستأن بها حتى ننظر إلاى ما تصير ، فقال الرجل : يا PageV19P225 رسول الله أقدني منه ، فقال له مثل ذالك ، فقال الرجل : أقدني يا رسول الله فأقاده رسول الله ، فيبست رجل الذي استقاده ، وبرأ الذي استقيد منه ، فأبطل رسول الله دمها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14248 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله أن يتعاطاى السيف مسلولا ) . ( كر ، وأخرجه الترمذي ) . )(@)(@@)(@@)(@@) $ 14249 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله مما أضرب منه يتيمي ؟ قال : مما كنت ضاربا منه ولدك غير واق مالك بماله ، ولا متأثل من ماله مالا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14250 عن سفيان ، عن ابن المنكدر ، عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي شرب لبنا فمضمض وقال : إن له دسما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14251 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم خيبر أصاب الناس مجاعة ، وأخذوا الحمر الإنسية فذبحوها وملاوا منها القدور ، فبلغ ذالك النبي ، فأمرنا رسول الله بإكفاء القدور ، وقال : إن الله سيأتيكم برزق هو أطيب من ذا وأحل ، فكفأنا القدور يومئذ وهي تغلي ، فحرم رسول الله يومئذ الحمر الإنسية والبغال ، وكل ذي ناب من السباع ، وكل ذي مخلب من الطير ، وحرم المجبة والخلسة والنهبة ) . ( كر 
ms6674	 ) . )(@)(@@)(@@)(@@) $ 14252 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله نهاى عن أكل لحوم الحمر الأهلية ، ونهاى أن توطأ النساء الحبالاى من السبي ) . ( ط ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 14253 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( أطعمنا النبي لحوم الخيل ، ونهانا عن لحوم الحمر ) . ( ش ) . )(@)(@@) PageV19P226(@)(@@)(@@)(@@) $ 14254 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أكلنا لحوم الخيل يوم خيبر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14255 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إن بقرة أفلتت علاى خمر فشربت ، فخافوا عليها ، فسألوا النبي ، فقال : كلوها أو قال : لا بأس بأكلها ) . ( ك ) . )(@)(@@)(@@)(@@) $ 14256 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( بينما أنا عند رسول الله إذ جاءه ناس ، فقالوا : يا رسول الله سفينة لنا انكسرت وإنا وجدنا ناقة سمينة ميتة ، فأردنا أن ندهن به سفينتنا ، وإنما هي عون علاى الماء ، فقال : لا تنتفعوا بشيء من الميتة ) . ( ابن جرير وسنده حسن ) . )(@)(@@)(@@)(@@) $ 14257 عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن غلاما من قومه صاد أرنبا فذكاها عروة ، فسأل رسول الله فأمره بأكلها ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14258 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن الضب أتي به النبي فلم يأكله ، فقال عمر رضي الله عنه : إن فيه منفعة للرعاء ، فقال : إن أمة من الامم مسخت ، فلا أدري لعلها . . . فلم يأمر به ولم ينه عنه ، ولم يأكله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14259 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( بعثنا رسول الله في سرية وليس معنا زاد إلا مزود من تمر ، واستعمل علينا أبا عبيدة بن الجراح رضي الله عنه ، وكان يعطينا حفنة حفنة حتى نفد ، وكان يعطينا تمرة تمرة ، فضرب البحر بدابة فأكلنا منها ، ثم إن أبا عبيدة أمر بالضلع فحني ، ثم أمر رجلا فركب بعيرا ، فمر راكبا علاى البعير ) . ( طب ) . )(@)(@@)(@@)(@@) $ 14260 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( سئل النبي : عن PageV19P227 الجنب : هل ينام أو يأكل وهو جنب ؟ فقال : إذا توضأ وضوءه للصلاة ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14261 عن جابر رضي الله عنه قال 
ms6675	 :(@)(@@) | 30 ( إذا دخل الرجل بيته وأواى إلاى فراشه ، ابتدره ملك وشيطان ، فقال الملك : اختم بخير ، وقال الشيطان : اختم بشر ، فإن ذكر الله وحمده طرده ثم بات يكلؤه ، فإذا استيقظ قال الملك : افتح بخير ، وقال الشيطان : افتح بشر ، فإن ذكر الله تعالاى وقال : الحمد لله الذي يمسك السماوات والأرض أن تزولا ولئن زالتا إن أمسكهما من أحد من أحد من بعده إنه كان حليما غفورا ، الحمد لله الذي يمسك السماء أن تقع علاى الأرض إلا بإذنه إن الله بالناس لرءوف رحيم ، فإن خر عن فراشه فمات مات شهيدا ، وإن قام فصلى صلى في فضائل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14262 عن عطية ، عن أبي سعيد أو جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( ليس أحد ينام إلا ضرب علاى صماخه بجرير عقد ، فإن هو استيقظ فذكر الله حلت عقده فإن توضأ حلق أخراى ، فأن صلى حلق عقده لكلها ، وإن لم يستيقظ ولم يتوضأ ولم يصل ، أصبحت العقد كلها كهيئتها ، فبال الشيطان في أذنه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14263 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رجل للنبي : إني رأيت كأن عنقي ضربت قال : لام يخبر أحدكم بلعب الشيطان به ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14264 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : يا رسول الله رأيت في المنام كأن رأسي قطع ، فضحك النبي وقال : إذا لعب الشيطان بأحدكم في منامه فلا يحدث به الناس ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14265 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( خرصها ابن رواحة ، PageV19P228 يعني أربعين ألف وسق ، قزعم أن اليهود لما خيرهم ابن رواحة رضي الله عنه أخذوا التمر وعليهم عشرون ألف وسق ) . ( ش ، أي خيبر ) . )(@)(@@)(@@)(@@) $ 14266 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( أن النبي صلى على أصحمة فكبر عليه أربعا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14267 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله يوم أحد : احفروا ، وأعمقوا وأوسعوا ، وأحسنوا ، وادفنوا الاثنين والثلاثة في قبر واحد وقدموا أكثرهم قرآنا ) . ( ابن 
ms6676	 جرير ) . )(@)(@@)(@@)(@@) $ 14268 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رأى ناس نارا في مقبرة فأتوها ، فإذا رسول الله يقول : ناولوني صاحبكم فإذا هو الرجل الذي كان يرفع صوته بالذكر ) . ( طب ) . )(@)(@@) PageV19P229(@)(@@)(@@)(@@) $ 14269 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : هل نكحت ؟ قلت : نعم ، قال : بكرا أو ثيبا ؟ قلت : بل ثيبا ، قال : فهلا بكرا تلاعبها وتلاعبك ؟ قلت : إن أبي قتل يوم أحد وترك تسع بنات ، فلي تسع أخوات ، فلم أحب أن يجمع إليهن خرقاء مثلهن ، وقلت : امرأة تقوم عليهن وتمشطهن ، قال : أصبت ) . ( ص ) . )(@)(@@) سقط صفحة 230 حديث رقم 14270 و 14271 و 14272 و 14273 في المطبوع(@)(@@)(@@)(@@) $ 14274 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في سفر ، فلما قفلنا تعجلت علاى بعير لي قطوف ، فلحقني راكب من خلفي ، فنخس بعيري بعنزة كانت معه ، فانطلق بعيري كأجود ما أنت راء من الإبل ، فالتفت فإذا النبي ، فقلت : يا رسول الله هاذه بركتك ، قال : ما يعجلك ؟ قلت : يا رسول الله إني حديث عهد بعرس ، قال : فبكر تزجت أو ثيب ؟ قلت : بل ثيب ، قال : فهلا جارية تلاعبها وتلاعبك ؟ فقال : إذا قدمت علاى أهلك فالكيس الكيس فلما قدمنا ذهبنا نهارا ، فقال : أمهلوا حتى ندخل عشاء لكي تمشط الشعثة ، وتستعد المغيبة ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14275 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( هلك أبي وترك سبع بنات أو تسعا ، فتزوجت امرأة ثيبا ، فقال لي رسول الله : تزوجت يا جابر ؟ قلت : نعم ، قال : بكرا أم ثيبا ؟ قلت : بل ثيبا ، قال : فهلا جارية تلاعبها وتلاعبك أو قال : تضاجعها وتضاجعك ؟ فقلت : إن أبي مات وترك تسع بنات أو سبعا فإني كرهت أن أجيئهن بمثلهن ، فقال : أحسنت بارك الله فيك وقال لي خيرا ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14276 عن جابر بن عبدالله رضي الله عنه : $ 30 ( أنه سئل عن متعة النساء ؟ PageV19P230 فقال : استمتعنا علاى عهد رسول الله وأبي بكر وعمر رضي الله عنهما ، ثم نهاى عنها عمر ) . ( عب ) .(@)(@@)(@@)(@@) $ 14277 عن حسن بن محمد بن علي ، عن جابر بن عبد 
ms6677	 الله ، وسلمة بن الأكوع رضي الله عنهم قالا :(@)(@@) | 30 ( كنا في غزوة ، فجاءنا رسول رسول الله فقال : إن رسول الله يقول : استمتعوا ) . ( عب ) . )(@)(@@) )(@)(@@)(@@)(@@) $ 14278 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا نستمتع بالقبضة من التمر والدقيق علاى عهد النبي وأبي بكر رضي الله عنه حتى نهاى عمر الناس ، وكنا نعتد من المستمتع منهن بحيضة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14279 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( في العبد والأمة ، سيدهما يجمع بينهما ويفرق ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14280 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نساء أهل الكتاب لنا حل ، ونساؤنا عليهم حرام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14281 عن أبي الزبير :(@)(@@) | 30 ( أنه سمع جابر بن عبد الله رضي الله عنه يقول في الرجل له الأمة المسلمة وعبد نصراني ، أيزوج العبد الأمة ؟ قال : لا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14282 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء ناس من المسلمين فقالوا : يا رسول الله إنها تكون الإماء فنعزل عنهن ، وزعمت اليهود أنها الموءودة الصغراى ، فقال النبي : كذبت اليهود ، وكذبت اليهود ، ولو أراد الله أن يخلقه لم يردوه ) . ( عب ، ت ) . )(@)(@@)(@@)(@@) $ 14283 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل من الأنصار إلاى النبي فقال : إن لي جارية وأنا أعزل عنها ، فقال النبي : ما قدر يكن ، فلم يلبث أن PageV19P231 حملت ، فجاء النبي فقال : ألم تر أنها حملت ؟ فقال النبي : ما قضاى الله تعالاى لنفس ما أن تخرج إلا وهي كائنة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14284 عن عطاء :(@)(@@) | 30 ( أنه سمع جابر بن عبد الله رضي الله عنه وذكروا له العزل فقال : كنا نفعله علاى عهد رسول الله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14285 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل بأبيه إلاى النبي يخاصمه فقال : دنت ومالك لأبيك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14286 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : يا رسول الله إن أبي يريد أن يستبيح مالي ، قال : أنت ومالك لأبيك ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14287 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أراد النبي أن ينهاى أن يسمى بيعلاى وبركة ، وبأفلح 
ms6678	 ويسار ، وبنافع وبنحو ذالك ، ثم رأيته سكت بعد عنها ، ولم يقل شيئا ، ثم قبض ولم ينه عنها ، ثم أراد عمر رضي الله عنه أن ينهى عنها ثم تركه ) . ( ابن جرير وصححه ) . )(@)(@@)(@@)(@@) $ 14288 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( هم النبي أن ينهاى أن يسمى : ميمونا ، وبركة ، وأفلح وهاذا النحو ثم تركه ) . ( ابن جرير ، وصححه ) . )(@)(@@)(@@)(@@) $ 14289 عن جابر بن عبدالله رضي الله عنه :(@)(@@) | 30 ( أن النبي زجر أن تصل المرأة بشعرها شيئا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14290 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إنما العمراى التي أجاز رسول الله أن يقول : هي لك ولعقبك ، فأما إذا قال : هي ما عشت ، فإنها ترجع إلاى صاحبها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14291 عن جابر رضي اللهق عنه قال :(@)(@@) | 30 ( قضاى رسول الله أنه أيما رجل PageV19P232 أعمر رجلا عمراى له ولعقبه ، فقال : قد أعطيتكها وعقبك ما بقي منكم أحد ، فإنها لمن أعطاها ، وإنها لا ترجع إلاى صاحبها من أجل أنه أعطاه عطاء وقعت فيه المواريث ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14292 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( النذر كفارته كفارة يمين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14293 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( خرجت مع رسول الله في سفر ، وكان لا يأتي البراز حتى يغيب فلا يراى ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14294 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يسجد في أعلا جبهته علاى قصاص الشعر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14295 عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يقول في التشهد وفي لفظ : كان يعلمنا التشهد : باسم الله وبالله ، التحيات لله ، والصلوات لله ، والطيبات ، السلام عليك أيها النبي ورحمة الله وبركاته ، السلام علينا وعلاى عباد الله الصالحين ، أشهد أن لا إلاه إلا الله ، وأشهد أن محمدا عبده ورسوله ، أسأل الله الجنة ، وأعوذ بالله من النار وفي لفظ يسأل الله ويتعوذ ) . ( ش ، ن ، ه ، ع ، ك ، هق ، ض ) . )(@)(@@)(@@)(@@) $ 14296 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جاء عمر رضي الله عنه يوم الخندق فجعل يسب كفار قريش 
ms6679	 ، ويقول : يا رسول الله ما صليت العصر حتى كادت الشمس أن تغيب ، فقال رسول الله : وأنا والله ما صليت بعد ، فنزل فتوضأ ثم صلى العصر بعد ما غربت الشمس ، ثم صلى المغرب بعدما صلى العصر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14297 عن جابر بن عبد الله رضي الله عنه في بيع المصاحف قال :(@)(@@) | 30 ( ابتعها ولا تبعها ) . ( ابن أبي داود في المصاحف ) . )(@)(@@) PageV19P233(@)(@@)(@@)(@@) $ 14298 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( من وجد صداق حرة فلا ينكح أمة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14299 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لا تنكح الأمة علاى الحرة وتنكح الحرة علاى الأمة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14300 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إنما جعل رسول الله الشفعة في كل ما لم يقسم ، فإذا وقعت الحدود ، وصرفت الطرق فلا شفعة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14301 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يغرف علاى رأسه ثلاثا ، فقال له رجل : إني كثير الشعر فلا يكفيني ، فقال : كان رسول الله أكثر منك شعرا ، وأطيب ريحا ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14302 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم الطائف قام النبي مع علي مناجيا بالنهار ، فقال له أبو بكر رضي الله عنه : يا رسول الله لقد أطلت مناجاته ، قال : ما أنا ناجيته ، ولاكن الله انتجاه ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14303 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( غزوت مع رسول الله ثلاث عشرة غزوة ) . ( طب ، عن جابر ) . )(@)(@@)(@@)(@@) $ 14304 عن جابر بن عبدالله رضي الله عنه قال :(@)(@@) | 30 ( لما انهزم الناس عن رسول الله يوم أحد ، حتى لم يبق معه إلا طلحة فغشوهما ، فقال رسول الله : من لهاؤلاء ؟ فقال طلحة : أنا فقاتل ، فأصيب بعض أنامله ، فقال : حس ، فقال رسول الله : يا طلحة لو قلت : بسم الله ، أو ذكرت الله ، لرفعتك الملائكة والناس ينظرون حتى تلج بك في جو السماء ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14305 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله طعن في خاصرة أبي PageV19P234 عبيدة رضي الله عنه وقال : إن هاهنا خويصرة مؤمنة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14306 عن 
ms6680	 جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن النبي لما رأى حمزة رضي الله عنه بكاى ، فلما رأى ما مثل به شهق ) . ( طب ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 14307 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا جلوسا عند النبي ، فأقبل سعد رضي الله عنه ، فقال : هاذا خالي ، فليرني امرؤ خاله ) . ( ت ، وقال : غريب ، طب ، ك ، وأبو نعيم ، ض ) . )(@)(@@)(@@)(@@) $ 14308 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله إذ أقبل سعد بن مالك رضي الله عنه ، فقال : أنت خالي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14309 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( جاء جبريل إلاى النبي فقال : من هاذا العبد الصالح الذي فتحت له أبواب السماء ، وتحرك له العرش ؟ فخرج رسول الله فإذا سعد بن معاذ رضي الله عنه ، فقال رسول الله : هاذا العبد الصالح شدد عليه في قبره حتى كان هاذا حين فرج له ) . ( حم ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 14310 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لقد اهتز العرش لموت سعد بن معاذ رضي الله عنه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14311 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله لسعد رضي الله عنه يوم مات وهو يدفن : لهاذا العبد الصالح الذي اهتز له العرش ، وفتحت له أبواب السماء ، شدد عليه ثم فرج عنه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14312 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما استواى رسول الله علاى المنبر يوم الجمعة قال : اجلسوا ، فسمع ذالك ابن مسعود رضي الله عنه فجلس عند باب المسجد ، فرآه النبي فقال : تعال يا عبد الله بن مسعود ) . ( كر ) . )(@)(@@) PageV19P235(@)(@@)(@@)(@@) $ 14313 عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رسول الله مر بعمار وأهله وهم يعذبون ، فقال : أبشروا آل عمار وآل ياسر فإن موعدكم الجنة ) . ( طس ، ك ، هق ، كر ، ض ) . )(@)(@@)(@@)(@@) $ 14314 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله والمسلمين لما أخذوا في حفر الخندق ، جعل عمار بن ياسر رضي 