ms381	 آمد و، برون شد صبرماحسنت، زهی در آمد و بیرون شد!(@)(@@)(@@)(@@) | مرتضی(@)(@@) ~~3829 گفتی که: صبور باش در محنت و درد با گریهآ گرم ساز و، با نالهآ سرد(@)(@@) ~~در نعمت و ناز، صبر کردن سهل است در محنت و درد، صبر می نتوان کرد!(@)(@@) (@@) 3830 یا، مرغ امید را پری بایستی %~% یا، رشتهآ سوز را سری بایستی(@)(@@) (@@) در گلشن وصل، تا به ویرانهآ صبر %~% از خانهآ آرزو، دری بایستی!(@)(@)PageV01P576(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0580.jpg)(@)(@)(@@) ~~3831 چون، یاد وصال آن دل افروز کنم آهی ز میان جان، جگر سوز کنم(@)(@@) (@@) صد پیرهن صبر بدرم، تا من %~% روزی به شب آرم و، شبی روز کنم!(@)(@@) (@@) 3832 آن دل که بدی در غم توشاد، نماند %~% وان تن که کشید از توبیداد، نماند(@)(@@) (@@) صبری، که به حیله ام همی داشت به پای %~% همچون دل و جان- تو را بقا باد- نماند(@)(@@)(@@)(@@) | آخر(@)(@@) (@@) 3832 آن کس، که ز هجر بر دلش بند بود %~% دیوانه شود، گرچه خردمند بود(@)(@@) (@@) هر چند، به صبر مرد خرسند بود %~% پیداست، که صبر آدمی چند بود!(@)(@@)(@@)(@@) | اشرف(@)(@@) (@@) 383 هر وعدهآ کام دل، که دلبر بدهد %~% دل گوید: دولتی بود گر بدهد!(@)(@@) (@@) ای دل، تو به صبر کوش و، می ساز که صبر %~% تخمی است، که دیر آید وهم بر بدهد!(@)(@@)(@@)(@@) | خجندی(@)(@@) (@@) 3834 یاری، که ندارد از لبش جام طمع %~% داریم بدو بر غم ایام طمع(@)(@@) (@@) بنگر، که بدین دست و دل و کیسهآ صبر %~% سودای تو می پزم، زهی خام طمع!(@)(@@)(@@)(@@) | مجیر(@)(@@) ~~3836 مسکین دل من، اگر قرارش بودی خوش بافته اند در ازل، جامهآ عشق(@)(@@) %~% گریک خط صبر، بر کنارش بودی! %~% با محنت و اندوه، چه کارش بودی؟(@)(@@)(@@)(@@) | مجیرا(@)(@@) (@@) 3831 هر جور و جفایی، که فلک پنهان داشت %~% زد بر دل ما، که از قضا فرمان داشت(@)(@@) (@@) ای دور فلک، دست فروهل که به صبر %~% با زخم تو، پای بیش از این نتوان داشت!(@)(@)PageV01P577(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0581.jpg)(@)(@)(@@)(@@)(@@) | مجیر(@)(@@) (@@) 3838 وصلی، که مرا به ناز 
ms382	 پروردی کو؟ %~% جانی، که مراعات دلم کردی کو؟(@)(@@) (@@) آن هجر، که نام من فرو بردی هست %~% آن صبر، که کار من برآوردی کو؟(@)(@@)(@@)(@@) | [مجیرا(@)(@@) (@@) 3839 ای صبر، نگفتی که: چوغم پیش آید %~% خوش باش، که کار توزمن بگشاید؟(@)(@@) (@@) رفتی، چو کلاه گوشهآ غم دیدی %~% ای صبر، کنون کفش که را می باید!(@)(@@) (@@) 3840 ای دیده، مبین جمال مهروی دگر %~% وی دل، مبر آب عشق در جوی دگر(@)(@@) (@@) هر چند، ز دست غم به جان آمده ای %~% ای صبر به جان آمده هان، هوی دگر!(@)(@@) (@@) 3841 در عشق تو، با این همه دلداری صبر %~% گفتم که به فریاد رسد یاری صبر(@)(@@) (@@) اکنون که گرفتار فراقت گشتم %~% رسوایی عقل بین و، بیزاری صبر!(@)(@@) (@@) 3842 تا کی گویی؟ که «صبر درمان باشد!») %~% بر چشم نظاره، کوشش آسان باشد!(@)(@@) (@@) آگه نه ای ای دوست، که بر مشتاقان %~% جان دادن وصبر، هر دو یکسان باشد!(@)(@@) (@@) 3843 با اشک بگفتم: مددی کن، زنهار %~% گف: از من شور بخت، این چشم مدار(@)(@@) (@@) در صبر گریختم، به شیرینی گفت: %~% رو، با من تلخ زندگانیت چه کار؟(@)(@@)(@@)(@@) | نمط سیزدهم(@)(@@)(@@)(@@) | در بیخوابی(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~3844 هر شب دلم ای ماه، پر ازتاب کنی خوابم ببری و، دیده پر آب کنی(@)(@@) ~~در عشق، شبی خواب ز چشمت برواد تا، چارهآ عاشقان بیخواب کنی!(@)(@@) ~~38،5 گفتی که: به صبر، از رخم روی بتاب وآسایش تن را، به سوی خواب شتاب!(@)(@@) (@@) اندر دل تنگ من، تو گنجی یا صبر؟ %~% در دیدهآ محتضر، تو آیی یا خواب؟(@)(@)PageV01P578(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0582.jpg)(@)(@)(@@)(@@)(@@) | (@)(@@) (@@) 3846 هر شب، زغمت خسته جگر می خسبم %~% با دو لب خشک و، چشم ترمی خسبم(@)(@@) (@@) نه نه غلطم، تا زتودور افتادم %~% از جسم تو بیزارم، اگر میخسبم(@)(@@) (@@) 3847 آن شب، که نه با آن بت موزون خسبم %~% بنگر که چگونه باشم و، چون خسبم(@)(@@) (@@) سر پیش فکنده، چون صراحی گریم %~% وز اشک، چوجام باده در خون خسهم!(@)(@@) ~~این طرفه نگر، که رفت از چشمم خواب 
ms383	 3848 در فرقت آن خوش سخن تلخ جواب(@)(@@) %~% یا خواب در او قرار گیرد، یا آب! %~% سرگشته و دلسوخته ام، در تگ و تاب(@)(@@) ~~3845 زان پس که، غم کار محالم بگرفت عهدی کردم، که سر به بالین ننهم(@)(@@) %~% زین خفتن بی خواب، ملالم بگرفت! %~% یعنی که: هوای آن وصالم بگرفت(@)(@@) (@@) 3850 از آب دو چشمم، این چنین رسوا من %~% بیخوابی کرد، هر چه بتوان با من(@)(@@) (@@) از آب بجست خواب از چشمم، گفت: %~% ای آب، در این چشم توباشی، یا من!(@)(@@) (@@) 385 خرم دل [آن] کسی که خوابش ببرد %~% یا خواب، غم از دل خرابش ببرد(@)(@@) (@@) می آید آب چشم و، میناید خواب %~% می ترسد اگر در آید، آبش ببرد!(@)(@@) (@@) 385 زان پس که وصال روی در پرده کشید %~% و اندوه فراق، پردهآ ما بدرید(@)(@@) (@@) گفتم که مگر توانمش دید به خواب %~% خود خواب، همبی به خواب نتوانم دید!(@)(@@) (@@) 3852 دوشم، قدری ز خستگی خواب ربود %~% ناگه، بت من خیال چون مه بنمود(@)(@@) (@@) با من به عساب گفت: در خواب شدی %~% شرمت بادا، که عشق توهیچ نبود.(@)(@@)(@@)(@@) | آخ(@)(@@) (@@) 3854 در خون جگر، همی نشیند چشمم %~% همراهی اشک می گزیند، چشمم(@)(@@) (@@) تا بو که به خواب بیند ای جان، بویت %~% خود خواب، به خواب می نبیند چشمم!(@)(@)PageV01P579(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0583.jpg)(@)(@)(@@) (@@) 3855 از بس که دلم دید عذاب از دیده %~% خون می آید به جای آب از دیده(@)(@@) (@@) ای همچودو دیده، تا برفتی زبرم %~% صبر از دل من برفت و، خواب از دیده!(@)(@@)(@@)(@@) | سجاسی(@)(@@) (@@) 3856 ای خواب، چرا به رفتن آمد رایت؟ %~% تر شد مگر از سرشک چشمم، پایت؟(@)(@@) (@@) دل با من دلسوخته خوش کن، باری %~% تا مردمک دو دیده سازم، جایت!(@)(@@) (@@) 3857 من دانم وشب، که حال چشمم چون است %~% اوله %~% خوابش کم شد، که اشک روز افزون است(@)(@@) (@@) ای دل، همه شب به ساز بیداری کوش %~% کزاشک، میان خواب و چشمم خون است!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3858 تا کی زفراق، دیده پر 
ms384	 خون بینم؟ %~% وز کاهش جان، درد دل افزون بینم؟(@)(@@) (@@) گویند: خیال او همی بین در خواب! %~% خوابم ناید، خیال او چون بینم؟(@)(@@) (@@) 3859 از کبر، همیشه در نقابت بینم %~% وله %~% وز ناز، همیشه در عتابت بینم(@)(@@) (@@) بر دیدهآ من، حرام زان کردی خواب %~% ترسی که مگر، شبی به خوابت بینم!(@)(@@)(@@)(@@) | طلحه(@)(@@) (@@) 3860 تا از برم آن یار پسندیده برفت %~% وز دیدهآ من تمام نادیده برفت(@)(@@) (@@) چون لاله، دل سوخته در سینه بماند %~% چون نرگس تازه، خونم از دیده برفت(@)(@@)(@@)(@@) | اشرف(@)(@@) ~~(386 امشب زغمت، میان خون خواهم خفت وز بسترعافیت، برون خواهم خفت(@)(@@) (@@) باور نکنی، خیال خود را بفرست %~% تا در نگرد، که بی تو چون خواهم خفت!(@)(@@)(@@)(@@) | شهاب(@)(@@) (@@) 3862 هر شب، ز تو جفت شیونم تا به سحر %~% چون صبح، زغم دم نزنم تا به سحر(@)(@@) (@@) وین جامهآ خواب را، که نامش پلک است %~% بر مردم دیده نفکنم، تا به سحر!(@)(@)PageV01P580(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0584.jpg)(@)(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~3861 من دوش، گشاده داشتم روزن چشم بستم زگهر، مرسله بر گردن چشم(@)(@@) (@@) تا روز، به نوک مژه از بیخوابی %~% بر جیب سپهر، دوختم دامن چشم!(@)(@@) (@@) 386 آب رخم، آن دو چشم بی آب ببرد %~% خون دلم، آن لب چو عناب بپرد(@)(@@) (@@) در آرزوی تو، ریختم چندان آب %~% خ %~% کز دیدهآ من خواب مرا، آب ببرد!(@)(@@) (@@) 3865 ای برده بدان دو چشم بی آب، آبم %~% وز آتش رخ، فکنده در جان تابم(@)(@@) (@@) در هجر تو خواب نایدم، ور آید %~% چون زلف تو، آشفته بماند خوابم!(@)(@@)(@@)(@@) | اخی(@)(@@) (@@) 386 گل، زرد شد از چهرهآ مهتابی من نرگس بس(؟) بنفشه در هیچ نخفت %~%(@)(@@) زان پس که به خواب دید، بیخوابی من! %~% در لاله گرفت، اشک عنابی من(@)(@@) (@@) 3867 با دیده بگفتم که: چنین بیخوابی %~% چه سود بود تورا، از این بیخوابی؟(@)(@@) (@@) گفتا: از ازل بهمدگر آمدهاند %~% خوبی وبلا و، عشق واین بیخوابی!(@)(@@)(@@)(@@) | نمط چهاردهم(@)(@@)(@@)(@@) | در گریه و اشک(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 386 با یار، نشست و خاست می نتوان کرد 
ms385	 %~% و اندیشهآ باز خواست، می نتوان کرد(@)(@@) (@@) در عشق، به جز گریستن کار نماند %~% وین کار، به گریه راست می نتوان کرد!(@)(@@)(@@)(@@) | وله(@)(@@) ~~3866 چون پیشه دل، همیشه بی غم خوردن از دل، غم عشق را نهادم گردن(@)(@@) ~~می گریم و، چوبک زن غم می گوید: این کار، به گریه راست خواهی کردن!(@)(@@) (@@) 3870 زین واقعه، لرزهآ تنم بین و مپرس %~% بدریده چو گل، پیرهنم بین و مپرس(@)(@@) (@@) دل، دست نمی دهد که نطقی بزنم %~% کز گریه، گره بر سخنم بین و مپرس!(@)(@)PageV01P581(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0585.jpg)(@)(@)(@@) (@@) 3871 دل، چون سخن دلبر غایب گوید %~% دیده، سخن در غرایب گوید(@)(@@) (@@) شبهای فراق، اگر سخنگوی شود %~% از آب دو چشم من، عجایب گوید!(@)(@@) (@@) 3872 بر من، چوفراق آن بهشتی گذرد %~% روزم به عنا، شبم به زشتی گذرد(@)(@@) (@@) از دیدهآ من، اشک چنان برخیزد %~% کز تارکم، آسمان یه کشتی گذرد!(@)(@@)(@@)(@@) | صدر(@)(@@) (@@) 3873 طفل چشمم، که لعل بر زر میزد %~% در بزم غم تو، دوش ساغر می زد(@)(@@) (@@) در پردهآ بینوایی، انصاف که راست %~% بر تار مژه، ترانهآ تر می زد!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 3874 تا هجر تو، شد چو آفتابم روشن %~% نگذاشت غم تو وجه خوابم روشن(@)(@@) (@@) پایم به گل تیره فروشد، چونماند %~% در دست جز اشک، هیچ آبم روشن!(@)(@@)(@@)(@@) | الیاس(@)(@@) ~~3875 طفلان دو چشمم، چونظر می بندند بر زر، همه عقد در تر می بندند(@)(@@) ~~با روی تو، این دو طفل خوگر شدهاند بی روی تو، هر دو گریه در می بندند!(@)(@@)(@@)(@@) | لاج کاشی(@)(@@) (@@) 3876 در عشق تو، [آب] دیده چندان ریزم %~% کز آب گذر نیابم، ار بگریزم!(@)(@@) (@@) پیرامن خود هیچ نیابم، خاکی %~% کز دست تو، برگیرم و بر سر ریزم!(@)(@@)(@@)(@@) | بدر قوامی(@)(@@) ~~3877 فریاد، که از غم توهمدم بنماند همدم چه بود، هیچ به جز غم بنماند(@)(@@) (@@) گه گاه، به آب دیده خوشدل شدمی %~% آن نیز، به بخت بد من هم بنماند!(@)(@@)(@@)(@@) | فخر مستوفی(@)(@@) ~~3878 رویی است تورا، که عقل مدهوش وی است زهری است 
ms386	 فراقت، که لبت نوش وی است(@)(@@) (@@) در کاسهآ سر، دیگ هوایت پختم %~% خونابهآ گرم دیده، سرجوش وی است!(@)(@@) (@@) 387 یا حوصلهٔ‌ امیدم از هم بچکد %~% یمین %~% یا سینهآ دل ز زحنمت غم بچکد(@)(@@) است، که از تنگ دلم جان عزیز %~% یک قطرهآ خون شود، ز چشمم بچکد!(@)(@)PageV01P582(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0586.jpg)(@)(@)(@@) ~~3880 دریای غم عشق، چو موج انگیزددر حال، مرا ز دیده گوهر خیزد(@)(@@) (@@) سفته، ز سر مژه فرو آویزد %~% ناسفته بود چو در، کنارم ریزد(@)(@@) (@@) 3881 قصه چه کنم؟ که بر چه سان می گریم %~% خون دل و آب دیدگان، می گریم(@)(@@) ~~چون شمع، زجان خنده زنان می سوزم چون زیر، زدل ناله کنان می گریم!(@)(@@)(@@)(@@) | اخ(@)(@@) ~~ای دوست، مریز آب رویم که مرا 3882 هجران تو، گیرم که شبی یا نفسی(@)(@@) است %~% من بیدلم، آن کار دل پر هوسی است! %~% گر در جگر آب نیست، در دیده بسی است!(@)(@@)(@@)(@@) | ملک طغانشاه(@)(@@) (@@) 3883 هر قطره، کز این دیدهآ بیخواب چکد %~% از خون دلم، به رنگ عناب چکد(@)(@@) (@@) بر آتش عشق، دل کباب است مرا %~% اخ %~% شک نیست، که از کباب خوناب چکد!(@)(@@) (@@) 3884 در مزرعهآ سینهآ درد آبادم %~% عمری، به کشاورزی صبر افتادم(@)(@@) (@@) کشتم نگرفت و، عمر شد بر بادم %~% کز چشمه شور [د] یده، آبش دادم!(@)(@@) ~~گه گاه، به آب دیده خوشدل شدمی 3885 ما را، به جز از نیاز تو چیز(@)(@@) نماند %~% خ %~% چندان بگریستم، که آن نیز نماند! %~% در کیسهآ نقد عقل، تمییز نماند(@)(@@) ~~3886 از بادهآ غم، دل مرا مست او کرد وزباد فراق، قامتم پست او کرد(@)(@@) (@@) ای اشک، چه می روی زدست غم او؟ %~% آخر، نه زنیستی تو را هست او کرد!(@)(@@) (@@) 3887 ای اشک، به هر غم نفشاندیم تورا %~% از بهر چنین روز، بماندیم تورا(@)(@@) (@@) گفتیم که خون شوی زعشقش، نشدی! %~% تا لاجرم، از چشم براندیم تورا!(@)(@@) (@@) 3888 آن قطره، کز او تفی گشاید اشک است %~% وان آب، کز او تبش فزاید اشک است 
ms387	(@)(@@) (@@) سیلاب جهان، به چشم من در ناید %~% آبی که به چشم من در آید، اشک است!(@)(@)PageV01P583(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0587.jpg)(@)(@)(@@) (@@) 3889 ای باد صبا، گرت بیفتد گذری %~% از من، بر آن سرو سهی بر، خبری(@)(@@) (@@) کو: ساز سفینه کن، که ناگه برسد %~% طوفان دو چشم من، شبی یا سحری!(@)(@@) (@@) 3890 در راه غمت، گرچه به جان می آیم %~% سردفتر خیل عاشقان، می آیم(@)(@@) (@@) بس گر مرو است اشک، در راه غمت %~% من سوخته تر دامن ازآن می آیم!(@)(@@) (@@) 3891 زان غمزهآ کافرت، که خون می ریزد %~% آیا که دو چشمم، اشک چون می ریزد؟(@)(@@) (@@) آن آب زلال رفت، کآنگه دیدی %~% این خون جگر بین، که کنون می ریزد!(@)(@@) (@@) 3892 کاری، که به مرد و زن فرو می آید %~% می گویم چون سخن فرو می آید(@)(@@) (@@) بسیار بر اشک عاشقان خندیدم %~% امروز، به روی من فرو می آید!(@)(@@) (@@) 3893 این اشک عقیق رنگ من، چون بچکد %~% آب از دل سنگ و، چشم گردون بچکد(@)(@@) (@@) چشمم چوز تو برید از او خون بچکید %~% شک نیست، که از بریدگی خون بچکد!(@)(@@)(@@)(@@) | نجم طوفی(@)(@@) ~~3894 دل، بستهآ دام آرزو می باشدجان، خستهآ آن روی نکو می باشد(@)(@@) (@@) در کار غم تو، دستگیرم اشک است %~% کاندر همه حال، سرخ رومی باشد!(@)(@@)(@@)(@@) | شرف بیلقانی(@)(@@) (@@) 3895 زین سان، که اسیر آن بت کشمیرم %~% وز بیخبری، بمانده بی تدبیرم(@)(@@) (@@) افشاندمی آستین بر او، زآتش دل %~% گر نیستی آب چشم، دامنگیرم(@)(@@)(@@)(@@) | مولانارضی الدین(@)(@@) (@@) 3893 ز آبشخور وصل، بهره اشک است مرا %~% گلگونهآ رنگ چهره، اشک است مرا(@)(@@) ~~چون چرخ، زخورشید وستاره شب و روزچشمی و، هزار قطبره اشک است مرا!(@)(@@) (@@) 3891 اشکم، که ز خون این دل ناشاد است %~% خر %~% از بی آبی، ز چشم من افتاده ست(@)(@@) (@@) گذار که بر خاک درت می غلتد %~% آخر نه چنانکه هست، مردم زاد است!(@)(@)PageV01P584(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0588.jpg)(@)(@)(@@) (@@) (389 بستان دلم، ارنه غم زمن بستاند %~% ور من ندهم، به دم ز من بستاند(@)(@@) گر عشق 
ms388	 تو، خون من چنین خواهد ریخت %~% خر %~% سرمایهآ گریه هم، ز من بستاند!(@)(@@) ~~3899 من بودم دوش و، یار سیمین تن من ایشان همه، صبحدم پراکنده شدند(@)(@@) %~% جز خون جگر، که ماند بر دامن من! %~% جمعی، زنشاط و عیش پیرامن من(@)(@@) (@@) 390 دوشم، هوس دل غمینم بگرفت %~% اندیشهآ یار نازنینم بگرفت(@)(@@) گفتم بروم از پی دل تا بریار %~% اشکم بدوید و، آستینم بگرفت!(@)(@@) (@@) 390 اشکم ز تو، در خون جگر می غلتد %~% پیش در تو، به خاک در می غلتد(@)(@@) (@@) 3901 بستند گرو، با نفس مشک تتار: در آرزوی خاک در تو، همه شب %~% *(@)(@@) %~% از چهرهآ من، بر سر زر می غلتد %~% بوی گل و، باد سحر و، زلف نگار(@)(@@) (@@) هستند به رغم یکدگر، گوهر بار: %~% چشم من و، لعل یارم و، ابر بهار!(@)(@@)(@@)(@@) | فحر(@)(@@) (@@) 3900 جایی که چنان صید ز دامی برود %~% معذور بود ار زر خامی برود(@)(@@) (@@) در دامن اشک، دست زد خون دلم %~% تا از پی یار، چند گامی برود(@)(@@)(@@)(@@) | اسعد گنجه ای(@)(@@) (@@) 390 تا دورم، از آن دو زلف شور انگیزش %~% با دیدهآ من، خواب نکرد آمیزش(@)(@@) در حسرت [آن] دو چشم او، صف مژهام %~% وله %~% بر هم نزنند، جز گه خون ریزش!(@)(@@) (@@) 390 من خسته که جفت انده و تیمارم %~% از بس که ز دیده سیل خون می بارم(@)(@@) در عشق زسر، گذشت آب چشمم %~% اله %~% انصاف، که طرفه سرگذشتی دارم!(@)(@@) (@@) 3906 از عمر خودم منفعتی حالی نیست %~% این رنج قدیمی است، امسالی نیست(@)(@@) (@@) اشکی است که بر مراد می بارم بس %~% وان نیز، هم ازخون دلی خالی نیست!(@)(@)PageV01P585(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0589.jpg)(@)(@)(@@)(@@)(@@) | رضی [گنجه ای](@)(@@) (@@) 3907 ای دل، چو مرا به باد بردادی، رو! %~% بر من در رنج وغصه بگشادی، رو!(@)(@@) (@@) وی اشک، چو رازم آشکارا کردی %~% تو نیز کنون زچشمم افتادی، روا(@)(@@) (@@) 3908 گر درد دل خراب خواهی، دارم %~% سوز جگر کباب خواهی، دارم(@)(@@) (@@) پیش توندارم آب رویی، لیکن %~% چندانکه زدیده آب خواهی، دارم!(@)(@@) (@@) 3909 
ms389	 در عشق تو، چون چنگ تو قد خم کردم %~% مانندهآ نی، خوی فرا دم کردم(@)(@@) (@@) دریاب، که سرمایهآ من اشکی ماند %~% وان نیز، به خون دل فراهم کردم!(@)(@@)(@@)(@@) | ت(@)(@@) (@@) 3910 پیوسته، دل از لبت نهد توشهآ خویش %~% واندر خم زلفت فکند، خوشهآ خویش(@)(@@) (@@) اشک است جگر گوشه و، من بهر رضات %~% از چشم فکندهام، جگر گوشهآ خویش!(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 3911 گر درد دلم، یک نفس آهسته شود %~% از دود دلم، راه نفس بسته شود(@)(@@) (@@) در دیده، از آن آب همی گردانم %~% تا هرچه نه نقش توست، از او شسته شود!(@)(@@)(@@)(@@) | بدر(@)(@@) (@@) 3912 از غصهآ آن بت، که دلم غمخور اوست %~% پیوسته، سرم بر آستان در اوست(@)(@@) (@@) هرتار زمژگان من، از خون دلم %~% سیخی است، که پارهآ جگر بر سر اوست!(@)(@@)(@@)(@@) | طهیر(@)(@@) (@@) 3913 ای اشک، به رفتن ارچه رویی داری %~% وز خون دلم تو، رنگ و بویی داری(@)(@@) (@@) از دیده سبک می روی، ای اشک روان %~% با آنکه گذر بر سر مویی داری!(@)(@@)(@@)(@@) | جمال(@)(@@) ~~3914 بس غم، که من از دل ستمدیده کشمبس جور، که از یار پسندیده کشم(@)(@@) ~~هر لحظه، هزار اشک چون مروارید در حلقهآ گوش مردم دیده کشم!(@)(@@)(@@)(@@) | رشید گنجهای(@)(@@) (@@) 3915 از دیده، به جز پرده دریدن ناید %~% جز گریه و خونابه چکیدن ناید(@)(@@) (@@) گفتم: مگری، نمی نیوشد چه کنم؟ %~% چشم است نه گوش، از او شنیدن ناید!(@)(@)PageV01P586(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0590.jpg)(@)(@)(@@)(@@)(@@) | ادیب(@)(@@) (@@) صحرای جهان زلاله، گویی که مگر 3916 تا کی، زغم تو اشک بارم زمژه %~%(@)(@@) خونی است، چکیده بر کنارم زمژه! %~% بر چهره، هزار جوی دارم ز مژه(@)(@@)(@@)(@@) | افضل کاشی(@)(@@) ~~3917 تا کار شب تیره به رونق گذرد چون روز آید، خیالش از دیدهآ دل(@)(@@) %~% در آب دو چشم من، به زورق گذرد! %~% از دامن من، اشک به راوق گذرد(@)(@@)(@@)(@@) | عایشهآ سمرقندی(@)(@@) (@@) 3917 گر لعل توام، به بوسه تسکین کندی %~% بس شکر، کز او این دل مسکین کندی(@)(@@) (@@) در فرقت تو، سرشک من داد بداد %~% گر مردم زاده نیستی، 
ms390	 این کندی؟(@)(@@) (@@) 3916 ای آنکه جهان، رخ تو پر نور کند %~% لغیرها %~% نوشین لب تو، علاج مخمور کند(@)(@@) (@@) رحم آر، بر آنکه چشم بر هم نزند %~% جز آن وقتی که اشک را دور کند!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 392 اشکی که ز عشق [یار] گلگون باشد %~% گر خود همه خون بود، عجب چون باشد؟(@)(@@) (@@) سرچشمهآ اشکم، زمیان جگر است %~% لابد چو همه جگر بود، خون باشد!(@)(@@) ~~ای تیر مژه، بترس کاین مردم چشم 392 غم، در جگر کباب تاب افکندهست(@)(@@) %~% وله %~% از سوز جگر، سپر بر آب افکندهست! %~% لبهات بر آن نمک کباب افکندهست(@)(@@)(@@)(@@) | اوله(@)(@@) ~~از گریه، شد آیینهآ چشمم تیره 3923 دل، در غمت از میان جان می بندم(@)(@@) 392 زان غم، که نظر به کار من کم داری %~% وله %~% تیره شود آیینه، که درنم(@)(@@) داری! %~% وز هجر، دلم ملازم غم داری %~% جان در طلب تو، بر منیان می بندم(@)(@@) (@@) در سینه، نهال عشق تو کاشته ام %~% آب از مژآه بر سینه، از آن می بندم PageV01P587(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0591.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3924 دل، خاتم درد را نگین خواهد بود %~% زیر قدم هجر، زمین خواهد بود(@)(@@) (@@) این دیدهآ خونفشانم، امروز ببین %~% تا باز نبینمت، چنین خواهد بود!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3925 سودای توام، باز به سر می آید %~% وز دست دلم، جان به جگر می آید(@)(@@) (@@) از گرمروی که هست، اشک چشمم %~% افتان خیزان، به روی در می آیدا(@)(@@)(@@)(@@) | نمط پانزدهم(@)(@@)(@@)(@@) | در اشک وزاری او(@)(@@)(@@)(@@) | کمال(@)(@@) (@@) 3926 ای اشک، غمش به سر دوانید تورا %~% زاندازةآ نخسویش بکذرانید تورا(@)(@@) (@@) ای ناله، شکایت مکن از بیدادش %~% آخر، نه بر آسمان رسانید تورا!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 3927 بریاد قدت، دل رهی ناله کند %~% چون مرغ، که بر سرو سهی ناله کند(@)(@@) (@@) گویند مکن ناله و، آن غم که مراست %~% بر دل نه، که بر کوه نهی ناله کند!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3928 عشق تو، که چارحد او غم دارد %~% بی آه، ز من هیچ نفس بر نارد(@)(@@) (@@) هر آه، که من زدست عشق 
ms391	 توزنم %~% زو خون بچکد، اگر کسی بفشارد!(@)(@@) (@@) 3929 بی یاد تو، دل شاد نمییارم کرد %~% وز بیم، تورا یاد نمی یارم کرد(@)(@@) (@@) زنهار، که زنهار نمی شاید خواست %~% فریاد، که فریاد نمی یارم کرد!(@)(@@)(@@)(@@) | لقائلها(@)(@@) ~~3930 بر درگه او، بار نمی یارم خواست بوسی زلب یار، نمی یارم خواست(@)(@@) (@@) فریاد، که فریاد نمییارم کرد %~% زنهار، که زنهار نبی یارم خواست!(@)(@)PageV01P588(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0592.jpg)(@)(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 3931 دل بندهآ عشق شد، تن آزاد چه سود؟ %~% جان گشت خراب، عالم آباد چه سود؟(@)(@@) ~~فریاد همی کنیم و، او خاموش استفریاد رسی چونیست، فریاد چه سود؟(@)(@@)(@@)(@@) | خ(@)(@@) ~~393 ای لعل لبت، شفای بیماریهاوی جزع تورا، پیشه ستمکاریها(@)(@@) (@@) نا سر ز گریبان وفا بر نکنی %~% دست من و دامن تو و، زاریها!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 393 کو همنفسی، که گه گهم خوش دارد %~% و او را غم این دل مشوش دارد(@)(@@) (@@) دل گرم به آه سرد می شاید بود %~% %~% کز سینهآ من، دریغش آتش دارد!(@)(@@) ~~3930 مشکی، که به چین و ختن آهودارد با چین سر زلف تو، آهو دارد(@)(@@) (@@) وان کوبه تودل داد، همه شب چون من %~% تا وقت سحر ناله وآه، او دارد!(@)(@@) (@@) 3935 دریک نفسم، هجر توصد ساله بسوخت %~% [خویت] دل من همچودل لاله بسوخت(@)(@@) (@@) مر گریهآ من، دیده به صد دیده گریست %~% بر نالهآ زار من، دل لاله بسوخت(@)(@@)(@@)(@@) | موفق سراج(@)(@@) (@@) 3936 گر آه من، اندر آسمان پیچیدی %~% از عرصهآ چرخ، مهرهها بر چیدی(@)(@@) (@@) ور درد من، اندر این جهان گنجیدی %~% صد کوه، برابرش کهی سنجیدی!(@)(@@)(@@)(@@) | ملک فخر الدین(@)(@@) (@@) 3937 هر شب، که سپاه زنگ در جنگ آید %~% از خیل ستاره، آسمان تنگ آید(@)(@@) (@@) خواهم، به یکی آه بسوزم همه را %~% پایم، زستارهآ تو در سنگ آید!(@)(@@)(@@)(@@) | شیخ برهان الدین(@)(@@) ~~3938 گر دیدهآ من به روی یار افتادی بودی، که به جان و دل قرار افتادی(@)(@@) ~~یارب، چه بدی کزاین همه یارب من باری، به غلط یکی به کار افتادی!(@)(@@) (@@) 3939 چون در دل 
ms392	 تنگ، غم نگنجد چه کنم؟ %~% در سینهٔ‌ خسته، دم، نگنجد چه کنم؟(@)(@@) (@@) خواهم که کنم آه، چواندر دل من %~% اندیشهآ آه هم نگنجد، چه کنم؟(@)(@)PageV01P589(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0593.jpg)(@)(@)(@@) ~~3940 خونین کفن ای لاله، به من باز گذار وین دیدهآ پر ژاله، به من باز گذار(@)(@@) (@@) ای مرغ سحر، به درد چندین مخروش %~% بیمار منم، ناله به من باز گذار!(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) (@@) 3941 دلدار، مرا چو خاک بر راه انداخت %~% در پای، دلم به کام بدخواه انداخت(@)(@@) (@@) ای دل، تو کمند آه بر چرخ انداز %~% علیل %~% کو، عهد من شکسته در چاه انداخت!(@)(@@) ~~3942 ای دل، غم دلدار به من باز گذار وی جان، هوس یار به من باز گذار(@)(@@) (@@) ای صبح مدر جامه، دم سرد مزن %~% عاشق منم، این کار به من باز گذار!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3943 آن عارض همرنگ گل و لاله نماندوان اشک روان، چوقطرهآ ژاله نماند(@)(@@) (@@) خرسند بدم به ناله، آوخ که مرا %~% ازغایت ضعف، طاقت ناله نماند!(@)(@@)(@@)(@@) | نمط شانزدهم(@)(@@) درشکایت ازنامحرمان(@)(@@) [کمال] اسماعیل(@)(@@) ~~3944 آنها، که فلک وفا نداد ایشان را وصل من وتو، بد اوفتاد ایشان را(@)(@@) (@@) خواهند، مرا زخدمتت باز برند %~% یارب، که زبان بریده باد ایشان را!(@)(@@) ~~3945 گر در همه عمر خویش، فرصت جویدتا با من خسته دل، حدیشی گوید(@)(@@) (@@) ناگه زستیزهآ مرا، چشم رقیب %~% چون دیدهآ نرگس، از زمین بر روید!(@)(@@) ~~3946 هر گه که دلم، فرصت آن دم جویدکز صد غم دل، با تویکی برگوید(@)(@@) (@@) نامحرم وناجنس، در آن دم گویی %~% کز ابر ببارد، از زمین برروید!(@)(@)PageV01P590(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0594.jpg)(@)(@)(@@)(@@)(@@) | عماد غزنوی(@)(@@) ~~3947 گر بخت، ز ماننگ ندارد عجب است ور چرخ، سر جنگ ندارد عجب است(@)(@@) (@@) از سردی و بد عهدی این سنگدلان %~% والله، که اگر سنگ نبارد عجب است!(@)(@@)(@@)(@@) | رفیع لنبانی(@)(@@) ~~394 آنها، که مرا از تو جدا می دارند بر جان من این درد، دوا می دارند(@)(@@) (@@) رسنگ همی زنم، سر از فرقت تو %~% وین سنگدلان، چنین روا می دارند! 
ms393	(@)(@@)(@@)(@@) | القائله(@)(@@) (@@) 394 از خدمت تو، مرا جدا می دارند %~% پشتم ز فراق تو، دو تا می دارند(@)(@@) (@@) سبحان الله، ز روی بی آزرمی %~% شرمی نه زمن، نه از خدا می دارند!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3950 ای تنگ شکر، به هر مگس می نرسی %~% یعنی به من خسته نفس، می نرسی(@)(@@) (@@) بس تازه و سیراب گلی، لیک چه سود %~% کز زحمت باغبان، به کس می نرسی!(@)(@@) (@@) 395 ای از تو، به درد دل زن و مرد از من %~% آگاه نه ای، که غم چه برخورد از من(@)(@@) (@@) چون صورت دیوار، زجان بادا فرد %~% آن کس، که تورا صورت بد کرد از من!(@)(@@) (@@) 3952 دشمن، که فتادهست به وصلت هوسش %~% یک لحظه، مبادا به طرب دسترسش(@)(@@) (@@) نی نی، نکنم دعای بد زین سپسش %~% گر دشمن آهن است، عشق توبسش!(@)(@@) (@@) 3953 هر شب، که لبم پیاله ای نوش کند %~% خصم آید و، از کرانه ای گوش کند(@)(@@) ~~یارب، تو گرفتار کنش جای دگرتا بو که مرا، شبی فراموش کند(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 3954 جانا، به میان ما بسی خصمانند %~% کاین قصهآ عشق ما، زبر می خوانند(@)(@@) (@@) کوشند، دل من از تو بر گردانند %~% آن توندانم، از من این نتوانند!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 3954 ای دوست، مرا طعنه زنان بسیارند %~% کز بهر توام، به درد سر می دارند(@)(@@) (@@) زنهار، به قولشان نباشی راضی %~% کز خانه گرآیی، به هزا انگارند PageV01P591(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0595.jpg)(@)(@)(@@)(@@)(@@) | الیاس گنجهای(@)(@@) (@@) 3956 تا گنبد هفت چرخ را ساخته اند گر را ستروی، قول مخالف مشنو %~%(@)(@@) زین نی سازان، که پرده نشناخته اند! %~% مردم همه با هم به غرض ساختهاند(@)(@@) (@@) 3957 خصم تو، اگر باز ندارد زتو چنگ %~% صد گونه، بر ای تو بر آمیزم رنگ(@)(@@) (@@) بنشینم، اگر کار به نام آید و ننگ %~% بر آتش چون کباب و، برتیغ چوزنگ!(@)(@@)(@@)(@@) | ابوالحسن(@)(@@) (@@) 3958 هر گه که کند دلم به صحرا آهنگ %~% تا بزداید، از این دل شیدا زنگ(@)(@@) (@@) ناگه زقضا، این فلک آینه رنگ %~% زن روسبیی فرو تراشد، از 
ms394	 سنگ!(@)(@@)(@@)(@@) | عبدالرحمن(@)(@@) (@@) 3959 دستم همه، از زلف تو کوته یابند %~% وز حال شب درازم، آگه یابند(@)(@@) (@@) با بندهآ خود، چرا چنین باید زیست؟ %~% تا بد گویان، میان ما ره یابند!(@)(@@) (@@) 3960 جانا، چوبه خدمتت مرا سوزی هست %~% در هر طرفی، تو را بدآموزی هست!(@)(@@) (@@) دست من و، دامان بدآموزانت %~% آخر پس از این روز، دگر روزی هست!(@)(@@)(@@)(@@) | نمط هفدهم(@)(@@) در سیر آهدن از خوذ واز او(@)(@@) ~~3961 زین واقعه های مشکلم دل بگرف وزخوی بد دل گسلم، دل بگرفت(@)(@@) ~~قصه چه کنم، بی رخ جان افزایت ای جان و دل، از جان و دلم دل بگرفت!(@)(@@) ~~3962 از صحبت هر بیخردم، دل بگرفت وز سرزنش نیک و بدم، دل بگرفت(@)(@@) (@@) از هستی ونیستی، چنان سیر شدم %~% کز جمله جهان و، از خودم دل بگرفت!(@)(@@) ~~3963 عشق تو، ولایت روان بگرفتهست تا بر نفسم، ره دهان بگرفتهست(@)(@@) ~~بی پرتو مهر [روایت، ای جان و جهان طبعم زجهان، دلم زجان بگرفته ست!(@)(@)PageV01P592(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0596.jpg)(@)(@)(@@) (@@) 3964 کردیم بسی جام لبالب خالی %~% تا بو که نهیم بر لبت، لب خالی(@)(@@) (@@) ترسنده از آنیم، که ناگاه زجان %~% بی وصل لبش، کنیم قالب خالی!(@)(@@)(@@)(@@) | خ(@)(@@) ~~تا کی گویی: «غم من از شادی به!» 3965 از دست تو، در شهر توافسانه(@)(@@) شدم %~% مه تو، مه غم تو، وه که دیوانه شدم! %~% غمهای تو را، به طبع پیمانه شدم(@)(@@) (@@) 3966 امروز، ملالی به کمالم دارد %~% باور نکنی، که برچه حالم دارد(@)(@@) (@@) از هرچه بر اندیشهآ مردم گذرد %~% زان چیز و، ز عکس آن ملالم دارد(@)(@@)(@@)(@@) | کمال [اسماعیل](@)(@@) (@@) 3967 بگذشت و، مرا اشک روان بود هنوز %~% و اندرتن من باقی جان، بود هنوز(@)(@@) (@@) می گفت و، مرا گوش بدان بود هنوز: %~% بیچاره فلانی است، جوان بود هنوز!(@)(@@)(@@)(@@) | انوری](@)(@@) ~~3968 چون سایه، دو یدم از پسش روزی چند امروز، چو آفتاب معلومم شد(@)(@@) %~% وز صحبت او، به سایهآ او خرسند %~% کو سایه بر این کار نخواهد افکند!(@)(@@) (@@) غم آب دلم 
ms395	 ببرد، کودست وصال؟ 3969 از خاک در تو، گر کنم رای گریز %~%(@)(@@) انوری %~% جان بر سر آتش است، کوپای گریز؟ %~% باد است، چونیست با تو پروای گریزا(@)(@@)(@@)(@@) | محمد غزنوی(@)(@@) ~~هرگز به جهان که دید، محنت زده ای 3970 خود حال دلی بود پریشان تر از(@)(@@) این؟ %~% خ %~% یا واقعه ای، بی سر و سامان تراز این؟ %~% سرگشتهآ روزگار، حیران تر از این؟(@)(@@) (@@) 3971 نابوده به کام دل خوش یک نفسی %~% نه بسته به دام وصل مرغ هوسی(@)(@@) (@@) نه یار به دست و، نه به دل دسترسی %~% چون بر خورد الحق، زچنین عمر کسی PageV01P593(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0597.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~3972 شک نیست، که تو بنده بسی خواهی یافت صد بنده چومن، هر نفسی خواهی یافت(@)(@@) (@@) بر بندهآ بیچاره ببخشای، اگر %~% بیچارهتر از بنده، کسی خواهی یافت(@)(@@) (@@) 3973 هر لحظه مرا به عشق، رایی افتد %~% وین دل که به جای نیست، جابی افتد(@)(@@) (@@) گر خاک وجود خویش، برباد دهم %~% هر ذره ، به کوی دلر بایی افتد!(@)(@@) (@@) 3974 کس نیست، چومن سوخته زار افتاده %~% وز کردهآ خود ز چشم یار افتاده(@)(@@) (@@) عشق آمده، صبر رفته، درد افزوده %~% خرجسته، رسن گسسته، بار افتاده!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3975 در پای دلم زعشق، خاری است عجب حال من و کارعشق، کاری است عجب(@)(@@) (@@) قصه چه کنم دراز، [دانی] که مرا %~% یاری ودلی و روزگاری است عجب!(@)(@@) (@@) 3976 سودای غم دلگسلم بگرفتهست %~% جانم ببرد، که مشکلم بگرفتهست(@)(@@) (@@) گر مرگ فروشند، به صد جان بخرم %~% کز زندگیی چنین، دلم بگرفتهست!(@)(@@) (@@) 3977 عمرم، همه بر بوک و مگرمی گذرد %~% هر روز، به محنتی دگر می گذرد(@)(@@) (@@) ایام جوانی، که خوشش می گویند %~% بر من زدل، از هر چه بتر می گذرد!(@)(@@)(@@)(@@) | قاضی کمال(@)(@@) ~~3978 ای ابر، چه خواهی زمن و کینهآ من؟ دورم چه کنی، زیار دیرینهآ من؟(@)(@@) ~~هر قطرهآ آبی، که همی باری تویک شعلهآ آتش است، در سینهآ من!(@)(@@) (@@) 3979 آن کس که به ماتمی، دلی ریش کند %~% وزحسرت و درد، 
