ms101	 % % إلى غير ايدي الألأمين الشرابث % % 46(@)(@@) % تذللكم لقياي باليأس منكم % % ولم أتذلل للمطال الملابث % 47(@)(@@) % فشكرا لمن لم يجعل الرزق عندكم % % فلا ري ظمآن ولا شبع غارث % 48(@)(@@) % لئن ساءكم مني حزون خلائقي % % فقد طال ما لم انتفع بالدمائث % % 49(@)(@@) % خذوها كاطواق الحمام فانها % % ستبقى بقاء الراسيات اللوابث % % 50(@)(@@) % قوافي يقطرن النجيع كانما % % طبعن على طبع الرقاق الفوارث % % PageV01P352 51(@)(@@) % إذا ما مطلناهن بقيا عليكم % خرجن خروج الخالعين النواكث % 52(@)(@@) % فآليت لا أعطي اللئام مقادة % ولو تحت ضغاط من الامر كارث % % 53(@)(@@) % ذنوبي أن استمطرت من غير ماطر % وأني طلبت الغيث من غير غائث % PageV01P353 البحر : طويل 1(@)(@@) % وان لنا النار القديمة للقرى % % تورث من اولى الزمان وتورث % % 2(@)(@@) % لنا القدم الأولى إلى كل غاية % وسعيان شيء فارط وملبث % % 3(@)(@@) % وفي الناس أخياف جهام وماطر % وناب ، ومضاء ، وباز ، وأبغث % PageV01P354 البحر : طويل 1(@)(@@) % لي الحرب معطوفا علي هياجها % % وظل جوادي قيظها وعجاجها % % 2(@)(@@) % ويأنف عزمي ان يرد رماحها % % اذا اشتبهت خرصانها وزجاجها % % 3(@)(@@) % فما بال بغداد اذا اشتقت رحلة % % تشبث بي غيطانها وفجاجها % % 4(@)(@@) % كأن لها دينا علي ، وإنني % % سيطلبها سيقي وديني خراجها % % 5(@)(@@) % ابغداد مالي فيك نهلة شارب % % من العيش الا والخطوب مزاجها % % 6(@)(@@) % ولو أنني أرضى بأدنى معيشة % لأرضت منائي عند أهليك حاجها % % 7(@)(@@) % ولكنني جار على حكم همة % كثير عن الطبع الذليل انعراجها % % 8(@)(@@) % يخيل لي ان الاماني غياهب % % ولا تنجلي الا وعزمي سراجها % % PageV01P355 البحر : وافر تام 1(@)(@@) % أداري المقلتين عن ابن ليلى % % ويأبى دمعها إلا لجاجا % % 2(@)(@@) % لها ثبط على الايام باق % % تجيش بها معينا أو اجاجا % % 3(@)(@@) % كأن بها ركية مستميت % يخضخضها بكورا وادلاجا % 4(@)(@@) % أذود النفس عنه ، وذاك منها % % عنان ما ملكت له معاجا % % 5(@)(@@) % كان العين بعد اليوم جرح % % إذا طبوا له غلب العلاجا % % 6(@)(@@) % تجم على القذى وتفيض دمعا % مطل الداء وادع ثم هاجا % % 7(@)(@@) % واين كفارس الفرسان عمرو % % اذا رزء من الحدثان فاجا % % 8(@)(@@) % بحق كان أولهم ولوجا % على هول وآخرهم خراجا % % 9(@)(@@) % اذا 
ms102	 رسبت حصاة القلب منه % % طفا قلب الجبان به انزعاجا % % 10(@)(@@) % بكيتك للسوابق موضعات % قماص السرب أعجز أن يعاجا % % PageV01P356 11(@)(@@) % يقرطها الاعنة مبدلات % % مكان جلالها العلق المجاجا % % 12(@)(@@) % يدعن على الاجالد موضحات % % كأن على مفارقها شجاجا % % 13(@)(@@) % وارقاص المطي على وجاها % % يجبن إلى العلى طرقا نهاجا % % 14(@)(@@) % مرنقة العيون كأن فيها % % دهان مواقد يصف الزجاجا % % 15(@)(@@) % ورثت عن الابين قنا وبأسا % فأنفقت اللهاذم والزجاجا % % 16(@)(@@) % ومنخرق اخوت السيف فيه % % وحبل الليل يندمج اندماجا % % 17(@)(@@) % أرابك ، فاكتلأت بغير رمح % كأن على عوامله سراجا % % 18(@)(@@) % توقر جاشك الاهوال فيه % % اذا اعتلج الجبان به اعتلاجا % % 19(@)(@@) % وقد جاب الذميل عليك وهنا % من الظلماء مدرعة وساجا % % 20(@)(@@) % ومزلقة ترش بها المنايا % % وتسمع للقلوب بها رجاجا % % PageV01P357 21(@)(@@) % وفقت بشوك أخمصك العوالي % % ويلقى المرء للغم انفراجا % % 22(@)(@@) % ومظلمة من الغمرات عطشى % % جعلت لها من القضب انبلاجا % % 23(@)(@@) % ومائلة أقمت لها كعوبا % وقد شغرت على القوم اعوجاجا % % 24(@)(@@) % وداهية تشول بالذنابى % % غدوت لباب مطلعها رتاجا % % 25(@)(@@) % ومعضلة كفيت وذات وهي % % شددت لها العراقي والعناجا % % 26(@)(@@) % وفاصلة كسيل الطود عجلى % % قطعت بها التشادق والضجاجا % % 27(@)(@@) % وآنية اللحوم من القضايا % % اعدت لهن كيا أو نضاجا % % 28(@)(@@) % وشاردة ربطت لها الحوايا % % وقد مرح البطان بها وماجا % % 29(@)(@@) % وراي يفرق الجلى ويهدي % % وراء مضيقها سبلا فجاجا % % 30(@)(@@) % قطعت بمطربيه على تمار % خلاج الشك ، إن له خلاجا % % PageV01P358 31(@)(@@) % كانك صبت منه بذات فرع % % على البوغاء لبدت العجاجا % % 32(@)(@@) % كمزلقة الذباب اذا امرت % % على ذي الداء بالغت الوداجا % % 33(@)(@@) % لئن نبحته آونة كلاب % لقد لبست به الأسد المهاجا % % 34(@)(@@) % فمن يزع العريب اذا تناغت % % ويضرب بين غاربها سياجا % % 35(@)(@@) % ويذكرها الحلوم على تناس % % وقد بلغت حفائظها الهياجا % % 36(@)(@@) % يحاججها عن الأرحام ، حتى % % يقر القوم ان له الحجاجا % % 37(@)(@@) % ومن رد النقائذ بعد يأس % وقد جاوزن ضورا والولاجا % % 38(@)(@@) % تغلغل في النفاق قني سعد % % رواغ الذئب قد ولج الحراجا % % 39(@)(@@) % تمادحت الرباب به وكانت % % تنابز بالمعائب أو تهاجا % % 40(@)(@@) % برغمي ان يكن قنا تميم % % قضين 
ms103	 على الذنائب منك حاجا % % PageV01P359 41(@)(@@) % حميت منابت الرمرام منهم % واخليت الاناعم والنباجا % % 42(@)(@@) % منعتهم اللقاح وملقحات % % يكاد الخوف يمنعها التناجا % % 43(@)(@@) % فما لقحت لهم الا اختلاسا % ولا ولدت لهم إلا خداجا % % 44(@)(@@) % أبى الباغون مثل مداك إلا % ضلالا عن طريقك وانعراجا % % 45(@)(@@) % سابعثها عليك مسقفات % % طباق الأرض ، أطلعها الفجاجا % % 46(@)(@@) % مسالات الاغرة ملجمات % % وحادا أو مقرنة زواجا % % 47(@)(@@) % وأجعلها سلوا بعد يأس % ومن الم الصدا ورد الاجاجا % % 48(@)(@@) % اقاض حق قبرك ذوا غرام % % اعادج الركب عن طرب وعاجا % % 49(@)(@@) % يريق عليك ماء القلب صرفا % وماء العين يجعله مزاجا % % 50(@)(@@) % ولو بلغ المنى انسان عيني % % خلا منها وأسكنك الحجاجا % % PageV01P360 البحر : مجزوء الكامل 1(@)(@@) % لا تيأسن ، فربما % % عظم البلاء وفرجا % % 2(@)(@@) % قد ينسخ الخوف الامان % % ويغلب اليأس الرجا % % PageV01P361 البحر : كامل تام 1(@)(@@) % اني اذا حلب البخيل لبانها % % أمسيت أحلبها دم الأوداج % 2(@)(@@) % خطبتني الدنيا فقلت لها ارجعي % % اني اراك كثيرة الازواج % % PageV01P362 البحر : سريع 1(@)(@@) % والعيس قد نشف منها السرى % % صفو العريكات ونقى الأجاج % % 2(@)(@@) % لم يبق الا مضغ لاكها % % طول الطوى واسترطتها الفجاج % % PageV01P363 البحر : وافر تام 1(@)(@@) % أغار على ثراك من الرياح % وأسأل عن غديرك والمراح % 2(@)(@@) % وأجهر بالسلام ودون صوتي % % منيع لا يجاوز بالصياح % % 3(@)(@@) % وأهوى أن يخالطك الخزامى % % ويلمع في أباطحك الأقاحي % % 4(@)(@@) % وكم لي نحو أرضك من مسير % دفعت به الغدو إلى الرواح % 5(@)(@@) % وهذا الدهر خفض من عرامي % % ورنق من غبوقي واصطباحي % % 6(@)(@@) % وقد كان الملام يطيف مني % % بمنجذب العنان إلى الجماح % % 7(@)(@@) % تؤول النائبات إلى مرادي % % ويعطيني الزمان على اقتراحي % % 8(@)(@@) % وعالية السوالف والهوادي % % تدافع في الاسنة والصفاح % % 9(@)(@@) % اذا استقصين غامضة الدياجي % % فقأت بهن عاشية الصباح % 10(@)(@@) % ومدرع سموت له مغذا % % وقد غرض المقارع بالرماح % PageV01P364 11(@)(@@) % بنافذة تمطق عن نجيع % تمطق شارب المقر الصراح % % 12(@)(@@) % وأخرى في الضلوع لها هدير % هدير الفحل قرب للقاح % % 13(@)(@@) % فما لي تطلب الأعداء حربي % % ويصبح جانبي غرض اللواح % 14(@)(@@) % أبا هرم ، وأنت تريد ضيمي % % بأي يد تطامن من طماحي % % 15 
ms104	(@)(@@) % لحقت أبي نزاعا في المعالي % % وعرقا في الشجاعة والسماح % % 16(@)(@@) % وانت فما لحقت اباك الا % % كما لحق الذنابى بالجناح % 17(@)(@@) % نميت من العقوق إلى المخازي % % كما ينمى الهرير إلى النباح % 18(@)(@@) % فنحن نرى مكانك من نزار % مكان الداء في الأدم الصحاح % 19(@)(@@) % بني مطر دعوا العلياء يطلع % % إليها كل منذلق وقاح % 20(@)(@@) % وولوا عن مقارعة المنايا : % ولقيان الملمة الرداح % % PageV01P365 21(@)(@@) % ايخفى لؤم اصلكم وهذي % % قروفكم تنم على الجراح % % 22(@)(@@) % تعيرنا القبائل أن قطعنا % % قرائن عامر وبني رياح % 23(@)(@@) % وعلقنا مطامعنا بحبل % تعلقه القلوب بغير راح % 24(@)(@@) % وكلهم يجرون العوالي % % محافظة على عشب البطاح % % 25(@)(@@) % فبلغ سادة الأحياء أنا % % سلونا بالغنا ضرب القداح % % 26(@)(@@) % وعفنا القاع نسكنه وملنا % % عن السمرات والنعم المراح % 27(@)(@@) % وطبقت العراق لنا قباب % % نظللها باطراف الرماح % % 28(@)(@@) % نعلل بالزلال من الغوادي % % ونتحف بالنسيم من الرياح % 29(@)(@@) % وجاورنا الخليفة حيث تسمو % % عرانين الرجال إلى الطماح % % 30(@)(@@) % نوجه بالثناء له مصونا % ونرتع منه في مال مباح % PageV01P366 31(@)(@@) % وسيال اليدين من العطايا % % مهيب الجد مأمون المزاح % % 32(@)(@@) % اذا ابتدر الملام ندى يديه % % مضى طلقا على سنن المراح % % 33(@)(@@) % أمير المؤمنين أذال سيري % % ذرى هذي المعبدة الرزاح % 34(@)(@@) % فكم خاض المطي إليك بحرا % يموج على الأماعز والضواحي % % 35(@)(@@) % سراب كالغدير تعوم فيه % ربا كغوارب الابل القماح % % 36(@)(@@) % وكم لك من غرام بالمعالي % % وهم في الاماني وارتياح % % 37(@)(@@) % وايام تشن بها المنايا % % عوابس يطلعن من النواحي % % 38(@)(@@) % اذا ريع الشجاع بهن قلنا % % لأمر غض بالماء القراح % 39(@)(@@) % فلانقل المهيمن عنك ظلا % من النعماء ليس بمستباح % 40(@)(@@) % وواجهك الثناء بكل أرض % معاونة لشكري وامتداحي % % PageV01P367 البحر : وافر تام 1(@)(@@) % تخطينا الصفوف إلى رواق % % تحجب بالصوارم والرماح % % 2(@)(@@) % وحيينا عظيما من قريش % % كان جبينه فلق الصباح % % 3(@)(@@) % عليه سيمياء الملك يبدو % % وعنوان الشجاعة والسماح % % PageV01P368 البحر : بسيط تام 1(@)(@@) % مثال عينيك في الظبى الذي سخا % % ولى ، وما دمل القلب الذي جرحا % % 2(@)(@@) % فرحت أقبض أثناء الحشا كمدا % وراح يبسط اثناء الخطى مرحا % % 3(@)(@@) % صفحت عن دم 
ms105	 قلب طله هدرا % % بقيا عليه ، فما أبقى ولا صفحا % % 4(@)(@@) % حمى له كل مرعى سهم مقتله % % ومورد الماء مغبوقا ومصطبحا % % 5(@)(@@) % اما تح انت غرب الدمع من كمد % % على الظعائن اذ جاوزن مطلحا % % 6(@)(@@) % أتبعتهم نظرا تدمى أواخره % وقد رملن على رمل العقيق ضحى % % 7(@)(@@) % فيهن أحوى غضيض الطرف رعيته % حب القلوب إذا ما راد أو سرحا % % 8(@)(@@) % عندي من الدمع ما لو كان وارده % مطي قومك يوم الجزع ما نزحا % % 9(@)(@@) % غادرن اسوان ممطورا بعبرته % % ينحو مع البارق العلوي أين نحا % % 10(@)(@@) % يروعه الركب مجتازا ويزعجه % % زجر الحداة تشل الاينق الطلحا % % PageV01P369 11(@)(@@) % هل يبلغنهم النفس التي ذهبت % فيهم شعاعا أو القلب الذي قرحا % % 12(@)(@@) % ان هان سفح دمي بالبين عندهم % % فواجب أن يهون الدمع إن سفحا % % 13(@)(@@) % قل للعواذل مهلا فالمشيب غدا % يغدو عقال لذي القلب الذي طمحا % % 14(@)(@@) % هيهات أحوج مع شيبي إلى عذل % فالشيب اعذل ممن لامني ولحا % % 15(@)(@@) % قف طالعا أيها الساعي ليدركني % % فبعدك الجزع المغرور قد قرحا % % 16(@)(@@) % لا عز اخبثنا عرقا واهجننا % % اما واصلدنا زندا اذا قدحا % % 17(@)(@@) % ظن راسك قد اعياك محمله % % ورب ثقل تمناه الذي طرحا % % 18(@)(@@) % كم المقام على جيل سواسية % نرجو الندى من إناء قل ما رشحا % % 19(@)(@@) % تشاغل الناس باستدفاع شرهم % % عن ان يسومهم الاعطاء والمنحا % % 20(@)(@@) % في كل يوم يناديني لبيعته % مشمر في عنان الغي قد جمحا % % PageV01P370 21(@)(@@) % ان تمنين لمنديل اذا لكم % % متى يشا ماسح منكم بها مسحا % % 22(@)(@@) % الام اصفيكم ودي على مضض % % وكم أنير وأسدي فيكم المدحا % % 23(@)(@@) % يروم نصحي أقوام وروا كبدي % % والعجز أن يجعل الموتور منتصحا % % 24(@)(@@) % ارى جناني قد جاشت حلائبه % % ما يمنع القلب من فيض وقد طفحا % % 25(@)(@@) % شمر ذويلك ، واركبها مذكرة % واطلب عن الوطن المذموم منتدحا % % 26(@)(@@) % وحمل الهم ، إن عناك نازله % غوارب الليل والعيرانة السرحا % % 27(@)(@@) % وانفض رجالا سقوك الغيظ أذنبة % وأورثوك مضيض الداء والكشحا % % 28(@)(@@) % ان عاينوا نعمة ماتوا بها كمدا % وان رأوا غمة طاروا بها فرحا % % 29 
ms106	(@)(@@) % أوهت أكفهم بيني وبينهم % فتقا بغير العوالي قل ما نصحا % % 30(@)(@@) % نالوا المعالي ولم تعرق جباههم % % فيها لغوبا ، وما نال الذي كدحا % % PageV01P371 31(@)(@@) % سائل عن الطود لم خفت قواعده % % وكان ان مال مقدار به رجحا % % 32(@)(@@) % قد جربوه ، فما لانت شكيمته % وحملوه فما اعيا ولا رزحا % % 33(@)(@@) % رموا به الغرض الأقصى ، فشافهه % مر القطامى جلى بعد ما لمحا % % 34(@)(@@) % من العراق إلى اجبال خرمة % يا بعده منبذا عنا ومطرحا % % 35(@)(@@) % ليس الملوم الذي شد اليدين به % % بل الملوم المرزا من به سمحا % % 36(@)(@@) % هو الحسام ، فمن تعلق يداه به % % يضمم على الصفقة العظمى وقد ربحا % % 37(@)(@@) % ان اغمدوه فلم تغمد فضائله % % ولا نأى ذكره الداني ، وقد نزحا % % 38(@)(@@) % أهدى السلام إليك الله ما حملت % غوارب الإبل الغادين والروحا % % 39(@)(@@) % ولا اغب بلادا انت ساكنها % % مسرى نسيم يميط الداء إن نفحا % % 40(@)(@@) % أغدو على سبل الأنواء مشترطا % سقياك في البلد النآي ومقترحا % % PageV01P372 41(@)(@@) % افردت للهم صدرا منك متسعا % على الهموم ، وقلبا منك منشرحا % % 42(@)(@@) % كساهم البهمة الدهماء عجزهم % % والعزم البسك التحجيل والفرحا % % 43(@)(@@) % عل الليالي أن تثنى بعاطفة % فيستقيل زمان بعدما اجترحا % % 44(@)(@@) % كما رمى الداء عضوا بعد صحته % كذا اذا التاث عضور بما اصطلحا % % 45(@)(@@) % وكم تلاحم كرب عند معضلة % فانجاب عن قدر لله ، وانفسحا % % 46(@)(@@) % ارى رجالا كبهم القاع عندهم % % سيان من مزق الآراء أو صرحا % % 47(@)(@@) % يعلو على قلل الاعناق بينهم % % من غش رئا ويوطا عنق من نصحا % % 48(@)(@@) % تظاهروا بنفاق الغي عندهم % حتى ادعاه على مكروهه الفصحا % % PageV01P373 البحر : متقارب تام 1(@)(@@) % برؤم السيوف وغرب الرماح % عقدنا لواء العلى والسماح % % 2(@)(@@) % وكل غلام حيي اللحاظ % يلقى الطعان برمح وقاح % 3(@)(@@) % إذا مطل الثار جر القنا % % نشاوى تقاضى صدور الصفاح % % 4(@)(@@) % فأغمدها في احمرار الشقي % % وجردها في بياض الاقاح % % 5(@)(@@) % بكل فلاة تقود الجياد % % تعثر فيها ببيض الأداحي % % 6(@)(@@) % فليلجم اعناقها بالجبال % % وينعل ارساغها بالبطاح % % 7(@)(@@) % وأشقر يسرق صبغ المدا % % انهبت جلدته للسلاح % % 8(@)(@@) % اذا يابس الماء بل الحزام 
ms107	 % % طارت به غلواء المراح % % 9(@)(@@) % تجول القرون باعطافه % % مجال الفواقع في كاس راح % 10(@)(@@) % يشق الظلام بسيف الضحى % % ويرمي الغدو بسهم الرواح % PageV01P374 11(@)(@@) % فيا راكب العجز مرخي العنان % % للذل يخبط ، والعز ضاح % 12(@)(@@) % تقاض المطالب واستنبط ال % % رجاء ونبه عيون النجاح % 13(@)(@@) % فلولا المطامع تحدو الطلاب % لما خفقت قادمات الجناح % 14(@)(@@) % وما العيش عندي الا الاباء % % وبعدي عن المنزل المستباح % % 15(@)(@@) % أحب الخيام وسكانها % % وأحسد كل بعيد المراح % 16(@)(@@) % وأغبط كل فتى لا يزال % عبئا على الزاعبات القماح % 17(@)(@@) % يخاطر فيها بعقز السوام % ويشرب منها لبان اللقاح % 18(@)(@@) % طروب المسامع اين استقل % % صهيل الجياد وجرس النباح % 19(@)(@@) % ومن لي بأن أتلافى الخطوب % ان نافرتني صدور الرماح % % 20(@)(@@) % ومن لي بتقبيل كف الزما % % ن من قبل توقيعها باطراحي % % PageV01P375 21(@)(@@) % كبا الدهر بيني وبين المنى % % وطال بزند الرجاء اقتداحي % % 22(@)(@@) % ارى الحلم يطوي سباب الرجال % % والجهل ينشره في التلاحي % % 23(@)(@@) % فيحسب عيا سكوت الحليم % ويعطى السفيه حظوظ الفصاح % 24(@)(@@) % أكاشر أبناء هذا الزمان % وأهزأ من نبلهم بامتداحي % % 25(@)(@@) % فبين البواطن حل الطلاق % وبين الظواهر عقد النكاح % 26(@)(@@) % وإني لأحفظ غيب الخليل % إن ضاع واستلبته اللواحي % % 27(@)(@@) % واني لاقصف بطش الفتى % % ولو رد باع القضاء المتاح % 28(@)(@@) % تكدر دوني نطاف الكلام % وأصقلها بالبيان الصراح % 29(@)(@@) % أدافع بالجد عن غاية % ولو شئت بلغتها بالمزاح % 30(@)(@@) % أراني سيخلق عمري الزمان % وكل ظلام جديد الصباح % % PageV01P376 31(@)(@@) % زجرت السرور فما يجتنى % % بغير العلى طلبي وارتياحي % % 32(@)(@@) % فبالله يا نشوات الشمول % عودي إلى نفحات الرياح % 33(@)(@@) % وصوني عن السكر من لا يزال % يندي المدام بماء القراح % 34(@)(@@) % اعاف ابنة الكرم لا ابن الغمام % % بين غبوقي وبين اصطباحي % % 35(@)(@@) % يمر الغناء فيعتاقني % % وعشق الحروب ثني من جماحي % % 36(@)(@@) % ولو لم أغن بذكر السيوف % لقل على النغمات ارتياحي % % 37(@)(@@) % وسمراء ترشف ظلم القلو % % قذافة بالنجيع المباح % % 38(@)(@@) % تطارد في كل ملمومة % منطقة بالعوالي رداح % % 39(@)(@@) % تريق عليها كؤوس الدما % % بالطعن والموت نشوان صاح % % 40(@)(@@) % فنخضب فيها جباه الظبى % % ونرمد فيها 
ms108	 عيون الجراح % PageV01P377 41(@)(@@) % كأنا نرى الضرب نحر السوام % ونحتسب الطعن ضرب الصفاح % % 42(@)(@@) % فمن ذا أسامي ، وجدي النبي % أم من أطاول أم من ألاحي % % 43(@)(@@) % انا ابن الائمة والنازلين % % كل منيع الربى والبراح % 44(@)(@@) % وايد تصافح ايدي الكرام % % وإن نفرت من أكف الشحاح % 45(@)(@@) % اذا استصرخوا عصفوا بالصباح % % بين الظبي والوجوه الصباح % % 46(@)(@@) % وسالوا إلى الطعن سيل القنا % % ومالوا على الضرب ميل الصفاح % % 47(@)(@@) % نشرنا على عذبات الرياح % % ح كل لواء صقيل النواحي % % 48(@)(@@) % وأحسابنا ساميات الأنوف % بين المقام وبين الضراح % PageV01P378 البحر : كامل تام 1(@)(@@) % بعض الملام فقد غضضت طماحي % % وكفيت من نفسي العذول اللاحي % % 2(@)(@@) % من بعد ما خطر الصبا بمقادتي % % وجرى إلى الامد البعيد جماحي % % 3(@)(@@) % عشرون اوجف في البطالة خلفها % % عامان غلا من يدي مراحي % % 4(@)(@@) % زمن يخف به الجناح إلى الصبا % % لما ظفرت به خفضت جناحي % % 5(@)(@@) % أغضي عن المرأى الأنيق زهادة % فيه وادفع لذتي بالراح % % 6(@)(@@) % أمعاهد الأحباب ! هل عود إلى % % مغدى نبل به الجوى ومراح % % 7(@)(@@) % يكفيك من انفاسنا ودموعنا % % ان تمطري من بعدنا وتراحي % % 8(@)(@@) % فلرب عيش فيك رق نسيمه % كالماء رق على جنوب بطاح % 9(@)(@@) % وتغزل كصبا الأصائل أيقظت % ريا خزامى باللوى واقاح % % 10(@)(@@) % كم فيك من صاح الشمائل منتش % % بالذل ، أو مرضى العيون صحاح % PageV01P379 11(@)(@@) % فسقى اللوى صوب الغمام ودره % وسقى النوازل فيه صوب الراح % % 12(@)(@@) % وغدا فروح ذاك عن تلك الربى % % وسرى فروح ذاعن الارواح % % 13(@)(@@) % فلطالما اقصدنني ظبياته % % وارقت فيه لبارق لماح % % 14(@)(@@) % والتحت من كمد إليه ، وورده % ناء يعذب غلة الملتاح % 15(@)(@@) % أيام في صبغ الشباب ذوائبي % % وإلى التصابي غدوتي ورواحي % % 16(@)(@@) % قومي أنوف بني معد والذرى % % من واضح فيهم ومن وضاح % % 17(@)(@@) % السابقون إلى علا ومفاخر % % والغالبون على ندى وسماح % % 18(@)(@@) % ذهبوا بشأو المجد ثم تلفتوا % % هزوا إلى الطلاع والطلاح % % 19(@)(@@) % شوس الحواجب مغضبين وفي الرضى % % ما شئت من بيض الوجوه صباح % % 20(@)(@@) % ورثوا المعالي بالجدود وبعدها % % بضراب مرهفة وطعن رماح % % PageV01P380 21(@)(@@) % وقياد مخطفة الخصور كانها % % العقبان 
ms109	 تحت مجلجل دلاح % 22(@)(@@) % يغبقن ليلا بالغبيق وتارة % % يصبحن بالغارات كل صباح % % 23(@)(@@) % ضربت بعرقي دوحة نبوية % في منصب واري الزناد صراح % % 24(@)(@@) % ينمى إلى أعياص خير أرومة % ليست بعشات الفروع ضواح % 25(@)(@@) % وابي الذي حصد الرقاب بسيفه % % في كل يوم تصادم ونطاح % 26(@)(@@) % ردت إليه الشمس يحدث ضوءها % % صبحا على بعد من الاصباح % % 27(@)(@@) % سائل به يوم الزبير مشمرا % يختال بين ذوابل وصفاح % 28(@)(@@) % واسأل به صفين إن زئيره % اودي بكبش امية النطاح % % 29(@)(@@) % واسأل شراة النهروان ، فإنهم % ضربوا بمنذلق اليدين وقاح % 30(@)(@@) % كم من طعين يوم ذاك مرمل % % وحريم عز بالطعان مباح % PageV01P381 31(@)(@@) % ومناقب بيض الوجوه مضئة % % أبدا ، تكاثر ألسن المداح % 32(@)(@@) % من قاس ذا شرف به فكأنما % % وزن الجبال القود بالاشباح % % 33(@)(@@) % قد قلت للعادي علي ببغيه % % مهلا فما يلحو القتادة لاحي % % 34(@)(@@) % فحذار إن مطرت عليك صواعقي % % وحذار ان هبت عليك رياحي % % 35(@)(@@) % أو في الصباح فشق كل دجنة % % وعلا الزئير فغض كل نباح % % 36(@)(@@) % أنا من علمت ، على المكاشح مرهف % نابي وشاك في الخصام سلاحي % % 37(@)(@@) % وابيت ان اعطي الاعادي مقودي % % أو ان تدر على الهوان لقاحي % % 38(@)(@@) % من بعد ما أوضعت في طرق العلى % % وأضر بالاعداء طول كفاحي % % 39(@)(@@) % وسحبت من خلع الخلائف طارفا % لحظات كل معاند طماح % 40(@)(@@) % ووليا في السن القريبة اسرتي % % فوكلت فاسدهم إلى اصلاحي % % PageV01P382 41(@)(@@) % بمهابة عمت بغير تكبر % وصرامة أدمت بغير جراح % 42(@)(@@) % حلم كحاشية الرداء ، ودونه % بأس يدق عوامل الارماح % % 43(@)(@@) % فلئن علوتهم ، فليس بمنكر % اما علت غرر على اوضاح % % 44(@)(@@) % فالان امدح غير مولى نعمة % % لو كنت أنصف كان من مداحي % % 45(@)(@@) % بعدا لدهر خاض بي أهواله % واجازني غمرا إلى ضحضاح % % 46(@)(@@) % لادر دري ان رضيت بذلة % % تلوي يدي وترد غرب طماحي % % 47(@)(@@) % من دون قود الجرد تمري جريها % % ربلات كل مغامر جحجاح % % 48(@)(@@) % عنقا على عنق الطلاب تحثها % % همم ضمن عوائد الانجاح % % 49(@)(@@) % فظع البلاد وراء قاضية العلى % % متغربا عن موطني ومراحي % % 50(@)(@@) % اشهى الي من 
ms110	 النعيم يدوم لي % % والذ من نعم علي مراح % % PageV01P383 51(@)(@@) % انى إلى العذب النمير اصابني % % بيد الهوان شربت بالأملاح % 52(@)(@@) % دعني اخاطر بالحيوة وانما % % طلب الرجال العز ضرب قداح % % 53(@)(@@) % اما لقاء الملك قسرا أو كما % % لقى ابن حجر من يدي الطماح % % PageV01P384 البحر : سريع 1(@)(@@) % نبهتهم مثل عوالي الرماح % إلى الوغى قبل نموم الصباح % 2(@)(@@) % فوارس نالوا المنى بالقنا % % وصافحوا اعراضهم بالصفاح % % 3(@)(@@) % لغارة سامع انبائها % % يغص منها بالزلال القراح % % 4(@)(@@) % ليس على مضرمها سبة % ولا على المجلب منها جناح % % 5(@)(@@) % دونكم ، فابتدروا غنمها % % دمى مباحات ، ومال مباح % 6(@)(@@) % فاننا في ارض اعدائنا % % لا نطأ العذراء إلا سفاح % 7(@)(@@) % يا نفس من هم إلى همة % فليس من عبء الأذى مستراح % 8(@)(@@) % قد آن للقلب الذي كده % طول مناجاة المنى أن يراح % 9(@)(@@) % لا بد أن أركبها صعبة % وقاحة تحت غلام وقاح % 10(@)(@@) % يجهدها ، أو ينثني بالردى % % دون الذي قدر أو بالنجاح % % PageV01P385 11(@)(@@) % الراح والراحة ذل الفتى % % والعز في شرب ضريب اللقاح % % 12(@)(@@) % في حيث لا حكم لغير القنا % % ولا مطاع غير داعي الكفاح % 13(@)(@@) % ما أطيب الأمر ، ولو أنه % على رزايا نعم في مراح % % 14(@)(@@) % وأشعث المفرق ذي همة % طوحه الهم بعيدا فطاح % % 15(@)(@@) % لما رأى الصبر مضرا به % راح ، ومن لم يطق الذل راح % 16(@)(@@) % دفعا بصدر السيف لما رأى % % ألا يرد الضيم دفعا براح % 17(@)(@@) % متى ارى الزوراء مرتجة % % تمطر بالبيض الظبي أو تراح % % 18(@)(@@) % يصيح فيها الموت عن ألسن % من العوالي والمواضي فصاح % % 19(@)(@@) % بكل روعاء عظينية % % يحتثها أروع شاكي السلاح % 20(@)(@@) % كانما ينظر من ظلها % % نعامة زيافة بالجناح % % PageV01P386 21(@)(@@) % متى ارى الأرض وقد زلزلت % % بعارض اغبر دامي النواح % % 22(@)(@@) % متى ارى الناس وقد صبحوا % % أوائل اليوم بطعن صراح % 23(@)(@@) % يلتفت الهارب في عطفه % مروعا يرقب وقع الجراح % % 24(@)(@@) % متى ارى البيض وقد امطرت % % سيل دم يغلب سيل البطاح % 25(@)(@@) % متى ارى البيضة مصدوعة % % عن كل نشوان طويل المراح % % 26(@)(@@) % مضمخ الجيد نؤوم الضحى % % كأنه العذراء ذات الوشاح 
ms111	 % 27(@)(@@) % اذا رداح الروع عنت له % % فرالى ضم الكعاب الرداح % % 28(@)(@@) % قوم رضوا بالعجز واستبدلوا % % بالسيف يدمى غربه كاس راح % % 29(@)(@@) % توارثوا الملك ، ولو أنجبوا % % لورثوه عن طعان الرماح % 30(@)(@@) % غطى رداء العز عوراتهم % فافتضحوا بالذل أي افتضاح % PageV01P387 31(@)(@@) % إني والشاتم عرضي كمن % روع اساد الشرى بالنباح % % 32(@)(@@) % يطلب شأوى وهو مستيقن % % ان عناني في يمين الجماح % % 33(@)(@@) % فارم بعينيك مليا ترى % % وقع غباري في عيون الطلاح % % 34(@)(@@) % وارق على ظلعك هيهات ان % % يزعزع الطود بمر الرياح % % 35(@)(@@) % لا هم قلبي بركوب العلى % % يوما ولا بل يدي السماح % % 36(@)(@@) % إن لم أنلها باشتراط ، كما % % شئت على بيض الظبى واقتراح % 37(@)(@@) % افوز منها باللباب الذي % % يغني الأماني نيله والصراح % 38(@)(@@) % فما الذي يقعدني عن مدى % % لا هو بالنسل ولا باللقاح % % 39(@)(@@) % طليحة مد باضباعه % % وغر قبلي الناس حتى سجاح % 40(@)(@@) % يطمح من لا مجد يسمو به % % اني اذا اعذر عند الطماح % % PageV01P388 41(@)(@@) % وخطة يضحك منها الردى % % عشراء تبري القوم بري القداح % % 42(@)(@@) % صبرت نفسي عند أهوالها % % وقلت : من هبوتها لا براح % 43(@)(@@) % اما فتى نال العلى فاشتفى % % أو بطل ذاق الردى فاستراح % % PageV01P389 البحر : كامل تام 1(@)(@@) % في كل يوم للأحبة مطرح % وعلى المنازل للمدامع مسفح % 2(@)(@@) % شوق على نأي الديار مغالب % وجوى على طول المطال مبرح % 3(@)(@@) % نفرت بنات الصبر منك وطالما % % قصرت نوازع عن ضميرك تطمح % 4(@)(@@) % يا هل يمانع بعد طول قياده % % قلب يطاوع في القياد ويسمح % % 5(@)(@@) % وعلى المطي ظباء وجرة كلما % % غفل المراقب تشرئب وتسنح % % 6(@)(@@) % خالسننا النظر المريب كما رنت % % بقر الجواء إلى وميض يلمح % % 7(@)(@@) % يبسمن عن برد الغمام وبرده % % ريان يغبق بالمدام ويصبح % % 8(@)(@@) % كلفت عينك نظرة مزؤودة % منعتك لذتها مدامع تسفح % % 9(@)(@@) % أمسوا كأن لطائما دارية % باتت تضوع من القباب وتنفخ % % 10(@)(@@) % ملكوا ولما يحسنوا وولوا ول % يعدلوا وغنوا ولما يسمحوا % % PageV01P390 11(@)(@@) % قل لليالي قد ملكت فاسجحي % % ولغيرك الخلق الكريم الأسجح % 12(@)(@@) % من اي خطب من خطوبك اشتكي % % وعن أي ذنب من ذنوبك 
ms112	 أصفح % 13(@)(@@) % ان اشك فعلك من فراق احبتي % % فلسوء فعلك في عذاري اقبح % % 14(@)(@@) % ضوء تشعشع في سواد ذؤابي % % لا أستضيء به ولا أستصبح % 15(@)(@@) % بعت الشباب به على مقة له % % بيع العليم بانه لا يربح % % 16(@)(@@) % لا تنكرن من الزمان غريبة % % ان الخطوب قليبها لا ينزح % % 17(@)(@@) % للذل بين الأقربين مضاضة % والذل ما بين الاباعد اروح % % 18(@)(@@) % واذا رمتك من الرجال قوارص % % فسهام ذي القربى القريبة اجرح % % 19(@)(@@) % اليس نسيج الذل ان البسته % % متململا ، وإناء قلبك يطفح % 20(@)(@@) % ما دمت تنتظر العواقب لابدا % لا تغتدي لعلى ولا تتروح % % PageV01P391 21(@)(@@) % وضجيعك العضب الذي لا ينتضى % % وخليطك الزور الذي لا يبرح % % 22(@)(@@) % واعلم بأن البيت ، إن أوطنته % سجن وطول الهم غل يجرح % % 23(@)(@@) % أأخي لا تك مضغة مزرودة % تنساغ لينة القياد وتسرح % % 24(@)(@@) % الا ابيت وانت من جمراتها % % ومن العجائب جمرة لا تلفح % 25(@)(@@) % كن شوكة يعيي انتقاش شباتها % % أو حمضة يشجي بها المتملح % % 26(@)(@@) % وانفض يديك من الثراء فكم مضى % % من دون ثروته البخيل المصلح % 27(@)(@@) % يبقى لوارثه كرائم ماله % ولقد يرقع عيشه ويرقح % 28(@)(@@) % قد ينتج المروء العشار بجده % % وسواه يعتام الفحول ويلقح % % 29(@)(@@) % لا عذر الا ان ارى سرباتها % % سوم الجراد يثور منها الابطح % % 30(@)(@@) % والهام تعتصب العجاج كانه % % في الجو شؤبوب الغمام الأملح % PageV01P392 31(@)(@@) % قومي الأولى ضمنت لهم أحسابهم % تان الزمان بمثلهم لا يسمح % % 32(@)(@@) % عركوا أديم الأرض قبل نباتها % % واستفسحوا أعطانها وتفيحوا % % 33(@)(@@) % فتقوا بشزر الطعن اكمام العلى % % وهم جذاع قبائل لم يقرحوا % % 34(@)(@@) % ان اخرجوا لم يجهلوا واذا قضوا % % لم يقسطوا اذا علوا لم يبجحوا % % 35(@)(@@) % ذنبي إلى البهم الكواذب أنني ال % % الطرف المطهم والاغر الاقرح % % 36(@)(@@) % يولونني خزر العيون لانني % % غلست في طلب العلى وتصبحوا % % 37(@)(@@) % وجذبت بالطول الذي لم يجذبوا % % ومتحت بالغرب الذي لم يمتحوا % % 38(@)(@@) % من كل حامل احنة لا تنجلي % % غطشى دجنتها ولا تتوضح % 39(@)(@@) % ضب يداهنني ، ويشكل غيبه % مما يرغى قوله ويصرح % % 40(@)(@@) % يغدوا ومرجل ضغنه متهزم % % أبدا علي ، وجرحه 
ms113	 متقرح % PageV01P393 41(@)(@@) % مسحت جباه الوانيات ولطمت % % من دون غايتها العتاق القرح % 42(@)(@@) % لو لم يكن لي في القلوب مهابة % % لم يطعن الاعداء في ويقدح % % 43(@)(@@) % من خيف خوف الليث خطله الربى % % وعوت لتشهره الكلاب النبح % 44(@)(@@) % نظروا بعين عداوة لو انها % % عين الرضى لاستحسنوا ما استقبحوا % % 45(@)(@@) % ما كان من شعث فاني منهم % % لهم أود على البعاد وأسمح % PageV01P394 البحر : طويل 1(@)(@@) % سليمان لو وفيت مدحي حقه % أريتك أسباب المنى كيف تنجح % % 2(@)(@@) % بسطت يدي حتى ظننتك فابضا % يد الدهر عني ، وهو أزور أكلح % 3(@)(@@) % فأقصدتني باليأس حتى تركتني % % وظني عن نيل الغنى يتزحزح % 4(@)(@@) % وأصعبت لي من بعد ما كنت مسهلا % مغالق بر شارفت تتفتح % 5(@)(@@) % فمن ماله في ذمة كيف يجتدي % % ومن أصله في ظلمه كيف يمدح % % PageV01P395 البحر : وافر تام 1(@)(@@) % أعيذك من هجاء بعد مدح % فعذني من قتال بعد صلح % % 2(@)(@@) % منحتك جل أشعاري فلما % % ظفرت بهن لم أظفر بمنح % % 3(@)(@@) % كبا زندي بحيث رجوت منه % مساعدة الضياء فخاب قدح % % 4(@)(@@) % وكنت مضافري فثلمت سيفي % % وكنت معاضدي فقصفت رمحي % % 5(@)(@@) % وكنت ممنعا فاذل داري % % دخولك ذل ثغر بع فتح % % 6(@)(@@) % فيا ليثا دعوت به ليحمي % % حماي من العدى فاجتاح سرحي % % 7(@)(@@) % ويا طبا رجوت صلاح جسمي % % بكفيه ، فزاد بلاء جرحي % % 8(@)(@@) % ويا قمرا رجوت السير فيه % % فلثمه الدجى عني بجنح % 9(@)(@@) % سأرمي العزم في ثغر الدياجي % % واحدو العيس في سلم وطلح % % 10(@)(@@) % لبشر مصفق الأخلاق عذب % وجود مهذب النشوات سمح % % PageV01P396 11(@)(@@) % وقور ما استخفته الليالي % % ولا خدعته عن جد بمزح % 12(@)(@@) % اذا ليل النوائب مد باعا % ثناه عن عزيمته بصبح % 13(@)(@@) % وان ركض السؤال إلى نداه % % تتبع إثر وطأته بنجح % 14(@)(@@) % وأصرف همتي عن كل نكس % أمل على الضمائر كل برح % 15(@)(@@) % يهددني بقبح بعد حسن % % ولم أر غير قبح بعد قبح % PageV01P397 البحر : طويل 1(@)(@@) % أبثك أني راغب عن معاشر % يضنون بالود القليل واسمح % % 2(@)(@@) % إذا ما جنوا ذنبا علي احتقرته % % فأعفو عن الذنب العظيم وأصفح % 3(@)(@@) % ويظهر 
ms114	 لي قوم بعادا وجفوة % وما علموا أني بذلك أفرح % % PageV01P398 البحر : مجزوء الكامل 1(@)(@@) % صبرا على نوب الزما % % ن وإن أبى القلب القريح % 2(@)(@@) % فلرب مبتسم ، وقد % أخذت مآخذها الجروح % % 3(@)(@@) % يسعى الفتى متماديا % ويد المنون له تليح % % 4(@)(@@) % كم آمل يغدو على الأ % % مل البعيد فلا يروح % % 5(@)(@@) % بينا يشاد له البنا % % حتى يخط له الضريح % % 6(@)(@@) % لا تيأسن من أن تعو % % تعود عوائد وتهب ريح % % 7(@)(@@) % قد يسقط العود الجليد % % د ، وينهض النضو الطليح % 8(@)(@@) % ويفرج الغماء يح % رج عندها العطن الفسيح % 9(@)(@@) % ولكل شيء آخر % إما جميل أو قبيح % PageV01P399 البحر : طويل 1(@)(@@) % ولو كنت فيها يوم ذا الأثل لم تؤب % وزادك إلا ذات ودقين تنضح % 2(@)(@@) % غداة ذبال السمهرية يلتظى % % بأيماننا ، والبيض بالبيض تقدح % 3(@)(@@) % مواقف تنسي المرء ما كان قبلها % % ترى الجذع العامي فيهن يقرح % 4(@)(@@) % كأن سقاط البيض ثم ارتفاعها % % مصاريع أبواب تجاف وتفتح % % 5(@)(@@) % فإن تك قد سقيت مثلي بكاسها % % فما لك يا ذا الضب لا تترنح % 6(@)(@@) % جعلت صحيحا مثل ضامن نقبة % له كل يوم جالب يتقرح % % PageV01P400 البحر : طويل 1(@)(@@) % ألا من عذيري في رجال تواعدوا % % لحربي من رامي عقوق ورامح % % 2(@)(@@) % وغرهم مني اصطبار على الأذى % % وقد يكظم المرء الأذى غير صافح % 3(@)(@@) % فما الجارم الجاني عقوقي بسالم % % ولا الماطل اللاوي ديوني برابح % 4(@)(@@) % أغاروا على ذود من الشعر آمن % تقادم عندي من نتاج القرايح % 5(@)(@@) % فيا ليتهم ادوه في الحي خالصا % ولم يخلطوه بالرزايا الطلايح % 6(@)(@@) % وانك لو موهت كل هجينة % % على ناظر ما عددت في الصرايح % % 7(@)(@@) % أرى كل يوم ، والأعاجيب جمة % على وبر الجربى وسوم الصحايح % 8(@)(@@) % إذا طردوها خالفت برقابها % % رجوعا إلى اوطانها والمسارح % % 9(@)(@@) % وإن أوردوها غير مائي حايدت % حياد عيوف ينكر الماء قامح % % 10(@)(@@) % إذا انجفلت في غارة بت ناظرا % أراقب منها روحة في الروائح % PageV01P401 11(@)(@@) % كأن بني غبراء ، إذ ينهبونها % % أحالوا على مال بذي الدوح سارح % 12(@)(@@) % يرجون منها والاماني ضلة % % رجاء نتاج الحمل من غير 
ms115	 لاقح % 13(@)(@@) % أباغث أضرتها السفاهة ، فاغتدت % تخطف هذا القول خطف الجوارح % % 14(@)(@@) % هبوها اليكم من يدي منيحة % % فقدان ياللقوم رد المنايح % % 15(@)(@@) % دعوا ورد ماء لستم من حلاله % وحلوا الروابي قبل سيل الاباطح % % 16(@)(@@) % ولا تستهبوا العاصفات ، وأصلكم % % نجيل رمت فيه الليالي بقادح % % 17(@)(@@) % فما أنتم من مالئي ذلك الحبا % % ولا فيكم أكفاء تلك المناكح % 18(@)(@@) % ولم تحسنوا رعي السوامخ قبلها % % فكيف تعاطيتم ركوب الجوامح % 19(@)(@@) % ولا تطلبوها سمعة في معرة % تحدث عنكم كل غاد ورايح % 20(@)(@@) % خمول الفتى خير من الذكر بالخنا % % جر ذيول المندبات الفواضح % % PageV01P402 21(@)(@@) % وعندي قواف ان تلقين بالاذى % % نزعن بمر القول نزع المواتح % % 22(@)(@@) % تعدد نبرات الأسود نباهة % وتنسى انابيح الكلاب النوابح % % PageV01P403 البحر : كامل تام 1(@)(@@) % قيدت أزمة كل مزن رائح % متحمل عبء المواطر دالح % % 2(@)(@@) % حتى يشق على العقيق مزاده % من غابق لرياضه أو صابح % % PageV01P404 البحر : متقارب تام 1(@)(@@) % ذكرت على فترة من مراح % % منازل بين قنا فالصفاح % % 2(@)(@@) % وأرضا تبدل قطانها % % بمجر القنا بمجر المساحي % % PageV01P405 البحر : متقارب تام 1(@)(@@) % فلو كنت شاهدها في الدجى % % وقد ضمها البلد الأفيح % % 2(@)(@@) % إذا ذكرتك على ونية % رأيت ذفاريها تنضح % % PageV01P406 البحر : خفيف تام 1(@)(@@) % أبلغا عني الحسين ألوكا % إن ذا الطود بعد عهدك ساخا % % 2(@)(@@) % والشهاب الذي اصطليت لظاه % عكست ضوءه الخطوب فياخا % % 3(@)(@@) % والفنيق الذي تدرع طول الأ % % رض خوى به الرد فأناخا % % 4(@)(@@) % ان ترد مورد القذى وهو راض % % فبما يكرع الزلال النقاخا % % 5(@)(@@) % والعقاب الشغواء اهبطها النيق % % ق ، وقد أرعت النجوم سماخا % % 6(@)(@@) % اعجلتها المنون عنا ولكن % % خلفت في ديارنا أفراخا % % 7(@)(@@) % وعلى ذلك الزمان بهم عاد % % غلاما من بعد ما كان شاخا % % PageV01P407 البحر : طويل 1(@)(@@) % أقول لها حيث انتهى مسقط النقا : % نصلت وأيم الله من رمل مربخ % % 2(@)(@@) % نجوت على ما فيك من ونية السرى % % وطي الموامي سربخا بعد سربخ % % 3(@)(@@) % بحيث الفتى لما يجب دعوة الفتى % % ولا يعطف الأخ الكريم على أخ % % 4(@)(@@) % ولم يبق إلا برزخ ، فاقذفي به % وراءك أن الدار 
ms116	 من بعد برزخ % % PageV01P408 البحر : بسيط تام 1(@)(@@) % إلى كم الطرف بالبيداء معقود % وكم تشكى سراي الضمر القود % % 2(@)(@@) % تعلة لي ، بعد القرب ، تولية % عن المقام ، وبعد النوم تسهيد % 3(@)(@@) % يا دار ذل لمن فارقت قعدته % % والعز أولى بمن علقت يابيد % % 4(@)(@@) % أرمي بأيدي المطايا كل مشتبه % تنبو باخفاقها عنه الجلاميد % % 5(@)(@@) % وكل ليل تظل النجم ظلمته % % قلب الدليل به حيران مزؤود % % 6(@)(@@) % وغلمة في ظهور العيس ارقهم % % هم شعاع ، وآمال عباديد % 7(@)(@@) % ملثمين بما راخت عمائمهم % وكلهم طرب للبين غريد % % 8(@)(@@) % لا آخذ الطعن إلا عن رماحهم % إذا تطاعنت الشم المناجيد % 9(@)(@@) % ورب أمر بعيد الغاي قربني % % منه السوابق والبذل المقاحيد % % 10(@)(@@) % أذم من أجل أشعاري فوا عجبا ! % نجاي من ضيقها سمراء قيدود % PageV01P409 11(@)(@@) % مالي بغير العلى في الأرض مضطرب % % ولا لجنبي بغير العز تمهيد % 12(@)(@@) % ولا خطوت إلى بأس ولا كرم % إلا وموضع رجلي منه موجود % 13(@)(@@) % ضاع الشباب ، فقل لي أين أطلبه % وازور عن نظري البيض الرعاديد % 14(@)(@@) % وجرد الشيب في فودي أبيضه % يا ليته في سواد الشعر مغمود % 15(@)(@@) % بيض وسود براسي لا يسلطها % % على الذوائب إلا البيض والسود % 16(@)(@@) % يؤمل الناس أن يبقوا وما علموا % % أن الفتى ليد الأقدار مولود % 17(@)(@@) % شغلت بالهم حتى ما يفرحني % % لولا الخليفة نور وز ولا عيد % % 18(@)(@@) % % وإن طغى بيننا نأي وتبعيد % 19(@)(@@) % محسد المجد مغبوط مناقبه % متيم القلب بالعلياء معمود % % 20(@)(@@) % كريم ما ضم برداه وعمته % % عفيف ما ضمنت منه المراقيد % % PageV01P410 21(@)(@@) % مطهر القلب لا انهلت مدامعه % % وجدا وما حقر الانفاس تصعيد % % 22(@)(@@) % ما راق عينيه الا ما اقرهما % % من المكارم لا عين ولا جيد % % 23(@)(@@) % المورد الرمح ما نالت عوامله % % والمطعم العضب ما عزاه تجريد % 24(@)(@@) % والقائد الخيل يمطو في اعنتها % % مطو النعام اضلتها القراديد % % 25(@)(@@) % في كل يوم له نعمى يجددها % % تملا يدي ، ولقولي فيه تجديد % 26(@)(@@) % وما اسر بمال لا اعز به % % ولا ألذ برأي فيه تفنيد % 27(@)(@@) % ليس السراء بغير المجد فائدة % وما البقاء بغير 
ms117	 العز محمود % 28(@)(@@) % جرح الحمام ولا جرح الأذى أبدا % والموت عند طروق الضيم مورود % % 29(@)(@@) % صارت اليك امير المؤمنين على % % غراء احرزها اباؤك الصيد % % 30(@)(@@) % من هاشم أنت في صماء شاهقة % لها رواق بباع المجد معمود % PageV01P411 31(@)(@@) % نهاية العز ان تبقى له ابدا % % وغاية الجود ان تبقى لك الجود % % 32(@)(@@) % لاي حال يداري القلب غلثه % % رجاء ورد ووردي منك تصريد % 33(@)(@@) % قد كنت عن عدد الايام في شغل % % فاليوم عامي لوعد منك معدود % % 34(@)(@@) % الام فيك واذني غير سامعة % % فاللؤم مطرح والعذل مردود % % 35(@)(@@) % يروم ملكك من لا رأي ينجده % ولا فخار ولا بأس ولا جود % % 36(@)(@@) % وكيف يطلب شأوا منك ذو ظلع % % باقي غبارك في عينيه موجود % % 37(@)(@@) % ما كل بارقة تحدو السحاب ولا % % 38(@)(@@) % يستفزه الخيل والاقدار تحصره % % ويستطيل العوالي وهو رعديد % % 39(@)(@@) % لا تحفلن بوعيد زل عن فمه % % فما يضر من المغرور توعيد % 40(@)(@@) % ولا يؤمل أن يلقاك في عدد % ان اصحر الليث اخفى شخصه السيد % % PageV01P412 41(@)(@@) % ولو بسطت يمينا بالعراق اذا % % نالته ، وهو بعيد الدار مطرود % 42(@)(@@) % أعيذ مجدك أن أبقى على طمع % وان تكون عطاياي المواعيد % % 43(@)(@@) % وان اعيش بعيدا من لقائكم % % 44(@)(@@) % ما لي احب حبيبا لا اشاهده % % ولا رجاي إلى لقياه ممدود % % 45(@)(@@) % وأتعب القلب فيمن لا وصال له % ياللرجال اقل الخرد الغيد % % 46(@)(@@) % اكثرت شعري ولم اظفر بحاجته % % فسقني قبل أن تفنى الأغاريد % 47(@)(@@) % قد جاء عيد وعيد المرء لذته % % وانت فيهم عظيم القدر محمود % % 48(@)(@@) % عيش الفتى كله وقت يسر به % % من الدنا وجميع العيش مفقود % % 49(@)(@@) % فاسعد به ، وبأيام طرفن به % إن العزيز على العلات مسعود % 50(@)(@@) % قليل مدحك في شعري يزينه % حتى كأن مقالي فيك تغريد % % PageV01P413 51(@)(@@) % كم خوض الناس في قولي وقائله % % وكم غلا بي إغراق وتجويد % 52(@)(@@) % اذم من اجل اشعاري فوا عجنا % % تذم إن جنت الخمر العناقيد % 53(@)(@@) % وما شكوت لان العز يقعدني % % وانت سيفي ويوم الروع مشهود % % PageV01P414 البحر : رمل تام 1(@)(@@) % من رأى البرق بغوري 
ms118	 السند % % في أديم الليل يفري ويقد % 2(@)(@@) % حيرة المصباح تزهوه الصبا % % خلل الظلماء يخبو ويقد % 3(@)(@@) % كلما أنجد علوي السنا % % قام بالقلب اشتياق وقعد % % 4(@)(@@) % تقصر الآجال من أعدائكم % ذاب دمع العين فيه وجمد % % 5(@)(@@) % ومغان أنبت الحسن بها % % هيفا ترعاه عيني ، وغيد % 6(@)(@@) % كلما عاود قلبي ذكرها % % لعب الدمع بجفني وجد % % 7(@)(@@) % إن ريم السرب أدنى لي الجوى % % ونأى بالصبر عني والجلد % % 8(@)(@@) % بندى غضين غصن ونقا % % وجنى عذبين شهد وبرد % 9(@)(@@) % قل لزور الشيب اهلا انه % % أخذ الغي وأعطاني الرشد % 10(@)(@@) % طارق قوم عودي بالنهى % % بعد ما استغمز من طول الاود % % PageV01P415 11(@)(@@) % وقر اليوم جموحا رأسه % جار ما جار طويلا وقصد % 12(@)(@@) % ظل لماع جلاه بارح % بعدما ابرق حينا ورعد % % 13(@)(@@) % لا تعد العيش شيئا ، إنه % نفس يقضي وأيام تعد % % 14(@)(@@) % إنما الأيام يوم واحد % وغرور اسمه اليوم وغد % 15(@)(@@) % يا قوام الدين مليت بها % % دولة تجري إلى غير أمد % 16(@)(@@) % كسقاط النار أورى قدحه % كلما فرعن النار وقد % % 17(@)(@@) % أصلها يطلب أعماق الثرى % % وذراها يطلب النجم صعد % 18(@)(@@) % كلما زاد علوا فرعها % % زاد مسراها قرارا ووطد % 19(@)(@@) % كلما توهي طنبا من بيتها % % نوب الايام والجد وتد % % 20(@)(@@) % انت اسيها إذا لج بها % % من اعاديها رداع وضمد % % PageV01P416 21(@)(@@) % قائد الحيل تساقى بالردى % % تحت اساد لها النقع لبد % % 22(@)(@@) % تحسب الشوس على اكتادها % % فلق الجندل في ماء الزرد % 23(@)(@@) % وعلى أربق قد أرسلها % % كالقطا الجون يبادرن الثمد % % 24(@)(@@) % وبيم ودجوها بالقنا % % ربما داويت من غير عمد % 25(@)(@@) % يوم أمسى من قناها ماطرا % سال واديه من الطعن ومد % % 26(@)(@@) % فص جمع الغي عن شدتها % % زأر الضيغم فانصاع النقد % % 27(@)(@@) % ونجا المغرور من جامحها % % مفلت الشحمة حلق المزدرد % 28(@)(@@) % غاويا يحلم بالملك وهل % % يغلب العير على بيت الاسد % % 29(@)(@@) % اذكرونا يوم ذي قار وقد % % اقبلوه عارض الطعن برد % % 30(@)(@@) % رحض الأغلف في تياره % ورد العلج ، وما كاد يرد % PageV01P417 31(@)(@@) % يصطلي نار طعان مضة % اوقدت فيها نزار بن معد % % 32(@)(@@) % سل صفيح 
ms119	 الهند عن موقفه % % و بعين الشمس للنقع رمد % % 33(@)(@@) % جر في دار الاعادي فيلقا % % كرغاء البحر يرمي بالزبد % % 34(@)(@@) % فعلى الجو سقوف من قنا % % وعلى الأرض قطوع من جسد % 35(@)(@@) % أصعق الأعداء حتى خلته % زفيان الريح يرمي بالعضد % 36(@)(@@) % ركدة عن جولة تحسبها % % مرجل القين غلا ثم برد % % 37(@)(@@) % ما أضل الرمح فيها منهم % عثر السيف به فيما وجد % % 38(@)(@@) % من بني ساسان أقنى ضربت % حجر الملك عليه والسدد % 39(@)(@@) % طلعت في كل افق شمسه % % هل ترى يختص بالشمس بلد % 40(@)(@@) % ما رأينا كأبيه ناجلا % ولد الناس جميعا بولد % PageV01P418 41(@)(@@) % إن يكن تاجا وعضدا فابنه % دره التاج ودملوج العضد % 42(@)(@@) % لاضحا ظلكم يوما ولا % % مطل الاقبال فيكم ماوعد % % 43(@)(@@) % و تفارطتم على رفه السرى % % مورد النعماء والعيش الرغد % 44(@)(@@) % وغدا الجد جموحا بكم % ماله عن غاية الايام رد % % 45(@)(@@) % تقصر الاجال من اعداءكم % % ويطال العيش فيكم ويمد % 46(@)(@@) % تنفد الغدران احيانا وما % % لعباب اليم ذي اللج نفد % % 47(@)(@@) % جعجع المجد بكم مبركه % راضيا بالدار فيكم والبلد % % 48(@)(@@) % و قباب الملك في اعطانها % % رفعت منكم بعادي العمد % 49(@)(@@) % معشر فات المساعي سعيهم % % ضل من كاثر رملا بعدد % 50(@)(@@) % افسدوا الدهر على اولاده % % لا يرى مثلهم فيمن ولد % PageV01P419 51(@)(@@) % يا معيد الماء في عودي ، ويا % % مثبتي بعد اضطراب واود % % 52(@)(@@) % ثمري اليوم لمن أورقني % % و اذا ما اورق الفرع عقد % % 53(@)(@@) % كل يوم لك نعمي غضة % % تعقد الفخر باطواق جدد % % 54(@)(@@) % رب من بعد من منكم % % جاء عفوا ، ويدا من بعد يد % 55(@)(@@) % فاعتقدها ناظمات للعلى % % جامعات المجد ، والمجد بدد % 56(@)(@@) % من مطايا الذكر لا يحسرها % % أبدا وعث بلاد وجدد % 57(@)(@@) % عقد للمجد باق عينها % % أبد الدهر ، وللمجد عقد % 58(@)(@@) % خارجيات بيادون المدى % % ولها فيك بواق وقعد % % PageV01P420 البحر : طويل 1(@)(@@) % أبى الله إلا أن يسوء بك العدى % % ويصبح مستثنى البقاء على الردى % % 2(@)(@@) % وما كان هذا الدهر يوما بنازع % نجاد حسام مثله ما تقلدا % % 3(@)(@@) % لعا ولعا لا عثر من بعد هذه 
ms120	 % % تلقى العلى واستأنف العز أغيدا % % 4(@)(@@) % خفيت خفاء البدر يرجى ظهوره % وما غاب بدر الليل إلا ليشهدا % % 5(@)(@@) % غروب الدراري ضامن لطلوعها % % فيا فرقدا باق على الليل فرقدا % % 6(@)(@@) % معاذا لهذا البحر مما يغيضه % % معاذ الشمل المجد ان يتبددا % % 7(@)(@@) % سلمت لنا والله ارأف بالعلى % % من ان ينطوي عنا وارحم للندى % % 8(@)(@@) % فقل للعدى شموا الهوان بأجدع % وعضوا على الأيدي القصار بأدردا % % 9(@)(@@) % افيقوا لها من سكرة الغي وابتغوا % % زماما إلى ما تكرهون ومقودا % % 10(@)(@@) % حسبتم بأن الملك هيضت جبوره % % و ان سوام المجد اصبحن شردا % % PageV01P421 11(@)(@@) % لها اليوم راع لا يراع سوامه % اذل لها نهج الطريق وعبدا % % 12(@)(@@) % إذا طمع الأعداء فيها أجارها % % و ارتعها بين العوالي واوردا % % 13(@)(@@) % وإن قوام الدين قد عب بحره % وعيدا أقام الخالعين وأقعدا % % 14(@)(@@) % تقوه فبينا تنظر البحر ساكنا % % إلى ان تراه شائل اللج مزبدا % % 15(@)(@@) % أأطمعكم أن الحسام قضى المنى % % ولم يبق عند الدهر ثأرا ، فأغمدا % % 16(@)(@@) % و إني ضمين ان تجرد مازق % % لغاو من الايام ان يتجردا % % 17(@)(@@) % اما يرهب القطاع الا مجردا % % اما يتقى العسال الا مسددا % % 18(@)(@@) % ليهن لليالي والمعالي انها % % اثابة برء عدها المجد مولدا % % 19(@)(@@) % على حين طارت بالقلوب مخافة % اطير فريص الملك منها وارعدا % % 20(@)(@@) % و اصبحت الامال غرثى ظمية % % يواعدن من نعماك مرعى وموردا % % PageV01P422 21(@)(@@) % فلو يستطيع الدهر من بعد هذه % % لألبسك اليوم التميم المعقدا % % 22(@)(@@) % بأي منال أم بأية أذرع % تعاطيتم اليوم البناء العطودا % % 23(@)(@@) % بناء أقام المجد فيه عماده % وقرره تحت العوالي ، ووطدا % % 24(@)(@@) % كد أبكم منه غداة حداكم % % تشاغله الآذان عن طرب الحدا % % 25(@)(@@) % و كبكم كب الحجيج هدية % % تحثحثها نخس النصال إلى المدى % % 26(@)(@@) % كأيام حنوي دارزين وأربق % مواقف أخبى الطعن فيها وأوقدا % % 27(@)(@@) % اطيل اختراط البيض فيها فلو خفى % % بها لمعان البرق ظن المهندا % % 28(@)(@@) % وتخفى بها الامطار من طول ماجرى % % عليها نجيع الطعن والضرب سرمدا % % 29(@)(@@) % شللتم بها شل الطرائد بالقنا % % تبرأ من ولى وضل الذي هدى % % 30(@)(@@) % و 