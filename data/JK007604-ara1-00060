ms41	 يحيا ليفهمه ، % و قال : أحسنت قولا غير إفصاح % 3(@)(@@) % فكاد ، أو لم يكد أن يستفيق له ، % و النفس في بحر سكر عب ، طفاح % 4(@)(@@) % فقلت للعلج : عللني ، فرب فتى % عللته ؛ فانثنى من نشوة الراح % 5(@)(@@) % من بنت كرم ، لها في الكأس رائحة % تحكي لمن نال منها ريح تفاح % 6(@)(@@) % نفتض بكرا عجوزا ، زانها كبر % في زي جارية في اللهو ، ملحاح % 7(@)(@@) % حتى إذا الليل غطى الصبح مجوله ، % كمطلع وجهه من بين أشباح % 8(@)(@@) % نبهت ندماني الموفي بذمته ، % من بعد إتعاب كاسات وأقداح % 9(@)(@@) % فقال : هات اسقني ، واشرب وغن لنا : % يادار شعثاء بالقاعين ، فاساح % % 10(@)(@@) % فما حسا ثانيا ، أو بعض ثالثة ، % حتى استدار ، ورد الراح بالراح % PageV01P187 البحر : بسيط تام 1(@)(@@) % دع البساتين من ورد ، وتفاح ، % واعدل ، هديت ، إلى ذات الأكيراح % % 2(@)(@@) % اعدل إلى نفر ، دقت شخوصهم % من العبادة ، إلا نضو أشباح % 3(@)(@@) % يكررون نواقيسا مرجعة % على الزبور ، بإمساء ، وإصباح % 4(@)(@@) % تنأى بسمعك عن صوت تكرهه % فلست تسمع فيه صوت فلاح % 5(@)(@@) % إلا الدراسة للإنجيل ، من كتب ، % ذكر المسيح بإبلاج وإفصاح % 6(@)(@@) % يا طيبهم ، وعتيق الراح تحفتهم % % بكل نوع من الطاسات رحراح % 7(@)(@@) % يسقيكها مدمج الخصرين ، ذو هيف ، % أخو مدارع صوف فوق أمساح % PageV01P188 البحر : وافر تام 1(@)(@@) % تعاتبني على شرب اصطباح ، % و وصل الليل من فلق الصباح % 2(@)(@@) % و ما علمت بأني أريحي ، % أحب من الندامى ذا ارتياح % 3(@)(@@) % فرب صحابة بيض ، كرام ، % بهاليل ، غطارفة ، صباح % 4(@)(@@) % صرفت مطيهم حيرى ، طلاحا ، % وقد سدت أساليب الرياح % 5(@)(@@) % وقام الظل فوق شراك نعل ، % مقام الريش في ثني الجناح % 6(@)(@@) % إلى حانات خمر في كروم % معرشة ، معرجة النواحي % % 7(@)(@@) % فأقبل ربها يسعى إلينا % % يهنىء بالفلاح ، وبالنجاح % 8(@)(@@) % فقلت : الخمر قال : نعم وإني % % بها لبني الكرام لذو سماح % 9(@)(@@) % فجاء بها تخب كماء مزن ، % وأنشأ منشدا شعر اقتراح : % 10(@)(@@) % أتصحو أم فؤادك غير صاح ، % عشية هم صحبك بالرواح % PageV01P189 11(@)(@@) % فبت لدى دساكره عروسا % بعذراوين من ماء وراح % 12(@)(@@) % ودار بكأسنا رشأ رخيم ، % لطيف الكشح ، مهضوم الوشاح 
ms42	 % 13(@)(@@) % وقال : أتبرحون غدا ؟ فقلنا : % وكيف نطيق بعدك من رواح % 14(@)(@@) % فخاتلنا ؛ فأسكرنا ، فنمنا % % إلى أن هم ديك بالصياح % 15(@)(@@) % فقمت إليه أرفل مستقيما % وقد هيأت كبشي للنطاح % 16(@)(@@) % فلما أن ركزت الرمح فيه % تنبه كالرقيد من الجراح % 17(@)(@@) % فقلت له : بحق أبيك سهل % فلا تحوج إلى سفح التلاحي % % 18(@)(@@) % فقال : لقد ظفرت فنل هنيئا % بإسعاف ، وبذل مستباح % 19(@)(@@) % فلما أن وضعت عليه رحلي % % تبدى منشدا شعر امتداح : % 20(@)(@@) % ( ألستم خير من ركب المطايا % % و أندى العالمين بطون راح % PageV01P190 البحر : بسيط تام 1(@)(@@) % قف لا تخلخل عن الريحان والراح % وعن ترنم أوتار بإفصاح % 2(@)(@@) % من كف ساقيه ، يستل ناظرها % % لدقة الفهم ما أوحى به الواحي % % 3(@)(@@) % و يا تعالي عقارا ، قرقفا ، رقصت % عند المزاج بطاسات وأقداح % 4(@)(@@) % تبدي الشموس ، إذا ما الماء خالطها ، % شعاع نور كلمح البرق لماح % PageV01P191 البحر : منسرح 1(@)(@@) % يا حبذا ليلة نعمت بها % % أشرب فضل الحبيب في القدح % 2(@)(@@) % سألته قبلة فجاد بها ، % فلم أصدق بها من الفرح % PageV01P192 البحر : بسيط تام 1(@)(@@) % أما المكاس فشيء لست أعرفه ، % و الحمد لله ، في فعل ولا راح % 2(@)(@@) % هاتيك أنفي بها همي ، وذا أملي ، % فلست عن ذا ولا عن تلك بالصاحي % % PageV01P193 البحر : بسيط تام 1(@)(@@) % كأنما وجهه والكأس إذ قربت % من فيه بدر تدلى منه مصباح % 2(@)(@@) % مدجج بسلاح الحب ، يحمله ، % طرف الجمال بسيف الطرف طماح % 3(@)(@@) % فالسيف مضحكه ، والقوس حاجبه ، % و السهم عيناه ، والأهداب أرماح % PageV01P194 البحر : مجزوء الرمل 1(@)(@@) % باكر اليوم الصبوحا ، % واعص في الخمر النصوحا % % 2(@)(@@) % واسقنيها من عقار % عهدت في الفلك نوحا % % 3(@)(@@) % قهوة تقرن في جس % مك مع روحك روحا % % 4(@)(@@) % فإذا صادفت منها % % نفحة خلت نضوحا % % 5(@)(@@) % ثم لا يركب منها % % مركبا إلا جموحا % % PageV01P195 البحر : بسيط تام 1(@)(@@) % لا تحفلن بقول الزاجر اللاحي ، % واشرب على الورد من مشمولة الراح % 2(@)(@@) % صهباء ، صافية تجديك نكهتها % % تنفس المسك ، ملطوخا بتفاح % 3(@)(@@) % حتى إذا سلسلت في قعر باطية ، % أغناك لألاؤها عن ضوء مصباح % 4(@)(@@) % مازلت أسقي حبيبي ، ثم 
ms43	 ألثمه % والليل ملتحف في ثوب أمساح % 5(@)(@@) % حتى تغنى ، وقد مالت سوالفه : % يادير حنذة من ذات الأكيراح % PageV01P196 البحر : بسيط تام 1(@)(@@) % ما زلت أستل روح الدن في لطف ، % وأستقي دمه من جوف مجروح % 2(@)(@@) % حتى انثنيت ولي روحان في جسد ، % والدن منطرح جسما بلا روح % PageV01P197 البحر : وافر تام 1(@)(@@) % فأسقيه إلى أن مات سكرا ، شريت الفتك بالثمن الربيح ، % وبعت النسك بالقصف النجيح % 2(@)(@@) % وأمكنت المجانة من قيادي ، % ولست من المجون بمستريح % 3(@)(@@) % ورب مخضب الأطراف ، رخص ، % مليح الدل ، ذي وجه صبيح % 4(@)(@@) % ظفرت به ، ونجم الصبح باد ، % عباديا على دين المسيح % 5(@)(@@) % فسر بطلعتي لما رآني ، % وأيقن أنني غير الشحيح % 6(@)(@@) % وقام بمبزل ، فافتض بكرا % عجوزا قد تجل عن المديح % 7(@)(@@) % رأت نوحا ، وقد شمطت وشابت ، % وقد شهدت قرونا قبل نوح % 8(@)(@@) % فأسقيه إلى أن مات سكرا ، % ولم يدفن ، وعيشك ، في ضريح ! % PageV01P198 البحر : بسيط تام 1(@)(@@) % يا دير حنة من ذات الأكيراح % من يصح عنك ؛ فإني لست بالصاحي % % 2(@)(@@) % رأيت فيك ظباء لا قرون لها % % يلعبن منا بألباب ، وأرواح % 3(@)(@@) % يعتاده كل محفوف مفارقه % من الدهان ، عليه سحق أمساح % 4(@)(@@) % في عصبة لم يدع منهم تخوفهم % وقوع ما حذروه ؛ غير أشباح % 5(@)(@@) % لا يدلفون إلى ماء بآنية % إلا اغترافا من الغدران بالراح ! % PageV01P199 البحر : سريع 1(@)(@@) % قلت لدن شج أوداجه : % ليت دمي دونك مسفوح % 2(@)(@@) % و كنت منه بدلا صالحا % % في مهجتي تحيا بك الروح % PageV01P200 البحر : منسرح 1(@)(@@) % هات من الراح ؛ فاسقني الراحا ، % أما ترى الديك كيف قد صاحا % % 2(@)(@@) % وأدبر الليل في معسكره ، % منصرفا ، والصباح قد لاحا % % 3(@)(@@) % فاستعمل الكأس ، واسقني بكرا ، % إني إليها أصبحن مرتاحا % % 4(@)(@@) % كأسا دهاقا ، صرفا ؛ كأن بها % % إلى فم الشاربين مصباحا % % 5(@)(@@) % نؤتى بها كالخلوق في قدح ، % خالط ريح الخلوق تفاحا % % 6(@)(@@) % من كف قبطية مزنرة ، % نجعلها للصبوح مفتاحا % % 7(@)(@@) % تقول للقوم من مجانتها % % بالله لا تحبسن الأقداحا % % PageV01P201 البحر : سريع 1(@)(@@) % وقهوة باكرتها سحرة ، % والصبح قد أسفر في لوحه % 2(@)(@@) % حمراء تصفر ، إذا شعشعت ، % ألطف 
ms44	 في الشارب من روحه % % 3(@)(@@) % شيع ريح الورد أرواحها ، % وريحها أطيب من ريحه % PageV01P202 البحر : بسيط تام 1(@)(@@) % ولى الصيام ، وجاء الفطر بالفرح ، % وأبدت الكأس ألوانا من الملح % 2(@)(@@) % وزارك اللهو في إبان دولته % مجدد اللهو ، بين العود والقدح % 3(@)(@@) % فليس يسمع إلا صوت غانية % مجهودة ، جددت صوتا لمقترح % 4(@)(@@) % و الخمر قد برزت في ثوب زينتها ، % فالناس ما بين مخمور ، ومصطبح % PageV01P203 البحر : رمل تام 1(@)(@@) % طرب الشيخ فغنى ، واصطبح % من عقار تنهب الهم الفرح % 2(@)(@@) % أخذت من كل شيء لونها ، % فهي في ناجودها قوس قزح % 3(@)(@@) % شيخ لذات ، نقي عرضه ، % تحسن الأشعار فيه ، والمدح % 4(@)(@@) % لا تراه الدهر إلا ثملا ، % بين إبريق ، وزق ، وقدح % PageV01P204 البحر : مجزوء الرمل 1(@)(@@) % أله بالبيض الملاح ، % و بقينات ، وراح % 2(@)(@@) % لا يصدنك لاح ، % هو عن سكرك صاح % 3(@)(@@) % ليس للهم دواء % كاغتباق ، واصطباح % 4(@)(@@) % فلعمري ما يداوى ال % % هم بالماء القراح % PageV01P205 البحر : بسيط تام 1(@)(@@) % وقهوة مزة باكرت صبحضتها ، % وضوأها نائب عن ضوء مصباح % 2(@)(@@) % حمراء ، علقها بالماء شاربها ، % تفتض عذرتها في بطن رحراح % 3(@)(@@) % و يثبت الماء في حافاتها حببا ، % كالقطر يثبت في حافات ضحضاح % 4(@)(@@) % تنفست في وجوه القوم ضاحكة % تنفس المسك في تفليج تفاح % PageV01P206 البحر : مجزوء الرمل 1(@)(@@) % أحي لي ، يا صاح ، روحي % % بغبوق ، وصبوح % 2(@)(@@) % واسقني حتى تراني % % رادعا ردع الجموح % 3(@)(@@) % قهوة ، صهباء ، بكرا % غرست أزمان نوح % 4(@)(@@) % تطرد الهم ، وبرتا % % ح لها قلب الشحيح % 5(@)(@@) % تلك ، لا أعدمنيها الل % ه ، أنسي ، عدل روحي % % 6(@)(@@) % يجنح القلب إليها % % في الهوى أي جنوح % 7(@)(@@) % عطفت نفسي عليها % % بهوى غير نزوح . . . % PageV01P207 البحر : مجزوء الكامل 1(@)(@@) % وأخي حفاظ ماجد % حلو الشمائل ، غير لاح % 2(@)(@@) % ناديته ، والليل قد % أودى بسلطان الصباح % 3(@)(@@) % يا صاح أشكو حلوة العي % نين جائلة الوشاح % 4(@)(@@) % فيها افتحت ، وحبها % % في الناس يسعى بافتضاحي % % 5(@)(@@) % ( ولها ولا ذنب لها % % لحظ كأطراف الرماح % 6(@)(@@) % في القلب يجرح دائما ن % % فالقلب مجروح النواحي ) % 7(@)(@@) % أجنان جارية المهذ % ب ، بالفضائل والسماح % 8(@)(@@) % مالي 
ms45	 ، ولم أك باذلا % ودا ، ولا فيكم سماحي % % 9(@)(@@) % فبخلت أنت وليس أه % لك من قبيلك بالشحاح % PageV01P208 البحر : طويل 1(@)(@@) % وأبيض مثل البدر دارة وجهه ، % له كفل راب به يترجح % 2(@)(@@) % أغن خماسي ؛ لما أنت طالب % من اللهو فيه واللذاذة يصلح % 3(@)(@@) % تقنصني لما بدا لي سانحا % كما مر ظبي بالمفازة يسنح % 4(@)(@@) % فأمكضنني طوعا عنان قياده % فقد خلت ظبيا ، واقفا ليس يبرح % 5(@)(@@) % فقلت له : زرني ، فديتك ، زورة ، % أقر بها ما شئت عينا وأفرح % 6(@)(@@) % فقال ، بوجه مشرق متبسم ، % وقد كدت أقضي للهوى : أنت تمزح % 7(@)(@@) % تقدم لنا ، لا يعرف الناس حالنا ؛ % وأقبل في تخطاره يترنح % 8(@)(@@) % فجئت إلى صحبي بظبي مفتق ، % فلما تراءوا ضوء خديه سبحوا % % 9(@)(@@) % فقلت لهم : لا تعجلوه ، فإنما % % علامتنا عند الفراغ التنحنح % PageV01P209 البحر : كامل تام 1(@)(@@) % إذهب ! نجوت من الهجاء ولذعه ، % و أما ولثغة رحمة بن نجاح % 2(@)(@@) % لولا فتور في كلامك يشتهى ، % و ترفقي بك ، بعد ، واستملاحي % % 3(@)(@@) % وتكسر في مقلتيك هو الذي % % عطف الفؤاد عليك بعد جماح % 4(@)(@@) % لعلمت أنك لا تمازح شاعرا ، % في ساعة ليست بحين مزاح ! % PageV01P210 البحر : بسيط تام 1(@)(@@) % لم أشرك الناس يوم العيد في الفرح ، % ولا هم شركوني في جوى الترح % 2(@)(@@) % غدوا بزينتهم فيه ، وخلفني % % ألا تروح لي من قلبي القرح % 3(@)(@@) % لم أتاني تجريم الحبيب لهم % علي لم أبتكر فيه ، ولم أرح % 4(@)(@@) % ولم أطاوع فما فيه على ضحك ، % ولا مددت يدي فيه إلى قدح % PageV01P211 البحر : بسيط تام 1(@)(@@) % قد عذب الحب هذا القلب ما صلحا ، % فلا تعدن ذنبا أن يقال صحا % % 2(@)(@@) % أبقيت في لتقوى الله باقية ، % و لم أكن كحريص لم يدع مرحا % % 3(@)(@@) % وحاجة لم تكن كالحاج واحدة % كلفتها العزم ، والعيرانة السرحا % % 4(@)(@@) % يكون جهد المطايا عفو سيرتها % % إذا نسائجها كانت لها وشحا % % 5(@)(@@) % نرمي به كل ليل كان كلكله % % مثل الفلاة ، إذا ما فوقها جنحا % % 6(@)(@@) % حتى تبين في أثناء نقبته % ورد السراة ترى في لونه ملحا % % 7(@)(@@) % و هن يلحقن بالمعزاء مجمرة 
ms46	 % خشم الأنوف نرى في خطوها روحا % % 8(@)(@@) % يطءلبن بالقوم حاجات نضمنها % % بدر بكل لسان يلبس المدحا % % 9(@)(@@) % كأن فيض يديه ، قبل تسأله ن % % باب السماء ، إذا ما بالحيا انفتحا % % 10(@)(@@) % لقد نزلنا أبا العباس منزلة % ما إن ترى خلفها الأبصار مطرحا % % PageV01P212 11(@)(@@) % وكلت بالدهر عينا غير غافلة ، % من جود كفك تأسو كلما جرحا % % 12(@)(@@) % أنت الذي تأخذ الأيدي يحجزته ، % إذا الزمان على أولاده كلحا % % 13(@)(@@) % كما الربيع كفى أيام نكبتهم % صدع الأمور ، وأدنى ود من نزحا % % 14(@)(@@) % تئط دون الرجال الأقربين به ، % قربى رؤوم ، وجيب طالما نصحا % % 15(@)(@@) % كان الموادع شأو الفضل مستترا ، % حتى إذا رام تلك الخطة افتضحا % % 16(@)(@@) % من للجذاع ، إذا الميدان ماطلها ، % بشأو مطلع الغايات قد قرحا % % 17(@)(@@) % من لا يصعضع منه البؤس أنملة ، % ولا يصعد أطراف الربى فرحا % % PageV01P213 البحر : طويل 1(@)(@@) % لقد نسلت رزين من استها ، % عليهن ، سيما في العيون تلوح % 2(@)(@@) % فعشواء مضليل ، وأعشى مضلل % % وأعور دجال عليه قبوح % 3(@)(@@) % سيبقى بقاء الدهر ما قلت فيكم ، % وأما الذي قد قلتموه ، فريح % PageV01P214 البحر : هزج 1(@)(@@) % أيا من وجهه الداح ، % وفي مئزره الماح % 2(@)(@@) % ومن سقيا ثناياه ، % إذا استسقيته ، الراح % 3(@)(@@) % و يا من هو تفاح ، % إذا لم يك تفاح % 4(@)(@@) % أما لي منك يا ظال % - م إلا الآء والآح % 5(@)(@@) % و لحظ صائب الأسه % - م للمهجة جراح % 6(@)(@@) % أما حان ، بلى قد حا % % ن ؛ لو أنك ترتاح % 7(@)(@@) % و لكنك إنسان ، % بما أكره ، مزاح ! % PageV01P215 البحر : بسيط تام 1(@)(@@) % دع من يقارض أقداحا بأقداح ، % ليس المروءة سقي الراح بالراح % 2(@)(@@) % عهدي بقوم ، إذا ما حل زائرهم % تبادروا لقرى الضيفان ، سماح % 3(@)(@@) % عاشوا بأسيافهم ، فتكا بلا منن ، % من الأراذل ، أو ماتو بأرماح % PageV01P216 البحر : مجزوء الرمل 1(@)(@@) % غرد الديك الصدوح % فاسقني ! طاب الصبوح % 2(@)(@@) % واسقني حتى تراني % % حسنا عندي القبيح % 3(@)(@@) % قهوة تذكر نوحا % حين شاد الفلك نوح % 4(@)(@@) % نحن نخفيها ، ويأبى % % طيب ريح فتفوح % 5(@)(@@) % فكأن القوم نهبى ، % بينهم مسك ذبيح % 6(@)(@@) % أنا في دنيا من العب % اس 
ms47	 أغدو وأروح % 7(@)(@@) % هاشمي ، عبدلي ، % عنده يغلو المديح % 8(@)(@@) % علم الجود ، كتاب % بين عينيه يلوح % 9(@)(@@) % كل جود يا أميري ، % ما خلا جودك ، ريح % 10(@)(@@) % إنما أنت عطايا % % أبدا لا تستريح % PageV01P217 11(@)(@@) % بح صوت المال مما % % منك يشكو ، ويصيح % 12(@)(@@) % ما لهذا آخذ فو % % ق يديه أو نصيح % 13(@)(@@) % جدت بالأموال ، حتى % % قيل ما هذا صحيح % 14(@)(@@) % صور الجود مثالا ، % فله العباس روح % 15(@)(@@) % فهو بالمال جواد ، % وهو بالعرض شحيح % PageV01P218 البحر : مجتث 1(@)(@@) % الموت منا قريب ، % و ليس عنا بنازح % 2(@)(@@) % في كل يوم نعي ، % تصيح منه الصوائح % 3(@)(@@) % تشجى القلوب ، وتبكي % % مولولات النوائح % 4(@)(@@) % حتى متى أنت تلهو % % في غفلة ، وتمازح ؟ % 5(@)(@@) % و الموت في كل يوم % في زند عيشك قادح % 6(@)(@@) % فاعمل ليوم عبوس ، % من شدة الهول كالح % 7(@)(@@) % و لا يغرنك دنيا ، % نعيمها عنك نازح % 8(@)(@@) % و بغضها لك زين ، % و حبها لك فاضح ! % PageV01P219 البحر : بسيط تام 1(@)(@@) % دم المكارم بالفسطاط مسفوح ، % والجود قد ضاع فيها ، وهو مطروح % 2(@)(@@) % يا أهل مصر لقد غبتم بأجمعكم ، % لما حوى قصب السبق المساميح % 3(@)(@@) % أموالكم جمة ، والبخل عارضها ، % والنيل مع جوده فيه التماسيح % 4(@)(@@) % لولا ندى ابن جوي أحمد نطقت % مني المفاصل فيكم والجواريح % PageV01P220 البحر : سريع 1(@)(@@) % أية نار قدح القادح ، % و أي جد بلغ المازح % 2(@)(@@) % لله در الشيب من واعظ ، % وناصح لو سمع الناصح % 3(@)(@@) % يأبى الفتى إلا اتباع الهوى ، % ومنهج الحق له واضح % 4(@)(@@) % فاسم بعينيك إلى نسوة ، % مهورهن العمل الصالح % 5(@)(@@) % لا يجتلي الحوراء من خدرها % % إلا امرؤ ميزانه راجح % 6(@)(@@) % من اتقى الله ، فذاك الذي % % سيق إليه المتجر الرابح % 7(@)(@@) % شمر ، فما في الدين أغلوطة ، % و رح لما أنت له رائح % PageV01P221 البحر : رجز تام 1(@)(@@) % قد أغتدي في فلق الإصباح ، % بمطعم يوجز في سراح % 2(@)(@@) % مؤيد بالنصر والنجاح ، % غذته أظار من اللقاح % 3(@)(@@) % فهو كميش ، ذرب السلاح ، % لا يسأم الدهر من الضباح % 4(@)(@@) % منجد ، يأشر للصياح ، % ما البرق في ذي عارض لماح ؟ % 5(@)(@@) % ولا انقضاض 
ms48	 الكوكب المنصاح ، % ولا انبتات الحوأب المنداح % 6(@)(@@) % حين دنا من راحة المشاح ، % أجد في السرعة من سرياح % 7(@)(@@) % يكاد عند ثمل المراح % يطير في الجو بلا جناح % 8(@)(@@) % إذا سما الخايل للأشباح ، % يفتر عن مثل شبا الرماح % 9(@)(@@) % فكم وكم ذي جدة لياح ، % ونازب أعفر ذي طماح % 10(@)(@@) % غادره مضرج الصفاح % % PageV01P222 البحر : رجز تام 1(@)(@@) % لاصيد إلا بالصقور اللمح % كل قطامي بعيد المطرح % 2(@)(@@) % يجلو حجاجي مقلة لم تجرح ، % لم تغذه باللبن المضيح % 3(@)(@@) % أم ، ولم يولد بسهل الأبطح ، % إلا بإشراف الجبال الطمح % 4(@)(@@) % أحص أطراف القدامى وحوح % أبرش ما بين القرا والمذبح % 5(@)(@@) % يلوي بخزان الصحارى الجمح % ينحى لها بعد الطماح الأطمح % 6(@)(@@) % يسلكها بنيزك مذرح ، % و منسر أقنى كأنف المجدح % 7(@)(@@) % و هي رواق بالبساط الأفيح ، % و متيحات للحاق متيح % 8(@)(@@) % فاصطاد قبل التعب المبرح ، % وقبل أوب العازب المروح % 9(@)(@@) % خمسين مثل العنز المشدح ، % ما بين مذبوح وما لم يذبح % PageV01P223 البحر : مجزوء الكامل 1(@)(@@) % يا مادح القوم اللئا % % م ، وطالبا رفد الشحاح % 2(@)(@@) % أشغل قريضك بالنسي % % ب ، وبالفكاهة والمزاح % 3(@)(@@) % حدثت وجوه ليس تأ % % لم غير أطراف الرماح % 4(@)(@@) % وأكف قوم ليس ين % بط ماءها إلا المساحي % % 5(@)(@@) % ما شئت من مال حمى ، % يأوي لي عرض مباح % PageV01P224 البحر : رجز تام 1(@)(@@) % قد أغتدي بزرق صبيح % محض لمن ينسبه صريح % 2(@)(@@) % صلت الخدود ، واضح مليح ، % و ليس ما يغمز كالصحيح % 3(@)(@@) % بكف ضنان به شحيح ، % مما اشترى بالثمن الربيح % 4(@)(@@) % فلم يزل بالنهم والتقديح ، % ورشه بالماء والتلويح % 5(@)(@@) % حتى انطوى إلا جنان الروح % و عرف الصوت ووحى الموحي % % 6(@)(@@) % فكم وكم من طول طموح ، % لم ينجه طموره في اللوح % 7(@)(@@) % من فلتات صلتات شيح ، % ترجله الريح بكف الريح % 8(@)(@@) % و ضربة بنيزك مذروح ، % فاصطاد قبل الأين والتبريح % 9(@)(@@) % خمسين مستحيى إلى مذبوح % % PageV01P225 البحر : بسيط تام 1(@)(@@) % لا تبك ليلى ، ولا تطرب إلى هند ، % واشرب على الورد من حمراء كالورد % 2(@)(@@) % كأسا إذا انحدرت في حلق شاربها ، % أجدته حمرتها في 
ms49	 العين والخد % 3(@)(@@) % فالخمر ياقوتة ، والكأس لؤلؤة % من كف جارية ممشوقة القد % 4(@)(@@) % تسقيك من عينها خمرا ، ومن يدها % % خمرا ، فما لك من سكرين من بد % 5(@)(@@) % لي نشوتان ، وللندمان واحدة ، % شيء خصصت به من بينهم وحدي % % PageV01P226 البحر : بسيط تام 1(@)(@@) % عاج الشقي على دار يسائلها ، % وعجت أسأل عن خمارة البلد % 2(@)(@@) % لا يرقىء الله عيني من بكى حجرا % ولا شفى وجد من يصبو إلى وتد % 3(@)(@@) % قالوا ذكرت ديار الحي من أسد % لا در درك قل لي من بنو أسد % 4(@)(@@) % و من تميم ، ومن قيس وإخوتهم ، % ليس الأعاريب عند الله من أحد % 5(@)(@@) % دع ذا عدمتك ، واشربها مثعتقة % صفراء تعنق بين الماء والزبد % 6(@)(@@) % من كف مختصر النار ، معتدل % كغصن بان تثنى ، غير ذي أود % 7(@)(@@) % لما رآني أبوه قد قعدت له % حيا ، وأيقن أني متلف صفدي % % 8(@)(@@) % فجاءني بسلاف لا يحف لها % % ولايملكها إلا يدا بيد % 9(@)(@@) % اسمح وجد بالذي تحوي يداك لها ، % لاتذخر اليوم شيئا خوف فقر غد % 10(@)(@@) % كم بين من يشتري خمرا يلذ بها % % وبين باك على نؤي ، ومنتضد % PageV01P227 11(@)(@@) % يا عاذلي قد أتتني منك بادرة ، % فإن تغمدها عفوي فلا تعد % 12(@)(@@) % لو كان لومك نصحا كنت أقبله ، % لكن لومك محمول على الحسد % PageV01P228 البحر : منسرح 1(@)(@@) % سقيا لغير العلياء والسند % و غير أطلال مي بالجرد % 2(@)(@@) % وياصبيب السحاب إن كنت قد % % جزت اللوى مرة فلا تعد % 3(@)(@@) % لا تسقين بلدة ، إذا عدت ال % بلدان كانت زيادة الكبد % 4(@)(@@) % إن أتحرز من الغراب بها ، % يكن مفري منه إلى الصرد % 5(@)(@@) % بحيث لا تجلب الفجاج إلى % % أذنيك إلا تصايح النقد % 6(@)(@@) % أحسن عندي من انكبابك بال % فهر ملحا به على وتد % 7(@)(@@) % وقوف ريحانة على أذن ، % وسير كأس إلى فم بيد % 8(@)(@@) % يسقيكها من بني العباد رشا % منتسب عيده إلى الأحد % 9(@)(@@) % إذا بنى الماء فوقها حببا ، % صلب فوق الجبين بالزبد % 10(@)(@@) % أشرب من كفه شمولا ، ومن % فيه رضابا يجري على برد % PageV01P229 11(@)(@@) % فذاك أشهى من 
ms50	 البكاء على ال % % ربع ، وأنمى في الروح والجسد % 12(@)(@@) % لا سيما إن شداك ذو نطف : % ' يا دار أقوت بالتف من جدد ' % PageV01P230 البحر : مجزوء الرمل 1(@)(@@) % اسقنيها بسواد % قبل تغريد المنادي % % 2(@)(@@) % من كميت بلغت في ال % % دن أقصى مستزاد % 3(@)(@@) % رضعت والدهر ثديا % وتلته في الولاد % 4(@)(@@) % فهي فيها كل ما يب % لغ مقروح الفؤاد % 5(@)(@@) % سمتها عند يهود % ي خصيب المستراد % 6(@)(@@) % فشربنا شرب قوم % عطشوا من عهد عاد % 7(@)(@@) % بين أفياء عريش % عمدوه بعماد % 8(@)(@@) % ودنان مسندات % معلمات بمداد % 9(@)(@@) % أنقذوهن بطعن % مثل أفوه المزاد % 10(@)(@@) % ثم لما مزجوها ، % وثبت وثب الجراد % PageV01P231 11(@)(@@) % ثم لما شربوها ، % أخذت أخذ الرقاد % PageV01P232 البحر : بسيط تام 1(@)(@@) % يا طيبنا بقصور القفص ، مشرفة % فيها الدساكر ، والأنهلر تطرد % 2(@)(@@) % لما أخذنا بها الصهباء ، صافية ، % كأنها النار وسط الكأس تتقد % 3(@)(@@) % جاءتك من بيت خمار بطينتها % % صفراء ، مثل شعاع الشمس ، ترتعد % 4(@)(@@) % فقام كاغصن قد شدت مناطقه % ظبي يكاد من التهييف ينعقد % 5(@)(@@) % فاستلها من فم الإبريق ، فانبعثت % % مثل اللسان جرى واستمسك الجسد % 6(@)(@@) % والكأس يضحك في تيجانها الزبد % % والليل يجمعنا ، حتى بدا الأحد % 7(@)(@@) % حتى بدت غرة الإثنين واضحة ، % والسعد معترض ، والطالع الأسد % 8(@)(@@) % وفي الثلاثاء أعملنا المطي بها ، % صهباء ، ما قرعتها بالمزاج يد % 9(@)(@@) % والأربعاء كسرنا حد سورتها % % 10(@)(@@) % ثم الخميس وصلناه بليلته % قصفا ، وتم لنا بالجمعة العدد % PageV01P233 11(@)(@@) % يا حسننا ! وبحار القصف تغمرنا % % في لجة الليل ، والأوتار تغترد % 12(@)(@@) % في مجلس حوله الأشجار محدقة ، % وفي جوانبه الأنهار تطرد % 13(@)(@@) % لا نستخف بساقينا لعزته ، % و لا يرد عليه حكمه أحد % 14(@)(@@) % عند الأمير أبي عيسى الذي كملت % أخلاقه ، فهي كالأوراق تنتقد % PageV01P234 البحر : وافر تام 1(@)(@@) % و ندمان ترادفه خمتار ، % فأورث في أنامله ارتعادا % % 2(@)(@@) % فليس بمستقل الكأس ، مالم % تكن يسراه لليمنى عمادا % % 3(@)(@@) % رفعت له يدي وهنا بكأس % بها منها تزيد ، فاستعادا % % 4(@)(@@) % وقال : ' ألست متبعها بأخرى % % توقرني ، فإنبي ازديادا ' % 5(@)(@@) % فقلت : ' بلى ! وباخريات % على أني سأجعلها جيادا % % 6(@)(@@) % فذالك دأبه ليلي ، ودأبي 
ms51	 ، % إذا ما زدته منها استزادا % % 7(@)(@@) % إلى أن خر ، ما يدري أأرضا % توسد عند ذلك أم وسادا % % PageV01P235 البحر : كامل تام 1(@)(@@) % باكر صبوحك ، فهو خير عتاد ، % واخلع قيادك ، قد خلعت قيادي % % 2(@)(@@) % لا تنس لي يوم العروبة وقعة % تودي بصاحبها بغير فساد % 3(@)(@@) % يوما شربت ، وأنت في قطربل % خمرا ، تفوق إرادة المرتاد % 4(@)(@@) % لما وردناها نلم بشيخها % % علج ، يحدث عن مصانع عاد % 5(@)(@@) % قلنا : السلام عليك ! قال : عليكم % مني سلام تحية ، ووداد % 6(@)(@@) % ما رمتم ؟ قلنا : المدام ! فقال : قد % % وفقتم ، يا إخوتي ، لرشاد % 7(@)(@@) % عندي مدام قد تقادم عهدها ، % عصرت ، ولم يشعر بها أجدادي % % 8(@)(@@) % فأكيل ؟ قلنا : بعد خبر ، إننا % % لا نشتري سمكا ببطن الوادي % % 9(@)(@@) % جئنا بها ! فأتى بكأس أشرقت % منها الدجى ، وأضاء كل سود % % 10(@)(@@) % فأدارها عددا ثلاثا ، فانثنت % منذا النفوس ، وليس منها صاد % PageV01P236 11(@)(@@) % حتى إذا أخذت بوجنة صاحبي % % وفؤاده ، وبوجنتي وفؤادي % % 12(@)(@@) % لم يرض إبليس الظريف فعالنا % % حتى أعان فسادنا بفساد ! % PageV01P237 البحر : بسيط تام 1(@)(@@) % قد أسحب الزق يأباني وأكرهه ، % حتى له في أديم الأرض أخدود % 2(@)(@@) % إن الملاهي أصناف يشيدها % % ناي ، به المزهر الغريد معقود % 3(@)(@@) % لا أرحل الراح ، إلا أن يكون لها % % حاد بمنتحل الأشعار ، غريد % 4(@)(@@) % ولا ألاطم دون الخمر تاجرها ، % لأن ظني أن لم يضغل موجود % 5(@)(@@) % فاستنطق العود ، قد طال السكوت به ، % لا ينطق اللهو حتى ينطق العود % 6(@)(@@) % و فضله عند أهل الظرف كلهم ، % فضل البرامك أن علاهم الجود % PageV01P238 البحر : سريع 1(@)(@@) % الخمر تفاح جرى ذائبا ؛ % كذالك التفاح خمر جمد % 2(@)(@@) % فاشرب على جامد ذا ذوب ذا ، % ولا تدع لذة يوم لغد % PageV01P239 البحر : مجتث 1(@)(@@) % وعود كرمة كرخ % زوجتها ماء واد % 2(@)(@@) % فلم يزل يضعتليها ، % بمسقيات الغوادي % % 3(@)(@@) % حتى إذا استهلت بسثود % مسهدات جعاد % 4(@)(@@) % فمهدت في دنان ، % سقيا لها من مهاد % 5(@)(@@) % حتى إذا مر دهر % لها أتاها عبادي % % 6(@)(@@) % وقد تناهت ، وصارت % كمثل قبس الزناد % 7(@)(@@) % فجاءها مستعدا % كالحارث بن عباد % 8(@)(@@) % قد لفف الكم منه % % كنازع للقتاد 
ms52	 % 9(@)(@@) % فسل منها بزالا ، % فسال مثل الفصاد % 10(@)(@@) % إلى قنان تلالا % % مدملجات القلاد % PageV01P240 11(@)(@@) % فأذهلتني عقلي ، % و استأثرت بفؤادي % % 12(@)(@@) % واخترت إخوة صدق % من خير هذي العباد % 13(@)(@@) % شريف ابن شريف ؛ % جواد ابن جواد % 14(@)(@@) % والهوا نهارا وليلا % إلى نداء المنادي % % 15(@)(@@) % و نفروا الليل عنكم % بلذة وسهاد % 16(@)(@@) % فقلت : لذوا ! بنفسي % % أفديكم وفؤادي % % 19(@)(@@) % و ناقلوا الكأس ظبيا % ما يرتعي في البوادي % % 20(@)(@@) % لكن بديوان يحيى % % بفيه لطخ مداد % 21(@)(@@) % تخاله ذا رقاد ، % وما به من رقاد % 22(@)(@@) % ما زال يسقي ويسقى ، % حتى انثنى للمراد % PageV01P241 23(@)(@@) % وانساب نحوي يغني % % مطربا وينادي : % 24(@)(@@) % سقيت صوب الغوادي % % يا منزلا لسعاد % PageV01P242 البحر : منسرح 1(@)(@@) % لا تبك رسما بجانب السند ، % ولا تجد بالدموع للجرد % 2(@)(@@) % و لاتعرج على معطلتة % ولا أثاف خلت ، ولا وتد % 3(@)(@@) % ومل إلى مجلس على شرف % بالكرخ بين الحديق ، معتمد % 4(@)(@@) % ممهد صففت نمارقه ، % في ظل كرم معرش ، خضد % 5(@)(@@) % قد لحفتك الغصون أردية ، % فيومك الغض بالنعيم ندي % % 6(@)(@@) % ثم اصطبح من أميرة حجبت ، % عن كل عين ، بالصون والرصد % 7(@)(@@) % لم يرها خاطب ، فيمنعها ، % ولا دعاه لها أخو فند % 8(@)(@@) % محجوبة ، في مقيل حوبتها ، % تسعين عاما محسوبة العدد % 9(@)(@@) % لم تعرف الشمس أنها خلقت ، % ولا اختلاف الحرور والصرد % 10(@)(@@) % بين فسيل يحفها خضل ، % وبين آس بالري منفرد % PageV01P243 11(@)(@@) % في كل يوم يظل قيمها % % مكبلا ، كالأسير ، في صفد % 12(@)(@@) % مزمزما حولها ، ومرتنما ، % يوجو بصون لها غنى الأبد % 13(@)(@@) % حتى بذلنا بعقرها مائة ، % صفراء تبدو بكف منتقد % PageV01P244 البحر : كامل تام 1(@)(@@) % ردا علي الكأس ، إنكما % % لا تدريان الكأس ما تجدي % % 2(@)(@@) % خوفتماني الله ربكما ، % وكخيفتيه رجاؤه عندي % % 3(@)(@@) % لا تعذلا في الراح ، إنكما % % في غفلة عن كنه ما تسدي % % 4(@)(@@) % لو نلتما ما نلت كت مزجت % إلا بدمعكما من الوجد % 5(@)(@@) % هاتا بمثل الراح معرفة ، % بلطافة التأليف والود % 6(@)(@@) % ما مثل نعماها ، إذا اشتملت ، % إلا اشتمال فم على خد % 7(@)(@@) % إن كنتما لا تشربان معي % % خوف العقاب شربتها وحدي % % PageV01P245 البحر : كامل 
ms53	 تام 1(@)(@@) % اعدل عن الطلل المحيل ، وعن هوى % % نعت الديار ، ووصف قدح الأزند % 2(@)(@@) % و دع العريب ، وخلها مع بؤسها ، % لمحارف ألف الشقاء ، مزند % 3(@)(@@) % و اقصد إلى شط الفرات ، وعاطني % % قبل الصباح ، وعاص كل مفند % 4(@)(@@) % صفراء ، تحكي التبر ، في حافاتها % % عقد الحباب كلؤلؤ متبدد % 5(@)(@@) % فلأشربن بطارف وبتالد % بنت الكروم برغم أنف الحسد % 6(@)(@@) % كرخية كصفاء وجه مشوقة % مرهاء ، ترغب عن سواد الإثمد % 7(@)(@@) % حنت مكاتمة ؛ فبين جفونها % % رقراق دمع فاض أو فكأن قد % 8(@)(@@) % و تخاف تحدره فترفع جفنها ، % فالدمع بين تحدر وتصعد % PageV01P246 البحر : رمل تام 1(@)(@@) % وإذا رام نديم عربده % فاقرعن بالصرف منه كبده % 2(@)(@@) % كرر الخمر عليه بحتة % كي تقيم الخمر منه أوده % 3(@)(@@) % ثم وسده إذا ما غلبت % سورة الراح عليه عضده % 4(@)(@@) % خلتا سوء تشينان الفتى % % حيث ما كان : الخنا والعربده % 5(@)(@@) % وشياطين من الإنس هم % أحدثوا القتل ، غواة ، مرده % 6(@)(@@) % قد سقيت الخمر حتى ثملوا % % ليلة ذات رياح صرده % PageV01P247 البحر : هزج 1(@)(@@) % إذا شاقك ناقوس % و شجو الناي ، والعود % 2(@)(@@) % وغوديت بريق الخم % ر مجته العناقيد % 3(@)(@@) % تطربت إلى الإلف % فقالوا : أنت عربيد % 4(@)(@@) % و هل عربد مكروب ، % قريح القلب معمود ؟ % PageV01P248 البحر : منسرح 1(@)(@@) % رب غزال كأنه قمر % لاح ، فجلى الدجون في البلد % 2(@)(@@) % سألته الوصل كي يجود به ، % فضن عني به ، ولم يجد % 3(@)(@@) % فقلت للظبي في صعوبته : % يا طيب الروح ، طيب الجسد % 4(@)(@@) % كم من أخ جاد بالوصال ، فما % % أحبل من وصلنا ولم يلد ! % 5(@)(@@) % فقال : هيهات ذا ترققني ، % ولن يرق الغزال للأسد % 6(@)(@@) % فقلت : دعنا ، وقم لنأخذها % % مما تزف العلوج بالعمد % 7(@)(@@) % من بنت كرم ، إذا تصفقها % % بماء مزن رمتك بالزبد % 8(@)(@@) % حتى إذا ما أتى صدرت به % عن كل واش ، وعن ذوي الحسد % 9(@)(@@) % أوجرته القرقف العقار فماا % % نتهيت حتى اتكى على العضد % 10(@)(@@) % فقمت حتى حللت مئزره % منه ، وسويت فخذه بيدي % % PageV01P249 11(@)(@@) % ثم اعتنقنا ، وظلت ألثمه % وثغره مثل ساقط البرد % 12(@)(@@) % فقام لما انجلت عمايته % حليف حزن 
ms54	 ، مولع الكمد % PageV01P250 البحر : كامل تام 1(@)(@@) % دعت الهموم إلى شغاف فؤادي ، % وحمت جوانب مقلتي رقادي % % 2(@)(@@) % ورق بتفجقة تنوح أليفها % % غلس الدجنة في ذرى الأعواد % 3(@)(@@) % ولقد أزيح الهم حين ينوبني ، % والشوق يقدح في الحشا بزناد % 4(@)(@@) % بمدامة ورث الزمان لبابها ، % عن ذي الأوائل من أكابر عاد % 5(@)(@@) % زادت على طول التقادم عزة ، % ودعت لآخر عهدها بنفاد % 6(@)(@@) % حتى تطلعها الزمان ، وقد فرت % حجب الدنان بناضر حداد % 7(@)(@@) % فكأنما صبغ التقادم ثوبها ، % والكأس في عرس المدام ، بجاد % 8(@)(@@) % تسعى إلي بكأسها كرخية ، % يختصها ندمانها بوداد % 9(@)(@@) % ناطت بعاتقها الوشاح ؛ كما ترى % % بطلا يحاول نجدة بنجاد % 10(@)(@@) % فرأت عقود الراح در وشاحها ، % فحكينهن ، وهن غير جماد % PageV01P251 11(@)(@@) % فتلألأ النوران نور ساطع ، % ومنظم أرج على الأجياد % 12(@)(@@) % و مرنة جمعت إلى ندمائها % % بدع السرور يقدن كل مقاد % 13(@)(@@) % لما تغنت ، والسرور يحثها : % رحل الخليط جمالهم بسواد % PageV01P252 البحر : طويل 1(@)(@@) % أدرها على الندمان نوحية العهد ، % وهات لعلي أن أسكن من وجدي % % 2(@)(@@) % لباب مدام أغفلت بمسكنة % من الأرض ، أو كانت حبيسا على عمد % 3(@)(@@) % تحيرت الأوهام دون صفاتها ، % وجلت صفات عن شبيه ، وعن ند % 4(@)(@@) % أتت دونها الأيام ، إلا بقية ، % تدق للطف أن تضاف إلى حد % 5(@)(@@) % أشمسا أعرت الكأس أم هي لمعة % من البرق ، أم أقرلت بالكوكب السعد ؟ % 6(@)(@@) % فقال : مدام خلط ماء سحابة % قرينة أم الدهر ؛ تربين في المهد % 7(@)(@@) % مددت لها الأجفان من خوف نورها % % على بصر قد كاد حين بدت يودي % % 8(@)(@@) % ألا أدنها تنأ الهموم لقربها ، % فتنقلها من دار قرب إلى بعد % 9(@)(@@) % فناولني فوق المنى من يمينه % مريض جفون العين ، معتدل القد % 10(@)(@@) % مطية فساق ، وقبلة ماجن % أليف سماع لا نزور ، ولا مكدي % % PageV01P253 البحر : طويل 1(@)(@@) % وقائلة لي : كيف كنت تريد ؟ % فقلت لها : أن لا يكون حسود % 2(@)(@@) % لقد عاجلت قلبي جنان بهجرها ، % و قد كان يكفيني بذاك وعيد % 3(@)(@@) % لعل جنانا ساءها أن أحبها ، % فقل لجنان : ثابت ويزيد % 4(@)(@@) % فسخطك في هذا على النفس هين ، % ولكنه 
ms55	 فيما سواه شديد % 5(@)(@@) % رأيت دنو الدار ليس بنافع ، % إذا كان ما بين القلوب بعيد % PageV01P254 البحر : متقارب تام 1(@)(@@) % تناومت جهدي ، فلم أرقد ، % ونام الخلي ولم يسهد % 2(@)(@@) % أقلب طرفا كليل اللحاظ ، % وإن قر عن جسد مقصد % 3(@)(@@) % و أنهض في طربات تهيج ، % وألزم طورا فؤادي يدي % % PageV01P255 البحر : طويل 1(@)(@@) % نهارك ، من حسن ، وليلك واحد ، % فذا أنت حيران ، وذا أنت ساهد % 2(@)(@@) % وفيها ، رعاك الله ، عنك تثاقل ، % وما ذاك إلا أنها فيك زاهد % 3(@)(@@) % وأنت الفتى في مثل وصل حباله % أقول ، وفي الأمثال للهم طارد % 4(@)(@@) % ألا رب مشغوف بنا لا يناله ، % و آخر قد نشقى به يتباعد ! % PageV01P256 البحر : كامل تام 1(@)(@@) % يا تاركي جسدا بغير فؤاد ، % أسرفت في هجري ، وف إبعادي % % 2(@)(@@) % إن كان يمنعك الزيارة أعين ، % فادخل علي بعلة العواد % 3(@)(@@) % إن القلوب مع العيون ، إذا جنت % جاءت بليتها على الأجساد % 4(@)(@@) % أشكو إليك جفاء أهلك ، إنهم % % ضربوا علي الأرض بالأسداد % PageV01P257 البحر : هزج 1(@)(@@) % إذا ما وطىء الأمر % د للعلم حصى المسجد % 2(@)(@@) % فقد حل لنا عقدا % من التكة تستعقد % 3(@)(@@) % فإن كان عروضيا ، % فقولوا : سجد الهدهد % 4(@)(@@) % وإن أعجبه النحو ، % فهذاك لنا أجود % 5(@)(@@) % و إن مال إلى الفقه ، % فللفقه له أفسد % 6(@)(@@) % و إن كان كلآميا ، % فحرك طرف المقود % 7(@)(@@) % وميله إلى الجد ، % ففيه قرب من يبعد % 8(@)(@@) % ونله كيفما شئت اق % تضابا ، وعلى موعد % 9(@)(@@) % فيا من وطىء المسج % د من ذي بهجة أغيد % PageV01P258 البحر : مجتث 1(@)(@@) % أيا ملين الحديد % لعبده داود % 2(@)(@@) % ألن فؤاد جنان % لعاشق معمود % 3(@)(@@) % قد صارت النفس منه % بين الحشا والوريد % 4(@)(@@) % جنان جودي ، وإن عز % ك الهوى أن تجودي % % 5(@)(@@) % ألا اقتليني . ففي ذا % % ك راحة للعميد % 6(@)(@@) % أما رحمت اشتياقي ، % أما رحمت سهودي % % 7(@)(@@) % أما رأيت بكائي % % في كل يوم جديد % 8(@)(@@) % فقربي لمحب % محض الوداد ، وجودي % % 9(@)(@@) % صب ، حريض ، مهيض ، % ناء ، طريد ، شريد % 10(@)(@@) % حران ، يدعو بليل : % يا للوحيد الفريد % % PageV01P259 11(@)(@@) % قومي ، فقد كان منكم ، % فديت ، طول 
ms56	 الرقود % 12(@)(@@) % فأنجزي لي وعدي ، % وأقصري من وعيدي % % 13(@)(@@) % فقد وعدت مواعي % % د كالسراب ببيد % PageV01P260 البحر : كامل تام 1(@)(@@) % كتبت على فص لخاتمها : % من مل محبوبا ، فلا رقدا % % 2(@)(@@) % فكتبت في فص ليبلغها : % من نام لم يعقل كمن سهدا % % 3(@)(@@) % فمحته ، واكتتبت ليبلغني : % لا نام من يهوى ولا هجدا % % 4(@)(@@) % فمحوته ثم اكتتبت : أنا ، % والله ، أول ميت كمدا % % 5(@)(@@) % فمحته ، واكتتبت تعارضني : % والله ! لا كلمته أبدا % % PageV01P261 البحر : طويل 1(@)(@@) % وقصرية أبصرتها ، فهويتها ، % هوى عروة العذري والعاشق النجدي % % 2(@)(@@) % فلما تمادى هجرها ، قلت : واصلي ، % فقالت : بهذا الوجه ترجو الهوى عندي ؟ % 3(@)(@@) % فقلت لها : لو كان في السوق أوجه % تباع بنقد حاضر ، وسوى نقد % 4(@)(@@) % لغيرت وجهي ، واشتريت مكانه ، % لعلك أن تهوي وصالي من بعد % 5(@)(@@) % و إن ذا قبح ، فإني شاعر ، % فقالت : ولو أصبحت نابغة الجعدي % % PageV01P262 البحر : مجزوء الرمل 1(@)(@@) % إنني أبصرت شخصا % قد بدا منه صدود % 2(@)(@@) % جالسا فوق مصلى ، % و حواليه عبيد % 3(@)(@@) % فرمى بالطرف نحوي ، % وهو بالطرف يصيد % 4(@)(@@) % ذاك في مكتب حفص ، % إن حفصتا لسعيد % 5(@)(@@) % قال حفص : إجلدوه ، % إنه عندي بليد % 6(@)(@@) % لم يزل مذ كان في الدر % س عن الدرس يحيد % 7(@)(@@) % كشفت عنه خزور ، % وعن الخز برود % 8(@)(@@) % ثم هالوه بسير % لين ، ما فيه عود % 9(@)(@@) % عندها صاح حبيبي : % يا معلم لا أعود ! % 10(@)(@@) % قلت : يا حفص اعف عنه ، % إنه سوف يجيد % PageV01P263 البحر : سريع 1(@)(@@) % وفاتن الألحاظ والخد ، % معتدل القامة والقد % 2(@)(@@) % قال ، وعيني منه في خده % % راتعة في جنة الخلد : % 3(@)(@@) % طرفك زان ! قلت د معي إذن % % يجلده أكثر من حد % PageV01P264 البحر : طويل 1(@)(@@) % ألا إن من أهواه ضن بوده ، ألا إن من أهواه ضن بوده ، % وأعقبني من بعد ذاك بصده % 2(@)(@@) % فواحزنا بعد المودة ، إنه % % ليبخل عني بالسلام ورده % 3(@)(@@) % دعاني إليه حسنه ، وجماله ، % وسحر بعينيه ، وخال بخده % 4(@)(@@) % كأن فرند المرهفات بخده ، % و يختال ماء الورد تحت فرنده % % 5(@)(@@) % فلم أر مثلي صار عبدا لمثله ، % و لا مثله يوما أضر بعبده 
ms57	 ! % PageV01P265 البحر : مجتث 1(@)(@@) % باتت بطرف مسهد % % مطمومة تتمرد % 2(@)(@@) % لها من الظرف والحس % ن زائد يتجدد % 3(@)(@@) % فكل حسن بديع % من حسنها يتولد % 4(@)(@@) % في القلب مني عليها % % حرارة تتوقد % 5(@)(@@) % تعود بالوصل طورا ، % و العود بالوصل أحمد % 6(@)(@@) % حتى ، إذا أطمعتني % % تأبى علي وتجحد % % 7(@)(@@) % فمتا لقلبي منها % % إلا العنا والتردد % 8(@)(@@) % أبغي دنوا إليها % % بالجهد مني ، فتبعد % PageV01P266 البحر : - 1(@)(@@) % إذا ما عاذلي سما % % ك قلت أعد ، كتذا أعد % 2(@)(@@) % وشب لي باسمها عذلي % % وزدني ، ثم زد وزد % 3(@)(@@) % نهاري كله ، وغدا ، % و بعد غد ، وبعد غد % PageV01P267 البحر : طويل 1(@)(@@) % أمربعنا بالشط لا لعب البلى % % بربعك ما ناحت حمامة واد % 2(@)(@@) % خلعت عذاري فيك يوما وليلة ، % وشرد شرب الراح فيك رقادي % % 3(@)(@@) % و متخذ لين النصارى عبادة ، % يرى أنه فيه مصأيب رشاد % 4(@)(@@) % أأذكر طرفا ، بالصدود تقطعت % قلوب إليه بالوصال صواد % 5(@)(@@) % وأذكر طرفا ، بالوصال سخت له % % قلوب تداعت من وثاق صفاد % 6(@)(@@) % و صفراء طول الدهر فيها يزبدها ، % إذا شجها هونا بماء غواد % 7(@)(@@) % كأن الذي تبديه عند نكاحها ، % و ما قبله منها ، عيون جراد % PageV01P268 البحر : طويل 1(@)(@@) % تصبحت في وعد ، وبت على وعد % لمن زارني بعد التجنب والصد % 2(@)(@@) % فجاء بعيد الظهر للغد موفيا ، % وبت على مهد ، وبات على مهد % 3(@)(@@) % و مازال يسقينا ، ويشرب ليلنا ، % فعين على عين ، وخد على خد % 4(@)(@@) % فبتنا من السكر الشديد كأننا % % قتيلان لفاف الرياحين والورد % PageV01P269 البحر : سريع 1(@)(@@) % يا فرحة جاءت مع العيد ، % وفى الذي أهوى بموعود % 2(@)(@@) % جاء من الأعين مستخفيا ، % من بعد إخلاف وتنكيد % 3(@)(@@) % حتى إذا الراح جرت بيننا ، % أمنت من خلف وترديد % 4(@)(@@) % ظل ولي العهد في خطبة ، % وظلت بين الراح والعود % 5(@)(@@) % صار مصلانا أباريقنا ، % ونحرنا بنت العناقيد % 6(@)(@@) % للناس عيد عمهم واحد ، % وصار لي عيدان في عيد % PageV01P270 البحر : رمل تام 1(@)(@@) % يا قريب الدار من داري ، وقد % زاد في البعد على من بعدا % % 2(@)(@@) % قد شهدت العيد ، فاستسمجته ، % ذاك أن لم تك فيمن شهدا 
ms58	 % % 3(@)(@@) % حولي الناس كأني لا أرى % % منهم ، إذ غبت عني ، أحدا % % PageV01P271 البحر : مجزوء الوافر 1(@)(@@) % أما ونجيبة يهوي % % عليها راكب فرد % 2(@)(@@) % مظلل محجر العيني % ن ، جيب قميصه قدد % 3(@)(@@) % إذا ما جاوزت جددا ، % فلاح لعينه جدد % 4(@)(@@) % حكت أم الرئال ، إذا % % رماها الوابل البرد % 5(@)(@@) % تؤم بقفزة بيضا % لها في جوفه ولد % 6(@)(@@) % وحرمة كف ممتزج % شمولا ، ضوؤها يقد % 7(@)(@@) % فلما أن تقارن فو % % قها ، كاللؤلؤ ، الزبد % 8(@)(@@) % سقاها ماجدا ، محضا % نمته جحاجح نجد % 9(@)(@@) % لصحن المسجد المعمو % % ر ، فالرحبات ، فالسند % 10(@)(@@) % فما ضمت سقائفه % فطود إزائه الوحد % PageV01P272 11(@)(@@) % فدور بني أبي سفيا % % ن حيث تبحبح العدد % 12(@)(@@) % فحيث استوطن البكرا % % ت ، فالدور التي امتهدوا % % 13(@)(@@) % فدور محارب حيث اس % تمر السيل يطرد % 14(@)(@@) % إلى دور يحل بها ا % % لألى قلبي بهم كمد % 15(@)(@@) % ألذ لعين مكتحل ، % أطاف بعينه رمد % 16(@)(@@) % من الموماة غاداها % % وراوح أهلها النقد % 17(@)(@@) % و كل مزيل ميتا % يثني جيده الغيد % 18(@)(@@) % عروضي إذا ما افتر % مبتسما بدا برد % 19(@)(@@) % إذا قمنا نصلي لم % % يفرق بيننا أحد % 20(@)(@@) % أحركه ، إذا قاموا ، % و ألمسه ، إذا قعدوا % % PageV01P273 21(@)(@@) % وليس خليفة الرحم % % ن يعدلني ، إذا سجدوا % % 22(@)(@@) % واين المربد الوحشي % من ذا النعت ، فالجلد % 23(@)(@@) % مخندقه ، وقد كان ال % % مصلي الفرد ، فالنضد % 24(@)(@@) % فسوق الإبل ، حيث تسا % % ق فيه الخيل تطرد % 25(@)(@@) % محل ليس يعدمني % % به ذو غمة جحد % 26(@)(@@) % من الأعراب قد محشت % ضواحي جلده النجد % 27(@)(@@) % إذا ما قلت كيف العي % % ش قال شرنبث نكد % 28(@)(@@) % معاذ الله ما استويا % % وإن آواهما بلد % PageV01P274 البحر : وافر تام 1(@)(@@) % قريب الدار ، مطلبه بعيد ، % يرى نظري ، فيعلم ما أريد % 2(@)(@@) % أقول له ، وقد أخلته عين % من الرقباء ناظرها حديد : % 3(@)(@@) % اتمنع ريقك المعسول عني ، % و أنت على الجدار به تجود ؟ ! % 4(@)(@@) % فرنق مغضبا لحظات عين % عليه بغير قواد تقود % % 5(@)(@@) % وكاد يقول شيئا ، غير أني % % سبقت إلى اليمين بلا أعود ! % 6(@)(@@) % فقال : لو اقتصرت عليه جدنا ، % ولكن قد علمنا 
ms59	 ما تريد ! % PageV01P275 البحر : مجزوء الكامل 1(@)(@@) % يا من بمقلته يصيد ، % وعن الصيادة لا يحيد % 2(@)(@@) % بالله ! في حق الهوى % % أن لا تصاد ، وقد تصيد % 3(@)(@@) % تسبي القلوب بمقلة ، % ألحاظها فيها شهود % PageV01P276 البحر : هزج 1(@)(@@) % أميري حال عن عهدي ، % وما دام على ودي % % 2(@)(@@) % وخلاني في النار ، % وفي السحق ، وفي البعد % 3(@)(@@) % غزال لم يحز هذا % % لخلق غيره عندي % % 4(@)(@@) % إذا ما قلت يا مولا % % ي ، يوما قال يا عبدي ! % PageV01P277 البحر : مجزوء الكامل 1(@)(@@) % غاد الهوى بالكأس بردا ، % و أطع إمارة من تبدي % % 2(@)(@@) % واشرب بكفي شادن % جاز المنى هيتفا وقد % 3(@)(@@) % ظبي ، كأن الله أل % بسه قشور الدر جلدا % % 4(@)(@@) % وترى على وجناته ، % في أي حين شئت ، وردا % % PageV01P278 البحر : خفيف تام 1(@)(@@) % بسجود القسيس ، يوم السجود ، % و الصليب المعظم المعمود % 2(@)(@@) % والأناجيل والمزامير والمس % راج في كف عابد معبود % % 3(@)(@@) % وبناقوس بيعة اللحم حقا ، % وبأقفالها وبالإقليد % 4(@)(@@) % و بما في بيوتها من رخام ، % و بما تحت سقفها من عمود % 5(@)(@@) % وبذبح الذي ذكرتم بأن ا % % لله لم يثبت اسمه في العبيد % 6(@)(@@) % بالجمال البديع ! إلا رثيتم % لشج مثخن بخوف الوعيد ! % PageV01P279 البحر : كامل تام 1(@)(@@) % قال الطبيب ، وقد تأمل سحنتي : % إن الذي أضناك فيك لباد % % 2(@)(@@) % و زوال ما بك ليس فيه مرية ، % إن عادك اللهبي في العواد % PageV01P280 البحر : منسرح 1(@)(@@) % إني لصب ، ولا أقول بمن % أخاف من لا يخاف من أحد % 2(@)(@@) % إذا تفكرت في هواي له % مسست رأسي هل طار عن جسدي ؟ % 3(@)(@@) % إني على ما ذكرت من فرق ، % لا آمل أن أناله بيدي % % PageV01P281 البحر : مجزوء الرمل 1(@)(@@) % رفع الصوت ، فنادى : % يا أبا عيسى الجوادا % % 2(@)(@@) % كن عمادا يا ابن من كا % % ن غياثا وعمادا % % 3(@)(@@) % وتدارك جسدا قد % % مات ، أو قد قيل كادا % % 4(@)(@@) % قل له إن قال تا % % ب ؟ ! نعم تاب وزادا % % 5(@)(@@) % واضمن التوبة عمن % كلما أطراك عادا % % PageV01P282 البحر : طويل 1(@)(@@) % إذا كان ريب الدهر غال إمامنا ، % فلم يخطه لما رماه ، فأقصدا % % 2(@)(@@) % فإن الذي كنا 
ms60	 نؤمل بعده ، % وندخره للنائبات محمدا % % 3(@)(@@) % إمام هدى عم الأنام بعدله ، % وجار على الأموال في الحكم واعتدى % % 4(@)(@@) % فأبقاه رب الناس ما حن واله ، % وما فرفر القمري يوما وغرد ا % % PageV01P283 البحر : مجتث 1(@)(@@) % أقول ، والغيث دان % يكاد يدفع باليد : % 2(@)(@@) % يا غيث أبرق وأرعد % محمد منك أجود % 3(@)(@@) % على الأمين يمين ، % بالله ، رب محمد % 4(@)(@@) % أن لا يقول لراج % رجاه : لا ، عن تعمد % PageV01P284 البحر : سريع 1(@)(@@) % ونرجس قد حف بالورد ، % في خد من قد لج في البعد % 2(@)(@@) % راودته عن نفسه خاليا ، % فقال ، يلقاني بالرد : % 3(@)(@@) % أما تراني قد بدت لحيتي ! % كف ، وخذ في طلب المرد % 4(@)(@@) % فقلت : هذا نرجس طالع ، % ورد في العارض والخد % 5(@)(@@) % فليس حبي ، صاح ، إلا الذي % % قد جاوز الخمسين في العد % 6(@)(@@) % أسأله كم لك من نسوة ، % و كم صبي لك في المهد % 7(@)(@@) % فذاك من شأني ، ومن لذتي % % حتى أوارى في ثرى لحدي % % PageV01P285 البحر : هزج 1(@)(@@) % حلفت اليوم بالطنبو % % ر ، والكعبين ، والنرد % 2(@)(@@) % و بالشرب من الراح % على النسرين ، والورد % 3(@)(@@) % وصيد الباز والشا % % هين ، والأكلب والفهد % 4(@)(@@) % لقد أجهدت يا مولا % % ي قلبي ، أيما جهد % 5(@)(@@) % ولكن لم أجد بدا % من أن أجزيكم ودي % % PageV01P286 البحر : وافر تام 1(@)(@@) % صببت على الأمير ثياب مدحي ، % فكل قال : أحسن ! واستجادا % % 2(@)(@@) % ولولا فضله ما جاد شعري ، % و لا ملك الثنا مني القيادا % % 3(@)(@@) % و قالوا : قد أجدت ، فقلت : إني % % رأيت الأمر أمكنني فزاد ا % % PageV01P287 البحر : سريع 1(@)(@@) % قولا لهارون إمام الهدى % % عند احتفال المجلس الحاشد % 2(@)(@@) % نصيحة الفضل ، وإشفاقه % أخلى له وجهك من حاسد % 3(@)(@@) % بصادق الطاعة ، ديانها ، % وواحد الغائب والشاهد % 4(@)(@@) % أنت على ما بك من قدرة ، % فلست مثل الفضل بالواجد % 5(@)(@@) % أوجده الله ، فما مثله % % لطالب ذاك ، ولا ناشد % 6(@)(@@) % وليس لله بمستنكر % أن يجمع العالم في واحد + % PageV01P288 البحر : وافر تام 1(@)(@@) % وإن تصفح ، فإحسان جديد أقلني ، قد ندمت على ذنوبي % % وبالإقرار عذت من الجحود % 2(@)(@@) % و إن تصفح ، فإحسان جديد % سبقت به إلى 