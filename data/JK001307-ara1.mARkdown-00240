ms221	 هذا باطل(@)(@@)(@@)(@@) $ 4382 - س ق / عمار بن أبي فروة عن الزهري قال البخاري لا يتابع على حديثه(@)(@@)(@@)(@@) $ 4383 - عمار بن أبي مالك عمرو بن هاشم الجنبي ضعفه الأزدي(@)(@@)(@@)(@@) $ 4384 - عمار بن مالك تابعي قديم روى عنه المنهال بن عمرو مجهول(@)(@@)(@@)(@@) $ 4385 - م ت ق / عمار بن محمد بن أخت سفيان الثوري ثقة قال ابن حبان استحق الترك وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4386 - عمار بن محمد المدني عن أبي عبيدة بن محمد لا شيء قاله ابن معين(@)(@@)(@@)(@@) $ 4387 - عمار بن مطر عن ابن ثوبان قال ابن عدي متروك PageV02P459(@)(@@)(@@)(@@) $ 4388 - عمار بن نصير والد هشام لينه ابن عساكر(@)(@@)(@@)(@@) $ 4389 - عمار بن نوح عن عمران القطان قال أبو زرعة ليس بالقوي(@)(@@)(@@)(@@) $ 4390 - عمار عن انس قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 4391 - عمار بن هارون أبو ياسر المستملي عن سلام بن مسكين قال ابن عدي كان يسرق الحديث(@)(@@)(@@)(@@) $ 4392 - عمار بن يزيد عن موسى بن هلال قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 4393 - عمارة بن بشر عن ابن غنم قال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 4394 - دق / عمارة بن ثوبان تفرد عنه ابن أخيه جعفر بن يحيى لكنه وثق(@)(@@)(@@)(@@) $ 4395 - ت ق / عمارة بن جوين أبو هارون العبدي تابعي ضعيف قال حماد بن زيد كذاب(@)(@@)(@@)(@@) $ 4396 - عمارة بن أبي حجار عن نافع قال الأزدي لا يصلح حديثه(@)(@@)(@@)(@@) $ 4397 - عه / عمارة بن حديد عن صخر الغامدي مجهول وقال أبو زرعة لا يعرف(@)(@@)(@@)(@@) $ 4398 - عمارة بن حيان عن جابر بن زيد قال يحيى ليس بشيء(@)(@@)(@@)(@@) $ 4399 - عمارة بن راشد بن كنانة عن جبير بن نفير مجهول قلت بل معروف PageV02P460 -(@)(@@)(@@)(@@) $ 4400 - د ت ق / عمارة بن زاذان عن ثابت ضعفه الدارقطني وغيره وله مناكير(@)(@@)(@@)(@@) $ 4401 - عمارة بن زيد عن أبيه قال الأزدي كان يضع الحديث(@)(@@)(@@)(@@) $ 4402 - عمارة بن سلمان لم يرو عنه سوى أبي إدريس الخولاني(@)(@@)(@@)(@@) $ 4403 - عمارة بن صالح عن مكحول شامي لا يعرف(@)(@@)(@@)(@@) $ 4404 - عمارة بن عامر عن أم الطفيل في الرؤية لا يعرف(@)(@@)(@@)(@@) $ 4405 - عمارة بن عبد عن 
ms222	 علي مجهول وقال أحمد مستقيم الحديث(@)(@@)(@@)(@@) $ 4406 - عمارة بن عثمان عن شبيب بن نعيم قال أبو أحمد الحاكم مجهول كشيخه(@)(@@)(@@)(@@) $ 4407 - عمارة بن عقبة الحنف شيخ لسليمان بن شعبة اليمامي لا يعرفان(@)(@@)(@@)(@@) $ 4408 - عمارة بن عمار عن زفر بن واصل لا يعرفان(@)(@@)(@@)(@@) $ 4409 - د / عمارة بن غراب شيخ لعبد الرحمن بن زياد بن أنعم قال أحمد ليس بشيء(@)(@@)(@@)(@@) $ 4410 - م عه / عمارة بن غزية تابعي مشهور صادق ضعفه ابن حزم فقط(@)(@@)(@@)(@@) $ 4411 - عمارة بن فيروز المدني عن ابن عمر لا يعرف(@)(@@)(@@)(@@) $ 4412 - عمارة بن أبي المطرف عن يزيد بن أبي مريم لا يعرف(@)(@@)(@@)(@@) $ 4413 - د / عمارة بن ميمون عن عطاء ما روى عنه سوى حماد بن سلمة(@)(@@)(@@)(@@) $ 4414 - عمارة الأحمر شيخ لأبي عاصم النبيل مجهول PageV02P461(@)(@@)(@@)(@@) $ 4415 - عمارة القرشي عن أبي بردة قال الأزدي ضعيف جدا له حديث يتجلى لنا ضاحكا(@)(@@)(@@)(@@) $ 4416 - ت س ق / عمر بن إبراهيم العبدي عن قتادة وثقه يحيى وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4417 - عمر بن إبراهيم العلوي الزيدي الكوفي مشهور متأخر معتزلي شيعي(@)(@@)(@@)(@@) $ 4418 - عمر بن إبراهيم بن خالد الكردي مولى بني هاشم عن عبد الملك بن عمير كذاب(@)(@@)(@@)(@@) $ 4419 - عمر بن إبراهيم عن القرظي وعنه هاشم بن هاشم وحده(@)(@@)(@@)(@@) $ 4420 - عمر بن أبان بن عثمان عن أبيه وعنه ولده إبراهيم له حديث ينكر(@)(@@)(@@)(@@) $ 4421 - عمر بن أحمد بن جرحة قال ابن طاهر روى عن الثقات موضوعات(@)(@@)(@@)(@@) $ 4422 - عمر بن أحمد بن روح الساجي قال ابن غلام الزهري ليس بالمرضي(@)(@@)(@@)(@@) $ 4423 - ت / عمر بن إسماعيل بن مجالد عن أبيه قال النسائي والدارقطني متروك(@)(@@)(@@)(@@) $ 4424 - عمر بن إسماعيل عن هشام بن عروة لا يعرف والخبر منكر باطل ذكره العقيلي(@)(@@)(@@)(@@) $ 4425 - عمر بن أيوب الغفاري عن عبد الله بن نافع عن مالك عن ربيعة عن أنس دخل علي فتزحزح له نبي الله PageV02P462 -(@)(@@)(@@)(@@) $ 4426 - عمر بن أيوب المزني عن أبي ضمرة تكلم فيه ابن حبان ووهاه الدارقطني(@)(@@)(@@)(@@) $ 4427 - عمر بن بشير عن الشعبي ضعفه يحيى بن معين 
ms223	 وقال أحمد صالح الحديث(@)(@@)(@@)(@@) $ 4428 - عمر بن بزيع عن الحارث بن حجاج لا يعرفان ذكره العقيلي(@)(@@)(@@)(@@) $ 4429 - عمر بن بسطام عن نصير بن القاسم إسناد مظلم والمتن باطل(@)(@@)(@@)(@@) $ 4430 - عمر بن أبي بكر المؤملي العدوي عن سليمان بن بلال قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 4431 - عمر بن أبي بكر الحجي عن ابن جريج متهم ليس بثقة(@)(@@)(@@)(@@) $ 4432 - عمر بن بلال الحمصي مولى بني أمية عن عبد الله بن بسر تكلم فيه ابن عدي فقال ليس بالمعروف ولا حديثه بالمحفوظ قلت له في رباعيات الشافعي(@)(@@)(@@)(@@) $ 4433 - عمر بن جعفر البصري الحافظ صدوق وقال أبو محمد السبيعي كذاب وقال غيره يخطئ كثيرا(@)(@@)(@@)(@@) $ 4434 - عمر بن حسن بن دحية إمام لكن اتهم بالمجازفة في نقله(@)(@@)(@@)(@@) $ 4435 - عمر بن حفص الأزدي عن أبي جمرة قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 4436 - عمر بن حفص بن ذكوان العبدي ويقال هو عمر بن أبي خليفة عن ثابت قال أحمد حرقنا حديثه وقال النسائي متروك PageV02P463(@)(@@)(@@)(@@) $ 4437 - عمر بن حفص بن عمر بن سعد القرظ عن آبائه قال يحيى بن معين ليس بشيء(@)(@@)(@@)(@@) $ 4438 - عمر بن حفص قاضي عمان قال أبو حاتم ليس بمعروف(@)(@@)(@@)(@@) $ 4439 - عمر بن حفص القرشي العبدري المكي عن ابن جريج عن عطاء عن ابن عباس قال لم يزل النبي صلى الله عليه وسلم يجهر ببسم الله الرحمن الرحيم حتى مات لا يعرف والخبر موضوع(@)(@@)(@@)(@@) $ 4440 - عمر بن حبيب العدوي القاضي عن هشام بن عروة كذبه ابن معين وقال النسائي ضعيف وقال ابن عدي مع ضعفه يكتب حديثه(@)(@@)(@@)(@@) $ 4441 - عمر بن حرملة تابعي لا يعرف لكنه وثق(@)(@@)(@@)(@@) $ 4442 - عمر بن الحسن الأشناني القاضي صاحب ذاك المجلس كذبه الدارقطني(@)(@@)(@@)(@@) $ 4443 - عمر بن حسن الراسبي عن أبي عوانة بحديث موضوع متنه علي سيد العرب PageV02P464(@)(@@)(@@)(@@) $ 4444 - م د ت ق / عمر بن الحكم بن ثوبان عن أسامة بن زيد والكبار ثقة صدوق لم يخرج له البخاري وذكر ابن الجوزي أن البخاري قال فيه ذاهب الحديث فكأن ابن الجوزي قد غلط 
ms224	 والله اعلم(@)(@@)(@@)(@@) $ 4445 - عمر بن الحكم الهذلي بصري قال أبو حاتم مجهول وقال هو والبخاري ذاهب الحديث(@)(@@)(@@)(@@) $ 4446 - عمر بن حماد بن سعيد الأبح عن ابن أبي عروبة جرحه ابن حبان وغيره(@)(@@)(@@)(@@) $ 4447 - م متابعة د ت ق / عمر بن حمزة بن عبد الله بن عمر عن عمه سالم ضعفه ابن معين والنسائي وقال أحمد أحاديثه مناكير وقد خرج له مسلم وقال الحاكم أحاديثه مستقيمة(@)(@@)(@@)(@@) $ 4448 - عمر بن حيان الدمشقي عن أم الدرداء ما روى عنه غير سعيد ابن أبي هلال(@)(@@)(@@)(@@) $ 4449 - عمر بن خليفة عن هشام بن حسان قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 4450 - س / عمر بن أبي خليفة عن محمد بن زياد القرشي بصري له حديث منكر قال أبو حاتم صالح الحديث(@)(@@)(@@)(@@) $ 4451 - عمر بن أبي خثعم راشد تراه(@)(@@)(@@)(@@) $ 4452 - عمر بن داود شيخ أبي علي الأهوازي روى حديثا كذبا وهو ابن سلمون الأنطرطوسي اتهم وقال الأهوازي سمعته يقول ختمت اثنين وأربعين ألف ختمة PageV02P465(@)(@@)(@@)(@@) $ 4453 - خ س / عمر بن ذر الهمداني عن أبيه ثقة لكنه رأس في الأرجاء(@)(@@)(@@)(@@) $ 4454 - عمر بن ذر عن أبي قلابة قال يعقوب الفسوي مجهول(@)(@@)(@@)(@@) $ 4455 - عمر بن ذؤيب عن ثابت البناني لا يعرف(@)(@@)(@@)(@@) $ 4456 - ت ق / عمر بن راشد اليمامي عن ابن أبي كثير ونافع ضعفوه وهو عمر بن أبي خثعم(@)(@@)(@@)(@@) $ 4457 - عمر بن راشد الكوفي أخو محمد واسماعيل قال ابن المديني ولدوا في بطن وقيل كانوا أربعة في بطن ويكنى ابوهم أبا إسماعيل وعمر لينه بعضهم بلا حجة(@)(@@)(@@)(@@) $ 4458 - عمر بن راشد المدني الجاري عن ابن عجلان ومالك قال أبو حاتم وجدت حديثه كذبا وهو عمر بن راشد مولى بني أمية الذي تكلم فيه ابن عدي يقال له الجاري كان ينزل الجار(@)(@@)(@@)(@@) $ 4459 - عمر بن راشد الثقفي عن الشعبي مجهول وقيل عمر بن رشيد قلت روى عنه اثنان(@)(@@)(@@)(@@) $ 4460 - عمر بن الربيع الخشاب قال القراب في الوفيات له كذاب(@)(@@)(@@)(@@) $ 4461 - عمر بن ربيعة أبو ربيعة الايادي عن الحسن قال أبو حاتم منكر الحديث 
ms225	(@)(@@)(@@)(@@) $ 4462 - عمر بن رديح عن عطاء بن أبي ميمونة ضعفه أبو حاتم وقال ابن معين صالح الحديث PageV02P466(@)(@@)(@@)(@@) $ 4463 - عه / عمر بن روبة الحمصي شيخ محمد بن حرب فيه لين وقال البخاري فيه نظر(@)(@@)(@@)(@@) $ 4464 - ق / عمر بن رياح أبو حفص البصري عن عمرو بن شعيب وقيل فيه عمر بن أبي عمر قال الفلاس دجال وقال الدارقطني متروك(@)(@@)(@@)(@@) $ 4465 - عمر بن زرعة الخارفي عن ابن جريج قال خ فيه نظر(@)(@@)(@@)(@@) $ 4466 - عمر بن زياد عن الأسود بن قيس قال البخاري تعرف منه وتنكر(@)(@@)(@@)(@@) $ 4467 - عمر بن زياد المدني شيخ ليعقوب بن حميد بن كاسب لا يعرف(@)(@@)(@@)(@@) $ 4468 - د ت ق / عمر بن زيد الصنعاني عن أبي الزبير قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 4469 - عمر بن سعد الخولاني عن أنس بن مالك متهم بوضع الحديث(@)(@@)(@@)(@@) $ 4470 - عمر بن سعد عن الأعمش شيعي راجح قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 4471 عمر بن سعد عن عمر الثقفي قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 4472 - عمر بن سعيد الدمشقي أبو حفص عن سعيد بن بشير تركوه(@)(@@)(@@)(@@) $ 4473 - عمر بن سعيد الأبح بصري عن سعيد بن أبي عروبة قال خ منكر الحديث(@)(@@)(@@)(@@) $ 4474 - عمر بن سعيد بن شريح عن الزهري فيه لين ويقال له ابن سرحة له مناكير وذكره ابن حبان وقال الدارقطني ضعيف PageV02P467(@)(@@)(@@)(@@) $ 4475 - د ت / عمر بن سفينة عن أبيه في لحم الحبارى وعنه ابنه بريه لا يعرف قال خ إسناد مجهول(@)(@@)(@@)(@@) $ 4476 - عه / عمر بن أبي سلمة بن عبد الرحمن ضعفه ابن معين وقال النسائي وغيره ليس بالقوي(@)(@@)(@@)(@@) $ 4477 - عمر بن سليم عن يوسف بن إبراهيم لا يدرى من هما قال العقيلي لهما مناكير(@)(@@)(@@)(@@) $ 4478 - د ق / عمر بن سليم بصري شيخ لعبد الوارث بحديث منكر(@)(@@)(@@)(@@) $ 4479 - عمر بن سليمان الحادي هو عمر بن موسى بن سليمان السامي عم الكديمي روى عن حماد بن سلمة وقال عمران السختياني ثنا موسى بن سليمان السامي فوهم في اسمه قال ابن عدي الضعف على رواياته بين(@)(@@)(@@)(@@) $ 4480 
ms226	 - عمر بن سليمان عن الضحاك بن حمرة حديثه في الإسراء موضوع(@)(@@)(@@)(@@) $ 4481 - عمر بن أبي سليمان عن بعض التابعين حجازي لا يعرف(@)(@@)(@@)(@@) $ 4482 - عمر بن سهل عن شعبة لين لكن قال أبو زرعة صدوق(@)(@@)(@@)(@@) $ 4483 - عمر بن سيار عن ابن أخي الزهري ليس بالمتين(@)(@@)(@@)(@@) $ 4484 - ت / عمر بن شاكر عن أنس ضعفه أبو حاتم وغيره وقال ابن عدي روى نسخة عشرين حديثا غير محفوظة PageV02P468(@)(@@)(@@)(@@) $ 4485 - ق / عمر بن شبيب المسلي الكوفي عن عبد الملك بن عمير قال أبو زرعة واهي الحديث وقال النسائي ليس بالقوي وضعفه الدارقطني(@)(@@)(@@)(@@) $ 4486 - عمر بن شريك عن أبيه مجهول(@)(@@)(@@)(@@) $ 4487 - عمر بن شقيق البصري والد الحسن عن إسماعيل بن سالم مقارب الحديث(@)(@@)(@@)(@@) $ 4488 - عمر بن شوذب شيخ لوكيع ضعف وقد وثقه ابن معين(@)(@@)(@@)(@@) $ 4489 - عمر بن شيبة عن المقبري مجهول(@)(@@)(@@)(@@) $ 4490 - عمر بن صالح الواسطي عن حماد بن زيد حديثه منكر(@)(@@)(@@)(@@) $ 4491 - عمر بن صالح البصري عن أبي جمرة قال أبو حاتم ضعيف(@)(@@)(@@)(@@) $ 4492 - عمر بن صالح عن عبد الله بن يزيد قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 4493 - عمربن أبي صالح عن أبي غالب لا يعرف والراوي عنه مجهول(@)(@@)(@@)(@@) $ 4494 - ق / عمر بن صبح عن قتادة وغيره هالك اعترف بوضع الحديث(@)(@@)(@@)(@@) $ 4495 - ق / عمر بن صهبان عن نافع تركوه(@)(@@)(@@)(@@) $ 4496 - عمر بن طلحة الأزدي عن ابن أبي عروبة تكلم فيه ابن حبان ولا يعرف(@)(@@)(@@)(@@) $ 4497 - بخ عمر بن طلحة بن علقمة بن وقاص عن المقبري فيه جهالة وقال أبو حاتم محله الصدق(@)(@@)(@@)(@@) $ 4498 - م س / عمر بن عامر البصري عن قتادة ضعفه ابن معين PageV02P469 مرة ووثقه أخرى(@)(@@)(@@)(@@) $ 4499 - د ت / عمر بن عبد الله مولى غفرة مشهور ضعفه ابن معين والنسائي(@)(@@)(@@)(@@) $ 4500 - دق / عمر بن عبد الله بن يعلي بن مرة الثقفي عن أنس ضعفوه(@)(@@)(@@)(@@) $ 4501 - ت ق / عمر بن عبد الله بن أبي خثعم اليمامي عن يحيى بن أبي كثير قال البخاري ذاهب الحديث(@)(@@)(@@)(@@) $ 4502 - عمر بن عبد الله البكري شيخ لابن المبارك مجهول 
ms227	(@)(@@)(@@)(@@) $ 4503 - عمر بن عبد الله الرومي عن شريك قال ابن حبان يأتي عن الثقات بما ليس من حديثهم قلت هذا غلط من ابن حبان إنما الراوي عن شريك محمد ولد عمر فإنه واه فأما عمر فثقة يروي عنه قتيبة والكبار(@)(@@)(@@)(@@) $ 4504 - عمر بن عبد الرحمن الوقاصي عن سالم بن عبد الله ضعفه الازدي وإنما هو عثمان بن عبد الرحمن(@)(@@)(@@)(@@) $ 4505 - عمر بن عبد الرحمن شيخ لموسى بن عقبة لم يصح حديثه(@)(@@)(@@)(@@) $ 4506 - عمر بن عبيد الخزاز ضعفه أبو حاتم وهو عمر بن عبيد الله البصري بياع الخمر عن هشام بن عروة فأما(@)(@@)(@@)(@@) $ 4507 - عمر بن عبيد الطنافسي فثقة(@)(@@)(@@)(@@) $ 4508 - عمر بن عثمان بن عفان قال البخاري في إسناده شيء يعني إنما الصواب عمرو PageV02P470(@)(@@)(@@)(@@) $ 4509 - عمر بن عطاء عن أبي سلمة قال أبو حاتم مضطرب الحديث(@)(@@)(@@)(@@) $ 4510 - د ق / عمر بن عطاء عن عكرمة ويعرف بابن وراز ضعفه غير واحد فأما(@)(@@)(@@)(@@) $ 4511 - عمر بن عطاء بن أبي الخوار صاحب ابن عباس فثقة(@)(@@)(@@)(@@) $ 4512 - عمر بن علي بن سعيد عن يوسف بن حسن البغدادي إسناد مظلم بخبر منكر(@)(@@)(@@)(@@) $ 4513 - عمر بن علي بن الفارض ينعق بالإتحاد تلويحا وتصريحا في شعره روى عن القاسم بن عساكر(@)(@@)(@@)(@@) $ 4514 - ع / عمر بن علي المقدمي ثقة عن هشام بن عروة وغيره ولكنه مدلس وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4515 - عمر بن عمر بن محمد بن حاطب الجمحي عن جده مجهول(@)(@@)(@@)(@@) $ 4516 - ق / عمر بن أبي عمر هو ابن رياح واه(@)(@@)(@@)(@@) $ 4517 - عمر بن عمرو العسقلاني عن الثوري قال ابن عدي كان يضع الحديث وهو أبو حفص الطحان(@)(@@)(@@)(@@) $ 4518 - عمر بن عمران السدوسي مجهول عن دهثم بن قران(@)(@@)(@@)(@@) $ 4519 - عمر بن عمران الحنفي ضعفه الدارقطني(@)(@@)(@@)(@@) $ 4520 - عمر بن عيسى الأسلمي عن ابن جريج قال البخاري منكر الحديث PageV02P471(@)(@@)(@@)(@@) $ 4521 - عمر بن عيسى الليثي هو ابن داب ضعفوه له عن ابن كيسان(@)(@@)(@@)(@@) $ 4522 - عمر بن عيسى عن مكحول لم يرو عن ذا إلا الهيثم ابن حميد(@)(@@)(@@)(@@) $ 4523 - عمر 
ms228	 بن غياث عن عاصم بن بهدلة ضعفوه وقال خ منكر الحديث(@)(@@)(@@)(@@) $ 4524 - عمر بن فرقد عن عطاء بن السائب قال البخاري منكر الحديث فيه نظر(@)(@@)(@@)(@@) $ 4525 - عمر بن فروخ القتاب شيخ ليعقوب الحضرمي ضعف(@)(@@)(@@)(@@) $ 4526 - عمر بن قيس المكي سندول عن عطاء هالك تركوا حديثه(@)(@@)(@@)(@@) $ 4527 - عمر بن أبي كبشة عن مورق العجلي بصري مجهول(@)(@@)(@@)(@@) $ 4528 - عمر بن أبي ليلى عن محمد بن كعب مجهول قلت روى عنه ابن أبي فديك والواقدي(@)(@@)(@@)(@@) $ 4529 - عمر بن أبي مالك عن الزهري مجهول(@)(@@)(@@)(@@) $ 4530 - عمر بن المثنى عن أبي إسحاق ضعفه الأزدي(@)(@@)(@@)(@@) $ 4531 - عمر بن المثنى عن قتادة لا يعرف(@)(@@)(@@)(@@) $ 4532 - عمر بن محمد بن السري عن البغوي هالك اتهمه أبو الحسن ابن الفرات PageV02P472(@)(@@)(@@)(@@) $ 4533 - عمر بن محمد بن صهبان وينسب إلى جده ساقط قال أبو زرعة واه(@)(@@)(@@)(@@) $ 4534 - خ م / عمر بن محمد بن زيد العمري نزيل عسقلان ثقة لينه يحيى بن معين(@)(@@)(@@)(@@) $ 4535 - عمر بن محمد بن عبد الله الشعيثي عن أبيه بحديث منكر في ذم غيلان(@)(@@)(@@)(@@) $ 4536 - عمر بن محمد بن أحمد بن مقبل عن المحاملي متهم واه وهو أبو القاسم ابن الثلاج(@)(@@)(@@)(@@) $ 4537 - عمر بن محمد بن حسين عن مطرف بن طريف ضعفه الخطيب(@)(@@)(@@)(@@) $ 4538 - عمر بن محمد بن طبرزد أكثر سماعه بإفادة أخيه وقد تكلم فيه كما سيأتي وقال لي ابن الظاهري لما ذاكرته بزاهر وتركه للصلاة فقال وإن ابن طبرزد يعني عمر ما كان يصلي(@)(@@)(@@)(@@) $ 4539 - عمر بن محمد التلي عن هلال بن العلاء قال الدارقطني وضاع للحديث(@)(@@)(@@)(@@) $ 4540 عمر بن محمد الترمذي عن محمد بن عبيد الله بن مرزوق قال ابن أبي الفوارس فيه نظر(@)(@@)(@@)(@@) $ 4541 - عمر بن المختار البصري قال ابن عدي روى الأباطيل عن يونس بن عبيد(@)(@@)(@@)(@@) $ 4542 - عمر بن مدرك القاص عن القعنبي وغيره ضعيف(@)(@@)(@@)(@@) $ 4543 - عمر بن مساور أو ابن مسافر عن الحسن وغيره ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 4544 - عمر بن مسكين عن نافع في حديثه نكرة ولا يتابع على حديثه في الجنازة 
ms229	 PageV02P473(@)(@@)(@@)(@@) $ 4545 - عمر بن مصعب بن الزبير عن عروة جاء في إسناد مظلم فيحرر امره(@)(@@)(@@)(@@) $ 4546 - عمر بن معن شيخ لعبد الله بن المبارك مجهول(@)(@@)(@@)(@@) $ 4547 - عمر بن أبي معروف المكي عن ليث و(@)(@@)(@@)(@@) $ 4548 - د س / عمر بن معتب تابعي لا يعرفان ويقال عمر بن أبي مغيث(@)(@@)(@@)(@@) $ 4549 - عمر بن المغيرة عن داود بن أبي هند قال البخاري مجهول ولينه غيره(@)(@@)(@@)(@@) $ 4550 - عمر بن موسى بن وجيه وهو الميتمي أو هما اثنان واهيان وقد بينتهما في تاريخي(@)(@@)(@@)(@@) $ 4551 - عمر بن موسى الوجيهي الحمصي عن مكحول قال ابن حبان يروي الموضوعات وورى عنه عفير بن معدان وأشهد بكذبه وقال ابن عدي هو ممن يضع(@)(@@)(@@)(@@) $ 4552 - عمر بن موسى عم الكديمي قال ابن عدي ضعيف يسرق الحديث هو الحادي أبو حفص عن حماد بن سلمة(@)(@@)(@@)(@@) $ 4553 - عمر بن موسى الأنصاري الكوفي قال الدارقطني متروك وأحسبه هو الوجيهي(@)(@@)(@@)(@@) $ 4554 - عمر بن ميناء عن أبيه(@)(@@)(@@)(@@) $ 4555 - وعمر بن أبي مالك(@)(@@)(@@)(@@) $ 4556 - وعمر بن معين مجاهيل PageV02P474(@)(@@)(@@)(@@) $ 4557 - عمر بن نافع الثقفي عن أنس واه ما اختلف قول ابن معين فيه أنه ليس بشيء(@)(@@)(@@)(@@) $ 4558 - خ م / عمر بن نافع مولى ابن عمر ثقة وقال ابن سعد لا يحتجون به(@)(@@)(@@)(@@) $ 4559 - عمر بن نبهان الغبري عن الحسن ضعفه أبو حاتم وغيره(@)(@@)(@@)(@@) $ 4560 - عمر بن نبهان عن أبي ثعلبة الأشجعي قال أبو حاتم لا أعرفه(@)(@@)(@@)(@@) $ 4561 - عمر بن نجيح عن سليمان بن أرقم ضعفه الدارقطني(@)(@@)(@@)(@@) $ 4562 - عمر بن نسطاس عن بكير بن القاسم فذكر خبرا موضوعا(@)(@@)(@@)(@@) $ 4563 - عمر بن نعيم روى عنه مكحول ولا يعرف(@)(@@)(@@)(@@) $ 4564 - عمر بن واصل عن سهل بن عبد الله اتهمه الخطيب بالوضع وساق له حديثا مكذوبا(@)(@@)(@@)(@@) $ 4565 - عمر بن واصل آخر ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 4566 - عمر بن الوليد الشني عن عكرمة قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 4567 - عمر بن هارون الأنصاري عن أبيه عن أبي هريرة بخبر لم يصح لا يعرف(@)(@@)(@@)(@@) $ 4568 - ت ق / عمر بن هارون البلخي أبو حفص عن ثور تركوه 
ms230	 وكذبه بعضهم(@)(@@)(@@)(@@) $ 4569 - عمر بن هاني الطائي شيخ للهيثم بن عدي لا يعرف والهيثم هالك PageV02P475(@)(@@)(@@)(@@) $ 4570 - عمر بن هرمز عن الربيع بن أنس مجهول يروي عنه إسحاق بن راهوية(@)(@@)(@@)(@@) $ 4571 - عمر بن هشام عن الخريبي لا يعرف روى عنه أبو داود خارج السنن(@)(@@)(@@)(@@) $ 4572 - عمر بن أبي هوذة عن ابن جريج مجهول لينه يحيى بن معين(@)(@@)(@@)(@@) $ 4573 - عمر بن يحيى عن شعبة قال الحافظ أبو نعيم متروك(@)(@@)(@@)(@@) $ 4574 - عمر بن يحيى الزرقي شيخ لابن عون قال ابن معين ليس بشئ(@)(@@)(@@)(@@) $ 4575 - عمر بن يزيد السياري الرفا عن شعبة قال ابن عدي حديث كالموضوع(@)(@@)(@@)(@@) $ 4576 - عمر بن يزيد عن عطاء وغيره منكر الحديث(@)(@@)(@@)(@@) $ 4577 - عمر بن يعلى ضعفه النسائي وهو عمر بن عبد الله بن يعلى بن مرة(@)(@@)(@@)(@@) $ 4578 - عمر بن يونس وليس باليمامي شويخ فيه ضعف(@)(@@)(@@)(@@) $ 4579 - عمر الهجنع عن أبي بكرة الثقفي لا يعرف(@)(@@)(@@)(@@) $ 4580 - عمر العنزي شيخ لقتادة مجهول(@)(@@)(@@)(@@) $ 4581 - عمر عن رجل عن القاسم أبي عبد الرحمن لا يعرف وكأنه الوجيهي له في اليمين PageV02P476(@)(@@)(@@)(@@) $ 4582 - عمر أبو الخطاب عن أبي زرعة وعنه ليث بن أبي سليم مجهول(@)(@@)(@@)(@@) $ 4583 - عمر الدمشقي عن واثلة وعنه ابنه لا يدرى من هو(@)(@@)(@@)(@@) $ 4584 - عمران بن أبان الواسطي عن محمد بن مسلم الطائفي ضعفه أبو حاتم والنسائي(@)(@@)(@@)(@@) $ 4585 - عمران بن إسحاق عن شعبة وعنه اسماعيل بن عياش لا يعرف(@)(@@)(@@)(@@) $ 4586 - د ت / عمران بن أنس أو ابن أبي أنس عن عطاء قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 4587 - عمران بن أوس بن ضمعج عن أبيه تفرد بحديث وفيه جهالة(@)(@@)(@@)(@@) $ 4588 - عمران بن أيوب قال ابن ماكولا يتهمونه(@)(@@)(@@)(@@) $ 4589 - عمران بن تمام عن أبي جمرة قال أبو حاتم أتى بخبر منكر من إكفاء الدين تفصح النبط واتخاذ القصور في الأمصار(@)(@@)(@@)(@@) $ 4590 - عمران بن ثابت عن علي وعنه إسحاق بن نباته لا يكاد يعرف(@)(@@)(@@)(@@) $ 4591 - عمران بن أبي ثابت روى عنه ابنه عبدالعزيز تكلم فه أبو حاتم(@)(@@)(@@)(@@) $ 4592 - عمران بن حميري عن عمار بن ياسر لا 
ms231	 يعرف(@)(@@)(@@)(@@) $ 4593 - عمران بن خالد الخزاعي عن ابن سيرين قال أبو حاتم ضعيف وقال أحمد متروك الحديث PageV02P477(@)(@@)(@@)(@@) $ 4594 - عمران بن خالد بن طليق الخزاعي عن آبائه وعنه الفسوي النظر إلى علي عبادة(@)(@@)(@@)(@@) $ 4595 - عمران بن أبي خليد الواسطي قال أبو داود ليس بثقة(@)(@@)(@@)(@@) $ 4596 - عه / عمران بن داود أبو العوام القطان عن الحسن صدوق ضعفه يحيى والنسائي(@)(@@)(@@)(@@) $ 4597 - عمران بن زياد القسملي عن ثابت قال الأزدي مجهول منكر الحديث(@)(@@)(@@)(@@) $ 4598 - ت ق / عمران بن زيد أبو يحيى التغلبي الملآئي عن أبي يحيى القتات وغيره مختلف في توثيقه(@)(@@)(@@)(@@) $ 4599 - عمران بن سريع عن حذيفة قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 4600 - عمران بن أبي طلحة شيخ لمعن بن عيسى مجهول(@)(@@)(@@)(@@) $ 4601 - س / عمران بن ظبيان عن عدي بن ثابت فيه لين وقال البخاري فيه نظر(@)(@@)(@@)(@@) $ 4602 - عمران بن عبد المعافري ضعفه ابن معين قلت من أفراد شيوخ الأئمة(@)(@@)(@@)(@@) $ 4603 - عمران بن عبد العزيز أبو ثابت الزهري شيخ لأبي مصعب قال يحيى منكر الحديث(@)(@@)(@@)(@@) $ 4604 - د ق / عمران بن عبد المعافري عن عبد الله بن عمرو فيه لين ولا يكاد يعرف PageV02P478(@)(@@)(@@)(@@) $ 4605 - عمران بن عكرمة عنه ذؤيب بن عباد مجهولان(@)(@@)(@@)(@@) $ 4606 - عمران بن أبي ثابت عبد العزيز قال أبو حاتم وغيره منكر الحديث وقد مر(@)(@@)(@@)(@@) $ 4607 - م عمران بن أبي عطاء أبو حمزة الأسدي الواسطي عن ابن الحنفية وثق قال أبو زرعة لين وذكر له العقيلي حديثا استنكره(@)(@@)(@@)(@@) $ 4608 - عمران بن أبي عمران الرملي عن بقية فذكر حديثا موضوعا هو آفته(@)(@@)(@@)(@@) $ 4609 - عمران بن أبي عمرو الرملي عن أبيه عن جابر في مس الذكر لا يصح حديثه لاضطرابه(@)(@@)(@@)(@@) $ 4610 - عه / عمران بن عيينة الهلالي أخو سفيان قال أبو حاتم لا يحتج به يأتي بالمناكير(@)(@@)(@@)(@@) $ 4611 - عمران بن أبي الفضل عن نافع قال ابن معين ليس بشيء وقال أبو حاتم روى عنه إسماعيل بن عياش حديثين موضوعين باطلين(@)(@@)(@@)(@@) $ 4612 - عمران بن قيس عن ابن عمر مجهول وقال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 4613 - عمران بن 
ms232	 قدامة العمي عن أنس قال يحيى القطان PageV02P479 لم يكن به بأس ولكن لم يكن من أهل الحديث كتبت عنه ورميت به وقال أبو حاتم ما به بأس(@)(@@)(@@)(@@) $ 4614 - عمران بن أبي كثير عن سعيد بن المسيب لا يعرف(@)(@@)(@@)(@@) $ 4615 - عمران بن أبي مدرك عن القاسم بن مخيمرة كذلك(@)(@@)(@@)(@@) $ 4616 - عمران بن مسلم الفزاري عن مجاهد كان رافضيا(@)(@@)(@@)(@@) $ 4617 - عمران بن مسلم عن عبد الله بن ديناز قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 4618 - عمران القصير عن أنس وعنه جعفر بن برقان مقل لا يكاد يعرف فأما(@)(@@)(@@)(@@) $ 4619 - خ م / عمران بن مسلم القصير صاحب الحسن فثقة لكنه قدري(@)(@@)(@@)(@@) $ 4620 - عمران بن موسى عن مكحول لا يكاد يعرف والظاهر أنه أخوه أيوب سمع أيضا من المقبري وعنه ابن جريج وابن علية وثق(@)(@@)(@@)(@@) $ 4621 - عمران بن ميثم تابعي قال العقيلي من كبار الرافضة(@)(@@)(@@)(@@) $ 4622 - عمران بن هارون المقدسي عن ابن لهيعة صدقه أبو زرعة ولينه ابن يونس(@)(@@)(@@)(@@) $ 4623 - عمران بن وهب الطائي عن أنس حديث الطير ضعفه أبو حاتم PageV02P480(@)(@@)(@@)(@@) $ 4624 - عمران بن يزيد روى عنه ثابت بن عبيدة مجهول وكذا(@)(@@)(@@)(@@) $ 4625 - عمران شيخ لابن عيينة(@)(@@)(@@)(@@) $ 4626 - عمران بن يزيد وقيل ابن زيد التغلبي روى عنه أبو النضر ضعفه ابن معين(@)(@@)(@@)(@@) $ 4627 - عمران العمي عن الحسن هو ابن قدامة(@)(@@)(@@)(@@) $ 4628 - د / عمران البارقي شيخ للثوري لا يعرف لكن وثق(@)(@@)(@@)(@@) $ 4629 - عمرو بن الأزهر العتكي قاضي جرجان عن هشام بن عروة كذاب قال أحمد وغيره كان يضع الحاديث(@)(@@)(@@)(@@) $ 4630 - عمرو بن إسماعيل الهمداني عن أبي إسحاق بخبر كذب في علي وهو مثلي كشجرة وأنا أصلها علي فرعها والحسن والحسين ثمرتها والشيعة ورقها(@)(@@)(@@)(@@) $ 4631 - عمرو بن بحر الجاحظ المتكلم صاحب الكتب قال ثعلب ليس بثقة ولا مأمون(@)(@@)(@@)(@@) $ 4632 - عمرو بن أبي برة عن شعبة مجهول(@)(@@)(@@)(@@) $ 4633 - عمرو بن بشير العنسي عن الوليد بن أبي السائب ثقة قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 4634 - ق / عمرو بن بكر السكسكي الرملي عن ابن جريج واه قال ابن عدي له مناكير PageV02P481(@)(@@)(@@)(@@) $ 4635 
ms233	 - عمرو بن أبي بكر عن محمد بن كعب القرظي له حديث منكر(@)(@@)(@@)(@@) $ 4636 - عمرو بن ثابت بن أبي المقدام متروك وقال أبو داود رافضي(@)(@@)(@@)(@@) $ 4637 - عمرو بن جابر أبو زرعة الحضرمي جابر عن جابر وغيره هالك وقال ابن لهيعة شيخ أحمق كان يقول إن عليا في السحاب وقال غيره كذاب(@)(@@)(@@)(@@) $ 4638 - عمرو بن جرير أبو سعيد البجلي عن إسماعيل بن أبي خالد كذبه أبو حاتم(@)(@@)(@@)(@@) $ 4639 - عمرو بن جميع عن الأعمش قال ابن عدي يتهم بوضع الحديث(@)(@@)(@@)(@@) $ 4640 - عمرو بن جراد التميمي عن أبي موسى الأشعري لا يدرى من هو(@)(@@)(@@)(@@) $ 4641 - د / عمرو بن حريش الزبيدي تابعي ما روى عنه سوى أبي سفيان ولا يعرف أيضا(@)(@@)(@@)(@@) $ 4642 - عمرو بن الحزور عن الحسن وعنه شباك إسناد مظلم لا شيء(@)(@@)(@@)(@@) $ 4643 - ق / عمرو بن الحصين العقيلي عن ابن علاثة وغيره ضعفوه جدا(@)(@@)(@@)(@@) $ 4644 - عمرو بن حكام عن شعبة ضعفه ابن المديني وتركه أحمد وغيره وهو صاحب حديث الحق الزنجيبل وأن ملك الروم أهداه PageV02P482(@)(@@)(@@)(@@) $ 4645 - م / عمرو بن حماد بن طلحة القناد روى عنه م حديثا واحدا عن أسباط بن نصر صدوق قال د لكن كان من الرافضة(@)(@@)(@@)(@@) $ 4646 - عمرو بن حمزة عن صالح المري قال الدارقطني وغيره ضعيف(@)(@@)(@@)(@@) $ 4647 - عمرو بن حميد قاضي الدينور عن الليث بن سعد هالك وخبره موضوع(@)(@@)(@@)(@@) $ 4648 - عمرو بن خالد أبو يوسف أو أبو حفص الأعشى عن هشام بن عروة قال ابن عدي منكر الحديث وقال ابن حبان لا تحل الرواية عنه(@)(@@)(@@)(@@) $ 4649 - ق / عمرو بن خالد القرشي الواسطي عن زيد بن علي عن آبائه كذبه أحمد والدارقطني وقال وكيع كان في جوارنا يضع الحديث ثم تحول إلى واسط فأما(@)(@@)(@@)(@@) $ 4650 - عمرو بن خالد الحراني ثم المصري فثقة من شيوخ البخاري(@)(@@)(@@)(@@) $ 4651 - د ق / عمرو بن خزيمة لم يرو عنه سوى هشام بن عروة لكنه وثق(@)(@@)(@@)(@@) $ 4652 - عمرو بن خليف أبو صالح شيخ لابن قتيبة العسقلاني قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 4653 - عمرو بن خير الشعباني 
ms234	 عن كعب الأحبار لا يعرف PageV02P483(@)(@@)(@@)(@@) $ 4654 - عمرو بن داود شيخ لعلي بن ميمون قال الأزدي لا يكتب حديثه(@)(@@)(@@)(@@) $ 4655 - ت ق / عمرو بن دينار قهرمان آل الزبير بصري يروي عن سالم بن عبد الله ضعفوه(@)(@@)(@@)(@@) $ 4656 - عمرو ذومر الهمداني عن علي قال البخاري لا يعرف(@)(@@)(@@)(@@) $ 4657 - عمرو بن زياد الباهلي عن مالك كذبه أبو حاتم وغيره كان ببغداد(@)(@@)(@@)(@@) $ 4658 - عمرو بن زياد الثوباني عن بكر بن مضر قال الدارقطني وغيره يضع الحديث له في فضل فاطمة(@)(@@)(@@)(@@) $ 4659 - عمرو بن سعيد السامي عن أنس وهاه ابن حبان وغيره فأما(@)(@@)(@@)(@@) $ 4660 - عمرو بن سعيد البصري فثقة(@)(@@)(@@)(@@) $ 4661 - ع / عمرو بن أبي سلمة التنيسي عن الأوزاعي ثقة و قال أبو حاتم لا يحتج به وقال الساجي ضعيف(@)(@@)(@@)(@@) $ 4662 - عه / عمرو بن شعيب مختلف فيه وحديثه حسن وفوق الحسن قال يحيى القطان إذا روى عنه ثقة فهو حجة وقال أحمد ربما احتججنا به وقال البخاري رأيت أحمد وإسحاق وأبا عبيد وعامة أصحابنا يحتجون به فمن الناس بعدهم PageV02P484 قلت ومع هذا القول فلم يحتج به في صحيحه(@)(@@) وقال أيوب السختياني كنت إذا أتيت عمرو بن شعيب غطيت رأسي حياء من الناس وقال ابن معين ليس بذاك وهو ثقة في نفسه إنما بلي بكتب أبيه عن جده وقال أبو زرعة إنما أنكروا عليه أنه روى صحيفة كانت عنده وقال أحمد ربما وجس في القلب منه وله مناكير(@)(@@)(@@)(@@) $ 4663 - عمرو بن شمر الجعفي عن جعفر بن محمد تركه الدارقطني وعدة وكان شيعيا جبلا(@)(@@)(@@)(@@) $ 4664 - عمرو بن شوذب قال الأزدي لا يساوي شيئا قلت هو أظن عمر(@)(@@)(@@)(@@) $ 4665 - عمرو بن صالح عن صهيب بن مهران مجهول وكذا(@)(@@)(@@)(@@) $ 4666 - عمرو بن صالح عن إسماعيل بن أمية(@)(@@)(@@)(@@) $ 4667 - عمرو بن صالح قاضي رامهرمز منكر الحديث روى عنه زيد بن الحريش(@)(@@)(@@)(@@) $ 4668 - عمرو بن صفوان عن عروة لا يعرف وكذا(@)(@@)(@@)(@@) $ 4669 - د عمرو بن عبد الله السيباني تابعي(@)(@@)(@@)(@@) $ 4670 - ع / عمرو بن عاصم الكلابي صدوق مشهور قال أبو حاتم يكتب حديثه 
ms235	 ولا يحتج به قال بندار لولا شيء لتركته PageV02P485(@)(@@)(@@)(@@) $ 4671 - ع / عمرو بن عبد الله أبو إسحاق السبيعي ثقة نبيل شاخ ونسي لم يضعفه أحد وسمع منه ابن عيينة وقد تغير شيئا(@)(@@)(@@)(@@) $ 4672 - عمرو بن عبد الله النمري قال الأزدي ضعيف جدا(@)(@@)(@@)(@@) $ 4673 - د / عمرو بن عبد الله بن لأاسوار أبو الأسوار الصنعاني عن عكرمة قال ابن معين وغيره ليس بالقوي وبعضهم قواه(@)(@@)(@@)(@@) $ 4674 - عمرو بن عبد الجبار السنجاري قال ابن عدي روى عن عمه مناكير(@)(@@)(@@)(@@) $ 4675 - عمرو بن عبد الجبار اليمامي عن أبيه عن أبي عوانة الوضاح فذكر حديثا بسند الصحاح لا تقوم الساعة حتى يقولون بآرائهم لا يعولون على ما روى عني تفرد به محمد بن سهل أحد الكذابين(@)(@@)(@@)(@@) $ 4676 - عمرو بن عبد الرحمن العسقلاني عن عطاء مجهول(@)(@@)(@@)(@@) $ 4677 - عمرو بن عبد الغفار الفقيمي عن الأعمش هالك قال أبو حاتم متروك الحديث قال ابن عدي اتهم بالوضع(@)(@@)(@@)(@@) $ 4678 - عمرو بن عبيد شيخ المعتزلة سمع الحسن كذبه أيوب ويونس وتركه النسائي(@)(@@)(@@)(@@) $ 4679 - عمرو بن عتاب عن عاصم بن أبي النجود متهم ليس بشيء(@)(@@)(@@)(@@) $ 4680 - ق / عمرو بن عثمان الكلابي عن زهير بن معاوية وغيره تركه النسائي PageV02P486(@)(@@)(@@)(@@) $ 4681 - عمرو بن عثمان عن ابن عباس رضي الله عنه قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 4682 - عمرو بن عثمان الثقفي عن سفيان الثوري لا يتابع على حديثه قاله العقيلي(@)(@@)(@@)(@@) $ 4683 - عمرو بن عطية العوفي روى عنه سعيد بن محمد الجرمي ضعفه الدارقطني(@)(@@)(@@)(@@) $ 4684 - عمرو بن أبي روق عطية بن الحارث الوادعي ضعفه الدارقطني أيضا(@)(@@)(@@)(@@) $ 4685 - ع / عمرو بن أبي عمرو مولى المطلب لينه يحيى بن معين وقال أحمد ما به بأس ووثقه غيره وقال أبو داود ليس بالقوي خرجا له في الأصول(@)(@@)(@@)(@@) $ 4686 - عمرو بن عون بن تميم شيخ لسعيد بن عفير مجهول(@)(@@)(@@)(@@) $ 4687 - عمرو بن عيسى عن ابن جريج لا يعرف(@)(@@)(@@)(@@) $ 4688 - عمرو بن فائد الأسواري عن مطر الوراق قال الدارقطني متروك(@)(@@)(@@)(@@) $ 4689 - عمرو بن فيروز عن عاصم بن علي بخبر موضوع PageV02P487(@)(@@)(@@)(@@) $ 4690 - عمرو بن 
ms236	 فروخ شيخ ليعقوب الحضرمي قال البيهقي ليس بالقوي(@)(@@)(@@)(@@) $ 4691 - عمرو بن القاسم الكوفي عن منصور قال ابن عدي ضعيف(@)(@@)(@@)(@@) $ 4692 - عمرو بن قيس الكندي الكوفي عن أبيه قال ابن معين لا شيء قد رأيته وثقه أبو حاتم فأما(@)(@@)(@@)(@@) $ 4693 - عه / عمرو بن قيس الكندي الكوفي أحد التابعين المعمرين المتأخرين(@)(@@)(@@)(@@) $ 4694 - م عه / وعمرو بن قيس الملائي الكوفي الراوي عن عكرمة وطبقته فثقتان(@)(@@)(@@)(@@) $ 4695 - وعمرو بن قيس الليثي شيخ لنصر بن علي الجهضمي ما علمت فيه جرحا(@)(@@)(@@)(@@) $ 4696 - عه / وعمرو بن أبي قيس الرازي عن المنهال بن عمرو فصدوق له أوهام قال ابن الجوزي عقيب الأول ويأتي في الحديث عمرو بن قيس خمسة ليس فيهم من طعن فيه غير هذا(@)(@@)(@@)(@@) $ 4697 - عمرو بن كثير القيسي عن ابن أبي الزناد مجهول(@)(@@)(@@)(@@) $ 4698 - عمرو بن كعب عن علي مرسلا مجهول(@)(@@)(@@)(@@) $ 4699 - ت / عمرو بن مالك الراسبي البصري لا النكري شيخ للترمذي قال ابن عدي كان يسرق الحديث وضعفه أبو يعلى وثنا عنه قلت فأما(@)(@@)(@@)(@@) $ 4700 - عه / عمرو بن مالك النكري عن أبي الجوزاء و PageV02P488(@)(@@)(@@)(@@) $ 4701 - عه / عمرو بن مالك الجنبي عن الصحابة فثقتان(@)(@@)(@@)(@@) $ 4702 - عمرو بن مالك عن جارية بن هرم الفقيمي قال ت قال محمد هذا كذاب كان استعار كتاب أبي جعفر المسندي فألحق فيه أحاديث(@)(@@)(@@)(@@) $ 4703 - عمرو بن مالك الواسطي أبو عثمان قال ابن أبي حاتم لم يكن بصدوق(@)(@@)(@@)(@@) $ 4704 - عمرو بن مجمع السكوني عن هشام بن عروة ضعفوه(@)(@@)(@@)(@@) $ 4705 - عمرو بن محمد الاعسم عن سليمان بن أرقم قال الدارقطني وغيره منكر الحديث وذكر له ابن حبان موضوعات(@)(@@)(@@)(@@) $ 4706 - عمرو بن محمد عن سعيد بن جبير مجهول(@)(@@)(@@)(@@) $ 4707 - عمرو بن مخرم بصري يروي عن يزيد بن زريع ليس بثقة(@)(@@)(@@)(@@) $ 4708 - خ د / عمرو بن مرزوق الباهلي ثقة مشهور قال الدارقطني كثير الوهم وكان يحيى بن سعيد لا يرضاه وقال أبو حاتم ثقة عابد(@)(@@)(@@)(@@) $ 4709 - عمرو بن مسلم بن نذير عن علي لا يعرف من هو PageV02P489(@)(@@)(@@)(@@) $ 4710 - م د س / عمرو بن 
ms237	 مسلم الجندي صاحب طاووس قال أحمد فيه ضعف وقواه غيره وقال ابن معين ليس بالقوي(@)(@@)(@@)(@@) $ 4711 - د / عمرو بن منصور عن الشعبي ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 4712 - عمرو بن مهران الخصاف شيخ للقاسم بن زكريا الصيقل ضعفه الأزدي(@)(@@)(@@)(@@) $ 4713 - عمرو بن ميسرة هو عمرو بن أبي عمرون مر قال ابن معين ليس بقوي وكان مالك يستضعفه(@)(@@)(@@)(@@) $ 4714 - عمرو بن ميمون القناد عن عبد الرحمن بن مغراء قال أبو حاتم حديثه منكر(@)(@@)(@@)(@@) $ 4715 - عمرو بن نصر روى عنه الحكم بن سلمة مجهولان(@)(@@)(@@)(@@) $ 4716 - عمرو بن النضر كذلك(@)(@@)(@@)(@@) $ 4717 - ق / عمرو بن النعمان عن سليمان التيمي صدوق قال ابن عدي ليس بالقوي(@)(@@)(@@)(@@) $ 4718 - عمرو بن نعيم العامري المصري قال الدارقطني يترك(@)(@@)(@@)(@@) $ 4719 - د س عمرو بن هاشم أبو مالك الجنبي شيخ ابن PageV02P490 معين قال النسائي ليس بالقوي وقال أحمد وغيره صدوق سمع هشام بن عروة(@)(@@)(@@)(@@) $ 4720 - ق / عمرو بن هاشم البيروتي وثق وقال ابن وارة ليس بذاك كتب عن الأوزاعي صغيرا(@)(@@)(@@)(@@) $ 4721 - عمرو بن هرم عن ربعي بن حراش ضعفه يحيى القطان(@)(@@)(@@)(@@) $ 4722 - ت ق / عمرو بن واقد الدمشقي عن يونس بن ميسرة قال الدارقطني وغيره متروك(@)(@@)(@@)(@@) $ 4723 - عمرو بن واقد البصري عن محمد بن عمرو لا يعرف وحديثه منكر(@)(@@)(@@)(@@) $ 4724 - ق عمرو بن الوليد بن عبدة لم يرو عنه سوى يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 4725 - عمرو بن الوليد الأغضف شيخ للقواريري لين الحديث ذكره ابن عدي وقواه(@)(@@)(@@)(@@) $ 4726 - عمرو بن أبي الوليد عن عمر مجهول(@)(@@)(@@)(@@) $ 4727 - عمرو بن وهب شيخ روى عنه يحيى بن حسان قال أبو حاتم مضطرب الحديث(@)(@@)(@@)(@@) $ 4728 - عمرو بن يحيى بن عمارة شيخ مالك وثقوه وقال ابن معين ليس بقوي(@)(@@)(@@)(@@) $ 4729 - عمرو بن يحيى بن عمرو بن سلمة قال يحيى بن معين ليس حديثه بشيء قد رأيته(@)(@@)(@@)(@@) $ 4730 - ق / عمرو بن يزيد أبو بردة التميمي عن علقمة بن مرثد PageV02P491 ضعفه الدارقطني وعدة وعنه أحمد بن يونس(@)(@@)(@@)(@@) $ 4731 - عمرو بن يوسف عن سعيد بن المسيب(@)(@@)(@@)(@@) $ 4732 - وعمرو بن أبي 
ms238	 يوسف عن معاوية مجهولان(@)(@@)(@@)(@@) $ 4733 - عمرو عن علي هو عمرو ذو مر مر(@)(@@)(@@)(@@) $ 4734 - وعمرو القصبي عن إبراهيم النخعي مجهولان(@)(@@)(@@)(@@) $ 4735 - س / عمير بن إسحاق شيخ ابن عون وثق وقال ابن معين لا يسواي حديثه شيئا(@)(@@)(@@)(@@) $ 4736 - عمير بن سويد عن أنس قال ابن حبان لا يجوز أن يحتج به(@)(@@)(@@)(@@) $ 4737 - عمير بن سيف الخولاني لم يرو عنه سوى شرحبيل بن مسلم(@)(@@)(@@)(@@) $ 4738 - عمير بن عبد المجيد الحنفي شيخ لأبي خيثمة قال ابن معين ضعيف(@)(@@)(@@)(@@) $ 4739 - عمير بن عمران الحنفي عن ابن جريج قال ابن عدي حدث بالبواطيل(@)(@@)(@@)(@@) $ 4740 - عمير بن مأمون عن الحسن قال الدارقطني لا شي(@)(@@)(@@)(@@) $ 4741 - عمير بن المغلس عن حريز بن عثمان الحمصي لا يعرف(@)(@@)(@@)(@@) $ 4742 - عمير بن هانئ العنسي قال أبو داود كان قدريا PageV02P492 وقال ابن أبي الحواري إني لأبغضه(@)(@@)(@@)(@@) $ 4743 - عميرة بن سعد عن علي قال يحيى القطان لم يكن ممن يعتمد عليه(@)(@@)(@@)(@@) $ 4744 - عميرة بن كوهان عن علي مجهول(@)(@@)(@@)(@@) $ 4745 - عنبسة بن الأزهر الشيباني عن سماك بن حرب قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4746 - عنبسة بن جبير عن الربيع بن صبيح لا يعرف(@)(@@)(@@)(@@) $ 4747 - عنبسة بن أبي رائطة الغنوي عن الحسن ضعفه ابن المديني(@)(@@)(@@)(@@) $ 4748 - عنبسة بن سعيد الواسطي القطان عن شهر وعنه عبد الوهاب الثقفي ضعفوه(@)(@@)(@@)(@@) $ 4749 - ق / عنبسة بن سعيد مولى عثمان لم يرو عنه إلا ابنه روح(@)(@@)(@@)(@@) $ 4750 - عنبسة بن سعيد البصري عن حنظلة وغيره ضعفوه وله عن الزهري وهو القطان(@)(@@)(@@)(@@) $ 4751 - عنبسة بن سعيد الكلاعي عن أنس قال أبو حاتم ليس بالقوي وقال أبو زرعة لم يسمع من عكرمة(@)(@@)(@@)(@@) $ 4752 - عنبسة بن سعيد أخو أبي الربيع السمان عن عمرو بن ميمون وغيره ضعفه أبن معين الدارقطني والظاهر أنه هو البصري المذكور فأما PageV02P493(@)(@@)(@@)(@@) $ 4753 - س ت / عنبسة بن سعيد الكوفي قاضي الري فثقة وكذا(@)(@@)(@@)(@@) $ 4754 - د عنبسة بن سعيد الكوفي الحاسب شيخ ابن مهدي(@)(@@)(@@)(@@) $ 4755 - عنبسة بن أبي صغيرة عن الأوزاعي بخبر باطل(@)(@@)(@@)(@@) $ 4756 - عنبسة بن عبد الرحمن بن 
ms239	 عنبسة بن سعيد بن العاص الأموي عن الحسن وغيره قال البخاري تركوه وقال أبو حاتم كان يضع الحديث قلت فأما(@)(@@)(@@)(@@) $ 4757 - خ م / جده فتابعي ثقة يروي عن أبي هريرة وأنس(@)(@@)(@@)(@@) $ 4758 - عنبسة بن أبي عمرو تابعي مجهول(@)(@@)(@@)(@@) $ 4759 - عنبسة بن مهران البصري الحداد عن الزهري قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 4760 - عنبسة بن هبيرة عن عكرمة مجهول(@)(@@)(@@)(@@) $ 4761 - عنبسة عن زيد بن أسلم ضعف(@)(@@)(@@)(@@) $ 4762 - العوام بن أعين شيخ أبي سعيد الأشج مجهول(@)(@@)(@@)(@@) $ 4763 - العوام بن جويرية عن الحسن قال ابن حبان كان يروي الموضوعات(@)(@@)(@@)(@@) $ 4764 - العوام بن حمزة المازني قال أحمد له أحاديث مناكير قلت روى القطان عنه(@)(@@)(@@)(@@) $ 4765 - العوام بن سليمان المزني مجهول(@)(@@)(@@)(@@) $ 4766 - ق / العوام بن عباد بن العوام حكى عنه محمد ابن يحيى الذهلي لا يعرف(@)(@@)(@@)(@@) $ 4767 - العوام بن عبد الغفار تركه الأزدي PageV02P494(@)(@@)(@@)(@@) $ 4768 - العوام بن أبي العوام شيخ لأبي سلمة مجهول(@)(@@)(@@)(@@) $ 4769 - العوام بن المقطع كذلك(@)(@@)(@@)(@@) $ 4770 - عوبذ بن أبي عمران الجوني عن أبيه قال النسائي وغيره متروك(@)(@@)(@@)(@@) $ 4771 - عوسجة بن رماح شيخ لعاصم بن شيبة قال الدارقطني مجهول لا يصح حديثه(@)(@@)(@@)(@@) $ 4772 - عه / عوسجة عن ابن عباس لا يعرف له في الفرائض قال البخاري لا يصح(@)(@@)(@@)(@@) $ 4773 - ع / عوف الأعرابي ثقة مشهور قال بندار قدري رافضي يعني يتشيع(@)(@@)(@@)(@@) $ 4774 - ق / عون بن أبي شداد البصري ضعفه أبو داود في قول سمع أنسا(@)(@@)(@@)(@@) $ 4775 - عون بن ذكوان أبو جناب القصاب وهو بكنيته أشهر وثق وقال ابن طاهر قال الدارقطني متروك(@)(@@)(@@)(@@) $ 4776 - عون بن سلام له في صدوق وقد لين(@)(@@)(@@)(@@) $ 4777 - ق / عون بن عمارة القيسي عن حميد ضعفه أبو حاتم وغيره(@)(@@)(@@)(@@) $ 4778 - عون بن عمرو أخو رياح عن الجريري قال ابن معين لا شيء(@)(@@)(@@)(@@) $ 4779 - عون أبو محمد البصري تابعي روى عن أبي موسى مجهول(@)(@@)(@@)(@@) $ 4780 - عياش بن عبد الله الهمداني عن عمرو بن سلمة ما روى عنه إلا إبنه عبد الله PageV02P495(@)(@@)(@@)(@@) $ 4781 - م د س ق / عياض بن عبد الله الفهري عن ابن 
ms240	 المنكدر وثق وقال أبو حاتم ليس بقوي مصري(@)(@@)(@@)(@@) $ 4782 - س / عياض بن عروة عن عائشة فيه جهالة(@)(@@)(@@)(@@) $ 4783 - عياض بن يزيد تابعي مجهول(@)(@@)(@@)(@@) $ 4784 - عيسى بن إبراهيم العبدي عن أبي إسحاق قال ابن عدي ليس بمعروف(@)(@@)(@@)(@@) $ 4785 - عيسى بن إبراهيم الهاشمي عن جعفر بن برقان وغيره تركه أبو حاتم(@)(@@)(@@)(@@) $ 4786 - عيسى بن أزهر روى عنه أبو علي بن هارون حديثا منكرا ولا أعرفه(@)(@@)(@@)(@@) $ 4787 - عيسى بن الأشعث عن الضحاك مجهول(@)(@@)(@@)(@@) $ 4788 - ق / عيسى بن جارية الأنصاري عن جابر مختلف فيه قال النسائي متروك وقال أبو زرعة لا بأس به PageV02P496(@)(@@)(@@)(@@) $ 4789 - عيسى بن حطان روى عنه عبد الملك بن مسلم قال ابن عبد البر ليسا ممن يحتج بهما(@)(@@)(@@)(@@) $ 4790 - عيسى بن خشنام عن أحمد بن سلمة المدائني بحديث منكر قاله الخطيب(@)(@@)(@@)(@@) $ 4791 - عيسى بن داب هو ابن يزيد(@)(@@)(@@)(@@) $ 4792 - عيسى بن راشد مجهول وخبره منكر قاله خ(@)(@@)(@@)(@@) $ 4793 - عيسى بن أبي رزين الثمالي شيخ لابن المبارك قال أبو زرعة مجهول(@)(@@)(@@)(@@) $ 4794 - عيسى بن رستم أبو العلاء عن عمر بن عبد العزيز لا يصح قاله البخاري(@)(@@)(@@)(@@) $ 4795 - عيسى بن زيد الهاشمي العقيلي عن الحسن بن عرفة وعنه الحاكم أبو عبد الله كذاب(@)(@@)(@@)(@@) $ 4796 - عيسى بن سعيد الدمشقي جاء في إسناد مظلم عن علي ابن يزيد ولا يعرف(@)(@@)(@@)(@@) $ 4797 - عيسى بن سليمان أبو طيبة الدارمي الجرجاني ضعفه يحيى سمع جعفر بن محمد(@)(@@)(@@)(@@) $ 4798 - عيسى بن سليم عن أبي وائل لا يعرف فأما(@)(@@)(@@)(@@) $ 4799 - م س / عيسى بن سليم الرستني فثقة PageV02P497(@)(@@)(@@)(@@) $ 4800 - ت ق / عيسى بن سنان أبو سنان القسملي الفلسطيني حدث بالبصرة عن يعلى بن شداد بن أوس ضعيف الحديث وقواه بعضهم(@)(@@)(@@)(@@) $ 4801 - عيسى بن سوادة النخعي عن الزهري قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 4802 - عيسى بن سواء عن إسماعيل بن أبي خالد بخبر باطل وعنه محمد بن حميد قال خ منكر الحديث(@)(@@)(@@)(@@) $ 4803 - عيسى بن شعيب البصري عن مطر الوراق قال ابن حبان فحش خطؤه فاستحق الترك(@)(@@)(@@)(@@) $ 4804 - خ س / عيسى بن 