ms41	 1(@)(@@) % يا جنة الوصل التي % % حفت بها نار الصدود % 2(@)(@@) % من لي برياك التي % % فتقت بريحان الخلود % % 3(@)(@@) % ومجاجة شهدية % تجنى من البرد البرود % % 4(@)(@@) % وارحمتا ، وأنا العبي % % د ، من الهوى لشج عميد % % 5(@)(@@) % يرمي ولكن لا يفي % % برماية الغرض البعيد % % 6(@)(@@) % من المقيم على الصعي % % د إلى الغزالة بالصعود % % PageV01P151 البحر : متقارب تام 1(@)(@@) % هفا القلب عن وصل هيف القدود % وماء الصبا مورق منه عودي % % 2(@)(@@) % فطمت ولي ولع بالعلى % % أجاري الصبا في مداها المديد % % 3(@)(@@) % وما زلت وطأ فويق السماك % % إلى قطبها ناظرا في صعود % % 4(@)(@@) % وما يورد الشيخ إلا الذي % % تلوح شمائله في الوليد % % 5(@)(@@) % حفظت الدمى لهوى دمية % ويحفظ للبيت كل القصيد % % 6(@)(@@) % ولكن رأيت العلى ضرة % تنافر كل فتاة خرود % % 7(@)(@@) % فثرت وثارت معي همة % قيامي لها فارغ من قعود % % 8(@)(@@) % وما نومت عزمتي بلدة % تنبه في الغمر عجز البليد % % 9(@)(@@) % ولا طفلة العيش وهنانة % أروج بنفحة مسك وعود % 10(@)(@@) % تودع للبين كفا بكف % ونحرا بنحر وجيدا بجيد % % PageV01P152 11(@)(@@) % ومن يطلب المجد ينزل إلى % % قرا النهد عن نهد عذراء رود % % 12(@)(@@) % ويرم على الخوف عزما بعزم % وليلا بليل وبيدا بيد % % 13(@)(@@) % ولله أرضي التي لم تزل % % كناس الظباء وغيل الأسود % % 14(@)(@@) % فمن شادن بابلي الجفون % % نفور الوصال أنيس الصدود % % 15(@)(@@) % يدير الهوى منه طرف كليل % يفل ذلاقة طرفي الحديد % % 16(@)(@@) % ومن قسور شائك البرثنين % له لبدة سردت من حديد % % 17(@)(@@) % يصول بمثل لسان الشواظ % فيولغه في نجيع الوريد % % 18(@)(@@) % زبانية خلقوا للحروب % % يشبون نيرانها بالوقود % % 19(@)(@@) % مشاعرهم مرهفات بنين % % لهد الجماحم من عهد هود % % 20(@)(@@) % هم المخرجون خبايا الجسوم % % إذا ضربوا بخبايا الغمود % % PageV01P153 21(@)(@@) % هم المائلون على الحاقدين % % صدور رماحهم بالحقود % % 22(@)(@@) % نجوم مطالعها في القنا % % ولكن مغاربها في الكبود % % 23(@)(@@) % تخط الحوافر من جردهم % محاريب مبثوثة في الصعيد % % 24(@)(@@) % تخر رؤوس العدى في الوغى % % لها سجدا ، يا له من سجود % % 25(@)(@@) % وبرق تألق إيماضه % % كخفق جناح فؤاد عميد % % 26(@)(@@) % يريك التواء قسي الرماة % % إذا ما 
ms42	 جذين بنزع شديد % % 27(@)(@@) % سقى الله منه الحمى عارضا % يقهقه ضاحكه بالرعود % % 28(@)(@@) % مكر الطراد ، وثغر الجهاد ، % ومجرى الجياد ، ومأوى الطريد % % 29(@)(@@) % بحيث تقابل شوسا بشوس % % وغرا بغر وصيدا بصيد % 30(@)(@@) % وأجسام أحيائهم في النعيم % وأرواح أمواتهم في الخلود % % PageV01P154 البحر : مجزوء الكامل 1(@)(@@) % حسن غذاءك واعتمد % منه على وقت وحد % 2(@)(@@) % فالنفس تهزل بالمأ % % كلما سمن الجسد % PageV01P155 البحر : رمل تام 1(@)(@@) % نثر الجو على الأرض برد % أي در لنحور لو جمد % % 2(@)(@@) % لؤلؤ أصدافه السحب التي % % أنجز البارق منها ما وعد % 3(@)(@@) % منحته عاريا من نكد % واكتساب الدر بالغوص نكد % % 4(@)(@@) % ولقد كادت تعاطى لقطه % رغبة فيه كريمات الخرد % 5(@)(@@) % وتحلي منه أجيادا إذا % % عطلت راقتك في حلي الغيد % 6(@)(@@) % ذوبته من سماء أدمع % فوق أرض تتلقاه بخد % % 7(@)(@@) % فجرت منه سيول حولنا % % كثعابين عجال تطرد % % 8(@)(@@) % وترى كل غدير متأق % سبحت فيه قوارير الزبد % % 9(@)(@@) % من يعاليل كبيض وضعت % في اشتباك الماء من فوق زرد % % 10(@)(@@) % أرق الأجفان رعد صوته % كهدير القرم في الشول حفد % % PageV01P156 11(@)(@@) % بات يجتاب بأبكار الحيا % % بلدا يرويه من بعد بلد % 12(@)(@@) % فهو كالحادي روايا إن ونت % في السرى صاح عليها وجلد % % 13(@)(@@) % وكأن البرق فيها حاذف % بضرام كلما شب خمد % % 14(@)(@@) % تارة يخفو ويخفى تارة % كحسام كلما سل غمد % 15(@)(@@) % يذعر الأبصار محمرا كما % % قلب الحملاق في الليل الأسد % % 16(@)(@@) % وعليل النبت ظمآن الثرى % % عرج الرائد عنه فزهد % % 17(@)(@@) % خلع الخصب عليه حللا % لبديع الرقم فيهن جدد % % 18(@)(@@) % وسقاه الري من وكافة % فتح البرق بها الليل وسد % 19(@)(@@) % ذات قطر داخل جوف الثرى % % كحياة الروح في موت الجسد % % 20(@)(@@) % فتثنى الغصن سكرا بالندى % % وتغنى ساجع الطير غرد % % PageV01P157 21(@)(@@) % وكأن الصبح كف حللت % من ظلام الليل بالنور عقد % % 22(@)(@@) % وكأن الشمس تجري ذهبا % % طائرا في صيده من كل يد % % PageV01P158 البحر : كامل تام 1(@)(@@) % خطب يهز شواهق الأطواد % صدع الزمان به حصاة فؤادي % % 2(@)(@@) % ومصيبة حر المصائب عندها % % برد بحرقتها على الأكباد % % 3(@)(@@) % وكأنما الأحشاء من 
ms43	 حسراتها % % يجذبن بين براثن الآساد % % 4(@)(@@) % كبر الداوهي رحلت بحلولها % % قرما . لقد قرعت قريع أعادي % % 5(@)(@@) % سكنت شقاشقه وكان هديره % % يستك منه مسامع الحساد % 6(@)(@@) % وكأنما في الترب غيض غيضها % % لحداه وردا عن ورود صواد % % 7(@)(@@) % نحرت شؤوني بالبكاء عليه أم % عصرت مدامعها من الفرصاد % % 8(@)(@@) % لم أنتفع بالنفس عند عزائها % % فكأنها عين بغير سواد % % 9(@)(@@) % هذا الزمان على خلائقه التي % % طوت الخلائق من ثمود وعاد % % 10(@)(@@) % لم يبق منهم من يشب لقره % بيديه سقطا من قداح زناد % % PageV01P159 11(@)(@@) % يفنى ويفني دهرنا وصروفه % % من طارق أو رائح أو غاد % % 12(@)(@@) % فكأن عينك منه واقعة على % % بطل مبيد في الحروب مباد % % 13(@)(@@) % والناس كالأحلام عند نواظر % % ترنو إليهم ، هي دار سهاد % % 14(@)(@@) % سهر كرى مقل تخاف من الردى % % للخوف هجر الطير ماء ثماد % % 15(@)(@@) % والعمر يحفز بين يوم سابق % لا يستقر ، وبين يوم حاد % % 16(@)(@@) % دنيا إلى أخرى تنقل أهلها % % هل تترك الأرواح في الأجساد % % 17(@)(@@) % وكأنهن صوارم ، ما فعلها % % إلا من الأجسام في أغماد % % 18(@)(@@) % حتى إذا فجعت بها أشباحها % % بقيت لفقد حياتها كجماد % % 19(@)(@@) % والموت يدرك والفرار معقل % من فر عنه على سراة جواد % % 20(@)(@@) % وينال ما صدع الهواء بخافق % موت ، ومن قطع الفلا بسهاد % % PageV01P160 21(@)(@@) % ويسوم ضيما كل أعصم شاهق % ريب المنون ، وكل حية واد % % 22(@)(@@) % وهزبر غاب يحتمي بمخالب % يرهفن من غير الحديد ، حداد % % 23(@)(@@) % يسري إلى وجه الصباح ، وإنما % % مصباحه من طرفه الوقاد % % 24(@)(@@) % أو لا ولم يبل الحمام بشبله % % وعناده بالدل غير عناد % % 25(@)(@@) % وأخو الهداية راحل جعل التقى % % زادا له فتقاه أفضل زاد % % 26(@)(@@) % أنا يا ابن أختى لا أزال أخا أسى % حتى أوسد في الضريح وسادي % % 27(@)(@@) % إني امرؤ مما طرقت مهيد % بفراق أهلي وانتزاح بلادي % % 28(@)(@@) % أودى الغريب بعلة تعتاده % % بالكرب ، وهي غريبة العواد % % 29(@)(@@) % أمل وعدت به ، وأوعدني الردى % % فبه يجذ الوعد بالإيعاد % % 30(@)(@@) % حي وميت بالخطوب تباعدا % % شتان بين بعاده وبعادي % % PageV01P161 31(@)(@@) % نعي دهيت به فمت وإن أعش % خلف المنون 
ms44	 فلم أعش بمرادي % % 32(@)(@@) % ما ثلم السيف الذي جسد الثرى % % أمسى له جفنا بغير نجاد % % 33(@)(@@) % عضب يكون عتاد فارسه إذا % % ما سله . والعضب غير عتاد % % 34(@)(@@) % قد كان في يمنى أبيه مصمما % يعتده يوم الوغى لجلاد % % 35(@)(@@) % أعزز علي برونق يبكي دما % بتواتر الأزمان والآباد % % 36(@)(@@) % وأقول بدر دب فيه محاقه % إن الكمال إليه غير معاد % % 37(@)(@@) % إن غاب في جدث أنار بنوره % % فبفقد ذاك النور أظلم نادي % % 38(@)(@@) % واستعذبته المعضلات لأنها % % مستهدفات مقاتل الأمجاد % % 39(@)(@@) % لو أخرته منية لتقدمت % % في الجود همته على الأجواد % % 40(@)(@@) % ولكان في درس العلوم وحفظها % % بين الأفاضل مبدأ الأعداد % % PageV01P162 41(@)(@@) % إن المفاخر والمحامد ، سرها % % لذوي البصائر في المخايل باد % % 42(@)(@@) % زين الحضور ذوي الفضائل غائب % يا طول غيبة معرض متماد % % 43(@)(@@) % هلا حمته عناصر المجد التي % % طابت من الآباء والأجداد % % 44(@)(@@) % ومكارم بذلت لصون نفوسهم % % معدودة بالفضل في الأعداد % % 45(@)(@@) % % منقولة منهم إلى الأولاد % % 46(@)(@@) % من معرق الطرفين ، مركز فخره % % بيت ، سماء علاه ذات عماد % % 47(@)(@@) % المنفقون بأرضهم أعمارهم % % ما بين غزو في العدى وجهاد % % 48(@)(@@) % أذمار حرب في سماء قتامهم % شهب طوالع في القنا المياد % % 49(@)(@@) % وبوارق تنسل من أجفانها % % ورق لزرع الهام ذات حصاد % % 50(@)(@@) % فزع الصريخ إليهم مستنجدا % فبهم ومنهم شوكة الأنجاد % % PageV01P163 51(@)(@@) % أسد لبوسهم جلود أراقم % بهتت لرؤيتها عيون جراد % % 52(@)(@@) % يا عابد الرحمن حسبك رحمة % وفى لها بالعهد صوب عهاد % % 53(@)(@@) % بحلاوة اسمك للمنون مرارة % % طرحت بعذب الورد للوراد % % 54(@)(@@) % إني أنادي منك غير مجاوب % ميتا ، وعن شوق إليك أنادي % % 55(@)(@@) % في جوف قبر مفرد من زائر : % قبر الغريب يخص بالإفراد % % 56(@)(@@) % ما بين موتى في صباح عرسوا % % لإعادة بالبعث يوم معاد % % 57(@)(@@) % بين الألوف عفية أرسامهم % % ولرسمه قبر من الآحاد % % 58(@)(@@) % أولم يكن بقراط دون أبيك في % % داء يعد له المريض عداد % % 59(@)(@@) % وأدق منه فكرة حسبية % حكمية الإصدار والايراد % % 60(@)(@@) % هلا شفى سقما فوقف برؤه % موتا تمشى منك في الأبراد % % PageV01P164 61(@)(@@) % هيهات كان ممات نفسك مثبتا 
ms45	 % بيد القضاء عليك في الميلاد % % 62(@)(@@) % قصرتك كالممدود قصر ضرورة % وعدتك عن مد الحياة عواد % % 63(@)(@@) % وشربت كأسا نحن في إيراقها % % إذ أنت منها في طويل رقاد % % 64(@)(@@) % وتركت عرسك ، وهي منك جنازة % ولباس عرسك ، وهو ثوب حداد % % 65(@)(@@) % أهدي إليك مكانها حورية % مهد ، وذاك الفضل فضل الهادي % % 66(@)(@@) % عندي عليك من البكاء بحسرة % ماء لنار الحزن ذو إيقاد % % 67(@)(@@) % ونياح ذي كمد يذوب به إذا % % رفع الرثاء عقيرة الإنشاد % % 68(@)(@@) % وتخيل يحييك في فكري ، فذا % % مسعاك في بري ومحض ودادي % % 69(@)(@@) % قد كان عيدك ، والحياة على شفا % % من قطع عمرك ، آخر الأعياد % % 70(@)(@@) % أرثيك عن طبع تجدول بحره % بعد الغياب وكثرة الأولاد % % PageV01P165 71(@)(@@) % أنا في الثمانين التي فشلت بها % % قيدي الزمانة ، عند ذل قيادي % % 72(@)(@@) % أمشي دبيبا كالكسير وأتقي % % وثبا على من الحمام العادي % % 73(@)(@@) % ذبلت من الآداب روضي التي % % جليت نضارتها على الرواد % % 74(@)(@@) % لو كنت بعدي لافتديت بأنفس % وبما حوت من طارف وتلاد % % 75(@)(@@) % فاصبر أبا الحسن احتساب مسلم % لله أمر خواتم ومبادي % % 76(@)(@@) % فلقد عهدتك ، والحوادث جمة % وشدادهن عليك غير شداد % % 77(@)(@@) % أوليس إبراهيم ، نجل محمد ، % بالدفن صار إلى بلى ونفاد % % 78(@)(@@) % رد النبي عليه تربة لحده % % بيد النبوة ، وهي ذات أيادي % % 79(@)(@@) % فتأس في ابنك بابنه ، وخلاله ، % تسلك باأسوته سبيل رشاد % % PageV01P166 البحر : خفيف تام 1(@)(@@) % نحن في جنة نباكر منها % % ساحلي جدول كسيف مجرد % 2(@)(@@) % صقلت متنه مداوس شمس % من خلال الغصون صقلا مجدد % % 3(@)(@@) % ومدام تطير في الصحن سكرا % % فتحل العقود منها وتعقد % % 4(@)(@@) % جسمها بالبقاء في الدن يبلى % % وقواها مع الليالي تجدد % 5(@)(@@) % وإذا الماء غاص في النار منها % % أخرج الدر من حباب منضد % % 6(@)(@@) % يا لها من عصير أول كرم % سكر الدن منه قدما وعربد % % 7(@)(@@) % جنة مجت الحيا إذا سقاها % % مصلح من غمامه غير مفسد % % 8(@)(@@) % قد لبسنا غلائل الظل فيها % % معلمات من الشعاع بعسجد % % 9(@)(@@) % ورأينا نارنجها في غصون % % هزت الريح خضرها فهي ميد % 10(@)(@@) % ككرات محمرة من عقيق % % تدريها 
ms46	 صوالج من زبرجد % % PageV01P167 11(@)(@@) % وكأن الأنوار فيها ذبال % بسليط من الندى تتوقد % % 12(@)(@@) % وكأن النسيم بالفرج يفشي % % بين روضاتها سرائر خرد % % 13(@)(@@) % حيث نسقى من السرور كؤوسا % ونغنى من الطيور وننشد % 14(@)(@@) % ذو صفير مرجع أو هديل % % أسمعتم عن الغصن ومعبد % % 15(@)(@@) % شاديات تمسي الغصون وتضحي % % ركعا للصبا بهن وسجد % % 16(@)(@@) % كان ذا والزمان سمح السجايا % % ببواد من الأماني وعود % % 17(@)(@@) % والصبا في معاطفي ، وكأني % % غصن في يد الصبا يتأود % % PageV01P168 البحر : كامل تام 1(@)(@@) % ومضمن راحا يشف زجاجه % % عن ماء ياقوت بدر يزبد % 2(@)(@@) % جام يجمع شربه لذاتنا % % وعقولنا بالسكر منه تبدد % 3(@)(@@) % ويخف ملآنا ويثقل فارغا % كالجسم تعدم روحه أو توجد % PageV01P169 البحر : كامل تام 1(@)(@@) % هل أنت فادية فؤاد عميد % % من لوعة في الصدر ذات وقود % 2(@)(@@) % أم أنت في الفتكات لا تخشين في % % قتل العباد عقوبة المعبود % % 3(@)(@@) % إن كان لا تنبو سيوفك عن حشا % % صب فليس حدادها بحديد % % 4(@)(@@) % قل كيف تعطف بالوصال لعاشق % % من لا تجود له بعطفة جيد % % 5(@)(@@) % لو بت مغتبقا مدامة ريقها % % لخشيت صارم جفنها العربيد % % 6(@)(@@) % إن شئت أن تطوي على ظمأ فرد % ماء المحاسن فوق وجنة رود % % 7(@)(@@) % غيداء يسقم بالملاحة دلها % % جسم العميد ، كذاك دل الغيد % % 8(@)(@@) % كتبت لها وصلا إشارة ناظري % % فمحاه ناظر طرفها بصدود % % 9(@)(@@) % ولقد يهيج لي البكاء صبابة % شاد مطوق آلة التغريد % % 10(@)(@@) % باتت سواري الطل تضرب ريشه % بجواهر لم تدر سلك فريد % % PageV01P170 11(@)(@@) % غنى على عود يميس به كما % % غنى التقابل معبد في العود % % 12(@)(@@) % والليل قوض رافعا من شبهه % % بيض القباب على نجائب سود % % 13(@)(@@) % والصبح يلقط من جمان نجومه % ما كان في الآفاق ذا تبديد % % 14(@)(@@) % زهر خبت أنوارها فكأنها % % سرج المشاكي عولجت بخمود % % 15(@)(@@) % كأزاهر النوار تقطفها مها % من كل مخضر البقاع مجود % % 16(@)(@@) % كأسنة طعنت بها فرسانها % % ثم امتسكن عن القنا بكبود % % 17(@)(@@) % كعيون عشاق أباح لها الكرى % % من كان عذبهن بالتسهيد % % 18(@)(@@) % والصبح يبرق كرة في كرة % مثل استلال الصارم 
ms47	 المغمود % % 19(@)(@@) % وتفرقت تلك الغياهب عن سنا % % فلق يفلق هامها بعمود % % 20(@)(@@) % إني خبرت الدهر خبر مجرب % وكلمت غاربه بحمل قتود % % PageV01P171 21(@)(@@) % فالحظ فيه طوع كفي مظلم % بالجهل ، من نور العلوم بليد % % 22(@)(@@) % والحمد في الأقوام غير مسلم % إلا لأحمد ذي العلى والجود % % 23(@)(@@) % من لا يجود على العفاة بطارف % حتى يجود عليهم بتليد % % 24(@)(@@) % خرق العوائد منه خرق ، سيبه % ثر الغمائم مورق الجلمود % % 25(@)(@@) % يأوي إلى شرف تقادم بيته % % أزمان عاد في العلى وثمود % % 26(@)(@@) % متردد في ساميات مراتب % والبدر في الأبراج ذو تغريد % % 27(@)(@@) % كالشمس يبعد في السماء محلها % % وشعاعها في الأرض غير بعيد % % 28(@)(@@) % يلقى وجوه المعتفين بغرة % بسامة ويد تسح بجود % % 29(@)(@@) % ما زال يشرد عرضه عن ذمة % وعطاؤه بالمطل غير شريد % % 30(@)(@@) % في ربعه روض مرود خصبه % أبدا مصاقب منهل مورود % % PageV01P172 31(@)(@@) % وكأنما لليل فيه مدارج % عند التقاء وفوده بوفود % % 32(@)(@@) % سبق الكرام وأقبلوا في إثره % % كسنان مطرد الكعوب مديد % % 33(@)(@@) % متصرف الكفين في شغل العلى % % لم يخل من بذل ومن تشييد % % 34(@)(@@) % والمجد لا تعلي يداك بناءه % إلا بمال بالندى مهدود % % 35(@)(@@) % يا ابن السيادة والرياسة والعلى % % وعظيم آباء ، عظيم جدود % 36(@)(@@) % خذها كمنتظم الجمان غرائبا % تروي قصيدتها بكل قصيد % % 37(@)(@@) % نيطت عليك عقودهما ولطالما % % نظمت لأجياد الملوك عقودي % % PageV01P173 البحر : طويل 1(@)(@@) % ولما تلاقينا وأثبت عندها % % نحولي وتبريحي من الحب ما عندي % % 2(@)(@@) % خلعنا على الأجياد أطواق أذرع % كأن لنا روحين في جسد فرد % % 3(@)(@@) % كأن عناق الوصل لاحم بيننا % % بريح ونار من زفيري ومن وجدي % % 4(@)(@@) % ولما أتاني الصبح ذبت ولم تذب % فيا لك من شوق خصصت به وحدي % % PageV01P174 البحر : طويل 1(@)(@@) % وراقصة بالسحر في حركاتها % % تقيم به وزن الغناء على حد % 2(@)(@@) % منغمة ألفاظها بترنم % كسا معبدا من عزه ذلة العبد % % 3(@)(@@) % تدوس قلوب السامعين برخصة % بها لقطت ما للحون من العد % 4(@)(@@) % بقد يموت الغصن من حركاته % % سكونا ، وأين الغصن من بره القد % % 5(@)(@@) % وتحسبها عما تشير بأنمل % إلى ما يلاقي 
ms48	 كل عضو من الوجد % 6(@)(@@) % بنا لا بها ما تشتكي من جوى الهوى % % وأدمع أشواق مخددة الخد % PageV01P175 البحر : بسيط تام 1(@)(@@) % ومودع في المطايا لسعة حمة % % فيزعج الروح تعذيبا من الجسد % 2(@)(@@) % يغشي السوام مناقيرا فتحسبها % % مباضعا مدميات كل مفتصد % % 3(@)(@@) % يحك من دمها القاني يدا بيد % حك الظريف بحناء بنان يد % % PageV01P176 البحر : طويل 1(@)(@@) % تنهد لما عن سرب النواهد % على بعد عهد بالصبا والمعاهد % % 2(@)(@@) % وعطف قلوب من دماها بمنطق % كفيل بتأنيس الظباء الشوارد % % 3(@)(@@) % ذكرت الصبا والحانيات على الصبا % % وهن لأجساد الصبا كالمجاسد % % 4(@)(@@) % فبرح بي شوق إليها معاود % وناهيك من تبريح شوق معاود % % 5(@)(@@) % على حين لم أركب عتاق صبابتي % % ولا ذعرت في سربهن طرائدي % % 6(@)(@@) % متى تصدر الأحلام من غير فتنة % % ومن غرض الأحداق بيض الخرائد % % 7(@)(@@) % لقد رادني روضا من الحسن ناظري % % فلي محل جسم جره خصب رائدي % % 8(@)(@@) % وأصبحت من مسك الذوائب ذائبا % أما يقتل الآساد سم الأساود % % 9(@)(@@) % وإني لذو قلب أبي حملته % % ليحمل عني مثقلات الشدائد % % 10(@)(@@) % فلا غرو إن لانت لظبي عريكتي % % أنا صائد الضرغام والظبي صائدي % % PageV01P177 11(@)(@@) % أيا هذه استبقي على الجسم ، إنني % % كثير سقامي حيث قلت عوائدي % % 12(@)(@@) % مساء ببين فرقتنا صروفه % % عباديد إلا في علو المقاصد % % 13(@)(@@) % ظلمنا المطايا ظلم أيامنا لنا % % لكل على الساري به صدر حاقد % % 14(@)(@@) % تكلفنا الهمات نيل مرادها % % ومن للمطايا باتصال الفراقد % % 15(@)(@@) % مقاودها تفني قواها كأنها % % مكاحل يفنى كحلها بالمراود % % 16(@)(@@) % وليلة أعطينا الحشاشات فضلة % % من النوم صرعى بين غبر الفدافد % % 17(@)(@@) % وقد وردت ماء الصباح بأعين % نوائم في رأي العيون ، سواهد % % 18(@)(@@) % فقلت لأصحابي ارفعوا من صدورها % % فقد رفع الإصباح راية عاقد % % 19(@)(@@) % إذا نظمت شمل المنى بمحمد % نثرنا على علياه در المحامد % % 20(@)(@@) % وأضحت لديه معتقات ومتعت % % بخضر المراعي بين زرق الموارد % % PageV01P178 21(@)(@@) % همام يهز الملك عطفيه كلما % % علا الناس منه كعب أروع ماجد % % 22(@)(@@) % وأكبر يأوي من ذؤابة يعرب % إلى ذروة البيت الرفيع القواعد % % 23(@)(@@) % تلاقى الملوك الغر حول 
ms49	 سريره % % فمن راكع مضغي الجفون وساجد % 24(@)(@@) % يكفون أبصارا عن سميدع % % تديم إليه الشمس نظرة حاسد % % 25(@)(@@) % إذا اقتاد جيشا ساطع النقع أنذرت % طلائعه جيش العدو المكابد % % 26(@)(@@) % ومن يك بالنصر العزيز مؤيدا % % من الله لا ينصب حبال المكايد % % PageV01P179 البحر : طويل 1(@)(@@) % ومنغمس في صبغة الليل يمتطي % % إلى آجل الآساد قيد الأوابد % % 2(@)(@@) % يختم يمناه قبيعة صارم % % لما قد طغى من سنبل الهام حاصد % % 3(@)(@@) % يكر فكم جسم على الأرض ساقط % صريع وكم روح إلى الجو صاعد % % 4(@)(@@) % وأسد تصير الأسد كالبهم عندها % % إذا ما الظبي خطت ربوع القلائد % % 5(@)(@@) % أطلت ، وقد حان الجلاد ، سكونها % % بقولك للأبطال : هل من مجالد ؟ % 6(@)(@@) % وردت فكم حظ من الفضل باهر % لديك وكم خفض من العيش بارد % % 7(@)(@@) % ثناؤك في الآفاق أركبني المنى % % وغربني عن موطني المتباعد % % 8(@)(@@) % وقد قست أعوامي التي سلفت فما % % وفين بيوم من لقائك واحد % % PageV01P180 البحر : رمل تام 1(@)(@@) % أنكرت سقم مذاب الجسد % وهو من جنس عيون الخرد % % 2(@)(@@) % وبكت فالدمع في وجنتها % % كجمان الطل في الورد الندي % % 3(@)(@@) % ما الذي يبكي بحزن ظبية % فتكت مقلتها بالأسد % % 4(@)(@@) % والظباء الحور ، إما قتلت % لحظات العين منها ، لا تدي % % 5(@)(@@) % غادة إن نيط منها موعد % بغد فر إلى بعد غد % % 6(@)(@@) % هكذا عندي يجري مطلها % % بخلاف عندها مطرد % % 7(@)(@@) % وهي من عجب ومن تيه لها % % كبد ترحم منها كبدي % % 8(@)(@@) % ذات عين بالهوى نابعة % ضل في الحب بها من يهتدي % % 9(@)(@@) % وهي نجلاء حكاها سعة % ربيت في حجره كالولد % % 10(@)(@@) % لا يذوق الميل فيها إثمدا % ما لأحداق المها والإثمد % % PageV01P181 11(@)(@@) % قذفت حبة قلبي في يالهوى % % هل رأيت الجمر في المفتأد % % 12(@)(@@) % سحرها وحي بنجوى ناظر % ذو نفاث للنهى في عقد % % 13(@)(@@) % ما لآس في محب عمل % غير داء الروح داء الجسد % % 14(@)(@@) % خفي البرء على ألطافه % % وهو في بعض ثنايا العود % % 15(@)(@@) % إن في ظلم ظلوم لجنى % % شهد ، واها لذاك الشهد % % 16(@)(@@) % ذاب لي بالراح منها برد % هل يكون الراح ذوب البرد 
ms50	 % % 17(@)(@@) % هاتها صفراء ما اخترت لها % % أفق الشمس على أفق يدي % % 18(@)(@@) % خارج في راحتي مقتنص % كل هم كامن في خلدي % % 19(@)(@@) % جرد المزج عليها صارما % فاتقه بدموع الزبد % % 20(@)(@@) % عتقت ما عتقت في خزف % برداء القار فيه ترتدي % % PageV01P182 21(@)(@@) % حيث أبلى جسمها لا روحها % % مر أيام الزمان الجدد % % 22(@)(@@) % ما أطاق الدهر أن يسلبها % % أرج المسك ولون العسجد % % 23(@)(@@) % فاقض أوطار اللذاذات على % % نقر أوتار الغزال الغرد % % 24(@)(@@) % فلحون العود والكاس لنا % % والندى والبأس للمعتمد % % 25(@)(@@) % ملك إن بدأ الحمد به % % ختم الفخر به ما يبتدي % % 26(@)(@@) % معرق في الملك موصولا به % % شرف المجد ومحض السؤدد % % 27(@)(@@) % من غدا في كل فضل أوحدا % ذلك الأوحد كل العدد % % 28(@)(@@) % من حمى الإسلام من طاغية % كان منه في المقيم المقعد % % 29(@)(@@) % وكست أسيافه عارية % ذل أهل السبت أهل الأحد % % 30(@)(@@) % ذو يد حمراء من قتلهم % % وهي عند الله بيضاء اليد % % PageV01P183 31(@)(@@) % تقتدي الأملاك في العدل به % % وهو فيه بأبيه يقتدي % % 32(@)(@@) % كيف لا يملي على الناس العلى % % مستمد من على المعتضد % % 33(@)(@@) % عارض ينهل بالوبل إذا % % كان للعارض كف الجلمد % % 34(@)(@@) % وهصور يفرس القرن إذا % % جرد المرهف فوق الأجرد % % 35(@)(@@) % قومت عزمته عن نية % من منار الدين ميل العمد % % 36(@)(@@) % لا تلمه في عطاياه التي % % إن ترم منهن نقصا تزدد % % 37(@)(@@) % فنداه البحر ، والبحر متى % % تعصف الريح عليه يزبد % % 38(@)(@@) % ومحال نقلك الطبع الذي % % كان منه في كريم المولد % % 39(@)(@@) % كم لهام جر في أوله % رمحه فهو له كالمقود % % 40(@)(@@) % وليوث صال فيهم فانثنوا % % وضواريهم له كالنقد % % PageV01P184 41(@)(@@) % بحسام مطفىء أرواحهم % بشواظ البارق المتقد % % 42(@)(@@) % لغراريه على هاماتهم % % من شرار القدح ما في الزند % % 43(@)(@@) % كم تغنى بالمنايا في الطلا % % ظبتاه ، عن أغاني معبد % % 44(@)(@@) % وسنان مشرع في صعدة % كلسان في فم الأيم الصدي % % 45(@)(@@) % في سماء النقع منه كوكب % % طالع في يزني أملد % % 46(@)(@@) % أبدا يدعو إلى مأدبة % حوم الوحش عليها تغتدي % % 47(@)(@@) % يا بني البأس : من الذمر الذي % % جاء 
ms51	 في كاهل عزم أيد ؟ % 48(@)(@@) % شيب الحرب اقتحاما بعدما % % 49(@)(@@) % يرعف اللهذم في راحته % % كلما شم قلوب الأسد % % 50(@)(@@) % سمهري أحرقت شعلته % كل روح في غدير الزرد % % PageV01P185 51(@)(@@) % أنت ذاك الأسد الورد فهل % % كان في رمحك سم الأسود % 52(@)(@@) % أعناق البهم استحسنته % % وهو برد أم عتاق الجرد % % 53(@)(@@) % دمت في الملك لمعنى مادح % ينظم الفخر ، وجدوى مجتد % % 54(@)(@@) % وبنات من فضيح مفلق % يشهد الفضل له في المشهد % % 55(@)(@@) % فهو بالإحسان في ألفاظها % % محسن صيد المعاني الشرد % % 56(@)(@@) % في بيوت أذنت فيها العلى % % لك بالتقريظ في كل ند % % 57(@)(@@) % قد تناهى في عروض فهي لا % % يعرض الهدم لها في المسند % % 58(@)(@@) % فإذا أثنت عليكم فتقت % % لكم مسك الثناء الأبدي % % 59(@)(@@) % وإذا استحيت من المجد أتى % % معربا عنها لسان المنشد % % PageV01P186 البحر : كامل تام 1(@)(@@) % صدت وبدر التم مكسوف به % % فحسبت أن كسوفه من صدها % % 2(@)(@@) % والبدر قد ذهب الخسوف بنوره % % في ليلة حسرت أواخر مدها % % 3(@)(@@) % فكأنه مرآة قين أحميت % فمشى احمرار النار في مسودها % % PageV01P187 البحر : كامل تام 1(@)(@@) % قدح المشيب بمفرقيه زنادا % % لا يستطيع لناره إخمادا % % 2(@)(@@) % وثنت مليحات التلفت سلوة % % عن شخصه الألحاظ والأجيادا % % 3(@)(@@) % ولربما فرشت لزائر لحظه % ورد الخدود محبة وودادا % % 4(@)(@@) % إن صادقته زمان صادقه الصبا % % فهي التي عادته لما عادى % % 5(@)(@@) % أترى بياض الشيب ماء غاسلا % في العارضين وللشباب سوادا % % 6(@)(@@) % خانت سعاد ، وقد وفى لك لونها ، % لو خان ما وفى ملكت سعادا % % 7(@)(@@) % أكثرت من ذكر الفتاء وقلما % % تعطي لذي الذكر الفتاة قيادا % % PageV01P188 البحر : طويل 1(@)(@@) % ومنقطع بالسبق من كل حلبة % فتحسبه يجري إلى الرهن مفردا % % 2(@)(@@) % كأن له في أذنه مقلة يرى % % بها اليوم أشخاصا تمر به غدا % % 3(@)(@@) % تقيد بالسبق الأوابد فوقه % ولو مر في آثارهن مقيدا % % PageV01P189 البحر : كامل تام 1(@)(@@) % تفشي يداك سرائر الأغماد % لقطاف هام واختلاء هواد % 2(@)(@@) % إلا على غزو يبيد به العدى % % لله من غزو له وجهاد % % 3(@)(@@) % وعزائم ترميهم بضراغم % % تستأصل الآلاف بالآحاد % 4(@)(@@) % من كل ذمر في 
ms52	 الكريهة مقدم % صال لحر سعيرها الوقاد % 5(@)(@@) % كسناد مسمرة وقسور غيضة % وعقاب مرقبة ، وحية واد % 6(@)(@@) % وكأنهم في السابغات صوارم % % والسابغات لهم من الأغماد % 7(@)(@@) % أسد عليهم من جلود أراقم % قمص أزرتها عيون جراد % % 8(@)(@@) % ما صون دين محمد من ضيمه % إلا بسيفك يوم كل جلاد % % 9(@)(@@) % وطلوع رايات ، وقود جحافل % وقراع أبطال ، وكر جياد % % 10(@)(@@) % ولديك هذا كله عن رائح % من نصر ربك في الحروب ، وغاد % % PageV01P190 11(@)(@@) % إن اهتمامك بالهدى عن همة % علوية الاصدار والايراد % 12(@)(@@) % وإقامة الأسطول تؤذن بغتة % بقيامة الأعداء والحساد % 13(@)(@@) % والحرب في حربية نيرانها % % تطأ المياه بشدة الإيعاد % % 14(@)(@@) % ترمي بنفط طيف يبقي لفحه % والشم منه محرق الأكباد % % 15(@)(@@) % وكأنما فيها دخان صواعق % ملئت من الإبراق والإرعاد % % 16(@)(@@) % لا تسكن الحركات عنك إنها % % لخواتم الأعمال خير مبادي % % 17(@)(@@) % وأشد من قهر الأعادي محرب % في سلمه للحرب ذو استعداد % % 18(@)(@@) % سيثير منك العزم بأسا مهلكا % والنار تنبع عن قداح زناد % % 19(@)(@@) % وغرار سيفك ساهر لم تكتحل % % عين الردى في جفنه برقاد % % 20(@)(@@) % وزمانك العاصي لغيرك ، طائع % لك ، طاعة المنقاد للمقتاد % PageV01P191 21(@)(@@) % ونرى يمينك ، والمنى في لثمها % % في كل أفق بالجنود تنادي % % 22(@)(@@) % من كان عن سنن الشجاعة والندى % % بئس المضل فأنت نعم الهادي % % 23(@)(@@) % هل تذكر الأعلاج سبي بناتها % % بظبا جعلن قلائد الأجياد % % 24(@)(@@) % من كل بيضاء الترائب غادة % تمشي كغصن البانة المياد % % 25(@)(@@) % مجذوية بذوائب كأساود % عبثت بهن براثن الآساد % % 26(@)(@@) % من كل ذي زبد علته سفنه % يخرجن من جسد بغير فؤاد % 27(@)(@@) % ثعبان بحر ، عضه بنواجذ % % خلعت عليه من الحديد ، حداد % % 28(@)(@@) % يبدي منه سقط حمامة % ببياضه في البحر جري سواد % % 29(@)(@@) % وكأنما الريح التي تجري به % % روح يحرك منه جسم جماد % % 30(@)(@@) % يا أيها الممضي قواه وحزمه % ومحالف التأويب والإسآد % % PageV01P192 31(@)(@@) % هذا ابن يحيى ذو السماح جنابه % مستهدف بعزائم القصاد % % 32(@)(@@) % فرغ من السير الرذية عنده % % تملأ يديك بطارف وتلاد % % 33(@)(@@) % ملك مفاخره تعد مفاخرا % % لمآثر الآباء والأجداد % 34(@)(@@) % ومراتع الرواد بين ربوعه 
ms53	 % محفوفة بمناهل الوراد % 35(@)(@@) % ثبتت قواعد ملكه فكأنما % % أرساه رب العرش بالأطواد % % 36(@)(@@) % وطريده ، من حيث راح أو اغتدى % % في قبضة منه بغير طراد % % 37(@)(@@) % والأرض في يمناه حلقة خاتم % % والبحر في جدواه رشح ثماد % % 38(@)(@@) % لا تسألن عما يصيب برأيه % % وطعانه بمقوم مياد % % 39(@)(@@) % يضع الهناء مواضع النقب الذي % % يضع السنان مواضع الأحقاد % % 40(@)(@@) % كالبدر يوم الطعن يطفىء رمحه % % روح الكمي بكوكب وقاد % % PageV01P193 41(@)(@@) % تبني سلاهبه سماء عجاجة % % من ذبل الأرماح ، ذات عماد % % 42(@)(@@) % وبرد سمر الطعن عن أرض العدى % % وكأنها في صبغة الفرصاد % % 43(@)(@@) % وسقوط هامات بضرب مناصل % % وصعود أرواح بطعن صعاد % % 44(@)(@@) % أما شداد المجرمين فعزه % أبقاهم بالذل غير شداد % % 45(@)(@@) % والنار تأخذ في تضرمها الغضا % % جزلا ، وتتركه مهيل رماد % % 46(@)(@@) % يا من إليه بانتجاع مؤمل % مستمطر منه سماء أيادي % % 47(@)(@@) % ألقيت من نيل المنى عن عاتق % فكأنني سيف بغير نجاد % % 48(@)(@@) % ما لي بأرضك يوم جودك معرب % بلسانه عن خدمتي وودادي % % 49(@)(@@) % إلا قصائد بالمحامد صغتها % % غرا تهز محافل الإنشاد % % 50(@)(@@) % خلعت معانيها على ألفاظها % % ألحان أشعار ونقر شواد % % PageV01P194 51(@)(@@) % رجحت بقسطاس البديع وإنها % % لخفيفة الأرواح والأجساد % 52(@)(@@) % تبقى كنقش الصخر وهي شوارد % مثل المقيم بها وحدوا الحادي % % PageV01P195 البحر : طويل 1(@)(@@) % أمسك الصبا أهدت إلي صبا نجد % وقد ملئت أنفاسه لي بالوجد % 2(@)(@@) % رماني بحر الشوق برد نسيمها % % أحدثت عن حر مذيب من البرد % 3(@)(@@) % وما طاب عرف من سراها وإنما % % تطيب في جنح الدجى بسرى هند % % 4(@)(@@) % حدا بالأسى شوقي رواحل أدمعي % % فكم خدد الخد الذي فوقه تخدي % % 5(@)(@@) % ولي ذمة مرعية عند عبرة % تواصل ودي في فراق ذوي الود % % 6(@)(@@) % أحب حبيبا نجل أوس لقوله : % ' فيا دمع أنجدني على ساكني نجد ' % 7(@)(@@) % نوى أسلمت منا خليا إلى شجى % ووصلا إلى هجر ، وقربا إلى بعد % % 8(@)(@@) % وأسد على مثل السعالي عوابس % % لها لبد من صنعة الحلق السرد % % 9(@)(@@) % كفاة وغيد ، أهدت الريح منهما % % لنا سهك الماذي في أرج الند % % 10(@)(@@) % سروا بالمها وهنا ومن ورق 
ms54	 الظبا % % كناس عليها حف بالقصب الملد % PageV01P196 11(@)(@@) % ندير عيونا شيب بالحسن حسنها % % فلله منها ما تسر وما تبدي % % 12(@)(@@) % وتحسب منها في البراقع نرجسا % تخط الأسى بالطل في صفحة الخد % % 13(@)(@@) % وكم غادة لا يعرف الرئم مثلها % % رمتني بسهمي مقلتيها على عمد % % 14(@)(@@) % فريدة حسن ، تخجل البدر بالسنا % % ودعص النقا بالردف ، والغصن بالقد % % 15(@)(@@) % إذا عقدت ، عقد الخيول ، وشاحها % % على خصرها المجدول أوهت من العقد % % 16(@)(@@) % مهاة تكاد العين من لين جسمها % % ترى الورق المخضر في الحجر الصلد % % 17(@)(@@) % يضل سرى المشط المسرح فرعها % % إذا ما سرى في ليل فاحمه الجعد % % 18(@)(@@) % وتندى بمفتوت من المسك صائك % % قدير إلى عصر الشباب على رد % % 19(@)(@@) % فلا تك منها ظالما لصفاتها % % على الثغر بالإغريض والريق بالشهد % 20(@)(@@) % إذا بات قلبي بالصبابة عندها % % ففي أي قلب بات وجدي بما عندي % % PageV01P197 21(@)(@@) % وليل هوت فيه نجوم كأنها % % يعاليل بحر مضمر الجزر في المد % % 22(@)(@@) % كأن الثريا فيه باقة نرجس % من الشرق يهديها إلى مغرب مهد % % 23(@)(@@) % أردت به صيد الخيال ففاتني % % كما فر عن وصل المتيم ذو صد % % 24(@)(@@) % فكيف يصيد الطيف في الحلم ساهر % أقل كرى من حسوة الطائر الفرد % % 25(@)(@@) % أخو عزمات بات يعتسف الفلا % % بعيرانة تردي وخيفانة تخدي % % 26(@)(@@) % قفار نجت منها الصبا إذ تعلقت % % حشاشتها مني بحاشية البرد % % 27(@)(@@) % وقد شق خيط الفجر في جنح ليلنا % % كما شق حد السيف في جانب الغمد % % 28(@)(@@) % وأهدت لنا الأنوار في أرض حمة % من ابن علي غرة القمر السعد % % 29(@)(@@) % هنالك ألقى المجتدون عصيهم % % بحيث استراحوا من مطاوعة الكد % % 30(@)(@@) % لدى ملك يربي على الغيث جوده % ويغرق منه البحر في طرف الثمد % % PageV01P198 31(@)(@@) % مندى الأماني في مراتع ربعه % % ومستمطر الجدوى ، ومنتجع الوفد % % 32(@)(@@) % ينير سرير الملك منه بأروع % % سنا نوره يجلو قذى الأعين الرمد % % 33(@)(@@) % غني ، بلا فقر لذكرى قديمة % بمفخره عن مفخر الأب والجد % % 34(@)(@@) % إذا السبعة الشهب العلية مثلت % بمنظوم عقد كان واسطة العقد % % 35(@)(@@) % جواد بما قد شئت من بذل 
ms55	 نائل % ومن كرم محض ، ومن حسب عد % 36(@)(@@) % يجود ارتجالا بالمنى لا روية % فلا حكم تسويف عليه ولا وعد % % 37(@)(@@) % تعود ظهر الحجر في الحجر مركبا % ومهدت العليا له الملك في المهد % % 38(@)(@@) % وقالت لقد السيف نبعه قده % ستعلم ما يلقاه حدك من حدي % % 39(@)(@@) % ترى الملك يستخذي لشدة بأسه % % خضوع ابن آوى للغضنفرة الورد % % 40(@)(@@) % تقوم على ساق به الحرب في العدى % % ومجلسه في صهوة الفرس النهد % % PageV01P199 41(@)(@@) % ويمتح نفس القرن عامل رمحه % كما يمتح الماء الرشاء من الجد % % 42(@)(@@) % إذا شرع الخطي أغرى سنانه % % من الذمر ، معتادا ، بجارحة الحقد % % 43(@)(@@) % سليل الملوك الغر يؤنسه الندى % % إذا ما علاه أوحشته من الند % 44(@)(@@) % وما حمير إلا الغطارفة الألى % % أياديهم تسدى وأيديكم تسدي % % 45(@)(@@) % يصولون صول الذائدين عن الهدى % % ويعفون عفو القائدين ذوي الرشد % % 46(@)(@@) % وتسلب تيجان الملوك أكفهم % إذا طوقوا أيمانهم قضب الهند % % 47(@)(@@) % وحرب كأن البأس ينقد جمعها % % ليعلم فيهم من يزيف بالنقد % % 48(@)(@@) % ويقدح ، قرع البيض في البيض ، نارها % % كما ينتضي القدح الشرار من الزند % % 49(@)(@@) % ضحوك عبوس في مراح ، منقل % عن الهزل في قطف الرءوس إلى الجد % % 50(@)(@@) % حشوها على الأعداء بالبيض والقنا % % وبالزرد الموضون ، والضمر الجرد % % PageV01P200 51(@)(@@) % أقول لك القول الكريم الذي به % % جرى قلم العلياء في صحف الحمد % % 52(@)(@@) % وإن كنت عن علياك فيه مقصرا % % فعذر مقل جاء بين يدي جهدي % % 53(@)(@@) % لك الفخر في جهر المقال كأنما % % يردد في الأسماع صلصلة الرعد % % 54(@)(@@) % تولى علي عهد يحيى وبعده % % توليت عهد الملك ، قدس من عهد % % 55(@)(@@) % وتوج يحيى قبل ذاك بتاجه % % تميم ، ومسعاه على سنن القصد % % 56(@)(@@) % وقال معز اليدن ذو الفخر لابنه % % تميم : سرير الملك أنت له بعدي % % 57(@)(@@) % ولو عد ذو علم جدودك لانتهى % % إلى أول الدنيا به آخر العد % % 58(@)(@@) % وأنت على أعمارهم سوف تعتلي % % لعمر مقيم في السعادة ممتد % % 59(@)(@@) % بكفك سل الدين للضرب سيفه % % وأضحى على أعدائه بك يستعدي % % 60(@)(@@) % سددت بأقيال الأسود ثغوره % وحق بها فتح الثغور من 
ms56	 السد % % PageV01P201 61(@)(@@) % وجيش عريض بالشياح طريقه % % يموج كسيل فاض منخرق السد % % 62(@)(@@) % كأن المنايا في الكريهة ألفيت % % على خلقها من خلقه صور الجند % % 63(@)(@@) % وحربية في طالع السعد أنشيت % فنيرانها للحرب دائمة الوقد % 64(@)(@@) % جبال طفت فوق اليماه وغيضت % بسمر القنا والمرهفات على الأسد % % 65(@)(@@) % ودهم بفرسان الكفاح سوابح % تجافيفها في الروع منسدل اللبد % % 66(@)(@@) % فمن كل ذي قوسين يرسل عنهما % % سهام المنايا فهي مصمية تردي % % 67(@)(@@) % وترمي بنفط ناره في دخانه % % به الموت محمر يؤوب بمسود % 68(@)(@@) % وتحسب فيه زفرة من جهنم % % تصعد عن فتل اللوالب بالشد % % 69(@)(@@) % عرائس أغوال تهادى وإنها % % لتهدي ، إذا صالت ، من الموت ما تهدي % % 70(@)(@@) % قلوب عداة الله منها خوافق % كما قلبت فيها الصبا عذب البند % % PageV01P202 71(@)(@@) % أبوك أصاب الرشد فيها برأيه % % وهد بها ركن العدى أيما هد % 72(@)(@@) % وأصبحت منه في سجايا معظم % وحد معاليك التعاليك عن الخد % % 73(@)(@@) % ولو كان يستجدى الغمام بزعمهم % % من البحر أضحى منك في المجد يستجدي % % 74(@)(@@) % فلا زالت الأعياد تلفيك سيدا % % ينهى الندى في صونه رمث المجد % % PageV01P203 البحر : رمل تام 1(@)(@@) % أين مني عتب أحباب هجود % % قتلوا نومي بإحياء الصدود % % 2(@)(@@) % وخلي لم تبت أحشاؤه % % آه من وصل عن القرب يذود % 3(@)(@@) % وخلي لم تبت أحشاؤه % % وهي بالتبريح للنار وقود % 4(@)(@@) % قال : كم تظما من الظلم إلى % % مورد لم ترو منه بورود % % 5(@)(@@) % شيب بالمسك وبالشهد معا % والمساويك على ذلك شهود % % 6(@)(@@) % أو ترجي نيل صاد للمى % % قلت : لولا الماء ما أورق عود % % 7(@)(@@) % قال : إن البيض لا تحظى بها % % أو ترى بيض ذؤاباتك سود % % 8(@)(@@) % قلت : عندي يوم اصطاد المنى % % جذع يحكم تأنيس الشرود % % 9(@)(@@) % كم مليم قد نضا ثوب الصبا % % عنه ، ردته إلى الصبوة رود % % 10(@)(@@) % بحديث يسحر السحر به % % يتمناه معادا أن يعود % % PageV01P204 11(@)(@@) % ت نزل الطير من الجو به % % وتحط العصم من شم الريود % % 12(@)(@@) % وسبته قضب في كثب % مالت الأكفال منها بالقدود % % 13(@)(@@) % وثمار نطقت أوصافها % % بإشارات إلى صغر النهود % % 14(@)(@@) % عد 
ms57	 بي عن كل هذا إنني % % لا أرى الدهر لإحساني كنود % % 15(@)(@@) % لي هوى آوي إليه مرحا % غير أني بالنهى عنه حيود % % 16(@)(@@) % إن همي همة أسمرها % % ولها قمت فما لي والقعود % % 17(@)(@@) % وفلاة أبدا ظامئة % مشفق من قطعها العود عنود % % 18(@)(@@) % حمل الماء ولا يشربه % فهو للمروى به عين الحسود % % 19(@)(@@) % جبتها في متن ريح تنبري % % للسرى بين سيوع وقتودا % % 20(@)(@@) % في ظلام طنبت أكنافه % فوق أرجاء وهاد ونجود % % PageV01P205 21(@)(@@) % وكأن البدر فيه ملك % % والنجوم الزهر حوليه وفود % % 22(@)(@@) % وكأن الشهب شهب قيدت % أيديا منها على الجري قيود % % 23(@)(@@) % ولقد قلت لحادي عيسنا % % وهي بالبخل عن البخل تجود % % 24(@)(@@) % أنجاء تخرق الخرق به % % كابدته منك أم مضغ الكبود % % 25(@)(@@) % فمتى يفلق عن أبصارها % % هامة الليل من الصبح عمود % % 26(@)(@@) % وأرى ما اسود من قار الدجى % % ذاب منه بلظى الشمس جمود % % 27(@)(@@) % جاليا أقذاء عين مقلت % من محيا حسن بدر السعود % % 28(@)(@@) % أروع إن سخنت عين العلى % % كحلتها من سناه ببرود % % 29(@)(@@) % في رواق الملك منه ملك % ملكه من قبل عاد وثمود % % 30(@)(@@) % بسط الكف بجود غدق % قبضت عن بذله كف الصلود % % PageV01P206 31(@)(@@) % كم سبيل نحوه مسلوكة % % فهي للقصاد كالأم الولود % % 32(@)(@@) % ذو سجايا في المعالي خلقت % للوغى والسلم من بأس وجود % 33(@)(@@) % وأناة أرسيت في خلق % كنظير الزهر في الروض المجود % % 34(@)(@@) % ومصون العرض مبذول الندى % % معرق الآباء في محض الجدود % % 35(@)(@@) % ثابت عند المعالي فضله % هل يطيق الليل للصبح جحود % % 36(@)(@@) % مقدم يصطاد أبطال الوغى % % إن شبل الليث للوحش صيود % % 37(@)(@@) % ذو ابتدار في وقار كامن : % للظى الزند وقود من خمود % % 38(@)(@@) % ألفت يمناه إسداء الغنى % % والغنى تسديه يمنى من يسود % % 39(@)(@@) % كم عفاة في بلاد نزحت % فسبت منهم أياديه وفود % 40(@)(@@) % من ملوك نظمت مداحهم % فقر المدح لهم نظم العقود % PageV01P207 41(@)(@@) % في بيوت بنيت شعرية % لثناء المرء فيهن خلود % % 42(@)(@@) % كل راسي الحلم حام ملكه % عادل السيرة واف بالعهود % % 43(@)(@@) % أسد تحسب في عامله % % أسودا ينهش أعضاء الحقود 
ms58	 % 44(@)(@@) % نشأوا في منعة من عزمهم % % للمعالي في حجور وبنود % % 45(@)(@@) % بيت مجد جاوزت أربعه % أربع الشهب حدودا بحدود % % 46(@)(@@) % يقذف الحرب بجيش لجب % مشرع الأرماح مقدام الجنود % % 47(@)(@@) % ذي موازيب حديد فهقت % بصبيب الدم من طعن الكبود % % 48(@)(@@) % ونسور تغتدي أحشاؤها % % من بني الهيجاء للقتلى لحود % % 49(@)(@@) % زاحف كالبحر مدا بالصبا % % بحرور الموت في ظل البنود % % 50(@)(@@) % نقعه كالغيم ملتفا على % % صعقات من بروق ورعود % PageV01P208 51(@)(@@) % وإذا ما ركعت أسيافه % % فوق هامات العدى خرت سجود % % 52(@)(@@) % للمنايا عنده ألسنة % قلما تعمر أفواه الغمود % 53(@)(@@) % كل عضب يحسب الناظر في % % متنه للنار بالماء وقود % 54(@)(@@) % ونعوت البيض حمر عنده % % لدم تكساه من قتل الأسود % 55(@)(@@) % وكأن الأثر فيها نمش كاد % % أن يخفى بتوريد الخدود % 56(@)(@@) % وكأن الفتك فيها أبدا % % ذو حياة للعدا منه همود % % 57(@)(@@) % دم لنا يا ابن علي ملكا % في على ذات سعود وصعود % 58(@)(@@) % ودنا منك بتقبيل الثرى % % كل قرم سيد ، وهو مسود % % PageV01P209 البحر : متدارك تام 1(@)(@@) % صادتك مهاة لم تصد % فلواحظها شرك الأسد % 2(@)(@@) % من توحي السحر بناظرة % لا تنفث منه في العقد % % 3(@)(@@) % لمياء تضاحك عن درر % وبروق حيا ، وحصى برد % % 4(@)(@@) % يندى بالمسك لراشفه % % وسلاف القهوة والشهد % % 5(@)(@@) % وذماء الليل على طرف % كترحل روح عن جسد % 6(@)(@@) % وضاب الماء بفيك جرى % % في جوهره عرض الصرد % % 7(@)(@@) % وكأن كليم الله بدا % % منه في الأفق بياض يد % 8(@)(@@) % أسفي لفراق زمان صبا % % وركوبي قيد مها الخرد % % 9(@)(@@) % من كل مطابقة خلقي % % بوفاء سروري أو كمدي % % 10(@)(@@) % هيفاء يعجزها كفل % فتقوم وتقعد بالرفد % PageV01P210 11(@)(@@) % لون الياقوت ، وقسوته % % في الوجنة منها ، والكبد % % 12(@)(@@) % ولها في جيد مروعة % حلي صاغته من الغيد % % 13(@)(@@) % نقضت وصلي بتتيعها % % بالهجر ، ونومي بالسهد % % 14(@)(@@) % وأصاب السود سهام البي % % ض ببين البيض وبالنكد % % 15(@)(@@) % عجبي لإصابة مرسلها % % من جوف ضلوعي في الخلد % 16(@)(@@) % يا نار نشاطي أين سنا % % ك وأين لظاك بمفتأدي % % 17(@)(@@) % زندي ولدتك ، وقد عقمت % عن حمل السقط ، فلم تلد % % 18(@)(@@) % أحييت 
ms59	 بذكري ميت صبا % أبكيه مسايرة الأبد % 19(@)(@@) % وطلبت الضد لأوجده % وجموحي في الصد فلم أجد % % 20(@)(@@) % ولو أن كريما تفقده % يفدى بالنفس إذن لفدي % % PageV01P211 21(@)(@@) % أذهبت الحزن بمذهبة % وبها ذهبت لجين يدي % % 22(@)(@@) % ولقد نادمت ندامى الرا % % ح بمطرفي وبمتلدي % % 23(@)(@@) % بمعتقة قدمت فأتت % للشرب بلذات جدد % 24(@)(@@) % سبيت بسيوف من ذهب % % من أهل السبت أو الأحد % % 25(@)(@@) % وإذا ما عد لها ع مر % ملأت كفيك من العدد % % 26(@)(@@) % يطفو في الكاس لها حبب % كصغار مسامير السرد % % 27(@)(@@) % وإذا ما غاص الماء بها % % في النار تردت بالزبد % % 28(@)(@@) % ونفيت الهم ببنت الكر % % م ونقر العود ، فلم يعد % 29(@)(@@) % ولبثت مشنفة أذني % % بترنم ذي النغم الغرد % % 30(@)(@@) % فالآن صددت كذي حذر % عن ورد اللهو فلم أرد % PageV01P212 31(@)(@@) % وطردت منام الغي عن ال % % أجفان بإيقاظ الرشد % 32(@)(@@) % ونقضت عهود الشرب فلا % % ود أصفيه لأهل دد % 33(@)(@@) % لا أشرب ما أنا واصفه % % فكأني بينهم قعدي % % 34(@)(@@) % ونقلت بعزمي من بلد % قدم الإسراء إلى بلد % 35(@)(@@) % في بطن الفلك مصارعة % زمني ، وعلى ظهر الأجد % % 36(@)(@@) % ووجدت الدين له حسنا % سندا فلجأت إلى السند % % 37(@)(@@) % صمد اللاجون إلى ملك % منصور بالأحد الصمد % % 38(@)(@@) % كالشمس سناها مقترب % وذراها منك على بعد % % 39(@)(@@) % وإذا ما آنس منه سنا % من ضل بجنح الليل هدي % % 40(@)(@@) % خصت بنوال شيمته % عجل ، وكلام متئد % PageV01P213 41(@)(@@) % لا وعد له بالجود ومن % يبدأ بعطاء لا يعد % 42(@)(@@) % وبنية شهم منتصر % لله جميل المعتقد % 43(@)(@@) % فيصون العرض بما بذلت % للوفد يداه من الصفد % 44(@)(@@) % ويسد الثغر ، وسيرته % % تجري في الملك على سدد % % 45(@)(@@) % ويسل ظباه بكل وغى % ويسيل نداه بكل يد % % 46(@)(@@) % وتريك اليوم بصيرته % % ما يخفى عنك ضمير غد % 47(@)(@@) % وله همم تبني رتبا % خصت بعلاء منفرد % % 48(@)(@@) % إلهام الدين وحاميه % قوم بسطاك ذوي الأود % % 49(@)(@@) % فت السباق بما كحلوا % % بغبارك عينا في الأمد % 50(@)(@@) % والريح وراءك عائرة % في الأين تكب وفي النجد % % PageV01P214 51(@)(@@) % نصر أيدت به ظفرا % % والساعد ينجد بالعضد % % 52(@)(@@) % يا 
ms60	 غيث المحل بلا كذب % وشجاع الحرب بلا فند % % 53(@)(@@) % لحظات أناتك جانبها % % أرسى في غيظك من أحد % % 54(@)(@@) % ولواؤك تقدم هيبته % بعديد يلبك في العدد % % 55(@)(@@) % وكأن عدوك ، خافقه % بجناح فؤاد مرتعد % 56(@)(@@) % إن كنت قصرت محبرة % تسهيم المحكم ذي الجدد % 57(@)(@@) % فالعذب يجل بقلته % % وعليه عماد المعتمد % 58(@)(@@) % وأجاج الماء بكثرته % % لا ري به لغليل صد % % 59(@)(@@) % والشعر أجدت بمعرفتي % % تأنيس غرائبه الشرد % % 60(@)(@@) % لو شئت لقلت لقافية % في الوزن تخب إليك : خدي % % PageV01P215 61(@)(@@) % بصقيل اللفظ منقحه % لا سمع يمر به بصد % 62(@)(@@) % لا زيف به فيريك قذى % في عين بصيرة منتقد % % 63(@)(@@) % لا يسمع فيه مستمع % زفرات أسى كالمفتقد % % 64(@)(@@) % فصفير البلبل مطرح % في الأيك له صوت الصرد % % 65(@)(@@) % تستحسن عودة منشده % % وتقول إذا ما زاد : زد % 66(@)(@@) % فبغام الرئم حلاوته % % وجزالته زأر الأسد % % 67(@)(@@) % وبذلة أهل السبت قضى % % ويذل له أهل الأحد % 68(@)(@@) % فانصر وافخر وأدر وأشر % وأبر وأجر وأغر وسد % PageV01P216 البحر : طويل 1(@)(@@) % أذا البدر يطوى في ربوع البلى لحدا % % أم الطود حطوا في ثرى القبر إذ هدا % % 2(@)(@@) % كسوف وهد تحسب الدهر منهما % % لعين وأذن : ظلمة ملئت رعدا % % 3(@)(@@) % تولى عن الدنيا علي بن أحمد % وأبقى لها من ذكره الفخر والحمدا % % 4(@)(@@) % حملنا على التكذيب تصديق نعيه % وسدت له الأسماع وانصرفت صدا % % 5(@)(@@) % وقال لمن أدى المصاب معنف : % فظيع من الأنباء جئت به إدا % % 6(@)(@@) % إلى أن نعاه الدهر ملء لسانه % ومن ذا الذي يخفي من الرزء ما أبدى % % 7(@)(@@) % هنالك خضنا في العويل ولم نجد % على الكره ، من تصديق ما قاله بدا % % 8(@)(@@) % وقال الورى ، والأرض مائدة بهم ، % أمن سيرها في الحشر قد ذكرت وعدا % % 9(@)(@@) % أرى الشرف الفهري يبكي ابن بيته % % عليا ، أما يبكي فتى راضع المجدا % % 10(@)(@@) % فيا معشرا حثوا به نحو قبره % % مطية حتف فوق أيديهم تحدى % % PageV01P217 11(@)(@@) % حملتم على الأعواد من قد حملتم % فكل جلال قد وجدتم له فقدا % % 12(@)(@@) % لقد دفعت أيديكم منه للبلى % % يدا بجديد العرف كانت لكم 