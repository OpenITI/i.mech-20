ms178	 - نوح الجامع: وضع حديث فضائل القرآن، قال الدارقطني: متروك.(@)(@@)(@@)(@@) $ 4418 - نوح بن يزيد: قاضي مرو، هو نوح بن أبي مريم.(@)(@@)(@@)(@@) $ 4419 - نوح: عن أبي مجلز عن أبي ذر رضي الله عنه في حسن الخلق، لا يصح حديثه.(@)(@@)(@@)(@@) || نوفل(@)PageV01P414(@)(@@)(@@)(@@) $ 4420 - نوفل بن سليمان الهنائي: عن ابن جريج، ضعفه الدارقطني.(@)(@@)(@@)(@@) | حرف الهاء(@)PageV01P415(@)(@@)(@@)(@@) || هارون(@)PageV01P415(@)(@@)(@@)(@@) $ 4421 - هارون بن أيوب: عن سلمة بن كهيل: مجهول.(@)(@@)(@@)(@@) $ 4422 - هارون بن الجهم: شيخ لسعد بن الصلت، يخالف في حديثه.(@)(@@)(@@)(@@) $ 4423 - هارون بن حاتم: قال النسائي وغيره: ليس بشيء.(@)(@@)(@@)(@@) $ 4424 - هارون بن حبيب البلخي: عن جويبر، قال الأزدي: كذاب.(@)(@@)(@@)(@@) $ 4425 - هارون بن حيان الرقي: عن ابن المنكدر، قال الحاكم: كان يضع الحديث.(@)(@@)(@@)(@@) $ 4426 - هارون بن دينار البصري: ضعفه الدارقطني، وغيره.(@)(@@)(@@)(@@) $ 4427 - هارون بن راشد البصري: مجهول.(@)(@@)(@@)(@@) $ 4428 - هارون بن زياد: عن الأعمش، قال أبو حاتم: له حديث باطل.(@)(@@)(@@)(@@) $ 4429 - هارون بن أبي زياد التميمي: عن ابن عمر رضي الله عنهما: مجهول.(@)(@@)(@@)(@@) $ 4430 - هارون بن سعد العجلي: شيخ للمسعودي، تابعي، رافضي.(@)(@@)(@@)(@@) $ 4431 - هارون بن سعد: صاحب راية علي، مولى لقريش: مجهول.(@)(@@)(@@)(@@) $ 4432 - هارون بن سوادة: روى عنه زياد بن الربيع، ضعف.(@)(@@)(@@)(@@) $ 4433 - هارون بن عنترة: وثقه أحمد، وقال ابن حبان: لا يحتج به. -د، س-(@)(@@)(@@)(@@) $ 4434 - هارون بن أبي عيسى: روى السيرة عن ابن إسحاق، قال البخاري: يخطئ، عن غير ابن إسحاق. -س-(@)(@@)(@@)(@@) $ 4435 - هارون بن قزعة: في زيارة قبر النبي - صلى الله عليه وآله وسلم - قال البخاري: لا يتابع عليه، عن رجل من آل الخطاب.(@)(@@)(@@)(@@) $ 4436 - هارون بن كثير: عن زيد بن أسلم: مجهول.(@)(@@)(@@)(@@) $ 4437 - هارون بن محمد: عن ابن أبي عروبة، قال ابن معين: كذاب، يكنى أبا الطيب.(@)(@@)(@@)(@@) $ 4438 - هارون بن مسلم: عن قتادة: مجهول. -ق-(@)(@@)(@@)(@@) $ 4439 - هارون أبو قزعة، قال الأزدي: متروك الحديث.(@)(@@)(@@)(@@) || هاشم(@)PageV01P416(@)(@@)(@@)(@@) $ 4440 - هاشم بن البريد الكوفي: صدوق غال في التشيع. -د، س، ق-(@)(@@)(@@)(@@) $ 4441 - هاشم بن حبيب البصري: ضعفه الأزدي.(@)(@@)(@@)(@@) $ 4442 - هاشم بن زيد: عن نافع، قال أبو حاتم: ضعيف الحديث.(@)(@@)(@@)(@@) $ 4443 - هاشم بن سعيد: كوفي مقل، قال 
ms179	 ابن معين: ليس بشيء. -ت-(@)(@@)(@@)(@@) $ 4444 - هاشم بن عيسى الحمصي: عن أبيه، عن تابعي، لا يعرف.(@)(@@)(@@)(@@) $ 4445 - هاشم بن مرثد الطبراني، أبو سعيد: قال ابن حبان: ليس بشيء في الحديث، وابنه صدوق.(@)(@@)(@@)(@@) $ 4446 - هاشم بن محمد الربعي: عن حماد بن زيد، لا يتابع على حديثه.(@)(@@)(@@)(@@) $ 4447 - هاشم بن أبي هاشم: كوفي مجهول.(@)(@@)(@@)(@@) $ 4448 - هاشم بن يحيى المزني: عن أبي دغفل: مجهولان.(@)(@@)(@@)(@@) || هانيء(@)PageV01P417(@)(@@)(@@)(@@) $ 4449 - هانئ بن خالد: عن أبي جعفر الرازي، فيه جهالة.(@)(@@)(@@)(@@) $ 4450 - هانئ بن المتوكل الإسكندراني: عن حيوة بن شريح، قال ابن حبان: كثرت المناكير في حديثه فلا يحتج به.(@)(@@)(@@)(@@) $ 4451 - هانئ بن هانئ: عن علي رضي الله عنه: مجهول. -د، ت، ق-(@)(@@)(@@)(@@) $ 4452 - هانئ، أبو سليمان الربعي: مجهول.(@)(@@)(@@)(@@) || هبة الله(@)PageV01P417(@)(@@)(@@)(@@) $ 4453 - هبة الله بن أبي شريك الحاسب: عن ابن النقور، قال ابن السمعاني: كانت الألسنة مجتمعة على الثناء السيء عليه.(@)(@@)(@@)(@@) $ 4454 - هبة الله بن المبارك السقطي: قال ابن ناصر: ليس بثقة، له معجم.(@)(@@)(@@)(@@) || هبيرة(@)PageV01P417(@)(@@)(@@)(@@) $ 4455 - هبيرة بن عبد الرحمن بن خديج: قال الأزدي: يتكلمون فيه. -عه-(@)(@@)(@@)(@@) $ 4456 - هبيرة بن يريم: عن علي، قال أبو حاتم: شبيه بالمجهول.(@)(@@)(@@)(@@) $ 4457 - هبيرة العدوي، قال أبو حاتم: لا شيء.(@)(@@)(@@)(@@) || هدبة(@)PageV01P418(@)(@@)(@@)(@@) $ 4458 - هدبة بن خالد: ثقة، لا وجه لقول النسائي فيه، ضعيف. -خ، م، د-(@)(@@)(@@)(@@) || هذيل(@)PageV01P418(@)(@@)(@@)(@@) $ 4459 - هذيل بن بلال المدائني: عن نافع، ضعفه الدارقطني وغيره.(@)(@@)(@@)(@@) $ 4460 - هذيل بن الحكم: عن الحكم بن أبان، قال البخاري: منكر الحديث.(@)(@@)(@@)(@@) || هرماس(@)PageV01P418(@)(@@)(@@)(@@) $ 4461 - هرماس بن حبيب: عن أبيه، عن جده: مجهول. -د، ق-(@)(@@)(@@)(@@) || هشام(@)PageV01P418(@)(@@)(@@)(@@) $ 4462 - هشام بن أبي إبراهيم: عن ابن عمر رضي الله عنهما: مجهول.(@)(@@)(@@)(@@) $ 4463 - هشام بن حجير: شيخ لابن جريج، ضعفه ابن معين، وأحمد. -خ، ق، س-(@)(@@)(@@)(@@) $ 4464 - هشام بن حسان: ثقة، لا يلتفت إلى قول شعبة فيه. -ع-(@)(@@)(@@)(@@) $ 4465 - هشام بن خالد بن الوليد: عن ابن عمر، لا يدرى من هو.(@)(@@)(@@)(@@) $ 4466 - هشام بن زياد، أبو المقدام: قال النسائي وغيره: متروك. -ت، ق-(@)(@@)(@@)(@@) $ 4467 - هشام بن سعد المدني: ضعفه النسائي وغيره، وقال ابن معين: كان يحيى القطان لا يحدث عنه، 
ms180	 وقال أحمد: ليس هو محكم الحديث، وقال ابن عدي: مع ضعفه يكتب حديثه. -عه، م-(@)(@@)(@@)(@@) $ 4468 - هشام بن سعيد الطالقاني: كان ابن معين لا يحدث عنه. -د، س-(@)(@@)(@@)(@@) $ 4469 - هشام بن سلمان: عن يزيد الرقاشي، ضعفه التبوذكي.(@)(@@)(@@)(@@) $ 4470 - هشام بن سليمان المخزومي: قيل في حديثه عن غير ابن جريج وهم.(@)(@@)(@@)(@@) $ 4471 - هشام بن عبد الله بن عكرمة المخزومي: تكلم فيه ابن حبان. -خ، م، ق-(@)(@@)(@@)(@@) $ 4472 - هشام بن عبيد الله الرازي: قال ابن حبان: كثرت مخالفته للأثبات، قلت: ثم ساق له حديثين موضوعين.(@)(@@)(@@)(@@) $ 4473 - هشام بن محمد الكعبي: تركوه كأبيه، وكانا رافضيين.(@)(@@)(@@)(@@) $ 4474 - هشام بن محمد التيمي الكوفي: متهم متأخر عن أبي حفص الكناني.(@)(@@)(@@)(@@) $ 4475 - هشام بن مودود: عن هشام بن علاقة: مجهول.(@)(@@)(@@)(@@) $ 4476 - هشام بن نجيح: وهشام بن أبي هشام الحنبي، وهشام المرهبي، عن الحسن، وهشام السختياني، مجاهيل.(@)(@@)(@@)(@@) $ 4477 - هشام بن لاحق: شيخ للإمام أحمد، قال: تركت حديثه.(@)(@@)(@@)(@@) $ 4478 - هشام بن أبي يعلى: عن ابن الحنفية: مجهول.(@)(@@)(@@)(@@) || هشيم(@)PageV01P420(@)(@@)(@@)(@@) $ 4479 - هشيم بن بشير: ثقة حافظ مدلس، وهو في الزهري، لين. -ع-(@)(@@)(@@)(@@) || همام(@)PageV01P420(@)(@@)(@@)(@@) $ 4480 - همام بن مسلم: عن ابن سوقة، قال ابن حبان: يسرق الحديث.(@)(@@)(@@)(@@) $ 4481 - همام بن نافع: والد عبد الرزاق، قال العقيلي: حديثه غير محفوظ. -ت-(@)(@@)(@@)(@@) $ 4482 - همام بن يحيى: ثقة، نبيل، كان يحيى القطان لا يرضى حفظه. -ع-(@)(@@)(@@)(@@) || هناد(@)PageV01P420(@)(@@)(@@)(@@) $ 4483 - هناد بن إبراهيم، أبو المظفر النسفي.(@)(@@)(@@)(@@) $ 4484 - هود بن عبد الله العصري: حسن الحديث لم يضعف. -ت-(@)(@@)(@@)(@@) $ 4485 - هود بن عطاء اليمامي: عن أنس، قال ابن حبان: لا يحتج به.(@)(@@)(@@)(@@) || هوذة(@)PageV01P421(@)(@@)(@@)(@@) $ 4486 - هوذة بن خليفة: صدوق، ضعفه يحيى بن معين. -ت-(@)(@@)(@@)(@@) || هلال(@)PageV01P421(@)(@@)(@@)(@@) $ 4487 - هلال بن خباب: عن عكرمة، قال ابن حبان: اختلط في آخر عمره. -عه-(@)(@@)(@@)(@@) $ 4488 - هلال بن رداد: عن الزهري: مجهول.(@)(@@)(@@)(@@) $ 4489 - هلال بن زيد، أبو عقال: عن أنس، متروك. -ق-(@)(@@)(@@)(@@) $ 4490 - هلال بن أبي زينب: عن شهر بن حوشب، قال أحمد: تركوه. -ق-(@)(@@)(@@)(@@) $ 4491 - هلال بن سويد، أو ابن أبي سويد: عن أنس، ضعفه جماعة. -ت-(@)(@@)(@@)(@@) $ 4492 - هلال بن عبد الله، أبو هاشم: عن أبي إسحاق السبيعي، 