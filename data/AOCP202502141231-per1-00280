ms264	 عمر(@)(@@) (@@) دی دیدم و، گفتمش که: داری سر ما؟ %~% گفتا: دارم، ولیک گردان همه عمر!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2631 گفتم: به جزاز سخن چه می خواهی تو %~% گفت: از من دلشکن چه می خواهی تو؟(@)(@@) (@@) گفتم: بوسی از لب تو می خواهم %~% گفتا که : زجان من چه می خواهی تو؟(@)(@)PageV01P430(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0434.jpg)(@)(@)(@@)(@@)(@@) | نمط سی وهفتم(@)(@@) در سرای و کوی وخانهآ او(@)(@@)(@@)(@@) | خاقانی(@)(@@) (@@) 2632 پیغام غمت، سوی دلم می آید جان، پیش درت به خاک خواهم کردن %~%(@)(@@) کز خاک درت، بوی دلم می آید! %~% زخمت، همه بر روی دلم می آید(@)(@@)(@@)(@@) | افضل کاشانی(@)(@@) ~~زنده به هوای عشق توست، آتش دل 263 بس رشک، که سرمه راست بر خاک درت(@)(@@) %~% الغیره %~% ای آب حیات، مرده در خاک درت! %~% از بس که بسود چشم، مرخاک درت(@)(@@) (@@) با این همه، آب چشم وین آتش دل 2640 ماییم زجان شده تورا خاک رهت %~%(@)(@@) لغیره %~% بر دیدهآ ما چو توتیا خاک رهت %~% چون باد بیامیخته با خاک رهت(@)(@@) ~~ر خاک در تو، جان توان داد ولیک 264 درد تو زدست یک نفس نتوان داد(@)(@@) %~% خاک در تو، به هیچ کس نتوان داد %~% وین عمر، جزاندر این هوس نتوان داد(@)(@@)(@@)(@@) | بهاءلاغری(@)(@@) (@@) 2641 بی توهمه شب، رهگذرت می بوسم %~% تا روز، به ره بر، اثرت می بوسم(@)(@@) ~~وز بیم رقیبان تو، چون بید زباد 2641 دل، میل وصال آن پری پیکر کرد(@)(@@) %~% الغیره %~% لرزان لرزان، خاک درت می بوسم %~% خود را می ونقل و ساقی و ساغر کرد(@)(@@) (@@) از خاک درش، رسید بویی به دلم %~% الغیره %~% زان بوی، دلم دماغ اندر سر کرد(@)(@@) (@@) ای لعل تو آب زندگانی، آسود 2264 رفتیم و، ببردیم گرانجانی ما %~%(@)(@@) بغیره %~% خوش باش، که رستی از پریشانی ما %~% خاک درت، از زحمت پیشانی ما!(@)(@@) (@@) 2645 در عشق تو، من دیده به هم بر نزنم خالی نشوم زآستان در تو %~%(@)(@@) تا، دست هزار باره بر سر نزنم %~% تا دیده به جای حلقه بر در نزنم 
ms265	 PageV01P431(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0435.jpg)(@)(@)(@@)(@@)(@@) | رضیه(@)(@@) (@@) 2646 شاگرد گره زنان موی تو، منم %~% مولای مشاطگان روی تو، منم(@)(@@) (@@) از بس که زدیدگان همی ریزم آب %~% سقای مجاوران کوی تو، منم(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 2647 بیچاره دل خسته، به اول نظرت %~% در دیدهآ خود دید، چو نور بصرت(@)(@@) (@@) باد هوس تو، کرد تیز آتش دل %~% اوله %~% زین پس، من و آب دیده و خاک درت!(@)(@@) (@@) 2648 دل بردی و گفتی: از توجان می خواهم %~% هرچ آرزوی توست، من آن می خواهم(@)(@@) (@@) لیکن نه برای دل، برای توزدل %~% سرگشته، به هر کوی نشان می خواهم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2649 خاک سر کوی آن بت مشکین خال %~% می بوسیدم دوش، به اومید وصال(@)(@@) (@@) پنهان زرقیب آمد و، در گوشم گفت: %~% می خور غم ما و، خاک در لب می مال!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2650 گر یک نظرت بر من حیران افتدشوریده دلم، بی سر و سامان افتد(@)(@@) (@@) بر خاک درت فتاده ام، بوسه زنان %~% چون تشنه، که بر چشمهآ حیوان افتد(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2651 دل، در کف انتظار فرسوده به استوز بهر امید، وصل نابوده به است(@)(@@) ~~خاک در دوست، چون دریغ است به لباز زحمت بوسیدنم، آسوده به است(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2652 برخیزم و، چون زلف در افتم به برش %~% و آنگاه، یکی بوسه زنم بر شکرش(@)(@@) (@@) نی نی، لب او به بوسه آزرده شود %~% هان ای لب خناکسار، هم خاک درش!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 2253 هر روز، زشوق نرگس بیمارت %~% برجان ودل ودیده کشم، تیمارت(@)(@@) (@@) شب تا به سحر، زآرزوی دیدارت %~% می مالم روی، بر در و دیوارت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2250 دل، در سر زلف دلبرت خواهد بود %~% جان، نعره زن هر نظرت خواهد بود(@)(@@) ~~گفتی: چشمت چه کار خواهد کردن؟او، آبزن خاک درت خواهد بود!(@)(@)PageV01P432(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0436.jpg)(@)(@)(@@)(@@)(@@) | خالد(@)(@@) ~~2655 کودل، که زعشق بر سرش خاکی نیست؟ بر دامن جانش، زغمت چاکی نیست؟(@)(@@) (@@) در کوچهآ عاشقانت، بنمای مرا %~% کنجی، که در او نشسته غمناکی نیست!(@)(@@)(@@)(@@) | ناضر(@)(@@) ~~265 برخیز، که عاشقان به شب راز کنند 
ms266	 گرد در و بام دوست، پرواز کنند(@)(@@) (@@) هر در که بود، جمله به شب در بندند %~% الآ در عاشق، که به شب باز کنند(@)(@@)(@@)(@@) | رشید وطواط(@)(@@) (@@) 2657 در دل، زغم عشق توناری دارم %~% وز آب دو دیده، پر کناری دارم(@)(@@) (@@) یا اینهمه همچوباد، گاه و بیگاه %~% با خاک سر کوی تو، کاری دارم(@)(@@)(@@)(@@) | شجاسی(@)(@@) ~~2658 هر خسته، که او عاشق روی توشود وان گرد، که از خاک وی انگیزد(@)(@@) باد %~% هم رقص کنان، با سر کوی تو شود! %~% در خاک لحد، به آرزوی توشود(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2659 ای دل، نفسی مرا به غم یاری کن %~% وان صحبت رفته را، وفاداری کن(@)(@@) (@@) امشب، به سر کوی نگارم با من %~% بنشین، به موافقت دمی زاری کن(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2660 دوش آمده بودم به درت، خشم آلود تا بر در تو حلقه بجنبانم، زود(@)(@@) (@@) چون دست فراز بردم و، حلقه نبود %~% معلومم شد، که حلقه من خواهم بود!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2661 آن کو در غم گشاد، من بودم من %~% در دام بلا فتاد من بودم، من(@)(@@) (@@) وان کس، که سر از هزار بالش برداشت %~% بر خاک درت نهاد، من بودم من(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2662 آن کو در دل شکست، من بودم من %~% وان کو در توبه بست، من بودم من(@)(@@) (@@) وان کو، به سرانگشت ادب نیمشبی %~% میزد دریار مست، من بودم من PageV01P433(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0437.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2663 آن کس که غم تو خورد، من بودم من %~% و آهنگ در تو کرد، من بودم من(@)(@@) (@@) وان کس، که چوحلقه بر درت سر می زد %~% نالان نالان به درد، من بودم من(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2664 آن کو صفت تو گفت، من بودم من %~% در هوس تو سفت، من بودم من(@)(@@) (@@) وان کو، شب دوش زآتش دل همه شب %~% وله %~% بر خاک در توخفت، من بودم من(@)(@@) (@@) 2665 تا جان دارم، روی بعه روی تو کنم %~% جان، در سر کار جست و جوی تو کنم(@)(@@) (@@) کعبه ست مرا کوی تو 
ms267	 و، من دایم %~% شب تا به سحر، طواف کوی تو کنم(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2626 در کوی نگار خود، نمی یارم گشت پیرامن کار خود، نمییارم گشت(@)(@@) (@@) شب تا به سحر، کوی به کومی گردم %~% گرد در یار خود، نمی یارم گشت!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2667 ای دل غم کارمن، به من بازگذار %~% کارتن زار من، به من بازگذار(@)(@@) (@@) وی باد، به کوی یار من بر مگذر %~% خاک در یار من، به من بازگذار(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2668 جانم، به غم فراق تو خواهد مرد %~% در آتش اشتیاق تو، خواهد مرد(@)(@@) (@@) وز آرزوی آب حیات وصلت %~% بر خاک در وثاق تو، خواهد مرد(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2669 دوش، از هوس تو دست بر سر ماندمدر کوی تو، ببا دلی چواخگر ماندم(@)(@@) ~~از بس که زدم چوحلقه، سر بر در تو دور از رویت، چو حلقه بر در ماندم(@)(@@) (@@) 2670 این بار فراق، پای بندی دگر است %~% وله %~% در گردن من صبر، کمندی دگر است(@)(@@) (@@) این آمدن خیال، هر شب بر من %~% از گردش چرخ، ریشخندی دگر است!(@)(@)PageV01P434(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0438.jpg)(@)(@)(@@)(@@)(@@) | نمط سی وهشتم(@)(@@)(@@)(@@) | در خیال معشوق(@)(@@)(@@)(@@) | سلطان طغرل(@)(@@) ~~2671 ای گشته چو من، هزار در پای غم وی غرقه چومن، بسی به دریای غمت(@)(@@) (@@) ویران مکن این دیده و دل، زآتش و آب %~% کاین جای خیال توست، وان جای غمت(@)(@@)(@@)(@@) | عبدالرزاق(@)(@@) (@@) 2676 دل رفت، که بود یاد گاری آخر %~% تن سوخت، که آمدی به کاری آخر(@)(@@) (@@) جان را بگذار، گر خیال تو شبی %~% وله %~% تشریف دهد، بود نثاری آخر!(@)(@@) ~~جانی دارم، که گر به من نپسندی 267 تن کو؟ که بدو ناز و دلال تو کشم(@)(@@) %~% یا دل، که غم هجر و وصال تو کشم! %~% آن نیز، شبی پیش خیال تو کشم!(@)(@@)(@@)(@@) | اوحد کرهانی(@)(@@) ~~در وقت سحر، خیال جان افزایت 267 دوش از غم تو، تن و توانم شده بود(@)(@@) %~% لغیره %~% گر زانکه نمی رسید، جانم شده بود! %~% صبر از دل و، هوش از روانم شده بود(@)(@@) ~~267 دوشینه، 
ms268	 شبی که کرد پرغالیه طشت بر من زشبیخون غمت، حال بگشت(@)(@@) (@@) از خواب خوش، آب دیده را پل بستم %~% چندانکه، خیالت به سلامت بگذشت!(@)(@@)(@@)(@@) | کافی همدانی(@)(@@) ~~شب خواب- بدانکه تا خیالت بینم 267 با وصل توام، زر و درم در نگرفت(@)(@@) %~% با هجر توام، زور و ستم در نگرفت %~% می خواستم از خداو، هم در نگرفت(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2677 دل، گر چه امید وصل کمتر دارد اندوه تو را، به ناز در بر دارد(@)(@@) (@@) هر جا که رسد، مردمک دیدهآ من %~% از شکر خیال تو، زبان تر دارد!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 2678 اکنون که شد از دست من، ای نوشین لب %~% وصل تو که جان من بدو داشت طرب(@)(@@) (@@) جبان من و، تیمار فراقت همه روز %~% دست من و، دامن خیالت همه شب!(@)(@)PageV01P435(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0439.jpg)(@)(@)(@@)(@@)(@@) | اله(@)(@@) ~~2679 دل گرچه همه ساله جمالت خواهدوآید به برتو، تا وصالت خواهد(@)(@@) (@@) این بار، به خدمت توزان آمد دل %~% الغیره %~% تا عذر قدمهای خیالت خواهد(@)(@@) (@@) 2680 در عشق تو، جان از ستمی خالی نیست %~% دل نیز، ز هر گونه غمی خالی نیست(@)(@@) (@@) ای چشم و چراغ، تا برفتی ز برم %~% چشمم، زخیال تو دمی خالی نیست!(@)(@@)(@@)(@@) | ابوالحسن طلحه(@)(@@) (@@) 2281 در هجرتو، کام دل بتا کم دارم %~% زان بیش که تو گمان بری، غم دارم(@)(@@) (@@) وزآرزوی خیال رویت، همه شب %~% بی خواب، نهاده چشم بر هم دارم(@)(@@)(@@)(@@) | جهان گشته(@)(@@) (@@) 2682 دوش، از دلم آه بر ثریا می شد %~% وز دیدهآ من، دجله به دریا می شد(@)(@@) (@@) تا روز، به پیش چشم اندیشهآ من %~% یا می آمد خیال او یا می شد(@)(@@)(@@)(@@) | سجاسی(@)(@@) (@@) 2683 تا کی ز فراق، دیده پر خون بینم؟ %~% وز کاهش جان، درد دل افزون بینم؟(@)(@@) (@@) گویند: خیال او همی بین در خواب %~% خوابم ناید، خیال او چون بینم؟(@)(@@) (@@) 2684 خواب از چشمم ز ریزش آب برفت %~% وله %~% سرتیزی سیل دید، بشتاب برفت(@)(@@) (@@) آسایشم، از خیال جانان بودی 2285 بی وصل تو، هرجا که دمی 
ms269	 بنشینم %~%(@)(@@) وله %~% از هجر رخت، به ماتمی بنشینم %~% دردا، که خیال نیز با خواب برفت!(@)(@@) (@@) آزادی و شادی، از خیالت کردم %~% در هر وطنی، که با غمی بنشینم!(@)(@@) ~~2686 یاری، که به خواب بی طلب شاید یافت خفتم، مگرش بدین سبب شاید یافت!(@)(@@) (@@) در خواب شدم، خیالش آمد که: مخسب! %~% معشوقه، به بیداری شب شاید یافت!(@)(@)PageV01P436(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0440.jpg)(@)(@)(@@)(@@)(@@) | مهذب شروانی(@)(@@) ~~دوشش دیدم، که دلنوازی می کرد 2687 یاری، که همیشه سرفرازی می کرد(@)(@@) %~% معزی %~% اما به خیال عشقبازی می کرد %~% بر دل، غم او دست درازی می کرد(@)(@@) (@@) 2688 هر شب غم تو، به مه اشارت کندم %~% وز چشم پر آب، خواب غارت کندم(@)(@@) (@@) بک شب نگذارد، که کنم دیده فراز %~% وله %~% چندان که خیال تو زیارت کندم!(@)(@@) (@@) 2685 باز آنکه دلم به وصل خرم نکند یداری را گذاشت بر دیدهآ من %~%(@)(@@) تا دل، طمع خیال او هم نکند! %~% یک زخم مرا، به وعده مرهم نکند(@)(@@)(@@)(@@) | طغرل(@)(@@) (@@) 269 ای انده تو معتکف سینهآ دل %~% سودای تو، نازنین دیرینهآ دل(@)(@@) ~~269 در عشق، چوشد زمن نهان خواب خوشم زنجیر هوس می گسلد جان، از شوق(@)(@@) %~% خلیل %~% تا دید خیال تو، در آیینهآ دل! %~% چون باز آید به عمری، آن خواب خوشم(@)(@@) (@@) در حال، خیال تو به آمد شدنی %~% بیدار کند، ناگه از آن خواب خوشم(@)(@@)(@@)(@@) | کمال ابن العزیز(@)(@@) (@@) 269 دوش، آنکه ز من جمال پنهانی داشت %~% در ملک نکویی، سر سلطانی داشت(@)(@@) (@@) این مردمک چشم برهنه [که] مراست %~% تشریف خیال خویش ارزانی داشت!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~269 دی شب، که ز ناله پرده سازی کردم با لعبتک حسن تو، در پردهآ خواب(@)(@@) %~% وله %~% تا وقت سحر خیالبازی کردم! %~% در کوی فراق، دلنوازی کردم(@)(@@) ~~نقشی زخیال تو، نمی گردد محو 269 زین دیده، که بی نور رخت درتاب است(@)(@@) %~% با آنکه بدو بر، گذر سیلاب است %~% وزجمله جهانش آرزو، یک خواب است PageV01P437(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0441.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2695 بایایی خواب، چشم من جمله بسوخت %~% وز اشک 
ms270	 به تاب، چشم من جمله بسوخت(@)(@@) (@@) و امشب، زخیال روی چون آتش دوست %~% با اینهمه آب، چشم من جمله بسوخت(@)(@@) (@@) 2696 ای کار غمت با دل من راست شدن %~% الغیره %~% وی پیشهآ من، از تو کم و کاست شدن(@)(@@) (@@) دوشینه، خیال سوی چشمم بگذشت %~% بگریخت، وگرنه غرق خون خواست شدن!(@)(@@) (@@) 2697 ای دل، تو که باشی که وصالش جویی؟ %~% الغیره %~% یا نیز، حدیث زلف وخالش گویی؟(@)(@@) (@@) این مایه تو را نه بس، که هر شب تا روز %~% خاک سم مرکب خیالش بویی!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2697 ای کار خطت، مشک طرازی کردن %~% و آیین لبت، بنده نوازی کردن(@)(@@) (@@) کردم شب دوش با خیالت بازی %~% در شب شاید، خیالبازی کردن!(@)(@@) (@@) 2699 بیداری شب، جان مرا گر چه بکاست %~% لغیره %~% جزبیداریم زروی انصاف خطاست(@)(@@) (@@) ترسم، که خیال او شبی رنجه شود %~% عذر قدمش، به سالها نتوان خواست!(@)(@@) (@@) 2700 چشمم، که به گریه آب دریا ببرد %~% لغیره %~% شب تا به سحر، ستاره زان می شمرد(@)(@@) (@@) ترسد، که خیال دوست تشریف دهد %~% بیند در حجره بسته، اندر گذرد!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2701 گر دل طلبم، در خم مویش بینم %~% ورجان طلبم، برسر کویش بینم(@)(@@) ~~در غایت تشنگی، اگر آب خورم در کوزه، همان خیال رویش بینم(@)(@@) (@@) 2702 ای تو کم من گرفته، در عالم خویش %~% وی من به موافقت گرفته، کم خویش(@)(@@) (@@) بفرست خیال خویش، یک شب بر من %~% تا پیش خیال تو، بگویم غم خویش!(@)(@@) (@@) 27033 تا فرقت تو، زچشم من خواب ربود %~% در دیدهآ من، خیال تو آب فزود(@)(@@) (@@) خون جگر، از دیده نیارم پالود %~% ترسم، که خیال تو شود خون آلود!(@)(@)PageV01P438(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0442.jpg)(@)(@)(@@) (@@) 2700 بگسست ز صحبت من، آن دلگسلم %~% مالید به زیر پای محنت، چو گلم(@)(@@) (@@) هر شب، آید خیال او پیش دلم %~% الحق، ز مراعات خیالش خجلم(@)(@@) ~~شب خواهم، شب، که هرشب از روضه خلد 4705 من روز نخواهم، که محالت(@)(@@) شنوم %~% آوازهآ مرکب خیالت شنوم %~% وز دشمن خود، لاف وصالت شنوم!(@)(@@)(@@)(@@) | رشید 
ms271	(@)(@@) (@@) من متهمم، شرح نمییارم گفت 270 کارم، شب دوش بی توشیون بودهست %~%(@)(@@) اوله %~% بررس زخیال خود، که با من بوده ست! %~% جان، از در بخشایش دشمن بودهست(@)(@@) (@@) 2701 دوش آمده بد، خیال روح افزایش %~% در حجرهآ جان بود همه شب، جایش(@)(@@) (@@) یش رخ خوب آفتاب آسایش %~% اوله %~% چون سایه فتاده بودم، اندر پایش(@)(@@) (@@) تا نیمشبی خیل خیال تورسید (270 سودای توام، در جنون می زد دوش %~%(@)(@@) له %~% ورنه، جانم خیمه برون می زد دوش! %~% دریای دو دیده، موج خون می زد دوش(@)(@@) ~~خون گشت دلم، تا که خیال تودر اوست 271 هرشب که خیال جان وشت راز کند(@)(@@) 270 چشمی، ز جفای تو پر اختر دارم گیرم که توناز می کنی، وررسدت %~% اوله(@)(@@) %~% اوله %~% دستی، زغم هجر تو بر سر دار %~% زانش همه ساله، تنگ در بر(@)(@@) دارم! %~% با من زنخست ناز آغاز کند %~% در خواب، خیال تو چرا ناز کند؟(@)(@@) ~~صد گونه نوازش از خیالت، در خواب 2711 در کوی غمت، به سردو یدم همه(@)(@@) عمر %~% دیدم، که یکی از تو ندیدم همه عمر! %~% بار غم تو، به جان کشیدم همه عمر(@)(@@) (@@) 2712 پیوسته، رهی وصال تو می جوید در روز، دلش جمال تومی طلبد %~% در(@)(@@) شب، جانش خیال تومی جوید! %~% وزعارض مه، مثال تومیی چوید PageV01P439(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0443.jpg)(@)(@)(@@)(@@)(@@) | نمط سی ونهم(@)(@@)(@@)(@@) | در افعال مختلف معشوق(@)(@@)(@@)(@@) | در گرمابه شدن(@)(@@) (@@) 2713 دارد بتم امروز، به گرمابه شتاب %~% رایی است مرا درین سخن، سخت صواب(@)(@@) (@@) ای عشق، دلم به آتش تیز بتاب %~% وی دیده، تو گرم کن بدان آتش آب!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2714 امروز، به گرمابه چو سر در کردم %~% او را دیدم، زعیش افسر کردم(@)(@@) (@@) حالی که به دست شانه دیدم زلفش %~% گل کردم خاک را و، بر سر کردم!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 21715 رشک آیدم از شانه و سنگ، ای دلجوی %~% زان رشک، زدیده ها روان دارم جوی(@)(@@) (@@) کان، بر سر زلف تو چرا یازد دست؟ %~% و ین، در کف پای تو چرا 
ms272	 مالد روی؟(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2716 در حمامی و، خانهآ معتدلی %~% با جانانی، ز دلبران چگلی(@)(@@) (@@) می شوی زدل دست، به آب دیده %~% می مال زخاک پاش، سر را به گلی!(@)(@@)(@@)(@@) | موی شانه کردن(@)(@@) ~~2717 تا حسن رخت، به عالم افسانه شدهستدل در طلبت، زخویش بیگانه شدهست(@)(@@) (@@) چون آینه، رونمای عالم شدهای %~% زان، زلف تو انگشت کش شانه شدهست!(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~2718 در عشق تو، هر سوی همی باید رفت چون اشک، به هر روی همی باید رفت(@)(@@) ~~در خدمت زلفین تو، همچون شانه شرطی است، که برموی همی باید رفت(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~271 شانه، که زچین زلف مشک افشانشهر لحظه، کنی به غالیه پنهانش(@)(@@) ~~زلف تو، چندان سردندان بنمودکاندر سر زلفین توشد، دندانش(@)(@@)(@@)(@@) | یضا(@)(@@) (@@) 272 دلدار، به حمام شد از مستی خواب %~% ای دیده ودل، خدمت او را دریاب(@)(@@) (@@) ای ول، تو برو آتش گرمابه بتاب! %~% وی دیده، به رسم خویش می ریز تو آب!(@)(@)PageV01P440(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0444.jpg)(@)(@)(@@) (@@) 221 زلف تو، که بر ماه قرار است اورا %~% ایضا %~% با شانه، نگویی چه شمار است او رام(@)(@@) ~~زین پس، من وشانه و خصومت با او تا، با سر زلف تو چه کار است او را؟(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~چندان به هوای سر زلفت می بود 2721 شانه، خود را چو از در زلف تو کرد(@)(@@) %~% کآخر، سر خویش در سر زلف تو کرد! %~% هر کار که کرد، در خور زلف تو کرد(@)(@@)(@@)(@@) | عرق کردن(@)(@@) ~~272 تا بر رخ چون گلت، پدید است عرق در ابر، شنیدهام که باران باشد(@)(@@) %~% از شرم رخت، زگل چکیدهست عرق %~% بر چهرهآ خورشید، که دیدهست عرق؟(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2728 ای چاک ز سودای تو پیراهن گل %~% خوشبوست گریبان تو، چون دامن گل(@)(@@) (@@) ازنازکیت، عرق براندام لطیف %~% چون قطرهآ شبنم است، پیرامن گل!(@)(@@)(@@)(@@) | گلاب افشاندن(@)(@@) ~~تا آب نشد بر آتش، از شرم رخت 2746 گل را چه محل؟ که رویت ای حورنژاد(@)(@@) %~% می نتوانست، بوسه بر دست توداد! %~% بیرون کند از سر گل سوری 
ms273	 باد(@)(@@)(@@)(@@) | سلاح پوشیدن(@)(@@) (@@) 272 زلفش دیدم، به جنبش باد اندر %~% همچون حرکت، به شاخ شمشاد اندر!(@)(@@) (@@) در جامهآ کار زار، می تافهت رخش %~% همچون گوهر، به مغز پولاد اندر!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2727 می آمد، پرخنده چودشت از لاله %~% می رفت بر آسمان زجانم، ناله(@)(@@) (@@) از بار سلاح و گرد موکب، گشته %~% رویش عرق آلود، چوبرگ از ژاله(@)(@@)(@@)(@@) | در باز به دست گرفتن(@)(@@) ~~ر دست گرفت باز، تا جان شکرد 272 ترکی، که جهان به غمزهآ مست گرفت(@)(@@) %~% این شیوه نگر، که باز بر دست گرفت! %~% دلهای همه، به زلف چون شست گرفت(@)(@@)(@@)(@@) | رگ زدن PageV01P441(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0445.jpg)(@)(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2730 فصاد، به نیش آبگون از دستت %~% بگشاد ره بستهآ خون از دستت(@)(@@) (@@) از دست تو، کس زنده نجست، الآخون %~% وان نیز، به زخم شد برون ازدستت(@)(@@)(@@)(@@) | نماز وروزه(@)(@@) (@@) 2731 ای گلرخ سرو قد، ای مایهآ ناز %~% بر تو زنماز و روزه، رنجی است دراز(@)(@@) (@@) چندین، به نماز و روزه تن را مگداز %~% ایضا %~% بر مه نبود روزه و، بر سرو نماز!(@)(@@) (@@) 2732 آمد رمضان و، من شدم چون کاهی %~% وز رنج، دلم گشت چو آتشگاهی(@)(@@) (@@) هر دم، زمیان جان برآرم آهی %~% ایضا %~% کان ماه، چگونه روزه دارد ماهی!(@)(@@) (@@) 2733 رخ را، ز برای دلفروزی داری %~% غمزه، زبرای سینه سوزی داری(@)(@@) (@@) تا روزه گرفته ای، نکوتر شدهای %~% ای ماه، ز روزه نیز روزی داری!(@)(@@)(@@)(@@) | در عید کردن(@)(@@) ~~2734 جانا، به کدام دست برخاسته ای(@)(@@) (@@) خوبان دگر، به عید روی آرایند %~% ایضا %~% تو، عید به روی خویش آراسته ای!(@)(@@) (@@) 2735 ای دوست، بیاو تکیه بر جانم کن %~% عید است، به عید روزه مهمانم کن!(@)(@@) (@@) این عید، زکات لب به من بوسی ده %~% ایضا %~% وان عید دگر، بیا و قربانم کن!(@)(@@) (@@) 2736 جانا، رحمی برین دل وجانم کن %~% در کار سر زلف پریشانم کن!(@)(@@) (@@) در آرزوی روی خوش چون عیدت %~% از کیش برآمدم، به قربانم کن!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 27737 عید است، هزار چاره خواهم کردن %~% وزعید، به 
ms274	 تو نظاره خواهم کردن(@)(@@) (@@) تو جامهآ نوپوش، که من از دستت %~% این کهنهآ خویش، پاره خواهم کردن!(@)(@@)(@@)(@@) | درماه جستن(@)(@@) (@@) 273 از بهر هلال عید، خورشید سپاه %~% بر بام، ز هر سوی [همی] کرد نگاه(@)(@@) (@@) ماندم به شگفت از او، که سبحان الله! %~% خورشید بر آمدهست و، می جوید ماه!(@)(@)PageV01P442(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0446.jpg)(@)(@)(@@) ~~2739 گر مه طلبان، شوند گردون پیمای توماه نوی به حسن، ای شهر آرای(@)(@@) %~% ایضا %~% تامه طلبند بهر عید، از هرجای %~% در آینه بین، عید کن و، روزه گشای!(@)(@@)(@@)(@@) | در حنا بستن(@)(@@) (@@) 274 یاری، که چو مه چهرهآ زیبا دارد وز خون من دلشدهآ خسته جگر %~%(@)(@@) چون سرو سهی، قامت و بالا دارد %~% آن سرخی دستش، ید بیضا دارد(@)(@@) ~~دود دل من، در آمده گرد رخش (274 دلبسته مرا، به زلف چون شستش بین(@)(@@) 274 ای دام دل من شده، زلف شستت. خون دل من ریخته ای دوش، ارنه %~% ایضا(@)(@@) %~% یضا %~% هشیاری عقل من، زچشم مستت %~% جان خسته مرا، زنرگس مستش بین(@)(@@) %~% خون جگرم، ریخته بر دستش بین %~% امروز، چنان سرخ چرا شد دستت؟(@)(@@)(@@)(@@) | در پتک زدن(@)(@@) ~~هرگز تو، که را گرفته ای دست به وصل 274 دوش، از سر خشم تیره رایی(@)(@@) زدهای %~% یضا %~% کاو را چو پتک، نه پشت پایی زدهای؟ %~% کامروز، به خون من هوایی زدهای(@)(@@) (@@) 2744 روزی، که من از بهر تو در بازم سر %~% آن روز، زخرمی برافرازم سر(@)(@@) ~~تا بوک یکی بوسه دهم، برپایت 2744 در پای غمت فتاده ام، چون پتکت(@)(@@) ور من، شرف بوسهآ پایت یابم %~% ایضا %~% هر دم، چو پتک سوی فلک بازم سر(@)(@@) %~% و فرق سر ایستادهام، چون پتکت %~% بر زخم تودل نهادهام، چون پتکت(@)(@@)(@@)(@@) | در کمان گشودن(@)(@@) (@@) 27،3 ترکم چو کمان کشید، کردم نگهش مه بود رخش، عقرب زلف سیهش %~%(@)(@@) ایضا %~% مه دیدم و قوس وعقرب، اندر کشهش %~% از عقرب در قوس همی رفت، مهش(@)(@@) (@@) 27 جانا، چوزه کمان به دوش تو رسد %~% سرخی، به لب شکر فروش 
ms275	 تو رسد(@)(@@) (@@) گویی، زگس ازدی نم ناد %~% زیره بهفدجهد، به گوس تورسد.(@)(@)PageV01P443(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0447.jpg)(@)(@)(@@) بهی ومافان ممشون(@)(@@) در کیش وقربان بستن(@)(@@) ~~2748 چون زور کمان، بر بر و دوش تورسید تیرش، به لب چشمهآ نوش تورسید(@)(@@) (@@) گویی، زهش از حدیث من بافته بود %~% یضا %~% زیرا که به صد جهد، به گوش تو رسید!(@)(@@) (@@) 2749 ترکم، سوی آماج که آمد سر مست %~% چون غمزهآ او، تیر و کمان اندر دست(@)(@@) (@@) هر تیر، که از خودش چومن دور انداخت %~% ایضا %~% نالان نالان برفت و، در خاک نشست(@)(@@) (@@) 2750 تا در غم عشق، زار و حیران گشتیم %~% زاهد بودیم، نابسامان گشتیم!(@)(@@) (@@) از بهر بتی، که کیش و قربان دارد %~% از کیش برآمدیم و، قربان گشتیم!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2751 هرگه که توم نعل اسب یکران بندی %~% داغی دگرم، بر دل و بر جان بندی(@)(@@) (@@) قربان شومت پیش، چو بگشایی کیش %~% وز کیش برون شوم، چوقر بان بندی!(@)(@@)(@@)(@@) | درتیرانداختن(@)(@@) (@@) 2752 گر مهر خموشی، ز زبان برگیری %~% بار غمم، از گردن جان برگیری(@)(@@) (@@) قربان تو گردم، چوتو تیراندازی %~% وز کیش برآیم، چو کمان برگیری!(@)(@@) درطاق وجفت(@)(@@) (@@) 2753 آن طاق بتان، که سازمش دیده وثاق %~% زان پس که مرا نخواست، جز جفت فراق(@)(@@) (@@) ابروی به طاق و جفت نرگس بنمود %~% پس گفت مراکه: ««جفت خواهی یاطاق؟))(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2754 آن طاق، که نیست جفت او در آفاق %~% ««جفتا طاقا» بباخت با ما، به وثاق(@)(@@) (@@) س گفت مراکه: «رطاق خواهی یاجفت؟» %~% گفتم: به توخفت، وزهمه عالم طاق!(@)(@@)(@@)(@@) | کبوتر باختن(@)(@@) ~~2755 مضراب ززلف و، نی زقامت سازی در شهر، تو را رسد کبوتر بازی(@)(@@) (@@) دلها چو کبوترند در سینه، طپان %~% تا تو، نی عشق در کدام اندازی؟(@)(@@)(@@)(@@) | شعر گفتن(@)(@@) ~~275 شاعر پسری تو، ای دلارام پدرهر بیت تو، گوهری است بسیار خطر(@)(@@) (@@) سنگ است دلت، توآفتاب ای دلبر %~% در سنگ، زآفتاب آید گوهر!(@)(@)PageV01P444(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0448.jpg)(@)(@)(@@)(@@)(@@) | برپای ایستادن(@)(@@) (@@) 2752 بر پای ستادن تو، ای شمع سرای %~% پیش هر کس، مرا در