ms7501	 وروى عنه محمد بن عبد الجبار.(@)(@@) الروضة: ح 272.(@)(@@) * وروى عن حسان، وروى عنه أحمد.(@)(@@) ابن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 10، ح 4.(@)(@@) * وروى عن الحسن بن الحسين اللؤلؤي، وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 6، ح 1117.(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 6، ح 250.(@)(@@) * وروى عن الحسن بن علي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 13.(@)(@@) * وروى عن حفص بن أبي عائشة، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 50.(@)(@@) * وروى عن حماد، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 111، ح 2، و ج 4، ك 3، ب 32، ح 3، و ب 34، ح 3.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 196. PageV24P336(@)(@@) * وروى عن حماد بن عثمان، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 8، ب 45، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 3، ح 170.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 3، ح 877.(@)(@@) * وروى عن داود بن أبي يزيد.(@)(@@) الفقيه: ج 3، ح 854.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 28، ح 42، و ج 7، ك 6، ب 9، ح 6.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 105، ح 8، و ك 4، ب 2، ح 5.(@)(@@) وروى عنه موسى بن عمر.(@)(@@) الكافي: ج 5، ك 2، ب 49، ح 7.(@)(@@) * وروى عن داود بن فرقد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 4، ب 23، ح 14.(@)(@@) وروى عنه محمد.(@)(@@) الروضة: ح 253.(@)(@@) * وروى عن صالح بن السندي، وروى عنه علي بن إبراهيم.(@)(@@) التهذيب: ج 10، ح 606.(@)(@@) * وروى عن صفوان، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1439.(@)(@@) * وروى عن صفوان الجمال، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 9، ب 4، ح 8.(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 6، ك 9، ب 4، ح 2.(@)(@@) * وروى عن عاصم بن حميد، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 146، ح 4.(@)(@@) * وروى عن عبد الصمد بن بشير، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 4، ك 3، ب 225، ح 2.(@)(@@) والتهذيب: ج 3، ح 746.(@)(@@) * وروى عن عبد الله، وروى عنه 
ms7502	 أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 729.(@)(@@) * وروى عن عبد الله بن بكير، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 305 (الإستبصار:(@)(@@) ج 1، ح 1231).(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 6، ك 8، ب 67، ح 3.(@)(@@) * وروى عن عبد الله بن الوليد PageV24P337(@)(@@) الكندي، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 3، ك 4، ب 84، ح 27.(@)(@@) والتهذيب: ج 2، ح 473 (الإستبصار:(@)(@@) ج 1، ح 1019).(@)(@@) * وروى عن عبيد بن إسحاق، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 2، ب 60، ح 3.(@)(@@) والتهذيب: ج 7، ح 45.(@)(@@) * وروى عن العلا، وروى عنه أحمد.(@)(@@) التهذيب: ج 2، ح 1580.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 37، ح 14، والروضة: ح 68.(@)(@@) * وروى عن العلاء بن رزين، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 142.(@)(@@) * وروى عن علي بن أسباط، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 224، ح 2.(@)(@@) * وروى عن علي بن الحكم، وروى عنه يعلى بن حمزة.(@)(@@) التهذيب: ج 3، ح 706.(@)(@@) * وروى عن علي بن شجرة، وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 3، ك 3، ب 40، ح 4، و ب 44، ح 3. والتهذيب: ج 1، ح 904.(@)(@@) * وروى عن علي بن عقبة، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 7، و ك 3، ب 13، ح 3. والتهذيب: ج 7، ح 8.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 72، ح 8، و ك 4، ب 2، ح 5، و ب 23، ح 14.(@)(@@) وروى عنه سهل.(@)(@@) الكافي: ج 2، ك 3، ب 8، ح 11.(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 7.(@)(@@) * وروى عن علي بن محمد بن عبد الرحمان، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 7، ك 3، ب 63، ح 29.(@)(@@) * وروى عن علي بن يعقوب الهاشمي، وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 2، ك 4، ب 4، ح 11.(@)(@@) * وروى عن غالب، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 28، ح 35.(@)(@@) * وروى عن غالب بن عثمان، وروى عنه أحمد بن محمد، ومحمد بن عبد الجبار. PageV24P338(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 7.(@)(@@) * وروى عن غالب بن محمد، وروى عنه 
ms7503	 أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 136، ح 2.(@)(@@) * وروى عن القاسم بن محمد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 54، ح 1.(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 80، ح 4.(@)(@@) * وروى عن بعض أصحابنا، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 168، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 649.(@)(@@) * وروى عن بعض أصحابه، عن أبي حمزة الثمالي، وروى عنه العباس بن معروف.(@)(@@) الكافي: ج 5، ك 2، ب 63، ح 3.(@)(@@) * وروى عن بعض أصحابه، عن أبي عبد الله عليه السلام، وروى عنه صالح.(@)(@@) الروضة: ح 364.(@)(@@) * وروى عن رجل من أهل المدينة، عن المطر في، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 122، ح 11.(@)(@@) * وروى عن غير واحد من أصحابنا، عن أبي عبد الله عليه السلام، وروى عنه أبو طاهر يعني الوراق.(@)(@@) التهذيب: ج 6، ح 136.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 127، ح 1.(@)(@@) * وروى عمن ذكره، عن أحدهما عليهما السلام، وروى عنه صالح بن أبي حماد.(@)(@@) الكافي: ج 2، ك 3، ب 13، ح 20.(@)(@@) (الحلبي) * روى عن أبي جعفر وأبي عبد الله عليهما السلام. وروى عنه أبو جميلة.(@)(@@) الكافي: ج 6، ك 7، ب 17، ح 2، و ب 18، ح 7. والتهذيب: ج 9، ح 471.(@)(@@) وروى عنه حماد بن عثمان.(@)(@@) الكافي: ج 3، ك 3، ب 55، ح 3.(@)(@@) والتهذيب: ج 3، ح 438 (الإستبصار:(@)(@@) ج 1، ح 1847).(@)(@@) * وروى عن أبي عبد الله عليه السلام. PageV24P339(@)(@@) الفقيه: ج 1، ح 183، و 184، و 185، و 186، و 430، وذيل ح 432، و 471، 729، و 818، و 933، و 938، 997، و 999، و 1015، و 1019، و 1040، و 1069، و 1070، و 1075، و 1141، و 1149، و 1156، و 1179، و 1197، و 1198، و 1212، و 1227، و 1232، و 1315، و 1467، و 1472، و 1477، و 1489، و 1533، و 1574، و ج 2، ح 67، و 286، و 287، و 318، و 338، و 360، و 393، و 399، و 412، و 417، و 427، و 516، و 517، و 529، و 728، و 752، و 934، و 940، و 943، و 962، و 968، و 995، و 1020، و 1055، و 1070، و 1262، و 1486، و ج 3، ح 549، و 
