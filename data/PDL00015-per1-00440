ms421	 ماهرویان توبه‌ها را بشکنیم(@)(@@) 3 همچو عیاران همی ریزیم اندر جام جان %~% بهر جان چون آسیا تا چند گرد تن تنیم(@)(@@) 4 گرد صحرای قدم پوییم چون تر دامنان %~% زین هوس خانه هوا تا کی نه ما اهریمنیم(@)(@@) 5 دیده جانهای ما هرگز نبیند مامنی %~% تا چو یک چشمان دلی پر دعوی ما و منیم(@)(@@) 6 مجرم و محروممان دارند تا ما غمروار %~% بسته این طارم پیروزه بی‌روزنیم(@)(@@) 7 گردنی بیرون کنیم از سر و گرنه تا ابد %~% بیشتر حمال سر خوانندمان گر گردنیم(@)(@@) 8 آروزها را برون روبیم از دل کارزو %~% شیوه آبستنانست و نه ما آبستنیم(@)(@@) 9 رشته تابی هم نیابد ره به ما زیرا که ما %~% نه درین ره تنگ چشم و تنگ دل چو سوزنیم(@)(@@) 10 عاقبت ما را گریبان‌گیر ناید زان که ما %~% نی چو مشتی خشک مغز بوالطمع تر دامنیم(@)(@@) 11 برکنیم از بوستان نطق بیخ صوت و حرف %~% تا شویم آزاد و انگاریم شاخ سوسنیم(@)(@@) 12 جام فرعونی به کف گیریم و پس موسی نهاد %~% هر چه فرعونیست در ما بیخش از بن برکنیم(@)(@@) 13 از درون سالوسیان داریم به گر یکدمی %~% خرقه سالوسیان را بخیه بر روی افگنیم(@)(@@) 14 گر چه نااهلانمان چون سیم بد بپرا کنند %~% ما چو سیماب از طریق خاصیت بپراکنیم(@)(@@) 15 در زنیم آتش سنایی وار در هر سوخته %~% کز در معنی نه ما کمتر ز سنگ و آهنیم PageV1P0557(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا کی دم از علایق و طبع فلک زنیم %~% تا کی مثل ز جوهر دیو و ملک زنیم(@)(@@) 2 تا کی غم امام و خلیفه جهان خوریم %~% تا کی دم از علی و عتیق و فلک زنیم(@)(@@) 3 دوریم از سماع و قرینیم با صداع %~% تا ما همی سقف به نوای سلک زنیم(@)(@@) 4 هرگز نبوده دفتر و دف در مصاف عشق %~% تیر امید کی چو شهان بر دفک زنیم(@)(@@) 5 تا کی ز راه رشک 
ms422	 برین و بر آن رویم %~% بهر گل و کلاله خوبان کلک زنیم(@)(@@) 6 تا کی به زیر دور فلک چون مقامران %~% از بهر برد خویش دم لی و لک زنیم(@)(@@) 7 دست حریف خوبتر آید که در قمار %~% شش پنج نقش ماست همین ما دو یک زنیم(@)(@@) 8 یک دم شویم همچو دم آدم و چنو %~% اندر سرای عشق دمی مشترک زنیم(@)(@@) 9 آن به که همچو شعر سنای گه سنا %~% میخ طناب خیمه برون از فلک زنیم(@)(@@) 10 بر یاد روی و موی صنم صد هزار بوس %~% بر دامن یقین و گریبان شک زنیم(@)(@@) 11 گر چه ستد زمانه چک و چاک را ز ما %~% آتش نخست در شکن چاک و چک زنیم(@)(@@) 12 طوفان عام تا چکند چون بسان سام %~% خر پشته در سفینه نوح و ملک زنیم(@)(@@) 13 ای ما ز لعل پر نمکت چون نمک در آب %~% هرگز بود که زیور ما بر محک زنیم(@)(@@) 14 زین جوهر و عرض غرض ما همین یکیست %~% گر چه همی ز قهر سما بر سمک زنیم(@)(@@) 15 ما را طعام خوان خدا آرزو شدست %~% یک دم به پای تا دو سخن بر نمک زنیم PageV1P0558(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 خیز تا خود ز عقل باز کنیم %~% در میدان عشق باز کنیم(@)(@@) 2 یوسف چاه را به دولت دوست %~% در چه صد هزار باز کنیم(@)(@@) 3 در قمار وقار بنشینیم %~% خویشتن جبرییل ساز کنیم(@)(@@) 4 هر چه شیب و فراز پرده ماست %~% خاک بر شیب و بر فراز کنیم(@)(@@) 5 ز بر و زیر چرخ هرزه زنیم %~% آن به از هر دو احتراز کنیم(@)(@@) 6 جان کبکی برون کنیم از تن %~% خویشتن جان شاهباز کنیم(@)(@@) 7 به خرابات روح در تازیم %~% در به روی خرد فراز کنیم(@)(@@) 8 آه را از برای زنده دلی %~% ملک‌الموت جان آز کنیم(@)(@@) 9 ناز را از برای پخته شدن %~% هیزم آتش نیاز کنیم(@)(@@) 10 با نیازیم 
ms423	 تا همه ماییم %~% چون همه او شدیم ناز کنیم(@)(@@) 11 آلت عشرت ظریفان را %~% آفت عقل عشوه ساز کنیم(@)(@@) 12 خم زلفین خوبرویان را %~% حجره روز های راز کنیم(@)(@@) 13 در زمین بی زمین سجود بریم %~% در جهان بی‌جهان نماز کنیم(@)(@@) 14 سه شراب حقیقتی بخوریم %~% چار تکبیر بر مجاز کنیم(@)(@@) 15 از سنایی مگر سنایی را %~% به یکی باده درد باز کنیم PageV1P0559(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گاه رزم آمد بیا تا عزم زی میدان کنیم %~% مرد عشق آمد بیا تا گرد او جولان کنیم(@)(@@) 2 چنگ در فتراک این معشوق عاشق کش زنیم %~% پس لگام نیستی را بر سر فرسان کنیم(@)(@@) 3 گر برآید خط توقعیش برین منشور ما %~% ما ز دیده بر خط منشور در افشان کنیم(@)(@@) 4 از خیال چهره غماز رنگ آمیز او %~% بس به رسم حاجیان گه طوف و گه قربان کنیم(@)(@@) 5 ننگ این مسجد پرستان را در دیگر زنیم %~% چون که مسجد لافگه شد قبله را ویران کنیم(@)(@@) 6 ملک دین را گر بگیرد لشکر دیو سپید %~% ما همه نسبت به زور رستم دستان کنیم(@)(@@) 7 خاکپای مرکب عشاق را از روی فخر %~% توتیای چشم شاهان همه کیهان کنیم(@)(@@) 8 بوحنیفه‌وار پای شرع بر دنیا نهیم %~% بوهریره‌وار دست صدق در انبان کنیم(@)(@@) 9 سوز سلمان را و درد بوذری را برگریم %~% آن گه نسبت درست از سنت و ایمان کنیم(@)(@@) 10 هر چه امر سرمدی باشد به جان فرمان بریم %~% و آنچه حکم احمدی باشد به حرمت آن کنیم(@)(@@) 11 شربت لا بر امید درد الاالله کشیم %~% و آنچه آن طوفان نوح آورد در طوفان کنیم(@)(@@) 12 چون جمال قرب و شرب لایزالی در رسید %~% جامه چون عاشق دریم و شور چون مستان کنیم(@)(@@) 13 گه چو بو عمر و علا فرش قرائت گستریم %~% گه چو حسان ابن ثابت مدحت احسان کنیم(@)(@@) 14 این نه شرط مومنی باشد نه راه بی‌خودی %~% طاعت سلطان بمانده 
ms424	 خدمت دربان کنیم(@)(@@) 15 هم تری باشد که در دعوی راه معرفت %~% صورت هارون بمانده سیرت هامان کنیم(@)(@@) 16 چون عروسان طبیعت محرم ما نیستند %~% بر عزیزان طریقت شاید ار پیمان کنیم(@)(@@) 17 هر چه از پیشی و بیشی هست در اطراف ما %~% ما بر آن از دل صلای «من علیها فان» کنیم(@)(@@) 18 ای سنایی تا درین دامی مزن دم جز به عشق %~% تات چون شمع معنبر روشن و تابان کنیم(@)(@@) 19 عندلیب این نوایی در قفس اولاتری %~% چون شدی طاووس جایت منظر و ایوان کنیم(@)(@@) 20 تا ز فرمان نیاید زین قفس بیرون مپر %~% کاشکارا آن گه گردی که ما فرمان کنیم(@)(@@) 21 گر تمنای بزرگی باشدت در سر رواست %~% فقر تو افزون شود چون حرص تو نقصان کنیم PageV1P0560(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گاه آن آمد که با مردان سوی میدان شویم %~% یک ره از ایوان برون آییم و بر کیوان شویم(@)(@@) 2 راه بگذاریم و قصد حضرت عالی کنیم %~% خانه‌پردازیم و سوی خانه یزدان شویم(@)(@@) 3 طبل جانبازی فرو کوبیم در میدان دل %~% بی‌زن و فرزند و بی‌خان و سر و سامان شویم(@)(@@) 4 گاه با بار مذلت سوی آن مسجد دویم %~% گاه با رخت غریبی نزد آن ویران شویم(@)(@@) 5 گاه در صحن بیابان با خران همره بویم %~% گاه در کنج خرابی با سگان هم خوان شویم(@)(@@) 6 گاه چون بی دولتان از خاک و خس بستر کنیم %~% گاه چون ارباب دولت نقش شادروان شویم(@)(@@) 7 گاه از ذل غریبی بار هر ناکس کشیم %~% گاه در حال ضرورت یار هر نادان شویم(@)(@@) 8 گاه بر فرزندگان چون بیدلان واله شویم %~% گه ز عشق خانمان چون عاشقان پژمان شویم(@)(@@) 9 از فراق شهر بلخ اندر عراق از چشم و دل %~% گاه در آتش بویم و گاه در طوفان شویم(@)(@@) 10 گه بعون همرهان چون آتش اندر دی بویم %~% گه به دست ملحدان چون آب در آبان شویم(@)(@@) 11 
ms425	 ملحدان گر جادوی فرعونیان حاضر کنند %~% ما به تکبیری عصای موسی عمران شویم(@)(@@) 12 غم نباشد بیش ما را زان سپس روزی که ما %~% از نشابور و ز طوس و مرو زی همدان شویم(@)(@@) 13 از پی بغداد و کرخ و کوفه و انطاکیه %~% زهرمان حلوا شود آنشب که در حلوان شویم(@)(@@) 14 چون بدارالملک عباسی امامی آمدیم %~% تازه رخ چون برگ و شاخ از قطره باران شویم(@)(@@) 15 از برای حق صاحب مذهب اندر تهنیت %~% جان قدم سازیم و سوی تربت نعمان شویم(@)(@@) 16 با شیاطین کین کشیم از خنجر توفیق حق %~% چون ز قادسیه سوی عقبه شیطان شویم(@)(@@) 17 پای چون در بادیه خونین نهادیم از بلا %~% همچو ریگ نرم پیش باد سرگردان شویم(@)(@@) 18 زان یتیمان پدر گم کرده یاد آریم باز %~% چون یتیمان روز عید از درد دل گریان شویم(@)(@@) 19 از پدر وز مادر و فرزند و زن یاد آوریم %~% ز آرزوی آن جگر بندان جگر بریان شویم(@)(@@) 20 در تماشاشان نیابیم ار گهی خوش دل بویم %~% گرد بالینشان نبینم ار دمی نالان شویم(@)(@@) 21 در غریبی درد اگر بر جان ما غالب شود %~% چون نباشد این عزیزان سخت بی‌درمان شویم(@)(@@) 22 غمگساری نه که اشگی بارد از غمگین بویم %~% مهربانی نی که آبی آرد ار عطشان شویم(@)(@@) 23 نه پدر بر سر که ما در پیش او نازی کنیم %~% نی پسر در بر که ما از روی او شادان شویم(@)(@@) 24 چون رخ پیری ببینیم از پدر یاد آوریم %~% همچو یعقوب پسر گم کرده با احزان شویم(@)(@@) 25 باشد امیدی هنوز ار زندگی باشد ولیک %~% آه اگر در منزلی ما صید گورستان شویم(@)(@@) 26 حسرت آن روز چون بر دل همی صورت کنیم %~% ناچشیده هیچ شربت هر زمان حیران شویم(@)(@@) 27 آه اگر یک روز در کنج رباطی ناگهان %~% بی‌جمال دوستان و اقربا مهمان شویم(@)(@@) 28 همرهان حج کرده باز آیند با طبل و 
ms426	 علم %~% ما به زیر خاک ره با خاک ره یکسان شویم(@)(@@) 29 قافله باز آید اندر شهر بی‌دیدار ما %~% ما به تیغ قهر حق کشته غریبستان شویم(@)(@@) 30 همرهان با سرخ رویی چون به پیش ماه شب %~% ما به زیر خاک چون در پیش مه کتان شویم(@)(@@) 31 دوستان گویند حج کردیم و می‌آییم باز %~% ما به هر ساعت همی طعمه دگر کرمان شویم(@)(@@) 32 نی که سالی صدهزار آزاده گردد منقطع %~% هم دریغی نیست گر ما نیز چون ایشان شویم(@)(@@) 33 گر نهنگ حکم حق بر جان ما دندان زند %~% ما به پیش خدمت او از بن دندان شویم(@)(@@) 34 رو که هر تیری که از میدان حکم آمد به ما %~% هدیه جان سازیم و استقبال آن پیکان شویم(@)(@@) 35 چون بدو باقی شدیم از جسم خود فانی شویم %~% چون بدو دانا شدیم از علم خود نادان شویم(@)(@@) 36 گر نباشد حج و عمره ور می و قربان گو مباش %~% این شرف ما را نه بس کز تیغ او قربان شویم(@)(@@) 37 این سفر بستان عیاران راه ایزدست %~% ما ز روی استقامت سرو این بستان شویم(@)(@@) 38 حاجیان خاص مستان شراب دولتند %~% ما به بوی جرعه‌ای مولای این مستان شویم(@)(@@) 39 نام و ننگ و لاف و اصل و فضل در باقی کنیم %~% تا سزاوار قبول حضرت قرآن شویم(@)(@@) 40 بادیه بوته‌ست و ما چون زر مغشوشیم راست %~% چون بپالودیم ازو خالص چو زر کان شویم(@)(@@) 41 بادیه میدان مردانست و ما نیز از نیاز %~% خوی این مردان گریم و گوی این میدان شویم(@)(@@) 42 گر چه در ریگ روان عاجز شویم از بی‌دلی %~% چون پدید آید جمال کعبه جان افشان شویم(@)(@@) 43 یا به دست آریم سری یا برافشانیم سر %~% یا به کام حاسدان گردیم یا سلطان شویم(@)(@@) 44 یا پدید آییم در صحرای مردان همچو کوه %~% یا به زیر پشته ریگ روان پنهان شویم PageV1P0561(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 
ms427	 بر بساز کم زنان خود را بر آن مهتر نهیم %~% گر دغا بازد کسی ما مهره در ششدر نهیم(@)(@@) 2 پاکبازانیم ما را نه جهاز و نه گرو %~% گر حریفی زر نهد ما جان به جای زر نهیم(@)(@@) 3 در دو کونم نیست از معلوم حالی یک درم %~% با چنین افلاس خود را نام سر دفتر نهیم(@)(@@) 4 چون خطا از سامری بینیم در هنگام کار %~% غایت سستی بود گر جرم بر آزر نهیم(@)(@@) 5 گر سراندازی کند با ما درین ره یار ما %~% ما ز سر بنهیم سودا بر خط او سر نهیم(@)(@@) 6 همتی داریم عالی در ره دیوانگی %~% درد چون از علم زاید جهل را بر در نهیم(@)(@@) 7 فتنه خویشیم هر یک در طریق عاشقی %~% جامه‌مان گازر درد تاوانش بر زرگر نهیم(@)(@@) 8 کی پسندد عاقل از ما در مقام زیرکی %~% کاسب تازی مانده بی که جو به پیش خر نهیم(@)(@@) 9 گر یکی دیگ از هوای هستی خود بشکنیم %~% از طریق نیستی صد دیگ دیگر برنهیم(@)(@@) 10 ز آتش معنی مگر مردان ره را خوی دهیم %~% تا ز روی تربیت تر دامنان را تر نهیم(@)(@@) 11 گر حریفان زان مکان لامکان پی برگرند %~% ما برین معلوم نامعلوم دستی بر نهیم(@)(@@) 12 آیت غم از برای عاشقان منزل شدست %~% دست بر حنظل زنیم و پای بر شکر نهیم(@)(@@) 13 مصر اگر فرعون دارد ما به کنعان بس کنیم %~% سیم گر سلمان رباید دیده در بوذر نهیم(@)(@@) 14 دست همت چنبر گردون خرسندی کنیم %~% پای خرسندی ز حکمت بر سر اختر نهیم(@)(@@) 15 پای رای نفس را از تیغ شرعی پی کنیم %~% پای معنی از سپهر و اختران برتر نهیم(@)(@@) 16 ماه اگر نیکو نتابد ابر در پیشش کشیم %~% رهبر ار گمراه گردد سنگها رهبر نهیم(@)(@@) 17 گوش زی فرمان صاحب حرمت و دولت نهیم %~% پای را بر شاهراه شرع پیغمبر نهیم(@)(@@) 18 عقل را اگر نقل 
ms428	 باید گو چو مردان کسب کن %~% گر گنه از کور زاید جرم چون بر کر نهیم(@)(@@) 19 خواجه جانیم از آن از خودپرستی رسته‌ایم %~% نفس اگر میزر بجوید حکمش از معجر نهیم(@)(@@) 20 هر خسی واقف نگردد بر نهاد کار ما %~% غایب و حاضر چه داند ما کجا محضر نهیم(@)(@@) 21 تا بدین دلق ای برادر در سنایی ننگری %~% عطر از عود آن گهی آید که بر آذر نهیم(@)(@@) 22 دیده بیدار باید تا بینند نظم او %~% تیر همت را به پای عقل کافی بر نهیم(@)(@@) 23 بر سر معلوم خود خاک قناعت گستریم %~% راه چون معلوم باشد نک به دیده بر نهیم PageV1P0562(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عقل محرم تا بود دستور سلطان بدن %~% کی به ناواجب رود فرمان جان در ملک تن(@)(@@) 2 جان جهانی لشکر عالی نسب دارد همی %~% هر یکی با کار و باری در جهان خویشتن(@)(@@) 3 ساخته میران این لشکر ز روی مرتبت %~% شمع اوباشان خود را ز افسر شاهان لگن(@)(@@) 4 شرم دارند ار نهند از تابش زهره کلاه %~% ننگ دارند ار کنند از عکس پروین پیرهن(@)(@@) 5 بی‌تکلف مرکبانی آوریده زیر ران %~% کآفتاب انگیر باشد نعلشان در تاختن(@)(@@) 6 طوطیان معنوی پرند در باغ فلک %~% در تماشاگاهشان مهد فلک کمتر چمن(@)(@@) 7 سیر ایشان خسته کرده پای سیاحان عرش %~% لفظ ایشان بسته دست خازنان ذوالمنن(@)(@@) 8 صوتشان راهست حیران گشته بی‌انگشت گوش %~% حرفشان را هست سرگردان زبان اندر دهن(@)(@@) 9 با همه شاهنشهی عقل معظم را رهی %~% با همه بت چهرگان جان مقدس را شمن(@)(@@) 10 ان دو والا هر دو چون شاه و وزیر اندر جسد %~% وزن دو والی هر دو چون دستور و سلطان در بدن(@)(@@) 11 کرده اندر بزمگه نفس ارادی را قدح %~% ساخته در رزمگه روح طبیعی را مجن(@)(@@) 12 نفس بی‌توقیعشان افگنده در صحرای «لا» %~% جسم بی‌منشورشان افتاده در دریای «لن»(@)(@@) 13 بر فلک مشهور کار و بارشان در 
