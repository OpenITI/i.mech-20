ms861	(@)(@@) % يحول أو يثول من صفرة % % حتى تراه عازب العقل % 5(@)(@@) % ينزع طول الدهر من جبنه % لكنه نزع على مهل % PageV01P3414 البحر : - 1(@)(@@) % غضبت لي السماء والأرض والنا % % س على ابن اللبون إسماعيل % 2(@)(@@) % ولما أسخط السماء مع الأر % % ض مع الناس غير سخط الجليل % % 3(@)(@@) % أنكر الله أن يرى مثل مدحي % % في أبي الفقر وهو غير منيل % % 4(@)(@@) % فرماه بكوكب هاشمي % كان أدهى له من السجيل % % 5(@)(@@) % ولقد كاد مااستطاع ولكن % جعل الكيد منه في تضليل % 6(@)(@@) % سال ذاك النجيع من ذلك العب % % د ودمع الباكيه كل مسيل % % 7(@)(@@) % وليطل معول عليه عويلا % إنه في لظى طويل العويل % 8(@)(@@) % لاسقى الله جسمه من حيا المز % % ن ولاروحه من السلسبيل % % PageV01P3415 البحر : - 1(@)(@@) % أيا من له الشرف المستقل % من جوده العارض المستهل % 2(@)(@@) % ويامن أضاء كشمس الضحى % % فأضحى عليه به نستدل % 3(@)(@@) % بوجهك ذاك الجميل آمتثله % % في الفعل بي واستمع مايمل % 4(@)(@@) % فمن مثله تستمل الفعا % % ل كف كريم عدت تستمل % 5(@)(@@) % أتهتز في ورق ناضر % وليس لعبدك في ذاك ظل % 6(@)(@@) % ولم يأت ذنبا ترى شخصه % % عيانا ولامثله من يزل % 7(@)(@@) % فإن قلت قصر فيما عليه % % فهو المقصر وهو المخل % % 8(@)(@@) % ولكن عفوك عفو يحل % % إذا كان قدرك قدرا يجل % % 9(@)(@@) % وإني أريبك يامن به % % دفاعي الريوب التي قد تظل % % 10(@)(@@) % ولكن ظنك بي لا يزال % أسوأ ظنك أو أستقل % % PageV01P3416 11(@)(@@) % وحتى نقدم مالاتشك % في أنني معه لاأضل % 12(@)(@@) % هنالك توقن أني الولي % وأني المحب وأني المجل % 13(@)(@@) % إذا أنت أوليتني صالحا % فأنت على غيب شكري مطل % 14(@)(@@) % وهل يلتقي في سليمي الصدور % % ذكرى صنيع جميل وغل % 15(@)(@@) % بحالي ضنى من توانيكم % % فحتى متى سادتي لاتبل % 16(@)(@@) % وتضييع مثلي مالا يحل % والله يكره مالا يحل % 17(@)(@@) % أحقا رضيت بأن الغنى % % عدو لعبدك والفقر خل % 18(@)(@@) % وأني إذا ماأعز امرؤ % % فلي مستضيم ولي مستذل % 19(@)(@@) % وسيبك يغمر ظلابه % وسيفك عن ظالم لا يكل % 20(@)(@@) % أيعجز فضلك عن خادم % وأنت بأمر الورى مستقل % PageV01P3417 21 
ms862	(@)(@@) % وبذري يسير كبذر القراح % واعلم بأني قراح مغل % % 22(@)(@@) % أغل الثناء الذي تعلمو % % ن أن ليس منه قليل يقل % 23(@)(@@) % فصلني بما فيه لي عصمة % فإن جنابك مجن مظل % 24(@)(@@) % وأعزز وليك إن القبي % % ح كل القبيح ولي يذل % % 25(@)(@@) % ولاتلحيني في أن أذل % صفرا من الإل فالود إل % 26(@)(@@) % وطولك أحظى شفيع لدي % ك حين يمل الشفيع الممل % % 27(@)(@@) % إذا كنت هشا تلقي السؤا % % ل وجها يهل إليه المهل % % 28(@)(@@) % فإني عليك بأن ليس لي % % أداة المدل مدل مدل % % 29(@)(@@) % ولم لاوأنت رحيب الفنا % % ء بحر ينيخ إليك المكل % 30(@)(@@) % ترى الحمد ينشر مسكا يفو % % ح والمال يطوى لحاما تصل % PageV01P3418 31(@)(@@) % وتعتد شكري الذي يستقل % ل فوق جداك الذي لا يقل % PageV01P3419 البحر : - 1(@)(@@) % أقبلت دولة هي الإقبال % فأقامت وزال عنها الزوال % 2(@)(@@) % دولة ليس يعدم الدهر فيها % % باطل مزهق وحق مدال % % 3(@)(@@) % طالعت للعيون فيها مصابي % % ح أضاءت لضوئها الآمال % 4(@)(@@) % شمس دجن ومشتر غير منحو % % س وبدر متمم وهلال % 5(@)(@@) % ملك وابنه ومدره ملك % وابنه هكذا يكون الكمال % PageV01P3420 البحر : - 1(@)(@@) % لاتعذل النفس في تعجلها % % فإننا خلقتان من عجل % 2(@)(@@) % وإن فوت الذي أبادره % أرمض لي من مردد العذل % % 3(@)(@@) % أخشى كسادي على النساء إذا % % أسننت والسن جمة الخبل % % 4(@)(@@) % وإنني من كسادهن على % % سني لأولى بالخوف والوجل % % 5(@)(@@) % كم من نشاط لهن عندي في ال % % يوم وكم بعد ذاك من كسل % % 6(@)(@@) % والعيش طعمان عند ذائقه % مر التوالي مستعذب الأول % 7(@)(@@) % من عسل تارة ومن صبر % لهفي لتأخير عقبة العسل % 8(@)(@@) % لو أنها أخرت لطاب بها ال % % عيش وإن جاوزت شفا الأجل % 9(@)(@@) % أعجزنا كرنا الشباب وأن % % تثمر صدقا مواعد الأمل % % 10(@)(@@) % كم تحسب العيش دار عر % جتنا وإنما العيش دار منتقل % PageV01P3421 11(@)(@@) % فبادر الدهر بالمناعم وال % لذات واحذر من وشك مرتحل % % 12(@)(@@) % فإن تعذرن أن يجبنك بالقو % وة فاحتل لطائف الحيل % % PageV01P3422 البحر : - 1(@)(@@) % ذكر الأخفش القديم فقلنا % % إن للأخفش الحديث لفضلا % % 2(@)(@@) % وإذا ماحكمت والروم قومي % % في 
ms863	 كلام معرب كنت عدلا % % 3(@)(@@) % أنا بين الخصوم فيه غريب % لاأرى الزور للمحاباة أهلا % % 4(@)(@@) % ومتى قلت باطلا لم ألقب % % فيلسوفا ولم أسوم هرقلا % % 5(@)(@@) % بدأ النحو ناشئا فغذاه % % أحدث الأخفشين فانصات كهلا % % 6(@)(@@) % وتعاصى فقاده بيديه % % أحدث الأخفشين فانقاد رسلا % % 7(@)(@@) % أيهذا المسائلي بعلي % زادك الله بالمعالم جهلا % % 8(@)(@@) % أنت كالمستثير شمسا بنار % ولعمري للشمس للعين أجلى % % 9(@)(@@) % لاتسائل به سواه من الن % % ناس تجده بحضرة الحفل حفلا % % 10(@)(@@) % قائلا بالصواب يقرع فصا % بجواباته وينطق فصلا % % PageV01P3423 11(@)(@@) % كلما شذت الفروع عن الأص % % ل ثناها فألحق الفرع أصلا % % 12(@)(@@) % وتراه تدينه كل عوصا % % ء كما دانت الحليلة بعلا % % 13(@)(@@) % ياظماء إلى الصواب ردوه % % يسقكم بالصواب علا ونهلا % % 14(@)(@@) % هو بحر من البحور فرات % ليس ملحا وليس حاشاه ضحلا % % 15(@)(@@) % قل له يامقومي وسمي % % وكنيي ومن غدا لي شكلا % % 16(@)(@@) % قد أردت الإطناب فيك فقالت % لي غاياتك البعيدة مهلا % % 17(@)(@@) % ورأيت اليسير يكفي من الحل % ي إذا النصل كان مثلك نصلا % % 18(@)(@@) % لك من نفسك الحلى اللواتي % % أنفت أن يكون حليك نحلا % % 19(@)(@@) % ولعمري ماأنت كالسيف صقلا % حين ننضوك بل مضاء وصقلا % % 20(@)(@@) % منظري لناظر مخبري % لمريغ لديك نقضا وفتلا % % PageV01P3424 21(@)(@@) % ذو أفاع لمن يعاديك صم % كائنات لمن يواليك نحلا % % 22(@)(@@) % تقلس الأري والسمام ونا % % هيك بهذا وذا شفاء وخبلا % % 23(@)(@@) % فدع الشكر لي فلم أكسك المد % % ح سليبا ولم أحلك عطلا % % 24(@)(@@) % أنت من لم يزل يحلي ويكسي % % كل مدح فلست توسم غفلا % % 25(@)(@@) % وحرام علي عرضك بسل % % أبدا مارأيت عرضي بسلا % % 26(@)(@@) % فالزم الصدق إنه للفريقي % % ين نجاة والختل يجزيك ختلا % % 27(@)(@@) % وخفي الحديث ينمي فيحيي % بعدما ماتت الضغائن ذحلا % % PageV01P3425 البحر : - 1(@)(@@) % ياعصمة لست منها باغيا بدلا % % يانعمة لست عنها باغيا حولا % % 2(@)(@@) % يابن الوزيرين يامن لاانصراف له % % عن سده خللا أو عفوه جللا % % 3(@)(@@) % يامن إذا قلت فيه القول سددني % % إجلاله فكفيت الزيغ والخطلا % % 4(@)(@@) % ومن إذا ما فعلت الفعل أيدني % % إقباله فوقيت العثر والزللا % % 5(@)(@@) % كم فعلة 
ms864	 لك بي أرسلتها مثلا % ومدحة فيك لي أرسلتها مثلا % % 6(@)(@@) % أحللتني قلل الآمال في دعة % أحلك الله من آمالك القللا % % 7(@)(@@) % لله طول سيجزي غير ما كذب % % طولا قصرت به ساعاتي الطولا % % 8(@)(@@) % تبخل البحر نفسي ماعرضت لها % % أو تزدري البدر أو تستصغر الجبلا % % 9(@)(@@) % بل كل ذلك يجري في خواطرها % % وماجهلت ولاضاهيت من جهلا % % 10(@)(@@) % وسائلين بحالي كيف صورتها % % فقلت قد نطقت حالي لمن عقلا % % PageV01P3426 11(@)(@@) % قالوا أتأمل مأمولا فقلت لهم % % يؤمل المرء مالم يبلغ الأملا % % 12(@)(@@) % مثل المسافر لا ينفك من سفر % حتى إذا هو وافى رحله نزلا % % 13(@)(@@) % وقد بلغت الذي أملت من أمل % يابن الوزير وماأعطى ومابذلا % % 14(@)(@@) % فما أؤمل إلا طول مدته % % أطالها الله حتى يرغم الأجلا % % 15(@)(@@) % أبى الحسين أخي الحسنى وفاعلها % % تم البيان تمام البدر بل فضلا % % 16(@)(@@) % لاتجمعن إلى ذكراه نسبته % % فقد كفاك مكان النسبة ابن جلا % % 17(@)(@@) % هل يطلب الصبح بالمصباح طالبه % % مااستهلك الصبح عن عين ولاخملا % % 18(@)(@@) % رحلت ظني إلى جدواه بل ثقتي % % فأخر الوعد لكن قدم النفلا % % 19(@)(@@) % سقيا لها رحلة ماكان أسعدها % % لقد كفتني طوال المسند الرحلا % % 20(@)(@@) % صادفت منه بليغا في مواهبه % تعطي يداه تفاريق الغنى جملا % % PageV01P3427 21(@)(@@) % وليس يقنع من تمت بلاغته % % أن يوجز القول حتى يوجز العملا % % 22(@)(@@) % جرى نداه إلى غاياته طلقا % سر العفاة وساء السادة النبلا % % 23(@)(@@) % مازلت في بدر منه وفي حلل % لم تمتثل عذرا منهم ولاعللا % % 24(@)(@@) % حتى اكتسى من مديحي فيه أوشية % شتى فرحنا جميعا نسحب الحللا % % 25(@)(@@) % فتى وإن كان كهلا في جلالته % % كهل وإن كان غضا غصنه خضلا % % 26(@)(@@) % ماظن يوما به إتيان سيئة % حقت ولاظن فيه صالح بطلا % % 27(@)(@@) % ومارجا فضله راج فأخلفه % % ولاتمناه إلا قال قد حصلا % % 28(@)(@@) % إذا التقى سيبه والطالبون له % لاقوه بحرا ولاقى شكرهم وشلا % % 29(@)(@@) % يلقى الوجوه بوجه ماؤه غدق % لاتسأم العين منه النهل والعللا % % 30(@)(@@) % المال غائبه والحمد آئبه والمج % % د صاحبه إن قال أو فعلا % % PageV01P3428 31(@)(@@) % لم يزه بالدولة الزهراء 
ms865	 حاش له % % من شيمة تستحق اللوم والعذلا % % 32(@)(@@) % وكيف يلقاك مزهوا بدولة % من صانه الله كي تزهى به الدولا % % 33(@)(@@) % يارب زد في معاني ماتخوله % ولاتزد في معانيه فقد كملا % % 34(@)(@@) % قل للإمام أدام الله غبطته % لامح نورك من بدر ولاأفلا % % 35(@)(@@) % ياخير معتضد بالله معتمد % عليه معتقد مااستودع المللا % % 36(@)(@@) % لولاك لم تلبس الدنيا شبيبتها % % ولااكتسى الدين سيماه ولااكتهلا % % 37(@)(@@) % أضحى بيمنك دين المصطفى نسكا % محضا كما أضحت الدنيا به غزلا % % 38(@)(@@) % مالت علينا غصون العيش مثقلة % حملا وقام عمود الحق فاعتدلا % % 39(@)(@@) % يامن وجدناه فردا في سياسته % % إن صال عدل ميلا أو قضى عدلا % % 40(@)(@@) % يامؤنس الإنس والوحش التي ذعرت % ومن أخاف الأسود السود والجبلا % % PageV01P3429 41(@)(@@) % في قاسم خادم كاف كفاك به % % كأنه لك من بين الورى جبلا % % 42(@)(@@) % مبارك لاتمج العين طلعته % % ولايرى الرائي في مخبوره فشلا % % 43(@)(@@) % مثل الحسام الذي يرضيك رونقه % وإن ضربت به في موطن فصلا % % 44(@)(@@) % لو امتريت به الأرزاق أنزلها % % ولو قرعت به الأجال مانكلا % % 45(@)(@@) % ممن يبين عن لب بعارضة % والطرف يعرب عن عتق إذا صهلا % % 46(@)(@@) % وإن جرى الأرقش النضناض في يده % % جرى شجاع يمج السم والعسلا % % 47(@)(@@) % تجيل طرفك فيما خط حامله % فلا ترى رهلا فيه ولاقحلا % % 48(@)(@@) % كأن تعديل أشباه يصورها % % تعديل أهيف لم يسمن ولاهزلا % % 49(@)(@@) % خط إذا قابلته العين قابلها % % روض الربيع إذا ما طل أو وبلا % % 50(@)(@@) % كأنما الشكل والإعجام شامله % من البيان ولم يعجم ولاشكلا % % PageV01P3430 51(@)(@@) % ولو وصلت به التدبير أمكنه % أن يفتق الرتق أو أن يرتق الخللا % % 52(@)(@@) % تكفي من النبل أحيانا مكايده % وربما خلفت أقلامه الأسلا % % 53(@)(@@) % قال الأماثل عجبا باختياركه % % لافاق سهمك من رام ولانصلا % % 54(@)(@@) % ومارميت ونبل القوم طائشة % إلا أصبت وإلا قيل لاشللا % % 55(@)(@@) % ماعيب عبدك إلا أن قيمته % تنهى أخا العدل أن يعتده خولا % % 56(@)(@@) % يكاد يحميك من أرفاق خدمته % إشفاق نفسك أن تلقاه مبتذلا % % 57(@)(@@) % أبا الحسين ادرعها إن ملبسها % % باق عليك إذا ماملبس سملا % % 58(@)(@@) % ياقابل 
ms866	 الناس والمقبول عندهم % % يامقبلا نحو باب الخير مقتبلا % % 59(@)(@@) % لك القبول مع الإقبال لا ارتحلا % % عن عقر دارك ماعاشا ولاانتقلا % % 60(@)(@@) % يحتال قوم لرفد الرافدين لهم % % لكن رفدك محتال لي الحيلا % % PageV01P3431 61(@)(@@) % ماإن يزال نوال منك يسألني % % حمدي وأي نوال قبله سألا % % 62(@)(@@) % إن وهزيك بالأشعار أنسجها % % للغافل المتعدي جد من غفلا % % 63(@)(@@) % أو الشجاع الذي لاشيء يفزعه % % ولاترد عواديه إذا حملا % % 64(@)(@@) % إذا استجيش من الطوفان ناجية % ماإن أرى لي بها حولا ولاقبلا % % 65(@)(@@) % أستوهب الله حظا من معونته % % على دفاعي ندى كفيك إن حفلا % % 66(@)(@@) % لو اتبع الناس أمري غير معتبر % إذا لعدوني المقدامة البطلا % % 67(@)(@@) % كن في مدى المجد للأمجاد كلهم % % صدرا وكن في مدى أغمارهم كفلا % % 68(@)(@@) % تبقى ويمضون عمرا لاانقطاع له % % مفضلا بعطاء الله ما اتصلا % % 69(@)(@@) % أمورك الدهر أمثال وأمثلة % إذا أمور الناس أصبحت مثلا % % PageV01P3432 البحر : - 1(@)(@@) % قل لأيوب والكلام سجال % والجوابات ذات يوم تدال % 2(@)(@@) % اسكتوا بعدها فلا تذكروا الش % شؤم حيا فأنتم الآجال % 3(@)(@@) % أنا شؤمي فيما تقولون عز % زال ولكن شؤمكم قتال % 4(@)(@@) % بالذي أدرك المؤيد منكم % % وابن سعدان تضرب الأمثال % % 5(@)(@@) % زرتموه والصالحات عليه % % مقبلات فأدبر الإقبال % 6(@)(@@) % حين درت له أفاويق دنيا % % ه دلفتم له فكان الفصال % 7(@)(@@) % إن شؤما حلت به عقدة العه % % د لشؤم تزول منه الجبال % % 8(@)(@@) % ليس بدعا من الحوادث أن يع % % زل وال وأن تموت الرجال % 9(@)(@@) % إنما البدع أن تزول أمور % لم يكن يهتدي إليها الزوال % 10(@)(@@) % كالذي حاق بالمؤيد منكم % بعدما نوطت به الآمال % PageV01P3433 11(@)(@@) % ذلك الشؤم يابني أم شيخ % يمكن القائلين فيه المقال % 12(@)(@@) % ذاك شؤم فيه سمام الأفاعي % % ناجز النقد ليس فيه مطال % 13(@)(@@) % ذاك شؤم كالسيل عفى على ال % % قطر جلال كما يكون الجلال % % 14(@)(@@) % ذاك شؤم لو جاور البحر يومي % % ن لأمسى وليس فيه بلال % % 15(@)(@@) % ذاك شؤم لو كان في جنة الخل % % د لحالت بأهلها الأحوال % 16(@)(@@) % ذاك شؤم لا يثلم الدهر حدي % % ه ومالم يزل فليس 
ms867	 يزال % 17(@)(@@) % ذاك شؤم شؤم البسوس وغبرا % % ء وشؤم الورى عليه عيال % % 18(@)(@@) % كالذي أدرك المؤيد منكم % % وهو في رأس نجوة لا ينال % % 19(@)(@@) % وهاذر يبلغني هدره % لو شئت عفى قطره سيلي % % 20(@)(@@) % أعملنه يركض في غيه % والخيل تبقي الجري للخيل % PageV01P3434 21(@)(@@) % ياأيها الأعمى الذي سبني % % محلل مانلت من نيل % 22(@)(@@) % شعرك لاتثبت آثاره % من غرة اليوم إلى الليل % 23(@)(@@) % مدب ذر في نقا هائل % % مرت به معصفة الذيل % % 24(@)(@@) % عفا فما يسطيع يقتافه % ناظر لقمان ولاقيل % % 25(@)(@@) % لوكان في شلوك لي مبطش % لقد دعت أمك بالويل % PageV01P3435 البحر : - 1(@)(@@) % خليلي قد عللتماني بالأسى % % فأنعمتما لو أنني أتعلل % 2(@)(@@) % أللناس آثاري وإلا فما الأسى % % وعيشكما إلا ضلال مضلل % 3(@)(@@) % وماراحة المرزوء في رزء غيره % % أيحمل عنه بعض مايتحمل % 4(@)(@@) % كلا حاملي أوق الرزيئة مثقل % وليس معينا مثقل الظهر مثقل % 5(@)(@@) % وضرب من الظلم الخفي مكانه % تعزيك بالمرزوء حين تأمل % 6(@)(@@) % لأنك يأسوك الذي هو كلمه % بلا جرم لو أن جورك يعدل % PageV01P3436 البحر : - 1(@)(@@) % وماراحة المرزوء في رزء غيره % % أمشركه في حمل ما قد تحملا % % 2(@)(@@) % كلا حاملي أوق الرزية مثقل % وليس معينا مثقل الظهر مثقلا % % PageV01P3437 البحر : - 1(@)(@@) % حذار عرامي أو نظار فإنما % % يظلكم قطع من الرجز مرسل % 2(@)(@@) % ولاتحسبن الصلح أنصل التي % % ولاأنني في هدنة العلم أغفل % 3(@)(@@) % ولكنني مستجمع الحلم مغبر % أفوق نبلي تارة وأنصل % 4(@)(@@) % فإن هاجت الهيجاء أو عاد عودها % % على بدئها لم يلق مني أعزل % 5(@)(@@) % ولي بعد إعطائي الوثيقة حقها % % بدائه لا يخذلنني حين أعجل % 6(@)(@@) % تلافي بي الشأو المغرب وادعا % وتسبق بي ماقدم المتمهل % PageV01P3438 البحر : - 1(@)(@@) % العدل فرض وبذل الفضل نافلة % يابن الكرام فعدلا ثم إفضالا % % 2(@)(@@) % ملكت مالك جودا لا يقام له % % والعدل أفضل ماملكته المالا % % 3(@)(@@) % أعطيت قوما ومااستكفيتهم عملا % أسنى عطاء وماجاءوك سؤالا % % 4(@)(@@) % وحظ كتابك الأشقين أن بخسوا % % حقوقهم وهم الأوفون أعمالا % % 5(@)(@@) % كتاب دولتك الميمون طائرها % % أضحوا وهم أسوأ الكتاب أحوالا % % 6(@)(@@) % عبيد خدمتك المعطوك جهدهم % في غاية الجهد إقتارا 
ms868	 وإقلالا % % 7(@)(@@) % فاعطف عليهم بفضل منك ينعشهم % % ياواحد الناس إحسانا وإجمالا % % 8(@)(@@) % صن منيصونك عن ثقل تحمله % % يزدك صونا ويحمل عنك أثقالا % % 9(@)(@@) % لاتحتقرهم وإن أصبحت فوقهم % % فالسمك بالأس مدعوم وإن طالا % % 10(@)(@@) % فارفق بأس بناء ذروته % فقد غدوت ومانالوه زلزالا % % PageV01P3439 11(@)(@@) % ولا يلح لاح أبا غانم % فعول الكرائم قوالها % % 11(@)(@@) % بصرت بفحل على خالد % فقال وكم حكمة قاله % % 11(@)(@@) % أخالك مستنكرا فعلتي % % فقلت لعمري وفعالها % % 11(@)(@@) % فقال ولكنني عارف % أصيب وأركب أمثالها % % 11(@)(@@) % وماذا على طالب لذة % بأية جارحة نالها % % 11(@)(@@) % أتنقم إن سفلت كفتي % % لرجحانها ذاك أعلى لها % % 11(@)(@@) % أم العيب حملي رماح الكما % % ة لا زلت ما عشت حمالها % % 11(@)(@@) % وهل عائب الأرض أن حملت % من الجن والإنس أثقالها % % 11(@)(@@) % كذا فليعد رجال العلا % % أقاويل تشبه أفعالها % % 11(@)(@@) % إن البناء متى مادت قواعدهمتقارب بصرت بفحل على خالد فقال وكم حكمة قالهأخالك مستنكرا فعلتيفقلت لعمري وفعالها فقال ولكنني عارف أصيب وأركب أمثالهاوماذا على طالب لذة بأية جارحة نالها أتنقم إن سفلت كفتيلرجحانها ذاك أعلى لها % % مال البناء ولن يبقى إذا مالا % % PageV01P3440 البحر : - 1(@)(@@) % ياأيها الهارب من دهره % أدركك الدهر على خيله % 2(@)(@@) % يسوق من نفرته طرة % إلى مدى يقصر عن ثيله % % 3(@)(@@) % فوجهه يأخذ من رأسه % أخذ نهار الصيف من ليله % 4(@)(@@) % قردة نردة نواة حصاة % بومة ثومة عظام بوالي % % 4(@)(@@) % مثل الذي يرقع من جيبهخفيف قصرت شنطف وقلت وذلتغير بظر تجره كالطحال ضيقت عينها ووسع فوهاومشق استها وثقب المبالفهي شيء كأنما صاغة اللهلصفع القفا وقفد القذال وهي تختال بين برقع قبح وقميص من الضنى والهزال وإذا ما تن % % وهيا بما يأخذ من ذيله % % 4(@)(@@) % قصرت شنطف وقلت وذلت % غير بظر تجره كالطحال % 4(@)(@@) % ضيقت عينها ووسع فوها % % ومشق استها وثقب المبال % % 4(@)(@@) % فهي شيء كأنما صاغة الله % لصفع القفا وقفد القذال % % 4(@)(@@) % وإذا ما تنادرت رخص الثل % % ج وأضحى فحم الغضا وهو غال % 4(@)(@@) % قالت الخلق كلهم قد قلوني % % قلت أعييت حيلة المحتال % PageV01P3441 4(@)(@@) % لو غدا طول 
ms869	 بظرها لقناة الظ % ظهر منها لألحقت بالطول % % 4(@)(@@) % بنت سبعين بل ثمانين بل تس % % عين بل ضعفها من الأحوال % % 4(@)(@@) % ضامر وجه طيزها غير تر % % كي ولكن ينموزجي السؤال % % 4(@)(@@) % صاح بي عمرها وقد غازلتني % % لا تعرج بدارس الأطلال % % 4(@)(@@) % طالبتني بأن أنيك وما القر % % د ولو حل نيكه بحلال % 4(@)(@@) % قلت ميلي إلى القرود بصغر % ليس لفق النكال غير النكال % 4(@)(@@) % وهي تختال بين برقع قبح % وقميص من الضنى والهزال % PageV01P3442 البحر : - 1(@)(@@) % كريم كثرت قدما % % وطابت فيه أقوالي % % 2(@)(@@) % فما قلل غرامي % % ولا كثر أموالي % % 3(@)(@@) % إذا عانيت مدحيه % أراه ذاك إغفالي % % 4(@)(@@) % إلى أن أزمع السير % % وقد أزمع إهمالي % % 5(@)(@@) % فإن يظعن أبو الصقر % % وقد أخلف آمالي % % 6(@)(@@) % فإن الله لي باق % ولن يحبط أعمالي % % 7(@)(@@) % أبا الصقر ألا أولى % % لتأميلي وأولى لي % % 8(@)(@@) % لقد طاول إعراضك % % بالمعروف إقبالي % % 9(@)(@@) % عقلت الرفد عن كفي % % وسارت فيك أمثالي % % 10(@)(@@) % لئن رحت وما حس % ن إحسانك من حالي % % PageV01P3443 11(@)(@@) % وأغفلت مجازاتي % % وتمجيدك أشغالي % % 12(@)(@@) % لما حاسنت إحساني % % ولاجاملت إجمالي % % 13(@)(@@) % وحسبي أن رأت عيني % % على مثلك إفضالي % % 14(@)(@@) % لقد أفرطت في رفعي % % بلا عمد وإجلالي % % PageV01P3444 البحر : - 1(@)(@@) % تفرست في الشطرنج حتى عرفتها % % فإن صح رأيي فهي بالوعة العقل % 2(@)(@@) % إليها يغيض العقل ماشاب صفوه % % من الهذيانات الشنيعة والهزل % 3(@)(@@) % وماذاك في الشطرنج عيبا لأنه % % عناء عظيم إن جنحنا إلى العدل % 4(@)(@@) % أليس عناء أنها آلة الفتى % % لتصفية العقل المشوب من الجهل % % 5(@)(@@) % بلى إن ترويق الشراب من القذى % % لنفع وتخليص الخيار من الرذل % PageV01P3445 البحر : - 1(@)(@@) % قد أناسي الهم تجوا % % ه بصفراء شمول % 2(@)(@@) % تجذل البال وتغتا % % ل مدى الهم الطويل % 3(@)(@@) % وتبقي جدة اللذ % ذات في عين الملول % 4(@)(@@) % أستشف الروضة الخض % % راء عن شمس الأصيل % 5(@)(@@) % ولقد يلهيني الطي % % ر بترجيع الهديل % PageV01P3446 البحر : - 1(@)(@@) % لاأسرق الشعر وغيري قاله % يكفيني ارتجاله انتحاله % PageV01P3447 البحر : - 1(@)(@@) % أرى لعبة الشطرنج إن هي حصلت % أحق أمور الناس ألا يحصلا % % 2(@)(@@) % تعلة توابين جاعا وأرملا 
ms870	 % % بباب قليل خيره فتعللا % % PageV01P3448 البحر : - 1(@)(@@) % وذكرك في الشعر مثل السنا % % د والخرم والخزم أو كالمحال % 2(@)(@@) % وإيطاء شعر وإكفائه % وإقوائه دون ذكر الرذال % 3(@)(@@) % وماعيب شعر بعيب له % % كأن يبتلى برجال السفال % % 4(@)(@@) % يتاح الهجاء لهاجي الهجا % % ء داء عضال لداء عضال % % PageV01P3449 البحر : - 1(@)(@@) % لاتصدفا عن دمن المنازل % اللائي أصبحن قرى النوازل % % 2(@)(@@) % مستضعفات لصبيب هاطل % % طورا وطورا لسفي حافل % % 3(@)(@@) % من كل أحوى قصف الأرامل % % وكل عجلي ذات ذيل ذائل % % 4(@)(@@) % حتى كأن لم تك بالأواهل % صاول منها الدهر غير صائل % 5(@)(@@) % كالثائر الطالب بالطوائل % فلم يرع عن دمن ذلائل % 6(@)(@@) % خواشع أطلالها خوامل % ولن تراه غافلا عن غافل % 7(@)(@@) % ولاإذا عامل بالمجامل % لادر در الدهر من معامل % % 8(@)(@@) % مجامل من ليس بالمجامل % % مماحل من ليس بالمماحل % % 9(@)(@@) % ملتحف المكر على نياطل % % مشتمل الشوط على مقاول % 10(@)(@@) % يهدم مايبني بلا معاول % % عوجا خليلي من العياهل % % PageV01P3450 11(@)(@@) % عوجة راعي منزل لآهل % % نلبس بقايا الخلع السوامل % % 12(@)(@@) % من المغاني لامن السرابل % % قد تحفظ الأبراد في الرعابل % % 13(@)(@@) % سقيا لها إذ نحن في غياطل % % من عيشنا ذي الظلل الظلائل % 14(@)(@@) % كالبكر الطلات والأصائل % % في نفحات الشمأل البلائل % % 15(@)(@@) % واها لها والظل غير زائل % % والدهر لم يثقل على الكواهل % % 16(@)(@@) % مرا على جناتنا الذوابل % % نبك مع الورق بها الهوادل % % 17(@)(@@) % معاهد الأيام والليائل % % لاالسود تالله ولا الأطاول % % 18(@)(@@) % ميلا إليها ميلة الممائل % % لاتعرضا عنها بوجه خاذل % % 19(@)(@@) % بحق أدماناتها الخوازل % % أبكارهن الغيد والمطافل % % 20(@)(@@) % وإن توجدنا على البخائل % المستمنحات بلا وسائل % % PageV01P3451 21(@)(@@) % صفو الهوى من مهجة المغازل % % الموقظات للهوى الغوافل % % 22(@)(@@) % الفارغات الهمم الشواغل % % التابلات المرء غير التابل % % 23(@)(@@) % والنافثات السحر سحر بابل % % بالأعين الصحائح العلائل % % 24(@)(@@) % واها لها من أعين كلائل % معدودة في عدد المناصل % % 25(@)(@@) % سلبن من أصورة الخمائل % % مكاحلا تغني عن المكاحل % % 26(@)(@@) % خط لها كحل بلا ملامل % % ساءت ظباء الوحش من بدائل % % 27(@)(@@) % بالمخرسات ألسن الخلاخل % % إخراسهن ألسن العواذل % % 28(@)(@@) % اللائي يمددن إلى المناول % % بيضا سباطا ليس بالعوامل 
ms871	 % % 29(@)(@@) % غير جليفات ولاهزائل % % يصلن راحا عطر الجداول % % 30(@)(@@) % يالك من راح ومن أنامل % % نوائش ألبابنا نوائل % % PageV01P3452 31(@)(@@) % تخالها بدهة عن الخائل % % سبائكا ركبن في وذائل % 32(@)(@@) % تجنى بها حبة قلب الذاهل % أنذرتك البيض فقف أو وائل % % 33(@)(@@) % هن العدا في صورة الخلائل % وأين تنجو من غرام داخل % % 34(@)(@@) % تلك اللطيفات من المداخل % % تسمو إلى الأملاك في المعاقل % % 35(@)(@@) % من بقر مبثوثة الحبائل % % للأسد في آجامها البواسل % % 36(@)(@@) % ياللمجدات بنا الهوازل % % الشافيات الخبل والخوابل % % 37(@)(@@) % القاطعات القيظ في الغلائل % والقر في الخز وفي المراجل % % 38(@)(@@) % بطن بالسمور والحواصل % تلك الحوالي لابل العواطل % % 39(@)(@@) % الخالعات نحل النواحل % % عن جيد تياه عن المراسل % % 40(@)(@@) % مستغنيات بعطايا الجابل % % وربما استعددن للمواصل % PageV01P3453 41(@)(@@) % غير أخي الكيد ولا المقاتل % % فزرنه في العدد الكوامل % % 42(@)(@@) % من الحلي الجمة الصلاصل % % والسلب الرائع لاالمباذل % % 43(@)(@@) % والمسك في أبشارهن الشامل % % والعنبر المنشور كالقساطل % % 44(@)(@@) % يهتفن هل من فارس منازل % % أولى فأولى لابن أم هابل % % 45(@)(@@) % نازل أقران بني الثواكل % % ومن عظيم الفتن الهوائل % % 46(@)(@@) % عقائل الدر على العقائل % % في وشيهن الفاخر المخايل % % 47(@)(@@) % والمسك صرفا كدم الأباجل % قاتلهن الله من قواتل % % 48(@)(@@) % صوارع بالكيد أو خواتل % % روع المحالي فتن المعاطل % % 49(@)(@@) % يلقيننا في الوشح الجوائل % % أطغى من الأبطال في الحمائل % % 50(@)(@@) % يهززن أوصال قنا عواسل % % قنا ظهور لا قنا قنابل % % PageV01P3454 51(@)(@@) % بين عواليهن والسوافل % % نشر قرون جعدة السلاسل % % 52(@)(@@) % مثل الدجى مسدولة السدائل % % إلى خدود ذات ماء جائل % % 53(@)(@@) % كأنها صفائح الصياقل % % صبغن لابالصبغ الحوائل % % 54(@)(@@) % إلى ثغور عذبة المناهل % % كأقحوان الديم الهواطل % % 55(@)(@@) % ذات رضاب مثل أري العاسل % % إلى ثدي فرغ حوافل % % 56(@)(@@) % ترنو إلى أجيادها العطائل % % على صدور لسن بالقواحل % % 57(@)(@@) % تلمس منهن يد المباعل % % رمان لاقطف ولامكاتل % % 58(@)(@@) % من كل ريا حلوة الشمائل % ناعمة ذات محب ذابل % % 59(@)(@@) % حسناء مثل الأمل المقابل % % في العمر المقتبل المماطل % % 60(@)(@@) % معدومة الأمثال والعدائل % % إن قلت مثل البدر لم تماثل % % PageV01P3455 61(@)(@@) % أوقلت مثل الشمس لم تعادل % % مهتزة فوق كثيب هائل 
ms872	 % % 62(@)(@@) % مرتجة تحت قضيب مائل % % عرج على أي لهن ماثل % % 63(@)(@@) % فاستسق غيثا بعد دمع هامل % % له وواقف خيمه وسائل % % 64(@)(@@) % حافظ على عهد لهن حائل % % عليه فاربع لا على الجنادل % % 65(@)(@@) % ولاعلى مبرك ذاك الجامل % % ماقدر إصرارك بالجمائل % % 66(@)(@@) % في وقفة من مخبر أو سائل % % لابل دع الهزل لكل هازل % % 67(@)(@@) % وله عن الباطل غير الحاصل % % زايل عهد الظاعن المزائل % % 68(@)(@@) % مارعية المقتول عهد القاتل % % ما صلة الواصل غير الواصل % % 69(@)(@@) % في موقف مستهدف للعاذل % % مفيل رأيك غير الفائل % % 70(@)(@@) % يستنكث الداء على عقابل % % ماذاك للعاقل بالمشاكل % % PageV01P3456 71(@)(@@) % والعقل قدما معقل للعاقل % % والصبر من خير مآل آئل % % 72(@)(@@) % فاعدل إلى الأحجى من المعاذل % % والتمس الفوز ولا تواكل % % 73(@)(@@) % واستنجح العزم ولاتماطل % % عساك أن تحظى بنفل النافل % % 74(@)(@@) % ماأقرب النهزة من معاجل % % وأبعد العثرة من مماهل % % 75(@)(@@) % وفي التأني رشد المحاول % % مالم تفته فرصة المزاول % % 76(@)(@@) % ليس نضيج اللحم للمناشل % % شتان لحما منضج وناشل % % 77(@)(@@) % وتوأم النقص غلو الفاتل % % إذا تعدى فيه حد الجادل % % 78(@)(@@) % فاقصد إذا فرطت من مباذل % % ولاتكثر فيه بالأباطل % % 79(@)(@@) % وازجر عن الجهل ولاتجاهل % % وادع إلى الخير ولاتقاتل % % 80(@)(@@) % ليس حميدا سائق كعاتل % % شمر لكي تسبل ذيل الرافل % % PageV01P3457 81(@)(@@) % فالفقر في أذيالك الذوائل % % PageV01P3458 البحر : - 1(@)(@@) % حبر أبي حفص لعاب الليل % كأنه ألوان دهم الخيل % 2(@)(@@) % يجري إلى الإخوان جري السيل % بغير وزن وبغير كيل % 3(@)(@@) % كأنه من نهر الرفيل % % يحدو به جود كميش الذيل % 4(@)(@@) % نيلا ومازال جزيل النيل % % قيلا من الأقيال وابن قيل % % 5(@)(@@) % ليس بتنبال ولازميل % % إني إليه لشديد الميل % % 6(@)(@@) % ساع لما يرضى كثير الحيل % % وإن دعا حاسده بالويل % % 7(@)(@@) % كما دعا الجمال من سهيل % % PageV01P3459 البحر : - 1(@)(@@) % عيني لعينك حين تنظر مقتل % لكن عينك سهم حتف مرسل % 2(@)(@@) % ومن العجائب أن معنى واحدا % هو منك سهم وهو مني مقتل % PageV01P3460 البحر : - 1(@)(@@) % أبابكر لك المثل المعلى % % وخد عدوك الترب الذليل % 2(@)(@@) % رأيت المطل ميدانا طويلا % يروض طباعه فيه البخيل % 3(@)(@@) % يراود عن جداه نفس 
ms873	 سوء % ترى أن الجدا رزء جليل % % 4(@)(@@) % فما هذا المطال فداك أهلي % % وباعك بالندى باع طويل % % 5(@)(@@) % أظنك حين تقدر لي نوالا % يقل لديك لي منه الجزيل % % 6(@)(@@) % ويعوزك الذي ترضى لمثلي % % وإن لم يعوز الرأي الجميل % % 7(@)(@@) % وعين الماجد المفضال عين % كثير نواله فيها قليل % % 8(@)(@@) % وفيما بين مطلك واختلالي % % يموت بدائه الرجل الهزيل % 9(@)(@@) % فلا تقدر بقدرك لي نوالا % ولاقدري فتحقر ماتنيل % % 10(@)(@@) % وأطلق ماتهم به عساه % كفافي أيها الرجل النبيل % % PageV01P3461 11(@)(@@) % وإلا فالسلام عليك مني % % نبت دار فأسرع بي رحيل % 12(@)(@@) % وإني قائل لك قول لاه % نبيل شأنه شأن نبيل % 13(@)(@@) % إذا ضاقت على أمل بلاد % فما سدت على عزم سبيل % 14(@)(@@) % وإن يك جانب لاظل فيه % % فلي في جانب ظل ظليل % 15(@)(@@) % وبئس الظل ظل ليس فيه % % لذي سبب يمر به مقيل % % 16(@)(@@) % وكل مطالب يزداد بعدا % فمنه تعوض وبه بديل % % 17(@)(@@) % وهذا الموت للأحياء طرا % قرار والحياة لهم مثيل % % 18(@)(@@) % سيرعى ظمأه قرن فقرن % ويورد حوضه جيل فجيل % % 19(@)(@@) % وصرف الدهر يسلك في مدار % يجيل خطوبه فيها مجيل % % 20(@)(@@) % فآونة يدال على أناس % وآونة يديلهم مديل % % PageV01P3462 21(@)(@@) % وليس على يد بقرار أمن % ولاليد بثروتها كفيل % % 22(@)(@@) % فما لي إثر منصرف حنين % ولا بي نحو منحرف مميل % % 23(@)(@@) % وقد يتيسر الميئوس منه % % كما يتعذر الأمر المحيل % % 24(@)(@@) % ومن يك من ثنائي مستقيلا % فإني من جداه مستقيل % % 25(@)(@@) % وأعجب ماأراني الدهر أني % % وفي عهدي وعهدك مستحيل % % 26(@)(@@) % ولو صمت لم يعجزك نفعي % % وأنى يعجز المرء الحويل % % 27(@)(@@) % سألتمس المنافع من مليك % إذا طالبته فهو الكفيل % % 28(@)(@@) % وتعلم أينا المغبون منا % % عيانا أو يقوم لك الدليل % % 29(@)(@@) % أحدك عند لائمتي حديد % وحدك عند منفعتي كليل % % 30(@)(@@) % ستحكم بيننا القلس النواجي % % ويبعد بين دارينا الذميل % % PageV01P3463 31(@)(@@) % لجأت إليكم فخذلتموني % % وضفتكم فما قري النزيل % 32(@)(@@) % ورمتك فاستطلت بلا نوال % فما لنزاهتي لاتستطيل % 33(@)(@@) % سلوت مراضعي وصبا شبابي % % فكيف يعز أن يسلى خليل % % 34(@)(@@) % سيجزي الله ماأوليتموني % % لكم صاع بصاعكم مكيل 
ms874	 % % 35(@)(@@) % وأحسب أن عرضك عن قليل % أبا بكر هو العرض الفتيل % % 36(@)(@@) % ولي عرض تكانفه لسان % كأن كليهما سيف صقيل % % 37(@)(@@) % فهذا غيره الدنس المخزي % % وهذا غيره الطبع الكليل % 38(@)(@@) % صحبت ذوي المكارم آل وهب % بلؤمك إذ أمالهم الدليل % 39(@)(@@) % فأيقن كلنا أن سوف تحمي % % جرامتها بشوكتها النخيل % % PageV01P3464 البحر : - 1(@)(@@) % إذا كان صبري للعاجل % ملاوة صبري للآجل % 2(@)(@@) % فما لي أترك مالا يزول % وأعمل للعرض الزائل % 3(@)(@@) % أأصبر هذا المدى كله % % لغير رغيب ولاطائل % 4(@)(@@) % ويعجزني صبر أضعافه % % لما دونه أمل الآمل % 5(@)(@@) % شهدت إذا أنني مائق % وأن لست بالرجل العاقل % 6(@)(@@) % يباع النفيس بما دونه % لإيثار مستسلف عاجل % 7(@)(@@) % فما عذر من باع أسنى الحظو % % ظ بالوكس من موكس ماطل % % 8(@)(@@) % أأترك آخرتي ضلة % وأخدم دنياي بالباطل % % 9(@)(@@) % وأسخط ربي وأرضي العبا % % د بغير ثواب ولانائل % 10(@)(@@) % شهدت إذا أنني جاهل % بحظي وزدت على الجاهل % % PageV01P3465 11(@)(@@) % أبا أحمد طال هذا المطا % % ل وحسبك بالدهر من غائل % % 12(@)(@@) % فأنجز عداتك أو أعطني % % أمانا من الحدث النازل % % 13(@)(@@) % تذكر فكم لي من مدحة % تركضت في ذيلها الذائل % % 14(@)(@@) % وكائن كسوتك من حلة % مشيت بها مشية الرافل % % 15(@)(@@) % وكم لك من بارق خلب % كذوب ومن عدة حائل % % 16(@)(@@) % يحصل في الزق نفخ اليرا % % ع وما لعدانك من حاصل % % 17(@)(@@) % ولو لم تكن عقما عقرا % لقد جاوزت مدة الحامل % 18(@)(@@) % منحتك مدحي فلم تجزه % ألا ضل سعي من عامل % 19(@)(@@) % كأني في كل ما قلته % زرعت حصا في صفا صامل % % 20(@)(@@) % رجعت إلى فضل من فضله % على الإنس والجن والخابل % % PageV01P3466 21(@)(@@) % دفعت لساني إلى صيقل % وأسلمت عرضي إلى غاسل % % 22(@)(@@) % وكم كنت نبهت من خامل % وكم كنت حليت من عاطل % % 23(@)(@@) % فلو كنت أعشق جدوى يدي % % ك لحان ذهولي مع الذاهل % 24(@)(@@) % إذا مدح المادح الناقصي % % ن ذكرهم فوزة الفاضل % 25(@)(@@) % فأهدى لهم مدحة حسرة % لتقصيرهم عن مدى الكامل % PageV01P3467 البحر : - 1(@)(@@) % غدونا إلى ميمون نطلب حاجة % فأوسعنا منعا وجيزا بلا مطل % 2(@)(@@) % وقد 
ms875	 يعد المرء البخيل كراهة % ألاء رجاء أن يعان على البذل % % 3(@)(@@) % وقال اعذروني إن بخلي جبلة % وإن يدي مخلوقة خلقة القفل % % 4(@)(@@) % طبيعة بخل أكدتها خليقة % تخلقتها خوف احتياجي إلى مثلي % % 5(@)(@@) % فألقى إلينا عذرة لانردها % % وكان ملقى حجة اللؤم والبخل % % PageV01P3468 البحر : - 1(@)(@@) % لاتسم الحمد أبا أحمد % فليس ذاك العلق من باله % 2(@)(@@) % فتى إذا حاولت معروفه % حملته أثقل أثقاله % % 3(@)(@@) % يستطرف الطارف من ماله % ويألف التالد من ماله % 4(@)(@@) % فليس في ماليه من مطمع % إذا عراه بعض سؤاله % % 5(@)(@@) % أحوجه إلى مثله الل % ه يوما لكي يجزى بأفعاله % % 6(@)(@@) % وقلل الأحياء من مثله % وكثر الموتى بأمثاله % % PageV01P3469 البحر : - 1(@)(@@) % قد بلى الله يونس بن بغاء % ببلاء النبي يونس قبله % 2(@)(@@) % يبلع الحوت بعضه كل يوم % % ليته يبلع المسكين جمله % % PageV01P3470 البحر : - 1(@)(@@) % وما في الناس أجود من شجاع % وإن أعطى القليل من النوال % 2(@)(@@) % وذلك أنه يعطيك مما % تفيء عليه أطراف العوالي % % 3(@)(@@) % وحسبك جود من أعطاك مالا % جباه بالطراد وبالنزال % % 4(@)(@@) % شرى دمه ليحويه فلما % % حواه حوى به حمد الرجال % % PageV01P3471 البحر : - 1(@)(@@) % ومولى يجر الشر لي غير مؤتل % % ويجني فيمضي وهو عني بمعزل % 2(@)(@@) % إذا كان زندا كنت مسعار ناره % وكم قادح نارا لآخر مصطلي % % 3(@)(@@) % سماك خرءا بخل % لاشك شيخ مغفل % 4(@)(@@) % لأن في الخرء نفعا % % للنخل والنخل يؤكل % % 5(@)(@@) % وأنت مافيك نفع % ولا لنفع تؤمل % 6(@)(@@) % فلست خرءا بخل % لكن صديد بحنظل % % 7(@)(@@) % وإن هذين عندي % % في الخلق منك لأمثل % % 8(@)(@@) % وللمنافع إن عد % دت المنافع أخيل % % PageV01P3472 البحر : - 1(@)(@@) % جاركم لا يعاد من علله % وضيفكم لا يسد من خلله % 2(@)(@@) % فاستعملوا الظلم والجفاء به % % فليس تلك السبيل من سبله % % 3(@)(@@) % ماضر مجفوكم جفاؤكم % % بالأمس في عيشه ولاأمله % % 4(@)(@@) % لاإن جفوتم قضى العليل ولا % % إن عدتم تنسئون في أجله % % PageV01P3473 البحر : - 1(@)(@@) % قصيدة كرها مثقفها % % عليك إذ ثقفت على مهل % 2(@)(@@) % أعجله الوقت عن رياضتها % % فأقبلت ريضا على عجل % % 3(@)(@@) % ثم استراضت فجاء مركبها % % ممتهد الظهر مردف الكفل % 4(@)(@@) % لم 
ms876	 أحتشم كرها عليك ولا % % سدد منها مواضع الخلل % % 5(@)(@@) % لأنني عالم بأنك لاتع % % تب فيما أصلحت من عملي % % 6(@)(@@) % وليس مثلي ينام عن خلل % في مدح ممدوحه ولازلل % 7(@)(@@) % لاسيما في مديح ممتدح % يحرم في مدح كل منتحل % % 8(@)(@@) % والشعر ماكان غير منتحل % يحرم في مدح كل منتحل % 9(@)(@@) % فليستعدها الأمير ثانية % على الذي في المعاد من ثقل % % 10(@)(@@) % وليحتمل عبده الأمير وإن % % ثقل تثقيل غير محتمل % % PageV01P3474 البحر : - 1(@)(@@) % لاح شيب فنهنه الحلم جهلا % % ومشى جائر على القصد رسلا % % 2(@)(@@) % إن في الحلم للسفاه وفي عي % % سى بن شيخ لكل عات لنكلا % % 3(@)(@@) % دانت الأرض سيف عيسى بن شيخ % خ مادانت الحليلة بعلا % % 4(@)(@@) % قام لله والإمام بحق % قد أطالت به الصناديد مطلا % % 5(@)(@@) % فتح المغلقات من سبل الأر % % ض وسد الثغور خيلا ورجلا % % 6(@)(@@) % قالت الحرب إذ تخمط عيسى % % يابن شيخ لقد تخمطت فحلا % % 7(@)(@@) % صال المشرفي صولات صدق % لم تدع فيهم لذي الذحل ذحلا % % 8(@)(@@) % وأخاف المخيف ذا العيث حتى % % أمن الخائف المشتت شملا % % 9(@)(@@) % قلت للسائلي بعيسى بن شيخ % زادك الله بالمعالم جهلا % % 10(@)(@@) % أنت كالمستضيء شمسا بنار % ولعمري للشمس للعين أجلى % % PageV01P3475 11(@)(@@) % كل مجد تراه في الناس حيا % هو أحياه بعدما مات هزلا % % 12(@)(@@) % كان عيسى في نشره ميت الجو % % د كعيسى مكلم الناس طفلا % % 13(@)(@@) % جبل عاصم وواد خصيب % لاترى الدهر في جنابيه محلا % % 14(@)(@@) % ذو أفاع لمن يعاديه صم % كائنات لمن يواليه نحلا % % 15(@)(@@) % تقلس الأري والسمام وناهي % % ك بهذا وذا شفاء وخبلا % % 16(@)(@@) % أوسع الراغبين فضلا كما أو % % سع أهل العناد نفيا وقتلا % % 17(@)(@@) % واحد الجود لاتمج سؤالا % أذناه ولاتليقان عدلا % % 18(@)(@@) % أيها الوافد الميمم عيسى % % اغترف لي من ذلك البحر سجلا % % 19(@)(@@) % ولك الله إن عرضت عليه % % حاجتي أن تقول أهلا وسهلا % 20(@)(@@) % ذاك ظني بسيد الناس طرا % وابن من سادهم غلاما وكهلا % % PageV01P3476 21(@)(@@) % قل له عن مؤمل من بعيد % ديمة من ندى يديه ووبلا % % 22(@)(@@) % إن جورا عمومك الناس بالفض % % ل 
ms877	 سوى واحد محق فعدلا % % 23(@)(@@) % لاتكن حسرة علي فقد أوسع % ت هذا الأنام غيري فضلا % % 24(@)(@@) % وشفيعي إليك حامل شعري % % وهو من لا تراه للرد أهلا % % 25(@)(@@) % مع أني إذا شفعت بأخلا % % قك كانت شفاعة الناس فضلا % % 26(@)(@@) % قد أردت الإطناب فيك فقالت % % لي غاياتك البعيدة مهلا % % 27(@)(@@) % ورأيت القليل يكفي من المد % % ح إذا المرء طاب فرعا وأصلا % % 28(@)(@@) % حسب ذي الهز باليسير من الهز % ز إذا النصل كان مثلك نصلا % % 29(@)(@@) % قد تثيب القليل مدحا من القو % % م كثيرا من المثوبة جزلا % % 30(@)(@@) % أبلها خلة برغم عدو % جعل الله خده لك نعلا % % PageV01P3477 31(@)(@@) % ورميت الذين ترمي فكانت % % لك آجالهم قسيا ونبلا % % 32(@)(@@) % لست أخشى صروف دهري إذا ما % % عقد الله لي بحبلك حبلا % % PageV01P3478 البحر : - 1(@)(@@) % قل لأبي سهل الذي ترك ال % % وعر بمعروفه وقد سهلا % % 2(@)(@@) % رأيتني يا أخا السماح وإي % اك عجيبا حديثنا مثلا % % 3(@)(@@) % تولي فأثني فتتبع النهل ال % % أول من عارفاتك العللا % % 4(@)(@@) % فهكذا دأبنا تجود فأن % أثنيت أتبعت ناقة جملا % % 5(@)(@@) % مانفل جاءني فقمت به % % في الناس إلا أردفته نفلا % % 6(@)(@@) % الله عوني على صنيعك بي % % فما أرى لي بحمله قبلا % % 7(@)(@@) % كلفت تخفيف ماامتننت به % % شكريك فازداد كاهلي ثقلا % % 8(@)(@@) % ياآل نوبخت لاعدمتكم % ولاتبدلت منكم بدلا % % 9(@)(@@) % إن صح علم النجوم كان لكم % % حقا إذا ما سواكم انتحلا % % 10(@)(@@) % كم عالم فيكم وليس بأن قا % % س ولكن بأن رقى فعلا % % PageV01P3479 11(@)(@@) % أعلاكم في السماء مجدكم % فلستم تجهلون ماجهلا % % 12(@)(@@) % شافهتم البدر في السؤال عن ال % % أمر إلى أن بلغتم زحلا % % 13(@)(@@) % وكل مابين ذا وذاك فما % % تخشون أني سلكتم الزللا % % 14(@)(@@) % لم تدركوا قط بالحساب بل ال % % أحساب علما لكم ولاعملا % % 15(@)(@@) % ماجعل الله بين علمكم % % وبينكم غير مجدكم وصلا % % PageV01P3480 البحر : - 1(@)(@@) % أجدر مال أن يكون نائلا % هدية تكسب شكرا عاجلا % % 2(@)(@@) % فبادر الآن الثناء الكاملا % % تلاق خلف الفكر منه حافلا % % 3(@)(@@) % واقسم لنا الكامخ قسما عادلا % قسم يد الله لك الفضائلا % % 4 
ms878	(@)(@@) % ولاترى فعلك فعلا خاملا % % إن أنت أسعفت صديقا مائلا % % 5(@)(@@) % بحاجة نزر فيها سائلا % % بل فاضل وافق شكرا فاضلا % % 6(@)(@@) % لن يرهب العدل ولا العواذلا % % في أن ينيل التحف القلائلا % % 7(@)(@@) % من قد أنال النعم الجلائلا % % وكان بالعرف سحابا هاطلا % % 8(@)(@@) % يتبع بالفرائض النوافلا % % أصاب حقا أم أصاب باطلا % % 9(@)(@@) % حاشاي أن يصبح رأيي فائلا % % فأغتدي أخرى الأنام قائلا % % 10(@)(@@) % وتغتدي أمنع خلق فاعلا % % أقسمت لولا أن أصيب عاذلا % % PageV01P3481 11(@)(@@) % أعمى عن المزح غبيا غافلا % يلزمني الجهل ولست جاهلا % % 12(@)(@@) % في أن مهرت كامخا عقائلا % % حوالي الأجياد لاعواطلا % % 13(@)(@@) % لقد جعلت القطر منها وابلا % % والظلف رأسا والذنابي كاهلا % % 14(@)(@@) % حتى تراها شردا مواثلا % % طوالع الأنجم لا أوافلا % % 15(@)(@@) % تنشدها المحافل المحافلا % % تولي الصديق نحلها العواسلا % % 16(@)(@@) % وشانئيك رقشها القواتلا % % وتورث الحساد خبلا خابلا % % 17(@)(@@) % ما خالفت قوائم جحافلا % % PageV01P3482 البحر : - 1(@)(@@) % ولما رأيت القيل ينبو شنيعه % % عن السمع لم أعدم لطاف المحايل % 2(@)(@@) % فصدرت أعجاز الهجاء مناسبا % تحط الوعول من رؤوس المعاقل % % 3(@)(@@) % ليخرقن أسداد المسامع قبله % % فينغل في أزرار تلك الغلائل % % PageV01P3483 البحر : - 1(@)(@@) % لعدوك الحد الأفل % ماعشت والخد الأذل % 2(@)(@@) % ولك اعتلاء الجد في % % خفض وعيش لا يمل % % 3(@)(@@) % ياحجة الله التي % % لخصيمها السعي الأضل % 4(@)(@@) % مازلت أعلم أن جي % % شا أنت فيه لا يفل % 5(@)(@@) % أنى ترادى صخرة % يردى بها الملك الأجل % 6(@)(@@) % نفسي فداؤك يوم أش % % به أورق القوم الأبل % % 7(@)(@@) % إذ كل رأي آفل % وهلال رأيك يستهل % 8(@)(@@) % أنت الذي نعش الموا % % لي رأيه حتى استقلوا % % 9(@)(@@) % من بعد ماكبت الجدو % % د بهم فأشفوا أو أضلوا % % 10(@)(@@) % لو لم تكن أنت الطبي % % ب لهم هناك ماأبلوا % % PageV01P3484 11(@)(@@) % شمرت نحو عدوهم % % وكأنك السمع الأزل % 12(@)(@@) % وتلوك في سنن الرشا % % د فشمروا ثم اشمعلوا % % 13(@)(@@) % ولرب شمير يجر % % ر بعقبه الذيل الرفل % 14(@)(@@) % فثنوا أعنتهم بعز % ز باذخ لا يستذل % 15(@)(@@) % بك أفلح السيف الحسا % % م وأنجح الرمح المتل % 16(@)(@@) % لولاك جارا عن مقا % % تل معشر جاروا وضلوا % % 17 
ms879	(@)(@@) % لكن أريتهما الهدى % % بمعالم لك لاتضل % 18(@)(@@) % وعقدت من عقد المكا % % يد للعدا مالا يحل % 19(@)(@@) % تلك التي من زاولت % فعروش دولته تثل % % 20(@)(@@) % صفرت يد الصفار بل % % شلت وحق لها تشل % PageV01P3485 21(@)(@@) % أرمت سوادا أنت في % % ه لقد أتت أمرا يجل % 22(@)(@@) % ماأطلقت في ذاك إل % % لا حين آن لها تغل % 23(@)(@@) % مل الذين اشتاقهم % % عند اللقاء ولم يملوا % % 24(@)(@@) % وسلاهم وبصدره % منهم غليل لا يبل % 25(@)(@@) % ولى يرى الأرض العري % % ضة ماله فيها محل % 26(@)(@@) % ويرى جوارح جسمه % % وأخفهن عليه كل % 27(@)(@@) % لايطمئن من الحذا % % ر به المبيت ولاالمظل % 28(@)(@@) % بيناه في جيش كرك % % ن متالع إذ قيل فل % 29(@)(@@) % كثر الثرى بجنوده % % لكن محقتهم فقلوا % % 30(@)(@@) % وضربتهم بسيوف كي % % د مغمدات لاتسل % PageV01P3486 31(@)(@@) % لو هز أدناها الأشل % ل فرى الحديد بها الأشل % 32(@)(@@) % قد طال ماغلب الكثي % % ر من العديد بها الأقل % 33(@)(@@) % لولا الذي أبلت لما أغ % % نى سيوف الهند سل % 34(@)(@@) % شرعت شرائع للظبا % % فيها لها نهل وعل % 35(@)(@@) % فانصاع جمع المارقي % % ن كأنهم نعم تشل % 36(@)(@@) % ولوا وحب قلوبهم % % بالطعن من دبر يحل % 37(@)(@@) % والأرض تسقى من دما % % ئهم فتوبل أو تطل % % 38(@)(@@) % فبكل قاع منهم % بطل لجبهته يتل % 39(@)(@@) % يتلاومون وينشدو % % ن من الهوادة ماأضلوا % % 40(@)(@@) % لازلت نجما يهتدى % % بك في الظلام ويستدل % PageV01P3487 41(@)(@@) % مردى خطوب للملو % % ك برأيه عقد وحل % 42(@)(@@) % ينبوع حزم يستقى % % منه الصواب ويستمل % 43(@)(@@) % في ظل عيش لا يزا % % ل من النعيم عليه ظل % 44(@)(@@) % تضفو عليك فضوله % % فيعاش فيه ويستظل % PageV01P3488 البحر : - 1(@)(@@) % قومي بنو العباس حلمهم % حلمي هواك وجهلهم جهلي % % 2(@)(@@) % نبلي نبالهم إذا نزلت % بي شدة ونبالهم نبلي % % 3(@)(@@) % لاأبتغي أبدا بهم بدلا % لف الإله بشملهم شملي % % 4(@)(@@) % ومتى وردت حياضهم معهم % % لم يشربوا صفواتها قبلي % % 5(@)(@@) % قوم غدا بري وتكرمتي % % من شغلهم ومديحهم شغلي % % 6(@)(@@) % المنعمون علي أنعمهم % % والحامدون لكل ماأبلي % % 7(@)(@@) % أنا منهم بقضاء من ختمت % % رسل الإله به وهم أهلي % % 8(@)(@@) % مولاهم وغذي 
ms880	 نعمتهم % % والروم حين تنصني أصلي % % 9(@)(@@) % حكماء هذا الناس روقتهم % % أتعيب اصلي ويك أم فصلي % % 10(@)(@@) % ومتى اعتصمت بهم فهم جبلي % % ومتى رعيتهم فهم سهلي % % PageV01P3489 11(@)(@@) % ومتى صفدت ففضلهم صفدي % % ومتى أجرت فحبلهم حبلي % % 12(@)(@@) % ومتى دعوتهم لنائبة % حدبوا علي ولم يروا خذلي % % 13(@)(@@) % يهبون دون دمي دماءهم % وأرى قليلا دونهم قتلي % % 14(@)(@@) % وإذا غدوت وجمعهم حشدي % % لم تستطع خيلي ولا رجلي % % 15(@)(@@) % يامن يميل إلى عدوهم % ماأنت من جدي ولاهزلي % % 16(@)(@@) % من لا يرى شمسي إذا طلعت % فقد استقاد عماه لي تبلي % % 17(@)(@@) % حسبي عماه من عقوبته % % وكفاه من عذل امرىء عذلي % % 18(@)(@@) % لايأملن معاشر جيف % جزري خباءثهم ولاأكلي % % 19(@)(@@) % أكرمت نصلي عن لحومهم % وخلقت يعرف مضربي نصلي % % PageV01P3490 البحر : - 1(@)(@@) % إن أنت لم ترع وأنت المفضال % لنا حقوقا أوجبتها أقوال % 2(@)(@@) % فيها أماديح صياب أمثال % فلترع فينا لاعدتك الآمال % 3(@)(@@) % حق الذي أعطاك وهو الفعال % % أنك مسئول وأنا سؤال % % 4(@)(@@) % تفاوتت منا ومنك الحال % % فأنت معمور ونحن أعطال % % 5(@)(@@) % وأنت موسوم ونحن أغفال % % سالمك المال وعادانا المال % % 6(@)(@@) % وشكر تفضيل الرجال الأفضال % % فافعل جميلا ساعدتك الأفعال % % PageV01P3491 البحر : - 1(@)(@@) % ياراغبا نزعت به الآمال % ياراهبا قذفت به الأوجال % 2(@)(@@) % ذهب النوال فما يحس نوال % وعفا الفعال فما يحس فعال % 3(@)(@@) % أودى الزمان بمن يعلم أهله % كيف النعيم فكيف ينعم بال % 4(@)(@@) % سلب الزمان جماله عن نفسه % فغدا وراح وما عليه جمال % 5(@)(@@) % ذهب الذي هبت يداه وفيهما % % للراغبين مناله ومصال % 6(@)(@@) % ذهب الذي نالت يداه من العلا % % مالاينال من المديح مقال % 7(@)(@@) % ياسوءتا للأرض كيف تماسكت % وقد استزيل وحقها الزلزال % % 8(@)(@@) % وكفى من الزلزال بعد محمد % أن ليس يعرف بعده إفضال % 9(@)(@@) % ذهب الذي كان الصيام شعاره % % ولضيفه الإنزال والآكال % % 10(@)(@@) % فكأنه رمضان في إخباته % % وكأنه في جوده شوال % PageV01P3492 11(@)(@@) % ذهب الذي أوصاه آدم إذ مضى % % بعياله فهم عليه عيال % 12(@)(@@) % ذهب الذي ماكان يمطل وعده % % وله إذا جارى السماح مطال % 13(@)(@@) % أودى محمد بن نصر بعدما % % ضربت به في سروه 