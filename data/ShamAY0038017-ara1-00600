ms581	 عن: عبد الله بن عمرو، روى عنه: عمرو بن دينار.(@)(@@) صهيب(@)(@@) مولى العتواريين، من أهل المدينة، يروي عن: أبي هريرة وأبي سعيد الخدري، روى عنه: نعيم بن عبد الله المجمر.(@)(@@) صهيب(@)(@@) يروي عن: سفينة، روى عنه: عمرو بن يزيد الأموي.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صبيح(@)(@@) مولى آل سعيد بن العاص، وهو والد مسلم بن صبيح، يروي عن: أبي هريرة، روى عنه: أبو يعفور.(@)(@@) صبيح(@)(@@) مولى زيد بن أرقم، ويقال: مولى أم سلمة، يروي عن: زيد بن أرقم، روى عنه: السدي.(@)(@@)(@@)(@@) ||| AUTO صبيح بن عميرة(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: سماك بن حرب.(@)PageV01P002(@)(@@) [ج 2: ص 238](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صبيح بن عبد الله العبسي(@)(@@) يروي عن: عمر، وعثمان، روى عنه: سماك بن حرب.(@)(@@) صبيح(@)(@@) مولى عبد الله بن رباح، كان كاتبا لعبد الله بن عمر، روى عنه: عبد الرحمن بن عبد الله المكي.(@)(@@)(@@)(@@) ||| AUTO صعصعة بن صوحان(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: أبو إسحاق، وعبد الله بن بريدة، وهو أخو زيد بن صوحان، يخطئ.(@)(@@)(@@)(@@) ||| AUTO صعصعة بن يزيد(@)(@@) يروي عن: ابن عباس، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO صعصعة بن مالك(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه زفر بن صعصعة.(@)(@@)(@@)(@@) ||| AUTO صعصعة بن معاوية(@)(@@) عم الأحنف بن قيس، يروي عن: أبي ذر، روى عنه: الحسن، كنيته أبو أيوب، مات في أول ولاية الحجاج على العراق.(@)(@@)(@@)(@@) ||| AUTO صلة بن زفر أبو العلاء العبسي(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، وحذيفة، روى عنه: أبو وائل، والشعبي، مات في خلافة ابن الزبير.(@)(@@)(@@)(@@) ||| AUTO صلة بن أشيم العدوي، أبو الصهباء(@)(@@) من عباد أهل البصرة وزهادهم، روى عنه: أهلها، قتل سنة خمس وسبعين بكابل في أول ولاية الحجاج بن يوسف، وقد قيل: إن أبا الصهباء قتل في ولاية يزيد بن معاوية.(@)PageV01P002(@)(@@) [ج 2: ص 239](@)(@@)(@@)(@@) ||| AUTO صهبان بن عبد الجبار بن مالك اللخمي، أبو طلاسة(@)(@@) من أهل بيت المقدس، سمع عمر بن الخطاب، روى عنه: أهل فلسطين.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صيفي بن صهيب بن سنان 
ms582	(@)(@@) مولى ابن جدعان التيمي القرشي، من النمر بن قاسط، يروي عن: أبيه، روى عنه: عمرو بن دينار القهرمان، وابناه زياد، ويزيد ابنا صيفى.(@)(@@)(@@)(@@) ||| AUTO صيفي أبو زياد(@)(@@) مولى أفلح مولى أبي أيوب الأنصاري، يروي عن: أبي سعيد الخدري، وأبي اليسر كعب بن عمرو، عداده في أهل المدينة، روى عنه: عبيد الله بن عمر، وسعيد بن أبي هلال.(@)(@@) صيفي(@)(@@) شيخ، يروي عن: أبي اليسر كعب بن عمرو، روى عنه: عبد الله بن سعيد بن أبي هند، إن لم يكن الأول فلا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO صيفي بن بشر(@)(@@) يروي عن: أبي موسى الأشعري، روى عنه: أبو عمران الجوني.(@)(@@)(@@)(@@) ||| AUTO صحار بن أبجر بن جابر العجلي(@)(@@) يروي عن: ابن مسعود، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO صخر بن أبي سمية(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO صخر بن مالك(@)(@@) يروي عن: أبي أمامة، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO الصبي بن معبد التغلبي(@)(@@) من أهل الكوفة، يروي عن: عمر، روى عنه: أبو وائل، ومجاهد.(@)PageV01P002(@)(@@) [ج 2: ص 240](@)(@@)(@@)(@@) ||| AUTO صعب العنزي، ويقال: صعيب، كنيته أبو العيوف(@)(@@) يروي عن: أسماء بنت أبي بكر، روى عنه: أبو الغريف الهمداني، ومجمع بن يحيى.(@)(@@)(@@)(@@) ||| AUTO صقير العبدي(@)(@@) يروي عن: سليمان بن صرد وله صحبة، روى عنه: أبو إسحاق الهمداني.(@)(@@)(@@)(@@) ||| AUTO صبيح أبو العلاء(@)(@@) يروي عن: أنس بن مالك، روى عنه: حماد بن سلمة، وعبد العزيز بن المختار.(@)(@@)(@@)(@@) ||| AUTO صديق بن موسى(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم ويروي عن: المدنيين، روى عنه: عثمان بن أبي سليمان، وابن ابنه عتيق بن يعقوب بن صديق الزبيري.(@)(@@)(@@)(@@) ||| AUTO صريع(@)(@@) شيخ، يروي عن: عائشة، روى عنه: الوليد بن أبي مالك. النساء:(@)(@@)(@@)(@@) ||| AUTO صفية بنت الحارث(@)(@@) تروي عن: عائشة: " لا يقبل الله صلاة امرأة حاضت بغير خمار ". روى عنها: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO صفية بنت أبي عبيد(@)(@@) امرأة عبد الله بن عمر بن الخطاب، وهى أخت المختار بن أبي 
ms583	 عبيد المتنبي بالعراق، تروي عن: حفصة، وعائشة زوجتي رسول الله صلى الله عليه وسلم روى عنه: نافع مولى ابن عمر، وعمر بن عثمان بن عبد الدار القرشي.(@)(@@)(@@)(@@) ||| AUTO صفية بنت شيبة بن عثمان بن طلحة الحجبي(@)(@@) تروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 241] عائشة، وأم حبيبة، عدادها في أهل المدينة، روى عنها: نافع، وابنها منصور بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO صفية بنت بحرة(@)(@@) قالت: رأيت لأبي محذورة قصة في مقدم رأسه يرسلها، فقلت له: ألا تحلقها، قال: " لا إن رسول الله صلى الله عليه وسلم وضع يده عليها ". روى عنها: أيوب بن ثابت.(@)(@@)(@@)(@@) ||| AUTO صميتة(@)(@@) خالة أبي نعامة العدوي، تروي عن: جدها سلمان بن عامر، روى عنها: أبو نعامة العدوي.(@)(@@)(@@)(@@) || AUTO باب الضاد(@)(@@) قال أبو حاتم:(@)(@@) وممن شافه الصحابة وروى عنهم ممن ابتدأ اسمه على الضاد:(@)(@@)(@@)(@@) ||| AUTO الضحاك بن قيس الكندي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: محمد بن المنتشر، والمسعودي، قتل في سنة سبع وعشرين ومائة، وذلك أنه لم يبايع مروان بن محمد الحمار، فاجتمع إليه جلة الناس، والتقى هو ومروان بنصيبين، فقالوا للضحاك: " والله ما اجتمع إلى داع دعي إلى هذا الرأي منذ كان الإسلام ما اجتمعك، فتأخر وقدم خيلك ورجلك، وتلقى هذه الطاغية، فقال: إي والله ما لي في دنياكم هذه حاجة، وإنما أردت هذه الطاغية لله على أن رأيته أن أحمل عليه حتى يحكم الله بيني وبينه، وعلي الدين سبعة دراهم وفي كمي منها ثلاثة دراهم، ثم اقتتلوا فقتل الضحاك في المعركة سنة سبع وعشرين ومائة ".(@)(@@)(@@)(@@) ||| AUTO الضحاك بن عبد الرحمن بن عرزب الشامي الأشعري(@)(@@) من أهل الشام، كنيته أبو زرعة، يروي عن: أبي موسى، وأبي هريرة، وواثلة، روى عنه: مكحول وأهل الشام، وهو الذي يقال له: ابن عزرم بالميم والصحيح بالباء، وكان يسكن قرية يقال لها: كوكب من كورة نابلس من تخوم الأردن.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن فيروز الديلمي(@)(@@) يروي عن: أبيه، روى عنه: أبو وهب الجيشاني.(@)PageV01P002(@)(@@) [ج 2: ص 242](@)(@@)(@@)(@@) ||| AUTO الضحاك بن رباح(@)(@@) يروي عن: ابن عمر، روى عنه: 
ms584	 يحيى بن أبي عمرو الشيباني.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن عبد الله القرشي(@)(@@) يروي عن: أنس بن مالك، روى عنه: بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن زميل الأملوكي(@)(@@) يروي عن: ابن عباس، روى عنه: عياش بن عباس القتباني.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن شرحبيل المشرقي(@)(@@) يروي عن: أبي سعد الخدري، روى عنه: الزهري، وحبيب بن أبي ثابت، ويقال: ابن شراحيل.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن شرحبيل العكي(@)(@@) أصله من عكة، انتقل إلى مصر، يروي عن: ابن عمر، روى عنه: موسى بن أيوب الغافقي.(@)(@@)(@@)(@@) ||| AUTO ضمرة بن عبد الله بن أنيس الجهني(@)(@@) يروي عن: أبيه، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO ضمرة بن سعيد المازني الأنصاري(@)(@@) من أهل المدينة، يروي عن: أبي سعيد الخدري، روى عنه: مالك، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO ضمرة بن حبيب بن صهيب الزبيدي الشامي، كنيته أبو عتبة، وقد قيل: أبو بشر(@)(@@) يروي عن: أبي أمامة، وسلمة بن نفيل السكوني، روى عنه: هلال بن يساف، والشاميون، مات سنة ثلاثين ومائة، وكان مؤذن مسجد دمشق.(@)PageV01P002(@)(@@) [ج 2: ص 243](@)(@@)(@@)(@@) ||| AUTO ضمضم بن الحارث بن جوس الهفاني(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي كثير، وعكرمة بن عمار، ومن قال: ضمضم بن جوس فقد نسبه إلى جده.(@)(@@)(@@)(@@) ||| AUTO ضمضم أبو المثنى الأملوكي الحمصي(@)(@@) من أهل الشام، يروي عن: عتبة بن عبد السلمي، وهذا الذي يقال له: المليكي، روى عنه: صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO ضمضم بن عمرو الحنفي، كنيته أبو الأسود(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: التبوذكي.(@)(@@)(@@)(@@) ||| AUTO ضرار بن عمران البرجمي:(@)(@@) (165) -[2: 243] سألت ابن عمر، فقلت: " رجل له امرأة وله أم ولد، أما يقسم لها كما يقسم للحرة؟ قال: أليست أمة؟ قال: نعم، قال: فلا ". رواه ابن المبارك، عن الأصبغ بن علقمة، عن ضرار بن عمران، وقال الفضل بن موسى، عن الأصبغ بن علقمة، عن ضرار بن عبد الرحمن، قال: سألت ابن عمر(@)(@@)(@@)(@@) ||| AUTO ضرار بن مسلم الباهلي(@)(@@) يروي عن: أنس بن مالك، روى عنه: عمر بن أبي خليفة.(@)(@@)(@@)(@@) ||| AUTO ضبة بن محصن 
ms585	 العنزي(@)(@@) من أهل البصرة، يروي عن: أبي هريرة، وأم سلمة، روى عنه: قتادة، والحسن، وعبد الرحمن بن أبي ليلى، وقد سمع عمر بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO ضريب بن نقير بن سمير القيسي(@)(@@) من قيس بن ثعلبة، أبو السليل الجريري، من أهل البصرة، يروي عن: أبي ذر، روى عنه: كهمس بن الحسن، وسعيد بن PageV01P002 [ج 2: ص 244] إياس الجريري.(@)(@@) (166) -[2: 244] ثنا أبو قتيبة، عن ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا كهمس بن الحسن، عن أبي السليل، عن أبي ذر، قال: جعل نبي الله " يقرأ هذه الآية {ومن يتق الله يجعل له مخرجا {2} ويرزقه من حيث لا يحتسب}، ثم قال: يا أبا ذر، لو أن الناس أخذوا بها لكفتهم "(@)(@@)(@@)(@@) ||| AUTO ضبيعة بن حصين(@)(@@) يروي عن: حذيفة، روى عنه: أبو بردة.(@)(@@)(@@)(@@) ||| AUTO الضوء بن الصلصال بن الدلهمس(@)(@@) يروي عن: أبيه وله صحبة، روى عنه: ابنه محمد بن الضوء، يعتبر حديثه من غير رواية ابنه عنه.(@)(@@)(@@)(@@) || AUTO باب الطاء(@)(@@) قال أبو حاتم:(@)(@@) وممن شافه الصحابة، وروى عنهم ممن ابتدأ اسمه على الطاء:(@)(@@)(@@)(@@) ||| AUTO طاوس بن كيسان اليماني الهمداني، كنيته أبو عبد الرحمن(@)(@@) أمه من أبناء فارس وأبوه من النمر بن قاسط، مولى بحير الحميري، يروي عن: ابن عمر، وابن عباس، كان من عباد أهل اليمن، ومن فقهائهم، ومن سادات التابعين، روى عنه: عمرو بن دينار، والناس، مرض بمنى، مات بمكة سنة إحدى ومائة قبل التروية بيوم قبل مجاهد بسنتين وصلى عليه هشام بن عبد الملك بين الركن والمقام، وقد قيل: إنه مات سنة ست ومائة، وكان طاوس قد حج أربعين حجة، وكان مستجاب الدعوة فيما قيل.(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الله بن عوف بن عبد عوف الزهري(@)(@@) ابن أخي عبد الرحمن بن عوف، يروي عن: أبي هريرة، وعمه، كنيته أبو عبد الله، وكان فقيها يكتب الوثائق، وكان يقال له: طلحة الندى لجوده، روى عنه الزهري، مات بالمدينة سنة سبع وتسعين، وهو ابن ثنتين وسبعين سنة، وأمه فاطمة بنت مطيع بن الأسود.(@)PageV01P002(@)(@@) [ج 2: ص 
ms586	 245](@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الله بن عثمان بن عبيد الله بن معمر التيمي(@)(@@) يروي عن: عائشة، روى عنه: أبو عمران الجوني، وسعد بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق(@)(@@) يروي عن: عائشة، وأسماء بنت أبي بكر، روى عنه: عثمان بن أبي سليمان، وابنه محمد بن طلحة.(@)(@@)(@@)(@@) ||| AUTO طلحة بن هلال العامري(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: سعد بن إبراهيم.(@)(@@) (167) -[2: 245] ثنا عمر بن محمد الهمداني، ثنا أبو الأشعث أحمد بن المقدام العجلي، ثنا محمد بن بكر البرساني، عن شعبة، عن سعد بن إبراهيم، قال: سمعت طلحة بن هلال رجلا من بني عامر، قال: سمعت عبد الله بن عمرو، يقول: قال رسول الله صلى الله عليه وسلم: " يا عبد الله بن عمرو، صم صيام الدهرف من جاء بالحسنة فله عشر أمثالهاق، فقلت: إني أطيق أكثر من ذلك، قال: صم صيام داود، وكان يصوم يوما ويفطر يوما "(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبيد الله بن كريز الكعبي الخزاعي(@)(@@) عداده في أهل المدينة، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: محمد بن سوقة.(@)(@@)(@@)(@@) ||| AUTO طلحة بن نافع المكي، أبو سفيان(@)(@@) مولى قريش، يروي عن: جابر بن عبد الله وأبي سعيد الخدري، روى عنه: الأعمش، وعتبة بن أبي حكيم، والناس، وكان الأعمش يدلس عنه.(@)(@@)(@@)(@@) ||| AUTO طلحة بن مصرف بن كعب بن عمرو بن جحدب بن معاوية بن سعد بن الحارث(@)(@@) من ذهل بن سلمة، كنيته أبو عبد الله الإيامي، من أهل الكوفة، يروي عن: ابن أبي أوفى، وأنس، روى عنه: أهل الكوفة، مات سنة ثنتي عشرة ومائة قبل زبيد بعشر سنين.(@)(@@) (168) -[2: 245] ثنا أبو قحطبة، قال: ثنا العباس بن عبد العظيم العنبري، قال: ثنا أبو مهدي، عن مالك بن مغول، عن طلحة بن مصرف، قال: سألت ابن أبي أوفى: هل أوصى رسول الله صلى الله عليه وسلم قال: لا. قلت: فلم كتب على الناس الوصية، قال: " أوصى بكتاب الله "(@)PageV01P002(@)(@@) [ج 2: ص 246](@)(@@)(@@)(@@) ||| AUTO طلحة 
ms587	 بن يزيد الأنصاري(@)(@@) يروي عن: زيد بن أرقم، روى عنه: عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO طلحة بن أبي حدرد(@)(@@) يروي المراسيل، روى عنه: محمد بن معن الغفاري، عن عمه، عنه.(@)(@@)(@@)(@@) ||| AUTO طلحة بن خراش بن عبد الرحمن بن خراش بن الصمة السلمي الأنصاري(@)(@@) من أهل المدينة، يروي عن: جابر بن عبد الله، روى عنه: موسى بن إبراهيم بن كثير بن بشير بن الفاكه الأنصاري، ويحيى بن عبد الله بن يزيد بن أنيس.(@)(@@)(@@)(@@) ||| AUTO طلحة بن أبي طلحة العنبري(@)(@@) يروي عن: أنس بن مالك، روى عنه: محمد بن ثابت.(@)(@@)(@@)(@@) ||| AUTO طلحة بن العلاء أبو العلاء(@)(@@) يروي عن: ابن عمر، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO طلحة بن جبر(@)(@@) شيخ، يروي عن: أبي جحيفة، روى عنه: وكيع.(@)(@@)(@@)(@@) ||| AUTO طلحة بن رافع(@)(@@) يروي المراسيل، روى عنه: صالح بن كيسان.(@)(@@)(@@)(@@) ||| AUTO طلحة بن أبي حفصة الحضرمي(@)(@@) يروي عن: عمر، روى عنه: عبد الله بن كثير، ويقال: ابن أبي حفصة.(@)(@@)(@@)(@@) ||| AUTO طارق بن عبد الرحمن البجلي(@)(@@) من أهل الكوفة، يروي عن: ابن PageV01P002 [ج 2: ص 247] أبي أوفى، روى عنه: الثوري، وشعبة.(@)(@@)(@@)(@@) ||| AUTO طارق بن عبد الرحمن بن القاسم القرشي(@)(@@) يروي عن: ميمونة، روى عنه: عكرمة بن عمار، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO طارق بن قرة(@)(@@) يروي عن: علي، روى عنه: شبيب بن غرقدة.(@)(@@)(@@)(@@) ||| AUTO طارق بن أحمر(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الكريم بن مالك.(@)(@@)(@@)(@@) ||| AUTO طارق بن مخاشن الأسلمي(@)(@@) يروي عن: أبي ذر، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO طارق بن زياد(@)(@@) يروي عن: علي، روى عنه: إبراهيم بن عبد الأعلى.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO طريف بن مجالد أبو تميمة الهجيمي(@)(@@) من أهل البصرة، يروي عن: أبي موسى وأبي هريرة، روى عنه: قتادة، وحكيم الأثرم، مات سنة خمس وتسعين، وقد قيل: سنة سبع وتسعين.(@)(@@)(@@)(@@) ||| AUTO طريف البراد(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO طريف بن يزيد الحنفي(@)(@@) يروي عن: أبي موسى، روى عنه: أهل اليمامة.(@)(@@) طريف(@)(@@) يروي عن: علي، روى عنه: ابناه 
ms588	 محمد، وموسى ابني طريف.(@)(@@)(@@)(@@) ||| AUTO طريف العكي(@)(@@) يروي عن: علي، قال: " من عرض عرضنا له بالسيف ". روى عنه: جابر الجعفي، لست أدري أهو الأول أم لا.(@)PageV01P002(@)(@@) [ج 2: ص 248](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO طريف البراد(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن عبد الرحمن بن عبد الله.(@)(@@) طريف(@)(@@) يروي عن: ابن عباس، روى عنه: الأعمش.(@)(@@)(@@)(@@) ||| AUTO طلق بن خشاف(@)(@@) من بني بكر بن وائل ثم من بني قيس بن ثعلبة، يروي عن: عثمان، وعائشة، روى عنه: سواد بن مسلم، ومسلم بن أبي الأسود.(@)(@@)(@@)(@@) ||| AUTO طلق بن حبيب العنزي(@)(@@) يروي عن: جابر، وابن الزبير، وأنس، وكان عابدا مرجئيا، روى عنه: أيوب، وعمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO طليق بن محمد(@)(@@) شيخ، عن: عمران بن حصين، روى عنه: سليمان التيمي.(@)(@@)(@@)(@@) ||| AUTO طليق بن قيس(@)(@@) أخو عبد الرحمن بن قيس أبي صالح، يروي عن: أبي الدرداء، وابن عباس، روى عنه: عبد الله بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الطفيل بن سخبرة(@)(@@) من أزد شنوءة، أخو عائشة لأمها أمهما أم رومان وهو، يروي عن: عائشة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO الطفيل بن أبي بن كعب الأنصاري المدني(@)(@@) يروي عن: أبيه، وابن عمر، روى عنه: عبد الله بن محمد بن عقيل، وكان صديقا لابن عمر، كنيته: أبو بطن، أمه بنت طفيل بن عمرو، وقد كان عظيم البطن يكنى به.(@)(@@)(@@)(@@) ||| AUTO طالوت بن أبي بكر بن خالد بن عرفطة العرفطي(@)(@@) حليف بني زهرة، يروي PageV01P002 [ج 2: ص 249] عن: عمر، روى النضر بن إسماعيل، عن أبي طالوت عنه، روى علي بن مسمى، عن عبد الرحمن بن إسحاق، عن طالوت بن أبي بكر، عن ابن عباس.(@)(@@)(@@)(@@) ||| AUTO طالوت أبو سعيد القرشي(@)(@@) يروي عن: ابن عباس، روى عنه: العلاء بن المسيب.(@)(@@)(@@)(@@) ||| AUTO طرفة المسلي(@)(@@) يروي عن: علي، وحذيفة، روى عنه: سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO طرفة الحضرمي(@)(@@) يروي عن: ابن أبي أوفى، روى عنه: محمد بن جحادة.(@)(@@)(@@)(@@) ||| AUTO طيسلة بن مياس(@)(@@) يروي عن: ابن عمر، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO طيسلة المازني(@)(@@) يروي عن: أعشى بني 
ms589	 مازن، روى عنه: ابنه صدقة بن طيسلة.(@)(@@)(@@)(@@) ||| AUTO طيسلة بن علي البهدلي(@)(@@) من أهل اليمامة، يروي عن: ابن عمر في الكبار السبع، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO طحرب(@)(@@) شيخ، يروي عن: الحسن بن علي، روى عنه: مجالد بن سعيد. النساء:(@)(@@)(@@)(@@) ||| AUTO طليحة بنت ربيعة بن الحارث(@)(@@) تروي عن: عائشة، روى عنها: أهل الكوفة.(@)(@@) (169) -[2: 249] حدثنا ابن مكرم، ثنا معمر بن سهل، قال: ثنا عامر بن مدرك، قال: ثنا عيسى بن عبد الرحمن البجلي، عن أمه طليحة بنت ربيعة بن الحارث، قالت: سألت عائشة عن العمرة في ذي الحجة، فقالت: أنا " اعتمرت في ذي الحجة، فقلت: يا رسول الله، أحرم نساؤك بحجة وعمرة غيري، فأمر أخي فأخرجني التنعيم "(@)PageV01P002(@)(@@) [ج 2: ص 250](@)(@@)(@@)(@@) || AUTO باب الظاء(@)(@@) قال أبو حاتم:(@)(@@) وممن سمع من الصحابة، وروى عنهم ممن ابتدأ اسمه على الظاء:(@)(@@)(@@)(@@) ||| AUTO ظبيان بن صبيح الضبي(@)(@@) يروي عن: ابن مسعود، قال: لا يقام الحد في المسجد، روى عنه: مبارك بن فضالة.(@)(@@)(@@)(@@) ||| AUTO ظبيان بن عمارة الكوفي(@)(@@) يروي عن: علي، روى عنه: سويد أبو قطبة.(@)(@@)(@@)(@@) ||| AUTO ظالم بن عمرو بن جندل بن سفيان بن يعمر بن حلبس بن نفاتة بن عدي بن الديل، أبو الأسود الديلي(@)(@@) يروي عن: عمران بن حصين، روى عنه: أهل البصرة، وقد قيل: اسم أبي الأسود عمرو بن ظالم، وشهد مع علي صفين، وولى البصرة لابن عباس، ومات بها وقد أسن، وهو أول من تكلم في النحو.(@)(@@)(@@)(@@) ||| AUTO أبو صفرة العتكي(@)(@@) والد المهلب بن أبي صفرة، اسمه ظالم بن بشر بن صبح، أدرك جماعة من الصحابة، روى عنه: ابنه المهلب.(@)PageV01P002(@)(@@) [ج 2: ص 251] بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) || AUTO باب العين(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن الصحابة، وشافههم في الأقاليم ممن ابتدأ اسمه على العين:(@)(@@)(@@)(@@) ||| AUTO أبو سلمة بن عبد الرحمن بن عبد عوف بن الحارث بن زهره بن كلاب بن مره بن كعب بن لؤي بن غالب الزهري القرشي(@)(@@) وأمه تماضر بنت الأصبغ بن عمرو بن ثعلبة بن حصين بن ضمضم بن 
ms590	 عدي بن كلب، وهى أول كلبيه تزوجها قرشي في الإسلام، وذاك أن رسول الله صلى الله عليه وسلم بعث عبد الرحمن بن عوف إلى كلب، وأمره أن يتزوج بنت سيدهم، وكان الأصبغ سيدهم فتزوج بابنته، كان مالك بن أنس يقول: أبو سلمه بن عبد الرحمن اسمه كنيته، وقال: محمد بن عمرو اسمه عبد الله، يروي عن: ابن عباس، وأبي هريرة، وابن عمر، روى عنه: الزهري، والناس، وكان من سادات قريش، مات سنة أربع ومائه، وقد قيل: سنة أربع وتسعين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد الله بن أبي مليكه بن عبد الله بن جدعان بن عمرو بن كعب القرشي التيمي، كنيته أبو بكر، وقد قيل: أبو محمد(@)(@@) وكان أحول، رأى ثمانين من أصحاب النبي صلى الله عليه وسلم وأمه ميمونه بنت الوليد بن أبي حسين بن عامر بن الحارث بن نوفل بن عبد مناف المليكي، يروي عن: ابن عباس، وابن الزبير، وعائشة، روى عنه: ابن جريج، والناس، مات سنة سبع عشرة ومائة، وقد قيل: سنة ثمان عشرة ومائه، واسم أبي مليكه زهير بن عبد الله بن جدعان.(@)(@@)(@@)(@@) ||| AUTO أبو قلابة عبد الله بن زيد الجرمي(@)(@@) من عباد أهل البصرة PageV01P002 [ج 2: ص 252] وزهادهم، يروي عن: أنس بن مالك، ومالك بن الحويرث، روى عنه: أيوب، وخالد، مات بالشام سنة أربع ومائة، في ولاية يزيد بن عبد الملك.(@)(@@) (170) -[2: 252] حدثني بقصة موته محمد بن المنذر بن سعيد، قال: ثنا يعقوب بن إسحاق بن الجراح، قال: ثنا الفضل بن عيسى، عن بقية بن الوليد، قال: ثنا الأوزاعي، عن عبد الله بن محمد، قال: " خرجت إلى ساحل البحر مرابطا وكان رابطنا يومئذ عريش مصر، قال: فلما انتهيت إلى الساحل فإذا أنا ببطيحة، وفي البطيحة خيمة فيها رجل قد ذهب يداه ورجلاه، وثقل سمعه وبصره، وما له من جارحة تنفعه إلا لسانه، وهو يقول: اللهم أوزعني أن أحمدك حمدا أكافئ به شكر نعمتك التي أنعمت بها علي، وفضلتني على كثير ممن خلقت تفضيلا، قال الأوزاعي: قال عبد الله: 
ms591	 قلت: والله لأتين هذا الرجل، ولأسألنه أنى له هذا الكلام، فهم، أم علم، أم إلهام ألهم، فأتيت الرجل فسلمت عليه، فقلت: سمعتك وأنت تقول: اللهم أوزعني أن أحمدك حمدا أكافئ به شكر نعمتك التي أنعمت بها علي، وفضلتني على كثير ممن خلقت تفضيلا، فأي نعمة من نعم الله عليك تحمده عليها، وأي فضيلة تفضل بها عليك تشكره عليها، قال: وما ترى ما صنع ربي، والله لو أرسل السماء علي نارا فأحرقتني، وأمر الجبال فدمرتني، وأمر البحار فغرقتني، وأمر الأرض فبلعتني ما ازددت لربي إلا شكرا لما أنعم علي من لساني هذا، ولكن يا عبد الله، إذ أتيتني، لي إليك حاجة، قد تراني على أي حالة أنا، أنا لست أقدر لنفسي على ضر ولا نفع، ولقد كان معي بني لي يتعاهدني في وقت صلاتي فيوضيني، وإذا جعت أطعمني، وإذا عطشت سقاني، ولقد فقدته منذ ثلاثة أيام، فتحسسه لي رحمك الله، فقلت: والله ما مشى خلق في حاجة خلق كان أعظم عند الله أجرا ممن يمشي في حاجة مثلك، فمضيت في طلب الغلام فما مضيت غير بعيد حتى صرت بين كثبان من الرمل، فإذا أنا بالغلام قد افترسه سبع، وأكل لحمه فاسترجعت، وقلت: أنى لي وجه رقيق آتي به الرجل، فبينما أنا مقبل نحوه إذ خطر على قلبي ذكر أيوب النبي صلى الله عليه وسلم فلما أتيته سلمت عليه، فرد علي السلام، فقال: ألست بصاحبي؟ قلت: بلى، قال: ما فعلت في حاجتي، فقلت: أنت أكرم على الله أم أيوب النبي، قال: بل أيوب النبي، قلت: هل علمت ما صنع به ربه، أليس قد ابتلاه بماله وآله وولده؟ قال: بلى، قلت: فكيف وجده؟ قال: وجده صابرا شاكرا حامدا، قلت: لم يرض منه ذلك حتى أوحش من أقربائه وأحبائه، قال: نعم، قلت: فكيف وجده ربه، قال: وجده صابرا شاكرا حامدا، قلت: فلم يرض منه بذلك حتى صيره عرضا لمار الطريق، هل علمت؟ قال: نعم، قلت: فكيف وجده ربه، قال: صابرا شاكرا حامدا أوجز رحمك 
ms592	 الله، قلت له: إن الغلام الذي أرسلتني في طلبه وجدته بين كثبان الرمل وقد افترسه سبع، فأكل لحمه، فأعظم الله لك الأجر، وألهمك الصبر، فقال المبتلى: الحمد لله الذي لم يخلق من ذريتي خلقا PageV01P002 [ج 2: ص 253] يعصيه، فيعذبه بالنار، ثم استرجع وشهق شهقة فمات، فقلت: إنا لله وإنا إليه راجعون عظمت مصيبتي، رجل مثل هذا إن تركته أكلته السباع، وإن قعدت لم أقدر على ضر ولا نفع، فسجيته بشملة كانت عليه، وقعدت عند رأسه باكيا، فبينما أنا قاعد إذ تهجم علي أربعة رجال، فقالوا: يا عبد الله، ما حالك وما قصتك، فقصصت عليهم قصتي وقصته، فقالوا لي: اكشف لنا عن وجهه، فعسى أن نعرفه فكشفت عن وجهه، فانكب القوم عليه يقبلون عينيه مرة ويديه أخرى، ويقولون بأبي، عين طالما غضت عن محارم الله، وبأبي وجسمه طالما كنت ساجدا والناس نيام، فقلت: من هذا يرحمكم الله، فقالوا: هذا أبو قلابة الجرمي صاحب ابن عباس، لقد كان شديد الحب لله، وللنبي صلى الله عليه وسلم فغسلناه وكفناه بأثواب كانت معنا، وصلينا عليه ودفناه فانصرف القوم وانصرفت إلى رباطي، فلما أن جن علي الليل وضعت رأسي فرأيته فيما يرى النائم في روضة من رياض الجنة، وعليه حلتان من حلل الجنة، وهو يتلو الوحيف سلام عليكم بما صبرتم فنعم عقبى الدارق فقلت: ألست بصاحبي؟ قال: بلى، قلت: أنى لك هذا، قال: إن لله درجات لا تنال إلا بالصبر عند البلاء، والشكر عند الرخاء مع خشية الله عز وجل في السر والعلانية "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نوفل بن الحارث بن عبد المطلب(@)(@@) أخو الحارث بن نوفل، كنيته أبو محمد، يروي عن: عمر بن الخطاب، وجماعة من الصحابة، روى عنه: أهل المدينة، وهو أول قاض كان بالمدينة من التابعين، أمه ضريبة بنت سعيد بن جندب بن عبد الله بن رافع، قتل يوم الجمعة سنة ثلاث وستين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محيرز القرشي(@)(@@) كان يتيما في حجر أبي محذورة، يروي عن: أبي سعيد الخدري، وأبي محذورة، سكن 
ms593	 فلسطين، وكان من العباد، وكان يشبه بعبد الله بن عمر، روى عنه: الزهري، ومكحول، وابنه عبد الرحمن بن محيريز، مات في ولاية الوليد بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كعب بن مالك السلمي الأنصاري(@)(@@) يروي عن: أبيه، وابن عباس، عداده في أهل المدينة، روى عنه: الزهري، مات سنة سبع أو ثمان وتسعين، في ولاية سليمان بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مطرف بن عبد الله بن الشخير العامري، كنيته أبو جزئ(@)(@@) يروي عن: أبي برزه، روى عنه: حميد بن هلال، مات قبل أبيه.(@)PageV01P002(@)(@@) [ج 2: ص 254](@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن عمر بن الخطاب(@)(@@) أخو عبيد الله بن عبد الله، كنيته أبو عبد الرحمن، يروي عن: أبيه، روى عنه: القاسم بن محمد، والزهري، ونافع، مات سنة خمس ومائة أول ما استخلف هشام بن عبد الملك، وكان أوصى إليه عبد الله بن عمر، وأمه صفية بنت أبي عبيد بن مسعود بن عمرو الثقفي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محمد بن أبي بكر الصديق(@)(@@) أخو القاسم بن محمد، يروي عن: عائشة، روى عنه: الزهري، ونافع.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي زكريا الشامي(@)(@@) واسم أبيه إياس بن يزيد، من العرب، يروي عن: معاوية، كنيته أبو يحيى، وكان من العباد، روى عنه: أهل الشام، مات في ولاية هشام بن عبد الملك، وهو من الخزاعة، كان يقول: " عالجت لساني عشرين سنة حتى استقام ".(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عامر بن كريز بن ربيعة بن حبيب بن عبد شمس بن عبد مناف(@)(@@) عامل عثمان بن عفان على البصرة، يروي عن: جماعه من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الناس، مات بمكة، ودفن بعرفات سنة تسع وخمسين قبل وفاة معاوية بسنة، وكنيته أبو عبد الرحمن، وقد قيل: إن له من النبي صلى الله عليه وسلم رؤية، وهو الذي افتتح عامة فارس، وخراسان، وسجستان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن خالد بن أسيد بن أبي العيص بن أمية(@)(@@) يروي عن: جماعه من الصحابة، روى عنه: أهل 
ms594	 الحجاز، أمه ريطة بنت عبد الله بن خزاعي بن الحويرث.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سليمان بن زيد بن ثابت الخزرجي الأنصاري(@)(@@) أخو سعيد بن سليمان، يروي عن: أنس بن مالك، عداده في أهل المدينة، روى عنه: ابنه خارجة بن عبد الله.(@)PageV01P002(@)(@@) [ج 2: ص 255](@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعد بن أبي وقاص الزهري القرشي(@)(@@) أخو عامر، وسعد، ومصعب، وعمر، ويحيى، وإبراهيم، ومحمد بني سعد بن أبي وقاص، يروي عن: أبي أيوب، عداده في أهل المدينة، روى عنه: خارجة بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حنين(@)(@@) مولى عباس بن عبد المطلب، ويقال: مولى علي، روى عنه: ابنه إبراهيم بن عبد الله بن حنين، مات في ولاية يزيد بن عبد الملك، والصحيح أنه مولى مثقب، ومثقب مولى مسحل، ومسحل مولى شماس، وشماس مولى العباس بن عبد المطلب، ولذلك قيل: مولى العباس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث بن نوفل الهاشمي(@)(@@) يروي عن: ابن عباس، وميمونة، روى عنه: ابناه: إسحاق، وعبد الله، ويزيد بن أبي زياد، توفي سنة تسع وسبعين قتله السموم، ودفن بالأبواء وصلى عليه سليمان بن عبد الملك، وهو عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب، كنيته أبو محمد، من فقهاء أهل المدينة، وقد قيل: إنه مات بعمان.(@)(@@)(@@)(@@) ||| AUTO أبو عبد الرحمن السلمي: اسمه عبد الله بن حبيب(@)(@@) عداده في أهل الكوفة، يروي عن: عثمان، وعلي، وابن مسعود، روى عنه: الكوفيون، مات سنة أربع وسبعين في ولاية بشر بن مروان على العراق، وقد قيل: سنة اثنتين وسبعين، وزعم شعبة أن أبا عبد الرحمن لم يسمع من عثمان، ولا عبد الله، وسمع عليا.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن أبي بكر الصديق(@)(@@) عداده في أهل PageV01P002 [ج 2: ص 256] المدينة، يروي عن: أم سلمه، روى عنه: زيد بن عبد الله بن عمر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن دينار(@)(@@) مولى ابن عمر، عداده في أهل المدينة، يروي عن: ابن عمر، روى عنه: مالك، وشعبه، والثوري، مات سنة سبع وعشرين ومائه.(@)(@@)(@@)(@@) ||| AUTO عبد 
ms595	 الله بن قيس بن مخرمه(@)(@@) يروي عن: زيد بن خالد الجهني، روى عنه: أبو بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شقيق العقيلي(@)(@@) عداده في أهل البصرة، يكنى أبا عبد الرحمن، وقيل: أبا عامر، يروي عن: عائشة، وأبي هريرة، روى عنه: الجريري، وخالد الحذاء، مات سنة ثمان ومائه، وهو والد عامر العقيلي، الذي روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد بن عمير بن قتادة الليثي، كنيته أبو هاشم(@)(@@) عداده في أهل مكة، يروي عن: ابن عمر، وأبيه، روى عنه: الزهري، والناس، وهو والد محمد بن عبد الله بن عبيد بن عمير، ومات عبد الله بن عبيد سنة ثلاث عشرة ومائة، وكان مستجاب الدعوة، كانت السحابة ربما مرت به أقسمت عليك، ألا تمطرين؟ فتمطر.(@)(@@)(@@)(@@) ||| AUTO أبو سنان الأسدي عبد الله بن سنان(@)(@@) كوفي، يروي عن: ابن مسعود، روى عنه: أهل الكوفة، مات في ولاية الحجاج بن يوسف قبل الجماجم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إبراهيم بن قارظ الزهري(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، روى عنه: الزهري.(@)PageV01P002(@)(@@) [ج 2: ص 257](@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي أيوب الأنصاري(@)(@@) أخو خالد بن أبي أيوب، يروي عن: أبيه، روى عنه: ابنه بشر بن عبد الله بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الله بن خباب بن الأرت(@)(@@) حليف بني زهره، يروي عن: أبيه، روى الزهري، عن عبد الله بن عبد الله بن الحارث بن نوفل، عنه، قتل زمن علي بن أبي طالب رضى الله تعالى عنه.(@)(@@) عبد الله بن خباب(@)(@@) مولى بني عدي بن النجار الأنصاري، عداده في أهل المدينة، يروي عن: أبي سعيد الخدري، روى عنه: القاسم بن محمد ويزيد بن الهاد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أنس بن مالك الأنصاري(@)(@@) من أهل البصرة، يروي عن: أبيه، روى عنه: يزيد الرشك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سلمة(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: عمرو بن مرة، يخطأ.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حفص بن عمر بن سعد الزهري 
ms596	 القرشي، كنيته أبو بكر(@)(@@) يروي عن: ابن عمر، وكان راويا لعروة، روى عنه: شعبة، وابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن فروخ(@)(@@) مولى آل طلحة بن عبيد الله، يروي عن: أم سلمه، PageV01P002 [ج 2: ص 258] وطلحه بن عبيد الله، روى عنه: طلحة بن يحيى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بديل بن ورقاء الخزاعي(@)(@@) يروي عن: جماعه من أصحاب رسول الله صلى الله عليه وسلم قتل يوم صفين في أصحاب علي بن أبي طالب، وهو عبد الله بن بديل بن ورقاء بن عبد العزى بن مازن بن عدي بن عمرو بن ربيعه بن حارثة وهو خزاعه، وقد قيل: انه قتل يوم الجمل.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مخرمه، أبو مخرمه(@)(@@) من أهل الشام، يروي عن: جماعه من الصحابة، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الخليل الحضري(@)(@@) عداده من أهل الكوفة، يروي عن: زيد بن أرقم، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أوس الخزاعي(@)(@@) يروي عن: بريده الأسلمي، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن باباه المكي(@)(@@) مولى آل حجير بن أبي إهاب، وهو الذي يقال له: بن بابي، يروي عن: جبير بن مطعم، وعبد الله بن عمرو، روى عنه: عمرو بن دينار، وأبو الزبير، وابن أبي نجيح.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي طلحة الأنصاري(@)(@@) واسم أبي طلحة: زيد بن سهل، من أهل PageV01P002 [ج 2: ص 259] بدر، يروي عن: أبيه، روى عنه: ابنه إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن أبي صعصعه المازني الأنصاري(@)(@@) من أهل المدينة، يروي عن: أبي سعيد الخدري، روى عنه: ابناه محمد، وعبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الأغر(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الأشج(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسحاق بن حازم(@)(@@) يروي عن: أنس بن مالك، روى عنه: الربيع بن حطان.(@)(@@)(@@)(@@) ||| AUTO أبو الزعراء الأعدل الكبير، اسمه عبد 
ms597	 الله بن هانئ الهمداني(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، روى عنه: سلمه بن كهيل.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شرحبيل بن حسنه(@)(@@) قرشي، يروي عن: عثمان بن عفان، روى عنه: الزهري، وسعد بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن الأشهلي(@)(@@) من أهل المدينة، يروي عن: حذيفه، روى عنه: عمرو بن أبي عمرو مولى المطلب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن السائب بن خلاد(@)(@@) يروي عن: أبيه، وأمه أنيسة بنت ثعلبة.(@)PageV01P002(@)(@@) [ج 2: ص 260](@)(@@)(@@)(@@) ||| AUTO أبو عامر الجيشاني، اسمه عبد الله بن مالك(@)(@@) يروي عن: عمر وعلي، مات سنة ثمان وتسعين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن الحارث(@)(@@) يروي عن: عباده بن الصامت، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بصير العبدي(@)(@@) يروي عن: أبي بن كعب، وعن أبيه، عن أبي، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بسر الحبراني السكسكي، كنيته أبو سعيد(@)(@@) عداده في أهل الشام، وهو الذي يقال له: عبد الله بن أبي إياس، يروي عن: عبد الله بن بسر، روى عنه: أبو عبيدة الحداد، ومحمد بن حمران، كأنه سكن البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عروة بن الزبير بن العوام(@)(@@) يروي عن: عبد الله، روى عنه: أخوه هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زيد الأزرق(@)(@@) يروي عن: عوف بن مالك، عداده في أهل دمشق، وكان قاصا لمسلمة بن عبد الملك بالقسطنطينة، روى زيد بن سلام، عن أبي سلام عنه.(@)PageV01P002(@)(@@) [ج 2: ص 261](@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن سعد بن أبي ذباب الدوسي(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، روى عنه: مجاهد، وعكرمة بن خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد(@)(@@) رضيع عائشة، يروي عن: عائشة، روى عنه: أبو قلابة، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بدر بن عميرة بن الحارث بن شمر الحنفي(@)(@@) من أهل اليمامه، وهو جد ملازم بن عمرو، يروي عن: قيس بن طلق، ورأى عبد الله بن عمر، روى عنه: ملازم بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بكر بن محمد 
ms598	 بن عمرو بن حزم الأنصاري(@)(@@) من أهل المدينة، عن: أنس، روى عنه: الثوري، ومالك، وقد روى عن: الزهري، وروى عنه، مات سنة خمس وثلاثين ومائه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بريده بن الحصيب الأسلمي(@)(@@) ولد في عهد عمر لثلاث سنين خلون منه، كان هو وأخوه سليمان توأمين، كان عبد الله قاضيا بمرو، وولاه يزيد بن المهلب، يروي عن: سمره، وعمران بن حصين، وأبيه، روى عنه الناس، مات سنة خمس عشره ومائه بجاورسة قرية من قرى مرو، وبها قبره.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن الرومي(@)(@@) عداده في البصريين، يروي عن: عبد الله بن مغفل، وابن عمر، وأبي هريرة، روى عنه: حماد بن زيد، مات قبل أيوب PageV01P002 [ج 2: ص 262] السختياني، وقد روى عنه: عبيده بن أبي رائطه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد(@)(@@) من أهل الكوفة، يروي عن أبي مسعود الأنصاري: إذا انفق الرجل على أهله كانت له صدقه، روى عنه: عدي بن ثابت الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن أزهر(@)(@@) يروي عن: أبيه، وله صحبه، روى عنه: جعفر بن ربيعه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بولي، ويقال: ابن تولي(@)(@@) يروي عن: عثمان بن عفان، روى عنه: عبد الرحمن بن إسحاق إن كان سمع منه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بكر بن عبد الله بن أبي أحمد بن جحش(@)(@@) يروي عن: أنس بن مالك، عداده في أهل المدينة، روى عنه: مجمع بن يعقوب، قتل سنة ثلاثين ومائه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عتبه بن مسعود الهذلي(@)(@@) ابن أخي عبد الله بن مسعود، يروي عن: عمر، كان يؤم الناس بالكوفه، وهو والد عبيد الله وعون، روى عنه: حصين بن عبد الرحمن، وحميد بن عبد الرحمن، مات سنة أربع وسبعين في ولاية بشر بن مروان على العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مره الهمداني(@)(@@) يروي عن: ابن مسعود، وابن عمر، روى عنه: أهل العراق، مات في خلافة عمر.(@)PageV01P002(@)(@@) [ج 2: ص 263](@)(@@)(@@)(@@) ||| AUTO عبد الله بن ظالم المازني(@)(@@) يروي عن: سعيد بن زيد بن عمرو بن نفيل، روى 
ms599	 عنه: هلال بن يساف.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي الفضل المدني(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO أبو مسلم الخولاني اسمه عبد الله بن ثوب(@)(@@) أسلم على عهد معاوية، ورأى جماعه من أصحاب رسول الله صلى الله عليه وسلم وكان من عباد أهل الشام، وزهادهم ولأبيه صحبة، روى عنه: أهل الشام، توفي في زمن معاوية قبل بسر بن أبي أرطاة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جابر بن عبد الله الأنصاري السلمي(@)(@@) من أهل المدينة، أخو محمد وعبد الرحمن ابني جابر، عداده في أهل المدينة، يروي عن: أبيه، روى عنه: سعيد المقبري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حمضه الخزاعي(@)(@@) من أهل البصرة، يروي عن: أبي هريرة، روى عنه: قتادة، وأبو جمرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحر(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بشير بن عقربة(@)(@@) من أهل بيت المقدس، يروي عن: أبيه، روى عنه: الشاميون، وقد قيل لأبيه: بشر بن عقربة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جبير بن حيه الثقفي(@)(@@) أخو زياد، وعبيد الله، يروي عن: شداد بن أوس، روى عنه: يوسف بن سعد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن لحي أبو عامر الهوزني(@)(@@) يروي عن: أبي عبيده بن الجراح، PageV01P002 [ج 2: ص 264] وبلال، ومعاويه، عداده في أهل الشام، روى عنه: أهلها صفوان بن عمرو، وذووه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ثمامة(@)(@@) يروي عن: علي، روى عنه: عمار الدهني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حسن الأنصاري البخاري(@)(@@) من أهل المدينة، يروي عن: رافع بن خديج، روى عنه: ابنه يحيى بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن غالب الحداني(@)(@@) من أهل البصرة، يروي عن: أبي سعيد الخدري، روى عنه: قتادة، ومالك بن دينار، كنيته أبو فراس، وكان من عباد أهل البصرة، بايع بن الأشعث، وقاتل معه حتى قتل في الجماجم سنة ثلاث وثمانين فكانوا يجدون من قبر ريح المسك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زبيب بن ثعلبة العنبري الأعرابي(@)(@@) يروي عن: أبيه وله صحبه، روى عنه: ابنه شعيث بن 
ms600	 عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي الجعد(@)(@@) أخو سالم بن أبي الجعد، وعبيد، وزياد، عداده في أهل الكوفة، واسم أبي الجعد رافع مولى غطفان، يروي عبد الله عن: ثوبان، روى عنه: عبد الله بن عيسى، ويزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شداد بن الهاد الليثي(@)(@@) يروي عن: عمر بن الخطاب، وعلي بن أبي طالب، عداده في أهل الكوفة، روى عنه: الشعبي، وموسى بن أبي عائشة، غرق بدجيل سنة ثلاث وثمانين في الجماجم، وكنيته أبو الوليد، أمه سلمى بنت عميس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي قتادة الأنصاري السلمي(@)(@@) واسم أبي قتادة PageV01P002 [ج 2: ص 265] الحارث بن ربعي، يروي عن: أبيه، عداده في أهل المدينة، روى عنه: يحيى بن أبي كثير وابنه قتادة بن عبد الله بن أبي قتادة، مات سنة خمس وتسعين، وكنيته أبو يحيى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ذئب الكوفي(@)(@@) يروي عن: ابن مسعود، روى عنه: الشعبي، وأبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن هند الجملي المرادي(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: عوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نيار الأسلمي(@)(@@) يروي عن: عمرو بن شاس، وله صحبة، روى عنه: محمد بن إسحاق، عن الفضل بن معقل، عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حصن أبو مدينة السدوسي(@)(@@) بصري يروي عن: ابن عباس وأبي موسى وابن الزبير، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جبير الخزاعي(@)(@@) يروي عن: أبي الفيل، ولا أدري من أبو الفيل غير أن عبد الله رأى رجلا من أصحاب النبي صلى الله عليه وسلم روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جرير(@)(@@) يروي عن: أبيه جرير بن عبد الله البجلي، عداده في أهل الكوفة، روى عنه: يزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نوفل بن الحارث بن عبد المطلب(@)(@@) قتل يوم الحرة سنة ثلاث وستين، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: أهل بلده.(@)PageV01P002(@)(@@) [ج 2: ص 266](@)(@@)(@@)(@@) ||| AUTO عبد الله بن رافع بن خديج الأنصاري(@)(@@) من 