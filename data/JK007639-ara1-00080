ms61	 ثغره ، % وتوقدت في الصدر جذوة حقده % 55(@)(@@) % ولذاك لم يرني بمنظر شاعر % تبغي قصائده جوائز قصده % 56(@)(@@) % بل بامرىء أسدى إليه سماحة % نعما ، فكان المدح غاية جهده % 57(@)(@@) % ودرى بأن نظام شعري جوهر ، % وسواه نحر لا يليق بعقده % 58(@)(@@) % ولقد عهدت إلى عرائس فكرتي % % أن لا تزف لمنعم من بعده % 59(@)(@@) % لكنك الفرع الذي هو أصله ، % شرفا ، ومجدك بضعة من مجده % 60(@)(@@) % ونجيه في سره ، ووصيه % في أمره ، وصفيه من بعده % PageV01P208 61(@)(@@) % وإليك كان الملك يطمح بعده ، % يبغي جوابا لو سمحت برده % 62(@)(@@) % فتركته طوعا ، وكنت ممكنا % من فك معصم كفه عن زنده % 63(@)(@@) % وشددت أزر أخيك يا هارونه ، % لما توقع منك شدة عضده % 64(@)(@@) % حتى أحاط بنو الممالك كلها ، % علما بأنك قد وفيت بعهده % 65(@)(@@) % سمحت بك الأيام ، وهي بواخل ، % ولربما جاد البخيل بعمده % 66(@)(@@) % وعد الزمان بأن نرى فيك المنى ، % والآن أوفى الزمان بوعده % 67(@)(@@) % لله كم قلدتني من منة ، % والقطر أعظم أن يحاط بعده % 68(@)(@@) % وعلمت ما في خاطري لك من ولا ، % حتى كأنك حاضر في وده % 69(@)(@@) % إن كان بعدي عن علاك خطية ، % قد يغفر المولى خطية عبده % 70(@)(@@) % بعد الوفي كقربه ، إذ وده % % باق كما قرب الملول كبعده % PageV01P209 71(@)(@@) % مدحي لمجدك عن وداد خالص ، % وسواي يضمر صابه في شهده % 72(@)(@@) % إذ لا أروم به الجزاء لأنه % بحر أنزه غلتي عن ورده % 73(@)(@@) % لا كالذي جعل القريض بضاعة ، % متوقعا كسب الغنى من كده % 74(@)(@@) % فاستجل درا أنت لجة بحره ، % والبس ثناء أنت ناسج برده % 75(@)(@@) % يزداد حسنا كلما كررته ، % كالتبر يظهر حسنهث في نقده % PageV01P210 البحر : بسيط تام 1(@)(@@) % من نفخة الصور أم من نفخة الصور % أحييت يا ريح ميتا غير مقبور % 2(@)(@@) % أم من شذا نسمة الفردوس حين سرت % على بليل من الأزهار ممطور % 3(@)(@@) % أم روض رشمل أعدى عطر نفحته % طي النسيم بنشر فيه منشور % 4(@)(@@) % والريح قد أطلقت فضل العنان به ، % والغصن ما بين تقديم وتأخير % 5(@)(@@) % في روضة نصبت أغصانها ، وغدا % % ذيل الصبا 
ms62	 بين مرفوع ومجرور % 6(@)(@@) % والماء ما بين مصروف وممتنع ، % والظل ما بين ممدود ومقصور % 7(@)(@@) % والريح تجري رخاء فوق بحرتها ، % وماؤها مطلق في زي مأسور % 8(@)(@@) % قد جمعت جمع تصحيح جوانبها ، % والماء يجمع فيها جمع تكسير % 9(@)(@@) % والريح ترقم في أمواجه شبكا ، % والغيم يرسم أنواع التصاوير % 10(@)(@@) % والنرجس الغض لم تغضض نواظره ، % فزهره بين منغض ومزرور % PageV01P211 11(@)(@@) % كأنه ذهب من فوق أعمدة % % 12(@)(@@) % وقد أطعنا التصابي حين ساعدنا % % عصر الشباب بجود غير منزور % 13(@)(@@) % إن الشباب شفيع ، نشر بردته % من عطر دارين لا من عطر فنصور % 14(@)(@@) % وزامر القوم يطوينا وينشرنا % % بالنفخ في الناي لا بالنفخ في الصور % 15(@)(@@) % وقد ترنم شاد ، صوته غرد ، % كأنه ناطق من حلق شحرور % 16(@)(@@) % شاد ، أنامله ترضي الأنام له ، % إذا شدا وأجاب البم بالزير % 17(@)(@@) % بشامخ الأنف قوام على قدم ، % يشكو الصبابة عن أنفاس مهجور % 18(@)(@@) % شدت بتصحيفه في العضد ألسنه ، % فزاد نطفا لسر فيه محصور % 19(@)(@@) % إذا تأبطه الشادي وأذكره % عصر الشباب بأطراف الأظافير % 20(@)(@@) % شكت إلى الصحب أحشاه وأضلعه % % قرض المقاريض أو نشر المناشير % PageV01P212 21(@)(@@) % بينما ترى خده من فوق سالفة % كمن يشاوره في حسن تدبير % 22(@)(@@) % تراه يزعجه عنفا ويسخطه % بضرب أوتاره عن حقد موتور % 23(@)(@@) % والراقصات ، وقد مالت ذوائبها ، % على خصور كأوساط الزنانير % 24(@)(@@) % يخفي الردا سقمها عنا فيفضحها % % عقد البنود وشدات الزنانير % 25(@)(@@) % إذا انثنين بأعطاف يجاذبها % % موار دعص من الكثبان ممطور % 26(@)(@@) % رأيت أمواج أرداف قد التطمت % في لج بحر بماء الحسن مسحور % 27(@)(@@) % من كل مائسة الأعطاف من مرح ، % مقسومة بين تأنيث وتذكير % 28(@)(@@) % كأن في الشيز يمناها ، إذا ضربت ، % صبح تقلقل فيه قلب ديجور % 29(@)(@@) % ترعى الضروب بكفيها وأرجلها ، % وتحفظ الأصل من نقص وتغيير % 30(@)(@@) % وتعرب الرقص من لحن فتلحقه ، % ما يلحق النحو من حذف وتقدير % PageV01P213 31(@)(@@) % وحامل الكأس ساجي الطرف ذو هيف % صاحي اللواحظ يثني عطف مخمور % 32(@)(@@) % كأنما صاغه الرحمن تذكرة % لمن يشكك في الولدان والحور % 33(@)(@@) % تظلمت وجنتاه ، وهي ظالمة ، % وطرفه ساحر في 
ms63	 زي مسحور % 34(@)(@@) % يدير راحا يشب المزج جذوتها ، % فلا يزيد لظاها غير تسعير % 35(@)(@@) % نارا بدت لكليم الوجد آنسها % % من جانب الكأس لا من جانب الطور % 36(@)(@@) % تشعشعت في يد الساقين واتقدت % بها زجاجاتها من لطف تأثير % 37(@)(@@) % كأنها ، وضيا الكأس يحجبها ، % روح من النار في جسم من النور % 38(@)(@@) % وللأباريق عند المزج لجلجة ، % كنطق مرتبك الألفاظ مذعور % 39(@)(@@) % كأنها ، وهي في الأكواب ساكبة ، % طير تزق فراخا بالمناقير % 40(@)(@@) % أمست تحاول منا ثأر والدها % % ودوسه تحت أقدام المعاصير % PageV01P214 41(@)(@@) % فحين لم يبق عقل غير معتقل % أقام يقرع فيها سن مغرور % 42(@)(@@) % أجلت في الصحب ألحاظي فكم نظرت % ليثا تعفره ألحاظ يعفور % 43(@)(@@) % من كل عين عليها مثل تالئها % % مكسورة ذات فتك غير مكسور % 44(@)(@@) % أقول ، والراح قد أبدت فواقعها ، % والكأس ينفث فيها نفث مصدور % 45(@)(@@) % أسأت يا مازج الكاسات حليتها ، % وهل يتوج ياقوت ببلور % 46(@)(@@) % وقائل إذ رأى الجنات عالية ، % والحور مقصورة بين المقاصير % 47(@)(@@) % الجوسق الفرد في لج البحيرة ، وال % % صرح الممرد فيه من قواير % 48(@)(@@) % لمن ترى الملك بعد الله ؟ قلت له % مقال منبسط الآمال مسرور % 49(@)(@@) % لصاحب التاج والقصر المشيد ومن % % أتى بعدل برحب الأرض منشور % 50(@)(@@) % فقال : تعني به كسرى ؟ فقلت له : % كسرى بن أرتق لا كسرى بن سابور % PageV01P215 51(@)(@@) % الصالح الملك المشكور نائله ، % ورب نائل ملك غير مشكور % 52(@)(@@) % ملك ، إذا وفر الناس الثناء له % أمست يداه بوفر غيرش موفور % 53(@)(@@) % محبوبة عند كل الناس طلعته ، % كأنما عوجلت منه بتكوير % 54(@)(@@) % لا تفخر الشمس إلا أنها لقب % له ، وشبه له في العز والنور % 55(@)(@@) % إن هم بالجود لم تنظر عزائمه % في فعله بين تقديم وتأخير % 56(@)(@@) % يلقاك قبل العطا بالبشر مبتدئا % بسطا ، وبعد العطايا بالمعاذير % 57(@)(@@) % رأت بنو أرتق نهج الرشاد به ، % وليس كل زناد في الدجى يوري % % 58(@)(@@) % برأيه انصلحت آراء ملكهم ، % كأنهم ظفروا منه بإكسير % 59(@)(@@) % كم عصبة مذ بدا سوء الخلاف بها % % بادت بصارم عزم منه مشهور % 60(@)(@@) % سعوا إلى الحرب ، والهامات 
ms64	 ساجدة ، % والبيض ما بين تهليل وتكبير % PageV01P216 61(@)(@@) % مشوا كمشي القطا ، حتى إذا حملوا % % ثقل القيود مشوا مشي العصافير % 62(@)(@@) % يا باذل الخيل في يوم الغلو بها ، % وما أتين بسعي غير مشكور % 63(@)(@@) % إن كان زهوة كسرى بالألوف فكم % وهبت من عدد بالألف مجذور % 64(@)(@@) % أو كان بالجوسق النعمان تاه ، فكم % % من جوسق لك بالشعبين معمور % 65(@)(@@) % في كل مستصعب الأرجاء ممتنع % تبنى القناطر فيه بالقناطير % 66(@)(@@) % لو مر عاد بن شداد بجنته % % 67(@)(@@) % لا غرو إن جدت للوفاد قاصدة % إليك تطوي الفلا طي الطوامير % 68(@)(@@) % إن تسع نحوك من أقصى الشآم ، فقد % % سعت إلى الملك المنصور من صور % 69(@)(@@) % فاسعد بعيد به عاد السرور لنا ، % وعاد شانيك في غم وتكدير % 70(@)(@@) % صمت بصومك أسماع العداة ، وكم % % قلب لهم منك بالإفطار مفطور % PageV01P217 71(@)(@@) % أدعوك دعوة عبد وامق بكم ، % يا واحد العصر ، فاسمع غير مأمور % 72(@)(@@) % لا أدعي العذر عن تأخير قصدكم ، % ليس المحب على بعد بمعذور % 73(@)(@@) % بل إن غدا طول بعدي عن جنابكم ، % ذنبي العظيم ، فهذا المدح تكفيري % % 74(@)(@@) % لولاكم لم يكن في الشعر لي أرب ، % ولا برزت به من خزن تامور % 75(@)(@@) % فضيلة نقصت قدري زيادتها ، % كالاسم زادت به ياء لتصغير % 76(@)(@@) % لكنني لم أهن ، حرصا ، نفائسها % % كمرخص الشعر في مدح ابن منصور % 77(@)(@@) % مكانة النفس مني فوق مكنتها ، % من النضار ، وقدري فوق مقدور % 78(@)(@@) % لكن تأخر بي عصري ، وقدم من % % قد كان قبلي في ماضي الأساطير % 79(@)(@@) % كأنني من رغوم الهند أوجب لي % % علو مرتبتي إفراط تأخيري % % 80(@)(@@) % فاستجل بكر قريض لا صداق لها % % سوى القبول وود غير مكفور % PageV01P218 81(@)(@@) % على أبي الطيب الكوفي مفخرها ، % إذ لم أضع مسكها في مثل كافور % 82(@)(@@) % رقت لتعرب عن رقي لمجدكم % حبا ، وطالت لتمحو ذنب تقصيري % % PageV01P219 البحر : طويل 1(@)(@@) % إذا لم تعني في علاك المدائح ، % فمن أين لي عذر عن البعد واضح ؟ % 2(@)(@@) % وكيف اعتذاري بالقريض ، وإنما % % عهدتك تغضي دائما وتسامح % 3(@)(@@) % وإني على بعد الديار وقربها ، % أطارح فيكم فكرتي وتطارح 
ms65	 % 4(@)(@@) % وأنظم أبكار المعاني وعونها ، % فإن لم أسر سارت إليك المدائح % 5(@)(@@) % وإني لأهوى حاسديك لأنها % % تفاتحني عن ذكركم وأفاتح % 6(@)(@@) % يسرون بالتذكار مغرى بذكركم ، % يبالغ في أوصافكم ويناصح % 7(@)(@@) % إذا سألوا عن سركم ، فهو كاتم ؛ % وإن سألوا عن فضلكم ، فهو بائح % 8(@)(@@) % سقى أرضكم سار من الوبل سائح ، % وباكرها غاد من المزن رائح % 9(@)(@@) % فتلك عرين للأسود ، وبينها % % مسالك فيها للظباء مسارح % 10(@)(@@) % ظباء سوانح وورق صوارح ، % وقضب نوافح ، وغدر طوافح % PageV01P220 11(@)(@@) % وبين قباب الحي سرب جآذر % من الترك في روض من الأمن سارح % 12(@)(@@) % إذا هي هزت للطعان قدودها ، % فلا أعزل إلا أنثنى ، وهو رامح % 13(@)(@@) % وهيفاء لو أهدت إلى الميت نشرها ، % لأنشر من ضمت عليه الصفائح % 14(@)(@@) % ولو أنها نادت عظامي أجابها % % فمي لاصدى من جانب القبر صائح % 15(@)(@@) % لئن بخلت إن الخيال مسامح ، % وإن غضبت فالطيف منها مصالح % 16(@)(@@) % حبيب لإهداء التحية مانع ، % وطيف للذات التواصل مانح % 17(@)(@@) % وبكر فلاة لم تخف وطء طامث ، % ولا افتضها من قبل مهري ناكح % 18(@)(@@) % كشفت خمار الصون عن حر وجهها % % ضحى ، ولثام الصبح في الشرق طائح % 19(@)(@@) % وأنكحتها يقظان من نسل لاحق ، % فأمست به ، مع عقمها ، وهي لاقح % 20(@)(@@) % من الشهب في إدراكه الشهب طامع ، % فناظره نحو الكواكب طامح % PageV01P221 21(@)(@@) % أخوض به بحر الدجى وهو راكد ، % وأورده حوض الضحى وهو و % % 22(@)(@@) % وقائل ما لي أراه كدمعه % يظل ويمسي ، وهو في الأرض سائح % 23(@)(@@) % أطالب مغنى ؟ قلت : كلا ، ولا غنى ، % ولست على كسب اللذاذ أكافح % 24(@)(@@) % ولكن لي في كل يوم إلى العلى % % حوائج ، لكن دونهن جوائح % 25(@)(@@) % فقالت : ألا إن المعالي عزيزة ، % فكيف ، وقد قلت لديك المنائح % 26(@)(@@) % فهل لك وفر ؟ قلت : إي ، وهو ناقص ، % فقالت : وقدر ؟ قلت : إي ، وهو راجح % 27(@)(@@) % فقالت : وجد ؟ قلت : إي ، وهو أعزل ، % فقالت ، وضد ؟ قلت : إي ، وهو راجح % 28(@)(@@) % فقالت : ومجد ؟ قلت : غي ، وهو معتب % فقالت : وسعد ؟ قلت : إي ، وهو ذابح % 29(@)(@@) % فقالت : وملك ؟ قلت : إي ، وهو فاسد ، % فقالت : وملك ؟ قلت : إي 
ms66	 ، وهو صالح % 30(@)(@@) % مليك شرى كنز الثناء بماله ، % على أنه في صفقة المجد رابح % PageV01P222 31(@)(@@) % تظن بأيديه الأنام أناملا ، % وهن لأرزاق العباد مفاتح % 32(@)(@@) % جواد ، إذا ما الجود غاضت بحاره ، % حليم ، إذا خف الحلوم الرواجح % 33(@)(@@) % إذا خامرته الراح أبقت روية % من الرأي لا تخفى عليها المصالح % 34(@)(@@) % يعم الأقاصي جوده ، وهو عابس ، % وتخشى الأداني بشره ، وهو مازح % 35(@)(@@) % كما تهب الأنواء ، وهي عوابس ، % وتضحك في وجه القتيل الصفائح % 36(@)(@@) % من القوم إن عد الفخار ، فإنهم % % هم الروح فخرا ، والأنام جوارح % 37(@)(@@) % أكفهم للمكرمات مفاتح ، % وذكرهم لاسم الكرام فواتح % 38(@)(@@) % إذا احتجبوا نمت عليهم خلالهم ، % كذا المسك يخفى جرمه ، وهو فائح % 39(@)(@@) % أيا ملكا أرضى المعالي بسعيه ، % وراض جياد الملك وهي جوامح % 40(@)(@@) % نهضت بأمر يعجز الشم ثقله ، % فقمت به جزعا ، ورأيك قادح % PageV01P223 41(@)(@@) % وألفت شمل الملك بعد شتاته ، % وقد صاح فيه بالتفرق صائح % 42(@)(@@) % مددت إلى العلياء كفك ، والعلى % % تمد أكفا ما لهن مصافح % 44(@)(@@) % فجاءتك طوعا في الزمام ، ولم تكن % % 45(@)(@@) % فجاءتك طوعا في الزمام ، ولم تكن % بمهجتها إلا عليك تكافح % 46(@)(@@) % وجمرة حربس أجج الشوس وقدها % % وبيض الظبى والعاديات الضوابح % 47(@)(@@) % رجال جحاجح ، وجرد سوابح ، % وسمر جوارح ، وبيض صفائح % 48(@)(@@) % وقفت لها والمرهفات ضواحك ، % وجوه الردى ما بينهن كوالح % 49(@)(@@) % ووجهك واضح ، وعضبك ناضح ، % وزندك قادح ، وعزمك فادح % 50(@)(@@) % فيا ملكا يثني عليه فم العلى ، % وتنسبه يوم الهياج الصفائح % 51(@)(@@) % لئن بعدت منا الجوانح عنكم ، % ففي ربعكم منا القلوب جوانح % PageV01P224 52(@)(@@) % ولكن حالي في التباعد بين % لديك ، وعذري في التأخر واضح % 53(@)(@@) % سأختم أبكار المدائح باسمكم ، % كما باسمكم قدما لها أنا فاتح % PageV01P225 البحر : بسيط تام 1(@)(@@) % أهلا ببدر دجى يسعى بشمس ضحى ، % بنوره صبغة الليل البهيم محا % % 2(@)(@@) % حيا بها والدجى مرخ غدائره ، % فخلت أن جبين الصبح قد وضحا % % 3(@)(@@) % راحا إذا ملأ الساقي بها قدحا ، % ظننت جذوة نار في الدجى قدحا % % 4(@)(@@) % لم يبق طول المدى إلا حشاشتها ، % عنت لنا ، فتراءت بيننا شبحا % % 5(@)(@@) % يسعى بها 
ms67	 ثمل الأعطاف يرجعها % % سكرى بألفاظه ، إن جد أو مزحا % % 6(@)(@@) % يجلو لنا وجهه في الليل مغتبقا % بها ، فيحسب بالآلاء مصطبحا % % 7(@)(@@) % نادمته وجناح النسر منقبض % عن المطار وجنح الليل قد جنحا % % 8(@)(@@) % حتى انثنى والكرى يهوي بجانبه % إلى الوساد ، فإن طارحته انطرحا % % 9(@)(@@) % وظل من فرط جرم الكأس منقبضا % عن المطار وجنح الليل قد جنحا % % 10(@)(@@) % يضمه ، والكرى يرخي أنامله ، % فكلما أوثقته كفه سرحا % % PageV01P226 11(@)(@@) % حتى رأيت مياه الليل غائرة % في غربها وغدير الصبح قد طفحا % % 12(@)(@@) % وللشعاع على ذيل الظلام دم % كأن طفل الدجى في حجره ذبحا % % 13(@)(@@) % وقام يهتف من فوق الجدار بنا % % متوج الرأس بالظلماء متشحا % % 14(@)(@@) % كأنه شامت بالليل عن حنق ، % فكلما صدع الصبح الدجى صدحا % % 15(@)(@@) % نبهته ، والكرى يثني معاطفه ، % ونشوة الراح تلوي جيده مرحا % % 16(@)(@@) % فهب لي ، وحميا النوم تصرعه ، % والشكر يطبق من جفنيه ما فتحا % % 17(@)(@@) % جشمته ، وهو يثني جيده مللا ، % كأسا ، إذا بسمت في وجهه كلحا % % 18(@)(@@) % يلقى سناها على تقطيب حاجبه % % أشعة ، فيرينا قوسه قزحا % % 19(@)(@@) % فظل ينزو وريح الراح ممتعضا ، % ويستشيط إذا عاطيته قدحا % % 20(@)(@@) % حتى إذا حلت الكأس النشاط له % أتبعته بثلاث تبعث الفرحا % % PageV01P227 21(@)(@@) % ونلت من فضلها ما كان أسأره % بقعرها من رضاب نشره نفحا % % 22(@)(@@) % ريقا لو استاقه الصاحي لمال به % سكرا ، ولو رشف السكران منه صحا % % 23(@)(@@) % فقال لي ، وغوادي الدمع تسبقني % % من السرور ، وقد يبكي إذا طفحا : % 24(@)(@@) % قد كنت تشكو فساد العيش معتديا ، % أنى ، وقد طاب باللذات وانفسحا % % 25(@)(@@) % فقلت : قد كان صرف الدهر أفسده ، % لكنه بالمليك الصالح انصلحا % % 26(@)(@@) % ملك ، إذا ظل فكري في مدائحه ، % أمست تعلمنا أوصافه المدحا % % 27(@)(@@) % فضل يكاد يعيد الخرس ناطقة ، % تتلو الثناء ، ولفظ يخرس الفسحا % % 28(@)(@@) % وطلعة كجبين الشمس لو لمعت % يوما لمغتبق بالراح لاصطبحا % % 29(@)(@@) % وجودها كهلال الفطر ملتمحا ، % وجودها كانهلال القطر منفسحا % % 30(@)(@@) % يخفي مكارمه ، والجود يظهرها ، % وكيف يخفى أريج المسك إذ نفحا % % PageV01P228 31(@)(@@) % يكاد يعقم فكري ، إذ أفارقه ، % عن المديح ، وإن وافيته لقحا % % 32(@)(@@) % فما 
ms68	 أرتنا الليالي دونه محنا ، % إلا سخا ، فأرتنا كفه منحا % % 33(@)(@@) % ثبت الجنان ، مرير الرأي صائبه ، % إذا تقاعس صرف الدهر أو جمحا % % 34(@)(@@) % لايستشير سوء نفس مؤيدة ، % من أخطأ الرأي لا يستذنب النصحا % % 35(@)(@@) % ولا يقلد إلا ما تقلده % من حد عضب إذا شاورته نصحا % % 36(@)(@@) % ولا يذيل عليه غير سابغة ، % كأنما البرق من ضحضاحها لمحا % % 37(@)(@@) % مسرودة مثل جلد الصل لو نصبت % قامت ، ولو صب فيها الماء ما نضحا % % 38(@)(@@) % غصت عيون الردى والسوء من ملك % طرف الزمان إلى عليائه طمحا % % 39(@)(@@) % ما ضر من ظل في أفناء منزله ، % إن أغلق الدهر باب الرزق أو فتحا % % 40(@)(@@) % يود باغي الندى لو نال بلغته ، % حتى إذا حل في أفنائه اقترحا % % PageV01P229 41(@)(@@) % لما رأى المال لا تلوي عليه يدي ، % أولاني الود ، إذ أوليته المدحا % % 42(@)(@@) % يا أيها الملك المحسود آمله ، % والمجتدى جود عافيه لما منحا % % 43(@)(@@) % لو أدعت جودك الأفواه لاتهمت ، % ولو تتعاطاه لج البحر لافتضحا % % 44(@)(@@) % حزت العلى ، فدعاك الناس سيدهم ، % والكأس لولا الحميا سميت قدحا % % 45(@)(@@) % في وصفنا لك بالإنعام سوء ثنا ، % والغيث ينقصه إن قيل قد سمحا % % 46(@)(@@) % يا باذلا من كنوز المال ما ذخروا ، % وقابضا من صيود الشكر ما سنحا % % 47(@)(@@) % وملبسي النعم اللاتي يباعدني % % عنها الحياء ، فلا أنفك منتزحا % % 48(@)(@@) % لئن خصصتك في عيد بتهنئة ، % فما أجدت ، ولا عذري به وضحا % % 49(@)(@@) % العيد نذكره في العام واحدة ، % وجود كفك عيد قط ما برحا % % 50(@)(@@) % لكن أهني بك الدين الحنيف ، فقد % % أتيت للدين مخلوقا كما اقترحا % % PageV01P230 51(@)(@@) % فاسلم ، فما ضرني ، مما دام جودك لي ، % سواك إن منع الإحسان أو منحا % % PageV01P231 البحر : طويل 1(@)(@@) % لعل ليالي الربوتين تعود ، % فتشرق من بعد الأفول سعود % 2(@)(@@) % ويخصب ربع الأنس من بعد محله ، % ويورق من دوح التواصل عود % 3(@)(@@) % سقى حلبا صوب العهاد ، وإن وهت % مواثيق من سكانها وعهود % 4(@)(@@) % وحيا على أعلى العقيقة منزلا ، % عيون ظباء للأسود تصيد % 5(@)(@@) % إذا ما انتضت فيه اللحاظ سيوفها ، % فإن قلوب العاشقين غمود % 6(@)(@@) % رددنا 
ms69	 به بيض الصفاح كليلة ، % فصالت علينا أعين وقدود % 7(@)(@@) % فلله عيش بالحبيب قضيته ، % فويق قويق ، والزمان حميد % 8(@)(@@) % بظبي من الأتراك في روض خده % غدير مياه الحسن فيه ركود % 9(@)(@@) % تملكته رقا ، فكان لحسنه ، % هو المالك المولى ، ونحن عبيد % 10(@)(@@) % فكنت ابن همام ، وقد ظفرت يدي % % به ، ودمشق في القياس زبيد % PageV01P232 11(@)(@@) % إلى أن قضى التفريق فينا قضاءه ، % وذلك ما قد كنت منه أحيد % 12(@)(@@) % فغيب بدرا يفضح البدر نوره ، % وغصنا يميت الغصن حين يميد % 13(@)(@@) % وقد كنت أخشى فيه من كيد حاسد ، % ولم أدر أن الدهر فيه حسود % 14(@)(@@) % فيا من يراه القلب ، وهو محجب ، % وتوجده الأفكار ، وهو فقيد % 15(@)(@@) % إذا كنت عن عيني بعيدا ، فكل ما % % أسر به ، إلا الحمام ، بعيد % 16(@)(@@) % وما ناب عنك الغير عندي ، وقلما % % ينوب عن الماء القراح صعيد % 17(@)(@@) % إذا كنت في أهلي ورهطي ولم تكن % لدي ، فإني بينهم لوحيد % 18(@)(@@) % وإن كنت في قفر الفلاة مقربا % إلي ، فعيشي في الفلاة رغيد % 19(@)(@@) % ولو كنت تشرى بالنفيس بذلته ، % ولو أن حبات القلوب نقود % 20(@)(@@) % ولكن من أودى هواك بلبه % مريد لما أصبحت منك أريد % PageV01P233 21(@)(@@) % جلوت له وجها وقدا مرنحا ، % وفرعا وفرقا وافر ومديد % 22(@)(@@) % فشاهد بدرا فوق غصن يظله % دجى ، لاح فيه للصباح عمود % 23(@)(@@) % أقول ، وقد حق الفراق ، وأحدقت % من الترك حولي عدة وعديد % 24(@)(@@) % وقد حجب الظبي الرقيب ، وأقبلت % تمانعني دون الكناس أسود % 25(@)(@@) % وتنظرني شزرا ، من السمر والظبى ، % نواظر إلا أنهن حديد % 26(@)(@@) % لك اللهث من جان علي برغمه ، % ومتهم بالغدر ، وهو ودود % 27(@)(@@) % ومن بات مغصوبا على ترك صحبتي % % بنزع مريد الأنس ، وهو مريد % 28(@)(@@) % معطلة بين السلو لفقده ، % وقصر غرامي في هواه مشيد % 29(@)(@@) % ولم يبق إلا حسرة وتذكر ، % وطيف يرى في مضجعي ، فيرود % 30(@)(@@) % جزى الله عني الطيف خيرا ، فإنه % يعيد لي اللذات حين يعود % PageV01P234 31(@)(@@) % سرى من أعالي الشام يقصد مثله ، % ونحن بأعلى ماردين هجود % 32(@)(@@) % فقضيت عيشا ، لو قضيناه يقظة ، % لقامت علينا للإله حدود 
ms70	 % 33(@)(@@) % وبرق حكى ثغر الحبيب ابتسامه ، % تألق وهنا ، والرفاق رقود % 34(@)(@@) % يعلم عيني البكا ، وهو إلفها % % وإن كان دمعي ما عليه مزيد % 35(@)(@@) % كما علمت صوب الحيا ، وهو عالم ، % يد الصالح السلطان ، كيف يجود % 36(@)(@@) % مليك ، إذا رام الفخار سمت به % إلى الفخر آباء له وجدود % 37(@)(@@) % إذا جاد فالبيد السباسب أبحر ؛ % وإن صال ، فالشم الشواهق بيد % 38(@)(@@) % سماح له تحت الطباق تحذر ، % وعزم له فوق الشداد صعود % 39(@)(@@) % لياليه بيض عند بذل هباته ، % وأيامه ، عند الوقائع ، سود % 40(@)(@@) % يرنحه سمع المديح تكرما ، % وإن لبيدا عنده لبليد % PageV01P235 41(@)(@@) % وقفت ، وأهل العصر تنشر فضله ، % ويسألني عن مجده ، فأعيد % 42(@)(@@) % فقالوا : له حكم ؛ فقلت : وحكمة ؛ % فقالوا : له جد ؛ فقلت : وجود % 43(@)(@@) % فقالوا : له قدر ؛ فقلت : وقدرة ؛ % فقالوا : له عزم ؛ فقلت : شديد % 44(@)(@@) % فقالوا : له عفو ؛ فقلت : وعفة ؛ % فقالوا : له رأي ؛ فقلت : سديد % 45(@)(@@) % فقالوا : له أهل ؛ فقلت : أهلة ؛ % فقالوا : له بيت ؛ فقلت : قصيد % 46(@)(@@) % من القوم في متن الجياد ولادهم ، % كأ ، متون الصافنات مهود % 47(@)(@@) % غيوث لهم يوم الجياد من الظبى % % بروق ، ومن وطء الجهاد رعود % 48(@)(@@) % أيا ملكا لو يستطيع سميه % تحمله ما خالفته ثمود % 49(@)(@@) % دعيت لملك لا يؤودك حفظه ، % وإن كان ثقلا للجيال يؤود % 50(@)(@@) % فقومت زيغ الحق ، وهو ممنع ، % وقمت بعبء الملك ، وهو شديد % PageV01P236 51(@)(@@) % وسهدت في رعي العباد نواظرا ، % بها الناس في ظل الأمان رقود % 52(@)(@@) % وأحييت آثار الشهيد بنائل % مع الناس منه سائق وشهيد % 53(@)(@@) % فيا لك سيفا في يدي آل أرتق ، % يدافع عن أحسابهم ويذود % 54(@)(@@) % ويا حامل الأثقال ، وهي شدائد ، % ويا متلف الأموال ، وهي جنود % 55(@)(@@) % لك الله قد جزت الكواكب صاعدا ، % إلى الغاية القصوى ، فأين تريد % 56(@)(@@) % يهنيك بالعيد السعيد معاشر ، % ولي كل يوم من هنائك عيد % 57(@)(@@) % ولو أن عيد النحر نحر مجسم % غدا فيك مدحي ، وهو فيه عقود % 58(@)(@@) % ولولا هواكم ما سرت لي مدحة ، % ولا شاع لي بين الأنام قصيد % 59(@)(@@) % ولما جلوت المدح ، وارتحت للندى ، % ورحنا ، وكل في الطلاب 
ms71	 مجيد % 60(@)(@@) % قصدنا المعاني ، والمعالي ، فلم أزل % أجيدث بأشعاري ، وأنت تجود % PageV01P237 61(@)(@@) % يقولون لي : قد قل نهضك للسرى ، % وما علموة ا أن النوال قيود % 62(@)(@@) % فقلت : مللت السير مذ ظفرت يدي % % بأضعاف ما أختاره وأريد % 63(@)(@@) % لدى ملك كالرمح أما سنانه % فماض ، وأما ظله فمديد % 64(@)(@@) % تبنه لي ، والعز عني راقد ، % وقام بنصري ، والأنام قعود % 65(@)(@@) % فيا قبلة الجود التي لبني الرجا % % ركوع إلى أركانها وسجود % 66(@)(@@) % ليهنك ملك لا يزال مخيما % لديك ، وذكر في الأنام شريد % 67(@)(@@) % لئن بت محسود الخصال ، فلا أذى ، % كذا من غدا في الناس ، وهو فريد % 68(@)(@@) % إذا عم نور البدر في أفق سعده ، % فما ضره أن السماك حسود % PageV01P238 البحر : سريع 1(@)(@@) % نم بسر الروض خفق الرياح ، % واقتدح الشرق زناد الصباح % 2(@)(@@) % وأخجل الورد شعاع الضحى ، % فابتسمت منه ثغور الأقاح % 3(@)(@@) % وقام في الدوح لنعي الدجى ، % حمائم تطربنا بالصياح % 4(@)(@@) % مذ ولد الصبح ومات الدجى % % صاحت ، فلم ندر غنا أم نواح % 5(@)(@@) % ويوم دجن حجبت شمسه ، % وأشرقت في ليله شمس راح % 6(@)(@@) % فما ظننا الصبح إلا دجى ، % ولا حسبنا الليل إلا صباح % 7(@)(@@) % وقابت نور الضحى أوجه % للغيد تبغي في الصباح اصطباح % 8(@)(@@) % فظلت ذا النورين في مجلسي % % منوجه صبح ووجوه صباح % 9(@)(@@) % وشادن إن جال ماء الحيا % % في مقلتيه زادهن اتقاح % 10(@)(@@) % يسكرنا من خمر ألحاظه ، % ويمزج الجد لنا بالمزاح % PageV01P239 11(@)(@@) % من لحظه يسقي ، ومن لفظه % وريقه خمرا حلالا مباح % 12(@)(@@) % نواظر تعزى إليها الظبى ، % وقامة تعزى إليها الرماح % 13(@)(@@) % يا عاذلي في حسن أوصافه ، % ومسمعي وصف الفتاة الرداح % 14(@)(@@) % في حب ذي القرطين ، يا لائمي ، % لي شاغل عن حب ذات الوشاح % 15(@)(@@) % دعني أقضي العيش في غبطة % متبعا مغدى الهوى والمراح % 16(@)(@@) % من قبل أن يهتف داعي النوى ، % فلم أجد عن بيننا من براح % 17(@)(@@) % فكل يوم لي برغم العلى % % في كل أرض غربة وانتزاح % 18(@)(@@) % واضيعة العمر وفوت المنى ، % بين رضى الكوم وسخط الملاح % % 19(@)(@@) % ورب ليل خضت تياره % بأدهم يسبق جري 
ms72	 الرياح % 20(@)(@@) % محجل الأربع ذي غرة % ميمونة الطلعة ذات اتضاح % PageV01P240 21(@)(@@) % كأنه قد شق بحر الدجى ، % وبعده خاض غدير الصباح % 22(@)(@@) % لم تعلم الأبصار في جريه % قادمة خفت به أم جناح % 23(@)(@@) % مذ فسد العيش رأى قصده % للملك الصالح عين الصلاح % 24(@)(@@) % الملك الندب الذي شكره % صار اعتبارا للورى واصطلاح % 25(@)(@@) % ممنع المجد رفيع العلى ، % لهم يك إلا ماله مستباح % 26(@)(@@) % يكاد من دقة أفكاره % يزري بما يجري القضاء المتاح % 27(@)(@@) % له يد ، إن جاد ، كانت حيا ، % وهمة ، إن جال ، كانت سلاح % 28(@)(@@) % ورحب صدر كلما هيمنت % فيه نسيم المدح زاد ارتياح % 29(@)(@@) % يا حامل الأثقال من بعد ما % % حط مرارا غيره واستراح % 30(@)(@@) % لولاك ، يا وابل ، زرع الندى % % أضحى هشيما ، وذرته الرياح % PageV01P241 31(@)(@@) % يا ابن الذي حج إليه الورى % % لكونه كعبة دين السماح % 32(@)(@@) % إن قصرت منى إليك الخطى ، % ما قصرت مني يد الامتداح % 33(@)(@@) % فقد جعلت الأرض من مدحكم % % خضرا ، وشعري جائل كالوشاح % 34(@)(@@) % خفضت بالنصب استعاراته ، % كما أعير الذل خفض الجناح % 35(@)(@@) % إذا تلاه الوفد قال الورى : % هذا هو السحر الحلال المباح % 36(@)(@@) % ذكرك كالمسك ، ولكنه % إن ضوعته نسمة المدح فاح % PageV01P242 البحر : كامل تام 1(@)(@@) % إني ليطربني العذول ، فأنثني ، % فيظن عن هواكم أنثني % % 2(@)(@@) % ويلذ لي تذكاركم ، فأعيره % % أذنا لغير حديثكم لم تأذن % 3(@)(@@) % وأقول للاحي الملح بذكركم : % زدني ، لعمر أبيك ، قد أطربتني % % 4(@)(@@) % أسكرتني بسلاف ذكر أحبتي ، % يا مترع الكاسات ، فاملأ واسقني % % 5(@)(@@) % يا ساكني جيرون جرتم في الهوى ، % الجور شر خلائق المتمكن % 6(@)(@@) % وسمعتم قول الوشاة ، وإنه % % ظن رميت به بغير تيقن % 7(@)(@@) % أيسوم إشراكي بدين هواكم % من ليس في شرع الغرام بمؤمن % 8(@)(@@) % يا عاذلي إن كنت تجهل ما الهوى ، % فانظر ظباء الترك كيف تركنني % % 9(@)(@@) % واعجب لأعينهن كيف أسرنني % % من معشري وأخذنني من مأمني % % 10(@)(@@) % بيض الطلى سمر القدود نواصع ال % % وجنات حمر الحلي سود الأعين % PageV01P243 11(@)(@@) % ومن كل فاضحة الجبين كأنها % % شمس النار بدت بليل أدكن % 12(@)(@@) % يسمو لها كحل بغير تكحل 
ms73	 ، % ويزينها حسن بغبر تحسن % 13(@)(@@) % ومضعف الأجفان فوق لحظه % % نبلا على بعد المدى لم يخطبني % % 14(@)(@@) % إن قلت : ملت على المتيم ، قال لي : % أرأيت غصنا لا يميل وينثني % % 15(@)(@@) % أو قلت : أتلفت الفؤاد ، أجابني : % دعني ، فما أخربت إلا مسكني % % 16(@)(@@) % أو قلت : يا دنياي ، قال : فإن أكن % % دنياك لم أنكرت فرط تلوني % % 17(@)(@@) % لم أنس إذ نادمته في ليلة % عدل الزمان بمثلها لم يمنن % 18(@)(@@) % والراح تبذل في الكؤوس كأنها % % لفظ تلجلج من لسان ألكن % 19(@)(@@) % حتى إذا ما السكر ثقل عطفه % % كسلا ، وسكن منه ما لم يسكن % 20(@)(@@) % عاجلته حذرا عليه من الردى ، % عجل الجفون إلى حفاظ الأعين % PageV01P244 21(@)(@@) % وضممته من غير موضع ريبة ، % وأطعت فيه تعففي وتديني % % 22(@)(@@) % نحن الذين أتى الكتاب مخبرا % بعفاف أنفسنا وفسق الألسن % 23(@)(@@) % وكذاك لا أنفك ألقي مقودي % % طوع الهوى ، وأعف عند تمكني % % 24(@)(@@) % فإذا أقمت جعلت أنباء العلى % % سكني ، وأبنية المعالي مسكني % % 25(@)(@@) % وإذا رحلت ، فجنتي أجم القنا ، % وعلى متون الصافنات تحصني % % 26(@)(@@) % ولكم ألفت الإغتراب ، فلم يزل % جواد ابن أرتق في التغرب موطني % % 27(@)(@@) % الصالح الملك الذي إنعامه % كنز الفقير ، وطوق جيد المغتني % % 28(@)(@@) % ملك يريك ، إذا خطبت سماحه ، % عذرن المسيء وجود كف المحسن % 29(@)(@@) % متألق ، متدفق ، مترفق ، % للمجتلي ، والمجتدي ، والمجتني % % 30(@)(@@) % بفضائل ، وفواضل ، وشمائل % قيد الخواطر والثنا والأعين % PageV01P245 31(@)(@@) % فإذا تبدى كان قيد عيوننا ؛ % وإذا تلفظ كان قيد الألسن % 32(@)(@@) % يرجى ويخشى جوده ونكاله ، % في يوم مكرمة وخطب مزمن % 33(@)(@@) % كالبحر يرغب في جواهر لجه % عند الورود ، وهوله لم يؤمن % 34(@)(@@) % يا طالبا منا حدود صفاته ، % أتعبتنا بطلاب ما لم يمكن % 35(@)(@@) % يا أيها الملك الذي في حربه % بالعزم عن حد الصوارم يغتني % % 36(@)(@@) % لو أن رأيك للدجنة لم تحل % صبغا ، وللحرباء لم تتلون % 37(@)(@@) % فإذا هززت الرمح نكس رأسه ، % وأجاب : ها إني كما عودتني % % 38(@)(@@) % وإذا سألت السيف قال فرنده : % لا علم لي إلا الذي علمتني % % 39(@)(@@) % هذي يمينك والوغى ومضاربي % % ودم الفوارس والظما بي فاسقني % % 40(@)(@@) % يا من 
ms74	 رماني عن قسي سماحه % بسهام أنعمه التي لم تخطني % % PageV01P246 41(@)(@@) % أغرقتني بالجود مع سأمي له % ردا علي ، فكيف لو قلت : اعطني % % 42(@)(@@) % يعتادني بالشام برك واصلا ، % طورا ، وطورا في بلاد الأرمن % 43(@)(@@) % ويزورني في غيبتي ، ويحوطني % % في أوبتي ، ويعودني في موطني % % 44(@)(@@) % أتعبتني بالشكر أعجز طاقتي ، % وظننت أنك بالنوال أرحتني % % 45(@)(@@) % أخفيت برك لي ، فأعلن منطقي ، % لا يشكر النعماء من لم يعلن % 46(@)(@@) % شهدت علومك أنني لك وامق ، % والله يعلم والأنام بأنني % % 47(@)(@@) % وعرفت رأيك بي ، فلو كشف الغطا % % عن حالة ما ازداد فيك تيقني % % 48(@)(@@) % عودتني صفو الوداد ، فعد به ، % واصبر لعادتك التي عودتني % % 49(@)(@@) % واعذر محبا حبه لعلاكم % طبع ، وصفو وداده من معدن % 50(@)(@@) % يعو لدولتك الشريفة مخلصا ، % والناس بين مؤمل ومؤمن % PageV01P247 البحر : كامل تام 1(@)(@@) % خذ فرصة اللذات قبل فواتها ، % وإذا دعتك إلى المدام ، فواتها % % 2(@)(@@) % وإذا ذكرت التائبين عن الطلا % % لا تنس حسرتهم على أوقاتها % % 3(@)(@@) % يرنون بالألحاظ شزرا كلما % % صبغت أشعتها أكف سقاتها % % 4(@)(@@) % كأس كساها النور لما أن بدا % % مصباح جرم الراح في مشكاتها % % 5(@)(@@) % صفها إذا جليت بأحسن وصفها % % كي نشرك الأسماع في لذاتها % % 6(@)(@@) % لولا التذاذ السامعين بذكرها % % لغنيت عن أسمائها بسماتها % % 7(@)(@@) % وإذا سمعت بأن ، قدما ، مظهرا % عنها النفار ، فتلك من آياتها % % 8(@)(@@) % ذنب ، إذا عد الذنوب رأيته % من حسنه كالخال في وجناتها % % 9(@)(@@) % راح حكت ثغر الحبيب وخده % % بحبابها ، وصفائها ، وصفاتها % % 10(@)(@@) % فكأنما في الكاس قابل صفوها % % ثغر الحبيب ، ولاح في مرآتها % % PageV01P248 11(@)(@@) % ولئن نهى عنها المشيب ، فطالما % % نشأت لي الأفراح من نشواتها % % 12(@)(@@) % والقضب دانية علي ظلالها ، % والزهر تاجات على هاماتها % % 13(@)(@@) % والماء يخفي في التدفق صوته ، % والورق تسجع باختلاف لغاتها % % 14(@)(@@) % ولقد تركت وصالها عن قدرة ، % وزجرت داعي النفس عن شبهاتها % % 15(@)(@@) % لم أشك جور الحادثات ، ولم أقل : % حالت بي الأيام عن حالاتها % % 16(@)(@@) % ما لي أعد لها مساوىء جمة ، % والصالح السلطان من حسناتها % % 17(@)(@@) % رب العفاف المحض والنفس التي % % غلبت مروءتها على شهواتها % % 18(@)(@@) % ملكية فلكية يسمو 
ms75	 بها % % كرم ترنح كنهه في ذاتها % % 19(@)(@@) % تحتال في العذر الجميل لوفدها % % كرما ، ولكن بعد بذل هباتها % % 20(@)(@@) % سبقت مواهبه السؤال ، فما له % % عدة مؤجلة إلى ميقاتها % % PageV01P249 21(@)(@@) % ملك تقر له الملوك بأنه % إنسان أعينها وعين حياتها % % 22(@)(@@) % لو لم ينط بالبشر هيبة وجهه % ذهلت بنور الآمال عن حاجاتها % % 23(@)(@@) % يعطي الألوف لوافديه براحة % تثني يد الأيام عن سطواتها % % 24(@)(@@) % فكأنما قتل الحوادث دونها % % وغدا يؤدي للعفاة دياتها % % 25(@)(@@) % من فتية راض الوقار نفوسها ، % فبدا سكون الحلم في حركاتها % % 26(@)(@@) % لو أمها يوم القيامة طالب % نقلت إلى ميزانه حسناتها % % 27(@)(@@) % في كفه القلم الذي خضعت له % % بيض الصفاح وفل حد شباتها % % 28(@)(@@) % وسطا على الأرماح ، وهو ربيبها % % وأليفها في الغاب عند نباتها % % 29(@)(@@) % قلم فرى كبد الأسود ، وما رعى % % حق الجوار لهن في أجماتها % % 30(@)(@@) % ما شاهد الأملاك مجة ريقه ، % إلا وجف الريق في لهواتها % % PageV01P250 31(@)(@@) % يا أيها الملك الذي سطواته % حلمت بها الأعداء في يقظاتها % % 32(@)(@@) % إن كنت من بعض الأنام فإنما % % غرر الجياد تعد بعض شياتها % % 33(@)(@@) % شهدت لراحتك السحائب أنها % % ري البسيطة ، وهي من ضراتها % % 34(@)(@@) % فالناس تدعوها مفاتح رزقها ، % وتعدها الأموال من آفاتها % % 35(@)(@@) % شتت شمل المال بعد وفوره ، % وجمعت شمل الناس بعد شتاتها % % 36(@)(@@) % فظهرت بالعدل الذي أمسى به % في البيد يخشى ذيبها من شاتها % % 37(@)(@@) % تبدي ابتساما للعداة ، وراءه % رأي ينكس في الوغى راياتها % % 38(@)(@@) % كالسمر تبدي للنواظر منظرا % متألقا ، والموت في شفراتها % % 39(@)(@@) % وكتيبة تختال في أجم القنا % % كالأسد تسري ، وهي في غاباتها % % 40(@)(@@) % سيان ما تحوي السروج وما حوت % أيدي الفوارس من سر يحياتها % % PageV01P251 41(@)(@@) % أرسلت فيها للرماح أراقما % لسبت قلوب حماتها بحماتها % % 42(@)(@@) % جشمتها جردا ، إذا رمت العلى % % أرسلتها ، فجرت إلى غاياتها % % 43(@)(@@) % ما بين عينيها الأسنة طلع ، % فكأنها غرر على جبهاتها % % 44(@)(@@) % سدت حوافرها الفضاء بعثير ، % غنيت به العقبان عن وكناتها % % 45(@)(@@) % صافحت هامات العدى بصفائح % دبت نمال الموت في صفحاتها % % 46(@)(@@) % حتى أعدت بها الجياد وشهبها % % حمر لوخز السمر 
ms76	 في لباتها % % 47(@)(@@) % وجعلت أشلاء الكماة كأنما % % ذخرت لقوت الوحش في فلواتها % % 48(@)(@@) % ضمنت بها قوت الوحوش فأصبحت % عند العريكة ، وهي من أقواتها % % 49(@)(@@) % يا حامل الأثقال ، وهي شدائد ، % والخائض الأهوال من غمراتها % % 50(@)(@@) % ومفرج الكرب التي لو صافحت % شم الجبال لزلزلت هضباتها % % PageV01P252 51(@)(@@) % قد كاد يغرق بحر نائلك الورى ، % فجعلت سر الجود سفن نجاتها % % 52(@)(@@) % فاسعد بعيد أنتم عيد له ، % ومواسم بكم هنا ميقاتها % % 53(@)(@@) % فطر فطرت بيمنه كبد العدى ، % فشغلت أنفسها بها عن ذاتها % % 54(@)(@@) % ووصلت فيه العاكفين على التقى ، % فشركتها في صومها وصلاتها % % 55(@)(@@) % فاستجلها من حور حلة بابل ، % فلذاك تبدي السحر من نفثاتها % % 56(@)(@@) % ظمآنة للقاك ، وهي روية ، % ببدائع تروي غليل رواتها % % 57(@)(@@) % % من قربش حضرتكم على عادتها % % 58(@)(@@) % تستنجز الوعد الشريف لريها % % لتروع قلب عداتها بعداتها % % 59(@)(@@) % هذي كنوز الشكر وافرة لكم ، % فاجعل نجاز الوعد بعض زكاتها % % PageV01P253 البحر : طويل 1(@)(@@) % أيا ملك العصر الذي شاع فضله ، % ويا ابن ملوك العرب والعجم والترك % 2(@)(@@) % ومن علمتني المدح أوصاف مجده ، % فما زدتها عند النظام سوى السلك % 3(@)(@@) % لقد غمرتني من أياديك أنعم ، % ملكت بها رقي وإن أكثرت ملكي % % 4(@)(@@) % أعد ، غذا فارقت مغناك ، تاجرا % فإن أبت ظنوني شريكك في الملك % 5(@)(@@) % لذلك لم تثن الخطوب مودتي ، % ولكنني مثل النضار على السبك % 6(@)(@@) % فإن يك صرف الدهر قد حك جانبي % % ليخبرني ، والتبر يخبر بالحك % 7(@)(@@) % فقد زدت وقع الحوادث رغبة ، % كما زاد فرط السحق في أرج المسك % 8(@)(@@) % فإن أخطأتني من نداك سحابة ، % فما غيرت حبي ، ولا أوجبت تركي % % 9(@)(@@) % لأني من أهل اليقين على الوفا ، % وقد يحدث التغيير عند ذوي الشك % PageV01P254 البحر : خفيف تام 1(@)(@@) % يا مليكا قد طاب أصلا وفرعا ، % وزكت من أصوله الأعراق % 2(@)(@@) % والذي جمع الفضائل والحمد % والمال في يديه افتراق % 3(@)(@@) % كم تحملت في طلابك للعلياء % ثقلا يسيره لا يطاق % 4(@)(@@) % لا تخف إن أضاعت المال كفا % % كن ففيهن للعلاء اتفاق % 5(@)(@@) % لا يضر القضيب ، وهو نضير ، % أن تزول الثمار والأوراق % PageV01P255 البحر : طويل 
ms77	 1(@)(@@) % رعى الله ملكا ما رمتني بربعه % مرامي النوى ، إلا بلغت مراميا % % 2(@)(@@) % فتى ربني بالمكرمات وبرني ، % وأصلح ما بيني وبين زمانيا % % 3(@)(@@) % وكم حاجة حاولتها من جنابه ، % وألحقت في قولي له وخطابيا % % 4(@)(@@) % فلم يلق إلحاحي بحب ، وإنما % % أجاد التغاضي ، إذ أسأت التقاضيا % % PageV01P256 البحر : وافر تام 1(@)(@@) % أجرد كي أجرد سيف مدحي ، % فينبو عن سواك به لساني % % 2(@)(@@) % وأنظم مدح غيرك والقوافي % % تعض علي أطراف البنان % 3(@)(@@) % فأظهر حيرة في بسط عذري ، % وأخفي ما يجن لكم جناني % % 4(@)(@@) % فإن أفعل تألمت المعالي ؛ % وإن أنكل تظلمت المعاني % % PageV01P257 البحر : مجتث 1(@)(@@) % شملت جمع صحابي ، % بفيض جود وفضل % 2(@)(@@) % فأنت شامل جمعي ؛ % وأنت جامع شملي % % PageV01P258 البحر : طويل 1(@)(@@) % سأثني على نعماك بالكلم التي % % بها تضرب الأمثال في اللفظ والفضل % 2(@)(@@) % بها تطرد السارون عن جفنها الكرى ، % وتجلب طيب النوم في المهد للطفل % PageV01P259 البحر : طويل 1(@)(@@) % سأثني على نعماك ما دمت باقيا ، % وإن مت يثني منطق الطرس من بعدي % % 2(@)(@@) % فقد أودعت صدر الطروس بدائعي ، % لمجدك ما يقضي لذكرك بالخلد % PageV01P260 البحر : كامل تام 1(@)(@@) % أطلقت نطقي بالمحامد عندما % % قيدتني بسوابق الإنعام % 2(@)(@@) % فليشكرنك نيابة عن منطقي % % صدر الطروس وألسن الأقلام % PageV01P261 البحر : طويل 1(@)(@@) % سأشكر نعماك التي لو جحدتها % % أقر بها حالي ، ونم بها سري % % 2(@)(@@) % وفي حسن حال الروض اعدل شاهد % يقر بما أسدت إليه يد القطر % PageV01P262 البحر : طويل 1(@)(@@) % سأثني على نعماك بالكلم التي % % محاسنها تبلي الزمان ، ولا تبلى % % 2(@)(@@) % وأشكر شكرا ليس لي فيه منة ، % ولا منة للروض إن شكر الوبلا % % PageV01P263 البحر : كامل تام 1(@)(@@) % أهلا بها كالقضب في كثبانها ، % جعلت شواظ النار من تيجانها % % 2(@)(@@) % شهب ، إذا جلت الظلام جيوشها % % جلبت جيوش الصبح قبل أوانها % % 3(@)(@@) % مأسورة تحيا بقطع رؤوسها ، % وتزيد نطقا عند قط لسانها % % 4(@)(@@) % باحت أسرة وجهها بسرائر % ضاقت صدور الناس عن كتمانها % % 5(@)(@@) % زهر حكت خد الحبيب ، وإنما % % تحكي فؤاد الصب في خفقانها % % 6(@)(@@) % لهبت وقد رأت الظلام ، ولم تكن ، % تالله ، لاهية لضعف جنانها % % 7(@)(@@) % بل أرعدت 
ms78	 منها الفرائص عندما % % نظرت نواظرها إلى سلطانها % % 8(@)(@@) % الصالح الملك الذي نعماؤه % قد أغنت الغرباء عن أوطانها % % 9(@)(@@) % ذي طلعة جلت العيون بحسنها ، % وجلت هموم الناس من إحسانها % % PageV01P264 البحر : كامل تام 1(@)(@@) % أهلا بشهب في سماء المجلس ، % هتكت أشعتها حجاب الحندس % 2(@)(@@) % زهر إذا أرخى الظلام ستورة % % فعلت بها كصحيفة المتلمس % 3(@)(@@) % هيف القدود تريك بهجة منظر % أبهى لديك من الجواري الكنس % 4(@)(@@) % كالقضب إلا أنها لا تنثني % % منها القدود ، وزهرها لم يلمس % 5(@)(@@) % أذكت لحاظ عيونها فكأنها % % زهر تفتح في حديقة نرجس % 6(@)(@@) % نابت عن الشمس المنيرة عندما % % حبست وساطع نورها لم يحبس % 7(@)(@@) % وإذا تحدرت النجوم رأيتها % % ترعى النجوم بمقلة لم تنعس % 8(@)(@@) % وضحت أسرتها وقد عبس الدجى ، % وتنفست والصبح لم يتنفس % 9(@)(@@) % إن خاطبتها الريح رد لسانها % % همسا كلجلجة اللسان الأخرس % 10(@)(@@) % وإذا توعدها النسيم ترى لها % % خفقا كقلب الخائف المتوسوس % PageV01P265 11(@)(@@) % في طرفها عمق ، إذا حققته ، % لم يبد منها الإسم إن لم يعكس % 12(@)(@@) % عجبا لها تبدي لقط لسانها % % بشرا وتحيا عند قطع الأرؤس % 13(@)(@@) % رضيت ببذل النفس حين تبوأت % من حضرة السلطان أشرف مجلس % 14(@)(@@) % الصالح الملك الذي إنعامه % قيد الغني ، وطوق جيد المفلس % 15(@)(@@) % شمس حكى الشمس المنيرة باسمه % % وضياء مجلسه وبعد الملمس % 16(@)(@@) % هو صاحب البلد الذي لسماحه % بالرفق يبلغ لا بشق الأنفس % 17(@)(@@) % لا زال في أوج السعادة لابسا % من حلة النعماء أشرف ملبس % PageV01P266 البحر : كامل تام 1(@)(@@) % أهلا بها شمط الذوائب والذرى ، % تعشو إلى نيرانها نار القرى % % 2(@)(@@) % شهبا ، إذا مد الظلام رواقه ، % جعلت ظلام الليل صبحا نيرا % % 3(@)(@@) % تذكى لدى ملك يرجى جوده ، % وتخاف من سطواته أسد الشرى % % 4(@)(@@) % الصالح الملك الذي بسماحه % أمسى الثرا وطأ لمن وطىء الثرى % % 5(@)(@@) % لازال شمل الملك منتظما به ، % والعز ممتد الرواق كما ترى % % PageV01P267 البحر : مجزوء الكامل 1(@)(@@) % نار الشموع توقدت % في الليل أم نور الشموس % 2(@)(@@) % شهب تبشر بالسعود ، % وليس تقضي بالنحوس % 3(@)(@@) % شبه الذوابل قومت % للطعن في صدر الخميس % 4(@)(@@) % شوس النواظر 
ms79	 ، وهي في % % غير الدجنة غير شوس % 5(@)(@@) % إن طال فضل لسانها ، % فجزاؤها قطع الرؤوس % 6(@)(@@) % وإذا تجلت للنوا % % ظر رجحت رأي المجوس % 7(@)(@@) % في حضرة الملك الذي % % جعل الصناع كالغروس % 8(@)(@@) % الصالح السلطان وها % % ب النفائس للنفوس % 9(@)(@@) % فضل الملوك بأصله ، % فضل الرئيس على الرؤوس % 10(@)(@@) % وغدا ثناه غرة ، % في جبهة الدهر العبوس % PageV01P268 البحر : طويل 1(@)(@@) % ومذ أطفأ الشمع النسيم بمجلس % به نور شمس الدين كالشمس ساطع % 2(@)(@@) % عذرنا ، وقلنا ما أتى ببديعة % لأن اشتعال الشمع في الشمس ضائع % PageV01P269 البحر : سريع 1(@)(@@) % أهلا بشهب عند إشرافها % % يجلي الدجى من نورها الواضح % 2(@)(@@) % تنضب بحر الليل ، إذ تغتدي % % ناهلة من لجه الطافح % 3(@)(@@) % كأنما أيمانها عزمة % من عزمات الملك الصالح % 4(@)(@@) % ملك يظل الدهر في حكمه % % مقتبسا من رأيه القادح % 5(@)(@@) % ومن غدا سائح إنعامه % يملأ قلب الآمل السانح % 6(@)(@@) % لا برحت رتبة سلطانه % تسمو على الأعزل والرامح % PageV01P270 البحر : كامل تام 1(@)(@@) % أنجوم روض أم نحوم سماء ، % كشفت أشعتها دجى الظلماء % 2(@)(@@) % أشرقن في حلل الظلام فحدقت % حسدا لهن كواكب الجوزاء % 3(@)(@@) % من كل هيفاء المعاطف قومت % قدا كقد الصعدة السمراء % 4(@)(@@) % جسم كصخر في صلابة جرمه ، % وجفونها في الدمع كالخنساء % 5(@)(@@) % تجري مدامعها ، ويضحك وجهها ، % فتظل بين تبسم وبكاء % 6(@)(@@) % تبكي لغربتها وتبسم إذ غدت % في حضرة السلطان كل مساء % 7(@)(@@) % الصالح الملك الذي أكنافه % كهف الوفود وكعبة الفقراء % 8(@)(@@) % ملك بسيرة عدله وسماحه % % خفيت مآثر دولة الخلفاء % 9(@)(@@) % لا زال في أفق السعادة راقيا % فوق المجرة في سنا وسناء % PageV01P271 البحر : طويل 1(@)(@@) % ليالي الحمى ما كنت إلا لآليا ، % وجيد سروري بانتظامك حاليا % % 2(@)(@@) % قرنق منك الدهر ما كان ريقا ، % وكدر منك البعد ما كان صافيا % 3(@)(@@) % وقد كنت أخشى من تجافي أحبتي ، % فلما فقدناهم ، وددت التجافيا % % 4(@)(@@) % ومن لي بصد منهم وتجنب ، % إذا كان منا منزل القوم دانيا % % 5(@)(@@) % لقد أرسلت نحوي الغوادي من الحمى % % روائح أرخصن الكبا والغواليا % % 6(@)(@@) % وما أذكرتني سالفات عهودهم ، % تذكر بالأشياء من كان ناسيا 
ms80	 % % 7(@)(@@) % وأغيد رخص الجسم كالماء رقة ، % أكابد قلبا منه كالصخر قاسيا % % 8(@)(@@) % كثير التجني لست ألقاه شاكرا % على مضض ، إلا وألفيه شاكيا % % 9(@)(@@) % يقول ، إذا استشفيت منه بنظرة : % كفى بك داء أن ترى الموت شافيا % % 10(@)(@@) % ويعجب مني إن تمنيت عتبه ، % وحسب المنايا أن يكن أمانيا % % PageV01P272 11(@)(@@) % فوا عجبا يدعى حبيبي ، وإن غدا % % يجاور في سوء الصنيع الأعاديا % % 12(@)(@@) % كما قيل للخرم المخوف مفازة ، % ولقب أصناف العبيد مواليا % % 13(@)(@@) % ولما اعتنقنا للوداع ، وقد وهت % عقود لآلي نحره ومآقيا % % 14(@)(@@) % فحلت عقود الدمع ما كان عاطلا ، % وعطل عقد الضم ما كان حاليا % % 15(@)(@@) % وكم سرت إثر الظاعنين مصيرا % هواي دليلا والذكر حاديا % % 16(@)(@@) % أسير ومن فوقي وتحتي ووجهتي ، % وخلفي ويمناي الهوى وشماليا % % 17(@)(@@) % فما لي إذا يممت في الأرض وجهة % وصرفت في أهل الزمان لحاظيا % % 18(@)(@@) % تضيق علي الأرض حتى كأنني % % أحاول فيها لابنن أرتق ثانيا % % 19(@)(@@) % مليك ، إذا شبهت بالغيث جوده ، % هجوت نداه ، وامتدحت الغواديا % % 20(@)(@@) % يعيد شباب الشيب مرآه في الندى ، % وفي الحرب مرآه يشيب النواصيا % % PageV01P273 21(@)(@@) % يرينا الندى في البأس والبأس في الندى ، % فينعم غضبانا ، وينقم راضيا % % 22(@)(@@) % كبيض الظبى تردي القتيل ضواحكا ، % وسحب الحيا تروي الغليل بواكيا % % 23(@)(@@) % وما لي لا أسعى بمالي ومهجتي ، % إلى من به استدركت روحي وماليا % % 24(@)(@@) % إلى ملك يستخدم الدهر بأسه ، % ويرجع طرف الخطب بالعدل خاسيا % % 25(@)(@@) % إلى ملك يخفي الملوك إذا بدا ، % كما أخفت الشمس النجوم الدراريا % % 26(@)(@@) % إلى ملك يولي الإرادة والردى ، % وتحوي المنايا كفه والأمانيا % % 27(@)(@@) % بوجه غدا للشمس والبدر ثالثا ، % وقلب غدا للجوهر الفرد ثانيا % % 28(@)(@@) % وعزم يزيل الخطب عن مستقره ، % رأينا به السبع الطباق ثمانيا % % 29(@)(@@) % وشدة بأس تترك الماء جامدا ، % جعلت الردى راحا وخيلك راحة ، % 30(@)(@@) % كف تشيم السيف غضبان ضاحكا ، % وتثنيه بعد الكر جذلان باكيا % % PageV01P274 31(@)(@@) % % يعم الأقاصي جوده والأدانيا % % 32(@)(@@) % جواد أباد المال إلا صيانة ، % مخافة أن يمسي من البذل خاليا % % 33(@)(@@) % له قلم ، إن خر في الطرس ساجدا % يخر له ذو التاج في 