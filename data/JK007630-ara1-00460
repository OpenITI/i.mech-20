ms441	 % أو كفلا كان طلى ومفرقا % % 92(@)(@@) % غريبة الحدثان في أزمانها % % بذت فحول الشعراء السبقا % % 93(@)(@@) % إذا الكلام اشتبهت شياته % واختلطت عرفت منها الأبلقا % % 94(@)(@@) % يجهل منها الناس ما علمته % % لا عجبا أن يحرموا وترزقا % % 95(@)(@@) % فهي إليك دون كل خاطب % تزف شفعا وتساق رفقا % % 96(@)(@@) % بشرني عنك الخبير بالتي % % نحي السرور وتميت الحرقا % % 97(@)(@@) % وقال صبرا وانتظر صبح غد % تدني السماء بدرها المحلقا % % 98(@)(@@) % غدا تراه فرفعت ناظرا % كان على قذى الفراق مطبقا % % 99(@)(@@) % وقلت نفسي لك إن قبلتها % % حق البشير قالرهن غلقا % % 100(@)(@@) % قد ملكتني غائبا نعماؤه % وأفعمت قلبي حتى اندفقا % % PageV01P1356 101(@)(@@) % فلم يدع قبل اللقاء طوله % فيه مكان فرحة يوم اللقا % % 102(@)(@@) % فمرحبا إذا صدقت مرحبا % لك المنى إن تم أو تحققا % % 103(@)(@@) % جادتك أنواء السماء أبدا % أين حللت وكفا وودقا % % 104(@)(@@) % ولا عدت بكتبها ونشدها % % سمعك مورودا بها مستطرقا % % 105(@)(@@) % ولا يزال المهرجان واضحا % بها عليك في الطلوع مشرقا % % 106(@)(@@) % والصوم والعيد إلى أن ينطوي % % مر النجوم طبقا فطبقا % % 107(@)(@@) % إذا دعوت الله أن يبقيك لي % % فقد دعوت للمعالي بالبقا % % PageV01P1357 البحر : - 1(@)(@@) % دعاها معقلة بالعراق % إلى أهل نجد هوى مطلق % 2(@)(@@) % فباتت تماكس ثنا الحبا % % ل منها الكراكر والأسؤق % 3(@)(@@) % فيأبى عليها المرير الفتيل % ويسمح والرمة المخلق % 4(@)(@@) % تحنة يا عجبا أن تحن % لو أنها سائل يرزق % 5(@)(@@) % وما هي إلا بروق المنى % % خلابا وما السفح والأبرق % 6(@)(@@) % فهل لمجعجعها أن يروح % لو أن الرواح بها أرفق % 7(@)(@@) % مراتعها أمس أمرى لها % % وترب معاطنها أرفق % 8(@)(@@) % أتت بابلا ونبت بابل % بها وبكى المشئم المعرق % 9(@)(@@) % فخل لها طرقها والظلا % % م تحلم في السير أو تخرق % 10(@)(@@) % وإن كذبتهاديات النجوم % فإن لها مقلا تصدق % PageV01P1358 11(@)(@@) % عسى رقها في ديار الخمول % إذا شارفت عزها يعتق % 12(@)(@@) % وقم أنت فاسبق بها المدلجين % فعفو المياه لمن يسبق % 13(@)(@@) % فإما اعتذرت وإما بلغت % فحظك غاية من يلحق % 14(@)(@@) % كم النوم تحت ظلال القنوع % وفوق القذى جفنك المطبق % 15(@)(@@) % تهب عليك رياح المنى 
ms442	 % % فتروى بما أنت مستنشق % 16(@)(@@) % وخلف العلا وأفاويقها % % لغيرك يصبح أو يغبق % 17(@)(@@) % وكم تستقيم فتمشى الحظوظ % وحظك اعمى الخطا مزلق % 18(@)(@@) % تخفض من حيث تبغي العلا % % وتحرم من حيث تسترزق % 19(@)(@@) % ترود لنفسك غير المراد % فرجل سعت ويد تخفق % 20(@)(@@) % مطالب تنفق فيها الزمان % ومن صلب عمرك ما تنفق % PageV01P1359 21(@)(@@) % وحولك حيث ترى راعياك % ثرى منبت وحيا مغدق % 22(@)(@@) % ودار تعز على أهلها % % ولم تتقلقل بك الأينق % 23(@)(@@) % وأسماع أبناء عبد الرحي % % م تصغى وأبوابهم تطرق % 24(@)(@@) % وأنجمهم لك رعيا تضيء % فتورى وشمسهم تشرق % 25(@)(@@) % وباسم الوزير فعذ بالوزي % % ر يفتح باب الندى المغلق % 26(@)(@@) % ألم ترى للناس في فترة % وقد أكل الأحلم الأخرق % 27(@)(@@) % ومن ركب الشر طالت يداه % وطارت وخود به معنق % 28(@)(@@) % وفي كل سرح أبو جعدة % مكان الرعاة به يعنق % 29(@)(@@) % تجشمه رحض ما دنسوا % % وإحسانه جمع ما فرقوا % % 30(@)(@@) % وكنت تغيب فتشرى الأمو % % ر ثم تعود فتستوسق % PageV01P1360 31(@)(@@) % حمى شرف الدين أطرافها % % ومن خلفها طارد مرهق % 32(@)(@@) % وأضغاث أرسانها في الرقاب % نواصل بالكف لا تعلق % 33(@)(@@) % فقوم والذئب مستأسد % وعدل والفحل مستنوق % 34(@)(@@) % كريم تصلصل من طينة % أعان المطيب بها المعبق % 35(@)(@@) % رأت عين ساسان فيها النمو % وهي على كفه تشرق % 36(@)(@@) % فشجرها شرفا لاحقا % إذا هجن التنسب الملصق % 37(@)(@@) % تلألأ في أفقها أنجم % بحاشيتن بدرها تحدق % 38(@)(@@) % تود البحار لأصدافه % % ن لو هي عن مثلها تغلق % 39(@)(@@) % رعاك مليك رعى الملك منك % بعين على الضيم لا تطرق % 40(@)(@@) % وأنقذه بك فانتاش وه % % و محترش ما له منفق % PageV01P1361 41(@)(@@) % حملت الوزارة حمل المخف % وقد اثقلت غيرك الأوسق % 42(@)(@@) % وكم عالجوها بخرق الأكف % ورأيك في طبها أحذق % 43(@)(@@) % وسعت بصبرك إصلاحها % % وصدر الزمان بها ضيق % 44(@)(@@) % وأخرهم عنك إذ قدمو % % ك أنك تفري الذي تخلق % 45(@)(@@) % وتزنق ما فتقته الرجال % ولا يرتقون كما ترتق % 46(@)(@@) % فكونوا لها كلما عطلت % حلى منكم القلب والأطوق % 47(@)(@@) % وزد شرفا أنت يا تاجها % % ولا افترق التاج والمفرق % 48(@)(@@) % يريد 
ms443	 سواكم ثناء بها % % فتأبى عليه وتستطلق % 49(@)(@@) % ويستروح الناس أثوابها % % وأردانها بكم أعبق % 50(@)(@@) % علوت فما تنحيك الصفات % بسهم ولو أنه مغرق % PageV01P1362 51(@)(@@) % فسيان في مدحك الناجم ال % % معذر والمنتهى المفلق % 52(@)(@@) % إذا جدت أنطقت من لا يدين % % وإن قلت أخرست من ينطق % 53(@)(@@) % فقد شك رب الكلام البليغ % أيكسد عندك ام ينفق % 54(@)(@@) % فداك وكيف له لو فداك % طليق بروعته موثق % 55(@)(@@) % تكنفه مانعات البلا % % د وهو على أمنها يفرق % 56(@)(@@) % يخال سيوفك يخطفنه % ومن دونه الباب والخندق % 57(@)(@@) % ويعلم أن القنا في يديك % يراه على البعد أو يرمق % 58(@)(@@) % وكيف تحيل خفايا الشخوص % على أسمر لحظه ازرق % 59(@)(@@) % تسمع لها تستحف الحلي % % م منها الطلاوة والرونق % 60(@)(@@) % وهاد الكلام وأجباله % طريق بحافرها يطرق % PageV01P1363 61(@)(@@) % نوافث في عقد المانعين % % فكل يبيس بها مورق % 62(@)(@@) % سوائر بالعرض سير النجوم % لها مغرب ولها مشرق % 63(@)(@@) % دعاة بحمدك في الخافقين % لها بك ألوية تخفق % 64(@)(@@) % لك السكب من سحبها والعهاد % وعند العدا الحصب المصعق % 65(@)(@@) % يكيس بها والد منجب % إذا ولد الشاعر المحمق % 66(@)(@@) % بقيت وقد فنى القائلون % عليها وما حزني لو بقوا % % 67(@)(@@) % تذكركم في حفظ العهود % وإن لم يضع عندكم موثق % 68(@)(@@) % تحاشيكم أن أرى ظامئا % أحوم وواديكم متأق % 69(@)(@@) % ويوحشها أن ربعي على % % تجدد دولتكم مخلق % 70(@)(@@) % وأنى بمضيعة مثلكم % على الفضل من مثلها يشفق % PageV01P1364 71(@)(@@) % ترى الناس لم يسلفوا مثل ما % % لها وهي تهبط قد حلقوا % % 72(@)(@@) % وفي الحق والحكم العدل أنت % إذا لحقوا أنها تلحق % 73(@)(@@) % أمنت عليك صروف الزمان % وأخطأك القدر الموبق % 74(@)(@@) % ودارت لك السبعة الجاريات % % بما تستحب وتستوفق % 75(@)(@@) % وعد ألوفا لك المهرجان % % يجد السنين كما يخلق % 76(@)(@@) % يزورك مسترفدا سائلا % فيغمره سيبك المغدق % 77(@)(@@) % ويذهله وجهك المستنير % عليه ومجلسك المونق % PageV01P1365 البحر : - 1(@)(@@) % سل أبرق الحنان واحبس به % أين ليالينا على الأبرق % 2(@)(@@) % وكيف بانات بسقط اللوى % % ما لم يجدها الدمع لم تورق % 3(@)(@@) % هل حملت لا حملت بعدنا % % عنك الصبا عرفا لمستنشق % 4 
ms444	(@)(@@) % جدد ما جدد من لوعتي % % أخذ البلى من ربعك المخلق % 5(@)(@@) % لتبخل الأنواء أو فلتجد % عليك بالمنهمر المغدق % 6(@)(@@) % أغناك صوب الدمع عن منة % أحملها للمرعد المبرق % 7(@)(@@) % دمع على الخيف جنى ما جنى % % بكاء حسان على جلق % 8(@)(@@) % لله رهن لك يوم القنا % % لولا وفاء الحب لم يغلق % 9(@)(@@) % يا سائق الأظعان رفقا وإن % لم يغن قولي للعسوف ارفق % 10(@)(@@) % أؤاخذ الحادي ونفسي جنت % لو شئت لم أبك ولم أشتق % PageV01P1366 11(@)(@@) % لولا زفيري خلف أجمالهم % ووخز أنفاسي لم تنسق % 12(@)(@@) % يا غدر من لم أك من غدره % بخائف القلب ولا مشفق % 13(@)(@@) % ما لغريمي قادرا واجدا % يمطل مطل الفاجر المملق % 14(@)(@@) % وما على اللائم في حبه % ما ضاع من حلمي أو ما بقي % % 15(@)(@@) % أنفقت لبي في الهوى طائعا % والخلف العاجل للمنفق % 16(@)(@@) % لا تبدؤا بالعذل صدري فما % % أستنجد الماء على محرقي % % 17(@)(@@) % سميت لي نجدا على بعدها % % يا وله المشئم بالمعرق % 18(@)(@@) % داو بها حبي فما مهجتي % % أول مخبول بنجد رقي % % 19(@)(@@) % ومنكر شمطاء مدت إلى ال % % خمسين يدلوها فلم تحلق % 20(@)(@@) % جنت شطاطي وجنت ما جنت % من صدأ عم على رونقي % % PageV01P1367 21(@)(@@) % لا بد ان يفتق على فجرها % % وإن تمادت ليلة المغسق % 22(@)(@@) % ما ضرها خائنة لو وفت % أو ضرني لو كنت لم أعشق % 23(@)(@@) % كان مشيبا ضل عن نهجه % فدله الحب على مفرقي % % 24(@)(@@) % وموقظ هب على غرة % يطرقني ساعة لا مطرق % 25(@)(@@) % والنجم حي نبضه راسب % في لجة الخضراء لم يغرق % 26(@)(@@) % قال انتبه للحظ كم خفقة % على مهاد الخامل المخفق % 27(@)(@@) % حتام تحويل على عسرة % حلق إلى النسر بنا حلق % 28(@)(@@) % قلت بغيري فتحرش لها % % فالنهضة الخرقاء للأخرق % 29(@)(@@) % أما ترى المال وجماته % في قلب تنهار بالمستقي % % 30(@)(@@) % يسوغ بالعين فمن رامه % بالفم قال المنع رد تشرق % PageV01P1368 31(@)(@@) % وما انتفاعي بحيا واسع % تخفره ذات جدا ضيق % 32(@)(@@) % لا مس للحرمان عندي إذا % % كنت من البخال لم أرزق % 33(@)(@@) % لا أجلب الرزق إذا لم يكن 
ms445	 % يدر من أكرم مسترزق % 34(@)(@@) % قناعة أعتق عزي بها % % عنقي وعند الحرص لم يعتق % 35(@)(@@) % حلفت بالخضع أعناقها % % تذرع بالواخد والمعنق % 36(@)(@@) % كالسطر بعد السطر مخطوطة % من صفحة البيض على مخرق % 37(@)(@@) % ينصها السير على لاحب % مثل صليف الجمل الأورق % 38(@)(@@) % تقدح صفاح الثرى كلم % % لاحكت الأعضاء بالأسؤق % 39(@)(@@) % تسمح للجلمد أخفاقها % % بكل ما يعرق أو يتنقي % % 40(@)(@@) % يطلبن محجوبا عتيق البنى % % لولا دفاع الله لم يعتق % PageV01P1369 41(@)(@@) % والأسود الملثوم أحواله % من كل أوب فرق تلتقي % % 42(@)(@@) % تهوي بشعث بدلوا سهمة % بكل ضاح لونه مونق % 43(@)(@@) % زفوا جماما وعدوها منى % متى تضع أوزارها تحلق % 44(@)(@@) % لولا ابن أيوب وآباؤه % لم يبضع الفضل ولم ينفق % 45(@)(@@) % ولا سرى ملك بني هاشم % فألحق المغرب بالمشرق % 46(@)(@@) % لقد اوى منهم إلى هضبة % تزل عنها قدم المرتقي % % 47(@)(@@) % هم عززوه ورموا دونه % بكل مطرور الشبا مطلق % 48(@)(@@) % يطيعه الموت إذا ماعصت % به يمين الخاطب المفلق % 49(@)(@@) % نصر بني الأشهل من قبلهم % على بني الأحمر والأزرق % 50(@)(@@) % وما وهى إلا غدا ممسكا % منهم بثني الأحصف الأوثق % PageV01P1370 51(@)(@@) % لا كرجال قلدوا حكمه % فخلطوا الممذوق بالريق % 52(@)(@@) % من كل ناس في غد بعثه % لم يرهب الله ولم يتق % 53(@)(@@) % باع هداه طائعا عن يد % يدا على التوفيق لم تصفق % 54(@)(@@) % يرتفق الأجر على دينه % لو كان حر الدين لم يرفق % 55(@)(@@) % حتى كفا الله فمدت يد % طولى يقي الله لها من تقي % % 56(@)(@@) % دلت وقامت في أبي طالب % شهادة المورق للمعرق % 57(@)(@@) % شفت به الدولة بعد الصدى % % جلجالة أم حيا مطبق % 58(@)(@@) % زلالة طيبة ريحها % % ما قيل للساقي بها رقق % 59(@)(@@) % جاءت بمجنى ماؤه مخصب % أدرك بعد المحصب المصعق % 60(@)(@@) % كانت على الفترة لم تحتسب % مفتاح باب الفرج المغلق % PageV01P1371 61(@)(@@) % إن الإمامين به استرعيا % % فتى لغير الخير لم يخلق % 62(@)(@@) % مر القلى والسخط حلو الرضا % % والوجه الأخلاق والمنطق % 63(@)(@@) % طال بكف رطبة عفة % مذ بسطت للجود لم تطبق % 64(@)(@@) % أغنتهما من قبل تجريبها % % كالسيف يعطي العتق بالرونق 
ms446	 % 65(@)(@@) % جلت دجى الظلم له نقبة % بمثلها الظلماء لم تفتق % 66(@)(@@) % فأدركاه غرضا قط لم % ينبض له الظن أو يرفق % 67(@)(@@) % نصحا كما شاء ورأيا متى % % يقل بغيب قولة يصدق % 68(@)(@@) % فكم حشا قرت على أمنها % % بعد افتراش الحذر المقلق % 69(@)(@@) % لم تك يا بازل في حملها % % مقطرا تظلع بالأوسق % 70(@)(@@) % ولا دخيل الظهر في صدرها % % مدلسا بالنسب الملصق % PageV01P1372 71(@)(@@) % لم نعقتعدها رغبة في اللها % % ولم تخف ضيما ولم تفرق % 72(@)(@@) % أبوك من قبل امتطى دستها % % سبقا وقال اقتفني والحق % 73(@)(@@) % لطيمة ريحانها لم يلق % بغيركم قط ولم يعبق % 74(@)(@@) % ميراثها فيكم فمن رامها % % يغصب ذليل الغصب أو يسرق % 75(@)(@@) % فارع بها حقك من روضة % بأعين الرواد لم ترمق % 76(@)(@@) % في سابغ من ظلها واسع % وسائغ من مائها ريق % 77(@)(@@) % تفوز بالمجذل منها ولل % % حساد حظ المكمد المحنق % 78(@)(@@) % واسحب ذيولا من كراماتها % % لم تبل بالسحب ولم تخلق % 79(@)(@@) % كساك منها المد فضفاضة % بغير أعطافك لم تلبق % 80(@)(@@) % بان بك الجود على معشر % كما تجلت شية الأبلق % PageV01P1373 81(@)(@@) % أنت الذي لو لم تكن مطمعي % % أفحمني اليأس فلم أنطق % 82(@)(@@) % أعلقتني منك بمفتولة % حصداء ما خاربها معلقي % % 83(@)(@@) % كل يد تحرشني بالأذى % % فأنت من محفارها منفقي % % 84(@)(@@) % في زمن يرشقني كيده % ليس له غيري من مرشق % 85(@)(@@) % يرى خوافي بما لا أرى % % إذا كنت عن قدامتي أتقى % % 86(@)(@@) % ذاك لأني بين أبنائه % لم آلف الهجر ولم أخرق % 87(@)(@@) % موحد لو نخلت كفه % عن مثلي الغبراء لم تلحق % 88(@)(@@) % وهو عدو الفضل مذ لم يزل % يكاثر الأحلم بالأنزق % 89(@)(@@) % فابق فما مثلك جودا ولا % % مثلي مليا بثناء بقي % % 90(@)(@@) % واسعد بعيدين جديد العلى % % ومخلق من مذهب مخلق % PageV01P1374 91(@)(@@) % فمسلم ينظره من عل % وكافر ذو ناظر مطرق % 92(@)(@@) % تصاحبا مع خلف حاليهما % % تصاحب الموسر والمخفق % 93(@)(@@) % يضم إقبالك شمليهما % % فيلحق المأسور بالمطلق % 94(@)(@@) % وانض ثياب الصوم عن عاتق % من كل وزر في غد معتق % 95(@)(@@) % وراع في الإمكان ما أغفلت % مني عين المحرج 
ms447	 المرهق % 96(@)(@@) % قد كان ريب بك لو لم أكن % آخذ بالأحزم والأوثق % 97(@)(@@) % وابن بها عذراء مولودة % في الحل لم تسب ولم تسرق % 98(@)(@@) % ناشزة لولاك ما أنكحت % وهي إذا طلقت لم تطلق % 99(@)(@@) % مسبوقة أخرها عصرها % % وهي إلى الإحسان لم تسبق % 100(@)(@@) % أنبطتها من ثغب ماؤه % شريعة قبلي لم تطرق % PageV01P1375 البحر : - 1(@)(@@) % أروض الوادي أم ابيض الغسق % أم طيف ظمياء على النأى طرق % 2(@)(@@) % جاء على غربته لم يحتفل % ما نكد الأرض وما تيه الطرق % 3(@)(@@) % تحمله راحلة كاذبة % من الكرى تشكر شكر من صدق % 4(@)(@@) % فقمت أمشي نائما ينفضني % % إكبار ما خاض إلي وما خرق % 5(@)(@@) % مرتشفا ترابه أعرفه % من غيره بما استفاد من عبق % 6(@)(@@) % والركب قد ألهاهم عن شأننا % % يوم الخليل سامني ما لم أطق % 7(@)(@@) % وناظر رقاده من غدره % لولا فراق الطيف ماذم الأرق % 8(@)(@@) % ناشد غصونا باللوى موائلا % طوع النسيم تلتوي وتفترق % 9(@)(@@) % أهن أحلى أم قدود تلتوي % % شكوى على جمر النوى وتعتنق % 10(@)(@@) % وعن قناة لحظها عاملها % % وحبب الرمح إن اسمر ودق % PageV01P1376 11(@)(@@) % لمياء يلفي الظبي من أوصافه % صفرا إذا رد الذي منها سرق % 12(@)(@@) % تم البدور وهلال وجهها % % ما بلغ التم بها ولا امحق % 13(@)(@@) % فارقت حولا أهل نجد والهوى % % ذاك الهوى وحرقي تلك الحرق % 14(@)(@@) % فقل لمن ظن البعاد سلوة % لا تنتحل طعم شيء لم تذق % 15(@)(@@) % آه لقلب شق عنه أضلعي % % من الحمى تخالج البرق الشفق % 16(@)(@@) % ثار به الشوق فهب فهفا % % تطلعا ثم نزا ثم مرق % 17(@)(@@) % أنشده وليس في أهل منى % والقوم حج من تعرف الشرق % 18(@)(@@) % لله عيش بالحمى تعلقت % حباله بيد قطاع العلق % 19(@)(@@) % صحبت منه رفقة سائرة % لو أمهل الحادي العنيف أو رفق % 20(@)(@@) % أيام لي من الشباب دوحة % ملتفة الأغصان خضراء الورق % PageV01P1377 21(@)(@@) % ولمتي تقطر من ماء الصبا % % شرط المفدي ما فلا وما فرق % 22(@)(@@) % إذا الظباء نفرت من قانص % تزاحمت على حبالي وربق % 23(@)(@@) % فاليوم لا أرجع إلا مخفقا % محصن المدية مثنى الورق 
ms448	 % 24(@)(@@) % قالوا المشيب لبسة جديدة % خذوا الجديد واستردوا لي الخلق % 25(@)(@@) % أسلفت دهري غبنا فارتجعت % أحداثه مني الذي كان استحق % 26(@)(@@) % كم قد ركبت ظهره ولجمي % % تبدله عن العليق بالعلق % 27(@)(@@) % أجريته ركضا إلى مآربي % % وخببا حتى أفوز بالسبق % 28(@)(@@) % فلم تزل خطاه بي قصيرة % وجلدي حتى رضيت بالعنق % 29(@)(@@) % قالت يئست فجلست حجرة % والرزق في أخرى يصوب ويدق % 30(@)(@@) % مزملا بعيشة ذبذابة % لم يكس الدهر بها ولا حمق % PageV01P1378 31(@)(@@) % تألف دارا بالعراق جدبها % % قد عدم اللحم معاد يعترق % 32(@)(@@) % أضربت أسداد جو غيرها % % على المطي أم على الأرض طبق % 33(@)(@@) % يحب كسرالبيت إما عاطل % من العلا أو طائش القلب فرق % 34(@)(@@) % مجثمتان أين أنت منهما % % هما الثرى وأنت بيضاء الأفق % 35(@)(@@) % عني فما أعدلها قضية % لو أن من يحرم بالفضل رزق % 36(@)(@@) % أما رأيت الفضل واجتماعه % في وطن والحظ قلما اتفق % 37(@)(@@) % العربي راقع شملته % والقروي بالنضار ينتطق % 38(@)(@@) % من لي بسوق المائقين يشتري % % حلمي فيها برفاغة النزق % 39(@)(@@) % وقد حرصت مطلقا أعنتي % % لو أن معقول القضاء ينطلق % 40(@)(@@) % والشعر قد أقعدته فكاسد % أو نافق وليت شعري ما نفق % PageV01P1379 41(@)(@@) % عبدته حرا لقوم عنفوا % % بملكه فما نجا حتى أبق % 42(@)(@@) % فصرت إن أردته لمثلها % % أبى علي خيفة منها وشق % 43(@)(@@) % وقد عصاني في الملوك زمنا % فهل ترى يسمح في مدح السوق % 44(@)(@@) % لو كان كالأمير كل سامع % لم يحتبس عن شأوه ولم يعق % 45(@)(@@) % ولو بسعد الدولة اشتغاله % مذ سار ما سار بمدح نختلق % 46(@)(@@) % حارن ما حارن وارتاض له % لقدأرم ولأمر ما نطق % 47(@)(@@) % أصاب كفئا ورأى ضريبة % ففالت الغمد إليها واندلق % 48(@)(@@) % ومر مشتاقا مع الأوصاف لا % % تملك منه صهوة ولا عنق % 49(@)(@@) % طابت له الأنباء فاستروحها % % شما وللجود رياح تنتشق % 50(@)(@@) % يا راكبا تنقله سابحة % ورهاء لا من جنة ولا خرق % PageV01P1380 51(@)(@@) % سوداء من لباسها وجلدها % % وجسمها أبيض عريان يقق % 52(@)(@@) % أرضعها البحر ورباها وما % % تخشى على ذاك ردى من الغرق % 53(@)(@@) % إذا المطايا ألمت من 
ms449	 الصدى % % خمسا وعشرا ألمت من الشرق % 54(@)(@@) % تحدى برجز ليس من أشجانها % % ونغم لم يصبها ولم يشق % 55(@)(@@) % تركب من هوج الرياح غررا % % وما لها إلا بهن مرتفق % 56(@)(@@) % بلغ بميسان إذا بلغتها % % عاقلة الثاوي وزاد المنطلق % 57(@)(@@) % وقمرا يطلع في سمائها % % ونوره في الخافقين يأتلق % 58(@)(@@) % وقل كما شاء الندى لخالد % قولة لا تخلب ولا ملق % 59(@)(@@) % يا خير من حلت على أبوابه % رحائل البدن وحاجات الرفق % 60(@)(@@) % ومن أتته كالحبال عجفا % ورجعت كالوسق من تحت الوسق % PageV01P1381 61(@)(@@) % لولا السماح وغرام بالندى % % لما قرعت تطلب المال الحلق % 62(@)(@@) % ولاشهدت اليوم تغلي قدره % لو لم يصب ماء الطلى به احترق % 63(@)(@@) % عمت على أشعارها صبائغ % تولدت بين النجيع والعرق % 64(@)(@@) % يحملن كل خائض بحر الندى % % حتى يرى الموج عليه ينطبق % 65(@)(@@) % كأنه بالموت يقضي لذة % أو بفراق نفسه يشقي حنق % 66(@)(@@) % كتيبة خرساء إلا قونس % يطن أو خر غلام فصعق % 67(@)(@@) % لمء تر من قبلك خرقا قادها % % أسد شرى تهفو عليهن الخرق % 68(@)(@@) % إذا طغى على لصليق زأرها % % فأضلع البصرة منها تصطفق % 69(@)(@@) % لواؤك المرفوع من أمامها % % لم ينخفض ولا هوى منذ بسق % 70(@)(@@) % كأنه أبصر أكباد العدا % % تنزو فأعداه الخفوق فخفق % PageV01P1382 71(@)(@@) % قد جربوا كيدك أمس والذي % % عند غد أشقى عليهم وأشق % 72(@)(@@) % يا فارس القرطاس والسيف لقد % جمعت من ذي طرفين مفترق % 73(@)(@@) % حتى لقالوا طاعن بقلم % أو كاتب بالرمح في الطرس مشق % 74(@)(@@) % عرفت من نفسك مالم يعرفوا % % فطرت حتى صرت حيث تستحق % 75(@)(@@) % كم عجبوا منك وأنت ترتقي % % وانتظروا فيك الزليل والزلق % 76(@)(@@) % وخاوصوك حسدا بأعين % لم تحفل الشهلة منها والزرق % 77(@)(@@) % حتى تركت النجم في خضرائه % يخطر زوا أن سبقت ولحق % 78(@)(@@) % فالمال إن لم تلتحف بريشه % ولم تنطه بيد ولم تلق % 79(@)(@@) % أنفقته في الجود فهو بدد % في الأرض حتى ما له منك نفق % 80(@)(@@) % والحوض يفنيه اعتوار شفة % فشفة وإن علا وإن عمق % PageV01P1383 81(@)(@@) % وفر الفتى ما شاء من حديثه % والمجد من غير 
ms450	 النضار والورق % 82(@)(@@) % هل لك في ود على شط النوى % % صفا على غش المودات ورق % 83(@)(@@) % وصاحب كما اشترطت صاحبا % أخلص ما كان إذا قلت مذق % 84(@)(@@) % بكيلك البر بصاع أصوعا % % وإن عققت غير غدر لم يعق % 85(@)(@@) % مطهر الشيمة غنم قربه % محبب الإكثار محفوظ النثطق % 86(@)(@@) % لا يشرب الراح لأن تسكره % لكن لأن يجذبها حسن الخلق % 87(@)(@@) % سيف إذا أنت عرفت قدره % فرى بأعناق عداك وفلق % 88(@)(@@) % أتاه عنك من أحاديث الندى % % والمجد ما صبا إليه وأرق % 89(@)(@@) % فساقها عذراء ما خطبتها % % وكم غلا خطب بها فلم تسق % 90(@)(@@) % ثمينة البضع حصينا سرها % % على الرجال حرة لا تسترق % PageV01P1384 91(@)(@@) % إن آنست خيرا أقامت أو رأت % ضيما أجاز حكمها أن تنطلق % 92(@)(@@) % العقد والتطليق للبعل وفي % % قبضتها أقر بعل أم طلق % 93(@)(@@) % إنسية تحسب نفث سحرها % % كلام جني حكى ما يسترق % 94(@)(@@) % حاضرة تحسبها بادية % تديرت دارات خبت فالبرق % 95(@)(@@) % أخرها الميلاد وهي رتبة % في الشعر بالتقديم أولى وأحق % 96(@)(@@) % إذا قرنت بالفحول شأوها % % حكمت أن السابق الذي سبق % 97(@)(@@) % فاجتلها من فم راو قد فرى % % بالسعي فيها لك دهرا وخلق % 98(@)(@@) % أشفق أن يعطل وهي مفخر % عرضك منها والمحب ذو شفق % 99(@)(@@) % فاشكر له ما حملت يمينه % منها وما فتق فيها ورتق % 100(@)(@@) % واعرف لمهديها لك افتتاحه % في المدح بابا عن سواك منغلق % PageV01P1385 101(@)(@@) % وجازه وابق على وداده % مسلما ما طرد الليل الفلق % 102(@)(@@) % ولا تعلل باستماع غيرها % % فإنما تلك بنيات الطرق % PageV01P1386 البحر : - 1(@)(@@) % إذا لم أحظ منك على التلاقي % % فما بالي أروع بالفراق % 2(@)(@@) % بعادك حيث لا يرجوك راج % كقربك حيث لا يلقاك لاقي % % 3(@)(@@) % فمن يشك النوى أو يبك منها % % فلا دمعي هناك ولا احتراقي % % 4(@)(@@) % نوك من الملال أخف مسا % على كبدي وأبرد لاشتياقي % % 5(@)(@@) % ولولا البين لم أملك وصولا % إلى قبل الوداع ولا العناق % 6(@)(@@) % على أني وأنت النجم بعدا % % حديثك بين صدري والتراقي % % 7(@)(@@) % أقول لصاحبي غداة جمع % وأيدي النفر تلعب بالرفاق % 8(@)(@@) % قياني 
ms451	 من سهام بنات سعد % وهل مما قضاه الله واقي % % 9(@)(@@) % ومن ظبي مددت له حبالي % % لأقنصه فعدن على خناقي % % 10(@)(@@) % خذا طرفي بما أبقي وطرفي % % بعمد جر قتلي لا اتفاق % PageV01P1387 11(@)(@@) % أراق دمي الحرام فضول عيني % % فثأرى بين أجفاني وماقي % % 12(@)(@@) % أيا ربع الهوى دع لي طريقي % % فلا حبسي إليك ولا اعتياقي % % 13(@)(@@) % لك الخلق الحسان إذا تصدت % ولكن ما لأهلك من خلاق % 14(@)(@@) % وقل لشقيقة القمرين بيني % % فهذا عنك بيني وانطلاقي % % 15(@)(@@) % وإلا تفعلي أنطق بهجر % يسوء الود يا ذات النطاق % 16(@)(@@) % علقتك صائعا في الحب عزمي % % فكان المجد أولى باعتلاقي % % 17(@)(@@) % أنا الجاري إذا الحلبات طالت % مراكضها على الخيل العتاق % 18(@)(@@) % نفضت طريقها شوطا فشوطا % وسلم بها قضب السباق % 19(@)(@@) % فمن ذا يبتغي في الفضل سبقي % % وقد يئس السوابق من لحاقي % % 20(@)(@@) % بقيت لحر هذا القول وحدي % % فعبدي منه مأمون الإباق % PageV01P1388 21(@)(@@) % وحسبك ما بدا لك من نفاذي % % على ملك الملوك ومن نفاقي % % 22(@)(@@) % بركن الدين سالمني زماني % % وأطلقت الحوادث من وثاقي % % 23(@)(@@) % فمهما أبق يسمع سائرات % مطبقة من الكلم البواقي % % 24(@)(@@) % تكون له مطارب في غدايا ال % % صبوح وفي عشايا الإغتباق % 25(@)(@@) % وفي الأعداء تقطع ماضيات % مصممة مع البيض الرقاق % 26(@)(@@) % حمى الدنيا فثبت جانبيها % % صليب لا يروع بالصفاق % 27(@)(@@) % أبو شبلين من تعلق يداه % فليس له من الحدثان واقي % % 28(@)(@@) % وساق الناس خفضا وارتفاعا % بصير بالإناخة والمساق % 29(@)(@@) % وقاوم بالسياسة كل داء % طبيب من لداغ الدهر راقي % % 30(@)(@@) % إذا غمض السقام على المداوي % % تطلع من غوامضه العماق % PageV01P1389 31(@)(@@) % ألا أبلغ ملوك الأرض أنا % % على الزوراء في العيش الوفاق % 32(@)(@@) % لنا ملك يرب على نظام % شتائت أمرنا وعلى اتساق % 33(@)(@@) % إذا جمد الغمام جرت يداه % فعمتنا بمنهمر دفاق % 34(@)(@@) % أطاعته المقادر واستجابت % له في كل رقع وانفتاق % 35(@)(@@) % تناهوا عن عداوتنا تناهوا % % وفي الأرواح باقية الرماق % 36(@)(@@) % فقد جربتم بالأمس منا % % عرائك لا تلين على اعتياق % 37(@)(@@) % وكم ملل جليل ند عنا % % فطاح على ذوابلنا الدقاق % 38 
ms452	(@)(@@) % عسفناه وآخر قد ملكنا % % مقادته بلطف وارتفاق % 39(@)(@@) % وجاءتنا السعود بكل عاص % على عجل تعارض واستباق % 40(@)(@@) % وأبصر رشده ابن أخ شقيق % فطاوع أمرنا بعد الشقاق % PageV01P1390 41(@)(@@) % رأى طعم العقوق لنا مريرا % فبر ودله صدق المذاق % 42(@)(@@) % أراه الحق أمر الله فينا % % فنبه جفنه بعد انطباق % 43(@)(@@) % تذكرها على الأهواز شعثا % نزائع بين خرق أو مراقي % % 44(@)(@@) % وأنذره بدلان وسوم % على الأعناق ثابتة بواقي % % 45(@)(@@) % وناشد بالقرابة فانعطفنا % % له عطف الغصون على الوراق % 46(@)(@@) % فها هو لو دعوناه لخطب % أطاق لأمرنا غير المطاق % 47(@)(@@) % فنصرا يا مليك الأرض نصرا % على رغم المحايد والملاقي % % 48(@)(@@) % تهن بدولة أنكحت منها % % فتاة لا تروع بالطلاق % 49(@)(@@) % وما اقترحت سوى أن ترضيها % % وأن تحنو عليها من صداق % 50(@)(@@) % وعاد المهرجان بخفض عيش % يرف على ظلائله الصفاق % PageV01P1391 51(@)(@@) % هو اليوم ابتناه أبوك كسرى % % وشيد من قواعده الوثاق % 52(@)(@@) % وشق له من اسم الشمس وصفا % يصول به صحيح الإشتقاق % 53(@)(@@) % ويقسم لو رأك جلست فيه % لجاءك قائما لك فوق ساق % 54(@)(@@) % واعجبه تنزله بعيدا % وأنت على سرير الملك راقي % % 55(@)(@@) % وأسلاه عن الإيوان بقيا % مقام العز في هذا الرواق % 56(@)(@@) % فبادر حظ يومك واقتبله % على النشوات بالكأس الدهاق % 57(@)(@@) % من السوداء لم تك بنت كرم % دفين بل من الهيف البساق % 58(@)(@@) % مولدة الخوابي لم تلدها ال % % دنان ولم تمخض في الزقاق % 59(@)(@@) % وإن هي لم تكن حمراء صرفا % ولا صفراء بالماء المراق % 60(@)(@@) % ولا لون الخدود لها إذا ما % % أفيضت في أوانيها الرقاق % PageV01P1392 61(@)(@@) % فألوان القلوب إذا أديرت % تناسبها وألوان الحداق % 62(@)(@@) % وأحسن صبغتين سواد كأس % تعلق في بياض يمين ساقي % % 63(@)(@@) % وحرمها الحجازيون ظلما % لها فأحلها أهل العراق % 64(@)(@@) % وما متجبب فيه اختلاف % كمحظور يحرم بالوفاق % 65(@)(@@) % عففت فعفت عين الخمر دينا % % إذا ما عف قوم للنفاق % 66(@)(@@) % فباكرها على أقمار تم % تقابل فوق أغصان رشاق % 67(@)(@@) % ونل بيمينك الدنيا جميعا % وأطبقها على السبع الطباق % 68(@)(@@) % تدرج في السنين تعد ألفا % وترجع بعد في أولى 
ms453	 المراقي % % 69(@)(@@) % إلى أن تصبح الخضراء ماء % ويفنى النيران وأنت باقي % % PageV01P1393 البحر : - 1(@)(@@) % إلى كم حبسها تشكو المضيقا % % أثرها ربما وجدت طريقا % % 2(@)(@@) % تنشط سوقها واسرح طلالها % % عساها أن ترى للخصب سوقا % % 3(@)(@@) % وإن لم تمضي هرولة وجمزا % فأمهلها الروائد والعنيقا % % 4(@)(@@) % أجلها تطلب القصوى ودعها % % سدى يرمي الغروب بها الشروقا % % 5(@)(@@) % فإن من المحالولم تهدم % غواربهاتنجزك الحقوقا % % 6(@)(@@) % أتعقلها وتقنع بالهوينا % % تكون إذا بذلتها خليقا % % 7(@)(@@) % ولم يشفق على حسب غلام % يكون على ركائبه شفيقا % % 8(@)(@@) % أخض أخفاقها الغمرات حتى % % ترى في الآل سابحها غريقا % % 9(@)(@@) % سمائن أوتعرقها الفيافي % % فتتركها عظاما أو عروقا % % 10(@)(@@) % تلاقط جوهر الحصباء منها % % مناسم من دم يصف العقيقا % % PageV01P1394 11(@)(@@) % يصيب به رميته معان ال % % يدين موفق نصلا وفوقا % % 12(@)(@@) % يفض على جنوب البيد منها % % سهام النزع مفلتة مروقا % % 13(@)(@@) % صبور للهواجر والسوافي % % يرى بجدوبه العيش الرقيقا % % 14(@)(@@) % إذا عدم المياه على الركايا % % كفاه أن يعد له البروقا % % 15(@)(@@) % تورطها فإما نلت خيرا % فسعى وافق القدر المسوقا % % 16(@)(@@) % وإما أن تخيب فلست فيها % % بأول طالب حرم اللحوقا % % 17(@)(@@) % أرى الأيام تأخذ ثم تعطي % % وتخرق ثم تنتصح الخروقا % % 18(@)(@@) % وتوقد نارها دقا لقوم % وفي قوم تضرمها حريقا % % 19(@)(@@) % وكل حلوبها عندي سواء % مشوبا أو صريفا أو مذيقا % % 20(@)(@@) % مظالم لو رفعن إلى كريم % لكان بسد عورتها حقيقا % % PageV01P1395 21(@)(@@) % ولو نادت كمال الملك ألفت % على الأدواء حاسمها الرفيقا % % 22(@)(@@) % وحطت فادح الأثقال منه % بذي جنبين يحملها مطيقا % % 23(@)(@@) % غيور لا ينام على اهتضام ال % % كرام ولا الغرار ولا الخفوقا % % 24(@)(@@) % تنقله من العزمات شم % يدوس جبالها نيقا فنيقا % % 25(@)(@@) % إذا ركب الطريق إلى المعالي % % فلا زاد يعد ولا رفيقا % % 26(@)(@@) % وحيد ترهف الاحداث منه % على أعناقها نصلا عتيقا % % 27(@)(@@) % لبيب الرأي يكبر عن مشير % إذا ما الرأي شارف أن يموقا % % 28(@)(@@) % إذا خفيت شواكل كل أمر % جليل الخطب أبصرها دقيقا % % 29(@)(@@) % فلو روي ليفرق بين ماء % وماء مثله وجد الفروقا % % 30(@)(@@) % نمت أم الوزارة من أخيه % ومنه 
ms454	 البدر والغصن الرشيقا % % PageV01P1396 31(@)(@@) % هما الولدان من صلة وبر % إذا ولدت من الناس العقوقا % % 32(@)(@@) % من النفر الذين إذا استغيثوا % % رأيت بهم وساع الأرض ضيقا % % 33(@)(@@) % كتائب ما رعت عيناك خرسا % مسومة وألوية خفوقا % % 34(@)(@@) % تخال بديه أمرهم رويا % إذا اجتمعوا وواحدهم فريقا % % 35(@)(@@) % رطاب النطق بسامو المجالي % % إذا ما أيبس الفرق الحلوقا % % 36(@)(@@) % لهم شرف سرى من ظهر كسرى % % مطا فمطا فما ضل الطريقا % % 37(@)(@@) % طوى أصلابهم أو جاء عبد ال % % رحيم فجاء متسقا مسوقا % % 38(@)(@@) % ترى الأب بالشهادة في بنيه % قريبا وهو قد أمسى سحيقا % % 39(@)(@@) % وما تسمو النفوس ولا تزكي % % إذا لم تنظم الحسب العريقا % % 40(@)(@@) % وبانت آية بأبي المعالي % % فكان مصليا فضل السبوقا % % PageV01P1397 41(@)(@@) % ربا معه الكمال فشق منه % له لقب فصار له شقيقا % % 42(@)(@@) % خلائق تارة يشربن صابا % % وأحيانا مشعشعة رحيقا % % 43(@)(@@) % يثير السخط منها والتغاضي % % صواعقها ووابلها الدفوقا % % 44(@)(@@) % ففي حال تكون بها شريبا % وفي حال تكون بها شريقا % % 45(@)(@@) % ويسكرك الذي يصحيك منها % % فما تنفك سكرانا مفيقا % % 46(@)(@@) % فداؤك كل جهم الوجه أني % % لقي مر الخلائق كيف ذيقا % % 47(@)(@@) % تراه ناشطا يأتي ويمضي % % وقيد العجز يجعله ربيقا % % 48(@)(@@) % إذا عزلوه لم يحذر عدوا % وإن ولوه لم يحرز صديقا % % 49(@)(@@) % يراك بمؤخر العينين غيظا % وقد أفديته جفنا وموقا % % 50(@)(@@) % فلا مدت لنعمتك الليالي % % يدا طولي ولا ظفرا علوقا % % PageV01P1398 51(@)(@@) % وإن سنحت ميامن كل يوم % صباحا بالسعادة أو طروقا % % 52(@)(@@) % فغنتك المطارب ثم أبكت % ديار عداك نوحا أو نعيقا % % 53(@)(@@) % وجادك كسب جودك من ثنائي % % مواقر ترجع الذاوي وريقا % % 54(@)(@@) % إذا هي وبلت بسطت عريضا % وإن هي أسبلت حفرت عميقا % % 55(@)(@@) % فتلحم في ربوعك أو تسدي % % خمائل تأسر الطرف الطليقا % % 56(@)(@@) % تزورك شاكيات كل يوم % حشى حران أو قلبا مشوقا % % 57(@)(@@) % على مسعاتها قامت مقاما % مقرا من قبولك أو زليقا % % 58(@)(@@) % وكم عثرت بذنب كان سهوا % فكنت بأن تغمده حقيقا % % 59(@)(@@) % وحر بالخطيئة صار عبدا % غفرت غلاطه فغدا طليقا % % PageV01P1399 البحر : - 1(@)(@@) % أما لنجوم ليلك بالمصلى 
ms455	 % % مغارب بل أما للشمس شرق % 2(@)(@@) % تساعدني على سهر الليالي % % فهل إسعادهن عليه عشق % 3(@)(@@) % وأين طريق نومي والدراري % % حوائر فيه ليس لهن طرق % 4(@)(@@) % أرقت فهل لهاجعة بسلع % على الأرقين أفئدة ترق % 5(@)(@@) % وما أشكو السهاد لأن جفني % % تنافي عنده فتح وطبق % 6(@)(@@) % ولا أن الرقاد يعير روحا % جوى كبدي فيبرد منه حرق % 7(@)(@@) % ولكن أن أرى خنساء حلما % كأن زخارف الأحلام حق % 8(@)(@@) % نشدتك بالقرابة بابن ودي % % فإنك لي من ابن أبي أحق % 9(@)(@@) % أسل بالجزع عينك إن عيني % % إذ استبررتها وقتا تعق % 10(@)(@@) % وإن شق البكاء على المعافي % % فلم أسألك إلا ما يشق % PageV01P1400 11(@)(@@) % ورافدني بكفك فوق قلبي % % ببرقة عاقل إن عن برق % 12(@)(@@) % تألق ثم حلق حاجريا % له أفق وللأظعان أفق % 13(@)(@@) % له من عبرتي حلب وصبغ % ومن أحشاي شعشعة وخفق % 14(@)(@@) % كما عط المشبرق شطر برد % يطرح واستوى شق وشق % 15(@)(@@) % يطارحني الغرام وساعدته % هواتف تركب الأوراق ورق % 16(@)(@@) % ورى أكبادها بالقاع زغب % جواثم ما استتم لهن خلق % 17(@)(@@) % رماها في شواكلها مصيب % من الأقدار فاختتلت مدق % 18(@)(@@) % زقت من كفة القناص تمكو % % إليها وهي أفرخة تزق % 19(@)(@@) % وما بين الفراق المر فيما % % تحاذره وبين الموت فرق % 20(@)(@@) % وليس عليك من علقي بمغنى % صمات حديثه بالموت نطق % PageV01P1401 21(@)(@@) % كأن معالم الأحباب فيه % سطور ملهوج والدار رق % 22(@)(@@) % وخرق ميت الأشخاص عاف % وسيع ليس يرقع منه خرق % 23(@)(@@) % كأن عزائف الجنان فيه % ملاء السحب من ريح تشق % 24(@)(@@) % سلكت ولا أنيس سوى اعتزامي % % ولا صوت سوى الأصداء يزقو % % 25(@)(@@) % على ضرم القوائم أعوجي % تكاذيب الشخوص عليه صدق % 26(@)(@@) % يفيض على الوهاد عن الروابي % % بما تمليه سالفة وعنق % 27(@)(@@) % أقب تخاله سنبكه اتساعا % يكب على المداوس منه حق % 28(@)(@@) % تظن العين فارسه رديفا % يطامن شخصه عنق أمق % 29(@)(@@) % تنقله قوادم مضرحي % خطائطهن فوق الترب مشق % 30(@)(@@) % سبقت به إلى أخرى المعالي % % بدار الفوت والعلياء سبق % PageV01P1402 31(@)(@@) % فأوردت الزلالة من ملوك % صفوا لفمي ومزج الناس مذق % 32(@)(@@) % رزقت 
ms456	 جزيل ما لهم بفضلي % % إذا لم يجتمع فضل ورزق % 33(@)(@@) % إذا لبى زعيم الملك صوتي % % فكل مواعد الآمال صدق % 34(@)(@@) % أغر كأن جبهته بلوجا % لعينك في جبين الشمس فتق % 35(@)(@@) % يغير حسن أخلاق الليالي % % عليه وخلقه في الجود خلق % 36(@)(@@) % ولا يرضي بعذر وهو حق % مبين في الندى وعليه حق % 37(@)(@@) % كريم العيص زاد وماد غصن % له من حيث طال وطاب عرق % 38(@)(@@) % عتيق الطينتين سما عفيفا % بمتنيه وبيت المجد عتق % 39(@)(@@) % ويصطلمون ما محكوا ولجوا % % وهم خلقاء أن يعفوا ويبقوا % % 40(@)(@@) % إذا نطقوا فأحلام وهدى % وإن وهبوا فإفراط وخرق % PageV01P1403 41(@)(@@) % وإن نطقوا بفاصلة أرمت % شقاشق كل هدار يبق % 42(@)(@@) % فلم يعرب ببينة لسان % ولم يرطب على اللهوات حلق % 43(@)(@@) % فإن تك يا علي نقلت منهم % مناقبهم فأنت بها أحق % 44(@)(@@) % سمحت لها ووجه الدهر جهم % وهم سمحوا ووجه الدهر طلق % 45(@)(@@) % إذا خان البنون أبا كريما % وفى لهم غلام منك خرق % 46(@)(@@) % فلا يدخل عليك فساد دهر % يخاف على تمامك فيه محق % 47(@)(@@) % وشلت كف خطب كان منها % % لرتق علائكم وهن وفتق % 48(@)(@@) % غلاط من جهالات الليالي % % وهن سواكن أبدا ونزق % 49(@)(@@) % وحمق في الزمان أصاب منكم % وفي أخلاقه كيس وحمق % 50(@)(@@) % شماس من مقادكم ولين % وصفو تارة لكم ورنق % PageV01P1404 51(@)(@@) % وعسف في القضاء ويقتضيه % فتمحوه مياسرة ورفق % 52(@)(@@) % وإيمان بمعجزكم وشكر % وكفر تارة بكم وفسق % 53(@)(@@) % فلا تغمز قناتكم ببوع % ولا يسبر لكم غور وعمق % 54(@)(@@) % ولا تقرع بمجزعة صفاكم % وإن خدشت سهام فهي مرق % 55(@)(@@) % ولا شرب المرية من رماكم % وإن هو ظن أن الماء طرق % 56(@)(@@) % يناطح صخرة منكم مليسا % معارج طرقها زلاء زلق % 57(@)(@@) % وإن سمحت لناتجها بفلق % فمنها للسقوط عليه فلق % 58(@)(@@) % هو البادي فإن كايلتموه % بصاع الغدر فالبادي أعق % 59(@)(@@) % وأنصع حين خاف الغمر شرا % فلا ينفق له ما عاش علق % 60(@)(@@) % سحابة صيف ستعود صحوا % ولم يعلق لها بالريب ودق % PageV01P1405 61(@)(@@) % وما سلمت لكم نفس وعرض % فأهون هالك عين وورق % 62(@)(@@) % سينزعها 
ms457	 ويرجعها إليكم % وبعد اللبس نزعتها أشق % 63(@)(@@) % وإن أحق من رد العواري % % فتى أخذ الذي لا يستحق % 64(@)(@@) % فلا يتوهم المنجاة منها % % وأن طريدكم بالخوف طلق % 65(@)(@@) % وأن البعد يحصنه وتثني ال % % مكايد عنه حيطان وغلق % 66(@)(@@) % وهل تخفى المكايد وهي بيض % على مقل الذوابل وهي زرق % 67(@)(@@) % فلا بسطت ولا قبضت يمين % لها نبض بنائلكم ورشق % 68(@)(@@) % وكشف هذا الغماء جد % عوائده بما تهوون سبق % 69(@)(@@) % وجمعكم وصاح بمن نعاكم % غراب نوى له في الدار نعق % 70(@)(@@) % وعادت دولة والحرب سلم % لكم من ربها والخلف رفق % PageV01P1406 71(@)(@@) % إلى أن تورث الدنيا وفيكم % ولايتها وما للناس حق % 72(@)(@@) % تعودكم القوافي لابسات % حفاظا لا يرث ولا يرق % 73(@)(@@) % ينقحها لكم قلب سليم % فيأتيكم بها حب وحذق % PageV01P1407 البحر : - 1(@)(@@) % نبهت سعدا والأفق % أدهم شارف البلق % 2(@)(@@) % وصادح الفجر على ال % % مفحص بعد ما نطق % 3(@)(@@) % فارتاع ثم قام فاه % % تز لها ثم انطلق % 4(@)(@@) % لهفان لا على الكرى % % حيران لا من الفرق % 5(@)(@@) % مداريا أجفانه % بين السهاد والأرق % 6(@)(@@) % وقالأمرك ما % % ذاك عرا وما طرق % 7(@)(@@) % اصدع به امض له % أطقته أو لم أطق % 8(@)(@@) % قلت الجلوس في كسو % % ر البيت أفن وخرق % 9(@)(@@) % والعز ما أفاده % هجر الجدار والفرق % 10(@)(@@) % راخ لها فادن بها % % ناشطة من الربق % PageV01P1408 11(@)(@@) % يبزلها استنانها % % بين المثاني والحقق % 12(@)(@@) % لها من اعتيادها % % أدلة على الطرق % 13(@)(@@) % تغني إذا الليل دجا % % عن النجوم بالحدق % 14(@)(@@) % قم نشتر العز بها % % بيع النضار بالورق % 15(@)(@@) % وافكك من العار بها % % عنقك وخدا وعنق % 16(@)(@@) % والمرء في دار الأذى % % عبد فإن سار عتق % 17(@)(@@) % جب طبق الأرض بنا % % فما على الأرض طبق % 18(@)(@@) % قد مزج الناس فكم % تشرب شوبا ورنق % 19(@)(@@) % خان الثقات فبمن % ندفع ضيما أو نثق % 20(@)(@@) % وا لهفتي إلى صدي % % ق قال خيرا فصدق % PageV01P1409 21(@)(@@) % وصاحب مستصرخ % يسمع الشكوى فيرق % 22(@)(@@) % طار الوفاء فترى % % بأي جو قد لحق % 23(@)(@@) % لولا ابن أيوب لما % % خلت أخا صدق صدق % 24 
ms458	(@)(@@) % ولا رأيت خلقا % يعجب من هذي الخلق % 25(@)(@@) % لم تترك الأيام غي % % ر مجده ولم تبق % 26(@)(@@) % على عميد الرؤسا % % ء وقف الظن المحق % 27(@)(@@) % والناس ما عدوته % خوالب البرق الشفق % 28(@)(@@) % يفديه كل وغر ال % % صدر على الفضل حنق % 29(@)(@@) % دعاؤه لوفره % جمعته فلا افترق % 30(@)(@@) % لم ترتدع بعرضه % سيادة ولم تلق % PageV01P1410 31(@)(@@) % قد غلط الدهر له % حمقا وفي الدهر حمق % 32(@)(@@) % فما له من سودد ال % % أوحد إلا ما سرق % 33(@)(@@) % سقى الحياة كفا إذا % % جفا الحيا فهي تدق % 34(@)(@@) % وحيت النعمة من % أعطى منها ما استحق % 35(@)(@@) % مصطحبا من نشوا % % ت المكرمات مغتبق % % 36(@)(@@) % مذ سكرت أخلاقه % من السماح لم يفق % 37(@)(@@) % راهن في شوط الندى % % جرى الرياح فسبق % 38(@)(@@) % وحالم الطود فخ % % ف الطود عنه ونزق % 39(@)(@@) % أبلج نور وجهه % يخطف عيني من رمق % 40(@)(@@) % وسائد الدست بما % % شعشع منه تأتلق % PageV01P1411 41(@)(@@) % يطمع فيه بشره % إذا استدر فاندفق % 42(@)(@@) % وتوئس الهيبة من % حصاته أن تسترق % 43(@)(@@) % فعفوه ليل ند % وبطشه يوم صعق % 44(@)(@@) % ناصح للخليفتين % حدث الرأى شفق % 45(@)(@@) % ورد في نصابه % ما كان شذ ومرق % 46(@)(@@) % مستدركا بنصحه % % ثغرة كل ما انفتق % 47(@)(@@) % سار من العدل على % % محجة لم تخترق % 48(@)(@@) % متسقا سعى الإما % % م نسقا بعد نسق % 49(@)(@@) % على اقتفاء أمره % في كل ما جل ودق % 50(@)(@@) % فالباس والإسلام في % % جماعة لا تفترق % PageV01P1412 51(@)(@@) % نظمت دار الملك ح % % تى التأمت وهي حذق % 52(@)(@@) % ينسخ إيمانك في % % ها شرع كل من فسق % 53(@)(@@) % وهي التي يختبر ال % % مبطل فيها والمحق % 54(@)(@@) % وتلتقي الطاعات في % % أبوابها وتتفق % 55(@)(@@) % ويستوي الملوك في % % ها خاضعين والسوق % 56(@)(@@) % رعيتها بمرهف % أجفانه لا تنطبق % 57(@)(@@) % يمضي مضاء السيف قد % جربته إذا مشق % 58(@)(@@) % تخال صبغ النقس في % % سنانه صبغ العلق % 59(@)(@@) % يصدر عن تنفيذه % باللطف ما عز وشق % 60(@)(@@) % فالرمح منه مااستقام % % واللواء ما خفق % PageV01P1413 61(@)(@@) % فلا عدمت آسيا % % كد العلاج فرفق % 62(@)(@@) % يبرم ما يفتل بال % % حزم ويفري ما 
ms459	 خلق % 63(@)(@@) % أنت الذي خلصت لي % % والناس غدر وملق % 64(@)(@@) % أسغتني الود وهم % بين الغصاص والشرق % 65(@)(@@) % عهد حديث بالوفا % % ء عهده وإن عتق % 66(@)(@@) % تجده لبسته % وكل ملبوس خلق % 67(@)(@@) % كم حادث عني أمط % % ت بعد ما كان علق % 68(@)(@@) % ومثقل حملته % لولا قواك لم يطق % 69(@)(@@) % فما لإعراض طرا % % ينسخ إقبالا سبق % 70(@)(@@) % وما لسانعن بذي % اتي بعد ما عشق % PageV01P1414 71(@)(@@) % يتركهن بارد ال % % قلب يعالجن الحرق % 72(@)(@@) % يندبن آثارا وعهدا % % كان حرا فأبق % 73(@)(@@) % وعيشة عندكم % بيضاء خضراء الورق % 74(@)(@@) % مع النسيات غراب ال % % هجر فيها قد نعق % 75(@)(@@) % تشكو الظما بحيث % كن أبدا تشكو الغرق % 76(@)(@@) % ما طرقت في حاجة % بابا لكم إلا غلق % 77(@)(@@) % هذا على اقتناعها % % منكم بما بل الرمق % 78(@)(@@) % وأنها لا تستبل ال % % ماء حتى تختنق % 79(@)(@@) % وهي على جفائكم % تحنو عليكم فترق % 80(@)(@@) % فما تغب وافدات % رفقا على رفق % PageV01P1415 81(@)(@@) % لا يلتوي عنكم لها % % لا ناظر ولا عنق % 82(@)(@@) % تبضعكم جوهرها % % أكسد فيكم أو نفق % 83(@)(@@) % تهدي إلى أعراضكم % نشرا إذا سار عبق % 84(@)(@@) % في كل يوم حسنه % وحسنها لا يفترق % 85(@)(@@) % تجلي لكم في حليها % % موشحا ومنتطق % 86(@)(@@) % تضمن ألفا مثله % يأتي بها على نسق % PageV01P1416 البحر : - 1(@)(@@) % ركب الدجى فسعى بغير رفيق % عجلا فاصبح قاطعا لطريق % 2(@)(@@) % أبكي لغاربه ويضحك مظهرا % بري بما يأتي وفيه عقوقي % % 3(@)(@@) % مستصحبا فرقا خلاف صحابتي % % ضعفا ويفتك بالقوي فريقي % % 4(@)(@@) % متجاربان فأبت مغلوبا يسابقني % % وهذا الخصل بالمسبوق % 5(@)(@@) % يرمي جنابا كنت عنه أذوده % بالمرهفات مقيمة للسوق % PageV01P1417 البحر : - 1(@)(@@) % أيا بانة الغور عطفا سقيت % وإن كنت أكني وأعني سواك % 2(@)(@@) % أحبك من أجل من تشبهين % لو أني أراه كما قد أراك % 3(@)(@@) % ذكرت ويا لهفتي هل نسيت % ليالي أسمرها في ذراك % 4(@)(@@) % يخضر عودك من دمعتي % % ويعطر من برد هند ثراك % 5(@)(@@) % ويا هند إن عقل الكاشحون % وعندهم من ذنوبي نداك % 6(@)(@@) % كفى الوجد أني إذا ما استرحت % إلى اسمك عميته بالأراك % 7(@)(@@) % ظمئت إلى 
ms460	 أعذب الشربتين % فكلتاهما قد حوتها يداك % 8(@)(@@) % فكيف تعنينني في الشهاد % محلئة وتحلين فاك % 9(@)(@@) % هناك ومن عجب في هوا % % ك قولي في قتل نفسي هناك % 10(@)(@@) % غروب تسح إذا القطر شح % وقلب إذا خمد الجمر ذاكي % % PageV01P1418 11(@)(@@) % أخاف انتقاصك عند العتاب % سقاطي فاشكر والقلب شاكي % % 12(@)(@@) % إذا الصد أرضاك فهو الوصال % فأنى فعلت فأهلا بذاك % PageV01P1419 البحر : - 1(@)(@@) % يا بنة القوم تراك % بالغ قتلي رضاك % 2(@)(@@) % أم دمي وهو عزيز % هان في دين هواك % 3(@)(@@) % إن يكن طاح فما أول % % ما طلت يداك % 4(@)(@@) % حب يوم السفح إلا % أنه يوم نواك % 5(@)(@@) % لعبت ساعاته بي % % ما كفاها وكفاك % 6(@)(@@) % كم غزال بالمصلى % % سام وصلى فحكاك % 7(@)(@@) % جاريا في حلبة الحس % % ن ولم يبلغ مداك % 8(@)(@@) % مر لا أرهف عيني % % ك ولا أرشف فاك % 9(@)(@@) % غير أني قلت حيي % % ت على ما أنت حاكي % % 10(@)(@@) % وقصيرات الخطى غي % % رك لدنات العراك % PageV01P1420 11(@)(@@) % عادلات علل الوج % % د بلذات التشاكي % % 12(@)(@@) % رعن في مكة نومي % % قبل تغريد المكاكي % % 13(@)(@@) % كل عطري شفتاها % % عترة فوق مداك % 14(@)(@@) % يغتدي مسواكها % % ريحانة غب السواك % 15(@)(@@) % فرأت عيني ولكن % ما رأى قلبي سواك % 16(@)(@@) % أجتدي النوم وهل في ال % % نوم إلا أن أراك % 17(@)(@@) % ما على من خطر الرا % % ح لو استثنى لماك % 18(@)(@@) % كنت صعبا لا أل % % وي بالخشاشات الركاك % 19(@)(@@) % فمضى حكم اكتهالي % % تابعا حكم صباك % 20(@)(@@) % يا سميري ليلة السف % % ح وقد نادوا براك % PageV01P1421 21(@)(@@) % والمطايا تخلط المع % % ج كلالا بالسواك % 22(@)(@@) % أتباكيت نفاقا % باللوى أم أنت باكي % % 23(@)(@@) % أم أراك الشوق أشبا % % ه سليمى في الأراك % 24(@)(@@) % سالت بي أم سلمى % % أين حزمي واحتناكي % % 25(@)(@@) % ورأت ضعضعة بي % % ن سكوني وحراكي % % 26(@)(@@) % طاويا كشح مهيض % ناشرا أنفاس شاكي % % 27(@)(@@) % لا تخالي خورا ذا % % ك فإني أنا ذاك % 28(@)(@@) % بل رزيئات تواصي % % ن شماتا بانتهاكي % % 29(@)(@@) % كل يوم حادث ين % % كأ قرفي بالحكاك % 30(@)(@@) % أنتحي أعزل فيه % وسلاح الدهر شاكي % % PageV01P1422 31(@)(@@) % كم عركت الصبر 