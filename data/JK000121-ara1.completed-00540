ms536	 أحمد أو أبو الحارث صدوق رمي بالقدر من السابعة 4(@)(@@)(@@)(@@) $ 7363 الهيثم بن حيان بالتحتانية أبو اليسع البعلبكي مقبول من الحادية عشرة س(@)(@@)(@@)(@@) $ 7364 الهيثم بن خارجة المروذي أبو أحمد أو أبو يحيى نزيل بغداد صدوق من كبار العاشرة مات سنة سبع وعشرين في آخر يوم منها خ س ق(@)(@@)(@@)(@@) $ 7365 الهيثم بن خالد ويقال بن جناد بجيم ونون الجهني أبو الحسن الكوفي ثقة من الحادية عشرة مات سنة تسع وثلاثين د(@)(@@)(@@)(@@) $ 7366 الهيثم بن خالد البجلي الكوفي الخشاب متروك من العاشرة مات سنة سبع وثلاثين وقيل بعد ذلك تمييز(@)(@@)(@@)(@@) $ 7367 الهيثم بن خالد بن يزيد أبو صالح الكوفي وراق أبي نعيم ثقة من الحادية عشرة مات سنة ثمان وسبعين تمييز(@)(@@)(@@)(@@) $ 7368 الهيثم بن خالد بن يزيد المصيصي نزيل بغداد مولى عثمان ضعيف من الحادية عشرة تمييز(@)(@@)(@@)(@@) $ 7369 الهيثم بن خالد القرشي أبو الحسن البغدادي بصري الأصل صدوق يغرب من الحادية عشرة أيضا تمييز(@)(@@)(@@)(@@) $ 7370 الهيثم بن خالد أبو الفرج مجهول من الحادية عشرة وأظن أنه المصيصي تمييز(@)(@@)(@@)(@@) $ 7371 الهيثم بن خالد الكندي مقبول من الثانية عشرة تمييز(@)(@@)(@@)(@@) $ 7372 الهيثم بن رافع الحنفي أو الباهلي أبو يحيى أو أبو الحكم أو أبو الحارث وقيل هم ثلاثة صدوق ربما أخطأ من السادسة ق(@)(@@)(@@)(@@) $ 7373 الهيثم بن الربيع العقيلي أبو المثنى البصري أو الواسطي ضعيف من السابعة ت(@)(@@)(@@)(@@) $ 7374 الهيثم بن أبي سنان المدني صدوق من الرابعة خ PageV01P577(@)(@@)(@@)(@@) $ 7375 الهيثم بن شفي بمعجمة وفاء وزن علي في الأصح الرعيني أبو الحصين الحجري بفتح المهملة وسكون الجيم المصري ثقة من الثانية د س ق(@)(@@)(@@)(@@) $ 7376 الهيثم بن مالك الطائي أبو محمد الشامي الأعمى ثقة من الخامسة بخ(@)(@@)(@@)(@@) $ 7377 الهيثم بن مروان بن الهيثم العنسي بمهملتين بينهما نون ساكنة أبو الحكم الدمشقي مقبول من الحادية عشرة س PageV01P578(@)(@@)(@@)(@@) | ( حرف الواو )(@)(@@)(@@)(@@) $ 7378 وابصة بكسر الموحدة ثم مهملة بن معبد بن عتبة الأسدي صحابي نزل الجزيرة وعمر إلى قرب سنة تسعين د ت ق(@)(@@)(@@)(@@) $ 7379 واثلة بن 
ms537	 الأسقع بالقاف بن كعب الليثي صحابي مشهور نزل الشام وعاش إلى سنة خمس وثمانين وله مائة وخمس سنين ع(@)(@@)(@@)(@@) $ 7380 واسع بن حبان بفتح المهملة ثم موحدة ثقيلة بن منقذ بن عمرو الأنصاري المازني المدني صحابي بن صحابي وقيل بل ثقة من الثانية ع(@)(@@)(@@)(@@) $ 7381 واصل بن أبي جميل الشامي أبو بكر السلاماني مشهور بكنيته مقبول من السادسة مد(@)(@@)(@@)(@@) $ 7382 واصل بن حيان الأحدب الأسدي الكوفى بياع السابري بمهملة وموحدة ثقة ثبت من السادسة مات سنة عشرين ومائة ع(@)(@@)(@@)(@@) $ 7383 واصل بن السائب الرقاشي أبو يحيى البصري ضعيف من السادسة مات سنة أربع وأربعين ومائة ت ق(@)(@@)(@@)(@@) $ 7384 واصل بن عبد الأعلى بن هلال الأسدي أبو القاسم أو أبو محمد الكوفي ثقة من العاشرة مات سنة أربع وأربعين ومائتين م 4(@)(@@)(@@)(@@) $ 7385 واصل بن عبد الرحمن أبو حرة بضم المهملة وتشديد الراء البصري صدوق عابد وكان يدلس عن الحسن من كبار السابعة مات سنة اثنتين وعشرين م قد س(@)(@@)(@@)(@@) $ 7386 واصل مولى أبي عيينة بتحتانية مصغر صدوق عابد من السادسة خ م د س ق(@)(@@)(@@)(@@) $$$ واقد بن عبد الله هو واقد بن محمد بن زيد بن عبد الله نسب لجد أبيه د(@)(@@)(@@)(@@) $ 7387 واقد بن عبد الرحمن بن سعد مجهول من الخامسة د(@)(@@)(@@)(@@) $ 7388 واقد بن عمرو بن سعد بن معاذ الأنصاري الأشهلي أبو عبد الله المدني ثقة من الرابعة مات سنة عشرين م د ت س(@)(@@)(@@)(@@) $ 7389 واقد بن محمد بن زيد بن عبد الله بن عمر بن الخطاب العدوي المدني ثقة من السادسة خ م د س(@)(@@)(@@)(@@) $ 7390 واقد بن أبي واقد الليثي يقال له صحبة وقيل بل هو من الثالثة د(@)(@@)(@@)(@@) $ 7391 واقد أبو عبد الله مولى زيد بن خليدة كوفي صدوق من السادسة س(@)(@@)(@@)(@@) $$$ واقد في وقدان PageV01P579(@)(@@)(@@)(@@) $ 7392 واهب بن عبد الله المعافري ثم الكعبي أبو عبد الله المصري ثقة من الرابعة مات سنة سبع وثلاثين بخ مد(@)(@@)(@@)(@@) $ 7393 وائل بن حجر بضم المهملة وسكون الجيم 
ms538	 بن سعد بن مسروق الحضرمي صحابي جليل وكان من ملوك اليمن ثم سكن الكوفة ومات في ولاية معاوية ر م 4(@)(@@)(@@)(@@) $ 7394 وائل بن داود التيمي الكوفي والد بكر ثقة من السادسة بخ 4(@)(@@)(@@)(@@) $$$ وائل بن علقمة عن وائل بن حجر وعنه عبد الجبار بن وائل صوابه عن عبد الجبار عن علقمة بن وائل عن أبيه د(@)(@@)(@@)(@@) $ 7395 وائل بن مهانة التيمي الكوفي مقبول من الثانية س(@)(@@)(@@)(@@) $ 7396 وبر بفتح أوله وسكون الموحدة بعدها راء بن أبي دليلة بالتصغير واسمه مسلم الطائفي ثقة من السابعة د س ق(@)(@@)(@@)(@@) $ 7397 وبرة بالموحدة المحركة بن عبد الرحمن المسلي بضم أوله وسكون المهملة بعدها لام أبو خزيمة أو أبو العباس الكوفي ثقة من الرابعة مات سنة ست عشرة خ م د س(@)(@@)(@@)(@@) $ 7398 وبرة الحارثي والد كرز الكوفي مستور من السادسة مد س(@)(@@)(@@)(@@) $ 7399 وحشي بفتح أوله وسكون المهملة ثم معجمة بن حرب بن وحشي بن حرب الحبشي الحمصي مستور من الثامنة د ق(@)(@@)(@@)(@@) $ 7400 وحشي بن حرب الحبشي جد الذي قبله يكنى أبا دسمة بفتح المهملتين والميم صحابي نزل حمص ومات بها خ د ق(@)(@@)(@@)(@@) $ 7401 وراد بتشديد الراء الثقفى أبو سعيد أو أبو الورد الكوفي كاتب المغيرة ومولاه ثقة من الثالثة ع(@)(@@)(@@)(@@) $ 7402 ورد بن عبد الله التميمي أبو محمد الطبري نزيل بغداد ثقة من العاشرة عس(@)(@@)(@@)(@@) $ 7403 ورقاء بن عمر اليشكري أبو بشر الكوفي نزيل المدائن صدوق في حديثه عن منصور لين من السابعة ع(@)(@@)(@@)(@@) $ 7404 وزير بكسر الزاي بن صبيح بوزنه الشامي مقبول عابد من الثامنة ق(@)(@@)(@@)(@@) $ 7405 وزير بن صبيح الوزان بصري مجهول من السابعة تمييز(@)(@@)(@@)(@@) $ 7406 وساج بتشديد المهملة ثم جيم بن عقبة بن وساج الأزدي مستور من الثامنة ق(@)(@@)(@@)(@@) $ 7407 وضاح بتشديد المعجمة ثم مهملة اليشكري بالمعجمة الواسطي البزاز أبو عوانة مشهور بكنيته ثقة ثبت من السابعة مات سنة خمس أو ست وسبعين ع PageV01P580(@)(@@)(@@)(@@) $ 7408 الوضين بفتح أوله وكسر المعجمة بعدها تحتانية ساكنة ثم نون بن 
ms539	 عطاء بن كنانة أبو عبد الله أو أبو كنانة الخزاعي الدمشقي صدوق سيء الحفظ ورمي بالقدر من السادسة مات سنة ست وخمسين وهو بن سبعين د عس ق(@)(@@)(@@)(@@) $ 7409 وعلة بن عبد الرحمن بن وثاب اليمامي مقبول من السادسة بخ د(@)(@@)(@@)(@@) $ 7410 وفاء بفاء ومد بن شريح الحضرمي المصري مقبول من الرابعة د(@)(@@)(@@)(@@) $ 7411 وقاء بكسر أوله وقاف بن إياس الأسدي أبو يزيد الكوفي لين الحديث من السادسة قد س(@)(@@)(@@)(@@) $ 7412 وقاص بتشديد القاف بن ربيعة العنسي بنون ومهملة أبو رشدين الشامي مقبول من الرابعة وروايته عن أبي الدرداء مرسلة بخ د(@)(@@)(@@)(@@) $ 7413 وقدان بسكون القاف أبو يعفور بفتح التحتانية وسكون المهملة وضم الفاء العبدي الكوفي مشهور بكنيته وهو الكبير ويقال اسمه واقد ثقة من الرابعة مات سنة عشرين تقريبا ع(@)(@@)(@@)(@@) $ 7414 وكيع بن الجراح بن مليح الرؤاسي بضم الراء وهمزة ثم مهملة أبو سفيان الكوفي ثقة حافظ عابد من كبار التاسعة مات في آخر سنة ست وأول سنة سبع وتسعين وله سبعون سنة ع(@)(@@)(@@)(@@) $ 7415 وكيع بن عدس بمهملات وضم أوله وثانيه وقد يفتح ثانيه ويقال بالحاء بدل العين أبو مصعب العقيلي بالفتح الطائفي مقبول من الرابعة 4(@)(@@)(@@)(@@) $ 7416 وكيع بن محرز بن وكيع الناجي بالنون والجيم البصري صدوق له أوهام من الثامنة ق(@)(@@)(@@)(@@) $ 7417 الوليد بن بكير بالتصغير التميمي أبو جناب بفتح الجيم ثم نون الكوفي لين الحديث من الثامنة ق(@)(@@)(@@)(@@) $ 7418 الوليد بن ثعلب الطائي أو العبدي البصري ثقة من السادسة د س ق(@)(@@)(@@)(@@) $$$ الوليد بن أبي ثور هو بن عبد الله يأتي(@)(@@)(@@)(@@) $$$ الوليد بن جميع كذلك(@)(@@)(@@)(@@) $ 7419 الوليد بن جميل الفلسطيني أبو الحجاج صدوق يخطىء من السادسة بخ ت ق(@)(@@)(@@)(@@) $ 7420 الوليد بن حرب الأشعري الكوفي لقبه ولاد مقبول من السادسة م(@)(@@)(@@)(@@) $ 7421 الوليد بن دينار السعدي أبو الفضل البصري التياس بمثناة وتحتانية مثقلة ثم مهملة مقبول من السابعة بخ(@)(@@)(@@)(@@) $ 7422 الوليد بن رباح المدني صدوق من الثالثة مات سنة سبع عشرة خت د ت ق 
ms540	(@)(@@)(@@)(@@) $$$ الوليد بن رباح في رباح بن الوليد PageV01P581(@)(@@)(@@)(@@) $ 7423 الوليد بن زوران بزاي ثم واو ثم راء وقيل بتأخير الواو السلمي الرقي لين الحديث من الخامسة د(@)(@@)(@@)(@@) $$$ الوليد بن زياد هو بن أبي هشام يأتي(@)(@@)(@@)(@@) $$$ الوليد بن زياد يأتي في بن بزيد(@)(@@)(@@)(@@) $ 7424 الوليد بن سريع بفتح المهملة الكوفي صدوق من الرابعة م س(@)(@@)(@@)(@@) $ 7425 الوليد بن سفيان بن أبي مريم الغساني شامي مجهول من السادسة د ت ق(@)(@@)(@@)(@@) $ 7426 الوليد بن سفيان مجهول من الثالثة عس(@)(@@)(@@)(@@) $$$ الوليد بن سلمة أبو بشر صوابه بن مسلم يأتي(@)(@@)(@@)(@@) $ 7427 الوليد بن سليمان بن أبي السائب القرشي ثقة من السادسة صد س ق(@)(@@)(@@)(@@) $ 7428 الوليد بن شجاع بن الوليد بن قيس السكوني أبو همام بن أبي بدر الكوفي نزيل بغداد ثقة من العاشرة مات سنة ثلاث وأربعين على الصحيح م د ت ق(@)(@@)(@@)(@@) $ 7429 الوليد بن صالح النخاس بنون ومعجمة ثم مهملة الضبي أبو محمد الجزري نزيل بغداد ثقة من صغار التاسعة خ م(@)(@@)(@@)(@@) $ 7430 الوليد بن عبادة بن الصامت الأنصاري المدني أبو عبادة ولد في عهد النبي صلى الله عليه وسلم وهو ثقة من كبار الثانية مات بعد السبعين خ م ت س ق(@)(@@)(@@)(@@) $ 7431 الوليد بن عبد الله بن أبي ثور الهمداني الكوفي وقد ينسب لجده ضعيف من الثامنة مات سنة اثنتين وسبعين بخ د ت ق(@)(@@)(@@)(@@) $ 7432 الوليد بن عبد الله بن جميع الزهري المكي نزيل الكوفة صدوق يهم ورمي بالتشيع من الخامسة بخ م د ت س(@)(@@)(@@)(@@) $ 7433 الوليد بن عبد الله بن أبي مغيث العبدري مولاهم المكي ثقة من السادسة د ق(@)(@@)(@@)(@@) $ 7434 الوليد بن عبد الرحمن بن حبيب الجارودي البصري أبو العباس ثقة من كبار العاشرة مات سنة اثنتين وثمانين خ(@)(@@)(@@)(@@) $ 7435 الوليد بن عبد الرحمن بن أبي مالك الهمداني أبو العباس الدمشقي نزيل الكوفة وقد ينسب لجده ثقة من الخامسة مات سنة خمس وعشرين ومائة ت س(@)(@@)(@@)(@@) $ 7436 الوليد بن عبد الرحمن الجرشي بضم الجيم وبالشين المعجمة 