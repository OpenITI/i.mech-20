ms41	 لما جرى % % من النصر والإعزاز لا زلت مسعدا % % 22(@)(@@) % ولا زلت للإسلام كهفا ومعقلا % % وسيفا على هام العدو مجردا % % 23(@)(@@) % ودونك نظما من أديب بصوغه % % إذا قال شعرا أصبح الدهر منشدا % % 24(@)(@@) % إذا شاعر أهدى لكم خرزاته % % بعثنا إليكم لؤلؤا وزبرجدا % % 25(@)(@@) % فأحسن إلينا بالقبول وبالرضي % % ودم سالما حيا معافى مؤيدا % % 26(@)(@@) % وأزكى صلاة الله ثم سلامه % % على المصطفى ما ناح سدم وغردا % % 27(@)(@@) % كذا الآل والصحب أنصار دينه % % وأتباعهم ما أطرب العيس من حدا % % 28(@)(@@) % أيا أم عبد مالك والتشرد % % ومسراك بالليل البهيم لتبعد % % 29(@)(@@) % ومأواك أوصاد الكهوف توحشا % % ومثواك أفياء التصوب وغرقد % % 30(@)(@@) % وما جاوزت ساقاك من سفح رهوة % % وأشعافها ما بين عال ووهد % % PageV01P122 31(@)(@@) % ومسراك من ذات العميق وكوثر % % ونهران مزور القذال الملبد % % 32(@)(@@) % وما السر إن أبدلت قصرا مشرفا % % وعرشا وفرشا بالقرى والتلدد % % 33(@)(@@) % فما مثل هذا منك إلا لضيقة % % من العيش أو من سوء أخلاق معند % % 34(@)(@@) % فقالت رويدا يا أبا عبد إنما % % أضاق بنا ذرعا شديد التوعد % % 35(@)(@@) % عرمرم جيش سيق من مصر معنفا % % يهتك أستار النساء ويعتدي % % 36(@)(@@) % ويسبي ذراري الأكرمين جبارة % % وينظم سادات الرجال بمقلد % % 37(@)(@@) % فقلت لها من دونكن ودونهم % % ضروب حماة بالحديد المهند % % 38(@)(@@) % وضرب يزيل الهام عما ربت به % % ويظهر مكنونات أجواف أكبد % % 39(@)(@@) % وطعنا ترى نفذ الأسنة لمعا % % من القوم يعوي جرحها لم يسدد % % 40(@)(@@) % قفي وانظري يا أم عبد معاركا % % يشيب لها الولدان من كل أمرد % % PageV01P123 41(@)(@@) % وإن كنت عنها في البعاد فسائلي % % ففيها أسود من مغيد بمرصد % % 42(@)(@@) % وفيها ليوث الأزد من كل شيعة % % يصالون نار الحرب حزنا لمفسد % % 43(@)(@@) % وفيها رئيس عايض حول وجهه % % حياض المنايا صدرت كل مورد % % 44(@)(@@) % خليفة عصر للحنيفي مثقف % % لما أعوج منه في حجاز وأنجد % % 45(@)(@@) % فيا لك من يوم الحفير وما بدا % % لريدة من طول الغمام المشيد % % 46(@)(@@) % ويا لك من يوم اللحوم سباعه % % شباع وطير الجو تحظى لمشهد % % 47(@)(@@) % ويالك من أيام نصر تتابعت % % بها من شواظ الحرب 
ms42	 ذات التوقد % % 48(@)(@@) % تطامت رقاب الروم فيها عيوقها % % كما غاق دود للجراد المقدد % % 49(@)(@@) % فأضحى جثاثا في البقاع مركما % % تزعزعه ريح العشية والغد % % 50(@)(@@) % ويالك من يوم المرار لواؤه % % تقنع بالصرعى به كل مقعد % % PageV01P124 51(@)(@@) % كأن تقحام الشريد وعوره % % فرود نحاها فجأة أعسر اليد % % 52(@)(@@) % تخرمها نحر الهجير وأنها % % لتعهد منه فرى ناب ومفصد % % 53(@)(@@) % ويا عجبا من في حبضى وما دنا % % لوداي كسان من قتيل مسند % % 54(@)(@@) % وفي ربوة الشعبين داهية أتت % % عليهم فما أغنى دفاع بمسجد % % 55(@)(@@) % ويوم المقضى قد تقضت أمورهم % % بفاقرة الظهر التي لم تضمد % % 56(@)(@@) % ومن قبل ذا يوم العزيزة عزهم % % ذليل بضرب المشرفي المجرد % % 57(@)(@@) % كتائب فيها ضرموا ثم غودروا % % بأشلائهم عانى الدماء المكند % % 58(@)(@@) % بأيدي رجال من شنوءة جدهم % % رقى بهم مجدا إلى حذو فرقد % % 59(@)(@@) % تداعى عليهم من صميم أصولها % % ثبات وجمع كالمحيط المزيد % % 60(@)(@@) % ففاخر بهم يا خاطبا فوق منبر % % على الناس فاقوا بالحسام وسودد % % PageV01P125 61(@)(@@) % ليهن بني قحطان مجد فخاره % % مدى الدهر في نادى بواد وأبلد % % 62(@)(@@) % فيا راكبا أما لقيت ببيشة % % وما دفعته من ضراب وفدفد % % 63(@)(@@) % فسلم على قبر ابن شكبان سالم % % فقد كان قدما قادما كل سيد % % 64(@)(@@) % يحامي على التوحيد حتى عرى له % % من الخلف كأس جرعه ذو تردد % % 65(@)(@@) % ومر على أجزاع ظلفع قف بها % % قليلا وما يغنيك عن ضرب مبعد % % 66(@)(@@) % على ظهر قباء الكلي لا يريبها % % حفا حزن منجاة قفر منكد % % 67(@)(@@) % تثر الحصا بالخف كالحذف قبلها % % وقد ضاق هما صدرها للتبعد % % 68(@)(@@) % كل ثر من عين برملان وحشه % % يجفله قناصة بالترصد % % 69(@)(@@) % توسمت الوسمى أما بكوره % % فمن نقا الدهناء سعدانها الندى % % 70(@)(@@) % وأما ثوانيه فإن زال ظعنها % % فمن حظن حتى الرشاء الممهد % % PageV01P126 71(@)(@@) % تعللها منه غواد فأشظأت % % بقول ورمث زهرها ذو تطرد % % 72(@)(@@) % فأضحت تسامى في سنام كأنها % % بخد تليع الهضب عالي التصعد % % 73(@)(@@) % فقل لمعد لا تغر بسرحها % % فتلقى كماة الحي جنبا بموعد % % 74(@)(@@) % بسمر العوالي والمواضي دونها % % ومبيض موضون الحديد 
ms43	 المسرد % % 75(@)(@@) % وأما إجازتك الدخول فحوملا % % فصبحا فعرضا فالسراديح فاعتد % % 76(@)(@@) % وسقها على نجد يؤمك ليلها % % بنات لنعش والضحى فيه تهتدي % % 77(@)(@@) % وإن خلات يوما لشحط مزارها % % فأبدل بها عينا ذات التعرد % % 78(@)(@@) % ودعها عن التهجير حتى إذا رأت % % ورودا بماء من صفار فأورد % % 79(@)(@@) % وأشرف على وادي اليمامة قائلا % % ودمعك سفاحا على الخد والثدي % % 80(@)(@@) % سلام على عبد العزيز وشيخه % % وتابع رشد للإمام المجد % % PageV01P127 81(@)(@@) % دعا الناس دهرا للهدى فأجابه % % فئام فمنهم عالمون ومقتدى % % 82(@)(@@) % وقفاهما حذوا سعود بسيفه % % مميز مجود النقود من الردى % % 83(@)(@@) % وعرج بها ذات اليمين وقد هوت % % على عرصات للرياض بمقصد % % 84(@)(@@) % وناد بأعلا الصوت بشرى لفيصل % % ومن نسل سادات الملوك مسدد % % 85(@)(@@) % إليك نظاما نشره في وقائع % % على جحفل المصري قد شد باليد % % 86(@)(@@) % فعشرون ألفا من قضى الله منهم % % فما بين مقتول وعار مجرد % % 87(@)(@@) % ولم ينج منهم غير قواد قومهم % % على صافنات في قليل معرد % % 88(@)(@@) % كأن أنين المومقين ومن به % % جوارح رمى قاصفات لاعمد % % 89(@)(@@) % أنين معيز زارها داؤها الذي % % بأكبادها أضنى عليها ليعتدي % % 90(@)(@@) % أو الساكني الأمصار قد حل فيهم % % عقاص فأصماهم على كل مرقد % % PageV01P128 91(@)(@@) % أتاهم بها إذ غاب نجم مشعشع % % من الجو في مغرابه نحس أسعد % % 92(@)(@@) % فكل الذي لاقوه يحسب دون ما % % تعكس من حزم الهمام المعمد % % 93(@)(@@) % فقل لدليل القوم هلا أفاده % % من العلم أن البغى قتال معتد % % 94(@)(@@) % ومهما أعادته الأماني لحربنا % % نصبنا لهم أمثالها بالمجدد % % 95(@)(@@) % ويا قافلا أما ثنيت زمامها % % وأقبلت ما استدبرته للتعود % % 96(@)(@@) % ولاح سهيل ضاحكا لك ثغره % % وقد لمحته عينها مفلق الغد % % 97(@)(@@) % فسلم على الأحباب تسليم موجد % % ولا تنس جيران البجير بالحد % % 98(@)(@@) % وآخر قولي وابتدائي فيهم % % صلاة وتسليما على خير مرشد % % 99(@)(@@) % وآل وصحب كل ما قال منشد % % أيا أم عبد مالك والتشرد % % PageV01P129 البحر : طويل 1(@)(@@) % بشير سعاد جاء نحوك فاسعد % % وقد وعدت وصلا فأوفت بموعد % % 2(@)(@@) % لقد عرفت وقت المزار فأقبلت % % إليك وقد نامت عيون لحسد % % 3 
ms44	(@)(@@) % فجاءت تجر الذيل خشية قائف % % لمعرفة الآثار بالحدس يهتدي % % 4(@)(@@) % يؤرج ترب الأرض عرف عبيرها % % وتهدي لسمع الصب وسواس عسجد % % 5(@)(@@) % أتتك سحيرا والنجوم كأنها % % دراري ترى في قبة من زبرجد % % 6(@)(@@) % فلما حوتها عرصة الدار سلمت % % سلام حبيب زائر ذي تودد % % 7(@)(@@) % فقر بنيل الوصل عينا وطالما % % تبيت لذكراها بليلة أرمد % % 8(@)(@@) % فتاة يريك الصبح غرة وجهها % % ويبدو الدجى من شعرها المتجعد % % 9(@)(@@) % ويعجب غصن البان إن هبت الصبا % % له سحرا من قدها المتميد % % 10(@)(@@) % يريك ابتساما لامع البرق ثغرها % % ويسفر عن شهد ودر منضد % % PageV01P130 11(@)(@@) % وقد جمعت كل المحاسن جملة % % فلم يستطع تفصيلها من معدد % % 12(@)(@@) % وفاقت جمالا كل هيفاء كاعب % % إذا ما مشت ما بين غيد وخرد % % 13(@)(@@) % فعاص جميع العاذلين ولا تطع % % بها كل واش لائم أو مفند % % 14(@)(@@) % فلو برزت يوما لغيلان لم يهم % % بمى ولم يبد القريض لمنشد % % 15(@)(@@) % ولو لمحت بالطرف طرفة ما بكى % % لخولة أطلالا ببرقة ثمهد % % 16(@)(@@) % لقد أصبحت في الغانيات فريدة % % كما انفرد الوالي بحزم وسؤدد % % 17(@)(@@) % حليف المعالي فيصل ناصر الهدى % % مذيق العدى كأس الردى بالمهند % % 18(@)(@@) % ترى الوفد والأضياف من حول قصره % % عكوفا كورد حوما حول مورد % % 19(@)(@@) % فيصدر كل مدركا ما يرومه % % من الفضل والجدوى ومن كل مقصد % % 20(@)(@@) % يقضي ببذل المكرمات نهاره % % سماحا ويحيي ليله بالتهجد % % PageV01P131 21(@)(@@) % لقد ساد أبناء الزمان وفاقهم % % بعفو وإقدام وكف له ندى % % 22(@)(@@) % وميراث مجد ناله عن أئمة % % سموا للعلا حتى استووا فوق فرقد % % 23(@)(@@) % حنيفية في دينها حنفية % % فأنسابهم تعزى لا فخر محتد % % 24(@)(@@) % هموا نصروا التوحيد بالبيض والقنا % % فنال المنى بالنصر كل موحد % % 25(@)(@@) % وآووا إماما قام لله داعيا % % يسمى بشيخ المسلمين محمد % % 26(@)(@@) % لقد أوضح الإسلام عند اغترابه % % وقد جد في إخفائه كل ملحد % % 27(@)(@@) % وجدد منهاج الشريعة إذ عفت % % فأكرم به من عالم ومجدد % % 28(@)(@@) % وأحيا بدرس العلم دارس رسمها % % كما قد أمات الشرك بالقول واليد % % 29(@)(@@) % وكم شبهة للمشركين أزاحها % % بكل دليل كاشف للتردد % % 30(@)(@@) % وألف 
ms45	 في التوحيد أوجز نبذة % % بها قد هدى الرحمن للحق من هدى % % PageV01P132 31(@)(@@) % نصوصا من القرآن تشفي من العمى % % وكل حديث للأئمة مسند % % 32(@)(@@) % فوازره عبد العزيز ورهطه % % على قلة منهم وعيش منكد % % 33(@)(@@) % فما خاف في الرحمن لومة لائم % % ولم يثنه صولات باع ومعتد % % 34(@)(@@) % وقفى سعود أثره طول عمره % % إلى حين وورى في الصفيح الملحد % % 35(@)(@@) % وقد جاهدوا في الله أعداء دينه % % فما وهنوا للحرب أو للتهدد % % 36(@)(@@) % وكم غارة شعواء شنوا على العدا % % وكم طارف منهم حووه ومتلد % % 37(@)(@@) % وكم سنة أحيوا وكم بدعة نفوا % % وكم هدموا بنيان شرك مشيد % % 38(@)(@@) % وقائعهم لا يحصر النظم عدها % % وإن تسأل السماء عن ذاك ترشد % % 39(@)(@@) % وكم لهم من وقعة شاع صيتها % % بها أيد الرحمن سنة أحمد % % 40(@)(@@) % وكم فتحوا من قرية ومدينة % % ودانت لهم بدو وسكان أبلد % % PageV01P133 41(@)(@@) % وكم ملكوا ما بين ينبع بالقنا % % ومن بين جعلان إلى جنب مزبد % % 42(@)(@@) % ومن عدن حتى تنيخ بأيلة % % قلوصك من مبدي سهيل إلى الجدي % % 43(@)(@@) % وقد طهروا تلك الديار وطردوا % % ذوي الشرك والإفساد كل مطرد % % 44(@)(@@) % بأمر بمعروف ونهي عن الردى % % وبالصلوات الخمس للمتعبد % % 45(@)(@@) % وقد هدموا الأوثان في كل قرية % % كما عمرت أيديهمو كل مسجد % % 46(@)(@@) % فكن ذاكرا فوق المنابر فخرهم % % وناد به في كل ناد ومشهد % % 47(@)(@@) % تغمدهم رب العباد برحمة % % وأسكنهم روض النعيم المخلد % % 48(@)(@@) % ولا تنس ذا الحي اليماني أنه % % لشيعة أهل الحق بالحق مقتدي % % 49(@)(@@) % قبائل من همدان أو من شنوءة % % من الأزد اتباع الرئيس المسود % % 50(@)(@@) % هموا قد حموا للدين إذ فل غضبه % % وبدد منه الشمل كل مبدد % % PageV01P134 51(@)(@@) % فهم فئة للمسلمين ومعقل % % وكهف منيع للشريد المطرد % % 52(@)(@@) % سما للعلى حقا علي ولم يزل % % يروح بأسباب الجهاد ويغتدي % % 53(@)(@@) % وكم عسكر للمسرفين أباده % % بحد الظبي والسمهري المسدد % % 54(@)(@@) % وصيرهم صنفين ما بين هالك % % وبين أسير في الحديد مصفد % % 55(@)(@@) % ومازال يغزوهم ويرمي ديارهم % % بفرسان حرب في الدلاص المسرد % % 56(@)(@@) % وفتح المخا بالسيف للدين آية % % وزجر وانذار 
ms46	 لأهل التمرد % % 57(@)(@@) % فلما تولى عاضنا منه عائض % % امام همام كالحسام المجرد % % 58(@)(@@) % فما زال يحمي بالسيوف حمى الهدى % % ويردي العدا في كل جمع ومحشد % % 59(@)(@@) % ونهزم منهم عسكرا بعد عسكر % % ويضرب من هاماتهم كل قمحد % % 60(@)(@@) % فلما أتى الأحزاب منهم وألبوا % % شفي النفس من أعداء دين محمد % % PageV01P135 61(@)(@@) % فلا زال تأييد الإله يمده % % بنصر وإسعاف على كل مفسد % % 62(@)(@@) % ودونكها بكرا عروسا زففتها % % إليك تهادي في حرير وعسجد % % 63(@)(@@) % شمت الأخطار شوقا ولم تهب % % وطيس هجير أو وغى ذي توقد % % 64(@)(@@) % إليك من الإحساء زمت ركابها % % فكم جاوزت من فدفد بعد فدفد % % 65(@)(@@) % فأحسن قراها بالقبول وبالرضى % % ودع أم عبد عنك ذات التشرد % % 66(@)(@@) % وأحسن ما يحلو به الختم أننا % % نصلى دواما في الرواح وفي الغد % % 67(@)(@@) % على المصطفى والآل ما هبت الصبا % % وما أطرب الأسماع صوت المغرد % % PageV01P136 البحر : طويل 1(@)(@@) % ليال المنى جادت علينا بأسعد % % لدن جمعتنا بالإمام المسدد % % 2(@)(@@) % حليف المعالي فيصل من سمت به % % مناقبه فوق الثريا وفرقد % % 3(@)(@@) % تفرع عن روح المكارم وانتمى % % من الحسب السامي إلى خير محتد % % 4(@)(@@) % كريم السجايا ماجد من أماجد % % بنوا في المعالي كل فخر وسؤدد % % 5(@)(@@) % ولكنه أضحى بأعلا أرومة % % يقصر عن إدراكها كل سيد % % 6(@)(@@) % امام الهدى جالى الصدى منهل الندى % % ومردي العدا بالمشرفي المهند % % 7(@)(@@) % حمى أرض نجد بالصوارم والقنى % % وأمنها من كل باغ ومعتد % % 8(@)(@@) % هو البطل المقدام كالليث في الوغى % % وغيث اليتامى والفقير المضهد % % 9(@)(@@) % رفيق شفيق بالورى متواضع % % ببذل العطايا هاطل كفه ندى % % 10(@)(@@) % له نفس حر تشتري المجد والثنا % % بكل نفيس من لجين وعسجد % % PageV01P137 11(@)(@@) % فلولاه لم ترقص بنا العيس في الفلا % % من البيد تطوى فدفدا بعد فدفد % % 12(@)(@@) % ترجى نوالا لم تجد كف هوذة % % به قط للأعشى ولا كف أجود % % 13(@)(@@) % فلما أناخت عيسنا بفنائه % % قضت كل مأمول وسول ومقصد % % 14(@)(@@) % فما زالت الوفاد تأتي مشيحة % % إلى قصره العالي المنيف المشيد % % 15(@)(@@) % فيا سائرا بلغه مني تحية % % نجددها في كل يوم مجدد 
ms47	 % % 16(@)(@@) % فلا زلت محروس الجناب مؤيدا % % لك العز والإقبال في كلا مشهد % % 17(@)(@@) % ودم سالما في طيب عيش مساعد % % بنصر من المولى عزيز مؤيد % % 18(@)(@@) % وصلى إله العالمين مسلما % % على خير هاد للأنام ومهتدي % % PageV01P138 البحر : بسيط تام 1(@)(@@) % تبكي الحساء بدمع سافح جارى % % من أجل خطب جسيم حادث جاري % % 2(@)(@@) % خطب أساء قلوب المتلدين بها % % من قاطنيها وآذى مهجة الجاري % % 3(@)(@@) % لما أتاهم كتاب للإمام به % % نار الوعيد فأصلى القلب بالنار % % 4(@)(@@) % ومن يطيق من الضرغام زأرته % % وقد يصول بأنياب وأظفار % % 5(@)(@@) % لجت له ساكنو الإحساء قاطبة % % حتى بكى من نائي عنهم بأقطار % % 6(@)(@@) % على النخيل التي عاشت أراملهم % % بها وكل يتيم جائع عاري % % 7(@)(@@) % كانوا يرون إمام المسلمين لهم % % كالأب يرجونه للحادث العاري % % 8(@)(@@) % فاهت له بالثنا والخير ألسنهم % % وبالدعاء له في جنح أسحاري % % 9(@)(@@) % وقال أحسنهم ظنا وأعقلهم % % ما للإمام وهذا الحادث الطاري % % 10(@)(@@) % لقد عهدناه ذا حلم ومرحمة % % ورأفة بالرعايا غير جبار % % PageV01P139 11(@)(@@) % لانعدم الخير من وال أخى ثقة % % للشرع متبع بالحق أمار % % 12(@)(@@) % خليفة قائم لله متقيا % % يخشى الإله ويرجو عفو عفار % % 13(@)(@@) % أنباء سيرته الحسنى قد انتشرت % % شرقا وغربا وفي أعمال بلغار % % 14(@)(@@) % يصلي العدو بنيران الحروب كما % % يشب نار القرى للطارق الساري % % 15(@)(@@) % أعطى الحسا وهي نزر من عطيته % % يوم السبية حقا دون إنكار % % 16(@)(@@) % لما استباح من الأعراب بيضتهم % % بعسكر من بني الإسلام جرار % % 17(@)(@@) % أباد خضراءهم بالسمر إذ شجرت % % وكل أبيض ماضي الحد بتار % % 18(@)(@@) % وعف عن حرمات الحي عن كرم % % فلم يرعها ولم يكشف لأستار % % 19(@)(@@) % ثم أنثنى نحو هجر بالجيوش إلى % % أبي غنيمة فاستولى على الدار % % 20(@)(@@) % وقال للناس إذ جاءوا لبيعته % % يسعون كالنمل من باد وحضار % % PageV01P140 21(@)(@@) % أليس هذا الحميدي المهين لكم % % لما أتينا أخذنا منه بالثار % % 22(@)(@@) % إلا فسيروا يهجر آمنين على % % دين الهدى بين جنات وأنهار % % 23(@)(@@) % وابشروا واشكروا الله أنعمه % % لما جلا الظلم والظلما بأنوار % % 24(@)(@@) % فما استقمتم فإنا نستقيم لكم % % عهدا وفيا لواف غير غدار 
ms48	 % % 25(@)(@@) % لقد حكينا لكم من بعض سيرته % % وليس ينبيك مثل العالم الداري % % 26(@)(@@) % فلا تظنوا به منا لما وهبت % % يداه حاشاه من بخل ومن عار % % 27(@)(@@) % لكنه للرعايا كالطبيب لها % % يسقي الدواء ويكوي الداء بالنار % % 28(@)(@@) % فادعوا له دائما بالخير واجتهدوا % % وناصحوه باعلان وأسرار % % 29(@)(@@) % ولا تكونوا كمن أبدى مداهنة % % والقلب لم يخل من غل واوحار % % 30(@)(@@) % ولا تشيدوا بناء الإعتقاد على % % أوهى شفا جرف من أصله هار % % PageV01P141 31(@)(@@) % لكن على المذهب المروي عن سلف % % من الصحابة والأتباع أخيار % % 32(@)(@@) % وابشروا بالذي ترجوا قلوبكم % % من الإمام السخي الناسك القاري % % 33(@)(@@) % هذي مقالة من أبدى نصيحته % % للمسلمين مع استغفاره الباري % % 34(@)(@@) % ثم الصلاة من الرحمن ما سجعت % % مغردات على أفنان أشجار % % 35(@)(@@) % أزكى صلاة بتسليم يوازرها % % على نبي كريم الأصل مختار % % 36(@)(@@) % محمد خير مبعوث وعترته % % وصحبه خير أصحاب وأنصار % % 37(@)(@@) % فأبدأهم بأبي بكر خليفته % % على الحقيقة ثاني اثنين في الغار % % 38(@)(@@) % والمقتدين بهم ما قال منشدها % % تبكي الحساء بدمع سافح جاري % % PageV01P142 البحر : طويل 1(@)(@@) % لك الحمد اللهم ما نزل القطر % % وما نسخ الديجور من ليلنا الفجر % % 2(@)(@@) % وما هبت النكبا رخاء وزعزعا % % على نعم لا يستطاع لها حصر % % 3(@)(@@) % فمن ذلك الفتح المبين الذي له % % تهلل وجه الدين وابتسم الثغر % % 4(@)(@@) % تفتح أبواب السماء لمثله % % ويعلو بسيط الأرض أثوابها الخضر % % 5(@)(@@) % فناهيك من فتح به أمن الفلا % % وأسفرت البلدان وابتهج الحضر % % 6(@)(@@) % تسامى به نجد إلى ذروة العلا % % وأسفر وجه الخط وافتخرت هجر % % 7(@)(@@) % لقد سرنا ما جاءنا من بشارة % % فزالت هموم النفس وانشرح الصدر % % 8(@)(@@) % لدن قيل عبد الله أقبل عاديا % % يقود أسودا في الحروب لها زأر % % 9(@)(@@) % ورئيس به سيما الخلافة قد بدت % % وفي وجهه الإقبال والعز والنصر % % 10(@)(@@) % فصبح قوما بالصبيحية اعتدوا % % وقادهم للبغي من شأنه الغدر % % PageV01P143 11(@)(@@) % فروى حدود المرهفات من الدما % % كما قد روت منها المثقفة السمر % % 12(@)(@@) % فغادر قتلى يعصب الطير حولها % % ويشبع منها النسر والذيب والنمر % % 13(@)(@@) % قبائل عجمان ومنهم شوامر % % ومن لحسين 
ms49	 ينتمون وما بروا % % 14(@)(@@) % وطائفة مرية غير عذبة % % خلائقها بل كل أفعالها مر % % 15(@)(@@) % أساءوا جميعا في الإمام ظنونهم % % فقالوا ضعيف الجند في عزمه حصر % % 16(@)(@@) % نغير على بلدانه ونخيفها % % ليعرفنا الوالي وينمو لنا الوفر % % 17(@)(@@) % فإن لم نصب ما قد أردنا فإنه % % صفوح عن الجاني ومن طبعه الصبر % % 18(@)(@@) % وما أنكروا في الحرب شدة بأسه % % ولكن بتسويل النفوس لها غروا % % 19(@)(@@) % وقد قسموا الإحساء جهلا بزعمهم % % لعجمانها شطر وللخالدي شطر % % 20(@)(@@) % أماني غرور كالسراب بقيعة % % يرى في الفلا وقت الضحى أنه بحر % % PageV01P144 21(@)(@@) % كذبتم فهجر سورها الخيل والقنا % % ومن دونها ضرب القماحد والأسر % % 22(@)(@@) % ومن دونها يوم به الجو مظلم % % أسنتنا والبيض أنجمه الزهر % % 23(@)(@@) % فقل للبوادي قد نكثتم عهودكم % % وذقتم وبال النكث وانكشف الأمر % % 24(@)(@@) % فعودوا إلى الإسلام واجتنبوا الردى % % وإلا فلا يؤويكم السهل والوعر % % 25(@)(@@) % وننذركم من بعدها أن من عصى % % فأفسد أو شق العصا دمه هدر % % 26(@)(@@) % فمن لم يكن عن غيه الوحي زاجرا % % له كان في ماضي الحديد له زجر % % 27(@)(@@) % تهن بهذا النصر يا فيصل الندى % % فقد تم للإسلام والحسب الفخر % % 28(@)(@@) % وهذا هو الفتح الذي قد بنى لكم % % مكارم يبقى ذكرها ما بقي الدهر % % 29(@)(@@) % وهذا هو الفتح الذي جل قدره % % وقد كل عن احصائه النظم والنثر % % 30(@)(@@) % فقابل بحمد الله جدواه مثنيا % % على الله بالنعما فقد وجب الشكر % % PageV01P145 31(@)(@@) % ولا تبن للأعراب مجدا فإنهم % % كما قيل أوثان لها الهدم والكسر % % 32(@)(@@) % إذا أودعوا النعماء لم يشكروا لها % % وإن رمت نفعا منهم أبدا ضروا % % 33(@)(@@) % فوضع الندى في اليد ومطغ ومفسد % % فاصلحهموا بالسيف كي يصلح الأمر % % 34(@)(@@) % وبالعدل سس أمر الرعية واحمهم % % عن الظلم كي ينمو لك الخير والأجر % % 35(@)(@@) % وألف بني الأحرار في زمن الرخا % % تجدهم إذا الهيجاء شدت لها الأزر % % 36(@)(@@) % ولا الذخر جمع المال في السلم للوغى % % ولكن أحرار الرجال هم الذخر % % 37(@)(@@) % ودونك نظم بالنصائح قد زها % % كما أن نظم العقد يزهو به الدر % % 38(@)(@@) % وختم نظامي بالصلاة مسلما 
ms50	 % % على المصطفى ماهل من مزنه القطر % % 39(@)(@@) % كذا الآل والصحب الأولى بجهادهم % % سما وعلا الإسلام وانخفض الكفر % % PageV01P146 البحر : طويل 1(@)(@@) % لك الحمد اللهم يا خير ناصر % % لدين الهدى ما لاح نجم لناظر % % 2(@)(@@) % وما انفلق إلا صباح من مطلع الضيا % % فجل وجلى حالكات الدياجر % % 3(@)(@@) % لك الحمد ما هب النسيم من الصبا % % ما أنهل ودق المعصرات المواطر % % 4(@)(@@) % على الفتح والنصر العزيز الذي سما % % فقرت به منا جميع النواظر % % 5(@)(@@) % وإظهار دين قد وعدت ظهوره % % على الدين طرا في جميع الجزائر % % 6(@)(@@) % وعدت فأنجزت الوعود ولم تزل % % معزا لأرباب التقى والبصائر % % 7(@)(@@) % لك الحمد مولانا على نصر حزبنا % % على كل باغ في البلاد وفاجر % % 8(@)(@@) % ومن بعد حمد الله جل ثناؤه % % على نعم لم يحصها عد حاصر % % 9(@)(@@) % نقول لأعداء بنا قد تربصوا % % عليكم أديرت سيئات الدوائر % % 10(@)(@@) % ألم تنظروا ما أوقع الله ربنا % % بعجمانكم أهل الجدود العواثر % % PageV01P147 11(@)(@@) % بأول هذا العام ثم بعجزه % % بأيام شهر الصوم إحدى الفواقر % % 12(@)(@@) % هموا بدلوا النعماء كفروا وجاهروا % % بظلم وعدوان وفعل الكبائر % % 13(@)(@@) % فكم نعمة نالوا وعز ورفعة % % على كل باد في الفلاة وحاضر % % 14(@)(@@) % إذا وردوا الإحساء يرعون خصبها % % وفي برها نبت الرياض الزواهر % % 15(@)(@@) % وكم أحسن الوالي إليهم ببذله % % وبالصفح عنهم في السنين الغوابر % % 16(@)(@@) % وكم نعمة أسدى لهم بعد نعمة % % ولكنه أسدى إلى غير شاكر % % 17(@)(@@) % ومن يصنع المعروف في غير أهله % % يلاقي كما لاقى مجير أم عامر % % 18(@)(@@) % لقد بطروا بالمال والعز فاجتروا % % على حرمة الوالي وفعل المناكر % % 19(@)(@@) % فمدوا يد الآمال للملك واقتفوا % % لكل خبيث ناكث العهد غادر % % 20(@)(@@) % وأبدوا لأهل الضغن ما في نفوسهم % % من الحقد والبغضا وخبث السرائر % % PageV01P148 21(@)(@@) % هموا حاولوا الإحسا ومن دون نيلها % % زوال الطلى ضربا وقطع الحناجر % % 22(@)(@@) % فعاجلهم عزم الإمام بفيلق % % رماهم به مثل الليوث الخوادر % % 23(@)(@@) % وقدم فيهم نجله يخفق اللوا % % عليه وفي يمناه أيمن طائر % % 24(@)(@@) % فأقبل من نجد بخيل سوابق % % ترى الأكم منها سجدا للحوافر % % 25(@)(@@) % فوافق في الوفرى 
ms51	 جموعا توافرت % % من البدو أمثال البحار الزواخر % % 26(@)(@@) % سبيعا وجيشا من مطير عرمرما % % ومن آل قحطان جموع الهواجر % % 27(@)(@@) % ولا تنس جمع الخالدي فإنهم % % قبائل شتى من عقيل وعامر % % 28(@)(@@) % سار بموار من الجيش أظلمت % % له الأفق من نقع هنالك ثائر % % 29(@)(@@) % فصبح أصحاب المفاسد والخنا % % بسمر القنا والمرهفات البواتر % % 30(@)(@@) % بكاظمه حيث التقى جيش خالد % % بهرمز نقلا جاءنا بالتواتر % % PageV01P149 31(@)(@@) % فلما أتى الجهراء ضاقت بجيشه % % وجالت بها الفرسان بين العساكر % % 32(@)(@@) % فولى العدا الأدبار إذ عاينوا الردى % % بطعن وضرب بالظبى والخناجر % % 33(@)(@@) % فما اعتصموا إلا بجلة مزبد % % من البحر يعلو موجه غير جازر % % 34(@)(@@) % فغادرهم في البحر للحوت مطعما % % وقتلى لسرحان ونمر وطائر % % 35(@)(@@) % تفاءلت بالجيران والعز إذ أتى % % بشيرا لنا عبد العزيز بن جابر % % 36(@)(@@) % فواها لها من وقعة عبقرية % % تشيب لرؤياها نواصي الأصاغر % % 37(@)(@@) % بها يسمر الساري إذا جد في السرى % % ويخطب من يعلو رؤوس المنابر % % 38(@)(@@) % تفوه بمدح للإمام ونجله % % ومعشره أهل العلا والمفاخر % % 39(@)(@@) % كفاه من المجد المؤثل ما انتمى % % إليه من العليا وطيب العناصر % % 40(@)(@@) % فشكرا إمام المسلمين لما جرى % % وهل تثبت النعماء إلا لشاكر % % PageV01P150 41(@)(@@) % فهنيت بالعيدين بالفتح أولا % % وعيد كمال الصوم إحدى الشعائر % % 42(@)(@@) % وشكر الايادي بالنواصي بالتقى % % بترك المناهي وامتثال الأوامر % % 43(@)(@@) % صبرت فنلت النصر بالصبر والمنى % % وما انقادت الآمال إلا لصابر % % 44(@)(@@) % فدونك من أصداف بحري لآلئا % % إلى نظمها لا يهتدي كل شاعر % % 45(@)(@@) % وبكرا عروسا أبرزت من خبائها % % شبيهة غزلان اللواء النوافر % % 46(@)(@@) % إلى حسنها يصبو وينشد ذو الحجى % % لك الخير حدثني بظبية عامر % % 47(@)(@@) % وأختم نظمي بالصلاة مسلما % % على من إليه الحكم عند التشاجر % % 48(@)(@@) % محمد المختار والآل بعده % % وأصحابه الغر الكرام الأكابر % % 49(@)(@@) % مدى الدهر والأزمان ما قال قائل % % لك الحمد اللهم يا خير ناصر % % PageV01P151 البحر : كامل تام 1(@)(@@) % قل للمليحة في القميص الأحمر % % ماذا فعلت بعابد مستبصر % % 2(@)(@@) % ما زال يدأب في العبادة طالبا % % للعلم غير مفرط ومقصر % % 3(@)(@@) % ترك الصبابة للصبا متسليا % % عن ذكر كل 
ms52	 عزالة أو جؤذر % % 4(@)(@@) % حتى وضعتي عن محياك الغطا % % فانجاب عن بدر منير مقمر % % 5(@)(@@) % ونشرت فرعا مثل ليل فاحم % % لولا مجاورة الصباح المسفر % % 6(@)(@@) % فدهشت من ذاك الجمال وحسنه % % ووقفت وقفة مولع متحير % % 7(@)(@@) % حسن به شغف الفؤاد وهاج لي % % شجنا فقل تجلدي وتصبري % % 8(@)(@@) % سقتي إلى الجسم السقام وراءه % % من ذلك الطرف السقيم الأحور % % 9(@)(@@) % سبحان من وهب المحاسن من يشا % % سبحانه من خالق ومصور % % 10(@)(@@) % يا كاعبا تحمي بصارم أنفها % % من كل صاد ورد ماء الكوثر % % PageV01P152 11(@)(@@) % شهد الرضاب وفيه خمر مسكر % % فالثم ولا حرج بذاك المسكر % % 12(@)(@@) % كلمتها من بعد تكليم الحشا % % يا هند إن لم تسمحي لم أصبر % % 13(@)(@@) % لا تتلفي بالصد مهجة مغرم % % فيصيب قومك سطوة من قسور % % 14(@)(@@) % من فيصل ملك الجزيرة من سما % % للمجد حتى حل فوق المشتري % % 15(@)(@@) % نصر الهدى وحوى الشجاعة والندى % % ليث وغيث للمقل المعسر % % 16(@)(@@) % أضحى بخير أرومة لو رامها % % ذو همة بتطاول لم يقدر % % 17(@)(@@) % كفاه كف قد كفت أعداءه % % والراحة الأخرى كمزن ممطر % % 18(@)(@@) % أعراقه طابت فطاب فروعها % % تعزى إذا نسبت لأطيب عنصر % % 19(@)(@@) % من عصبة صبروا على نصر الهدى % % وأذى العدا أكرم بهم من معشر % % 20(@)(@@) % آووا إلى إمام المسلمين محمدا % % لما جفاء ريئس آل معمر % % PageV01P153 21(@)(@@) % فدعا إلى التوحيد ضلال الورى % % جهرا ولولا منعهم لم يجهر % % 22(@)(@@) % وحموه من أعدائه بسيوفهم % % مع ضعفهم وكفى بها من مفخر % % 23(@)(@@) % ما هالهم جمع الخوالد إذ أتى % % بمدافع في فيلق مع عرعر % % 24(@)(@@) % بل صابروه بنية وبحسبة % % حتى تولى كالجهام المدبر % % 25(@)(@@) % وكذاك ما بالوا بتهديد أتى % % من صاحب الحرم الشريف الحيدر % % 26(@)(@@) % قاموا وما بالوا بلومة لائم % % من مرجف ومخوف ومحذر % % 27(@)(@@) % بل هدموا أوثان شرك عظمت % % ونهوا عن الأمر الشنيع المنكر % % 28(@)(@@) % شنوا على أهل القرى غاراتهم % % وعلى البوادي في الخلاء المقفر % % 29(@)(@@) % حتى صفت لهم الجزيرة واجتنوا % % للعز من ورق الحديد الأخضر % % 30(@)(@@) % وبنوا مفاخر جمة مشهورة % % شهد العدو بها ولما ينكر % % PageV01P154 31(@)(@@) % وقد 
ms53	 حظي هذا الإمام ونسله % % من ذاك بالحظ الوفي الأوفر % % 32(@)(@@) % ما زال يقفو الأثر من أسلافه % % بالنصر للشرع الأعز الأطهر % % 33(@)(@@) % أفلا ترى أعلامه منشورة % % للغزو بين سرية أو عسكر % % 34(@)(@@) % فيغير في غور البلاد ونجدها % % فوق النجائب والجياد الضمر % % 35(@)(@@) % حتى أعز به المهيمن دينه % % وأذل كل معاند متجبر % % 36(@)(@@) % فانقادت الأعراب بعد عتوها % % بالسمر والبيض الخفاف البتر % % 37(@)(@@) % لا زال محفوظ الجناب مؤيدا % % بالنصر والفتح المبين الأكبر % % 38(@)(@@) % وعلى النبي وآله وصحابه % % أزكى صلاة مثل نفح العنبر % % 39(@)(@@) % تبقى مدى الأيام ما هب الصبا % % سحرا على الروض الأنيق المزهر % % PageV01P155 البحر : طويل 1(@)(@@) % بقاؤك فيما بيننا منة الدهر % % نقابله بالحمد والشكر % % 2(@)(@@) % ترائيك لما أن رأتك عيوننا % % ترائي هلال العيد ليلة الفطر % % 3(@)(@@) % جلوت بأنوار الهدى ظلمة الردى % % كما انفلق الديجور مطلع الفجر % % 4(@)(@@) % فأضحت بك الأيام غرا ضواحكا % % وأمست ليالي الشهر كالبيض بالبدر % % 5(@)(@@) % رفعت لأعلام الشريعة في القرى % % وحكمت حكم الشرع في البدو والحضر % % 6(@)(@@) % وصيرت للعلم الشريف محافلا % % أحاديث ترويها الرواة عن الخدري % % 7(@)(@@) % لئن أمنت نجد بملكك وازدهت % % فقد فخر الأحسا به وقرى هجر % % 8(@)(@@) % وسرت عمان بالأماني فأسلمت % % لدن زرتها بالجرد والبيض والسمر % % 9(@)(@@) % رفعت بها الرايات في كل جحفل % % جررت فدانت بعد ذا الرفع والجر % % 10(@)(@@) % فأنت حسام الدين والله ضارب % % بحدك هامات الضلالات والكفر % % PageV01P156 11(@)(@@) % وليس عطاياك الغزار كغيرها % % فمن ذا يقيس النهر في البحري بالبحر % % 12(@)(@@) % وما أنت إلا العارض الجود جلجلت % % رواعده وانهل في البلد القفر % % 13(@)(@@) % فأصبح بعد المحل يهتز بالربى % % وفاح من الروض البهي شذا الزهر % % 14(@)(@@) % فلا زلت في الملك العزيز مؤيدا % % من الله بالفتح المبين وبالنصر % % 15(@)(@@) % وصل إله العالمين مسلما % % على المصطفى الهادي وشيعته الغر % % 16(@)(@@) % محمد المختار من آل هاشم % % وأصحابه وابدأهموا بأبي بكر % % PageV01P157 البحر : طويل 1(@)(@@) % تهلل وجه الدين وابتسم الثغر % % وقد لاح من بيض السيوف له النصر % % 2(@)(@@) % وجلى دباجير الضلالة والردى % % سنا المرهفات البيض فانصدع الفجر % % 3(@)(@@) % وشمس الأماني بالتهاني لنا 
ms54	 بدت % % وبالسعد لاحت فانجلت انجم زهر % % 4(@)(@@) % وقد جاءنا ذاك البشير مبشرا % % بفتح عمان حين حل به السدر % % 5(@)(@@) % همام له قاد الجيوش بفيلق % % إذا جاش بالأبطال يشبهه البحر % % 6(@)(@@) % فأوطأهم جمعا عمانا فأذعنت % % ودان له من أرضها السهل والوعر % % 7(@)(@@) % وحلت بها الخيل السوابق بالقنا % % وسلت سيوف الحق فانهزم الكر % % 8(@)(@@) % وطهرها من كل سوء وباطل % % وكانت تبذي القبائح والسحر % % 9(@)(@@) % وبالا من ساروا في البلاد لياليا % % وأيام سعد صفوها ما به كدر % % 10(@)(@@) % فقرت عيون المسلمين بنصره % % كما شمخت منا الأنوف ولا فخر % % PageV01P158 11(@)(@@) % فناهيك من فتح مبين تزلزلت % % له مكة والسند وارتعد الشحر % % 12(@)(@@) % فهذا هو الفتح الذي فخرت به % % عمان ونجد أشرقت وسما هجر % % 13(@)(@@) % فهن أمام المسلمين وقل له % % هنيئا لك الإقبال والفتح والنصر % % 14(@)(@@) % لئن لبست نجد بملكك مفخرا % % فقد زانت الدنيا بوجهك والعصر % % 15(@)(@@) % فما هي إلا نعمة جل قدرها % % فلله فيها يعظم الحمد والشكر % % 16(@)(@@) % ودونكها منظومة عبقرية % % تناثر من اصبهاف أبياتها الدر % % 17(@)(@@) % وبكر عروس قد تصدى لزفها % % محب لكم أدنى وسائله الشعر % % 18(@)(@@) % فعجل قراها فالضرورة احوجت % % وكاد يكون الفقر لولا الهدى كفر % % 19(@)(@@) % وانجز له الوعد الذي قد وعدته % % فأمنيته والوعد ينجزه الحر % % 20(@)(@@) % أصلي على المختار ما هبت الصبا % % على الروض مطلولا فعطره الزهر % % PageV01P159 البحر : مجزوء الرجز 1(@)(@@) % يا من أشاد جامعا % % لله في الإحسا عمر % % 2(@)(@@) % به يسر كل من % % لله مولانا شكر % % 3(@)(@@) % من بعد أن خربه % % كل ظلوم قد بطر % % 4(@)(@@) % وليس من يعمره % % كمن بتخريب أمر % % 5(@)(@@) % بشراء يا عامره % % غدا ببيت من درر % % 6(@)(@@) % في جنة عالية % % ذات قصور وثمر % % 7(@)(@@) % من أجل ذا تاريخه % % محرر عز أغر % % PageV01P160 البحر : طويل 1(@)(@@) % أنظم قريض أم نفيس الجواهر % % له نظمت بالفكر أيدي الخواطر % % 2(@)(@@) % أم الروضة الغناء قد حاك وشيها % % أنامل وسمى السحاب المباكر % % 3(@)(@@) % أم الطرس يزهو بالبلاغة وسمه % % يكاد لها يبيض حبر المحابر % % 4(@)(@@) % فأنبأنا عن وجد صب أخى وفا % % تذكر عهدا في 
ms55	 السنين الغوابر % % 5(@)(@@) % وأثنى على شيخ هدته علومه % % إلى نهج أرباب الحجى والبصائر % % 6(@)(@@) % فأصبح في الآداب والعلم والنهى % % يتيمة دهر فهو إحدى النوادر % % 7(@)(@@) % تذكرنا قسا فصاحة لفظه % % وتخبر عن سحبان فوق المنابر % % 8(@)(@@) % وينشده الملتاع من لاعج الهوى % % لك الخير حدثني بظبية عامر % % 9(@)(@@) % عليه سلام الله ما نمت الصبا % % بعرف الخزامى في الرياض الزواهد % % 10(@)(@@) % بحيث وفى بالواجبات وما جفا % % وهجران شيخ العلم إحدى الكبائر % % PageV01P161 11(@)(@@) % وصل إله العالمين مسلما % % على خير مبعوث وناه وآمر % % 12(@)(@@) % كذا الآل والأصحاب ما هبت الصبا % % وما أطرب الأسماع تغريد طائر % % PageV01P162 البحر : - 1(@)(@@) % بحمد إله يجمع الشمل عطفه % % وأيدي النوى عما يرام تحاجز % % 2(@)(@@) % أتاني سلام ضاع بالند نشره % % وفاحت به عطرا علينا المفاوز % % 3(@)(@@) % به رد لي عصر الشبيبة والهوى % % وما الشيب لي عن ذلك العهد حاجز % % 4(@)(@@) % سلام كعقد الدر في جيد غادة % % بضمن كتاب أبدعته الغرائز % % 5(@)(@@) % كتاب به سر البلاغة واضح % % وكل بليغ عن مجاريه عاجز % % 6(@)(@@) % غدت نبلاء العصر مذعنة له % % وما كل مقدام جريء يبارز % % 7(@)(@@) % ولله طرس قد أعاد لي الهوى % % وأبدى من الأسواق ما أنا كانز % % 8(@)(@@) % فشوقي حكى شوق المتيم خانه % % سلو صبر والمحجب ناشز % % 9(@)(@@) % كتاب حبيب حالف الجود كفه % % وها هو في نوع المروءة فائز % % 10(@)(@@) % حبيب كريم الذات والأصل ماجد % % له في أثيل المجد قدما مراكز % % PageV01P163 11(@)(@@) % فريد المزايا أحمد الذكر باسل % % نجيب لغايات الثنا متجاوز % % 12(@)(@@) % أبي يفي طبعا عهود إخائه % % ولكن به يشقى العدر المبارز % % 13(@)(@@) % له خلق كالروض كلله الندى % % سحيرا وغاداه النسيم المجاوز % % 14(@)(@@) % بودي لكم أبدي القريض مهذبا % % وليس كمدح زخرفته الجوائز % % 15(@)(@@) % يرى النزر من شعري كأنفس حلية % % وبالطل عن وبل تسد العوائز % % PageV01P164 البحر : طويل 1(@)(@@) % أنظم بديع هذبته الغرائز % % أم الدر من أصداف بحرك بارز % % 2(@)(@@) % أم الروض حاكت أدمع المزن وشيه % % فعطر من ذاك النسيم المجاوز % % 3(@)(@@) % أأبكار فكر فقد ضممن لآلئا % % من القوم لا ما نظمته العجائز % % 4(@)(@@) % نعم در 
ms56	 ألفاظ القريض أنى بها % % بليغ لأنواع الفصاحة حائز % % 5(@)(@@) % إلى العلويين الكرام قد انتمى % % قفى هاشم أغرافه والمراكز % % 6(@)(@@) % أجال بميدان البلاغة خيلة % % فصار بها يدعي الكمى المناجز % % 7(@)(@@) % لقد أحجمت فرسانها عن لقائه % % فكل بليغ عن مراميه عاجز % % 8(@)(@@) % حوى النحو مع علم المعاني فتارة % % يبين لنا المعنى وحينا يلاغز % % 9(@)(@@) % وقد جاء في علم البيان قريضه % % بنوع من السحر الذي هو جائز % % 10(@)(@@) % وأصبح في علم البديع ابن حجة % % ومن ذا له في كل فن يبارز % % PageV01P165 11(@)(@@) % تجاوز حد الشعر حتى كأنما % % قصائده للمنكرين معاجز % % 12(@)(@@) % إذ قال قولا أنشد الناس شعره % % وغنى به باد وحاد وراجز % % 13(@)(@@) % وما أنشدت يوما عرائس شعره % % على مقعد إلا مشى وهو ناشز % % 14(@)(@@) % ودبت به روح الصبابة فاستوى % % ولو كان محمولا حوته الجنائز % % 15(@)(@@) % لئن بلغتنا عنك يا ابن طباطبا % % نسيم الصبا شوقا لحد يجاوز % % 16(@)(@@) % فإن بنا من لاعج الشوق فوق ما % % بثثت وأضعاف الذي أنت كانز % % 17(@)(@@) % فإن حكمت أيدي النوى بافتراقنا % % وصار لنا من شقة البين حاجز % % 18(@)(@@) % فإن لأرواح المحبين مجمعا % % وإن بعدت بين الجسوم المفاوز % % 19(@)(@@) % ودونك من جهد المقل خريدة % % من الشعر أهدتها إليك الغرائز % % 20(@)(@@) % أتتك من الإحساء تطلب كفوها % % وما مهرها إلا الرضى والتجاوز % % PageV01P166 21(@)(@@) % عليك بحسن المدح أثنت مودة % % وما قصد كل الوافدين الجوائز % % 22(@)(@@) % وخير ختامي أن أصلي مسلما % % على المصطفى من أيدته المعاجز % % 23(@)(@@) % وأصحابه ما جالت الخيل بالقنا % % وما حركت للدارعين الهزاهز % % PageV01P167 البحر : طويل 1(@)(@@) % لقد لاح سعد النيرات الطوالع % % وغابت نحوس من جميع المطالع % % 2(@)(@@) % غداة انحنا بالرياض ركابنا % % بباب امام تابع للشرائع % % 3(@)(@@) % حريص على إحياء سنة أحمد % % وإخماد نيران الهوى والبدائع % % 4(@)(@@) % يقيم اعوجاج الأمر بالبيض والقنا % % ويحكم بالوحيين عند التنازع % % 5(@)(@@) % ويحيي دروسا للعلوم بدرسها % % وتقريب ذي علم قريب وشاسع % % 6(@)(@@) % تقي نقي قانت متواضع % % وما الفخر إلا في التقى والتواضع % % 7(@)(@@) % وما زال للدين الحنيفي ناصرا % % بتدمير أوثان وتعمير جامع % % 8(@)(@@) % يعامل قوما بالأناة 
ms57	 فإن تفد % % وإلا أفادتهم حدود اللوامع % % 9(@)(@@) % وإن تسألن عن جوده وسخائه % % فكفاه مثل المعصرات الهوامع % % 10(@)(@@) % فإن كنت عن علياه يوما محدثا % % فحث وقرط بالحديث مسامعي % % PageV01P168 11(@)(@@) % هو المنهل الطامي بل به الصدا % % فرده ودع آل البقاع البلاقع % % 12(@)(@@) % به أمن الله البلاد فأصبحت % % لنا حرما في الأمن من كل رائع % % 13(@)(@@) % بمدحته فاه الزمان وأهله % % فحسبك من صيت له فيه شائع % % 14(@)(@@) % يربي يتامى المسلمين كأنه % % لهم والد بر بهم غير دافع % % 15(@)(@@) % وكم بائس عار كساه برفده % % وكم أشبعت يمناه من بطن جائع % % 16(@)(@@) % قصدناه من هجر تؤمل رفده % % فجاد علينا بالمنى والمنافع % % 17(@)(@@) % أعذناه بالرحمن من كيد كائد % % ومن شر شيطان وحب مخادع % % 18(@)(@@) % ونستودع الله المهيمن ذاته % % وربي كريم حافظ للودائع % % 19(@)(@@) % وكل إله العالمين على الذي % % أتانا بنور من هدى الله ساطع % % 20(@)(@@) % محمد المبعوث للناس رحمة % % بأقوم دين ناسخ للشرائع % % PageV01P169 21(@)(@@) % كذا الآل والأصحاب ماهبت الصبا % % وما أطرب الأسماع صوت لساجع % % PageV01P170 البحر : بسيط تام 1(@)(@@) % الحمد لله حمدا دائما وكفى % % شكرا على سيب جدواه الذي وكفا % % 2(@)(@@) % ثم الصلاة وتسليم الإله على % % ماحي الضلال ومحيي سنة الخلفا % % 3(@)(@@) % نبينا أحمد الهادي وشيعته % % وكل من عند حد الله قد وقفا % % 4(@)(@@) % وبعد فالعلم بالتاريخ أنفع ما % % له اللبيب اعتنى أو همة صرفا % % 5(@)(@@) % وهاك نظما وجيز اللفظ محتويا % % منه على غرر من سيرة الخلفا % % PageV01P171 البحر : بسيط تام 1(@)(@@) % قد كان مولد خير الخلق أرخه % % على الأصح بعام الفيل من عرفا % % 2(@)(@@) % وذاك بعد ألوف سدست ولها % % قاف وسين ودال بعدها ردفا % % 3(@)(@@) % من حين أهبط مولانا خليفته % % للأرض مستخلفا بالذنب معترفا % % 4(@)(@@) % وحين كمل سن الأربعين أتى % % إليه بالوحي روح الله واختلفا % % 5(@)(@@) % إليه بضعة عشر قبل هجرته % % من مكة ثم عشر بعدهن وفا % % 6(@)(@@) % ومات في طيبة في شهر مولده % % في حادي العشر للجنات قد زلفا % % 7(@)(@@) % فوا مصيبة أهل الأرض أجمعهم % % بفقده حين واروه ويا أسفا % % PageV01P172 البحر : - 1(@)(@@) % وقام من بعده الصديق 
ms58	 مقتديا % % بهديه تابعا للحق إذ خلفا % % 2(@)(@@) % ما هاله ذلك الخطب الذي عظمت % % فيه الخروق ولم يوهن وما ضعفا % % 3(@)(@@) % سل الحسام على من زاغ حين أبو % % عن الزكاة وللخرق العظيم رفا % % 4(@)(@@) % حتى استقام به دين الهدى وسما % % ورد من كان مرتدا ومنحرفا % % 5(@)(@@) % وفي ثلاثة عشر مات مجتهدا % % وقلد الأمر أقواهم بغير خفا % % 6(@)(@@) % أعني به عمر الفاروق من فتحت % % به الفتوح وعز الدين وانتصفا % % 7(@)(@@) % بعدله ضرب الأمثال ساكنها % % ورأيه وافق التنزيل إذ وصفا % % 8(@)(@@) % وهو الذي سلب الأملاك ملكهم % % أباد كسرى وأجلى قيصر ونفا % % 9(@)(@@) % وفي ثلاث وعشرين الشهادة قد % % سيقت إليه بفرض الصبح إذ وقفا % % 10(@)(@@) % ثم الخليفة عثمان ومقتله % % في عام ويك بلا ذنب له اقترفا % % PageV01P173 11(@)(@@) % أضحى قتيلا بأيدي عصبة خرجت % % عن الهدى وأتوا من أمرهم سرفا % % 12(@)(@@) % ضحوا بأشمط عنوان السجود به % % يقطع الليل تسبيحا له كلفا % % 13(@)(@@) % ذو الهجرتين وذو النورين محتسبا % % كف القتال ولو سل الحسام شفا % % 14(@)(@@) % أصيب يتلو كتاب الله إذ قطرت % % منه الدماء على يكفيكهم فكفا % % 15(@)(@@) % في الأربعين علي كان مقتله % % بكف ذي شقوة عن ديننا صدفا % % 16(@)(@@) % أضحى كأشقى ثمود حين أوردهم % % بذنبه إذ أذلق الناقة التلفا % % 17(@)(@@) % أما علي فلا تحصى مناقبه % % كأنها الشمس إذ تبدو بغير خفا % % 18(@)(@@) % زوج البتول ابن عم المصطفى أسد % % يوم الهياج فكم من مشكل كشفا % % 19(@)(@@) % فخذهم خلفاء الرشد أربعة % % من يقف هديهم هدى النبي قفا % % 20(@)(@@) % وفي ثلاثين حولا كان مدتهم % % فيها الهدى بين أهل الأرض قد عكفا % % PageV01P174 البحر : - 1(@)(@@) % بنوا أمية أملاك غطارفة % % حازوا الخلافة بعد السادة الخلفا % % 2(@)(@@) % منهم معاوية صهر النبي ومن % % قد كان بالحلم والإنصاف متصفا % % 3(@)(@@) % ثم ابنه بعده أعني يزيد وذا % % جان على نفسه لما بغى سرفا % % 4(@)(@@) % ثم ابنه واسمه أيضا معاوية % % فلم يرم إن تولى أثره وقفا % % 5(@)(@@) % حتى احتوى الملك مروان وورثه % % لنسله بعده حتى بهم عرفا % % 6(@)(@@) % عبد الملك وأبناء له غرر % % في العد أربعة قد احرزوا 
ms59	 الشرفا % % 7(@)(@@) % هم الوليد سليمان يزيد ومن % % يدعي هشام وكل حين ساس كفا % % 8(@)(@@) % لكن سليمان أفضاها إلى عمر % % أكرم به من إمام تابع السلفا % % 9(@)(@@) % أحيا سبيل الهدى من بعدما درست % % وأظهر العدل وقت الجور حين عفا % % 10(@)(@@) % وطهر الأرض من ظلم الولاة بها % % حتى إذا مات لم ندرك له خلفا % % PageV01P175 11(@)(@@) % وابن اليزيد وليدا وهو أفسق من % % قد قلد الأمر منهم بئس ما اقترفا % % 12(@)(@@) % واذكر يزيد وإبراهيم قل وهما % % ابنا الوليد ومروان الحمار قفا % % 13(@)(@@) % فعدة القوم عشر بعد أربعة % % في ألف شهر تقضي ملكهم ووفا % % 14(@)(@@) % تاريخه عام ثنتي عشرة تبعت % % عشرين بعد تمام القرن قد كشفا % % PageV01P176 البحر : - 1(@)(@@) % ثم اقتفتهم بنو العباس تضربهم % % بالمشرفية ضربا مسرفا عنفا % % 2(@)(@@) % حتى احتوى ابن علي كلما ادخروا % % من الكنوز وحاز الملك والتحفا % % 3(@)(@@) % وقام جد بني العباس حين بدا % % من سعدهم طالع لا يعتريه خفا % % 4(@)(@@) % واستنقذوا من بني مروان ملكهم % % فهم أحق به لو حكموا النصفا % % 5(@)(@@) % وهاك ضبط الذي من نسله ملكوا % % خذهم ثلاثين تتلو سبعة خلفا % % 6(@)(@@) % سفاح منصور مهدي وهاديهم % % هارون وهو رشيد ليس فيه خفا % % 7(@)(@@) % قد كان ذا خشية لله متقيا % % وعارض الجود من كيفه قد وكفا % % 8(@)(@@) % ثم الأمين والمأمون ومعتصم % % ثم ابنه واثق بالله قد عرفا % % 9(@)(@@) % وذو التوكل منهم ثم منتصر % % والمستعين ولكن بدره انكسفا % % 10(@)(@@) % والمهتدي بعده المعتز معتمد % % وأحمد المعتضد بالله قد خلفا % % PageV01P177 11(@)(@@) % وكان أقواهم ملكا وأسوسهم % % من بعده الملك أمسى واهيا دنفا % % 12(@)(@@) % ثم ابنه المكتفي بالله مقتدر % % وقاهر بعده الرضي به اكتنفا % % 13(@)(@@) % وفتق ثم مستكف مطيعهم % % وطائع قادر للمسلمين شفا % % 14(@)(@@) % وقائم مقتدر مستظهر وكذا % % مسترشد راشد كالليث إذ وصفا % % 15(@)(@@) % ومقتف بعد مستنجد ملكا % % والمستضيء بنور الله قد عرفا % % 16(@)(@@) % بالفضل واليمن إذ عادت خلافتهم % % بملكه حسبما كانت وما جنفا % % 17(@)(@@) % وناصر ظاهر مستنصر فطن % % أهدى له يوسف من حسنه طرفا % % 18(@)(@@) % كذاك مستعصم كان الختام به % % وكان في رأيه من أضعف 
ms60	 الضعفا % % 19(@)(@@) % من أجله كاده ابن العلقمي فلم % % يفطن لحيلته الأغبى وما عرفا % % 20(@)(@@) % إذ قال اعطاؤك الأجناد ما لهم % % يفني الخزائن فاحفظ واترك السرفا % % PageV01P178 21(@)(@@) % فليس في كثرة الأجناد فائدة % % والمال جندك لن نحتج إليه كفا % % 22(@)(@@) % ودس نحو تتار الكفر يخبرهم % % بكيده وعلى ما قاله حلفا % % 23(@)(@@) % فاقبلوا نحو بغداد بزحفهم % % فلم يروا دونها الجند الذي كشفا % % 24(@)(@@) % فحكموا السيف فيها أربعين فلم % % يبقوا عليما وأفنوا سائر الخلفا % % 25(@)(@@) % وقتلوا وعثوا بالسبي وانتهبوا % % كل النفائس يالهفا ويا أسفا % % 26(@)(@@) % وأودعوا الكتب والقرآن دجلتها % % حتى جرى ماؤها بالحبر حين طفا % % 27(@)(@@) % وكاد يجتث أصل الدين فتكهم % % لولا الإله باتباع الهدى لطفا % % 28(@)(@@) % آه لها وقعة سيم العباد بها % % خسفا وكل من الأقطار قد رجفا % % 29(@)(@@) % بها أهين الهدى بل ذل جانبه % % والكفر عز وللغيظ القديم شفا % % 30(@)(@@) % تاريخها بمئين سدست وتلت % % تسعا وخمسين عاما كان منكشفا % % PageV01P179 31(@)(@@) % حتى إذا هب من مصر نسيم صبا % % بالنصر للدين مع سلطانها عصفا % % 32(@)(@@) % فمزق الله أجناد التتار به % % حتى أبيدوا وعاد الدين منتصفا % % 33(@)(@@) % ثم الصلاة على خير البرية ما % % هب النسيم قضيب البان فانعطفا % % 34(@)(@@) % وآله الغر والصحب الكرام ومن % % تلى سبيلهم من بعدهم وقفا % % PageV01P180 البحر : طويل 1(@)(@@) % أتنكر رسم الدار أم أنت تعرف % % لدن قمت بالأطلال والعين تذرف % % 2(@)(@@) % ديار لسلمى قد محا رسمها البلا % % وغيرها وبل من المزن ينظف % % 3(@)(@@) % كأن لم تكن مغنى لبيض أو أنس % % بهن غزال أحور الطرف أهيف % % 4(@)(@@) % فتاة كأن البدر غرة وجهها % % سوى أنه حينا إذا أتم يكسف % % 5(@)(@@) % ترى الصبح يبدو نوره من جبينها % % وفي شعرها جنح من الليل يعكف % % 6(@)(@@) % وقد يقد العاشقين قوامه % % كمثل قضيب البان بالريح يعطف % % 7(@)(@@) % وطرف سقيم اللحظ كم أسقمت به % % محبا نحيفا جسمه فهو مدنف % % 8(@)(@@) % وأنف كحد المشرفي حمت به % % رحيق رضاب طيب حين يرشف % % 9(@)(@@) % فما بال من لا يعرف الوجد والهوى % % يلوم على وجدي بها ويعنف % % 10(@)(@@) % كما لام والي المسلمين سفاهة 