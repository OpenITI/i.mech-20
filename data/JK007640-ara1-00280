ms261	(@)(@@) % ولو أنها تصغي لعتبي أذقتها % % وبال حديث في العتاب يطول % % PageV01P814 61(@)(@@) % وما تنفع العتبى وما ثم منصف % % أقول له ما أشتهي ويقول % % PageV01P815 البحر : رمل تام 1(@)(@@) % ما قضى إلا على الصب العميد % % وغدا يعثر في ذيل الصدود % % 2(@)(@@) % رشأ يقتنص الأسد ومن % علم الظبي اقتناصا للأسود ؟ % 3(@)(@@) % بأبي الشادن يرنو طرفه % % بلحاظ الريم سود % % 4(@)(@@) % ما ألاقي من سيوف وقنا % ما ألاقي من عيون وقدود % % 5(@)(@@) % ويح قلب لعب الشوق به % % من عيون بابليات وجيد % % 6(@)(@@) % رب طيف من زرود زارني % % فسقى صوب الحيا عهد زرود % % 7(@)(@@) % فتذكرت زمانا مر بي % % طرب النشوة مرعي العهود % % 8(@)(@@) % وبعيد الدار في ذاك الحمى % % من فؤادي في الهوى غير بعيد % % 9(@)(@@) % يا دموعي روضي الخد ويا % % حر نيران الجوى هل من مزيد ؟ % 10(@)(@@) % أين أيام الهوى من رامة % % يا لياليها رعاك الله عودي % % PageV01P816 11(@)(@@) % وبكاء المزن في أرجائها % % إنما تغرف من بحر مديد % % 12(@)(@@) % قذفت أنجمها - كأس الطلا % % كل شيطان من الهم مريد % % 13(@)(@@) % فأدرها قهوة عادية % عصرت في عهد عاد وثمود % % 14(@)(@@) % أيها الساقي وهب لي قبلة % هبة منك باحسان وجود % % 15(@)(@@) % أنا لا أشربها إلا على % % أقحوان الثغر أو ورد الخدود % % 16(@)(@@) % وبفيك المورد العذب الذي % % أرتوي منه ومن لي بالورود % % 17(@)(@@) % وبقلبي نار خديك التي % % لم تزل في مهجتي ذات الوقود % % 18(@)(@@) % من معيد لي زمانا قد مضى % % بمذاب التبر في الماء الجمود % % 19(@)(@@) % دارت الأقداح فيها طربا % من يدي أحوى ومن حسناء ورد % 20(@)(@@) % وكأن الكأس في توريدها % % قطفت واعتصرت من خد خود % % PageV01P817 21(@)(@@) % في رياض غردت ورقاؤها % % بفنون السجع منها والنشيد % % 22(@)(@@) % وغصون البان في ريح الصبا % % تنثني بين ركوع وسجود % % 23(@)(@@) % فسقى تلك المغاني عارض % مستطير البرق مهدار الرعود % % 24(@)(@@) % كانت الجنة إلا أنها % % لم تكن حينئذ دار الخلود % % 25(@)(@@) % في ليال أشبهت ظلماؤها % % بدخان كان من ند وعود % % 26(@)(@@) % وكأن الأنجم الزهر بها % % أعين من وجدها غير رقود % % 27(@)(@@) % وكأن البدر فيها ملك % حف بالموكب منها 
ms262	 والجنود % % 28(@)(@@) % وكأن الصبح في إثر الدجى % % طائر يركض في إثر طريد % % 29(@)(@@) % رق فيه الجو حتى خلته % % رقة القاضي بنا عبد الحميد % % 30(@)(@@) % لطفت أخلاقه وابتهجت % كابتهاج الروض يزهو بالورود % % PageV01P818 31(@)(@@) % إن من يأوي إلى أحكامه % % إنما يأوي إلى ركن شديد % % 32(@)(@@) % عادل في الحكم يمضي حكمه % % بقضاء الرب ما بين العبيد % % 33(@)(@@) % كلما كررت فيه نظرا % رمقتني منه ألحاظ الورود % % 34(@)(@@) % حجتي فيه الأيادي والندى % % وجميل الصنع بالخلق الحميد % % 35(@)(@@) % وشهودي من مزاياه ولا % % تثبت الحجة إلا بالشهود % % 36(@)(@@) % قمر في المجد يكسوه السنا % % شرف الآباء منه والجدود % % 37(@)(@@) % أنا لولا صيب من سيبه % % من منيل ومراد لمريد % % 38(@)(@@) % عالم فيه لنا فائدة % % فجزى الله مفيد المستفيد % % 39(@)(@@) % ألمعي ناظر في بصر % % في خوافي غامض الأمر حديد % % 40(@)(@@) % وبما في ذاته من همم % كلما ترهف أزرت بالحدبد % % PageV01P819 41(@)(@@) % شرحت معنى معاليه لنا % % فهي لا تخفى على غير البليد % % 42(@)(@@) % وأرتنا منه في أقرانه % % مفردا يغني عن الجمع العديد % % 43(@)(@@) % شرعة الدين ومنهاج الهدى % % قائم بالقسط مجري الحدود % % 44(@)(@@) % حامل للحق سيفا خاضع % لمضاه كل جبار عنيد % % 45(@)(@@) % يرتجى أو يختشى في حده % % مؤنس الوعد وإيحاش الوعيد % % 46(@)(@@) % وعدتني منه آمالي به % % فوفت لي بعد حول بالوعود % % 47(@)(@@) % فحمدت الله لما أن بدا % % طالعا كالبدر في برج السعود % % 48(@)(@@) % عاد للمنصب قاض لم يزل % % 49(@)(@@) % وبفضل الله يعلو مجده % % فتعالى الله ذو العرش المجيد % % 50(@)(@@) % يا عماد المجد في المجد ويا % % درة التاج ويا بيت القصيد % % PageV01P820 51(@)(@@) % دمت في العالم عطري الشذا % % دائم النعمة مكبوت الحسود % % 52(@)(@@) % يا لك الله فتى من مبدئ % بالندى والفضل فينا ومعيد % % 53(@)(@@) % وقوافي التي أنشدها % % نظمت في مدحه نظم العقود % % 54(@)(@@) % أطلقت فيه لساني أنعم % قيدتني من علاه بقيود % % 55(@)(@@) % أما لولا صيب من سيبه % % ما ارتوى غصني ولا أورق عودي % % PageV01P821 البحر : كامل تام 1(@)(@@) % لك بالمعالي رتبة تختارها % % ف فخر فأنت فخارنا وفخارها % % 2(@)(@@) % يا ساعد الدين القويم وباعه % % لحظتك من عين 
ms263	 العلى أنظارها % % 3(@)(@@) % لله أية رفعة بلغتها % % قرت وليس يغيرك استقرارها % % 4(@)(@@) % في ذروة الشرف الرفيع مقامها % % وعلى أهاضيب العلى أوكارها % % 5(@)(@@) % فلتهن فيك شريعة قد أصبحت % % وعليك ما بين الأنام مدارها % % 6(@)(@@) % ولقد ملأت الكون في نور الهدى % % كالشمس قد ملأ الفضا أنوارها % % 7(@)(@@) % وكشفت من سر العلوم غوامضا % لولاك ما انكشفت لنا أسرارها % % 8(@)(@@) % يا دوحة الفضل الذي لا يجتنى % % إلا بنائل جوده أثمارها % % 9(@)(@@) % الله أكبر أنت أكبر قدوة % % لم تعرف الثقلات ما مقدارها % % 10(@)(@@) % ولتسم فيك المسلون كما سمت % % في جده عدنانها ونزارها % % PageV01P822 11(@)(@@) % من حيث إن لسانه صمصامها ال % % ماضي وإن يراعه خطارها % % 12(@)(@@) % فرد بمثل كماله ونواله % % لم تسمح الدنيا ولا أعصارها % % 13(@)(@@) % دنيا بها نقرض الكرام فأذنبت % % فكأنما بوجوده استغفارها % % 14(@)(@@) % وكأنما اعتذرت إلى أبنائها % % فيه وقد قبلت به أعذارها % % 15(@)(@@) % أمؤملا نيل الغنى بأكفه % يغنيك من تلك الأكف نضارها % % 16(@)(@@) % بسطت مكارمه أنامل راحة % تجري على وفاده أنهارها % % 17(@)(@@) % أحرارنا فيما تنيل عبيدها % % وعبيده من سيبه أحرارها % % 18(@)(@@) % هاتيك شنشنة وقد عرفت به % % لم تقض إلا بالندى أوطارها % % 19(@)(@@) % كم روضة بالفضل باكرها الحيا % % فزهت بوابل جوده أزهارها % % 20(@)(@@) % هو ديمة لم تنقطع أنواؤها % % وسحابة لم تنقشع امطارها % % PageV01P823 21(@)(@@) % أحيا ربوع العلم بعد دروسها % % علما وقد رجعت لها أعمارها % % 22(@)(@@) % وكذا القوافي الغر بعد كسادها % % ربحت بسوق عكاظه تجارها % % 23(@)(@@) % حملت جميل ثنائه ركبانها % % وتحدثت بصنيعه سمرها % % 24(@)(@@) % وروت عن المجد الأثيل رواتها % % وتواترت عن صحة أخبارها % % 25(@)(@@) % فضل يسير بكل أرض ذكره % % وكذا النجوم أجلها سيارها % % 26(@)(@@) % وله التصانيف الحسان وإنها % % قد أسفرت عن فضله أسفارها % % 27(@)(@@) % هي كالرياض تفتحت أزهارها % % أو كالحسان تفككت أزرارها % % 28(@)(@@) % تبدي من الخفي ما يعيي الورى % % وتحير عند بروزها أفكارها % % 29(@)(@@) % لا زال خائض ليلها في ثاقب % % من فكرة حتى ستبان نهارها % % 30(@)(@@) % مصبوبة من لفظة بعبارة % % يحلو لسامع لفظها تكرارها % % PageV01P824 31(@)(@@) % % من مالك الارضون أو أقطارها % % 32(@)(@@) % قرت عيون الدين فيك وإنما % % حسأد فضلك 
ms264	 لا يقر قرارها % % 33(@)(@@) % راموا الوصول إلى سعاد سعودها % % فنأت بها عنهم وشط مزارها % % 34(@)(@@) % تختار لذات الكمال على الهوى % % تلك المشقة قل من يختارها % % 35(@)(@@) % فإذا نثرت فأنت أبلغ ناثر % نظام لؤلؤ حكمة نثارها % % 36(@)(@@) % وإذا نظمت فلا أبو تمامها % % تحكيك رقته ولا مهيارها % % 37(@)(@@) % ورسائل أين الصبا من لفظها % % الشافي وأين أريجها وعرارها % % 38(@)(@@) % خط كليلات السعود تراوحت % فيها بطيب نسيمها أسحارها % % 39(@)(@@) % هل تدري أي روية لك في الحجى % % ومن العجيب فديتك ستحضارها % % 40(@)(@@) % تأتي كسيل المزن حيث دعوتها % % وكجود كفك وافر مدرارها % % PageV01P825 41(@)(@@) % فلكم جلوت دجنة من مشكل % يتجاب فيك ظلامها وأوارها % % 42(@)(@@) % وجليت فيه من العلوم عرائسا % فأتاك من ملك الزمان نثارها % % 43(@)(@@) % قد زدت فيها رفعة وتواضعا % وأرى الرجال يشينها ستكبارها % % 44(@)(@@) % إن الرزانة في النفوس ولم تطش % % نفس وقار الراسيات وقارها % % 45(@)(@@) % إن كنت مفتخرا بلبس علامة % فعلاك ياشرف الوجود فخارها % % 46(@)(@@) % صيغت لعزك سيدي من جوهر % % حيث الجواهر أنت أنت بحارها % % 47(@)(@@) % فكأنما من صدرك ستخراجها % % أو من جمالك أشرقت أنوارها % % 48(@)(@@) % لا زال يأخذ بالنواظر نورها % % لكن بأحشاء الحواسد نارها % % 49(@)(@@) % إن العناية أقبلت بجميع ما % % تهوى عليك وهذه آثارها % % 50(@)(@@) % قتلت عداك بلوغها وكأنها % % قتلى العيون فليس يدرك ثارها % % PageV01P826 51(@)(@@) % وكفاك إقرار العداة بما به % % قر الولاة ولم يفد إنكارها % % 52(@)(@@) % ولقد خلقت سماء كل فضيلة % % طلعت على آفاقها أقمارها % % 53(@)(@@) % هل في العراق ومنعليه ومن له % % منها وليس لألفهم معشارها % % 54(@)(@@) % ولقد سترت على عوادي بلدة % % لولاك لم يستر وحقك عارها % % 55(@)(@@) % يا قطب دائرة الرئاسة والعلى % % أضحى يدور لأمره دوارها % % 56(@)(@@) % لحقت سوابقك الألى فسبقتهم % % بسوابق ما شق قط غبارها % % 57(@)(@@) % خذها تغيظ الحاسدين قصيدة % ما مل فيك أبا الثنا إكثارها % % 58(@)(@@) % لا زالت الأيام توليك المنى % % وجرت على ما تشتهي أقدارها % % PageV01P827 البحر : كامل تام 1(@)(@@) % عيدي بيوم شفائكم لسقامي % % إن تعطفوا يوما فذاك مرامي % % 2(@)(@@) % يا خلة أرعى ذمام ودادهم % % ولو نهم نقضوا عهود ذمامي % % 3(@)(@@) % رعيا 
ms265	 لأيام خلون بقربهم % % لم أسلها بتعاقب الأيام % % 4(@)(@@) % يا أيها الريان من ماء بها % % هل مورد لغليل قلبي الظامي % % 5(@)(@@) % فلقد طويت على هواك جوانحي % % وعصيت فيك ملامة اللوام % % 6(@)(@@) % ف ستبق من دنف الفؤاد بقية % لولاك ما ملك الزمان زماني % % 7(@)(@@) % فأخذت شعري أهبة الإحرام % % مقرونة بالرحب والإكرام % % 8(@)(@@) % حي الربوع النازلين بذي الغضا % % وسقيت ذاك الحي صوب غمام % % 9(@)(@@) % ظعنوا فما أبقوا لمسلوب الحشى % % إلا توقد لوعة وغرام % % 10(@)(@@) % من كل أحوى ما تلفت طرفه % % إلا ادكرت تلفت الآرام % % PageV01P828 11(@)(@@) % يا حادي الأظعان يزعجها النوى % % فتخد خد فدافد ومرامي % % 12(@)(@@) % بالله إن يممت ذياك الحمى % % بلغ أميم تحيتي وسلامي % % 13(@)(@@) % مذ غاب عن عيني نور شموسهم % % ما ذاقت الأجفان طيب منام % % 14(@)(@@) % ما للحمام أهاج لي برح الأسى % % هذا الحمام يروم جلب حمامي % % 15(@)(@@) % يتلو صبابات الهيام بوجده % % أترى هيام الورق مثل هيامي % % 16(@)(@@) % قم يا نديم وعاطنيها قرقفا % فالعيش بين منادم ومدام % % 17(@)(@@) % راح إذا لمعت بكأس خلتها % % برقا تألق من خلال غمام % % 18(@)(@@) % تتراقص الكاسات في إقبالها % % كتراقص الأرواح بالأجسام % % 19(@)(@@) % جمحت بنا خيل المسرة برهة % % والعيش كالغصن الرطيب النامي % % 20(@)(@@) % أيام مرجعها علينا منيتي % % إن المنى كوساوس الأحلام % % PageV01P829 21(@)(@@) % أمواعد الأجفان منه بزورة % ما كان ذاك المزن غير جهام % % 22(@)(@@) % ف شفع زيارتك التي قد زرتني % % والليل قد أرخى سدول ظلام % % 23(@)(@@) % لما ألم يميط لي سجف الدجى % % وفقدت في وجدانه آلامي % % 24(@)(@@) % ولكم يصد كأنه ريم الفلا % % ويصول صولة باسل مقدام % % 25(@)(@@) % ورمت لواحظه نصال صبابة % ها قد أصاب القلب ذاك الرامي % % 26(@)(@@) % غرو إن هام الفؤاد به جوى % إن الغرام موكل بهيامي % % 27(@)(@@) % أنى تصيدني الغزال فريسة % عهدي الغزال فريسة الضرغام % % 28(@)(@@) % أهوى على حب الجمال تغزلي % % وعلى مديح أبي الثناء نظامي % % 29(@)(@@) % مفتي العراقين الذي بعلومه % % قد فاخرت بغداد أرض الشام % % 30(@)(@@) % أين السحائب من مكارم أنمل % في المكرمات ينابع الإكرام % % PageV01P830 31(@)(@@) % إن شح هطال السحاب بغيثه % % فسحابه في كل وقت هامي 
ms266	 % % 32(@)(@@) % لا زال من لين العريكة باسما % كتبسم الأزهار بالأكمام % % 33(@)(@@) % يفتر في وجه المؤمل ثغره % % وكذا افترار البارق البسام % % 34(@)(@@) % ما بين منطقه العجيب وقلبه % % صدر يفيض ببحر علم طامي % % 35(@)(@@) % أحيا به الله الشريعة والهدى % % وأقام فيه شعائر الإسلام % % 36(@)(@@) % يجدي العباد بنانه وبيانه % % درين در ندى ودر كلام % % 37(@)(@@) % حكم على أهل العقول يبثها % % متقونة الأوضاع والأحكام % % 38(@)(@@) % ميريك في ألفاظه وكلامه % % سحر العقول وحيرة الأفهام % % 39(@)(@@) % كم أعربت ألفاظه عن حاله % % يوما فأعجم منطق الأعجام % % 40(@)(@@) % ولقد ادارا على الورى جام الحجى % % فالناس صرعى راح ذاك الجام % % PageV01P831 41(@)(@@) % من كل مكرمة وكل فضيلة % % قد حل منها في محل سامي % % 42(@)(@@) % تمت به حسن المعالي والعلى % % ومحاسن الأشياء بالإنمام % % 43(@)(@@) % من ذا يهني الوافدين بسيد % جبلت سجيته على الإكرام % % 44(@)(@@) % ويقول نائله لطالب فضله % % حييت بين أكارم وكرام % % 45(@)(@@) % ولرب رأي بالأمور مجرب % تغني مضاربه عن الصمصام % % 46(@)(@@) % قد الحوادث غارب من حده % % فكأنه في الخطب حد حسام % % 47(@)(@@) % والله ما فتك الكمي برمحه % % يوما كفتك يديه بالأقلام % % 48(@)(@@) % وطوئف لم يفحموا في مبحث % % ذاقت لديه مرارة الإفحام % % 49(@)(@@) % ببلاغة وبراعة قسية % وقعت على الأغبار وقع سهام % % 50(@)(@@) % إن يحسدوك الجاهلون على النهى % % لا تحسد الكرماء غير لئام % % PageV01P832 51(@)(@@) % ولقد تفاخر فيك سادات الورى % % أنت فتخار السادة الأعلام % % 52(@)(@@) % يا كعبة قد جئت أبغي حجها % % 53(@)(@@) % عام به للعيد وجهك عيده % % فليفتخر فيها على الأعوام % % 54(@)(@@) % لم أرض منك وإن بذلت جوائزا % لكن رضاؤك مطلبي ومرامي % % PageV01P833 البحر : طويل 1(@)(@@) % بوخز القنا والمرهفات البواتر % بلوغ المعالي واقتناء المفاخر % % 2(@)(@@) % وإن الفتى من لا يزال بنفسه % % يخوض غمار الموت غير محاذر % % 3(@)(@@) % يشيد له ما عاش مجدا مؤثلا % ويبقي له في الفخر ذكرا لذاكر % % 4(@)(@@) % إذا كنت ممن عظم الله شأنه % % فثمر ألى الأمر العظيم وبادر % % 5(@)(@@) % وإني امرؤ يأبى الهوان فلم يدن % % إلى حكم دهر يا أميمة جائر % % 6(@)(@@) % مضت مثل ماضي الشفرتين عزيمتي % % وحلق في جو الأبوة 
ms267	 طائري % % 7(@)(@@) % لئن أنكر الغمر الحسود فضائلي % % وأصبح بالمعروف أول كافر % % 8(@)(@@) % فتلك برغم الحاسدين شواردي % % يسير بها الساري وتلك نوادري % % 9(@)(@@) % فما عرفت مني مدى الدهر ريبة % ولا مر ما راب الرجال بخاطري % % 10(@)(@@) % وما زلت مذ شدت يدي عقد مئزري % % بعيد مناط الهم عف المآزر % % PageV01P834 11(@)(@@) % صفوت فلم أكدر على من يودني % % ولا يتقي من قد صحبت بوادري % % 12(@)(@@) % وكم مشمخر أنفه بغروره % % يرى نفسه في الجهل جم المآثر % % 13(@)(@@) % جدعت بحول الله مارن أنفه % وأوطأت نعلي منه هامة صاغر % % 14(@)(@@) % ألا ثكلت أم الجبان وليدها % % وفازت بما حازته أم المخاطر % % 15(@)(@@) % أحن إلى يوم عبوس عصبصب % % تتوق له نفسي حنين الأباعر % % 16(@)(@@) % إلى موقف بين الأسنة والظبا % % ومنزلة بين القنا المتشاجر % % 17(@)(@@) % يكثر فيه الموت عن حد نابه % % وتغدو المنايا داميات الأظافر % % 18(@)(@@) % ترفعت عن قوم إذا ما خبرتهم % % وجدت كبارا في صفات الأصاغر % % 19(@)(@@) % أخو الحزم من لم يملك الحرص رقه % % ولا ينتج الآمال من رحم عاقر % % 20(@)(@@) % شديد على حرب الزمان وسلمه % % جريء على الأخطار غير محاذر % % PageV01P835 21(@)(@@) % خلقت صبورا في الأمور ولم أكن % على الضيم في دار الهوان بصابر % % 22(@)(@@) % إذا ما رأيت الحي بالذل عيشه % % فأولى بذاك الحي أهل المقابر % % 23(@)(@@) % ألا إن عمر المرء ما عاش طوله % % كطيف خيال أو كزورة زائر % % 24(@)(@@) % تمر الليالي يا سعاد وتنقضي % % وتمضي بباق حيث كان وبائر % % 25(@)(@@) % فكيف يعاني الحر ما لا يسره % % ويأمن من ريب الزمان بغادر % % 26(@)(@@) % ومن يأمن الدنيا يكن مثل واقف % % على غرة بالموسيات الصواهر % % 27(@)(@@) % أزيد على رزء الحوادث قسوة % % وإن معاناتي بها غير ضائر % % 28(@)(@@) % كما فاح بالطيب الأريج وضوعت % % شذا المندلي الرطب نار المجامر % % 29(@)(@@) % أرانا سليمان الزهير وقومه % % رجال المنايا فتك أروع ظافر % % 30(@)(@@) % يريك بيوم الجود نعمة منعم % ويوم الوغى واليأس قدرة قادر % % PageV01P836 31(@)(@@) % يسير مواليه بعز وسؤدد % % ويرجع شاتيه بصفقة خاسر % % 32(@)(@@) % لقد ظفرت آل الزهير بشيخها % % بأشجع من ليث بخفان خادر % % 33(@)(@@) % يشق إلى 
ms268	 نيل المعالي غبارها % % ومن دونها إذ ذاك شق المرائر % % 34(@)(@@) % فذا سيفه الماضي فهل من مبارز % % وذا فخره العالي فهل من مفاخر % % 35(@)(@@) % ففي الحرب إن دارت رحاها وأصبحت % تدور على فرسانها بالدوائر % % 36(@)(@@) % تحف به من آل نجد عصابة % % شبيهة ما تأتي به بالقساور % % 37(@)(@@) % وكم برز الأعداء في حومة الوغى % % وثغر الردى يفتر عن ناب كاشر % % 38(@)(@@) % فأوردها بالمشرفية والقنا % % وارد حتف ما لها من مصادر % % 39(@)(@@) % وكم أنهل الوارد منهل جوده % فمن وارد تلك الأكف وصادر % % 40(@)(@@) % ألا إن أبناء الزهير بأسرهم % % أوائلهم متلوة بالأواخر % % PageV01P837 41(@)(@@) % سل الحرب عنهم والصوارم والقنا % % وما كان منهم في العصور الغوابر % % 42(@)(@@) % فهم شيدوها في صدورهم علي % وهم أورثوها كابرا بعد كابر % % 43(@)(@@) % أكابر يعطون الرئاسة حقها % % ومعروفهم يسدى لبر وفاخر % % 44(@)(@@) % وما برحت في كل مكرمة لهم % % مناقب تورى بين باد وحاضر % % 45(@)(@@) % قد ستودعت أخبار ما فتكت لهم % % صدور المعالي في بطون الدفاتر % % 46(@)(@@) % يمينا برب البيت والركن والصفا % % ومن فاز في تعظيم تلك المشاعر % % 47(@)(@@) % بأن سليمان الزهير محله % % محل سما فوق النجوم الزواهر % % 48(@)(@@) % يقر لعيني أن ترى منه طلعة % ترى العين فيها قرة للنواظر % % 49(@)(@@) % فأسمع منه ما يشنف مسمعي % % وأنظر فيه ما يروق لناظري % % 50(@)(@@) % كريم أكاسير الغنى بالتفاته % % فهل كان إلا وارثا علم جابر % % PageV01P838 51(@)(@@) % يصح مزاج المجد في رأي حاذق % % طيب بأدواء الرئاسة قاهر % % 52(@)(@@) % يمر بنادي الأكرمين ثناؤه % % كما مر نجدي النسيم بعاطر % % 53(@)(@@) % وقد نطقت في مدحه ألسن الورى % % فمن ناظم فيه الثناء وناثر % % 54(@)(@@) % أحامي الحمى بالبأس ما ينوبه % % وصنديدها المعروف بين العشائر % % 55(@)(@@) % إليك من الداعي لك الله مدحة % % مقدمة من حامد لك شاكر % % 56(@)(@@) % فلا زلت في رزق الأسنة تحتمي % % وتحمي بحد البيض سود الغدائر % % PageV01P839 البحر : وافر تام 1(@)(@@) % تبارك من يراك ابن المبارك % وزادك من مواهبه وبارك % 2(@)(@@) % مكانة رفعة وعلو قدر % يزيد به علاءك واقتدارك % % 3(@)(@@) % وأبقاك الإل ه غمام جود % لمن يظما فيستسقي قطارك % % 4 
ms269	(@)(@@) % رأيتك مورد الآمال طرا % فها أنا لم أرد إلا بحارك % % 5(@)(@@) % تهين نفائس الأموال بذلا % ولم تعبأ بها وتعز جارك % % 6(@)(@@) % حماك هو الحمى مما يحاشى % % تجير من الخطوب من استجارك % % 7(@)(@@) % وإنك صفوة النجباء فينا % % وإنك خيرة لمن استخارك % % 8(@)(@@) % نشأت بطاعة المولى منيبا % وتقوى الله ما برحت شعارك % % 9(@)(@@) % تجنبك التي تأبى تقاة % % عقدت على العفاف بها إزارك % % 10(@)(@@) % تعير البدر من محياك حسنا % كأن البدر طلعته استعارك % % PageV01P840 11(@)(@@) % أخذت بصالح الأعمال تقضي % % بأمر الله ليلك أو نهارك % % 12(@)(@@) % مجيبا من دعاك ولا أناة % % أثارك للمكارم من أثارك % % 13(@)(@@) % ولا لحقتك يوم سبقت نجب % بمكرمة ولا شقت غبارك % % 14(@)(@@) % أغرت على الثناء من البرايا % % وقد أبعدت يومئذ منارك % % 15(@)(@@) % لقد طابت بفضلك و ستقرت % % بك الأرض التي كانت قرارك % % 16(@)(@@) % وحق لها إذا فخرت وباهت % % ديار رحت توليها فتخارك % % 17(@)(@@) % سماحك لا يزال لمستميح % % من العافين جاهك واعتبارك % % 18(@)(@@) % وإنك دوحة بسقت وطالت % % جنى الجانون يانعة ثمارك % % 19(@)(@@) % يشارك كل ذي مجد بمجد % % ومجدك في الحقيقة لا يشارك % % 20(@)(@@) % ودهر قد جنى ذنبا عظيما % فلما قيل هل تلقي اعتذارك % % PageV01P841 21(@)(@@) % تدارك ذنبه بعلاك حتى % % غفرنا ذنبه فيما تدارك % % 22(@)(@@) % وإن أبا الخصيب يروق عندي % % لأنك فيه قد شيدت دارك % % 23(@)(@@) % أزورك سيدي في كل عام % % فلا أنأى عن الداعي مزارك % % 24(@)(@@) % وإني قد ترقبت الغوادي % % ووابلها ترقبت أزديارك % % 25(@)(@@) % شهدت مشاهد النعماء فيها % % فلا شاهدت في الدنيا بوارك % % PageV01P842 البحر : وافر تام 1(@)(@@) % هلم بنا نزور أبا الخصيب % ونرعى جانب العيش الخصيب % 2(@)(@@) % نعاشر أهله ونقيم فيه % % بخفض العيش من حسن وطيب % % 3(@)(@@) % كرام قد نزلت بهم غريبا % فكانوا سلوة الرجل الغريب % % 4(@)(@@) % وعبد الواحد الموصوف فيهم % % بطول الباع والصدر الرحيب % % 5(@)(@@) % هو الشهم الذي لا عيب فيه % % سوى العرض النقي من العيوب % % 6(@)(@@) % لقد تقنا إلى ذاك المحيا % % ولا توق المحب إلى الحبيب % % 7(@)(@@) % فحي ابن المبارك من كريم % % أحب إلى القلوب من القلوب % % 8(@)(@@) % يرى فعل الجميل 
ms270	 عليه فرضا % وصنع المكرمات من الوجوب % % 9(@)(@@) % نصيب بفضله الأغراض منه % % ونرجع عنه في أوفى نصيب % % 10(@)(@@) % حكى إحسانه صوب الغوادي % % فقلنا ديمة القطر الصبيب % % PageV01P843 11(@)(@@) % إذا المستصرخون دعوه يوما % فقد أمنت بكشاف الكروب % % 12(@)(@@) % وإن أبصرت منه البشر يبدو % % فأبشر منه بالفرج القريب % % 13(@)(@@) % يلذ لدى سؤال ندى يديه % % فيثني عطف مرتاح طروب % % 14(@)(@@) % ومبتسم بوجه الضيف زاه % % ووجه الدهر مشتد القطوب % % 15(@)(@@) % أجل عصابة كرمت وجادت % % على العافين في اليوم العصيب % % 16(@)(@@) % كريم قد تفرع من كريم % % نجيب ينتمي لأب نجيب % % 17(@)(@@) % رأيت الأكرمين على ضروب % % وهذا خير هاتيك الضروب % % 18(@)(@@) % وقدر ما ستخفته الرزايا % % ولا راعته قارعة الخطوب % % 19(@)(@@) % ولا استهوته نفس في هوان % ولم يدن إلى أدنى معيب % % 20(@)(@@) % منار يستمد الرأي منه % % وعنه رمية السهم المصيب % % PageV01P844 21(@)(@@) % فأشهد أنه فرد المعالي % % وما أنا منه في شك مريب % % 22(@)(@@) % عليه ذوو العقول إذن عيال % وها هو إربة الفطن الأريب % % 23(@)(@@) % فتعرض رأيها أبدا عليه % % كما عرض المريض على الطبيب % % 24(@)(@@) % فداك الباخلون وهم كثير % فداء النحر من بدن ونيب % % 25(@)(@@) % بيوم عنده الإنفاق فيه % % أشد على الجبان من الحروب % % 26(@)(@@) % ولا أفلت كواكبك الزواهي % % ولا أذنت شموسك للغروب % % PageV01P845 البحر : طويل 1(@)(@@) % بلغتم كمال الرشد أبناء راشد % فبوركتم أولاد أكرم والد % 2(@)(@@) % إذا ما دعيتم دعوة المجد كلها % % أقمتم على دعواكم ألف شاهد % % 3(@)(@@) % وقمتم إليها رتبة تبتغونها % % فما قائم يبغي العلاء كقاعد % % 4(@)(@@) % على أنها فيكم لديكم وراثة % وما هي في زيد وبكر وخالد % % 5(@)(@@) % كنزتم من الفعل الجميل صنائعا % وقد تنفد الدنيا وليس بنافد % % 6(@)(@@) % وما زالت الدنيا بحسن صنيعكم % % مقلدة أعناقها بالقلائد % % 7(@)(@@) % أردتم صلاح الناس بعد فسادها % % وبالصارم الهندي إصلاح فاسد % % 8(@)(@@) % فأججتم نارا تسعر جمرها % % ولكن بحد المرهفات البوارد % % 9(@)(@@) % تسلونها في الخطب في كل شدة % ألا إنها معروفة بالشدائد % % 10(@)(@@) % وما فات قصد من جسور الرعية بينهم % % وقد أوسع الطغيان خرق المفاسد % % PageV01P846 11(@)(@@) % وقلمت أظفار الطغاة وسستهم % % بأبيض حاد الزيغ عن 
ms271	 كل حاسد % % 12(@)(@@) % ولولاك ظلت في المجرة أهلها % % تناش بأيدي اللوى قلب الأوابد % % 13(@)(@@) % أعدت لنا أيام فهد وبندر % ومن قلبها أيام عيسى وماجد % % 14(@)(@@) % وأضحكت سن المجد بعد بكائه % % طويلا على أجداث تلك الأماجد % % 15(@)(@@) % ومن بعد ما كانت أمور وأقلعت % تذوب لها إذ ذاك صم الجلامد % % 16(@)(@@) % إذا ذكرت ثار الغرام وهيجت % كوامن نيران القلوب الخوامد % % 17(@)(@@) % وهل يفلح القوم الذين تسوسهم % % بنو الجهل في عار من الحلم فاقد % % 18(@)(@@) % وما كل من ساس الرعية ساسها % % ولا كل من قاد الجيوش بقائد % % 19(@)(@@) % توليتها والطعن بالطعن يلتقي % % وأخذ المنايا واحدا بعد واحد % % 20(@)(@@) % فما بين مقتول وما بين قاتل % % وما بين مطرود وما بين طارد % % PageV01P847 21(@)(@@) % وقد نزغ الشيطان إذ ذاك بينهم % % إذ الناس فوضى لا تدين لواحد % % 22(@)(@@) % فأرشدتهم للخير حتى تركتهم % % يقولون إن الرشد فعل بن راشد % % 23(@)(@@) % عفوت بها عما جنى ذو قرابة % % رماك بسهم القطع رمي الأباعد % % 24(@)(@@) % ورحت وما في صدرك الحقد كامن % % على حاقد جهلا عليك وواجد % % 25(@)(@@) % وقلت لمن يطوي على المكر كشحه % % دع الزيف لا تنفقه في سوق ناقد % % 26(@)(@@) % وما ساد في قوم حقود عليهم % % ولا حيزت النعماء يوما لحاسد % % 27(@)(@@) % فأسهرت عين الخط والخط ساهر % % وما أنت عن ثار العدو براقد % % 28(@)(@@) % أخو الحزم من يخشى شماتة كاشح % ولا زال مشحوذا غرار الحدائد % % 29(@)(@@) % ولا يطأ الأرض الفسيحة بقعة % إذا اتصلت فيها حبال المكائد % % 30(@)(@@) % لك الله منصور لك الله ناصر % وحسبك من حزب معين مساعد % % PageV01P848 31(@)(@@) % وثبت وثوب الليث تستفرس المنى % % وما كنت عنها منذ كنت بلابد % % 32(@)(@@) % وساعدك المقدور فيها وربما % % سعى قبل ما تسعى لنيل المقاصد % % 33(@)(@@) % ومن لم تساعده العناية لم يكن % % له ساعد يشتد عن لين ساعد % % 34(@)(@@) % لقد صلت حتى كان أول قائم % % لسيفك يوم الروع أول ساجد % % 35(@)(@@) % وجدت وأعطيت المكارم حقها % % برغم على أنف الحسود المعاند % % 36(@)(@@) % فأرغمت آنافا وأكبت حسدا % فأكرم وصل واقطع وقرب وباعد % % 37(@)(@@) % وما فيكم إلا 
ms272	 طموح إلى العلى % % جموح إلى مجد طريف وتالد % % 38(@)(@@) % عقائدنا فيكم كما تشتهونها % % وكل بكم منا صحيح العقائد % % 39(@)(@@) % فلم نر في إحسانكم غير شاكر % % ملي بما يملي لسان المحامد % % 40(@)(@@) % عرفناكم فيمن سواكم وهكذا % % يكون امتياز الشيء عند التضادد % % PageV01P849 41(@)(@@) % ومن جرب الأيام والناس غيركم % % رنا نحوهم لكن بناظر زاهد % % 42(@)(@@) % وإنك ممن يشفع البأس بالندى % % ويقبل با لبشرى على كل وافد % % 43(@)(@@) % وقد كان تأسيس الوائل فيكم % % فشيدوا على تأسيس تلك القواعد % % 44(@)(@@) % لئن كنت أفنيت الحطام فإنما % % حظيت على بيت من الذكر خالد % % 45(@)(@@) % وعدت بك الجدوى إذا زرت والغنى % % ولم يخلف الميعاد نوء العوائد % % 46(@)(@@) % فزرت فحيى الله طلعة زائر % % تعود على وفادها بالفوائد % % 47(@)(@@) % وأقبلت إقبال الغمام ببارق % % توليت إصلاح الرعية بينهم % % 48(@)(@@) % فما حتجت بعد السيل شرعة وارد % % ولا احتجت بعد الروض ندى لرائد % % 49(@)(@@) % بلغت بك الآمال حتى كفيتني % % ركوب المطايا واجتناب الفدافد % % 50(@)(@@) % ويا رب يوم مثل وجهك ضاحك % عرضنا على علياك غر القصائد % % PageV01P850 51(@)(@@) % وأما نداك العذب ما إن وردته % % على كبدي الحرى فأعذب بارد % % 52(@)(@@) % ملكتم على أمري فؤادي ومقولي % % وأصبح فيكم غائبي مثل شاهدي % % 53(@)(@@) % رفعتم مناري بعد خفض ورشتم % جناحي واملأتم فمي بالغرائد % % 54(@)(@@) % وأطلقتموني من وثاق خصاصة % % فلا غرو إن قيدت فيكم شواردي % % PageV01P851 البحر : سريع 1(@)(@@) % غير وجه الجو في حمرة % كأنما توقد بالجو نار % 2(@)(@@) % وأعقبتها ظلمة أيقنت % أنفسنا من أجلها بالبوار % % 3(@)(@@) % حتى عن الشمس وأضوائها % % بذلك التاريخ حال الغبار % % PageV01P852 البحر : وافر تام 1(@)(@@) % سقانيها معتقة عقارا % وقد ألقت يد الفجر الإزارا % % 2(@)(@@) % ودار بها مشعشعة علينا % % فدار الأنس فينا حيث دارا % % 3(@)(@@) % إذا ما زفها الساقي بليل % أعاد الليل حينئذ نهارا % % 4(@)(@@) % تشق حشاشة الظلماء كأس % كما أوقدت في الظلماء نارا % % 5(@)(@@) % جلاها في الكؤوس لنا عروسا % وقد جعل الجمان لها نثارا % % 6(@)(@@) % يتوجها الحباب بتاج كسرى % % إذا مزجت ويلبسها سوارا % % 7(@)(@@) % فقبل المزج تحسبها عقيقا % وبعد المزج تحسبها نضارا % % 8(@)(@@) % جلاها فانجلت عنا 
ms273	 هموم % % وفرت كلما جلبت فرارا % % 9(@)(@@) % فأدركت الندامى بالحميا % % من الهم الذي في القلب ثارا % % 10(@)(@@) % وكم من لذة بكميت راح % % أغرناها فأبعدنا المفارا % % PageV01P853 11(@)(@@) % ويعذرني الشباب على التصابي % % بصبوة مغرم خلع العذارا % % 12(@)(@@) % وما أهنا المدام بكف ساق % % كمثل البدر أشرق و ستنارا % % 13(@)(@@) % بروحي ذلك الرشأ المفدى % % وإن ألف التجنب والنفارا % % 14(@)(@@) % وأين الضبي من لفتات أحوى % % يضاهيه التفاتا واحورارا % % 15(@)(@@) % رنا فأصاب بالألحاظ منا % % فؤادا بالصبابة مستطارا % % 16(@)(@@) % مليح ما تصبر في هواه % % محب لم يجد عنه اصطبارا % % 17(@)(@@) % وما أنسى غداة الشرب أمست % % بناظره وريقته سكارى % % 18(@)(@@) % ألا يا ممرضي بسقام طرف % % أصاب من الحشا جرحا جبارا % % 19(@)(@@) % فؤادى مثل طرفك بانكسار % فكل يشتكي منك نكسارا % % 20(@)(@@) % غرامي في هواك بلا ختياري % % وما كان الهوى إلا اضطرارا % % PageV01P854 21(@)(@@) % مضى وتصرمت تلك التصابي % % فإن عاد الصبا عاد ادكارا % % 22(@)(@@) % فوا لهفي على أوقات لهو % % قضيناها وإن كانت قصارا % % 23(@)(@@) % تركت الشعر لما ألبستني % % من الأكدار أيامي شعارا % % 24(@)(@@) % ولولا مدح مولانا علي % لما جدت النظام ولا النثارا % % 25(@)(@@) % أجل السادة الأشراف قدرا % وأرفعهم وأطيبهم نجارا % % 26(@)(@@) % وأرأفهم على الملهوف قلبا % وأسرعهم إلى الحسنى بدارا % % 27(@)(@@) % جواد في الأكارم لا يبارى % % وبحر في المكارم لا يجارى % % 28(@)(@@) % إذا نظر الكبار إلى علاه % % رأت في المجد أنفسها صغارا % % 29(@)(@@) % وقد سبق الأعالي في المعالي % % فما لحقت له فيها غبارا % % 30(@)(@@) % وساجله السحاب فكان أندى % % يدا منها وأعظمها قطارا % % PageV01P855 31(@)(@@) % وكم عام منعنا القطر فيه % % فأمطرنا لجينا أو نضارا % % 32(@)(@@) % وكم شاهدت في الأيام عسرا % ولذت به فشاهدت اليسارا % % 33(@)(@@) % لنا في فضله غرس الأماني % % جنيناها بدولته ثمارا % % 34(@)(@@) % وكم أكرومة عذراء بكر % يجيىء بها إلى الناس ابتكارا % % 35(@)(@@) % يهين أعز ما ملكت يداه % % بوافر نيله ويعز جارا % % 36(@)(@@) % ألستم في الحقيقة آل بيت % % علوا جودا وفضلا واقتدارا % % 37(@)(@@) % عليكم تنزل الآيات قدما % فحسبكم بذالكم افتخارا % % 38(@)(@@) % أقمتم ركن هذا الدين فيها % % وأوضحتم لطالبه المنارا % % 39(@)(@@) % جزيتم عن جميع الناس 
ms274	 حيرا % وما زلتم من الناس الخيارا % % 40(@)(@@) % بنفسي منك قرما هاشميا % يجير من الخطوب من ستجارا % % PageV01P856 41(@)(@@) % تقد حوادث الأيام قدا % فأنت السيف بل أمضى شفارا % % 42(@)(@@) % بسر نداك قام الشعر فينا % % فأثنينا عليك به جهارا % % 43(@)(@@) % نقلد من مناقبك القوافي % % بأحسن ما تقلدت العذارى % % 44(@)(@@) % لبست من الثناء عليك حليا % لعمرك لن يباع ولن يعارا % % 45(@)(@@) % يضوع شميمه في كل ناد % كما نشرت صبا نجد عرارا % % 46(@)(@@) % فلا زالت لك الأيام عيدا % ولا شاهدت في الدنيا بوارا % % PageV01P857 البحر : وافر تام 1(@)(@@) % أقول ليوسف والمطل ظلم % أما لي حصة في ماء وردك % 2(@)(@@) % وإنك قد وعدت به قفل لي % % متى يا سيدي إنجاز وعدك % PageV01P858 البحر : وافر تام 1(@)(@@) % رآها قد أضر بها الكلال % % وقد ساءت لها ياسعد حال % % 2(@)(@@) % فذكرها شميم عرار نجد % ولا سيما إذا هبت شمال % % 3(@)(@@) % فحركها وأين لها بنجد % % لهيب الشوق والدمع المذال % 4(@)(@@) % وقد كانت كأن بها عقالا % فأطلقها وليس بها عقال % 5(@)(@@) % ولولا النازلون هضاب نجد % تحاماها الضنى والاختلال % % 6(@)(@@) % تخال الدمع سابقها عليهم % % فكيف تسابق المزن الرؤال % % 7(@)(@@) % يحملها الهوى عبئا ثقيلا % وللأشجان أعباء ثقال % % 8(@)(@@) % ويقذفها النوى في كل فج % لها فيه انسياب وانثيال % % 9(@)(@@) % تمد به فيقصر في خطاها % % من البيداء أبواع طوال % % 10(@)(@@) % تشيم البرق يومئذ سناه % % كعضب القين أرهقه الصقال % % PageV01P859 11(@)(@@) % وما أدري أهاج النوق منه % % غرام حين أومض أم خيال % % 12(@)(@@) % شديد وجدها والوصل دان % فكيف بها وقد منع الوصال % % 13(@)(@@) % ذكرنا عهد ربعك يا سليمى % % وعقد الدمع يوهيه نحلال % % 14(@)(@@) % منازل للهوى ما لي أراها % % كطرفي لا يلم بها خيال % % 15(@)(@@) % مباديها المسرة والتهاني % % وغايتها التغابن والوبال % % 16(@)(@@) % وكانت بهجة الأبصار حتى % % أحالتها من الحدثان حال % % 17(@)(@@) % سألتك أين عيشك بالأوالي % % وما يغني التفحص والسؤال % % 18(@)(@@) % غداة الشيح نبتك والخزامى % % حمتها البيض والأسل الطوال % % 19(@)(@@) % وتسنح في عراصك قبل هذا % % من السرب الغزالة والغزال % % 20(@)(@@) % وتطلع من خيامك مشرقات % % بدور من أسرتها الكمال % PageV01P860 21(@)(@@) % وكل مهفهف تثني 
ms275	 عليه % % معاطفه ويثنيه دلال % % 22(@)(@@) % رماة من حواجبها قسي % تراش لها من الحدق النبال % % 23(@)(@@) % ومن لي أن ترى عيني سناها % % فتنعم أعين ويراح بال % % 24(@)(@@) % تنافرت المها فوجدت قلبي % % يجد به للحي ارتحال % % 25(@)(@@) % وهاتيك الركايب أرقلتها % % ظباء قد أقلتها الجمال % % 26(@)(@@) % وكم صانت أكلتها وجوها % عليها مهجتي أبدا تذال % % 27(@)(@@) % فمالوا بالأباعر لا إلينا % % ومال بنا الهوى من حيث مالوا % % 28(@)(@@) % أعيذك من حشا تذكو لظاها % % وهم داؤه الداء العضال % % 29(@)(@@) % أحبتك الذذين شقيت فيهم % % أسالوا من دموعك ما أسالوا % % 30(@)(@@) % لنيران الجوى يا ناق عندي % % على البعد اتقاد واشتعال % % PageV01P861 31(@)(@@) % أعلل بالأماني ، والأماني % % أمور من زخارفها المحال % % 32(@)(@@) % سراب لا يبل به غليل % % ولا فيه لوارده بلال % % 33(@)(@@) % وحسبك إن وردت أبا جميل % % جميل ما يروقك أو جمال % % 34(@)(@@) % ردي من سيبه عذبا زلالا % فثم المورد العذب الزلال % % 35(@)(@@) % تناخ ببابه الامال طرا % وتملأ من مواهبه الرحال % % 36(@)(@@) % تعظمه الخطوب ويزدريها % % وليس له بمعظمها حتفال % % 37(@)(@@) % وينهض من أبوته بعبء % % قليل ما تنوء به الرجال % % 38(@)(@@) % من الشم الشوامخ في المعالي % % بطول الراسيات ولا يطال % % 39(@)(@@) % ويوقره إذا طاشت رجال % % حلوم لا تضاهيها الجبال % % 40(@)(@@) % صقيل مضارب العزمات ماض % فلا فلت مضاربه الصقال % % PageV01P862 41(@)(@@) % قوام الدين والدنيا جميعا % شفاؤهما إذا كان عتلال % % 42(@)(@@) % أظلتنا غمامته بظل % إذا لفح الهجير به ظلال % % 43(@)(@@) % ويوم مشمس فيه مضيء % فشمس ما لمطلعها زوال % 44(@)(@@) % وليل فيه أقمر مستنيرا % على وجنات هذا الدهر خال % % 45(@)(@@) % ينفس كل كاربة بكر % لدى يوم يضيق به المجال % % 46(@)(@@) % سماء من سماوات المعالي % % كواكبها المناقب والخصال % % 47(@)(@@) % فعال تسبق الأقوال منه % % وأقوال تقدمها الفعال % % 48(@)(@@) % يريك مداده في يوم جود % % لأحداق النوال به اكتحال % % 49(@)(@@) % ومن كلماته ما قيل فيها % % هي السلسال والسحر الحلال % % 50(@)(@@) % لساني في مدائحه صدوق % % بصدق فيه مني ما يقال % % PageV01P863 51(@)(@@) % إذا أسدى إلي المال أمست % تمال لي القلوب وتستمال % % 52(@)(@@) % فلي من ماله شرف وجاه % % ولي من جاهه عز ومال 
ms276	 % % 53(@)(@@) % قريب النيل ممتنع المعالي % % ومدني النيل ما بعد المنال % % 54(@)(@@) % تحطك رأفة شملت ورقت % وترفعك الأبوة والجلال % % 55(@)(@@) % عزيز النفس عز على البرايا % % نظيرك في الأماجد والمثال % % 56(@)(@@) % كأنك بين أقام سراة % هدى ما بعده إلا الضلال % % 57(@)(@@) % وإني قد رأيت علاك منهم % % مرام قد يرام ولا ينال % % 58(@)(@@) % وليس لهم وإن دفعوا % % مناقبك الشريفة والخلال % % 59(@)(@@) % خليقتك المروءة حيث كانت % % وشيمتك السماحة والنوال % % 60(@)(@@) % وهل أخشى من الحظ انفصالا % ولي من قرب حضرتك اتصال % % PageV01P864 61(@)(@@) % تلذ لك المكارم والعطايا % % وتطربك الشجاعة والنزال % % 62(@)(@@) % ولست من الكرام كبعض قوم % % يجود بماله حتى يقال % 63(@)(@@) % فيا جبلا أطل من المعالي % % علينا لا تزول ولا تزال % % 64(@)(@@) % هبات منك للعافين تترى % % ولا وعد لديك ولا مطال % % PageV01P865 البحر : وافر تام 1(@)(@@) % شديد ما أضر بها الغرام % وأضناها لشقوتها السقام % 2(@)(@@) % وما نفروت بصبوتها ولكن % كذلكم المحب المستهام % % 3(@)(@@) % تشاكينا الهوى زمنا طويلا % فأدمعنا وأدمعها سجام % % 4(@)(@@) % قريبة ما تذوب على طلول % % عفت حتى معاليها رمام % % 5(@)(@@) % سقى الله الديار حيا كدمعي % % لها فيها انسكاب وانسجام % % 6(@)(@@) % وبات الغيث منهلا عليها % % تسيل به الأباطح والأكام % % 7(@)(@@) % حسبت بها المطي فقال صحبي % % أضر بهذه النوق المقام % 8(@)(@@) % وبرح بالنياق نوى شطون % وأشجان تراش لها سهام % % 9(@)(@@) % فلا رندا تشم ولا تماما % وأين الرند منها والثمام % % 10(@)(@@) % مفارقة أحبتها بنجد % % عليك الصبر يومئذ حرام % % PageV01P866 11(@)(@@) % تقر لأعيني تلك المغاني % % وهاتيك المنازل والخيام % % 12(@)(@@) % إذا ذكرت لنا فاضت عيون % % وأضرم مهجة الصب الضرام % % 13(@)(@@) % لعمرك يا أميمة إن طرفي % % على العبرات أوقفه الغرام % % 14(@)(@@) % أشيم البرق يبكيني ابتساما % وقد يبكي الشجي الابتسام % % 15(@)(@@) % تبسم ضاحكا فكأن سعدى % % فليس بغيره فتخر الأنام % % 16(@)(@@) % يلوح فينجلي طورا ويخفى % % كما جليت مضاربه الحسام % % 17(@)(@@) % أما وهواك يمنحني سقامي % % ومنك البرء أجمع والسقام % % 18(@)(@@) % لقد بلغ الهوى مني مناه % % ولم يبلغ مآربه الملام % % 19(@)(@@) % على الأحداق لا بيض حداد % يشق بها حشى ويقد هام % % 20(@)(@@) % سلي السمر المثقفة العوالي % % أتفتك 
ms277	 مثل ما فتك القوام % % PageV01P867 21(@)(@@) % أبيت أرعى النجم فيه % % بطرف لا يلم به منام % % 22(@)(@@) % يذكرني حمام الأيك إلفا % ألا لا فارق الإلف الحمام % 23(@)(@@) % وهاتفة إذا هتفت بشجوي % % أقول لها ومثلك لا يلام % % 24(@)(@@) % فنوحي ما بدا لك أن تنوحي % % فلا عيب عليك ولا منام % % 25(@)(@@) % بذلت لباخل في الحب نفسي % % ولذ لي الصبابة والهيام % % 26(@)(@@) % منعت رضابه حرصا عليه % % ففاض الري واتقد الأوام % % 27(@)(@@) % وفي طي الجوانح لو نشرنا % % بها المطوي طال لنا كلام % % 28(@)(@@) % أرى الأيام أولها عناء % وعقباها إذا نقرضت أثام % % 29(@)(@@) % عناء إن تأملها لبيب % وما يشقى بها إلا الكرام % % 30(@)(@@) % لذاك الأكرمون تزاد عنها % % فتمنها ويعطاها اللئام % % PageV01P868 31(@)(@@) % نزلنا من جميل أبي جميل % % بحيث القصد يبلغ والمرام % % 32(@)(@@) % فثم العروة الوثقى وإنا % % لنا بالعروة الوثقى عتصام % % 33(@)(@@) % إذا نزل المروع لديه أمسى % % يضيم به الخطوب ولا يضام % % 34(@)(@@) % جواد لا يجود به زمان % ولا يستنتج الدهر العقام % % 35(@)(@@) % أشيم بروقه في كل يومم % وما كل بوارقه تشام % % 36(@)(@@) % إذا افتخر الأنام على النسق الأعالي % % فذاك البدء فيه والختام % % 37(@)(@@) % تيقظ للمكارم والعطايا % % وأعين غيره عنها نيام % % 38(@)(@@) % مكانك من عرانين المعالي % % مكان لا ينال ولا يرام % % 39(@)(@@) % وما جود الروائح والغوادي % % فإن الجود جودك والسلام % % 40(@)(@@) % بنفسي من لدى حرب وسلم % هو الضرغام والقرم الهمام % % PageV01P869 41(@)(@@) % تراع به ألوف وهو فرد % وليس يروعه العدد اللهام % % 42(@)(@@) % ومن عظمت له في المجد نفس % أهينت عنده الخطط العظام % % 43(@)(@@) % صدوع ما هنالك والتئام % % وما ضلت وأنت لها إمام % % 44(@)(@@) % كأنك في بني الدنيا أبوها % % وراع أنت والدنيا سوام % % 45(@)(@@) % إذا فتخر الأنام وكان فيهم % % محل الأمن والبلد الحرام % % 46(@)(@@) % لكل في جماك له طواف % وتقبيل لكفك واستلام % % 47(@)(@@) % تعود بوجهك الظلماء صبحا % ويستسقى بطلعتك الغمام % % 48(@)(@@) % ويشرق من جمالك كل فج % كما قد أشرق البدر التمام % % 49(@)(@@) % فداؤك من عرفت وأنت تدري % % فخير من حياتهم الحمام % % 50(@)(@@) % أناس حاولوا ما أنت فيه % % وما سلكوا طريقك واستقاموا 
ms278	 % % PageV01P870 51(@)(@@) % لقد تخلوا وجدت وأنت فينا % % كما نهلت عزاليه الركام % % 52(@)(@@) % وما كل بمندور ببخل % ولا كل على بخل يلام % % 53(@)(@@) % تميل بنا بمدحتك القوافي % % كما مالت بشاربها المدام % % 54(@)(@@) % ولولا أنت تنفقها لكانت % بوائر لا تباع ولا تسام % % 55(@)(@@) % نزورك سيدي في كل عام % إذا ما مر عام جاء عام % % 56(@)(@@) % تخبر أننا ولأنت أدرى % % صيام منذ وافانا الصيام % % PageV01P871 البحر : رمل تام 1(@)(@@) % لهذي النوق تنحط كلالا % % وتجوب البيد حلا و رتحالا % % 2(@)(@@) % نحلت حتى نبرت أعظمها % % والهوى ينقب أهليه نكالا % % 3(@)(@@) % كلما شامت سنا من بارق % % قذفت لوعتها دمعا مذالا % % 4(@)(@@) % أصبحت تفري فيافيها سرى % وتحاكي ب قتحام لآل رالا % % 5(@)(@@) % فترفق أيها الحادي بها % % فلقد أورثها الوجد خبالا % % 6(@)(@@) % لست أنسى وقفة في رامة % % لم يدع منها النوى إلا خيالا % % 7(@)(@@) % ووشت عن كل صب عبرة % فكفت عبرته الواشي المقالا % % 8(@)(@@) % وأساة لحشى مكلومة % جرحتها حذق الغيد نصالا % % 9(@)(@@) % يا مهاة الجزع أنتن له % % سالبات قلبه المضنى جمالا % % 10(@)(@@) % يا أخلائي تناءى زمن % % مر لي فيكم وصالا وانفصالا % % PageV01P872 11(@)(@@) % وليال ما احتلى أنسها % % أصبحت في وجنة الأيام خسالا % % 12(@)(@@) % نقل الواشي إليكم خبرا % لم يكن يقبل ما قال احتمالا % % 13(@)(@@) % يتمنى سلوتي لكنه % % يتمنى وأبي أرما محالا % % 14(@)(@@) % لا تلمني لائمي في صبوتي % % فالهوى ما زال للعقل عقالا % % 15(@)(@@) % فاتركاني والهوى إني فتى % غالني دونكم الوجد اغتيالا % % 16(@)(@@) % من ظباء الرمل ظبي إن رنا % % سل من جفنيه صمصاما وصالا % % 17(@)(@@) % ظبية الخدر التي لما جفت % % أدلالا كان منها أم ملالا % % 18(@)(@@) % هل وفت مديونها مستغرما % يشتكي منها وإن أوفت مطالا % % 19(@)(@@) % لو أباحتني جنى مرشفها % % لشفت من ريقها الداء العضالا % % 20(@)(@@) % يا رعى الله نزولا بالحمى % % عثرة المغرم فيهم لن تقالا % % PageV01P873 21(@)(@@) % حللوا ظلما حراما مثلما % % حرموا في شرعهم شيئا حلالا % % 22(@)(@@) % فاصطبر يا قلب يوما ربما % % أصبح الخلب بعد اليأس خالا % % 23(@)(@@) % كم يريني الدهر جدا هازلا % فأريه من ظبا عزمي جدالا % % 24(@)(@@) % إن يكن في 
ms279	 الناس محمود فلا % % غير محمود مقالا وفعالا % % 25(@)(@@) % فتفاءل ب سمه في سيبه % % ف سمه كان لمن يرجوه فالا % % 26(@)(@@) % إن تحاول شخصه تلق على % صحب العز يمينا وشمالا % % 27(@)(@@) % لا يرجى غيره في شدة % أو ترجو بوجود البحر لا % % 28(@)(@@) % ليث غاب وسحاب صيب % حيث تلقاه نوالا ونزالا % % 29(@)(@@) % كرم يخجا هتان الحيا % % وعلى تورث أعداه الوبالا % % 30(@)(@@) % ويد ما نقبضت عن سائل % % بل كفت في سيبها العافي السؤالا % % PageV01P874 31(@)(@@) % صارم الله الذي لم يخش من % % حادث الدهر انثلاما وانفلالا % % 32(@)(@@) % ولكم أجدى فأسدى كرما % مننا طوق فيهن الرجالا % % 33(@)(@@) % صنعته المعروف مغروز به % % لا يجود الجود حتى أن يقالا % % 34(@)(@@) % كم وردنا فضله من مورد % فوجدناه نميرا وزلالا % % 35(@)(@@) % منح الله به يا حبذا % % منح من جانب الله تعالى % % 36(@)(@@) % قل لحساد معاليه اقصروا % % لم تزل أيديه في المجد طوالا % % 37(@)(@@) % يتمنون مع العجز العلى % % وإذا قاموا لها قاموا كسالى % % 38(@)(@@) % ليس من يذخر جميلا في الورى % % كالذي يذخر للأخطار مالا % % 39(@)(@@) % لا ولا من صلبت راحته % % كالذي يقطر جودا ونوالا % % 40(@)(@@) % آل بيت الوحي ما زلنا على % % فضلكم يا سادة الدنيا عيالا % % PageV01P875 41(@)(@@) % ما برحتم مذ خلقتم سادة % تكشفون الغي عنا والضلالا % % 42(@)(@@) % لا يغالي فيكم المادح إن % أطنب المادح في المدح وغالى % % 43(@)(@@) % أيها البدر الذي زاد سنا % زادك الله سناء وكمالا % % 44(@)(@@) % هاك من عبدك نظما إنه % % ينظم الشعر بعلياك رتجالا % % 45(@)(@@) % كلما ضقت به ذرعا أرى % % يوسع الفضل على الفكر مجالا % % 46(@)(@@) % وآهنا باالعيد الذي عودتنا % % لثم كفيك التي تكفي نوالا % % 47(@)(@@) % ملك أنت بنا أم ملك % ما وجدنا لك في الناس مثالا % % 48(@)(@@) % كيف أقضي شكر أيديك التي % % حملتني منك أحمالا ثقالا % % 49(@)(@@) % لا عدمنا فيك يا بحر الندى % % أيديا تولي وفضلا يتوالى % % PageV01P876 البحر : بسيط تام 1(@)(@@) % وغادة لو بروحي بعث رؤيتها % % لكنت والله غير مغبون % 2(@)(@@) % ما البدر والغصن أحلى من شمائلها % % كأنها من بنات الحور والعين % PageV01P877 البحر : طويل 1(@)(@@) % عفا الله 
ms280	 عن ذاك الحبيب وإن جنى % % دعاني به المشتاق في صده العنا % % 2(@)(@@) % قسا قلبه في قول واش وحاسد % وعهدي به رطب المحبة لينا % % 3(@)(@@) % من الغيد فتاك بقد ومقلة % % إذا لاح وسنان النواظر بالسنا % % 4(@)(@@) % ففي لحظه استكفى عن الضرب بالظبا % % وفي قده استغنى عن الطعن بالقنا % % 5(@)(@@) % فأين غصون البان منه إذا انثنى % % وأين الظباء العفر منه إذا رنا % % 6(@)(@@) % فيا سالبي صبري على البعد والنوى % % ويا ملبسي ثوبا من السقم والضنى % % 7(@)(@@) % لقد فتنتني منك عين كحيلة % وما خلقت عيناك إلا لتفتنا % % 8(@)(@@) % وليل بإرغام الرقيب سهرته % % كأن علينا للكواكب أعينا % % 9(@)(@@) % نعمنا به من لذة العيش ليلة % % وقد طافت الأقداح من طرب بنا % % 10(@)(@@) % فمن كأس راح للمسرات تحتسي % % ومن ورد خد ما هنالك يجتنى % % PageV01P878 11(@)(@@) % إلى أن ذوى روض الدجى بصباحه % % وبدل من ورد البنفسج سوسنا % % 12(@)(@@) % أعد ذكر هاتيك الليالي وإن مضت % % ولم تك بعد اليوم راجعة لنا % % 13(@)(@@) % إذا ما جرت تلك الأحاديث بيننا % % أمال عليها غصنه البان و نحنى % % 14(@)(@@) % وإن عرض اللاحي ولام على الهوى % % فصرح بمن تهوى ودعني من الكنى % % 15(@)(@@) % إلى الله أشكو من تجنيه شادنا % أحل مكانا في الحشى فتمكنا % % 16(@)(@@) % أشير إلى بدر الدجنة طالعا % وإياه يعني بالإشارة من عنى % % 17(@)(@@) % ويا ويح قلبي كيف يرمين أعين % تعلمن مرمى الصيد ثم رميننا % % 18(@)(@@) % خليلي هل أحظى بها سنة الكرى % % لعل خيالا يطرق العين موهنا % % 19(@)(@@) % فما أنا لولا النازحون بمهرق % فرادى دموع ينحدرن ولا ثنا % % 20(@)(@@) % رعيت لهم عهدا وإن شطت النوى % % بهم و ستبين الود بالصدق معلنا % % PageV01P879 21(@)(@@) % وإني لأرعى للمودة حقها % % ولا يهدمن الود عندي من بنى % % 22(@)(@@) % ولا خير في ود امرئ إن تلونت % % بي الحال من ريب الزمان تلونا % % 23(@)(@@) % حبيب إلي الدهر من لا يريبني % % ويرعى مودات الأخلاء بيننا % % 24(@)(@@) % وكل جواد يقتني المال للندى % % وينفق يوم الجود أنفس ما اقتنى % % 25(@)(@@) % لئن كنت أغنى الناس عن سائر الورى % % فما لي عن سلمان 