ms621	 ثور بن زيد ومالك ثقة د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5738- (@)(@@) موسى بن نافع أبو شهاب الحناط عراقي عن مجاهد وسعيد بن جبير وعنه القطان وأبو الوليد قال أحمد منكر الحديث خ م س(@)(@@)(@@)(@@) | 5739- (@)(@@) صلى الله عليه وسلم موسى بن نجدة عن جده أبي كثير السحيمي وعنه ملازم بن عمرو جهل د(@)(@@)(@@)(@@) | 5740- (@)(@@) موسى بن هارون القيسي البردي البني عن بن وهب والوليد بن مسلم وعنه الذهلي ويحيى بن عثمان بن صالح وأحمد زغبة ثقة مات 224 خ د س(@)(@@)(@@)(@@) | 5741- (@)(@@) عز وجل موسى بن وردان العامري القاص عن أبي هريرة وجابر وعنه الليث وضمام صدوق توفي 117 د ت ق(@)(@@)(@@)(@@) | 5742- (@)(@@) موسى بن يسار عن أبي هريرة وعنه بن أخيه محمد بن إسحاق وأبو معشر وثق م د س ق(@)(@@)(@@)(@@) | 5743- (@)(@@) موسى بن يسار الاردني شامي عن عطاء ونافع وعنه يحيى بن حمزة وابن المبارك صدوق صحب مكحولا أربع عشرة سنة ت(@)(@@)(@@)(@@) | 5744- (@)(@@) موسى بن يعقوب الزمعي عن أبي الحويرث عبد الرحمن بن معاوية وأبي حازم الاعرج وعنه بن مهدي وخالد بن مخلد فيه لين 4(@)(@@)(@@)(@@) | 5745- (@)(@@) موسى بن فلان بن أنس عن بن عمه ثمامة وعنه بن إسحاق يقال موسى بن حمزة ت ق(@)(@@)(@@)(@@) | 5746- (@)(@@) موسى عن محمد بن سعد وعنه الجريري س موسى عن الحسن الزعفراني وعنه النسائي موسى عن الحسن الزعفراني وعنه النسائي س 5698(@)(@@)(@@)(@@) | 5747- (@)(@@) مؤمل بن إسماعيل البصري العمري مولاهم نزل مكة عن عكرمة بن عمار وشعبة وسفيان وعنه أحمد ومؤمل بن إهاب قال أبو حاتم صدوق شديد في السنة كثير الخطأ وقيل دفن كتبه وحدث حفظا فغلط مات 206 ت س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5748- (@)(@@) مؤمل بن إهاب الكوفي نزل الرملة عن ضمرة بن ربيعة ويزيد بن هارون وعنه أبو داود والنسائي وابن جوصا صدوق صاحب رحلة مات في رجب 254 د س(@)(@@)(@@)(@@) | 5749- (@)(@@) مؤمل بن الفضل الحراني عن عيسى بن يونس وبقية وعنه أبو داود وعثمان الدارمي وأبو شعيب الحراني ثقة توفي 229 د س(@)(@@)(@@)(@@) | 5750- (@)(@@) مؤمل بن هشام اليشكري البصري عن أبي معاوية وابن علية وعنه البخاري وأبو داود 
ms622	 والنسائي وابن صاعد ثقة مات 253 خ د س(@)(@@)(@@)(@@) | 5751- (@)(@@) ملازم بن عمرو السحيمي عن عبد الله بن بدر وموسى بن نجدة وعنه بن معين وهناد ثقة مفوه 4(@)(@@)(@@)(@@) | 5752- (@)(@@) ميسرة بن حبيب النهدي عن المنهال وعدي بن ثابت وعنه شعبة وإسرائيل ثقة د ت س(@)(@@)(@@)(@@) | 5753- (@)(@@) ميسرة الاشجعي عن أبي حازم وابن المسيب وعنه سفيان وزائدة وثق خ م س(@)(@@)(@@)(@@) | 5754- (@)(@@) ميسرة بن يعقوب أبو جميلة الطهوي عن علي وعنه ابنه عبد الله وعبد الاعلى الثعلبي وثق د س ق(@)(@@)(@@)(@@) | 5755- (@)(@@) ميسرة أبو صالح الكندي عن علي وعن سويد بن غفلة وعنه هلال بن خباب وعطاء بن السائب وثق د س(@)(@@)(@@)(@@) | 5756- (@)(@@) صلى الله عليه وسلم ميسرة عن مولاه فضالة بن عبيد وعنه إسماعيل بن عبيد الله نكرة ق(@)(@@)(@@)(@@) | 5757- (@)(@@) ميمون بن أبان عن ثابت وعنه زيد بن الحباب وأبو عاصم وثق ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5758- (@)(@@) ميمون بن أصبغ عن يزيد وجعفر بن عون وعنه الفريابي وموسى بن محمد وحاجب بن أركين ثقة مات 256 س(@)(@@)(@@)(@@) | 5759- (@)(@@) ميمون بن جابان بصري عن أبي رافع الصائغ وغيره وعنه الحمادان ثقة د(@)(@@)(@@)(@@) | 5760- (@)(@@) ميمون بن سياه أبو بحر عن جندب وأنس وعنه سلام بن مسكين وحزم القطعي ورع تقي ص دوق وقد ضعفه بن معين خ س(@)(@@)(@@)(@@) | 5761- (@)(@@) ميمون بن أبي شبيب الربعي عن علي وابن مسعود وعنه الحكم ومنصور بن زاذان صدوق تاجر 4(@)(@@)(@@)(@@) | 5762- (@)(@@) ميمون بن العباس الرافقي عن عبيد الله بن موسى والطبقة وعنه النسائي وأبو حاتم ثقة توفي 254 س(@)(@@)(@@)(@@) | 5763- (@)(@@) ميمون بن عبد الله عن ثابت وعنه زيد بن الحباب د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5764- (@)(@@) ميمون بن مهران أبو أيوب عالم الرقة عن بن عباس وابن عمر وعنه ابنه عمرو وجعفر بن برقان وأبو المليح ثقة عابد كبير القدر ولد 4 وتوفي 117 م 4(@)(@@)(@@)(@@) | 5765- (@)(@@) ميمون بن موسى المرإي عن الحسن وميمون بن سياه وعنه ابنه موسى والقطان وأبو الوليد صويلح يدلس ت ق(@)(@@)(@@)(@@) | 5766- (@)(@@) ميمون أبو عبد الله الكندي عن زيد بن أرقم وابن عباس وعنه عوف وشعبة قال أحمد أحاديثه مناكير ت س ق 
ms623	(@)(@@)(@@)(@@) | 5767- (@)(@@) ميمون المكي عن بن عباس وابن الزبير وعنه عبد الله بن هبيرة د(@)(@@)(@@)(@@) | 5768- (@)(@@) ميمون القناد بصري عن بن المسيب وأبي قلابة وعنه بن أبي عروبة وكهمس وثق د س(@)(@@)(@@)(@@) | 5769- (@)(@@) ميمون أبو حمزة القصاب عن بن المسيب وأبي وائل وعنه الفضيل وابن علية ضعفوه ت ق(@)(@@)(@@)(@@) | 5770- (@)(@@) ميناء عن مولاه بن عوف وعثمان وعنه والد عبد الرزاق ضعفوه ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف النون(@)(@@)(@@)(@@) | 5771- (@)(@@) نابل صاحب العباء عن أبي هريرة وابن عمر وعنه بكير بن الاشج وصالح بن عبيد ثقة د ت س وناتل الجذامي بمثناه سأل أبا هريرة(@)(@@)(@@)(@@) | 5772- (@)(@@) ناجية بن كعب الاسلمي صاحب بدن النبي صلى الله عليه وسلم عنه مجزأة وعروة 4(@)(@@)(@@)(@@) | 5773- (@)(@@) ناجية بن كعب الاسدي عن علي وعمار وعنه أبو إسحاق وابنه يونس د ت س(@)(@@)(@@)(@@) | 5774- (@)(@@) ناشرة بن سمي اليزني عن معاذ وعمر وعنه علي بن رباح وعبد الرحمن بن عائذ ثقة س(@)(@@)(@@)(@@) | 5775- (@)(@@) ناصح بن عبد الله المحلمي عن سماك ويحيى بن أبي كثير وعنه يحيى بن يعلى وإسحاق السلولي صالح ضعفوه ت(@)(@@) PageV00P000(@)(@@) ناصح بن العلاء أبو العلاء شيخ لابن المديني ناصح بن عبد الله شامي عن المقبري(@)(@@)(@@)(@@) | 5776- (@)(@@) ناعم بن أجيل الهمداني عن مولاته أم سلمة وأبي هريرة وعنه يزيد بن أبي حبيب وعبد الله بن المغيرة مات سنة ثمانين م س(@)(@@)(@@)(@@) | 5777- (@)(@@) نافذ أبو معبد عن مولاه بن عباس وعنه أبو الزبير وسليمان الاحول مات 104 ع(@)(@@)(@@)(@@) | 5778- (@)(@@) نافع بن جبير بن مطعم عن أبيه وعائشة وعنه الزهري وصالح بن كيسان شريف مفت توفي 99 ع(@)(@@)(@@)(@@) | 5779- (@)(@@) نافع بن عاصم بن عروة بن مسعود الثقفي عن عبد الله بن عمرو وعنه يعلى بن عطاء وغضيف ثقة س(@)(@@)(@@)(@@) | 5780- (@)(@@) نافع أبو محمد عن أبي قتادة مولاه وأبي هريرة وعنه سالم أبو النضر والزهري ثقة ع(@)(@@)(@@)(@@) | 5781- (@)(@@) نافع عن فروة بن قيس وعنه أنس بن عياض ق(@)(@@)(@@)(@@) | 5782- (@)(@@) نافع بن عبد الحارث الخزاعي الصحابي عنه أبو الطفيل وأبو سلمة ولي مكة واستناب مولاه بن أبزى م د س ق(@)(@@)(@@)(@@) | 5783- (@)(@@) نافع بن عتبة بن أبي وقاص أخو هاشم من الطلقاء 
ms624	 عنه جابر بن سمرة م ق(@)(@@)(@@)(@@) | 5784- (@)(@@) نافع بن عجير بن عبد يزيد المطلبي عن أبيه وعمه ركانة وعنه ابنه محمد ومحمد بن إبراهيم التيمي وعبد الله بن علي وثق د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5785- (@)(@@) نافع بن عمر الجمحي المكي الحافظ عن بن أبي مليكة وعمرو بن دينار وسعيد بن أبي هند وعنه القطان وسعيد بن أبي مريم وداود الضبي ثقة مات 169 ع(@)(@@)(@@)(@@) | 5786- (@)(@@) نافع بن مالك بن أبي عامر الاصبحي عن بن عمر وسهل بن سعد وعنه بن أخيه مالك والداروردي ثقة مقرئ بقي إلى زمن السفاح ع(@)(@@)(@@)(@@) | 5787- (@)(@@) نافع بن محمود المقدسي عن عبادة بن الصامت وعنه مكحول وحرام بن حكيم ثقة د س(@)(@@)(@@)(@@) | 5788- (@)(@@) نافع بن أبي نافع البزاز عن أبي هريرة ومعقل بن يسار وعنه خالد بن طهمان وابن أبي ذئب ثقة د ت س(@)(@@)(@@)(@@) | 5789- (@)(@@) نافع بن يزيد الكلاعي عن بن الهاد وجعفر بن ربيعة وعنه سعيد بن أبي مريم وأبو صالح ثقة توفي 168 م د س ق(@)(@@)(@@)(@@) | 5790- (@)(@@) نافع عن مولاته أم سلمة وعنه عبد الرحمن بن الحارث س(@)(@@)(@@)(@@) | 5791- (@)(@@) نافع أبو عبد الله الفقيه عن مولاه بن عمر وأبي هريرة وعائشة وعنه أيوب ومالك والليث من أئمة التابعين وأعلامهم مات 117 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5792- (@)(@@) نافع عن عائشة وعنه الزبير بن عبيد ويقال نافع بن عطاء ق(@)(@@)(@@)(@@) | 5793- (@)(@@) نائل بن نجيح أبو سهل عن فطر وكامل أبي العلاء وعنه عمر بن شبه ومحمد بن سنان ضعيف ق(@)(@@)(@@)(@@) | 5794- (@)(@@) نباته الوالبي المؤدب عن عمر وغيره وعنه إبراهيم وعاصم بن كليب س(@)(@@)(@@)(@@) | 5795- (@)(@@) صلى الله عليه وسلم نبهان عن مولاته أم سلمة وعنه الزهري ومحمد بن عبد الرحمن ثقة 4(@)(@@)(@@)(@@) | 5796- (@)(@@) نبيح العنزي كوفي عن بن عباس وجابر وعنه الاسود بن قيس وأبو خالد الدالاني ثقة 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5797- (@)(@@) نبيشة الهذلي الصحابي عنه أم عاصم وأبو المليح الهذلي م 4(@)(@@)(@@)(@@) | 5798- (@)(@@) نبيط بن شريط الاشجعي الكوفي له صحبة عنه ابنه سلمة ونعيم بن أبي هند د س ق(@)(@@)(@@)(@@) | 5799- (@)(@@) نبيط عن جابان وعنه سالم بن أبي الجعد وثق س(@)(@@)(@@)(@@) | 5800- (@)(@@) نبيه بن وهب العبدري الحجبي عن 
ms625	 أبي هريرة وابن الحنفية وعنه ربيعة الرأي وابن إسحاق ثقة تأخر م 4(@)(@@)(@@)(@@) | 5801- (@)(@@) نجدة الحنفي عن بن عباس وعنه عبد المؤمن بن خالد المروزي د(@)(@@)(@@)(@@) | 5802- (@)(@@) نجيح بن عبد الرحمن أبو معشر السندي مولى بني هاشم عن المقبري والقرظي ونافع وعنه بن مهدي وسعيد بن منصور قال أحمد صدوق لا يقيم الاسناد وقال بن معين ليس بالقوي وقال بن عدي يكتب حديثه مع ضعفه مات 4 17(@)(@@)(@@)(@@) | 5803- (@)(@@) نجي الحضرمي عن علي وعنه ابنه عبد الله لين د س ق(@)(@@)(@@)(@@) | 5804- (@)(@@) نزار بن حيان الاسدي عن أبيه وعكرمة وعنه ابنه علي والقاسم بن حبيب التمار ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5805- (@)(@@) النزال بن سبرة الهلالي الكوفي قيل له صحبة عن أبي بكر وابن مسعود وعنه الشعبي وعبد الملك بن ميسرة ثقة خ د س ق(@)(@@)(@@)(@@) | 5806- (@)(@@) النزال بن عمار عن أبي عثمان النهدي وغيره وعنه قرة بن خالد وعمران بن حدير وثق د(@)(@@)(@@)(@@) | 5807- (@)(@@) نسير بن ذعلوق الكوفي عن بن عمر والربيع بن خثيم وعنه ابنه عمرو والثوري وقيس بن الربيع وثق ق(@)(@@)(@@)(@@) | 5808- (@)(@@) نسي الكندي عن أبي الدرداء وعبادة وعنه ابنه عبادة بن نسي د ق(@)(@@)(@@)(@@) | 5809- (@)(@@) نصر بن حماد الوراق بصري عن مسعر وشعبة وعنه الصاغاني ومحمد بن الجهم حافظ متهم قال أبو زرعة لا يكتب حديثه ق(@)(@@)(@@)(@@) | 5810- (@)(@@) نصر بن دهر الاسلمي صحابي عنه ابنه أبو الهيثم س(@)(@@)(@@)(@@) | 5811- (@)(@@) نصر بن زيد البغدادي المجدر عن مالك وشريك وعنه محمد بن عيسى بن الطباع ومحمد بن الصباح الدولابي ثقة د(@)(@@)(@@)(@@) | 5812- (@)(@@) نصر بن عاصم الليثي النحوي عن أبي بكرة الثقفي ومالك بن الحويرث وعنه قتادة ومالك بن دينار ثقة نقط المصاحف وقرأ على أبي الاسود قال أبو داود خارجي م د س ق(@)(@@)(@@)(@@) | 5813- (@)(@@) نصر بن عاصم الانطاكي عن الوليد ومسكين بن بكير وله رحلة ومعرفة وعنه أبو داود والفريابي د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5814- (@)(@@) نصر بن عبد الرحمن الوشاء الكوفي عن المحاربي ووكيع وعنه الترمذي وابن ماجة وابن جرير وأبو عروبة ثقة مات 248 ت ق(@)(@@)(@@)(@@) | 5815- (@)(@@) نصر بن عبد الرحمن الكناني عن رجل وعنه ثور بن 
ms626	 يزيد د(@)(@@)(@@)(@@) | 5816- (@)(@@) نصر بن عبد الرحمن القرشي عن جد له وعنه سعد بن إبراهيم س(@)(@@)(@@)(@@) | 5817- (@)(@@) نصر بن علقمة الحضرمي الحمصي عن أخيه محفوظ وجبير بن نفير وعنه بن بن أخيه خزيمة بن جنادة وبقية ثقة س ق(@)(@@)(@@)(@@) | 5818- (@)(@@) نصر بن علي الجهضمي الكبير عن جده لامه أشعث الحداني وغيره وعنه أبو نعيم وعبد الصمد ثقة لم يتكهل 4(@)(@@)(@@)(@@) | 5819- (@)(@@) نصر بن علي بن نصر بن علي الكبير الجهضمي أبو عمرو الحافظ عن معتمر والداروردي وعنه الجماعة والنسائي بواسطة أيضا وابن خزيمة قال أبو حاتم هو أوثق من الفلاس وأحفظ طلبه المستعين للقضاء فقال أستخير الله فصلى ركعتين ودعا ونام فقبض لليلته 25 في ربيع الآخر ع نصر بن علي الكوفي كذا في نسخة بالترمذي وصوابه بن عبد الرحمن الوشاء نصر بن علي الكوفي كذا في نسخة بالترمذي وصوابه بن عبد الرحمن الوشاء 5814(@)(@@)(@@)(@@) | 5820- (@)(@@) نصر بن عمرو الحمصي عنه النسائي قاله صاحب النبل(@)(@@)(@@)(@@) | 5821- (@)(@@) نصر بن عمران أبو جمرة الضبعي عن بن عباس وابن عمر وعنه شعبة وعباد بن عباد ثقة توفي 128 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5822- (@)(@@) نصر بن القاسم وقيل نصير عن أبي إسحاق وعنه بشر بن ثابت حديثه موضوع قاله البخاري ق(@)(@@)(@@)(@@) | 5823- (@)(@@) نصر بن محمد بن سليمان الحمصي عن أبيه وإسماعيل بن عياش وعنه بن ماجة والفسوي ضعفه أبو حاتم ق(@)(@@)(@@)(@@) | 5824- (@)(@@) نصر بن مهاجر المصيصي عن عمر بن عبيد ويزيد بن هارون وعنه أبو داود ومحمد عوف ثقة د(@)(@@)(@@)(@@) | 5825- (@)(@@) عز وجل نصير بن الاشعث أو بن أبي الاشعث عن حبيب بن أبي ثابت وسماك وعنه مسلم والتبوذكي ثقة خ(@)(@@)(@@)(@@) | 5826- (@)(@@) نصير بن الفرج أبو حمزة الثغري الزاهد عن شعيب بن حرب ومعاذ بن هشام وعنه أبو داود والنسائي وابن أبي داود ثقة توفي 245 د س(@)(@@)(@@)(@@) | 5827- (@)(@@) النضر بن إسماعيل أبو المغيرة البجلي الكوفي القاص عن الاعمش وابن أبي خالد وعنه بن عرفة وزياد بن أيوب ليس بالقوي ت س(@)(@@)(@@)(@@) | 5828- (@)(@@) عز وجلالنضر بن أنس بن مالك عن أبيه وابن عباس وزيد بن أرقم وعنه قتادة وابن أبي 
ms627	 عروبة(@)(@@) ثقة ع(@)(@@)(@@)(@@) | 5829- (@)(@@) النضر بن حماد العتكي الكوفي عن سيف وعنه أبو بكر بن نافع والكديمي ضعيف ت(@)(@@)(@@)(@@) | 5830- (@)(@@) النضر بن سفيان الدؤلي عن أبي هريرة وعنه علي بن خالد ومسلم بن جندب ثقة س(@)(@@)(@@)(@@) | 5831- (@)(@@) النضر بن شميل أبو الحسن المازني البصري النحوي شيخ مرو ومحدثها عن حميد وهشام بن عروة وعنه بن معين وإسحاق والدارمي ثقة إمام صاحب سنة مات في سلخ عام 203 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5832- (@)(@@) النضر بن شيبان الحداني عن أبي سلمة وعنه أبو عقيل الدورقي والقاسم بن الفضل قال البخاري لم يصح حديثه قد رواه الزهري وجماعة عن أبي سلمة عن أبي هريرة س ق(@)(@@)(@@)(@@) | 5833- (@)(@@) النضر بن عبد الله بن مطر عن قيس بن عباد وأنس وعنه ابنه عبيد الله والحكم بن عطية ثقة د(@)(@@)(@@)(@@) | 5834- (@)(@@) النضر بن عبد الله الاصم عن إسماعيل بن زكريا وعنه محمد بن علي بن شقيق وثق ت(@)(@@)(@@)(@@) | 5835- (@)(@@) النضر بن عبد الله السلمي عن عمرو بن حزم وعنه أبو بكر بن محمد بن عمرو بن حزم س(@)(@@)(@@)(@@) | 5836- (@)(@@) النضر بن عبد الجبار بن نضير أبو الأسود المرادي المصري عن الليث وبكر بن مضر وعنه بن معين ومقدام الرعيني قال أبو حاتم صدوق عابد شبهته بالقعنبي مات عن أربع وسبعين سنة في آخر 219 د س ق(@)(@@)(@@)(@@) | 5837- (@)(@@) النضر بن عبد الرحمن أبو عمر الخزاز عن عكرمة وعنه وكيع والمحاربي ساقط ت(@)(@@)(@@)(@@) | 5838- (@)(@@) النضر بن عربي الباهلي الحراني عن مجاهد وعكرمة وعنه النفيلي ويحيى الوحاظي ثقة إن شاء الله توفي 168 د ت(@)(@@)(@@)(@@) | 5839- (@)(@@) النضر بن كثير البصري العابد عن بن طاوس وابن عقيل وعنه عمر بن شبة وأحمد الدورقي ضعيف د س(@)(@@)(@@)(@@) | 5840- (@)(@@) النضر بن محمد الجرشي اليمامي عن عكرمة بن عمار وشعبة وعنه أحمد العجلي ومؤمل بن(@)(@@) يهاب ثقة ع غير س(@)(@@)(@@)(@@) | 5841- (@)(@@) النضر بن محمد القرشي عن بن المنكدر والعلاء بن المسيب وعنه إسحاق والحسن بن عيسى ثقة من أئمة مرو توفي 183 س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5842- (@)(@@) النضر بن منصور أبو عبد الرحمن عن أبي الجنوب عقبة بن علقمة وسهل الفزاري وعنه 
ms628	 أبو كريب والاشج ضعفه جماعة ت(@)(@@)(@@)(@@) | 5843- (@)(@@) نضلة بن عبيد أبوبرزة الاسلمي الصحابي عنه أبو عثمان النهدي وأبو الوضئ وبقي إلى 64 ع(@)(@@)(@@)(@@) | 5844- (@)(@@) النعمان بن بشير بن سعد الخزرجي الامير أبو عبد الله عن عروة وأبي قلابة وسماك ولي حمص ليزيد قتل في آخر سنة 64 ع(@)(@@)(@@)(@@) | 5845- (@)(@@) النعمان بن ثابت بن زوطا الامام أبو حنيفة فقيه العراق مولى بني تيم الله بن ثعلبة رأى أنسا وسمع عطاء ونافعا وعكرمة وعنه أبو يوسف ومحمد وأبو نعيم والمقرئ أفردت سيرته في مؤلف عاش سبعين عاما مات في رجب 15 ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5846- (@)(@@) النعمان بن راشد الجزري عن ميمون بن مهران والزهري وعنه جرير بن حازم وحماد بن زيد ضعف وقال البخاري صدوق في حديثه وهم كثير م 4(@)(@@)(@@)(@@) | 5847- (@)(@@) النعمان بن سالم الطائفي عن عثمان بن أبي العاص وابن عمر وعنه داود بن أبي هند وشعبة ثقة م 4(@)(@@)(@@)(@@) | 5848- (@)(@@) النعمان بن سعد الانصاري عن علي والمغيرة وعنه بن أخته عبد الرحمن بن إسحاق وثق ت(@)(@@)(@@)(@@) | 5849- (@)(@@) النعمان بن أبي شيبة عبيد الجندي عن طاوس وابن طاوس وعنه هشام بن يوسف وعبد الرزاق ثقة د(@)(@@)(@@)(@@) | 5850- (@)(@@) النعمان بن عبد السلام التيمي الاصبهاني عن بن جريج وأبي حنيفة وعنه عفان وسليمان الشاذكوني قال أبو حاتم محله الصدق توفي 183 وكان يتفقه للثوري ويتعبد س(@)(@@)(@@)(@@) | 5851- (@)(@@) النعمان بن أبي عياش الزرقي عن أبي سعيد وابن عمر وعنه يحيى بن سعيد وابن عجلان ثقة من أبناء كبار الصحابة خ م ت س ق(@)(@@)(@@)(@@) | 5852- (@)(@@) النعمان بن معبد عن أبيه وعنه ابنه عبد الرحمن وثق د(@)(@@)(@@)(@@) | 5853- (@)(@@) النعمان بن مقرن المزني حامل لواء مزينة يوم الفتح عنه ابنه معاوية وجبير بن حية استشهد يوم نهاوند سنة 21 ع(@)(@@)(@@)(@@) | 5854- (@)(@@) النعمان بن المنذر الغساني الدمشقي عن مجاهد وطاوس وعنه صدقة السمين ويحيى بن حمزة صدوق قدري مات 132 د س(@)(@@)(@@)(@@) | 5855- (@)(@@) نعيم بن حكيم المدائني عن أبي مريم الثقفي وعنه القطان وشبابة ثقة مات 148 د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5856- (@)(@@) نعيم بن حماد الخزاعي الحافظ أبو عبد الله المروزي الاعور عن أبي 
ms629	 حمزة السكري وإبراهيم بن سعد وعنه البخاري مقرونا والدارمي وحمزة الكاتب مختلف فيه امتحن فمات محبوسا بسامراء 229 خ د ت ق(@)(@@)(@@)(@@) | 5857- (@)(@@) نعيم بن حنظلة أو النعمان أو بن قبيصة عن عمار وعنه الركين بن الربيع وثق د(@)(@@)(@@)(@@) | 5858- (@)(@@) نعيم بن دجاجة الاسدي عن عمر وعلي وعنه أبو حصين ويحيى بن هانئ ثقة س(@)(@@)(@@)(@@) | 5859- (@)(@@) نعيم بن ربيعة عن عمر وعنه مسلم بن يسار الجهني د(@)(@@)(@@)(@@) | 5860- (@)(@@) نعيم بن زياد الانماري عن بلال وأبي هريرة وعنه مكحول ومعاوية بن صالح ثقة س(@)(@@)(@@)(@@) | 5861- (@)(@@) نعيم بن عبد الله القيني الكاتب عن عمر بن عبد العزيز وعنه رجاء بن أبي سلمة س(@)(@@)(@@)(@@) | 5862- (@)(@@) نعيم بن عبد الله المجمر مولى آل عمر عن أبي هريرة وجابر وعنه مالك وفليح ثقة جالس أبا هريرة عشرين سنة ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5863- (@)(@@) نعيم بن قعنب عن أبي ذر وعنه يزيد بن الشخير س(@)(@@)(@@)(@@) | 5864- (@)(@@) الله عز وجل نعيم بن مسعود أبو سلمة الاشجعي الذي خذل بين الاحزاب عنه ابنه سلمة د(@)(@@)(@@)(@@) | 5865- (@)(@@) نعيم بن ميسرة النحوي الكوفي نزل الري عن عكرمة وقيس بن مسلم وعنه يحيى بن يحيى وزنيج ومحمد بن حميد ثقة مات 174 ت(@)(@@)(@@)(@@) | 5866- (@)(@@) نعيم بن هزال الاسلمي مختلف في صحبته عنه ابنه يزيد د س(@)(@@)(@@)(@@) | 5867- (@)(@@) نعيم بن همار أو هبار أو حمار أو حمار أو هدار صحابي شامي عنه كثير بن مرة وأبو إدريس د س(@)(@@)(@@)(@@) | 5868- (@)(@@) نعيم بن أبي هند الاشجعي عن أبيه وله صحبة وعنه شعبة وشيبان وله عن سويد بن غفلة ثقة م ت س ق(@)(@@)(@@)(@@) | 5869- (@)(@@) نفيع بن الحارث بن كلدة أبو بكرة الثقفي وقيل اسمه مسروح كناه النبي صلى الله عليه وسلم لتدليه ببكرة من الطائف عنه أولاده والحسن وعدة توفي 51 ع(@)(@@)(@@)(@@) | 5870- (@)(@@) نفيع بن الحارث أبو داود الهمداني الكوفي الاعمى عن عمران بن حصين وأبي برزة وعنه الثوري وشريك تركوه وكان يترفض ت ق(@)(@@)(@@)(@@) | 5871- (@)(@@) نفيع أبو رافع الصائغ مدني نزل البصرة عن عمر وعثمان وأبي وعنه قتادة وبكر المزني ثقة نبيل ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5872- (@)(@@) الله عز وجلنقادة بن عبد الله الاسدي 
ms630	 أعرابي له صحبة عنه ابنه سعد وزيد بن أسلم ق(@)(@@)(@@)(@@) | 5873- (@)(@@) نقيب أو نقيد عن رجل وعنه إسماعيل بن محمد الطلحي حديث السفرجلة ق(@)(@@)(@@)(@@) | 5874- (@)(@@) النمر بن تولب صحابي عنه يزيد بن الشخير ولكن لم يسم في الكتابين د س(@)(@@)(@@)(@@) | 5875- (@)(@@) نمران بن جارية الحنفي عن أبيه وعنه دهثم وثق ق(@)(@@)(@@)(@@) | 5876- (@)(@@) صلى الله عليه وسلم نمران بن عتبة الذماري عن أم الدرداء وعنه الوليد بن رباح وثق د(@)(@@)(@@)(@@) | 5877- (@)(@@) نملة بن أبي نملة الانصاري عن أبيه وله صحبة وعنه الزهري وعاصم بن عمر د(@)(@@)(@@)(@@) | 5878- (@)(@@) نمير بن أوس الاشعري قاضي دمشق عن مالك بن مسروح وأم الدرداء وعنه الزبيدي والاوزاعي توفي 121 ت(@)(@@)(@@)(@@) | 5879- (@)(@@) نمير بن عريب الهمداني عن عامر بن مسعود وعنه أبو إسحاق وثق حب ت(@)(@@)(@@)(@@) | 5880- (@)(@@) نمير الخزاعي صحابي عنه ابنه مالك د س ق(@)(@@)(@@)(@@) | 5881- (@)(@@) نميلة الفزاري عن بن عمر وعنه ابنه عيسى د(@)(@@)(@@)(@@) | 5882- (@)(@@) نهار العبدي عن أبي سعيد وعنه أبو طوالة ومحمد بن يحيى بن حبان ثقة ق(@)(@@)(@@)(@@) | 5883- (@)(@@) النهاس بن قهم القيسي عن أنس وعطاء وعنه أبو عاصم والانصاري ضعفوه د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5884- (@)(@@) عز وجل نهشل بن سعيد الخراساني عن الضحاك والربيع بن أنس وعنه رواد بن الجراح وابن نمير واه ق(@)(@@)(@@)(@@) | 5885- (@)(@@) نهيك بن يريم الاوزاعي عن مغيث الاوزاعي وعنه أبو عمرو الاوزاعي صدوق ق(@)(@@)(@@)(@@) | 5886- (@)(@@) النواس بن سمعان الكلابي له صحبة عنه جبير بن نفير وأبو إدريس م 4(@)(@@)(@@)(@@) | 5887- (@)(@@) نوح بن أبي بلال عن سعيد بن المسيب وأبي سلمة وعنه زيد بن الحباب وأبو بكر الحنفي ثقة س(@)(@@)(@@)(@@) | 5888- (@)(@@) نوح بن حبيب القومسي عن بن إدريس والقطان وعنه أبو داود والنسائي والحسن بن سفيان ثقة صاحب سنة توفي 242 د س(@)(@@)(@@)(@@) | 5889- (@)(@@) نوح بن حكيم الثقفي عن بعض التابعين وعنه بن إسحاق وثق حب د(@)(@@)(@@)(@@) | 5890- (@)(@@) نوح بن ذكوان عن الحسن وعطاء وعنه سويد بن عبد العزيز وثوابة بن مسعود واه ق(@)(@@)(@@)(@@) | 5891- (@)(@@) نوح بن ربيعة أبو مكين عن أبي مجلز وعكرمة وعنه يحيى القطان ووكيع ثقة د س ق(@)(@@)(@@)(@@) | 5892- (@)(@@) نوح بن صعصعة عن يزيد بن عامر 
ms631	 وعنه سعيد بن السائب وثق حب د(@)(@@)(@@)(@@) | 5893- (@)(@@) نوح بن قيس الحداني أو الطاحي عن أيوب وأبي هارون العبدي وعنه مسدد وخليفة حسن الحديث وقد وثق مات 183 م 4(@)(@@)(@@)(@@) | 5894- (@)(@@) نوح بن أبي مريم قاضي مرو وهو نوح الجامع فقيه واسع العلم تركوه مات 173 يكنى أبا عصمة تفقه بأبي حنيفة وابن أبي ليلى وأخذ عن حجاج بن أرطاة وروى عن الزهري(@)(@@) PageV00P000(@)(@@) ومحمد بن المنكدر وعنه نعيم بن حماد وحبان بن موسى وسويد وخلق ت(@)(@@)(@@)(@@) | 5895- (@)(@@) الله عز وجلنوح بن يزيد المؤدب عن إبراهيم بن سعد وعنه الذهلي وعباس الدوري ثقة د(@)(@@)(@@)(@@) | 5896- (@)(@@) نوفل بن عبد الملك الهاشمي عن أبيه وعنه إبراهيم بن أبي يحيى والربيع بن حبيب ق(@)(@@)(@@)(@@) | 5897- (@)(@@) نوفل بن مساحق القرشي عن عمر وسعيد بن زيد وعنه ابنه عبد الملك وصالح بن كيسان ثقة ولي قضاء المدينة د(@)(@@)(@@)(@@) | 5898- (@)(@@) نوفل بن معاوية الديلي له صحبة عنه عراك بن مالك وأبو بكر بن عبد الرحمن تأخر موته خ م س(@)(@@)(@@)(@@) | 5899- (@)(@@) نوفل الاشجعي صحابي نزل الكوفة عنه ولده فروة د ت س(@)(@@)(@@)(@@) | 5900- (@)(@@) نيار بن مكرم له صحبة عنه عروة ت نيار عن عروة عن عائشة وعنه عبد الله بن يزيد ق 3025(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الهاء(@)(@@)(@@)(@@) | 5901- (@)(@@) هارون بن إبراهيم الاهوازي عن بن سيرين وعطاء وعنه العقدي وأبو نعيم ثقة س(@)(@@)(@@)(@@) | 5902- (@)(@@) هارون بن إسحاق الهمداني الكوفي حافظ عن بن عيينة ومعتمر وعنه الترمذي والنسائي وابن ماجة وابن خزيمة والمحاملي ثقة متعبد مات 258 ت س ق(@)(@@)(@@)(@@) | 5903- (@)(@@) هارون بن إسماعيل الخزاز بصري عن قرة وهمام وعنه الكوسج وعبد والكديمي ثقة توفي 206 خ م ت س ق(@)(@@)(@@)(@@) | 5904- (@)(@@) هارون بن الاشعث البخاري عن وكيع وجماعة وعنه البخاري وسهل بن شاذويه وثق خ(@)(@@)(@@)(@@) | 5905- (@)(@@) هارون بن حميد الدهكي أبو أحمد الواسطي عن غندر والقطان وعنه زكريا خياط السنة وابن أبي حاتم وثق س(@)(@@)(@@)(@@) | 5906- (@)(@@) هارون بن رئاب الاسيدي البصري العابد عن أنس وابن المسيب وعنه الاوزاعي وشعبة(@)(@@) ثقة م د س(@)(@@)(@@)(@@) | 5907- (@)(@@) هارون بن زيد بن أبي الزرقاء الموصلي نزيل الرملة عن أبيه 
