ms121	 ثقات مأمونون زهاد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1125 - (@)(@@) أبو عبيدة عن أبي بكر الصديق وابن مسعود وعنه عمرو بن مرة لعله أبو عبيدة بن عبد الله بن مسعود وأرسل(@)(@@)(@@)(@@) $ 1126 - (@)(@@) أبو عتبة الكندي الحمصي عن أبي أسامة الباهلي وعنه معاوية بن صالح ذكره بن حبان في الثقات(@)(@@)(@@)(@@) $ 1127 - (@)(@@) أبو عثمان الأصبحي عن أبي هريرة وعنه سلامان بن عامر وشراحبيل بن يزيد حديثه عند المصريين واسمه عبيد بن عمرو فيه نظر(@)(@@)(@@)(@@) $ 1128 - (@)(@@) أبو عثمان الجحشي عن موسى بن عبد الرحمن بن أبي ربيعة وعنه معمر(@)(@@)(@@)(@@) $ 1129 - (@)(@@) أبو العذراء عن أبي الدرداء وعنه عمير بن هاني قال أبو حاتم مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1130 - (@)(@@) أبو عسيب مولى النبي عليه السلام له صحبة ورواية قيل اسمه أحمر أسند إلى النبي عليه السلام حديثين أحدهما في الحمى والطاعون روى عنه مسلم بن عبد الله أبو نصيرة وأبو عمران الجوني وغيرهما وقد قيل فيه أبو عسيم بالميم وقيل أبو عصيب بالصاد ذكر ذلك أبو حاتم وغيره وفرق الحاكم أبو أحمد بن أبي عسيب وأبي عسيم والصحيح أنهما واحد كما أشار إليه أبو حاتم وغيره والحديث يدل عليه قال أبو عمران الجوني حدثنا أبو عسيب أو أبو عسيم فالشك من أبي عمران لا يوهم المغايرة بينهما في التشخيص بل في الكنية فقط والله أعلم وذكره بن سعد في طبقات البصريين فقال أبو عسيب مولى النبي عليه السلام قال وفي بعض الرواية يقولون عن أبي عسيم وهو رجل واحد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1131 - (@)(@@) أبو عفير الأنصاري عن محمد بن سهل بن أبي حثمة عن أبيه ومحيصة بن مسعود غير مشهور(@)(@@)(@@)(@@) $ 1132 - (@)(@@) أبو عقرب الأسدي عن بن مسعود وعنه طلق بن حبيب مجهول(@)(@@)(@@)(@@) $ 1133 - (@)(@@) أبو عكرمة المخزومي عن أبي هريرة وعنه منصور بن دينار(@)(@@)(@@)(@@) $ 1134 - (@)(@@) أبو عقرب البكري له صحبة ورواية أسلم يوم فتح مكة روى عنه ابنه نوفل(@)(@@)(@@)(@@) $ 1132 - (@)(@@) أبو علوان عن بن عباس هو عبد الله بن عصم الحنفي مترجم في التهذيب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1136 - (@)(@@) أبو علي الرداد الصيقلي عن جعفر بن تمام بن العباس بن عبد المطلب 
ms122	 عن أبيه عن جده في السواك وعنه سفيان الثوري ومنصور وأبو حنيفة قال أبو علي بن السكن مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1137 - (@)(@@) أبو علي من بني كاهل عن أبي موسى الأشعري وعنه عبد الملك بن أبي سليمان العرزمي ذكره بن حبان في الثقات(@)(@@)(@@)(@@) $ 1138 - (@)(@@) أبو عمارة ويقال أبو عمار قال حدثني جار لجابر بن عبد الله قال تقدمت من سفر فجاءني جابر يسلم علي فجعلت أحدثه عن افتراق الناس وما أحدثوا فجعل يبكي ثم قال سمعت رسول الله صلى الله عليه وسلم يقول إن الناس دخلوا في دين الله أفواجا وسيخرجون منه أفواجا رواه عنه الأوزاعي(@)(@@)(@@)(@@) $ 1139 - (@)(@@) أبو عمر المقري عن سماك وعنه أبو إبراهيم الترجماني مجهول(@)(@@)(@@)(@@) $ 1140 - (@)(@@) أبو عمرو البجلي يقال اسمه عبيدة عن عبد الملك بن سفيان الثقفي وعنه أبو عبد الله مسلمة الرازي وجرمي بن حفص قال بن حبان لا يحل الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1141 - (@)(@@) أبو عمرو القسملي عن ابنه أهبان بن صيفي عن أبيهما وعنه حماد بن سلمة ما لا يعرف(@)(@@)(@@)(@@) $ 1142 - (@)(@@) أبو عمير الحضرمي عن أبي مسعود وعنه العيزار بن خردل مجهول(@)(@@)(@@)(@@) $ 1143 - (@)(@@) أبو عمير ويقال أبو عمرو واسمه أسيد بن مالك جد معروف بن واصل قال كنا جلوسا عند النبي عليه السلام فجاء رجل رجل بطبق عليه تمر روت عنه حفصة بنت طلق وغيرها(@)(@@)(@@)(@@) $ 1144 - (@)(@@) أبو العوام سادن بيت المقدس روى عن عمر ومعاذ بن جبل ومعاوية وكعب وغيرهم وعنه روح بن عابد وغيره قال الإمام أحمد لا أدري ما اسمه وذكره بن حبان في الثقات وقال روى عن أهل الشام ومصر(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الغين(@)(@@)(@@)(@@) $ 1145 - (@)(@@) أبو الغادية الجهني واسمه يسار بن سبع وقيل غير ذلك واسمه يسار بن سبع وقيل غير ذلك سكن الشام ونزل واسط عداد في الشاميين أدرك النبي عليه السلام وهو غلام وسمع منه قوله لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض وكان محبا لعثمان وهو قاتل عمار بن يسار وكان إذا استأذن على معاوية وغيره يقول قاتل عمار بالباب يتبجح بذلك فانظر إلى 
ms123	 العجب يروي عن النبي عليه السلام النهي عن القتل ثم يقتل مثل عمار نسأل الله العافية روى عنه كلثوم بن جبر وغيره(@)(@@)(@@)(@@) $ 1146 - (@)(@@) أبو غادية اليمامي عن أبي هريرة وعنه عكرمة بن عمار مجهول(@)(@@)(@@)(@@) $ 1147 - (@)(@@) أبو الغادية المزني صحابي روى عنه حبان بن حجر وغيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1148 - (@)(@@) أبو غفار عن علقمة بن عبد الله المزني عن رجل من قومه له صحبة وعنه يحيى الأنصاري مجهول(@)(@@)(@@)(@@) $ 1149 - (@)(@@) أبو غيلان عب الشيباني عن الحكم بن عبد الملك وعنه خالد بن مخلد(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الفاء(@)(@@)(@@)(@@) $ 1150 - (@)(@@) أبو فزارة عن عبد الرحمن بن أبي ليلى لعله راشد بن كيسان قال بن سعد أبو فزارة من أهل الرقة ليس بذاك(@)(@@)(@@)(@@) $ 1151 - (@)(@@) أبو فضالة الأنصاري عن علي أن رسول الله صلى الله عليه وسلم عهد إليه أنه لا يموت حتى يؤمر ثم يخضب هذه يعني لحيته من دم هذه يعني هامته روى عنه ابنه فضالة قال أبو حاتم له صحبة وشهد بدرا وقاتل مع علي بصفين(@)(@@)(@@)(@@) $ 1152 - (@)(@@) أبو الفضل عب عن أبي الجوزاء عن أبي بن كعب وعنه مالك بن مغول لعله عبد الله بن الفضل بن العباس وهو راوي الحديث قال الأزدي متروك الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1135 - (@)(@@) أبو الفضل عب المروزي الخراساني هو حاتم بن الليث الجوهري روى عن إسماعيل بن أبي أويس ويحيى بن معين وإسحاق بن موسى الأشيب وشريح بن النعمان وغيرهم وعنه عبد الله بن الإمام أحمد(@)(@@)(@@)(@@) $ 1154 - (@)(@@) أبو فلان عن علقمة بن مرثد وعنه إسحاق بن يوسف قال عبد الله بن الإمام أحمد كذا قال أبي لم يسمه على عمد قال وحدثناه غيره فسماه يعني أبا حنيفة عن علقمة بن مرثد عن سليمان بن بريدة عن أبيه أن رسول الله صلى الله عليه وسلم قال لرجل أتاه اذهب فإن الدال على الخير كفاعله كذا رواه في مسند الأنصار(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف القاف(@)(@@)(@@)(@@) $ 1155 - (@)(@@) أبو القاسم عن بن عباس هو مقسم بن بجرة(@)(@@)(@@)(@@) $ 1156 - (@)(@@) أبو قحذم قال وجد في زمن زياد صرة فيها حب أمثال النوى عليه مكتوب 
ms124	 هذا نبت في زمان كان يعمل فيه بالعدل رواها عنه عوف قال أبو حاتم أبو قحذم رأى أبا بكرة روى عنه منصور بن زاذان وقال بن معين ليس بشيء وقال الدولابي ليس بثقة قال الذهبي له عن عبد الله بن حرام(@)(@@)(@@)(@@) $ 1157 - (@)(@@) أبو قدامة الحنفي عن أنس وعنه يونس بن عبيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الكاف(@)(@@)(@@)(@@) $ 1158 - (@)(@@) أبو كثير مولى الأنصار قال كنت مع سيد علي بن أبي طالب حين قتل أهل النهروان روى عنه إسماعيل بن مسلم العبدي(@)(@@)(@@)(@@) $ 1159 - (@)(@@) أبو كثير المحاربي عن خرشة بن الحر وعنه ثابت بن عجلان(@)(@@)(@@)(@@) $ 1160 - (@)(@@) أبو كثير عن مولاه عقبة بن عامر الجهني وعنه كعب بن علقمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1161 - (@)(@@) أبو كريمة عن رجل من أهل البصرة عن قبيصة بن المخارق وعنه الحسن البصري(@)(@@)(@@)(@@) $ 1162 - (@)(@@) أبو كعب عن مولاه عبد الله بن عباس وعنه ثعلبة بن مسلم الخثعمي وغيره قال أبو زرعة لا يسمى ولا يعرف إلا في هذا الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الميم(@)(@@)(@@)(@@) $ 1163 - (@)(@@) أبو المثنى العبدي عن بشير بن الخصاصية وعنه جبلة بن سحيم(@)(@@)(@@)(@@) $ 1164 - (@)(@@) أبو محمد عن أبي ذر وأبي هريرة وعنه فلان بن عبد الواحد(@)(@@)(@@)(@@) $ 1165 - (@)(@@) أبو المخيس اليشكري عن أنس وعنه الحكم بن عطية مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1166 - (@)(@@) أبو مراية العجلي التيمي عن عمران بن حصين وعنه قتادة قال بن سعد اسمه عبد الله بن عمر وكان قليل الحديث(@)(@@)(@@)(@@) $ 1167 - (@)(@@) أبو مريم الحنفي واسمه إياس بن صبيح بن المحرش وكان من أهل اليمامة من أصحاب مسيلمة وهو قتل زيد بن الخطاب يوم اليمامة ثم تاب وأسلم وحسن إسلامه وولى قضاء البصرة بعد عمران بن حصين في زمن عمر روى عن عمر أنه كان بالجابية فذكر فتح بيت المقدس وعنه أبو سنان ومحمد بن سيرين وتوفي بناحية الأهواز(@)(@@)(@@)(@@) $ 1168 - (@)(@@) أبو مراية عن النبي عليه السلام أو عن عبد الله بن عمر وعنه أسلم العجلي(@)(@@)(@@)(@@) $ 1169 - (@)(@@) أبو مسعود عن حميد بن القعقاع وعنه شعبة(@)(@@)(@@)(@@) $ 1170 - (@)(@@) أبو المشنى لقيط بن المشنى عن أبي أمامة وعنه الجريري(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1171 - (@)(@@) أبو مصبح أو 
ms125	 بن مصبح هكذا بالشك عن بن السمط عن عبادة بن الصامت وعنه أبو بكر بن حفص مجهول عن مثله(@)(@@)(@@)(@@) $ 1172 - (@)(@@) أبو مطر البصري الجهني عن علي وعنه مختار بن نافع التيمي قال أبو زرعة لا يعرف اسمه قال أبو حاتم مجهول وتركه حفص بن غياث(@)(@@)(@@)(@@) $ 1173 - (@)(@@) أبو معروف عن أبي ذر وعنه علي بن زيد غير معروف(@)(@@)(@@)(@@) $ 1174 - (@)(@@) أبو معسر عن سليم مولى ليث عن أسامة بن زيد وعنه حسين بن محمد مجهول(@)(@@)(@@)(@@) $ 1175 - (@)(@@) أبو معشر عن الأشعث بن قيس وعنه بن شبرمة لا يعرف(@)(@@)(@@)(@@) $ 1176 - (@)(@@) أبو المغيرة بن حنين عن بن عمر وعنه عبد الله بن عكرمة هو رافع(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1177 - (@)(@@) أبو المقدام عن عبد الرحمن الأزرق عن علي وعنه قيس بن الربيع(@)(@@)(@@)(@@) $ 1178 - (@)(@@) أبو منصور مولى الأنصار عن عمرو بن الجموح وعنه عبد الله بن الوليد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1179 - (@)(@@) أبو المنهال الكناني عن البراء بن عازب وزيد بن أرقم وعنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 1180 - (@)(@@) أبو المنهال بن سلمة وقيل بن مسلم الخزاعي عن عمه وله صحبة وعنه قتادة(@)(@@)(@@)(@@) $ 1181 - (@)(@@) أبو موسى العافي واسمه مالك بن عبادة حديثه عند أهل مصر وعداده فيهم روى عن النبي عليه السلام وعن عقبة بن عامر وعنه يحيى بن ميمون الحضرمي وثعلبة بن أبي الكنود وغيرهما(@)(@@)(@@)(@@) $ 1182 - (@)(@@) أبو موسى الهروي واسمه إسحاق بن إبراهيم تقدم(@)(@@)(@@)(@@) $ 1183 - (@)(@@) أبو مويهبة مولى النبي عليه السلام كان من مولدي مزينة اشتراه النبي عليه السلام فأعتقه يقال أنه شهد المريسيع مع رسول الله صلى الله عليه وسلم وهو كان يقود بعائشة بعير قالت وكان رجلا صالحا روى عنه عبد الله بن عمرو بن العاص وعبيد بن حنين قال بن عبد البر لا يوقف له على اسم حديثه حسن في استغفار النبي عليه السلام لأهل البقيع(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف النون(@)(@@)(@@)(@@) $ 1184 - (@)(@@) أبو نبيه بن إبراهيم التيمي أخو محمد بن إبراهيم عن عائشة وعنه بن إسحاق ذكره بن حبان في الثقات(@)(@@)(@@)(@@) $ 1185 - (@)(@@) أبو نهشل عن أبي وائل وعنه المسعودي قال الذهبي لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف 
ms126	 الهاء(@)(@@)(@@)(@@) $ 1186 - (@)(@@) أبو هارون الغنوي عن مطرف وعنه بشر بن المفضل وإسماعيل بن علية(@)(@@)(@@)(@@) $ 1187 - (@)(@@) أبو هبيرة الكلاعي عن عبد الله بن عمرو وعنه عبد الله بن هبيرة مجهول(@)(@@)(@@)(@@) $ 1188 - (@)(@@) أبو هرم عن صدقة الدمشقي وعنه الفرج بن فضالة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1189 - (@)(@@) أبو همام الشعباني عن رجل من خثعم له صحبة ورواية وعنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 1190 - (@)(@@) أبو هند الأشجعي الكوفي واسمه النعمان بن أشيم الأشجعي الكوفي عن بن سمرة بن جندب عن أبيه وعنه ابنه نعيم بن أبي هند(@)(@@)(@@)(@@) $ 1191 - (@)(@@) أبو هند الداري يقال اسمه بريكا ويقال بريد بن عبد الله بن بريد بن عسيب وهو بن عم تميم الداري وليس بأخيه شقيقه ولكنه أخوه لأمه قدم أبو هند على النبي عليه السلام هو وأبناء عمه تميم ونعيم أبناء أوس وسألوه أن يقطعهم أرضا بالشام فكتب لهم بها عداده في أهل الشام حدث عنه حفيده سعيد بن زياد بن أبي هند ومكحول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1192 - (@)(@@) أبو هند مولى بني بياض صحابي روى أبو هريرة أن رسول الله صلى الله عليه وسلم قال يا بني بياض أنكحوا أبا هند وانكحوا إليه(@)(@@)(@@)(@@) $ 1193 - (@)(@@) أبو هنيدة العدوي واسمه البراء بن نوفل عن والان العدوي وعنه أبو نعامة العدوي وسليمان التيمي وقال البخاري ويقال اسمه حريق بن مالك قال بن سعد كان معروفا قليل الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الواو(@)(@@)(@@)(@@) $ 1194 - (@)(@@) أبو الواصل عن بن مسعود وعنه عبد الكريم مجهول(@)(@@)(@@)(@@) $ 1195 - (@)(@@) أبو وهب عن مولاه أبي هريرة وعنه أبو معشر المديني قال بن سعد كان قليل الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) || حرف الياء(@)(@@)(@@)(@@) $ 1196 - (@)(@@) أبو يحيى مولى آل الزبير وعنه أبو سعيد الأنصاري(@)(@@)(@@)(@@) $ 1197 - (@)(@@) أبو يزيد مولى عبد الله بن الحارث عن أم جندب الأودية وعنه حجاج بن أرطأة(@)(@@)(@@)(@@) $ 1198 - (@)(@@) أبو يزيد أن رسول الله قال دعوا الناس يرزق الله بعضهم من بعض رواه عنه بن حكيم في بابي مسند المكيين والمدنيين روى هذا الحديث أبو عوانة عن عطاء بن حكيم بن أبي يزيد عن أبيه عن رجل سمع النبي عليه السلام يقول 
ms127	 نحوه ورواه حماد بن سلمة عن عطاء عن حكيم بن يزيد عن أبيه وإنما هو بن أبي يزيد(@)(@@)(@@)(@@) $ 1199 - (@)(@@) أبو يزيد الهمزي له صحبة ورواية وعنه أيوب السختياني(@)(@@)(@@)(@@) $ 1200 - (@)(@@) أبو يزيد اللقيطي له صحبة ورواية في الزكاة(@)(@@)(@@)(@@) $ 1201 - (@)(@@) أبو يعقوب الخياط عن أبي سعيد الخدري وعنه سعيد بن هلال(@)(@@)(@@)(@@) $ 1202 - (@)(@@) أبو اليمان عن أبي ذر وعنه صفوان لعله عامر بن عبد الله الهوزاني(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1203 - (@)(@@) أبو يونس الباهلي عن مهاجر المكي وعنه شعبة (@)(@@)(@@)(@@) | فصل وممن اشتهر بالنسبة إلى أبيه أو جده ونحو ذلك(@)(@@)(@@)(@@) $ 1204 - (@)(@@) بن الأحمسي عن أبي ذر وعنه أبو العلاء بن الشخير(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1205 - (@)(@@) بن الأدرع قال كنت أحرس النبي عليه السلام ذات ليلة فخرج لحاجته فذكر قصة ذي البجادين رواه عنه زيد بن أسلم(@)(@@)(@@)(@@) $ 1206 - (@)(@@) بن أذناب قال سلفت علقمة ألفي درهم وعنه عطاء بن السائب(@)(@@)(@@)(@@) $ 1207 - (@)(@@) بن أسامة بن زيد عن أبيه هو محمد(@)(@@)(@@)(@@) $ 1208 - (@)(@@) بن أشوع عن حنش أبي المعتمر وعنه أشعث بن سوار هو سعيد بن عمرو(@)(@@)(@@)(@@) $ 1209 - (@)(@@) بن الأصبهاني عن جدة له وكانت سرية علي بن أبي طالب هو عبد الرحمن بن عبد الله الأصبهاني روى له الجماعة(@)(@@)(@@)(@@) $ 1210 - (@)(@@) بن أغيد قال قال لي علي بن أبي طالب يا علي بن أغيد تدري ما حق الطعام وعنه أبو الورد بن ثمامة القشيري قال بن أبي حاتم روى عنه أبو تمام القشيري قال بن المديني بن أغيد ليس بمعروف وقال الذهبي اسمه علي(@)(@@)(@@)(@@) $ 1211 - (@)(@@) بن أكيمة واسمه عبد الله بن سليم بن أكيمة الليثي حجازي حدث عن أبي هريرة وسعيد بن المسيب وابن أخي أبي رهم وعنه الزهري(@)(@@)(@@)(@@) $ 1212 - (@)(@@) بن بنت أنس بن مالك عن أنس وعنه عبد الكريم الجزري(@)(@@)(@@)(@@) $ 1213 - (@)(@@) بن أخي أبي أيوب عن عمه وعنه يحيى بن جابر الطائي(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1214 - (@)(@@) بن أبي بشير الأنصاري عن أبيه وعنه حبيب الأنصاري(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1215 - (@)(@@) بن أبي بلال اسمه عبد الله حمصي عن عبد الله بن بسر وعنه خالد بن معدان(@)(@@)(@@)(@@) $ 1216 - (@)(@@) بن جدعان عن أنس وعنه بن 
ms128	 عون هو علي بن زيد بن خالد جدعان(@)(@@)(@@)(@@) $ 1217 - (@)(@@) بن حجيزة عن القاسم بن البرجي وأبي هريرة وعنه سلمة بن أكسوم هو عبد الرحمن بن حجيرة الأكبر(@)(@@)(@@)(@@) $ 1218 - (@)(@@) بن حذيفة بن اليمان عن أبيه وعنه أبو بكر بن عمرو بن عتبة(@)(@@)(@@)(@@) $ 1219 - (@)(@@) بن الحوتكية عن عمر وأبي ذر وعنه حكيم بن جبير وموسى بن طلحة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1220 - (@)(@@) بن خنبش الطائي له صحبة ورواية حديثه عمرة في رمضان تعدل حجة وعنه الشعبي بن خنبش اسمه وهب ويقال هرم وقال الشعبي أيضا حدثنا خنبش الطائي فذكر الحديث هو بن خنبش ولكل واحد من هرم ووهب ترجمة في التهذيب واختلف عن الشعبي فقيل تاره عن وهب بن خنبش وتارة عن بن خنبش وتارة عن هرم بن خنبش وكلها في المسند(@)(@@)(@@)(@@) $ 1221 - (@)(@@) بن دارة مولى عثمان عن أبي هريرة وعنه العلاء بن عبد الرحمن(@)(@@)(@@)(@@) $ 1222 - (@)(@@) بن أبي ذباب هو عبد الله بن عبد الرحمن بن الحارث بن أبي ذباب عن سهل بن سعد وعنه عبد الرحمن بن معاوية(@)(@@)(@@)(@@) $ 1223 - (@)(@@) بن ذر عن أبيه وعنه وكيع هو عمر بن ذر بن عبد الله الهمداني(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1224 - (@)(@@) بن الرسيم عن أبيه قال وفدنا على رسول الله فسألناه عن الأشربة في الظروف وعنه يحيى بن غسان(@)(@@)(@@)(@@) $ 1225 - (@)(@@) بن الساعدي المالكي قال استعملني عمر على الصدقة وعنه بسر بن سعيد هو عبد الله بن السعدي(@)(@@)(@@)(@@) $ 1226 - (@)(@@) بن سليمان بن الغسيل عن عكرمة وعنه وكيع هو عبد الرحمن بن سليمان من رجال الصحيحين(@)(@@)(@@)(@@) $ 1227 - (@)(@@) بن السمط عن عمر وعبادة بن الصامت وعنه جبير بن نفير وغيره(@)(@@)(@@)(@@) $ 1228 - (@)(@@) بن شراحيل بن بلال الخولاني عن أبيه عن بن عمر وعنه طباق الإسكندراني(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1229 - (@)(@@) بن أبي صعصعة عن أبيه عن أبي سعيد وعنه سفيان بن عيينة وأخطأ فيه وقال حدثني بن صعصعة عبد الله بن عبد الرحمن عن أبيه قال عبد الله بن أحمد عن أبيه قال وسفيان يخطىء في اسمه والصواب عبد الرحمن بن عبد الله بن عبد الرحمن بن أبي صعصعة المازني 
ms129	 قلت وله ترجمة في التهذيب(@)(@@)(@@)(@@) $ 1230 - (@)(@@) بن ضمرة بن سعيد عن جدته عن امرأة من نساءهم وكانت صلت القبلتين قالت دخل علي رسول الله عليه السلام فقال اختضبي الحديث(@)(@@)(@@)(@@) $ 1231 - (@)(@@) بن عبد الرحمن بن أبزى عن أبيه اسمه سعيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1232 - (@)(@@) بن عبس رجل أدرك الجاهلية قال كنت أسوق لآل لنا بقرة قال فسمعت من جوفها يآل دريح قول فصيح أن لا إله إلا الله قال فقدمنا مكة فوجدنا النبي عليه السلام قد خرج روى عنه مجاهد(@)(@@)(@@)(@@) $ 1233 - (@)(@@) بن عبيد عن أبيه وابن عمر وعنه الهذيل بن بلال(@)(@@)(@@)(@@) $ 1234 - (@)(@@) بن عتبان أو عتبان الأنصاري عن النبي عليه السلام بحديث الماء من الماء رواه المطلب بن عبد الله فقال عن عتبان ان بن عتبان هكذا بالشك وعتبان له ترجمة في التهذيب وابن عتبان لا يعرف ولا ذكر في الصحابة(@)(@@)(@@)(@@) $ 1235 - (@)(@@) بن عبد خير عن أبيه عن علي وعنه أبو السوداء(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1236 - (@)(@@) بن أبي عتيق عن أبيه عن أبو بكر الصديق وعنه حماد بن سلمة هو محمد بن عبد الله بن أبي عتيق(@)(@@)(@@)(@@) $ 1237 - (@)(@@) بن عجلان هو محمد بن عجلان العابد عن بكير بن عبد الله(@)(@@)(@@)(@@) $ 1238 - (@)(@@) بن عم أبي عقيل زهرة بن معبد بن عبد الله بن هشام التيمي عقبة بن عامر عن عمر وعنه بن عمه أبو عقيل(@)(@@)(@@)(@@) $ 1239 - (@)(@@) بن علاثة عن مسلم الجهني وعنه حماد بن خالد(@)(@@)(@@)(@@) $ 1240 - (@)(@@) بن قابوس بن أبي ظبيان الجنبي عن أبيه عن جده(@)(@@)(@@)(@@) $ 1241 - (@)(@@) بن قارظ عن أبيه وعنه إبراهيم بن ميسرة اسمه عبد الله بن قارظ(@)(@@)(@@)(@@) $ 1242 - (@)(@@) بن قريط الصدفي عن عائشة وعنه سويد بن قيس(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1243 - (@)(@@) أبناء قريظة أنهم عرضوا على النبي عليه السلام زمن قريظة فمن كانت نبتت عانته قتل ومن لا ترك رواه عنهم كثير بن السائب(@)(@@)(@@)(@@) $ 1244 - (@)(@@) بن أبي ليلى قال حدثني أخي عن علي هو محمد بن عبد الرحمن بن أبي ليلى واسم أخيه عيسى(@)(@@)(@@)(@@) $ 1245 - (@)(@@) بن أبي محذورة عن أبيه وعنه هذيل بن بلال هو عبد الملك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1246 
ms130	 - (@)(@@) بن محيصن شيخ من قريش سهمي عن محمد بن قيس بن مخرمة عن أبي هريرة وعنه سفيان هو عمر بن عبد الرحمن بن محيصن(@)(@@)(@@)(@@) $ 1247 - (@)(@@) بن مربع الأنصاري قيل اسمه زيد وقيل عبد الله له صحبة ورواية روى حديثه سفيان عن عمرو بن دينار عن عمرو بن عبد الله بن صفوان عن يزيد بن شيبان قال أتانا بن مربع الأنصاري ونحن في مكان من الموقف فقال إني رسول رسول الله إليكم بقول كونوا على مشاعركم هذه فإنكم على إرث من إرث إبراهيم وهذا الحديث رواه أصحاب السنن بهذا السند وهذا اللفظ وليس لابن مربع سواه وقد أورده شيخنا المزي في الأسماء في حرف الزاي وإيراده هنا أولى إذ قد جاء حديثه عن غير مسمى(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1248 - (@)(@@) بن مسعدة صاحب الجيوش قيل اسمه عبد الله له صحبة ورواية حديث إني قد بدنت فمن فاته ركوعي أدركه في بطء قيامي رواه عنه عثمان بن أبي سليمان(@)(@@)(@@)(@@) $ 1249 - (@)(@@) بن المصبح أو أبو المصبح عن بن السمط عن عبادة بن الصامت وعنه أبو بكر بن حفص تقدم في الكنى(@)(@@)(@@)(@@) $ 1250 - (@)(@@) بن معانق أو أبو معانق عن أبي مالك الأشعري وعنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 1251 - (@)(@@) بن معبر السعدي عن بن مسعود وعنه وائل(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1252 - (@)(@@) بن المنتفق القيسي قيل اسمه عبد الله حديثه في صفة النبي عليه السلام فيما روى محمد بن حجارة عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن أبيه عنه(@)(@@)(@@)(@@) $ 1253 - (@)(@@) بن الموزع عن علي وعنه الحكم أبو محمد الهذلي محمد الهذلي مذكور في الكنى من التهذيب (@)(@@)(@@)(@@) | فصل وممن اشتهر بالنسبة إلى بلد أو حرفة ونحو ذلك(@)(@@)(@@)(@@) $ 1254 - (@)(@@) التنوخي رسول هرقل إلى النبي عليه السلام روى عنه سعيد بن راشد(@)(@@)(@@)(@@) $ 1255 - (@)(@@) الحنظلي عن شداد بن أوس وعنه أبو العلاء بن الشخير(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1256 - (@)(@@) الديلمي الحميري أنه سأل رسول الله فقال أنا بأرض جاره الحديث وعنه مرثد بن عبد الله اليزني هو ديلم الجيشاني مذكور في التهذيب(@)(@@)(@@)(@@) $ 1257 - (@)(@@) الوالبي صديق لمعاذ عن معاذ 
ms131	 وعنه أبو حصين(@)(@@)(@@)(@@) | فصل في المبهمات(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1258 - (@)(@@) أبان بن عبد الله البجلي قال حدثني عمومتي عن جدهم صخر بن عيلة أن قوما من بني سليم فروا عن أرضهم حين جاء الإسلام روى هذا في التهذيب(@)(@@)(@@)(@@) $ 1259 - (@)(@@) أبان أيضا عن عمه عثمان بن أبي حازم البجلي عن أبيه أبي حازم عن صخر وكان جد عثمان لأمه ولكل منهم ترجمة في التهذيب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1260 - (@)(@@) إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن بعض أهله عن أبيه عن طلق بن حبيب عن جابر مرفوعا اتقوا فورة العشاء(@)(@@)(@@)(@@) $ 1261 - (@)(@@) إبراهيم بن عبد الأعلى عن جدته عن أبيها سويد بن حنظلة في ذكر وفادته على النبي عليه السلام(@)(@@)(@@)(@@) $ 1262 - (@)(@@) إبراهيم بن مهاجر عن قائد السائب بن عبد الله عن السائب عن عائشة(@)(@@)(@@)(@@) $ 1263 - (@)(@@) إبراهيم بن ميمون عن رجل من بني الحارث قال سمعت رجلا منا يقال له أيوب قال سمعت عبد الله بن عمرو يقول من تاب قبل موته عاما يتب عليه(@)(@@)(@@)(@@) $ 1264 - (@)(@@) أرطاة بن المنذر عن بعض أشياخ الجند عن المقدام بن معدي كرب بحديث النهي عن لطم خدود الدواب(@)(@@)(@@)(@@) $ 1265 - (@)(@@) إسحاق بن أخي أنس عن رافع بن إسحاق هو بن عبد الله بن أبي طلحة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1266 - (@)(@@) إسحاق بن عبد الله بن الحارث بن كنانة عن عمه وعن أبي بكر بن زيد أنهما سمعا عميرا مولى أبي اللحم قال أقبلت مع سادتي نريد الهجرة الحديث(@)(@@)(@@)(@@) $ 1267 - (@)(@@) إسحاق بن عبد الله بن أبي طلحة عن امرأة عبد الله بن أبي طلحة عن أبي قتادة لعلها حميدة بنت عبيد بن رفاعة(@)(@@)(@@)(@@) $ 1268 - (@)(@@) إسماعيل بن أمية عن رجل عن بن عباس بحديث أي الشراب أطيب قال الحلو(@)(@@)(@@)(@@) $ 1269 - (@)(@@) إسماعيل بن أمية قال أخبرني الثقة أو من لا أتهم عن بن عمر بحديث آمروا النساء في بناتهن لعل هذا الثقة صالح بن عبد الله الشحام وهو راوي الحديث المذكور عن بن عمر(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1270 - (@)(@@) إسماعيل بن عياش عن رجل سماه عن محمد بن يوسف عن عمرو بن 
ms132	 عثمان بن عفان عن أبيه الرجل هو أبو فروة ويقال أبو قرة(@)(@@)(@@)(@@) $ 1271 - (@)(@@) الأسود بن قيس عن رجل عن علي أنه قال يوم الجمل إن رسول الله صلى الله عليه وسلم لم يعهد إلينا عهدا نأخذ به في الإمارة(@)(@@)(@@)(@@) $ 1272 - (@)(@@) الأعمش عن رجل عن بن عمر بحديث فضل المؤذن(@)(@@)(@@)(@@) $ 1273 - (@)(@@) الأعمش عن رجل عن أبي الأحوص(@)(@@)(@@)(@@) $ 1274 - (@)(@@) الأوزاعي عن بعض إخوانه عن محمد بن عبيد المكي عن بن عباس بحديث التكذيب بالقدر هذا اسمه العلاء بن الحجاج(@)(@@)(@@)(@@) $ 1275 - (@)(@@) أيوب عن رجل عن بن عباس أمرنا رسول الله صلى الله عليه وسلم أن نحل فحللنا(@)(@@)(@@)(@@) $ 1276 - (@)(@@) أيوب عن شيخ من بني سدوس قال سئل بن عباس عن القبلة للصائم(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1277 - (@)(@@) أيوب عن رجل عن سعيد بن جبير قال أتيت علي بن عباس وهو يأكل رمانا بعرفة الحديث(@)(@@)(@@)(@@) $ 1278 - (@)(@@) بقية عن شيخ من قريش عن رجاء بن حيوة(@)(@@)(@@)(@@) $ 1279 - (@)(@@) بكر بن سوادة عن رجل من ربيعة بن قيس عن عقبة بن عامر بحديث من توضأ فأحسن الوضوء ثم صلى غير ساه ولا لاه غفر له ما تقدم من ذنبه(@)(@@)(@@)(@@) $ 1280 - (@)(@@) بكر بن سوادة عن مولى لجابر عن جابر أن رسول الله صلى الله عليه وسلم مر بهم وهم يحشون أراكا(@)(@@)(@@)(@@) $ 1281 - (@)(@@) بكير بن الأخنس عن رجل عن أبي بكر الصديق(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1282 - (@)(@@) ثور هو بن يزيد عن رجل من أهل البصرة عن محمد بن مسلمة أن رسول الله صلى الله عليه وسلم قال إذا قذف الله في قلب امرء خطبة فلا بأس أن ينظر إليها(@)(@@)(@@)(@@) $ 1283 - (@)(@@) جابر عن خالته أم عثمان عن جويرية(@)(@@)(@@)(@@) $ 1284 - (@)(@@) جعفر بن عبد الله بن الحكم المزني عن رجل من مزينة قالت له امرأته ألا تنطلق فتسأل رسول الله كما يسأله الناس(@)(@@)(@@)(@@) $ 1285 - (@)(@@) حاتم بن أبي صغيرة عن بعض بني عبد المطلب عن علي بن عبد الله بن عباس(@)(@@)(@@)(@@) $ 1286 - (@)(@@) حاتم بن أبي صغيرة قال سمعت رجلا من قريش يقول رأيت امرأة جاءت إلى بن عمر بمنى عليها درع 
ms133	 من حرير(@)(@@)(@@)(@@) $ 1287 - (@)(@@) الحسن عن رجل قد سماه عن سلمة بن المحبق أن رسول الله أتى على أهل بيت فاستقى هذا الرجل هو جون بن قتادة(@)(@@)(@@)(@@) $ 1288 - (@)(@@) الحسن بن محمد عن امرأته عن عائشة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1289 - (@)(@@) الحكم هو بن عتيبة عمن سمع عليا وابن مسعود يقولان قضى رسول الله بالجوار(@)(@@)(@@)(@@) $ 1290 - (@)(@@) حميد بن عبد الرحمن الحميدي عن ثكثة من ولد سعد أن رسول الله عليه السلام دخل عليه يعوده لسعد من الولد محمد وإبراهيم وعمر وعامر(@)(@@)(@@)(@@) $ 1291 - (@)(@@) حميد الطويل عن شيخ من ثقيف ذكره حميد بصلاح ذكر أن عمه أخبره أنه رأى عثمان جلس على الباب الثاني من مسجد رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 1292 - (@)(@@) حنظلة بن علي الأسلمي عن رجل من بني الديل قال صليت الظهر في بيتي ثم خرجت فمررت برسول الله وهو يصلي(@)(@@)(@@)(@@) $ 1293 - (@)(@@) حوى مولى سليمان بن عبد الملك عن رجل أرسل إليه عمر بن عبد العزيز وهو أمير المؤمنين قال كيف الحديث الذي حدثتني عن الصنابحي فقال أخبرنا الصنابحي أنه لقى عمرو بن عبسة فذكر حديث العتق(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1294 - (@)(@@) خارجة بن زيد عن أمه أن عثمان بن مظعون لما قبض قالت أم خارجة بنت زيد طبت أبا السائب الحديث كذا رقع في هذه الطريق والصواب خارجة عن أم العلاء بنت الحارث بن ثابت الأنصارية(@)(@@)(@@)(@@) $ 1295 - (@)(@@) الخطاب بن صالح عن أمه عن سلامة بنت معقل بحديث أم الوليد(@)(@@)(@@)(@@) $ 1296 - (@)(@@) خيثمة بن عبد الرحمن بن أبي سبرة عن رجل من قومه عن عبد الله بن مسعود(@)(@@)(@@)(@@) $ 1297 - (@)(@@) خيثمة عن سمع بن مسعود بحديث لا تسموا لا لمصل أو مسافر(@)(@@)(@@)(@@) $ 1298 - (@)(@@) رباح بن عبد الرحمن عن جدته عن أبيها اسم جدته أسماء بنت سعيد بن زيد(@)(@@)(@@)(@@) $ 1299 - (@)(@@) ربعي بن خراش عن رجل عن بعض أصحاب النبي عليه السلام بحديث الهلال(@)(@@)(@@)(@@) $ 1300 - (@)(@@) ربعي بن خراش عن رجل عن علي قال رسول الله لن يؤمن عبد حتى يؤمن بأربع الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1301 - (@)(@@) ربيع عن امرأته عن أخت حذيفة قالت خطبنا رسول الله 
ms134	 عليه السلام الحديث في التهذيب(@)(@@)(@@)(@@) $ 1302 - (@)(@@) الربيع بن أنس عن جده قال سمعت أبا موسى يقول قال رسول الله صلى الله عليه وسلم لا يقبل الله صلاة رجل في جسده شيء من الخلوق(@)(@@)(@@)(@@) $ 1303 - (@)(@@) الربيع بن عميلة عن فلان بن عميلة عن حذيم بن فاتك فلان هو يسير بن عميلة أخو الربيع(@)(@@)(@@)(@@) $ 1304 - (@)(@@) زهرة بن معبد عن جده قال كنا مع رسول الله وهو أخذ بيد عمر بن الخطاب زهرة هو بن معبد بن عبد الله بن هشام بن زهرة روى عن جده عبد الله بن هشام بن زهرة(@)(@@)(@@)(@@) $ 1305 - (@)(@@) زهرة بن معبد عن بن عم له أخي أبيه عن عقبة بن عامر بحديث من توضأ ثم رفع بصره إلى السماء(@)(@@)(@@)(@@) $ 1306 - (@)(@@) سالم بن أبي الجعد عن أخيه عن بن عباس(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1307 - (@)(@@) سالم بن أبي الجعد عن رجل منهم من أشجع قال رأى النبي عليه السلام علي خاتما من ذهب فقال اطرحه فطرحته إلى يومي هذا(@)(@@)(@@)(@@) $ 1308 - (@)(@@) سالم بن أبي الجعد عن رجل عن كعب بن مرة قال سألت رسول الله صلى الله عليه وسلم أي الجعل أجوب قال جوف الليل(@)(@@)(@@)(@@) $ 1309 - (@)(@@) سعد بن إبراهيم أنه سمع رجلا من بني مخزوم يحدث عن عمه أن معاوية أراد أن يأخذ أرضا لعبد الله بن عمرو(@)(@@)(@@)(@@) $ 1310 - (@)(@@) سعيد بن جمهان الأسلمي عن أبي بكرة هو عبد الرحمن بن أبي بكرة(@)(@@)(@@)(@@) $ 1311 - (@)(@@) سعيد المقبري عن رجل من بني سالم عن أبيه عن جده عن كعب بن عجره يرفعه لا يتطهر رجل في بيته ثم يخرج لا يريد إلا الصلاة الحديث ثم قال سعيد عن بعض بني كعب بن عجرة عن كعب فذكره(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1312 - (@)(@@) سعيد عن رجل عن الحكم بن عتبة عن بن أبي ليلى عن علي أمرني رسول الله صلى الله عليه وسلم أن أبيع غلامين(@)(@@)(@@)(@@) $ 1313 - (@)(@@) سفيان عن رجل عن جابر بن زيد عن بن عباس العين حق اسم الرجل دويد بن نفاع الدمشقي(@)(@@)(@@)(@@) $ 1314 - (@)(@@) سفيان عن شيخ له عن أنس بحديث 
ms135	 النخل بيع النخل حتى يزهو(@)(@@)(@@)(@@) $ 1315 - (@)(@@) سليط بن أيوب بن الحكم عن أمه عن سلمى بنت قيس(@)(@@)(@@)(@@) $ 1316 - (@)(@@) سليمان بن عمرو بن الأحوص عن أمه أنها شهدت النبي عليه السلام عند جمرة العقبة اسمه أمه أم جندب الأزدية(@)(@@)(@@)(@@) $ 1317 - (@)(@@) شريح الحضرمي عن جدته عن عقبة بن عامر أن أول عظم من الإنسان يتكلم يوم يختم على الأفواه فخذه من الرجل الشمال(@)(@@)(@@)(@@) $ 1318 - (@)(@@) شعبة بن أخي مطرف بن عبد الله الشخير عن مطرف هو عبد الله بن هانئ بن عبد الله بن الشخير(@)(@@)(@@)(@@) $ 1319 - (@)(@@) شعبة عن شيخ من بجيلة عن بن أبي أوفى لعله طارق بن عبد الرحمن البجلي(@)(@@)(@@)(@@) $ 1320 - (@)(@@) شعبة عن فلان بن عبد الصمد الثقفي عن أبي مجيب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1321 - (@)(@@) شعبة عن فلان الخثعمي عن أبي زرعة عن أبي هريرة بحديث اللهم أنت الصاحب في السفر(@)(@@)(@@)(@@) $ 1322 - (@)(@@) شهاب بن عباد العصري عن بعض وفد عبد القيس قال قدما على رسول الله فاشتد فرحهم بنا لعل اسم هذا الوافد قيس بن النعمان وهو الذي روى عنه أبو القموص(@)(@@)(@@)(@@) $ 1323 - (@)(@@) شهر بن حوشب قال سمعت رجلا يحدث عن عقبة بن عامر بحديث ما من رجل يموت وفي قلبه مثقال حبة من خردل(@)(@@)(@@)(@@) $ 1324 - (@)(@@) شهر بن حوشب عن بن عم لأبي ذر عن أبي ذر في شرب الخمر(@)(@@)(@@)(@@) $ 1325 - (@)(@@) شهر بن حوشب عن خاله عن عائشة(@)(@@)(@@)(@@) $ 1326 - (@)(@@) صالح بن كيسان عن رجل عن عثمان(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1327 - (@)(@@) طلحة بن مصرف عن امرأة من بني عبد القيس عن أخت عبد الله بن رواحة أن رسول الله صلى الله عليه وسلم قال وجب الخروج على كل ذات نطاق(@)(@@)(@@)(@@) $ 1328 - (@)(@@) عاصم بن عمرو البجلي عن رجل من القوم الذين سألوا عمر(@)(@@)(@@)(@@) $ 1329 - (@)(@@) عاصم بن الكليب عن شيخ من قريش من بني تيم قال حدثني فلان وفلان وفلان فعد ستة أو سبعة كلهم من قريش فيهم عبد الله بن الزبير بحديث ميراث النبي عليه السلام(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1330 - (@)(@@) عامر الشعبي عن رجل من ثقيف قال سألت رسول الله عن ثلاث فلم 
ms136	 يرخص لنا في شيء منهن(@)(@@)(@@)(@@) $ 1331 - (@)(@@) عبد الله بن بأبيه عن بعض بني يعلى بن أمية قال كنت مع عمر فاستلم الركن لعله صفوان بن يعلى(@)(@@)(@@)(@@) $ 1332 - (@)(@@) عبد الله بن سعيد بن أبي هند عن رجل من أصحاب عكرمة عن عكرمة بحديث كان النبي عليه السلام يلحظ في صلاته من غير أن يلوي عنقه هذا الرجل هو ثور بن يزيد(@)(@@)(@@)(@@) $ 1333 - (@)(@@) عبد الله بن عميرة عن زوج درة بنت أبي لهب عن درة(@)(@@)(@@)(@@) $ 1334 - (@)(@@) عبد الله بن أبي الهذيل عن رجل عن عبد الله بن عمرو(@)(@@)(@@)(@@) $ 1335 - (@)(@@) عبد الله بن أبي الهذيل عن شيخ من النخع قالت دخلت مسجد إيليا فذكر حديث عبد الله بن عمرو أعوذ بك من نفس لا تشبع(@)(@@)(@@)(@@) $ 1336 - (@)(@@) عبد الرحمن بن الأسود عن عمه هو علقمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1337 - (@)(@@) عبد الرحمن بن حرملة هو الأسلمي عن رجل من جهينة عن عقبة بن عامر فذكر حديث تأخير الصلاة(@)(@@)(@@)(@@) $ 1338 - (@)(@@) عبد الرحمن بن أبي رافع عن عمته هي سلمى(@)(@@)(@@)(@@) $ 1339 - (@)(@@) عبد الرحمن بن أبي الزناد عن محمد من آل عمرو بن عثمان عن فاطمة بنت الحسين هو محمد بن عبد الله بن عمرو بن عثمان بن عفان الديباج(@)(@@)(@@)(@@) $ 1340 - (@)(@@) عبد الرحمن بن عباس عن رجل من همدان من أصحاب عبد الله بن مسعود ولم يسم عن بن مسعود(@)(@@)(@@)(@@) $ 1341 - (@)(@@) عبد الرحمن بن عبد الله بن كعب بن مالك عن بعض من شهد النبي عليه السلام قال لرجل ممن معه في الغزاة إنه من أهل النار الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1342 - (@)(@@) عبد الرحمن بن أبي عمرة عن عمه أن النبي عليه السلام قال لا تجمعوا بين اسمي وكنيتي(@)(@@)(@@)(@@) $ 1343 - (@)(@@) عبد الرحمن بن أبي ليلى قال رأيت شيخا أبيض الرأس واللحية على حمار وهو يتبع جنازة فسمعته يقول حدثني فلان بن فلان سمع رسول الله يقول من كره لقى الله كره الله لقاه(@)(@@)(@@)(@@) $ 1344 - (@)(@@) عبد الرحمن بن أبي ليلى عن رجل من أصحاب النبي عليه السلام بحديث لا يتلقى الجلب(@)(@@)(@@)(@@) $ 1345 - (@)(@@) عبد الرزاق قال 
ms137	 إن شيخ من أهل نجران قال حدثني محمد بن عبد الرحمن البيلماني عن أبيه عن بن عمر بحديث الرضاع هذا الشيخ هو محمد بن عثيم أبو ذر روى هذا الحديث أيضا عنه معتمر وروى عنه أيضا هشام بن يوسف وغيره قال فيه بن معين ليس بشيء وقال أبو حاتم منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1346 - (@)(@@) عبد الملك بن عمير عن رجل من آل أبي حيثمة عن الشفاء بنت عبد الله سئل رسول الله صلى الله عليه وسلم عن أفضل الأعمال لعل الرجل أبو بكر بن عبد الرحمن بن أبي حيثمة(@)(@@)(@@)(@@) $ 1347 - (@)(@@) عبد الملك بن عمير عن رجل من بلحارث عن أبي هريرة اسم الرجل زياد(@)(@@)(@@)(@@) $ 1348 - (@)(@@) عبد الملك بن عمير عن بن عم لحذيفة عن حذيفة(@)(@@)(@@)(@@) $ 1349 - (@)(@@) عبيد الله بن أبي جعفر قال حدثني من سمع حنشا الصنعاني عن رويقع بن ثابت هذا الراوي عن حنش هو مرزوق الكندي مولى بجيب وبجيب بطن من كندة(@)(@@)(@@)(@@) $ 1350 - (@)(@@) عبيد الله بن سعيد الثقفي عن عمه عن علي(@)(@@)(@@)(@@) $ 1351 - (@)(@@) عبيد الله بن عبد الله بن عتبة أن رجلين أخبراه أنهما أتيا على النبي عليه السلام يسألانه من الصدقة وحجة الوداع الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1352 - (@)(@@) عبيد الله بن عبد الله بن عمر عمن سمع بن سراقة يذكر عن بن عمر قال ما رأيت رسول الله صلى قبل الصلاة ولا بعدها في السفر(@)(@@)(@@)(@@) $ 1353 - (@)(@@) عبيد الله بن عبد الله بن موهب عن مولى لأبي سعيد قال بينما أنا مع أبي سعيد وهو مع رسول الله عليه السلام فذكر حديث السبيل في المسجد(@)(@@)(@@)(@@) $ 1354 - (@)(@@) عبيد الله بن عمر عن شيخ سماه عن نعيم بن النحام قال سمعت مؤذن رسول الله عليه السلام في ليلة باردة هذا الشيخ هو محمد بن يحيى بن حبان وقد روى هذا الحديث عنه عن نعيم(@)(@@)(@@)(@@) $ 1355 - (@)(@@) عبيد الله بن هوذة القريعي قال حدثني رجل سمع جرموزا الهجيمي أنه قال يا رسول الله أوصني قال أن لا تكون لعانا(@)(@@)(@@)(@@) $ 1356 - (@)(@@) عروة بن الزبير قال حدثني جار لخديجة 
ms138	 بنت خويلد أنه سمع النبي عليه السلام يقول أنا والله لا أعبد اللات أبدا(@)(@@)(@@)(@@) $ 1357 - (@)(@@) عطاء بن السائب عن أبيه عن عائشة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1358 - (@)(@@) عطاء بن السائب عن رجل من بكر بن وائل عن خاله قال قلت يا رسول الله أعشر قومي قال إنما العشور على اليهود والنصارى(@)(@@)(@@)(@@) $ 1359 - (@)(@@) عطاء بن يسار أن امرأة حدثته أن رسول الله ناه ثم استيقظ وهو يضحك فذكر حديث الغزاة في البحر هذه هي أم حرام بن ملحان(@)(@@)(@@)(@@) $ 1360 - (@)(@@) عطاء الخراساني عن مولى امرأته عن علي(@)(@@)(@@)(@@) $ 1361 - (@)(@@) عطاء بن يزيد عن بعض الصحابة قال يا رسول الله أي الناس أفضل قال مؤمن مجاهد بماله ونفسه(@)(@@)(@@)(@@) $ 1362 - (@)(@@) عطاء عن رجل من هذيل عن عبد الله بن عمرو بن العاص(@)(@@)(@@)(@@) $ 1363 - (@)(@@) عطاء عن مولى لأسماء عنهما لعله عمر ختن عطاء بن يسار(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1364 - (@)(@@) عطاف بن خالد عن رجل من أهل البصرة عن طلحة بن عبد الله بن عبد الرحمن بن أبي أبكر الصديق(@)(@@)(@@)(@@) $ 1365 - (@)(@@) عطية الطفاوي عن أبيه عن أم سلمة(@)(@@)(@@)(@@) $ 1366 - (@)(@@) عكرمة بن خالد المخزومي قال حدثني عريف من عرفاء قريش عن أبيه سمع رسول الله قال من صام رمضان وشوال والأربعة والخميس في كل السنة(@)(@@)(@@)(@@) $ 1367 - (@)(@@) علقمة بن عبد الله المزني قال حدثني رجل من قومي أنه سمع رسول الله يقول من كان يؤمن بالله واليوم الآخر فليكرم ضيفه لعل الرجل معقل بن يسار المزني(@)(@@)(@@)(@@) $ 1368 - (@)(@@) علي بن زيد عن رجل عن بن عباس أن رسول الله صلى الله عليه وسلم صلى على النجاشي(@)(@@)(@@)(@@) $ 1369 - (@)(@@) عمرو بن مرة عن رجل في بيت أبي عبيدة عن عبد الله بن عمرو(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1370 - (@)(@@) عمرو بن أوس عن رجل حدثه مؤذن النبي عليه السلام قال نادى منادي رسول الله في يوم مطير صلوا في الرحال(@)(@@)(@@)(@@) $ 1371 - (@)(@@) عمرو بن الحارث بن المصطلق عن بن أخي زينب امرأة عبد الله بن سمعود عن زينب قالت خطبنا رسول الله(@)(@@)(@@)(@@) $ 1372 - (@)(@@) عمرو بن دينار عن رجل من أهل مصر عن عمرو بن العاص 
ms139	 أنه أهدى إلى الناس هدايا ففضل عمارا فقيل له فقال سمعت رسول الله عليه السلام تقتله الفئة الباغية(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1373 - (@)(@@) عمرو بن دينار قال سمعت رجلا يحدث عن عثمان كان رجلا سمحا بايعا الحديث(@)(@@)(@@)(@@) $ 1374 - (@)(@@) عمرو بن سليم الزرقي عن أمه قالت كنا نمشي بمنى فإذا صائح يصيح(@)(@@)(@@)(@@) $ 1375 - (@)(@@) عمرو بن شعيب أن مولى شرحبيل بن حسنة حدثه عن عقبة بن عامر وحذيفة بن اليمان كل ما زدت عليك قوسك(@)(@@)(@@)(@@) $ 1376 - (@)(@@) عمرو بن عبد الرحمن عن عمته عن عائشة(@)(@@)(@@)(@@) $ 1377 - (@)(@@) عمرو بن أبي عمرو عن رجل من الأنصار عن جابر بحديث كلوا الصيد وأنتم حرم ما لم تصيدوه أو يصاد لكم ثم قال عمر وأخبرني رجل ثقة من بني سلمة عن جابر فذكره(@)(@@)(@@)(@@) $ 1378 - (@)(@@) العلاء بن عبد الرحمن عن رجل من قريش من بني سهم عن رجل منهم يقال له ماجده أو بن ماجده التيمي عن بن عمر(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1379 - (@)(@@) العلاء بن المسيب عن رجل من بني تيم الله عن بن عمر هذا الرجل هو أبو أمامة ويقال أبو أميمة التيمي الكوفي(@)(@@)(@@)(@@) $ 1380 - (@)(@@) العيزار بن جرول عن رجل من حضرموت يكنى أبا عمير عن بن مسعود(@)(@@)(@@)(@@) $ 1381 - (@)(@@) عيسى بن عبد الرحمن البجلي السلمي عن أمه عن عائشة(@)(@@)(@@)(@@) $ 1382 - (@)(@@) قدام بن موسى عن شيخ عن بن عمر بحديث لا صلاة بعد الفجر إلا ركعتين(@)(@@)(@@)(@@) $ 1383 - (@)(@@) فطن بن وهب بن عويمر عن جدته عن سالم عن بن عمر ثلاثة حرم الله عليهم الجنة(@)(@@)(@@)(@@) $ 1384 - (@)(@@) ليث عن رجل عن بن عباس قال لهما يعني عائشة إنما سميت أم المؤمنين لسعدي وإنه لا سمك قبل أن تولدي(@)(@@)(@@)(@@) $ 1385 - (@)(@@) مالك عن عمه عن أبيه عن طلحة بن عبيد الله عمه هو أبو سهل نافع بن مالك بن أبي عامر(@)(@@)(@@)(@@) $ 1386 - (@)(@@) مالك قال أخبرني الثقة عن عمرو بن شعيب(@)(@@)(@@)(@@) $ 1387 - (@)(@@) المبارك يعني بن فضالة عن أمه عن معاذة عن عائشة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1388 - (@)(@@) محمد بن إسحاق عن أبيه عن رجل من بني مازن عن أبي داود المازني اسم الرجل حفض 
ms140	 بن مازن(@)(@@)(@@)(@@) $ 1389 - (@)(@@) محمد بن إسحاق قال حدثني رجل عن عبد الله بن أبي نجيح عن مجاهد عن بن عباس قال أهدي رسول الله في حجته مائة بدنة(@)(@@)(@@)(@@) $ 1390 - (@)(@@) محمد بن إسحاق عن رجل من الأنصار عن أمه سلمى بنت قيس أنها بايعت النبي عليه السلام مع نسوة الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1391 - (@)(@@) محمد بن طلحة بن يزيد بن ركانة عن أمت مسعود بن العجماء عن أبيهما أنه قال لرسول الله في المخزومية التي سرقت(@)(@@)(@@)(@@) $ 1392 - (@)(@@) محمد بن أبي عائشة عن رجل من أصحاب النبي عليه السلام في النهي عن القراءة مع قراءة الإمام سوى الفاتحة لعل الرجل أبو هريرة(@)(@@)(@@)(@@) $ 1393 - (@)(@@) محمد بن عبد الرحمن بن ثوبان عن أمه عائشة(@)(@@)(@@)(@@) $ 1394 - (@)(@@) محمد بن كعب القرظي عمن حدثه عن بن مسعود(@)(@@)(@@)(@@) $ 1395 - (@)(@@) محمد بن أبي يحيى الأسلمي عن أمه عن أم بلال بنت هلال(@)(@@)(@@)(@@) $ 1396 - (@)(@@) محمد الزهري عن رجل من الأنصاري من أهل الفقه عن عثمان بن عفان(@)(@@)(@@)(@@) $ 1397 - (@)(@@) محمد الزهري أيضا عن رجل من الأنصار غير متهم عن عثمان هو الأول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1398 - (@)(@@) محمد الزهري عن فلان بن عمرو بن أمية الضمري عن أبيه فلان هو جعفر بن عمرو بن أمية(@)(@@)(@@)(@@) $ 1399 - (@)(@@) مرثد بن عبد الله البزني قال حدثني بعض أصحاب النبي عليه السلام عن النبي عليه السلام أن ظل المؤمن يوم القيامة صدقته(@)(@@)(@@)(@@) $ 1400 - (@)(@@) مسروق عن رجل نزل عليه عن عبد الله بن عمرو بن العاص بحديث من لقي الله لا يشرك به شيئا(@)(@@)(@@)(@@) $ 1401 - (@)(@@) مسلم بن أبي مريم عن رجل من الأنصاري عن علي بحديث من عاد مريضا مشي في حرف الجنة(@)(@@)(@@)(@@) $ 1402 - (@)(@@) مطرف بن عبد الله بن الشخير عن أعرابي رأى على النبي عليه السلام نعلين محصوفين(@)(@@)(@@)(@@) $ 1403 - (@)(@@) معبد بن كعب بن مالك عن أمه وكانت وصلت القبلتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1404 - (@)(@@) معمر عن رجل عن عمرو بن وابصة بن معبد الأسدي اسم الرجل إسحاق بن راشد الحرزي(@)(@@)(@@)(@@) $ 1405 - (@)(@@) معمر عن عبيد الله بن عمرو عن شيخ سماه عن نعيم بن النحام قال سمعت 