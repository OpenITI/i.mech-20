ms41	(@)(@@) % على أناس بانوا وكانوا % % ذخري ليومي ضري ونفعي % % 7(@)(@@) % فليت شعري بأي حكم % يا ابن علي وأي شرع % 8(@)(@@) % سوغت بعد لوصال هجري % % عمدا وبعد العطاء منعي % % 9(@)(@@) % فارع عهود الإخاء وأكرم % % PageV01P173 البحر : منسرح 1(@)(@@) % خليفة لله أنت ب لدين و ل % % وأمر الإسلام مضطلع % 2(@)(@@) % أنت لما سنه لأئمة أع % لام لهدى مقتف ومتبع % 3(@)(@@) % قد عدم العدم في زمانك % جور معا و لخلاف و لبدع % 4(@)(@@) % ف لناس في لعدل و لسياسة و لإ % % حسان والشرع كلهم شرع % 5(@)(@@) % يا ملكا يردع الحوادث والأ % % يام من ظلمنا قترتدع % 6(@)(@@) % يا من له أنعم مكررة % لنا مصيف منها ومرتبع % 7(@)(@@) % أرضي قد أجدبت وليس لمن % أجدب يوما سواك منتجع % 8(@)(@@) % ولي عيال لا در درهم % قد أكلوني دهري وما شبعوا % % 9(@)(@@) % لو وسموني وسم لعبيد وبا % % عوني بسوق الأعراب ما قنعوا % % 10(@)(@@) % إذا رأوني ذا ثروة جلسوا % % حولي ومالوا إلي و جتمعوا % % PageV01P174 11(@)(@@) % وطالما قطعوا حبالي إع % راضا إذا لم يكن معي قطع % 12(@)(@@) % يمشون حولي شتى كأنهم % عقارب كلما سعوا لسعوا % % 13(@)(@@) % فمنهم لطفل و لمراهق و ل % والمرضع يحبو والكهل واليفع % 14(@)(@@) % لا قارح منهم أؤمل أن % ينالني خيره ولا جذع % 15(@)(@@) % لهم حلوق تفضي إلى معد % تحمل في لأكل فوق ما تسع % 16(@)(@@) % من كل رحب لمعاء أجوف نا % % ري الحشا لا يمسه الشبع % 17(@)(@@) % لا يحسن المضغ فهو يطرح في % % فيه بلا كلفة ويبتلع % 18(@)(@@) % ولي حديث يلهي ويعجب من % % يوسع لي خلقه فيتسع % 19(@)(@@) % نقلت رسمي جهلا إلى ولد % لست بهم ما حييت أنتفع % 20(@)(@@) % نظرت في نفعهم وما أنا في % % تلاب نفع لأولاد مبتدع % PageV01P175 21(@)(@@) % وقلت هذا بعدي يكون لكم % فما أطاعوا أمري ولا سمعوا % % 22(@)(@@) % و ختلسوه مني فما تركوا % % عيني عليه ولا يدي تقع % 23(@)(@@) % فبئس و لله ما صنعت فأض % ررت بنفسي وبئس ما صنعوا % % 24(@)(@@) % فإن أردتم أمرا يزول به % لخصام من بيننا ويرتفع % 25(@)(@@) % ف ستأنفوا لي رسما 
ms42	 أعوذ على % % ضنك معاشي به فأتسع % 26(@)(@@) % وإن زعمتم أني أتيت بها % % خديعة ف لكريم منخدع % 27(@)(@@) % حاشى لرسمي لقديم ينسخ من % نسخ دواوينكم وينقطع % 28(@)(@@) % فوقعوا لي بما سألت فقد % أطمعت نفسي و ستحكم لطمع % 29(@)(@@) % ولا تطيلوا معي فلست ولو % دفعتموني بالراح أندفع % 30(@)(@@) % وحلفوني أن لا تعود يدي % % ترفع في نقله ولا تضع % PageV01P176 البحر : كامل تام 1(@)(@@) % ما كنت أول حافظ لمضيع % والغدر من حسناء غير بديع % 2(@)(@@) % ماذا على لأيام أيام لصبى % % لو أنها سمحت لنا برجوع % 3(@)(@@) % وعلى لليالي لو تكر معيدة % ما فرقت من شملنا لمجموع % 4(@)(@@) % وعلى شموس في الخدور غوارب % لو أذنت بعد النوى بطلوع % 5(@)(@@) % لم تبك يوم فراقكم عيني دما % إلا وقد نزح البكاء دموعي % % 6(@)(@@) % ودعت عيسهم فيا لله ما % % صنعت بقلبي ساعة التوديع % 7(@)(@@) % بانوا بسكر اللحظ صاح قلبها % % مما تجن جوانحي وضلوعي % % 8(@)(@@) % لحظ به يدوى لصحيح فليتها % % أبقت على قلب بها مصدوع % 9(@)(@@) % قالت أتقنع أن أزورك في لكرى % % فتبيت في حكم المنام ضجيعي % % 10(@)(@@) % وأبيك ما سمحت بطيف خيالها % % إلا وقد ملكت علي هجوعي % % PageV01P177 11(@)(@@) % يا سلم إن الحب أسلمني إلى % % شغلين من وجد بكم وولوع % 12(@)(@@) % وهواك يا ذات للما لمعسول غا % % درني أبيت بليلة الملسوع % 13(@)(@@) % يا قارعا بالعذل سمعي بعد ما % % علق لفؤاد دعوت غير سميع % 14(@)(@@) % أنا في الغرام بها ومجد الدين في % % حب لندى للعذل غير مطيع % PageV01P178 البحر : مجزوء الخفيف 1(@)(@@) % أيها لرائح لمجد % وأنفاسنا معه % 2(@)(@@) % سرت في الحفظ والكلا % % ءة والأمن والدعه % 3(@)(@@) % وتلقاك من منا % % زلك الرحب والسعه % 4(@)(@@) % كلما استشعرت فرا % % قك عادت مسترجعه % 5(@)(@@) % وفؤاد حنا الغرا % % م على لشوق أضلعه % PageV01P179 البحر : رجز تام 1(@)(@@) % خليفة لله لذي % % وعوده لا تخلف % 2(@)(@@) % ويا إماما أعجزت % صفاته من يصف % 3(@)(@@) % ما عنده لسائل % رد ولا توقف % 3(@)(@@) % % ت موسدي خدا وسالف % 4(@)(@@) % وللسماح و لندى % % تليده والمطرف % 4(@)(@@) % وهمه لخدمة في ل % % 5(@)(@@) % % مدح كنوار لربي 
ms43	 % % 5(@)(@@) % يا من له عزم كحد المشرفي مرهف % ه تذرف % 6(@)(@@) % فاقي عليه تدرف % الكماة ترجف % 7(@)(@@) % حلفة بر صادق ل % % PageV01P180 7(@)(@@) % ومن له شمائل % من الشمول ألطف % 8(@)(@@) % ومقلة عن الرعا % % يا طرفها لا يطرف % 8(@)(@@) % لله ليلات خلت % منه وأيام سوالف % 9(@)(@@) % أيامه لحسنها % % روضة حزن أنف % 9(@)(@@) % خيث الحبيب مساعد % يا من له عزم كح % 10(@)(@@) % ليس بها ظلم ولا % % جور ولا تعجرف % 11(@)(@@) % ع وشيه مفوف % باللحظات يقطف % 12(@)(@@) % أوما ترى هيف الغصون % % 12(@)(@@) % وريقة يمزج لي % % بها السلاف القرقف % 13(@)(@@) % % طربا ودمع المزن واكف % PageV01P181 14(@)(@@) % ومخطف لوني إذا % % رأيته ينخطف % 15(@)(@@) % أعطفه وقلبه % كالصخر لا ينعطف % 16(@)(@@) % وعيشة دهري علي % مثلها لا تخلف % 17(@)(@@) % وهل لماض من شبا % % ب عوض أو خلف % 18(@)(@@) % لهفي على أيامها % % لو ينفع لتلهف % 20(@)(@@) % إن أبا العباس عد % ل في القضاء منصف % 21(@)(@@) % وإنه أكرم من % داس لثرى وأشرف % 22(@)(@@) % وإن مدحي فيه لا % يدخله لتكلف % 23(@)(@@) % بذل النوال لكل را % % لهجة حين يحلف % 24(@)(@@) % أبهى من لدر إذا % % ما شق عنه لصدف % PageV01P182 25(@)(@@) % كالماء ما في نظمه % كل ولا تكلف % 26(@)(@@) % قد ملئت عني بما % % أمليت منه لصحف % 27(@)(@@) % فاغتنموا مدحي فإني % % زائر منصرف % 28(@)(@@) % قد شبت في خدمتكم % ولي بذاك الشرف % 29(@)(@@) % من معشر بولائهم % % 29(@)(@@) % و لعبد كيء شامط % يخشى عليه لتلف % 30(@)(@@) % وليس بعد لشيب إلا % ميتة أو خرف % 31(@)(@@) % وخلفه عائلة % أغراضهم تختلف % 32(@)(@@) % قد ألزموه كلفا % وأين منه لكلف % 33(@)(@@) % وفيه مع مغارم % يحملها تعقف % PageV01P183 34(@)(@@) % تأنف من مدح لليام % نفسه وتعزف % 35(@)(@@) % ما هو مثل غيره % مدروز مقيف % 35(@)(@@) % وفيه مع مغامر % % 37(@)(@@) % ف نظر إليه نظرة % وقد أبل المدنف % 38(@)(@@) % فحاله يصلحها % % تدبيرك لملطف % 39(@)(@@) % ما دام ريان لقضيب ع % % 39(@)(@@) % وقد نشا للكي يا % % مولى الأنام مخلف % 41(@)(@@) % يشعفني حبا وما % % زال الصغير يشعف % 42(@)(@@) % وما له بعدي مو % روث ولا مخلف % 43(@)(@@) % وليس لي ملك ولا % % PageV01P184 45(@)(@@) % وهو وقد 
ms44	 بلوته % مهذب مثقف % 46(@)(@@) % ما فيه لا كبر ولا % تيه ولا تعجرف % 47(@)(@@) % قد أينعت أثماره % وعن قليل تقطف % 49(@)(@@) % فاغرسه لي في خدمة % يسمو بها ويشرف % 50(@)(@@) % يعلو بها بين الأنام % قدره ويعرف % 52(@)(@@) % وبعد شهرين إذا % % ما دار فيه العلف % 53(@)(@@) % وأقبل العيد الذي % % تنفق فيه لعرف % 54(@)(@@) % تراه في لموكب وهو % % PageV01P185 البحر : كامل تام 1(@)(@@) % دار الهوى بين اللوى وشراف % من مربع أقوى ومن مصطاف % 2(@)(@@) % صابت ثراك من لدموع مواطر % تغنيك عن صوب لحيا لوكاف % 3(@)(@@) % جسدي كما بليت طلولك بعدهم % بال وصبري مثل ربعك عاف % 4(@)(@@) % ولقد عهدتك في الشبيبة مألفا % نغشاه قبل تفرق لألاف % 5(@)(@@) % قف وقفة يا سعد في آثارهم % إن كنت تؤثر في الهوى إسعافي % % 6(@)(@@) % و كرم محلا خف عنه قطينه % عن أن يداس ثراه بالأخفاف % 7(@)(@@) % و شف لعليل من لوقوف بمنزل % في لقلب من ذكراه وخز أشاف % 8(@)(@@) % وانشد فؤادا باللوى أضللته % بين لغصون لهيف و لأحقاف % 9(@)(@@) % لله عهد هوى وعصر شبيبة % فارقته فتجمعت أطرافي % % 10(@)(@@) % أيام لا تعصي الغواني في الهوى % % حكمي ولا تنوي لحسان خلافي % % PageV01P186 11(@)(@@) % إذ لا ظلوم تسر لي ظلما ولا % % ذات لنصيف تميل عن إنصافي % % 12(@)(@@) % وعلي من حلل الصبى فضفاضة % أختال في حبراتها الأفواف % 13(@)(@@) % ألهو بمعشوق الشمائل مخطف % بطل للحاظ مخنث لأعطاف % 14(@)(@@) % شكوى لمحب إليه من ثقل لهوى % % PageV01P187 البحر : بسيط تام 1(@)(@@) % لم يبق فيك لمشتاق إذا وقفا % % إلا ادكار رسوم تبعث الأسفا % % 2(@)(@@) % ونظرة ربما أرسلت رائدها % % والطرف ينكر من معناك ما عرفا % % 3(@)(@@) % يا منزلا باللوى أقوى معالمه % لم يعف وجدي على سكانه وعفا % % 4(@)(@@) % لولاك ما هاجني نوح الحمام ولا % % هفا بي لبرق علويا إذا خطفا % % 5(@)(@@) % أعائد وأحاديث المنى خدع % على لغضا زمن من عيشنا سلفا % % 6(@)(@@) % هيهات أن تخلف لأيام من عمري % % شبيبة فيكم أنفقتها سرفا % % 7(@)(@@) % وباخل سمح لطيف لكذوب به % والليل قد مد من ظلمائه سجفا % % 8(@)(@@) % أسرى إلي على ما فيه من 
ms45	 فرق % تحت الدجى يركب الأهوال معتسفا % % 9(@)(@@) % فبت من قده للغصن معتنفا % طورا ومن خده للخمر مرتشفا % 10(@)(@@) % فيا له من بخيل كيف جاد لنا % % عفوا ومن غادر ب لعهد كيف وفا % % PageV01P188 11(@)(@@) % وفاتر الطرف ممشوق القوام له % قد يعلم خوط البانة الهيفا % % 12(@)(@@) % إن قلت جرت على ضعفي يقول متى % % كان لمحب من لمحبوب منتصفا % % 13(@)(@@) % أو قلت أتلفت روحي قال لا عجب % من ذاق طعم الهوى يوما وما تلفا % % 14(@)(@@) % إن أنكرت من دمي عيناه ما سفكت % فقد أقر به خداه و عترفا % % 15(@)(@@) % ما قلتم الغصن ميال ومنعطف % فكيف مال على ضعفي وما عطفا % % 16(@)(@@) % يا صاح قم فوجوه اللهو سافرة % وناظر الهم بالأفراح قد طرفا % % 17(@)(@@) % كسا لربيع ثراها من خمائله % % ريطا وألقى على كبانها قطفا % % 18(@)(@@) % والغيم باك وثغر النور مبتسم % وطائر لبان في لأغصان قد هتفا % % 19(@)(@@) % والثغر ريان لدن العطف قد عقدت % لآلىء لطل من أوراقه شنفا % % 20(@)(@@) % فانهض إلى الراح واعذر في الغرام بها % % لا تلح من بات مشغوفا بها كلفا % % PageV01P189 21(@)(@@) % واحب النديم بها حمراء صافية % صرفا إذا ثبتت في صدره رجفا % % 22(@)(@@) % راحا كأن عماد الدين شاب بها % % في لكأس ما رق من أخلاقه وصفا % % 23(@)(@@) % في جنة جادها وسمي راحته % و متد فيها علينا ظله وضفا % % 24(@)(@@) % حيث التقينا رأينا من صنائعه % ومن سجاياه فيها روضة أنفا % % 25(@)(@@) % أعدت شمائله مر لنسيم بها % % وكلما هب في أرجائه لطفا % % 26(@)(@@) % على شفا جدول في أبرديه إذا ع % تل لنسيم لأدواء لهموم شفا % % 27(@)(@@) % يزهى بملك إذا سحب لحيا بخلت % تبدو له مني فيسترها % % 28(@)(@@) % جذلان يصبح شمل المال منصدعا % في راحتيه وشمل لحمد مؤتلفا % % 29(@)(@@) % يا من يلوم عليا في مواهبه % هيهات حاولت منه غير ما ألفا % % 30(@)(@@) % فهل يلام عباب البحر إن زخرت % أمواجه ومهب لريح إن عصفا % % PageV01P190 31(@)(@@) % أقسمت لو كان يدري ما الحياء حيا % أرضا بها نزلت جدواه ما وكفا % % 32(@)(@@) % عان على الشرف الموروث تالده % بما 
ms46	 استجد من العلياء أو طرفا % % 33(@)(@@) % ما زاده قومه فخرا وإن بلغوا % % في لمجد شأوا على من رامه قذفا % % 34(@)(@@) % فالأنجم الزهر والشهب الثواقب لو % كانت عشائره زادت به شرفا % % 36(@)(@@) % ماضي الغرار إذا البيض الحداد نبت % ثبت الجنان إذا قلب الحليم هفا % % 37(@)(@@) % يستل من عزمه في الروع ذا شطب % عضبا ويلبس من آرائه زعفا % % 38(@)(@@) % كأن غرته و لخطب معتكر % بشائر الصبح جلا نورها السدفا % % 39(@)(@@) % تلقى لغنى عنده إن جئت مجتديا % والعفو إن جئته للذنب معترفا % % 40(@)(@@) % ما للزمان ولي حتام تجمع لي % % أيامه مع سواء الليلة الخسفا % % 41(@)(@@) % يسوم ذؤبانه مدحي ويطمع في % % أني أنازعها أشلاءها لجيفا % % PageV01P191 42(@)(@@) % هيهات ترهب نفسي عن مطامعها % % وصنت فضلي عن إدناسها صلفا % % 43(@)(@@) % لله در أبي لنفس ممتعض % لفضله أن يلاقي لحيف و لجنفا % % 44(@)(@@) % يأبى غضارة عيش جر ملبسها % % ذلا ويختار عز لنفس و لقشفا % % 45(@)(@@) % قالوا انتزح وتغرب تكتسب شرفا % فالدر ما عز حتى فارق الصدفا % % 46(@)(@@) % أأترك لبحر دوني سائغا غدقا % وأجتدي وشلا بالجو منتزفا % % 47(@)(@@) % أبت عطايا علي أن أمد إلى % % يدي يدا كفني معروفه وكفا % % 48(@)(@@) % كم رد عني سهام الدهر طائشة % ولم أزل لمرامي صرفه هدفا % % 49(@)(@@) % وكم دعوت أبا نصر لحادثة % جلت فما خار عن نصري ولا صدفا % % 50(@)(@@) % أحلني من جميل لرأي منزلة % غدوت منها لظهر لنجم مرتدفا % % 51(@)(@@) % % وإن دعوت به في غمة كشفا % % PageV01P192 52(@)(@@) % يا من إذا قال أعي لقائلون له % ومن إذا جاد أعطى لجلة لشرفا % % 53(@)(@@) % فداك كل قصير لباع منسلخ % من المكارم مهجو إذا وصفا % % 54(@)(@@) % لا تعرف العرف كفاه ولا هو إن % حاولت تعريفه في محفل عرفا % % 55(@)(@@) % ف سمع دعاء ولي بات مبتهلا % فيه وظل على لإخلاص معتكفا % % 56(@)(@@) % مدحا ملأت به قلب لحسود جوى % % كما ملأت بطون الكتب والصحفا % % 57(@)(@@) % سرى فما عرس الركبان في طرف % إلا رأوا فيه من مدحي لكم طرفا % % 58(@)(@@) % ف فن لليالي و لأيام ساحب أذ % يال لسعادة ما 
ms47	 كرا وما اختلفا % % PageV01P193 البحر : بسيط تام 1(@)(@@) % يا من إذا ضنت لأيام جائرة % عم لبرية إسعافا وإنصافا % % 2(@)(@@) % ومن أمنت به دهري وحادثه % ولست أخشاه إن داجى وإن صافا % % 3(@)(@@) % تعطي الألوف إذا الجعد اليدين غدا % % يعطي الدراهم أثلاثا وأنصافا % % 4(@)(@@) % لا زلت تبلي جديد لدهر مغتبطا % صوما وفطرا وأعيادا وأنصافا % % PageV01P194 البحر : سريع 1(@)(@@) % يا زمن السوء الذي مسني % % بغمرة ليس لها كاشف % 2(@)(@@) % صحبته قدما فما سرني % % سالف أيامي ولا لآنف % 3(@)(@@) % إذا كلوم الهم ذاويتها % % عاد لها من جوره قارف % 4(@)(@@) % وكلما أغضيت عن زلة % أغراه عفوي بي فيستانف % 5(@)(@@) % يخضع منه للدنايا على % % غرتها لجبهة و لسالف % 6(@)(@@) % ما لك لا ينفق في سوق أب % نائك إلا لبهرج لزائف % 7(@)(@@) % فكم أداجيهم على أنني % % طب بأدوائهم عارف % 8(@)(@@) % ورب مشاء على علة % وهو إذا استثبته واقف % 9(@)(@@) % يحسدني لناس على مورد % مكدر ينزحه لراشف % 10(@)(@@) % وصاحب همي ما سره % وهو على ما ساءني عاكف % PageV01P195 11(@)(@@) % إذا بدت مني له هفوة % أعرض لا يعطفه عاطف % 12(@)(@@) % لا يدرك لعلياء إلا فتى % % آب على حمل لأسى عازف % 13(@)(@@) % ولا ينال العز حتى يرى % % خابط ليل نوؤه واكف % 14(@)(@@) % ف رحل متى آنست ذلا ولا % يعتاقك التالد والطارف % 15(@)(@@) % فما يسوم لخسف إلا هوى % % أو منزل أنت به آلف % 16(@)(@@) % لا سلمت دار ولا خلة % أنت على آثارها تالف % 17(@)(@@) % يا دولة ما نالني خيرها % % وإنني من شرها خائف % 18(@)(@@) % ناءت صروف لدهر عنها فما % % يطوف للذعر بها طائف % 19(@)(@@) % فارقب لها إن رقدت فتنة % نكباء شر ريحها عاصف % PageV01P196 البحر : بسيط تام 1(@)(@@) % لا بارك لله في قوم صحبتهم % فما رعوا حرمتي يوما ولا عرفوا % % 2(@)(@@) % ولا وصفت قبيحا من فعالهم % إلا وعندهم بي فوق ما أصف % 3(@)(@@) % لأصبرن على إدمان ظلمهم % عسى الليالي تواتني فأنتصف % PageV01P197 البحر : كامل تام 1(@)(@@) % ألدست من لألاء وجهك مشرق % وعلى لوزارة من جلالك رونق % 2(@)(@@) % ما إن رأت كفوا لها حتى رأت % سود البنود 
ms48	 على لوائك تخفق % 3(@)(@@) % قرت بلابل صدرها ولقد ترى % % وبها إليك صبابة وتشوق % 4(@)(@@) % أليوم أسفر دستها ولطالما % % شمناه وهو من الكآبة مطرق % 5(@)(@@) % كانت بمضيعة تعاوي سرحها الذؤبان والغربان فيها تنفق % ذؤبان و لغربان فيها تنفق % 6(@)(@@) % ردت إليك فأصلها بك ثابت % عالي لبناء وفرعها بك مورق % 7(@)(@@) % أنتم وإن رغم لعدى وراثها % % PageV01P198 البحر : رجز تام 1(@)(@@) % خليفة لله لذي % % آراؤه موفقه % 4(@)(@@) % بحق من صدق ما % % لام فتقا رتقه % 5(@)(@@) % أطبق أبا سعد وخذ % منه قراح الطبقه % 6(@)(@@) % حتى ترى أحشاؤه % بغيظها ممزقه % 7(@)(@@) % يمسي على المورقي % عينه مؤرقه % 8(@)(@@) % و ستخرج لمال لذي % % جمعه و رتفقه % 9(@)(@@) % حصله خيانة % طورا وطورا سرقه % 10(@)(@@) % لا تجب الزكاة في % % أمثاله والصدقه % 11(@)(@@) % جمعه وأنت أو % لى أن تكون منفقه % 12(@)(@@) % واستجلها دردا صحا % % حا وزنا محققه % PageV01P199 13(@)(@@) % مثل لوجوه لبدويا % % ت لحسان لمشرقه % 14(@)(@@) % كأنها من حسنها % % روضة حزن مؤنقه % 15(@)(@@) % وسلط لخرج على % % جموعها و لنفقه % 16(@)(@@) % حتى تراها وهي في % % أربابها مفرقه % PageV01P200 البحر : رمل تام 1(@)(@@) % يا صلاح ل % % دين خذ ح % 2(@)(@@) % فلقد وافاك في ثو % بي عناد ونفاق % 3(@)(@@) % لا يغرنك منه % منطق حلو المذاق % 4(@)(@@) % % ذرك من صل لعراق % 6(@)(@@) % ليس فيه شيء يدور على الضرس % ذرك من صل لعراق % 6(@)(@@) % دق لؤما فتفطن % في معانيه الدقاق % 7(@)(@@) % لو ظفرنا فيه بمرعى وريق % لعذرناك أو بمرأى أنيق % 9(@)(@@) % لا تخالطه وسائل % عنه أخلاط الرفاق % 10(@)(@@) % فهو داء في الخياشيم شجا بين التراقي % % ن لتراقي % % 11(@)(@@) % أكذب الناس إذا آ % % PageV01P201 17(@)(@@) % وجروح تعجز النا % % 23(@)(@@) % وغدت تلعب فيها % % فهو داء في لخياش % 32(@)(@@) % % باللؤم والغدر صفاق % PageV01P202 البحر : مجتث 1(@)(@@) % وحلوة الريق باتت % في حضن غصن وريق % 2(@)(@@) % أعدى إليها فرقت % من لنسيم لرقيق % 3(@)(@@) % مكفوفة القد بيضا % % ء ذات مرأى أنيق % 4(@)(@@) % كأنها تملأ لك % % 4(@)(@@) % تشق عن أحمر للو % ن قانيء ك لشقيق % 6(@)(@@) % تجني ويجنى عليها % % فما لها من صديق % 7(@)(@@) % طفنا بها 
ms49	 فسقتنا % % ريقا كطعم لرحيق % 8(@)(@@) % أي اجتماع قضينا % % عليه بالتفريق % PageV01P203 البحر : رجز تام 1(@)(@@) % عسى غزال لأبرق % يرق لي من أرقي % % 2(@)(@@) % ويجمع لأيام من % شمل هوى مفرق % 3(@)(@@) % أغيد مقلاق الوشاح % نائم عن قلقي % % 4(@)(@@) % أسلمني للوجد وهو % سالم من حرقي % % 5(@)(@@) % لا تعلق السلوة في % % قلب به معلق % 7(@)(@@) % عانقني ولم يكن % لولا لنوى معتنقي % % 8(@)(@@) % وكان لا يسمح لي % % ب لنظر لمسترق % 9(@)(@@) % ولم أخل أن اللقاء % رائد لتفرق % 10(@)(@@) % وأننا يوم لوداع % يرق لي من أرقي % % 24(@)(@@) % أنت جلبت الهم يا % % طرفي لقلبي فذق % PageV01P204 35(@)(@@) % % اء لزلال مشرقي % % PageV01P205 البحر : بسيط تام 1(@)(@@) % قل لصديقي أبي علي % ما هكذا يفعل لصديق % 2(@)(@@) % أتيت ما لم يكن بمثلي % % ولا بأمثالكم يليق % 3(@)(@@) % نقضت عهدي وكان ظني % % بأنه محكم وثيق % 4(@)(@@) % وكنت تنسى حقي وكانت % مرعية عندك الحقوق % 5(@)(@@) % قد كنت أوعدتني بوعد % أنت بأمثاله خليق % 6(@)(@@) % أنك تجلو همي بيوم % يجمع أطرافه الفسوق % 7(@)(@@) % يبل فيه غليل صدري % % شرابك المسكر العتيق % 8(@)(@@) % أخلفتني و نفردت عني % % أما استحى وجهك الصفيق % 9(@)(@@) % وقد تحققت في أني % % صب إلى شربها مشوق % 10(@)(@@) % وأنني في هوى لوجوه ل % حسان ما عشت ما أفيق % PageV01P206 11(@)(@@) % أضاق عني لكم فناء % عن لاخلاء لا يضيق % 12(@)(@@) % وهل علمتم بأن شكري % % عبد لإحسانكم رقيق % 13(@)(@@) % أما وحق لمدام صرفا % يخجل من لونها الشقيق % 14(@)(@@) % وكل هيفاء ذات دل % يقتلني قدها لرشيق % 15(@)(@@) % يشكو إلى ردفها لمعبا % % من جوره خصرها الدقيق % 16(@)(@@) % للصب من ورد وجنتيها % % ورد ومن ثغرها رحيق % 17(@)(@@) % إن ك إن لم تصخ لعتبي % % جاءك مني ما لا تطيق % 18(@)(@@) % وإننا الدهر لا التقينا % % إلا وقد ضمنا لطريق % PageV01P207 البحر : مجزوء الكامل 1(@)(@@) % لأبي علي مرتقى % % في ذروة العلياء شاهق % 2(@)(@@) % ومواهب كالغيث يتبع سابقا منها بلاحق % بع سابقا منها بلاحق % 3(@)(@@) % وبوجهه بشر مخا % % ئله لشائمه صوادق % 4(@)(@@) % قسما بمزجي السحب تحدوها الرواعد والبوارق % دوها لرواعد و لبوارق % 5(@)(@@) % ومسير الشهب الثوا % % قب 
ms50	 في المغارب والمشارق % PageV01P208 البحر : مديد تام 1(@)(@@) % يا جلال الدين يا ملكا % هو في أفعاله ملك % 2(@)(@@) % وجوادا ما له أبدا % بالندى في الناس مشترك % 3(@)(@@) % يا مصون العرض وافره % وحمى الأعراض منتهك % 4(@)(@@) % والصدوق الوعد في زمن % أهله إن حدثوا أفكوا % % 5(@)(@@) % أنت والأحلام طائشة % ثابت الأرآء محتنك % 6(@)(@@) % لك بالإقبال دار وإن % رغمت أعداؤك الفلك % 7(@)(@@) % فابق منصورا فقد هبطوا % % وارق موفورا فقد هلكوا % % 8(@)(@@) % واستمع من شاعر يده % بك بعد الله تمتسك % 9(@)(@@) % هزه فيك الرجاء فآماله في الصدر تعترك % في الصدر تعترك % 10(@)(@@) % حل زوراء العراق كما % % حل قيعان السما السمك % PageV01P209 11(@)(@@) % أنا في توقيع جائزتي % % طول هذا الليل مرتبك % 12(@)(@@) % فقلد كادت ضلوعي من % حر نار الفكر تنسبك % 13(@)(@@) % شاع أمري فيه و متلأت % بحديثي الطرق والسكك % 14(@)(@@) % رجموا في الظنون فكم % مسلك في الإثم قد سلكوا % % 15(@)(@@) % محنة لم يرم قط بها % % سوقة قبلي ولا ملك % 16(@)(@@) % سيما والأمر في يد من % هو في الإحسان منهمك % 17(@)(@@) % ودما الأموال طافحة % بيد السؤال تنسفك % 18(@)(@@) % فتدارك قصتي فعلى % % يدك المبسوطة الدرك % 19(@)(@@) % و قتنص حر الثناء فما % % كل وقت يعلق الشرك % PageV01P210 البحر : مديد تام 1(@)(@@) % سل عن الماضين إن نطقت % عنهم الأجداث والبرك % 2(@)(@@) % أي دار للبلا نزلوا % % أو سبيل للردى سلكوا % % 3(@)(@@) % ملكوا الدنيا فما دفع الم % وت ما حازوا وما ملكوا % % 4(@)(@@) % بيد الأيام منتهك % برجال طالما فتكوا % % 5(@)(@@) % ضحكوا حينا فعاد أسى % % وبكاء ذلك الضحك % 6(@)(@@) % وبرتها للزمان يد % ما عليها في دم درك % 7(@)(@@) % يا أخا الخمسين باهرها % % وهو في دنياه منهمك % 8(@)(@@) % بات مغرورا تمد له % من حبالات الردى شبك % 9(@)(@@) % لاهيا والعمر منتهب % % 10(@)(@@) % قف قليلا قد بلغت مدى % % للمنايا فيه معترك % PageV01P211 البحر : متقارب تام 1(@)(@@) % لميمون وجه يسوء العيون % منظره الأسود الحالك % 2(@)(@@) % وحمامه مظلم بارد % يضل بأرجائه السالك % 3(@)(@@) % وهب أن حمامه جنة % أليس على بابه مالك % PageV01P212 البحر : كامل تام 1(@)(@@) % لا تخش إملاقا إذا عتلقت % كفاك 
ms51	 بي فالنجح في دركي % % 2(@)(@@) % فالنسر لو قصدته بندقة % مني لأردته عن الفلك % 3(@)(@@) % نهضت غواربها من ال % أشواق بالعبء الثقيل % 4(@)(@@) % متلفتات من شرا % % ف إلى سنا برق كليل % 9(@)(@@) % يا دار لا برحت تجو % % دك كل غادية هطول % 10(@)(@@) % وتنفست ريح الصبا % % حران في عافي الطلول % 11(@)(@@) % هل لي إلى ذات القلا % % ئد والمراسل من رسول % 12(@)(@@) % فيبث ما بي من ضنا % % باد وداء هوى دخيل % 13(@)(@@) % ومن المحال تنظري % % ملاعب الحي الحلول % 14(@)(@@) % وعلى النقا من وجرة % بلهاء تلعب بالعقول % PageV01P213 15(@)(@@) % في ضم ما ضمت غلا % ئلها شفاء للغليل % 17(@)(@@) % ما بين خوط أراكة % منها وحقف نقا مهيل % 18(@)(@@) % مح بي ويحزن في السهول % يبدو لشائمه كمخ % 19(@)(@@) % ني إلى هم طويل % ي وريقة بعد الذبول % 22(@)(@@) % يا بين كم أجليت يو % من آله آل النب % 23(@)(@@) % ما للعذول ولم أزل % كلفا بعصيان العذول % 25(@)(@@) % صلف ملول آه وا % % قوام في الليل الطويل % 26(@)(@@) % يا سعد أنجدني على ال % ل بخصره الواهي النحيل % 30(@)(@@) % ألثابت الأرآء في % % دحض بواطئه زليل % 35(@)(@@) % بأكف فتيان لهم % في الروع أحلام الكهول % PageV01P214 36(@)(@@) % من كل أغلب باسل % غير الجبان ولا النكول % 37(@)(@@) % يسري وحيدا وهو من % حد العزيمة في رعيل % 38(@)(@@) % يهوي به أظمى الفصو % % ص مطهم سامي التليل % 39(@)(@@) % عزمات منصور العزا % % ئم لا ينام على الذحول % 41(@)(@@) % ما أجدبت أرض سقا % % ها صوب نائله الهطول % 43(@)(@@) % لقحت على طول الحيا % % ل وروضت بعد المحول % 45(@)(@@) % جيران بيت الله ذي % % الحرمات والشرف الأثيل % 46(@)(@@) % من معشر يرعى ذما % % م الجار فيهم والنزيل % 47(@)(@@) % يأوي الطريد إلى ظلا % % ل بيوتهم و بن السبيل % 48(@)(@@) % أطواد حلم في الند % ي وفي الوغا آساد غيل % PageV01P215 49(@)(@@) % لهم قديم مآثر % مأثورة عن جبرئيل % 50(@)(@@) % بالناصر المولى الإما % % م وجوده الجم الجزيل % 51(@)(@@) % شيدت مبانيهم وقد % تربي الفروع على الأصول % 52(@)(@@) % ورث الخلافة عنهم % والملك جيلا بعد جيل % 53(@)(@@) % فإذا نتمى عد الجدو % % د الأنبياء 
ms52	 إلى الخليل % 58(@)(@@) % وأحلني في وارف % من ظل دولته ظليل % 59(@)(@@) % ولبست من نعمائه % حصداء سابغة الذيول % 60(@)(@@) % والدهر يرمقني بطر % ف من حوادثه كليل % 63(@)(@@) % أحسنت في الدهر المسي % % ء وجدت في الزمن المحيل % 64(@)(@@) % فإليك رائقة فصا % % حتها بأشعار الفحول % PageV01P216 65(@)(@@) % ما ضرها أن لا تكو % % ن عقيلة لابي العقيل % 66(@)(@@) % فضلت على أخواتها % % فضل الضحاء على الأصيل % 68(@)(@@) % وأطال من تعنيسها % % عدم الكفاة من البعول % 69(@)(@@) % ما للكواكب ما لها % % عند القلوب من القبول % 70(@)(@@) % لم أرض في الدنيا لها % % غير الخليفة من منيل % 71(@)(@@) % ولطالما نزهتها % % عن موقف الشعر الذليل % 72(@)(@@) % وجذبت فضل زمامها % % عن مرتع الطمع الوبيل % 73(@)(@@) % فتمل ملكا ما لرا % % ئعة عليها من سبيل % 74(@)(@@) % وعلو جد ما لطا % % لعه المشرق من أفول % PageV01P217 البحر : كامل تام 1(@)(@@) % غاداك من بحر الرواعد مسبل % وسقتك أخلاف الغيوم الحفل % 2(@)(@@) % وجرت بليل الذيل وانية الخطا % % مسكية النفحات فيك الشمأل % 3(@)(@@) % لله ما حملت من ثقل الهوى % % يوم استقل قطينك المتحمل % 4(@)(@@) % ولطالما قضى الشباب مآربي % % فيك اختلاسا والحوادث غفل % 5(@)(@@) % أيام لا تعصى الغواية في هوى % % الغيد الحسان ولا تطاع العذل % 6(@)(@@) % والبيض تسفر لي فأصدف معرضا % عنها وتنجزني الوعود فأمطل % 7(@)(@@) % ما خلت أن جديد أيام الصبى % % يبلى ولا أن الشبيبة تنصل % 8(@)(@@) % أتغزلا بعد المشيب وصبوة % سفها لرأيك شائبا يتغزل % 9(@)(@@) % هيهات ما للبيض في ود مرىء % إرب وقد ولى الشباب المقبل % 10(@)(@@) % أعرضن لما أن رأين بلمتي % % أمثالهن وقلن داء معضل % PageV01P218 11(@)(@@) % ولرب معسول المراشف واللمى % % من دونه سمر الذوابل تعسل % 12(@)(@@) % متقلد عضب المضارب خصره % من حد مضربه أرق وأنحل % 13(@)(@@) % كالظبي يوم السلم وهو لفتكه % يوم الوغى ليث العرين المشبل % 14(@)(@@) % نادمته والصبح ما ذعر الدجا % % والليل في ثوب الشبيبة يرفل % 15(@)(@@) % وكأن أفراد النجوم خوامس % تدنو لورد والمجرة منهل % 16(@)(@@) % فأدار خمر مراشف ما زلت بالصهباء عن رشفاتها أتعلل % صهباء عن رشفاتها أتعلل % 17(@)(@@) % مشمولة ما فض طين ختامها % % ساق 
ms53	 ولا أنحى عليها مبزل % 18(@)(@@) % ولرب أبيض صارم من لحظه % يحمى به ثغر له ومقبل % 19(@)(@@) % يذكي على قلب المحب رضابه % جمر الغضا وهو البرود السلسل % 20(@)(@@) % لقد سترق له القلوب مهفهف % من قده لدن وطرف أكحل % PageV01P219 21(@)(@@) % يا شاكي اللحظات شكوى مغرم % يلقاك وهو من التجلد أعزل % 22(@)(@@) % أصمت لواحظك المقاتل راميا % أفما يدق على سهامك مقتل % 23(@)(@@) % أغنتك عن حمل السلاح ونقله % نجلاء أمضى من ظباك وأقتل % 24(@)(@@) % لولا نصول ذوائبي لم تلقني % % من غير جرم في الهوى أتنصل % 25(@)(@@) % أمست تلوم على القناعة جارة % سمعي بوقع ملامها لا يحفل % 26(@)(@@) % عابت علي خصاصتي فأجبتها % % منن الرجال من الخصاصة أثقل % 27(@)(@@) % قالت تنقل في البلاد فقلما % % فات الغنى والحظ من يتنقل % 28(@)(@@) % فالمرء تحقره العيون إذا بدا % % إعساره ويهاب وهو ممول % 29(@)(@@) % يا هذه إن السؤال مذلة % وولوج أبواب الملوك تبذل % 30(@)(@@) % كفي الملام فكل حظ معرض % عني بإقبال الخليفة مقبل % PageV01P220 31(@)(@@) % ألمستضيء المستضاء بهديه % والساجد المتهجد المتبتل % 32(@)(@@) % ألمستجاب دعاؤه فالغيث ما % % قنط الثرى بدعائه يتنزل % 33(@)(@@) % ألمستقر من الخلافة في ذرى % شماء لا يسطيعها المترقل % 36(@)(@@) % قرم إذا غشي الوغى فعتاده % مدروبة زرق وسمر ذبل % 37(@)(@@) % ومطهم في السرج منه هضبة % ومثهند في الغمد منه جدول % 38(@)(@@) % ما رد يوما سائلا وله سطا % % بأس يرد بها الخميس الجحفل % 39(@)(@@) % جذلان يكثر في الندى عذاله % إن الكريم على السماح معذل % 40(@)(@@) % يعفو عن الجاني فيوسع ذنبه % عفوا ويعطي سائليه فيجزل % 41(@)(@@) % جار على سنن النبي وسنة % الخلفاء من آبائه تتقبل % 43(@)(@@) % عن جودهم رويت أحاديث النوى % % وبفضلهم نطق الكتاب المنزل % PageV01P221 44(@)(@@) % لا يرتضى عمل بغير ولائهم % فيهم تتم الصالحات وتكمل % 45(@)(@@) % إن كنت تنكر مأثرات قديمهم % فاسأل بها ' يا أيها المزمل ' % 46(@)(@@) % شرفا بني العباس شاد بناءه % لكم فأعلاه النبي المرسل % 47(@)(@@) % ما طاولتكم في الفخار قبيلة % إلا ومجدكم أتم وأطول % 48(@)(@@) % شرفتم بطحاء مكة ف غتدت % بكم يعظم قدرها ويبجل % 49(@)(@@) % أنتم مصابيح الهدى والناس في 
ms54	 % % طرق الجهالة حائر ومضلل % 50(@)(@@) % ف سلم أمير المسلمين مشيدا % ما شيدوا ومؤثلا ما أثلوا % % 51(@)(@@) % يلقى الأمان على حياضك والأما % % ني في جنابك خائف ومؤمل % 52(@)(@@) % إن فاض سيبك فالبحور جداول % أو صاب غيثك فالغمام مبخل % 53(@)(@@) % أو راعنا جدب فجودك مورد % أو غالنا خطب فبأسك معقل % PageV01P222 55(@)(@@) % سست الأنام بسيرة ما سارها % % في الناس إلا جدك المتوكل % 56(@)(@@) % لا حرمة الدين الحنيف مضاعة % كلا ولا حق الرعايا مهمل % 57(@)(@@) % هذبت أخلاق الزمان وطالما % % كانت حوادثه تسيء وتجهل % 58(@)(@@) % وعممت وغمام جودك مسبل % أن لا يصوب بها الغمام المسبل % 60(@)(@@) % وبمدحه ميزان أعمالي إذا % % خفت موازين القيامة تثقل % 61(@)(@@) % كن لي بطرفك راعيا يا من له % طرف برعي العالمين موكل % 62(@)(@@) % فالله ناصر من نصرت وذائد % عمن تذود وخاذل من تخذل % 63(@)(@@) % حللتني من جود كفك أنعما % تضفو ملابسها علي وتفضل % 64(@)(@@) % وفتحت باب مكارم ألفيته % في عصر غيرك وهو دوني مقفل % 65(@)(@@) % ووقفت من شرف الخلافة موقفا % من دونه ستر النبوة مسبل % PageV01P223 66(@)(@@) % ورأيت من حسن ختيارك منظرا % عجبا تحار له العقول وتذهل % 67(@)(@@) % دارا رفعت بناءها ووضعتها % % للجود فهي لكل راج مؤئل % 68(@)(@@) % دارا أقام بها السرور فما له % عن أهلها عمر الزمان ترحل % 69(@)(@@) % يغضي لعزتها النواظر هيبة % فيرد عنها طرفه المتأمل % 70(@)(@@) % حسدت محلتها النجوم فود لو % أمسى يجاورها السماك الأعزل % 71(@)(@@) % ورفعتها عن أن تقبل من بها % % شفة فأضحت بالجباه تقبل % 72(@)(@@) % هي ملجأ للخائفين وعصمة % ومعرس للطالبين ومنزل % 73(@)(@@) % غنيت عن الأنواء أن تغشى لها % % ربعا وفيها العارض المتهلل % 75(@)(@@) % تزهى على أخواتها فكأنها % % أدماء من ظبيات وجرة مغزل % 76(@)(@@) % فات الأوائل شأوها فلو حتبت % في آل حرب لادعاها الأخطل % PageV01P224 77(@)(@@) % تمشي وللأغراض منها صارم % عضب وللأحساب منها صيقل % 78(@)(@@) % مدحا يخيرها لعز جلالكم % عبد له حر الكلام مذلل % 79(@)(@@) % إن كان للشعراء من تيارها % % وشل فلي منها سحائب هطل % PageV01P225 البحر : رجز تام 1(@)(@@) % مولاي مجد الدين يا % % من مجده مؤثل % 2(@)(@@) % يا 
ms55	 من على إحسانه % وفضله يعول % 3(@)(@@) % يا خير من يرجى ويا % % أكرم من يؤمل % 4(@)(@@) % ومن سحاب جوده % بالمكرمات هطل % 5(@)(@@) % ومن له بيت قد % % يم في الفخار أول % 8(@)(@@) % إلى إمام جوده % أللوذعي الأريح % 9(@)(@@) % يقدم والأقدام من % لكل راج موئل % 10(@)(@@) % صوب حيا يهمي وطو % را جذوة تشتعل % 11(@)(@@) % يجزل ما يعطي وما % % كل جواد يجزل % 12(@)(@@) % ل عنده ويجمل % ه مربع ومنهل % PageV01P226 13(@)(@@) % شمائل هي الشمو % % ل رقة والشمأل % 14(@)(@@) % قد عرضت لي حاجة % خفيفة لا تثقل % 15(@)(@@) % ممكنة ليس على % % أمثالها تأول % 16(@)(@@) % وليس عنها عائق % يعوق إلا الكسل % 17(@)(@@) % ما لي إليها بسوى % % مدائحي توصل % 18(@)(@@) % ضمنتها قصيدة % قائلها لا يخجل % 20(@)(@@) % تناصف المديح في % % أبياتها والغزل % 21(@)(@@) % رفعتها إلى إما % % م جاره لا يخذل % 22(@)(@@) % إلى إمام لم يخب % في عصره مؤمل % 23(@)(@@) % أبلج من عصابة % منها النبي المرسل % PageV01P227 24(@)(@@) % قد نطقت بفضله % حاميم والمزمل % 25(@)(@@) % ورأيك الباب الذي % % منه إليها يدخل % 26(@)(@@) % وهو لعمري مرتج % إلا عليك مقفل % 27(@)(@@) % فانهض لحاجات فتى % ما مثله من يفشل % 29(@)(@@) % قد سار فيك مدحه % كما يسير المثل % 30(@)(@@) % مدح كما تحبه % منقح مفحل % 31(@)(@@) % لسانه في الشكر من % كل لسان أطول % 32(@)(@@) % كأنه في الذب عن % عرض الكريم منصل % 33(@)(@@) % فاقبل عليه ربما % % يثرى ثراه الممحل % 34(@)(@@) % فكلمن يقبل مو % لانا عليه مقبل % PageV01P228 35(@)(@@) % و جعل له رسما من الإ % % حسان فهو يعقل % 36(@)(@@) % و نه زمانا صرفه % % 37(@)(@@) % فإنه يسمع ما % % تقوله ويقبل % 38(@)(@@) % لا زلت بالإقبال في % % ثوب البقاء ترفل % 39(@)(@@) % يبسط للباغي الندى % % بساطك المقبل % 40(@)(@@) % ما رضع الطفل وما % % عاقب فجرا طفل % 41(@)(@@) % وبغمت عاطفة % على طلاها مغزل % PageV01P229 البحر : متقارب تام 1(@)(@@) % فلا يضجرنك ازدحام الوفود % عليك وكثرة ما تبذل % 2(@)(@@) % فإنك في زمن ليس فيه % جواد سواك ولا مفضل % 3(@)(@@) % وقد قل في أهله المنعمون % وقد كثر البائس المرمل % 4(@)(@@) % وما فيه غيرك من يستماح % وما فيه إلاك من يسأل % PageV01P230 البحر 
ms56	 : كامل تام 1(@)(@@) % أمط اللثام عن العذار السائل % ليقوم عذري فيك عند عواذلي % % 2(@)(@@) % واغمد لحاظك قد فللن تجلدي % % و كفف سهامك قد أصبن مقاتلي % % 3(@)(@@) % لا تجمع الشوق المبرح والقلى % % والبين لي أحد الثلثة قاتلي % % 4(@)(@@) % يكفيك ما تذكيه بين جوانحي % % لهواك نار لواعجي وبلابلي % % 5(@)(@@) % وهناك أني لا أدين صبابة % لهوى سواك ولا ألين لعاذل % 6(@)(@@) % بت لاهيا جذلا بحسنك إنني % % مذ بنت في شغل بحزني شاغل % 7(@)(@@) % ف عطف على جلد كعهدك في النوى % % واه وجسم مثل خصرك ناحل % 8(@)(@@) % ويلاه من هيف بقدك ضامن % تلفي ومن كفل بوجدي كافل % 9(@)(@@) % وبنفسي الغضبان لا يرضيه غير دمي وما في سفكه من طائل % دمي وما في سفكه من طائل % 10(@)(@@) % تصمي نبال جفونه قلبي ولا % % شلت وإن أصمت يمين النابل % PageV01P231 11(@)(@@) % ويهز قدا كالقناة لحاظه % لمحبه منها مكان العامل % 12(@)(@@) % عانقته أبكي ويبسم ثغره % كالبرق أومض في غمام هاطل % 13(@)(@@) % فألين في الشكوى لقاس قلبه % وأجد في وصف الغرام الهازل % 14(@)(@@) % ملك يجير من الحوادث جاره % ويخيل سائله دعاء السائل % 15(@)(@@) % ملك أنامله لأرقش نافث % حتف العدى ولمنصل ولذابل % 16(@)(@@) % كم غارة شعواء جدل أسدها % % يوم الكريهة عن متون أجادل % 17(@)(@@) % فينال ما أعيا الأسنة والظبى % % بأسنة من رأيه ومناصل % 18(@)(@@) % وبصامت منذ احتوته بنانه % فخر اليراع على الوشيج الذابل % 19(@)(@@) % لقن الندى والبأس في قضبانه % عن أيهم طاو وأغلب باسل % 20(@)(@@) % سل عن مواقعه الكتائب في الوغى % % يخبرن عن كتب له ورسائل % PageV01P232 21(@)(@@) % كالسحر تنفث في القلوب مكائدا % لا تتقى فكأنها من بابل % 22(@)(@@) % ترعى لحاظك من بدائع وشيها % % أزهار جنات ونور خمائل % 23(@)(@@) % وإذا سرت سكرى شمال خلتاه % % مرت بأخلاق له وشمائل % 24(@)(@@) % من معشر نهضوا وقد درس الندى % % بفروض جود أهملت ونوافل % 26(@)(@@) % شاد العلى بمعارف وعوارف % ورمى العدى بصوارم وصواهل % 27(@)(@@) % فهم إذا جلسوا صدور مجالس % وهم إذا ركبوا قلوب جحافل % 28(@)(@@) % نسب كما وضح الصباح مردد % في سودد متقادم متقابل % 30(@)(@@) % يا طالب 
ms57	 المعروف يجهد نفسه % في خوض أهوال ونقض مراحل % 31(@)(@@) % شم بارقا عبد الرحيم سحابه % و بشر بسح من نداه ووابل % 32(@)(@@) % يا خير من أولى الجميل وخير من % علقت بحبل منه راحة آمل % PageV01P233 33(@)(@@) % كم من يد أسدت يداك ونائل % أتبعته يوم العطاء بنائل % 34(@)(@@) % بيضاء يشهد بالسماح لربها % % ما أثقلته من طلى وكواهل % 35(@)(@@) % واستجل أبكار المديح عرائسا % أبدين زينتهن غير عواطل % 36(@)(@@) % أبرزتهن على علاك سوافرا % عافين فياض اليدين حلاحل % 37(@)(@@) % فاجلس لها وارفع حجابك دونها % % و نصت إلى إنشادها وتطاول % 38(@)(@@) % % كرما على المأمول حق الآمل % 39(@)(@@) % جاءتك لا مرذولة المعنى ولا % دنسا ملابسها بمدح أراذل % 40(@)(@@) % ولطالما نزهتها عن موقف % يخزي الكرام وصنتها عن جاهل % 41(@)(@@) % ورفعتها عن مدح كل مبخل % والعدم أحسن من عطاء الباخل % 42(@)(@@) % هيهات يطمع في انقيادي مانع % وشكيمتي لا تستكين لباذل % PageV01P234 43(@)(@@) % ولئن دعوتك من محل شاسع % ناء مداه على السرى المتطاول % 44(@)(@@) % فالسحب تبعد أن تنال وصوبها % % دان قريب من يد المتناول % 45(@)(@@) % فارفع إذا عرضت عليك قصائدي % % مدحي إلى الملك الرحيم العادل % 46(@)(@@) % واسفر بجاهك بين حظي والغنى % % وتقاض لي أيام دهري الماطل % 47(@)(@@) % و نهض بها أكرومة قعد الورى % % عنها فمن متقاعس أو ناكل % 48(@)(@@) % إن كنت أكرم منزل نزلت به % فليحمدن عليك أفضل نازل % 49(@)(@@) % لم أدع حين دعوت نصرك غافلا % عني ولا استنجدت منك بخاذل % 50(@)(@@) % قد أخصبت أرض العراق وإنني % % لأرود منها في جديب ماحل % 51(@)(@@) % وصفت مواردها الغزار وموردي % % منها ثماد بقائع ووشائل % 52(@)(@@) % مترديا برداء حظ ناقص % في أهلها وجمال فضل كامل % PageV01P235 53(@)(@@) % ومتى رأت عيناك فضلا شائعا % ف حكم لصاحبه بذكر خامل % 54(@)(@@) % فإذا هممت بنهضة أعلي بها % % قدري وأنشر في البلاد فضائلي % % 55(@)(@@) % قام الزمان يجود دون بلوغها % % بعوائق من صرفه وشواغل % 56(@)(@@) % ولعله يخشى سطاك إذا رأى % % حسن التفاتك أن يصيب شواكلي % % PageV01P236 البحر : طويل 1(@)(@@) % حللت حلول الغيث في البلد المحل % وإن جل ما تولي يداك عن المثل % 2(@)(@@) % وفارقت 
ms58	 أرض الشأم لاعن ملامة % ولا أن فيها عن فراقك ما يسلي % % 3(@)(@@) % ولكن ليستشفي البلاد وأهلها % % بفضلك من دآء الجهالة والبخل % 4(@)(@@) % فيأخذ كل من لقائك حظه % وما زلت بالقسطاس تحكم والعدل % 5(@)(@@) % وما كنت إلا العارض الجون جلجلت % رواعده فانحل في الحزن والسضهل % 6(@)(@@) % وقالوا رسول أعجزتنا صفاته % فقلت صدقتم هذه صفة الرسل % 7(@)(@@) % جمال إلى المولى الكمال نتسابه % وبارع فضل بارع من أبي الفضل % 8(@)(@@) % بكم أيد الله الممالك فاغتدت % موطدة الأكناف مجموعة الشمل % 9(@)(@@) % فمن سائس للملك فيها مدبر % ومن عالم حبر ومن حاكم عدل % 10(@)(@@) % فلا طمعت ما دمتم من حماتها % % يد الدهر في طرد لهن ولا وشل % PageV01P237 11(@)(@@) % وعشتم لدهر أنتم حسناته % ومجدكم حلي لايامه العطل % 12(@)(@@) % وأنشر أموات المكارم منكم % بكل جواد يتبع القول بالفعل % 13(@)(@@) % فأنتم بناة المجد بالبيض والقنا % % وأنتم ولاة العقد في الناس والحل % 14(@)(@@) % تجيرون من صرف الليالي فجاركم % عزيز إذا ما الجار أسلم للذل % 15(@)(@@) % يحل البعيد الدار والأهل فيكم % فيلهى عن الجيران والدار والأهل % 16(@)(@@) % خلقت أبا العباس للبأس والندى % % وللغارة الشعواى والقولة الفصل % 17(@)(@@) % فندعوك في الهيجاء يا قاتل العدى % % وندعوك في اللأواء يا قاتل المحل % 18(@)(@@) % لقد ناط نور الدين منك أموره % بأغلب شثن الكف ذي ساعد عبل % 19(@)(@@) % وألقى مقاليد الأمور مفوضا % إليك فأضحى الملك في جانب بسل % 20(@)(@@) % فقمت بما حملته منه ناهضا % وقد ضعفت عنه قوى الجلة البزل % PageV01P238 21(@)(@@) % وحمل أعباء الرسالة ناصحا % أمين القوى خالي الضلوع من الغل % 22(@)(@@) % تخيره أمضى الأنام عزيمة % وأحملهم يوم الكريهة للثقل % 23(@)(@@) % تخير منصور السرايا مؤيدا % خواطره تملي على الغيب ما يملي % % 24(@)(@@) % ملكت قلوب الناس ودا ورغبة % بأخلاقك الحسنى ونائلك الجزل % 25(@)(@@) % غفرت لدهري ما جنته خطوبه % بقربك والأيام في أوسع الحل % 26(@)(@@) % ووجهت آمالي إليك وقلما % % شددت على ظهر المنا قبلها رحلي % % 27(@)(@@) % فقد عشت دهرا ما تمد لنائل % يداي ولا تسعى إلى آمل رجلي % % 28(@)(@@) % أصون عن الجهال شعري ترفعا % وأشفق من مدح 
ms59	 البخيل على فضلي % % 29(@)(@@) % فأذوي ولا أبدي لخلق شكايتي % % وأعيا ولا ألقي على أحد ثقلي % % 30(@)(@@) % حليما على صحو الزمان وسكره % وقورا على جد النوائب والهزل % PageV01P239 31(@)(@@) % أبيا على الرواض لا يستفزني % % ذوات القدود الهيف والأعين النجل % 32(@)(@@) % فلا يملك المسني العطية مقودي % % ولا يطمع البيض الرعابيب في وصلي % % 33(@)(@@) % وما لي هوى أسمو إليه سوى العلى % % ولا سكن يمسي ضجيعي سوى الفضل % 34(@)(@@) % ولولا السماح الشهرزوري لم تبت % عقائل أشعاري تزف إلى بعل % 35(@)(@@) % وعند عماد الدين لي ما اقترحته % عطاء بلا من وود بلا غل % 36(@)(@@) % هو المرء يثني عن كريم نجاره % شمائله والفرع يثني عن الأصل % 37(@)(@@) % طويل نجاد السيف في حومة الوغى % % رحيب مجال الباع والهم في الأزل % 38(@)(@@) % تعرض للجدوى وكل أخي ندى % % إذا هو لم يسأل تعرض للبذل % 39(@)(@@) % وحنت إلى أن يبذل العرف كفه % كما حنت الأم الرقوب إلى الطفل % 40(@)(@@) % تمل بها يصبى الحليم بحسنها % % فلا بانة الوادي ولا ظبية الرمل % PageV01P240 41(@)(@@) % وراع لها ما أسلفت من مودة % وما أحكمته من ذمام ومن إل % 42(@)(@@) % ولا تنسها إن جد بين وحاذها % % على البعد حذو النعل في الود بالنعل % 43(@)(@@) % فحاشا لعهد من ولاء عقدته % بمدحك يمسي وهو منجذم الحبل % 44(@)(@@) % ولا زلت مرفوع العماد لآمل % يرجيك مسكوب الندى وارف الظل % PageV01P241 البحر : وافر تام 1(@)(@@) % أرى الأيام صيغتها تحول % وما لهواك من قلبي نصول % 2(@)(@@) % وحب لا تغيره الليالي % % محال أن يغيره العذول % 3(@)(@@) % بنفسي من وهبت لها رقادي % % فليلي بعد فرقتها طويل % 4(@)(@@) % وما بخلت علي بيوم وصل % ولكن الزمان بها بخيل % 5(@)(@@) % فتاة في موشحها قضيب % وتحت إزارها حقف مهيل % 7(@)(@@) % تميل على القلوب بذي عتدال % له من نشوة وصبى مميل % 8(@)(@@) % ويقعدها إذا خفت نهوضا % لحاجتها مؤزرها الثقيل % 9(@)(@@) % سقا دار الحبيب وإن تناءت % ملث مثل أجفاني هطول % 10(@)(@@) % ولا برحت تسحب للغوادي % % وطورا للصبا فيها ذيول % 11(@)(@@) % فجفني والغمام لها غزير % وقلبي والنسيم لها عليل % PageV01P242 12(@)(@@) % وعنفني على العبرات 
ms60	 صحبي % % عشية قوض الحي الحلول % 13(@)(@@) % وقالوا ستبق للأحباب دمعا % % فقد شرقت بأدمعك الطلول % 14(@)(@@) % معاذ الحب أن ألقى حمولا % وقد سارت بمن أهوى الحمول % 15(@)(@@) % وعار أن تزم ليوم بين % جمالهم ولي صبر جميل % 16(@)(@@) % فلا رقت الدموع وقد تولت % ركابهم ولا برد الغليل % 17(@)(@@) % وفي الأظعان من لولا اعتلاقي % % بهم لم يعتلق جسدي النحول % 18(@)(@@) % ولولا الكلة السيراء ما ها % % ج وجدي برق سارية كليل % 19(@)(@@) % ويوم بالصراة لنا قصير % وأيام التواصل لا تطول % 21(@)(@@) % إلام تسر لي يا دهر غدرا % أما انقضت الضغائن والذحول % 22(@)(@@) % وكم يتحيف النقصان فضلي % % ويأخذ من نباهتي الخمول % PageV01P243 23(@)(@@) % فيلفت وجه آمالي ويلوي % % ديوني عنده الزمن المطول % 24(@)(@@) % مطالب أمست الأيام بيني % % وبين مآربي منها تحول % 25(@)(@@) % سأدركها وشيكا والليالي % % مخزرة نواظرهن حول % 27(@)(@@) % فتى بنداه رضت جموح حظي % % فأصبح وهو منقاد ذلول % 28(@)(@@) % وهزته المكارم لاصطناعي % % يريك قوامها خوط الأراك ال % 29(@)(@@) % وقلدني من الإحسان عضبا % على نوب الزمان به أصول % 30(@)(@@) % وألبسني من النعماء درعا % تناذرها الأسنة والنصول % 31(@)(@@) % إذا قلصت سرابيل العطايا % % ضفت منها الذلاذل والفضول % 32(@)(@@) % فناءك يا ظهير الدين أمت % ى لمتيم طلل محيل % 34(@)(@@) % ممر الحبل محصدة قواه % وحبل سواه منقضب سحيل % PageV01P244 35(@)(@@) % تخاف سطاه أحداث الليالي % % ويهرب من مواهبه المحول % 37(@)(@@) % معاقله الجياد مسومات % وخير معاقل العرب الخيول % 38(@)(@@) % يميل بعطفه كرم السجايا % % 39(@)(@@) % ويشعف قلبه لمع المواضي % % إذا انتضيت ويطربه الصهيل % 40(@)(@@) % بغى قوم لحاقك يا بن نصر % وقد سدت على الباغي السبيل % 41(@)(@@) % وراموا نيل شأوك والمعالي % % لها ظهر براكبه ذليل % 42(@)(@@) % فأتعبهم مدى خرق جواد % حزون المكرمات له سهول % 43(@)(@@) % وأين من الثرى نيل الثريا % % وكيف تقاس بالغرر الحجول % 44(@)(@@) % حلمت فسفهت هضبات قدس % وجدت فبخل الغيث الهطول % 45(@)(@@) % وطورا أنت للضاحي مقيل % وطورا أنت للجاني مقيل % PageV01P245 46(@)(@@) % بلغت نهاية في المجد عزت % لك الأضراب فيها والشكول % 47(@)(@@) % على رسل فما لك من مجار % إلى رتب العلاء ولا رسيل % 48(@)(@@) % بلا منك 