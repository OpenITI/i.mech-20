ms261	 الملائكة(@)(@@)(@@)(@@) | 3828 - (@)(@@) أنس(@)(@@) الصائم بالخيار ما بينه وبين نصف النهار(@)(@@)(@@)(@@) | 3829 - (@)(@@) أم هانىء(@)(@@) الصائم المتطوع أمير نفسه إن شاء صام وإن شاء أفطر(@)(@@)(@@)(@@) | 3830 - (@)(@@) عائشة(@)(@@) الصائم رمضان في السفر كمفطره في الحضر(@)(@@) فصل(@)(@@)(@@)(@@) | 3831 - (@)(@@) أبو هريرة(@)(@@) الصدقة ما أبقت غنى وأبدأ بمن تعول واليد العليا أفضل من السفلى ولا يلوم الله عز وجل على كفاف(@)(@@)(@@)(@@) | 3832 - (@)(@@) عقبة بن عامر(@)(@@) الصدقة تطفىء عن أهلها حر القبور(@)(@@)(@@)(@@) | 3833 - (@)(@@) معاذ بن جبل(@)(@@) الصدقة تطفىء الخطيئة كما يطفىء الماء النار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3834 - (@)(@@) أنس بن مالك(@)(@@) الصدقة تطفىء غضب الرب وتدفع عنه ميتة السوء(@)(@@)(@@)(@@) | 3835 - (@)(@@) رافع بن خديج(@)(@@) الصدقة تسد سبعين بابا من الشر(@)(@@)(@@)(@@) | 3836 - (@)(@@) سلمان بن عامر(@)(@@) الصدقة على المسكين صدقة وهي(@)(@@) PageV00P000(@)(@@) على ذي الرحم صدقة وصلة(@)(@@)(@@)(@@) | 3737 - (@)(@@) أنس(@)(@@) الصدقات بالغدوات تذهب بالعاهات(@)(@@)(@@)(@@) | 3838 - (@)(@@) حنظلة بن حريم(@)(@@) الصدقة عشر وإلا فعشرون وإلا فثلاثون فإن كثر فأربعون(@)(@@) فصل(@)(@@)(@@)(@@) | 3839 - (@)(@@) علي بن أبي طالب(@)(@@) الصبر والحلم والسخاوة من أخلاق الأنبياء فمن أكرمه الله عز وجل بكرامة الأنبياء أدخله الجنة مع الأنبياء بغير حساب(@)(@@)(@@)(@@) | 3840 - (@)(@@) أنس بن مالك(@)(@@) الصبر من الإيمان بمنزلة الرأس من الجسد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3841 - (@)(@@) ابن مسعود(@)(@@) الصبر نصف الإيمان واليقين الإيمان كله(@)(@@)(@@)(@@) | 3842 - (@)(@@) أنس بن مالك(@)(@@) الصبر عند الصدمة الأولى(@)(@@)(@@)(@@) | 3843 - (@)(@@) أبو موسى(@)(@@) الصبر رضا(@)(@@)(@@)(@@) | 3844 - (@)(@@) الحسين بن علي(@)(@@) الصبر مفتاح الفرج والزهد غنى الأبد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3845 - (@)(@@) أنس بن مالك(@)(@@) الصبر صبران صبر عند المصيبة فحسن وصبر عند ما حرم الله عليك فتمسك نفسك عنك وذلك أفضل(@)(@@)(@@)(@@) | 3846 - (@)(@@) علي بن أبي طالب(@)(@@) الصبر ثلاثة فصبر على المصيبة وصبر على الطاعة وصبر عن المعصية فمن صبر على المصيبة حتى يردها بحسن عزائه كتب الله له ثلاثمائة درجة ما بين الدرجة إلى الدرجة كما بين السماء والأرض ومن صبر على الطاعة كتب الله له ستمائة درجة ما بين الدرجة إلى الدرجة كما بين تخوم الأرضين إلى منتهى العرش مرتين(@)(@@)(@@)(@@) | 3847 - (@)(@@) أنس(@)(@@) الصبر على البلاء عبادة(@)(@@)(@@)(@@) | 3848 - (@)(@@) الحكم بن عمير(@)(@@) الصبر والاحتساب هن من عتق الرقاب ويدخل الله عز وجل 
ms262	 صاحبهن الجنة بغير حساب(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 3849 - (@)(@@) أبو هريرة(@)(@@) الصمت أرفع العبادة(@)(@@)(@@)(@@) | 3850 - (@)(@@) أنس(@)(@@) الصمت سيد الأخلاق ومن مزح استخف به ومن حمل الأمر على القضاء استراح(@)(@@)(@@)(@@) | 3851 - (@)(@@) ابن عمر(@)(@@) الصمت حلم وقليل فاعله(@)(@@)(@@)(@@) | 3852 - (@)(@@) أبو ذر(@)(@@) الصعيد الطيب وضوء المسلم وإن لم يجد الماء عشر سنين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3853 - (@)(@@) عائشة(@)(@@) الصبا ريح مؤمنة وبها نصرت(@)(@@)(@@)(@@) | 3854 - (@)(@@) أبو سعيد(@)(@@) الصف الأول في المسجد أول زمرة يدخلون المسجد هم الصف الأول وإن لم يقوموا في أول الصف(@)(@@)(@@)(@@) | 3855 - (@)(@@) عبد الله بن عمرو(@)(@@) الصور قرن ينفخ فيه(@)(@@)(@@)(@@) | 3856 - (@)(@@) أبو هريرة(@)(@@) الصلح جائز بين المسلمين إلا صلحا حرم حلالا أو أحل حراما(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3857 - (@)(@@) أبو الدرداء(@)(@@) الصداع والمليلة يولعان بالمؤمن وإن ذنبه مثل جبال أحد حتى لا يبقى عليه من ذنبه مثقال حبة من خردل(@)(@@)(@@)(@@) | 3858 - (@)(@@) علي(@)(@@) الصراط المستقيم كتاب الله عز وجل(@)(@@)(@@)(@@) | 3859 - (@)(@@) جابر(@)(@@) الصراط المستقيم أوسع مما بين السماء والأرض(@)(@@)(@@)(@@) | 3860 - (@)(@@) جابر(@)(@@) الصراط المستقيم دين الإسلام وطريق الحج والغزو في سبيل الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3861 - (@)(@@) أبو هريرة(@)(@@) الصراط كحد السيف دحضة مزلة ذات حسك وكلاليب(@)(@@)(@@)(@@) | 3862 - (@)(@@) أبو هريرة(@)(@@) الصراط بين أظهر جهنم دحض مزلة والأنبياء عليهم السلام يقولون اللهم سلم سلم والناس كلمع البرق وكطرف العين وكأجاويد الخيل والبغال والركاب وشد على الأقدام فناج مسلم ومخدوش مرسل ومطروح فيها وله سبعة أبواب لكل باب منهم جزء مقسوم(@)(@@)(@@)(@@) | 3863 - (@)(@@) ابن عمر(@)(@@) الصمد السيد المصمود إليه في الحوائج(@)(@@)(@@)(@@) | 3864 - (@)(@@) عمر بن الخطاب(@)(@@) الصادق بلسانه الطويل صمته ويسلم الناس من شره فذلكم العاقل وإن كان لا يقرأ من كتاب الله عز وجل كثيرا(@)(@@)(@@)(@@) | 3865 - (@)(@@) شداد بن أوس(@)(@@) الصادق لا يشتغل بالخلق ولا بالدنيا من يدعي الصدق ويصحب مع الخلق فهو كذاب ومن رجع عند النوائب إلى المخلوقين فهو مرائي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3866 - (@)(@@) داود بن بلال بن أجنحة(@)(@@) الصديقون ثلاثة حبيب النجار وخربيل مؤمن آل فرعون وعلي بن أبي طالب رضي الله عنه الثالث وهو أفضلهم(@)(@@) فصل(@)(@@)(@@)(@@) | 3867 - (@)(@@) أنس بن مالك(@)(@@) الصحبة مع العاقل زيادة والصحبة مع الأحمق نقصان في الدنيا 
ms263	 وحسرة وندامة عند الموت وخسارة في الآخرة(@)(@@)(@@)(@@) | 3868 - (@)(@@) عثمان بن عفان(@)(@@) الصبحة تمنع بعض الرزق يعني نومة الغذاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3869 - (@)(@@) عبد الله بن عمرو(@)(@@) الصفرة خضاب المؤمن والخضرة خضاب المسلم والسواد خضاب الكافر(@)(@@)(@@)(@@) | 3870 - (@)(@@) ابن عباس(@)(@@) الصورة الرأس إذا قطع الرأس فلا صورة(@)(@@)(@@)(@@) | 3871 - (@)(@@) عبادة بن الصامت(@)(@@) الصخرة صخرة بيت المقدس على نخلة والنخلة على نهر من أنهار الجنة وتحت النخلة آسية بنت مزاحم امرأة فرعون ومريم بنت عمران تنظمان سموط أهل الجنة إلى يوم القيامة السمط القلادة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الضاد(@)(@@) PageV02P423(@)(@@) PageV02P424(@)(@@)(@@)(@@) | 3872 - (@)(@@) جابر بن عبد الله(@)(@@) ضحوا مواشيكم في فورة العشاء فإن الشياطين يرسلون في تلك الساعة(@)(@@)(@@)(@@) | 3873 - (@)(@@) عائشة(@)(@@) ضحوا وطيبوا بها أنفسكم فإنه ليس من مسلم يوجه أضحيته إلى القبلة إلا كان دمها وقرنها وصوفها حسنات محضرات في ميزانه يوم القيامة(@)(@@)(@@)(@@) | 3874 - (@)(@@) أنس بن مالك(@)(@@) ضع بصرك موضع سجودك قال أنس قلت هذا شديد لا أطيق قال ففي المكتوبة إذا يا أنس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3875 - (@)(@@) زيد بن ثابت(@)(@@) ضع قلمك على أذنك يكون أذكر للمملي(@)(@@)(@@)(@@) | 3876 - (@)(@@) عبد الله بن عمرو(@)(@@) ضاف ضيف من بني إسرائيل وفي داره كلب محج فقالت الكلبة لا والله لا أنبح ضيف أهلي فعوى جراؤها في بطنها قال قيل ما هذا فأوحى الله عز وجل إلى إمامهم هكذا أمة تكون بعدكم يقرقر شفاؤها علماءها محح يعني حاملا يقرقر يعني يغلب(@)(@@)(@@)(@@) | 3877 - (@)(@@) أبو هريرة(@)(@@) ضيافة الضيف ثلاثة أيام فما زاد فهو صدقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3878 - (@)(@@) علي(@)(@@) ضالة المؤمن العلم كما قيد حديثا طلب إليه آخر(@)(@@)(@@)(@@) | 3879 - (@)(@@) عبد الله بن عمرو(@)(@@) ضرب الأقلام عند الأحاديث تعدل عند الله عز وجل مع التكبير الذي يكبر في رباط عبادان وعسقلان(@)(@@)(@@)(@@) | 3880 - (@)(@@) أبو هريرة(@)(@@) ضالة المؤمن المكتوبة غرامتها ومثلها معها(@)(@@)(@@)(@@) | 3881 - (@)(@@) أبو جارود بشر بن عمر والعبدي(@)(@@) ضالة المسلم حرق(@)(@@) PageV00P000(@)(@@) النار فلا يقربنها يعني أنه نار تشتعل قالها ثلاثا(@)(@@)(@@)(@@) | 3882 - (@)(@@) أبو هريرة(@)(@@) ضرس الكافر مثل أحد وغلظ جلده مسيرة ثلاث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3883 - (@)(@@) أسامة بن زيد(@)(@@) ضحك المؤمن تبسم والقرقرة من الشيطان(@)(@@)(@@)(@@) | 3884 - (@)(@@) علي بن أبي طالب(@)(@@) ضعفت 
ms264	 عن الصلاة وعن الجماع فنزلت علي قدر من السماء فأكلت منها فزادت في قوتي قوة أربعين رجلا في البطش(@)(@@)(@@)(@@) | 3885 - (@)(@@) النواس بن سمعان(@)(@@) ضرب الله عز وجل مثلا صراطا مستقيما وعلى حافتي الصراط سوران فيهما أبواب مفتحة وستور مرخاة وعلى باب الصراط داع يقول يا أيها الناس ادخلوا الصراط ولا تتعوجوا وداع من فوق الصراط فإذا أراد الإنسان فتح شيء من تلك الأبواب قال ويحك لا تفتحه فإنك إن تفتحه تلجه والصراط الإسلام والستور حدود الله عز وجل والأبواب المفتحة محارم الله تعالى والداعي على رأس الصراط كتاب الله عز وجل والداعي فوق الصراط واعظ الله في قلب المسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3883 - (@)(@@) أسامة بن زيد(@)(@@) ضحك المؤمن تبسم والقرقرة من الشيطان(@)(@@)(@@)(@@) | 3884 - (@)(@@) علي بن أبي طالب(@)(@@) ضعفت عن الصلاة وعن الجماع فنزلت علي قدر من السماء فأكلت منها فزادت في قوتي أربعين رجلا في البطش(@)(@@)(@@)(@@) | 3885 - (@)(@@) النواس بن سمعان(@)(@@) ضرب الله عز وجل مثلا صراطا مستقيما وعلى حافتي الصراط سوران فيهما أبواب مفتحة وستور مرخاة وعلى باب الصراط داع يقول يا أيها الناس ادخلوا الصراط ولا تتعوجوا وداع من فوق الصراط فإذا أراد الإنسان فتح شيء من تلك الأبواب قال ويحك لا تفتحه فإنك إن تفتحه تلجه والصراط الإسلام والستور حدود الله عز وجل والأبواب المفتحة محارم الله تعالى والداعي على رأس الصراط كتاب الله عز وجل والداعي فوق الصراط واعظ الله في قلب المسلم(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 3886 - (@)(@@) ابن عمر(@)(@@) ضرب الله الحق على لسان عمر وقلبه(@)(@@)(@@)(@@) | 3887 - (@)(@@) أبو هريرة(@)(@@) ضمن الله عز وجل لمن خرج في سبيل الله لا يخرجه إلا جهاد في سبيل وإيمانا بي وتصديقا برسولي وهو علي ضامن أن أدخله الجنة أو أرجعه إلى مسكنه الذي خرج منه نائلا ما نال من أجر وغنيمة(@)(@@)(@@)(@@) | 3888 - (@)(@@) ابن مسعود(@)(@@) ضحك الله عز وجل لقوله أتستهزىء بي وأنت رب العالمين(@)(@@)(@@)(@@) | 3889 - (@)(@@) أبو هريرة(@)(@@) ضحك الله عز وجل من رجلين قتل أحدهما صاحبه ثم دخلا الجنة جميعا يقتل هذا فيلج الجنة ثم يتوب 
ms265	 الله عز وجل على الآخر فيهديه إلى الإسلام ثم يجاهد في سبيل الله عز وجل فيستشهد(@)(@@)(@@)(@@) | 3890 - (@)(@@) ابو رزين(@)(@@) ضحك ربنا عز وجل من قنوط عباده(@)(@@) PageV00P000(@)(@@) وقرب خيره ولن نعدم من رب يضحك خيرا(@)(@@) فصل(@)(@@) من ذوات(@)(@@) الألف واللام(@)(@@)(@@)(@@) | 3891 - (@)(@@) أنس بن مالك(@)(@@) الضحك في المسجد ظلمة في القبر(@)(@@)(@@)(@@) | 3892 - (@)(@@) أنس(@)(@@) الضحك من غير عجب يذهب بالمروءة وممحقة للرزق(@)(@@)(@@)(@@) | 3893 - (@)(@@) أنس بن مالك(@)(@@) الضحك الكثير يميت القلب(@)(@@)(@@)(@@) | 3894 - (@)(@@) جابر(@)(@@) الضحك ينقض الصلاة ولا ينقض الوضوء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3895 - (@)(@@) معاذ بن أنس(@)(@@) الضاحك في الصلاة والملتفت والمفرقع أصابعه بمنزلة سواء(@)(@@)(@@)(@@) | 3896 - (@)(@@) أبو ذر وأنس(@)(@@) الضيف يأتي برزقه ويرتحل بذنوب القوم(@)(@@)(@@)(@@) | 3897 - (@)(@@) أبن عمر(@)(@@) الضيافة على أهل الوبر وليست على أهل المدر(@)(@@)(@@)(@@) | 3898 - (@)(@@) أبو شريح(@)(@@) الضيافة ثلاثة أيام والجائزة يوم وليلة ولا(@)(@@) PageV00P000(@)(@@) يحل لأحد أن يقيم عند أخيه حتى يؤثمه يقيم عنده وليس عنده ما يضيفه(@)(@@)(@@)(@@) | 3899 - (@)(@@) جابر(@)(@@) الضيافة حق على كل مسلم والضيافة ثلاثة أيام ولياليهن وأيما رجل أضاف رجلا فلم يؤد إليه حق ضيافته فلقي مالا فأصاب منه بقدر ما منعه من ضيافته فلا سبيل عليه(@)(@@)(@@)(@@) | 3900 - (@)(@@) ابن عباس(@)(@@) الضرار في الوصية من الكبائر(@)(@@)(@@)(@@) | 3901 - (@)(@@) معاذ بن جبل(@)(@@) الضمة في القبر كفارة للمؤمن لكل ذنب بقي عليه لم يغفر له وذلك ان يحيى بن زكريا عليهما السلام ضم ضمة في قبره في أكله شعير شبع منها(@)(@@)(@@)(@@) | 3902 - (@)(@@) ابن عمر(@)(@@) الضب لست آكلة ولا أحرمه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3903 - (@)(@@) سعيد بن يسار(@)(@@) الضرب بالكف على الفخذ عند المصيبة يحبط الأجر من المصيبة(@)(@@)(@@)(@@) | 3904 - (@)(@@) ابن عباس(@)(@@) الضبع صيد وفيها كبش(@)(@@)(@@)(@@) | 3905 - (@)(@@) ابن عباس(@)(@@) الضريع شيء يكون في النار شبه الشوك أمر من الصبر أنتن من الجيفة وأشد حرا من النار سماه الله الضريع إذا طعمه صاحبه لا يدخل البطن ولا يرتفع إلى الفم فيبقى بين ذلك ولا يغني من جوع(@)(@@)(@@)(@@) | 3906 - (@)(@@) أنس بن مالك(@)(@@) الضعفاء في أمتي ثلاثة المرأة واليتيم والمملوك فمن أكرمهم أكرمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الطاء(@)(@@) PageV02P435(@)(@@)(@@)(@@) | 3907 - (@)(@@) أنس بن مالك(@)(@@) طلب العلم فريضة على كل مسلم 
ms266	 وواضع العلم عند غير أهله كمقلد الخنازير الجوهر واللؤلؤ والذهب(@)(@@)(@@)(@@) | 3908 - (@)(@@) علي بن أبي طالب(@)(@@) طلب العلم فريضة على كل مؤمن فاغد أيها العبد عالما أو متعلما ولا خير فيما بين ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3909 - (@)(@@) أنس بن مالك(@)(@@) طلب العلم فريضة وبذله للناس فريضة والنصيحة لهم فريضة والجهاد في سبيل الله عز وجل فريضة(@)(@@)(@@)(@@) | 3910 - (@)(@@) ابن عباس(@)(@@) طلب العلم أفضل عند الله عز وجل من الصلاة والصيام والحج والجهاد في سبيل الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3911 - (@)(@@) حذيفة بن اليمان(@)(@@) طالب العلم بين الجهال كالحي بين الأموات(@)(@@)(@@)(@@) | 3912 - (@)(@@) حسان بن أبي سنان(@)(@@) طالب العلم لله عز وجل كالغادي والرائح في سبيل الله عز وجل(@)(@@)(@@)(@@) | 3913 - (@)(@@) أنس(@)(@@) طلب الفقه حتم واجب على كل مسلم(@)(@@)(@@)(@@) | 3913 - (@)(@@) مكرر أنس(@)(@@) طلب العلم في الله عز وجل مع السمت الحسن والعمل الصالح جزء من النبوة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3914 - (@)(@@) أنس بن مالك(@)(@@) طلب الحلال واجب على كل مسلم(@)(@@)(@@)(@@) | 3915 - (@)(@@) أنس(@)(@@) طالب العلم طالب الرحمة طالب العلم ركن الإسلام ويعطى أجره مع النبيين(@)(@@)(@@)(@@) | 3916 - (@)(@@) عائشة(@)(@@) طالب العلم تبسط الملائكة أجنحتها وتستغفر له(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3917 - (@)(@@) ابن عباس(@)(@@) طلب العلم ساعة خير من قيام ليلة وطلب العلم يوما خير من صام ثلاثة أشهر(@)(@@)(@@)(@@) | 3918 - (@)(@@) ابن مسعود(@)(@@) طلب كسب الحلال فريضة بعد الفريضة وجهاد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3919 - (@)(@@) ابن عباس(@)(@@) طلب الحلال جهاد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3920 - (@)(@@) علي بن أبي طالب(@)(@@) طلب الحق غرية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3921 - (@)(@@) أنس بن مالك(@)(@@) طلب الحق فريضة على كل مسلم(@)(@@)(@@)(@@) | 3922 - (@)(@@) أبو بكر الصديق(@)(@@) طلب الرجل معيشته في الحلال صدقة(@)(@@) فصل(@)(@@)(@@)(@@) | 3923 - (@)(@@) أبو هريرة(@)(@@) طوبى لمن بات حاجا واصبح غازيا رجل(@)(@@) PageV00P000(@)(@@) مستور ذو عيال قانع متعفف باليسير من الدنيا يدخل عليهم ضاحكا ويخرج عنهم ضاحكا فوالذي نفسي بيده إنهم هم الحاجون الغازون في سبيل الله عز وجل(@)(@@)(@@)(@@) | 3924 - (@)(@@) عبد الله بن حنظلة(@)(@@) طوبى لمن رزقه الله عز وجل الكفاف ثم صبر عليه(@)(@@)(@@)(@@) | 3925 - (@)(@@) عبد الله بن بسر(@)(@@) طوبى لمن طال عمره وحسن عمله(@)(@@)(@@)(@@) | 3926 - (@)(@@) أنس بن مالك(@)(@@) طوبى لمن رآني ولمن رأى من رآني ولمن رأى من رأى من 
ms267	 رآني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3927 - (@)(@@) أبو أمامة(@)(@@) طوبى لمن رآني وآمن بي وطوبى سبع مرات لمن لم يرني وآمن بي(@)(@@)(@@)(@@) | 3928 - (@)(@@) ركب المصري(@)(@@) طوبى لمن تواضع في غير منقصة وذلك نفسه في غير مسكنة وأنفق مالا جمعه في غير معصية وخالط أهل الفقه والحكمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3929 - (@)(@@) أنس بن مالك(@)(@@) طوبى لمن شغله عيبه عن عيوب الناس وأنفق الفضل من ماله وأمسك الفضل من قوله ووسعته السنة ولم يتعدها إلى البدعة(@)(@@)(@@)(@@) | 3930 - (@)(@@) ثوبان مولى النبي صلى الله عليه وسلم(@)(@@) طوبى لمن ملك لسانه ووسعه بينه وبكى على خطيئته(@)(@@)(@@)(@@) | 3931 - (@)(@@) فضالة بن عبيد(@)(@@) طوبى لمن هدي للاسلام وكان عيشه كفافا وقنع به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3932 - (@)(@@) أبو هريرة(@)(@@) طوبى لمن يبعث يوم القيامة وجوفه محشو بالقرآن والفرائض والعلم(@)(@@)(@@)(@@) | 3933 - (@)(@@) عائشة(@)(@@) طوبى لمن وجد في صحيفته استغفارا كثيرا(@)(@@)(@@)(@@) | 3934 - (@)(@@) أبو بكر الصديق(@)(@@) طوبى لمن مات في النأنأة حدة الإسلام وبدؤها(@)(@@)(@@)(@@) | 3935 - (@)(@@) أنس(@)(@@) طوبى للمؤمن إذا أحسن قبل منه وإذا أساء غفر له(@)(@@)(@@)(@@) | 3936 - (@)(@@) ثوبان(@)(@@) طوبى للمخلصين أولئك مصابيح الهدى تتجلى عنهم كل فتنة ظلماء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3937 - (@)(@@) عبد الله بن عمرو(@)(@@) طوبى للغرباء أناس صالحون في ناس سواهم كثير من بعضهم اكثر من يعطيهم(@)(@@)(@@)(@@) | 3938 - (@)(@@) ابن عمر(@)(@@) طوبى للفقراء والضعفاء من أمتي الفقراء أحبائي وأحباء الله هيهات هيهات كم من ضعيف يشفع في سبعين ألف إنسان وكم من قوي لا يشفع لأحد ولا ينجو في نفسه لأنه ترك أمر الله ويفخر ويتطاول على الناس(@)(@@)(@@)(@@) | 3939 - (@)(@@) أنس بن مالك(@)(@@) طوبى لكل غني تقي ولكل فقير خفي يعرفه الله ولا يعرفه الناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3940 - (@)(@@) عبد الله بن الزبير(@)(@@) طوبى لمن أسكنه الله إحدى العروسين عسقلان وغزة(@)(@@) فصل(@)(@@)(@@)(@@) | 3941 - (@)(@@) أبو هريرة(@)(@@) طوبى لعبد غبر قدماه في سبيل الله شاحب لونه أشعث رأسه إن كانت الساقة كان فيهم وإن كان الحرس كان فيهم إن يشفع له لم يشفع وإن استأذن لم يؤذن له طوبى له ثم طوبى له(@)(@@)(@@)(@@) | 3942 - (@)(@@) أبو هريرة(@)(@@) طوبى لعبد أغبر جلده دنس ثيابه يكون في النهار في الساقة وبالليل في الحرس إن حقا 
ms268	 على الله أن يزوجه من الحور العين(@)(@@)(@@)(@@) | 3943 - (@)(@@) أبو هريرة(@)(@@) طوبى لعيش بعد المسيح يؤذن للسماء في القطر والأرض في النبات فلو بذرت حبة على الصفا لنبتت ولا تباغض ولا تحاسد حتى يمر الرجل على الأسد فلا يضره ويطأ على الحية فلا تضره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3944 - (@)(@@) أنس بن مالك(@)(@@) طوبى لك يا طير تقع على الشجر وتأكل الشجر وتصير إلى غير حساب(@)(@@)(@@)(@@) | 3945 - (@)(@@) عائشة(@)(@@) طوبى لك يا عثمان لم تلبسك الدنيا ولم تلبسها قاله لعثمان بن مظعون يوم مات(@)(@@)(@@)(@@) | 3946 - (@)(@@) ابن عمر(@)(@@) طوبى شجرة في الجنة لا يعلم طولها إلا الله عز وجل يسير الراكب تحت غصن من أغصانها سبعين خريفا ورقها الحلل يقع عليها الطير كأمثال البخت(@)(@@) فصل(@)(@@)(@@)(@@) | 3947 - (@)(@@) أبو هريرة(@)(@@) طاعة الله عز وجل طاعة الوالد(@)(@@) PageV00P000(@)(@@) ومعصية الله عز وجل في معصية الوالد(@)(@@)(@@)(@@) | 3948 - (@)(@@) عائشة(@)(@@) طاعة النساء ندامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3949 - (@)(@@) علي(@)(@@) طلحة والزبير جاراي في الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3950 - (@)(@@) معاوية بن أبي سفيان(@)(@@) طلحة ممن قد قضى نحبه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3951 - (@)(@@) جابر(@)(@@) طلحة شهيد يمشي على وجه الأرض(@)(@@)(@@)(@@) | 3952 - (@)(@@) ابن عباس(@)(@@) طينة المعتق من طينة المعتق(@)(@@)(@@)(@@) | 3953 - (@)(@@) عمران بن حصين(@)(@@) طيب الرجال ريح لا لون له وطيب النساء لون لا ريح له(@)(@@)(@@)(@@) | 3954 - (@)(@@) عائشة(@)(@@) طعام السخي دواء وطعام الشحيح داء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3954 - (@)(@@) مكرر ابن عمر(@)(@@) طعام الجواد دواء وطعام البخيل داء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3955 - (@)(@@) سلمة بن الأكوع(@)(@@) ألطعام الحار غير ذي بركة فأبردوه(@)(@@)(@@)(@@) | 3956 - (@)(@@) جابر(@)(@@) طعام الواحد يكفي الإثنين وطعام الإثنين يكفي الأربعة وطعام الأربعة يكفي الثمانية إذا سموا(@)(@@)(@@)(@@) | 3957 - (@)(@@) جابر بن عبد الله(@)(@@) طي الثوب راحته(@)(@@)(@@)(@@) | 3958 - (@)(@@) جابر(@)(@@) طرف الغازي إذا طرف بعينه حسنة له والحسنة بسبعمائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3959 - (@)(@@) أنس بن مالك(@)(@@) طلاق السنة أن يطلقها طاهرة من غير جماع ثم يتركها من غير جماع ثم يتركها حتى تنقضي عدتها(@)(@@)(@@)(@@) | 3960 - (@)(@@) عائشة(@)(@@) طلاق الأمة تطليقتان وقرؤها حيضتان(@)(@@)(@@)(@@) | 3961 - (@)(@@) ابن عباس(@)(@@) طلوع الفجر أمان لأمتي من الطلوع الشمس من مغربها(@)(@@)(@@)(@@) | 3962 - (@)(@@) ابو هريرة(@)(@@) طهور إناء أحدكم إذا ولغ فيه الكلب أن يغسله سبع مرات أو لهن بالتراب وطهور الإناء 
ms269	 إذا ولغ فيه الهرة مرة أو مرتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3963 - (@)(@@) جابر(@)(@@) طائر كل امرىء في عنقه يعني الطيرة(@)(@@)(@@)(@@) | 3964 - (@)(@@) علي بن أبي طالب(@)(@@) طسم الطاء طور سيناء والسين الإسكندرية والميم مكة(@)(@@)(@@)(@@) | 3965 - (@)(@@) أنس بن مالك(@)(@@) طبقات أمتي خمس طبقات كل طبقة منها أربعون سنة فطبقتي وطبقة أصحابي أهل العلم والإيمان والذين يلونهم إلى الثمانين أهل البر والتقوى والذين يلونهم إلى العشرين ومائة أهل التراحم والتواصل والذين يلونهم إلى الستين ومائة أهل التقاطع والتدابر والذين يلونهم إلى المئتين أهل الهرج والحرب(@)(@@)(@@)(@@) | 3966 - (@)(@@) أبو هريرة(@)(@@) طلبت بنو إسرائيل زكريا ليقتلوه فخرج هاربا في البرية فانفرجت له شجرة فدخل فيها وبقيت هدبة من ثوبه فجاؤا حتى وقفوا عليها فنشروه بالمناشير(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 3967 - (@)(@@) ابن عمر(@)(@@) طهروا هذه الأجساد طهركم الله عز وجل فليس من عبد يبيت طاهرا إلا بات معه ملك في شعاره ولا يتقلب ساعة من الليل يسأل الله شيئا من أمر الدنيا والآخرة إلا أعطاه إياه(@)(@@)(@@)(@@) | 3968 - (@)(@@) ابن عمر(@)(@@) طهروا أجسادكم واعملوا لمعادكم وصلوا ذوي قراباتكم(@)(@@)(@@)(@@) | 3969 - (@)(@@) أبو هريرة(@)(@@) طيبوا ساحاتكم فإن أنتن الساحات ساحات اليهود(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3970 - (@)(@@) سمرة بن جندب(@)(@@) طيبوا أفواهكم بالسواك فإنها طرق القرآن(@)(@@)(@@)(@@) | 3971 - (@)(@@) عائشة(@)(@@) طيبوا مساجدكم التي تكون في دوركم(@)(@@)(@@)(@@) | 3972 - (@)(@@) أنس بن مالك(@)(@@) طوافان لا يوافقهما عبد مسلم إلا خرج من ذنوبه كيوم ولدته أمه ويغفر له ذنوبه كلها بالغة ما بلغت طواف بعد صلاة الفجر يكون فراغه مع طلوع الشمس وطواف بعد صلاة العصر يكون فراغه مع غروب الشمس(@)(@@) ذكر الفصول من ذوات الألف واللام(@)(@@)(@@)(@@) | 3973 - (@)(@@) ابن عباس(@)(@@) الطواف بالبيت صلاة إلا أن الله عز وجل قد أحل لكم فيه المنطق فمن نطق فلا ينطق إلا بخير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3974 - (@)(@@) ابن عمر(@)(@@) الطواف بالبيت صلاة فأقلوا فيه من الكلام(@)(@@)(@@)(@@) | 3975 - (@)(@@) علي(@)(@@) الطهور ثلاث ثلاث واجبة ومسح الرأس واحدة(@)(@@)(@@)(@@) | 3976 - (@)(@@) أبو مالك الأشعري(@)(@@) الطهور شطر الإيمان والحمد لله تملأ الميزان وسبحان الله والحمد لله تملأ أو تملان ما بين السماء والأرض والصلاة نور والصدقة برهان والصبر ضياء والقرآن حجة لك أو 
ms270	 عليك(@)(@@)(@@)(@@) | 3977 - (@)(@@) أبو الدرداء(@)(@@) الطهارات أربع حلق العانة وقص الشارب وتقليم الأظفار والسواك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3978 - (@)(@@) ابن عباس(@)(@@) الطلاق بيد من أخذ بالساق(@)(@@)(@@)(@@) | 3989 - (@)(@@) عمر(@)(@@) الطلاق للعدة أن يطلقها طاهرا من غير جماع(@)(@@)(@@)(@@) | 3980 - (@)(@@) ابن عمر(@)(@@) الطابع معلق بالعرش فإذا انتهكت الحرمة واجترأوا على الخطايا وعمل بالمعاصي بعث الله الطابع فيطيع القلب فلا يعقل بعد ذلك شيئا(@)(@@)(@@)(@@) | 3981 - (@)(@@) عمرو بن حريث(@)(@@) الطاهر النائم كالصائم القائم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3982 - (@)(@@) أبو هريرة(@)(@@) الطاعم الشاكر كالصائم الصابر(@)(@@)(@@)(@@) | 3983 - (@)(@@) عائشة(@)(@@) الطير حق فأقروها على مكناتها وخيرها الفأل الصالح(@)(@@)(@@)(@@) | 3984 - (@)(@@) ابن مسعود(@)(@@) الطيرة شرك الطيرة شرك الطيرة شرك وما منا إلا ولكن الله يذهبه بالتوكل(@)(@@)(@@)(@@) | 3985 - (@)(@@) قبيصة بن المخارق(@)(@@) الطرق والطيرة والعيافة من الجبت(@)(@@) PageV00P000(@)(@@) والجبت الكاهن ويقال الساحر والطرق الزجر والعيافة الخط والطيرة التي تطير(@)(@@)(@@)(@@) | 3986 - (@)(@@) عائشة(@)(@@) الطوفان الموت(@)(@@)(@@)(@@) | 3987 - (@)(@@) أبو هريرة(@)(@@) الطريق يطهر بعضه بعضا(@)(@@) فصل(@)(@@)(@@)(@@) | 3988 - (@)(@@) أنس بن مالك(@)(@@) الطاعون شهادة لكل مسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3989 - (@)(@@) معاذ بن جبل(@)(@@) الطاعون رحمة من ربكم ودعوة من نبيكم وقبض الصالحين من قبلكم ولا يفر منه إلا منافق(@)(@@)(@@)(@@) | 3990 - (@)(@@) أسامة بن زيد(@)(@@) الطاعون رجز أرسل عن من كان قبلكم فإذا سمعتم به في أرض فلا تقدموا عليه وإذا وقع بأرض وأنتم بها فلا تخرجوا فرارا منه(@)(@@)(@@)(@@) | 3991 - (@)(@@) صفوان بن أمية(@)(@@) الطاعون والغرق والنفساء والبطن شهادة(@)(@@)(@@)(@@) | 3992 - (@)(@@) أبو عسب مولى النبي صلى الله عليه وسلم الطاعون شهادة لأمتي ورحمة لهم ورجس على الكافر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الظاء(@)(@@) PageV02P467(@)(@@)(@@)(@@) | 3993 - (@)(@@) عقبة بن عامر(@)(@@) ظل المؤمن يوم القيامة صدقته(@)(@@)(@@)(@@) | 3994 - (@)(@@) عائشة(@)(@@) ظهر المؤمن حمى إلا في حد من حدود الله عز وجل يعني لا يضرب إلا في حد من حدود الله عز وجل(@)(@@)(@@)(@@) | 3995 - (@)(@@) أبو هريرة(@)(@@) ظلم الغني المطل(@)(@@) فصل من ذوات الألف واللام(@)(@@)(@@)(@@) | 3996 - (@)(@@) عائشة(@)(@@) الظلم ندامة والطاعة قرة عين والبكاء من(@)(@@) PageV00P000(@)(@@) خشية الله عز وجل النجاة من النار والضحك هلاك البدن(@)(@@)(@@)(@@) | 3997 - (@)(@@) أبو هريرة وابن عمر(@)(@@) الظلم ظلمات يوم القيامة فمن ظلم وصبر كان معي في الجنة كهاتين(@)(@@)(@@)(@@) | 3998 - (@)(@@) أبو أمامة(@)(@@) الظالم مطلوب والمظلوم يتوقع الصبر 
ms271	(@)(@@)(@@)(@@) | 3999 - (@)(@@) علي(@)(@@) الظالم له ثلاث علامات يقهر من دونه بالغلبة ومن فوقه بالمعصية ويظاهر الظلمة(@)(@@)(@@)(@@) | 4000 - (@)(@@) حذيفة(@)(@@) الظلمة وأعوانهم في النار(@)(@@)(@@)(@@) | 4001 - (@)(@@) طلحة الظن يخطىء ويصيب(@)(@@)(@@)(@@) | 4002 - (@)(@@) أبو هريرة(@)(@@) الظن أكذب الحديث ولا تجسسوا ولا تنافسوا ولا تباغضوا ولا تدابروا وكونوا عباد الله إخوانا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4003 - (@)(@@) ابن عباس(@)(@@) علموا ويسروا ولا تعسروا فإذا غضب أحدكم فليسكت(@)(@@)(@@)(@@) | 4004 - (@)(@@) أبو هريرة(@)(@@) علموا ولا تعنفوا فإن المعلم خير من المعنف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4005 - (@)(@@) أنس بن مالك: علموا نساءكم سورة الواقعة فإنها سورة الغنى.(@)(@@)(@@)(@@) | 4006 - (@)(@@) أبي بن كعب(@)(@@) علموا أرقاءكم سورة يوسف وأيما مسلم تعلم سورة يوسف وتلاها وعلمها ما ملكت يمينه وأهله هون الله عليه سكرات الموت وأعطاه من القوة أن لا يحسد مسلما(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4007 - (@)(@@) سبرة بن معبد(@)(@@) علموا الصبي الصلاة ابن سبع سنين وأضربوه عليها ابن عشر سنين(@)(@@)(@@)(@@) | 4008 - (@)(@@) جابر(@)(@@) علموا بنيكم الرمي فإنه نكاية العدو(@)(@@)(@@)(@@) | 4009 - (@)(@@) حذيفة(@)(@@) عجلوا بالركعتين مع المغرب ليرفعا مع الصلاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4010 - (@)(@@) أبو بكرة(@)(@@) عوذوا بالله عز وجل من الكفر والفقر وعذاب القبر(@)(@@)(@@)(@@) | 4011 - (@)(@@) الحكم بن عمير(@)(@@) عودوا قلوبكم الترقب وأكثروا التفكر والبكاء(@)(@@)(@@)(@@) | 4012 - (@)(@@) ابن عباس(@)(@@) علقوا السوط في البيت كي يرهب عنه الخادم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4013 - (@)(@@) ابن عباس(@)(@@) عفوا عن أولادكم فإنها نجاة لهم من كل آفة لأن أخي عيسى قال لأمه يوم السابع من ميلاده يا أمه عفي عني قالت بماذا فوالله مالك من الأرض إلا موضع سجودك فسكت فبعث الله عز وجل بيمامتين أبيضين ذكرين حجازيين فوقعا في حجر عيسى فذبحتهما بمروة ثم تصدقت بهما على أسمه(@)(@@)(@@)(@@) | 4014 - (@)(@@) ابن مسعود(@)(@@) عموا بالسلام وعموا بالتشميت(@)(@@)(@@)(@@) | 4015 - (@)(@@) أنس بن مالك(@)(@@) عودوا المريض وأمروه أن يدعو الله عز وجل لكم فإن دعوة المريض مستجابة وذنبه مغفور(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4016 - (@)(@@) أبو سعيد(@)(@@) عودوا المريض واتبعوا الجنائز تذكركم الآخرة(@)(@@)(@@)(@@) | 4017 - (@)(@@) ابن عباس(@)(@@) عاقبوا أرقاءكم على قدر عقولهم(@)(@@)(@@)(@@) | 4018 - (@)(@@) أنس بن مالك(@)(@@) عد من لا يعودك واهد من لا يهدي إليك(@)(@@) PageV00P000(@)(@@) فصل في التعبد(@)(@@)(@@)(@@) | 4019 - (@)(@@) أبو بكر الصديق(@)(@@) عليكم بلا إله إلا الله والاستغفار والإكثار منها فإن إبليس 
ms272	 قال أهلكت الناس بالذنوب وأهلكوني بلا إله إلا الله والاستغفار فلما رأيت ذلك أهلكتهم بالأهواء وهم يحسبون أنهم مهتدون فلا يستغفرون(@)(@@)(@@)(@@) | 4020 - (@)(@@) ابن مسعود(@)(@@) عليكم بالعلم فإن الرجل من أمتي في آخر الزمان يروي الحديث ويرفعه إلي فما من راو يذكره إلا وأتاه ملك بشير من الملائكة فيقول إن فلان بن فلان قد روى عنك حديث كذا وكذا فأحيا ذكرك بعد موتك فيقول الرجل يا رب مكني يوم القيامة أن أخلصه من النار كما ذكرني بعد موتي(@)(@@)(@@)(@@) | 4021 - (@)(@@) عرباض بن سارية(@)(@@) عليكم بالطاعة فعضوا عليها(@)(@@) PageV00P000(@)(@@) بالنواجذ وإن كان عبدا حبشيا فإنما المؤمن كالجمل الأنف حيث ما قيد انقاد(@)(@@)(@@)(@@) | 4022 - (@)(@@) أبو أمامة(@)(@@) عليكم بالعلم قبل أن يقبض وقبل أن يرفع العالم والمتعلم شريكان في الأجر ولا خير في سائر الناس بعد(@)(@@)(@@)(@@) | 4023 - (@)(@@) علي(@)(@@) عليكم بالقرآن فاتخذوه إماما وقائدا فإنه كلام رب العالمين الذي منه بدأ وإليه يعود(@)(@@)(@@)(@@) | 4024 - (@)(@@) جابر(@)(@@) عليكم بالقرآن فإنه كلام رب العالمين وهو منه فآمنوا بمتشابهه واعتبروا بأمثاله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4025 - (@)(@@) أبو أمامة(@)(@@) عليكم بالتواضع فإن التواضع في القلب ولا يؤذين مسلم مسلما فرب متضاعف في أطمار لو أقسم على الله لأبره(@)(@@)(@@)(@@) | 4026 - (@)(@@) ابن المعتمر(@)(@@) عليكم بالصدق فإن رأيتم فيه الهلكة فإن فيه النجاة وإياكم والكذب وإن رأيتم فيه النجاة فإن فيه الهلكة(@)(@@)(@@)(@@) | 4027 - (@)(@@) أبو موسى(@)(@@) عليكم بالقصد في جنائزكم إذا مشيتم بها(@)(@@)(@@)(@@) | 4028 - (@)(@@) ابن عباس(@)(@@) عليكم بالحزن فإنه مفتاح القلب أجيعوها وأظمئوها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3029 - (@)(@@) سلمان(@)(@@) عليكم بالصلاة فيما بين العشاءين فإنها تذهب بملاغاة أول النهار ومهدنة آخره مهدنة مضعفة(@)(@@)(@@)(@@) | 4030 - (@)(@@) جابر بن عبد الله(@)(@@) عليكم بصلاة الليل فإنه قربة لكم إلى ربكم عز وجل وإن الله يباهي بكم ملائكته ويحببكم إلى خلقه ويدفع عنكم البلاء وميتة السوء ويطفىء عنكم حر النار(@)(@@)(@@)(@@) | 4030 - (@)(@@) مكرر(@)(@@) عليكم بصلاة الليل ولو ركعة واحدة فإن صلاة الليل منهاة عن الإثم وتطفىء غضب الرب تبارك وتعالى وتدفع عن أهلها حر النار يوم القيامة وإن أبغض الخلق إلى الله ثلاثة الرجل يكثر(@)(@@) PageV00P000(@)(@@) النوم بالنهار ولم يصل من 
ms273	 الليل شيئا والرجل يكثر الأكل ولا يسمي الله على طعامه ولا يحمده والرجل يكثر الضحك من غير عجب فإن كثرة الضحك تميت القلب وتورث الفقر(@)(@@)(@@)(@@) | 4031 - (@)(@@) أبو ذر(@)(@@) عليكم بقيام هذا الليل فإنه دأب الصالحين من قبلكم ومنهاة من اللغو ومطردة للأذى من الجسد(@)(@@)(@@)(@@) | 4032 - (@)(@@) ابن عباس(@)(@@) عليكم بالصف الأول وعليكم بالميمنة وإياكم والصف بين السواري(@)(@@)(@@)(@@) | 4033 - (@)(@@) علي(@)(@@) عليكم بحسن الخلق فإن حسن الخلق في الجنة لا محالة وإياكم وسوء الخلق فإن سوء الخلق في النار لا محالة(@)(@@)(@@)(@@) | 4034 - (@)(@@) أبو أمامة(@)(@@) عليكم بلباس الصوف تجدون حلاوة الإيمان(@)(@@) PageV00P000(@)(@@) وقلة الأكل تعرفون في الآخرة وإن النظر إلى الصدق يورث التفكر والتفكر يورث الحكمة والحكمة تجري في أجوافكم مثل الدم(@)(@@)(@@)(@@) | 4035 - (@)(@@) عبد الله بن رافع بن خديج(@)(@@) عليكم بتأخير الظهر(@)(@@)(@@)(@@) | 4036 - (@)(@@) بريدة الأسلمي(@)(@@) عليكم هديا قاصدا فإنه من يشاد هذا الدين يغلبه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4037 - (@)(@@) جابر(@)(@@) عليكم دياركم فإنما تكتب آثاركم(@)(@@) فصل في التزويج وغيره(@)(@@)(@@)(@@) | 4038 - (@)(@@) أنس بن مالك(@)(@@) عليكم بالباءة فمن لم يستطع فعليه بالصوم فإن الصوم له وجاء(@)(@@)(@@)(@@) | 4039 - (@)(@@) عبد الرحمن بن عوف(@)(@@) عليكم بالأبكار فإنهن أعذب أفواها وأفتق أرحاما وأرضا باليسير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4040 - (@)(@@) أنس بن مالك(@)(@@) عليكم بالوجوه الحسان والحداق السود فإن الله عز وجل يستحي أن يعذب وجها مليحا بالنار(@)(@@)(@@)(@@) | 4041 - (@)(@@) أبو الدرداء(@)(@@) عليكم بالسراري فإنهن مباركات الأرحام(@)(@@)(@@)(@@) | 4042 - (@)(@@) سمرة بن جندب(@)(@@) عليكم بهذه الثياب البياض فليلبسها أحياؤكم وكفنوا فيها موتاكم فإنها من خير ثيابكم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4043 - (@)(@@) علي بن أبي طالب(@)(@@) عليكم بالمشط فإنه يذهب بالغم والوباء والفقر(@)(@@)(@@)(@@) | 4044 - (@)(@@) أبو هريرة(@)(@@) عليكم بالدلجة فإن لله عز وجل ملائكة موكلين يطوون الأرض للمسافرين كما تطوى القراطيس(@)(@@)(@@)(@@) | 4045 - (@)(@@) سعد بن أبي وقاص(@)(@@) عليكم بالرمي فإنه من خير لعبكم(@)(@@)(@@)(@@) | 4046 - (@)(@@) جابر(@)(@@) عليكم بالأسود البهيم ذي النقطتين فإنه شيطان(@)(@@) PageV00P000(@)(@@) يعني الكلب البهيم لون واحد لا يخالطه غيره سوادا كان أو غيره(@)(@@) فصل في الأدوية وغيرها(@)(@@)(@@)(@@) | 4047 - (@)(@@) صهيب(@)(@@) عليكم بالحجامة في جوزة القمحدوة فإنها شفاء من اثنين وسبعين داء وخمسة أدواء من الجنون والجذام والبرص ووجع الأضراس(@)(@@) القمحدوة 
ms274	 فاس القفا الذي إذا استلقى الرجل أصاب الأرض من رأسه(@)(@@)(@@)(@@) | 4048 - (@)(@@) النضر بن حميد(@)(@@) عليكم بالكحل عند النوم فإنه يجلو البصر وينبت الشعر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4049 - (@)(@@) جابر بن عبد الله(@)(@@) عليكم بالشمس فإنها بكم برة تنزع الوجع والصداع من الرأس(@)(@@)(@@)(@@) | 4050 - (@)(@@) أنس(@)(@@) عليكم بالمرزنجوش فشموه فإنه جيد للخشام(@)(@@) الخشام داء يأخذ الرجل في أنفه ويقال رجل مخشوم(@)(@@) فصل آخر في المأكول منها(@)(@@)(@@)(@@) | 4051 - (@)(@@) ابن مسعود(@)(@@) عليكم بالشفاءين العسل والقرآن(@)(@@)(@@)(@@) | 4052 - (@)(@@) أبو هريرة(@)(@@) عليكم بالهليج الأسود فإنه من شجر الجنة(@)(@@) PageV00P000(@)(@@) طعمه مر وفيه شفاء من كل داء(@)(@@)(@@)(@@) | 4053 - (@)(@@) عبد الله بن حرام(@)(@@) عليكم بالسنا والسنون فإن فيهما شفاء من كل داء(@)(@@) السنون فيه مقال يقال هو العسل ويقال هو الزارناتخ ويقال الشين ويقال الكمون ويقال عكة السمن بعصر فتخرج خطوط سود مع السمن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4054 - (@)(@@) عقبة بن عامر(@)(@@) عليكم بهذه الشجرة المباركة زيت الزيتون فتداوا به فإن فيه منفعة للناسور(@)(@@)(@@)(@@) | 4055 - (@)(@@) واثلة بن الأسقع(@)(@@) عليكم بالقرع فإنه يزيد في الدماغ(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4056 - (@)(@@) ابن عباس(@)(@@) عليكم باللبان فإنه يمسح الحزن عن القلب كما يمسح الأصبع العرق عن الجبين ويشد القلب ويزيد في العقل ويذكي الذهن ويجلي البصر ويذهب النسيان(@)(@@)(@@)(@@) | 4057 - (@)(@@) علي بن أبي طالب(@)(@@) عليكم بالرمان فكلوه بشحمه فإنه دباغ المعدة وما من حبة تقع في جوف رجل إلا أنارت قلبه وخرست شياطين الوسوسة أربعين يوما(@)(@@)(@@)(@@) | 4058 - (@)(@@) ابن مسعود(@)(@@) عليكم بألبان البقر فإنها دواء وأسمانها شفاء وإياكم ولحومها فإن لحومها داء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4059 - (@)(@@) ابن عمر(@)(@@) عليكم بالفواكه بالاقبال فإنها مصحة للأبدان مطردة للأحزان واتقوها في الإدبار فإنها داء للأبدان(@)(@@)(@@)(@@) | 4060 - (@)(@@) علي بن أبي طالب(@)(@@) عليكم بالعدس فإنه مبارك مقدس وإنه يرق القلب ويكثر الدمعة وقد بارك فيه سبعون نبيا آخرهم عيسى بن مريم عليه السلام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4061 - (@)(@@) عائشة(@)(@@) عليكم بالبغيض النافع يعني التلبينة والذي نفسي بيده إنه ليغسل بطن أحدكم كما يغسل أحدكم وجهه من الوسخ(@)(@@)(@@)(@@) | 4062 - (@)(@@) عبد الرحمن بن دلهم(@)(@@) عليكم بالأترج فإنه يشد الفؤاد ويزيد في الدماغ(@)(@@)(@@)(@@) | 4063 - (@)(@@) عائشة(@)(@@) عليكم بالمرازمة أكل الخبر بالعنب(@)(@@)(@@)(@@) | 4064 - (@)(@@) معاذ 
ms275	 بن جبل(@)(@@) عليكم بأكل لحوم الإبل فإنه لا يأكل لحومها إلا كل مؤمن مخالف لليهود أعداء الله(@)(@@)(@@)(@@) | 4065 - (@)(@@) أنس بن مالك(@)(@@) عليكم بالغداء المبارك السحور وإن لم يصب أحدكم إلا جرعة فليتسحر بها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4066 - (@)(@@) جابر(@)(@@) عليكم بالأسود منه يعني الكباث فإنه أطيبه فإني كنت آكله زمن كنت أرعى وهل بعث نبي إلا وهو راع(@)(@@) الكباث ورق الأراك ويقال تمر الأراك(@)(@@) فصل(@)(@@)(@@)(@@) | 4067 - (@)(@@) أبو ذر الغفاري(@)(@@) عليك بالورع تكن أعبد العابدين وعليك بالقنوع تكن أشكر الشاكرين وأقل الضحك فإنه ممرضة للقلب وأحسن إلى جارك فإذا قال قد أحسنت فقد أحسنت(@)(@@)(@@)(@@) | 4068 - (@)(@@) أبو ذر(@)(@@) عليك بتلاوة القرآن وذكر الله فإنه ذكر لك في السماء ونور لك في الأرض وعليك بطول الصمت فإنه مطردة للشياطين وعون لك على أمر دينك وقل الحق وإن كان مرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4069 - (@)(@@) سعد بن أبي وقاص(@)(@@) عليك بالإياس مما في أيدي الناس وإياك والطمع فإنه الفقر الحاضر(@)(@@)(@@)(@@) | 4070 - (@)(@@) أبو أمامة(@)(@@) عليك بالهجرة فإنه لا مثل لها(@)(@@)(@@)(@@) | 4071 - (@)(@@) معاذ(@)(@@) عليك بالرفق والعفو في غير ترك الحق حتى يقول الجاهل قد ترك من حق الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4072 - (@)(@@) عبد الله بن الأسقع(@)(@@) عليك بالشام فإنها صفوة الله عز وجل من بلاده يسوف الله إليها صفوته من عباده(@)(@@)(@@)(@@) | 4073 - (@)(@@) سلمان الفارسي(@)(@@) عليك بالعسل فوالذي نفسي بيده ما من بيت فيه عسل إلا وتستغفر الملائكة لذلك البيت فإن شربها رجل دخل في جوفه ألف دواء ويخرج ألف داء فإن مات وهو في جوفه لم تمس النار جسده(@)(@@)(@@)(@@) | 4074 - (@)(@@) علي بن أبي طالب(@)(@@) عليك بالملح فإنه شفاء من سبعين داء منه الجنون والجذام والبرص(@)(@@)(@@)(@@) | 4075 - (@)(@@) ابن عباس(@)(@@) عليك بالتبن فإنه رأس مال يسير وربحه كثير وعليك بالبز فإن فيه تسعة أعشار البركة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4076 - (@)(@@) أم أنس(@)(@@) عليك بالصلاة فإنها أفضل الجهاد واهجري المعاصي فإنها أفضل الهجرة(@)(@@)(@@)(@@) | 4077 - (@)(@@) يسيرة(@)(@@) عليكن بالتسبيح والتهليل والتقديس واعقدن بالأنامل فإنهن مسؤولات مستنطقات ولا تيأسن فتنسين الرحمة(@)(@@) فصل(@)(@@)(@@)(@@) | 4078 - (@)(@@) عبد الرحمن بن عوف(@)(@@) عشرة في الجنة أبو بكر وعمر وعثمان وعلي 
ms276	 وطلحة والزبير وعبد الرحمن بن عوف وسعد بن أبي وقاص وسعيد بن زيد وأبو عبيدة بن الجراح(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4079 - (@)(@@) عائشة(@)(@@) عشرة من الفطرة قص الشارب وإعفاء اللحية والسواك والاستنشاق بالماء وقص الأظفار وغسل البراجم ونتف الإبط وحلق العانة والانتقاص بالماء يعني الاستنجاء(@)(@@)(@@)(@@) | 4080 - (@)(@@) عبد الله بن جعفر(@)(@@) عشرة لا يتركون في قبورهم ولكنهم يصلون بين يدي الله عز وجل حتى ينفخ في الصدر الأنبياء والشهداء والمؤذنون والملبون والمتوفى في طريق مكة والمرأة تموت في نفاسها والتائبون من الذنوب وخادم المسلمين في طاعة الله عز وجل والمصلون بالليل والناس نيام والمترحمون على فقراء أمتي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4081 - (@)(@@) ابن عباس(@)(@@) عشرة من أخلاق قوم لوط الحذف في النادي ومضغ العلك والسواك على ظهر الطريق والصفير بالحمام والجلاهق والعمامة التي لا يتحلى بها والسكينية والتطريف بالحنا وحل أزرار الأقنية والمشي في الأسواق والأفخاذ بادية(@)(@@)(@@)(@@) | 4082 - (@)(@@) ابن مسعود(@)(@@) عشرة أصناف من أمتي لا ينظر الله إليهم يوم القيامة ولا يكلمهم ولهم عذاب أليم إلا أن يتوبوا أو ينيبوا المتلذذون بالقهوات واللاعبون بالمساهمات والضاربون بالكوبات واللاهون بالعرطيات والمانعون الزكوات والغانمون الأمانات والنائمون عن العتمات والغدوات والعشارون في الطرقات والطالبون للشهوات واللذات والراضوان في المنكرات(@)(@@)(@@)(@@) | 4083 - (@)(@@) أنس بن مالك(@)(@@) عشر خصال يورثن النسيان أكل الجبن وأكل سؤر الفأر وأكل التفاحة الحامضة والجلجلان والحجامة على النقرة والمشي بين امرأتين والنظر إلى المصلوب والبول في الماء الراكد وإلقاء القملة والقراة في المقبرة(@)(@@) الجلجلان نوع من السمسم وهو الأسود(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4084 - (@)(@@) عائشة(@)(@@) عشرة مباحة في الغزو الطعام والإدام والثمار والشجر والخل والزيت والشراب والحجر والعود غير منحوت والجلد الطري(@)(@@) فصل(@)(@@)(@@)(@@) | 4085 - (@)(@@) عقبة بن عامر(@)(@@) عجب الله عز وجل من شاب ليست له صبوة(@)(@@)(@@)(@@) | 4086 - (@)(@@) أبو هريرة(@)(@@) عجب ربنا عز وجل من أقوام يقادون إلى الجنة في السلاسل وهم كارهون(@)(@@)(@@)(@@) | 4087 - (@)(@@) ابن مسعود(@)(@@) عجب ربنا عز وجل من رجل قام من فراشه ولحافه من بين حبه وأهله إلى صلاته فيقول الله لملائكته انظروا(@)(@@) PageV00P000(@)(@@) إلى عبدي هذا قام من بين فراشه ولحافه من بين حبه 
ms277	 وأهله إلى صلاته رغبة فيما عندي وشفقة مما عندي(@)(@@) عجب أي عظم ربك وكبر(@)(@@)(@@)(@@) | 4088 - (@)(@@) أنس بن مالك(@)(@@) عجبت من مجادلة العبد ربه يوم القيامة يقول أليس وعدتني أن لا تظلمني قال بلى قال فإني لا أقبل علي إلا شاهدا من نفسي قال أوليس كفاني بالملائكة المقربين فيختم على فيه وتتكلم أركانه بما كان يعمل فيقول بعدا لكن وسحقا عنكن كنت أجادل(@)(@@)(@@)(@@) | 4089 - (@)(@@) عمرو(@)(@@) عجبت لرجلين مررت بهما وأحدهما يسب الآخر والآخر يقول يرحمك الله والملك بينهما يرد على كل واحد منهما قوله(@)(@@)(@@)(@@) | 4090 - (@)(@@) علي بن أبي طالب(@)(@@) عجبت لربنا عز وجل يعجبه العبد إذا قال اغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت قال علم عبدي أنه لا رب له غيري(@)(@@)(@@)(@@) | 4091 - (@)(@@) أم حرام بنت ملحان(@)(@@) عجبت من قوم من أمتي يركبون البحر كالملوك على الأسرة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4092 - (@)(@@) أنس(@)(@@) عجبت من منزلة المؤمن عند الله إذا أحسن قبل منه وإذا أساء غفر له(@)(@@)(@@)(@@) | 4093 - (@)(@@) ابن عباس(@)(@@) عجبت لصبر أخي يوسف وكرمه والله يغفر له حيث أرسل إليه ليستفتا في الرؤيا لو كنت أنا ما أخبرتهم حتى يخرجوني وحيث أبى ليخرج من السجن فلم يخرج حتى أخبرهم بعذره ولو كنت أنا لبادرتهم الباب(@)(@@)(@@)(@@) | 4094 - (@)(@@) ابن مسعود(@)(@@) عجبت لأمر المؤمن إن أمره له كله خير ليس ذلك لأحد إلا للمؤمن إن أصابته سراء شكر فكان خيرا له وأن أصابته ضراء صبر فكان خيرا له(@)(@@)(@@)(@@) | 4095 - (@)(@@) ابن مسعود(@)(@@) عجبا لغافل ولا يغفل عنه وعجبا لطالب الدنيا والموت يطلبه وعجبا لضاحك ملء فيه لا يدري أرضى الله أم أسخطه(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 4096 - (@)(@@) أنس بن مالك(@)(@@) عمل البر كله نصف العبادة والدعاء نصف فإذا أرادالله بعبد خيرا امتحن قلبه للدعاء(@)(@@)(@@)(@@) | 4097 - (@)(@@) سهل بن سعد(@)(@@) عمل الأبرار من الرجال الخياطة وعمل الأبرار من النساء المغزل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4098 - (@)(@@) ابن مسعود(@)(@@) عمل قليل في السنة خير من عمل كثير في البدعة(@)(@@)(@@)(@@) | 4099 - (@)(@@) عبد الله بن عمرو(@)(@@) عمل يسير قل من يحافظ عليه من حافظ عليه دخل الجنة أن يقول 
ms278	 العبد في دبر كل صلاة سبحان الله عشرا والحمد لله عشرا ولا إله إلا الله عشرا والله أكبر عشرا(@)(@@)(@@)(@@) | 4100 - (@)(@@) ابن عباس(@)(@@) عالم ينتفع بعلمه خير من ألف عابد(@)(@@)(@@)(@@) | 4101 - (@)(@@) ابن عمر(@)(@@) عمل لا يعلم ثواب عامله إلا الله الصيام لا يعلم ثواب عامله إلا الله(@)(@@) فصل(@)(@@)(@@)(@@) | 4102 - (@)(@@) أبو سعيد(@)(@@) علم الإيمان الصلاة فمن فرغ لها قلبه وحافظ عليها بحدودها ووقتها وسنتها فهو مؤمن(@)(@@)(@@)(@@) | 4103 - (@)(@@) معاذ بن جبل(@)(@@) علم القرآن على ثلاثة أجزاء حلال فاتبعه وحرام فاجتنبه ومتشابه يشكل عليك فكله إلى عالمه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4104 - (@)(@@) علي بن أبي طالب(@)(@@) علم الباطن سر من سر الله عز وجل وحكم من حكم الله يقذفه في قلوب من يشاء من أوليائه(@)(@@)(@@)(@@) | 4105 - (@)(@@) عطية بن بسر(@)(@@) علم الله عز وجل آدم ألف حرفة من الحرف فقال له قل لولدك وذريتك إن لم تصبروا فاطلبوا الدنيا بهذه الحرف ولا تطلبوها بدين فإن الدين لي وحدي خالصا ويل لمن طلب بالدين الدنيا ويل له(@)(@@)(@@)(@@) | 4106 - (@)(@@) زيد بن حارثة(@)(@@) علمني جبريل الوضوء وأمرني أن أنضح تحت ثوبي لما يخرج من البول بعد الوضوء(@)(@@)(@@)(@@) | 4107 - (@)(@@) أبو هريرة(@)(@@) علمني جبريل الصلاة فقام وكبر ثم قرأ بسم الله الرحمن الرحيم يجهر بها في كل ركعة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8418 - (@)(@@) علي بن أبي طالب(@)(@@) علمني جبريل وأوجز فقال يا محمد أحبب من شئت فإنك مفارقه وعش ما شئت فإنك ميت واعمل ما شئت فإنك ملاقيه(@)(@@) فصل(@)(@@)(@@)(@@) | 4109 - (@)(@@) أنس بن مالك(@)(@@) عائد المريض يخوض في الرحمة حتى إذا قعد عنده غمرته الرحمة(@)(@@)(@@)(@@) | 4110 - (@)(@@) ثوبان(@)(@@) عائد المريض في خرفة الجنة حتى يرجع(@)(@@) PageV03P043(@)(@@)(@@)(@@) | 4111 - (@)(@@) ابن عباس(@)(@@) عيادة المريض أول يوم فريضة وما بعد ذلك تطوع(@)(@@)(@@)(@@) | 4111 - (@)(@@) مكرر ابن عمر(@)(@@) عيادة المريض أعظم أجرا من اتباع الجنائز(@)(@@)(@@)(@@) | 4112 - (@)(@@) علي(@)(@@) عدة المؤمن دين وعدة المؤمن كالأخذ باليد(@)(@@)(@@)(@@) | 4113 - (@)(@@) حبيب بن خماشة(@)(@@) عرفة كلها موقف إلا بطن عرفة والمزدلفة كلها موقف إلا بطن محسر(@)(@@)(@@)(@@) | 4114 - (@)(@@) علي(@)(@@) عورة الرجل على الرجل كعورة المرأة على الرجل وعورة المرأة على المرأة كعورة الرجل على 
ms279	 المرأة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4115 - (@)(@@) أبو سعيد(@)(@@) عورة الرجل ما بين سرته إلى ركبته(@)(@@)(@@)(@@) | 4116 - (@)(@@) عمرو بن العاص(@)(@@) عدة أم الولد عدة الحرة(@)(@@)(@@)(@@) | 4117 - (@)(@@) أبو سعيد(@)(@@) عدة المختلعة حيضة(@)(@@)(@@)(@@) | 4118 - (@)(@@) عبد الله بن عمرو(@)(@@) عقل المرأة مثل عقل الرجل حتى يبلغ الثلث من ديتها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4119 - (@)(@@) عبد الله بن عمرو(@)(@@) عقل شبه العمد مغلظ مثل قتل العمد ولا يقتل صاحبه(@)(@@) فصل(@)(@@)(@@)(@@) | 4120 - (@)(@@) سهل بن سعد(@)(@@) عند الله عز وجل خزائن الخير والشر مفتاحها الرجال فطوبى لمن خلقته مفتاحا للخير مغلاقا للشر وويل لمن خلقته مفتاحا للشر مغلاقا للخير(@)(@@) الشرير عند الله عز وجل علم أمية بن أبي الصلت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4121 - (@)(@@) أنس بن مالك(@)(@@) عند كل ختمة للقرآن دعوة مستجابة(@)(@@)(@@)(@@) | 4122 - (@)(@@) أنس(@)(@@) عند آذان المؤذنين يستجاب الدعاء(@)(@@)(@@)(@@) | 4123 - (@)(@@) أبو هريرة(@)(@@) عند اتخاذ الأغنياء الدجاج هلاك الفقراء ويأذن الله عز وجل بهلاك القرى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4124 - (@)(@@) ثوبان(@)(@@) عصابتان من أمتي أحذرهما الله عز وجل عن النار عصابة تغزو الهند وعصابة تكون مع عيسى بن مريم صلوات الله وسلامه عليه(@)(@@)(@@)(@@) | 4125 - (@)(@@) أبو هريرة(@)(@@) عينان لا تمسهما النار عين بكت من خشية الله وعين باتت ساهرة في سبيل الله وحرم الله عز وجل الفردوس على عين بكت على الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4126 - (@)(@@) أنس بن مالك(@)(@@) عسقلان إحدى العروسين يبعث الله عز وجل منهما يوم القيامة سبعين ألف ليس عليهم حساب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4127 - (@)(@@) معاذ بن جبل(@)(@@) عمران بيت المقدس خراب يثرب وخراب يثرب خروج ملحمة وخروج ملحمة فتح قسطنطينية وفتح قسطنطينية خروج الدجال(@)(@@)(@@)(@@) | 4128 - (@)(@@) أبو هريرة(@)(@@) عنوان كتاب المؤمن يوم القيامة حسن ثناء الناس(@)(@@)(@@)(@@) | 4129 - (@)(@@) أسماء بنت يزيد(@)(@@) عن الغلام شاتان متكافئتان وعن الجارية شاة لا يضركم ذكرانا كانت أم إناثا(@)(@@) المكافئتان المثلان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4130 - (@)(@@) ابن عباس(@)(@@) عبد مناف غرر قريش وأسد ركحها وعضدها وزهرة كبدها وعدي نجاحها ومخزوم ريحانتها وأريكتها في نصرتها وجمح سهم حديقتها وعامر فرسانها وليوثها وعبد الدار رؤوسها وأوتادها والناس تبع لقريش وقريش تبع لقصي(@)(@@) الركح الخيل الصغير إلى جنب الخيل الكبير(@)(@@)(@@)(@@) | 4131 - (@)(@@) عائشة(@)(@@) عمار ما عرض عليه أمران إلا اختار الأرشد 
ms280	 منهما(@)(@@)(@@)(@@) | 4132 - (@)(@@) أنس(@)(@@) علق سوطك حيث يراه أهلك ولا تضربهم به واضربهم بنعلك ضربا غير مبرح ولا شائن لوجه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4133 - (@)(@@) معاذ بن جبل(@)(@@) عبد الله بن سلام عاشر عشرة في الجنة(@)(@@)(@@)(@@) | 4134 - (@)(@@) علي وابن عمر(@)(@@) عبد الرحمن بن عوف في السماء يسمى الأمين(@)(@@) فصل(@)(@@)(@@)(@@) | 4135 - (@)(@@) عمر بن الخطاب(@)(@@) عدل في حكم ساعة خير من عبادة سبعين سنة وجور في حكم ساعة يحبط عبادة سبعين سنة(@)(@@)(@@)(@@) | 4136 - (@)(@@) أبو الدرداء(@)(@@) عريش كعريش موسى ثمام وخشبات والأمر أعجل من ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4137 - (@)(@@) عائشة بنت قدامة(@)(@@) عزيز على الله عز وجل أن يأخذ عيني مسلم ثم يدخله النار(@)(@@)(@@)(@@) | 4138 - (@)(@@) جابر(@)(@@) عمرة في رمضان تعدل حجة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4139 - (@)(@@) عقبة بن عامر(@)(@@) عهدة الرقيق ثلاثة أيام(@)(@@)(@@)(@@) | 4140 - (@)(@@) معقل بن يسار(@)(@@) عقوبة هذه الأمة السيف والساعة موعدهم والساعة أدهى وأمر(@)(@@)(@@)(@@) | 4141 - (@)(@@) أنس(@)(@@) علامة حب الله عز وجل حب ذكره وعلامة بغض الله عز وجل بغض ذكره(@)(@@)(@@)(@@) | 4142 - (@)(@@) ابن مسعود علامة غضب الله غز وجل على أمتي أن يغلي أسعارهم ويستعمل عليهم شرارهم(@)(@@)(@@)(@@) | 4134 - (@)(@@) البراء بن عازب(@)(@@) علامة أهل الجنة في سبع خصال(@)(@@) PageV00P000(@)(@@) يعفو عمن ظلمه ويحسن إلى من أساء إليه ويعطي لمن حرمه إن أعطى شكر وإن ابتلي صبر وإن قال صدق فهو يمشي بين الناس كحي بين الأموات(@)(@@)(@@)(@@) | 4144 - (@)(@@) طلحة(@)(@@) عمرو بن العاصي من صالحي قريش(@)(@@)(@@)(@@) | 4145 - (@)(@@) عويمر حكيم(@)(@@) أمتي وجندب طريد أمتي يعيش وحده ويموت وحده والله وحده يكفيه(@)(@@)(@@)(@@) | 4146 - (@)(@@) أبو هريرة(@)(@@) عمر بن الخطاب سراج أهل الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4147 - (@)(@@) الفضل بن عباس(@)(@@) عمر معي وأنا مع عمر والحق بعدي مع عمر حيث كان(@)(@@)(@@)(@@) | 4148 - (@)(@@) أنس(@)(@@) عمار المساجد هم أهل الله عز وجل(@)(@@)(@@)(@@) | 4149 - (@)(@@) أنس بن مالك(@)(@@) عظم الجزاء مع عظم البلاء والصبر عند الصدمة الأولى وإن الله عز وجل إذا أراد بقوم خيرا ابتلاهم فمن رضي فله الرضا ومن جزع فله الجزع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4150 - (@)(@@) أبو هريرة(@)(@@) عمر أمتي ما بين الستين إلى السبعين فما فوق ذلك فأمراض وأسقام(@)(@@)(@@)(@@) | 4151 - (@)(@@) أنس بن مالك(@)(@@) عمر الدنيا سبعة أيام من أيام 