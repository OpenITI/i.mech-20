ms341	(@)(@@)(@@)(@@) | 6684 - (@)(@@) نوح عن أبي مجلز عن أبي ذر في حسن الخلق لا يصح حديثه(@)(@@)(@@)(@@) | 6685 - (@)(@@) نوفل بن سليمان الهنائي عن ابن جريج ضعفه الدارقطني(@)(@@)(@@)(@@) | 6686 - (@)(@@) نوفل بن عبد الملك عن أبيه عن علي في ذوات الدر قال ابن معين ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - حرف الهاء(@)(@@)(@@)(@@) | 6687 - (@)(@@) هارون بن أحمد ثنا البغوي فذكر حديثا موضوعا كأنه أدخل عليه(@)(@@)(@@)(@@) | 6688 - (@)(@@) هارون بن أيوب عن سلمة بن كهيل مجهول(@)(@@)(@@)(@@) | 6689 - (@)(@@) هارون بن الجهم بن ثوبر روى عنه سعد بن الصلت يخالف في حديثه(@)(@@)(@@)(@@) | 6690 - (@)(@@) هارون بن حاتم الكوفي عن أبي بكر بن عياش ذكره أبو حاتم فقال أسأل الله السلامة(@)(@@)(@@)(@@) | 6691 - (@)(@@) هارون بن حبيب البلخي عن جويبر قال الأزدي كذاب مجهول(@)(@@)(@@)(@@) | 6692 - (@)(@@) هارون بن حيان الرقي عن ابن المنكدر قال الدارقطني ليس بالقوي وأما الحاكم فقال كان يضع الحديث(@)(@@)(@@)(@@) | 6693 - (@)(@@) هارون بن دينار بصري عن أبيه طبقة هشيم ضعفه الدارقطني وغيره(@)(@@)(@@)(@@) | 6694 - (@)(@@) هارون بن راشد البصري عن رجل عن أبي هريرة مجهول(@)(@@)(@@)(@@) | 6695 - (@)(@@) هارون بن زياد عن الأعمش قال ابن حبان كان ممن يضع الحديث(@)(@@)(@@)(@@) | 6696 - (@)(@@) هارون بن أبي زياد التميمي عن ابن عمر مجهول(@)(@@)(@@)(@@) | 6697 - (@)(@@) هارون بن سعد العجلي شيخ للمسعودي صدوق لكنه رافضي ثقل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6698 - (@)(@@) هارون بن سعد مولى قريش صاحب راية علي بيض له مجهول(@)(@@)(@@)(@@) | 6699 - (@)(@@) هارون بن سوادة يروي عنه زياد بن الربيع ضعفه الأزدي(@)(@@)(@@)(@@) | 6700 - (@)(@@) د س / هارون بن عنترة عن أبيه وثقه أحمد وابن معين وقال ابن حبان لا يجوز أن يحتج به(@)(@@)(@@)(@@) | 6701 - (@)(@@) هارون بن عيسى الهاشمي قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) | 6702 - (@)(@@) س / هارون بن أبي عيسى عن إبن اسحاق قال البخاري يخطئ في غير ابن اسحاق(@)(@@)(@@)(@@) | 6703 - (@)(@@) هارون بن قزعة المدني عن رجل من آل الخطاب في زيارة قبر النبي صلى الله عليه وسلم قال خ لا يتابع عليه(@)(@@)(@@)(@@) | 6704 - (@)(@@) هارون بن كثير عن زيد بن أسلم مجهول(@)(@@)(@@)(@@) | 6705 - (@)(@@) هارون بن محمد أبو الطيب عن ابن أبي عروبة قال يحيى بن معين كذاب(@)(@@)(@@)(@@) | 6706 - (@)(@@) هارون بن مسلم 
ms342	 عن قتادة مجهول(@)(@@)(@@)(@@) | 6707 - (@)(@@) هارون بن مسلم صاحب الحناء عن أبيه والقاسم بن عبد الرحمن قال أبو حاتم فيه لين قلت روى عنه سويد ونصر بن علي ووثقه الحاكم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6708 - (@)(@@) ق / هارون بن هارون التيمي عن مجاهد والأعرج ضعفوه(@)(@@)(@@)(@@) | 6709 - (@)(@@) هارون أبو قزيمة قال الأزدي متروك(@)(@@)(@@)(@@) | 6710 - (@)(@@) د س ق / هاشم بن البريد صدوق يترفض(@)(@@)(@@)(@@) | 6711 - (@)(@@) هاشم بن حبيب البصري ضعفه الأزدي(@)(@@)(@@)(@@) | 6712 - (@)(@@) هاشم بن زيد الدمشقي عن نافع قال أبو حاتم ضعيف الحديث(@)(@@)(@@)(@@) | 6713 - (@)(@@) هاشم بن سعيد الكوفي عن هشام بن عروة قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 6714 - (@)(@@) هاشم بن عبد الله لا يدري من هو تفرد عنه بقية(@)(@@)(@@)(@@) | 6715 - (@)(@@) هاشم بن عيسى الحمصي عن أبيه عن يحيى بن سعيد الانصاري لا يعرف 6716 - ق / هاشم بن القاسم الحراني عن يعلى بن الأشدق قال أبو عروبة كبر وتغير(@)(@@)(@@)(@@) | 6717 - (@)(@@) هاشم بن محمد الربعي عن حماد بن زيد قال العقيلي لا يتابع على حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6718 - (@)(@@) هاشم بن ناصح روى شيئا في ذم الغناء قال ابن حزم لا يعرف(@)(@@)(@@)(@@) | 6719 - (@)(@@) هاشم بن أبي هاشم الكوفي عن أبيه مجهول(@)(@@)(@@)(@@) | 6720 - (@)(@@) هاشم بن مرثد الطبراني عن آدم بن أبي إياس قال ابن حبان ليس بشيء(@)(@@)(@@)(@@) | 6721 - (@)(@@) هاشم بن يحيى المزني عن أبي دغفل لا يعرفان(@)(@@)(@@)(@@) | 6722 - (@)(@@) هاشم الأوقص قال البخاري غير ثقة(@)(@@)(@@)(@@) | 6723 - (@)(@@) هانئ بن ايوب الجعفي قال ابن سعد فيه ضعف قلت صدوق سمع محارب بن دثار(@)(@@)(@@)(@@) | 6724 - (@)(@@) هانئ بن خالد عن أبي جعفر الرازي قال أبو حاتم فيه جهالة(@)(@@)(@@)(@@) | 6725 - (@)(@@) هانئ بن المتوكل الاسكندراني تكلم فيه ابن حبان(@)(@@)(@@)(@@) | 6726 - (@)(@@) د ت ق / هانئ بن هانئ عن علي ليس بالمعروف قال ابن المديني مجهول(@)(@@)(@@)(@@) | 7627 - (@)(@@) هانئ أبو سليمان الربعي روى عنه داود بن رشيد مجهول(@)(@@)(@@)(@@) | 6728 - (@)(@@) هبة الله بن الحسن بن المظفر بن السبط عن أبيه وابن كادش قال ابن نقطة غير مرضي في دينه(@)(@@)(@@)(@@) | 6729 - (@)(@@) هبة الله بن أبي شريك الحاسب عن أبي النقور صحيح السماع قال ابن السمعاني كانت الألسنة 
ms343	 مجمعة على الثناء السيء عليه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6730 - (@)(@@) هبة الله بن المبارك السقطي محدث متأخر قال ابن ناصر ليس بثقة(@)(@@)(@@)(@@) | 6731 - (@)(@@) هبة الله بن المبارك بن الدواتي الكاتب سمع ابن غيلان قال ابن ناصر يتهم بالرفض والإعتزال(@)(@@)(@@)(@@) | 6732 - (@)(@@) هبيرة بن عبد الرحمن بن رافع بن خديج قال الأزدي يتكلمون فيه(@)(@@)(@@)(@@) | 6733 - (@)(@@) هبيرة بن عبد الرحمن ويقال ابن غنم ذكره ابن عدي في الضعفاء(@)(@@)(@@)(@@) | 6734 - (@)(@@) عه / هبيرة بن يريم عن علي تفرد عنه أبو إسحاق قال ابن خراش ضعيف كان يجيز على قتلى صفين وقال أبو حاتم شبيه بالمجهول وقال الجوزجاني كان مختاريا(@)(@@)(@@)(@@) | 6735 - (@)(@@) هبيرة العدوي روى عنه محمد بن موسى الحرشي قال ابن معين لا شيء(@)(@@)(@@)(@@) | 6736 - (@)(@@) خ م / هدبة بن خالد القيسي وثقه جماعة وقال النسائي ضعيف وقواه مرة(@)(@@)(@@)(@@) | 6737 - (@)(@@) الهجيع بن قيس الكوفي قال الدارقطني لا شيء له حديثان(@)(@@)(@@)(@@) | 6738 - (@)(@@) الهذيل بن بلال المدائني عن نافع ضعفه الدارقطني وغيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6739 - (@)(@@) ق / الهذيل بن الحكم عن الحكم بن ابان قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 6740 - (@)(@@) هرير بن عبد الرحمن بن رافع بن خديج عن جده قال الأزدي يتكلمون في حديثه(@)(@@)(@@)(@@) | 6741 - (@)(@@) د ق / هرماس بن حبيب عن أبيه عن جده قال أحمد ويحيى لا يعرف(@)(@@)(@@)(@@) | 6742 - (@)(@@) هزان بن ثابت مجهول(@)(@@)(@@)(@@) | 6743 - (@)(@@) هشام بن أبي ابراهيم عن ابن عمر مجهول(@)(@@)(@@)(@@) | 6744 - (@)(@@) هشام بن حجير المكي من شيوخ ابن جريج ضعفه ابن معين وأحمد(@)(@@)(@@)(@@) | 6745 - (@)(@@) ع / هشام بن حسان ثقة مشهور روى شعيب بن(@)(@@) PageV00P000(@)(@@) حرب عن شعبة قال كان خشبيا ولم يكن يحفظ(@)(@@) قلت وذكره العقيلي في كتابه فروى باسناده عن ابن المديني قال كان أصحابنا يثبتون هشام بن حسان وكان يحيى يضعف حديثه عن عطاء وكان الناس يرون انه أرسل حديث الحسن عن حوشب(@)(@@) وقال عرعرة بن البرند ذكرت لجرير بن حازم هشام بن حسان فقال ما رأيته عند الحسن قط قلت وانكر عليه حديثه عن محمد عن عبيدة ينقض الوضوء أذى المسلم(@)(@@)(@@)(@@) | 6746 - (@)(@@) هشام بن خالد بن الوليد بن عن ابن عمر 
ms344	 مجهول(@)(@@)(@@)(@@) | 6747 - (@)(@@) ت ق / هشام بن زياد أبو المقدام عن محمد بن كعب قال النسائي وغيره متروك(@)(@@)(@@)(@@) | 6748 - (@)(@@) م عه / هشام بن سعد مولى بني مخزوم صدوق مشهور ضعفه س وغيره(@)(@@) وكان يحيى القطان لا يحدث عنه(@)(@@) وقال أحمد ليس هو محكم للحديث وقال ابن عدي مع ضعفه يكتب حديثه وقال ابن معين ليس بذاك القوي قال الحاكم روى له مسلم في الشواهد(@)(@@)(@@)(@@) | 6749 - (@)(@@) د س / هشام بن سعيد الطالقاني كان ابن معين لا يروي عنه ووثقه أحمد لقي ابن لهيعة(@)(@@)(@@)(@@) | 6750 - (@)(@@) هشام بن سلمان المجاشعي عن يزيد الرقاشي صدوق ضعفه موسى بن إسماعيل(@)(@@)(@@)(@@) | 6751 - (@)(@@) هشام بن سليمان المخزومي عن ابن جريج مشاه ابو حاتم وقال العقيلي في حديثه عن غير ابن جريج وهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6752 - (@)(@@) هشام بن أبي عبد الله الدستوائي حافظ حجة لكنه رمي بالقدر(@)(@@)(@@)(@@) | 6753 - (@)(@@) هشام بن عبد الله بن عكرمة المخزومي عن هشام بن عروة وهاه ابن حبان(@)(@@)(@@)(@@) | 6754 - (@)(@@) هشام بن عبيد الله الرازي عن مالك وخلق قال ابن حبان كثرت مخالفته للأثبات فبطل الاحتجاج به ثم روى له حديثين أراهما موضوعين أحدهما عن ابن أبي ذئب عن نافع عن ابن عمر الدجاج غنم فقراء أمتي والجمعة حجهم وأما أبو حاتم فقال صدوق ما رأيت أحدا أعظم ولا أجل قدرا عند أهل بلده منه ومن أبي مسهر بدمشق قلت كانا إمامين في السنة(@)(@@)(@@)(@@) | 6755 - (@)(@@) خ عه / هشام بن عمار خطيب دمشق ومقرئها ثقة مكثر له ما ينكر قال أبو حاتم صدوق قد تغير وكان كلما لقنه تلقن(@)(@@) وقال أبو داود حدث بأرجح من أربعمائة حديث لا اصل لها(@)(@@) وقال ابن معين ثقة وقال مرة كيس كيس(@)(@@) وقال النسائي لا بأس به وقال الدارقطني صدوق كبير المحل وقال صالح جزرة كان يأخذ على الراوية(@)(@@)(@@)(@@) | 6756 - (@)(@@) هشام بن محمد بن السائب بن الكلبي عن أبيه تركوه وهو اخباري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6757 - (@)(@@) هشام بن محمد الكوفي متأخر روى عنه أبي حفص الكتاني متهم(@)(@@)(@@)(@@) | 6758 - (@)(@@) هشام بن محمد التيملي الكوفي عن ابن حبابة 
ms345	 اتهمه الصوري وغيره(@)(@@)(@@)(@@) | 6759 - (@)(@@) هشام بن مودود عن زياد بن علاقة لا يعرف وضعفه الأزدي(@)(@@)(@@)(@@) | 6760 - (@)(@@) هشام بن نجيح بيض له ابن أبي حاتم(@)(@@)(@@)(@@) | 6761 - (@)(@@) وهشام بن أبي هشام عن زيد العمي(@)(@@)(@@)(@@) | 6762 - (@)(@@) وهشام المرهبي عن الحسن مجهولون(@)(@@)(@@)(@@) | 6763 - (@)(@@) هشام بن لاحق عن عاصم الأحول قال أحمد تركت حديثه قلت وربما روى عنه(@)(@@)(@@)(@@) | 6764 - (@)(@@) هشام بن أبي يعلى عن ابن الحنفية مجهول(@)(@@)(@@)(@@) | 6765 - (@)(@@) ع / هشيم حجة يدلس وهو لين في روايته عن الزهري(@)(@@)(@@)(@@) | 6766 - (@)(@@) همام بن مسلم الزاهد عن ابن سوقة قال ابن حبان يسرق الحديث(@)(@@)(@@)(@@) | 6767 - (@)(@@) همام بن نافع والد عبد الرزاق قال العقيلي حديثه غير محفوظ(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6768 - (@)(@@) ع / همام بن يحيى ثقة مشهور قال أبو حاتم ثقة في حفظه شيء وكان القطان لا يرضى حفظه وقال أحمد بن حنبل كان يحيى بن سعيد لا يستخف هماما وما رأيت يحيى أسوأ رأيا في أحد منه في حجاج بن أرطأة ومحمد بن إسحاق وهمام لا يستطيع أحد أن يرجعه فيهم(@)(@@)(@@)(@@) | 6769 - (@)(@@) هناد بن ابراهيم النسفي ابو المظفر متاخر راوية للموضوعات ضعف(@)(@@)(@@)(@@) | 6770 - (@)(@@) ت / هود بن عبد الله العصري صدوق قلت لا يكاد يعرف له حديث واحد دخل عليه السلام يوم الفتح وعلى سيفه ذهب وفضة(@)(@@)(@@)(@@) | 6771 - (@)(@@) هود بن عطاء اليمامي عن أنس قال ابن حبان لا يحتج به منكر الرواية على قلتها(@)(@@)(@@)(@@) | 6772 - (@)(@@) ق / هوذة بن خليفة عن عوف وغيره صدوق ضعفه يحيى بن معين فقال هوذة عن عوف ضعيف(@)(@@)(@@)(@@) | 6773 - (@)(@@) هلال بن جبير عن أنس مقل وفيه جهالة(@)(@@)(@@)(@@) | 6774 - (@)(@@) هلال بن الجهم عن اسحاق بن عبد الله بن أبي طلحة لا يعرف(@)(@@)(@@)(@@) | 6775 - (@)(@@) عه / هلال بن خباب عن أبي جحيفة وأبي عمر زاذان وعكرمة وثقه ابن معين وغيره وقال ابن حبان اختلط في(@)(@@) PageV00P000(@)(@@) آخر عمره فحدث بالتوهم لا يجوز الاحتجاج به إذا انفرد وقال القطان تغير(@)(@@)(@@)(@@) | 6776 - (@)(@@) هلال بن رداد عن الزهري لا يدرى من هو(@)(@@)(@@)(@@) | 6777 - (@)(@@) ق / هلال بن زيد أبو عقال عن أنس قال ابن حبان روى 
ms346	 اشياء موضوعة(@)(@@)(@@)(@@) | 6778 - (@)(@@) ق / هلال بن أبي زينب عن شهر بن حوشب قال أحمد ابن حنبل تركوه(@)(@@)(@@)(@@) | 6779 - (@)(@@) هلال بن سويد ويقال ابن أبي سويد عن أنس ضعفوه وهو أبو ظلال وقيل آخر واه(@)(@@)(@@)(@@) | 6780 - (@)(@@) ت / هلال بن عبد الله عن أبي اسحاق قال الترمذي مجهول يكنى أبا هاشم وقال خ منكر الحديث(@)(@@)(@@)(@@) | 6781 - (@)(@@) هلال بن عبد الرحمن الحنفي عن ابن المنكدر قال العقيلي منكر الحديث(@)(@@)(@@)(@@) | 6782 - (@)(@@) هلال بن عمر الرقي جد هلال بن العلاء ضعفه أبو حاتم الرازي(@)(@@)(@@)(@@) | 6783 - (@)(@@) د س / هلال بن فياض اليشكري ولقبه شاذ تكلم فيه البخاري ووثقه أبو حاتم(@)(@@)(@@)(@@) | 6784 - (@)(@@) هلال بن ميمون هو ابن أبي سويد أو ابن سويد أبو ظلال القسملي عن أنس قال ابن عدي عامة ما يرويه لا يتابع عليه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6785 - (@)(@@) هلال بن مرة تفرد عنه عمرو بن شعيب له في زكاة العسل(@)(@@)(@@)(@@) | 6786 - (@)(@@) هلال بن نعيم عن سالم بن عبد الله مجهول(@)(@@)(@@)(@@) | 6787 - (@)(@@) هلال الرازي هو ابن يحيى عن أبي عوانة وغيره تكلم فيه ابن حبان(@)(@@)(@@)(@@) | 6788 - (@)(@@) هلال بن محمد بن محمد البصري ابن أخي هلال الرأي قال ابن غلام الزهري جاءني بخبر عن رجل وقال كتبت عنه بالبصرة فقلت إياك أن تنطق بهذا فإن الرجل لم يدخل البصرة أصلا(@)(@@)(@@)(@@) | 6789 - (@)(@@) هلال أبو الورد العتكي مجهول(@)(@@)(@@)(@@) | 6790 - (@)(@@) ق / هياج بن بسطام الهروي عن حميد وعدة قال أبو حاتم يكتب حديثه وقال ابن معين ضعيف وقال د تركوا حديثه(@)(@@)(@@)(@@) | 6791 - (@)(@@) الهيثم بن الأشعث روى عنه عثمان بن الهيثم مجهول(@)(@@)(@@)(@@) | 6792 - (@)(@@) الهيثم بن بدر الضبي عن حرقوص كان على خراج الري فيه ضعف(@)(@@)(@@)(@@) | 6793 - (@)(@@) الهيثم بن جماز الحنفي عن يحيى بن أبي كثير قال أحمد والنسائي متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6794 - (@)(@@) ق / الهيثم بن جميل حافظ له مناكير وغرائب سمع حماد بن سلمة قال الدارقطني ثقة حافظ قال ابن عدي ليس بالحافظ يغلط على الثقات وأرجو أنه لا يتعمد الكذب قلت توفي سنة ثلاث عشرة ومائتين(@)(@@)(@@)(@@) | 6795 - (@)(@@) الهيثم بن حبيب عن ابن عيينة بخبر كذب 
ms347	 في المهدي هو آفته(@)(@@)(@@)(@@) | 6796 - (@)(@@) الهيثم بن الحسين العقيلي عن الثوري لم يصح حديثه(@)(@@)(@@)(@@) | 6797 - (@)(@@) الهيثم بن حماد عن أبي كثير نكرة كشيخه وعنه يعلى الغزال(@)(@@)(@@)(@@) | 6798 - (@)(@@) عه / الهيثم بن حميد الدمشقي الحافظ قال أبو داود ثقة قدري(@)(@@)(@@)(@@) | 6799 - (@)(@@) الهيثم بن خالد بن عبد الله المصيصي عن عبد الكريم بن المعافى قال الدارقطني ضعيف(@)(@@)(@@)(@@) | 6800 - (@)(@@) ت / الهيثم بن خالد عن وكيع ما روى عنه فيما علمت سوى الترمذي(@)(@@)(@@)(@@) | 6801 - (@)(@@) ت / الهيثم بن الربيع العقيلي عن سماك بن عطية له خبر وقد وهم فيه(@)(@@)(@@)(@@) | 6802 - (@)(@@) الهيثم بن زريق عن الحسن البصري لم يصح حديثه(@)(@@)(@@)(@@) | 6803 - (@)(@@) الهيثم بن سهل التستري عن حماد بن زيد قال الدارقطني وغيره ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6804 - (@)(@@) الهيثم بن صالح عن سلام أبي المنذر لا يعرف(@)(@@)(@@)(@@) | 6805 - (@)(@@) الهيثم بن عباد عن أنس مجهول(@)(@@)(@@)(@@) | 6806 - (@)(@@) الهيثم بن عبد الغفار عن همام بن يحيى تركوه وقيل كان كذابا(@)(@@)(@@)(@@) | 6807 - (@)(@@) الهيثم بن عدي الطائي أبو عبد الرحمن الأخباري عن هشام ابن عروة ونحوه تركوه وقال أبو داود السجستاني كذاب(@)(@@)(@@)(@@) | 6808 - (@)(@@) الهيثم بن عقاب عن محارب بن دثار مجهول وخبره منكر(@)(@@)(@@)(@@) | 6809 - (@)(@@) الهيثم بن قيس روى عنه قرة بن حبيب في المسح لا يصح خبره(@)(@@)(@@)(@@) | 6810 - (@)(@@) الهيثم بن محمد بن حفص عن أبيه وقيل ابن عمر قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) | 6811 - (@)(@@) الهيثم بن محفوظ أبو سعد روى عنه علي بن حرب لا يدرى من هو(@)(@@)(@@)(@@) | 6812 - (@)(@@) الهيثم بن المغيرة السرخسي مجهول(@)(@@)(@@)(@@) | 6813 - (@)(@@) الهيثم بن اليمان روى عنه محمد بن حسن الزعفراني ضعفه الأزدي(@)(@@)(@@)(@@) | 6814 - (@)(@@) الهيثم السلمي تابعي مجهول(@)(@@)(@@)(@@) | 6815 - (@)(@@) هيصم بن الشداخ عن الاعمش قال ابن حبان يروي الطامات(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - حرف الواو(@)(@@)(@@)(@@) | 6816 - (@)(@@) الوازع بن نافع العقيلي الجزري عن أبي سلمة قال أحمد ويحيى ليس بثقة(@)(@@)(@@)(@@) | 6817 - (@)(@@) واسط بن الحارث عن نافع وغيره له مناكير مع قلة ما روى(@)(@@)(@@)(@@) | 6818 - (@)(@@) م س / واصل بن عبد الرحمن أبو حرة الرقاشي صدوق قال البخاري يتكلمون في روايته عن الحسن البصري(@)(@@)(@@)(@@) | 6819 - (@)(@@) ت ق / واصل بن 
ms348	 السائب عن عطاء قال النسائي وغيره متروك(@)(@@)(@@)(@@) | 6820 - (@)(@@) واصل بن أبي جميل عن مجاهد قال يحيى بن معين لا شيء(@)(@@)(@@)(@@) | 6821 - (@)(@@) واصل بن عطاء المتكلم المتشدق سمع الحسن قال الأزدي رجل سوء كافر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6822 - (@)(@@) واضح البصري عن الحسن مجهول(@)(@@)(@@)(@@) | 6823 - (@)(@@) د / واقد بن عبد الرحمن بن سعد بن معاذ لا يعرف(@)(@@)(@@)(@@) | 6824 - (@)(@@) واقد ويقال بالفاء هو ابن سلامة عن يزيد الرقاشي ضعفوه(@)(@@)(@@)(@@) | 6825 - (@)(@@) واقد بن الحافظ أبي يعلى الخليلي أبو زيد تكلم ابن طاهر في سماعه لسنن ابن ماجه(@)(@@)(@@)(@@) | 6826 - (@)(@@) والان أبو عروة المرادي مجهول(@)(@@)(@@)(@@) | 6827 - (@)(@@) د وائل بن علقمة عن وائل بن حجر لا يعرف(@)(@@)(@@)(@@) | 6828 - (@)(@@) وثيمة بن موسى قال ابن أبي حاتم يحدث عن سلمة بن الفضل بأحاديث موضوعة(@)(@@)(@@)(@@) | 6829 - (@)(@@) وجيه بن هبة الله بن المبارك السقطي عن أبي القاسم الربعي قال ابن عساكر هو أدبر من أبيه(@)(@@)(@@)(@@) | 6830 - (@)(@@) وحشي بن حرب بن وحشي الحمصي عن أبيه قال جزرة لا يشتغل به ولا بأبيه(@)(@@)(@@)(@@) | 6831 - (@)(@@) ع / ورقاء بن عمر اليشكري ثقة ثبت قال القطان لا يساوي شيئا(@)(@@)(@@)(@@) | 6832 - (@)(@@) الوركاني قال أسلم يوم موت أحمد بن حنبل عشرون(@)(@@) PageV00P000(@)(@@) ألفا لا يدرى من هو وما هو بمحمد بن جعفر الوركاني الذي مات قبل أحمد بزمان(@)(@@)(@@)(@@) | 6833 - (@)(@@) وزير بن صبيح الوزان عن بعض التابعين لا يعرف وخبره منكر(@)(@@)(@@)(@@) | 6834 - (@)(@@) وزير بن عبد الله الخولاني عن الزبيدي قال ابن حزم منكر الحديث 6835 - وزير الجزري عن غالب وعنه بقية ضعفه ابو زرعة(@)(@@)(@@)(@@) | 6836 - (@)(@@) وضاح بن حسان عن شعبة قال الفسوي مغفل(@)(@@)(@@)(@@) | 6837 - (@)(@@) وضاح بن خيثمة عن هشام بن عروة يقال لم يتابع على حديثه(@)(@@)(@@)(@@) | 6838 - (@)(@@) وضاح بن عبد الله أبو عوانة ثقة حجة ولا سيما إذا حدث من كتابه وروى حنبل عن علي قال هو في قتادة ضعيف لأنه ذهب كتابه(@)(@@)(@@)(@@) | 6839 - (@)(@@) وضاح بن عباد عن عاصم الأحول تكلم فيه أحمد ابن المنادي(@)(@@)(@@)(@@) | 6840 - (@)(@@) وضاح بن يحيى النهشلي الأنباري قال أبو حاتم كتبت عنه وليس بالمرضي قال ابن حبان لا يحتج به 
ms349	(@)(@@)(@@)(@@) | 6841 - (@)(@@) د ق / الوضين بن عطاء الشامي قال أحمد ما به بأس وقال أبو حاتم تعرف وتنكر وقال ابن سعد ضعيف الحديث(@)(@@)(@@)(@@) | 6842 - (@)(@@) د / وعلة بن عبد الرحمن اليمامي عن تابعي لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6843 - (@)(@@) س / وقاء بن إياس الأسدي عن سعيد بن جبير قال ابن معين ما هو بالذي يعتمد عليه(@)(@@)(@@)(@@) | 6844 - (@)(@@) ق / وكيع بن محرز روى عنه روح بن عبد المؤمن قال البخاري عنده عجائب(@)(@@)(@@)(@@) | 6845 - (@)(@@) الوليد بن أبي ثور هو ابن عبد الله(@)(@@)(@@)(@@) | 6846 - (@)(@@) الوليد بن جبلة شيخ مروان بن معاوية مجهول(@)(@@)(@@)(@@) | 6847 - (@)(@@) ت ق / الوليد بن جميل قال أبو حاتم روى عن القاسم أحاديث منكرة(@)(@@)(@@)(@@) | 6848 - (@)(@@) م متابعة د ت س ق / الوليد بن جميع هو ابن عبد الله قال ابن حبان فحش تفرده فبطل الإحتجاج به وقال الحاكم لو لم يذكره مسلم لكان أولى قال أبو حاتم صالح الحديث ووثقه ابن معين وغيره(@)(@@)(@@)(@@) | 6849 - (@)(@@) الوليد بن حيان عن ابن عمر لم يصح حديثه(@)(@@)(@@)(@@) | 6850 - (@)(@@) الوليد بن خالد عن يوسف بن عطية ضعفه الأزدي(@)(@@)(@@)(@@) | 6851 - (@)(@@) الوليد بن دينار التياس عن الحسن ضعفه ابن معين(@)(@@)(@@)(@@) | 5852 - (@)(@@) الوليد بن زياد عن غصين(@)(@@)(@@)(@@) | 6853 - (@)(@@) والوليد بن أبي زينب عن أبي لؤلؤة(@)(@@)(@@)(@@) | 6854 - (@)(@@) والوليد بن سعيد عن عبيد الله بن أقرم مجهولون(@)(@@)(@@)(@@) | 6855 - (@)(@@) الوليد بن سفيان عن علي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6856 - (@)(@@) د ت ق / والوليد بن سفيان الغساني عن تابعي لا يعرفان(@)(@@)(@@)(@@) | 6857 - (@)(@@) الوليد بن سلمة الطبراني الأردني عن عبيد الله بن عمر كذبه دحيم والحاكم(@)(@@)(@@)(@@) | 6858 - (@)(@@) م د ت ق / الوليد بن شجاع أبو همام السكوني ثقة مشهور قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) | 6859 - (@)(@@) الوليد بن عباد روى عنه اسماعيل بن عياش الحمصي مجهول(@)(@@)(@@)(@@) | 6860 - (@)(@@) الوليد بن صالح النخاس عن جرير بن حازم وثقه الدورقي وقال أحمد تركته لسوء صلاته(@)(@@)(@@)(@@) | 6861 - (@)(@@) الوليد بن العباس بن مسافر المصري كان قبل الثلاثمائة ضعفه الدارقطني وأبو عمر الكندي يروي عن عبد الغفار بن صالح وغيره وله حديث باطل قال ابن الجوزي روى الدارقطني في 
ms350	 الأفراد ثنا أحمد ابن اسحاق الملحمي وما كتبته إلا عنه ثنا الوليد ثنا عبد الله بن صالح ثنا خالد بن حميد عن ابن أبي عروبة عن جابر بن سعيد عن جبير عن أبي هريرة مرفوعا المقيم بالإسكندرية ثلاثة أيام كمن عبد الله سبعين ألف سنة(@)(@@)(@@)(@@) | 6862 - (@)(@@) د ت ق / الوليد بن عبد الله بن أبي ثور الهمداني عن سماك ضعفه أحمد وجزرة وجماعة(@)(@@)(@@)(@@) | 6863 - (@)(@@) الوليد بن عبد الرحمن يروي عنه معتمر بن سليمان قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 6864 - (@)(@@) الوليد بن عبدة مولى عمرو بن العاص(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6865 - (@)(@@) والوليد بن عنبسة مجهولان(@)(@@)(@@)(@@) | 6866 - (@)(@@) الوليد بن عبيد الله بن أبي رباح عن عمه عطاء ضعفه الدارقطني(@)(@@)(@@)(@@) | 6867 - (@)(@@) الوليد بن عتبة الدمشقي عن معاوية بن صالح الحضرمي مجهول وما هو ب(@)(@@)(@@)(@@) | 6868 - (@)(@@) الوليد بن عتبة الدمشقي المقرئ ذاك أصغر وهو صدوق(@)(@@)(@@)(@@) | 6869 - (@)(@@) الولدي بن عجلان شيخ لجون بن بشير لا يدرى من هو(@)(@@)(@@)(@@) | 6870 - (@)(@@) الوليد بن عصام الزبيدي روى عن أبيه متهم في نقله(@)(@@)(@@)(@@) | 6871 - (@)(@@) الوليد بن عطاء بن الأغر مكي ذكره ابن عدي عن مسلم الزنجي ولكن البلية من شاذان والوليد فقد وثق(@)(@@)(@@)(@@) | 6872 - (@)(@@) م / الوليد بن عطاء ما روى عنه سوى ابن جريج(@)(@@)(@@)(@@) | 6873 - (@)(@@) ق / الوليد بن عقبة عراقي عن بعض التابعين لا يعرف(@)(@@)(@@)(@@) | 6874 - (@)(@@) الوليد بن عمرو بن ساج بيض له ابن أبي حاتم وقال أبوه لا يحتج به قلت يروي عن عون ب نأبي جحيفة وجماعة وضعفه ابن معين(@)(@@)(@@)(@@) | 6875 - (@)(@@) الوليد بن عمرو الحراني عن عون بن أبي جحيفة ضعفوه هو الذي قبله سواء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6876 - (@)(@@) الوليد بن عمرو الدمشقي عن مالك بن أنس مجهول(@)(@@)(@@)(@@) | 6877 - (@)(@@) الوليد بن عيسى أبو وهب عن الشعبي قال البخاري فيه نظر(@)(@@)(@@)(@@) | 6878 - (@)(@@) الوليد بن الفضل عن عبد الله بن إدريس مجهول واتهمه ابن حبان(@)(@@)(@@)(@@) | 6879 - (@)(@@) الوليد بن الفضل شيخ ابن عرفة ثنا إسماعيل بن عبيد بحديث ان عمر من حسنات أبي بكر وهذا باطل وإسماعيل هالك(@)(@@)(@@)(@@) | 6880 - (@)(@@) ت ق / الوليد بن القاسم بن الوليد 
ms351	 الهمداني عن ابن أبي ليلى ضعفه بعضهم وقال ابن حبان انفرد عن الثقات بما لا يشبه حديثهم فخرج عن حد الاحتجاج به(@)(@@)(@@)(@@) | 6881 - (@)(@@) د / الوليد بن كامل شيخ لبقية واه ضعفه أبو الفتح الأزدي(@)(@@)(@@)(@@) | 6882 - (@)(@@) ع / الوليد بن كثير المخزومي ثقة وحديثه في الكتب الستة سمع سعيد بن أبي سعيد بن أبي هند والكبار قال أبو داود ثقة إلا أنه إباضي وقال ابن سعد ليس بذاك(@)(@@)(@@)(@@) | 6883 - (@)(@@) الوليد بن كريز عن محمد بن سيرين مجهول قلت وحديثه منكر(@)(@@)(@@)(@@) | 6884 - (@)(@@) ت ق / الوليد بن محمد الموقري عن الزهري ضعفوه وقال ابن معين يكذب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6885 - (@)(@@) الوليد بن محمد الأيلي عن مبارك بن فضالة مجهول قلت بل روى عنه أبو أمية والأعين وقد ذكره ابن عدي وأورد له حديثين منكرين(@)(@@)(@@)(@@) | 6886 - (@)(@@) الوليد بن محمد السلمي الحجام عن شعبة وثق وقال الدارقطني ضعيف(@)(@@)(@@)(@@) | 6887 - (@)(@@) ع / الوليد بن مسلم الدمشقي إمام مشهور صدوق ولكنه يدلس عن ضعفاء لا سيما في الأوزاعي فاذا قال ثنا الاوزاعي فهو حجة(@)(@@)(@@)(@@) | 6888 - (@)(@@) الوليد بن مروان عن غيلان بن جرير(@)(@@)(@@)(@@) | 6889 - (@)(@@) والوليد بن المغيرة عن ابن المسيب مجهولان(@)(@@)(@@)(@@) | 6890 - (@)(@@) الوليد بن مسلمة الاردني عن عمرو بن قيس قال الدارقطني متروك(@)(@@)(@@)(@@) | 6891 - (@)(@@) الوليد بن معدان روى عنه ابنه عبد الملك قال ابن حزم كلاهما ساقط(@)(@@)(@@)(@@) | 6892 - (@)(@@) الوليد بن المهلب عن النضر بن محرز لا يعرف(@)(@@)(@@)(@@) | 6893 - (@)(@@) الوليد بن موسى الدمشقي عن سعيد بن بشير قال الدارقطني منكر الحديث وقواه أبو حاتم وقال غيره متروك(@)(@@)(@@)(@@) | 6894 - (@)(@@) الوليد بن هشام بن الوليد بيض له ابن أبي حاتم مجهول ما هو بالقحذمي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6895 - (@)(@@) الوليد بن الوليد دمشقي عن سعيد بن بشر قال الدارقطني منكر الحديث وقال ابن حبان لا يحتج به وهو العنسي(@)(@@)(@@)(@@) | 6896 - (@)(@@) الوليد بن يزيد الهدادي مكثر عن المجاهيل تكلم فيه ابن حبان(@)(@@)(@@)(@@) | 6897 - (@)(@@) الوليد الرماح عن ابن عباس مجهول(@)(@@)(@@)(@@) | 6898 - (@)(@@) الوليد عن جابر لا يعرف وعنه ابن شداد(@)(@@)(@@)(@@) | 6899 - (@)(@@) وهب بن أبان عن نافع لا يدرى من هو وحديثه منكر بل 
ms352	 باطل(@)(@@)(@@)(@@) | 6900 - (@)(@@) ت وهب بن إسماعيل سمع منه أحمد بن حنبل وتوقف في الإحتجاج به(@)(@@)(@@)(@@) | 6901 - (@)(@@) د س / وهب بن جابر الخيواني تابعي فيه جهالة له عن عبد الله بن عمرو قال ابن المديني مجهول(@)(@@)(@@)(@@) | 6902 - (@)(@@) وهب بن حفص البجلي الحراني عن أبي قتادة الحراني كذبه أبو عروبة والدارقطني(@)(@@)(@@)(@@) | 6903 - (@)(@@) وهب بن حكيم عن محمد بن سيرين لا يكاد يعرف وقال العقيلي لا يتابع على حديثه(@)(@@)(@@)(@@) | 6904 - (@)(@@) وهب بن داود المخرمي عن ابن علية عن ابن(@)(@@) PageV00P000(@)(@@) صهيب عن أنس من صلى علي يوم الجمعة ثمانين مرة غفر له ذنوب ثمانين عاما قال الخطيب لم يكن بثقة ثم أورد له حديثا من وضعه(@)(@@)(@@)(@@) | 6905 - (@)(@@) وهب بن راشد عن مالك بن دينار قال الدارقطني متروك(@)(@@)(@@)(@@) | 6906 - (@)(@@) وهب الله بن راشد أبو زرعة المصري غمزه سعيد ابن أبي مريم(@)(@@)(@@)(@@) | 6907 - (@)(@@) وهب بن عمرو عن أبي عبد الرحمن مجهول والخبر موضوع(@)(@@)(@@)(@@) | 6908 - (@)(@@) خ م / وهب بن منبه ثقة مشهور قصاص حبر ضعفه أبو حفص الفلاس وحده(@)(@@)(@@)(@@) | 6909 - (@)(@@) وهب بن وهب أبو البختري القاضي عن هشام بن عروة كذبه أحمد وغيره(@)(@@)(@@)(@@) | 6910 - (@)(@@) وهب بن وهب عن سعد بن أبي وقاص مجهول(@)(@@)(@@)(@@) | 6911 - (@)(@@) وهب بن يحيى بن حفص الحراني هووهب بن حفص مر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - حرف اللام ألف(@)(@@)(@@)(@@) | 8912 - (@)(@@) لاحق بن الحسين بن المقدسي روى عنه أبو نعيم قال الإدريسي كذاب(@)(@@)(@@)(@@) | 6913 - (@)(@@) لاهز أبو عمرو التيمي عن معتمر بن سليمان اتهمه ابن عدي بالوضع(@)(@@) PageV02P728(@)(@@)(@@)(@@) | - حرف الياء(@)(@@)(@@)(@@) | 6914 - (@)(@@) ياسر عن أنس لا شيء(@)(@@)(@@)(@@) | 6915 - (@)(@@) ياسين بن محمد عن أبي حازم المديني لا يعرف(@)(@@)(@@)(@@) | 6916 - (@)(@@) ياسين بن معاذ الزيات عن الزهري تركه النسائي وغيره(@)(@@)(@@)(@@) | 6917 - (@)(@@) ياسين العجلي الكوفي عن إبراهيم بن محمد بن الحنفية وعنه أبو نعيم قال البخاري في حديثه نظر وقال ابن معين ليس به بأس يقال هو ياسين بن شيبان(@)(@@)(@@)(@@) | 6918 - (@)(@@) يافع بن عامر عن قتادة مجهول(@)(@@)(@@)(@@) | 6919 - (@)(@@) يحيى بن ابراهيم بن أبي زيد أبو الحسين بن البيان الأندلسي المقرئ اتهم في اللقاء(@)(@@)(@@)(@@) | 6920 - (@)(@@) يحيى بن ابراهيم 
ms353	 السلمي عن سفيان الثوري منكر الحديث(@)(@@)(@@)(@@) | 6921 - (@)(@@) يحيى بن ابراهيم أبو تراب الكرخي الفقيه نزيل دمشق روى الصحيح عن أبي الوقت قال ابن نقطة دخلت فرأيته مختلا(@)(@@)(@@)(@@) | 6922 - (@)(@@) يحيى بن ابراهيم السلماسي معروف صنف في مناقب علي كتاب باب المدينة أبان فيه عن جهل وهوى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6923 - (@)(@@) يحيى بن أزهر شيخ روى عنه ابن وهب لا يعرف وهو مقل(@)(@@)(@@)(@@) | 6924 - (@)(@@) ق / يحيى بن اسحاق الهنائي احد التابعين لا يعرف(@)(@@)(@@)(@@) | 6925 - (@)(@@) يحيى بن إسماعيل عن إبراهيم بن سعد لا يعرف وخبره منكر واسطي(@)(@@)(@@)(@@) | 6926 - (@)(@@) يحيى بن إسماعيل الجريري الكوفي قال الدارقطني لا يحتج به(@)(@@)(@@)(@@) | 6927 - (@)(@@) يحيى بن أبي الأشعث عن ابن عون مجهول(@)(@@)(@@)(@@) | 6928 - (@)(@@) يحيى بن الأسود مجهول(@)(@@)(@@)(@@) | 6929 - (@)(@@) ت / يحيى بن أكثم القاضي صدوق إن شاء الله تعالى من الفقهاء قال علي بن الحسين بن الجنيد كانوا لا يشكون أنه يسرق الحديث وقال الأزدي يتكلمون فيه(@)(@@)(@@)(@@) | 6930 - (@)(@@) د ت / يحيى بن أيوب البجلي عن أبي زرعة ضعفه ابن معين وقال مرة ليس به بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6931 - (@)(@@) ع / يحيى بن أيوب الغافقي المصري عن يزيد بن أبي حبيب والطبقة قال ابن معين صالح وقال أحمد سيء الحفظ وقال أبو حاتم لا يحتج به وقال النسائي ليس بالقوي وقال الدارقطني في بعض حديثه اضطراب وقد ذكره ابن عدي في كامله وقال هو عندي صدوق ومن غرائبه ثنا ابن جريج عن ابي الزبير عن جابر قال قال رسول الله صلى الله عليه وسلم لا تعلموا العلم لتباهوا به العلماء ولا لتماروا به السفهاء ولا لتخيروا به المجالس فمن فعل ذلك فالنار النار هذا معروف بيحيى بن أيوب(@)(@@)(@@)(@@) | 6932 - (@)(@@) ت / يحيى بن أبي أنيسة الجزري أخو زيد مشهور قال أحمد وغيره متروك(@)(@@)(@@)(@@) | 6933 - (@)(@@) يحيى بن بشير عن أبي بكر بن عياش كذبه مطين هو يحيى بن محمد بن بشير(@)(@@)(@@)(@@) | 6934 - (@)(@@) يحيى بن بشار الكندي شيخ لعباد الرواجني لا يعرف عن مجهول(@)(@@)(@@)(@@) | 6935 - (@)(@@) يحيى بن بريد بن أبي بردة أبو بردة عن ابن جريج ضعفه أحمد وغيره 
ms354	(@)(@@)(@@)(@@) | 6936 - (@)(@@) يحيى بن بسطام عن ابن لهيعة بصري قال ابو حاتم صدوق وقال ابن حبان لا تحل الرواية عنه وقيل كان قدريا(@)(@@)(@@)(@@) | 6937 - (@)(@@) يحيى بن بشر الخراساني عن عكرمة ضعفه أبو الفتح الأزدي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6938 - (@)(@@) يحيى بن بهمل مولى عثمان روى عنه إبراهيم الخوزي مجهول(@)(@@)(@@)(@@) | 7939 - (@)(@@) يحيى بن ثعلبة أبو المقوم عن الحكم بن عتيبة ضعفه الدارقطني(@)(@@)(@@)(@@) | 6940 - (@)(@@) يحيى بن الحارث عن أخيه زهدم في قطع السدر لا يصح ذلك(@)(@@)(@@)(@@) | 6941 - (@)(@@) يحيى بن حرب عن سعيد المقبري فيه جهالة(@)(@@)(@@)(@@) | 6942 - (@)(@@) م عه / يحيى بن الجزار عن علي قال الحكم بن عتيبة كان يغلو في التشيع ووثقه غيره(@)(@@)(@@)(@@) | 6943 - (@)(@@) يحيى بن جرجة ما روى عنه سوى ابن جريج(@)(@@)(@@)(@@) | 6944 - (@)(@@) يحيى بن جعفر السراج(@)(@@)(@@)(@@) | 6945 - (@)(@@) ويحيى بن الجهم مجهولان(@)(@@)(@@)(@@) | 6946 - (@)(@@) يحيى بن جعفر بن الزبرقان قال الدارقطني لم يطعن فيه أحد بحجة لا بأس به عندي ويأتي بعد ورقة هو جعفر بن أبي طالب(@)(@@)(@@)(@@) | 6947 - (@)(@@) يحيى بن حسين العلوي رافضي متأخر كتب عنه ابن أبي النرسي أتى بخبر أن أبوي الرسول وجده في الجنة فاتهم به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6948 - (@)(@@) يحيى بن حفص الكرخي عن يعلى بن عبيد بخبر باطل لا يعرف هذا(@)(@@)(@@)(@@) | 6949 - (@)(@@) يحيى بن حميد الطويل عن أبيه قال ابن عدي أحاديثه غير مستقيمة(@)(@@)(@@)(@@) | 6950 - (@)(@@) يحيى بن حميد عن قرة بن حيويل وعنه ابن وهب قال البخاري لا يتابع في حديثه(@)(@@)(@@)(@@) | 6951 - (@)(@@) ت س / يحيى بن أبي الحجاج عن عوف قال ابن عدي في الكامل لا أرى بحديثه بأسا(@)(@@)(@@)(@@) | 6952 - (@)(@@) خ م / يحيى بن حمزة قاضي دمشق صدوق قال ابن معين صدقة أحب إلى منه وقال أبو حاتم صدوق وقال عباس عن ابن معين كان يرمى بالقدر وقال ابن سعد صالح الحديث(@)(@@)(@@)(@@) | 6953 - (@)(@@) يحيى بن حوشب روى عنه مخلد بن مالك الحراني منكر الحديث(@)(@@)(@@)(@@) | 6954 - (@)(@@) د ت ق / يحيى بن أبي حية أو جناب الكلبي مشهور سمع الشعبي ونحوه قال أبو زرعة صدوق مدلس وقال النسائي(@)(@@) PageV00P000(@)(@@) والدارقطني ضعيف وقال يحيى بن سعيد القطان لا 
ms355	 أستحل أن أروي عنه(@)(@@)(@@)(@@) | 6955 - (@)(@@) يحيى بن خالد شيخ لبقية مجهول(@)(@@)(@@)(@@) | 6956 - (@)(@@) يحيى بن أبي خالد شيخ لابن أبي فديك كذلك(@)(@@)(@@)(@@) | 6957 - (@)(@@) يحيى بن خلف الطرسوسي عن مالك ليس بثقة(@)(@@)(@@)(@@) | 6958 - (@)(@@) يحيى بن خليف عن سفيان الثوري منكر الحديث(@)(@@)(@@)(@@) | 6959 - (@)(@@) يحيى بن أبي الدنيا عن ابن جريج ضعفه أبو حاتم(@)(@@)(@@)(@@) | 6960 - (@)(@@) ق / يحيى بن راشد بصري عن خالد الحذاء ونحوه ضعفه النسائي(@)(@@)(@@)(@@) | 6961 - (@)(@@) يحيى بن أبي روق شيخ للنفيلي قال ابن معين ليس بثقة وقال أبو داود ليس بشيء(@)(@@)(@@)(@@) | 6962 - (@)(@@) يحيى بن زبان عن عبد الله بن راشد مجهول(@)(@@)(@@)(@@) | 6963 - (@)(@@) خ م / يحيى بن زكريا بن أبي زائدة وثق وقال ابو نعيم ما هو بأهل أن أحدث عنه(@)(@@)(@@)(@@) | 6964 - (@)(@@) يحيى بن زكريا عن جعفر بن محمد راوي خبر محاورة ابي بكر وعمر في القدر في خبر بيبي قال ابن الجوزي يحيى المتهم به وقال ابن عدي كان يضع الحديث(@)(@@)(@@)(@@) | 6965 - (@)(@@) يحيى بن زكريا ويعرف بابن أبي الحواجب عن الاعمش ضعفه الدارقطني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 6966 - (@)(@@) خ / يحيى بن أبي زكريا الغساني عن هشام بن عروة ضعفه أبو داود(@)(@@)(@@)(@@) | 6967 - (@)(@@) يحيى بن زهدم بن الحارث قال ابن حبان يروى عن أبيه نسخة موضوعة(@)(@@)(@@)(@@) | 6968 - (@)(@@) يحيى بن سابق المدائني عن أبي حازم قال أبو حاتم ليس بقوي وضعفه غيره(@)(@@)(@@)(@@) | 6969 - (@)(@@) يحيى بن سالم الكوفي عن اسرائيل ضعفه الدارقطني والعقيلي(@)(@@)(@@)(@@) | 6970 - (@)(@@) يحيى بن سعيد السعيدي العبشمي الشهيد عن ابن جريج قال ابن حبان يروي المقلوبات والملزوقات لا يجوز الإحتجاج به إذا انفرد(@)(@@)(@@)(@@) | 6971 - (@)(@@) يحيى بن سعيد التميمي المديني قاضي شيراز عن الزهري وعمرو تركوه(@)(@@)(@@)(@@) | 6972 - (@)(@@) يحيى بن سعيد بن سالم القداح عن بيض له مناكير(@)(@@)(@@)(@@) | 6973 - (@)(@@) يحيى بن سعيد المطوعي عن هشام بن عبيد الله الرازي كذبه أبو حاتم(@)(@@)(@@)(@@) | 6974 - (@)(@@) يحيى بن سعيد الحمصي العطار عن مبارك بن فضالة وعدة قال ابن عدي هو بين الضعف وقال غيره صالح الحديث وقال ابن حبان يروي الموضوعات(@)(@@)(@@)(@@) | 6975 - (