ms1754	 النبي :(@)(@@) | 30 ( كلوا ما حسر عنه البحر وما ألقاه ، وما وجدتموه ميتا PageV05P457 أو طافيا فوق الماء فلا تأكلوه ) )(@)(@@) ( قط ) وضعفه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15957 ) قال النبي :(@)(@@) | 30 ( كلوا لا بأس به ، ولاكنه ليس من طعام قومي يعني الضب ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما عن امرأة من أزواج النبي .(@)(@@)(@@)(@@) $ ( 15958 ) قال النبي :(@)(@@) | 30 ( كل فإن صيام يوم السبت لا لك ولا عليك ) )(@)(@@) ( حم ) عن الصماء بنت بسر رضي الله عنها .(@)(@@)(@@)(@@) ||| ( الكاف مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15959 ) قال النبي :(@)(@@) | 30 ( كم من أشعث أغبر ذي طمرين لا يؤبه له لو أقسم على الله لأبره ، منهم البراء بن مالك ) )(@)(@@) ( ت ) و الضياء عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15960 ) قال النبي :(@)(@@) | 30 ( كم من جار متعلق بجاره يوم القيامة يقول : يا رب هاذا أغلق بابه دوني فمنع معروفه ) )(@)(@@) ( خد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15961 ) قال النبي :(@)(@@) | 30 ( كم من حوراء عيناء ما كان مهرها إلا قبضة من حنطة أو مثلها من تمر ) )(@)(@@) ( عق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15962 ) قال النبي :(@)(@@) | 30 ( كم من ذي طمرين لا يؤبه له لو أقسم على الله لأبره ، منهم عمار بن ياسر ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15963 ) قال النبي :(@)(@@) | 30 ( كم من عاقل عقل عن الله أمره ، وهو حقير عند الناس ، دميم المنظر ينجو غدا ، وكم من ظريف اللسان ، جميل المنظر ، عظيم الشان ، هالك غدا في القيامة ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV05P458(@)(@@)(@@)(@@) $ ( 15964 ) قال النبي :(@)(@@) | 30 ( كم من عذق معلق لأبي الدحداح في الجنة ) )(@)(@@) ( حم م د ت ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15965 ) قال النبي :(@)(@@) | 30 ( كم من مستقبل يوما لا يستكمله ، ومنتظر غدا لا يبلغه ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15966 ) قال النبي :(@)(@@) | 30 ( كم ممن أصابه السلاح ليس بشهيد ولا حميد ، وكم ممن قد مات على فراشه حتف أنفه عند الله صديق شهيد ) )(@)(@@) ( حل ) عن أبي ذر 
ms1755	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15967 ) قال النبي :(@)(@@) | 30 ( كما تدين تدان ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15968 ) قال النبي :(@)(@@) | 30 ( كما تكونوا يولى عليكم ) )(@)(@@) ( فر ) عن أبي بكرة ( هب ) عن أبي إسحاق السبيعي مرسلا .(@)(@@)(@@)(@@) $ ( 15969 ) قال النبي :(@)(@@) | 30 ( كما لا يجتنى من الشوك العنب ، كذالك لا ينزل الفجار منازل الأبرار ، فاسلكوا أي طريق شئتم ، فأي طريق سلكتم وردتم على أهله ) )(@)(@@) ( حل ) عن يزيد بن مرثد مرسلا .(@)(@@)(@@)(@@) $ ( 15970 ) قال النبي :(@)(@@) | 30 ( كما لا يجتنى من الشوك العنب كذالك لا ينزل الفجار منازل الأبرار ، وهما طريقان فأيهما أخذتم أدركتم إليه ) )(@)(@@) ابن عساكر عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15971 ) قال النبي :(@)(@@) | 30 ( كما لا ينفع مع الشرك شيء كذالك لا يضر مع الإيمان شيء ) )(@)(@@) ( خط ) عن عمر ( حل ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV05P459(@)(@@)(@@)(@@) $ ( 15972 ) قال النبي :(@)(@@) | 30 ( كما يضاعف لنا الأجر كذالك يضاعف علينا البلاء ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15973 ) قال النبي :(@)(@@) | 30 ( كمل من الرجال كثير ولم يكمل من النساء إلا آسية امرأة فرعون ، ومريم بنت عمران ، وإن فضل عائشة على النساء كفضل الثريد على سائر الطعام ) )(@)(@@) ( حم ق ت ه ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15974 ) قال النبي :(@)(@@) | 30 ( كما يضاعف لنا الأجر كذالك يضاعف علينا البلاء ، ما يقول الناس ؟ قالت : زعموا أن برسول الله ذات الجنب ، قال : ما كان الله ليسلطها علي ، إنما هي همزة من الشيطان ، ولاكنه من الأكلة التي أكلت وابنك يوم خيبر ، ما زال يصيبني منها عداد وحتى كان هاذا أوان انقطاع أبهري ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها قالت : دخلت أم بشر بن البراء بن معرور على رسول الله في مرضه الذي مات فيه فمسته فقالت : ما وجدت مثل وعك عليك على أحد قال فذكره .(@)(@@)(@@)(@@) $ ( 15975 ) قال النبي :(@)(@@) | 30 ( كما لا تلتقي الشفتان على قول لا إلاه إلا الله ، كذالك لا تحجب عن سماء حتى تنتهي إلى العرش ، لها دوي كدوي النحل تشفع 
ms1756	 لصاحبها ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15976 ) قال النبي :(@)(@@) | 30 ( كما تكونوا يولى عليكم ) )(@)(@@) ( ك ) في تاريخه عن أبي بكرة رضي الله عنه .(@)(@@) PageV05P460(@)(@@)(@@)(@@) $ ( 15977 ) قال النبي :(@)(@@) | 30 ( كم من عذق رداح لأبي الدحداح في الجنة ) )(@)(@@) ( حم ) و البغوي ( حب ك طب ) عن أنس ( طب ) عن عبد الرحمان بن أبزى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15978 ) قال النبي :(@)(@@) | 30 ( كم من جار متشبث بجاره يوم القيامة يقول : يا رب هاذا أغلق بابه دوني ومنعني معروفه ) )(@)(@@) أبو الشيخ عن ابن عمر والديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15979 ) قال النبي :(@)(@@) | 30 ( كم بين مسألة الأعرابي وعجوز بني إسرائيل ؟ ، أن موسى لما أمر أن يقطع البحر فانتهى إليه صرفت وجوه الدواب فرجعت ، فقال موسى : ما لي يا رب ؟ قال : إنك عند قبر يوسف فاحمل عظامه معك ، وقد استوى القبر بالأرض ، فجعل موسى لا يدري أين هو ؟ فسأل موسى : هل يدري أحد منكم أين هو ) )(@)(@@) فقالوا : إن كان أحد يعلم أين هو ؟ فعجوز بين فلان نعلم أين هو ؟ فأرسل إليها الرسول ، قالت : ما لكم ؟ قالوا : انطلقي إلى موسى ، فلما أتته ، قال لها : تعلمين أين قبر يوسف ؟ قالت : نعم ، قال : فدلينا عليه ، قالت : لا والله حتى تعطيني ما أسألك ، قال لها : لك ذالك ، قالت : فإني أسألك أن أكون معك في الدرجة التي تكون فيها في الجنة ، قال : سلي الجنة ، قالت : لا والله ، لا أرضى إلا أن أكون معك ، فجعل موسى يرادها ، فأوحى الله إليه أن أعطيها ذالك فإنه لا ينقصك شيء ، فأعطاها ودلته على القبر ، فأخرجوا العظام وجاوزوا البحر ) )(@)(@@) | ال| خرائطي في مكارم الأخلاق عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15980 ) قال النبي :(@)(@@) | 30 ( كم من مستقبل يوما لا يستكمله ، ومنتظر غدا لا يبلغه ، لو نظرتم إلى ألاجل ومسيره لأبغضتم الأمل وغروره ) )(@)(@@) الديلمي عن ابن عمر PageV05P461 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15981 ) قال النبي :(@)(@@) | 30 ( كمال الإيمان حسن الخلق ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15982 ) قال النبي :(@)(@@) | 30 ( كمل دينه ، النكاح لا السفاح ، ولا نكاح 
