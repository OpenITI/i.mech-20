ms3541	 : بعث النبي صلى الله عليه وسلم عمر بن الخطاب ورجلا من الأنصار يحرسان المسلمين فأجنبا حين أصابهما برد السحر فتمرغ عمر بالتراب وتيمم الأنصاري صعيدا طيبا ثم صليا ، فقال النبي صلى الله عليه وسلم : فذكره ) .(@)(@@) 26701 - أصب أهلك وإن لم تقدر على الماء عشر سنين .(@)(@@) % ( الرافعي عن أبي ذر ) .(@)(@@) 26702 - الصعيد الطيب وضوء المسلم ولو عشر حجج ، فإذا وجد الماء فليمس بشرته الماء .(@)(@@) % ( حب عن أبي ذر ) .(@)(@@) 26703 - الصعيد الطيب طهور ما لم يوجد الماء ولو إلى عشر حجج ، فإذا وجدت الماء فأمس بشرتك .(@)(@@) % ( ش عن أبي الدرداء ) .(@)(@@) PageV09P175(@)(@@) | 1 ( الفصل الثالث { في المسح على الخفين } ) 1(@)(@@) 26704 - امسحوا على الخفين والخمار .(@)(@@) % ( حم عن بلال ) .(@)(@@) 26705 - إذا أدخل أحدكم رجليه في خفيه وهما طاهرتان فليمسح عليهما ثلاثا للمسافر ويوما للمقيم .(@)(@@) % ( ش عن أبي هريرة ) .(@)(@@) 26706 - إذا توضأ أحدكم ولبس خفيه فليصل فيهما وليمسح عليهما ثم لا يخلعهما إن شاء إلا من جنابة .(@)(@@) % ( قط ك عن أنس ) .(@)(@@) 26707 - امسحوا على الخفاف ثلاثة أيام .(@)(@@) % ( طب عن خزيمة بن ثابت ) .(@)(@@) 26708 - للمسافر ثلاثة أيام ولياليهن ، وللمقيم يوما وليلة في المسح على الخفين .(@)(@@) % ( حم م ن ه عن علي ؛ حم 4 ( أخرجه الترمذي كتاب الطهارة باب المسح على الخفين للمسافر والمقيم رقم ( 95 ) وقال : حسن صحيح . ص ) حب عن خزيمة بن ثابت ؛ حم ، تخ عن عوف بن مالك ؛ طب عن أسامة بن شريك والبراء بن عازب وجرير البجلي وصفوان بن عسال والمغيرة بن شعبة ويعلى بن مرة وأبي بكرة طس عن أنس وابن عمر ؛ تخ عن عمر ؛ قط في الأفراد عن بلال ؛ البزار عن أبي هريرة ؛ وأبو نعيم في المعرفة عن مالك بن سعد وأبي مريم ؛ الباوردي عن خالد بن عرفطة ؛ ابن عساكر عن يسار ؛ أبو بكر النيسابوري عن عمرو بن أمية الضمري ) .(@)(@@) | 1 ( { الإكمال } من المسح على الخفين ) 1(@)(@@) 26709 - امسحوا على الخفين والموق ( الموق : الذي يلبس فوق الخف . فارسي معرب . المختار [ 507 ] ب ) .(@)(@@) % ( طب والبغوي عن بلال ) .(@)(@@) 26710 - امسحوا على الخفين وعلى الخمار 
ms3542	 .(@)(@@) % ( عبد الرزاق حم طب عن بلال ) .(@)(@@) 26711 - امسحوا على النصيف ( النصيف : هو الخمار . النهاية [ 5 / 66 ] ب ) والموق .(@)(@@) % ( ص عن بلال ) .(@)(@@) 26712 - إنكم سيكثر لكم من الخفاف ، قالوا : فما تأمرنا ؟ قال : تمسحون عليها .(@)(@@) % ( طب عن معقل بن يسار ) .(@)(@@) 26713 - ليس هكذا السنة أمرنا بالمسح على الخفين هكذا ، وأمر يده على خفيه .(@)(@@) % ( طس عن جابر ) .(@)(@@) 26714 - المسح للمسافر ثلاثة ، وللمقيم يوم وليلة .(@)(@@) % ( ش عن خزيمة بن ثابت ) .(@)(@@) 26715 - المسح على الخفين للمقيم يوم وليلة ، وللمسافر ثلاثة أيام ولياليهن .(@)(@@) % ( حل عن علي ؛ الخطيب عن خزيمة بن ثابت ، طب عن ابن عباس ، طب عن ابن عمر ، أبو نعيم عن خزيمة بن ثابت ) .(@)(@@) 26716 - ثلاثة أيام ولياليهن للمسافر ، ويوم وليلة للمقيم ، لا تنزعه من نوم ولا بول ولا غائط إلا من جنابة .(@)(@@) % ( طب عن صفوان بن عسال ) .(@)(@@) PageV09P176(@)(@@) 26717 - يمسح المسافر ثلاثة أيام والمقيم يوما وليلة .(@)(@@) % ( ق في المعرفة عن خزيمة بن ثابت ) .(@)(@@) 26718 - للمسافر ثلاثة ولياليهن وللمقيم يوم وليلة يمسح على خفيه إذا أدخلهما قدماه طاهرتان .(@)(@@) % ( طب عن خزيمة بن ثابت ) .(@)(@@) | 1 ( الفصل الرابع { في الحيض والاستحاضة والنفاس } ) 1(@)(@@)(@)(@@) | 1 ( { الحيض } ) 1(@)(@@) 26719 - أقل الحيض ، ثلاث وأكثره عشرة .(@)(@@) % ( طب عن أبي أمامة ) .(@)(@@) 26720 - لا يقرأ الجنب ولا الحائض شيئا من القرآن .(@)(@@) % ( حم ت ه عن ابن عمر ) ( أخرجه الترمذي كتاب الطهارة باب ما جاء في الجنب والحائض رقم ( 131 ) وفيه إسماعيل بن عياش . ص ) .(@)(@@) 26721 - خذي فرصة ( فرصة : الفرصة - بكسر الفاء - قطعة من صوف أو قطن أو خرقة . يقال : فرصت الشيء إذا قطعته . وفي حديث الحيض ( خذي فرصة ممسكة فتطهري بها ) والممسكة : المطيبة بالمسك . يتتبع بها أثر الدم فيحصل منه الطيب والتنشيف . النهاية [ 3 / 431 ] ب ) من مسك فتطهري بها .(@)(@@) % ( ق ( أخرجه مسلم كتاب الحيض باب استحباب المغتسلة من الحيض رقم ( 332 ) و ( 1 / 260 و 261 ) ص ) ن عن عائشة ) .(@)(@@) 26722 - أخبرني جبريل أن الله عز وجل بعثه إلى أمنا حواء حين دميت فنادت ربها : جاء مني دم لا أعرفه فناداها لأدمينك وذريتك 
ms3543	 لأجعلنه لك كفارة وطهورا .(@)(@@) % ( قط في الأفراد عن عمر ) .(@)(@@) 26723 - إذا أصاب ثوب أحداكن الدم من الحيض فلتقرصه ثم لتنضحه بماء ثم لتصلي فيه .(@)(@@) % ( ق د عن أسماء بنت أبي بكر ) .(@)(@@) 26724 - إن حيضتك ليست في يدك .(@)(@@) % ( م ( أخرجه مسلم كتاب الحيض باب جواز غسل الحائض رقم ( 299 ) ص ) 3 عن عائشة م ن عن أبي هريرة ) .(@)(@@) | 1 ( { الإكمال } من الحيض ) 1(@)(@@) 26725 - لا يكون الحيض للجارية والثيب التي قد أيست من الحيض أقل من ثلاثة أيام ولا أكثر من عشرة أيام .(@)(@@) % ( قط عن أبي أمامة ) .(@)(@@) 26726 - جامعوهن في البيوت واصنعوا كل شيء غير النكاح .(@)(@@) % ( د عن أنس ) ( أخرجه أبو داود كتاب الطهارة باب في مؤاكلة الحائض ومجامعتها رقم ( 258 ) والحديث صحيح . ص ) .(@)(@@) 26727 - إن للحائض وقعات ولدم الحيض ريح ليس لغيره فإذا ذهب قرء ( قرء القرء - بالفتح - : الحيض . وجمعه : أقراء ، كأفراخ ؛ وقروء ، كفلوس ؛ وأقرؤ كأفلس . والقرء أيضا ، الطهر ، وهو من الأضداد . المختار [ 414 ] ب ) الحيض ، فلتغتسل إحداكن ثم لتغتسل عنها الدم .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) | 1 ( { الاستحاضة } ) 1(@)(@@) 26728 - المستحاضة تغتسل من قرء إلى قرء .(@)(@@) % ( طس عن ابن عمر ) .(@)(@@) 26729 - إذا كان دم الحيض فإنه دم أسود يعرف ، فإذا كان ذلك فأمسكي عن الصلاة فإذا كان الآخر فتوضئي وصلي فإنما هو عرق .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب من قال توضأ لكل صلاة رقم ( 304 و 286 ) ص ) ن ك عن فاطمة بنت أبي حبيش ؛ ن عن عائشة ) .(@)(@@) PageV09P177(@)(@@) 26730 - إن هذه ليست بالحيضة لكن هذا عرق ، فإذا أدبرت الحيضة فاغتسلي وصلي ، وإذا أقبلت فاتركي الصلاة .(@)(@@) % ( ن ك عن عائشة ) .(@)(@@) 26731 - إنما ذلك عرق فانظري ، فإذا أتى قرؤك فلا تصلي ، وإذا مر قرؤك فتطهري ، ثم صلي ما بين القرء إلى القرء .(@)(@@) % ( د ، ن عن فاطمة بنت أبي حبيش ) ( أخرجه أبو داود كتاب الطهارة باب من روى أن الحيضة إذا أدبرت لا تدع الصلاة رقم ( 282 ) ص ) .(@)(@@) 26732 - لتدع الصلاة في كل شهر أيام قرئها ثم تتوضأ لكل صلاة فإنما 
ms3544	 هو عرق .(@)(@@) % ( ك عن فاطمة بنت أبي حبيش ) .(@)(@@) 26733 - المستحاضة تدع الصلاة أيام أقرائها ، ثم تغتسل وتصلي ، والوضوء عند كل صلاة .(@)(@@) % ( 4 ( أخرجه الترمذي كتاب الطهارة باب ما جاء أن المستحاضة تتوضأ لكل صلاة رقم ( 126 ) وأبو داود ضعف هذا الحديث . ص ) عن دينار ) .(@)(@@) 26734 - أنعت لك الكرسف ( الكرسف : القطن . المختار [ 424 ] ب ) فإنه يذهب الدم .(@)(@@) % ( د ( أخرجه الترمذي كتاب الطهارة باب ما جاء في المستحاضة رقم ( 128 ) حسن صحيح . ص ) 4 عن حمنة بنت جحش ) .(@)(@@) 26735 - تأخذ إحداكن ماءها وسدرها فتطهر فتحسن الطهور ثم تصب على رأسها فتدلكه دلكا شديدا حتى يبلغ شؤن رأسها ، ثم تصب عليها الماء ، ثم تأخذ فرصة ممسكة فتطهر بها .(@)(@@) % ( حم م ( أخرجه مسلم كتاب الحيض باب استحباب استعمال المغتسلة رقم ( 61 ) ص ) د ، ه عن عائشة ) .(@)(@@) 26736 - لتنظر عدة الليالي والأيام التي كانت تحيضهن من الشهر قبل أن يصيبها الذي أصابها ، فلتترك الصلاة قدر ذلك من الشهر ، فإذا خلفت ذلك فلتغتسل ، ثم لتستثفر ( ثم لتستثفر : هو أن تشد فرجها بخرقة عريضة بعد أن تحتشي قطنا ، وتوثق طرفيها في شيء تشده على وسطها ، فتمنع بذلك سيل الدم ، وهو مأخوذ من ثفر الدابة الذي يجعلها تحت ذنبها . النهاية [ 1 / 214 ] ب ) بثوب ثم لتصل فيه .(@)(@@) % ( د ن عن أم سلمة ) ( أخرجه أبو داود كتاب الطهارة باب من قال إذا أقبلت الحيضة تدع الصلاة رقم ( 284 ) ص ) .(@)(@@) 26737 - سآمرك بأمرين بأيهما فعلت أجزأ عنك من الآخر ، وإن قويت عليهما فأنت أعلم فقال لها : إنما هذه ركضة من ركضات الشيطان فتحيضي ستة أيام أو سبعة أيام في علم الله ، ثم اغتسلي حتى إذا رأيت أنك قد طهرت واستنقأت ، فصلي ثلاثا وعشرين ليلة أو أربعا وعشرين ليلة وأيامها وصومي ، فإن ذلك يجزئك ، وكذلك فافعلي كل شهر كما يحضن النساء وكما يطهرن ميقات حيضهن وطهرهن وإن قويت على أن تؤخري الظهر وتعجلي العصر ، فتغتسلين وتجمعين بين الصلاتين الظهر والعصر ، وتؤخرين المغرب وتعجلين العشاء ، ثم تغتسلين وتجمعين بين الصلاتين فافعلي ، وتغتسلين 
ms3545	 مع الفجر فافعلي ، وصومي إن قدرت على ذلك ، قال رسول الله صلى الله عليه وسلم : وهذا أعجب الأمرين إلي .(@)(@@) % ( حم 4 ( أخرجه الترمذي كتاب الطهارة باب ما جاء في المستحاضة رقم ( 128 ) وقال : حسن صحيح . ص ) ك عن حمنة بنت جحش ) .(@)(@@) | 1 ( { الإكمال } من الاستحاضة ) 1(@)(@@) 26738 - إنما ذلك عرق فانظري فإذا أتى قرؤك فلا تصلي فإذا مر قرؤك فتطهري ثم صلى ما بين القرء إلى القرء .(@)(@@) % ( د ن عن فاطمة بنت أبي حبيش أنها شكت إلى رسول الله صلى الله عليه وسلم الدم قال : فذكره ) .(@)(@@) 26739 - إنما ذلك عرق فإذا أقبلت الحيضة فدعي الصلاة فإذا أدبرت فاغسلي عنك الدم ثم صلي .(@)(@@) % ( ت عن فاطمة ) .(@)(@@) PageV09P178(@)(@@) 26740 - إنما هو عرق تترك الصلاة قدر حيضتها ثم تجمع الظهر والعصر بغسل واحد ، والمغرب والعشاء بغسل واحد ، وتغتسل للصبح غسلا .(@)(@@) % ( عبد الرزاق عن ابن عيينة عن عيينة عن عبد الرحمن بن القاسم عن أبيه أن امرأة من المسلمين استحيضت فسألت النبي قال : فذكره ) .(@)(@@) 26741 - إن هذه ليست الحيضة ولكن هذا عرق ، فإذا أدبرت الحيضة فاغتسلي وصلي ، وإذا أقبلت فاتركي بها الصلاة .(@)(@@) % ( ن ك عن عائشة أن أم حبيبة استحيضت فاستفتت رسول الله صلى الله عليه وسلم قال : فذكره ) .(@)(@@) 26742 - الحائض تنظر ما بينها وبين عشر ، فإن رأت الطهر فهي طاهرة ، وإن جاوزت العشر فهي مستحاضة تغتسل وتصلي ، فإن غلبها الدم احتشت واستثفرت وتوضأت لكل صلاة وتنظر النفساء ما بينها وبين الأربعين فإن رأت الطهر قبل ذلك فهي طاهرة ، وإن جاوزت الأربعين فهي بمنزلة المستحاضة وتصلي ، فإن غلبها الدم احتشت واستثفرت وتوضأت لكل صلاة .(@)(@@) % ( طس عن ابن عمرو ) ( أورده الهيثمي في مجمع الزوائد ( 1 / 280 ) باب ما جاء في الحيض والاستحاضة وقال : أخرجه الطبراني في الأوسط وفيه عمرو بن الحصين وهو ضعيف . ص ) .(@)(@@) 26743 - المستحاضة تدع الصلاة في أيام حيضها في كل شهر فإذا كان عند انقضائها اغتسلت وصلت وصامت وتوضأت عند كل صلاة .(@)(@@) % ( الدارمي عن عدي بن ثابت ) .(@)(@@) 26744 - المستحاضة تقعد أيام أقرائها ثم 
ms3546	 تغتسل عند كل طهر ، ثم تحتشي وتصلي .(@)(@@) % ( طس عن جابر ) .(@)(@@) 26745 - المستحاضة تدع الصلاة أيام أقرائها التي كانت تجلس فيها ، ثم تغتسل غسلا واحدا ، ثم تتوضأ لكل صلاة .(@)(@@) % ( طس عن سودة بنت زمعة ) .(@)(@@) 26746 - المستحاضة تضع الصلاة أيام أقرائها ، ثم تغتسل وتوضأ لكل صلاة وتصوم وتصلي .(@)(@@) % ( ش عن عدي بن ثابت عن أبيه عن جده ) .(@)(@@) 26747 - تدع الصلاة أيامها ثم تغتسل غسلا واحدا ثم تتوضأ عند كل صلاة .(@)(@@) % ( حب عن عائشة قالت : سئل رسول الله صلى الله عليه وسلم عن المستحاضة قال : فذكره ) .(@)(@@) 26748 - إن حيضتك ليست في يدك .(@)(@@) % ( عبد الرزاق م ، د ، ت عن عائشة أن رسول الله صلى الله عليه وسلم قال لها : ناولينا الخمرة ( الخمرة : هي مقدار ما يضع الرجل عليه وجهه في سجوده من حصير أو نسيجة خوص ونحوة من النبات ، ولا تكون خمرة إلا في هذا المقدار ، وسميت خمرة لأن خيوطها مستورة بسعفها ، وقد تكررت في الحديث . هكذا فسرت . وقد جاء في سنن أبي داود عن ابن عباس قال : جاءت فأرة فأخذت تجر الفتيلة ، فجاءت بها فألقتها بين يدي رسول الله صلى الله عليه وسلم على الخمرة التي كان قاعدا عليها ، فأحرقت منها مثل موضع درهم . وهذا صريح في إطلاق الخمرة على الكبير من نوعها . النهاية [ 2 / 78 ] ب ) من المسجد ، فقالت : إني حائض ، قال : فذكره ؛ م ن عن أبي هريرة ؛ طب عن أم أيمن مثله ) مر برقم [ 26724 ] .(@)(@@) 26749 - تعتد أيام أقرائها ثم تغتسل في كل يوم عند كل طهور وتصلي .(@)(@@) % ( الشاشي قط عن جابر أن فاطمة بنت أبي حبيش سألت رسول الله صلى الله عليه وسلم عن المستحاضة كيف تصنع قال : فذكره ) .(@)(@@) PageV09P179(@)(@@) 26750 - تقعد أيام أقرائها ثم تغتسل وتصلي عند طهرها .(@)(@@) % ( ك عن فاطمة بنت قيس في المستحاضة ) .(@)(@@) 26751 - سبحان الله هذا من الشيطان فتجلس في مركن ( مركن : المركن بكسر الميم : الاجانة التي يغسل فيها الثياب . والميم زائدة ، وهي التي تخص الآلات . النهاية [ 2 / 260 ] ب ) فإذا رأت الصفرة فوق الماء فلتغتسل للظهر 
ms3547	 والعصر غسلا واحدا ، وتغتسل للمغرب والعشاء غسلا واحدا وتغتسل للفجر غسلا وتتوضأ فيما بين ذلك .(@)(@@) % ( ك ( أخرجه الحاكم في المستدرك كتاب الطهارة ( 1 / 174 ) وقال : صحيح على شرط مسلم ووافقه الذهبي ) عن أسماء بنت عميس قالت ، قلت لرسول الله صلى الله عليه وسلم إن فاطمة بنت أبي حبيش استحيضت منذ كذا وكذا فلم تصل قال : فذكره ) .(@)(@@) 26752 - لا إنما ذلك عرق وليس بحيض ؛ فإذا أقبلت حيضتك فدعي الصلاة ، وإذا أدبرت فاغسلي عنك الدم وصلي ثم توضئي لكل صلاة حتى يجيء ذلك الوقت .(@)(@@) % ( خ ( أخرجه البخاري كتاب الوضوء باب غسل الدم ( 1 / 66 / 67 ) ص ) م د ت ن ه عن عائشة أن فاطمة بنت أبي حبيش ، وأبو حبيش هو ابن عبد المطلب بن أسد قالت : يا رسول الله إني امرأة أستحاض فلا أطهر قال ، فذكره ) .(@)(@@) 26753 - لا إنما ذلك عرق وليس بالحيضة اجتنبي الصلاة أيام محيضك ، ثم اغتسلي وتوضئي لكل صلاة وإن قطر الدم على الحصير .(@)(@@) % ( ه عنها ) .(@)(@@) 26754 - قولي لها : فلتدع الصلاة في كل شهر أيام أقرائها ثم لتغتسل في كل يوم غسلا واحدا ، ثم الطهور عند كل صلاة ولتنظف ولتختش فإنما هو داء عرض أو ركضة من الشيطان أو عرق انقطع .(@)(@@) % ( ك ( أخرجه الحاكم في المستدرك كتاب الطهارة ( 1 / 175 ) وقال : هذا حديث صحيح ولم يخرجاه وقال الذهبي : مرسل . ص ) عن عائشة ) .(@)(@@) | 1 ( { النفاس وبعض أحكام الحيض } ) 1(@)(@@) 26755 - إذا مضى للنفساء سبع ثم رأت الطهر فلتغتسل ولتصل .(@)(@@) % ( ك ( أخرجه الحاكم في المستدرك كتاب الطهارة ( 1 / 176 ) وقال الحاكم : فيه الأسود بن ثعلبة شامي معروف والحديث غريب ووافقه الذهبي . ص ) عن معاذ ) .(@)(@@) 26756 - ما فوق الإزار حلال وما تحت الإزار منها حرام يعني من الحائض .(@)(@@) % ( طب عن عبادة بن الصامت ) .(@)(@@) 26757 - ما فوق الإزار ، والتعفف عن ذلك أفضل .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطهارة باب في المذي رقم ( 210 ) وقال أبو داود : وليس بالقوي وقال المنذري : الحديث ضعيف . عون المعبود ( 1 / 363 ) ص ) عن معاذ ) .(@)(@@) | 1 ( { الإكمال } من 
ms3548	 النفاس وبعض أحكام الحيض ) 1(@)(@@) 26758 - تنتظر النفساء أربعين يوما إلا أن ترى الطهر قبل ذلك فإن بلغت أربعين يوما ولم ترى الطهر فلتغتسل وهي بمنزلة المستحاضة .(@)(@@) % ( عد كر عن مكحول عن أبي الدرداء عن أبي هريرة ) .(@)(@@) 26759 - تنتظر النفساء أربعين ليلة فإن رأت الطهر قبل ذلك فهي طاهرة ، وإن جاوزت الأربعين فهي بمنزلة المستحاضة تغتسل وتصلي ، فإن غلبها الدم توضأت لكل صلاة .(@)(@@) % ( كر عن ابن عمر ) .(@)(@@) PageV09P180(@)(@@) | 1 ( الفصل الخامس { في الدباغ } ) 1(@)(@@) 26760 - دباغ الأديم طهوره .(@)(@@) % ( حم م ( أخرجه مسلم كتاب الحيض باب طهارة جلود الميتة بالدباغ رقم ( 106 و 366 ) ص ) عن ابن عباس ؛ د عن سلمة بن المحبق ؛ ن عن عائشة ؛ ع عن أنس ؛ طب عن أبي أمامة وعن المغيرة ) .(@)(@@) 26761 - دباغ جلود الميتة طهورها .(@)(@@) % ( طب عن زيد بن ثابت ) .(@)(@@) 26762 - دباغ كل إهاب طهوره .(@)(@@) % ( قط عن ابن عباس ) .(@)(@@) 26763 - ذكاة الميتة دباغها .(@)(@@) % ( ن ك عن عائشة ) .(@)(@@) 26764 - ذكاة كل مسك دباغه .(@)(@@) % ( ك عن عبد الله بن الحارث ) .(@)(@@) 26765 - طهور كل أديم دباغه .(@)(@@) % ( أبو بكر في الغيلانيات عن عائشة ) .(@)(@@) 26766 - أيما إهاب دبغ فقد طهر .(@)(@@) % ( حم ، ت ( أخرجه الترمذي كتاب اللباس باب ما جاء في جلود الميتة إذا دبغت رقم ( 1727 ) قال : حسن صحيح ) ، ن ، ه عن ابن عباس ) .(@)(@@) 26767 - إذا دبغ الإهاب فقد طهر .(@)(@@) % ( م د عن ابن عباس ) ( أخرجه مسلم كتاب الحيض باب طهارة جلود الميتة بالدباغ رقم ( 106 و 366 ) ص ) .(@)(@@) 26768 - إذا دبغ جلد الميتة فحسبه فلينتفع به .(@)(@@) % ( عب عطاء مرسلا ) .(@)(@@) 26769 - إن الدباغ يحل من الميتة كما يحل الخل من الخمر .(@)(@@) % ( عد هق عن أم سلمة ) .(@)(@@) 26770 - لو أخذتم إهابها يطهره الماء والقرظ .(@)(@@) % ( د ن ( أخرجه أبو داود كتاب اللباس باب في أهب الميتة رقم ( 4108 ) وقال المنذري : أخرجه النسائي . عون المعبود ( 11 / 183 ) ص ) عن ميمونة ) .(@)(@@) 26771 - ما عليها لو انتفعت بإهابها إنما حرم الله أكلها .(@)(@@) % ( ن عن ميمونة ) .(@)(@@) 26772 - هلا أخذتم إهابها فدبغتموه فانتفعتم إنما حرم أكلها .(@)(@@) % ( حم 4 ( أخرجه 
ms3549	 مسلم كتاب الحيض باب طهارة جلود الميتة رقم ( 363 ) ص ) عن ابن عباس ) .(@)(@@) | 1 ( { الإكمال } من الدباغ ) 1(@)(@@) 26773 - اشربوا فإن دباغ الميتة طهورها .(@)(@@) % ( البغوي وابن قانع وابن منده ، كر عن جون بن قتادة التيمي قال : كنا مع رسول الله صلى الله عليه وسلم في سفر فمروا بسقاء معلق ، فقال صاحبه : إنه جلد ميتة ، قال النبي صلى الله عليه وسلم : فذكره ) .(@)(@@) 26774 - أفلا انتفعتم بإهابها يحلها دباغها كما يحل الخل الخمر .(@)(@@) % ( طب عن أم سلمة ) .(@)(@@) 26775 - ألا كنتم تنتفعون بإهابها ؟ إن دباغها أحلها كما أحل الخل الخمر .(@)(@@) % ( طب عن أم سلمة ) .(@)(@@) 26776 - ألا دبغتم إهابها فاستمتعتم به .(@)(@@) % ( حب عن ميمونة رضي الله عنها ) .(@)(@@) 26777 - ما ضر أهل هذه لو انتفعوا بإهابها .(@)(@@) % ( ه عن سليمان ؛ طب عن أبي مسعود ) .(@)(@@) PageV09P181(@)(@@) 26778 - أفلا انتفعتم به فإن دباغها ذكاتها يحل كما يحل الخل من الخمر .(@)(@@) % ( طب عن أم سلمة ) .(@)(@@) 26779 - هلا انتفعتم بجلدها إنما حرم أكلها .(@)(@@) % ( مالك والشافعي ، حم ، خ ، م ( أخرجه مسلم كتاب الحيض باب طهارة جلود الميتة بالدباغ رقم ( 101 ) ص ) ن حب عن ابن عباس قال : وجد النبي صلى الله عليه وسلم شاة ميتة قال : فذكره ) .(@)(@@) 26780 - جلود الميتة دباغته يذهب خبثه .(@)(@@) % ( حم ك عن ابن عباس ) .(@)(@@) 26781 - كل إهاب دبغ فقد طهر .(@)(@@) % ( ط عن ابن عباس ) .(@)(@@) 26782 - لا بأس بمسك الميتة إذا دبغ .(@)(@@) % ( طب عن أم سلمة ) .(@)(@@) 26783 - دباغه يذهب خبثه .(@)(@@) % ( حم ك عن ابن عباس ) .(@)(@@) 26784 - فأين الدباغ ؟(@)(@@) % ( عم ، ق عن ابن أبي ليلى أن رجلا قال : يا رسول الله أصلي في الفراء قال : فذكره ) .(@)(@@) 26785 - إنما حرم من الميتة أكل اللحم ، فأما الصوف والشعر والجلد فلا بأس به .(@)(@@) % ( عد وابن النجار عن ابن عباس ) .(@)(@@) 26786 - إنما حرم عليكم لحمها ورخص لكم في مسكها .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 26787 - لا تنتفعوا بشيء من الميتة .(@)(@@) % ( سمويه عن جابر ، أبو عبد الله الكيساني في فوائده عن ابن عمر ) .(@)(@@) 26788 - لا تنتفعوا من الميتة بإهاب ولا عصب .(@)(@@) % ( ط حم عن عبد الله 
ms3550	 بن عكيم ) .(@)(@@) 26789 - لا تستمتعوا من الميتة بإهاب ولا عصب .(@)(@@) % ( طس عن عبد الله بن عكيم ) .(@)(@@) PageV09P182(@)(@@) | 1 ( حرف الطاء ) 1(@)(@@)(@)(@@) | 1 ( كتاب الطهارة من قسم الأفعال ) 1(@)(@@)(@)(@@) | 1 ( { باب في فضلها مطلقا } ) 1(@)(@@) 26790 - عن عمر قال : لا تقبل صلاة إلا بطهور .(@)(@@) % ( الحديث هنا خال من العزو فأقول : قد مر الحديث مرفوعا برقم [ 26006 ] ورقم [ 26015 ] مع عزوه . ص ) .(@)(@@) 26791 - { مسند علي } عن حجر بن عدي قال : حدثنا علي بن أبي طالب أن الطهور نصف الإيمان .(@)(@@) % ( عب ش ورسته في الإيمان واللالكائي في السنة ، عب ، كر ) .(@)(@@) 26792 - { أيضا } عن شريح بن هانئ قال : سمعت عليا يقول : من أحسن الطهور ثم مشي إلا المسجد كان في صلاة ما لم يحدث .(@)(@@) % ( عب ) .(@)(@@) 26793 - عن الحسن أن رجلا حدثهم أن رسول الله صلى الله عليه وسلم كان يتوضأ بمد من ماء ويغتسل بصاع .(@)(@@) % ( عب ش ) .(@)(@@) 26794 - عن ابن عمر قال : لا يقبل الله صلاة بغير طهور ولا صدقة من غلول ولا نفقة في رياء .(@)(@@) % ( ص ) .(@)(@@) 26795 - عن علي قال : الطهور شطر الإيمان .(@)(@@) % ( ش ) .(@)(@@) | 1 ( { باب الوضوء } ) 1(@)(@@)(@)(@@) | 1 ( { فضله } ) 1(@)(@@) 26796 - عن حمران قال توضأ عثمان بن عفان يوما وضوءا حسنا ثم قال رأيت رسول الله صلى الله عليه وسلم توضأ فأحسن الوضوء ثم قال : من توضأ هكذا ثم خرج إلى المسجد لا ينهزه ( لا ينهزه : معناه لا يدفعه وينهضه ويحركه إلا الصلاة . والحديث أخرجه مسلم كتاب الطهارة باب فضل الوضوء والصلاة عقبه رقم ( 232 ) ص ) إلا الصلاة غفر له ما خلا من ذنبه .(@)(@@) % ( م وأبو عوانة ) .(@)(@@) PageV09P183(@)(@@) 26797 - عن حمران مولى عثمان قال : أتيت عثمان بن عفان بوضوء فتوضأ ثم قال : إن ناسا يتحدثون عن رسول الله صلى الله عليه وسلم أحاديث لا أدري ما هي ألا إني رأيت رسول الله صلى الله عليه وسلم توضأ مثل وضوئي هذا ثم قال : من توضأ هكذا غفر له ما تقدم من ذنبه ، وكانت صلاته ومشيه إلى المسجد نافلة .(@)(@@) % ( م ) ( أخرجه مسلم كتاب الطهارة باب فضل 
ms3551	 الوضوء والصلاة عقبه رقم ( 229 ) ص ) .(@)(@@) 26798 - عن حمران قال : رأيت عثمان قاعدا فدعا بوضوء فتوضأ ثم قال : رأيت رسول الله صلى الله عليه وسلم في مقعدي هذا توضأ مثل وضوئي هذا ثم قال : من توضأ مثل وضوئي هذا غفر له ما تقدم من ذنبه ، وقال رسول الله صلى الله عليه وسلم : ولا تغتروا .(@)(@@) % ( ه حب ) .(@)(@@) 26799 - عن عثمان قال : رأيت رسول الله صلى الله عليه وسلم توضأ فأحسن الوضوء ثم قال : من توضأ وضوئي هذا ثم أتى المسجد فركع ركعتين غفر له ما تقدم من ذنبه .(@)(@@) % ( البزار ورجاله ثقات ) .(@)(@@) 26800 - عن حمران قال : أتيت عثمان بوضوء فتوضأ للصلاة ثم قال : سمعت رسول الله صلى الله عليه وسلم يقول : من توضأ فأحسن الطهور كفر عنه ما تقدم من ذنبه ، ثم التفت إلى أصحابه فقال : يا فلان أسمعتها من رسول الله صلى الله عليه وسلم حتى أنشد ثلاثة من أصحابه فكلهم يقول : سمعناه ووعيناه .(@)(@@) % ( الحارث وفيه إسماعيل بن إبراهيم بن مهاجر ضعيف ) .(@)(@@) 26801 - عن حمران أن عثمان بن عفان توضأ ثلاثا ثلاثا ، ثم قال : إن رسول الله صلى الله عليه وسلم توضأ نحو وضوئي هذا ، ثم قال رسول الله صلى الله عليه وسلم : من توضأ نحو وضوئي هذا ، ثم ركع ركعتين لا يحدث فيهما نفسه إلا بخير غفر له ما تقدم من ذنبه .(@)(@@) % ( طس ) .(@)(@@) 26802 - عن عمرو بن ميمون سمعت عثمان بن عفان وكان قليل الحديث يقول قال رسول الله صلى الله عليه وسلم : من توضأ كما أمر وصلى كما أمر خرج من ذنوبه كيوم ولدته أمه ، ثم استشهد رهطا من أصحاب النبي صلى الله عليه وسلم يقول هذا قالوا : نعم .(@)(@@) % ( حل ) .(@)(@@) 26803 - عن حمران قال : كان عثمان يغتسل كل يوم مرة منذ أسلم فوضعت وضوءا له ذات يوم للصلاة ، فلما توضأ قال : إني أردت أن أحدثكم حديثا سمعته من رسول الله صلى الله عليه وسلم ، ثم بدا لي أن لا أحدثكموه ، فقال الحكم بن العاص : يا أمير المؤمنين إن كان 
ms3552	 خيرا فنأخذ به أو شرا فنتقيه ، فقال : إني محدثكم به توضأ رسول الله صلى الله عليه وسلم هذا الوضوء ثم قال : من توضأ هذا الوضوء فأحسن الوضوء ، ثم قام إلى الصلاة فأتم ركوعها وسجودها كفرت عنه ما بينها وبين الصلاة الأخرى ما لم يصب مقتلة يعني كبيرة .(@)(@@) % ( حم هب ) .(@)(@@) 26804 - عن حمران قال : رأيت عثمان توضأ فغسل يديه ، ثم مضمض واستنشق اثنين ، ثم غسل وجهه ثلاث مرات ، ثم غسل يديه إلى المرفقين ثلاث مرات ، ثم مسح برأسه ومر بيديه على ظاهر أذنيه ومر بهما على لحيته ، ثم غسل رجليه إلى الكعبين ثلاث(@)(@@) PageV09P184 مرات ، ثم قام فركع ركعتين ، ثم قال : توضأت كما رأيت رسول الله صلى الله عليه وسلم توضأ ، ثم ركعت ركعتين كما رأيته ركع ، ثم قال : قال رسول الله صلى الله عليه وسلم حين فرغ من ركعتيه من توضأ كما توضأت ، ثم ركع ركعتين لا يحدث نفسه فيهما غفر له ما كان بينهما وبين صلاته بالأمس .(@)(@@) % ( ابن بشران في أماليه ) .(@)(@@) 26805 - عن عكرمة بن خالد المخزومي قال : حدثني رجل من أهل المدينة أن المؤذن أذن بصلاة العصر فدعا عثمان بن عفان بطهور فتطهر ، ثم قال : سمعت رسول الله صلى الله عليه وسلم يقول : من توضأ كما أمر كفر عنه ما تقدم من ذنبه ، ثم استشهد على ذلك أربعة من أصحاب رسول الله صلى الله عليه وسلم فشهدوا بذلك على النبي صلى الله عليه وسلم .(@)(@@) % ( ص ) .(@)(@@) 26806 - عن حمران قال : كنت عند عثمان بن عفان إذ دعا بوضوء فتوضأ فلما فرغ قال : توضأ رسول الله صلى الله عليه وسلم كما توضأت ثم تبسم فقال : هل تدرون فيم ضحكت ؟ قالوا : الله ورسوله أعلم ، قال : إن العبد المسلم إذا توضأ فأتم وضوءه ، ثم دخل في صلاته خرج من صلاته كما خرج من بطن أمه .(@)(@@) % ( ص ) .(@)(@@) 26807 - عن أبي أمامة قال : بينما أنا قاعد مع النبي صلى الله عليه وسلم إذ جاءه رجل فقال : يا رسول الله إني قد أصبت حدا فأقمه علي 
ms3553	 ، فسكت النبي صلى الله عليه وسلم ، ثم أعاد فأقيمت الصلاة فلم يرد عليه شيئا حتى صلى النبي صلى الله عليه وسلم ، ثم انصرف ، فقال : أرأيت حين خرجت من بيتك أليس توضأت فأحسنت الوضوء ؟ قال : بلى يا رسول الله ، قال : فإن الله قد غفر لك حدك أو قال ذنبك .(@)(@@) % ( كر ) .(@)(@@) 26808 - عن ابن مسعود قال : قلت يا رسول الله كيف تعرف ما لم تر من أمتك ؟ قال : هم غر محجلون بلق من آثار الوضوء .(@)(@@) % ( ش ) .(@)(@@) 26809 - عن علي عن النبي صلى الله عليه وسلم قال : إذا توضأ الرجل فهو في صلاة ما لم يحدث وقال علي : أستحيكم مما لم يستحي منه رسول الله صلى الله عليه وسلم الحدث أن يفسوا أو يضرط .(@)(@@) % ( ابن جرير وصححه ) .(@)(@@) | 1 ( { فرائض الوضوء } ) 1(@)(@@) 26810 - { مسند الصديق } عن أبي بكر قال : كنت عند النبي صلى الله عليه وسلم جالسا فجاء رجل وقد توضأ وبقي على ظهر قدمه مثل ظفر إبهامه لم يمسه الماء فقال له النبي صلى الله عليه وسلم : ارجع فأتم وضوءك ففعل .(@)(@@) % ( ابن أبي حاتم في العلل ، عق قط وضعفاه طس ) .(@)(@@) 26811 - { مسند عمر } عن عمر قال : رأيت رجلا توضأ للصلاة فترك موضع ظفر على ظهر قدمه فأبصره النبي صلى الله عليه وسلم فقال : ارجع فأحسن وضوءك ، فرجع فتوضأ ثم صلى .(@)(@@) % ( حم م ه ) ( أخرجه مسلم كتاب الطهارة باب وجوب استيعاب جميع أجزاء محل الطهارة رقم ( 243 ) ص ) .(@)(@@) PageV09P185(@)(@@) 26812 - عن عمر قال : رأيت رسول الله صلى الله عليه وسلم في غزوة تبوك توضأ واحدة واحدة .(@)(@@) % ( حم ه والطحاوي وهو حسن ) .(@)(@@) 26813 - عن إبراهيم قال : قلت للأسود أكان عمر يغسل قدميه ؟ قال : نعم كان يغسلهما غسلا .(@)(@@) % ( الطحاوي ) .(@)(@@) 26814 - عن أبي قلابة أن عمر بن الخطاب رأى رجلا يصلي وقد ترك من رجليه موضع ظفر فأمره أن يعيد الوضوء والصلاة .(@)(@@) % ( عب ) .(@)(@@) 26815 - عن مجاهد أن عمر بن الخطاب رأى أبا الدرداء مبقع ( مبقع : يريد به مواضع في رجليه لم يصبها الماء فخالف لونها لون ما أصابه 
ms3554	 الماء . النهاية [ 1 / 146 ] ب ) الرجلين فقال : يا أبا الدرداء ما لك ، فقال : القر يا أمير المؤمنين ، فبعث إليه بخميصة وقال : أجد الآن الطهور .(@)(@@) % ( ابن سعد ) .(@)(@@) 26816 - عن عبد بن عمير الليثي أن عمر بن الخطاب رأى رجلا وبظهر قدمه لمعة لم يصبها الماء فقال له عمر : أبهذا الوضوء تحضر الصلاة ؟ فقال : يا أمير المؤمنين البرد شديد وما معي ما يدفئني فرق له بعد ما هم به فقال : اغسل ما تركت من قدميك وأعد الصلاة وأمر له بخميصة .(@)(@@) % ( ص ، قط ) .(@)(@@) 26817 - عن جابر قال : رأى عمر بن الخطاب في قدم رجل مثل موضع الفلس لم يصبه الماء ، فأمره أن يعيد الوضوء ويعيد الصلاة .(@)(@@) % ( ص ) .(@)(@@) 26818 - عن أبي قلابة أن عمر بن الخطاب رأى رجلا توضأ وبظهر قدمه لمعة لم يصبها الماء فقال له : أعد الوضوء والصلاة .(@)(@@) % ( ص ) .(@)(@@) 26819 - عن علي أن رسول الله صلى الله عليه وسلم مسح رأسه مرة .(@)(@@) % ( ه ) .(@)(@@) 26820 - عن علي أنه توضأ فمسح رأسه مسحة واحدة .(@)(@@) % ( عب ) .(@)(@@) 26821 - { مسند البراء بن عازب } عن يزيد بن البراء بن عازب قال أبي : اجتمعوا فلأرينكم كيف كان رسول الله صلى الله عليه وسلم يتوضأ وكيف كان يصلي فجمع بنيه وأهله ودعا بوضوء فتمضمض واستنشق وغسل وجهه ثلاثا ويده اليمنى ثلاثا ويده اليسرى ثلاثا ، ثم مسح رأسه وأذنيه ظاهرهما وباطنهما ، وغسل رجله اليمنى ثلاثا ورجله اليسرى ثلاثا ثم قال : هكذا كان رسول الله صلى الله عليه وسلم يتوضأ .(@)(@@) % ( ص ) .(@)(@@) 26822 - { مسند تميم بن زيد المازني } عن عباد بن تميم عن أبيه قال : رأيت رسول الله صلى الله عليه وسلم توضأ ومسح بالماء على لحيته ورجليه .(@)(@@) % ( ش حم خ في تاريخه والعدني والبغوي والباوردي ، طب وأبو نعيم قال في الإصابة رجاله ثقات ) .(@)(@@) 26823 - عن شهر بن حوشب قال : دخلت على أبي أمامة فقال : سمعت رسول الله صلى الله عليه وسلم لو لم أسمعه إلا مرة أو مرتين أو ثلاثة أو أربعة حتى انتهى إلى سبع كنت خليقا(@)(@@) PageV09P186 أن لا أحدثكموه سمعت 
ms3555	 رسول الله صلى الله عليه وسلم يقول : إذا توضأ العبد المسلم فأحسن الوضوء ، ثم انطلق إلى الصلاة خرجت ذنوبه من سمعه وبصره ويديه ورجليه ، فقال أبو طيبة وهو جالس معنا : سمعت عمرو بن عبسة يحدث هذا الحديث عن رسول الله صلى الله عليه وسلم كما حدثنا أبو أمامة ، وزاد فيه : وإذا أوى الرجل إلى فراشه طاهرا على ذكر ، ثم توسد يمينه ثم تعار ( تعار : أي استيقظ ، ولا يكون إلا يقظة مع كلام . النهاية [ 3 / 204 ] ب ) من الليل لم يسأل الله من خير الدنيا والآخرة شيئا إلا أعطاه إياه .(@)(@@) % ( ابن زنجويه ورجاله ثقات ) .(@)(@@) 26824 - عن معاوية بن أبي سفيان أنه ذكر لهم وضوء رسول الله صلى الله عليه وسلم ثم إنه مسح رأسه حتى قطر الماء عن رأسه أو كان يقطر .(@)(@@) % ( كر ) .(@)(@@) 26825 - عن القاسم بن معاوية الثقفي عن معاوية أنه أراهم وضوء رسول الله صلى الله عليه وسلم فلما بلغ مسح رأسه وضع كفيه على مقدم رأسه ثم مر بهما حتى بلغا القفا ، ثم ردهما حتى بلغا المكان الذي منه بدأ .(@)(@@) % ( كر ) .(@)(@@) 26826 - عن عثمان بن أبي سعيد أنه ذكر لعمر بن عبد العزيز المسح على القدمين ، فقال : لقد بلغني عن ثلاثة من أصحاب محمد صلى الله عليه وسلم أدناهم ابن عمك المغيرة بن شعبة أن النبي صلى الله عليه وسلم غسل قدميه .(@)(@@) % ( عب ) .(@)(@@) 26827 - عن أبي ذر قال : أشرف علينا رسول الله صلى الله عليه وسلم ونحن نتوضأ ، فقال : ويل للعراقيب من النار ، فطفقت أغسلها غسلا وأدلكها دلكا .(@)(@@) % ( ص ) .(@)(@@) 26828 - عن أبي رافع قال : رأيت رسول الله صلى الله عليه وسلم يتوضأ ثلاثا ثلاثا ورأيته يتوضأ مرة مرة .(@)(@@) % ( ص ) .(@)(@@) 26829 - عن أبي هريرة قال : الأذنان من الرأس .(@)(@@) % ( عب ) .(@)(@@) 26830 - عن عطاء بن يسار عن ابن عباس أنه توضأ فغسل كل عضو منه غسلة واحدة ، ثم ذكر النبي صلى الله عليه وسلم كان يفعله .(@)(@@) % ( عب ) .(@)(@@) 26831 - عن أبي هريرة أن النبي صلى الله عليه وسلم توضأ غرفة غرفة وقال 
ms3556	 : لا يقبل الله صلاة إلا به .(@)(@@) % ( كر ) .(@)(@@) 26832 - { مسند أبي واقد } رأيت النبي صلى الله عليه وسلم توضأ فمسح رأسه هكذا ، وأمر حفص بيده على رأسه حتى مسح قفاه .(@)(@@) % ( ش ) .(@)(@@) 26833 - قال ابن النجار : أنبأنا أبو أحمد الأشقر في كتابه أن أبا الفضل الأشيب أخبره قال : كتب إلى أبو قاسم الزمن ، أنبأنا والدي أبو عبد الله المقعد قال : حدثني محمد بن أبي خراسان المفلوج ، حدثنا الأثرم ببغداد ، حدثنا الحسن بن مهران بن الوليد أبو سعيد الأصبهاني ، حدثنا الأحدب ، حدثنا الأصم ، حدثنا الضرير عن الأعمش عن الأعور عن الأعرج عن الأعمى أن النبي صلى الله عليه وسلم توضأ مرة مرة . الأحدب عبد الله ابن الحسن(@)(@@) PageV09P187 قاضي المصيصة ، والأصم عبد الله بن نصر الأنطاكي ، والضرير أبو معاوية ، والأعمش سليمان بن مهران ، والأعور إبراهيم النخعي ، والأعرج الحكم ، والأعمى عبد الله بن عباس ) .(@)(@@) 26834 - عن عمارة بن خزيمة عن ابن الفاكه قال : رأيت رسول الله صلى الله عليه وسلم توضأ مرة مرة .(@)(@@) % ( ابن النجار ) .(@)(@@) 26835 - { مسند الربيع بنت معوذ } كان رسول الله صلى الله عليه وسلم يأتينا فيكثر فأتانا فوضعنا له الميضأة ، فتوضأ ومسح رأسه بدأ بمؤخره ثم رد يديه على ناصيته .(@)(@@) % ( ش ) .(@)(@@) 26836 - { أيضا الربيع } أتانا النبي صلى الله عليه وسلم فتوضأ ومسح رأسه بما بقي من وضوئه .(@)(@@) % ( ش ) .(@)(@@) 26837 - { أيضا } عن عبد الله بن محمد بن عقيل بن أبي طالب قال : دخلت على الربيع بنت معوذ بن عفراء فقلت : جئت أسألك عن وضوء رسول الله صلى الله عليه وسلم قالت : كان رسول الله صلى الله عليه وسلم يصلنا ويزورنا وكان يتوضأ في هذا الإناء أو في مثل هذا الإناء وهو نحو من مد ، وفي لفظ : يكون مدا أو مدا وربعا ، فكان يبدأ بغسل يديه قبل أن يدخلهما الإناء ويمضمض ثلاثا ، ويستنشق ثلاثا ، ثم يغسل وجهه ثلاثا ، ثم يغسل يديه ثلاثا ثلاثا ، ثم يمسح برأسه مقبلا ومدبرا مرتين ، ويمسح بأذنيه ظاهرهما وباطنهما ، ويغسل قدميه ثلاثا ثلاثا ، ثم قالت : إن ابن عباس قد دخل 
ms3557	 علي يسألني عن هذا الحديث فأخبرته ، فقال : يأبى الناس إلا الغسل ، ونجد في كتاب الله المسح على القدمين .(@)(@@) % ( عب ، ص ، ش ، د ، ت ، ن ، ه ) .(@)(@@) 26838 - { أيضا } عن عبد الله بن محمد بن عقيل قال : دخلت على الربيع ابنة معوذ بن عفراء في نفر فسألناها عن وضوء رسول الله صلى الله عليه وسلم قالت : نعم وضأت رسول الله صلى الله عليه وسلم في إناء نحو من هذا الإناء ، وهي تشير إلى ركوة تأخذ مدا أو ثلاثا ، قالت : فمضمض واستنثر ، ثم غسل وجهه ويديه ثلاثا ثلاثا ، ثم مسح رأسه مقدمه ومؤخره ومسح أذنيه مع مؤخر رأسه وغسل رجليه ثلاثا .(@)(@@) % ( ص ) .(@)(@@) 26839 - عن ابن عباس قال : إن نسي المسح بالرأس أعاد الصلاة .(@)(@@) % ( عب ) .(@)(@@) 26840 - عن ابن عباس قال : الوضوء غسلتان ومسحتان .(@)(@@) % ( عب ) .(@)(@@) 26841 - عن ابن عباس أنه توضأ مرة مرة .(@)(@@) % ( عب ) .(@)(@@) 26842 - عن ابن عباس قال : افترض الله غسلتين ومسحتين ، ألا ترى أنه ذكر التيمم فجعل مكان الغسلتين مسحتين وترك المسحتين .(@)(@@) % ( عب ) .(@)(@@) 26843 - عن نافع أن ابن عمر كان يمسح رأسه مرة .(@)(@@) % ( عب ص ) .(@)(@@) PageV09P188(@)(@@) 26844 - عن نافع أن ابن عمر كان يضع بطن كفه اليمنى على الماء ثم لا ينفضها ، ثم يمسح بها ما بين قرنه إلى الجبين مرة واحدة لا يزيد عليها .(@)(@@) % ( عب ) .(@)(@@) 26845 - عن نافع عن ابن عمر كان يدخل يديه في الوضوء فيمسح بهما مسحة واحدة اليافوخ فقط ، ثم يدخل أصبعيه في الماء ، ثم يدخلهما في أذنيه ، ثم يرد إبهاميه خلف أذنيه .(@)(@@) % ( عب ) .(@)(@@) 26846 - عن نافع أن ابن عمر كان يحدث لرأسه ماء .(@)(@@) % ( عب ) .(@)(@@) 26847 - عن ابن عمر قال : الأذنان من الرأس .(@)(@@) % ( عب ص ) .(@)(@@) 26848 - عن نافع أن ابن عمر كان يغسل ظهور أذنيه وبطونهما إلى الصماخ مع الوجه مرة أو مرتين ، ويدخل أصبعيه بعد ما يمسح برأسه في الماء ثم يدخلهما في الصماخ مرة .(@)(@@) % ( عب ) .(@)(@@) 26849 - عن الحسن أن رسول الله صلى الله عليه وسلم رأى رجلا توضأ وبظهر قدمه قدر ظفر لم يصبه الماء فقال له أحسن 
ms3558	 وضوءك .(@)(@@) % ( ص ش ) .(@)(@@) 26850 - عن قتادة قال : إن ابن مسعود رجع إلى غسل القدمين في قوله وأرجلكم إلى الكعبين .(@)(@@) % ( عب طب ) .(@)(@@) 26851 - عن الشعبي قال : أما جبريل فقد نزل بالمسح على القدمين .(@)(@@) % ( عب ش وعبد بن حميد وابن جرير ) .(@)(@@) 26852 - عن الشعبي قال : نزل القرآن بالمسح وجرت السنة بالغسل .(@)(@@) % ( عبد الرحمن بن حميد والنحاس في تاريخه ) .(@)(@@) 26853 - عن عطاء أن النبي صلى الله عليه وسلم كان في سفر فأخر العمامة ومسح هكذا وأشار شقيق إلى مقدم رأسه إلى وجهه .(@)(@@) % ( ص ) .(@)(@@) 26854 - عن عطاء قال : ألقى النبي صلى الله عليه وسلم عمامته بين كتفيه بين مكة والمدينة ومسح برأسه مسحة واحدة وقال بيده على هامته فمسحها إلى مقدم وجهه .(@)(@@) % ( ص ) .(@)(@@) 26855 - عن يحيى بن أبي كثير أن رسول الله صلى الله عليه وسلم نظر إلى رجل في رجله كموضع الدرهم لم يصبه الماء ، فقال له رسول الله صلى الله عليه وسلم : انطلق فأحسن وضوءك .(@)(@@) % ( ص ) .(@)(@@) 26856 - { مسند علي } عن الهزال بن سبرة أنه رأى عليا بال وهو قائم ثم دعا بماء فتوضأ ، ثم مسح على نعليه وقدميه ، ثم دخل المسجد فخلع نعليه ثم صلى .(@)(@@) % ( ص ) . { آداب الوضوء }(@)(@@) 26857 - { مسند الصديق } عن معمر بن يحيى بن أبي كثير أن أبا بكر كان يخلل أصابعه إذا توضأ .(@)(@@) % ( عب ) .(@)(@@) PageV09P189(@)(@@) 26858 - عن أبي بكر قال : إذا توضأ العبد فذكر اسم الله طهر جسده كله ، وإن لم يذكر لم يطهر إلا ما أصابه الماء .(@)(@@) % ( ش ) .(@)(@@) 26859 - عن أبي بكر الصديق قال : لتخللن أصابعكم بالماء أو ليخللها الله بالنار .(@)(@@) % ( ش ) .(@)(@@) 26860 - عن الصنابحي أن أبا بكر الصديق رأى رجلا يتوضأ ، فقال : عليك بالمغفلة والمنشلة ( المغفلة العنفقة يريد الاحتياط في غسلها في الوضوء سميت مغفلة لأن كثيرا من الناس يغفل عنها . النهاية [ 3 / 186 ] .(@)(@@) المنشلة : موضع الخاتم من الخنصر سميت بذلك لأنه أراد غسله نشل الخاتم أي اقتلعه ثم غسله . النهاية [ 4 / 155 ] ب ) .(@)(@@) % ( ابن قتيبة في غريب الحديث والدينوري في المجالسة ، قال ابن قتيبة : المغفلة العنفقة والمنشلة 
ms3559	 موضع الخاتم من الخنصر ) .(@)(@@) 26861 - عن عاصم بن ضمرة قال : رأيت عليا أمير المؤمنين يأخذ ماء لطهوره فبادرته إليه فقال : مه فإني رأيت عمر بن الخطاب يأخذ ماء لطهوره فبادرته إليه ، فقال : مه فإني رأيت أبا بكر الصديق يأخذ ماء لطهوره فبادرته إليه ، فقال : مه إني رأيت رسول الله صلى الله عليه وسلم يأخذ ماء لطهوره فبادرته إليه : فقال : يا أبا بكر إني لا أحب أن يعينني أحد على طهوري .(@)(@@) % ( أبو القاسم الغافقي في جزء المذكور ما اجتمع في سنده أربعة من الصحابة وفيه أحمد بن محمد بن اليمامي كذاب ) .(@)(@@) 26862 - { مسند عمر } عن عمر أنه توضأ فمسح بأذنيه ظاهرهما وباطنهما وقال : رأيت النبي صلى الله عليه وسلم يفعله .(@)(@@) % ( عب ) .(@)(@@) 26863 - عن حمران قال : دعا عثمان بماء فتوضأ ثم ضحك فقال : ألا تسألوني مم أضحك ؟ قالوا : يا أمير المؤمنين ما أضحكك ؟ قال : رأيت رسول الله صلى الله عليه وسلم توضأ كما توضأت فمضمض واستنشق وغسل وجهه ثلاثا ويديه ثلاثا ومسح برأسه وظهر قدميه .(@)(@@) % ( ش ) .(@)(@@) 26864 - عن عطاء أنه بلغه أن عثمان توضأ ثلاثا ومسح برأسه مسحة وغسل برجليه غسلا ، ثم قال : هكذا رأيت رسول الله صلى الله عليه وسلم توضأ .(@)(@@) % ( عب ش ) .(@)(@@) 26865 - عن رجل من الأنصار أن رجلا قال : ألا أريكم كيف كان وضوء رسول الله صلى الله عليه وسلم ؟ قالوا : بلى فدعا بماء فمضمض ثلاثا ، واستنشق ثلاثا ، وغسل وجهه ثلاثا ، وذراعيه ثلاثا ، ومسح برأسه وغسل قدميه ، ثم قال : واعلموا أن الأذنين من الرأس ، ثم قال : تحريت أو توخيت لكم وضوء رسول الله صلى الله عليه وسلم .(@)(@@) % ( ش والعدني ، خط ) .(@)(@@) 26866 - عن أبي وائل قال : رأيت عثمان يتوضأ فخلل لحيته ثلاثا وقال : رأيت رسول الله صلى الله عليه وسلم فعله .(@)(@@) % ( عب ش والبغوي ) .(@)(@@) 26867 - { في مسند عثمان } رأيت رسول الله صلى الله عليه وسلم توضأ فمسح رأسه مرة .(@)(@@) % ( ش ه ) .(@)(@@) PageV09P190(@)(@@) 26868 - عن سفيان بن سلمة قال : شهدت عثمان توضأ ثلاثا ثلاثا وأفرد المضمضة من الاستنشاق ثلاثا ثم قال : هكذا 
ms3560	 توضأ النبي صلى الله عليه وسلم .(@)(@@) % ( البغوي في مسند عثمان كر ) .(@)(@@) 26869 - عن أبي وائل قال : رأيت عثمان يغسل كفيه ثلاثا ، ومضمض واستنشق ثلاثا وخلل أصابعه وخلل لحيته حين غسل وجهه قبل أن يغسل قدميه ، ثم قال : رأيت رسول الله صلى الله عليه وسلم يفعل كالذي رأيتموني فعلت .(@)(@@) % ( عب وابن منيع والدارمي د وابن خزيمة وابن الجارود والطحاوي حب والبغوي في مسند عثمان ص ولفظ البغوي وخال أصابعه ثلاثا وخلل لحيته ثلاثا ) .(@)(@@) 26870 - عن حمران قال : رأيت عثمان توضأ فأفرغ على يديه ثلاثا فغسلهما ، ثم مضمض ثلاثا واستنثر ثلاثا ، ثم غسل وجهه ثلاثا ، ثم غسل يده اليمنى إلى المرفق ثلاثا ، ثم غسل اليسرى مثل ذلك ثم مسح رأسه ، ثم غسل قدميه اليمنى ثلاثا ، ثم اليسرى ثلاثا ، ثم قال رأيت رسول الله صلى الله عليه وسلم يتوضأ من نحو وضوئي هذا ثم قال : من توضأ نحو وضوئي هذا وفي لفظ : مثل وضوئي هذا ثم صلى ركعتين لا يحدث فيهما نفسه غفر له ما تقدم من ذنبه .(@)(@@) % ( حب قط والعدني حم وابن خزيمة خ م د ن ) ( أخرجه مسلم كتاب الطهارة باب صفة الوضوء وكماله رقم ( 226 ) ص ) .(@)(@@) 26871 - عن ابن دارة قال : رأيت عثمان دعا بوضوء فتمضمض ثلاثا واستنشق ثلاثا وغسل وجهه ثلاثا وذراعيه ثلاثا ومسح برأسه ثلاثا وغسل قدميه ثلاثا ثلاثا ثم قال : من أحب أن ينظر إلى وضوء رسول الله صلى الله عليه وسلم فهذا وضوء رسول الله صلى الله عليه وسلم .(@)(@@) % ( حم قط ص ) .(@)(@@) 26872 - عن حمران قال : كنت عند عثمان فدعا بوضوء فتوضأ فلما فرغ قال ، توضأ رسول الله صلى الله عليه وسلم كما توضأت ثم تبسم فقال : أتدرون مم ضحكت ؟ قلنا الله ورسوله أعلم قال : إن العبد المسلم إذا توضأ فأتم وضوءه ثم دخل في صلاته فأتم صلاته خرج من الذنوب كما خرج من بطن أمه .(@)(@@) % ( الحارث وأبو نعيم في المعرفة وهو صحيح ) .(@)(@@) 26873 - عن عثمان أن النبي صلى الله عليه وسلم كان يخلل لحيته .(@)(@@) % ( ت 