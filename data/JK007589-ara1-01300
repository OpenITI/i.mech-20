ms1289	 معاون جمة ومعادنا % % 164(@)(@@) % وأثيب سعيك للإمام فلم تزل % % لثغوره بجنود رأيك شاحنا % % 165(@)(@@) % ما كانت العزاء تزحم منكم % % إلا جبالا لا تزول ركائنا % % 166(@)(@@) % ماكانت الللأواء تلقى منكم % % إلا مضابر نوبة ومماتنا % % 167(@)(@@) % لهفي أبا العباس لهفة آمل % كان ارتجاك على الزمان معاونا % % 168(@)(@@) % ولساسة الدنيا أحق بلهفتي % % مني وأولى بالغليل جناجنا % % 169(@)(@@) % لهفي عليك لخطة مرهوبة % ما كنت فيها بالذميم مواطنا % % 170(@)(@@) % لهفي عليم لها إذا أزماتها % % ضاقت على الزول الرحيب معاطنا % % PageV01P4887 171(@)(@@) % كم من أعاد قد رقيت فلم تدع % فيهم رقاك الشافيات مداهنا % % 172(@)(@@) % أطفأت نارهم وكن نوائرا % وأبحت حقدهم وكان دواجنا % % 173(@)(@@) % متألفا لهم تألف حول % لو شاء سير بالقفار سفائنا % % 174(@)(@@) % متلطفا لهم تلطف قلب % لو شاء شاد على البحار مدائنا % % 175(@)(@@) % ماكان سعيك للخلائف كلها % % إلا معاقل تارة ومعادنا % % 176(@)(@@) % إن نابهم خطب درأت وإن بغوا % % مالا ملأت خزائنا وخزائنا % % 177(@)(@@) % كم قد فتحت لهم عدوا جامحا % كم قد حرثت لهم خراجا حارنا % % 178(@)(@@) % أنشرت آراء وكن هوامدا % وأثرت أموالا وكن دفائنا % % 179(@)(@@) % كانت فتوحك كلها ميمونة % تأتي وليست للحتوف قرائنا % % 180(@)(@@) % بالخيل لكن لاتزال صوافنا % والبيض لكن لاتزال كوامنا % % PageV01P4888 181(@)(@@) % عجبا لفتحك بالسيوف كوامنا % تلك الفتوح وبالجياد صوافناص ولع الزمان بأن يحرك ساكنا % 182(@)(@@) % وبأن يثير من الأوابد كامنا % % وهم الأحبة من أقام ترحلوا % % 183(@)(@@) % عنه فكلهم يودع ظاعنا % % أضحى الزمان مدائنا لك فيهم % 184(@)(@@) % ولعل رشدا إن قضيت مدائنا % % فأرى الليالي ما نقضن معاهدا % 185(@)(@@) % فيما أتين ولا هجمن مآمنا % % رحلن إلفك عن مساكن قلعة % 186(@)(@@) % كانت لقوم آخرين مساكنا % % فاقن الحياء أبا الحسين فلم يكن % % 187(@)(@@) % شيء فري لم تخله كائنا % % كان الذي قد كنت توقن أنه % % 188(@)(@@) % سيكون فاجزع واقنا لا واهنا % % هون عليك المقطعات ولا تكن % % 189(@)(@@) % بنصيحة من مخلص متهاونا % % إن الحوادث قد عدون فواجعا % 190(@)(@@) % فاشدد إزارك لا يكن فواتنا % % لا تنكرن من المصائب منا أتى % % PageV01P4889 191(@)(@@) % حتى كأنك كنت منها آمنا % % أنكره إنكار امرىء عرف الردى 
