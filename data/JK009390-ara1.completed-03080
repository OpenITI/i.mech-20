ms3066	 ( يسلم الصغير علاى الكبير ، والمار علاى القاعد ، والقليل علاى الكثير ) )(@)(@@) . ( خ ، د ، ت ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@) PageV09P292(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28533 قال النبي :(@)(@@) | 30 ( يسألني أحدكم عن خبر السماء ويدع أظفاره كأظفار الطير يجتمع فيها الخباثة والتفث ) )(@)(@@) . ( ط ، عن أبي أيوب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28534 قال النبي :(@)(@@) | 30 ( يسبق المقتول في سبيل الله مقبلا غير مدبر المقتول المدبر إلاى الجنة سبعين خريفا ، ومرضاى أمتي قبل أصحابهم سبعين خريفا ، والأنبياء قبل سليمان بن داود بأربعين خريفا لما كان فيه من الملك ) )(@)(@@) . ( طب ، عن ابن عباس رضي الله عنهما وضعف ) .(@)(@@)(@@)(@@) $ 28535 قال النبي :(@)(@@) | 30 ( يستاك الصائم برطب السواك ويابسه أول النهار وآخره ) )(@)(@@) . ( قط ، وضعفه عق ، وقال غير محفوظ عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28536 قال النبي :(@)(@@) | 30 ( يستأني بالجراحات سنة ) )(@)(@@) . ( قط ، وضعفه والخطيب عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28537 قال النبي :(@)(@@) | 30 ( يستر المصلي من الدواب مثل مؤخرة الرحل بين يديه ) )(@)(@@) . ( عبد الرزاق عن موساى بن طلحة مرسلا ) .(@)(@@)(@@)(@@) $ 28538 قال النبي :(@)(@@) | 30 ( يستوقد المسلمون من جعابهم وقسيهم وأترستهم ونشابهم سبع سنين يعني يأجوج ومأجوج ) )(@)(@@) . ( طب ، عن النواس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28539 قال النبي :(@)(@@) | 30 ( يسح الله عز وجل الخير في أربع ليال سحا : ليلة الأضحى والفطر ، وليلة النصف من شعبان ينسخ فيها الآجال والأرزاق ويكتب فيها الحج ، وفي ليلة عرفة إلاى الأذان ) )(@)(@@) . ( الديلمي عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28540 قال النبي :(@)(@@) | 30 ( يسري علاى كتاب الله تعالاى ليلا فيصبح الناس ليس منه آية ولا حرف في جوف مسلم إلا نسخت ) )(@)(@@) . ( الديلمي عن حذيفة وأبي هريرة رضي الله عنهما معا ) .(@)(@@) PageV09P293(@)(@@)(@@)(@@) $ 28541 قال النبي :(@)(@@) | 30 ( يسرا ولا تعسرا ، وبشرا ولا تنفرا ، وتطاوعا ولا تختلفا ) )(@)(@@) . ( حم ، خ ، م ، عن سعيد بن أبي بردة عن أبيه عن جده ) .(@)(@@)(@@)(@@) $ 28542 قال النبي :(@)(@@) | 30 ( يسروا ولا تعسروا ، وبشروا ولا تنفروا ، وإذا غضبت فاسكت ) )(@)(@@) . ( ط ، طب ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28543 قال النبي :(@)(@@) | 30 ( يسلط الجرب علاى أهل النار فيحكون حتى تبدو عظامهم 
ms3067	 فيقولون : بم سلط علينا ذالك ؟ فيقال : بإيذائكم أهل الايمان ) )(@)(@@) . ( الديلمي عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28544 قال النبي :(@)(@@) | 30 ( يسلط علاى الكافر في قبره تسعة وتسعون تنينا ينهشه ويلدغه حتى تقوم الساعة ، ولو أن تنينا منها نفخ في الأرض ما أنبتت خضراء ) )(@)(@@) . ( حم ، وعبد بن حميد والدارمي ، ع ، ض ، حب ، عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28545 قال النبي :(@)(@@) | 30 ( يسلم الصغير علاى الكبير ، ويسلم الواحد علاى الاثنين ، ويسلم القليل علاى الكثير ، ويسلم الراكب علاى الماشي ، ويسلم المار علاى القائم ، ويسلم القائم علاى القاعد ) )(@)(@@) . ( ابن السني عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28546 قال النبي :(@)(@@) | 30 ( يسلم الراكب علاى الماشي ، والماشي علاى القاعد ، والماشيان جميعا أيهما ابتدأ بالسلام فهو أفضل ) )(@)(@@) . ( ابن السني والشاشي وأبو عوانة ، حب ، ض ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28547 قال النبي :(@)(@@) | 30 ( يسلم الراكب علاى الراجل ، والراجل علاى الجالس ، والأقل علاى الأكثر ، فمن أجاب السلام كان له ، ومن لم يجب فلا شيء له ) )(@)(@@) . ( طب ، عن عبد الرحمان بن شبل رضي الله عنه ) .(@)(@@) PageV09P294(@)(@@)(@@)(@@) $ 28548 قال النبي :(@)(@@) | 30 ( يسلم الراكب علاى الراجل ، ويسلم الراجل علاى القاعد ، ويسلم الأقل علاى الأكثر ، فمن أجاب السلام فهو له ، ومن لم يجب السلام فليس منا ) )(@)(@@) . ( ابن السني في عمل يوم وليلة عن عبد الرحمان بن شبل رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28549 قال النبي :(@)(@@) | 30 ( يسلم الرجال علاى النساء ، ولا يسلم النساء علاى الرجال ) )(@)(@@) . ( ابن السني عن واثلة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28550 قال النبي :(@)(@@) | 30 ( يسير الفقه خير من كثير العبادة ، وخير أعمالكم أيسرها ) )(@)(@@) . ( طب ، عن عبد الرحمان بن عوف رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28551 قال النبي :(@)(@@) | 30 ( يسير الراكب في ظل الفنن منها مائة سنة فيها فراش الذهب كأن ثمرها القلال يعني سدرة المنتهاى ) )(@)(@@) . ( ت ، حسن صحيح ، طب ، ك ، عن أسماء بنت أبي بكر رضي الله عنهما ) .(@)(@@)(@@)(@@) ||| ( الياء مع الشين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28552 قال النبي :(@)(@@) | 30 ( يشرب ناس من أمتي الخمر باسم يسمونها إياه ) )(@)(@@) . ( ه ، عن عبادة بن الصامت رضي الله عنه ، ز 
ms3068	 ) .(@)(@@)(@@)(@@) $ 28553 قال النبي :(@)(@@) | 30 ( يشرب ناس من أمتي الخمر يسمونها بغير اسمها ) )(@)(@@) . ( ن ، عن رجل ز ) .(@)(@@)(@@)(@@) $ 28554 قال النبي :(@)(@@) | 30 ( يشفع الشهيد في سبعين من أهل بيته ) )(@)(@@) . ( د ، عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28555 قال النبي :(@)(@@) | 30 ( يشفع يوم القيامة ثلاثة : الأنبياء ، ثم العلماء ، ثم الشهداء ) )(@)(@@) . ( ه ، عن عثمان رضي الله عنه ) .(@)(@@) PageV09P295(@)(@@)(@@)(@@) $ 28556 قال النبي :(@)(@@) | 30 ( يشمت العاطس ثلاثا ، فإن زاد ، فإن شئت فشمته ، وإن شئت فكف ) )(@)(@@) . ( د ، ن ، عن عبيد بن رفاعة الزرقي مرسلا ، ز ) .(@)(@@)(@@)(@@) $ 28557 قال النبي :(@)(@@) | 30 ( يشمت العاطس ثلاثا ، فما زاد فهو مزكوم ) )(@)(@@) . ( ه ، عن سلمة بن الأكوع رضي الله عنه ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28558 قال النبي :(@)(@@) | 30 ( يشبه ريحان الجنة ) )(@)(@@) . ( طب ، عن ابن عباس رضي الله عنهما قال : أتي النبي بورد الحناء قال فذكره ) .(@)(@@)(@@)(@@) $ 28559 قال النبي :(@)(@@) | 30 ( يشمت العاطس إذا عطس ثلاث مرات ، فإن عطس فهو زكام ) )(@)(@@) . ( ابن السني عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28560 قال النبي :(@)(@@) | 30 ( يشهده ملائكة الليل وملائكة النهار ) )(@)(@@) . ( ت ، حسن صحيح عن أبي هريرة رضي الله عنه في قوله عز وجل : { إن قرآن الفجر كان مشهودا } .(@)(@@)(@@)(@@) ||| ( الياء مع الصاد(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28561 قال النبي :(@)(@@) | 30 ( يصاح برجل من أمتي يوم القيامة علاى رؤوس الخلائق فينشر له تسعة وتسعون سجلا ، كل سجل مد البصر ، ثم يقول الله تبارك PageV09P296 وتعالاى : هل تنكر من هاذا شيئا ؟ فيقول : لا يا رب ، فيقول : أظلمك كتبتي الحافظون ؟ فيقول : لا يا رب ، ثم يقول : ألك عذر ، ألك حسنة ؟ فيهاب الرجل فيقول : لا ، فيقول : بلاى إن لك عندنا حسنة وإنه لا ظلم عليك اليوم ، فتخرج له بطاقة فيها : أشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، فيقول : يا رب ما هاذه البطاقة مع هاذه السجلات ؟ فيقول : إنك لا تظلم ، فتوضع السجلات في كفة والبطاقة في كفة ، فطاشت السجلات وثقلت البطاقة ) )(@)(@@) . ( ه ، ك ، عن ابن عمرو رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28562 قال النبي :(@)(@@) | 30 ( يصبح علاى كل سلامي من ابن آدم 
ms3069	 صدقة : تسليمه علاى من لقي صدقة ، وأمره بالمعروف صدقة ، ونهيه عن المنكر صدقة ، وإماطة الأذاى عن الطريق صدقة ، وبضعه أهله صدقة ، ويجزي من ذالك كله ركعتان من الضحاى ، قالوا : يا رسول الله أحدنا يقضي شهوته وتكون له صدقة ، قال : أرأيت لو وضعها في غير حلها ألم يكن يأثم ) )(@)(@@) . ( د ، عن أبي ذر رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28563 قال النبي :(@)(@@) | 30 ( يصبح علاى كل سلاماى من أحدكم صدقة ، فكل تسبيحة صدقة ، وكل تحميدة صدقة وكل تهليلة صدقة ، وكل تكبيرة صدقة ، وأمر بالمعروف صدقة ، ونهي عن المنكر صدقة ، ويجزي من ذالك ركعتان تركعهما من الضحاى ) )(@)(@@) . ( م ، ن ، عن أبي ذر رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28564 قال النبي :(@)(@@) | 30 ( يصبح علاى كل سلاماى من أحدكم في كل يوم صدقة : فله بكل صلاة صدقة ، وصيام صدقة ، وحج صدقة ، وتسبيح صدقة ، وتكبير صدقة ، وتحميد صدقة ، ويجزي أحدكم من ذالك ركعتا الضحاى ) )(@)(@@) . ( د ، عن أبي ذر رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28565 قال النبي :(@)(@@) | 30 ( يصف الناس يوم القيامة صفوفا ، فيمر الرجل من أهل النار علاى الرجل من أهل الجنة فيقول : يا فلان أما تذكر يوم استسقيت فسقيتك شربة فيشفع له ، ويمر الرجل علاى الرجل فيقول : أما تذكر يوم ناولتك PageV09P297 طهورا ؟ فيشفع له ، ويقول : يا فلان أما تذكر يوم بعثتني في حاجة كذا وكذا فذهبت لك ؟ فيشفع له ) )(@)(@@) . ( ه ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28566 قال النبي :(@)(@@) | 30 ( يصلون لكم ، فإن أصابوا فلكم ، وإن أخطؤوا فلكم وعليهم ) )(@)(@@) . ( خ ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28567 قال النبي :(@)(@@) | 30 ( يصبح الناس مجدبين ، فيأتيهم الله برزق من عنده فيصبحون مشركين ويقولون : مطرنا بنوء كذا وكذا ) )(@)(@@) . ( ابن جرير ، طب ، عن معاوية الليثي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28568 قال النبي :(@)(@@) | 30 ( يصب علاى بول الغلام الماء ويغسل بول الجارية ) )(@)(@@) . ( طب ، عن أنس ، ع ، عن أم سلمة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28569 قال النبي :(@)(@@) | 30 ( يصلي إذا ذكر ) )(@)(@@) . ( طس ، عن أبي سعيد رضي الله عنه في الذي نسي 
ms3070	 الصلاة ) .(@)(@@)(@@)(@@) $ 28570 قال النبي :(@)(@@) | 30 ( يصلى علاى من مات من أهل القبلة ) )(@)(@@) . ( خ ، في تاريخه عن علي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28571 قال النبي :(@)(@@) | 30 ( يصلى في مرابض الغنم ولا يصلى في أعطان الإبل ) )(@)(@@) . ( عبد الرزاق عن معمر عن الحسن وقتادة رضي الله عنهما مرسلا ) .(@)(@@)(@@)(@@) $ 28572 قال النبي :(@)(@@) | 30 ( يصلي المريض قائما إن استطاع ، فإن لم يستطع صلى قاعدا ، فإن لم يستطع أن يسجد أومأ وجعل سجوده أخفض من ركوعه ، فإن لم يستطع أن يصلي قاعدا صلى علاى جنبه الأيمن مستقبل القبلة ، فإن لم يستطع أن يصلي علاى جنبه الأيمن صلى مستلقيا ، رجله مما يلي القبلة ) )(@)(@@) . ( هق ، عن الحسين بن علي رضي الله عنهما ) .(@)(@@) PageV09P298 |(@)(@@)(@@)(@@) $ 28573 - قال النبي صلى الله عليه وسلم : ' يصيح صائح يوم القيامة : أين الذين أكرموا الفقراء | والمساكين في الدنيا ادخلوا الجنة لا خوف عليكم ولا أنتم تحزنون ، ويصيح صائح | يوم القيامة : أين الذين عادوا مرضى الفقراء والمساكين في الدنيا ؟ فيجلسون على | منابر من نور يحدثون الله والناس في شدة الحساب ' . ( ابن عساكر عن عمر | الشيرازي في الألقاب ، والرافعي عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) ||| ( الياء مع الضاد )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28574 - قال النبي صلى الله عليه وسلم : ' يضحك الله إلى رجلين يقتل أحدهما الآخر يدخلان | الجنة ، يقاتل هذا في سبيل الله فيقتل ، ثم يتوب الله على القاتل فيسلم فيقاتل في | سبيل الله تعالى فيستشهد ' . ( حم ، ق ، ن ، ه ، عن أبي هريرة رضي الله | عنه ، ز )(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28575 - قال النبي صلى الله عليه وسلم : ' يضحك الله إلى ثلاثة : القوم إذا صفوا في | الصلاة ، وإلى الرجل يقاتل وراء أصحابه ، وإلى الرجل يقوم في سواد الليل ' . | ( ش ، وابن جرير عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28576 - قال النبي صلى الله عليه وسلم : ' يضغط المؤمن فيه - يعني القبر - ضغطة تزول منها | حمائله ، ويملأ على الكافر نارا ' . ( حم ، والحكيم عن حذيفة رضي الله عنه وأورده | ابن الجوزي في الموضوعات ورد عليه ابن حجر في القول المسدد ) . | PageV09P299 |(@)(@@)(@@)(@@) $ 28577 - قال النبي 
ms3071	 صلى الله عليه وسلم : ' يضمن المقدم على الدابة ثلثي ما أصابت وهو | راكب ، ويضمن الرديف الثلث ' . ( ابن عساكر عن واثلة رضي الله عنه ) . |(@)(@@)(@@)(@@) ||| ( الياء مع الطاء )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )1(@)(@@)(@@)(@@) $ 28578 - قال النبي صلى الله عليه وسلم : ' يطبع المؤمن على كل خلق ليس الخيانة | والكذب ' . ( هب ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28579 - قال النبي صلى الله عليه وسلم : ' يطوي الله السموات يوم القيامة ثم يأخذهن بيده | اليمنى ثم يقول : أنا الملك ، أين الجبارون ، أين المتكبرون ؟ ثم يطوي الأرضين ، | ثم يأخذهن بشماله ثم يقول : أنا الملك ، أين الجبارون ، أين المتكبرون ' . ( م ، | د ، عن ابن عمر رضي الله عنهما ، ز ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28580 - قال النبي صلى الله عليه وسلم : ' يطبع المؤمن على كل خلة غير الخيانة والكذب ' . | ( بز ، عن سعد رضي الله عنه وحسن ) . |(@)(@@)(@@)(@@) $ 28581 - قال النبي صلى الله عليه وسلم : ' يطبع المؤمن على الخلال كلها إلا الخيانة | والكذب ' . ( حم ، عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28582 - قال النبي صلى الله عليه وسلم : ' يطبع المؤمن على كل شيء إلا الخيانة والكذب ' . | ( قط ، عد ، هق ، عن سعد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28583 - قال النبي صلى الله عليه وسلم : ' يطلع الله عز وجل إلى خلقه في ليلة النصف من | PageV09P300 | شعبان فيغفر لجميع خلقه إلا لمشرك أو مشاحن ' . ( حب ، طب ، وابن شاهين في | الترغيب ، هب ، وابن عساكر عن معاذ رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28584 - قال النبي صلى الله عليه وسلم : ' يطلع الله تعالى على خلقه ليلة النصف من شعبان | فيغفر لعباده إلا اثنين : مشاحن أو قاتل نفس ' . ( حم ، بز ز ، عن ابن عمرو رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 28585 - قال النبي صلى الله عليه وسلم : ' يطبع المؤمن على كل خلق ليس الخيانة | والكذب ' . ( طب ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28586 - قال النبي صلى الله عليه وسلم : ' يطلع عليكم قبل الساعة سحابة من الغرب مثل | الترس ، فما تزال ترتفع في السماء وتنتشر حتى تملأ السماء ، ثم ينادي مناد : يا أيها | الناس ! أتى أمر الله فلا 
ms3072	 تستعجلوه ، فوالذي نفسي بيده إن الرجلين لينشران الثوب | فما يطويانه ، وإن الرجل ليمدر حوضه فما يسقي منه شيئا أبدا ، والرجل ليحتلب | ناقته فما يشرب منه أبدا ' . ( طب عن عقبة بن عامر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28587 - قال النبي صلى الله عليه وسلم : ' يطهر المؤمن ثلاثة أحجار ، والماء أطهر ' . | ( طب ، عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28588 - قال النبي صلى الله عليه وسلم : ' يطهره ما بعده ' . ( مالك ، طب ، عن أم | سلمة رضي الله عنها أن امرأة قالت يا رسول الله : إني أطيل زيلي وأمشي في المكان | القذر قال فذكره ) . |(@)(@@)(@@)(@@) $ 28589 - قال النبي صلى الله عليه وسلم : ' يطعم عنه لكل يوم مسكين ' . ( هق ، عن ابن | عمر رضي الله عنهما قال : سئل النبي صلى الله عليه وسلم عن رجل مات وعليه صوم شهر ؟ قال : | فذكره ) . | PageV09P301 |(@)(@@)(@@)(@@) $ 28590 - قال النبي صلى الله عليه وسلم : ' يطعم لكل يوم نصف صاع من بر ' . ( هق ، عن | ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) ||| ( الياء مع الظاء )(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28591 - قال النبي صلى الله عليه وسلم : ' يظل أحدكم يضرب امرأته ضرب العبد ثم يظل | يعانقها ولا يستحيي ' . ( ابن سعد عن أبي أيوب رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28592 - قال النبي صلى الله عليه وسلم : ' يظهر المسلمون على جزيرة العرب ، ويظهر | المسلمون على فارس ، ويظهر المسلمون على الروم ويظهر المسلمون على الأعور | الدجال ' . ( الحاكم في الكنى ، ك ، عن هاشم بن عتبة بن أبي وقاص رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28593 - قال النبي صلى الله عليه وسلم : ' يظهر هذا الدين حتى يجاوز البحار ، وحتى يخاض | بالخيل في سبيل الله ، ثم يأتي قوم يقرأون القرآن يقولون : قد قرأنا القرآن فمن أقرأ | منا ؟ ومن أفقه منا ؟ ومن أعلم منا ؟ هل في أولئك من خير ؟ فأولئك منكم ، وأولئك | من هذه الأمة ، وأولئك هم وقود النار ' . ( ابن المبارك ، طب ، عن العباس بن | عبد المطلب رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28594 - قال النبي صلى الله عليه وسلم : ' يظهر في آخر الزمان قوم يسمون الرافضة ، يرفضون | الإسلام ' . ( عم ، عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28595 
ms3073	 - قال النبي صلى الله عليه وسلم : ' يظهر الإسلام حتى يختلف التجار في البحر ، وحتى | تخوض الخيل في سبيل الله ، ثم يظهر قوم يقرأون القرآن يقولون : من أقرأ منا ؟ من | أعلم منا ؟ من أفقه منا ؟ هل في أولئك من خير ؟ أولئك منكم من هذه الأمة وأولئك | هم وقود النار ' . ( طس ، عن عمر رضي الله عنه ) | PageV09P302 |(@)(@@)(@@)(@@) ||| ( الياء مع العين )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28596 - قال النبي صلى الله عليه وسلم : ' يعجب ربك من راعي غنم في رأس شظية بجبل | يؤذن للصلاة ويصلي ، فيقول الله عز وجل انظروا إلى عبدي هذا يؤذن ويقيم للصلاة | يخاف مني ، قد غفرت لعبدي وأدخلته الجنة ' . ( حم ، د ، ن ، عن عقبة بن | عامر رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28597 - قال النبي صلى الله عليه وسلم : ' يعذب ناس من أهل التوحيد فيطرحون في النار حتى | يكونوا فيها حمما ثم تدركهم الرحمة فيخرجون ويطرحون على أبواب الجنة فيرش | عليهم أهل الجنة الماء فينبتون كما ينبت الغثاء في حمالة السيل ، ثم يدخلون | الجنة ' . ( حم ، ت ، عن جابر رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28598 - قال النبي صلى الله عليه وسلم : ' يعرض الناس يوم القيامة ثلاث عرضات : فأما | عرضتان فجدال ومعاذير ، وأما الثالثة فعند ذلك تطير الصحف في الأيدي ، فآخذ | بيمينه وآخذ بشماله ' . ( ت ، عن أبي هريرة ، حم ، ه ، عن أبي موسى رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28599 - قال النبي صلى الله عليه وسلم : ' يعرق الناس يوم القيامة حتى يذهب عرقهم في | الأرض سبعين ذراعا ، ويلجمهم حتى يبلغ آذانهم ' . ( خ ، عن أبي هريرة رضي | الله عنه ، ز ) . | PageV09P303 |(@)(@@)(@@)(@@) $ 28600 - قال النبي صلى الله عليه وسلم : ' يعض أحدكم أخاه كما يعض الفحل لا دية له ' . | ( حم ، ق ، ت ، ن ، ه ، عن عمران بن حصين ، ن ، عن يعلى بن منية وأخيه | مسلمة رضي الله عنهم ، ز ) . |(@)(@@)(@@)(@@) $ 28601 - قال النبي صلى الله عليه وسلم : ' يعطى المؤمن في الجنة قوة مائة في النساء ' . | ( ت ، حب ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28602 - قال النبي صلى الله عليه وسلم : ' يعقد الشيطان على قافية 
ms3074	 رأس أحدكم إذا هو نام | ثلاث عقد ، يضرب مكان كل عقدة عليك ليل طويل فارقد ، فإن استيقظ فذكر الله | انحلت عقدة ، فإن توضأ انحلت عقدة ، فإن صلى انحلت عقده كلها فأصبح نشيطا | طيب النفس ، وإلا أصبح خبيث النفس كسلان ' . ( حم ، ق ، د ، ن ، ه ، عن | أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28603 - قال النبي صلى الله عليه وسلم : ' يعق عن الغلام ولا يمس رأسه بدم ' . ( ه ، عن | يزيد بن عبد المزني رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28604 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم إلى جمرة من نار فيجعلها في يده ' . | ( م ، عن ابن عباس رضي الله عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28605 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم فيبرك في صلاته كما يبرك الجمل ' . | ( 3 عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28606 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم فيجلد امرأته جلد العبد ولعله يضاجعها | من آخر يومه ' . ( حم ، ق ، ت ، ه ، عن عبد الله بن زمعة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28607 - قال النبي صلى الله عليه وسلم : ' يعمد الشيطان إلى أحدكم فيتهول له ثم يغدو يخبر | الناس ' . ( ه ، عن أبي هريرة رضي الله عنه ، ز ) . | PageV09P304 |(@)(@@)(@@)(@@) $ 28608 - قال النبي صلى الله عليه وسلم : ' يعوذ عائذ بالبيت فيبعث إليه بعث ، فإذا كانوا ببيداء | من الأرض خسف بهم ، قيل يا رسول الله ! فكيف بمن كان كارها ؟ قال : يخسف | به معهم ولكنه يبعث يوم القيامة على نيته ' . ( حم ، م ، عن أم سلمة رضي الله | عنها ، ز ) . |(@)(@@)(@@)(@@) |||| ( من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28609 - قال النبي صلى الله عليه وسلم : ' يعاد الوضوء من سبع أقطار : البول ، والدم | السائل ، والقيء ، ومن دسعة يملأ بها الفم ، والنوم المضطجع وقهقهة الرجل | في الصلاة ، ومن خروج الدم ' . ( هق ، وضعفه عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28610 - قال النبي صلى الله عليه وسلم : ' يعتري المرء عند أربع خصال : إذا نام وحده ، | وإذا نام مستلقيا ، وإذا نام في ملحفة معصفرة ، وإذا اغتسل بفضاء من الأرض ، فمن | استطاع أن لا يغتسل 
ms3075	 بفضاء من الأرض فليفعل ، فإن كان لا بد فاعلا فليخط خطا ' . | ( طس ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28611 - قال النبي صلى الله عليه وسلم : ' يعتذر الله إلى آدم يوم القيامة ثلاث معاذير : يقول | الله تعالى : يا آدم ! لولا أني لعنت الكذابين وأبغضت الخلف والكذب وأوعدت عليه | لرحمت اليوم ذريتك أجمعين من شدة ما أعددت لهم من العذاب ، ولكن حق القول | مني لئن كذبت رسلي وعصي أمري لأملأن جهنم من الجنة والناس أجمعين ، ويقول | الله تعالى : يا آدم ! اعلم أني لا أدخل من ذريتك النار أحدا ، ولا أعذب منهم بالنار | أحدا إلا من قد علمت بعلمي أني لو رددته إلى الدنيا لعاد إلى شر ما كان فيه ولم يرجع | ولم يعتب ، ويقول الله تعالى : يا آدم ! قد جعلتك حكما بيني وبين ذريتك ، قم عند | PageV09P305 | الميزان وانظر ما يرفع إليك من أعمالهم ، فمن رجح منهم خيره على شره مثقال ذرة | فله الجنة ، حتى تعلم أني لا أدخل النار منهم إلا كل ظالم ' . ( ابن عساكر عن | الفضل بن عيسى الرقاشي عن الحسن عن أبي هريرة رضي الله عنهما والفضل ضعيف | وعن سعد بن أنس عن الحسن قوله ) . |(@)(@@)(@@)(@@) $ 28612 - قال النبي صلى الله عليه وسلم : ' يعتق الرجل من عبده ما شاء ، إن شاء ثلثا وإن شاء | ربعا ' . ( طب ، عن علقمة بن عبد الله المزني عن أبيه ) . |(@)(@@)(@@)(@@) $ 28613 - قال النبي صلى الله عليه وسلم : ' يعتق الرجل من عبده ما شاء ، إن شاء ثلثا وإن شاء | ربعا ، وإن شاء خمسا ، ليس بينه وبين الله ضغطة ' . ( هق ، عن محمد بن فضالة | عن أبيه ) . |(@)(@@)(@@)(@@) $ 28614 - قال النبي صلى الله عليه وسلم : ' يعجب الرب من عبده إذا قال : رب اغفر لي ، | ويقول : علم عبدي أنه لا يغفر الذنوب غيري ' . ( حم ، عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28615 - قال النبي صلى الله عليه وسلم : ' يعجب ربنا من رجلين يقتل أحدهما الآخر كلاهما | يدخل الجنة ' . ( ابن خزيمة عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28616 - قال النبي صلى الله عليه وسلم : ' يعذب الميت 
ms3076	 ببكاء أهله عليه ' . ( حم ، عن ابن | عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28617 - قال النبي صلى الله عليه وسلم : ' يعذب اللسان بعذاب لا يعذب به ' شيء من | الجوارح ، فيقول : يا رب ! عذبتني بعذاب لم تعذب به شيئا من الجوارح ، فيقال | له : خرجت منك كلمة بلغت مشارق الأرض ومغاربها ، فسفك بها الدم الحرام ، | وأخذ بها المال الحرام ، وانتهك بها الفرج الحرام ، فوعزتي لأعذبنك بعذاب لا | أعذب به شيئا من الجوارح ' . ( أبو نعيم عن إبان عن أنس رضي الله عنه ) . | PageV09P306 |(@)(@@)(@@)(@@) $ 28618 - قال النبي صلى الله عليه وسلم : ' يعذب المذنبون في النار على قدر نقصان | إيمانهم ' . ( ك ، في تاريخه عن ابن عباس عن أنس رضي الله عنهم ) . |(@)(@@)(@@)(@@) $ 28619 - قال النبي صلى الله عليه وسلم : ' يعطى المؤمن في الجنة قوة مائة في النساء من | الجماع ' . ( ط ، ت ، صحيح غريب ، حب ، ص ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28620 - قال النبي صلى الله عليه وسلم : ' يعرفني الله نفسه يوم القيامة فأسجد سجدة يرضى | بها عني ، ثم أمدحه مدحة يرضى بها عني ثم يؤذن لي في الكلام ، ثم تمر أمتي على | الصراط مضروب بين ظهراني جهنم فيمرون أسرع من الطرف والسهم ، وأسرع من | أجود الخيل ، ثم يخرج الرجل منهم يحبو وهي الأعمال وجهنم تسأل المزيد حتى | يضع قدمه فيها فينزوي بعضها إلى بعض وتقول قط قط ، وأنا على الحوض ، قالوا وما | الحوض ؟ قال : والذي نفسي بيده إن شرابه أبيض من اللبن ، وأحلى من العسل وأبرد | من الثلج ، وأطيب ريحا من المسك ، وآنيته أكثر من عدد النجوم ، لا يشرب منه إنسان | فيظمأ أبدا ، ولا يصرف فيروى أبدا ' ( ع ، قط ، في الأفراد عن أبي بن كعب رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28621 - قال النبي صلى الله عليه وسلم : ' يعطى الرجل منهم من القوة الواحدة أكثر من سبعين | منكم ' . ( ابن السكن وابن منده وأبو نعيم ، هب ، والخطيب في المؤتلف عن | خارجة بن جزء العذري قال : سمعت رجلا بتبوك يقول : يا رسول الله ! أنباضع أهل | الجنة ؟ قال فذكره ) . |(@)(@@)(@@)(@@) $ 28622 - قال النبي صلى الله عليه وسلم 
ms3077	 : ' يعطى الشهيد ست خصال عند أول قطرة من دمه : | يكفر عنه كل خطيئة ، ويرى مقعده من الجنة ، ويزوج من الحور العين ، ويؤمن من | الفزع الأكبر ومن عذاب القبر ، ويحلى حلة الإيمان ' . ( حم ، وابن سعد عن قيس | الجذامي رضي الله عنه ) . | PageV09P307 |(@)(@@)(@@)(@@) $ 28623 - قال النبي صلى الله عليه وسلم : ' يعظم أهل النار في النار حتى إن بين شحمة أذن | أحدهم إلى عاتقه مسيرة سبعمائة عام ، وإن غلظ جلده سبعون ذراعا ، وإن ضرسه | مثل أحد ' . ( حم ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28624 - قال النبي صلى الله عليه وسلم : ' يعفى عنه كل يوم سبعون مرة - يعني المملوك - ' . | ( حم عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28625 - قال النبي صلى الله عليه وسلم : ' يعق عن الغلام شاتان مكافأتان ، وعن الجارية | شاة ، اذبحوا على اسمه وقولوا : بسم الله والله أكبر ، اللهم لك وإليك هذه ، عقيقة | فلان ' . ( هق ، عن عائشة رضي الله عنها ) . |(@)(@@)(@@)(@@) $ 28626 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم إلى ابنته فيزوجها القبيح الدميم ، إنهن | يردن ما تريدون ' . ( أبو نعيم عن الزبير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28627 - قال النبي صلى الله عليه وسلم : ' يعوذ عائذ بهذا البيت فيبعث إليه جيش حتى إذا كانوا | بالبيداء خسف بهم ، فلم يفلت منهم إلا رجل يخبر عنهم ' . ( الخطيب في المتفق | والمفترق عن أم سلمة رضي الله عنها ) . |(@)(@@)(@@)(@@) $ 28628 - قال النبي صلى الله عليه وسلم : ' يعطى الشهيد ثلاثا عند أول دفعة من دمه : تغفر له | ذنوبه ، وأول من يمسح التراب عن وجهه زوجته من الحور العين ، وإذا وجب جنبه | إلى الأرض وقع في الجنة ' . ( قط والديلمي والرافعي عن أنس رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28629 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم إلى ماله فيتصدق به ثم يقعد فيتكفف | الناس ، وإنما الصدقة عن ظهر غنى وابدأ بمن تعول ' . ( ابن سعد عن جابر رضي الله عنه ) . | PageV09P308 |(@)(@@)(@@)(@@) $ 28630 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم إلى أخيه فيعضه كعضاض الفحل ، | ثم يأتي بعد ذلك يلتمس العقل ، انطلق فلا عقل لك ' . ( ه ، ك 
ms3078	 ، طب ، عن يعلى | وسلمة ابني أمية رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28631 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم إلى جمرة من نار فيجعلها في يده ' . | ( م ، عن ابن عباس رضي الله عنهما أن رسول الله صلى الله عليه وسلم رأى خاتما من ذهب في يد | رجل فنزعه وقال فذكره ) . |(@)(@@)(@@)(@@) $ 28632 - قال النبي صلى الله عليه وسلم : ' يعمد أحدكم فينخلع من ماله ثم يصير عيالا على | الناس ' . ( هب ، عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28633 - قال النبي صلى الله عليه وسلم : ' يعيش هذا الغلام قرنا - قاله لعبد الله بن بسر - ' . | ( حم ، وابن جرير ، طب ، وابن مندة وتمام ، ك ، هق ، في الدلائل عن | عبد الله بن بسر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28634 - قال النبي صلى الله عليه وسلم : ' يعيش كل نبي نصف عمر الذي قبله ، وإن عيسى بن | مريم مكث في قومه أربعين عاما ' . ( ابن سعد عن الأعمش عن إبراهيم مرسلا ) |(@)(@@)(@@)(@@) ||| ( الياء مع الغين )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28635 - قال النبي صلى الله عليه وسلم : ' يغزو جيش الكعبة ، فإذا كانوا ببيداء من الأرض | خسف بأولهم وآخرهم ثم يبعثون على نياتهم ' . ( خ ، عن عائشة رضي الله عنها ، | ز ) . |(@)(@@)(@@)(@@) $ 28636 - قال النبي صلى الله عليه وسلم : ' يغزو هذا البيت جيش فيخسف بهم بالبيداء ' . | ( ن ، عن أبي هريرة رضي الله عنه ، ز ) . | PageV09P309 |(@)(@@)(@@)(@@) $ 28637 - قال النبي صلى الله عليه وسلم : ' يغسل الإناء إذا ولغ فيه الكلب سبع مرات أخراهن أو | أولاهن بالتراب ، وإذا ولغت فيه الهرة غسل مرة ' . ( ت ، عن أبي هريرة رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28638 - قال النبي صلى الله عليه وسلم : ' يغسل من بول الجارية ويرش من بول الغلام ' . | ( د ، ن ، ه ، ك ، عن أبي السمح ، د ، ه ، عن علي رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28639 - قال النبي صلى الله عليه وسلم : ' يغضب علي أن لا أجد ما أعطيه ، من سأل منكم وله | أوقية أو عدلها فقد سأل إلحافا ' . ( د ، عن رجل ، ز ) . |(@)(@@)(@@)(@@) $ 28640 - قال النبي صلى الله عليه وسلم : ' يغفر للشهيد كل ذنب إلا الدين ' . ( حم 
ms3079	 ، م ، عن | ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28641 - قال النبي صلى الله عليه وسلم : ' يغتسل من أربع : من الجنابة ، ويوم الجمعة ، | ومن غسل الميت ، والحجامة ' . ( ش ، م ، ك ، عن عائشة بن خزيمة عن ابن | الزبير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28642 - قال النبي صلى الله عليه وسلم : ' يغسل بول الجارية وينضح بول الصبي ' . | ( عبد الرزاق عن قاموس بن المخارق ) . |(@)(@@)(@@)(@@) $ 28643 - قال النبي صلى الله عليه وسلم : ' يغسل مذاكيره ويتوضأ وضوءه للصلاة ' . ( ن ، ك ، | عن علي عن المقداد أنه سأل النبي صلى الله عليه وسلم عمن أمذى ولم يجامع قال فذكره ، ن ، عن | عمار بن ياسر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28644 - قال النبي صلى الله عليه وسلم : ' يغسل الإناء من الهر كما يغسل من الكلب ' . | ( الديلمي عن أبي هريرة رضي الله عنهما ) . | PageV09P310 |(@)(@@)(@@)(@@) $ 28645 - قال النبي صلى الله عليه وسلم : ' يغفر للمؤذن منتهى أذانه ، ويستغفر له كل رطب | ويابس سمع صوته ' . ( عب ، عن عطاء بن يسار مرسلا ، حم ، عن ابن عمر ) . |(@)(@@)(@@)(@@) $ 28646 - قال النبي صلى الله عليه وسلم : ' يغفر للمؤذن مد صوته ويجيبه كل رطب ويابس | سمعه ، وله مثل أجر من صلى معه ' . ( أبو الشيخ في الأذان عن البراء رضي الله | عنه ) . |(@)(@@)(@@)(@@) ||| ( الياء مع الفاء )(@)(@@)(@@)(@@) |||| الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28647 - قال النبي صلى الله عليه وسلم : ' يفتقد أهل الجنة قوما كانوا معهم في الدنيا ، | فينطلقون إلى الأنبياء فيقولون لهم : اشفعوا لنا فيشفعون لهم ، فيخرجون من النار | فيصب عليهم ماء الحياة فيكونون مثل الثعارير فيسمون الطلقاء وكلهم طلقاء ' | ( الشيرازي في الألقاب عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28648 - قال النبي صلى الله عليه وسلم : ' يفضل الذكر الخفي الذي لا تسمعه الحفظة على | الذي تسمعه سبعين ضعفا ' . ( ابن أبي الدنيا ، ح ، وضعفه عن جابر رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28649 - قال النبي صلى الله عليه وسلم : ' يفضل الذكر على النفقة في سبيل الله سبعمائة ألف | ضعف ' . ( ابن شاهين في الترغيب في الذكر عن معاذ بن أنس وليس في سنده من | تكلم فيه سوى ابن لهيعة رضي 
ms3080	 الله عنه ) . | PageV09P311 |(@)(@@)(@@)(@@) ||| ( الياء مع القاف )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28650 - قال النبي صلى الله عليه وسلم : ' يقال لأهل الجنة : يا أهل الجنة ! خلود لا موت ، | ولأهل النار : يا أهل النار ! خلود لا موت ' . ( خ ، عن أبي هريرة رضي الله عنه ، | ز ) . |(@)(@@)(@@)(@@) $ 28651 - قال النبي صلى الله عليه وسلم : ' يقال لصاحب القرآن إذا دخل الجنة : اقرأ واصعد ، | فيقرأ ويصعد لكل آية درجة حتى يقرأ آخر شيء معه ' . ( حم ، ه ، عن أبي | سعيد رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28652 - قال النبي صلى الله عليه وسلم : ' يقال لصاحب القرآن : اقرأ وارق ورتل كما كنت | ترتل في دار الدنيا فإن منزلتك عند آخر آية كنت تقرأها ' . ( حم ، 3 ، حب ، ك ، | عن ابن عمرو رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28653 - قال النبي صلى الله عليه وسلم : ' يقال للرجل من أهل النار يوم القيامة : أرأيت لو | كان لك ما على الأرض من شيء أكنت مفتديا به ؟ فيقول : نعم ، فيقول الله | كذبت قد أردت منك أهون من ذلك ، قد أخذت عليك في ظهر آدم أن لا تشرك بي | شيئا فأبيت إلا أن تشرك ' . ( حم ، ق ، عن أنس رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28654 - قال النبي صلى الله عليه وسلم : ' يقبض العلم ، ويظهر الجهل والفتن ويكثر | الهرج ' . ( خ ، عن أبي هريرة رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28655 - قال النبي صلى الله عليه وسلم : ' يقبض الله الأرض يوم القيامة ، ويطوي السموات | بيمينه ثم يقول : أنا الملك ، أين ملوك الأرض ؟ ' . ( ق ، ن ، ه ، عن أبي | PageV09P312 | هريرة ، خ ، عن ابن عمر رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28656 - قال النبي صلى الله عليه وسلم : ' يقتل ابن مريم الدجال بباب لد ' . ( ت ، عن | مجمع بن جارية رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28657 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم السبع العادي والكلب العقور ، | والفأرة ، والعقرب ، والحدأة ، والغراب ' . ( ت ، ه ، عن أبي سعيد رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28658 - قال النبي صلى الله عليه وسلم : ' يقتل عند كنزكم هذا ثلاثة كلهم ابن خليفة ، ثم لا | يصير إلى واحد منهم ، ثم تطلع 