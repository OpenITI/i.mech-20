ms4860	 ومخطوطات الظاهرية، الرياضيات (الرقم العام 5648). PageV08P0127(@)(@)(@@)(@@)(@@) | AUT حرف ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) ء(@)(@@)(@)(@@)(@@)(@@) || AUT يا(@)(@@) ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) بري (ابن عبدون) = عبد المجيد بن عبد الله 529 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) بري = شعيب بن عيسى 538 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) بري = طلحة بن محمد 643 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) روقي (المشد) = علي بن عمر 656 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) زجي = ناصيف بن عبد الله 1287 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) زجي = خليل بن ناصيف 1306 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) زجي = إبراهيم بن ناصيف 1324 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) زجية = وردة بنت ناصيف 1342 ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) زوري = الحسن بن علي 450 ابن(@)(@@)(@@)(@@) || AUT يا(@)(@@) سر = محمد بن علي 563(@)(@@)(@@)(@@) ||| AUT أبو عمار(@)(@@) ( 000 - نحو 7 ق ه = 000 - نحو 615 م)(@)(@@)(@@)(@@) || AUT يا(@)(@@) سر بن عامر الكناني المذحجي العنسي،(@)(@@)(@@)(@@) ||| AUT أبو عمار(@)(@@) : صحابي، من السابقين إلى الاسلام. يماني. انتقل إلى مكة، وحالف أبا حذيفة ابن المغيرة المخزومي (من قريش) وزوجه أبو حذيفة بأمة له اسمها سمية (انظر سمية بنت خباط) فولدت له ابنه عمارا، على الرق، فأعتقه(@)(@@)(@@)(@@) || AUT يا(@)(@@) سر. وفى أ(@)(@@)(@@)(@@) || AUT يا(@)(@@) مه بدأت الدعوة إلى الإسلام سرا، فآمن هو وزوجته وابنه. ثم أظهروا إسلامهم بمكة، وعذبهم مشركو قريش، وقتل أبو جهل سمية (زوجة(@)(@@)(@@)(@@) || AUT يا(@)(@@) سر) ومات في العذاب (1). ال(@)(@@)(@@)(@@) || AUT يا(@)(@@) سري = الحسن بن علي 622 __________ (1) الاصابة: ت 9209. PageV08P0128(@)(@@) ابن ال(@)(@@)(@@)(@@) ||| AUT ياسمين(@)(@@) = عبد الله بن محمد 601(@)(@@)(@@)(@@) ||| AUT ياسمين(@)(@@) ( 000 - نحو 80 ه = 000 - نحو 700 م)(@)(@@)(@@)(@@) ||| AUT ياسمين(@)(@@) : من جواري " عتاب بن ورقاء الرياحي " القائد، المتقدمة ترجته. كانت معه أيام حاصره الخوارج وزعيمهم ابن أبي الماحوز، في أصبهان. ولما طال عليه الحصار، نصب لواء لجاريته، ونادى في من معه: من أراد البقاء فليلحق بلواء "(@)(@@)(@@)(@@) ||| AUT ياسمين(@)(@@) " ومن أراد الجهاد فليخرج معي ! وخرج، فكانت معركة " جي " وهي ناحية أصبهان القديمة، وكانت تسمى " المدينة " فظفر بالخوارج، وقتل ابن أبي الماحوز، فقال أحد بني ضبة، ممن خرج للقتال مع عتاب: " خرجت من المدينة مستميتا ... ولم أك في 