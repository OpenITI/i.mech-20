ms61	(@)(@@) % فخلفناه وسط القاع ملقى % وها أنا طالب قتل البقيه % 5(@)(@@) % ورحنا بالسيوف نسوق فيهم % % إلى ربوات معضلة خفيه % 6(@)(@@) % وكم من فارس منهم تركنا % % عليه منن صوارمنا قضيه % 7(@)(@@) % فوارسنا بنو عبس وإنا % % ليوث الحرب ما بين البريه % 8(@)(@@) % نجيد الطعن بالسمر العوالي % % ونضرب بالسيوف المشرفيه % 9(@)(@@) % وننعل خيلنا في كل حرب % من السادات أقحافا دميه % 10(@)(@@) % ويوم البذل نعطي ما ملكنا % % من الأموال والنعم البهيه % % PageV01P233 11(@)(@@) % ونحن العادلون إذا حكمنا % % ونحن المشفقون على الرعيه % 12(@)(@@) % ونحن المنصفون إذا دعينا % % إلى طعن الرماح السمهريه % % 13(@)(@@) % ونحن الغالبون إذا حملنا % % على الخيل الجياد الأعوجيه % 14(@)(@@) % ونحن الموقدون لكل حرب % ونصلاها بأفئدة جريه % 15(@)(@@) % ملأنا الأرض خوفا من سطانا % % وهابتنا الملوك الكسرويه % % 16(@)(@@) % سلوا عنا ديار الشام طرا % وفرسان الملوك القيصريه % % 17(@)(@@) % أنا العبد الذي بديار عبس % ربيت بعزة النفس الأبيه % % 18(@)(@@) % سلوا النعمان عني يوم جاءت % فوارس عصبة النار الحميه % 19(@)(@@) % أقمت بصارمي سوق المنايا % % ونلت بذابلي الرتب العليه % % PageV01P234 البحر : وافر تام 1(@)(@@) % ألا يا دار عبلة بالطوى % % كرجع الوشم في رسغ الهدي % 2(@)(@@) % كوحي صحائف من عهد كسرى % % فأهداهما لأعجم طمطمي % 3(@)(@@) % أمن زو الحوادث يوم تسمو % % بنو جرم لحرب بني عدي % % 4(@)(@@) % إذا اضطربوا سمعت الصوت فيهم % % خفيا غير صوت المشرفي % 5(@)(@@) % وغير نوافذ يخرجن منهم % بطعن مثل أشطان الركي % % 6(@)(@@) % وقد خذلتهم ثعل بن عمرو % % سلامانيهم والجرولي % PageV01P235 البحر : طويل 1(@)(@@) % ألا قاتل الله الطلول البواليا % % وقاتل ذكراك السنين الخواليا % % 2(@)(@@) % وقولك للشيء الذي لا تناله % إذا ما حلا في العين : يا ليت ذا ليا % % 3(@)(@@) % ونحن منعنا بالفروق نساءنا % % نطرف عنها مشعلات غواشيا % % 4(@)(@@) % حلفنا لهم والخيل تردي بنا معا % نزايلهم حتى يهروا العواليا % % 5(@)(@@) % عوالي زرقا من رماح ردينة % هرير الكلاب يتقين الأفاعيا % % 6(@)(@@) % تفاديتم أستاه نيب تجمعت % على رمة من ذي العظام تفاديا % % 7(@)(@@) % ألم تعلموا أن الأسنة أحرزت % بقيتنا لو أن للدهر باقيا % 8(@)(@@) % ونحفظ عورات النساء ونتقي % % عليهن أن يلقين يوما مخازيا % % 9(@)(@@) % أبينا 
ms62	 أبينا أن تضب لثاتكم % على مرشفات كالظباء عواطيا % % 10(@)(@@) % وقلت لمن قد أحضر الموت نفسه % % ألا من لأمر حازم قد بدا ليا % % PageV01P236 11(@)(@@) % وقلت لهم ردوا المغيرة عن هوى % % سوابقها وأقبلوها النواصيا % % 12(@)(@@) % وإنا نقود الخيل تحكي رؤوسها % % رؤوس نساء لا يجدن فواليا % % 13(@)(@@) % فما وجدونا بالفروق أشابة % ولا كشفا ولا دعينا مواليا % % 14(@)(@@) % تعالوا إلى ما تعلمون فإنني أرى % % الدهر لا ينجي من الموت ناجيا % % PageV01P237 
