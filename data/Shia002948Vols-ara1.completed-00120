ms101	 / 22 - ثابت الضرير:(@)(@@) له كتاب، ذكره ابن النديم، الفهرست (8).(@)(@@) PageV01P314(@)(@@)(@@)(@@) $ 849 / 23 - ثابت بن عبد الله وهو ثابت بن أبي ثابت، البجلي، الكوفي، يكنى أبا سعيد، مولى، من أصحاب علي بن الحسين (1) والباقر (2) والصادق (3) عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 850 / 24 - ثابت بن عبد الله بن الزبير:(@)(@@) ابن العوام بن أسد، من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 851 / 25 - ثابت بن عمرو بن زيد:(@)(@@) ابن عدي، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 852 / 26 - ثابت بن قيس بن رغبة:(@)(@@) الأشهلي، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 853 / 27 - ثابت بن قيس بن الشماس:(@)(@@) الخزرجي، خطيب الأنصار، سكن المدينة، قتل يوم اليمامة (8)، من(@)(@@) PageV01P315(@)(@@) أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1) وذكره ابن داود في البابين (2) (3).(@)(@@)(@@)(@@) $ 854 / 28 - ثابت بن هرمز الفارسي:(@)(@@) أبو المقدام، العجلي الحداد، مولى بني عجل، من أصحاب علي بن الحسين (4) والباقر (5) والصادق (6) عليهم السلام، رجال الشيخ.(@)(@@) زيدي بتري، الخلاصة (7).(@)(@@) روى نسخة عن علي بن الحسين عليهما السلام، رواها عنه ابنه عمرو بن ثابت، رجال النجاشي (8).(@)(@@) وسيجئ بعض أحواله عند ترجمة سلمة بن كهيل (9).(@)(@@)(@@)(@@) $ 855 / 29 - ثابت بن هزال:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (10).(@)(@@) PageV01P316(@)(@@)(@@)(@@) $ 856 / 30 - ثابت بن يزيد بن وديعة الأنصاري الخزرجي، سكن الكوفة، يكنى أبا سعد، وقيل: أبا مجعد، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 857 / 1 - ثبيت بن محمد:(@)(@@) أبو محمد العسكري، صاحب أبي عيسى الوراق، متكلم حاذق، من أصحابنا العسكريين، وكان أيضا له اطلاع بالحديث والرواية والفقه، له كتب.(@)(@@) ثبيت ممن كان يروي عن الصادق عليه السلام، وله عنه أحاديث، يروي عنه: أبو أيوب الخراز (2)، رجال النجاشي (3).(@)(@@)(@@)(@@) $ 858 / 1 - ثبيط بن نشيط الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 859 / 1 - ثعلبة بن أبي مليك القرطي:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 860 / 2 - ثعلبة بن حاطب (6) الأنصاري:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال 
ms102	 الشيخ (7).(@)(@@) PageV01P317(@)(@@)(@@)(@@) $ 861 / 3 - ثعلبة بن الحكم الليثي من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 862 / 4 - ثعلبة بن راشد الأسدي (2):(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 863 / 5 - ثعلبة بن زهرم الحنظلي:(@)(@@) التميمي، وافد رسول الله صلى الله عليه وآله، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 864 / 6 - ثعلبة بن صغير:(@)(@@) أبو عبد الله، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 865 / 7 - ثعلبة بن عمرو:(@)(@@) أبو عمرة الأنصاري، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (6)، وسيجئ بعض أحواله عند ترجمة: الحصين بن المنذر (7).(@)(@@)(@@)(@@) $ 866 / 8 - ثعلبة بن غنمة بن عدي:(@)(@@) من بني سلمة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (8).(@)(@@) PageV01P318(@)(@@)(@@)(@@) $ 867 / 9 - ثعلبة بن ميمون (1) مولى بني أسد، مولى بني سلامة، منهم: أبو إسحاق النحوي، كان وجها في أصحابنا، قارئا، فقيها، نحويا، لغويا، راوية (2)، وكان حسن العمل، كثير العبادة والزهد، روى عن أبي عبد الله وأبي الحسن عليهما السلام، له كتاب (3)، روى عنه: عبد الله بن محمد المزخرف (4)، رجال النجاشي (5).(@)(@@) ذكر حمدويه، عن محمد بن عيسى: ان ثعلبة بن ميمون مولى محمد ابن قيس الأنصاري، وهو ثقة، خير، فاضل، مقدم، معلوم (6) في العلماء والفقهاء الأجلة من هذه العصابة، رجال الكشي (7).(@)(@@) وذكره العلامة وابن داود ولم يوثقاه صريحا (8)، وينبغي أن يوثقاه كما وثقه الكشي.(@)(@@)(@@)(@@) $ 868 / 1 - ثقاف (9) بن عمرو بن سميط:(@)(@@) حليف بني عبد شمس، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (10).(@)(@@) PageV01P319(@)(@@)(@@)(@@) $ 869 / 1 - ثلج بن أبي ثلج اليعقوبي من ولد داود بن علي اليعقوبي، من أصحاب الرضا عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 870 / 1 - ثمامة بن عمرو:(@)(@@) أبو سعيد الأودي، العطار، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 871 / 1 - ثوبان:(@)(@@) مولى رسول الله صلى الله عليه وآله، يكنى أبا عبد الله، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 872 / 1 - ثوير بن أبي فاختة (4):(@)(@@) أبو جهم، الكوفي، واسم أبي فاختة: سعيد 
ms103	 بن علاقة، يروي عن أبيه، وكان مولى أم هاني بنت أبي طالب.(@)(@@) قال ابن نوح: حدثني جدي، قال: حدثنا بكر بن أحمد، قال: حدثنا محمد بن عبد الله البزاز، قال: حدثنا محمد (5) بن غيلان، قال: حدثنا سيابة (6) بن سوار، قال: قلت ليونس بن أبي إسحاق: مالك لا تروي عن ثوير فان إسرائيل يروي عنه؟ فقال: ما اصنع به، كان رافضيا، رجال(@)(@@) PageV01P320(@)(@@) النجاشي (1) وروى الكشي، عن محمد بن قولويه، عن محمد بن عباد بن بشير، عن ثوير بن أبي فاختة رواية تدل على أن ثويرا أشفق على أبي جعفر عليه السلام من مسائل هيأها له عمرو بن ذر القاضي وابن قيس الماصر والصلت بن بهرام (2).(@)(@@) وقال العلامة في الخلاصة: هذه الرواية لا تقتضي مدحا ولا قدحا، فنحن في روايته من المتوقفين (3).(@)(@@)(@@)(@@) $ 873 / 2 - ثوير (4) بن عمارة الأزدي:(@)(@@) الكوفي، أبو الحسن، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 874 / 3 - ثوير بن عمرو بن عبد الله:(@)(@@) المرهبي (6)، الهمداني، الكوفي (7)، من أصحاب الصادق عليه السلام، رجال الشيخ (8). وفي نسخة: ثور.(@)(@@)(@@)(@@) $ 875 / 4 - ثوير بن يزيد الشامي:(@)(@@) من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (9).(@)(@@) PageV01P321(@)(@@)(@@)(@@) | " باب الجيم "(@)(@@)(@@)(@@) $ 876 / 1 - جابر بن أبحر (1) النخعي:(@)(@@) الكوفي، الصهباني، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 877 / 2 - جابر بن أسامة (الجهني) (3):(@)(@@) نزل بالمدينة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 878 / 3 - جابر بن خالد الأشهلي:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 879 / 4 - جابر بن سليم الجهني (6):(@)(@@) من تميم، وقيل: سليم بن جابر، والصحيح الأول، يكنى أبا جري (7)، نزل البصرة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 880 / 5 - جابر بن سمرة (9):(@)(@@) نزل الكوفة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (10).(@)(@@) PageV01P322(@)(@@)(@@)(@@) $ 881 / 6 - جابر بن شمير الأسدي كوفي، أبو العلاء، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 882 / 7 - جابر بن طارق الأحمسي:(@)(@@) أبو حكيم، وقال البخاري: جابر بن عوف، من أصحاب الرسول صلى 
ms104	 الله عليه وآله، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 883 / 8 - جابر بن عبد الله بن رئاب:(@)(@@) السلمي، سكن المدينة، روى عنه أنس حديثين، كنيته أبو ياسر، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 884 / 9 - جابر بن عبد الله بن عمرو:(@)(@@) ابن حزام (4) الأنصاري، نزل المدينة، شهد بدرا وثماني عشر غزوة مع رسول الله صلى الله عليه وآله، مات سنة ثمان وسبعين، من أصحاب الرسول صلى الله عليه وآله (5) وعلي (6) والحسن (7) والحسين (8) وعلي بن الحسين (9) والباقر (10) عليهم السلام، رجال الشيخ.(@)(@@) وأورد الكشي في مدحه روايات كثيرة تدل على علو مرتبته وحسن عقيدته وانقطاعه إلى أهل البيت عليهم السلام (11).(@)(@@) PageV01P323(@)(@@)(@@)(@@) $ 885 / 10 - جابر بن عتيك المعاذي الأنصاري، سكن المدينة (1)، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 886 / 11 - جابر بن عمير الأنصاري:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 887 / 12 - جابر بن محمد بن أبي بكر:(@)(@@) من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 888 / 13 - جابر المكفوف (5):(@)(@@) حدثني محمد بن مسعود قال: حدثني علي بن الحسن، عن العباس ابن عامر، عن جابر المكفوف، عن الصادق عليه السلام قال: دخلت عليه فقال:(@)(@@) أما يصلونك؟ قلت: ربما فعلوا، قال: فوصلني بثلاثين دينارا وقال:(@)(@@) يا جابر كم عبد (6) إن غاب لم يفقدوه وإن شهد لم يعرفوه، في أطمار (7) لو أقسم على الله لأبر قسمه، رجال الكشي (8).(@)(@@) PageV01P324(@)(@@) والطمر بالكسر الثوب الخلق، والجمع أطمار، كذا في الصحاح (1)(@)(@@)(@@)(@@) $ 889 / 14 - جابر بن نوح التميمي:(@)(@@) الحماني، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 890 / 15 - جابر بن يزيد (3):(@)(@@) أبو عبد الله، وقيل: أبو محمد الجعفي، عربي قديم، لقي الباقر والصادق عليهما السلام، ومات في أيام (4) سنة ثمان وعشرين ومائة، روى عنه جماعة غمز فيهم، ضعفوا (5)، منهم: عمرو بن شمر ومفضل بن صالح ومنخل بن جميل ويوسف بن يعقوب، وكان في نفسه مختلطا.(@)(@@) وكان شيخنا أبو عبد الله محمد بن محمد بن النعمان رحمه الله ينشدنا أشعارا كثيرة في معناه، تدل على الاختلاط، 
ms105	 ليس هذا موضعا لذكرها، وقلما يورد عنه شئ في الحلال والحرام، له كتب، روى عنه: عبد الله بن محمد الجعفي، وهذا عبد الله بن محمد يقال (6): الجعفي، ضعيف، وعمرو ابن شمر، ومنخل بن جميل رجال النجاشي (7).(@)(@@) PageV01P325(@)(@@) له أصل (1) روى عنه إبراهيم بن سليمان، الفهرست (2) من أصحاب الباقر (3) والصادق عليهما السلام. تابعي (4) رجال الشيخ (5).(@)(@@) حدثني حمدويه وإبراهيم قالا: حدثنا محمد بن عيسى، عن علي بن الحكم، عن زياد بن أبي الحلال، قال: اختلف أصحابنا في أحاديث جابر الجعفي، فقلت لهم: أسأل الصادق عليه السلام، فلما دخلت ابتدأني فقال: رحم الله جابر الجعفي، كان يصدق علينا، ولعن الله المغيرة بن سعيد، كان يكذب علينا، رجال الكشي (6). وذكر أيضا روايات كثيرة تدل بعضها على مدحه (7) وبعضها على ذمه (8).(@)(@@) وروى العلامة في الخلاصة عن ابن الغضائري: ان جابر بن يزيد الجعفي ثقة في نفسه، ولكن جل من روى عنه ضعيف (9) (10).(@)(@@) PageV01P326(@)(@@)(@@)(@@) $ 891 / 16 - جابر بن يزيد الفارسي:(@)(@@) يكنى أبا القاسم، من أصحاب العسكري عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 892 / 1 - الجارود بن أبي بشر:(@)(@@) من أصحاب الحسن عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 893 / 2 - الجارود بن السري:(@)(@@) التميمي، السعدي، الكوفي، من أصحاب الباقر (3) والصادق (4) عليهما السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 894 / 3 - الجارود بن عمر بن حفش:(@)(@@) ابن يعلى العبدي، من أصحاب الرسول صلى الله عليه وآله، من الوافدين عليه، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 895 / 4 - الجارود بن عمر الطائي (7):(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 896 / 5 - الجارود بن المعلى:(@)(@@) سكن البصرة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (9).(@)(@@) PageV01P327(@)(@@)(@@)(@@) $ 897 / 6 - الجارود بن المنذر (1) أبو المنذر الكندي، النحاس (2)، كوفي (3)، ثقة ثقة، ذكره أبو العباس في رجاله، له كتاب تختلف الرواة عنه، روى عنه: علي بن الحسن بن رباط، رجال النجاشي (4).(@)(@@) له كتاب (5)، روى عنه: صفوان بن يحيى، الفهرست (6) (7).(@)(@@)(@@)(@@) $ 898 / 1 - جارية بن ظفر:(@)(@@) سكن الكوفة، وأصله اليمامة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 899 / 2 - جارية بن قدامة السعدي:(@)(@@) عم الأحنف (9)، من أصحاب 
ms106	 الرسول صلى الله عليه وآله (10) وعلي عليه السلام (11) رجال الشيخ.(@)(@@) PageV01P328(@)(@@) وروى الكشي بطريق ضعيف ان أمير المؤمنين عليه السلام وجهه إلى أهل نجران عند ارتدادهم عن الاسلام (1).(@)(@@)(@@)(@@) $ 900 / 1 - جاهمة السلمي:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 901 / 1 - جبار بن صخر:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 902 / 1 - جبر بن عتيك:(@)(@@) أخو جابر (4)، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 903 / 1 - جبرئيل بن أحمد الفاريابي:(@)(@@) يكنى أبا محمد، كان مقيما بكش (6)، كثير الرواية عن العلماء بالعراق وقم وخراسان، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 904 / 1 - جبلة بن أبي سفيان:(@)(@@) مصري (8)، من أصحاب علي عليه السلام، رجال الشيخ (9).(@)(@@) PageV01P329(@)(@@)(@@)(@@) $ 905 / 2 - جبلة بن الأزرق:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 906 / 3 - جبلة بن أعين الجعفي:(@)(@@) مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 907 / 4 - جبلة بن حارثة بن شراحيل:(@)(@@) الكلبي، أخو زيد، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 908 / 5 - جبلة بن الحجاج الصيرفي:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 909 / 6 - جبلة بن حيان (5) بن أبحر (6):(@)(@@) الكناني، الكوفي (7)، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) وفي النجاشي: جلبة كما يأتي (9).(@)(@@)(@@)(@@) $ 910 / 7 - جبلة الخراساني:(@)(@@) الذي حدث عنه: يحيى بن سالم، من أصحاب الصادق عليه السلام، رجال الشيخ (10).(@)(@@) PageV01P330(@)(@@)(@@)(@@) $ 911 / 8 - جبلة بن عطية:(@)(@@) يكنى أبا عرفاء، من أصحاب علي عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 912 / 9 - جبلة بن عمرو:(@)(@@) من أصحاب علي عليه السلام (2)، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 913 / 1 - جبير بن الأسود النخعي:(@)(@@) أبو عبيد، مولى عبد الرحمن بن عائس (4) الصهباني، من أصحاب الصادق عليه السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 914 / 2 - جبير بن أياس (7) الأنصاري:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 915 / 3 - جبير بن حفص الغمشاني:(@)(@@) الكوفي، أبو الأسود، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 916 / 4 - جبير بن مطعم (10):(@)(@@) روى 
ms107	 الكشي بطريق ضعيف عن الكاظم عليه السلام أنه من حواري علي بن(@)(@@) PageV01P331(@)(@@) الحسين عليهما السلام (1)، وحواري الرجل خلصائه (2).(@)(@@) ثم روى بطريق مرسل عن الصادق عليه السلام أنه قال: ارتد الناس بعد قتل الحسين عليه السلام إلا ثلاثة: أبو خالد الكابلي ويحيى بن أم الطويل وجبير بن مطعم، ثم إن الناس لحقوا وكثروا، وروى يونس عن حمزة بن محمد الطيار مثله، وزاد فيه: جابر بن عبد الله الأنصاري (3) (4).(@)(@@)(@@)(@@) $ 917 / 1 - جحدر بن المغيرة الطائي:(@)(@@) كوفي، روى عن جعفر بن محمد عليهما السلام، ذكر ذلك الجماعة، له كتاب، روى عنه: محمد بن إدريس صاحب الكرابيس، رجال النجاشي (5).(@)(@@) كان خطابيا في مذهبه، ضعيفا في حديثه، وكتابه لم يرو إلا من طريق واحد، رجال ابن الغضائري (6).(@)(@@)(@@)(@@) $ 918 / 1 - جحل بن عامل:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (7).(@)(@@) PageV01P332(@)(@@)(@@)(@@) $ 919 / 1 - جدار:(@)(@@) ولم ينسب، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 920 / 1 - الجراح الأشجعي:(@)(@@) التميمي، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 921 / 2 - الجراح بن عبد الله المدني:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 922 / 3 - الجراح المدائني:(@)(@@) روى عن أبي عبد الله عليه السلام، ذكره أبو العباس، له كتاب (4)، يرويه عنه جماعة، منهم: النضر بن سويد، رجال النجاشي (5)، من أصحاب الباقر (6) والصادق (7) عليهما السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 923 / 4 - الجراح بن مليح الرواسي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 924 / 1 - جرموز الهجيمي:(@)(@@) سكن البصرة، القريعي، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (9).(@)(@@) PageV01P333(@)(@@)(@@)(@@) $ 925 / 1 - جرهد الأسلمي:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 926 / 1 - جرهم:(@)(@@) ويقال: جرثوم بن ناشر (2)، ويقال: ابن ناشب، من اليمن، ويقال:(@)(@@) عمرو، وأبو ثعلبة، نزل الشام، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 927 / 1 - جرير بن أحمر العجلي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 928 / 2 - جرير بن حكيم الأزدي:(@)(@@) المدائني، أخو مرازم، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 929 
ms108	 / 3 - جرير بن عبد الحميد الضبي:(@)(@@) كوفي، نزل الري، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 930 / 4 - جرير بن عبد الله (7):(@)(@@) أبو عمرو، ويقال: أبو عبد الله البجلي، سكن الكوفة، وقدم الشام برسالة أمير المؤمنين عليه السلام إلى معاوية، وأسلم في السنة التي قبض فيها رسول الله صلى الله عليه وآله. وقيل: إن طوله كان ستة أذرع، ذكره محمد بن إسحاق،(@)(@@) PageV01P334(@)(@@) من أصحاب الرسول صلى الله عليه وآله (1)، رجال الشيخ (2).(@)(@@) وتخريب علي عليه السلام داره بالكوفة بعد لحوقه بمعاوية (3) مشهور (4).(@)(@@)(@@)(@@) $ 931 / 5 - جرير بن عثمان:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 932 / 6 - جرير بن عجلان الأزدي (6):(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 933 / 7 - جرير بن كليب الكندي:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 934 / 1 - جعادة بن سعد الأنصاري:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 935 / 1 - جعدة بن أبي عبد الله:(@)(@@) من أصحاب الباقر عليه السلام، رجال الشيخ (10).(@)(@@)(@@)(@@) $ 936 / 2 - جعدة بن هبيرة المخزومي (11):(@)(@@) ابن أخت أمير المؤمنين عليه السلام، أمه أم هاني بنت أبي طالب، من(@)(@@) PageV01P335(@)(@@) أصحاب علي عليه السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 937 / 1 - جعفر بن إبراهيم الجعفي:(@)(@@) من أصحاب الباقر عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 938 / 2 - جعفر بن إبراهيم الحضرمي:(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 939 / 3 - جعفر بن إبراهيم:(@)(@@) من أصحاب الهادي عليه السلام، رجال الشيخ (5).(@)(@@) ويحتمل أن يكون هذا هو المذكور قبيل هذا.(@)(@@)(@@)(@@) $ 940 / 4 - جعفر بن إبراهيم بن محمد:(@)(@@) ابن علي بن عبد الله (6) بن جعفر بن أبي طالب عليه السلام (7)، المدني من أصحاب علي بن الحسين (8) والصادق (9) عليهما السلام رجال الشيخ.(@)(@@) ووثقه النجاشي عند ذكر ابنه سليمان بن جعفر (10).(@)(@@) PageV01P336(@)(@@)(@@)(@@) $ 941 / 5 - جعفر بن إبراهيم بن نوح:(@)(@@) من أصحاب العسكري عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 942 / 6 - جعفر بن أبي جعفر السمرقندي:(@)(@@) من أصحاب العياشي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 943 / 7 - جعفر بن أبي طالب بن عبد المطلب:(@)(@@) قتل 
ms109	 بمؤتة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@) ومؤتة: اسم أرض (من بلاد الشام، كذا في الصحاح (4)) (5).(@)(@@)(@@)(@@) $ 944 / 8 - جعفر بن أبي عثمان (6) الفزاري:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (7) (8).(@)(@@)(@@)(@@) $ 945 / 9 - جعفر بن أحمد بن أيوب:(@)(@@) السمرقندي، أبو سعيد، يقال له: ابن العاجز، كان صحيح الحديث والمذهب، روى عنه: محمد بن مسعود العياشي، ذكر أحمد بن الحسين رحمه الله: أن له كتاب الرد على من زعم أن رسول الله صلى الله عليه وآله كان على دين قومه قبل النبوة، روى عنه: محمد بن عمر بن عبد العزيز الكشي، رجال النجاشي (9).(@)(@@) PageV01P337(@)(@@) جعفر بن أحمد (1) بن أيوب، يعرف: بابن التاجر، من أهل سمرقند، متكلم، له كتب، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 946 / 10 - جعفر بن أحمد بن وندك:(@)(@@) الرازي، أبو عبد الله، من أصحابنا المتكلمين والمحدثين، له كتاب في الإمامة كبير، رجال النجاشي (3).(@)(@@)(@@)(@@) $ 947 / 11 - جعفر بن أحمد بن يوسف:(@)(@@) الأودي، أبو عبد الله، شيخ من أصحابنا الكوفيين، ثقة، روى عنه:(@)(@@) أحمد بن محمد بن عقدة، له كتاب المناقب، روى عنه: محمد بن جعفر الذهلي، رجال النجاشي (4) (5).(@)(@@)(@@)(@@) $ 948 / 12 - جعفر بن إسماعيل المنقري:(@)(@@) له نوادر، روى عنه: حميد (6)، رجال النجاشي (7).(@)(@@) كان غاليا كذابا، رجال ابن الغضائري (8).(@)(@@) وفي الخلاصة، في موضع المنقري: المقري (9).(@)(@@) وفي الإيضاح ورجال ابن داود كما في النجاشي (10).(@)(@@) PageV01P338(@)(@@)(@@)(@@) $ 949 / 13 - جعفر الأودي (1):(@)(@@) كوفي، له كتاب، روى عنه: محمد بن أبي عمير، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 950 / 14 - جعفر بن إياس:(@)(@@) أبو بشر النصري، من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 951 / 15 - جعفر بن بزاز بن حسان (4):(@)(@@) الهاشمي، مولاهم، الصيرفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 952 / 16 - جعفر بن بشير:(@)(@@) أبو محمد، البجلي، الوشاء، من زهاد أصحابنا وعبادهم ونساكهم، وكان ثقة، وله مسجد بالكوفة باق في بجيلة إلى اليوم، وأنا وكثير من أصحابنا إذا وردنا الكوفة نصلي فيه مع المساجد التي ترغب (6) في الصلاة فيها، ومات جعفر رحمه الله 
ms110	 بالأبواء سنة ثمان (7) ومائتين.(@)(@@) PageV01P339(@)(@@) كان أبو العباس بن نوح يقول: كان يلقب فقحة العلم، روى عن الثقات، ورووا عنه، له كتب (1)، روى عنه: محمد بن المفضل بن إبراهيم وابن أبي الخطاب، رجال النجاشي (2).(@)(@@) والأبواء: قرية بين مكة والمدينة (3).(@)(@@) وفي الخلاصة: يعرف بقفة (4) العلم (5) (6).(@)(@@) وفي الإيضاح: فقحة العلم، ورأيت بخط السيد السعيد صفي الدين محمد الموسوي رحمه الله قال: حدثني بعض العلماء ممن قرأت عليه هذا الكتاب أنه نفحة العلم: بالنون والفاء والحاء المهملة (7).(@)(@@) وقال الشيخ في الفهرست: ثقة، جليل القدر، له كتاب (8)، روى عنه:(@)(@@) محمد بن الحسين بن أبي الخطاب، وله كتاب ينسب إلى جعفر بن محمد عليهما السلام رواية علي بن موسى الرضا عليه السلام (9) وقال في الرجال من أصحاب الرضا عليه السلام (10) (11).(@)(@@) PageV01P340(@)(@@)(@@)(@@) $ 953 / 17 - جعفر بن الحارث:(@)(@@) أبو الأشهب، النخعي، الكوفي (1)، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 954 / 18 - جعفر بن الحبيب الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 955 / 19 - جعفر بن الحسن بن علي:(@)(@@) ابن شهريار، سيجئ بعنوان: جعفر بن الحسين (4).(@)(@@)(@@)(@@) $ 956 / 20 - جعفر بن الحسن بن يحيى:(@)(@@) ابن سعيد الحلي، شيخنا نجم الدين أبو القاسم، المحقق المدقق، الأمام العلامة، واحد عصره، كان أكبر (5) أهل زمانه وأقومهم بالحجج، وأسرعهم استحضارا، قرأت عليه، ورباني صغيرا، وكان له علي إحسان عظيم والتفات، وأجاز لي جميع ما صنفه وقرأه ورواه وكل ما يصح روايته عنه، توفي رحمه الله في شهر ربيع الاخر من سنة ست وسبعين وستمائة، له تصانيف حسنة محققة محررة عذبة، وله تلاميذ فقهاء وفضلاء رحمه الله، رجال ابن داود (6).(@)(@@)(@@)(@@) $ 957 / 21 - جعفر بن الحسين بن علي:(@)(@@) ابن شهريار، أبو محمد المؤمن القمي، شيخ أصحابنا القميين، ثقة،(@)(@@) PageV01P341(@)(@@) انتقل إلى الكوفة (1) وأقام بها، وصنف كتابا في المزار وفضل الكوفة ومساجدها، وله كتاب نوادر (2)، روى عنه: أبو الحسين بن تمام (3)، رجال النجاشي (4).(@)(@@) وفي الخلاصة: جعفر بن الحسن بدون الياء (5).(@)(@@) وفي الإيضاح: بالياء (6)، كما في النجاشي.(@)(@@) وقال الشيخ في الرجال: جعفر بن الحسين، روى عنه: ابن بابويه أبو 
ms111	 جعفر، في من لم يرو عن الأئمة عليهم السلام (7).(@)(@@) والظاهر أنهما واحد.(@)(@@)(@@)(@@) $ 958 / 22 - جعفر بن الحكيم بن عباد:(@)(@@) الكوفي، من أصحاب الباقر عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 959 / 23 - جعفر بن حيان:(@)(@@) واقفي، من أصحاب الكاظم عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 960 / 24 - جعفر بن حيان الصيرفي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (10) (11).(@)(@@) PageV01P342(@)(@@) ويحتمل أن يكون هذا هو المذكور قبيل هذا.(@)(@@)(@@)(@@) $ 961 / 25 - جعفر بن خلف:(@)(@@) من أصحاب أبي الحسن موسى عليه السلام، روى الكشي عن جعفر بن أحمد، عن يونس بن عبد الرحمن، عن جعفر بن خلف، قال: سمعت أبا الحسن عليه السلام يقول: سعد امرؤ لم يمت حتى يرى منه خلفا، وقد أراني الله ابني هذا خلفا، وأشار إليه (1) دلالة على خصوصية (2)، انتهى.(@)(@@) وقال الشيخ في الرجال: من أصحاب الصادق (3) والكاظم (4) عليهما السلام.(@)(@@)(@@)(@@) $ 962 / 26 - جعفر بن داود اليعقوبي:(@)(@@) من أصحاب الجواد عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 963 / 27 - جعفر بن زياد الأحمر:(@)(@@) أبو عبد الله الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 964 / 28 - جعفر بن سارة الطائي:(@)(@@) كوفي، مولى، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 965 / 29 - جعفر بن سليمان القمي:(@)(@@) أبو محمد، ثقة، من أصحابنا القميين، له كتاب ثواب الأعمال، روى عنه: محمد بن الحسن بن الوليد، رجال النجاشي (8).(@)(@@) PageV01P343(@)(@@) وذكر ابن داود بعد ذكر هذا الرجل رجلا اخر حيث قال: جعفر بن سليمان الضبعي البصري، (ق جخ)، ثقة (1)، انتهى. ولم أجده في الرجال وغيره (2).(@)(@@)(@@)(@@) $ 966 / 30 - جعفر بن سليمان:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (3).(@)(@@) والظاهر أنه غير ما ذكره النجاشي لرواية ابن الوليد عنه.(@)(@@)(@@)(@@) $ 967 / 31 - جعفر بن سليمان:(@)(@@) من أصحاب الهادي عليه السلام، رجال الشيخ (. 4).(@)(@@)(@@)(@@) $ 968 / 32 - جعفر بن سماعة:(@)(@@) واقفي، من أصحاب الصادق (5) والكاظم (6) عليهما السلام، رجال الشيخ.(@)(@@) والظاهر أن يكون هذا والذي سيجئ بعنوان: جعفر بن محمد بن سماعة (7)، واحدا.(@)(@@)(@@)(@@) $ 969 / 33 - جعفر بن سويد الجعفري:(@)(@@) القيسي، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) PageV01P344(@)(@@)(@@)(@@) $ 970 / 34 - جعفر 
ms112	 بن سويد:(@)(@@) مولى بني سليم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 971 / 35 - جعفر بن سهيل الصيقل:(@)(@@) وكيل أبي الحسن وأبي محمد وصاحب الدار عليهم السلام، من أصحاب العسكري عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 972 / 36 - جعفر بن شبيب النهدي:(@)(@@) يعرف بالبرذون، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 973 / 37 - جعفر بن عبد الرحمن (4) الكاهلي:(@)(@@) له نوادر (5)، روى عنه: حميد، رجال النجاشي (6).(@)(@@) وفي من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 974 / 38 - جعفر بن عبد الله رأس المدري (8):(@)(@@) ابن جعفر الثاني بن عبد الله بن جعفر بن محمد بن علي بن أبي(@)(@@) PageV01P345(@)(@@) طالب عليه السلام، أبو (1) عبد الله، كان وجها في أصحابنا وفقيها، وأوثق الناس في حديثه، وروى عن أخيه محمد عن أبيه عبد الله بن جعفر، وله عقب بالكوفة والبصرة، وابن ابنه: أبو الحسن العباس بن أبي طالب علي بن جعفر، روى عنه: هارون بن موسى.(@)(@@) وروى جعفر عن جلة أصحابنا مثل: الحسن بن محبوب ومحمد بن أبي عمير والحسن بن علي بن فضال وعبيس بن هشام وصفوان وابن جبلة.(@)(@@) قال أحمد بن الحسين رحمه الله: رأيت له كتاب المتعة، يرويه عنه: أحمد ابن محمد بن سعيد بن عبد الرحمن الهمداني (2)، رجال النجاشي (3).(@)(@@)(@@)(@@) $ 975 / 39 - جعفر بن عبد الله بن جعفر:(@)(@@) ابن محمد بن علي بن أبي طالب عليه السلام، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 976 / 40 - جعفر بن عبد الله بن الحسين:(@)(@@) ابن جامع، قمي، حميري، من أصحاب الهادي عليه السلام، رجال الشيخ (5).(@)(@@) وقال النجاشي عند ذكر أخيه محمد بن عبد الله: ان له مكاتبة (6) (7).(@)(@@)(@@)(@@) $ 977 / 41 - جعفر بن عبيد الله:(@)(@@) روى عن الحسن بن محبوب، روى عنه: ابن عقدة، في من لم يرو(@)(@@) PageV01P346(@)(@@) عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@) والظاهر أن يكون هذا هو المذكور بعنوان: جعفر بن عبد الله رأس المدري (2).(@)(@@)(@@)(@@) $ 978 / 42 - جعفر بن عثمان بن زياد:(@)(@@) الرواسي، روى الكشي عن حمدويه، قال: سمعت أشياخي يذكرون: 
ms113	 ان حمادا وجعفرا والحسين بني عثمان بن زياد الرواسي، وحماد يلقب بالناب، كلهم ثقات، فاضلون، خيار (3).(@)(@@) وقال الشيخ في الرجال: من أصحاب الصادق عليه السلام (4).(@)(@@)(@@)(@@) $ 979 / 43 - جعفر بن عثمان بن شريك:(@)(@@) ابن عدي الكلابي الوحيدي، ابن أخي عبد الله بن شريك، وأخوه الحسين بن عثمان، رويا عن الصادق عليه السلام، ذكر ذلك أصحاب الرجال، له كتاب (5)، روى عنه: ابن أبي عمير، رجال النجاشي (6).(@)(@@)(@@)(@@) $ 980 / 44 - جعفر بن عثمان:(@)(@@) صاحب أبي بصير (7)، له كتاب (8)، روى عنه: محمد البرقي، الفهرست (9).(@)(@@) PageV01P347(@)(@@) ويمكن أن يكون هذا أحد المذكورين قبيل هذا.(@)(@@)(@@)(@@) $ 981 / 45 - جعفر بن عفان الطائي:(@)(@@) قال الكشي: حدثني نصر بن الصباح، قال: حدثني أحمد بن محمد بن عيسى، عن يحيى بن عمران، قال: حدثنا محمد بن سنان، عن زيد الشحام، قال: كنا عند الصادق عليه السلام ونحن جماعة من الكوفيين، فدخل جعفر بن عفان على الصادق عليه السلام فقربه وأدناه، ثم قال: يا جعفر، قال: لبيك جعلني الله فداك، قال: بلغني أنك تقول الشعر في الحسين عليه السلام وتجيد؟ فقال: نعم جعلني الله فداك، قال: قل، فأنشده (1)، [فبكى] (2) عليه السلام ومن حوله، حتى صارت الدموع على وجهه ولحيته، ثم قال: يا جعفر، والله لقد شهدك ملائكة الله المقربون هاهنا، يسمعون قولك في الحسين عليه السلام، ولقد بكوا كما بكينا أو أكثر، ولقد أوجب الله لك يا جعفر في ساعتك (3) الجنة بأسرها، وغفر الله لك، فقال: يا جعفر ألا أزيدك؟ قال: نعم يا سيدي، قال: ما من أحد قال في الحسين شعرا فبكى وأبكى به إلا أوجب الله له الجنة وغفر له (4) (5).(@)(@@)(@@)(@@) $ 982 / 46 - جعفر بن علي بن أبي طالب عليه السلام:(@)(@@) قتل مع أخيه الحسين عليه السلام، أمه أم البنين، من أصحاب الحسين عليه السلام، رجال الشيخ (6).(@)(@@) PageV01P348(@)(@@)(@@)(@@) $ 983 / 47 - جعفر بن علي بن أحمد:(@)(@@) القمي، المعروف بابن الرازي، لم جخ، أبو محمد، ثقة، مصنف، رجال ابن داود (1). ولم أجده في الرجال (2) وغيره (3).(@)(@@)(@@)(@@) $ 984 / 48 - جعفر بن علي بن حازم:(@)(@@) يروي عنه: حميد 
ms114	 بن زياد، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 985 / 49 - جعفر بن علي بن حسان:(@)(@@) روى عنه حميد نوادر، رجال النجاشي (5).(@)(@@) وفي من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 986 / 50 - جعفر بن علي بن سهل:(@)(@@) ابن فروخ، الدقاق، الدوري، الحافظ، بغدادي، يكنى أبا محمد،(@)(@@) PageV01P349(@)(@@) سمع منه التلعكبري (1)، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 987 / 51 - جعفر بن عمارة الهمداني:(@)(@@) الحارثي (4)، الكوفي، أبو عمارة، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@) وقال في باب صفة الوضوء من التهذيب: فأما ما رواه ابن عقدة: عن الفضل بن يوسف، عن محمد بن عكاشة، عن جعفر بن عمارة أبي عمارة الحارثي قال: سألت جعفر بن محمد عليهما السلام... إلى اخر الحديث، فالوجه فيه التقية، لأن رجاله رجال العامة والزيدية (6).(@)(@@) وكان هذا الدليل على جرح المذكورين.(@)(@@)(@@)(@@) $ 988 / 52 - جعفر بن عمرو:(@)(@@) ابن ثابت أبي المقدام بن هرمز الحداد العجلي، مولاهم، كوفي، من أصحاب الباقر عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 989 / 53 - جعفر بن عمرو:(@)(@@) المعروف بالعمري، ذكره العلامة في الخلاصة، وروى عن الكشي،(@)(@@) PageV01P350(@)(@@) عن محمد بن إبراهيم بن مهزيار: ان أباه لما حضره الموت دفع إليه مالا، وأعطاه علامة لمن يسلم إليه المال، فدخل إليه (1) شيخ فقال: أنا العمري، فأعطاه المال (2).(@)(@@) وقال ابن داود: جعفر بن عمرو المعروف بالعمري، لم، كش، ممدوح (3)، انتهى.(@)(@@) ولم أجده في كتب الرجال، خصوصا في الكشي، وهو أربع نسخ عندي.(@)(@@) نعم ذكر الكشي حفص بن عمرو المعروف بالعمري (4)، وعنده هذه الرواية (5)، كما في الرجال عند ذكر أصحاب العسكري عليه السلام، حيث قال:(@)(@@) حفص بن عمرو، العمري (6) المعروف (7).(@)(@@) ويخطر ببالي ان النسخة التي كانت عند العلامة قدس سره من الكشي كان غلطا فاشتبه عليه، فذكره بهذا العنوان، واقتفى ابن داود أثر العلامة قدس سره، والعجب ان العلامة ذكره بعنوان: حفص أيضا حيث قال: حفص بن عمرو، المعروف بالعمري، وكيل أبي محمد عليه السلام (8). وكذا في رجال ابن داود أيضا (9)، وكأنه نقل 
ms115	 هذا عن رجال الشيخ كما سننقل.(@)(@@) PageV01P351(@)(@@)(@@)(@@) $ 990 / 54 - جعفر بن عيسى بن عبيد:(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (1).(@)(@@) ويحتمل أن يكون هذا هو الذي سيجئ بعيد هذا.(@)(@@)(@@)(@@) $ 991 / 55 - جعفر بن عيسى بن يقطين:(@)(@@) روى الكشي عن حمدويه وإبراهيم قالا: حدثنا أبو جعفر محمد بن عيسى العبيدي، عن هشام بن إبراهيم الختلي (2) (3) المشرقي (وهو أحد من اثني عليه في الحديث) (4): ان أبا الحسن الثاني عليه السلام شكى إليه جعفر بن عيسى أصحابه، ثم قال عن يونس وهشام المشرقي: هما أدبانا وعلمانا الكلام، فإن كنا على هدى [ففزنا] (5)، وإن كنا على ضلال فهذان أضلانا، فمرنا نترك ونتوب إلى الله منه (6)، فقال عليه السلام: ما أعلمكم إلا على هدى، وجزاكم الله على الصحبة القديمة والحديثة خيرا، فتأولوا القديمة علي بن يقطين، والحديثة خدمتنا له والله أعلم.(@)(@@) ثم قال المشرقي: عندنا كتاب سميناه كتاب الجامع، فيه جميع ما يتكلم الناس عليه عن آبائك، وانما نتكلم عليه، فقال له (7) جعفر شبيها بهذا الكلام، فأقبل على جعفر فقال: إذا كنتم لا تتكلمون بكلام ابائي عليهم السلام فبكلام أبي بكر وعمر تريدون ان تتكلموا (8)؟!(@)(@@) PageV01P352(@)(@@)(@@)(@@) $ 992 / 56 - جعفر بن قرط المزني:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 993 / 57 - جعفر بن قعنب بن أعين:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 994 / 58 - جعفر بن مازن الكاهلي:(@)(@@) الطحان، أبو عبد الله، روى عنه: حميد بن زياد، ومات في سنة أربع وستين ومائتين، وصلى عليه محمد بن إبراهيم بن محمد العلوي، رجال النجاشي (4).(@)(@@)(@@)(@@) $ 995 / 59 - جعفر بن المثنى الخطيب:(@)(@@) مولى لثقيف، كوفي، واقفي، من أصحاب الرضا عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 996 / 60 - جعفر بن المثنى بن عبد السلام:(@)(@@) ابن عبد الرحمن بن نعيم الأزدي، العطار، ثقة، من وجوه أصحابنا الكوفيين، ومن بيت آل نعيم، له كتاب نوادر، روى عنه: القاسم بن محمد ابن الحسين بن حازم، رجال النجاشي (6).(@)(@@)(@@)(@@) $ 997 / 61 - جعفر بن محمد بن إبراهيم:(@)(@@) ابن محمد بن موسى بن جعفر بن محمد 
ms116	 بن علي بن الحسين بن علي بن أبي طالب عليهم السلام، الحيري، روى عنه: التلعكبري (7)، روى عن(@)(@@) PageV01P353(@)(@@) حميد، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 998 / 62 - جعفر بن محمد بن إبراهيم:(@)(@@) ابن محمد (2) بن عبد الله بن موسى الكاظم عليه السلام (3)، العلوي، الحسيني، الموسوي، المصري، روى عنه: التلعكبري، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 999 / 63 - جعفر بن محمد:(@)(@@) أبو عبد الله، شيخ من جرجان، عامي، رجال الكشي عند ذكر سلمان الفارسي رحمه الله (5).(@)(@@)(@@)(@@) $ 1000 / 64 - جعفر بن محمد:(@)(@@) أبو محمد، روى عنه: محمد بن علي بن محبوب، الفهرست (6).(@)(@@) وفي من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 1001 / 65 - جعفر بن محمد بن إسحاق:(@)(@@) ابن رباط، أبو القاسم البجلي، شيخ، ثقة، كوفي، من أصحابنا، له(@)(@@) PageV01P354(@)(@@) كتاب الرد على الواقفة، كتاب الرد على الفطحية، كتاب نوادر، روى عنه:(@)(@@) أبو عبد الله الصفواني، رجال النجاشي (1).(@)(@@)(@@)(@@) $ 1002 / 66 - جعفر بن محمد بن إسماعيل:(@)(@@) ابن الخطاب، من أصحاب الهادي عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 1003 / 67 - جعفر بن محمد بن الأشعث (3):(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4) (5).(@)(@@)(@@)(@@) $ 1004 / 68 - جعفر بن محمد بن جعفر:(@)(@@) ابن الحسن (بن جعفر بن الحسن) (6) بن الحسن بن علي بن أبي طالب عليه السلام، أبو عبد الله، هو والد أبي قيراط، وابنه يحيى بن جعفر، روى الحديث، كان وجها في الطالبين (7)، متقدما، وكان ثقة في أصحابنا، سمع وأكثر، وعمر وعلا إسناده، له كتاب اللغوي (8)، وكتاب الصخرة والبئر،(@)(@@) PageV01P355(@)(@@) روى عنه: محمد بن عمر بن محمد الجعابي (1)، مات في سنة ثمان وثلاثمائة (2)، رجال النجاشي (3).(@)(@@) وفي الخلاصة: مات سنة ثمانين وثلاثمائة (4) (5).(@)(@@)(@@)(@@) $ 1005 / 69 - جعفر بن محمد بن جعفر:(@)(@@) ابن موسى بن قولويه، أبو القاسم، وكان أبوه يلقب مسلمة، من خيار أصحاب سعد، وكان أبو القاسم من ثقات أصحابنا، وأجلائهم في الحديث والفقه، روى عن أبيه وأخيه، عن سعد، وقال: ما سمعت من سعد إلا أربعة أحاديث، وعليه قرأ شيخنا أبو عبد 
ms117	 الله الفقه، ومنه حمل (6)، وكل ما يوصف به الناس من جميل (7) وفقه فهو فوقه، له كتب حسان، قرأت أكثر هذه الكتب على شيخنا أبي عبد الله رحمه الله وعلى الحسين بن عبيد الله رحمه الله، رجال النجاشي (8).(@)(@@) وروي عن الحسين بن عبيد الله - عند ذكر سعد بن عبد الله - أنه قال(@)(@@) PageV01P356(@)(@@) أبو القاسم جعفر بن محمد بن قولويه: أنا لم أسمع من سعد إلا حديثين (1).(@)(@@) وقال الشيخ في الفهرست: ثقة، له تصانيف كثيرة (2)، روى عنه: أبو عبد الله محمد بن محمد بن النعمان والحسين بن عبيد الله وأحمد بن عبدون، وغيرهم (3).(@)(@@) وقال في الرجال: روى عنه: التلعكبري، مات في سنة ثمان وستين وثلاثمائة، في من لم يرو عن الأئمة عليهم السلام (4).(@)(@@)(@@)(@@) $ 1006 / 70 - جعفر بن محمد بن جندب:(@)(@@) يكنى أبا محمد (5)، من أهل قزوين، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 1007 / 71 - جعفر بن محمد بن حكيم:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (7).(@)(@@) وروى الكشي عن حمدويه عن رجل: ان جعفر بن محمد بن حكيم ليس بشئ (8).(@)(@@) PageV01P357(@)(@@)(@@)(@@) $ 1008 / 72 - جعفر بن محمد الدوريستي (1):(@)(@@) أبو عبد الله، ثقة، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 1009 / 73 - جعفر بن محمد بن رباح (3):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 1010 / 74 - جعفر بن محمد بن سماعة:(@)(@@) ابن موسى، أبو عبد الله، أخو أبي محمد الحسن وإبراهيم أبي محمد (5)، وكان جعفر أكبر من إخوته (6)، ثقة في حديثه، واقف، له كتاب النوادر كبير، روى الحسن بن محمد عن أخيه جعفر، رجال النجاشي (7).(@)(@@)(@@)(@@) $ 1011 / 75 - جعفر بن محمد السنجاري:(@)(@@) لم يسمع منه حميد إلا حديثا واحدا، أخبرنا بذلك: ابن نوح، عن الحسين بن علي، عن حميد، رجال النجاشي (8).(@)(@@) PageV01P358(@)(@@) في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 1012 / 76 - جعفر بن محمد بن شريح:(@)(@@) الحضرمي، له كتاب (2)، روى عنه: محمد بن أمية بن القاسم الحضرمي، الفهرست (3).(@)(@@)(@@)(@@) $ 1013 / 77 - جعفر بن محمد بن عبيد الله:(@)(@@) له 
ms118	 كتاب (4)، روى أحمد بن أبي عبد الله عن أبيه عنه، الفهرست (5).(@)(@@)(@@)(@@) $ 1014 / 78 - جعفر بن محمد العلوي:(@)(@@) الحسيني، من ولد علي بن عبد الله بن الحسين بن علي بن الحسين ابن علي بن أبي طالب عليه السلام، يكنى أبا هاشم، روى عنه: التلعكبري، وكان قليل الرواية، وسمع منه شيئا يسيرا أبو عبد الله (6)، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 1015 / 79 - جعفر بن محمد بن عون:(@)(@@) الأسدي، وجه (8)، رجال النجاشي عند ذكر ابنه محمد بن جعفر (9).(@)(@@) PageV01P359(@)(@@)(@@)(@@) $ 1016 / 80 - جعفر بن محمد الكوفي:(@)(@@) روى عنه: محمد بن أحمد بن يحيى، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 1017 / 81 - جعفر بن محمد بن مالك (2):(@)(@@) كوفي، ثقة، ويضعفه قوم، روى في مولد القائم عليه السلام أعاجيب، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (3).(@)(@@) أبو عبد الله، كان ضعيفا في الحديث، قال أحمد بن الحسين: كان يضع الحديث وضعا (4)، ويروي عن المجاهيل، وسمعت من قال: كان أيضا فاسد المذهب والرواية.(@)(@@) ولا أدري كيف روى عنه شيخنا النبيل الثقة أبو علي بن همام وشيخنا الجليل الثقة أبو غالب الزراري رحمهما الله، له كتب، روى عنه: محمد بن همام، رجال النجاشي (5).(@)(@@) كان كذابا، متروك الحديث جملة، وكان في مذهبه ارتفاع، ويروي عن الضعفاء والمجاهيل (6)، وكل عيوب الضعفاء مجتمعة فيه، رجال ابن(@)(@@) PageV01P360(@)(@@) الغضائري (1).(@)(@@)(@@)(@@) $ 1018 / 82 - جعفر بن محمد بن مروان:(@)(@@) عن (2) إسماعيل بن إبراهيم النجار (3)، روى عنه: أبو عبد الله محمد ابن محمد بن رباط الخراز (4) الكوفي، روى عنه: ابن نوح، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 1019 / 83 - جعفر بن محمد بن مسعود:(@)(@@) العياشي، فاضل، روى عن أبيه جميع كتب أبيه، روى عنه: أبو المفضل الشيباني، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7) (8).(@)(@@)(@@)(@@) $ 1020 / 84 - جعفر بن محمد بن مفضل:(@)(@@) كوفي، يروي عنه الغلاة خاصة، وما رأيت قط له رواية صحيحة، وهو متهم في كل أحواله، رجال ابن 
ms119	 الغضائري (9).(@)(@@) PageV01P361(@)(@@)(@@)(@@) $ 1021 / 85 - جعفر بن محمد الهاشمي:(@)(@@) صيرفي، من أصحاب الجواد عليه السلام رجال الشيخ (1).(@)(@@)(@@)(@@) $ 1022 / 86 - جعفر بن محمد:(@)(@@) يكنى أبا القاسم الشاشي، من غلمان العياشي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 1023 / 87 - جعفر بن محمد بن يونس:(@)(@@) الأحول الصيرفي، مولى لبجيلة (3)، روى عن أبي جعفر الثاني [عليه السلام]، روى عنه: أحمد بن محمد بن عيسى، له كتاب نوادر، روى عنه: أحمد بن محمد بن خالد، رجال النجاشي (4).(@)(@@) ثقة، من أصحاب الجواد (5) والهادي (6) عليهما السلام، رجال الشيخ.(@)(@@) له كتاب (7)، روى أحمد بن أبي عبد الله عن أبيه عنه، الفهرست (8).(@)(@@) وفي الخلاصة أنه من أصحاب الرضا عليه السلام (9)، وفيه نظر.(@)(@@)(@@)(@@) $ 1024 / 88 - جعفر بن معروف:(@)(@@) يكنى أبا محمد، من أهل كش، وكيل، وكان مكاتبا، في من لم يرو(@)(@@) PageV01P362(@)(@@) عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@) وفي الخلاصة: والظاهر أنه ليس جعفر بن معروف السمرقندي الذي قال عنه ابن الغضائري: أنه مرتفع المذهب يعرف حديثه تارة وينكر أخرى، لأن ابن الغضائري قال: إنه يكنى أبا الفضل، قال: وكان يروي عنه العياشي كثيرا (2).(@)(@@)(@@)(@@) $ 1025 / 89 - جعفر بن معروف:(@)(@@) أبو الفضل السمرقندي، روى عنه العياشي كثيرا، كان في مذهبه ارتفاع، وحديثه يعرف تارة وينكر أخرى (3)، رجال ابن الغضائري (4).(@)(@@)(@@)(@@) $ 1026 / 90 - جعفر بن ميمون:(@)(@@) قال الكشي: ما روي في موسى بن أشيم وحفص بن ميمون وجعفر ابن ميمون، حمدويه بن نصير قال: حدثنا أيوب بن نوح، عن حنان بن سدير، عن الصادق عليه السلام قال: لأنفس (5) على أجساد أصيبت (6) معه يعني: أبا الخطاب النار، ثم ذكر ابن الأشيم، فقال (7): يأتيني فيدخل علي هو وصاحبه وحفص بن ميمون، ويسألوني فأخبرهم بالحق، ثم يخرجون من عندي إلى أبي الخطاب، فيخبرهم بخلاف قولي، فيأخذون بقوله ويذرون قولي (8).(@)(@@) PageV01P363(@)(@@) وفي رجال ابن داود راويا عن كش: جعفر بن شمون (1). وهو غلط.(@)(@@)(@@)(@@) $ 1027 / 91 - جعفر بن ناجية بن أبي عمارة:(@)(@@) الكوفي، مولى، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 1028 / 92 - جعفر بن نجيح المدني:(@)(@@) جد 
ms120	 علي بن المثنى (3)، من أصحاب الصادق عليه السلام، رجال الشيخ (4) (5).(@)(@@)(@@)(@@) $ 1029 / 93 - جعفر بن واقد:(@)(@@) قال الكشي: حدثني محمد بن قولويه والحسين بن الحسن (6) بن بندار القمي، قالا: حدثنا سعد بن عبد الله، قال: حدثني إبراهيم بن مهزيار ومحمد بن عيسى بن عبيد، عن علي بن مهزيار، قال: سمعت الباقر عليه السلام يلعن جعفر بن واقد (7) الخلاصة (8)(@)(@@)(@@)(@@) $ 1030 / 94 - جعفر الوراق:(@)(@@) له نوادر (9)، روى عنه: حميد، الفهرست (10).(@)(@@) PageV01P364(@)(@@) جعفر بن الوراق، روى عنه: حميد، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 1031 / 95 - جعفر بن ورقاء بن محمد:(@)(@@) ابن ورقاء، أبو محمد، أمير بني شيبان بالعراق ووجههم، وكان عظيما عند السلطان، وكان صحيح المذهب، له كتاب في إمامة أمير المؤمنين عليه السلام وتفضيله على أهل البيت عليهم السلام، روى عنه أبو أحمد إسماعيل بن يحيى بن أحمد القيسي (2)، رجال النجاشي (3).(@)(@@) وفي رجال ابن داود: أمين بني شيبان (4) (5).(@)(@@) وفي الخلاصة كما في النجاشي (6).(@)(@@)(@@)(@@) $ 1032 / 96 - جعفر بن هارون الكوفي:(@)(@@) يكنى أبا عبد الله، ثقة، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 1033 / 97 - جعفر بن الهذيل:(@)(@@) له نوادر، روى عنه: حميد بن زياد (8)، رجال النجاشي (9).(@)(@@) PageV01P365(@)(@@) جعفر الهذلي: له نوادر (1)، روى عنه: حميد، الفهرست (2) (3).(@)(@@) والظاهر أنهما واحد.(@)(@@)(@@)(@@) $ 1034 / 98 - جعفر بن هشام:(@)(@@) من أصحاب الهادي عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 1035 / 99 - جعفر بن يحيى بن سعد:(@)(@@) الأحول، خال الحسين بن سعيد، من أصحاب الجواد عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 1036 / 100 - جعفر بن يحيى بن العلاء (6):(@)(@@) أبو محمد الرازي، ثقة، وأبوه أيضا، روى أبوه (7) عن الصادق عليه السلام، وهو أخلط بنا من أبيه، وأدخل فينا، وكان أبوه يحيى بن العلاء قاضيا بالري، وكتابه يختلط بكتاب أبيه، لأنه يروي كتاب أبيه عنه، فربما نسب إلى أبيه، وربما نسب إليه، روى عنه: موسى بن الحسين (8) بن موسى، رجال النجاشي (9).(@)(@@) PageV01P366(@)(@@)(@@)(@@) $ 1037 / 1 - جعيد الهمداني (1):(@)(@@) من أصحاب علي (2) والحسن (3) والحسين (4) وعلي بن الحسين (5) عليهم السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 1038 / 1 - جعيل الأشجعي:(@)(@@) من أصحاب الرسول صلى 