ms968	 كلها موقف)) (ت) عن علي.(@)(@@) (13031) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه عمرة استمتعنا بها: فمن لم يكن عنده الهدي فليحل الحل كله فإن العمرة قد دخلت في الحج إلى يوم القيامة)) (حم م) عن ابن عباس.(@)(@@) (13032) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه معاتبة الله لعبده بما يصيبه من الحمى والنكبة حتى البضاعة يضعها في كم قميصه فيفقدها فيفرغ لها حتى إن العبد ليخرج من ذنوبه كما يخرج التبر الأحمر من الكير)) (ت) عن عائشة.(@)(@@) (13033) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه وه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه سواء، يعني الخنصر والإبهام)) (حم خ ت ن ه) عن ابن عباس.(@)(@@) (13034) ((هاشم والمطلب كهاتين، لعن الله من فرق بينهما، ربونا صغارا، وحملونا كبارا)) (هق) عن زيدبن علي مرسلا.(@)(@@) PageV03P274(@)(@@) (13035) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; كذا الوضوء، فمن زاد على ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذا أو نقص فقد أساء وظلم)) (حم د ن ه) عن ابن عمرو.(@)(@@) (13036) (( (ز) هكذا فإنما الاستئذان من النظر)) (د) عن سعد.(@)(@@) (13037) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; كذا نبعث يوم القيامة)) (ت ه ك) عن ابن عمر.(@)(@@) (13038) ((هاهنا أحد من بني فلان إن صاحبكم مأسور بدينه)) (حمد) عن سمرة.(@)(@@) (13039) ((هاهنا أرض الفتن حيث يطلع قرن الشيطان)) (ت) عن ابن عمر.(@)(@@) (13040) ((هاهنا تكسب العبرات، يعني عند الحجر)) (ه ك) عن ابن عمر.(@)(@@) (13041) ((هجاهم حسان فشفى واستشفى)) (م) عن عائشة.(@)(@@) (13042) ((هجر المسلم أخاه كسفك دمه)) (ابن قانع) عن أبي حدرد.(@)(@@) (13043) ((هدايا العمال حرام كلها)) (ع) عن حذيفة.(@)(@@) (13044) ((هدايا العمال غلول)) (حم هق) عن أبي حميد الساعدي.(@)(@@) (13045) ((هدية الله تعالى إلى المؤمن السائل على بابه)) (خط في رواة مالك) عن ابن عمر.(@)(@@) (13046) ((هدم المتعة النكاح، والطلاق، والعدة، والميراث)) (حب) عن أبي هريرة.(@)(@@) (13047) ((هل أنت إلا إصبع دميت، وفي سبيل الله ما لقيت)) (حم ق ت ن) عن جندب البجلي.(@)(@@) (13048) (( (ز) هل أنتم تاركو لي أمرائي لكم صفوة أمرهم وعليهم كد