ms10310	 وداود بن أبي هند، ويونس مقلوبة [102] .(@)(@@)(@@)(@@) | 327 - (@)(@@) عبيد الله بن أبي حميد، وهو ابن غالب بصري عن أبي المليح [103] .(@)(@@)(@@)(@@) | 328 - (@)(@@) عبد الرحمن بن زيد عن أبيه عبد الرحمن بن عبد الله العمري عن أبيه، وعمه سعيد، وأخيه القاسم، متروك.(@)(@@) PageV29P051(@)(@@)(@@)(@@) | 329 - (@)(@@) عبد الرحمن بن قيس الزعفراني، أبو معاوية بصري خرج إلى نيسابور، عن شعبة، والثوري، وحميد، ومحمد بن عمرو [104] .(@)(@@)(@@)(@@) | 330 - (@)(@@) عبد الرحمن بن مالك بن مغول، كوفي عن أبيه، وعبيد الله بن عمر [105] .(@)(@@)(@@)(@@) | 331 - (@)(@@) عبد الرحمن بن مسهر، أخو علي بن مسهر عن أبي سعد البقال وهشام بن عروة، وأخوه ثقة.(@)(@@)(@@)(@@) | 332 - (@)(@@) عبد الرحمن بن يزيد بن تميم، شامي أبو أسامة يغلط في نسبه يروي عن الزهري، وإسماعيل بن عبيد الله بن أبي المهاجر الدمشقي، وإسماعيل هذا ثقة.(@)(@@)(@@)(@@) | 333 - (@)(@@) عبد الرحمن بن زياد بن أنعم الإفريقي، ليس بالقوي.(@)(@@)(@@)(@@) | 334 - (@)(@@) عبد الرحمن بن إسحاق بن الحارث أبو شيبة [106] واسطي عن النعمان بن سعد، عن أبيه، لا يعرف إلا به.(@)(@@)(@@)(@@) | 335 - (@)(@@) عبد الرحمن بن محمد بن عبيد الله العزرمي، أخو إسحاق، وإسحاق متروك أيضا، ولهما أخ ثالث يسمى حسن له مقاطيع يعتبر به.(@)(@@)(@@)(@@) | 336 - (@)(@@) عبد الرحمن بن أبي المليكي، ابن أخي بن أبي مليكة عن ابن أبي مليكة، والزهري [107] .(@)(@@)(@@)(@@) | 337 - (@)(@@) عبد الرحمن بن إسحاق، يعرف بعباد، يرمى بالقدر ضعيف الحديث روى عن الزهري، روى عنه إبراهيم بن طهمان، وأسماء، وعباد، والبصريون رووا فقالوا عبد الرحمن ابن إسحاق [108] .(@)(@@)(@@)(@@) | 338 - (@)(@@) عبد الرحيم بن زيد العمي، بصري عن أبيه، أبوه صالح [109] .(@)(@@)(@@)(@@) | 339 - (@)(@@) عبد الواحد بن زيد القاضي، بصري عن الحسن، وثابت [110] .(@)(@@)(@@)(@@) | 340 - (@)(@@) عبد الواحد بن قيس.(@)(@@)(@@)(@@) | 341 - (@)(@@) عبد الواحد بن ميمون، أبو حمزة مدني، عن عروة [111] .(@)(@@)(@@)(@@) | 342 - (@)(@@) عبد الوهاب بن مجاهد، مكي، عن أبيه، وعطاء [112] .(@)(@@)(@@)(@@) | 343 - (@)(@@) عبد الوهاب بن الضحاك العرضي، حمصي عن إسماعيل بن أبي عياش له مقلوبات وبواطيل.(@)(@@)(@@)(@@) | 344 - (@)(@@) عبد الأعلى بن أبي المساور، كوفي عن حماد، والشعبي [113] .(@)(@@)(@@)(@@) | 345 - (@)(@@) عبد العزيز بن أبان، أبو خالد القرشي كوفي عن الثوري [114] .(@)(@@)(@@)(@@) | 346 - (@)(@@) عبد العزيز بن عمران 
ms10311	 أبو ثابت الزهري مدني [115] .(@)(@@) PageV29P052(@)(@@)(@@)(@@) | 347 - (@)(@@) عبد العزيز بن عبد الرحمن البالسي عن خصيف [116] .(@)(@@)(@@)(@@) | 348 - (@)(@@) عبد الحميد بن سليمان مدني، أخو فليح عن أبي حازم، وأخوه ثقة.(@)(@@)(@@)(@@) | 349 - (@)(@@) عبد الحميد بن الحسن الهلالي، كوفي حدث بالبصرة عن أبي إسحاق، وعبد الملك بن عمير [117] .(@)(@@)(@@)(@@) | 350 - (@)(@@) عبد الصمد بن سليمان الواسطي، الأزرق، ضعيف عن الضعفاء عن سليمان بن أبي سراج، وخصيب بن جحدر متروك.(@)(@@)(@@)(@@) | 351 - (@)(@@) عبد الرزاق بن عمر، الشامي ضعيف.(@)(@@)(@@)(@@) | 352 - (@)(@@) عبد الجبار بن عمر الأيلي، ضعيف.(@)(@@)(@@)(@@) | 353 - (@)(@@) عبد الغفار بن القاسم، أبو مريم كوفي ضعيف حدث عنه شعبة ولعله لم يخبره.(@)(@@)(@@)(@@) | 354 - (@)(@@) عبد الغفور بن عبد العزيز بن سعيد، أبو الصباح الواسطي له عن أبي هاشم الرماني نسخة.(@)(@@)(@@)(@@) | 355 - (@)(@@) عبد الخالق بن زيد بن واقد دمشقي، عن أبيه، وأبوه ثقة روى عن حزام بن حكيم، ومكحول [118] .(@)(@@)(@@)(@@) | 356 - (@)(@@) عبد المنعم بن إدريس بن سنان، سكن بغداد، عن أبيه، وأبوه متروك عن وهب ابن منبه [119] .(@)(@@)(@@)(@@) | 357 - (@)(@@) عبد المنعم بن نعيم أبو سعيد بصري رياحي، عن يحيى بن مسلم مجهول لا يعرف إلا به، وعن الأعمش [120] .(@)(@@)(@@)(@@) | 358 - (@)(@@) عبد الكريم بن أبي المخارق، أبو أمية البصري، عن نافع، وابن سيرين، والحسن، يروي عنه ابن أبي ليلى. ويروي عنه، وعن الجزري الثوري، وابن جريج يرويان عنه، وعن عبد الكريم الجزري [121] .(@)(@@)(@@)(@@) | 359 - (@)(@@) عبد الملك بن هارون بن عنترة الكوفي، روى عن حبيب بن أبي ثابت، وأبي إسحاق [122] .(@)(@@)(@@)(@@) | 360 - (@)(@@) عبد الملك بن حسين أبو مالك النخعي، عن البصريين، والكوفيين.(@)(@@)(@@)(@@) | 361 - (@)(@@) عبد السلام بن أبي الجنوب، عن الزهري، وخالد بن قدامة.(@)(@@)(@@)(@@) | 362 - (@)(@@) عبد القدوس بن حبيب، شامي أبو سعيد عن الشعبي، وعكرمة، والحسن، والزهري [123] .(@)(@@)(@@)(@@) | 363 - (@)(@@) علاء بن زيدل، بصري عن أنس.(@)(@@)(@@)(@@) | 364 - (@)(@@) علاء بن زيد، أيضا، متروك من أهل البصرة.(@)(@@)(@@)(@@) | 365 - (@)(@@) عمر بن هارون البلخي، ضعيف.(@)(@@) PageV29P053(@)(@@)(@@)(@@) | 366 - (@)(@@) عمر بن رياح الضرير بصري، ويقال عمر بن أبي عمر عن ابن طاوس، وهشام ابن عروة [124] .(@)(@@)(@@)(@@) | 367 - (@)(@@) عمر بن حفص أبو حفص بصري، عن ثابت، ويزيد الرقاشي.(@)(@@)(@@)(@@) | 368 - (@)(@@) عمر بن إسماعيل بن 
ms10312	 مجالد، بغدادي عن أبيه، وأبي معاوية، ويحيى الأموي.(@)(@@)(@@)(@@) | 369 - (@)(@@) عمر بن موسى بن وجيه الوجيهي، كوفي عن أبي الزبير، وأبي إسحاق، وقتادة، يروي عنه يحيى بن يعلى الأسلمي، فيقول: عن عبيد الله بن موسى، وقيل: إنه عمر هذا [125] .(@)(@@)(@@)(@@) | 370 - (@)(@@) عمر بن سعيد أبو حفص الدمشقي، عن سعيد بن عبد العزيز، وسعيد بن بشير بواطيل.(@)(@@)(@@)(@@) | 371 - (@)(@@) عمر بن صالح بن أبي الزاهرية واسطي عن أبي حمزة.(@)(@@)(@@)(@@) | 372 - (@)(@@) عمر بن غياث، وقيل: عمرو كوفي، عن عاصم، وعبد الملك بن عمير [126] .(@)(@@)(@@)(@@) | 373 - (@)(@@) عمر بن عبد الله بن يعلى بن مرة الثقفي، عن أبيه عن جده، وأبوه لا يعرف إلا به، وروى أيضا عن زياد بن علاقة عن المنهال بن عمرو [127] .(@)(@@)(@@)(@@) | 374 - (@)(@@) عمر بن محمد بن صهبان، مدني عن الزهري، وأبي حازم [128] .(@)(@@)(@@)(@@) | 375 - (@)(@@) عمر بن قيس. سندل مكي، عن الزهري، وعطاء، وعمرو بن دينار.(@)(@@)(@@)(@@) | 376 - (@)(@@) عمر بن راشد اليمامي، عن يحيى بن أبي كثير.(@)(@@)(@@)(@@) | 377 - (@)(@@) عمير بن عمران الحنفي، عن علاء بن خالد، والعلاء يعتبر به.(@)(@@)(@@)(@@) | 378 - (@)(@@) عمارة بن جوين، أبو هارون العبدي متلون خارجي، وشيعي، يصلح أن يعتبر له بما يرويه عنه الثوري، والحمادان [129] .(@)(@@)(@@)(@@) | 379 - (@)(@@) عمارة بن زاذان الصيدلاني، بصري عن ثابت، وأبي غالب حزور [130] .(@)(@@)(@@)(@@) | 380 - (@)(@@) عباد بن جويرية بصري، عن الأوزاعي.(@)(@@)(@@)(@@) | 381 - (@)(@@) عباد بن كثير بصري، نزل مكة عن الحسين.(@)(@@)(@@)(@@) | 382 - (@)(@@) عباد بن كثير، رملي فلسطيني، عن البصريين، وعن قتيلة عن ابنها.(@)(@@)(@@)(@@) | 383 - (@)(@@) عمرو بن جابر أبو زرعة، مصري تابعي عن جابر.(@)(@@)(@@)(@@) | 384 - (@)(@@) عمرو بن جميع، كوفي، وكان بحلوان.(@)(@@)(@@)(@@) | 385 - (@)(@@) عمرو بن عطية العوفي، ضعيف.(@)(@@)(@@)(@@) | 386 - (@)(@@) عمرو بن أبي روق [131] .(@)(@@)(@@)(@@) | 387 - (@)(@@) عطية بن الحارث، ضعيف.(@)(@@) PageV29P054(@)(@@)(@@)(@@) | 388 - (@)(@@) عمرو بن الحصين العقيلي، متروك عن الأعمش، ويحيى بن سعيد، وابن جريج.(@)(@@)(@@)(@@) | 389 - (@)(@@) عمرو بن زياد الثوباني، يضع الحديث.(@)(@@)(@@)(@@) | 390 - (@)(@@) عمرو بن عثمان الكلابي، ضعيف.(@)(@@)(@@)(@@) | 391 - (@)(@@) عمرو بن واقد دمشقي، عن عمر بن يزيد البصري، ويونس بن ميسرة [132] .(@)(@@)(@@)(@@) | 392 - (@)(@@) عمرو بن الأزهر بصري، قاضي جرجان كذاب، عن البصريين.(@)(@@)(@@)(@@) | 393 - (@)(@@) عبيد بن القاسم كوفي ضعيف.(@)(@@)(@@)(@@) | 394 - (@)(@@) عبيد 
ms10313	 بن إسحاق العطار، كوفي ضعيف.(@)(@@)(@@)(@@) | 395 - (@)(@@) عمرو بن جرير أبو سعيد البجلي، كوفي، عن محمد بن عمرو، وإسماعيل بن أبي خالد [133] .(@)(@@)(@@)(@@) | 396 - (@)(@@) عمرو بن قائد بصري، قد روى عن بصريين، ومكيين، ومدنين.(@)(@@)(@@)(@@) | 397 - (@)(@@) عمرو بن شمر أبو عبد الله، كوفي، عن جابر، وعن جعفر بن محمد.(@)(@@)(@@)(@@) | 398 - (@)(@@) عمرو بن عبيد أبو عثمان، بصري عن الحسن.(@)(@@)(@@)(@@) | 399 - (@)(@@) عمرو بن ثابت بن هرمز، أبو المقدام، كوفي [134] .(@)(@@)(@@)(@@) | 400 - (@)(@@) عمرو بن خالد أبو خالد الواسطي، كذاب، عن أبي هاشم الرماني، وزيد بن علي.(@)(@@)(@@)(@@) | 401 - (@)(@@) عثمان بن عبد الرحمن يعرف بالوقاصي مدني، عن الزهري، وابن أبي مليكة.(@)(@@)(@@)(@@) | 402 - (@)(@@) عثمان بن مقسم البري بصري، أبو سلمة عن يحيى بن سعيد، وهشام بن عروة [135] .(@)(@@)(@@)(@@) | 403 - (@)(@@) عثمان بن عمير أبو اليقظان، كوفي، عن أبي الطفيل، وسعيد بن جبير.(@)(@@)(@@)(@@) | 404 - (@)(@@) عثمان بن مطر بصري، عن ثابت(@)(@@)(@@)(@@) | 405 - (@)(@@) علي بن يزيد الدمشقي، أبو عبد الملك بن القاسم.(@)(@@)(@@)(@@) | 406 - (@)(@@) علي بن أبي علي اللهبي، مكي، عن ابن المنكدر، وجعفر بن محمد، والزهري.(@)(@@)(@@)(@@) | 407 - (@)(@@) علي بن حزور، وهو ابن أبي فاطمة، كوفي عن أصبغ بن نباتة، وأبي مريم الحنفي [136] .(@)(@@)(@@)(@@) | 408 - (@)(@@) علي بن ظبيان، كوفي عن عبيد الله بن عمر، وأبي حنيفة.(@)(@@)(@@)(@@) | 409 - (@)(@@) عاصم بن سليمان الكوزي، بصري كذاب، عن هشام، وغيره.(@)(@@)(@@)(@@) | 410 - (@)(@@) عيسى بن أبي عيسى الحناط، مدني، عن الشعبي، وأخوه موسى بن أبي عيسى صالح الحديث واسم أبي عيسى ميسرة [137] .(@)(@@) PageV29P055(@)(@@)(@@)(@@) | 411 - (@)(@@) عيسى بن ميمون، عن القاسم بن محمد، وهشام بن عروة.(@)(@@)(@@)(@@) | 412 - (@)(@@) فأما عيسى بن ميمون المكي، فهو ثقة يعرف بابن دايه يروي عن ابن أبي نجيح سكن البصرة(@)(@@)(@@)(@@) | 413 - (@)(@@) عيسى بن قرطاس، كوفي عن عكرمة، والنخعي.(@)(@@)(@@)(@@) | 414 - (@)(@@) عيسى بن هاشم البري، أبو معاوية(@)(@@)(@@)(@@) | 415 - (@)(@@) عيسى بن المسيب، كوفي، عن عطية، والشعبي.(@)(@@)(@@)(@@) | 416 - (@)(@@) عيسى بن مهران المستعطف، بغدادي، رجل سوء ومذهب سوء، روى عنه ابن جرير الطبري [138] .(@)(@@)(@@)(@@) | 417 - (@)(@@) عنبسة بن سعيد أخو الربيع السمان أشعث بن سعيد، ضعيف، عن الزهري(@)(@@)(@@)(@@) | 418 - (@)(@@) عيسى بن ميمون بصري، أبو عبيدة عن يزيد الرقاشي، ويحيى 
ms10314	 بن أبي كثير.(@)(@@)(@@)(@@) | 419 - (@)(@@) عنبسة بن عبد الرحمن القرشي، أظنه بغدادي عن زيد بن أسلم، وعبد الله بن نافع.(@)(@@)(@@)(@@) | 420 - (@)(@@) عقبة بن عبد الله الرفاعي، الأصم بصري عن عطاء بن أبي رباح، والحسن.(@)(@@)(@@)(@@) | 421 - (@)(@@) عطاء بن عجلان بصري، عن أنس، وأبي ضمرة [139] .(@)(@@)(@@)(@@) | 422 - (@)(@@) عباس بن بكار الضبي بصري، كذاب(@)(@@)(@@)(@@) | 423 - (@)(@@) عباس بن الفضل الأنصاري موصلي، ضعيف.(@)(@@)(@@)(@@) | 424 - (@)(@@) عطاف بن خالد المخزومي مدني، ضعيف [140] .(@)(@@) ---------------------------------------------------------------------- ----------(@)(@@) [1] قال ابن حجر: "كذبه الشعبي في رأيه ورمي بالرفض. وفي حديث ضعف"- على- تقريب التهذيب 60(@)(@@) [2] ضعيف رماه ابن حبان بالوضع من التاسعة –ق - تقريب التهذيب60(@)(@@) [3] متروك من الثامنة - ت ق - تقريب التهذيب 61(@)(@@) [4] لسان الميزان 2/ 152.(@)(@@) [5] لسان الميزان 2/149.(@)(@@) [6] ميزان الاعتدال 1/432.(@)(@@) [7] قال ابن حجر: "قال الدارقطني مجهولان لسان الميزان 2/149.(@)(@@) [8] قال الذهبي: "ضعفوه ولم يترك"ديوان 71(@)(@@) [9] انظر ميزان الاعتدال 1/598.(@)(@@) [10] قال ابن حجر: "حماد بن عيسى بن عبيد غرق بالجحفة سنة ثمان ومائتين"تقريب التهذيب 82(@)(@@) PageV29P056(@)(@@) [11] قال ابن حجر: "حفص بن عمر الفرخ بالفاء وسكون الراء والخاء المعجمة"تقريب التهذيب 78(@)(@@) [12] قال الذهبي: "قال الدارقطني متروك" ميزان الاعتدال 1/456(@)(@@) [13] قال الإمام أحمد: "ترك الناس حديثه" ميزان الاعتدال 1/468(@)(@@) [14] قال الذهبي: "قال الدارقطني ضعيف". ديوان 49.(@)(@@) [15] قال ابن حجر: متروك من الثامنة -ت- تقريب التهذيب 76.(@)(@@) [16] قال الذهبي: "قال الدارقطني متروك" ميزان الاعتدال 1/606.(@)(@@) [17] قال الذهبي: "قال الدارقطني متروك"ميزان الاعتدال 1/477.(@)(@@) [18] قال ابن حجر: "تركه وكيع وابن حنبل". لسان الميزان 2/203.(@)(@@) [19] قال ابن حجر: متروك من الثامنة -ت ق- تقريب التهذيب 71.(@)(@@) [20] قال الذهبي: "كذبه ابن معين". ديوان 57.(@)(@@) [21] قال ابن حجر: ضعيف من الثامنة -ت ق- تقريب التهذيب 71.(@)(@@) [22] ميزان الاعتدال1/482.(@)(@@) [23] قال البخاري: "منكر الحديث". التاريخ الكبير 2/1/288(@