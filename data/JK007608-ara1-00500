ms481	 بروعات الحزن % % 55(@)(@@) % زدن الرزايا فنقصن دفعة % % ووطن القلب عليها ، فاطمأن % 56(@)(@@) % قل للزمان : ارحل بهم من بازل % واحمل على غاربه فقد مرن % % PageV01P1697 البحر : متقارب تام 1(@)(@@) % نعوه على ضن قلبي به % % فلله ماذا نعى الناعيان % % 2(@)(@@) % رضيع ولاء له شعبة % % من القلب فوق رضيع اللبان % % 3(@)(@@) % بكيتك للشرد السائرا % % ت تعبق ألفاظها بالمعاني % % 4(@)(@@) % مواسم تعلط منها الجباه % % بأشهر من مطلع الزبرقان % % 5(@)(@@) % جوائف تبقى أخاديدها % % عماقا وتعفو ندوب الطعان % % 6(@)(@@) % تبض إلى اليوم آثارها % % بأحمر من عاند الطعن قاني % % 7(@)(@@) % قعاقعهن تشن الحتوف % % إذا هن أوعدن لا بالشنان % % 8(@)(@@) % وما كنت أحسب أن المنون % % تفل مضارب ذاك اللسان % 9(@)(@@) % لسان هو الأزرق القعضبي % تمضمض من ريقة الأفعوان % % 10(@)(@@) % له شفتا مبرد الهالكي % أنجى بجانبه غير واني % % PageV01P1698 11(@)(@@) % إذا لز بالعرض مبراته % % تصدع صدع الرداء اليماني % % 12(@)(@@) % يرى الموت أن قد طوى مضغة % ولم يطو إلا غراري سنان % 13(@)(@@) % فأين تسرعه للنضال % وهباته للطوال اللدان % % 14(@)(@@) % يشل الجوائح شل السياط % ويلوي الجوانح لي العنان % 15(@)(@@) % فإن شاء كان حران الجماح % وإن شاء كان جماح الحران % % 16(@)(@@) % يهاب الشجاع غذاميره % على البعد منه مهاب الجبان % % 17(@)(@@) % وتعنو الملوك له خيفة % % إذا راع قبل اللظى بالدخان % 18(@)(@@) % وكم صاحب كمناط الفؤاد % % عناني من يومه ما عناني % % 19(@)(@@) % قد انتزعت من يدي المنون % % ولم يغن ضمي عليه بناني % % 20(@)(@@) % فزل كزيال الشباب الرطي % % ب خانك يوم لقاء الغواني % % PageV01P1699 21(@)(@@) % ليبك الزمان طويلا عليك % فقد كنت خفة روح الزمان % PageV01P1700 البحر : رجز تام 1(@)(@@) % أقول والأقدار ترتمينا % % والدهر لا يحفل ما لقينا % % 2(@)(@@) % ما بال قلبي يطلب الحنينا % % وجد القرين افتقد القرينا % % 3(@)(@@) % وما لدمعي يقرب الشؤونا % % قد كاد أن يطلع الجفونا % % 4(@)(@@) % من خبر لا جاءنا يقينا % % بأن عين الكرم اليمينا % % 5(@)(@@) % تقذى وقد أقرت العيونا % % قلوبنا أسمعننا الأنينا % % 6(@)(@@) % وقمن يا آمالنا ، فابكينا % % هيهات يلقى من زمان لينا % % 7(@)(@@) % لا نهضت عن مثله السنونا % % أعيا العقيم أن ترى البنينا % % 8(@)(@@) % يا من 
ms482	 لنا اليوم نلاقي الهونا % % يؤمنا بعدك أو يأبونا % % 9(@)(@@) % أم من على أيامنا يعدينا % % ويعكس السهم إلى رامينا % % 10(@)(@@) % أم من يعيد النعم العزينا % % جوافلا تشجر بالقنينا % % PageV01P1701 11(@)(@@) % شجر المداري القطط الدهينا % % الله يا ريب الزمان فينا % % 12(@)(@@) % ابق على الدنيا وحاب الدينا % % ما لك لا تنظرنا الديونا % % 13(@)(@@) % تأتخذ منا كل ما تعطينا % % لا غضت ذاك الثغب المعينا % % 14(@)(@@) % يا ليته يوقى ، ولا وقينا % % بين يديه نرد المنونا % % 15(@)(@@) % لا كان ما نحذر أن يكونا % % PageV01P1702 البحر : بسيط تام 1(@)(@@) % لواعج الشوق تخطيهم وتصميني % % واللوم في الحب ينهاهم ويغريني % % 2(@)(@@) % ولو لقوا بعض ما ألقى نعمت بهم % % لكنهم سلموا مما يعنيني % % 3(@)(@@) % وبالكثيب إلى الأجزاع نازلة % علقت منها بوعد غير مضمون % % 4(@)(@@) % ما سوغوني برد الماء مذ حظروا % % علي برد اللمى والشوق يظميني % % 5(@)(@@) % يا منشظ الشيح والحوذان من يمن % حييت فيك غزالا لا يحييني % % 6(@)(@@) % ترى الغريم الذي طال اللزوم له % % في الحي مول من بعدي فيقضيني % % 7(@)(@@) % إن الخلي ، غداة الجزع ، عيد به % % إلى ضمير معنى اللب مفتون % 8(@)(@@) % لولا ظباء معاطيل سنحن لنا % % ما كان يذهل عن عقل وعن دين % 9(@)(@@) % قد كاد ينجو بجد من عزيمته % فعارضته عيون الربرب العين % 10(@)(@@) % ماء النقيب ، ولو مقدار مضمضة % شفاء وجدي ، وغير الماء يشفيني % % PageV01P1703 11(@)(@@) % ونشقة من نسيم البان فاح بها % % جنح من الليل تجري في العرانين % 12(@)(@@) % أسقى دموعي إذا ما بات في سدف % صرير أثل بداريا يغنيني % % 13(@)(@@) % وصاحب وقذ التهويم هامته % % ناديته ورواق الليل يؤويني % % 14(@)(@@) % فقام قد غرغرت في رأسه شده % % يمضي على الكره أمري أو يلبيني % % 15(@)(@@) % لا غر قومك ، كم نوم على ضمد % سقما ولو بطرير الغرب مسنون % 16(@)(@@) % وضاربات بلحييها على أضم % من اللغوب نحاف كالعراجين % 17(@)(@@) % أبلى أزمتها بعد المدى ، وغدت % من الوجى بين معقول ومرسون % 18(@)(@@) % مغرورقات المآقي كلما نظرت % % برقا يضيء كفاف الغر والجون % 19(@)(@@) % هيهات بابل من نجد لقد بعدت % على المطي ، مرامي ذلك البين % 20(@)(@@) % سلني عن 
ms483	 الوجد إني ، كل شارقة % يريشني الوجد ، والأيام تبريني % % PageV01P1704 21(@)(@@) % من لي ببلغة عيش غير فاضلة % % تكفني عن قذى الدنيا وتكفيني % % 22(@)(@@) % أخي ، من باع دنياه وزخرفها % % بصونه ، كان عندي غير مغبون % 23(@)(@@) % قالوا : أتقنع بالدون الخسيس ، وما % % قنعت بالدون بل قنعت بالدون % 24(@)(@@) % إذا ظننا وقدرنا جرى قدر % بنازل غير موهوم ومظنون % 25(@)(@@) % أعجب لمسكة نفس بعدما رميت % من النوائب بالأبكار والعون % 26(@)(@@) % ومن نجائي ، يوم الدار ، حين هوى % % غيري ولم أخل من حزم ينجيني % % 27(@)(@@) % مرقت منها مروق النجم منكدرا % وقد تلاقت مصاريع الردى دوني % % 28(@)(@@) % وكنت أول طلاع ثنيتها % % ومن ورائي شر غير مأمون % % 29(@)(@@) % من بعد ما كان رب الملك مبتسما % إلي ادنوه في النجوى ويدنيني % % 30(@)(@@) % أمسيت أرحم من أصبحت أغبطه % % لقد تقارب بين العز والهون % % PageV01P1705 31(@)(@@) % ومنظر كان بالسراء يضحكني % % يا قرب ما عاد بالضراء يبكيني % % 32(@)(@@) % هيهات أغتر بالسلطان ثانية % قد ضل ولاج أبواب السلاطين % % 33(@)(@@) % ما للحمام غدا ، فاعتام زافرتي % % واختار ما كان يعطيني ويمطيني % % 34(@)(@@) % خلى علي مرارات الحيا ومضت % % أحداثه بالمطاعيم المطاعين % % 35(@)(@@) % يشجعون علي الدهر إن جبنت % % خطوبه ، وتوقى أن يناديني % % 36(@)(@@) % إذا رأوا مده نحوي يدا وضعوا % % فيها عظام جلاميد لترميني % % 37(@)(@@) % أقارب لم يزل بي شر عرقهم % عرق من اللؤم يعديهم ويعدوني % % 38(@)(@@) % تملحوا بي كأني حمضة قطعت % لا بد بعد مدى أن يستمروني % % 39(@)(@@) % عزوا إلي نصابا بعد تشظية % وألصقوا بي أديما بعد تعييني % % 40(@)(@@) % هبوا أصولكم أصلي على مضض % ما تصنعون بأخلاق تنافيني % % PageV01P1706 41(@)(@@) % أعطاكم السجل قبل النهر غرفته % % فارضوا بروق جمامي واستجموني % % 42(@)(@@) % كم الهوان كأني بينكم جمل % في كل يوم قطيع الذل يحدوني % % 43(@)(@@) % لا تأمنن عدوا لان جانبه % % خشونة الصل عقبى ذلك اللين % % 44(@)(@@) % واحذر شرارة من أطفأت جمرته % % فالثار غض ، وإن بقي إلى حين % 45(@)(@@) % أنى تهيب بي البقيا وأتبعها % % فلم أباق بها من لا يباقيني % % 46(@)(@@) % توقعوها ، فقد شبت بوارقها % % بعارض كصريم الليل مدجون % % 47(@)(@@) % إذا غدا الأفق الغربي مختمرا % من 
ms484	 الغبار فظنوا بي وظنوني % % 48(@)(@@) % لتنظرني مشيحا في أوائلها % % يغيب بي النقع أحيانا ويبديني % % 49(@)(@@) % لا تعرفوني إلا بالطعان إذا % % أضحى لثامي معصوبا بعرنيني % % 50(@)(@@) % أقدام غضبان كظته ضغائنه % % فمال يخلط مضروبا بمطعون % PageV01P1707 51(@)(@@) % فإن أصب فمقادير محجزة % % وإن أصب ، فعلى الطير الميامين % PageV01P1708 البحر : بسيط تام 1(@)(@@) % أسل بدمعك وادي الحي ، إن بانوا % % إن الدموع على الأحزان أعوان % % 2(@)(@@) % لا عذر بعد تنائي الدار من سكن % % لمدعي الوجد لم يدمع له شان % 3(@)(@@) % حي الطوالع من نجد تصونهم % عن النواظر ، أنماط وكيران % 4(@)(@@) % رموا جيوب المطالي عن ميامنهم % % وشيحة الحزن يسراهم ونجران % % 5(@)(@@) % سارت بقلبك في الأحشاء زفرته % % واستوقفتك بأعلى الرمل أظعان % 6(@)(@@) % لما مررنا على تلك السروب ضحى % % نضت إلى الربع أجياد وأعيان % 7(@)(@@) % من كل غيداء قد مال النعيم بها % % كما تخايل بالبردين نشوان % 8(@)(@@) % كأنما انفرجت عنهم قبابهم % يوم الأنيعم آجال وصيران % % 9(@)(@@) % مستشرفات يعرضن الخدود لنا % % كما تشوف صوب المزن غزلان % 10(@)(@@) % لا يذكر الرمل إلا حن مغترب % % له بذي الرمل أوطار وأوطان % % PageV01P1709 11(@)(@@) % تهفو إلى البان من قلبي نوازعه % % وما بي البان بل من داره البان % 12(@)(@@) % أسد سمعي إذا غنى الحمام به % % ألا يبين سر الوجد إعلان % 13(@)(@@) % ورب دار أوليها مجانبة % % وبي إلى الدار أطراب وأشجان % % 14(@)(@@) % إذا تلفت في أطلالها ابتدرت % % للعين والقلب أمواه ونيران % 15(@)(@@) % كلم بقلبي أداويه ويقرفه % طول ادكاري لمن لي منه نسيان % % 16(@)(@@) % لا للوائم إقصار بلائمة % عن العميد ولا للقلب سلوان % % 17(@)(@@) % على مواعيدهم خلف ، إذا وعدوا % % وفي ديونهم مطل وليان % 18(@)(@@) % هم عرضوا بووفاء العهد آونة % حتى إذا عذبوني بالمنى خانوا % % 19(@)(@@) % لا تخلدن إلى أرض تهون بها % % بالدار دار ، وبالجيران جيران % 20(@)(@@) % أقول للركب ، قد خوت ركابهم % من الكلال ومر الليل عجلان % % PageV01P1710 21(@)(@@) % مدوا علابيها . واستعجلوا طلبا % إذا رضي بالهوينا معشر هانوا % % 22(@)(@@) % نرجو الخلود ، وباقينا على ظعن % % والدار قاذفة بالزور مظعان % % 23(@)(@@) % إن قلص الدهر ما أضفاه من جدة % فصنعة الدهر إعطاء وحرمان % 24 
ms485	(@)(@@) % كم من غلام ترى أطماره مزقا % % والعرض أملس والأحساب غران % 25(@)(@@) % إذا الفتى كان في أفعاله شوه % لم يغن إن قيل : إن الوجه حسان % 26(@)(@@) % لا تطلب الغاية القصوى فتحرمها % % فإن بعض طلاب الربح خسران % % 27(@)(@@) % والعزم في غير وقت العزم معجزة % % والازدياد بغير العقل نقصان % % 28(@)(@@) % واجعل يديك مجاز المال تحظ به % % إن الإشحاء للوارث خزان % % 29(@)(@@) % سيرعب القوم مني سطو ذي لبد % % له بعثر أعراس وولدان % % 30(@)(@@) % لا يطعم الطعم إلا من فريسته % % إن يعدم القرن يوما فهو طيان % PageV01P1711 31(@)(@@) % ماشى الرفاق يراعي أين مسقطهم % والسمع منتصب والقلب يقظان % % 32(@)(@@) % يستعجل الليلة القمراء أوبتها % % إذا بنو الليل من طول السرى لانوا % % 33(@)(@@) % حتى إذا عرسوا في حيث تفرشهم % % نمارق الرمل انقاء وكثبان % % 34(@)(@@) % دنا كما اعتس وطمرين لمظه % % من فضلة الزاد ، بالبيداء ، ركبان % 35(@)(@@) % ثم استقرت به نفس مشيعة % % لها من القدر المجلوب معوان % 36(@)(@@) % فعاث ما عاث واستبلى عقيرته % % يجرها مطعم للصيد جذلان % % 37(@)(@@) % قرن إذا طلب الأوتار عن عرض % لم تفد منه دماء القوم ألبان % 38(@)(@@) % وغلمة أخذوا للروع أهبته % % لف البطون على الأعواد خمصان % % 39(@)(@@) % طارت بأشباحهم جرد مسومة % % كأنما خطفت بالقوم عقبان % 40(@)(@@) % من كل أعنق ملطوم بغرته % كأنه من تمام الخلق بنيان % PageV01P1712 41(@)(@@) % يمد للجرس مثل الآستين ، إذا % % خان التوجس أبصار وآذان % 42(@)(@@) % فاستمسكوا بنواصيها وقد سقطت % % من غائر الجري ألباب وأرسان % 43(@)(@@) % كأنما النخل تزفيه يمانية % % فاهت به ثم أعقاب وعيران % 44(@)(@@) % كعمت فاغرة الثغر المخوف بهم % يهفو بأيمانهم نبع ومران % % 45(@)(@@) % كأن غر المعالي في بيوتهم % بيض عقائل يحميهن غيران % 46(@)(@@) % يا فاقد الله بين الحي من يمن % أنساهم الحلم أحقاد وأضغان % 47(@)(@@) % إلى كم الرحم البلهاء شاكية % لها من النعي إعوال وإرنان % 48(@)(@@) % حيرى يضلونها ما بيننا ولها % منا على عدواء الدار نشدان % % 49(@)(@@) % النجر متفق والرأي مختلف % % فالدار ووعاء الشر ملآن % % 50(@)(@@) % أنا نجرهم أعراضنا طمعا % في أن يعودوا إلى البقيا كما كانوا % % PageV01P1713 51(@)(@@) % أنى يتاه بكم في كل 
ms486	 مظلمة % وللرشاد أمارات وعنوان % 52(@)(@@) % ميلوا إلى السلم إن السلم واسعة % % واستوضحوا الحق ، إن الحق عريان % 53(@)(@@) % يا راكبا ذرعت ثوب الظلام به % هوجاء ، مائلة الضبعين مذعان % 54(@)(@@) % أبلغ على النأي قومي إن حللت بهم % % إني عميد بما يلقون أسوان % % 55(@)(@@) % يا قوم إن طويل الحلم مفسدة % وربما ضر إبقاء وإحسان % 56(@)(@@) % مالي أرى حوضكم تعفو نصائبه % % وذودكم ليلة الأوراد ظمآن % % 57(@)(@@) % مدفعين عن الأحواض من ضرع % ينضو بهامكم ظلم وعدوان % 58(@)(@@) % لا يرهب المرء منكم عند حفظته % % ولا يراقب يوما وهو غضبان % 59(@)(@@) % إن الألى لا يعز الجار بينهم % ولا تهاب عواليهم لذلان % % 60(@)(@@) % كم اصطبار على ضيم ومنقصة % % وكم على الذل إقرار وإذعان % PageV01P1714 61(@)(@@) % وفيكم الحامل الهمهام مسرحه % % داج ومن حلق الماذي أبدان % 62(@)(@@) % والخيل مخطفة الأوساط ضامرة % كأنهن على الأطواد ذؤبان % % 63(@)(@@) % الله الله أن يبتز أمركم % راع ، رعيته المعزي والضان % 64(@)(@@) % ثوروا لها ، ولتهن فيها نفوسكم % إن المناقب للأرواح أثمان % % 65(@)(@@) % فمن إباء الأذى حلت جماجمها % % على مناصلها عبس وذبيان % % 66(@)(@@) % وعن سيوف إباء الضيم حين سطوا % % مضى بغصته الجعدي مروان % % 67(@)(@@) % فإن تنالوا فقد طالت رماحكم % % وإن تنالوا فللأقران أقران % % PageV01P1715 البحر : كامل تام 1(@)(@@) % ملك الملوك نداء ذي شجن % % لو شئت لم يعتب على الزمن % 2(@)(@@) % الخطب هين مع صفائك لي % % وإذا كدرت علي لم يهن % 3(@)(@@) % ألقى زماني بالليان ويلقا % % قاني الزمان بجانب خشن % 4(@)(@@) % عدة على الأيام أطلبها % % والدهر يفتلني ويمطلني % % 5(@)(@@) % ما لي رأيت الدهر ينصبني % % ولغير وجد ما يؤرقني % % 6(@)(@@) % وأبيت كالملسوع ، في كبدي % % من شدة الإقلاق ، لا بدني % % 7(@)(@@) % إني أتاني عنك ، آونة % لذع يضيق بوقعه عطني % % 8(@)(@@) % وتنكر بدرت بوادره % من غير ذنب كان من لدني % % 9(@)(@@) % أهدى إلى قلبي لواذعه % وأطار عني واقع الوسن % 10(@)(@@) % إني ، وما رفع الحجيج له % عند الجمار ، شعائر البدن % PageV01P1716 11(@)(@@) % والبيت ذي الأستار يمسحه % % النزاع من شام ومن يمن % 12(@)(@@) % ما زلت عن سنن الحفاظ ، وكم % زال المعادي لي عن السنن % 13(@)(@@) % ستر 
ms487	 الذي أظهرت من كرم % % وطوى الذي أبديت من حسن % 14(@)(@@) % لم أوت من نصح ولا شفق % % فالشر والأعداء في قرن % 15(@)(@@) % إحباط أجري ، مع زكا عملي % % طرف من الخسران والغبن % 16(@)(@@) % إن كان لي ذنب فلا نظرت % % عيني ولا سمعت إذا أذني % % 17(@)(@@) % أنسى بأي يد رددت يدي % % لما نزعت إليك من وطني % % 18(@)(@@) % ألبستني النعماء في قفلي % % وأنلتني العلياء في ظعني % % 19(@)(@@) % ومن العجائب أنت بالإحسان تب % % تبنيني والإعراض تهدمني % % 20(@)(@@) % أنا عبد أنعمك التي نشطت % أملي وأنهض عزها منني % % PageV01P1717 21(@)(@@) % والحر ، إما شئت تملكه % بالمن يملك ليس بالثمن % % 22(@)(@@) % وغرستني بندى يديك ، فلا % % تدع الزمان يعيث في غصني % % 23(@)(@@) % أيدرني عن رعي أنعمه % % من كان قبل أجره رسني % % 24(@)(@@) % لا أتقي طعن الخطوب ، إذا % % لاقيتها ، ورضاك من جنني % % 25(@)(@@) % لو رمت لي الجيد عنك لقد % عطفته أطواق من المنن % % 26(@)(@@) % لا تسمعن قول الوشاة ومن % % غرس الأضالع لي على الإحن % % 27(@)(@@) % يتطلبون لي العيوب وير % % موني بافراد من الظنن % 28(@)(@@) % النقص أخرهم على ظلع % من غايتي والفضل قدمني % % 29(@)(@@) % فالفرق ما بيني وبينهم % كالفرق بين العي واللسن % % 30(@)(@@) % إني أرى الأيام مومضة % % لك عن بوارق عارض هتن % PageV01P1718 31(@)(@@) % فكأنني بعداك قد حبطوا % % حبطا لما شبوا من الفتن % 32(@)(@@) % وكأنني بالهام قد جعلت % منهم عمائم للقنا اللدن % 33(@)(@@) % تبكي ديارهم كما بكيت % % مطموسة الأطلال والدمن % % 34(@)(@@) % فاسلم بهاء الملك ما سلمت % % عادية الأطواد والقنن % 35(@)(@@) % الوجه طلق والبنان ند % % والوعد نقد والعطاء هني % % 36(@)(@@) % سترى مخالصتي ، وتخبرني % % طبعا على غير النفاق بني % % 37(@)(@@) % وإذا الزمان رمى بنائبة % % ونأى الأقارب فالتفت ترني % % PageV01P1719 البحر : هزج 1(@)(@@) % أما كنت مع الحي % صباحا ، حين ولينا % % 2(@)(@@) % وقد صاح بنا المجد : % إلى أين ، إلى أينا % % 3(@)(@@) % إلى أن أدرك العرق % % فثبنا ، ثم لاقينا % % 4(@)(@@) % حمينا بالحفيظات % فقارعنا وحامينا % % 5(@)(@@) % فلا تسأل عن الكا % % س التي فيها تساقينا % % 6(@)(@@) % تناكينا فلما غلب % % الأمر تباكينا % % 7(@)(@@) % عن الحلم تحاجزنا % % وبالضغن تلاقينا % % 8(@)(@@) % ولولا أطة الأرحا % % م 
ms488	 أعذرنا وأبلينا % % 9(@)(@@) % إذا ناشدت القربى % % تباقينا ، وأبقينا % % 10(@)(@@) % بني أعمامنا ! مهلا % سينأى بين دارينا % % PageV01P1720 11(@)(@@) % ويغدو رهج الروع % لحاما بين غارينا % % 12(@)(@@) % إذا ما ضرب النقع % % على الحرب رواقينا % % 13(@)(@@) % عسى الأرحام تثنينا % % إذا نحن تباغينا % % 14(@)(@@) % تبالوا لتلاقونا % % فإنا قد تبالينا % % 15(@)(@@) % فلم يلق لنا العا % % جم رعديدا ولا هينا % % 16(@)(@@) % لنا كل غلام هم % % مه أن يرد الحينا % % 17(@)(@@) % يخال موفيا نذرا % به ، أو قاضيا دينا % % 18(@)(@@) % حديد السمع في حيث % تكون الأذن العينا % % 19(@)(@@) % غرار النوم يجلو عن % % لحاظ الضرم الرينا % % 20(@)(@@) % إذا السير حذا أيدي % % ركاب الدم والأينا % % PageV01P1721 21(@)(@@) % اذات الطوق ! تجلو في % % براق الطلى لينا % % 22(@)(@@) % قفي أخبرك عن صبري % % إذا أوعدتني البينا % % 23(@)(@@) % سلي عن هيئة السيف % شجاع القوم لا القينا % % 24(@)(@@) % لنا السبق بأقدام % إلى المجد تساعينا % % 25(@)(@@) % تري زمجرة الآسا % % د همسا بين غابينا % % 26(@)(@@) % إذا ساومنا الضيم % على الأعراض غالينا % % 27(@)(@@) % وإن نازعنا الحق % % عنان المال ألقينا % % 28(@)(@@) % إذا ما روح الرعيا % % ن ، أعطينا وأمطينا % % 29(@)(@@) % يظن المجتدى أنا % % على الجود تواطينا % % 30(@)(@@) % ملكنا مقطع الرزق % فأفقرنا ، وأغنينا % % PageV01P1722 31(@)(@@) % وحزنا طاعة الدهر % % فأغضبنا وأرضينا % % 32(@)(@@) % متى لم يطع الجود % سخونا ، أو تساخينا % % 33(@)(@@) % سراعا فتفاقدنا % % جميعا وتناعينا % % 34(@)(@@) % إذا ما ثوب الداعي % % إلى الموت تداعينا % % 35(@)(@@) % وما ينفعنا يوما % إذا نحن تفادينا % % 36(@)(@@) % وما أعلمنا أنا % % إلى الغاية أجرينا % % PageV01P1723 البحر : خفيف تام 1(@)(@@) % ما أقل اعتبارنا بالزمان % % وأشد اغترارنا بالأماني % % 2(@)(@@) % وقفات على غرور وأقدا % % م على مزلق من الحدثان % 3(@)(@@) % في حروب على الردى ، وكأ % % نا اليوم في هدنة مع الأزمان % % 4(@)(@@) % وكفانا مذكرا بالمنايا % % علمنا أننا من الحيوان % % 5(@)(@@) % كل يوم رزيئة في فلان % % ووقوع من الردى بفلان % 6(@)(@@) % كم تراني أضل نفسا والهو % % فكأني وثقت بالوخدان % 7(@)(@@) % قل لهذي الهوامل : استوثقي لل % % سير واستنشزي عن الأعطان % 8(@)(@@) % واستقيمي قد ضمك اللقم الن % % هج وغنى وراءك الحاديان % % 9(@)(@@) % كم محيد عن الطريق وقد صر % ح خلج البرى وجذب 
ms489	 العران % % 10(@)(@@) % ننثني جازعين من عدوة الده % هر ونرتاع للمنايا الدواني % % PageV01P1724 11(@)(@@) % جفلة السرب في الظلام وقد زع % زع روعا من عدوة الذؤبان % 12(@)(@@) % ثم ننسى جرح الحمام ، وإن كا % % ن رغيبا ، يا قرب ذا النسيان % 13(@)(@@) % كل يوم تزايل من خليط % % بالردى أو تباعد من دان % % 14(@)(@@) % وسواء مضى بنا القدر الج % % د عجولا أو ماطل العصران % % 15(@)(@@) % يا لقومي لهذه الصيلم الص % ماء عنت ، والنازل الأرونان % 16(@)(@@) % هل مجير بذابل أو حسام % % أو معين بساعد أو بنان % % 17(@)(@@) % مضرب من مضاربي فله الد % هر وغصن أبين من أغصاني % % 18(@)(@@) % نسب ضارب إلى هاشم الجو % % د ، وفرع نام إلى عدنان % 19(@)(@@) % حفرة أطبقت على واضح الأث % اب في المجد طيب الأردان % % 20(@)(@@) % خلق كالربيع روضه القطر % % وصدر صاف من الأضغان % PageV01P1725 21(@)(@@) % وجنان ماض على روعة الخط % % ب ونفس كثيرة النزوان % % 22(@)(@@) % لازم شرعة الوفاء يرى حف % % ظ التصافي دينا من الأديان % 23(@)(@@) % شيعوه بالدمع يجري كما % % شيع غدوا بواكر الأظعان % % 24(@)(@@) % كل عين قريحة تتلقا % % ه بواد من دمعها ملآن % % 25(@)(@@) % قد مررنا على الديار خشوعا % ورأينا البنى ، فأين الباني % % 26(@)(@@) % وجهلنا الرسوم ثم عرفنا % % فذكرنا الأوطار بالأوطان % 27(@)(@@) % جمحت زفرة بغير لجام % % وجرت دمعة بغير عنان % 28(@)(@@) % فالتفاتا إلى القرون الخوالي % % هل ترى اليوم غير قرن فاني ؟ % 29(@)(@@) % أين رب السدير والحيرة البي % ضاء ، أم أين صاحب الإيوان ؟ % 30(@)(@@) % والسيوف الحداد من آل بدر % والقنا الصم من بني الديان % % PageV01P1726 31(@)(@@) % طردتهم وقائع الدهر عن لع % لعلع طرد السفار عن نجران % % 32(@)(@@) % والمواضي من آل جفنة أرسى % % طنبا ملكهم على الجولان % 33(@)(@@) % لم يكن غير قبسة الفرق العج % كرع الظماء في الغدران % 34(@)(@@) % من أباة اللعن الذين يحيو % % بها في معاقد التيجان % % 35(@)(@@) % تتراءاهم الوفود بعيدا % ضاربين الصدور بالأذقان % 36(@)(@@) % في رياض من السماح حوال % وجبال من الحلوم رزان % 37(@)(@@) % وهم الماء لذ للناهل الظم % بردا والنار للحيران % % 38(@)(@@) % كل مستيقظ الجنان إذا % % لم ليل النوامة المبطان % 39(@)(@@) % يغتدي 
ms490	 في السباب غير شجاع % % ويرى في النزال غير جبان % % 40(@)(@@) % ما ثنت عنهم المنون يد شو % % كاء أطرافها من المران % PageV01P1727 41(@)(@@) % عطف الدهر فرعهم ، فرآه % بعد بعد الذرى قريب المجاني % % 42(@)(@@) % وثنتهم بعد الجماح المنايا % % في عنان التسليم والإذعان % % 43(@)(@@) % عطلت منهم المقاري وباخت % % في حماهم مواقد النيران % % 44(@)(@@) % ليس يبقى على الزمان جريء % في إباء ، وعاجز في هوان % 45(@)(@@) % لا شبوب من الصوار ، ولا أع % ق يرعى منابت العلجمان % % 46(@)(@@) % لا ولا خاضب من الربد يختا % % ل بريط أحم غير يمان % % 47(@)(@@) % يرتمي وجهة الرئال ، إذا آ % % نس ولن الإظلام والإدجان % % 48(@)(@@) % نابلا في مطامح الجو هاتيك % % وذا في مهابط الغيطان % % 49(@)(@@) % لو لوى عنك رائع الخطب ذب % أو رمت دونك الحمام يدان % 50(@)(@@) % لوقتك الردى نفوس عزيزا % % ت وأيد مليئة بالطعان % PageV01P1728 51(@)(@@) % ورجال إذا دعوا غدوة الروع % % ع ، وقد خف جانب الأقران % 52(@)(@@) % شمروا يطلبون ناشئة الصو % % ت ، خناذيذ كالقني اللدان % 53(@)(@@) % لا أغب الربيع تربك من نو % % ر هجان ومنظر أضحيان % % 54(@)(@@) % وحدا البرق كل يوم إليه % % عجل القطر بالنسيم الواني % % 55(@)(@@) % في جبال من الغمام كأن الليل % % يرمي رعانها برعان % % 56(@)(@@) % هزجات من البروق كأن ال % % البلق فيها مجرورة الأرسان % % 57(@)(@@) % بعد ما كن كالشفوف تراهن % ن خفيات نقية الألوان % 58(@)(@@) % نشوء مزن كأن في الأفق منه % % نفس القين في الحسام اليماني % % 59(@)(@@) % أو كماوية الصناع علاها % % صدأ اللون بعد طول صيان % % 60(@)(@@) % لاحمت بينه الرياح فأوفى % % كمجر الأنقاء والكثبان % % PageV01P1729 61(@)(@@) % تمتريه هوجاء من قبل الغو % رين ، نزع الدلاء بالأشطان % 62(@)(@@) % تحفز القطر كلما جلجل الرا % % عد حفز الحنية المرنان % 63(@)(@@) % كعياب الدروع أسمع ركض الخيل % % خيل فيها خشاخش الأبدان % 64(@)(@@) % لو تراخت تلك الرياح لأرسل % ت رياح الزفير والإرنان % 65(@)(@@) % لو ونى ذلك الغمام لأطلق % مزاد الدموع من أجفاني % % 66(@)(@@) % فعليك السلام من خاشع النا % % ظر مستسلم لريب الزمان % 67(@)(@@) % ينظر الدهر بعد يومك والنا % % س بعين وحشية الإنسان % % 68(@)(@@) % ويرى الأنس لست من حاضريه 
ms491	 % % وحشة ، والجميع كالوحدان % 69(@)(@@) % معطيا للعدا به الواهن الضا % % رع بعد الأنصار والأعوان % 70(@)(@@) % اذكرته أيام هذا التنائي % % مامضى من أيام ذاك التداني % % PageV01P1730 72(@)(@@) % أصدقائي أقاربي وأخلا % % ئي قبيلي وأخوتي أخواني % % 73(@)(@@) % فامض لا غرني الزمان بعهد % في خليل ولا بعقد ضمان % % 74(@)(@@) % قد تخلى النفس الحبيبة بالرغ % بالرغم وقد يبعد القريب الداني % % 75(@)(@@) % صرف الطرف عنك لا عن تقال % وأقل اللقاء لا عن تواني % % PageV01P1731 البحر : هزج 1(@)(@@) % غزال ماطل ديني % % بأجزاع الغديرين % % 2(@)(@@) % رهوني عندها تغلق % ق بين الهجر والبين % % 3(@)(@@) % ألا ، لا شللا يا را % % مي القلب بنصلين % 4(@)(@@) % طريرين وما مرا % % على مطرقة القين % % 5(@)(@@) % ألا يا نظرة أرسل % تها بين الغبيطين % 6(@)(@@) % أسأت اليوم للقلب % % وأحسنت إلى العين % 7(@)(@@) % فعاد الطرف بالفوز % % وولى القلب بالحين % 8(@)(@@) % فيا لله ! كم تجر % ح يا قلبي من عيني % % 9(@)(@@) % ومن لوم الرفيقين % ومن بين الخليطين % % 10(@)(@@) % صغا قلبي إلى الحلم % بلا قول العذولين % % PageV01P1732 11(@)(@@) % وخلفت الصبا % % خلفي منقاد القرينين % % 12(@)(@@) % وما جزت الثلاثين % % بعام أو بعامين % % 13(@)(@@) % فقل لي اليوم ما عذر % % ك يا شيب العذارين % 14(@)(@@) % سلي بي جولة الخيل % وملتف العجاجين % % 15(@)(@@) % وخطار القنا ، والمو % ت مضروب الرواقين % 16(@)(@@) % تري عزمي مثل السي % ف مشحوذ الغرارين % 17(@)(@@) % أجلي النقع قد صار % لحاما بين غارين % 18(@)(@@) % وأثني سنن الخيل % بهبهاب السرى لين % 19(@)(@@) % بحيث تقطع القربى % % على أيدي القريبين % 20(@)(@@) % ويشتق القنا الذا % % ما بين الشقيقين % % PageV01P1733 21(@)(@@) % ترى فيه القريبين % % من البغضا قرينين % 22(@)(@@) % رمت عندي يد الدهر % بخطب ليس بالهين % 23(@)(@@) % أرى الأيام تحدو % % ني في شر الطريقين % 24(@)(@@) % كما أوضع ، تحت المي % الميس موار الملاطين % % 25(@)(@@) % أزجي الحظ كاللاعب % زحافا على الأين % 26(@)(@@) % كما زجيت الرجزاء % زحفا بعقالين % 27(@)(@@) % وهذا الدهر يثنيني % بالليان عن ديني % % 28(@)(@@) % ويغدو ماتحا للض % رع الواني بسجلين % 29(@)(@@) % له نضح بروقيه % ولي نطح بروقين % 30(@)(@@) % ترى صرف المقادير % % متى يصحو من الأين % PageV01P1734 31(@)(@@) % وهيهات لقد أغلق % % دون الرزق بابين % % 32(@)(@@) % فلا 
ms492	 تطلب دواء % % الحظ قد أعيا الطبيين % % 33(@)(@@) % وإن عاتبت هذا الده % صار الذنب ذنبين % % 34(@)(@@) % وقد طل دم تطل % به عند الجديدين % PageV01P1735 البحر : رمل تام 1(@)(@@) % فخرت قحطان أن كان لها % % ذو نواس وكلاع ورعين % 2(@)(@@) % شرف الأذواء فيها قبلنا % % كل رحب الباع هطال اليدين % % 3(@)(@@) % ثم ساوتها فخارا مضر % بعلي الطاهر المنقبتين % 4(@)(@@) % شيمتا عز ومجد أغنتا % % عن أبي أحمد فينا والحسين % 5(@)(@@) % هل ترى جدا كجدي وأبي % % أي مجد وثناء بعد ذين ؟ % 6(@)(@@) % نسب كالنضر أمسى واسطا % كل أنف من بني النضر ، وعين % 7(@)(@@) % نير الأقطار قد ضوأ ما % % بين جدي الكريمين وبيني % % 8(@)(@@) % ثابت في طينة المجد إذا % % منصب أمسى زليق القدمين % % 9(@)(@@) % بمناط النجم يجري دونه % بارق الأفق وضوء القمرين % % 10(@)(@@) % زينت أفعالنا أحسابنا % % زينة اللهذم أنبوب الرديني % % PageV01P1736 11(@)(@@) % حسب ضاربة أعراقه % بقرارات منى والمأزمين % % 12(@)(@@) % شامخ الأعناق عادي الذرى % % ناضر العرق نضار الطرفين % 13(@)(@@) % وبمجد النفس فخري سابقا % فضلة الفخر بمجد الوالدين % % PageV01P1737 البحر : كامل تام 1(@)(@@) % ما زلت أطرق المنازل بالنوى % % حتى نزلت منازل النعمان % 2(@)(@@) % بالحيرة البيضاء حيث تقابلت % % شم العماد ، عريضة الأعطان % 3(@)(@@) % شهدت بفضل الرافعين قبابها % % وتبين بالبنيان فضل الباني % % 4(@)(@@) % ما ينفع الماضين إن بقيت لهم % % خطط معمرة بعمر فان % % 5(@)(@@) % ورأيت عجماء الطلول من البلى % % عن منطق عربية التبيان % % 6(@)(@@) % باق بها حظ العيون وإنما % % لا حظ فيها اليوم للآذن % % 7(@)(@@) % وعرفت بين بيوت آل محرق % % مأوى القرى ومواقد النيران % 8(@)(@@) % ومناط ما اعتقلوا من البيض الظبا % % ومجر ما سحبوا من المران % 9(@)(@@) % ورأيت مرتبط السوابق للمها % % ومعاقل الآساد للذؤبان % % 10(@)(@@) % الهاجمين على الملوك قبابهم % % والضاربين معاقد التيجان % PageV01P1738 11(@)(@@) % وكأن يوم الإذن يبرز منهم % أسد الشرى وأساود الغيطان % % 12(@)(@@) % ولقد رأيت بدير هند منزلا % ألما من الضراء والحدثان % 13(@)(@@) % أغضى كمستمع الهوان تغيبت % أنصاره ، وخلا من الأعوان % 14(@)(@@) % بالي المعالم أطرقت شرفاته % % إطراق منجذب القرينة عان % 15(@)(@@) % أو كالوقود رأوا سماط خليفة % فرموا على الأعناق بالأذقان % 16(@)(@@) % وذكرت مسحبها الرياط 
ms493	 بجوه % % من قبل بيع زمانها بزمان % 17(@)(@@) % وبما ترد على المغيرة دهيه % % نزع النوار بطيئة الإذعان % 18(@)(@@) % أمقاصر الغزلان غيرك البلى % % حتى غدوت مرابض الغزلان % 19(@)(@@) % وملاعب الأنس الجميع طوى الردى % % منهم ، فصرت ملاعب الجنان % 20(@)(@@) % من كل دار تستظل رواقها % % أدماء ، غانية عن الجيران % PageV01P1739 21(@)(@@) % ولقد تكون محلة وقرارة % لأغر من ولد الملوك هجان % % 22(@)(@@) % يطأ الفرات فناءها بعبابه % % ولها السلافة منه والروقان % 23(@)(@@) % ووقفت أسأل بعضها عن بعضها % % وتجيبني عبر بغير لسان % 24(@)(@@) % قدحت زفيري فاعتصرت مدامعي % % لو لم يؤل جزعي إلى السلوان % % 25(@)(@@) % ترقى الدموع ويرعوي جزع الفتى % % وينام بعد تفرق الأقران % % 26(@)(@@) % مسكية النفحات تحسب تربها % % برد الخليع معطر الأردان % % 27(@)(@@) % وكأنما نشر التجار لطيمة % جرت الرياح بها على العقيان % % 28(@)(@@) % ماء كجيب الدرع تصقله الصبا % % ونقا يدرجه النسيم الواني % % 29(@)(@@) % حلل الملوك رمى جذيمة بينها % % والمنذرين ، تغاير الأزمان % 30(@)(@@) % طردا ، كدأب الدهر في طرد الألى % % والى الحفائظ في بني الديان % PageV01P1740 31(@)(@@) % نعق الزمان بجمعهم عن لعلع % وأقض منزلهم على نجران % 32(@)(@@) % وكآل جفنة أزعجتهم نبوة % نقلت قبابهم عن الجولان % 33(@)(@@) % وعلى المدائن جلجلت برعادها % % عركا لكلكلها على الإيوان % 34(@)(@@) % وإلى ابن ذي يزن غدت مرحولة % % نفضت حويتها على غمدان % 35(@)(@@) % قصفت قنا جدل الطعان وثورت % % بعد الأمان بعامر الضحيان % 36(@)(@@) % زفر الزمان عليهم ، فتفرقوا % % وجلوا عن الأوطار والأوطان % PageV01P1741 البحر : كامل تام 1(@)(@@) % يا مسقط العلمين من رمل الحمى % % لي عند ظبيتك النوار ديون % % 2(@)(@@) % شرت الفؤاد رخيصة أعلاقه % % ومضى يعض بنانه المغبون % 3(@)(@@) % هيهات يتبعني إلى سلوانه % % قلب أصاب به الظباء العين % 4(@)(@@) % سنحت لنا في المشرقات عشية % ومن السهام محاجر وعيون % % 5(@)(@@) % لا العف عف حين يملك لبه % % تلك اللحاظ ولا الأمين أمين % % 6(@)(@@) % لو أن قومك نصلوا أرماحهم % بعيون سربك ما أبل طعين % % PageV01P1742 البحر : وافر تام 1(@)(@@) % أذات الطوق لم أقرضك قلبي % % على ضني به ليضيع ديني % % 2(@)(@@) % كفاك حلي جيدك أن تحلي % بأطواق النضار ، أو اللجين % 3(@)(@@) % سكنت القلب حيث خلقت منه 
ms494	 % % فأنت من الحشى والناظرين % % 4(@)(@@) % أحبك أن لونك لون قلبي % % وإن ألبست لونا غير لوني % % 5(@)(@@) % عديني وامطلي ، وعدي ، فحسبي % % وصالا أن أراك وأن تريني % % 6(@)(@@) % ولا تستهلكي بيديك قلبي % % فإن القلب بينكم وبيني % % 7(@)(@@) % سمعت لها حوارا كان فيه % رجوع بلابلي ودنو حيني % % 8(@)(@@) % فيا لك منطقا لو كان هجرا % لسامعه تلقي باليدين % 9(@)(@@) % كأن الظبية الأدماء حارت % إلي بناعم العذبات لين % % 10(@)(@@) % نظرتك نظرة لما التقينا % % على وجلين من هجر وبين % % PageV01P1743 11(@)(@@) % كأني قد نظرت سواد قلبي % % بوجهك ظاهرا لسواد عيني % % PageV01P1744 البحر : متقارب تام 1(@)(@@) % ذكرتك ذكرة لا ذاهل % % ولا نازع قلبه والجنان % 2(@)(@@) % أعاود منك عداد السليم % فيادين قلبي ماذا يدان % % 3(@)(@@) % عواطف من مقلقات الغرا % % م يوم دموعي بها أرونان % 4(@)(@@) % ويأبى الجوى أن أسر الجوى % % إذا ملئ القلب فاض اللسان % % 5(@)(@@) % وما خير عين خبا نورها % % ويمنى يد جذ منها البنان % % 6(@)(@@) % فيا أثر الحب أنى بقيت % وقد بان ممن أحب العيان % 7(@)(@@) % وقالوا : تسل بأترابها % % فأين الشباب ، وأين الزمان ؟ % PageV01P1745 البحر : بسيط تام 1(@)(@@) % يا روض ذي الأثل من شرقي كاظمة % قد عاود القلب من ذكراك أديانا % % 2(@)(@@) % أمر بالركب مجتازا بذي سلم % % لو ما شريتك بالأوطان أوطانا % % 3(@)(@@) % شغلت عيني دموعا والحشى حرقا % % فكيف ألفت أمواها ونيرانا % % 4(@)(@@) % أشم منك نسيما لست أعرفه % % أظن ظمياء جرت فيك أردانا % % 5(@)(@@) % أشبهت أظعان ذاك الحي من يمن % طيبا وحسنا وأغصانا وكثبانا % % 6(@)(@@) % لو أستطيع لما سافتك سائفة % % ولا جناك فتى رندا ولا بانا % % 7(@)(@@) % ألقاك والقلب صاف من رجيع هوى % % وأنثني عنك بالأشواق نشوانا % % 8(@)(@@) % ولا تداويت من قرح فرى كبدي % % ولا سقاني راقي الحي سلوانا % % 9(@)(@@) % يقول صحبي ، وقد أعياهم طربي : % بعض الأسى إنما أحببت إنسانا % % 10(@)(@@) % أين الخيام التي كنا نلوذ بها % % بالابرقين وأين الحي مذ بانا % % PageV01P1746 11(@)(@@) % لا هجت لي قنصا من بعد بينهم % ولا ذعرت عن الأطلاء غزلانا % % 12(@)(@@) % أنسيتني الناس إذ أذكرتني بهم % % يا مهديا لي تذكارا ونسيانا % % PageV01P1747 البحر : بسيط تام 
ms495	 1(@)(@@) % يا طائر البان غريدا على فنن % % ما هاج نوحك لي يا طائر البان % % 2(@)(@@) % هل أنت مبلغ من هام الفؤاد به % % إن الطيلق يؤدي حاجة العاني % % 3(@)(@@) % ضمانة ما جناها ، غير مقلته % يوم الوداع فيا شوقي إلى الجاني % % 4(@)(@@) % مغفل عن همومي في بلهنية % % أرعى النجوم ، وطرفاه قريران % 5(@)(@@) % ينأى ويدنو على خضراء مورقة % لعب النعامى بأوراق وأغصان % % 6(@)(@@) % كالقرط علق في ذفرى مبتلة % % بين العقائل قرطاها قليقان % 7(@)(@@) % هيهات ما أنت من وجدي ولا طربي % % ولا لقلبك أشجاني وأحزاني % % 8(@)(@@) % ولا نظرت إلى ماء على ظمأ % % تبغي الورود وليس الورد بالداني % % 9(@)(@@) % ولا فجعت وقد سارت ركائبهم % % يوم الغميم بغزلان كغزلاني % % 10(@)(@@) % لو لا تذكر أيامي بذي سلم % % وعند رامة أوطاري وأوطاني % % PageV01P1748 11(@)(@@) % لما قدحت بنار الوجد في كبدي % % ولا بللت بماء الدمع أجفاني % % PageV01P1749 البحر : متقارب تام 1(@)(@@) % أذاع بذي العهد عرفانه % وعاود للقلب أديانه % 2(@)(@@) % وأضرب سمع عن العاذلات % % لها شانها وله شانه % % 3(@)(@@) % وما طل قلبا بإبلاله % % مطال الغريم وليانه % % 4(@)(@@) % أهاجك ذا الحي من وائل % تحمل للبين أظعانه % 5(@)(@@) % نأى السرب عنك وعهدي به % % تكنس في القلب غزلانه % % 6(@)(@@) % لئن أوحش الربع حلا له % % لقد عمر القلب سكانه % 7(@)(@@) % مررن غدوا بروض الصري % % راق من النور ظهرانه % % 8(@)(@@) % فحن لإلمامهم أثله % ومال إلى قربهم بانه % % 9(@)(@@) % وما حملت مثل تلك البدو % % ر بين الذوائب أغصانه % 10(@)(@@) % ولي ناظر بعد بين الخلي % % ط مات من الدمع إنسانه % PageV01P1750 11(@)(@@) % رواء من الماء آماقه % % ظماء من النوم أجفانه % % 12(@)(@@) % يروح بهم ساهرا طرفه % % ويغدو لهم دامعا شانه % 13(@)(@@) % يراخي الهوى ، فأريغ السلو % قليلا ، وتجذب أشطانه % 14(@)(@@) % فأين من الداء إفراقه % وأين من القلب سلوانه % 15(@)(@@) % فيا ظالما طيبا ظلمه % % كثيرا على القلب أعوانه % % 16(@)(@@) % تبعت فؤادي إلى حبه % % مطيعا ، وإن لج عصيانه % 17(@)(@@) % يباع بسومك حب القلوب % وتغلق عندك أثمانه % % 18(@)(@@) % وشر الإساءة من مالك % % أساء ، وما نيل إحسانه % 19(@)(@@) % وقد كنت أشفق من ذا الصدو % % د ، مذ 
ms496	 أودع القلب خوانه % 20(@)(@@) % ويا ركبا لجلجت نضوه % % ثنايا الغوير ، ونجرانه % PageV01P1751 21(@)(@@) % يروعه الصبح أسفاره % % ويؤنسه الليل إدجانه % 22(@)(@@) % إذا منزل آن تعريسه % طواه على الأين ظعانه % 23(@)(@@) % تحمل ألوكة حامي الضلو % % ع ، طال من البين إرنانه % 24(@)(@@) % إلى الحي من يمن أنهم % ودائع قلبي وخلصانه % % 25(@)(@@) % لنالوا من القلب ما لم ينل % زعازع حي وشيحانه % 26(@)(@@) % لأنتم أسنة يوم الطعان % إذا أسلم السرح فرسانه % 27(@)(@@) % كأن الجياد ، تسامى بكم % % قنان الشريف وعقبانه % % 28(@)(@@) % وهل زان تيجانه أسرة % جباههم الغر تيجانه % % 29(@)(@@) % وإن رباط بني مالك % تقاد إلى الموت أرسانه % 30(@)(@@) % إذا الفيلق المجر أدلى له % إلى قلب الذمر مرانه % % PageV01P1752 31(@)(@@) % يكون سواكم عقابيله % % وأنتم إلى الطعن سرعانه % % 32(@)(@@) % وما كل أصل كريم العرو % % ق تأبى على الغمز عيدانه % % 33(@)(@@) % لكم كل جمع كما أقبلت % تموج بالنحل غيرانه % % 34(@)(@@) % كأن أسنته في القنا % % شرار ظبا البيض نيرانه % % 35(@)(@@) % هل الموت إلا إذا استجمعت % كعوب القني وإيمانه % % 36(@)(@@) % إذا دبر الطعن أوهمته % تنم إلى النجم خرصانه % % 37(@)(@@) % لقد ضل عهدكم باللوى % % وطال بدمعي نشدانه % 38(@)(@@) % أناقشكم ، ووراء النقا % % ش أنف العلوق ورئمانه % 39(@)(@@) % وأهجركم هجر مستعتب % وكم وامق طال هجرانه % % 40(@)(@@) % فأنأى وأقرب أوب الظليم % % ينتظر الط عم رئلانه % % PageV01P1753 41(@)(@@) % سيبعد عنكم على حسرة % % طويل جوى القلب أسوانه % 42(@)(@@) % تبدل بالمرء أحبابه % % وتنبو على المرء أوطانه % 43(@)(@@) % إذا منزل راب سكانه % من الأرض حرم أيطانه % % 44(@)(@@) % إذا كان صعبا تناسي الحنين % % إليكم فهيهات نسيانه % % 45(@)(@@) % وشيبني والصبا وارق % % علي ، وما انجاب ريعانه % 46(@)(@@) % حميم تقلب أخلاقه % ومولى تلون ألوانه % % PageV01P1754 البحر : كامل تام 1(@)(@@) % يا ظالمي ، والقلب ناصره % يجني علي له كما يجني % % 2(@)(@@) % أجمعت هجري ، والفراق معا % أوما اشتفيت بواحد مني % % 3(@)(@@) % لم أنس موقفنا وقد طلعت % % كالشمس تحت حواجب الدجن % % 4(@)(@@) % ترنو إلي بعين مطفلة % رعت النوى ومساقط المزن % 5(@)(@@) % سهم وجدت له على كبدي % % ألما ، وآلم صرفه عني % % 6(@)(@@) % سمحت بكم نفسي على مضض % % ولرب سامحة على ضن % 7 
ms497	(@)(@@) % هيهات يعدل في قضيته % % قمر يدل بدولة الحسن % PageV01P1755 البحر : مجزوء الرجز 1(@)(@@) % أعاد لي عيد الضنى % % جيراننا على منى % % 2(@)(@@) % مواقف تبدل ذا الشي % الشيب شطاطا بحنا % % 3(@)(@@) % يقول من عاين ها % % تيك الطلى والأعينا % % 4(@)(@@) % هذا غزال قد عطا % % وذاك ظبي قد رنا % % 5(@)(@@) % والهفتا من واجد % % على الشباب والغنى % % 6(@)(@@) % من أجلها يرضى الغري % % يب بالبوادي وطنا % % 7(@)(@@) % أنسى قنا مرانها % % موارن ذات قنا % % 8(@)(@@) % يلقى بها فوارس % لا يحفلون الجبنا % % 9(@)(@@) % مجتمرات رحن عن % % رمي الجمار موهنا % % 10(@)(@@) % تروح السرب عن ال % % رد إذا الليل دنا % % PageV01P1756 11(@)(@@) % كم كبد معقورة % % للعاقرين البدنا % % 12(@)(@@) % بأعين تركنها % % على القلوب أعينا % % 13(@)(@@) % وإنما جعلنها % % لرد قول السنا % % 14(@)(@@) % يورق منهن الحصى % % حتى يكاد يجتنى % % 15(@)(@@) % ليهن من لم يفتتن % % إنا لقينا الفتنا % % 16(@)(@@) % يخفي تباريح الهوى % % وقد عنانا ما عنا % % 17(@)(@@) % كما النزوع عندكم % % كذا النزاع عندنا % % 18(@)(@@) % يا صاحبي رحلي : قفا % % فسائلا لي الدمنا % % 19(@)(@@) % بالغمر قد غيرها % % صوب الغمام مدجنا % % 20(@)(@@) % وأمطرا دمعيكما % % ذاك الكثيب الأيمنا % % PageV01P1757 21(@)(@@) % الدار عندي سكن % % إذا عدمت السكنا % % 22(@)(@@) % قالا : ومن أين رما % % الشوق قلت من هنا % % 23(@)(@@) % وصاحب نبهته % % بعد اللغوب والونى % % 24(@)(@@) % رمى الكرى في سمعه % % فبعد لأي أذنا % % 25(@)(@@) % وقام كالمصعب ذي % % روق يجر الرسنا % % 26(@)(@@) % فقلت من معاقدي % % على الردى قال أنا % % 27(@)(@@) % اتق ما بي تتقى % % ولو أنابيب القنا % % 28(@)(@@) % كل الظبى حدائد % وقل منها المقتنى % % 29(@)(@@) % وإنما الصون على % % قدر المضاء والغنا % % 30(@)(@@) % وبارق أشيمه % % كالطرف أغضى ورنا % % PageV01P1758 31(@)(@@) % أو رمح محبوك القرا % % بات شموعا أرنا % % 32(@)(@@) % أيقظت عنه صاحبا % ينجاب علوي السنا % % 33(@)(@@) % فقلت إيه نظرا % أما قضيت الوسنا % % 34(@)(@@) % أين تقول صوبه % % فقال لي دون قنى % % 35(@)(@@) % ذكرني الأحباب ، وال % % والذكرى تهيج الحزنا % % 36(@)(@@) % أضامن أن لا يني % % يشوق قلبا ضمنا % % 37(@)(@@) % من بطن مر والسرى % % تؤم عسفان بنا % % 38(@)(@@) % وبالعراق وطري % % يا بعد ما لاح لنا % % 39(@)(@@) % أشتاقهم ومربخ % % إلى زرود بيننا % % 40(@)(@@) % يا 
ms498	 ويح لي من شجني % % أما مللت الشجنا % % PageV01P1759 41(@)(@@) % رحلني عن وطني % % إني ذممت الوطنا % % 42(@)(@@) % ما رابني من أبعدي % % ما رابني من الدنى % % 43(@)(@@) % ولو وجدت مرقعا % لبست ثوبي زمنا % % 44(@)(@@) % إني ومن يغلب با % % لرقع أديما لخنا % % 45(@)(@@) % أقسمت بالمحجوج مرف % % وع العماد والبنا % % 46(@)(@@) % مثل سنام العود قد % عالوا عليه الظعنا % % 47(@)(@@) % موضوعة صفاحه % % وضع المطي الثفنا % % 48(@)(@@) % والأسود الملموس قد % % جابوا عليه الركنا % % 49(@)(@@) % يلقى عليه مضر % بعد الصفاء اليمنا % % 50(@)(@@) % تحكك الجرب على الأ % % جذال من مض الهنا % % PageV01P1760 51(@)(@@) % لأقبلن معشرا % تلك الطوال اللدنا % % 52(@)(@@) % تلمظ الأصلال لج % لجن إلينا الألسنا % % 53(@)(@@) % يطلبن وردي ظمأ % % إما الردى ، أو المنى % % 54(@)(@@) % يصبح في أطرافها % % للقوم فقر وغنى % % 55(@)(@@) % لقد أنى أن أحم % % ضيم بها لقد أنى % % PageV01P1761 البحر : طويل 1(@)(@@) % تضاجعني الحسناء والسيف دونها % % ضجيعان لي والسيف أدناهما مني % % 2(@)(@@) % إذا دنت البيضاء مني لحاجة % % أبى الأبيض الماضي فأبعدها عني % % 3(@)(@@) % وإن نام لي في الجفن انسان ناظر % تيقظ عني ناظر لي في الجفن % 4(@)(@@) % أغرت فتاة الحي مما ألفته % % أغلغله دون الشعار من الضن % 5(@)(@@) % وقالت هبوه ليلة الخوف ضمه % % فما عذره في ضمه ليلة الأمن % % PageV01P1762 البحر : طويل 1(@)(@@) % وما كنت أدري الحب حتى تعرضت % % عيون ظباء بالمدينة عين % 2(@)(@@) % فوالله ما أدري الغداة رميننا % % عن النبع أم عن أعين وجفون % 3(@)(@@) % بكل حشى منا رمية نابل % قوي على الأحشاء غير أمين % % 4(@)(@@) % فررت بطرفي من سهام لحاظها % % وهل تتلقى أسهم بعيون % % 5(@)(@@) % وقالوا : انتجع رعي الهوى من بلاده % % فهذا معاذ من جوى وحنين % 6(@)(@@) % فيا بانتي بطن العقيق سقيتما % % بماء الغوادي بعد ماء شؤون % 7(@)(@@) % أحبكما ، والمستجن بطيبة % محبة ذخر بات عند ضنين % 8(@)(@@) % جلون الحداق النجل وهي سقامنا % % لكل لبان واضح ، وجبين % 9(@)(@@) % يلجلجن قضبان البشام عشية % على ثغب من ريقهن معين % 10(@)(@@) % ترى بردا يعدي إلى القلب برده % فينقع من قبل المذاق بحين % PageV01P1763 11(@)(@@) % تماسكت لما خالط اللب لحظها % % وقد جن منه القلب أي 
ms499	 جنون % 12(@)(@@) % وما كان إلا وقفة ثم لم تدع % دواعي النوى منهن غير ظنون % % 13(@)(@@) % نصصت المطايا أبتغي رشد مذهبي % % فأقلعن عني ، والغواية دوني % % PageV01P1764 البحر : بسيط تام 1(@)(@@) % وصاحب في أصيحاب أنخت به % % على زرود ، وموج الليل يغشانا % % 2(@)(@@) % ثنى الذراع ، وألقى فضل لمته % على الكثيب خميص البطن طيانا % % 3(@)(@@) % ناديته بعد ما مال الجنوب به % % أبا نعامة أبردنا قم الآنا % % 4(@)(@@) % فقام ، والنوم طرح في محاجره % لا يرسل الطرف إلا عاد وسنانا % % 5(@)(@@) % مستأخر ، ومطايا الركب سائرة % أحموقة إن عقل المرء قد رانا % % 6(@)(@@) % يهوى الرقاد كأن الرمل أفرشه % % نمارق ابنة منظور ابن زبانا % % PageV01P1765 البحر : وافر تام 1(@)(@@) % وليس من الفراغ يثرن عني % % نفاثات يجيش بها الجنان % % 2(@)(@@) % ولكن مهجة ملئت ففاضت % % وضاق القلب ، واتسع اللسان % PageV01P1766 البحر : رمل تام 1(@)(@@) % يا رفيقي قفا نضويكما % % بين أعلام النقا والمنحنى % % 2(@)(@@) % وانشدا قلبي فقد ضيعته % % باختياري بين جمع ومنى % % 3(@)(@@) % عارضا السرب فان كان فتى % % بالعيون النجل يقضي ، فأنا % % 4(@)(@@) % إن من شاط على ألحاظها % % ضعف من شاط على طول القنا % % 5(@)(@@) % تجرح الأعين فينا والطلى % % قاتل الله الطلى والأعينا % % 6(@)(@@) % ثم كانت ، بقباء ، وقفة % ضمنت للشوق قلبا ضمنا % % 7(@)(@@) % وحديث كان من لذته % أحد يصغي إلينا أذنا % % 8(@)(@@) % غادروني جسدا تظهره % % لهم الشكوى ويخفيه الضنى % % 9(@)(@@) % حبذا منكم خيال طارق % مر بالحي ولم يلمم بنا % % 10(@)(@@) % باخل بخل الذي أرسله % % سئل النيل وما جاد لنا % % PageV01P1767 11(@)(@@) % سرحة أعجلها البين وما % % لبس الظل ، ولا ذيق الجنى % % 12(@)(@@) % ما رأت عيني مذ فارقتكم % يا نزول الحي شيئا حسنا % % PageV01P1768 البحر : سريع 1(@)(@@) % ما أسرع الأيام في طينا % % تمضي علينا ثم تمضي بنا % % 2(@)(@@) % في كل يوم أمل قد نأى % % مرامه عن أجل قد دنا % % 3(@)(@@) % أنذرنا الدهر وما نرعوي % % كأنما الدهر سوانا عنى % % 4(@)(@@) % تعاشيا ، والموت في جده % ما أوضح الأمر وما أبينا % % 5(@)(@@) % والناس كالأجمال قد قربت % تنتظر الحي ، لأن يظعنا % % 6(@)(@@) % تدنو إلى الشعب ومن خلفها % % مغامر يطردها بالقنا % % 7(@)(@@) % إن 
ms500	 الألى شادوا مبانيهم % % تهدموا قبل انهدام البنا % % 8(@)(@@) % لا معدم يحميه إعدامه % ولا يقي نفس الغني الغنى % % 9(@)(@@) % كيف دفاع المرء أحداثها % % فردا وأقران الليالي ثنى % % 10(@)(@@) % حط رجال ، وركبنا الذرى % % وعقبة السير لمن بعدنا % % PageV01P1769 11(@)(@@) % كم من حبيب هان من فقده % ما كنت أن أحسبه هينا % % 12(@)(@@) % أنفقت دمع العين من بعده % وقل دمع العين إن يخزنا % % 13(@)(@@) % كنت أوقيه فأسكنته % % بعد الليان المنزل الأخشنا % % 14(@)(@@) % دفنته والحزن من بعده % % يأبى على الأيام أن يدفنا % % 15(@)(@@) % يا أرض ! فاشدتك أن تحفظي % % تلك الوجوه الغر والأعينا % % 16(@)(@@) % يا ذل ما عندك من أوجه % كن كراما أبدا عندنا % % 17(@)(@@) % والحازم الرأي الذي يغتدي % % مستقلعا ينذر مستوطنا % % 18(@)(@@) % لا يأمن الدهر على غرة % % وعز ليث الغاب أن يؤمنا % % 19(@)(@@) % كأنما يجفل من غارة % % ملتفتا يحذر أن يطعنا % % 20(@)(@@) % أخي جبرا لك من عثرة % % لا بد للعاثر أن يوهنا % % PageV01P1770 21(@)(@@) % إن التي آذتك من ثقلها % % هلمها ، نحملها بيننا % % 22(@)(@@) % ساقيتك الحلو فلا بدعة % % إن أنا طاعمتك مر الجنى % % 23(@)(@@) % واصبر على ضرائها ، إنما % % في قوة السالب عذر لنا % % 24(@)(@@) % جناية الدهر له عادة % % فما لنا نعجب لما جنى % % 25(@)(@@) % من كان حرمان المنى دأبه % فالفضل إن بلغ بعض المنى % % 26(@)(@@) % كم غارس أمل في غرسه % فأعجل المقدار أن يجتنى % % 27(@)(@@) % ما الثلم في حدك نقصا له % % قد يثلم العضب ، وقد يقتنى % % 28(@)(@@) % يأبى لك الحزن أصيل الحجا % % ويقتضيك الرزء أن تحزنا % % 29(@)(@@) % والأجر في الأولى وإن أقلقت % % وربما نستقبح الأحسنا % % 30(@)(@@) % ذا الخلق الأعلى فخذ نهجه % % واترك إليه الخلق الأدونا % % PageV01P1771 31(@)(@@) % أبا علي هل لأمثالها % % غيرك إن خطب زمان عنى % % 32(@)(@@) % فانهض بها إنك من معشر % إن جشموا الأمر أبانوا الغنى % % 33(@)(@@) % واصبر على ضراتها إنما % % نغالب القرن إذا أمكنا % % PageV01P1772 البحر : كامل تام 1(@)(@@) % يا صاحبي تروحا بمطيتي % % إن الظباء بذي الإدراك سلبنني % % 2(@)(@@) % سيرا فقد وقف الطعين لما به % % مستسلما ونجا الذي لم يطعن % 3(@)(@@) % ما سرني ، وقنا اللحاظ تنوشني % % إني 