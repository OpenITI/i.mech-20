ms1295	 العدواني = حرثان بن الحارث(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الاعواد (القاضي) = مخاشن بن معاوية(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الاهدام = المتوكل بن عياض(@)(@@)(@@)(@@) || AUT ذو(@)(@@) بتع (الاصغر) = نوف بن موهب إل(@)(@@)(@@)(@@) || AUT ذو(@)(@@) بتع (الاكبر) = نوف بن يحضب(@)(@@)(@@)(@@) || AUT ذو(@)(@@) البجادين = عبد الله بن نهم(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الحلم = عامر بن الظرب(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الخمار = سبيع بن الحارث(@)(@@)(@@)(@@) || AUT ذو(@)(@@) رداع (الحميري) = بهنعم(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الملاحي(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الرمحين = عامر بن وهب(@)(@@)(@@)(@@) || AUT ذو(@)(@@) الرمة = غيلان بن عقبة(@)(@@)(@@)(@@) || AUT ذو(@)(@@) رياش = عامر بن باران(@)(@@)(@@)(@@) || AUT ذو(@)(@@) السعادات (الوزير) = محمد بن جعفر 440(@)(@@)(@@)(@@) || AUT ذو(@)(@@) شناتر = لختيعة بن ينوف(@)(@@)(@@)(@@) || AUT ذو(@)(@@) العمرين (ابن الخطيب) = محمد بن عبد الله 776 __________ (1) نهاية الارب 214. (2) جمهرة الأنساب 302 - 308 واللباب 1: 447 ونهاية الارب 214. (3) اللباب 1: 447. PageV03P0008(@)(@)(@@)(@@)(@@) ||| AUT وجيه الدولة(@)(@@) ( 000 - 428 ه = 000 - 1036 م) ذو القرنين بن حمدان بن ناصر الدولة التغلبي، أبو المطاع،(@)(@@)(@@)(@@) ||| AUT وجيه الدولة(@)(@@) : أمير، شاعر، من أهل دمشق. ولي إمرتها سنة 401 ه وعزل فرحل إلى مصر فولاه الظاهر العبيدي الاسكندرية وأعمالها سنة 414 فأقام بها عاما. وعاد إلى دمشق فاستقر فيها أميرا إلى سنة 419 ه وتوفي بمصر. له (ديوان شعر) حققه الدكتور محسن غياض، ونشره في مجلة المجمع العلمي العراقي (1). ذو الكلاع الاكبر = يزيد بن النعمان ذو الكلاع الاصغر = سميفع ذو لعوة = محلم بن بكيل ذوالمجاسد = عامر بن جشم ذو المشعار = حمرة بن أيفع ذو المشعار = مالك بن نمط ذوالمنار = أبرهة بن الحارث(@)(@@)(@@)(@@) ||| AUT ذو نواس(@)(@@) ( 000 - 102 ق ه = 000 - 524 م)(@)(@@)(@@)(@@) ||| AUT ذو نواس(@)(@@) الحميري: آخر ملوك حمير في اليمن. في اسمه واسم أبيه اضطراب، كما سنذكر في مصادر هذه الترجمة. وهو صاحب الاخدود المذكور في القرآن الكريم. كان يدين باليهودية، وبلغه أن أهل نجران مقبلون على النصرانية، فسار إليهم وحفر أخاديد (حفرا مستطيلة) وم