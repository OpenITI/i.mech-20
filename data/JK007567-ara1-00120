ms101	 ضر لو تشفي الغليل % % 20(@)(@@) % يا روضة الأزهار % % وعرفها يبري العليل % % PageV01P348 21(@)(@@) % قضيبك الفينان % % يسقى بدمع همر % % 22(@)(@@) % فلاعج الأشجان % % فيض الدموع يمتري % % 23(@)(@@) % هل في الهوى ناصر % % أو هل يجار الهائم % % 24(@)(@@) % لو كان لي زائر % % طيف الخيال الحائم % % 25(@)(@@) % ما بت بالساهر % % ودمع عيني ساجم % % 26(@)(@@) % والحب ذو عدوان % % يجهد في ظلم البري % % 27(@)(@@) % وصارم الأجفان % % مؤيد بالحور % % 28(@)(@@) % رحماك في صب % % أذكرته عهد الصبا % % 29(@)(@@) % بواعث الحب % % قادت إليه الوصبا % % 30(@)(@@) % لم تهف بالقلب % % ريح الصبا إلا صبا % % PageV01P349 31(@)(@@) % بليلة الأردان % % قد ضمخت بالعنبر % % 32(@)(@@) % يشير غصن البان % % منها بفضل المئزر % % 33(@)(@@) % طيبها حمد % % فخر الملوك المجتبى % % 34(@)(@@) % من يرجح الطود % % من حلمه إذا احتبى % % 35(@)(@@) % فالبأس والإحسان % % والغوث للمستنصر % % 36(@)(@@) % تحمله الركبان % % تحية للمنبر % % 37(@)(@@) % عصابة الكتاب % % حق لها الفوز العظيم % % 38(@)(@@) % تختال في أثواب % % ألبسها الطول الجسيم % % 39(@)(@@) % فحسبها الإطناب % % في الحمد والشكر العميم % % 40(@)(@@) % خليفة الرحمن % % لا زلت سامي المظهر % % PageV01P350 41(@)(@@) % يا مورد الظمآن % % ورأس مال المعسر % % 42(@)(@@) % خذها على دعوى % % تزري على الروض الوسيم % % 43(@)(@@) % جاءت كما تهوى % % أرق من لون النسيم % % 44(@)(@@) % قد طارحت شكوى % % من قال في الليل البهيم % % 45(@)(@@) % ليل الهوى يقظان % % والحب ترب السهر % % 46(@)(@@) % والصبر لي خوان % % والنوم من عيني بري % % PageV01P351 البحر : - 1(@)(@@) % بالله يا قامة القضيب % % ومخجل الشمس والقمر % % 2(@)(@@) % من ملك الحسن في القلوب % % وأيد اللحظ بالحور % % 3(@)(@@) % من لم يكن طبعه رقيقا % % لم يدر ما لذة الصبا % % 4(@)(@@) % فرب حر غدا رقيقا % % تملكه نفحة الصبا % % 5(@)(@@) % نشوان لم يشرب الرحيقا % % لكن إلى الحسن قد صبا % % 6(@)(@@) % فعذب القلب بالوجيب % % ونعم العين بالنظر % % 7(@)(@@) % وبات والدمع في صبيب % % يقدح من قلبه الشرر % % 8(@)(@@) % عجبت من قلبي المعنى % % يهفو إذا هبت الرياح % % 9(@)(@@) % لو كان للصب ما تمنى % % لطار شوقا إلى البطاح % % 10(@)(@@) % وبلبل الدوح إن تغنى % % أسهر ليلي إلى الصباح % % PageV01P352 11(@)(@@) % عساك إن زرت يا طبيبي % % بالطيف في رقدة السحر % % 12(@)(@@) % أن تجعل النوم من نصيبي 
ms102	 % % والعين تحمي من السهر % % 13(@)(@@) % كم شادن قاد لي الحتوفا % % بمربع القلب قد سكن % % 14(@)(@@) % يسل من لحظه سيوفا % % فالقلب بالروع ما سكن % % 15(@)(@@) % خلقت من عادتي ألوفا % % أحن للإلف والسكن % % 16(@)(@@) % غرناطة منزل الحبيب % % وقربها السؤل والوطر % % 17(@)(@@) % تبهر بالمنظر العجيب % % فلا عدا ربعها المطر % % 18(@)(@@) % عروسه تاجها السبيكة % % وزهرها الحلي والحلل % % 19(@)(@@) % لم ترض من عزها شريكه % % بحسنها يضرب المثل % % 20(@)(@@) % أيدها الله من مليكه % % تملكها اشرف الدول % % PageV01P353 21(@)(@@) % بدولة المرتجى المهيب % % الملك الطاهر الأغر % % 22(@)(@@) % تختال من بردها القشيب % % في في حلة النور والزهر % % 23(@)(@@) % كرسيها جنة العريف % % مرآتها صفحة الغدير % % 24(@)(@@) % وجوهر الطل عن شنوف % % تحكمها صنعة القدير % % 25(@)(@@) % والأنس فيها على صنوف % % فمن هديل ومن هدير % % 26(@)(@@) % كم خرق الزهر من جيوب % % وكلل القضب بالدرر % % 27(@)(@@) % فالغصن كالكاعب اللعوب % % والطير تشدو بلا وتر % % 28(@)(@@) % ولائم النصر في احتفال % % وفرح دين الهدى جديد % % 29(@)(@@) % سلطانها معمل العوالي % % محمد الظافر السعيد % % 30(@)(@@) % ومخجل البدر في الكمال % % سلطانها المجتبى الفريد % % PageV01P354 31(@)(@@) % أصفح مولى عن الذنوب % % أكرم عاف إذا قدر % % 32(@)(@@) % وشمس هدي بلا مغيب % % وبحر جود بلا حسر % % 33(@)(@@) % مولاي يا عاقد البنود % % تظلل الأوجه الصباح % % 34(@)(@@) % أوحشت يا نخبة الوجود % % غرناطة هالة السماح % % 35(@)(@@) % سافرت باليمن والسعود % % وعدت بالفتح والنجاح % % 36(@)(@@) % يا ملهم القلب للغيوب % % ومطعم النصر والظفر % % 37(@)(@@) % اسمعك الله عن قريب % % على السلامه مع السفر % % PageV01P355 البحر : - 1(@)(@@) % ريحانة الفجر قد أطلت % % خضراء بالزهر تزهر % % 2(@)(@@) % وراية الصبح قد أظلت % % في مرقب الشرق بتنشر % % 3(@)(@@) % فالشهب من غارة الصباح % % ترعد خوفا وتخفق % % 4(@)(@@) % وأدهم الليل في جماح % % أعنة البرق يطلق % % 5(@)(@@) % والأفق في ملتقى الرياح % % بأدمع الغيث يشرق % % 6(@)(@@) % والسحب بالجوهر استهلت % % فالبرق سيف مجوهر % % 7(@)(@@) % صفاحه المذهبات حلت في راحة الجو تشهر % . . . % 8(@)(@@) % كم للصبا ثم من مقيل % % بطيبه الزهر يشهد % % 9(@)(@@) % والنهر كالصارم الصقيل % % في حلية النور يغمد % % 10(@)(@@) % ورب قال به وقيل % % للطير في حين تنشد % % PageV01P356 11(@)(@@) % فألسن الورق قد أملت % % مدائحا عنه 
ms103	 تشكر % % 12(@)(@@) % ونسمة الصبح قد تجلت % % في سندس الروض تعثر % % 13(@)(@@) % والكأس في راحة النديم % % يجلو بها غيهب الهموم % % 14(@)(@@) % اقبست النار في القديم % % من قبل أن تخلق الكروم % % 15(@)(@@) % والنهر في ملعب النسيم % % للزهر في عطفه رقوم % % 16(@)(@@) % فلبة الحلي قد تحلت % % والطل في القضب جوهر % % 17(@)(@@) % وبهجة الكون قد تجلت % % والروض بالحسن يبهر % % 18(@)(@@) % يذكرني وجنة الحبيب % % والآس في صفحة العذار % % 19(@)(@@) % وشارب الشارب العجيب % % بين أقاح وجلنار % % 20(@)(@@) % يدير من ثغره الشنيب % % سلافة دونها العقار % % PageV01P357 21(@)(@@) % حلت لأهل الهوى وجلت % % بالذكر والوهم تسكر % % 22(@)(@@) % كم من نفوس بها تسلت % % فما لها الدهر منكر % % 23(@)(@@) % يا غصن بان يميل زهوا % % ريان في روضة الشباب % % 24(@)(@@) % لو كنت تصغي لرفع شكوى % % أطلت من قصة العتاب % % 25(@)(@@) % ومن لمثلي ببث نجوى % % للبدر في رفرف السحاب % % 26(@)(@@) % عزائم الصبر فيك حلت % % وعقدة الصبر تذخر % % 27(@)(@@) % قد أكثرت منك ما استقلت % % وليت لو كنت تشعر % % 28(@)(@@) % كم ليلة بتها وبتا % % ضدين في السهد والرقاد % % 29(@)(@@) % أسامر النجم فيك حتى % % علمت أجفانها السهاد % % 30(@)(@@) % ارقب بدر الدجى وأنتا % % قد لحت في هالة الفؤاد % % PageV01P358 31(@)(@@) % نفسي وليت ما تولت % % ولم تكن عنك تنفر % % 32(@)(@@) % لو سمتها الهجر ما تولت % % ولم تكن عنك تنفر % % 33(@)(@@) % علمها الصبر في الحروب % % سلطاننا عاقد البنود % % 34(@)(@@) % معفر الصيد للجنوب % % أعز من حف بالجنود % % 35(@)(@@) % نصرت بالرعب في القلوب % % والبيض لم تبرح الغمود % % 36(@)(@@) % عناية الله فيه حلت % % بسعده الدين ينصر % % 37(@)(@@) % والخلق في عصره تملت % % غنائما ليس تحصر % % 38(@)(@@) % مولاي يا نكتة الزمان % % دار بما ترتضي الفلك % % 39(@)(@@) % حللت باليمن والأمان % % كل مليك وما ملك % % 40(@)(@@) % لم يدر وصفي ولا عياني % % أملك أنت أم ملك % % PageV01P359 41(@)(@@) % جنودك الغلب حيث حلت % % بالفتح والنصر تخفر % % 42(@)(@@) % وعادة الله فيك دلت % % أنك بالكفر تظفر % % 43(@)(@@) % يا آية الله في الكمال % % ومخجل البدر في التمام % % 44(@)(@@) % قدمت بالعز والجلال % % والدهر في ثغره ابتسام % % 45(@)(@@) % يختال في حلة الجمال % % والبدر قد عاد في 
ms104	 اختتام % % 46(@)(@@) % ريحانة الفجر قد أطلت % % خضراء بالزهر تزهر % % 47(@)(@@) % وراية الصبح قد أظلت % % في مرقب الشرق تنشر % % PageV01P360 البحر : - 1(@)(@@) % عليك يا رية السلام % % ولا عدا ربعك المطر % % 2(@)(@@) % مذ حل في قصرك الإمام فقربك السؤل والوطر % . . . % 3(@)(@@) % والدوح في روضك الانيق % % للشكر قد حطت الرؤوس % % 4(@)(@@) % والغصن في نهره غريق % % وفي حلاه كما عروس % % 5(@)(@@) % والجو من وجهك الشريق % % تحسده أوجه الشموس % % 6(@)(@@) % وأعين الزهر لا تنام % % تستعذب السهد والسهر % % 7(@)(@@) % تنفث من تحتها الغمام % % ترقيك من أعين الزهر % % 8(@)(@@) % عروسة أنت يا عقيلة % % تجلى على مظهر الكمال % % 9(@)(@@) % مدت لك الكف مستقيلة % % تمسح أعطافك الشمال % % 10(@)(@@) % والبحر مرآتك الصقيلة % % تشف عن ذلك الجمال % % PageV01P361 11(@)(@@) % والحلي زهر له انتظام % % يكلل القضب بالدرر % % 12(@)(@@) % قد راق من ثغره ابتسام % % والورد في خدها خفر % % 13(@)(@@) % إن قيل من بعلها المفدى % % ومن له وصلها مباح % % 14(@)(@@) % أقول اسنى الملوك رفدا % % مخلد الفخر بالصفاح % % 15(@)(@@) % محمد الحمد حين يهدي % % ثناؤه عاطر الرياح % % 16(@)(@@) % تخبر عن طيبه الكمام % % والخبر يغني عن الخبر % % 17(@)(@@) % فالسعد والرعب والحسام % % والنصر آياته الكبر % % 18(@)(@@) % ذو غرة تسحر البدورا % % وطلعة تخجل الصباح % % 19(@)(@@) % كم راية سامها ظهورا % % تظلل الأوجه الصباح % % 20(@)(@@) % وكم ظلام جلاه نورا % % أظفر بالفوز والنجاح % % PageV01P362 21(@)(@@) % الطاهر الظاهر الهمام % % اعز من صال وافتخر % % 22(@)(@@) % لسيفه في العدى احتكام % % جرى به سابق القدر % % 23(@)(@@) % يا مرسل الخير في الغوار لو تطلب البحر تلحق % . . . % 24(@)(@@) % لك الجواري إذا تجاري % % سوابق الشهب تسبق % % 25(@)(@@) % تستن في لجة البحار % % فالكفر منهن يفرق % % 26(@)(@@) % فالدين وليقصر الكلام % % بسيفك اعتز وانتصر % % 27(@)(@@) % كذاك أسلافك الكرام % % هم نصروا سيد البشر % % PageV01P363 البحر : - 1(@)(@@) % نسيم غرناطة عليل % % لكنه يبرئ العليل % % 2(@)(@@) % وروضها زهره بليل % % ورشفه ينقع الغليل % % 3(@)(@@) % سقى بنجد ربى المصلى % % مباكرا روضة الغمام % % 4(@)(@@) % فجفنه كلما استهلا % % تبسم الزهر في الكمام % % 5(@)(@@) % والروض بالحسن قد تحلى وجرد النهر عن حسام % . . . % 6(@)(@@) % ودوحها ظله ظليل % % يحسن في ربعه المقيل % % 7(@)(@@) % والبرق والجو مستطيل % % يلعب 
ms105	 بالصارم الصقيل % % 8(@)(@@) % عقيلة تاجها السبيكة % % تطل بالمرقب المنيف % % 9(@)(@@) % كأنها فرقه مليكه % % كرسيها جنة العريف % % 10(@)(@@) % تطبع من عسجد سبيكه % % شموسها كلها تطيف % % PageV01P364 11(@)(@@) % ابدعك الخالق الجميل % % يا منظرا كله جميل % % 12(@)(@@) % قلبي إلى حسنه يميل % % وقبلنا قد صبا جميل % % 13(@)(@@) % وزاد للحسن فيك حسنا % % محمد الحمد والسماح % % 14(@)(@@) % جدد للفخر فيك مغنى % % في طالع اليمن والنجاح تدعى دشارا وفيك معنى يخصك الفأل بافتتاح % % 15(@)(@@) % فالنصر والسعد لا يزول % % لأنه ثابت أصيل % % 16(@)(@@) % سعد وأنصاره قبيل % % آباؤه عترة الرسول % % 17(@)(@@) % ابدى به حكمه القدير % % وتوج الروض بالقباب % % 18(@)(@@) % ودرع الزهر بالغدير % % وزين النهر بالحباب % % 19(@)(@@) % فمن هديل ومن هدير % % ما أولع الحسن بالشباب % % 20(@)(@@) % كبت على روضها القبول % % وطرفها بالسرى كليل فلم يزل بينها يجول حتى تبدت له حجول للزهر في عطفها رقوم تلوح للعين كالنجوم % % PageV01P365 21(@)(@@) % وللندى بينها رسوم % % عقد الندى فوقه نظيم % % 22(@)(@@) % وكل واد بها يهيم % % ولم يزل حولها يحوم % % 23(@)(@@) % شنيلها مد منه نيل % % والشين ألف لمستنيل % % 24(@)(@@) % وعين واد به تسيل % % من فوق خد له أسيل % % 25(@)(@@) % كم من ظلال به ترف % % تضفو له فوقها ستور % % 26(@)(@@) % ومن زجاج به يشف % % ما بين نور وبين نور % % 27(@)(@@) % ومن شموس بها تصف % % تديرها بينها البدور % % 28(@)(@@) % مزاجها العذب سلسبيل % % يا هل إلى رشفها سبيل % % 29(@)(@@) % وكيف والشيب لي عذول % % وصبغة صفرة الأصيل % % 30(@)(@@) % يا سرحة في الحمى ظليله % % كم نلت في ظلك المنى % % PageV01P366 31(@)(@@) % روضك الله من خميلة % % يجنى بها أطيب الجنى % % 32(@)(@@) % وبرقها صادق المخيلة % % ما زال بالغيث محسنا % % 33(@)(@@) % أنجز لي وعدك القبول % % فلم أقل مثل من يقول % % 34(@)(@@) % يا حسرة الحي يا مطول % % شرح الذي بيننا يطول % % PageV01P367 البحر : - 1(@)(@@) % قد طلعت راية الصباح % % وآذن الليل بالرحيل % % 2(@)(@@) % فباكر الروض باصطباح % % وأشرب على زهرة البليل % % 3(@)(@@) % فالورق هبت من السبات % % لمنبر الدوح تخطب % % 4(@)(@@) % تسجع مفتنة % % اللغات كل عن الشوق يعرب % % 5(@)(@@) % والغصن بعد الذهاب ياتي % % لأكؤس الطل يشرب % % 6(@)(@@) % وأدمع السحب في 
ms106	 انسياح % % في كل روض لها سبيل % % 7(@)(@@) % والجو مستبشر النواحي % % يلعب بالصارم الصقيل % % 8(@)(@@) % قم فاغتنم بهجة النفوس % % ما بين نور وبين نور % % 9(@)(@@) % وشفع الصبح بالشموس % % تديرها بيننا البدور % % 10(@)(@@) % ونبه الشرب للكؤوس % % تمزج من ريقة الثغور % % PageV01P368 11(@)(@@) % ما أجمل الراح فوق راح % % صفراء كالشمس في الاصيل % % 12(@)(@@) % تغادر الصدر ذا انشراح % % للأنس في طيه مقيل % % 13(@)(@@) % ولا تذر خمرة الجفون % % فسكرها في الهوى جنون % % 14(@)(@@) % ولتخش من أسهم العيون % % فإنها رائد المنون % % 15(@)(@@) % عرضت منها إلى الفتون % % وكل خطب بها يهون % % 16(@)(@@) % أهيم بالغادة الرادح % % والجسم من حبها عليل % % 17(@)(@@) % لو بت منها على اقتراح % % نقعت من ريقها الغليل % % 18(@)(@@) % أواعد الطيف للمنام % % ومن لعيني بالمنام % % 19(@)(@@) % اسهر في ليلة التمام % % وأنت يا بدر في التمام % % 20(@)(@@) % وألثم الزهر في الكمام % % عليه من ثغرك ابتسام % % PageV01P369 21(@)(@@) % سفرت عن مبسم الأقاح % % وريقك العذب سلسبيل % % 22(@)(@@) % قل لي يا ربة الوشاح % % هل لي إلى الوصل من سبيل % % 23(@)(@@) % يا لعبة الحسن زدت حسنا % % وللهوى حولك المطاف % % 24(@)(@@) % وغصن بان إذا تثنى % % لو حان من زهرك القطاف % % 25(@)(@@) % الا انعطاف على المعنى % % فالغصن يزهي بالانعطاف % % 26(@)(@@) % اصبحت تزهو على الملاح % % بذلك المنظر الجميل % % 27(@)(@@) % ووجهك الشمس في اتضاح % % لو أنها لم تكن تميل % % 28(@)(@@) % ما الزهر إلا بنظم در % % تحسد في حسنه العقود % % 29(@)(@@) % للملك الظاهر الاغر % % أكرم من حف بالسعود % % 30(@)(@@) % محمد الحمد وابن نصر % % وباسط العدل في الوجود % % PageV01P370 31(@)(@@) % مساجل السحب في السماح % % بالغيث من رفده الجليل % % 32(@)(@@) % ومخجل البدر في اللياح % % بغرة ما لها مثيل % % 33(@)(@@) % يا مشرب الحب في القلوب % % وواهب الصفح للصفاح % % 34(@)(@@) % نصرت بالرعب في الحروب % % والرعب أجدى من السلاح % % 35(@)(@@) % قد لحت من عالم الغيوب % % لم تعدم الفوز والفلاح % % 36(@)(@@) % مراكش نهبة افتتاح % % والصنع في فتحها جليل % % 37(@)(@@) % بشراك بالفتح والنجاح % % والشكر من ذلك القبيل % % PageV01P371 البحر : - 1(@)(@@) % أبلغ لغرناطة سلامي % % وصف لها عهدي السليم % % 2(@)(@@) % فلو رعى طيفها ذمامي % % ما بت في ليلة السليم 
ms107	 % % 3(@)(@@) % كم بت فيها على اقتراح % % أعل من خمرة الرضاب % % 4(@)(@@) % أدير فيها كؤوس راح % % قد زانها الثغر بالحباب % % 5(@)(@@) % أختال كالمهر في الجماح % % نشوان في روضة الشباب % % 6(@)(@@) % أضاحك الزهر في الكمام % % مباهيا روضة الوسيم % % 7(@)(@@) % وافضح الغصن في القوام % % إن هب من جوها نسيم % % 8(@)(@@) % بينا أنا والشباب ضاف % % وظله فوقنا مديد % % 9(@)(@@) % ومورد الأنس فيه صاف % % وبرده رائق جديد % % 10(@)(@@) % إذ لاح في الفود غير خاف % % صبح به نبه الوليد % % PageV01P372 11(@)(@@) % ايقظ من كان ذا منام % % لما انجلى ليله البهيم % % 12(@)(@@) % وأرسل الدمع كالغمام % % في كل واد به أهيم % % 13(@)(@@) % يا جيرة عهدهم كريم % % وفعلهم كلهم جميل % % 14(@)(@@) % لا تعذلوا الصب إذ يهيم % % فقبله قد صبا جميل % % 15(@)(@@) % القرب من ربعكم نعيم % % وبعدكم خطبه جليل % % 16(@)(@@) % كم من رياض به وسام % % يزهى بها الرائض المسيم % % 17(@)(@@) % غديرها أزرق الجمام % % ونبتها كله جميم % % 18(@)(@@) % أعندكم أنني بفاس % % أكابد الشوق والحنين % % 19(@)(@@) % أذكر أهلي بها وناسي % % واليوم في الطول كالسنين % % 20(@)(@@) % الله حسبي فكم أقاسي % % من وحشة الصحب والبنين % % PageV01P373 21(@)(@@) % مطارحا ساجع الحمام % % شوقا إلى الإلف والحميم % % 22(@)(@@) % والدمع قد لج في انسجام % % وقد وهى عقده النظيم % % 23(@)(@@) % يا ساكني جنة العريف % % اسكنتم جنة الخلود % % 24(@)(@@) % كم ثم من منظر شريف % % قد حف باليمن والسعود % % 25(@)(@@) % ورب طود به منيف % % أدواحه الخضر كالبنود % % 26(@)(@@) % والنهر قد سل كالحسام % % لراحة الشرب مستديم % % 27(@)(@@) % والزهر قد راق بابتسام % % مقبلا راحة النديم % % 28(@)(@@) % بلغ عبيد المقام صحبي % % لا زلتم الدهر في هنا % % 29(@)(@@) % لقاكم بغية المحب % % وقربكم غاية المنى % % 30(@)(@@) % فعندكم قد تركت قلبي % % فجدد الله عهدنا % % PageV01P374 31(@)(@@) % ودارك الشمل بانتظام % % من مرتجى فضله العميم % % 32(@)(@@) % في ظل سلطاننا الإمام % % الطاهر الظاهر الحليم % % 33(@)(@@) % مؤمن العدوتين مما % % يخاف من سطوة العدى % % 34(@)(@@) % وفارج الكرب إن الما % % ومذهب الخطب والردى % % 35(@)(@@) % قد راق حسنا وفاق حلما % % وما عدا غير ما بدا % % 36(@)(@@) % مولاي يا نخبة الأنام % % وحائز الفخر في القديم % % 37(@)(@@) % كم أرقب 
ms108	 البدر في التمام % % شوقا إلى وجهك الكريم % % PageV01P375 البحر : - 1(@)(@@) % في طالع اليمن والسعود % % قد كملت راحة الإمام % % 2(@)(@@) % فأشرق النور في الوجود % % وابتسم الزهر في الكمام % % 3(@)(@@) % قد طلعت راية النجاح % % وانهزم البؤس والعنا % % 4(@)(@@) % وقال حي على الفلاح % % مؤذن القوم بالمنى % % 5(@)(@@) % فالدهر يأتي بالاقتراح % % مستقبلا أوجه الهنا % % 6(@)(@@) % تخفق منشورة البرود % % والسعد يقدم من أمام % % 7(@)(@@) % والأنس مستجمع الوفود % % واللطف مستعذب الجمام % % 8(@)(@@) % وأكؤس الطل مترعات % % بأنمل السوسن الندي % % 9(@)(@@) % والطير مفتنة اللغات % % تشدو بأصوات معبد % % 10(@)(@@) % والغصن يذهب ثم ياتي % % بالسندس الغض مرتدي % % PageV01P376 11(@)(@@) % والدوح يومي إلى السجود % % شكرا لذي الأنعم الجسام % % 12(@)(@@) % والريح خفاقة البنود % % تباكر الروض بالغمام % % 13(@)(@@) % مظاهر للجمال تجلى % % قد هز أعطافها السرور % % 14(@)(@@) % وباهر الحسن قد تجلى % % ما بين نور وبين نور % % 15(@)(@@) % قد هنأت بالشفاء مولى % % بعصره تفخر العصور % % 16(@)(@@) % ما بين باس وبين جود % % قد مهد الأمن للأنام % % 17(@)(@@) % فالدين ذو أعين رقود % % وكان لا يطعم المنام % % 18(@)(@@) % والكأس في راحة السقاة % % تروح طورا وتغتدي % % 19(@)(@@) % يهديكها رائق السمات % % ما بين برق وفرقد % % 20(@)(@@) % والشمس تذهب للبيات % % قد لبست ثوب عسجد % % PageV01P377 21(@)(@@) % والزهر في اليانع المجود % % يقابل الشرب بابتسام % % 22(@)(@@) % والروض من حلية الغمود % % قد جرد النهر عن حسام % % 23(@)(@@) % مولاي يا اشرف الملوك % % وعصمة الخلق اجمعين % % 24(@)(@@) % أهديك من جوهر السلوك % % يقذفه بحرك المعين جعلت تنظيمه سلوكي وانت لي المنجد المعين % % 25(@)(@@) % تحية الواحد المجيد % % ورحمة الله والسلام % % 26(@)(@@) % عليك من راحم ودود % % يا مخجل البدر في التمام % % PageV01P378 البحر : - 1(@)(@@) % قد أنعم الله بالشفاء % % واستكملت راحة الإمام % % 2(@)(@@) % فلتنطق الطير بالهناء % % وليضحك الزهر في الكمام % % 3(@)(@@) % وجوده بهجة الوجود وبرؤه راحة النفوس % . . . % 4(@)(@@) % قد لاح في مرقب السعود % % واستبشرت أوجه الشموس % % 5(@)(@@) % فالدوح يومي إلى البنود % % أكمامه غطت الرؤوس % % 6(@)(@@) % والزهر في روضة السماء % % كالزهر قد راق بابتسام % % 7(@)(@@) % والصبح مستشرف اللواء % % والبدر مستقبل التمام % % 8(@)(@@) % محاسن الكون قد تجلت % % جمالها العقل يبهر % % 9(@)(@@) % عرائس بالبها تحلت % % والطل في 
ms109	 الحلي جوهر % % 10(@)(@@) % وألسن الورق قد أملت % % مدائحا عنه تشكر % % PageV01P379 11(@)(@@) % تستوقف الخلق بالغناء % % كأنها تحسن الكلام % % 12(@)(@@) % تطنب لله في الثناء % % تقول سلمت يا سلام % % 13(@)(@@) % كم من ثغور لها ثغور % % تبسم إذ جاءها البشير ومن خدور بها بدور يشير منها له المشير % % 14(@)(@@) % تقول إذ حفها السرور % % تبارك المنعم القدير % % 15(@)(@@) % قد أنعم الله بالبقاء % % في ظل مولى به اعتصام % % 16(@)(@@) % قد صادف النجح في الدواء % % فالداء عنا له انفصام % % 17(@)(@@) % يهنيك مولاي بل يهني % % ببرئك الدين والهدى % % 18(@)(@@) % فالغرب والشرق منك يعنى % % بمذهب الخطب والردى والله لولاك ما تهنا ما فيه من سطوة الردى % % 19(@)(@@) % يا مورد الانفس الظماء % % قد كان يشتفها الاوام % % 20(@)(@@) % وقرة العين بالبهاء % % رددت للأعين التمام % % PageV01P380 21(@)(@@) % لو أبذل الروح في البشاره % % بذلت بعض الذي ملك % % 22(@)(@@) % فأنت يا نفس مستعارة % % مولاي بالفضل جملك % % 23(@)(@@) % لم أدر إذ سطر العبارة % % أملك هو أم ملك % % 24(@)(@@) % لا زلت مولاي في هناء % % مبلغ القصد والمرام % % 25(@)(@@) % ودمت للملك في اعتلاء % % تسحب أذياله الغمام % % PageV01P381 
