ms228	(@)(@@) 55 و اندر رضای او گه و بیگه به شعر زهد %~% مر خلق را به رشته کنم علم و حکمتش(@)(@@) 56 مستنصری معانی و حکمت به نظم و نثر %~% بر امتت که خواند الا که حجتش PageV1P122(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه بود این چرخ گردان را که دیگر گشت سامانش %~% به بستان جامه زربفت بدریدند خوبانش(@)(@@) 2 منقش جامه‌هاشان را که‌شان پوشید فروردین %~% فرو شست از نگار و نقش ماه مهر و آبانش(@)(@@) 3 همانا با خزان گل را به بستان عهد و پیمان بود %~% که پنهان شد چو بدگوهر خزان بشکست پیمانش(@)(@@) 4 ز سر بنهاد شاخ گل به باغ آن تاج پر درش %~% به رخ بر بست خورشید آن نقاب خز خلقانش(@)(@@) 5 همان که سر که پوشیدش به دیبا باد نوروزی %~% خزانی باد پنهان کرد در محلوج کوهانش(@)(@@) 6 یکی گردنده گوئی بر شد از دریا سوی گردون %~% که جز کافور و مروارید و گوهر نیست در کانش(@)(@@) 7 نهنگی را همی ماند که گردون را بیوبارد %~% چو از دریا برآمد جوش از بحر هر عصیانش(@)(@@) 8 نباشد جز که یک میدان نشیب و کوه و هامونش %~% نیاید بیش یک لقمه خراب و خاک و عمرانش(@)(@@) 9 نپوشد جز بدو عالم ز خز و تو ز پیراهن %~% نگردد جز که از خورشید فرسوده گریبانش(@)(@@) 10 بغرد همچو اژدرها چو بر عالم بیاشوبد %~% ببارد آتش و دود از میان کام و دندانش(@)(@@) 11 خزینه آب و آتش گشت بر گردون که پنداری %~% زخشم خویش و از رحمت مرکب کرد یزدانش(@)(@@) 12 بمیرد چون بگرید سیر تا هشیار پندارد %~% که چیزی جز که گریه نیست ترکیب تن و جانش(@)(@@) 13 مگر تخت سلیمان است کز دریا سحرگاهان %~% نباشد زی که و هامون مگر بر باد جولانش(@)(@@) 14 چنین تیره چرائی ای مبارک تخت رخشنده %~% همانا کز سلیمانت بدزدیدند دیوانش(@)(@@) 15 تو مرغان را همی سایه کنی امروز اگر روزی %~% تو 
ms229	 را سایه همی کردند و او را نیز مرغانش(@)(@@) 16 فلک را پرده و که را کلاه و خاک را خیمه %~% میانجی کرد یزدانت میان چرخ و ارکانش(@)(@@) 17 چو دایه مهربانی جمله فرزندان عالم را %~% همی گردی کجا هستند در آباد و ویرانش(@)(@@) 18 به فعل خوب تو خوب است روی زشت تو زی آن %~% که او مر آفرینش را بداند راه و سامانش(@)(@@) 19 نه اندر صورت خوب است زیب مرد و نیکوئی %~% ولیکن در خوی خوب است خوبی‌ی مرد و در دانش(@)(@@) 20 سخن عنوان نامه مردم آمد هر که را خواهی %~% که برخوانی به چشم گوش بنگر سوی عنوانش(@)(@@) 21 دو صورت هست مردم را به هر دو بنگر و بررس %~% به چشم از روی پیدائش به گوش از جان پنهانش(@)(@@) 22 نپرسد مرد را کس که «ت چرا رخ نیست چون دیبا» %~% ولیکن «چونکه نادانی» بسی گویند مردانش(@)(@@) 23 نکوهش مرگ را ماند ستایش زندگانی را %~% چو نادانی بود علت مدان جز علم درمانش(@)(@@) 24 بمیرد صورت جسمی سخن ماند ز ما زنده %~% سخن دان را بر این دعوی چو خورشید است برهانش(@)(@@) 25 همی طاووس را بکشی ز بهر پر رنگینش %~% بداری زنده بلبل را ز بهر خوب الحانش(@)(@@) 26 به حکمت کوش تا باشد که باشی بلبل یزدان %~% بمانی جاودان اندر بهشت خلد رضوانش(@)(@@) 27 نبینی چند احسان کرد بی طاعت بجای تو %~% اگر طاعت کنی بی شک مضاعف گردد احسانش(@)(@@) 28 نبینی گر خردمندی که تو کرسی یزدانی %~% نبینی کز جهان جز بر تو ننبشته است فرمانش(@)(@@) 29 زمین خوان خدای است ای برادر پر ز نعمت‌ها %~% که جز مردم نیابد بر همی از نعمت و خوانش(@)(@@) 30 نیابد آن خوشی حیوان که مردم یابد از دنیا %~% و گرچه زو فزون از ما تواند خورد حیوانش(@)(@@) 31 ندارد شادمانش روی خوب و خز و سقلاطون %~% نبخشد بوی خوش هرگز عبیر و عنبر 
ms230	 و بانش(@)(@@) 32 بیابان است اگر باع است یکسان است سوی او %~% نه شاد و خوش کند اینش نه مستوحش کند آنش(@)(@@) 33 پدید آمد پس ای دانا که عالم خوان یزدان است %~% و حیوان چونکه طفلانند و جز تو نیست مهمانش(@)(@@) 34 مر این را چاشنی پندار و شکرش کن زیادت را %~% و گر کفرانش پیش آری بترس از بند و تاوانش(@)(@@) 35 به چشم دل نکو بنگر ببین این خوان پر نعمت %~% که بنهاده است پیش تو در این زنگاری ایوانش(@)(@@) 36 اگر دانی که مهمانی چرا پس پست ننشستی %~% بباید بهر تو یکسر زخوان ساران و پایانش(@)(@@) 37 که جز تو نیز خواهد بود مهمانان مر ایزد را %~% که می‌خواند در این خوان‌شان ازو افلاک و دورانش(@)(@@) 38 تو را افلاک و دوران خواند در میدان یزدانی %~% برونت رفت باید تا نگردد تنگ میدانش(@)(@@) 39 همی خواهندت از میدان برون راندن به دشواری %~% که با هر خوانده‌ای این است رسم و سیرت و سانش(@)(@@) 40 زمان چوگان گردون است و میدان خاک و تو بر وی %~% مگر گوئی یکی گردنده گوئی پیش چوگانش(@)(@@) 41 یکی زندان تنگ است این که باغش ظن برد نادان %~% سوار است آنکه پندارد که بستان است زندانش(@)(@@) 42 حذر کن زین ره افگن یار و بد خو دشمن خندان %~% که تا خلقت نگیرد ناگهان نشناسی آسانش(@)(@@) 43 اگر با میر صحبت کرد میرانید میرش را %~% و گر با خان برادر شد خیانت دید ازو خانش(@)(@@) 44 نیاساید ز بیدادی که مرکب تیز رو دارد %~% فرو سایدت اگر سنگی که بس تیز است سوهانش(@)(@@) 45 بکش نفس ستوری را به دشنه حکمت و طاعت %~% بکش زین دیو دستت را که بسیار است دستانش(@)(@@) 46 یکی غول فریبنده است نفس آرزو خواهت %~% که بی‌باکی چرا خورش است و نادانی بیابانش(@)(@@) 47 به ره باز آید این گم راه دیوت گر بخواهی تو %~% مسلمانی بیابد 
ms231	 گر خرد باشد سلیمانش(@)(@@) 48 که را عقل از فضایل خلعتی دینی بپوشاند %~% نداند کرد از آن خلعت هگرز این دیو عریانش(@)(@@) 49 مرا در پیرهن دیوی منافق بود و گردن کش %~% ولیکن عقل یاری داد تا کردم مسلمانش(@)(@@) 50 مرا در دین نپندارد کسی حیران و گم بوده %~% جز آن حیران که حیرانی دگر کرده‌است حیرانش(@)(@@) 51 مرا گویند بد دین است و فاضل بهتر آن بودی %~% که دینش پاک بودی و نبودی فضل چندانش(@)(@@) 52 نبیند چشم ناقص طلعت پر نور فاضل را %~% که چشمش را بخست از دیدن او خار نقصانش(@)(@@) 53 که چون خفاش نتواند که بیند روی من نادان %~% زمن پنهان شود زیرا منم خورشید رخشانش(@)(@@) 54 مغیلان است جاهل پیشم و من پیش او ریحان %~% ندارد پیش ریحانم خطر ناخوش مغیلانش(@)(@@) 55 همی گوید «بپرسیدش پس از ایمان به فرقان او %~% به پیغمبر رسول مصطفی از فضل یارانش(@)(@@) 56 اگر کمتر ندارد مر علی را از همه یاران %~% نباشد جز که باطل زی خدای اسلام و ایمانش»(@)(@@) 57 اگر منکر شوم دعویش را بر کفر و جهل من %~% گواهی یکسره بدهند جهال خراسانش(@)(@@) 58 چرا گوید خردمند آنچه ندهد بر صواب آن %~% گوائی عقل بی آفت نه نیز آیات فرقانش(@)(@@) 59 چرا گویم که بهتر بود در عالم کسی زان کس %~% که بر اعدای دین بر تیغ محنت بود بارانش(@)(@@) 60 از آن سید که از فرمان رب‌العرش پیغمبر %~% وصی کردش در آن معدن که منبر بود پالانش(@)(@@) 61 از آن مشهور شیر نر که اندر بدر و در خیبر %~% هوا از چشم خون بارید بر صمصام خندانش(@)(@@) 62 شدی حیران و بی سامان و کردی نرم گردن را %~% اگر دیدی به صف دشمنان سام نریمانش(@)(@@) 63 کسی کو دیگری را برگزیند بر چنین حری %~% بپرسد روز حشر ایزد ز تن بی روی بهتانش PageV1P123(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نگذاشت خواهد ایدرش %~% بر رغم او صورت 
