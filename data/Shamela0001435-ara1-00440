ms421	 قال: (@)(@@) @MATN@ «ليس في الصرف اختلاف» (@)(@@) (@)PageV03P535 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٢ - (@)(@@) حدثنا الحسن بن علي الخلال قال: حدثنا يزيد بن هارون قال: أخبرنا حماد بن سلمة، عن سماك بن حرب، عن سعيد بن جبير، عن ابن عمر قال: كنت أبيع الإبل بالبقيع، فأبيع بالدنانير فآخذ مكانها الورق، وأبيع بالورق فآخذ مكانها الدنانير، فأتيت رسول الله صلى الله عليه وسلم فوجدته خارجا من بيت حفصة، فسألته عن ذلك؟ فقال: (@)(@@) @MATN@ «لا بأس به بالقيمة» : (@)(@@) @MATN@ «هذا حديث لا نعرفه مرفوعا إلا من حديث سماك بن حرب، عن سعيد بن جبير، عن ابن عمر» (@)(@@) وروى داود بن أبي هند هذا الحديث، عن سعيد بن جبير، عن ابن عمر موقوفا والعمل على هذا عند بعض أهل العلم: أن لا بأس أن يقتضي الذهب من الورق، والورق من الذهب، وهو قول أحمد، وإسحاق، وقد كره بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم ذلك (@)PageV03P536 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٣ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن شهاب، عن مالك بن أوس بن الحدثان، أنه قال: أقبلت أقول من يصطرف الدراهم، فقال طلحة بن عبيد الله وهو عند عمر بن الخطاب: أرنا ذهبك، ثم ائتنا إذا جاء خادمنا نعطك ورقك، فقال عمر: كلا والله، لتعطينه ورقه أو لتردن إليه ذهبه، فإن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الورق بالذهب ربا إلا هاء وهاء، والبر بالبر ربا إلا هاء وهاء، والشعير بالشعير ربا إلا هاء وهاء، والتمر بالتمر ربا إلا هاء وهاء» : (@)(@@) هذا حديث حسن صحيح، والعمل على هذا عند أهل العلم ومعنى قوله: إلا هاء وهاء، يقول: (@)(@@) @MATN@ «يدا بيد» (@)(@@) (@)PageV03P537 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ابتياع النخل بعد التأبير والعبد وله مال (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٤ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن شهاب، عن سالم، عن أبيه قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من ابتاع نخلا بعد أن تؤبر فثمرتها للذي باعها إلا أن يشترط المبتاع، ومن ابتاع عبدا وله مال فماله للذي باعه إلا أن يشترط المبتاع» (@)(@@) وفي الباب عن جابر وحديث 
ms422	 ابن عمر حديث حسن صحيح، هكذا روي من غير وجه عن الزهري، عن سالم، عن ابن عمر، عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «من ابتاع نخلا بعد أن تؤبر، فثمرتها للبائع إلا أن يشترط المبتاع، ومن باع عبدا وله مال فماله للذي باعه إلا أن يشترط المبتاع» (@)(@@) وقد روي، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من ابتاع نخلا قد أبرت فثمرتها للبائع إلا أن يشترط المبتاع» (@)(@@) PageV03P538 وقد روي، عن نافع، عن ابن عمر، عن عمر أنه قال: (@)(@@) @MATN@ «من باع عبدا وله مال فماله للبائع إلا أن يشترط المبتاع» ، (@)(@@) هكذا رواه عبيد الله بن عمر، وغيره، عن نافع الحديثين، وقد روى بعضهم هذا الحديث، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم أيضا، وروى عكرمة بن خالد، عن ابن عمر، عن النبي صلى الله عليه وسلم نحو حديث سالم والعمل على هذا الحديث عند بعض أهل العلم، وهو قول الشافعي، وأحمد، وإسحاق قال محمد بن إسماعيل: حديث الزهري، عن سالم، عن أبيه، عن النبي صلى الله عليه وسلم أصح ما جاء في هذا الباب (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في البيعين بالخيار ما لم يتفرقا (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٥ - (@)(@@) حدثنا واصل بن عبد الأعلى قال: حدثنا محمد بن فضيل، عن يحيى بن سعيد، عن نافع، عن ابن عمر قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «البيعان بالخيار ما لم يتفرقا أو يختارا» (@)(@@) PageV03P539 قال: (@)(@@) @MATN@ «فكان ابن عمر إذا ابتاع بيعا وهو قاعد قام ليجب له البيع» : (@)(@@) وفي الباب عن أبي برزة، وحكيم بن حزام، وعبد الله بن عباس، وعبد الله بن عمرو، وسمرة، وأبي هريرة: (@)(@@) @MATN@ «حديث ابن عمر حديث حسن صحيح» (@)(@@) والعمل على هذا عند بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم، وهو قول الشافعي، وأحمد، وإسحاق، وقالوا: (@)(@@) @MATN@ «الفرقة بالأبدان لا بالكلام» (@)(@@) وقد قال بعض أهل العلم: معنى قول النبي صلى الله عليه وسلم (@)(@@) @MATN@ «ما لم يتفرقا» ، (@)(@@) يعني: الفرقة بالكلام، 
ms423	 والقول الأول أصح لأن ابن عمر هو روى عن النبي صلى الله عليه وسلم وهو أعلم بمعنى ما روى وروي عنه أنه كان إذا أراد أن يوجب البيع مشى ليجب له، وهكذا روي عن أبي برزة (@) (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٦ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد، عن شعبة، عن قتادة، عن صالح أبي الخليل، عن عبد الله بن الحارث، عن حكيم بن حزام، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «البيعان بالخيار PageV03P540 ما لم يتفرقا، فإن صدقا وبينا بورك لهما في بيعهما، وإن كتما وكذبا محقت بركة بيعهما» (@)(@@) هذا حديث صحيح (@) (@)(@) (@)(@@) وهكذا روي عن أبي برزة الأسلمي أن رجلين اختصما إليه في فرس بعد ما تبايعا وكانوا في سفينة، فقال: لا أراكما افترقتما، وقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «البيعان بالخيار ما لم يتفرقا» (@)(@@) وقد ذهب بعض أهل العلم من أهل الكوفة وغيرهم إلى أن الفرقة بالكلام، وهو قول سفيان الثوري، وهكذا روي عن مالك بن أنس، وروي عن ابن المبارك أنه قال: كيف أرد هذا؟ والحديث فيه عن النبي صلى الله عليه وسلم صحيح وقوى هذا المذهب. ومعنى قول النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إلا بيع الخيار» ، (@)(@@) معناه: أن يخير البائع المشتري بعد إيجاب البيع، فإذا خيره فاختار البيع فليس له خيار بعد ذلك في فسخ البيع، وإن لم يتفرقا، هكذا فسره الشافعي، وغيره، ومما يقوي قول من يقول: الفرقة بالأبدان لا بالكلام، حديث عبد الله بن عمرو، عن النبي صلى الله عليه وسلم (@)PageV03P541 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٧ - (@)(@@) أخبرنا بذلك قتيبة بن سعيد قال: حدثنا الليث بن سعد، عن ابن عجلان، عن عمرو بن شعيب، عن أبيه، عن جده، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «البيعان بالخيار ما لم يتفرقا إلا أن تكون صفقة خيار ولا يحل له أن يفارق صاحبه خشية أن يستقيله» : (@)(@@) هذا حديث حسن ومعنى هذا: أن يفارقه بعد البيع خشية أن يستقيله، ولو كانت الفرقة بالكلام ولم يكن له خيار بعد البيع لم يكن 
ms424	 لهذا الحديث معنى، حيث قال صلى الله عليه وسلم: (@)(@@) @MATN@ «ولا يحل له أن يفارقه خشية أن يستقيله» (@)(@@) (@)PageV03P542 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٨ - (@)(@@) حدثنا نصر بن علي قال: حدثنا أبو أحمد قال: حدثنا يحيى بن أيوب وهو البجلي الكوفي، قال: سمعت أبا زرعة بن عمرو بن جرير يحدث، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا يتفرقن عن بيع إلا عن تراض» : (@)(@@) هذا حديث غريب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٤٩ - (@)(@@) حدثنا عمر بن حفص الشيباني قال: حدثنا ابن وهب، عن ابن جريج، عن أبي الزبير، عن جابر، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم خير أعرابيا بعد البيع» (@)(@@) وهذا حديث صحيح غريب (@)PageV03P543 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن يخدع في البيع (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٠ - (@)(@@) حدثنا يوسف بن حماد البصري قال: حدثنا عبد الأعلى بن عبد الأعلى، عن سعيد، عن قتادة، عن أنس، أن رجلا كان في عقدته ضعف، وكان يبايع، وأن أهله أتوا النبي صلى الله عليه وسلم، فقالوا: يا رسول الله، احجر عليه، فدعاه نبي الله صلى الله عليه وسلم، فنهاه، فقال: يا رسول الله، إني لا أصبر عن البيع، فقال: (@)(@@) @MATN@ «إذا بايعت فقل هاء وهاء، ولا خلابة» : (@)(@@) وفي الباب عن ابن عمر وحديث أنس حديث حسن صحيح غريب (@)(@@) @MATN@ " والعمل على هذا الحديث عند بعض أهل العلم، وقالوا: الحجر على الرجل الحر في البيع والشراء إذا كان ضعيف العقل، وهو قول أحمد، وإسحاق، ولم ير بعضهم أن يحجر على الحر البالغ " (@)PageV03P544 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في المصراة (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥١ - (@)(@@) حدثنا أبو كريب قال: حدثنا وكيع، عن حماد بن سلمة، عن محمد بن زياد، عن أبي هريرة قال: قال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «من اشترى مصراة فهو بالخيار إذا حلبها، إن شاء ردها ورد معها صاعا من تمر» : (@)(@@) وفي الباب عن أنس، ورجل من أصحاب النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عامر قال: حدثنا قرة بن خالد، عن محمد بن سيرين، عن أبي هريرة، عن النبي صلى الله عليه وسلم PageV03P545 قال: (@)(@@) @MATN@ «من اشترى مصراة 
ms425	 فهو بالخيار ثلاثة أيام، فإن ردها رد معها صاعا من طعام لا سمراء» : (@)(@@) هذا حديث حسن صحيح، والعمل على هذا الحديث عند أصحابنا منهم: الشافعي، وأحمد، وإسحاق، ومعنى قوله: (@)(@@) @MATN@ «لا سمراء» ، (@)(@@) يعني: لا بر (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في اشتراط ظهر الدابة عند البيع (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٣ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا وكيع، عن زكريا، عن الشعبي، عن جابر بن عبد الله أنه (@)(@@) @MATN@ «باع من النبي صلى الله عليه وسلم بعيرا واشترط ظهره إلى أهله» : (@)(@@) هذا حديث حسن صحيح، وقد روي من غير وجه عن جابر والعمل على هذا عند بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: يرون الشرط في البيع جائزا إذا كان شرطا واحدا، وهو قول أحمد، وإسحاق وقال بعض أهل العلم: لا يجوز الشرط في البيع، ولا يتم البيع إذا كان فيه شرط (@)PageV03P546 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الانتفاع بالرهن (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٤ - (@)(@@) حدثنا أبو كريب، ويوسف بن عيسى، قالا: حدثنا وكيع، عن زكريا، عن عامر، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الظهر يركب إذا كان مرهونا، ولبن الدر يشرب إذا كان مرهونا، وعلى الذي يركب ويشرب نفقته» : (@)(@@) هذا حديث حسن صحيح غريب لا نعرفه مرفوعا، إلا من حديث عامر الشعبي، عن أبي هريرة وقد روى غير واحد هذا الحديث عن الأعمش، عن أبي صالح، عن أبي هريرة موقوفا، والعمل على هذا الحديث عند بعض أهل العلم، وهو قول أحمد، وإسحاق، وقال بعض أهل العلم: ليس له أن ينتفع من الرهن بشيء (@)PageV03P547 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في شراء القلادة وفيها ذهب وخرز (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٥ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن أبي شجاع سعيد بن يزيد، عن خالد بن أبي عمران، عن حنش الصنعاني، عن فضالة بن عبيد، قال: اشتريت يوم خيبر قلادة باثني عشر دينارا فيها ذهب وخرز، ففصلتها، فوجدت فيها أكثر من اثني عشر دينارا، فذكرت ذلك للنبي صلى الله عليه وسلم، فقال: (@)(@@) @MATN@ «لا تباع حتى تفصل» (@)(@@) حدثنا قتيبة قال: حدثنا ابن المبارك، عن 
ms426	 أبي شجاع سعيد بن يزيد بهذا الإسناد نحوه،: هذا حديث حسن صحيح والعمل على هذا عند بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم، وغيرهم لم يروا أن يباع السيف محلى، أو منطقة مفضضة، أو مثل هذا بدراهم، حتى يميز ويفصل، وهو قول ابن المبارك، والشافعي، وأحمد، وإسحاق، وقد رخص بعض أهل العلم في ذلك من أصحاب النبي صلى الله عليه وسلم وغيرهم (@)PageV03P548 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في اشتراط الولاء والزجر عن ذلك (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٦ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن منصور، عن إبراهيم، عن الأسود، عن عائشة، أنها أرادت أن تشتري بريرة فاشترطوا الولاء، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «اشتريها فإنما الولاء لمن أعطى الثمن، أو لمن ولي النعمة» (@)(@@) وفي الباب عن ابن عمر. حديث عائشة حديث حسن صحيح، والعمل على هذا عند أهل العلم. ومنصور بن المعتمر يكنى أبا عتاب. حدثنا أبو بكر العطار البصري، عن ابن المديني قال: سمعت يحيى بن سعيد، يقول: (@)(@@) @MATN@ «إذا حدثت عن منصور فقد ملأت يدك من الخير لا ترد غيره» (@)(@@) ثم قال يحيى: ما أجد في إبراهيم النخعي، ومجاهد أثبت من منصور PageV03P549 وأخبرني محمد، عن عبد الله بن أبي الأسود قال: قال عبد الرحمن بن مهدي: منصور أثبت أهل الكوفة (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٧ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو بكر بن عياش، عن أبي حصين، عن حبيب بن أبي ثابت، عن حكيم بن حزام، أن رسول الله صلى الله عليه وسلم بعث حكيم بن حزام يشتري له أضحية بدينار، فاشترى أضحية، فأربح فيها دينارا، فاشترى أخرى مكانها، فجاء بالأضحية والدينار إلى رسول الله صلى الله عليه وسلم، فقال: (@)(@@) @MATN@ «ضح بالشاة، وتصدق بالدينار» : (@)(@@) حديث حكيم بن حزام لا نعرفه إلا من هذا الوجه، وحبيب بن أبي ثابت لم يسمع عندي من حكيم بن حزام (@)PageV03P550 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٨ - (@)(@@) حدثنا أحمد بن سعيد الدارمي قال: حدثنا حبان وهو ابن هلال أبو حبيب البصري قال: حدثنا هارون الأعور المقرئ وهو 
ms427	 ابن موسى القارئ قال: حدثنا الزبير بن الخريت، عن أبي لبيد، عن عروة البارقي، قال: دفع إلي رسول الله صلى الله عليه وسلم دينارا لأشتري له شاة، فاشتريت له شاتين، فبعت إحداهما بدينار، وجئت بالشاة والدينار إلى النبي صلى الله عليه وسلم، فذكر له ما كان من أمره، فقال له: (@)(@@) @MATN@ «بارك الله لك في صفقة يمينك» ، (@)(@@) فكان يخرج بعد ذلك إلى كناسة الكوفة فيربح الربح العظيم، فكان من أكثر أهل الكوفة مالا حدثنا أحمد بن سعيد الدارمي قال: حدثنا حبان قال: حدثنا سعيد بن زيد، قال: حدثنا الزبير بن خريت فذكر نحوه، عن أبي لبيد. وقد ذهب بعض أهل العلم إلى هذا الحديث وقالوا به، وهو قول أحمد، وإسحاق، ولم يأخذ بعض أهل العلم بهذا الحديث منهم: الشافعي. وسعيد بن زيد أخو حماد بن زيد، وأبو لبيد اسمه لمازة بن زبار (@)PageV03P551 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في المكاتب إذا كان عنده ما يؤدي (@)(@) (@)(@@)(@@)(@@) ||| ١٢٥٩ - (@)(@@) حدثنا هارون بن عبد الله البزار قال: حدثنا يزيد بن هارون قال: أخبرنا حماد بن سلمة، عن أيوب، عن عكرمة، عن ابن عباس، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إذا أصاب المكاتب حدا أو ميراثا ورث بحساب ما عتق منه» (@)(@@) وقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «يؤدي المكاتب بحصة ما أدى دية حر، وما بقي دية عبد» (@)(@@) وفي الباب عن أم سلمة: حديث ابن عباس حديث حسن وهكذا روى يحيى بن أبي كثير، عن عكرمة، عن ابن عباس، عن النبي صلى الله عليه وسلم، وروى خالد الحذاء، عن عكرمة، عن علي قوله والعمل على هذا الحديث عند بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم، PageV03P552 وقال أكثر أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: المكاتب عبد ما بقي عليه درهم، وهو قول سفيان الثوري، والشافعي، وأحمد، وإسحاق (@) (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٠ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد الوارث بن سعيد، عن يحيى بن أبي أنيسة، عن عمرو بن شعيب، عن أبيه، عن جده قال: سمعت 
ms428	 رسول الله صلى الله عليه وسلم يخطب يقول: (@)(@@) @MATN@ «من كاتب عبده على مائة أوقية فأداه إلا عشر أواق» (@)(@@) أو قال: (@)(@@) @MATN@ «عشرة دراهم ثم عجز فهو رقيق» : (@)(@@) هذا حديث غريب والعمل عليه عند أكثر أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: أن المكاتب عبد ما بقي عليه شيء من كتابته وقد روى الحجاج بن أرطاة، عن عمرو بن شعيب نحوه (@)PageV03P553 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦١ - (@)(@@) حدثنا سعيد بن عبد الرحمن، قال: حدثنا سفيان بن عيينة، عن الزهري، عن نبهان، مولى أم سلمة عن أم سلمة قالت: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا كان عند مكاتب إحداكن ما يؤدي فلتحتجب منه» : (@)(@@) هذا حديث حسن صحيح ومعنى هذا الحديث عند أهل العلم على التورع، وقالوا: لا يعتق المكاتب وإن كان عنده ما يؤدي حتى يؤدي (@)(@) (@)(@@)(@@)(@@) || باب ما جاء إذا أفلس للرجل غريم فيجد عنده متاعه (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٢ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن يحيى بن سعيد، عن أبي بكر بن محمد بن عمرو بن حزم، عن عمر بن عبد العزيز، PageV03P554 عن أبي بكر بن عبد الرحمن بن الحارث بن هشام، عن أبي هريرة، عن رسول الله صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «أيما امرئ أفلس ووجد رجل سلعته عنده بعينها فهو أولى بها من غيره» (@)(@@) وفي الباب عن سمرة، وابن عمر. حديث أبي هريرة حديث حسن صحيح، والعمل على هذا عند بعض أهل العلم، وهو قول الشافعي، وأحمد، وإسحاق. وقال بعض أهل العلم: هو أسوة الغرماء، وهو قول أهل الكوفة (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النهي للمسلم أن يدفع إلى الذمي الخمر يبيعها له (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٣ - (@)(@@) حدثنا علي بن خشرم قال: أخبرنا عيسى بن يونس، عن مجالد، عن أبي الوداك، عن أبي سعيد قال: كان عندنا خمر ليتيم فلما نزلت المائدة سألت رسول الله صلى الله عليه وسلم عنه، وقلت: إنه ليتيم، فقال: (@)(@@) @MATN@ «أهريقوه» (@)(@@) وفي الباب عن أنس بن مالك: PageV03P555 حديث أبي سعيد حديث حسن، وقد روي من غير وجه عن النبي صلى الله عليه 
ms429	 وسلم نحو هذا , وقال بهذا بعض أهل العلم، وكرهوا أن تتخذ الخمر خلا، وإنما كره من ذلك والله أعلم أن يكون المسلم في بيته خمر حتى يصير خلا، ورخص بعضهم في خل الخمر إذا وجد قد صار خلا. أبو الوداك اسمه جبر بن نوف (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٤ - (@)(@@) حدثنا أبو كريب قال: حدثنا طلق بن غنام، عن شريك، وقيس، عن أبي حصين، عن أبي صالح، عن أبي هريرة قال: قال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «أد الأمانة إلى من ائتمنك، ولا تخن من خانك» : (@)(@@) هذا حديث حسن غريب وقد ذهب بعض أهل العلم إلى هذا الحديث، وقالوا: إذا كان للرجل على آخر شيء، فذهب به، فوقع له عنده شيء، فليس له أن يحبس عنه بقدر ما ذهب له عليه، ورخص فيه بعض أهل العلم من التابعين، وهو قول الثوري وقال: " إن كان له عليه دراهم PageV03P556 فوقع له عنده دنانير فليس له أن يحبس بمكان دراهمه، إلا أن يقع عنده له دراهم فله حينئذ أن يحبس من دراهمه بقدر ما له عليه (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في أن العارية مؤداة (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٥ - (@)(@@) حدثنا هناد، وعلي بن حجر، قالا: حدثنا إسماعيل بن عياش، عن شرحبيل بن مسلم الخولاني، عن أبي أمامة قال: سمعت النبي صلى الله عليه وسلم يقول في الخطبة عام حجة الوداع: (@)(@@) @MATN@ «العارية مؤداة، والزعيم غارم، والدين مقضي» : (@)(@@) وفي الباب عن سمرة، وصفوان بن أمية، وأنس وحديث أبي أمامة حديث حسن، وقد روي عن أبي أمامة، عن النبي صلى الله عليه وسلم أيضا من غير هذا الوجه (@)PageV03P557 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٦ - (@)(@@) حدثنا محمد بن المثنى قال: حدثنا ابن أبي عدي، عن سعيد، عن قتادة، عن الحسن، عن سمرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «على اليد ما أخذت حتى تؤدي» (@)(@@) قال قتادة: ثم نسي الحسن، فقال: فهو أمينك لا ضمان عليه، يعني: العارية: هذا حديث حسن وقد ذهب بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم إلى هذا، وقالوا: يضمن صاحب العارية، وهو 
ms430	 قول الشافعي، وأحمد، وقال بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: ليس على صاحب العارية ضمان إلا أن يخالف، وهو قول الثوري، وأهل الكوفة، وبه يقول إسحاق (@)PageV03P558 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاحتكار (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٧ - (@)(@@) حدثنا إسحاق بن منصور قال: أخبرنا يزيد بن هارون قال: أخبرنا محمد بن إسحاق، عن محمد بن إبراهيم، عن سعيد بن المسيب، عن معمر بن عبد الله بن نضلة قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «لا يحتكر إلا خاطئ» (@)(@@) فقلت لسعيد: يا أبا محمد إنك تحتكر، قال ومعمر قد كان يحتكر: وإنما روي عن سعيد بن المسيب أنه كان يحتكر الزيت والخبط ونحو هذا: وفي الباب عن عمر، وعلي، وأبي أمامة، وابن عمر وحديث معمر حديث حسن صحيح والعمل على هذا عند أهل العلم كرهوا احتكار الطعام، ورخص بعضهم في الاحتكار في غير الطعام وقال ابن المبارك: لا بأس بالاحتكار في القطن، والسختيان ونحو ذلك (@)PageV03P559 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في بيع المحفلات (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٨ - (@)(@@) حدثنا هناد قال: حدثنا أبو الأحوص، عن سماك، عن عكرمة، عن ابن عباس، أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا تستقبلوا السوق، ولا تحفلوا، ولا ينفق بعضكم لبعض» : (@)(@@) وفي الباب عن ابن مسعود، وأبي هريرة وحديث ابن عباس حديث حسن صحيح والعمل على هذا عند أهل العلم كرهوا بيع المحفلة وهي المصراة لا يحلبها صاحبها أياما، أو نحو ذلك، ليجتمع اللبن في ضرعها فيغتر بها المشتري، وهذا ضرب من الخديعة والغرر (@)PageV03P560 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في اليمين الفاجرة يقتطع بها مال المسلم (@)(@) (@)(@@)(@@)(@@) ||| ١٢٦٩ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، عن شقيق بن سلمة، عن عبد الله بن مسعود قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من حلف على يمين وهو فيها فاجر ليقتطع بها مال امرئ مسلم لقي الله وهو عليه غضبان» ، (@)(@@) فقال الأشعث بن قيس: في والله، لقد كان ذلك كان بيني وبين رجل من اليهود أرض، فجحدني، فقدمته إلى النبي صلى الله عليه 
ms431	 وسلم، فقال لي رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ألك بينة؟» ، (@)(@@) قلت: لا، فقال لليهودي: (@)(@@) @MATN@ «احلف» ، (@)(@@) فقلت: يا رسول الله، إذا يحلف فيذهب بمالي، فأنزل الله تعالى: @QB@ {إن الذين يشترون بعهد الله وأيمانهم ثمنا قليلا} @QE@ [آل عمران: ٧٧] إلى آخر الآية: وفي الباب عن وائل بن حجر، وأبي موسى، وأبي أمامة بن ثعلبة الأنصاري، وعمران بن حصين وحديث ابن مسعود حديث حسن صحيح (@)PageV03P561 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء إذا اختلف البيعان (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٠ - (@)(@@) حدثنا قتيبة قال: حدثنا سفيان، عن ابن عجلان، عن عون بن عبد الله، عن ابن مسعود قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا اختلف البيعان فالقول قول البائع والمبتاع بالخيار» : (@)(@@) هذا حديث مرسل، عون بن عبد الله لم يدرك ابن مسعود وقد روي عن القاسم بن عبد الرحمن، عن ابن مسعود، عن النبي صلى الله عليه وسلم هذا الحديث أيضا، وهو مرسل أيضا: قال إسحاق بن منصور: قلت لأحمد: إذا اختلف البيعان ولم تكن بينة، قال: القول ما قال رب السلعة، أو يترادان قال إسحاق كما قال وكل من كان القول قوله فعليه اليمين: هكذا روي عن بعض أهل العلم من التابعين منهم شريح، وغيره ونحو هذا (@)PageV03P562 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في بيع فضل الماء (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧١ - (@)(@@) حدثنا قتيبة قال: حدثنا داود بن عبد الرحمن العطار، عن عمرو بن دينار، عن أبي المنهال، عن إياس بن عبد المزني قال: (@)(@@) @MATN@ «نهى النبي صلى الله عليه وسلم عن بيع الماء» (@)(@@) وفي الباب عن جابر، وبهيسة، عن أبيها، وأبي هريرة، وعائشة، وأنس، وعبد الله بن عمرو: حديث إياس حديث حسن صحيح والعمل على هذا عند أكثر أهل العلم أنهم كرهوا بيع الماء، وهو قول ابن المبارك، والشافعي، وأحمد، وإسحاق، وقد رخص بعض أهل العلم في بيع الماء منهم: الحسن البصري (@)PageV03P563 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٢ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن أبي الزناد، عن الأعرج، عن أبي هريرة، أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا يمنع فضل الماء ليمنع به الكلأ» : (@)(@@) هذا حديث حسن صحيح وأبو المنهال 
ms432	 اسمه عبد الرحمن بن مطعم كوفي، وهو الذي روى عنه حبيب بن أبي ثابت، وأبو المنهال سيار بن سلامة بصري صاحب أبي برزة الأسلمي (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية عسب الفحل (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٣ - (@)(@@) حدثنا أحمد بن منيع، وأبو عمار قالا: حدثنا إسماعيل ابن علية، قال: أخبرنا علي بن الحكم، عن نافع، عن ابن عمر قال: (@)(@@) @MATN@ «نهى النبي صلى الله عليه وسلم عن عسب الفحل» (@)(@@) PageV03P564 وفي الباب عن أبي هريرة، وأنس، وأبي سعيد: حديث ابن عمر حديث حسن صحيح والعمل على هذا عند بعض أهل العلم، وقد رخص بعضهم في قبول الكرامة على ذلك (@) (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٤ - (@)(@@) حدثنا عبدة بن عبد الله الخزاعي البصري قال: حدثنا يحيى بن آدم، عن إبراهيم بن حميد الرؤاسي، عن هشام بن عروة، عن محمد بن إبراهيم التيمي، عن أنس بن مالك، أن رجلا من كلاب سأل النبي صلى الله عليه وسلم عن عسب الفحل؟ (@)(@@) @MATN@ «فنهاه» ، (@)(@@) فقال: يا رسول الله، إنا نطرق الفحل فنكرم، (@)(@@) @MATN@ «فرخص له في الكرامة» : (@)(@@) هذا حديث حسن غريب، لا نعرفه إلا من حديث إبراهيم بن حميد، عن هشام بن عروة (@)PageV03P565 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ثمن الكلب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٥ - (@)(@@) حدثنا محمد بن رافع قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن يحيى بن أبي كثير، عن إبراهيم بن عبد الله بن قارظ، عن السائب بن يزيد، عن رافع بن خديج، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «كسب الحجام خبيث، ومهر البغي خبيث، وثمن الكلب خبيث» (@)(@@) وفي الباب عن عمر، وابن مسعود، وجابر، وأبي هريرة، وابن عباس، وابن عمر، وعبد الله بن جعفر: حديث رافع حديث حسن صحيح والعمل على هذا عند أكثر أهل العلم، كرهوا ثمن الكلب، وهو قول الشافعي، وأحمد، وإسحاق، وقد رخص بعض أهل العلم في ثمن كلب الصيد (@)PageV03P566 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٦ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن شهاب، ح وحدثنا سعيد بن عبد الرحمن المخزومي، وغير واحد، قالوا: حدثنا سفيان بن عيينة، عن الزهري، عن أبي بكر بن عبد الرحمن، عن أبي مسعود 
ms433	 الأنصاري قال: (@)(@@) @MATN@ «نهى رسول الله صلى الله عليه وسلم عن ثمن الكلب، ومهر البغي، وحلوان الكاهن» (@)(@@) هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كسب الحجام (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٧ - (@)(@@) حدثنا قتيبة، عن مالك بن أنس، عن ابن شهاب، عن ابن محيصة، أخي بني حارثة، عن أبيه، أنه استأذن النبي صلى الله عليه وسلم في إجارة الحجام، (@)(@@) @MATN@ «فنهاه عنها» ، (@)(@@) فلم يزل يسأله ويستأذنه، حتى قال: (@)(@@) @MATN@ «اعلفه ناضحك، وأطعمه رقيقك» (@)(@@) PageV03P567 وفي الباب عن رافع بن خديج، وأبي جحيفة، وجابر، والسائب بن يزيد. حديث محيصة حديث حسن، والعمل على هذا عند بعض أهل العلم وقال أحمد: إن سألني حجام نهيته، وآخذ بهذا الحديث (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرخصة في كسب الحجام (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٨ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا إسماعيل بن جعفر، عن حميد، قال: سئل أنس عن كسب الحجام، فقال أنس: احتجم رسول الله صلى الله عليه وسلم، وحجمه أبو طيبة فأمر له بصاعين من طعام، وكلم أهله فوضعوا عنه من خراجه، وقال: (@)(@@) @MATN@ «إن أفضل ما تداويتم به الحجامة» ، (@)(@@) أو (@)(@@) @MATN@ «إن من أمثل دوائكم الحجامة» (@)(@@) وفي الباب عن علي، وابن عباس، وابن عمر: حديث أنس حديث حسن صحيح وقد رخص بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم في كسب الحجام، وهو قول الشافعي (@)PageV03P568 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية ثمن الكلب والسنور (@)(@) (@)(@@)(@@)(@@) ||| ١٢٧٩ - (@)(@@) حدثنا علي بن حجر، وعلي بن خشرم، قالا: حدثنا عيسى بن يونس، عن الأعمش، عن أبي سفيان، عن جابر قال: (@)(@@) @MATN@ «نهى رسول الله صلى الله عليه وسلم عن ثمن الكلب والسنور» : (@)(@@) هذا حديث في إسناده اضطراب ولا يصح في ثمن السنور وقد روي هذا الحديث، عن الأعمش، عن بعض أصحابه، عن جابر، واضطربوا على الأعمش في رواية هذا الحديث وقد كره قوم من أهل العلم ثمن الهر، ورخص فيه بعضهم، وهو قول أحمد، وإسحاق وروى ابن فضيل، عن الأعمش، عن أبي حازم، عن أبي هريرة، عن النبي صلى الله عليه وسلم من غير هذا الوجه (@)PageV03P569 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٠ - (@)(@@) حدثنا يحيى بن 
ms434	 موسى قال: حدثنا عبد الرزاق قال: أخبرنا عمر بن زيد الصنعاني، عن أبي الزبير، عن جابر قال: (@)(@@) @MATN@ «نهى النبي صلى الله عليه وسلم عن أكل الهر وثمنه» : (@)(@@) هذا حديث غريب، وعمر بن زيد لا نعرف كبير أحد روى عنه غير عبد الرزاق (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨١ - (@)(@@) حدثنا أبو كريب قال: أخبرنا وكيع، عن حماد بن سلمة، عن أبي المهزم، عن أبي هريرة قال: (@)(@@) @MATN@ «نهى عن ثمن الكلب، إلا كلب الصيد» : (@)(@@) PageV03P570 هذا حديث لا يصح من هذا الوجه وأبو المهزم اسمه يزيد بن سفيان وتكلم فيه شعبة بن الحجاج وضعفه وقد روي عن جابر، عن النبي صلى الله عليه وسلم نحو هذا ولا يصح إسناده أيضا (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية بيع المغنيات (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٢ - (@)(@@) حدثنا قتيبة قال: أخبرنا بكر بن مضر، عن عبيد الله بن زحر، عن علي بن يزيد، عن القاسم، عن أبي أمامة، عن رسول الله صلى الله عليه وسلم قال: " لا تبيعوا القينات، ولا تشتروهن، ولا تعلموهن، ولا خير في تجارة فيهن، وثمنهن حرام، في مثل هذا أنزلت هذه الآية: @QB@ {ومن الناس من يشتري لهو الحديث ليضل عن سبيل الله} @QE@ [لقمان: ٦] إلى آخر الآية وفي الباب عن عمر بن الخطاب: PageV03P571 حديث أبي أمامة غريب إنما نعرفه مثل هذا من هذا الوجه، وقد تكلم بعض أهل العلم في علي بن يزيد وضعفه وهو شامي (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية أن يفرق بين الأخوين أو بين الوالدة وولدها في البيع (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٣ - (@)(@@) حدثنا عمر بن حفص الشيباني قال: أخبرنا عبد الله بن وهب، قال: أخبرني حيي بن عبد الله، عن أبي عبد الرحمن الحبلي، عن أبي أيوب قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من فرق بين الوالدة وولدها فرق الله بينه وبين أحبته يوم القيامة» : (@)(@@) هذا حديث حسن غريب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٤ - (@)(@@) حدثنا الحسن بن عرفة قال: أخبرنا عبد الرحمن بن مهدي، عن PageV03P572 حماد بن سلمة، عن الحجاج، عن الحكم، عن ميمون بن أبي شبيب، عن علي قال: وهب لي رسول الله 
ms435	 صلى الله عليه وسلم غلامين أخوين فبعت أحدهما، فقال لي رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يا علي ما فعل غلامك» ، (@)(@@) فأخبرته، فقال: (@)(@@) @MATN@ «رده رده» : (@)(@@) هذا حديث حسن غريب وقد كره بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم التفريق بين السبي في البيع، ورخص بعض أهل العلم في التفريق بين المولدات الذين ولدوا في أرض الإسلام، والقول الأول أصح وروي عن إبراهيم النخعي أنه فرق بين والدة وولدها في البيع، فقيل له في ذلك، فقال: إني قد استأذنتها بذلك فرضيت (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن يشتري العبد ويستغله ثم يجد به عيبا (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٥ - (@)(@@) حدثنا محمد بن المثنى قال: حدثنا عثمان بن عمر، وأبو عامر PageV03P573 العقدي، عن ابن أبي ذئب، عن مخلد بن خفاف، عن عروة، عن عائشة، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم قضى أن الخراج بالضمان» : (@)(@@) هذا حديث حسن صحيح، وقد روي هذا الحديث من غير هذا الوجه، والعمل على هذا عند أهل العلم (@) (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٦ - (@)(@@) حدثنا أبو سلمة يحيى بن خلف قال: أخبرنا عمر بن علي المقدمي، عن هشام بن عروة، عن أبيه، عن عائشة، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم قضى أن الخراج بالضمان» (@)(@@) هذا حديث حسن غريب من حديث هشام بن عروة: وقد روى مسلم بن خالد الزنجي هذا الحديث، عن هشام بن عروة، ورواه جرير، عن هشام أيضا وحديث جرير يقال تدليس دلس فيه جرير لم يسمعه من هشام بن عروة وتفسير الخراج بالضمان: هو الرجل يشتري العبد فيستغله ثم يجد به عيبا فيرده على البائع فالغلة للمشتري، لأن العبد لو هلك PageV03P574 هلك من مال المشتري، ونحو هذا من المسائل يكون فيه الخراج بالضمان: استغرب محمد بن إسماعيل هذا الحديث من حديث عمر بن علي، قلت: تراه تدليسا؟ قال: لا (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرخصة في أكل الثمرة للمار بها (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٧ - (@)(@@) حدثنا محمد بن عبد الملك بن أبي الشوارب قال: حدثنا يحيى بن سليم، عن عبيد الله بن عمر، عن نافع، عن 
ms436	 ابن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من دخل حائطا فليأكل، ولا يتخذ خبنة» (@)(@@) وفي الباب عن عبد الله بن عمرو، وعباد بن شرحبيل، ورافع بن عمرو، وعمير مولى آبي اللحم، وأبي هريرة: حديث ابن عمر حديث غريب لا نعرفه من هذا الوجه إلا من حديث يحيى بن سليم وقد رخص فيه PageV03P575 بعض أهل العلم لابن السبيل في أكل الثمار، وكرهه بعضهم إلا بالثمن (@) (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٨ - (@)(@@) حدثنا أبو عمار قال: حدثنا الفضل بن موسى، عن صالح بن أبي جبير، عن أبيه، عن رافع بن عمرو قال: كنت أرمي نخل الأنصار، فأخذوني، فذهبوا بي إلى النبي صلى الله عليه وسلم، فقال: (@)(@@) @MATN@ «يا رافع، لم ترمي نخلهم» ، (@)(@@) قال: قلت: يا رسول الله، الجوع، قال: (@)(@@) @MATN@ «لا ترم، وكل ما وقع أشبعك الله وأرواك» (@)(@@) هذا حديث حسن صحيح غريب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٨٩ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن عجلان، عن عمرو بن شعيب، عن أبيه، عن جده، أن النبي صلى الله عليه وسلم سئل عن الثمر المعلق؟ فقال: (@)(@@) @MATN@ «من أصاب منه من ذي حاجة غير متخذ خبنة فلا شيء عليه» : (@)(@@) هذا حديث حسن (@)PageV03P576 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النهي عن الثنيا (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٠ - (@)(@@) حدثنا زياد بن أيوب البغدادي قال: أخبرنا عباد بن العوام، قال: أخبرني سفيان بن حسين، عن يونس بن عبيد، عن عطاء، عن جابر، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم نهى عن المحاقلة، والمزابنة، والمخابرة، والثنيا، إلا أن تعلم» : (@)(@@) هذا حديث حسن صحيح غريب من هذا الوجه من حديث يونس بن عبيد، عن عطاء، عن جابر (@)PageV03P577 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية بيع الطعام حتى يستوفيه (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩١ - (@)(@@) حدثنا قتيبة قال: حدثنا حماد بن زيد، عن عمرو بن دينار، عن طاوس، عن ابن عباس، أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من ابتاع طعاما فلا يبعه حتى يستوفيه» ، (@)(@@) قال ابن عباس: (@)(@@) @MATN@ «وأحسب كل شيء مثله» (@)(@@) وفي الباب عن جابر، وابن عمر، وأبي هريرة: حديث ابن عباس حديث حسن صحيح والعمل على هذا عند أكثر أهل 
ms437	 العلم كرهوا بيع الطعام حتى يقبضه المشتري، وقد رخص بعض أهل العلم فيمن ابتاع شيئا مما لا يكال ولا يوزن مما لا يؤكل ولا يشرب، أن يبيعه قبل أن يستوفيه، وإنما التشديد عند أهل العلم في الطعام، وهو قول أحمد، وإسحاق (@)PageV03P578 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النهي عن البيع على بيع أخيه (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٢ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا يبيع بعضكم على بيع بعض، ولا يخطب بعضكم على خطبة بعض» (@)(@@) وفي الباب عن أبي هريرة، وسمرة: حديث ابن عمر حديث حسن صحيح وقد روي عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «لا يسوم الرجل على سوم أخيه» (@)(@@) ومعنى البيع في هذا الحديث عن النبي صلى الله عليه وسلم عند بعض أهل العلم: هو السوم (@)PageV03P579 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في بيع الخمر والنهي عن ذلك (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٣ - (@)(@@) حدثنا حميد بن مسعدة قال: حدثنا المعتمر بن سليمان، قال: سمعت ليثا يحدث، عن يحيى بن عباد، عن أنس، عن أبي طلحة أنه قال: يا نبي الله، إني اشتريت خمرا لأيتام في حجري، قال: (@)(@@) @MATN@ «أهرق الخمر، واكسر الدنان» (@)(@@) وفي الباب عن جابر، وعائشة، وأبي سعيد، وابن مسعود، وابن عمر، وأنس: حديث أبي طلحة، روى الثوري هذا الحديث، عن السدي، عن يحيى بن عباد، عن أنس، أن أبا طلحة كان عنده وهذا أصح من حديث الليث (@)PageV03P580 (@)(@) (@)(@@)(@@)(@@) || باب النهي أن يتخذ الخمر خلا (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٤ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا سفيان، عن السدي، عن يحيى بن عباد، عن أنس بن مالك قال: سئل النبي صلى الله عليه وسلم أيتخذ الخمر خلا؟ قال: (@)(@@) @MATN@ «لا» : (@)(@@) هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٥ - (@)(@@) حدثنا عبد الله بن منير، قال: سمعت أبا عاصم، عن شبيب بن بشر، عن أنس بن مالك قال: (@)(@@) @MATN@ " لعن رسول الله صلى الله عليه وسلم في الخمر عشرة: عاصرها، ومعتصرها، وشاربها، وحاملها، والمحمولة إليه، وساقيها، وبائعها، وآكل ثمنها، والمشتري لها، والمشتراة له " : PageV03P581 هذا 
ms438	 حديث غريب من حديث أنس وقد روي نحو هذا عن ابن عباس، وابن مسعود، وابن عمر، عن النبي صلى الله عليه وسلم (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في احتلاب المواشي بغير إذن الأرباب (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٦ - (@)(@@) حدثنا أبو سلمة يحيى بن خلف قال: حدثنا عبد الأعلى، عن سعيد، عن قتادة، عن الحسن، عن سمرة بن جندب، أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إذا أتى أحدكم على ماشية، فإن كان فيها صاحبها فليستأذنه، فإن أذن له فليحتلب وليشرب، وإن لم يكن فيها أحد فليصوت ثلاثا، فإن أجابه أحد فليستأذنه، فإن لم يجبه أحد فليحتلب وليشرب، ولا يحمل» (@)(@@) وفي الباب عن عمر، وأبي سعيد: حديث سمرة حديث حسن صحيح غريب والعمل على هذا عند بعض أهل العلم، وبه يقول أحمد، وإسحاق: PageV03P582 وقال علي بن المديني: سماع الحسن من سمرة صحيح وقد تكلم بعض أهل الحديث في رواية الحسن عن سمرة، وقالوا: إنما يحدث عن صحيفة سمرة (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في بيع جلود الميتة والأصنام (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٧ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن يزيد بن أبي حبيب، عن عطاء بن أبي رباح، عن جابر بن عبد الله، أنه سمع رسول الله صلى الله عليه وسلم عام الفتح وهو بمكة يقول: (@)(@@) @MATN@ «إن الله ورسوله حرم بيع الخمر، والميتة، والخنزير، والأصنام» ، (@)(@@) فقيل: يا رسول الله، أرأيت شحوم الميتة، فإنه يطلى بها السفن، ويدهن بها الجلود، ويستصبح بها الناس، قال: (@)(@@) @MATN@ «لا هو حرام» ، (@)(@@) ثم قال رسول الله صلى الله عليه وسلم عند ذلك: (@)(@@) @MATN@ «قاتل الله اليهود، إن الله حرم عليهم الشحوم فأجملوه، ثم باعوه، فأكلوا ثمنه» (@)(@@) PageV03P583 وفي الباب عن عمر، وابن عباس: حديث جابر حديث حسن صحيح، والعمل على هذا عند أهل العلم (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرجوع في الهبة (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٨ - (@)(@@) حدثنا أحمد بن عبدة الضبي قال: حدثنا عبد الوهاب الثقفي قال: حدثنا أيوب، عن عكرمة، عن ابن عباس، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ليس لنا مثل السوء العائد في هبته كالكلب يعود في قيئه» (@)(@@) (@)(@) (@)(@@) وفي الباب 
ms439	 عن ابن عمر عن النبي صلى الله عليه وسلم أنه قال (@)(@@) @MATN@ «لا يحل لأحد أن يعطي عطية فيرجع فيها إلا الوالد فيما يعطي ولده» (@)(@@) (@)PageV03P584 (@)(@) (@)(@@)(@@)(@@) ||| ١٢٩٩ - (@)(@@) حدثنا بذلك محمد بن بشار قال: حدثنا ابن أبي عدي، عن حسين المعلم، عن عمرو بن شعيب، أنه سمع طاوسا يحدث عن ابن عمر، وابن عباس يرفعان الحديث إلى النبي صلى الله عليه وسلم بهذا الحديث،: " حديث ابن عباس حديث حسن صحيح، والعمل على هذا الحديث عند بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم قالوا: من وهب هبة لذي رحم محرم فليس له أن يرجع فيها، ومن وهب هبة لغير ذي رحم محرم فله أن يرجع فيها، ما لم يثب منها، وهو قول الثوري وقال الشافعي: (@)(@@) @MATN@ «لا يحل لأحد أن يعطي عطية فيرجع فيها إلا الوالد فيما يعطي ولده» (@)(@@) واحتج الشافعي بحديث عبد الله بن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا يحل لأحد أن يعطي عطية فيرجع فيها إلا الوالد فيما يعطي ولده» (@)(@@) (@)PageV03P585 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في العرايا والرخصة في ذلك (@)(@) (@)(@@)(@@)(@@) ||| ١٣٠٠ - (@)(@@) حدثنا هناد قال: حدثنا عبدة، عن محمد بن إسحاق، عن نافع، عن ابن عمر، عن زيد بن ثابت، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم نهى عن المحاقلة، والمزابنة، إلا أنه قد أذن لأهل العرايا أن يبيعوها بمثل خرصها» (@)(@@) وفي الباب عن أبي هريرة، وجابر: حديث زيد بن ثابت هكذا روى محمد بن إسحاق هذا الحديث، وروى أيوب، وعبيد الله بن عمر، ومالك بن أنس، عن نافع، عن ابن عمر، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم نهى عن المحاقلة، والمزابنة» (@)(@@) وبهذا الإسناد، عن ابن عمر، عن زيد بن ثابت، عن النبي صلى الله عليه وسلم أنه (@)(@@) @MATN@ «رخص في العرايا» (@)(@@) وهذا أصح من حديث محمد بن إسحاق (@)PageV03P586 (@)(@) (@)(@@)(@@)(@@) ||| ١٣٠١ - (@)(@@) حدثنا أبو كريب قال: حدثنا زيد بن حباب، عن مالك بن أنس، عن داود بن حصين، عن أبي سفيان، مولى ابن أبي أحمد، عن أبي هريرة، (@)(@@) @MATN@ «أن رسول الله صلى 
ms440	 الله عليه وسلم رخص في بيع العرايا فيما دون خمسة أوسق أو كذا» (@)(@@) حدثنا قتيبة، عن مالك، عن داود بن حصين نحوه وروي هذا الحديث، عن مالك، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم أرخص في بيع العرايا في خمسة أوسق، أو فيما دون خمسة أوسق» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ١٣٠٢ - (@)(@@) حدثنا قتيبة قال: حدثنا حماد بن زيد، عن أيوب، عن نافع، عن ابن عمر، عن زيد بن ثابت، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم أرخص في بيع العرايا بخرصها» : (@)(@@) هذا حديث حسن صحيح، وحديث أبي هريرة حديث حسن صحيح والعمل عليه عند بعض أهل العلم منهم: الشافعي، وأحمد، وإسحاق، PageV03P587 وقالوا: إن العرايا مستثناة من جملة نهي النبي صلى الله عليه وسلم إذ نهى عن المحاقلة، والمزابنة، واحتجوا بحديث زيد بن ثابت، وحديث أبي هريرة، وقالوا: له أن يشتري ما دون خمسة أوسق ومعنى هذا عند بعض أهل العلم: أن النبي صلى الله عليه وسلم أراد التوسعة عليهم في هذا لأنهم شكوا إليه، وقالوا: لا نجد ما نشتري من الثمر إلا بالتمر، فرخص لهم فيما دون خمسة أوسق أن يشتروها فيأكلوها رطبا (@) (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ١٣٠٣ - (@)(@@) حدثنا الحسن بن علي الحلواني الخلال قال: حدثنا أبو أسامة، عن الوليد بن كثير قال: حدثنا بشير بن يسار، مولى بني حارثة، أن رافع بن خديج، وسهل بن أبي حثمة، حدثاه (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم نهى عن بيع المزابنة الثمر بالتمر، إلا لأصحاب العرايا، فإنه قد أذن لهم، وعن بيع العنب بالزبيب، وعن كل ثمر بخرصه» : (@)(@@) هذا حديث حسن صحيح غريب من هذا الوجه (@)PageV03P588 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية النجش في البيوع (@)(@) (@)(@@)(@@)(@@) ||| ١٣٠٤ - (@)(@@) حدثنا قتيبة، وأحمد بن منيع، قالا: حدثنا سفيان، عن الزهري، عن سعيد بن المسيب، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: وقال قتيبة: يبلغ به النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا تناجشوا» (@)(@@) وفي الباب عن ابن عمر، وأنس: حديث أبي هريرة حديث حسن صحيح والعمل على هذا عند 