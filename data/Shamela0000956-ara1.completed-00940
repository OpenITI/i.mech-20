ms921	 - عبد الله بن معاذ، قال ابن معين: كان ثقة، عبد الرزاق كان يكذبه، وقال هشام بن يوسف: هو صدوق.(@)(@@)(@@)(@@) $ 683 - عبد الله بن منير أبو عبد الرحمن المروى (4) ، سمع وهب PageV05P212(@)(@@) ابن جرير ويزيد بن هارون.(@)(@@)(@@)(@@) ||| باب ن(@)(@@)(@@)(@@) $ 684 - عبد الله بن نهيك، سمع عليا رضي الله عنه (1) في قوله (1) " كمثل الشيطان إذ قال للانسان اكفر " قاله محمد بن مقاتل (2) أخبرنا النضر عن شعبة عن أبي إسحاق: سمع عبد الله.(@)(@@)(@@)(@@) $ 685 - عبد الله بن نافع بن العمياء عن ربيعة بن الحارث، روى عنه عمران بن أبي أنس، لم يصح حديثه.(@)(@@)(@@)(@@) $ 686 - عبد الله بن نافع مولى بني هاشم عن أبيه، (3) سمع عمر رضى الله عنه قوله (3) ، قاله آدم حدثنا شعبة عن الحكم.(@)(@@)(@@)(@@) $ 687 - عبد الله بن نافع الصانع أبو محمد مولى بني مخزوم المديني عن مالك بن أنس، يعرف حفظه وينكر وكتابه أصح.(@)(@@)(@@)(@@) $ 688 - عبد الله بن نافع من ولد الزبير بن العوام القرشى PageV05P213(@)(@@) المديني، سمع مالك بن أنس، كنيته أبو بكر، أحاديثه معروفة، قال هارون بن محمد: مات سنة عشرين ومائتين.(@)(@@)(@@)(@@) $ 689 - عبد الله بن نافع مولى ابن عمر القرشي المديني عن أبيه، منكر الحديث.(@)(@@)(@@)(@@) $ 690 - عبد الله بن نجى الحضرمي عن أبيه عن (2) على رضي الله عنه، قاله شعبة عن علي بن مدرك عن أبي زرعة، فيه نظر.(@)(@@)(@@)(@@) $ 691 - عبد الله بن ناشر الكناني عن سعيد بن سفيان، روى عنه يحيى بن أبي عمرو السيباني.(@)(@@)(@@)(@@) $ 694 - عبد الله بن نيار بن مكرم الأسلمي، سمع أباه وعن عروة، روى عنه أبو الزناد وفضيل بن أبي عبد الله وعبد الرحمن بن حرملة، وروى الفضل بن معقل بن سنان عن عبد الله بن نيار الأسلمي: عن عمرو بن شاس (3) .(@)(@@)(@@)(@@) $ 693 - عبد الله بن نسيب، روى عنه معتمر. PageV05P214(@)(@@)(@@)(@@) $ 694 - عبد الله بن نسيب السلمي (1) ، سمع أبا السليل وعن مسلم ابن عبد الله، سمع منه معتمر وعبد الواحد بن واصل.(@)(@@)(@@)(@@) $ 695 - عبد الله بن نصر، (2) روى عنه حاتم بن اسمعيل منقطع (2) .(@)(@@)(@@)(@@) $ 696 - عبد الله 
ms922	 بن نجيد (3) بن عمران بن حصين الخزاعي عن(@)(@@) نجيد عن عمران: أنه أعطى شاعرا، قاله علي بن سلمة سمع يوسف بن عبد الله بن نجيد سمع أباه، حديثه في البصريين.(@)(@@)(@@)(@@) $ 697 - عبد الله بن نعيم، سمع الضحاك بن عبد الرحمن، سمع منه ابن جريج، وروى الوليد بن مسلم حدثنا يحيى بن عبد العزيز عن عبد الله ابن نعيم القرشي: سمع الضحاك بن عبد الرحمن (4) .(@)(@@)(@@)(@@) $ 698 - عبد الله بن نعمان، (@)(@@) </span>سمع عكرمة قوله، روى عنه سلم ابن قتيبة، علي بن نصر قال: هو جدي، قال سهل بن حماد: حدثنا PageV05P215(@)(@@) عبد الله بن النعمان أبو محمد، وروى عنه عمر بن يونس اليمامي (1) ، هو السحيمي (2) .(@)(@@)(@@)(@@) $ 699 - عبد الله بن نعمان، سمع قيس بن طلق، روى عنه ملازم (3) .(@)(@@)(@@)(@@) $ 700 - عبد الله بن نمير أبو هشام الكوفى الهمداني، سمع عبيد الله العمري وهشام بن عروة (4) ، قال أحمد بن أبي رجاء: مات سنة تسع وتسعين ومائة، صلى عليه محمد بن بشر.(@)(@@)(@@)(@@) $ 701 - عبد الله بن نصيب السلمي عن رجل من طي عن ابن(@)(@@) مسعود رضى الله عنه قوله، قاله إسحاق عن جرير عن ليث عن عون بن عبد الله عنه. (@)(@@)(@@)(@@) ||| باب و(@)(@@)(@@)(@@) $ 702 - عبد الله بن الوليد بن عبد الله بن معقل المزني (@)(@@) وجده إياس بن عبد من قبل أمه عن موسى بن عبد الله بن يزيد (5) ، روى عنه PageV05P216(@)(@@) اسمعيل بن زكريا الكوفي (1) .(@)(@@)(@@)(@@) $ 703 - عبد الله بن الوليد (@)(@@) بن عثمان بن عفان </span>عن أسماء بنت أبي بكر رضي الله عنهما، قاله موسى بن يعقوب (2) عن عمه يزيد سمع منه (2) ، وسمع منه محمد بن إسحاق.(@)(@@)(@@)(@@) $ 704 - عبد الله بن الوليد (3) عن عبد الله بن عبد الرحمن بن حجيرة وأبي (4) منصور (5) ، روى عنه سعيد بن أبي أيوب، وعن عبد الملك ابن أبي بكر بن عبد العزيز والحارث الخولاني وعن سعيد بن المسيب.(@)(@@)(@@)(@@) $ 705 - عبد الله بن الوليد (6) : أن عبادة بن الصامت، روى عنه حكم بن أبي نعيم.(@)(@@)(@@)(@@) $ 706 - عبد الله / بن الوليد الجعفي، رأى سويد بن غفلة، سمع 
ms923	 منه زهير (7) .(@)(@@)(@@)(@@) $ 707 - عبد الله بن الوليد العدني أبو محمد وكان يقول: PageV05P217(@)(@@) أنا مكي، ولكن يقال له عدني، سمع سفيان.(@)(@@)(@@)(@@) $ 708 - عبد الله بن وهب بن منبه عن ابيه، روى عنه ابراهيم ابن عمر بن كيسان وداود بن قيس الصنعاني.(@)(@@)(@@)(@@) $ 709 - عبد الله بن وهب بن زمعة الأسدي القرشى، سمع ام سلمة رضى الله عنها، قاله موسى بن يعقوب (1) حدثنا هاشم بن هاشم (2) ، وقال يعقوب بن عبد الله الأسدي وابنه (3) يزيد، وسمع منه الزهري.(@)(@@)(@@)(@@) $ 710 - عبد الله بن وهب بن مسلم مولى ابن زياد المصري أبو محمد، سمع حميد بن هانئ وحيوة وابن جريج والثوري، سمع منه اسمعيل بن أبي أويس (4) ، قال إسحاق: هو القرشي مولى بنى فهر، قال احمد ابن صالح: مات سنة سبع وتسعين ومائة.(@)(@@)(@@)(@@) $ 711 - عبد الله بن واقد أبو رجاء الهروي، سمع محمد بن مالك (5) ، PageV05P218(@)(@@) سمع منه المقرئ (1) وإسمعيل بن أبان.(@)(@@)(@@)(@@) $ 712 - عبد الله بن واقد بن عبد الله بن عمر بن الخطاب القرشي العدوي، سمع ابن عمر، روى عنه فضيل بن غزوان، وروى الزبيدي عن الزهري: عن عبد الله بن واقد عن أبي بكر بن سليمان عن النبي صلى الله عليه وسلم: لا تعلموا قريشا، وهذا لا يصح، وقال ابن أخي الزهري عن عمه: حدثني واقد بن عبد الله، وروى شعبة عن سعد بن إبراهيم: عن عبد الله بن واقد بن عبد الله بن عمر، وقال الوليد بن كثير عن محمد بن جعفر الزبيدي: عن عبد الله بن واقد سمع عبد الله بن عبد الله ابن عمر عن ابيه، اسمعيل حدثنا مالك عن عبد الله بن أبي بكر: عن عبد الله ابن واقد عن ابن عمر رضى الله عنهما: نهى النبي صلى الله عليه وسلم عن الأضاحي بعد ثلاث، قال مالك: رأيت عبد الله بن واقد.(@)(@@)(@@)(@@) $ 713 - عبد الله بن واقد أبو قتادة الحراني (2) ، تركوه، منكر الحديث، يقال مولى بني حمان، مات سنة سبع ومائتين.(@)(@@)(@@)(@@) $ 714 - عبد الله بن واصل عن عون (3) ، روى عنه مسعر، 
ms924	 مرسل. PageV05P219(@)(@@)(@@)(@@) $ 715 - عبد الله بن وردان وكان أول من حج من أهل مصر، سمع عائشة ومعاوية رضى الله عنهما.(@)(@@) عبد الله (1) بن أحمد وإبراهيم وعامر ابن سعد أبو حفص وحدثنا ابن وهب عن جبلة بن عمران عن عبد الله ابن وردان: قال معاوية: إن من الناس من لا يرد عليه أمره وإن عائشة رضي الله عنها منهم.(@)(@@)(@@)(@@) $ 716 - عبد الله بن وهبان، سمع ابن عباس رضى الله عنهما قوله، روى عنه عبد العزيز بن رفيع.(@)(@@)(@@)(@@) $ 717 - عبد الله بن وديعة بن خدام (2) الأنصاري أخو يزيد بن وديعة المديني، سمع سلمان (2) .(@)(@@)(@@)(@@) $ 718 - عبد الله بن ورد (4) عن عامر بن عبد الله بن الزبير عن أبيه (5) (@)(@@)(@@)(@@) ||| باب ه(@)(@@)(@@)(@@) $ 719 - عبد الله بن هارون بن ابى عيسى الشامي، سكن البصرة PageV05P220(@)(@@) سمع أباه عن ابن إسحاق، سمع منه على (1) ، وأدركته أنا حيا سنة إحدى عشرة ومائتين.(@)(@@)(@@)(@@) $ 720 - عبد الله بن هانئ أبو الزعراء الكوفى (2) ، سمع ابن مسعود رضى الله عنه، سمع منه سلمة بن كهيل، يقال عن أبي نعيم: أنه الكندي، روى عن ابن مسعود رضى الله عنه في الشفاعة: ثم يقوم نبيكم رابعهم، والمعروف عن النبي صلى الله عليه وسلم: أنا أول شافع، ولا يتابع في حديثه.(@)(@@)(@@)(@@) $ 721 - عبد الله بن هني (3) ، سمع أباه، حجازي، روى عنه أبو إسحاق، وهو مولى عمر بن الخطاب العدوي القرشي.(@)(@@)(@@)(@@) $ 722 - عبد الله بن هارون، سمع عبد الله بن عمرو (4) ، قاله الثوري عن محمد بن سعيد.(@)(@@)(@@)(@@) $ 723 - عبد الله بن هرم وهرم أبو العجفاء السلمي (5) عن ابيه، PageV05P221(@)(@@) روى عنه ابنه الهيثم.(@)(@@)(@@)(@@) $ 724 - عبد الله بن هرمز اليماني عن (1) محمد وسعيد ابني عبيد (1) عن أبي حاتم المزني، روى عنه حاتم بن اسمعيل وابن عجلان، قال ابن معين حدثنا حاتم: عن عبد الله بن هرمز الفدكي.(@)(@@)(@@)(@@) $ 725 - عبد الله بن هداج من بني عدي بن حنيفة، روى عنه أبو عمار (2) المدني.(@)(@@)(@@)(@@) $ 726 - عبد الله بن هبيرة السبائى (3 ا) المصري، سمع أبا تميم الجيشاني، روى عنه بكر بن عمرو 
ms925	 ويحيى بن سعيد الأنصاري (4) .(@)(@@)(@@)(@@) $ 727 - عبد الله بن أبي الهذيل أبو المغيرة المقبرى (5) ، سمع ابن PageV05P222(@)(@@) مسعود رضى الله عنه وعن أبي بن كعب (1) رضي الله عنه، سمع منه مسلم أبو فروة الكوفي المسندى قال ح يحيى بن آدم حدثنا الأشجعي عن سفيان ابن سعيد عن ابى سنان ضرار ح عبد الله بن أبي الهذيل: سمعت عمر بن(@)(@@) الخطاب خطيبا بالروحاء: لا تشدوا الرحال إلا إلى البيت العتيق، وقال النبي صلى الله عليه وسلم: إلا إلى ثلاثة، وحديث النبي صلى الله عليه وسلم أولى.(@)(@@)(@@)(@@) $ 728 - عبد الله بن هلال عن رجل عن سعيد بن جبير عن ابن عباس رضي الله عنهما عن النبي صلى الله عليه وسلم: ما زال جبريل يوصيني بالجار، قال أحمد بن منيع حدثنا عباد بن عباد (2) : عن عبد الله.(@)(@@)(@@)(@@) $ 729 - عبد الله بن أبي هياج، أراه أخا جرير الأسدي ومنصور (3) .(@)(@@)(@@)(@@) $ 730 - عبد الله بن أبي هند عن أبي عبيدة (4) ، روى عنه أبو مالك PageV05P223(@)(@@) الأشجعي، لا يصح حديثه.(@)(@@)(@@)(@@) $ 731 - عبد الله الهمداني عن ابى موسى الهمداني (1) ، قاله جعفر ابن برقان عن ثابت بن الحجاج، لا يصح حديثه.(@)(@@)(@@)(@@) ||| باب لا(@)(@@)(@@)(@@) $ 732 - عبد الله بن لاحق المكي، سمع سعد بن عبادة الزرقي (2)(@)(@@) عن أبيه، سمع منه عبد الله بن المبارك (3) .(@)(@@)(@@)(@@) ||| باب ي(@)(@@)(@@)(@@) $ 733 - عبد الله بن يزيد بن هرمز، قال يحيى بن سليمان حدثنا ابن وهب حدثني مالك: كان عبد الله بن يزيد بن هرمز ترك اللحم إذا قدمت غنم الصدقة وإبلها لأنهم لا يضعونها / مواضعها فسأل محمد بن عجلان ابن هرمز فأفتاه فلم يعجبه فلم يزل ابن هرمز يخبره حتى فهم فقام ابن عجلان فقبل رأسه، وقال يحيى بن سعيد الأنصاري: دعى فقهاء PageV05P224(@)(@@) أهل المدينة منهم أبو هرمز (1) ، قال الفروي: كنيته أبو بكر، مولى بني ليث، مات سنة ثمان وأربعين.(@)(@@)(@@)(@@) $ 734 - عبد الله بن يزيد رضيع عائشة رضى الله عنها، سمع عائشة، سمع منه أبو قلابة.(@)(@@)(@@)(@@) $ 735 - عبد الله بن يزيد بن أسد (2) القسري (3) عن أبيه، روى عنه ابنه 
ms926	 خالد البجلي.(@)(@@)(@@)(@@) $ 736 - عبد الله بن يزيد مولى الأسود (4) بن سفيان، سمع أبا سلمة(@)(@@) وأبا عياش، وهو الأعور، روى عنه مالك ويحيى بن أبي كثير، مديني.(@)(@@) قال ابن أبي أويس: مولى الأسود بن عبد الأسد، المخزومي المديني.(@)(@@)(@@)(@@) $ 737 - عبد الله بن يزيد الصهباني وصهبان من النخع ولا يقال PageV05P225(@)(@@) الأشجعي وقال قتيبة: هو النخعي، سمع يزيد، بن احمر وإبراهيم (1) ، روى عنه ابنه زكريا والثوري وشريك.(@)(@@)(@@)(@@) $ 738 - عبد الله بن يزيد (2) ، نسبه عبد الرزاق عن سفيان الباهلي، سمع ضبة بن محصن (3) والأحنف بن قيس، روى عنه مغيرة بن النعمان وحميد بن هلال.(@)(@@)(@@)(@@) $ 739 - عبد الله بن يزيد أبو عبد الرحمن (4) الحبلي، يعد في المصريين (4) ، عن عبد الله بن عمرو رضي الله عنه، سمع منه شرحبيل بن شريك والإفريقي وعقبة بن مسلم، (5) وهو المعافري، عن قبيصة بن ذؤيب، روى عنه بكر بن سوادة وأبو فراس مولى السهميين (5) ، ويروي عن أبي ذر رضى الله عنه هو الحبلي.(@)(@@)(@@)(@@) $ 740 - عبد الله بن يزيد المعافرى عن قبيصة بن ذؤيب، روى PageV05P226(@)(@@) عنه بكير بن سوادة وأبو فراس مولى السهميين، وروى عن أبي ذر.(@)(@@)(@@)(@@) $ 741 - عبد الله بن يزيد (@)(@@) بن فنطس (1) الهذلى مدينى، </span>سمع السائب ابن يزيد وسعيد بن المسيب ورأى أنسا وعمر بن عبد العزيز، روى عنه الثوري وحاتم بن اسمعيل، عبد الرحمن بن شيبة قال لا أعلم إلا أني سمعت أبا بكر بن أبي أويس يقول: حسين بن عبد الله بن عبيد الله بن عباس كان يتهم بالزندقة وعبد الله بن يزيد الهذلي (2) .(@)(@@)(@@)(@@) $ 742 - عبد الله بن يزيد أبو هلال السعدي، سمع سعيد بن المسيب، روى عنه سهيل بن أبي صالح، نسبه سليمان بن بلال، ويقال البكري.(@)(@@)(@@)(@@) $ 743 - عبد الله بن يزيد، سمع مكحولا (3) قال الهيثم بن خارجة لعبد الرحمن بن يزيد بن تميم: أخ عبد الله بن يزيد.(@)(@@)(@@)(@@) $ 744 - عبد الله بن يزيد بن ضبة الثقفى البصري عن عمته PageV05P227(@)(@@) سارة، سمع منه ابنه عبد العظيم وموسى بن مسعود(@)(@@)(@@)(@@) $ 745 - عبد الله بن يزيد (@)(@@) أبو عبد 
ms927	 الرحمن المقرئ مولى آل عمر بن الخطاب </span>قرشي أصله من ناحية البصرة سكن مكة، سمع حيوة ابن شريح وسعيد بن أبي أيوب وشعبة والثوري، مات سنة ثلاث عشرة ومائتين.(@)(@@)(@@)(@@) $ 746 - عبد الله بن يزيد الحميري عن سويد بن غفلة وأبي رملة، روى عنه زكريا بن يحيى (2) .(@)(@@)(@@)(@@) $ 747 - عبد الله بن يزيد مولى المنبعث عن رجل عن سرق، روى عنه جويرية (3) ، قال اسمعيل عن أخيه عن سليمان بن بلال: عن عبد الملك بن عيسى عن عبد الله بن يزيد مولى المنبعث عن أبيه عن أبي هريرة رضي الله عنه في صلة الرحم، لم يرفعه، وقال بشر عن ابن المبارك: عن عبد الملك عن زيد (4) مولى المنبعث عن أبي هريرة رضي الله عنه عن النبي صلى الله عليه وسلم، وقال إبراهيم عن عباد (5) بن اسحاق عن عبد الله PageV05P228(@)(@@) ابن يزيد مولى المنبعث: عن أبيه يزيد عن زيد بن خالد عن النبي صلى الله عليه وسلم في اللقطة.(@)(@@)(@@)(@@) $ 748 - عبد الله بن يزيد (@)(@@) </span>عن حبان، سمع ابن عمر رضى الله عنها، روى عنه موسى بن اسمعيل عن عبد القاهر (1) ، منقطع.(@)(@@)(@@)(@@) $ 749 - عبد الله بن يزيد بن ربيعة الدمشقي ثنا أبو إدريس الخولاني عن أبي الدرداء رضي الله عنه كان النبي صلى الله عليه وسلم إذا ذكر داود قال: كان أعبد البشر، حدثني ابن سلام ثنا ابن فضيل عن محمد بن سعد، أحمد بن إشكاب (2) حدثنا ابن فضيل عن محمد بن سعد: عن [عبد الله بن يزيد بن] (3) ربيعة الدمشقي حدثنا أبو إدريس - مثله.(@)(@@)(@@)(@@) $ 750 - عبد الله بن يزيد الأزدي (4) ، سمع سالم بن عبد الله، نسبه أبو عوانة عن أبي بشر، مرسل.(@)(@@)(@@)(@@) $ 751 - عبد الله بن يزيد عن ربيعة بن يزيد وعطية بن قيس، روى عنه عبد الله بن عقيل (5) . PageV05P229(@)(@@)(@@)(@@) $ 752 - عبد الله بن يزيد بن عبد الله بن قسيط الليثي المدينى عن عن أبيه عن أبي بكر بن عبد الرحمن (1) ، مرسل، سمع منه ابن أبي الفديك، اخو القاسم.(@)(@@)(@@)(@@) $ 753 - عبد الله بن ابى 
ms928	 يريد (2) المازني، سمع الحسن وثابتا، وروى عبد الصمد (3) ، قال أبو نعيم: حدثنا عبد الله رأى ابن سيرين يخلل لحيته، قال زيد بن خباب: كنيته أبو عبد الرحمن.(@)(@@)(@@)(@@) $ 754 - عبد الله بن يحنس / مولى معاوية قلت لأبي هريرة رضى الله عنه، روى عنه داود بن أبي عاصم.(@)(@@)(@@)(@@) $ 755 - عبد الله بن يعمر الكلاعي عن أبي بكر بن أبي قيس (4) ، روى عنه حميد بن هانئ (5) ، فيه نظر.(@)(@@)(@@)(@@) $ 756 - عبد الله بن يحيى من ولد كعب بن مالك السلمي الأنصاري، قال عبد الله بن صالح حدثني الليث عن رجل من ولد كعب ابن مالك يقال [له] (6) عبد الله بن يحيى: عن أبيه عن جده أن جدته خيرة امرأة كعب بن مالك أتت النبي صلى الله عليه وسلم بحلى لها فقالت: PageV05P230(@)(@@) ان تصدقت بهذا، قال النبي صلى الله عليه وسلم: إنه لا يجوز للمرأة في(@)(@@) مالها أمر (1) إلا بإذن زوجها، هل استأذنت [كعبا؟ قالت:] لا (2) ، فبعث النبي صلى الله عليه وسلم إلى كعب فقال: أذنت لخيرة [أن تتصدق] (3) بحليها (4) هذا، فقبله النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 757 - عبد الله بن يحيى بن أبي كثير اليمامي، سمع أباه، سمع منه مسدد (5) .(@)(@@)(@@)(@@) $ 758 - عبد الله بن يحيى بن زيد بن النجار (6) أخو موسى اليمامي عن جهضم (7) ، سمع منه اخوه موسى. PageV05P231(@)(@@)(@@)(@@) $ 759 - عبد الله بن يحيى أبو يعقوب الثقفي ويقال له التوأم(@)(@@) ولد وأخوه (1) في بطن واحد، قاله قتيبة عن ابن أبي مليكة، ويقال أيضا عبادة بن يحيى بن سلمان.(@)(@@)(@@)(@@) $ 760 - عبد الله بن يحيى المعافري (2) عن نافع بن يزيد، سمع منه دحيم.(@)(@@)(@@)(@@) $ 761 - عبد الله بن يحيى بن عطاء مولى عبيد الله بن عباس بن عبد المطلب الهاشمي، سمع الزهري، روى عنه معن بن عيسى.(@)(@@)(@@)(@@) $ 762 - عبد الله بن يونس عن سعيد المقبرى، روى عنه يزيد ابن الهاد (3) .(@)(@@)(@@)(@@) $ 763 - عبد الله بن يونس الثقفي عن سيار أبي الحكم (4) ، روى عنه يزيد بن هارون. PageV05P232(@)(@@)(@@)(@@) $ 764 - عبد الله بن يوسف التنيسي، سمع مالكا ويحيى بن حمزة والليث (1) ، أصله 
ms929	 دمشقي، أبو محمد.(@)(@@)(@@)(@@) $ 765 - عبد الله بن يامين (2) عن أبي هريرة رضى الله عنه، روى(@)(@@) عنه سعيد بن السائب (3) .(@)(@@)(@@)(@@) $ 766 - عبد الله بن يسار مولى ميمونة أخو سليمان بن يسار المديني وعبد الملك وعطاء (4) .(@)(@@)(@@)(@@) $ 767 - (@)(@@) عبد الله بن يسار أبو يسار وهو عبد الله بن ابى نجيج المكي، سمع طاوسا وعطاء ومجاهدا وأباه، سمع منه الثوري (5) نسبه ابن عيينة، قال يحيى القطان: لم يسمع ابن ابى بجيح من مجاهد التفسير كله يدور على القاسم بن أبي بزة، قال علي: مات سنة ثنتين وثلاثين ومائة، هو مولى أبي الأخنس الثقفي، قال أحمد بن سليمان سمعت ابن عيينة: مات بن أبي نجيح سنة إحدى وثلاثين.(@)(@@)(@@)(@@) $ 768 - عبد الله بن يسار الأعرج مولى ابن عمر القرشي مديني، سمع سالما، روى عنه سليمان بن بلال وعمر بن محمد. PageV05P233(@)(@@)(@@)(@@) $ 769 - عبد الله بن يسار أبو همام عن أبي عبد الرحمن الفهري وعمرو بن حريث، ورى عنه يعلى بن عطاء.(@)(@@)(@@)(@@) $ 770 - عبد الله بن يسار هو ابن أبي ليلى الأنصاري عن على رضى الله عنه، قاله مسدد عن محمد بن سليمان عن عبد الرحمن بن الأصبهاني عن مختار بن عبد الله بن أبي ليلى: عن ابيه عن على رضى الله عنه، ولا يصح.(@)(@@)(@@)(@@) $ 771 - عبد الله بن يسار الجهني الكوفي، سمع سليمان بن صرد(@)(@@) رضي الله عنه (1) يقول خالد بن عرفطة: أما سمعت النبي صلى الله عليه وسلم يقول: من قتله بطنه لم يعذب في قبره؟ فقال سليمان: نعم سمعته، قاله عمرو ابن محمد حدثنا العلاء حدثنا عبد الله بن عمرو عن زيد بن أبي أنيسة عن أبي صخرة المحاربي: عن عبد الله، ورى أيضا عن قتيلة (2) .(@)(@@)(@@)(@@) $ 772 - عبد الله بن يعلى النهدي، سمع عليا رضى الله عنه، قاله مالك بن اسمعيل عن عيسى بن عبد الرحمن: أن فاطمة رضى الله عنها أتت النبي صلى الله عليه وسلم تسأله خادما.(@)(@@)(@@)(@@) $ 773 - عبد الله بن يامين: لما مر بجنازة ابن عباس رضى الله عنهما PageV05P234(@)(@@) دخل طير فلم 
ms930	 ير، قاله أبو نعيم حدثنا بسام (1) ، حسن بن صباح (2) حدثنا شعيب ابن حرب حدثنا شعيب بن السائب حدثنا عبد الله بن يامين: عن أبي هريرة رضي الله عنهما عن النبي صلى الله عليه وسلم: خذ حقك في عفاف، قال أبو النضر حدثنا بسام حدثني عبد الله بن يامين: عن أبيه: جاء طير (3) - نحوه.(@)(@@)(@@)(@@) $ 774 - عبد الله بن يعلى بن مرة الثقفي عن أبيه عن النبي صلى الله عليه وسلم، روى [عنه] (4) ابنه عمر، يعد في الكوفيين.(@)(@@)(@@)(@@) $ 775 - عبد الله بن يرفأ المديني عن ابن فروخ، سمع منه (5) أبو ضمرة محمد بن أبي الفديك والحميدي ويعقوب بن محمد (6) ، قال يعقوب PageV05P235(@)(@@) ح عبد الله (@)(@@) بن يرفأ مولى بني ليث: سمع عبد الله بن فروخ.(@)(@@)(@@)(@@) ||| ومن أفناء الناس(@)(@@)(@@)(@@) $ 776 - عبد الله إمام مسجد عمرو بن مرة عن عمرو بن مرة، روى عنه شعبة، منقطع.(@)(@@)(@@)(@@) $ 777 - عبد الله والد منير عن سعد بن أبي ذباب، لم يصح.(@)(@@)(@@)(@@) $ 778 - عبد الله الوراس سمع عليا وطلحة والزبير، روى عنه عاصم الأحول، منقطع.(@)(@@)(@@)(@@) $ 779 - عبد الله المديني، قال ابن المبارك: عن اسمعيل بن أبي خالد عن عبد الله المديني: كنت في مسجد فخطب مروان في بيعة يزيد، وقال عبد الرحمن بن يونس حدثنا ابن عيينة: عن اسمعيل بن أبي خالد عن زياد مولى بني مخزوم عن مروان بهذا، عبيد الله قال حدثنا ضرار بن صرد حدثنا عائذ بن حبيب: عن ابن أبي خالد عن عبد الله المديني سمعت(@)(@@) عبد الرحمن بن ابى بكر رضى الله عنهما: كان فلان يجلس إلى النبي صلى الله عليه وسلم فإذا تكلم النبي صلى الله عليه وسلم قال برأسه: لا.(@)(@@)(@@)(@@) $ 780 - عبد الله (2) عن جابر بن سمرة رضي الله عنه، روى عنه PageV05P236(@)(@@) فرات، وقال هارون حدثنا عمر عن (1) فرات القزاز (1) : عن عبيد الله بن أبي غفار عن جابر بن سمرة رضى الله عنهما: صلى بنا النبي صلى الله عليه وسلم، وقال مسعر: عن عبيد الله بن القبطية (2) عن جابر رضي الله عنه 
ms931	 عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 781 - عبد الله الهوزني </span>(3) ، سمع بلالا رضى الله عنه، روى عنه أبو سلام، منظور (4) .(@)(@@)(@@)(@@) $ 782 - عبد الله الهلالي، سمع ابن مسعود، روى عنه أبو يحيى PageV05P237(@)(@@) خوات (1) ، عن أمه (2) .(@)(@@)(@@)(@@) $ 783 - / عبد الله القرشي، سمع ابا هريرة رضى الله عنه، روى عنه عبيد الله (3) .(@)(@@)(@@)(@@) $ 784 - عبد الله عن أبيه عن النبي صلى الله عليه وسلم، روى عنه ابنه مليح (4) ، مرسل في أهل المدينة (5) .(@)(@@)(@@)(@@) $ 785 - عبد الله التيمي (6) قال: بعث عمر بن الخطاب رضي الله عنه عمار بن ياسر رضى الله عنهما اميرا علينا ونحن بالمدائن، قاله عبيد الله بن عمرو عن زيد بن أبي أنيسة عن عدي بن ثابت.(@)(@@)(@@)(@@) $ 786 - عبد الله مولى مجاهد، قال وكيع عن سفيان: عن PageV05P238(@)(@@)(@@)(@@) $ عبد الله (@)(@@) مولى مجاهد عن مجاهد: أنه كان لا يرى بأسا بيضة (1) ببيضتين يدا بيد.(@)(@@)(@@)(@@) $ 787 - عبد الله سمع أبا هريرة رضي الله عنه عن النبي صلى الله عليه وسلم قال: من أحيل على ملئ فليحتل ولا تباع ثمرة حتى تعلم ما خراجها ولا توطأ حبالى السبي حتى يضعن، قاله عبد الله بن صالح وابن مهدي عن معاوية بن صالح: عن أبي لقمان عبد الله (2) .(@)(@@)(@@)(@@) $ 788 - عبد الله مؤذن الضحاك عن الضحاك قوله، قاله وكيع عن الوليد (3) بن ثعلبة.(@)(@@)(@@)(@@) $ 789 - عبد الله صاحب الكرى كان يكري الثياب، يعد في البصريين، قال موسى (4) حدثنا عبد الله: سمع أبا ربيعة صاحب السابري عن أنس بن مالك قوله.(@)(@@)(@@)(@@) || باب عبد الرحمن(@)(@@)(@@)(@@) $ 790 - عبد الرحمن بن عوف بن عبد عوف أبو محمد الزهري PageV05P239(@)(@@) القرشى رضى الله عنه، شهد بدرا مع النبي صلى الله عليه وسلم، قال الحسن عن ضمرة: مات لست بقين من خلافة عثمان، وقال محمد بن مقاتل أخبرنا(@)(@@) أحمد بن محمد أخبرنا يعقوب بن إبراهيم: لتسع من سني عثمان، وقال يعقوب بن إبراهيم: وهو ابن خمس وسبعين.(@)(@@)(@@)(@@) $ 791 - عبد الرحمن (1) بن أبي عميرة المزني (2) ، يعد في الشيامين، قال أبو مسهر حدثنا سعيد بن عبد العزيز عن ربيعة بن 
ms932	 يزيد: عن ابن أبي عميرة قال النبي صلى الله عليه وسلم لمعاوية: اللهم اجعله هاديا مهديا واهده واهد به، وقال عبد الله عن مروان عن سعيد عن ربيعة: سمع عبد الرحمن سمع النبي صلى الله عليه وسلم - مثله.(@)(@@)(@@)(@@) $ 792 - عبد الرحمن بن أزهر بن عبد عوف أبو جبير الزهري القرشي، له صحبة، إبراهيم بن موسى أخبرنا هشام عن معمر عن الزهري: كان عبد الرحمن بن أزهر يحدث أن خالد بن وليد رضى الله عنه كان على خيل (3) النبي صلى الله عليه وسلم يوم حنين فرأيت النبي صلى الله عليه وسلم PageV05P240(@)(@@) فسعيت بين يديه وأنا محتلم.(@)(@@)(@@)(@@) $ 793 - عبد الرحمن بن أبي سبرة (1) ، حديثه في الكوفيين، قال محمد بن العلاء حدثنا يونس بن بكير حدثنا اسمعيل بن زربى (2) عن الشعبي حدثني عبد الرحمن بن أبي سبرة (1) : كنت مع أبي حين أتى النبي صلى الله عليه وسلم فبايعه وبايعته - فذكر الوتر.(@)(@@)(@@)(@@) $ 794 - عبد الرحمن بن عبيد الله (3) القرشى التيمى ابن اخى طلحة ابن عبيد الله، قال إبراهيم بن المنذر عن محمد بن طلحة: قتل مع ابن الزبير في يوم واحد (4) ، قال ابن أبي أويس حدثني إبراهيم بن سعد عن خالة أمه هند بنت عبد الرحمن: عن أبيها عبد الرحمن بن عثمان بن عبيد الله (5) PageV05P241(@)(@@) التيمي وكان قد أدرك النبي صلى الله عليه وسلم، الحميدي قال ابن أبي حازم قال حدثني أسامة بن بكير بن عبد الله بن الأشج عن يحيى بن عبد الرحمن ابن حاطب: عن عبد الرحمن بن عثمان التيمي قال: نهى النبي صلى الله عليه وسلم عن لقطة الحاج، ورأى عثمان يوتر بركعة، روى عنه السائب ابن يزيد ومحمد بن المنكدر.(@)(@@)(@@)(@@) $ 795 - عبد الرحمن بن ابى بكر الصديق رضى الله عنهما وهو عبد الرحمن بن عبد الله بن أبي قحافة القرشي التيمي، مات قبل عائشة(@)(@@) رضى الله عنها وبعد سعد بن أبي وقاص رضي الله عنه، قاله أحمد بن عيسى عن بشر بن بكر عن الأوزاعي عن يحيى عن سالم مولى 
ms933	 دوس، وقال سعيد بن أبي مريم أخبرنا نافع بن عمر عن ابن أبي مليكة قال قال عبد الرحمن بن أبي بكر: ما يعرف ذلك الغار غيري (1) يعني الغار الذي (1) كان فيه النبي صلى الله عليه وسلم وأبو بكر، مات سنة ثمان وخمسين، أبو محمد.(@)(@@)(@@)(@@) $ 769 - عبد الرحمن بن سمرة بن حبيب (2) القرشى رضى الله عنه، له صحبة، قال أبو بكر حدثنا عبد الأعلى عن الجريري عن حيان بن عمير عن عبد الرحمن بن سمرة رضي الله عنه: قرأ رسول الله صلى الله عليه وسلم PageV05P242(@)(@@) سورتين في الكسوف وصلى ركعتين، قال ناصح بن العلاء عن عمار ابن أبي عمار: قلت لعبد الرحمن بن سمرة القرشى: يا باسعيد!(@)(@@)(@@)(@@) $ 797 - عبد الرحمن بن يعمر الديلي، قال محمد بن يوسف ثنا سفيان عن بكير بن عطاء قال سمعت عبد الرحمن بن يعمر رضى الله عنه قال: شهدت النبي صلى الله عليه وسلم بعرفة [وأتاه] ناس من أهل نجد [فأمروا رجلا] فنادى يارسول الله صلى الله عليه وسلم كيف الحج؟ [قال: الحج] يوم عرفة من جاء ليلة جمع قبل صلاة الفجر تم حجه، أيام منى ثلاثة (1) فمن تعجل في يومين فلا إثم عليه ومن تأخر فلا إثم عليه. PageV05P243(@)(@@)(@@)(@@) $ 798 - عبد الرحمن بن معاذ رضى الله عنه، له صحبة، قال مسدد حدثنا خالد بن عبد الله قال ثنا حميد الأعرج عن محمد بن إبراهيم عن عبد الرحمن بن معاذ رضى الله عنه قال النبي صلى الله عليه وسلم: ارموا بمثل حصاة الخذف (1) .(@)(@@)(@@)(@@) $ 799 - عبد الرحمن بن أبي قراد (2) ، يعد في أهل الحجاز، قاله على ابن الجعد، حدثنا عدي بن الفضل عن أبي جعفر (3) عن عمارة بن خزيمة: عن ابن الفاكه قال: رأيت النبي صلى الله عليه وسلم توضأ مرة مرة، وقال يحيى بن سعيد ثنا أبو جعفر الخطمي قال ثنى عمارة بن خزيمة والحارث بن فضيل: عن عبد الرحمن بن أبي قراد قال: خرجت مع النبي صلى الله عليه وسلم حاجا - فذكر وضوءه، وقال محمد بن 
ms934	 بشار ثنا محمد ابن جعفر / سمع عمارة بن عثمان بن حنيف قال حدثنى القيسي (4) : انه كان PageV05P244(@)(@@) مع النبي صلى الله عليه وسلم في سفر فغسل يده مرة مرة ووجهه وذراعيه ورجليه مرة.(@)(@@)(@@)(@@) $ 800 - عبد الرحمن بن أبزى مولى خزاعة الكوفي، له صحبة.(@)(@@) قال عمرو بن محمد حدثنا يعقوب حدثنا أبي عن ابن إسحاق حدثني سلمة بن كهيل الحضرمي: عن عبد الله بن عبد الرحمن بن أبزى من قدماء موالي أهل مكة.(@)(@@)(@@)(@@) $ 801 - عبد الرحمن بن شبل (1) الأنصاري، له صحبة.(@)(@@)(@@)(@@) $ 802 - عبد الرحمن بن حبر أبو عثمان الأنصاري المديني، له صحبة، قال ابراهيم بن منذر ح محمد بن طلحة عن عبد المجيد بن ابى عيسى ابن محمد بن أبي عيسى عن أبيه عن جده قال: كان علقمة من به وتصدق بقرضه فقال النبي صلى الله عليه وسلم: قد قبل صدقتك.(@)(@@)(@@)(@@) $ 803 - عبد الرحمن بن سهل، له صحبة. PageV05P245(@)(@@)(@@)(@@) $ 804 - عبد الرحمن بن أشيم (1) ، له صحبة، قال عبد الرحمن بن شيبة حدثني يونس بن يحيى عن سلمة بن وردان قال: رأيت أنس بن مالك ومالك بن أوس بن الحدثان النصري (2) وسلمة بن الأكوع وعبد الرحمن ابن الأشيم من بني أنمار كلهم صاحب النبي صلى الله عليه وسلم لا يغيرون الشيب.(@)(@@)(@@)(@@) $ 805 - عبد الرحمن بن فرط وكان من أصحاب الصفة صفة مسجد النبي صلى الله عليه وسلم، قاله عمرو بن خالد عن مسكين بن صالح (2) عن عروة بن رويم.(@)(@@)(@@)(@@) $ 806 - عبد الرحمن بن خباب السلمي، له صحبة، قال محمود حدثنا أبو داود قال ثنا السكن بن المغيرة أبو محمد مولاى لآل عثمان قال سمعت الوليد بن أبي هشام عن فرقد أبي طلحة عن عبد الرحمن بن خباب السلمي قال: شهدت النبي صلى الله عليه وسلم وحض على جيش العسرة فقام عثمان فقال: يا رسول الله! مائة بعير بأحلاسها وأقتابها، ثم حض على الجيش فقام عثمان فقال: [يا رسول الله! علي] (3) مائتا بعير بأحلاسها وأقتابها في سبيل الله، ثم حض على الجيش فقام عثمان وقال: 
ms935	 [على] (3) PageV05P246(@)(@@) ثلاث مائة بعير بأحلاسها وأقتابها في سبيل الله، ثم رأيت النبي صلى الله عليه وسلم حين نزل من المنبر يقول بيده: ما على عثمان وقال: ما على عثمان ما عمل بعده (1) - مرتين.(@)(@@)(@@)(@@) $ 807 - عبد الرحمن بن صفوان - أو - صفوان بن عبد الرحمن عن النبي صلى الله عليه وسلم، قاله يزيد بن أبي زياد عن مجاهد، ولا يصح.(@)(@@)(@@)(@@) $ 808 - عبد الرحمن بن غنم الأشعري، وقال عمرو بن على: مات سنة ثمان وسبعين، قال محمد بن عبيد حدثنا محمد بن سلمة عن محمد ابن إسحاق عن عبد الرحمن بن الحارث قال حدثت (2) عن عبد الرحمن بن ضباب الأشعري: عن عبد الرحمن بن غنم الأشعري - وكانت له صحبة - قال: (3) كنا جلوسا في المسجد مع النبي صلى الله عليه وسلم (3) ومعنا ناس من أهل المدينة وهم أهل النفاق إذ [بدت] (4) سحابة فأبدها (5) رسول الله صلى الله عليه وسلم عينيه، قال ابن عبيد: يعني ينظر إليها، ثم جعل كأنه PageV05P247(@)(@@) يتبع بصره شيئا حتى نظر إلى بعض حجره ثم قام فلبث ما شاء الله ثم رفع فقلنا: يا رسول الله! لقد رأيناك اليوم تصنع شيئا ما رأيناك تصنعه، قال: بينما أنا جالس معكم إذ نظرت إلى ملك تبدا (1) لي من هذا السحاب فأتبعته بصري أنظر أين يعمد حتى وقع في بعض حجري، فقمت إليه فسلم علي ثم قال: إني لم أزل أستأذن ربي في لقائك حتى كان هذا أوان أذن لي في ذلك وإني أبشرك أنه ليس أحد أكرم على ربه منك، قلت: من أنت؟ ثم لم يرجع إذا سلم ورجعنا ... (2) .(@)(@@)(@@)(@@) $ 809 - عبد الرحمن بن المرقع، قال معلى حدثنا أبو عاصم العباداني.(@)(@@) قال حدثني محبر بن هارون (3) عن أبي يزيد المدني عن عبد الرحمن بن المرقع قال: لما فتح النبي صلى الله عليه وسلم خيبر (4) في ألف وثمان مائة.(@)(@@) فقسمها على ثمانية عشر سهما (4) .(@)(@@)(@@)(@@) $ 810 - عبد الرحمن بن خنبش (5) التميمي، قال عبد الله بن ابى PageV05P248(@)(@@) الأسود حدثنا جعفر (1) قال ثنا أبو التياح قال: سأل رجل 
ms936	 (2) عبد الرحمن ابن خنبش وكان شيخا من بني تميم أحسبه قال: كان جاهليا (3) فقال: كيف(@)(@@) صنع رسول الله حين كادت الشياطين؟ قال: تحدرت الشياطين عليه من الجبال والأودية ومعهم شيطان معه شعلة من نار يريد أن يحرق بها وجه النبي صلى الله عليه وسلم فلما رآهم النبي فزع منهم فجاءه جبريل فقال: يا محمد! قل، فقال: ما أقول؟ قال: قل أعوذ بكلمات الله - فذكر الحديث بطوله.(@)(@@)(@@)(@@) $ 811 - عبد الرحمن بن أبي عقيل، قال أحمد بن يونس حدثنا PageV05P249(@)(@@) زهير حدثنا أبو خالد الاسدي قال ح عون بن أبي جحيفة السوائي عن عبد الرحمن بن علقمة الثقفي (@)(@@) عن عبد الرحمن بن أبي عقيل قال: انطلقت في وفد إلى النبي صلى الله عليه وسلم فأنخنا بالباب (1) وما في الناس رجل أبغض (1) إلينا من رجل نلج عليه فما خرجنا (2) حتى ما أحد (2) أحب إلينا (3) من رجل دخل(@)(@@) عليه (3) ، فقال: أعطاني دعوة عند ربي (4) شفاعة لامتي يوم القيامة فقال قائل منا: يارسول [الله!] (5) ألا سألت ربك ملكا كملك سليمان؟ فضحك وقال - فذكر الحديث، وقال القاسم بن أبي شيبة حدثنا ليث بن هشام عن الحكم بن هشام الثقفى قال ح هشام بن الحكم الثقفي عن عبد الرحمن بن أبي عقيل قال: قال النبي صلى الله عليه وسلم: من سره أن يمد في عمره ويرفغ (6) له رزقه فليصل رحمه.(@)(@@)(@@)(@@) $ 812 - عبد الرحمن بن علقمة الثقفي (7) ، له صحبة، قال يوسف بن PageV05P250(@)(@@) يعقوب حدثنا أبو بكر قال ح يحيى بن هانئ المرادي عن أبي حذيفة عن عبد الملك بن محمد بن بشير 1 عن عبد الرحمن بن علقمة قال: قدم وفد ثقيف على النبي صلى الله عليه وسلم ومعهم هدية فقال: صدقة أو هدية؟ فإن يراد بها وجه الرسول أو الحاجة وإلا صدقة يراد (2) بها وجه الله (2) ، قالوا: لا، بل هدية (3) فقال رسول الله - فذكره.(@)(@@) وقال خليفة ثنا محمد بن جعفر: عن شعبة عن جامع سمعت عبد الرحمن بن أبي علقمة يقول: سمعت(@)(@@) عبد الله بن مسعود رضي الله 
ms937	 عنه قال: قفلنا مع النبي صلى الله عليه وسلم من الحديبية فنام عن الصلاة وأنزل عليه " إنا فتحنا لك فتحا مبينا "، وقال صدقة أخبرنا يحيى: عن شعبة عن جامع عن عبد الرحمن بن أبي علقمة سمعت عبد الله، وتابعه معاذ قال: ثنا شعبة عن جامع عن عبد الرحمن ابن أبي علقمة عن عبد الله، وقال آدم حدثنا المسعودي: حدثنا جامع عن عبد الرحمن بن علقمة عن ابن مسعود، وقال أبو جعفر حدثنا يحيى PageV05P251(@)(@@) ابن آدم قال حدثني الحسن بن ثابت (1) عن عبد الله بن الوليد المزني: عن جامع بن شداد عن عبد الرحمن بن أبي علقمة (2) الثقفي عن عبد الله بن مسعود رضي الله عنه قال: كان معنا ليلة نام النبي صلى الله عليه وسلم عن الفجر حاديان.(@)(@@)(@@)(@@) $ 813 - عبد الرحمن بن سنة (3) عن النبي صلى الله عليه وسلم، وحديثه ليس بالقائم (4) .(@)(@@)(@@)(@@) $ 814 - عبد الرحمن بن عائش (5) الحميري.(@)(@@)(@@)(@@) ||| باب الألف (من وافق أول اسم أبيه ألف)(@)(@@)(@@)(@@) $ 815 - عبد الرحمن بن الأسود بن يزيد أبو حفص النخعي الكوفي.(@)(@@) قال أبو نعيم حدثنا العلاء بن زهير الازدي حدثنى عبد الرحمن ابن الأسود: كنت ادخل على عائشة رضي الله عنها بغير اذن وأنا غلام PageV05P252(@)(@@) حتى إذا احتلمت استأذنت فعرفت صوتي فقالت (1) : يا عدو نفسه! فعلتها؟ قلت: نعم يا أمتاه! قالت: ادخل.(@)(@@)(@@)(@@) $ 816 - / عبد الرحمن بن الأسود بن عبد يغوث القرشي الحجازي عن أبي بن كعب رضي الله عنه عن النبي صلى الله عليه وسلم قال: من الشعر حكمة (2) ، قاله أبو عاصم عن ابن جريج عن زياد عن الزهري: عن أبي بكر بن عبد الرحمن عن مروان بن الحكم (3) ، قال إبراهيم بن سعد: عبد الله بن الأسود (4) وهو وهم، وقال عبد الرزاق عن معمر عن الزهري: عن عروة عن مروان عن عبد الرحمن، قال عبد الرزاق وأخبرني رباح أنه وجد في كتاب معمر عن أبي بكر: قال أبو اليمان أخبرنا شعيب عن الزهري: أخبرني أبو بكر أن مروان أخبره أن عبد الرحمن أخبره عن 
ms938	 النبي صلى الله عليه وسلم، تابعه يونس، وسمع PageV05P253(@)(@@) عمرو بن العاص وعائشة رضى الله عنهما، روى عنه سليمان بن يسار، قال أبو سلمة: كنا نجالس عبد الرحمن بن الأسود.(@)(@@)(@@)(@@) $ 817 - عبد الرحمن بن الأسود العنسي - يعد في الشاميين - ان عمر رضى الله عنه، روى عنه أبو بكر بن أبي مريم.(@)(@@)(@@)(@@) $ 818 - عبد الرحمن بن آدم صاحب السقاية مولى أم برثن البصري عن أبي هريرة رضى الله عنه، روى عنه قتادة وسليمان التيمي، قال عمرو بن علي: عبد الرحمن هو عبد الرحمن بن برثن، قال يحيى بن موسى حدثنا أبو داود عن أبي خلدة (1) عن ابى العالية: دخلنا على عبد الرحمن ابن برثن.(@)(@@)(@@)(@@) $ 819 - عبد الرحمن بن أفلح (2) مولى أبي أيوب، روى عنه أبو النضر، مرسل، المديني.(@)(@@)(@@)(@@) $ 820 - عبد الرحمن بن أبان بن عثمان بن عفان القرشي الأموي عن أبيه، سمع منه عمر بن سليمان (3) من ولد عمر بن الخطاب، المديني.(@)(@@)(@@)(@@) $ 821 - عبد الرحمن بن الأزرق العدني (4) فعله، روى عنه الحكم PageV05P254(@)(@@) ابن أبان.(@)(@@)(@@)(@@) $ 822 - عبد الرحمن بن أذينة العبدي عن أبيه، مرسل، روى عنه أبو إسحاق الهمداني، قال ابن عيينة عن عبد الملك بن أعين: لقيت عبد الرحمن بواسط، قال علي (1) : عبد الرحمن قاضي البصرة زمن شريح ولما مات عبد الرحمن طلب أبو قلابة للقضاء فهرب إلى الشام.(@)(@@)(@@)(@@) $ 823 - عبد الرحمن بن أذنان (2) ، سمع عليا قوله، قاله الثوري عن أبي إسحاق، وقال إسرائيل: هو ابن دانيل (3) ، وقال عمرو بن مرزوق عن شعبة: عبد الرحمن، وقال عبيد الله بن عثمان عن أبيه عن شعبة: عن عبد الرحمن بن دانيل.(@)(@@)(@@)(@@) $ 824 - عبد الرحمن بن أيمن (4) المخزومي المكي، رأى أبا سعيد رضي الله عنه، روى إبراهيم بن نافع عن عبد الله بن عبد الرحمن، وروى عنه عمرو بن دينار، وسمع ابن عمر رضي الله عنهما، وأثنى عليه ابن عيينة (5) خيرا، وقال هارون بن معروف حدثنا حجاج قال ابن جريج PageV05P255(@)(@@) أخبرني أبو الزبير أنه سمع عبد الرحمن بن أيمن مولى عزة (1) : سأل ابن عمر رضى 
ms939	 الله عنهما في الطلاق، محمد بن عبد الله بن عبيد بن عقيل حدثني جدي عبيد حدثنا إبراهيم بن نافع: حدثنا عبد الله بن عبد الرحمن بن أيمن الرومي.(@)(@@)(@@)(@@) $ 825 - عبد الرحمن بن أوس عن ابى هريرة رضى الله عنه، سمع منه بكر بن سوادة.(@)(@@)(@@)(@@) $ 826 - عبد الرحمن بن أصبغ الحضرمي عن أبي الضحاك، روى عنه حسين الجعفي.(@)(@@)(@@)(@@) $ 827 - عبد الرحمن بن ابراهيم يقال له دحيم (2) الدمشقي، سمع عمر بن عبد الواحد والوليد (3) .(@)(@@)(@@)(@@) $ 828 - عبد الرحمن بن إبراهيم أبو بشر المنقري الكوفي، سمع عمر بن موسى (4) عن القاسم عن أبي إمامة رضي الله عنه قال: تدلى أبو بكرة قصرا ثم تدلى سيده، قال: يا رسول الله! رد على عبدى، قال: PageV05P256(@)(@@) إن العبد إذا تدلى قبل سيده لم يرد وإذا تدلى السيد قبل عبده رد.(@)(@@)(@@)(@@) $ 829 - عبد الرحمن بن إبراهيم القاص مديني، سمع العلاء بن عبد الرحمن وعن ابن المنكدر (1) ، قاله ابن معين، سمع منه عفان (2) ، يحيى بن محمد بن سكن حدثنا حبان (3) : حدثنا عبد الرحمن بن إبراهيم ثقة منزله عند منزل الشقاقي (4) يعني بالبصرة سمع العلاء.(@)(@@)(@@)(@@) $ 830 - عبد الرحمن بن أمية الثقفي عن أخيه يعلى.(@)(@@)(@@)(@@) $ 831 - عبد الرحمن بن أبي أمية (5) المكي، روى عنه الحارث ابن يعقوب عن رجل من تجيب عن عمرو بن العاص رضى الله عنه، وقال حيوة عن سعيد بن موسى (6) [عن] (7) طلق بن جعبان عن عبد الرحمن PageV05P257(@)(@@) ابن ابى امية: سمع عمر رضى الله عنه في غزو البحر.(@)(@@)(@@)(@@) $ 832 - عبد الرحمن بن أبلحان أبو سلمان المؤذن (1) .(@)(@@)(@@)(@@) $ 833 - عبد الرحمن بن امرئ القيس (2) عن محمد المطيري (3) عن النبي صلى الله عليه وسلم، مرسل، قاله ابن عجلان عن ابى المصفى (4) .(@)(@@)(@@)(@@) $ 834 - عبد الرحمن بن إسحاق بن الحارث القرشي المدني عن الزهري وأبيه وأبي عبيدة بن محمد، سمع منه ابن علية وبشر بن المفضل ويزيد بن زريع، وقال عبد الله بن رجاء: أهل المغرب يقولون: عباد ابن إسحاق، ربما وهم، قال خالد عن عبد الرحمن عن الزهري: عن سالم PageV05P258(@)(@@) عن 
ms940	 أبيه عن النبي صلى الله عليه وسلم في الأذان ورواه معمر ويونس وابن إسحاق عن الزهري: عن سعيد (1) عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 835 - عبد الرحمن بن إسحاق بن الحارث أبو شيبة الواسطي عن أبيه والنعمان بن سعد (2) ، نسبه القاسم بن مالك، وكناه أحمد وقال(@)(@@) أحمد: هو منكر الحديث، فيه نظر، وقال البخاري (3) : عن عبد الرحمن ابن إسحاق الواسطي.(@)(@@)(@@)(@@) $ 836 - عبد الرحمن الأصم، سمع أنسا، سمع منه الثوري وأبو عوانة، قال مخلد حدثنا أبو زهير ربيع بن صبيح عن ابن سيرين: أول من جعل أصبعه في أذنيه في الأذان عبد الرحمن الأصم (4) مؤذن الحجاج، وقال ابن المثنى حدثنا معاذ حدثنا أبو عون عن محمد: أول من نزع احدى يديه ابن الاصم، قال عبيد الله عن سفيان عن عبد الرحمن العبدي، محمد ابن عبادة حدثنا أبو أحمد حدثنا سفيان عن أبي بكر الأصم سمع أنسا رضي الله عنه: كان النبي صلى الله عليه وسلم يتم التكبير.(@)(@@)(@@)(@@) $ 837 - عبد الرحمن بن أبي الحكم (5) الثقفى، قال يحيى بن صالح PageV05P259(@)(@@) حدثنى سعيد بن عبد العزيز عن اسمعيل بن عبيد الله: سمع عبد الرحمن أنه صلى خلف عثمان بن عفان الجمعة معى (1) السح الجمعة وسح الحوادثين.(@)(@@)(@@)(@@) ||| باب ب(@)(@@)(@@)(@@) $ 838 - عبد الرحمن بن أبي بكرة الثقفي هو ابن نفيع البصري أبو بحر (2) ، سمع اباه وعليا رضى الله عنه، سمع منه محمد بن سيرين وأبو بشر وعبد الملك بن عمير وعلي بن زيد، قال محمد بن عقبة حدثنا يحيى بن(@)(@@) ميسرة العقيلي ثنا ابن (3) عون: كان عبد الرحمن بن أبي بكرة أول مولود بالبصرة.(@)(@@)(@@)(@@) $ 839 - عبد الرحمن بن أبي بكر بن أبي مليكة القرشي المليكي - منكر الحديث - التيمي عن القاسم، سمع منه ابنه محمد، قال ابن منذر حدثنا معن حدثني عبد الرحمن بن أبي بكر بن عبيد الله بن عبد الله بن أبي مليكة: سمعت عمي ابن أبي مليكة هو عبد الله، ورأى طاوسا PageV05P260(@)(@@) والزهري.(@)(@@)(@@)(@@) $ 840 - عبد الله بن أبي بكر بن عبد الرحمن بن الحارث 