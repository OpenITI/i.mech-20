ms2041	 عنك ) )(@)(@@) البعوي عن عبد الرحمان بن هشام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18966 ) قال النبي :(@)(@@) | 30 ( ما اجتمع ثلاثة في حضر أو بدو ولا تقام فيهم الصلاة إلا استحوذ عليهم الشيطان ) )(@)(@@) ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18967 ) قال النبي :(@)(@@) | 30 ( ما اجتمع قوم في مجلس فتفرقوا من غير ذكر الله والصلاة على النبي إلا كان عليهم حسرة يوم القيامة ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18968 ) قال النبي :(@)(@@) | 30 ( ما أجد لك من رخصة ، ولو يعلم هاذا المتخلف عن الصلاة في الجماعة ما لهاذا الماشي إليها لأتاها ولو حبوا على يديه ورجليه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18969 ) قال النبي :(@)(@@) | 30 ( ما أحب أن لي أحدا ذهبا أموت يوم أموت وعندي منه دينار أو نصف دينار إلا أن أرصده لغريم ) )(@)(@@) ( حم ) و الدارمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18970 ) قال النبي :(@)(@@) | 30 ( ما أحب أن يرقد وهو جنب حتى يتوضأ ويحسن PageV06P310 وضوءه ، فإني أخشى أن يتوفى فلا يحضره جبريل ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 18971 ) قال النبي :(@)(@@) | 30 ( ما أحب لو أن لي هاذا الجبل ذهبا أنفقه ويتقبل مني لا أذر خلفي منه شيئا ) )(@)(@@) ( حم ) عن أبي ذر وعثمان رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 18972 ) قال النبي :(@)(@@) | 30 ( ما أحب الله من عبده ذكر شيء من النعم ما أحب أن يذكره بما هداه له من الإيمان به وملائكته وكتبه ورسله وإيمان بقدره خيره وشره ) )(@)(@@) أبو نعيم عن أسعد بن زرارة ابن منده عن أخيه سعد بن زرارة ووهمه أبو نعيم أبو علي الحسن بن أحمد بن البنا في مشيخته وابن النجار من طريق أبي الرجال عن أبيه عن جده سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18973 ) قال النبي :(@)(@@) | 30 ( ما أحد من الناس أفضل علي نعمة في أهل ومال من أبي بكر ، ولو كنت متخذا خليلا لاتخذته ، ولاكن أخوة الإسلام ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18974 ) قال النبي :(@)(@@) | 30 ( ما أحد من بني آدم 
ms2042	 إلا وقد أخطأ أو هم بخطيئة ليس يحيى بن زكريا ) )(@)(@@) ( طب ك ع ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18975 ) قال النبي :(@)(@@) | 30 ( ما أحد من الناس ينتظر هاذه الصلاة يعني العشاء غيركم ، وإنكم في صلاة ما انتظرتموها ، ولولا أن أشق على أمتي لأمرت بتأخير هاذه الصلاة إلى نصف الليل أو أقرب من نصف الليل ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18976 ) قال النبي :(@)(@@) | 30 ( ما آحد أمن علي في صحبته وذات يده من أبي بكر ، وما نفعني مال أبي بكر ، ولو كنت متخذا من أهل الأرض خليلا PageV06P311 لاتخذت أبا بكر خليلا ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 18977 ) قال النبي :(@)(@@) | 30 ( ما أحد يلقى الله يوم القيامة إلا ذا ذنب إلا يحيى بن زكريا ) )(@)(@@) ( عب ) في التفسير ( كر ) عن قتادة عن سعيد بن المسيب مرسلا ، تمام ( كر ) عن يحيى بن سعيد عن سعيد بن المسيب عن عمرو بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18978 ) قال النبي :(@)(@@) | 30 ( ما أحد أعظم عند الله من رجل مؤمن يعمر في الإسلام ) )(@)(@@) ( ن ض ) عن شداد بن الهاد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18979 ) قال النبي :(@)(@@) | 30 ( ما أحد من المسلمين يصاب ببلاء في جسده إلا أمر الله عز وجل الحفظة الذين يكتبون فقال : اكتبوا لعبدي هاذا في كل يوم وليلة ما كان يعمله في الصحة من الخير ما دام محبوسا في وثاقي ) )(@)(@@) ( حم قط ) في الأفراد ( طب حل ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18980 ) قال النبي :(@)(@@) | 30 ( ما أحد أغير من الله ، وذالك أنه حرم الفواحش ، وما أحد أحب إليه المدحة من الله ، وذالك أنه مدح نفسه ، ولا أحد أحب إليه العذر من الله ، وذالك أنه اعتذر إلى خلقه ، ولا أحد أحب إليه الحمد من الله ، وذالك أنه حمد نفسه ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18981 ) قال النبي :(@)(@@) | 30 ( ما أحسن محسن من مسلم ولا كافر إلا أثابه الله تعالى ، قيل : ما إثابة الكافر ؟ قال : إن كان قد وصل رحما ، أو تصدق 
ms2043	 بصدقة ، أو عمل حسنة أثابه الله المال والولد والصحة وأشباه ذالك ، قيل : وما إثابته في الآخرة ؟ قال : عذابا دون العذاب ، وقرأ : { أدخلوا آل فرعون أشد العذاب } ) )(@)(@@) ( ك هب بز ) و الخرائطي في مكارم الأخرق وابن شاهين عن PageV06P312 ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18982 ) قال النبي :(@)(@@) | 30 ( ما أحسن الله خلق رجل ولا خلقه فيطعمه النار ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18983 ) قال النبي :(@)(@@) | 30 ( ما أحسن هاذا يا بلال اجعله في آذانك ) )(@)(@@) ( طب ) عن بلال أنه أتى النبي يؤذنه بالصبح فوجده راقدا فقال : الصلاة خير من النوم مرتين قال : فذكره .(@)(@@)(@@)(@@) $ ( 18984 ) قال النبي :(@)(@@) | 30 ( ما أحسن هاذا ) )(@)(@@) ( د ) عن ابن عمر رضي الله عنهما قال : مطرنا ذات ليلة فأصبحت الأرض مبتلة ، فجعل الرجل يأتي بالحصا في ثوبه فيبسطه تحته فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 18985 ) قال النبي :(@)(@@) | 30 ( ما أحطتم عليه وأعلمتموه فهو لكم ، وما لكم يحط عليه فهو لله ولرسوله ) )(@)(@@) ( عد هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18986 ) قال النبي :(@)(@@) | 30 ( ما أحل الله تعالى في كتابه فهو حلال ، وما حرم فهو حرام ، وما سكت عنه فهو عفو فاقبلوا من الله عافيته ، فإن الله لم يكن لينسى شيئا ) )(@)(@@) ( بز طب ك هق ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18987 ) قال النبي :(@)(@@) | 30 ( ما أحل اسمي وحرم كنيتي ، وما حرم كنيتي وأحل اسمي ؟ ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 18988 ) قال النبي :(@)(@@) | 30 ( ما أحل الله عز وجل حلالا أحب إليه من النكاح ، ولا أحل حلالا أكره عليه من الطلاق ) )(@)(@@) ابن لال والديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18989 ) قال النبي :(@)(@@) | 30 ( ما أخاف على أمتي إلا ثلاثا . شحا مطاعا ، وهوى PageV06P313 متبعا ، وإماما ضالا ) )(@)(@@) ( أبو نعيم كر ) عن أبي الأعور السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18990 ) قال النبي :(@)(@@) | 30 ( ما أخاف على قريش إلا أنفسها ، أشحة نخرة ، وإن طال بك عمر لتنظرن إليهم يفتنون الناس ، حتى يرى الناس بينهم كالغنم بين الحوضين ، إلى هاذ مرة وإلى هاذا مرة ) )(@)(@@) ( حم 
ms2044	 ) عن أعرابي .(@)(@@)(@@)(@@) $ ( 18991 ) قال النبي :(@)(@@) | 30 ( ما أخبرتكم أنه من عند الله فهو الذي لا شك فيه ) )(@)(@@) البزار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18992 ) قال النبي :(@)(@@) | 30 ( ما أدري أنا بفتح خيبر أفرح ، أو بقدوم جعفر ) )(@)(@@) البغوي والباوردي وابن قانع ( طب ) عن عبد الله بن جعفر عن أبيه .(@)(@@)(@@)(@@) $ ( 18993 ) قال النبي :(@)(@@) | 30 ( ما أدري بأيهما أنا أشد فرحا : بفتح خيبر ، أم بقدوم جعفر ) )(@)(@@) ( عد كر ) عن علي ، ( هق كر ) عن الشعبي مرسلا ، ( ك ) عن الشعبي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18994 ) قال النبي :(@)(@@) | 30 ( ما أدري بأي الأمرين أنا أسر : بقدوم جعفر أو بفتح خيبر ) )(@)(@@) ( طب كر ) عن عون بن أبي جحيفة عن أبيه ( كر ) عن إسماعيل بن عبد الله بن جعفر عن أبيه .(@)(@@)(@@)(@@) $ ( 18995 ) قال النبي :(@)(@@) | 30 ( ما أذن الله لشيء كإذنه لعبد يترنم بالقرآن ) )(@)(@@) ( ش ) عن أبي سلمة مرسلا .(@)(@@)(@@)(@@) $ ( 18996 ) قال النبي :(@)(@@) | 30 ( ما أذن الله لشيء ما أذن لرجل حسن الترنم بالقرآن ) )(@)(@@) ( عب ) عن أبي سلمة مرسلا أبو نصر السجزي في الإبانة عن أبي سلمة عن أبيه .(@)(@@) PageV06P314(@)(@@)(@@)(@@) $ ( 18997 ) قال النبي :(@)(@@) | 30 ( ما اذن الله لشيء كإذنه للذي يتغنى بالقرآن يجهر به ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18998 ) قال النبي :(@)(@@) | 30 ( ما أذنب عبد ذنبا فندم إلا كتب الله له مغفرته قبل أن يستغفر ) )(@)(@@) أبو الشيخ عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 18999 ) قال النبي :(@)(@@) | 30 ( ما أرى الإمام إذا قرأ إلا كان كافرا ) )(@)(@@) ( طب هق ) وضعفه عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19000 ) قال النبي :(@)(@@) | 30 ( ما أراك إلا أصنعت خيانة في دينك وغشا للمسلمين ) )(@)(@@) ( هب ) عن أبي حيان عن أبيه مر النبي برجل يبيع طعاما فأوحى الله إليه أن أدخل يدك فيه قال : فذكره .(@)(@@)(@@)(@@) $ ( 19001 ) قال النبي :(@)(@@) | 30 ( ما ارتكض في النساء من جنين ينبغي له أن يقول أنا أفضل من يحيى بن زكريا ، لأنه لم يحك في صدره خطيئة ، ولم يهم بها ) )(@)(@@) ( كر ) عن علي بن أبي طلحة مرسلا .(@)(@@)(@@)(@@) $ ( 19002 ) قال النبي :(@)(@@) | 30 
ms2045	 ( ما ازداد عبد قط فقها في دينه إلا ازداد قصدا في عمله ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19003 ) قال النبي :(@)(@@) | 30 ( ما أرسل الله على عاد من الريح إلا قدر خاتمي هاذا ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19004 ) قال النبي :(@)(@@) | 30 ( ما استخلف العبد في أهله من خليفة إذا هو شد عليه بباب سفره خيرا من أربع ركعات يضعهن في بيته يقرأ في كل واحدة منهن بفاتحة الكتاب ، وقل هو الله أحد ، ثم يقول : اللهم إني أتقرب بهن إليك فاجعلهن خليفتي في أهلي ومالي ، فهن خليفته في أهله وماله وداره ودور حول داره PageV06P315 حتى يرجع إلى أهله ) )(@)(@@) ( ك ) في تاريخه والخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19005 ) قال النبي :(@)(@@) | 30 ( ما استرعى الله عبدا رعية فلم يحط من وراءهم بالنصيحة إلا حرم الله عليه الجنة ) )(@)(@@) ابن النجار عن عبد الرحمان بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19006 ) قال النبي :(@)(@@) | 30 ( ما استحل به فرج امرأة من مهر أو عدة فهو لها ، وما أكرم به أبوها أو أخوها أو وليها بعد عقد النكاح فهو له ، وأحق ما أكرم به الرجل ابنته أو أخته ) )(@)(@@) ( حم هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19007 ) قال النبي :(@)(@@) | 30 ( ما استخلف الله عز وجل خليفة حتى يمسح ناصييه بيمينه ) )(@)(@@) ابن النجار والديلمي عن سليمان بن معقل بن عبد الله بن كعب بن مالك عن أبيه عن جده عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19008 ) قال النبي :(@)(@@) | 30 ( ما استرعى الله عبدا رعية فلم يحط من وراءهم بالنصيحة إلا حرم الله عليه الجنة ) )(@)(@@) ( هب ) و ابن النجار عن عبد الرحمان بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19009 ) قال النبي :(@)(@@) | 30 ( ما استكبر من أكل مع خادمه ، وركب الحمار بالأسواق ، واعتقل الشاة فحلبها ) )(@)(@@) ابن لال عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19010 ) قال النبي :(@)(@@) | 30 ( ما استحلق قوم رجلا إلا ورثهم ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@) PageV06P316(@)(@@)(@@)(@@) $ ( 19011 ) قال النبي :(@)(@@) | 30 
ms2046	 ( ما استودع الله عبدا علما وفي لفظ : عقلا إلا وهو مستنقذه به يوما ما ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19012 ) قال النبي :(@)(@@) | 30 ( ما أسفرتم بالفجر فإنه أعظم للأجر ) )(@)(@@) ( طب ) عن محمود بن لبيد عن رجل من الأنصار .(@)(@@)(@@)(@@) $ ( 19013 ) قال النبي :(@)(@@) | 30 ( ما أصاب مسلما قط هم أو حزن فقال : اللهم إني عبدك وابن عبدك ، ابن أمتك ، ناصيتي بيدك ، ماض في حكمك ، عدل في قضاؤك ، أسألك بكل اسم هو لك سميت به نفسك ، أو أنزلته في كتابك ، أو علمته أحدا من خلقك ، أو استأثرت به في علم الغيب عندك ، أن تجعل القرآن ربيع قلبي ، ونور بصري ، وجلاء حزني ، وذهاب همي ، إلا أذهب الله تعالى همه ، وأبدله مكان حزنه فرحا ، قالوا : يا رسول الله أفلا نتعلم هاذه الكلمات ؟ قال : بلى ، ينبغي لمن سمعهن أن يتعلمهن ) )(@)(@@) ( حم ش طب ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19014 ) قال النبي :(@)(@@) | 30 ( ما أصاب الله أهل قرية بعذاب إلا عمهم ، ثم يبعثون يوم القيامة على نياتهم ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19015 ) قال النبي :(@)(@@) | 30 ( ما أصاب عبد المصيبة فما فوقها إلا بإحدى حالتين : بذنبه لم يكن الله ليغفر له إلا بتلك المصيبة ، أو بدرجة لم يكن الله ليبلغه إياها إلا بتلك المصيبة ) )(@)(@@) أبو نعيم عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19016 ) قال النبي :(@)(@@) | 30 ( ما أصاب المسلم شيء إلا كان له كفارة ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19017 ) قال النبي :(@)(@@) | 30 ( ما أصابني شيء منها إلا وهو مكتوب علي وآدم في PageV06P317 طينته ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما قال : قالت أم سلمة : يا رسول الله لا يزال يصيبك كل عام وجع من الشاة المسمومة قال : فذكره .(@)(@@)(@@)(@@) $ ( 19018 ) قال النبي :(@)(@@) | 30 ( ما أسكر الفرق منه فالجرعة منه خمر ) )(@)(@@) ( خط ) في المتفق والمفترق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19019 ) قال النبي :(@)(@@) | 30 ( ما أضحى مؤمن يلبي حتى تغرب الشمس إلا غابت بذنوبه حتى يعود كما ولدته أمه ) )(@)(@@) ( هق ) عن عامر بن 
ms2047	 ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19020 ) قال النبي :(@)(@@) | 30 ( ماأضيف شيء إلى شيء أفضل من حلم إلى علم ) )(@)(@@) ابن السني وأبو الشيخ عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19021 ) قال النبي :(@)(@@) | 30 ( ما اصطفى الله لملائكته : سبحان الله وبحمده ) )(@)(@@) عن أبي ذر رضي الله عنه قال : سألت النبي ما نقول في سجودنا ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 19022 ) قال النبي :(@)(@@) | 30 ( ما اصطفاه الله لملائكته : سبحان الله وبحمده ) )(@)(@@) ( حم م ) عن أبي ذر رضي الله عنه قال : سئل رسول الله : أي الكلام أفضل ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 19023 ) قال النبي :(@)(@@) | 30 ( ما اطلع أحد على قبر موسى إلا الرخمة فنزع الله عقلها لكي لا تدل عليه ) )(@)(@@) ( كر ) عن محمد بن إسحاق يرفعه .(@)(@@)(@@)(@@) $ ( 19024 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ولا أقلت الغبراء ذا لهجة أصدق من أبي ذر ، من سره أن ينظر إلى تواضع عيسى بن مريم فلينظر إلى أبي ذر ) )(@)(@@) ابن سعد ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P318(@)(@@)(@@)(@@) $ ( 19025 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ، ولا أقلت الغبراء من ذي لهجة أصدق من أبي ذر ، يطلب شيئا من الزهد عجز عنه الناس ) )(@)(@@) ( كر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19026 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ، ولا أقلت الغبراء من ذي لهجة أصدق من أبي ذر ، فإذا أردتم أن تنظروا إلى أشبه الناس بعيسى بن مريم : هديا وبرا ونسكا ، فعليكم به ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19027 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ولا أقلت الغبراء على ذي لهجة أصدق من أبي ذر ، من سره أن ينظر إلى زهد عيسى بن مريم فلينظر إلى أبي ذر ) )(@)(@@) ابن سعد عن مالك بن دينار مرسلا .(@)(@@)(@@)(@@) $ ( 19028 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ولا أقلت الغبراء على ذي لهجة أصدق من أبي ذر ، ثم رجل بعدي ، من سره أن ينظر إلى عيسى بن مريم زهدا وسمتا فلينظر إلى أبي ذر ) )(@)(@@) ( كر ) عن الضبع بن قيس مرسلا .(@)(@@)(@@)(@@) $ ( 19029 ) قال النبي :(@)(@@) | 30 ( ما أظلت الخضراء ولا أقلت الغبراء 
ms2048	 بعد النبيين خيرا منك يا عمر ) )(@)(@@) الشاشي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19030 ) قال النبي :(@)(@@) | 30 ( ما أعطي أهل بيت الرفق إلا نفعهم ، ولا منعوه إلا ضرهم ) )(@)(@@) البغوي وأبو نعيم ( كر ) عن عبيد الله بن معمر القرشي ، قال البغوي : ولا أعلم له غيره هو مرسل .(@)(@@)(@@)(@@) $ ( 19031 ) قال النبي :(@)(@@) | 30 ( ما أعز الله بجهل قط ، ولا أذل الله بعلم قط ) )(@)(@@) العسكري في الأمثال عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19032 ) قال النبي :(@)(@@) | 30 ( ما أعز الله بجهل قط ، ولا أذل بحلم قط ، ولا نقصت صدقة من مال قط ) )(@)(@@) ابن شاهين عن ابن مسعود رضي الله عنه .(@)(@@) PageV06P319(@)(@@)(@@)(@@) $ ( 19033 ) قال النبي :(@)(@@) | 30 ( ما أعطي أحد أربعة فمنع أربعة : ما أعطي أحد الشكر فمنع الزيادة لأن الله تعالى يقول : { لئن شكرتم لأزيدنكم } ، وما أعطي أحد الدعاء فمنع الإجابة لأن الله تعالى يقول : { ادعوني أستجب لكم } ، وما أعطي أحد الاستغفار ثم منع المغفرة لأن الله تعالى يقول : { استغفروا ربكم إنه كان غفارا } ، وما أعطي أحد التوبة فمنع التقبل لأن الله تعالى يقول : { وهو الذي يقبل التوبة عن عباده } ) )(@)(@@) ( هب ) عن عطارد بن مصعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19034 ) قال النبي :(@)(@@) | 30 ( ما أعطي عبد أفضل من حسن اليقين والعافية ، فاسألوا الله حسن اليقين والعافية ) )(@)(@@) البزار عن سهل بن سعد عن أبي بكر رضي الله عنه ، وقال : ليس لسهل عن أبي بكر حديث مرفوع غيره .(@)(@@)(@@)(@@) $ ( 19035 ) قال النبي :(@)(@@) | 30 ( ما أعطي عبد شيئا شرا من طلاقة لسانه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19036 ) قال النبي :(@)(@@) | 30 ( ما أعطيت فضيلة إلا وقد أعطيت شطرا منها حتى الشهادة فإني أعطاها بسم أكلة خيبر ، وتؤتاها بسم أفعى ليلة الغار قاله لأبي بكر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19037 ) قال النبي :(@)(@@) | 30 ( ما أعلم شرابا يجزىء عن الطعام إلا اللبن ، فإذا شربه أحدكم فليقل : اللهم بارك لنا فيه ، وزدنا منه ، ومن أكل منكم طعاما يعني من ذالك الضب فليقل : اللهم بارك لنا فيه وأطعمنا خيرا منه ) )(@)(@@) ( ط ) عن 
ms2049	 ابن عباس رضي الله عنهما .(@)(@@) PageV06P320(@)(@@)(@@)(@@) $ ( 19038 ) قال النبي :(@)(@@) | 30 ( ما أعمال العباد كلهم عند المجاهدين في سبيل الله إلا كمثل خطاف أخذ بمنقاره من ماء البحر ) )(@)(@@) أبو ابشيخ عن أنس ، الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19039 ) قال الن بي :(@)(@@) | 30 ( ما أغيرك يا أبي ، إني لأغير منك ، والله أغير مني ) )(@)(@@) ( كر ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19040 ) قال النبي :(@)(@@) | 30 ( ما اغرورقت عين بمائها إلا حرم الله سائر ذالك الجسد على النار ، ولا سالت قطرة على خدها فيرهق ذالك الوجه قترة ولا ذلة ، ولو أن باكيا بكى في أمة من الأمم رحموا ، وما من شيء إلا له مقدار وميزان إلا الدمعة يطفأ بها بحار من نار ) )(@)(@@) ( هب ) عن مسلم بن يسار مرسلا .(@)(@@)(@@)(@@) $ ( 19041 ) قال النبي :(@)(@@) | 30 ( ما اغرورقت عينا عبد من خشية الله إلا حرم الله جسده على النار ، فإن فاضت على خده لم يرهقه قتر ولا ذلة ، وما من عمل إلا وله ثواب إلا الدموع فإنها تطفىء بحورا من نار ، ولو أن عبدا بكى في أمة من الأمم لأنجا الله تلك الأمة ببكاء ذالك الرجل ) )(@)(@@) أبو الشيخ عن النضر بن حميد مرسلا .(@)(@@)(@@)(@@) $ ( 19042 ) قال النبي :(@)(@@) | 30 ( ما أغناك الله فلا تسأل الناس شيئا ، فإن اليد العليا هي المنطية ، وإن اليد السفلى هي المنطاة ، وإن مال الله مسئول ومنطي ) )(@)(@@) ابن منده ( ك هق كر ) عن عروة بن محمد بن عطية السعدي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19043 ) قال النبي :(@)(@@) | 30 ( ما أقبحه ، لو أهدي إلي كراع لقبلت ، ولو دعيت إلى ذراع لأجبت ) )(@)(@@) ( طب ) عن أم حكيم بنت وداع الخزاعية قالت : قلت : يا رسول الله يكره رد اللطف ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 19044 ) قال النبي :(@)(@@) | 30 ( ما أكثر أحد من الربا إلا كان عاقبة أمره إلى قل ) )(@)(@@) ( ك هب ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV06P321(@)(@@)(@@)(@@) $ ( 19045 ) قال النبي :(@)(@@) | 30 ( ما أكل لحمه فلا بأس ببوله ) )(@)(@@) ( ن ) وضعفه عن البراء ( قط هق ) وضعفاه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19046 ) قال النبي :(@)(@@) | 30 ( ما أكل 
ms2050	 يتيم مع قوم في صحفتهم أو قصعة فيقرب صحفتهم الشيطان ) )(@)(@@) ابن النجار عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19047 ) قال النبي :(@)(@@) | 30 ( ما التقى رجلان إلا كان أولاهما بالله الذي يبدأ بالسلام ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19048 ) قال النبي :(@)(@@) | 30 ( ما التقى صفان منذ كانت الدنيا إلى أن تقوم الساعة إلا كانت يد الرحمان بينهما ، فإذا أراد نصر عبد قال بيده هاكذا فينهزمون كطرف العين ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19049 ) قال النبي :(@)(@@) | 30 ( ما أنا انتجيته ولاكن الله انتجاه ) )(@)(@@) ( ت ) حسن غريب ( طب ) عن جابر قال : دعا رسول الله عليا يوم الطائف فانتجاه ، فقال الناس : لقد طال نجواه ابن عمه قال : فذكره .(@)(@@)(@@)(@@) $ ( 19050 ) قال النبي :(@)(@@) | 30 ( ما أنا وامرأة سفعاء الخدين إذ حنت على ولدها ، وأطاعت ربها ، وأحصنت فرجها في الجنة إلا كهاتين ، وقرن بين أصبعيه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19051 ) قال النبي :(@)(@@) | 30 ( ما أنا والدنيا ، وما أنا والرحم ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19052 ) قال النبي :(@)(@@) | 30 ( ما أنا بأحق بهاذه الوبرة من رجل من PageV06P322 المسلمين ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19053 ) قال النبي :(@)(@@) | 30 ( ما انتعل عبد قط ، ولا تخفف ولا لبس ثوبا ليغدو في طلب العلم إلا غفر له ذنوبه حيث يخطو عتبة باب بيته ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19054 ) قال النبي :(@)(@@) | 30 ( ما أنت إلا س| فينة ) )(@)(@@) ( حل ) عن سفينة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19055 ) قال النبي :(@)(@@) | 30 ( ما أنت يا طلحة إلا فياض ) )(@)(@@) ( كر ) عن محمد بن إبراهيم بن الحارث التيمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19056 ) قال النبي :(@)(@@) | 30 ( ما أنتم إذا مرج الدين ، وسفك الدم ، وظهرت الزينة ، وشرف البنيان ، واختلف الإخوان ، وحرق البيت العتيق ) )(@)(@@) ( طب ) عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19057 ) قال النبي :(@)(@@) | 30 ( ما أنتما أقوى على المشي مني ، وما أنا بأغنى عن الأجر منكما ) )(@)(@@) ( حم ) عن ابن مس