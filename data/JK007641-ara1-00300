ms281	 % % وأسير مكبل وقتيل % % 45(@)(@@) % دار سلمى ما دار فيها كثيف % % 46(@)(@@) % قط إلا وناله تلطيف % % 47(@)(@@) % قيل لي حين جئتها يا شريف % % 48(@)(@@) % ما الذي جيت تبتغي قلت ضيف % % جاء يبغي القرى فأين النزول % % 49(@)(@@) % يا لسلمى تعز قوما وتحقر % % 50(@)(@@) % وأسير الهوى يرى الحر في القر % % PageV01P1282 51(@)(@@) % جئتها والفنا من الغير مقفر % % 52(@)(@@) % فأشارت بالرحب دونك فاعقر % % ها فما عندنا لضيف رحيل % % 53(@)(@@) % حبنا العز والعلى من لدنه % % 54(@)(@@) % والكمالات المفاخرو منه % % 55(@)(@@) % إن ترمنا فما لما رمت كنه % % 56(@)(@@) % من أتانا ألقى عصا السير عنه % % قلت من لي بها وأين السبيل % % 57(@)(@@) % حثنا الشوق في مهامه لوم % % 58(@)(@@) % لديار الهوى وبهجة يوم % % 59(@)(@@) % ثم سرنا نزيل آثار نوم % % 60(@)(@@) % فحططنا إلى منازل قوم % % صرعتهم قبل المذاق الشمول % % PageV01P1283 61(@)(@@) % لفؤادي في الحب أوفر قسم % % 62(@)(@@) % والهوى قد هوى بروح وجسم % % 63(@)(@@) % ونداماي ليس منهم سوى اسم % % 64(@)(@@) % درس الوجد منهمو كل رسم % % فهو رسم والقوم فيه حلول % % 65(@)(@@) % هو قلبي عن الهوى ليس ينفك % % 66(@)(@@) % فاقطع اللوم صاح من حيثما رك % % 67(@)(@@) % إنما القوم طودهم بالهوى أندك % % 68(@)(@@) % منهمو من عفا ولم يبق للشك % % وى ولا للدموع منه مقيل % % 69(@)(@@) % منزل الغانيات إياك منه % % 70(@)(@@) % فهو للسلب في المحبة كنه % % PageV01P1284 71(@)(@@) % ولكم عاشق عهدت لديه % % 72(@)(@@) % ليس إلا الأنفاس تخبر عنه % % وهو منها مبرأ معزول % % 73(@)(@@) % ركن أهل الملام من صبوتي ارتج % % 74(@)(@@) % وأخلاي في الهوى صبرهم عج % % 75(@)(@@) % فترى منهم الطريح وقد لج % % 76(@)(@@) % ومن القوم من يشير إلى وج % % د تبقى عليه منه القليل % % 77(@)(@@) % أنا أهوى نواظرا وقواما % % 78(@)(@@) % ذاك رمحا أرى وتلك سهاما % % 79(@)(@@) % ولا هل الهوى غدوت إماما % % 80(@)(@@) % ولكل رأيت منهم مقاما % % شرحه في الكتاب مما يطول % % PageV01P1285 81(@)(@@) % اتركوا اللوم يا عواذل ويكم % % 82(@)(@@) % وامنحوني يا سادتي ما لديكم % % 83(@)(@@) % أنا أرسلت بالكتاب إليكم % % 84(@)(@@) % قلت أهل الهوى سلام عليكم % % لي فؤاد بحبكم مشغول % % 85(@)(@@) % عرف ليلى من النسائم أشتم % % 86(@)(@@) % وفؤادي بزائد 
ms282	 الحب يهتم % % 87(@)(@@) % لي ضلوع من كثرة الشوق في غم % % 88(@)(@@) % وجفون دق قرحتها من الدم % % ع حثيثا إلى لقاكم سيول % % 89(@)(@@) % ليس في الحق يا ابن ودي جحد % % 90(@)(@@) % وجدك أسم به وهل لك وحد % % PageV01P1286 91(@)(@@) % يا كراما لضدهم ضم لحد % % 92(@)(@@) % لم يزل حادث من الشوق يحدو % % ني إليكم والحادثات تحول % % 93(@)(@@) % سال دمعي دما من الماء أميع % % 94(@)(@@) % وحدثني من كل ما شاع أشيع % % 95(@)(@@) % ضعت والود بين قومي أضيع % % 96(@)(@@) % واعتذاري ذنب فهل عند من يع % % لم عذري في ترك عذري قبول % % 97(@)(@@) % إن ذاك الحمى وذاك المكانا % % 98(@)(@@) % خطفتني بروقه لمعانا % % 99(@)(@@) % يا رعاة الحمى أمانا وأمانا % % 100(@)(@@) % جئت كي أصطلي فهل لي إلى نا % % ركو هذه الغداة سبيل % % PageV01P1287 101(@)(@@) % أهل ودي أهل الهوى فائتمنهم % % 102(@)(@@) % فالو فاقدو وجدته من لدنهم % % 103(@)(@@) % ورجوت الكرام أطلب منهم % % 104(@)(@@) % فأجابت شواهد الحال عنهم % % كل حد من دونها مفلول % % 105(@)(@@) % إن هذا الضيا وهذا البريقا % % 106(@)(@@) % لسلميى فاسلك إليها الطريقا % % 107(@)(@@) % وإذا الكون أظهر التزويقا % % 108(@)(@@) % لا تروقنك الرياض الأنيقا % % ت فمن دونها ربا ودخول % % 109(@)(@@) % قف على الباب للمحبة مدمن % % 110(@)(@@) % فهواها غالي لدي القوم مثمن % % PageV01P1288 111(@)(@@) % هي سلمى لم يدرها غير مؤمن % % 112(@)(@@) % كم أناها قوم على غرة من % % ها وراموا أمرا فعز الوصول % % 113(@)(@@) % حسبوا ماءها يزيل أواما % % 114(@)(@@) % فأذيبوا واعدموا إعداما % % 115(@)(@@) % ثم لما أبدت لهم إعلاما % % 116(@)(@@) % وقفوا شاخصين حتى إذا ما % % لاح للوصل غرة وحجول % % 117(@)(@@) % عرفات الهوى بها الثج والعج % % 118(@)(@@) % لك طوبى يوما إذا فزت بالحج % % 119(@)(@@) % فاقصد الركب إن تجد شوقهم لج % % 120(@)(@@) % وبدت راية الوفا بيد الوج % % د ونادى أهل الحقائق جولوا % % PageV01P1289 121(@)(@@) % إن عهدي الوثيق في الحب ما انحل % % 122(@)(@@) % وأخو لصادقا دام والمدعي مل % % 123(@)(@@) % وعلوم الهوى تقول الهوى جل % % 124(@)(@@) % أين من كان يدعينا فهذا ال % % يوم فيه صبغ الدعاوى يحول % % 125(@)(@@) % نحن قوم مقامنا بالعلى خص % % 126(@)(@@) % وعلينا في محكم الذكر قد نص % % 127 
ms283	(@)(@@) % معشر للهدى بهم كلما اقتص % % 128(@)(@@) % حملوا حملة الفحول ولا يص % % دع يوم اللقاء إلا الفحول % % 129(@)(@@) % أهل أيد كالغيث بالبذل سحت % % 130(@)(@@) % طالما بالعداة في الحرب ضجت % % PageV01P1290 131(@)(@@) % ثم لما النوى عليهم ألحت % % 132(@)(@@) % بذلوا أنفسا سخت حين شحت % % بوصال واستصغر المبذول % % 133(@)(@@) % سادة قلعة الأنا هدموها % % 134(@)(@@) % أي حال في الحرب ما عملوها % % 135(@)(@@) % دخلوا في الوغى ليخترموها % % 136(@)(@@) % ثم غابوا من بعدما اقتحموها % % بين أمواجها وجاءت سيول % % 137(@)(@@) % سادة عن قلوبهم زال غل % % 138(@)(@@) % ولهم في عز الحقيقة ذل % % 139(@)(@@) % ثم لما بهم لهم كان ظل % % 140(@)(@@) % قذفتهم إلى الرسوم فكل % دمه في طلولها مطلول % % PageV01P1291 141(@)(@@) % صرح القوم لي بما فكرهم حس % % 142(@)(@@) % يحرق الكف للجهول إذا جس % % 143(@)(@@) % ثم قالوا لكل من يطلب المس % % 144(@)(@@) % نارنا هذه تضيء لمن يس % % ري بليل لكنها لا تنيل % % 145(@)(@@) % كم عزيز في الحب لذلة الذل % % 146(@)(@@) % ثم من رونق النعيم قد استل % % 147(@)(@@) % شرفت حالة بها شغف الكل % % 148(@)(@@) % منتهى الحظ ما تزود منه ال % % خط والمدركون ذاك قليل % % 149(@)(@@) % هي ذات قد آظهرتنا لباسا % % 150(@)(@@) % وبنا منشأ زكت وأساسا % % PageV01P1292 151(@)(@@) % ثم يا عقل مذ تركت قياسا % % 152(@)(@@) % جاءها من عرفت يبغي اقتباسا % % وله البسط والمنى والسول % % 153(@)(@@) % نفرته عن حبها وأشمأزت % % 154(@)(@@) % وعليه من قدها الرمح هزت % % 155(@)(@@) % كل نفس همت بها واستفزت % % 156(@)(@@) % فتعالت عن المثال وعزت % % عن دنو إليه وهو رسول % % 157(@)(@@) % أخذتنا مقيدين أسارى % % 158(@)(@@) % والجوى قد أقام والصبر سارا % % 159(@)(@@) % يا ابن ودي كنا بها نتجارى % % 160(@)(@@) % فوقفنا كما عهدت حيارى % % كل عزم من دونها مخذول % % PageV01P1293 161(@)(@@) % عللتنا بما تشير الملاهي % % 162(@)(@@) % فسمعنا منها ولم ندر ما هي % % 163(@)(@@) % ثم رحنا والفكر بالشوق ساهي % % 164(@)(@@) % ندفع الوقت بالرجاء وناهي % % كم بقلب غذاؤه التعليل % % 165(@)(@@) % يا أخا الوجد من لصب أسير % % 166(@)(@@) % بين شوق نما وصبر بسير % % 167(@)(@@) % ويح قلبي في حب ظبي غرير % % 168(@)(@@) % كلما ذاق كأس يأس مرير % % جاء كأس من الرجا معسول 
ms284	 % % 169(@)(@@) % لم يجد في هوى المهفهف صبرا % % 170(@)(@@) % وبه الشوق قد توقد جمرا % % PageV01P1294 171(@)(@@) % مغرم القلب سره صار جهرا % % 172(@)(@@) % فإذا سولت له النفس أمرا % % حيد عنه وقيل صبر جميل % % 173(@)(@@) % حرم نحن فيه والغير في الحل % % 174(@)(@@) % رح سليما ومن ملامتنا قل % % 175(@)(@@) % فإذا ما سئلت يا أيها الخل % % 176(@)(@@) % هذه حالنا وما وصل العل % % م إليه وكل حال تحول % % PageV01P1295 البحر : - 1(@)(@@) % الحمد لله لا جاه ومال % % وإنما هو علم الله والحال % % 2(@)(@@) % فلا أخاف على جاه يزول ولا % % مال عليه يد تبغى وتحتال % % 3(@)(@@) % عندي علوم وما عندي لها أحد % % في عصرنا اليوم بين الناس حمال % % 4(@)(@@) % أبثها بين أقوام فيوهمني % % بعض بإيمانه والبعض نقال % % 5(@)(@@) % وهم يلومون في إفشائها وأنا % % أخاف تدركني بالكتم أنكال % % 6(@)(@@) % لعن من الله في القرآن جاء لمن % % أخفى بيانا له في الذكر إنزال % % 7(@)(@@) % وإنما أنا أبديها فيؤمن ذو % % هدى وينكرها من فيه إضلال % % 8(@)(@@) % يا ويحهم كلما أصغوا لها وجدوا % % قبولها فدهتهم منه أثقال % % 9(@)(@@) % فيعرضون اكتفاء بالذي فهموا % % والفهم فيها بدون الذوق بطال % % 10(@)(@@) % وغاية الأمر أن البعض ليس له % % منها على الجد إلا القيل والقال % % PageV01P1296 11(@)(@@) % عقيدتي كلها القرآن جملته % % وسنة المصطفى علم وأعمال % % 12(@)(@@) % والله لي منهما بالكشف يوضح ما % % لم تستعد له في القوم إبطال % % 13(@)(@@) % ذوق أكاد به أدرى الغيوب بلا % % دراية لكن الإيمان فعال % % 14(@)(@@) % والذل والانكسار القلب مشتمل % % عليهما دائما ما فيه إخلال % % 15(@)(@@) % وفي الأذية لي صبر ولي جلد % % وليس لي في انتظار النصر إهمال % % 16(@)(@@) % عندي التفاصيل من علم الإله ترى % % وغيرنا عنده في العلم إجمال % % 17(@)(@@) % دين هو الشرع باد والحقيقة قد % % دارت به فأحاطت وهي أحوال % % 18(@)(@@) % بر وبحر هما دين الإله فلا % % تكفر بواحدة منهن تغتال % % 19(@)(@@) % كن مؤمنا بهما إن لم يكن لهما % % فيك اقتدار فللرحمن إقبال % % 20(@)(@@) % بالشرع مؤمنهم لا بالحقيقة قل % % أو بالحقيقة لا بالشرع دجال % % PageV01P1297 21(@)(@@) % ومؤمن بهما في جنة وعلى % % لكن له عن تجلي 
ms285	 الحق أشغال % % 22(@)(@@) % لأنه ماله ذوق يحققه % % بالحق والقلب منه فيه إغفال % % 23(@)(@@) % وصاحب الذوق سر لا يباح به % % ما عنده قط في الأشياء إشكال % % 24(@)(@@) % الله أكبر هذا الدين فهت به % % جميعه ولغيري فيه أقوال % % 25(@)(@@) % فمن يجد عنده رشدا يدين به % % أولا فذلك للباغين تمثال % % PageV01P1298 البحر : - 1(@)(@@) % الا إنما المخلوق يعرف بالعقل % % وخالقنا بالحس يعرف والنقل % % 2(@)(@@) % وهم يعرفون الله بالعقل كلهم % % كما يعرفون الخلق بالحس والشكل % % 3(@)(@@) % فلو علموا أن الذي في عقولهم % % هو الخلق بل والحق في حسهم مجلى % % 4(@)(@@) % بآياته في كل شيء منزها % % عن الشيء حيث الشيء فإن من الكل % % 5(@)(@@) % تعالى وجل الله عن كل حادث % % بذات ووصف بل وبالاسم والفعل % % 6(@)(@@) % وقد أمر الله العباد قل انظروا % % وذلك بالعينين في النظر الأصلي % % 7(@)(@@) % وهم عدلوا عنه لأنظار عقلهم % % ودانوا كما دانت فلاسفة الخيل % % 8(@)(@@) % وما العقل إلا للمعاش فإنه % % لتدبير ملبوس وللشرب والأكل % % 9(@)(@@) % وأما الحواس الخمس فهي لربنا % % بها نشهد الآيات في العلو والسفل % % 10(@)(@@) % كما جاء في القرآن والسنة التي % % عن المصطفى بالحس تهدي ذوي العقل % % PageV01P1299 11(@)(@@) % لرؤية محسوسات آياته فخذ % % متابعة الآيات تنبتك كالبقل % % 12(@)(@@) % وتبصر فعل الله في كائناته % % وتشهدها الآيات تتلى على الوصل % % 13(@)(@@) % وذاك كلام الله والله قارئ % % كلاما قديما لا يبدء ولا فصل % % 14(@)(@@) % حروف بدت منا بأصواتنا له % % تجل عن الأصوات وإلا حرف المثل % % 15(@)(@@) % وكانت وما كنا جميعا وإنما % % هو العلم نور الذات يبديه كالظل % % 16(@)(@@) % وغيب غيوب الحق عزوجل عن % % مشابهة الأكوان والبعد والقبل % % 17(@)(@@) % ولكننا نومي إلى علمنا به % % ونعلم أن العلم منا أخو الجهل % % PageV01P1300 البحر : - 1(@)(@@) % ربي تجلى بأنواع الخلائق لي % % تجليا هو كشف القول والعمل % % 2(@)(@@) % فالقول كن فيكون اسمع مقالتنا % % فإنها لك تهدي أوضح السبل % % 3(@)(@@) % والفعل قدرته بعد الإرادة لم % % يترك من الكون شيئا غير منفعل % % 4(@)(@@) % فانظر بعقلك فيما أنت تدركه % % فإنه الخلق من عال ومنسفل % % 5(@)(@@) % وانظر إلى ربك الفعال ثم إلى % % كلامه الحق عين 
ms286	 الأحرف الأول % % 6(@)(@@) % بالجمع قرآنه والفرق أجمعه % % فرقانه فتحقق فالمقام جلى % % PageV01P1301 البحر : - 1(@)(@@) % إن من آيات ربي هو قال % % نومكم كل نهار وليال % % 2(@)(@@) % وكذا الناس نيام قاله % % من أتى بالحق في صدق المقال % % 3(@)(@@) % وإذا ماتوا يقول انتبهوا % % ومضى عنهم به حكم الخيال % % 4(@)(@@) % فافهموا إذا القول يا أمته % % تهتدوا للحق من غير جدال % % 5(@)(@@) % كل ما أدركتموه صور % % في منام من جلال وجمال % % 6(@)(@@) % عبروه تعرفوه واجزموا % % أنه الحق تعالى ذو الجلال % % 7(@)(@@) % مطلق في نومكم تلقونه % % في قيود كلها عنه محال % % 8(@)(@@) % ماله كيف ولا كيفية % % يتجلى بنساء ورجال % % 9(@)(@@) % وكبار وصغار مثل ما % % جاء في القرآن عنه وهو قال % % 10(@)(@@) % قال إنا كل شيء فارفعوا % % لام كل خبر يتلوه تال % % PageV01P1302 11(@)(@@) % وكذا قال له ما في السم % % وات والأرض وكم قال مثال % % 12(@)(@@) % يا نياما عبروا الرؤيا به % % هو حق وسوى الحق ضلال % % 13(@)(@@) % كل شيء هالك قال وكل % % من عليها هو فان بالزوال % % 14(@)(@@) % واقرأوا القرآن مثلي تجدوا % % كل ما قد قلته كل الكمال % % 15(@)(@@) % لا أنا أيضا ولا أنتم ولا % % كل شيء من مياه وجبال % % 16(@)(@@) % بل خيالات عقول ظهرت % % في منام وهو رب متعال % % 17(@)(@@) % إنه الله وجود واحد % % حكمه فينا حرام وحلال % % 18(@)(@@) % وهو حق وسواه باطل % % وإلى الحق رجوع ومآل % % 19(@)(@@) % وإليه ترجعون الله قد % % قال في القرآن والسبع الطوال % % 20(@)(@@) % أينما أنتم تولوا ثم وجه ال % % إله الحق محمود الفعال % % PageV01P1303 21(@)(@@) % لا تصدق أنت رؤياك كما % % للخليل القول قد كان يقال % % 22(@)(@@) % واتبع التعبير في الرؤيا تفز % % بالمنى لا بجواب وسؤال % % 23(@)(@@) % هذه الغاية في العرفان لا % % ما يقول الغير من قيل وقال % % PageV01P1304 البحر : - 1(@)(@@) % نفخ روح بالعز صار ذليلا % % دين رب مؤجل تأجيلا % % 2(@)(@@) % لترى الربح باتجارك فيه % % تفعل الخير بكرة وأصيلا % % 3(@)(@@) % فبذلت لدينا الميسر فيما % % تشتهيه ونلت حظا قليلا % % 4(@)(@@) % ثم حل الدين المؤجل حتى % % جاء يبغيه منك لا تمهيلا % % PageV01P1305 البحر : - 1(@)(@@) % أنت إنسان خيالي % % لك عقل 
ms287	 كالعقال % % 2(@)(@@) % أنت جسم من تراب % % فيه روح متلالي % % 3(@)(@@) % أنت في أنت كثيف % % في لطيف الروح عالي % % 4(@)(@@) % ليس في الخارج شيء % % منك بل لمعة آل % % 5(@)(@@) % إنما الخارج حق % % أمر رب متعالي % % 6(@)(@@) % وكذاك الخلق طرا % % من نساء ورجال % % 7(@)(@@) % وسموات وأرض % % وبحار وجبال % % 8(@)(@@) % كلهم عنك في صف % % حة مرآة الخيال % % 9(@)(@@) % صور تبدو وتخفى % % وهو حق في المجالي % % 10(@)(@@) % فتحقق بك وافهم % % قبل محو وزوال % % PageV01P1306 11(@)(@@) % واعرف المعروف تنجو % % من تناويع الضلال % % PageV01P1307 البحر : - 1(@)(@@) % كم غادة كاملة في حسنها % % لو يدرك البدر سناها لاختبل % % 2(@)(@@) % لبستها ثوب حرير ناعم % % بكرا وزررت عليها بالقبل % % 3(@)(@@) % ولي فؤاد بالحسان مغرم % % يدكه محبوبه دك الجبل % % 4(@)(@@) % واللات والعزى ظهوران له % % بما وراهما وما ورا هبل % % 5(@)(@@) % والحب كالحب هو الأصل وما % % تبدو له الفروع إلا بالسبل % % PageV01P1308 البحر : - 1(@)(@@) % ألا فتحقق أن كل استقامة % % بغير اعوجاج ما عليها معول % % 2(@)(@@) % فإن اعوجاج القوس عين استقامة % % له في يد الرامي فلا يتحول % % 3(@)(@@) % ولما استقام السهم زال بسرعة % % عن القوس فافهم أيها المتطول % 4(@)(@@) % وقصدي بهذا الاعوجاج هو الذي % % رأته نفوس جاهلون فجهلوا % % 5(@)(@@) % ولا يفرقون الحق من باطل السوى % % وشيطانهم يملى لهم ويسول % % 6(@)(@@) % وإلا فإن الاستقامة عين ما % % هو الشرع يسمو من بها يتجمل % % 7(@)(@@) % وما الشرع إلا والحقيقة عينه % % وبينهما لا فرق قول مفصل % % PageV01P1309 البحر : - 1(@)(@@) % صفا الوجود فلا علم ولا عمل % % وإنما الكل أوهما بها الخبل % % 2(@)(@@) % تقدير مولاك يا هذا جميعك قد % % بدافكن ذائقا قولي ولا زلل % % 3(@)(@@) % فشر وجودك أن القشر تأكله % % دواينا أنت قشر أيها الرجل % % 4(@)(@@) % وعلمنا في أولي الألباب يعرفه % % من قد تخفى بهم لما به جهلوا % % 5(@)(@@) % تبارك الله لا حق سواه ولا % % لباطل أثر يدري به البطل % % 6(@)(@@) % يا من تصفى وجود خالصا وبدا % % من قشرة إذ عليه كان يشتمل % % 7(@)(@@) % قشر هو العدم الموهوم ليس له % % أصل وما ثم سهل لا ولا جبل % % 8(@)(@@) % لما رأة الصعق موسى كان 
ms288	 ليس هنا % % موسى وقل جبل بالدك منجبل % % 9(@)(@@) % نعم تصفيت من دعوى الوجود وقد % % فنيت فاصدق إذا ما كنت تحتمل % % 10(@)(@@) % أنت الذي هو أنت الكل أجمعهم % % لا كل لكن علينا ضافت الحيل % % PageV01P1310 البحر : - 1(@)(@@) % أنا الوجود وكل الخلق أفعالي % % والنفس أمن لم أمتها فهي أفعى لي % % 2(@)(@@) % يا مكثر اللوم في تقبيح أعمالي % % شيطان أرسلك الرحمن أعمى لي % % PageV01P1311 البحر : - 1(@)(@@) % الفعل معدوم لا يظهر بلا فاعل % % يكون عنه سعال كان من ساعل % % 2(@)(@@) % فالكل مجعول فإني خلقة الجاعل % % نور الوجود به قنديلنا شاعل % % PageV01P1312 البحر : - 1(@)(@@) % اقبل على الحق لا تقبل على الباطل % % فالحق فاعل وغيره كله العاطل % % 2(@)(@@) % والله بالوعد موفي والسوى ماطل % % والغير ما حل وربي غيثه الهاطل % % PageV01P1313 البحر : - 1(@)(@@) % الله حق وأغياره عدم باطل % % والفاعل الله ربي السوى عاطل % % 2(@)(@@) % والحق يوفى وغيره بالوفا ماطل % % والغير ما حل وربي غيثه هاطل % % PageV01P1314 البحر : - 1(@)(@@) % قل لعباد الخيال % % كم قيام في الخيال % % 2(@)(@@) % تعبدون الله معقو % % لا عليه العقل والي % % 3(@)(@@) % وهو معقول بمعنى % % خاطر فيكم ببال % % 4(@)(@@) % عندكم حصلتموه % % ببراهين طوال % % 5(@)(@@) % هي في علم كلام % % عمدة بين الرجال % % 6(@)(@@) % جادل الماضون فيه % % مع أهل الاعتزال % % 7(@)(@@) % صنفوه بخصام % % في المعاني وجدال % % 8(@)(@@) % وخيالات فهوم % % وتماثيل المثال % % 9(@)(@@) % وتصاوير وفكر % % وبقيل وبقال % % 10(@)(@@) % وهو لولا فيه سمع % % ياته محض ضلال % % PageV01P1315 11(@)(@@) % أصله العقل ومعقو % % لاته مثل العقال % % 12(@)(@@) % أيها الأقوام كفوا % % عقلكم عن رب عالي % % 13(@)(@@) % ويحكم كم قد عبدتم % % ولد العقل المزال % % 14(@)(@@) % وشهدتم أنه الله بزور وتغالي % % 15(@)(@@) % ويحكم ما ولد العقل لرب متعالي % % 16(@)(@@) % وهو لم يولد كما قا % % ل بنص متلالي % % 17(@)(@@) % كيفما شئتم عرفتم % % ربكم مولى الموالي % % 18(@)(@@) % ويح إنسان يناجي % % صورة ذات انفعال % % 19(@)(@@) % يعبد الله الذي في % % عقله ولا يبالي % % 20(@)(@@) % وإذا قيل له رب % % ك باد في الجبال % % PageV01P1316 21(@)(@@) % وبأرض وسماء % % ورياض وظلال % % 22(@)(@@) % وبناس وبجن % وبإملاك وعجال % % 23(@)(@@) % وبكل الخلق في الأي % % أم طرا والليالي % % 24(@)(@@) % كل هذا فعل 
ms289	 رب % % قد تجلى ذي جلال % % 25(@)(@@) % ظاهر بالفعل منه % % وهو أنواع الفعال % % 26(@)(@@) % يتجلى بالذي يب % % ديه في أهل ابتهال % % 27(@)(@@) % وهو في التنزيه عن مخ % % لوقه في كل حال % % 28(@)(@@) % قال مع إنكاره ما % % قلته يبغى جدالي % % 29(@)(@@) % يتعالى الله عما % % قلته يا ابن الحلال % % 30(@)(@@) % كل هذا هو خلق % % قلته لي باحتفال % % PageV01P1317 31(@)(@@) % جل ربي وتعالى % % عنه في كل مجال % % 32(@)(@@) % إنما الله بعقلي % % ظاهر وبخيالي % % 33(@)(@@) % وأنا أعرفه من % % قبل أيام خوالي % % 34(@)(@@) % ما درى المسكين إن الله يجلي بالمجالي % % 35(@)(@@) % ظاهر في كل شيء % % ليس يخفى بانعزال % % 36(@)(@@) % وهو حق وسواه % % باطل لمعة آل % % 37(@)(@@) % قال براهيمإ قد وجهت وجهي في سؤالي % % 38(@)(@@) % للذي فطر الأر % % ض بأنواع الفعال % % 39(@)(@@) % وكذا أصحاب كهف % % قولهم أقوى المقال % % 40(@)(@@) % ربنا رب السموا % % ت العلى السبع الثقال % % PageV01P1318 41(@)(@@) % وكذاك الأنبيا والأولياء أهل الكمال % % ليا أهل الكمال % % 42(@)(@@) % كلهم لم يعبدوا بال % % عقل ربا ذا اتصال % % 43(@)(@@) % إنما هم عبدوا رب الدراري والهلال % % 44(@)(@@) % وله شمس الضحى مخلوقة ذات انفعال % % 45(@)(@@) % خالق كل البرايا % % عن يمين وشمال % % 46(@)(@@) % خالق الفوق مع التح % % ت وما في ذاك صالي % % 47(@)(@@) % خالق القدام والخل % % ف وما في كل كالي % % 48(@)(@@) % والهوا خالقه كال % % ترب والماء الزلال % % 49(@)(@@) % خالق النار وما تح % % رقه بالإشتعال % % 50(@)(@@) % ظاهر في كل شيء % % هالك فيه وبالي % % PageV01P1319 51(@)(@@) % واقرأ القرآن وافهم % % لا تكن عنه بقالي % % 52(@)(@@) % واترك العقل لأصحا % % ب عذاب ونكال % % 53(@)(@@) % يفهمون الدين منه % % بشباك وحبال % % 54(@)(@@) % ليس هذا دين ربي % % هو من قبح الخصال % % 55(@)(@@) % دينه الحق تعالى % % ذو جمال وجلال % % 56(@)(@@) % وله الأحكام فينا % % بحرام وحلال % % 57(@)(@@) % والذي يعرض عن أق % % والنا بالاشتغال % % 58(@)(@@) % فهو مشغول بدنيا % % ه بجاه أو بمال % % 59(@)(@@) % أو بعشق الهيف المر % % د وربات الحجال % % 60(@)(@@) % فهو مفتون وممقو % % ت ومحروم النوال % % PageV01P1320 61(@)(@@) % ما له حظ من الله ومن طيب الوصال % % 62(@)(@@) % إنما الطرد له وال % % بعد تعداد الرمال % % 63(@)(@@) % كل 
ms290	 وقت ما تغنى % % طائر فوق التلال % % PageV01P1321 البحر : - 1(@)(@@) % يحبني وأنا المعدوم لم أزل % % أحبه وهو موجود من الأزل % % 2(@)(@@) % إنا كلانا محب واحد وهما الم % % صوران على أحوالنا الأول % % 3(@)(@@) % حق هو الله فرد دائم أبدا % % وباطل أنا مع قولي ومع عملي % % 4(@)(@@) % يا أيها الباطل المغرور تطمع أن % % ترى وجودا بلا شبه ولا مثل % % 5(@)(@@) % وإنما أنت رأي قد أضلك في % % بطلانه فاقتصروا عرض عن الجدل % % 6(@)(@@) % نعم ترى أنت نور الوجه منه بدا % % يغشى الكوائن من سهل ومن جبل % % 7(@)(@@) % الله نور السموات استمع خبرا % % والأرض عن ربنا في الذكر منه تلى % % 8(@)(@@) % وتبصر النور مرشوشا عليك كما % % جاء الحديث به عن أشرف الرسل % % 9(@)(@@) % فاجعل فناءك معراجا إليه ولا % % تكن جبانا وكن كالفارس البطل % % 10(@)(@@) % هذا مقامك في دنيا وآخرة % % واترك وجودك تقرب منه بل تصل % % PageV01P1322 11(@)(@@) % إن الوجود بدا في كل كائنة % % معدومة وهو في حق الجميع جلى % % PageV01P1323 البحر : - 1(@)(@@) % الناس موصوفون بالأفعال % % وبسائر الأقوال والأفعال % % 2(@)(@@) % من غير تأثير لهم في كل ما % % يكون من ذلك باستئصال % % 3(@)(@@) % فإن معنى أنهم قد أثروا % % أي أظهروا من عدم للحال % % 4(@)(@@) % والله وحده هو المظهر لا % % سواه في الماضي والاستقبال % % 5(@)(@@) % فإن تكن نفوسهم قد ادعت % % إظهار فعل هم على الضلال % % 6(@)(@@) % لا يظهرون من جميع ما به % % قد وصفوا فعلا من الأفعال % % 7(@)(@@) % في ظاهر أو باطن وإنما % % يظهره الخلاق ذو الجلال % % 8(@)(@@) % وكلهم خلق الإله ربنا % % مع كل الأفعال على التتالي % % PageV01P1324 البحر : - 1(@)(@@) % عن يمين الحي من إضم % % سرب غزلان تبيح دمي % % 2(@)(@@) % يا لقومي من لواحظهم % % أسرت في الحب كل كمي % % 3(@)(@@) % والوجوه الغر طالعة % % أوجدوا وجدي من العدم % % 4(@)(@@) % واستباحوا يوم جفوتهم % % مهجتي شوقا لوصلهم % % 5(@)(@@) % واستهانوا بي وقد قهروا % % ثم صالوا صول منتقم % % 6(@)(@@) % ليت لو جادوا ولو سمحوا % % لي ولو بالطيف في الحلم % % 7(@)(@@) % أيها العذال في شغفي % % لومكم من أخبث الكلم % % 8(@)(@@) % لو شهدتم ما أشاهده % % من حبيبي ذقتمو ألمي 
ms291	 % % 9(@)(@@) % لكن الألباب زائغة % % لا تعي والطرف عنه عمي % % 10(@)(@@) % قربوا منامسا معكم % % علكم أن تسمعوا حكمي % % PageV01P1325 11(@)(@@) % واعلموا أني نصحت لكم % % لو عقلتم ما يقول فمي % % 12(@)(@@) % غير أني في نصيحتكم % % ناثر درا على غنم % % 13(@)(@@) % كيف تصغي العاذلون لنا % % وهم الأعدا من القدم % % 14(@)(@@) % كل مغرور بغير هدى % % ربه ناش من الوهم % % 15(@)(@@) % عابد من فكره صنما % % هائم بالجهل في الصنم % % 16(@)(@@) % محض تشبيه عقيدته % % في سوى التجسيم لم يهم % % 17(@)(@@) % جاهل بالطبع لذته % % لذة الثيران والنعم % % 18(@)(@@) % وعلى تشبيهه حذر % % خائف منا عليه ظمي % % 19(@)(@@) % إن نقل تنزيه خالقنا % % قال هذا زلة القدم % % 20(@)(@@) % وإذا بالفتح فهت له % % حل مني ساحة التهم % % PageV01P1326 21(@)(@@) % يا بني قومي ومن ألفوا % % نصرتي في كل مزدحم % % 22(@)(@@) % ذاكروني في مواجدكم % % عل أن يشفى بكم سقمي % % 23(@)(@@) % واسألوا برق الحمى كرما % % عن لويلات بذي سلم % % 24(@)(@@) % هل له في عود هن لنا % % إذ له التصريف في الحرم % % 25(@)(@@) % ليت أهل المنحنى عطفوا % % لي وراعوا حرمة الذمم % % 26(@)(@@) % أغمضوا عنا لواحظكم % % قد مزجتم دمعتي بدمي % % 27(@)(@@) % واعلموا أني شغفت بكم % % وأنا من جملة الخدم % % 28(@)(@@) % هائم صب كثير جوى % % في الهوى لحم على وضم % % 29(@)(@@) % كل أحوالي بكم ظهرت % % وغرامي غير منكتم % % PageV01P1327 البحر : - 1(@)(@@) % كل دين إن فاتك الإسلام % % فمحال لأنه أوهام % % 2(@)(@@) % إن من في الوجود طوعا وكرها % % دينهم كلهم هو الإسلام % % 3(@)(@@) % ظهر الحي والعوالم موتى % % وبدا النور والجميع ظلام % % 4(@)(@@) % وفنون التجليات علينا % % كثرت والعيون عنها نيام % % 5(@)(@@) % وسرت نسمة الحمى فأسرت % % أهل ذاك العهد القديم فهاموا % % 6(@)(@@) % يا إشارات من أحب رويدا % % منك في القلب صبوة وغرام % % 7(@)(@@) % رحت منها سكران لا القوم قوم % % في عيوني ولا الخيام خيام % % 8(@)(@@) % سلمت حين أسلمت خطراتي % % وعليها من السلام سلام % % 9(@)(@@) % والذي في قلوبنا أو ثان % % والذي في عيوننا أصنام % % 10(@)(@@) % ووراء الجميع محض وجود % % هم على وجهه الجميل قتام % % PageV01P1328 11(@)(@@) % وهو مشهودنا وشاهدنا في % % شأننا حيث يقظة ومنامسقط بيت ص 
ms292	 % % 12(@)(@@) % وأتم الأمور أنك ثوبوله منك كيف ما شاء حال وله منك كيف شئت مقام % بك تختال غادة وغلام % % 13(@)(@@) % وفؤاد المحب إن هام وجدا % % في المعاني فإنه لا يلام % % 14(@)(@@) % ولقد جاء بالجميع ركون % % وانقياد إليه واستسلام % % PageV01P1329 البحر : - 1(@)(@@) % قضي الأمر وجف القلم % % وبدت نار الحمى والعلم % % 2(@)(@@) % ونزلنا غرب وادي سلم % % واحتوانا ضالهم والسلم % % 3(@)(@@) % يا رعى الله قبابا بقبا % % عادها عادت ورامت إرم % % 4(@)(@@) % وسقى ثم لويلات بها % % لم يضمني في هواها إضم % % 5(@)(@@) % أيها النازل في كاظمة % % لي لسان فيك حي وفم % % 6(@)(@@) % بث للجيرة عني شغفا % % لم يزل بين الحشا يضطرم % % 7(@)(@@) % وتنصت للغواني سحرا % % ربما هاجك ذاك النغم % % 8(@)(@@) % واستمع صوت حمامات اللوى % % عندما تأتي عليها الظلم % % 9(@)(@@) % هذه النشأة فيها عبر % % للورى عنها تضيق الكلم % % 10(@)(@@) % وثياب الكون شفت فشفت % % مهجة للبعد فيها ألم % % PageV01P1330 11(@)(@@) % صوت دف الجسم عالي وبه % % نفخ ناي الروح لا ينكتم % % 12(@)(@@) % وشجانا رقص بانات النقى % % حين غنتها الصبا والديم % % 13(@)(@@) % حيث كاسات الهوى دائرة % % ويلي كل وجود عدم % % 14(@)(@@) % ونسيم الأمر فينا عابق % % وأزاهير الربا تبتسم % % 15(@)(@@) % والحمى طلق وأصحاب الحمى % % لم يزالوا فيه والقوم هم % % 16(@)(@@) % والذي قد كان لا زال على % % ما به كان وتلك النعم % % 17(@)(@@) % غير أن القلب لا قلب له % % وذوو الأفكار صموا وعموا % % 18(@)(@@) % لو أزيلت عن عيون حجب % % وتنحى عن قلوب وهم % % 19(@)(@@) % لرأوا الجهل الذي حف بهم % % وعلت منهم إليه همم % % 20(@)(@@) % وبدا الكل غرورا عندهم % % ولو دوا أنهم ما علموا % % PageV01P1331 21(@)(@@) % لكن الوسواس قد آيسهم % % أن منهم ليس تحيى الرمم % % 22(@)(@@) % فتراهم وطنوا أنفسهم % % أن منهم ليس يرقى القدم % % 23(@)(@@) % قد بذلت النصح يا قوم لكم % % حسب جهدي فانجلى المنبهم % % 24(@)(@@) % وشرحت الدين شرحا واضحا % % بلسان ما اعتراه بكم % % 25(@)(@@) % وزجرت العيس منكم للسرى % % فهمو أهل المعاني فهموا % % 26(@)(@@) % نفع الله بما فهت به % % وبما أسفر عنه القلم % % 27(@)(@@) % وبخير ختم الأمر لنا % % إننا للدين نحن الخدم % % 28(@)(@@) % ولأهل 
ms293	 الأرض طرا ولمن % % بالتقى تحفظ منه الذمم % % 29(@)(@@) % وصلاة الله مني دائما % % مع سلام منه لا ينصرم % % 30(@)(@@) % لنبي الله طه المصطفى % % ماتوا لي من إلهي كرم % % PageV01P1332 البحر : - 1(@)(@@) % حوت تعاظم فالتقم % % لهب التولع والسقم % % 2(@)(@@) % لولا أكون مسبحا % % في بطنه كان انتقم % % 3(@)(@@) % حتى إذا تمت كتا % % بة لوح صدري والرقم % % 4(@)(@@) % ألقى بساحل أمره % % كلي وعرفني اللقم % % 5(@)(@@) % فلمحت يونس حكمة % % زالت بها عني النقم % % PageV01P1333 البحر : - 1(@)(@@) % عالم الدنيا كفجر كاذب % % إن تبدى يعقب الضوء ظلام % % 2(@)(@@) % ونهار الحشر فجر صادق % % ليس فيه إن تحققت كلام % % 3(@)(@@) % وطلوع الشمس في أفلاكها % % أن ترى ربك في دار السلام % % 4(@)(@@) % فهي أطوار ثلاث جمعت % % دائما فيك على هذا النظام % % 5(@)(@@) % فاعتبرها منك بالجسم وبالنف % % س والروح تجدها والسلام % % PageV01P1334 البحر : - 1(@)(@@) % هوى قد أذاب الروح والنفس والجسما % % فلم يبق عينا للمشوق ولا رسما % % 2(@)(@@) % وبعض اصطبار أنفقته يد النوى % % وقد حسمت دآء التسلي لنا حسما % % 3(@)(@@) % سلونا على سلمى نفوسا نفيسة % % واسما لنا لم نبق ذاتا ولا اسما % % 4(@)(@@) % هي الكنز والجسم الكثيف جدارها % % إذا جهل الداعي بها يمتلي علما % % 5(@)(@@) % وما القرب إلا البعد عنها لأنها % % على الضد منا حيث كنا بها وهما % % 6(@)(@@) % هي العقل بل وهي المعاني جميعها % % هي الحس والمحسوس إن خص أو عما % % 7(@)(@@) % فإن رمت أن تدنو إليها فكن بهاوقف عندهها واترك وقوفك تاركا لتركك تكشف عن هلال بها تما % % بعيد أودع إن رمت فهما لها فهماسقط بيت ص % % 8(@)(@@) % وإياك والإقبال بالنفس نحوها % % وإياك والأعراص عنها بها زعما % % 9(@)(@@) % وصلها بما منها ومل نحو حانها % % بميل تراه جاء من نحوها حتما % % 10(@)(@@) % وكن ناظرا آثارها بعيونها % % وإلا فعن آثارها لم تزل أعمى % % PageV01P1335 11(@)(@@) % ولا تسمع الأصوات إلا بسمعها % % فإنك إن تسمع بها تسمع الصما % % 12(@)(@@) % وناديها في الناس واستمع الندا % % تجبك رجال نحوها ألفوا الهما % % 13(@)(@@) % وحول لها عن وجه ذاتك حجبها % % ترى الشمس تهدي من سنا عقلك النجما % % 14(@)(@@) % ولا تحتفل بالكل إن 
ms294	 ضل أوغوى % % فما فائز إلا بما خصه سهما % % PageV01P1336 البحر : - 1(@)(@@) % هوى أفنى الوجود فزال رسم % % ولا روح ولا وأبيك جسم % % 2(@)(@@) % وشخص في المحبة ماله اسم % % وهذا من جنون العشق قسم % % 3(@)(@@) % دور % % 4(@)(@@) % بما بجفون عينك من فتور % % وما بالخد من نار ونور % % 5(@)(@@) % دع الهجران واسمح بالحضور % % وهذا من جنون العشق قسم % % 6(@)(@@) % دور % % 7(@)(@@) % قوامك إن مشى يحكي العوالي % % وأنت على ملاح الكون والي % % 8(@)(@@) % أما ترثي أما ترثي لحالي % % وهذا من جنون العشق قسم % % 9(@)(@@) % دور % % 10(@)(@@) % محب قد أمات النفس قتلا % % ولم يقبل بمن يهواه عدلا % % PageV01P1337 11(@)(@@) % وشد على خناق الجسم حبلا % % وهذا من جنون العشق قسم % % 12(@)(@@) % دور % % 13(@)(@@) % له كبد من الأشواق ذابت % % وفطنته غراما فيك غابت % % 14(@)(@@) % ونفس بعد ذلك منه خابت % % وهذا من جنون العشق قسم % % 15(@)(@@) % دور % % 16(@)(@@) % شهيد الحب تقلته العيون % % وقد منت عليه بها المنون % % 17(@)(@@) % وغير قضاء ربي لا يكون % % وهذا من جنون العشق قسم % % 18(@)(@@) % دور % % 19(@)(@@) % م شهيد الحب تقلته العيون % % وقد منت عليه بها المنون % % 20(@)(@@) % وغير قضاء ربي لا يكون % % وهذا من جنون العشق قسمه % % PageV01P1338 21(@)(@@) % دور % % 22(@)(@@) % إذا اجتمع المحب مع الحبيب % % فقد وصل البعيد إلى القريب % % 23(@)(@@) % وجاء الموت بالعجب العجيب % % وهذا من جنون العشق قسم % % PageV01P1339 البحر : - 1(@)(@@) % سلم إن جئت أرض وادي سلم % % واقصد قوما على يمين العلم % % 2(@)(@@) % واشرح وجدي لهم عسى أن يرثوا % % أني فيهم مزجت دمعي بدمي % % PageV01P1340 البحر : - 1(@)(@@) % غب عن وجودك ترى في وسط قلبك رسم % % به حبيبك قسم لك من شهوده قسم % % 2(@)(@@) % واخرج عن الفكر واحسم داء فكرك حسم % % واعلم بأن التفكر من بقايا الرسم % % PageV01P1341 البحر : - 1(@)(@@) % بقاب قوسين قم يا صاح وارمي سهم % % إن كنت مقدام في حرب الأعادي شهم % % 2(@)(@@) % وافهم عانيم حروف الخلق أقوى فهم % % وارفع قناع الحجى واخرق حجاب الوهم % % PageV01P1342 البحر : - 1(@)(@@) % أمي جميع المقل يا مقلتي أمي % % في رؤية الحب من قاري ومن أمي % % 2(@)(@@) % ولا تؤمى السوى والغير 
ms295	 بل أمي % % أبى الذي تعرفي من قبل أو أمي % % PageV01P1343 البحر : - 1(@)(@@) % إن عين الوجود ليس تنام % % فتأمل ما تظهر الأيام % % 2(@)(@@) % وفم الكائنات ينطق لكن % % نحن قوم أسماعنا الأفهام % % 3(@)(@@) % ولنا في معارج القرب حال % % ولنا في ذرى الكمال مقام % % 4(@)(@@) % والمعالي والفخر والمجد فينا % % والمزايا والعز والاحتشام % % 5(@)(@@) % وبنا تعرف المعارف حتى % % يستبين الضيا ويخفى الظلام % % 6(@)(@@) % والرجال الرجال منا وعنا % % يحفظ النثر في الهدى والنظام % % 7(@)(@@) % وإلينا مراتب الفضل تعزى % % في البرايا وينسب الإكرام % % 8(@)(@@) % كل علم نفيده ذاك علم % % وكلام نقول ذاك الكلام % % 9(@)(@@) % والذي عندنا يقين وحق % % والذي عند غيرنا أوهام % % 10(@)(@@) % وعلينا من المهيمن عين % % من رعته فإنه لا يضام % % PageV01P1344 11(@)(@@) % وكفى المنكرين حرمانهم عن % % وردنا العذب حيث زاد الأوام % % 12(@)(@@) % وبهم حيرة وفرط اندهاش % % إن رأونا وقد علاهم قتام % % 13(@)(@@) % هذه حالهم ونحن على ما % % نحن فيه لا نرعوي والسلام % % PageV01P1345 البحر : - 1(@)(@@) % حق بدا في صورة الموهوم % % لما تسمى فيه بالقيوم % % 2(@)(@@) % وتتابعت أوصافه وترادفت % % أسماؤه في انفس وجسوم % % 3(@)(@@) % وتبينت أفعاله فتعاكست % % أحكامها في أمره المحكوم % % 4(@)(@@) % نحن الكواكب في سموات الهدى % % نرمي شياطين العدى برجوم % % 5(@)(@@) % صور شربناها حلاوة كوثر % % والجاهلون تعب من زقوم % % 6(@)(@@) % قرأوا الوجود وساوسا وزخارفا % % وشكوك أوهام وقبح فهوم % % 7(@)(@@) % ولقد قرأناه صحائف نشرت % % بالحق بين معارف وعلوم % % 8(@)(@@) % ظل ظليل للذين به اهتدوا % % وعلى الذين جفوه من يحموم % % 9(@)(@@) % ضاءت سموات القلوب بشمسنا % % وعلى الورى كانت طلوع نجوم % % 10(@)(@@) % والآن نوبته انقضت بظهورنا % % وخصوصنا مستجمع لعموم % % PageV01P1346 11(@)(@@) % أزل له ما قبلنا ولنا به % % أبدو ليس الفرق غير رسوم % % 12(@)(@@) % نحن الذين يضيء نور علومنا % % بين الورى في غيبة المعصوم % % 13(@)(@@) % الله أكبر ما أعز مقامنا % % وأجل وافر حظنا المقسوم % % PageV01P1347 البحر : - 1(@)(@@) % على رغم أنف الحاسدين مقامي % % وما الكل إلا خادمي وغلامي % % 2(@)(@@) % أنا النور أبدو في الزيادة كلما % % تقابلني منها العدى بظلام % % 3(@)(@@) % وأمسيت طودا في البرية شامخا % % وأصبحت بحرا في الحقيقة طامي % % 4(@)(@@) % وعندي علوم لو 
ms296	 وجدت لها وعا % % لأفرغتها فيه بحسن كلامي % % 5(@)(@@) % ولكن صدور الكون ضاقت فلم تجد % % مساغا لقولي فانثنت بملام % % 6(@)(@@) % أبي الفرد إلا أن أكون بعلمه % % أنا الفرد حقا والخواص عوامي % % 7(@)(@@) % وما زلت يقظانا لسر فهمته % % وأهل زماني عند أسر منام % % 8(@)(@@) % أكلت لبوب الاهتدا وتركتهم % % على قشرها غرثى البطون ظوامي % % PageV01P1348 البحر : - 1(@)(@@) % فؤادي قد أضربه الغرام % % 2(@)(@@) % وجسمي قد تناهبه السقام % % 3(@)(@@) % فيا من قد سهرت بهم وناموا % % 4(@)(@@) % لغير جمالكم نظري حرام % % وغير كلامكم عندي كلام % % 5(@)(@@) % سمعت من العواذل كل لوم % % 6(@)(@@) % وكنت عن السوى في حال صوم % % 7(@)(@@) % سعدنا أن رأيناكم بنوم % % 8(@)(@@) % وعمر النسر معكم بعض يوم % % وساعة غيركم عام فعام % % 9(@)(@@) % جرى منكم لموعدنا مطال % % 10(@)(@@) % فليت بكم يكون لنا وصال % % PageV01P1349 11(@)(@@) % وكم هجر أراه وكم دلال % % 12(@)(@@) % وصبري عنكمو شيء محال % % ومالي قاتل إلا الفطام % % 13(@)(@@) % لشمس جمالكم سترت غيومي % % 14(@)(@@) % فأوصافي بها أنا في غموم % % 15(@)(@@) % ويا من قد أنيط بهم علومي % % 16(@)(@@) % إذا عاينتكم زالت همومي % % وإن غبتم دنا مني الحمام % % 17(@)(@@) % تذكركم أهاج بنار سيسا % % 18(@)(@@) % وأسكرنا فأشبه خندريسا % % 19(@)(@@) % وهل ألقى سواكم لي أنيسا % % 20(@)(@@) % أود بأن أكون لكم جليسا % % وينصب لي بربعكمو خيام % % PageV01P1350 21(@)(@@) % على ليل الجفا منوا بفجر % % 22(@)(@@) % وكفوا بالعطا عن فرط حجر % % 23(@)(@@) % وإن رمتم بأن تحظوا بأجر % % 24(@)(@@) % فداووا بالوصال مريض هجر % % يهيم بكم إذا جن الظلام % % 25(@)(@@) % هنا صب متى وافى نسيم % % 26(@)(@@) % يهيج به لكم وجد مقيم % % 27(@)(@@) % ومشتاق له صبر عديم % % 28(@)(@@) % حديث غرامه فيكم قديم % % وملبسه من الحب السقام % % 29(@)(@@) % لنوع من محبتكم وفصل % % 30(@)(@@) % رمينا من لواحظكم بنصل % % PageV01P1351 31(@)(@@) % عسى ولعل منكم بعض وصل % % 32(@)(@@) % فأنتم للوجود أجل أصل % % إذا شئتم تحصل لي المرام % % 33(@)(@@) % بكم علم السوى قد صار جهلا % % 34(@)(@@) % ولست أرى لكم في الكون أهلا % % 35(@)(@@) % متى منكم يذوق الصب نهلا % % 36(@)(@@) % بكم صعب الأمور يعود سهلا % % فبالإحسان جودوا يا كرام % % 37(@)(@@) % شربت شرابكم طفلا وكهلا 
ms297	 % % 38(@)(@@) % وعانيت الهوى صعبا وسهلا % % 39(@)(@@) % فمهلا يا كرام الحي مهلا % % 40(@)(@@) % وليس سواكموا للجود أهلا % % فكيف نزيل ساحتكم يضام % % PageV01P1352 البحر : - 1(@)(@@) % أتعبتني بقر الشام % % وهي في نقض وإبرام % % 2(@)(@@) % واعنائي كم أعلمهم % % ثم ألقى جهلهم نامي % % 3(@)(@@) % زبلهم في الماء صيرهم % % شربه من غير أفهام % % 4(@)(@@) % لم يرقوا بالمواعظ إذ % % ماؤهم من حجر هامي % % 5(@)(@@) % كلهم لا يعرفون سوى % % قبح أفعال وآثام % % 6(@)(@@) % بطنهم والفرج أهلكهم % % مثل ثيران وأنعام % % 7(@)(@@) % فتراهم لا عقول لهم % % إنما هم أسر أوهام % % 8(@)(@@) % عصبة البهتان ضلوا ولم % % يختشوا زلات أقدام % % 9(@)(@@) % في قد زادت وساوسهم % % وابتلوا في داء برسام % % 10(@)(@@) % فلذا هم يخلطون بنا % % فرط تحقير بإكرام % % PageV01P1353 11(@)(@@) % بعضهم للبعض متبع % % حذو أقدام بأقدام % % 12(@)(@@) % حاولوا بالاستهانة أن % % يخفضوا مرفوع أعلامي % % 13(@)(@@) % وأرادوا في تعنتهم % % أن يذلوا قدري السامي % % 14(@)(@@) % ويهينوني ويحتقروا % % علم تحقيقي والهامي % % 15(@)(@@) % ولقد خاضوا ولم يخفوا % % غرقا في بحري الطامي % % 16(@)(@@) % والإله الحق مطلع % % بأموري خير علام % % 17(@)(@@) % قادر في الحال يأخذهم % % بي على قهر وإرغام % % 18(@)(@@) % ما أنا من جنسهم وبنو % % آدم هم مثل أصنام % % 19(@)(@@) % فكأني بينهم وأنا ال % % عربي من نسل أعجام % % 20(@)(@@) % ينكروني كلما جهلوا % % فيزيد الله إنعامي % % PageV01P1354 21(@)(@@) % وأنا من خبث عصبتهم % % بين عذال ولوام % % 22(@)(@@) % مولدي فيهم ولا عجب % % جوهر في صدف كامي % % 23(@)(@@) % لست منهم لانفرادي في ال % % بيت عنهم منذ أعوام % % 24(@)(@@) % قسوة فيهم وفرط جفا % % لم يخف مرميهم رامي % % 25(@)(@@) % وابتلوا بالبغي من حسد % % مثل أمراض وأسقام % % 26(@)(@@) % قد أتى في مسند ابن عدي % % خبر عن جل أقوام % % 27(@)(@@) % قال خير الخلق سيدنا % % الجفا والبغي في الشام % % PageV01P1355 البحر : - 1(@)(@@) % علم عظيم النفع للعالم % % جل عن المفهوم والفاهم % % 2(@)(@@) % وكيف لا ينكر وهو الذي % % يجهله إبليس في آدم % % 3(@)(@@) % حتى أبى عن أن يرى ساجدا % % لربه من قوة الواهم % % 4(@)(@@) % والتبس الأمر عليه ولم % % يقدر على التمييز في العالم % % 5(@)(@@) % كم عدم أخفى وجودا وكم % % من زائل غطى على دائم % % 6 
ms298	(@)(@@) % يا ويحه والنهر في داره % % من حائر صادي الحشى حائم % % 7(@)(@@) % وكل ذا من قسوة عنده % % وحسد في نفسه قائم % % 8(@)(@@) % لم يسلم الأمر إلى ربه % % ولم يشاهد حكمة الحاكم % % 9(@)(@@) % وعاند الخالق في خلقه % % معترضا سيف القضا القاسم % % 10(@)(@@) % فاحذروه واحذر أن تحاكي له % % ترجع بحال الخاسر النادم % % PageV01P1356 11(@)(@@) % يا أيها الإنسان قم وانتبه % % من لي بهذا الغافل النائم % % 12(@)(@@) % ويحك قد أشقى إله الورى % % إبليس من أجلك يا آدمي % % 13(@)(@@) % فكن سعيدا أنت واسبق إلى % % نيل العلى واعرض عن اللائم % % 14(@)(@@) % وكتب محيي الدين طالع لها % % بخاطر عن غيرها صائم % % 15(@)(@@) % معتقدا في حقها قاطعا % % بأنها دين أبي القاسم % % 16(@)(@@) % ولا تكن في ذاك مستعملا % % علوم رسم للبنا هادم % % 17(@)(@@) % فإن محيي الدين شمس الهدى % % وهو الإمام العارف الحاتمي % % 18(@)(@@) % عليه رضوان من الله ما % % تنعم المرحوم بالراحم % % PageV01P1357 البحر : - 1(@)(@@) % في كل جنس من الأجناس معلوم % % لابد من خادم فيهم ومخدوم % % 2(@)(@@) % وثالث هو بالإفساد بينهما % % يسعى بعقل من الخيرات معدوم % % 3(@)(@@) % وكل طائفة تخشى أفاضلهم % % تبدو أراذلهم بالقبح والشوم % % 4(@)(@@) % فكم رايت أناسا لا خلاق لهم % % وظالما ظاهر في زي مظلوم % % 5(@)(@@) % وكم بليت بأقوام سواسية % % في حكم أمر بعين الحس موهوم % % 6(@)(@@) % وكم عرفت بربي مشكلا قصرت % % عنه لعقول عقول العرب والروم % % 7(@)(@@) % وليس من يأكل الأكوان عذب جنى % % كمثل آكلها أشجار زقوم % % 8(@)(@@) % كل امرئ عقله ميزان حالته % % فليس صوت هزار الدوح كالبوم % % 9(@)(@@) % كلامنا الحق لا تخفى فوائده % % إلا على منكر للحق محروم % % 10(@)(@@) % به نخاطب أهل الاتفاق على % % سر عظيم من الأسرار مكتوم % % PageV01P1358 11(@)(@@) % هم المراد به لا غيرهم أبدا % % بالقول في كل منطوق ومفهوم % % 12(@)(@@) % من العلوم وسلوى الغير أهلهما % % في الشكل من عصبة القثاء والثوم % % 13(@)(@@) % أبو هريرة حيث الاختلاف رأى % % في الحق ما بين ممددوح ومذموم % % 14(@)(@@) % لو قال ما عنده من علم خالقه % % عن النبي دهاه قطع بلعوم % % 15(@)(@@) % ومثله شعر زين العابدين أتى % % يا رب جوهر علم قول 
ms299	 منظوم % % 16(@)(@@) % فتترك القاصرون الخوض في كلمي % % هم أهل عقل من الأغيار مكلوم % % 17(@)(@@) % ونحن قلنا عن السر المصون وعن % % نطق الوجود وأمر منه معلوم % % 18(@)(@@) % لا عن خيال ولا فكر وشاهده % % كنت اللسان له في قرب قيوم % % PageV01P1359 البحر : - 1(@)(@@) % يعلم الحق نفسه بالذي قد % % علم العبد نفسه عندما هم % 2(@)(@@) % وبه الحق يعلم العبد والعب % % د به صار يعلم الحق فافهم % % 3(@)(@@) % نسب أربع وهن لشيء % % واحد أين من لها يتفهم % % 4(@)(@@) % وبها كل نسبة ظهرت في % % كل عقل إيان أنجد أتهم % % 5(@)(@@) % وهي ذات لديك وهي ذوات % % فتحقق بها ولا تتوهم % % 6(@)(@@) % أربع مثل ما دللتك فاسلك % % منهج الصدق إنما الله ألهم % % 7(@)(@@) % واشرب الغيب بالشهادة مزجا % وكل الكل من إنائك وانهم % % 8(@)(@@) % واستمع أيها الجهول كلامي % % إن عندي لداء جهلك مرهم % % 9(@)(@@) % هي أنت الذي له وحدة الذا % % ت وبالوصف كثرة فتفهم % % 10(@)(@@) % وهي عين غلت وعزت وجلت % % عن سواها فأمرها عنك مبهم % % PageV01P1360 11(@)(@@) % ألبست غيرها على كل عقل % % وهي لا غيرها وذو اللب يفهم % % 12(@)(@@) % ورأينا شئونها ولكل % % وجهة حيثما تفاض وتلهم % % 13(@)(@@) % عبد ذات وعبد وصف وعبد ال % % وهم والفهم ثم عبد الدرهم % % 14(@)(@@) % واعتبر أوهن البيوت لبيت ال % % عنكبوت الذي لعقلك أوهم % % 15(@)(@@) % هذه لمحة من العلم بالذا % % ت لها أوضح التجلي وأبهم % % 16(@)(@@) % سكنت ديرها الأكابر منا % % وانجلى كاسها على كل ملهم % % 17(@)(@@) % فاعتقل رمحها الطويل إليها % % واقتحمها واركب من الليل أدهم % % 18(@)(@@) % طف بها كعبة وقبل سناها % % حجرا والتزم بها كل أشهم % % 19(@)(@@) % واستهمها حظا ودع كل حظ % % فلها الحق كل شيء أسهم % % 20(@)(@@) % إنها ما همو الجميع عليه % % وتغنى الهزار والليث همهم % % PageV01P1361 البحر : - 1(@)(@@) % قلبي بني فيه الهوى بيت الجمالص حجوا يا عشاقص من كل الآفاق % % 2(@)(@@) % حولي طوفواص وارموا جمري في الوادي % % وادي الأمانيص وحجكم قام % % 3(@)(@@) % دور % % 4(@)(@@) % يا طلعة الوجه المنير بالكمالص إنني مشتاق صوافر الأشواق % % 5(@)(@@) % لي لم يوفواص من لقياهم ميعادي % % أهل المعانيص قلبي بهم هام 
ms300	 % % 6(@)(@@) % دور % % 7(@)(@@) % فاكشف بنور الحق أستار الخيالص وافتح الأغلاقص واقرأ الأوراق % % 8(@)(@@) % ذا المعروفص واسمع رنات الحادي % % فالوصل دانيص وطابت الشام % % 9(@)(@@) % دور % % 10(@)(@@) % واستجلي هذا الكأس في جنح الليالص إن خمري راقص زائد الإشراق % % PageV01P1362 11(@)(@@) % فالمخطوفص قلبي هذاك الصادي % % لما يعانيص بحر الهوى الطام % % 12(@)(@@) % دور % % 13(@)(@@) % عيني التي قد شاهدت وجه الحبيبص مكشوف الأستارص شعاع الأنوار % % 14(@)(@@) % حتى صارتص تعطي للغير الأسرار % % يوم التلاقيص من فرط إنعام % % 15(@)(@@) % دور % % 16(@)(@@) % وكوشف القلب بذا العلم الغريبص زادت الأطوارص حارت الأفكار % % 17(@)(@@) % لما طارتص عنا أطيار الأغيار % % والقلب راقيص في أوج إسلام % % 18(@)(@@) % دور % % 19(@)(@@) % ثم الصلاة والسلام من قريبص للهادي المختارص العالي المقدار % % 20(@)(@@) % من قد سارتص لما ناداها الأشجار % % وهو الواقيص بجوده العام % % PageV01P1363 21(@)(@@) % دور % % 22(@)(@@) % ما طاب من عبد الغني الصدر الرحيبص في نظم الأشعارص بالمدح المعطار % % 23(@)(@@) % أو قد دارتص أفلاك وقت الأسحار % % وطاب ساقيص بطيب إنعام % % PageV01P1364 البحر : - 1(@)(@@) % ظهرت يا نور والسوى عدم % % فأشرقت من ظهورك الظلم % % 2(@)(@@) % وبان سر الحدوث في صور % % بها عليها تلبس القدم % % 3(@)(@@) % وموج بحر الوجود مختلف % % وهو الكتاب المبين والكلم % % 4(@)(@@) % لنا إلى الحق نسبة ظهرت % % بها يكون النعيم والألم % % 5(@)(@@) % يا أمة النور هذه رتب % % تبدو بها الذات ثم تنكتم % % 6(@)(@@) % نحن وأنتم وأنتما وهما % % وهن وهو الجميع قل وهمو % % 7(@)(@@) % وليس إلا الوجود صادرة % % شئونه عنه منه تنقسم % % 8(@)(@@) % وجه له باعتبارها ويد % % كذاك عين وصورة وفم % % 9(@)(@@) % وكل ما جاءت النصوص به % % والحكم منه اقتضاه والحكم % % 10(@)(@@) % قف عندها يا حجاب حضرتها % % مدادها عنه أنت مرتسم % % PageV01P1365 11(@)(@@) % وكن بها لا بغيرها ولها % % لا لسواهها يزول منبهم % % 12(@)(@@) % واعلم بأن الوجود هاهوذا % % وما سواه فإنه عدم % % 13(@)(@@) % يكشف عن ذاته ويظهرها % % له ويعطيك غيره الوهم % % 14(@)(@@) % وهو على نفسه به وله % % يكتبنا فوق لوحه القلم % % 15(@)(@@) % وليس فيما مضى وما هو في % % مستقبل غيره هم التهم % % 16(@)(@@) % الله الله يا موحده % % فإنه محسن ومنتقم % % 17(@)(@@) % وكن 