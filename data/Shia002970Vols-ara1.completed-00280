ms261	 وقال " كش " انه فطحي.(@)(@@)(@@)(@@) $ 2728 - معاوية بن سعيد الكندي " ق " " ضا " الكوفي، له مسائل عن الرضا عليه السلام، عنه محمد بن الحسين بن أبي الخطاب " جش " وفي " تعق " ذكر في أخيه محمد انهما معروفان، ويظهر من " جش " كونه اماميا.(@)(@@)(@@)(@@) $ 2729 - معاوية بن وهب بن جبلة، له كتاب، عنه عبيد الله بن أحمد بن نهيك " ست ". PageV01P360(@)(@@)(@@)(@@) $ 2730 - معاوية بن وهب بن فضال، له كتاب، عنه عبيد الله بن أحمد بن نهيك " ست ".(@)(@@)(@@)(@@) $ 2731 - معاوية بن وهب الميثمي، له كتاب، عنه عبيد الله بن أحمد بن نهيك " ست ".(@)(@@)(@@)(@@) $ 2732 - معاوية بن يحيى " ضا " غير معلوم الحال من المدح والذم، والله أعلم.(@)(@@)(@@)(@@) $ 2733 - معلى أبو عثمان الأحول، عن معلى بن خنيس، له كتاب " ست " ويجئ في التالية معلى بن عثمان أبو عثمان الأحول.(@)(@@)(@@)(@@) $ 2734 - معلى بن أسد، غير مذكور بهذا العنوان، ويأتي بعنوان ابن راشد، كذا في المنتهى. أقول: ومن أحفاده أحمد بن إبراهيم الراوي عنه التلعكبري اجازة، وقد أشرنا إليه في طبقته.(@)(@@)(@@)(@@) $ 2735 - معلى بن راشد بالراء قبل الألف ضعيف غال " صه " وفي " تعق " هذا كلام " غض " كما في النقد، وحكم المولى عناية الله بأن الصواب بدل راشد أسد، لما في كلام " ست " و " لم " و " جش " و " صه " التصريح به في أحمد بن إبراهيم بن المعلى، هكذا في المنتهى. أقول: إن نسبته إلى الأربعة التصريح به في ترجمة أحمد فهو غير موجود حتى في نسخة المنتهى الحاضرة عندي، فلعله غيره، والتصحيف خلاف الأصل والغلبة، فتدبر.(@)(@@)(@@)(@@) $ 2736 - معمر بن خلاد بن أبي خلاد، وأبو خلاد بغدادي ثقة روى عن " ضا " عليه السلام " جش " " صه " عنه محمد بن عيسى بن زياد، وأحمد بن أبي عبد الله، والصفار " ست " " جش ".(@)(@@)(@@)(@@) $ 2737 - معن بن خالد، من أصحاب الرضا عليه السلام له كتاب ثقة " صه " " جخ " " د " الا من أصحاب الرضا عليه السلام مع إضافة الأول بالنون.(@)(@@)(@@)(@@) $ 2738 - معن بن عبد السلام، له كتاب الزهد، عنه معمر بن خلاد " جش " والحسن بن محمد بن سماعة " ست 
ms262	 " وفي المنتهى ظاهر " ست " و " جش " كونه اماميا، وبعد انضمام كونه صاحب كتاب الزهد إليه لعله يقوى خبره انتهى. أقول: واستظهار PageV01P361(@)(@@) كونه اماميا منهما في حيز المنع بلا خفاء، فلا اعتداد به.(@)(@@)(@@)(@@) $ 2739 - المغيرة بن توبة الكوفي " ق " وفي ارشاد المفيد ما يدل على أنه من خاصة " ظم " عليه السلام وثقاته ومن أهل الورع والعلم والفقه من شيعته، هكذا فهمه في النقد والوجيزة، وفي " تعق " سنشير إلى أنه غيره بل هو عبد الله بن الحارث. أقول:(@)(@@) فيحتاج المقام إلى التأمل التام.(@)(@@)(@@)(@@) $ 2740 - مقاتل بن مقاتل بن قياما، واقفي خبيث " ضا " من أصحاب " ضا " عليه السلام " صه " روى عنه عليه السلام له كتاب، عنه الحسن بن علي بن يوسف به " جش " وفي " تعق " توقف في وقفه وزعم أن الشيخ اشتبه عليه لما رأى في الاخبار ان ابن قياما واقفي خبيث شديد العناد، فتوهم انه مقاتل، وليس كذلك بل هو الحسين، وفيه تأمل.(@)(@@)(@@)(@@) $ 2741 - ممويه بن معروف، ضعيف " صه " " د " " لم " روى عنه محمد بن أحمد بن يحيى " د " " لم " وفي " تعق " مضى في أحمد بن يحيى أيضا. أقول: هو ممن استثناه ابن الوليد من رجال نوادر الحكمة.(@)(@@)(@@)(@@) $ 2742 - منذر بن جفير أو جيفر على الأصح ابن حكيم العبدي، عربي صميم، روى أبوه عن " ق " عليه السلام له كتاب، عنه إسماعيل بن مهران " جش " وفي " تعق " حسنه خالي لان للصدوق طريقا إليه وفي رواية الأجلة كصفوان وابن المغيرة وأحمد بن محمد بن عيسى وغيرهم عنه اشعار بالوثاقة. أقول: بل دلالة عليها خصوصا مع ملاحظة تأييدات أخر.(@)(@@)(@@)(@@) $ 2743 - منصور بن أبي منصور مولى أبي الحسن عليه السلام " ظم ".(@)(@@)(@@)(@@) $ 2744 - منصور بن العباس " دي " كوفي أو بغدادي أبو الحسن الرازي سكن بغداد ومات بها، مضطرب الامر، له كتاب، عنه أحمد بن مابندار " جش " وأحمد بن أبي عبد الله " ست " " لم ".(@)(@@)(@@)(@@) $ 2745 - موسى بن إبراهيم المروزي أبو حمران، روى عن أبي الحسن موسى عليه السلام له كتاب، ذكر أنه سمعه وأبو الحسن عليه السلام محبوس 
ms263	 عند PageV01P362(@)(@@) السندي بن شاهك، عنه محمد بن خلف (@)(@@)(@@)(@@) $ 2746 - موسى بن جعفر البغدادي " ست " " لم " له كتاب، عنه محمد بن أحمد بن يحيى " ست " وفي " جش " ابن جعفر بن وهب ويأتي.(@)(@@) أقول: وفي رواية ابن أحمد بن يحيى عنه وعدم استثنائه وظهور كونه اماميا من " ست " و " جش " امارة قوية على الاعتماد.(@)(@@)(@@)(@@) $ 2747 - موسى بن جعفر بن وهب البغدادي أبو الحسن، له كتاب، محمد بن أحمد بن قتادة عنه به، وكذا عمران بن موسى " جش " وكذا في " مشكا " وتقدم عن " ست " " لم " ابن جعفر البغدادي، والظاهر الاتحاد كما يظهر من الميرزا وغيره، فتأمل.(@)(@@)(@@)(@@) $ 2748 - موسى بن جندب قمي " ضا ".(@)(@@)(@@)(@@) $ 2749 - موسى بن الحسن " ظم ".(@)(@@)(@@)(@@) $ 2750 - موسى بن الحسن بن عامر بن عمران بن عبد الله بن سعيد الأشعري القمي أبو الحسن، ثقة عين جليل " صه " " جش " صنف ثلاثين كتبا، الحميري عن أبيه عنه.(@)(@@)(@@)(@@) $ 2751 - موسى بن حماد الطيالسي الدراع، ذكره محمد بن الحسين بن أبي الخطاب في الواقفة " صه " قاله ابن نوح، وقال: هو موسى بن حماد الذراع " جش ".(@)(@@)(@@)(@@) $ 2752 - موسى بن داود المنقري " ج ".(@)(@@)(@@)(@@) $ 2753 - موسى بن داود اليعقوبي " ج " " دي ".(@)(@@)(@@)(@@) $ 2754 - موسى بن رنجوية أبو عمران الأرمني ضعيف " صه " " جش " له كتاب أكثره عبد الله بن الحكيم، روى عنه محمد بن حسان " لم " وفي " ضح " زنجويه بالزاي المعجمة والأرمني بالكسر.(@)(@@)(@@)(@@) $ 2755 - موسى بن سابق الكوفي " ق " " جش " له كتاب، عنه الحسين بن علي اللؤلؤي " جش " وقال في المنتهى: عند الشيخ و " جش " امامي، ورواية جماعة تشير إلى الاعتماد عليه انتهى. أقول: ولم يظهر منهما ذلك هنا الا أن يكون من محل آخر، ورواية الجماعة غير معلومة كذلك ولم يذكر الا الحسين. PageV01P363(@)(@@)(@@)(@@) $ 2756 - موسى بن سعدان الخياط " ظم " " صه " " جش " الكوفي روى عن أبي الحسن موسى عليه السلام، ضعيف في مذهبه غال، له كتب كثيرة، عنه محمد بن الحسين بن أبي الخطاب " ست " " جش " ويظهر من " تعق " وتلميذه الاعتماد عليه باجتهادات غير وافية.(@)(@@)(@@)(@@) $ 2757 - موسى بن سلمة، كوفي له 
ms264	 كتاب عن الرضا عليه السلام، عنه محمد بن سالم بن عبد الرحمن " جش ".(@)(@@)(@@)(@@) $ 2758 - موسى بن طلحة القمي، قريب الامر، ذكر ذلك أبو العباس " صه " " جش " له كتاب " ست " عنه البرقي " جش " " ست " وفي " مشكا " ابن طلحة أحمد بن أبي عبد الله عنه.(@)(@@)(@@)(@@) $ 2759 - موسى بن عبد السلام، مضى في بكر بن محمد الأزدي، أنه من بيت جليل بالكوفة " تعق " أقول: وهو ابن عم بكر بن محمد الأزدي الذي يأتي في التالية، وهو من أصحاب " ظم " وابنه " ضا " عليهما السلام.(@)(@@)(@@)(@@) $ 2760 - موسى بن عبد الله بن عبد الملك بن هشام " ج ".(@)(@@)(@@)(@@) $ 2761 - موسى بن عمر بن بزيع " دي " ثقة " ج " " صه " " جش " مولى المنصور كوفي، له كتاب، عنه يحيى بن سنان زكريا " جش " عبد الرحمن بن حماد " ست ".(@)(@@)(@@)(@@) $ 2762 - موسى بن عمر البغدادي، روى الصدوق في الأمالي والعيون في الصحيح عن محمد بن أحمد بن يحيى عنه عن ابن ولم يستثن " تعق ".(@)(@@)(@@)(@@) $ 2763 - موسى بن عمر بن يزيد بن ذبيان الصيقل أبو علي مولى بني نهد، له كتاب، عنه محمد بن علي بن محبوب " ست " وفي " جش " عنه سعد، فيكون في السابقة.(@)(@@)(@@)(@@) $ 2764 - موسى بن عمر الحضيني " دي " لم أقف على مدح ولا ذم له، فلا اعتداد بما يرويه بانفراد.(@)(@@)(@@)(@@) $ 2765 - موسى بن عيسى بن عبيد اليقطيني أخو محمد، في " يب " عن محمد PageV01P364(@)(@@) بن عيسى قال: بعث الرضا عليه السلام رزم ثياب وغلمان ودنانير وحجة لي وحجة لاخي موسى بن عيسى وحجة ليونس وأمرنا ان نحج عنه الحديث. واحتمل في " تعق " كونه ابن يقطين الآتي، وحكم بدلالته على عدالتهم، وفيه تأمل.(@)(@@)(@@)(@@) $ 2766 - موسى بن القاسم بن معاوية بن وهب البجلي، عربي كوفي ثقة " ضا " أبو عبد الله يلقب البجلي من أصحاب الرضا عليه السلام، كوفي ثقة ثقة جليل، واضح الحديث، حسن الطريقة " صه " " جش " عنه الفضل وأحمد بن محمد.(@)(@@)(@@)(@@) $ 2767 - موسى بن محمد الحضيني " دي " وهو كأضرابه غير مقبول الحديث، والله العالم.(@)(@@)(@@)(@@) $ 2768 - موسى بن محمد بن علي الرضا عليهما 
ms265	 السلام روى المفيد أبو عبد الله فيه ما ينبئ عنه انه غير مشكور.(@)(@@)(@@)(@@) $ 2769 - موسى بن مرشد الوراق نيسابوري " دي ".(@)(@@)(@@)(@@) $ 2770 - موسى بن معمر " ضا " غير معروف الحال، فلا يقبل حديثه.(@)(@@)(@@)(@@) $ 2771 - موسى بن مهران " ضا ".(@)(@@)(@@)(@@) $ 2772 - موسى بن يقطين " ضا " يحتمل كونه ابن عيسى المتقدم " تعق ".(@)(@@)(@@)(@@) $ 2773 - موفق بن هارون " ضا " وفي " تعق " لعله الذي مر في محمد بن سنان أنه اخرج أبا جعفر عليه السلام وهو في صدره، ويظهر منه انه من خدامه عليه السلام بل من خواصه، وفي المجمع أنه عبده عليه السلام.(@)(@@)(@@)(@@) $ 2774 - مهران بن أبي بصير " ظم " احتمل الميرزا كونه ابن نصر الآتي في التالية.(@)(@@)(@@)(@@) $ 2775 - نجم بن حطيم العجلي أبو علي، مات في حياة أبي الحسن عليه السلام روى عن أبي جعفر عليه السلام " ق ".(@)(@@)(@@)(@@) $ 2776 - نصر بن حازم القمي " دي ".(@)(@@)(@@)(@@) $ 2777 - نصر بن مزاحم المنقري العطار أبو الفضل، كوفي مستقيم الطريقة صالح الامر، غير أنه يروي عن الضعفاء، عنه يحيى بن زكريا، وجعفر بن محمد بن PageV01P365(@)(@@) سعيد وأبو سمينة، ومحمد بن عيسى، ويونس بن علي. وعن شرح ابن أبي الحديد أنه في نفسه ثبت صحيح النقل غير منسوب إلى هوى.(@)(@@)(@@)(@@) $ 2778 - نصر بن مغلس " ضا ".(@)(@@)(@@)(@@) $ 2779 - النضر بن سويد الصيرفي، كوفي ثقة صحيح الحديث، انتقل إلى بغداد، له كتاب، عنه عيسى بن عبيد، وأبو عبد الله البرقي، والحسن بن سعيد " ست " وفي " صه " من أصحاب " ظم " عليه السلام.(@)(@@)(@@)(@@) $ 2780 - النضر بن شعيب، في طريق الصدوق إلى خالد بن مارد يروي عبد الغفار، قال جدي: وربما يتوهمون أن شعيبا تصحيف سويد، وليس كذلك بل هما اثنان وان لم يذكروه في الرجال، لكنه موجود في الروايات في الكتب المعتمدة، سيما في الرواية عن عبد الغفار " تعق ".(@)(@@)(@@)(@@) $ 2781 - النضر بن محمد الهمداني ثقة " صه " " دي " " د " من أصحاب " ظم " في الأول.(@)(@@)(@@)(@@) $ 2782 - نعيم القابوسي، عده المفيد من خاصة أبي الحسن موسى عليه السلام وثقاته ومن أهل الورع والعلم والفقه من شيعته.(@)(@@)(@@)(@@) $ 2783 - نوح بن شعيب البغدادي، 
ms266	 من أصحاب أبي جعفر الثاني عليه السلام، ذكر الفضل بن شاذان انه كان فقيها " صه " " جخ " عالما صالحا مرضيا وقيل: إنه نوح بن صالح " ج ".(@)(@@)(@@)(@@) $ 2784 - نوح بن صالح البغدادي، ذكر " كش " عن الشاذاني عن ابن شاذان انه من شيعة أهل البيت، وعن بعض " كش " ما يؤمي إلى اتحاده مع ابن شعيب كما عن " ج " فتأمل.(@)(@@)(@@)(@@) $ 2785 - واصل، قال " كش " معد حدثني أبو علي المحمودي، قال: حدثني واصل قال: طلبت أبا الحسن عليه السلام بالنورة فسددت مخرج الماء من الحمام إلى PageV01P366(@)(@@) البئر، ثم جمعت ذلك الماء وتلك النورة وذلك الشعر فشربت كله (1).(@)(@@)(@@)(@@) $ 2786 - الوليد بن أبان الضبي الرازي " ضا " يروي عنه أبو حنيفة محمد بن يحيى السابق، ذكره كما في الكافي.(@)(@@)(@@)(@@) $ 2787 - الوليد بن سعد مولى أبو الحسن عليه السلام " ظم " ابن سعيد " د ".(@)(@@)(@@)(@@) $ 2788 - الوليد بن هشام المرادي " ظم ".(@)(@@)(@@)(@@) $ 2789 - وهب بن محمد البزاز أبو نصر القمي، ثقة عين له كتاب، عنه محمد بن علي بن محبوب، وفي " تعق " في " يب " في الصحيح عن صفوان عنه، وهو يشعر بوثاقته.(@)(@@)(@@)(@@) $ 2790 - هارون بن عبد العزيز أبو علي الأراجني الكاتب، بصري كان وجها في زمانه، مدحه المتنبي، وله ابن اسمه علي، وكان حسن التخصيص بمذهبنا " صه " وزاد " جش " له كتاب الرد على الواقفة.(@)(@@)(@@)(@@) $ 2791 - هارون بن عمر بن عبد العزيز بن محمد أبو موسى المشاجعي، صحب الرضا عليه السلام له كتب، عنه الفضل بن المسيب الشعراني " جش " وظاهره كونه اماميا لقوله " صحب " وعد من كتبه كتاب ما نزل في القرآن علي عليه السلام فيكون اماميا ممدوحا وقد أشار إليه أبو علي، فتأمل.(@)(@@)(@@)(@@) $ 2792 - هاشم بن إبراهيم العباسي الذي يقال له المشرقي، روى عن الرضا عليه السلام له كتاب يونس عنه عن الرضا عليه السلام، قال أبو النضر: سألنا الحسين بن اشكيب عن العباسي الحديث. ويأتي عن " كش " و " صه " هشام.(@)(@@)(@@)(@@) $ 2793 - هشام بن إبراهيم الأحمر " ضا ".(@)(@@)(@@)(@@) $ 2794 - هشام بن إبراهيم العباسي، روى " كش " عن " دي " عليه السلام ما يدل على الطعن، 
ms267	 وفي طريق آخر مرسل عن صفوان وابن سنان أنهما سمعا منه عليه(@)(@@) PageV01P367(@)(@@) السلام يقول: لعن الله العباسي فإنه زنديق، والعلامة قال: الطعن في مذهبه لا في نفسه و " د " لا في ثقته.(@)(@@)(@@)(@@) $ 2795 - هشام بن إبراهيم المشرقي البغدادي الختلي، وقد تقدم في جعفر بن محمد بن عيسى بن عبيد، وفي " كش " عن حمدوية ما يدل على توثيقه واتحاده مع العباسي الملعون، كما زعمه الميرزا غير معلوم.(@)(@@)(@@)(@@) $ 2796 - هند بن الحجاج " ظم " روى " كش " حديثا في طريقه نظر بشهد بأن له بالكاظم عليه السلام اختصاصا " صه " أقول: والحديث طويل فلا مجال لذكره الا في " د " " كش " ممدوح، وفي " تعق " في الوجيزة حسن.(@)(@@)(@@)(@@) $ 2797 - الهيثم بن عبد الله الرماني كوفي روى عن موسى والرضا عليهما السلام له كتاب " جش ".(@)(@@)(@@)(@@) $ 2798 - الهيثم بن عدي، روى عنه محمد بن أحمد بن يحيى " لم ". وهو في السابقة وقد مضى.(@)(@@)(@@)(@@) $ 2799 - الهيثم بن محمد الثمالي، كوفي ثقة " جش " " صه " له كتاب، عنه إبراهيم بن سليمان بن حيان الخزاز، والحسين بن سعيد " ست " " جش " مشوشا.(@)(@@)(@@)(@@) $ 2800 - ياسر خادم الرضا عليه السلام وهو مولى حمزة بن اليسع الأشعري القمي، له مسائل عن الرضا عليه السلام " ست " عنه البرقي أحمد " ست " " جش " وفي العيون روى حديثا عنه عن " ري " عليه السلام ثم قال: إنه قد لقى الرضا عليه السلام وحديثه عنه غريب. قلت: لا غرابة فيه إذ حينئذ أدرك ثلاثة كما وقع لنظائره.(@)(@@) والظاهر كونه اماميا.(@)(@@)(@@)(@@) $ 2801 - ياسين الضرير الزيات البصري، لقى أبا الحسن موسى عليه السلام لما كان بالبصرة روى عنه وصنف هذا الكتاب المنسوب إليه " جش " عنه محمد بن عيسى " جش " " ست ".(@)(@@)(@@)(@@) $ 2802 - يحيى بن إبراهيم بن يحيى مولى عبد الله بن غطفان، ثقة هو أبوه أحد القراء كان يتحقق بأمرنا هذا " صه " " جش " له كتاب عنه يحيى بن زكريا. PageV01P368(@)(@@) " جش " أحمد بن أبي عبد الله عن أبيه عنه " ست ".(@)(@@)(@@)(@@) $ 2803 - يحيى بن أبي بكر بن مهروية " لم " القزويني، له نوادر " جش " يكنى أبا زكريا من أهل 
ms268	 قزوين، له كتاب " ست " عنه أحمد بن أبي عبد الله " جش " " ست " " لم ".(@)(@@)(@@)(@@) $ 2804 - يحيى بن أبي السمط وهو رئيس السمطية القائلة بامامة محمد بن جعفر عليه السلام دون موسى عليه السلام وعبد الله، كما يأتي في المذاهب.(@)(@@)(@@)(@@) $ 2805 - يحيى بن أبي عمران، للصدوق طريق إليه يروي عن يونس، وعنه إبراهيم بن هاشم، ويظهر من روايته تشيعه، ومضى في أحمد بن سابق بسند ضعيف أن الرضا عليه السلام كتب إليه والى أصحابه عافاه الله وإياكم. ويحتمل كونه ابن عمران الهمداني الآتي، ووصفه بيونسي هناك يشعر بحسنه " تعق ".(@)(@@)(@@)(@@) $ 2806 - يحيى بن أحمد بن قيس بن غيلان " ضا ".(@)(@@)(@@)(@@) $ 2807 - يحيى بن حبيب الزيات، في " تعق " في ترجمة ابن جندب الظاهر أنه مصحف حبيب، كما لا يخفى على المطلع لاشتهار ابن حبيب الزيات وكثرة وروده في الروايات، وفي الوجيزة حسن الخ، وفي اتحاده مع ابن جندب كلام، ويأتي في التالية.(@)(@@)(@@)(@@) $ 2808 - يحيى بن جندب الزيات " ضا " لم أجد غير الترجمة من الوصف ذما أو مدحا، فهو كنظائره محل التوقف في روايته، والله أعلم.(@)(@@)(@@)(@@) $ 2809 - يحيى بن الحسن بن جعفر بن عبيد الله بن الحسين بن علي بن الحسين بن علي بن أبي طالب عليهم السلام أبو الحسين العالم الفاضل الصدوق، روى عن الرضا عليه السلام.(@)(@@)(@@)(@@) $ 2810 - يحيى بن الحسين العلوي، له كتاب نسب آل أبي طالب روى ابن أخي طاهر عنه " لم " والظاهر أنه ابن الحسن المتقدم على وجه، فتأمل.(@)(@@)(@@)(@@) $ 2811 - يحيى بن الحسين بن زيد بن علي بن الحسين، من أصحاب " ظم " عليه السلام واقفي " صه " " جخ ".(@)(@@)(@@)(@@) $ 2812 - يحيى بن حماد، قد ذكره " كش " في الريان بن الصلت. PageV01P369(@)(@@)(@@)(@@) $ 2813 - يحيى بن خالد، وفي " كش " عن كتاب محمد بن الحسن بن بندار بخطه حدثني الحسن بن أحمد المالكي، قال: حدثنا عبد الله بن طاووس، قال: قلت للرضا عليه السلام: ان يحيى بن خالد سم أباك " ظم " عليه السلام قال: نعم في ثلاثين رطبة.(@)(@@)(@@)(@@) $ 2814 - يحيى بن سليمان الكاتب " ضا " غير معروف الحال من 
ms269	 المدح والذم، فيترك حديثه.(@)(@@)(@@)(@@) $ 2815 - يحيى بن سماعة الخياط " ظم " وهو أيضا كسابقه غير منعوت بشئ من الوصفين، فيترك حديثه.(@)(@@)(@@)(@@) $ 2816 - يحيى بن العباس الوراق، من أصحاب الرضا عليه السلام مجهول " صه " " جخ " وقول " د " ومن أصحابنا من أثبته ابن عباس، وهو تحريف إشارة إلى بعض نسخ " صه " وهو من تحريف الكتاب.(@)(@@)(@@)(@@) $ 2817 - يحيى بن عبد الحميد، وفي " ست " بعده له كتاب، أخبرنا إلى أن ذكر محمد بن أيوب بن يحيى بن ضريس، والحسين بن علي بن مهزيار، عن يحيى بن عبد الحميد، وكذلك " جش " الا الحماني ويجئ إلى آخره، وزاد عنه به، وفي " تعق " مر في المفضل ماله دخل، واستظهر الشيخ أبو علي منهما كونه من الامامية، وفيه تأمل.(@)(@@)(@@)(@@) $ 2818 - يحيى بن عبد الله البصري " ظم " وهو كنظائره ممن لا يقبل حديثه فقاهة.(@)(@@)(@@)(@@) $ 2819 - يحيى بن عمرو " ضا " رأيت في بعض الحواشي للميرزا أنه قال قيل: إنه من ولد يحيى بن عمرو، ولكن الذي في نسخ " ق " عمر والد يحيى بن عمر بغير واو في الموضعين، فتدبر.(@)(@@)(@@)(@@) $ 2820 - يحيى بن عمران الهمداني " ضا " وفي " صه " يحيى بن عمران يونسي، وفي " تعق " في مشيخة " ق " ابن أبي عمران وقد سبق، وقد مر عن " تعق " انه هو الذي يروي عن يونس وعنه إبراهيم، فتأمل.(@)(@@)(@@)(@@) $ 2821 - يحيى بن عيسى، روى عنه الحسين بن سعيد. PageV01P370(@)(@@)(@@)(@@) $ 2822 - يحيى بن الفضل النوفلي " ظم ".(@)(@@)(@@)(@@) $ 2823 - يحيى بن المبارك " ضا " وهو كسابقه، كما لا يخفى على المتدرب.(@)(@@)(@@)(@@) $ 2824 - يحيى بن محمد " دي ".(@)(@@)(@@)(@@) $ 2825 - يحيى بن هاشم، كوفي قليل الحديث ثقة " صه " " جش " له كتاب، عنه إبراهيم بن سليمان " ست " " جش ".(@)(@@)(@@)(@@) $ 2826 - يحيى بن هرثمة، روي أنه كان من الحشوية ثم تشيع لما رأى من علي بن محمد بن الرضا عليهم السلام.(@)(@@)(@@)(@@) $ 2827 - يحيى بن يحيى الحنفي، له كتاب، عنه الحسن بن علي بن فضال " جش " " ست " وفي " مشكا " ابن يحيى الحنفي " عل " عن أخيه عن أبيه عنه.(@)(@@)(@@)(@@) $ 2828 - يحيى بن يحيى التميمي عامي " ظم " في نسخة وفي 
ms270	 أخرى في " ضا " كما نقله " د " وعن حاشية المجمع يحيى بن يحيى التميمي عامي " ضا " وفي الوجيزة ضعيف. والعجب من الميرزا أنه قال: لم أجده في " جخ " وفي نسخة من الوسيط ذكره عن " ظم " فتدبر.(@)(@@)(@@)(@@) $ 2829 - يحيى بن يزيد أبو خالد الكوفي " ضا " تقدم في نظائره ما يثمر هنا، وفي " تعق " مر بعنوان ابن زيد، والظاهر أنه هو الذي يروي عنه " ق " وليس في هذه الطبقة، اللهم الا أن يريد ابن الحسين بن زيد، فسقط الأب وذكر الجد، وقد أشرنا في طبقة مشايخ " ق " فلاحظ.(@)(@@)(@@)(@@) $ 2830 - يزداد " ج " كذا وجدته، لم أظفر على وصفه ولا على ذات أبيه ووصفه.(@)(@@)(@@)(@@) $ 2831 - يزيد بن إسحاق شعر ابن السحف الغنوي أبو إسحاق يلقب شعر له كتاب، الحميري عن أبيه عنه، روى " كش " أن يزيدا أنه كان منكرا لامامة الرضا عليه السلام وأن أخاه يقول بحياة " ظم " ثم رجع.(@)(@@)(@@)(@@) $ 2832 - يزيد بن خليفة، واقفي " ظم " وهذا غير ما يأتي في التالية عن " كش " و " جش " و " ق " فإنه على رواية في الكافي عنه " تعق " أنه من بني الحارث، والمذكور في " ق " أن الآتي ليس منهم، ولعل من وثقه في الوجيزة هو غير المذكور في PageV01P371(@)(@@) " ظم " إذ فيه ورد رواية يشعر بالذم بعكس من في " ق " فان فيه رواية مادحة، فراجع ولاحظ.(@)(@@)(@@)(@@) $ 2833 - يزيد بن سليط الزيدي، من أصحاب " ظم " عليه السلام " صه " " جخ " حديثه طويل " كش " " صه " عده المفيد في ارشاده من خاصة " ظم " عليه السلام وثقاته ومن الورع والعلم والفقه من شيعته، وفي الوجيزة وثقه المفيد.(@)(@@)(@@)(@@) $ 2834 - يزيد بن الصايغ، الظاهر أنه في هذه الطبقة " كشن " ذكر في بعض كتبه أن الكذابين المشهورين أبو الخطاب ويونس بن ظبيان ويزيد الصايغ ومحمد بن سنان أشهرهم " صه ".(@)(@@)(@@)(@@) $ 2835 - يزيد بن عمر ابن بنت عثمان " ضا " غير مقبول بالفقاهة.(@)(@@)(@@)(@@) $ 2836 - يعقوب بن إسحاق السكيت أبو يوسف، كان متقدما عند أبي جعفر الثاني عليه السلام وأبي الحسن عليه السلام قتله المتوكل لأجل التشيع وأمره مشهور، وكان عالما 
ms271	 بالعربية واللغة، ثقة مصدق لا يطعن عليه.(@)(@@)(@@)(@@) $ 2837 - يعقوب البجلي " دي ".(@)(@@)(@@)(@@) $ 2838 - يعقوب بن جعفر بن محمد " ظم ".(@)(@@)(@@)(@@) $ 2839 - يعقوب بن داود، ممن سعى بالكاظم عليه السلام وكان رأى رأي الزيدية، كذا ذكره في عيون أخبار الرضا عليه السلام.(@)(@@)(@@)(@@) $ 2840 - يعقوب بن سعيد الكندي " ضا ".(@)(@@)(@@)(@@) $ 2841 - يعقوب بن عبد الله بن جندب " ضا " غير معروف هو وكذلك السوابق الثلاثة، فلا يعتد بحديثهم متفردا.(@)(@@)(@@)(@@) $ 2842 - يعقوب بن منقوش " دي " " ري " لا أعتمد على ما يتفرد به.(@)(@@)(@@)(@@) $ 2843 - يعقوب بن نعيم بن قرقارة الكاتب أبو يوسف، كان جليلا في أصحابنا ثقة في الحديث روى عن الرضا عليه السلام " صه " " د ".(@)(@@)(@@)(@@) $ 2844 - يعقوب بن يقطين، من أصحاب الرضا عليه السلام ثقة " صه " " جخ " " د " وفي " تعق " هو أخو علي الجليل ومن أصحاب " ظم " عليه السلام وان روى PageV01P372(@)(@@) عن " ضا " أيضا وفي " مشكا " ابن يقطين الثقة، عنه ابن عيسى وابن أبي عمير والنضر والحسين وابن أبي الخطاب.(@)(@@)(@@)(@@) $ 2845 - يوسف بن السخت أبو يعقوب بصري " دي " ضعيف مرتفع القول استثناه القميون من نوادر الحكمة " صه " روى عن ابن جمهور، عنه محمد بن أحمد بن يحيى " لم " " غض ".(@)(@@)(@@)(@@) $ 2846 - يوسف بن عقيل البجلي، كوفي ثقة قليل الحديث، يقول القميون:(@)(@@) ان له كتابا، والظاهر أن الكتاب لمحمد بن قيس " صه " " جش " عنه محمد بن خالد البرقي " ست " " جش " ومحمد بن عيسى " ست ".(@)(@@)(@@)(@@) $ 2847 - يوسف بن محمد، عنه محمد بن أحمد بن يحيى بصري " لم ".(@)(@@)(@@)(@@) $ 2848 - يوسف بن محمد بن يعقوب من أصحاب " ظم " عليه السلام واقفي، وهو أخو يونس فطحي، وفي " تعق " يأتي كلام " ق " رحمه الله في أخيه يونس.(@)(@@)(@@)(@@) $ 2849 - يونس بن عبد الرحمن مولى علي بن يقطين، كان وجها في الأصحاب، ثقة متقدما عظيم المنزلة، وكان أبو الحسن عليه السلام يشير إليه في العلم والفتيا، وهو من أصحاب الاجماع، وروايات الذم مطروحة.(@)(@@)(@@)(@@) $ 2850 - يونس بن عبد الله، فطحي، روي عن الكاظم عليه السلام في تعظيمه والترحم عليه والشهادة له بحسن الخاتمة ما ينافي ذلك " د 
ms272	 " وقال الشيخ أبو علي بعد ما مر: لم أجده في كتب الرجال أصلا فتتبع، وكأنه اشتباه بابن يعقوب. أقول:(@)(@@) وهو كما ذكره فلاحظ، ولعله أخذه من الأسانيد فانظر.(@)(@@)(@@)(@@) $ 2851 - أبو أحمد الأزدي، كنية لابن أبي عمير، والتكنية به أشهر من هذه الكنية ومن اسمه محمد كأبيه زياد في طرق الروايات.(@)(@@)(@@)(@@) $ 2852 - أبو أحمد البصري، له كتاب، عنه إبراهيم بن سليمان " ست " وفي " تعق " يطلق على الجلودي وعمر بن الربيع الذي هو من أصحاب " ق " عليه السلام، ولا يخفى أن الأول في طبقة ابني قولويه، والثاني في التالية فلاحظهما.(@)(@@)(@@)(@@) $ 2853 - أبو أحمد البجلي، وهو محسن بن أحمد، وفي " تعق ". وصفه في الكنى PageV01P373(@)(@@) بالثقة الجليل، ثم احتمل كونه هو البصري المشار إليه، ولا يخلو من نظر، إذ البجلي من اليمن والبصري من البصرة، ولم يعلم النقل من هناك إليها، فتدبر.(@)(@@)(@@)(@@) $ 2854 - أبو أحمد القزويني، هو داود بن سليمان بن جعفر، في " مشكا " ابن سليمان بن جعفر القزويني الممدوح، عنه أبو علي الخزاز.(@)(@@)(@@)(@@) $ 2855 - أبو إسحاق إبراهيم بن هاشم القمي أبو علي صاحب التفسير (1).(@)(@@)(@@)(@@) $ 2856 - أبو إسحاق الأنماطي، هو إبراهيم بن صالح الثقة.(@)(@@)(@@)(@@) $ 2857 - أبو إسحاق الأهوازي، اسمه إبراهيم بن مهزيار، وقد مر في الأسماء ما يجوز أن يعول عليه في قبول روايته.(@)(@@)(@@)(@@) $ 2858 - أبو إسحاق بن هراسة، هو إبراهيم بن رجاء الشيباني المعروف بابن أبي هراسة.(@)(@@)(@@)(@@) $ 2859 - أبو الأسد، في رواية في " كش " أنه ممن روى عن الرضا عليه السلام وأنه خصي علي بن يقطين.(@)(@@)(@@)(@@) $ 2860 - أبو إسماعيل الكوفي، هو بكر بن الأشعث.(@)(@@)(@@)(@@) $ 2861 - أبو الأكراد الصائغ علي بن ميمون، من رجال " ق " و " ظم " عليهما السلام.(@)(@@)(@@)(@@) $ 2862 - أبو أيوب الأنباري المدني، تحول إلى بغداد، له كتاب، عنه أحمد بن أبي عبد الله " ست " " جش ".(@)(@@)(@@)(@@) $ 2863 - أبو أيوب المدني، عنه علي بن محمد ماجيلويه بكتابه " جش " وكأنه الأنباري المتقدم عن " ست ".(@)(@@)(@@)(@@) $ 2864 - أبو بحير عبد الله بن النجاشي، كما عن المجمع.(@)(@@)(@@)(@@) $ 2865 - أبو بكر بن أبي سمال، هو إبراهيم بن أبي سمال، 
ms273	 وقد مر في الأسماء واسم أبيه محمد بن الربيع، وهو وأخوه إسماعيل بن أبي سمال ثقتان عن الكاظم عليه(@)(@@) PageV01P374(@)(@@) السلام.(@)(@@)(@@)(@@) $ 2866 - أبو بكر بن أبي شيبه، له كتاب، عنه أحمد بن ميثم " ست " وفيه أيضا له كتاب الصلاة والفرائض، رواهما ابن حصين عنه.(@)(@@)(@@)(@@) $ 2867 - أبو بكر الفهفهكي " دي ".(@)(@@)(@@)(@@) $ 2868 - أبو بلال الأشعري مقل " جش " له كتاب، عنه إبراهيم بن سليمان " ست " " جش ".(@)(@@)(@@)(@@) $ 2869 - أبو ثمامة، لم يذكروه أصحاب الرجال منا الا ابن بابويه في أسانيد الفقيه، حيث روى عنه وبين الطريق إليه ولم يذكر اسمه ولا حاله، غير أنه صاحب أبي جعفر الثاني عليه السلام، ذكره الميرزا في " تعق " عده خالي حسنا.(@)(@@)(@@)(@@) $ 2870 - أبو جبل، من أصحاب الكاظم عليه السلام واقفي " صه " " جخ " " د " الا أن في الأخير، أبو حبل بالحاء المهملة والباء المفردة.(@)(@@)(@@)(@@) $ 2871 - أبو جرير القي " ظم " " ضا " ثقة وجه يروي عن الرضا عليه السلام وأبيه عليه السلام قيل: إنه روى عن أبي عبد الله عليه السلام ولكنه غير معلوم، وربما يقال: إنه ان روى عن الصادق عليه السلام فهو هذا، وان روى عنهما فمشترك (1).(@)(@@)(@@)(@@) $ 2872 - أبو الجعد أحمد بن عامر، وهو الذي ينتهي نسبه إلى وهب بن عامر المقتول في كربلاء معه عليه السلام.(@)(@@)(@@)(@@) $ 2873 - أبو جعدة، من أصحاب الكاظم عليه السلام واقفي " صه " " جخ " لم أقف على اسمه.(@)(@@)(@@)(@@) $ 2874 - أبو جعفر الأزرق محمد بن فضيل، ويقال له: الأزدي الكوفي وقد مضى في الأسماء ما لا بد أن يلاحظ.(@)(@@)(@@)(@@) $ 2875 - أبو جعفر البجلي الخزاز محمد بن الوليد، روى عن يونس بن(@)(@@) PageV01P375(@)(@@) يعقوب وحماد ومن في طبقتهما، وعمر حتى لقيه الصفار وسعد.(@)(@@)(@@)(@@) $ 2876 - أبو جعفر البصري " ج " روى " كش " عن القتيبي عن " فض " قال: حدثني أبو جعفر البصري وكان ثقة فاضلا صالحا " صه " لم أظفر على اسمه.(@)(@@)(@@)(@@) $ 2877 - أبو جعفر الزاهري محمد بن سنان.(@)(@@)(@@)(@@) $ 2878 - أبو جعفر السراج أحمد بن أبي بشير.(@)(@@)(@@)(@@) $ 2879 - أبو جعفر السقاء الأحول المنجم، وكان لقى الرضا عليه السلام رآه التلعكبري بدسكرة الملك سنة 
ms274	 أربعين وثلاثمائة ووصف له الرضا عليه السلام وحكى حكايته " لم " أقول: وبعده غير خفي.(@)(@@)(@@)(@@) $ 2880 - أبو جعفر السكوني أحمد بن محمد بن أبي نصر البزنطي، وقيل:(@)(@@) أبو علي ويقال له: أبو عبد الله أيضا.(@)(@@)(@@)(@@) $ 2881 - أبو جعفر شاه طاق، له كتاب، عنه أحمد بن زيد الخزاعي " ست " قال الميرزا: الظاهر أنه أبو جعفر مؤمن الطاق انتهى. وفيه بعد إذا لم يوصف به في اسمه، ومع فرض الاتحاد فهو في التالية.(@)(@@)(@@)(@@) $ 2882 - أبو جعفر الصبيحي، من قصبة صبيح حمدان بن المعافا.(@)(@@)(@@)(@@) $ 2883 - أبو جعفر الصيرفي الهمذاني بالذال المعجمة محمد بن علي بن إبراهيم بن موسى القرشي.(@)(@@)(@@)(@@) $ 2884 - أبو جعفر الطبري الجبلي محمد بن أسلم.(@)(@@)(@@)(@@) $ 2885 - أبو جعفر الطبري الخاصي محمد بن الحسين بن سعيد بن عبد الله، لم أقف عليه، والظاهر أنه في هذه الطبقة.(@)(@@)(@@)(@@) $ 2886 - أبو جعفر العنبري البصري محمد بن صدقة.(@)(@@)(@@)(@@) $ 2887 - أبو جعفر الكرخي محمد بن أحمد بن عبد الله، ويقال لمحمد بن عبد الله مهران أيضا في هذه الطبقة، وكذا لأحمد بن عبد الله بن مهران المعروف بابن خانبة، ويظهر من تعق اتحاده مع السابق فتأمل.(@)(@@)(@@)(@@) $ 2888 - أبو جعفر الكوفي محمد بن عبد الحميد. PageV01P376(@)(@@)(@@)(@@) $ 2889 - أبو جعفر مولى المنصور محمد بن إسماعيل بن بزيع.(@)(@@)(@@)(@@) $ 2890 - أبو جعفر الميثمي الأسدي محمد بن الحسن بن زياد.(@)(@@)(@@)(@@) $ 2891 - أبو جنادة الأعمى واقفي " صه " عنه ابن أبي الخطاب بكتابه " جش " وفي " تعق " اسمه الحصين بن مخارق، وفي المجمع جعل للأعمى ترجمة، وللمسمى بالحصين ترجمة على حدة.(@)(@@)(@@)(@@) $ 2892 - أبو الحسن بن الحصين ينزل الأهواز ثقة " دي " ويأتي عن " صه " و " ج " أبو الحصين، واستصوبه الميرزا، والله أعلم به.(@)(@@)(@@)(@@) $ 2893 - أبو الحسن بن علي بن بلال " دي " كذا وجدته من دون التعرض للاسم.(@)(@@)(@@)(@@) $ 2894 - أبو الحسن الكوفي علي بن عمر.(@)(@@)(@@)(@@) $ 2895 - أبو الحسن الليثي، له كتاب، عنه هارون بن مسلم " ست " والسند فيه ابن أبي جيد، عن محمد بن الحسن، عن عبد الله بن جعفر الحميري، عن هارون، عنه.(@)(@@)(@@)(@@) $ 2896 - أبو الحسن المكفوف، 
ms275	 هو علي بن خليد، وقد تقدم أنه لا بأس به.(@)(@@)(@@)(@@) $ 2897 - أبو الحسن النهدي، له كتاب، عنه محمد بن علي بن محبوب " ست " " جش ".(@)(@@)(@@)(@@) $ 2898 - أبو الحسين النخعي أيوب بن نوح بن دراج الثقة، وقد تقدم في الأسماء.(@)(@@)(@@)(@@) $ 2899 - أبو الحسين بن هلال، من أصحاب أبي الحسن الثالث عليه السلام ثقة " صه " " جخ ".(@)(@@)(@@)(@@) $ 2900 - أبو الحصين الأسدي، له كتاب، عنه القاسم بن إسماعيل " ست " قال الشيخ أبو علي: هو زجر بن عبد الله، وقد مضى موثقا، والظاهر غفلة الميرزا عن ذلك (1). أقول: ويأتي في الأسماء في التاليين ما ينبغي أن يلاحظ.(@)(@@) PageV01P377(@)(@@)(@@)(@@) $ 2901 - أبو الحصين بن الحصين الحصيني، من أصحاب أبي جعفر الجواد عليه السلام ثقة " صه " " جخ " وهو أيضا من أصحاب أبي الحسن الثالث عليه السلام وقد مر عن " دي " بالسين.(@)(@@)(@@)(@@) $ 2902 - أبو حفص الرماني، له كتاب، عنه القاسم بن إسماعيل " ست " واسمه عمر، وهو الثقة كما ذكره بعض الأعاظم.(@)(@@)(@@)(@@) $ 2903 - أبو حمزة مولى الرضا عليه السلام " ضا ".(@)(@@) مر عن " دي " بالسين.(@)(@@)(@@)(@@) $ 2904 - أبو حيون، له كتاب الملاحم أي الفتن، عنه أحمد بن أبي عبد الله " ست " " جش " " لم ".(@)(@@)(@@)(@@) $ 2905 - أبو خالد الذيال مجهول " صه " " د " " لم ".(@)(@@)(@@)(@@) $ 2906 - أبو خالد الزبالي، من أهل زبالة " ظم " وعن الكافي في مولد أبي الحسن موسى عليه السلام ما يدل على حسن عقيدته ومحبته.(@)(@@)(@@)(@@) $ 2907 - أبو خالد السجستاني " ضا " قيل: إنه لما مضى أبو الحسن عليه السلام وقف عليه ثم نظر في نجومه، فزعم أنه قد مات، فقطع على موته وخالف أصحابه " كش " عنه " صه ".(@)(@@)(@@)(@@) $ 2908 - أبو خالد الكوفي " ضا " اسمه غير مذكور وكذا وصفه.(@)(@@)(@@)(@@) $ 2909 - أبو خالد مولى علي بن يقطين، روى عنه عن أبي الحسن عليه السلام أنه ليس على مفرد الحج طواف النساء، وهو خلاف الاجماع، فتأمل، هكذا ذكره الميرزا، وللبحث فيه محل آخر.(@)(@@)(@@)(@@) $ 2910 - أبو خداش المهري بصري " ج " تقدم في الأسماء أنه عبد الله بن خداش، وقد مر الاختلاف فيه.(@)(@@)(@@)(@@) $ 2911 - أبو الخزرج هو الحسن بن الزبرقان، أو أخوه 
ms276	 الحسين، ويقال أيضا لطلحة بن زيد النهدي، ولكنه في الطبقة التالية.(@)(@@)(@@)(@@) $ 2912 - أبو داود المسترق هو المنشد، اسمه سليمان بن سفيان " صه " وقد PageV01P378(@)(@@) تقدم. وما روى محمد بن يعقوب الكليني عن أبي داود عن الحسين بن سعيد فليس بالمسترق قطعا، فإنه: اما في هذه الطبقة، أو السابقة، أو في طبقة أصحاب " قر " بملاحظة تاريخ الوفاة.(@)(@@)(@@)(@@) $ 2913 - أبو راشة المتطبب " دي " وعن نسخة ابن راشنة بالنون.(@)(@@)(@@)(@@) $ 2914 - أبو رويم الأنصاري، قال " عق ": انه ضعيف الامر " صه ".(@)(@@)(@@)(@@) $ 2915 - أبو زكريا الأعور، ثقة من أصحاب الكاظم عليه السلام روى عنه علي بن رباط " صه " " جخ " وفي " مشكا " أبو زكريا الأعور الثقة، عنه علي بن رباط، ومحمد بن عيسى بن عبيد.(@)(@@)(@@)(@@) $ 2916 - أبو زيد الرطاب، له كتاب الدلائل، عنه علي بن الحسن " ست " ولعله في السابقة أيضا.(@)(@@)(@@)(@@) $ 2917 - أبو زيد المكي، من أصحاب " ضا " عليه السلام مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2918 - أبو سارة " ج " لم أقف على غير العنوان، والله أعلم.(@)(@@)(@@)(@@) $ 2919 - أبو سالم طالب بن هارون " تعق ".(@)(@@)(@@)(@@) $ 2920 - أبو سجاج الأنصاري " ضا ".(@)(@@)(@@)(@@) $ 2921 - أبو سعيد، له كتاب الطهارة " ست " عنه أحمد بن محمد بن عيسى " ست " " لم " والظاهر تشيعه ورواية جماعة كما في طريق " ست " تشير إلى القبول، مضافا إلى رواية أحمد بن محمد بن عيسى عنه، فالرجل من الحسان.(@)(@@)(@@)(@@) $ 2922 - أبو سعيد الخراساني، مجهول من أصحاب الرضا عليه السلام " صه " " جخ ".(@)(@@)(@@)(@@) $ 2923 - أبو سكينة كوفي " ج " لم أقف على اسمه.(@)(@@)(@@)(@@) $ 2924 - أبو سلمة قيل: اسمه خلف بن خلف اللفايفي، خادم أبي الحسن عليه السلام " ظم ".(@)(@@)(@@)(@@) $ 2925 - أبو سليمان، له كتاب، عنه ابن نهيك " ست ". PageV01P379(@)(@@)(@@)(@@) $ 2926 - أبو سليمان الجبلي " لم " " جش " " ست " له كتاب، عنه أحمد بن أبي عبد الله " جش ".(@)(@@)(@@)(@@) $ 2927 - أبو السمهري، قال إسحاق الأنباري قال لي أبو جعفر الثاني عليه السلام: ما فعل أبو السمهري لعنه الله يكذب علينا ويزعم أنه وابن أبي الزرقاء دعاة إلينا الحديث.(@)(@@)(@@)(@@) $ 2928 - أبو سمينة، اسمه محمد بن علي بن إبراهيم القرشي ضعيف " صه " ويقال: محمد 
ms277	 بن علي الصيرفي أيضا.(@)(@@)(@@)(@@) $ 2929 - أبو شعيب المحاملي، كوفي ثقة، من أصحاب الكاظم عليه السلام " صه " " جش " مولى علي بن الحكم الأنباري " جش " له كتاب، عنه ابن معروف اسمه صالح بن خالد كما تقدم.(@)(@@)(@@)(@@) $ 2930 - أبو الصلت الخراساني المروي، عامي من أصحاب الرضا عليه السلام روى عنه بكر بن صالح " صه " " جخ " اسمه عبد السلام، وقد مر أنه ثقة صحيح الحديث عظيم الشأن.(@)(@@)(@@)(@@) $ 2931 - أبو الصهبان اسمه عبد الجبار ابنه محمد يقال له: ابن أبي الصهبان وابن عبد الجبار، وقد تقدم اسمه في عنوان ابنه في السابقة، والظاهر أن أباه ليس من الاحداث لم أجده في الرجال، والله أعلم.(@)(@@)(@@)(@@) $ 2932 - أبو طاهر بن حمزة بن اليسع الأشعري، قمي ثقة، من أصحاب الهادي عليه السلام " صه " " جخ " أخو أحمد، روى عن الرضا عليه السلام، قمي روى عن أبي الحسن الثالث عليه السلام نسخة عنه أحمد واسمه محمد " جش " ويحتمل سقوط كلمة أبوه قبل الرضا من " جش " كما استظهره البعض ببعض التقريبات فلاحظ.(@)(@@)(@@)(@@) $ 2933 - أبو طاهر محمد وأبو الحسن وأبو الطيب بنو علي بن بلال " دي ".(@)(@@)(@@)(@@) $ 2934 - أبو الطيب علي بن بلال " دي ".(@)(@@)(@@)(@@) $ 2935 - أبو طيفور المتطبب، له ابن اسمه محمد من رجال " دي " عليه PageV01P380(@)(@@) السلام.(@)(@@)(@@)(@@) $ 2936 - أبو عامر بن جناح، تقدم مع أخيه جناح، وهما ثقتان.(@)(@@)(@@)(@@) $ 2937 - أبو العباس صاحب عمار بن مروان، عنه أحمد بن أبي عبد الله " لم " " جش " بكتابه، له كتاب أحمد بن أبي عبد الله عن أبيه عنه " ست " وهو في التالية.(@)(@@)(@@)(@@) $ 2938 - أبو عبد الرحمن الكندي، قال " فش " ان من الكذابين المشهورين علي بن حسكة، والعباس بن صدقة، وأبا العباس الطيرناني، وأبا عبد الرحمن الكندي المعروف بشاه رئيس، وهو من الغلاة. أقول: قد مر في شاه رئيس أن كنيته أبو عبد الله، وهذا غفلة منهم الا مع الاتحاد.(@)(@@)(@@)(@@) $ 2939 - أبو عبد الله الباقطاني، يأتي في آخر الكتاب عن " صه " أنه من وجوه الشيعة وأكابرها " تعق " أقول: لم أقف على اسمه وذكره هنا ليس على التحقيق.(@)(@@)(@@)(@@) $ 2940 
ms278	 - أبو عبد الله البرقي محمد بن خالد بن عبد الرحمن.(@)(@@)(@@)(@@) $ 2941 - أبو عبد الرحمن العرزمي، له كتاب " ست " عنه أحمد بن أبي عبد الله " جش " " ست " " لم ".(@)(@@)(@@)(@@) $ 2942 - أبو عبد الرحمن المسعودي " لم " " ست " له كتاب، عنه محمد بن موسى الملقب خورا، ويروي حميد عن خورا، فهو في هذه الطبقة بملاحظة الراوي والمروي عنه.(@)(@@)(@@)(@@) $ 2943 - أبو عبد الله بن أبي الحسين " دي ".(@)(@@)(@@)(@@) $ 2944 - أبو عبد الله الجاموراني، عنه أحمد بن أبي عبد الله " ست " " جش " " لم " بكتابه، وعنه أيضا محمد بن أحمد بن يحيى، اسمه محمد بن أحمد وفي " صه " الرازي الجاموراني ضعيف.(@)(@@)(@@)(@@) $ 2945 - أبو عبد الله الجرجاني، فتح بن يزيد، كان خارجيا ثم رجع إلى التشيع بعد أن كان بايع على الخروج واظهاره السيف كما في " صه " وفي " مشكا " روى عن " ضا " و " دي " عليهما السلام عنه ابن أبي عبد الله، والمختار بن بلال.(@)(@@)(@@)(@@) $ 2946 - أبو عبد الله الرازي، هو المتقدم بعنوان الجاموراني. PageV01P381(@)(@@)(@@)(@@) $ 2947 - أبو عبد الله اللاحقي، محمد بن عبد الله بن عمرو بن سالم بن لاحق " تعق ".(@)(@@)(@@)(@@) $ 2948 - أبو عبد الله المؤمن، هو زكريا بن محمد المغازي، عنه محمد بن عيسى، تقدم في الأسماء، وهو غال " دي " وفي " تعق " في النقد يحتمل أن يكون اسمه محمد بن إسحاق صاحب المغازي.(@)(@@)(@@)(@@) $ 2949 - أبو عبد الله المغازي غال " دي ".(@)(@@)(@@)(@@) $ 2950 - أبو عبد الله المكاري " دي ".(@)(@@)(@@)(@@) $ 2951 - أبو العلاء الحضرمي.(@)(@@)(@@)(@@) $ 2952 - أبو علي الأشعري، اسمه محمد بن عيسى بن عبد الله بن سعد بن مالك شيخ القميين " صه " وقد تقدم.(@)(@@)(@@)(@@) $ 2953 - أبو علي الأراجني، هارون بن عبد العزيز.(@)(@@)(@@)(@@) $ 2954 - أبو علي الحراني، أحمد بن محمد بن خالد عن أبيه عنه بكتابه " جش " عنه أحمد بن أبي عبد الله " ست " وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 2955 - أبو علي بن راشد، كان وكيلا مقام الحسين بن عبد ربه مع ثناء وشكر " صه " " طس " أو مقام علي بن الحسين بن عبد ربه لاختلاف الاخبار في ذلك، على أن الترك أقرب من الزيادة، واسمه الحسن 
ms279	 بن راشد وفي " كش " ما ينبغي أن يلاحظ.(@)(@@)(@@)(@@) $ 2956 - أبو علي العلوي وأخوه أبو الحسين اسمه محمد بن محمد بن يحيى من بني زبارة معروفان جليلان من أهل نيسابور " لم " " صه " وفي الوجيزة " ح " وفي الحاوي ذكره في الضعاف، وهو بعيد.(@)(@@)(@@)(@@) $ 2957 - أبو علي القطان " ضا " وفي المنتهى هو الحسن بن محمد، وغفل عنه الميرزا.(@)(@@)(@@)(@@) $ 2958 - أبو علي المحمودي، اسمه محمد بن أحمد بن حيان.(@)(@@)(@@)(@@) $ 2959 - أبو علي الهاشمي داود بن علي اليعقوبي " غين " كذا في المنتهى. PageV01P382(@)(@@)(@@)(@@) $ 2960 - أبو عمار الطحان، له روايات، عنه أحمد بن ميثم " ست ".(@)(@@)(@@)(@@) $ 2961 - أبو عمر الحذاء " دي " وعن نسخة أبو عمرو مع الواو، ولعل الأول أصح.(@)(@@)(@@)(@@) $ 2962 - أبو عمران الأرمني ضعيف، اسمه موسى بن رنجويه، قد تقدم.(@)(@@)(@@)(@@) $ 2963 - أبو غسان الذهلي، له كتاب، عنه القاسم بن إسماعيل " ست " اسمه حميد بن راشد، وقد تقدم.(@)(@@)(@@)(@@) $ 2964 - أبو عمارة الحارثي جعفر بن عمارة ضعيف، وهو " غين " في المنتهى.(@)(@@)(@@)(@@) $ 2965 - أبو عمرو العمري، عثمان بن سعيد " تعق ".(@)(@@)(@@)(@@) $ 2966 - أبو عمرو الكلابي العامري، عثمان بن عيسى " غين " في المنتهى.(@)(@@)(@@)(@@) $ 2967 - أبو غسان النهدي، له كتاب، عنه ابن نهيك " ست " وعن مختصر الذهبي من كتب رجال العامة: مالك بن إسماعيل أبو غسان النهدي الحافظ، عنه البخاري، توفى سنة تسع عشر ومائتين.(@)(@@)(@@)(@@) $ 2968 - أبو الفضل التميمي عبد الرحمن بن أبي نجران.(@)(@@)(@@)(@@) $ 2969 - أبو الفضل الخراساني " ضا " روى " كش " عن معد عن حمدان عن معاوية عنه، وكان له انقطاع إلى أبي الحسن عليه السلام وكان يخالط القراء ثم انقطع إلى أبي جعفر عليه السلام الا أن حمدان ضعيف، ولا يخلو من كونه مرجحا.(@)(@@)(@@)(@@) $ 2970 - أبو الفضل الكفرثوثي، إدريس بن زياد.(@)(@@)(@@)(@@) $ 2971 - أبو الفضل الناشري، عباس بن هشام.(@)(@@)(@@)(@@) $ 2972 - أبو الفضل الوراق، العباس بن موسى، من أصحاب يونس.(@)(@@)(@@)(@@) $ 2973 - أبو القاسم، يقال لعبد الرحمن بن حماد، كما مر في إبراهيم بن أبي البلاد، ويروي عنه محمد بن عبد الجبار " تعق ".(@)(@@)(@@)(@@) $ 2974 - أبو القاسم، يقال لعبد الرحمن بن أبي حماد، كما مضى في 
ms280	 ترجمته، قال في المنتهى: وما في ترجمة إبراهيم المذكور فالظاهر سقط " أبي " قبل حماد. أقول:(@)(@@) يظهر منه اتحاده مع الأول، والتغاير ممكن. PageV01P383(@)(@@)(@@)(@@) $ 2975 - أبو مالك، محمد بن حمزة العنزي مجمع " تعق " الا العنزي وابن حمزة في هذه الطبقة معد وغير مذكور الكنية.(@)(@@)(@@)(@@) $ 2976 - أبو محمد بن إبراهيم " دي ".(@)(@@)(@@)(@@) $ 2977 - أبو محمد الأزدي، مرازم بن حكيم.(@)(@@)(@@)(@@) $ 2978 - أبو محمد الأسدي صاحب أبي مريم، له كتاب، أحمد بن أبي عبد الله عن أبيه عنه " ست " (@)(@@)(@@)(@@) $ 2979 - أبو محمد الأسود، صاحب أبي مريم الأنصاري، ابن بطة عن البرقي عن أبيه عنه " جش " تقدم عن " ست " الأسدي، والتغاير محتمل، فتأمل.(@)(@@)(@@)(@@) $ 2980 - أبو محمد الأنصاري، يروي عنه العبيدي، وعبد الله بن إبراهيم، مجهول لا يعرف. وقيل: كان خيرا فالتوقف أولى.(@)(@@)(@@)(@@) $ 2981 - أبو محمد البجلي، عبد الله بن المغيرة، وصفوان بن يحيى.(@)(@@)(@@)(@@) $ 2982 - أبو محمد البجلي الوشاء، الحسن بن علي، وجعفر بن بشير.(@)(@@)(@@)(@@) $ 2983 - أبو محمد التفليسي، من أصحاب الرضا عليه السلام مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2984 - أبو محمد التيملي، الحسن بن علي بن فضال " غين " في المنتهى.(@)(@@)(@@)(@@) $ 2985 - أبو محمد الحجال، له كتاب، أحمد بن أبي عبد الله عن أبيه عنه " ست " اسمه عبد الله بن محمد.(@)(@@)(@@)(@@) $ 2986 - أبو محمد الدريري دينوري " ضا ".(@)(@@)(@@)(@@) $ 2987 - أبو محمد الزبيري، عبد الله بن هارون، مجمع عنه المنتهى.(@)(@@)(@@)(@@) $ 2988 - أبو محمد العلوي، كان من عباد الله الصالحين، كما في الحديث، ذكره صاحب الاحتجاج، قد تلمذ عند أبي الطيب الرازي. ولا يخفى ما فيه، فان أبا الطيب أستاد أبي محمد العلوي المعروف بابن طاهر وهو في طبقة التلعكبري ومشايخه وهو في هذه الطبقة، إذ يروي التلعكبري عنه بواسطتين، ومع ذلك فهو في السابقتين أقرب. PageV01P384(@)(@@)(@@)(@@) $ 2989 - أبو محمد القزويني " ضا ".(@)(@@)(@@)(@@) $ 2990 - أبو محمد الكوفي " ضا " ويأتي لعمران بن مسكان، وعبد الله بن الوضاح، والحسن بن طريف بن ناصح، وبكر بن جناح، والأول في السابقة، والثاني في هذه الطبقة، كالثالث والرابع في التالية، فلاحظ.(@)(@@)(@@)(@@) $ 2991 - أبو محمد المشهدي البجلي " ضا ".(@)(@@)(@@)(@@) $ 2992 - أبو مساور 