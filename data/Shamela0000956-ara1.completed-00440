ms421	(@)(@@)(@@)(@@) $ 2824 - حجاج عن الشعبي، سمع منه إسماعيل بن أبي خالد قوله.(@)(@@)(@@)(@@) $ 2825 - حجاج بن السائب بن أبي لبابة بن عبد المنذر الأنصاري المديني، عن أبيه عن جدته الخنساء بنت خذام، قاله محمد بن سعيد أخبرنا عبد الرحيم عن ابن إسحاق، حدثني محمد بن عبيد قال ثنا محمد بن سلمة عن ابن إسحاق عن حجاج بن السائب بن أبي لبابة قال: كانت خنساء بنت خذام آمت من زوجها، فقال النبي صلى الله(@)(@@) عليه وسلم لأبيها: الحقها بهواها فولدت السائب أبا صاحب هذا الحديث، وروى الزهري عن أخيه حسين.(@)(@@)(@@)(@@) $ 2826 - حجاج بن أبي مجلز قوله - قاله عبدة حدثني عبد الصمد قال ثنا حمام قال ثنا قتادة قال ثنا حجاج.(@)(@@)(@@)(@@) $ 2827 - حجاج بن أبي يزيد، عن مجاهد، روى عنه الثوري، مرسل.(@)(@@)(@@)(@@) $ 2828 - حجاج بن أبي يونس، عن طاوس روى عنه هشام بن حسان قوله.(@)(@@)(@@)(@@) $ 2829 - حجاج بن أبي زينب أبو يوسف الواسطي السلمي الصيقل (1) ، قال محمد بن المثنى ثنا يزيد بن هارون قال: أخبرنا حجاج PageV00P000(@)(@@) ابن أبي زينب عن أبي عثمان النهدي عن أبي هريرة عن النبي صلى الله عليه وسلم قال: جعل الله الرحمة مائة رحمة، وقال خليفة حدثنا بشر بن المفضل ومعتمر سمعا التيمي، سمع أبا عثمان عن سلمان عن النبي صلى الله عليه وسلم - نحوه، وقال موسى بن إسماعيل ثنا عبد الواحد سمع عاصما عن أبي عثمان قال [عن - 1] سلمان: أنا نجد في التوراة - نحوه، وقال عبد الله بن عثمان أخبرنا يزيد بن زريع عن داود عن أبي عثمان أراه عن سلمان - قوله، وقال ابن عثمان أخبرنا عبد الله عن الجريري عن أبي عثمان عن سلمان - قوله، وقال ابن عثمان أخبرنا نوح بن قيس عن أشعث بن جابر عن أبي عثمان عن سلمان - قوله، كناه يزيد، سمع أبا عثمان وأبا سفيان، سمع منه هشيم ومحمد بن الحسن الواسطي.(@)(@@)(@@)(@@) $ 2830 - حجاج بن شداد (2) الصنعانى (3) سمع ابا صالح سعيدا الغفاري روى عنه حيوة، يعد في المصريين.(@)(@@)(@@)(@@) $ 2831 - حجاج أبو خليفة بن عتاب 
ms422	 (4) العبدي البصري، قال موسى عن محمد بن سليم عن أبي خليفة عن عبد الله بن معبد الزمانى PageV00P000(@)(@@) عن أبي هريرة: أدنى أهل الجنة يروح عليه عشرة آلاف (1) خادم، هو والد عمر بن أبي خليفة.(@)(@@)(@@)(@@) $ 2832 - حجاج الوراق، روى عنه معتمر.(@)(@@)(@@)(@@) $ 2833 - حجاج بن أبي عيينة، عن هند بنت المهلب روى عنه حماد بن زيد وسعيد بن عامر، منقطع، يعد في البصريين، هو ابن المهلب (2) ، المهلبي أخو محمد بن أبي عيينة.(@)(@@)(@@)(@@) $ 2834 - حجاج بن زيد السامي القرشي البصري، سمع أبا المتوكل قوله، روى عنه عرعرة (3) .(@)(@@)(@@)(@@) $ 2835 - حجاج بن أرطاة أبو أرطاة الكوفي النخعي، سمع عطاء، سمع منه شعبة والثوري قال ابن المبارك: كان الحجاج يدلس يحدثنا (4) عن عمرو بن شعيب بما يحدث محمد العرزمي، والعرزمي(@)(@@) متروك لا نقربه.(@)(@@)(@@)(@@) $ 2836 - حجاج بن عبد الله الحميري، عن بكير بن الأشج، روى عنه الليث. PageV00P000(@)(@@)(@@)(@@) $ 2837 - حجاج بن حسان التيمي (1) ، سمع أبا محمد الحنفي، سمع منه يحيى بن سعيد ويزيد بن هارون وموسى بن إسماعيل، وسمع عكرمة وعبد الله بن بريدة وأنس بن مالك، يعد في البصريين، قال أحمد هو العيشي، وقال عبد الصمد هو العائشي يقال: العيشي من تيم الله بن (2) ثعلبة، أراه من ربيعة حدثني إسحاق قال ثنا أبو عاصم قال ثنا حجاج بن حسان التيمي.(@)(@@)(@@)(@@) $ 2838 - حجاج بن عاصم قاضي الكوفة (3) المحاربي.(@)(@@)(@@)(@@) $ 2839 - حجاج بن صفوان المدينى (4) . PageV00P000(@)(@@)(@@)(@@) $ 2840 - حجاج بن محمد الأعور المصيصي وأصله ترمذي، سمع ابن جريج (1) وشعبة قال أحمد: مات حجاج ويزيد بن هارون سنة ست ومائتين، يقال مولى سليمان بن مجالد مولى أبي جعفر الهاشمي، قال الفضل: مات سنة خمس ومائتين ببغداد، أبو محمد.(@)(@@)(@@)(@@) $ 2841 - حجاج بن المنهال أبو محمد الأنماطي البصري، سمع شعبة وحماد بن سلمة، مات سنة سبع عشرة ومائتين.(@)(@@)(@@)(@@) $ 2842 - حجاج بن إبراهيم الأزرق أبو محمد، سكن طرسوس وسمع ابن وهب - قاله عبد العزيز.(@)(@@)(@@)(@@) $ 2843 - حجاج بن أبي منيع (2) الشامي سمع جده عبيد الله ابن أبي زياد، عن الزهري أخبرني عقبة بن سويد سمع أباه: أقبلنا 
ms423	 مع رسول الله صلى الله عليه وسلم من غزوة حنين فلما بدا له أحد قال:(@)(@@) الله أكبر جبل يحبنا ونحبه - قاله عمرو بن محمد.(@)(@@)(@@)(@@) $ 2844 - حجاج بن عبيد (3) .(@)(@@)(@@)(@@) $ 2845 - حجاج بن نصير أبو محمد الفسطاطي البصري (4) عن شعبة، يتكلم فيه بعضهم، مات سنة ثلاث أو أربع عشرة ومائتين. PageV00P000(@)(@@)(@@)(@@) || باب حسين(@)(@@)(@@)(@@) $ 2846 - حسين بن علي بن أبي طالب أبو عبد الله الهاشمي، وقال أحمد بن سليمان عن عطاء بن مسلم عن الأعمش: قتل الحسين وهو ابن تسع (1) وخمسين، وقال أبو نعيم: قتل الحسين يوم عاشوراء، وقال فروة بن أبي المغراء عن القاسم بن مالك عن عاصم بن كليب عن أبيه قال: رأيت النبي صلى الله عليه وسلم في المنام فذكرته لابن عباس فقال: أذكرت حسين بن علي حين رأيته؟ قلت: نعم، والله! ذكرت (2) تكفيه حين رأيته يمشي قال: إنا كنا نشبهه بالنبي صلى الله عليه وسلم، وقال عبد الله بن محمد ومحمد بن الصلت قالا حدثنا سفيان ابن عيينة عن جعفر بن محمد عن أبيه، قال: قتل حسين بن علي وهو ابن ثمان وخمسين.(@)(@@)(@@)(@@) $ 2847 - حسين بن علي بن حسين بن علي بن أبي طالب الهاشمي المدني أخو عمر ومحمد، سمع وهب بن كيسان سمع منه ابن المبارك.(@)(@@)(@@)(@@) $ 2848 - حسين بن علي أبو عبد الله مولى الجعفيين الكوفي، سمع القاسم بن الوليد وزائدة وأخاه الوليد، قال أحمد بن أبي رجاء: مات سنة ثلاث ومائتين.(@)(@@)(@@)(@@) $ 2849 - حسين بن عبد الرحمن الأشجعي، وقال بعضهم PageV00P000(@)(@@) عبد الرحمن بن حسين (1) عن سعد.(@)(@@)(@@)(@@) $ 2850 - حسين بن الحارث الجدلي أبو القاسم، سمع الحارث ابن حاطب وابن عمرو النعمان بن بشير وعبد الرحمن بن زيد بن الخطاب، سمع منه أبو مالك الأشجعي وحجاج وزكريا، يعد في الكوفيين.(@)(@@)(@@)(@@) $ 2851 - حسين بن بشير بن سلمان مولى صفية بنت عبد الرحمن عن أبيه، روى عنه خارجة بن عبد الله.(@)(@@)(@@)(@@) $ 2852 - حسين بن خارجة (2) ، سمع سعدا - قوله، قال أبو معمر حدثنا عبد الوارث قال ثنا ابن جحادة عن نعيم بن أبي هند 
ms424	 عن أبي حازم (3) .(@)(@@)(@@)(@@) $ 2853 - حسين بن أبي سفيان السلمى، سمع انسا، روى عنه PageV00P000(@)(@@) عبد الرحمن بن إسحاق أبو شيبة (1) ، حديثه فيه نظر.(@)(@@)(@@)(@@) $ 2854 - حسين بن شفي بن ماتع الأصبحي المصري، سمع عبد الله بن عمرو وتبيعا، روى عنه النعمان بن عمرو وحيوة، قال عبد الله بن يزيد حدثنا سعيد بن أبي أيوب حدثني النعمان بن عمرو بن خالد عن حسين بن شفي قال: كنا عند عبد الله بن عمرو فأقبل تبيع، فقال عبد الله: أتاكم أعلم من عليها.(@)(@@)(@@)(@@) $ 2855 - حسين أبو سفيان بن حسين (2) الواسطي السلمى قال: املى على الحسن (3) كتاب (4) ، كناه شعبة وهاشم بن البريد (5) PageV00P000(@)(@@) وسمع أنسا (1) ويقال حسين بن حسن.(@)(@@)(@@)(@@) $ 2856 - حسين الأيلي (2) عن ابن شهاب، روى عنه (3) ابن أبي ذئب، مرسل.(@)(@@)(@@)(@@) $ 2857 - حسين بن رستم الأيلي، سمع محمد بن المنكدر، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) $ 2858 - حسين بن حازم، رأى عمر بن عبد العزيز بالمدينة، قال إبراهيم بن حمزة سمع الدراوردي: (4) ، وقال محمد بن صالح بن عمر حدثنا حسين بن حازم: وقف علينا عمر بن عبد العزيز ونحن نبيع البز.(@)(@@)(@@)(@@) $ 2859 - حسين بن أبي عائشة، عن أبي خالد الوالبي، روى عنه عمران بن زائدة (5) . PageV00P000(@)(@@)(@@)(@@) $ 2860 - حسين بن ميمون الخندقى (1) أو الجندي، عن أبي الجنوب الأسدي، روى عنه عبد الرحمن بن غسيل قال ابن نمير عن محمد ابن عبيبد عن هاشم بن بريد عن حسين بن ميمون عن عبد الله بن عبد الله قاضي الري عن ابن أبي ليلى قال: سمعت عليا قال: سألت النبي صلى الله عليه وسلم أن يوليني الخمس فأعطاني ثم أبو بكر فأعطاني ثم عمر، وهو حديث لم يتابع عليه.(@)(@@)(@@)(@@) $ 2861 - حسين بن الحسن الكندي، روى عنه شريك، أراه يروي عن ابن بريدة، يقال قاضي الكوفة.(@)(@@)(@@)(@@) $ 2862 - حسين بن حسن أبو عبد الله، </span>سمع زهير بن معاوية ويعقوب القمي، فيه نظر هو الأشقر، سمع منه أحمد.(@)(@@)(@@)(@@) $ 2863 - حسين بن حسن صاحب ابن عون، حسن الهيئة، سمع منه ابن المثنى.(@)(@@)(@@)(@@) $ 2864 - حسين بن السائب 
ms425	 بن أبي لبابة، [قال محمد حدثنا - 2] محمد بن أبي حفصة عن الزهري عن الحسين بن السائب(@)(@@) [ابن أبي لبابة - 3] عن أبيه قال لما تاب الله على أبي لبابة قال أبو لبابة PageV00P000(@)(@@) جئت النبي صلى الله عليه وسلم فقلت إني أهجر دار قومي التي أصبت بها الذنب وأنخلع من مالي صدقة لله ورسوله، فقال: يجزي عنك الثلث وقال سليمان بن عبد الرحمن عن سعدان بن يحيى عن ابن أبي حفصة عن الزهري عن حسين بن السائب بن أبي لبابة أو غيره - نحوه، وقال عبد الله حدثني الليث حدثني يونس عن ابن شهاب أخبرني بعض بني السائب بن أبي لبابة أن أبا لبابة - نحوه وروى ابن إسحاق عن حجاج بن السائب أخي هذا.(@)(@@)(@@)(@@) $ 2865 - حسين بن حسن أبو عبد الله بن يسار البصري من آل مالك بن يسار، قال أبو عبد الله: أراه هو الأول حسن الهيئة (1) حدثنا أحمد بن ثابت حدثنا بشر بن الحسن أبو مالك أخو حسين.(@)(@@)(@@)(@@) $ 2866 - حسين بن صالح عن جناح مولى ليلى، يعد في أهل المدينة، روى عنه ابنه صالح.(@)(@@)(@@)(@@) $ 2867 - حسين بن الرماس العبدي، سمع عبد الرحمن بن مسعود، سمع سلمان: أمرنا النبي صلى الله عليه وسلم أن لا نتكلف للضيف ما ليس عندنا وأن نقدم ما حضر - قاله محمد، سمع حسين بن(@)(@@) محمد سمع حسين بن رماس.(@)(@@)(@@)(@@) $ 2868 - حسين بن إسماعيل من أهل تيماء، سمع درباس (2) ، PageV00P000(@)(@@) روى عنه أحمد بن سليمان.(@)(@@)(@@)(@@) $ 2869 - حسين بن ذكوان المعلم المكتب البصري العوذي سمع عبد الله بن بريدة ويحيى بن أبي كثير، سمع منه شعبة وعبد الوارث وابن المبارك.(@)(@@)(@@)(@@) $ 2870 - حسين بن عمران الجهني، عن عمران بن مسلم عن خيثمة: كنت عند ابن عباس - في النذر - قاله محمد بن عقبة قال ثنا روح بن عطاء قال ثنا حسين بن عمران، وروى عمران القطان عن حسين عن الشيباني (1) ، فلا أدري هو هذا أم لا، ولا يتابع في حديثه PageV00P000(@)(@@) وقال أبو ضمرة قال حدثنا حسين بن عمران عن الزهري مناكير.(@)(@@)(@@)(@@) $ 2871 
ms426	 - حسين بن عبد الله العنزي، سمع الشعبي قوله، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) $ 2872 - حسين بن عبد الله بن عبيد الله بن عباس الهاشمي، عن كريب وعكرمة، قال علي: تركت حديثه، قال شريك عن حسين عن عكرمة عن ابن عباس: قال النبي صلى الله عليه وسلم في أم إبراهيم: أعتقها (1) ، ولم يصح وقال عمرو عن عطاء عن ابن عباس: ما أمهات الأولاد إلا بمنزلة شاتك أو بعيرك قال أبو عبد الله: وهذا المعروف من فتيا ابن عباس.(@)(@@)(@@)(@@) $ 2873 - حسين بن عبد الله بن ضميرة واسم ضميرة سعد (2) الحميري من آل ذي يزن مديني عن أبيه عن جده، منكر الحديث، وعن عبد الرحمن بن يحيى بن عباد، روى عنه زيد بن حباب، حدثني أحمد بن عيسى قال ثنا عبد الله بن وهب قال أخبرني ابن ابى ذئب عن PageV00P000(@)(@@) حسين بن عبد الله بن ضميرة عن أبيه عن جده: أن النبي صلى الله عليه وسلم مر بأم ضميرة وهي تبكي قالت: يفرق بيني وبين ابني (1) فقال: لا يفرق بين الوالدة وولدها، ثم أرسل إلى الذي ضميرة عنده فدعاه فابتاعه منه ببكر.(@)(@@)(@@)(@@) $ 2874 - حسين بن عقيل العقيلي الكوفي، سمع الضحاك قوله، سمع منه أبو نعيم.(@)(@@)(@@)(@@) $ 2875 - حسين أبو عبد الله جليس لكعب، سمع منه عتبة ابن أبي حكيم الشامي قوله.(@)(@@)(@@)(@@) $ 2876 - حسين اليمامي، روى عنه ابن المبارك، يروي عن يحيى بن أبي كثير قوله.(@)(@@)(@@)(@@) $ 2877 - حسين بن واقد أبو على قاضى مرو مولى عبد الله ابن عامر بن كريز القرشي، سمع عبد الله بن بريدة، روى عنه الأعمش قال زيد بن حباب قال لي حسين بن واقد: كانت الفتنة عندنا بخراسان زمن (2) الكرماني وأبي مسلم فما سألت عنها ولا سئلت حتى مضت، قال علي بن حسين: مات أبي سنة تسع وخمسين ومائة، ويقال: سبع وخمسين ومائة (3) . PageV00P000(@)(@@)(@@)(@@) $ 2878 - حسين بن محمد، </span>سمع حجاج بن حسان، سمع منه موسى بن إسماعيل، وروى ابن مهدي عن حسين بن محمد عن شعبة فلا أدري هو هذا 
ms427	 أم لا (1) .(@)(@@)(@@)(@@) $ 2879 - حسين بن محمد أبو أحمد البغدادي التميمي (2) المعلم، سمع يزيد بن عطاء وجرير بن حازم ومحمد بن مطرف، سمع منه عبد الله بن محمد (3) .(@)(@@)(@@)(@@) $ 2880 - حسين أبو المنذر، عن الرقاشي (4) ، سمع منه معتمر، ولم تصح روايته.(@)(@@)(@@)(@@) $ 2881 - حسين بن زياد، عن عكرمة مولى ابن عباس عن النبي صلى الله عليه وسلم: تظهر معادن - قاله موسى حدثنا جرير بن حازم قال ثنا حسين بن زياد. PageV00P000(@)(@@)(@@)(@@) $ 2882 - حسين </span>بن زياد أبو علي المروزي، سمع فضيل بن عياض، سكن طرسوس، أصله مروزي احاديثه مشهورة، ومات بطرسوس، مولى ابن علاقة (1) - سنة عشرين ومائتين.(@)(@@)(@@)(@@) $ 2883 - حسين بن سعد الجهني البطين، يعد في البصريين، سمع عطاء وابن أبي مليكة وزيد بن أسلم، روى عنه عبد الرحمن مولى بني هاشم وموسى بن إسماعيل.(@)(@@)(@@)(@@) $ 2884 - حسين بن حفص، قال سعيد بن سليمان حدثنا حسين ابن حفص الأصبهاني قال حدثنا سفيان الثوري قال قال محارب بن دثار: إني لأدع لبس الثوب الجديد مخافة أن يظهر في جيراني حسد لم يكن.(@)(@@)(@@)(@@) $ 2885 - حسين بن الوليد أبو علي النيسابوري القرشي مات سنة ثلاث ومائتين، قال لي علي بن سلمة سمعت حسين أبو عبد الله (2) عن شيخ ذكره: كان نافع مولى ابن عمر من سبي نيسابور.(@)(@@)(@@)(@@) $ 2886 - حسين عن الحكم بن عتيبة، قال موسى حدثنا حماد بن يزيد بن مسلم عن عمه حسين. PageV00P000(@)(@@)(@@)(@@) $ 2887 - حسين (1) أخبرنا (2) محمد بن عبادة قال حدثنا يعقوب حدثتنا كرامة (3) بنت حسين عن أبيها عن أبي عياش عن جابر بن عبد الله: قال النبي صلى الله عليه وسلم: المعتدي في الصدقة كمانعها.(@)(@@)(@@)(@@) $ 2888 - حسين بن ثابت بن أنس بن ظهير الأنصاري المديني عن أخته سعدى (4) عن أبيها.(@)(@@)(@@)(@@) $ 2889 - حسين بن منصور أبو علي النيسابوري، مات سنة ثمان وثلاثين ومائتين، سمع حماد بن أسامة.(@)(@@)(@@)(@@) $ 2890 - حسين بن عطاء (5) ، عن زيد بن أسلم عن ابن عمر عن أبي ذر رفعه في صلاة الضحى، روى عنه عبد الحميد بن جعفر، وروى موسى بن يعقوب عن الصلت بن سالم 
ms428	 مولى طلحة أو ابن عثمان (6) بن عبيد الله التيمي عن مولى لعمر عن عبد الله بن عمرو PageV00P000(@)(@@) ابن العاص عن أبي الدرداء عن النبي صلى الله عليه وسلم، قال الصلت فأخبرنيه سليمان بن ثعلبة الأنصاري، وقال الشعبي عن ابن عمر: صلاة الضحى بدعة ونعمت البدعة، وهذا اصح، يقال حسين بن عطاء ابن يسار.(@)(@@)(@@)(@@) $ 2891 - حسين بن حريث أبو عمار الخزاعي المروزي، سمع الفضل بن موسى، وهو الحسين (1) بن ثابت بن قطبة مولى عمران ابن حصين الخزاعي.(@)(@@)(@@)(@@) $ 2892 - حسين بن قيس أبو علي الرحبي، ويقال له حنش (2) ، عن عكرمة، ترك أحمد حديثه.(@)(@@)(@@)(@@) $ 2893 - حسين بن عيسى أبو علي البسطامي مات سنة سبع وأربعين ومائتين، سمع عبد الصمد.(@)(@@)(@@)(@@) $ 2894 - حسين بن عبد الأول أبو عبد الله النخعي الكوفى الاحول.(@)(@@)(@@)(@@) |EDITOR|(@)(@@) في خاتمة هذا الجزء من نسخة كوپر يلى آخر الجزء الاول من كتاب التاريخ الكبير تأليف ابى عبد الله محمد بن إسماعيل البخاري رحمه الله. PageV00P000(@)(@@) يتلوه في الجزء الثاني ان شاء الله تعالى " باب حصين " والحمد لله رب العالمين وصلواته على سيدنا محمد النبي صلى الله عليه وسلم.(@)(@@) كتبه بعون الله تعالى لنفسه الحسين بن عمر بن نصر بن حسين بن سعد بن باز الموصلي ببغداد وفرغ منه في يوم الاربعاء سادس عشر شهر رمضان سنة ثلاث وسبعين وخمسمائة.(@)(@@)(@@)(@@) |EDITOR|(@)(@@) تعاليق وسماعات وغيرها في آخر هذا المجلد من نسخة كوپر يلى بلغت من اول الكتاب إلى هنا مقابلة بالاصل المنقول منه على الحافظ ابى احمد البصري هو ينظر في الاصل وأنا اصح هذه، وكانت نسخة الاصل بخط ابى الفتح بن ابى الفوارس الحافظ.(@)(@@) بلغت سماعا بقراءتي على الشيخ ابى الحسين ... بن عبد الخالق بن احمد بن عبد القادر بن محمد بن يوسف ... ابى الغنائم ابن النرسى وعرضا بالاصل فصح ذلك ... بباب الازج وثبت.(@)(@@) شاهدت على غاشية الجزء الخامس من الاصل المنقول منه بخط عبد الخالق بن يوسف ما صورته، سمع جميعه وما قبله من اول الكتاب على الح الحافظ ابى الغنائم محمد 
ms429	 بن على بن ميمون النرسى من كتابه بقراءة عبد الخالق بن احمد بن عبد القادر بن محمد بن يوسف - ابنه أبو الحسين عبد الحق ووالدة عبد الحق فاطمة بنت المبارك بن على ابن نصر وأبو سعيد هبة الله بن على بن عبد الباقي الخياط سبط ابن(@)(@@) PageV02P394(@)(@@) يوسف ومثقال وشفيع الحبشيان الخصيان فتيا ابن يوسف في جمادى الآخرة من سنة ثلاث وخمسمائة.(@)(@@) ونقل السماع إلى هذه في شهر رمضان سنة اثنى عشرة (كذا) وخمسمائة.(@)(@@) نقلته من خطه انا على الوجه حرفا حرفا.(@)(@@) وشاهدت ايضا سماع ابى الحسين بن يوسف في جميع الاجزاء التى قبله وبعده إلى آخر العاشر وكانت النسخة المنقول منها بخط الحافظ ابى الفتح محمد بن ابى الفوارس من وقف الح ابى الفضل بن ناصر رحمه الله وقابل ابن ناصر بها اصل ابى النرسى.(@)(@@) قرأ على الشيخ حسين بن عمر بن نصر بن حسن بن باز الموصلي من اول كتاب التاريخ للبخاري قراءة من الاصل إلى آخر هذه الكراسة وهو ربع الكتاب في مجالس آخرها سادس عشر ذى الحجة من سنة ثلاث وسبعين وخمسمائة وكتب عبد الحق بن عبد الخالق ابن احمد بن عبد القادر بن محمد بن يوسف..الله تعالى.(@)(@@) بلغ الجماعة سماعا من لفظي بدار الحديث المعمورة بالموصل في مستهل ربيع الاول سنة احد عشر (كذا) وستمائة.(@)(@@) بلغ الجماعة سماعا..المعمورة بالموصل..سابع ... سمع جميع هذه المجلدة من اولها إلى آخرها على الشيخ الاجل الثقة ابى الحسين عبد الحق بن عبد الخالق بن احمد بن عبد القادر ابن محمد بن يوسف بروايته لها عن الشيخ الحافظ ابى الغنائم محمد بن(@)(@@) PageV02P395(@)(@@) على بن ميمون النرسى عن ابى احمد عبد الوهاب بن محمد بن موسى(@)(@@) الغندجانى عن ابى بكر احمد بن عبدان بن محمد بن الفرج الحافظ الشيرازي عن ابى الحسن محمد بن سهل الفسوى عن الامام ابى عبد الله محمد بن إسماعيل بن إبراهيم الجعفي البخاري رحمه الله بقراءة الحسين ابن عمر بن نصر بن حسن بن سعد بن باز الموصلي 
ms430	 وهذا خطه - أبو محمد عبد الله بن ابى الحسين بن ابى الفرج الجبائى الشامي وأبو الحسن على بن منصور بن محمد الجوهرى الخياط وأبو القاسم عبد الرحيم وأبو صالح نصر ابنا عبد الرزاق بن عبد القادر بن ابى صالح الجيلى وأبو محمد عبد الرزاق بن فيروز بن عبد الله المقرى المعروف بقيصر وصح ذلك لهم.(@)(@@) وسمع من اول الجزء الرابع من نسخة ابى الفتح ابن ابى الفوارس إلى آخر هذه المجلدة أبو الفتح المبارك بن سعد الله ابن وهب الخباز وولده أبو محمد عبد الله وآخرون في الاصل بفوات وذلك في مجالس آخرها يوم الاثنين سادس عشر ذى الحجة سنة ثلاث وسبعين وخمسمائة ببغداد بالجانب الشرقي بباب الازج بمسجد درب العجم وصح وثبت والحمد لله وحده وصلواته على سيدنا محمد النبي وآله وسلم.(@)(@@) سمع جميع هذا المجلد وهو الاول من تاريخ البخاري الكبير المرتب على حروف المعجم من لفظ الح (1) الامام العالم ثقة الدين PageV02P396(@)(@@) ابى عبد الله الحسين بن عمر بن نصر بن باز الموصلي بها بدار الحديث المظفرية في مجالس آخرها مستهل ربيع الاول سنة احدى عشرة وستمائة - ولده أبو حامد محمد والح الامام العالم جلال الدين أبو اسحاق(@)(@@) ابراهيم بن عثمان بن عيسى المارانى والح الامام خلف بن محمد بن خلف المكنزى والح ابراهيم بن يوسف بن بركة المقرى وولده محمد وعبد الكريم بن محمود بن سبكتكين التبريزي وولده محمد وأبو عبد الله محمد بن ابى بكر بن غالب الخوزى وأبو عبد الله محمد ابن ابى بكر بن بركة الازجى وأبو الفتح عبد الرحمن ابن المظفر المبارك ابن طاهر الخزاعى وأبو الحسن على بن الحسين بن محمد الخطيرى وأبو عبد الله محمد بن ابراهيم بن يوسف الهاشمي الطنجى وأبو عبد الله محمد بن يوسف بن احمد المراغى والسراج عبد الغفار بن محمد بن عبد الواحد القومسائى الاعلمي وأبو إسحاق ابراهيم بن نفيس بن ابراهيم سبط ابن الباقلانى الواسطي وأبو الثناء محمود بن مسعود ابن محمود بن بلدجى ومحمد 
ms431	 بن المظفر بن محمد الانصاري ومحمد بن محمود بن الحسن الخباز التكريتي والح أبو حفص عمر بن محمد بن ابى بكر ابن ابى الحسن بن معمر المدنى الموصلي وولده أبو عمر وعثمان وأحمد ابن عبد الرحمن بن عبد الرزاق وكاتب الاسماء ومثبتها الفقير إلى الله تعالى محمود بن ابى العز بن احمد بن ابراهيم بن ظفر الشيباني السنجارى في التاريخ المتقدم المذكور والحمد لله وحده وصلواته على محمد وآله.(@)(@@) PageV02P397(@)(@@) خاتمة الطبع الحمد لله رب العالمين والصلاة والسلام على خاتم النبيين وعلى آله وصحبه والتابعين لهم باحسان إلى يوم الدين.(@)(@@) اما بعد، قال أبو العباس بن سعيد " لو أن رجلا كتب ثلاثين الف حديث لما استغنى عن كتاب تاريخ محمد بن اسماعيل " - تهذيب(@)(@@) التهذيب (9 / 48) .(@)(@@) لما كان هذا السفر الجليل محتويا على اهم مواد التاريخ ومشتملا على اعظم فوائد علم الرجال ومتضمنا لادق اصول الجرح والتعديل عزمت على طبعه جمعيتنا العلمية وتفحصت عن نسخ هذا الكتاب الكبير.(@)(@@)(@@)(@@) |EDITOR|(@)(@@) ذكر النسخ الخطية من هذا الكتاب مما يتعلق بهذا الجزء(@)(@@) 1 - (@)(@@) نسخة قسطنطينية: كاتبنا فيه المستشرق الجليل سالم الكرنكوى وانه بذل العناية التامة في التفحص عن نسخ هذا الكتاب وكاتب الدكتور ه - ريتر الذى كان يشتغل في أخذ العكوس من النسخ الخطية المحفوظة في خزائن اسلامبول حتى فاز في مرامنا الدكتور ه - ريتر وأرسل الينا عكوس هذا الكتاب وفى آخرها " كمل جميع كتاب التاريخ الكبير لابي عبد الله محمد بن إسماعيل البخاري رحمه الله وذلك بمدرسة سبتة حاطهما الله وحرسهما(@)(@@) PageV02P398(@)(@@) في صبيحة يوم الاربعاء الثامن عشر لمحرم سنة ثنتين وسبعمائة ".(@)(@@) وعلى لوح هذه النسخة " رواية ابى الحسن محمد بن سهل بن عبد الله المقرى عنه " وعلامتها في هوامش هذا المطبوع " قط ".(@)(@@) 2 - (@)(@@) نسخة محفوظة بالخزانة المصرية تحت رقم (1890) تفضلت علينا الحكومة العلية المصرية بارسال عكوس شمسية عنها كعادتها ايدها الله تعالى وحماها في اسداء المساعدة العلمية لجمعيتنا في كل مهمة.(@)(@@) وهذه النسخة وإن كانت منقولة بالتصوير عن النسخة الاولى لكننا استفدنا منها كثيرا 
ms432	 لان نقولها كانت اوضح من النسخ التى بين ايدينا في كثير من المواضع ولا سيما في الحواشى فان نقولنا لم يظهر فيها كثير من الحواشى وهى ظاهرة في النسخة المصرية وفى النقول المرسلة الينا منها.(@)(@@) 3 - (@)(@@) نسخة كوپريلى وهى نسخة جليلة محفوظة بخزانة كوپريلى في اسلامبول الموجود منها من اول الكتاب إلى آخر باب حسين تحصلت جمعيتنا على عكوس شمسية من هذه النسخة بالواسطة المتقدمة، وبآخر هذا المجلد تعليقات وسماعات اثبتناها في محلها والنسخة مع وضوح خطها وجودته جيدة الضبط صححت وقوبلت على عدة اصول وقرئت على الشيوخ الاجلة غير مرة كما يعلم من الكتابات في اول المجلد وآخره وحواشيه وقد اثبتنا ذلك(@)(@@) PageV02P399(@)(@@) كله في مواضعه وعلامة هذه النسخة في حواشى هذا المطبوع " كو ".(@)(@@) فقد تم بحمد الله تعالى طبع النصف الثاني من المجلد الاول من التاريخ الكبير لامام المحدثين شيخ الاسلام ابى عبد الله محمد بن إسماعيل البخاري رحمه الله تعالى يوم الخميس تاسع عشر ذى القعدة سنة 1362 ه في العهد الميمون والزمن المسعود والايام الذهبية لجلالة الملك مظفر الممالك نظام الملك سلطان العلوم امير المسلمين النواب مير عثمان على خان بهادر آصف جاه السابع ملك الدولة الاسلامية الآصفية بحيدر آباد الدكن ادام الله ايامه وخلد الله ملكه وسلطنته.(@)(@@) وأحيا الله تعالى بحسن نيته المعالم الشرعية والمدارس الدينية(@)(@@) شرقا وغربا.(@)(@@) وأطال الله عمر ولى عهده الاعظم الدكتور النواب اعظم جاه وابنه المعظم الدكتور النواب معظم جاه بهادر ووفقهما لتشييد اركان الدين آمين وحفظ الله حفيده المكرم النواب مكرم جاه بهادر.(@)(@@) وذلك في عهد وزارة صاحب المعالى النواب الحافظ السير احمد سعيد خان رئيس جهتارى ورئيس الوزراء في الدولة الآصفية ابقاه الله لرقي المملكة الآصفية إلى منازل عالية ونشر علوم القرآن في معالم الدين " ان الله لا يضيع اجر المحسنين ".(@)(@@) وهذه الجمعية تحت رياسة الاديب الجليل الدكتور النواب مهدى يارجنك بهادر وزير المعارف ونائب امير الجامعة العثمانية(@)(@@) PageV02P400(@)(@@) ونيابة الشهم الغيور السيد عبد العزيز وزير العدلية والشرعية ونائب الرئيس وتحت 
ms433	 اعتماد الحسيب النسيب الحاج السيد محيى الدين، وذى المجد والكرم النواب ناظر يارجنك بهادر شريك العميد للجمعية، ابقاهم الله في خدمة العلم والدين! وقد اعتنى بتصحيح هذا الكتاب وتعليق الحواشى المفيدة الاستاذ الفاضل العلامة الشيخ عبد الرحمن بن يحيى اليماني ولله دره فقد اجتهد في تصحيح الاسماء والانساب والمشتبهات واستوعب النظر في الاختلافات من حيث علم الرجال ونقد الروايات من جهة الجرح والتعديل وساعده مولانا الفاضل السيد احمد الله الندوى ومولانا الشيخ محمد طه الندوى ومولانا محمد عادل القدوسي ومولانا السيد حسن جمال الليل المدنى وأنا الحقير الكاتب في(@)(@@) الاستاذ الفاضل العلامة الشيخ عبد الرحمن بن يحيى اليماني ولله دره فقد اجتهد في تصحيح الاسماء والانساب والمشتبهات واستوعب النظر في الاختلافات من حيث علم الرجال ونقد الروايات من جهة الجرح والتعديل وساعده مولانا الفاضل السيد احمد الله الندوى ومولانا الشيخ محمد طه الندوى ومولانا محمد عادل القدوسي ومولانا السيد حسن جمال الليل المدنى وأنا الحقير الكاتب في المقابلة والتصحيح.(@)(@@) وفى الختام ندعو الله سبحانه وتعالى ان يوفقنا لاتمام هذا السفر الجليل ويجعله حرزا لجميع المسلمين والائمة المهديين والعلماء المحدثين وملوك الاسلام الموفقين - وآخر دعوانا ان الحمد لله رب العالمين.(@)(@@) خادم العلم السيد هاشم الندوى مدير دائرة المعارف(@)(@@) PageV02P401(@)(@@) تمت الطبعة الثانية من القسم الثاني للجزء الاول من التاريخ الكبير للامام البخاري رحمه الله يوم الخميس التاسع من شهر جمادى الآخرة سنة 1382 ه = 8 نوفمبر سنة 1962 م وصلى الله تعالى على خير خلقه سيدنا ومولانا محمد وآله وصحبه اجمعين(@)(@@) PageV02P402(@)(@@) بسم الله الرحمن الرحيم (@)(@@)(@@)(@@) || باب حصين(@)(@@)(@@)(@@) $ 1 - حصين بن عوف الخثعمي، له صحبة.(@)(@@)(@@)(@@) $ 2 - حصين بن وحوح، له صحبة.(@)(@@)(@@)(@@) $ 3 - حصين والد عمران بن حصين الخزاعي، رواه البصريون، قال عمرو بن محمد حدثنا أبو معاوية قال حدثنا شبيب بن شيبة عن الحسن عن عمران بن حصين: قال رسول الله صلى الله عليه وسلم لأبي حصين: أما إنك إن أسلمت علمتك كلمتين تنفعانك، قال: فلما أسلم حصين قال.(@)(@@) يا رسول الله! علمني 
ms434	 الكلمتين اللتين وعدتني، قال: قل: اللهم! ألهمني رشدي وأعذني من شر نفسي.(@)(@@)(@@)(@@) $ 4 - حصين بن أوس والد زياد النهشلي، قال موسى بن(@)(@@) إسماعيل حدثنا غسان بن الأغر قال حدثني عمي زياد بن النهشلي عن أبيه حصين بن أوس أنه قدم بإبل له المدينة على عهد رسول الله صلى الله عليه وسلم فقال: ادن مني! فوضع يده على رأسه فمسح وجهه ودعا له.(@)(@@) PageV03P001(@)(@@)(@@)(@@) $ 5 - حصين (1) ، أبو الحسين حدثني محمد بن المثنى قال حدثنا محرز بن وزر بن عمران بن شعيث بن عاصم بن حصين بن مشمت ابن شداد بن زهير بن النضر بن مرة بن حمان بن كعب بن سعد قال حدثني أبي يعني وزرا (2) أن أباه عمران حدثه أن أباه شعيثا حدثه أن أباه حصينا حدثه أنه وفد إلى رسول الله صلى الله عليه وسلم وصدق إليه ماله فأقطعه مياه عدة (3) بالمروت (4) وإسناد جراد (5) منها الماعزة ومنها أصيهب ومنها أهوى (6) ومنها الثماد ومنها السديرة PageV03P002(@)(@@) وشرط رسول الله صلى الله عليه وسلم لحصين فيما أقطعه أن لا يعقر لي (1) ولا يعقر مرعاه ولا يباع ماؤه.(@)(@@)(@@)(@@) $ 6 - حصين بن جندب أبو ظبيان الجنبي الكوفي، سمع سلمان وعليا، سمع منه إبراهيم والأعمش، قال محمد بن سعيد حدثنا شريك عن سماك عن أبي ظبيان عن ابن عباس قال: جاء أعرابي إلى النبي صلى الله عليه وسلم فقال: بما أعرف أنك نبي؟ فقال: إن دعوت هذا العذق من هذه النخلة أتشهد أني رسول الله؟ فدعا، فجعل ينزل من النخلة حتى سقط إلى النبي صلى الله عليه وسلم ثم قال: ارجع! فعاد، فأسلم الأعرابي.(@)(@@)(@@)(@@) $ 7 - حصين بن قيس الرياحي عن ابن عباس قوله - قاله معتمر عن عوف عن زياد بن حصين بن أبيه.(@)(@@) ويقال: اليربوعي، ورياح ويربوع من تميم.(@)(@@)(@@)(@@) $ 8 - حصين بن قيس بن عاصم المنقري (2) ، أراه أخا حكيم، روى عنه ابنه خليفة.(@)(@@)(@@)(@@) $ 9 - حصين عامل عمر بن الخطاب والد يزيد بن حصين. PageV03P003(@)(@@)(@@)(@@) $ 10 - حصين بن حدير - قاله هشام الدستوائي: عن يحيى عن حسان بن زاهر 
ms435	 عن حصين سمع عمر يقول: لاقطع في عذق، وقال محمد بن سلام عن وكيع - وقال أبو نعيم وعبيد الله حدثنا شيبان: عن يحيى عن حسان سمع حصين بن حدير سمع عمر - مثله، وقال عثمان بن عمر عن علي بن المبارك (1) : عن حصين بن حدير، وهو أصح، وقال حرب وأبان: حدثنا يحيى سمع حسان سمع حصين ابن حدير سمع عمر.(@)(@@)(@@)(@@) $ 11 - حصين بن الحر الفزاري (2) ، عن سمرة بن جندب، وقال إسحاق عن جرير: عن عبد الملك عن حصين بن الحر.(@)(@@) (3)(@)(@@)(@@)(@@) $ 12 - حصين بن نمير (4) ، قال حبان حدثنا عبد الوارث حدثنا PageV03P004(@)(@@) محمد بن الزبير حدثنا يزيد بن حصين بن نمير عن ابيه قال: شهدت بلا لاخطب على أخيه وكان عمر استعمله على الأردن فزوجوه عربية، ويقال إنه فيمن أحرق الكعبة، ولم يصح إسناده.(@)(@@)(@@)(@@) $ 13 - حصين بن قبيصة الفزاري، سمع عليا وعن عبد الله، روى عنه القاسم بن عبد الرحمن والركين.(@)(@@)(@@)(@@) $ 14 - حصين بن محصن الخطمي الأنصاري المدني، سمع عميه، سمع منه، بشير بن يسار.(@)(@@)(@@)(@@) $ 15 - حصين بن عقبة الفزاري، عن علي وسلمان - قولهما، روى عنه ابنه مالك وصالح بن خباب، قال إسحاق عن علي: هو أخو زيد بن عقبة.(@)(@@)(@@)(@@) $ 16 - حصين بن سبرة، سمعت عمر قوله، روى عنه إبراهيم التيمي.(@)(@@)(@@)(@@) $ 17 - حصين بن أوس، سمع عثمان قوله، روى محمد بن ابى PageV03P005(@)(@@) يحيى عن عمر بن أبي معتب، وقال حسن حدثنا يحيى بن حسان قال(@)(@@) حدثنا عمرو بن وهب بن عثمان عن عبد الرحمن بن حصين: لقي ابن عمر حصين بن أوس وأنا معه فقال: يا ابا الحكم! كم تعدون هذ ه؟ فقال: بضعا وسبعين، فبكى وقال: ما بيننا وبين المائة إلا بضع وعشرين (1) سنة.(@)(@@) ويقال: حصين بن ويس (2) .(@)(@@)(@@)(@@) $ 18 - حصين الحبراني - ويقال: الحميري - عن أبي سعد الخير عن أبي هريرة عن النبي صلى الله عليه وسلم قال: ما لاك بلسانه فليبتلعه - قاله أبو عاصم عن ثور.(@)(@@)(@@)(@@) $ 19 - حصين بن يزيد الثعلبي (3) ، قال خلف بن الوليد عن أبي جعفر عن حصين عن أبي 
ms436	 اليقظان عن حصين بن يزيد الثعلبي قال: كان ابن مسعود يدعوني دبر كل صلاة اللهم إني أسألك موجبات رحمتك، وقال ابن طهمان عن حصين عن أبي اليقظان عن حصين بن يزيد الثعلبي، حدثني أحمد بن مفضل قال حدثنا جعفر هو ابن زياد عن عمران بن سليمان عن حصين الثعلبي عن اسماء بنت PageV03P006(@)(@@) عميس: قال النبي صلى الله عليه وسلم - في علي، قال أبو عبد الله: فيه نظر.(@)(@@)(@@)(@@) $ 20 - حصين الثعلبي </span>(1) ، عن ابن المسيب، روى وكيع عن هارون الثقفي (2) .(@)(@@)(@@)(@@) $ 21 - حصين (3) ، قال قال علي، روى عنه أبو إسحاق الهمداني.(@)(@@)(@@)(@@) $ 22 - حصين بن مصعب: كره أبو هريرة التراهن بالحمام (4) - قاله عمرو بن زرارة أبو محمد عن مروان عن عمر بن حمزة (5) .(@)(@@)(@@)(@@) $ 23 - حصين بن محمد السالمي الأنصاري المدني، عن عتبان، روى عنه الزهري.(@)(@@)(@@)(@@) $ 24 - حصين والد داود مولى عمرو بن عثمان القرشي، عن أبي رافع، روى عنه ابنه داود، مدني، حديثه ليس في وجه صحيح.(@)(@@)(@@)(@@) $ 25 - حصين بن عبد الرحمن السلمي أبو الهذيل الكوفى، PageV03P007(@)(@@) سمع عمارة بن رويبة والشعبي، سمع منه الثوري وشعبة وأبو عوانة، وقال أحمد عن يزيد بن هارون: طلبت الحديث وحصين حي كان بالمبارك ويقرأ عليه وكان قد نسي، قال زياد حدثنا هشيم عن حصين: أني لأذكر ليلة أهديت أم منصور إلى أبيه، وكان أكبر من الأعمش وكان قريب السن من إبراهيم ومات ابن ثلاث وتسعين (1) أو سبعين.(@)(@@)(@@)(@@) $ 26 - حصين بن عبد الرحمن الحارثي، عن الشعبي، روى عنه إسماعيل بن أبي خالد وحجاج، قال إبراهيم بن موسى عن محمد عن ابن أبي خالد عن حصين الحارثي: حدثتني سرية زيد (2) بن أرقم أن عليا عاد زيد بن أرقم.(@)(@@)(@@)(@@) $ 27 - حصين بن عبد الرحمن النخعي أخو سلم، عن الشعبي، روى عنه حفص بن غياث.(@)(@@)(@@)(@@) $ 28 - حصين بن عبد الرحمن بن عمرو بن سعد بن معاذ الأنصاري الأشهلي الأوسي، مدني، عن محمود (3) بن عمرو ومحمود بن لبيده روى عنه ابنه محمد بن حصين. PageV03P008(@)(@@)(@@)(@@) $ 29 - حصين بن مالك </span>(1) ، حدثنا عمرو بن 
ms437	 علي قال حدثنا أبو عتيبة قال حدثنا أبو العلاء (2) الخفاف عن حصين بن مالك سمع ابن عباس عن النبي صلى الله عليه وسلم: من كسا سائلا ثوبا كان في حفظ الله ما كان عليه قطعة.(@)(@@)(@@)(@@) $ 30 - حصين بن مالك (3) جد عبيد الله بن حسن، سمع عامر ابن عبد قيس، يعد في البصريين، هو حصين بن أبي الحر بن الخشخاش العنبري التميمي، روى عنه الوليد بن بشر.(@)(@@)(@@)(@@) $ 31 - حصين بن عرفطة ليربوعى التميمي، عن أبي هريرة، سمع منه عنترة بن أبي العيش ويقال: ابن أبي العيص (4) .(@)(@@)(@@)(@@) $ 32 - حصين بن عبد الله الهفاني عن أنس بن مالك قال: ما أعرف شيئا إلا لصلاة - قاله عمرو بن عباس عن ابن مهدي عن سفيان عن أبيه: عن حصين، وقال علي حدثنا حسان بن إبراهيم عن سعيد بن مسروق: عن حصين بن عبد الله الشيباني عن معاوية بن قرة عن أنس قال: ما أعرف إلا القبلة، ورواه يونس بن ابى اسحاق عن معاوية ابن قرة عن انس. PageV03P009(@)(@@)(@@)(@@) $ 33 - حصين بن حذيفة، سمع عمه عن سعيد بن المسيب عن صهيب، سمع منه يعقوب بن محمد، أراه من ولد صهيب (1) .(@)(@@)(@@)(@@) $ 34 - حصين بن حرملة المهري، سمع أبا مصبح، سمع منه عتبة ابن أبي حكيم، يعد في الشاميين.(@)(@@)(@@)(@@) $ 35 - حصين بن نافع العنبري التميمي الوراق، بصري، سمع أبا رجاء والحسن، سمع منه أبو الوليد وسلم بن قتيبة، وقال النضر بن شميل أخبرنا حصين أبو نصر منزله في بني فهر سمع أبا رجاء.(@)(@@)(@@)(@@) $ 36 - حصين بن منيع السدوسي (2) ، روى عنه شاذان: منقطع.(@)(@@)(@@)(@@) $ 37 - حصين بن نمير أبو محصن الواسطي، سمع حصين بن عبد الرحمن والفضل بن عطية، سمع منه علي ومسدد.(@)(@@)(@@)(@@) $ 38 - حصين بن عمر أبو عمر الأحمسي عن مخارق وإسماعيل(@)(@@) ابن أبي خالد، كوفي، منكر الحديث ضعفه أحمد قدم من الكوفة بغداد سائلا (3) يسأل، ويقال: أبو عمران.(@)(@@)(@@)(@@) $ 39 - حصين بن منصور الأسدي عن عبد الله بن ابى حسين PageV03P010(@)(@@) عن شهر عن ابن غنم عن معاذ: قال النبي صلى 
ms438	 الله عليه وسلم: من قال حين ينصرف من الغداة - قاله هارون عن المحاربي.(@)(@@)(@@)(@@) $ 40 - حصين أبو حبيب، سمع حرب بن أبي حرب، وروى عن عكرمة، منقطع، سمع منه عبد الصمد.(@)(@@)(@@)(@@) $ 41 - حصين بن سعيد بن سيار بن سلامة الرياحي البصري، سمع سيارا (1) عن عقيل بن سمير، سمع منه محمد بن عقبة.(@)(@@)(@@)(@@) || باب حكيم(@)(@@)(@@)(@@) $ 42 - حكيم بن حزام أبو خالد الاسدي، هالك سنة ستين وهو ابن عشيرين ومائة سنة، الحجازي القرشي، عاش في الجاهلية ستين سنة وفي الإسلام ستين سنة - قاله إبراهيم بن المنذر.(@)(@@) حدثني إبراهيم بن موسى قال اخبرنا هشام ان ابن جريح أخبرهم قال أخبرني عمر بن عبد الله بن عروة عن عروة: قال رسول الله صلى الله عليه وسلم: يا حكيم! إن الدنيا خضرة حلوة، قال: فما أخذ من أبي بكر وعمر وعثمان ولا معاوية ديوانا ولاغيره.(@)(@@) لشر (2) سنوات من إمارة معاوية.(@)(@@)(@@)(@@) $ 43 - حكيم بن معاوية النميري، </span>سمع النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 44 - حكيم بن معاوية، سمع النبي صلى الله عليه وسلم (3) . PageV03P011(@)(@@)(@@)(@@) $ 45 - حكيم بن معاوية بن حيدة الفشيرى البصري، عن أبيه، سمع منه ابنه بهز والجريري.(@)(@@)(@@)(@@) $ 46 - حكيم بن قيس بن عاصم المنقري التميمي، قال سعيد ابن الربيع حدثنا شعبة عن قتادة عن مطرف عن حكيم بن قيس عن أبيه قال: لاتنوحوا علي فإن النبي صلى الله عليه وسلم لم ينح عليه.(@)(@@)(@@)(@@) $ 47 - حكيم بن جابر بن طارق بن عوف الكوفي الأحمسي، سمع أباه وعمر، قال ابن نمير حدثنا محمد بن بشر من كنانة (1) قال حدثنا إسماعيل بن أبي خالد عن حكيم بن جابر قال: سمعت عبد الله بن مسعود حين بويع عثمان: ما الونا عن أعلاها فوقا، وقال حكيم: أخبرت عن عبادة - في الصرف.(@)(@@)(@@)(@@) $ 48 - حكيم بن دينار، عن ابن عمر قوله، روى عنه الحسن البصري.(@)(@@)(@@)(@@) $ 49 - حكيم بن دينار أبو طلحة قوله، قال بشر بن بكر حدثنا PageV03P012(@)(@@) ابن جابر قال حدثنا حكيم، حديثه عن الشاميين.(@)(@@)(@@)(@@) $ 50 - حكيم السلمي، عن ابن عباس قوله، روى عنه 
ms439	 منصور، وقال بعضهم: أبو إدريس (1) .(@)(@@)(@@)(@@) $ 51 - حكيم والد المغيرة بن حكيم الصنعاني، عن عمر (2) قوله، روى عنه ابنه مغيرة.(@)(@@)(@@)(@@) $ 52 - حكيم بن عقال القرشي، عن ابن عمر، روى عنه قتادة، وسمع عثمان، روى عنه أبو مرة القرشي وأوس وحميد بن هلال، وقال عبد الرزاق أخبرنا ابن جريج عن عطاء عن حكيم بن عقال أنه كان ينهى عن رفع الصوت بالقرآن بالنهار في التطوع.(@)(@@)(@@)(@@) $ 53 - حكيم بن سلمة، قال إبراهيم عن عباد بن إسحاق عن أيوب بن حبيب وحكيم بن سلمة عن الجشمي (3) : قال ابن عمر PageV03P013(@)(@@) لحصين بن أويس (1) : يا أبا الحكم - في الحرورية.(@)(@@)(@@)(@@) $ 54 - حكيم بن أبي حرة الأسلمي، سمع ابن عمر، روى عنه(@)(@@) موسى بن عقبة، وهو عم محمد بن عبد الله بن أبي حرة.(@)(@@)(@@)(@@) $ 55 - حكيم بن أبي حكيم، (@)(@@) </span>عن ابى امامة، روى عنه ليث ابن أبي سليم (2) .(@)(@@)(@@)(@@) $ 56 - حكيم بن أبي حكيم، روى عنه عبيد الله بن عمرو (3) .(@)(@@)(@@)(@@) $ 57 - حكيم بن أبي راشد، سمع أبا سلمة بن عبد الرحمن قوله.(@)(@@) سمع منه الليث بن سعد.(@)(@@)(@@)(@@) $ 58 - حكيم بن شريك بن نملة، عن أبيه، روى عنه ابنه مصعب. PageV03P014(@)(@@)(@@)(@@) $ 59 - حكيم بن شريك الهذلي، يعد في المصريين، قال المقري حدثنا سعيد بن أبي أيوب عن عطاء بن دينار عن حكيم بن شريك عن يحيى بن ميمون عن ربيعة الجرشي عن أبي هريرة عن عمر: قال(@)(@@) النبي صلى الله عليه وسلم: لا تجالسوا أهل القدر ولا تفاتحوهم.(@)(@@)(@@)(@@) $ 60 - حكيم بن عمار الحنفي وكان رضا، سمع ابن خالته، وكان صديقا لأبي هريرة سمع منه عكرمة بن عمار(@)(@@)(@@)(@@) $ 61 - حكيم بن عمرو، عن ابن عباس قوله - قاله شاذان عن شريك عن حصين.(@)(@@)(@@)(@@) $ 62 - حكيم بن الحارث، نسيب ابن سيرين، سمع ابن عباس، روى عنه ابنه الحسن.(@)(@@)(@@)(@@) $ 63 - حكيم بن أبي يزيد عن أبيه عمن سمع النبي صلى الله عليه وسلم، روى عنه عطاء - قاله مسدد عن أبي عوانة، وقال قتيبة عن جرير: عن عطاء عن حكيم بن يزيد الكرخي عن النبي صلى 
ms440	 الله عليه وسلم قال: لايبع حاضر لباد! وقال موسى حدثنا وهيب: عن عطاء عن حكيم بن أبي يزيد أنه جاءه في حاجة فحدثني عن أبيه عن النبي صلى الله عليه وسلم، ويقال: عن جرير عن عطاء عن حكيم بن أبي يزيد الكرخي عن أبيه عن النبي صلى الله عليه وسلم (1) . PageV03P015(@)(@@)(@@)(@@) $ 64 - حكيم بن عمر (1) أبو الأحوص العلسي أن عمر كتب، روى عنه ابنه الأحوص ومعاوية بن صالح وأبو بكر ابن أبي مريم الشامي، مرسل، وقال إسحاق حدثنا بقية عن أرطاة حدثني أبو الأحوص بن حكيم (2) بن عمير العلسي عن عمر بن عبد العزيز - قوله.(@)(@@)(@@)(@@) $ 65 - حكيم بن جبير الأسدي الكوفي، عن سعيد بن جبير(@)(@@) وإبراهيم، روى عنه الثوري، كان شعبة يتكلم فيه، قال أحمد قال وكيع قال ابن حكيم بن جبير أن أباه مولى لبني أمية، كان يحيى وابن مهدى لا يحدثان عنه ولاعن عبد الأعلى - يعني الثعلبي.(@)(@@)(@@)(@@) $ 66 - حكيم بن الديلمي (3) ، عن أبي بردة والضحاك، سمع منه الثوري، يعد في الكوفيين.(@)(@@)(@@)(@@) $ 67 - حكيم الأثرم (4) ، قال موسى بن اسماعيل حدثنا حماد ابن سلمة سمع حكيما الأثرم عن أبي تميمة الهجيمى عن ابى هريرة عن PageV03P016(@)(@@) النبي صلى الله عليه وسلم قال: من أتى كاهنا فصدقه بما يقول أو أتى امرأة حائضا أو امرأة في دبرها فقد برئ مما أنزل على محمد صلى الله عليه وسلم، هذا حديث لا يتابع عليه ولا يعرف لأبي تميمة سماع من أبي هريرة، في البصريين.(@)(@@)(@@)(@@) $ 68 - حكيم بن عباد بن حنيف الأنصاري </span>سمع ابن عباس فيمن يحرك نفسه فيمني قال: " ذاك نائك نفسه - قاله ابن فضيل عن عثمان بن حكيم عن أبيه.(@)(@@)(@@)(@@) $ 69 - حكيم بن حكيم بن عباد بن حنيف الأنصاري أخي(@)(@@) عثمان بن حنيف، سمع نافع بن جبير وعن أبي أمامة بن سهل، روى عنه سهيل بن أبي صالح وعبد الرحمن بن الحارث، هو أخو عثمان ابن حكيم، نسبه يحيى الأموي عن عثمان بن حكيم عن أخيه.(@)(@@)(@@)(@@) $ 70 - حكيم بن دريم، روى عنه محمد بن 