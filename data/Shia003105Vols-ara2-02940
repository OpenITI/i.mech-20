ms2933	 هو أبو بكر عبد الله بن محمد بن أبي الأسود البصري حافظ ثقة مات سنة ٢٢٣. تذكرة الحفاظ ٢: ٤٩٣، تاريخ بغداد ١٠: ٦٢.(@)(١) النفيلي: هو عبد الله بن محمد بن علي بن نفيل بالتصغير بن زراع بن علي أبو جعفر النفيلي الحراني روى عن هشيم وغيره حافظ ثقة مات سنة ٢٣٤ ه‍، تهذيب التهذيب ٦: ١٥ - 16.(@)(١) سفيان بن عيينة بن ميمون الهلالي الكوفي أبو محمد محدث الحرم المكي الثبت الحجة توفي في مكة سنة ١٩٨، له الجامع في الحديث وكتاب في التفسير. تاريخ بغداد ٩: ١٧٤، وفيات الأعيان ٢: ٣٩١، تهذيب التهذيب ٤: ١٠٤ - 107.(@)(١) علي بن الجعد بن عبيد الجوهري البغدادي الحافظ الثبت المسند شيخ بغداد، مات سنة ٢٣٠ ه‍. تاريخ بغداد ١١ : ٣٦٠، تذكرة الحفاظ ١: ٣٩٩.(@)(@@) (٢) مجاهد بن جبر أبو الحجاج المكي مقرئ مفسر حافظ أحد التابعين الاجلاء تهذيب التهذيب ١٠: ٣٨ - ٤٠ مات ١٠٤ ه‍. صفة الصفوة ٢: ١١٧، حلية الأولياء ٣: ٢٧٩ الاعلام.(@)(@@) (٣) طاووس بن كيسان الخولاني الهمداني من أكابر التابعين، مات أثناء الحج وصلى عليه هشام بن عبد الملك سنة ١٠٦ ه‍. تهذيب التهذيب ٥: ٨ - 9، وفيات الأعيان 1: 233، الاعلام.(@)(١) يحيى بن سعيد بن فروخ القطان التميمي أبو سعيد من حفاظ الحديث ثقة حجة، تهذيب التهذيب ١١: ١٩٠ - ١٩٣، تذكرة الحفاظ ١: ٢٧٤، الجواهر المضيئة ٢: ٢١٢، الاعلام.(@)(@@) (٢) عباس بن محمد بن حاتم الدوري أبو الفضل البغدادي الامام الحافظ مات سنة ٢٧١ ه‍. تاريخ بغداد ٢: ١٤٢ تذكرة الحفاظ ٢: ٥٧٩. النجوم الزاهرة 2: 120.(@)(@@) (3) الامام يحيى بن معين.(@)(١) موسى بن عبد الله ويقال ابن عبد الرحمن الجهني أبو سلمة ويقال: أبو عبد الله الكوفي، ثقة قليل الحديث، مات سنة ١٤٤ ه‍. تهذيب التهذيب ١٠: ٣١٦.(@)(@@) (٢) الآية - لتؤمنوا بالله ورسوله وتعزروه وتوقروه وتسبحوه بكرة وأصيلا - سورة الفتح ٩، والحديث رواه ابن مردويه والخطيب، وابن عساكر في تاريخ دمشق، الدر المنثور ٦: ٧٠.(@)(١) معاذ بن معاذ بن نصر بن حسان الامام العلامة الحافظ أبو المثني قاضي البصرة، مات سنة ١٩٦ ه‍. قال أحمد:(@)(@@) إليه المنتهى في البصرة. تاريخ بغداد ١٣: ١٣١، تذكرة الحفاظ ١: ٣٢٤.(@)(١) عبد الله بن المبارك بن واضح الحنظلي بالولاء التميمي المروزي أبو عبد الرحمن الحافظ شيخ الاسلام، صاحب التصانيف والرحلات، وجمع الحديث 
ms2934	 والفقه والعربية، وأيام الناس والشجاعة والسخاء، له كتاب في الجهاد، وآخر في الرقائق، وغيرها، مات سنة ١٨١ ه‍. حلية الأولياء ٨: ١٦٢، شذرات الذهب ١: ٢٩٥، تاريخ بغداد ١٠: ١٥٢ تهذيب التهذيب ٥: ٣٣٤ - ٣٣٨. الأعلام للزركلي.(@)(@@) (٢) إبراهيم بن يوسف الرازي الهسنجاني أبو إسحاق حافظ ثقة من أهل هسنجان من قرى الري له مسند كبير في الحديث، شذرات الذهب ٢: ٢٣٥. ومعجم البلدان ٨: ٤٥٦.(@)(@@) (٣) الدغولي: هو محمد بن عبد الرحمن أبو العباس. تاريخ بغداد ١٠: ١٦٢.(@)(@@) (٤) ابن قهزاد: هو محمد بن عبد الله بن قهزاد. تاريخ بغداد ١٠: ١٦٢.(@)(١) يونس بن يزيد بن أبي النجاة الأيلي، أبو يزيد، ثقة أخرج حديثه الستة مات سنة ١٥٩ ه‍. تهذيب التهذيب ١١:: ٣٩٥ - ٣٩٧.(@)(@@) (٢) الوليد بن مسلم أبو العباس الدمشقي حافظ، اخرج حديثه الستة، مات سنة ١٩٥ ه‍. تهذيب التهذيب ١١: ١٣٣ - ١٣٦.(@)(@@) (٣) حياة بن شريح بن صفوان التجيبي أبو زرعة المصري الحافظ مات سنة ١٥٨ ه‍. تهذيب التهذيب ٣: ٦١ - 62.(@)(١) جعفر بن عون بن جعفر بن عمرو بن حريث المخرومي أبو عون الكوفي، ثقة ثبت اخرج حديثه الستة، مات سنة ٢٠٦ ه‍. تهذيب التهذيب ٢: ٨٦.(@)(@@) (٣) نعيم بن حماد بن معاوية الخزاعي أبو عبد الله الشهيد، مات بسامراء سنة ٢٢٨ ه‍ تاريخ بغداد ١٣: ٣٠٦.(@)(1) القلس لغة ما خرج من الحلق ملء الفلم أعاده صاحبه أو ألقاه فهو القئ ويقال القلس بالتحريك (لسان العرب مادة قلس).(@)(١) كذا في الأصل: وهو محمد بن عمرو بن بكر بن سالم أبو غسان الرازي شهر بالطيالسي وعرف بزنيج ذكره ابن حبان في الثقات مات سنة ٢٤٠ ه‍، تهذيب التهذيب ٩: ٣٢٨ - ٣٢٩.(@)(@@) (٢) حديث أنس. متفق عليه، رواه الشيخان.(@)(@@) (٣) جرير بن عبد الحميد بن قوط الرازي الضبي محدث الري في عصره، رحل إليه المحدثون لسعة علمه، كان ثقة، مولده ثم وفاته في الري توفي سنة ١٨٨ ه‍. تاريخ بغداد ٧: ٢٥٣. ميزان الاعتدال ١: ١٨٢. الأعلام للزركلي.(@)(١) الفضل بن موسى السيناني، امام حافظ، السيناني نسبة إلى سينان، من قرى مرو، مات سنة ١٩٢ ه‍، تهذيب التهذيب ٨: ٢٥٧، تذكرة الحفاظ ١: ٢٩٦، ميزان الاعتدال ٣: ٣٦٠.(@)(١) وكيع بن الجراح بن مليح الرؤاسي، أبو سفيان الكوفي، الحافظ الثبت الناقد، محدث العراق، أحد الأئمة 
ms2935	 الاعلام، قال الامام أحد: ما رأيت أحدا أوعى منه ولا أحفظ، وكيع أما المسلمين مات سنة ١٩٦ ه‍. له ترجمة في: الارشاد ورقة ٩٠، مقدمة الجرح والتعديل ٢١٩، الفهرست ٣٣١، تاريخ بغداد ١٣: ٤٢٦، طبقات الحنابلة 1: 391.(@)(١) عبد الله بن مسلمة بن قعثب القعنبي الحارثي من رجال الحديث الثقات من أهل المدينة، سكن البصرة، مات سنة ٢٢١ ه‍، روى عنه، البخاري ١٢٣. تهذيب التهذيب ٦: ٢٨ - ٢٩، النجوم الزاهرة ٢: ٨٥. الأعلام للزركلي.(@)(@@) (٢) علي بن الحسن بن شقيق بن دينار، أبو عبد الرحمن المروزي، أخرج حديثه الستة، وروى عنه البخاري مباشرة، مات سنة ٢١٥ ه‍. تهذيب التهذيب ٧: ٢٦٣ - ٢٦٤.(@)(@@) (٣) أبو داود الحفري، عمر بن سعد بن عبيد، أبو داود الحفري الكوفي، ثقة مات سنة ٢٠٣، تهذيب التهذيب ٧: ٣٩٧ - ٣٩٨.(@)(@@) (٤) سعيد بن عامر الضبعي أبو محمد بن البصري، مات سنة ٢٠٨ ه‍. تهذيب التهذيب ٤: ٤٤ - ٤٥.(@)(@@) (٥) عبد الرحمن بن مهدي بن حسان المنبري البصري اللؤلؤي أبو سعيد من كبار حفاظ الحديث، وله فيه تصانيف، مولده ثم وفاته بالبصرة، قال الشافعي: لا أعرف له نظيرا في الدنيا، مات سنة ١٩٨ ه‍. حلية الأولياء ٩: ٣، تاريخ بغداد ١٠: ٢٤٠، اللباب للسمعاني ٣: ٧٢، تهذيب التهذيب ٦: ٢٥٠ - 252، الأعلام للزركلي.(@)(١) نبهرج: النبهرج كالبهرج. والدرهم البهرج: الذي فضته رديئة (لسان العرب).(@)(@@) (٢) حسين بن الوليد القرشي، مولاهم، أبو علي الفقيه النيسابوري، لقبه كميل، ثقة، مات سنة ٢٠٣ ه‍. تهذيب التهذيب ٢: ٢٢٢ - 223.(@)(١) قطبة بن عبد العزيز بن سياه الأسدي الحماني الكوفي ذكره ابن حبان في الثقات، تهذيب التهذيب ٨: ٢٣٨ - ٢٣٩.(@)(@@) (٢) أبو عامر العقدي عبد الملك بن عمرو القيسي العقدي البصري ثقة مات سنة ٢٠٥ ه‍، تهذيب التهذيب ٦: ٢٦٣ - ٢٦٤.(@)(@@) (٣) الحارث بن سريج بالمهملة (النقال) تاريخ بغداد ٨: ٢٠٩، ابن مأكولا ٤: ٢٧٤.(@)(@@) (٤) جرير بن حازم بن عبد الله بن شجاع الأزدي العتكي أبو النضر البصري، حافظ ثقة مات سنة ١٧٥، تهذيب التهذيب ٢: ٦٠ - ٦١.(@)(@@) (٥) عبد الوهاب بن عبد المجيد بن الصلت الثقفي أبو محمد مات سنة ١٩٤ ه‍ وثقة يحيى بن معين، لسان الميزان ٤:(@)(@@) ٨٨، تذكرة الحفاظ ١: ٣٢١.(@)(@@) (٦) معتمر بن سليمان بن طرخان من موالي بني مرة، أبو محمد، محدث البصرة، حافظ ثقة، حدث عنه أحمد ابن حنبل. 
ms2936	 ابن سعد ٧: ٤٥ تذكرة الحفاظ ١: ٢٤٥، الاعلام.(@)(@@) (٧) عبد الأعلى بن عبد الأعلى القرشي البصري، من الثقات. تهذيب التهذيب ٦: ٨٧ - 88.(@)(١) الحافظ محمد بن جعفر أبو عبد الله البصري المعروف بغندر، ثقة ثبت أخرج حديثه الستة مات سنة ٩٢ ه‍ أو بعدها، تهذيب التهذيب ٩: ٨٤ - 86.(@)(١) بندار الحافظ الكبير، الإمام أبو بكر محمد بن بشار بن عثمان البصري، النساج، المعروف ببندار، كان علاما بحديث البصرة، أخرج حديثه الأئمة الستة مات سنة ٢٥٢ ه‍. تذكرة الحفاظ ٢: ٥١١، تهذيب التهذيب ٩: ٦١ - ٦٣.(@)(@@) (٢) عبيد الله بن عمر بن ميسرة أبو سعيد الجشمي مولاهم المعروف بالقواريري زهري، وثقه ابن معين والعجلي والنسائي وغيرهم، مات سنة ٢٣٥، تاريخ بغداد ١٠: ٣٢٠.(@)(@@) (٣) البرد نوع من الثياب معروف - النهاية لابن الأثير.(@)(@@) (٤) أبو الوليد هشام بن عبد الملك الطيالسي البصري حافظ حجة مات سنة ٢٢٧ ه‍، تذكرة الحفاظ ١: ٣٨٢.(@)(١) عبد الله بن داود بن عامر بن الربيع الهمداني المعروف بالخريبي ثقة مات ٢١١ ه‍، تهذيب التهذيب ٥: ١٧٥ - ١٧٦.(@)(@@) (٢) حماد بن زيد بن درهم الأزدي الجهضمي ذكره ابن حبان في الثقات مات سنة ١٧٩ ه‍، تهذيب التهذيب ٣: ٩ - ١١.(@)(@@) (٣) يزيد بن زريع العيشي ويقال التميمي أبو معاوية حافظ ثقة مات سنة ١٨٢ قال أحمد بن حنبل عنه: كان ريحانة البصرة. تهذيب التهذيب ١١: ٢٨٤ - ٢٨٦. الاعلام.(@)(@@) (٤) سفيان بن زياد البصري المعروف بالرأس. حافظ ثقة مات بعد المائتين. الجرح والتعديل ٢: ٢٣٠، ميزان الاعتدال ٢: ١٩٦، لسان الميزان ٣: ٥٢.(@)(@@) (٥) المظفر بن مدرك أبو كامل الخراساني البغدادي حافظ ثقة توفي سنة ٢٠٧ ه‍، تهذيب التهذيب ١٠: ١٦٦ - ١٦٧.(@)(@@) شذرات الذهب ٢: ١٨، تاريخ بغداد ١٣: ١٢٥.(@)(@@) * آخر الجزء الثالث (م).(@)(١) إخميم: بلدة بمصر. (معجم البلدان).(@)(@@) (٢) عمرو بن العباس الباهلي أبو عثمان البصري الأهوازي الرزي. روى عن غندر وابن مهدي وغيرهما وروى عنه عبدان بن أحمد الأهوازي وغيره. انظر تهذيب التهذيب ٨: ٥٣ - 54 (المصحح).(@)(١) أي الشافعي.(@)(@@) (٢) الحميدي: هو عبد الله بن الزبير بن عيسى. تهذيب التهذيب ٥: ١٨٩.(@)(@@) (٣) هانئ بن هانئ الهمذاني ذكره ابن حبان في الثقات، تهذيب التهذيب ١١: ٢٢، الاعتدال ٤: ٢٩١.(@)(@@) (٤) أبو قلابة: هو عبد الله بن زيد بن عمرو البصري، امام ثقة مات سنة ١٠٤، تهذيب ال