ms268	 خير من جاف مكثر(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD06 وجه مستبشر خير من قطوب مؤثر(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD017 في الروضة الكافي عنه (عليه السلام): وكل الرزق بالحمق ووكل الحرمان بالعقل ووكل البلاء بالصبر(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD06 وصول الناس من وصل من قطعه(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD010 وجيه الناس من تواضع مع رفعة وذل مع منعة(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD09 ويل لمن تمادى في جهله وطوبى لمن عقل(@)(@)PageV01P726(@)(@)(@@) @HAD02 واهتدى(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD011 ويل لمن ساءت سيرته وجارت ملكته وتجبر واعتدى(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD010 ويل لمن تمادى في غيه ولم يف إلى الرشد(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD010 ويل لمن غلبت عليه الغفلة فنسي الرحلة ولم يستعد(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD09 ويل للنائم ما أخسره قصر عمره وقل أجره(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD010 ويح المسرف ما أبعده عن صلاح نفسه وإستدراك أمره(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD010 ويح ابن آدم ما أغفله وعن رشده ما أذهله(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD011 ويح ابن آدم أسير الجوع صريع الشبع عرض الآفات خليفة الأموات(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD09 ويل العاصي ما أجهله وعن حظه ما أعدله(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD07 ويح الحسد ما أعدله بدا بصاحبه فقتله(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD010 وقروا أنفسكم عن الفكاهات ومضاحك الحكايات ومحال النزاهات(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD018 يا أباذر إن الرجل يتكلم بكلمة في المجلس ليضحكهم بها فيهوى في جهنم ما بين السماء والأرض(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD06 يا أباذر ويل للذي يحدث فيكذب(@)(@)PageV01P727(@)(@)(@@) @HAD09 ليضحك به القوم ويل له ويل له ويل له(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD013 ويح البخيل المتعجل الفقر الذي منه هرب والتارك الغني الذي إياه طلب(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD07 وقار الشيب أحب إلى من نضارة الشباب(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD09 ويل للباغين من أحكم الحاكمين وعالم ضمائر المضمرين(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD08 ويل لمن بلي بعصيان وحرمان وخذلان(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD032 والذي فلق الحبة وبرء النسمة ليظهرن عليكم قوم يضربون الهام على تأويل القرآن كما بدأكم محمد (صلى الله عليه وآله) على تنزيله حكم من الرحمن عليكم في آخر الزمان(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @HAD09 وقروا الله سبحانه واجتنبوا محارمه وأحبو أحبائه(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD018 وق نفسك نارا وقودها الناس والحجارة بمبادرتك إلى طاعة الله سبحانه وتجنبك معاصيه وتوخيك رضاه(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD06 وقر سمع من لم يسمع الداعية(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD08 وقر قلب من لم تكن له أذن واعية(@)(@)PageV01P728(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD05 وقوا دينكم بالإستعانة بالله سبحانه(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD010 وقوا انفسكم 
ms269	 من عذاب الله بالمبادرة إلى طاعة الله سبحانه(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD07 وال ظلوم غشوم خير من فتنة تدوم(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD010 وقر عرضك بعرضك، تكرم وتفضل تخدم، واحلم تقدم(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD07 وافد الموت يقطع الأجل ويفضح الأمل(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD010 وافد الموت يبيد المهل ويدني الأجل ويبعد الأمل(@)(@)(@@)(@@)(@@) ||| 54(@)(@)(@@) @HAD04 وفد الجنة أبدا منعمون(@)(@)(@@)(@@)(@@) ||| 55(@)(@)(@@) @HAD04 وفد النار أبدا معذبون(@)(@)(@@)(@@)(@@) ||| 56(@)(@)(@@) @HAD04 وارد الجنة مخلد النعماء(@)(@)(@@)(@@)(@@) ||| 57(@)(@)(@@) @HAD04 وارد النار مؤبد الشقاء(@)(@)(@@)(@@)(@@) ||| 58(@)(@)(@@) @HAD06 ود أبناء الدنيا ينقطع لإنقطاع أسبابه(@)(@)(@@)(@@)(@@) ||| 59(@)(@)(@@) @HAD07 ود أبناء الآخرة لا ينقطع لدوام سببه(@)(@)(@@)(@@)(@@) ||| 60(@)(@)(@@) @HAD013 وادوا من توادونه في الله سبحانه وأبغضوا من تبغضونه في الله سبحانه(@)(@)(@@)(@@)(@@) ||| 61(@)(@)(@@) @HAD011 واصلوا من تواصلونه في الله واهجروا من تهجرونه في الله(@)(@)(@@)(@@)(@@) ||| 62(@)(@)(@@) @HAD06 وزراء السوء أعوان الظلمة وإخوان(@)(@)PageV01P729(@)(@)(@@) @HAD01 الأثمة(@)(@)(@@)(@@)(@@) ||| 63(@)(@)(@@) @HAD04 ولاة الجور شرار الأمة(@)(@)(@@)(@@)(@@) ||| 64(@)(@)(@@) @HAD011 وا عجبا أتكون الخلافة بالصحابة ولا تكون بالصحابة والقرابة(@)(@)(@@)(@@)(@@) ||| 65(@)(@)(@@) @HAD09 والله ما كتمت وشيمة ولا كذبت كذبة(@)(@)(@@)(@@)(@@) ||| 66(@)(@)(@@) @HAD010 وفور المال عوض بابتذال المال وصلاح الدين بإفساد الدنيا(@)(@)(@@)(@@)(@@) ||| 67(@)(@)(@@) @HAD015 وقود النار يوم القيامة كل بخيل بماله على الفقرآء وكل عالم باع الدين بالدنيا(@)(@)(@@)(@@)(@@) ||| 68(@)(@)(@@) @HAD07 واضع العلم عند غير أهله ظالم له(@)(@)(@@)(@@)(@@) ||| 69(@)(@)(@@) @HAD07 واضع معروفه عند غير مستحقه مضيع له(@)(@)(@@)(@@)(@@) ||| 70(@)(@)(@@) @HAD05 ورع المؤمن يظهر في علمه(@)(@)(@@)(@@)(@@) ||| 71(@)(@)(@@) @HAD07 ورع المنافق لا يظهر إلا فى لسانه(@)(@)(@@)(@@)(@@) ||| 72(@)(@)(@@) @HAD022 والله ما فجئني من الموت وارد كرهته ولا طالع أنكرته ولا كنت إلا كعازب ورد ولا طالب وجد(@)(@)(@@)(@@)(@@) ||| 73(@)(@)(@@) @HAD018 والله ما منع الحق أهله وأزاح الحق عن مستحقه إلا كل كافر جاحد ومنافق ملحد(@)(@)(@@)(@@)(@@) ||| 74(@)(@)(@@) @HAD015 ولئن أمهل الله سبحانه الظالم فلن يفوته أخذه وهو له بالمرصاد على مجاز(@)(@)PageV01P730(@)(@)(@@) @HAD07 طريقه وبموضع الشجا من مجاز ريقه(@)(@)(@@)(@@)(@@) ||| 75(@)(@)(@@) @HAD09 وجهك ماء جامد يقطره السؤال فانظر عند من تقطره(@)(@)(@@)(@@)(@@) ||| 76(@)(@)(@@) @HAD05 وزر صدقة المنان يغلب أجره(@)(@)(@@)(@@)(@@) ||| 77(@)(@)(@@) @HAD06 وحدة المرء خير من جليس السوء(@)(@)(@@)(@@)(@@) ||| 78(@)(@)(@@) @HAD09 وضع الصنيعة في أهلها تكبت العدو وتقي السوء(@)(@)(@@)(@@)(@@) ||| 79(@)(@)(@@) @HAD011 وجدت المسالمة ما لم يكن وهن فى الإسلام أنجع من القتال(@)(@)(@@)(@@)(@@) ||| 80(@)(@)(@@) @HAD09 وجدت الحلم والإحتمال أنصر لي من شجعان الرجال(@)(@)(@@)(@@)(@@) ||| 81(@)(@)(@@) @HAD013 والله لا يعذب الله سبحانه مؤمنا 
ms270	 إلا بسوء ظنه وسوء خلقه(@)(@)(@@)(@@)(@@) ||| 82(@)(@)(@@) @HAD020 وصول المرء إلى كل ما يبتغيه من طيب عيشه وأمن سيرته وسعة رزقه بحسن نيته وسعة من خلقه(@)(@)(@@)(@@)(@@) ||| 83(@)(@)(@@) @HAD028 والذي فلق الحبة وبرء النسمة ما أسلموا ولكن استسلموا وأسروا الكفر فلما وجدوا أعوانا عليه أعلنوا ما كانوا أسروا وأظهروا ما كانوا أبطنوا(@)(@)(@@)(@@)(@@) ||| 84(@)(@)(@@) @HAD014 والذي بعث بالحق نبيا لتبلبلن بلبلة ولتغربلن غربلة ولتساطن سوط القدر(@)(@)PageV01P731(@)(@)(@@) @HAD017 حتى يعلو أسفلكم أعلاكم وأعلاكم أسفلكم وليسبقن سابقون كانوا قصروا وليقصرن سابقون كانوا سبقوا(@)(@)(@@)(@@)(@@) ||| 85(@)(@)(@@) @HAD042 والله لئن أبيت على حسك السعدان مسهدا وأجر في الأغلال مصفدا أحب إلى من أن القى الله ورسوله ظالما لبعض العباد أو غاصبا لشيء من الحطام وكيف أظلم لنفس يسرع إلى البلى قفولها ويطول في الثرى حلولها(@)(@)(@@)(@@)(@@) ||| 86(@)(@)(@@) @HAD095 ولقد علم المستحفظون من أصحاب محمد (صلى الله عليه وآله) إنى لم أرد على الله سبحانه ولا على رسوله ساعة قط ولقد واسيته بنفسي في المواطن التي تنكث فيها الأبطال وتتأخر عنها الأقدام نجدة أكرمني الله بها ولقد بذلت في طاعته (صلوات الله عليه) جهدي ولقد جاهدت أعداه بكل طاقتي ووقيته بنفسي ولقد أفضى إلي من علمه ما لم يفض به إلى أحد غيري ولقد قبض رسول الله (صلى الله عليه وآله وسلم) وإن رأسه لعلى صدري ولقد سالت نفسه في(@)(@)PageV01P732(@)(@)(@@) @HAD047 كفي فأمررتها في وجهى ولقد وليت غسله (صلى الله عليه وآله وسلم) والملائكة أعواني فضجت الدار والأفنية ملاء يهبط وملاء يعرج وما فارقت سمعي هينمة منهم يصلون عليه حتى واريناه في ضريحه فمن ذا أحق به مني حيا وميتا(@)(@)(@@)(@@)(@@) ||| 87(@)(@)(@@) @HAD023 واتقوا الله الذي أعذر بما أنذر واحتج بما أبهج وحذركم عدوا نفذ في الصدور خفيا ونفث في الآذان نجيا(@)(@)(@@)(@@)(@@) ||| 88(@)(@)(@@) @HAD030 وأيم الله لئن فررتم من سيف العاجلة لا تسلموا من سيوف الآخرة وأنتم لهاميم العرب والسنام الأعظم فاستحيوا من الفرار فإن فيه إدراع العار وولوج النار(@)(@)(@@)(@@)(@@) ||| 89(@)(@)(@@) @QUR@08 وسيق الذين اتقوا ربهم إلى الجنة زمرا @HAD@ قد أمن العقاب وانقطع العتاب وزحزحوا عن النار واطمانت بهم الدار ورضوا 
ms271	 المثوى والقرار(@)(@)(@@)(@@)(@@) ||| 90(@)(@)(@@) @HAD033 والذي فلق الحبة وبرء النسمة لو لا حضور الحاضر وقيام الحجة بوجود الناصر وما أخذ الله سبحانه على العلماء أن لا يقاروا على كظة ظالم ولا سغب مظلوم(@)(@)PageV01P733(@)(@)(@@) @HAD018 لألقيت حبلها على غاربها ولسقيت آخرها بكأس أولها ولألفيتم دنياكم هذه عندي أزهد من عفطة عنز(@)(@)PageV01P734(@)(@)(@@)(@@)(@@) ||| الفصل الرابع والثمانون مما ورد من حكم امير المؤمنين علي بن ابيطالب (عليه السلام) في حرف الهاء من ذلك قوله (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD05 هدى الله سبحانه أحسن الهدى(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD05 هدي من أشعر قلبه التقوى(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD05 هدي من تجلبب جلباب الدين(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD07 هدي من ادرع لباس الصبر واليقين(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD012 هدي من سلم مقادمه إى الله سبحانه ورسوله وولي أمره(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD07 هدي من أطاع ربه وخاف ذنبه(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD05 وقال (عليه السلام):(@)(@)(@@) @HAD015 في ذكر الملائكة (عليهم السلام) هم أسراء الإيمان لم يفكهم منه زيغ ولا عدول(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD08 هلك فى رجلان محب غال ومبغض قال(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD04 هلك من لم يعرف(@)(@)PageV01P735(@)(@)(@@) @HAD01 قدره(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD07 هلك من لم يحرز سره وأمره(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD018 في ذكر المنافقين هم لمة الشيطان وحسمة النيران اولئك حزب الشيطان ألا إن حزب الشيطان هم الخاسرون(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD014 وروي أنه (عليه السلام) مر على مزبلة فقال هذا ما بخل به الباخلون(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD07 هلك من افترى وخاب من ادعى(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD010 هلك من أضله الهوى واستقاده الشيطان إلى سبيل العمى(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD010 هلك من رضي عن نفسه ووثق بما تسوله له(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD09 هيهات من نيل السعادة السكون إلى الهواني والبطالة(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD05 في ذكر بني أمية:(@)(@)(@@) @HAD010 هي مجاجة من لذيذ العيش يتطعمونها برهة ويلفظونها جملة(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD011 هلك من باع اليقين بالشك والحق بالباطل والآجل بالعاجل(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD014 هل ينتظر أهل مدة البقاء إلا آونة الفناء مع قرب الزوال وأزوف الإنتقال(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD08 هلك خزان الأموال وهم أحياء والعلماء(@)(@)PageV01P736(@)(@)(@@) @HAD013 باقون ما بقي الليل والنهار أعيانهم مفقودة وأمثالهم في القلوب موجودة(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD018 هلك من استأمن إلى الدنيا وأمهرها دينه فهو حيث مالت مال إليها قد اتخذها همها ومعبوده(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD07 هل ينتظر أهل الشباب إلا حواني الهرم 
ms272	(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD08 هل ينتظر أهل غضارة الصحة إلا نوازل السقم(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD07 هل تدفع عنكم الأقارب أو تنفعكم النواجب(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD010 هيهات ما تناكرتم إلا لما قبلكم من الخطايا والذنوب(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD013 هل من خلاص أو مناص أو ملاذ أو معاذ أو قرار أو مجاز(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD011 هون عليك الأمر فإن الأمر قريب والإصطحاب قليل والمقام يسير(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD010 هدم رفيق الباطل بعد كظوم وصال الدهر صيال السبع العقور(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD07 هيهات لو لا التقى لكنت أدهى العرب(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD011 هيهات أن يفوت الموت من طلب أو ينجو منه من هرب(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD03 هيهات أن ينجو(@)(@)PageV01P737(@)(@)(@@) @HAD09 الظالم من أليم عذاب الله سبحانه وعظيم سطواته(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD014 هيهات لا يخدع الله سبحانه في جنته ولا ينال ما عنده إلا بمرضاته(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD011 هو الله الذي تشهد له أعلام الوجود على قلب ذوي الجحود(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD05 وفي وصف الدنيا:(@)(@)(@@) @HAD09 هي الصدود العنود والحيود الميود والخدوع الكنود(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD04 في وصف القرآن:(@)(@)(@@) @HAD013 هو الذي لا تزيغ به الأهواء ولا يلتبس به الشبه والآراء(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD09 هلك الفرحون بالدنيا يوم القيامة ونجى المحزونون بها(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD028 هل تنظر إلا فقيرا يكابد فقرا أو غنيا بدل نعم الله سبحانه كفرا أو بخيلا إتخذ البخل بحق الله وفرا أو متمردا كأن بأذنيه عن سمع المواعظ وقرا(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD07 في ذكر القرآن: هو الفصل ليس بالهزل(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD07 هو الناطق بالسنة العدل والأمر بالفضل(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD07 هو حبل الله المتين والذكر الحكيم(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD014 هو وحي الله الأمين وحبله المتين وهو ربيع القلوب وينابيع العلم(@)(@)PageV01P738(@)(@)(@@) @HAD03 وهو الصراط(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD020 هو هدى لمن ائتم به وزينة لمن تحلى به وعصمة لمن اعتصم به وحبل لمن تمسك به(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD011 هذا اللسان جموح بصاحبه هم المؤمن لآخرته وكل جده لمنقلبه(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @HAD04 في ذكر الإسلام:(@)(@)(@@) @HAD09 هو أبلج المناهج، نير الولائج، مشرق الأقطار، رفيع الغاية(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD05 وقال (عليه السلام):(@)(@)(@@) @HAD026 في حق الأشتر النخعي (رضوان الله عليه)، هو سيف الله لا ينبو عن الضرب ولا كليل الحد لا يستوهبه بدعة ولا تثنيه يد غواية(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD020 وفي ذكر من ذمه هو بالقول مدل ومن 
ms273	 العمل مقل وعلى الناس على طاعن ولنفسه مداهن(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD028 هو في مهلة من الله سبحانه يهوى مع الغافلين ويغدو مع المذنبين بلا سبيل قاصد ولا إمام قائد ولا علم مبين ولا دين متين(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD07 هو يخشى الموت ولا يخاف الفوت(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD010 هب ما أنكرت لما عرفت وما جهلت لما علمت(@)(@)PageV01P739(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD011 هب اللهم لنا رضاك وأغننا عن مد الأيدى إلى سواك(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD010 هواك أعدى عليك من كل عدو فاغلبه وإلا أهلكك(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD010 هموم الرجل على قدر همته وغيرته على قدر حميته(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD09 هم الكافر لدنياه وسعيه لعاجلته وغايته شهوته(@)(@)(@@)(@@)(@@) ||| 54(@)(@)(@@) @HAD050 وقال (عليه السلام) في حق من أثنى عليهم هجم بهم العلم على حقيقة الإيمان وباشروا روح اليقين فاستسهلوا ما استوعر المترفون وآنسوا بما استوحش منه الجاهلون صحبوا الدنيا بأبدان أرواحها معلقة بالمحل الأعلى اولئك خلفاء الله في أرضه والدعاة إلى دينه آه آه شوقا إلى رؤيتهم(@)(@)(@@)(@@)(@@) ||| 55(@)(@)(@@) @HAD053 وقال (عليه السلام) في وصف آل الرسول (صلوات الله عليه وعليهم): هم دعائم الإسلام وولائج الإعتصام بهم عاد الحق في نصابه وانزاح الباطل عن مقامه وانقطع لسانه عن منبته عقلوا الدين عقل وعاية ورواية هم موضع سر رسول الله (صلى الله عليه وآله) وحماة أمره(@)(@)PageV01P740(@)(@)(@@) @HAD039 وأوعية علمه وموئل حكمه وكهوف كتبه وحبال دينه، هم كرائم الإيمان وكنوز الرحمن إن قالوا صدقوا وإن صمتوا لم يسبقوا هم كنوز الإيمان ومعادن الإحسان إن حكموا عدلوا وإن حاجوا خصموا(@)(@)(@@)(@@)(@@) ||| 56(@)(@)(@@) @HAD013 هم أساس الدين وعماد اليقين إليهم يفييء الغالى وبهم يلحق التالي(@)(@)(@@)(@@)(@@) ||| 57(@)(@)(@@) @HAD012 هم مصابيح الظلم وينابيع الحكم ومعادن العلم ومواطن الحلم(@)(@)(@@)(@@)(@@) ||| 58(@)(@)(@@) @HAD028 هم عيش الحلم وموت الجهل يخبركم حلمهم عن علمهم وصمتهم عن منطقهم لا يخالفون الحق ولا يختلفون فيه فهو بينهم صامت ناطق وشاهد صادق(@)(@)PageV01P741(@)(@)(@@)(@@)(@@) ||| الفصل الخامس والثمانون مما ورد من حكم امير المؤمنين علي بن 