ms1321	 عشيرة اللهيبات الساكنة في الجعارة بالعراق.(@)(@@) العزاوي 3/ 253(@)(@@)(@@)(@@) $ كاطع (قاطع) :(@)(@@) فرع من البو حسن من البو فراج من العزة بالعراق.(@)(@@) العزاوي 3/ 182(@)(@@)(@@)(@@) $ الكاطع:(@)(@@) فرع من السكران من البو حميرة من آل ازيرج في المنتفق بالعراق.(@)(@@) العزاوي 3/ 73(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكاظم:(@)(@@) </span></span>(@)(@@) فخذ من القراغول بالعراق.(@)(@@) الطاهر 1/ 209(@)(@@) الكاظم:(@)(@@) فرع من الكراغول (القراغول) من عشيرة آل حميد بالعراق.(@)(@@) العزاوي 3/ 58(@)(@@) الكاظم:(@)(@@) فخذ من القراغول من الأجود بالعراق.(@)(@@) العزاوي 4/ 105(@)(@@) PageV05P141(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كاظم (آل) :(@)(@@) </span>(@)(@@) فرع من آل حسينية من الجنابات بالعراق. يقيم في الشامية.(@)(@@) العزاوي 3/ 104(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كاظم (البو) :(@)(@@) </span></span></span></span></span>(@)(@@) فرع من البو حمود من الجعافرة من العنبكية (العنبقية) بالعراق.(@)(@@) العزاوي 4/ 223(@)(@@) كاظم (البو) :(@)(@@) فرع من البو شعبان من البو عامر من طيء بالعراق.(@)(@@) العزاوي 3/ 242(@)(@@) كاظم (البو) :(@)(@@) فرع من البو علي من العبيد بالعراق.(@)(@@) العزاوي 3/ 155(@)(@@) كاظم (البو) :(@)(@@) فرع من البو غيث من القراغول في أنحاء المحمودية بالعراق.(@)(@@) العزاوي 3/ 128(@)(@@) كاظم (البو) :(@)(@@) فرع من البو فضل من البو علي بالعراق.(@)(@@) العزاوي 3/ 155(@)(@@) كاظم (البو) :(@)(@@) فرع من البو لطيف من المشاهدة بالعراق.(@)(@@) العزاوي 4/ 238(@)(@@) كاظم (آل) :(@)(@@) فرع من آل ياسر بالعراق.(@)(@@) العزاوي 4/ 244(@)(@@)(@@)(@@) $ كاظم العبد الله (البو) :(@)(@@) فخذ من الكروية من قيس بالعراق.(@)(@@) العزاوي 4/ 104(@)(@@)(@@)(@@) $ كاظمية (البو) :(@)(@@) فرع من حجام الجزيرة من حجام بالعراق.(@)(@@) الطاهر 1/ 113(@)(@@)(@@)(@@) $ الكافرة (أولاد) :(@)(@@) فخذ من الأجود من غزية من طيء.(@)(@@) القلائد 88(@)(@@)(@@)(@@) $ الكامل:(@)(@@) فرع من العيسى من بني سعيد بالعراق.(@)(@@) الطاهر 1/ 226(@)(@@) PageV05P142(@)(@@)(@@)(@@) $ كامل (البو) :(@)(@@) فخذ من بني ركاب بالعراق.(@)(@@) الطاهر 1/ 211(@)(@@)(@@)(@@) $ كايم (آل قايم) :(@)(@@) فرع من الشيحان من العبيج بالعراق.(@)(@@) العزاوي 4/ 84(@)(@@)(@@)(@@) $ الكبيسات:(@)(@@) فرقة من البو خميس الراشد بسورية. عدد بيوتها 80. مراكزها الرئيسية: الجبول ودير حافر بمنطقة منبج من محافظة حلب، ومناطق تجولها: جبل البشري.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ كبر (البو) :(@)(@@) فرع من البو عكاش من خلفة خميس بالعراق. يسكن في الازركية.(@)(@@) العزاوي 3/ 123(@)(@@)(@@)(@@) $ الكبلان (القبلان) :(@)(@@) فرع من البو غنيمة من البو محمد النمر من البو نمر من البو سالم بالعراق.(@)(@@) العزاوي 3/ 113(@)(@@)(@@)(@@) $ الكبيب:(@)(@@) فرع من أولاد الشايب من البو هيازع من خلفة 
ms1322	 دويمع بالعراق، ويقال له: البو عواد.(@)(@@) العزاوي 4/ 156(@)(@@)(@@)(@@) $ الكبيش:(@)(@@) فخذ من الجلال من المجمع بالعراق. يسكن في الابراهيمية.(@)(@@) العزاوي 4/ 212(@)(@@)(@@)(@@) $ الكبيشات:(@)(@@) فخذ من البو هيازع من خلفة دويمع بالعراق. من فروعه: الغوالبة، البو عيسى، البو جنيحن، المناهلة، الولايدة والمخايلة.(@)(@@) العزاوي 3/ 156، 157(@)(@@)(@@)(@@) $ كتايب (البو) :(@)(@@) فخذ من عشيرة الحلاف الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 67(@)(@@)(@@)(@@) $ الكحاطنة (القحاطنة) :(@)(@@) فخذ من الكروية من قيس بالعراق.(@)(@@) الطاهر 4/ 205(@)(@@) PageV05P143(@)(@@)(@@)(@@) $ كحيلين (آل) :(@)(@@) فرع من آل سعيد من الغنائمة بالعراق.(@)(@@) الطاهر 1/ 107(@)(@@)(@@)(@@) $ الكدور (القدرو) :(@)(@@) فرع من البو سلمان من أولاد سلمان بن خميس من المحامدة بالعراق.(@)(@@) العزاوي 3/ 126(@)(@@)(@@)(@@) $ الكديرات (القديرات) :(@)(@@) فرع من الجوالة من سنبس بالعراق. يقيم في أنحاء العبيد.(@)(@@) العزاوي 3/ 240(@)(@@)(@@)(@@) $ الكديشات:(@)(@@) فرع من البو حسين من الظوالم بالعراق.(@)(@@) العزاوي 4/ 126(@)(@@)(@@)(@@) $ الكرابجة:(@)(@@) فخذ من النوافلة من الظيفة من الموسى من ناصرة من بلحارث بالسعودية، وسكناه السد (م) حمد الجاسر: العرب 6/ 608(@)(@@)(@@)(@@) $ الكرابلة:(@)(@@) من عشائر العراق. تسكن في الجزيرة بجوار البو هزيم في أراضي الحماميات، وهي مشتتة ومعظم أفرادها في الرحبة، ومنها في أراضي الداوودية قرب الراشدية. وأفخاذها: البو حسن، البو شهاب، الذبات، البو عساف، البو عجاج، البو جاسم، البو خالد، البو حسين، والبكر العزاوي 4/ 118، 119(@)(@@)(@@)(@@) $ الكرات:(@)(@@) فخذ من الكرخية بالعراق.(@)(@@) العزاوي 4/ 208(@)(@@)(@@)(@@) $ الكرازية:(@)(@@) فخذ من اليزيد من البيعرب من الموسى من ناصرة من بلحارث بالسعودية. وسكناه: قرية زيان والهياضلة.(@)(@@)(@@)(@@) $ الكراشين:(@)(@@) بطن من الطفلة من ذوي حطاب من الشلاوى من بلحارث بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 608(@)(@@)(@@)(@@) $ الكرايعة:(@)(@@) فخذ من المنسي من اليزيد من الموسى من ناصرة من بلحارث بالسعودية وسكناه: وادي الصور، ووادي مثان.(@)(@@) (م) حمد الجاسر: العرب 6/ 608(@)(@@) PageV05P144(@)(@@)(@@)(@@) $ الكرارصة:(@)(@@) فخذ من بني عجيل بالعراق.(@)(@@) العزاوي 3/ 52(@)(@@)(@@)(@@) $ كراكشة:(@)(@@) فخذ من الطفيل. يقيم في الهندية بالعراق.(@)(@@) العزاوي 4/ 153(@)(@@)(@@)(@@) $ كران (البو قران) :(@)(@@) فرقة من الزهيرية بالعراق.(@)(@@) العزاوي 4/ 207(@)(@@)(@@)(@@) $ الكرانصة (القرانصة) :(@)(@@) فرع من الكرنوص من الملحم من العدية من الجلال من المجمع بالعراق.(@)(@@) العزاوي 4/ 212(@)(@@)(@@)(@@) $ الكربول:(@)(@@) فرع من آل نجم من البدور بالعراق.(@)(@@) العزاوي 4/ 94، الطاهر 1/ 179(@)(@@)(@@)(@@) $ الكرخية:(@)(@@) من عشائر قيس 
ms1323	 بالعراق. تسكن في ناحية كنعان وفرقها: الوشاحات الكرات، الفضول، العرينات، الجلالات، العمادات، النعيمات، السوارية، والشميسات.(@)(@@) العزاوي 4/ 208(@)(@@)(@@)(@@) $ الكرداويون (القراديون) :(@)(@@) فرع من البو غيث من القراغول في أنحاء المحمودية بالعراق.(@)(@@) العزاوي 3/ 128(@)(@@)(@@)(@@) $ الكردوش:(@)(@@) فرع من عبادات من عبدة من السبعة بسورية. عدد بيوته 45.(@)(@@) مراكزه الرئيسية: الحماد إلى شرقي جبل عنزة، والقعرة حتى وادي حوران، ومناطق تجوله: وادي حوران، جبل البشري، قديم (كديم) أسرية، وسلمية.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ الكردي:(@)(@@) فرع من المحمد العامر من الشللة من بني سبعة بالعراق.(@)(@@) العزاوي 3/ 263(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كردي (ال(@)(@@) بو) :</span>(@)(@@) فخذ من بني زيد بالعراق.(@)(@@) العزاوي 3/ 60(@)(@@) PageV05P145(@)(@@)(@@)(@@) $ كردي (آل) :(@)(@@) فخذ من البو صالح من بني مالك بالعراق. فروعه: الحمد، والبو حسين.(@)(@@) الطاهر 1/ 154، العزاوي 4/ 32(@)(@@)(@@)(@@) $ الكرشة:(@)(@@) من الأفخاذ الملحقة بعشيرة المجمع بالعراق. يقيم في خريسان.(@)(@@) العزاوي 4/ 214(@)(@@)(@@)(@@) $ الكرطان:(@)(@@) من عشائر العراق.(@)(@@) تسكن مع الدليم وفي مواطن أخرى، أصلها من جيس (قيس) ، ومواطنها في الحماميات بحدود الملاحمة، وفي أراضي الدجيلة شرقي صدر اليوسفية وغربيها من تل أسود إلى صدر الحلان قرب الدير ومن صدر اليوسفية إلى صدر المحمودية وفي أراضي فحيل.(@)(@@) وأفخاذها: البو عبوس، البو فارس، البو سليمان، البو حبيب، البو شيخان، البو حسن، البو سويد، الدراوشة، البو يونس، والبو جبر.(@)(@@) العزاوي 3/ 136- 137(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكرعان (القرعان) :(@)(@@) </span>(@)(@@) فرع من الثلث من الكعيدات (العقيدات) بالعراق.(@)(@@) يقيم في الشامية والجزيرة.(@)(@@) العزاوي 3/ 132(@)(@@) الكرعان (القرعان) :(@)(@@) فرع من الشللة من بني سبعة بالعراق، ويسكن قرب العقيدات في دير الزور.(@)(@@) العزاوي 3/ 263(@)(@@)(@@)(@@) $ الكرعان:(@)(@@) فرع من البو عبود من البو محمد بالعراق.(@)(@@) العزاوي 3/ 64(@)(@@)(@@)(@@) $ كرفان:(@)(@@) بطن من مرسد من الخرمان من الهجال من الصعوب من بني عبد الله بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 173(@)(@@)(@@)(@@) $ الكرفوش:(@)(@@) فرع من الرواشد من آل شلال من الخزاعل بالعراق.(@)(@@) العزاوي 3/ 247(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكركوش:(@)(@@) </span>(@)(@@) فخذ قيل من المطيرات(@)(@@) PageV05P146(@)(@@) من عشيرة بني خيكان (خيقان) الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 61(@)(@@)(@@)(@@) $ الكركوش:(@)(@@) فخذ من الشمس من بني سعيد بالعراق.(@)(@@) الطاهر 1/ 227(@)(@@)(@@)(@@) $ كركوش (بيت) :(@)(@@) من بيوت إمارة ربيعة بالعراق.(@)(@@) العزاوي 4/ 165(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكرم:(@)(@@) </span>(@)(@@) فخذ من البو 
ms1324	 الهوش من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 149(@)(@@) الكرم:(@)(@@) فرع من البو خليفة من آل شمس بالعراق.(@)(@@) الطاهر 1/ 160(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كرم (البو) :(@)(@@) </span>(@)(@@) فرع من البو جارود من العنبكية (العنبقية) بالعراق.(@)(@@) العزاوي 4/ 224(@)(@@) كرم (البو) :(@)(@@) فرع من البو خضير من الجمعة من الظوالم بالعراق.(@)(@@) العزاوي 4/ 127(@)(@@)(@@)(@@) $ الكرنة:(@)(@@) فخذ من البو صكر (صقر) من الجنابيين بالعراق. من فروعه:(@)(@@) العشبة، الصعمة، البعيجي، الجابر، آل جن، الشعير، وهؤلاء الآن مع الثابت من شمر، والخضير، وآل هويكص، والجويبر والبلال وهؤلاء في أنحاء اللطيفية.(@)(@@) العزاوي 3/ 98، 99(@)(@@)(@@)(@@) $ الكرنة (القرنة) :(@)(@@) من الأفخاذ الملحقة بعشيرة المجمع بالعراق، يقيم في أراضي بني سعد في بلد وفي المشيرية.(@)(@@) العزاوي 4/ 214(@)(@@)(@@)(@@) $ كرنوص (آل قرنوص) :(@)(@@) فخذ من الخزاعل بالعراق. يسكن في الرميثة.(@)(@@) العزاوي 3/ 248(@)(@@)(@@)(@@) $ الكروش (القروش) :(@)(@@) فخذ من الأكرع بالعراق، ويتفرع إلى نفس الكروش والشواظي.(@)(@@) العزاوي 3/ 207(@)(@@)(@@)(@@) $ الكروية:(@)(@@) من العشائر القيسية، وهي ذات أطناب، تسكن في أراضي كروه لي(@)(@@) PageV05P147(@)(@@) في الراوية من ناحية السعدية وقره تبه في مقاطعة الكاووري والاحيمر والمحمولة وبردان، وكيفه جي، وحجات، وجيس، وجبلاغ، والخلاوية.(@)(@@) ويجاورها العزة، واللهيب، والبيات، والطاطران، والبلانية، وبنو ويس، وربيعة وان قراهم بأسماء أراضيها.(@)(@@) وفرقها: المصاليخ، والبو نزال، الدويان، الحمامدة، البو كاظم، العبد الله، الغلامات، الخميس، البو دراج، الصوافي، الكحاطنة، الرحاملة، الصبابحة، الدراوشة، العويسات، الشميسات، والنزارات.(@)(@@) ويلحق بها: الطوالات من حرب، والسواكن، والجميلة، والبجاجيل، والسجافات، والحشامات.(@)(@@) العزاوي 4/ 201- 205(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كريدي (البو) :(@)(@@) </span></span>(@)(@@) فرع من آل سهلان من آل ازيرج في المنتفق بالعراق.(@)(@@) العزاوي 3/ 74، الطاهر 1/ 176(@)(@@) كريدي (البو) :(@)(@@) فخذ من عشيرة بني مسلم الملحقة بعشيرة الطفيل بالعراق.(@)(@@) العزاوي 4/ 154(@)(@@) كريدي (البو) :(@)(@@) فرع من آل محسن من آل شلال من الخزاعل بالعراق.(@)(@@) العزاوي 3/ 248(@)(@@)(@@)(@@) $ كرير (البو) :(@)(@@) فرع من البو حويجمة من الجمعة من الظوالم بالعراق.(@)(@@) العزاوي 4/ 126(@)(@@)(@@)(@@) $ الكريش (قريش) :(@)(@@) من عشائر العراق. تسكن في جانبي دجلة في أنحاء البغيلة (النعمانية) وفرقها: الحجي، والفرج (فري) .(@)(@@) العزاوي 4/ 171- 173(@)(@@)(@@)(@@) $ كريش (البو قريش) :(@)(@@) فرع من البو دلي من البو بكر من العزة بالعراق.(@)(@@) العزاوي 3/ 175(@)(@@)(@@)(@@) $ كريش (بيت قريش) :(@)(@@) فخذ من الكطارنة بالعراق.(@)(@@) العزاوي 4/ 192 
ms1325	(@)(@@)(@@)(@@) $ الكريشات:(@)(@@) فرع من آل صالح من بني ركاب (رجاب) بالعراق. يسكن في(@)(@@) PageV05P148(@)(@@) أراضي العكرة (العقرة) ، وأم جميل، وبيش يعكوب (يعقوب) .(@)(@@) العزاوي 3/ 194(@)(@@)(@@)(@@) $ كريشة:(@)(@@) فرع من البو حبيب من الكرطان بالعراق.(@)(@@) العزاوي 3/ 137(@)(@@)(@@)(@@) $ الكريط:(@)(@@) من عشائر العراق.(@)(@@) تقيم في طويريج بأراضي الصليعة من الجذول الغربي والمنفهان وخبازة وأبي روية وغيرها.(@)(@@) وفرقها: البو خلف، الحوافظ، العشائر، والحويفظات. ويجاورها في جانب الحلة آل يسار، وآل فتلة، وبنو حسن، وجليحة. ويتبعها الكرافة، والخوالد، والعبودة.(@)(@@) ومن الكريط من يسكن قرب سوق الشيوخ، وهم: البو خلف، الحوافظ، ومن الكريط من يسكن في الشامية وبالمشخاب وبالمحمودية.(@)(@@) والجعافرة يرجعون إلى البو خلف، والحوافظ من العنبكية من الحويفظات. ومن هذا يرى الباحث اشتباك العشائر وتداخلها كثيرا.(@)(@@) العزاوي 4/ 226- 228(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كريطي (قريطي) :(@)(@@) </span>(@)(@@) فرع من البو مهنا من البو عيسى بالعراق يسكن بالعامرية ومنه الجويثات.(@)(@@) العزاوي 3/ 259(@)(@@) كريطي (قريطي) :(@)(@@) فخذ من خفاجة بالعراق.(@)(@@) العزاوي 4/ 150(@)(@@)(@@)(@@) $ الكريعات:(@)(@@) فخذ من اللهيب بالعراق.(@)(@@) يقيم في ناحية المحاويل. وفروعه: البو كرير، البو حسن، البو عبيد، الدبيسات، البو صالح، البو شاووش، ويقيم قسم كبير من الكريعات في ناحية الأعظمية، وتسمى المحلة باسمهم.(@)(@@) العزاوي 3/ 95(@)(@@)(@@)(@@) $ كريفع (قريفع) :(@)(@@) فخذ من خلفة خميس بالعراق. يسكن قسم منه في بغداد،(@)(@@) PageV05P149(@)(@@) ويرجع أصل نسبه إلى خضر من خميس، ويتقرع إلى: البو جنعان، والبو عجيمي.(@)(@@) العزاوي 3/ 125(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ ال(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كريم:(@)(@@) </span></span></span>(@)(@@) فرع من آل عبد الرحمن من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 148(@)(@@) الكريم:(@)(@@) فخذ من الشرش (الشرس) بالبصرة.(@)(@@) الطاهر 1/ 330، العزاوي 4/ 67(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كريم (آل) :(@)(@@) </span></span>(@)(@@) فخذ من البو جياش بالعراق.(@)(@@) العزاوي 4/ 133(@)(@@) كريم (آل) :(@)(@@) فخذ من آل حمزة يقيم في أبي خزامة، وفي أم العجبان بالعراق.(@)(@@) العزاوي 4/ 159(@)(@@) كريم:(@)(@@) فرع من آل عليوي من الغزي من بني لام بالعراق.(@)(@@) العزاوي 3/ 230(@)(@@) كريم (آل) :(@)(@@) من عشائر العمارة بالعراق. موطنها شمالي الصديفة.(@)(@@) (م) جونز: المورد س 3 ع 1/ 43(@)(@@)(@@)(@@) $ كريم (بنو) :(@)(@@) بطن من الحسكان من ناصرة من بلحارث بالسعودية. ومنهم:(@)(@@) آل غزال والربع والبراهيم والغطفة، والقحارشة، وسكناهم العطاء بميسان، والجعدة وسكناهم الشهباء بوادي ميسان، والزحمة وسكناهم 
ms1326	 المناضيج.(@)(@@) (م) حمد الجاسر: العرب 6/ 173(@)(@@)(@@)(@@) $ كريم (بو) :(@)(@@) فخذ من عشيرة السودان بالعراق.(@)(@@) العزاوي 4/ 196، الطاهر 1/ 305(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كريم (البو) :(@)(@@) </span>(@)(@@) فخذ من البو عطوان من آل ازيرج (الازيرق) في العمارة بالعراق.(@)(@@) العزاوي 3/ 79(@)(@@) كريم (البو) :(@)(@@) فرع من آل ربيع من آل ازيرج (الازيرق) في العمارة بالعراق.(@)(@@) العزاوي 3/ 76(@)(@@) PageV05P150(@)(@@)(@@)(@@) $ كريم:(@)(@@) فرع من الوحيلات من الأخشاب من السراي (السراج) بالعراق.(@)(@@) العزاوي 4/ 170(@)(@@)(@@)(@@) $ الكريون:(@)(@@) فرع من البو طرفة من آل حاتم من بني ركاب (رجاب) بالعراق.(@)(@@) العزاوي 3/ 196(@)(@@)(@@)(@@) $ كسار (البو) :(@)(@@) من عشائر الوسطيين بمحافظة دير الزور بسورية.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ الكشان:(@)(@@) فرع من البو سوف من الحسينات بالعراق.(@)(@@) الطاهر 1/ 196(@)(@@)(@@)(@@) $ كشموط (بيت) :(@)(@@) فخذ من عشيرة البو حمادي الملحقة بعشيرة السودان بالعراق.(@)(@@) العزاوي 4/ 197(@)(@@)(@@)(@@) $ الكشوش:(@)(@@) فرقة من عشيرة أهالي الشلهة الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 68(@)(@@)(@@)(@@) $ الكشيش:(@)(@@) فرع من الصليحات من آل إبراهيم بالعراق.(@)(@@) الطاهر 1/ 128(@)(@@)(@@)(@@) $ كشيش (البو) :(@)(@@) فخذ من عشيرة بني مسلم الملحقة بعشيرة الطفيل بالعراق.(@)(@@) العزاوي 3/ 154(@)(@@)(@@)(@@) $ كصاعمة (قصاعمة) :(@)(@@) فرع من الطجاح من تميم بالعراق.(@)(@@) العزاوي 3/ 219(@)(@@)(@@)(@@) $ الكصب (القصب) :(@)(@@) فخذ من النوافلة من الجنابيين بالعراق. يقيم قسم منه في شيشبار وفي جرف الصخر والاسكندرية من فروعه: العلوش، والمحمد.(@)(@@) العزاوي 3/ 101(@)(@@)(@@)(@@) $ الكصري (القصري) :(@)(@@) فرع من الدريس من الصكر (الصقر) من الجنابيين بالعراق.(@)(@@) العزاوي 3/ 98(@)(@@) PageV05P151(@)(@@)(@@)(@@) $ كصوان (آل قصوان) :(@)(@@) فرع من أهل الشط من عشيرة الصيام الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 64(@)(@@)(@@)(@@) $ الكصيرات (القصيرات) :(@)(@@) فرع من البو حمد من البو سلطان من زبيد الأكبر. يقيم في أراضي الكدس من ناحية المدحتية بالعراق.(@)(@@) العزاوي 3/ 38(@)(@@)(@@)(@@) $ الكضاة:(@)(@@) فخذ من الجبور بالعراق.(@)(@@) يقيم في أنحاء الموصل وكركوك والقنطرة (ألتون كبري) وفي الشام.(@)(@@) العزاوي 3/ 86(@)(@@)(@@)(@@) $ كضيب (بو قضيب) :(@)(@@) فخذ من الشجير، ويتفرع إلى الحمدان، البو جريم، والبو كشاش.(@)(@@) العزاوي 3/ 49(@)(@@)(@@)(@@) $ كضيب (البو قضيب) :(@)(@@) فرع من البو دروبي من الحديديين في الموصل بالعراق.(@)(@@) العزاوي 3/ 190، 4/ 230(@)(@@)(@@)(@@) $ الكطارنة:(@)(@@) من عشائر العراق.(@)(@@) أفخاذها: بيت رباط، الشماخنة، وبيت كريش (قريش) .(@)(@@) العزاوي 4/ 192(@)(@@)(@@)(@@) $ كطان (آل قطان) :(@)(@@) فخذ من آل حاتم من بني ركاب (رجاب) بالعراق.(@)(@@) العزاوي 3/ 197 
ms1327	(@)(@@)(@@)(@@) $ كطاية (قطاية) :(@)(@@) فخذ من المشاهدة بالعراق. يسكن بقرب الحصيوة التابعة إلى الكاظمية.(@)(@@) العزاوي 4/ 238(@)(@@)(@@)(@@) $ كطبة (البو قطبة) :(@)(@@) فرع من البو دلي من البو بكر من العزة بالعراق.(@)(@@) العزاوي 3/ 174(@)(@@)(@@)(@@) $ كطل (البو قطل) :(@)(@@) فرع من البو محمد بن البو بكر من العزة بالعراق.(@)(@@) العزاوي 3/ 175(@)(@@)(@@)(@@) $ الكطلات:(@)(@@) فرع من البو شيخ علي من آل مطر من الجوازرية من جبور الواوي بالعراق.(@)(@@) العزاوي 3/ 88(@)(@@) PageV05P152(@)(@@)(@@)(@@) $ الكطو:(@)(@@) فخذ من ربيعة بالعراق.(@)(@@) يسكن في بلدروز (براز الروز) .(@)(@@) العزاوي 4/ 180(@)(@@)(@@)(@@) $ كطيش (آل قطيش) :(@)(@@) فرع من آل حاتم من بني ركاب (رجاب) بالعراق.(@)(@@) العزاوي 3/ 196(@)(@@)(@@)(@@) $ الكطيشات (القطيشات) :(@)(@@) فخذ من البو عامر من طيء بالعراق. يقيم في الراشدية والفلوجة والرمادي.(@)(@@) العزاوي 3/ 243(@)(@@)(@@)(@@) $ كطيمة (قطيمة) :(@)(@@) فخذ من بني زيد بالعراق. يسكن في لواء ديالي وأنحاء سلمان باك.(@)(@@) العزاوي 3/ 60(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كعب:(@)(@@) </span>(@)(@@) عشيرة عراقية تابعة لبني لام بالعراق. أفخاذها: بيت عزيز، النبدة، العصافرة، الحسن، بيت الملحة، زبيد، عمير الحاج، الدبيس، البو حمدان، عمامة، القويوات، بيت شاوي، بيت سنيد، بيت عطيوي، حجاج، عمارنة، قمر، مكيحيل، جلالات، بيت هويدر، جنادلة، عبد العبد، البو لطيف، العبد الله، عبد ويس.(@)(@@) الطاهر 1/ 312- 314(@)(@@) كعب:(@)(@@) من العشائر القديمة التي تنتسب إلى ربيعة إحدى القبائل الكبرى التي كانت في العراق، فتسلطت عليها إيران، ودام النزاع عليها مدة طويلة، ومنها مجموعات عديدة في العراق، كما تكونت إمارة كعب في إيران، وكانت تابعة للمشعشعين ثم حكم عليها نادر شاه، واستخدمها لمصالحه، كما أن كريم خان الزند في أيام حكمه استخدمها للتسلط على البصرة بواسطة أخيه صادق خان.(@)(@@) وتتكاثر عشيرة كعب في أنحاء الحويزة في المحمرة وما والاها، حيث امتدت في الجانب الشرقي من شط العرب، وتبعد المحمرة عن كردلان العراقية بمسافة ثماني ساعات مشيا وهي على يمين نهر كارون بالقرب من مصبه، وبقربها أطلال قرية بهذا الاسم، وفيها(@)(@@) PageV05P153(@)(@@) مقاطعات على يسار هذا النهر، تمتد نحو ساعتين، وفي اليمين يبلغ امتدادها نحو أربع ساعات، وتليها جزيرة الخضر، وتمتد بين الخليج وشط العرب وبهمشير وكارون.(@)(@@) وفي غرب هذه الجزيرة (جزيرة المحلة) في 
ms1328	 نفس شط العرب والآن متصلة بساحله غير مفصولة.(@)(@@) وكانت الحويزة للعراق تسكنها عشائر كعب وعشائر أخرى ولا يزال بعضها في العراق.(@)(@@) وعشائر بني كعب لا تختلف عن سائر العشائر العربية في عوائدها ولها مهارة تلقي الأخبار، ولها عناية بالغرس والزرع سواء في الفلاحية أو في الاسماعيلية والأهواز أو شوشتر ودزفول.(@)(@@) ومن أفرادها من يقوم بأمر تسيير الزوارق والمشاحيف، وعيشتهم على التمر ويعدونه من خير الأقوات عندهم.(@)(@@) وأفخاذها: المحيسن، البو غبيش، الدريس، الخنافرة، المجدم، (آل مقدم) حزبة، النصار، كعب الله الدبيس، العنافجة عبد الخان، والجواسبة.(@)(@@) العزاوي 4/ 181- 189(@)(@@)(@@)(@@) $ كعب الدبيس:(@)(@@) فخذ من المحيسن من كعب من ربيعة بالعراق. يقيم في الميناو.(@)(@@) العزاوي 4/ 188(@)(@@)(@@)(@@) $ كعب بن عمرو:(@)(@@) بطن من مذحج ابن أدد، من كهلان، من القحطانية.(@)(@@) الجمهرة 416(@)(@@)(@@)(@@) $ الكعيب:(@)(@@) فرع من جياش من الظوالم بالعراق.(@)(@@) الطاهر 1/ 231(@)(@@)(@@)(@@) $ الكعيثيون:(@)(@@) فرع من البزازية من المعدان من عشيرة الصيام الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 65(@)(@@)(@@)(@@) $ كعيد (آل) :(@)(@@) فرع من السعيد من البو صكر (صقر) من الجنابيين بالعراق.(@)(@@) العزاوي 3/ 99(@)(@@) PageV05P154(@)(@@) كعيد (البو) :(@)(@@) فرع من الفلاحات من خلفة خميس بالعراق.(@)(@@) العزاوي 3/ 124(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كعيد (البو) :(@)(@@) </span></span>(@)(@@) فرع من البو غياض من الجوازرية من جبور الواوي بالعراق.(@)(@@) العزاوي 3/ 88(@)(@@) كعيد (البو) :(@)(@@) فرع من البو دراج من الكروية من قيس بالعراق.(@)(@@) العزاوي 4/ 204(@)(@@)(@@)(@@) $ كعيران (البو) :(@)(@@) فرقة من الكومة من الحديديين بسورية. عدد بيوتها 150.(@)(@@) مراكزها الرئيسية: قرى محافظات حلب وحماة واداب (جبل سمعان ومنبج والباب وادلب ومعرة النعمان وسلمية) ، ومناطق تجولها: الخرايج، المنطقة الجنوبية من جبل الحصى، امباج ومتياهة، البو النيتل، ابو الفياض، جبل أسرية، اليتيمة، السخنة، وابو رحمين.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ العكيشيش (القعيشيش) :(@)(@@) فخذ يتبع الشريفات من الغزي بالعراق.(@)(@@) العزاوي 3/ 233(@)(@@)(@@)(@@) $ الكفارات:(@)(@@) فخذ من آل شبيبة. يقيم في الجلحة، ويقال له: الغربيون.(@)(@@) العزاوي 4/ 158(@)(@@)(@@)(@@) $ الكفيف:(@)(@@) فرع من حجام الجزيرة من حجام بالعراق.(@)(@@) الطاهر 1/ 113(@)(@@)(@@)(@@) $ الكلابنة:(@)(@@) قسم من الغياث بسورية.(@)(@@) عدد بيوته 135. مراكزه الرئيسية:(@)(@@) الرحبة، الدرس، غراب، دكوة، والعاجر.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ الكلابين:(@)(@@) بطن من سافر من الصعوب من بني عبد الله بالسعودية.(@)(@@) (م) 
ms1329	 حمد الجاسر: العرب 6/ 173(@)(@@)(@@)(@@) $ الكلاثمة:(@)(@@) فخذ من بني شهر ثرامين من شهر السراة بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 608(@)(@@) PageV05P155(@)(@@)(@@)(@@) $ الكلاصنة (القلاصنة) :(@)(@@) فرع من البو دعي من البو بكر من العزة بالعراق.(@)(@@) العزاوي 3/ 174(@)(@@)(@@)(@@) $ الكلش:(@)(@@) فرع من العيسى من المكادمة (المقادمة) من عشيرة المجمع بالعراق.(@)(@@) العزاوي 4/ 215(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكليب:(@)(@@) </span>(@)(@@) فرقة من الكومة من الحديديين بسورية. عدد بيوتها 50، مراكزها الرئيسية: قرى محافظات حلب وادلب وحماة.(@)(@@) (خ) مذاكراتي.(@)(@@) الكليب:(@)(@@) فرع من المكادمة (المقادمة) من المجمع بالعراق.(@)(@@) العزاوي 4/ 215(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كليب (البو) :(@)(@@) </span>(@)(@@) فخذ من الجحيش من زبيد في الحلة بالعراق.(@)(@@) العزاوي 3/ 42(@)(@@) كليب (البو) :(@)(@@) فخذ من الندة إحدى عشائر قيس بالعراق.(@)(@@) العزاوي 4/ 210(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكليبات:(@)(@@) </span></span>(@)(@@) فرقة من البو خميس الراشد بسورية. عدد بيوتها 30، مراكزها الرئيسية: الجبول ودير حافر بمنطقة منبج بمحافظة حلب، ومناطق تجولها: جبل البشري.(@)(@@) (خ) مذاكراتي.(@)(@@) الكليبات:(@)(@@) فرع من الرفيعات من المجمع بالعراق.(@)(@@) العزاوي 4/ 216(@)(@@) الكليبات:(@)(@@) فرقة من المشاهدة بسورية عدد بيوتها 40. مراكزها الرئيسية: قرى جبل سمعان وادلب.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ كليل (آل) :(@)(@@) فرع من آل دخان من بني زريج (زريق) بالعراق.(@)(@@) العزاوي 4/ 135(@)(@@)(@@)(@@) $ كليل (آل بو) :(@)(@@) فرع من آل ربيع من آل ازريج (الازيرق) في العمارة بالعراق.(@)(@@) العزاوي 3/ 76(@)(@@) PageV05P156(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكماملة:(@)(@@) </span>(@)(@@) فرع من الحاج علوان من آل شدود بالعراق.(@)(@@) الطاهر 1/ 158(@)(@@) الكماملة:(@)(@@) فخذ من آل جميعان بالعراق. فروعه: آل دين، السعدون، الثويمر، والتجار.(@)(@@) الطاهر 1/ 132(@)(@@)(@@)(@@) $ الكماهيين:(@)(@@) فخذ من ذوي اصيمع من العونة من بني عبد الله بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 174(@)(@@)(@@)(@@) $ كمر (بيت قمر) :(@)(@@) فرع من البريصات من الحجي من الكريش (القريش) من ربيعة بالعراق.(@)(@@) العزاوي 4/ 171(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كمر (البو قمر) :(@)(@@) </span>(@)(@@) فرع من آل بلادي من آل كيتم من الفتلة بالعراق.(@)(@@) العزاوي 3/ 146(@)(@@)(@@)(@@) $ كمر (آل) :(@)(@@) فخذ من جنانة (كنانة) من ربيعة بالعراق، منه رؤساء عشيرة جنانة.(@)(@@) العزاوي 4/ 177- 178(@)(@@) كمر (البو قمر) :(@)(@@) فرع من الشليخات من البو علكة (علقى) من خلفة دويمع بالعراق.(@)(@@) العزاوي 3/ 157(@)(@@)(@@)(@@) $ كمولي (بو) :(@)(@@) فخذ من المشاهدة بالعراق. يقيم في الطارمية، ومنه البو سحاب، والبو غنطوس.(@)(@@) العزاوي 4/ 238(@)(@@)(@@)(@@) $ كمير 
ms1330	 (بيت قمير) :(@)(@@) فرع من البو سهيل من بني عجيل بالعراق.(@)(@@) العزاوي 3/ 52(@)(@@)(@@)(@@) $ الكميعات:(@)(@@) من عشائر قيس بالعراق، والظاهر أنها من عشيرة المطير، وهي مقلوب الكعيمات، وعشائر نجد منتشرة، وتساكنها عتبة. تسكن في الهارونية وفي المنطقة الممتدة من الهارونية حتى تل أبي ردان. أفخاذها: البو عروش، البو سعيد، والبو نيلة.(@)(@@) العزاوي 4/ 209(@)(@@) PageV05P157(@)(@@)(@@)(@@) $ كناش (البو) :(@)(@@) فرع من كضيب (قضيب) من الشجير من السعيد بالعراق.(@)(@@) العزاوي 3/ 49(@)(@@)(@@)(@@) $ الكناعنة (الجناعنة) :(@)(@@) فرع من البو دروبي من الحديديين بالعراق.(@)(@@) العزاوي 4/ 230(@)(@@)(@@)(@@) $ كنامش (البو) :(@)(@@) فرع من البو غيث من القراغول في أنحاء المحمودية بالعراق.(@)(@@) العزاوي 3/ 128(@)(@@)(@@)(@@) $ ال(@)(@@)(@@)(@@) $ كنانة:(@)(@@) </span>(@)(@@) فخذ من خفاجة بالعراق فروعه: البتران، والمسعود.(@)(@@) الطاهر 1/ 201(@)(@@) كنانة:(@)(@@) فخذ من العوامر من بني شهر السراة بالسعودية.(@)(@@) (م) عبد الله بن حميد 9/ 67(@)(@@)(@@)(@@) $ كنانة الكبير (آل) :(@)(@@) من عشائر بني لام بالعراق. موطنها العمارة.(@)(@@) (م) جونز: المورد س 3 ع 1/ 46(@)(@@)(@@)(@@) $ الكنانية:(@)(@@) من عشائر البصرة.(@)(@@) الطاهر 1/ 326(@)(@@)(@@)(@@) $ الكنج:(@)(@@) فرع من البو حمد من المشاهدة من خلفة مشهد بالعراق.(@)(@@) العزاوي 3/ 154(@)(@@)(@@)(@@) $ كنجي (البو) :(@)(@@) فرع من آل عصيدة من آل زياد بالعراق.(@)(@@) العزاوي 4/ 131(@)(@@)(@@)(@@) $ الكندان:(@)(@@) فخذ من المثلوثة.(@)(@@) مناطق تجوله في الصيف: الجزيرة العليا بسورية، وفي الشتاء: مناطق مملحة البوارة بالقرب من الحدود العراقية.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ الكنش:(@)(@@) فرع من العمران من الطوقية بالعراق.(@)(@@) الطاهر 1/ 222(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كنعان (البو) :(@)(@@) </span>(@)(@@) فرع من البو نجدي من البو طراز من العزة بالعراق.(@)(@@) العزاوي 3/ 181(@)(@@) PageV05P158(@)(@@)(@@)(@@) $ كنعان (البو) :(@)(@@) فخذ من البو عباس بالعراق. فروعه: البو حسن، البو علي، البو مهيدي، والبو حسين.(@)(@@) العزاوي 4/ 251(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ كنعان (بيت) :(@)(@@) </span>(@)(@@) فخذ من المحيسن بالبصرة.(@)(@@) الطاهر 1/ 341(@)(@@) كنعان (بيت) :(@)(@@) فرع من بني عقبة من بني لام بالعراق.(@)(@@) الطاهر 1/ 299(@)(@@)(@@)(@@) $ الكنو:(@)(@@) فرع من البو عليوي من البو متيوت بالعراق.(@)(@@) العزاوي 3/ 47(@)(@@)(@@)(@@) $ كنوش (آل) :(@)(@@) فرع من آل شاووش من آل خزيم بالعراق.(@)(@@) العزاوي 3/ 251(@)(@@)(@@)(@@) $ كنيش (آل) :(@)(@@) فخذ من المخاضرة يقيم في أراضي الطويلة بالعراق.(@)(@@) العزاوي 4/ 159(@)(@@)(@@)(@@) $ الكوارت:(@)(@@) فرع من بيت عبد السيد من السواعد بالعراق.(@)(@@) العزاوي 3/ 70(@)(@@)(@@)(@@) $ الكوارظ (القوارظ) :(@)(@@) فخذ يتبع عشيرة 
ms1331	 آل غانم بالعراق.(@)(@@) العزاوي 4/ 156(@)(@@)(@@)(@@) $ الكواشتة:(@)(@@) فخذ من العزة بالعراق.(@)(@@) العزاوي 3/ 173(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكواصمة (القواصمة) :(@)(@@) </span>(@)(@@) فخذ من الحديديين بالموصل.(@)(@@) العزاوي 3/ 190(@)(@@) الكواصمة (القواصمة) :(@)(@@) فخذ كان يرجع إلى النوافلة من النجابيين بالعراق، ولكنه الآن فخذ مستقل، وفروعه: المحمد، والعفيكات.(@)(@@) العزاوي 3/ 104(@)(@@)(@@)(@@) $ الكواضي (القواضي) :(@)(@@) فرع من المنابية في الحويزة، ويتبع عشيرة السودان بالعراق.(@)(@@) العزاوي 4/ 197(@)(@@) PageV05P159(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكوام (القوام) :(@)(@@) </span></span></span></span>(@)(@@) فخذ من اليسار بالعراق.(@)(@@) العزاوي 3/ 255(@)(@@) الكوام (القوام) :(@)(@@) فرع من المناذير من آل زياد بالعراق. يقيم في الدغارة.(@)(@@) العزاوي 4/ 131(@)(@@)(@@)(@@) $ الكوام:(@)(@@) من عشائر الكوت، كانت قبلا في أنحاء العمارة بالعراق في الجانب الغربي قرب الإمام منصور في ناحية أم حلانة، ثم أصبحت فى الجانب الشرقي، وقد تكاثرت، وأصلها من وائل من عنزة، وتتفرع إلى: بيت سميس، بيت طعيمة، البو حسن، بيت دبيثي، البو ويس، حميد، والشواغل.(@)(@@) العزاوي 4/ 200(@)(@@) الكوام (القوام) :(@)(@@) فرع من العساجرة (العساكرة) من عشيرة بني خيكان (خيقان) الملحقة ببني مالك.(@)(@@) العزاوي 4/ 59(@)(@@) الكوام (القوام) :(@)(@@) من عشائر العراق الصغيرة، ويصعب تعيين ما ترجع إليه، وهي صاحبة تقاليد خاصة، تزوج بناتها لغيرها من العشائر ومهور نسائها محدودة.(@)(@@) العزاوي 4/ 43(@)(@@) الكوام (القوام) :(@)(@@) فخذ من آل حسين من الغزي من بني لام بالعراق.(@)(@@) العزاوي 3/ 230(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكوامات (القوامات) :(@)(@@) </span>(@)(@@) فرع من آل فرطوس من آل خزيم من آل شبل بالعراق.(@)(@@) العزاوي 3/ 251(@)(@@) الكوامات (القوامات) :(@)(@@) فرع من المشاهدة من خلفة مشهد بالعراق.(@)(@@) العزاوي 3/ 154(@)(@@)(@@)(@@) $ الكوامل:(@)(@@) فخذ من بني سعيد بالعراق. فروعه: الحمراء.(@)(@@) الطاهر 1/ 226(@)(@@) PageV05P160(@)(@@)(@@)(@@) $ الكوامي (القوامي) :(@)(@@) فرع من البو دروبي من الحديديين بالعراق.(@)(@@) العزاوي 4/ 231(@)(@@)(@@)(@@) $ الكوايد (القوايد) :(@)(@@) فرع من البو حياص من تميم بالعراق.(@)(@@) العزاوي 4/ 220(@)(@@)(@@)(@@) $ الكوبة:(@)(@@) فخذ من البو صالح بالعراق.(@)(@@) فروعه: الهواشم، البو رحمة، وبنو عقبة.(@)(@@) الطاهر 1/ 155(@)(@@)(@@)(@@) $ كوبع (آل قوبع) :(@)(@@) فخذ من البو صالح من بني مالك بالعراق.(@)(@@) العزاوي 4/ 32(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكوت (أهل) :(@)(@@) </span></span>(@)(@@) تنسب هذه العشيرة العراقية إلى المجرة، وتسكن منطقة سوق الشيوخ من أشهر أفخاذها: كوت جار الله، وكوت محينة.(@)(@@) الطاهر 1/ 140- 142(@)(@@) الكوت (أهل) :(@)(@@) فخذ من الحساوية بالعراق.(@)(@@) الطاهر 1/ 120(@)(@@) الكوت (أهل) :(@)(@@) عشيرة عراقية 
ms1332	 تسكن على ضفتي نهر الفرات بين الناصرية والسوق بالعراق.(@)(@@) الطاهر 1/ 207(@)(@@)(@@)(@@) $ كوت ابن محينة:(@)(@@) من عشائر العراق، وتعرف بكوت ابن بادي أيضا. تقيم في نفس الكوت.(@)(@@) العزاوي 4/ 40(@)(@@)(@@)(@@) $ كوت جار الله:(@)(@@) من عشائر العراق، تقيم في الكوت.(@)(@@) العزاوي 3/ 40(@)(@@)(@@)(@@) $ كوت العمارة:(@)(@@) من عشائر العراق.(@)(@@) موطنها كوت العمارة، ومهنتها الرئيسية: هي الدلالة. وقد سمح لها بجباية ما تحبيه عشائر الدور، وكان لها شأن في الماضي، ولكن المتعاقبين قللوا من مخصصاتها.(@)(@@) (م) جونز: المورد س 3 ع 1/ 43(@)(@@)(@@)(@@) $ كودة (آل) :(@)(@@) فرع من البو شريعة يقيم في بغداد.(@)(@@) العزاوي 3/ 142(@)(@@) PageV05P161(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكورجة:(@)(@@) </span>(@)(@@) فرع من البو عطوان من آل ازيرج (الازيرق) في العمارة بالعراق.(@)(@@) العزاوي 3/ 75(@)(@@) الكورجة:(@)(@@) فخذ من السواعد بالعراق فروعه: بيت حميدان، البو حوف، البو سكندر، البو عاشور، البو هليل، البو دوه، اللعاوسة، البو غدير، البو شبيل، بيت حسان، والبو دومة.(@)(@@) العزاوي 3/ 71، الطاهر 1/ 308(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ ال(@)(@@)(@@)(@@) $ كولبة:(@)(@@) </span></span>(@)(@@) فرع من العمايرة من عشيرة بني خيكان (خيقان) الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 60(@)(@@) الكولبة:(@)(@@) فخذ من العصيدة من خفاجة بالعراق. من فروعه: الشيخ عبد البندر، والبو حوف.(@)(@@) الطاهر 1/ 202(@)(@@) كولبة:(@)(@@) فخذ من البو دراج بالعراق.(@)(@@) فروعه: العواشر، طهمازه، بيت علي، بيت خنجر، بيت فارس، بيت مهنا، الهابشية، بيت شعيبان، البو سعد، البو عبد علي، بيت العمة، البو فليح، وبيت طوعين.(@)(@@) الطاهر 1/ 310(@)(@@)(@@)(@@) $ الكومة:(@)(@@) فرقة من الحديديين بسورية مراكزها الرئيسية: قرى محافظات حلب وادلب وحماة.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ الكويخات:(@)(@@) فرع من الرباح من بني سعيد بالعراق.(@)(@@) العزاوي 3/ 204(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ الكويد:(@)(@@) </span>(@)(@@) فرع من آل عبد الرحمن من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 148(@)(@@) الكويد:(@)(@@) فرع من البو حمدان من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 148(@)(@@) PageV05P162(@)(@@)(@@)(@@) $ كويدر (البو قويدر) :(@)(@@) فرع من البو علي العزام من البو عزام من خلفة خميس بالعراق.(@)(@@) العزاوي 3/ 121(@)(@@)(@@)(@@) $ الكويزات:(@)(@@) فرقة من البو خميس البدر بسورية. عدد بيوتها 65. مراكزها الرئيسية: الجبول ودير حافر بمنطقة منبج من محافظة حلب، ومناطق تجولها: جبل البشري.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ كويسم (البو) :(@)(@@) فخذ من البو سليمان من الحديديين بالعراق. من فروعه: البو 
ms1333	 مكلد (مقلد) والمحاسنة.(@)(@@) العزاوي 4/ 231(@)(@@)(@@)(@@) $ كويش (بيت) :(@)(@@) فرع من أهل الثلث من السراي (السراج) بالعراق.(@)(@@) العزاوي 4/ 171(@)(@@)(@@)(@@) $ الكويشاب:(@)(@@) من عشائر العمارة بالعراق. موطنها: عمية اليول.(@)(@@) (م) جونز: المورد س 3 ع 1/ 44(@)(@@)(@@)(@@) $ الكويشات:(@)(@@) فخذ ينتسب إلى المياح إحدى عشائر ربيعة بالعراق، ويقال له الشروكية (الشروقية) .(@)(@@) العزاوي 4/ 167(@)(@@)(@@)(@@) $ كويظم (البو) :(@)(@@) فرع من آل جبران من آل كيم من الفتلة بالعراق.(@)(@@) العزاوي 3/ 146(@)(@@)(@@)(@@) $ كيلان (البو) :(@)(@@) فرع من البو عيادة من البو عامر من طيء بالعراق.(@)(@@) العزاوي 3/ 244(@)(@@)(@@)(@@) $ كيم (آل) :(@)(@@) فخذ من الفتلة بالعراق. يسكن في الهندية والمشخاب والشامية: وفروعه: آل الأحمد، آل خليفة، آل جبران، آل معمر، آل سالم، آل بلادي، وترجع هذه الفروع إلى بعض ما تفرع منه، ولكنها اليوم معروفة بأسمائها ومستقلة بها.(@)(@@) العزاوي 3/ 146- 147(@)(@@) PageV05P163(@)(@@)(@@)(@@) $ حرف اللام(@)(@@)(@@)(@@) $ لاجح (البو) :(@)(@@) فرع من المقاصيص (المكاصيص) من ربيعة بالعراق.(@)(@@) العزاوي 4/ 173(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ لام (بنو) :(@)(@@) </span>(@)(@@) من عشائر دجلة الكبيرة ذات الشأن بالعراق، وتتعاطى زراعة الحنطة والشعير على ضفتي النهر، وتمتد أراضيها إلى الحدود الايرانية بالقرب من مبردة والحويزة، وترعى مواشيها بالقرب من الهضاب الايرانية في الشهر الأول من السنة.(@)(@@) ويعتبر أفراد هذه العشيرة من المقاتلين الأشداء وهم فرسان أقوياء، أما اليوم فليس لهم قيمة قتالية تذكر. وان بداوتها في أيامها السابقة، مكنتها من السيطرة على لواء العمارة، أو أكثر بقاعه، ولكن العشائر التابعة لها فقد تبدلت أوضاعها، والتزمت مواطنها، فاستقرت فيها، وانحسر نفوذ بني لام رويدا رويدا.(@)(@@) وهي من عشائر طيء، فقد امتدت سلطتها قديما من القرنة إلى الشاطئ الشرقي من نهر ديالي، مما هو قريب من بغداد، إلا أن هذا تقلص تدريجيا، وانتزعت سلطتها من بعض المواطن مثل لواء الكوت.(@)(@@) وانقطعت الصلة إلا قليلا، فبقي موطنها محصورا فيما هو لا يزال الآن بأيديها، كما أن عشائر أخرى في الجنوب قد حدت من سلطة بني لام عليها، بل كادت تنعدم.(@)(@@) PageV05P165(@)(@@) وفي تاريخ وقائعها ما يثبت ويعين على إثبات توسع سلطان بني لام في الماضي وتقلصه في الحاضر. وكان يعد تاريخ اللواء مكونا من حوادث 
ms1334	 بني لام، وعلاقاتها بولاة بغداد كثيرة.(@)(@@) وكانت عشائر بني لام تسكن الحجاز في جبال أجأ وسلمى، وأصل موطنها اليمن والتاريخ القديم مملوء وطافح بذكر الحوادث عنها أو ما يتعلق بها.(@)(@@) وسبقت عشائر بني لام عشائر شمر في سكنى العراق، وكان سكناها في نحو القرن الثامن الهجري.(@)(@@) ومن عشائر بني لام: آل نصيري، آل نصار، الحويفظ، الغزي، الجوارين، والجشعم (القشعم) .(@)(@@) العزاوي 3/ 210- 237(@)(@@)(@@)(@@) $ لام (بنو) :(@)(@@) فخذ من بلحارث من بني شهر السراة بالسعودية.(@)(@@) (م) عبد الله بن حميد: العرب 9/ 67(@)(@@)(@@)(@@) $ لامى (بيت) :(@)(@@) فخذ من بني زيد بالعراق. يسكن في لواء ديالي وأنحاء سلمان باك.(@)(@@) العزاوي 3/ 60(@)(@@)(@@)(@@) $ لامى (البو) :(@)(@@) فرع من عبودة بالعراق.(@)(@@) العزاوي 4/ 103، الطاهر 1/ 167(@)(@@)(@@)(@@) $ اللاوي:(@)(@@) فرع من العجيل من حجام العراق.(@)(@@) الطاهر 1/ 115(@)(@@)(@@)(@@) $ لاوي (آل) :(@)(@@) فرع من بني منصور من جبور الواوي بالعراق.(@)(@@) العزاوي 3/ 90(@)(@@)(@@)(@@) $ لايد (آل) :(@)(@@) فرع من المراشدة من بني زيد بالعراق.(@)(@@) العزاوي 4/ 137(@)(@@)(@@)(@@) $ لايذ (آل) :(@)(@@) فخذ من الغزالات.(@)(@@) يقيم في ام بازية بالعراق. من فروعه:(@)(@@) البو عبيد.(@)(@@) العزاوي 4/ 155(@)(@@) PageV05P166(@)(@@)(@@)(@@) $ لباد (البو) :(@)(@@) فرع من البو محمد العزام من خلفة خميس بالعراق.(@)(@@) العزاوي 3/ 120(@)(@@)(@@)(@@) $ اللبان:(@)(@@) فرع من الحسية من الرفيع بالعراق.(@)(@@) العزاوي 4/ 82(@)(@@)(@@)(@@) $ لجام (آل) :(@)(@@) فخذ من آل شبل بالعراق وفروعه: آل صادج، آل دهيم وآل بصري.(@)(@@) العزاوي 3/ 250(@)(@@)(@@)(@@) $ اللجى:(@)(@@) فرع من البو سلمان من أولاد سلمان بن خميس من المحامدة بالعراق.(@)(@@) العزاوي 3/ 126(@)(@@)(@@)(@@) $ اللجي:(@)(@@) فرع من المحمد العامر من الشللة من بني سبعة بالعراق.(@)(@@) العزاوي 3/ 263(@)(@@)(@@)(@@) $ اللحافات:(@)(@@) فرع من الجبور من الرميثة من السماوة بالعراق.(@)(@@) العزاوي 3/ 92(@)(@@)(@@)(@@) $ لحه (البو لحى) :(@)(@@) فخذ من آل زياد بالعراق، أراضيه الصقلاوية.(@)(@@) العزاوي 4/ 131(@)(@@)(@@)(@@) $ لحي (البو) :(@)(@@) فرع من الفرج (فري) من الكريش (القريش) من ربيعة بالعراق.(@)(@@) العزاوي 4/ 172(@)(@@)(@@)(@@) $ لطف (البو) :(@)(@@) فرع من عشيرة كعب التابعة لبني لام بالعراق.(@)(@@) الطاهر 1/ 313(@)(@@)(@@)(@@) $ اللطيف:(@)(@@) فرع من البو حمدان بالعراق.(@)(@@) يسكن في أراضي الحليوة.(@)(@@) العزاوي 3/ 266(@)(@@)(@@)(@@) $ لطيف (آل) :(@)(@@) فرع من البو دلي من الفهود بالعراق.(@)(@@) الطاهر 1/ 113(@)(@@) PageV05P167(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ لطيف (البو) :(@)(@@) </span>(@)(@@) فرع من البو فاعور من البو محمد النمر 
ms1335	 من البو نمر من البو سالم بالعراق.(@)(@@) العزاوي 1/ 113(@)(@@) لطيف (البو) :(@)(@@) فخذ من المشاهدة بالعراق. يسكن في أراضي اليهودية وفي أبي سريويل، وفي مواطن أخرى. وفروعه:(@)(@@) البو جواد، البو كاظم، البو عليوي، البو حمد اللطيف، البو عبد علي، البو عز الدين، البو درويش العبدلي، والبو صالح الياسين.(@)(@@) العزاوي 4/ 238، 239(@)(@@)(@@)(@@) $ لطيف العابد (البو) :(@)(@@) فرع من الفلاحات من خلفة خميس بالعراق. يسكن في المزرقة.(@)(@@) العزاوي 3/ 122(@)(@@)(@@)(@@) $ اللطيفات:(@)(@@) فخذ من البو خطاب من الجبور بالعراق. من فروعه: الجافي أي الكافي، والصبيحات.(@)(@@) العزاوي 3/ 87(@)(@@)(@@)(@@) $ اللعاوسة:(@)(@@) فرع من الكورجة من السواعد بالعراق.(@)(@@) العزاوي 3/ 71(@)(@@)(@@)(@@) $ اللغيوات:(@)(@@) فرع من النصر الله من البو صالح بالعراق.(@)(@@) الطاهر 1/ 155(@)(@@)(@@)(@@) $ اللفتة:(@)(@@) فخذ من بني زيد بالعراق.(@)(@@) يسكن في الحلة.(@)(@@) العزاوي 3/ 60(@)(@@)(@@)(@@) $ لفيفة (البو) :(@)(@@) فرع من العظميين بالعراق.(@)(@@) الطاهر 1/ 222(@)(@@)(@@)(@@) $ اللكاءة:(@)(@@) فرع من البو عظيم (عظام) من الحسينيات بالعراق.(@)(@@) الطاهر 1/ 195، العزاوي 4/ 97(@)(@@)(@@)(@@) $ ليل (البو) :(@)(@@) فرع من البو خابور من العكيدات (العقيدات) بالعراق.(@)(@@) العزاوي 3/ 131(@)(@@) PageV05P168(@)(@@)(@@)(@@) $ الليلي:(@)(@@) فخذ من اليسار بالعراق.(@)(@@) العزاوي 3/ 255(@)(@@)(@@)(@@) $ اللمام:(@)(@@) فرع من الدلاهمة من آل شميس بالعراق.(@)(@@) الطاهر 1/ 159(@)(@@)(@@)(@@) $ اللمعة:(@)(@@) فخذ من الجابر من الشعيث من ناصرة من بلحارث بالسعودية وسكناه قرية حريزة والجناب.(@)(@@) (م) حمد الجاسر: العرب 6/ 607(@)(@@)(@@)(@@) $ اللهامقة:(@)(@@) بطن من الخماميش بشمال الطائف بالسعودية.(@)(@@) (م) محمد سعيد كمال: العرب 5/ 975(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ اللهيب:(@)(@@) </span></span>(@)(@@) فخذ يتبع سنبس من طيء بالعراق.(@)(@@) العزاوي 3/ 238- 239(@)(@@) اللهيب:(@)(@@) فخذ من الجشعم (القشعم) بالعراق.(@)(@@) العزاوي 3/ 236(@)(@@) اللهيب:(@)(@@) من عشائر العراق، تعد من الجبور من أولاد محمد بن جبر، وعدها بعضهم من أخوة جبر، وهؤلاء مستقلون في عشائرهم وفي فروعهم، ومنتشرون كثيرا، وهذا السبب في عدهم أخوة جبر.(@)(@@) وفروع اللهيب كثيرة وهي في مواطن كثيرة وأشهر فرقها: الرحال، الحجاريون، لدويزات، البو رحيل، الصاتلمش، والبو مراد.(@)(@@) ومن اللهيب الكريعات في ناحية المحاويل. وفروعهم: البو كرير، البو حسن البو عبيد، الدبيسات، البو صالح، البو شاووش.(@)(@@) هذا ومن اللهيب جماعة في بغداد، وهم:(@)(@@) بيت دراغ، وبيت حداد، ومنهم في أنحاء؟ نارنين؟ وهم: العواشرة، العطية، البكة، البو غافل، والشواذب.(@)(@@) العزاوي 
ms1336	 3/ 93- 95(@)(@@) PageV05P169(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ اللهيبات:(@)(@@) </span>(@)(@@) فرع من خزيم من آل شبل بالعراق، وهم من اللهيب، ومنهم آل سالم وآل ظلال، والقبوي (القبوج) العزاوي 3/ 251(@)(@@) اللهيبات:(@)(@@) فخذ من آل شبل الجلتة بالعراق. وفروعه: البو بديوي، البو سويعية، وآل سباهي، ومن فرق اللهيبات الساكنة في الجعارة: آل شاتي، آل زكي، البو شاهر، البو حسين، البو حوطة، الفنهرة، البو شيخ علي، وبنو ليث.(@)(@@) العزاوي 3/ 252- 253(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ لهيث (البو) :(@)(@@) </span>(@)(@@) فرع من آل طوك (طوق) من الفيادة من الفتلة بالعراق.(@)(@@) العزاوي 3/ 147(@)(@@) لهيث (البو) :(@)(@@) فرع من آل طوك (طوق) من الفيادة من الفتلة بالعراق.(@)(@@) العزاوي 3/ 147(@)(@@)(@@)(@@) $ اللهيد:(@)(@@) فرع من المكادمة (المقادمة) بالعراق.(@)(@@) العزاوي 4/ 215(@)(@@)(@@)(@@) $ لهيمد (البو) :(@)(@@) فرع من البو عبيثة من البو طرات من العزة بالعراق.(@)(@@) العزاوي 3/ 180(@)(@@)(@@)(@@) $ اللوافية:(@)(@@) فخذ من المشاريف من الصعوب من بني عبد الله بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 174(@)(@@)(@@)(@@) $ اللوامي:(@)(@@) بطن من الطفلة من ذوي حطاب من الشلاوى من بلحارث بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 605(@)(@@)(@@)(@@) $ اللوبة:(@)(@@) فخذ من خفاجة في الحلة بالعراق.(@)(@@) العزاوي 4/ 90(@)(@@) PageV05P170(@)(@@)(@@)(@@) $ لويلو (بيت) :(@)(@@) فخذ من البو محمد بالعراق. فروعه: بيت مشتت، بيت ضمد، بيت فياض، بيت خليفة، وبيت فيصل.(@)(@@) العزاوي 3/ 63(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ ليث (بنو) :(@)(@@) </span>(@)(@@) فرقة من عشيرة اللهيبات القاطنة في الجعارة بالعراق.(@)(@@) العزاوي 3/ 252(@)(@@) ليث (بنو) :(@)(@@) فخذ يتبع عشيرة آل غانم بالعراق.(@)(@@) العزاوي 4/ 156(@)(@@)(@@)(@@) $ ليد (البو) :(@)(@@) فرع من الجلابين من جحيش الحلة من زبيد بالعراق.(@)(@@) العزاوي 3/ 43(@)(@@) PageV05P171(@)(@@)(@@)(@@) $ حرف الميم(@)(@@)(@@)(@@) $ ما شاء الله:(@)(@@) فخذ من الظوالم.(@)(@@) فروعه: المطر، النوجة، النصيري، الشهيب، البو شويل، وزيارة.(@)(@@) الطاهر 1/ 232(@)(@@)(@@)(@@) $ الماجد:(@)(@@) فخذ من عشيرة آل جميعان الملحقة بالبو صالح من بني مالك بالعراق.(@)(@@) فروعه: العواحيل، الغصاب، الهكشام، والشقير.(@)(@@) الطاهر 1/ 132- 133 العزاوي 4/ 33(@)(@@)(@@)(@@) $ ماجد (بو) :(@)(@@) فخذ من شرابين يقيم على ضفتي الخابور وجغجغ بمحافظة الحسكة بسورية.(@)(@@) (خ) مذاكراتي.(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ ماجد (البو) :(@)(@@) </span>(@)(@@) فرع من البو حسين من الظوالم بالعراق.(@)(@@) العزاوي 4/ 126(@)(@@) ماجد (البو) :(@)(@@) فخذ من الأعبس بالعراق. يقيم في الكرحة.(@)(@@) العزاوي 4/ 129(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ المارد:(@)(@@) </span>(@)(@@) من قبائل الأجود بالعراق، وهم رحل، وبينهم زراع، والأكثر أهل بداوة، 
ms1337	 وهم بين سوق الشيوخ والناصرية.(@)(@@) العزاوي 4/ 105(@)(@@) المارد:(@)(@@) فخذ من الشريفات بالعراق.(@)(@@) الطاهر 1/ 214(@)(@@) PageV05P173(@)(@@)(@@)(@@) $ الماضي:(@)(@@) فرع من المطاردة من آل جويبر بالعراق.(@)(@@) العزاوي 1/ 134(@)(@@)(@@)(@@) $ ماضي (آل) :(@)(@@) فخذ من آل صادج من آل لجام بالعراق.(@)(@@) العزاوي 3/ 250(@)(@@)(@@)(@@) $ ماضي (ذوي، ذوو) :(@)(@@) بطن من السحالين من المشاريف من الصعوب من بني عبد الله بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 174(@)(@@)(@@)(@@) $ المال الله:(@)(@@) فرع من الشوالجة من النوافلة من الجنابيين بالعراق.(@)(@@) العزاوي 3/ 100(@)(@@)(@@)(@@) $ المالح:(@)(@@) فرع من حجام الجزيرة من حجام العراق.(@)(@@) الطاهر 1/ 113(@)(@@)(@@)(@@) $ مالح (آل) :(@)(@@) فرع من الزويدات من حجام من بني مالك بالعراق.(@)(@@) العزاوي 4/ 39(@)(@@)(@@)(@@) $ المالك:(@)(@@) فرع من الزرقان من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 149(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ مالك (بنو) :(@)(@@) </span></span></span>(@)(@@) فرقة من عشيرة بير حميد (السعد) الملحقة ببني مالك بالعراق.(@)(@@) العزاوي 4/ 65(@)(@@) مالك (بنو) :(@)(@@) من عشائر العراق.(@)(@@) من فروعها: العيدان، بنو سكين. السبتي، والحمودي.(@)(@@) العزاوي 4/ 193(@)(@@) مالك (بنو) :(@)(@@) من عشائر العراق المنتشرة في سوق الشيوخ والبصرة والقرنة ناحية البو صالح التابعة لمركز لواء المنتفق (الناصرية) وفي مواطن أخرى في لواء الديوانية والحلة، وفي الحويزة من المناطق العراقية.(@)(@@) وينتسب بنو مالك إلى مالك بن المنتفق، وقد انضمت إليهم عشائر كثيرة، كما ألحقت بهم عشائر أخرى.(@)(@@) PageV05P174(@)(@@) ومن أفخاذ مالك: البو صالح، العليات، آل حسن، آل إبراهيم، حجام، كوت جار الله، كوت ابن محينة الشواليش، الحساوية، آل إسماعيل، الدجين، آل زياد، الجويبر، بنو حطيط، الحماحمة، البو شعيرة، الكوام (القوام) المطيرات، بنو أسد، وعبادة.(@)(@@) وهناك عشائر أخرى ملحقة ببني مالك وهي: بنو خيكان (خيقان) ، الصيام، بير حميد ويقال لها: السعد، بنو منصور، الحلاف، أهل الشرش، أهالي الجلعة، أهالي الشلهة، عشائر السويب، وعشائر مزيرعة.(@)(@@) ومن بني مالك قطع وفرق: مثل آل خشاب، الصليحات، الخبيطات. ومن آل إبراهيم في الشنافية: آل عباس، وآل سليم وهؤلاء مشهورون في الحسجة وبالهوسات.(@)(@@) ويجاور بني مالك: الفتلة من الشمال والغزلات وآل شبل من الجنوب، وآل زياد من الشرق، وآل ياسر من الغرب.(@)(@@) العزاوي 4/ 30- 69، 148- 150، الطاهر 1/ 92- 94(@)(@@)(@@)(@@) $ مالك (بنو) :(@)(@@) من عشائر العراق يرجع أصلها إلى البو صالح في 
ms1338	 الغراف، فقد هاجرت من الفرات وتوطنت في الأراضي الحالية على دجلة والعائدة إلى المنتفق، وأفخاذها: موزة، العلوة، النخيلات، حربية، بيت غويم، الخضر، الجويبر، التيلات، البو مسعد، عويلات، طريفات، وبيت ساري.(@)(@@) الطاهر 1/ 332- 333(@)(@@)(@@)(@@) $ مالك الأغر:(@)(@@) بطن من الخزرج من الأزد من القحظانية، ينتسب إلى مالك الأغر بن ثعلبة بن كعب بن الخزرج بن الحارث بن الخزرج.(@)(@@) الجمهرة 363- 365(@)(@@)(@@)(@@) $ مالك بن بكر (بنو) :(@)(@@) بطن من تغلب بن وائل من العدنانية، وينتسب إلى مالك بن بكر بن حبيب بن عمرو بن غنم بن تغلب بن وائل.(@)(@@) الجمهرة 306(@)(@@) PageV05P175(@)(@@)(@@)(@@) $ مانع (آل) :(@)(@@) فرع من الرفيعات من الجوارين من الغزي من بني لام بالعراق.(@)(@@) العزاوي 3/ 234(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ مانع (البو) :(@)(@@) </span></span></span>(@)(@@) فرع من الرحمة من الغنائمة بالعراق.(@)(@@) الطاهر 1/ 106(@)(@@) مانع (البو) :(@)(@@) فرع من البو مهلهل من الجنابيين بالعراق. يقيم في الصوفية بلواء الدليم.(@)(@@) العزاوي 3/ 103(@)(@@)(@@)(@@) $ المانع:(@)(@@) فخذ من بني خالد بسورية.(@)(@@) مراكزه الرئيسية: المعمورة بمنطقة حماة وسلمية، ومناطق تجوله: جبل شمرية، عين مران، حجار، عين البيضة بمنطقة تدمر، تل أفري، عليانية، القرب، التنف، والحماد.(@)(@@) (خ) مذاكراتي.(@)(@@) مانع (البو) :(@)(@@) فخذ من الهيجل من الجبور بالعراق.(@)(@@) العزاوي 3/ 84(@)(@@) مانع (البو) :(@)(@@) فرع من البو هلال من البو حسين النمر من البو نمر من البو سالم بالعراق.(@)(@@) العزاوي 3/ 114(@)(@@)(@@)(@@) $ مانع (بيت) :(@)(@@) فرع من بيت عبد السيد من السواعد بالعراق.(@)(@@) العزاوي 3/ 70(@)(@@)(@@)(@@) $ مايح (آل) :(@)(@@) فرقة من عشيرة اللهيبات القاطنة في الجعارة بالعراق.(@)(@@) العزاوي 3/ 253(@)(@@)(@@)(@@) $ مايح (البو) :(@)(@@) فرع من آل طوك (طوق) من الفيادة من الفتلة بالعراق.(@)(@@) العزاوي 3/ 148(@)(@@)(@@)(@@) $ المبادر:(@)(@@) فخذ من آل إبراهيم بالعراق فروعه: البو علاد، البو فزيعة، والمعرف.(@)(@@) الطاهر 1/ 127(@)(@@)(@@)(@@) $ مبادر (آل) :(@)(@@) فخذ من البو صالح من بني مالك بالعراق.(@)(@@) العزاوي 4/ 23(@)(@@) PageV05P176(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ مبارك (ذوي، ذوو) :(@)(@@) </span></span>(@)(@@) بطن من الخماميش بشمال الطائف بالسعودية.(@)(@@) محمد سعيد كمال: العرب 5/ 975(@)(@@) مبارك (ذوي، ذوو) :(@)(@@) فخذ من ذوي عواض من الروقة من الشدادين من بني أوس (بنيوس) من بلحارث بالسعودية (م) حمد الجاسر: العرب 6/ 603(@)(@@) مبارك (ذوي، ذوو) :(@)(@@) بطن من الصليخات من بني أوس (بنيوس) من 
ms1339	 بلحارث بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 604(@)(@@)(@@)(@@) $ المبارك:(@)(@@) فرع من الرسن من البدور بالعراق.(@)(@@) الطاهر 1/ 180، العزاوي 4/ 94(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ مبارك (آل) :(@)(@@) </span>(@)(@@) فرع من البو زامل من آل حاتم من بني ركاب (رجاب) بالعراق العزاوي 3/ 196(@)(@@) مبارك (آل) :(@)(@@) فخذ من بني زيد بالعراق.(@)(@@) العزاوي 3/ 59(@)(@@)(@@)(@@) $ المباطية:(@)(@@) بطن من مرثد من الجزمان من الهجال من الصعوب من بني عبد الله بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 173(@)(@@)(@@)(@@) $ المبرقع:(@)(@@) فرع من الموسى من آل رحمة بالعراق.(@)(@@) الطاهر 1/ 150(@)(@@)(@@)(@@) $ المبيرق:(@)(@@) فرع من العبيد من آل جميعان بالعراق.(@)(@@) الطاهر 1/ 132(@)(@@)(@@)(@@) $ المتاعبة:(@)(@@) فخذ من قريش من المجايشة من الحسكان من ناصرة من بلحارث وسكناه وادي ميسان بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 606(@)(@@)(@@)(@@) $ المتان:(@)(@@) فرع من البو حسين النجاد من البو نجاد من الجبور بالعراق.(@)(@@) العزاوي 3/ 82(@)(@@)(@@)(@@) $ متيوت (البو) :(@)(@@) عشيرة عراقية قائمة بذاتها سواء أعدت من الجحيش رأسا أم من فرع العيسى أم اعتبرت من الأحلاف.(@)(@@) PageV05P177(@)(@@) وأفراد هذه العشيرة معروفون بالشجاعة وفلاحة الأرض وزراعتها. فروعها: البو خليفة، المرعي، البو مزيدة، البو عليوي، الدوخية، البو صبيح، والهيجل.(@)(@@) العزاوي 3/ 46- 48(@)(@@)(@@)(@@) $ مثعي (ذوي، ذوو) :(@)(@@) بطن من ذوي حطاب من الشلاوى من بلحارث بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 605(@)(@@)(@@)(@@) $ المجابرة:(@)(@@) فخذ من بني مهدي من طريف من جذام من كهلان من القحطانية.(@)(@@) القلائد: 66(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ المجابل:(@)(@@) </span>(@)(@@) فخذ من الحساوية بالعراق.(@)(@@) الطاهر 1/ 120(@)(@@) المجابل:(@)(@@) فخذ من بني مشرف بالعراق.(@)(@@) الطاهر 1/ 145(@)(@@)(@@)(@@) $ مجابلة:(@)(@@) فرع من الهمام من خفاجة بالعراق.(@)(@@) الطاهر 1/ 202(@)(@@)(@@)(@@) $ المجاتيم:(@)(@@) فخذ من بني حسن بالعراق.(@)(@@) وفروعه: الثروان، والبو عريف.(@)(@@) العزاوي 4/ 147(@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ (@)(@@)(@@)(@@) $ المجاحيل:(@)(@@) </span></span></span>(@)(@@) فخذ من الملاحمة بالعراق.(@)(@@) العزاوي 3/ 119(@)(@@) المجاحيل:(@)(@@) فرع من البو عجيل من البو بكر من العزة بالعراق.(@)(@@) العزاوي 3/ 178(@)(@@) المجاحيل:(@)(@@) فخذ من جنانة (كنانة) من ربيعة بالعراق. يقيم في أراضي الجزيرة.(@)(@@) مع حجام.(@)(@@) العزاوي 4/ 177(@)(@@) المجاحيل:(@)(@@) فرع من آل خنيفر من خفاجة في الحلة بالعراق.(@)(@@) العزاوي 4/ 91(@)(@@)(@@)(@@) $ مجار (آل) :(@)(@@) فخذ من البو ناشي.(@)(@@) يقيم في الجعجة بالعراق.(@)(@@) العزاوي 4/ 160(@)(@@) PageV05P178(@)(@@)(@@)(@@) $ المجافية:(@)(@@) بطن النورية من بني أوس من بلحارث بالسعودية.(@)(@@) (م) حمد 
ms1340	 الجاسر: العرب 6/ 604(@)(@@)(@@)(@@) $ المجالدة:(@)(@@) فخذ من الشطر من الصعوب من بني عبد الله بالسعودية. من فروعه:(@)(@@) الخشمان، الدوائخ، وذوي عواض.(@)(@@) (م) حمد الجاسر: العرب 6/ 173(@)(@@)(@@)(@@) $ المجانبة [1] :(@)(@@) فرع من البو علي من الغزي من بني لام بالعراق.(@)(@@) الطاهر 1/ 182، العزاوي 3/ 229(@)(@@)(@@)(@@) $ المجاودة:(@)(@@) فخذ يتبع البو جمال (كمال) من الكعيدات (القعيدات) بالعراق.(@)(@@) العزاوي 3/ 131(@)(@@)(@@)(@@) $ المجاوير:(@)(@@) فخذ من الأكرع بالعراق وغالب أفراده في ناحية الشنافية على جانبي نهر الديوانية، وفروعه: مزاريج، العماريون العفالجة، البو حسن، البو خنيفس، البو عرب، البو حي الله، البو صالح، والبغادة.(@)(@@) العزاوي 3/ 207- 208(@)(@@)(@@)(@@) $ المجايشة:(@)(@@) بطن من الحسكان من ناصرة من بلحارث. ومنه قريش والعمرية وسكناهم الحراء وظفر ومرقتة وداما والكوت والكتمة وهي فروع بوادي ميسان والصخرة وبيضان وأكلها بالسعودية.(@)(@@) (م) حمد الجاسر: العرب 6/ 606- 607(@)(@@)(@@)(@@) $ مجبل (البو) :(@)(@@) فرع من عيادة من البو عامر من طيء بالعراق.(@)(@@) العزاوي 3/ 244(@)(@@)(@@)(@@) $ مجبل (آل) :(@)(@@) فرع من المناصرة من الجابر من بني ركاب (رجاب) بالعراق.(@)(@@) العزاوي 3/ 194(@)(@@)(@@)(@@) $ مجد (البو) :(@)(@@) فرع من بني أسد بالعراق. يسكن في أراضي المشورب بين الهندية وطويرج (طويرق) وفي ضواحي كربلاء.(@)(@@) العزاوي 4/ 52 PageV05P179(@)(@@)(@@)(@@) $ المجدم (آل المقدم) :(@)(@@) فخذ من المحيسن من كعب من ربيعة بالعراق.(@)(@@) يسكن في الجفال والفلاحية (الدورق) .(@)(@@) العزاوي 4/ 188(@)(@@)(@@)(@@) $ مجدي (بيت) :(@)(@@) فرع من عتاب من السراي (السراج) بالعراق.(@)(@@) العزاوي 4/ 169(@)(@@)(@@)(@@) $ مجذوب (البو) :(@)(@@) فرع من البدران من عبادة بالعراق.(@)(@@) العزاوي 4/ 54(@)(@@)(@@)(@@) $ المجر:(@)(@@) فخذ من النواشي بالعراق.(@)(@@) الطاهر 1/ 147(@)(@@)(@@)(@@) $ مجربة بن حرام:(@)(@@) بطن من جذام من كهلان من القحطانية.(@)(@@) القلائد 61- 62(@)(@@)(@@)(@@) $ المجرة:(@)(@@) اتحاد عشائري قوي، له عداوة مستحكمة مع بني خيقان، لهذا استمرت حوادث أخذ الثأر بينهما، وأفراد هذا الاتحاد معروفون بقوة الشكيمة وإقلاقهم للأمن، وهم مسلحون تسليحا جيدا، وكانوا يكرهون العثمانيين والانكليز على السواء.(@)(@@) ويعتبر اتحاد المجرة أكثر خطرا من بني خيقان، فقد قاد العثمانيون ثلاث حملات ضدهم، كان الغرض منها إخضاعهم للسلطة، فكانت فاشلة.(@)(@@) واستطاعت السلطات البريطانية بعد احتلالها الخميسية، وهي قرية تابعة لسوق الشيوخ على منتهى الأهوار، أن تسيطر على الموقف وأن تخضع عشائر المجرة. وتتألف ثرواتهم من التمور 