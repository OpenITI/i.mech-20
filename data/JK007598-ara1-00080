ms61	 % % فأذكرها الشان في الشمس والبدر % 13(@)(@@) % وقد غريت بالبعد حتى بودها % % وبالبخل حتى بالخيال الذي يسري % % 14(@)(@@) % وبالهضبة الحمراء من أيمن الحمى % % لها منزل ألوت به نوب الدهر % 15(@)(@@) % كأن بقايا نشرها في عراصه % تبث أريج المسك بالجرع العفر % 16(@)(@@) % فلا برحت تكسوه ما هبت الصبا % % أنامل من قطر غلائل من زهر % 17(@)(@@) % حمته سراة الحي غنم بن مالك % وإخوتها الشم العرانين من فهر % 18(@)(@@) % بصيابة مجر ، وكرامة ثبى % ومرهفة بيض ، ومشرعة سمر % 19(@)(@@) % وكم فيهم من صارخ ومثوب % ومن مجلس فخم ، ومن نعم دثر % 20(@)(@@) % وسرب عذارى بين غاب من القنا % % كسرب ظباء في ظلال من السدر % PageV01P193 21(@)(@@) % سموت لها والليل رق أديمه % وكاد يقص الفجر قادمة النسر % 22(@)(@@) % ورمنا عناقا نهنهت عنه عفة % شديد بها عقد النطاق على الخصر % 23(@)(@@) % ولم تك إلا الوشح فينا مذالة % وإن حام بي ظن الغيور على الأزر % 24(@)(@@) % وإني ليصبيني حديث ونظرة % يعارضها الواشون بالنظر الشزر % 25(@)(@@) % حديث رقيق من سعاد كأنها % % تشوب لنا ماء الغمامة بالخمر % 26(@)(@@) % فما راعنا إلا الصباح كما بدا % % من الغمد حد الهند وإني ذي الأثر % 27(@)(@@) % ومن عجل ما لف جيدا وداعنا % % بجيد ، ولا نحرا أضفنا إلى نحر % 28(@)(@@) % فعدت أجر الذيل والسيف منتضى % وهن يبادرن الخيام على ذعر % 29(@)(@@) % وقد محيت آثارها بذيولها % % سوى ما أعارته التراب من النشر % 30(@)(@@) % مشين فعطرن الثرى بذوائب % غرضن بسري ، لا نفضن من العطر % PageV01P194 31(@)(@@) % كما نم حسان بن سعد بن عامر % بغر مساعيه على كرم النجر % 32(@)(@@) % أخو همم لم يملأ الهول صدره % ولا ناله خطب بناب ولا ظفر % 33(@)(@@) % يلاحظ غب الأمر قبل وقوعه % ويبلغ ما لا تبلغ العين بالفكر % 34(@)(@@) % وينظم شمل المجد ما بين منحة % عوان ، وتصميم على فتكة بكر % 35(@)(@@) % إذا المعضلات استقبلت عزماته % فلم يلتفت إلا إلى حادث نكر % 36(@)(@@) % نكصن على الأعقاب دون ارتيابه % تعثر في أذيالهن على صغر % 37(@)(@@) % وإن كان يوم غادر المحل أفقه % يمج نجيعا وهو في حلل حمر 
ms62	 % 38(@)(@@) % فزعنا إليه نمتري من يمينه % سحائب يسحبن الضروع من الغزر % 39(@)(@@) % أقمنا صدور الأرحبية نحوه % طوالب رفد لا بكي ولا نزر % 40(@)(@@) % فمدت لنا الأعناق طوعا وما اتقت % بلي خدود في أزمتها صعر % PageV01P195 41(@)(@@) % ترنحها ذكراه حتى كأننا % % نهز بها أعطافهن من السكر % 42(@)(@@) % ويسلبها السير الحثيث مراحها % % إلى أن يعود الخطو أقصر من شبر % 43(@)(@@) % وذي ثروة هبت به خيلاؤه % ومنشؤه بين الخصاصة والفقر % 44(@)(@@) % دعاها فلو أصغت إليه مجيبة % لقلت عثرنا ، لا لعا لك من عثر % 45(@)(@@) % فجاءته لم تذمم إليه طريقها % % ولم تثو من واديه بالمبرك الوعر % 46(@)(@@) % وبالنظرة الأولى تيقنت أنه % إذا مدح اختار الثناء على الوفر % 47(@)(@@) % فساق إلينا ما نروم من الغنى % % وسقنا إليه ما يحب من الشكر % 48(@)(@@) % فلا أحسب العصر الذي قد طويته % لدى غيره طي الرداء من العمر % 49(@)(@@) % ألم آته والدهر في غلوائه % قليل غرار النوم منتشر الأمر % 50(@)(@@) % فأعذب من شربي بما مد من يدي % % وآمن من سربي بما شد من أزري % % PageV01P196 51(@)(@@) % وخولني ماضاق ذرع المنى به % من البشر في أثناء نائله الغمر % 52(@)(@@) % وقلدته مدحا يروض له الحجى % % قوافي لا تعطي القياد على القسر % 53(@)(@@) % إذا ما نسبناهن كان انتماؤها % % إليه انتماء الدر يعزى إلى البحر % 54(@)(@@) % لنعم مناخ الركب بابك للورى % % وآل عدي نعم منتجع السفر % 55(@)(@@) % تفيض ندى غمرا ، ويثني عفاته % عليك كما تثني الرياض على القطر % 56(@)(@@) % فعش طلق الأيام للمجد والعلا % % صقيل حواشي العرض في الزمن النضر % PageV01P197 البحر : طويل 1(@)(@@) % سقى الله يوما قصر اللهو طوله % وظلت خياشيم الأباريق ترعف % 2(@)(@@) % بروض تمشى بين أزهاره الصبا % % فتحسبها مذعورة حين ترجف % 3(@)(@@) % وقد مزجت ظمياء بالريق راحها % % فلم أدر من أي المدامين أرشف % 4(@)(@@) % وقلت لها شيمي لحاظك وارفقي % % بلبي وخلي البابلية تعنف % 5(@)(@@) % فطرفك لا صهباء ينزو حبابها % % قويت على قتلي به وهو يضعف % PageV01P198 البحر : بسيط تام 1(@)(@@) % هي الصبابة من باد ومكتمن % طوى لها الوجد أحشائي على شجن % 2(@)(@@) % وحنة كأوار 
ms63	 النار يضرمها % % قلب تملك رق المدمع الهتن % 3(@)(@@) % ناولته طرف الذكرى فأقلقه % شوق يصرح عنه لوعة الحزن % 4(@)(@@) % فحن والوجد يستشري عليه كما % % حن الأعاريب من نجد إلى الوطن % 5(@)(@@) % تذري دموعهم الذكرى إذا خطرت % رويحة الحزن تمري درة المزن % 6(@)(@@) % فلا استمال الهوى عيني وإن جمحت % عنها ، ولا افترش الواشي بها أذني % % 7(@)(@@) % هيفاء تخجل غصن البان من هيف % عيناء تهزأ بالغزلان من عين % 8(@)(@@) % إذا مشت دب في أعطافها مرح % كما هفت نسمات الريح بالغصن % 9(@)(@@) % وإن سرى بارق من أرضها طمحت % عين تقلص جفنيها عن الوسن % 10(@)(@@) % وأستمل إذا ريح الصبا نسمت % حديث نعمان والأنباء عن حضن % PageV01P199 11(@)(@@) % وأحبس الركب يا ظمياء إن برقت % غمامة ، وشدت ورقاء في فنن % 12(@)(@@) % على روازح يخضبن السريح دما % كادت تمس أديم الأرض بالثفن % 13(@)(@@) % إن خان سرك طرفي فالهوى علق % مني بقلب على الأسرار مؤتمن % 14(@)(@@) % إني لأرضيك والحيان في سخط % بثا عداوة موتور ومضطغن % 15(@)(@@) % ولست أحفل بالغيران ما صحبت % كفي أنابيب للعسالة اللدن % 16(@)(@@) % لا أبتغي العز إلا من أسنتها % % والموت ينزل ، والأرواح في ظعن % 17(@)(@@) % وألبس الخل تعرى لي شمائله % من الخنى ، حذر الكاسي من الدرن % 18(@)(@@) % وأنفض اليد من مال ، إذا انبسطت % إليه عادت بعرض عنه ممتهن % 19(@)(@@) % لا رغبة لي في النعمى ، إذا نسبت % لم تتصل بغياث الدولة الحسن % 20(@)(@@) % أغر يحتمل العافون نائله % على كواهل لم يثقلن بالمنن % PageV01P200 21(@)(@@) % ويمترون سجال العرف مترعة % هذي المكارم لا قعبان من لبن % 22(@)(@@) % يأوون منه إلى سهل مباءته % يرمي صفاة العدا عن جانب خشن % 23(@)(@@) % إذا المنى نزلت هيما بساحته % ظللن يمرحن بين الماء والعطن % 24(@)(@@) % أدعوك يا بن علي والخطوب غدت % تلفني وبنات الدهر في قرن % 25(@)(@@) % كم موقف كغرار السيف قمت به % والقرن مشتمل فيه على إحن % 26(@)(@@) % ومدحة ذهبت في الأرض شاردة % تهدي معد قوافيها إلى اليمن % 27(@)(@@) % فانظر إلي بعيني ناقد يقظ % تجذب إليك بضبعي شاعر فطن % 28(@)(@@) % ما كل من قال شعرا 
ms64	 فيك سيره % وليس كل كلام جيب عن لسن % 29(@)(@@) % إذا مسحت جباه الخيل سابقة % ففي يدي عنان السابح الأرن % 30(@)(@@) % إن المكارم لا ترضى لمثلك أن % % أعزى إليه وأستعدي على الزمن % PageV01P201 البحر : طويل 1(@)(@@) % فؤاد دنا منه الغرام جريح % وجفن نأى عنه الرقاد قريح % 2(@)(@@) % فللوجد قلبي والمدامع للبكا % % إذا لاح برق أو تنفس ريح % 3(@)(@@) % أكلف عيني أن تجود بمائها % % وإنى به لولا الهوى لشحيح % 4(@)(@@) % ويعذلني خلي ويزعم أنه % نصيح وهل في العاذلين نصيح ؟ % 5(@)(@@) % ولو أنصف الواشون رق لذي الشجى % % خلي ، وما لام السقيم صحيح % 6(@)(@@) % فما لغراب البين ينعب بعدما % % أتت دون من أهوى مهامه فيح ؟ % 7(@)(@@) % بفيه الثرى قد فرقت بيننا النوى % % نأى عنه فرخاه ففيم يصيح ؟ % PageV01P202 البحر : وافر تام 1(@)(@@) % تلفت بالثوية نحو نجد % فبات فؤاده علقا بوجد % 2(@)(@@) % وقد خلصت إليه بعيد وهن % صبا عثرت على لغب برند % 3(@)(@@) % فهاج حنينه إبلا طرابا % تكفكف غربها حلقات قد % 4(@)(@@) % حثون على العراق تراب نجد % فلا ألقت مراسيها بورد % 5(@)(@@) % وكم خلفن من طلل بحزوى % % وسمت عراصه مرحا ببردي % % 6(@)(@@) % ولينة المعاطف في التثني % % ضعيفة رجع ناظرة وقد % 7(@)(@@) % تجلت للوداع على ارتياع % من الواشي ينير بنا ويسدي % % 8(@)(@@) % وقد جعلت على خفر تراءى % % فتخفي من محاسنها وتبدي % % 9(@)(@@) % وكم باك كأن الجيد منها % % يوشح من مدامعه بعقد % 10(@)(@@) % شجاه البرق فهو كما تنزى % % إليك السقط من أطراف زند % PageV01P203 11(@)(@@) % تناعس حين جاذبه كراه % وقد شمط الظلام ، هدير رعد % 12(@)(@@) % فما لك يابنة القرشي غضبى % % أمنسي على العلمين عهدي % % 13(@)(@@) % وبين جوانحي شجن قديم % أعد له الغوابة فيك رشدي % % 14(@)(@@) % فلا ملل ألف عليه قلبا % ولا غدر أخيط عليه جلدي % % 15(@)(@@) % وإن يك صافيا وشل تمشت % بجانبه الصبا ، فكذاك ودي % % 16(@)(@@) % وبي عن خطة الضيم ازورار % إذا ما جد للعلياء جدي % % 17(@)(@@) % فلا ألقي الجران بها مبنا % بطيء النهض كالجمل المغد % 18(@)(@@) % ولكني أخو العزمات ماض % ومرهوب على اللؤماء حدي % % 19(@)(@@) % فهل من مبلغ سروات 
ms65	 قومي % % مضاجعتي على العزاء غمدي % % 20(@)(@@) % وإدلاجي وجنح الليل طاو % جناحيه على نصب وكد % PageV01P204 21(@)(@@) % وقد رنت النجوم إلي خوصا % بأعين كاسرات الطرف رمد % 22(@)(@@) % لأورثهم مآثر صالحات % شفعت طريفها لهم بتلد % 23(@)(@@) % ولولا الله ثم بنو عقيل % لقصر دون غايتهن جهدي % % 24(@)(@@) % فها أنا بالعراق نجي عز % وإلف كرامة وحليف رفد % 25(@)(@@) % أقد به قوافي محكمات % لأروع قد من سلفي معد % 26(@)(@@) % أغر تدر راحته سماحا % ولم تعصب رغائبه بوعد % 27(@)(@@) % ويغضي من تكرمه حياء % ودون إبائه سطوات أسد % % 28(@)(@@) % له ، والمحل غادر كل عاف % يكد العيس منتجعا فيكدي % % 29(@)(@@) % فناء مخصب العرصات رحب % إذا ضاقت مباءة كل وغد % 30(@)(@@) % تلثمه المواهب كل يوم % تمج سماؤه علقا ، بوفد % PageV01P205 31(@)(@@) % وتصغي الأرحبية في ذراه % إلى قب أياطلهن جرد % 32(@)(@@) % وما متوقد اللحظات يحمي % % على حذر معرسه بوهد % 33(@)(@@) % كأن نفي جلدته بقايا % % دلاص فضها الملوان سرد % 34(@)(@@) % تراه الدهر مكتحلا بجمر % يكاد يذيب مهجته بوقد % 35(@)(@@) % بأحضر وثبة منه إذا ما % % رأى إغضاءه يلد التعدي % % 36(@)(@@) % أعدك للعدا يا سعد فاهتف % % بسمر من رماح الخط ملد % 37(@)(@@) % ومد إلى العلا ضبعي ، وامنع % صروف الدهر أن يضرعن خدي % % 38(@)(@@) % فعندك ملتقى سبل المعالي % % ومعترك القوافي الغر عندي % % 39(@)(@@) % أتاك العيد يرفع ناظريه % إلى ما فيك من كرم ومجد % 40(@)(@@) % ودهرك - دع بنيه - إليك يهفو % % بطاعة مستبين الرق عبد % PageV01P206 41(@)(@@) % ويعلم أن سيفك عن قليل % يشوب من العدو دما بحقد % 42(@)(@@) % فلا زالت لك الأيام سلما % ملقحة لياليها بسعد % PageV01P207 البحر : طويل 1(@)(@@) % وساجية الألحاظ تفتر إن رنت % فتحسبها مملوءة من رقادها % % 2(@)(@@) % أعلل نفسي بالمنى ، ويشوقني % % سنا البرق يسري موهنا من بلادها % % 3(@)(@@) % وما لي منها غير داء مخامر % يبرح بي في قربها وبعادها % % 4(@)(@@) % وأرعى نجوم الليل والعين ثرة % تراقبها مطروفة بسهادها % % 5(@)(@@) % فليت بياض الصبح يبدو لمقلة % كأن الدجى مخلوقة من سوادها % % PageV01P208 البحر : طويل 1(@)(@@) % خضاب على فودي للدهر ما نضا % % ومقتبل من ريق العمر ما مضى % % 2(@)(@@) % ونفس على 
ms66	 الأيام غضبي وقد أبت % % تصاريفها أن تبدل السخط بالرضى % % 3(@)(@@) % إذا أنا عاتبت الليالي لم تبل % عتابا كترنيق النعاس ممرضا % % 4(@)(@@) % وفي الكف عضب كلما فاض من دم % عبيط غرارا فاح بالمسك مقبضا % % 5(@)(@@) % وإن ديونا ما طلتها صروفها % % ببيض الظبا في هبوة النقع تقتضى % % 6(@)(@@) % إذا ما ذوى غصن الشباب ولم تسد % وشبت ، فلا تطلب إلى العز منهضا % % 7(@)(@@) % سأفري أديم الأرض بالعيس نقبا % حبا بالذي أبغيه أو بخل ، القضا % % 8(@)(@@) % وإن ضقت ذرعا بالمنى فرحيبة % بها خطوات الأرحبية والفضا % % 9(@)(@@) % ومن شيمي أن أهجر الماء صاديا % إذا كان طرقا سؤره متبرضا % % 10(@)(@@) % وأطوي على الهم النزيع جوانحي % % وإن أقلق الخطب الملم وأرمضا % % PageV01P209 11(@)(@@) % وأصبر والرمح الرديني شاجر % وأجزع إن بان الخليط وأعرضا % % 12(@)(@@) % وريم رمى قلبي بأسهم لحظه % فأصمى وفي قوس الحواجب أنبضا % % 13(@)(@@) % طرقت الغضى والليل جثل فروعه % فأومى بعينيه إلي وأومضا % % 14(@)(@@) % وقال لتربيه : ارفعا السجف إنني % % أحسن بزور للمنايا تعرضا % % 15(@)(@@) % وما هو إلا الليث يرتاد مطمعا % على غرة ، أولا فمن نفض الغضى ؟ % 16(@)(@@) % أخاف عليه غلمة الحي إنهم % لووا من هواديهم إلى الفجر . هل أضا % % 17(@)(@@) % وحيث التقى الجفنان دمع يفيضه % إذا من الواشي ، وإن ريع غيضا % % 18(@)(@@) % فدى لك يا ظبي الصريمة مهجة % أعدت ليوم الروع جأشا مخفضا % % 19(@)(@@) % فلا ترهب الأعداء ما عصفت يدي % % بأسمر ، أو ناطت نجادي بأبيضا % % 20(@)(@@) % سأضرب أكباد المطي على الوجى % % إلى خير من يرجى إذا الخطب نضنضا % % PageV01P210 21(@)(@@) % إلى عضد الدين الذي ساغ مشربي % % به بعدما أشجى الزمان و أجرضا % % 22(@)(@@) % أغر ، إذا استنجدت هب إباؤه % به ؛ وإن استعطفت أغضى وغمضا % % 23(@)(@@) % وكم غمرة دون الخلافة خاضها % % بآرائه ، وهي الصوارم تنتضى % % 24(@)(@@) % تكشر عن يوم يرشح صبحه % أجنة ليل بالمنايا تمخضا % % 25(@)(@@) % على ساعة يضحي الفرار محببا % ويمسي الحفاظ المر فيها مبغضا % % 26(@)(@@) % وقد أرهف العزم الذي بشباته % نهوض جناح هم أن يتهيضا % % 27(@)(@@) % أبينوا من المدعو والرمح تلتوي % % به حلقات الدرع كالأيم في الأضى % % 28(@)(@@) % ومن 
ms67	 قال حتى رد ذا النطق مفحما % ومن صال حتى غادر القرن محرضا % % 29(@)(@@) % فهل هو مجزي بأكرم سعيه % فقد أسلف الصنع الجميل وأقرضا % % 30(@)(@@) % فداك بهاء الدولة الناس إنهم % سراحين يستوطئن في الغدر مربضا % PageV01P211 31(@)(@@) % إذا لقح الود القديم تطلعت % ضغائنهم قبل النتاج فأجهضا % 32(@)(@@) % لهم أنفس لا يرخص الدهر عارها % % وإن ألبسوهن الرداء المرحضا % % 33(@)(@@) % أرى كل من جربت منهم مداجيا % اذا لم يصرح بالإساءة عرضا % % 34(@)(@@) % يغرك - مالم تختبره - رواؤه % كما غر عن أديانها طيئا رضا % % 35(@)(@@) % وجائلة الأنساع مائلة الطلى % % ببيداء لا تلفي بها الريح مركضا % % 36(@)(@@) % فشبت لها تحت الأحجة أعين % لمرعى على أطرافه العز حوضا % % 37(@)(@@) % بواد على الرواد يندى مذانبا % % إذا زاره العافي أخل وأحمضا % % 38(@)(@@) % إليك زجرناها وعندك بركت % بمغنى تقراه الربيع وروضا % % 39(@)(@@) % فلا العهد مما يستشن أديمه % ولا المجد يرضى أن يخان وينقضا % % 40(@)(@@) % ولاهمتي ترضى بتقبيل أنمل % نشأن على فقر ، وإن كن فيضا % % PageV01P212 41(@)(@@) % فإن بني البيت الرفيع عماده % إذا افترشوا فيه الهوينى تقوضا % % 42(@)(@@) % ولولاك لم أنطق وإن كنت محسنا % بشعر ، ولم أسال وإن كنت منفضا % % 43(@)(@@) % إليك هفت طوع الأزمة همتي % % وكانت على غي الأماني ريضا % % 44(@)(@@) % فقد صار أمري ، والأمور لها مدى % إليك على رغم الأعادي مفوضا % % PageV01P213 البحر : طويل 1(@)(@@) % لويت على الرمح الرديني معصما % % وزرت العدا والحرب فاغرة فما % % 2(@)(@@) % وقد زعموا أني ألين عريكتي % % لهم إذ توسدت الخماصة معدما % % 3(@)(@@) % أما علموا أني وإن كنت مقترا % أروي من القرن الحسام المصمما % % 4(@)(@@) % ويشرق وجهي حين ينسب والدي % % وتلقى عليه للسيادة ميسما % % 5(@)(@@) % وإن ذكروا آباءهم فوجوههم % تشبهها قطعا من الليل مظلما % % 6(@)(@@) % وللفقر خير من أب ذي دناءة % إذا هز للفخر ابنه عاد مفحما % % 7(@)(@@) % متى حصلت أنساب قيس وخندف % فلي من روابيهن أشرف منتمى % % 8(@)(@@) % وإن نشرت عنها صحيفة ناسب % رأيت بدورا من جدودي وأنجما % % 9(@)(@@) % لهم أوجه عند الفخار تزينها % % عرانين ما شمت هوانا ومرغما % % 10(@)(@@) % ليقصد مسر الضغي فينا بذرعه % ولا يستثر 
ms68	 منا بواديه ضيغما % % PageV01P214 11(@)(@@) % فإن المنايا حين يضمرن غلة % ليلعقن من أطراف أرماحنا الدما % % PageV01P215 البحر : طويل 1(@)(@@) % لك المجد لا ما تدعيه الأوائل % وما في مقال بعد مدحك طائل % 2(@)(@@) % وليس يؤدي بعض ما أنت فاعل % إذا رمت وصفا ، كل ماأنا قائل % 3(@)(@@) % أبوك وأنت السابقان إلى العلا % % على شيم منهن حزم ونائل % 4(@)(@@) % ولولا كما لم يعرف البأس والندى % % ولم يدر ساع كيف تبغى الفضائل % 5(@)(@@) % وهل يلد الضرغام إلا شبيهه % وينجب إلا الأكرمون الأماثل % 6(@)(@@) % فليت أبا لا يورث الفخر عاقر % وأما إذا لم تعقب المجد حائل % 7(@)(@@) % وأنت الذي إن هز أقلامه حوى % % بها ما نبت عنه الرماح الذوابل % 8(@)(@@) % يطول لسان الفخر في مكرماته % ويقصر باع الدهر عما يحاول % 9(@)(@@) % وحي من الأعداء تبدي شفاههم % نواجذ مقرون بهن الأنامل % 10(@)(@@) % فمنهم بمستن المنايا معرس % تطيف به سمر القنا والقنابل % PageV01P216 11(@)(@@) % وآخر تستدني خطاه قيوده % وهن بساقي كل عاص خلاخل % 12(@)(@@) % أزرتهم بيضا كأن متونها % % أجن المنايا السود فيها الصياقل % 13(@)(@@) % ولم يبق إلا من عرفت وعنده % % مكائد تسري بينهن الغوائل % 14(@)(@@) % أطلت له باعا قصيرا فمده % إلى أمد يعيى به المتطاول % 15(@)(@@) % وخاتل عن أضعانه بتودد % وهل يمحض الود العدو المخاتل % 16(@)(@@) % لئن ظهرت منه خديعة ماكر % فسيفك لا تخفى عليه المقاتل % 17(@)(@@) % وكم يوقظ الأحقاد من رقداتها % % وترقد في أغمادهن المناصل % 18(@)(@@) % فرو غرار المشرفي به دما % فأم الذي لا يتبع الحق ثاكل % 19(@)(@@) % بيوم تردى بالأسنة فاستوت % هواجره من وقعها والأصائل % 20(@)(@@) % وغار على الشمس العجاج ، فإن سمت % لتلحظها عين ثنتها القساطل % PageV01P217 21(@)(@@) % وحليت الأعناق فيه من الظبا % % قلائد لا يصبو إليهن عاطل % 22(@)(@@) % بكف تعير السحب من نفحاتها % % فترخي عزاليها الغيوث الهواطل % 23(@)(@@) % وهمة طلاع إلى كل سؤدد % له غاية من دونها النجم آفل % 24(@)(@@) % ففاز غياث الدين منك بصارم % على عاتق العلياء منه الحمائل % 25(@)(@@) % ودان له حزن البلاد وسهلها % % وأنت المحامي دونها والمناضل % 26(@)(@@) % فما بال زوراء العراق منيخة % بمعترك تدمى 
ms69	 لديه الكلاكل % 27(@)(@@) % تشيم من الهيجاء برقا إذا بدا % % همى بالنجيع الورد منه المخائل % 28(@)(@@) % تحيد الرجال الغلب عن غمراتها % % وتسلم فيهن النساء المطافل % 29(@)(@@) % كأن الألى طاروا إلى الحرب ضلة % نعام يباري خطرة الريح جافل % 30(@)(@@) % ومن أين يستولي من العرب رامح % على بلد فيه من الترك نابل % PageV01P218 31(@)(@@) % أبابل لا واديك بالرفد مفعم % لدينا ، ولا ناديك بالوفد آهل % 32(@)(@@) % لئن ضقت عني فالبلاد فسيحة % وحسبك عارا أنني عنك راحل % 33(@)(@@) % وإن كنت بالسحر الحرام مدلة % فعندي من السحر الحلال دلائل % 34(@)(@@) % قواف تعير الأعين النجل سحرها % % فكل مكان خيمت فيه بابل % 35(@)(@@) % وأي فتى ماضي العزيمة راعه % ملوكك ، لاروى رباعك وابل % 36(@)(@@) % أغر رحيب في النوائب ذرعه % لأعباء ما يأتي به الدهر حامل % 37(@)(@@) % فتى الحي يرمي بالخصوم وراءه % حيارى إذا التفت عليه المحافل % 38(@)(@@) % متى تسلب الجرد الجياد مراحها % % إليك كما يستنفر النحل عاسل % 39(@)(@@) % تقرط أثناء الأعنة ، والثرى % % يواري جبين الشمس ، والنقع ذائل % 40(@)(@@) % إذا نضت الظلماء برد شبابها % % مضت وخضاب الليل بالصبح ناصل % PageV01P219 41(@)(@@) % ولفت على صحن العراق عجاجها % % يقدمها من آل إسحاق باسل % 42(@)(@@) % اذا ماسرى فالليل بالبيض مقمر % ولون الضحى إن سار بالنقع حائل % 43(@)(@@) % همام إذا ما الحرب ألقت قناعها % % فلا عزمه واه ، ولا الرأي فائل % 44(@)(@@) % وإن كدرت صفو الليالي خطوبها % % صفت منه في غمائهن الشمائل % 45(@)(@@) % أبى طوله أن يستفاد بشافع % نداه ومعصي لديه العواذل % 46(@)(@@) % فلم يحتضن غير الرغائب راغب % ولم يتشبث بالوسائل سائل % 47(@)(@@) % إليك أوى يابن الأكارم ماجد % له عند أحداث الزمان طوائل % 48(@)(@@) % تجر قوافيه إليك ذيولها % % كما ابتسمت غب الرهام الخمائل % 49(@)(@@) % وعندك ترعى حرمة المجد فارتمى % % إليك به دامي الأظلين بازل % 50(@)(@@) % براه السرى والسير ، وهو من الضنى % % حكاه هلال كالقلامة ناحل % PageV01P220 51(@)(@@) % قليل إلى الري الذليل التفاته % وإن كثرت للواردين المناهل % 52(@)(@@) % وها أنا أرجو من زمانك رتبة % يقل المسامي عندها والمساجل % 53(@)(@@) % وليس ببدع أن أنال بك العلا % % فمثلك مأمول ، ومثلي آمل 
ms70	 % PageV01P221 البحر : طويل 1(@)(@@) % وأغيد يحوي وجهه الحسن كله % وينكر أن البدر فيه شريكه % 2(@)(@@) % أتاني وفي يمناه كأس كأنها % % من التبر يعلى باللجين سبيكه % 3(@)(@@) % فنازعته الصهباء طورا وتارة % جنى الريق حتى نم بالصبح ديكه % PageV01P222 البحر : متقارب تام 1(@)(@@) % سرى البرق والليل يدني خطاه % فبات على الأين يلوي مطاه % 2(@)(@@) % ولاح كما يقتذي طائر % ولم يستطع من كلال سراه % % 3(@)(@@) % فمال على ساعديه الغريب % بخديه حتى ونى مرفقاه % % 4(@)(@@) % وحن إلى عذبات اللوى % % ووادي الحمى وإلى منحناه % 5(@)(@@) % وهل يستنيم إلى سلوة % أخو شجن أجهضته نواه % 6(@)(@@) % فشام بأروند ذاك الوميض % وأين سناه ؟ بنجد سناه % % 7(@)(@@) % ومن دونه أمد نازح % إذا أمه الطرف أوهى قواه % % 8(@)(@@) % فهل من معين على نأيه % بنظرة صقر رأى ما ابتغاه % 9(@)(@@) % وطار على إثره فامتطى % % سراة نهار صقيل ضحاه % 10(@)(@@) % فها هو يذكر ملء الفؤاد % زمانا مضى وشبابا نضاه % % PageV01P223 11(@)(@@) % ومرتبعا بالحمى والنعي % % م يلقي بحاشيتيه عصاه % % 12(@)(@@) % هنالك ربع تشيم الأسو % % د فيه لواحظها عن مهاه % 13(@)(@@) % ويختال في ظله المعتفون % وتندى على زائريه رباه % % 14(@)(@@) % فهل أرين بعيني المطي % يهز الذميل إليه طلاه % 15(@)(@@) % ويسترجع القلب أفراحه % به ويصافح جفني كراه % % 16(@)(@@) % أمثلي - ولا مثل لي في الورى % % ولا لأمية حاشا علاه - % 17(@)(@@) % تفوقني نكبات الزمان % عفافة ما أسأرته الشفاه % 18(@)(@@) % وفي مدرعي ماجد لا يحوم % على نغب كدرات صداه % % 19(@)(@@) % ويطوي الضلوع على غلة % إذا درعته الهوان المياه % % 20(@)(@@) % ولا يتهيب أمرا تشد % عواقبه بالمنايا عراه % PageV01P224 21(@)(@@) % وإن تقتسم مضر ما بنت % ه من مجدها يتفرع ذراه % 22(@)(@@) % ولي همة بمناط النجوم % وفضل توشح دهري حلاه % % 23(@)(@@) % وسطوة ذي لبد في العري % % ن منضوحة بنجيع سطاه % % 24(@)(@@) % يحدد ظفرا يمج المنون % % إذا ساور القرن أدمى شباه % 25(@)(@@) % ويوقد لحظا يكاد الكمي % - يقبس والليل داج ، لظاه % 26(@)(@@) % سلي يابنة القوم عمن تضم % درعي وبردي عما حواه % % 27(@)(@@) % ففي تلك أصحر يغشى المكر % وفي ذاك أسحم واه كلاه % 28(@)(@@) % أجرر أذيالها كالغدير % اذا 
ms71	 ما النسيم اعتراه زهاه % 29(@)(@@) % وقائم سيفي بمسك يفوح % وترشح من علق شفرتاه % 30(@)(@@) % وتحتي أدهم رحب اللبان % حبيك قراه ، سليم شظاه % % PageV01P225 31(@)(@@) % كسا الفجر من نوره صفحتي % % ه ، والليل ألبسه من دجاه % % 32(@)(@@) % سيعلم دهر عدا طوره % على أي خرق جنى ماجناه % 33(@)(@@) % وأي غلام سما نحوه % ولم يسأل المجد عن منتماه % % 34(@)(@@) % أغر ، عزائمه من ظبا % % أعرن التألق من مجتلاه % % 35(@)(@@) % وليس برعديدة في الخطوب % ولا خفق في الرزايا حشاه % 36(@)(@@) % أتخشى الضراغم ذؤبانه % وتشكو الصقور إليه قطاه ؟ % 37(@)(@@) % ولولا تنمره للكرام % لما فارقت أخمصيه الجباه % % 38(@)(@@) % وعن كثب يتقرى بنيه % بما يعقد العز فيه حباه % % 39(@)(@@) % فيسقي صوارمه منهم % عبيط دم ، ويروي قناه % 40(@)(@@) % ومن ينحسر عنه ظل الغنى % % ففي المشرفيات مال وجاه % PageV01P226 41(@)(@@) % فما للذليل يسام الأذى % % ويخشى الردى ، لاوقاه الإله % PageV01P227 البحر : وافر تام 1(@)(@@) % ألا بأبي بلادك يا سليمى % % وما ضم العذيب من الربوع % 2(@)(@@) % ولي نفس إذا هيجن وجدي % % يكاد يقيم معوج الضلوع % 3(@)(@@) % فلم أزر الديار الطرف حتى % % نفضت بهن أوعية الدموع % PageV01P228 البحر : طويل 1(@)(@@) % سرى طيفها والملتقى متدان % وجنح الدجى والصبح يعتلجان % 2(@)(@@) % ولا نيل إلا الطيف في القرب والنوى % % وأما الذي نهذي به فأماني % % 3(@)(@@) % خليلي من عليا قريش هديتما % % أشأنكما في حب علوة شاني ؟ % 4(@)(@@) % فمالكما يوم العذيب نقمتما % % علي البكا ، والأمر ما تريان ؟ % 5(@)(@@) % فؤاد بذكر العامرية مولع % وعين لجوج الدمع في الهملان % 6(@)(@@) % أما فيكما من هزة أموية % لأروع في أسر الصبابة عان ؟ % 7(@)(@@) % ولم يحزن الحي الكناني أن أرى % % أسيرا لهذا الحي من غطفان % 8(@)(@@) % ألا بأبي ذاك الغزيل إذ رنا % % إلي ، وذياك البريق شجاني % % 9(@)(@@) % نظرت غداة البين والعين ثرة % وردناي مما أسبلت خضلان % 10(@)(@@) % فحمحم مهري وامترى الدمع صاحبي % % وقد كاد يبكي منصلي وسناني % % PageV01P229 11(@)(@@) % ولولا حنين الأرحبية لم يهج % % فتى مضري من بكاء يمان % 12(@)(@@) % أفق من جوى يا أيها المهر ، إنني % % وإياك في أهل الغضى غربان % 13(@)(@@) % يشوقك ماء بالأباطح سلسل % وقد نشحت 
ms72	 بالأبرقين شناني % % 14(@)(@@) % هواي لعمري ماهويت ، وإنما % % يجاذبني ريب الزمان عناني % % 15(@)(@@) % وما مغزل تعطو الأراك ، يهزه % نسيم تناجيه الخمائل وان % 16(@)(@@) % وتزجي بروقيها أغن كأنه % من الضعف يطوي الأرض بالرسفان % 17(@)(@@) % فمال إلى الظل الأراكي دونها % % وكانا به من قبل يرتديان % 18(@)(@@) % وصبت عليه الطلس وهي سواغب % تجوب إليه البيد بالنسلان % 19(@)(@@) % فعادت إليه أمه ، وفؤادها % % هفا كجناح الصقر في الخفقان % 20(@)(@@) % وظلت على الجرعاء ولهى كئيبة % وقد سال واديها بأحمر قان % PageV01P230 21(@)(@@) % تسوف الثرى طورا ، ويعبث تارة % بها أولق من شدة الولهان % 22(@)(@@) % بأوجد مني يوم سرنا إلى الحمى % % وقد نزلت سمراء سفح أبان % 23(@)(@@) % أفي كل يوم حنة تعقب الأسى % % وهبت لها الأحشاء منذ زمان % 24(@)(@@) % فحتام أغضي ناظري على القذى % % وألقي بمستن الخطوب جراني % % 25(@)(@@) % ألم تعلم الأيام أني بمنزل % به يحتمى من طارق الحدثان ؟ % 26(@)(@@) % بأشرف بيت في لؤي بن غالب % جنوح إلى أبوابه الثقلان % 27(@)(@@) % ومربوطة جرد سوابق حوله % بمركوزة ملس المتون لدان % 28(@)(@@) % تخر على الأذقان في عرصاته % ملوك يرون العز تحت هوان % 29(@)(@@) % وتجمح فيهم هيبة قرشية % لأبيض من آل النبي هجان % 30(@)(@@) % من النفر البيض الألى تعتزي العلا % % إليهم بيومي نائل وطعان % PageV01P231 31(@)(@@) % بهم رفعت عليا معد عمادها % % ودانت لها الأيام بعد حران % 32(@)(@@) % وجروا أنابيب الرماح بهضبة % من المجد تكبو دونها القدمان % 33(@)(@@) % فأفياؤهم للمستجير معاقل % وأبياتهم للمكرمات مغاني % % 34(@)(@@) % أقول لحادينا وقد لغب السرى % % بأشباح قود كالقسي حوان % 35(@)(@@) % نواصل من أعقاب ليل كأنما % % سقاها الكرى عانية وسقاني % % 36(@)(@@) % يلوين أعناقا خواضع في الدجى % % وترمي بألحاظ إلي روان % 37(@)(@@) % أنخها طليحات المآقي لواغبا % بما اعتسفت من صحصح ومتان % 38(@)(@@) % فإن أمير المؤمنين وجاره % بعلياء لا يسمو لها القمران % 39(@)(@@) % إليك امتطيت الخيل والليل والفلا % % وقد طاح في الإدلاج كل هدان % 40(@)(@@) % بذي مرح لا يملأ الهول قلبه % ولا يتلقى لمة بلبان % PageV01P232 41(@)(@@) % وأهدي إليك الشعر غضا ، وماله % بنشر أياديك الجسام يدان % 42(@)(@@) % تطول يدي منها على ما أريده % ويقصر 
ms73	 عنها خاطري ولساني % % 43(@)(@@) % بقيت ولا أبقى لك الله كاشحا % على غرر يرمى به الرجوان % 44(@)(@@) % ومد عنان الدهر إن شاء أو أبى % % إلى نيل ما أملته الملوان % PageV01P233 البحر : وافر تام 1(@)(@@) % وغيد أنكرت شمطي فظلت % تغمض دونه طرفا مريضا % % 2(@)(@@) % وشيمتها التزاور عن مشيب % يرد حبيب غانية بغيضا % % 3(@)(@@) % فما ارتاعت من الحيات سودا % % كما ارتاعت من الشعرات بيضا % % PageV01P234 البحر : بسيط تام 1(@)(@@) % من أغفل الحزم أدمى كفه ندما % % واستضحك النصر من أبكى السيوف دما % % 2(@)(@@) % فالرأي يدرك ما يعيى الحسام به % إذا الزمان بذيل الفتنة التثما % % 3(@)(@@) % هاب العدا غمرات الموت إذ بصروا % % بالأسد تنزل من سمر القنا أجما % % 4(@)(@@) % والخيل عابسة يعتادها مرح % إذا امتطاها نظام الدين مبتسما % % 5(@)(@@) % في ساعة تذر الأرماح راعفة % والمشرفي على الأرواح محتكما % % 6(@)(@@) % رطب الغرارين مأمون على بطل % يخشى زمانا على الأحرار متهما % % 7(@)(@@) % تلوح غرته والجرد نافضة % على جبين الضحى من نقعها قتما % % 8(@)(@@) % وللسهام حفيف في مسامعهم % كالنحل ألقيت في أبياته الضرما % % 9(@)(@@) % إذا استطارت طلاع الأفق أردفها % % بالبيض عوضن عن أغمادها القمما % % 10(@)(@@) % لم تطلع الشمس إلا استقبلت بعمى % ولا بدا النجم إلا استشعر الصمما % % PageV01P235 11(@)(@@) % توقفوا كارتداد الجفن وانصرفوا % % كما طردت حذار الغارة النعما % % 12(@)(@@) % والأعوجية كادت من تغيظها % % على فوارسها أن تلفظ اللجما % % 13(@)(@@) % من كل طرف يبذ الطرف ملتهبا % في حضره ، ولشأو الريح ملتهما % % 14(@)(@@) % ردع النجيع مبين في حوافرها % % مما يطأن بمستن الردى بهما % % 15(@)(@@) % كأن كل بنان من ولائدهم % أهدى إليهن إذ نجينهم عنما % % 16(@)(@@) % باض النعام على هاماتهم ، وهم % أشباهه ، والوغى يسترجف اللمما % % 17(@)(@@) % فبات أرحبهم في كل نائبة % ذرعا تضيق عليه الأرض منهزما % % 18(@)(@@) % وما التفت احتقارا نحوه وبه % نجلاء يلوي لها حيزومه ألما % % 19(@)(@@) % ولو أملت إليه السوط غادره % شلوا بمعترك الأبطال مقتسما % % 20(@)(@@) % وعصبة ملئت غيظا صدورهم % من مخفر ذمة ، أو قاطع رحما % % PageV01P236 21(@)(@@) % واستوطؤوا ثبج البغضاء واجتذبوا % % حبلا أمر على الشحناء فانجذما % % 22(@)(@@) % والشعب إن دب في تفريقه 
ms74	 إحن % فلن يعود طوال الدهر ملتئما % % 23(@)(@@) % وأنت أبعد في فضل ومكرمة % شأوأ ، وأثبت منهم في الوغى قدما % % 24(@)(@@) % وخيرهم حسبا ضخما ، وأغزرهم % سيبا ، وأضفى على مسترفد نعما % % 25(@)(@@) % تعفو وتصفح عن عز ومقدرة % ولا نراك وقيذ الحلم منتقما % % 26(@)(@@) % إذا أذاب شرار الحقد عاطفة % هززت للعفو عطفي سؤدد كرما % % 27(@)(@@) % فود كل بريء مذ عرفت به % دون البرية ، أن يلقاك مجترما % % 28(@)(@@) % ومن مساعيك فتح إذ سللت له % رأيا فللت به الصمصامة الخذما % % 29(@)(@@) % أضحى به الدين مفترا مباسمه % والملك بعد شتات الشمل منتظما % % 30(@)(@@) % فأشرق العدل والأيام داجية % بثت يد الظلم في أرجائها الظلما % % PageV01P237 31(@)(@@) % وقد رمى بك ركن الدين معضلة % يهاب كل كمي دونها قحما % % 32(@)(@@) % فقمت بالخطب مرهوبا عواقبه % للعزم محتضنا ، للحزم ملتزما % % 33(@)(@@) % كالبحر متلطما ، والفجر مبتسما % والليث معتزما ، والغيث منسجما % 34(@)(@@) % كفته كتبك أن تزجى كتائبه % وألهم السيف أن يستنجد القلما % % 35(@)(@@) % تلقى الشدائد في نيل العلا ولها % % يعالج الهم من يستنهض الهمما % % 36(@)(@@) % وإن أرابك من دهر تكدره % كنت المصفى على أحداثه شيما % % 37(@)(@@) % فابسط إلى أمد تسمو إليه يدا % تكفي المؤمل أن يستمطر الديما % % 38(@)(@@) % ولا تبل سخط الأعداء ، إنهم % يرضون منك بأن ترضى بهم خدما % % 39(@)(@@) % وسل بي المجد تعلم أي ذي حسب % في بردتي إذا ما حادث هجما % % 40(@)(@@) % يلين للخل في عز عريكته % محض الهوى ، وله العتبى إذا ظلما % % PageV01P238 41(@)(@@) % من معشر لا يناجي الضيم جارهم % نضو الهموم غضيض الطرف مهتضما % % 42(@)(@@) % فصحة الود تأبى وهي ظاهرة % أن تخفي الحال في أيامكم سقما % % 43(@)(@@) % والدهر يعلم أني لا أذل له % فكيف أفتح بالشكوى إليك فما % % PageV01P239 البحر : كامل تام 1(@)(@@) % رغم الأراذل إذ ورثنا سؤددا % عودا له أثر علينا بين % 2(@)(@@) % وتيقنوا أني إذا اشتجر القنا % % خشن وعطفي في السماحة لين % 3(@)(@@) % وإذا هم رغموا وقد بسط العلا % % باعي ، فذاك لدي رغم هين % PageV01P240 البحر : وافر تام 1(@)(@@) % تأملت الورى جيلا فجيلا % % فكان كثيرهم عندي قليلا % % 2(@)(@@) % لهم صور تروق ولا 
ms75	 حلوم % وأجسام تروع ولا عقولا % % 3(@)(@@) % وأبصر خاملا يجفو نبيها % وأسمع عالما يشكو جهولا % % 4(@)(@@) % إذا ما شئت أن يلقاك فيهم % % عدو فاتخذ منهم خليلا % % 5(@)(@@) % وإن تؤثر دنوهم تمارس % أذى تجد العناء به طويلا % % 6(@)(@@) % وإن ناولهم أطراف حبل % وهي فاهجرهم هجرا جميلا % % 7(@)(@@) % ولن لهم وخادعهم أو اشدد % على صفحاتهم وطئا ثقيلا % % 8(@)(@@) % فإما أن تغالبهم عزيزا % وإما أن تداريهم ذليلا % % 9(@)(@@) % ومن راقته ضجعته بدار % يقل المشرفي بها صليلا % % 10(@)(@@) % فلست من الهوان وليس مني % % فألبسه وأدرع الخمولا % % PageV01P241 11(@)(@@) % إذا الأموي قرب أعوجيا % وضاجع هندوانيا صقيلا % % 12(@)(@@) % فذره والمصاع ، فسوف تؤتى % % به ملكا مهيبا أو قتيلا % % 13(@)(@@) % وطامحة العيون ، على مطاها % % أسود يتخذن السمر غيلا % % 14(@)(@@) % أظن مراحها راحا ، فمنه % بها ثمل وما شربت شمولا % % 15(@)(@@) % وأزجر من نزائعها رعيلا % إذا وقذ الوجى منها رعيلا % % 16(@)(@@) % وأوردها الوغى والنقع كاب % فتسحب من وشائعه ذيولا % % 17(@)(@@) % وتعثر بالكماة الصيد صرعى % % فتنفر وهي تحسبهم نخيلا % % 18(@)(@@) % بحيث النسر لا يلفي لديهم % سوى الذئب الأزل له أكيلا % % 19(@)(@@) % وتخطر في نجيع غب طعن % وجيع يسلب البطل الشليلا % % 20(@)(@@) % كأن الشمس قد نضحت جيادي % % بذوب التبر إذ جنحت أصيلا % % PageV01P242 21(@)(@@) % وسيفي تتقيه الهام حتى % % تفارق قبل سلته المقيلا % % 22(@)(@@) % به بعد الإله بلغت شأوا % يسارقه السها نظرا كليلا % % 23(@)(@@) % وطافت بالعلا هممي وعافت % غنى أرعى به كلأ وبيلا % % 24(@)(@@) % فلم أحمد لعارفة جوادا % ولم أذمم على منع بخيلا % % 25(@)(@@) % نماني كل أبيض عبشمي % تعد النيرات له قبيلا % % 26(@)(@@) % فآبائي معاقلهم سيوف % بها شجوا الحزونة والسهولا % % 27(@)(@@) % وأرضى الله نصرهم لدين % به بعث ابن عمهم رسولا % % 28(@)(@@) % وهم غرر أضاءت في نزار % وكان بنوه بعدهم حجولا % % 29(@)(@@) % متى هذر القبائل في فخار % بألسنة تهز بها نصولا % % 30(@)(@@) % فنحن نكون أطولها فروعا % إذا نسبت وأكرمها أصولا % % PageV01P243 البحر : كامل تام 1(@)(@@) % ومكاشح نهنهته عن غاية % زأر الأسود الغلب دون عرينها % % 2(@)(@@) % إنا معاويون نبسط أيديا % في المكرمات شمالها كيمينها % % 3(@)(@@) % من كل ذي حسب 
ms76	 نمته حرة % غراء لاح العتق فوق جبينها % % 4(@)(@@) % خضل البنان ، إليه يزجي المجتدي % % وجناء أبلى السير ثني وضينها % % 5(@)(@@) % وإذا العفاة تيممتنا عيسهم % لم يذكروا أوطانهم بحنينها % % 6(@)(@@) % تقرو مراتع وشحت بمناهل % تختال بين نميرها ومعينها % % 7(@)(@@) % ولنا ، إذا العرب اعتزت ، جرثومة % خلق النبي محمد من طينها % % PageV01P244 البحر : كامل تام 1(@)(@@) % وله تشف وراءه الأشجان % وهوى يضيق بسره الكتمان % 2(@)(@@) % ومتيم يدمي مقيل همومه % وجد يضرم ناره الهجران % 3(@)(@@) % فنضا الكرى عن مقلتيه شادن % عبث الفتور بلحظه وسنان % 4(@)(@@) % يرعى النجوم إذا استراب بطيفه % هلا استراب بطرفه اليقظان % 5(@)(@@) % ألف السهاد فلو أهاب خياله % بالعين ما شعرت به الأجفان % % 6(@)(@@) % لله وقفتنا التي ضمنت لنا % % شجنا غداة تفرق الجيران % 7(@)(@@) % نصف الهوى بمدامع مذعورة % تبكي الأسود بهن والغزلان % 8(@)(@@) % وإذا سمعنا نبأة من عاذل % جعلت مغيض دموعها الأردان % 9(@)(@@) % ولقد طرقت الحي يحمل شكتي % % ظامي الفصوص ، أديمه ريان % 10(@)(@@) % لبس الدجى وأضاء صبح جبينه % ينشق عنه سبيبه الفينان % PageV01P245 11(@)(@@) % وسما لدار العامرية بعدما % % خفت الهدير وروح الرعيان % 12(@)(@@) % ووقفته حيث اليمين جعلتها % % طوق الفتاة ، وفي الشمال عنان % 13(@)(@@) % ورجعت طلق البرد أسحب ذيله % ويعض جلدة كفه الغيران % 14(@)(@@) % يا صاحبي تقصيا نظريكما % % هل بعد ذلكما اللوى سفوان % 15(@)(@@) % فلقد ذكرت العامرية ذكرة % لا يستشف وراءها النسيان % 16(@)(@@) % وهفا بنا ولع النسيم على الحمى % % فثنى معاطفه إليه البان % 17(@)(@@) % ومشى بأجرعه فهب عراره % من نومه وتناجت الأغصان % 18(@)(@@) % وإذا الصبا سرقت إليها نظرة % مالت كما يترنح النشوان % 19(@)(@@) % عبقت حواشي الترب من أمواهه % راحا تصوغ حبابها الغدران % 20(@)(@@) % فكأن وفد الريح شافه أرضها % % بثرى تعفر عنده التيجان % PageV01P246 21(@)(@@) % من عرصة تسم الجباه بتربها % % صيد يطيف بعزهم إذعان % 22(@)(@@) % خضعوا لملثوم الخطا ، عرصاته % للمعتفين وللعلا ، أوطان % 23(@)(@@) % ذو محتد سنم رفيع سمكه % تعلي دعائم مجده عدنان % 24(@)(@@) % قوم إذا جهروا بدعوى عامر % قلق الظبا وتزعزع الخرصان % 25(@)(@@) % وأظل أطراف البسيطة جحفل % لجب يبشر نسره السرحان % 26(@)(@@) % تفرى ذيول النقع فيه صوارم % مذروبة 
ms77	 ، وذوابل مران % 27(@)(@@) % بأكف أبطال تكاد دروعهم % % عند اللقاء تذيبها الأضغان % 28(@)(@@) % من كل عراص ، إذا جد الردى % % في الروع لاعب متنه العسلان % 29(@)(@@) % ومهند تندى مضاربه دما % بيد ينم بجودها الإحسان % 30(@)(@@) % لو كان للأرواح منه ثائر % لتشبشت بغراره الأبدان % PageV01P247 31(@)(@@) % وبنو رؤاس ينهجون إلى الندى % % طرقا يضل أمامها الحرمان % 32(@)(@@) % كرماء والسحب الغزار لئيمة % حلماء حين تسفه الشجعان % 33(@)(@@) % إن جالدوا لفظ السيوف جفونها % % أو جاودوا غمر الضيوف جفان % 34(@)(@@) % وإذا العفاة تمرسوا بفنائهم % وتوشحت بظلاله الضيفان % 35(@)(@@) % طفح الدم المهراق في أرجائها % % دفعا تضرم حولها النيران % 36(@)(@@) % وإلى سناء الدولة اضطربت بنا % % شعب الرحال وغرد الركبان % 37(@)(@@) % ثمل الشمائل للمديح كأنما % % عاطاه نشوة كأسه الندمان % 38(@)(@@) % ونماه أروع ، عوده من نبعة % رفت على أعراقها الأفنان % 39(@)(@@) % يا من تضاءل دون غايته العدا % % وعنا لسورة بأسه الأقران % 40(@)(@@) % أيامنا الأعياد في أفيائكم % بيض كحاشية الرداء لدان % PageV01P248 41(@)(@@) % فاستقبل الأضحى بملك طارف % للعز في صفحاته عنوان % 42(@)(@@) % وتصفح الكلم التي وصلت بها % % مرر البلاغة شدة وليان % 43(@)(@@) % تلقي إلي عنانها عن طاعة % ولها على المتشاعرين حران % 44(@)(@@) % فالمجد يأنف أن يقرظ باقل % أربابه ، ولديهم سحبان % 45(@)(@@) % والشعر راض أبيه لي مقول % ذرب الشبا ، وفصاحة وبيان % 46(@)(@@) % ويدي مكرمة فلا أعطو بها % % منحا على أعطافهن هوان % 47(@)(@@) % والماء في الوجنات جم ، والغنى % % حيث القناعة ، والحشى طيان % 48(@)(@@) % تلد المنى همم وتعقم همتي % % فيمسهن الهون وهي حصان % PageV01P249 البحر : مجزوء الرمل 1(@)(@@) % ومفيقين من الله % % و نشاوى من مراح % 2(@)(@@) % ألفوا الجد ولم ين % % تهجوا طرق المزاح % 3(@)(@@) % فهم الأسد على جر % د عتاق كالسراح % 4(@)(@@) % يمتطي أبطالهم من % هن أثباج الرياح % 5(@)(@@) % سحبوا أذيال نقع % ليله وحف الجناح % 6(@)(@@) % بوجوه تجتلى من % ها تباشير الصباح % 7(@)(@@) % وردوا الموت ظماء % تحت أظلال الرماح % 8(@)(@@) % والضبيبيات خوض % وبها نجل الجراح % 9(@)(@@) % فشفت غلتهم بالد % م أطراف الصفاح % 10(@)(@@) % وأفاد البأس نعمى % % أتلفوها بالسماح % PageV01P250 البحر : طويل 1(@)(@@) % من الركب يابن العامري أمامي % % أهم سر 
ms78	 صبح في ضمير ظلام % 2(@)(@@) % يشيعهم قلب المشوق ، وربما % % يقاد إلى ما ساءه بزمام % 3(@)(@@) % وقد بخلت سعدى فلا الطيف طارق % وليس بمردود إلي سلامي % % 4(@)(@@) % من الهيف تستعدي على لحظها المها % % وتسلب خوط البان حسن قوام % 5(@)(@@) % وكم ظمأ تحت الضلوع أجنه % إلى رشفات من وراء لثام % 6(@)(@@) % وما ذقت فاها غير أني مكرر % أحاديث يرويها فروع بشام % 7(@)(@@) % هوى حال صرف الدهر بيني وبينه % أقد له الأنفاس وهي دوام % 8(@)(@@) % وغادرني نضو الهموم ، يثيرها % % غناء حمام أو بكاء غمام % 9(@)(@@) % وأشتاق أيام العقيق وأنثني % % بأربعة من ذكرهن سجام % 10(@)(@@) % وهل أتناسى العيش غضا كأنه % أعير اخضرارا في عذار غلام % PageV01P251 11(@)(@@) % بأرض كأن الروض في جنباتها % % يجر ذيول العصب فوق أكام % 12(@)(@@) % إذا صافحت غدرانه الريح خلتها % % تدرج أثرا في غرار حسام % 13(@)(@@) % ونام حواليها العرار كأنها % % تدير على النوار كأس مدام % 14(@)(@@) % سبقنا بها ريب الزمان إلى المنى % % وقد لقحت أسماعنا بملام % 15(@)(@@) % ومن أريحياتي إذا اقتادني الهوى % % أفض وإن ساء العذول لجامي % % 16(@)(@@) % ومازالت الأيام تغري بنا النوى % % وتسحب ذيلي شرة وعرام % 17(@)(@@) % أراها على سعدى غيارى كأنما % % بها ما بنا من صبوة وغرام % 18(@)(@@) % فيا ليتها إذ جاذبتني وصالها % % تركن هواها أو حملن سقامي % % 19(@)(@@) % لعمر المعالي حلفة أموية % لسد علي الدهر كل مرام % 20(@)(@@) % أما في لئام الناس مندوحة له % فحتام لا يحتاج غير كرام ؟ % PageV01P252 21(@)(@@) % لأدر عن الليل يلمع صبحه % تحدر راح من خلال فدام % 22(@)(@@) % على أرحبيات مرقن من الدجى % % وقد لغب الحادي ، مروق سهام % 23(@)(@@) % حوامل للحاجات تلقى رحالها % % إلى ماجد رحب رحب الفناء همام % 24(@)(@@) % أغر كلابي عليه مهابة % تغض له الأبصار وهي سوامي % % 25(@)(@@) % من القوم لم يستقدح المجد زنده % لدى الفخر إلا أوقدوا بضرام % 26(@)(@@) % وأعلاهم في قلة المجد مرقبا % أخو نعم في المعتفين جسام % 27(@)(@@) % محجب أطراف الرواقين بالقنا % % إذا ادرع الخيلان ظل قتام % 28(@)(@@) % ولم تعثرا إلا بأشلاء غلمة % تروي غليل المشرفي وهام % 29(@)(@@) % نطالع من أقلامه 
ms79	 وحسامه % مقر حياة في مدب حمام % 30(@)(@@) % ويخبر أهواء النفوس بنظرة % تفض لها الأسرار كل ختام % PageV01P253 31(@)(@@) % وتنضح كفاه نجيعا ونائلا % تدفق نائي الحجرتين ركام % 32(@)(@@) % بحلم إذا الخطب استطيرت له الحبا % % رماه بركني يذبل وشمام % 33(@)(@@) % وخلق كما هبت شمال مريضة % على زهرات الروض غب رهام % 34(@)(@@) % وعرض كمتن الهندواني ناصع % تذب المعالي دونه وتحامي % % 35(@)(@@) % صقيل الحواشي ، مسرح الحمد عنده % رحيب ، وما فيه معرس ذام % 36(@)(@@) % فلله مجد أعجز النجم شأوه % أحلك أعلى ذروة وسنام % 37(@)(@@) % وهبت بك الآمال بعد ضياعها % % لدى معشر عن رعيهن نيام % 38(@)(@@) % فدونك مما ينظم الفكر شردا % سلبن حصى المرجان كل نظام % 39(@)(@@) % تسير بشكر غائر الذكر منجد % يناجي لساني معرق وشآمي % % 40(@)(@@) % ويهوى ملوك الأرض أن يمدحوا بها % % وما كل سمع يرتضيه كلامي % % PageV01P254 41(@)(@@) % ألم يعلموا أني تبوأت منزلا % يطنب فوق النيرين خيامي % % 42(@)(@@) % وقد كنت لا أرضى وبي لا عج الصدى % % سوى منهل عذب الشريعة طام % 43(@)(@@) % ولما استقرت في ذراك بنا النوى % % وقد كرم المثوى ، نقعت أوامي % % PageV01P255 البحر : طويل 1(@)(@@) % رأت أم عمرو ما أعاني فعرضت % بشكوى وة في فيض الدموع بيانها % % 2(@)(@@) % وقد كنت أهوى مبسما وجمانه % فقدرشغفتني مقلة وجمانها % % 3(@)(@@) % ومن يبغ ما أبغي من المجد لم يبل % نوائب تتلو البكر منها عوانها % % 4(@)(@@) % رعى الله نفسا بين بردي مرة % على أي خطب ليس يلقى جرانها % % 5(@)(@@) % يفيء إليها الدهر كل عظيمة % ولا يزدهيها فهي ثبت جنانها % % 6(@)(@@) % ويعلم أني أستنيم إلى الردى % % بها حين يستشري عليها هوانها % % 7(@)(@@) % وأبرح ما ألقى رئاسة عصبة % أخس زمان نال مني زمانها % % 8(@)(@@) % يحوم عليها صارمي وغراره % وتصبو إليها صعدتي وسنانها % % 9(@)(@@) % وكل امرئ منها يمد إلى العلا % % يدا نشأت في الفقر ، شل بنانها % % 10(@)(@@) % ويأمل مني أن أسف بهمتي % % إليه وما شأن اللئام وشانها ؟ % PageV01P256 11(@)(@@) % ولو أمكنتني وثبة أموية % لألجمته سيفي ، فهاذا أوانها % % PageV01P257 البحر : كامل تام 1(@)(@@) % النائبات كثيرة الإنذار % واليوم طالب صرفها بالثار % 2(@)(@@) % سدت على عون الرزايا طرقها 
ms80	 % % فسمت لنا بخطوبها الأبكار % 3(@)(@@) % عجبا من القدر المتاح تولعت % أحداثه بمصرف الأقدار % 4(@)(@@) % ولنا بمعترك المنايا أنفس % وقفت بمدرجة القضاء الجاري % % 5(@)(@@) % في كل يوم تعترينا روعة % تذر العيون كواسف الأبصار % 6(@)(@@) % والموت شرب ليس يورده الردى % % أحدا فيطمع منه في الإصدار % 7(@)(@@) % شرب الأوائل عنفوان غديره % ولنشربن به من الأسآر % 8(@)(@@) % ملأت قبورهم الفضاء كأنها % % بزل الجمال أنخن بالأكوار % 9(@)(@@) % ألقوا عصيهم بدار إقامة % أنضاء أيام مضين قصار % 10(@)(@@) % وكأنهم بلغوا المدى فتواقفوا % % يتذاكرون عواقب الأسفار % PageV01P258 11(@)(@@) % لم يذهبوا سلفا لنغرر بعدهم % أين البقاء ونحن في الآثار ؟ % 12(@)(@@) % حارت وراءهم العقول كأننا % % شرب تطوحهم كؤوس عقار % 13(@)(@@) % يا من تخادعه المنى ، ولربما % % قطعت مخائلها قوى الأعمار % 14(@)(@@) % والناس يستبقون في مضمارها % % والموت آخر ذلك المضمار % 15(@)(@@) % والعمر يذهب كالحياة فما الذي % % يجدي عليك من الخيال الساري % % 16(@)(@@) % بينا الفتى يسم الثرى بردائه % إذ حل فيه رهينة الأحجار % 17(@)(@@) % لو فات عادية المنون مشيع % لنجا بمهجته الهزبر الضاري % % 18(@)(@@) % أقعى دوين الغاب يمنع شبله % ويجيل نظرة باسل كرار % 19(@)(@@) % وحمى الأمير ابن الخلائف جعفرا % إقدام كل مغرر مغوار % 20(@)(@@) % يمشي كما مشت الأسود إلى الوغى % % والخيل تعثر بالقنا الخطار % PageV01P259 21(@)(@@) % ويخوض مشتجر الرماح بغلمة % عربية نخواتها أغمار % 22(@)(@@) % ويجوب أردية العجاج بجحفل % لجب ، تئن له الربا ، جرار % 23(@)(@@) % والمشرفيات الرقاق كأنها % % ماء أصاب قرارة في نار % 24(@)(@@) % ينعون فرعا من ذوائب دوحة % خضلت حواشيها عليه نضار % 25(@)(@@) % نبوية الأعراق مقتدرية % تفتر عن كرم وطيب نجار % 26(@)(@@) % ذرفت عيون المكرمات وأعصمت % أسفا بأكباد عليه حرار % 27(@)(@@) % صبرا أمير المؤمنين فأنتم % أسكنتم الأحلام ظل وقار % 28(@)(@@) % هذا الهلال وقد رجوت نموه % للمجد ، عاجله الردى بسرار % 29(@)(@@) % إن غاض من أنواره فوراءه % أفق توشح منك بالأقمار % 30(@)(@@) % كادت تزول الراسيات لفقده % حتى أذنت لهن في استقرار % PageV01P260 31(@)(@@) % ومتى أصاب - ولا أصابك حادث % مما يطامن نخوة الجبار - % 32(@)(@@) % فاذكر مصابك بابن عمك أحمد % والغر من آبائك الأخيار % 33(@)(@@) % كانوا بدور أسرة ومنابر % يتهللون 