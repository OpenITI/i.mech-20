ms801	 السماوات وأبواب الجنة تفتح في تلك الساعة ، يعني : إذازالت الشمس فما ترتج حتى تصلى هاذه الصلاة ، فأحب أن يرفع عملي في أول عمل العابدين ) )(@)(@@) ابن عساكر عن أبي أمامة عن أبي أيوب رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7280 ) قال النبي :(@)(@@) | 30 ( إن أثقل الصلاة على المنافقين صلاة العشاء وصلاة الفجر ، ولو يعلمون ما فيهما لأتوهما ولو حبوا ، واعلموا أن الصف المقدم على مثل صف الملائكة ، ولو علمتم فضيلته لابتدرتموه ، واعلموا أن صلاة الرجل مع الرجل أزكى من صلاة الرجل وحده ، وأن صلاته مع الرجلين أزكى من صلاته مع الرجل ، وما كثر فهو أحب إلى الله تعالى ) )(@)(@@) عبد الرزاق ( هب ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7281 ) قال النبي :(@)(@@) | 30 ( إن أثقل الصلاة على المنافقين صلاة العشاء والفجر ، ولو علموا ما فيهما من الفضل لأتوهما ولو حبوا ) )(@)(@@) الخطيب وابن عساكر عن معاوية بن أسحاق بن طلحة بن عبد الله عن أبيه عن جده ( طب ) عن ابن مسعود PageV03P061 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7282 ) قال النبي :(@)(@@) | 30 ( إن أحاديثي ينسخ بعضها بعضا كنسخ القرآن ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7283 ) قال النبي :(@)(@@) | 30 ( إن أحب الخلائق إلى الله عز وجل شاب حدث السن في صورة حسنة جعل شبابه وجماله لله وفي طاعة الله ، ذالك الذي يباهي به الرحمان ملائكته ، يقول : هاذا عبدي حقا ) )(@)(@@) ابن عساكر عن ابن مسعود رضي الله عنه ، وفيه إبراهيم الهجري ضعيفا .(@)(@@)(@@)(@@) $ ( 7284 ) قال النبي :(@)(@@) | 30 ( إن أحب الدين إلى الله الحنيفية السمحة ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7285 ) قال النبي :(@)(@@) | 30 ( إن أحب الأعمال إلى الله عز وجل ثلاث : مؤاساة الأخ في المال ، وإنصاف الناس من نفسك وذكر الله على كل حال ) )(@)(@@) ابن النجار عن أبي جعفر محمد بن علي بن الحسن رضي الله عنه معضلا .(@)(@@)(@@)(@@) $ ( 7286 ) قال النبي :(@)(@@) | 30 ( إن أحب البيوت إلى الله بيت فيه يتيم مكرم ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7287 ) قال النبي :(@)(@@) | 30 ( إن أحب الأعمال إلى الله تعجيل الصلاة 
ms802	 لأول وقتها ) )(@)(@@) ( حم ) عن أم فروة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7288 ) قال النبي :(@)(@@) | 30 ( إن أحب الكلام إلى الله : سبحانك اللهم ، وبحمدك ، وتبارك اسمك ، وتعالى جدك ، ولا إلاه غيرك ، وإن أبغض الكلام إلى الله عز وجل أن يقول الرجل للرجل : اتق الله ، فيقول : عليك بنفسك ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7289 ) قال النبي :(@)(@@) | 30 ( إن أحب ما زرتم الله في مساجدكم وقبوركم البياض ) )(@)(@@) ( كر ) عن عمران بن حصين وسمرة بن جندب رضي الله عنهما .(@)(@@) PageV03P062(@)(@@)(@@)(@@) $ ( 7290 ) قال النبي :(@)(@@) | 30 ( إن أحبكم إلي وأقربكم مني مجلسا يوم القيامة أحاسنكم أخلاقا ، وإن أبغضكم إلي وأبعدكم مني مجلسا يوم القيامة مساوئكم أخلاقا ، الثرثارون المتعشدقون المتفيهقون ) )(@)(@@) الخرائطي في مكارم الأخلاق والخطيب وابن عساكر ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7291 ) قال النبي :(@)(@@) | 30 ( إن أحبكم إلى الله يوم القيامة أحاسنكم أخلاقا ، وإن من أبغضكم إلي يوم القيامة المتعشدقون المتفيهقون ) )(@)(@@) ( طب ) عن أبي مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7292 ) قال النبي :(@)(@@) | 30 ( إن أحبكم إلى الله أحسنكم أخعلاقا ، الموطؤون أكنافا ، الذين يألفون ويؤلفون ، وإن أبغضكم إلى الله المشاؤون بالنميمة ، المفرقون بين الإخوان ، الملتمسون للبرآء العثرات ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7293 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا صلى فإنه يناجي ربه ، وإن الله يستقبله بوجهه ، فلا يتنخمن أحدكم في القبلة ولا عن يمينه ) )(@)(@@) عبد الرزاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7294 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا مات عرض عليه مقعده بالغداة والعشي ، إن كان من أهل الجنة فمن أهل الجنة ، وإن كان من أهل النار فهو من أهل النار ، يقال : هاذا مقعدك حيث يبعثك الله إليه يوم القيامة ) )(@)(@@) مالك ( ط حم خ م ت ن ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7295 ) قال النبي :(@)(@@) | 30 ( إن أحدكم ليسأل يوم القيامة حتى يكون فيما يسأل عنه أن يقال : ما منعك أن تنكر المنكر إذا رأيته ؟ فمن لقاه الله حجته قال : رب PageV03P063 رجوتك وخفت الناس ) )(@)(@@) ( حم ) عن أبي 
ms803	 سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7296 ) قال النبي :(@)(@@) | 30 ( إن أحدكم مرآة أخيه ، فإذا رأى به شيئا فليمطه عنه ) )(@)(@@) ( هنا ) وضعفه العسكري في الأمثال وابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7297 ) قال النبي :(@)(@@) | 30 ( إن أحدكم لو كان له واد ملآن ما بين أعلاه إلى أسفله أحب أن يملأ له واد آخر فإن ملىء له الوادي الآخر فانطلق يمشي فوجد واديا آخر قال : أما والله لئن استطعت لأملأنك ، وإن الرجل لا تمتلىء نفسه من المال حتى تمتلىء من التراب ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7298 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا قام في الصلاة فإنه يناجي ربه ، ولا يجهر بعضكم على بعض بالقراءة في الصلاة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7299 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا كان في المسجد جاء الشيطان فأبس به كما يبس الرجل بدابته ، فإذا سكن له زنقه أو ألجمه ) )(@)(@@) ( حم ) و أبو الشيخ في الثواب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7300 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا كان في الصلاة جاء الشيطان فأبس به كما يبس الرجل بدابته ، فإذا سكن له أضرط ما بين إلييه ليفتنه عن الصلاة ، فإذا وجد أحدكم شيئا من ذالك فاشكل عليه ، أخرج منه شيء أم لا ؟ فلا يخرجن من المسجد حتى يسمع صوتا أو يجد ريحا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7301 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا انقطع شسع نعليه فقال : إنا لله وإنا إليه راجعون ، كان عليه من الله الصلاة والهدى والرحمة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@) PageV03P064(@)(@@)(@@)(@@) $ ( 7302 ) قال النبي :(@)(@@) | 30 ( إن أحدكم يقول : قد نكحت قد طلقت ، وليس هاذا بطلاق المسلمين طلقوا المرأة في قبل عدتها ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7303 ) قال النبي :(@)(@@) | 30 ( إن أحدكم يسألني فينطلق بمسألته متأبطها ، وما هي إلا نار ، قيل : لم تعطيهم ؟ قال : يأبون إلا أن يسألوني ، ويأبى الله لي البخل ) )(@)(@@) ( ع ك ض ) عن أبي سعيد ( ك ) عن جابر 
ms804	 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7304 ) قال النبي :(@)(@@) | 30 ( إن أحرم الأيام يومكم هاذا في شهركم هاذا ، في بلدكم هاذا ، ألا إن دماءكم عليكم حرام كحرمة يومكم هاذا ، في شهركم هاذا ، في بلدكم هاذا ، ألا هل بلغت ؟ قالوا : نعم ، قال : اللهم اشهد ) )(@)(@@) ابن النجار عن أبي أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7305 ) قال النبي :(@)(@@) | 30 ( إن أحصاهم لهاذا القرآن من أمتي منافقوهم ) )(@)(@@) محمد بن الربيع الجيزي في تاريخ الصحابة الذين نزلوا مصر وابن منده وأبو نعيم عن محمد بن مسلم بن جاحل الصوفي عن أبيه عن جده ، قال ابن منده وأبو نعيم غريب .(@)(@@)(@@)(@@) $ ( 7306 ) قال النبي :(@)(@@) | 30 ( إن أحق أسمائك أبو تراب ) )(@)(@@) ( طب ) عن أبي الطفيلي قال : جاء النبي وعلي نائم في التراب قال فذكره .(@)(@@)(@@)(@@) $ ( 7307 ) قال النبي :(@)(@@) | 30 ( إن أحمق الحمق وأضل الضلال قوم رغبوا عما جاء به نبيهم إلى نبي غير نبيهم ، أو إلى أمة غير أمتهم ) )(@)(@@) الديلمي عن يحيى بن جعدة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7308 ) قال النبي :(@)(@@) | 30 ( إن أخاكم النجاشي قد مات فاستغفروا له ) )(@)(@@) ( حم ش طب ) و ابن قانع ( ض ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7309 ) قال النبي :(@)(@@) | 30 ( إن أخاكم مات بغير أرضكم فقوموا فصلوا عليه ، PageV03P065 قالوا : من هو ؟ قال : النجاشي ) )(@)(@@) ( ط حم ه ) و ابن قانع ( طب ض ) عن أبي الطفيل عن حذيفة بن أسيد الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7310 ) قال النبي :(@)(@@) | 30 ( إن أخاكم النجاشي قد مات ، فمن أراد أن يصلي عليه فليصل عليه ) )(@)(@@) ( طب ) عن حذيفة بن أسيد الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7311 ) قال النبي :(@)(@@) | 30 ( إن أخاك استسقى قبلك ما هو بآثر عندي منك ، وإنهما عندي بمنزل واحد ، وإني وإياك وهو وهاذا النائم لفي مقام واحد يوم القيامة ) )(@)(@@) ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7312 ) قال النبي :(@)(@@) | 30 ( إن أخي عيسى بن مريم قال للحواريين يوما : يا معشر الحواريين كونوا من الشر بلهاء كالحمام ، وكونوا في الاجتهاد والحذر كالوحش إذا طلبها القناص ) )(@)(@@) ( عد ) عن أبي أمامة رضي الله 
ms805	 عنه .(@)(@@)(@@)(@@) $ ( 7313 ) قال النبي :(@)(@@) | 30 ( إن إخوانكم لقوا العدو ، وإن زيدا أخذ الراية فقاتل حتى قتل ، ثم أخذ الراية بعده جعفر فقاتل حتى قتل ، ثم أخذ الراية بعده جعفر فقاتل حتى قتل ، ثم أخذ الراية عبد الله بن رواحة فقاتل حتى قتل ، ثم أخذ الراية سيف من سيوف الله خالد بن الوليد ففتح الله عز وجل عليه ) )(@)(@@) ( حم طب ك ض ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7314 ) قال النبي :(@)(@@) | 30 ( إن إخوانكم قد لقوا المشركين فاقتطعوهم فلم يبق منهم أحد ، وإنهم قالوا : ربنا بلغ قومنا أنا قد رضينا ورضي عنا ربنا ، فأنا رسولهم إليكم إنهم قد رضوا ورضي عنهم ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7315 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي ثلاث : زلة عالم ، وجدال منافق بالقرآن ، ودنيا تقطع أعناقكم فاتهموها على أنفسكم ) )(@)(@@) أبو نصر السجزي في الإبانة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7316 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي الكتاب واللبن ، فأما PageV03P066 اللبن فينتجع أقوام بحبه ويتركون الجماعة والجمعات ، وأما الكتاب فيفتح لأقوام فيه فيجادلون به الذين آمنوا ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7317 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي ثلاث : زلة عالم ، وجدال منافق بالقرآن ، ودنيا تفتح عليهم ) )(@)(@@) ( طب قط ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7318 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي : تأخيرهم الصلاة عن وقتها ، وتعجيلهم الصلاة عن وقتها ) )(@)(@@) ( خ ) في تاريخه ( هق ) عن ابن عباس رضي الله عنهعما .(@)(@@)(@@)(@@) $ ( 7319 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف عليكم : الشرك الأصغر : الرياء ، يقال لمن فعل ذالك إذا جاء الناس بأعمالهم : اذهبوا إلى الذين كنتم تراؤون في الدنيا فاطلبوا ذالك عندهم ) )(@)(@@) ( طب ) عن محمود بن لبيد عن رافع بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7320 ) قال النبي :(@)(@@) | 30 ( أن أخوف ما أخاف على أمتي تصديق بالنجوم ، وتكذيب بالقدر ، ولا يجد العبد حلاوة الايمان حتى يؤمن بالقدر خيره وشره ، وحلوه 
ms806	 ومره ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7321 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي : الهوى وطول الأمل ، فأما الهوى فيصد عن الحق ، وأما طول الأمل فينسي الآخرة ، وهاذه الدنيا مرتحلة ذاهبة ، وهاذه الآخرة مقبلة صادقة ، ولكل واحدة منهما بنون ، فإن استطعتم أن تكونوا من بني الآخرة ولا تكونوا من بني الدنيا فافعلوا ، فإنكم اليوم في دار عمل ولا حساب ، وأنتم غدا في دار ولا عمل ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7322 ) قال النبي :(@)(@@) | 30 ( إن أخونكم عندنا من طلبه يعني العمل ) )(@)(@@) ( حم د ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV03P067(@)(@@)(@@)(@@) $ ( 7323 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلة ، وليس فيها أدنى ، الذي يتمنى فيقول بلسان طلق ذلق وعقل مجتمع : أعطني كذا ، أعطني كذا ، حتى إذا لم يجد شيئا لقن فقيل له : قل كذا وقل كذا ، فيقال هو لك ومثله معه ) )(@)(@@) ( طب ص ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7324 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل النار عذابا لرجل عليه نعلان من نار تغلي منهما دماغه كأنه مرجل ، مسامعه جمر ، وأضراسه جمر ، وأشفاره لهب النار ، تخرج أحشاء جنبيه من قدميه ، وسائرهم كالحب القليل في الماء الكثير فهو يفور ) )(@)(@@) ( هناد ) عن عبيد بن عمير مرسلا .(@)(@@)(@@)(@@) $ ( 7325 ) قال النبي :(@)(@@) | 30 ( إن أدنى زرعات المجاهدين في سبيل الله عدل صيام سنة وقيامها ، قيل : وما أدنى زرعات المجاهدين ؟ قال : سقط سوطه وهو ناعس فينزل فيأخذه ) )(@)(@@) ابن أبي عاصم وأبو نعيم عن ثابت بن أبي عاصم .(@)(@@)(@@)(@@) $ ( 7326 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلا لرجل له دار من لؤلؤة واحدة ، منها غرفها وأبوابها ) )(@)(@@) ( هناد ) عن عبيد بن عمير مرسلا .(@)(@@)(@@)(@@) $ ( 7327 ) قال النبي :(@)(@@) | 30 ( إن أربى الربا شتم الأعراض وأشد الشتم الهجاء ، والمراد به أحد الشاتمين ) )(@)(@@) ( عب هق ) عن محمد بن عبيد الله بن عمير بن عثمان مرسلا .(@)(@@)(@@)(@@) $ ( 7328 ) قال النبي :(@)(@@) | 30 ( إن أربى الربا أن يستطيل الرجل في شتم أخيه ، وإن أكبر الكبائر أن 
ms807	 يشتم الرجل والديه قالوا : وكيف يشتمهما ؟ قال : يشتم أبا الرجل فيشتمهما ) )(@)(@@) ( طب ) عن قيس بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7329 ) قال النبي :(@)(@@) | 30 ( إن أربى الربا تفضيل المرء على أخيه بالشتم ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن ابن أبي نجيح مرسلا .(@)(@@)(@@)(@@) $ ( 7330 ) قال النبي :(@)(@@) | 30 ( إن أرأف الناس بهاذه الأمة أبو بكر ، وإن أقواها في PageV03P068 أمر الله عمر ، وإن أصدقها حبا عثمان ، وإن أعلمها بفصل القضاء علي ، وإن أقرأها أبي ، وإن أفرضها زيد ، وإن أعلمها بالناسخ والمنسوخ معاذ ، وإن لكل أمة أمينا ، وأمين هاذه الأمة أبو عبيدة بن الجراح ) )(@)(@@) ابن عساكر عن أبي محجن وفيه أبو سعد الأعور البقال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7331 ) قال النبي :(@)(@@) | 30 ( إن أرفع الناس درجة يوم القيامة الامام العادل ، وإن أوضع الناس درجة يوم القيامة الإمام الذي ليس بعادل ) )(@)(@@) ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7332 ) قال النبي :(@)(@@) | 30 ( إن أرضكم رفعت لي منذ قعدتم إلي فنظرت من أدناها إلى أقصاها فخير ثمراتكم البرني يذهب الداء ولا داء فيه ) )(@)(@@) ( ك ) وتعقب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7333 ) قال النبي :(@)(@@) | 30 ( إن أرواح الشهداء في طير خضر ترعى من رياض الجنة ، ثم يكون مأواها إلى قناديل معلقة بالعرش فيقول الرب عز وجل : تعلمون كرامة أكرم من كرامة أكرمتكم بها ؟ فيقولون : لا ، إلا أنا وددنا أنك رددت أرواحنا إلى أجسادنا حتى نقاتل مرة أخرى فنقتل في سبيلك ) )(@)(@@) ( هناد ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7334 ) قال النبي :(@)(@@) | 30 ( إن أرواح المؤمنين تلتقي على مسيرة يوم ما رأى أحدهم صاحبه ) )(@)(@@) ( قط حم ) عن ابن عمرو رضي الله عنهما . ،(@)(@@)(@@)(@@) $ ( 7335 ) قال النبي :(@)(@@) | 30 ( إن أسرق الناس من سرق صلاته لا يتم ركوعها ولا سجودها ، وأبخل الناس من بخل بالسلام ) )(@)(@@) ( طب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@) PageV03P069(@)(@@)(@@)(@@) $ ( 7336 ) قال النبي :(@)(@@) | 30 ( إن اسم الرجل المؤمن في الكتب الكرم من أجل ما كرمه الله على الخليقة ، إنكم تدعون الحائط من العنب الكرم ، ألا واسمه الحفر ، والرجل هو 
ms808	 الكرم ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7337 ) قال النبي :(@)(@@) | 30 ( إن أسوأ الناس سرقة الذي يسرق من صلاته لا يتم ركوعها ولا سجودها ) )(@)(@@) ( ش ) عن أبي سعيد ( طس ) عن أبي هريرة ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7338 ) قال النبي :(@)(@@) | 30 ( إن أشد أمتي حبا لي قوم يأتون من بعدي يؤمنون لي ولم يروني ، يعملون بما في الورق المعلق ) )(@)(@@) الخطيب وابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7339 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس عذابا يوم القيامة أشدهم عذابا للناس في الدنيا ) )(@)(@@) ( ط طب هب حم ض ) عن خالد بن حكيم بن حزام عن خالد بن الوليد ( طب ك هق ) وابن عساكر عن هشام بن حكيم بن حزام وعياض بن غنم رضي الله عنهما ابن عساكر عن هشام بن حكيم بن حزام عن خالد بن الوليد بن سعد والباوردي والبغوي عن خالد بن حكيم بن حزام ( طب ) وابن نعيم عن خالد بن حكيم بن حزام وأبي عبيدة بن الجراح رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 7340 ) قال النبي :(@)(@@) | 30 ( إن أشد ما أتخوف عليكم خصلتان : اتباع الهوى وطول الأمل ، فأما اتباع الهوى فإنه يعدل عن الحق ، وأما طول الأمل فالحب للدنيا ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7341 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس عذابا يوم القيامة من شتم الأنبياء ثم أصحابي ثم المسلمين ) )(@)(@@) ( حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7342 ) قال النبي :(@)(@@) | 30 ( إن أشد أهل النار عذابا يوم القيامة من قتل نبيا أو PageV03P070 قتله نبي ، أو إمام جائر ، وهاؤلاء المصورون ) )(@)(@@) ( طب حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7343 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس عذابا يوم القيامة عالم لم ينفعه الله بعلمه ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7344 ) قال النبي :(@)(@@) | 30 ( إن أشدكم أملككم لنفسه عند الغضب ، وأحلمكم من عفا بعد القدرة ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7345 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس عتوا رجل ضرب غير ضاربه ، ورجل قتل غير قاتله ، ورجل تولى 
ms809	 غير أهل نعمته فمن فعل ذالك فقد كفر بالله ورسوله ، لا يقبل منه صرف ولا عدل ) )(@)(@@) ( ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7346 ) قال النبي :(@)(@@) | 30 ( إن أصحابك يظنون أنك من أهل النار ، وأنا أشهد أنك من أهل الجنة ) )(@)(@@) ( طب ) عن أبي عطية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7347 ) قال النبي :(@)(@@) | 30 ( إن أصحاب هاذه الصور يعذبون بها ، يقال لهم : أحبوا ما خلقتم ، وإن البيت الذي فيه الصور لا تدخله الملائكة ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7348 قال النبي :(@)(@@) | 30 ( إن أصغر البيوت بيت ليس فيه من كتاب الله شيء ، فاقرؤوا القرآن فإنكم تؤجرون عليه بكل حرف منه عشر حسنات ، أما إني لا أقول الم حرف ولاكن أقول ألف حرف ولام حرف وميم حرف ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7349 ) قال النبي :(@)(@@) | 30 ( إن أطول الناس جوعا يوم القيامة أكثرهم شبعا في الدنيا ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@) PageV03P071(@)(@@)(@@)(@@) $ ( 7350 ) قال النبي :(@)(@@) | 30 ( إن أطيب الكسب كسب التجار الذين إذا حدثوا لم يكذبوا ، وإذا ائتمنوا لم يخونوا ، وإذا وعدوا لم يخلفوا ، وإن كان عليهم لم يمطلوا ، وإن كان لهم لم يعسروا ، وإذا باعوا لم يطروا ، وإذا اشتروا لم يذموا ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7351 ) قال النبي :(@)(@@) | 30 ( إن أطيب ما أكلتم من كسبكم ) )(@)(@@) ( ش خ ) في تاريخه ( ت حسن ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7352 ) قال النبي :(@)(@@) | 30 ( إن أعدى الناس على الله من قتل في الحرم ، أو قتل غير قاتله ، أو قتل بدخول الجاهلية ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7353 ) قال النبي :(@)(@@) | 30 ( إن أعز أهلي أن يتخلف عني المهاجرون من قريش والأنصار وأسلم وغفار ) )(@)(@@) ( ك هب طب ) عن أبي رهم الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7354 ) قال النبي :(@)(@@) | 30 ( إن أطيب ما أكل الرجل من كسبه ، وإن ولده من كسب ( فكلوا من أموالهم ) ) )(@)(@@) ( حم عب د ت ) حسن ( ن ه حب ق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7355 ) قال النبي 
ms810	 :(@)(@@) | 30 ( إن أعتى الناس على الله رجل قتل غير قاتله ، أو طلب بدم الجاهلية من أهل الاسلام ، ومن بصر عينيه في المنام ما لم يبصر ) )(@)(@@) ابن جرير ( طب هق ك ) عن أبي شريح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7356 ) قال النبي :(@)(@@) | 30 ( إن أعجل الخير ثوابا صلة الرحم ، حتى إن أهل البيت ليكونون فجارا فتنمو أموالهم ويكثر عددهم إذا وصلوا أرحامهم ) )(@)(@@) ابن جرير والخرائطي في مكارم الأخلاق عن أبي سلمة عن أبيه ( طس ) عن أبي سلمة عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P072(@)(@@)(@@)(@@) $ ( 7357 ) قال النبي :(@)(@@) | 30 ( إن أعجل الطاعة ثوابا صلة الرحم ، حتى إن أهل البيت ليكونون فجرة فتنمو أموالهم ويكثر عددهم إذا تواصلوا ، وما من أهل بيت يتواصلون فيحتاجون ) )(@)(@@) ( حب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7358 ) قال النبي :(@)(@@) | 30 ( إن أعدى الناس على الله القاتل غير قاتله ، والضارب غير ضاربه ، ومن تولى غير مواليه فقد كفر بما أنزل الله على محمد ) )(@)(@@) ( هق ) عن علي بن الحسين مرسلا .(@)(@@)(@@)(@@) $ ( 7359 ) قال النبي :(@)(@@) | 30 ( إن أعظم الناس عند الله فرية لرجل هاجى رجلا فهجى القبيلة بأسرها ، ورجل انتفى من أبيه وزنى أمه ) )(@)(@@) ( ه هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7360 ) قال النبي :(@)(@@) | 30 ( إن أعظم الفرية أن يفتري الرجل على عينيه يقول : رأيت ولم ير ، ويفتري على والديه ، أو يقول سمعني ولم يسمعني ) )(@)(@@) ( حم ك ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7361 ) قال النبي :(@)(@@) | 30 ( إن أعمال العباد ترفع يوم الاثنين ويوم الخميس ، فاحب أن لا يرفع عملي إلا وأنا صائم ) )(@)(@@) ( هب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7362 ) قال النبي :(@)(@@) | 30 ( إن أعمالكم تعرض على عشائركم وأقربائكم في قبورهم ، فإن كان خيرا استبشروا به ، وإن كان غير ذالك قالوا : اللهم ألهمهم أن يعملوا بطاعتك ) )(@)(@@) ( ط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7363 ) قال النبي :(@)(@@) | 30 ( إن أعمال العباد لتعرض على الله في كل اثنين وحميس ، فيغفر الله لكل عبد لا يشرك بالله شيئا ، إلا عبدا بينه وبيين أخيه شحناء ) )(@)(@@) الخطيب وابن عساكر عن معاوية بن 
ms811	 إسحاق بن طلحة بن عبيد الله عن أبيه عن جده .(@)(@@) PageV03P073(@)(@@)(@@)(@@) $ ( 7364 ) قال النبي :(@)(@@) | 30 ( إن أعمال أمتي تعرض في كل يوم جمعة ، واشتد غضب الله على الزناة ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7365 ) قال النبي :(@)(@@) | 30 ( إن أفرى الفرى من قولني ما لم أقل ، ومن أرى عينيه في المنام ما لم تريا ، ومن ادعى إلى غير أبيه ) )(@)(@@) الشافعي ( هق ) في المعرفة عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7366 ) قال النبي :(@)(@@) | 30 ( إن أفضل إيمان العبد أن يعلم العبد أن الله معه حيثما كان ) )(@)(@@) الحكيم عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7367 ) قال النبي :(@)(@@) | 30 ( إن أفضل عباد الله عند الله يوم القيامة إمام عادل رفيق ، وإن أشر عباد الله عند الله يوم القيامة إمام جائر خرق ) )(@)(@@) ( بز هق ) ابن زنجويه والشيرازي في الألقاب وابن النجار ( هب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7368 ) قال النبي :(@)(@@) | 30 ( إن أفضل ما يوضع في الميزان يوم القيامة : الخلق الحسن ) )(@)(@@) ( طب ) عن أم الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7369 ) قال النبي :(@)(@@) | 30 ( إن أفضل الحديث كتاب الله وأحسن الهدي هدي محمد ، وشر الأمور محدثاتها ، وكل بدعة ضلالة ، ومن ترك مالا فلأهله ، ومن ترك دينا أو ضياعا فعلي ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7370 ) قال النبي :(@)(@@) | 30 ( إن أفضل الصلوات عند الله صلاة الصبح يوم الجمعة في جماعة ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7371 ) قال النبي :(@)(@@) | 30 ( إن أفضل العبادة حسن الظن بالله ، يقول الله عز وجل لعبده : أنا عند ظن عبدي بي ) )(@)(@@) البغوي عن ابن الديلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7372 ) قال النبي :(@)(@@) | 30 ( إن أفضل الصلاة بعد الفريضة الصلاة في جوف الليل ، وإن أفضل الصيام بعد شهر رمضان لشهر الله الذي تدعونه المحرم ) )(@)(@@) ابن زنجويه ( ض ) عن جندب البجلي رضي الله عنه .(@)(@@) PageV03P074(@)(@@)(@@)(@@) $ ( 7373 ) قال النبي :(@)(@@) | 30 ( إن أفضل المسلمين إسلاما من سلم المسلمون من لسانه ويده ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7374 ) قال النبي :(@)(@@) | 30 ( إن أقبح السرقة 
ms812	 الذي يسرق صلاته لا يتم ركوعها ولا سجودها ولا خشوعها ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7375 ) قال النبي :(@)(@@) | 30 ( إن أقرب الخلائق من عرش الرحمان يوم القيامة المؤمن الذي قتل مظلوما ، رأسه عن يمينه وقاتله عن شماله وأوداجه تشخب يقول : رب سل هاذا فيم قتلني ؟ فيم حال بيني وبين الصلاة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7376 ) قال النبي :(@)(@@) | 30 ( إن أقرب الخلق إلى الله عز وجل جبريل وميكائيل وإسرافيل وهم عند ذي العرش مكينون وإنهم من الله مسيرة خمسين ألف سنة ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7377 ) قال النبي :(@)(@@) | 30 ( إن أقربكم مني يوم القيامة في كل موطن أكثركم علي صلاة في الدنيا ، من صلى علي في يوم الجمعة وليلة الجمعة قضى الله له مائة حاجة : سبعين من حوائج الآخرة ، وثلاثين من حوائج الدنيا ، ثم يوكل الله بذالك ملكا يدخله في قبري كما تدخل عليكم الهدايا يخبرني من صلى علي باسمه ونسبه إلى عشيرته فاثبته عندي في صحيفة بيضاء ) )(@)(@@) ( هب ) و ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7378 ) قال النبي :(@)(@@) | 30 ( إن أقربكم مني مجلسا يوم القيامة ، من خرج من الدنيا كهيئته يوم تركته عليه ) )(@)(@@) ( حم ) و ابن سعد وهناد حل طب هق ) عن أبي ذر رضي الله عنه .(@)(@@) PageV03P075(@)(@@)(@@)(@@) $ ( 7379 ) قال النبي :(@)(@@) | 30 ( إن أقواما يتعمقون في الدين يمرقون من الدين كما يمرق السهم من الرمية ) )(@)(@@) ( حم خ ) في التاريخ والسراج ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7380 ) قال النبي :(@)(@@) | 30 ( إن أقواما من أمتي أشدة ، زلقة ألسنتهم بالقرآن لا يجاوز تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية ، فإذا لقيتموهم فاقتلوهم ، فإن المأجور من قتلهم ) )(@)(@@) ابن جرير ( ك ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7381 ) قال النبي :(@)(@@) | 30 ( إن أكثر الناس ذنوبا يوم القيامة أكثرهم كلاما فيما لا يعنيه ) )(@)(@@) أبو نصر في الإبانة عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7382 ) قال النبي :(@)(@@) | 30 ( إن أمام الدجال سنين خداعة 
ms813	 يكذب فيها الصادق ، ويصدق فيها الكاذب ، ويخون فيها الأمين ، ويؤتمن فيها الخائن ، ويتكلم فيها الرويبضة ، قيل : وما الرويبضة ؟ قال : الفاسق يتكلم في أمر العامة ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7383 ) قال النبي :(@)(@@) | 30 ( إن أمي رأت في المنام أن الذي في بطنها نور ، قالت : فجعلت أتبع بصري النور فسبق بصري حتى أضاءت لي مشارق الأرض ومغاربها ) )(@)(@@) الديلمي عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7384 ) قال النبي :(@)(@@) | 30 ( إن أمتي لن تخزى ما أقاموا صيام شهر رمضان ، قيل : يا رسول الله وما خزيهم في إضاعة شهر رمضان ؟ قال : انتهاك المحارم فيه ، من زنا فيه أو شرب فيه خمرا لعنه الله ومن في السماوات إلى مثله من الحول ، فإن مات قبل أن يدرك رمضان فليست له عند الله حسنة يتقي بها النار ، فاتقوا الله في شهر رمضان ، فإن الحسنات تضاعف فيه ما لا تضاعف فيما سواه ، وكذالك PageV03P076 السيئات ) )(@)(@@) ( طب عد ) عن أم هانىء ( عد ) وابن صصرى في أماليه عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7385 ) قال النبي :(@)(@@) | 30 ( إن أمتي يشربون الخمر في آخر الزمان يسمونها بغير اسمها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7386 ) قال النبي :(@)(@@) | 30 ( إن أمتي أمة مرحومة مغفور لها جعل الله عذابها بينها في الدنيا ، فإذا كان يوم القيامة أعطي كل رجل من المسلمين يهوديا أو نصرانيا فيقال : هاذا فداؤك من النار ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7387 ) قال النبي :(@)(@@) | 30 ( إن أمتي لا تزال متمسكة بدينها ما لم يكذبوا بالقدر ، فإذا كذبوا بالقدر فعند ذالك هلاكهم ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7388 ) قال النبي :(@)(@@) | 30 ( إن أمتي أمة مرحومة ليس عليها في الآخرة حساب ولا عذاب إنما عذابها في الدنيا القتل والبلابل والزلازل والفتن ) )(@)(@@) ( حم ك هب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7389 ) قال النبي :(@)(@@) | 30 ( إن أمتي يسوقها قوم عراض الوجوه صغار الأعين كأن وجوههم الحجف ثلاث مرار فيهلك بعض وينجو بعض ، وأما الثالثة 
ms814	 فيصطلحون كلهم من بقي منهم ، قالوا : يا رسول الله من هم ؟ قال : الترك ، أما والذي نفسي بيده ليربطن خيولهم إلى سواري مساجد المسلمين ) )(@)(@@) ( حم ع ك هق ) في البعث ( ض ) عن بريدة ورواه ( د ) مختصرا .(@)(@@)(@@)(@@) $ ( 7390 ) قال النبي :(@)(@@) | 30 ( إن أمتي أمة مرحومة مقدسة مباركة لا عذاب عليها PageV03P077 يوم القيامة إنما عذابهم بينهم في الدنيا بالفتن ) )(@)(@@) ( طب ) و ابن عساكر عن أبي بردة عن أبي موسى ا رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7391 ) قال النبي :(@)(@@) | 30 ( إن امرأة من بني إسرائيل اتخذت خاتما من ذهب وحشته مسكا هو أطيب الطيب ) )(@)(@@) ( ن هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7392 ) قال النبي :(@)(@@) | 30 ( إن أمن الناس علي في صحبته وذات يده أبو بكر الصديق ، فحبه وشكره وحفظه واجب على أمتي ) )(@)(@@) ( قط ) في الأفراد و الخطيب عن سهل بن سعد رضي الله عنه وقالا : تفرد به عمر بن إبراهيم الكردي وغيره أوثق منه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 7393 ) قال النبي :(@)(@@) | 30 ( إن أناسا يتبعوني ، اللهم فمن ضربت أو سببت فاجعلها له كفارة وأجرا ) )(@)(@@) ابن سعد عن أبي السوار العدوي عن خاله .(@)(@@)(@@)(@@) $ ( 7394 ) قال النبي :(@)(@@) | 30 ( إن أناسا يدخلون جهنم ، حتى إذا كانوا حمما أدخلوا الجنة فيقول أهل الجنة : من هاؤلاء ؟ فيقال : هاؤلاء الجهنميون ) )(@)(@@) ( سمويه ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7395 ) قال النبي :(@)(@@) | 30 ( إن أناسا من أهل لا إلاه إلا الله يدخلون النار بذنوبهم ، فيقول لهم أهل اللات والعزى ما أغنى عنكم قول لا إلاه إلا الله وأنتم معنا في النار ، فيغضب الله تعالى فيخرجهم فيلقيهم في نهر الحياة فيبرؤون من حروقهم كما يبرأ القمر من كسوفه فيدخلون الجنة ويسمون فيها الجهنميون ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7396 ) قال النبي :(@)(@@) | 30 ( إن أناسا منكم أروا ليلة القدر في السبع الأول ، وإن أناسا أروها في السبع الأواخر ، التمسوها في السبع الأواخر ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P078(@)(@@)(@@)(@@) $ ( 7397 ) قال النبي :(@)(@@) | 30 ( إن أنسابكم هاذه ليست بمسبات على أحد ، وإنما أنتم بنو آدم كطف الصاع 
ms815	 إن تملؤه وليس لأحد على أحد فضل إلا بدين أو عمل صالح ، حسب امرىء أن يكون فاحشا بديئا بخيلا جبارا ) )(@)(@@) ( حم ) و ابن جرير ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7398 ) قال النبي :(@)(@@) | 30 ( إن أنسابكم هاذه ليست بمسبة على أحد ، كلكم بنو آدم ، ليس لأحد على أحد فضل إلا بدين أو تقوى ، وكفى بالرجل أن يكون بذيئا فاحشا بخيلا ) )(@)(@@) ( هب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7399 ) قال النبي :(@)(@@) | 30 ( إن أهل النار الذين لا يريد الله عز وجل إخراجهم ، لا يموتون فيها ولا يحيون ، وإن أهل النار الذين يريد الله إخراجهم يميتهم فيها إماتة حتى يصيروا فحما ثم يخرجون ضبائر فيبثون على أنهار الجنة حتى ينبتوا كما تنبت الحبة في حميل السيل فيسميهم أهل الجنة الجهنميين فيسألون الله تعالى أن يرفع ذالك الإسم عنهم فيرفعه عنهم ) )(@)(@@) عبد بن حميد عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7400 ) قال النبي :(@)(@@) | 30 ( إن أهل الكتاب افترقوا في دينهم على ثنتين وسبعين ملة ، وإن هاذه الأمة ستفترق على ثلاث وسبعين ملة وكلها في النار إلا واحدة وهي الجماعة وإنها ستخرج من أمتي أقوام تتجارى بهم تلك الأهواء كما يتجارى الكلب بصاحبه ، فلا يبقى منه عرق ولا مفصل إلا دخله ) )(@)(@@) ( حم طب ك ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7401 ) قال النبي :(@)(@@) | 30 ( إن أهل بيتي هاؤلاء يرون أنهم أولى الناس بي وليس كذالك ، إن أوليائي منكم المتقون من كانوا وحيث كانوا ، اللهم إني لا أحل لهم فساد ما أصلحت ، وايم الله لتكفا أمتي عن دينها كما تكفا الأثمار في البطحاء ) )(@)(@@) PageV03P079 ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7402 ) قال النبي :(@)(@@) | 30 ( إن أهل الجنة من لا يموت حتى يملأ الله مسامعه مما يحب ، وأهل النار من لا يموت حتى يملأ مسامعه مما يكره ) )(@)(@@) سمويه ( ك ض ) عن أنس قال أبو زرعة وأبو ظفر في رفعه .(@)(@@)(@@)(@@) $ ( 7403 ) قال النبي :(@)(@@) | 30 ( إن أهل الفردوس يسمعون أصيط العرش ) )(@)(@@) ابن مردويه عن أبي أمامة رضي 
ms816	 الله عنه .(@)(@@)(@@)(@@) $ ( 7404 ) قال النبي :(@)(@@) | 30 ( إن أهل بيتي سيلقون من بعدي من أمتي قتلا وتشريدا ، وإن أشد قومنا لنا بغضا بنو أمية وبنو المغيرة وبنو مخزوم ) ن| عيم بن حماد في الفتن ( ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7405 ) قال النبي :(@)(@@) | 30 ( إن أهل الدرجات العلى لينظر إليهم من هو أسفل منهم كما ينظر أحدكم إلى الكوكب الدري العابر في أفق من آفاق السماء ، وإن أبا بكر وعمر لمنهم وأنعما ) )(@)(@@) ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7406 ) قال النبي :(@)(@@) | 30 ( إن أهل الجنة ليحتاجون إلى العلماء في الجنة وذالك أنهم يزورون الله في كل جمعة فيقول لهم : تمنوا علي ما شئتم ، فيلتفتون إلى العلماء فيقولون : ماذا نتمنى على ربنا ؟ فيقولون : تمنوا عليه كذا وكذا ، فهم يحتاجون إليهم في الجنة كما يحتاجون إليهم في الدنيا ) )(@)(@@) ابن عساكر والديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7407 ) قال النبي :(@)(@@) | 30 ( إن أوفى كلمة عند الله أن يقول العبد : اللهم أنت ربي وأنا عبدك ، ظلمت نفسي وأعترف بذنبي ، ولا يغفر الدنوب إلا أنت ، أي رب فاغفر لي ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7408 ) قال النبي :(@)(@@) | 30 ( إن أولى الناس بي المتقون فأبصروا ، لا يأتي الناس بالأعمال يوم القيامة وتأتون بالدنيا فأصد عنكم بوجهي ) )(@)(@@) ( ع ) و ابن أبي عاصم في الآحاد PageV03P080 عن الحكم بن منهال أو ابن مينا .(@)(@@)(@@)(@@) $ ( 7409 ) قال النبي :(@)(@@) | 30 ( إن أولى الناس بالرجل يلي مقدمه من القبر وإن أولى الناس بالمرأة يلي مؤخرها من القبر ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7410 ) قال النبي :(@)(@@) | 30 ( إن أولادكم هبة الله تعالى لكم يهب لمن يشاء إناثا ويهب لمن يشاء الذكور ، فهم وأموالهم لكم إذا احتجتم إليها ) )(@)(@@) ( ك هق ) و الديلمي وابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7411 ) قال النبي :(@)(@@) | 30 ( إن أول من جحد آدم ثلاثا إن الله لما خلق آدم مسح على ظهره فأخرج ذريته فعرضهم عليه ، فرأى فيهم رجلا يزهر فقال : أي رب ، أي بني 
ms817	 هاذا ؟ قال : هاذا ابنك داود ، قال : فكم عمره ؟ قال : ستون سنة ، قال : أي رب زده في عمره ، قال : لا ، إلا أن تزيده أنت من عمرك ، وكان عمر آدم ألف سنة ، قال : أي رب زده من عمري فزاده أربعين سنة وكتب عليه كتابا وأشهد عليه الملائكة ، فلما احتضر آدم أتته الملائكة لتقبض روحه ، قال : إنه قد بقي من عمري أربعون سنة ، فقالوا : إنك جعلتها لابنك داود قال : أي رب ما فعلت ، فأنزل الله عليه الكتاب ، وأقام عليه البينة ، ثم أكمل الله لآدم ألف سنة ، وأكمل لداود مائة سنة ) )(@)(@@) ( ط حم ) ابن سعد ( طب هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7412 ) قال النبي :(@)(@@) | 30 ( إن أول شيء يرفع من هاذه الأمة الأمانة والخشوع ، حتى لا تكاد ترى خاشعا ) )(@)(@@) ابن المبارك عن ضمرة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 7413 ) قال النبي :(@)(@@) | 30 ( إن أول ما ينتن من الرجل بطنه فلا يدخل أحدكم فيه إلا طيبا ) )(@)(@@) سمويه عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7414 ) قال النبي :(@)(@@) | 30 ( إن أول قطرة تقطر من دم الشهيد يكفر بها ذنوبه ، PageV03P081 والثانية يكسى من حلل الإيمان ، والثالثة : يزوج من الحور العين ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7415 ) قال النبي :(@)(@@) | 30 ( إن أول شيء كتبه الله تبارك وتعالى في اللوح المحفوظ : بسم الله الرحمان الرحيم ، إني أنا الله لا إلاه إلا أنا لا شريك لي ، إنه من استسلم لقضائي وصبر على بلائي ، ورضي بحكمي كتبته صدقا وبعثته مع الصديقين يوم القيامة ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7416 ) قال النبي :(@)(@@) | 30 ( إن أول ما يتكلم من الإنسان حين يختم على الأفواه فخذه من الرجل اليسار ) )(@)(@@) ( حم طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7417 ) قال النبي :(@)(@@) | 30 ( إن أول من يدخل الجنة أنا وأنت وفاطمة والحسن والحسين ، قال علي فمحبونا ، قال : من ورائكم ) )(@)(@@) ( ك ) وتعقب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7418 ) قال النبي :(@)(@@) | 30 ( إن أول الناس يستظل في ظل الله يوم القيامة لرجل أنظر معسرا 
ms818	 حتى يجد شيئا ، أو تصدق عليه بما يطلبه ، يقول : ما لي عليك صدقة ابتغاء لوجه الله تعالى وتحرق صحيفته ) )(@)(@@) ( طب ) عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7419 ) قال النبي :(@)(@@) | 30 ( إن أول ما يهراق من دم الشهيد يغفر له ذنوبه ) )(@)(@@) ( ق ) عن سهل بن أبي أمامة بن سهل بن حنيف عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7420 ) قال النبي :(@)(@@) | 30 ( إن أول لواء يقرع باب الجنة لوائي ، وإن أول من يؤذن له في الشفاعة أنا ولا فخر ) )(@)(@@) ( ش ) عن أبي إسحاق عن رجل .(@)(@@)(@@)(@@) $ ( 7421 ) قال النبي :(@)(@@) | 30 ( إن أول ما يحاسب به العبد صلاته ، فإن صلحت صلح سائر عمله ، وإن فسدت فسد سائر عمله ، ثم يقول : انظروا هل لعبدي من PageV03P082 نافلة ، فإن كانت له نافلة أتم بها الفريضة ثم الفرائض كذالك لعائدة الله ورحمته ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه وهو حسن .(@)(@@)(@@)(@@) $ ( 7422 ) قال النبي :(@)(@@) | 30 ( إن أول معافاة الله العبد أن يستر عليه سيئاته في الدنيا ، وإن أول خزي الله للعبد أن يظهر عليه سيئاته ) )(@)(@@) الحسن بن سفيان وأبو نعيم عن بلال بن يحيى ا قال أبو نعيم : ذكره الحسن بن سفيان في الوجدان وأراه عندي العبسي الكوفي وهو صاحب حذيفة لا صحبة له .(@)(@@)(@@)(@@) $ ( 7423 ) قال النبي :(@)(@@) | 30 ( إن أول وقت العشاء حين يغيب الشفق ، وإن آخر وقتها حين ينتصف الليل ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7424 ) قال النبي :(@)(@@) | 30 ( إن أول منسك يومكم هاذا الصلاة ) )(@)(@@) ( طب ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7425 ) قال النبي :(@)(@@) | 30 ( إن أول عظم يتكلم من الإنسان حين يختم على الأفواه فخذه ) )(@)(@@) ابن عساكر عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7426 ) قال النبي :(@)(@@) | 30 ( إن أول تحفة المؤمن أن يغفر لمن خرج في جنازته ) )(@)(@@) ابن أبي الدنيا في ذكر الموت والخطيب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7427 ) قال النبي :(@)(@@) | 30 ( إن أول ما يتحف به المؤمن في قبره أن يقال له : ابشر فقد غفر لمن تبع جنازتك ) )(@)(@@) ابن أبي الدنيا عن 
ms819	 أبي عاصم الخبطي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7428 ) قال النبي :(@)(@@) | 30 ( إن أول ما يتحف به المؤمن إذا دخل قبره أن يغفر لمن صلى عليه ) )(@)(@@) ( قط ) في الأفراد عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7429 ) قال النبي :(@)(@@) | 30 ( إن أول كرامة المؤمن على الله تعالى أن يغفر لمن PageV03P083 شيعه ) )(@)(@@) ( عد ) و الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7430 ) قال النبي :(@)(@@) | 30 ( إن أول ما يذهب من هاذا الدين الأمانة ، وآخر ما يبقى منه الصلاة ، وسيصلي من لا خير فيه ، وما استجاز قوم بينهم الزنى إلا استوجبوا حرب الله ورسوله ، ولا ظهرت فيهم المعازف إلا صمت قلوبهم ، ولا ركبوا الزهو والبهاء إلا عميت أبصارهم ، ولا تكبروا إلا حرموا نفع الوحي ، ولا تركوا الأمر بالمعروف والنهي عن المنكر إلا نكست قلوبهم حتى لا يعرفون معروفا ولا ينكرون منكرا ) )(@)(@@) ابن عساكر عن واصل بن عبد الله السلامي عن جدته .(@)(@@)(@@)(@@) $ ( 7431 ) قال النبي :(@)(@@) | 30 ( إن أول من يبدل سنتي رجل من بني أمية ) )(@)(@@) ( ع هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7432 ) قال النبي :(@)(@@) | 30 ( إن أول ما خلق الله تعالى القلم ثم قال اكتب ، فقال : ما أكتب ؟ قال : القدر ، فجرى في تلك الساعة ما هو كائن إلى يوم القيامة ) )(@)(@@) ( حم ش ) و ابن منيع وابن جرير ( ط طب ض ) عنه .(@)(@@)(@@)(@@) $ ( 7433 ) قال النبي :(@)(@@) | 30 ( إن أوليائي المتقون يوم القيامة وإن كان نسب أقرب من نسب ، يأتي الناس بالأعمال وتأتون بالدنيا تحملونها على رقابكم ، يقولون : يا محمد فأقول : هاكذا وهاكذا ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7434 ) قال النبي :(@)(@@) | 30 ( إن بالمدينة رجالا ما قطعتم واديا ولا سلكتم طريقا إلا شركوكم في الأجر حبسهم العذر ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7435 ) قال النبي :(@)(@@) | 30 ( إن بالمدينة جنا قد أسلموا فإذا رأيتم منهم شيئا فأذنوه ثلاثة أيام ، فإن بدا لكم بعد ذالك فاقتلوه فإنما هو شيطان ) )(@)(@@) ( حم مع حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7436 ) قال النبي :(@)(@@) | 30 ( إن بالمغرب بابا للتوبة مفتوحا 
ms820	 مسيرة سبعين سنة لا PageV03P084 يغلق حتى تطلع الشمس من مغربها ) )(@)(@@) ( عد ) و ابن عساكر عن الفرزدق عن أبي هريرة ، عبد الرزاق ( طب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7437 ) قال النبي :(@)(@@) | 30 ( إن بائعها كشاريها يعني : الخمر ) )(@)(@@) ( طب ) عن عامر بن ربيعة ( طب ) عن كيسان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7438 ) قال النبي :(@)(@@) | 30 ( إن بحسبكم القتل ) )(@)(@@) ( د ) عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7439 ) قال النبي :(@)(@@) | 30 ( إن بدلاء أمتي لم يدخلوا الجنة بصلاة ولا صيام ، ولاكن دخلوها بسخاء النفس وسلامة الصدر ، والنصح للمسلمين ) )(@)(@@) ( قط ) في كتاب الأجواد ( د ) و الحلال في كرامات الأولياء وابن لال في مكارم الأخلاق عن الحسن عن أنس رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7440 ) قال النبي :(@)(@@) | 30 ( إن بدلاء أمتي لم يدخلوا الجنة بكثرة صوم ولا صلاة ، ولاكن دخلوها برحمة الله وسلامة الصدر ، وسخاوة الأنفس ، والرحمة لجميع المسلمين ) )(@)(@@) الحكيم وابن أبي الدنيا في كتاب السخاء ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7441 ) قال النبي :(@)(@@) | 30 ( إن بعدكم زمانا سفلتهم مؤذنهم ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7442 ) قال النبي :(@)(@@) | 30 ( إن بمكة لأربعة نفر من قريش أربا بهم عن الشرك وأرغب لهم في الإسلام ) )(@)(@@) عتاب بن أسيد وجبير بن مطعم وحكيم بن حزام وسهيل بن عمرو ) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7443 ) قال النبي :(@)(@@) | 30 ( إن بلالا يؤذن بليل ، فمن أراد الصوم فلا يمنعه أذان بلال حتى يؤذن ابن أم مكتوم ) )(@)(@@) عبد الرزاق عن ابن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 7444 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل اختلفوا فلم يزل اختلافهم بينهم PageV03P085 حتى بعثوا حكمين فضلا وأضلا ، وإن هاذه الأمة ستختلف فلا يزال اختلافهم بينهم حتى يبعثوا حكمين ضلا وضل من اتبعهما ) )(@)(@@) ( هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7445 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل كان إذا بال أحدهم فأصاب شيء من بوله ، تتبعه فقرضه بالمقراض ) )(@)(@@) ( طب ) عن أبي موسى مرفوعا ( خ م ) عنه موقوفا .(@)(@@)(@@)(@@) $ ( 7446 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل لما وقع فيهم النقص 