ms141	(@)(@@) % رشأ قد زان طرته % مشق نون ليس بالقلم % 13(@)(@@) % لا تلم عقلي ، ولم نظري ، % إن عقلي غير متهم % 14(@)(@@) % لي ، وتركي في المدام فيا % % لائمي أقصر ، ولا تلم % PageV01P819 البحر : خفيف تام 1(@)(@@) % أخذت من شبابي الأيام ، % وتوفي الصبا عليه السلام % 2(@)(@@) % وارعوى باطلي ، وبر حديث ال % % نفس مني ، وعفت الأحلام % 3(@)(@@) % ونهاني الإمام عن سفه الكأ % % س فردت على السقاة المدام % 4(@)(@@) % عفتها مكرها ولذات عيش % قام بيني وبينهن الإمام % 5(@)(@@) % و لقد حث بالمدامة كفي % % غصن بان عليه بدر تمام % 6(@)(@@) % عجبا ينهب العيون ، ويشتا % % ق إليه التقبيل والإلتزام % 7(@)(@@) % و ندامي في شباب وحسن ، % أتلفت مالهم نفوس كرام % 8(@)(@@) % بين أقداحهم حديث قصير % هو سحر ، وما سواه كلام % 9(@)(@@) % و غناء يستعجل الراح غض ، % وكما ناح في الغصون الحمام % 10(@)(@@) % وكأن السقاة بين الندامى % % ألفات على السطور قيام % PageV01P820 البحر : مخلع البسيط 1(@)(@@) % قد أظلم الليل ، يا نديمي ، % فاقدح لنا النار بالمدام % % 2(@)(@@) % كأننا والورى رقود ، % نقبل الشمس في الظلام % PageV01P821 البحر : طويل 1(@)(@@) % ألا عج إلى دار السرور ، وسلم ، % و قل أين لذاتي ، وأين تكلمي % % 2(@)(@@) % وقل : ما حلت بالعين دار سكنتها % % سواك ، فإن لم تعلمي ذاك فاعلمي % % 3(@)(@@) % و صفراء من صبغ الهجير لرأسها % % إذا مزجت إكليل در منظم % 4(@)(@@) % قطعت بها عمر الدجى وشربتها ، % ظلامية الأجسام نورية الدم % PageV01P822 البحر : سريع 1(@)(@@) % يارب ليل ، سحر كله ، % مفتضح البدر عليل النسيم % 2(@)(@@) % يلتقط الأنفاس برد الندى % % فيه فيهديه لحر السموم % 3(@)(@@) % لم أعرف الإصباح في ضوئه ، % لما بدا ، إلا بسكر النديم % PageV01P823 البحر : خفيف تام 1(@)(@@) % طول في أيلول شهر الصيام ، % وما قضينا فيه حق المدام % 2(@)(@@) % و الله لا أرضى على الدهر ، أو % % يسرق شهر الصوم في كل عام % PageV01P824 البحر : مجتث 1(@)(@@) % طال وجدي وداما ، % و فنيت سقاما % % 2(@)(@@) % أكل اللحم مني ، % وأذاب العظاما % % 3(@)(@@) % آل سلمى غضاب ، % فماذا علي ما ؟ % 4(@)(@@) % جعلوا القرب منها ، % و الكلام حراما % % 5(@)(@@) % ود منهم كثير ، % لو ألاقي الحماما % % 6(@)(@@) % انتضوا لي قسيا 
ms142	 ، % و أحدوا سهاما % % 7(@)(@@) % وفؤادي عاص ، % لا يطيع الملاما % % 8(@)(@@) % كلما جذبوه ، % ليلاقي الرشد هاما % % 9(@)(@@) % قل لمن نام عني : % صف لعيني المناما % % 10(@)(@@) % ما يضر خليا ، % لو شفى مستهاما % % PageV01P825 11(@)(@@) % مفردا بضناه ، % يحسب الليل عاما % % 12(@)(@@) % يا خليلي هيا ، % واسقياني المداما % % 13(@)(@@) % قد لبسنا صباحا ، % و خلعنا ظلاما % % 14(@)(@@) % و تروم الثريا % % في الغروب مراما % % 15(@)(@@) % كانكباب طمر ، % كاد يلقي اللجاما % % 16(@)(@@) % أرق العين برق % شق منها ركاما % % 17(@)(@@) % كيد حلت وسلت % مشرفيا حساما % % 18(@)(@@) % وأرى وجه هند ، % وألح دواما % % 19(@)(@@) % فإذا قلت خل % أرض نجد أقاما % % 20(@)(@@) % وقليل لهند % أن يسقى الغماما % % PageV01P826 21(@)(@@) % وجد الهم عندي % % موطنا ، ومقاما % % 22(@)(@@) % يا لقومي ، وقومي % % جرعوني السماما % % 23(@)(@@) % وكلوا بكريم % حسدا وغراما % % 24(@)(@@) % إسهروا كيف شئتم ، % قر ليل وناما % % 25(@)(@@) % لست أدري قعودا % أنتم أم قياما % % PageV01P827 البحر : متقارب تام 1(@)(@@) % إذا فتح القوم أفواههم % % لغير كلام ولا مطعم % 2(@)(@@) % فلا خير فيهم لشرب النبيذ ، % و دعهم يناموا مع النوم % PageV01P828 البحر : كامل تام 1(@)(@@) % لج الزمان ، فليس يعبث صرفه ، % إن الزمان على الكريم لئيم % 2(@)(@@) % لم يدر ما تحت التجمل حاسد ، % بالغيظ يقعد مرة ويقوم % 3(@)(@@) % قل للحسود ، إذا تنفس صعدة : % يا ظالما ، وكأنه مظلوم % PageV01P829 البحر : رجز تام 1(@)(@@) % جاءت تهادى كالغراب الهائم ، % ملظوظة ، مسودة القوادم % 2(@)(@@) % تصيح بالتهتان والهماهم ، % حتى شفت غلة ترب هائم % 3(@)(@@) % وغطت المحل بوبل دائم % . . . . . . . . . . . . . . . . % PageV01P830 البحر : متقارب تام 1(@)(@@) % أقول ، وقد طال ليل الهموم ، % وسامرت نجوى فؤاد سقيم % 2(@)(@@) % ترى ، الشمس قد مسخت كوكبا % وقد طلعت في عداد النجوم ؟ % PageV01P831 البحر : طويل 1(@)(@@) % و ليل ككحل العين خضت ظلامه % % بأزرق لماع وأبيض صارم % 2(@)(@@) % و طيارة بالرحل حرف كأنها % % تصافحث رضراض الحصى بجماجم % PageV01P832 البحر : طويل 1(@)(@@) % ذكرت عبيد الله ، والترب دونه ، % فلم تملك العينان إلا بكاهما % % 2(@)(@@) % و حاشاه من قول سقى الغيث قبره ، % يداه تسقي قبره من نداهما % % PageV01P833 البحر : بسيط تام 1(@)(@@) % لا تحزنن ، وقيت الحزن والألما ، % ولا عدمت بقاء يصحب النعما % % 2(@)(@@) % أليس قد قيل ، فيما 
ms143	 لست تنكره ، % في مكرمات الفتى تقديمه الحرما % % 3(@)(@@) % يا شامتا بيني وهب ، وقد فجعوا ، % لا تفرحن بنقص زادهم كرما % % PageV01P834 البحر : مخلع البسيط 1(@)(@@) % الموت مر ، والعيش هم ، % وأي هذين لا أذم % 2(@)(@@) % أهلك نفسي ، متى تناجي ، % لها وراء الغيوب رجم % 3(@)(@@) % أثقل رحلي من كل زاد ، % خوف المنايا ، والأرض رسم % 4(@)(@@) % و قد تعجبت ، إذ دهاني % % عيش ، وعندي بالموت علم % 5(@)(@@) % و الروح مستوفز بجسمي ، % له على الانتقال عزم % PageV01P835 البحر : متقارب تام 1(@)(@@) % إذا كنت ذا ثروة من غنى ، % فأنت المسود في العالم % 2(@)(@@) % وحسبك من نسب صورة ، % تخبر أنك من آدم % PageV01P836(@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % ضمن اللقاء رواح ناجية ، % مقذوفة بالنحض كالرعن % 2(@)(@@) % زبد اللغام يطير من فمها ، % نفض النوادف ناعم القطن % 3(@)(@@) % و كأن ذفراها معلقة ، % أو لبة رويت من الدهن % 4(@)(@@) % وكأن كلكلها ، إذا وخذت ، % فتل المرافق عن رحى طحن % 5(@)(@@) % تصغي إلى أمر الزمام كما % % عطفت يد الجاني ذرى الغصن % 6(@)(@@) % وكأن ظعن الحي غادية ، % نخل ، سقيت الغيث من ظعن % 7(@)(@@) % أو أيكة ناحت حمائمها ، % منثور أخضر ناعم لدن % 8(@)(@@) % يصفقن أجنحة ، إذا انتقلت % في فرع كطيالس دكن % 9(@)(@@) % وجد المتيم ، وهي هاتفة % ما شئت من طرب ومن حزن % 10(@)(@@) % لله ما ضمنت هوادجها ، % من منظر عجب ومنحسن % PageV01P837 11(@)(@@) % يا هند ! حسبك من مصارمتي ، % لا تحكمي في الحبذ بالظن % 12(@)(@@) % فات الصبا ، ورميت بالوهن ، % و يد المنية قد دنت مني % % 13(@)(@@) % و لقد حلبت الدهر أشطره ، % و عبرت حظ الجهل من سني % % 14(@)(@@) % ووجدت في الأيام موعظة ، % نصرت ملائكتي على جني % % 15(@)(@@) % وشبعت من أمر ومملكة ، % وحكمت بالملكات والسن % 16(@)(@@) % فعلى م تلمع لي سيوفكم ، % حاشاي من جزع ومن جبن % 17(@)(@@) % كم طابخاص قدراص لآكله ، % فاضت عليه بفاتر سخن % 18(@)(@@) % و لقد نهضت لوطئكم ، فأبى % % مثقال حلم راجح الوزن % 19(@)(@@) % عندي من العلات سلهبة ، % و مقوم خضل من الطعن % 20(@)(@@) % لا منصلي هجر الضراب ، ولا % % صدئت مضاربه من الحزن % PageV01P838 21(@)(@@) % كم من خليل لا أمتعه ، % لم 
ms144	 يبقه حذري ولا ضني % % 22(@)(@@) % ولى ، وخلفني لغائرة % بالمخزيات السود ، والأفن % 23(@)(@@) % أدى الإله إليه صحبته ، % و سقى ديارك صائب المزن % 24(@)(@@) % يا آمنا لا تبق من حذر ، % إن المخافة جانب الأمن % 25(@)(@@) % لا تخدعن بأقربيك ، وقد % % عفوك من عين ومن أذن % 26(@)(@@) % و لقيت من قوم ذوي إحن % لجبت صدورهم من الطعن % 27(@)(@@) % غش المغيب ، فإن لقيتهم % سجنوا العداوة أيما سجن % 28(@)(@@) % و هي العداوة ، لا خفاء بها ، % كالشمس تكسف ساعة الدجن % PageV01P839 البحر : مديد تام 1(@)(@@) % ولقد أغدو بعادية ، % تأكل الأرض بفرسان % 2(@)(@@) % فرجت عنها نواصيها ، % غرر خيطت بألوان % 3(@)(@@) % فتركن العير مختضبا % بدم في جوفه قان % 4(@)(@@) % و بنينا سمك خافقية % كرقوم بين أشطان % 5(@)(@@) % فوعتنا غير فاضلة ، % تزن الأرض بميزان % 6(@)(@@) % و شربنا ماء سارية ، % في قرارات وغدران % 7(@)(@@) % ثم قمنا نحو ملجمة % جنة طارت بفتيان % 8(@)(@@) % فتلاقينا على قدم % بين آجال وصيران % 9(@)(@@) % و توشحنا بضمته ، % و سقى جري ، فأرواني % % 10(@)(@@) % ذاك إذ لي الصبا عذر ، % قبل أن يؤمنض شيطاني % % PageV01P840 11(@)(@@) % و سل البيداء عن رجل % يخطم الريح بثعبان % 12(@)(@@) % ساهر فيك ، ومقلته % ليس يكسوها بأجفان % 13(@)(@@) % و جررت الجيش أسحبه % لعدو كان من شاني % % 14(@)(@@) % فأذقت الأرض مهجته ، % دينه منه كأديان % PageV01P841 البحر : بسيط تام 1(@)(@@) % يا دار ، يا دار أطرابي وأشجاني ، % أبلى جديد مغانيك الجديدان % 2(@)(@@) % لئن تخليت من لهوي ومن سكني ، % لقد تاهلت من همي ، وأحزاني % % 3(@)(@@) % جاءتك رائحة في إثر باكرة ، % تروي ثرى منك امسى غير ريان % 4(@)(@@) % حتى ارى النور في مغناك مبتمسا ، % كأنه حدق في غير أجفان % 5(@)(@@) % لما وقفت على الأطلال أبكاني % % ما كان أضحكني منها وألهاني % % 6(@)(@@) % فما أقول لدهر شتتت يده % شملي ، واخلى من الأحباب أوطاني % % 7(@)(@@) % وما أتاني بنعمى ظلت لابسها ، % إلا انثنى مسرعا فيها ، فعراني % % 8(@)(@@) % كم نعمة عرف الإخوان صاحبها ، % لما مضت أنكروه بعد عرفان % 9(@)(@@) % و مهمه كرداء العصب مشتبه ، % قطعته ، والدجى والصبح خيطان % % 10(@)(@@) % والريح تجذب أطراف الرداء ، كما % % أفضى الشقيق إلى تنبيه 
ms145	 وسنان % % PageV01P842 11(@)(@@) % حتى طويت على أحشاء ناجية ، % كأنما خلقها تشييد بنيان % 12(@)(@@) % كأن أخفافها ، والسير ينقلها ، % دلاء بئر تدلت بين أشطان % 13(@)(@@) % لها زمام ، إذا أبصرت جولته % حسبت في قبضتي أثناء ثعبان % 14(@)(@@) % إلى هلال تجلت عنه ليلته ، % باريه صوره في خلق إنسان % 15(@)(@@) % لجت بنا هجرة ، والقلب عندكم ، % فأطلقي القلب ، أو قودي لجثماني % % 16(@)(@@) % أنا الذي لم تدع فيه محبتكم % % فضلا لغيرك من إنس ولا جان % 17(@)(@@) % فإن أردت وصالا فاقبلي صلتي % % مني وإلا ، فهجران بهجران % 18(@)(@@) % ما الود مني بمنقول إلى مذق ، % ولست أطرح نفسي حيث تلحاني % % 19(@)(@@) % و لا أريد الهوى ، إن لم يكن لهوى % % نفسي ، وبعض الهوى والموت سيان % 20(@)(@@) % و رب سر كنار الصخر كامنة ، % أمت إظهاره مني ، فأحياني % % PageV01P843 21(@)(@@) % لم يتسع منطقي فيه ببائحة % حزما ولا ضاق عن مثواه كتماني % % 22(@)(@@) % و رب نار أبيت الليل أوقدها % % في ليلة من جمادى ذات تهتان % 23(@)(@@) % يقيد اللحظ فيها عن مسالكها ، % كأنها لبست أثواب رهبان % 24(@)(@@) % ما زلت أدعو بضوء النار مقتربا ، % يغري دجى الليل منه شخص حران % 25(@)(@@) % و قد تشق غبار الحرب لي فرس % مقدم ، غير هياب ، ولا وان % 26(@)(@@) % و قد قائمة منه مركبة % في مفصل ضامر الأعصاب ظمآن % 27(@)(@@) % بحيث لا غوث إلا صارم ذكر ، % و جنة كحباب الماء تغشاني % % 28(@)(@@) % و صعدة كرشاء البئر ناهضة ، % بأزرق كاتقاد النجم يقظان % 29(@)(@@) % سلي ، فديتك ، هل عربت من منني % % خلقا ، وهل رحت في أثواب منان % 30(@)(@@) % وهل مزجت صفائي للصديق ، وهل % % أودعت ، ياهند ، غير الحمد خزاني % % PageV01P844 31(@)(@@) % و لا عققت بجس الكأس ساقيتي ، % و لا عففتث ، وظل الدهر ينعاني % % 32(@)(@@) % أسررت حزنا بها والقلب مضطرب ، % و راح يبني بغير الحق إعلاني % % 33(@)(@@) % وقد أرقت لبرق طار طائره ، % والنوم قد خاط أجفانا بأجفان % 34(@)(@@) % في مكفهر كركن الطود مصطخب ، % كأن إرعاده تحنان ثكلان % PageV01P845 البحر : طويل 1(@)(@@) % ملكنا الهوى حينا ، وكان وكانا ، % فأرخصنا دهر ، فكيف ترانا % % 2(@)(@@) % ألم نتلق الحادثات بصبرنا ، % وكم جازع للحادثات سوانا % % PageV01P846 البحر 
ms146	 : مجزوء الوافر 1(@)(@@) % شجاك الحي ، إذ بانوا ، % فدمع العين تهتان % 2(@)(@@) % و فيهم ألعس أغي % % د ، ساجي الطرف وسنان % 3(@)(@@) % و لم أنس ، وقد زمت % لوشك البين أظعان % 4(@)(@@) % و قد أنهبني فاه ، % و ولى ، وهو عجلان % 5(@)(@@) % فقل في مكرع عذب ، % و قد وافاه عطشان % 6(@)(@@) % لوجه الموت ألوان % له في الريح أغصان % 7(@)(@@) % كما ضم غريق سا % % بحا ، والماء طوفان % 8(@)(@@) % و ما خفنا من الناس ، % وهل في الناس إنسان ؟ % 9(@)(@@) % جزينا الأمويين ، % ودناهم كما دانوا % % 10(@)(@@) % و ذاقوا ثمر البغي ، % و خناهم كما خلنوا % % PageV01P847 11(@)(@@) % و للخير وللشر ، % بكف الله ميزانث % % 12(@)(@@) % و لولا نحن قد ضاع % دم بالطف مجان % 13(@)(@@) % فيا من عنده القبر ، % وطين القبر قربان % 14(@)(@@) % بأسياف لكم أودى % % حسين ، وهو ظمآن % 15(@)(@@) % يرى في وجهه الجهم ، % % 16(@)(@@) % و دأب العلويين ، % لهم جحد وكفران % 17(@)(@@) % فهلا كان إمساك ، % إذا لم يك إحسان % 18(@)(@@) % يلومونهم ظلما ، % فهلا مثلهم كانوا % % PageV01P848 البحر : سريع 1(@)(@@) % يا غصنا إن هزه مشيه ، % خشيت أن يسقط رمانه % % 2(@)(@@) % إرحم مليكا صار مستعبدا ، % قد ذل في حبك سلطانه % % PageV01P849 البحر : كامل تام 1(@)(@@) % أرأيت كيف بدا ليقتلنا % % ذاك الرشا والبدر والغصن % 2(@)(@@) % ببياض وجه مع عيون ظبا ، % بسوادهها ، فتكامل الحسن % PageV01P850 البحر : بسيط تام 1(@)(@@) % يا عاذلي كم ، لحاك الله ، تلحاني ، % هبني لبدر على غصن من البان % 2(@)(@@) % قد مر بي ، وهو يمشي في معصفرة % عشية ، وسقاني ، ثم حياني % % 3(@)(@@) % و قال : تلعب جنابا ، فقلت له : % من جد بالوصل لم يلعب بهجران % PageV01P851 البحر : - 1(@)(@@) % % أنت تستحسن الوفاء فكنه % 2(@)(@@) % خجل الورد إذ رأى وجه من أه % % واه ، والجلنار أخجل منه % 3(@)(@@) % ليس للعبد منك بد ، فإن شئ % % 4(@)(@@) % أيها اللائم ، الذي لام فيه ، % دع محبا ، بجهده ، أو أعنه % PageV01P852 البحر : خفيف تام 1(@)(@@) % يا حبيبا سلا ، ولم أسل عنه ، % أنت تستحسن الوفاء فكنه % 3(@)(@@) % % ت فأكرمه يبتدي أو أهنه % PageV01P853 البحر : بسيط تام 1(@)(@@) % قد كلمت عينه عيني فهنوني ، % وحدثوني بحب ليس بالدون % 2(@)(@@) % قالوا : جننت 
ms147	 بلا شك ، فقلت لهم : % ما لذة العيش إلا للمجانين % PageV01P854 البحر : مجزوء الخفيف 1(@)(@@) % أنا مذ صار لي سكن % في ضروب من الحزن % 2(@)(@@) % هائم العقل في نها % % ري ، وليلي بلا وسن % 3(@)(@@) % ليتني عدت مثل ما % % كنت أرعى بلا رسن % PageV01P855 البحر : طويل 1(@)(@@) % و لما التقينا بعد حين من الحين ، % حلفنا بأنا لا نعود إلى البين % 2(@)(@@) % وقلت : تعالي يا شريرة نمتزج % % كمثل امتزاج الماء والخمر نصفين % 3(@)(@@) % وقد أخرستنا قبلة عن حديثنا ، % إلى الصبح حتى غرد الديك صوتين % 4(@)(@@) % و طول عتاب في التلاقي يريبني ، % و ينبي بعجز أو تغير قلبين % PageV01P856 البحر : سريع 1(@)(@@) % حاجيتكم يا كل من لامني ، % قولوا بحق ، أو دعوني إذن % 2(@)(@@) % ما خصبة حصباؤها جوهر ، % إن لم تكن في فم شر ، فمن ؟ % PageV01P857 البحر : مجزوء الكامل 1(@)(@@) % عندي من الحب اليقين ، % كذب الهوى بدن سمين % 2(@)(@@) % موتي كذا ألم الهوى ، % لكن صبري لا يكون % PageV01P858 البحر : مجتث 1(@)(@@) % أسرفت في الكتمان ، % وذاك مما دهاني % % 2(@)(@@) % كتمت حبك حتى % % كتمته كتماني % % 3(@)(@@) % فلم يكن لي بد % من ذكره بلساني % % PageV01P859 البحر : مجتث 1(@)(@@) % يا دائم الهجر دعني % % من الصدود ، فقطني % % 2(@)(@@) % فر فؤادي مني ، % فسل يحدثك عني % % PageV01P860 البحر : طويل 1(@)(@@) % فداك أبي ! ما لي أراك بحسرة ، % بليت بهجر أودهيت ببين ؟ % 2(@)(@@) % و ما لي أرى ديباج خدك أصفرا ، % ونرجستي عينيك ذابلتين % 3(@)(@@) % زعمت بأني لست أحسن عذرة ، % ألا إن ذا عذري ، فكيف تريني ؟ % PageV01P861 البحر : رمل تام 1(@)(@@) % قل ليعقوب : فديناك بنا ، % ما نرى بعدك شيئا حسنا % 2(@)(@@) % شنع الظن علينا عندكم ، % إنما كذبه الحسن لنا % % PageV01P862 البحر : كامل تام 1(@)(@@) % أما ، وقد بانوا فلم تبن % نفسي ، فما أحسنت في الحزن % 2(@)(@@) % يا رب ، واستبدلت بعدهم ، % وسكنت بعدهم إلى سكن % 3(@)(@@) % هلا خلوت كما خلا وعفا % % رسم سواك ، وفى ولم يخن % 4(@)(@@) % و الله ما استحدثت مثلهم ، % حاشا لوجه شريرة الحسن % PageV01P863 البحر : منسرح 1(@)(@@) % أبصرته في المنام معتذرا % إلي مما جناه يقظانا % % 2(@)(@@) % ولان حتى إذا هممت به ، % نبهت ، عند الصباح 
ms148	 ، لا كانا % % PageV01P864 البحر : مجزوء الرجز 1(@)(@@) % أفدي التي قلت لها ، % والبين منا قد دنا : % 2(@)(@@) % بالحزن بعدي فأتسي ، % قالت : إذا قل العنا % % 3(@)(@@) % قلت لها : حبك قد أن % % حل مني البدنا % % 4(@)(@@) % قالت : فماذا حيلتي ؟ % كذاك قد ذبت أنا % % PageV01P865 البحر : مديد تام 1(@)(@@) % زودينا نائلا ، أو عدينا ، % قد صدقناك ، فلا تكذبينا % % 2(@)(@@) % خبريني كيف أسلو ، وإن لم % % أر زفرة ، أو أنينا % % 3(@)(@@) % أو أريحيني ، ففي الموت كفؤ ، % واقتليني مثل من تقتلينا % % 4(@)(@@) % يا هلالا تحته بان ، % أي ذنب فيك للعاشقينا % % 5(@)(@@) % يا أمير المؤمنين المرجى ، % قد أقر الله فيك العيونا % % 6(@)(@@) % ودعينا لك ببيعة حق ، % فسعينا نحوها مسرعينا % % 7(@)(@@) % بنفوس أملتك زمانا ، % سبقت أيدينا طائعينا % % 8(@)(@@) % ولك المنة فيها علينا ، % لم نجد مثلك في العالمينا % % 9(@)(@@) % جمع الله عليك قلوبا ، % مزقت في معشر آخرينا % % 10(@)(@@) % أنت أقررت عين كل نفس ، % وفرشت الأمن للخائفينا % % PageV01P866 11(@)(@@) % و حصرتض الماس من كل عاد % بسيوف وقنا قد روينا % % 12(@)(@@) % و إذا ما زأرت أسد أرض ، % دستها حتى تئن أنينا % % 13(@)(@@) % بركام يملأ الأرض خيلا ، % ورحال لا تهاب المنونا % % 14(@)(@@) % ربط النصر بهم أين كانوا ، % إن شمالا ذهبوا ، أو يمينا % % 15(@)(@@) % ضمهم في غرفة الحزم منهم % % رأس بر ساس دنيا ودينا % % 16(@)(@@) % قر في كفك خاتم ملك % لك صاغته الخلافة حينا % % 17(@)(@@) % ولقد كان إليك فقيرا ، % لا يرى مثلك في اللابسينا % % PageV01P867 البحر : مجزوء الرجز 1(@)(@@) % يا جوهر الإخوان ، % و حلية الزمان % 2(@)(@@) % ودولة المعالي ، % و روضة الأمان % 3(@)(@@) % عش لي كعمر قولي % % فيك ، فقد كفاني % % 4(@)(@@) % داويت غير ودي ؛ % مصائب الإخوان % PageV01P868 البحر : مجزوء الكامل 1(@)(@@) % يا ناصر الإسلام عش ، % واسلم على ريب الزمن % 2(@)(@@) % شق الجموع بسيفه ، % وشفى حزازات الإحن % 3(@)(@@) % دامي الجراح كأنه % ورد تفتح في غصن % PageV01P869 البحر : بسيط تام 1(@)(@@) % إني رزقت من الإخوان جوهرة ، % ما إن لها قيمة عندي ولا ثمن % 2(@)(@@) % فلست معتذرا من أن أشح بها ، % و لا يزال لدي الدهر يختزن % 3(@)(@@) % بحيثث لا يهتدي هجر ولا ملل ، % و 
ms149	 لا يطور بها عتب ولا ضغن % 4(@)(@@) % فما الخيانة من شأني ، ولا خلقي ، % وليس عندي لها عين ولا أذن % PageV01P870 البحر : طويل 1(@)(@@) % أيا معقلي للنائبات ، وإن قست % علي خطوب الدهر ، وهي تلين % 2(@)(@@) % خلقت لأسقام النوى قبل كونها ، % فكيف تراني إن نأيت أكون % 3(@)(@@) % أكون كذي داء يعد دواؤه ، % له كل يوم زفرة وأنين % 4(@)(@@) % ألا رب حال قد تحول بؤسها ، % و ما الدهر إلا نبوة وسكون % 5(@)(@@) % وقد يعقب المكروه يوما محبة ، % و كل شديد مرة سيهون % 6(@)(@@) % و يا قلب صبراص عند كل ملمة ، % وخل عنان الدهر ، فهو حرون % PageV01P871 البحر : مجزوء الرجز 1(@)(@@) % يارب قد أبلاني ، % حبي لذا الخوان % 2(@)(@@) % وباح دمعي بسري ، % و خانني كتماني % % 3(@)(@@) % يا زهرة البستان ، % يا نفحة الريحان % 4(@)(@@) % أنت ابن بدر وشمس ، % ما أنت من إنسان % 5(@)(@@) % ما للثريا شبيه ، % فيما بنى قط بان % 6(@)(@@) % حيطانه من نور ، % والسقف من نيران % 7(@)(@@) % و الصحن ياقوت در ، % للعين في جنان % 8(@)(@@) % و الماء يعدو عليها ، % في جدول ريان % 9(@)(@@) % فعش بذاك سليما ، % خليفة الرحمن % 10(@)(@@) % وكن مع الدهر دهرا ، % عمرا ، كما عمران % PageV01P872 11(@)(@@) % فتبقيان جميعا ، % % PageV01P873 البحر : خفيف تام 1(@)(@@) % نصر الله بالوزيرين ملكا ، % كان أودى واستكمن الذل منه % 2(@)(@@) % فأجادا نصيحة لإمام ، % إن دهاها في شدة لم تخنه % 3(@)(@@) % هو مثل الحسام بين غراري % % ه ، فهذا وذا يجاهد عنه % PageV01P874 البحر : بسيط تام 1(@)(@@) % هل من معين على أحداث أزماني ، % أسأت معتمدا لي بعد إحسان % 2(@)(@@) % كلا أليست تقيني للزمان يد ، % لقاسم ذات تمكين وسلطان % 3(@)(@@) % الزاجر الدهر عني إذا شحا فمه ، % و مد كفيه في ظلم وعدوان % 4(@)(@@) % حملت نفسك ، ولا زالت معمرة ، % رد المكاره عن نفسي وجثماني % % 5(@)(@@) % كذاك كان عبيد الله ، واحزني % % عليه ، ما عشت في سري وإعلاني % % 6(@)(@@) % أقول ، لما علا صوت النعي به ، % وما ملكت عليه دمع أجفاني : % 7(@)(@@) % يا ناعييه ! بحق مات ، ويحكما ، % أتدريان لنا ماذا تقولان ؟ % 8(@)(@@) % لئن فجعنا بما لا خلق يعد له ، % وما له في 
ms150	 الورى ، إلا ابنه ، ثان % 9(@)(@@) % تبت يد قبرته أي بحر ندى % % طمى ، وهضبة عز ذات أركان % 10(@)(@@) % كان المصيب بسهم الرأي قبضته ، % و القائل الحق موزونا بميزان % PageV01P875 11(@)(@@) % كم ليلة قد نفى عني الرقاد بها % % ما يعلم الله من هم وأحزان % 12(@)(@@) % كأن حاطبة كانت تحطب ، في % % قلبي ، قتادا ، وتكويه بنيران % 13(@)(@@) % إن نترك الشرك لا يتركه من يده ، % لا بد للحلو في الإيمان من جان % PageV01P876 البحر : طويل 1(@)(@@) % تبدى فأين الغصن من ذلك الغصن ، % وبدر الدجى من ذلك البدر في الحسن % 2(@)(@@) % وغالبت حبي ساعة ثم لم أطق % طلائعه في اللحظ والدمع والحزن % 3(@)(@@) % وقد لام عقلي فيه نفسي ، فما انتهت ، % وقالت : أعني باحتيالك ، أو دعني % % 4(@)(@@) % هنتك أمير المؤمنين خلافة ، % أتتك على طير السعادة واليمن % 5(@)(@@) % ولما أقرت في يديك عنانها ، % نشرت على الدنيا جناحا من الأمن % 6(@)(@@) % لقد زفها في حليها رأي قاسم % إلى ملك كالبدر مقتبل السن % 7(@)(@@) % ولم يظلم الحق الذي هو أهله ، % وأنفذ حكم الله في والد وابن % 8(@)(@@) % ألا مذكر بي عند خبير خليفة ، % جزيل العطايا ، واسع الفضل والمن % 9(@)(@@) % مجالستي إياه في حلم الكرى ، % وجائزتي تمسي إلى خلفها عني % % 10(@)(@@) % و أحضرت في يوم الخميس لخلعة ، % وأبت عشاء ، وهي فارغة مني % % PageV01P877 11(@)(@@) % فيا جود كفيه امح آثار بأسه ، % فإن عليه أرش حبسي ولم أجن % PageV01P878 البحر : بسيط تام 1(@)(@@) % لا ذنب لا ذنب لابن العير حين هوت % % قواه من خور فيها ومن لين % 2(@)(@@) % حملتموه الذي ما كان يحمله % فره البغال وأصناف البراذين % 3(@)(@@) % الشمس والبدر والطور الرفيع معا ، % في الغيث والليث والدنيا مع الدين % PageV01P879 البحر : رجز تام 1(@)(@@) % لي صاحب مختلف الألوان ، % متهم الغيب على الإخوانش % % 2(@)(@@) % منقلب الود مع الزمان ، % يسرق عرضي حيث لا يلقاني % % 3(@)(@@) % و هو إذا لقيته أرضاني ، % فليته دام على الهجران % PageV01P880 البحر : كامل تام 1(@)(@@) % لمن القتيل ، وما تحللت الحبا ، % هل كان غير مسود مدفون % 2(@)(@@) % بالشام ، ملكا قد تبدد ملكه % بمسرة من أنفس وعيون % 3(@)(@@) % لا 
ms151	 بد أن يقع الجزاء بظالم ، % و تحرك الأحقاد بعد سكون % 4(@)(@@) % لا يصلح الجبار إلا ضربة ، % تشفيه من خبل به وجنون % PageV01P881 البحر : طويل 1(@)(@@) % تركت حبيبا من يدي من هوانه ، % و أقبلت في شأني ، وولى بشانه % 2(@)(@@) % أرى عورات الناس يخفى مكانها ، % و عورته في عقله ولسانه % PageV01P882 البحر : طويل 1(@)(@@) % وكم جولة لا يحسن البغل مثلها ، % أتت عجلا لم يجن مكروهها جان % 2(@)(@@) % وفك ، إذا غنى يحرك لحية % كمثل ذنابى صعوة ليس بالواني % % PageV01P883 البحر : مخلع البسيط 1(@)(@@) % كان لنا صاحب زمانا ، % فحال عن عهده وخانا % % 2(@)(@@) % تاه علينا ، فتاه منا ، % فلا نراه ولا يرانا % % PageV01P884 البحر : خفيف تام 1(@)(@@) % ضحك المشرفات في يوم عيد ، % إذ رأوا جعفرا يحث العنانا % % 2(@)(@@) % قلن ، لما رأينه حالكا أس % ود جعدا ، يناسب السودانا : % 3(@)(@@) % ليت هذا لنا فنعمل من جل % % دته في وجوهنا خيلانا % % PageV01P885 البحر : خفيف تام 1(@)(@@) % ليت ما قد شربته في جمادى ، % كنت أسقيتنيه في شعبان % 2(@)(@@) % لم أزل آمل المزيد ، ولا ف % % كرت في ذا المطال والحرمان % 3(@)(@@) % كل يوم أمد عيني إلى البا % % ب رجاء لمثل تلك القناني % % 4(@)(@@) % أو لما دونها ، إذا ما سوى ذا % % ك ، وقد تجتري عليه الأماني % % PageV01P886 البحر : متقارب تام 1(@)(@@) % أيا ساقي الراح لا تنسنا ، % و يا جارة العود غني لنا % % 2(@)(@@) % فقد أسبل الدجن بين السما % % ء والأرض مطرفه الأدكنا % % PageV01P887 البحر : منسرح 1(@)(@@) % من عائدي من الهموم والحزن ، % و ذكر ما قد مضى من الزمن % 2(@)(@@) % و شرب كأس في مجلس بهج % لم أر فيه هما ، ولم يرني % % 3(@)(@@) % من كف ظبي مقرطق ، غنج ، % يعشقه من عليه يعذلني % % 4(@)(@@) % تلوح صلبانه بلبته ، % كنور زهرية بلا غصن % 5(@)(@@) % يا ليت من جاءه يقربه ، % من فضل قربانه يقربني % % 6(@)(@@) % جاء بها كالسراج ضافية ، % سلافة لم تدس ، ولم تهن % 7(@)(@@) % من ماء كرم عتقت حقبا % في بطن أحوى الضمير مختزن % 8(@)(@@) % كأنه ، منذ قام معتمدا % بعظم ساق مثقل البدن % 9(@)(@@) % ميت وفيه الحياة كامنة ، % بروحها العنكبوت في كفن 
ms152	 % 10(@)(@@) % ما لي ، وللباكراتش والظعن ، % و مقفراتش الطلول والدمن % PageV01P888 11(@)(@@) % شغلي عنها بالراحش في غلس ، % ووضع ريحانة على أذني % % 12(@)(@@) % و لحظ عين يريد ذاك وذا ، % خوانة تجرى على العين % PageV01P889 البحر : بسيط تام 1(@)(@@) % دعني فما طاعة العذال من ديني ، % ما السالم القلب في الدنيا كمحزون % 2(@)(@@) % لا تسمع النصح غلا القلب يقلبه ، % يكفيك رأيك لي رأي سيكفيني % % 3(@)(@@) % أقررت أني مجنون بحبكم ، % و ليس لي عنكم عذر المجانين % 4(@)(@@) % وصاحب بعد سن النوم مقلته ، % دعوته ، ولسان الصبح يدعوني % % 5(@)(@@) % نبهته ونجوم الليل راكعة ، % في محفل من بقايا ليلها جون % 6(@)(@@) % ركوع رهبان دير في صلاتهم ، % سود مدارعهم شم العرانين % 7(@)(@@) % فقام يمسح عينيه وسنته % بقعدة النوم من فيه يلبيني % % 8(@)(@@) % و طاف بالدن ساق وجهه قمر ، % وطرفه بسريع الحد مسنون % 9(@)(@@) % كان خط عذار ، شق عارضه ، % ميدان آس على ورد ونسرين % 10(@)(@@) % وخط فوق حجاب الدر شاربه ، % بنصف صاد ودال الصدغ كالنون % PageV01P890 11(@)(@@) % فجاء بالراح يحكي ورد وجنته ، % مقرطق من بني كسرى وشيرين % 12(@)(@@) % عليه إكليل آس فوق مفرقه ، % قد رصعوه بأنواع الرياحين % 13(@)(@@) % لا أتقي الراح بالندمان من يده ، % وإن سقتني حولا ، قلت : زيديني % % 14(@)(@@) % قولوا لمكتوم : يا نور البساتين ، % الحمد لله ، حتى أنت تجفوني % % 15(@)(@@) % قد كنت منتظرا هذا ، فجئت به ، % وليس خلق على غدر بمأمون % 16(@)(@@) % ذكرت من خوف أهلي من بليت به % من بينهم ، واحتملت العار في ديني % % 17(@)(@@) % صرفت معنى حديثي عن ظنونهم ، % عمدا ، كمن فر من ماء إلى طين % PageV01P891 البحر : طويل 1(@)(@@) % صحوت ، ولكن بعد أي فتون ، % فلا تسأليني صبوة ، ودعيني % % 2(@)(@@) % و دب مشيي بعضه فوق بعضه ، % و أخرجني من أنفس وعيون % 3(@)(@@) % فما أحضر اللذات إلا تخلفا ، % و لم أر مخلوقا بغير يمين % 4(@)(@@) % وأفردت إلا من خليل مكاشر ، % سريع شرار الجهل غير أمين % 5(@)(@@) % و خمارة تعني المسيح بربها ، % طرقت وضوء الصبح غير مبين % 6(@)(@@) % فلما رأتني أيقنت بمعذل % قصير بقاء الوفر غير ضنين % 7(@)(@@) % فجاءت بها في كأسيها ذهبية 
ms153	 ، % لها حدق لم تتصل بجفون % 8(@)(@@) % كأنا وضوء الصبح يستعجل الدجى % % نطير غرابا ذا قوادم جون % 9(@)(@@) % فما زلت أسقاها بكف مقرطق ، % كغصن ثنته الريح بين غصون % 10(@)(@@) % لوى صدغه كالنون من تحت طرة % ممسكة ، تزهى بعاج جبين % PageV01P892 البحر : مديد تام 1(@)(@@) % لا تملا حثنا واسقيانا ، % قد بدا الصبح لنا ، واستبانا % % 2(@)(@@) % واقتلا همنا بصرف عقار ، % و اتركا الدهر ، فما شاء كانا % % 3(@)(@@) % وامزجا كأسنا بريقة شر ، % طاب للعطشان وردا ، وحانا % % 4(@)(@@) % من فم قد غرس الدر فيه ، % ناصح الريق إذا الريق خانا % % 5(@)(@@) % ونديم قد أمرض السقم منه % مقلة فاترة ولسنا % % 6(@)(@@) % قد دعوناه إلى الكأس حتى % % هش للساقي ومد البنانا % % 7(@)(@@) % لم يزل يرقص ، وهو طروب ، % ثم علقنا عليه القيانا % % PageV01P893 البحر : وافر تام 1(@)(@@) % سقاني من معتقة الدنان ، % مليح الدل مختضب البنان % 2(@)(@@) % وهبت لوجهه ألحاظ عيني ، % بلا خوف لأولاد الزواني % % 3(@)(@@) % و فرغ حسنه من كل عيب ، % وجل عن المشاكل والمداني % % 4(@)(@@) % فجاء كما تمنى كل نفس ، % له بدع دقيقات المعاني % % 5(@)(@@) % و حمل كفه كأسا تلظى % % بنار لا تقنع بالدجان % 6(@)(@@) % فلما صب فيها الماء ثارت % كما ثار الشجاع إلى الجبان % 7(@)(@@) % فخلت الكأس مركز أقحوان ، % و تربته سحيق الزعفران % PageV01P894 البحر : سريع 1(@)(@@) % ردت علي اللوم ظلامة % ويحك لاأغلب بالعاذلين % 2(@)(@@) % هل يحبس النفس على جسمها % % جار هزيل ، وابن بنت سمين % 3(@)(@@) % قد أقبلت تعذلني باطلا ، % وانصرفت عن وجه حق مبين % 4(@)(@@) % لا أحمل البخل إلى حفرتي ، % لتأكلي البخل مع الآكلين % 5(@)(@@) % من مبلغ قومي على قربهم ، % وبعد أسماع عن الواعظين % 6(@)(@@) % هبوا فقد طالت بكم رقدة ، % من بعدها أحسب لا ترقدون % 7(@)(@@) % حثوا مطايا الجد ترقل بكم % % ناجين بين الناس أو معذرين % 8(@)(@@) % يا عجبا من ناصح لم يطع ، % كم حازم قد ضاع في جاهلين % 9(@)(@@) % رأى من الشر الذي لم يروا ، % و كان يهم ، وهم يفرحون % 10(@)(@@) % إني أرى الأعداء قد رسخوا % % دواهيا ، أنتم لها حافرون % PageV01P895 11(@)(@@) % يلوا قباب الملك عن معشر % كانوا لها 
ms154	 من قبلكم مبتنين % 12(@)(@@) % تخبركم عن زمن لم يزل % يجد بالقوم ، وهم يلعبون % 13(@)(@@) % كذاك ما أنتم عليه ، وما % % أشبه ما كان لشيء يكون % 14(@)(@@) % عانقتم الأحلام في مضجع ، % سينبت الشوك لكم بعد حين % 15(@)(@@) % يا لهف قرباي على معشر ، % إن لم تشق بالله ، وما يتقون ؟ % PageV01P896 البحر : - 1(@)(@@) % قد مضى آب صاغرا ، لعنته ال % % له عليه ، ولعنة اللاعنينا % % 2(@)(@@) % و أتانا أيلول ، وهو ينادي : % الصبوح الصبوح يا غافلينا % % PageV01P897 البحر : متقارب تام 1(@)(@@) % ألا من لنفس وأحزانها ، % ودار تداعت بحيطانها % % 2(@)(@@) % أظل نهاري في شمسها ، % شقيا ، معنى ببنيانها % % 3(@)(@@) % ولا أحد من ذوي قربتي % % يساعدني عند إتيانها % % 4(@)(@@) % أسود وجهي لتبييضها ، % وأهدم كيسي لعمرانها % % PageV01P898 البحر : كامل تام 1(@)(@@) % يا رب بيت زرته ، فكأنما % % قد ضمني من ضيقه سجن % 2(@)(@@) % لم يحسن الزمان جمع أحبة % في قشرة إلا كما نحن % PageV01P899 البحر : طويل 1(@)(@@) % غدا باحمرار الخد للحسن جامعا ، % ومن فيه للتبسم رضوانا % % 2(@)(@@) % فأبدى لنا من ثغره ورضابه % و عارضه راحا وروحا وريحانا % % PageV01P900 البحر : وافر تام 1(@)(@@) % إذا أحسست في خطي فتورا ، % وحظي والبلاغة والبيان % 2(@)(@@) % فلا ترتب بفهمي ، إن رقصي % % على مقدار وإيقاع الزمان % PageV01P901 البحر : رجز تام 1(@)(@@) % بت بجهد ساهر الأجفان ، % يلدغ جلدي شرر النيران % 2(@)(@@) % من طائر زمر في الآذان ، % من الدماء مترع ملآن % PageV01P902 البحر : طويل 1(@)(@@) % تلوم ، ودمعي واكف فوق قبره ، % أتدرين من هذا ؟ أتدرين من كانا ؟ % 2(@)(@@) % فتى مورقا بالبشر قبل عطائه ، % يباري من الراجين جودا وإحسانا % % 3(@)(@@) % دعيني أصف ، والغيث وابل كفه ، % و يبكي عليه الدهر سحا وتهتانا % % PageV01P903 البحر : رجز تام 1(@)(@@) % صبرا على الهموم والأحزان ، % و فرقة الأحباب والإخوان % 2(@)(@@) % فإن هذا خلق الزمان % . . . . . . . . . . . . . . . . . % PageV01P904 البحر : متقارب تام 1(@)(@@) % أقول ، وقد طال ليلي الذي % % علي ، فسامرت قلبا حزينا % % 2(@)(@@) % و مات ابن وهب خلي الخطوب ، % عوابث فيهن دنيا ودينا : % 3(@)(@@) % أيا دهر خلطت من بعده ، % كذا ينبغي بعده أن تكونا % % PageV01P905 البحر : وافر تام 1(@)(@@) % لقد أيسرت من هم وحزن ، % و بنت من السرور وبان مني % % 2 
ms155	(@)(@@) % و ولى قاسم عني حميدا ، % فيا رب اجزه ، يا رب ، عني % % PageV01P906 البحر : متقارب تام 1(@)(@@) % ذكرت ابن وهب ، فلله ما % % ذكرت ، وماغيبوا في الكفن % 2(@)(@@) % يقطر أقلامه من دم ، % و يعلم بالظن ما لم يكن % 3(@)(@@) % وظاهر أطرافه ساكن ، % ومن تحته حركات الفطن % PageV01P907 البحر : وافر تام 1(@)(@@) % ألم ترني سخطت على الزمان ، % و حسن الظن بالدنيا دهاني % % 2(@)(@@) % و لست من الشباب ، وليس مني ، % فقد أعطيت حابستي عناني % % PageV01P908 البحر : بسيط تام 1(@)(@@) % يا شاكي الدهر إن الدهر ألوان ، % فيه لصاحبه بؤس وأحزان % 2(@)(@@) % وفي الممات غنى للمرء يستره ، % و ليس مستغنيا ما عاش إنسان % PageV01P909 البحر : خفيف تام 1(@)(@@) % لست تنجو من كل ما حدت عنه ، % فاصحب الصبر دائما واتبعنه % 2(@)(@@) % و تيقظ ، إذا اضطررت إلى وص % % ل عدو ، ودم على الخوف منه % PageV01P910 البحر : كامل تام 1(@)(@@) % إصبر لعلك عن قليل بالغ % بتفضل الوهاب والإحسان % 2(@)(@@) % فرجا يضيء لك انفتاق صباحه ، % متبسلجا من ظلمة الإحسان % PageV01P911(@)(@@)(@@)(@@) | البحر : كامل تام 1(@)(@@) % وقف الشباب ، وأنت تابع غيه ، % لا ترعوي لنذير شيب قد نهى % % 2(@)(@@) % يا جهل قلب منك عطل حلمه ، % لو كان دانى غيه ، أو أشبها % % 3(@)(@@) % أمست بلاد الخوف تضرب بابها % % دوني ، وأمسى دونها لي منتهى % % 4(@)(@@) % خلت غليل الشوق بين جوانحي % % قطعا ، فعدت كيف كان ودلها % % 5(@)(@@) % أبلى الهوى والوجد سلك دموعه ، % فإذا نجي الفكر حركه وهى % % 6(@)(@@) % لا يستقر به مضاجع جنبه % حتى الصباح تقلبا وتأوها % % 7(@)(@@) % حظ مضى ما كنت أعرف قدره ، % حتى انتهى ، فعرفته ، حين انتهى % % 8(@)(@@) % أفنيته وسنان أخبط غمرة % بيدي ، فأنبهه الزمان ونبها % % 9(@)(@@) % لا مثل أيام مضين بلهوها ، % منكورة أعطت فؤادي ما اشتهى % % 10(@)(@@) % أيام عمري في سني ، ورتبتي % % مني ، وسلطاني على حدق المها % % PageV01P912 11(@)(@@) % و جهلت ما جهل الفتى زمن الصبا ، % فالآن قد وعظ المشيب وفوها % % 12(@)(@@) % فالآن قد كشف الزمان قناعه % % 13(@)(@@) % ولهوت من لهو النفوس بغادة % تحكي بنغمتها الحمام المولها % % 14(@)(@@) % و كأنها والشرب قد أذنوا لها ، % دنف أشار برأسه ، فتأوها % % 15(@)(@@) % ونذير 
ms156	 ناظرتين في أجفانها ، % لم تعرفا عنت الدموع فتمرها % % 16(@)(@@) % و كأن إبريق المدامة ، بيننا ، % ظبي على شرف أناف مدلها % % 17(@)(@@) % لما استحثته السقاة حنى لها ، % فبكى على قدح النديم ، وقهقها % % 18(@)(@@) % حسنات دهر قد مضين لذيذة ، % وبقيت معتل البقاء ، مولها % % 19(@)(@@) % يا من يشير إلى العداوة برده ، % إرجع بكيدك طائعا ، أو مكرها % % 20(@)(@@) % فطن إذا ما الذم قام خطيبه ، % فإذا خطيب الحمد أسمعه سها % % PageV01P913 21(@)(@@) % لا تخدعن بواعد لك نصرة ، % من سل سيفك للعقوق فقد وهى % % 22(@)(@@) % ولقد تكلف حاجتي عيدية ، % جنات قفر ينتهبن المهمها % % 23(@)(@@) % طارت بأجنحة القيود مدلة ، % في السير يخبطن الطريق الأفوها % % 24(@)(@@) % قب ، بناها النجم ، فهي عرائس ، % أشباه خلق ، لم تجاب الأفرها % % 25(@)(@@) % لما وردن الماء خلفن الصدى ، % وخرجن من سقم الهواجر نقها % % 26(@)(@@) % و لقد شهدت الحرب تلمع بيضها ، % ورأيت من غول المنايا أوجها % % 27(@)(@@) % ورأيت من عشراء دهر قسوة ، % وبلغت مأمول النعيم الأرفها % % 28(@)(@@) % و فعلت ما فعل الكرام ، وإنما % % أحظى الورى بالحمد إعطاء اللهى % % 29(@)(@@) % وفتقت أسماع الخصوم بحجة ، % بيضاء تبري بالبيان الأكمها % % 30(@)(@@) % إني ، إذا فطن الزمان ، لناطق ، % وسكت حين رأيت دهرا أبلها % % PageV01P914 البحر : منسرح 1(@)(@@) % لا ، والذي لا إله إلا هو ، % أنت بهذا علي تياه % 2(@)(@@) % ما لي ذنب سوى محاسنه ، % شاهدي الله ، حسبي الله % % 3(@)(@@) % لم تر عيني من قبله قمرا % % حكى هلال الدجى فاراه % PageV01P915 البحر : خفيف تام 1(@)(@@) % إن عيني قادت فؤادي إليها % % عبد شوق ، لا عبد رق لديها % % 2(@)(@@) % فهو بين الفراق والهجر موقو % % ف بحزن منها وحزن عليها % % PageV01P916 البحر : مجزوء الرمل 1(@)(@@) % قمر فوق قضيب ، % لا يرى العشاق تيها % % 2(@)(@@) % ما رأينا لشرير % قط في الناس شبيها % % 3(@)(@@) % دمعتي تعلم وجدي % % و اشتياقي ، فسليها % % 4(@)(@@) % لي من ذكرك مرآ % % ة أرى وجهك فيها % % PageV01P917 البحر : سريع 1(@)(@@) % يا ذا الذي تسخر عيناه ، % بي منك ما يعلمه الله % % 2(@)(@@) % إذا بدا يخطر في مجلس ، % فكم محب فيه يهواه % 3(@)(@@) % يسترزق الرحمن من فضله ، % و ما درى مولاه معناه % PageV01P918 البحر 
ms157	 : بسيط تام 1(@)(@@) % أفنى العداة إمام ما له شبه ، % ولا ترى مثله خلقا ولم نره % 2(@)(@@) % ضار إذاانقض لم تحرم مخالبه ، % مستوفز لانتباه الجزم منتبه % 3(@)(@@) % ما يحسن القطر أن ينهل عارضه % % كما تتابع أيام الفتوح له % PageV01P919 البحر : طويل 1(@)(@@) % ألا من لقلب في الهوى غير منته ، % و في الغي مطواع وفي الرشد مكره % 2(@)(@@) % أشاوره في توبة ، فيقول : لا ، % فإن قلت : تأتي فتنة ، قال : أين هي ؟ % 3(@)(@@) % و يا ساقيي اليوم عودا وثنيا % % بإبريق راح في الكؤوس مقهقه % 4(@)(@@) % أورث نفسي مالها قبل وارثي ، % وأنفقه فيما تحب وتشتهي % % PageV01P920 البحر : طويل 1(@)(@@) % إلى أي حين كنت في صبوة اللاهي ، % أما لك في شيء وعظت به ناه ؟ % 2(@)(@@) % ويا مذنبا يرجو من الله عفوه ، % أترضى بسبق المتقين إلى الله ؟ % PageV01P921 البحر : بسيط تام 1(@)(@@) % مسهد في ظلام الليل أواه ، % عضته للدهر أنياب وأفواه % % 2(@)(@@) % إن كان يخطىء سمعي ما أقدره % % فليس يخطئ ما قد قدر الله % PageV01P922(@)(@@)(@@)(@@) | (@)(@@) البحر : مجزوء الكامل 1(@)(@@) % يا صاحبي شيبت عفوا ، % و شربت بالتكدير صفوا % % 2(@)(@@) % وسقيت كاسات الهوى ، % فوجدتها مرا وحلوا % % 3(@)(@@) % ظبي يجاهر بالقلى ، % تيها على ذلي وقسوا % % 4(@)(@@) % شغل الفؤاد بكربة ، % قبضت عليه ، وصار خلوا % % 5(@)(@@) % واها لأيام الصبا ، % محيت من الآنام محوا % % 6(@)(@@) % أزمان أبلغ في المنى % % أقطارها مرحا ولهوا % % 7(@)(@@) % أيام تغفر زلتي ، % ويظن عمد الذنب سهوا % % 8(@)(@@) % يغدو علي بكأسه % رشأ مريض الطرف أحوى % % 9(@)(@@) % حشيت عقارب صدغه % بالمسك في خديه حشوا % % 10(@)(@@) % و كأنما أجفانه % تشكو إليك شكوا % % PageV01P923 11(@)(@@) % في فتية قدمتهم % قبلي ، وما استخلفت كفوا % % 12(@)(@@) % أمسوا جوى في القل % ب يحزنه وأحزانا وشجوا % % 13(@)(@@) % سل للمنازل سقية ، % و الربع والديرين أقوى % % 14(@)(@@) % حتى تظل بقاعه % شهبا ، منورة ، وحوا % % 15(@)(@@) % و يهز أجنحة النبا % % ت نسيمه ، ويحن زهوا % % 16(@)(@@) % من كل عيش قد أصب % % ت لذيذة ، وسلكت نحوا % % 17(@)(@@) % زمن الصبا ، ورددت ك % فا بعده وقصرت خطوا % % 18(@)(@@) % سل المشيب سيروفه ، % فسطا على اللذات سطوا % % 19(@)(@@) % حتى انثنت حمة الشبا % % ب 
ms158	 كليلة ، وصحوت صحوا % % 20(@)(@@) % ولقد لقيت عظيمة % محذورة وحملت عبوا % % PageV01P924 21(@)(@@) % و رفلت في قمص الحدي % % د ، وما أرى في الليل ضوا % % 22(@)(@@) % بشملة جوالة ، % تنضو مطايا الركب نضوا % % 23(@)(@@) % رحلت بها همم امرىء ، % ومقامها في الهم أسوا % % 24(@)(@@) % أومى إليها بالزما % % م ، فلم تدع للسطو عدوا % % 25(@)(@@) % و لقد فضضت عن الصبا % % ح ظلامه سحرا وغدوا % % 26(@)(@@) % بمخنث ذي ميعة % ينزو أمام الخيل نزوا % % 27(@)(@@) % في أثر سارية تبطن % نورها خفضا وربوا % % 28(@)(@@) % نحرت على حر الثرى % % بسقات وابلها ، فأروى % % PageV01P925 البحر : مجزوء الوافر 1(@)(@@) % أللمنزل بالحنو ، % و مغنى الطلل النضو % 2(@)(@@) % و أحجار كأخلال % مقيمات على بو % % 3(@)(@@) % تصابيت ، وقد أرهق % % ت عزم الدين والصحو % 4(@)(@@) % على حين ابيضاض الرأ % % س واللوم على الهفو % 5(@)(@@) % ورد الشيب بالخضب ، % و ما للشيب من رفو % 6(@)(@@) % صنعنا للملمات % شديدا صادق العدو % 7(@)(@@) % يروى لبن الكرم ، % و لا يطوى على حقو % 8(@)(@@) % فلما فلق الردف % بنحض حسن النجو % 9(@)(@@) % عصرناه بتضمين % كعصر الحبل بالصغو % 10(@)(@@) % طمرا يؤنس الفار % % س من أين ومن كبو % PageV01P926 11(@)(@@) % يطير بالحديدات % سبوحا مرح الخطو % 12(@)(@@) % من الخيل العتاق القو % % د يتلوها على حذو % % 13(@)(@@) % نواصيهن كالسعفا % % ت ، والأذناب كالسرو % 14(@)(@@) % ولكن رب مطروح % مليح الدل والزهو % 15(@)(@@) % خلا عن كل تشبيه % تسامى نفسه نحوي % % 16(@)(@@) % تجاسرت عليه ري % % ثما يجسر ذو الشجو % % 17(@)(@@) % و خلفت عروس النو % % م والأحلام للخلو % 18(@)(@@) % فأديت إلى بدر % ملا عيني من الضو % 19(@)(@@) % و بتنا بأكف الخو % % ف نجني ثمر اللهو % 20(@)(@@) % و سقتني ثناياه % عقارا من فم حلو % PageV01P927 21(@)(@@) % غزال مخطف الكشح ، % لطيف الخصر والحقو % 22(@)(@@) % وقد نضجت ثمار بنا % % ن من القنو % 23(@)(@@) % ألا يا أيها الموعد % قصر خطوة النحو % 24(@)(@@) % و لا تنفث إلى الغي % % ظ ، فما أملك بالسطو % 25(@)(@@) % و أعطيني على كره ، % وخذ مني على عفو % PageV01P928(@)(@@)(@@)(@@) | (@)(@@) البحر : خفيف تام 1(@)(@@) % صاح بالوعظ شيب رأس مضي ، % حثني للتقى ، وقلبي بطي % 2(@)(@@) % وأراني وجه المنية من قر % % ب 
ms159	 ، ولكنني عليها جري % 3(@)(@@) % سحرتني الدنيا ، وعادات لذا % % تي ، فجسمي كهل ، وقلبي صبي % 4(@)(@@) % أصرع العقل بالهوى ، فسراج ال % % رشد ، من تحت ، بالظلام خفي % 5(@)(@@) % تركتني عين الخلي لما بي ، % وتمطى علي ليل قسي % 6(@)(@@) % غير ليلاتي القديمة إذ ده % % ري غر بالحادثات غبي % 7(@)(@@) % وغصون الدنيا قريب جناها ، % وغدير الحياة صاف هني % 8(@)(@@) % لم تزل بالرحيل دار سليمى ، % يتهادى بها المها الوحشي % 9(@)(@@) % مشعلات مثل الفساطيط قدر % كز فيها الصعاد والخطي % 10(@)(@@) % ومن العفر بارح وسنيح ، % جامد الظلف ، قرنه ملوي % PageV01P929 11(@)(@@) % و ثلاث حنت لنوء رماد ، % يأكل الصبح جمره ، والعشي % 12(@)(@@) % فهي للريح كل يوم ، وللقط % % ر ، غريب في ربعها الإنسي % 13(@)(@@) % كل دار لها وظيفة دمع % من جفوني حتى تكل المطي % 14(@)(@@) % عاقبتني شرير بالصد ، والهج % % ر ، وتحت العقاب قلب جري % 15(@)(@@) % و تعجبت من معاشر دسوا % % لي شرا ، والله كاف علي % 16(@)(@@) % حذرا أيها الحسود فلا تغ % % فر للحمي ، فإن لحمي وبي % 17(@)(@@) % أنا جاه الناس الذي يحمل الع % بء ويمرى به الزمان البكي % 18(@)(@@) % ساحب ذيل جحفل يملأ الأر % % ض ، كما عم حافتيه الأتي % 19(@)(@@) % راجح بي ميزان ملك ومجد ، % ليس فيه من الأنام كفي % 20(@)(@@) % ثم ظني بأن ما يسعد العا % % قل والحاسد المعنى الشقي % PageV01P930 21(@)(@@) % ضن عني فلم يضرني حسودي ، % وحباني رب علي ، سخي % 22(@)(@@) % و فلاة عمياء يردى بها السف % % ر ، خلاء ، يهابها الجني % 23(@)(@@) % تقف العصف الزعازع فيها ، % و لها قبلها جناح سري % 24(@)(@@) % قد تجاوزتها ، وتحتي سبوح ، % ذو مطار في عدوه مهري % 25(@)(@@) % و يمد الزمام منه بجزع % مثل ما مد حية مطوي % 26(@)(@@) % كابن قفر أصاب غيثا خلاء ، % جاده صوب وابل وسمي % 27(@)(@@) % و أجادت بلاده بنبات % عرقه بارد الشراب غني % 28(@)(@@) % قاعدا في الثرى يطير ساقا ، % يتمشى فيها شباب وري % 29(@)(@@) % و له ، كلما تغلغل في الأر % % ض ، فراش من التراب وطي % % 30(@)(@@) % فخلا منه آمنا باغي الطل % % ع ، وله مشرب ، وبقل جني % PageV01P931 31(@)(@@) % شاحج ، يرفع النهيق كما غ 
ms160	 % رد حاد بأينق نجدي % PageV01P932 البحر : طويل 1(@)(@@) % بليت ، ومل العائدون ، ورابني % % تزايد أدوائي ، وفقد دوائيا % % 2(@)(@@) % و عطل من نفسي مكان رجائها ، % فإن لم يكن موت ، فكالموت ما بيا % % 3(@)(@@) % فيا أهل بيت الله من آل هاشم ، % أقروا برزئي ، أو فسدوا مكانيا % % 4(@)(@@) % يجرحه قوم ، ويرجون عفوه ، % فكيف ، وآلام بجسمي كما هيا ؟ % PageV01P933 البحر : - 1(@)(@@) % أسر القلب ، فأمسى لديه ، % فهو يشكوه إليه % 2(@)(@@) % خلع الحسن على وجنتيه ، % ورقى هاروت في مقلتيه % 3(@)(@@) % ليس لي صبر ، ولا أدعيه ، % يشهد الدمع دما شائليه % 4(@)(@@) % لو رأى العذال ما بقلبي لم % % يجدوا ، والله ، غيرك فيه % 5(@)(@@) % لا أقول البدر أنت ، ولا % % غصن بان أنت لا أشتهيه % PageV01P934 البحر : سريع 1(@)(@@) % يا جافيا مستعجلا بالقلى ، % لم يبق لي من بعده باقيه % % 2(@)(@@) % قد كان لي ، فيما مضى ، واصلا ، % فقد دهتني عنده داهيه % % 3(@)(@@) % وطالما استسقيت من ريقه ، % و كم له من زورة خافيه % % 4(@)(@@) % و غمزة من كفه كلما % % صافحته نافعة شافيه % % 5(@)(@@) % حبك لي في سقم دائم ، % لكن حبي لك في عافيه % % PageV01P935 البحر : مخلع البسيط 1(@)(@@) % يا عين لا تغلبي عليه ، % وارعي رياضا بوجنتيه % 2(@)(@@) % عودي إليه ، إليه عودي ، % فمنذ أطرقت لم تريه % PageV01P936 البحر : مخلع البسيط 1(@)(@@) % يا بديعا بلا شبيه ، % و يا حقيقا بكل تيه % 2(@)(@@) % و من جفاني ، فلا أراه ، % هب لي رقادا أراك فيه % % PageV01P937 البحر : وافر تام 1(@)(@@) % قلوب الناس أسرى في يديه ، % و ثوب الحسن مخلوعا عليه % 2(@)(@@) % أسير ، إذا بليت وذاب جسمي ، % لعل الريح تسعى بي إليه % PageV01P938 البحر : خفيف تام 1(@)(@@) % كم صنيع شكرته لبني وه % % ب بدا لي ، وما اهتديت إليه % 2(@)(@@) % و عدو يريد قتلي ، ولكن % % يد صنع منهم ترد يديه % 3(@)(@@) % رب عذر أبيتم وعبتم ، % ووفاء مر صبرتم عليه % PageV01P939 البحر : - 1(@)(@@) % يا رب أبيق ولي دولة هاشم ، % واجعل عليه من المكاره واقيا % % 2(@)(@@) % من أين مثلك لا أراه باقيا ، % فيما يكون ، ولا راه ماضيا % 3(@)(@@) % وكأنما سامى أباه وجده ، % إذا لم يجد في العالمين مساميا % % 4(@)(@@) % كانا 