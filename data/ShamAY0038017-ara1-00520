ms501	 القرشي(@)(@@) يروي عن: أبي عبيدة بن الجراح، وخالد بن الوليد، روى عمرو بن دينار، عن أبي نجيح، عنه.(@)(@@)(@@)(@@) ||| AUTO خالد بن المهاجر بن خالد بن الوليد بن المغيرة المخزومي القرشي(@)(@@) حجازي، يروي عن: ابن عباس، روى عنه: الزهري، ومحمد بن أبي بكر.(@)(@@)(@@)(@@) ||| AUTO خالد بن الوليد السكسكي(@)(@@) أدرك الجاهلية، عداده في أهل الشام، يروي المراسيل، روى عنه: يحيى بن الضحاك.(@)(@@)(@@)(@@) ||| AUTO خالد بن سعد الكوفي(@)(@@) يروي عن: أبي مسعود الأنصاري، روى عنه: إبراهيم النخعي، ومنصور، وكان مولى لأبي مسعود الأنصاري.(@)(@@)(@@)(@@) ||| AUTO خالد بن أسلم(@)(@@) أخو زيد بن أسلم، مولى عمر بن الخطاب، يروي عن: ابن عمر، روى عنه: الزهري، وزيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO خالد بن أبي أيوب الأنصاري(@)(@@) يروي عن: أبيه، روى عنه: أيوب بن خالد.(@)(@@)(@@)(@@) ||| AUTO خالد بن زيد بن جارية(@)(@@) يروي عن: ابن عمر، روى عنه: سفيان الثوري.(@)PageV01P002(@)(@@) [ج 2: ص 115](@)(@@)(@@)(@@) ||| AUTO خالد بن الربيع العبسي(@)(@@) يروي عن: حذيفة، روى عنه: أبو وائل.(@)(@@)(@@)(@@) ||| AUTO خالد بن أيمن المعافري، ويقال: المعاوري(@)(@@) يروي المراسيل، روى عنه: عمرو بن شعيب.(@)(@@)(@@)(@@) ||| AUTO خالد بن الحويرث القرشي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: علي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO خالد بن الربيع العتكي(@)(@@) يروي عن: حذيفة بن اليمان، روى عنه: أبو وائل.(@)(@@)(@@)(@@) ||| AUTO خالد بن أبي أمية(@)(@@) يروي عن: عمرو بن حريث، عداده في أهل الكوفة، روى عنه: الصباح.(@)(@@)(@@)(@@) ||| AUTO خالد بن ربعي الأسدي(@)(@@) كوفي، يروي عن: ابن مسعود، روى عنه: عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO خالد بن جرير بن عبد الله البجلي(@)(@@) يروي عن: جرير بن عبد الله، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO خالد بن يسار(@)(@@) أخو صدقة بن يسار، يروي المقاطيع، يروي عن: ابن عقيل، وغيره، روى عنه: موسى بن عبيدة الربذي.(@)(@@)(@@)(@@) ||| AUTO أبو خلدة، اسمه خالد بن دينار السعدي الخياط(@)(@@) يروي عن: أنس بن مالك، روى عنه: وكيع، وكان ابن مهدي يحسن الثناء عليه.(@)PageV01P002(@)(@@) [ج 2: ص 116](@)(@@)(@@)(@@) ||| AUTO خالد بن أبي حيان(@)(@@) مولى هزيلة، امرأة من بني دينار ولدت 
ms502	 في بني سلمة بالمدينة، يروي عن: جابر، روى عنه: يعقوب بن محمد بن طحلاء.(@)(@@)(@@)(@@) ||| AUTO خالد الربعي(@)(@@) يروي عن: أنس بن مالك، روى عنه: هشام بن حسان، وأبو الأشهب، وحميد الكندي العنبري.(@)(@@)(@@)(@@) ||| AUTO خالد بن مضرب العبدي(@)(@@) كوفي، يروي عن: ابن أبي أوفى، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO خالد بن خالد بن عمرو بن حريث(@)(@@) يروي عن: جده عمرو بن حريث، روى عنه: ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO خالد بن دينار(@)(@@) يروي عن: ابن عباس، روى عنه: العلاء بن المسيب.(@)(@@)(@@)(@@) ||| AUTO خالد بن جبر(@)(@@) يروي عن: ابن عمر، روى عنه: جعفر بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO خالد بن خلاد النجاري الأنصاري المدني(@)(@@) يروي عن: أنس بن مالك، وهو الذي يقال له: خلاد بن خلاد، روى عنه: عمرو بن يحيى المازني.(@)(@@)(@@)(@@) ||| AUTO خالد بن نشيط أبو العريان(@)(@@) يروي عن: أنس بن مالك والحسن، روى عنه: مروان الفزاري.(@)(@@)(@@)(@@) ||| AUTO خالد بن رافع(@)(@@) يروي المراسيل، روى عنه: مالك بن عبد.(@)(@@)(@@)(@@) ||| AUTO خالد بن زيد المزني(@)(@@) يروي عن: أبي موسى، روى عنه: أبو حبيب.(@)(@@)(@@)(@@) ||| AUTO خالد بن جابر بن سمرة العامري السوائي(@)(@@) يروي عن: أبيه، روى عنه: ابنه حرب بن خالد.(@)PageV01P002(@)(@@) [ج 2: ص 117](@)(@@)(@@)(@@) ||| AUTO خالد بن دريك(@)(@@) يروي عن: عمران بن حصين، روى عنه: أسيد بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO خالد بن حيي(@)(@@) مولى عثمان بن عفان، يروي عن: أبي هريرة، روى عنه: زيد بن واقد.(@)(@@)(@@)(@@) ||| AUTO خالد بن يزيد(@)(@@) يروي عن: العرباض بن سارية، روى عنه: سفيان بن حسين.(@)(@@)(@@)(@@) ||| AUTO خالد بن سعيد بن أبي سعيد المدني(@)(@@) يروي عن: جده أبي سعيد، روى عنه: داود بن صالح.(@)(@@)(@@)(@@) ||| AUTO خالد بن زيد بن حارثة الأنصاري(@)(@@) يروي عن: ابن عمر، روى عنه: معتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO خالد بن زيد الأنصاري(@)(@@) أدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم منهم أنس بن مالك، ويرسل الأخبار كثيرا، روى عنه: مجمع بن يحيى.(@)(@@) (122) -[2: 117] ثنا أبو يعلى، قال: ثنا إبراهيم بن الحجاج، قال: ثنا ابن المبارك، عن مجمع بن يحيى الأنصاري، 
ms503	 قال: حدثني عمي خالد بن زيد، قال: قال رسول الله صلى الله عليه وسلم: " برئ من الشح من أدى الزكاة، وقرى الضيف، وأعطى في النائبة ". مرسل(@)(@@)(@@)(@@) ||| AUTO خالد بن عبيد بن سارة المخزومي المكي(@)(@@) يروي عن: عبد الله بن جعفر، وعبد الله بن عمر، روى عنه: عطاء وابنه جعفر بن خالد، وهو الذي يقال له: خالد بن سارة، نسب إلى جده.(@)(@@)(@@)(@@) ||| AUTO خالد السبائي(@)(@@) يروي عن: ابن عباس، روى عنه: يونس بن أبي إسحاق.(@)(@@)(@@)(@@) ||| AUTO خالد بن غلاق، أبو حسان العيشي(@)(@@) من تيم الله بن ربيعة، يروي عن: أبي PageV01P002 [ج 2: ص 118] هريرة، روى عنه: الجريري.(@)(@@)(@@)(@@) ||| AUTO (123) -[2: 118] ثنا عبد الله بن محمد، قال: ثنا إسحاق بن إبراهيم، قال: ثنا المخزومي، قال: ثنا وهيب، قال: ثنا أبو مسعود وهو سعيد بن إياس الجريري، عن خالد القيسي، قال: قلت: يا أبا هريرة، هل سمعت من خليلك شيئا تطيب به أنفسنا، فقال: نعم، سمعته يقول: " صغاركم دعاميص الجنة ". قال المخزومي: الصغار: الأطفال، والدعاميص يكون في أسفل الجب(@)(@@)(@@)(@@) ||| AUTO خالد بن سبيع(@)(@@) يروي عن: حذيفة، روى عنه: صخر بن بدر.(@)(@@)(@@)(@@) ||| AUTO خالد بن سيحان(@)(@@) بصري، شهد تستر مع أبي موسى، روى عنه: العوام بن مزاحم، والعوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO خالد بن عبد الله بن الحسين القرشي(@)(@@) مولى عثمان بن عفان، عداده في أهل الشام، يروي عن: أبي هريرة، روى عنه: زيد بن واقد، وإسماعيل بن عبيد الله بن أبي المهاجر.(@)(@@) (124) -[2: 118] ثنا عمرو بن محمد الهمداني، ثنا عمرو بن عثمان بن سعيد، ثنا الوليد بن مسلم، عن سعيد بن عبد العزيز، عن إسماعيل بن عبيد الله بن أبي المهاجر، عن خالد بن عبد الله بن حسين، عن أبي هريرة، قال: " ما رأيت أحدا أكثر أن يقول: أستغفر الله وأتوب إليه من رسول الله صلى الله عليه وسلم "(@)(@@)(@@)(@@) ||| AUTO خالد بن سلمة المخزومي(@)(@@) والد عكرمة، ومحمد، يروي عن: ابن عمر، روى عنه: ابنه محمد.(@)(@@) خالد(@)(@@) شيخ، يروي عن: أبي هريرة، روى عنه: سالم بن غيلان.(@)(@@)(@@)(@@) ||| AUTO خالد 
ms504	 بن سمير السدوسي(@)(@@) بصري، يروي عن: ابن عمر وأنس بن مالك، روى عنه: الأسود بن شيبان.(@)PageV01P002(@)(@@) [ج 2: ص 119](@)(@@)(@@)(@@) ||| AUTO خالد بن عبد الله بن رباح(@)(@@) يروي عن: معاوية، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO خالد بن عمير العدوي(@)(@@) يروي عن: عتبة بن غزوان، عداده في أهل البصرة، روى عنه: حميد بن هلال وأبو نعامة.(@)(@@)(@@)(@@) ||| AUTO خالد بن عرعرة التيمي(@)(@@) يروي عن: علي، روى عنه: سماك بن حرب والقاسم بن عوف.(@)(@@)(@@)(@@) ||| AUTO خالد بن أبي عثمان(@)(@@) يروي عن: أبي الطفيل، روى عنه: يعقوب بن إسحاق الحضرمي.(@)(@@)(@@)(@@) ||| AUTO خالد العماني(@)(@@) يروي عن: عائشة، روى عنه: يزيد العبدي.(@)(@@)(@@)(@@) ||| AUTO خالد بن اللجلاج أبو إبراهيم العامري(@)(@@) أخو العلاء بن اللجلاج، عداده في أهل الشام، كان من أفاضل أهل زمانه، يروي عن: عمر بن الخطاب، وأبيه، وعبد الرحمن بن عائش، روى عنه: مكحول، وعبد الرحمن بن يزيد بن جابر.(@)(@@)(@@)(@@) ||| AUTO خالد بن معتب(@)(@@) يروي عن: أنس بن مالك، روى عنه: شيبة بن نصاح.(@)(@@)(@@)(@@) ||| AUTO خالد بن الواشمة(@)(@@) يروي عن: عائشة، روى عنه: بجير بن أوس.(@)(@@)(@@)(@@) ||| AUTO خالد بن كيسان(@)(@@) يروي عن: الربيع بنت معوذ بن عفراء، روى عنه: عيسى بن يزيد أبو معاذ.(@)PageV01P002(@)(@@) [ج 2: ص 120](@)(@@)(@@)(@@) ||| AUTO خالد بن عبد الله بن أسيد(@)(@@) وأدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الزهري، وهو الذي يروي عن: قبيصة بن ذؤيب.(@)(@@)(@@)(@@) ||| AUTO خالد بن محدوج الواسطي، أبو روح(@)(@@) يروي عن: أنس بن مالك، روى عنه: أبو أسامة.(@)(@@)(@@)(@@) ||| AUTO خالد بن رباح الأنصاري(@)(@@) يروي عن: أبي قتادة، روى عنه: ثابت البناني.(@)(@@)(@@)(@@) ||| AUTO خالد بن محمد بن عبد الله(@)(@@) يروي عن: معاوية، وابن الزبير، وأم سلمة، روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO خالد بن الفرز(@)(@@) يروي عن: أنس بن مالك، روى عنه: الحسن بن صالح بن حي.(@)(@@)(@@)(@@) ||| AUTO خالد بن وهبان(@)(@@) بن خالة أبي ذر الغفاري، يروي عن: أبي ذر، روى عنه: الناس.(@)(@@)(@@)(@@) ||| AUTO خالد بن كيسان(@)(@@) يروي عن: ابن عمر، وابن الزبير، روى عنه: أيوب بن ثابت.(@)(@@)(@@)(@@) ||| AUTO 
ms505	 خالد بن ذكوان أبو الحسن المديني، وقد قيل: أبو حسين(@)(@@) سكن البصرة، يروي عن: الربيع بنت معوذ بن عفراء ولها صحبة، روى عنه: حماد بن سلمة، وبشر بن المفضل وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO خالد بن أبي مسلم الطائفي(@)(@@) عن: عبد الله بن عمرو، روى عنه: يعلى بن عطاء، والنعمان بن سالم.(@)PageV01P002(@)(@@) [ج 2: ص 121](@)(@@)(@@)(@@) ||| AUTO خالد بن يزيد أبو عبد الرحمن(@)(@@) يروي عن: المغيرة بن شعبة، ومعاوية، روى عنه: معاوية بن صالح، والناس.(@)(@@)(@@)(@@) ||| AUTO خالد بن مساور(@)(@@) يروي عن: أبي هريرة، روى عنه: شعيب بن الحبحاب، وقد قيل: خالد بن يسار.(@)(@@)(@@)(@@) ||| AUTO خالد الجدلي(@)(@@) كوفي، يروي عن: جابر بن سمرة، روى عنه: ابنه معبد بن خالد.(@)(@@)(@@)(@@) ||| AUTO خلاد بن السائب بن خلاد الأنصاري(@)(@@) من بلحارث بن الخزرج، يروي عن: أبيه، روى عنه: عطاء بن يسار، وقتادة، وهو خلاد بن السائب بن خلاد بن سويد بن ثعلبة بن عمرو بن حارثة بن امرئ القيس بن ثعلبة بن الخزرج، أمه مارية بنت الحارث بن سلامان، من أزد شنوءة.(@)(@@)(@@)(@@) ||| AUTO خلاد بن خلاد الأنصاري(@)(@@) يروي عن: أنس بن مالك، روى عنه: عمرو بن يحيى الأنصاري.(@)(@@)(@@)(@@) ||| AUTO خلاد بن السائب الجهني(@)(@@) يروي عن: أبيه، روى عنه: الزهري، وقتادة، ويحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO خليفة بن كعب التميمي، أبو ذبيان(@)(@@) بصري، يروي عن: ابن الزبير، روى عنه: جعفر بن ميمون.(@)(@@)(@@)(@@) ||| AUTO خليفة الواسطي(@)(@@) مولى أشجع، يروي عن: أسماء بنت أبي بكر، روى عنه: ابنه خلف بن خليفة.(@)PageV01P002(@)(@@) [ج 2: ص 122](@)(@@)(@@)(@@) ||| AUTO خليفة(@)(@@) مولى عمرو بن حريث القرشي، يروي عن: عمرو بن حريث، روى عنه: ابنه فطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO خليفة بن حصين بن قيس بن عاصم المنقري(@)(@@) يروي عن: جماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل الكوفة، روى عنه: الأغر.(@)(@@)(@@)(@@) ||| AUTO خليفة بن أبي حبيب(@)(@@) أخو يزيد بن أبي حبيب، يروي عن: جماعة من التابعين، روى عنه: حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO خليفة بن قيس(@)(@@) مولى خالد بن عرفطة، حليف بني زهرة، يروي عن: خالد 
ms506	 بن عرفطة، عداده في أهل الكوفة، روى عنه: عبد الرحمن بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO خليفة بن عبد الله الغبري(@)(@@) يروي عن: عائذ بن عمرو، روى شعبة، عن بسطام، عنه.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO خليد بن سعد(@)(@@) مولى أبي الدرداء، عداده في أهل الشام، يروي عن: أبي الدرداء، روى عنه: طلحة بن نافع، كان يسكن بيت المقدس.(@)(@@)(@@)(@@) ||| AUTO خليد بن عبد الله العصري البصري(@)(@@) أبو سليمان العبدي، عداده في أهل البصرة، يروي عن: أبي الدرداء، روى عنه: قتادة، ويقال: إن هذا مولى لأبي الدرداء، وهو الذي يروي عن: الأحنف بن قيس.(@)(@@)(@@)(@@) ||| AUTO خليد الثوري(@)(@@) يروي عن: علي، وعمار، روى عنه: نسير بن ذعلوق، عداده في أهل الكوفة.(@)(@@) خليد(@)(@@) يروي عن: ابن عمر، روى عنه: السدي، أحسبه الأول.(@)PageV01P002(@)(@@) [ج 2: ص 123](@)(@@)(@@)(@@) ||| AUTO خطاب بن خفاف، أبو جويرية الجرمي اليماني(@)(@@) يروي عن: ابن عباس، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO خطاب بن جبير بن حية الثقفي البصري(@)(@@) يروي عن: عمر، روى عنه: ابنه محمد بن خطاب.(@)(@@)(@@)(@@) ||| AUTO خارجة بن زيد بن ثابت الأنصاري المدني، كنيته أبو زيد(@)(@@) من فقهاء المدينة من السبعة، يروي عن: أبيه، وهو أخو إسماعيل بن زيد، روى عنه: الزهري، وأبو الزناد، مات سنة تسع وتسعين، وقد قيل: سنة مائة، وهو ابن سبعين سنة.(@)(@@)(@@)(@@) ||| AUTO خارجة بن الصلت بن صحار التميمي(@)(@@) عن: عمه، روى عنه: الشعبي، واسم عمه علاقة بن صحار السليطي، وسليط من تميم.(@)(@@)(@@)(@@) ||| AUTO خارجة بن الصلت البرجمي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO خارجة بن العوام(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه.(@)(@@)(@@)(@@) ||| AUTO خبيب بن عبد الله بن الزبير بن العوام(@)(@@) يروي عن: أبيه، روى عنه: ابنه الزبير بن خبيب، مات سنة ثلاث وتسعين، قبل أن يستخلف عمر بن عبد العزيز، أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام المخزومي.(@)(@@)(@@)(@@) ||| AUTO خرشة بن الحر الفزاري(@)(@@) أخو سلامة بن الحر، عداده في PageV01P002 [ج 2: ص 124] أهل الكوفة، وكان يتيما في حجر عمر، يروي عن: ابن عمر، وأبي ذر، روى عنه: 
ms507	 سليمان بن مسهر الفزاري، مات سنة أربع وسبعين في ولاية بشر بن مروان على العراق.(@)(@@)(@@)(@@) ||| AUTO خرشة بن حبيب السلمي(@)(@@) أخو أبي عبد الرحمن السلمي، يروي عن: علي بن أبي طالب، روى عنه: هلال بن يساف.(@)(@@)(@@)(@@) ||| AUTO خثيم بن عمرو(@)(@@) يروي عن: ابن مسعود، روى عنه: حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO خثيم بن مروان(@)(@@) يروي عن: أبي هريرة، روى عنه: كلثوم بن جبر، ويقال: ابن مرزوق.(@)(@@)(@@)(@@) ||| AUTO خثيم بن مروان بن قيس السلمي(@)(@@) يروي عن: عمر بن الخطاب، روى يحيى بن سعيد الأنصاري، عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO خثيم بن القارة المكي(@)(@@) جد عبد الله بن عثمان بن خثيم، يروي عن: عمر، روى عنه: عياض بن وهب بن عبيد الله بن أبي حبيبة.(@)(@@)(@@)(@@) ||| AUTO خضير السلمي(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: عمير بن هانئ.(@)(@@)(@@)(@@) ||| AUTO خضير بن الأسود(@)(@@) يروي عن: أبي أمامة الباهلي، روى عنه: عبد الرحمن بن سوار الهلالي.(@)(@@)(@@)(@@) ||| AUTO أبو راشد الحبراني(@)(@@) من أهل الشام، وقد قيل: إن اسمه خضر بن خرط، فإن صح ذلك فهو غريب، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO خباب(@)(@@) يروي عن: أبي بكر، روى عنه: ابنه عطاء بن خباب.(@)(@@)(@@)(@@) ||| AUTO خنيس بن عبد الرحمن بن نعيم الغفاري(@)(@@) يروي عن: عبد الله بن سلام، روى عنه: قيس بن عبد الملك.(@)PageV01P002(@)(@@) [ج 2: ص 125](@)(@@)(@@)(@@) ||| AUTO خيثمة بن عبد الرحمن بن أبي سبرة الجعفي الكوفي(@)(@@) واسم أبي سبرة يزيد بن مالك، يروي عن: علي، وعبد الله بن عمرو، وابن عمر، روى عنه: الأعمش، ومنصور، مات قبل أبي وائل.(@)(@@) (125) -[2: 125] ثنا محمد بن إسحاق الثقفي، قال: ثنا عقبة بن مكرم، قال: ثنا مسلم بن قتيبة، عن شعبة، عن نعيم بن أبي هند، قال: رأيت أبا وائل " في جنازة خيثمة على حمار يبكي، واضعا يده على رأسه، يقول: واعيشاه، واعيشاه "(@)(@@)(@@)(@@) ||| AUTO خيثمة بن مالك(@)(@@) عن: أبي الدرداء، روى عنه: أبو بكر بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO خيثمة بن أبي خيثمة البصري(@)(@@) يروي عن: أنس، روى عنه: بشير بن سلمان والأعمش ومنصور. 
ms508	(@)(@@)(@@)(@@) ||| AUTO خمير أبو مالك الحميري(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: عبد الكريم بن الحارث.(@)(@@)(@@)(@@) ||| AUTO خمير بن مالك(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي، وعبد الله بن عيسى.(@)(@@)(@@)(@@) ||| AUTO خازم بن القاسم البصري(@)(@@) يروي عن: أبي عسيب، روى عنه: موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO خشف بن مالك الطائي(@)(@@) عداده في أهل الكوفة، يروي عن: عمر، وابن مسعود، روى عنه: زيد بن جبير الطائي.(@)PageV01P002(@)(@@) [ج 2: ص 126](@)(@@)(@@)(@@) ||| AUTO خداش بن إسماعيل الكوفي(@)(@@) شهد الجمل، روى عنه: محمد بن سواء.(@)(@@)(@@)(@@) ||| AUTO خزيمة بن ثابت بن خزيمة بن ثابت(@)(@@) يروي عن: جده، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO خميل(@)(@@) يروي عن: نافع بن عبد الحارث، روى عنه: حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO خزاعي بن زياد بن عبد الله بن المغفل(@)(@@) بصري، يروي عن: عبد الله بن مغفل، روى عنه: الهيثم بن جهم المؤذن.(@)(@@)(@@)(@@) ||| AUTO خطاف مولى لعثمان بن أبي العاص(@)(@@) روى عنه: المبارك بن فضالة.(@)(@@)(@@)(@@) ||| AUTO خيار بن سلمة أبو زياد(@)(@@) عداده في أهل الشام، يروي عن: عائشة، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO خصيلة بنت واثلة بن الأسقع(@)(@@) تروي عن أبيها، روى عنها: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO خالدة بنت طلق(@)(@@) تروي عن أبيها، قال: أتينا النبي صلى الله عليه وسلم فبايعناه، روى عنها: سراج بن عقبة بن طلق بن علي.(@)(@@)(@@)(@@) ||| AUTO خيرة(@)(@@) مولاة أم سلمة، والدة الحسن بن أبي الحسن، يروي عنها: ابنها الحسن بن أبي الحسن، عن أم سلمة في عمار: " تقتلك الفئة الباغية ".(@)(@@)(@@)(@@) || AUTO باب الدال(@)(@@) قام أبو حاتم:(@)(@@) وممن روى من الصحابة، وشافههم ممن ابتدأ اسمه على الدال:(@)(@@)(@@)(@@) ||| AUTO داود بن كردوس الثعلبي(@)(@@) يروي عن: عمر بن الخطاب، عداده في أهل الكوفة، روى عنه: السفاح بن مطر.(@)PageV01P002(@)(@@) [ج 2: ص 127](@)(@@)(@@)(@@) ||| AUTO داود بن فراهيج(@)(@@) مولى بني قيس بن الحارث بن فهر، أصله من المدينة، قدم البصرة وحدثهم بها، يروي عن: أبي هريرة، وأبي سعيد، روى عنه: شعبة، والناس.(@)(@@)(@@)(@@) ||| AUTO داود بن خيثمة(@)(@@) يروي عن: أبي موسى، روى عنه: شبيب 
ms509	 بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO داود بن محمد بن نجيح(@)(@@) يروي عن: أبي هريرة، روى عنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO داود بن إسماعيل الأنصاري(@)(@@) من أهل المدينة، يروي عن: ابن عمر، روى عنه: عاصم بن سويد الأنصاري وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO داود بن أبي عاصم بن عروة بن مسعود بن معتب بن مالك بن عمرو بن كعب بن سعد بن عوف بن ثقيف الثقفي الحجازي(@)(@@) يروي عن: ابن عمر، روى عنه: يعقوب بن عطاء، ويزيد بن أبي زياد، وهو الذي يقال له: داود بن عاصم، أمه أم حبيبة بنت أمية بن زيد بن حلس من بني الحارث بن عبد مناة بن كنانة.(@)(@@)(@@)(@@) ||| AUTO داود الغفاري(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO داود السراج الثقفي(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO داود بن إسماعيل بن مجمع(@)(@@) يروي عن: ابن عمر، روى عنه: عاصم بن سويد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO داود بن سليمان أبو اليمان الخشك(@)(@@) كوفي، يروي عن: ابن أبي أوفى، روى عنه: عبد الله بن نمير، ومروان بن معاوية.(@)PageV01P002(@)(@@) [ج 2: ص 128](@)(@@)(@@)(@@) ||| AUTO داود بن عامر المازني الأنصاري(@)(@@) وهو الذي يقال له: داود بن أبي داود، يروي المراسيل، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO دينار أبو عبد الله القراظ(@)(@@) مولى خزاعة، من أهل المدينة، يروي عن: سعد بن أبي وقاص، وأبي هريرة، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO دينار الكوفي(@)(@@) يروي عن: عمرو بن الحارث بن المصطلق، روى عنه: ابنه عيسى بن دينار الأزدي.(@)(@@) دينار(@)(@@) مولى أبي رهم أبو حازم التمار، وقد قيل: مولى بني غفار، يروي عن: البياضي، رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: محمد بن إبراهيم التيمي ومحمد بن عمرو بن علقمة.(@)(@@)(@@)(@@) ||| AUTO دينار أبو العيزار(@)(@@) يروي عن: علي، روى عنه: عبد الله بن ميسرة، وابنه أيوب بن دينار، عداده في أهل الكوفة.(@)(@@) دينار(@)(@@) شيخ، يروي عن: علي، عداده في أهل الكوفة، روى عنه: ابنه أيوب بن دينار.(@)(@@)(@@)(@@) ||| AUTO 
ms510	 (@@)(@@)(@@) ||| AUTO دينار الحجام(@)(@@) مولى جرم، حجم زيد بن أرقم، روى عنه: يونس بن عبد الله الجرمي.(@)(@@) دينار الحجام(@)(@@) حجم أنس بن مالك، روى عنه: النضر بن شميل، أحسبه أبا طالب الحجام الذي روى عنه: قتادة.(@)PageV01P002(@)(@@) [ج 2: ص 129](@)(@@)(@@)(@@) ||| AUTO دينار أبو كثير(@)(@@) يروي عن: ابن عمر، روى عنه: ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO دينار بن دينار الشامي(@)(@@) يروي عن: أبي الدرداء، روى عنه: الهيثم الأعمى.(@)(@@)(@@)(@@) ||| AUTO دينار أبو سعيد عقيصا(@)(@@) يروي عن: الحسن والحسين، روى عنه: سالم بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO دينار أبو فاطمة(@)(@@) يروي عن: أبي رافع، روى عنه: سعيد بن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO درهم أبو هند(@)(@@) كان من العباد، يروي عن: معقل بن يسار، روى عنه: حاجب بن عمر.(@)(@@)(@@)(@@) ||| AUTO درهم أبو عبيد(@)(@@) يروي عن: علي، روى عنه: عبادة بن مسلم.(@)(@@) درهم(@)(@@) مولى حمزة، يروي عن: أبي هريرة، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO دثار بن عبيد بن الأبرص الشاعر الأسدي(@)(@@) عداده في أهل الكوفة، يروي عن: علي، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO دخين الحجري(@)(@@) من أهل مصر، يروي عن: عقبة بن عامر، روى عنه: بكر بن سوادة وكعب بن علقمة، كنيته أبو الهيثم، وكان كاتبا لعقبة بن عامر.(@)(@@)(@@)(@@) ||| AUTO أبو طلحة الخولاني، اسمه درع بن عبد الله(@)(@@) من أهل بيت المقدس، وكان واليا عليها، يروي عن: جماعة من الصحابة، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO ديسم السدوسي(@)(@@) يروي عن: بشير بن الخصاصية، روى عنه: أيوب السختياني.(@)PageV01P002(@)(@@) [ج 2: ص 130](@)(@@)(@@)(@@) ||| AUTO دخيل بن أبي الخليل(@)(@@) واسم أبيه صالح بن أبي مريم الضبعي، من أهل البصرة، يروي عن: أبي هريرة، روى عنه: مطر الوراق.(@)(@@)(@@)(@@) ||| AUTO دلجة بن قيس(@)(@@) يروي عن: الحكم بن عمرو الغفاري، روى عنه: أبو تميمة السلي.(@)(@@)(@@)(@@) ||| AUTO دجاجة(@)(@@) يروي عن: عثمان بن عفان، روى عنه: ابناه الدرباس، وعمرو.(@)(@@)(@@)(@@) ||| AUTO دغفل(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO دقرة بنت غالب الراسبية(@)(@@) من أهل البصرة، تروي عن: عائشة، روى عنها: أهل البصرة، وقد قيل: أنها ابنة أذينة، 
ms511	 ويشتبه أن يكون أذينة أمها.(@)(@@)(@@)(@@) || AUTO باب الذال(@)(@@) قال أبو حاتم:(@)(@@) وممن شافه الصحابة، وروى عنهم ممن ابتدأ اسمه على الذال:(@)(@@)(@@)(@@) ||| AUTO ذكوان أبو صالح السمان(@)(@@) وهو الذي يقال له: الزيات، كان يجلب السمن والزيت إلى الكوفة فنسب إليهما، وهو والد سهيل بن أبي صالح، يروي عن: أبي هريرة، وسعد بن أبي وقاص، روى عنه: الأعمش، وابنه والناس، وهو مولى جويرية بنت الأحمس الغطفاني، مات سنة إحدى ومائة.(@)(@@)(@@)(@@) ||| AUTO ذكوان أبو عمرو(@)(@@) مولى عائشة بنت أبي بكر، يروي عن: عائشة، وكانت دبرته، وكان يؤمها في شهر رمضان في المصحف، روى عنه: ابن أبي مليكة، قتل ليالي الحرة سنة ثلاث وستين.(@)PageV01P002(@)(@@) [ج 2: ص 131](@)(@@)(@@)(@@) ||| AUTO الذيال بن حنظلة بن حنيفة بن حذيم(@)(@@) عن: أبيه، وله صحبة، روى عنه: البصريون من حديث المقدمي، عن محمد بن عثمان، عن الذيال، عن حنظلة.(@)(@@)(@@)(@@) ||| AUTO الذيال بن عبيد بن حنظلة بن حنيفة بن حذيم(@)(@@) يروي عن: جده حنظلة، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO الذيال بن حرملة الأسدي(@)(@@) كوفي، يروي عن: جابر بن عبد الله، روى عنه: حصين، وفطر بن خليفة، والأجلح.(@)(@@) (126) -[2: 131] ثنا إبراهيم بن هريم، قال: ثنا عبد بن حميد، قال: ثنا يعلى بن عبيد، عن الأجلح، عن الذيال بن حرملة، عن جابر، قال: " أقبلنا مع النبي صلى الله عليه وسلم عن السفر، حتى دفعنا إلى حائط من حيطان بني النجار، فإذا فيه جمل لا يدخل الحائط أحد إلا شد عليه، فذكروا ذلك للنبي صلى الله عليه وسلم فأتاه فدعاه فجاء واضعا مشفره في الأرض، حتى برك بين يديه، فقال صلى الله عليه وسلم: هاتوا خطاما وخطمه، ودفعه إلى صاحبه، ثم التفت، وقال: ما بين السماء والأرض شيء إلا يعلم أني رسول الله، إلا عاصي الجن والإنس "(@)(@@)(@@)(@@) ||| AUTO ذو الكلاع أبو شراحيل بن عم كعب(@)(@@) عداده في أهل الشام، يروي عن: عوف بن مالك، روى عنه: أزهر بن سعد الكلاعي.(@)(@@)(@@)(@@) ||| AUTO ذهيل بن عوف بن الشماخ(@)(@@) يروي عن: أبي هريرة، روى سهيل بن أبي صالح، عن 
ms512	 سليط، عنه.(@)(@@)(@@)(@@) ||| AUTO ذباب بن مرة(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: الحكم.(@)(@@)(@@)(@@) ||| AUTO ذهل بن كعب(@)(@@) يروي عن: عمر، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO ذواد العقيلي(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO ذريح النخعي أبو المثنى(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: الحارث بن جميلة.(@)PageV01P002(@)(@@) [ج 2: ص 132](@)(@@)(@@)(@@) ||| AUTO ذفيف(@)(@@) مولى ابن عباس، يروي عن: ابن عباس، روى عنه: حميد بن قيس، مات سنة سبع ومائة.(@)(@@)(@@)(@@) ||| AUTO ذرة(@)(@@) روت عن عائشة، روى عنها: زيد بن أسلم.(@)(@@)(@@)(@@) || AUTO باب الراء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن أصحاب رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الراء:(@)(@@)(@@)(@@) ||| AUTO الربيع بن خثيم الثوري التميمي الكوفي، كنيته أبو يزيد(@)(@@) ابن ثور بن عبد مناة بن أد بن طابخة بن إلياس بن مضر، من العباد الثمانية، أخباره في العبادة والزهد أشهر من أن يحتاج إلى الإغراق في ذكرها، يروي عن: ابن مسعود، روى عنه: أهل الكوفة، مات بعد قتل الحسين بن علي سنة ثلاث وستين،(@)(@@) (127) -[2: 132] ثنا محمد بن معاذ، قال: ثنا الفرياناني، قال: ثنا محمد بن فضيل، عن أبيه، عن سعيد بن مسروق، عن الربيع بن خثيم، أنه سرق له فرس وقد أعطي به عشرين ألفا، فاجتمع عليه حيه، وقالوا: ادع الله عليه، فقال: " اللهم إن كان غنيا فاغفر له، وإن كان فقيرا فأعنه "(@)(@@)(@@)(@@) ||| AUTO الربيع بن زياد(@)(@@) عامل معاوية على خراسان، يروي عن: أبي بن كعب، روى عنه: قتادة، روى عن: الربيع بن زياد بن أنس بن الذيال الحارثي، وذاك أن عثمان بن عفان رضى الله تعالى عنه في السنة التاسعة والعشرين عزل أبا موسى الأشعري عن البصرة، وعثمان بن العاص عن فارس، وولى البصرة وفارس كلها عبد الله بن عامر بن كريز، فانفذ عبد الله بن عامر في أول سنة ثلاثين الربيع بن زياد إلى سجستان وولاه عليها ففتح سجستان على يديه، وقد ذكرنا تلك القصة بتمامها في فضائل سجستان. 
ms513	(@)(@@)(@@)(@@) ||| AUTO الربيع بن معبد بن أبي الحقيق(@)(@@) روى عنه: يزيد بن زياد القرظي.(@)PageV01P002(@)(@@) [ج 2: ص 133](@)(@@)(@@)(@@) ||| AUTO الربيع بن قزيع(@)(@@) أحد بني غطفان، كنيته أبو الجارود، عداده في أهل الكوفة، يروي عن: ابن عمر، روى عنه: الثوري وشعبة.(@)(@@)(@@)(@@) ||| AUTO الربيع بن البراء بن عازب الأنصاري(@)(@@) أخو إبراهيم ويحيى، عداده في أهل الكوفة، يروي عن: أبيه، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO الربيع بن نضيلة(@)(@@) كوفي، يروي عن: سلمان، روى عنه: علي بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO الربيع بن عميلة الفزاري(@)(@@) أخو يسير بن عميلة، عداده في أهل الكوفة، يروي عن: ابن مسعود، روى عنه: ابنه الركين بن الربيع.(@)(@@)(@@)(@@) ||| AUTO الربيع بن لوط(@)(@@) ابن أخي البراء بن عازب، يروي عن: البراء، روى عنه: ابن جريج ويحيى بن سليم.(@)(@@)(@@)(@@) ||| AUTO الربيع بن أبي بن كعب الأنصاري(@)(@@) يروي عن: أبيه، روى عنه: موسى بن دهقان.(@)(@@)(@@)(@@) ||| AUTO ربيع بن حراش(@)(@@) من عباد أهل الكوفة وقرائهم، يروي عن: جماعة من الصحابة، روى عنه: عبد الملك بن عمير، وأخوه ربعي، آلى أن لا تفتر أسنانه ضاحكا حتى يعلم أين مصيره فما ضحك إلا بعد موته، وله فيه قصة طويلة،(@)(@@) (128) -[2: 133] ثنا القطان بالرقة، قال: ثنا حكيم بن يوسف الرقي، قال: ثنا عبيد الله بن عمرو، عن عبد الملك بن عمير، عن ربعي بن حراش، عن أخيه الأوسط، أنه مرض وثقل، قال: فخرجت في حاجة فأغمي عليه وسجي، وقيل: قد مات، فأتيته فبينا نحن جلوس عنده إذ فتح عينيه، فقلت: سبحان الله أبعد الموت؟ قال: " إني لقيت ربي فتلقاني منه بروح وريحان ورب غير غضبان، وكساني ثيابا خضرا من سندس وإستبرق، وإني استأذنت الله عز وجل لأبشركم، وأخبركم أن الأمر أهون مما في أنفسكم، PageV01P002 [ج 2: ص 134] ولكن لا تغتروا، وإن رسول الله صلى الله عليه وسلم أقسم أن لا يبرح حتى أرجع إليه، قال: فكأنها حصاة ألقيت في ماء فرسبت "(@)(@@)(@@)(@@) ||| AUTO الربيع بن ركين الكوفي(@)(@@) يروي عن: أنس بن مالك، روى عنه: أهل الكوفة، مات سنة أربع ومائة.(@)(@@)(@@)(@@) ||| AUTO الربيع بن 
ms514	 سبرة بن معبد الجهني(@)(@@) يروي عن: أبيه، وأنس، روى عنه: الزهري، وابناه عبد العزيز، وعبد الملك، وعمارة بن غزية.(@)(@@)(@@)(@@) ||| AUTO الربيع بن عبد الله، من تيم الرباب(@)(@@) يروي عن: ابن عمر، روى عنه: مزاحم بن زفر.(@)(@@)(@@)(@@) ||| AUTO الربيع بن أنس بن زياد البكري(@)(@@) سكن مرو، يروي عن: أنس بن مالك، روى عنه: ابن المبارك، وأبو جعفر الرازي، والناس يتقون حديثه ما كان من رواية أبي جعفر عنه، لأن فيها اضطراب كثير.(@)(@@)(@@)(@@) ||| AUTO الربيع بن عتبة الباهلي(@)(@@) يروي عن: أبي أمامة، روى عنه: عبد الملك بن عتبة.(@)(@@)(@@)(@@) ||| AUTO الربيع بن علي(@)(@@) شيخ، يروي عن: علي بن أبي طالب، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO الربيع بن سليم(@)(@@) مولى أنس بن مالك، يروي عن: أنس، روى عنه: زيد بن الحباب العكلي.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن عبد الله بن عبيد الله بن الهدير بن عبد العزى بن عامر بن الحارث بن حارثة بن سعد بن تيم بن مرة التيمي القرشي PageV01P002 [ج 2: ص 135](@)(@@) عم محمد بن المنكدر، عداده في أهل المدينة، يروي عن: عمر بن الخطاب، روى عنه: ابن أبي مليكة، مات سنة ثلاث وتسعين، أمه سمية بنت قيس بن الحارث بن نضلة بن عوف بن عبيد بن عويج بن عدي بن كعب.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن ناجذ الأسدي الأزدي الكوفي(@)(@@) يروي عن: علي، روى عنه: أبو صادق، وقيل: ربيعة بن ناجذ الأسلمي.(@)(@@)(@@)(@@) ||| AUTO ربيعة الجرشي(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن ميمونة الحضرمي.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن شيبان السعدي أبو الحوراء(@)(@@) يروي عن: الحسن بن علي، عداده في أهل البصرة، روى عنه: يزيد بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن سلمة اليماني(@)(@@) يروي عن: عثمان، وعلي، روى عنه: مسلم بن يسار.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن دراج(@)(@@) يروي عن: عمر وعلي، روى الزهري، عن رجل، عنه.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن يورا(@)(@@) مصري، يروي عن: فضالة بن عبيد، روى عنه: عبد الله بن مسروح.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن عمرو الجرشي(@)(@@) من العباد، شامي، كان يقص أيام PageV01P002 [ج 2: ص 136] معاوية، يروي عن: معاوية، 
ms515	 روى عنه: أهل الشام، قتل بمرج راهط.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن لقيط التجيبي(@)(@@) من أهل مصر، يروي عن: عبد الله بن حوالة، روى عنه: أهل مصر.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن عباد الديلي(@)(@@) شيخ من أهل المدينة، وقد قيل: إن له صحبة وفيه نظر، مات سنة خمس وتسعين.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن الغاز(@)(@@) يروي عن: عائشة، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن الأبيض(@)(@@) يروي عن: علي بن أبي طالب رضى الله تعالى عنه، روى عنه: ابن أشوع.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن الحارث(@)(@@) يروي عن: الفضل بن العباس، روى عنه: عبد الله بن نافع بن العمياء.(@)(@@)(@@)(@@) ||| AUTO ربيعة القيسي(@)(@@) ملاعب الأسنة، يروي عن: أبي الدرداء، روى عنه: حبيب بن عبيد.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن أبي هلال الأسلمي(@)(@@) يروي عن: ابن الزبير، روى عنه: ابنه خالد بن ربيعة، ويقال: ربيعة بن هلال.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن زرارة العتكي، أبو الحلال(@)(@@) بصري، يروي عن: عثمان بن عفان، روى عنه: هشيم، وقد قيل: إن اسمه زرارة بن ربيعة.(@)PageV01P002(@)(@@) [ج 2: ص 137](@)(@@)(@@)(@@) ||| AUTO ربيعة بن عبد الرحمن بن حصن الغنوي(@)(@@) يروي عن: جدته سراء، ولها صحبة، روى عنه: أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن زياد(@)(@@) يروي المراسيل، روى عنه: وبرة الحارثي.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن قيس(@)(@@) يروي عن: عقبة بن عامر، روى بكر بن سوادة، عن رجل، عنه.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن أبي عبد الرحمن(@)(@@) مولى التيميين، واسم أبي عبد الرحمن: فروخ، وهو الذي يقال له: ربيعة الرأي، كنيته أبو عثمان، وقد قيل: أبو عبد الرحمن، كان من فقهاء المدينة، وعنه أخذ مالك الفقه، يروي عن: أنس بن مالك، روى عنه: مالك، والثوري، مات سنة ثلاث وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن يزيد القصير الدمشقي، كنيته أبو شعيب(@)(@@) وكان من خيار أهل الشام، يروي عن: واثلة بن الأسقع، روى عنه: الأوزاعي، وسعيد بن عبد العزيز، وأهل الشام، قتل غازيا بالمغرب،(@)(@@) (129) -[2: 137] ثنا محمد بن المنذر، قال: ثنا أبو زرعة، قال: ثنا أبو مسهر، قال: ثنا عبد الرحمن بن عامر، قال: سمعت ربيعة بن يزيد، يقول: 
ms516	 " ما أذن مؤذن صلاة الظهر منذ أربعين سنة إلا وأنا في المسجد إلا أن أكون مريضا أو مسافرا " قال أبو حاتم: خرج ربيعة بن يزيد غازيا نحو المغرب في بعث بعثه هشام بن عبد الملك، واستعمل عليهم كلثوم بن عياض القشيري، قتل ربيعة بن يزيد غازيا في ذلك البعث بالمغرب، وكان يزيد صاحبا لمعاوية.(@)(@@)(@@)(@@) ||| AUTO ربيعة بن الصلت(@)(@@) من أهل الشام، يروي عن: عائشة، روى عنه: خالد بن سعدان.(@)PageV01P002(@)(@@) [ج 2: ص 138](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO راشد بن سعد الحمصي المقرئ(@)(@@) ومقرأ قرية بدمشق، من أهل الشام، يروي عن: ثوبان ويعلى بن مرة، روى عنه: أهل الشام، ومات في ولاية هشام بن عبد الملك سنة ثلاث عشرة ومائة.(@)(@@)(@@)(@@) ||| AUTO راشد بن أبي سكنة الشامي(@)(@@) يروي عن: معاوية، روى عنه: عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO راشد بن يسار(@)(@@) مملوك لعبد الله بن أبي أوفى، رأى خمسة من أصحاب رسول الله صلى الله عليه وسلم منهم مرداس، أو ابن مرداس، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO راشد بن حبيش الرقي(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: أبو العوام بن حوشب، سادن بيت المقدس، وزرعة بن عبد الرحمن بن جرهد.(@)(@@)(@@)(@@) ||| AUTO راشد بن الحارث(@)(@@) يروي عن: أبي ذر، روى عنه: عمار الدهني.(@)(@@)(@@)(@@) ||| AUTO راشد بن معبد(@)(@@) يروي عن: أنس بن مالك، روى عنه: الحسن بن حبيب، وأبو نعيم.(@)(@@) راشد(@)(@@) مولى عثمان، يروي عن: عثمان بن عفان، روى عنه: إبراهيم بن طهمان.(@)(@@)(@@)(@@) ||| AUTO راشد بن نجيح الحماني، كنيته أبو محمد(@)(@@) عداده في أهل الكوفة، يروي عن: أنس، روى عنه: ابن المبارك، وعبد الوهاب، ربما أخطأ.(@)(@@) راشد(@)(@@) مولى قريش، وقد قيل: مولى الأنصار، يروي عن: عمر، روى عنه: معمر بن أبان.(@)PageV01P002(@)(@@) [ج 2: ص 139](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO راشد(@)(@@) شيخ، يروي عن: السائب بن خباب، روى عنه: ابنه عبد الملك بن راشد.(@)(@@) راشد(@)(@@) مؤذن بن الزبير، يروي عن: ابن الزبير، روى عنه: عوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO رافع بن أبي رافع الطائي(@)(@@) يروي عن: أبي بكر الصديق، روى عنه: طارق بن شهاب، واسم 
ms517	 أبي رافع عميرة، مات في خلافة أبي بكر.(@)(@@)(@@)(@@) ||| AUTO رافع بن حديج(@)(@@) يروي عن: حذيفة، روى عنه: الربيع بن سحيم، وقد قيل: إنه رافع بن حديد السوائي، من أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO رافع الأشجعي أبو الجعد الغطفاني(@)(@@) مولى لهم، وكان قارئا للقرآن، يروي عن: علي، وابن مسعود، روى عنه: ابنه سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO رافع بن عاقب(@)(@@) يروي عن: ابن عمر، روى عنه: أبو علي البهدلي.(@)(@@)(@@)(@@) ||| AUTO رافع بن سالم الفزاري(@)(@@) يروي عن: عمر، روى عنه: محمد بن إبراهيم بن الحارث التيمي.(@)(@@)(@@)(@@) ||| AUTO رافع بن حصن(@)(@@) أبو المغيرة، يروي عن: ابن عمر، روى عنه: عبد الله بن عكرمة.(@)(@@)(@@)(@@) ||| AUTO رافع أبو الحسن(@)(@@) يروي عن: ثوبان، روى عنه: أبو الزاهرية، وعبد الرحمن بن جبير بن نفير.(@)(@@)(@@)(@@) ||| AUTO رافع بن جحش المحاربي(@)(@@) يروي عن: عثمان، روى عنه: أبو مالك بن ثعلبة القرظي.(@)PageV01P002(@)(@@) [ج 2: ص 140](@)(@@)(@@)(@@) ||| AUTO رافع بن إسحاق(@)(@@) مولى أبي الشفاء، من أهل المدينة، يروي عن: أبي أيوب الأنصاري، والخدري، روى عنه: إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO رافع أبو عامر(@)(@@) يروي عن: علي رضى الله تعالى عنه، روى عنه: أبو حصين.(@)(@@)(@@)(@@) ||| AUTO رافع بن بشير السلمي(@)(@@) يروي عن: أبيه، روى عبد الحميد بن جعفر، عن أبي جعفر، عنه، ويشبه أن يكون هذا هو بشر بن معاوية بن ثور السلمي، فإن له صحبة.(@)(@@)(@@)(@@) ||| AUTO رافع بن سلمة البجلي(@)(@@) يروي عن: علي، روى عنه: بشير بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO رافع بن حنين، ويقال: حصين، كنيته أبو المغيرة(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الله بن عكرمة، والصحيح حنين.(@)(@@)(@@)(@@) ||| AUTO روح بن زنباع الجذامي(@)(@@) من أهل فلسطين، وكان عابدا غازيا، من سادات أهل الشام، يروي عن: تميم الداري، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO رجاء الغنوي(@)(@@) يروي المراسيل، أصيبت يده يوم الجمل، روت عنه: ساكنة بنت الجعد الغنوية.(@)(@@)(@@)(@@) ||| AUTO رجاء بن ربيعة الزبيدي(@)(@@) يروي عن: أبي سعيد الخدري، والبراء بن عازب، عداده في أهل الكوفة، روى عنه: ابنه إسماعيل بن رجاء.(@)PageV01P002(@)(@@) [ج 2: ص 
ms518	 141](@)(@@)(@@)(@@) ||| AUTO رجاء بن أبي رجاء الباهلي(@)(@@) يروي عن: محجن وله صحبة، روى عنه: عبد الله بن شقيق العقيلي.(@)(@@)(@@)(@@) ||| AUTO رجاء بن حيوة الكندي الشامي، كنيته أبو المقدام(@)(@@) وقد قيل: أبو بكر، سكن فلسطين، وربما سكن الأردن، وكان من عباد أهل الشام وزهادهم وفقهائهم، يروي عن: أبي أمامة، روى عنه: ابن عون، وأهل الشام.(@)(@@) (130) -[2: 141] ثنا محمد بن عثمان العقبي، قال: ثنا أبو زرعة، قال: ثنا أبو مسهر، قال: سمعت كامل بن سلمة بن رجاء بن حيوة، قال: قال هشام بن عبد الملك: " من سيد أهل فلسطين؟ قالوا: رجاء بن حيوة، قال: فمن سيد أهل الأردن؟ قالوا: عبادة بن نسي، قال: فمن سيد أهل دمشق؟ قالوا: يحيى بن يحيى الغساني، قال: فمن أهل حمص؟ قالوا: عمرو بن قيس، قالوا: فمن أهل الجزيرة؟ قالوا: عدي بن عدي الكندي ". قال: قال كندة: ومات رجاء بن حيوة سنة ثنتي عشرة ومائة، وكان رجاء بن حيوة يحمر رأسه ويترك لحيته بيضاء(@)(@@)(@@)(@@) ||| AUTO رجاء بن الحارث(@)(@@) يروي عن: علي، روى عنه: حزن بن بشير.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO رياح بن عبيدة(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: ابنه إسماعيل بن رياح وأهل العراق، وكان رياح من العباد من جلساء عمر بن عبد العزيز.(@)(@@) رياح(@)(@@) يروي عن: عثمان بن عفان، روى عنه: الحسن بن سعد، لا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO رياح بن رياح(@)(@@) يروي عن: أبي هريرة، روى عنه: الحسن البصري.(@)(@@)(@@)(@@) ||| AUTO رياح بن الحارث الكوفي(@)(@@) يروي عن: علي، وسعيد بن زيد، PageV01P002 [ج 2: ص 142] روى عنه: صدقة بن المثنى.(@)(@@)(@@)(@@) ||| AUTO رزيق(@)(@@) مولى لعمر بن الخطاب، يروي عن: ابن عمر، روى عنه: أبو زيد.(@)(@@)(@@)(@@) ||| AUTO رزيق أبو عبد الله الألهاني الشامي(@)(@@) يروي عن: أبي أمامة، روى عنه: أرطاة بن المنذر السكوني.(@)(@@)(@@)(@@) ||| AUTO رزيق بن حيان(@)(@@) مولى بني فزارة، كنيته أبو المقدام، يروي عن: مسلم بن قرظة، روى عنه: ابن جابر.(@)(@@)(@@)(@@) ||| AUTO رزيق بن سوار(@)(@@) يروي عن: الحسن، روى عنه: مسافر الجصاص.(@)(@@)(@@)(@@) ||| AUTO رفيع البصري: أبو العالية 
ms519	 الرياحي(@)(@@) مولى امرأة من بني يربوع من بني رياح، أسلم لسنتين خلتا من خلافة أبي بكر، يروي عن: علي، وابن عباس، روى عنه: قتادة، وأهل البصرة، مات يوم الإثنين في شهر شوال سنة ثلاث وتسعين، وكان الشافعي سيء الرأي فيه.(@)(@@)(@@)(@@) ||| AUTO رفيع المكي(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه عبد العزيز بن رفيع المكي.(@)(@@)(@@)(@@) ||| AUTO رفيع أبو عقبة السدوسي(@)(@@) يروي عن: علي، روى عنه: عمران بن حدير.(@)PageV01P002(@)(@@) [ج 2: ص 143](@)(@@)(@@)(@@) ||| AUTO رفاعة بن شداد الفتياني، كنيته أبو عاصم(@)(@@) وفتيان بطن من بجيلة من أهل اليمن، عداده في أهل الكوفة، يروي عن: عمرو بن الحمق الخزاعي، روى عنه: السدي، وكان ممن انفلت من عين الوردة حين قتل الحسين بن علي في تسعة آلاف من أصحاب الحسين فتلقاهم عبيد الله بن زياد في أهل الشام فقتلهم، عن آخرهم.(@)(@@)(@@)(@@) ||| AUTO رفاعة بن رافع الزرقي الأنصاري(@)(@@) من أهل المدينة، يروي عن: أنس بن مالك، روى عنه: عبيد الله بن عمر، والناس.(@)(@@)(@@)(@@) ||| AUTO رفاعة بن رافع بن خديج الأنصاري الحارثي(@)(@@) يروي عن: أبيه، روى عنه: الناس، كنيته أبو خديج، مات في ولاية الوليد بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO رزين بن عبيد(@)(@@) يروي عن: ابن عباس، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO رزين بن قطن(@)(@@) يروي عن: البراء بن عازب، عداده في أهل الكوفة، روى عنه: الأجلح.(@)(@@)(@@)(@@) ||| AUTO ربعي بن حراش بن جحش الغطفاني القيسي(@)(@@) من قيس غيلان، كوفي، أخو الربيع بن حراش، ومسعود بن حراش، وكان ربعي من عباد أهل الكوفة، وكان أعور، يروي عن: حذيفة بن اليمان، وعمر، روى عنه: منصور، وعبد الملك بن عمير، مات في خلافة عمر بن عبد العزيز سنة مائة أو إحدى ومائة، وصلى عليه عبد الحميد بن عبد الرحمن بن زيد بن الخطاب، ويقال: أنه تكلم بعد الموت.(@)PageV01P002(@)(@@) [ج 2: ص 144](@)(@@)(@@)(@@) ||| AUTO ريحان بن يزيد العامري الأعرابي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: سعد بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO رحيل(@)(@@) يروي عن: بلال، روى عنه: ابنه عبد الملك بن رحيل الرحبي. 
ms520	(@)(@@)(@@)(@@) ||| AUTO رداد الليثي(@)(@@) إن حفظه معمر، يروي:(@)(@@) (131) -[2: 144] عن عبد الرحمن بن عوف، عن النبي صلى الله عليه وسلم قال: قال الله عز وجل: " أنا الرحمن، خلقت الرحم وشققت لها اسما من اسمي، فمن وصلها وصلته ومن قطعها بتته ". ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا عبد الرزاق، قال: ثنا معمر، عن الزهري، عن أبي سلمة، عن رداد الليثي، عن عبد الرحمن بن عوف، ما أحسب معمرا حفظه، روى أصحاب الزهري هذا الخبر، عن أبي سلمة، عن عبد الرحمن بن عوف(@)(@@)(@@)(@@) ||| AUTO رياش بن عمرو الطائي(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: الشعبي، وقد قيل: رياش بن عدي.(@)(@@)(@@)(@@) ||| AUTO رياش الحماني(@)(@@) يروي عن: عمر وعمرو بن العاص، روى عنه: نوح بن جابر.(@)(@@)(@@)(@@) ||| AUTO ريان بن صبيرة الحنفي(@)(@@) يروي عن: ابن عمر، روى عنه: عيسى بن حطان.(@)(@@)(@@)(@@) ||| AUTO ريان بن الجعد الكناني(@)(@@) من أهل فلسطين، يروي عن: أبي قرصافة، روى عنه: الغنجار عيسى بن موسى.(@)(@@)(@@)(@@) ||| AUTO رشيد الواسطي(@)(@@) قدم البصرة، يروي عن: ابن عمر، روى عنه: فضيل بن طلحة.(@)(@@)(@@)(@@) ||| AUTO رواد بن أبي بكرة الثقفي(@)(@@) من أهل البصرة، أخو عبد الرحمن، وعبيد الله، ويزيد، وعبد العزيز، ومسلم بني أبي بكرة، يروي عن: أبيه أبي بكرة، روى عنه: ابن سيرين.(@)PageV01P002(@)(@@) [ج 2: ص 145](@)(@@)(@@)(@@) ||| AUTO الركين بن الربيع بن عميلة الفزاري الكوفي(@)(@@) يروي عن: ابن الزبير، وابن عمر، روى عنه: الثوري، وشريك، مات سنة إحدى وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO رديح(@)(@@) يروي عن: ابن عباس، روى عنه: الأعمش.(@)(@@)(@@)(@@) ||| AUTO رستم المزني(@)(@@) يروي عن: عائذ بن عمرو المزني، روى عنه: ابنه أبو عامر الخزاز واسمه: صالح بن رستم.(@)(@@)(@@)(@@) ||| AUTO رستم أبو يزيد الطحان(@)(@@) كوفي، يروي عن: أنس، روى عنه: خالد بن مخلد القطواني، سكن الكوفة.(@)(@@)(@@)(@@) ||| AUTO رغبان(@)(@@) مولى حبيب بن مسلمة الفهري، رأى أصحاب النبي صلى الله عليه وسلم يركعون ركعتين قبل المغرب، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO رباب(@)(@@) شيخ، يروي عن: سليمان بن عامر الضبي، روت عنه: حفصة بنت سيرين، 