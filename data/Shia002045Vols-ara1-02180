ms2161	 جعفر الرازي ثنا أبو بكر بن أبي الأسود ثنا عبد الواحد بن زياد عن عاصم الأحول قال سمعت عزرة يقول إن أبا العالية قال قال عبد الله بن مسعود لعنت الواصلة والواشمة والفالجة والمنمصة قاله رسول الله صلى الله عليه وسلم حدثنا علي بن عبد العزيز ثنا المسعودي عن سلمة بن كهيل عن أبي عمرو الشيباني أن عبد الله بن مسعود قال والذي لا إله غيره ما صلت امرأة صلا قط خيرا لها من صلاة تصليها في بيتها إلا أن يكون المسجد الحرام أو مسجد الرسول إلا عجوزا في منقليها حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن سلمة بن كهيل عن أبي عمرو الشيباني عن بن مسعود قال ما صلت المرأة في مكا خير لها من بيتها إلا أن يكون المسجد الحرام أو مسجد النبي صلى الله عليه وسلم إلا امرأة تخرج في منقليها يعني خفيها حدثنا إسحاق بن إبراهيم الدبري عن عبد الرزاق عن الثوري عن أبيه عن أبي عمرو الشيباني قال سمعت رب هذه الدار يحلف فيبلغ باليمين ما من مصلى المرأة خير لها من بيتها إلا في حج أو PageV09P293(@)(@@) عمرة إلا امرأة يئست من البعولة فهي في منقليها قلت ما منقليها قال امرأة عجوز قد تقارب خطوها حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا سعيد بن مسروق عن أبي عمرو الشيباني قال حلف عبد الله فبالغ في اليمين ما من مصلى لامرأة خير من بيتها إلا في حج أو عمرة إلا امرأة قد يئست من البعولة فهي في منقليها حدثنا إسحاق بن إبراهيم أنا عبد الرزاق أنا معمر عن أبي إسحاق عن أبي عمرو الشيباني أنه رأى بن مسعود يخرج النساء من المسجد يوم الجمعة ويقول اخرجن إلى بيوتكن خير لكن حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا شعبة أخبرني أبو إسحاق أخبرني أبو عمرو الشيباني قال رأيت بن مسعود يطرد النساء 
ms2162	 من المسجد يوم الجمعة حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن الحجاج عن أبي إسحاق عن أبي عمرو الشيباني عن بن مسعود أنه كان يطرد النساء من المسجد يوم الجمعة ويقول صلين في بيوتكن حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا إبراهيم الهجري عن أبي الأحوص عن عبد الله قال ما صنعت امرأة خيرا من أن تقعد في قعر بيتها تعبد ربها تقول إحداهن أذهب إلى أهلي فيستشرفها الشيطان حتى تقول ما رآني أحد إلا أعجبته حدثنا محمد بن حيان المازني ثنا عمرو بن الاستثناء أنا شعبة عن أبي إسحاق عن أبي الأحوص عن عبد الله قال إنما النساء PageV09P294(@)(@@) عورة وإن المرأة لتخرج من بيتها وما بها من بأس فيستشرف لها الشيطان فيقول إنك لا تمر بأحد إلا أعجبته وإن المرأة لتلبس ثيابها فيقال أين تريدين فيقول أعود مريضا أشهد جنازة أو أصلى في مسجد وما عبدت امرأة ربها بمثل ان تعبده في بيتها حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا أبو هلال عن حميد بن هلال عن أبي الأحوص عن بن مسعود قال إن المرأة عورة وإنها إذا خرجت من بيتها استشرفها الشيطان فتقول ما رآني أحد إلا أعجبته وأقرب ما تكون إلى الله إذا كانت في قعر بيتها حدثنا إسحاق بن إبراهيم الدبري عن عبد الرزاق عن معمر عن أيوب عن حميد بن هلال عن أبي الأحوص عن بن مسعود قال صلاة المرأة في بيتها أفضل من صلاتها في حجرتها وصلاتها في حجرتها أفضل من صلاتها في دارها وصلاتها في دارها أفضل من صلاتها فيما سواه ثم قال إن المرأة إذا خرجت تشرف لها الشيطان حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن الأعمش عن إبراهيم عن عبد الله قال صلاة المرأة في البيت خير من صلاتها في الدار وصلاتها في الدار خير من صلاتها خارجه حدثنا إسحاق بن 
ms2163	 إبراهيم عن عبد الرزاق عن الثوري عن الأعمش عن إبراهيم عن أبي معمر عن بن مسعود قال كان الرجال والنساء في بني إسرائيل يصلون جميعا فكانت المرأة إذا كان لها الخليل تلبس القالبين تطول بهما لخليلها فألقى الله عليهن الحيض فكان بن مسعود يقول أخروهن حيث أخرهن الله قلنا لأبي بكر ما القالبين قال رقيصتين من خشب PageV09P295(@)(@@) حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن الأعمش عن إبراهيم عن عبد الله قال كانت المرأة من بني إسرائيل تلبس القالبين فتقوم عليهما فتواعد خليلها فألقي عليهن الحيض وكان عبد الله يقول أخروهن حيث أخرهن الله * باب * حدثنا إسحاق بن إبراهيم الدبري عن عبد الرزاق عن الثوري عن حصين عن عبد الأعلى قال دخلت المسجد مع بن مسعود فركع فمر عليه رجل وهو راكع فسلم عليه فقال صدق الله ورسوله فلما انصرف قال كان يقال من أشراط الساعة أن يسلم الرجل على الرجل للمعرفة وتتخذ المساجد طرقا وأن تغلو النساء والخيل ثم ترخص فلا تغلو إلى يوم القيامة وأن يتجر الرجل والمرأة جميعا حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا حصين عن عبد الأعلى بن الحكم الكلبي عن خارجة بن الصلت البرجمي قال أتينا المسجد مع عبد الله بن مسعود فقال عبد الله كان يقال إن من اقتراب الساعة أن تتخذ المساجد طرقا حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن منصور عن سالم بن أبي الجعد قال دخل بن مسعود المسجد فقال قال رسول الله صلى الله عليه وسلم إن من أشراط الساعة أن يمر الرجل في طول المسجد وعرضه لا يصلي فيه ركعتين هكذا رواه منصور ووصله قتادة حدثنا محمد بن علي بن شعيب السمسار ثنا الحسن بن PageV09P296(@)(@@) بشر الأسماء ثنا الحكم بن عبد الملك عن قتادة عن سالم بن أبي الجعد عن أبيه قال لقي بن مسعود رجلا فقال السلام عليك يا بن مسعود فقال بن 
ms2164	 مسعود صدق الله ورسوله صلى الله عليه وسلم سمعت رسول الله صلى الله عليه وسلم يقول من أشراط الساعة أن يمر الرجل في المسجد لا يصلي فيه ركعتين وأن لا يسلم الرجل إلا على من يعرف وأن يبرد الصبي الشيخ حدثنا عبدان بن أحمد ثنا هشام بن عمار ثنا عمر بن المغيرة عن ميمون أبي حمزة عن إبراهيم عن علقمة قال لقي عبد الله بن مسعود أعرابي ونحن معه فقال السلام عليك ك يا أبا عبد الرحمن فضحك فقال صدق الله ورسوله سمعت رسول الله صلى الله عليه وسلم يقول لا تقوم الساعة حتى يكون السلام على المعرفة وإن هذا عرفني من بينكم فسلم علي وحتى تتخذ المساجد طرقا فلا يسجد لله فيها وحتى يبعث الغلام الشيخ بريدا بين الأفقين وحتى يبلغ التاجر بين الأفقين فلا يجد ربحا حدثنا الحسين بن إسحاق التستري ثنا عثمان بن أبي شيبة ثنا عبد الله بن نمير ثنا مجالد عن الشعبي عن الأسود بن يزيد قال أقيمت الصلاة في المسجد فجئنا نمشي مع عبد الله فلما ركع الناس ركع عبد الله وركعنا معه ونحن نمشي فمر رجل بين يديه فقال السلام عليك يا أبا عبد الرحمن فقال عبد الله وهو راكع صدق الله ورسوله فلما انصرف سأله بعض ض القوم لم قلت حين سلم عليك الرجل صدق الله ورسوله فقال إني سمعت رسول الله صلى الله عليه وسلم يقول من أشراط الساعة إذا كانت التحية على المعرفة PageV09P297(@)(@@) حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا إسماعيل بن أخالد عن قيس قال كان عبد الله يقول أحسنوا هذه الصلاة واقصروا هذه الخطب حدثنا أبو خليفة ثنا محمد بن كثير ثنا سفيان عن الأعمش عن أبي وائل عن عمرو بن شرحبيل عن عبد الله قال المريض الصلاة وقصر الخطبة مئنة من فقه الرجل حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن الأعمش عن شقيق عن عمرو بن شرحبيل 
ms2165	 عن عبد الله قال طول الصلاة وقصر الخطبة مئنة من فقه الرجل حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن عاصم عن شقيق عن عبد الله قال إنها ستكون عليكم كثرة يميتون الصلاة فمن أدرك ذلك منكم فليصلها لوقتها وليجعل صلاته معهم سبحه حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن أبي إسحاق عن أبي الأحوص عن بن مسعود قال إنكم في زمان قليل خطباؤه كثير علماؤه يطيلون الصلاة ويقصرون الخطبة وإنه سيأتي عليكم زمان كثير خطباؤه قليل علماؤه يطيلون الخطبة ويؤخرون الصلاة حتى يقال هذا شرق الموتى قلت له ما شرق الموتى قال إذا اصفرت الشمس جدا فمن أدرك ذلك منكم فليصل الصلاة لوقتها فإن احتبس فليصل معهم وليجعل صلاته وحده الفريضة وصلاته معهم تطوعا حدثنا الحسين بن جعفر القتات ثنا منجاب بن الحارث PageV09P298(@)(@@) ثنا علي بن مسهر عن الأعمش عن أبي عمار عن صلة بن زفر عن عبد الله قال إنه سيكون أمراء يدعون من السنة مثل هذه فإن تركتموها جعلوها مثل هذه فإن تركتموها جاؤوا بالطامة الكبرى حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن أبي حصين عن الشعبي عن مهدي قال قال بن مسعود كيف أنت يا مهدي إذا ظهر لخياركم واستعمل عليكم أحداثكم أو أشراركم وصليت الصلاة لغير ميقاتها قلت لا أدري قال لا تكن جابيا ولا عريفا ولا شرطيا ولا بريدا وصل الصلاة لميقاتها حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن منصور عن إبراهيم قال كان عبد الله يصلي معهم إذا أخروها قليلا ويرى أنهم يتحملون إثم ذلك حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن عبد الرحمن بن عبد الله عن القاسم بن عبد الرحمن قال أخر الوليد بن عقبة الصلاة فأمر بن مسعود المؤذن فثوب بالصلاة ثم تقدم فصلى بالناس فأرسل إليه الوليد ما صنعت أجاءك من أمير المؤمنين حدث أم ابتدعت فقال بن مسعود كل ذلك 
ms2166	 لم يكن ولم يأمر الله علينا ورسوله صلى الله عليه وسلم أن ننتظرك بصلاتنا وأنت في حاجتك حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن عاصم بن بهدلة عن المسيب بن رافع عن بن مسعود أنه قال إن من الجفاء أربعة ان يسمع المؤذن يقول الله أكبر الله أكبر أشهد أن PageV09P299(@)(@@) لا إله إلا الله وأشهد أن لا إله إلا الله فلا يقول مثل ما يقول وأن يمسح وجهه قبل أن يقضي صلاته وأن يبول قائما وأن يصلي وليس بينه وبين القبلة شئ يستره حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن عاصم عن المسيب رفع الحديث إلى عبد الله قال أربع من الجفاء أن يسمع الرجل المؤذن يكبر فلا يكبر ويتشهد فلا يتشهد ويمسح جبهته من التراب وهو يصلي وأن يصلي في الأرض الفضاء ليس بينه وبين القبلة سترة حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا شريك عن عاصم عن المسيب بن رافع عن عبد الله قال أربع من الجفاء وأن تمسح وجهك وأنت في الصلاة وأن تصلي إلى غير سترة وأن تبول قائما وأن تسمع المؤذن ولا تقول كما يقول حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن الأعمش عن زيد بن وهب قال جاء رجل إلى عبد الله فقال يا أبا عبد الرحمن إني نمت عن صلاة الفجر حتى طلعت الشمس فقال له عبد الله توضأ أحسن ما كنت متوضئا وصل أحسن ما كنت مصليا قال فرأى أن عبد الله لم يفهم من كبر ما أتى قال فعاد فقال يا أبا عبد الرحمن إني نمت عن صلاة الفجر حتى طلعت الشمس فقال له عبد الله توضأ أحسن ما كنت متوضأ وصل أحسن ما كنت مصليا فسكت حتى إذا خف من عنده قال له يا أبا عبد الرحمن إني نمت عن صلاة الفجر حتى طلعت الشمس قال فأخذ عبد الله بأصبعه فعصرها 
ms2167	 ثم قال إنما قيل لك لتعقل توضأ أحسن ما كنت متوضئا وصل أحسن ما كنت مصليا حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن عيينة PageV09P300(@)(@@) ويحيى بن العلاء عن الأعمش عن زيد بن وهب قال أتى رجل بن مسعود ثم ذكر مثل حديث زائدة حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن عاصم عن زر عن عبد الله قال يصلي الرجل في ثوبين فلقيت أبي بن كعب فأخبرته فقال كلكم يجد ثوبين يصلي في ثوب واحد حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن قتادة أن بن مسعود وعائشة كانا يتطوعان في السفر قبل الصلاة وبعدها حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن الحجاج عن عبد الملك الأعور عن إبراهيم النخعي أن حذيفة قال لابن مسعود ألا تعجب من قوم بين دارك ودار أبي موسى يزعمون أنهم معتكفون فقال لعلهم أصابوا وأخطأت حدثنا علي ثنا حجاج بن المنهال ثنا أبو عوانة عن اني عن إبراهيم أن حذيفة قال لابن مسعود ألا تعجب من قوم بين دارك ودار أبي موسى يزعمون أنهم معتكفون قال فلعلهم أصابوا وأخطأت أو حفظوا ونسيت قال أما أنا فقد علمت أنه لا اعتكاف إلا في مسجد جماعة حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا سفيان (ح) وحدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن واصل الأحدب عن إبراهيم قال جاء حذيفة إلى عبد الله فقال ألا أعجبك من PageV09P301(@)(@@) ناس عكوف بين دارك وبين دار الأشعري فقال عبد الله فلعلهم أصابوا وأخطأت قال حذيفة ما أبالي أفيه أعتكف أم في سوقكم هذه وإنما الاعتكاف في هذه المساجد الثلاثة مسجد الحرام ومسجد المدينة ومسجد الأقصى وكأن الذين اعتكفوا فعاب عليهم حذيفة في مسجد الكوفة الأكبر حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن عيينة عن جامع بن أبي راشد قال سمعت أبا وائل 
ms2168	 يقول قال حذيفة لعبد الله قوم عكوف بين دارك ودار أبي موسى ألا تنهاهم فقال له عبد الله فلعلهم أصابوا وأخطئت وحفظوا ونسيت فقال حذيفة اعتكاف إلا في هذه المساجد الثلاثة مسجد المدينة ومسجد مكة ومسجد إيليا حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا سفيان ح وحدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن علي بن الأقمر عن شداد بن الأزمع قال اعتكف رجل في خيمة له فحصبه الناس فأرسل الرجل إلى عبد الله بن مسعود فجاء عبد الله فطرد الناس وحسن ذلك حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن عبد الملك بن عمير عن كردوس قال كان عبد الله بن مسعود يكبر في الضحى والفطر تسعا تسعا يبدأ فيكبر أربعا ثم يقرأ ثم يكب واحدة فيركع بها ثم يقوم في الركعة الآخرة فيبدأ فيقرأ ثم يكبر أربعا يركع بإحداهن حدثنا محمد بن عبد الله الحضرمي ثنا مسروق بن المرزبان ثنا بن أبي زائدة عن أشعث عن كردوس قال أرسل الوليد إلى PageV09P302(@)(@@) عبد الله بن مسعود وحذيفة وأبي مسعود وأبي موسى الأشعري بعد العتمة فقال إن هذا عيد المسلمين فكيف الصلاة فقالوا سل أبا عبد الرحمن فسأله فقال يقوم فيكبر أربعا ثم يقرأ بفاتحة الكتاب وسورة من المفصل ثم يكبر ويركع فتلك خمس ثم يقوم فيقرأ بفاتحة الكتاب وسورة من المفصل ثم يكبر أربعا يركع في آخرهن فتلك تسع في العيدين فما أنكره واحد منهم حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن حماد عن إبراهيم أن الوليد بن عقبة دخل المسجد وابن مسعود وحذيفة وأبو موسى في عرصة المسجد فقال الوليد إن العيد قد حضر فكيف أصنع فقال بن مسعود تقول الله أكبر وتحمد الله وتثني عليه وتصلي على النبي صلى الله عليه وسلم وتدعو الله ثم تكبر وتحمد الله وتثني عليه وتصلي على النبي صلى الله عليه وسلم ثم تكبر وتحمد الله وتثني 
ms2169	 عليه وتصلي على النبي صلى الله عليه وسلم وتدعو الله ثم تكبر وتحمد الله وتثني عليه وتصلي على النبي صلى الله عليه وسلم وتدعو ثم كبر واقرأ بفاتحة الكتاب وسورة ثم كبر واركع واسجد ثم قم فاقرأ بفاتحة الكتاب وسورة ثم كبر وأحمد الله واثن عليه وصل على النبي صلى الله عليه وسلم وادع ثم كبر وأحمد الله واثن عليه وصلي على النبي صلى الله عليه وسلم واركع واسجد قال فقال حذيفة وأبو موسى أصاب حدثنا إسحاق بن إبراهيم الدبري عن عبد الرزاق عن معمر عن أبي إسحاق عن علقمة والأسود بن يزيد قالا كان بن مسعود جالسا وعنده حذيفة وأبو موسى فسألهم سعيد بن العاص عن التكبير في الصلاة يوم الفطر والأضحى فجعل هذا يقول سل هذا وهذا PageV09P303(@)(@@) يقول سل هذا حتى قال له حذيفة سل هذا لعبد الله بن مسعود فسأله فقال بن مسعود يكبر أربعا ثم يقرأ ثم يكبر فيركع ثم يكبر في الثانية فيقرأ ثم يكبر أربعا بعد القراءة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن أبي إسحاق عن علقمة والأسود بن يزيد أن بن مسعود كان يكبر في العيدين تسعا أربعا قبل القراءة ثم يكبر فيركع وفي الثانية يقرأ فإذا فرغ كبر أربعا ثم ركع حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن الأسود وعلقمة ومسروق عن عبد الله أنه كان يكبر بتسع في الأضحى والفطر يقوم فيكبر أربعا ثم يقرأ ثم يكبر واحدة فيركع بها ثم يقوم فيقرأ ويكبر أربعا يركع بواحدة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن جريج عن عبد الكريم بن أبي المخارق عن إبراهيم النخعي عن علقمة بن قيس وعن الأسود بن يزيد عن بن مسعود انه كان يكبر في الأولى خمسا بتكبيرة الركعة وبتكبيرة الاستفتاح وفي الأخرى أربعا بتكبيرة الركعة حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق ثنا عبد الله 
ms2170	 بن أبي موسى عن أبيه حين دعا بهم سعيد بن العاص دعى أبا موسى وحذيفة وعبد الله بن مسعود عند الفجر قبل أن يصلي الغداة فسألهم عن التكبير يوم العيد فقال حذيفة سل الأشعري فقال الأشعري سل عبد الله فإنه أعلمنا وأقدمنا فسأله فقال تفتح بأربع وتختم بأربع وتكبر واحدة ثم تضيف إليها ثلاثا ثم PageV09P304(@)(@@) تكبر فتركع فإذا رفعت من السجدة قرأت ثم كبرت أربعا ثم تركع حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا سفيان عن علي بن الأقمر عن أبي عطية عن عبد الله قال التكبير في العيدين أربعا كالصلاة على الميت حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن جريج أخبرني عبد الكريم النخعي عن علقمة والأسود عن بن مسعود قال إن بين كل تكبيرتين قدر كلمة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن أيوب عن بن سيرين أن بن مسعود وحذيفة كانا ينهيان الناس أو قال يجلسان ميرياه يصلي قبل خروج الإمام في العيد حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن أيوب وهشام عن محمد أن بن مسعود وحذيفة كانا ينهيان الناس يوم العيد عن الصلاة قبل خروج الإمام حدثنا محمد بن النضر الأزد ثنا معاوية بن عمرو ثنا زائدة عن هشام عن محمد قال أنبئت أن بن مسعود وحذيف كانا يقومان في النحر والفطر فينهيان أن يصلي أحد قبل الإمام حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا يزيد بن إبراهيم ثنا محمد بن سيرين نبئت أن بمسعود وحذيفة أحدهما أو كلاهما قام قائما فنهى الناس عن الصلاة يوم العيد قبل خروج الإمام PageV09P305(@)(@@) حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد عن حماد عن إبراهيم ان بن مسعود كان لا يصلي قبلها ويصلي بعدها أربع ركعات حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن أيوب عن بن سيرين وقتادة أن بن مسعود كان يصلي بعدها أربع 
ms2171	 ركعات أو ثمان وكان لا يصلي قبلها حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن صالح عن الشعبي قال كان بن مسعود يصلي بعد العيدين أربعا حدثنا محمد بن علي بن شعيب السمسار ثنا خالد بن خداش ثنا عيسى بن يونس عن حريث عن الحكم عن إبراهيم عن علقمة عن عبد الله أنه كان يصلي بعد العيدين أربعا حدثنا إسحاق عن عبد الرزاق عن الثوري عن مطرف عن الشعبي قال قال عبد الله بن مسعود من فاته العيد فليصل أربعا حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن سفيان عن مطرف عن الشعبي قال قال عبد الله بن مسعود من فاته العيد فليصل أربعا حدثنا إبراهيم بن محمد بن برة الصنعاني ثنا عبد الرزاق أنا الثوري عن أبي إسحاق عن الأسود عن بن مسعود أنه كان يكبر من صلاة الغداة يوم عرفة إلى صلاة العصر من يوم النحر PageV09P306(@)(@@) حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن جريج أخبرني عبد الكريم أبو أمية عن إبراهيم النخعي عن علقمة والأسود عن بن مسعود في زكاة الفطر قال الفساد من قمح أو صاع من تمر أو شعير حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن الحجاج عن الأعمش عن عمارة بن عمير التيمي عن عبد الرحمن بن يزيد قال اغتسلت مع بن مسعود يوم عرفة تحت الأراك حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا شعبة أخبرني الحكم وحماد عن إبراهيم قال كان عبد الله يقول التكبير أيام التشريق بعد صلاة الصبح من يوم عرفة إلى بعد العصر من يوم النحر حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن أصحاب عبد الله عن عبد الله أنه كان يكبر صلاة الغداة من يوم عرفة ويقطع صلاة العصر من يوم النحر يكبر إذا صلى العصر قال وكان يكبر الله أكبر الله أكبر لا 
ms2172	 إله إلا الله والله أكبر الله أكبر ولله الحمد حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن الأعمش عن إبراهيم قال قال عبد الله بن مسعود إذا نودي الولاء من يوم الجمعة فاسعوا إلى ذكر الله قال عبد الله لو قرأتها فاسعوا لسعيت حتى يسقط ردائي وكان يقرؤها فامضوا حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن قتادة قال في حرف بن مسعود فامضوا إلى ذكر الله وهي كقوله إن PageV09P307(@)(@@) سعيكم لشتى حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة أنا حماد عن إبراهيم عن بن مسعود أنه سأل أبي بن كعب ونبي الله صلى الله عليه وسلم يخطب عن آية من كتاب الله فأعرض عنه ولم يرد عليه فلما قضى صلاته قال إنك لم تجمع فسأل بن مسعود رسول الله صلى الله عليه وسلم فقال صدق أبي حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا إبراهيم بن المهاجر الأسماء عن إبراهيم قال استقرأ رجل عبد الله بن مسعود والإمام يخطب يوم الجمعة فلم يكلمه عبد الله فلما قضى الصلاة قاله عبد الله الذي سألت عنه نصيبك من الجمعة حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا الركين بن الربيع ها عن أبيه عن عبد الله قال كفى لغوا أن تقول لصاحبك أنصت إذا خرج الإمام في الجمعة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن الحسن بن عبيد الله قال صليت أنا وزر فأمني وفاتتنا الجمعة فسألت إبراهيم فقال فعل ذلك عبد الله بعلقمة والأسود قال سفيان وربما فعلته انا والأعمش حدثنا الحسين بن جعفر القتات الكوفي ثنا منجاب بن الحارث ثنا علي بن مسهر عن الأعمش عن أبي إسحاق عن أبي الأحوص عن عبد الله قال من أدرك من الجمعة ركعة فليضف إليها أخرى ومن فاتته الركعتان فليصل أربعا PageV09P308(@)(@@) حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن 
ms2173	 أبي إسحاق عن أبي الأحوص عن بن مسعود قال من أدرك الركعة فقد أدرك الجمعة ومن لم يدرك الركعة فليصل أربعا حدثنا محمد بن النضر ثنا معاوية بن عمرو ثنا زائدة قال سئل أبو إسحاق السبيعي أذكرت عن أبي الأحوص أن عبد الله قال من أدرك الركعتين أو أحدهما فقد أدرك الجمعة ومن فاتته الركعتان فليصل أربعا قال نعم حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن أبي الأحوص عن عبد الله قال من أدرك الخطبة فالجمعة ركعتان ومن لم يدركها فليصل أربعا ومن لم يدرك الركعة فلا يعتمد بالسجدة حتى يدرك الركعة حدثنا إسحاق بن إبراهيم ثنا عبد الرزاق أنا معمر عن أبي إسحاق عن هبيرة بن يريم عن بن مسعود قال من فاتته الركعة الأخرى فليصل أربعا قال معمر قال قتادة يصلي أربعا فقيل لقتادة إن بن مسعود جاءوهم جلوس في آخر الصلاة فقال لأصحابه اجلسوا أدركتم إن شاء الله قال قتادة إنما يقول أدركتم الأجر حدثنا محمد بن النضر ثنا معاوية بن عمرو ثنا زائدة ثنا عطاء بن السائب عن أبي عبد الرحمن قال كان عبد الله بن مسعود يعلمنا أن نصلي أربع ركعات بعد الجمعة حتى سمعنا قول علي صلوا PageV09P309(@)(@@) ستا قال أبو عبد الرحمن فنحن نصلي ستا قال عطاء أبو عبد الرحمن يصلي ركعتين ثم أربعا حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن عطاء بن السائب عن أبي عبد الرحمن السلمي قال كان بن مسعود يأمرنا أن نصلي قبل الجمعة أربعا وبعدها أربعا حتى جاء علي رضي الله عنه فأمرنا أن نصلي بعدها ركعتين ثم أربعا حدثنا علي بن عبد العزيز ثنا حجاج ثنا همام عن عطاء بن السائب عن أبي عبد الرحمن قال كان بن مسعود يأمرنا أن نصلي قبل الجمعة أربعا وبعدها أربعا حتى جاء علي فأمرنا أن نصلي بعدها ركعتين ثم أربعا حدثنا علي بن عبد العزيز ثنا حجاج ثنا همام عن 
ms2174	 عطاء عن أبي عبد الرحمن قال أمرنا بن مسعود أن نصلي بعد الجمعة أربعا قال فلما جاء علي قال اجعلوها ستا حدثنا محمد بن النضر ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن علقمة بن قيس أن بن مسعود صلى يوم الجمعة بعدما سلم الإمام أربع ركعات حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن أبي إسحاق أن بن مسعود كان يصلي قبل الجمعة أربع ركعات وبعدها أربع ركعات قال أبو إسحاق وكان علي يصلي بعد الجمعة ست ركعات PageV09P310(@)(@@) حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن قتادة أن بن مسعود كان يصلي بعد الجمعة أربعا حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن الأعمش ثنا زيد بن وهب قال كنا نصلي الجمعة مع عبد الله ثم نرجع فنقيل حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن يحيى بن العلاء عن الأعمش عن زيد بن وهب قال كنا نجمع مع بن مسعود ثم نرجع فنقيل حدثنا محمد بن عبدوس بن كامل السراج ثنا علي بن الجعد ثنا شعبة عن إسماعيل بن أبي خالد عن أبي عمرو الشيباني قال رأيت عبد الله بن مسعود يعس المسجد صارت فلا يرى فيه سوادا إلا أخره إلا رجلا قائما يصلي حدثنا محمد بن عبدوس بن كامل ثنا علي بن الجعد ثنا شعبة عن أبي قيس قال سمعت هزيل بن شرحبيل قال جاء بن مسعود إلى مسجدنا وأقيمت الصلاة فقيل له تقدم فقال يتقدم إمامكم قلنا إمامنا ليس ههنا قال ليتقدم رجل منكم فتقدم رجل فقام على دكان في قبلة المسجد فنهاه عبد الله حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا سفيان عن أبي قيس عن هزيل بن شرحبيل عن عبد الله أنه كره أن يؤمهم على المكان المرتفع حدثنا علي بن عبد العزيز ثنا أبو نعيم ثنا سفيان عن PageV09P311(@)(@@) عبد العزيز بن رفيع عن شداد بن معقل قال قال عبد الله أول 
ms2175	 ما تفقدون من دينكم الأمانة وآخر ما يبقى الصلاة وليصلين قوم لا دين لهم حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن الأسود بن يزيد وعلقمة ومسروق أن عبد الله قال الصيام من رؤية الهلال إلى رؤيته فإن خفي عليكم فثلاثون يوما حدثنا محمد بن النضر ثنا أبو غسان مالك بن إسماعيل ثنا قيس بن الربيع أنا عتبة بن عمار عن بن عياش عن أبيه قال أتيت عبد الله بن مسعود فقلت صام ناس من الحي وناس من جيراننا اليوم قال عن رؤية الهلال قال لا قال لأن أفطر يوما من رمضان ثم أقضيه أحب إلي من أن أصوم يوما من شعبان حدثنا إسحاق بن إبراهيم الدبري عن عبد الرزاق عن الثوري عن جامع بن شداد ثنا عبد الله بن مرداس قال جاءني رجل من الحي فقال إني مررت بامرأتي في القمر فأعجبتني فجامعتها في شهر رمضان فنمت حتى أصبحت فقلت عليك بعبد الله بن مسعود أو بابي حكيم المزني فإذا عبد الله بن مسعود فسألته فقلت إني كنت جنبا فقال كنت جنبا لا يحل لك الصلاة فاغتسلت فحلت لك الصلاة وحل لك الصيام فصم حدثنا محمد بن عبد الله الحضرمي ثنا أحمد بن يونس ثنا يعلى بن الحارث المحاربي قال سمعت جامع بن شداد أبا صخرة يحدث عن عبد اللبن مرداس أنه جاء إلى مسجد الحي بعدما صلوا الفجر فقال لهم وذاك في رمضان إني أصبت من أهلي ثم غلبتني PageV09P312(@)(@@) عيني فأصبحت ولم أغتسل فما ترون فقال له القوم ما نراك إلا قد أفطرت فانطلق إلى عبد الله بن مسعود فقال لهم أتيت من هو خير منكم أو أفقه فقال إنما الإفطار من الطعام والشراب فأتم صومك حدثنا عمر بن حفص السدوسي ثنا عاصم بن علي ثنا المسعودي ثنا جامع بن شداد عن الأسود بن هلال قال أتى عبد الله بن مسعود رجل فقال يا أبا عبد الرحمن إني كنت جنبا فلم 
ms2176	 اغتسل حتى أصبحت فقال عبد الله كنت جنبا لا تحل لك الصلاة فاغتسلت فحلت لك الصلاة وحل لك الصيام وذلك في رمضان حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة عن هشام قال قال محمد بن سيرين حدثني يحيى بن الجزار عن عبد الله بن مسعود قال لو أتيت امرأة من الليل ثم تركت الغسل عمدا حتى مطرف لم يمنعن من الصوم إنما أتيتها وهي تحل لي حدثنا علي بن عبد العزيز ثنا عارم أبو النعمان ثنا حماد بن زيد عن أيوب وهشام عن محمد بن سيرين عن يحيى بن الجزار أن بن مسعود قال لو أتيت امرأة من الليل ثم تركت الغسل عمدا حتى مطرف لم يمنعني ذلك من الصوم لأني إنما أتيتها وهي تحل لي حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد أنا أيوب وهشام عن محمد بن سيرين أن بن مسعود قال لو أتيت أهلي أول الليل ثم أصبحت جنبا لصمت لأني أتيتها وهي تحل لي حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زهير ثنا أبو إسحاق عن أبي عبيدة عن عبد الله قال لو كنت جنبا فمكثت شهرا PageV09P313(@)(@@) لا أجد الماء ما صليت حتى أجد الماء حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن منصور عن هلال بن يساف عن الهرمزان عن بن مسعود في الرجل يقبل وهو صائم قال يقضي يوما مكانه قال سفيان لا يؤخذ بهذا حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن بن عيينة عن زكريا عن الشعبي عن عمر بن شرحبيل أن بن مسعود كان يباشر امرأته نصف النهار وهو صائم حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن واصل الأحدب عن اني بن عبد الله اليشكري عرجل قال قال بن مسعود من أفطر يوما من رمضان من غير رخصة لقي الله به وان صام الدهر كله إن شاء ورجاله له وإن شاء عذبه حدثنا علي بن 
ms2177	 عبد العزيز ثنا أبو نعيم ثنا سفيان عن واصل الأحدب عن اني بن عبد الله اليشكري عن بلال بن الحارث قال قال عبد الله من أفطر يوما من رمضان فذكر مثله حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري أخبرني وائل بن داود عن إبراهيم عن عبد الله بن مسعود قال إنما الصيام مما دخل وليس مما خرج والوضوء مما خرج وليس مما دخل حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن أبي سفيان PageV09P314(@)(@@) وكيع عن مسعر عن جبلة بن سحيم عن عامر بن مطير الشيباني عن أبيه قال تسحرنا مع عبد الله ثم خرجنا فأقيمت الصلاة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن أبي إسحاق عن قيس بن أبي حازم عن بن مسعود قال إذا عرض على أحدكم طعام أو شراب وهو صائم فليقل إني صائم حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن الأعمش عن إبراهيم عن الأسود قال قال عبد الله بن مسعود تحروا ليلة القدر ليلة سبع عشرة صبيحة بدر أو إحدى وعشرين ليلة أو ثلاث وعشرين حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن عاصم عن زر بن حبيش قال قلت أبا المنذر يعني أبي بن كعب أخبرني عن ليلة القدر فإن بن أم عبد يقول من يقم الحول يصبها قال يرحم الله أبا عبد الرحمن لقد علم أنها في رمضان ولكنه عمى على الناس حتى لا يتكلموا والذي أنزل الكتاب على محمد صلى الله عليه وسلم إنها لفي رمضان وإنها ليلة سبع وعشرين قلت أبا المنذر إني علمت ذلك قال بالآية التي أخبرنا رسول الله صلى الله عليه وسلم فقد رأينا وحفظنا فوالله إنها لهي لا يستثنى قلت لزر وما الآية قال تطلع الشمس غداتئذ كأنها طست ليس لها شعاع حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال وعارم أبو النعمان قالا ثنا حماد بن زيد عن عاصم عن زر قال قلت لأبي بن كعب 
ms2178	 أبا المنذر أخبرني عن ليلة القدر فإن صاحبنا بن مسعود سئل عنها فقال من يقم الحول يصبها قال رحم الله أبا عبد الرحمن أما PageV09P315(@)(@@) والله لقد علم أنها في رمضان ولكنه كره أن يتكلوا أو أحب أن لا يتكلوا والله إنها لفي رمضان وإنها ليلة سبع وعشرين يحلف ولا يستثني قال قلت يا أبا المنذر أني علمت ذلك قال بالآية التي أخبرنا رسول الله صلى الله عليه وسلم قال حماد فقلت لعاصم ما الآية قال تصبح الشمس صبيحة تلك الليلة ليس لها شعاع مثل الطست حتى ترتفع حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة ثنا عاصم بن أبي النجود عن زر قال قلت لأبي أخبرني عن ليلة القدر فإن عبد الله يقول من يقم الحول يصبها قال يرحم الله أبا عبد الرحمن إنه ليعلم أنها في رمضان ولكن عمى على الناس حتى لا يتكلوا والله إنها ليلة وعشرين فقلت أبا المنذر أنى علمت ذلك قال بالآية التي أنبأنا رسول الله صلى الله عليه وسلم فعددنا وحفظنا أنها لهي قال عاصم قلت لزر ما تلك الآية قال طلوع الشمس بيضاء كالطست ليس لها شعاع حتى ترتفع قال فرمقتها مرار كذلك حدثنا محمد بن عمرو بن خالد الحراني ثنا أبي ثنا زهير ثنا عاصم بن أبي النجود عن زر بن حبيش قال لقيت أبي بن كعب وكان امرأ فيه شراسة فقلت أبا المنذر اخفض لي جناحك رحمك الله وسألته عن ليلة القدر فقال إنها في رمضان وإنها ليلة سبع وعشرين قلت وأنى علمت ذلك قال بالآية التي أخبرنا رسول الله صلى الله عليه وسلم فعددنا وحفظنا فوالله إنها لهي لا يستثني حدثنا أبو شعيب عبد الله بن الحسن الحراني ثنا عبد الله بن حفص الرقي ثنا عبيد الله بن عمرو عن زيد بن أبي أنيسة عن عاصم عن زر بن حبيش عن أبي بن كعب قال ليلة القدر ليلة سبع وعشرين قلت يا أبا المنذر أنى علمت ذلك 
ms2179	 قال بالآية التي حدثنا رسول الله صلى الله عليه وسلم فحفظتها وعددتها والذي أنزل الكتاب على محمد إنها ليلة سبع وعشرين PageV09P316(@)(@@) حدثنا محمد بن عبدوس بن كامل ثنا سريج بن يونس ثنا أبو حفص الأبار عن منصور بن المعتمر عن عاصم بن أبي النجود عن زر بن حبيش قال وفدت إلى عثمان فلقيت أبي بن كعب فقلت له حدثني فإني قد كنت أحب لقيك وما وفدت إلى لقائك فحدثني عن ليلة القدر فإن بن مسعود يقول من يقم السنة يصبها أو يدركها فقال أبي لقد علم أنها في رمضان ولكنه أحب أن يعمي عليكم فإنها ليلة سبع وعشرين بالآية التي حدثنا بها رسول الله صلى الله عليه وسلم فحفظناها بالقرامطة كان رسول الله صلى الله عليه وسلم يواصلها إلى السحر فإذا كان قبلها بيوم وبعدها بيوم صعد فنظر إلى الشمس وقال إنها تطلع الشمس صبيحتها ولا شعاع لها حتى ترتفع حدثنا أحمد بن عمرو البزار ثنا محمد بن يزيد الرواس ثنا حاتم بن وردان عن يونس بن عبيد عن عاصم عن زر قال قال رجل لأبي بن كعب إن عبد الله بن مسعود يقول في ليلة القدر من يقم الحول يصبها فقال أبي رحم الله أبا عبد الرحمن لقد علم أنها في شهر رمضان في ليلة سبع وعشرين ولكن أحب أن لا يتكلوا حدثنا محمد بن جعفر الرازي ثنا علي بن الجعد أنا بن ثوبان عن عبدة بن أبي لبابة عن زر بن حبيش قال تذاكروا عند بن مسعود ليلة القدر فقال من قام شهر رمضان كله أدركها قال فقدمت المدينة فذكرت ذلك لأبي فقال والذي نفسي بيده إني لأعلم أي ليلة هي الليلة التي أمرنا رسول الله صلى الله عليه وسلم بقيامها قال فسألته عنها فقال ليلة سبع وعشرين قال عبدة فإذا كان الشهر ثلاثين قمنا بعدها ثلاثا وإذا كان تسعا وعشرين قمنا بعدها ليلتين حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن الأعمش عن PageV09P317(@)(@@) زيد بن 
ms2180	 وهب قال كان عبد الله يصلي بنا في شهر رمضان فينصرف بليل حدثنا محمد بن النضر الأزدي ثنا معاوية بن عمرو ثنا زائدة قال قلت لخصيف أحدثكم أبو عبيدة بن عبد الله بن مسعود عن أبيه أنه قال في خمس وعشرين من الإبل بنت مخاض فإن لم يكن فابن لبون ذكر قال نعم حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن أبيه عن همام عن ميناء أنهم جاؤوا عبد الله بن مسعود في زمن عثمان فقالوا أعطنا أعطياتنا فقال ما لكم عندي عطاء إنما عطاؤكم من فيئكم وجزيتكم والصدقة لأهلها فلما ترددوا إليه جاء بالمفاتيح إلى عثمان فرمى بها وقال إني لست بخازن حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن مجاهد عبن مسعود وسئل عن أموال اليتامى فقال إذا بلغوا فأعلموهم ما حل فيها من زكاة فإن شاؤوا زكوا وأن شاؤوا تركوا حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد عن ليث عن مجاهد عن بن مسعود قال والي اليتيم يحصي السنين فإذا قال احتلم قال له إن عليك زكاة كذا وكذا سنة حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن أبي إسحاق عن هبيرة بن يريم عن بن مسعود قال كان يعطينا العطاء ثم يأخذ زكاته PageV09P318(@)(@@) حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن معمر عن حماد عن إبراهيم عن بن مسعود قال سألته امرأة عن جلي لها أفيه زكاة قال إذا بلغ مئتي درهم فزكيه قالت إن في حجري أيتاما فأدفعه إليهم قال نعم حدثنا علي بن عبد العزيز ثنا حجاج بن المنهال ثنا حماد بن سلمة عن حماد عن إبراهيم أن امرأة بن مسعود قالت يا أبا عبد الرحمن هل في حليي زكاة قال نعم قالت فإن لي بن أخ أيتام فاجعله فيهم قال اجعليه فيهم حدثنا إسحاق بن إبراهيم عن عبد الرزاق عن الثوري عن أبي سلمة عن رجلين بينه وبين بن مسعود عن بن مسعود قال من 