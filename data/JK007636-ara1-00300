ms281	 فسطا % % بالخصب يطو بياض الصبح في السدف % % 10(@)(@@) % فاق البرية في عدل ومعرفة % % فليس عن رتب العلياء بمنصرف % % PageV01P1276 11(@)(@@) % سجية في اقتضاء الحمد ناشئة % على الندى والسدى والمجد والشرف % % 12(@)(@@) % وهمه دبر الاسلام كافلها % % تدبير متصف بالحق منتصف % % 13(@)(@@) % يا جائل الطرف في السادات منتقدا % ها قد وصلت إلى أزكاهم فقف % % 14(@)(@@) % وقد وجدت معاني الفضل باهرة % فان قدرت على أوصافها فصف % % 15(@)(@@) % دار الثناء على القطب الذي اتفقت % % فيه العقول فلا قول بمختلف % % 16(@)(@@) % لا تبغ منزل فضل بعد منزله % % من حل طيبة لم يحتج إلى النجف % % 17(@)(@@) % من معشر نجب ما زال مجدهم % يوصي به السلف الماضي إلى الخلف % % 18(@)(@@) % شاد المعالي بنوا خاقان واجتمعوا % % في واحد بمعاني البيت مكتنف % % 19(@)(@@) % قد قدمته على السادات همته % % في الفضل تقديم بسم الله في الصحف % % 20(@)(@@) % كافي الجيوش بآراء مناضلة % تكاد ترعد منها أنفس النطف % % PageV01P1277 21(@)(@@) % فلا جناح بمنهاض اذا عضدت % % من جانبيه ولا قلب بمرتجف % % 22(@)(@@) % في كفه قلم كالسيف منتصب % لكنه لبني الآداب كالهدف % % 23(@)(@@) % جار بكف سهيلي العلى فلذا % % كم في المهمات من روض له أنف % % 24(@)(@@) % أمل عطاياه واستعرض فضائله % % فما يرد جناه كف مقتطف % % 25(@)(@@) % وشم بعينك في الدنيا محاسنه % % اذا دلفت ودعنا من أبي دلف % % 26(@)(@@) % قالوا أفي بأسه أم في سماحته % % فقلت في ذا على رغم الحسود وفي % % 27(@)(@@) % يا من تحملت في أبوابه نعما % لاعيب فيها سوى أن أثقلت كتفي % % 28(@)(@@) % تهن بالمنصب الميمون طائره % % واقبل لدستك يا موسى ولا تخف % % 29(@)(@@) % واغفر جناية أيام قد اعتذرت % % وابشر بسعد على الأيام مؤتلف % % 30(@)(@@) % الله يعلم فيما أنت واجده % % ونور حظي من بشري ومن أسفي % % PageV01P1278 31(@)(@@) % لي في جنابك برج غير منقلب % اذا التجأت ونجم غير منكسف % % 32(@)(@@) % ففي ولائك توكيدي اذا اختلفت % % حال امرىء والى علياك منعطفي % % 33(@)(@@) % حلفت أنك معدوم النظير فما % % راجعت فكري وما استثنيت في حلفي % % 34(@)(@@) % بستان حسن لا عدمت قطافه % لثما يسلفني السرور سلافه % 35(@)(@@) % يختال في 
ms282	 مرح الشباب كأنما % % هزت حمائم حليه أعطافه % 36(@)(@@) % في وصفه الأغزال خص مديحها % % ملك البسيطة لا تريد خلافه % 37(@)(@@) % الناصر بن الناصر بن قلاون الم % % نصور جانس نصره أسلافه % 38(@)(@@) % خضعت لعزته الملوك وأذعنت % % لأغر أمله الزمان وخافه % 39(@)(@@) % خدمته حتى أنجم مريخها % % لو عاد كسرى ظنه سيافه % 40(@)(@@) % ولو أن ذا الاكتاف سابورا عصى % % أمرا لقطعت العصا أكتافه % PageV01P1279 41(@)(@@) % متع لواحظنا بحسنك ساعة % ودع النفوس تروح وهي توالف % % 42(@)(@@) % واجعل وعودك لي صدودا قابلا % فلقد أراك اذا وعدت تخالف % % 43(@)(@@) % ويلاه من ساج اللواحظ أهيف % % مالي عليه سوى البكاء مساعف % % 44(@)(@@) % يوم الغنى يهواه عاما كله % % بالدمع شات والصبابة صائف % % 45(@)(@@) % سل خصره عن طول ليلة شعره % % إن السقيم بطول ليل عارف % % 46(@)(@@) % أسفي للدراهم الحلبيا % % ت فقد فرحت حشاي وطرفي % % 47(@)(@@) % أكلتني كفي عليها مرارا % % وعليها أصبحت آكل كفي % % 48(@)(@@) % يا لها حالة تكدر عيشي % % وزمان في وجه قصدي يصفي % % 49(@)(@@) % أقول لمن يتشكي الخطوب % % ويحذر من موبقات الصروف % % 50(@)(@@) % عليك بأبواب سيف العلا % % ملاذ الفقير وأمن المخوف % % PageV01P1280 51(@)(@@) % تجد ظله جنة والجنان % % بلا شك تحت ظلال السيوف % % 52(@)(@@) % هنئتها خلع السيادة والتقى % % والبر والبركات والالطاف % % 53(@)(@@) % وبقيت ممدوح العلا عينا لها % % ألف الندى ولكل ملك كافي % % 54(@)(@@) % يا صاحب القلم الذي في بابه % % عرف وعرف ندى بغير خلاف % % 55(@)(@@) % خليلي كفا عني الشغل بالهوى % % فعندي من فقد الصبا شاغل كافي % % 56(@)(@@) % صفا لون شيبي ثم كدر عيشتي % % فيا عجبا للشيب من كدر صافي % % 57(@)(@@) % ومرخى على الاكتاف يضحك من يرى % % فأواه من شيب يقطع أكتافي % % 58(@)(@@) % جاء بالخصب الينا كافل % % آمن في عدله كل مخوف % % 59(@)(@@) % فدمشق اليوم والدنيا معا % في فنون للتهاني وصنوف % % 60(@)(@@) % جنة في ظل سيف قادم % % وكذا الجنات في ظل السيوف % % PageV01P1281 61(@)(@@) % قل للذي قد كنت معترفا % من بحر أنعمه ومغترفا % % 62(@)(@@) % عجز اجتهاد الشكر عن منن % % قدمتها عندي فيا أسفا % % 63(@)(@@) % ان كنت لا تسدي الي يدا % حتى أقوم بشكر ما سلفا 
ms283	 % % 64(@)(@@) % وكنت اذا جفوتم أو كدرتم % % أحن اليكمو أبدا وأصفو % % 65(@)(@@) % إلى أن زرتمو فثنيت طرفي % % وعلمني جفاكم كيف أجفو % % 66(@)(@@) % فما دمعي على العادات جار % ولا قلبي على التبريج وقف % % 67(@)(@@) % بالجنك من مغنى دمشق حمائم % % في دف أشجا تشوق بلطفها % % 68(@)(@@) % فاذا أشار لها الشجي بكأسه % % غنت عليه بجنكها وبدفها % % 69(@)(@@) % أتى الملبس الصوف الذي قد بعثته % % لجبري يا أندى الأنام وتشربفي % % 70(@)(@@) % فقابله الشكران شكر قصائدي % % و سجعي والشكران من واجب الصوفي % % PageV01P1282 71(@)(@@) % تغير بدر الدين بعد مودة % و حالت به الأيام عن ذلك الوفا % % 72(@)(@@) % و دل على أن الوداد مكلف % % و لا عجب للبدر أن يتكلفا % % 73(@)(@@) % عندي غلام بعلم الحرف مشتغل % % و أي حرف إلى الفحشاء منحرف % % 74(@)(@@) % أحكى الأنام لدال في تفاجعه % % و أنفق الناس من ميم على ألف % % 75(@)(@@) % خليلي كيف الصبر عن حب شادن % % شهي اللمى ساجي للواحظ أهيف % % 76(@)(@@) % يحاول بدر التم تشبيه وجهه % % فيحسن إلا أنه يتكلف % % 77(@)(@@) % هنئت بالعيد يا من يستضيئ به % % في الناس حالي ومن بالحمد أعطفه % % 78(@)(@@) % الناس تعرف عيدا بالهلال اذا % % وافى ولكنني بالبدر أعرفه % % 79(@)(@@) % فديت رئيسا عندنا من نواله % % الوف وصد بعد ذاك خفيف % % 80(@)(@@) % فان يكن العقل الذي سآء واحدا % فافعاله اللآئي سررن ألوف % % PageV01P1283 81(@)(@@) % يا رب فاتنة الجمال غريرة % % تحمي ورأء أسنة وسيوف % % 82(@)(@@) % صغت الوعود لها صياغة ماهر % و جمعت بين خلاخل وشنوف % % 83(@)(@@) % قاضي القضاة لك اتصال سلامة % % ولحاسديك مساءة وتلاف % % 84(@)(@@) % ما كان في رجفان كفك منكر % % فالبحر من أسمائه الرجاف % % 85(@)(@@) % مملوكة عندي رومية % % كم نشفت رأسي وما من شفه % % 86(@)(@@) % بعثتها مع بعض شعري وقد % % خلصت في الحالين من منشفه % % 87(@)(@@) % يا صاحبا أسعى إلى بابه % % وأشتكي الفاقة والكلفه % % 88(@)(@@) % شهرك ذو القعدة فاهنأ به % % وارحم من المملوك ذي الوقفه % % 89(@)(@@) % أمزق قلبي في هواك تحرقا % % وجفني تسهيدا وليتك تعرف % % 90(@)(@@) % ولي أسف باد من الحزن انما % % على مثل لقياك ابن يعقوب يوسف % % PageV01P1284 91(@)(@@) % يا 
ms284	 قريرا بالمنى يا سيدي % % يا صديقا للتهاني ألفا % % 92(@)(@@) % أن ايري يا لعقبى ايركم % % كان ياء ثم أمسى ألفا % % 93(@)(@@) % أرادت تضاهي حسنه وصفاته % % بدور وغزلان فقلت لها قفي % % 94(@)(@@) % بعيشك يا غزلان لا تتعيبي % % عليه ويا أقمار لا تتكلفي % % 95(@)(@@) % و لي صديق أرجفته مدحتي % % وكالان ظني أنه لا يرتجف % % 96(@)(@@) % فقل له يابحر علم وندى % % أنا الذي لو جاء للبحر نشف % % 97(@)(@@) % خف خصر الحبيب ثم ابتلاني % % بعذول يزيدني تعنيفا % % 98(@)(@@) % ليت لو كان في الملاح كمثلي % % في هوى الخصر يؤثر التخفيفا % % 99(@)(@@) % لنون صدغك آية فتنت % % بحسنها كل طامح الطرف % % 100(@)(@@) % يسبح الله حين يبصرها % % فيا له عابدا على حرف % % PageV01P1285 101(@)(@@) % أفنى التي تاجها وقامتها % % كأنه همزة على ألف % % 102(@)(@@) % أذكر ثغرا لها فأسكر من % % ورود خد لها فأرتع في % % 103(@)(@@) % قولا لنور الدين عن خله % % خل الجفا وارجع لذاك الوفا % % 104(@)(@@) % ياحجري الوصف من نسبة % % حقا لقد عاملتني بالصفا % % 105(@)(@@) % شكرا لأنعم مولانا التي فضلت % % جهد الثناء فأبدي وجه معترف % % 106(@)(@@) % لو لم أكن للغنى أبغي تطلبها % % طلبتها كونها نوعا من الشرف % % 107(@)(@@) % يا سيدي دعوة من قوله % يا سيدي يوجب تشريفه % % 108(@)(@@) % حملت بالإحسان تثقيله % % فاحمل باحسانك تخفيفه % % 109(@)(@@) % صيرت إيري واقفا من شرطه % % إثبات عشقي واطراح مخالفي % % 110(@)(@@) % فليدر حسنك أن قلبي فيه قد % % ثبتت صبابته بشرط الواقف % % PageV01P1286 111(@)(@@) % بات انفي يشكو زكاما وقد كا % % ن التشكي من الحوادث يكفي % % 112(@)(@@) % أحمد الله لا أزال معنى % بأمور تأتي على رغم أنفي % % 113(@)(@@) % و دف أشجار سمعنا به % % ناعورة مطربة الوصف % % 114(@)(@@) % لا غرو إن شبب نظم الورى % % فيها قد غنت على الدف % % 115(@)(@@) % شافعي قل لمالكي أن في ن % % ثرة سطرين منه للفقر صرفه % % 116(@)(@@) % أترى هل يحج في وفي ق % % لبي جمار وعند حالي وقفه % % 117(@)(@@) % صرفت لجود تاج الدين قصدي % % ولم أر بعد ذا عنه انصرافه % % 118(@)(@@) % فقيل لي القرافة أشغلته % % وكم بنداه قيل لي الق رافه % % 119(@)(@@) % يا سيدي إن طاب 
ms285	 وقت ولائنا % % لفظا ففي معناه منك تعسف % % 120(@)(@@) % أنا في المدبح أشبب الوصف الذي % % أهدى وأنت على الجريح تذفف % % PageV01P1287 121(@)(@@) % قاضي القضاة حبذا تكرمة % % تنزه المملوك في صنوفها % % 122(@)(@@) % دراهم عن كلمات عددت % % فأقبلت تجري على حروفها % % 123(@)(@@) % أترى يا سادة لي كلما % % زدتهم في الود زادوا في الجفا % % 124(@)(@@) % هل كفى من فرط هجري ما جرى % % وجرى من دمع عيني ماكفى % % 125(@)(@@) % رجلي وحالي لغير نافع % % أصبح هذا لذا يخالف % % 126(@)(@@) % الرجل طول النهار تمشي % % والحال طول النهار واقف % % 127(@)(@@) % قل ليراع الإمام شيخ شيوخ الو % % قت ما حي الإعساروالحيف % % 128(@)(@@) % يا قلم العلم والبلاغة كن % % شفيع آمالنا إلى السيف % % 129(@)(@@) % علقته ساجي اللواحظ أهيفا % % وبليتي ساجي اللواحظ أهيف % % 130(@)(@@) % قلبي الجريح مشبب بصفاته % % في الحسن وهو على الجريح يذفف % % PageV01P1288 131(@)(@@) % يقول لي امرؤ كتاب مصر % % بأخبار لها وقت منيف % % 132(@)(@@) % فهل عجزا احتيالك أن تهيئ % % لهم خبزا فقلت ولا رغيف % % 133(@)(@@) % ألا رب أحباب شغلت بحبهم % % زمان إلى أن غيروا بيننا الصفة % % 134(@)(@@) % فسليت قلبي من يديهم وعنهمو % % ونشفت دمعي من هواهم بمنشفه % % 135(@)(@@) % حملت الي شخصي الحباب وكاد من % % أذى البرد لا من زهرة يتقصف % % 136(@)(@@) % و كنت بفقري لا بعتقي أشتكي % % وأعجز عن حمل القميص وأضعف % % PageV01P1289 البحر : - 1(@)(@@) % عوذت شعرك بالظلام وما وسق % % وسناك بالقمر المنيراذا اتسق % % 2(@)(@@) % آها لها من طلعة في طرة % % لاحت فلا لاح الصباح ولا الغسق % % 3(@)(@@) % وهلال تم طالع في سعده % % لكن نجم حشاي فيه قد احترق % % 4(@)(@@) % رشأ وجدت العذل فيه باطلا % % لما وجدت بمقلتيه السحر حق % % 5(@)(@@) % زعم المشنع أنني واصلته % % ليت المشنع عن تواصلنا صدق % % 6(@)(@@) % بأبي الذي أجريت أحمر أدمعي % % في حبه فاذا ابتغى أمدا سبق % % 7(@)(@@) % يا للجوانح والبكاء تطابقا % % هذي مقيدة وذاك قد انطلق % % 8(@)(@@) % قم يا غلام وهاتها في حبه % % صفراء مشرقة كما وضح الشفق % % 9(@)(@@) % هذي الحمائم في منابر أيكها % % تملي الغنى والطل يكتب في الورق % % 10(@)(@@) % والقضب تخفض للسلام رؤسها % % والزهر يرفع 
ms286	 زائريه على الحدق % % PageV01P1290 11(@)(@@) % فعسى تجدد لي زمان تواصل % % قد كان في اللذات معنى مسترق % % 12(@)(@@) % لا تسمعن بأن قلبي قد سلا % % ذاك الزمان وذاك قول مختلق % % 13(@)(@@) % تتخالف الاخبار لكن الندى % % خبر عن الملك المؤيد متفق % % 14(@)(@@) % ملك خزائن ماله وعداته % % تشكو بأيديه التفرق والفرق % % 15(@)(@@) % البحر في كفيه أو في صدره % % فانهل وان ناويته فاخش الغرق % % 16(@)(@@) % ذاك الذي بالناس يفدى شخصه % % ويعاذ في ظلم الحوادث بالفلق % % 17(@)(@@) % للسيف في يمنى يديه جدول % % فلذا يفيض على جوانبه العلق % % 18(@)(@@) % وبكفه القلم الذي لا يشتكي % % فتق الامور لفضله الا رتق % % 19(@)(@@) % تجري البحار فلورمى بحر به % % لا نشق ذاك البحر غيظا وانفلق % % 20(@)(@@) % فيه مآرب للعلوم وللندى % % ان فاض راق وان أفاض القول رق % % PageV01P1291 21(@)(@@) % كالغصن يستحلى سنا أزهاره % % ويجود بالثمر الجني وينتشق % % 22(@)(@@) % فاز امرؤ ألقى يمين رجائه % % لمقام إسماعيل يوما واعتلق % % 23(@)(@@) % المرتجي والافق محجوب الحيا % % والملتجا والدهر مرهوب الحنق % % 24(@)(@@) % لله كم خضعت لعليا مجده % % رأس وكانت ذات صول لم يطق % % 25(@)(@@) % سارت سيادته وأمعن شوطها % % فغدت على الاعناق واصلة العنق % % 26(@)(@@) % وأراد أن يجري إلى غاياته % % صوب الحيا فلذاك ألجمه العرق % % 27(@)(@@) % النصر والدنيا الخصيبة والهدى % % ان صال أو بذل الصنائع أو نطق % % 28(@)(@@) % لاقيته فشفى رجاي وعانقت % % كفاي من جدواه أطيب معتنق % % 29(@)(@@) % وروائح المعروف لا تخفى على % % حال فشموا من أناملي العبق % % 30(@)(@@) % يا أيها الملك المؤيد دعوة % تذر العداة بغيظها تشكو الحرق % % PageV01P1292 31(@)(@@) % واصلت قصدي باللهى وقطعت ما % % بيني وبين بني الزمان من العلق % % 32(@)(@@) % فلأشكرن جميل ما أوليتني % % شكر الرياض الزهر للماء الغدق % % 33(@)(@@) % بمدائح أهلتني لنظامها % % فغدت محررة وعنقي مسترق % % 34(@)(@@) % درر خدمت بها علاك وانما % % عطفت على درر العلى عطف النسق % % PageV01P1293 البحر : - 1(@)(@@) % مابت فيك بدمع عيني أشرق % % إلا وأنت من الغزالة أشرق % % 2(@)(@@) % يا من تحكم في الجوارح حسنه % % فالقلب يؤسر والمدامع تطلق % % 3(@)(@@) % أنفقت عيني في البكاء وحبذا % % عين على مرآى جمالك تنفق % % 4(@)(@@) % وأخافني فيك العذول 
ms287	 ومادرى % % إني لجودك في الهوى أتشوق % % 5(@)(@@) % قسما بمن جعل الأسى بك لذة % والدمع راحة من يحب ويعشق % % 6(@)(@@) % إن العذول هو الغني وأن من % % يفني عليك حياته لموفق % % 7(@)(@@) % لي من نصيب هواك سهم وافر % وسهام سحر من جفونك ترشق % % 8(@)(@@) % يمتار من دمعي عليك ذوو البكا % % فاعجب له من سائل يتصدق % % 9(@)(@@) % ولقد سقيت بكأس فيك مدامة % % في غيظ لوامي عليك فلا سقوا % % 10(@)(@@) % وضممت من عطفيك غصن ملاحة % بالحلي يزهر والغلائل تورق % % PageV01P1294 11(@)(@@) % وقرأت في خديك بعد تأمل % % خطا به حب القلوب معلق % % 12(@)(@@) % ورزقت من جفنيك ما حسد الورى % % حظي عليه وهو رزق ضيق % % 13(@)(@@) % ونعمت باللذات وهي جديدة % ولبست ضوء الراح وهو معتق % % 14(@)(@@) % في ليل أفراح كأن هلاله % % للشرب ما بين الندامى زورق % % 15(@)(@@) % يا حبذا ليل نبيع به الكرى % % لكننا لا عن رضى نتفرق % % 16(@)(@@) % حيث الشباب إلى المسرة راكض % % لا يستقر وطالب لا يرفق % % 17(@)(@@) % سقيا لأوقات الشبيبة إنها % % أوفى لمطلب السرور وأوفق % % 18(@)(@@) % ما سرني أن الكميت تحثها % % نحوي السقاة وأن فودي أبلق % % 19(@)(@@) % عني بكأسك يا نديم فإن لي % % جفنا مدامعه أرق وأروق % % 20(@)(@@) % زال الصبا ونأى الحبيب فعادني % % أرق على أرق ومثلي يأرق % % PageV01P1295 21(@)(@@) % وكأن عيني راحة ملكية % % حلف النوال بأنها لاتطبق % % 22(@)(@@) % نشأ النوال الأفضلي فلم نسل % % في الأفق هل نشأ الغمام المغدق % % 23(@)(@@) % إن كان في الكرماء رسل سماحة % فمحمد منها الأخير الأسبق % % 24(@)(@@) % ملك أقام على حماه وذكره % بالمكرمات مغرب ومشرق % % 25(@)(@@) % ماضره والفعل فعل باهر % % طلب السهى والاصل أصل معرق % % 26(@)(@@) % من أسرة تقوية حظ الأولى % % يوم الفخار لقهرها أن يتقوا % % 27(@)(@@) % النجم بعض ديارهم فلينزلوا % % والنجم بعض حدودهم فليرتقوا % % 28(@)(@@) % إن فاخروا بقديمهم لم يدفعوا % % أو سابقوا بجديدهم لم يلحقوا % % 29(@)(@@) % إن يفن ماضيهم على سنن الردى % % فكأنهم ببقاء أفضلهم بقوا % % 30(@)(@@) % الأرض واسعة بجدوى ملكهم % % والعدل في أيامه متوثق % % PageV01P1296 31(@)(@@) % ملأت موافقة القلوب مهابة % % فالقلب قبل الطرف فيها مطرق % % 32(@)(@@) % وكأنما صور الوقوف 
ms288	 أمامه % % صور الدمى فمواثل لا تنطق % % 33(@)(@@) % سار على منهاج اسرة بيته % % ترجو البرية حالتيه وتفرق % % 34(@)(@@) % لا عيب فيه سوى عزائم قصرت % % عنها الكواكب وهي بعد تحلق % % 35(@)(@@) % وندى تتابع وفده حتى اشتكت % % نفحات أنعمه الفلا والاينق % % 36(@)(@@) % فياض سيب حين يزهى مجلس % % وخضيب سيف حين يعرو فيلق % % 37(@)(@@) % تلقاه بين مهابة ولطافة % % كالسيف فيه مضا وفيه رونق % % 38(@)(@@) % وتراه من لمع الاسنة سافرا % كالبدر بين كواكب تتألق % % 39(@)(@@) % حيث الغضا بين السلاح كأنه % % لج تحقق بنده يترقرق % % 40(@)(@@) % والطير تقربها الظبا فمن السماء % % والأرض تغشاه الضيوف وتطرق % % PageV01P1297 41(@)(@@) % يا أيها الملك المكمل فضله % % وقيت من حدق اليك تحدق % % 42(@)(@@) % وبقيت للمداح تجلب عيسهم % % جلبا بغير بلادكم لا ينفق % % 43(@)(@@) % اذكرتنا زمن المؤيد لا غدت % % مثواه باكية الغمام تشهق % % 44(@)(@@) % حتى تجربه ذيول حديقة % % أكمامها بيد النسيم تفتق % % 45(@)(@@) % علياك علياه وخلقك خلقه % % فاهنأ بلبس مدائح لا تخلق % % 46(@)(@@) % وقدوم عيد كان من طرب إلى % % لقياك تخترق الصيام وتسبق % % 47(@)(@@) % وبديعة كالروض الا أنها % % تجلى بجارحة السماع وتعشق % % 48(@)(@@) % نظمتها عقدا لمثل مثاله % % في النظم شاب من الوليد المفرق % % 49(@)(@@) % وتلوت قاف معوذا من قافها % % خوفا عليه من النواظر أشفق % % 50(@)(@@) % لا فضل لي فيها وبحرك قاذف % % درر الصفات تقول للخلق انفقوا % % PageV01P1298 51(@)(@@) % من عش بيتك قد درجت وطار لي % % في الخافقين جناح ذكر يخفق % % 52(@)(@@) % وبكم علمت من القريض صناعة % % ما كنت لولاكم بها أتعلق % % 53(@)(@@) % لكم الولا مني لأن نداكم % % من كل حادثة له في معتق % % PageV01P1299 البحر : - 1(@)(@@) % بطيفك يابدر والطارق % % ومسبل شعرك والغاسق % % 2(@)(@@) % وقدك يا غصن واللحظ من % % رشيق يميس ومن راشق % % 3(@)(@@) % وطلق جبين قضى حسنه % % ببين على سلوتي الطالق % % 4(@)(@@) % أغث بأيادي الرضا مغرما % دعاك وخذ بيد العاشق % % 5(@)(@@) % فقد تعبت عينه في الهوي % % بانسانها السابح الغارق % % 6(@)(@@) % وعاقبها سيد ظالم % % عليها بذنب الكرى الآبق % % 7(@)(@@) % سكاب دموع جرت في مدا % % بكاها فأعيت على الآحق % % 8(@)(@@) % وسهر روى من بكاءي الذي % % تدفق عن 
ms289	 جعفر الصادق % % 9(@)(@@) % وأمرد نشوان أما لقاه % % لعمري فمعذرة الفاسق % % 10(@)(@@) % منعم جسما ولكنني % % شقيت بمنظره الشقائق % % PageV01P1300 11(@)(@@) % وذي إمرة سار للقيل في % % جناحي لوا قلبي الخافق % % 12(@)(@@) % فكم مسلم خائف عند ما % % رنا من ظبا لحظه المارق % % 13(@)(@@) % وكم ذابل في العيون التي % % سناها بسهد لها ماحق % % 14(@)(@@) % فيفتح للجفن من مطبق % % ويعمل للقلب من طلبق % % 15(@)(@@) % بخد وخال على تبره % % يشح على قبلة الوامق % % 16(@)(@@) % فكم قلت بالتبر جد مرة % % علي فقال ولا الدانق % % 17(@)(@@) % وكم قلت ماالرفق قال الطلا % % وقسم ما أنت بالذائق % % 18(@)(@@) % ورب مدام تروق التي % % شربت على حسنه الرائق % % 19(@)(@@) % معتقة من ذوي الحجب في % % يمين محجبة عاتق % % 20(@)(@@) % و فاتكة كالمدام التي % % تدير على لينها مادق % % PageV01P1301 21(@)(@@) % تنزه في الثغر مبني في % % محل العذيب وفي بارق % % 22(@)(@@) % زمان شباب مضيء مضى % % بعيش لنا فائز فائق % % 23(@)(@@) % و جاء مشيب على جانبي % % عذاري وحاشاك كالباصق % % 24(@)(@@) % فعيناي في الليل محلوقتان % % وفي اليوم من مائها الدافق % % 25(@)(@@) % و قلبي حران من لوعة % أتت من كئيب النوى الفارق % % 26(@)(@@) % و من زمن بعد ذاك الزمان % % عقوق كمثل اسمه عائق % % 27(@)(@@) % محاذق في الضر لي أفرقت % % خلاف القياس من الحاذق % % 28(@)(@@) % و حملت في الأرض من خطبه % % ذرا جبل في السما شاهق % % 29(@)(@@) % لسني بالفم كم قارع % ولحمي بالهم كم عارق % % 30(@)(@@) % و قلبي المعذب مع همه % % لدى القلب في مخلبي باشق % % PageV01P1302 31(@)(@@) % لعل صديق صديق بمصر % % يخفف بالشام عن عاتق % % 32(@)(@@) % بخطوة ساع مثاب إلى % % حمى الفضل والكرم السابق % % 33(@)(@@) % فنشكو فعال الزمان الغلام % % لسيده الفاتق الراتق % % 34(@)(@@) % علي السيوف لشأو العلى % % وحاتم في القوم من لاحق % % 35(@)(@@) % مجيد العطا ومجيد السطا % % بممتشق فيهما ماشق % % 36(@)(@@) % له الله من راتق في الورى % % أمورا كبارا ومن فاتق % % 37(@)(@@) % و ميكال دهر جديد على % % يديه تصب يد الرازق % % 38(@)(@@) % من الغرب والشرق راجوه لا % % يرد حماه رجا الطارق % % 39(@)(@@) % فيلقى الجويني في الوفد من % % ندى عنده مالقى المالقي 
ms290	 % % 40(@)(@@) % على خلفاء كثير أبر % بسودده الراسخ السامق % % PageV01P1303 41(@)(@@) % فياعون المكتفي إذ بدت % % علاه ويا خجل الواثق % % 42(@)(@@) % فيا صائغ اللفظ صوغ الشنوف % % زهت في حلا سوقه النافق % % 43(@)(@@) % أغث مبعدا لاقيا للأسى % % يلوذ باحسانك اللائق % % 44(@)(@@) % صباح الطوى من دمشق التي % % خدمت ومن حلب فالق % % 45(@)(@@) % و في حلب راتب قانع % ولكن نعته يدا ناعق % % 46(@)(@@) % و عائلة أعولت كلما % % أطلت على نفسي الزاهق % % 47(@)(@@) % على أنني ولي الصبر قد % % ألفت بهذا الشقا الراهق % % 48(@)(@@) % فلو قيل فارق ولا تبتئس % % أيست لقولهم فارق % % 49(@)(@@) % و قد آن لي من يد العمر أن % % أسير إلى رحمة الخالق % % 50(@)(@@) % و ما فتر هذا الهلال القديم % % لخلق عليها سوى خافق % % PageV01P1304 51(@)(@@) % فداك محب عطفت الولا % % على حبه عطفة الناسق % % 52(@)(@@) % طفقت له مزويا نبته % % زمانا بطافحك الطافق % % 53(@)(@@) % و أحييت منه ومن لفظه % % لمن قد يرى رمق الرامق % % 54(@)(@@) % فكم من شهيد زكي على % % جميل ثناه وكم سابق % % 55(@)(@@) % و أنت الذي لم يزل بشره % % لظام وسار سنا بارق % % 56(@)(@@) % و انت الذي في السهى قدره % % بعيوق شاهده الناطق % % 57(@)(@@) % لا بدع لفظك كم حاسد % كليم حشا دونه صاعق % % 58(@)(@@) % تنزه في روضة المجتلى % % على المرخ من همة اللاصق % % 59(@)(@@) % فعيناه في المرخ حيث اجتلت % % بديعا وأحشاه في دابق % % 60(@)(@@) % ملكت بحقل جلاد الجلال % % وحيدا فمزقت في مازق % % PageV01P1305 61(@)(@@) % و أفردت نظما سريا فما % % لبيتك في النظم من سارق % % 62(@)(@@) % و أبعدت بالرغم والعجز عن % % جنا دوحك الناضر الباسق % % 63(@)(@@) % فيا طرسي الثم ثراه المري % % ع ألفا ويا مدحه عانق % % 64(@)(@@) % و عش يا ربيب التقى والعلى % % لدى أمل بالوفا صادق % % 65(@)(@@) % و مبلغ علم باعجازه % % رمى في حشا الند بالحارق % % 66(@)(@@) % علومك يا دوح للمجتني % % وذكرك يا روض للناشق % % PageV01P1306 البحر : - 1(@)(@@) % قال العذول فزاد قلبا شيقا % % ما ضر يا مسحور دمعك لو رقى % % 2(@)(@@) % هيهات مع نأي الأحبة والضنا % % ترقى دموع العين أو تجدي الرقى % % 3(@)(@@) % ما زاد طرفي في الدموع 
ms291	 تبحرا % إلا وزادني العذول تملقا % % 4(@)(@@) % أبكي الصبا بدموع عين كاد في % % شكوى الجفا إنسانها أن ينطقا % % 5(@)(@@) % آها لعهد صبا وعهد صبابة % % شب ادكارهما فشيب مفرقا % % 6(@)(@@) % يا من رمى هذا الرماد بمفرقي % % ماذا رمى قلبي الشجي فأحرقا % % 7(@)(@@) % و تفرقت جفناي عن دمع به % % أشرت وعن ميسور نوم أملقا % % 8(@)(@@) % إن يغن جفني البكاء فقد قلى % % عدم الكرى فيها وأن يتفرقا % % 9(@)(@@) % أفديك راشقة اللحاظ رشيقة % % يا لحظها وقوامها ما أرشقا % % 10(@)(@@) % عربية أروي لباسم ثغرها % % نظما لأكباد الحواسد مقلقا % % PageV01P1307 11(@)(@@) % تجفو ولو أني قبرت وسلمت % % سلمت تسليم البشاشة أوزقا % % 12(@)(@@) % و لربما عطفت وغصن قوامها % % بالحلي أثمر والذوائب أورقا % % 13(@)(@@) % و ضممتها في الحي أرشف ثغرها % % ثم انتبهت فلا العذيب ولا النقا % % 14(@)(@@) % طيفا ألم وما يظن بشاعر % % قاضي القضاة سميعه الا التقا % % 15(@)(@@) % أما الزمان فقد كساه نضارة % % قاضي القضاة ابن العلوم أبو البقا % % 16(@)(@@) % قاضي القضاة تهنها علياء ما % % برحت ببيتكم الممدح أليقا % % 17(@)(@@) % من ذا لذا ارثا وملكا عن رضا % لكم به النعمى وللأعدا الشقا % % 18(@)(@@) % و لنا بكم هذا الهناء المجتلى % % ولكم بنا هذا الثناء المنتقى % % 19(@)(@@) % لا تعدم المدح الحسان بهاءه % % وثناه مملا مغربا أو مشرقا % % 20(@)(@@) % ذو السؤدد الموروث والكسب الذي % % أثرى فنفق ما رجاه ونطقا % % PageV01P1308 21(@)(@@) % عرقت جباه السائدين حياله % % وكذا يكون ابن السيادة معرقا % % 22(@)(@@) % أبناء خزرجها وعيبة نصرها % % هنئتم الشرف التقي ثم ارتقى % % 23(@)(@@) % ان يشبه الاسلاف أخلاق لقد % % رضع الرجا منها الغمام المغدقا % % 24(@)(@@) % أكرم به متحليا من مصره % % حتى أقام لسعدها متدمشقا % % 25(@)(@@) % يا وارث الانصار فضل سيادة % % أخذت على عهد المعالي موثقا % % 26(@)(@@) % يا من سجعت بمدحه اذ لم أزل % % بنداه ثم ندى ذويه مطوقا % % 27(@)(@@) % عذرا على تأخير عبد عنكم % أضحى بترسيم الهموم معوقا % % 28(@)(@@) % عرف الزمان بأنني أشكو إلى % % رحماك عدته فعاق عن اللقا % % 29(@)(@@) % بأليمه يا سيدي وأليمه % % لا أستطيع بشكوها أن أنطقا % % 30(@)(@@) % ومع اهتمام الهم بي فاستجلها % % عذراء قال ثناؤها 
ms292	 ما أصدقا % % PageV01P1309 31(@)(@@) % جاءتك في شفق الحياء وانما % % وجدتك في الحسنى أبر وأشفقا % % 32(@)(@@) % يا من على جدواه أن يهمى الحيا % % وعلى نبات مدائحي أن تعبقا % % 33(@)(@@) % ان يغد مدحي عن ثناك مقصرا % فلقد يرى فوق النجوم محلقا % % PageV01P1310 البحر : - 1(@)(@@) % لرسوم الحمى عليه حقوق % % مدمع فائض وقلب خفوق % % 2(@)(@@) % ذاك يغني مولاه ان يسفح الغي % % ث وهذا ان تستهل البروق % % 3(@)(@@) % أين عيشي والشمل فيه جميع % % ومراحي وما استقل الفريق % % 4(@)(@@) % يا ديار الشهباء أحمر دمعي % % كل يوم إلى هواك سبوق % % 5(@)(@@) % كلما أسعر الغضا قلب صب % % سال من جفنه عليك العقيق % % 6(@)(@@) % إن دارا كمسجد بصفي الد % % ين يقضي بأن دمعي خلوق % % 7(@)(@@) % الأديب الذي به أدب الده % % فما يشتكي لديه عقوق % % 8(@)(@@) % و العريق الذي تسامت فروع % % من علا بيته وساخت عروق % % 9(@)(@@) % فاضل لقطنا له مفرق الحم % % د وفي بحره الخضم غريق % % 10(@)(@@) % ذو نظام له إذا قصر النا % % س على هامة السهى تحليق % % PageV01P1311 11(@)(@@) % و معال لو رامها نجم أفق % % عاقه عن لحاقها العيوق % % 12(@)(@@) % و ودادا اذا جفا الصحب يدنو % % وإذا كدر الزمان يروق % % 13(@)(@@) % و يرى لي حقا عليه وهيها % % ت له لا لحقي التحقيق % % 14(@)(@@) % هو والله سابق لي برا % وثنآء وغيره المسبوق % % 15(@)(@@) % قامت الناس في لقاه على سا % % ق وقامت لحلية الشعر سوق % % 16(@)(@@) % فأبوه عبد العزيز المرجى % % وأخوه زهر الرياض الشقيق % % 17(@)(@@) % و قصيد منه أتى ببديع % % هو حر المقال وهو رقيق % % 18(@)(@@) % و خليق بجده الحسن فاعجب % % لجديد يلقاك وهو خليق % % 19(@)(@@) % حبس الغي عن وفاه يرعى % % بثلاث كأنه مخنوق % % 20(@)(@@) % كل بيت كأنه حان سكر % حيث صفى سلافه الراووق % % PageV01P1312 21(@)(@@) % ثم نادوا إلى الصبوح فقامت % % قينة في يمينها إبريق % % 22(@)(@@) % أي نظم صافي الحديث اذا ما % % عاقرته الألباب قيل عتيق % % PageV01P1313 البحر : - 1(@)(@@) % عللونا عند النوى بالعناق % % وامزجوا بالوداع كأس الفراق % % 2(@)(@@) % وصلونا يوم الرحيل فلا نط % % مع في أن نبقى ليوم التلاق % % 3(@)(@@) % ما عليكم من احمرار دموع 
ms293	 % % تتحلوا بها مع الأطواق % % 4(@)(@@) % سامح الله حسنكم يوم تأتو % % ن وتلك الدماء في الأعناق % % 5(@)(@@) % يا خليلين من جواي ودمعي % % لا لقيتم من العنا ما ألاقي % % 6(@)(@@) % كلما مر من قضية سهد % أو جرى من بكى على الأحداق % % 7(@)(@@) % رب ظبي منكم أخضر العي % % ش وأفنى موارد الآماق % % 8(@)(@@) % منفذ في هواه حاصل دمعي % % وله سالف يريد الباقي % % 9(@)(@@) % تحت أصداغه عذار خفي % فهو بين السطور كالإلحاق % % 10(@)(@@) % كل يوم ينضو على عاشقيه % % سيف لحظ يسوقهم للساق % % PageV01P1314 11(@)(@@) % ما ترى مقلتيه تشكو فتورا % أتراها لكثرة العشاق % % 12(@)(@@) % غنني يا نديم باسم هواه % % وثناء الوزير في الآفاق % % 13(@)(@@) % يطرب الذكر عن مناقب يعقو % % ب كمثل اللحون عن إسحاق % % 14(@)(@@) % صاحب يصحب الثنا ويرقى % % درجات العلآء باستحقاق % % 15(@)(@@) % ان علت غاية وان جن دهر % % فهو في الحالتين أحسن راقي % % 16(@)(@@) % عشقت نفسه المعالي فجدت % % والمعالي قليلة العشاق % % 17(@)(@@) % كل أفعاله مناسبة النف % % ل فعوذ تجنيسها بالطباق % % 18(@)(@@) % همة في سنائها جازت الشه % % ب وأمسى الهلال ذا أطواق % % 19(@)(@@) % ووزير في مصر جاء مرجي % ه وغنى بمدحه في عراق % % 20(@)(@@) % ليس في عيب سوى أن نعما % % ه تحوز الأحرار باسترقاق % % PageV01P1315 21(@)(@@) % أطلقت كفه العطايا وقالت % % فهي مشكورة على الاطلاق % % 22(@)(@@) % وغدا بابه لمجتلب الحم % % د اليه بمجمع الأسواق % % 23(@)(@@) % ذو يراع جار بفصل القضايا % % واتصال العفاة بالأرزاق % % 24(@)(@@) % كلما ماس في المهارق كالغص % % ن رأيت الندى على الأوراق % % 25(@)(@@) % يا وزيرا قد عامل الله في الخل % % ق وما خاب طالب الخلاق % % 26(@)(@@) % بك شدت قريحتي بعد وهن % وبنعمى يديك حل وثاقي % % 27(@)(@@) % جودك المجتدى وامداحك الغ % % ر كنوز تبقى على الانفاق % % PageV01P1316 البحر : - 1(@)(@@) % رأى الغصن أعطاف الغزال المقرطق % % فقام مقام المجتدي المتملق % % 2(@)(@@) % وجاوبه والدمع يخطي فما درى % % إلى البحر يمشي أم إلى البدر يرتقي % % 3(@)(@@) % وما نافعي اطراف طرفي دونه % % اذا كان طرف القلب ليس بمطرق % % 4(@)(@@) % لي الله قلبا في اتباع صبابة % % كعاذله من قال للفلك أرفق % % 5(@)(@@) % يميل لعذال 
ms294	 الصبابة والهوى % % اذا شاء أن يلهو بلحية أحمق % % 6(@)(@@) % ويصغى إلى الواشي وليس بقائل % % ويقضي على علم بكل مخرق % % 7(@)(@@) % ويحثو تراب السبق في وجه عاشق % % أراه غباري ثم قال له الحق % % 8(@)(@@) % معنى بذي قد ثنى الرمح تابعا % لأدرب منه في الطعان وأحذق % % 9(@)(@@) % معنى بظبي ينهب الناس لحظه % % ويعزي إليهم كل سور وخندق % % 10(@)(@@) % من الترك إلا أنه أسمر اللمى % % لعوب بأطراف الكلام المشقق % % PageV01P1317 11(@)(@@) % بروحي من لم يلق مضناه عادل % % بمثل خضوع في كلام منمق % % 12(@)(@@) % مسدد نبل المقلتين كأنما % % يخير أرواح الكماة وينتقي % % 13(@)(@@) % يجفن رشا ان تسمه السحر لم يحد % % وإن تدعه حد الحسام فأخلق % % 14(@)(@@) % أباد قلوب العاشقين فلم يدع % % حبيبا لفاد أو رقيقا لمعتق % % 15(@)(@@) % وأغرق عذالي بدمعي ولم أرد % % ولكنه من يرجم البحر يغرق % % 16(@)(@@) % هوى كشأ الرأي الفلاني أنسبا % قنا ابن أبي الهيجاء في قلب فيلق % % PageV01P1318 البحر : - 1(@)(@@) % أبكيك للحسنين الخلق والخلق % % كما بكى الروض صوب العارض الغدق % % 2(@)(@@) % تبكيك رقة لفظي في مهارقها % % يا غصن فاسمع بكاء الورق في الورق % % 3(@)(@@) % وما أوفيك يا عبد الرحيم وإن % % بكت لك العين بعد الماء بالعلق % % 4(@)(@@) % ما زال مبيض دمعي داعيا لدمي % % حتى بكيت ظلال الحسن بالشفق % % 5(@)(@@) % وخددت فوق خدي للبكا طرق % % حتى رويت حديث الحزن عن طرق % % 6(@)(@@) % يا ساكن اللحد مسرور المقام به % % أرقد هنيئا فإني دائم الأرق % % 7(@)(@@) % وإن تعرض لي في الليل طيف كرى % % فلا تشقني وغيري ساليا فشق % % 8(@)(@@) % صح الوداد لقلبي والأسى فلذا % % أبكيك بالبحر لا أبكيك بالملق % % 9(@)(@@) % بني لولاك ما استعذبت ورد بكا % % ولا أنست بتسهيد ولا أرق % % 10(@)(@@) % ليصنع الدمع والتسهيد ما صنعا % % فإن ذلك محمول على الحدق % % PageV01P1319 11(@)(@@) % بني لا وجبين تحت طرته % % لم يخل حزنك لا صبحي ولا غسقي % % 12(@)(@@) % يهيج الليل نارا فيك أنكرها % % فإن صدقت فقلبي ليلة الصدق % % 13(@)(@@) % ويجلب الصبح لي مما آساء به % % بياض شعر فيا فرقي ويا فرقي % % 14(@)(@@) % بني إن تسق كاسات الحمام فكم 
ms295	 % % مليك حسن كما شاء الزمان سقي % % 15(@)(@@) % بني ان الردى كأس على أمم % ما بين مصطبح منها ومغتبق % % 16(@)(@@) % وللهلال على الأعمار قاطبة % % فتر يحاول منها كل مختنق % % 17(@)(@@) % والعمر ميدان سبق والحمام له % % مدى وكل الورى جار على طلق % % 18(@)(@@) % مارد سيف الردى سيف ابن ذي يزن % % ولا نجا تبع في الزعف والخلق % % 19(@)(@@) % ولا أحتمي عنه ذو سنداد في شرف % % ولا اختفت دونه الزباء في نفق % % 20(@)(@@) % كم نائح كالصدى مثلي على ولد % يقول واحرقي إن قلت واحرقي % % PageV01P1320 21(@)(@@) % ولا كمثلي في حزن فجعت به % % لكن أعلق صبري فيه بالعلق % % 22(@)(@@) % أدنيت للطرف قبرا أنت ساكنه % % عسى أساعد في شجوي وفي قلقي % % 23(@)(@@) % بالرغم ان بات يدر الأفق معتليا % وبات بدري مدفونا على الطرق % % 24(@)(@@) % كأنني لم أغن الليل من طرب % % ليل الحمى بات بدري فيك معتنقي % % 25(@)(@@) % يا ترب كم من فتور قد نثرت بها % % أعضاء حسن كمثل اللؤلؤ النسق % % 26(@)(@@) % وكم تركت بها كفا بلا عضد % % وقد توسدها رأس بلا عنق % % 27(@)(@@) % آها لها حسرات لو رميت بها % % ثهلان خل حصاة القلب لم يطق % % 28(@)(@@) % وأوجها كخلاص التبر قد جليت % % على الحمام عليها لؤلؤ العرق % % 29(@)(@@) % كانت رياضا لمستجل فما تركت % % منها الليالي سوى ذكر لمنتشق % % 30(@)(@@) % بني ليتك لم تعرف ولاءك في % % حبي فرحت بدمعي شاكي الغرق % % PageV01P1321 31(@)(@@) % وليت نجمك لم يشرق على سحري % % وليت برقك لم يومض على أفقي % % 32(@)(@@) % ما كان أقصر أوقات بك استرقت % % فليت عمري مقطوع على السرق % % 33(@)(@@) % ما كان أهداك في السن الصغير إلى % % فضل تجمع فيه كل مفترق % % 34(@)(@@) % فإن يغب منك عن جفني عطارده % % فقد رسيت بفكر فيه محترق % % 35(@)(@@) % مضيت حيث بقايا العمر تضعف لي % % واطول حزني مما قد مضى وبقي % % 36(@)(@@) % لا أهملتك عيون السحب هاملة % % ولا بعينيك ما يلقى الحشا ولقي % % 37(@)(@@) % فما أظنك ترضى حالة نعمت % % وأن قلبي بنيران الهموم شقي % % 38(@)(@@) % قد أخلقت جسدي أيدي الأسى فمتى % % للأرض ترمي بهذا الملبس الخلق 
ms296	 % % PageV01P1322 البحر : - 1(@)(@@) % تشبيب مدحك مطرب لكنه % % حق لإطراب المديح سباق % % 2(@)(@@) % قاضي القضاة ويا أبا الحسن الذي % % شرفت أصول علاه والأعراق % % 3(@)(@@) % يا ابن الذين اذا تحدث مادح % فاليهم ذاك الحديث يساق % % 4(@)(@@) % يا خير من لولائنا وثنائنا % % في بابه التقييد والإطلاق % % 5(@)(@@) % أعداك والأنعام في حال سوا % % حق لمثلهما دم مهراق % % 6(@)(@@) % فانحرهما في يوم عيدك وابق ذا % % مجد تضيء بذكره الآفاق % % 7(@)(@@) % لرقاب جزرك والعدى حد المدا % % ورقابنا من جودك الأطواق % % PageV01P1323 البحر : - 1(@)(@@) % ماذا من الشوق جناي والأرق % % برق على حمص كقلب خفق % % 2(@)(@@) % يا جاعلا في حمص قلبي لقد % % حمصت مشتاقك حتى احترق % % 3(@)(@@) % حتى اذا عاد إمام الهدى % % تساعد السعد فرق الفرق % % 4(@)(@@) % أعظم به تاجا لعليائه % % يعطف رد المدح عطف النسق % % 5(@)(@@) % من نعم الوهاب سبحان من % % جمل من أخلاقه ما خلق % % 6(@)(@@) % إذا كتبت السطر من مدحه % % أضاء في الطرس ضياء الفلق % % 7(@)(@@) % فلم يزد إلا بما زاد من % % بياضه فوق بياض الورق % % PageV01P1324 البحر : - 1(@)(@@) % جيوش حسنك ياذا الحسن متفقه % % لها من السقم عرض والبكا نفقه % % 2(@)(@@) % اذا رأواحلقات الصدغ دائرة % فكلهم جند أشجان من الحلقه % % 3(@)(@@) % ألحاظك النبل في أهل الغرام كما % % مال ابن يعقوب في أهل الرجا درقه % % 4(@)(@@) % ترد عن عرضه الأنقى فتبصرها % % محمرة من دما التبر الذي هرقه % % 5(@)(@@) % شيخ الشيوخ طريقا أو مباحثة % % وصاحب الستر من شغل ومن صدقه % % 6(@)(@@) % مولاي دعوة مطوي على شجن % لا يستكي لسوى إحسانكم حرقه % % 7(@)(@@) % لا تسألوا كيف حال منه ممحلة % % ما حال فرع نبات يشتكي ورقه % % PageV01P1325 البحر : - 1(@)(@@) % ونظم يجاري الناظمين جواده % % إذا شاء أن يلهو بلحية أحمق % % 2(@)(@@) % أتى من إمام منطقي فيه للثنا % % وللحب ما لم يبق مني وما بقي % % 3(@)(@@) % أبا الفتح لو فاتحت بحرا أو ابنه % % لقام مقام المجتدي المتملق % % 4(@)(@@) % ويامن له في العقل والنقل خاطر % % لعادله من قال للفلك ارفق % % 5(@)(@@) % لقد جدت حتى جدت في كل ناقل % وحتى أتاك الحمد من كل منطق % % 6(@)(@@) % وقلدتني 
ms297	 شرف من النظم نعمة % أنرت بها ما بين غرب ومشرق % % 7(@)(@@) % أقول لها إذ صحفت نعت حاسد % % بعينيك ما يلقى الحسود ومالقي % % PageV01P1326 البحر : - 1(@)(@@) % يا تاركين للمحب أدمعا % قد وقع الحزن له إطلاقها % % 2(@)(@@) % والذاريات من دموعي خلفة % ما نقضت أيدي النوى ميثاقها % % 3(@)(@@) % لو حنت الورق حنيني نحوكم % % لمزقت من أسف أطواقها % % 4(@)(@@) % ولو غدت تملي على الأغصان ما % % في كبدي لأحرقت أوراقها % % PageV01P1327 البحر : - 1(@)(@@) % مولاي ما متعب يلوح على الس % % مت والحي صنعة الفائق % % 2(@)(@@) % كأنه عاشق تهيج له الاوت % % ار شجوا وليس بالعاشق % % 3(@)(@@) % لسانه صامت على أكثر الاوق % % ات لكن قلبه ناطق % % PageV01P1328 البحر : - 1(@)(@@) % حوى فلكي عند الوزير وطالما % % أزيحت بجدوى راحتيه عوائقي % % 2(@)(@@) % وقد كان قدري عنده متدرجا % وبيتي عميرا بالندى المتلاحق % % 3(@)(@@) % فللدرج اللاتي حوت بت باكيا % وعائلتي تبكي لمنع الدقايق % % PageV01P1329 البحر : - 1(@)(@@) % يارب ظبي على ظبي ظفرت به % % فقام إيري مقام الطاعن اللبق % % 2(@)(@@) % وكاد يخترق الإثنين ذاك لذا % % كالفعل ينصب مفعولين في نسق % % PageV01P1330 البحر : - 1(@)(@@) % نأى بك الشام يا خلي فقلت عسى % % خل بمصر اذا بالموت قد طرقه % % 2(@)(@@) % يا دهر أعدمتني خلين رمت فدا % % صلاح صدق لآمالي وذا صدقه % % PageV01P1331 البحر : - 1(@)(@@) % غرس أياديك في هديته % % يطلب عذرا من جودك الغدق % % 2(@)(@@) % إن لم يكن قد أتاك ذا ثمر % % فإنه قد أتاك ذا ورق % % PageV01P1332 البحر : - 1(@)(@@) % يامن يطالع سقط الزند دونك من % % ألفاظه ما يباهي الزهر في الأفق % % 2(@)(@@) % لا تحسب العقد في الأعناق يشبهه % % فإن للزند حليا ليس للعنق % % PageV01P1333 البحر : - 1(@)(@@) % تقول بني الجائعون أما ترى % % من الجوع شكوانا لكل فريق % % 2(@)(@@) % وقد كنت ذا نظم وسعي ببرنا % % فلم جئت من هذا وذا بدقيق % % 3(@)(@@) % عليك بأبواب الامام محمد % % تجد فرجا منها لكل مضيق % % 4(@)(@@) % وما هي غل بيت مال لطالب % % ونصرة آمال ونجح طريق % % PageV01P1334 البحر : - 1(@)(@@) % أتاركة بالحزن قلبي مقيدا % % ودمعي على الخدين وهو طليق % % 2(@)(@@) % يقولون قد أخلقت جفنك بالبكا % % نعم ان جفني بالبكا خليق % % 3(@)(@@) % دعوا الدمع للجفن 
ms298	 القريح مواخيا % فاني فقدت الخد وهو شقيق % % 4(@)(@@) % وساحرة الالحاظ حتى رضا بها % % رحيق وفي قلب المحب حريق % % PageV01P1335 البحر : - 1(@)(@@) % هددني بالدين في جلق % % مطالب يفض لي خلقا % % 2(@)(@@) % قلت له قاضي قضاة الورى % % لا زال يرعاني فما صدقا % % 3(@)(@@) % وقال فكر في حديث الوفا % % وخلني من لفظك المنتقى % % 4(@)(@@) % ويلك ان يفتح باب القضا % % فقلت بل ويلي أن يغلقا % % PageV01P1336 البحر : - 1(@)(@@) % كذا أبدا يا آل أيوب ملككم % % له بالندى في الشرق والغرب اطلاق % % 2(@)(@@) % اذا ما سقيتم بالعطايا نباتكم % % توالت ثمار من نداه وأوراق % % 3(@)(@@) % و إني وإن عيقت عن السعي حجتي % % إلى وقفة في ذلك الباب مشتاق % % PageV01P1337 البحر : - 1(@)(@@) % في دعة الله سر سعيدا % ممدح الحلق والخلائق % % 2(@)(@@) % مفارق الطرف فيك غيري % % حيث سرت خيلك السوابق % % 3(@)(@@) % من أعلم الطرف حين تسري % % أنك تاج على المفارق % % PageV01P1338 البحر : - 1(@)(@@) % لا تعاتب من غير جرم ولا تج % % عل عقاب الأنام في الأرزاق % % 2(@)(@@) % و تعلم بأن حظك أوفى % % في اتصال الارفاد والارفاق % % 3(@)(@@) % لك منا صفو المحامد والأج % % ر وأرزاقنا على الخلاق % % PageV01P1339 البحر : - 1(@)(@@) % إني إذا آنست هما طارقا % عاجلت باللذات قطع طريقه % % 2(@)(@@) % و ذكرت ألفاظ الحبيب وكأسه % % فنعمت بين حديثه وعتيقه % % PageV01P1340 البحر : - 1(@)(@@) % و صارم كعباب الموج ملتمع % % يكاد يغرق رائيه ويحترق % % 2(@)(@@) % لما غدا جدولا تسقى المنون به % % أضحى يشف على حافاته العلق % % PageV01P1341 البحر : - 1(@)(@@) % سيدي قد كلفتني زوجتي % % حلقا فانظر إلى حالي الأشق % % 2(@)(@@) % كنت في الشعر أكدي برهة % % وأنا اليوم أكدي في الحلق % % PageV01P1342 البحر : - 1(@)(@@) % هنئتها خلعا تذكر من رأى % % نعماك للخضراء والعرض النقي % % 2(@)(@@) % كنت الأحق بأن تهنى لبسها % % فملابس التقوى أحق بها التقي % % PageV01P1343 البحر : - 1(@)(@@) % أهدي لبابك أوراقا ملفقة % من حظه منك إرفاد وإرفاق % % 2(@)(@@) % غرس لبابك سامح جهد قدرته % % إن لم يكن ثمر منه فأوراق % % PageV01P1344 البحر : - 1(@)(@@) % كانت لنظمي رقة % ضن الزمان بما استحقت % % 2(@)(@@) % فصرفتها عن فكرتي % % وقطعتها من حيث رقت % % PageV01P1345 البحر : - 1(@)(@@) % وكنت أظن العشق يترك مهجتي % % إذا زحم الشيب 
ms299	 الشباب بمفرقي % % 2(@)(@@) % فلما بدا مع أسود الشعر أبيض % أتى العشق يغزوني على ألف أبلق % % PageV01P1346 البحر : - 1(@)(@@) % أقبلت يا ملك الشجاعة والندى % % والجيش محمر الأهاب شريق % % 2(@)(@@) % فكأنما الدنيا بجودك روضة % % وكأن جيشك للشقيق شقيق % % PageV01P1347 البحر : - 1(@)(@@) % فديت من الأتراك سرب جآذر % تعلم زهاد الورى كيف تعشق % % 2(@)(@@) % لهم منظر في الحسن يفتح خاطرا % ولكن سهم اللحظ في القلب يغلق % % PageV01P1348 البحر : - 1(@)(@@) % بروحي من أهوى العذيب لريقه % % وأعشق من أعطافه البان والنقا % % 2(@)(@@) % رمى لحظه قلبي وماس قوامه % % فلم أر من هذا ولا ذاك أوثقا % % PageV01P1349 البحر : - 1(@)(@@) % مليك التقى هنئت بالجامع الذي % % وجدت إلى مبناه سعدا موافقا % % 2(@)(@@) % دعا حسنه أهل الصلاة لقصده % % فلا غرو إن جاء المصلي سابقا % % PageV01P1350 البحر : - 1(@)(@@) % لنا من وزير الشام بر يحثه % % مكارم شمس الدين حيث تليق % % 2(@)(@@) % وأقسم لا نشكو عدو زماننا % % وذا صاحب يدعى وذاك صديق % % PageV01P1351 البحر : - 1(@)(@@) % يا ويح من أصبح محت % % اجا لنوع الصدقه % % 2(@)(@@) % يثقل منه عند من % % يرجوه حتى الورقه % % PageV01P1352 البحر : - 1(@)(@@) % إن دام حالي واسهالي استحلت خرا % ما بين مندفع يجري ومندفق % % 2(@)(@@) % وما عجيب لشخص ذاب أكثره % % وإنما عجبي للبعض كيف بقي % % PageV01P1353 البحر : - 1(@)(@@) % يا قارعا باب هجراني ولا سبب % يحل من جهتي أسباب ميثاقي % % 2(@)(@@) % لتقرعن علي السن من ندم % اذا تذكرت يوما بعض أخلاقي % % PageV01P1354 البحر : - 1(@)(@@) % كفاني المؤيد عتب الزمان % % وأنقذني من إسار الشقا % % 2(@)(@@) % فكان ولائي له مخلصا % لأن الولاء لمن أعتقا % % PageV01P1355 البحر : - 1(@)(@@) % لا تسل عن حديث دمعي لما % % ظعن الركب واستقل الفريق % % 2(@)(@@) % لونته وأمطرته جفون % جر منها الوادي وسال العقيق % % PageV01P1356 البحر : - 1(@)(@@) % إذا كان أوفى سادتي وأبرهم % % ملاذي فلا زال الزمان موافقي % % 2(@)(@@) % ولا حال يوم الشعر عني هوى له % % ولا قطعت يوم الشعير علائقي % % PageV01P1357 البحر : - 1(@)(@@) % أفدي الذي أرسل نحوي طبقا % مع البدور حسنه في نسق % % 2(@)(@@) % يا طرق الشكر عليه قسما % لتركبن طبقا عن طبق % % PageV01P1358 البحر : - 1(@)(@@) % خلني بالطلا أمد حياتي % % يا عذولي وكن عليها صديق % % 2(@)(@@) % انما ماؤها 
ms300	 هو الدم في العنقو % % د يجري من عرقه وعروقي % % PageV01P1359 البحر : - 1(@)(@@) % رب بكر في طريق جليت % % لي بالشام أمورا لم ترق % % 2(@)(@@) % هكذا كل جموح سائر % لم يدع عنه بنيات الطرق % % PageV01P1360 البحر : - 1(@)(@@) % يا حبذا خد الحبيب % % فقد أضاء شريقه % % 2(@)(@@) % إن لم يكن في الحسن نف % % س الروض فهو شقيقه % % PageV01P1361 البحر : - 1(@)(@@) % أمستنقذي باللطف من قبضة الردى % % لئن حثني فيك الرجا فلي الحق % % 2(@)(@@) % على يد مولانا نشا العمر ثانيا % فلا غرو أن ينشا على يده الرزق % % PageV01P1362 البحر : - 1(@)(@@) % يا رب أمرد قد سبرت غويره % % حتى أزال الشعر ذاك الرونقا % % 2(@)(@@) % وتنكرت صفة الغوير فلم يكن % % ذاك الغوير ولا النقا ذاك النقا % % PageV01P1363 البحر : - 1(@)(@@) % يا سيدي يا جمال الدين قد عرضت % % ضرورة ولك الموزون والصدقة % % 2(@)(@@) % إن أحوج الفقر حالي أن يحار به % % فالعرض مني ومن احسانك النفقه % % PageV01P1364 البحر : - 1(@)(@@) % شكرا لها كنافة من بعدها % % قطائف جاء بقطر مغدق % % 2(@)(@@) % يا جود مهديها اذا قلنا انتهى % % ركبت فيها طبقا عن طبق % % PageV01P1365 البحر : - 1(@)(@@) % يفديك عبد كم دعاك مسطرا % رق المديح فحاز أوفر حقه % % 2(@)(@@) % ووعدته وعدا ستملكه به % % وتكون في الحالين مالك رقه % % PageV01P1366 البحر : - 1(@)(@@) % إلى حلب رمت السرى بعد بعدكم % % فعارضني أيضا زمان بعائق % % 2(@)(@@) % فياليتني للمرج دبقا لزمتكم % % وإن حلب فاتت فقل مرج دابق % % PageV01P1367 البحر : - 1(@)(@@) % يا شيخ أهل العلم والزهد في % % سادات أهل الرفق والرفقه % % 2(@)(@@) % لي خرقة ضاعت وأنت الذي % % نلبس من عرفانه الخرقه % % PageV01P1368 البحر : - 1(@)(@@) % سيدي إن يعق حجاب لقانا % % ما لطيقاننا القريبة عاقه % % 2(@)(@@) % عجبا للصدود منك ومني % % ولكل منا على الوصل طاقه % % PageV01P1369 البحر : - 1(@)(@@) % يامن أعاد وداد وا % % لده فجاء على وفاقي % % 2(@)(@@) % حاشاك تبطي يا جواد % % وأنت أسرع من براق % % PageV01P1370 البحر : - 1(@)(@@) % لك يا مليحة مقلة مع حاجب % للسهم عن قوس لقلبي يرشق % % 2(@)(@@) % و حبال شعر قد شقيت بحبها % % إن الشقي بكل حبل يخنق % % PageV01P1371 البحر : - 1(@)(@@) % يا ماجدا لا يزال من كرم % في بابه القاصدون تستبق % % 2(@)(@@) % هل لك في 