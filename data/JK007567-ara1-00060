ms41	 الخفاق % % PageV01P151 41(@)(@@) % أودى الذي غيث العباد بكفه % % يزري بواكف غيثك الغيداق % % 42(@)(@@) % إن كان صوتك بالمياه فدرها % % در يروض ما حل الإملاق % % 43(@)(@@) % بشر كثير قد نعوا لما نعي % % قاضي القضاة وغاب في الأطباق % % 44(@)(@@) % البستهم ثوب الكرامة ضافيا % % وأرحت من كد ومن إرهاق % % 45(@)(@@) % يتفيأون ظلال جاهك كلما % % لفحت سموم الخطب بالإحراق % % 46(@)(@@) % عدموا المرافق في فراقك وانطوى % % عنهم بساط الرفق والإرفاق % % 47(@)(@@) % رفعوا سريرك خافضين رؤوسهم % % ما منهم إلا حليف سياق % % 48(@)(@@) % لكن مصيرك للنعيم مخلدا % % كان الذي ابقى على الأرماق % % 49(@)(@@) % ومن العجائب أن يرى بحر الندى % % طود الهدى يسري على الأعناق % % 50(@)(@@) % إن يحملوك على الكواهل طالما % % قد كنت محمولا على الأحداق % % PageV01P152 51(@)(@@) % أو يرفعوك على العواتق طالما % % رفعت ظهر منابر وعتاق % % 52(@)(@@) % ولئن رحلت إلى الجنان فإننا % % نصلى بنار الوجد والأشواق % % 53(@)(@@) % لو كنت تشهد حزن من خلفته % % لثني عنانك كثرة الإشفاق % % 54(@)(@@) % إن جن ليل جن من فرط الأسى % % وسوى كلامك ماله من راق % % 55(@)(@@) % فابعث خيالك في الكرى يبعث به % % ميت السرور لثاكل مشتاق % % 56(@)(@@) % اغليت يا رزء التصبر مثلما % % أرخصت در الدمع في الآماق % % 57(@)(@@) % إن يخلف الأرض الغمام فإنني % % أسقي الضريح بدمعي المهراق % % PageV01P153 البحر : - 1(@)(@@) % يا خير من ملك الملوك % % أهديتني حب الملوك % % 2(@)(@@) % فكأنما يا قوتها % % نظمت لنا نظم السلوك % % 3(@)(@@) % إن الملوك إذا لحوا % % فغياثهم أن أملوك % % 4(@)(@@) % وكذا العفاة إذا شكوا % % فغناهم أن يسألوك % % 5(@)(@@) % فالله يقبل من دعا % % لعلاك من أهل السلوك % % 6(@)(@@) % لا زلت تطلع غرة % % كالشمس في وقت الدلوك % % PageV01P154 البحر : - 1(@)(@@) % يا خير من ملك الملوك بجوده % % ولفضله قد أشبه الأملاكا % % 2(@)(@@) % والله ما عرف الزمان وأهله % % أمنا ويمنا دائما لولاكا % % 3(@)(@@) % وافيت أهلي بالرياض عشية % % في روض جاهك تحت ظل ذراكا % % 4(@)(@@) % فوجدته قد طله صوب الندى % % بسحائب تنهل من يمناكا % % 5(@)(@@) % وسفائن مشحونة القى بها % % بحر السماح يجيش من نعماكا % % 6(@)(@@) % رطب من الطلع النضيد كأنها % % قد نظمت من حسنها أسلاكا % % 7(@)(@@) % من 
ms42	 كل ما كان النبي يحبها % % وأحبها الأنصار من أولاكا % % 8(@)(@@) % وبدائع التحف التي قد أطلعت % % مثل البدور أنارت الأحلاكا % % 9(@)(@@) % نطف من النور المبين تجسمت % % حتى حسبنا أنهن هداكا % % 10(@)(@@) % يحلو على الأفواه طيب مذاقها % % لولا التجسد خلتهن ثناكا % % PageV01P155 11(@)(@@) % طافت بها النشأ الصغار كأنها % % سرب القطا لما وردن نداكا % % 12(@)(@@) % نجواهم مهما سمعت كلامهم % % ونداؤهم مولاي أو مولاكا % % 13(@)(@@) % بلغت في الأبناء عبدك سؤله % % لا زلت تبلغ في بنيك مناكا % % 14(@)(@@) % يتدارسون من الدعاء صحائفا % % كيما يطيل الله في بقياكا % % 15(@)(@@) % فبقيت شمسا في سماء خلافة % % وهم البدور أمدهن سناكا % % PageV01P156 البحر : - 1(@)(@@) % أزور بقلبي معهد الأنس والهوى % % وأنهب من أيدي النسيم رسائلا % % 2(@)(@@) % ومهما سألت البرق يهفو من الحمى % % يبادره دمعي مجيبا وسائلا % % 3(@)(@@) % فيا ليت شعري والأماني تعلل % % ايرعى لي الحي الكرام الوسائلا % % 4(@)(@@) % وهي جيرتي الأولى كما قد عهدتهم % % يوالون بالإحسان من جاء سائلا % % PageV01P157 البحر : - 1(@)(@@) % أمولاي يا ابن السابقين إلى العلا % % ومن نصروا الدين الحنيفي أولا % % 2(@)(@@) % غنيت بنور الله عن كل زينة % % والبست من رضوانه أشرف الحلى % % 3(@)(@@) % وقارك زاد الملك عزا وهيبة % % وسوغه في رحمة الله منهلا % % 4(@)(@@) % ويا شمس هدي في سماء خلافة % % وأبناؤه الزهر المنيرة تجتلى % % 5(@)(@@) % تبارك من ابداك في كل مظهر % % جميلا جليلا مستعاذا مؤملا % % 6(@)(@@) % فيخجل منك الشمس شمس هداية % % ويحسد منك البدر بدرا مكملا % % 7(@)(@@) % إذا أنت ألبست الزمان وآله % % ملابس عز ليس يدركها البلى % % 8(@)(@@) % وطوقت أجياد الملوك اياديا وتوجتهم بالفخر تاجا مكللا فما شئت فالبس فالمشاهد قائل تبارك ما أبهى واسنى وأجملا % . . . % 9(@)(@@) % ألا كل من صلى وضحى ومن دعا % % ومد يديه ضارعا متوسلا % % 10(@)(@@) % وجودك شرط في حصول قبوله % % وجودك أثرى كفه فتنفلا % % PageV01P158 البحر : - 1(@)(@@) % يا من له الوجه الجميل إذا بدا % % فاقت محاسنه البدور كمالا % % 2(@)(@@) % والمنتقى من جوهر الفخر الذي % % فاق الخلائف عزة وجمالا % % 3(@)(@@) % ما ابصرت عيناي مثل هدية % % أبدت لنا صنع الإله تعالى % % 4(@)(@@) % فيها من التفاح كل عجيبة % % تذكي برياها 
ms43	 صبا وشمالا % % 5(@)(@@) % تهدي لنا نهد الحبيب وخده % % وتري من الورد الجني مثالا % % 6(@)(@@) % وبها من الأترج شمس أطلعت % % من كل شطر للعيون هلالا % % 7(@)(@@) % ويحفها ورق يروق كأنه % % ورق النضار وقد اجاد نبالا % % 8(@)(@@) % لون العشية ذهبت صفحاتها % % رقت وراقت بهجة وجمالا % % 9(@)(@@) % وبها من النقل الشهي مذكر % % عهدا تولى ليته يتوالى % % 10(@)(@@) % لله منها خضرة من حضرة % % تغني العفاة وتحسب الآمالا % % PageV01P159 11(@)(@@) % اذكرتني العهد القديم ومعهدا % % كانت شموس الراح فيه تلالا % % 12(@)(@@) % فأردت تجديد العهود وإنما % % كتب المشيب على عذاري لالا % % 13(@)(@@) % فأدرت من ذكراك كأس مدامة % % وشربت من حبي لها جريالا % % 14(@)(@@) % فبقيت شمسا في سماء خلافة % % لا يستطيع لها الزمان زوالا % % PageV01P160 البحر : - 1(@)(@@) % لو كنت أعطي من لقائك سولا % % لم أتخذ برق الغمام رسولا % % 2(@)(@@) % أو كنت أبلغ من قبولك مأملي % % لم أودع الشكوى صبا وقبولا % % 3(@)(@@) % لكن معتل النسيم إذا سرى % % ما زال يوسع ذا الهوى تعليلا % % 4(@)(@@) % وبملتقى الأرواح دوحة أيكة % % جاذبتها عند الغروب مميلا % % 5(@)(@@) % عهدي بها سدلت علي ظلالها % % فسدلت ظلا للشباب ظليلا % % 6(@)(@@) % رتعت به حولي الظباء أوانسا % % فنعمت فيه معرسا ومقيلا % % 7(@)(@@) % وصقلت للحسناء صفح مودتي % % لما اجتليت العارض المصقولا % % 8(@)(@@) % ثم انتشيت وقد تعاطيت الهوى % % ريما اغر وجؤذرا مكحولا % % 9(@)(@@) % كم فيه من ملح لمرتاد الهوى % % تركت فؤاد محبه متبولا % % 10(@)(@@) % لم ترو لي عيناه حكمة بابل % % إلا أخذت حديثها مقبولا % % PageV01P161 11(@)(@@) % ولقد أجد جواي لما زرته % % رسما كحاشية الرداء محيلا % % 12(@)(@@) % قد أنكرته العين إلا لمحة % % عرفت به آثاره تخييلا % % 13(@)(@@) % وإذا الطلول تعرضت لمتيم % % غادرن دمع جفونه مطلولا % % 14(@)(@@) % من ينجد الصبر الجميل فإنه % % بعد الأحبة قد أجد رحيلا % % 15(@)(@@) % كيف التجمل بعدهم وأنا الذي % % أنسيت قيسا في الهوى وجميلا % % 16(@)(@@) % من عاذري والقلب أول عاذل % % فيمن افند لائما وعذولا % % 17(@)(@@) % أتبعت في دين الصبابة أمة % % ما بدلوا في حبهم تبديلا % % 18(@)(@@) % يا موردا حامت عليه قلوبنا % % لو نيل لم تجر المدامع نيلا % % 19(@)(@@) % ما ضر من 
ms44	 رقت غلائله ضحى لو بات ينقع للمحب غليلا % . . . % 20(@)(@@) % كم ذا أعلل بالحديث وبالمنى قلبا كما شاء الغرام عليلا % . . . % PageV01P162 21(@)(@@) % أعديت واصلة الهديل بسحرة % % شجوا وجانحة الأصيل نحولا % % 22(@)(@@) % وسريت في طي النسيم لعلني % % احتل حيا بالعقيق حلولا % % 23(@)(@@) % هذا ووجدي مثل وجدي عندما استشعرت % % من ركب الحجاز رحيلا % % 24(@)(@@) % قد سددوا الانضاء ثم تتابعوا % % يتلو رعيل في الفلاة رعيلا % % 25(@)(@@) % مثل القسي ضوامر قد أرسلت % % يذرعن عرض البيد ميلا ميلا % % 26(@)(@@) % مترنحين على الرمال كأنما % % عاطين من فرط الكلال شمولا % % 27(@)(@@) % إن يلتبس علم الطريق عليهم % % جعلوا التشوق للرسول دليلا % % 28(@)(@@) % يا راحلين وما تحمل ركبهم % % إلا قلوب العاشقين حمولا % % 29(@)(@@) % ناشدتكم عهد المودة بيننا % % والعهد فينا لم يزل مسؤولا % % 30(@)(@@) % مهما وصلتم خير من وطئ الثرى % % أن توسعوا ذاك الثرى تقبيلا % % PageV01P163 31(@)(@@) % يا ليت شعري هل أعرس ليلة % % فاشم حولي إذ خرا وجليلا % % 32(@)(@@) % أو تروني يوما مياه مجنة % % ويشيم طرفي شامة وطفيلا % % 33(@)(@@) % وأحط في مثوى الرسول ركائبي % % وأبيت للحرم الشريف نزيلا % % 34(@)(@@) % بمنازل الوحي التي قد شرفت % % قد شافهت أعلامها التنزيلا % % 35(@)(@@) % بمعاهد الإيمان والدين التي قد صافحت عرصاتها جبريلا % . . . % 36(@)(@@) % ومهاجر الدين الحنيف وأهله % % حيث استقر به الأمان دخيلا % % 37(@)(@@) % دار الرسول ومطلع القمر الذي % % ابداؤه ما فارق التكميلا % % 38(@)(@@) % يا حبذا تلك المعالم والربا % % يا حبذا تلك الطلول طلولا % % 39(@)(@@) % حيث النبوة قد جلت آفاقها % % وجها من الحق المبين جميلا % % 40(@)(@@) % حيث الرسالة فصلت أحكامها % % لتبين التحريم والتحليلا % % PageV01P164 41(@)(@@) % حيث الشريعة قد رست أركانها % % فالنص منها يعضد التاويلا % % 42(@)(@@) % حيث الهدى والدين والحق الذي % % محق الضلال واذهب التضليلا % % 43(@)(@@) % حيث الضريح يضم أكرم مرسل % % وأجل خلق الله جيلا جيلا % % 44(@)(@@) % إن الإله أختارها لمقامه % % واختاره للعالمين رسولا % % 45(@)(@@) % رحم الإله العالمين ببعثه % % فيهم وفضل جنسه تفضيلا % % 46(@)(@@) % بدعائه انقشع الغمام وقبلها % % والت بدعوته الغمام همولا % % 47(@)(@@) % والشمس قد ردت له ولطالما % % قد ظللته سحابها تظليلا % % 48(@)(@@) % لم لا يطاوعه الوجود وقد غدا % % من نوره 
ms45	 في خلقه معلولا % % 49(@)(@@) % يا نكتة الأكوان يا علم الهدى % % آيات فضلك رتلت ترتيلا % % 50(@)(@@) % لولاك لم يك للكيان حقيقة % % ولكان باب وجودها مقفولا % % PageV01P165 51(@)(@@) % لولاك للزهر الكواكب لم تلح % % مثل الأزاهر ما عرفن ذبولا % % 52(@)(@@) % لولاك لم تجل السماء شموسها % % ولكان سجف ظلامها مسبولا % % 53(@)(@@) % لولاك ما عبد الاله وما غدا % % ربع الجنان بأهله ماهولا % % 54(@)(@@) % يا رحمة الله التي ألطافها % % سحبت علينا للقبول ذيولا % % 55(@)(@@) % يا حجة الله التي برهانها ما كان يوما صدقة مجهولا % . . . % 56(@)(@@) % كم آية لك قد صدعت بنورها % % ليل الضلال وإفكه المنحولا % % 57(@)(@@) % أوضحتها كالشمس عند طلوعها % % وعقلت عن إدراكهن عقولا % % 58(@)(@@) % واتيت بالذكر الحكيم مبينا % % قد فصلت آياته تفصيلا % % 59(@)(@@) % أثنى عليك بكتبه من أنزل القرآن % % والتوراة والإنجيلا % % 60(@)(@@) % فإذا البليغ يروم مدحك جاهدا % % اضحى حسام لسانه مفلولا % % PageV01P166 61(@)(@@) % يا شافع الرسل الكرام ومن به % % يرجون في يوم الحساب قبولا % % 62(@)(@@) % رفقا بمن ملك القضاء زمامه % % فغدا بقيد ذنوبه معقولا % % 63(@)(@@) % واحسرتا ضيعت عمري في الهوى % % والتوب أضحى دينه ممطولا % % 64(@)(@@) % وجريت في طلق البطالة جامحا % % حتى انثنى طرف الشباب كليلا % % 65(@)(@@) % وعثرت في طلب المفاز جهالة % % لكن وجدتك للعثار مقيلا % % 66(@)(@@) % يا صفوة الله الأمين لوحيه % % من أم جاهك أحرز التأميلا % % 67(@)(@@) % والله ما لي للخلاص وسيلة % % إلا رضاك وعفوك المأمولا % % 68(@)(@@) % إن كنت ما أعددت زادا نافعا % % أعددت حبك شافعا مقبولا % % 69(@)(@@) % صلى عليك الله ما ركب سرى % % فأجد وخدا في المفازة ميلا % % 70(@)(@@) % وأعز من ولاه أمر عباده % % فحباهم إحسانه الموصولا % % PageV01P167 71(@)(@@) % وأقام مفورض الجهاد بعزمة % % تركت بأفئدة العداة فلولا % % 72(@)(@@) % والله ما ادري وقد حضر الوغى % % أحسامه أم عزمه مصقولا % % 73(@)(@@) % ملك إذا لثم الوجود يمينه % % فالبحر عذبا والرياض بليلا % % 74(@)(@@) % أو يخلف الناس الغمام وأمحلوا % % فنداه لا يخشى العفاة محولا % % 75(@)(@@) % من دوحة نصرية يمينة % % وشجت فروعا في العلا واصولا % % 76(@)(@@) % فإذا سألت الكتب نقل فضيلة % % لم تلف إلا فخرها منقولا % % 77(@)(@@) % يا ايها الملك الذي أيامه % % وضحت 
ms46	 بأوجه دهرهن حجولا % % 78(@)(@@) % والله ما آثار هديك عندنا % % إلا نجوما ما عرفن أفولا % % 79(@)(@@) % لم يعرف التركيب سيفك في الوغى % % فاعجب له قد أحكم التحليلا % % 80(@)(@@) % كم صورة لك في الفتوح وسورة % % تجلى وتتلى بكرة وأصيلا % % PageV01P168 81(@)(@@) % لم تسر سارية الرياح بطيبة % % إلا لتحمل ذكره المعسولا % % 82(@)(@@) % وكأن صفح البرق سيفك ظل من % % غمد الغمامة مرهفا مسلولا % % 83(@)(@@) % كم بلدة للكفر قد عوضت من % % ناقوسها التكبير والتهليلا % % 84(@)(@@) % صدقت مقدمة الجيوش فصيرت % % من حينها موضوعها محمولا % % 85(@)(@@) % كسروا تماثيل الصليب ومثلوا % % بمن انتمى لولائه تمثيلا % % 86(@)(@@) % لما أحطت بها وحان دمارها % % أخرجت مترفها الأعز ذليلا % % 87(@)(@@) % تجري الدموع وما تبل غليله % % فمصفد يبكي هناك قتيلا % % 88(@)(@@) % سلت يمين الملك منك على العدا % % غضبا مهيب الشفرتين صقيلا % % 89(@)(@@) % لم يرض سيفك أن يحلى جوهرا % % حتى يحلى عسجدا محلولا % % 90(@)(@@) % لم ترض همتك القليل من التقى % % حتى أتت بالصالحات قبيلا % % PageV01P169 91(@)(@@) % فأقمت ميلاد الرسول بليلة % % أوضحت فيها للجهاد سبيلا % % 92(@)(@@) % حيث القباب البيض جللت الربا % % أزهار روض ما اكتسين ذبولا % % 93(@)(@@) % ومواقد النيران تذكى حولها % % فينير مشعلها ربا وسهولا % % 94(@)(@@) % والأفق فوقك قبة محبوكة % % مدت عليك طرافها المسدولا % % 95(@)(@@) % ورمى إليك ببدره ونجومه % % يهديك منه التاج والإكليلا % % 96(@)(@@) % حيث الكتائب قد تلاطم موجها % % وتدفقت فيها الخيول سيولا % % 97(@)(@@) % زخرت بأمواج الحديد وربما % % ضاق الفضاء فما وجدن مسيلا % % 98(@)(@@) % يتجاوب التكبير في جنباتها % % فتعيده غر الجياد صهيلا % % 99(@)(@@) % حملت من الأبطال كل مشمر % % لا يقتني سمر القنا ونصولا % % 100(@)(@@) % آساد ملحمة إذا اشتجر الوغى % % دخلوا من الاسل المثقف غيلا % % PageV01P170 101(@)(@@) % إن شمروا يوم الحروب ذيولهم % % سحبوا من الزرد المفاض ذيولا % % 102(@)(@@) % أو قصروا يوم الطعان رماحهم % % وصلوا بها الخطو الوساع طويلا % % 103(@)(@@) % يا ليلة ظفرت يداي بأجرها % % وسهرت فيها بالرضا مشمولا % % 104(@)(@@) % والله لو عوضت عنك شبيبتي % % ما كنت ارضى بالشباب بديلا % % 105(@)(@@) % يا ناصر الإسلام يا ملك العلا % % الله يؤتيك الجزاء جزيلا % % 106(@)(@@) % جهز جيوشك للجهاد موفقا % % وكفى بربك كافيا وكفيلا 
ms47	 % % 107(@)(@@) % ولتبعد الغارات في أرض العدا % % والله حسبك ناصرا ووكيلا % % 108(@)(@@) % وإليك من سمر الجهاد غريبة % % جاءت تقرظك الثناء جميلا % % 109(@)(@@) % وأطلت لكني أطبت وعادتي % % ألفى مطيبا في المديح مطيلا % % 110(@)(@@) % لا زال نصرك كلما استنجدته % % لمهم دينك عائدا موصولا % % PageV01P171 البحر : - 1(@)(@@) % لك غرة ود الصباح جمالها % % ومحاسن تهوى البدور كمالها % % 2(@)(@@) % وشمائل تحكي الرياض خلالها % % وأنامل ترجو الأنام خلالها % % 3(@)(@@) % للمستعين خلافة نصرية % % عرفت ملوك العالمين جلالها % % 4(@)(@@) % وأنا الذي قد نال منك معاليا % % تهدي النجوم الزاهرات منالها % % 5(@)(@@) % تهديه ما قد نلته من بعضها % % فالفخر كل الفخر فيمن نالها % % 6(@)(@@) % في كل يوم منك منة منعم % % لو طاولت سمك السما ما طالها % % 7(@)(@@) % بلغت آمال العبيد فبلغت % % فيك العبيد من البقا آمالها % % PageV01P172 البحر : - 1(@)(@@) % نجوم أمدتها بدور كوامل % % لها النور من شمس الخلافة شامل % % 2(@)(@@) % وفي الشهب من بدر السماء مشابه % % وفي البدر من شمس النهار مخايل % % 3(@)(@@) % وتعرف فيها من أبيها شمائل % % كما في أبيها من أبيه شمائل % % 4(@)(@@) % مراتب في عد الحساب ثلاثة % % وهن لأقمار العلاء منازل % % 5(@)(@@) % طلعن على حكم السعود أهلة % % وسرعان ما تبدو وهن كوامل % % 6(@)(@@) % تجلت إلى الأبصار من أفق الهدى % % وبثت إلى الأنصار منها وسائل % % 7(@)(@@) % فيا ايها المولى الذي شاد آخرا % % من الفخر ما لم تستطعه الأوائل % % 8(@)(@@) % بنوك كأمثال الأنامل عدة % % فزانت يد الإسلام تلك الأنامل % % 9(@)(@@) % غصون بروض الجود منك ترعرعت % % وقد جادها من صوب نعماك وابل % % 10(@)(@@) % فوالله ما أدري إذا ما تذوكرت % % أأخلاقها تجلى لنا أم خمائل % % PageV01P173 11(@)(@@) % غيوث سماح والعفاة مسايل % % ليوث كفاح والكماة تنازل % % 12(@)(@@) % سيوف محلاة على عاتق الهدى % % إذا تنتضى تمضي وتنبو المناصل % % 13(@)(@@) % تخاف عداة الدين منهم وتتقي % % كما تتقي الأسد الظباء الجوافل % % 14(@)(@@) % وإن أبا الحجاج وهو كبيرهم % % محل كثير دونه متضائل % % 15(@)(@@) % عليك إذا استقبلت غرة وجهه % % تخيلت أن الشمس في ما تقابل % % 16(@)(@@) % إذا استمطرت في المحل سحب بنانه % % فهن لمستجد هوام هوامل % % 17(@)(@@) % وإن سال ماء البشر 
ms48	 فوق جبينه % % فليس بمدفوع عن الورد سائل % % 18(@)(@@) % تقلد منه عاتق الملك صارما % % له العزم نصل والسعود حمائل % % 19(@)(@@) % وأبناؤه در تناسق عقده % % يحلى بهم من لبة الفخر عاطل % % 20(@)(@@) % أزاهر في روض المحاسن أينعت % % فلا روضها ذاو ولا الزهر ذابل % % PageV01P174 21(@)(@@) % زواهر في أفق العلاء تطلعت يشابه بعض بعضها ويشاكل % . . . % 22(@)(@@) % فما منهم إلا أغر محجل % % بورد المعالي في الشبيبة ناهل % % 23(@)(@@) % اقمت لها الأعذار موسم رحمة % % تسنت به للمتقين المآمل % % 24(@)(@@) % وما هو إلا مورد لسعادة % % تفيض لها منه المنى والفواضل % % 25(@)(@@) % وأجريت سرعان الجياد بملعب % % تذكر فيه موقف الجد هازل % % 26(@)(@@) % نجوم وآفاق الطراد مشارق % % عليها بدور من وجوه كوامل % % 27(@)(@@) % مفاتيح أبواب الفتوح فطالما % % ابيحت بها للكافرين المعاقل % % 28(@)(@@) % فاشهب كالاصباح راق أديمه % % وغالت بدور من وجوه كوامل % % 29(@)(@@) % ألم تر أن الشهب في الأفق كلما % % تجلى له الإصباح فهي أوائل % % 30(@)(@@) % وأحمر زان الورد منه خميلة % % يحف به نهر من السيف سائل % % PageV01P175 31(@)(@@) % جرت لونه من فوقه مهج العدا % % فلله منه الجامد المتسايل % % 32(@)(@@) % تلاقي به أمثاله فكأنها % % جمار وقد اذكى بها البأس باسل % % 33(@)(@@) % إذا قبست بالركض في حومة الوغى % % تنير بها ليل القتام مشاعل % % 34(@)(@@) % واشقر مهما حاول البرق في مدى % % يفوت جواد البرق منه المحاول % % 35(@)(@@) % تحلى بمحلول النضار أديمه % % فكل محلى دونه فهو عاطل % % 36(@)(@@) % وأدهم في مسح الدجى متلفع % % وقد خاض منه في الصباح الأسافل % % 37(@)(@@) % يكلل بالجوزاء حلي لجامه % % فدر الدراري من حلاه عواطل % % 38(@)(@@) % ولم يرضه سرج الهلال مفضضا % % فأعرض عنها للأهلة ناعل % % 39(@)(@@) % واصفر في ثوب الأصيل قد ارتدى % % وربتما ودت حلاه الأصائل % % 40(@)(@@) % وقد قد من برد العشي جلاله % % وفي ذيله صبغ من الليل حائل % % PageV01P176 41(@)(@@) % وصاعدة في الجو ملء عنانها % % تسامت أعنان السما وتطاول % % 42(@)(@@) % طلعت تحيي البدر منها بصعدة % % عليها لواء الصبح في الأفق ماثل % % 43(@)(@@) % وقد أعربت بالرفع عن طيب فخرها % % متى نصبتها في الفضاء العوامل % % 44(@)(@@) % يمد لها الكف الخضيب بساعد % % ويشكي 
ms49	 السماك الأعزل الرمح عامل % % 45(@)(@@) % وتنتابها هيف العصي كأنها % % سهام وعاها للرمية نابل % % 46(@)(@@) % تراوغها طورا وطورا تضيفها % % فسام لأعلى مرتقاها ونازل % % 47(@)(@@) % وبالامس كانت بعض أغصان دوحها % % فنقلها عنها على الرغم ناقل % % 48(@)(@@) % فحنت إلى أوطانها وتسابقت % % تعاود مسراها بها وتواصل % % 49(@)(@@) % وبرج منيف في ذراها قد ارتقى % % لترفع منه للبروج الرسائل % % 50(@)(@@) % تطور حالات أتى في جميعها % % بأوضاع حلي وصفه متغافل % % PageV01P177 51(@)(@@) % فتاج بأعلاها وشاح بخصرها % % وفي الساق منه قد أديرت خلاخل % % 52(@)(@@) % وما هو إلا قائم مد فلكه % % إلى الله في البقيا لما صد سائل % % 53(@)(@@) % ولله عينا من رأى القصر حوله % % منازل فيها للسعود منازل % % 54(@)(@@) % تروقك فيه للبدور مطالع % % إذا مثلت في ساحتيه الأماثل % % 55(@)(@@) % مظاهر أقمار مراتب أنجم % % منازل بالنصر العزيز أواهل % % 56(@)(@@) % وقد كان هول الحفل روع أهلة % % واشعرت الإشفاق تلك المحافل % % 57(@)(@@) % فأبدت به أبناء نجلك أوجها % % تبين إلى السارين منها المجاهل % % 58(@)(@@) % فلا الحفل مرهوب ولا الخطو قاصر % % ولا السرب مرتاع ولا الروع هائل % % 59(@)(@@) % ولا القلب منخوب ولا الحلم طائش % % ولا العقل معقول ولا الفكر ذاهل % % 60(@)(@@) % أولئك ابناء الخلافة بوكروا % % وتجري على أعدائهن الصواهل % % PageV01P178 61(@)(@@) % هنيئا بها من سنة نبوية % % زها الفخر محصول لديها وحاصل % % 62(@)(@@) % ورحمى له من عاذر بان عذره % % وأوهم نقصا فضله متطاول % % 63(@)(@@) % فنقص هلال الأفق ما زال مؤذنا % % لمرآه أن يبدو لنا وهو كامل % % 64(@)(@@) % ومن نقص ظل الشمس تزداد رفعة % % إلى أن ترى والظل في الشرق مائل % % 65(@)(@@) % وإن تابع النقص الشهور فإنها % % على إثره تأتي وهن كوامل % % 66(@)(@@) % ونقص صلاة الظهر يوم عروبة % % لمعنى كما أوضحته الدلائل % % 67(@)(@@) % وإن نقص البازي رياش جناحه % % يزيد استباقا وهو للصيد خاتل % % 68(@)(@@) % وتستفرغ الأنعام ما في ضروعها % % عشيا لتغدو والضروع حوافل % % 69(@)(@@) % ونقص زكاة المال فيه وفوره % % ومشق ذباب السيف يخشاه صاقل % % 70(@)(@@) % لك الخير من صنع جلوت محاسنا % % يحدي بها حادي السرى ويناقل % % PageV01P179 71(@)(@@) % الا هكذا فليعقد الفخر تاجه % % ويسمو إلى أوج العلا ويطاول 
ms50	 % % 72(@)(@@) % بأبلج غار الصبح منه بطلعة % % لها البدر تاج والنجوم قبائل % % 73(@)(@@) % إذا خطب العليا تخطت بركبه % % على خطر المسعى القنا والقنابل % % 74(@)(@@) % ولو رام إدراك النجوم بحيلة % % لأحرز من إدراكها ما يحاول % % 75(@)(@@) % وإن طلبت زهر النجوم لحاقه % % فمن دون ما تبغي المدى المتطاول % % 76(@)(@@) % وتخفق بالنصر العزيز بنوده % % إذا خفقت فيها الصبا والشمائل % % 77(@)(@@) % وليل جهاد بات يرعى نجومه % % فلا الليل منجاب ولا النجم آفل % % 78(@)(@@) % يراعي حماة الدين فيه بمقلة % % يراعي بها الإسلام كاف وكافل % % 79(@)(@@) % إذا اشتاق هز الريح خافق بنده % % وإن حن غنته الجياد الصواهل % % 80(@)(@@) % وفي الله عن وصل الأحبة مرغب % % وفي الغزو عن ذكر المنازل شاغل % % PageV01P180 81(@)(@@) % من الخزرجين الذين نمتهم % % عشائر من قحطانها وفصائل % % 82(@)(@@) % تسامى إلى ماء السماء فجوده % % بماء سماء في البسيطة حائل % % 83(@)(@@) % أقول لمستام الربيع وقد غدا % % يرود مصاب الغيث والعام ماحل % % 84(@)(@@) % أمامك دار للغني بربه % % بأرجائها للمعتفين مناهل % % 85(@)(@@) % تفجر من كفيه عشرة أبحر % % يغص بهن البحر وهي أنامل % % 86(@)(@@) % فتجري بها سفن الرجاء إلى مدى % % وليس إلى الجودي من الجود ساحل % % 87(@)(@@) % فراجيه تستجدي العفاة نواله % % وسائله ترجى إليه الوسائل % % 88(@)(@@) % أحاديث عنه في السماح غريبة % % يروي عواليها عطاء وواصل % % 89(@)(@@) % لك الله من نال غمام بنانه % % أقامت فروض البر منها النوافل % % 90(@)(@@) % طلعت بأفق الغرب نير رحمة % % وقد شرفت منك العلا والفضائل % % PageV01P181 91(@)(@@) % فحمدك أحرى ما أفادت حقائب % % وذكرك أسنى ما أقلت رواحل % % 92(@)(@@) % تروم جواري الشهب شأوك في العلا % % ومن دونه للنيرات مراحل % % 93(@)(@@) % وفي الصبح من ذاك الجبين أشعة % % وفي الشمس من ذاك المحيا دلائل % % 94(@)(@@) % وفي الروض من رياك عرف ونفحة وفي الغيث من يمناك جود ونائل % . . . % 95(@)(@@) % إذا أنت لم تزج الجنود إلى العلا % % فإن جنود الله عنك تناضل % % 96(@)(@@) % وإن لم تقومها سهاما مريشة % % فإن سهام الله عنك تناضل % % 97(@)(@@) % تريش لك الأقدار اسهم اسعد % % تصاب بها للدار عين مقاتل % % 98(@)(@@) % لك العز تستجلي الخطوب بنوره % % فليس له إلا 
ms51	 الصباح مماثل % % 99(@)(@@) % إذا العزم لم يصقل حسام كميه % % فما نافع ما قد جلته الصياقل % % 100(@)(@@) % فقبل مضاء السيف تمضى عزائم % % وبعد بناء الراي تبنى المعاقل % % PageV01P182 101(@)(@@) % وما يستوي والعلم لله وحده % % عليم بأعقاب الأمور وجاهل % % 102(@)(@@) % تظلل سحب الطير جيشك حيثما % % تميل به الرايات وهي حوامل % % 103(@)(@@) % فلاقى بها عقبان طير وراية % % تبيد الأعادي والرماح حبائل % % 104(@)(@@) % فقل لعميد الروم دونك فارتقب % % طلائع فيها للمنايا رسائل % % 105(@)(@@) % وشم بارق السيف اللموع جفونه % % سحاب قتام تحته الدم سائل % % 106(@)(@@) % ولا تزجر الغربان في البحر إنها % % سفائن والبحر المذلل حامل % % 107(@)(@@) % ولكنها والله ينجز وعده % % جوار بآساد الرجال حوامل % % 108(@)(@@) % ومخضرة الأرجاء في جنباتها % % مسارح تحميها الرماح الذوابل % % 109(@)(@@) % ترى الدوح منها بالأسنة مزهرا % % إذا ما سقته للسيوف الجداول % % 110(@)(@@) % تبل غليل الرمح من مهج العدا % % إذا ما كست منها الرماح غلائل % % PageV01P183 111(@)(@@) % فيا عجبا للرمح رويته دما % % وقد راق منه العين ريان ذابل % % 112(@)(@@) % لقد كملت فيك المحاسن كلها % % وما كل من يعطى الخلافة كامل % % 113(@)(@@) % فعند جميع الخلق شكرك عاجل % % وعند الإله الحق أجرك آجل % % 114(@)(@@) % ودونك من نظمي جواهر حكمة % % يفاخر منها السحر بالشعر بابل % % 115(@)(@@) % وما هو إلا ذكر أوصافك العلا % % فتفعل يا مولاي والعبد قائل % % 116(@)(@@) % فتتلى على الأسماع منها بدائع % % وتجلى على الأبصار منها عقائل % % 117(@)(@@) % ولو أنني أدركت أعصار من مضى % % لما قال فيها الشاعر المتخايل % % 118(@)(@@) % وإني وإن كنت الأخير زمانه % % لآت بما لم تستطعه الأوائل % % 119(@)(@@) % ولا افتخرت قدما إياد بقسها % % ولا استصحبت سحبان في الفخر وائل % % 120(@)(@@) % فلا زلت يا مولاي مورد رحمة % % عطاش الأماني في رضاك نواهل % % PageV01P184 121(@)(@@) % تقيم رسوم المعلوات بمغرب % % وذكرك في أقصى البسيطة جائل % % 122(@)(@@) % وأدركت في الأعداء ما أنت طالب % % وبلغت في الابناء ما أنت آمل % % PageV01P185 البحر : - 1(@)(@@) % أبحر سماح مد عشرة ابحر % % تفيض غمام الجود وهي الأنامل % % 2(@)(@@) % بكفك غيث للبلاد وأهلها % % يروض محل الأرض والعام ما حل % % 3(@)(@@) % لك الخير أن أصبحت بحر سماحة 
ms52	 % % يعم نداه فالمواهب ساحل % % 4(@)(@@) % خلعت على هذا الرسول ملابسا % % بها تتسنى في علاك المآمل % % 5(@)(@@) % وبلغته آماله كيف شاءها % % فبلغت يا مولاي ما أنت آمل % % PageV01P186 البحر : - 1(@)(@@) % أقول لبدر التم كيف هلالكا % % نعمت صباحا بالسعود وآلكا % % 2(@)(@@) % وبلغت في النجل الكريم سعادة % % تقربها عينا وينعم بالكا % % 3(@)(@@) % وخصصت بالبشرى من الله ربنا % % كما عم أقطار البلاد نوالكا % % PageV01P187 البحر : - 1(@)(@@) % أسائل بدر التم كيف هلاله % % وأدعو له الرحمن جل جلاله % % 2(@)(@@) % وأسأله تعجيل راحته التي % % وسيلتنا فيها النبي وآله % % 3(@)(@@) % ستبلغ فيه ما تؤمل من منى % % ويرضيك يا بدر الكمال كماله % % PageV01P188 البحر : - 1(@)(@@) % بشرى كما وضح الزمان وأجمل % % يعشي سناها كل من يتأمل % % 2(@)(@@) % ابدى لها وجه النهار طلاقة % % وأفتر من ثغر الاقاح مقبل % % 3(@)(@@) % ومنابر الإسلام يا ملك الورى % % بحلاك أو بحليها تتكلل % % 4(@)(@@) % تجلو لنا الأكوان منك محاسنا % % تروى على مر الزمان وتنقل % % 5(@)(@@) % فالشمس تأخذ من جبينك نورها % % والبشر منك بوجهها يتهلل % % 6(@)(@@) % والروض ينفح من ثنائك طيبه % % والورق فيه بالممادح تهدل % % 7(@)(@@) % والبرق سيف من سيوفك منتضى % % والسحب تهمي من يديك وتهمل % % 8(@)(@@) % يا ايها الملك الذي أوصافه % % در على جيد الزمان يفصل % % 9(@)(@@) % الله أعطاك التي لا فوقها % % وحباك بالفضل الذي لا يجهل وجه كما حسر الصباح نقابه لضيائه تعشو البدور الكمل % % 10(@)(@@) % تلقاه في يوم السماحة والوغى % % والبشر في وجناته يتهلل % % PageV01P189 11(@)(@@) % كف أبت ألا تكف عن الندى % % أبدا فإن ضن الحيا تسترسل % % 12(@)(@@) % وشمائل كالروض باكره الحيا % % وسرت برياه الصبا والشمال % % 13(@)(@@) % خلق ابن نصر في الجمال كخلقه % % ما بعدها من غاية تستكمل % % 14(@)(@@) % نور على نور بأبهى منظر % % في حسنه لمؤمل ما يأمل % % 15(@)(@@) % فاق الملوك بسيفه وبسيبه % % فبعد له وبفضله يتمثل % % 16(@)(@@) % وإذا تطاول للعميد عميدهم % % فله عليه تطاول وتطول % % 17(@)(@@) % يا آية الله التي أنوارها % % يهدى بها قصد الرشاد الضلل % % 18(@)(@@) % قل للذي التبست معالم رشده % % هيهات قد وضح الطريق الأمثل % % 19(@)(@@) % قد ناصح الإسلام خير خليفة % % وحمى عزيز الملك 
ms53	 أغلب مشبل % % 20(@)(@@) % فلقد ظهرت من الكمال بمستوى % % ما بعده لذوي الخلافة مأمل % % PageV01P190 21(@)(@@) % وعناية الله اشتملت رواءها % % وعلقت منها عروة لا تفصل % % 22(@)(@@) % فالجود إلا من يديك مقتر % % والغيث إلا من نداك مبخل % % 23(@)(@@) % والعمر إلا تحت ظلك ضائع % % والعيش إلا في جنابك ممحل % % 24(@)(@@) % حيث الجهاد قد اعتلت راياته % % حيث المغانم للعفاة تنفل % % 25(@)(@@) % حيث القباب الحمر ترفع للقرى % % قد عام في أرجائهن المندل % % 26(@)(@@) % يا حجة الله التي برهانها % % عز المحق به وذل المبطل % % 27(@)(@@) % قل للذي ناواك يرقب يومه % % فوراءه ملك يقول ويفعل % % 28(@)(@@) % والله جل جلاله إن أمهلت أحكامه مستدرجا لا تهمل % . . . % 29(@)(@@) % يا ناصر الإسلام وهو فريسة % % أسد الفلا من حولها تتسلل % % 30(@)(@@) % يا فخر أندلس وعصمة أهلها % % لك فيهم النعمى التي لا تجهل % % PageV01P191 31(@)(@@) % لا يهمل الله الذين رعيتهم % % فلأنت أكفى والعناية أكفل % % 32(@)(@@) % لا يبعد النصر العزيز فإنه % % آوى إليك وأنت نعم الموئل % % 33(@)(@@) % لولا نداك لها لما نفع الندى % % ولجف من ورد الصنائع منهل % % 34(@)(@@) % لولاك كان الدين يغمط حقه % % ولكان دين النصر فيه يمطل % % 35(@)(@@) % لكن جنيت الفتح من شجر القنا % % وجنى الفتوح لمن عداك مؤمل % % 36(@)(@@) % ولقبل ما استفتحت كل ممنع % % من دونه باب المطامع مقفل % % 37(@)(@@) % ومتى نزلت بمعقل متأشب % % فالعصم من شعفاته تستنزل % % 38(@)(@@) % وإذا غزوت فإن سعدك ضامن % % ألا تخيب وأن قصدك يكمل % % 39(@)(@@) % فمن السعود أمام جيشك موكب % % وفي الملائك دون جندك جحفل % % 40(@)(@@) % وكتيبة أردفتها بكتيبة % % والخيل تمرح في الحديد وترفل % % PageV01P192 41(@)(@@) % من كل منحفز كلمحة بارق % % بالبدر يسرج والأهلة ينعل % % 42(@)(@@) % أوفى بهاد كالظليم وخلفه % % كفل كما ماج الكثيب الأهيل % % 43(@)(@@) % حي إذا ملك الكمي عنانه % % يهوي كما يهوي بجو أجدل % % 44(@)(@@) % حملت أسود كريهة يوم الوغى % % ما غابها إلا الوشيج الذبل % % 45(@)(@@) % لبسوا الدروع غدائرا مصقولة % % والسمر قضب فوقها تتهدل % % 46(@)(@@) % من كل معتدل القوام مثقف % % لكنه دون الضريبة يعسل % % 47(@)(@@) % أذكيت فيه شعلة من نصله % % يهدي بها إن ضل عنه المقتل 
ms54	 % % 48(@)(@@) % ولرب لماع الصقال مشهر % % ماض ولكن فعله مستقبل % % 49(@)(@@) % رقت مضاربه وراق فرنده % % فالحسن فيه مجمل ومفصل % % 50(@)(@@) % فإذا الحروب تسعرت أجزالها % % ينساب في يمناك منها جدول % % PageV01P193 51(@)(@@) % وإذا دجا ليل القتام رأيته % % وكأنه فيه ذبال مشعل % % 52(@)(@@) % فاعجب لها من جذوة لا تنطفي % % في أبحر زخرت وهن الأنمل % % 53(@)(@@) % هي سنة أحييتها وفريضة % % أديتها قرباتها تتقبل % % 54(@)(@@) % فإذا الملوك تفاخرت بجهادها % % فلأنت أحفى بالجهاد وأحفل % % 55(@)(@@) % يا ابن الذين جمالهم ونوالهم % % شمس الضحى والعارض المتهلل % % 56(@)(@@) % يا ابن الإمام ابن الإمام ابن الأمام % % ابن الإمام وقدرها لا يجهل % % 57(@)(@@) % آباؤك الأنصار تلك شعارهم % % فلحيهم آوى النبي المرسل % % 58(@)(@@) % فهم الألى نصروا الهدى بعزائم % % مصقولة وبصائر لا تخذل % % 59(@)(@@) % ماذا يحبر شاعر في مدحهم % % وبفضلهم أثنى الكتاب المنزل % % 60(@)(@@) % مولاي لا أحكي مآثرك التي % % بحديثها تنضى المطي الذلل % % PageV01P194 61(@)(@@) % وإذا الحقائق ليس يدرك كنهها % % سيان فيها مكثر ومقلل % % 62(@)(@@) % فإليك من شوال غرة وجهه % % أهداكها يوم أغر محجل % % 63(@)(@@) % عذراء راق العيد رونق حسنها % % فغدا بنظم حليها يتجمل % % 64(@)(@@) % رضعت لبان العلم في حجر النهى % % فوفت لها في ضروع حفل % % 65(@)(@@) % سلك البيان بها سبيل إجادة % % لولا صفاتك كان عنها يعدل % % 66(@)(@@) % جاءت تهني العيد أيمن قادم % % وافى بشهر صيامه يتوسل % % 67(@)(@@) % وطوى الشهور مراحلا معدودة % % كيما يرى بفناء جودك ينزل % % 68(@)(@@) % وأتى وقد شف النحول هلاله % % ولشوقه للقاء وجهك ينحل % % 69(@)(@@) % عقدت بمرقبة العيون مسرة % % فمكبر لطلوعه ومهلل % % 70(@)(@@) % فاسلم لألف مثله في غبطة % % ظل المنى من فوقه يتهدل % % PageV01P195 71(@)(@@) % فإذا بقيت لنا فكل سعادة % % في الدين والدنيا بها تتكفل % % PageV01P196 البحر : - 1(@)(@@) % طلع الهلال وأفقه متهلل % % فمكبر لطلوعه ومهلل % % 2(@)(@@) % أوفى على وجه الصباح بغرة % % فغدا الصباح بنوره يتجمل % % 3(@)(@@) % شمس الخلافة قد أمدت نوره % % وبسعدها يرجو التمام ويكمل % % 4(@)(@@) % لله منه هلال سعد طالع % % لضيائه تعشو البدور الكمل % % 5(@)(@@) % وألحت يا شمس الهداية كوكبا % % يعشي سناه كل من يتأمل % % 6(@)(@@) % والتاج تاج البدر في أفق العلا % % ما 
ms55	 زال بالزهر النجوم يكلل % % 7(@)(@@) % ولئن حوى كل الجمال فإنه % % بالشهب أبهى ما يكون وأجمل % % 8(@)(@@) % أطلعت يا بدر السماح هلاله % % والملك أفق والخلافة منزل % % 9(@)(@@) % يبدو بهالات السروج وإنه % % من نور وجهك في العلا يستكمل % % 10(@)(@@) % قلدت عطف الملك منه صارما % % بغنائه ومضائه يتمثل % % PageV01P197 11(@)(@@) % حليته بحلى الكمال وجوهر الخلق % % النفيس وكل خلق يجمل % % 12(@)(@@) % يغزو أمامك والسعود أمامه % % وملائك السبع العلا تتنزل % % 13(@)(@@) % من مبلغ الأنصار منه بشارة % % غر البشائر بعدها تسترسل % % 14(@)(@@) % أحيا جهادهم وجدد فخرهم % % بعد المئين فملكهم يتأثل % % 15(@)(@@) % فيه إلى الأجر الجزيل توصلوا % % وبهم إلى رب السما يتوسل % % 16(@)(@@) % من مبلغ الأذواء من يمن وهم % % قد توجوا وتملكوا وتقيلوا % % 17(@)(@@) % أن الخلافة في بينهم أطلعت % % قمرا به سعد الخليقة يكمل % % 18(@)(@@) % من مبلغ قحطان آساد الشرى % % ما غابها إلا الوشيح الذبل % % 19(@)(@@) % أن الخلافة في بينهم أطلعت % % قمرا به سعد الخليفة يكمل % % 20(@)(@@) % من مبلغ قحطان آساد الشرى % % ما غابها إلا الوشيح الذبل % % PageV01P198 21(@)(@@) % أن الخلافة في بنيهم أطلعت % % قمرا به سعد الخليقة يكمل % % 22(@)(@@) % من مبلغ قحطان آساد الشرى % % ما غابها إلا الوشيح الذبل % % 23(@)(@@) % أن الخلافة وهو شبل ليوثهم % % قد حاط منها الدين ليث مشبل % % 24(@)(@@) % يهني بني الأنصار أن إمامهم % % قد بلغته سعوده ما يأمل % % 25(@)(@@) % يهني البنود فإنها ستظله % % وجناح جبريل الأمين يظلل % % 26(@)(@@) % يهني الجياد الصافنات فإنها % % بفتوحه تحت الفوارس تهدل % % 27(@)(@@) % يهني المذاكي والعوالي والظبي % % فيها إلى نيل المنى يتوصل يهني المعالي والمفاخر أنه في مرتقى أوج العلا يتوقل % % 28(@)(@@) % سبقت مقدمة الفتوح قدومه % % وأتاك وهو الوادع المتمهل % % 29(@)(@@) % وبدت نجوم السعد قبل طلوعه % % تجلو المطامع قبله وتؤثل % % 30(@)(@@) % وروت أحاديث الفتوح غرائبا % % والنصر يملي والبشائر تنقل % % PageV01P199 31(@)(@@) % ألقت إليك به السعود زمامها % % فالسعد يمضي ما تقول ويفعل % % 32(@)(@@) % فالفتح بين معجل ومؤجل % % ينسيك ماضيه الذي يستقبل % % 33(@)(@@) % أوليس في شأن المشير دلالة % % أن المقاصد من طلابك تكمل % % 34(@)(@@) % ناداهم داعي الضلال فاقبلوا % % ودعاهم داعي المنون فجدلوا % % 35 
ms56	(@)(@@) % عصوا الرسول إباية وتحكمت % % فيهم سيوفك بعدها فاستمثلوا % % 36(@)(@@) % كانوا جبالا قد علت هضباتها % % نسفتهم ريح الجلاد فزلزلوا كانوا بحارا من حديد زاخر أذكتهم نار الوغى فتسيلوا % % 37(@)(@@) % ركبت أرجلها الأداهم كلما % % يتحركون إلى قيام تصهل % % 38(@)(@@) % كان الحديد لباسهم وشعارهم % % واليوم لم تلبسه إلا الأرجل % % 39(@)(@@) % الله أعطاك التي لا فوقها % % فتحا به دين الهدى يتأثل % % 40(@)(@@) % جددت للأنصار حلي جهادها % % فالدين والدنيا به تتجمل % % PageV01P200 41(@)(@@) % من يتحف البيت العتيق وزمزما % % والوفد وفد الله فيه ينزل % % 42(@)(@@) % متسابقين إلى مثابة رحمة % % من كل ما حدب إليه تنسل % % 43(@)(@@) % هيما كأفواج القطا قد ساقها % % ظمأ شديد والمطاف المنهل % % 44(@)(@@) % من كل مرفوع الأكف ضراعة % % والقلب يخفق والمدامع تهمل % % 45(@)(@@) % حتى إذا روت الحديث مسلسلا % % بيض الصوارم والرماح العسل % % 46(@)(@@) % من فتحك الأسنى عن الجيش الذي % % بثباته أهل الوغى تتمثل % % 47(@)(@@) % أهدتهم السراء نصرة دينهم % % واستبشروا بحديثها وتهللوا % % 48(@)(@@) % وتناقلوا عنك الحديث مسرة % % بسماعه واهتز ذاك المحفل % % 49(@)(@@) % ودعوا بنصرك وهو أعظم مفخرا % % أن الحجيج بنصر ملكك يحفل % % 50(@)(@@) % فاهنأ بملكك واعتمد شكرا به % % لطف الاله وصنعه تتخول % % PageV01P201 51(@)(@@) % شرفت منه باسم والدك الرضى % % يحيا به منه الكريم المفضل % % 52(@)(@@) % أبديت من حسن الصنيع عجائبا % % تروي على مر الزمان وتنقل % % 53(@)(@@) % خفقت به أعلامك الحمر التي % % بخفوقها النصر العزيز موكل % % 54(@)(@@) % هدرت طبول العز تحت ظلالها % % عنوان فتح إثرها يستعجل % % 55(@)(@@) % ودعوت اشراف البلاد وكلهم % % يثنى الجميل وصنع جودك أجمل % % 56(@)(@@) % وردوا ورود الهيم أجهدها الظما % % فصفا لهم من ورد كفك منهل % % 57(@)(@@) % وأثرت فيه للطراد فوارسا % % مثل الشموس وجوههم تتهلل % % 58(@)(@@) % من كل وضاح الجبين كأنه % % نجم وجنح النقع ليل مسبل % % 59(@)(@@) % يرد الطراد على أغر محجل % % في سرجه بطل أغر محجل % % 60(@)(@@) % قد عودوا قنص الكماة كأنما % % عقبانها ينقض منها أجدل % % PageV01P202 61(@)(@@) % يستتبعون هوادجا موشية % % تنسي عقول الناظرين وتذهل % % 62(@)(@@) % وتضمن جزل الوقود حمولها % % والنصر في التحقيق ما هي تحمل % % 63(@)(@@) % والعاديات إذا تلت فرسانها % % آي القتال صفوفها تترتل 
ms57	 % % 64(@)(@@) % لله خيلك إنها لسوابح % % بحر القتام وموجه متهيل % % 65(@)(@@) % من كل برق بالثريا ملجم % % بالبدر يسرج والأهلة ينعل % % 66(@)(@@) % أوفى بهاد كالظليم وخلفه % % كفل كما ماج الكثيب الاهيل % % 67(@)(@@) % حتى البوارق غير أن جيادها % % عن سبق خيلك يا مؤيد تنكل % % 68(@)(@@) % من اشهب كالصبح يعلو سرجه % % صبح به نجم الضلالة يأفل % % 69(@)(@@) % أو أدهم كالليل قلد شهبه % % خاض الصباح فأثبتته الأرجل % % 70(@)(@@) % أو أشقر سال النضار بعطفه وكساه صبغة بهجة لا تنصل % . . . % PageV01P203 71(@)(@@) % أو أحمر كالجمر أضمر بأسه % % بالركض في يوم الحفيظة يشعل % % 72(@)(@@) % كالخمر أترع كاسها لندامها % % وبها حبابة غرة تتسيل % % 73(@)(@@) % أو اصفر لبس العشي ملاءة % % وبذيله لليل ذيل مسبل % % 74(@)(@@) % أجملت في هذا الصنيع عوائدا الجود فيها مجمل ومفضل % . . . % 75(@)(@@) % أنشأت فيها من نداك غمائما % % بالفضل تنشأ والسماحة تهمل % % 76(@)(@@) % فجرت من كفيك عشرة أبحر % % تزجي سحاب الجود وهي الأنمل % % 77(@)(@@) % من قاس كفك بالغمام فإنه % % جهل القياس ومثلها لا يجهل % % 78(@)(@@) % تسخو الغمام ووجهها متجهم % % والوجه منه مع الندى يتهلل % % 79(@)(@@) % والسحب تسمح بالمياه وجوده % % ذهب به أهل الغنى تتمول % % 80(@)(@@) % من قاس بالشمس المنيرة وجهه % % ألفيته في حكمه لا يعدل % % PageV01P204 81(@)(@@) % من أين للشمس المنيرة منطق % % ببيانه در الكلام يفصل % % 82(@)(@@) % من أين للشمس المنيرة راحة % % تسخو إذا بخل الزمان الممحل % % 83(@)(@@) % من قاس بالبدر المنير كماله % % فالبدر ينقص والخليفة يكمل % % 84(@)(@@) % من أين للبدر المنير شمائل % % تسري برياها الصبا والشمال % % 85(@)(@@) % من أين للبدر المنير مناقب % % بجهادها تنضى المطي الذلل % % 86(@)(@@) % يا من إذا نفحت نواسم حمده % % فالمسك يعبق طيبه والمندل % % 87(@)(@@) % يا من إذا لمحت محاسن وجهه % % تعشو العيون ويبهر المتأمل % % 88(@)(@@) % يا من إذا تليت مفاخر قومه % % آي الكتاب بذكرها تتنزل % % 89(@)(@@) % كفل الخلافة منك يا ملك العلا % % والله جل جلاله لك أكفل % % 90(@)(@@) % مأمونها وأمينها ورشيدها % % منصورها مهديها المتوكل % % PageV01P205 91(@)(@@) % حسب الخلافة أن تكون وليها % % ومجيرها من كل من يتحيل % % 92(@)(@@) % حسب الزمان بأن تكون إمامه % % فله بذلك عزة لا 
ms58	 تهمل % % 93(@)(@@) % حسب الملوك بأن تكون عميدها % % ترجو الندى من راحتيك وتأمل % % 94(@)(@@) % حسب المعالي أن تكون إمامها % % فعليك أطناب المفاخر تسدل % % 95(@)(@@) % يا حجة الله التي برهانها % % عز المحق به وذل المبطل % % 96(@)(@@) % أنت الإمام ابن الإمام ابن الإمام % % ابن الإمام وفخرها لا يعدل % % 97(@)(@@) % علمت حتى لم تدع من جاهل % % أعطيت حتى لم تدع من يسأل % % 98(@)(@@) % وعناية الله اشتملت رداءها وعلقت منها عروة لا تفصل % . . . % PageV01P206 البحر : - 1(@)(@@) % أخذت قلوب الكافرين مهابة % % فعقولهم من خوفها لا تعقل % % 2(@)(@@) % حسبوا البروق صوارما مسلولة % % أرواحهم من بأسها تتسلل % % 3(@)(@@) % وترى النجوم مناصلا مرهوبة % % فيفر منها الخائف المتنصل % % 4(@)(@@) % يا ابن الألى إجمالهم وجمالهم % % شمس الضحى والعارض المتهلل % % 5(@)(@@) % مولاي لا أحصي مآثرك التي % % بجهادها يتوصل المتوسل % % 6(@)(@@) % أصبحت في ظل امتداحك ساجعا % % ظل المنى من فوقه يتهدل % % 7(@)(@@) % طوقته طوق الحمائم أنعما % % فغدا بشكرك في المحافل يهدل % % 8(@)(@@) % فإليك من صون العقول عقيلة % % أهداكها صنع أغر محجل % % 9(@)(@@) % عذراء راق الصنع رونق حسنها % % فغدا بنظم حليها يتكلل % % 10(@)(@@) % خيرتها بين المنى فوجدتها % % أقصى مناها أنها تتقبل % % PageV01P207 11(@)(@@) % لا زلت شمسا في سماء خلافة % % وهلالك الاسمى يتم ويكمل % % PageV01P208 البحر : - 1(@)(@@) % يا وارث الأنصار وهي مزية % % بفخارها أثنى الكتاب المنزل % % 2(@)(@@) % أهديتني الباكور وهي بشارة % % ببواكر الفتح الذي يستقبل % % 3(@)(@@) % وولادة لهلال تم طالع % % وجه الزمان بوجهه يتهلل % % 4(@)(@@) % هو أول الأنوار في أفق الهدى % % وترى الأهلة بعدها تسترسل % % 5(@)(@@) % مولاي صدق الفال قد جربته % % من لفظ عبدك والعواقب أجمل % % PageV01P209 البحر : - 1(@)(@@) % أنا تاج كهلال % % أنا كرسي جمال % % 2(@)(@@) % ينجلي الإبريق فيه % % كعروس ذي اختيال % % 3(@)(@@) % جود مولانا ابن نصر % % قد حباني بالكمال % % PageV01P210 البحر : - 1(@)(@@) % يا فرجا عللت نفسي به % % والفال محبوب لتعليله % % 2(@)(@@) % حرمت إحليلك هذا على % % نفسي وأفتيت بتحليله % % PageV01P211 البحر : - 1(@)(@@) % ما للحمول تحن للأطلال % % ويشوقها ذكر الزمان الخالي % % 2(@)(@@) % يثني أزمة هيمها شوق إلى % % ظل الأراك وأزرق سلسال % % 3(@)(@@) % ذكرت بها الحي الجميع كعهدها % % والربع منها أخضر السربال % % 4 
ms59	(@)(@@) % والدار حالية المعاطف والربا % % ومرادها بالروضة المخضال % % 5(@)(@@) % أيان ما لعبت بها أيدي النوى % % وتراهنت في الحل والترحال % % 6(@)(@@) % وجرت بسدتها الحداة كأنها % % قطع السفائن خضن بحر ليال % % 7(@)(@@) % دعني أطارحها الحنين فإنني % % لا أنثني لمقالة العذال % % 8(@)(@@) % وهي المنازل أشبهت سكانها أعمارها تفضي إلى الآجال % . . . % 9(@)(@@) % بليت محاسنها وخف أنيسها % % والشوق والتذكار ليس ببالي % % 10(@)(@@) % ولقد أقول وما يعنف ذو الهوى % % ذهب الغرام بحيلة المحتال % % PageV01P212 11(@)(@@) % أحشى تذوب صبابة ومدامع % % تغري جفون المزن باستهلال % % 12(@)(@@) % ووراء مطلع الخدور جآذر % % تجلى شموسا في غمام حجال % % 13(@)(@@) % يا ساكني نجد وما نجد سوى % % نادي الهدى ومخيم الآمال % % 14(@)(@@) % ما للظباء الآنسات بربعكم % % عطلا وهن من الجمال خوالي % % 15(@)(@@) % أو للرياح تهب وهي بليلة % % فتهيج من وجدي ومن بلبالي % % 16(@)(@@) % هي شيمة عذرية عودتها % % قلبا شعاعا ما يرى بالسالي % % 17(@)(@@) % يا بنت من غمر العفاة نواله % % هلا سمحت ولو بطيف خيال % % 18(@)(@@) % فلكم بعثت مع النسيم تحيتي % % عودت ساري البرق من أرسالي % % 19(@)(@@) % بالله يا ريح النعامى جرري % % فوق الخزامى عاطر الاذيال % % 20(@)(@@) % وإذا مررت على الكثيب برامة % % صافح محيا الروضة المخضال % % PageV01P213 21(@)(@@) % فيها المعاهد قد طلعن بأفقها % % زمنا ولم أجنح لوقت زوال % % 22(@)(@@) % أمذكري عهد الشبيبة جاده % % صوب العهاد بواكف هطال % % 23(@)(@@) % عاطيتني عنه الحديث كأنما % % عاطيتني منه ابنه الجريال % % 24(@)(@@) % هذا على أني نزعت عن الصبا % % وصرمت من حب الحسان حبالي % % 25(@)(@@) % حسبي وقارا في الندي إذا احتبى % % وتجادلوا في الفخر كل مجال % % 26(@)(@@) % أني ألوذ بدولة نصرية % % حليت محاسنها بكل كمال % % 27(@)(@@) % حيث الوجوه صبيحة والمكرمات % % صريحة والعز غير مزال حيث المكارم سنها أعلامها من كل فياض الندى مفضال % % 28(@)(@@) % بيض الأيادي والوجوه أعزة % % قد شيدوا العليا بسمر عوالي % % 29(@)(@@) % هم آل نصر ناصرو دين الهدى % % والمصطفون لخيرة الأرسال % % 30(@)(@@) % ما شئت من مجد قديم شاده % % أبناء قيلة أشرف الأقيال % % PageV01P214 31(@)(@@) % ما منهم إلا أغر محجل % % يلقى العظائم وهو غير مبال % % 32(@)(@@) % متبسم واليوم أكلح عابس % % والحرب تدعو بالكماة 
ms60	 نزال % % 33(@)(@@) % قد عودوا النصر العزيز وخولوا % % الفتح المبين بملتقى الابطال % % 34(@)(@@) % بذلوا لدى الهيجا كرائم أنفس % % قد أرخصت في الله خير منال % % 35(@)(@@) % اصبحت وارث مجدهم وفخارهم % % ومشرف الأمصار والأبطال % % 36(@)(@@) % وطلعت في أفق الخلافة نيرا % % تجلو ظلام الظلم والإضلال % % 37(@)(@@) % فقت الملوك جلالة وبسالة % % وشأوتهم في الحلم والإجمال % % 38(@)(@@) % أعدت محاسنك المحاسن كلها % % فجمالها يزري بكل جمال % % 39(@)(@@) % فالشمس تأخذ عن جبينك نورها % % والروض ينفح عن كريم خلال % % 40(@)(@@) % والريح تحمل عن ثنائك طيبها % % في ملتقاها من صبا وشمال % % PageV01P215 41(@)(@@) % والغيث إلا من نداك مبخل % % فالغيث يقلع والندى متوال % % 42(@)(@@) % تعطي الذي لا فوقه لمؤمل % % وتجود بالإحسان قبل سؤال % % 43(@)(@@) % طاولت علوي النجوم بهمة % % لا فاقدا عزما ولا مكسال % % 44(@)(@@) % وبلغت من رتب السعادة مبلغا % % أبعدت فيه مرتقاك العالي % % 45(@)(@@) % وقياس سعدك في مرامك كله % % يقضي مقدمة بصدق التالي % % 46(@)(@@) % لمن الجياد الصافنات كأنها % % في الورد أسراب القطا الأرسال % % 47(@)(@@) % من كل ملموم القوى عبل الشوى % % مرخي العنان محفز جوال % % 48(@)(@@) % لمن القباب الحمر تشرع للندى % % فتفيض للعافين فيض سجال % % 49(@)(@@) % لمن الخيام البيض تحسب أنها % % زهر الكواكب أطلعت بحلال % % 50(@)(@@) % منداحة الأرجاء عالية الذرى % % فكأنها في الوهد شم جبال % % PageV01P216 51(@)(@@) % هو مظهر الملك العلي ومطلع النور % % الجلي بمرقب متعال % % 52(@)(@@) % آثار مولانا الإمام محمد % % بدر الهدى لا زال حلف كمال % % 53(@)(@@) % لله وجهتك التي نلنا بها % % أجر الجهاد وبغية الآمال % % 54(@)(@@) % ما شئت من حسن يفوق كماله % % ويروق منظره الجميل الحالي % % 55(@)(@@) % كم من عجائب جمة أظهرتها % % ما كان يخطر وصفهن ببال % % 56(@)(@@) % أمت وفود الناس منك مملكا % % قد خص بالتعظيم والإجلال % % 57(@)(@@) % جاءوا مواقيت اللقاء كأنهم % % وفد الحجيج برامة وألال % % 58(@)(@@) % لله عينا من رأى ملك العلا % % حف الوقار جماله بجلال % % 59(@)(@@) % في موكب لبسوا الخلوص شعاره % % وتميزوا منه بزي جمال % % 60(@)(@@) % بلغوا به العدد الكثير وكلهم % % أرضاهم إحسانك المتوالي % % PageV01P217 61(@)(@@) % يهني المرية نعمة سوغتها % % جادت بها الأيام بعد مطال % % 62(@)(@@) % قدست واديها وزرت خلالها % % فلها 