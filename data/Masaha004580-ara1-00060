ms48	 نظر الزاهد المفارق ولا تنظر إليها نظر العاشق الوامق(@)(@)(@@)(@@)(@@) ||| 163(@)(@)(@@) @HAD06 أمسك عن طريق اذا خفت ضلالته(@)(@)(@@)(@@)(@@) ||| 164(@)(@)(@@) @HAD08 إعتزم بالشدة حين لا يغنى عنك إلا الشدة(@)(@)(@@)(@@)(@@) ||| 165(@)(@)(@@) @HAD012 ألجىء نفسك فى الأمور كلها إلى الهك فإنك تلجئها إلى كهف حريز(@)(@)(@@)(@@)(@@) ||| 166(@)(@)(@@) @HAD011 إعتصم فى أحوالك كلها بالله فإنك تعتصم منه سبحانه بمانع عزيز(@)(@)(@@)(@@)(@@) ||| 167(@)(@)(@@) @HAD020 أحي قلبك بالموعظة وأمته بالزهادة وقوه باليقين وذلله بذكر الموت وقرره بالفناء وبصره فجايع الدنيا(@)(@)(@@)(@@)(@@) ||| 168(@)(@)(@@) @HAD017 أشعر قلبك الرحمة لجميع الناس والإحسان إليهم ولا تنلهم حيفا ولا تكن عليهم سيفا(@)(@)(@@)(@@)(@@) ||| 169(@)(@)(@@) @HAD021 أذكر أخاك إذا غاب بالذي تحب أن يذكرك به وإياك وما يكره ودعه مما تحب أن يدعك منه(@)(@)PageV01P140(@)(@)(@@)(@@)(@@) ||| 170(@)(@)(@@) @HAD012 إتق الله الذى لا بدلك من لقائه ولا منتهى لك دونه(@)(@)(@@)(@@)(@@) ||| 171(@)(@)(@@) @HAD017 أد الأمانة إذا ائتمنت ولا تتهم غيرك إذا ائتمنته فإنه لا ايمان لمن لا أمانة له(@)(@)(@@)(@@)(@@) ||| 172(@)(@)(@@) @HAD015 أحرس منزلتك عند سلطانك واحذر أن يحطك عنها التهاون عن حفظ ما رقاك إليه(@)(@)(@@)(@@)(@@) ||| 173(@)(@)(@@) @HAD020 إصحب من لا تراه إلا وكأنه لا غناء به عنك وإن أسأت إليه أحسن إليك وكأنه المسيىء(@)(@)(@@)(@@)(@@) ||| 174(@)(@)(@@) @HAD020 إزهد في الدنيا واعزف عنها واياك أن ينزل بك الموت وأنت آبق من ربك فى طلبها فتشقى(@)(@)(@@)(@@)(@@) ||| 175(@)(@)(@@) @HAD07 إستقبح من نفسك ما تستقبحه من غيرك(@)(@)(@@)(@@)(@@) ||| 176(@)(@)(@@) @HAD023 إرض للناس بما ترضاه لنفسك وأخلص لله عملك وعلمك وحبك وبغضك وأخذك وتركك وكلامك وصمتك(@)(@)(@@)(@@)(@@) ||| 177(@)(@)(@@) @HAD08 إسع في كدحك ولا تكن خازنا لغيرك(@)(@)(@@)(@@)(@@) ||| 178(@)(@)(@@) @HAD017 أدم ذكر الموت وذكر ما تقدم عليه بعد الموت ولا تتمن الموت إلا بشرط وثيق(@)(@)(@@)(@@)(@@) ||| 179(@)(@)(@@) @HAD019 أنصف الناس من نفسك وأهلك وخاصتك ومن لك فيه هوى وأعدل في العدو والصديق(@)(@)PageV01P141(@)(@)(@@)(@@)(@@) ||| 180(@)(@)(@@) @HAD013 أفق أيها السامع من سكرتك واستيقظ من غفلتك واحتصر من عجلتك(@)(@)(@@)(@@)(@@) ||| 181(@)(@)(@@) @HAD010 أمسك من المال بقدر ضرورتك وقدم الفضل اليوم فاقتك(@)(@)(@@)(@@)(@@) ||| 182(@)(@)(@@) @HAD030 إعقل عقلك وأملك أمرك وجاهد نفسك واعمل للأخرة جهدك واتق الله فى نفسك ونازع الشيطان قيادك واصرف إلى الأخرة وجهك واجعل لله جدك(@)(@)(@@)(@@)(@@) ||| 183(@)(@)(@@) @HAD013 إستعن على العدل بحسن النية فى الرعية وقلة الطمع وكثرة 
ms49	 الورع(@)(@)(@@)(@@)(@@) ||| 184(@)(@)(@@) @HAD015 أطع الله فى جل امورك فإن طاعة الله فاضلة على كل شىء والزم الورع(@)(@)(@@)(@@)(@@) ||| 185(@)(@)(@@) @HAD017 أجمل إدلال من أدل عليك واقبل عذر من اعتذر إليك وأحسن إلى من أساء إليك(@)(@)(@@)(@@)(@@) ||| 186(@)(@)(@@) @HAD010 إستفرغ جهدك لمعادك يصلح مثواك ولا تبع آخرتك بدنياك(@)(@)(@@)(@@)(@@) ||| 187(@)(@)(@@) @HAD024 إستصلح كل نعمة أنعمها الله عليك ولا تضيع نعمة من نعم الله عندك ولير عليك أثر ما أنعم الله سبحانه به عليك(@)(@)(@@)(@@)(@@) ||| 188(@)(@)(@@) @HAD024 إملك حمية نفسك وسورة غضبك وسطوة يدك وغرب لسانك واحترس في ذلك كله بتأخير البادرة وكف السطوة حتى يسكن(@)(@)PageV01P142(@)(@)(@@) @HAD05 غضبك ويثوب إليك عقلك(@)(@)(@@)(@@)(@@) ||| 189(@)(@)(@@) @HAD016 أءمر بالمعروف تكن من أهله وانكر المنكر بيدك ولسانك وباين من فعله بجهدك(@)(@)(@@)(@@)(@@) ||| 190(@)(@)(@@) @HAD022 إجتنب مصاحبة الكذاب فان اضطررت إليه فلا تصدقه ولا تعلمه أنك تكذبه فإنه ينتقل عن ودك ولا ينتقل عن طبعه(@)(@)(@@)(@@)(@@) ||| 191(@)(@)(@@) @HAD024 أحسن رعاية الحرمات وأقبل على أهل المرؤات فإن رعاية الحرمات تدل على كرم الشيمة والأقبال على ذوي المرؤات يعرب عن شرف الهمة(@)(@)(@@)(@@)(@@) ||| 192(@)(@)(@@) @HAD018 إفعل الخير ولا تفعل الشر فخير من الخير من يفعله وشر من الشر من يأتيه بفعله(@)(@)(@@)(@@)(@@) ||| 193(@)(@)(@@) @HAD017 أقم الناس على سنتهم ودينهم وليأمنك بريئهم وليخفك مريبهم وتعاهد ثغورهم وأطرافهم(@)(@)(@@)(@@)(@@) ||| 194(@)(@)(@@) @HAD018 إزهد في الدنيا وأعرف عنها وإياك أن ينزل بك الموت وقلبك متعلق بشىء منها فتهلك(@)(@)(@@)(@@)(@@) ||| 195(@)(@)(@@) @HAD010 إقبل أعذار الناس تستمتع بإخائهم والقهم بالبشر تمت أضغانهم(@)(@)(@@)(@@)(@@) ||| 196(@)(@)(@@) @HAD024 إرحم من دونك يرحمك من فوقك وقس سهوه بسهوك ومعصيته لك بمعصيتك لربك وفقره إلى رحمتك بفقرك إلى رحمة ربك:(@)(@)PageV01P143(@)(@)(@@)(@@)(@@) ||| 197(@)(@)(@@) @HAD021 أشكر من أنعم عليك وأنعم على من شكرك فإنه لا زوال للنعمة إذا شكرت ولا بقاء لها إذا كفرت(@)(@)(@@)(@@)(@@) ||| 198(@)(@)(@@) @HAD015 إملك عليك هواك وشجى نفسك فإن شجى النفس الإنصاف منها فيما أحبت وكرهت(@)(@)(@@)(@@)(@@) ||| 199(@)(@)(@@) @HAD024 إلصق بأهل الخير والورع ورضهم على أن لا يطروك فإن كثرة الأطرآء تدني من الغرة والرضا بذلك يوجب من الله المقت(@)(@)(@@)(@@)(@@) ||| 200(@)(@)(@@) @HAD034 إجعل نفسك ميزانا بينك وبين غيرك وأحب له ما تحب لنفسك وأكره له ما تكره لها وأحسن كما تحب 
ms50	 أن يحسن إليك ولا تظلم كما تحب أن لا تظلم(@)(@)(@@)(@@)(@@) ||| 201(@)(@)(@@) @HAD012 إغتنم الصدق في كل موطن تغنم واجتنب الشر والكذب تسلم(@)(@)(@@)(@@)(@@) ||| 202(@)(@)(@@) @HAD018 أكرم نفسك عن كل دنية وإن ساقتك إلى الرغائب فإنك لن تعتاض عما تبذل من نفسك عوضا(@)(@)(@@)(@@)(@@) ||| 203(@)(@)(@@) @HAD012 إجعل من نفسك على نفسك رقيبا واجعل لآخرتك من دنياك نصيبا(@)(@)(@@)(@@)(@@) ||| 204(@)(@)(@@) @HAD012 إرض بمحمد (صلى الله عليه وآله) رايدا والى النجاة قائدا(@)(@)(@@)(@@)(@@) ||| 205(@)(@)(@@) @HAD07 أكثر ذكر الموت وما تهجم عليه(@)(@)PageV01P144(@)(@)(@@) @HAD021 وتفضى إليه بعد الموت حتى يأتيك وقد أخذت له حذرك وشددت له أزرك ولا يأتيك بغتة فيبهرك(@)(@)(@@)(@@)(@@) ||| 206(@)(@)(@@) @HAD016 إجعل لكل إنسان من خدمك عملا تأخذه به فإن ذلك أحرى أن لا يتواكلوا في خدمتك(@)(@)(@@)(@@)(@@) ||| 207(@)(@)(@@) @HAD015 إجعل الدين كهفك والعدل سيفك تنج من كل سوء وتظفر على كل عدو(@)(@)(@@)(@@)(@@) ||| 208(@)(@)(@@) @HAD032 أقبل على نفسك بالإدبار عنها أعني أن تقبل على نفسك الفاضلة المقتبسة من نور عقلك الحائلة بينك وبين دواعي طبعك وأعني بالإدبار الإدبار عن نفسك الأمارة بالسوء المصاحفة بيد العتو(@)(@)(@@)(@@)(@@) ||| 209(@)(@)(@@) @HAD012 أهجر اللهو فإنك لم تخلق عبثا فتلهو ولم تترك سدا فتلغو(@)(@)(@@)(@@)(@@) ||| 210(@)(@)(@@) @HAD08 إجعل جدك لإعداد الجواب ليوم المسئلة والحساب(@)(@)(@@)(@@)(@@) ||| 211(@)(@)(@@) @HAD023 إحبس لسانك قبل أن يطيل حبسك ويردى نفسك فلا شىء أولى بطول سجن من لسان يعدل عن الصواب ويتسرع إلى الجواب(@)(@)(@@)(@@)(@@) ||| 212(@)(@)(@@) @HAD018 إجعل كل همك وسعيك للخلاص من محل الشقاء والعقاب والنجاة من مقام البلاء والعذاب(@)(@)(@@)(@@)(@@) ||| 213(@)(@)(@@) @HAD010 إحفظ عمرك من التضييع له فى غير العبادة والطاعات(@)(@)PageV01P145(@)(@)(@@)(@@)(@@) ||| 214(@)(@)(@@) @HAD07 إمنع نفسك من الشهوات تسلم من الأفات(@)(@)(@@)(@@)(@@) ||| 215(@)(@)(@@) @HAD07 إمحض أخاك النصيحة حسنة كانت أو قبيحة(@)(@)(@@)(@@)(@@) ||| 216(@)(@)(@@) @HAD08 أكذب السعاية والنميمة باطلة كانت أو صحيحة(@)(@)(@@)(@@)(@@) ||| 217(@)(@)(@@) @HAD019 أطع الله سبحانه فى كل حال ولا تخل قلبك من خوفه ورجائه طرفة عين والزم الإستغفار(@)(@)(@@)(@@)(@@) ||| 218(@)(@)(@@) @HAD013 أعط ما تعطيه معجلا مهنأ وان منعت فليكن فى إجمال وإعذار(@)(@)(@@)(@@)(@@) ||| 219(@)(@)(@@) @HAD012 إجعل لنفسك فيما بينك وبين الله سبحانه أفضل المواقيت والأقسام(@)(@)(@@)(@@)(@@) ||| 220(@)(@)(@@) @HAD018 إحذر الحيف والجور فإن الحيف يدعو إلى السيف والجور يعود بالجلاء ويعجل العقوبة والإنتقام(@)(@)(@@)(@@)(@@) ||| 221(@)(@)(@@) @HAD013 ألزم الصمت يلزمك النجاة والسلامة 
ms51	 والزم الرضا يلزمك الغنى والكرامة(@)(@)(@@)(@@)(@@) ||| 222(@)(@)(@@) @HAD021 أخرج من مالك الحقوق وأشرك فيه الصديق وليكن كلامك فى تقدير وهمتك فى تفكير تأمن الملامة والندامة(@)(@)(@@)(@@)(@@) ||| 223(@)(@)(@@) @HAD032 أذكر مع كل لذة زوالها ومع كل نعمة إنتقالها ومع كل بلية كشفها فإن ذلك أبقى للنعمة وأنفى للشهوة وأذهب للبطر وأقرب إلى الفرج وأجدر بكشف(@)(@)PageV01P146(@)(@)(@@) @HAD04 الغمة ودرك المأمول(@)(@)(@@)(@@)(@@) ||| 224(@)(@)(@@) @HAD026 إحمل نفسك عند شدة أخيك على اللين وعند قطيعته على الوصل وعند جموده على البذل وكن للذى يبدو منه حمولا وله وصولا(@)(@)(@@)(@@)(@@) ||| 225(@)(@)(@@) @HAD017 أكرم عشيرتك فإنهم جناحك الذى به تطير واصلك الذى إليه تصير ويدك التى بها تصول(@)(@)(@@)(@@)(@@) ||| 226(@)(@)(@@) @HAD047 إحمل نفسك مع أخيك عند صرمه على الصلة وعند صدوده على اللطف والمقاربة وعند تباعده على الدنو وعند جرمه على العذر حتى كانك له عبد وكأنه ذو نعمة عليك وإياك أن تضع ذلك فى غير موضعه أو تفعله مع غير أهله(@)(@)(@@)(@@)(@@) ||| 227(@)(@)(@@) @HAD022 إجعل همك لآخرتك وحزنك على نفسك فكم من حزين وفد به حزنه على سرور الأبد وكم من مهموم أدرك أمله(@)(@)(@@)(@@)(@@) ||| 228(@)(@)(@@) @HAD010 أحسن إلى من تملك رقه يحسن إليك من يملك رقك(@)(@)(@@)(@@)(@@) ||| 229(@)(@)(@@) @HAD09 أصحب الناس بما تحب أن يصحبوك تأمنهم ويأمنوك(@)(@)(@@)(@@)(@@) ||| 230(@)(@)(@@) @HAD015 أنصف من نفسك قبل ان ينتصف منك فإن ذلك أجل لقدرك وأجدر برضا ربك(@)(@)(@@)(@@)(@@) ||| 231(@)(@)(@@) @HAD07 إبدء السائل بالنوال قبل السؤال فإنك إن(@)(@)PageV01P147(@)(@)(@@) @HAD010 أحوجته إلى سؤالك أخذت من حر وجهه أفضل مما أعطيته(@)(@)(@@)(@@)(@@) ||| 232(@)(@)(@@) @HAD021 أكرم ذوي رحمك ووقر حليمهم واحلم عن سفيههم وتيسر لمعسرهم فإنهم لك نعم العدة في الشدة والرخاء(@)(@)(@@)(@@)(@@) ||| 233(@)(@)(@@) @HAD018 إلق دواتك وأطل جلفة قلمك وفرق سطورك وقرمط بين حروفك فإن ذلك أجدر بصباحة الخط(@)(@)(@@)(@@)(@@) ||| 234(@)(@)(@@) @HAD024 إلزم الإخلاص في السر والعلانية والخشية في الغيب والشهادة والقصد في الفقر والغنى والعدل فى الرضا والسخط(@)(@)(@@)(@@)(@@) ||| 235(@)(@)(@@) @HAD09 إختر من كل شيء جديده ومن الإخوان أقدمهم(@)(@)(@@)(@@)(@@) ||| 236(@)(@)(@@) @HAD010 إستشر أعدائك تعرف من رأيهم مقدار عداوتهم ومواضع مقاصدهم(@)(@)(@@)(@@)(@@) ||| 237(@)(@)(@@) @HAD022 أبذل لصديقك كل المودة ولا تبذل له كل الطمأنينة وأعطه من نفسك كل المواساة ولا تقص إليه بكل أسرارك(@)(@)(@@)(@@)(@@) ||| 238 
ms52	(@)(@)(@@) @HAD015 إصحب السلطان بالحذر والصديق بالتواضع والبشر والعدو بما تقوم به عليه حجتك(@)(@)(@@)(@@)(@@) ||| 239(@)(@)(@@) @HAD011 إفسح برية قلمك وأسمك شحمته وأيمن قطك يجد خطك(@)(@)(@@)(@@)(@@) ||| 240(@)(@)(@@) @HAD06 أبذل لصديقك نصحك ولمعارفك معونتك(@)(@)PageV01P148(@)(@)(@@) @HAD04 ولكافة الناس بشرك(@)(@)(@@)(@@)(@@) ||| 241(@)(@)(@@) @HAD016 إحتمل دالة من دل عليك وأقبل العذر ممن إعتذر إليك وأغتفر لمن جنى عليك(@)(@)(@@)(@@)(@@) ||| 242(@)(@)(@@) @HAD09 إجعل جزاء النعمة عليك الإحسان إلى من أساء إليك(@)(@)(@@)(@@)(@@) ||| 243(@)(@)(@@) @HAD012 أبذل مالك لمن بذل لك وجهه فإن بذل الوجه لا يوازيه شيء(@)(@)(@@)(@@)(@@) ||| 244(@)(@)(@@) @HAD014 أبذل معروفك للناس كافة فإن فضيلة فعل المعروف لا يعدلها عند الله سبحانه شيىء(@)(@)(@@)(@@)(@@) ||| 245(@)(@)(@@) @HAD08 إستشر عدوك العاقل واحذر رأى صديقك الجاهل(@)(@)(@@)(@@)(@@) ||| 246(@)(@)(@@) @HAD011 إصبر على مضض مرارة الحق وإياك أن تنخدع لحلاوة الباطل(@)(@)(@@)(@@)(@@) ||| 247(@)(@)(@@) @HAD07 إجعل شكواك إلى من يقدر على غناك(@)(@)(@@)(@@)(@@) ||| 248(@)(@)(@@) @HAD015 إلزم السكوت واصبر على القناعة بأيسر القوت تعز فى دنياك وتعز في أخراك(@)(@)(@@)(@@)(@@) ||| 249(@)(@)(@@) @HAD012 أطع من فوقك يطعك من دونك وأصلح سريرتك يصلح الله علانيتك(@)(@)(@@)(@@)(@@) ||| 250(@)(@)(@@) @HAD09 إستكثر من المحامد فإن المذام قل من ينجو منها(@)(@)(@@)(@@)(@@) ||| 251(@)(@)(@@) @HAD09 أكره نفسك على الفضائل فإن الرذائل أنت مطبوع عليها(@)(@)PageV01P149(@)(@)(@@)(@@)(@@) ||| (الفصل الثالث) مما ورد من حكم أمير المؤمنين على بن أبيطالب(عليه السلام) في حرف الألف بلفظ الأمر في خطاب الجمع قال (عليه السلام):(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD03 أطلبوا العلم ترشدوا(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD03 إعملوا بالعلم تسعدوا(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD03 أخلصوا إذا عملتم(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD03 إعملوا إذا علمتم(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD06 إتقوا الله جهة ما خلقكم له(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD03 إسمحوا إذا سئلتم(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD07 أطيعوا الله حسب ما أمركم به رسله(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD04 إلزموا الحق تلزمكم النجاة(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD04 إكتسبوا العلم يكسبكم الحياة(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD03 إستنزلوا الرزق بالصدقة(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD05 إلزموا الجماعة واجتنبوا الفرقة(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD02 إملكوا أنفسكم(@)(@)PageV01P150(@)(@)(@@) @HAD02 بدوام جهادها(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD04 إعتصموا بالذمم فى أوتادها(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD04 إستعدوا للموت فقد أظلكم(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD08 أسمعوا دعوة الموت آذانكم قبل أن يدعى بكم(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD011 إستمعوا من ربانيكم وأحضروه قلوبكم واسمعوا إن هتف بكم(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD09 إسمعوا النصيحة ممن أهداها إليكم واعقلوها على أنفسكم(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD010 إتعظوا بمن كان قبلكم قبل أن يتعظ بكم من بعدكم(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD011 إرفضوا هذه الدنيا الذميمة فقد رفضت من كان أشغف بها منكم 
ms53	(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD013 أسهروا عيونكم وضمروا بطونكم وخذوا من أجسادكم تجودوا بها على أنفسكم(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD013 إشغلوا أنفسكم بالطاعة وألسنتكم بالذكر وقلوبكم بالرضا فيما أحببتم وكرهتم(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD013 إلزموا الأرض واصبروا على البلاء ولا تحركوا بأيديكم وهوى ألسنتكم(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD014 أخرجوا الدنيا من قلوبكم قبل أن تخرج منها أجسادكم ففيها أختبرتم ولغيرها خلقتم(@)(@)PageV01P151(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD07 إنتهزوا فرص الخير فإنها تمر مر السحاب(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD014 اكذبوا آمالكم واغتنموا آجالكم بأحسن أعمالكم وبادروا مبادرة أولي النهى والألباب(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD011 إستحيوا من الفرار فإنه عار في الأعقاب ونار يوم الحساب(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD08 أذكروا عند المعاصي ذهاب اللذات وبقاء التبعات(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD011 أهجروا الشهوات فإنها تقودكم إلى إرتكاب الذنوب والتهجم على السيئات(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD010 إتقوا الله الذى إن قلتم سمع وإن أضمرتم علم(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD014 إحترسوا من سورة الغضب وأعدوا له ما تجاهدونه به من الكظم والحلم(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD010 إتقوا ظنون المؤمنين فإن الله سبحانه أجرى الحق على ألسنتهم(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD012 إستجيبوا لأنبياء الله وسلموا لأمرهم واعملوا بطاعتهم تدخلوا في شفاعتهم(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD017 إتقوا دعوة المظلوم فإنه يسئل الله حقه والله سبحانه أكرم من أن يسئل حقا إلا أجاب(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD02 إجعلوا كل(@)(@)PageV01P152(@)(@)(@@) @HAD017 رجآئكم لله سبحانه ولا ترجوا أحدا سواه فإنه ما رجا أحد غير الله تعالى إلا خاب(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD07 أفيضوا في ذكر الله فإنه أحسن الذكر(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD07 إقمعوا نواجم الفخر واقلعوا لوامع الكبر(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD09 إرغبوا فيما وعد الله المتقين فإن أصدق الوعد ميعاده(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD014 إستحقوا من الله ما أعدكم لكم بالتنجز لصدق ميعاده والحذر من هول معاده(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD08 إتعظوا بالعبر واعتبروا بالغير وانتفعوا بالنذر(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD08 إمتاحوا من صفو عين قدر وقت من الكدر(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD08 إسعوا في فكاك رقابكم قبل أن تغلق رهائنها(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD010 أحسنوا جوار نعم الدين والدنيا بالشكر لمن دلكم عليها(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD014 إستتموا نعم الله عليكم بالصبر على طاعته والمحافظة على ما إستحفظكم من كتابه(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @QUR@04 إتقوا الله حق تقاته @HAD@ واسعوا في مرضاته واحذروا ما حذركم من أليم عذابه(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD09 إتقوا شرار النساء وكونوا من خيارهن على حذر(@)(@)PageV01P153(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD011 إتقوا البغى فإنه يجلب النقم ويسلب النعم ويوجب الغير 
ms54	(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD07 إتقوا معاصي الخلوات فإن الشاهد هو الحاكم(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD09 أبعدوا عن الظلم فإنه أعظم الجرآئم وأكبر المآثم(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD07 أحيوا المعروف بإماتته فإن المنة تهدم الصنيعة(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD010 إغلبوا الجزع بالصبر فإن الجزع يحبط الأجر ويعظم الفجيعة(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD07 إلتووا فى أطراف الرماح فإنه أمور للأسنة(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD09 أقبلوا على من أقبلت عليه الدنيا فإنه أجدر بالغنى(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD08 إتقوا الحرص فإن صاحبه رهين ذل وعناء(@)(@)(@@)(@@)(@@) ||| 54(@)(@)(@@) @HAD010 أطلبوا العلم تعرفوا به واعملوا به تكونوا من أهله(@)(@)(@@)(@@)(@@) ||| 55(@)(@)(@@) @HAD08 إفعلوا الخير ما استطعتم فخير من الخير فاعله(@)(@)(@@)(@@)(@@) ||| 56(@)(@)(@@) @HAD07 إجتنبوا الشر فإن شرا من الشر فاعله(@)(@)(@@)(@@)(@@) ||| 57(@)(@)(@@) @HAD019 إعملوا في غير رياء ولا سمعة فإنه من يعمل لغير الله يكله الله سبحانه إلى من عمل له(@)(@)(@@)(@@)(@@) ||| 58(@)(@)(@@) @HAD05 إغتنموا الشكر فأدنى نفعه الزيادة(@)(@)PageV01P154(@)(@)(@@)(@@)(@@) ||| 59(@)(@)(@@) @HAD09 إستديموا الذكر فإنه ينير القلب وهو أفضل العبادة(@)(@)(@@)(@@)(@@) ||| 60(@)(@)(@@) @HAD08 أطلبوا الخير في أخفاف الأبل طاردة وواردة(@)(@)(@@)(@@)(@@) ||| 61(@)(@)(@@) @HAD011 أجملوا في الطلب فكم من حريص خائب ومجمل لم يخب(@)(@)(@@)(@@)(@@) ||| 62(@)(@)(@@) @HAD012 إحترسوا من سورة الإطراء والمدح فإن لها ريح خبيثة في القلب(@)(@)(@@)(@@)(@@) ||| 63(@)(@)(@@) @HAD010 إعملوا والعمل ينفع والدعاء يسمع والتوبة ترفع(@)(@)(@@)(@@)(@@) ||| 64(@)(@)(@@) @HAD010 أصدقوا في أقوالكم وأخلصوا في أعمالكم وتزكوا بالورع(@)(@)(@@)(@@)(@@) ||| 65(@)(@)(@@) @HAD08 إلزموا الصبر فإنه دعامة الإيمان وملاك الأمور(@)(@)(@@)(@@)(@@) ||| 66(@)(@)(@@) @HAD033 أحسنوا تلاوة القرآن فإنه أحسن القصص واستشفوا به فإنه شفاء الصدور واتبعوا النور الذي لا يطفى والوجه الذي لا يبلى واستسلموا وسلموا لأمره فإنكم لن تضلوا مع التسليم(@)(@)(@@)(@@)(@@) ||| 67(@)(@)(@@) @HAD017 إستصبحوا من شعلة واعظ متعظ واقبلوا نصيحة ناصح متيقظ وقفوا عند ما أفادكم من التعليم(@)(@)(@@)(@@)(@@) ||| 68(@)(@)(@@) @HAD012 إقتدوا بهدى نبيكم فإنه أصدق الهدى واستنوا بسنته فإنها أهدى السنن(@)(@)(@@)(@@)(@@) ||| 69(@)(@)(@@) @HAD09 إتقوا الله تقية من سمع فخشع واقترف فاعترف(@)(@)PageV01P155(@)(@)(@@) @HAD09 وعلم فوجل وحاذر فبادر وعمل فأحسن(@)(@)(@@)(@@)(@@) ||| 70(@)(@)(@@) @HAD018 إتقوا الله تقية من دعي فأجاب وتاب فأناب وحذر فحذر وعبر فاعتبر وخاف فأمن(@)(@)(@@)(@@)(@@) ||| 71(@)(@)(@@) @HAD013 إقنعوا بالقليل من دنياكم لسلامة دينكم فإن المؤمن البلغة اليسيرة من الدنيا تقنعه(@)(@)(@@)(@@)(@@) ||| 72(@)(@)(@@) @HAD013 أقيلوا ذوي المرؤات عثراتهم فما يعثر منهم عاثر إلا ويد الله ترفعه(@)(@)(@@)(@@)(@@) ||| 73(@)(@)(@@) @HAD021 أهربوا من الدنيا واصرفوا قلوبكم عنها فإنها 
ms55	 سجن المؤمن حظه منها قليل وعقله بها عليل وناظره فيها كليل(@)(@)(@@)(@@)(@@) ||| 74(@)(@)(@@) @HAD016 إعقلوا الخبر إذا سمعتموه عقل دراية لا عقل رواية فإن رواة العلم كثير ورعاته قليل(@)(@)(@@)(@@)(@@) ||| 75(@)(@)(@@) @HAD015 إلجأوا إلى التقوى فإنه جنة منيعة من لجأ إليها حصنته ومن اعتصم بها عصمته(@)(@)(@@)(@@)(@@) ||| 76(@)(@)(@@) @HAD012 إعتصموا بتقوى الله فإن لها حبلا وثيقا عروته ومعقلا منيعا ذروته(@)(@)(@@)(@@)(@@) ||| 77(@)(@)(@@) @HAD010 إستعيذوا بالله من سكرة الغنى فإن له سكرة بعيدة الإفاقة(@)(@)(@@)(@@)(@@) ||| 78(@)(@)(@@) @HAD016 إستعيذوا بالله من لواقح الكبر كما تستعيذون به من طوارق الدهر واستعدوا لمجاهدته حسب الطاقة(@)(@)(@@)(@@)(@@) ||| 79(@)(@)(@@) @HAD02 إئتمروا بالمعروف(@)(@)PageV01P156(@)(@)(@@) @HAD010 وأمروا به وتناهوا عن المنكر وانهوا عنه(@)(@)(@@)(@@)(@@) ||| 80(@)(@)(@@) @HAD017 أعرضوا عن كل عمل بكم غنى عنه واشغلوا أنفسكم من أمر الآخرة بما لابد لكم منه(@)(@)(@@)(@@)(@@) ||| 81(@)(@)(@@) @HAD012 إقمعوا هذه النفوس فإنها طلعة إن تطيعوها تزغ بكم إلى شر غاية(@)(@)(@@)(@@)(@@) ||| 82(@)(@)(@@) @HAD012 إغلبوا أهوائكم وحاربوها فإنها إن تقيدكم توردكم من الهلكة أبعد غاية(@)(@)(@@)(@@)(@@) ||| 83(@)(@)(@@) @HAD020 أنظروا إلى الدنيا نظر الزاهدين فيها الصارفين عنها فإنها والله عما قليل تزيل الثاوي الساكن وتفجع المترف الآمن(@)(@)(@@)(@@)(@@) ||| 84(@)(@)(@@) @HAD017 إتقوا غرور الدنيا فإنها تسترجع أبدا ما خدعت به من المحاسن وتزعج المطمئن إليها والقاطن(@)(@)(@@)(@@)(@@) ||| 85(@)(@)(@@) @HAD034 إتقوا خداع الآمال فكم من مؤمل يوم لم يدركه وباني بناء لم يسكنه وجامع مال لم يأكله ولعله من باطل جمعه ومن حق منعه أصابه حراما واحتمل به آثاما(@)(@)(@@)(@@)(@@) ||| 86(@)(@)(@@) @HAD013 أعرفوا الحق لمن عرفه لكم صغيرا كان أو كبيرا وضيعا كان أو رفيعا(@)(@)(@@)(@@)(@@) ||| 87(@)(@)(@@) @HAD022 إحترسوا من سورة الجهل والحقد والغضب والحسد وأعدوا لكل شيء من ذلك عدة تجاهدونه بها من الفكر في(@)(@)PageV01P157(@)(@)(@@) @HAD013 العاقبة ومنع الرذيلة وطلب الفضيلة وصلاح الآخرة ولزوم الحلم(@)(@)(@@)(@@)(@@) ||| 88(@)(@)(@@) @HAD015 أعجبوا لهذا الإنسان ينظر بشحم ويتكلم بلحم ويسمع بعظم ويتنفس من خرم(@)(@)(@@)(@@)(@@) ||| 89(@)(@)(@@) @HAD07 إضربوا بعض الرأي ببعض يتولد منه الصواب(@)(@)(@@)(@@)(@@) ||| 90(@)(@)(@@) @HAD06 أجملوا في الخطاب تسمعوا جميل الجواب(@)(@)(@@)(@@)(@@) ||| 91(@)(@)(@@) @HAD07 إمخضوا الرأي مخض السقاء ينتج سديد الآراء(@)(@)(@@)(@@)(@@) ||| 92(@)(@)(@@) @HAD09 إتهموا عقولكم فإنه من الثقة بها يكون في الخطاء(@)(@)(@@)(@@)(@@) ||| 93(@)(@)(@@) @HAD032 إعلموا وأنتم في آونة البقاء والصحف منشورة والتوبة مبسوطة والمدبر يدعى والمسييء يرجى 
ms56	 قبل أن يخمد العمل وينقطع المهل وتنقضي المدة ويسد باب التوبة(@)(@)(@@)(@@)(@@) ||| 94(@)(@)(@@) @HAD017 إتقوا باطل الأمل فرب مستقبل يوم ليس بمستدبره ومغبوط في أول ليلة قامت بواكيه في آخره(@)(@)(@@)(@@)(@@) ||| 95(@)(@)(@@) @HAD012 إستعدوا اليوم تشخص فيه الأبصار وتتدله لهوله العقول وتتبلد البصائر(@)(@)(@@)(@@)(@@) ||| 96(@)(@)(@@) @HAD09 إعملوا اليوم تذخر له الذخائر وتبلى فيه السرائر(@)(@)(@@)(@@)(@@) ||| 97(@)(@)(@@) @HAD02 أذكروا هادم(@)(@)PageV01P158(@)(@)(@@) @HAD07 اللذات ومنغص الشهوات وداعي الشتات(@)(@)(@@)(@@)(@@) ||| 98(@)(@)(@@) @HAD014 أذكروا مفرق الجماعات ومباعد الأمنيات ومدني المنيات والمؤذن بالبين والشتات(@)(@)(@@)(@@)(@@) ||| 99(@)(@)(@@) @HAD016 أرفضوا هذه الدنيا التاركة لكم وإن لم تحبوا تركها والمبلية أجسادكم على محبتكم لتجديدها(@)(@)PageV01P159(@)(@)(@@)(@@)(@@) ||| (الفصل الرابع) مما ورد من حكم أمير المؤمنين علي بن ابيطالب(عليه السلام) في حرف الألف بلفظ إحذروا وإحذر وهو داخل فى ألف الأمر قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD05 إحذروا اللسان فإنه سهم يخطي(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD05 إحذروا الشره فإنه خلق مردي(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD05 إحذروا التفريط فإنه يوجب الملامة(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD05 إحذروا العجلة فإنها تثمر الندامة(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD06 إحذروا الجبن فإنه عار ومنقصة(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD06 إحذروا البخل فإنه لؤم ومسبة(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD06 إحذروا الغفلة فإنها من فساد الحس(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD06 إحذروا من الحسد فإنه يزري بالنفس(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD06 إحذروا الأمل المغلوب والنعيم المسلوب(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD06 إحذروا الزائل الشهي والفاني المحبوب(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD05 إحذروا الغضب فإنه نار محرقة(@)(@)PageV01P160(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD05 إحذروا الأماني فإنها منايا محققة(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD011 إحذر كل عمل إذا سئل عنه صاحبه إستحيى منه وأنكره(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD09 إحذر كل أمر إذا ظهر أزرى بفاعله وحقره(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD014 إحذر الشرير عند إقبال الدولة لئلا يزيلها عنك وعند إدبارها لئلا يعين عليك(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD015 إحذروا الأحمق فإن مداراته تعييك وموافقته ترديك ومخالفته تؤذيك ومصاحبته وبال عليك(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD012 إحذر من كل عمل يعمل في السر ويستحيى منه في العلانية(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD08 إحذر كل أمر يفسد الاجلة ويصلح العاجلة(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD010 إحذر كل عمل يرضاه عامله لنفسه ويكرهه لعامة المسلمين(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD011 إحذر كل قول وفعل يؤدي إلى فساد الاخرة والدين(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD010 إحذر مجالسة قرين السوء فإنه يهلك مقارنه ويردي مصاحبه(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD013 إحذر مصاحبة كل من يقبل رأيه وينكر عمله فإن الصاحب معتبر بصاحبه(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD09 إحذر مصاحبة الفساق والفجار والمجاهرين بمعاصي الله 
ms57	(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD03 إحذر الشره فكم(@)(@)PageV01P161(@)(@)(@@) @HAD04 من أكلة منعت أكلات(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD011 إحذر الهزل واللعب وكثرة المزح والضحك والترهات(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD011 إحذر منازل الغفلة والجفاء وقلة الأعوان على طاعة الله(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD012 إحذر اللئيم إذا اكرمته والرذل إذا قدمته والسفلة إذا رفعته(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD012 إحذر الكريم إذا أهنته والحليم إذا جرحته والشجاع إذا أوجعته(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD08 إحذر مجالسة الجاهل كما تأمن من مصاحبة العاقل(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD08 إحذر فحش القول والكذب فإنهما يزريان بالقائل(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD08 إحذر الدنيا فإنها شبكة الشيطان ومفسدة الإيمان(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD08 إحذر الكبر فإنه رأس الطغيان ومعصية الرحمن(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD014 ألحذر الحذر أيها المستمع والجد الجد أيها الغافل ولا ينبئك مثل خبير(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD012 الحذر الحذر أيها المغرور والله لقد ستر حتى كأنه قد غفر(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD011 إحذر أن يخدعك الغرور بالحائل اليسير أو يستزلك السرور بالزائل الحقير(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD07 إحذر الموت وأحسن له الإستعداد تسعد(@)(@)PageV01P162(@)(@)(@@) @HAD01 بمنقلبك(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD08 إحذر قلة الزاد وأكثر من الإستعداد لرحلتك(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD010 إحذروا صولة الكريم إذا جاع واشر اللئيم إذا شبع(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD010 إحذروا سطوة الكريم إذا وضع وسورة اللئيم إذا رفع(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD07 إحذروا نفار النعم فما كل شارد بمردود(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD010 إحذروا ضياع الأعمار فيما لا يبقى لكم ففائتها لا يعود(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD010 إحذروا نارا حرها شديد وقعرها بعيد وحليها حديد(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD06 إحذروا الذنوب المورطة والعيوب المسخطة(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @HAD011 إحذروا نارا لجبها عتيد ولهبها شديد وعذابها أبدا جديد(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD014 إحذروا من الله كنه ما حذركم من نفسه واخشوه خشية تحجزكم عما يسخطه(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD011 إحذروا عدوا نفذ في الصدور خفيا ونفث في الأذان نجيا(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD010 إحذروا هوى بالأنفس هويا وأبعدها عن قرارة الفوز قصيا(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD017 إحذروا عدو الله إبليس أن يعديكم بدائه أو يستفزكم بخيله ورجله فقد فوق لكم سهم الوعيد(@)(@)PageV01P163(@)(@)(@@) @HAD06 ورمى لكم من مكان قريب(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD011 إحذروا الشح فإنه يكسب المقت ويشين المحاسن ويشيع العيوب(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD013 إحذروا أهل النفاق فإنهم الضآلون المضلون الزالون المزلون قلوبهم دوية وصحافهم نقية(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD09 إحذروا منافخ الكبر وغلبة الحمية وتعصب الجاهلية(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD013 إحذروا يوما تفحص فيه الأعمال وتكثر فيه الزلزال وتشيب فيه الأطفال(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD012 إحذروا 
ms58	 سوء الأعمال وغرور الامال ونفاد الأمل وهجوم الأجل(@)(@)PageV01P164(@)(@)(@@)(@@)(@@) ||| ألفصل الخامس مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام) في حرف الألف بلفظ إياك وهو داخل فى باب الأمر والتحذير. قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD010 إياك وفعل القبيح فإنه يقبح ذكرك ويكثر وزرك(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD012 إياك والغيبة فإنها تمقتك إلى الله والناس وتحبط أجرك(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD09 إياك والشك فإنه يفسد الدين ويبطل اليقين(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD08 إياك والغضب فأوله جنون وآخره ندم(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD08 إياك والعجل فإنه عنوان الفوت والندم(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD08 إياك والهذر فمن كثر كلامه كثرت آثامه(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD07 إياك والظلم فمن ظلم كرهت أيامه(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD010 إياك والبطنة فمن لزمها كثرت أسقامه وفسدت أحلامه(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD03 إياك ومصاحبة(@)(@)PageV01P165(@)(@)(@@) @HAD05 الفساق فإن الشر بالشر يلحق(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD08 إياك ومعاشرة الأشرار فإنهم كالنار مباشرتها تحرق(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD08 إياك أن ترضى عن نفسك فيكثر الساخط عليك(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD010 إياك والظلم فإنه يزول عمن تظلمه ويبقى عليك(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD09 إياك أن تخدع عن صديقك أو تغلب عن عدوك(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD09 إياك ومصادقة الأحمق فإنه يريد أن ينفعك فيضرك(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD011 إياك ومصادقة البخيل فإنه يقعد عنك أحوج ما تكون إليه(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD010 إياك أن تعتمد على اللئيم فإنه يخذل من اعتمد عليه(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD09 إياك ومصاحبة الأشرار فإنهم يمنون عليك بالسلامة منهم(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD011 إياك ومعاشرة متتبعي عيوب الناس فانه لم يسلم مصاحبهم منهم(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD012 إياك ومصادقة الكذاب فإنه يقرب عليك البعيد ويبعد عليك القريب(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD013 إياك والتحلى بالبخل فإنه يزرى بك عند القريب ويمقتك إلى النسيب(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD012 إياك والكبر فإنه أعظم الذنوب ألأم العيوب وهو حلية إبليس(@)(@)PageV01P166(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD012 إياك والحسد فإنه شر شيمة وأقبح سجية وخليقة إبليس(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD06 إياك والخرق فإنه شين الأخلاق(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD06 إياك والسفه فإنه يوحش الرفاق(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD013 إياك والتسرع إلى العقوبة فإنه ممقتة عند الله ومقرب من الغير(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD011 إياك والبغي فإنه يعجل الصرعة ويحل بالعامل به العبر(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD013 إياك والشح فإنه جلباب المسكنة وزمام يقاد به الى كل دنائة(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD012 إياك وانتهاك المحارم فإنها شيمة الفساق واولى الفجور والغواية(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD06 إياك والعجل فإنه مقرون 
ms59	 بالعثار(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD09 إياك والشره فإنه يفسد الورع ويدخل النار(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD012 إياك والجفاء فإنه يفسد الإخاء ويمقت إلى الله والناس(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD012 إياك والنميمة فإنها تزرع الضغينة وتبعد عن الله والناس(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD012 إياك والغدر فإنه أقبح الخيانة ان الغدر لمهان عند الله بغدره(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD013 إياك والظلم فإنه أكبر المعاصي وان الظالم لمعاقب يوم القيامة بظلمه(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD012 إياك والإسائة فإنها خلق اللئام وإن المسيىء لمترد فى جهنم(@)(@)PageV01P167(@)(@)(@@) @HAD01 بإسائته(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD013 إياك والخيانة فإنها شر معصية وإن الخائن لمعذب بالنار على خيانته(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD011 إياك والشره فإنه رأس كل دنية وأس كل رذيلة(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD012 إياك وحب الدنيا فإنها أصل كل خطيئة ومعدن كل بلية(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD09 إياك والجور فإن الجائر لا يريح رائحة الجنة(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD09 إياك وطاعة الهوى فإنه يقود إلى كل محنة(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD012 إياك والإعجاب وحب الإطراء فإن ذلك من أوثق فرص الشيطان(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD08 إياك والمن بالمعروف فإن الأمتنان يكدر الأحسان(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @HAD07 إياك ومذموم اللجاج فإنه يثير الحروب(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD07 إياك ومستهجن الكلام فإنه يوغر القلوب(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD010 إياك والثقة بنفسك فإن ذلك من اكبر مصائد الشيطان(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD09 إياك أن تعجب بنفسك فيظهر عليك النقص والشنئان(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD010 إياك والإصرار فإنه من اكبر البكائر وأعظم الجرائم(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD08 إياك والمجاهرة بالفجور فإنه من أشد المأثم(@)(@)PageV01P168(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD010 إياك وكثرة الكلام فإنه يكثر الزلل ويورث الملل(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD09 إياك وإدمان الشبع فإنه يهيج الأسقام والعلل(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD011 إياك أن تذكر من الكلام مضحكا وإن حكيته عن غيرك(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD019 إياك أن تستكبر من معصية غيرك ما تستصغره من نفسك أو تستكثر من طاعتك ما تستقله من غيرك:(@)(@)(@@)(@@)(@@) ||| 54(@)(@)(@@) @HAD08 إياك والإتكال على المنى فإنها بضائع النوكى(@)(@)(@@)(@@)(@@) ||| 55(@)(@)(@@) @HAD08 إياك والثقة بالأمال فإنها من شيم الحمقى(@)(@)(@@)(@@)(@@) ||| 56(@)(@)(@@) @HAD020 إياك أن تغفل عن حق أخيك إتكالا على واجب حقك عليه فإن لأخيك عليك من الحق مثل الذى لك عليه(@)(@)(@@)(@@)(@@) ||| 57(@)(@)(@@) @HAD017 إياك أن تخرج صديقك إخراجا يخرجه عن مودتك وأستبق له من أنسك موضعا يثق بالرجوع إليه(@)(@)(@@)(@@)(@@) ||| 58(@)(@)(@@) @HAD017 إياك أن تهمل حق أخيك إتكالا على ما بينك وبينه فليس لك بأخ 
ms60	 من أضعت حقه(@)(@)(@@)(@@)(@@) ||| 59(@)(@)(@@) @HAD015 إياك أن توحش موادك وحشة تفضح به إلى إختياره البعد عنك وإيثار الفرقة منك(@)(@)(@@)(@@)(@@) ||| 60(@)(@)(@@) @HAD016 إياك والتغاير فى غير موضعه فإن ذلك يدعو الصحيحة إلى السقم والبريئة إلى الريب(@)(@)PageV01P169(@)(@)(@@)(@@)(@@) ||| 61(@)(@)(@@) @HAD010 إياك أن تتخير لنفسك فإن اكثر النجح فيما لا يحتسب(@)(@)(@@)(@@)(@@) ||| 62(@)(@)(@@) @HAD011 إياك وصحبة من ألهاك وأغراك فإنه يخذلك ويوبقك(@)(@)(@@)(@@)(@@) ||| 63(@)(@)(@@) @HAD011 إياك أن يفقدك ربك عند طاعته أو يراك عند معصيته فيمقتك(@)(@)(@@)(@@)(@@) ||| 64(@)(@)(@@) @HAD011 إياك والنفاق فإن ذا الوجهين لا يكون وجيها عند الله(@)(@)(@@)(@@)(@@) ||| 65(@)(@)(@@) @HAD011 إياك والتجبر على عباد الله فإن كل متجبر يقصمه الله(@)(@)(@@)(@@)(@@) ||| 66(@)(@)(@@) @HAD09 إياك والملق فإن الملق ليس من خلائق الإيمان(@)(@)(@@)(@@)(@@) ||| 67(@)(@)(@@) @HAD08 إياك والفرقة فإن الشاذ من الناس للشيطان(@)(@)(@@)(@@)(@@) ||| 68(@)(@)(@@) @HAD09 إياك ومحاضر الفسوق فإنها مسخطة للرحمن مصلية للنيران(@)(@)(@@)(@@)(@@) ||| 69(@)(@)(@@) @HAD010 إياك ومقاعد الأسواق فإنها معارض الفتن ومحاضر الشيطان(@)(@)(@@)(@@)(@@) ||| 70(@)(@)(@@) @HAD014 إياك أن تبيع حظك من ربك وزلفتك لديه بحقير من حطام الدنيا:(@)(@)(@@)(@@)(@@) ||| 71(@)(@)(@@) @HAD011 إياك ومصاحبة أهل الفسوق فإن الراضي بفعل قوم كالداخل معهم(@)(@)(@@)(@@)(@@) ||| 72(@)(@)(@@) @HAD017 إياك أن تحب أعداء الله أو تصفي ودك لغير أولياء الله فإن من أحب قوما حشر معهم(@)(@)(@@)(@@)(@@) ||| 73(@)(@)(@@) @HAD04 إياك والخديعة فإن(@)(@)PageV01P170(@)(@)(@@) @HAD04 الخديعة من خلق اللئيم(@)(@)(@@)(@@)(@@) ||| 74(@)(@)(@@) @HAD07 إياك والمكر فإن المكر لخلق ذميم(@)(@)(@@)(@@)(@@) ||| 75(@)(@)(@@) @HAD014 إياك والمعصية فإن اللئيم من باع جنة المأوى بمعصية دنية من معاصي الدنيا(@)(@)(@@)(@@)(@@) ||| 76(@)(@)(@@) @HAD014 إياك والوله بالدنيا فإنها تورثك الشقاء والبلاء وتحدوك على البقاء بالفناء(@)(@)(@@)(@@)(@@) ||| 77(@)(@)(@@) @HAD018 إياك أن تغلبك نفسك على ما تظن ولا تغلبها على ما تستيقن فإن ذلك من أعظم الشر(@)(@)(@@)(@@)(@@) ||| 78(@)(@)(@@) @HAD012 إياك أن تسييء الظن فإن سوء الظن يفسد العبادة ويعظم الوزر(@)(@)(@@)(@@)(@@) ||| 79(@)(@)(@@) @HAD010 إياك أن تسلف المعصية وتسوف بالتوبة فتعظم لك العقوبة(@)(@)(@@)(@@)(@@) ||| 80(@)(@)(@@) @HAD015 إياك أن تكون على الناس طاعنا ولنفسك مداهنا فتعظم عليك الحوبة وتحرم المثوبة(@)(@)(@@)(@@)(@@) ||| 81(@)(@)(@@) @HAD013 إياك والإمساك فإن ما أمسكته فوق قوت يومك كنت فيه خازنا لغيرك(@)(@)(@@)(@@)(@@) ||| 82(@)(@)(@@) @HAD017 إياك وملابسة الشر فإنك تنيله نفسك قبل عدوك وتهلك به دينك قبل ايصاله إلى غيرك(@)(@)(@@)(@@)(@@) ||| 83(@)(@)(@@) @HAD015 إياك أن تثني على أحد بما ليس فيه فإن فعله يصدق 