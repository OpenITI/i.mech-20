ms81	 الملك الذي لم اغترب % % عن أرض قومي خطوة لولاه % % 43(@)(@@) % أيجوز أن أشكوك ضيقة عيشة % والمال عندك راهن والجاه % % PageV01P248 البحر : - 1(@)(@@) % يهن علاك مداها القصي % % ومجد يؤثل عنها سني % % 2(@)(@@) % لقد حل سؤددك المرتقى ال % % ذي لا يرام إليه رقي % % 3(@)(@@) % وذل بعزمك صرف الزما % % ن حتى أطاعك منه العصي % 4(@)(@@) % ورضت الحوادث ذا حنكة % فصيرت ما اعوج منها سوي % % 5(@)(@@) % وأنت عميد العلى لم تزل % % وأنت حلاحلها الأريحي % % 6(@)(@@) % وقائلة رعتها خلة % % أليس لك اليعمل الشدقمي % % 7(@)(@@) % وهذا ابن يحيى إلى فضله % % تنض الركاب وتنضي المطي % % 8(@)(@@) % فعش في ذراه فإن الوفود % % لهم رغد العيش منه الهني % 9(@)(@@) % جناب مريع لوارده % % بواد خصيب وشرب روي % 10(@)(@@) % فلما تيممته قاصدا % تكنفني منه جود سني % PageV01P249 11(@)(@@) % وقابلني البدر من وجهه % وناطقني مصقع هبرزي % % 12(@)(@@) % تحار العقول بألفاظه % % فيرتد غفلا لديه الدهي % 13(@)(@@) % وقور يراع له هيبة % % لذيذ الفكاهة عذب شهي % 14(@)(@@) % كأن تألق آرائه % % سنا البرق يفتر عنه الحبي % 15(@)(@@) % يشف العيون بايماضها % % كأن القضاء لديه نجي % 16(@)(@@) % إذا ما انتضى العزم أقلامه % تذلل طوعا له السمهري % 17(@)(@@) % ولم ينج منهن حد الظبى % % ولا الزغف والزرد التبعي % % 18(@)(@@) % فتلك اليراع اللواتي لها % % شباة يفض بها السابري % % 19(@)(@@) % يشب بأطرافهن الوغى % % فتضحي وللهام فيها هوي % 20(@)(@@) % يزين المهارق من كتبه % كما فوف البرد الأتحمي % % PageV01P250 21(@)(@@) % كنور الحديقة في روضة % تتابع وسميها والولي % 22(@)(@@) % تروق العيون بأزهارها % % وتبسم عن نشرها العنبري % % 23(@)(@@) % فحين تفيأت أظلالها % % ظللت وبالي لديه رخي % 24(@)(@@) % بحال قعدت بها عاطلا % فصيغ لها من نداه الحلي % 25(@)(@@) % فتى يفعل المكرمات الجسام % % ويسترهن بطرف حني % 26(@)(@@) % ولما صفا لي ريق الحياة % وساغ لي العذب منه المري % 27(@)(@@) % بذلت حدائق شكري له % وأتبعت فيهن مداحا جني % 28(@)(@@) % فقلت الذي رام مسعى أبي % % حسين لقد خاب سعيا بطي % % 29(@)(@@) % إذا هو خودع عن ماله % تخادع وهو النبيه الدري % 30(@)(@@) % منحتك عذراء زفت إليك % % كما ازدلفت للبناء الهدي % PageV01P251 31(@)(@@) % إذا ما ثنى التيه أعطافها 
ms82	 % % تضوع من نشرها المندلي % 32(@)(@@) % فقد قصر المدح عن شكر من % % أطاع له الدهر قسرا أبي % % 33(@)(@@) % تمل العلى ما بدا كوكب % % وما أعقب الليل صبح ذكي % PageV01P252 البحر : - 1(@)(@@) % وكم من أخ لو حرم الماء لم أكن % % له ولو أني مت ظمآن شاربا % 2(@)(@@) % فظن بهذا وده لي تطوعا % وودي له فرضا علي وواجبا % % 3(@)(@@) % فأعتقني ذا الظن من سوء ملكه % % وكنت له عبدا فأصبحت صاحبا % % 4(@)(@@) % ومن ظن أن لا بد منه أريته % بصبري عنه ذلك الظن كاذبا % % 5(@)(@@) % أبيح لخلي من فؤادي جانبا % وأترك للهجران إن كان جانبا % % 6(@)(@@) % على أنني ألقاه بالبشر حاضرا % وأحفظه بالغيب إن كان غائبا % % 7(@)(@@) % وتلك سجايا لي أعم بها العدى % % وأشرك فيهن العدى والأقاربا % % PageV01P253 البحر : - 1(@)(@@) % لنفسك لم لا عذر قد نفد العذر % بذا حكم المقدور إذ قضي الأمر % 2(@)(@@) % لقد لفظتني كل أرض وبلدة % وما لفظتني عن مواطنها مصر % 3(@)(@@) % لعمري لقد طوفت في طلب العلى % % وحالفني بر وحالفني بحر % 4(@)(@@) % فشرقت حتى لم أجد لي مشرقا % وغربت حتى قيل هذا هو الخضر % % 5(@)(@@) % أروم جسيمات الأمور وإنما % % قصاراي أن أبقى إذا بقي الدهر % % 6(@)(@@) % ولو كنت أرضى بالكثير وجدته % ولكن في نفسي أمورا لهاأمر % 7(@)(@@) % ظللت بمصر في السجون مخلدا % وإني لسيف جفنه فوقه ستر % % 8(@)(@@) % فقدت أخلائي الذين عهدتهم % % وجانبني من كان لي عنده وفر % 9(@)(@@) % وأعظم ما بي يا محمد أننا % % بأرض وفيها بينا البعد والهجر % 10(@)(@@) % ومالي من ذنب إليك اجترمته % فقل لي مع الإخوان غيرك الدهر % % PageV01P254 11(@)(@@) % تأمل أبا عبد الإله مقالتي % % فإن الصديق الحر يعتبه الحر % % 12(@)(@@) % أتذكر إذ كنا لدى الدهر رتعا % ومصر وأرض الشام إذ عيشنا نضر % % 13(@)(@@) % فمالك تجفوني مع الدهر إذ عتا % % أكل زمان عيشه هكذا مر % 14(@)(@@) % فلا سائل عني فأعذر صاحبا % ولا لك في ترك السؤال بنا عذر % % 15(@)(@@) % فإن أحرم الإخوان والزور منهم % % فإني امرؤ من شيمتي في الأسى الصبر % % 16(@)(@@) % عتبتك عتب الذاكر الود إذ غدا % % أسيرا 
ms83	 ومحبوسا وقد ناله ضر % 17(@)(@@) % فلو كنت في أسر الزمان أقالني % % ولكنني في أسر قوم بهم كبر % 18(@)(@@) % إذا جنني ليلي وهاجت بلابلي % % وعاودني همي تجدد لي فكر % % 19(@)(@@) % عليل وما دائي سوى الضيم منهم % فهل من دواء إذ مدى الغاية القبر % % 20(@)(@@) % فلو أبصرت عيناك ما بي من الأسى % % بكيت بماينضي به الأبل السفر % % PageV01P255 21(@)(@@) % على أنني لا أستكين لنكبة % ولا واضع جنبي وإن مسني فقر % % 22(@)(@@) % جنيت على نفسي بسعيي إليهم % وحظي من أوفى مواثيقهم غدر % % 23(@)(@@) % ومالي من ذنب سوى الشعر إنني % % لأعلم أن الذنب في نكبتي الشعر % % 24(@)(@@) % لعل الليالي منصفات أخا نوى % بأحشائه من فرط حسرته جمر % % 25(@)(@@) % أسير لدى قوم بغير جناية % % ألا في سبيل الله ما صنع الدهر % % 26(@)(@@) % لقد ضاقت الدنيا علي كأنها % % لما قدر الرحمن في مقلتي فتر % % 27(@)(@@) % وفي النفس حاجات ودون مرامها % % قيود وحراس لهم حولنا زجر % % 28(@)(@@) % فكن سائلا عني فإني هالك % % وما لهم عندي على حالة وتر % % 29(@)(@@) % حذرت زمانا ثم أوقعني القضا % % وهل حذر ينجي إذا نفد العمر % % 30(@)(@@) % وأنت أخي في كل حال وإنما % % عتبتك هذا العتب إذ نفث الصدر % % PageV01P256 31(@)(@@) % أكل غريب هكذا هو هالك % % بمصر ولم يشفع له شافع حر % 32(@)(@@) % فلو أنني في بلدة غير هذه % % إذا لفداني المال والأسل السمر % % 33(@)(@@) % وما نالني ضيم ولا لان جانبي % % ولا نالني ضر ولا مسني عسر % 34(@)(@@) % أبيت لها يقظان بين وساوس % أراعي نجوم الليل ما طلع الفجر % 35(@)(@@) % إذا كان نفسي من أجل ذخيرتي % % وأتلفتها لم يبق لي بعدها ذخر % % 36(@)(@@) % فإن عشت أبديت الذي في ضمائري % % وإن مت إن الملتقى لهو الحشر % % PageV01P257 البحر : - 1(@)(@@) % أيا من نعاه لسان القريض % % وكالند ينشر من عرفه % % 2(@)(@@) % ومن كالثريا له همة % وقد عد ذلك من سخفه % % 3(@)(@@) % يعز على الدهر ما أنت فيه % % وإن حل ذلك من صرفه % % 4(@)(@@) % فلا تقنطن فإن الخناق % % يقطعه الضيق من حرفه % % 5(@)(@@) % فقد يقشع الغيم بعد الهطول % % وإن طبق 
ms84	 الأرض من وكفه % % 6(@)(@@) % وباري العباد لطيف بهم % % فلا توئس النفس من لطفه % % 7(@)(@@) % تبارك من عز في ملكه % % وجل المهيمن عن وصفه % % 8(@)(@@) % توسل إليه إذا الليل جن % فيما دهاك وفي كشفه % % 9(@)(@@) % يريحك من سجن دار البنود % % ويكفيك ما أنت مستكفه % % 10(@)(@@) % من القيد والغل في أدهم % % أليم عذابك من عنفه % % PageV01P258 11(@)(@@) % يفك وثاقك من أسرها % % وراحة قلبك من لهفه % % 12(@)(@@) % وأما بشرب حياض المنون % % فقد سلم العيش من خسفه % % 13(@)(@@) % وضاعف وجدي لما سجنت % مقالة من غاب من طرفه % % 14(@)(@@) % يقول وبعض كلام السفيه % % يقتل إن هو لم يخفه % % 15(@)(@@) % أهذا التهامي من مكة % % برجليه يسعى إلى حتفه % % 16(@)(@@) % ألم يكفه أن ثوب الحيا % % ة ضاق عليه ألم يكفه % % 17(@)(@@) % أراد يطير مطار الملوك % % وظن الأسنة من زفه % % 18(@)(@@) % وكان كقائد جيش الضلا % % ل عاين جبريل في صفه % % 19(@)(@@) % أصيفر يرعف من نحره % % إذا رعف المرء من أنفه % % 20(@)(@@) % وأحسب سيف ابن بنت % % النبي يخضب خديه من عرفه % % PageV01P259 21(@)(@@) % أرى ملك الموت يدنو إليه % % وهو يعض على كفه % % 22(@)(@@) % أبالشعر ويحك تبغي العلى % % وأنت تقصر عن رصفه % % 23(@)(@@) % ولم تك أهلا بأن تستقر % على منبر الملك أو طرفه % % 24(@)(@@) % لأنك أبور من شاعر % % على خسة الشعر مع ضعفه % % 25(@)(@@) % أرقت دما بعد ما صنته % وأشعلت جمرا ولم تطفه % % 26(@)(@@) % وأشفيت منتظرا للبوار % % وصدرك حران لم تشفه % 27(@)(@@) % لعمرك إن لبيب الرجا % % ل من كف أو غض من طرفه % % 28(@)(@@) % إلى الله أشكو أمورا جرت % % على غير قصد وأستعفه % % 29(@)(@@) % وكم قائل سجنوه على % % تطلبه الملك من كهفه % % 30(@)(@@) % أيطلب الملك من ليس منه % ولا من بنيه ولا صنفه % % PageV01P260 31(@)(@@) % ومن كان ذا حنكة بالعلو % % م قاربه البؤس من حرفه % % 32(@)(@@) % إذا نشف العود من أصله % % فذلك أدهى إلى قصفه % % 33(@)(@@) % وذو الفضل ينظر في أمره % % كذي النقص ينظر في عطفه % % 34(@)(@@) % فإن مصارع بغي الرجا % % ل تخترم الإلف من إلفه % % 35(@)(@@) % وكل بما قاله آثم % % سيقرا الذي 
ms85	 قال في صحفه % 36(@)(@@) % وليس سوى نكبات الزمان % % ورأي يضلك في ضعفه % % 37(@)(@@) % على أهل مكة مني السلام % ومن يصفني الود أو أصفه % % 38(@)(@@) % حياتي وبعد وفاتي إذا % % هويت من اللحد في لحفه % % PageV01P261 البحر : - 1(@)(@@) % جسمي نحيل بالحب والحب % ذا من ربيبي وذاك من ربي % % 2(@)(@@) % ناران نار بالطب إن ظهرت % % تخفى ونار تخفى عن الطب % % 3(@)(@@) % مولاي مهلا فليس يجمل إن % % عتبت بي غير موضع العتب % % 4(@)(@@) % بي جرب واقع مضاربه % أمضى من المرهفات في الضرب % % 5(@)(@@) % أغزر من ماء مقلتي فإذا % % يئست منه أحر من قلبي % % 6(@)(@@) % حرمت من لبسة الثياب فقد % % عريت إلا من لؤلؤ رطب % % 7(@)(@@) % غير منير جسمي عليه إذا % % هاج وصلبي فليس بالصلب % % 8(@)(@@) % كأن كفي في اشتباكهما % % جيشان حفا بالطعن والضرب % % 9(@)(@@) % وليس غير الأظفار بينهما % % من أسمر ذابل ومن عضب % % PageV01P262 البحر : - 1(@)(@@) % شقيت بما جمعت فليت شعري % % ورائي من يكون به سعيدا % % 2(@)(@@) % أعاين حسرة أهلي ومالي % % إذا ما النفس جاوزت الوريدا % % 3(@)(@@) % أعد الزاد من تقوى فإني % % رأيت منيتي السفر البعيدا % % 4(@)(@@) % تبدل صاحبي في اللحد مني % % وهال على مناكبي الصعيدا % % 5(@)(@@) % وودعني وعز عليه أني % % أودعه وداعا لن أعودا % % 6(@)(@@) % فلو أبصرتني من بعد عشر % % رأيت محاسني قد صرن دودا % % 7(@)(@@) % وحيدا مفردا يا رب عفوا % بعبدك حين تتركه وحيدا % % PageV01P263 البحر : - 1(@)(@@) % سقى دمعي الأحبة حيث ساروا % % فما ترويهم الديم الغزار % % 2(@)(@@) % تولت ظعنهم والمرء تنبو % % به الأحوال لا تنبو الديار % % 3(@)(@@) % لهن من الخبا نحوي ابتدار % كما ابتدرت من الزند الشرار % 4(@)(@@) % فأصمين الفؤاد فقلت واها % أترمي قلب صائدها الصوار % % 5(@)(@@) % أقيدوني جآذركم فقالوا % % جراحة كل عجماء جبار % % 6(@)(@@) % وطاعنة برمح من نهود % أسنة مثلها الحلم الصغار % % 7(@)(@@) % زرعت بخدها روضا بلثمي % % ففي وجناتها منه اخضرار % 8(@)(@@) % كأن مواقع التقبيل فيه % % رماد جامد والخد نار % % 9(@)(@@) % لعينك وخزة في كل قلب % أأشفار جفونك أم شفار % 10(@)(@@) % عذرتك إذ حجبت وأنت بدر % % له في كل أوقات سرار % PageV01P264 11(@)(@@) % تجرد مني 
ms86	 الأيام نصلا % له في كل نائبة غرار % 12(@)(@@) % تظن أناتي الجهلاء وقرا % وهذا الوقر أكثره وقار % 13(@)(@@) % ولو ساد الصبور بغير حلم % إذن لاقتاد قائده الحمار % 14(@)(@@) % فذرني والطغاة فبين رمحي % % وبين قلوب أكثرهم سرار % 15(@)(@@) % إذا ما عرس الخطي فيهم % % فإن رؤوسهم فيها نثار % 16(@)(@@) % كأن رؤوسهم حصبات حذف % تساقط والفضاء لها جمار % % 17(@)(@@) % حلفت لأنهضن لهم بأسد % لهم بشعار دين الله زار % % 18(@)(@@) % إذا عمدوا ظلام الشرك يوما % أزالوه كأنهم نهار % % 19(@)(@@) % يؤدون النفوس إلى المنايا % % كأن النفس علق مستعار % % 20(@)(@@) % إذا بلغ الفتى عشرين عاما % وأعجزه الفخار فلا اعتذار % % PageV01P265 21(@)(@@) % إذا ما أول الخطي اخطا % % فما يرجى بآخره انتصار % % PageV01P266 البحر : - 1(@)(@@) % لقد كنت نبالا بلحظك صائدا % فأردفت رمحا حين أصبحت ناهدا % % 2(@)(@@) % سلاح ولكن لا يضير مدانيا % وينفذ فيه حده متباعدا % % 3(@)(@@) % يبرز ورد الخد ثم يعيده % ولم أر وردا في الكمائم عائدا % % 4(@)(@@) % لها مقلة بالسقم تعدي وما بها % % سقام وهل تردي السموم الاساودا % % 5(@)(@@) % لها برد من ثغرها الريق ذوبه % فطاب ولولا ذاك لم يك باردا % % 6(@)(@@) % وأقسم أني ما هممت بريبة % % لغانية إلا إذا كنت راقدا % % 7(@)(@@) % ولكنني لما رأيت جفونها % % ممرضة أرسلت طرفي عائدا % % 8(@)(@@) % ولو لم تكن أجفانها صدفا لما % % نثرن غداة البين درا فرائدا % % 9(@)(@@) % كلفت بحب البيض والقلب مولع % بحب المواضي ما هجرت الخرائدا % % 10(@)(@@) % ويسعدني سيفي على كل بغية % % إذا لم أجد في العالمين مساعدا % % PageV01P267 11(@)(@@) % توسدني العيس الطليح ذراعها % % إذا لم توسدني الخريدة ساعدا % % 12(@)(@@) % وكنت إذا ما رمت رعي قرارة % من المجد أرسلت الرديني رائدا % % 13(@)(@@) % وكم رجل أثوابه دون قدره % % وقد يلبس السلك الجمان الفرائدا % % 14(@)(@@) % فلا تعجبن ذا البخل كثرة ماله % فإن الشغى نقص وإن كان زائدا % PageV01P268 البحر : - 1(@)(@@) % سأطلب العلاء بكل ليث % % له زار بذكر الله وحده % % 2(@)(@@) % له مما تصوغ الهند ناب % % ومما حاكه داود لبده % % 3(@)(@@) % يرد الرمح أزرق في احمرار % % كمقلة أزرق كحلت برقده % % PageV01P269 البحر : - 1(@)(@@) % ترى النازلين بأرض العراق % % وقد 
ms87	 علموا أن وجدي كذا % % 2(@)(@@) % فلا حبذا بلد بعدهم % % وإن واصلوه فيا حبذا % % 3(@)(@@) % دنا طرب والهوى نازح % فيا بعد ذاك ويا قرب ذا % % 4(@)(@@) % هوى ماأطعت به العاذلين % % وما طاعة الحب إلا أذى % % 5(@)(@@) % وقد كنت أقذي به ناظري % % فمذ غاب صار لعيني قذى % % PageV01P270 البحر : - 1(@)(@@) % دل فأبدى الصدود والجزعا % % تيها وقد كان حقق الطمعا % % 2(@)(@@) % ولم يكن ذاك منه عن ملل % بل كان يهوى أذيتي ولعا % % 3(@)(@@) % حتى إذا ما يئست منه دنا % % وجدد الوصل بعدما قطعا % % 4(@)(@@) % ظبي تجرعت من تمنعه % % قدما من الصاب في الهوى جرعا % % 5(@)(@@) % يتبعني في الهوى وأتبعه % أكرم به تابعا ومتبعا % % PageV01P271 البحر : - 1(@)(@@) % لوكان حر الوجد يعقب بعده % % برد الوصال غفرت ذاك لذاكا % % 2(@)(@@) % لكن شجيت بمن يبيت مسلما % خالي الضلوع ولا يحس شجاكا % % 3(@)(@@) % إن يصبحوا صاحين من خمر الهوى % % فلقد سقوك من الغرام دراكا % % 4(@)(@@) % يا ليت شغلك بالأسى أعداهم % % أولا فليت فراغهم أعداكا % % 5(@)(@@) % أهوى وذلا في الهوى وإطاعة % % أبدا تعالى الله ما أشقاكا % % 6(@)(@@) % يا قلب كيف علقت في أشراكهم % % ولقد عهدتك تفلت الأشراكا % % 7(@)(@@) % أكبيت حين تقصدتك سهامهم % % قد كنت عن أمثالها أنهاكا % % 8(@)(@@) % إذ ذبت من كمد فقد جر الهوى % % هذا السقام علي من جراكا % % 9(@)(@@) % يا قلب ليتك حيث لم تدع الهوى % % علقت من يهواك مثل هواكا % % 10(@)(@@) % لا تشكون إلي وجدا بعدها % % هذا الذي جرت عليك يداكا % % PageV01P272 11(@)(@@) % لأعاقبنك بالغليل وإنني % % لولاك لم أذق الهوى لولاكا % % 12(@)(@@) % يا عاذل المشتاق دعه فإنه % يطوي على الزفرات غير حشاكا % % 13(@)(@@) % لو كان قلبك عنده ما لمته % % حاشاك مما عنده حاشاكا % % PageV01P273 البحر : - 1(@)(@@) % ألا يا غزالا أعار الغزالا % % جمالا وأعطى القضيب اعتدالا % % 2(@)(@@) % يسرك يا منيتي أن ترى % % محبك من أسوأ الناس حالا % % 3(@)(@@) % فلله دهر مضى بالوصال % % فما كان أحسن ذاك الوصالا % % 4(@)(@@) % ولما ترحلت عني بكيت % % بدمع سكوب يزيد اشتعالا % % 5(@)(@@) % أناخوا جمالا وحازوا جمالا % أظن الأحبة راموا ارتحالا % % PageV01P274 البحر : - 1(@)(@@) % قل للذي ورد خده 
ms88	 القاني % % في لج بحر الغرام القاني % % 2(@)(@@) % ما نلت من ثغر ريقك الهاني % % عن ثغر كل الأنام ألهاني % % PageV01P275 البحر : - 1(@)(@@) % حكم المنية في البرية جار % ما هذه الدنيا بدار قرار % 2(@)(@@) % بينا يرى الانسان فيها مخبرا % حتى يرى خبرا من الاخبار % % 3(@)(@@) % طبعت على كدر وأنت تريدها % % صفوا من الأقذاء والأكدار % % 4(@)(@@) % ومكلف الأيام ضد طباعها % % متطلب في الماء جذوة نار % % 5(@)(@@) % وإذا رجوت المستحيل فإنما % % تبني الرجاء على شفير هار % % 6(@)(@@) % فالعيش نوم والمنية يقظة % % والمرء بينهما خيال سار % % 7(@)(@@) % والنفس إن رضيت بذلك أو أبت % % منقادة بأزمة المقدار % % 8(@)(@@) % فاقضوا مآربكم عجالا إنما % % أعماركم سفر من الأسفار % % 9(@)(@@) % وتراكضوا خيل الشباب وبادروا % % أن تسترد فإنهن عوار % % 10(@)(@@) % فالدهر يخدع بالمنى ويغص إن % % هنا ويهدم ما بنى ببوار % PageV01P276 11(@)(@@) % ليس الزمان وإن حرصت مسالما % خلق الزمان عداوة الأحرار % 12(@)(@@) % إني وترت بصارم ذي رونق % أعددته لطلابة الأوتار % % 13(@)(@@) % زردا فأحكم كل موصل حلقة % % بحبابة في موضع المسمار % % 14(@)(@@) % فدحوا فويق الأرض أرضا من دم % ثم انثنوا فبنوا سماء غبار % % 15(@)(@@) % قوم إذا لبسوا الدروع حسبتها % % سحبا مزررة على أقمار % % 16(@)(@@) % وترى سيوف الدارعين كأنها % % خلج تمد بها أكف بحار % % 17(@)(@@) % لو أشرعوا أيمانهم من طولها % % طعنوا بها عوض القنا الخطار % % 18(@)(@@) % شوس إذا عدموا الوغى انتجعوا لها % % في كل أوب نجعة الأمطار % % 19(@)(@@) % جنبوا الجياد إلى المطي وراوحوا % % بين السروج هناك والأكوار % % 20(@)(@@) % فكأنما ملؤوا عياب دروعهم % % وغمود أنصلهم سراب قفار % % PageV01P277 21(@)(@@) % وكأنما صنع السوابغعزه % % ماء الحديد فصاغ ماء قرار % % 22(@)(@@) % فتدرعوا بمتون ماء جامد % % وتقنعوا بحباب ماء جار % % 23(@)(@@) % أسد ولكن يؤثرون بزادهم % % والأسد ليس تدين بالإيثار % % 24(@)(@@) % يتزين النادي بحسن وجوههم % % كتزين الهالات بالأقمار % % 25(@)(@@) % يتعطفون على المجاور فيهم % % بالمنفسات تعطف الأظآر % % 26(@)(@@) % من كل من جعل الظبى أنصاره % % وكرمن فاستغنى عن الأنصار % % 27(@)(@@) % والليث إن بارزته لم يعتمد % % إلا على الأنياب والأظفار % % 28(@)(@@) % وإذا هو اعتقل القناة حسبتها % % صلا تأبطه هزبر ضار % % 29(@)(@@) % زرد الدلاص من 
ms89	 الطعان برمحه % % مثل الأساور في يد الإسوار % % 30(@)(@@) % ويجر حين يجر صعدة رمحه % في الجحفل المتضايق الجرار % % PageV01P278 31(@)(@@) % ما بين ترب بالدماء ملبد % زلق ونقع بالطراد مثار % % 32(@)(@@) % والهون في ظل الهوينى كامن % وجلالة الأخطار في الإخطار % % 33(@)(@@) % تندى أسرة وجهه ويمينه % % في حالة الإعسار والإيسار % % 34(@)(@@) % ويمد نحو المكرمات أناملا % للرزق في أثنائهن مجار % % 35(@)(@@) % يحوي المعالي غالبا أو خالبا % أبدا يداني دونها ويداري % % 36(@)(@@) % قد لاح في ليل الشباب كواكب % % إن أمهلت آلت إلى الاسفار % % 37(@)(@@) % يا كوكبا ما كان أقصر عمره % % وكذا تكون كواكب الأسحار % % 38(@)(@@) % أثني عليه بأثره ولو أنه % لم يغتبط أثنيت بالآثار % % 39(@)(@@) % وهلال أيام مضى لم يستدر % % بدرا ولم يمهل لوقت سرار % % 40(@)(@@) % عجل الخسوف عليه قبل أوانه % فمحاه قبل مظنة الإبدار % % PageV01P279 41(@)(@@) % واستل من أتربه ولداته % كالمقلة استلت من الأشفار % % 42(@)(@@) % فكأن قلبي قبره وكأنه % في طيه سر من الأسرار % % 43(@)(@@) % إن يحتقر صغرا فرب مفخم % % يبدو ضئيل الشخص للنظار % % 44(@)(@@) % إن الكواكب في علو محلها % % لترى صغارا وهي غير صغار % % 45(@)(@@) % ولد المعزى بعضه فإذا انقضى % % بعض الفتى فالكل في الآثار % % 46(@)(@@) % أبكيه ثم أقول معتذرا له % % وفقت حينتركت ألأم دار % % 47(@)(@@) % جاورت أعدائي وجاور ربه % شتان بين جواره وجواري % % 48(@)(@@) % أشكو بعادك لي وأنت بموضع % لولا الردى لسمعت فيه سراري % % 49(@)(@@) % والشرق نحو الغرب أقرب شقة % % من بعد تلك الخمسة الأشبار % % 50(@)(@@) % هيهات قد علقتك أشراك الردى % % واعتاق عمرك عائق الأعمار % % PageV01P280 51(@)(@@) % ولقد جريت كما جريت لغاية % فبلغتها وأبوك في المضمار % % 52(@)(@@) % فإذا نطقت فأنت أول منطقي % % وإذا سكت فأنت في إضماري % % 53(@)(@@) % أخفي من البر حاء نارا مثل ما % % يخفي من النار الزناد الواري % % 54(@)(@@) % وأخفض الزفرات هي صواعد % % وأكفكف العبرات وهي جوار % % 55(@)(@@) % وشهاب زند الحزن أن طاوعته % وار وإن عاصيته متوار % % 56(@)(@@) % وأكف نيران الأسى ولربما % % غلب التصبر فارتمت بشرار % % 57(@)(@@) % ثوب الرياء يشف عما تحته % فإذا التحفت به فإنك عار % % 58(@)(@@) % قصرت جفوني أم تباعد بينها 
ms90	 % % أم صورت عيني بلا أشفار % % 59(@)(@@) % جفت الكرى حتى كأن غرارها % % عند اغتماض العين حد غرار % % 60(@)(@@) % ولو استزارت رقدة لرمى بها % % ما بين أجفاني إلى التيار % % PageV01P281 61(@)(@@) % أحيي ليالي التم وهي تميتني % % ويميتهن تبلج الأنوار % % 62(@)(@@) % حتى رأيت الصبح يرفع كفه % بالضوء رفرف خيمة من قار % % 63(@)(@@) % والصبح قد غمر النجوم كأنه % سيل طغى فطما على النوار % % 64(@)(@@) % لو كنت تمنع خاض دونك فتية % منا بحار عوامل وشفار % % 65(@)(@@) % وتلهب الأحشاء شيب مفرقي % % هذا الضياء شواظ تلك النار % % 66(@)(@@) % شاب القذال وكل غصن صائر % فينانه الأحوى إلى الإزهار % % 67(@)(@@) % والشبه منجذب فلم بيض الدمى % % عن بيض مفرقه ذوات نفار % % 68(@)(@@) % وتود لو جعلت سواد قلوبها % % وسواد أعينها خضاب عذاري % % 69(@)(@@) % لا تنفر الظبيات عنه فقد رأت % % كيف اختلاف النبت في الأطوار % % 70(@)(@@) % شيئان ينقشعان أول وهلة % شرخ الشباب وخلة الأشرار % % PageV01P282 71(@)(@@) % لا حبذا الشيب الوفي وحبذا % % ظل الشباب الخائن الغدار % % 72(@)(@@) % وطري من الدنيا الشباب وروقه % فإذا انقضى فقد انقضت أوطاري % % 73(@)(@@) % قصرت مسافته وما حسناته % عندي ولا آلاؤه بقصار % % 74(@)(@@) % نزداد هما كلما ازددنا غنى % والفقر كل الفقر في الإكثار % % 75(@)(@@) % ما زاد فوق الزاد خلف ضائعا % في حادث أو وارث أو عار % % 76(@)(@@) % إني لأرحم حاسدي لحر ما % % ضمت صدورهم من الأوغار % % 77(@)(@@) % نظروا صنيع الله بي فعيونهم % % في جنة وقلوبهم في نار % % 78(@)(@@) % لا ذنب لي كم رمت كتم فضائلي % % فكأنما برقعت وجه نهار % % 79(@)(@@) % وسترتها بتواضعي فتطلعت % % أعناقها تعلو على الأستار % % 80(@)(@@) % ومن الرجال معالم ومجاهل % ومن النجوم غوامض ودراري % % PageV01P283 81(@)(@@) % والناس مشتبهون في إيرادهم % % وتباين الأقوام في الأصدار % % 82(@)(@@) % عمري لقد أوطأتهم طرق العلى % % فعموا ولم يقفوا على آثاري % % 83(@)(@@) % لو أبصروا بقلوبهم لاستبصروا % % وعمى البصائر من عمى الأبصار % % 84(@)(@@) % هلا سعوا سعي الكرام فأدركوا % % أو سلموا لمواقع الأقدار % % 85(@)(@@) % ذهب التكرم والوفاء من الورى % % وتصرما إلا من الأشعار % % 86(@)(@@) % وفشت خيانات الثقات وغيرهم % % حتى اتهمنا رؤية الأبصار % % 87(@)(@@) % ولربما اعتضد الحليم بجاهل % % لا 
ms91	 خير في يمنى بغير يسار % % PageV01P284 البحر : - 1(@)(@@) % لله در النائبات فإنها % % صدأ اللئام وصيقل الأحرار % % 2(@)(@@) % هل كنت إلا زبرة فطبعنني % % سيفا وأطلق صرفهن غراري % % 3(@)(@@) % زمن كأم الكلب ترأم جروها % % وتصد عن ولد الهزبر الضاري % % PageV01P285 البحر : - 1(@)(@@) % أبا الفضل طال الليل أم خانني صبري % % فخيل لي أن الكواكب لا تسري % % 2(@)(@@) % أرى الرملة البيضاء بعدك أظلمت % % فدهري ليل ليس يفضي إلى فجر % % 3(@)(@@) % وما ذاك إلا أن فيها وديعة % % أبي ربها أن تسترد إلى الحشر % % 4(@)(@@) % رزئت بملء العين يحسب كوكبا % تولد بين الشمس والقمر البدر % % 5(@)(@@) % بأبلج لو يخفى لنم ضياؤه % % عليه كما نم النسيم على الزهر % % 6(@)(@@) % بنفسي هلال كنت أرجو تمامه % % فعاجله المقدار في غرة الشهر % % 7(@)(@@) % وشبل رجونا أن يكون غضنفرا % % فمات ولم يجرح بناب ولا ظفر % % 8(@)(@@) % أتاه قضاء الله في دار غربة % بنفسي غريب الأصل والقبر والقدر % % 9(@)(@@) % أحمله ثقل التراب وإنني % % لأخشى عليه الثقل من موطئ الذر % % 10(@)(@@) % وأودعه غبراء غير أمينة % عليه ولكن قاد شر إلى شر % PageV01P286 11(@)(@@) % فوالله لو أسطيع قاسمته الردى % % فمتنا جميعا أو لقاسمني عمري % % 12(@)(@@) % ولكنما أرواحنا ملك غيرنا % % فما لي في نفسي ولا فيه من أمر % % 13(@)(@@) % وما اقتضت الأيام إلا هباتها % % فهلا اقتضتها قبل أن ملأت صدري % % 14(@)(@@) % ومن قبل أن يجري هواه وإلفه % % بقلبي جري الماء في الغصن النضر % % 15(@)(@@) % ولا حزن إلا يوم واريت شخصه % % ورحت ببعض النفس والبعض في القبر % % 16(@)(@@) % وأعلم أن الحادثات بمرصد % لتأخذ كلي مثل ما أخذت شطري % % 17(@)(@@) % أحين نضا ثوب الطفولة ناسلا % كما ينسل الريش اللؤام عن النسر % % 18(@)(@@) % وخلى رضاع الثدي مستبدلا به % % أفاويق من در البلاغة والشعر % % 19(@)(@@) % وألقى تميمات الصبى وتباشرت % % حمائل أغماد المهندة البتر % % 20(@)(@@) % وبان عليه الفضل قبل اثغاره % % ويبدو وإن لم يثغر كرم المهر % % PageV01P287 21(@)(@@) % وقامت عليه للعلاء شواهد % كما استشهد العضب السريجي بالأثر % % 22(@)(@@) % وخبرنا عن طيبه ماء وجهه % كتخبير ماء الظلم عن طيبة الثغر % % 23(@)(@@) % وجادت به الأيام وهي 
ms92	 بخيلة % وقد ينبع الماء الزلال من الصخر % % 24(@)(@@) % طواه الردى طي الرداء فأصبحت % % مغانيه ما فيهن منه سوى الذكر % % 25(@)(@@) % فجاد على قسر بباقي دمائه % % وقد كان ممن لا يجود على القسر % % 26(@)(@@) % فإن أبك فالقربى القريبة تقتضي % % بكائي وإن أصبر فبقيا على الأجر % % 27(@)(@@) % فبي منه ما يوهي القوى غير أنني % % بنيت كما يبنى الكريم على الصبر % % 28(@)(@@) % وما صبر محزون جناح فؤاده % % يرفرف ما بين الترائب والنحر % % 29(@)(@@) % يقلب عينا ما تنام كأنها % % بلا هدب يثني عليها ولا شفر % % 30(@)(@@) % غطا دمعها انسانها فكأنه % % غريق تسامى فوقه لجج البحر % % PageV01P288 31(@)(@@) % ينغص نومي كل يوم ويقظتي % % خيال له يسري وذكر له يجري % % 32(@)(@@) % ويوسع صدري بالحديث ادكاره % % على أن ذاك الوسع أضيق للصدر % % 33(@)(@@) % وقالوا سيسليه التأسي بغيره % % فقلت لهم هل يطفأ الجمر بالجمر % % 34(@)(@@) % ايندمل الجرح الرغيب بمثله % ألا لا ولكن يستطير ويستشري % % 35(@)(@@) % وليت التأسي بالمصيبة كان لي % % كفافا فلا يسلي هناك ولا يغري % % 36(@)(@@) % فلا تسألوني عنه صبرا فإنني % % دفنت به قلبي وفي طيه صبري % % 37(@)(@@) % فإلا تكن قلبي فإنك شطره % قددت كما قد الهلال من البدر % 38(@)(@@) % أيا نعمة جلت وولت ولم أكن % % نهضت بما لله فيها من الشكر % % 39(@)(@@) % وضاعف وجدي أن قضيت ولم تقم % % مقام الشجا المعروض في ثغرة الثغر % % 40(@)(@@) % ولم تلق صفا من عداك بمثله % كما أسند الكتاب سطرا إلى سطر % % PageV01P289 41(@)(@@) % وما خضت جيشا بالدماء مضمخا % يرى بيضهم مثل الحباب على الخمر % % 42(@)(@@) % ولم تختصم حوليك ألسنة القنا % % فتحكم في الهيجاء بالعرف والنكر % % 43(@)(@@) % بضرب يطير البيض من حر وقعه % % شعاعا كم طار الشرار عن الجمر % % 44(@)(@@) % ترى زرد الماذي منه مفككا % % يطيح كما طاح القلام عن الظفر % % 45(@)(@@) % ولما تضف في نصرة الله طعنة % إلى ضربه كالتبن فوق شفا نهر % % 46(@)(@@) % ولما تقم لله بالقسط موقفا % سأقضي ولما أقض من مثله نذري % % 47(@)(@@) % ولم تمش في ظل اللواء كما مشى % % إلى الصيد فهد تحت رفرفة الصقر % % 48(@)(@@) % ولم تخفق 
ms93	 النيران حولك للقرى % % كما خفقت أطراف ألوية حمر % % 49(@)(@@) % ولم تقف أبكار المعاني وعونها % % فترغب فيها عن عوان وعن بكر % % 50(@)(@@) % ولما تبار النجم ضوءا ورفعة % وصيتا وأنوار وهديا إذا يسري % % PageV01P290 51(@)(@@) % ولم تخجل الروض الأنيق بروضة % % مفوفة الأرجاء بالنظم النثر % % 52(@)(@@) % ولما تقم في مشهد بعد مشهد % تصدق أخبار المخايل بالخبر % % 53(@)(@@) % وما قلت إلا ما ذكاؤك ضامن % له كضمانات السحائب للقطر % % 54(@)(@@) % عليك سلام الله ربك إن تكن % % عبرت إلى الأخرى فنحن على الجسر % % 55(@)(@@) % وما نحن إلا مثل أفراس حلبة % تقدمنا شيء ونحن على الأثر % % 56(@)(@@) % ولما تجارينا وغاية سبقنا % % إلى الموت كان السبق للجذع الغمر % % 57(@)(@@) % محاك الردى من رأي عيني وما محا % % خيالك من قلبي وذكرك من فكري % % 58(@)(@@) % فما أنس من شيء وإن جل قدره % % فإنك مني ماحييت على ذكر % % 59(@)(@@) % وإني من دهر أصابك صرفه % وأخطأني من أن يصيب على حذر % % 60(@)(@@) % رحلت وخلفت الذين تركتهم % % وراءك بالأحزان والهم والفكر % % PageV01P291 61(@)(@@) % فلو لفظتك الأرض قلت تشابهت % % مناظر من في البطن منها وفي الظهر % % 62(@)(@@) % ولا فرق فيما بيننا غير أننا % % بمس الأذى ندري وأنك لا تدري % % 63(@)(@@) % رجوتك للدنيا وللدين قبلها % % ورحت بكف من رجائهما صفر % % 64(@)(@@) % أزورك إكراما وبرا وفي البلى % % لمثلك شغل عن وفائي وعن بري % % 65(@)(@@) % ولما أتى بعد المشيب عدلته % بعصر الشباب الغض بورك من عصر % % 66(@)(@@) % وقلت شباب ابني شبابي وإنما % % ينقل معنى الشطر مني إلى الشطر % % 67(@)(@@) % فولى كما ولى الشباب كلاهما % % حميد فقيد طيب العهد والبشر % % 68(@)(@@) % وكان كمثل العنبر الجون لبثه % فبان وأبقى في يدي عبق العطر % % 69(@)(@@) % نقضت عهود الود إن ذقت بعده % % سلوا ألا إن السلو أخو الغدر % % 70(@)(@@) % وما أنا بالوافي وقد عشت بعده % ورب اعتراف كان أبلغ من عذر % % PageV01P292 71(@)(@@) % كفى حزنا أني دعوت فلم يجب % % ولم يك صمتا عن وقار ولا وقر % % 72(@)(@@) % ولم يك عن بعد المسافة صمته % فما بيننا إلا ذراعان في القدر % % 73(@)(@@) % ننافس في الدنيا غرورا 
ms94	 وإنما % % قصارى غناها أن يؤول إلى الفقر % % 74(@)(@@) % وإنا لفي الدنيا كركب سفينة % نظن وقوفا والزمان بنا يجري % % 75(@)(@@) % وأفنيت أياما فنيت بمرها % % وغاية ما يفنى ويفني إلى قدر % % 76(@)(@@) % إلى الله أشكو ما أجن وإنني % % فقدتك فقد الماء في البلد القفر % % 77(@)(@@) % على حين جزت الأربعين مصوبا % ولاحت نجوم الشيب في ظلم الشعر % % 78(@)(@@) % إذا ما تولى ابني وولت شبيبتي % % وولى عزائي فالسلام على الدهر % % PageV01P293 البحر : - 1(@)(@@) % أتى الدهر من حيث لا أتقي % % وخان من السبب الأوثق % % 2(@)(@@) % مضى بأبي الفضل شطر الحياة % % وما مر أنفس مما بقي % % 3(@)(@@) % فقل للحوادث من بعده % % أسفي بمن شئت أو حلقي % % 4(@)(@@) % أمنتك لم يبق لي من أخاف % % عليه الحمام ولا أتقي % % 5(@)(@@) % وقد كنت أشفق مما دهاه % وقد سكنت لوعة المشفق % % 6(@)(@@) % ولما قضى دون أترابه % % تيقنت أن الردى ينتقي % % 7(@)(@@) % مضى حين ودع در الرضاع % % لدر التفصح في المنطق % % 8(@)(@@) % وهز اليراع أنابيبه % وهنئ بالكاتب المفلق % % 9(@)(@@) % وقيل سيشرف هذا الغلام % وقالت مخايله أخلق % % 10(@)(@@) % كأن اللثام على وجهه % % هلال على كوكب مشرق % PageV01P294 11(@)(@@) % وما النوم إلا التقاء الجفون % % فكيف أنام وما تلتقي % % 12(@)(@@) % يعز على حاسدي أنني % % إذا طرق الخطب لم أطرق % % 13(@)(@@) % وإني طود إذا صادفت % % ه رياح الحوادث لم يقلق % % PageV01P295 
