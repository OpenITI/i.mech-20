ms228	 تصویر مانی %~% شده منسوخ از آن تمثال آذر(@)(@@) 46 دژم گشته ز رویش روی لاله %~% خجل مانده ز چشمش چشم عبهر(@)(@@) 47 فراق تو بخواهد گستریدن %~% ز خار و آتشم بالین و بستر(@)(@@) 48 هوای تو به من برکرد خواهد %~% زمانه مظلم و آفاق مغبر(@)(@@) 49 همی در پیش برخواهم گرفتن %~% رهی با سهم دوزخ هول محشر(@)(@@) 50 کشنده آب او بر کوه شمشیر %~% خلنده خارش اندر خاره نشتر(@)(@@) 51 سمومش گرد کرده آب در حوض %~% سرابش آب کرده سنگ در جر(@)(@@) 52 ز ترس او هوا را دیده گریان %~% ز بیم او شفق را چهره اخضر(@)(@@) 53 قضا را داد خواهم شب طلیعه %~% صبا را کرد خواهم روز رهبر(@)(@@) 54 هژبری بود خواهم آهنین چنگ %~% عقابی گشت خواهم آتشین پر(@)(@@) 55 مگر عبره کنم شبهای بی حد %~% پس پشت افکنم شخ های بی مر(@)(@@) 56 چو کشتی از شکم در پنج دریا %~% برون آیم به پشت خنگ زین ور(@)(@@) 57 برین لاغر تن گردن بریده %~% که از پولاد سفته دارد افسر(@)(@@) 58 مرا جایی همی باید نهادن %~% ز باز و چرغ و شاهین راه یکسر(@)(@@) 59 ازیرا سوی صدر تو ازین پس %~% نباشد قاصد من جز کبوتر(@)(@@) 60 بس آسانست بر تو کز فراقت %~% نگردد آب عیش من مکدر(@)(@@) 61 ولیکن بخت بد کرده ست بر من %~% نهاده طبعت اندک پایه برتر(@)(@@) 62 همی چون از رضای شافی تو %~% در این مدت نصیبم هست کمتر(@)(@@) 63 چنان نالم که بر معشوق عاشق %~% چنان گریم که بر فرزند مادر(@)(@@) 64 ز من گر زخم من گرداندت شاد %~% همان یابی به گوش از زخم مزمر(@)(@@) 65 و گر آتش زنی اندر دل من %~% همان گیری که مغز از دود مجمر(@)(@@) 66 اگر پر زهر گردانی دهانم %~% زبانم گویدت شکری چو شکر(@)(@@) 67 اگر بر فرق من خشمت ببارد %~% چو باران ذره از هر تیغ و خنجر(@)(@@) 68 به حق نعمت تو 
ms229	 گر گشایم %~% دری جز خدمتت بر خویشتن بر(@)(@@) 69 همی تا خامه و ساغر به دستم %~% بود خندان و گریان درد و محضر(@)(@@) 70 مرا در هیچ بزم و هیچ مجلس %~% مرا بر هیچ درج و هیچ دفتر(@)(@@) 71 نخواهد جز به نامت رفت خامه %~% نخواهد جز به یادت گشت ساغر(@)(@@) 72 همی تا هال یابد گوی مرکز %~% همی تا دور دارد چرخ محور(@)(@@) 73 زمین روشن نگردد جز به خورشید %~% عرض قایم نباشد جز به جوهر(@)(@@) 74 نشسته بر سریر عز مربع %~% به فرمان تو گردون مدور(@)(@@) 75 به عشرت بر همه رامش توانا %~% به همت بر همه نهمت مظفر(@)(@@) 76 به رتبت جاه تو گشته مقدم %~% به مدحت عمر تو گشته مؤخر PageV1P148(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بگشاد خون ز چشم من آن یار سیم بر %~% چون بر بسیج رفتن بستم همی کمر(@)(@@) 2 او آفتاب و همچو مطر اشکش و مرا %~% در آفتاب نادره آمد همی مطر(@)(@@) 3 گه روی تافت گاه ببوسید روی من %~% گه بر بکند و گاه گرفت او مرا به بر(@)(@@) 4 گه گفت اگر توانی ایدر مقام کن %~% گه گفت اگر توانی با خود مرا ببر(@)(@@) 5 گفتم که حاجتم به تو افزون کنون از آنک %~% حاجت فزون بود به مه ای ماه در سفر(@)(@@) 6 نه نوگلی و شکر دانم که چاره نیست %~% از آفتاب و باران کس را به راه در(@)(@@) 7 ترسم ز آفتاب فرو پژمری چو گل %~% بگدازی ای نگار ز باران تو چون شکر(@)(@@) 8 و ایدر مقام کردن دانی که چاره نیست %~% چون داد روی سوی سفر نازش بشر(@)(@@) 9 بدرود کردم او را وز وی جدا شدم %~% در پیش برگرفتم راهی پر از عبر(@)(@@) 10 در بیشه ای فتادم کاندر زمین او %~% مالیده خون جانوران و بریده سر(@)(@@) 11 نه ز انبهی تواند آمد به گوش بانگ %~% نه ز دیدگان تواند رفتن برون نظر(@)(@@) 12 چون سرگذشت 
ms230	 مجنون پر فتنه و بلا %~% چون داستان وامق پرآفت و خطر(@)(@@) 13 زان آمدم شگفت که از بس بلا و شور %~% در وی چگونه یارد رستن همی شجر(@)(@@) 14 شد بسته مرکبان را دم از برای آن %~% کامد به گوش ایشان آواز شیر نر(@)(@@) 15 آمد برون ز بیشه یکی زرد و سرخ چشم %~% لاغر میان و اندک دنبال و پهن سر(@)(@@) 16 رویش چراست زرد نترسیده او ز کس %~% چشمش چراست سرخ نبودش شبی سهر(@)(@@) 17 می جست همچو تیر و دو چشمش همی نمود %~% مانند کوکب سپر از روی چون سپر(@)(@@) 18 مانند آفتاب همی رفت و بر زمین %~% همچون مجره پیدا از پنجه هاش اثر(@)(@@) 19 از سهم روی و بانگ نخیز و گریز او %~% هر زنده چشم و گوش همی داشت کور و کر(@)(@@) 20 آنجا که قصد کرد بسان قضاش دید %~% وانچش مراد بود بیامدش چون قدر(@)(@@) 21 آتش نهاد و خیره بود در میان آب %~% خورشید رنگ و تیره از او جان جانور(@)(@@) 22 ماننده خور است همیشه به طبع گرم %~% آری شگفت می نبود گرم طبع خور(@)(@@) 23 از بهر چیست تارک جوشان و ترش روی %~% چون یافته است دانم بر جانور ظفر(@)(@@) 24 در سهم و جنگ داند رفتن همی چو تیر %~% وز بد چو تیغ کرد نداند همی حذر(@)(@@) 25 هست او قوی دل و جگرآور ز بهر آنک %~% باشد طعام او همه ساله دل و جگر(@)(@@) 26 گشت او دلیر و نامور از بهر آنکه او %~% بسیار برد جان دلیران نامور(@)(@@) 27 خورشید رنگ و فعل شهابست بهر آنک %~% در مرغزار چون فلک او را بود ممر(@)(@@) 28 گفتم که یارب او را بگمار و چیره کن %~% بر دشمنان صاحب کافی پر هنر(@)(@@) 29 منصوربن سعید بن احمد که در جهان %~% چون فضل نامور شد و چون جود مشتهر(@)(@@) 30 گر طول و عرض همت او را داردی سپهر %~% خورشید 
