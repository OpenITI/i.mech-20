ms21	 الدهر في كل ساعة % له عارض فيه المنية تلمع % 4(@)(@@) % أيا باني الدنيا لغيرك تبتني % % ويا جامع الدنيا لغيرك تجمع % 5(@)(@@) % أرى المرء وثابا على كل فرصة % وللمرء يوما لا محالة مصرع % 6(@)(@@) % تبارك من لا يملك الملك غيره % متى تنقضي حاجات من ليس يشبع % 7(@)(@@) % أي امرىء في غاية ليس نفسه % إلى غاية أخرى ، سواها ، تطلع % PageV01P093 البحر : كامل تام 1(@)(@@) % أجل الفتى مما يؤمل أسرع % وأراه يجمع دائبا لا يشبع % 2(@)(@@) % قل لي لمن اصبحت تجمع ما أرى % % البعل عرسك لا أبا لك تجمع % 3(@)(@@) % لا تنظرن إلى الهوى ، وانظر إلى % % ريب الزمان بأهله ما يصنع % 4(@)(@@) % الموت حق لا محالة دونه % ولكل موت علة لا تدفع % 5(@)(@@) % الموت داء ليس يدفعه الدوا % % ء إذا أتى ولكل جنب مصرع % 6(@)(@@) % كم من أخي حيل دون لقائه ، % قلبي إليه ، من الجوانح ، منزع % 7(@)(@@) % وإذا كبرت فهل لنفسك لذة % ما للكبير بلذة متمتع % 8(@)(@@) % وإذا قنعت فأنت أغنى من غني % % إن الفقير لكل من لا يقنع % 9(@)(@@) % وإذا طلبت فلا إلى متضايق % من ضاق عنك فرزق ربك أوسع % 10(@)(@@) % إن المطامع ما علمت مزلة % للطامعين ، وأين من لا يطمع % PageV01P094 11(@)(@@) % إقنع ولا تنكر لربك قدرة ، % فالله يخفض من يشاء ، ويرفع % 12(@)(@@) % ولربما انتفع الفتى بضرار من % ينوي الضرار ، وضره من ينفع % 13(@)(@@) % لا شيء أسرع من تقلب من له % % أذن تسمعه الذي لا يسمع % 14(@)(@@) % كل امريء متفرد بطباعه % ليس امروء إلا على ما يطبع % PageV01P095 البحر : بسيط تام 1(@)(@@) % خذ من يقينك ما تجلو الظنون به ، % وإن بدا لك أمر مشكل فدع % 2(@)(@@) % قد يصبح المرء فيما ليس يدركه % مملق البال بين اليأس والطمع % 3(@)(@@) % لم يعمل الناس في التصحيح بينهم ، % فاضطر بعضهم بعضا إلى الخدع % PageV01P096 البحر : طويل 1(@)(@@) % لعمري لقد نوديت لو كنت تسمع ؛ % ألم تر أن الموت ما ليس يدفع % 2(@)(@@) % ألم تر أن الناس في غفلاتهم % ألم تر أسباب الأمور تقطع % 3(@)(@@) % ألم تر لذات الجديد إلى البلى 
ms22	 ؛ % ألم تر أسباب الحمام تشيع % 4(@)(@@) % ألم تر أن الفقر يعقبه الغنى % % ألم تر أن الضيق قد يتوسع % 5(@)(@@) % ألم تر أن الموت يهتر شبيبة % وأن رماح الموت نحوك تشرع % 6(@)(@@) % ألم تر أن المرء يشبع بطنه % وناظره فيما ترى ليس يشبع % 7(@)(@@) % أيا باني الدنيا لغيرك تبتني % % ويا جامع الدنيا لغيرك تجمع % 8(@)(@@) % ألم تر أن المرء يحبس ماله % ووارثه فيه ، غدا ، يتمتع % 9(@)(@@) % كأن الحماة المشفقين عليك قد % % غدوا بك أو راحوا رواحا فأبرعوا % % 10(@)(@@) % وما هو إلا النعش لو قد دعوا به % تقل ، فتلقى فوقه ثم ترفع % PageV01P097 11(@)(@@) % وما هو إلا حادث بعد حادث % فمن أي أنواع الحوادث تجزع % 12(@)(@@) % ألا ، وإذا أودعت توديع هالك ، % فآخر يوم منك يوم تودع % 13(@)(@@) % ألا وكما شيعت يوما جنازة ، % فأنت كما شيعتهم ستشيع % 14(@)(@@) % رأيتك في الدنيا على ثقة بها ، % وإنك في الدنيا لأنت المروع % 15(@)(@@) % ولم تعن بالأمر الذي هو واقع % وكل امرىء يعنى بما يتوقع % 16(@)(@@) % وإنك للمنقوض في كل حالة % وإن بني الدنيا على النقض يطبعوا % % 17(@)(@@) % إذا لم يضق قول عليك ، فقل به ، % وإن ضاق عنك القول فالصمت أوسع % 18(@)(@@) % فلا تحتقر شيئا تصاغرت قدره ، % فإن حقيرا قد يضر وينفع % 19(@)(@@) % تقلبت في الدنيا تقلب أهلها % % وذو المال فيها حيث ما مال يتبع % 20(@)(@@) % وما زلت أرمى كل يوم بعبرة % تكاد لها صم الجبال تصدع % PageV01P098 21(@)(@@) % فما بال عيني لا تجود بمائها % % وما بال قلبي لا يرق ويخشع % 22(@)(@@) % تبارك من لا يملك الملك غيره % متى تنقضي حاجات من ليس يقنع % 23(@)(@@) % وأي تمرىء في غاية ، ليس نفسه % % إلى غاية أخرى ، سواها ، تطلع % 24(@)(@@) % وبعض بني الدنيا لبعض ذريعة ، % وكل بكل قلما يتمتع % 25(@)(@@) % يحب السعيد العدل عند احتجاجه % ويبغي الشقي البغي والبغي يصرع % 26(@)(@@) % ولم أر مثل الحق أقوى لحجة % يد الحق ، بين العلم والجهل ، تقرع % 27(@)(@@) % وذو الفضل لا يهتز إن هزه الغنى % % لفخر ولا إن عضه الدهر يفزع % PageV01P099 البحر : منسرح 1(@)(@@) % ألحرص لؤم 
ms23	 ، ومثله الطمع ، % ما اجتمع الحرص قط والورع % 2(@)(@@) % لو قنع الناس بالكفاف إذا % لا تسعوا في الذي به قنعوا % % 3(@)(@@) % للمرء فيما يقيمه سعة ، % لكنه ما يريد ما يسع % 4(@)(@@) % يا حالب الدهر در أشطره ! % هل لك فيما حلبت منتفع ؟ % 5(@)(@@) % يا عجبا لامرىء تخادعه ال % % الساعات عن نفسه فينخدع % 6(@)(@@) % يا عجبا للزمان ، يأمنه % من قد يرى الصخر عنه ينصدع % 7(@)(@@) % عجبت من آمن بمنزلة % يكثر فيها الأمراض والوجع % 8(@)(@@) % عجبت من جهل قوم قد عرفوا % % الحق فولوا عنه وما رجعوا % % 9(@)(@@) % الناس في زرع نسلهم ويد ال % % الموت بها حصد كل ما زرعوا % % 10(@)(@@) % ما شرف المرء كالقناعة والصب % ر ، على كل حادث يقع % PageV01P100 11(@)(@@) % لم يزل القانعون أشرفنا % % يا حبذا القانعون ما قنعوا % % 12(@)(@@) % للمرء في كل طرفة حدث % يذهب منه ما ليس يرتجع % 13(@)(@@) % من ضاق بالصبر عن مصيبته % ضاق ولم يتسع لها الجزع % 14(@)(@@) % الشمس تنعاك حين تغرب لو % تدري وتنعاك حين تطلع % 15(@)(@@) % حتى متى أنت لاعب أشر % حتى متى أنت بالصبا ولع % 16(@)(@@) % إن الملوك الأولى مضوا سلفا % بادوا جميعا ، وما باد ما جمعوا % % 17(@)(@@) % يا ليت شعري عن الذين مضوا % % قبلي إلى الترب ، ما الذي صنعوا % % 18(@)(@@) % بؤسا لهم أي منزل نزلوا % % بؤسا لهم ، أي موقع وقعوا % % 19(@)(@@) % الحمد لله ! كل من سكن ال % % الدنيا فعنها بالموت ينقطع % PageV01P101 البحر : كامل تام 1(@)(@@) % إياك أعني يا ابن آدم فاستمع % ودع الركون إلى الحياة فتنتفع % 2(@)(@@) % لو كان عمرك ألف حول كامل % لم تذهب الأيام حتى تنقطع % 3(@)(@@) % إن المنية لا تزال ملحة ، % حتى تشتت كل أمر مجتمع % 4(@)(@@) % فاجعل لنفسك عدة للقاء من % لو قد أتاك رسوله لم تمتنع % 5(@)(@@) % شغل الخلائق بالحياة ، وأغفلوا % % زمنا ، حوادثه عليهم تقترع % 6(@)(@@) % ذهبت بنا الدنيا ، فكيف تغرنا ، % أم كيف تخدع من تشاء فينخدع % 7(@)(@@) % والمرء يوطنها ، ويعلم أنه % عنها إلى وطن سواها منقلع % 8(@)(@@) % لم تقبل الدنيا على أحد بريتها % % فمل من الحياة ولا شبع % 9 
ms24	(@)(@@) % يا أيها المرء المضيع دينه ، % إحراز دينك خير شيء تصطنع % 10(@)(@@) % نتها ، فمل من الحياة ولا شبع % فاعمل فما كلفت ما لا تستطع % PageV01P102 11(@)(@@) % والحق أفضل ما قصدت سبيله ، % والله أكرم من تزور وتنتجع % 12(@)(@@) % فامهد لنفسك صالحا تجزى به ، % وانظر لنفسك أي أمر تتبع % 13(@)(@@) % واجعل صديقك من وفى لصديقه ، % واجعل رفيقك ، حين تسقط ، من سرع % 14(@)(@@) % وامنع فؤادك أن يميل بك الهوى % % واشدد يديك بحبل دينك والورع % 15(@)(@@) % واعلم بأن جميع ما قدمته % عند الإله ، موفر لك لم يضع % 16(@)(@@) % طوبى لمن رزق القنوع ، ولم يرد % ما كان في يد غيره ، فيرى ضرع % 17(@)(@@) % ولئن طمعت لتصرعن ، فلا تكن % طمعا ، فإن الحر عبد ما طمع % 18(@)(@@) % إنا لنلقى المرء تشره نفسه % فيضيق عنه كل أمر متسع % 19(@)(@@) % والمرء يمنع ما لديه ، ويبتغي % % ما عند صاحبه ، ويغضب إن منع % 20(@)(@@) % ما ضر من جعل التراب فراشه % ألا ينام على الحرير ، إذا قنع % PageV01P103 البحر : طويل 1(@)(@@) % هو الموت ، فاصنع كل ما أنت صانع ، % وأنت لكأس الموت لا بد جارع % 2(@)(@@) % ألا أيها المرء المخادع نفسه ! % رويدا أتدري من أراك تخادع % 3(@)(@@) % ويا جامع الدنيا لغير بلاغه % ستتركها فانظر لمن أنت جامع % 4(@)(@@) % وكم قد رأينا الجامعين قد اصبحت % لهم ، بين أطباق التراب مضاجع % 5(@)(@@) % لو أن ذوي الأبصار يرعون كلما % % يرون ، لما جفت لعين مدامع % 6(@)(@@) % فما يعرف العطشان من طال ريه ، % وما يعرف الشبعان من هو جائع % 7(@)(@@) % وصارت بطون المرملات خميصة ، % وأيتامهم منهم طريد وجائع % 8(@)(@@) % وإن بطون المكثرات كأنما % % تنقنق في أجوافهن الضفادع % 9(@)(@@) % وتصريف هذا الخلق لله وحده % وكل إليه ، لا محالة ، راجع % 10(@)(@@) % ولله في الدنيا أعاجيب جمة % تدل على تدبيره ، وبدائع % PageV01P104 11(@)(@@) % ولله في أسرار الأمور وإن جرت % بها ظاهرا ، بين العباد ، المنافع % 12(@)(@@) % ولله أحكام القضاء بعلمه % ألا فهو معط ما يشاء ومانع % 13(@)(@@) % إذا ضن من ترجو عليك بنفعه ، % فذره ، فإن الرزق ، في الأرض ، واسع % 14(@)(@@) % ومن كانت الدنيا هواه وهمه ، % سبته 
ms25	 المنى واستعبدته المطامع % 15(@)(@@) % ومن عقل استحيا ، وأكرم نفسه ، % ومن قنع استغنى فهل أنت قانع % 16(@)(@@) % لكل امرىء رأيان رأي يكفه % عن الشيء ، أحيانا ، ورأي ينازع % PageV01P105 البحر : رمل تام 1(@)(@@) % خير أيام الفتى يوم نفع % واصطناع الخير أبقى ما صنع % 2(@)(@@) % ونظير المرء ، في معروفه ، % شافع بت إليه فشفع % 3(@)(@@) % ما ينال الخير بالشر ولا % يحصد الزارع إلا ما زرع % 4(@)(@@) % ليس كل الدهر يوما واحدا % ربما ضاق الفتى ثم اتسع % 5(@)(@@) % خذ من الدنيا الذي درت به ، % واسل عما بان منها ، وانقطع % 6(@)(@@) % إنما الدنيا متاع زائل ، % فاقتصد فيه وخذ منه ودع % 7(@)(@@) % وارض للناس بما ترضى به ، % واتبع الحق فنعم المتبع % 8(@)(@@) % وابغ ما اسطعت عن الناس الغنى ، % فمن احتاج إلى الناس ضرع % 9(@)(@@) % اشهد الجامع لو أن قد أتى % % يومه لم يغن عنه ما جمع % 10(@)(@@) % إن للخير لرسما بيننا ، % طبع الله عليه ما طبع % PageV01P106 11(@)(@@) % قد بلونا الناس في أخلاقهم % فرأيناهم لذي المال تبع % 12(@)(@@) % وحبيب الناس من أطمعهم ، % إنما الناس جميعا بالطمع % 13(@)(@@) % احمد الله على تدبيره % قدر الرزق فعطى ومنع % 14(@)(@@) % سمت نفسي ورعا تصدقه ، % فنهاها النقص عن ذاك الورع % 15(@)(@@) % ولنفسي حين تعطى فرح ، % واضطراب عند منع وجزع % 16(@)(@@) % ولنفسي غفلات لم تزل ، % ولها بالشيء ، أحيانا ، ولع % 17(@)(@@) % عجبا من مطمئن آمن % إنما يغذى بألوان الفزع % 18(@)(@@) % عجبا للناس ما أغفلهم % لوقوع الموت عما سيقع % 19(@)(@@) % عجبا إنا لنلقى مرتعا % كلنا قد عاث فيه ورتع % 20(@)(@@) % يا أخي الميت الذي شيعته % فحثي الترب عليه ورجع % PageV01P107 21(@)(@@) % ليت شعري ما تزودت من ال % % زاد ، يا هذا ، لهول المطلع % 22(@)(@@) % يوم يهدوك محبوك إلى % % ظلمة القبر وضيق المضطجع % PageV01P108 البحر : خفيف تام 1(@)(@@) % أيها المبصر ، الصحيح ، السميع ، % أنت باللهو والهوى مخدوع % 2(@)(@@) % كيف يعمى عن السبيل بصير % عجبا ذا ، أو يستصم سميع % 3(@)(@@) % ما لنا نستطيع أن نجمع الما % % ل ، ورد الممات لا نستطيع % 4(@)(@@) % حبب الأكل والشراب إلينا % % وبناء القصور والتجميع % 5(@)(@@) % وصنوف اللذات من 
ms26	 كل لون ، % والفنا مقبل إلينا سريع % 6(@)(@@) % ليس ينجو من الفنا فاجر لبت % ولا السفلة الدني الوضيع % 7(@)(@@) % كل حي سيطعم الموت كرها % ثم خلف الممات يوم فظيع % 8(@)(@@) % كيف نلهو أو كيف نسلو من العي % % هو منا مرجع منزوع % 9(@)(@@) % نجمع الفاني والقليل من الما % % ل وننسى الذي إليه الرجوع % 10(@)(@@) % في مقام ، تعشى العيون إليه ، % والملوك العظام فيه خضوع % PageV01P109 البحر : رمل تام 1(@)(@@) % ربما ضاق الفتى ثم اتسع ، % وأخو الدنيا على النقص طبع % 2(@)(@@) % إن من يطمع في كل منى % % أطمعته النفس فيه لطمع % 3(@)(@@) % للتقى عاقبة محمودة % والتقي المحض من كان يرع % 4(@)(@@) % وقنوع المرء يحمي عرضه % ما القرير العين إلا من قنع % PageV01P110 البحر : بسيط تام 1(@)(@@) % ما بال نفسك بالآمال منخدعه % وما لها لا ترعى بالوعظ منتفعه % 2(@)(@@) % أما سمعت بمن أضحى له سبب ، % إلى النجاة ، بحرف واحد سمعه % PageV01P111 البحر : خفيف تام 1(@)(@@) % أي عيش يكون أبلغ من عي % ش كفاف ، قوت ، بقدر البلاغ % 2(@)(@@) % صاحب البغي ليس يسلم منه % وعلى نفسه بغى كل باغ % 3(@)(@@) % رب ذي نعمة تعرض منها % % حائل بينه ، وبين المساغ % 4(@)(@@) % أبلغ الدهر في مواعظه بل % زاد فيهن لي على الإبلاغ % 5(@)(@@) % غبنتني الأيام عقلي ، ومالي ، % وشبابي ، وصحتي ، وفراغي % % PageV01P112 البحر : كامل تام 1(@)(@@) % لله در أبيك أية ليلة % مخضت صبيحتها بيوم الموقف % 2(@)(@@) % لو أن عينا شاهدت ، من نفسها ، % يوم الحساب ، تمثلا لم تطرف % PageV01P113 البحر : بسيط تام 1(@)(@@) % إن كان لا بد من موت فما كلفي % % وما عنائي بما يدعو إلى الكلف % 2(@)(@@) % لا شيء للمرء أغنى من قناعته % ولا امتلاء لعين الملتهي الطرف % 3(@)(@@) % من فارق القصد لم يأمن عليه هوى % يدعو إلى البغي والعدوان والسرف % 4(@)(@@) % ما كل رأي الفتى يدعو إلى رشد % إذا بدا لك رأي مشكل فقف % 5(@)(@@) % أخي ! ما سكنت ريح ولا عصفت ، % إلا لتؤذن بالنقصان والتلف % 6(@)(@@) % ما أقرب الحين ممن لم يزل بطرا % ولم تزل نفسه توفي على شرف % 7(@)(@@) % كم من عزيز عظيم 
ms27	 الشأن في جدث % مجدل ، بتراب الأرض ملتحف % 8(@)(@@) % لله أهل قبور كنت أعهدهم % أهل القباب الرخاميات ، والغرف % 9(@)(@@) % يا من تشرف بالدنيا وزينتها ، % حسب الفتى بتقى الرحمان من شرف % 10(@)(@@) % والخير والشر في التصوير بينهما % % لو صورا لك ، بون غير مؤتلف % PageV01P114 11(@)(@@) % أخي آخ المصفى ما استطعت ولا % تستعذبن مؤاخاة الأخ النطف % 12(@)(@@) % ما أحرز المرء من أطرافه طرفا ، % إلا تخونه النقصان من طرف % 13(@)(@@) % والله يكفيك إن أنت اعتصمت به ، % من يصرف الله عنه السوء ينصرف % 14(@)(@@) % الحمد لله ، شكرا ، لا مثيل له ، % ما قيل شيء بمثل اللين واللطف % PageV01P115 البحر : طويل 1(@)(@@) % متى تتقضى حاجة المتكلف ، متى تتقضى حاجة المتكلف ، % ولا سيما من مترف النفس مسرف % 2(@)(@@) % طلبت الغنى في كل وجه فلم أجد % سبيل الغنى ، إلا سبيل التعفف % 3(@)(@@) % إذا كنت لا ترضى بشيء تناله % وكنت على ما فات حم التلهف % 4(@)(@@) % فلست من الهم العريض بخارج ، % ولست من الغيظ الطويل بمشتف % 5(@)(@@) % أراني بنفسي معجبا متعززا % كأني على الآفات لست بمشرف % 6(@)(@@) % وإني لعين البائس الواهن القوى ، % وعين الضعيف البائس المتطرف % 7(@)(@@) % وليس امرو لم يرع منك بجهده % جميع الذي ترعاه منه ، بمنصف % 8(@)(@@) % خليلي ما أكفى اليسير من الذي % % نحاول ، إن كنا بما عف نكتفي % % 9(@)(@@) % وما أكرم العبد الحريص على الندى ، % وأشرف نفس الصابر المتعفف % PageV01P116 البحر : بسيط تام 1(@)(@@) % الله كاف فما لي دونه كاف % على اعتدائي على نفسي وإسرافي % % 2(@)(@@) % تشرف الناس بالدنيا وقد غرقوا % % فيها فكل على أمواجها طاف % 3(@)(@@) % هم العبيد لدار قلب صاحبها ، % ما عاش ، منها على خوف وإيجاف % 4(@)(@@) % حسب الفتى بتقى الرحمان من شرف % وما عبيدك ، يا دنيا ، بأشراف % 5(@)(@@) % يا دار ! كم قد رأينا فيك من أثر ، % ينعى الملوك إلينا ، دارس ، عاف % 6(@)(@@) % أودى الزمان بأسلافي ، وخلفني ، % وسوف يلحقني يوما بأسلافي % % 7(@)(@@) % كأننا قد توافينا بأجمعنا % % في بطن ظهر عليه مدرج السافي % % 8(@)(@@) % أخي ! عندي من الأيام تجربة ، % فيما أظن وعلم بارع شاف % 9(@)(@@) % لا تمش في الناس 
ms28	 إلا رحمة لهم % ولا تعاملهم إلا بإنصاف % 10(@)(@@) % واقطع قوى كل حقد أنت مضمره % إن زال ذو زلة ، أو إن هفا هاف % PageV01P117 11(@)(@@) % وارغب بنفسك عما لا صلاح له ، % وأوسع الناس من بر ، وإلطاف % 12(@)(@@) % وإن يكن أحد أولاك صالحة % فكافه فوق ما أولى بأضعاف % 13(@)(@@) % ولا تكشف مسيئا عن إساءته % وصل حبال أخيك القاطع ، الجافي % % 14(@)(@@) % فتستحق من الدنيا سلامتها % % وتستقل بعرض وافر ، واف % 15(@)(@@) % ما أحسن الشغل في تدبير منفعة ، % أهل الفراغ ذوو خوض وإرجاف % PageV01P118 البحر : مجزوء الوافر 1(@)(@@) % ألا أين الألى سلفوا ، % دعوا للموت واختطفوا % % 2(@)(@@) % فوافوا حين لا تحف ، % ولا طرف ولا لطف % 3(@)(@@) % ترص عليهم حفر % وتبنى ثم تنخسف % 4(@)(@@) % لهم من تربها فرش % ومن رضراضها لحف % 5(@)(@@) % تقطع منهم سبب ال % % الرجاء فضيعوا وجفوا % % 6(@)(@@) % تمر بعسكر الموتى ، % وقلبك منه لا يجف % 7(@)(@@) % كأن مشيعيك ، وقد % رموابك ، ثم ، وانصرفوا % % 8(@)(@@) % فنون رداك ، يا دنيا ، % لعمري فوق ما أصف % 9(@)(@@) % فأنت الدار فيك الظلم % م ، والعدوان ، والسرف % 10(@)(@@) % وأنت الدار فيك الهم % والأحزان والأسف % PageV01P119 11(@)(@@) % وأنت الدار فيك الغد % ر ، والتنغيص ، والكلف % 12(@)(@@) % وفيك الحبل مضطرب ؛ % وفيك البال منكسف % 13(@)(@@) % وفيك لساكنيك الغبن % والآفات والتلف % 14(@)(@@) % وملكك فيهه دول ، % بها الأقدار تختلف % 15(@)(@@) % كأنك بينهم كرة % ترامى ثم تلتقف % 16(@)(@@) % ترى الأيام لا ينظر % ن والساعات لا تقف % 17(@)(@@) % ولن يبقى لأهل الأر % ض لا عز ، ولا شرف % 18(@)(@@) % وكل دائم الغفلا % % ت والأنفاس تختطف % 19(@)(@@) % وأي الناس إلا مو % قن بالموت معترف % 20(@)(@@) % وخلق الله مشتبه ، % وسعي الناس مختلف % PageV01P120 21(@)(@@) % وما الدنيا بباقية % ستنزح ثم تنتسف % 22(@)(@@) % وقول الله ذاك لنا % % وليس لقوله خلف % PageV01P121 البحر : طويل 1(@)(@@) % أتبكي لهذا الموت أم أنت عارف % بمنزلة تبقى وفيها المتالف % 2(@)(@@) % كأنك قد غيبت في اللحد والثرى ، % فتلقى كما لاقى القرون السوالف % 3(@)(@@) % أرى الموت قد أفنى القرون التي مضت % فلم يبق ذو إلف ولم يبق آلف % 4(@)(@@) % كأن الفتى لم يفن في الناس ساعة % إذا أعصبت 
ms29	 يوما عليه اللفائف % 5(@)(@@) % وقامت عليه عصبة يندبونه ، % فمستعبر يبكي وآخر هاتف % 6(@)(@@) % وغودر في لحد ، كريه حلوله ، % وتعقد من لبن عليه السقائف % 7(@)(@@) % يقل الغنا عن صاحب اللحد والثرى % % بما ذرفت فيه العيون الذوارف % 8(@)(@@) % وما من يخاف البعث والنار آمن ، % ولكن حزين موجع القلب خائف % 9(@)(@@) % إذا عن ذكر الموت أوجع قلبه % وهيج ، أحزانا ، ذنوب سوالف % 10(@)(@@) % وأعلم غير الظن أن ليس بالغا % أعاجيب ما يلقى من الناس ، واصف % PageV01P122 البحر : سريع 1(@)(@@) % تزيده الأيام إن أقبلت % شدة خوف لتصاريفها % % 2(@)(@@) % كأنها في حال إسعافها % % تسمعه أوقات تخويفها % % PageV01P123 البحر : طويل 1(@)(@@) % ألم تر هذا الموت يستعرض الخلقا % % ترى أحدا يبقى فتطمع أن تبقى % % 2(@)(@@) % لكل امرىء حي من الموت خطة % يصير إليا حين يستكمل الرزقا % % 3(@)(@@) % تزود من الدنيا ، فإنك شاخص % إلى المنتهى واجعل مطيتك الصدقا % % 4(@)(@@) % فأمسك من الدنيا الكفاف ، وجد على % % أخيك ، وخذ بالرفق ، واجتنب الخرقا % % 5(@)(@@) % فإني رأيت المرء يحرم حظه % من الدين والدنيا ، إذا حرم الرفقا % % 6(@)(@@) % ولا تجعلن الحمد إلا لأهله ، % ولا تدع الإمساك بالعروة الوثقى % % 7(@)(@@) % ولا خير فيمن لا يؤاسي بفضله % ولا خير فيمن لا يرى وجهه طلقا % % 8(@)(@@) % وليس الفتى في فضله بمقصر % إذا ما اتقى الرحمان ، واتبع الحقا % % PageV01P124 البحر : منسرح 1(@)(@@) % ما أغفل الناس والخطوب بهم % % في خبب مرة ، وفي عنق % 2(@)(@@) % وفي فناء الملوك معتبر % كفى به حجة على السوق % PageV01P125 البحر : طويل 1(@)(@@) % طلبت أخا في الله في الغرب والشرق % فأعوزني هذا ، على كثرة الخلق % 2(@)(@@) % فصرت وحيدا بينهم ، متصبرا ، % على الغدر منهم ، والملالة والمذق % 3(@)(@@) % أرى من بها يقضي علي لنفسه % ولم أر من يرعى علي ولا يبقي % % 4(@)(@@) % وكم من أخ قد ذقته ذا بشاشة % إذا ساغ في عيني يغص به حلقي % % 5(@)(@@) % ولم أر كالدنيا ، وكشفي لأهلها ، % فما انكشفوا لي عن وفاء ولا صدق % 6(@)(@@) % ولم أر أمرا واحدا من أمورها % % أعز ، ولا أعلى من الصبر للحق % PageV01P126 البحر : خفيف تام 1(@)(@@) % قطع الموت كل عقد وثيق 
ms30	 ، % ليس للميت بعده من صديق % 2(@)(@@) % من يمت يعدم النصيحة والإش % % فاق من كل ناصح ، وشفيق % 3(@)(@@) % نزل الساكن الثرى من ذوي % % طاف في المنزل البعيد السحيق % 4(@)(@@) % كل أهل الدنيا تعوم على الغف % منها في غمر بحر عميق % 5(@)(@@) % يتبارون في السباح فهم من % بين ناج منهم ، وبين غريق % 6(@)(@@) % والتماسي لما أطالب منها % % لم أكن ، لالتماسه ، بحقيق % PageV01P127 البحر : مديد تام 1(@)(@@) % عامل الناس برأي رفيق % والق من تلقى بوجه طليق % 2(@)(@@) % فإذا أنت جميل الثناء % وإذا أنت كثير الصديق % PageV01P128 البحر : رمل تام 1(@)(@@) % داو بالرفق جراحات الخرق % وابل قبل الذم قبل الذم والحمد وذق % 2(@)(@@) % وسع الناس بخلق حسن ، % لم يضق شيء على حسن الخلق % 3(@)(@@) % كل من لم تتسع أخلاقه ، % بعد إحسان إليه ينسحق % 4(@)(@@) % كم ترانا يا أخي نبقى على % % جولان الموت في هذا الأفق % 5(@)(@@) % نحن أرسال إلى دار البلى % % نتوالى عنقا ، بعد عنق % PageV01P129 البحر : بسيط تام 1(@)(@@) % الرفق يبلغ ما لا يبلغ الخرق ، % وقل في الناس من يصفو له خلق % 2(@)(@@) % لم يفلق المرء عن رشد فيتركه % إلا دعاه إلى ما يكره الفلق % 3(@)(@@) % الباطل ، الدهر ، يلفى لا ضياء له ، % والحق أبلج فيه النور يأتلق % 4(@)(@@) % متى يفيق حريص دائب أبدا ، % والحرص داء له تحت الحشا قلق % 5(@)(@@) % يستغنم الناس من قوم فوائدهم % وإنما هي في أعناقهم ربق % 6(@)(@@) % فيجهد الناس ، في الدنيا ، منافسة ، % وليس للناس شيء غير ما رزقوا % % 7(@)(@@) % يا من بنى القصر في الدنيا ، وشيده ، % أسست قصرك حيث السيل والغرق % 8(@)(@@) % لا تغفلن ، فإن الدار فانية ، % وشربها غصص أو صفوها رنق % 9(@)(@@) % والموت حوض كريه أنت وارده % فانظر لنفسك قبل الموت يا مذق % 10(@)(@@) % اسم العزيز ذليل عند ميتته ؛ % واسم الجديد ، بعيد الجدة ، الخلق % PageV01P130 11(@)(@@) % يبلى الشباب ، ويفني الشيب نضرته ، % كما تساقط ، عن عيدانها ، الورق % 12(@)(@@) % ما لي أراك ، وما تنفك من طمع ، % يمتد منك إليه الطرف ، والعنق % 13(@)(@@) % تذم دنياك ذما لا تبوح به ، % إلا وأنت لها في ذاك معتنق 
ms31	 % 14(@)(@@) % فلو عقلت لأعددت الجهاز لها ، % بعد الرحيل بها ما دام لي رمق % 15(@)(@@) % إذا نظرت من الدنيا إلى صور ، % تخيلت لك يوما فوقها الخرق % 16(@)(@@) % ما نحن إلا كركب ضمه سفر % يوما ، إلى ظل في ثمت افترقوا % % 17(@)(@@) % ولا يقيم على الأسلاف غابرهم ، % كأنهم بهم من بعدهم لحقوا % % 18(@)(@@) % ما هب أو دب يفنى لا بقاء له % والبر ، والبحر ، والأقطار ، والأفق % 19(@)(@@) % نستوطن الأرض دارا للغرور بها % % وكلنا راحل عنها ، ومنطلق % 20(@)(@@) % لقد رأيت ، وما عيني براقدة ، % قتلى الحوادث بين الخلق تخترق % PageV01P131 21(@)(@@) % كم من عزيز أذل الموت مصرعه % كانت ، على رأسه ، الرايات تختفق % 22(@)(@@) % كل امرء وله رزق سيبلغه % والله يرزق لا كيس ولا حمق % 23(@)(@@) % إذا نظرت إلى دنياك مقبلة ، % فلا يغرنك تعظيم ولا ملق % 24(@)(@@) % أخي إنا لنحن الفائزون غدا % % إن سلم الله من دار لها علق % 25(@)(@@) % فالحمد لله حمدا لا انقطاع له ، % ما إن يعظم إلا من له ورق % 26(@)(@@) % والحمد لله حمدا دائما أبدا % فاز الذين ، إلى ما عنده ، سبقوا % % 27(@)(@@) % ما أغفل الناس عن يوم انبعاثهم % ويوم يلجمهم ، في الموقف ، العرق % PageV01P132 البحر : طويل 1(@)(@@) % ألا إنما الإخوان عند الحقائق ، % ولا خير في ود الصديق المماذق % 2(@)(@@) % لعمرك ما شيء من العيش كله ، % أقر لعيني من صديق موافق % 3(@)(@@) % وكل صديق ليس في الله وده % فإني به ، في وده ، غير واثق % 4(@)(@@) % أحب أخا في الله ما صح دينه ، % وأفرشه ما يشتهي من خلائق % 5(@)(@@) % وأرغب عما فيه ذل دنية ، % وأعلم أن الله ، ما عشت ، رازقي % % 6(@)(@@) % صفي ، من الإخوان ، كل موافق % صبور على ما نابه من بوائق % PageV01P133 البحر : مجزوء الكامل 1(@)(@@) % انظر لنفسك يا شقي % حتى متى لا تتقي % % 2(@)(@@) % أو ما ترى الأيام % تلس النفوس ، وتنتقي % % 3(@)(@@) % انظر بطرفك هل ترى % % في مغرب ، أو مشرق % 4(@)(@@) % أحدا وفى لك في الشدائد % إن لجأت بموثق % 5(@)(@@) % كم من أخ غمضته % بيدي نصيح مشفق % 6(@)(@@) % ويئست منه فلست أط % أن يعيش فنلتقي % % 7 
ms32	(@)(@@) % لا تكذبن ، فإنه % من يجتمع يتفرق % 8(@)(@@) % والموت غاية من مضى % % منا وموعد من بقي % % PageV01P134 البحر : طويل 1(@)(@@) % وما الموت إلا رحلة ، غير أنها % % من المنزل الفاني إلى المنزل الباقي % % PageV01P135 البحر : طويل 1(@)(@@) % أرى الشيء أحيانا بقلبي معلقا % % فلا بد أن يبلى وأن يتمزقا % % 2(@)(@@) % تصرفت أطوارا أرى كل عبرة % وكان الصبا مني جديدا ، فأخلقا % % 3(@)(@@) % وكل امرئ في سعيه الدهر ربما % % يفتح أحيانا له أو يغلقا % % 4(@)(@@) % وما اجتمع الإلفان إلا تفرقا % % وحسب امرىء من رأيه أن يوفقا % % PageV01P136 البحر : طويل 1(@)(@@) % نموت جميعا كلنا ، غير ما شك ، % ولا أحد يبقى سوى مالك الملك % 2(@)(@@) % أيا نفس أنت الدهر في حال غفلة % وليست صروف الدهر غافلة عنك % 3(@)(@@) % أيا نفس كم لي عنك من يوم صرعة % إلى الله أشكو ما أعالجه منك % 4(@)(@@) % أيا نفس إن لم أبك مما أخافه % عليك غدا عند الحساب فمن يبكي % % 5(@)(@@) % أيا نفس هذي الدار لا دار قلعة % فلا تجعلن القصد في منزل الإفك % 6(@)(@@) % أيا نفس لا تنسي عن الله فضله % فتأييده ملكي ، وجذلانه هلكي % % 7(@)(@@) % وليس دبيب الذر فوق الصفاة ، في % % الظلام بأخفى من رياء ولا شرك % PageV01P137 البحر : كامل تام 1(@)(@@) % إن كنت تبصر ما عليك ومالكا % % فانظر لمن تمضي وتترك مالكا % % 2(@)(@@) % ولقد ترى أن الحوادث جمة ، % وترى المنية حيث كنت حيالكا % % 3(@)(@@) % يا إبن آدم كيف ترجو أن يكو % % الرأي رأيك والفعال فعالكا % % PageV01P138 البحر : طويل 1(@)(@@) % كأن المنايا قد قصدن إليكا ، % يردنك فانظر ما لهن لديكا % % 2(@)(@@) % سيأتيك يوم لست فيه بمكرم % بأكثر من حثو التراب عليكا % % PageV01P139 البحر : وافر تام 1(@)(@@) % خذ الدنيا بأيسرها عليكا % % ومل عنها إذا قصدت إليكا % % 2(@)(@@) % فإن جميع ما خولت منها % % ستنفضه جميعا من يديكا % % PageV01P140 البحر : منسرح 1(@)(@@) % المرء مستأسر بما ملكا ، % ومن تعامى عن قدره هلكا % % 2(@)(@@) % من لم يصب من دنياه آخرة ، % فليس منها بمدرك دركا % % 3(@)(@@) % للمرء ما قدمت يداه من ال % % الفضل وللوارثين ما تركا % % 4(@)(@@) % يا سكرة الموت أنت واقعة 
ms33	 % للمرء في أي ا فة سلكا % % 5(@)(@@) % يا سكرة الموت قد نصبت لهذا % % الخلق في كل مسلك شركا % % 6(@)(@@) % أخي إن الخطوب مرصدة % بالموت لا بد منه لي ولكا % % 7(@)(@@) % ما عذر من لم تنم تجاربه % وحنكته الأمور ، فاحتنكا % % 8(@)(@@) % خضت المنى ثم صرت بعد إلى % % مولاك في وحلهن مرتبكا % % 9(@)(@@) % ما أعجب الموت ثم أعجب منه % ه مؤمن ، موقن به ضحكا % % 10(@)(@@) % حن لأهل القبور من ثقتي % % إن حن قلبي إليهم وبكى % % PageV01P141 11(@)(@@) % الحمد لله حيثما زرع ال % % الخير امرء طاب زرعه وزكا % % 12(@)(@@) % لا تجتني الطيبات يوما من % غرس يد كان غرسها الحسكا % % 13(@)(@@) % إن المنايا لا تخطئن ولا % % تبقين لا سوقة ولا ملكا % % 14(@)(@@) % الحمد للخالق الذي حرك ال % % الساكن منا وسكن الحركا % % 15(@)(@@) % وقامت الأرض والسماء به ، % وما دحى منهما وما سمكا % % 16(@)(@@) % وقلب الليل والنهار وصب % رزق صبا ، ودبر الفلكا % % PageV01P142 البحر : مجزوء الوافر 1(@)(@@) % رأيت الفضل متكئا % % يناجي البحر والسمكا % % 2(@)(@@) % فأرسل عينه لما % % رآني مقبلا وبكى % % 3(@)(@@) % فلما أن حلفت له % بأني صائم ضحكا % % PageV01P143 البحر : منسرح 1(@)(@@) % لا رب أرجوه لي سواكا ، % إذ لم يخب سعي من رجاكا % % 2(@)(@@) % أنت الذي لم تزل خفيا % لم يبلغ الوهم منتهاكا % % 3(@)(@@) % إن أنت لم تهدنا ضللنا % % يا رب إن الهدى هداكا % % 4(@)(@@) % أحطت علما بنا جميعا ، % أنت ترانا ولا نراكا % % PageV01P144 البحر : هزج 1(@)(@@) % رأيت الشيب يعروكا % % بأن الموت ينحوكا % % 2(@)(@@) % فخذ حذرك ، يا هذا ، % فإني لست آلوكا % % 3(@)(@@) % ولا تزدد من الدنيا ، % فتزدادن بها نوكا % % 4(@)(@@) % فتقوى الله تغنيك % وإن سميت صعلوكا % % 5(@)(@@) % تناومت عن الموت % وداع الموت يدعوك % 6(@)(@@) % وحاديه ، وإن نمت ، % حثيث السير يحدوكا % % 7(@)(@@) % فلا يومك ينساك ، % ولا رزقك يعدوكا % % 8(@)(@@) % متى ترغب إلى الناس ، % تكن في الناس مملوكا % % 9(@)(@@) % إذا ما أنت خففت % عن الناس أحبوكا % % 10(@)(@@) % وثقلت ملوك % وعابوك ، وسبوكا % % PageV01P145 11(@)(@@) % إذا ما شئت أن تعصى % % فمر من ليس يرجوكا % % 12(@)(@@) % ومر من ليس يخشاك % فيدمى عندها فوكا % % PageV01P146 البحر : منسرح 1 
ms34	(@)(@@) % لا تنس ، واذكر سبيل من هلكا ، % ستسلك المسلك الذي سلكا % % PageV01P147 البحر : بسيط تام 1(@)(@@) % طول التعاشر بين الناس مملول % ما لابن آدم إن فتشت معقول % 2(@)(@@) % للمرء ألوان دنيا : رغبة وهوى ، % وعقله أبدا ما عاش مدخول % 3(@)(@@) % يا راعي النفس لا تغفل رعايتها ، % فأنت عن كل ما استرعيت مسؤول % 4(@)(@@) % خذ ما عرفت ودع ما أنت جاهله % للأمر وجهان : معروف ، ومجهول % 5(@)(@@) % واحذر ، فلست من الأيام منفلتا ، % حتى يغولك من أيامك الغول % 6(@)(@@) % والدائرات بريب الدهر دائرة % والمرء عن نفسه ما عاش مختول % 7(@)(@@) % لن تستتم جميلا أنت فاعله % إلا وأنت طليق الوجه ، بهلول % 8(@)(@@) % ما أوسع الخير فابسط راحتيك به ، % وكن كأنك ، عند الشر ، مغلول % 9(@)(@@) % الحمد لله في آجالنا قصر ، % نبغي البقاء وفي آمالنا طول % 10(@)(@@) % نعوذ بالله من خذلانه أبدا % فإنما الناس معصوم ومخذول % PageV01P148 11(@)(@@) % إني لفي منزل ما زلت أعمره ، % على يقيني بأني عنه منقول % 12(@)(@@) % وأن رحلي ، وإن أوثقته ، لعلى % % مطية ، من مطايا الحين ، محمول % 13(@)(@@) % ولو تأهبت والأنفاس في مهل % والخير بيني وبين العيش مقبول % 14(@)(@@) % وادي الحياة محل لا مقام به ، % لنازليه ، ووادي الموت محلول % 15(@)(@@) % والدار دار أباطيل مشبهة % الجد مر بها ، والهزل معسول % 16(@)(@@) % وليس من موضع يأتيه ذو نفس ، % إلا وللموت سيف فيه مسلول % 17(@)(@@) % لم يشغل الموت عنا مذ أعد لنا % % وكلنا عنه باللذات مشغول % 18(@)(@@) % ومن يمت فهو مقطوع ومجتنب % والحي ما عاش مغشي ، وموصول % 19(@)(@@) % كل ما بدا لك فالآكال فانية % وكل ذي أكل لا بد مأكول % 20(@)(@@) % وكل شيء من الدنيا فمنتقض % وكل عيش من الدنيا ، فمملول % PageV01P149 21(@)(@@) % سبحان من أرضه للخلق مائدة ، % كل يوافيه رزق منه مكفول % 22(@)(@@) % غدى الأنام وعشاهم ، فأوسعهم ، % وفضله لبغاة الخير مبذول % 23(@)(@@) % يا طالب الخير ابشر واستعد له % فالخير أجمع عند الله مأمول % PageV01P150 البحر : كامل تام 1(@)(@@) % قطعت منك حبائل الآمال ، % وحططت عن ظهر المطي رحالي % % 2(@)(@@) % ويئست أن أبقى لشيء نلت مما % % فيك يا دنيا وإن يبقى لي % % 3 
ms35	(@)(@@) % فوجدت برد اليأس بين جوانحي ، % وأرحت من حلي ومن ترحالي % % 4(@)(@@) % ولئن يئست لرب برقة خلب % برقت لذي طمع ، وبرقة آل % 5(@)(@@) % فالآن ، يا دنيا ، عرفتك فاذهبي ، % يا دار كل تشتت وزوال % 6(@)(@@) % والآن صار لي الزمان مؤدبا % فغدا علي وراح بالأمثال % 7(@)(@@) % والآن أبصرت السبيل إلى الهدى % % وتفرغت هممي عن الأشغال % 8(@)(@@) % ولقد أقام لي المشيب نعاته ، % تفضي إلي بمفرق وقذال % 9(@)(@@) % ولقد رأيت الموت يبرق سيفه % بيد المنية ، حيث كنت ، حيالي % % 10(@)(@@) % ولقد رأيت عرى الحياة تخرمت ، % ولقد تصدى الوارثون لمالي % % PageV01P151 11(@)(@@) % ولقد رأيت على الفناء أدلة ، % فيما تنكر من تصرف حالي % % 12(@)(@@) % وإذا اعتبرت رأيت خطب حوادث % يجرين بالأرزاق ، والآجال % 13(@)(@@) % وإذا تناسبت الرجال ، فما أرى % % نسبا يقاس بصالح الأعمال % 14(@)(@@) % وإذا بحثت عن التقي وجدته % رجلا ، يصدق قوله بفعال % 15(@)(@@) % وإذا اتقى الله امرؤ ، وأطاعه ، % فيداه بين مكارم ومعال % 16(@)(@@) % وعلى التقي إذا ترسخ في التقى % % تاجان تاج سكينة وجلال % 17(@)(@@) % والليل يذهب والنهار ، تعاورا % بالخلق في الإدبار والإقبال % 18(@)(@@) % وبحسب من تنعى إليه نفسه % منه بأيام خلت وليال % 19(@)(@@) % إضرب بطرفك حيث شئت ، فأنت في % % عبر لهن تدارك وتوال % 20(@)(@@) % يبكي الجديد وأنت في تجديده % وجميع ما جددت منه ، فبال % PageV01P152 21(@)(@@) % يا أيها البطر الذي هو في غد ، % في قبره ، متفرق الأوصال % 23(@)(@@) % ولقل ما تلقى أغر لنفسه % من لاعب مرح بها ، مختال % 24(@)(@@) % يا تاجر الغي المضر برشده ، % حتى متى بالغي أنت تغالي % % 25(@)(@@) % الحمد لله الحميد بمنه % خسرت ولم تربح يد البطال % 26(@)(@@) % لله يوم تقشعر جلودهم ، % وتشيب منه ذوائب الأطفال % 27(@)(@@) % يوم النوازل والزلازل ، والحوا % % مل فيه إذ يقذفن بالأحمال % 28(@)(@@) % يوم التغابن والتباين والتنا % % زل والأمور عظيمة الأهوال % 29(@)(@@) % يوم ينادى فيه كل مضلل % بمقطعات النار وألأغلال % 30(@)(@@) % للمتقين هناك نزل كرامة % علت الوجوه بنضرة ، وجمال % 31(@)(@@) % زمر اضاءت للحساب وجوهها % % فلها بريق عندها وتلالي % % PageV01P153 32(@)(@@) % وسوابق غر محجلة جرت % خمص البطون خفيفة الأثقال % 33(@)(@@) % من كل أشعث كان أغبر ناحلا 
ms36	 ، % خلق الرداء مرقع السربال % 34(@)(@@) % حيل ابن آدم في الأمور كثيرة ، % % 35(@)(@@) % نزلو بأكرم سيد فأظلهم % في دار ملك جلالة ، وظلال % 36(@)(@@) % ومن النعاة إلى ابن آدم نفسه ، % حرك الخطى ، وطلوع كل هلال % 37(@)(@@) % ما لي أراك لحر وجهك مخلقا ، % أخلقت ، يا دنيا ، وجوه رجال % 39(@)(@@) % كن بالسؤال أشد عقد ضنانة ، % ممن يضن عليك بالأموال % 40(@)(@@) % وصن المحامد ما استطعت فإنها % % في الوزن ترجح بذل كل نوال % 41(@)(@@) % ولقد عجبت من المثمر ماله ، % نسي المثمر زينة الإقلال % 42(@)(@@) % وإذا امرؤ لبس الشكوك بعزمه % سلك الطريق على عقود ضلال % PageV01P154 43(@)(@@) % وإذا ادعت خدع الحوادث قسوة ، % شهدت لهن مصارع الأبطال % PageV01P155 البحر : سريع 1(@)(@@) % يا ذا الذي يقرأ في كتبه % ما أمر الله ، ولا يعمل % 2(@)(@@) % قد بين الرحمن مقت الذي % % يأمر بالحق ولا يفعل % 3(@)(@@) % من كان لا تشبه أفعاله % أقواله ، فصمته أجمل % 4(@)(@@) % من عذل الناس فنفسي بما % % قد فارقت من دينها أعذل % 5(@)(@@) % إن الذي ينهى ، ويأتي الذي % % عنه نهى في الخلق ، لا يعدل % 6(@)(@@) % والراكب الذنب على جهله % اعذر ممن كان لا يجهل % 7(@)(@@) % لا تخلطن ما يقبل الله من % فعل بقول منك لا يقبل % PageV01P156 البحر : بسيط تام 1(@)(@@) % ما للجديدين لا يبلى اختلافهما ، % وكل غض جديد فيهما بال % 2(@)(@@) % يا من سلا عن حبيب بعد ميتته ، % كم بعد موتك أيضا عنك من سال % 3(@)(@@) % كأن كل نعيم أنت ذائقه ، % من لذة العيش ، يحكي لمعة الآل % 4(@)(@@) % لا تلعبن بك الدنيا ، وأنت ترى % % ما شئت من غير فيها وأمثال % 5(@)(@@) % ما حلة الموت إلا كل صالحة % أو لا فما حيلة فيه لمحتال % PageV01P157 البحر : خفيف تام 1(@)(@@) % كل حي كتابه معلوم % لا شقاء ، ولا نعيم يدوم % 2(@)(@@) % يحسد المرء في النعيم صباحا ، % ثم يمسي وعيشه مذموم % 3(@)(@@) % وإذا ما الفقير قنعه الل % ه ، فسيان بؤسه والنعيم % 4(@)(@@) % من أراد الغنى فلا يسأل النا % % س ، فإن السؤال ذل ولوم % 5(@)(@@) % إن في الصبر والقنوع غنى الده % % ر ، حرص الحريص فقر مقيم 
ms37	 % 6(@)(@@) % إنما الناس كالبهائم في الرز % % ق ، سواء جهولهم والعليم % 7(@)(@@) % ليس حزم الفتى يجر له الرز % ق ولا عاجزا يعد العديم % PageV01P158 البحر : بسيط تام 1(@)(@@) % هو التنقل من يوم إلى يوم % كأنه ما تريك العين في النوم % 2(@)(@@) % إن المنايا وإن أصبحت في لعب % تحوم حولك حوما أيما حوم % 3(@)(@@) % والدهر ذو دول ، فيه لنا عجب ، % دنيا تنقل من قوم إلى قوم % PageV01P159 البحر : سريع 1(@)(@@) % ماذا يفوز الصالحون به % سقيت قبور الصالحين ديم % 2(@)(@@) % لولا بقايا الصالحين عفا % % ما كان أثبته لنا ، ورسم % 3(@)(@@) % سبحان من سبقت مشيته ، % وقضى بذاك لنفسه وحكم % PageV01P160 البحر : كامل تام 1(@)(@@) % أهل القبور عليكم مني السلام ، % إني أكلمكم وليس بكم كلام % 2(@)(@@) % لا تحسبوا أن الأحبة لم يسغ % من بعدكم ، لهم الشراب ولا الطعام % 3(@)(@@) % كلا لقد رفضوكم ، واستبدلوا % % بكم ، وفرق ذات بينكم الحمام % 4(@)(@@) % والخلق كلهم كذاك وكل من % قد مات ليس له على حي ذمام % 5(@)(@@) % ساءلت أجداث الملوك ، فأخبرت % ي أنهم ، فيهن أعضاء وهام % 6(@)(@@) % لله ما وارى التراب من الألى % % كانوا الكرام هم ، إذا ذكر الكرام % 7(@)(@@) % لله ما وارى التراب من الألى % % كانوا وجارهم منيع لا يضام % 8(@)(@@) % يا صاحبي ! نسيت دار إقامتي ، % وعمرت دارا ليس لي فيها مقام % 9(@)(@@) % دار يريد الدهر نقلة أهلها ، % وكأنهم عما يراد بهم نيام % 10(@)(@@) % ما نلت منها لذة إلا وقد % أبت الحوادث أن يكون لها تمام % PageV01P161 البحر : - 1(@)(@@) % يا عين ! قد نمت ، فإستنبهي ، % ما اجتمع الخوف وطيب المنام % 2(@)(@@) % أكره أن ألقى حمامي ، ولا % % بد لحي من لقاء الحمام % 3(@)(@@) % لا بد من موت بدار البلى % % والله بعد الموت يحيي العظام % 4(@)(@@) % يا طالب الدنيا ولذاتها % % هل لك في ملك طويل المقام ؟ % 5(@)(@@) % من جاور الرحمن ، في داره ، % تمت له النعمة كل التمام % PageV01P162 البحر : خفيف تام 1(@)(@@) % لعظيم من الأمور خلقنا % % غير أنا مع الشقاء ننام % 2(@)(@@) % كل يوم يحيط آجالنا الده % ر ، ويدنو ، إلى النفوس ، الحمام % 3(@)(@@) % لا نبالي ولا نراه 
ms38	 غراما % ذا لعمري ، لو اتعظنا الغرام % 4(@)(@@) % من رجونا لديه دنيا وصلنا % % ه ، وقلنا له : عليك السلام % 5(@)(@@) % ما نبالي أمن حرام جمعنا ، % أم حلال ولا يحل الحرام % 6(@)(@@) % همنا اللهو ، والتكاثر في الما % % ل ، وهذا البناء والخدام % 7(@)(@@) % كيف نبتاع فاني العيش بالدا % % ئم أين العقول والأحلام % 8(@)(@@) % لو جهلنا فناءه وقع العذ % ر ، ولكن كلنا علام % PageV01P163 البحر : كامل تام 1(@)(@@) % سميت نفسك ، بالكلام ، حكيما ، % ولقد أراك على القبيح مقيما % % 2(@)(@@) % ولقد أراك من الغواية مثريا % ولقد أراك من الرشاد عديما % % 3(@)(@@) % أغفلت ، من دار البقاء ، نعيمها ، % وطلبت ، في دار الفناء ، نعيما % % 4(@)(@@) % منع الجديدان البقاء ، وأبليا % % أمما خلون من القرون قديما % % 5(@)(@@) % وعصيت ربك يا ابن آدم جاهدا ، % فوجدت ربك ، إذ عصيت ، حليما % % 6(@)(@@) % وسألت ربك يا ابن آدم رغبة % فوجدت ربك ، إذ سألت كريما % % 7(@)(@@) % ودعوت ربك يا ابن آدم رهبة ، % فوجدت ربك ، إذ دعوت ، رحيما % % 8(@)(@@) % فلئن شكرت لتشكرن لمنعم ، % ولئن كفرت لتكفرن عظيما % % 9(@)(@@) % فتبارك الله الذي هو لم يزل % ملكا ، بما تخفي الصدور ، عليما % % PageV01P164 البحر : بسيط تام 1(@)(@@) % يا نفس ! ما هو إلا صبر أيام ، % كأن لذاتها أضغاث أحلام % 2(@)(@@) % يا نفس ! ما لي لا أنفك من طمع % طرفي غليه سريع طامح سام % 3(@)(@@) % يا نفس ! كوني ، عن الدنيا ، مبعدة ، % وخلفيها ، فإن الخير قدامي % % 4(@)(@@) % يا نفس ! ما الذخر إلا ما انتفعت به % % بالقبر ، يوم يكون الدفن إكرامي % % 5(@)(@@) % وللزمان وعيد في تصرفه ، % إن الزمان لذو نقض وإبرام % 6(@)(@@) % أما المشيب فقد أدى نذارته ، % وقد قضى ما عليه منذ أيام % 7(@)(@@) % إني لأستكثر الدنيا ، وأعظمها % % جهلا ولم أرها أهلا لإعظام % 8(@)(@@) % فلو علا بك أقوام مناكبهم ، % حثوا بنعشك إسراعا بأقدام % 9(@)(@@) % في يوم آخر توديع تودعه % تهدي إلى حيث لا فاد ولا حام % 10(@)(@@) % ما الناس إلا كنفس في تقاربهم % لولا تفاوت أرزاق وأقسام % PageV01P165 11(@)(@@) % كم لابن آدم من لهو ، ومن لعب ، % وللحوادث من شد وإقدام % 12(@)(@@) % كم قد نعت لهم الدنيا الحلول بها 
ms39	 % % لو أنهم سمعوا منها بأفهام % 13(@)(@@) % وكم تحرمت الأيام من بشر % كانوا ذوي قوة فيها وأجسام % 14(@)(@@) % يا ساكن الدار تبنيها ، وتعمرها ، % والدار دار منيات وأسقام % 15(@)(@@) % لا تلعبن بك الدنيا وخدعتها ، % فكم تلاعبت الدنيا بأقوام % 16(@)(@@) % يا رب مقتصد من غير تجربة % ومعتد ، بعد تجريب ، وإحكام % 17(@)(@@) % ورب مكتسب بالحكم راميه % ورب مستهدف بالبغي للرامي % % PageV01P166 البحر : - 1(@)(@@) % ألست ترى للدهر نقضا وإبراما ، % فهل تم عيش لامرئ فيه أو داما % % 2(@)(@@) % لقد أبت الأيام إلا تقلبا % لترفع ذا عاما ، وتخفض ذا عاما % % 3(@)(@@) % ونحن مع الأيام حيث تقلبت % فترفع أقواما وتخفض أقواما % % 4(@)(@@) % فلا توطن الدنيا محلا فإنما % % مقامك فيها لا أبا لك أياما % % PageV01P167 البحر : طويل 1(@)(@@) % أيا رب يا ذا العرش ، أنت حكيم ! % وأنت بما تخفي الصدور عليم % 2(@)(@@) % فيا رب ! هب لي منك حلما ، فإنني % % أرى الحلم لم يندم عليه حليم % 3(@)(@@) % ألا إن تقوى الله أكبر نسبة % تسامى بها ، عند الفخار ، كريم % 4(@)(@@) % إذا ما اجتنبت الناس إلا على التقى ، % خرجت من الدنيا وأنت سليم % 5(@)(@@) % أراك امرأ ترجو من الله عفوه ، % وأنت على ما لا يحب مقيم % 6(@)(@@) % فحتى متى يعصى ويعفو إلى متى % % تبارك ربي ، إنه لرحيم % 7(@)(@@) % ولو قد توسدت الثرى وافترشته % لقد صرت لا يلوي عليك حميم % 8(@)(@@) % تدل على التقوى ، وأنت مقصر ، % أيا من يداوي الناس وهو سقيم % 9(@)(@@) % وإن امرأ ، لا يربح الناس نفعه ، % ولم يأمنوا منه الأذى للئيم % 10(@)(@@) % وإن امرأ ، لم يجعل البر كنزه ، % وإن كانت الدنيا له ، لعديم % PageV01P168 11(@)(@@) % وإن امرأ ، لم يلهه اليوم عن غد % تخوف ما يأتي به لحكيم % 12(@)(@@) % ومن يأمن الأيام جهل وقد رأى % % لهن صروفا كيدهن عظيم % 13(@)(@@) % فإن منى الدنيا غرور لأهلها % % أبى الله أن يبقى عليه نعيم % 14(@)(@@) % وأذللت نفسي اليوم كيما أعزها % % غدا ، حيث يبقى العز لي ويدوم % 15(@)(@@) % وللحق برهان وللموت فكرة % ومعتبر للعالمين قديم % PageV01P169 البحر : طويل 1(@)(@@) % ألا إنما التقوى هي العز والكرم ، % وحبك للدنيا هو الذل والعدم 
ms40	 % 2(@)(@@) % وليس على عبد تقي نقيصة % إذا صحح التقوى ، وإن حاك أو حجم % PageV01P170 البحر : مجزوء الرجز 1(@)(@@) % من سالم الناس سلم % من شاتم الناس شتم % 2(@)(@@) % من ظلم الناس أسا ، % من رحم الناس رحم % 3(@)(@@) % من طلب الفضل إلى % % غير ذوي الفضل حرم % 4(@)(@@) % من حفظ العهد وفى ؛ % من أحسن السمع فهم % 5(@)(@@) % من صدق الله علا % من طلب العلم علم % 6(@)(@@) % من خالف الرشد غوى % % من تبع الغي ندم % 7(@)(@@) % من لزم الصمت نجا ، % من قال بالخير غنم % 8(@)(@@) % من عف واكتف زكا ، % من جحد الحق أثم % 9(@)(@@) % من مسه الضر شكا % % من عضه الدهر ألم % 10(@)(@@) % لم يعد حيا رزقه % رزق امرئ حيث قسم % PageV01P171 البحر : مديد تام 1(@)(@@) % سكن يبقى له سكن % ما بهذا يؤذن الزمن ! % 2(@)(@@) % نحن في دار يخبرنا ، % عن بلاها ، ناطق لسن % 3(@)(@@) % دار سوء لم يدم فرح % لامرئ فيها ولا حزن % 4(@)(@@) % ما نرى من أهلها أحدا ، % لم تغل فيها به الفتن % 5(@)(@@) % عجبا من معشر سلفوا % % أي غبن بين غبنوا % % 6(@)(@@) % وفروا الدنيا لغيرهم % % وابتنوا فيها ، وما سكنوا % % 7(@)(@@) % تركوها بعدما اشتبكت % بينهم ، في حبها ، الإحن % 8(@)(@@) % كل حي عند ميتته % حظه من ماله الكفن % 9(@)(@@) % إن مال المرء ليس له % منه ، إلا ذكره الحسن % 10(@)(@@) % ما له مما يخلفه ، % بعد إلا فعله الحسن % PageV01P172 11(@)(@@) % في سبيل الله أنفسنا ، % كلنا بالموت مرتهن % PageV01P173 البحر : كامل تام 1(@)(@@) % نهنه دموعك كل حي فان % واصبر لقرع نوائب الحدثان % 2(@)(@@) % يا داري الحق التي لم أبنها % % فيما أشيده من البنيان % 3(@)(@@) % كيف العزاء ولا محالة إنني % % يوما ، إليك ، مشي ع إخواني % % 4(@)(@@) % نعشا يكفكفه الرجال ، وفوقه % % جسد يباع بأوكس الأثمان % 5(@)(@@) % لولا الإله وإن قلبي مؤمن % والله غير مضيع إيماني % % 6(@)(@@) % لظننت ، أو أيقنت عند منيتي ، % أن المصير إلى محل هوان % 7(@)(@@) % فبنور وجهك يا إله مراحم % زحزح إليك ، عن السعير ، مكاني % % 8(@)(@@) % وامنن علي بتوبة ترضى بها % % يا ذا العلى والمن والإحسان % PageV01P174 البحر : وافر تام 1 