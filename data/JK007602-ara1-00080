ms61	 زمائمه % 20(@)(@@) % ملاء إذا لبسوا الحديد رأيتهم % بحرا تموج بالظبا متلاطمه % PageV01P187 21(@)(@@) % و أبو اليتامى بين أظهرهمإذا % % زأرت ضراغمه نهشن أراقمه % 22(@)(@@) % فلقد سرى مسرى النجوم همومه % و مضى مضي الباترات عزائمه % 23(@)(@@) % شمس النبوة من ذؤابة هاشم % أضحى به فوق الكواكب هاشمه % 24(@)(@@) % و حسام دين ما تناءى فعله % و كريم ثوم أنجبته كرائمه % 25(@)(@@) % إن جاد يوم الجود فهو غمامة % أو صال يوم الروع فهو صوارمه % 26(@)(@@) % و من الملائك في المعارك جنده % و الموت في حرب الضلالة خادمه % 27(@)(@@) % و البيض والأسل الطوال ظلاله % يوم الكريهة والنفوس غنائمه % 28(@)(@@) % ذاك الذي سجد البعير لوجهه % و الجذع حن وظللته غمائمه % 29(@)(@@) % وعليه سلمت الأوابد مثل ما % % فاضت من الضرع الأجد سواجمه % 30(@)(@@) % صلى عليه الله ما زهر زها % % وضحكن في خضر الرباء بواسمه % PageV01P188 31(@)(@@) % فهو المتوج بالكرامة والذي % % عصبت على الكرم العريض عمائمه % 32(@)(@@) % شرف الزمان به فطار فخاره % و تقطعت ظلماته ومظالمه % 33(@)(@@) % و زها بأحمد برده وقضيبه % و التاج والحوض المعين وخاتمه % % 34(@)(@@) % و به استبان الرشد بعد دروسه % و زكت مطالعه وأشرق ناجمه % 35(@)(@@) % و أضاء مصباح الهدى بمحمد % والحق أشرق واستقمن قوائمه % 36(@)(@@) % لذ من جميع النائبات به تجد % حرما علا لأن تستباح محارمه % 37(@)(@@) % وارم الزمان بعظم جاه محمد % مهما رمتك من الزمان عظائمه % 38(@)(@@) % يا من له البيت الحرام وفضله % و مقامه وحطيمه ومواسمه % 39(@)(@@) % و له الصفا والحجرو الحجر الذي % % يزداد ماسحه النعيم ولائمه % 40(@)(@@) % ماذا تعاملني جعلت فداك يا % % من يرتجيه عربه وأعاجمه % PageV01P189 41(@)(@@) % في يوم المظلوم منتصر له % و بسجن سجين يعاقب ظالمه % 42(@)(@@) % و لخصمه يرجوالجزا وشهوده % الأعضاءو الملك المهيمن حاكمه % % 43(@)(@@) % ناداك من برع أسير ذنوبه % لما رحمته عن المزار مآثمه % 44(@)(@@) % فاشفع إلى الباريله فلربما % % تمحى بجاهك في المعاد جرائمه % 45(@)(@@) % إن لم تصل عبد الرحيم برحمة % من ذاك واصله سواك وراحمه % % 46(@)(@@) % فاخفض جناحك يا ابن آمنة له % و لمن يليه مودة ويلائمه % % 47(@)(@@) % و 
ms62	 تلق مدحي بالبشارة واستمع % ما قال ناثره عليك وناظمه % 48(@)(@@) % فالفخر مفتخر وفيك فخاره % و الجود موجود و منك غمائمه % 49(@)(@@) % و عليك صلى الله ما هب الصبا % % برياح نجد أو نسمن نسائمه % 50(@)(@@) % و على جميع الآلو الأصحاب ما % % سجعت بأيمن ذي الأراك حمائمه % PageV01P190 البحر : - 1(@)(@@) % سقاك الحيا الوسمي ربعا تأبدا % و عاداك عيد الأنس وقفا مؤبدا % % 2(@)(@@) % و حيتك من روح النسيم مريضة % تساقط ذر الطل فيك منضدا % % 3(@)(@@) % فما أنا في الآثار أول قائل % سقاك ورواك الغمام ورددا % % 4(@)(@@) % عكفت على مغناك حتى توهمت % نهاتي بأبى قد اتخذتك مسجدا % % 5(@)(@@) % و جددت عهد الحب منك بلوعة % إذا طفئت بالدمع زادت توقدا % % 6(@)(@@) % بكين حمامات الحمى فاستفزني % % جراح هوى في القلب عاد كما بدا % % 7(@)(@@) % و هاج الصبا النجدي وجد بحاجر % فافنيت ليلا بعد ليل مسهدا % % 8(@)(@@) % و ماتركت مني الصبابة في الصبا % % لمستقبل الوجد الجديد تجلدا % % 9(@)(@@) % عذيري من هم دخيل و حسرة % على زمن في الغور لم يك مسعدا % % 10(@)(@@) % و سوق لفقد الوصل أعوز فقده % فأولى له الصبر الجميل تجددا % % PageV01P191 11(@)(@@) % بنفسي ليلات مضت بسويعة % و شعب حياد ما ألذ تهجدا % % 12(@)(@@) % و ذات جمال في أباطح مكة % محاسنها تحكى سناءتوقدا % % 13(@)(@@) % إذا ما رآها العاشقون رأيتهم % % يخرون للأذقان يبكون سجدا % % 14(@)(@@) % عكوفا بمغناها حيارى بحسنها % % فلله كم أصبت قلوبا وأكيدا % % 15(@)(@@) % و ما زلت أوليها بوادر عبرتي % % و أسأل عنها كل من راح أو غدا % % 16(@)(@@) % و لو أنصفتني ساعدتني بزورة % أعيش بها بعد الفراق مخلدا % % 17(@)(@@) % فو لله لا والله ما بي طاقة % على حكم دهر جائر جار واعتدى % % 18(@)(@@) % و لكن أنادي يا لجاه محمد % لاسمع صوتي خير من سمع الندا % % 19(@)(@@) % و أنزل من أعل ذوائب هاشم % بأسمح من فيض الغمام وأجودا % % 20(@)(@@) % بأحسن من في الكون خلقا وخلقة % و أطيبهم أصلا وفرعا ومولدا % PageV01P192 21(@)(@@) % و أرجحهم وزنا وأرفعهم ذرى % % و أطهرهم قلبا وأطولهم يدا % % 22(@)(@@) % فما ولدت في الأرض حوا 
ms63	 وآدم % بأشرف منه في الوجود وأمجدا % % 23(@)(@@) % و ما اشتملت أرض على مثل أحمد % أبر وأوفى من تقمص وارتدى % % 24(@)(@@) % بنور الفتى المكي قامت دلائل % على الحق لما قام فينا موحدا % % 25(@)(@@) % و إن الفتى المكي شمس هداية % إذا استمسك الغاوى بعروته اهتدى % % 26(@)(@@) % لقد شملتنا منه كل كرامة % وصلنا به عزا وفخرا على العدا % % 27(@)(@@) % هدانا الصراط المستقيم بهديه % و ألقتهم الأهواء في هوة الردى % % 28(@)(@@) % فأصبح يولينا عواطف بره % ويوليهم السيف الصقيل المهندا % % 29(@)(@@) % و مازال حتى فل شوكة شركهم % % و شد عرا الدين الحنيف وأكدا % % 30(@)(@@) % إلى أن أقام الحق بعد اعوجاجه % و دل على قصد السبيلفأرشدا % % PageV01P193 31(@)(@@) % عليك سلام اللهيبدوا بطيبة % به يختم الذكر الجميل ويبتدا % % 32(@)(@@) % كأني بزوار الحبيب وقد رأوا % % بيثرب نورا في السماء تصعدا % % 33(@)(@@) % و هبت رياح المسك من نحو روضة % أقام بها الداعي إلى سبل الهدى % % 34(@)(@@) % محمد الحاوي المحامد لم يزل % لمن في السماء السبع والأرض سيدا % % 35(@)(@@) % ثمالي ومأمولي ومالي وموئلي % % و غاية مقصودي إذا شئت مقصدا % % 36(@)(@@) % شددت به أزري وجددت أنعمي % % و أعددته لي في الحوادث منجدا % % 37(@)(@@) % و قيدت آمالي به وبحبه % و من وجد الإحسان قيدا تقيدا % 38(@)(@@) % سلام على السامي إلى الرتب التي % % سرى الحيدري فيها سماكا وفرقدا % % 39(@)(@@) % فتى جاوز السبع السموات حائزا % فضائل سبق ما لميدانه مدى % % 40(@)(@@) % و أدناه منناداهمن فوق عرشه % ليزداد في الدارين مجدا وسؤددا % % PageV01P194 41(@)(@@) % أجب يا رسول الله دعوة مادح % يراك لما يرجو من الخير مرصدا % % 42(@)(@@) % توسل بي بر إليك صويحب % ليمحو كتابا بالذنوب مسودا % % 43(@)(@@) % و مازال تعويلي على جاهك الذي % % يؤمله العبد الشقي ليسعدا % % 44(@)(@@) % فقم بابن موسى أحمد المذنب الذي % % رجاك وهب في الحشر موسى لأحمد % 45(@)(@@) % و أولاده والوالدينتولهم % و أقربهم رحما إليه وأبعدا % % 46(@)(@@) % و زد قائل الأبيات فضلا ورحمة % و أكرمه في دنياه واشفع له غدا % % 47(@)(@@) % و قل أنت يا عبد الرحيم وكل من % يليك غريق الخير في لجة 
ms64	 الندى % % 48(@)(@@) % فما كنت بدعا أن جعلتك عدتي % % و لا كنت ذا عجز فتتركني سدا % % 49(@)(@@) % و لكنني ألقى العدا بكغالبا % و آوى إلى الركن الشديد مؤيدا % % 50(@)(@@) % فأعيت مسافات مواسم ربحه % فحج وما زار النبي محمدا % % PageV01P195 51(@)(@@) % فيا ضيعة الأيام إن هي أدبرت % و ما أنجزت بيني وبينك موعدا % % 52(@)(@@) % و صلى عليك الله ماذر عارض % و ما صاح قمري الأراك مغردا % % 53(@)(@@) % صلاة تحاكي الشمس نورا ورفعة % و تبقى على مر الجديدين سرمدا % % 54(@)(@@) % تخصك يافرد الجلال وينثني % % سناها على الصحب الكرام مرددا % % PageV01P196 البحر : - 1(@)(@@) % أعلمت من ركب البراق عتيما % % و تلاه جبريل الأمين نديما % % 2(@)(@@) % حتى سما فوق السماء قدوما % ودنافكلمربهتكليما % % 3(@)(@@) % صلوا عليهو سلموا تسليما % % 4(@)(@@) % أم من على الرسل الكرام تقدما % % و نوى الصلاة بهم وكبر محرما % % 5(@)(@@) % و سرى إلى ذي العرش فردا بعدما % % بلغ الأمين مكانه المعلوما % % 6(@)(@@) % صلوا عليهو سلموا تسليما % % 7(@)(@@) % أم من كقاب القوس آية قربه % بعلوه ودنوه من ربه % 8(@)(@@) % و رأى الإله بعينه وبقلبه % وحوى من الغيب الخفي علوما % % 9(@)(@@) % صلوا عليهو سلموا تسليما % % 10(@)(@@) % ومن المخصص بالنبوة أولا % و أبوه آدم طينة لم يكملا % % PageV01P197 11(@)(@@) % و من الذي نال العلا حتى علا % شرفا وحاز الفخر والتفخيما % % 12(@)(@@) % صلوا عليهو سلموا تسليما % % 13(@)(@@) % ذاك ابن آمنة البشير المنذر % الصادق المزمل المدثر % 14(@)(@@) % السابقالمتقدم المتأخر % حاوى المفاخر آخرا وقديما % % 15(@)(@@) % صلوا عليهو سلموا تسليما % % 16(@)(@@) % ذاك الذيطاب الزمان بذكره % و تعطرتطرق الهدى من عطره % 17(@)(@@) % و إذا النسيم الرطب مر بقبره % أهدى من المسك الذكي نسيما % % 18(@)(@@) % صلوا عليهو سلموا تسليما % % 19(@)(@@) % اختاره رب السموات العلى % % واختصه بالمكرمات وفضلا % % 20(@)(@@) % و هداه بالوحي الشريف مفصلا % سورا وذكرا من لدنه حكيما % % PageV01P198 21(@)(@@) % صلوا عليهو سلموا تسليما % % 22(@)(@@) % عبرت صبا نجد بنفحة عنبر % من روضة في مشهد متعطر % 23(@)(@@) % ما بين قبر للنبي ومنبر % فيها الذي وهب النوال عميما % % 24(@)(@@) % صلوا عليهو سلموا تسليما % % 25(@)(@@) % هو صفوة الباري وخاتم رسله % و 
ms65	 أمينة المخصوص منه بفضله % 26(@)(@@) % لا در در الشعر إن لم أمله % في مدح أحمد لؤلؤا منظوما % % 27(@)(@@) % صلوا عليهو سلموا تسليما % % 28(@)(@@) % كم دمر المختار من متمرد % بمحجل ومثقف ومهند % 29(@)(@@) % وعصابة حازت بفضل محمد % شرفا وفخرا لا يرام عظيما % % 30(@)(@@) % صلوا عليهو سلموا تسليما % % PageV01P199 31(@)(@@) % قاد الخيول الصافنات إلى العدا % % ثم انتضى بيضا تدل على الهدى % % 32(@)(@@) % و عواسلا أوردن باغضه الردى % % و أعدن واردة الضلال عقيما % % 33(@)(@@) % صلوا عليهو سلموا تسليما % % 34(@)(@@) % و حمت حما الإسلام بيض صفاحه % و جنود نصرته وسمر رماحه % 35(@)(@@) % وحمى الضلال وسقى رمال بطاحه % دم باغضيه وعاد منه سليما % % 36(@)(@@) % صلوا عليهو سلموا تسليما % % 37(@)(@@) % ذاك الذي عبد الإله وأخلصا % % و هو المشفع في المعاد لمن عصى % % 38(@)(@@) % وبكفه نطقت وسبحت الحصى % % شرفا له ولربه تعظيما % 39(@)(@@) % صلوا عليهو سلموا تسليما % % 40(@)(@@) % في الغار نسج العنكبوت لأجله % و الماء من يمناه فاض لفضله % PageV01P200 41(@)(@@) % و تفجر الضرع الأجد برسله % واخضر جذع كان قبل هشيما % % 42(@)(@@) % صلوا عليهو سلموا تسليما % % 43(@)(@@) % و الفحل خص محمدا بسجوده % و الجذع حن على فوات وجوده % 44(@)(@@) % يا أيها المتعرضون لجوده % زوروا كريما واقصدوه كريما % % 45(@)(@@) % صلوا عليهو سلموا تسليما % % 46(@)(@@) % من لي بأن أحظى بأفخر موعد % و أزوره والعمر ليس بمسعد % 47(@)(@@) % و متى أشاهد نور قبر محمد % و يصير حظي بالشقاء نعيما % % 48(@)(@@) % صلوا عليهو سلموا تسليما % % 49(@)(@@) % فومن أحن إلى زيارة سوحه % لأكفرن خطيئتيبمديحه % 50(@)(@@) % فاللهيسعدنيبلثم ضريحه % لأنال فوزا من لدنه عظيما % PageV01P201 51(@)(@@) % صلوا عليهو سلموا تسليما % % 52(@)(@@) % ما زلت أكتسب الفضائلو العلى % % بنظام نثر كالجواهر فضلا % 53(@)(@@) % أهديهمن نيابتي برع إلى % % من لم يزل بالمؤمنين رحيما % % 54(@)(@@) % صلوا عليهو سلموا تسليما % % 55(@)(@@) % هو ذخرتي هوعمدتيهوعدتي % % و حماى في الدنيا ومؤنس وحدتي % % 56(@)(@@) % و غدا ألوذبهفيكشف كربتي % % و يكون عني للخصوم خصيما % % 57(@)(@@) % صلوا عليهو سلموا تسليما % % 58(@)(@@) % هوملجئي وبه اهتديت من العمى % % و لقيت منه لدى الشدائد أنعما % % 59(@)(@@) % و جعلتهلمنال فخريسلما % و 
ms66	 لروضة الأمل الهشيم غيوما % % 60(@)(@@) % صلوا عليهو سلموا تسليما % % PageV01P202 61(@)(@@) % هل يا محمد تنقذون غريقكم % % متحمل الأوزار ضل طريقكم % 62(@)(@@) % إنلمأكن في النائبات رفيقكم % و لزيمكمفلمن أكون لزيما % % 63(@)(@@) % صلوا عليهو سلموا تسليما % % 64(@)(@@) % قل أنت يا عبد الرحيم وكل من % يعنيك من أصل وفرع أو سكن % 65(@)(@@) % في ظلنا الممدود من محن الزمن % واشمل بجاهك صاحبا وحميما % % 66(@)(@@) % صلوا عليهو سلموا تسليما % % 67(@)(@@) % و ادرأ بصولكفينحور حواسدي % % أبدا وعاندبالنكال معاندي % % 68(@)(@@) % و أجزحروف قصائديبمقاصدي % % و تول نصري ظالما مظلوما % % 69(@)(@@) % صلوا عليهو سلموا تسليما % % 70(@)(@@) % يا منبراه الله نورا للورى % % فأقام فيهم منذرا ومبشرا % % PageV01P203 71(@)(@@) % أناغرسجودكفي العراء وفي الثرى % % و غداة يجمعنا المعاد عموما % % 72(@)(@@) % صلوا عليهو سلموا تسليما % % 73(@)(@@) % مني السلام عليكماهب الصبا % % و تعانقتعذباتبانات الربا % % 74(@)(@@) % و تناوحتورق الحمام لتطربا % % و أضاء نورك في السما نجوما % % 75(@)(@@) % صلوا عليهو سلموا تسليما % % 76(@)(@@) % و عليك صلى اللهغالب أمره % تعداد موجودالوجودبأسره % 77(@)(@@) % باللهيا متلذذ ينبذكره % من كانمنكم ظاعنا ومقيما % % 78(@)(@@) % صلوا عليهو سلموا تسليما % % PageV01P204 البحر : - 1(@)(@@) % قفابرياض الشعب شعب القرنفل % نجدها بد مع في المحاجر مسبل % 2(@)(@@) % و نندب آثارا أثارت غرامنا % % و أجرت حمى الوجد في كل مفصل % 3(@)(@@) % منازل كنا أهلها فأحالها % % تقلب دهر بالبلاء موكل % 4(@)(@@) % فأضحت لأرواح الرياح ملاعبا % تناوحن فيها من جنوب وشمأل % 5(@)(@@) % و لم يبق منها غير سفع رواكد % و آثار أطلال وبئر معطل % 6(@)(@@) % خليلي لا تستخبراني عن الهوى % % فيشكو لسان الحال حال التذلل % 7(@)(@@) % و ما أنا للشكوى بأهل وإنما % % سلكت سبيلا لست فيها بأول % 8(@)(@@) % لقد نزلت منى بربع ربيعة % ترامى عيون العين في كل مقتل % 9(@)(@@) % و لم يدر رب الربع أي دم جنى % % و أي فتى أفتى بحكم التحول % 10(@)(@@) % و كم من شهيد كر في مشهد الهوى % % فراح وروح الوصل غير مواصل % PageV01P205 11(@)(@@) % تقاضته باقي دنها غربة النوى % % فأصبحبعد الظاعنينبمعزل % 12(@)(@@) % إذا رام أعتاب الزمان تعرضت % خطوب تذل العصم عن كل معقل % 13(@)(@@) % فكيف تراني أرتجي 
ms67	 نجح مطلب % إذا لم يكن بالهاشمي توسلي % % 14(@)(@@) % جعلت عريض الجاه في كل حادث % ثمالي ومأمولي ومالي وموئلي % % 15(@)(@@) % أرد به كيد العدوإذااعتدى % % و ألقي به سود الخطوبفتنجلي % % 16(@)(@@) % و أوردآماليمناهلبره % و أنزلآمالي بأجودمنزل % 17(@)(@@) % بأبلجمنقرمى لؤيبن غالب % ملاذ غياث مستغاث مؤمل % 18(@)(@@) % بشير نذير مشفق متعطف % رؤوف رحيم شاهد متوكل % 19(@)(@@) % هو الشافعالمقبولفي الحشر للورى % % إذا عملالإنسانلميتقبل % 20(@)(@@) % أيا نسمات الريحمن طيب طيبة % أعيديلروحي روح ند ومندل % % PageV01P206 21(@)(@@) % و يا هاطلات السحب جوديكرامة % على خير أرض أودعت خير مرسل % 22(@)(@@) % محمد المستغرق الحمدباسمه % حميد المساعي ذو الجناب المجلل % 23(@)(@@) % نبي زكي أريحي مهذب % شريف منيف سربهغير مهمل % 24(@)(@@) % بتوراة موسى نعته وصفاته % و إنجيل عيسى والزبور المفصل % 25(@)(@@) % و في الملإ الأعلى علو مناره % و تشريفه عن كلذي شرف على % % 26(@)(@@) % لمسراهأبوابالسماءتفتحت % وقيللهأهلا وسهلا بك ادخل % % 27(@)(@@) % و خصبأد نى قاب قوسين رفعة % و بالحوض في بحر السنا المتهلل % 28(@)(@@) % و بالآية الكبرى وتعليم ذي القوى % % وسبعالمثاني والكتاب المنزل % % 29(@)(@@) % و بالبد ر منشقا وبالضب ناطقا % و بالجذع وجدا والسحاب المظلل % 30(@)(@@) % و كمآية تقرا وأعجوبة ترى % % و معجزة تروي بنقل مسلسل % PageV01P207 31(@)(@@) % فما ولدتأنثى ولا اشتملتعلى % % أجلو أعلى منه قدرا وأجمل % 32(@)(@@) % و لا ضمت الأقطار مثل ابن هاشم % بحسن و إحسان ومجد مؤثل % 33(@)(@@) % عسى منكيا مولاينهضة رحمة % بعبدالرحيم السائل المتوسل % 34(@)(@@) % و أصحابه والوالدين وإن علوا % % و قرباه والولدان أسفل أسفل % 35(@)(@@) % فأنتلنا كنز و عز و ملجأ % و نهج لمأمول وفتح لمقفل % 36(@)(@@) % حوائجفي الدنيابجاهك عجلت % و آجلة أخرى ليوم مؤجل % 37(@)(@@) % فصل حبل وديما ذكرتكو اهدني % % بمصباحنور العلمفي كل مشكل % 38(@)(@@) % و عندفراق الروحكنلي مشاهدا % ليشهدبالتوحيدفلبي ومقولي % % 39(@)(@@) % فإذالمتكن لي في الشدائد عدة % فمن ياشفيعالمذنبينيكونلي % % 40(@)(@@) % و صلى عليكاللهمالاحبارق % و ما سح ودق تحت رعد مجلجل % PageV01P208 41(@)(@@) % و ما سجعت ورق الحمائم في الحمى % % و غردقمري لتغريدبلبل % 42(@)(@@) % صلاةتؤديكلحقك رفعة % و مجدا وتفضيلا على كلأفضل % 43(@)(@@) % و تشملمنوالاكنصرا وهجرة % و كلمحب للصحابةأو ولي % PageV01P209 البحر 
ms68	 : - 1(@)(@@) % إذا عهدوا فليس لهم وفاء % و إن وعدوا فموعدهم هباء % 2(@)(@@) % و إن أرضيتهم غضبوا ملالا % و إنأحسنت عشرتهم أساءوا % % 3(@)(@@) % فطب نفسا جعلت فداك عنهم % و لا تبكي فما يغني البكاء % 4(@)(@@) % و حاذر تستمع فيهم ملاما % أنا واللائمون لهم فداء % 5(@)(@@) % فضول صبابة ونحول جسم % لعمرك ما على هذا بقاء % 6(@)(@@) % و لا مسود قلبك من حديد % و لا عيناك دمعهما دماء % 7(@)(@@) % و من لك بالزيارة من حبيب % حمته البيض والأسل الظباء % 8(@)(@@) % صبيح في لمى شفتيه خمر % كأن مزاجها عسل وماء % 9(@)(@@) % سقيم اللحظ أورثني سقاما % و في شفتيه للسقم الشفاء % 10(@)(@@) % دعاني للوداعفذبت وجدا % فهل بعدالوداعلنا لقاء % PageV01P210 11(@)(@@) % إذا رحل الحبيب فما حياتي % % وموتيبعده إلا سواء % 12(@)(@@) % جعلتفداكما العشاقإلا % % مساكين قلوبهم هواء % 13(@)(@@) % تزودللخطوبالسودصبرا % فإنالصبرظلمتهضياء % 14(@)(@@) % وخذمنكلمنواخاكحذرا % فهذا الدهر ليسلهإخاء % 15(@)(@@) % ولا تأنسبعهد منأناس % إذا عهدوافليسلهموفاء % 16(@)(@@) % و إن عثرت بك الأيام فانزل % بأكرم من تظلله السماء % 17(@)(@@) % نبي هاشمي أبطحي % شمائلهالسماحةو الوفاء % 18(@)(@@) % طويل الباع ذو كرم و صدق % نمته الأكرمون الأصدقاء % 19(@)(@@) % بنفسي من سرى وسما إلى أن % رأى حجب الجلال لها انطواء % 20(@)(@@) % و ناداهالمهيمن يا حبيبي % % هلم لوصلناولكالهناء % PageV01P211 21(@)(@@) % فقل واشفع ترى كرما ومجدا % وسل تعطى فشيمتنا العطاء % 22(@)(@@) % خزائن رحمتي ونعيم ملكي % % بحكمك فاقض فيها ما تشاء % 23(@)(@@) % لك الحوض المعين كرامة % يا محمدو الشفاعةو اللواء % 24(@)(@@) % مقامكتقصر الأملاك عنه % و فضلكلمتنلهالأنبياء % 25(@)(@@) % و كم لك في العلا من معجزات % و آيات بها سبق القضاء % 26(@)(@@) % إذا نسبوا المكارم والمعالي % % فأنتلهاتمام وابتداء % 27(@)(@@) % تزيد إذا اشمأز الدهر جودا % وجودك لا يخالطه الرياء % 28(@)(@@) % و تخصب في السنين الغبر سوحا % و تصفو كلما كدر الصفاء % 29(@)(@@) % إذا الفخر انتهى شرفا فحاشا % % و كلا مالمفخركانتهاء % 30(@)(@@) % ومن يحصى مكارمك اللواتي % % لها في كل مرتبة ثناء % PageV01P212 31(@)(@@) % أجب يا ابن العواتك صوت عبد % أسير الذنب فيه لك اللواء % 32(@)(@@) % من النيابتين دعاك لما % % تولى العمر وانقطع الرجاء % 33(@)(@@) % مدحتك مذ وجدتك لي 
ms69	 ربيعا % فلي منك الندى ولك الثناء % 34(@)(@@) % تداركني بجاهك من ذنوب % و أوزار يضيق بها الفضاء % 35(@)(@@) % وكن لي ملجا في كل حال % فليس إلى سواك لي التجاء % 36(@)(@@) % و قل عبد الرحيم ومن يليه % لهم في ريف رأفتنا جزاء % 37(@)(@@) % فإن أكرمتنا دنيا وأخرى % % فليس البحر تنقصه الدلاء % 38(@)(@@) % عليك صلاة ربك ما تبارت % نجوم الجو أو عصفت رخاء % 39(@)(@@) % صلاة تبلغ المأمول فيها % % صحابتك الكرام الأتقياء % PageV01P213 البحر : - 1(@)(@@) % قل للمطي اللواتي طال مسراها % % من بعد تقبيل يمناها ويسراها % % 2(@)(@@) % ما ضرها يوم جد البين لو وقفت % تقص في الحي شكوانا وشكواها % % 3(@)(@@) % لو حملت بعض ماحملت من حرق % ما استعذبت ماءها الصافي ومرعاها % % 4(@)(@@) % لكنها علمتوجدي فأوجدها % % شوق إلى الشأمأبكاني وأبكاها % % 5(@)(@@) % ما هبمنجبلي نجد نسيمصبا % % للغورإلا وأشجانيوأشجاها % % 6(@)(@@) % و لا سرى البارقالمكي مبتسما % إلا وأشهرني وهنا وأسراها % % 7(@)(@@) % تبادرتمن ربا نابتي برع % كأن صوت رسول الله ناداها % % 8(@)(@@) % حتى إذا ما رأت نور النبي رأت % للشمس والبدر أمثالا وأشباها % % 9(@)(@@) % حطت بسوح رسول الله واطرحت % % أثقالها ولديه طاب مثواها % % 10(@)(@@) % حيا الغمام الرحاب الخضر منسجما % فالقبر فالروضة الخضراء حياها % % PageV01P214 11(@)(@@) % حيث النبوة مضروب سرادقها % % و ذروة الدين فوق النجم علياها % % 12(@)(@@) % هنالك المصطفى المختار من مضر % خير البرية أقصاها وأدناها % % 13(@)(@@) % أتى بهاللهمبعوثا وأمته % على شفا جرف هار فأنجاها % % 14(@)(@@) % و أبدل الخلق رشدا من ضلالتهم % وفل بالسيف لما عز عزاها % % 15(@)(@@) % كم حكم السيف والبيض القواضب في % % معاشر اللات والعزى فأفناها % % 16(@)(@@) % و ساق جرد جياد الخيل خائضة % مجرى الكماة بمجراها ومرساها % % 17(@)(@@) % ذاك البشير النذير المستغاث به % سر النبوة في الدنيا ومعناها % % 18(@)(@@) % شمس الوجود الذي أنوار مولده % ملآن ما بين كنعان و بصراها % % 19(@)(@@) % و انشقإيوان كسرى من مهابته % و نار فارس ذاك الطفل أطفاها % % 20(@)(@@) % و كم له من كرامات يخص بها % % و معجزات كثيرات عرفناها % % PageV01P215 21(@)(@@) % الثدي در له والغيم ظلله % وانشقفي الأفق بدر شق ظلماها % % 22(@)(@@) % و الجذع حن وأجرى الماء 
ms70	 من يده % عشر المئين ونصف العشر أرواها % % 23(@)(@@) % و العنكبوت بنت بيتا عليه لكى % % ترد قافة كفر ضل مسعاها % % 24(@)(@@) % و الفحل ذل وأوما بالسجود له % و الظبية اشتكت البلوى فأشكاها % % 25(@)(@@) % بشرى ظراف القوافي أنها ظفرت % بسيد العرب والعرباء بشراها % % 26(@)(@@) % فالحمد لله نحن الفائزون به % في ملة نعم عقبى الدار عقباها % % 27(@)(@@) % هذا محمد المحمودسيرته % هذا أبر بنى الدنيا وأوفاها % % 28(@)(@@) % هذا الذي حين جانا بالرسالة في % % بطحاء مكة عم النور بطحاها % % 29(@)(@@) % لم يبق من شجر فيها ولاحجر % إلا تحييه نطقا حين يلقاها % % 30(@)(@@) % وكلمتهجماداتالوجود على % % علم كأن لها حسأ وأفواها % % PageV01P216 31(@)(@@) % والطير والوحش والأملاك ما برحت % تهديالسلاملهكيترضي الله % % 32(@)(@@) % مني السلام على النور الذي ابتهجت % % به السموات لما جاز أعلاها % % 33(@)(@@) % واستبشر العرشوالكرسيوامتلأت % حجب الجلالة نورا حين وافاها % % 34(@)(@@) % يا من الكوثر الفياض مكرمة % يا خاتم الرسليا يس يا طه % % 35(@)(@@) % ماللنبيين منوصف وليسله % فمنتهى حسنهافيه وحسناها % % 36(@)(@@) % أنتالذي مالهفي الكونشبه % هيهاتأينثراها منثرياها % % 37(@)(@@) % مانالفضلكذو فضل سواكولا % % سامى فخاركذو فخر ولاضاهى % % 38(@)(@@) % فرد الجلالة مقبولالشفاعة في % % يومالقيامةأعلى الأنبياجاها % % 39(@)(@@) % مولاى ماليإلا حسنلطفكبي % % فهبلعيني عينا منكترعاها % % 40(@)(@@) % واشملبرحمة عبدالرحيموصل % أهلا وصحبا وأرحاما لمولاها % % PageV01P217 41(@)(@@) % وانهضبنفسكإذا أمتك منبرع % تبغيالزيارة عاقتهاخطاياها % % 42(@)(@@) % وهبلها الأمنفي الدارين وارعلها % % حسنالظنونلدنياها وأخراها % % 43(@)(@@) % واجعل لأمتكالخيراتمنقلها % يومالقيامةوالجناتمأواها % % 44(@)(@@) % صلى عليكإلهييامحمدما % % دامتإليكالورى تحدوامطاياها % % 45(@)(@@) % تحيةينثنيفيالآلطالعها % % سعدا ويفضحريحالمسكرياها % % PageV01P218 البحر : - 1(@)(@@) % بكى الغريب بفقد الدار والجار % إن الغريب غزير دمعه الجاري % % 2(@)(@@) % أهاجه الركب إذ قالوا الرحيل غدا % أم شاقه لمع ذاك البارق الساري % % 3(@)(@@) % أم بات يرقب نارا بالحمى وقدت % ياموقد النار لا عذبت بالنار % 4(@)(@@) % هب النسيم بأرواح يمانية % تهدي إلى الشأم ذاك المنزل الداري % % 5(@)(@@) % فبت والقلب مجروح جوارحه % حيران أضربأخماسا بأعشار % 6(@)(@@) % نام الخليون من حولي وما علموا % % أني سمير صبابات وتذكار % 7(@)(@@) % ذكرت جيرة نجد يوم دارهم % داري وسمار ذاك الحي سماري % % 8(@)(@@) % و ذبت وجدا لأرض لي بها وطر % هيهات كم بين أوطاني وأوطاري % % 9(@)(@@) % يا ممرضي بربا نجد أعد مرضي 
ms71	 % % عسى يعودن عوادي وزواري % % 10(@)(@@) % فقد وهبت لغزلان العذيب دمى % % و لم أطالب عيون العين بالثار % PageV01P219 11(@)(@@) % لولا فراق الفريق النازلين على % % حكم الهوى ما وشى دمعي بأسراري % % 12(@)(@@) % فكم تقسم قلبي نية عرضت % مقسومة بين أنجاد وأغوار % 13(@)(@@) % يا معمل العيس من شام إلى يمن % معودا حمل أهوال وأخطار % 14(@)(@@) % سلم على الحي من نيابتي برع % و قل لهم حين تنبيهم بأخباري % % 15(@)(@@) % رأيته حول بيت الله في زمر % منطائفين وحجاج وعمار % 16(@)(@@) % و قد قضى عمل النسكين محتسبا % و نال ما نال من غفران غفار % 17(@)(@@) % لكنه ضاق ذرعا أن يحج ولم % يزر شفيع البرايا صفوة الباري % % 18(@)(@@) % محمد دعوة الحق الرسول إلى % % عرب وعجم وبدو ثم حضار % 19(@)(@@) % سر السرارةلب اللب خير فتى % % من فتية سادة السادات أخيار % 20(@)(@@) % مستودع الحسن والإحسان ذو كرم % بالخير أجود من ريح الصبا الذاري % % PageV01P220 21(@)(@@) % مستغرق باسمه كل المحامد من % علم وحلم وإفضال وإيثار % 22(@)(@@) % حياك يا طيبة الغرا صوب حيا % يهمى بمنسجم في الحي مطار % 23(@)(@@) % حيث النبوة مضروب سرادقها % % على رياض جنان ذات أنهار % 24(@)(@@) % الله أكبر ذا فرد الجلالة ذا ال % % كاسي من الكيس والعاري من العار % 25(@)(@@) % ذابهجة الكون ذا سر الهداية ذا % % روح الوجود المصطفى ذا خير مختار % % 26(@)(@@) % إنجيل عيسى مع التوراة بشرنا % % ببعثه مسندا عن كعب أحبار % 27(@)(@@) % و كم له في علامات النبوة من % مصنفات صحيحات وآثار % 28(@)(@@) % كبرء مرضى وفيض الماء من يده % و أنس نافر وغزلان وأطيار % 29(@)(@@) % و نطق ضب ونسج العنكبوت كما % % باض الحمام لثاني اثنين في الغار % 30(@)(@@) % و العضو كلمه والجذع حن وفي % % معناهتسليم أحجار وأشجار % PageV01P221 31(@)(@@) % و الغيم ظلله والبدر شق له % و الثدي فاض بدر منه مدرار % 32(@)(@@) % و كم لأشرف رسل الله من شرف % لم تبلغ الخلق منه عشر معشار % 33(@)(@@) % يا منقذ الخلق من نار الجحيم وهم % على شفا جرف هار بمنهار % 34(@)(@@) % يا عدتي يا رجائي في النوائب يا % % عزي وكنزي ويسري 
ms72	 بعد إعساري % % 35(@)(@@) % إسمع غرائب مدح لا أريد بها % % تحصيل دار ودينار وقنطار % 36(@)(@@) % بل أرتجي منك في الدارين مرحمة % و في الإقامة بين الدار والدار % 37(@)(@@) % فما مدحتك بالتقصير معترفا % إلا لتخفيف آصاريو أوزاري % % 38(@)(@@) % و أين ينزل مدحي فيك بعد ثنا % % سبع المثاني وسجعي وأشعاري % % 39(@)(@@) % عليكأزكى صلاةاللهدائمة % تبقى بقاء عشيات و أبكار % 40(@)(@@) % تندى عليكعبيرا طيبا و على % % مهاجرين وآل ثم أنصار % PageV01P222 البحر : - 1(@)(@@) % يالأبرق الفرد أطلال قديمات % لآل هند عفتهن الغمامات % 2(@)(@@) % و ملعب لعبت هوج الرياح به % كأنهم فيه ما ظلوا ولا باتوا % % 3(@)(@@) % تنكر العلم الغربي من أضم % و أقفرت بعدبينالركبرامات % 4(@)(@@) % تشتيتهمجمع الأحزان في كبدي % % فالهم مجتمع والركب أشتات % 5(@)(@@) % فإن أنست غيابات الفؤاد بهم % فهم أحيباب قلبي يا غيابات % 6(@)(@@) % فيا حمامات وادي البان شجوك في % % ظل الأراك شجاني يا حمامات % 7(@)(@@) % و يا أثيلات نجد ما لعبت ضحى % % إلا لعبت بقلبي يا أثيلات % 8(@)(@@) % تهيج لوعة قلبي المستهام إذا % % هبت بنشر الصبا النجدي هبات % 9(@)(@@) % فكيف حال بعيد الدار مغترب % له إلى الشام حنات وأنات % 10(@)(@@) % يهدي التحية من نيابتي برع % إلى نبي عطاياه جزيلات % PageV01P223 11(@)(@@) % محمد سيد الخلق الذي امتلأت % من نوره الأرض والسبع السموات % 12(@)(@@) % أسرى به الله من أرض الحجاز إلى % % أن قبلت نعله الحجب الرفيعات % 13(@)(@@) % أدناه منقاب قوس حينكلمه % بالغيب من بعد ما قال التحيات % 14(@)(@@) % وزاده منه تشريفا وشفعه % في الخلق لاعدمت منه الشفاعات % 15(@)(@@) % فالبدر والبحر والقطر الملث حيا % و الفضل والفخر فيه والكرامات % 16(@)(@@) % تالله ما ارتفعت للدين مرتبة % لولا مراتبه الشم المنيعات % 17(@)(@@) % أحيا الزمان فأيام الزمان به % يومان في الله إنعام وغارات % 18(@)(@@) % و قل شوكة أهل الشرك مرتضيا % لله ربا فما العزى وما اللات % 19(@)(@@) % فالخيل تصهل والأرماح شاجرة % و البيض والبيض مسراها العجاجات % 20(@)(@@) % ما استمطرته ثغور المشركين حيا % إلا سقتها القنا والمشرفيات % PageV01P224 21(@)(@@) % مني السلام على القبر الذي اعتكفت % فيه العلى وانتهت فيه النهايات % 22(@)(@@) % و جاد طيبة 
ms73	 مرفض تلوح به % زهر الرياض وتخضر البشامات % 23(@)(@@) % أرض سمت برسول الله أشرف من % تشرفت فيه آباء وأمات % 24(@)(@@) % متى أرى النور من أرجاء قبته % متى تباشرني منه البشارات % 25(@)(@@) % فإن ولهت إلى قبر ابن آمنة % فهو الذي ختمت فيه الرسالات % 26(@)(@@) % ذاك الحبيب الذي ترجو عواطفه % و بره الخلق أحياء وأموات % 27(@)(@@) % البدر شق له والغيم ظلله % و الجذع حن وسبحن الحصيات % 28(@)(@@) % و شاة جابر يوم الجيش معجزة % نعم النبي ونعم الجيش والشاة % 29(@)(@@) % و كان في الشمس نورا ليس تشخصه % ظل بذلك جاءتنا الروايات % 30(@)(@@) % له فخار وتعظيم ومرتبة % و معجزات كثيرات و آيات % PageV01P225 31(@)(@@) % مولاي مولاي فرج كل معظمة % عني فقد أثقلت ظهري الخطيئات % 32(@)(@@) % و عد علي بما عودتني كرما % فكم جرت لي بخير منك عادات % 33(@)(@@) % و امنع حماي وهب لي منك مكرمة % يا من مواهبه خير وخيرات % 34(@)(@@) % و اعطف علي وخذ يا سيدي بيدي % % إذا دهتني الملمات المهمات % 35(@)(@@) % فقد وقفت بباب الجود معتذرا % و العفو متسع والعذر أبيات % 36(@)(@@) % و قل غدا أنت من أهل اليمين إذا % % زخرفتللداخلين الخلد جنات % 37(@)(@@) % و إن مدحتك بالتقصير معترفا % فمدحك الوحي والسبع القراآت % 38(@)(@@) % قل لا يخف بعدها عبد الرحيم ومن % يليه أهل وصحب أو قرابات % 39(@)(@@) % صلى عليك إلهي يا محمد ما % % لاحت بنورك من بدر علامات % 40(@)(@@) % و اللآل والصحب والأزواج كلهم % فهم لسادات أهل الفضل سادات % PageV01P226 البحر : - 1(@)(@@) % هي العيس نوليها الحنين فتسعد % و نزجرها نحو الحبيب فتصعد % 2(@)(@@) % يذكرها الحادي بجيرة طيبة % فيأخذها شوم مقيم و مقعد % 3(@)(@@) % وإنسمعت سجعالحمام تذكرت % بسلع حمامات تبيت تغرد % 4(@)(@@) % و إن وقدت نار بأحد تبادرت % إليها وفي أحشائها النار توقد % 5(@)(@@) % فلا تذكرايا صاحبيلها الحمى % % و لا جيرةخلوا الغوير فأنجدوا % % 6(@)(@@) % و لكنعداها بالحجازو أحمد % فما قصدها إلا الحجاز وأحمد % 7(@)(@@) % سرت فرأت من نحو بدر على الربا % % طلائعبدر نورهيتصعد % 8(@)(@@) % و دانتثنياتالوداعفهاجها % % نسيم حجازي يهبو يركد % 9(@)(@@) % لعلنسيمالريحيهدي تحيتي % % إلى منلهعن أيمن 
ms74	 العرش مقعد % 10(@)(@@) % فيقرئهمنيالسلاممكررا % فخيرالتحياتالسلامالمردد % PageV01P227 11(@)(@@) % نبي لهجود و مجد مؤثل % و جاه و تمكين مكين و سؤدد % 12(@)(@@) % على حبهيستمسكالطيرفي الهوا % % و تهبطأملاكالسماءو تصعد % 13(@)(@@) % و يهتزريحانالقلوب لذكره % إذا ذكرارتاحتقلوب و أكبد % 14(@)(@@) % و ذلكمنأوتيالنبوةأولا % و آدمبينالماء والطينمفرد % 15(@)(@@) % فكانلهفي العرشسبق و رفعة % و كانلهفي الأرض بعث ومولد % 16(@)(@@) % هنيئا لذاكالبدرشرفقدره % و أعطى منالتمكينماليسينفد % 17(@)(@@) % و شقاسمه منأحرفاسمإلهه % فذو العرشمحمود و هذا محمد % 18(@)(@@) % ينادى بأسماء الملائكوالعلا % على أنه أعلى وأزكى وأمجد % 19(@)(@@) % و يذكر في التهليل مع ذكر ربه % و إن قيل في التأذينأشهدأشهد % 20(@)(@@) % ويعلو على الأملاكوالرسلرفعة % فهاهو للأملاك والرسل سيد % % PageV01P228 21(@)(@@) % فلا غيره في الفضل يخترق العلى % % ولا تحت ساق العرش لله يسجد % 22(@)(@@) % نبي أتى والناس فيجاهلية % من الدين والأصنامفي الأرض تعبد % 23(@)(@@) % فقام على التوحيد بالسيف داعيا % إلى اللهفهوالهاشميالموحد % 24(@)(@@) % وغيضبحرالشركحينتلاطمت % على أهلهأمواجهوهو مزبد % 25(@)(@@) % وغادرحيالمشركينبلا قعا % منكرة لما عصواوتمردوا % % 26(@)(@@) % تروحوتغدوالطيرفي عرصاتها % % وأسيافهفيهمتسلوتغمد % 27(@)(@@) % فآياتهبالمعجزات نواطق % وراياته بالنصر والفتح تعقد % 28(@)(@@) % فذلكنور اللهفي كلوجهة % منالأرضوالسيفالصقيلالمهند % 29(@)(@@) % غنائمه حل ومكةقبلة % لهو الطهورالتربو الأرضمسجد % 30(@)(@@) % و كممنكرامات له وخصائص % لمشهدهافوقالسمواتمشهد % PageV01P229 31(@)(@@) % مدحترسولاللهمفتخرا به % و قمتبحمداللهأنثى و أنشد % 32(@)(@@) % و قلتلعل اللهيمحوجرائمي % % بهو ابن مسعود المقصر يسعد % 33(@)(@@) % رجوناكفي الدارينيا علمالهدى % % لأنك فيالدارين هاد و مرشد % 34(@)(@@) % أقلعثرات إنبنا زمن نبا % % فأنتأبرالناسقلبا وأجود % 35(@)(@@) % و لا نرتجيمولىسواكلعلمنا % % بأنكموجود و غيركيفقد % 36(@)(@@) % أتتكمنالنيابتينحروفها % % تخالحروفا و هيدر منضد % 37(@)(@@) % و قائلهاعبدالرحيمبنأحمد % عسى أنهفي نظممدحكيحمد % 38(@)(@@) % فحققرجائيفيكيا غايةالمنى % % و قلأنتمنا في الجنانمخلد % 39(@)(@@) % و لا تطردالمسكينمعحسنظنه % فحاشا علاكمأنيرجى ويطرد % 40(@)(@@) % و كيفيخافالذبكلمقصر % وعفوكيا مولايللذنبمرصد % PageV01P230 41(@)(@@) % فهل منكإذن في الزيارةإنني % % أسير بأغلالالذنوبمقيد % 42(@)(@@) % بعدتبزلاتيو طالتإقامتي % % فلا الموتمأمون ولا العمر مسعد % 43(@)(@@) % فواحسرتي يا خيرمنوطئالثرى % % إذا لميكنبيني وبينك موعد % 44(@)(@@) % عليكسلام لا يبيدمبارك % جديد على مرالجديدينسرمد % PageV01P231 البحر : - 1(@)(@@) % هم الأحبة إن جاروا وإن عدلوا % % فليس لي معدل عنهم وإن عدلوا % % 2(@)(@@) % و كل شيء سواهم لي به بدل % منهم ومالي بهم من غيرهم بدل % 3(@)(@@) % إني وإن فتتوا في حبهم كبدي 
ms75	 % % باق على ودهم راض بما فعلوا % % 4(@)(@@) % شربت كأس الهوى العذرى من ظمأ % و لذلي في الغرام العل والنهل % 5(@)(@@) % فليت شعري والدنيا مفرقة % بين الرفاق وأيام الورى دول % 6(@)(@@) % اهل ترجع الدار بعد البعد آنسة % و هل تعود لنا أيامنا الأول % 7(@)(@@) % يا ظاعنين بقلبي أينما ظعنوا % % و نازلين بقلبي أينما نزلوا % % 8(@)(@@) % ترفقوا بفؤادي في هوادجكم % راحت به يوم راحت بالهوى الإبل % 9(@)(@@) % فو الذي حجت الزوار كعبته % و من ألم بها يدعو ويبتهل % 10(@)(@@) % لقد جرى حبكم مجرى دمي فدمي % % بعد التفرق في أطلالكم طلل % PageV01P232 11(@)(@@) % لم أنس ليلة فارقت الفريق وقد % عافوا الحبيب عن التوديع وارتحلوا % % 12(@)(@@) % لما تراءت لهم نار بذي سلم % ساروافمنقطع عنها ومتصل % 13(@)(@@) % لا در در المطايا أينما ذهبت % إن لم تنخ حيث لا تثنى لها العقل % 14(@)(@@) % في روضة من رياض الجنة ابتهجت % حسنا وطاب بها للنازل النزل % 15(@)(@@) % حيث النبوة مضروب سرادقها % % و طالع النور في الآفاق يشتمل % 16(@)(@@) % و حيث من شرف الله الوجود به % فاستغرق الفضل فردا ماله مثل % 17(@)(@@) % محمد سيد السادات من مضر % سر السرارة شمس ماله طفل % 18(@)(@@) % شوارد المجد في مغناه عاكفة % و ريف رأفته غصن الجنى الخضل % 19(@)(@@) % تثنى عليه المثاني كلما تليت % كما استنارت به الأقطار والسبل % 20(@)(@@) % بحر طوارقه ب ر ومكرمة % بدر على فلك العلياء مكتمل % PageV01P233 21(@)(@@) % ما زالبالنورمن صلب إلى رحم % من عهد آدم في الساداتينتقل % 22(@)(@@) % حتى انتهى في الذرى من هاشم وسما % % فتى وطفلا ووفي وهو مكتهل % 23(@)(@@) % فكان في الكون لا شكل يقاسبه % و لا على مثلهالأقطارتشتمل % 24(@)(@@) % به الحنيفةمرساة قواعدها % % فوق النجومو نهجالحقمعتدل % 25(@)(@@) % و منهظللواءالحمديشملنا % % إذا العصاةعليهممنلظى ظلل % 26(@)(@@) % و إنهالحكم العدلالذينسخت % بدينملتهالأديانو الملل % 27(@)(@@) % يا خير من دفنتفي الترب أعظمه % فطابمن طيبهن السهل والجبل % 28(@)(@@) % نفسيالفداءلقبر أنتساكنة % فيهالهدى و الندى و العلمو العمل % 29(@)(@@) % أنتالحبيبالذينرجو عواطفه % عند الصراطإذاما ضاقت الحيل % 30(@)(@@) % نرجو شفاعتك العظمى لمذنبنا % % بجاهوجهكعناتغفرالزلل % PageV01P234 31(@)(@@) % يا سيدييارسولاللهخذبيدي % % فيكلحادثة ماليبهاقبل % 32(@)(@@) % قالوانزيلكلايؤذى 
ms76	 و ها أناذا % % دميوعرضي مباح والحمى همل % 33(@)(@@) % و ذاالمسمى بكاشتدالبلاءبه % % فارحممدامعهفي الخدتنهمل % 34(@)(@@) % و حلعقدة هم عنهمابرحت % و اشرحبهصدرأمقلبها وجل % 35(@)(@@) % و صل بمرحمة عبد الرحيم ومن % يليه لا خابفيه الظنو الأمل % 36(@)(@@) % صلى و سلمربيدائما أبدا % عليكيا خيرمنيحفى وينتعل % 37(@)(@@) % و الألو الصحبما غنتمطوقة % و ما تعاقبتالأبكار والأصل % PageV01P235 البحر : - 1(@)(@@) % عاهدوا الربع ولوعا وغراما % فوفوا للربع بالدمع ذماما % % 2(@)(@@) % كلمامرواعلى أطلاله % سفحواالدمعبذي السفحانسجاما % % 3(@)(@@) % نزلوابالشعبمنشرقيه % مستظلينأراكا وبشاما % % 4(@)(@@) % ينثرالطلعليهملؤلؤا % % يشبهاللؤلؤحسنا وابتساما % % 5(@)(@@) % و إذاهبتصبانجد لهم % فهمتهمعنربانجد كلام % 6(@)(@@) % يا رفيقيبنواحيرامة % غنليبالأبرقالفردو راما % % 7(@)(@@) % كمبدور في خدورالمنحنى % % يستعيرالبدرمنهنالتماما % % 8(@)(@@) % حبهمحلسويدا مهجتي % % و فؤاديبعدمافتالعظاما % % 9(@)(@@) % أيهااللائمأذنيلا تعي % % زخرفالقولفدععنكالملاما % % 10(@)(@@) % أولعالحببدمعيو دمي % % فعلاماللومفي الحبعلاما % % PageV01P236 11(@)(@@) % عذريالوجدو قلبي فيهم % يكرهالمسكو يرتاحالخزاما % % 12(@)(@@) % و الفتى العذرى لاينفكعن % عهدةالشوقو إنذاقالحماما % % 13(@)(@@) % ليتشعريهلأدانيشعبهم % بعدبعدى و ترى عينيالخياما % % 14(@)(@@) % ماعليكمسادتيمنحرج % لوتردون لياليناالقداما % % 15(@)(@@) % إنتناهتدارناعنداركم % فاذكرواالعهدوزورونامناما % % 16(@)(@@) % هيجتنينسمة نجدية % قلبت قلبيعميدا مستهاما % % 17(@)(@@) % كلماناحتحماماتالحمى % % فيأراكالشعبناوحتالحماما % % 18(@)(@@) % و اأحيبابيالألى عاهدتهم % % عقلواعقليبمنأهوى هياما % % 19(@)(@@) % عرضواالكاسعلينامرة % فانتهى السكرو مافاضوا الختاما % % 20(@)(@@) % ثملتأرواحنامن ذكرهم % لم نر الراحو لا ذقناالمداما % % PageV01P237 21(@)(@@) % يا ندامايفؤاديعند كم % % ما فعلتم بفؤادييا ندامى % % 22(@)(@@) % همتفاستعذبتتعذيبيبكم % فاجرحواقلبيو لا تخشواأثاما % % 23(@)(@@) % أنتممندميالمسفوحفي % % أوسع الحلو إنكانحراما % % 24(@)(@@) % و اصرمواحبليو إنشئتم صلوا % % لذ لي الحبو صالا وانصراما % % 25(@)(@@) % أناراض بالذي ترضونه % لكم المنة عفوا و انتقاما % % 26(@)(@@) % كنتفيالشعبو كانواجيرتي % % لو صفاليذلكالعيشو داما % % 27(@)(@@) % قسما بالبيتو الركنالذي % % طابتقبيلا و مسحا والتزاما % % 28(@)(@@) % إنفيطيبةقوما جارهم % فيمحلالنجميعلوأنيسامى % % 29(@)(@@) % روضةالجنةفيأوطانهم % و ثرى آثارهميبريالجذاما % % 30(@)(@@) % كلمنلميرفرضا حبهم % فهمفيالنارو إنصلى وصاما % % PageV01P238 31(@)(@@) % همنجومأشرقالكونبهم % بعدماكانتنواحيهظلاما % % 32(@)(@@) % فتحواالأرضبعليابأسهم % و استباحوايمينا منهاو شاما % % 33(@)(@@) % فيهمالبدرالذيأنواره % لميطقمنبعدها الحقانكتاما % % 34(@)(@@) % الأعزالمنتقى منهاشم % طيبالعنصرحاشاأنيضاما % % 35(@)(@@) % المدانيقابقوسينالذي % % كانللأملاكوالرسلإماما % 36(@)(@@) % إرتضاهاللهنورا للهدى % % و انتضاهلدمالأعداحساما % % 37(@)(@@) % خصهاللهبدين قيم % نسخ الأديان ندبا و التزاما % % 38(@)(@@) % و كتاب أحكمت آياته % % عصمةاللهلمنراماعتصاما % % 39(@)(@@) % يهتديكلمناستهدى به % سبلالرشدو يعمى منتعامى % % 40(@)(@@) % فرضالعمرةو الحج لنا % % و صلاةو زكاةو صياما % % PageV01P239 41(@)(@@) % يا رسولاللهيا ذاالفضليا % % بهجةالمحشرجاها ومقاما % % 42(@)(@@) % ياوجيهالوجهفيالدارينيا % % شافع الخلقإذالدواخصاما % % 43(@)(@@) % عدعلى عبدالرحيمالملتجي % % بحمى عزكيا غوثاليتامى % % 44(@)(@@) % و رفاقيالكلقمبيو بهم % فيالملماتإذااحتجنامقاما % % 45(@)(@@) % و 
ms77	 أقلنيسيدي منعثرتي % % و اكتسابيالذنبمنخمسين عاما % 46(@)(@@) % نحنفيروضثناكمنجتني % % ثمراتالمدحنثراو نظاما % 47(@)(@@) % لوسماالمجدلأقصى غاية % كنتللمجدسناء وسناما % % 48(@)(@@) % يدكالعلياعلى كليد % زادكاللهعلوا واحتراما % 49(@)(@@) % و كساروحكمنهرحمة % و صلاة ترتضيها وسلاما % % 50(@)(@@) % تقتضيحقكعني دائما % و تعمالآلو الصحبالكراما % % PageV01P240 البحر : - 1(@)(@@) % قف بذات السفح من أضم % وانشد السارين في الظلم % 2(@)(@@) % هلرووا علما عن العلم % أمرأواسلمى بذيسلم % 3(@)(@@) % ليتشعريبعدما رحلوا % % أيأكنافالحمى نزلوا % % 4(@)(@@) % أبذاتالبانأمعدلوا % % ينشدونالقلبفيالخيم % 5(@)(@@) % فسقى مرعاهم المطر % و سرى روحالصباالعطر % % 6(@)(@@) % فيرياض طلهادرر % بين منثور ومنتظم % 7(@)(@@) % نورهاالقاني ملتهب % فيرقوم لونها ذهب % 8(@)(@@) % فيهمنحبالندى حبب % فوقزهر منهمبتسم % 9(@)(@@) % مذتراءتليخدورهم % و بدت للعيندورهم % 10(@)(@@) % هيجت وجديبدورهم % يالقلبيبالغرام رمى % % PageV01P241 11(@)(@@) % فجهات الصبر مظلمة % و مرامى الهجرمؤلمة % 12(@)(@@) % و هيأرواح مقسمة % هيجتلعث اللمى ألمى % % 13(@)(@@) % كمصباقلبيبهاو لها % % كمأذابتمهجتيو لها % % 14(@)(@@) % كمحفظت العهد ليو لها % % قبلسنالحلمبالحلم % 15(@)(@@) % أنافيتأليف قافيتي % % غيرمجتاز إلى فئة % 16(@)(@@) % سقمى فيالحبعافيتي % % ووجوديفيالهوى عدمى % % 17(@)(@@) % و صفكمصاف عنالشبه % يا عزيزالشكلو الشبه % % 18(@)(@@) % و عذاب ترضونبه % فيفميأحلى من النعم % 19(@)(@@) % قسما بالنجم حين هوى % % ماالمعافى و السقيمسوى % % 20(@)(@@) % فاخلعالكونينعنك سوى % % حبمولى العربو العجم % PageV01P242 21(@)(@@) % سيدالساداتمن مضر % غوثأهلالبدوو الحضر % 22(@)(@@) % صاحبالآياتو السور % منبع الأحكامو الحكم % 23(@)(@@) % قمر طابت سريرته % و سجاياه وسيرته % % 24(@)(@@) % صفوة الباريو خيرته % عدل أهلالحل والحرم % 25(@)(@@) % ما رأت عيني وليس ترى % % مثل طه في الورى بشرا % % 26(@)(@@) % خير منفوقالثرى أثرا % % طاهرالأخلاق والشيم % 27(@)(@@) % جاوز السبعالطباق إلى % % قاب قوسيناستمرعلا % % 28(@)(@@) % و أحالته الحظوظ على % % سر علم اللوح والقلم % 29(@)(@@) % نالعبدالله موهبة % ولعظم الفضل موجبة % 30(@)(@@) % يا أعز الناس مرتبة % عد بفضل الجود والكرم % % PageV01P243 31(@)(@@) % عدبفضل الجودمنكعلى % % صاحب النيابتين فلا % % 32(@)(@@) % يعترى عبدالرحيمبلا % % وارع حقالصحبو الرحم % 33(@)(@@) % قل لهم أنتم منالسعدا % % و اشملالأدنين والبعدا % % 34(@)(@@) % و إنكنت الشفيع غدا % % للورى فالقاسمي سمى % % 35(@)(@@) % أنت عبداللهذوالشرف % وهو عبداللهذو السرف % 36(@)(@@) % صدهعنمذهبالسلف % كثرة العصيان واللمم % 37(@)(@@) % صا ر بالأوزار مرتهنا % ظالما للنفس ممتهنا % 38(@)(@@) % لذنوب كالجبال جنى % % هتك أعراض وسفكدم % 39(@)(@@) % ضاق عنه وجهه مذهبه % عزعنه نيل مذهبه % 40(@)(@@) % قم عداة الحشربيو به % يومجمعالخصموالحكم % PageV01P244 41(@)(@@) % لم يخبمنكنت موئله 
ms78	 % يامنالرحمن فضله % 42(@)(@@) % ما على الجانيوأنتله % عصمة من أوثقالعصم % 43(@)(@@) % بك مزن الجود ماطرة % و بحارالخير زاخرة % 44(@)(@@) % فجميع الرسل قاصرة % عنمساعيطاهرالقدم % 45(@)(@@) % وصلاةالله كلضحى % % و سلام الله مابرحا % % 46(@)(@@) % جاوزوا ختما ومفتتحا % حيث كنتم خيرفيالقدم % % 47(@)(@@) % المصطفى منصب الشرفا % % ذوالوفاأعلى الورى شرفا % 48(@)(@@) % أحمد المختار والخلفا % % شهداء الله فيالأمم % PageV01P245 البحر : - 1(@)(@@) % أبني دونك عبرتي وتنهدي % % كمدا عليك فكم أعيد وأبتدي % % 2(@)(@@) % أبني طال بك السقام فليتني % % أفديك لو ولد بوالدهفدى % % 3(@)(@@) % أ بني ما بيدي لمثلك حيلة % لكن أمد إلى ابن آمنة يدي % % 4(@)(@@) % إن ضاق بي وبك الخناق فلم يضق % عني وعنك عريض جاه محمد % 5(@)(@@) % ذاك الغياث المستغاث به الذي % % لولاه ما كان الوجود بموجد % 6(@)(@@) % ذاك المتوج بالمهابة والعلى % % شمس النبو عصمة المسترشد % 7(@)(@@) % و غيم مرحمة يمد ظلاله % و يفيض نائله لكل موحد % 8(@)(@@) % هو صاحب الأحكام والحكم التي % % طلعت طلائعها هدى للمهتدى % % 9(@)(@@) % قمر تسلسل من ذؤابة هاشم % في السر منها والصريح الأمجد % 10(@)(@@) % ملأت محامده الزمان وأسرعت % شهب النجاة لمغور ولمنجد % PageV01P246 11(@)(@@) % رؤوف بأمته رحيم مشفق % متعطف بالود للمتودد % 12(@)(@@) % نرجوهفي الدنيا لنجح مرادنا % % و نلوذ منه إلى الشفاعة في غد % 13(@)(@@) % و هو الذي من قاب قوسين انتهى % % في القرب يفتح كل باب موصد % 14(@)(@@) % و له الفضيلة والوسيلة رفعة % و الفضلو الزلفى وصدق المقعد % 15(@)(@@) % و الرسل تحشر تحت ظل لوائه % و تؤم كوثره الهنىء المورد % 16(@)(@@) % جبل نلوذ من الخطوب بعزه % وبه نصولعلى الزمان المعتدى % % 17(@)(@@) % جعل الصنائع في الرقاب قلائدا % و بنى المحامد في عراص الفرقد % 18(@)(@@) % يتوسل المتوسلونبجاهه % فيرد عنهمكل خطب أنكد % 19(@)(@@) % جاد الغمام على رباه إلى ربا % % سلع فما والى بقيع الغرقد % 20(@)(@@) % و سقى جوانب روضة قدسية % محروسة في ظل ذاك المسجد % PageV01P247 21(@)(@@) % فهناك أرواح النفوس عواكف % شغفا بأحمدذائباتالأكبد % 22(@)(@@) % طوبى لطيبة حيث حل بربعها % % شمس الفخار ففاق شمس الأسعد % 23(@)(@@) % نزل المكان فكان محترما به % ومحا الفساد فساد كل مسود % 24(@)(@@) % علم تظلل بالغمامة 
ms79	 وارتوى % % من ذلك الضرع الأجد الجلمد % 25(@)(@@) % و الجذع حنم له وسبحت الحصى % % في كفه نص الحديث المسند % 26(@)(@@) % هو عدتي هو عمدتي هو ذخرتي % % هو نصرتي هو منقذي هو منجدي % % 27(@)(@@) % ياسيد الثقلين كن لي مسعدا % فالدهر يا مولايليسبمسعدي % % 28(@)(@@) % هذا سميك أحمد فاق الحشا % % أتراك تغفل عن سميك أحمد % 29(@)(@@) % ألم ألم به فقطع بالبكا % % كبدي وظني فيك غاية مقصدي % % 30(@)(@@) % فاسأل له الرحمن نظرة راحم % بشمول عافية وعفو سرمد % PageV01P248 31(@)(@@) % واجز به عبد الرحيم براءة % من حر نار جهنم المتوقد % 32(@)(@@) % و عليك صلى الله ما هب الصبا % % من طيب طيبة عن شذا الند الندي % % 33(@)(@@) % و على صحابتك الجميع وكل من % والاك يشهد حسن ذاك المشهد % PageV01P249 البحر : - 1(@)(@@) % مثل لعينك خدرا في الحمى ضربا % و انشد فؤادا مع الاحباب مغتربا % % 2(@)(@@) % و ابكالمنازلبعد الظاعنين دما % إن لمتر الدمع يقضي عنك ما وجبا % % 3(@)(@@) % و لا تلم في الهوى العذرى ذا شجن % في الغور هب له ريح الصبا فصبا % % 4(@)(@@) % إن حدث الركب عن نجد بكى شجنا % و إن رأى النار في نجد بكى طربا % % 5(@)(@@) % و الورق ساجعة تغرى الغرام به % و البرق يلهبه وجدا إذا التهبا % % 6(@)(@@) % يود لو أن أيام الحمى رجعت % و قلما رد شيء بعد ما ذهبا % % 7(@)(@@) % فيا حويدالمطايا ذا الكثيبو ذا ال % % مرعى الخصيب فدعها ترتعي العذبا % % 8(@)(@@) % في روضة تجد ظل النسيم بها % % نشوان ينثر من حب الندى حببا % % 9(@)(@@) % و إن وردت بها ماء العذيب فقل % سقى العذيب من الأمواه ما عذبا % % 10(@)(@@) % و خل عنها إذا ارتاحت لرائحة % من طيب طيبة أو ريا رياض قبا % % PageV01P250 11(@)(@@) % و إن وصلت بها باب السلام فقل % مني السلام على أوفى الورى حسبا % % 12(@)(@@) % محمد خير منزول بساحته % كهف الأرامل والأيتام والغربا % % 13(@)(@@) % أغر أرسله الرحمن مرحمة % للخلق بالحق يهدي العجم والعربا % % 14(@)(@@) % نور الوجود تمام الوجد إن نزلت % بهالوفود بسوح ضيق رحبا % % 15(@)(@@) % ملاذ كل صريخ ما صدمت به % % خطبا 
ms80	 فكل ولا أستعطيته فأبى % % 16(@)(@@) % تندى الغمام إذا استمطرتها مطرا % و ابن العواتكتندى كفه ذهبا % % 17(@)(@@) % و تسلب الشمس ثوب النور آفلة % و نور أحمد شق الترب والشهبا % % 18(@)(@@) % إن ابن عبد مناف شمس قد ابتهجت % لما رآها سنا أهل الضلال خبا % % 19(@)(@@) % كم عاندته قريش في نبوته % و كم أضافوا إليه السحر والكذبا % % 20(@)(@@) % و ضلة نبزوه بالجنون ولم % يبقوا لأسمائه من ضدها لقبا % % PageV01P251 21(@)(@@) % حتى رماهم بجيش لا كفاء له % يهدي إلى الملحدين الحرب والحربا % % 22(@)(@@) % بيض المفارق والهيجاء مظلمة % كأنهم في ظهور الخيل نبت ربا % % 23(@)(@@) % فيهم عتيق وفاروق و صنوهما % % عثمان والحيدريالضاري إذا وثبا % % 24(@)(@@) % أئمة شر ف الله الوجود بهم % ساموا العلا فسموا فوق العلا رتبا % 25(@)(@@) % و من نزار وفرعى تغلب عرب % أرباب سمر وبيض تلتظى لهبا % % 26(@)(@@) % الغائضي غمرات الموت متخذي % % هام الكماة على أرماحهم عذبا % % 27(@)(@@) % الشاربي الموت صرفا في الهياج فما % % يدرون طعنا وضربا كان أم ضربا % % 28(@)(@@) % محبةلنبي بينأظهرهم % اختاره واجتباه الله وانتخبا % % 29(@)(@@) % مؤيدا بكتاب اللهمعتصما % بالله منتصرا لله محتسبا % 30(@)(@@) % يا أشرف الخلق من حاف ومنتعل % و منتقى من مشى منهم ومن ركبا % % PageV01P252 31(@)(@@) % كان ابن مسلم جار الجنب من برع % فكنت من بعد جاركالجنبا % % 32(@)(@@) % أهدي إليك منالنيابتينعلى % % شوقي إليك حروفا تشبه الشهبا % % 33(@)(@@) % فصل برحمة عبد الرحيم ومن % يليه أهلا وأرحاما ومصطحبا % % 34(@)(@@) % و إندعافأجبه واحمجانبه % و صلهما قطعت أيامهالسببا % % 35(@)(@@) % لا نلت قوة ضعفي إن نبا زمني % % و في يدي منك سيف ما هوى فنبا % % 36(@)(@@) % و لا عدمتك في الدارين معتمدا % بجاهوجهك مثلي يتقى التربا % % 37(@)(@@) % فقم بحالي وحال المسلمين إذا % % ضاق الخناق ورض لي كل ما صعبا % % 38(@)(@@) % مني عليك صلاة الله دائمة % تنمي فتستغرق الأعصار والحقبا % % 39(@)(@@) % تزيد قدرك يا سر الوجود علا % و الآل والصحب نعم السادة النجبا % % 40(@)(@@) % ما حن رعد وما غنت مطوقة % و ما تغنت حمامات الحمى طربا % PageV01P253 البحر : - 1(@)(@@) % فؤادي بربع الظاعنين أسير % يقيم على آ ثارهمو 