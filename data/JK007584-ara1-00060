ms41	 عذاري ، % ومن رد الشباب المستعار ! % 2(@)(@@) % و ثوب ، كنت ألبسه ، أنيق % أجرر ذيله ، بين الجواري % % 3(@)(@@) % و ما زادت على العشرين سني % % فما عذر المشيب إلى عذاري ؟ % 4(@)(@@) % و ما استمتعت من داعي التصابي % % إلى أن جاءني داعي الوقار % % 5(@)(@@) % أيا شيبي ، ظلمت ! ويا شبابي % % لقد جاورت ، منك ، بشر جار ! % 6(@)(@@) % يرحل كل من يأوي إليه % و يختمها بترحيل الديار % 7(@)(@@) % أمرت بقصه ، وكففت عنه ، % وقر على تحمله قراري % % 8(@)(@@) % وقلت : الشيب أهون ما ألاقي % % من الدنيا وأيسر ما أداري ! % 9(@)(@@) % ولا يبقى رفيقي الفجر حتى % % يضم إليه منبلج النهار ' % 10(@)(@@) % ' و إني ما فجعت به لألقى % % به ملقى العثار من الشعار ' % PageV01P180 11(@)(@@) % و كم من زائر بالكره مني % % كرهت فراقه بعد المزار ! % 12(@)(@@) % متى أسلو بلا خل وصول % يوافقني ، ولا قدح مدار ؟ % 13(@)(@@) % و كنت ، إذا الهموم تناوبتني ، % فزعت من الهموم إلى القفار % 14(@)(@@) % أنخت وصاحباي بذي طلوح % طلائح ، شفها وخد القفار % 15(@)(@@) % ولا ماء سوى نطف الأداوي ، % ولا زاد سوى القنص المثار % 16(@)(@@) % فلما لاح بعد الأين سلع ، % ذكرت منازلي وعرفت داري % % 17(@)(@@) % ألم بنا ، وجنح الليل داج ، % خيال زار وهنا من نوار % 18(@)(@@) % أباخلة علي ، وأنت جار ، % وواصلة على بعد المزار ! % 19(@)(@@) % تلاعب بي ، على هوج المطايا ، % خلائق لا تقر على الصغار % 20(@)(@@) % و نفس ، دون مطلبها الثريا % % وكف دونها فيض البحار % PageV01P181 21(@)(@@) % أرى نفسي تطالبني بأمر % قليل ، دون غايته ، اقتصاري % % 22(@)(@@) % و ما يغنيك من همم طوال % إذا قرنت بأعمار قصار ؟ % 23(@)(@@) % ومعتكف على حلب بكي ، % يقوت عطاش آمال غزار % 24(@)(@@) % يقول لي : ' انتظر فرجا ' ومن لي % % بأن الموت ينتظر انتظاري ؟ ! % 25(@)(@@) % علي لكل هم ، كل عيس % أمون الرحل موخدة القفار % 26(@)(@@) % وخراج من الغمرات خرق ، % أبو شبلين ، محمي الذمار % 27(@)(@@) % شديد تجنب الآثام واف ، % على علاته ، عف الإزار % 28(@)(@@) % فلا نزلت بي الجيران إن لم % أجاورها مجاورة البحار % 29(@)(@@) % % أصاحبها بمأمون الفرار % 30(@)(@@) % ولا صحبتني الأملاك إن لم % أصبحها بملتف الغبار % PageV01P182 31(@)(@@) % بجيش لا يحل 
ms42	 بهم مغير % ورأي لا يغبهم مغار % 32(@)(@@) % شددت على الحمامة كور رحل % بعيد حله ، دون اليسار % 33(@)(@@) % تحف به الأسنة ، والعوالي ، % و مضمرة المهاري ، والمهاري % % 34(@)(@@) % يعدن ، بعيد طول الصون ، سعيا % لما كلفن من بعد المغار % 35(@)(@@) % و تخفق حولي الرايات حمرا ، % وتتبعني الخضارم من ' نزار ' % 36(@)(@@) % وإن طرقت بداهية نآد % تدافعها الرجال بكل جار % 37(@)(@@) % عزيز حيث حط السير رحلي ، % تداريني الأنام ولا أداري ! % 38(@)(@@) % و أهلي من أنخت إليه عيسي ، % وداري حيث كنت من الديار % PageV01P183 البحر : هزج 1(@)(@@) % تواعدنا بآذار % لمسعى غير مختار % 2(@)(@@) % وقمنا ، نسحب الريط ، % إلى حانة خمار ؛ % 3(@)(@@) % فلم ندر ، وقد فاحت % لنا من جانب الدار % 4(@)(@@) % بخمار ، من القوم ، % نزلنا ، أم بعطار ؟ % 5(@)(@@) % فلما ألبس الليل ، % لنا ثوبا من القار % 6(@)(@@) % وقلنا : أوقد النار % لطراق وزوار % 7(@)(@@) % وجا خاصرة الدن % فأغنانا عن النار % 8(@)(@@) % وما في طلب اللهو ، % على الفتيان ، من عار ! % PageV01P184 البحر : وافر تام 1(@)(@@) % صبرت على اختيارك واضطراري % % وقل ، مع الهوى ، فيك انتصاري % % 2(@)(@@) % و كان يعاف حمل الضيم قلبي ، % فقر على تحمله قراري % % 3(@)(@@) % فديتك ، طال ظلمك واحتمالي % % كما كثرت ذنوبك واعتذاري % % PageV01P185 البحر : مجزوء الكامل 1(@)(@@) % ما آن أن أرتاع للش % % يب ، المفوف في عذاري ؟ % 2(@)(@@) % وأكف عن سبل الضلا % % ل ، وأكتسي ثوب الوقار % 3(@)(@@) % أم قد أمنت الحادثا % % ت من الغوادي والسواري % % 4(@)(@@) % إني أعوذ ، بحسن عف % % و الله ، من سوء اختياري % % PageV01P186 البحر : مجزوء الرمل 1(@)(@@) % هل ترى النعمة دامت % لصغير أو كبير ؟ % 2(@)(@@) % أو ترى أمرين جاءا % % أولا مثل أخير % 3(@)(@@) % إنما تجري التصاري % % ف بتقليب الدهور % 4(@)(@@) % ففقير من غني ؛ % وغني من فقير ! % PageV01P187 البحر : كامل تام 1(@)(@@) % من أين للرشإ ، الغرير ، الأحور ، % في الخد ، مثل عذاره المتحدر ؟ ! % 3(@)(@@) % قمر ، كأن بعارضيه كليهما % % مسكا ، تساقط فوق ورد أحمر % PageV01P188 البحر : بسيط تام 1(@)(@@) % ووارد مورد أنسا ، يؤكده % صدوره عن سليم الورد والصدر % 2(@)(@@) % شدت سحائبه منه على نزه % تقسم الحسن بين السمع والبصر % 3(@)(@@) % عذوبة ، صدرت عن منطق جدد ؛ % كالماء 
ms43	 يخرج ينبوعا من الحجر % 4(@)(@@) % وروضة من رياض الفكر ، دبجها % % صوب القرائح لا صوب من المطر % 5(@)(@@) % كأنما نشرت أيدي الربيع بها % % بردا من الوشي أو ثوبا من الحبر % PageV01P189 البحر : متقارب تام 1(@)(@@) % ولي منة في رقاب الضباب ، % وأخرى تخص بني جعفر % 2(@)(@@) % عشية روحن من ' عرقة ' % وأصبحن فوضى ، على شيزر % 3(@)(@@) % وقد طال ما وردت ' بالجباة ' % وعاودت الماء في تدمر % 4(@)(@@) % قددن البقيعة ، قد الأدي % % م ، والغرب في شبه الأشقر % 5(@)(@@) % و جاوزن ' حمص ' ؛ فلم ينتظر % ن على مورد أو على مصدر % 6(@)(@@) % وبالرستن استلبت موردا ، % كورد الحمامة أو أنزر % 7(@)(@@) % وجزن المروج ، وقرني حماة % و ' شيزر ' ، والفجر لم يسفر % 8(@)(@@) % و غامضت الشمس إشراقها % % فلفت كفرطاب بالعسكر % 9(@)(@@) % ولاقت بها عصب الدارعي % % ن بكل منيع الحمى مسعر % 10(@)(@@) % على كل سابقة بالرديف ، % وكل شبيه بها مجفر % PageV01P190 11(@)(@@) % و لما اعتفرن ولما عرقن % خرجن ، سراعا ، من العثير % 12(@)(@@) % ننكب عنهن فرسانهن ، % ونبدأ بالأخير الأخير % 13(@)(@@) % فلما سمعت ضجيج النسا % % ء ناديت : ' حار ' ، ألا فاقصر ! % 14(@)(@@) % أ ' حارث ' من صافح ، غافر % لهن ، إذا أنت لم تغفر ؟ ! % 15(@)(@@) % رأى ابن عليان ما سره % فقلت : رويدك لا تسرر ! % 16(@)(@@) % فإني أقوم بحق الجوا % % ر ثم أعود إلى العنصر % PageV01P191 البحر : طويل 1(@)(@@) % و يوم جلا فيه الربيع بياضه % بأنواع حلي ، فوق أثوابه الخضر % 2(@)(@@) % كأن ذيول الجلنار ، مطلة ، % فضول ذيول الغانيات من الأزر % PageV01P192 البحر : طويل 1(@)(@@) % ووالله ، ما أضمرت في الحب سلوة ، % ووالله ، ماحدثت نفسي بالصبر % 2(@)(@@) % و إنك في عيني ، لأبهى من الغنى ، % وإنك ، في قلبي ، لأحلى من النصر % 3(@)(@@) % فيا حكمي المأمول جرت مع الهوى ! % وياثقتي المأمون ، خنت مع الدهر ! % PageV01P193 البحر : طويل 1(@)(@@) % سأثني على تلك الثنايا ، لأنني % % أقول على علم ، وأنطق عن خبر % 2(@)(@@) % و أنصفها ، لا أكذب الله ، أنني % % PageV01P194 البحر : بسيط تام 1(@)(@@) % يا طيب ليلة ميلاد ، لهوت بها % % بأحور ، ساحر العينين ، ممكور % 2(@)(@@) % والجو ينشر درا ، غير منتظم ، % والأرض بارزة في ثوب كافور % 3(@)(@@) % والنرجس الغض يحكي حسن 
ms44	 منظره % صفراء صافية في كأس بلور % PageV01P195 البحر : وافر تام 1(@)(@@) % ولي في كل يوم منك عتب ولي في كل يوم منك عتب % أقوم به مقام الاعتذار % 2(@)(@@) % حملت جفاك ، لا جلدا ، ولكن % صبرت على اختيارك واضطراري % % PageV01P196 البحر : وافر تام 1(@)(@@) % جنى جان ، وأنت عليه حان ، % وعاد ، فعدت بالكرم الغزير % 2(@)(@@) % صبرت عليه حتى جاء ، طوعا ، % إليك ، وتلك عاقبة الصبور % 3(@)(@@) % فإن تك عدلة في الجسم كانت % فما عدل الضمير عن الضمير % 4(@)(@@) % و مثل ' أبي فراس ' من تجافى % % له عن فعله ، مثل الأمير % PageV01P197 البحر : طويل 1(@)(@@) % بكيت ، فلما لم أر الدمع نافعي ، % رجعت إلى صبر ، أمر من الصبر % 2(@)(@@) % و قدرت أن الصبر ، بعد فراقهم ، % يساعدني ، وقتا ، فعزيت عن صبري % % PageV01P198 البحر : كامل تام 1(@)(@@) % ما زال معتلج الهموم بصدره % حتى أباحك ما طوى من سره % 2(@)(@@) % أضمرت حبك ، والدموع تذيعه ، % و طويت وجدك ، والهوى في نشره % 3(@)(@@) % ترد الدموع ، لما تجن ضلوعه ، % تترى إلى وجناته أو نحره % 4(@)(@@) % من لي بعطفة ظالم ، من شأنه % نسيان مشتغل اللسان بذكره ؟ % 5(@)(@@) % يا ليت مؤمنه سلوى - ما دعت % ورق الحمام - مؤمني من هجره % 6(@)(@@) % من لي برد الدمع ، قسرا ، والهوى % % يغدو عليه ، مشمرا ، في نصره ؟ % 7(@)(@@) % أعيا علي أخ ، وثقت بوده ، % وأمنت في الحالات عقبى غدره % 8(@)(@@) % وخبرت هذا الدهر خبرة ناقد % حتى أنست بخيره وبشره % 9(@)(@@) % لا أشتري بعد التجرب صاحبا % إلا وددت بأنني لم أشره % 10(@)(@@) % من كل غدار يقر بذنبه % فيكون أعظم ذنبه في عذره % PageV01P199 11(@)(@@) % ويجيء ، طورا ، ضره في تفعه ، % جهلا ، وطورا ، نفعه في ضره % % 12(@)(@@) % فصبرت لم أقطع حبال وداده % و سترت منه ، مااستطعت ، بستره % 13(@)(@@) % وأخ أطعت فما رأى لي طاعتي % % حتى خرجت ، بأمره ، عن أمره % 14(@)(@@) % و تركت حلو العيش لم أحفل به % لما رأيت أعزه في مره % % 15(@)(@@) % والمرء ليس ببالغ في أرضه ، % كالصقر ليس بصائد في وكره % 16(@)(@@) % أنفق من الصبر الجميل ، فإنه % لم يخش فقرا منفق من صبره % 17(@)(@@) % واحلم وإن سفه الجليس 
ms45	 ، وقل له % حسن المقال إذا أتاك بهجره % 18(@)(@@) % وأحب إخواني إلي أبشهم % % بصديقه في سره أو جهره % 19(@)(@@) % لا خير في بر الفتى ما لم يكن % أصفى مشارب بره في بشره % 20(@)(@@) % ألقى الفتى فأريد فائض بشره % و أجل أن أرضى بفائض بره % PageV01P200 21(@)(@@) % يارب مضطغن الفؤاد ، لقيته % بطلاقة ، فسللت ما في صدره % PageV01P201 البحر : طويل 1(@)(@@) % و ما كنت أخشى أن أبيت وبيننا % % خليجان و ' الدرب ' الأشم و ' آلس ' % 2(@)(@@) % ولا أنني أستصحب الصبر ساعة % ولي عنك مناع ودونك حابس % 3(@)(@@) % ينافسني فيك الزمان وأهله % وكل زمان لي عليك منافس % 4(@)(@@) % شريتك من دهري بذي الناس كلهم % % فلا أنا مبخوس ولا الدهر باخس % 5(@)(@@) % وملكتك النفس النفيسة طائعا ، % و تبذل للمولى النفوس النفائس % 6(@)(@@) % تشوقني الأهل الكرام وأوحشت % مواكب بعدي عندهم ومجالس % 7(@)(@@) % وربتما زان الأماجد ماجد ، % وربتما زان الفوارس فارس ! % 8(@)(@@) % رفعت على الحساد نفسي ؛ وهل هم % و ما جمعوا لو شئت إلا فرائس ؟ % 9(@)(@@) % أيدرك ما أدركت إلا ابن همة % يمارس في كسب العلى ما أمارس ؟ % 10(@)(@@) % يضيق مكاني عن سواي لأنني % % على قمة المجد المؤثل جالس % PageV01P202 11(@)(@@) % سبقت وقومي بالمكارم والعلا % و إن زعمت من آخرين المعاطس % PageV01P203 البحر : بسيط تام 1(@)(@@) % سقى ثرى ' حلب ' ما دمت ساكنها % % يا بدر ، غيثان منهل ومنبجس % 2(@)(@@) % أسير عنها وقلبي في المقام بها ، % كأن مهري لثقل السير محتبس % 3(@)(@@) % هذا ولولا الذي في قلب صاحبه % من البلابل لم يقلق به فرس % 4(@)(@@) % كأنما الأرض والبلدان موحشة ، % و ربعها دونهن العامر الأنس % 5(@)(@@) % مثل الحصاة التي يرمى بها أبدا % إلى السماء فترقى ثم تنعكس % PageV01P204 البحر : بسيط تام 1(@)(@@) % لمن أعاتب ؟ ما لي ؟ أين يذهب بي ؟ % قد صرح الدهر لي بالمنع والياس % 2(@)(@@) % أبغي الوفاء بدهر لا وفاء له ، % كأنني جاهل بالدهر والناس ! % PageV01P205 البحر : كامل تام 1(@)(@@) % لما رأت أثر السنان بخده % ظلت تقابله بوجه عابس ! % 2(@)(@@) % خلف السنان به موقع لثمها ، % بئس الخلافة للمحب البائس ! % PageV01P206 البحر : كامل تام 1(@)(@@) % ما أنس قولتهن 
ms46	 ، يوم لقينني : % ' أزرى السنان بوجه هذا البائس ! ' % 2(@)(@@) % قالت لهن ، وأنكرت ما قلنه : % أجميعكن على هواه منافسي ؟ % 3(@)(@@) % إني ليعجبني ، إذا عاينته ، % أثر السنان بصحن خد الفارس % PageV01P207 البحر : كامل تام 1(@)(@@) % المرء رهن مصائب لا تنقضي % % حتى يوارى جسمه في رمسه % 2(@)(@@) % فمؤجل يلقى الردى في أهله ، % ومعجل يلقى الردى في نفسه % PageV01P208 البحر : مخلع البسيط 1(@)(@@) % تناهض القوم للمعالي % % لما رأوا نحوها نهوضي % % 2(@)(@@) % تكلفوا المكرمات ، كدا ، % تكلف الشعر بالعروض % PageV01P209 البحر : هزج 1(@)(@@) % أيا قلبي ، أما تخشع ؟ % ويا علمي ، أما تنفع ؟ % 2(@)(@@) % أما حقي بأن أنظ % % ر للدنيا ، وما تصنع ؟ % 3(@)(@@) % أما شيعت أمثالي % % إلى ضيق من المضجع % 4(@)(@@) % أما أعلم أن لا ب % % د لي من ذلك المصرع ؟ % 5(@)(@@) % أيا غوثاه ، يا الل % % ه هذا الأمر ما أفظع ! ! % PageV01P210 البحر : طويل 1(@)(@@) % أبى غرب هذا الدمع إلا تسرعا % % ومكنون هذا الحب إلا تضوعا % % 2(@)(@@) % وكنت أرى أني مع الحزم واحد ، % إذا شئت لي ممضى وإن شئت مرجعا % % 3(@)(@@) % فلما استمر الحب في غلوائه ، % رعيت مع المضياعة الحب ما رعى % % 4(@)(@@) % فحزني حزن الهائمين مبرحا ، % و سري سر العاشقين مضيعا % % 5(@)(@@) % خليلي ، لم لا تبكياني صبابة ، % أأبدلتما بالأجرع الفرد أجرعا ؟ % 6(@)(@@) % علي ، لمن ضنت علي جفونه % غوارب دمع يشمل الحي أجمعا % % 7(@)(@@) % وهبت شبابي ، والشباب مضنة ، % لأبلج من أبناء عمي ، أروعا ! % 8(@)(@@) % أبيت ، معنى ، من مخافة عتبه ، % و أصبح ، محزونا ، وأمسي ، مروعا ! % 9(@)(@@) % فلما مضى عصر الشبيبة كله ، % وفارقني شرخ الشباب ، مودعا % % 10(@)(@@) % تطلبت بين الهجر والعتب فرجة ، % فحاولت أمرا ، لا يرام ، ممنعا % % PageV01P211 13(@)(@@) % وصرت إذا ما رمت في الخير لذة % تتبعتها بين الهموم ، تتبعا % % 14(@)(@@) % وها أنا قد حلى الزمان مفارقي ، % و توجني بالشيب تاجا مرصعا % % 15(@)(@@) % فلو أنني مكنت مما أريده % من العيش ، يوما ، لم يجد في موضعا ! % 16(@)(@@) % أما ليلة تمضي ولا بعض ليلة ! % أسر بها هذا الفؤاد المفجعا ؟ % 17(@)(@@) % أما صاحب فرد يدوم وفاؤه ! % فيصفي لمن أصفى ويرعى لمن رعى ؟ % 18(@)(@@) % أفي كل دار لي صديق أوده 
ms47	 ، % إذا ما تفرقنا حفظت وضيعا ؟ % 19(@)(@@) % أقمت بأرض الروم ، عامين ، لا أرى % % من الناس محزونا ولا متصنعا % % 20(@)(@@) % إذا خفت من أخوالي الروم خطة % تخوفت من أعمامي العرب أربعا % % 21(@)(@@) % و إن أوجعتني من أعادي شيمة % لقيت من الأحباب أدهى وأوجعا % % 22(@)(@@) % ولو قد رجوت الله لا شيء غيره % رجعت إلى أعلى وأملت أوسعا % % PageV01P212 23(@)(@@) % لقد قنعوا بعدي من القطر بالندى ، % و من لم يجد إلا القنوع تقنعا % % 24(@)(@@) % و ما مر إنسان فأخلف مثله ؛ % ولكن يزجي الناس أمرا موقعا % % 25(@)(@@) % تنكر ' سيف الدين ' لما عتبته ، % وعرض بي ، تحت الكلام ، وقرعا % % 26(@)(@@) % فقولا له : من أصدق الود أنني % % جعلتك مما رابني ، الدهر مفزعا % % 27(@)(@@) % و لو أنني أكننته في جوانحي % % لأورق ما بين الضلوع وفرعا % % 28(@)(@@) % فلا تغترر بالناس ، ما كل من ترى % % أخوك إذا أوضعت في الأمر أوضعا % % 29(@)(@@) % ولا تتقلد ما يروعك حليه % تقلد ، إذا حاربت ، ما كان أقطعا ! % 30(@)(@@) % ولا تقبلن القول من كل قائل ! % سأرضيك مرأى لست أرضيك مسمعا % % 31(@)(@@) % % و لله صنع قد كفاني التصنعا % % 32(@)(@@) % أراني طريق المكرمات ، كما أرى ، % علي وأسماني على كل من سعى % % PageV01P213 33(@)(@@) % فإن يك بطء مرة فلطالما % % تعجل ، نحوي ، بالجميل وأسرعا % % 34(@)(@@) % و إن يحف في بعض الأمور فانني % % لأشكره النعمى التي كان أودعا % % 35(@)(@@) % و إن يستجد الناس بعدي فلم يزل % بذاك البديل ، المستجد ، ممتعا ! % PageV01P214 البحر : بسيط تام 1(@)(@@) % و ما تعرض لي يأس سلوت به % إلا تجدد لي في إثره طمع % 2(@)(@@) % و لا تناهبت في شكوى محبته % إلا وأكثر مما قلت ما أدع % PageV01P215 البحر : مجزوء الكامل 1(@)(@@) % ما للعبيد من الذي % % يقضي به الله امتناع % 2(@)(@@) % ذدت الأسود عن الفرا % % ئس ، ثم تفرسني الضباع % PageV01P216 البحر : سريع 1(@)(@@) % المجد بالرقة مجموع ، % والفضل مرئي ومسموع % 2(@)(@@) % إن بها كل عميم الندى % % يداه للجود ينابيع % 3(@)(@@) % و كل مبذول القرى ، بيته ، % على علا العلياء ، ، مرفوع % % 4(@)(@@) % لكن أتاني خبر رائع % يضيق عنه السمع والروع % 5(@)(@@) % أن بني عمي ، وحاشاهم 
ms48	 ، % شعبهم بالخلف مصدوع % % 6(@)(@@) % مالعصا قومي قد شقها % % تفارط منهم وتضييع ؟ % 7(@)(@@) % بني أبي ، فرق ما بينكم % واش ، على الشحناء مطبوع ! % 8(@)(@@) % عودوا إلى أحسن ما كنتم ، % فأنتم الغر المرابيع ! % 9(@)(@@) % لا يكمل السؤدد في ماجد ، % ليس له عود ومرجوع % % 10(@)(@@) % أنبذل الود لأعدائنا ، % و هو عن الإخوة ممنوع ؟ ! % PageV01P217 11(@)(@@) % أو نصل الأبعد من قومنا ، % والنسب الأقرب مقطوع ؟ % 12(@)(@@) % لا يثبت العز على فرقة ، % غيرك بالباطل مخدوع ! % PageV01P218 البحر : طويل 1(@)(@@) % هي الدار من سلمى وهاتي المرابع ، % فحتى متى ياعين ، دمعك هامع ؟ ! % 2(@)(@@) % ألم ينهك الشيب الذي حل نازلا ؟ % وللشيب بعد الجهل للمرء رادع ! % 3(@)(@@) % لئن وصلت ' سلمى ' حبال مودتي % % فإن وشيك البين ، لا شك ، قاطع % 4(@)(@@) % و إن حجبت عنا النوى ' أم مالك ' % لقد ساعدتها كلة وبراقع ! % 5(@)(@@) % و إن ظمئت نفسي إلى طيب ريقها % % لقد رويت بالدمع مني المدامع % 6(@)(@@) % وإن أفلت تلك البدور عشية ، % فإن نحوسي بالفراق طوالع % 7(@)(@@) % ولما وقفنا للوداع ، غدية ، % أشارت إلينا أعين وأصابع % 8(@)(@@) % وقالت : أتنسى العهد بالجزع واللوى % % و ما ضمه منا النقا والأجارع ؟ % 9(@)(@@) % وأجرت دموعا من جفون لحاظها % % شفار ، على قلب المحب قواطع % % 10(@)(@@) % فقلت لها : مهلا ! فماالدمع رائعي ، % وما هو للقرم المصمم رائع ! % PageV01P219 11(@)(@@) % لئن لم أخل العيس وهي لواغب % حدابير ، من طول السرى ، وظوالع % 12(@)(@@) % فما أنا من ' حمدان ' في الشرف الذي % % له منزل بين السماكين طالع % % PageV01P220 البحر : كامل تام 1(@)(@@) % و لقد أبيت ، وجل ما أدعو به ، % حتى الصباح ، وقد أقض المضجع % 2(@)(@@) % لا هم ، إن أخي لديك وديعة % مني وليس يضيع ما تستودع ! % PageV01P221 البحر : سريع 1(@)(@@) % محلك الجوزاء ، بل أرفع ، % وصدرك الدهناء ، بل أوسع % 2(@)(@@) % وقلبك الرحب الذي لم يزل ، % للجد والهزل ، به موضع % 3(@)(@@) % رفه بقرع العود سمعا ، غدا % % قرع العوالي جل ما يسمع % PageV01P222 البحر : طويل 1(@)(@@) % لئن جمعتنا ، غدوة ، أرض ' بالس ' % فإن لها عندي يدا لا أضيعها % % 2(@)(@@) % أحب بلاد الله ، أرض تحلها ، % إلي ؛ ودار تحتويك ربوعها % % 3(@)(@@) % أفي كل يوم ، رحلة بعد رحلة % تجرع 
ms49	 نفسي ، حسرة ، وتروعها ؟ % 4(@)(@@) % فلي ، أبدا ، قلب كثير نزاعه ، % ولي ، أبدا ، نفس قليل نزوعها % % 12(@)(@@) % لحى الله قلبا لا يهيم صبابة % إليك ، وعينا لا تفيض دموعها % % PageV01P223 البحر : مجزوء الكامل 1(@)(@@) % أنظر إلى زهر الربيع ، % و الماء في برك البديع ، % 2(@)(@@) % و إذا الرياح جرت علي % % ه في الذهاب وفي الرجوع ، % 3(@)(@@) % نثرت على بيض الصفا % % ئح بيننا حلق الدروع % PageV01P224 البحر : خفيف تام 1(@)(@@) % كيف أرجو الصلاح من أمر قوم % ضيعوا الحزم فيه أي ضياع ؟ % 2(@)(@@) % فمطاع المقال غير سديد ، % وسديد المقال غير مطاع % PageV01P225 البحر : مجزوء الكامل 1(@)(@@) % من بحر شعرك أغترف ، % و بفضل علمك أعترف % 2(@)(@@) % أنشدتني ؛ فكأنما % % شققت عن در صدف % 3(@)(@@) % شعرا ، إذا ما قسته % بجميع أشعار السلف % 4(@)(@@) % قصرن ، دون قراه تق % % صير الحروف عن الألف % PageV01P226 البحر : مجزوء الكامل 1(@)(@@) % إني أقول بما علمت % ولا أجور ولا أخيف % 2(@)(@@) % أما علي الجعفري % ي فإنه الحر العفيف % 3(@)(@@) % نسب شريف ، زانه % في أهله خلق شريف % PageV01P227 البحر : طويل 1(@)(@@) % أيا ظالما ، أمسى يعاتب منصفا ! % أتلزمني ذنب المسيء تعجرفا ؟ % 2(@)(@@) % بدأت بتنميق العتاب ، مخافة ال % % عتاب ، وذكري بالجفا ، خشية الجفا ! % 3(@)(@@) % أوافي ، على علات عتبك ، صابرا % وألفى ، على حالات ظلمك ، منصفا % % 4(@)(@@) % و كنت ، إذا صافيت خلا ، منحته % بهجرانه وصلا ، ومن غدره وفا % % 5(@)(@@) % فهيج بي هذا الكتاب صبابة ، % و جدد لي هذا العتاب تأسفا % % 6(@)(@@) % فإن أدنت الأيام دارا بعيدة % شفى القلب مظلوم من العتب واشتفى ! % 7(@)(@@) % فإن كنته أقررت بالذنب ، تائبا ، % وإن لم أكن أمسكت عنه ، تألفا ! % PageV01P228 البحر : مجزوء الوافر 1(@)(@@) % غلام فوق ما أصف ، % كأن قوامه ألف % 2(@)(@@) % إذا ما مال يرعبني % % أخاف عليه ينقصف % 3(@)(@@) % و أشفق من تأوده ، % أخاف يذيبه الترف % 4(@)(@@) % سروري عنده لمع ، % و دهري ، كله ، أسف % 5(@)(@@) % وأمري ، كله ، أمم ، % وحبي وحده سرف % PageV01P229 البحر : كامل تام 1(@)(@@) % غيري يغيره الفعال الجافي ، % و يحول عن شيم الكريم الوافي % % 2(@)(@@) % لا أرتضي ودا ، إذا هو لم يدم % عند الجفاء ، وقلة الإنصاف % 3(@)(@@) % تعس الحريص 
ms50	 ، وقل ما يأتي به % عوضا من الإلحاح والإلحاف % 4(@)(@@) % إن الغني هو الغني بنفسه % ولو أنه عاري المناكب ، حاف % 5(@)(@@) % ما كل ما فوق البسيطة كافيا ، % فإذا قنعت فكل شيء كاف % 6(@)(@@) % وتعاف لي طمع الحريص أبوتي ، % و مروءتي ، وفتوتي ، وعفافي % % 7(@)(@@) % ما كثرة الخيل الجياد بزائدي % % شرفا ، ولا عدد السوام الضافي % % 8(@)(@@) % خيلي ، وإن قلت ، كثير نفعها % % بين الصوارم ، والقنا الرعاف % 9(@)(@@) % و مكارمي عدد النجوم ؛ ومنزلي % % مأوى الكرام ، ومنزل الأضياف % 10(@)(@@) % لا أقتني لصروف دهري عدة % حتى كأن صروفه أحلافي % % PageV01P230 11(@)(@@) % شيم عرفت بهن ، مذ أنا يافع ، % ولقد عرفت بمثلها أسلافي % % PageV01P231 البحر : مجزوء الرجز 1(@)(@@) % و مرتد بطرة ، % مسبلة الرفارف % 2(@)(@@) % كأنها مرسلة % من زرد مضاعف % PageV01P232 البحر : بسيط تام 1(@)(@@) % بعض الجفاة إلى المجفو مشتاق % ودون ما أمل المعشوق معتاق % 2(@)(@@) % أعصي الهوى ، وأطيع الرأي في ولد % بعد النصيحة رابت منه أخلاق % 3(@)(@@) % فما نظرت بعين السوء معتمدا % إليه إلا وللأحشاء إطراق % 4(@)(@@) % و ما دعاني إلى ما ساءه سخط % إلا ثناني إلى ما شاء إشفاق % PageV01P233 البحر : بسيط تام 1(@)(@@) % الحزن مجتمع ، والصبر مفترق ، % و الحب مختلف ، عندي ومتفق % 2(@)(@@) % ولي ، إذا كل عين نام صاحبها ، % عين تحالف فيها الدمع والأرق % 3(@)(@@) % لولاك يا ظبية الإنس ، التي نظرت ، % لما وصلن إلى مكروهي الحدق % 4(@)(@@) % لكن نظرت ، وقد سار الخليط ضحى ، % بناظر كل حسن منه مسترق % PageV01P234 البحر : وافر تام 1(@)(@@) % و لما عز دمع العين فاضت % دماء ، عند ترحال الفريق % 2(@)(@@) % وقد نظمت على خدي سموطا % من الدر المفصل بالعقيق % PageV01P235 البحر : - 1(@)(@@) % يا أخي قد وهبت ذنب زمان % طرقتني صروفه بالمهالك % 2(@)(@@) % لم يهب لي صبابة من رقاد % لم يجد لي فيها بطيف خيالك % 3(@)(@@) % قد قنعنا بذلك النزر منه ، % وغفرنا له الذنوب لذلك % PageV01P236 البحر : خفيف تام 1(@)(@@) % يا غلامي ، بل سيدي ، لن أملك ، % هب لمولاك ، لا عدمتك ، عدلك % 2(@)(@@) % خوف أن يصطفيك غيري بعدي % % لا أرى أن أقول قدمت قبلك % PageV01P237 البحر : مجزوء الكامل 1(@)(@@) % بالكره مني واختيارك ، % أن 
ms51	 لا أكون حليف دارك % 2(@)(@@) % يا تاركي ، إني لذك % رك ، ما حييت ، لغير تارك ! % 3(@)(@@) % كن كيف شئت ، فإنني % % ذاك المواسي والمشارك % PageV01P238 البحر : سريع 1(@)(@@) % أليك أشكو منك ، يا ظالمي ، % إذ ليس ، في العالم ، معد عليك % 2(@)(@@) % أعانك الله بخير ، أعن % من ليس يشكو منك إلا إليك % PageV01P239 البحر : متقارب تام 1(@)(@@) % أيا سافرا ! ورداء الخجل % مقيم بوجنته ، لم يزل ! % 2(@)(@@) % بعيشك ، رد عليك اللثام ! % أخاف عليك جراح المقل % 3(@)(@@) % فما حق حسنك أن يجتلى ، % ولا حق وجهك أن يبتذل % 4(@)(@@) % أمنت عليك صروف الزمان ، % كما قد أمنت علي الملل % PageV01P240 البحر : مجتث 1(@)(@@) % ما زلت تسعى بجد ، % برغم شانيك ، مقبل % 2(@)(@@) % ترى لنفسك أمرا ، % و ما يرى الله أفضل % % PageV01P241 البحر : سريع 1(@)(@@) % قد عذب الموت بأفواهنا % % والموت خير من مقام الذليل % 2(@)(@@) % إنا إلى الله ، لما نابنا ، % و في سبيل الله خير السبيل ! % PageV01P242 البحر : مجزوء الكامل 1(@)(@@) % قف في رسوم المستجا % % ب وحي أكناف المصلى ! % 2(@)(@@) % ف ' الجوسق ' الميمون ، ف ' الس % % قيا ' بها ، فالنهر أعلى ! % 3(@)(@@) % تلك المنازل ، والملا % % عب ، لا أراها الله محلا ! % 4(@)(@@) % أوطنتها زمن الصبا ؛ % وجعلت منبج لي محلا % 6(@)(@@) % حيث التفت رأيت ما % % ء سابحا ، وسكنت ظلا % 7(@)(@@) % تر دار ' وادي عين قا % % صر ' منزلا رحبا ، مطلا % 8(@)(@@) % وتحل بالجسر الجنا % % ن ، وتسكن الحصن المعلى % % 9(@)(@@) % تجلو عرائسه لنا % % هزج الذباب إذا تجلى % % 10(@)(@@) % و إذا نزلنا ب ' السوا % % جير ' اجتنينا العيش سهلا % 11(@)(@@) % والماء يفصل بين زه % % ر الروض ، في الشطين ، فصلا % % PageV01P243 12(@)(@@) % كبساط وشي ، جردت % أيدي القيون عليه نصلا % 13(@)(@@) % من كان سر بما عرا % % ني ، فليمت ضرا وهزلا % 14(@)(@@) % لم أخل ، فيما نابني ، % من أن أعز ، وأن أجلا % 15(@)(@@) % رعت القلوب ، مهابة ، % وملأتها ، فضلا ونبلا % 16(@)(@@) % ما غض مني حادث ؛ % والقرم قرم ، حيث حلا % 17(@)(@@) % أنى حللت فإنما % % يدعوني السيف المحلى % % 18(@)(@@) % فلئن خلصت فإنني % % شرق العدا ، طفلا وكهلا % 19(@)(@@) % ما كنت إلا السيف ، زا % % د على صروف الدهر صقلا % 20(@)(@@) % ولئن قتلت ، فإنما 
ms52	 % % موت الكرام الصيد قتلا % 24(@)(@@) % يغتر بالدنيا الجهو % % ل ، وليس في الدنيا مملا ! % PageV01P244 البحر : مجزوء الرمل 1(@)(@@) % أجملي يا أم عمر و ، % زادك الله جمالا % 2(@)(@@) % لا تبيعيني برخص ؛ % إن في مثلي يغالى ! % 3(@)(@@) % أنا ، إن جدت بوصل ، % أحسن العالم حالا ! % PageV01P245 البحر : كامل تام 1(@)(@@) % أأبا العشائر ، إن أسرت فطالما % % أسرت لك البيض الخفاف رجالا ! % 2(@)(@@) % لما أجلت المهر ، فوق رؤوسهم ، % نسجت له حمر الشعور عقالا % 3(@)(@@) % يا من إذا حمل الحصان على الوجى % % قال : اتخذ حبك التريك نعالا % 4(@)(@@) % ما كنت نهزة آخذ ، يوم الوغى ، % لو كنت أوجدت الكميت مجالا % 5(@)(@@) % حملتك نفس حرة وعزائم ، % قصرن من قلل الجبال طوالا % 6(@)(@@) % ورأين بطن العير ظهر عراعر ، % والروم وحشا ، والجبال رمالا % 7(@)(@@) % أخذوك في كبد المضايق ، غيلة ، % مثل النساء ، تربب الرئبالا % 8(@)(@@) % ألا دعوت أخاك ، وهو مصاقب % يكفي العظيم ، ويدفع ، الأهوالا ؟ % 9(@)(@@) % ألا دعوت أبا فراس ، إنه % ممن إذا طلب الممنع نالا ؟ % 10(@)(@@) % وردت ، بعيد الفوت ، أرضك خيله ، % سرعى ، كأمثال القطا أرسالا % PageV01P246 11(@)(@@) % زلل من الأيام فيك ، يقيله % ملك إذا عثر الزمان أقالا % 12(@)(@@) % ما زال ' سيف الدولة ' القرم ، الذي % % يلقى العظيم ، ويحمل الأثقالا % 13(@)(@@) % بالخيل ضمرا ، والسيوف قواضبا ، % و السمر لدنا ، والرجال عجالا % 14(@)(@@) % ومعود فك العناة ، معاود % قتل العداة ، إذا استغار أطالا % 15(@)(@@) % صفنا ' بخرشنة ' وقطعنا الشتا ، % و بنو البوادي في ' قمير ' حلالا % 16(@)(@@) % وسمت بهم همم إليك منيفة % لكنه حجر الخليج وجالا % 17(@)(@@) % وغدا تزورك بالفكاك خيوله ، % متثاقلات ، تنقل الأبطالا % 18(@)(@@) % إن ابن عمك ليس يغفل ، إنه % ملك الملوك ، وفكك الأغلالا ! % PageV01P247 البحر : مجزوء الكامل 1(@)(@@) % في الناس إن فتشتهم ، % من لا يعزك أو تذله % 2(@)(@@) % فاترك مجاملة اللئي % % م ، فإن فيها العجز كله % PageV01P248 البحر : وافر تام 1(@)(@@) % أيا عجبا لأمر ' : بني قشير ' ! % أراعونا ؛ وقالوا القوم قل % 2(@)(@@) % وكانوا الكثر ، يومئذ ؛ ولكن % % كثرنا ، إذ تعاركنا ، وقلوا % % 3(@)(@@) % وقال الهام للأجساد : هذا % % يفرق يننا إن لم تولوا ! % 4(@)(@@) % فولوا ، للقنا والبيض فيهم % وفي جيرانهم نهل وعل % 5(@)(@@) % ورحنا بالقلائع 
ms53	 ، كل نهد % مطل ، فوقه نهد مطل % PageV01P249 البحر : بسيط تام 1(@)(@@) % يا عمر الله سيف الدين مغتبطا ، % فكل حادثة يرمى بها جلل % 2(@)(@@) % من كان من كل مفقود لنا بدلا % فليس منه على حالاته بدل % 3(@)(@@) % يبكي الرجال ، و ' سيف الدين ' مبتسم ، % حتى عن ابنك تعطى الصبر ، يا جبل % 4(@)(@@) % لم يجهل القوم منه فضل ما عرفوا % % لكن عرفت من التسليم ما جهلوا % % 5(@)(@@) % هل تبلغ القمر المدفون رائعة % من المقال ، عليها للأسى حلل ؟ % 6(@)(@@) % ما بعد فقدك ، في أهل ، ولا ولد ، % و لا حياة ، ولا دنيا ، لنا ، أمل % 7(@)(@@) % يا من أتته المنايا ، غير حافلة ! % أين العبيد وأين الخيل والخول ؟ % 8(@)(@@) % أين الليوث ، التي حوليك ، رابضة ؟ % أين الصنائع ؟ أين الأهل ؟ ما فعلوا ؟ % 9(@)(@@) % أين السيوف التي يحميك أقطعها ؟ % أين السوابق ؟ أين البيض والأسل ؟ % 10(@)(@@) % ياويح خالك ! بل يا ويح كل فتى ! % أكل هذا تخطى ، نحوك ، الأجل ؟ % PageV01P250 البحر : سريع 1(@)(@@) % يا قرح ، لم يندمل الأول ! % فهل بقلبي لكما محمل ؟ % 2(@)(@@) % جرحان ، في جسم ضعيف القوى ، % حيث أصابا فهو المقتل ! % 3(@)(@@) % تقاسم الأيام أحبابنا ، % وقسمها الأفضل والأجمل % 4(@)(@@) % وليتها ، إذ أخذت قسمها ، % عن قسمنا تغمض أو تغفل % 5(@)(@@) % وقيت في الآخر من صرفها ال % % جائر ، ما جرعك الأول % 6(@)(@@) % ففدية المأسور مقبولة ، % وفدية الميت لا تقبل % 7(@)(@@) % لا تعدمن الصبر في حالة ، % فإنه للخلق الأجمل % 8(@)(@@) % وعشت في عز وفي نعمة ، % وجدك المقتبل المقبل % PageV01P251 البحر : طويل 1(@)(@@) % نعم ! تلك ، بين الواديين ، الخواتل % وذلك شاء ، دونهن ، وجامل % 2(@)(@@) % فما كنت ، إذ بانوا ، بنفسك فاعلا % فدونك مت ؛ إن الخليط لزائل % 3(@)(@@) % كأن ابنة القيسي ، في أخواتها ، % خذول ، تراعيها الظباء الخواذل % 4(@)(@@) % قشيرية ، قترية ، بدوية ، % لها ، بين أثناء الضلوع ، منازل % 5(@)(@@) % وهبت سلوي ، ثم جئت أرومه ، % ومن دون ما رمت القنا والقنابل % 6(@)(@@) % هوانا غريب ؛ شزب الخيل والقنا % % لنا كتب ، والباترات رسائل % 7(@)(@@) % أغرن على قلبي بخيل من الهوى % % فطارد عنهن الغزال المغازل % 8(@)(@@) % بأسهم لفظ ، لم تركب نصالها ، % و أسياف لحظ ، ما جلتها الصياقل 
ms54	 % 9(@)(@@) % وقائع قتلى الحب فيها كثيرة ، % ولم يشتهر سيف ، ولا هز ذابل % 10(@)(@@) % أراميتي ! كل السهام مصيبة ؛ % و أنت لي الرامي ؛ وكلي مقاتل % PageV01P252 12(@)(@@) % وإني لمقدام وعندك هائب ، % وفي الحي ' سحبان ' ؛ وعندك ' باقل ' % 13(@)(@@) % يضل علي القول ، إن زرت دارها ، % ويعزب عني وجه ما أنا فاعل % 14(@)(@@) % وحجتها العليا ، على كل حالة % فباطلها حق ، وحقي باطل % 20(@)(@@) % تطالبني بيض الصوارم والقنا % % بما وعدت حدي في المخايل % 21(@)(@@) % ولا ذنب لي ، إن الفؤاد لصارم ، % و إن الحسام المشرفي لفاصل % 22(@)(@@) % و إن الحصان الوالقي لضامر ، % وإن الأصم السمهري لعاسل % 23(@)(@@) % ولكن دهرا دافعتني خطوبه % كما دفع الدين الغريم المماطل % 24(@)(@@) % و أخلاف أيام ، إذا ما انتجعتها ، % حلبت بكيات ، وهن حوافل % 25(@)(@@) % ولو نيلت الدنيا بفضل منحتها % % فضائل تحويها وتبقى فضائل % 32(@)(@@) % ولكنهما الأيام ، تجري بما جرت ، % فيسفل أعلاها ، ويعلو الأسافل % PageV01P253 33(@)(@@) % لقد قل أن تلقى من الناس مجملا % وأخشى ، قريبا ، أن يقل المجامل % 38(@)(@@) % ولست بجهم الوجه في وجه صاحبي % % ولا قائل للضيف : هل أنت راحل ؟ % 39(@)(@@) % ولكن قراه ما تشهى ، ورفده ، % ولو سأل الأعمار ما هو سائل % 40(@)(@@) % ينال اختيار الصفح عن كل مذنب % له عندنا ما لا تنال الوسائل % 41(@)(@@) % لنا عقب الأمر ، الذي في صدوره % تطاول أعناق العدا ، والكواهل % 42(@)(@@) % أصاغرنا ، في المكرمات ، أكابر % أواخرنا ، في المأثرات ، أوائل % 43(@)(@@) % إذا صلت ، يوما ، لم أجد لي مصاولا ؛ % وإن قلت ، يوما ، لم أجد من يقاول ! % PageV01P254 البحر : بسيط تام 1(@)(@@) % يا من أتانا بظهر الغيب ، قولهم % لو شئت ، غاظتكم منا الأقاويل % 2(@)(@@) % لكن أرى أن في الأقوال منقصة % ما لم تسد الأقاويل الأفاعيل % PageV01P255 البحر : بسيط تام 1(@)(@@) % أحل بالأرض يخشى الناس جانبها % % ولا أسائل أنى يسرح المال % 2(@)(@@) % فهيبتي في طراد الخيل واقعة % والناس فوضى ، ومال الحي إهمال % 3(@)(@@) % كذاك نحن ؛ إذا ما أزمة طرقت % حيا ، بحيث يخاف الناس ، حلال ! % PageV01P256 البحر : بسيط تام 1(@)(@@) % ألعذر منك ، على الحالات مقبول ؛ % والعتب منك ، على العلات ، محمول % 2(@)(@@) % لولا اشتياقي لم أقلق لبعدكم ، % ولا 
ms55	 غدا في زماني ، بعدكم ، طول % 3(@)(@@) % وكل منتظر ، إلاك ، محتقر ، % و كل شيء ، سوى لقياك ، مملول ! % PageV01P257 البحر : طويل 1(@)(@@) % إذا لم يعنك الله فيما ترومه ، % فليس لمخلوق إليه سبيل % 2(@)(@@) % وإن هو لم ينصرك لم تلق ناصرا % وإن عز أنصار وجل قبيل % 3(@)(@@) % وإن هو لم يرشدك في كل مسلك % ضللت ، ولو أن السماك دليل ! % PageV01P258 البحر : طويل 1(@)(@@) % مصابي جليل ، والعزاء جميل ، % وظني بأن الله سوف يديل % 5(@)(@@) % جراح ، تحاماها الأساة ، مخوفة ، % وسقمان : باد ، منهما ودخيل % 6(@)(@@) % و أسر أقاسيه ، وليل نجومه ، % أرى كل شيء ، غيرهن ، يزول % 7(@)(@@) % تطول بي الساعات ، وهي قصيرة ؛ % وفي كل دهر لا يسرك طول ! % 8(@)(@@) % تناساني الأصحاب ، إلا عصيبة % ستلحق بالأخرى ، غدا ، وتحول ! % 9(@)(@@) % و من ذا الذي يبقى على العهد ؟ إنهم ، % و إن كثرت دعواهم ، لقليل ! % 10(@)(@@) % أقلب طرفي لا أرى غير صاحب ، % يميل مع النعماء حيث تميل % 11(@)(@@) % وصرنا نرى : أن المتارك محسن ؛ % وأن صديقا لا يضر خليل % 14(@)(@@) % فكل خليل ، هكذا ، غير منصف ! % وكل زمان بالكرام بخيل ! % 15(@)(@@) % نعم ، دعت الدنيا إلى الغدر دعوة ، % أجاب إليها عالم ، وجهول % PageV01P259 17(@)(@@) % وفارق عمرو بن الزبير شقيقه ، % وخلى أمير المؤمنين عقيل ! % 18(@)(@@) % فيا حسرتا ، من لي بخل موافق % أقول بشجوي ، مرة ، ويقول ! % 19(@)(@@) % وإن ، وراء الستر ، أما بكاؤها % % علي ، وإن طال الزمان ، طويل ! % 20(@)(@@) % فيا أمتا ، لا تعدمي الصبر ، إنه % إلى الخير والنجح القريب رسول ! % 21(@)(@@) % ويا أمتا ، لا تخطئي الأجر ! إنه % على قدر الصبر الجميل جزيل % 23(@)(@@) % أما لك في ' ذات النطاقين ' أسوة ، % ب ' مكة ' والحرب العوان تجول ؟ % 24(@)(@@) % أراد ابنها أخذ الأمان فلم تجب % و تعلم ، علما أنه لقتيل ! % 25(@)(@@) % تأسي ! كفاك الله ما تحذرينه ، % فقد غال هذا الناس قبلك غول ! % 26(@)(@@) % و كوني كما كانت ب ' أحد ' ' صفية ' % ولم يشف منها بالبكاء غليل ! % 27(@)(@@) % ولو رد ، يوما ' حمزة الخير ' حزنها % % إذا ما علتها رنة وعويل % PageV01P260 29(@)(@@) % لقيت نجوم الأفق وهي صوارم ، % وخضت سواد الليل ، وهو خيول % 30(@)(@@) % ولم أرع للنفس الكريمة خلة 
ms56	 ، % عشية لم يعطف علي خليل % 31(@)(@@) % ولكن لقيت الموت ، حتى تركتها ، % وفيها وفي حد الحسام فلول % 32(@)(@@) % ومن لم يوق الله فهو ممزق ! % ومن لم يعز الله ، فهو ذليل ! % 33(@)(@@) % و من لم يرده الله ، في الأمر كله ، % فليس لمخلوق إليه سبيل % PageV01P261 البحر : وافر تام 1(@)(@@) % ومغض ، للمهابة ، عن جوابي ! % وإن لسانه العضب الصقيل % 2(@)(@@) % أطلت عتابه ، عنتا وظلما ، % فجمجم ، ثم قال : ' كما تقول ! ' % PageV01P262 البحر : طويل 1(@)(@@) % وما لي لا أثني عليك ، وطالما % % وفيت بعهدي ، والوفاء قليل ؟ % 2(@)(@@) % و أوعدتني حتى إذا ما ملكتني % % صفحت ، وصفح المالكين جميل ! % PageV01P263 البحر : متقارب تام 1(@)(@@) % بقلبي ، على ' جابر ' ، حسرة % تزول الجبال ، وليست تزول % 2(@)(@@) % له ، ما بقيت ، طويل البكاء % و حسن الثناء ؛ وهذا قليل % PageV01P264 البحر : بسيط تام 1(@)(@@) % الدهر يومان : ذا ثبت ، وذا زلل ، % والعيش طعمان : ذا صاب وذا عسل % 2(@)(@@) % كذا الزمان ؛ فما في نعمة بطر % للعارفين ؛ ولا في نقمة فشل % 3(@)(@@) % سعادة المرء في السراء إن رجحت ، % والعدل أن يتساوى الهم والجذل % 4(@)(@@) % وما الهموم ، وإن حاذرت ، ثابتة % ولا السرور ، وإن أملت يتصل % 5(@)(@@) % فما الأسى لهموم ، لابقاء لها ، % وما السرور بنعمى ، سوف تنتقل % 6(@)(@@) % لكن في الناس مغرورا بنعمته ، % ما جاءه اليأس حتى جاءه الأجل % PageV01P265 البحر : وافر تام 1(@)(@@) % وعطاف على الغمرات نحوي ، % تحف به المثقفة الطوال % 2(@)(@@) % تركت الرمح ، يخطر في حشاه ، % له ، ما بين أضلعه ، مجال % 3(@)(@@) % يقول ، وقد تعدل فيه ، رمحي : % ' لأمر ما تحاماك الرجال ! ' % PageV01P266 البحر : بسيط تام 1(@)(@@) % قد ضج جيشك ، من طول القتال به ، % وقد شكتك إلينا الخيل والإبل ! % 2(@)(@@) % وقد درى الروم مذ جاورت أرضهم % أن ليس يعصمهم سهل ولا جبل % 3(@)(@@) % في كل يوم تزور الثغر ، لا ضجر % يثنيك عنه ، ولا شغل ولا ملل % 4(@)(@@) % فالنفس جاهدة ، والعين ساهدة ، % والجيش منهمك ، والمال مبتذل % 5(@)(@@) % توهمتك كلاب غير قاصدها ، % وقد تكنفك الأعداء والشغل % 6(@)(@@) % حتى رأوك ، أمام الجيش ، تقدمه % وقد طلعت عليهم دون ما أملوا % % 7(@)(@@) % فاستقبلوك بفرسان ، أسنتها % % سود البراقع ، والأكوار ، والكلل % 8 
ms57	(@)(@@) % فكنت أكرم مسؤول وأفضله ، % إذا وهبت فلا من ولا بخل % PageV01P267 البحر : كامل تام 1(@)(@@) % ويقول في الحاسدون ، تكذبا ، % ويقال في المحسود ما لا يفعل % 2(@)(@@) % يتطلبون إساءتي لا ذمتي ، % إن الحسود ، بما يسوء ، موكل % PageV01P268 البحر : طويل 1(@)(@@) % أقلي ، فأيام المحب قلائل ، % وفي قلبه شغل عن اللوم شاغل % 2(@)(@@) % ولعت بعذل المستهام على الهوى ، % وأولع شيء بالمحب العواذل % 3(@)(@@) % أريتك ، هل لي من جوى الحب مخلص ، % وقد نشبت ، للحب في ، حبائل ؟ % 4(@)(@@) % وبين بنيات الخدور وبيننا % % حروب ، تلظى نارها وتطاول % 5(@)(@@) % أغرن على قلبي بجيش من الهوى % % وطارد عنهن الغزال المغازل % 6(@)(@@) % تعمد بالسهم المصيب مقاتلي ، % ألا كل أعضائي ، لديه ، مقاتل % 7(@)(@@) % ووالله ، ماقصرت في طلب العلا ؛ % ولكن كأن الدهر عني غافل % 8(@)(@@) % مواعيد آمال ، تماطلني بها % % مراماة أزمان ، ودهر مخاتل % 9(@)(@@) % تدافعني الأيام عما أريده ، % كما دفع الدين الغريم المماطل % 10(@)(@@) % خليلي ، أغراضي بعيد منالها ! % فهل فيكما عون على ما أحاول ؟ % PageV01P269 11(@)(@@) % خليلي ! شدا لي على ناقتيكما % % إذا مابدا شيب من العجز ناصل % 13(@)(@@) % فمثلي من نال المعالي بسيفه ، % وربتما غالته ، عنها ، الغوائل % 14(@)(@@) % وما كل طلاب ، من الناس ، بالغ % ولا كل سيار ، إلى المجد ، واصل ! % 15(@)(@@) % وإن مقيما منهج العجز خائب % وإن مريغا ، خائب الجهد ، نائل % 16(@)(@@) % وما المرء إلا حيث يجعل نفسه % وإني لها ، فوق السماكين ، جاعل % 17(@)(@@) % وللوفر متلاف ، وللحمد جامع ، % وللشر تراك ، وللخير فاعل % 18(@)(@@) % وما لي لا تمسي وتصبح في يدي % % كرائم أموال الرجال العقائل ؟ % 19(@)(@@) % أحكم في الأعداء منها صوارما % أحكمها فيها إذا ضاق نازل % 20(@)(@@) % و مانال محمي الرغائب ، عنوة ، % سوى ما أقلت في الجفون الحمائل % PageV01P270 البحر : بسيط تام 1(@)(@@) % سكرت من لحظه لا من مدامته % و مال بالنوم عن عيني تمايله % 2(@)(@@) % وما السلاف دهتني بل سوالفه ، % و لا الشمول ازدهرني بل شمائله % 3(@)(@@) % وغال صبري ما تحوي غلائله % و غال قلبي ما تحوي غلائله % PageV01P271 البحر : طويل 1(@)(@@) % لحبك من قلبي حمى لا يحله % سواك ، وعقد ليس خلق يحله % 2(@)(@@) % وقد كنت 
ms58	 أطلقت المنى لي بموعد % و قدرت لي وقتا ، وهذا محله ! % 3(@)(@@) % ففي أي حكم ؟ أو على أي مذهب % تحل دمي ؟ والله ليس يحله ! % PageV01P272 البحر : متقارب تام 1(@)(@@) % أفر من السوء لا أفعله % ومن موقف الضيم لا أقبله % 2(@)(@@) % وقربى القرابة أرعى لها ، % وفضل أخي الفضل لا أجهله % 3(@)(@@) % و أبذل عدلي للأضعفين ؛ % و للشامخ الأنف لا أبذله % 4(@)(@@) % و أحسن ما كنت بقيا إذا % % أنالني الله ما آمله % 5(@)(@@) % وقد علم الحي ، حي الضباب ، % و أصدق قيل الفتى أفضله % 6(@)(@@) % بأني كففت ، وأني عففت ، % و إن كره الجيش ما أفعله % 7(@)(@@) % وقد أرهق الحي ، من خلفه % و أوقف ، خوف الردى ، أوله % 8(@)(@@) % فعادت ' عدي ' بأحقادها ، % وقد عقل الأمر من يعقله % PageV01P273 البحر : منسرح 1(@)(@@) % يا حسرة ما أكاد أحملها ، % آخرها مزعج ، وأولها ! % 2(@)(@@) % عليلة ، بالشآم مفردة ، % بات ، بأيدي العدا ، معللها % % 3(@)(@@) % تمسك أحشاءها ، على حرق % أنت ، على يأسها ، مؤملها % % 4(@)(@@) % إذا اطمأنت - وأين ؟ - أو هدأت ؛ % عنت لها ذكرة تقلقلها % % 5(@)(@@) % تسأل عنا الركبان ، جاهدة % بأدمع ما تكاد تمهلها : % 6(@)(@@) % ' يامن رأى لي ، بحصن ' خرشنة ' % أسد شرى ، في القيود أرجلها ! ' % 7(@)(@@) % ' يامن رأى لي الدروب ، شامخة % دون لقاء الحبيب أطولها ' % 8(@)(@@) % يامن رأى لي القيود ، موثقة ، % على حبيب الفؤاد أثقلها ! ' % 9(@)(@@) % يا أيها الراكبان ، هل لكما % % في حمل نجوى ، يخف محملها ؟ ! % 10(@)(@@) % قولا لها ، إن وعت مقالكما ، % وإن ذكري لها ليذهلها : % PageV01P274 11(@)(@@) % يا أمتا ، هذه منازلنا % % نتركها تارة ، وننزلها ! % 12(@)(@@) % يا أمتا ، هذه مواردنا % % نعلها تارة ، وننهلها ! ' % 13(@)(@@) % ' أسلمنا قومنا إلى نوب % أيسرها في القلوب أقتلها ' % 14(@)(@@) % ' واستبدلوا ، بعدنا ، رجال وغى % يود أدنى علاي أمثلها ' % 15(@)(@@) % يا سيدا ، ما تعد مكرمة ، % إلا وفي راحتيه أكملها % % 16(@)(@@) % ليست تنال القيود من قدمي ، % وفي اتباعي رضاك ، أحملها % % 17(@)(@@) % لاتتيمم ، والماء تدركه ! % غيرك يرضى الصغرى ويقبلها % % 18(@)(@@) % إن بني العم لست تحلفهم ؛ % إن عادت الأسد عاد أشبلها % % 19(@)(@@) % أنت سماء ، ونحن أنجمها ، % أنت بلاد ، ونحن أجبلها ! % 20(@)(@@) % أنت سحاب ، ونحن وابله ، % أنت يمين ، ونحن أنملها 
ms59	 ! % PageV01P275 21(@)(@@) % بأي عذر ، رددت والهة ، % عليك ، دون الورى ، معولها % % 22(@)(@@) % جاءتك ، تمتاح رد واحدها ، % ينتظر الناس كيف تقفلها ! % 23(@)(@@) % سمحت مني بمهجة كرمت % أنت ، على يأسها ، مؤلمها % % 24(@)(@@) % إن كنت تبذل الفداء لها ! % فلم أزل ، في رضاك ، أبذلها % % 25(@)(@@) % تلك المودات ، كيف تهملها ؟ % تلك المواعيد ، كيف تغفلها ؟ % 26(@)(@@) % تلك العقود ، التي عقدت لنا ، % كيف ، وقد أحكمت ، تحللها ؟ % 27(@)(@@) % أرحامنا منك ؛ لم تقطعها ؟ % % 28(@)(@@) % أين المعالي التي عرفت بها ، % تقولها ، دائما ، وتفعلها ؟ % 29(@)(@@) % يا واسع الدار ، كيف توسعها % % ونحن في صخرة نزلزلها ! % 30(@)(@@) % يا ناعم الثوب ! كيف تبدله ؟ % ثيابنا الصوف ما نبدلها ! % PageV01P276 31(@)(@@) % يا راكب الخيل ! لو بصرت بنا % % نحمل أقيادنا ، وننقلها ! % 32(@)(@@) % رأيت ، في الضر ، أوجها كرمت % فارق فيك الجمال أجملها ! % 33(@)(@@) % قد أثر الدهر في محاسنها ، % تعرفها ، تارة ، وتجهلها % % 34(@)(@@) % فلا تكلنا ، فيها ، إلى أحد ، % معلها محسن يعللها % % 35(@)(@@) % لا يفتح الناس باب مكرمة % صاحبها المستغاث يقفلها % % 36(@)(@@) % أينبري ، دونك ، الكرام لها % % وأنت قمقامها ، وأحملها ! % 37(@)(@@) % و أنت ، إن عن حادث جلل ، % قلبها المرتجى ، وحولها ! % 38(@)(@@) % منك تردى بالفضل أفضلها ، % منك أفاد النوال أنولها % % 39(@)(@@) % فإن سألنا سواك عارفة ، % فبعد قطع الرجاء نسألها % % 40(@)(@@) % إذا رأينا أولى الكرام بها % % يضيعها ، جاهدا ، ويهملها % % PageV01P277 41(@)(@@) % لم يبق ، في الناس ، أمة عرفت % إلا وفضل ' الأمير ' يشملها % % 42(@)(@@) % نحن أحق الورى برأفته ، % فأين عنا ؟ وأين معدلها ؟ % 43(@)(@@) % يا منفق المال ، لا يريد به % إلا المعالي التي يؤثلها % % 44(@)(@@) % أصبحت تشري مكارما فضلا % فداؤنا ، قد علمت ، أفضلها ! % 45(@)(@@) % لا يقبل الله ، قبل فرضك ذا ، % نافلة عنده تنفلها ! % PageV01P278 البحر : سريع 1(@)(@@) % أي اصطبار ليس بالزائل ؟ % و أي دمع ليس بالهامل ؟ % 2(@)(@@) % إنا فجعنا بفتى ' وائل % لما فجعنا ' بأبي وائل ' % 3(@)(@@) % المشتري الحمد بأمواله ، % والبائع النائل بالنائل % 4(@)(@@) % ماذا أرادت سطوات الردى % % بالأسد ابن الأسد ، الباسل ؟ % 5(@)(@@) % السيد ابن السيد ، المرتجى ، % والعالم ابن العالم ، الفاضل ! % 6(@)(@@) % أقسمت : لو لم يحكه ذكره % رجعن عنه بشبا ثاكل % 7(@)(@@) % كأنما دمعي ، من بعده % صوب سحاب واكف ، وابل % 8(@)(@@) % ما 
ms60	 أنا أبكيه ، ولكنما % % تبكيه أطراف القنا الذابل % 9(@)(@@) % ما كان إلا حدثا نازلا ، % موكلا بالحدث النازل % 10(@)(@@) % دان إلى سبل الندى والعلا ، % ناء عن الفحشاء والباطل % PageV01P279 11(@)(@@) % أرى المعالي ، إذ قضى نحبه ، % تبكي بكاء الواله ، الثاكل % 12(@)(@@) % الأسد الباسل ، والعارض ال % % هاطل ، عند الزمن الماجل % 13(@)(@@) % لو كان يفدي معشر هالكا % فداه من حاف ، ومن ناعل % 14(@)(@@) % فكم حشا قبرك من راغب ! % وكم حشا تربك من آمل ! % 15(@)(@@) % سقى ثرى ، ضم ' أبا وائل ' ، % صوب عطايا كفه الهاطل ! % 16(@)(@@) % لا در در الدهر - ما باله % حملني ما لست بالحامل ؟ % 17(@)(@@) % كان ابن عمي ، إن عرا حادث ، % كالليث ، أو كالصارم الصاقل % 18(@)(@@) % كان ابن عمي عالما ، فاضلا ، % والدهر لا يبقي على فاضل % 19(@)(@@) % كان ابن عمي بحر جود طمى % % لكنه بحر بلا ساحل % 20(@)(@@) % من كان أمسى قلبه خاليا % فإنني في شغل شاغل % PageV01P280 البحر : وافر تام 1(@)(@@) % ضلال مارأيت من الضلال % معاتبة الكريم على النوال % 2(@)(@@) % وإن مسامعي ، عن كل عذل ، % لفي شغل بحمد أو سؤال % 3(@)(@@) % ولا والله ، ما بخلت يميني ، % ولا أصبحت أشقاكم بمالي % % 4(@)(@@) % ولا أمسي يحكم فيه يعدي % % قليل الحمد ، مذموم الفعال % 5(@)(@@) % ولكني سأفنيه ، وأقني % % ذخائر من ثواب أو جمال % 6(@)(@@) % وللوراث إرث أبي وجدي ، % جياد الخيل والأسل الطوال % 7(@)(@@) % وما تجني سراة بني أبينا % % سوى ثمرات أطراف العوالي % % 8(@)(@@) % ممالكنا مكاسبنا ، إذا ما % % توارثها رجال عن رجال % 9(@)(@@) % إذا لم تمس لي نار فإني % % أبيت ، لنار غيري ، غير صال % 10(@)(@@) % أوينا ، بين أطناب الأعادي ، % إلى بلد ، من النصار خال % PageV01P281 11(@)(@@) % نمد بيوتنا ، في كل فج ، % به بين الأراقم والصلال % 14(@)(@@) % نعاف قطونه ، ونمل منه ، % ويمنعنا الإباء من الزيال % 15(@)(@@) % مخافة أن يقال ، بكل أرض : % بنو حمدان كفوا عن قتال % 16(@)(@@) % أسيف الدولة المأمول ، إني % % عن الدنيا ، إذا ما عشت ، سال % 17(@)(@@) % ومن ورد المهالك لم ترعه % رزايا الدهر في أهل ومال % 19(@)(@@) % إذا قضي الحمام علي ، يوما % ففي نصر الهدى بيد الضلال % 20(@)(@@) % مخافة أن يقال 