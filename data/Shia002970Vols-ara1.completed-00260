ms241	 بن عمران الثقة عنه ابن أبي عبد الله.(@)(@@)(@@)(@@) $ 2490 - عمير بن عطار " دي ".(@)(@@)(@@)(@@) $ 2491 - عون بن سالم كوفي ثقة قليل الحديث " صه " " جش " له كتاب، حميد عن إبراهيم عنه " جش " وفي " مشكا " ابن سالم الثقة عنه إبراهيم.(@)(@@)(@@)(@@) $ 2492 - عون بن جرير صاحب عمر بن هارون الثقفي، عنه محمد بن خالد البرقي " جش " " ست " " لم " الا أن فيه روى عنه أحمد بن أبي عبد الله، وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 2493 - عيسى بن جعفر بن عاصم، وفيه حديث يدل على مدحه الا انه ضعيف السند، وهو متضمن أنه ضرب ثلاثمائة سوط ورمي به في دجله ويمكن الاعتماد عليه، لما يظهر من الشيخ بكونه وكيلا وأنه ممن رأى القائم عليه السلام ووقف على معجزته، واعتناء المشايخ بالرواية المذكورة، فتأمل.(@)(@@)(@@)(@@) $ 2494 - عيسى بن داود النجار، كوفي من أصحابنا قليل الرواية، روى عن " ظم " عليه السلام له كتاب التفسير عنه محمد بن سالم بن عبد الرحمن " جش " أقول:(@)(@@) يظهر منه أنه من مصنفي الامامية، فهو حسن وفي الوجيزة " ح " وفي " مشكا " عنه محمد بن سالم بن عبد الرحمن.(@)(@@)(@@)(@@) $ 2495 - عيسى بن عبد الله بن محمد الهاشمي، له كتاب عنه أو سمينة " ست " " جش " والنوفلي " ست " وقد جمع أبو بكر محمد بن سالم الجعابي روايات عيسى PageV01P337(@)(@@) عن آبائه أخبرنا محمد بن عثمان به " جش ".(@)(@@)(@@)(@@) $ 2496 - عيسى بن عثمان، من أصحاب " ضا " مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2497 - عيسى بن عيسى الكلابي، وليس هو الرواسي من أصحاب أبي الحسن الرضا عليه السلام كوفي واقفي " صه " " جخ " مولى بني عامر " ضا " " د ".(@)(@@)(@@)(@@) $ 2498 - عيسى بن المستفاد أبو موسى البجلي الضرير، روى عن أبي جعفر الجواد عليه السلام ولم يكن بذلك، وهو في نفسه ضعيف، له كتاب رواه عبيد الله بن عبد الله الدهقان عنه " ست ".(@)(@@)(@@)(@@) $ 2499 - عيسى بن مهران المستعطف أبو موسى، له عدة كتب " جش " عنه أحمد بن محمد بن موسى النوفلي " لم " " ست " " جش ".(@)(@@)(@@)(@@) $ 2500 - عيسى بن هشام، له كتاب يرويه محمد بن الحسين عنه " جش ".(@)(@@)(@@)(@@) $ 2501 - فارس 
ms242	 بن حاتم بن ما هوية نزيل العسكر القزويني، من أصحاب " ضا " عليه السلام قلما روى الحديث الا شاذا " صه " " جش " غال ملعون لعنه " دي " وكذا الحسن المعروف بابن بابا ومحمد بن نصير النميري.(@)(@@)(@@)(@@) $ 2502 - فتح بن يزيد الجرجاني صاحب المسائل، عنه المختار بن بلال بن المختار، وأحمد بن أبي عبد الله، الا أنهم اختلفوا في أن المسائل لأبي الحسن عليه السلام هو الثاني أو الثالث عليه السلام والرجل مجهول، والاسناد إليه مدخول.(@)(@@)(@@)(@@) $ 2503 - فرج السندي له كتاب عنه أحمد بن رباح " ست ".(@)(@@)(@@)(@@) $ 2504 - الفرج مولى علي بن يقطين " ظم " قال الميرزا: الاتحاد محتمل لمناسبة توافق الطبقة، واحتمال وجود الوصفين، فيعرف تارة بأحدهما وأخرى بالآخر.(@)(@@)(@@)(@@) $ 2505 - فضالة بن أيوب الأزدي ثقة " ظم " عربي " ضا " " جش " صميم سكن الأهواز روى عن موسى، وكان ثقة في حديثه مستقيما في دينه، وكذا " صه " غير الصميم، عنه الحسين.(@)(@@)(@@)(@@) $ 2506 - الفضل بن إسماعيل الكندي، رجل من أصحابنا، ثقة قليل الحديث له كتاب " ست " " جش " عنه محمد بن علي بن محبوب، ومحمد بن علي بن أيوب، مع PageV01P338(@)(@@) تأمل في الثاني.(@)(@@)(@@)(@@) $ 2507 - الفضل بن دكين في " تعق " مر عن المصنف ترجمة أحمد بن ميثم أنه رجل مشهور من علماء الحديث، ويظهر ذلك أيضا من ترجمة بن أبي يونس وفيها أن كنيته أبو نعيم انتهى. أقول: ويظهر من العامة أنه منهم، ولكن عن ابن الأثير أنه كان شيعيا ومن مشايخ مسلم والبخاري.(@)(@@)(@@)(@@) $ 2508 - الفضل بن سنان نيسابوري من أصحاب " ضا " عليه السلام وكيل " صه " " جخ " الا من أصحاب " ضا " عليه السلام.(@)(@@)(@@)(@@) $ 2509 - الفضل بن سهل ذو الرياستين " ضا " " د ".(@)(@@)(@@)(@@) $ 2510 - الفضل بن شاذان، كان أبو ه من أصحاب يونس، روى عن أبي جعفر الثاني عليه السلام وقيل: عن أبي الحسن " ضا " ثقة جليل متكلم له عظم شان في هذه الطائفة، وهو في السابقة.(@)(@@)(@@)(@@) $ 2511 - الفضل بن محمد الأشعري، له كتاب، عنه الحسن بن علي بن فضال، هو أخو إبراهيم لهما كتاب مشترك بينهما " ست " روى عنهما الحسن بن علي 
ms243	 بن فضال " ست " " جش " وفي " تعق " أخذ معرفا لأخيه إبراهيم في " لم " فلاحظ ويروي عنهما ابن أبي عمير فتأمل، مضافا إلى كونه اماميا عند الشيخ و " جش ".(@)(@@)(@@)(@@) $ 2512 - الفضيل بن عثمان الصيرفي، له كتاب عنه الحسن بن محمد بن سماعة " ست " قال: وأظن أنهما - يعني هو مع فضيل الأعور - واحد انتهى وهو رجم بالغيب.(@)(@@)(@@)(@@) $ 2513 - فيهس " لم " " ست " له أخبار عنه محمد بن حسان الرازي " ست ".(@)(@@)(@@)(@@) $ 2514 - القاسم بن أسباط، من أصحاب أبي الحسن الرضا عليه السلام مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2515 - القاسم بن الحسين البزنطي، صاحب أيوب بن نوح " ج " فعلى هذا يمكن أن يروي عن أبي الحسن الثالث عليه السلام وهو في السابقة.(@)(@@)(@@)(@@) $ 2516 - القاسم الصقيل " دي " ليس له مدح ولا ذم فيترك ما يتفرد به. PageV01P339(@)(@@)(@@)(@@) $ 2517 - القاسم بن عروة، روى عنه البرقي أحمد " لم " وفي المنتهى وقد يحتمل الاتحاد انتهى. أقول: يعني الاتحاد مع الآتي في الآتية الذين يروي عن " ق " وبعده قريب.(@)(@@)(@@)(@@) $ 2518 - القاسم بن محمد الأصفهاني المعروف بكاسام، عنه أحمد بن أبي عبد الله " ست " الا أن فيه المعروف بكاسولا، له كتاب، وفي " تعق " صحيح في " صه " طريق " ق " إلى سليمان المقري وهو فيه.(@)(@@)(@@)(@@) $ 2519 - القاسم بن محمد بن أيوب بن ميمون من جلة أصحابنا وليس بكاسولا " صه ".(@)(@@)(@@)(@@) $ 2520 - القاسم بن محمد الجوهري، من أصحاب " ظم " عليه السلام واقفي كوفي سكن بغداد، روى عن " ظم " عليه السلام وعن علي بن أبي حمزة، ويروي عنه الحسين بن سعيد والبرقي محمد، وهو في التالية.(@)(@@)(@@)(@@) $ 2521 - القاسم بن محمد الخلقاني، كوفي قريب الامر " صه " " جش " له كتاب عنه أحمد بن ميثم " ست " " جش ".(@)(@@)(@@)(@@) $ 2522 - القاسم بن محمد القمي المعروف بكاسولا، لم يكن بالمرضي، قال: إنه يكنى أبا محمد حديثه يعرف تارة وينكر أخرى. ويجوز أن يخرج شاهدا، له كتاب عنه البرقي، تقدم ابن محمد الأصفهاني وهما متحدان.(@)(@@)(@@)(@@) $ 2523 - القاسم بن يحيى بن الحسن بن راشد مولى المنصور، روى عن جده ضعيف " صه " له كتاب فيه آداب أمير المؤمنين عليه 
ms244	 السلام عنه الاحمدان ومحمد بن عيسى، وفي " مشكا " ابن يحيى عنه محمد بن عيسى وأحمد بن محمد وإبراهيم بن هاشم.(@)(@@)(@@)(@@) $ 2524 - القافي خادم أبي الحسن عليه السلام مجهول " صه " " د " " ظم " والظاهر منه الثالث وان احتمل الأول والثاني عليهم السلام، والله أعلم.(@)(@@)(@@)(@@) $ 2525 - كلثوم بنت سليم روت عن الرضا عليه السلام كتابا، عنها محمد بن إسماعيل بن بزيع " جش ".(@)(@@)(@@)(@@) $ 2526 - لفافة النقاش كوفي " ظم ". PageV01P340(@)(@@)(@@)(@@) $ 2527 - مبارك مولى الرضا عليه السلام.(@)(@@)(@@)(@@) $ 2528 - مبارك بن يزيد أبو يوسف " ظم ".(@)(@@)(@@)(@@) $ 2529 - مبرور بن إسماعيل مجهول " ظم " " صه " وقيل: مسرور " صه " في " قي " و " د " نقلا عن خط الشيخ مبرور.(@)(@@)(@@)(@@) $ 2530 - مثنى بن راشد، له كتاب، عنه الحسن بن محمد بن سماعة " ست " " جش " وفي " ق " مثنى بن راشد الخياط أبو الوليد الكوفي، وهو في التالية أيضا، وفي " تعق " روى عنه البزنطي في الصحيح.(@)(@@)(@@)(@@) $ 2531 - محسن بن أحمد البجلي أبو أحمد " ضا " القيسي، من موالي قيس بن غيلان، روى عن الرضا عليه السلام عنه أحمد بن أبي عبد الله بكتابه " ست " " جش " وفي " تعق " في الكنى محسن بن أحمد الثقة، ولا يبعد كونه البصري المذكور، فتأمل.(@)(@@)(@@)(@@) $ 2532 - محفوظ بن نصر الهمداني، كوفي ثقة " صه " " جش " له كتاب، عنه إبراهيم بن سليمان " ست " " جش " وفي " مشكا " ابن نصر الهمداني الثقة، عنه إبراهيم بن سليمان وغيره، لا أصل له ولا كتاب.(@)(@@)(@@)(@@) $ 2533 - محمد بن آدم المدائني يعرف بزرقان المدائني " ضا ".(@)(@@)(@@)(@@) $ 2534 - محمد بن إبراهيم الموصلي " ظم " مرتين.(@)(@@)(@@)(@@) $ 2535 - محمد بن إبراهيم بن أبي الولاد وأخوه يحيى مولى بني عبد الله بن غطفان، ثقة قليل الحديث " صه " " جش " أخوه أكثر حديثا منه، له كتاب، عنه محمد بن علي بن محبوب.(@)(@@)(@@)(@@) $ 2536 - محمد بن أبي إسحاق القمي " ست " " لم " متكلم له كتب في الكلام وفي الاخبار " ست " عنه أحمد بن أبي عبد الله " ست " " جش " " لم ".(@)(@@)(@@)(@@) $ 2537 - محمد بن أبي عبادة، وكان مشتهرا بالسماع وبشرب النبيذ، قال:(@)(@@) سألت الرضا عليه السلام عن السماع؟ فقال: لأهل الحجاز فيه رأي 
ms245	 وهو في حيز الباطل اللهو، أما سمعت الله عز وجل " وإذا مروا باللغو مروا كراما ".(@)(@@)(@@)(@@) $ 2538 - محمد بن أبي عمير زياد بن عيسى أبو أحمد مولى الأزد من موالي PageV01P341(@)(@@) المهلب، ثقة جليل القدر عظيم المنزلة من أوثق الناس عند الفرقتين، له مصنفات كثيرة، أدرك من الأئمة عليهم السلام " ظم " ولم يرو عنه وروى عن " ضا " و " ج " مات سنة سبع عشرة ومائتين.(@)(@@)(@@)(@@) $ 2539 - محمد بن أبي قريش " ج ".(@)(@@)(@@)(@@) $ 2540 - محمد بن أبي يزيد الرازي، أصله من قم " ج " في نسخة وقيل: في أخرى ابن أبي زيد.(@)(@@)(@@)(@@) $ 2541 - محمد بن أحمد بن إبراهيم " دي ".(@)(@@)(@@)(@@) $ 2542 - محمد بن أحمد بن قيس بن غيلان، مولى كوفي له كتاب من أصحاب الرضا عليه السلام ثقة " صه " " جخ ".(@)(@@)(@@)(@@) $ 2543 - محمد بن أحمد بن مطهر " دي " بغدادي يونسي " صه ".(@)(@@)(@@)(@@) $ 2544 - محمد بن أورمة القمي " ضا " ويأتي في عنوان ابن أورمة.(@)(@@)(@@)(@@) $ 2545 - محمد بن إسحاق أخو يزيد شعر، والظاهر أن يزيدا أخاه، كان واقفيا يقول بحياة " ظم " فدعى له " ضا " حتى قال بإسحاق وأما محمد فكان مستويا، وفيه حكاية تدل على مدحه.(@)(@@)(@@)(@@) $ 2546 - محمد بن إسحاق بن عمار الصيرفي التغلبي، ثقة عين روى عن أبي الحسن موسى عليه السلام وقال أبو جعفر " ره ": واقفي، وتوقف فيه " مه " في " صه " له كتاب كثير الرواة، منهم محمد بن بكر بن جناح والقاسم وغيرهما.(@)(@@)(@@)(@@) $ 2547 - محمد بن إسحاق القمي " ج " وفي " تعق " ذكر " ق " أن من وكلاء الصاحب عليه السلام الذين رأوه ووقفوا على معجزته من أهل قم إسحاق بن يعقوب، وفي النقد كما في الكتاب، وزاد محمد بن إسحاق القمي، روى عنه أحمد بن أبي عبد الله. ويحتمل أن يكونا واحدا انتهى. أقول: ولا يخلو من تأمل.(@)(@@)(@@)(@@) $ 2548 - محمد بن أسلم الجبلي الطبري، أصله كوفي كان غاليا فاسد الحديث، روى عن الرضا عليه السلام و " غض " الحلبي بدل الجبلي، عنه محمد بن الحسين بن أبي الخطاب " ست " " لم " وفي " تعق " الجبلي أي من بلاد جبل وهي من بغداد PageV01P342(@)(@@) إلى 
ms246	 آذربيجان، والطبري أي من طبرستان وهي بلاد جيلان ومازندران.(@)(@@)(@@)(@@) $ 2549 - محمد بن إسماعيل بن بزيع، كان من صالحي هذه الطائفة وثقاتهم، كثير العمل من رجال " ظم " عليه السلام وأدرك أبا جعفر الثاني عليه السلام له كتب، عنه أحمد بن محمد بن عيسى، ومعاوية بن حكيم، وابن هاشم، وابن الحسين.(@)(@@)(@@)(@@) $ 2550 - محمد بن إسماعيل البلخي " دي ".(@)(@@)(@@)(@@) $ 2551 - محمد بن إسماعيل الجعفري له كتاب " ست " " جش " عنه ابن نهيك " ست ".(@)(@@)(@@)(@@) $ 2552 - محمد بن إسماعيل بن جعفر الصادق عليه السلام فيه حديث صحيح يدل على ذمه وشركه في دم عمه الكاظم عليه السلام وصار منشاءا لبغض هارون باخباره الكذب مؤكدا باليمين، والحديث مذكور في " في " وغيره.(@)(@@)(@@)(@@) $ 2553 - محمد بن إسماعيل الضيمري قمي " دي ".(@)(@@)(@@)(@@) $ 2554 - محمد بن إسماعيل بن ميمون الزعفراني أبو عبد الله، ثقة عين روى عنه الثقات وروى عنهم، ولقى أصحاب أبي عبد الله عليه السلام " صه " " جش " له كتاب، عنه عبد الله بن محمد بن خالد.(@)(@@)(@@)(@@) $ 2555 - محمد بن الأصبغ الهمداني، كوفي ثقة " صه " " جش " له كتاب " ست " " جش " عنه أحمد بن محمد بن خالد " جش " وفي " مشكا " ابن الأصبغ الثقة، أحمد بن محمد بن خالد عنه.(@)(@@)(@@)(@@) $ 2556 - محمد بن أورمة، له كتب مثل كتب الحسين بن سعيد، روى عنه الحسين بن الحسن بن أبان، وقد طعن عليه بالغلو والتخليط، وفيه مجال للاجتهاد.(@)(@@) والتعمق ليس هنا محله.(@)(@@)(@@)(@@) $ 2557 - محمد بن بحر أخو مفلس " ضا ".(@)(@@)(@@)(@@) $ 2558 - محمد بن بشر الحمدوني أبو الحسين السوسنجردي، متكلم جيد الكلام صحيح الاعتقاد، حج على قدميه خمسين حجة، كان من عيون الأصحاب وصالحيهم، له كتب، عنه محمد بن أحمد رجاء " ست ". PageV01P343(@)(@@)(@@)(@@) $ 2559 - محمد بن بشير وأخوه، ثقتان من رواة الحديث، كوفي مات بقم " جش " غير كوفي " صه " له كتاب، عنه أحمد بن أبي عبد الله " ست " " جش ".(@)(@@)(@@)(@@) $ 2560 - محمد بن بشير من أصحاب " ظم " عليه السلام غال ملعون، وفي رواية أنه يكذب عليه عليه السلام فأذاقه الله حر الحديد، أي جعل محبوسا، أو قتل بالسيف الحديد، وله 
ms247	 أصحاب قالوا: إن " ظم " عليه السلام لم يمت وأنه غاب وهو القائم عليه السلام الحديث.(@)(@@)(@@)(@@) $ 2561 - محمد بن بكر، له روايات، عنه أحمد بن ميثم " ست ".(@)(@@)(@@)(@@) $ 2562 - محمد بن بكر الأزدي، له كتاب، عنه إبراهيم بن سليمان " ست " وفي " تعق " لعله بن بكر بن محمد الأزدي لتكنيه بأبي محمد، وهو من بيت جليل بالكوفة كما مر في بكر، واحتمل في النقد اتحاده مع الآتي بعيده.(@)(@@)(@@)(@@) $ 2563 - محمد بن بكران بن جناح، من أصحاب " ظم " واقفي " صه " وفي " د " ابن بكر وقد تقدم.(@)(@@)(@@)(@@) $ 2564 - محمد بن بكران بن عمران أبو جعفر الرازي، سكن الكوفة وجاور بقية عمره، عين مسكون إلى روايته، له كتاب الكوفة وكتاب موضع قبر أمير المؤمنين عليه السلام وكتاب شرف التربة " جش " وفي " صه " ابن بدران ولعل الأول أصح.(@)(@@)(@@)(@@) $ 2565 - محمد بن البهلول، كوفي له كتاب، عنه يحيى بن زكريا اللؤلؤي " جش " وفي " د " " لم " والله أعلم على ما ذكره الميرزا.(@)(@@)(@@)(@@) $ 2566 - محمد بن تميم النهشلي التميمي، البصري، له كتاب عن أبي الحسن عليه السلام، عنه الحسن بن علي بن زكريا.(@)(@@)(@@)(@@) $ 2567 - محمد بن ثابت، من أصحاب " ظم " مجهول، عنه أحمد بن محمد بن سعيد " جش ".(@)(@@)(@@)(@@) $ 2568 - محمد الملقب بالثواب، كوفي ثقة قليل الحديث " صه " " جش " عنه إبراهيم بن سليمان " جش " وفي " مشكا " ابن محمد الثقة الملقب بثوابا عنه إبراهيم.(@)(@@)(@@)(@@) $ 2569 - محمد بن جذاعة الفارسي " ضا ". PageV01P344(@)(@@)(@@)(@@) $ 2570 - محمد بن جزك الجمال، من أصحاب " دي " عليه السلام ثقة " صه " " جخ ".(@)(@@)(@@)(@@) $ 2571 - محمد بن جعد الأسدي " ظم ".(@)(@@)(@@)(@@) $ 2572 - محمد بن جعفر الخزاز " ضا " مكررا.(@)(@@)(@@)(@@) $ 2573 - محمد بن جعفر العبسي " ضا ".(@)(@@)(@@)(@@) $ 2574 - محمد بن جعفر بن محمد بن علي بن الحسين عليه السلام يلقب ديباجة، له نسخة يرويها عن أبيه، عنه أحمد بن الوليد بن برد، وانما لقب بديباجة لحسن وجهه، كان شجاعا يصوم يوما ويفطر آخر، ويرى رأي الزيدية في الخروج بالسيف، وقد بارز الجلودي المأمور من قبل المأمون فأخذه.(@)(@@)(@@)(@@) $ 2575 - محمد بن جعفر المقنائي " ضا ".(@)(@@)(@@)(@@) $ 2576 - محمد بن الجمهور 
ms248	 القمي، عربي بصري غال ضعيف الحديث فاسد المذهب لا يلتفت إليه، روى عن " ضا " عليه السلام وفي " مشكا " ابن جمهور عنه ابنه الحسن، وأحمد بن الحسين بن سعيد، والمعلى بن محمد.(@)(@@)(@@)(@@) $ 2577 - محمد بن جميل بن صالح الأسدي، عربي صميم ثقة " صه " وزاد " جش " له كتاب يرويه جماعة منهم البرقي.(@)(@@)(@@)(@@) $ 2578 - محمد بن الحارث " ظم " وفي " تعق " الظاهر أنه ابن الحارث النوفلي راوي أدعية الوسائل إلى المسائل خادم الرضا عليه السلام كما في مهج الدعوات.(@)(@@)(@@)(@@) $ 2579 - محمد بن الحسن بن أبي خالد القمي الأشعري " ضا " وفي " تعق " يظهر من غير واحد من الاخبار كونه وصي سعد، ويظهر منه عدالته، وفي الوجيزة " ح " ولعله الملقب بشنبولة، ومر في إدريس بن عبد الله، وفي " مشكا " عنه الحسين بن سعيد.(@)(@@)(@@)(@@) $ 2580 - محمد بن الحسن بن الجمهور العمي البصري له كتب " ست " سعد عن أحمد بن الحسين بن سعيد عنه، وكذا العمي تقدم محمد بن جمهور، والظاهر الاتحاد فتأمل. PageV01P345(@)(@@)(@@)(@@) $ 2581 - محمد بن الحسن بن زياد العطار، روى أبوه عن أبي عبد الله عليه السلام كوفي ثقة له كتاب، عنه الحسن بن محمد، وقد ورد في " يب " الحسن بن محمد عن محمد بن زياد، والظاهر أنه سهو.(@)(@@)(@@)(@@) $ 2582 - محمد بن الحسن بن زياد الميثمي الأسدي مولاهم أبو جعفر، ثقة عين روى عن الرضا عليه السلام له كتاب، عنه يعقوب بن يزيد " جش " وفي " مشكا " كذلك.(@)(@@)(@@)(@@) $ 2583 - محمد بن الحسن بن محبوب " ج ".(@)(@@)(@@)(@@) $ 2584 - محمد بن الحسن الواسطي " ج " روى " كش " عن علي بن محمد القتيبي، قال الفضل بن شاذان: محمد بن الحسن كان كريما على أبي جعفر وأن أبا الحسن عليه السلام أنفذ نفقة في مرضه وكفنه وأقام مأتمه عند موته " صه ".(@)(@@)(@@)(@@) $ 2585 - محمد بن الحصين الأهوازي " دي ".(@)(@@)(@@)(@@) $ 2586 - محمد بن الحصين الفهري، من أصحاب أبي الحسن الثالث عليه السلام ملعون ضعيف " صه " " جخ " وقيل: إنه محمد بن نصير النميري الفهري.(@)(@@)(@@)(@@) $ 2587 - محمد بن حكيم " ظم " روى " كش " أن أبا الحسن عليه السلام كان يرضى 
ms249	 كلامه عند ذكر أصحاب الكلام يروي عنه محمد بن أبي عمير، وهو في التالية.(@)(@@)(@@)(@@) $ 2588 - محمد بن حماد بن زيد الحارثي أبو عبد الله، ثقة، روى أبوه عن " ق " عليه السلام " صه " " جش " له كتاب، عنه محمد بن الحسين بن أبي الخطاب " جش " محمد بن علي بن محبوب، وأحمد بن ميثم " ست ".(@)(@@)(@@)(@@) $ 2589 - محمد بن حمزة " ج " مكررا.(@)(@@)(@@)(@@) $ 2590 - محمد بن حمزة بن القاسم " ضا ".(@)(@@)(@@)(@@) $ 2591 - محمد بن حمزة القمي " دي " وفي " تعق " الظاهر أنه ابن حمزة بن اليسع وقول المصنف كأنه أبو طاهر بن حمزة بن اليسع الأشعري الثقة الآتي، وكذا قال أيضا في النقد ويأتي أيضا في أبي طاهر عن المصنف كأن اسمه محمد. أقول: وفي اتحاده مع ابن اليسع امارات لا تخفى. PageV01P346(@)(@@)(@@)(@@) $ 2592 - محمد بن حمزة بن اليسع، عن زكريا بن آدم، عنه أحمد بن محمد بن عيسى، لا أعرفه " صه " قال الميرزا: والظاهر أنه أبو طاهر بن حمزة الثقة.(@)(@@)(@@)(@@) $ 2593 - محمد بن خالد، له كتاب، عنه أحمد بن أبي عبد الله " ست ".(@)(@@)(@@)(@@) $ 2594 - محمد بن خالد الأحمسي البجلي كوفي ثقة " صه " " جش " له كتاب، عنه إبراهيم بن سليمان بن حيان " ست " " جش ".(@)(@@)(@@)(@@) $ 2595 - محمد بن خالد الأشعري، قمي قريب الامر " صه " " جش " له كتاب نوادر، عنه أحمد بن أبي عبد الله " جش " قيل: لا يبعد أن يكون المتقدم أولا أي المذكور عن " ست ".(@)(@@)(@@)(@@) $ 2596 - محمد بن خالد البرقي " ظم " " ج " ثقة، قال نصر بن الصباح: لم يلق البرقي أبا بصير بينهما القاسم ولا إسحاق بن عمار، وينبغي أن يكون صفوان، ويأتي بعنوان ابن عبد الرحمن.(@)(@@)(@@)(@@) $ 2597 - محمد بن خالد البلخي مولى أبي الحسن " ضا ".(@)(@@)(@@)(@@) $ 2598 - محمد بن خالد الرازي يكنى أبا العباس " دي ".(@)(@@)(@@)(@@) $ 2599 - محمد بن خالد الطيالسي " ظم " له كتاب، عنه محمد بن علي بن محبوب " ست " روى عنه علي بن الحسن بن فضال، وسعد بن عبد الله " لم " في " مشكا " عنه علي وسعد وحميد وابن علي بن محبوب، وفي " تعق " رواية الأجلة عنه دليل 
ms250	 الاعتماد.(@)(@@)(@@)(@@) $ 2600 - محمد بن خالد بن عبد الرحمن بن محمد بن علي البرقي أبو عبد الله مولى أبي موسى الأشعري، من أصحاب " ضا " عليه السلام ثقة " صه " " جخ " ولا اعتماد بتضعيف " غض " و " جش " وبرق رود قرية من سواد قم، عنه ابنه أحمد وله اخوة.(@)(@@)(@@)(@@) $ 2601 - محمد بن خالد بن عمر الطيالسي التميمي أبو عبد الله، كان يسكن بالكوفة في صحراء جرم، له كتاب نوادر " جش " والظاهر أنه ابن خالد الطيالسي المتقدم، وهو الظاهر من الشيخ أبي علي. PageV01P347(@)(@@)(@@)(@@) $ 2602 - محمد بن الخضيب أهوازي " ضا ".(@)(@@)(@@)(@@) $ 2603 - محمد بن الخليل أبو جعفر السكاك، بغدادي صاحب هشام بن الحكم وتلميذه أخذ عنه، له كتب منها كتاب التوحيد، الا أن " جش " قال إنه تشبيه يعني ليس بتوحيد بل تشبيه وشرك. ويستفاد من " ست " كونه اماميا و " كش " جلالته.(@)(@@)(@@)(@@) $ 2604 - محمد بن رجاء الخياط " دي " لم أر له شيئا يوجب الوثوق بروايته، فالأصوب التوقف في قبولها كما في نظائره.(@)(@@)(@@)(@@) $ 2605 - محمد بن الريان بن الصلت، من أصحاب أبي الحسن الثالث ثقة " صه " " جخ " الأشعري القمي، له مسائل لأبي الحسن العسكري عليه السلام عنه محمد بن عبد الله بن جعفر، وهو في السابقة، وفي " مشكا " ابن الريان الثقة ابن عبد الله بن جعفر عن أبيه عنه، وسهل بن زياد كما في " يه ".(@)(@@)(@@)(@@) $ 2606 - محمد بن زبرقان أبو همام الرازي صدوق، ربما وهم كونه من الثامنة، كذا في بعض الحواشي للميرزا.(@)(@@)(@@)(@@) $ 2607 - محمد بن زرقان صاحب موسى بن جعفر بن الحباب صاحب جعفر بن محمد عليهما السلام له نسخة رواها عن " ظم " عليه السلام " جش ".(@)(@@)(@@)(@@) $ 2608 - محمد بن زيد الزرامي خادم الرضا عليه السلام، عنه محمد بن حسان الرازي " جش " فالتوقف فيما تفرد به لازم.(@)(@@)(@@)(@@) $ 2609 - محمد بن زيد الطبري، أصله كوفي " ضا " وهو كنظائره غير معتمد عليه.(@)(@@)(@@)(@@) $ 2610 - محمد بن سالم بن شريح الأشجعي الحذاء الكوفي أبو إسماعيل، أسند عنه مات سنة اثنتين وتسعين ومائة، وهو ابن تسع وخمسين سنة، ويقال له: سالم الحذاء، وسالم الأشجعي، 
ms251	 وسالم بن أبي واصل، وسالم بن شريح، وهو ثقة " ق " " صه " الا أن في الأول ابن سلم كما يأتي، وليس فيه التوثيق، والتكرار دليل التعدد.(@)(@@)(@@)(@@) $ 2611 - محمد بن سالم بن عبد الحميد، ومحمد بن الوليد الخزاز، ومعاوية بن حكيم، ومصدق بن صدقة، قال " كش ": كلهم فطحية من أجلة العلماء والثقات PageV01P348(@)(@@) والفقهاء وبعضهم أدرك " ضا " عليه السلام.(@)(@@)(@@)(@@) $ 2612 - محمد بن سالم القمي " ضا ".(@)(@@)(@@)(@@) $ 2613 - محمد بن سعيد بن كلثوم المروزي، وكان متكلما " دي " قال ابن الصباح: كان ابن سعيد هذا من أجلة المتكلمين بنيسابور، وقال الجرجاني: انه كان خارجيا ثم رجع إلى التشيع بعد الخروج واظهار السيف.(@)(@@)(@@)(@@) $ 2614 - محمد بن سكين بن عمار النخعي الجمال، ثقة روى أبوه عن أبي عبد الله عليه السلام " صه " " جش " له كتاب، عنه إبراهيم بن سليمان " ست " " جش " وفي " مشكا " ابن سكين الثقة النخعي، عنه إبراهيم بن سلميان، وابن أبي عمير.(@)(@@)(@@)(@@) $ 2615 - محمد بن سليمان الأرمني " دي ".(@)(@@)(@@)(@@) $ 2616 - محمد بن سليمان البصري الديلمي، له كتاب يرمى بالغلو " ظم " الديلمي بصري " ضا " ويأتي عن " د " و " صه " النصري بالنون.(@)(@@)(@@)(@@) $ 2617 - محمد بن سليمان الديلمي، له كتاب، عنه أحمد بن أبي عبد الله، وإبراهيم بن إسحاق النهاوندي " ست " تقدم ابن سليمان البصري، ويأتي ابن سليمان بن عبد الله، والكل واحد.(@)(@@)(@@)(@@) $ 2618 - محمد بن سليمان بن عبد الله الديلمي، ضعيف جدا لا يعول عليه في شئ " صه " " جش " له كتاب، أحمد بن محمد عن أبيه عنه " جش " تقدم الديلمي والبصري، ويأتي النصري، الا أن رواية أحمد في " جش " بالواسطة.(@)(@@)(@@)(@@) $ 2619 - محمد بن سليمان الكاتب " ضا ".(@)(@@)(@@)(@@) $ 2620 - محمد بن سليمان النصري بالنون، من أصحاب أبي الحسن " ظم " عليه السلام يرمى بالغلو " صه " ونحوه " د " وتقدم عن رجاله عليه السلام البصري بالباء.(@)(@@)(@@)(@@) $ 2621 - محمد بن سنان أبو جعفر الزاهري، من ولد زاهر مولى عمرو بن الحمق الخزاعي، وأبو الحسن قد توفى في صغر سنه، وكفله سنان جده، فنسب إليه، اختلف قول علمائنا فيه شديدا، والأشبه الضعف. PageV01P349(@)(@@)(@@)(@@) $ 2622 - محمد بن سليمان 
ms252	 النوفلي، في ترجمة هشام بن الحكم ما يظهر منه حسن حاله، وروى عنه أحمد بن محمد بن عيسى، وفيها أيضا شهادة " تعق ".(@)(@@)(@@)(@@) $ 2623 - محمد بن سهل بن اليسع الأشعري القمي، روى عن الرضا وأبي جعفر عليهما السلام، له مسائل عن الأول عليه السلام، عنه أحمد بلا واسطة " ست " وهو معها " جش " فهو في التالية أيضا.(@)(@@)(@@)(@@) $ 2624 - محمد بن سهل البجلي الرازي، أسند عنه " ضا ".(@)(@@)(@@)(@@) $ 2625 - محمد بن شعيب " ضا " غير ممدوح ولا مذموم فيما حضرنا من كتب الرجال فالتوقف لازم، نعم في " تعق " الظاهر أنه الذي يروي عنه ابن أبي عمير.(@)(@@)(@@)(@@) $ 2626 - محمد بن الصباح، كوفي ثقة، عنه إبراهيم بن سليمان " ست " " جش " وزاد في الأول له روايات رويناها بهذا الاسناد عن حميد عن أبي إسحاق، ثم ذكر الاسناد.(@)(@@)(@@)(@@) $ 2627 - محمد بن صدقة، من أصحاب الرضا عليه السلام بصري غال " صه " " جخ " روى عن أبي الحسن عليه السلام عنه الحسن بن علي بن زكريا، وفي " مشكا " ابن صدقة، عنه الحسن بن علي بن زكريا.(@)(@@)(@@)(@@) $ 2628 - محمد بن صيفي كوفي " دي ".(@)(@@)(@@)(@@) $ 2629 - محمد بن عباس، له روايات، عنه أحمد بن ميثم " ست " قيل: ولعله ابن مرزوق الآتي، فتأمل.(@)(@@)(@@)(@@) $ 2630 - محمد بن العباس بن مرزوق، له روايات، عنه أحمد بن ميثم " ست " قد تقدم احتمال كونه هو المتقدم، والذي دعى القائل إليه هو الاتحاد في الاسم والأب.(@)(@@)(@@)(@@) $ 2631 - محمد بن عبد الحميد بن سالم العطار أبو جعفر، روى عن أبي الحسن عليه السلام، وكان ثقة من أصحابنا الكوفيين، عنه عبد الله بن جعفر، وأحمد بن أبي عبد الله، ولعله المتقدم عن " لم " في السابقة.(@)(@@)(@@)(@@) $ 2632 - محمد بن عبد الله الأشعري " ضا " مكررا، وفي بعض الروايات في روضة الكافي عن أبي جرير القمي، وهو محمد بن عبد الله بن عبد الله عن أبي الحسن PageV01P350(@)(@@) عنه وكأنه هذا، كذا ذكره الميرزا.(@)(@@)(@@)(@@) $ 2633 - محمد بن عبد الله الجلاب البصري، من أصحاب " ظم " واقفي " صه " " جخ ".(@)(@@)(@@)(@@) $ 2634 - محمد بن عبد الله بن زرارة بن أعين، رجل 
ms253	 فاضل دين أصدق لهجة من أحمد بن الحسن بن فضال، عنه علي بن الريان، وفي تعليقات الشهيد على الخلاصة مجهول الحال، وقد وثق العلامة رواية هو في طريقها.(@)(@@)(@@)(@@) $ 2635 - محمد بن عبد الله الطاطري " ضا ".(@)(@@)(@@)(@@) $ 2636 - محمد بن عبد الله الطهومي " ضا ".(@)(@@)(@@)(@@) $ 2637 - محمد بن عبد الله ابن عم الحسين بن أبي العلاء، روى ابن عقدة عن الحسن بن علي بن بزيع، عن عبد الله بن محمد المزخرف أبو محمد، قال: حدثني محمد هذا وكان خيرا " صه ".(@)(@@)(@@)(@@) $ 2638 - محمد بن عبد الله بن عمرو بن سالم بن لاحق أبو عبد الله اللاحقي الصفار، روى عن الرضا عليه السلام له نسخة تشبه كتاب الحلبي مبوبة كبيرة، عنه أحمد بن محمد بن عيسى بن العراد " جش ".(@)(@@)(@@)(@@) $ 2639 - محمد بن عبد الله بن عيسى الأشعري قمي " ضا ".(@)(@@)(@@)(@@) $ 2640 - محمد بن عبد الله المدائني، لحق موسى بن جعفر " ج " " ضا ".(@)(@@)(@@)(@@) $ 2641 - محمد بن عبد الله بن مهران الكرخي، من أبناء الأعاجم، غال كذاب فاسد المذهب والحديث مشهور بذلك، عنه البرقي " جش " " صه " الا الراوي، وفي " مشكا " عنه البرقي، أقول: وهو الابن كما في " ست ".(@)(@@)(@@)(@@) $ 2642 - محمد بن عبد الله النوفلي الهمداني " دي ".(@)(@@)(@@)(@@) $ 2643 - محمد بن عبيد بن صاعد، كوفي يكنى أبا عبد الله واقف " صه " " جش " روى عن القاسم بن إسماعيل، له كتاب، عنه الحسين بن أحمد بن الياس في الثاني.(@)(@@)(@@)(@@) $ 2644 - محمد بن عبيد الطاهي من أهل طاهي " دي ". PageV01P351(@)(@@)(@@)(@@) $ 2645 - محمد بن عثمان أخو حماد، قال " عقد " عن علي بن الحسن: أنه ثقة " صه ".(@)(@@)(@@)(@@) $ 2646 - محمد بن عرفة، علي بن إبراهيم، عن محمد بن عيسى، عن محمد بن عرفة، قال قال لي الرضا عليه السلام: ويحك يابن عرفة اعملوا لغير رياء ولا سمعة، فإنه من عمل لغير الله وكله الله الحديث.(@)(@@)(@@)(@@) $ 2647 - محمد بن عصام الأنماطي كوفي " جش " له كتاب، عنه محمد بن أحمد بن رجاء " ست " " جش ".(@)(@@)(@@)(@@) $ 2648 - محمد بن علي بن جعفر " ضا ".(@)(@@)(@@)(@@) $ 2649 - محمد بن علي بن الحسين بن زيد 
ms254	 بن علي بن الحسين بن علي بن أبي طالب عليهم السلام له نسخة يرويها عن الرضا عليه السلام، عنه جعفر بن محمد الحسني " جش ".(@)(@@)(@@)(@@) $ 2650 - محمد بن علي بن حمزة بن الحسين بن عبيد الله بن عباس بن علي بن أبي طالب عليه السلام أبو عبد الله، ثقة عين في الحديث، صحيح الاعتقاد، له رواية عن " دي " و " ري " عليهما السلام له كتاب، عنه حمزة بن القاسم بن علي ابن أخيه " جش ".(@)(@@)(@@)(@@) $ 2651 - محمد بن علي الطلحي، له مسائل، عنه أحمد بن محمد بن عيسى ويحتمل كونه ابن علي بن عيسى الآتي.(@)(@@)(@@)(@@) $ 2652 - محمد بن علي بن إبراهيم بن موسى أبو جعفر القرشي، مولاهم صيرفي، ابن أخت خلاد بن عيسى المقري، وكان يلقب أبا سمينة بضم السين، ضعيف فاسد الاعتقاد ولا يعتمد عليه " صه " " جش " وفي " مشكا " ابن علي بن إبراهيم بن موسى الكذاب الضعيف، عنه محمد بن أبي القاسم ماجيلوية، وجعفر بن عبد الله المحمدي، وهو في السابقة وقد مضى.(@)(@@)(@@)(@@) $ 2653 - محمد بن علي بن حمزة بن الحسن بن عبيد الله بن العباس بن علي بن أبي طالب عليه السلام أبو عبد الله، ثقة عين في الحديث، صحيح الاعتقاد " صه " PageV01P352(@)(@@) " جش " وزاد له رواية عن " دي " و " ري " عليهما السلام وأيضا له مكاتبة، وفي داره حصلت أمر صاحب الامر بعد وفاة أبيه، عنه الحمزة ابن أخيه.(@)(@@)(@@)(@@) $ 2654 - محمد بن علي بن عيسى الأشعري قمي " دي " وفي " تعق " الظاهر اتحاده مع الآتي.(@)(@@)(@@)(@@) $ 2655 - محمد بن علي بن عيسى القمي، كان وجها بقم وأميرا عليها من قبل السلطان، وكذلك كان أبوه يعرف بالطلحي، له مسائل لأبي الحسن العسكري عليه السلام " صه " " جش " وزاد عنه محمد بن أحمد بن زياد، وفي " مشكا " هو مع أحمد بن زكريا وعتقوية، وفي النقد جعله متحدا مع الطلحي.(@)(@@)(@@)(@@) $ 2656 - محمد بن علي القرشي " ضا " وكأنه الذي مر عن " صه " و " جش " فلا يعتمد عليه اجتهادا مع الاتحاد وفقاهة مع التغاير، فلاحظ وتتبع.(@)(@@)(@@)(@@) $ 2657 - محمد بن علي 
ms255	 بن مهزيار، من أصحاب أبي الحسن الثالث عليه السلام ثقة " صه " " جخ " وعده ابن طاووس من السفراء والأبواب المعروفين الذين لا تختلف الامامية القائلون بامامة الحسن بن علي عليهما السلام فيهم.(@)(@@)(@@)(@@) $ 2658 - محمد بن علي الهمداني ضعيف " صه " " لم " روى عنه محمد بن أحمد بن يحيى، قال ابن بطة: هو أبو سمينة، وفي " تعق " قال جدي: الظاهر أنه ليس أبا سمينة، وأبو سمينة أرفع منه بطبقة، وفي " ست " يروي عنه محمد بن عبد الله، واسم عبد الله بندار الخبابي.(@)(@@)(@@)(@@) $ 2659 - محمد بن عمار بن الأشعث النهدي " ضا " وعن نسخة السندي.(@)(@@)(@@)(@@) $ 2660 - محمد بن عمارة بن أشعث " ضا ".(@)(@@)(@@)(@@) $ 2661 - محمد بن عمرو، من أصحاب " ظم " واقفي وفي " ظم " ابن عمر كما يأتي:(@)(@@)(@@)(@@) $ 2662 - محمد بن عمرو الزيات ابن سعيد المدائني، ثقة عين روى عن الرضا عليه السلام " صه " له كتاب، عنه علي بن السندي " ست " " جش " " لم " وفي " مشكا " ابن عمرو بن سعيد الزيات الثقة، عنه علي بن محمد السندي، ومحمد البرقي، PageV01P353(@)(@@) وهو عن " ضا " عليه السلام.(@)(@@)(@@)(@@) $ 2663 - محمد بن عمرو بن عبد الله بن عمرو بن مصعب بن الزبير بن العوام، متكلم حاذق من أصحابنا " صه " " جش " وزاد له كتاب في الإمامة حسن يعرف بكتاب الصورة.(@)(@@)(@@)(@@) $ 2664 - محمد بن عمر، واقفي " ظم " تقدم عن " صه " ابن عمرو، وهما متحدان.(@)(@@)(@@)(@@) $ 2665 - محمد بن عمر الجرجاني، مختلط الامر، قاله أبو العباس بن نوح " صه " " جش " له كتاب، عنه أحمد بن أبي عبد الله في الثاني، وفي " لم " محمد بن عمر الجرجاني بغدادي روى عنه البرقي، وظن الميرزا كونه غير الأول لتكريره الذكر.(@)(@@)(@@)(@@) $ 2666 - محمد بن عمر الكناسي " ضا ".(@)(@@)(@@)(@@) $ 2667 - محمد بن عمر الزيات، له كتاب، رويناه بهذا الاسناد، عن أحمد بن أبي عبد الله " ست " والاسناد جماعة عن أبي المفضل، عن ابن بطة، وفي " تعق " يحتمل كونه ابن عمرو السابق. أقول: وهذا احتمال غريب، لكونه السابق مع الواو وهنا بدونه باتفاق من ذكرهما من دون تعرض لاحتمال الاتحاد.(@)(@@)(@@)(@@) $ 2668 - محمد بن عمر 
ms256	 بن يزيد " ضا " " ست " " جش " بياع السابري، روى عن أبي الحسن عليه السلام " جش " له كتاب، عنه محمد بن عبد الحميد " ست " " جش ".(@)(@@)(@@)(@@) $ 2669 - محمد بن عيسى بن عبد الله بن سعد بن مالك الأشعري أبو علي، شيخ القميين ووجه الأشاعرة، متقدم عند السلطان ودخل على الرضا عليه السلام وسمع منه وروى عن " ج " عنه أحمد.(@)(@@)(@@)(@@) $ 2670 - محمد بن عيسى بن عبيد بن يقطين أبو جعفر العبيدي اليقطيني، اختلط قول علمائنا في شأنه، والأشبه قبول روايته، يروي عن أبي جعفر الثاني عليه السلام، ولتنقيح المرام مقام آخر.(@)(@@)(@@)(@@) $ 2671 - محمد بن غورك، كوفي قليل الحديث له كتاب، عنه إبراهيم بن PageV01P354(@)(@@) سليمان " ست " " جش ".(@)(@@)(@@)(@@) $ 2672 - محمد بن الفرج الرخجي بالراء مضمومة ثم الخاء المعجمة المفتوحة والجيم، من أصحاب أبي الحسن الرضا عليه السلام ثقة، عنه أحمد بن هلال، وقد عد من رجال " ج " و " دي " أيضا، وعن الارشاد روايات في مدحه.(@)(@@)(@@)(@@) $ 2673 - محمد بن الفضل الأزدي، من أصحاب أبي الحسن الرضا عليه السلام ثقة وفي " ظم " ابن فضيل الأزدي الكوفي ضعيف، وفي " ست " ابن الفضيل الأزدي عنه علي بن الحكم.(@)(@@)(@@)(@@) $ 2674 - محمد بن الفضل بن عمر " ضا ".(@)(@@)(@@)(@@) $ 2675 - محمد بن الفضيل، له كتاب، عنه الحسن بن علي اللؤلؤي الشعيري " ست " ومن المحتمل كما احتمله بعض أجلة الأصحاب كونه الأزدي الأزرق الآتي، والله أعلم.(@)(@@)(@@)(@@) $ 2676 - محمد بن الفضيل، من أصحاب " ضا " عليه السلام أزدي صيرفي، يرمى بالغلو ضعيف يلقب بالأزرق، له كتاب، عنه علي بن الحكم، ومحمد بن الحسين، وجماعة أخرى، يروي عن موسى وابنه عليهما السلام.(@)(@@)(@@)(@@) $ 2677 - محمد بن الفضيل بن كثير، وهو الأزدي المتقدم، كما ذكره الميرزا رحمه الله، وفي " جش " ابن الفضيل بن كثير الصيرفي الأزدي أبو جعفر الأزرق، وفي " مشكا " ابن الفضيل الأزدي الثقة، عنه محمد بن الحسين، وفي الاتحاد مع السابقين كلام.(@)(@@)(@@)(@@) $ 2678 - محمد بن فضيل الكوفي الأزدي ضعيف " ظم " وهو الأزدي المتقدم والاختلاف في العنوان.(@)(@@)(@@)(@@) $ 2679 - محمد بن فيض بن مالك المدائني، مولى عمر بن الخطاب " ضا 
ms257	 ".(@)(@@)(@@)(@@) $ 2680 - محمد بن القاسم الأسدي كوفي أبو إبراهيم يقال له: الكاره، مات سنة سبع ومائتين " ق ".(@)(@@)(@@)(@@) $ 2681 - محمد بن القاسم البوشجاني " ضا " ويحتمل بالنون قبل الواو. PageV01P355(@)(@@)(@@)(@@) $ 2682 - محمد بن القاسم البوشنجي " ضا ".(@)(@@)(@@)(@@) $ 2683 - محمد بن القاسم بن الفضيل بن يسار النهدي، ثقة، هو وأبوه وعمه العلاء وجده الفضيل رووا عن الرضا عليه السلام، له كتاب، عنه أبو عبد الله البرقي " ست " " جش ".(@)(@@)(@@)(@@) $ 2684 - محمد بن القاسم بن المثنى، له كتاب، عنه أحمد بن ميثم " ست " وفي " تعق " في ترجمة السابق في النقد لا يبعد اتحاده مع ابن المثنى بن القاسم الآتي، وهو الظاهر بقرينة الرواة، وقد تبعه تلميذه مؤيدا بعدم وجوده في غير " ست " ووجود مثنى بن القاسم دون العكس، فتأمل.(@)(@@)(@@)(@@) $ 2685 - محمد بن كلثوم، هو محمد بن سعيد بن كلثوم " تعق " أقول: وقد مضى بعنوانه، فلاحظ.(@)(@@)(@@)(@@) $ 2686 - محمد بن كليب الأشعري " ق ".(@)(@@)(@@)(@@) $ 2687 - محمد بن مالك بن الأبرد النخعي " ضا ".(@)(@@)(@@)(@@) $ 2688 - محمد بن مبشر، له كتاب، أخبرنا ابن أبي جيد، عن محمد بن الحسن، عن أحمد بن إدريس، وسعد والحميري عن أحمد بن محمد، وأحمد بن أبي عبد الله عن أبي عبد الله البرقي عنه " ست " قيل: ولا يبعد كونه بالمثناة والمهملة وفي " تعق " استظهره بشهادة السند وعدم توجه " جش " لما في " ست " وفيه تأمل.(@)(@@)(@@)(@@) $ 2689 - محمد بن المثنى بن القاسم، كوفي ثقة " صه " " جش " وزاد له كتاب، أخبرنا الحسين، عن أحمد بن جعفر، عن أحمد عنه. أقول: وهو في السابقة أيضا.(@)(@@)(@@)(@@) $ 2690 - محمد بن مرازم بن حكيم، مولى ثقة " ظم " الساباطي الأزدي ثقة، روى أبوه عن " ق " و " ظم " عليهما السلام " جش " " صه " له كتاب، عنه أبو عبد الله البرقي في الأول، وفي " مشكا " ابن مرازم الثقة أحمد بن محمد بن خالد عنه.(@)(@@)(@@)(@@) $ 2691 - محمد بن مروان، له روايات، عنه إبراهيم بن سليمان " ست ".(@)(@@)(@@)(@@) $ 2692 - محمد بن مروان أبو عيسى الوراق، له كتاب، ويأتي عن " جش " ابن هارون، واتحادهما غير معلوم. PageV01P356(@)(@@)(@@)(@@) $ 2693 - محمد بن مروان الأنباري، له كتاب 
ms258	 نوادر، عنه محمد بن أحمد بن يحيى الأشعري " جش " وفي " مشكا " كذلك.(@)(@@)(@@)(@@) $ 2694 - محمد بن مروان الجلاب، من أصحاب الهادي عليه السلام ثقة " صه " " جخ ".(@)(@@)(@@)(@@) $ 2695 - محمد بن مروان الخطاب " دي ".(@)(@@)(@@)(@@) $ 2696 - محمد بن المفضل بن عمر " ظم ".(@)(@@)(@@)(@@) $ 2697 - محمد بن منصور بن سعيد بن أبي الجهم، في ترجمة منذر بن محمد أنه من بيت جليل، وفي ترجمة سعيد بن أبي الجهم، وآل أبي الجهم بيت جليل بالكوفة " تعق " أقول: ولعله الذي يأتي بعيده، فتأمل.(@)(@@)(@@)(@@) $ 2698 - محمد بن منصور، من أصحاب الرضا عليه السلام مجهول، والذي في " ضا " ابن منصور الأشعثي مجهول، ثم ابن منصور الأشعري.(@)(@@)(@@)(@@) $ 2699 - محمد بن منصور بن نصر الخزاعي " ضا " ثم كرره ويقال: أحمد بن منصور، ويحتمل الاختلاف لا الاشتباه.(@)(@@)(@@)(@@) $ 2700 - محمد بن منصور بن يونس بزرج، كوفي ثقة " صه " " جش " له كتاب، عنه محمد بن الحسين الصائغ " جش " " ست " وفي " مشكا " مثله.(@)(@@)(@@)(@@) $ 2701 - محمد بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي عليهم السلام من أهل الفضل والصلاح، أخبرني أبو محمد الحسن بن محمد بن يحيى، قال: حدثني جدي، قال: حدثتني فاطمة مولاة رقية بنت موسى، قال: كان محمد هذا صاحب وضوء وصلاة، وكان ليله كله يتوضأ ويصلي، فنسمع سكب الماء ثم يصلي ليلا الحديث (1).(@)(@@)(@@)(@@) $ 2702 - محمد بن الوليد الخزاز فطحي، قال " جش " ثقة عين نقي الحديث، روى عن يونس بن يعقوب وحماد ومن في طبقتهما، وعمر حتى لقيه ابن الحسن(@)(@@) PageV01P357(@)(@@) الصفار، عنه أحمد البرقي والصفار، فيكون في السابقة.(@)(@@)(@@)(@@) $ 2703 - محمد بن الوليد الصيرفي شاب ضعيف " صه " وعن " شه " عليها شباب بالبائين الموحدتين بعد الشين المعجمة، وضعفه " غض " وفي " تعق " وصفه الكليني في الكافي والصدوق في توحيده بالشباب الصيرفي، ثم استظهر أن تضعيف العلامة من " غض " ولا يعبأ به.(@)(@@)(@@)(@@) $ 2704 - محمد بن هارون، روى عنه محمد بن أحمد بن يحيى " لم " " جش " ضعيف " صه " وعن " ست " و " جش " استثناءه من نوادر الحكمة.(@)(@@)(@@)(@@) $ 2705 - محمد بن هارون أبو عيسى الملقب بالوراق، له 
ms259	 كتب " جش " قال الميرزا: وكأنه المتقدم، أو الآتي في الكنى.(@)(@@)(@@)(@@) $ 2706 - محمد بن هشام الخثعمي، روى عن كرام وعلاء بن رزين وغيرهما، له كتاب " جش " وفي " كش " في هشام بن الحكم ما يدل على أنه عامي وفي " تعق " الذي يظهر هناك أنه من علماء الشيعة ومتكلميهم، ولعل عامي مصحف عالم أو عالم امامي ووقع سقط. أقول: من ثمة أنه من أهل العلم، فلاحظ.(@)(@@)(@@)(@@) $ 2707 - محمد بن الهيثم بن عروة التميمي، كوفي ثقة، روى أبوه عن بي عبد الله عليه السلام " صه " " جش " له كتاب، عنه أبو عبد الله البرقي " جش " " ست ".(@)(@@)(@@)(@@) $ 2708 - محمد بن يحيى " ظم " " قي " لم أقف له على مدح ولا ذم، فروايته مردودة كأضرابه.(@)(@@)(@@)(@@) $ 2709 - محمد بن يحيى أبو حنيفة لم أجده في كتب الرجال، ذكره في الكافي في باب مولد أمير المؤمنين عليه السلام يروي عنه محمد بن يحيى الفارسي، وهو عن الوليد بن أبان، فهو مردود الرواية كأضرابه على المختار.(@)(@@)(@@)(@@) $ 2710 - محمد بن يحيى أبو يحيى البصري " دي " وهو كسابقه غير معلوم الحال، والله أعلم.(@)(@@)(@@)(@@) $ 2711 - محمد بن يحيى الخزاز، روى عن أصحاب أبي عبد الله عليه السلام PageV01P358(@)(@@) ثقة عين " صه " " جش " له كتاب، عنه يحيى بن زكريا اللؤلؤي، وأحمد بن أبي عبد الله " ست " " جش ".(@)(@@)(@@)(@@) $ 2712 - محمد بن يحيى بن رئاب " دي " غير معلوم الوصف.(@)(@@)(@@)(@@) $ 2713 - محمد بن يحيى الصيرفي، له كتاب، عنه أبو عبد الله البرقي " ست ".(@)(@@)(@@)(@@) $ 2714 - محمد بن يزداد الرازي، قال معد: لا بأس به " كش " عنه " صه " عنه محمد بن الحسين بن أبي الخطاب " لم " أقول: وفي بعض النسخ نضر بدون أبو وكذا زعمه " ع ب " نظر فقال بعد ذكر ما في " صه " قلت: النصر لا اعتداد بقوله فأدرجه في الضعفاء والصواب أبو النضر وهو معد، فتأمل.(@)(@@)(@@)(@@) $ 2715 - محمد بن يزيد، من أصحاب " ظم " عليه السلام مجهول " صه ".(@)(@@)(@@)(@@) $ 2716 - محمد بن يزيد النهرواني " ظم ".(@)(@@)(@@)(@@) $ 2717 - محمد بن يونس، من أصحاب " ظم " عليه السلام ثقة " صه " " جخ " ابن يونس بن عبد 
ms260	 الرحمن " ضا " " ج " لحق الرضا عليه السلام، علي بن القتيبي عن ابن شاذان عن ابن أبي عمير أنه لما ضرب الحديث (1).(@)(@@)(@@)(@@) $ 2718 - المختار بن زياد العبدي، بصري من أصحاب أبي جعفر الثاني محمد بن علي عليهما السلام ثقة " صه " " جخ " الا من أصحاب أبي جعفر الثاني عليه السلام وفي " مشكا " عنه الحسين بن سعيد.(@)(@@)(@@)(@@) $ 2719 - المرزبان بن عمران بن عبد الله بن سعد الأشعري القمي، روى عن الرضا عليه السلام، له كتاب، عنه صفوان، وله رواية عنه عليه السلام تدل على كونه من الشيعة بتصديقه عليه السلام.(@)(@@)(@@)(@@) $ 2720 - مروان بن يحيى، من أصحاب الرضا عليه السلام مجهول " صه " " جخ ".(@)(@@) PageV01P359(@)(@@)(@@)(@@) $ 2721 - مروك بن عبيد بن سالم بن أبي حفصة مولى بني عجل، وقيل: إنه مولى عمار واسم مروك صالح واسم أبي حفصة زياد " صه " " جخ " ثقة شيخ صدوق، عنه أحمد بن أبي عبد الله بكتابه " ست ".(@)(@@)(@@)(@@) $ 2722 - مسافر مولى أبي الحسن عليه السلام قال: أمرني أبو الحسن عليه السلام بخراسان فقال: ألحق بأبي جعفر عليه السلام فإنه صاحبك " كش " وفي " د " أنه من رجال " ظم " وعن " كش " ممدوح، واستظهر في " تعق " جلالته كما عن غيره.(@)(@@)(@@)(@@) $ 2723 - مسكين أبو الحكم بن مسكين، كوفي ثقة ذكره سعد، له كتاب " جش " وفي " صه " ابن الحكم ثقة، وفي " د " ابن الحكم بن مسكين " جش " كوفي ثقة، وما في " صه " و " جش " كأنه أصح، فان الظاهر أن أباه هو الذي يروي عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 2724 - مسلم بن رستم الكوفي، روى عن " ظم " عليه السلام روى عنه حنان بن سدير " ق ".(@)(@@)(@@)(@@) $ 2725 - مصعب بن يزيد الأنصاري، قال أبو العباس: ليس بذاك، له كتاب، علي بن الحسن الطويل عنه به " جش " وهذا غير الآتي في أصحاب " ي " عليه السلام فإنه عامله كما يأتي عن " ق ".(@)(@@)(@@)(@@) $ 2726 - مصقلة بن إسحاق القمي الأشعري " دي ".(@)(@@)(@@)(@@) $ 2727 - معاوية بن حكيم بن معاوية بن عمار الدهني، ثقة جليل في أصحاب الرضا عليه السلام، عنه الصفار، وأحمد بن أبي عبد الله، وحمدان القلانسي، 