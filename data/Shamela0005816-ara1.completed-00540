ms521	 ما دفن(@)(@@)(@@)(@@) $ 2147 - الحارث بن لقيط النخعي الكوفي شهد القادسية يروي عن عمر روى عنه ابنه حنش بن الحارث(@)(@@)(@@)(@@) $ 2148 - الحارث بن زياد يروي عن أبي رهم السمعي وقد أدرك أبا أمامة روى عنه يونس بن سيف(@)(@@)(@@)(@@) $ 2149 - الحارث بن أبي موسى الأشعري يروي عن أبيه روى عنه ابنه كريب بن الحارث من حديث عبد العزيز بن المختار(@)(@@)(@@)(@@) $ 2150 - الحارث بن عكرمة يروي المراسيل روى عنه عباد بن إسحاق(@)(@@)(@@)(@@) $ 2151 - الحارث بن قيس أبو موسى كوفي رأى عليا روى عنه محمد بن قيس الكوفي(@)(@@)(@@)(@@) $ 2152 - الحارث بن مخلد الزرقي الأنصاري المدني يروي عن أبي هريرة PageV04P133 روى عنه سهيل بن أبي صالح وبسر بن سعيد(@)(@@)(@@)(@@) $ 2153 - الحارث مولى بن سباع يروي عن أبي سعيد الخدري روى عنه عبد الرحمن بن معاوية(@)(@@)(@@)(@@) $ 2154 - الحارث بن عمير الزبيدي الشامي يروي عن معاذ بن جبل روى عنه شريك(@)(@@)(@@)(@@) $ 2155 - الحارث بن عبد الرحمن كنيته أبو عبد الرحمن خال بن أبي ذئب غزا مع أصحاب رسول الله صلى الله عليه وسلم روى عنه بن أبي ذئب مات سنة سبع وعشرين ومائة وهو بن ثلاث وسبعين سنة(@)(@@)(@@)(@@) $ 2156 - الحارث بن معاقب يروي عن أبي هريرة روى عنه أبو الغصن ثابت بن قيس PageV04P134(@)(@@)(@@)(@@) $ 2157 - الحارث بن نوفل يروي عن عائشة روى عنه ابنه عبد الله بن الحارث الهاشمي(@)(@@)(@@)(@@) $ 2158 - الحارث بن النعمان الليثي يروي عن أنس بن مالك روى عنه سعيد بن عمارة(@)(@@)(@@)(@@) $ 2159 - الحارث بن معاوية الكندي شامي يروي عن عمر روى عنه سليم بن عامر(@)(@@)(@@)(@@) $ 2160 - الحارث بن يزيد الصنعاني يروي عن أبي ذر الغفاري روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 2161 - الحارث الأشعري والد مالك يروي عن أبي موسى عداده في PageV04P135 أهل الكوفة روى عنه ابنه مالك(@)(@@)(@@)(@@) $ 2162 - الحارث بن فضيل يروي عن عبد الرحمن بن أبي قراد وله صحبة روي عنه أبو جعفر الخطمي(@)(@@)(@@)(@@) $ 2163 - الحارث بن عبد مولى عثمان بن عفان روى عنه أبو عقيل زهرة بن معبد حديث الوضوء مات في 
ms522	 ولاية معاوية(@)(@@)(@@)(@@) $ 2164 - الحارث بن ميناء يروي عن عمر روى عنه محمد بن إبراهيم بن الحارث التيمي(@)(@@)(@@)(@@) $ 2165 - الحارث بن أبي يزيد مولى الحكم مدني يروي عن جابر بن عبد الله روى عنه محمد بن يحيى المدني وكثير بن زيد(@)(@@)(@@)(@@) $ 2166 - الحارث بن محمد يروي عن أبي الطفيل إن سمع منه روى عنه زافر بن سليمان PageV04P136(@)(@@)(@@)(@@) $ 2167 - الحارث بن يحمد الأشعري عداده في أهل الشام يروي عن عبد الله بن عمر روى عنه عبد الرحمن بن يزيد بن جابر وقد قيل إنه الحارث بن يمجد وهو الصحيح لا يحمد ولاه الوليد بن عبد الملك القضاء بعد يزيد بن أبي مالك(@)(@@)(@@)(@@) $ 2168 - الحارث بن يعقوب الأنصاري مصري يروي عن سهل بن سعد روى عنه ابنه عمرو بن الحارث وبكر بن مضر(@)(@@)(@@)(@@) $ 2169 - حبيب بن أبي ثابت مولى بنى أسد كنيته أبو يحيى عداده في أهل الكوفة واسم أبي ثابت قيس بن دينار يروى عن بن عمر وابن عباس روى عنه الأعمش والثوري مات في شهر رمضان سنة تسع عشرة ومائة كان مدلسا ثنا الهيثم بن خلف الدوري ببغداد قال ثنا إسحاق بن موسى الأنصاري قال ثنا أبو بكر بن عياش قال قدم PageV04P137 حبيب بن أبي ثابت على أهل الطائف فكأنما قرأ عليهم بشيء(@)(@@)(@@)(@@) $ 2170 - حبيب بن سالم مولى النعمان بن بشير كوفي يروي عن النعمان بن بشير روى عنه أبو بشر والكوفيون إبراهيم بن محمد بن المنتشر وغيره(@)(@@)(@@)(@@) $ 2171 - حبيب بن أبي فضالة المالكي وليس بالبصري يروي عن عمران بن حصين روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 2172 - حبيب بن صهبان الأسدي يروي عن عمار بن ياسر كنيته أبو مالك الكاهلي روى عنه أبو حصين والأعمش(@)(@@)(@@)(@@) $ 2173 - حبيب بن عبيد الرحبي الشامي أدرك سبعين من أصحاب رسول الله صلى الله عليه وسلم روى عنه أهل الشام وثور بن يزيد وغيره PageV04P138(@)(@@)(@@)(@@) $ 2174 - حبيب بن حماز الأسدي يروي عن على وأبي ذر روى عنه سماك بن حرب كنيته أبو كثير(@)(@@)(@@)(@@) $ 2175 - أبو جمعة اسمه 
ms523	 حبيب بن سباع من عباد التابعين رأى جماعة من الصحابة روى عنه أهل فلسطين(@)(@@)(@@)(@@) $ 2176 - حبيب بن أوس يروي عن عمرو بن العاص روى عنه راشد بن سعد(@)(@@)(@@)(@@) $ 2177 - حبيب مولى أسيد بن الأخنس يروي عن عثمان روى عنه عباد بن إسحاق(@)(@@)(@@)(@@) $ 2178 - حبيب بن أبي مليكة يروي عن بن عمر روى عنه كليب بن وائل PageV04P139(@)(@@)(@@)(@@) $ 2179 - حبيب بن أبي حبيب أبو عميرة ويقال أبو كشوثاء يروي عن أنس بن مالك روى عنه خالد أبو العلاء(@)(@@)(@@)(@@) $ 2180 - حبيب بن عبد الله يروي عن عائشة روى عنه يحيى بن عبد الله بن مالك(@)(@@)(@@)(@@) $ 2181 - حبيب بن شداد أحسبه مولى الزبير يروي عن طلحة بن عبيد الله روى عنه أبو بردة(@)(@@)(@@)(@@) $ 2182 - حبيب بن سبيعة الضبعي يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه ثابت البناني ومنهم من زعم أنه سبيعة بن حبيب الضبعي وقد وهم من قاله(@)(@@)(@@)(@@) $ 2183 - حبيب بن أبي كثير يروي عن بن عمر وابن عباس روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 2184 - حبيب بن أبي جبيرة يروي عن يعلى بن سيابة روى عنه PageV04P140 عاصم بن أبي النجود(@)(@@)(@@)(@@) $ 2185 - حبيب بن أبي مليكة النهدي الحداني كنيته أبو ثور يروي عن بن عمر روى عنه الشعبي(@)(@@)(@@)(@@) $ 2186 - حبيب بن مهران التيمي كوفي يروي عن بن أبي أوفى روى عنه عبد الواحد وابن نمير كنيته أبو مالك(@)(@@)(@@)(@@) $ 2187 - حبيب يروي عن أبيه عن النبي صلى الله عليه وسلم روى عنه ابنه هرماس بن حبيب(@)(@@)(@@)(@@) $ 2188 - حبيب بن هند بن أسماء بن حارثة يروي عن أبيه أن النبي صلى الله عليه وسلم بعثه إلى قومه يأمرهم بصيام عاشوراء روى عنه أهل المدينة قال محمد بن إسحاق عن عبد الله بن أبي بكر عن حبيب بن هند عن أبيه PageV04P141 وقال وهيب عن عبد الرحمن بن حرملة عن يحيى بن هند عن أبيه وكأنهما أخوان إن شاء الله(@)(@@)(@@)(@@) $ 2189 - حبيب بن يعلى بن أمية يروي عن بن عباس عن النبي صلى 
ms524	 الله عليه وسلم لو أن لابن آدم واديين من مال لابتغى إليهما ثالثا روى عنه مصعب بن شيبة(@)(@@)(@@)(@@) $ 2190 - حبيب بن يزيد يروي عن زيد بن أرقم روى عنه عمارة الأحمر(@)(@@)(@@)(@@) $ 2191 - حبيب بن هرم يروي عن عمه عن النبي صلى الله عليه وسلم ولا أدري من عمه روى عنه عون بن ذكوان(@)(@@)(@@)(@@) $ 2192 - حبيب بن سالم يروي عن أبي هريرة روى عنه محمد بن سعيد PageV04P142 الأنصاري إن لم يكن مولى النعمان بن بشير فلا أدري من هو(@)(@@)(@@)(@@) $ 2193 - حبيب بن يسار يروي عن زيد بن أرقم روى عنه يوسف بن صهيب(@)(@@)(@@)(@@) $ 2194 - حبيب الهذلي يروي عن أبي هريرة روى عنه مسلم بن جندب(@)(@@)(@@)(@@) $ 2195 - حبيب بن إبراهيم بن سعد أبو يوسف مولى سعيد بن عبد الملك قال صليت خلف أنس بن مالك بالبصرة يوم الفطر فكبر في الأولى سبعا وفي الثانية خمسا روى عنه إدريس بن يحيى الخولاني المصري وقتيبة بن سعيد وابن بكير ثنا محمد بن عبد الله بن الجنيد قال ثنا قتيبة بن سعيد قال ثنا حبيب بن إبراهيم بن سعد مولى لبني أمية قال رأيت أنس بن مالك بالبصرة كبر عند الخروج إلى المصلى فاجتمع إليه ناس فصلى بهم يوم الفطر فكبر في الأولى سبعا وفي الثانية خمسا(@)(@@)(@@)(@@) $ 2196 - الحكم بن مسعود الثقفي يروي عن عمر روى عنه وهب بن منبه(@)(@@)(@@)(@@) $ 2197 - الحكم بن أبي العاص الثقفي أخو عثمان بن أبي العاص عداده في أهل البصرة روى عنه معاوية بن قرة PageV04P143(@)(@@)(@@)(@@) $ 2198 - الحكم بن قيس بن عاصم المنقري يروي عن أبيه روى عنه قتادة بن دعامة وهو أخو حكيم بن قيس(@)(@@)(@@)(@@) $ 2199 - الحكم بن عتيبة بن النهاس مولى امرأة من كندة من بنى عدى كوفي كنيته أبو محمد وقد قيل أبو عبد الله يروي عن أبي جحيفة وزيد بن أرقم روى عنه منصور وشعبة ولد سنة خمسين في ولاية معاوية ومات سنة خمس عشرة ومائة وقد قيل سنة ثلاث عشرة ومائة وكان يدلس وكان سنه سن 
ms525	 إبراهيم النخعي وهو الحكم بن عتيبة بن النهاس بن حنطب بن يسار من ولد سعد بن عجل(@)(@@)(@@)(@@) $ 2200 - الحكم بن عبد الله بن إسحاق بن الأعرج الثقفي يروي عن أبي هريرة وابن عباس روى عنه خالد الحذاء وابن أخيه حاجب بن PageV04P144 عمر الثقفي وهو الذي سأل بن عباس عن صيام يوم عاشوراء فقال إذا رأيت هلال المحرم فاعدد فإذا أصبحت من تاسعة فأصبح منها صائما فقلت أكذلك كان محمد صلى الله عليه وسلم يصوم قال نعم(@)(@@)(@@)(@@) $ 2201 - الحكم بن أيوب يروي عن أبي هريرة روى عنه الجريري(@)(@@)(@@)(@@) $ 2202 - الحكم بن ميناء يروى عن بن عمر وابن عباس روى يحيى بن أبي كثير عن أبي سلام عنه(@)(@@)(@@)(@@) $ 2203 - الحكم بن ميناء المدني يروي عن بلال روى عنه ابنه شبيب بن الحكم وهو الذي يروى عن بن عمر وأبي هريرة لينتهين أقوام عن تركهم الجمعات أو ليختمن الله على قلوبهم وليكتبن من الغافلين روى عنه معاوية بن سلام(@)(@@)(@@)(@@) $ 2204 - الحكم بن الأزرق يروي عن عبد الله بن عمرو روى عنه عكرمة بن خالد PageV04P145(@)(@@)(@@)(@@) $ 2205 - الحكم بن الوليد الوحاظي يروي عن عبد الله بن بسر روى عنه عبد الله بن عبد الجبار الخبائري وكان الحكم إمام مسجد حمص(@)(@@)(@@)(@@) $ 2206 - الحكم بن عمر يروي عن عبد الله بن بسر روى عنه أهل الشام(@)(@@)(@@)(@@) $ 2207 - الحكم التجيبي يروي عن أبي هريرة روى عنه محمد بن قيس النخعي(@)(@@)(@@)(@@) $ 2208 - الحكم يروي عن بن عباس روى سفيان عن أبي يحيى عنه(@)(@@)(@@)(@@) $ 2209 - الحكم شيخ يروي عن أنس بن مالك روى عنه معاوية بن صالح لا أدرى من هما ولا من أبوهما(@)(@@)(@@)(@@) $ 2210 - حميد بن عبد الرحمن بن عوف الزهري القرشي أخو إبراهيم وأبي سلمة وأم حميد أولاد عبد الرحمن يروي عن عثمان وأبي هريرة ومعاوية أمه أم كلثوم بنت عقبة بن أبي معيط روى عنه الزهري كنيته أبو عبد الرحمن وقد قيل أبو إبراهيم مات قبل عمر بن عبد العزيز بالمدينة وقد قيل إنه مات سنة خمس 
ms526	 ومائة وهو بن ثلاث وسبعين سنة(@)(@@)(@@)(@@) $ 2211 - حميد بن النعمان بن بشير الأنصاري يروي عن أبيه روى عنه الزهري PageV04P146(@)(@@)(@@)(@@) $ 2212 - حميد بن عبد الرحمن الحميري البصري كان فقيها عالما يروي عن بن عباس وأبي هريرة روى عنه بن سيرين وأهل البصرة(@)(@@)(@@)(@@) $ 2213 - حميد بن نافع بن صفوان أبو أفلح مولى صفوان بن خالد ويقال مولى أبي أيوب الأنصاري وهو الذي يقال له حميد صفيرا يروي عن بن عمر روى عنه عبد الرحمن بن القاسم وابنه أفلح بن حميد(@)(@@)(@@)(@@) $ 2214 - حميد بن هلال العدوى الهلالي البصري كنيته أبو نصر يروي عن أنس بن مالك روى عنه أيوب وابن عون مات في ولاية خالد على العراق(@)(@@)(@@)(@@) $ 2215 - حميد بن ربيعة القرشي الشامي يروي عن أبي أمامة والمقدام PageV04P147 روى عنه محمد بن حرب الأبرش(@)(@@)(@@)(@@) $ 2216 - حميد بن مالك بن خثيم يروي عن سعد بن أبي وقاص وأبي هريرة روى عنه محمد بن عمرو بن حلحلة وبكير بن عبد الله بن الأشج ويقال هو حميد بن عبد الله بن مالك بن خثيم(@)(@@)(@@)(@@) $ 2217 - حميد بن أبي حميد الطويل البصري مولى طلحة الطلحات الخزاعي واسم أبيه تيرويه وقد قيل تير ويقال اسم أبيه عبد الرحمن وقد قيل إن اسم أبيه طرخان وهو الذي يقال له حميد بن أبي داود كان قصير القامة طويل اليدين يسمى حميد الطويل كنيته أبو عبيدة ويقال أبو عبيد مولده سنة ثمان وستين ومات سنة ثلاث وأربعين ومائة يروي عن أنس بن مالك روى عنه الناس وكان يدلس سمع من أنس بن مالك ثمانية عشر حديثا وسمع الباقي من ثابت فدلس عنه(@)(@@)(@@)(@@) $ 2218 - حميد بن زاذويه مولى خزاعة وقد قيل زاذويه الأزرق PageV04P148 يروي عن أنس بن مالك روى عنه بن عون وليس هذا بحميد الطويل(@)(@@)(@@)(@@) $ 2219 - حميد الضبعي البصري والد أبي التياح يروي المراسيل روى عنه ابنه أبو التياح واسمه يزيد بن حميد(@)(@@)(@@)(@@) $ 2220 - حميد بن رومان يروي عن أبي الدرداء روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 2221 - حميد بن 
ms527	 عبد الله المزني يروي عن أبي كبشة الأنماري وعبادة بن الصامت روى عنه ابنه عبد الله بن حميد وصفوان بن عمرو وأهل الشام(@)(@@)(@@)(@@) $ 2222 - أبو هانئ اسمه حميد بن هانئ من أهل مصر قال ثنا عمرو بن حريث أن رسول الله صلى الله عليه وسلم قال ما خففت عن خادمك من عمله كان لك أجر في موازينك رواه عنه سعيد بن أبي أيوب وقد ذكرناه في كتاب مسند الصحيح(@)(@@)(@@)(@@) $ 2223 - حميد بن مخراق الأنصاري يروي عن أنس بن مالك روى عنه PageV04P149 سعيد بن أبي أيوب وعمرو بن الحارث(@)(@@)(@@)(@@) $ 2224 - حميد بن أبي حميد يروي عن بن عباس روى عنه عامر بن يحيى(@)(@@)(@@)(@@) $ 2225 - حميد بن جبير مولى بن عباس يروي عن بن عباس روى عنه عيسى بن عبد الرحمن(@)(@@)(@@)(@@) $ 2226 - حميد بن عقبة القرشي الفلسطيني يروى عن بن عمر وأبي الدرداء روى عنه يحيى بن أبي عمرو الشيباني والوليد بن سليمان بن أبي السائب وقيل حميد المقرى(@)(@@)(@@)(@@) $ 2227 - حميد بن أبي عطاء يروي عن عبد الله بن عمرو روى ليث بن أبي سليم عن الحسن الكوفي عنه(@)(@@)(@@)(@@) $ 2228 - حميد بن بشير يروي عن أبي موسى الأشعري روى عنه يزيد بن خصيفة(@)(@@)(@@)(@@) $ 2229 - حميد بن أخت صفوان بن أمية يروي عن صفوان بن أمية PageV04P150 روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 2230 - حميد والد سليمان بن حميد يروي عن سعيد بن العاص عداده في أهل مصر روى عنه سماك بن حرب وهو الذي روى عنه عمرو بن الحارث عن سليمان بن حميد عن أبيه عن أبي هريرة(@)(@@)(@@)(@@) $ 2231 - حفص بن عبيد الله بن أنس بن مالك الأنصاري يروي عن أنس روى عنه يحيى بن سعيد الأنصاري ويحيى بن أبي كثير(@)(@@)(@@)(@@) $ 2232 - حفص بن عبد الله بن أبي طلحة الأنصاري بن أخي أنس بن مالك صحب أنسا إلى الشام روى عنه عكرمة بن عمار وخلف بن خليفة(@)(@@)(@@)(@@) $ 2233 - حفص بن عبد الله الليثي يروي عن عمران بن حصين روى عنه PageV04P151 أبو التياح يزيد بن 
ms528	 حميد(@)(@@)(@@)(@@) $ 2234 - حفص بن عاصم بن عمر بن الخطاب المدني يروي عن بن عمر وأبي هريرة روى عنه القاسم وسالم وخبيب بن عبد الرحمن(@)(@@)(@@)(@@) $ 2235 - حفص بن النضر بن أنس بن مالك سمع أنس بن مالك يقول كان النبي صلى الله عليه وسلم إذا هاجت الريح الدبور تغير لونه حتى يعرف ذلك في وجهه رواه عمر بن عاصم عن عمارة بن زاذان المعولي قال ثنا حفص وعبد الله ابنا النضر بن أنس أنهما سمعا أنس بن مالك(@)(@@)(@@)(@@) $ 2236 - حفص بن عياض يروي عن أنس بن مالك روى عنه مالك بن إسماعيل(@)(@@)(@@)(@@) $ 2237 - حفص بن جابر الراسبي يروي عن أنس بن مالك روى عنه يزيد بن عبد الله الشامي(@)(@@)(@@)(@@) $ 2238 - حفص بن أبي حفص يروى عن بن عمر وابن عباس روى عنه السدى PageV04P152(@)(@@)(@@)(@@) $ 2239 - حفص بن ثابت الشامي يروي عن النعمان بن بشير روى عنه ابنه عمر بن حفص(@)(@@)(@@)(@@) $ 2240 - حفص بن عمر بن سعد بن عابد القرظ المؤذن المديني يروي عن زيد بن ثابت روى عنه الزهري(@)(@@)(@@)(@@) $ 2241 - حفص بن عمر بن أبي الزبير يروي عن أنس بن مالك روى عنه يحيى بن عبد الملك بن أبي غنية(@)(@@)(@@)(@@) $ 2242 - حفص بن عنان الحنفي من أهل اليمامة سمع أبا هريرة يروي عن نافع روى عنه الأوزاعي وابنه عمر بن حفص ويحيى بن أبي كثير(@)(@@)(@@)(@@) $ 2243 - حجاج بن حجاج بن مالك الأسلمي الحجازي يروي عن أبيه PageV04P153 وأبي هريرة روى عنه عروة بن الزبير ومن زعم أن له صحبة فقد وهم حديث الرضاع سمعه من أبيه عن النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 2244 - حجاج بن لاحق بن حميد بن أبي مجلز يروي عن بن عمر أنه أتاه رجل فقال إني وجدت حصيرا فقال أنشده قال قد أنشدته فلم يعرف فأعاد عليه فقال له بن عمر بالله لا يأمرك بن عمر أن تنتفع به روى عنه قتادة من حديث معاذ بن هشام عن أبيه(@)(@@)(@@)(@@) $ 2245 - حجاج بن مالك عداده في أهل البصرة يروي عن 
ms529	 أنس بن مالك روى عنه شبيب أبو الحارث(@)(@@)(@@)(@@) $ 2246 - حجاج بن مالك النصرى من أهل مصر يروي عن أنس بن مالك روى عنه شيبة بن الحارث(@)(@@)(@@)(@@) $ 2247 - حجاج بن يسار يروي عن بن عمر روى عنه ليث بن أبي سليم(@)(@@)(@@)(@@) $ 2248 - حجاج بن الورد الأزدي مولى عتيك يروي عن أنس بن مالك روى عنه ابنه شعبة بن الحجاج PageV04P154(@)(@@)(@@)(@@) $ 2249 - حجاج بن السائب بن أبي لبابة الأنصاري الذي يروي عن جدته خنساء بنت خذام ولها صحبة روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 2250 - حسين بن السائب بن أبي لبابة يروي عن أبيه المراسيل روى عنه الزهري(@)(@@)(@@)(@@) $ 2251 - حسين بن الحارث أبو القاسم الجدلي من جديلة قيس يروي عن بن عمر والنعمان بن بشير عداده في أهل الكوفة روى عنه يزيد بن زياد بن أبي الجعد وأبو مالك الأشجعي(@)(@@)(@@)(@@) $ 2252 - حسين بن خارجة يروي عن سعد بن أبي وقاص روى عنه أبو حازم(@)(@@)(@@)(@@) $ 2253 - حسين بن شفى بن ماتع الأصبحي المصري يروي عن عبد الله بن عمرو وتبيع روى عنه النعمان بن عمرو بن خالد وحيوة بن شريح(@)(@@)(@@)(@@) $ 2254 - حسين بن أبي سفيان يروي عن أنس بن مالك روى عنه عبد الرحمن بن إسحاق أبو شيبة PageV04P155(@)(@@)(@@)(@@) $ 2255 - حسين بن عبد الرحمن الأشجعي يروي عن سعد بن أبي وقاص روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2256 - حصين بن جندب الجنبي أبو ظبيان الكوفي يروي عن علي بن أبي طالب وسلمان روى عنه إبراهيم والأعمش وهو والد قابوس بن أبي ظبيان مات سنة ست وتسعين(@)(@@)(@@)(@@) $ 2257 - حصين بن قيس بن عاصم المنقري أخو حكيم بن قيس يروي عن أبيه روى عنه ابنه خليفة بن حصين(@)(@@)(@@)(@@) $ 2258 - حصين بن الحر الفزاري وقد قيل حصين بن أبي الحر الكوفي روى عن سمرة بن جندب روى عنه عبد الملك بن عمير PageV04P156(@)(@@)(@@)(@@) $ 2259 - حصين بن حدير يروي عن عمر أنه قال لا قطع في عذق ولا في عام سنة يعنى مجاعة روى عنه حسان بن زاهر ويحيى بن أبي كثير(@)(@@)(@@)(@@) $ 2260 - حصين 
ms530	 بن نمير يروي عن بلال روى عنه ابنه يزيد بن حصين(@)(@@)(@@)(@@) $ 2261 - حصين بن محصن الأنصاري عداده في أهل المدينة يروي عن أم قيس ولها صحبة وهى عمته روى عنه بشير بن يسار(@)(@@)(@@)(@@) $ 2262 - حصين بن قبيصة الفزاري يروي عن على وابن مسعود روى عنه القاسم بن عبد الرحمن والركين بن الربيع(@)(@@)(@@)(@@) $ 2263 - حصين بن عقبة الفزاري يروي عن على وسلمان وهو أخو زيد بن عقبة روى عنه ابنه مالك بن حصين وصالح بن خباب PageV04P157(@)(@@)(@@)(@@) $ 2264 - حصين بن سبرة يروي عن عمر روى عنه إبراهيم التيمي(@)(@@)(@@)(@@) $ 2265 - حصين بن أوس يروي عن عثمان بن عفان وابن عمر روى عنه عمر بن أبي معتب وعبد الرحمن بن حصين وهو الذي يقال له حصين بن أويس(@)(@@)(@@)(@@) $ 2266 - حصين بن يزيد الثعلبي يروى عن بن مسعود وأسماء بنت عميس روى عنه أبو اليقظان وعمران بن سليمان القبي له عشرة أحاديث(@)(@@)(@@)(@@) $ 2267 - حصين بن مصعب يروي عن أبي هريرة روى عنه يحيى بن حمزة(@)(@@)(@@)(@@) $ 2268 - حصين بن مالك الجعفي يروي عن بن عباس روى عنه PageV04P158 أبو العلاء الخفاف(@)(@@)(@@)(@@) $ 2269 - حصين بن محمد السالمي الأنصاري من أهل المدينة روى عن عتبان بن مالك روى عنه الزهري(@)(@@)(@@)(@@) $ 2270 - حصين بن عرفطة اليربوعي التميمي يروي عن أبي هريرة روى عنه عنترة بن أبي العيس ويقال بالصاد(@)(@@)(@@)(@@) $ 2271 - حصين بن عبد الله الهفاني يروي عن أنس بن مالك روى عنه سعيد بن مسروق والثوري(@)(@@)(@@)(@@) $ 2272 - حصين بن عبد الله الشيباني يروي عن على روى عنه أبو سنان ضرار بن مرة(@)(@@)(@@)(@@) $ 2273 - حماد بن أبي سليمان مولى إبراهيم بن أبي موسى الأشعري واسم PageV04P159 أبيه مسلم روى عن أنس روى عنه الثوري وشعبة وأبو حنيفة مات سنة تسع عشرة ومائة وقد قيل سنة عشرين ومائة يخطىء وكان مرجئا سمع أنس بن مالك وأكثر روايته عن إبراهيم النخعي والتابعين وكان لا يقول بخلق القرآن(@)(@@)(@@)(@@) $ 2274 - حماد بن سليم القرشي يروي المراسيل روى عنه أبو بكر بن أبي مريم الغساني(@)(@@)(@@)(@@) $ 2275 - حكيم 
ms531	 بن قيس بن عاصم المنقري يروي عن أبيه روى عنه مطرف بن الشخير وقتادة(@)(@@)(@@)(@@) $ 2276 - حكيم بن جابر بن أبي طارق بن عوف الأحمسي الكوفي يروي عن عمر وعبد الله بن مسعود روى عنه إسماعيل بن أبي خالد مات في آخر إمارة الحجاج PageV04P160(@)(@@)(@@)(@@) $ 2277 - حكيم بن معاوية بن حيدة القشيري بصرى يروي عن أبيه روى عنه ابنه بهز والجريري وقتادة(@)(@@)(@@)(@@) $ 2278 - حكيم بن أبي حرة يروي عن أبي أمامة وابن عمر روى عنه موسى بن عقبة وهو عم محمد بن عبد الله بن أبي حرة(@)(@@)(@@)(@@) $ 2279 - حكيم بن دينار أبو طلحة الشامي قوله روى عنه عبد الرحمن بن يزيد بن جابر(@)(@@)(@@)(@@) $ 2280 - حكيم بن دينار يروي عن بن عمر روى عنه الحسن البصري(@)(@@)(@@)(@@) $ 2281 - حكيم السلمي يروى عن بن عباس كنيته أبو إدريس روى عنه منصور بن معتمر(@)(@@)(@@)(@@) $ 2282 - حكيم الصنعاني يروي عن عمر روى عنه ابنه المغيرة بن حكيم(@)(@@)(@@)(@@) $ 2283 - حكيم بن عقال القرشي يروي عن بن عمر روى عنه قتادة سمع حكيم عثمان(@)(@@)(@@)(@@) $ 2284 - حكيم بن أبي حكيم يروي عن أبي أمامة روى عنه ليث بن أبي سليم PageV04P161(@)(@@)(@@)(@@) $ 2285 - حكيم بن عمرو يروي عن بن عباس روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 2286 - حكيم بن الحارث نسيب بن سيرين يروي عن بن عباس روى عنه ابنه الحسن بن حكيم(@)(@@)(@@)(@@) $ 2287 - حكيم بن عمير أبو الأحوص العنسي الشامي يروي عن عمر روى عنه ابنه الأحوص بن حكيم ومعاوية بن صالح(@)(@@)(@@)(@@) $ 2288 - حكيم بن عباد بن حنيف الأنصاري يروي عن بن عباس روى عنه عثمان بن حكيم(@)(@@)(@@)(@@) $ 2289 - حكيم بن بشير يروي عن أبي أيوب الأنصاري روى عنه الزهري(@)(@@)(@@)(@@) $ 2290 - حكيم بن دريم يروي عن عمر روى عنه محمد بن واسع ويقال رويم وهو الذي يروي عن أنس بن مالك(@)(@@)(@@)(@@) $ 2291 - حسان بن حريث أبو السوار العدوى البصري يروي عن عمران بن حصين روى عنه البصريون وغيره وقد قيل اسم PageV04P162 أبي السوار منقذ(@)(@@)(@@)(@@) $ 2292 - حسان بن أنس الثعلبي الكوفي يروي 
ms532	 عن عائشة روى عنه زياد بن علاقة(@)(@@)(@@)(@@) $ 2293 - حسان بن فائد العبسي كوفي يروي عن عمر روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2294 - حسان البجلي يروي عن حذيفة روى عنه الأسود بن قيس(@)(@@)(@@)(@@) $ 2295 - حسان بن حمضة ويقال بن ضمرة يروي عن عبد الله بن عمرو روى عنه حيان بن عمير(@)(@@)(@@)(@@) $ 2296 - حسان بن مخارق الكوفي يروي عن أم سلمة روى عنه أبو إسحاق الشيباني PageV04P163(@)(@@)(@@)(@@) $ 2297 - حسان بن كريب الحميري المصري يروي عن على روى عنه أبو الخير مرثد بن عبد الله اليزني وقد قيل إنه حسان بن أبي كريب(@)(@@)(@@)(@@) $ 2298 - حسان بن بلال المزني يروي عن عمار بن ياسر إن سمع منه روى عنه قتادة وأبو قلابة(@)(@@)(@@)(@@) $ 2299 - حسان بن أبي الضمري يروي عن عبد الله بن السعدي روى عنه أبو إدريس الخولاني ويقال بن الضمري(@)(@@)(@@)(@@) $ 2300 - حسان بن عبد الرحمن يروي المراسيل روى عنه قتادة(@)(@@)(@@)(@@) $ 2301 - حسان بن أبي وجزة مولى قريش يروي المراسيل روى عنه مجاهد(@)(@@)(@@)(@@) $ 2302 - حسان بن نوح الحمصي النصري كنيته أبو أمية يروي عن عبد الله بن بسر قال نهى رسول الله صلى الله عليه وسلم عن صيام يوم السبت إلا في فريضة وقال إن لم يجد أحدكم إلا لحاء شجرة فليفطر عليه روى PageV04P164 عنه مبشر بن إسماعيل الحلبي وأهل الشام(@)(@@)(@@)(@@) $ 2303 - حسان بن زيد قال سمعت علي بن أبي طالب يقول يا أيها الناس إنكم تكثرون في وفي عثمان وإنما مثلي ومثله كما قال الله عز وجل ونزعنا ما في صدورهم من غل إخوانا على سرر متقابلين رواه محمد بن الصباح الجرجاني قال أنبأتنا أم عمرو بنت حسان بن زيد سمعت أبي يقول دخلت مسجدا الأكبر مسجد الكوفة وعلي بن أبي طالب قائم على المنبر وهو ينادي بأعلى صوته أيها الناس محمد بن إسحاق الثقفى عنه(@)(@@)(@@)(@@) $ 2304 - حسان بن وبرة المزني البصري كنيته أبو عثمان يروي عن أبي هريرة روى عنه عمرو بن شراحيل(@)(@@)(@@)(@@) $ 2305 - حنظلة بن أبي الأسقع الأسلمى ويقال بن الأسقع السلمي 
ms533	 يروي عن أبي هريرة روى عنه الزهري وعمران بن أبي أنس عداده PageV04P165 في أهل المدينة(@)(@@)(@@)(@@) $ 2306 - حنظلة بن قيس الزرقي الأنصاري المدني يروي عن رافع بن خديج وأبي هريرة روى عنه يحيى بن سعيد الأنصاري وربيعة بن أبي عبد الرحمن أمه أم حنطب بنت قيس بن حصن بن خالد بن مخلد وقد رأى حنطب عمر وعثمان(@)(@@)(@@)(@@) $ 2307 - حنظلة بن سويد يروي عن عبد الله بن عمرو روى عنه العوام بن حوشب(@)(@@)(@@)(@@) $ 2308 - حنظلة الشيباني يروي عن عمر روى عنه ابنه علي بن حنظلة(@)(@@)(@@)(@@) $ 2309 - حنظلة بن خويلد الغنوي يروي عن عبد الله بن عمر روى عنه الأسود بن شيبان(@)(@@)(@@)(@@) $ 2310 - حنظلة بن خويلد يروي عن بن مسعود روى عنه بن أبى الهذيل PageV04P166(@)(@@)(@@)(@@) $ 2311 - حنظلة بن نعيم العنبري يروي عن علي روى عنه ابنه أبو طلق بن حنظلة واسم أبي طلق غضبان بن حنظلة(@)(@@)(@@)(@@) $ 2312 - حنظلة بن عبيد الله السدوسي يروي عن أنس بن مالك أن النبي صلى الله عليه وسلم أمر بلالا أن يثني الأذان ويفرد الإقامة رواه أبو غانم يونس بن نافع عن منيع عن حنظلة(@)(@@)(@@)(@@) $ 2313 - حنظلة بن قنان أبو محمد يروي عن عثمان بن عفان وأنس بن مالك روى عنه سماك بن حرب PageV04P167(@)(@@)(@@)(@@) $ 2314 - حنظلة أبو خلدة يروي عن على وابن مسعود روى عنه محمد بن مسلم أبو ثمالة وجويرية بن بشير(@)(@@)(@@)(@@) $ 2315 - حمزة بن أبي أسيد الساعدي المدني كنيته أبو مالك واسم أبي أسيد مالك بن ربيعة الأنصاري يروي عن أبيه روى عنه الزهري مات في زمن الوليد بن عبد الملك(@)(@@)(@@)(@@) $ 2316 - حمزة بن صهيب بن سنان المدني يروي عن أبيه خياركم من أطعم الطعام ورد السلام روى عنه بن عقيل(@)(@@)(@@)(@@) $ 2317 - حمزة بن المغيرة بن شعبة يروي عن أبيه روى عنه بكر بن عبد الله المزني وإسماعيل بن محمد(@)(@@)(@@)(@@) $ 2318 - حمزة بن عبد الله بن عمر بن الخطاب والد عمر بن حمزة من أهل المدينة كنيته أبو عمارة أمه أم سالم وكانت أم ولد يروي 
ms534	 عن أبيه روى عنه الزهرى PageV04P168(@)(@@)(@@)(@@) $ 2319 - حمزة بن عبد الله بن الزبير بن العوام القرشي والد عباد وعبد الواحد كنيته أبو عمار يروي عن أبيه وعائشة روى عبد الحميد بن جعفر عن أبيه عنه أمه تماظر بنت منظور بن زبان بن سيار بن عمرو بن جابر من فزارة(@)(@@)(@@)(@@) $ 2320 - حمزة بن عبد الله بن عتبة بن مسعود الهذلي أخو عون بن عبد الله يروي عن عمرو بن حريث روى عنه أبو العميس وعمرو بن أبي عمرو(@)(@@)(@@)(@@) $ 2321 - حمزة بن أبي سعيد الخدري يروي عن أبيه روى عنه عبد الله بن محمد بن عقيل أمه بنت عبد الله بن الحارث بن قيس(@)(@@)(@@)(@@) $ 2322 - حمزة القرشي يروي عن بن عباس روى عنه الحسن بن عمرو(@)(@@)(@@)(@@) $ 2323 - حمزة بن عبد كلال يروي عن عمر بن الخطاب روى عنه راشد بن سعد(@)(@@)(@@)(@@) $ 2324 - حمزة بن عمرو الضبي العائذي وعائذ الله من ضبة يروي عن أنس PageV04P169 بن مالك عداده في أهل البصرة روى عنه شعبة وعوف الأعرابي وقد وهم من زعم أنه جمرة(@)(@@)(@@)(@@) $ 2325 - حمزة بن يوسف بن عبد الله بن سلام يروي عن أبيه روى عنه محمد بن حمزة(@)(@@)(@@)(@@) $ 2326 - حمزة بن هانئ الرحبي يروي عن أبي أمامة روى عنه حريز بن عثمان وقد وهم من زعم أنه حمزة(@)(@@)(@@)(@@) $ 2327 - حمزة بن سلمة أبو أيوب الدالاني أمام مسجد الدالاني يروي عن أنس بن مالك روى عنه محمد بن ربيعة وأبو نعيم(@)(@@)(@@)(@@) $ 2328 - حمزة بن موسى بن أنس بن مالك الأنصاري يروي عن أنس روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 2329 - حيان بن حصين أبو الهياج الأسدي يروي عن على وعمار بن ياسر روى عنه أبو وائل والشعبي(@)(@@)(@@)(@@) $ 2330 - حيان بن إياس البارقي الأزدي يروي عن بن عمر روى عنه شعبة PageV04P170(@)(@@)(@@)(@@) $ 2331 - حيان بن عمير الجريري القيسي أبو العلاء البصري يروي عن بن عباس وعبد الرحمن بن سمرة روى عنه البصريون سعيد بن إياس الجريري وغيره(@)(@@)(@@)(@@) $ 2332 - حيان بن الحارث أبو عقيل يروي عن 
ms535	 على روى عنه شبيب(@)(@@)(@@)(@@) $ 2333 - حيان الأنصاري يروي المراسيل روى عنه ابنه عمران بن حيان(@)(@@)(@@)(@@) $ 2334 - حيان الهذلي والد سليم بن حيان يروي عن أبي هريرة روى عنه ابنه سليم بن حيان(@)(@@)(@@)(@@) $ 2335 - حيان أبو النضر الأسدي من أهل الشام يروي عن واثلة بن الأسقع روى عنه هشام بن الغاز(@)(@@)(@@)(@@) $ 2336 - حيان بن جحدر أبو السمين الطائي يروي عن بن عمر روى عنه شيخ يقال له عتبة بن سليمان بن أبي سليمان وقد قيل إنه حيان بن حجر PageV04P171(@)(@@)(@@)(@@) $ 2337 - حيان بن أبحر الهمداني قوله وهو جد عبد الملك بن سعيد بن حيان بن أبحر الكوفي روى عنه الأعمش(@)(@@)(@@)(@@) $ 2338 - حيان بن وبرة المدني يروي عن أبي هريرة روى عنه عمرو بن شرحبيل(@)(@@)(@@)(@@) $ 2339 - حيان أبو سعيد التيمي يروي عن على روى عنه الأعمش(@)(@@)(@@)(@@) $ 2340 - حيان بن كريب يروي عن معاوية بن أبي سفيان روى عنه عياش بن عباس القتباني(@)(@@)(@@)(@@) $ 2341 - حيان بن ضمرة الباهلي يروي عن عائشة روى عنه التبوذكي(@)(@@)(@@)(@@) $ 2342 - حرب بن الحارث يروي عن على روى عنه الربيع بن زياد(@)(@@)(@@)(@@) $ 2343 - حرب بن ناجدة يروي عن بن عباس روى هشيم عن شيخ له عنه وقد روى عنه أبو حمزة وقال إنه حرب بن ناجية(@)(@@)(@@)(@@) $ 2344 - حرب بن عبيد الله كوفي يروي عن خال له عن النبي صلى الله عليه وسلم روى عنه عطاء بن السائب PageV04P172(@)(@@)(@@)(@@) $ 2345 - حرب بن هلال الثقفي يروي عن أبي أمامة الباهلي عن النبي صلى الله عليه وسلم روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 2346 - حرب بن مخشى شهد الجمل بصرى روى عنه سليمان التيمي وكان مع علي بن أبي طالب رضي الله عنه(@)(@@)(@@)(@@) $ 2347 - حرب بن وحشي بن حرب الحبشي مولى جبير بن مطعم يروي عن أبيه عداده في أهل الشام روى عنه ابنه وحشي(@)(@@)(@@)(@@) $ 2348 - حرملة بن إياس الشيباني يروي عن أبي قتادة روى عنه مجاهد وقد قيل إياس بن حرملة(@)(@@)(@@)(@@) $ 2349 - حرملة مولى أسامة بن زيد يروي عن أسامة بن زيد روى عنه 
ms536	 أبو جعفر محمد بن علي(@)(@@)(@@)(@@) $ 2350 - حرملة مولى زيد بن ثابت يروي عن زيد بن ثابت وأبي بن كعب روى عنه أبو بكر بن محمد بن عمرو بن حزم PageV04P173(@)(@@)(@@)(@@) $ 2351 - حرملة بن عبد الرحمن يروي عن أبي هريرة وعبادة بن الصامت روى عنه مسلم أبو النضر(@)(@@)(@@)(@@) $ 2352 - حريث بن ظهير الكوفي يروي عن بن مسعود روى عنه عمارة بن عمير ثنا أبو خليفة قال ثنا محمد بن كثير قال ثنا سفيان عن الأعمش عن عمارة بن عمير عن حريث بن ظهير قال قال عبد الله بن سعود لا تسألوا أهل الكتاب عن شيء فإنهم لن يهدوكم وقد ضلوا(@)(@@)(@@)(@@) $ 2353 - حريث بن الربيع العدوى أخو حجير بن الربيع يروي عن عمر بن الخطاب روى عنه أبو نعامة وأهل البصرة(@)(@@)(@@)(@@) $ 2354 - حريث بن مخشى القيسي شهد الجمل يروي عن على عداده في أهل البصرة روى عنه عبد الله بن المبارك(@)(@@)(@@)(@@) $ 2355 - حريث بن عمرو يروي عن معاذ بن جبل روى عنه أبو بكر بن أبي مريم PageV04P174(@)(@@)(@@)(@@) $ 2356 - حريث بن عمارة من بني عذرة يروي عن أبي هريرة روى عنه بن ابنه أبو محمد بن عمرو بن حريث ثنا أبو يعلى قال ثنا أبو خيثمة قال ثنا سفيان عن إسماعيل بن أمية عن أبي محمد بن عمرو بن حريث عن جده سمع أبا هريرة يقول قال أبو القاسم صلى الله عليه وسلم إذا صلى أحدكم فليجعل تلقاء وجهه شيئا وإن لم يجد فليلق عصى فإن لم يجد عصى فليخط خطا ثم لا يضره ما مر بين يديه(@)(@@)(@@)(@@) $ 2357 - حريث بن سليمان العدوى يروي عن علي بن أبي طالب روى عنه بكير بن عطاء(@)(@@)(@@)(@@) $ 2358 - حريث بن مالك أبو ماوية الأسيدى يروى المراسيل وقد PageV04P175 قيل إن اسم أبي ماوية مالك بن حريث روى عنه الناس(@)(@@)(@@)(@@) $ 2359 - حريث بن عمار يروي عن أبي هريرة روى عنه إسماعيل بن أمية(@)(@@)(@@)(@@) $ 2360 - حريث بن أبى حريث يروي عن بن عمر روى عنه يونس بن ميسرة(@)(@@)(@@)(@@) $ 2361 - حجر 
ms537	 بن عدي الكندي يروي عن علي وعمار وقد قيل إن له صحبة شهد صفين مع علي عداده في أهل الكوفة وهو الذي يقال له حجر بن الأدبر والأدبر هو عدي بعثه زياد إلى بعض الناس مقيدا على بعير ورجلاه من جانب وقتل سنة ثلاث وخمسين في عهد عائشة وقد قيل سنة إحدى وخمسين بمرج عذراء ثنا الحسن بن سفيان قال ثنا أبو بكر بن شيبة قال ثنا أزهر عن بن عون عن بن سيرين قال لما انطلق بحجر إلى معاوية بن أبي سفيان قال السلام عليك يا أمير المؤمنين قال وأمير المؤمنين أنا قال نعم قال لأقتلنك قال ثم أمر به ليقتل فقال دعوني لأصلي ركعتين فصلى ركعتين وجوز فيهما ثم PageV04P176 قال لا ترون أني خففتهما جزعا ولكني كرهت أن أطول عليكم ثم قتل رحمه الله(@)(@@)(@@)(@@) $ 2362 - حجر بن حجر الكلاعي يروي عن العرباض بن سارية روى عنه خالد بن معدان(@)(@@)(@@)(@@) $ 2363 - حجر بن عنبس أبو السكن الكوفي وهو الذي يقال له حجر أبو العنبس يروي عن على ووائل بن حجر روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 2364 - حجر بن قيس المدرى من همدان يروي عن زيد بن ثابت روى عنه طاوس وهو الذي يقول شعبة بن المندلى أو بن القندلي ولم يحفظ شعبة اسمه(@)(@@)(@@)(@@) $ 2365 - حجر بن شراحيل يروي عن سلمان روى عنه مطرف بن طريف(@)(@@)(@@)(@@) $ 2366 - حيي بن يعلى بن أمية الثقفي يروي عن معاوية وأبيه روى عنه بن أبي مليكة PageV04P177(@)(@@)(@@)(@@) $ 2367 - حيي الخولاني ثم الجعلي يروي عن أبي ذر عداده في أهل مصر روى عنه ابنه سعيد بن حيي(@)(@@)(@@)(@@) $ 2368 - حيي بن هانئ أبو قبيل المعافري المصري يروي عن عبد الله بن عمرو وعقبة بن عامر روى عنه الليث بن سعد وأهل مصر ويحيى بن أيوب مات سنة ثمان وعشرين ومائة وكان يخطىء(@)(@@)(@@)(@@) $ 2369 - حاتم بن حريث الطائي الحمصي من المحررين يروي عن أبي أمامة وأبي هريرة ومعاوية روى عنه معاوية بن صالح والجراح بن مليح وأهل الشام 
ms538	 مات سنة ثلاث وثلاثين ومائة ثنا الصوفي قال ثنا الهيثم بن خارجة قال ثنا الجراح بن مليح قال ثنا حاتم بن حريث قال سمعت أبا أمامة يقول قال رسول الله صلى الله عليه وسلم من وجد لقحة مصراة فلا تحل له صرارها حتى يردها(@)(@@)(@@)(@@) $ 2370 - حاتم بن عدى الحمصي يروي عن أبي ذر وواثلة بن الأسقع روى عنه أهل الشام سليمان بن أبى عثمان التجيبي وغيره PageV04P178(@)(@@)(@@)(@@) $ 2371 - حمران بن أبان مولى عثمان بن عفان يروي عن عثمان روى عنه عروة بن الزبير وعطاء بن يزيد الليثي وكان من سبى عين التمر من الذين سباهم خالد بن الوليد قدم البصرة فكتب عنه البصريون(@)(@@)(@@)(@@) $ 2372 - حمران بن أعين أخو عبد الملك بن أعين يروي عن أبي الطفيل روى عنه الثوري وإسرائيل وحمزة الزيات(@)(@@)(@@)(@@) $ 2373 - حمران بن المنذر الوائلي وقد قيل الواثلي يروي عن أبي هريرة روى عنه أبو الأخضر العبدي(@)(@@)(@@)(@@) $ 2374 - حمران مولى بن عبلة يروى عن بن عمرو أبي الطفيل روى عنه المثنى بن الصباح(@)(@@)(@@)(@@) $ 2375 - حمران مولى معقل بن يسار البصري يروي عن معقل بن يسار روى عنه إسحاق PageV04P179 بن عثمان(@)(@@)(@@)(@@) $ 2376 - حر شيخ يروي عن بن مسعود روى قتادة عن أبي الرضراض عنه لست أعرفهما ولا أباهما(@)(@@)(@@)(@@) $ 2377 - حر شيخ يروي عن علي بن أبي طالب روى عنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 2378 - حر بن الصباح النخعي كوفي يروي عن بن عمر روى عنه شعبة وشريك(@)(@@)(@@)(@@) $ 2379 - حبان بن الحارث أبو عقيل يروي عن على روى عنه شبيب فقد قيل حيان بن الحارث والصحيح حبان(@)(@@)(@@)(@@) $ 2380 - حبان صاحب الدثينة يروي عن بن عمر روى عنه محمد بن سلم وعبد الله بن يزيد PageV04P180(@)(@@)(@@)(@@) $ 2381 - حبان بن زيد الشرعي الشامي كنيته أبو خداش يروي عن عبد الله بن عمرو روى عنه حريز بن عثمان ومن قال حيان فقد وهم(@)(@@)(@@)(@@) $ 2382 - حبان بن معاوية السلمي يروي عن أبي هريرة روى عنه الهزهاز بن ميزن(@)(@@)(@@)(@@) $ 2383 - حبان بن جزى السلمي ويقال بن جزء 
ms539	 يروى عن بن عمر وأبي هريرة روى عنه عبد الكريم بن أبي المخارق وهو الذي يروي عن أخيه خزيمة بن جزى(@)(@@)(@@)(@@) $ 2384 - حبان بن أبي جبلة القرشي يروي عن عبد الله بن عمرو روى عنه عبيد الله بن زحر ومن قال حيان بن أبي جبلة فقد وهم(@)(@@)(@@)(@@) $ 2385 - حوط بن عبد العزيز العبدي يروي عن بن مسعود وزيد بن أرقم روى عنه عبد الملك بن ميسرة والمسعودي(@)(@@)(@@)(@@) $ 2386 - حبة بن غسيل الأسدي وهو الذي يقال له حبة بن سلمة يروي عن بن مسعود روى عنه أبو رزين PageV04P181(@)(@@)(@@)(@@) $ 2387 - حية بن حابس يروي عن أبيه وله صحبة روى عنه يحيى بن كثير(@)(@@)(@@)(@@) $ 2388 - حبة بن جوين العربي أبو قدامة كوفي روى عن على وابن مسعود روى عنه سلمة بن كهيل حبة بن جوين ضعيف(@)(@@)(@@)(@@) $ 2389 - حارثة بن مضرب الكوفي يروي عن عمر وعلى روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2390 - أبو تحبا اسمه حكيم بن سعد الكوفي يروي عن على وأم سلمة روى عنه عمران بن ظبيان والأعمش ومنهم من قال حكيم والصحيح حكيم(@)(@@)(@@)(@@) $ 2391 - حكيم بن عبد الله بن قيس بن مخرمة من بنى عبد مناف يروي عن بن عمر روى عنه يزيد بن أبي حبيب والليث بن سعد(@)(@@)(@@)(@@) $ 2392 - حذيفة بن أبي حذيفة الأزدي يروي عن صفوان بن عسال روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2393 - حدير السلمي مولى بنى سليم كنيته أبو فوزة يروي عن عثمان PageV04P182 بن عفان روى عنه يونس بن ميسرة والعلاء بن الحارث(@)(@@)(@@)(@@) $ 2394 - حدير بن كريب أبو الزاهرية الشامي الحمصي يروي عن أبي أمامة وعبد الله بن بسر روى عنه معاوية بن صالح وأهل الشام مات في إمارة عبد الملك وقد قيل إنه مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 2395 - حدير بن الخطاب يروي عن الحسن بن علي روى عنه يحيى بن واضح(@)(@@)(@@)(@@) $ 2396 - حدير الأسلمي يروي عن أبي الدرداء روى عنه عبيد الله بن عبد الرحمن(@)(@@)(@@)(@@) $ 2397 - حنش بن علي يروي عن بن عباس روى عنه قيس 
ms540	 بن الحجاج عداده في أهل مصر PageV04P183(@)(@@)(@@)(@@) $ 2398 - حنش بن عبد الله السباى الصنعاني من صنعاء الشام يروي عن فضالة بن عبيد وابن عباس ورويفع بن ثابت وروى عنه ربيع بن سليم التجيبي وأهل الشام وكان من الأبناء مات سنة مائة(@)(@@)(@@)(@@) $ 2399 - حنش العبدي يروي عن أبي هريرة روى عنه سلمة بن جنادة(@)(@@)(@@)(@@) $ 2400 - حوشب بن سيف أبو روح السكسكي الشامي وهو الذي يقال له المعافري يروي عن معاوية بن صالح روى عنه صفوان بن عمرو وشداد بن أفلح(@)(@@)(@@)(@@) $ 2401 - حوشب بن أبي زياد يروي عن أبي أمامة روى عنه يونس بن يزيد الأيلي ثنا بن قتيبة قال ثنا محمد بن أيوب بن سويد قال ثنا أبي قال أنبأ يونس بن يزيد قال ثنا حوشب بن أبي زياد عن أبي أمامة الباهلي قال قال رسول الله صلى الله عليه وسلم من حج واعتمر وصلى ببيت المقدس ثم جاهد فقد استكمل جميع سنتي(@)(@@)(@@)(@@) $ 2402 - حرام بن سعد بن محيصة بن مسعود بن كعب بن عامر بن عدي بن مجدعة بن حارثة بن الحارث بن الخزرج الأنصاري الحارثي المدني PageV04P184 كنيته أبو سعيد وهو الذي يقال له حرام بن ساعدة يروي عن البراء بن عازب روى عنه الزهري وأمه هند بنت عمرو بن الجموح بن زيد بن حرام مات سنة ثلاث عشرة ومائة وهو بن سبعين سنة(@)(@@)(@@)(@@) $ 2403 - حرام بن سعد يروى قصة ناقة البراء ولم يسمع من البراء وقيل إنه يروي عن أبيه عن البراء(@)(@@)(@@)(@@) $ 2404 - حرام بن حكيم الدمشقي يروي عن أبي هريرة روى عنه زيد بن واقد والعلاء بن الحارث(@)(@@)(@@)(@@) $ 2405 - حزام بن دراج لقى عمر بن الخطاب وعلى بن أبي طالب في طريق مكة روى عنه الزهري(@)(@@)(@@)(@@) $ 2406 - حرام بن معاوية يروي المراسيل روى عنه زيد بن رفيع PageV04P185(@)(@@)(@@)(@@) $ 2407 - حرام بن عبد عمرو الخثعمي الحضرمي يروي عن عبد الله بن عمرو روى عنه أبو سهيل بن مالك(@)(@@)(@@)(@@) $ 2408 - الحجية بن عدي الكندي يروي عن علي وعبد الله روى عنه أهل 