ms41	 يكاد الليل يشرق كالضحى % % لو أن فكرته تمر بفكره % 50(@)(@@) % آي الفصاحة إن يخط يراعه % لم تبد أنجمها بظلمة حبره % PageV01P119 51(@)(@@) % ترك المواكب كالكواكب فاهتدى % % فيهن من يسري لمشرق يسره % 52(@)(@@) % غيث يكاد التبر ينبت بالربى % % كالنور لو وسمت بلؤلوء قطره % 53(@)(@@) % لو أن للأعناق منها ألسنا % نطقت بأفواه الجيوب بشكره % 54(@)(@@) % لم يغش وجه الأفق حتى ينطوي % % كلف الدجى لو حاز رونق بشره % 55(@)(@@) % سام يمد إلى العلا باعا طوت % مجرى الدراري السبع خطوة بشره % 56(@)(@@) % من آل حيدرة الألى ازدان العلا % % فيهم كما ازدان الربيع بزهره % 57(@)(@@) % غر إذا منهم تولد كوكب % حسدت شموس الأفق مفخر ظئره % 58(@)(@@) % نفر لو أنهم جلوا أحسابهم % في الليل لاشتبهت بأضوإ زهره % 59(@)(@@) % من كل أبلج في ذيول قماطه % علق العلا ونشا السماح بحجره % 60(@)(@@) % لم يبطك وهو على حشية مهده % إلا لحب ركوب صهوة مهره % PageV01P120 61(@)(@@) % لله درك يا علي ففصلهم % بك فصلت ’ آيات محكم ذكره % 62(@)(@@) % ألله حسبك كيف سرت إلى العلا % ما بين أنياب الحمام وظفره % 63(@)(@@) % لولاك قدس المجد أصبح طوره % دكا يموج وخر موسى قدره % 64(@)(@@) % قامت بنجدته سيوفك فاغتدت % بالنصر تبسم كالثغور بثغره % 65(@)(@@) % جردتها فرجمت شيطان العدا % % بنجومها ودحرت مارد شره % 66(@)(@@) % قضب إذا رأت الأسود فرندها % % شهدت مناياها بأيدي ذره % 67(@)(@@) % مولاي سمعا من رقيقك مدحة % هي بنت فكرته ودمية قصره % 68(@)(@@) % بكر يحجبها الجمال وإن بدت % ويصونها بدر الدلال بستره % 69(@)(@@) % لو كان تخطبها النجوم لبدرها % % حاشاك لم تعط القبول لمهره % 70(@)(@@) % فاستجلها عذراء هذب لفظها % % طبع أرق من النسيم بمره % PageV01P121 71(@)(@@) % وليهنك الشهر المبارك صومه % وجزاك ربك عنه أفضل أجره % 72(@)(@@) % شهر لو أن من الورى أوقاته % عدت لرحت وأنت ليلة قدره % 73(@)(@@) % واسعد بعيد أنت لنا مثله % وافطر قلوب المعتدين بفطره % PageV01P122 البحر : كامل تام 1(@)(@@) % ضربوا القباب وطنبوها بالقنا % % فمحوا بأنجمها مصابيح المنا % % 2(@)(@@) % وبنوا الحجال على الشموس فوكلوا % % شهب السهاء برجم زوار البنا % % 3(@)(@@) % وجلوا بتيجان الترائب أوجها % لو قابلت 
ms42	 جيش الدجنة لانثنا % % 4(@)(@@) % وجروا إلى الغايات فوق سوابق % لو خاض عثيرها النهار لأوهنا % % 5(@)(@@) % لله قوم في حبائل حسنهم % قنصوا الكرى لجفونهم من عندنا % % 6(@)(@@) % غر رباربهم وأسد عرينهم % سلوا المنون وأغمدوها الأجفنا % % 7(@)(@@) % إن زارهم خصم عليه نضوا الظبا % % أو مدنف سلوا عليه الأعينا % % 8(@)(@@) % لم تلقهم إلا وفاجاك الردى % % من جفن غصن هز أو ريم رنا % % 9(@)(@@) % تثنى الظبا تحت السوابغ منهم % سمر الرماح وفي الغلائل أغصنا % 10(@)(@@) % من كل محتجب تبرج في العلا % أو كل سافرة يحجبها السنا % % PageV01P123 11(@)(@@) % نهدى بلمع نصولهم لوصولهم % % ونرى ضياء وجوههم فتصدنا % % 12(@)(@@) % قسما بقضب قدورهم لخدودهم % كالورد إلا أنها لا تجتنى % % 13(@)(@@) % كم مات خارج حيهم من مدنف % والروح منه لها وجود في الفنا % % 14(@)(@@) % أسكنتهم بأضالعي فبيوتهم % بطويلع وشموسهم بالمنحنا % % 15(@)(@@) % يا صاح إن جئت الحجاز فمل بنا % % نحو الصفا فهواي أجمعه هنا % % 16(@)(@@) % فتش عبير ثراه إن شئت الثرى % % فالدر حيث به نثرنا عتبنا % % 17(@)(@@) % وانشد به قلبي فإن مقامه % حيث المقام به الحجون إلى منى % % 18(@)(@@) % وسل المضاجع إن ششكت فإنها % % منا لتعلم عفة وتدينا % % 19(@)(@@) % يا أهل مكة ليت من فلق النوى % % قسم المحبة بالسوية بيننا % % 20(@)(@@) % اطلقتم الأجسام منا للشقا % % ولديكم الأرواح في أسر العنا % % PageV01P124 21(@)(@@) % أجفانكم غصبت سواد قلوبنا % % وخصوركم عنه تعوضنا الضنى % % 22(@)(@@) % عن ري غلتنا منعتم زمزما % ورميتم جمرات وجدكم بنا % % 23(@)(@@) % ظبيانكم أظمأننا وأسودكم % بجداول الفولاذ تمنع وردنا % % 24(@)(@@) % ما بال فجر وصالكم لا ينجلي % % وقرونكم سلبت ليالي بعدنا % % 25(@)(@@) % أبزعمكم أنا يغيرنا النوى % % فوحقكم ما زال عنكم عهدنا % % 26(@)(@@) % أنخونكم بالعهد وهو أمانة % قبضت خواطرنا عليه أرهنا % % 27(@)(@@) % أخفي مودتكم فيظهر سرها % % والراح لا تخفى إذا لطف الإنا % % 28(@)(@@) % بكم اتحدت هوى ولو حييتكم % قلت السلام علي إذ أنتم أنا % % 29(@)(@@) % لله أيام على الخفيف انقضت % يا حبذا لو أنها رجعت لنا % % 30(@)(@@) % أيام لهو طالما بوجوهها % % وضحت لنا غرر المحبة والهنا % % PageV01P125 31(@)(@@) % وسقى الحيا غدوات لذات غدت % فيها غصون 
ms43	 الأمس طيبة الجنا % % 32(@)(@@) % وظلال آصال كأن نسيمها % % لأبي الحسين يهب في أرج الثنا % % 33(@)(@@) % ملك جلالته كفته وشأنه % عن زينة الألقاب أو حلي الكنى % % 34(@)(@@) % سمح إذا أثنى النبات على الحيا % % قصد المجاز بلفظه وله عنى % % 35(@)(@@) % قرن لديه قرى الجيوش إذا به % نزلوا فرادى الظعن أو حزب ثنا % % 36(@)(@@) % للفخر جرحاه تلذ بضربه % والبرء يرضي الجرب في ألم الهنا % % 37(@)(@@) % تمسي بأفواه الجراح حرابه % تثني عليه تظنهن الألسنا % % 38(@)(@@) % سجدت لعزمته النصال أما ترى % % فيهن من أثر السجود الإنحنا % % 39(@)(@@) % وهوت عواليه الطعان فأوشكت % قبل الصدور زجاجها أن تطعنا % % 40(@)(@@) % بيت القصيد من الملوك وإنما % % يأبى علاه بوزنهم أن يوزنا % % PageV01P126 41(@)(@@) % يصبو إلى نخب الوفود بسمعه % طربا كما يصبو التريف إلى الغنا % % 42(@)(@@) % متسرع نحو الصريخ إذا دعا % % مترفق فيه عن الجاني ونا % % 43(@)(@@) % فالورق تشفق منه يغرقها الندى % % فلذاك تلجأ في الغصون لتأمنا % % 44(@)(@@) % والنار من فزع الخمود بصوبه % فزعت إلى جوف الصخور لتكمنا % % 45(@)(@@) % والمزن من حسد لجود يمينه % تبكي أسى وتظنها لن تهتنا % % 46(@)(@@) % بطل تكاد الصاعقات بأرضه % حذرا الصوت الرعد أن لا تعلنا % % 47(@)(@@) % لو أكرم البحر السحاب كوفده % للدر عنا كاد أن لا يحزنا % % 48(@)(@@) % أو يقتفيه البدر في سعي العلا % لم يرض في شرف الثريا مسكنا % % 49(@)(@@) % أو بعن أنفسها الأهلة صفة % منه بنعل حذائه لن تغبنا % % 50(@)(@@) % حرست علاه بالظبا ففروجها % % تحكي البروج تحصنا وتزينا % PageV01P127 51(@)(@@) % لا ينكرن الأفق غبطته لها % أو ليس قد لبس السواد تحزنا % % 52(@)(@@) % تقف المنية في الزحام لديه لا % تسعى إلى المهجات حتى يأذنا % % 53(@)(@@) % نفذت إرادته وألقمت نحوه ال % % دنيا مقاليد العلا فتمكنا % % 54(@)(@@) % فإذا اقتضى إحداث أمر رأيه % لو كان ممتنع الوجود لأمكنا % % 55(@)(@@) % يا من بطلعته يلوح لنا الهدى % % وبيمن رؤيته نزيد تيمنا % % 56(@)(@@) % مالروح منذ رحلتإلا مهجة % بك تيمت فخفوقها لن يسكنا % % 57(@)(@@) % أضناه طول نواك حتى أنه % دل النحول على هواه وبرهنا % % 58(@)(@@) % أخفى الهدى لما ارتحلت مناره % فحللت فيه فلاح 
ms44	 نورا بينا % 59(@)(@@) % قد كنت فيه وكان صبحا مشرقا % حتى ارتحلت فعاد ليلا أدكنا % % 60(@)(@@) % سلب البلاد مذ غبت ملبس أرضه % فكسته أوبتك الحرير ملونا % % PageV01P128 61(@)(@@) % فارقته فأباح بعدك للعدى % % منه الفروج وجئته فتحصنا % 62(@)(@@) % أمسى لبعدك للصبابة محزنا % والآن أصبح للمسرة معدنا % % 63(@)(@@) % لا أوحش الرحمن منك ربوعه % أبدا ولا برحت لمجدك موطنا % 64(@)(@@) % مولاي لا برح العدى لك خضعا % رهبا ودان لك الزمان فأذعنا % % 65(@)(@@) % هب أنهم سألوك فأحسن فيهم % % لرضا الإله فإنه بك أحسنا % % 66(@)(@@) % لا تعجبن إذا امتحنت بكبدهم % فالحر ممتحن بأولاد الزنا % % 67(@)(@@) % فاغضض بحلمك ناظر متيقظا % % وأجمع لرأيك خاطرا متفطنا % % 68(@)(@@) % واغفر خطيئة من إذا عذرا بغى % % وهو الفصيح غدا جبانا ألكنا % % 69(@)(@@) % إني لأعلم إن عنك تخلفي % ذنب ولكني أقول مضمنا % % 70(@)(@@) % اضحى فراقك لي عليه عقوبة % ليس الذي قاسيت منه هينا % % PageV01P129 71(@)(@@) % لا زال فيك المجد مبتهجا ولا % % فجعت بفرقتك العلا نوب الدنا % % PageV01P130 البحر : بسيط تام 1(@)(@@) % عرج على البان وانشد في مجانيه % قلبا فقد ضاع مني في مغانيه % 2(@)(@@) % وسل ظلال الغضا عنه فثم له % مثوى بها فهجير الهجر يلجيه % 3(@)(@@) % أولا فسل منزل النجوى بكاظمة % عن مهجتي وضماني إنها فيه % 4(@)(@@) % واقر السلام عريب الجزع جمهم % واخضع لهم وتلطف في تأديه % 5(@)(@@) % وحي أقمار ذاك الحي عن دنف % يميته الليل فكرا وهو يحييه % 6(@)(@@) % وانح الحمى يا حماك الله ملتمسا % فك القلوب الأسارى عند أهليه % 7(@)(@@) % لله حي إذا أقماره غربت % أغنتك عنها وجوه من غوانيه % 8(@)(@@) % مغنى إذا ارتاد طرفي في ملاعبه % حسبهن عقودا في تراقيه % 9(@)(@@) % جمال كل أسيل الخد يجمعه % وقلب كل أسير الوجه يحويه % 10(@)(@@) % تمشي كنوز الثنايا من عقائله % مرصودة بالأفاعي من عواليه % PageV01P131 11(@)(@@) % لولا النوى وجلي البين لالتبست % عواطل السرب حسنا في حواليه % 12(@)(@@) % إذا بمجرى الظبا تجري ضراغمه % أثارت الخيل نقعا من عواليه % 13(@)(@@) % قد يكتفي المجرمون الناكسون إذا % % هب النسيم عليهم من نواحيه % 14(@)(@@) % مذ حرمت قضبه مس الصعيد على % % باغي الطهور 
ms45	 ودمعي ماء واديه % 15(@)(@@) % سقى الحيا عز أقوام صوارمهم % عن منة الغيث عام الجدب تغنيه % 16(@)(@@) % يا نارحين وأوهامي تقربهم % حوشيتم من لظى قلبي وحوشيه % 17(@)(@@) % عسى نسيم الصبا في نشر تربتكم % يعود مرضاكم يوما فيشفيه % 18(@)(@@) % من لي به من ثراكم أن يحدثني % % بام عليه ذيول العين ترويه % 19(@)(@@) % وحقكم إن رضيتم في ضنى جسدي % % بحبكم لوجودي في تفانيه % 20(@)(@@) % أفري الجيوب إذا غبتم فكيف إذا % % بنتم فمن أين لي قلب فأفريه % PageV01P132 21(@)(@@) % بالنفس درا بسمعي كنت ألفظه % منكم ووردا بعيني كنت أجنيه % 22(@)(@@) % الله يا ساكني سلع بنفس شج % على الطلول أسالتها مآقيه % 23(@)(@@) % عان خصور الغواني البيض تنحله % وبيض مرضى الجفون السود تبريه % 24(@)(@@) % يرعى السها بعيون كلما التفتت % نحو العقيق غدت في الخد تجريه % 25(@)(@@) % يهزه البان شوقا حين تفهمه % معنى الإشارة عنكم في تثنيه % 26(@)(@@) % تبدو بدور غوانيكم فتوهمه % بأنهن ثناياكم فتصبيه % 27(@)(@@) % هوى فأضحى بميدان الهوى هدفا % فعينكم بسهام الغنج ترميه % 28(@)(@@) % يوري النوى أي نار في جوانحه % أما ترون سناها في نواصيه % 29(@)(@@) % رعيا لمنزل أنس بالعقيق لنا % % لا زال صوب الحلا بالدر يوليه % 30(@)(@@) % وحبذا عصر لذات عرجت به % نحو البدور البيض من لياليه % PageV01P133 31(@)(@@) % أكرم بها من لويلات لو انتسقت % لكن في السلك أبهى من لآليه % 32(@)(@@) % غر كأن علي المجد خولها % % فزينت ببدور من أياديه % 33(@)(@@) % شمس بها زان وجه الدهر وانكشفت % عن أهله ظلمات من مساويه % 34(@)(@@) % حليف حزم له في كل مظلمة % نور من الرأي نحو الفتح يهديه % 35(@)(@@) % سيفا لو الحلم لم يغمده كادبه % أن تهلك الناس حين العزم ينضيه % 36(@)(@@) % غيث هم وسما في المجد فاشتركت % في جوده الخلق واختصت معاليه % 37(@)(@@) % يمن العلا والأماني البيض في يده % يمني وحمر المنايا في أمانيه % 38(@)(@@) % فلو أراع غراب البين صارمه % لشاب فؤاده وابيضت خوافيه % 39(@)(@@) % ولو أتته النجوم الشهب يوم ندى % لم يرض بالشمس دينارا فيعطيه % 40(@)(@@) % وهو السميع إذا التقوى تناديه % ولو بها اشتعلت يوما مذاكيه 
ms46	 % PageV01P134 41(@)(@@) % وافرحة الليث فيه لو يسالمه % وغبطة الغيث فيه إن يؤاخيه % 42(@)(@@) % مقداره عن ذوي الأقدار يرفعه % وجوده لذوي الحاجات يدنيه % 43(@)(@@) % هوالأصم إذا تدعوه فاحشة % وهو السميع إذا التقوى يناديه % 44(@)(@@) % إن يحمل الحمد وردا فهو قاطفه % أو يجتني منه شهد فهو جانيه % 45(@)(@@) % هام الزمانث به حبا فأووشك أن % يعود شوقا إلى رؤياه ماضيه % 46(@)(@@) % إذا الحظوظ محاها البأس أثبتها % % رجاؤه بحظوظ ملء أيديه % 47(@)(@@) % دوح الفخار الذي مزن الإمامة لا % تنفك في رشحات البر تسقيه % 48(@)(@@) % % نور النبوة منه حين يغريه % 49(@)(@@) % من حوله نسب يغشى بصائرنا % % 50(@)(@@) % من الملوك الألى لولا حلومهم % تزلزل المجد واندكت رواسيه % PageV01P135 51(@)(@@) % من كل أبلج مأمون مناقبه % بجنة الحمد يلق طعن شانيه % 52(@)(@@) % نشا ونفس الندى منه شنت فغدا % % كل لصاحبه الأدنى يربيه % 53(@)(@@) % ألحيدري الذي دان الزمان له % حتى استكان وخافت دواهيه % 54(@)(@@) % قرن إذا ما غدير الدر أغرقه % خاض الردى فيكادث البأس يوريه % 55(@)(@@) % بدر الحسام إذا في الروع أضحكه % فإنه بالدم الجاري سيبكيه % 56(@)(@@) % والهامث تدري وإن عزت سيلزمها % % دل السجود إذا صلت مواضيه % 57(@)(@@) % ساس الأمور فأجرى في أوامره % حكم المنى والمنايا في مناهيه % 58(@)(@@) % تعشق المجد طفلا واستهام به % فهان فيه عليه ما يقاسيه % 59(@)(@@) % سل الحيا حين يهمي عن أنامله % أهن أندى بنانا أم غواديه % 60(@)(@@) % له خصال بخيط الفجر لو نظمت % لم ينتظم سبح الداجي بثانيه % PageV01P136 61(@)(@@) % شمائل لو حواها الليل وافتقدت % بوده لفداها في دراريه % 62(@)(@@) % قلادة المجد والعليا صنائعه % وزينة الدين والدنيا مساعيه % 63(@)(@@) % مولى كأنك تتلو في مجالسنا % % آي السجود علينا إذ تسميه % 64(@)(@@) % يا ساعد الجود بل يا نفس حاتمه % يا نقش خاتمه يا طوق هاديه % 65(@)(@@) % لا زلت يا غوث لي غوثا ومنتجعا % ولا برحت إليك المدح أهديه % 66(@)(@@) % لولا تملككم رقي بأنعمكم % ما راق شعري ولا رقت مبانيه % 67(@)(@@) % واستجل من آي نظمي أي معجزة % تخلد الذكر في الدنيا وتبقيه % 68(@)(@@) % مدح تسير إذا ما فيك فهت به 
ms47	 % سير الكواكب في الدنيا قوافيه % 69(@)(@@) % بيوت شعر بناها الفكر من ذهب % سكانها حور عين من معانيه % 70(@)(@@) % واغنم بصوم عسى بالخير يختمه % لك الإله وبالرضوان يجزيه % PageV01P137 71(@)(@@) % هلال سعد تراءى فيه منك علا % فعاد صبا يكاد الشوق يخفيه % 72(@)(@@) % وليهنك العيد في تجديد عودته % بل فيك يا بهجة الدنيا نهنيه % PageV01P138 البحر : كامل تام 1(@)(@@) % حتام أسألها الذنو فتنزح % وأروض قلبي بالسلو فيجمح % 2(@)(@@) % وإلام لا أنفك أصرع للهوى % % وتتيه في عز الجمال وتمرح % 3(@)(@@) % وعلام تمطلني فيحسن مطلها % % وتسومني الصبر الجميل فيقبح % 4(@)(@@) % تجفو وما حنيت عليه أضالعي % يحنو عليها والجوانح تجنح % 5(@)(@@) % قلبي يضن بها علي ومنطقي % % عنها يكني والجفون تصرح % 6(@)(@@) % يا لائمي فيها وعذري الهوى % % من وجهها الوضاح عذري أوضح % 7(@)(@@) % خنت التقى وقطعت أرحام العلا % % إن لم أعق في حبها من ينصح % 8(@)(@@) % لا تعذلوا الدنف المشوق فقلبه % كالزند يقرعه الملام فيقدح % 9(@)(@@) % ما بال تضعف عن ملامك طاقتي % % وأنا الحمول لكل خطب يفدح % 10(@)(@@) % لا يسنح الأجل المتاح بفكرتي % % إلا إذا إجل الجآذر يسنح % PageV01P139 11(@)(@@) % يا ساكني الجرعاء لا أقوى الغضا % % منكم ولا فقدت مهاكم توضح % 12(@)(@@) % هل في الزارة للنسيم أذنتم % فلقد أشم المسك منه ينفح % 13(@)(@@) % لم تحسن الأقمار بعد وجوهكم % عندي ولا نظري إليها يطمح % 14(@)(@@) % لا تنكروا قتل الرقاد ببينكم % أو ليس ذا دمه بخدي يسفح % 15(@)(@@) % عذرا فكم قلبي بليلى حيكم % قد مات عذري وجن ملوح % 16(@)(@@) % لله كم في سربكم من مقلة % تمضي وبيض صفاحها لا تجرح % 17(@)(@@) % ولكم بزندكم سوار أخرس % أوحى الكلام إلى وشاح يفصح % 18(@)(@@) % أبصارنا مخطوفة وعقولنا % % بثغوركم وبروقها لا تلمح % 19(@)(@@) % يردى بحيكم الهزبر مسربلا % ويمر فيه الظبي وهو موشح % 20(@)(@@) % لم يخش لولا مهلكات صدودكم % بيضا تسل وعاديات تضبح % PageV01P140 21(@)(@@) % رفقا بمنتزح إليكم روحه % تغدو بها ريح الضبا وتروح % 22(@)(@@) % يصبو إلى برق الحجون فتلتظي % ويصوب الدمع الهتون فتسبح % 23(@)(@@) % رعيا لأيام الحمى ورعى الحمى % % وسقت معاهده العهاد الروح % 24(@)(@@) % وعدا البلاد 
ms48	 الروح من مغنى فلا ال % أرواح فيها والقلوب تروح % 25(@)(@@) % كل الموارد بعد زمزم حلوها % % بفمي يمج وكل عذب يملح % 26(@)(@@) % يا جيرة غلط الزمان بوصلهم % فمحوه إذ وطنوا إليه وصححوا % % 27(@)(@@) % لا تطلبوا عندي الفؤاد فداره % إما ربوع منى وإما الأبطح % 28(@)(@@) % يا ليتنا بمنى حوانا موسم % ولكم به نهدي القلوب ونذبح % 29(@)(@@) % خلفتم الوجد المبرح بعدكم % عندي فروحي عندكم لا تبرح % 30(@)(@@) % مالي وما للدهر ليس بمنجز % وعدي ولا أملي لديكم ينجح % PageV01P141 31(@)(@@) % أشكو الزمان إلى بنيه وإنما % % فسد الزمان وليس فيهم مصلح % 32(@)(@@) % ساءت خلائقهم فساء فلا أرى % % شيئا به إلا عليا يمدح % 33(@)(@@) % الماجد العذب الذي في نفسه % وبماله يشري الثناء ويسمح % 34(@)(@@) % حر يريك البشر منه لدى الندى % % شيما كأزهار الرياض تفتح % 35(@)(@@) % شيم تصرح آية التطهير عن % أنسابها وبفضلهن تلوح % 36(@)(@@) % قرن إذا أجرى جداول قطبه % أذكت على الهامات نارا تلفح % 37(@)(@@) % طلق المحيا والجياد سواهم % والبيض تبسم في الوجوه فتكلح % 38(@)(@@) % فطن له علم يفيض ومنسب % من ضرعه در النبوة يرشح % 39(@)(@@) % فرع ذكا من دوحة الشرف التي % % من فوقها ورق الإمامة تصدح % 40(@)(@@) % علم على جعل البرية واحدا % للاحدين هو الدليل الأرجح % PageV01P142 41(@)(@@) % هو فوق علمكم به فتأملوا % % فيه فللأنظار فيه مطرح % 42(@)(@@) % هذا مخلص نسخة السادات من % آل النبي ففضله لا يشرح % 43(@)(@@) % صغر المديح وجل عنه فكل من % يثنى عليه كأنما هو يقدح % 44(@)(@@) % إن شئت إدراك الفلاح فواله % ولكل من والى عليا يفلح % 45(@)(@@) % تهوي الجبال الراسيات وحلمه % في الصدر لايهوي ولا يتزحزح % 46(@)(@@) % لا مبدئا جزعا لأعظم فائت % منه ولا بحصول ذلك يفرح % 47(@)(@@) % كم بين شدة خوفه ورجائه % عين تسيل دما وصدر يرشح % 48(@)(@@) % أسد لديه دم الأسود من الطلا % أحلى من ريق الغواني أملح % 49(@)(@@) % تهوي مذاكيه الصباح كأنه % لبن بخالصه تعل وتصبح % 50(@)(@@) % سبق الأنام وما تجوز عمره % حولا ولم تبلغ نداه القرح % PageV01P143 51(@)(@@) % % حتى حميم الفجر منها ينضح % 52(@)(@@) % يستصحب النصر العزيز بسيفه % وبرأيه 
ms49	 فدجى الوغى يستصبح % 53(@)(@@) % لو تنكح الريح العقيم برفقه % يوما لبالبركات كادت تلقح % 54(@)(@@) % وافى وقد نضب النوال وأصبحت % غدر المطالب وهي ملأى تطفح % 55(@)(@@) % وسقى العلا عزا فأصبح روضه % خصبا ولولاه لكاد يصوح % 56(@)(@@) % يخفي الندى فينم عرف ثنائه % فيه وريح المسك مما يفصح % 57(@)(@@) % أندى الملوك يدا وأشرفهم أبا % وأبرهم للمذنبين وأصفح % 58(@)(@@) % قل للذي حسدا يعيب صفاته % أعلمت أي ضياء بدر يقبح % 59(@)(@@) % أنظر جميع خصاله وفعاله % فجميعها عبر لمن يتصفح % 60(@)(@@) % عجبا لقوم يكفرون بها ولو % عقلوا وما غفلوا الصواب لسبحوا % % PageV01P144 61(@)(@@) % يا ابن الأولى لولا جبال حلومهم % لم يرس ظهر الأرض وهو مسطح % 62(@)(@@) % والكاسب المدح التي لا تنتهي % % والواهب المنح التي لا تمنح % 63(@)(@@) % والثابت الرأي المسدد حيث لا % % أسد يقر ولا جواد يكبج % 64(@)(@@) % فز بالعلا وانعم فإنك أهلها % % ولها سواك من الورى لا يصلح % 65(@)(@@) % واستجل من نظمي بائع فكرة % بسواك بكر ثنائها لا تنكح % 66(@)(@@) % واسعد بعيد مثل وجهك بهجة % % 67(@)(@@) % عيد تكمل بالسعود هلاله % فبدا وأنت أتم منه وألوح % 68(@)(@@) % لا زال شهر الصوم يختم بالهنا % % لك والثواب وفيهما يستفتح % PageV01P145 البحر : وافر تام 1(@)(@@) % هلم بنا إلى أرض الحجون % عسى نقضي الغداة بها ديوني % % 2(@)(@@) % وسائل جيرة المسعى لماذا % % وفيتهم وقد قبضوا رهوني % % 3(@)(@@) % وعرج في المقام بربع ليلى % % لتنثر فوقه درر الشؤون % 4(@)(@@) % وفتش ثم عن كبدي فعهدي % % هنالك قد أراقتها عيوني % % 5(@)(@@) % وحي على الصفا حيا قليلا % له وضع الجبين على الوجين % 6(@)(@@) % وملعب حور جنات سقتنا % % به الولدان كأسا من معين % 7(@)(@@) % محلا فيه أسرار الأماني % % محجبة بأحشاء المنون % 8(@)(@@) % تسوم بها القلوب فتشتريها % % ثنايا البيض بالدر الثمين % 9(@)(@@) % به تبدي الشموس دجى وتحمي % % بدور قيانه شبه القيون % 10(@)(@@) % يزر به الحديد على العوالي % % وينسدل الحرير على الغصون % PageV01P146 11(@)(@@) % بسمعي من غوانيه كنوز % فقف فيها لتنظرها جفوني % % 12(@)(@@) % ولي في الخيف أحباب كرام % لدي وإن هم لم يكرموني % % 13(@)(@@) % خضعت لحبهم ذلا فعزوا % % ودنت لحكمهم فاستعبدوني % % 14 
ms50	(@)(@@) % هم اجتمعوا على قتلي بجمع % ففيم على المنازل فرقوني % % 15(@)(@@) % عيوني في هواهم أدخلتني % % وفي العبرات منها أخرجوني % % 16(@)(@@) % تقاسمت الهوى معهم ولكن % تسلوا عن هواي وهيموني % % 17(@)(@@) % وإذ كنت القسيم بغير عدل % نجوا منه وحازوا الصبر دوني % % 18(@)(@@) % تمر ظباهم متبرقعات % محافظة على الحسن المصون % 19(@)(@@) % فليت ملاحهم عدلت فأعطت % حمائم حليها خرس البرين % 20(@)(@@) % تغانوا بالقدود على العوالي % % وبالأجفان عن ما بالجفون % PageV01P147 21(@)(@@) % فبين لحاظهم كم من طريح % وبين قدودهم كم من طعين % 22(@)(@@) % أنا الخل الوفي وإن تجافوا % % وسايلهم وإن لم يرفدوني % % 23(@)(@@) % أود رضاهم لو كان حتفي % % وأوثر قربهم لو قربوني % % 24(@)(@@) % ألا يا أهل مكة إن قلبي % % بكم علقته أشراك الفنون % 25(@)(@@) % جميعي صفقة مني أشتريتم % فديتكم ولو بغضتموني % % 26(@)(@@) % نقلتم نحو مكتكم فؤادي % % وبين الكرختين تركتموني % % 27(@)(@@) % غرامي في هواكم عامري % فهل ليلاكم علمت جنوني % % 28(@)(@@) % أمنتكم عللى قلبي فخنتم % وأنتم سادة البلد الأمين % 29(@)(@@) % لئن أنستكم الأيام عهدي % % فذكركم نجيي كل حين % 30(@)(@@) % وإن وهنت قواي فإن دمعي % % على كلفي بكم أبدا معيني % % PageV01P148 31(@)(@@) % وإن صفرت يدي منكم فجدوى % % علي المجد قد ملأت يميني % % 32(@)(@@) % حليف ندى مكارمه وفت لي % % بما ضمنت من الدنيا ظنوني % % 33(@)(@@) % جسيم الفضل منتحل المواضي % % رفيع القدر ذي الشرف المكين % 34(@)(@@) % كريم النفس في سنن السجايا % % موقى العرض عن طعن المشين % 35(@)(@@) % على الكبراء بيدي كبر كسرى % % وللفقراء ذل المستكين % 36(@)(@@) % إذا عدت فنون الفخر يوما % فمفخره مقدمة الفنون % 37(@)(@@) % نسيب جاء من ماء طهور % وكل الخلق من ماء مهين % 38(@)(@@) % وهل يحكي عناصره نسيب % وما اختلطت عواليها بطين % 39(@)(@@) % يفوح شذا العبا منه ويحكي % % جوانبها مزاحمة الأمين % 40(@)(@@) % بفلق البدر موسوم المحيا % % لرد الشمس منسوب الجبين % PageV01P149 41(@)(@@) % همام لو أراع فؤاد رضوى % % لزلزل ركنها بعد السكون % 42(@)(@@) % ولو أعدى الصخور عليه سالت % جوامدها بجارية العيون % 43(@)(@@) % حباء الليث إذ يغشى الأعادي % % له وتبسم السيف السنين % 44(@)(@@) % يشم ذوابل المران حبا % ويعرض عن غضيض الياسمين % 45(@)(@@) % ويرغب في 
ms51	 قتل الأسد حتى % % كأن سيوفها لفتات عين % 46(@)(@@) % ترى في السلم منه حيا الغواني % وفي هيجانه أسدض العرين % 47(@)(@@) % إذا سلت صوارمه أطالت % سجود الذل هامات القرون % 48(@)(@@) % تظن غمودهن إذا انتضاها % % غصبن الصاعقات من الدجون % 49(@)(@@) % يبيح ذكورها العزمات منه % فروج المحصنات من الحصون % 50(@)(@@) % كتبن على حواشيها المنايا % % حواشيها على شرح المتون % PageV01P150 51(@)(@@) % تساوى الخلق في جدواه حتى % % فراخ القبح وهي على الوكون % 52(@)(@@) % وسلمت الورى دعوى المعالي % % له حتى الأجنة في البطون % 53(@)(@@) % يضر ثناه بالجرعى ويحيي % % مسيح نداه موتى المعتفين % 54(@)(@@) % برؤية وجهه نيل الأماني % % وفي راحاته روخح الحزين % 55(@)(@@) % كثير الصمت إن أبدى مقالا % ففي الأحكام والفضل المبين % 56(@)(@@) % وإن خفقت له يوما بنود % فأجنحة لدنيا أو لدين % 57(@)(@@) % أراض جونح الحدثان حتى % % به ثبتت صغة الصفون % 58(@)(@@) % يرى أمواله في عين زهد % فيعتقد اللجين من اللجين % 59(@)(@@) % ويلقى الدارعين بآي موسى % % فيفلق عنهم لجج الضعون % 60(@)(@@) % تشرفت العلا بأبي حسين % فبورك بالمكان وبالمكين % PageV01P151 61(@)(@@) % فياابن الطاهرين ومن ازينت % بفضل حديثهم سير القرون % 62(@)(@@) % ويا ابن المحسنين إذا الليالي % % أساءت كل ذي خطر بهون % 63(@)(@@) % لقد حسنت بك الدنيا وجادت % بنيل النحج في الزمن الضنين % 64(@)(@@) % وفك الجود أغلال العطايا % % وأمسى البخل في قيد الرهين % 65(@)(@@) % فسمعا من ثناي عليك لفظا % يهز مناكب الصعب الحزون % 66(@)(@@) % أنا ابن جلا القريض متى شككتم % % 67(@)(@@) % خذ الألواح من زبر القوافي % % فنسختهن ترجمة اليقين % 68(@)(@@) % بك الرحمن علمني المعاني % وأوحاها إلى قلمي ونوني % % 69(@)(@@) % فكم قوم لديك ترى محلي % فتغبطني وقوم يحسدوني % % 70(@)(@@) % ليهنك سيدي عيد شريف % حكاك فجل عن شبه القرين % PageV01P152 71(@)(@@) % فضح نفوس أهل الغدر فيه % وقرب مهجة الدهر الخؤون % 72(@)(@@) % ولا برحت عليك مخيمات % سرادق رفعة الشرف المكين % PageV01P153 البحر : خفيف تام 1(@)(@@) % شرف الوجه في راب زرود % حيث ليلى فثم مهوى السجود % 2(@)(@@) % واخلع النعل في ثراه احتراما % لاتضعه على نقوش الخدود % 3(@)(@@) % واتبع سنة المحبين فيه % واقض ندبا لواجبات الكبود % 4(@)(@@) % واحذر الصعق يا 
ms52	 كليم فكم قد % صار دكا هناك قلب عميد % 5(@)(@@) % وانشد الربع من منازل ليلى % % عن فؤاد من أضلعي مفقود % 6(@)(@@) % قد أضل النهى فضل لديها % % فاهتدى في الضلال للمقصود % 7(@)(@@) % كم أتاها من قابس نور وصل % فاصطلى دون ذاك نار الصدود % 8(@)(@@) % أيها السائرون نحو حماها % % حسبكم ضوء نارها من بعيد % 9(@)(@@) % لك نار تعشو العيون إليها % % فتمس القلوب قبل الجلود % 10(@)(@@) % إن ورت للقرى فبالند تورى % % أو لحرب فبالوشيع القصيد % PageV01P154 11(@)(@@) % لا تؤدي سلامكم نحوها الر % يح ولا طيفها مطايا الهجود % 12(@)(@@) % لم تصلها حبائل الفكر والوه % م ولو وصلت بحبل الوريد % 13(@)(@@) % شمس خذر من دونها كل بدر % حامل في النجاد فجر حديد % 14(@)(@@) % لم يزل باسطا ذراع هزبر % بارز الناب دونها بالوصيد % 15(@)(@@) % ما رأينا الهلال في معصم الشم % % س ولا الشهب قبلها في العقود % 16(@)(@@) % صاح وافاقتي إلى كنز در % بافاعي أثيثها مرصود % 17(@)(@@) % سفرت في براقع الحسن فاعجب % لجمال محجب مشهود % 18(@)(@@) % كم ترى حول حيها في هواها % % من كرام تصرعت بالصعيد % 19(@)(@@) % منهم من قضى ومنهم شقي % سالم للبلاء لا للخلود % 20(@)(@@) % وصلها يمنح المحب شبابا % وجفاها يشيب رأس الوليد % PageV01P155 21(@)(@@) % لا تلمني إذا تفانيت فيها % % ففناءي في الحب عين وجودي % % 22(@)(@@) % يا سقى الله بالحمى أهل بدر % كم به بين حيهم من شهيد % 23(@)(@@) % هل نسيم الصبا على نارهم مر % ففيه أشم أنفاس عود % 24(@)(@@) % أ عليه ترى الملاعب أم لا % % ما عليه أملت ذبول البرود % 25(@)(@@) % أسرة صيروا الأساور فيهم % لا سارى القلوب أي قيود % 26(@)(@@) % كم أبادوا بالبيض آجال صيد % وبسمر القناء آجال صيد % 27(@)(@@) % شربهم يوم حربهم من دم الأ % م سد وفي سلمهم دم العنقود % 28(@)(@@) % حبذا عيشنا باكناف حزوى % % لا رمى الله ربعها بالهمود % 29(@)(@@) % منزل تنزل الأساور منه % في قرون المها وأيدي الأسود % 30(@)(@@) % ومحل تحل منه المنايا % % بين أجفان عينه والغمود % PageV01P156 31(@)(@@) % قد حمته أيمه الطعن إما % % بصدور الرماح أو بالقدور % 32(@)(@@) % لا أرى لي الزمان 
ms53	 يرعى ذماما % لا ولا نسبة لخير جدود % 33(@)(@@) % أصرف العمر صرفه بين كذب ال % وعد منه وصدق يوم الوعيد % 34(@)(@@) % والد ليته يكون عقيما % لم يلد غير فاجر ومكيد % 35(@)(@@) % أبغض الناس من بنيه لديه % ماجد عقه بخلق جديد % 36(@)(@@) % لم نؤمل لولا وجود علي % منه جودا لا ولا وفا بعهود % 37(@)(@@) % سيد في الأنام أصبحت حرا % منذ في جوده تملك جيدي % % 38(@)(@@) % علوي له نجاد إذا ما % % ذكروه يجر كل عميد % 39(@)(@@) % نسب في القريض يعبق منه % طيب آل النبي عند النشيد % 40(@)(@@) % نبوي منه بكل ندي % ينثر الناسبون سمط فريد % PageV01P157 41(@)(@@) % حازم قوسه إلى كل قصد % فوقت سهمها يد التسديد % 42(@)(@@) % خدمته الدنا فأوقاته الب % يض لديه وسودها كالعبيد % 43(@)(@@) % سيف حتف إلى نفوس الأعادي % حملته حمائل التأييد % 44(@)(@@) % ألفت جيشه النسور فكادت % قبحها أن تبيض فوق البنود % 45(@)(@@) % حيدري إذا الأكارم عدوا % % كان منها مكان بيت القصيد % 46(@)(@@) % ذو خصال حسانها باسمات % عن ثنايا ترملت كالبرود % 47(@)(@@) % شيم كالفرند أصبحن منه % قائمات بذات نصل جديد % 48(@)(@@) % أنجم في القضاء تحكي الدراري % % كم شقي منها وكم من سعيد % % 49(@)(@@) % ويمين بنانها زاخرات % بالمنايا وبالعطاء المزيد % 50(@)(@@) % لجة في الكفاح تنتج نارا % لم تلدها حوامل الجلمود % PageV01P158 51(@)(@@) % أوشكت شعلة المهند فيها % % أن تذيب الدروع ذوب الجليد % 52(@)(@@) % حبك فوقها تسمى خطوطا % وهي بحر وتلك أمواج جودي % % 53(@)(@@) % صدقت رأي قائف حين صارت % قال فيها سياسة للجنود % 54(@)(@@) % مغرم في عناق سمر العوالي % أو ظن الرماح أعطاف غيد % 55(@)(@@) % عوذ الملك بأسه بالمواضي % % فحماه من نزع كل مريد % 56(@)(@@) % آمر في أوامر الله ناه % عن مناهيه حاكم بالحدود % 57(@)(@@) % يعرج المدح للسماء فيأوي % % ثم منه إلى جانب مجيد % 58(@)(@@) % عن علي يورث العلم ولاح % % كم وفصل الخطاب عن داود % 59(@)(@@) % تستفيد النجوم من وجهه النو % % ر ومن حظه قران السعود % 60(@)(@@) % أينها منه رفعة ومحلا % ليس قدر المفيد كالمستفيد % PageV01P159 61(@)(@@) % يم جود تثني عليه الغوادي % % وكفاه فخرا ثناء الحسود % 62 
ms54	(@)(@@) % حسدت جوده فللبرق منها % % نار حزن وأنه للرعود % 63(@)(@@) % هو في وجنة الزمان إذا ما % % نسبوه إليه كالتوريد % 64(@)(@@) % ألمعي يبري النفوس المعاني % % بحسود من لؤلؤ منضود % 65(@)(@@) % سيدي لا برحت في الدهر ركنا % للمعالي وكعبة للوفود % 66(@)(@@) % لك من مطلق الفخار خصال % غير محتاجة إلى التقييد % 67(@)(@@) % كل يوم تأتي بصنع عجيب % خارج عن ضوابط التحديد % 68(@)(@@) % فصلت فيك جملة الفضل وال % % فصل وعلم الأحكام والتجويد % 69(@)(@@) % عمرك الله يا علي ولازل % % ت مسرور الأنام في كل عيد % 70(@)(@@) % إن شهر الصيام عنك ليمضي % % وهو يثني عليك عطف ودود % PageV01P160 71(@)(@@) % قد تفرغت فيه عن كل شيء % شاغل للدعاء والتحميد % 72(@)(@@) % وهجرت الرقاد هجرا جميلا % ووصلت الجفون بالتسهيد % 73(@)(@@) % وعصيت الهوى وأعرضت عنه % امتثالا لطاعة المعبود % 74(@)(@@) % قوتك الذكر فيه والورد ورد % إن دعاك الأنام نحو الورود % 75(@)(@@) % فاسم واسلم وفز بأجر صيام % فطره فاطر لقلب الحسود % 76(@)(@@) % وابق في نعمة وحظ سني % وعلا لم يزل وعيش رغيد % PageV01P161 البحر : كامل تام 1(@)(@@) % عج بالعقيق وناد أسد سراته % % أسرى قلوب في يدي ظبياته % 2(@)(@@) % وابذل به نقد الدموع عساهم % أن يطلقوها رشوة لضاته % 3(@)(@@) % وأسألهم عما بهم صنع الهوى % % لشقائهن به وجور ولاته % 4(@)(@@) % هامت بواديه القلوب فأصبحت % منا النفوس تسيح في ساحاته % 5(@)(@@) % إن لم تذقنا الموت أعين عينه % كمدا فأصحانا لفي سكراته % 6(@)(@@) % نقضي وينشرنا هواه كأنما % % نفس المسيح يهب في نفحاته % 7(@)(@@) % واد إذا دارين سافر طيبها % % عنها غدا متوطنا بجهاته % 8(@)(@@) % إن لم تكن بالحظ تعرف أرضه % فلقد زهت أكنافها بنباته % 9(@)(@@) % كمنت بأكناف الرباب أسدها % % فبه الكناس تعد من غاباته % 10(@)(@@) % لله حي أشبهت بصفاحها % % فتيانه اللفتات من فتياته % PageV01P162 11(@)(@@) % ومحل طعن شاككت برماحها % % خفراؤه القامات من خفرته % 12(@)(@@) % فلك مشارقه الجيوب أما ترى ال % أطواق في الأعناق من هالاته % 13(@)(@@) % تهوي بدور التيم حتى قبابه % وتلوح أنجمه على قنواته % 14(@)(@@) % أسد النجوم وإن تعذر نيله % أدنى وصول من وصول مهاته % 15(@)(@@) % دون الأماني البيض خلف 
ms55	 ستوره % حمر المنايا في عمود حماته % 16(@)(@@) % حرم بأجنحة النسور صيانة % عضت كواسره على بيضاته % 17(@)(@@) % وحمى به نصب الهوى طاغوته % فاحذر به إن جزت فتنة لاته % 18(@)(@@) % لم ندر أيهما أشد إصابة % مقل الغواني أم سهام رماته % 19(@)(@@) % تغنيك وجنات الدمى عن ورده % ومراشف الغزلان عن حاناته % 20(@)(@@) % سل عن أوانس بيضه قمر الدجى % % فعساه يرشدنا إلى أخواته % PageV01P163 21(@)(@@) % وانشد به إن جئت يانع بانه % قلبي فطائره على عذباته % 22(@)(@@) % ما باله من بعد عز جوانبي % % يختار ذل الأسر في جنباته % 23(@)(@@) % ياحبذا المتحملون وإن هم % حكموا على جمع الكرى بشتاته % 24(@)(@@) % أموا العقيق وخلفوا خلف الغضا % % جسمي الفنا وتعوضوا بحياته % 25(@)(@@) % غابوا عن الدنف المفدى طيفهم % إن صدق الرؤيا بذبح سناته % 26(@)(@@) % نسخوا زبور عزاه منذ بهجرهم % نسجوا سطور الدمع في وجناته % 27(@)(@@) % لولا غوالي الدر بين شفاههم % لم يرخص الياقوت من عبراته % 28(@)(@@) % أحيا الدجا كمدا فخر صباحه % ميتا فأوقعه القضا بشواته % 29(@)(@@) % ولج الهوى فيه فأخرج كبده % فلذا بذي الدمع من حدقاته % 30(@)(@@) % يخفي صبابته ومصدور الهوى % % نطق الدموع الحمر من نفثاته % PageV01P164 31(@)(@@) % سيان فيض دموعه يوم النوى % % وندى علي المجد يوم هباته % 32(@)(@@) % فخر السيادة والعلى الملك الذي % % سجدت وجوه الدهر في عتباته % 33(@)(@@) % صمصامة الحق المبين وعامل الد % ين القويم سنان مسنوناته % 34(@)(@@) % ألكوكب الدري نور زجاجة ال % مختار بل مصباح ذرياته % 35(@)(@@) % حر يدل على كريم نجاده % طيب النبوة من جيوب صفاته % 36(@)(@@) % سمح يد التصوير خطت للورى % % سبلا إلى الأرزاق في راحاته % 37(@)(@@) % فطن له ذهن إذا حققته % أبصرت نور الله في مشكاته % 38(@)(@@) % يقفو ظهر الكائنات بحدسه % فيرى وجوه الغيب في مرآته % 39(@)(@@) % عيسى الزمان طيب أمراض العلا % % محيي رفات الجود بعد مماته % 40(@)(@@) % لله كم في علمه من درة % مخزونة كمنت بلخ فراته % PageV01P165 41(@)(@@) % إن يعبق النادي بحسن حديثه % فلطيب ما ترويه لسن رواته % 42(@)(@@) % متورع عف المآزر طائع % يعصي الهوى لله في خلواته % 43(@)(@@) % ما أة شغلته طاعة عن 
ms56	 طاعة % فصلاته مشفوعة بصلاته % 44(@)(@@) % فسل المضاجع عن تجافيه الكرى % % واستخبر المحراب عن نغماته % 45(@)(@@) % يتقرب الجاني إليه لعفوه ال % مأمول عند السخطفي زلاته % 46(@)(@@) % كل المطالب دونه فلو أنه % طلب السماك لحط من درجاته % 47(@)(@@) % لسن يواري باللسان مهندا % تشفى صدور الحق في ضرباته % 48(@)(@@) % ما قال لا يوما ولا عثر الهوى % % كلا ولا التأثيم في لهواته % 49(@)(@@) % لو أن أصداف اللآلي أوتيت % سمعا عليها آثرت كلماته % 50(@)(@@) % أو للنجوم يباع حسن بيانه % أعطت دراريها بدور بناته % PageV01P166 51(@)(@@) % يوحي الكلام إلى جماد يراعه % سرا فيفصح عن بديع لغاته % 52(@)(@@) % فالدر يعلم أن أكرم رهطه ال % % منثور والمظلوم من لفظاته % 53(@)(@@) % والسحر يعلم أنما هاروته % قلم تنكر في قليب دواته % 54(@)(@@) % قرن قضى من تيم أبناء العدى % % وأذاق قلب الدهر ثكل بناته % 55(@)(@@) % شمس إذا ركب الدجنة غازيا % طلعت نجوم القذف من هفواته % 56(@)(@@) % أو ما ترى وجه الصباح قد اكتسى % % أثر اصفرار الخوف من غاراته % 57(@)(@@) % كل النجوم تغور خيفة بأسه ال % مشهور حين يمر نهر سراته % 58(@)(@@) % طال اغتراب سيوفه فتوطنت % بدل الغمد جسوم أسد عداته % 59(@)(@@) % يبكي اللهام دوما ويضحك عضبه % بيمينه هزؤا على هاماته % 60(@)(@@) % وتميل من طرب قناه لعلمها % % ستبل غلتهن عن مهجاته % PageV01P167 61(@)(@@) % كالليث في وثباته يوم الوغى % % والطود في تمكينه وثباته % 62(@)(@@) % أيامه في العصر كالتوريد في % % خديه أو كالبحر في لحظاته % 63(@)(@@) % قد ألبس الدنيا ثياب مفاخر % ستر الزمان بها عوراته % 64(@)(@@) % هذي ثمار نواله فليقتطف % ما يبتغي المحتاج من حاجاته % 65(@)(@@) % قسم الحيا فبكفه المقصور وال % % ممدود مقصور على قسماته % 66(@)(@@) % حسن له وجه يريك إذا انجلى % % ماء السماح يجول في صفحاته % 67(@)(@@) % وشمائل لو في السماء تجسمت % كانت بدور التم في ظلماته % 68(@)(@@) % يا ابن الذين بيوم بدر أزهقوا % % بحدود أأنصلهم نفوس طغاته % 69(@)(@@) % وابن الميامين الذين توارثوا % % علم الكتاب وبينوا آياته % 70(@)(@@) % مولاي لا برح الزمان مجيده % أو يؤنس المحراب في دعواته % PageV01P168 71(@)(@@) % سلف دعتك إلى العلا فنهضت في 
ms57	 % % أعبائه وحللت في شرفاته % 72(@)(@@) % سمعا فديتك مدحة ما شانها % % ملق الرياء بغش تمويهاته % 73(@)(@@) % لولاك ما صغت القريض لغاية % ولصنت مني النفس عن شبهاته % % 74(@)(@@) % لكنني النحل الذي أرعيته ال % % نعمى لديك فمج شهدة ذاته % 75(@)(@@) % ويراع شكريك الذي أسقيته % ماء الندى فسقاك ماء نباته % 76(@)(@@) % علمتني بنداك نسج حريره % فكسوت عرضك خير ديباجاته % 77(@)(@@) % واستجل بكرا رصعت أيدي الحجا % % منها الحلى بفصوص مبتكراته % 78(@)(@@) % عذراء حجبها الجمال وصانها % % عمن سواك الفكر في حجراته % 79(@)(@@) % خطب الزمان وصالها لملوكه % فأبت قبول سواك من ساداته % 80(@)(@@) % حلت محل العقد منك فأشبهت % كلماتها المنظوم من حباته % PageV01P169 81(@)(@@) % نقشت خواتمها بكم فلأجل ذا % % ختم الزمان بها على جبهاته % 82(@)(@@) % % مغلولة عنكم يدا نكباته % 83(@)(@@) % وبقيت تلقى العبد في نهج العلا % % أبدا وعاد عليك في بركاته % 84(@)(@@) % وليهنك الشهر الشريف وصومه % وثواب واجبه ومندوباته % 85(@)(@@) % فرغت فيه القلب عن شغل الهوى % % وعصيت ما يلهيك عن طاعاته % 86(@)(@@) % وعليك رضوان المهيمن دائما % وصلاته وأجل تسليماته % PageV01P170 البحر : طويل 1(@)(@@) % بقيت بقاء الدهر يا بهجة الدهر % وهنئ فيك العصر يا زينة العصر % 2(@)(@@) % وفدت محياك النجوم بشمسها % % ولا زلت منها تجتني هالة البدر % 3(@)(@@) % ولا برحت ريح الوغى لك في اللقا % % تفتح أزهار الفتوح مع البشر % 4(@)(@@) % ولا برح الجيش الذي أنت قلبه % يضم جناحيه على بيضة النصر % 6(@)(@@) % لقد سرت الدنيا بنصرك والعلا % % وأصج دست الملك منشرح الصدر % 7(@)(@@) % نشأت ونفس الجود في قبضة الردى % % فأنقذتها في بسط أنملك العشر % 8(@)(@@) % وأحدثت في وجه الزمان طلاقة % ووردت خد المجد في بيضك الحمر % 9(@)(@@) % ورنحت أعطاف الرماح كأنما % % مزجت دما سقيتها منه بالخمر % 10(@)(@@) % قدود المعالي ما حملت من القنا % % وأحداقها ما قد هززت من البتر % 11(@)(@@) % عضدت بحسن الرأي عضبا مهندا % فأعرب عند الضرب عن معجم السر % PageV01P171 12(@)(@@) % شفعت بماضي العزم يا ذا غراره % فأدركت وتر المجد بالضربة الوتر % 13(@)(@@) % وفلقت هامات به طال ما غدت % متوجة في عزة الغي والكبر % 14(@)(@@) % تراها العلا في 
ms58	 خدها وهي في الثرى % % على دمها خالا على وجنتي بكر % 15(@)(@@) % كأن دما منها سقى تربة قد سقى % % رقاب العلا بعد البلى جرعة الخضر % 16(@)(@@) % وأهزمت أحزاب الضلال ولو ونوا % % لألحقتهم في إثر سيدهم عمرو % % 17(@)(@@) % وأخرجتهم في زعمهم عن ديارهم % وما اعتقدوا هذا إلى أول الحشر % 18(@)(@@) % وألقوا حبال المنكرات وخيلوا % % فعارضتهم في آية السيف لا السحر % 19(@)(@@) % كفى الله فيك المؤمنين لدى الوغى % % قتال العدا حتى سلمت من الأزر % 20(@)(@@) % ولو لم يكف البأس عفوك عنهم % لعدت وقد عاد الحديد من التبر % 21(@)(@@) % وما لبثوا إلا قليلا فكم ترى % % بهم من ظليم فر عن بيضة الخدر % PageV01P172 22(@)(@@) % تولوا مع الخفاش في غسق الدجى % % وخافوا طلاب الشمس في عقب الفجر % 23(@)(@@) % إذا ما لهم عقبان راياتك انجلت % أعيروا من الغربان أجنحة الغر % 24(@)(@@) % رميتهم في فيلق قد تفردت % به طائرات النحج في عذب السمر % 25(@)(@@) % به كل شهم من سلالة هاشم % من الحيدريين الغطارفة الغر % 26(@)(@@) % إذا ولجوا في معرك كاد نقعه % لطيبهم يربي على طيب العطر % 27(@)(@@) % سحائب جود كلما سئلوا همت % بنانهم للوفد بالبيض والصفر % 28(@)(@@) % أسودكفاح بأسهم في رماحهم % كسم الأفاعي في أنابيبها يجري % % 29(@)(@@) % وكم قبلهم صبحت قوما بغارة % فلم يحتموا منها ببر ولا بحر % 30(@)(@@) % رجعت ضحى عن أسدهم نجس الظبا % % وعن عيبهم عف الردا طاهر الأزر % 31(@)(@@) % أبا السبعة الأطهار لا زلت ناظما % بهم عقد جيد المجد بالأنجم الزهر % PageV01P173 32(@)(@@) % ملوك إذا شنوا الإغارة لم تكن % لهم همة إلا إلى مغنم الفخر % 33(@)(@@) % فمن شئت منهم فهو مصباحك الذي % يفيد العلا نورا وكوكبك الدري % 34(@)(@@) % وإنهم أيام أسبوعك التي % % على الخلق تقضي بالمنافع والضر % 35(@)(@@) % وأبحرك اللج التي قد جعلتها % % بيوم الندى والضرب للمد والجزر % 36(@)(@@) % إذا نسبوا للأكرمين فإنهم % بمنزلة السبع المثاني من الذكر % 37(@)(@@) % حواميم رشد فصلت للورى هدى % وآيات فتح أنزلت ليلة القدر % 38(@)(@@) % بهم نفذ الرحمن حكمك في الورى % % فعشت وعاشوا في السعيد من العمر % PageV01P174 البحر : كامل تام 1 
ms59	(@)(@@) % وا بال وتر صلاتكم لا تشفع % م فيكم مفردي لا يجمع % 2(@)(@@) % وإلام أرجو قربكم وشموسكم % عن ردهن إلي يعجز يوشع % 3(@)(@@) % غبتم وصيرت الحمائم بعدكم % إلفا ولكني أنوح وتسجع % 4(@)(@@) % وشققت بعدكم الجيوب ففصلت % منهن لي حمر الثنايا الأدمع % 5(@)(@@) % حتام أطلب سلسبيل وصالكم % وأرد عنه وعلتي لا تقنع % 6(@)(@@) % إني لأعجب من حفاظ عهودكم % عندي وجسمي في الرسوم مضيع % 7(@)(@@) % هجر الضنى جسدي لوصلكم النوى % % إذ للضنى لم يبق فيه موضع % 8(@)(@@) % وتشاركت في قتل نومي خمسة % سهر الليالي والدموع الاربع % 9(@)(@@) % لله من رشقات نبل جفونكم % % 10(@)(@@) % % توري وماء الحسن منها ينبع % PageV01P175 11(@)(@@) % بالله يالعس الشفاه لصبكم % أدوا زكاة زكاة كنوزها لا تمنعوا % % 12(@)(@@) % منطقتم خصري بخاتم خنصري % % حيث استوى جسمي بكم والإصبع % 13(@)(@@) % وا فاقة المضنى بكم ونطاقه % % 14(@)(@@) % جحدت جفونكم دمي وخدودكم % فيهن منه شبه لا تدفع % 15(@)(@@) % وعذلتموني إذ خلعت بحبكم % عذري فعذري عندكم لا يسمع % 16(@)(@@) % لو تعزمون بواسعات عيونكم % لعلمتموني أن عذري أوسع % 17(@)(@@) % كم ياسراة الحي فوق صدوركم % من حية تسعى لقبي تلسع % 18(@)(@@) % ولكم بكم قمر تبرقع بالسنا % % 19(@)(@@) % لله كم بعيون عين كناسكم % من ضيغم يسطو وآخر يصرع % 20(@)(@@) % غصبت غصون قدودكم دول القنا % % فغدت لعزتهاتلبن وتضرع % PageV01P176 21(@)(@@) % واستخدمت أجفانكم بيض الظبا % % فعصيهن لها مجيب طيع % 22(@)(@@) % كل العوارض دونكم يوم النوى % % عند الوداع تزول إلا البرقع % 23(@)(@@) % ياليته أضحى لنبل لحاظهم % % 25(@)(@@) % منع النسيم بها عناق غصونها % % فيد الصبا لو صافحتها تقطع % 26(@)(@@) % ياجبرة جاروا علي فزلزلوا % % مني الفؤاد وركن صبري زعزعوا % % 27(@)(@@) % ما حيلتي بعد المشيب لوصلكم % وصباي عند حسانكم لا ينفع % 28(@)(@@) % أشكو إلى زمني جفاكم وهو من % إحدى نوائبه ومنها أفظع % 29(@)(@@) % يا قلب لا تلقي ولا تك واثقا % بالبشر منه فإنه متصنع % 30(@)(@@) % وببره لا تستعز فإنه % فخ بحبنه يكيد ويخدع % 31(@)(@@) % كم في بنيه ظالم متظلم % كالذئب يقتنص الغزال ويطلع % PageV01P177 32(@)(@@) % لم يبق فيه كريم كفؤ يرتجى % % إلا علي والسحاب الهمع % 33(@)(@@) % نجل 
ms60	 الكرام أخو الغمام وصاحب ال % % فضل التمام أخو الحسين الأروع % 34(@)(@@) % سمح تفرد بالنوال وإن غدا % % وكف السحاب لكفه يتتبع % 35(@)(@@) % يهمي وتهمى المعصرات وإنما % % هذا له طبع وتلك تطبع % 36(@)(@@) % للله شعلة بارق لا تنطفي % % في راحتيه وديمة لا تقلع % 37(@)(@@) % % ويعود يوم الحرب نارا تسفع % 38(@)(@@) % لو تسج الأقمار في فلك به % لم تستطع في العام يوما تطلع % 39(@)(@@) % ولو أن حوت الافق يسكن لجة % كادت لعنبره الدجنة تقلع % 40(@)(@@) % أنشأ من العدم المكارم فاعتدى % % منها يصور ما يشاء ويبدع % 41(@)(@@) % فطن تنور قلبه من ذهنه % فظباؤه بضميره تتشعشع % PageV01P178 42(@)(@@) % فكأن عين الشمس كانت ضرة % تسقيه من لبن الصباح وترضع % 43(@)(@@) % راجي نداه لديه يعذب بأسه % فيكاد في ذر الكواكب يطمع % 44(@)(@@) % وجياده في الغزو يعطشها السرى % % فتكاد في نهر المجرة تكرع % 45(@)(@@) % فضل الملوك وطينه من طينهم % ومن الحجارة جوهر واليرمع % 46(@)(@@) % يرنو إلى درق الحديد هوى كما % % يرنو إلى ورق اللجين المدقع % 47(@)(@@) % ويميل صبا للرماح كأنه % صب بقامات الملاح مولع % 48(@)(@@) % كالقلب في صدر الخميس تظنه % في جانبيه من الصوارم أضلع % 49(@)(@@) % يسطو وأفواه الجراح فواغر % تشكو وألسنة الأسنة تلذع % 50(@)(@@) % لم يرو من ماء الفرات حسامه % كالنار من إضرامها لا تشبع % 51(@)(@@) % لو أريحيته تهز لدى الندى % % جذعا لأوشك باللآلئ يطلع % PageV01P179 52(@)(@@) % بثناه يلهج كل ذي روح فلو % نطق الجماد لكان فيه يصدع % 53(@)(@@) % تهوي لعزته الرؤس مهابة % ولوجهه تعنو الوجوه وتخضع % 54(@)(@@) % يبدو فكم من دعوة مشفوعة % في حاجة تهدى إليه وترفع % 55(@)(@@) % لمعادن الأرزاق من أكمامه % طرق وللبحرين فيها مجمع % 56(@)(@@) % عجبا له يسع القميص وإنه % لو كان شمسا لم تسعه بلقع % 57(@)(@@) % لا يبلغن إليه سهم معاند % لو كان في قوس الكواكب ينزع % 58(@)(@@) % دانت له الأيام حتى لو يشا % % عودا لماضيها لكانت ترجع % 59(@)(@@) % نظر العفاة نواله فاستبشروا % % ورأى العداة نزاله فاسترجعوا % % 60(@)(@@) % يا ابن الميامين الذين على الورى % % بالفضل قد أخذوا العهود وبويعوا % % 61(@)(@@) % حازوا العلا إرثا ومن آبائهم 