ms1301	 - العلوي(@)(@)(@@) : [نسبة] إلى علي بن أبي طالب، وبنو علي بطن من الأزد (¬1). ودولة العلوية. والفقهاء العلويون بزبيد ينتمون في النسب إلى علي بن راشد من أولاد عك وجدهم:(@)(@@) إسمعيل(@)(@@) عبد الرحمن(@)(@@) مجمد(@)(@@) أبو بكر(@)(@@) علي(@)(@@) العلوي: [نسبة] إلى علويه.(@)(@@) علوي: [مخلص أربعة من الشعراء العثمانيين عاشوا في القرن العاشر الهجري،(@)(@)(@@) 7772 - • أولهم إستانبولي كان منسوبا إلى أوجاق الإنكشارية، وعرف بحسن خطه ونسخ العديد من الكتب.(@)(@@) 7773 - • والثاني إستانبولي أيضا، وعرف باسم درزي زاده.(@)(@@) 7774 - • والثالث من بروسة، عرف باسم يكان أوغلى، وكان من فئة رجال العلم، لكنه مال بعد ذلك إلى الاعتكاف، وله أشعار في الزهد والنصح والإرشاد.(@)(@@) 7775 - • أما الرابع فهو من بروسة أيضا، وكان من مادحي السلطان مراد خان، وله منظومة تركية بعنوان "هفت بيكر" أي الحسان السبع، وكان يحاكي الشعراء الفرس في أشعارهم] (¬2).(@)(@@) العلياباذي: إليه [ينسب] الإمام حسام الدين محمد بن عثمان الحنفي (¬3) صاحب "الفوائد" وأستاذ عماد الدين، صاحب "الفصول".(@)(@@) العلياني: [نسبة] إلى عليان، بطن من همدان (¬4).(@)(@@) العليجي: [نسبة] إلى عليجه، تصغير علي [بالتركية] (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 7776 - العليصي: [نسبة] إلى عليص بن ضمضم بن عدي(@)(@)(@@) (¬6).(@)(@)PageV05P148(@)(@)(@@)(@@)(@@) ||| CHECK 7779 - وعماد بن جبريل اسمه محمد(@)(@)(@@)(@@)(@@) ||| CHECK 7777 - أبو محمد يحيى بن محمد الأنصاري المقرئ(@)(@)(@@) العليمي: [نسبة] إلى عليم بطن من كلب ومن باهلة وجد (¬1)، إليه [ينسب]:(@)(@)(@@) 7777 - • أبو محمد يحيى بن محمد الأنصاري المقرئ (¬2)، مات [سنة] 243 عن 93 [سنة]،(@)(@@) • والشيخ عبد الرحمن بن محمد (¬3) صاحب "الأنس الجليل في تاريخ القدس(@)(@@) [والخليل] ".(@)(@@) العلي: [نسبة] إلى علة بطن من مذحج (¬4).(@)(@@) العلى: [نسبة] إلى علة بطن من قضاعة (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 7778 - عماد الإسلام: لقب القاضي عبد الرحيم بن عبد العزيز بن محمد السديدي الزوزني(@)(@)(@@) (¬6)،(@)(@@) • وصاعد بن محمد بن أحمد (¬7)، الحنفيان.(@)(@@) عماد الدولة: علي بن بويه (¬8).(@)(@@) عماد الدين: محمد بن محمد بن حامد الكاتب الأصبهاني (¬9)، مات [سنة 597].(@)(@@) • ويحيى بن أحمد الكاشي (¬10)، مات [بعد سنة 745]،(@)(@)(@@) 7779 - • وعماد بن جبريل اسمه محمد.(@)(@)(@@)(@@)(@@) ||| AUTO 7780 - العماد: علي بن أحمد بن محمود ابن الغزنوي الحنفي(@)(@)(@@) (¬11).(@)(@)(@@)(@@)(@@) ||| AUTO 7781 - العمادي: [نسبة] 
ms1302	 إلى عماد ... أوهو جمال الدين بن عماد الدين الحنفي(@)(@)(@@) ، وقيل هو أبو الفتح عبد الرحيم بن أبي بكر بن عبد الجليل المرغيناني السمرقندي] صاحب "الفصول" الحنفي (¬12)، وإلى قرية من قرى إسكلب يقال لها دركلو، إليه:(@)(@@) • المولى أبو السعود المفتي (¬13).(@)(@)PageV05P149(@)(@)(@@)(@@)(@@) ||| CHECK 7782 - أبو الفرج(@)(@)(@@) العماري: [نسبة] إلى عمار جد (¬1)، والعمارية: دولة في القرن السادس بطرابلس الغرب يقال لها [دولة] بني عمار.(@)(@@) العماني: [نسبة] إلى عمان، مدينة البلقاء بالشام (¬2).(@)(@@) العماني: [نسبة] إلى عمان، [وهي] قرية [على البحر] تحت البصرة (¬3)، إليه [ينسب]:(@)(@)(@@) 7782 - • أبو الفرج (¬4).(@)(@@) العمايمي: [نسبة] إلى العمامة المعروفة (¬5).(@)(@@) العمراني: [نسبة] إلى العمرانية، ناحية بالموصل (¬6).(@)(@@) العمروسي: [نسبة] إلى عمروس جد (¬7).(@)(@@) العمري: [نسبة] إلى عمر بن الخطاب، وعمر بن علي بن أبي طالب. قال السيوطي: وإلى العمرية محلة ببغداد (¬8).(@)(@)(@@)(@@)(@@) ||| AUTO 7783 - العمروي: [نسبة] إلى عمرو بن عامر بن ربيعة، وعمرو بن عوف(@)(@)(@@) (¬9)، بطن من الأنصار، وعمرو بن الخزرج منهم: وعمرو بن أسد، من الأزد، وعمرو بن عبيد المعتزلي، وإلى قراءة أبي عمرو [الداني] (¬10).(@)(@@) عميد الملك: أبو نصر منصور بن محمد الكندري وزير السلطان طغرل (¬11).(@)(@@) العميدي: [نسبة] إلى العميد، بفتح العين، قال ابن خلكان (¬12): ولا أعرف إلى ماذا، [وإليه]:(@)(@@) • ركن الدين محمد بن محمد بن محمد السمرقندي الحنفي (¬13)، مات 615.(@)(@@) العميري: [نسبة] إلى عميرة، بطن من ربيعة (¬14).(@)(@)PageV05P150(@)(@)(@@)(@@)(@@) ||| CHECK 7789 - وأبو زكريا يحيى بن عبد الله بن العنبر بن عطا السلمي الشافعي(@)(@)(@@)(@@)(@@) ||| CHECK 7788 - وعبيد الله بن الحسن الفقيه قاضي البصرة(@)(@)(@@)(@@)(@@) ||| CHECK 7787 - وأبو الفضل عباس بن عبد العظيم بن إسمعيل(@)(@)(@@)(@@)(@@) ||| CHECK 7786 - الشيخ أبو إسحاق إبراهيم بن إسماعيل الطوسي الحافظ(@)(@)(@@)(@@)(@@) ||| CHECK 7784 - علي بن محمد(@)(@)(@@) العمي: [نسبة] إلى العم، بطن من تميم، أما زيد العمي فلقب به لأنه كان يسأل عن الشيء فيقول: حتى أسأل عمي (¬1)، وإلى الأول:(@)(@)(@@) 7784 - • علي بن محمد (¬2).(@)(@@) العنابي: [نسبة] إلى العناب المعروف (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 7785 - العنبري: [نسبة] إلى العنبر بن عمرو بن تميم، وعنبر جد(@)(@)(@@) (¬4)، إليه [ينسب]:(@)(@@) 7786 - • الشيخ أبو إسحاق إبراهيم بن إسماعيل الطوسي الحافظ (¬5)، المتوفى [سنة] ست وثمانين ومائتين، 
ms1303	 عن نيف وثمانين [سنة]. وكان محدث عصره بطوس بعد شيخه محمد بن أسلم، صنف "مسندا" كبيرا في مائتي جزء وبضعة عشر، ذكره الذهبي في "سير النبلاء"،(@)(@@) • والإمام زفر بن هذيل (¬6)، مات [سنة 158](@)(@)(@@) 7787 - • وأبو الفضل عباس بن عبد العظيم بن إسمعيل (¬7)، مات [سنة] 246،(@)(@@) 7788 - • وعبيد الله بن الحسن الفقيه قاضي البصرة (¬8)، مات [سنة] 168،(@)(@@) 7789 - • وأبو زكريا يحيى بن عبد الله بن العنبر بن عطا السلمي الشافعي (¬9)، مات سنة 344 عن 71 [سنة].(@)(@@) العنبي: [نسبة] إلى العنب المعروف (¬10).(@)(@)(@@)(@@)(@@) ||| AUTO 7790 - عنترة: هو [عنترة] بن شداد [بن عمرو] بن معاوية بن قراد العبسي(@)(@)(@@) (¬11)، من أشهر فرسان العرب. كان شديد السواد.(@)(@@) العنتري: [نسبة] إلى عنترة جد (¬12).(@)(@)PageV05P151(@)(@)(@@)(@@)(@@) ||| CHECK 7795 - العباس بن الربيع(@)(@)(@@)(@@)(@@) ||| CHECK 7792 - والثاني من قسطموني](@)(@)(@@)(@@)(@@) ||| CHECK 7791 - أحدهما من استانبول(@)(@)(@@) عندليبي: [مخلص شاعرين عثمانيين عاشا في القرن العاشر الهجري،(@)(@)(@@) 7791 - • أحدهما من إستانبول،(@)(@@) 7792 - • والثاني من قسطموني] (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 7793 - العنزي: [نسبة] إلى عنزة بن أسد بن ربيعة بن نزار(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 7794 - العنزي: [نسبة] إلى عنز بن وائل أخي بكر(@)(@)(@@) (¬3)، إليه [ينسب]:(@)(@@) 7795 - • العباس بن الربيع (¬4).(@)(@@) العنسي: [نسبة] إلى عنس حي من مذحج (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 7796 - العنصري: مخلص أبي القاسم حسن بن أحمد البلخي الشاعر(@)(@)(@@) (¬6)، مات [سنة] 431، كان يلقب بملك الشعراء. له مهارة في الفنون، ولفضائله يدعى بالحكيم ويقدم على شعراء عصره عند السلطان محمود، وكان ينادمه ويصاحبه في أكثر الاجتماعات معه وقد اجتمع في بابه أزيد من أربعمائة شاعر، فإذا جاء أحدهم بقصيدة في مدحه عرضها أولا على العنصري ثم على السلطان فحصل له الجاه الوافر والمال المتكاثر. وله قصيدة طويلة في غزواته، وديوانه مشتمل على ثلاثين ألف بيت. وكان يعجبه الفردوسي ونظمه. كذا في "تذكرة الأولياء" و"مجالس النفائس".(@)(@)(@@)(@@)(@@) ||| AUTO 7797 - عنقا(@)(@)(@@) : [مخلص شاعر يعرف باسم حسين، عاش في القرن العاشر الهجري، أصله من شيراز وهاجر إلى بلاد الروم وتوطن في إستانبول؛ ويقول قنالي زاده صاحب "تذكرة الشعراء" إنه كان له صحبة ومودة مع والده، وله أشعار فارسية وتركية] (¬7).(@)(@@) العنقزي: [نسبة] إلى العنقز، 
ms1304	 وهو الريحان (¬8).(@)(@@) العنيني: [نسبة] إلى عنين، بطن من طيء (¬9).(@)(@@) العودي: ...(@)(@)PageV05P152(@)(@)(@@)(@@)(@@) ||| CHECK 7802 - والثاني عرف باسم علي، وكان هو الآخر أدرنوي(@)(@)(@@)(@@)(@@) ||| CHECK 7801 - أولهم من أدرنة(@)(@)(@@)(@@)(@@) ||| CHECK 7799 - أبو بكر محمد بن سنان الحافظ(@)(@)(@@)(@@)(@@) ||| CHECK 7798 - حسين بن حسن الحنفي(@)(@)(@@) العوذي: [نسبة] إلى عوذ، بطن من الأزد (¬1)(@)(@@) العوسجي: [نسبة] إلى عوسجة جد (¬2).(@)(@@) العوصي: [نسبة] إلى عوص، بطن من كلب (¬3).(@)(@@) العوفي: [نسبة] إلى عبد الرحمن بن عوف (¬4)، وإلى: عوف بن سعد، بطن من قيس عيلان وآخر من ذبيان (¬5)، إليه [ينسب]:(@)(@)(@@) 7798 - • حسين بن حسن الحنفي (¬6)، مات [سنة 201].(@)(@@) العوقي: [نسبة] إلى العوقة، بطن من عبد القيس، ومحلة لهم بالبصرة (¬7)، إلى الأول:(@)(@)(@@) 7799 - • أبو بكر محمد بن سنان الحافظ (¬8)، مات [سنة] 223.(@)(@@) العوني: [نسبة] إلى عون (¬9).(@)(@@) العوهي: [نسبة] إلى عوه بطن (¬10).(@)(@)(@@)(@@)(@@) ||| AUTO 7800 - عويف القوافي: هو عويف بن معاوية بن عقبة(@)(@)(@@) (¬11)، لقب بذلك لقوله:(@)(@@) سأكذب من قد كان يزعم أنني ... إذا قلت قولا لا أجيد القوافيا(@)(@@) العوي: [نسبة] إلى العوة، بطن من سامة بن لؤي وجد (¬12).(@)(@@) عهدي: [مخلص ثلاثة من الشعراء العثمانيين عاشوا في القرن العاشر الهجري،(@)(@)(@@) 7801 - • أولهم من أدرنة، وكان من الخطاطين وكتاب الديوان على أيام السلطان بايزيد خان الثاني.(@)(@@) 7802 - • والثاني عرف باسم علي، وكان هو الآخر أدرنوي، ذاعت شهرته بين الناس بلقب (يلديرم شيخي)، وكان من فئة رجال العلم، لكن أشعاره متوسطة الجودة.(@)(@)PageV05P153(@)(@)(@@)(@@)(@@) ||| CHECK 7810 - والثالث شاعر من بروسة](@)(@)(@@)(@@)(@@) ||| CHECK 7809 - والثاني مظفر ابن مفتي حلب(@)(@)(@@)(@@)(@@) ||| CHECK 7808 - أولهم سليمان كان من مناستر(@)(@)(@@)(@@)(@@) ||| CHECK 7807 - أبو بكر بن يحيى بن إسحق(@)(@)(@@)(@@)(@@) ||| CHECK 7803 - والشاعر الثالث بغدادي اسمه أحمد(@)(@)(@@) 7803 - • والشاعر الثالث بغدادي اسمه أحمد، كان من الشعراء المجيدين، وأقام مدة طويلة في إستانبول، وله تذكرة جمع فيها تراجم الشعراء الذين عاشوا في زمنه] (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 7804 - العيابي: [نسبة] إلى عيابة بن عامر بن زيد بن عدوان(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 7805 - العيار: هو الشيخ أبو عثمان سعيد بن أبي سعيد الصوفي(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 7806 - العياضي: [نسبة] إلى عياض جد ابن يحيى بن حسن بن سعد بن 
ms1305	 عبادة الأنصاري(@)(@)(@@) (¬4)، إليه [ينسب]:(@)(@@) • أبو أحمد بن أبي نصر أحمد بن العباس (¬5)، مات .....(@)(@@) عياض(@)(@@) نوفل(@)(@@) جابر(@)(@@) غالب(@)(@@) جبلة(@)(@@) حسين(@)(@@) عباس(@)(@@) أبو نصر أحمد(@)(@@) أبو بكر محمد(@)(@@) أبو أحمد(@)(@@) العياني: [نسبة] إلى عيانة، قرية من قرى مقمح من أعمال الجند باليمين (¬6)، إليه ينسب قوم وقبيلة يعرفون بالأعيون، إليه [ينسب]:(@)(@)(@@) 7807 - • أبو بكر بن يحيى بن إسحق (¬7)، مات ......(@)(@@) عياني: [مخلص ثلاثة من الشعراء العثمانيين عاشوا في القرن العاشر الهجري،(@)(@)(@@) 7808 - • أولهم سليمان كان من مناستر، وسلك طريق العلم، لكنه مات في سن مبكرة.(@)(@@) 7809 - • والثاني مظفر ابن مفتي حلب، سلك طريق العلم هو الآخر.(@)(@@) 7810 - • والثالث شاعر من بروسة] (¬8).(@)(@)PageV05P154(@)(@)(@@)(@@)(@@) ||| CHECK 7817 - وعمر الكرابيسي الحنفي(@)(@)(@@)(@@)(@@) ||| CHECK 7815 - أبو عبد الرحمن عبيد الله بن محمد بن حفص بن عمر القرشي المعروف بالعيشي(@)(@)(@@)(@@)(@@) ||| CHECK 7812 - ومحمد بن محمد بن محمد(@)(@)(@@)(@@)(@@) ||| CHECK 7811 - عبد المجيد بن عبد الرحمن بن أحمد(@)(@)(@@) العيداني: [نسبة] إلى عيدان، بطن من حضرموت (¬1)، إليه [ينسب]:(@)(@)(@@) 7811 - • عبد المجيد بن عبد الرحمن بن أحمد،(@)(@@) 7812 - • ومحمد بن محمد بن محمد.(@)(@)(@@)(@@)(@@) ||| AUTO 7813 - العيدي: [نسبة] إلى يوم العيد(@)(@)(@@) . كان من أباء محمد بن أحمد بن عمر الحنفي (¬2)، مات [سنة 1668] ولد يوم العيد فنسب إليه.(@)(@@) العيذي: [نسبة] إلى عيذ الله بن سعد العشيرة من مذحج (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 7814 - العيسوية: [نسبة] إلى أبي عيسى إسحق بن يعقوب اليهودي الأصبهاني(@)(@)(@@) ، مات ... كان في خلافة المنصور خالف اليهود في أشياء منها أنه حرم الذبائح، وهم طائفة يعتقدون اختصاص رسالة نبينا [صلى الله عليه وسلم] بالعرب [وحدهم].(@)(@@) العيشوني: [نسبة] إلى عيشون رجل (¬4).(@)(@@) العيشي: [نسبة] إلى عائشة الصديقة، وبني عائش بن مالك بن تيم الله (¬5)، إليه [ينسب]:(@)(@)(@@) 7815 - • أبو عبد الرحمن عبيد الله بن محمد بن حفص بن عمر القرشي المعروف بالعيشي (¬6) لأنه من ولد عائشة بنت طلحة، مات [سنة] 228.(@)(@@) العيشي: [نسبة] إلى عيش بطن من حرام، ومن سعد هذيم، ومن مزينة، ومن أشجع، ومن قضاعة (¬7).(@)(@@) العيلاني: [نسبة] إلى قيس عيلان بن نضر (¬8).(@)(@)(@@)(@@)(@@) ||| AUTO 7816 - عين الأئمة: لقب عمر بن محمد 
ms1306	 النسفي الحنفي(@)(@)(@@) (¬9)، مات ....(@)(@@) 7817 - • وعمر الكرابيسي الحنفي (¬10).(@)(@)(@@)(@@)(@@) ||| AUTO 7818 - عين بصل: لقب إبراهيم بن علي بن خليل(@)(@)(@@) ، مات .....(@)(@)PageV05P155(@)(@)(@@)(@@)(@@) ||| CHECK 7820 - الشيخ زين الدين عبد الرحمن بن أبي بكر الدمشقي الحنفي الشهير بابن العيني(@)(@)(@@) العينتابي: [نسبة] إلى عينتاب، بلد من جند قنسرين (¬1)، إليه [ينسب]:(@)(@@) • أحمد بن إبراهيم الدمشقي القاضي عسكر (¬2)، مات [سنة] 767.(@)(@@) العين زربي: إلى عين زربى بلد قرب طرسوس (¬3).(@)(@@) عين الزمان: لقب أحمد بن منير الشاعر (¬4)، مات [سنة] 548.(@)(@@) عين القضاة: عبد الله بن محمد بن علي الهمداني (¬5)، مات مصلوبا [سنة] 525. جامي:(@)(@@) [بالفارسية] بلند مرتبه عين القضاة عيسى دم جشيد شهد شهادت زدست بيجزان(@)(@@) هزار رحمت حق بر روان باكش باكش عارف همه دين بودى وعالم همه وإن (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 7819 - العينوسي: [نسبة] إلى عينوس(@)(@)(@@) ، قرية من نابلس، إليه [ينسب]: إبراهيم بن إسحق.(@)(@@) العينوني: [نسبة] إلى عينون، قرية بالقدس (¬7).(@)(@@) العيني: [نسبة] إلى عين التمر، بلد بالحجاز، قال السيوطي (¬8): وإلى عين تاب قلعة بين حلب وأنطاكية، وإلى عين ثرما قرية بدمشق. أقول: بل بلد بين حلب ومرعش، وإلى رأس العين (¬9) [إليه] ينسب:(@)(@@) • الشيخ بدر الدين محمود بن أحمد العيني الحنفي (¬10)، مات [سنة] 855، وإلى عينتاب:(@)(@)(@@) 7820 - • الشيخ زين الدين عبد الرحمن بن أبي بكر الدمشقي الحنفي الشهير بابن العيني (¬11)، مات سنة 893 [و] إلى رأس عين: ...(@)(@@) * * *(@)(@)PageV05P156(@)(@)(@@)(@@)(@@) ||| CHECK 7821 - الشيخ أبو إسحق إبراهيم بن أحمد بن عيسى بن يعقوب المالكي، النحوي(@)(@)(@@)(@@)(@@) || AUTO [باب] الغين المعجمة(@)(@)(@@) الغابي: كالقاضي، إما إلى غاب موضع باليمن (¬1)، أو إلى غابة موضع قرب المدينة (¬2).(@)(@@) الغانفري: [نسبة] إلى غانفر محلة بسمرقند قال ياقوت بنون ساكنة وفاء مفتوحة (¬3).(@)(@@) غازان خان: لقب السلطان محمود (¬4)، السابع من الجنكزية بأذربيجان.(@)(@@) الغازي: [نسبة] إلى الغزو، وإلى الغاز جد (¬5).(@)(@@) غازي خداوندكار: السلطان مراد بن أورخان، الثالث من العثمانية (¬6).(@)(@@) الغاضري: [نسبة] إلى غاضرة بن مالك بن ثعلبة، وغاضرة بطن من خزاعة (¬7).(@)(@@) الغافري: [نسبة] إلى غافر بطن من سامة بن لؤي (¬8).(@)(@@) الغافقي: [نسبة] إلى غافق كصاحب، بطن من الأزد، وحصن بالأندلس (¬9)، إليه [ينسب]:(@)(@)(@@) 7821 - • الشيخ أبو إسحق إبراهيم بن أحمد 
ms1307	 بن عيسى بن يعقوب المالكي، النحوي (¬10)، المتوفى سنة 710 عشر وسبعمائة عن تسع وستين سنة، وكان شيخ القراءة والنحو بسبتة، له "شرح الجمل"،(@)(@@) • وأحمد بن محمد الطبيب (¬11)، صاحب "الأدوية" المعروف، مات [سنة 560].(@)(@)PageV05P157(@)(@)(@@)(@@)(@@) ||| AUTO 7822 - الغالب بالله: عبد الله بن المعتز بالله العباسي، وقيل لقبه الراضي(@)(@)(@@) (¬1)،(@)(@@) • وإسمعيل بن فرج (¬2)، صاحب الأندلس من الأموية، مات [سنة] 726.(@)(@@) الغالي: [نسبة] إلى الغلو، وغالية أم [محمد بن حامد] وهو القطب (¬3).(@)(@@) الغامدي: [نسبة] إلى غامد، بطن من الأزد (¬4).(@)(@@) الغانمي: [نسبة] إلى غانم جد (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 7823 - الغبابي: [نسبة] إلى غباب لقب ثعلبة بن الحارث بن تيم الله(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 7824 - غبار العسكر: هو مروان الأصفر أبو الشمط(@)(@)(@@) لقب بذلك لقوله:(@)(@@) لما سئلت عن المشيب أجبتهم ... هذا غبار من غبار العسكر(@)(@@) غباري: [عبد الرحمن] (¬7).(@)(@@) الغباغبي: [نسبة] إلى غباغب قرية بحوران (¬8).(@)(@@) الغبري: [نسبة] إلى غبر، بطن من يشكر (¬9).(@)(@@) الغثوي: [نسبة] إلى الغثاة قرية بحوران (¬10).(@)(@@) الغجدواني: [نسبة] إلى غجدوان، بضم الغين وسكون الجيم وفتح الدال قرية ببخارى (¬11) إليه [ينسب]:(@)(@@) • أحمد بن علي بن محمود (¬12)، شارح "الكافية"، مات .....(@)(@@) • وخواجه عبد الخالق (¬13)،(@)(@)PageV05P158(@)(@)(@@)(@@)(@@) ||| CHECK 7826 - ويوسف بن محمد بن أبي سعيد(@)(@)(@@)(@@)(@@) ||| CHECK 7825 - وحاتم بن نصر(@)(@)(@@) 7825 - • وحاتم بن نصر (¬1)،(@)(@@) 7826 - • ويوسف بن محمد بن أبي سعيد (¬2)، ومنها:(@)(@@) • فضل الله مسعود بن محمد الغجدواني (¬3) له "تائية" في الفرائض وشرحها المسمى ب "التكميل".(@)(@@) مجمد الغجدواني(@)(@@) محمد(@)(@@) محمد شرف الدين(@)(@@) سعد الدين مسعود خاله محمد بارسا(@)(@@) عمر نجم الدين خاله أيضا(@)(@@) الغداني: [نسبة] إلى غدانة بن يربوع بن حنظلة (¬4).(@)(@@) الغذاني: [نسبة] إلى غذانة، قرية ببخارى (¬5).(@)(@@) الغذاوذي: [نسبة] إلى غذاوذ محلة بسمرقند (¬6).(@)(@@) الغذ شفردري: [نسبة] إلى غذشفردر قرية ببخارى (¬7).(@)(@@) الغراء: [نسبة] إلى عمل الغراء (¬8).(@)(@@) الغرابي: [نسبة] إلى غراب بلفظ الطير. بطن من فزارة، والغرابية من الشيعة بل من غلاة الرافضة، لقولهم كان النبي - صلى الله عليه وسلم - أشبه بعلي من الغراب بالغراب، فغلط جبرائيل الوحي، كذا في "المقتنى" (¬9).(@)(@@) الغراد: [نسبة] إلى عمل الحائط [من] القصب (¬10).(@)(@@) الغرافي: [نسبة] إلى الغراف، نهر تحت واسط عليه قرى كثيرة (¬11).(@)(@)PageV05P159(@)(@)(@@)(@@)(@@) ||| CHECK 7829 
ms1308	 - وخليل بن محمد بن عبد الرحمن الأقفهسي، الشافعي(@)(@)(@@)(@@)(@@) ||| AUTO 7827 - غرامي(@)(@)(@@) : [مخلص شاعر عثماني عاش في القرن العاشر الهجري وعرف باسم محمد، وهو من قره فريه، كان يطوف البلاد ويدعي كشف الخبايا بالرمل، وأشعاره بسيطة] (¬1).(@)(@@) الغربي: [نسبة] إلى باب الغربة محلة ببغداد (¬2).(@)(@@) الغردياني: [نسبة] إلى غرديان، قرية بما وراء النهر (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 7828 - الغرزي: [نسبة] إلى غرزة، جد أحمد بن حازم(@)(@)(@@) (¬4)، مات [سنة 276].(@)(@@) غرس الدين: خليل بن أحمد بن إبراهيم الحلبي (¬5)، مات [سنة 971]،(@)(@@) • وأبو بكر بن محمد بن إبراهيم (¬6)، مات [سنة 679]،(@)(@)(@@) 7829 - • وخليل بن محمد بن عبد الرحمن الأقفهسي، الشافعي (¬7)، له قصيدة لامية.(@)(@@) الغرقى: [نسبة] إلى غرق، قرية بمرو (¬8).(@)(@@) الغرمينوي: [نسبة] إلى غرمينوى من رستاق سمرقند (¬9).(@)(@@) الغرناطي: [نسبة] إلى غرناطة، مدينة بالغرب (¬10).(@)(@@) الغروي: [نسبة] إلى الغرية، قرية بدمشق (¬11).(@)(@)(@@)(@@)(@@) ||| AUTO 7830 - غريبي(@)(@)(@@) : [مخلص شاعر عثماني عاش في القرن العاشر الهجري، وهو من واردار يكيجه سى، سلك طريق العلم، ثم مال إلى الطريقة المولوية فانتسب إليها، وراح يطوف البلاد، فلما عاد ودخل إستانبول توفي بها سنة 954 ه] (¬12).(@)(@@) الغريري: بالتصغير، [نسبة] إلى غرير بن المغيرة بن حميد بن عبد الرحمن بن عوف (¬13).(@)(@)PageV05P160(@)(@)(@@)(@@)(@@) ||| CHECK 7832 - منصور بن أحمد بن إسماعيل الحنفي(@)(@)(@@)(@@)(@@) ||| CHECK 7831 - ويحيى بن الحكم الغزال(@)(@)(@@) الغزاء: [نسبة] إلى كثرة الغزو (¬1).(@)(@@) الغزالي: بالتشديد: [نسبة] إلى الغزل كالغزال (¬2)، على عادة أهل خوارزم فإنهم ينسبون إلى القصار القصاري و [إلى] العطار العطاري، وقيل هو بالتخفيف إلى غزالة قرية بطوس قاله سراج الدين في "مشيخته" وأن التشديد خطأ حكاه جمع منهم النووي وروي عنه أنه أنكر التشديد وقال: أما الغزالي بتخفيف الزاي إلى غزالة قرية من قرى طوس، وعن ابن الأثير أنه أنكر التخفيف، "المقتنى". وهو خلاف المشهور، إليه [ينسب]:(@)(@@) • الإمام أبو حامد محمد بن محمد بن محمد (¬3)، مات [سنة] 505،(@)(@@) • وأخوه الشيخ أحمد بن محمد بن محمد (¬4)، مات بقزوين [سنة] 520،(@)(@)(@@) 7831 - • ويحيى بن الحكم الغزال (¬5)، وهو الذي يقول الغزل أي الشعر وكان شاعر الأندلس، مات سنة 250. والغزالي القديم من الشافعية هو:(@)(@@) • أبو حامد أحمد بن محمد 
ms1309	 (¬6)، قال الإسنوي: هو عم حجة الإسلام. ذكره السبكي في "الكنى".(@)(@@) الغزقي: [نسبة] إلى غزق، قرية بفرغانة (¬7)، إليه [ينسب]:(@)(@)(@@) 7832 - • منصور بن أحمد بن إسماعيل الحنفي (¬8)، مات [سنة 495].(@)(@@) الغزميني: [نسبة] إلى غزمينة، قصبة من قصبات خوارزم (¬9)، منها:(@)(@@) • الإمام مختار بن محمود الزاهدي (¬10)، مات [سنة] 658.(@)(@)PageV05P161(@)(@)(@@) الغزنوي: [نسبة] إلى غزنة، مدينة بالهند من أول بلاد الهند وقيل موضع قريب من حلب (¬1)، إليه [ينسب]:(@)(@@) • أحمد بن محمد بن محمود الحنفي (¬2)، صاحب "المقدمة"، مات [سنة] 593،(@)(@@) • وسراج الدين عمر بن إسحاق الهندي الحنفي (¬3)، مات [سنة 773].(@)(@@) والغزنوية: دولة في القرن الرابع بخراسان، ويقال لها آل سبكتكين (¬4).(@)(@@) الغزنياني: [نسبة] إلى غزنيان، قرية بما وراء النهر (¬5).(@)(@@) الغزوي: [نسبة] إلى غزية، قبيلة من طيئ، وفخذ من هوازن (¬6).(@)(@@) الغزنيزي: [نسبة] إلى غزنيز، قرية بخوارزم (¬7).(@)(@@) الغزيفي: [نسبة] إلى غزيل، بطن من مراد (¬8).(@)(@@) الغزي: [نسبة] إلى غزة، مدينة بالشام في ساحل البحر من فلسطين (¬9)، إليه [ينسب]:(@)(@@) • شرف الدين عبد القادر بن بركات بن إبراهيم بن حبيب الحنفي (¬10)، صاحب "تنوير البصائر"، و [هو] حاشية على "الأشباه والنظائر" فرغ عنه سنة 1005، وإليه:(@)(@@) • إبراهيم بن يحيى الكلبي الشاعر (¬11)، مات [سنة] 524،(@)(@@) • وبدر الدين محمد بن رضي الدين محمد الغزي (¬12)، صاحب "الرحلة"، مات 980،(@)(@@) • وشمس الدين محمد بن عبد الله بن أحمد (¬13)، صاحب "تنوير الأبصار" ألفه [سنة] 995،(@)(@)PageV05P162(@)(@)(@@)(@@)(@@) ||| CHECK 7833 - محمد بن القاسم(@)(@)(@@) 7833 - • محمد بن القاسم.(@)(@@) أحمد(@)(@@) عبد الله(@)(@@) رضي محمد شمس الدين(@)(@@) محمد(@)(@@) محمد(@)(@@) محمد(@)(@@) محمد نور الدين(@)(@@) محمد بدر الدين أبو البركات(@)(@@) الغساني: [نسبة] إلى غسان قبيلة من الأزد، وجد، وغسان رأس الغسانية من المرجئة (¬1)(@)(@@) الغساني: [نسبة] إلى غسان بن جذام بن الصدف (¬2).(@)(@@) الغشوفي: [نسبة] إلى الغسولة قرية بدمشق (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 7834 - الغسيلي(@)(@)(@@) : [نسبة] إلى حنظلة بن أبي عامر الأنصاري (¬4)، غسيل الملائكة، خرج يوم أحد فأصيب فقال - صلى الله عليه وسلم - هذا صاحبكم قد غسلته الملائكة. فسئلت عن ذلك امرأته فقالت: إنه كان معي على ما يكون عليه الرجل مع امرأته فأعجلته حينها هيعة في المسلمين عن الأغتسال فخرج فأصيب (¬5)، إليه [ينسب]:(@)(@@) • الشيخ أبو إسحق إبراهيم بن إسحاق 
