ms61	 شكر جديد % PageV01P289 البحر : وافر تام 1(@)(@@) % وقيت بي الردى زدني قيودا ، % وثن علي سوطا ، أو عمودا % % 2(@)(@@) % ووكل بي ، وبالأبواب دوني ، % من الرقباء شيطانا مريدا % % 3(@)(@@) % وأعف مسامعي من صوت رجس % ثقيل شخصه يدعى : سعيدا % % 4(@)(@@) % فقد ترك الحديد علي ريشا % وأوقر بغضه قلبي حديدا % % PageV01P290 البحر : طويل 1(@)(@@) % أربع البلى ! إن الخشوع لباد % % عليك ، وإني لم أخنك ودادي % % 2(@)(@@) % % رهينة أرواح ، وصوب غوادي % % 3(@)(@@) % و لا أدرأ الضراء عنك بحيلة % فما أنا منها قائل لسعاد % 4(@)(@@) % و إن كنت مهجور الفنا فبما رمت % يد الدهر عن قوس المنون فؤادي % % 5(@)(@@) % و إن كنت قد بدلت بؤسي بنعمة ، % فقد بدلت عيني قذى برقاد % 7(@)(@@) % من الريح ما قامت ، وإن هي أعصفت % نهوز برأس كالعلاة وهادي % % 8(@)(@@) % فكم حطمت من جندل بمفازة ، % وخاضت كتيار الفرات بواد % 9(@)(@@) % وما ذاك في جنب الأمير وزوره ، % ليعدل من عنسي مدب قراد % 10(@)(@@) % رأيت لفضل في السماحة همة ، % أطالت لعمري غيظ كل جواد % 11(@)(@@) % فتى لا تلوك الخمر شحمة ماله ، % و لكن أياد عود وبواد % PageV01P291 12(@)(@@) % ترى الناس أفواجا إلى باب داره ، % كأنهم رجلا دبى وجراد % 13(@)(@@) % فيوم لإلحاق الفقير بذي الغنى ، % ويوم رقاب بوكرت لحصاد % 14(@)(@@) % أظلت عطاياه نزارا ، وأشرفت % على حمير في دارها ومراد % 15(@)(@@) % وكنا ، إذا ما الحائن الجد غره % سنى برق غاو ، أو ضجيج رعاد % 16(@)(@@) % تردى له الفضل بن يحي بن خالد % بماضي الظبى يزهاه طول نجاد % 17(@)(@@) % أمام خميس أرجوان كأنه % % 18(@)(@@) % فما هو إلا الدهر يأتي بصرفه ، % على كل من يشقى به ويعادي % % 19(@)(@@) % سلام على الدنيا ، إذا ما فقدتم ، % بني برمك من رائحين وغاد % 20(@)(@@) % بفضل بن يحي أشرقت سبل الهدى % % و أمن ربي خوف كل بلاد % 21(@)(@@) % فدونكها يا فضل مني كريمة ، % ثنت لك عطفا بعد عز قياد % PageV01P292 22(@)(@@) % خليلية في وزنها قطربية ، % نظائرها عند الملوك عتادي % % 23(@)(@@) % وما ضرها أن لا تعد لجرول ، % ولا المزني كعب ، ولا لزياد % PageV01P293 البحر : خفيف تام 1(@)(@@) % قل لمن ساد ثم 
ms62	 ساد أبوه % قبله ، ثم قبل ذالك جده % % 2(@)(@@) % وأبو جده ، فساد إلى أن % يتلاقى نزاره ومعده % 3(@)(@@) % ثم آباؤه إلى المبتدى من % % آدم لا أب وأم تعده % 4(@)(@@) % يا ابن بحبوحة البطاح ، عبيد ا % % لله ، غوثا من مستغيث يوده % 5(@)(@@) % فاهتبل عندي النصيحة واذخر % ني لقول أجيده وأجده % 6(@)(@@) % و استزدني إلى مكارمك الغ % ر ومجد إليك خيم مجده % 7(@)(@@) % عبدري إذا انتمى ، أبطحي % تالد نسجه ، عتيق فرنده % PageV01P294 البحر : مجتث 1(@)(@@) % طاب الهوى لعميده % لولا اعتراض صدوده % 2(@)(@@) % وقادني حب ريم % مهفهف الكشح روده % 3(@)(@@) % كالبدر ليلة عشر % وأربع لسعوده % 4(@)(@@) % بدا يدل علينا ، % بمتقلتيه وجيده % % 5(@)(@@) % فاصطادني لحمامي % % تخطاره في بروده % 6(@)(@@) % فقمت نصب عدو % قاسي الفؤاد ، كنوده % 7(@)(@@) % لا أستطيع فرارا % من برقه ورعوده % 8(@)(@@) % وعسكر الحب حولي % % بخيله وجنوده % 9(@)(@@) % فإن عدلت يمينا % خشيت وقع وعوده % 10(@)(@@) % وإن شمالا ، فموت ، % لا بد لي من وروده % PageV01P295 11(@)(@@) % وإن رجعت ورائي ، % خشيت زأر اسوده % 12(@)(@@) % ونصب عيني طود ، % فكيف لي بصعوده % 13(@)(@@) % وتحت رجلي بحر % يجري الهوى بمدوده % % 14(@)(@@) % وفوق رأسي كمي ، % مقنع في حديده % 15(@)(@@) % % ليمن موسى وجوده % 16(@)(@@) % % جذار ماضي حديده % 17(@)(@@) % ولي خشوع المصلي % % في ديره يوم عيده % 18(@)(@@) % كأنني مستهام % ضل الطريق ببيده % 19(@)(@@) % لو لاح لي منه نهج ، % ركبت نهج صعيده % 20(@)(@@) % فالويل لي كيف أنجو % % من حمر موت وسوده % PageV01P296 21(@)(@@) % لا شيء إلا اشتغالي % % 22(@)(@@) % فكم شديد به قد % دفعت خوف شديده % 23(@)(@@) % لا مرة بعد أخرى ، % أكل عن تعديده % 24(@)(@@) % أيام أنف حسودي % % دام ، وأنف حسوده % 25(@)(@@) % غنى السماح بموسى % % في هزجه ونشيده % 26(@)(@@) % وكيف يهزج إلا % بإلفه وعقيده % PageV01P297 البحر : سريع 1(@)(@@) % لي صاحب أثقل من أحد ، % قرينه ما عاش في جهد % 2(@)(@@) % علامة البغض على وجهه ، % بينة مذ حل في المهد % 3(@)(@@) % لو دخل النار طفى حرها ، % فمات من فيها من البرد % PageV01P298 البحر : خفيف تام 1(@)(@@) % لا تعوجا على رسوم ديار % دارسات بذي النقا أو بغيدا % % 2(@)(@@) % قد غنينا بهن عصرا 
ms63	 طويلا ، % وأصبنا بهن ملهى وصيدا % % 3(@)(@@) % يا ابنة القوم لا تراعي بريب ، % واسلمي رخصة الأنامل رودا % % 4(@)(@@) % لا تخافي علي صرف الليالي ، % إن بيني وبينهن عبيدا % % 5(@)(@@) % إن بحيني وبينهن أبا عم % ر و كفاني عزا وكهفا وطود % % PageV01P299 البحر : هزج 1(@)(@@) % أيا من كنت بالبصر % ة أصفي لهم الودا % % 2(@)(@@) % ومن كانوا موالي ، % و من كنت لهم عبدا % % 3(@)(@@) % و من قد كنت أرعاه ، % و إن مل ، وإن صدا % % 4(@)(@@) % شربنا ماء بغداد ، % فأنساناكم جدا % % 5(@)(@@) % تبدلنا بها حورا % لألحان الغنا إدا % % 6(@)(@@) % وأبهى منكم شكلا ، % وأحلى منكم قدا % % 7(@)(@@) % فلا ترعوا لنا عهدا ، % فما نرعى لكم عهدا % % 8(@)(@@) % ولما لم يكن بد % وجدنا منكم بدا % % 9(@)(@@) % و لا تشكوا لنا فقدا ، % فما نشكو لكم فقدا % % 10(@)(@@) % كلانا واجد في النا % % س ممن مله ندا % % PageV01P300 11(@)(@@) % قطعنا حبلكم عمدا ، % كما أعرضتم صدا % % 12(@)(@@) % قطعنا بردكم بالح % % ر حتى قطع البردا % % 13(@)(@@) % كما ينهزم القرب % إذا ما عاين البعدا % % PageV01P301 البحر : متقارب تام 1(@)(@@) % ودار تؤدب فيها البزاة ، % و يمتحن الفهد والفهده % 2(@)(@@) % وصلت عراها إلى بلدة % بها نحر الذابح البلده % 3(@)(@@) % إذا اغتامها قرم المعتفين % طروقا ، غدا راهم المعده % 4(@)(@@) % ولي قفا بعد وسميه ، % فهمك من كمأة معده % % 5(@)(@@) % وصيد بأسفع شاكي السلاح % سريع الإغارة ، والشده % 6(@)(@@) % وزين ، إذا وزنته الأكف ، % منتصب الزور والقعده % 7(@)(@@) % فقلنا لسايسه : ما ترى ؟ % خفيف الخميصة واللبده % 8(@)(@@) % يقلب طرفا طحور الذى ، % يضيء بمقلته خده % 9(@)(@@) % بذي شبة ، أعرف الحوصلاء ، % كأنك رديته برده % 10(@)(@@) % فلما استحال رأى تسعة % رتاعا ، وواحدة فرده % PageV01P302 11(@)(@@) % فكفكف منتصب المنكبين ، % لفرط الشهامة والنجده % 12(@)(@@) % فشك المزمر ، أو قده % ليفعل داهية إده % 13(@)(@@) % فأنحى له في صميم القذال ، % % 14(@)(@@) % و ثنى لألافها الغابرات ، % فكمل عشرا بها العده % 15(@)(@@) % قفوا معشر الراحلين اسمعوا ، % أنبئكم عن بني كنده % 16(@)(@@) % وردنا على هاشم مصره ، % فبارت تجارتنا عنده % 17(@)(@@) % و ألهاه ذو كفل ناشيء ، % شديد الفقارة والبلده % 18(@)(@@) % سبطر يميد ، إذا ما مشى % % ترى بين رجليه 
ms64	 كالصعده % 19(@)(@@) % يجوب به الليل ذا بطنة ، % شذاك عليه من الحده % 20(@)(@@) % رأيتك عند حضور الخوان ، % شتديدا على العبتد والعبده % PageV01P303 21(@)(@@) % وتحتد حتى يخاف الجليس % شذاكظض عليه من الحده % % 22(@)(@@) % وتختم ذاك بفخر عليه ، % بكندة ، فاسلح على كنده % 23(@)(@@) % فإن حديجا له هجرة ، % و لكنها زمن الرده % 24(@)(@@) % و ما كان إيمانكم بالرسول % صوى قتلكم صهره بعده % 25(@)(@@) % تعدونها في مساعيكم ، % كعد الأهلة معتده % 26(@)(@@) % وما كان قاتله في الرجال % بحمل لطهر و لا رشده % 27(@)(@@) % فلو شهدته قريش البطاح ، % لما محشت ناركم جلده % PageV01P304 البحر : وافر تام 1(@)(@@) % أتشتم خير ذي حكم بن سعد ، % لقد لاقيت داهية نآدا % % 2(@)(@@) % سببت ابن الحديج ، فسب ظلي ، % لعمر أبيك لا استوفى وزادا % % 3(@)(@@) % و لو في غير مصر سببت ظلي % % لقلت : ابن الخبيثة كن رمادا % % PageV01P305 البحر : بسيط تام 1(@)(@@) % يا هاشم بن حديج ليس فخركم % بقتل رسول الله بالسداد % 2(@)(@@) % أدرجتم في إهاب العير جثته ، % فبئس ما قدمت أيديكم لغد % 3(@)(@@) % إن تقتلوا ابن أبي بكر ، فقد قتلت % جحرا بدارة ملحوب بنو أسد % 4(@)(@@) % وطردوكم إلى الأجبال من أجإ ، % طرد النعام إذا ما تاه في البلد % 5(@)(@@) % و قد أصاب شراحيلا أبو حنش ، % يوم الكلاب ، فما دافعتم بيد % 6(@)(@@) % و يوم قلتم لزيد ، وهو يقتلكم % قتل الكلاب : لقد أبرحت من ولد % 7(@)(@@) % و كل كندية قالت نجارتها ، % والدمع ينهل من مثنى ومن وحد : % 8(@)(@@) % ألهى امرأ القيس تشبيب بغانية % عن ثأره ، وصفات النؤي والوتد % PageV01P306 البحر : مخلع البسيط 1(@)(@@) % كل بني برمك كريم ، % أستغفر الله ، غير واحد % 2(@)(@@) % خولف في خلعة ، فوافى % % يمزج من صالح بفاسد % PageV01P307 البحر : طويل 1(@)(@@) % إذا أنت زوجت الكريمة كفوها ، % فزوج خميسا راحة ابنة ساعد % 2(@)(@@) % تعففه ما دام في الحبس ثاويا ، % وما حالفته مصمتات الحدائد % 3(@)(@@) % فإن جرت الأقدار يوما بفرقة ، % تبدل منها كل عذراء ناهد % 4(@)(@@) % و قل بالرفا ما نلت من وصل حرة ، % لها ساحة حفت بخمس ولائد % PageV01P308 البحر : كامل تام 1(@)(@@) % شغلت خداشا عن مساعي مخلد 
ms65	 ، % خمر توقد في صحاف العسجد % 2(@)(@@) % فليصبحن من الدراهم مفلسا ، % وليمسين من الندى صفر اليد % 3(@)(@@) % قد شردت أمواله فضحاته ، % ومقاله لنديمه ، هات انشد % 4(@)(@@) % ' قل للملحة في الخمار الأسود : % ماذا فعلت براهب متعبد % 5(@)(@@) % قد كان شمر للصلاة إزاره ، % حتى وقفت له بباب المسجد % 6(@)(@@) % و الخمر شاغلة ، إذا ما عوقرت ، % ياابن الزبير ، عن الندى والسؤدد % 7(@)(@@) % ما يثبت الإخوان حلية وجهه ، % مما يغيب ، فلا يرى في مشهد % 8(@)(@@) % هذا ، وليس من الخمار بعارف % سمت الطريق إلى مصلى المسجد % % PageV01P309 البحر : مجزوء الكامل 1(@)(@@) % الحمد لله العلي ، % و من له تزكو المحامد % 2(@)(@@) % أيسبني رجل علي % ه من الخزانة ألف شاهد % 3(@)(@@) % هذا أبو الهندي في % % ه مشابه من غير واحد % 4(@)(@@) % ماذا أقول لمن له % في كل عضو منه والد ! ؟ % PageV01P310 البحر : طويل 1(@)(@@) % وأخوس ، دلاج علي ، ورائح % رجاء نوال ؛ لو يعان بجود % 2(@)(@@) % وإني وإياه لقرنان ، نصطلي % % من المطل نارا غير ذات خمود % 3(@)(@@) % قطبت له وجها قطوبا عن الندى ، % و أيأسته من نائل بوعيد % 4(@)(@@) % فإن كنت لا عن سوء فعلك مقلعا ، % فدونك فاستظهر بنعل حديد % 5(@)(@@) % فعندي مطل ، لا يطير غرابه % مطير ، ولا يدعى له بوليد % PageV01P311 البحر : رجز تام 1(@)(@@) % أنعت كلبا أهله من كده % قد سعدت جدودهم بجده % 2(@)(@@) % و كل خير عندهم من عنده ، % يظل مولاه له كعبده % 3(@)(@@) % يبيت أدنى صاحب من مهده ، % وإن عري جلله ببرده % 4(@)(@@) % ذا غرة / محجلا بزنده ، % تلذ منه العين حسن قده % 5(@)(@@) % تأخير شدقيه ، وطول خده ، % تلقى الظباء عنتا من طرده % 6(@)(@@) % يشرب كأس شدها بشده ، % يصيدها عشرين في مرقه % % 7(@)(@@) % يا لك من كلب نسيج وحده % % PageV01P312 البحر : رجز تام 1(@)(@@) % أنعت ديكا من ديوك الهند ، % كريم عم وكريم جد ! % 2(@)(@@) % لنسبة ليست إلى معد ، % ولا قضاعي ولا في الأزد % 3(@)(@@) % مفتح الريش ، شديد الزند ، % صخم المخاليب ، عظيم العضد % 4(@)(@@) % حتى إذا الديك ارتأى من بعد ، % و نجمه في النحس لا في السعد % 5(@)(@@) % يقشه بالكد بعد الكد 
ms66	 ، % وتعب موصل بجهد % 5(@)(@@) % رأيته كالفارس المعد ، % يخطر خطرا مثل خطر الأسد % 6(@)(@@) % حتى ترى الديك له كالقد ، % مفكرا يعظمه بالسجد % 7(@)(@@) % يالك من ديك ربى في المهد ! % % PageV01P313 البحر : رجز تام 1(@)(@@) % لما طوى الليل حواشي برده ، % عن واضح اللون نقي ورده % 2(@)(@@) % ناديت فهادي برد فهده ، % نداء من جاد له بوده % 3(@)(@@) % فجاء يزجيه على سمنده ، % أصفر أحوى بين بين ورده % 4(@)(@@) % واحد قد في اكملال قده ، % قلت ارتدفه ، فانثنى لزنده % 5(@)(@@) % ماكان إلا نظرة من بعده ، % ونظرة أخرى بأدنى جهده % 6(@)(@@) % حتى أرانا العين دون ورده ، % مطردا يحسو بشفري عده % 7(@)(@@) % فانصاع مرقد ا على مرقده ، % كأنه حين انفرى في شده % 8(@)(@@) % وامتد للناظر في مرتده ، % كوكب عفريت هوى لعده % 9(@)(@@) % كما انطوى العاقد من ذي عقده ، % خمسين عاما بيدي معتده % 10(@)(@@) % حتى احتوى العين ، ولما يرده ، % فنحن أضياف حسامى غمده ! % PageV01P314 البحر : رجز تام 1(@)(@@) % أنعت ديكا من ديوك الهند ، % أحسن من طاووس قصر المهدي % % 2(@)(@@) % أشجع من عادي عرين الأسد ، % ترى الدجاج حوله كالجند % 3(@)(@@) % يقعين منه خيفة للسفد ، % له سقاع كدوي الرعد % 4(@)(@@) % منقاره كالمعول المحد ، % يقهر ما ناقره بالنقد % 5(@)(@@) % عيناه منه في القفا والخد ، % ذو هامة وعنق كالورد % 6(@)(@@) % وجلدة تشبه وشي البرد % ظاهرها زف شديد الوقد % 7(@)(@@) % كأنه الهداب في الفرند ، % مضمر الخلق عميم القد % 8(@)(@@) % له اعتدال وانتصاب قد ، % محدودب الظهر كريم الجد % 9(@)(@@) % مفحج الرجلين عند النجد ، % ثم وظيفان له من بعد % 10(@)(@@) % وشوكتان خصتا بالحد ، % كأنما كفاه عند الوخد % PageV01P315 11(@)(@@) % في خطوه كالمسك المرتد ، % فالقرن دوما عنده يعدي % % 12(@)(@@) % كم طائر أردى وكم ييردي % % بالجمز والقفز وصفق الجلد % 13(@)(@@) % كدا له بالخطر أي كد ، % كما يسدي الحائك المسدي % % 14(@)(@@) % إن وقف الديك ثنى بالشد ، % والوثب منه مثل وثب الفهد % 15(@)(@@) % ليس له من غلب من بد ، % فالحمد لله ولي الحمد ! ! % PageV01P316 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والليل أحوى السد ، % و الصبح في الظلماء ذو تقدي % % 2(@)(@@) % مثل اهتزاز العضب ذي 
ms67	 الفرند ، % بأهرت الشدقين ، مرمئد % 3(@)(@@) % أزبر ، مضبور القرا ، علكد ، % طاوي الحشا في طي جسم معد % 4(@)(@@) % كره الروا ، جم غضون الخد ، % دلامز ، ذي نكف مسود % 5(@)(@@) % شرنبث أغلب ، مصمعد % % 6(@)(@@) % % للشبح الحائل ، مستعد % 7(@)(@@) % عاين بعد النظر الممتد % سربين عنا بجبين صلد % 8(@)(@@) % فانقض يأدو غير مجرهد ، % في لهب عنه ، وختل إد % 9(@)(@@) % مثل انسياب الحية العربد ، % بكل نشز ، وبكل وهد % 10(@)(@@) % حتى إذا كان كها في القصد ، % صعصعها بالصحصحان الجرد % PageV01P317 11(@)(@@) % وعاث فيها بفريغ الشد % بعد شريجي طمع وحرد % 12(@)(@@) % لا خير في الصيد بغير فهد % % PageV01P318 البحر : طويل 1(@)(@@) % فقل مثل ما قالت بثينة إذ شكا % % جميل إليها الحب وهو شديد % 2(@)(@@) % إذا قلت : ما بي يا بثينة قاتلي % % من الحب ، قالت : ثابت ويزيد % PageV01P319 البحر : كامل تام 1(@)(@@) % أفنيت عمرك ، والذنوب تزيد ، % والكاتب المحصي عليك شهيد % 2(@)(@@) % كم قلت لست بعائد في سوءة ، % ونذرت فيها ثم صرت تعود % 3(@)(@@) % حتى متى لا ترعوي عن لذة ، % و حسابها يوم الحساب شديد % 4(@)(@@) % وكأنني بك قد أتتك منية ، % لا شك أن سبيلها مورود % PageV01P320 البحر : منسرح 1(@)(@@) % إن مع اليوم ، فاعلمن ، غدا % فانظر بما ينقضي مجيء غده % 2(@)(@@) % ما ارتد طرف امرىء بلذته ، % إلا وشيء يموت من جسده % PageV01P321 البحر : بسيط تام 1(@)(@@) % و قائل : هل تريد الحج ؟ قلت له : % نعم ، إذا فنيت لذات بغداذ % 2(@)(@@) % أما وقطربل منها بحيث أرى % % فقبة الفرك من أكناف كلواذ % 3(@)(@@) % فالصالحية ، فالكرخ التي جمعت % شذاذا بغداد ، ماهم لي بشذاذ % 4(@)(@@) % فكيف بالحج لي ما دمت منغمسا % في بيت قوادة أو بيت نباذ % 5(@)(@@) % وهبك من قصف بغداد تخلصني ، % كيف التخلص لي من طيزناباذ % PageV01P322 البحر : بسيط تام 1(@)(@@) % اشرب على الورد في نيسان ، مصطبحا % من خمر قطربل حمراء كالكاذي % 2(@)(@@) % واخلع عذارك ؛ لا تأتي بصالحة % ما دمت مستوطنا أكناف بغداذ % 3(@)(@@) % نعم شبابك بالخمر العتيق ، ولا % % تشرب كما يشرب الغمار من ماذي % % 4(@)(@@) % صل من صفت لك في الدنيا مودته % % و لا تصل بإخاء حبل جذاذ % 5 
ms68	(@)(@@) % يعوذ بالله إن أصبحت ذا عدم ، % وليس منك إذا تثري بمعتاذ % PageV01P323 البحر : كامل تام 1(@)(@@) % ألف المدامة ، فالزمان قصير ، % صاف عليه ، وما به تكدير % 2(@)(@@) % وله بدور الكأس كل عشية % حالان ، موت تارة ، ونشور % 3(@)(@@) % كأس من الراح العتيق ، بريحها % % قبل المذاقة في الرؤوس تسور % 4(@)(@@) % صفراء ، حمراء الترائب ، رأسها % % فيه لما نسج المزاج قتير % PageV01P324 البحر : طويل 1(@)(@@) % ألا فاسقني خمرا ، وقل لي : هي الخمر ، % ولا تسقني سرا إذا أمكن الجهر % 2(@)(@@) % فما العيش إلا سكرة بعد سكرة ، % فإن طال هذا عنده قصر الدهر % 3(@)(@@) % و ماالغبن إلا أن تراني صاحيا % % و ما الغنم إلا أن يتعتعني السكر % 4(@)(@@) % فبح باسم من تهوى ، ودعني من الكنى % % فلا خير في اللذات من دونها ستر % % 5(@)(@@) % ولا خير في فتك بدون مجانة ؛ % ولا في مجون ليس يتبعه كفر % 6(@)(@@) % بكل أخي فتك كأن جبينه % % هلال ، وقد حفت به الأنجم الزهر % 7(@)(@@) % و خمارة نبهتها بعد هجعة ، % و قد غابت الجوزاء ، وارتفع النسر % 8(@)(@@) % فقالت : من الطراق ؟ قلنا : عصابة % % خفاف الأداوى يبتغى لهم خمر % 9(@)(@@) % ولا بد أن يزنوا ، فقالت : أو الفدا % % بأبلج كالدينار في طرفه فتر % 10(@)(@@) % فقلنا لها : هاتيه ، ما إن لمثلنا % % فديناك بالأهلين عن مثل ذا صبر % PageV01P325 11(@)(@@) % فجاءت به كالبدر ليلة تمه ، % تخال به سحرا ، وليس به سحر % 12(@)(@@) % فقمنا إليه واحدا بعد واحد ، % فكان به من صوم غربتنا الفطر % 13(@)(@@) % فبتنا يرانا الله شر عصابة ، % نجرر أذيال الفسوق ولا فخر % PageV01P326 البحر : طويل 1(@)(@@) % وفتيان صدق قد صرفت مطيهم % إلى بيت خمار نزلنا به ظهرا % % 2(@)(@@) % فلما حكى الزنار : أن ليس مسلما ، % ظننا به خيرا ؛ فظن بنا شرا % % 3(@)(@@) % فقلنا : على دين المسيح بن مريم ؟ % فأعرض مزورا ، وقال لنا هجرا % % 4(@)(@@) % و لكن يهودي ، يحبك ظاهرا ، % ويضمر في المكنون منه لك الخترا % % 5(@)(@@) % فقلنا له : ما الاسم ؟ قال : سموأل ، % على أنذني أكنى بعمرو ولا عمرا % % 6(@)(@@) % و ما شرفتني كنية عربية ، % و لا أكسبتني لا سناء ولا فخرا % % 7 
ms69	(@)(@@) % و لكنها خفت ، وقلت حروفها ، % و ليست كأخرى إنما خلقت وقرا % % 8(@)(@@) % فقلنا له عجبا بظرف لسانه : % أجدت ، أبا عمرو ، فجود لنا الخمرا % % 9(@)(@@) % فأدبر كالمزور ، يقسم طرفه : % لأرجلنا شطرا ، وأوجهنا شطرا % % 10(@)(@@) % و قال : لعمري لو أحطتم بأمرنا % % للمناكم ، لكن سنوسعكم عذرا % % PageV01P327 11(@)(@@) % فجاء بها زيتية ، ذهبية ، % فلم نستطع دون السجود لها صبرا % % 12(@)(@@) % خرجنا ، على أن المقام ثلاثة ، % فطابت لنا حتى أقمنا بها شهرا % % 13(@)(@@) % عصابة سوء لا يرى الدهر مثلهم ، % و إن كنت منهم لا بريا ، ولاصفرا % % 14(@)(@@) % إذا ما دنا وقت الصلاة رأيتهم % يحثونها ، حتى تفوتهم سكرا % % PageV01P328 البحر : مجزوء الرمل 1(@)(@@) % دع لباكيها الديارا ، % وانف بالخمر الخمارا % % 2(@)(@@) % واشربنها من كميت % تدع الليل نهارا % % 3(@)(@@) % بنت عشر لم تعاين % غير نار الشمس نارا % % 4(@)(@@) % لم تزل في قعر دن ، % مشعر زفتا وقارا % % 5(@)(@@) % ثم شجت ، فأدارت % فوقها طوقا ، فدارا % % 6(@)(@@) % كاقتران الدر بالد % ر صغارا وكبارا % % 7(@)(@@) % فإذا ما اعترضته ال % % عين من حيث استدارا % % 8(@)(@@) % خلته في جنبات ال % % كأس واوات صغارا % % 9(@)(@@) % من يدي ساق ظريف ، % كسى الحسن شعارا % % 10(@)(@@) % يقتري القوم بكأس % تلبس الخمر إزارا % % PageV01P329 11(@)(@@) % فإذا ما سلسلوها ، % أحذت العين احمرارا % % 12(@)(@@) % و مغن كلما شئ % ت تغنى وأشارا % % 13(@)(@@) % رفع الصوت بصوت % هاج للقلب ادكارا % % 14(@)(@@) % ( صاح هل أبصرت بالخي % % تين من أسماء نارا ) % PageV01P330 البحر : طويل 1(@)(@@) % بكيت ، وما أبكي على دمن قفر ، % و ما بي عشق ، فأبكي من الهجر % 2(@)(@@) % و لكن حديث جاءنا عن نبينا ، % فذاك الذي أجرى دموعي على النحر % 3(@)(@@) % بتحريم شرب الخمر ، والنهي جاءنا ، % فلما نهى عنها بكيت على الخمر % 4(@)(@@) % فأشربها صرفا ، وأعلم أنني % % أعزر فيها بالثمانين في ظهري % % PageV01P331 البحر : طويل 1(@)(@@) % أعر شعرك الأطلال والدمن القفرا ، % فقد طال ما أزرى به نعتك الخمر % 2(@)(@@) % دعاني إلى نعت الطلول مسلط ، % تضيق ذراعي أن أجوز له أمرا % % 3(@)(@@) % فسمع أمير المؤمنين ، وطاعة % و إن كنت قد جشمتني مركبا وعرا % % PageV01P332 البحر : مخلع البسيط 1(@)(@@) % أعطتك ريحانها العقار 
ms70	 ، % و كان من ليلك انسفار % 2(@)(@@) % فانعم بها قبل رائعات % لا خمر فيها ، ولا خمار % 3(@)(@@) % و وقر الكأس عن سفيه ، % فإن آيينها الوقار % 4(@)(@@) % تخيرت ، والنجوم وقف % لم يتمكن بها المدار % 5(@)(@@) % فلم تزل تأكل الليالي % % جثمانها ما بها انتصار % 6(@)(@@) % حتى إذا مات كل ذام ، % و خلص السر والنجار % 7(@)(@@) % عادت إلى جوهر لطيف ، % عيان موجوده ضمار % 8(@)(@@) % كأن في كأسها سرابا ، % تخيله المهمه القفار % 9(@)(@@) % كأنها ذاك ، حين تزهى ، % لو لم يشب لونها اصفرار % 10(@)(@@) % لا ينزل الليل حيث حلت ، % فليل شرابها نهار % PageV01P333 11(@)(@@) % حتى لو استودعت سرارا % لم يخف في ضوئها السرار % 12(@)(@@) % ما أسكرتني الشمول ، لكن % مدير طرف به احورار % PageV01P334 البحر : مجزوء الرمل 1(@)(@@) % داو يحيى من خماره % بابنة الدن ، وقاره % 2(@)(@@) % من شراب خسروي ، % ما تعنوا باعتصارهء % % 3(@)(@@) % طبخته الشمس لما % % بخل العلج بناره % 4(@)(@@) % فأتى الدهر عليه % غير شيء في قراره % 5(@)(@@) % فتجلت عن شهاب ، % يترامى بشراره % 6(@)(@@) % ركد الدهر عليه ، % فكفى ضوء نهاره % 7(@)(@@) % ونديمي كل خرق ، % زانه عتق نجاره % 8(@)(@@) % و غزال تشره النف % س إلى حل إزاره % 9(@)(@@) % بسطته سورة الرا % % ح لنا بعد ازوراره % 10(@)(@@) % فأطفنا بنواحي % % ه ، ولم نعرض لداره % PageV01P335 البحر : طويل 1(@)(@@) % أدرها علينا مزة بابلية ، % تخيرها الجاني على عهد قيصرا % % 2(@)(@@) % عقأر أبوها الماء ، والكرم أمها ، % وفي كأسها تحكي الملاء المزعفرا % % 3(@)(@@) % فما الطيش إلا أن تراني صاحيا ، % و ما العيش إلا أن ألذ ، فأسكرا % % PageV01P336 البحر : وافر تام 1(@)(@@) % و خمار حططت إليه ، ليلا ، % قلائص قد ونين من السفار % 2(@)(@@) % فجمجم والكرى في مقلتيه ، % كمخمور شكا ألم الخمار % 3(@)(@@) % أبن لي كيف صرت إلى حريمي ، % و نجم الليل مكتحل بقار % 4(@)(@@) % فقلت له : ترفق بي فإني % % رأيت الصبح من خلل الديار % 5(@)(@@) % فكان جوابه أن قال : صبح ! % و لا صبح سوى ضوء العقار ! % 6(@)(@@) % وقام إلى العقار ، فسد فاها % % فعاد الليل مسود الإزار % 7(@)(@@) % فحل بزالها في قعر كأس ، % محفرة الجوانب والقرار % 8(@)(@@) % مصورة بصورة جند 
ms71	 كسرى ، % وكسرى في قرار الطرجهار % 9(@)(@@) % وجل الجند تحت ركاب كسرى ، % بأعمدة ، وأقبية قصار % PageV01P337 البحر : سريع 1(@)(@@) % آذنك الناقوس بالفجر ، % و غرد الراهب في العمر % 2(@)(@@) % و حن مخمور إلى خمرة ، % و جاءك الغيث على قدر % 3(@)(@@) % واطردت عيناك في روضة ، % تضحك عن خضر وعن صفر % 4(@)(@@) % فعاط ندمانك من خمرة ، % مزاجها من معرق القطر % 5(@)(@@) % على خزاماها ، وحوذانها % % ومشكل من حلل الزهر % 6(@)(@@) % في مسرح ترتع أكنافه % شوادن من بقر زهر % 7(@)(@@) % يا حبذا الصبحة في العمر ، % وحبذا نيسان من شهر % 8(@)(@@) % يا عاقد الزنار في الخصر ، % بحرمة الحانة والفهر % 9(@)(@@) % لا تسقني ، إن كنت بي عالما ، % إلا التي أضمرت في صدري % % 10(@)(@@) % هات التي تعرف وجدي بها ، % واكن بما شئت عن الخمر ! % PageV01P338 البحر : سريع 1(@)(@@) % الشرب في ظلة خمار ، % عندي من اللذات يا جاري % % 2(@)(@@) % لا سيما عند يهودية % حوراء ، مثل القمر الساري % % 3(@)(@@) % تسقيك من كف لها رطبة ، % كأنها فلقة جمار % 4(@)(@@) % حتى إذا السكر تمشى بها ، % صار لها صولة جبار % PageV01P339 البحر : طويل 1(@)(@@) % غدوت ، وما يشجي فؤادي خوادش % و ما وطري إلا الغواية والخمر % 2(@)(@@) % معتقة ، حمراء ، وقدتها جمر ، % ونكهتها مسك ، وطلعتها تبر % 3(@)(@@) % حططنا على خمارها ، جنح ليلة ، % فلاح لنا فجر ، ولم يطلع الفجر % 4(@)(@@) % و أبرز بكرا مزة الطعم ، قرقفا % % صنيعة دهقان ، تراخى له العمر % 5(@)(@@) % فقال : عروس كان كسرى ربيبها ، % معتقة ، من دونها الباب والستر % 6(@)(@@) % فقلت : أدل منها العنان ، فإنني % % لها كفء صدق ، ليس من شيمي العسر % 7(@)(@@) % فجاء بها شعثاء ، مشدودة القرا ، % على رأسها تاج ، ملاحفها عفر % 8(@)(@@) % فلما توجى خصرها فاح ريحها % % فقلت : أذا عطر ؟ فقال : هو العطر % 9(@)(@@) % وأرسلتها في الكأس راحا كريمة ، % تعطر بالريحان ، أحكمها الدهر % 10(@)(@@) % كأن الزجاج البيض منها عرائس ، % عليهن بين الشرب أردية حمر % PageV01P340 11(@)(@@) % إذا قهرت بالماء ، راق شعاعها % % عيون الندامى ، واستمر بها الأمر % 12(@)(@@) % وضاء من الحلي المضاعف فوقها % % بدور ، ومرجان تألفه الشذر % 13(@)(@@) % كأن نجوم الليل فيها رواكد ؛ % أقمن على التأليف ، آنسها 
ms72	 البدر % 14(@)(@@) % وصلت بها يوما بليل وصلته % بأول يوم ، كان آخره السكر % 15(@)(@@) % وظبي ، خلوب اللفظ ، حلو لوجهه ، % وأمكن منه ما تحيط به الأزر % 16(@)(@@) % فقمت إليه ، والكرى كحل عينه ، % فقبلته ، والصب ليس له صبر % 17(@)(@@) % وقبلته ظهرا لبطن ، وتارة % يكون بساط الأرض بالباطن الظهر % 18(@)(@@) % إلى أن تجلى نومه عن جفونه ، % وقال : كسبت الذنب ! قلت : لي العذر % 19(@)(@@) % فأعرض مزورا ، فكان بوجهه % تفقؤ رمان ، وقد برد الصدر % 20(@)(@@) % فما زلت أرقيه ، وألثم خده % إلى أن تغنى راضيا وله الشكر : % PageV01P341 البحر : كامل تام 1(@)(@@) % عتبت عليك محاسن الخمر ، % أم غيرتك نوائب الدهر ؟ % 2(@)(@@) % فصرفت وجهك عن معتقة ، % تفتر عن در وعن شذر % 3(@)(@@) % يسعى بها ذو غنة غنج ، % متكحل اللحظات بالسحر % 4(@)(@@) % و نسيت قولك ، حين تمزجها ، % فتريك مثل كواكب النسر % 5(@)(@@) % لا تحسبن عقار خابية % و الهم يجتمعان في صدر % PageV01P342 البحر : مجزوء الرمل 1(@)(@@) % قلت لما وضح الصب % ح ؛ فأورى واستنارا % % 2(@)(@@) % وتولى تابع النج % م إلى الأفق فغارا % % 3(@)(@@) % و رأيت الديك قد صا % % ح لدى الصبح مرارا % % 4(@)(@@) % لأبي بشر خليلي % % أينما ولى ، وسارا % % 5(@)(@@) % هذه الخمر ! جهارا % فاشربنها ، لا سرارا % % 6(@)(@@) % لا كمن يكني عن الأم % ر إذا ما خاف عارا % % 7(@)(@@) % واشربنها مزة ، تذ % هب بالهم ، عقارا % % 8(@)(@@) % تترك المرء إذا ما % % ذاقها يرخي الإزارا % % 9(@)(@@) % ويرى الجمعة كالسب % ت ، وكالليل النهارا % % 10(@)(@@) % واتركن من لام فيها ، % وأبى إلا نفارا % % PageV01P343 11(@)(@@) % يشرب الماء مكان ال % % راح رغما وصغارا % % 12(@)(@@) % واصرفنها عن أبي أي % وب ، إذ تاه فخارا % % 13(@)(@@) % باع راحا بنبيذ ، % هكذا بيعا خسارا % % 14(@)(@@) % مثل مبتاع بطرف % سبق الخيل حمارا % % PageV01P344 البحر : طويل 1(@)(@@) % وأحور ، ذمي ، طرقت فناء ه ، % بفتيان صدق ، ما ترى منهم نكرا % % 2(@)(@@) % فلما قرعنا بابه هب خائفا ، % و بادر نحو الباب ، ممتلئا ذعرا % % 3(@)(@@) % وقال : من الطراق ليلا فناءنا ؟ % فقلت له : افتح ! فتية طلبوا خمرا % % 4(@)(@@) % فأطلق عن أبوابه غير هائب ، % وأطلع من أزراره قمرا بدرا % % 5(@)(@@) % ومر أمام القوم ، يسحب 
ms73	 ذيله % يجاذب منه الردف في مشيه الخصرا % % 6(@)(@@) % فقلت له : ما الاسم حييت ؟ قال لي : % دعاني أبي سابا ولقبني شمرا % % 7(@)(@@) % فكدنا جميعا من حلاوة لفظه % نجن ، ولم نسطع لمنطقه صبرا % % 8(@)(@@) % فقلت له : جئناك نبتاع قهوة % معتقة ، قد أنفدت ، قدما ، دهرا % % 9(@)(@@) % فقال : اربعوا عندي التي تطلبونها ، % قد احتجبت في خدرها حقبا عشرا % % 10(@)(@@) % فقلت : فماذا مهرها ؟ قال : مهرها % % إليك ، فسقنا نحوه خمسة صفرا % % PageV01P345 11(@)(@@) % فقلت له : خذها ، وهات نعاطها ، % فقام إليها قد تملى بنا بشرا % % 12(@)(@@) % فشك بإشفاء له بطن مسند ، % فسالت تحاكي في تلألؤها البدرا % % 13(@)(@@) % وجاء بها ، والليل ملق سدوله ، % مدلا بأن وافى ، محيطا بها خبرا % % 14(@)(@@) % ربيبة خدر راضها الخدر أعصرا % فكانت له قلبا ، وكان لها صدرا % % 15(@)(@@) % إذا أخذتها الكأس كادت بريحها % % تخال بها عطرا وما إن ترى عطرا % % 16(@)(@@) % ومازال يسقينا ، ويشرب دائبا % إلى أن تغنى حين مالت به سكرا % % 17(@)(@@) % ( فما ظبية ترعى مساقط روضة % كسا الواكف الغادي لها ورقا خضرا % % 18(@)(@@) % بأحسن منه منظرا زان مخبرا ، % بل الظبي منه شابه الجيد والنحرا % % 19(@)(@@) % فيا حسنه لحنا بدا من لسانه ، % و يا حسنه لحظا ! ويا حسنه ثغرا ! % 20(@)(@@) % ونام ، وما يدري أأرض وساده ، % توسد سكرا ، أم وسادا رأى جهرا % % PageV01P346 21(@)(@@) % فقمنا إليه حين نام ، وأرعدت % فرائصه تجري بميدانه ضمرا % % 22(@)(@@) % فلما رأى أن ليس عن ذاك مخلص ، % ووافقه لين أجاد لنا العصرا % % PageV01P347 البحر : طويل 1(@)(@@) % نداماي طول الدهر خرس عن الخنا % % وعمي عن العوراء نزه عن الكبر % 2(@)(@@) % إذا نزفوا زقا أقمت مكانه % % من الشاصيات السود محزوزة الظهر % 3(@)(@@) % تكن رحيقا من مدامة عانة ، % إذا هي فاحت أجلت الهم عن صدري % % 4(@)(@@) % ويبدي لنا من جوفها مس مزجها % % كألسنة الحيات تبدو من الذعر % 5(@)(@@) % لدينا أباريق ، كأن رقابها % % رقاب كراكي نظرن إلى صقر % 6(@)(@@) % منصبة قد قدمتها سقاتنا % % وريحاننا شم الخدود إلى النحر % PageV01P348 البحر : طويل 1(@)(@@) % غدوت على اللذات منهتك الستر ، % وأفضت بنات السر إلى الجهر % 2(@)(@@) % وهان علي الناس ، فيما أريده 
ms74	 % بما جئت ، فا ستنغنيت عن طلب العذر % 3(@)(@@) % رأيت الليالي مرصدات لمدتي ، % فبادرت لذاتي مبادرة الدهر % 4(@)(@@) % رضيت من الدنيا بكأس وشادن ، % تحير في تفضيله فطن الفكر % 5(@)(@@) % مدام ربت في حجرنوح ، يديرها % % علي ثقيل الردف ، مضطمر الخصر % 6(@)(@@) % صحيح مريض الجفن مدن مباعد % يميت ويحيي بالوصال وبالهجر % 7(@)(@@) % كأن ضياء الشمس نيط بوجهه ، % وبدر الدجى بين الترائب والنحر % 8(@)(@@) % إذا ما بدت أزرار جيب قميصه % تطلع منها صورة القمر البدر % 9(@)(@@) % فأحسن من ركض إلى حومة الوغى % % و أحسن عندي من خروج النحر % 10(@)(@@) % فلا خير في قوم تدور عليهم % كؤوس المنايا بالمثقفة السمر % PageV01P349 11(@)(@@) % تحياتهم في كل يوم وليلة % ظبى المشرفيات المزيرة للقبر % PageV01P350 البحر : مجزوء الرمل 1(@)(@@) % بادر الكأس نهارا ، % واشرب الراح العقارا % % 2(@)(@@) % واسقنيها مثلما تش % ربها كيلا عيارا % % 3(@)(@@) % خندريسا ، تنفح المس % ك ، وتحكي الجلنارا % % 4(@)(@@) % فإذا أكثرت فيها ال % ماء زادتك خمارا % % 5(@)(@@) % فامض في اللذات قدما % و اخلعن فيها العذارا % % 6(@)(@@) % واجعل البستان بيتا ، % واجعل الفرية دارا % % 7(@)(@@) % وأطر فيها حماما ، % وارتبط فيها المهارى % % 8(@)(@@) % وإذا كان قطاف % وتوقعت العصارا % % 9(@)(@@) % فاطبخ الراح بشمس ، % فكفى بالشمس نارا % % PageV01P351 البحر : بسيط تام 1(@)(@@) % لو كان لي سكن في الراح يسعدني ، % لما انتظرت بشرب الراح إفطارا % % 2(@)(@@) % الراح شيء عجيب أنت شاربها ، % فاشرب ، وإن حملتك الراح أوزارا % % 3(@)(@@) % يامن يلوم على حمراء صافية % صرفي في الجنان ، ودعني أسكن النارا % % PageV01P352 البحر : طويل 1(@)(@@) % لنا هجمة لا يدرك الذئب سخلها ، % ولا راعها نزو الفحالة والخطر % 2(@)(@@) % إذا امتحنت ألوانها مال صفوها % % إلى الجو ، إلا أن أوبارها خضر % 3(@)(@@) % فإن قام فيها الحالبون اتقتهم % بنجلاء ثقب الجوف ، درتها الخمر % 4(@)(@@) % مسارحها الغربي من نهر صرصر ، % فقطربل ، فالصالحية ، فالعقر % 5(@)(@@) % تراث أنو شروان كسرى ، ولم تكن % مواريث ما أبقت تميم ولا بكر % 6(@)(@@) % قصرت بها ليلي ، وليل ابن حرة ، % له حسب زاك ، وليس له وفر % PageV01P353 البحر : بسيط تام 1(@)(@@) % لما أتوني بكأس من شرابهم ، % يدعى الطلاء ، صليبا ، غير خوار % 2(@)(@@) % أظهرت 
ms75	 نسكا ، وقلت : الخمر أشربها ! % والله يعلم أن الخمر إضماري % % 3(@)(@@) % آلى زعيمهم بالنار قد طبخت ، % يريد مدحتها بالشين والعار % 4(@)(@@) % فقلت من ذا الذي بالنارعذبها ، % لا خفف الله عنه كربة النار % PageV01P354 البحر : طويل 1(@)(@@) % ألا فاسقني مسكية العرف ، مزة % على نرجس ، تعطيك أنفاسه الخمر % 2(@)(@@) % عيون ، إذا عاينتها ، فكأنما % % دموع الندى من فوق أجفانها در % 3(@)(@@) % مناصبها بيض ، وأجفانها خضر ، % وأحداقها صفر ، وأنفاسها عطر % 4(@)(@@) % بروضة بستان كأن نباتها % % تقنع وشيا حين باكرها القطر % 5(@)(@@) % يدير علينا الشمس ، والبدر حولها ، % فيا من رأى شمسا يدور بها بدر ! % PageV01P355 البحر : بسيط تام 1(@)(@@) % يا حبذا مجلس قد كان يجمعنا % % بطيزناباذا في بستان عمار % 2(@)(@@) % وحبذا أم عمار ، ورؤيتها ، % خمارة أصبحت أما لخمار % 3(@)(@@) % تعلنا بمدام قد تناولها % % ريب الزمان ، وعصر بعد أعصار % 4(@)(@@) % أنت زمانا ، كما أن المريض ، وما % % تشفى ؛ فدافع عنها الخالق الباري % % 5(@)(@@) % فلم تزل حقب الأيام تنقصها ، % حتى اختبا عشرها في دنها الضاري % % 6(@)(@@) % كأنما شربت من نفسها جرعا ، % فازداد من لونها في باطن القار % 7(@)(@@) % لم تخط من خدرها شبرا إلى أحد ، % ولم تزل بين جنات وأنهار % PageV01P356 البحر : خفيف تام 1(@)(@@) % يا خليلي قد خلعت عذاري ، % وبدا ما أكن من أسراري % % 2(@)(@@) % فاشربا الخمر ، واسقياني سلافا ، % عتقت بين نرجس وبهار % 3(@)(@@) % لبثت في دنانها ألف شهر ، % لم تقمص ، ولم تعذب بنار % 4(@)(@@) % نسج العنكبوت بيتا عليها ، % فعلى دنها دقاق الغبار % 5(@)(@@) % فأتى خاطب مليح إليها ، % ذو وشاح ، مؤزر بإزار % 6(@)(@@) % نقد المهر ، ثم وجاها ، % فجرت كالعقيق والجلنار % 7(@)(@@) % في أباريق ، من لجين حسان ، % كظباء سكن عرض القفار % 8(@)(@@) % أو كراك ذعرن من صوت صقر % مفزعات ، شواخص الأبصار % 9(@)(@@) % قد تحسيتها على وجه ساق % خالع في هواي كل عذار % 10(@)(@@) % قمر يقمر الديباجي بوجه ، % ضوؤه في الدجى صباح النهار % PageV01P357 11(@)(@@) % يتثنى كأنه غصن بان ، % ميلته الر ياح بالأسحار % 12(@)(@@) % بأبي ذاك من غزال غرير ، % في قباء محلل الأزرار % 13(@)(@@) % كم شممنا من خده الورد غضا % ومزجنا رضابه بعقار ! % PageV01P358 البحر 
ms76	 : طويل 1(@)(@@) % لئن رحت مبيض الذوائب من شعري ، % وأبدلني دهري غرابي بالنسر % 2(@)(@@) % فيا رب خمار طرقت بسحرة % فنبهته ، والطير في كنف الوكر % 3(@)(@@) % أقمنا به نعطي البطالة حقها ، % إذا لم ينل لذاتها الرجل المثري % % 4(@)(@@) % وذي غيد قد صادنا منه ، إذ بدا ، % محاسن مابين الجبين إلى النحر % 5(@)(@@) % رميناه بالأبصار من كل جانب ، % فراح ، وقد نلناه بالنظر الشزر % PageV01P359 البحر : رمل تام 1(@)(@@) % ونديم لم يزل ساقينا ، % و على الصبح من الليل إزار % 2(@)(@@) % فاحتسى حتى تولى ليله ، % فكساه الصبح ثوبا ما يعار % 3(@)(@@) % فتغشاه كراه ، فهذى % % ساعة ، ثم تغشاه الخمار % 4(@)(@@) % فاستوى كالصقر من رقدته % ينفض الرأس ، وما فيه غبار % PageV01P360 البحر : وافر تام 1(@)(@@) % لئن هجرتك ، بعد الوصل ، أروى ، % فلم تهجرك صافية عقار % 2(@)(@@) % فخذها من بنات الكرم ، صرفا ، % كعين الديك يعلوها احمرار % 3(@)(@@) % شرابا ، إن تزاوجه بماء % تولد منهما درر كبار % 4(@)(@@) % طبيخ الشمس ، لم تطبخه قدر % بماء ، لا ولم تلذعه نار % 5(@)(@@) % على أمثالها كانت لكسرى % % أنوشروان تتجر التجار % 6(@)(@@) % إذا المخمور باكرها ثلاثا ، % تطاير عن مفاصله الخمار % 7(@)(@@) % وهات فغنني بيتي نصيب ، % فقد وافاني القدح المدار : % 8(@)(@@) % ' ولولا أن يقال صبا نصيب ، % لقلت بنفسي النشء الصغار ' % 9(@)(@@) % ( بنفسي كل مهضوم حشاها ، % إذا ظلمت ، فليس لها انتصار ) % PageV01P361 البحر : سريع 1(@)(@@) % لم يبق لي في غيرها لذة ، % كرخية في الكأس كالنار % 2(@)(@@) % نكهتها أطيب من فارة ، % مملوءة مسكا لعطار % PageV01P362 البحر : منسرح 1(@)(@@) % أحسن من منزل بذي قار % منزل خمارة بالأنبار % 2(@)(@@) % وشم ريحانة ، ونرجسة % أحسن من أينق بأكوار % 3(@)(@@) % و عشرة للقيان ، في دعة % مع رشإ عاقد لزنار % 4(@)(@@) % ألذ من مهمة أكد به ، % ومن سراب أجوب ، غرار % 5(@)(@@) % ونقر عود ، إذا ترجعه % بنان رود الشباب ، معطار % 6(@)(@@) % أحسن عندي من أم ناجية ، % وأم عمرو ، وأم عمار % PageV01P363 البحر : بسيط تام 1(@)(@@) % إن لا تزوري ، فإن الطيف قد زارا ، % وقد قضيت لبانات وأوطارا % % 2(@)(@@) % قال : لقد بعد المسرى ، فقلت لها : % من عالج الشوق لا يستبعد الدارا % % 3(@)(@@) % قالت : كذبت 
ms77	 على طيفي ! فقلت لها : % إذن فعاديت ، يامكنون ، خمارا % % 4(@)(@@) % ولانقلت إلى حانوته قدما ، % ولا نبذت إليه النقد ، فاختارا % % 5(@)(@@) % ولا رأى شفة منه على شفتي ، % إطباق عينيك بالأشفار أشفارا % % 6(@)(@@) % قالت : حلفت يمينا لا كفاء لها ، % أما تخاف وعيد الله والنارا ؟ ! % PageV01P364 البحر : مجزوء الرمل 1(@)(@@) % منع الصوم العقارا % % وزوى اللهو ، فغارا % % 2(@)(@@) % و بقينا في سجون ال % % صوم للهم أسارى % % 3(@)(@@) % غير أنا سنداري % % فيه من ليس يدارى % % 4(@)(@@) % نشرب الليل إلى الصب % ح صغارا وكبارا % % 5(@)(@@) % ونغني ما اشتهينا % % ه من الشعر جهارا % % 6(@)(@@) % اسقني حتى تراني % % أحسب الديك حمارا % % PageV01P365 البحر : كامل تام 1(@)(@@) % غضبت عليك ذخيرة الخمار % لما بها شببت في الأشعار % 2(@)(@@) % قالت : يشبهني بنار أججت ، % تخبو إذا نضحت بماء جار % 3(@)(@@) % وأنا التي أزداد حسنا كلما % % لاح المزاج ككوكب الأسحار % 4(@)(@@) % فلئن لججت لأحرمنك درتي % % حتى تجرع قهوة التمار % PageV01P366 البحر : منسرح 1(@)(@@) % ياعارم الطرف ! حيثما نظر % أثر فيه ، وإن رأى حجرا % % 2(@)(@@) % مالقي العالمون منك ومن % طرفك ما إن يعد من قبرا % % 3(@)(@@) % أبوك بدر تلوح غرته ، % وأمك الشمس أنتجا قمرا % % 4(@)(@@) % فهل على من قتلت من حرج ، % أم لست تدري ، فتخبر الخبرا % % 5(@)(@@) % عليك أوزار من قتلت بلا % % شك ، فكن للحساب منتظرا % % 6(@)(@@) % وصاحب أطلقته رقدته % عن غير سكر ؛ فهب معتذرا % % 7(@)(@@) % نازعته الكأس ما أفتره ، % كأس مدام ترى لها شررا % % 8(@)(@@) % مثل دم الشادن الذبيح ، إذا % % ما انساب منه علأرض أو قطرا % % 9(@)(@@) % رقت عن اللمس ، فهي كالقمر ال % % طالع في الماء فات من نظرا % % 10(@)(@@) % تقول خمر ؛ فحين تحدرها % % من فم إبريقها ، إذا انحدرا % % PageV01P367 11(@)(@@) % قلت شعاع ؛ فكيف أشربها ، % لو كان خمرا لأبرزت كدرا % % 12(@)(@@) % حتى إذا ذقتها خررت لها ، % بعد مجال الظنون ، منعفرا % % PageV01P368 البحر : كامل تام 1(@)(@@) % قل للعذول بحانة الخمار ، % و الشرب عند فصاحة الأوتار : % 2(@)(@@) % إني قصدت إلى فقيه عالم % متنسك ، حبر من الأحبار % 3(@)(@@) % متعمق في دينه متفقه ، % متبصر في العلم والأخبار % 4(@)(@@) % قلت : النبيذ تحله ؟ فأجاب : لا % % إلا 
ms78	 عقارا ترتمي بشرار % 5(@)(@@) % قلت : الصلاة ؟ فقال : فرض واجب ، % صل الصلاة ، وبت حليف عقار % 6(@)(@@) % اجمع عليك صلاة حول كامل % من فرض ليل ، فاقضيه بنهار % 7(@)(@@) % قلت : الصيام ؟ فقال لي : لاتنوه % واشدد عرى الإفطار بالإفطار % 8(@)(@@) % قلت : التصدق والزكاة ؟ فقال لي : % شيء يعد لآ لة الشطار % 9(@)(@@) % قلت : المناسك إن حججت ؟ فقال لي : % هذا الفضول ، وغاية الإدبار % 10(@)(@@) % لا تأتين بلاد مكة محرما ، % ولو ان مكة عند باب الدار % PageV01P369 11(@)(@@) % قلت : الطغاة ؟ فقال لي : لاتغزهم % ولو انهم قربوا من الأنبار % 12(@)(@@) % سالمهم واقتص من أولادهم % إن كنت ذا حنق على الكفار % 13(@)(@@) % واطعن برمحك بطن تلك وظهر ذا % % هذا الجهاد ، فنعم عقبى الدار % 14(@)(@@) % قلت : الأمانة هل ترد ؟ فقال لي : % لا تردد القطمير من قنطار % 15(@)(@@) % لاهم إلا أن تكون مضمنا % دينا لصاحب حانة خمار % 16(@)(@@) % فاردد أمانته عليه ، ودينه % واحتل لذاك ، ولو ببيع إزار % 17(@)(@@) % قلت : اعتزمت ، فما ترى في عازب % متغرب ، متقارب الأسفار ؟ ! % 18(@)(@@) % فأجابني : لك أن تلذ بزنية % من جارة ، وتلوط بابن الجار % 19(@)(@@) % ودنا إلي وقال : نصحك واجب % زين خصالك هذه بقمار ! % PageV01P370 البحر : هزج 1(@)(@@) % أنا ، والله ، مشتاق % إلى الحيرة ، والخمر % 2(@)(@@) % وأصوات النواقيس % على الزيرات بالفجر % 3(@)(@@) % و مشتاق إلى الحانا % % ت يوم الذبح والنحر % 4(@)(@@) % ومفن في طلاب المر % د والخمر معا وفري % % 5(@)(@@) % أما والله لو تسم % ع ماقلت من الشعر % 6(@)(@@) % لآيست من افلاحي ، % يقينا آخر العمر % PageV01P371 البحر : مجزوء الكامل 1(@)(@@) % دع عنك يا صاح الفكر % فيمن تغير أو هجر % 2(@)(@@) % واشرب كميتا مزة ، % عنست ، وأقعدها الكبر % 3(@)(@@) % من كف ظبي ناعم ، % عنج ، بمقلته حور % 4(@)(@@) % يسبي القلوب بدله ، % و الطرف منه إذا نظر % 5(@)(@@) % فكأنها في كفه % شمس ، وراحته قمر % 6(@)(@@) % لم يصطبح منها الندي % % م ثلاثة إلا سكر % 7(@)(@@) % طربا ، وغنى معلنا % و الطرف منه قد نكر : % 8(@)(@@) % يا من أضر به السهر % عندي من الحب الخبر % PageV01P372 البحر : منسرح 1(@)(@@) % وقهوة كالعقيق ، صافية % يطير من كأسها لها شرر % 2(@)(@@) % زوجتها 
ms79	 الماء كي تذل له ، % فامتعضت حين مسها الذكر ! % 3(@)(@@) % كذالك البكر عند خلوتها ، % يظهر منها الحياء والخفر % PageV01P373 البحر : طويل 1(@)(@@) % طربت إلى خمر ، وقصف الدساكر ، % و منزل دهقان بها غيردائر % 2(@)(@@) % بفتيان صدق من سراة ابن مالك % وأزد عمان ذي العلى والمفاخر % 3(@)(@@) % فلما حللناها نزلنا بأشمط ، % كريم المحيا ، ظاهر الشرك ، كافر % 4(@)(@@) % له دين قسيس ، وتدبير كاتب ، % وإطراق جبار ، وألفاظ شاعر % 5(@)(@@) % فحيا وبيا ، ثم قال لنا : اربعوا ! % نزلتم بنا رحبا بأيمن طائر % 6(@)(@@) % فقلنا له : إن المدام غذاؤنا % % وإنا أولو عقل ، وأهل بصائر ! % 7(@)(@@) % فجاء بها قد أنهك الغمو جسمها ، % وأوجعها في الصيف حر الهواجر % 8(@)(@@) % فقلت لها لما أضاء سناؤها % % على صحن كأس قد علا الكف زاهر : % 9(@)(@@) % أبيني لنا يا خمر ! كم لك حجة ؟ % فقالت : لحاك الله ! لست بذاكر % 10(@)(@@) % شهدت ثمودا حين حل بها البلى ، % وأدركت أياما لعمروبن عامر ! % PageV01P374 11(@)(@@) % فقلنا : أنسقاها على وجه أهيف % له تيه معشوق وشخرة شاطر ؟ ! % 12(@)(@@) % فما زال هذا دأبنا وغذاءنا ، % ثلاثين يوما مع ليال غوابر % 13(@)(@@) % ترى عندنا ما يكره الله كله ، % سوى الشرك بالرحمن ، رب المشاعر % PageV01P375 البحر : طويل 1(@)(@@) % سقى الله ظبيا مبدي الغنج في الخطر % يميس كغصن البان من رقة الخصر % 2(@)(@@) % بعينيه سحر ظاهر في جفونه ، % وفي نشره طيب كفائحة العطر % 3(@)(@@) % هو البدر ، إلا أن فيه ملاحة % بتفتير لحظ ليس للشمس والبدر % 4(@)(@@) % ويضحك عن ثغر مليح كأنه % حباب عقار ، أو نقي من الدر % 5(@)(@@) % جفاني بلا جرم إليه اجترمته ، % و خلفني نضوا خليا من الصبر % 6(@)(@@) % ولوبات ، والهجران يصدع قلبه ، % لجاد بوصل دائم آخر الدهر % 7(@)(@@) % مخافة أن يبلى بهجر وفرقة ، % فيلقى من الهجران جمرا على جمر % 8(@)(@@) % سقى الله أياما ، ولا هجر بيننا ، % وعود الصبا يهتز بالورق النضر % 9(@)(@@) % يباكرنا النوروز في غلس الدجى % % بنور على الأغصان كالأنجم الزهر % 10(@)(@@) % يلوح كأعلام المطارف وشيه % من الصفر فوق البيض والخضر والحمر % PageV01P376 11(@)(@@) % إذا قابلته الريح أو ما برأسه % إلى الشرب أن سروا ، ومال إلى 
ms80	 السكر % 12(@)(@@) % و مسمعة جاءت بأخرس ناطق ، % بغير لسان ظل ينطق بالسحر % 13(@)(@@) % لتبدي سر العاشقين بصوته ، % كما تنطق الأقدام تجهر بالسر % 14(@)(@@) % ترى فخذ الألواح فيها كأنها % % إلى قدم نيطت تضج إلى الزمر % 15(@)(@@) % أصابعها مخضوبة ، وهي خمسة ، % تختمن بالأوتار في العسر واليسر % 16(@)(@@) % إذا لحقت يوما لوي اصبع لها ، % فتحكي أنين الصب من حرقة الهجر % 17(@)(@@) % تقول ، وقد دبت عقار كأنها % % دم ودموع فوق خد ، إذا تجري : % 18(@)(@@) % سلام على شخص ، إذا ما ذكرته % حذرت من الواشين أن يهتكوا سري % % 19(@)(@@) % فبغض الندامى في سرور وغبطة ، % وبعض الندامى للمدامة في أسر % 20(@)(@@) % وبعض بكى بعضا ، ففاضت دموعه % % على الخد كالمرجان سال إلى النحر % PageV01P377 21(@)(@@) % فساعدتهم علما بما يورث الهوى ، % وأن جنون الحب يولع بالحر % 22(@)(@@) % فسقيا لأيام مضت ، وهي غضة ، % ألا ليتها عادت ودامت إلى الحشر % PageV01P378 البحر : خفيف تام 1(@)(@@) % صاح ، مالي وللرسوم القفار ، % و لنعت المطي والأكوار % 2(@)(@@) % شغلتني المدام ، والقصف عنها ، % و قراع الطنبور والأوتار % 3(@)(@@) % واستماعي الغناء من كل خود ، % ذات دل بطرفها السحار % 4(@)(@@) % فدعوني فذاك أشهى ، وأحلى % % من سؤال التراب والأحجار % PageV01P379 البحر : منسرح 1(@)(@@) % قل لأبي مالك فتى مضر % مقال لا مفحم ، ولا حصر : % 2(@)(@@) % جئناك في ميت تكفنه ، % ليس من الجن ، لا ولا البشر % 3(@)(@@) % لكن ميتا عظامه خزف ، % واللحم قار ، والروح من عكر % 4(@)(@@) % ليس لنا ما به نكفنه ، % فكفن الميت يا أخا مضر % 5(@)(@@) % واعجل فقد مات فاعلمن ضحى % ونحن من موته على حذر % 6(@)(@@) % يا لك ميتا ، صلاة شيعته % عزف عليه ، والنقر بالوتر % PageV01P380 البحر : بسيط تام 1(@)(@@) % لولا الأمير ، وأن العذر منقصة ، % و العار بالعذر عندي أقبح العار % 2(@)(@@) % جاءت بخاتمتها من عند خمار ، % روح من الكرم في جسم من القار % 3(@)(@@) % فالريح ريح ذكي الأذفر الداري ، % و البرد برد الندى ، واللون للنار % 4(@)(@@) % ما تختطي مجلسا مما تمر به % إلا تلوها بأسماع ، وأبصار % 5(@)(@@) % والزق يرميهم عما تضمنه % رميا يصيب به من غير أوتار % 6(@)(@@) % حتى إذا حازها 