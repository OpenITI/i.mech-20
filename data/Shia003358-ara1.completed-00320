ms301	 ابن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2476 - كتاب الرد على الجبائي في التفسير للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة *(@)(@@)(@@)(@@) $ 2477 - كتاب الرد على الخالدي في الإمامة للشيخ المفيد محمد ابن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2478 - كتاب الرد على الذاهب إلي تكفير أبي طالب للسيد شمس الدين فخار بن معد بن فخار الموسوي المتوفى سنة ثلاثين وستمائة * PageV00P441(@)(@@)(@@)(@@) $ 2479 - كتاب الرد على الرافضة للحسين بن علي بن سفيان البزوفري * (@)(@@)(@@)(@@) $ 2480 - كتاب الرد على الرافضة للشيخ أبي عبد الله الحسين ابن علي بن الحسين بن موسى بن بابويه القمي عمله للصاحب ابن عباد * (@)(@@)(@@)(@@) $ 2481 - كتاب الرد على الزنادقة لهشام بن الحكم * (@)(@@)(@@)(@@) $ 2482 - كتاب الرد على العتيقي في الشورى للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2483 - كتاب الرد على الغلاة والمفوضة لأبي عبد الله الحسين ابن عبد الله الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2484 - كتاب الرد على الغلاة لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2485 - كتاب الرد على الغالية وأبي الخطاب وأصحابه لإبراهيم ابن أبي حفص اسحق الكاتب كان من أصحاب أبي محمد الحسن ابن علي العسكري عليهما السلام * (@)(@@)(@@)(@@) $ 2486 - كتاب الرد على الفلاسفة لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2487 - كتاب الرد على القرامطة لمحمد بن يعقوب بن إسحاق الكليني المتوفى سنة ثمان وعشرين وثلاثمائة * (@)(@@)(@@)(@@) $ 2488 - كتاب الرد على الكرابيسي في الإمامة للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2489 - كتاب الرد على من قال بامامة المفضول لهشام بن الحكم * (@)(@@)(@@)(@@) $ 2490 - كتاب الرد على المرجئة لفضل بن شاذان النيسابوري * PageV00P442(@)(@@)(@@)(@@) $ 2491 - كتاب الرد على المثلثة لفضل بن شاذان النيسابوري(@)(@@)(@@)(@@) $ 2492 - كتاب الرد على المعتزلة في امامة المفضول لمحمد ابن النعمان الملقب بمؤمن الطاق * (@)(@@)(@@)(@@) $ 2493 - كتاب الرد على المعتزلة في أمر طلحة والزبير لهشام ابن الحكم * (@)(@@)(@@)(@@) $ 2494 - كتاب الرد لنصر بن مزاحم بالزاي المعجمة المنقري بالنون قبل القاف * (@)(@@)(@@)(@@) $ 2495 
ms302	 - كتاب الرويا لمحمد بن مسعود بن محمد بن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2496 - كتاب الزهد والتقوى للشيخ الامام عماد الدين أبي جعفر محمد بن أبي القاسم بن محمد بن علي الطبري الآملي الكجي * (@)(@@)(@@)(@@) $ 2497 - كتاب الزهد لكل واحد من الأئمة عليهم السلام للشيخ الصدوق محمد بن علي بن الحسين بن علي بن موسى بن بابويه القمي المتوفى سنة إحدى وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2498 - كتاب الزهد لمعمر بضم الميم والعين وتشديد الميم الثانية ابن خلاد بالخاء المعجمة وتشديد اللام ابن أبي خلاد بتشديد اللام أيضا * (@)(@@)(@@)(@@) $ 2499 - كتاب الزهد للحسين بن سعيد بن حماد بن سعيد ابن مهران من موالي علي بن الحسين الثاني وأبي الحسن الثالث عليهم السلام الأهوازي *(@)(@@)(@@)(@@) $ 2500 - كتاب زيارة الرضا عليه السلام وفضله ومعجزاته نحوا من مأتي ورقة لأبي الطيب الرازي * PageV00P443(@)(@@)(@@)(@@) $ 2501 - كتاب زيد الزراد بفتح الزاي وتشديد الراء واهمال الدال النبرسي بالنون المفتوحة والمهملتين كوفي روى عن أبي عبد الله عليه السلام قال النجاشي له كتاب أخبرنا محمد بن محمد قال حدثنا جعفر بن محمد قال حدثنا أبي وعلي بن الحسين بن موسى قالا حدثنا علي بن إبراهيم بن هاشم قال حدثنا محمد بن عيسى بن عبيد عن ابن أبي عمير عن زيد بكتابه انتهى أوله حدثنا أبو محمد هارون ابن موسى بن أحمد التلعكبري قال حدثنا أبو علي محمد بن همام قال أخبرنا أحمد بن زياد بن حماد قال حدثنا عبيد الله بن أحمد بن نهيك أبو العباس قال حدثنا محمد بن أبي عمير عن زيد الزراد قال سمعت أبا عبد الله عليه السلام يقول خياركم سمحاؤكم وشراركم بخلاؤكم ومن خالص الايمان البر بالاخوان وفي ذلك محبته من الرحمن ومرغمة للشيطان وتزحزح عن النيران الخ * (@)(@@)(@@)(@@) $ 2502 - كتاب آخر له أوله حدثنا الشيخ أبو محمد هارون بن موسى ابن احمد التلعكبري قال حدثنا أبو العباس أحمد بن محمد ابن سعيد الهمداني قال حدثنا جعفر بن عبد الله العلوي وأبو عبد الله المحمدي قالا حدثنا محمد بن أبي 
ms303	 عمير عن زيد النرسي عن أبي عبد الله عليه السلام قال سمعته يقول إذا كان يوم الجمعة ويوم العيدين أمر الله رضوان خازن الجنان ان ينادي في أرواح المؤمنين وهم في عرصات الجنان ان الله قد اذن لكم بالزيارة إلى أهاليكم الخ * (@)(@@)(@@)(@@) $ 2503 - كتاب زيد واخباره لإبراهيم بن محمد بن سعيد الثقفي كان من أصحاب علي عليه السلام * PageV00P444(@)(@@)(@@)(@@) $ 2504 - كتاب سجدة الشكر لأبي عبد الله الحسين بن عبد الله الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2505 - كتاب السقيفة لإبراهيم بن محمد بن سعيد الثقفي كان من أصحاب علي عليه السلام * (@)(@@)(@@)(@@) $ 2506 - كتاب سلام بتخفيف اللام ابن أبي عمره الخراساني بفتح العين والراء والهاء بعد الراء قال النجاشي ثقة روي عن أبي جعفر وعن أبي عبد الله عليهما السلام سكن الكوفة له كتاب يرويه عنه عبد الله بن جيلة اخبرني عدة من أصحابنا عن أحمد بن محمد بن سعيد قال حدثنا القاسم بن محمد بن الحسين بن حازم قال حدثنا عبد الله بن جبلة قال حدثنا سلام انتهى أوله قال الشيخ أبو محمد هارون بن موسى التلعكبري قال حدثنا أحمد بن محمد بن سعيد قال حدثنا القاسم ابن محمد بن الحسن بن حازم قال حدثنا عبد الله بن جبلة الكناني قال حدثنا سلام بن أبي عمره عن معروف بن حزبوز المكي عن أبي جعفر عليه السلام قال دخلت عليه فأنشأت الحديث فذكرت باب القدر فقال لا أراك الا هناك اخرج عني قال قلت جعلت فداك اني أتوب منه الخ * (@)(@@)(@@)(@@) $ 2507 - كتاب السلطان للشيخ الصدوق أبي جعفر محمد بن علي ابن الحسين بن موسى بن بابويه القمي المتوفى سنة إحدى وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2508 - كتاب سليم بن قيس الهلالي العامري الكوفي صاحب أمير المؤمنين عليه السلام ذكر فيه ما سمعه من علي عليه السلام وغيره من الأصحاب كسلمان ومقداد وأبي ذر رضي الله عنهم مما وقع بعد رسول الله صلى الله عليه وآله من ارتداد الصحابة وما جرى على أهل البيت من الظلم 
ms304	 PageV00P445(@)(@@) والجفاء وأمثال ذلك من بعض مكاتبات علي عليه السلام إلى معوية وما قيل إنه موضوع لامرية فيه وعلى ذلك علامات منها ما ذكران محمد بن أبي بكر وعظ أباه عند الموت ومنها ان الأئمة ثلثة عشر فمقدوح لان وعظ محمد بن أبي بكر أباه ليس ببعيد لأنه قد يصدر من الأطفال الصغار الأفعال العجيبة وكان محمد بن أبي بكر عند وفاة أبيه ابن سنتين وسبعة أشهر على قول وعلى قول ابن أربع سنة وقد روت قريبا من هذه الرواية العامة أيضا كالغزالي في كتابه سر العالمين ويوسف سبط ابن الجوزي في تذكرة خواص الأمة واما كون الأئمة ثلاثة عشر فاني تصفحت الكتاب من الأول إلى الآخر فلم أجد فيه بل في مواضع عديدة انهم اثنى عشر واحد عشر من ولد علي أوله قال حدثني أبو طالب محمد ابن صبيح بن زجا بدمشق سنة أربع وثلاثين وثلاثين وثلاثمائة قال اخبرني أبو عمرو عصمة بن أبي عصمة البخاري قال حدثنا أبو بكر أحمد بن المنذر بن أحمد الصنعاني بصنعا شيخ صالح مأمون جار إسحاق بن إبراهيم الديري قال حدثنا أبو بكر عبد الرزاق بن همام ابن النافع الصنعاني الحميري قال حدثنا أبو عروة محمد بن ارشد البصري قال دعاني أبان بن أبي عباس قبل موته بنحو شهر فقال اني رأيت الليلة رويا اني لخليق ان أموت سريعا واني رايته في الغداة ففرحت بك اني رأيت الليلة سليم بن قيس الهلالي فقال لي يا ابان انك ميت من أيامه هذه فاتق الله في وديعتي ولا تضعها الخ * (@)(@@)(@@)(@@) $ 2509 - كتاب السنن في الفقه على طريقة العامة لفضل بن شاذان ابن الخليل النيسابوري * (@)(@@)(@@)(@@) $ 2510 - كتاب السنن عن أهل البيت لعبد الباقي بن قانع * PageV00P446(@)(@@)(@@)(@@) $ 2511 - كتاب السنن المشتركة لعيسى بن مهران المعروف بالمستعطف * (@)(@@)(@@)(@@) $ 2512 - كتاب سيرة؟؟ أبي بكر لمحمد بن مسعود بن محمد بن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2513 - كتاب سيرة عثمان بن عفان لمحمد بن مسعود بن محمد ابن عياش السلمي السمرقندي المعروف بالعياشي 
ms305	 * (@)(@@)(@@)(@@) $ 2514 - كتاب سيرة عمر بن الخطاب لمحمد بن مسعود بن محمد ابن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2515 - كتاب سيرة معوية لمحمد بن مسعود بن محمد بن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2516 - كتاب الصفين لنصر بن مزاحم بالزاي المعجمة المنقري بالنون قبل القاف * (@)(@@)(@@)(@@) $ 2517 - كتاب صناعة الشعر للشيخ أبي عبد الله محمد بن أحمد الأردستاني * (@)(@@)(@@)(@@) $ 2518 - كتاب الطب لمحمد بن مسعود بن محمد بن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2519 - كتاب الطب عن أهل البيت للسيد أبي محمد علي ابن الحسين الحسيني تلميذ الشيخ أبي جعفر الطوسي * (@)(@@)(@@)(@@) $ 2520 - كتاب عاصم بن حميد بضم الحاء الحناط بالنون الحنفي كوفي ثقة عين صدوق روى عن أبي عبد الله عليه السلام وقال النجاشي له كتاب PageV00P447(@)(@@) أخبرنا محمد بن جعفر قال حدثنا أحمد بن محمد بن سعيد قال حدثنا علي بن الحسين بن فضال قال حدثنا محمد بن عبد الحميد عن عاصم بكتابه أوله حدثنا أبو الحسن محمد بن الحسن بن الحسين بن أيوب القمي أيده الله قال حدثنا أبو علي محمد بن همام بن سهيل الكاتب وأبو القاسم حميد بن زياد بن هواز بفتح الهاء والواو بعدها والألف ثم الزاء في سنة تسع وثلاثمائة قالا حدثني عبيد الله بن أحمد عن مساور وسلمة عن عاصم بن حميد الحناط وذكر أبو محمد قال حدثني بهذا الكتاب أبو القاسم جعفر بن محمد بن إبراهيم بن عبيد الله بن موسى بن جعفر العلوي الموسوي بمصر سنة إحدى وأربعين قال حدثني الشيخ الصالح أبو العباس عبيد الله بن أحمد بن نهيك عن مساور وسلمة جميعا عن عاصم بن حميد الحناط قال سمعت أبا عبد الله عليه السلام يقول إن رسول الله لما انتهى إلى البيداء حيث الميلين أنيخت له ناقة فركبها فلما انبعثت به لبى بأربع فقال لبيك اللهم لبيك لبيك لا شريك لك لبيك ان الحمد والنعمة لك والملك لك لا شريك لك ثم قال حيث يخسف بالأخاسف الخ * (@)(@@)(@@)(@@) $ 2521 - كتاب العالم والمتعلم لمحمد بن 
ms306	 مسعود بن محمد بن عياش المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2522 - كتاب أبي سعيد بالياء عباد العصفري بضم العين واسكان الصاد المهملتين قال الشيخ الطوسي له كتاب أخبرنا به جماعة عن التلعكبري عن ابن همام عن محمد بن خاقان النهدي عن محمد بن علي يكني أبا سمينة عنه أوله حدثنا أبو محمد هارون بن موسى ابن احمد التلعكبري قال حدثنا أبو علي محمد بن همام السهلي قال أخبرنا PageV00P448(@)(@@) أبو جعفر محمد بن أحمد بن خاقان النهدي قال حدثنا محمد بن علي بن إبراهيم الصيرفي أبو سمينة قال حدثني أبو سعيد العصفري وعباد عن عمرو بن ثابت وهو ابن المقدام عن أبيه قال سمعت أبا جعفر يقول كيف أنتم يا أبا المقدام وقد كانت سبطة بين الحرمين تبقون فيها جاري لا تجدون سنادا يستندون إليه لا تدرون أيا من اي قلت وان ذلك لكائن قال كان أبي عليه السلام يقول ذلك ويقول يفعل الله ما يشاء ويمحو ويثبت وعنده أم الكتاب الخ * (@)(@@)(@@)(@@) $ 2523 - كتاب عبد الله بن يحيى بن أبي محمد الكاهلي قال الشيخ الطوسي روى عن أبي عبد الله وأبي الحسن عليهما السلام وكان وجيها عند أبي الحسن عليه السلام ووصى به علي بن يقطين فقال له اضمن إلى الكاهلي وعياله اضمن لك الجنة فلم يزل علي بن يقطين يجري لهم الطعام والدراهم وجميع النفقات مستغنين حتى مات الكاهلي له كتاب أخبرنا به ابن أبي الجيد عن ابن الوليد عن الصفار عن أحمد ابن محمد بن أبي النصر عنه وأخبرنا به أبو عبد الله عن محمد بن علي ابن الحسين عن أبيه وحمزة بن محمد ومحمد بن علي عن علي ابن إبراهيم عن أبيه عن محمد بن أبي عمير عنه أوله قال الشيخ أبو محمد هارون بن موسى التلعكبري قال حدثنا أبو العباس أحمد بن سعيد قال حدثنا محمد بن أحمد بن الحسن بن الحكم القطراني قال حدثنا احمد ابن محمد بن أبي نصر البرنطي قال حدثنا أبو عبد الله بن يحيى الكاهلي 
ms307	 قال سمعت أبا عبد الله يقول صلوا في مساجدهم وأعينوا جنائزهم وعودا مرضاهم الخ * (@)(@@)(@@)(@@) $ 2524 - كتاب عبد الملك بن حكيم بالحاء المفتوحة الخثعمي PageV00P449(@)(@@) كوفي ثقة عين روى عن أبي عبد الله عليه السلام وأبي الحسن عليه السلام قال الشيخ في الفهرست له كتاب أخبرنا به جماعة عن التلعكبري عن ابن عقدة عن ابن فضال عن محمد بن جعفر بن محمد بن حكيم عن عمه عبد الملك بن حكيم انتهى أوله حدثنا الشيخ أبو محمد هارون بن موسى ابن احمد التلعكبري قال أخبرنا أبو العباس أحمد بن محمد بن سعيد الهمداني قال أخبرنا علي بن الحسين بن علي بن فضال التيملي قال حدثنا جعفر بن محمد بن حكيم قال حدثني عمي عبد الملك بن حكيم عن سيف التمار عن حمزة الثمالي قال سمعت أبا جعفر عليه السلام يقول إن سليمان كان أدركه العلم الأول انه كان على الشريعة من دين عيسى عليه السلام فخدم بعض رهبانهم الخ * (@)(@@)(@@)(@@) $ 2525 - كتاب العروض لأبي عبد الرحمن الخليل بن أحمد بن عمرو ابن تميم الفراهيدي المتوفى سنة ستين ومائة قال ابن خلكان وهو الذي استنبط علم العروض وأخرجه إلى الوجود وحصر أقسامه في خمس دوائر يستخرج منه خمسة عشر بحرا ثم زاد الأخفش بحرا واحدا وسماه الخبب وقيل إن الخليل دعى بمكة ان يرزق علما لم يسبقه أحد إليه ولا يؤخذ الا عنه فلما رجع من حجه فتح عليه بعلم العروض وله معرفة بالايقاع والنغم وتلك المعرفة أحدثت له علم العروض فإنهما متقاربان في المأخذ وقال حمزة بن الحسن الأصبهاني في حق الخليل ابن احمد في كتابه المسمى بالتنيه على حدوث التصحيف وبعد فان دولة الاسلام لم تخرج أبدع للعلوم التي لم يكن لها عند علماء العرب أصول من الخليل وليس على ذلك برهان أوضح من علم العروض الذي لاعن حكيم اخذه ولا على مثال تقدمه احتذاه وانما اخترعه من ممر له بالصفارين من وقع مطرقة على طشت ليس فيهما حجة ولا بيان PageV00P450(@)(@@) يوديان إلى 
ms308	 غير حليتهما أو يفسران غير جوهرهما فلو كانت أيامه قديمة ورسومه بعيدة لشك فيه بعض الأمم لصنعته ما لم يصنعه أحد منذ خلق الله الدنيا من اختراعه العلم الذي قدمت ذكره * (@)(@@)(@@)(@@) $ 2526 - كتاب العلل لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2527 - كتاب العين في اللغة ينسب إلى الشيخ الجليل الخليل ابن احمد الفراهيدي بفتح الفاء والراء وبعد الألف هاء مكسورة ثم ياء ساكنة مثناة من تحتها وبعدها دال مهملة هذه النسبة إلى فراهيد وهي بطن من الأزد اليحمدي بفتح الياء المثناة من تحتها وسكون الحاء المهملة وفتح الميم وبعدها دال نسبة إلى يحمد وهو أيضا بطن من الأزد المتوفى سنة ستين ومائة وقال العلامة المجلسي في البحار والخليل والصاحب كانا من الامامية وهما عالمان في اللغة والعروض والعربية وقال حمزة ابن الحسن الأصبهاني في كتابه المسمى بالتنيه على حدوث التصحيف عند ذكره الخليل ومن تأسيسه بناء كتاب العين الذي يحصر لغة كل أمة من الأمم قاطبة انتهى وذكر في العين ان عدد أبنية كلام العرب المستعمل والمهمل على مراتبها الأربع من الثنائي والثلاثي والرباعي والخماسي من غير تكرير اثنى عشر الف الف وثلاثمائة الف وخمسمائة آلاف وأربعمائة واثنى عشر الف الثنائي تسعمائة وستة وخمسون والثلاثي تسعة عشر الف وستمائة وخمسون والرباعي أربعمائة الف واحد وتسعون ألفا وأربعمائة والخماسي أحد عشر الف الف وسبعمائة وثلاثة وتسعون ألفا وستمائة ونسبه إلى الخليل كثير من العلماء ذكره السيوطي في المزهر *(@)(@@)(@@)(@@) $ 2528 - كتاب الغارات لأبي إسحاق إبراهيم بن محمد بن سعيد ابن هلال الثقفي * PageV00P451(@)(@@)(@@)(@@) $ 2529 - كتاب الغدير لعلي بن هلال المهلبي * (@)(@@)(@@)(@@) $ 2530 - كتاب الغيبة لإبراهيم بن إسحاق الأحمري النهاوندي * (@)(@@)(@@)(@@) $ 2531 - كتاب الغيبة للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2532 - كتاب الغيبة للشيخ الصدوق محمد بن علي بن الحسين ابن موسى بن بابويه القمي المتوفى سنة إحدى وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2533 - كتاب الغيبة لمحمد بن إبراهيم بن جعفر بن أبي عبد الله النعماني بالنون المضمومة قبل العين المعروف بابن زينب بالزاي 
ms309	 المعجمة والنون بين الياء والباء شيخ من أصحابنا عظيم القدر شريف المنزلة صحيح العقيدة خرج إلى الشام ومات بها أوله حدثنا الشيخ أبو الفرج محمد بن علي بن يعقوب بن أبي قرة القنابي رحمه الله قال حدثنا أبو الحسين محمد بن علي البجلي الكاتب واللفظ من أصله كتبت هذه النسخة وهو ينظر في أصله قال حدثنا أبو عبد الله محمد ابن إبراهيم النعماني بحلب الحمد لله رب العالمين الهادي من يشاء إلى صراط مستقيم الخ *(@)(@@)(@@)(@@) $ 2534 - كتاب الغيبة لعبد الله بن جعفر بن الحسين بن مالك ابن جامع الحميري القمي صاحب قرب الإسناد * (@)(@@)(@@)(@@) $ 2535 - كتاب الغيبة لشيخ الطائفة محمد بن حسن بن علي الطوسي المتوفى سنة ستين وأربعمائة قال فيه اما بعد فاني مجيب ما رسمه الشيخ الجليل أطال الله بقاؤه من املاء كلام في غيبة صاحب الزمان وسبب غيبته والعلة التي لأجلها طالت غيبته وامتد استتاره مع شدة PageV00P452(@)(@@) الحاجة إليه وانتشار الحيل ووقوع الهرج والمرج وكثرة الفساد في البر البحر ولم لم يظهر وما المانع منه والمحوج إليه والجواب عن كل ما يسأل في ذلك من شبه المخالفين أوله الحمد لله الذي هدانا لحمده وجعلنا من أهله ووفقنا للتمسك لدينه والانقياد لسبيله الخ * (@)(@@)(@@)(@@) $ 2536 - كتاب الفرح في الغيبة لمحمد بن علي بن الفضل بن تمام بن سكين بضم السين ابن بنداذ بالنون الساكنة بعد الموحدة المضمومة والدال المهملة قبل الألف والذال المعجمة * (@)(@@)(@@)(@@) $ 2537 - كتاب الفرق بين الآل والأمة لعيسي بن مهران المعروف بالمستعطف * (@)(@@)(@@)(@@) $ 2538 - كتاب الفرق لأحمد بن إبراهيم بن أحمد بن المعلى وهو كتاب حسن غريب قاله الشيخ أبو جعفر الطوسي * (@)(@@)(@@)(@@) $ 2539 - كتاب الفصول للسيد المرتضى علم الهدى طاب ثراه مر في الفصول المنتخبة * (@)(@@)(@@)(@@) $ 2540 - كتاب الفضائل لزيد بن محمد بن جعفر المعروف بابن أبي اليابس بالتحتية قبل الألف وبعدها باء موحدة ثم السين المهملة الكوفي * (@)(@@)(@@)(@@) $ 2541 - كتاب الفضائل للشيخ الصدوق أبي جعفر محمد بن علي ابن الحسين بن موسى بن بابويه القمي المتوفى سنة إحدى وثمانين وثلاثمائة 
ms310	 * (@)(@@)(@@)(@@) $ 2542 - كتاب الفضائل لأبي عبد الله الحسين الحسيني * PageV00P453(@)(@@)(@@)(@@) $ 2543 - كتاب الفضائل لإبراهيم بن رجاء الجحدري بفتح الجيم أولا وسكون المهملة واهمال الدال المفتوحة ثم الراء منسوب إلى جحدر اسم رجل من بني قيس بن ثعلبة * (@)(@@)(@@)(@@) $ 2544 - كتاب الفضائل لابان بن تغلب الجريري الذي قال فيه جعفر عليه السلام اجلس في مجلس المدينة وافت الناس فاني أحب ان ارى في شيعتي مثلك * (@)(@@)(@@)(@@) $ 2545 - كتاب الفضائل لزهير بن محمد الجمال * (@)(@@)(@@)(@@) $ 2546 - كتاب الفضائل للشيخ الجليل أبي الفضل شاذان بن جبرئيل بن إسماعيل القمي *(@)(@@)(@@)(@@) $ 2547 - كتاب الفضائل لعيسى بن مهران المعروف بالمستعطف * (@)(@@)(@@)(@@) $ 2548 - كتاب فضائل أهل بيت رسول الله صلوت الله عليهم أجمعين لأبي علي محمد بن محمد بن عبد الله * (@)(@@)(@@)(@@) $ 2549 - كتاب فضائل الزهراء للشيخ أبي منصور أحمد بن علي ابن أبي طالب الطبرسي صاحب الاحتجاج * (@)(@@)(@@)(@@) $ 2550 - كتاب فضائل القران لمحمد بن مسعود بن محمد بن عياش بالشين المعجمة المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2551 - كتاب فضل بغداد لأبي عبد الله الحسين بن عبد الله الغضائري المتوفى سنة أحدي عشره وأربعمائة * (@)(@@)(@@)(@@) $ 2552 - كتاب فضل العرب لعلي بن الحسين المهلبي PageV00P454(@)(@@)(@@)(@@) $ 2553 - كتاب فضل العرب لعبد الله بن جعفر بن الحسين ابن مالك بن جامع الحميري القمي صاحب قرب الإسناد * (@)(@@)(@@)(@@) $ 2554 - كتاب فضل العلوية للشيخ الصدوق أبي جعفر محمد بن علي بن الحسين بن موسى بن بابويه القمي المتوفى سنة أحدي وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2555 - كتاب فضل الكوفة ومن نزلها من الصحابة لإبراهيم بن محمد بن سعيد الثقفي كان من أصحاب علي عليه السلام * (@)(@@)(@@)(@@) $ 2556 - كتاب فضل قريش وكافة العرب لأبي علي محمد بن محمد ابن عبد الله قاله ابن شهرآشوب * (@)(@@)(@@)(@@) $ 2557 - كتاب فوائد العلماء للسيد محمد بن حسن بن قاسم الحسيني العاملي النيسابوري العيناني الجزيني سبق في الفاء * (@)(@@)(@@)(@@) $ 2558 - كتاب قبض روح المؤمن والكافر لإبراهيم بن سليمان بن عبد الله بن حيان النهمي * (@)(@@)(@@)(@@) $ 2559 - كتاب في قول أمير المؤمنين علي بن أبي طالب عليه السلام الا أخبركم بخبر هذه الأمة لأبي عبد الله الحسين بن عبد الله 
ms311	 الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2560 - كتاب في قول أنت مني بمنزلة هارون من موسى للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * PageV00P455(@)(@@)(@@)(@@) $ 2561 - كتاب قراءة أمير المؤمنين علي بن أبي طالب عليه السلام لمحمد بن العباس بن علي بن مروان بن الماهيار المعروف بابن الجحام بالجيم قبل الحاء * (@)(@@)(@@)(@@) $ 2562 - كتاب قراءة أهل البيت لمحمد بن العباس بن علي ابن مروان بن الماهيار المعروف بابن الجحام بالجيم قبل الحاء * (@)(@@)(@@)(@@) $ 2563 - كتاب قراءة زيد بن علي بن الحسين بن علي بن أبي طالب قال شيخنا الطوسي في فهرسته أخبرنا به أحمد بن عبدون عن أبي بكر الدوري عن أبي بكر محمد بن عمر بن سالم الجعابي قال حدثني أبي عبد الله محمد بن سليمان بن محبوب عن أصل كتابه قال حدثني إبراهيم بن مسكين أبو إسحاق البصري كتبت عنه في الخزينة سنة أحدي وستين ومائتين قال حدثني يحيى بن كهمس أبو بكر القراري قال حدثني عمر بن موسى الوجيهي قال هذه القراءة سمعتها عن زيد ابن علي بن الحسين قال سمعت زيد بن علي يقول هذه قراءة أمير المؤمنين علي بن أبي طالب وقال ما رأيت اعلم بكتاب الله عز وجل وناسخه ومنسوخة ومشكله واعرابه منه * (@)(@@)(@@)(@@) $ 2564 - كتاب القراءة على مذهب العامة لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2565 - كتاب قضايا أمير المؤمنين عليه السلام لإبراهيم بن هاشم القمي * (@)(@@)(@@)(@@) $ 2566 - كتاب قضاء حقوق المؤمنين للشيخ سديد الدين أبي علي ابن طاهر السوري * PageV00P456(@)(@@)(@@)(@@) $ 2567 - كتاب الكبير في الرجال للعلامة جمال الدين حسن بن يوسف المطهر الحلي ذكره في مواضع من الخلاصة وفي أولها واخرها اسمه كشف المقال في معرفة الرجال * (@)(@@)(@@)(@@) $ 2568 - كتاب الكر للسيد أحمد بن موسى بن جعفر بن طاؤس الحسيني المتوفى سنة ثلاث وسبعين وستمائة ذكره ابن داود * (@)(@@)(@@)(@@) $ 2569 - كتاب الكر والفر لابن عقيل العماني * (@)(@@)(@@)(@@) $ 2570 - كتاب الكوفة لأحمد بن علي بن أحمد بن عباس بن محمد ابن عبد الله بن إبراهيم بن محمد بن عبد 
ms312	 الله النجاشي المتوفى سنة خمس وأربعمائة * (@)(@@)(@@)(@@) $ 2571 - كتاب اللقطة للشيخ الجليل والعالم النبيل محمد بن يوسف الاسترآبادي الحائري فرغ من تأليفه في شهر شوال سنة ثلاث وستين ومائتين بعد الألف أوله أحمدك يا من العقول الهادية في بيداء تعقل كنه ذاته ضالة والأفكار الحادة من السرح في تيهاء شرح صفاته كآلة الخ * (@)(@@)(@@)(@@) $ 2572 - كتاب ما اتفق من الاخبار في فضل الأئمة الاطهار للشيخ محمد بن جعفر الحائري * (@)(@@)(@@)(@@) $ 2573 - كتاب ما نزل من القران في أمير المؤمنين لإبراهيم بن محمد ابن سعيد الثقفي * (@)(@@)(@@)(@@) $ 2574 - كتاب ما سئل الصادق عليه السلام من الملاحم لعلي بن يقطين المتوفى اثنتين وثمانين ومائة * (@)(@@)(@@)(@@) $ 2575 - كتاب ما نزل في أعداء آل محمد صلى الله عليهم لأبي عبد الله محمد بن العباس بن علي بن مهيار المعروف بابن الجحام * PageV00P457(@)(@@)(@@)(@@) $ 2576 - كتاب ما نزل في شيعة آل محمد صلى الله عليهم لأبي عبد الله محمد بن العباس بن علي بن مهيار المعروف بابن الجحام * (@)(@@)(@@)(@@) $ 2577 - كتاب ما نزل من القرآن في أهل البيت لأبي عبد الله محمد بن عباس بن علي بن مروان بن الماهيار قال النجاشي قال جماعة من أصحابنا انه كتاب لم يصنف مثله في معناه وقيل إنه الف ورقة * (@)(@@)(@@)(@@) $ 2578 - كتاب ما لا يسع المكلف الاخلال به لشيخ الطائفة محمد ابن الحسن بن علي الطوسي المتوفى سنة ثمان وخمسين وأربعمائة * (@)(@@)(@@)(@@) $ 2579 - كتاب ما يعلل وما لا يعلل لشيخ الطائفة محمد بن الحسن ابن علي الطوسي المتوفى سنة ثمان وخمسين وأربعمائة * (@)(@@)(@@)(@@) $ 2580 - كتاب المبدأ والمبعث والمغازي والوفاة والسقيفة والرد لابان بن عثمان الأحمر البجلي *(@)(@@)(@@)(@@) $ 2581 - كتاب المتعة وتحليلها والرد على من حرمها للفقيه الفاضل محمد بن أحمد بن عبد الله بن قضاعة الصفواني * (@)(@@)(@@)(@@) $ 2582 - كتاب المتعة لأبي احمد محمد بن أبي عمير زياد * (@)(@@)(@@)(@@) $ 2583 - كتاب المتعة للشيخ المفيد محمد بن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2584 - كتاب المتعتين متعة النساء ومتعة الحج لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2585 - كتاب مثنى بن الوليد الحناط 
ms313	 بالنون قال الشيخ الطوسي رحمه الله روى الكشي باسناده عن ابن فضال أنه قال إنه كوفي حناط PageV00P458(@)(@@) لا باس به وله كتاب رواه الحسن بن علي الخزاز عنه وأخبرنا به جماعة عن أبي المفضل عن ابن بطة عن أحمد بن محمد بن عيسى عن ابن أبي عمير عنه انتهى أوله حدثنا الشيخ أبو محمد هارون بن موسى التلعكبري قال حدثنا أحمد بن محمد بن سعيد قال حدثنا علي بن الحسن بن فضال التيملي قال حدثنا العباس بن عامر القصبي قال حدثنا مثنى بن الوليد الحناط عن ميسر بياع الزطي عن أبي عبد الله عليه السلام انه علمه دعاء يدعو به اللهم إني أسئلك بقوتك وقدرتك الخ * (@)(@@)(@@)(@@) $ 2586 - كتاب محبة آل الرسول وذكر أحوال أعدائهم للفقيه الفاضل محمد بن أحمد بن عبد الله بن قضاعة الصفواني * (@)(@@)(@@)(@@) $ 2587 - كتاب المحدثين لعيسي بن مهران المعروف بالمستعطف * (@)(@@)(@@)(@@) $ 2588 - كتاب محمد بن القاسم الحضرمي كوفي ثقة قال النجاشي له كتاب أخبرنا الحسين قال حدثنا أحمد بن جعفر قال حدثنا حميد قال حدثنا احمد عن محمد بن المثنى بكتابه انتهى أوله حدثنا الشيخ أبو محمد هارون بن موسى بن أحمد التلعكبري أيده الله قال حدثنا محمد بن همام قال حدثنا حميد بن زياد الدهقان قال حدثنا محمد ابن المثنى بن القاسم الحضرمي قال حدثنا جعفر بن محمد بن شريح الحضرمي عن ذريح بالذال المعجمة المفتوحة والراء المكسورة والتحتية والمهملة المحاربي بضم الميم من بني محارب عن أبي عبد الله 4 قال قال صلوا إلى جانب القبر قبر رسول الله صلى الله عليه وآله وسلم وإن كانت صلاة المؤمن تبلغه أينما كان الخ * PageV00P459(@)(@@)(@@)(@@) $ 2589 - كتاب المدينة لعلي بن أحمد العقيقي صاحب كتاب الرحال * (@)(@@)(@@)(@@) $ 2590 - كتاب المختصر للشيخ حسن بن سليمان نقل عنه المجلسي رحمه الله تعالى في البحار * (@)(@@)(@@)(@@) $ 2591 - كتاب المزورين عن معاني الأخبار للشيخ المفيد محمد ابن محمد بن النعمان الحارثي المتوفى سنة ثلاث عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2592 - كتاب المسح على الرجلين لعلي بن هلال المهلبي * (@)(@@)(@@)(@@) $ 2593 
ms314	 - كتاب المسح على الرجلين حسن كبير ليحيى العلوي المكنى بابي محمد * (@)(@@)(@@)(@@) $ 2594 - كتاب المسح على الخفين لفضل بن شاذان النيسابوري * (@)(@@)(@@)(@@) $ 2595 - كتاب المصادقة للشيخ الصدوق أبي جعفر محمد بن علي ابن الحسين بن موسى بن بابويه القمي المتوفى سنة أحدي وثمانين وثلاثمائة يأتي في مصادقة الإخوان * (@)(@@)(@@)(@@) $ 2596 - كتاب المصباح للشيخ الصدوق محمد بن علي بن الحسين ابن موسى بن بابويه القمي المتوفى سنة أحدي وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2597 - كتاب المعادلات من الجبر والمقابلة بالفارسية للمولى الأعظم والمقتدى الأفخم كشاف مشكلات الحقائق مفتاح مغلقات الدقائق مخزن نفائس جواهر أصناف الحكم محرم سرائر خواص الحدوث والقدم المتحلى بكل زين المتخلي عن كل شين أخي المعظم السيد سراج حسين لا زالت شموس إفاداته طالعة في ذكر حل المعادلات أوله الحمد لله الذي عنده حقائق الأشياء والصلاة على محمد وآله الأصفياء الخ * PageV00P460(@)(@@)(@@)(@@) $ 2598 - كتاب المعراج للشيخ الصدوق أبي جعفر محمد بن علي ابن الحسين بن موسى بن بابويه القمي المتوفى سنة أحدي وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2599 - كتاب المعرفة لعبد الله بن محمد البلوي وبلى قبيلة من أهل مصر * (@)(@@)(@@)(@@) $ 2600 - كتاب المعرفة لمحمد بن الخليل المعروف بالسكاك صاحب هشام بن الحكم * (@)(@@)(@@)(@@) $ 2601 - كتاب المعرفة لمحمد بن نعمان الملقب بمؤمن الطاق * (@)(@@)(@@)(@@) $ 2602 - كتاب المعرفة لهشام بن الحكم * (@)(@@)(@@)(@@) $ 2603 - كتاب المقالات والفرق وأسماءها وصنوفها للشيخ الاجل المتقدم سعيد بن عبد الله * (@)(@@)(@@)(@@) $ 2604 - كتاب الملاهي للشيخ الصدوق محمد بن علي بن الحسين ابن موسى بن بابويه القمي المتوفى سنة أحدي وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2605 - كتاب الموالي لمحمد بن عمر بن محمد بن سالم الجعابي ويسميه كتاب من روى الحديث وغيره من العلوم ومن كانت له صناعة ومذهب ونحلة * (@)(@@)(@@)(@@) $ 2606 - كتاب المناسك لإبراهيم بن سليمان بن عبد الله بن حيان النهمي * (@)(@@)(@@)(@@) $ 2607 - كتاب من قتل من آل محمد عليهم السلام لإبراهيم بن محمد بن سعيد الثقفي * PageV00P461(@)(@@)(@@)(@@) $ 2608 - كتاب مواطن أمير المؤمنين علي بن أبي طالب عليه السلام لأبي عبد الله الحسين بن عبد الله الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2609 - كتاب 
ms315	 مولد القائم عليه السلام للسيد الاجل هاشم المعروف بالعلامة بن السيد سليمان بن السيد إسماعيل بن السيد عبد الجواد الكتكاني المتوفى سنة سبع ومائة بعد الألف * (@)(@@)(@@)(@@) $ 2610 - كتاب المنطق والكلام للسيد الجليل خليفة بن مطلب بن حيدر الموسوي المشعشي الحويزي المعاصر للشيخ الحر البهائي * (@)(@@)(@@)(@@) $ 2611 - كتاب الناسخ والمنسوخ لأبي عبد الله محمد بن العباس ابن علي بن ماهيار المعروف بابن الجحام * (@)(@@)(@@)(@@) $ 2612 - كتاب النجوم والقيافة لمحمد بن مسعود بن محمد بن عياش السلمي السمرقندي المعروف بالعياشي * (@)(@@)(@@)(@@) $ 2613 - كتاب النسب لعلي بن أحمد العقيقي العلوي صاحب كتاب الرجال * (@)(@@)(@@)(@@) $ 2614 - كتاب نسب آل أبي طالب ليحيى بن الحسين بن جعفر ابن عبيد الله بن الحسن بن علي بن الحسين بن علي بن أبي طالب عليهم السلام * (@)(@@)(@@)(@@) $ 2615 - كتاب نسب عمر بن الخطاب للسيد الاجل هاشم المعروف بالعلامة بن السيد سليمان بن السيد إسماعيل بن السيد عبد الجواد الكتكاني المتوفى سنة سبع ومائة والف * PageV00P462(@)(@@)(@@)(@@) $ 2616 - كتاب النوادر لعلي بن أسباط بن سالم بياع الزطي أبي الحسن المقري قال النجاشي كوفي ثقة وكان فطحيا جري بينه وبين علي ابن مهزيار رسائل في ذلك فرجعوا فيها إلى أبي جعفر عليه السلام فرجع علي ابن أسباط عن ذلك القول وتركه وقد روى عن الرضا عليه السلام من قبل ذلك وكان أوثق الناس وأصدقهم لهجة له كتاب الدلائل إلى أن قال وله كتاب النوادر مشهور أخبرنا أبو الحسن أحمد بن محمد بن موسى ابن الجراح الجندي قال حدثنا محمد بن علي بن همام أبو علي الكاتب قال حدثنا أحمد بن محمد بن موسى قال حدثنا أحمد بن هلال عن علي بن أسباط انتهى أوله حدثنا الشيخ أبو محمد هارون بن موسى التلعكبري قال حدثنا أبو العباس أحمد بن محمد بن سعيد الهمداني قال أخبرنا علي بن فضال عن علي بن أسباط قال أخبرنا يعقوب بن سالم الأحمر عن رجل عن أبي جعفر قال لما قبض رسول الله صلى الله عليه وآله وسلم بات آل محمد بليلة أطول 
ms316	 ليلة ظنوا انهم لا سماء تطلبهم ولا ارض تفلهم مخافة الخ *(@)(@@)(@@)(@@) $ 2617 - كتاب الوزراء لإسماعيل بن أبي الحسن عباد الطالقاني المتوفى سنة خمس وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2618 - كتاب الوصايا للشيخ الصدوق محمد بن علي بن الحسين ابن موسى بن بابويه القمي المتوفى سنة إحدى وثمانين وثلاثمائة *(@)(@@)(@@)(@@) $ 2619 - كتاب الوصية والرد على من أنكرها لهشام بن الحكم كان من خواص موسى بن جعفر عليهما السلام * (@)(@@)(@@)(@@) $ 2620 - كتاب الوعد والوعيد لفضل بن شاذان النيسابوري * PageV00P463(@)(@@)(@@)(@@) $ 2621 - كتاب وفاة الزهراء للسيد الاجل هاشم المعروف بالعلامة ابن السيد سليمان بن السيد إسماعيل بن السيد عبد الجواد الكتكاني المتوفى سنة سبع بعد المائة والألف * (@)(@@)(@@)(@@) $ 2622 - كتاب وفاة فاطمة الزهراء عليها السلام للسيد الجليل أبى الحسن البكري أستاذ الشهيد الثاني * (@)(@@)(@@)(@@) $ 2623 - كتاب وفاة النبي صلعم للسيد الاجل هاشم المعروف بالعلامة بن السيد سليمان بن السيد إسماعيل بن السيد عبد الجواد الكتكاني المتوفى سنة سبع بعد المائة والألف * (@)(@@)(@@)(@@) $ 2624 - كتاب يوم الغدير لأبي عبد الله الحسين بن عبد الله الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2625 - الكشف فيما يتعلق به بالسقيفة لأحمد بن إبراهيم بن أبي الربيع بن عبيد الأنصاري * (@)(@@)(@@)(@@) $ 2626 - الكشف والحجة لمحمد بن أحمد بن عبد الله بن قضاعة الصفواني كان فقيها فاضلا وكانت له منزلة عند السلطان * (@)(@@)(@@)(@@) $ 2627 - الكشف عن مساوي شعر المتنبي لإسماعيل بن أبي الحسن عباد الطالقاني المتوفى سنة خمس وثمانين وثلاثمائة * (@)(@@)(@@)(@@) $ 2628 - كشف الابهام في شرح قواعد الأحكام لمولانا محمد ابن حسن الأصفهاني المعروف بالفاضل الهندي المتوفى سنة خمس وثلاثين بعد المائة والألف وكان مولده سنة اثنتين وستين بعد الألف ونشؤه في بدو امره حال صغره في بلاد الهند ولذا نسب إليها وفرغ من المعقول والمنقول ولم يكمل ثلاث عشرة سنة كما صرح به نفسه PageV00P464(@)(@@) وشرح فيه من كتاب النكاح وانتهاه إلى الختام وسلك فيه النمط الأوسط الذي هو أقرب إلى الاختصار ثم بدأ من الأول مع استيفاء للمهم من الأدلة والأقوال ولم يبرز منه الا الطهارة والصلاة والحج لكن كتاب الصلاة ناقص 
ms317	 أوله الحمد لله الذي شرع لنا الدين ورفع قواعده وسهل شرايعه وموارده الخ فرغ من تصنيفه سنة خمس بعد المائة والألف * (@)(@@)(@@)(@@) $ 2629 - كشف الاخطار في طب الأئمة الاطهار لشمس الدين محمد الحسني الأحساوي ذكر فيه العوذ والأدوية المأخوذة من الأحاديث ورتبه على مقدمة اثنى عشر بابا وفرغ من تصنيفه في ثالث شهر ربيع الأول سنة تسع وثمانين والف بمحروسة شيراز أوله الحمد لله الذي شرع الاسلام فسهل ماخذه للواردين وأوضح اعلام الهداية للمرتادين الخ * (@)(@@)(@@)(@@) $ 2630 - كشف الاسرار لشرح الاستبصار في الحديث للفاضل المحقق السيد نعمة الله بن عبد الله بن محمد بن حسين الموسوي الشوشتري الجزائري المتوفى سنة ثلاثين ومائة بعد الألف * (@)(@@)(@@)(@@) $ 2631 - كشف الآيات للأمير الكبير السيد محمد رضا الحسيني منشي الممالك كان عالما عاملا فاضلا معاصرا للشيخ الحر العاملي * (@)(@@)(@@)(@@) $ 2632 - كشف البراهين في شرح زاد المسافرين في أصول الدين للشيخ محمد بن أبي جمهور الشيباني الأحساوي صنفه لأجل السيد محسن في سنة ثمان وسبعين وثمانمائة أوله ان أولي ما صرفت فيه القوى أو توجهت إليه الهمم وأحق ما نطق به اللسان أو رقم به القلم الخ * PageV00P465(@)(@@)(@@)(@@) $ 2633 - كشف التمويه والغمة لأبي عبد الله الحسين بن عبد الله الغضائري المتوفى سنة إحدى عشرة وأربعمائة * (@)(@@)(@@)(@@) $ 2634 - كشف الحقائق للشيخ أحمد بن زين العابدين العلوي العاملي الجبلي تلميذ محمد باقر الداماد الحسيني وهو حاشية كتاب تقويم الايمان لإستاذه وقد كتب مولانا الباقر الداماد الحسيني عليه لقد أصبحت قرير العين بحقائق تحقيقات هذه التعليقة ودقائق تدقيقاتها أدام الله تعالى إفاضات مصنفها السيد السند المحقق المدقق المتبحر المتمهر السالك سبيل العلم على سنة البرهان الناهج نهج الحكمة من شريعة العرفان انتهى أوله الحمد لمن أضاء قلوب المتفكرين في عجائب بديع السماوات السائرات والأرضين الراسيات بأنوار جماله وأنار عقول المتوسمين في غرائب صنع المبدعات العاكفين في سرادقات مجده وجلاله الخ * (@)(@@)(@@)(@@) $ 2635 - كشف الحق للعلامة جمال الدين حسن بن يوسف ابن المطهر الحلي اسمه الصحيح نهج الحق *(@)(@@)(@@)(@@) $ 2636 - كشف الخفاء من كتاب الشفاء في الحكمة 
ms318	 للعلامة جمال الدين حسن بن يوسف بن المطهر الحلي المتوفى سنة ست وعشرين وسبعمائة * (@)(@@)(@@)(@@) $ 2637 - كشف الريبة في احكام الغيبة للشيخ الاجل زين الدين ابن علي بن أحمد العاملي الشهيد الثاني المستشهد سنة ست وستين وتسعمائة وهي مرتبة على مقدمة وفصول وخاتمة في تعريف الغيبة وأقسامها واحكامها وبيان الأحاديث الدالة على تحريمها أولها PageV00P466(@)(@@) الحمد لله الذي طهر السنة أوليائه عن اللغو والغيبة والنميمة وذكى نفوسهم عن الأخلاق الدنية والشيم الذميمة الخ * (@)(@@)(@@)(@@) $ 2638 - كشف العوار في تفسير آية الغار للسيد نور الله بن شريف ابن نور الله الشوشتري المرعشي المستشهد سنة تسع عشرة بعد الألف رد فيه كلام الفاضل النيسابوري المتعلق بآية الغار أوله الحمد لله الذي جعل آيات الغار لرسوله المختار شرفا ومنارا وآنسه بملائكته كرامة الخ * (@)(@@)(@@)(@@) $ 2639 - كشف الغطاء للشيخ جعفر بن خضير النجفي المتوفى سنة أحدي وثلاثين ومائتين بعد الألف * (@)(@@)(@@)(@@) $ 2640 - كشف الغطاء في تفسير سورة هل اتى بالفارسية للفاضل اللوذعي والعالم الألمعي منبع الجود والاحسان قدوة الأعيان صدر الزمان المشار إليه بالبنان السيد رجب علي خان سلمه الله الملك المنان سلك فيه مسلكا غريبا بين طباق السورة على واقعة كربلاء أوله الحمد لله على أفضاله والصلاة على رسوله محمد وآله الخ * (@)(@@)(@@)(@@) $ 2641 - كشف الغمة في معرفة الأئمة للعلامة بهاء الملة والدين أبي الحسن علي بن عيسى بن أبي الفتح الأربلي المتوفى سنة اثنتين وتسعين وستمائة جمع فيه أحوال النبي وفاطمة والأئمة عليهم السلام من مواليدهم ووفياتهم ومناقبهم وفضائلهم ومحاسنهم وكلامهم ومعجزاتهم وغير ذلك واعتمد في الغالب على كتب الجمهور ليكون ادعى إلى تلقيه بالقبول عند أهل الشعور وقد اثنى عليه المخالفون أيضا كصلاح الدين الصفدي في فوات الوفيات وغيره في غيره أوله الحمد لله الذي ألزمنا كلمة التقوى ووفقنا للتمسك بالسبب الاقوي الخ * PageV00P467(@)(@@)(@@)(@@) $ 2642 - كشف الفوائد في شرح قواعد العقائد للشيخ جمال الدين أبي المنصور الحسن بن يوسف بن المطهر الحلي كانت ولادته في التاسع والعشرين من شهر رمضان سنة ثمان وأربعين وستمائة وتوفي في الحادي والعشرين 
ms319	 من شهر محرم الحرام سنة ست وعشرين وسبعمائة صنفه لولده فخر المحققين محمد طيب الله مضجعهما أوله الحمد لله على تواتر نعمائه وتظافر آلائه الخ * (@)(@@)(@@)(@@) $ 2643 - كشف القناع عن عور الاجماع لميرزا محمد الاخباري ذكره في المعاول * (@)(@@)(@@)(@@) $ 2644 - كشف القناع عن صريح الدليل في الرد على من قال في الرضاع بالتنزيل سيما على السيد محمد باقر الداماد للشيخ يوسف ابن احمد البحراني المتوفى سنة ست وثمانين ومائة بعد الألف * (@)(@@)(@@)(@@) $ 2645 - كشف القناع عن وجوه حجية الاجماع لأسد الله بن إسماعيل فرغ من تصنيفه في صفر سنة الف ومائتين واثنتين وعشرين من الهجرة النبوية أوله الحمد لله الذي رفع منازل العلماء الأعلام إلى أعلى مقام وكشف بمصابيح تبيانهم غياهب الظلام عن شرائع الاسلام الخ * (@)(@@)(@@)(@@) $ 2646 - كشف اللثام في شرح افهام الافهام في عقائد دين الاسلام للشيخ حسين بن الشيخ أحمد بن الشيخ إبراهيم بن عصفور الدرازي البحراني * (@)(@@)(@@)(@@) $ 2647 - كشف المحجة لثمرة المهجة للسيد علي بن طاؤس لحسيني سبق في البهجة لثمرة المهجة * PageV00P468(@)(@@)(@@)(@@) $ 2648 - كشف المراد في شرح تجريد الاعتقاد للعلامة جمال الدين أبي منصور حسن بن يوسف بن علي بن المطهر الحلي المتوفى سنة ست وعشرين وسبعمائة وهو شرح بالقول حامل المتن أوله الحمد لله القاهر سلطانه العظيم شانه الواضح برهانه الخ * (@)(@@)(@@)(@@) $ 2649 - كشف المقال في معرفة الرجال للعلامة جمال الدين حسن ابن يوسف بن علي بن المطهر الحلي المتوفى سنة ست وعشرين وسبعمائة ذكر فيه ما نقل من أحوال الرواة والمصنفين وأحوال المتأخرين والمعاصرين لكنه لا يوجد في هذا الزمان * (@)(@@)(@@)(@@) $ 2650 - كشف المكنون من كتاب القانون للعلامة جمال الدين حسن بن يوسف بن علي بن المطهر الحلي المتوفى سنة ست وعشرين وسبعمائة وهو اختصار شرح الجزولية في النحو * (@)(@@)(@@)(@@) $ 2651 - كشف النعمة في حكم التسمية للشيخ الجليل محمد بن الحسن بن علي بن محمد بن الحسين الحر العاملي وهي رسالة في تسمية المهدي عليه السلام * (@)(@@)(@@)(@@) $ 2652 - كشف النكات في علل النحاة للشيخ جمال الدين احمد ابن علي بن أميركا القوسي ذكره 
ms320	 منتجب الدين * (@)(@@)(@@)(@@) $ 2653 - كشف اليقين في فضائل أمير المؤمنين عليه السلام للعلامة جمال الدين حسن بن يوسف بن المطهر الحلي المتوفى سنة ست وعشرين وسبعمائة وقد ذكره في نهج الحق وان لم يذكره في الخلاصة عند ذكر مصنفاته أوله الحمد لله القديم القاهر العظيم القادر الحليم الغافر الكريم الخ * PageV00P469(@)(@@)(@@)(@@) $ 2654 - الكشكول في بيان ما جرى على آل الرسول لحيدر بن علي العبيدي الحسيني على ما نسبه إليه العلامة الشوشتري في مجالسه وقد ذكره الشيخ الحر العاملي عند ذكر مصنفات العلامة الحلي وقال ينسب إليه وقال الشيخ يوسف البحراني بعد نقله واما ما عد الكتاب الكشكول فيما جرى على آل الرسول من مصنفات العلامة الحلي فهو غلط وان عده غيره أيضا من مصنفاته قدس سره وانما هو من مصنفات حيدر بن علي العبيدي الحسيني الآملي كما ذكره في كتاب مجالس المؤمنين حيث عد الكتاب المذكور من جملة مصنفاته فقال والكتاب الكشكول فيما جرى على آل الرسول وأيضا التأمل في سياق عبارات الكتاب وأسلوب كلامه ظاهر في أنه ليس ذلك على طريقة العلامة ولا نظم كلامه * (@)(@@)(@@)(@@) $ 2655 - الكشكول للشيخ بهاء الدين محمد بن الشيخ الحسين ابن عبد الصمد الحارثي العاملي المتوفى سنة أحدي وثلاثين والف وهو في خمس مجلدات قال فيه اني لما فرغت من تأليف كتابي المسمى بالمخلاة حوى من كل شي أحسنه وأحلاه ثم عثرت بعد ذلك على نوارد يتحرك لها الطباع ويهش لها الاسماع وطرائف تسر المحزون وتزري بالدر المخزون ولطائف أصفى من رائق الشراب وأبهى من أيام الشباب واشعار أعذب من الماء الزلال والطف من السحر الحلال ومواعظ لو قرأت على الحجارة لانفجرت أو الكواكب لانتثرت وفقر أحسن من ورد الخدود وأرق من شكوى العاشق حال الصدود فاستخرت الله تعالى ونفقت كتابا ثانيا يحذو حذو ذلك الكتاب الفاخر ويستبين صدق المثل السائر كم ترك الأول للآخر ولما لم يتسع المجال لترتيبه ولا وجدت من الأيام فرصة بتبويبه جعلته كصفط مختلط رخيصة بغالية أو عقد انفصم فتناثرت لآليه وسميته 