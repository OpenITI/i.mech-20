ms526	 ) )(@)(@@) ( حم طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4916 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي الإشراك بالله ، أما إني لست أقول يعبدون شمسا ولا قمرا ولا وثنا ولاكن أعمالا لغير الله وشهوة خفية ) )(@)(@@) ( ه ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4917 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي عمل قوم لوط ) )(@)(@@) ( حم ت ه ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4918 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي في آخر زمانها : النجوم ، وتكذيب بالقدر ، وحيف السلطان ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4919 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي كل منافق عليم اللسان ) )(@)(@@) ( حم ) عن عمر رضي الله عنه .(@)(@@) PageV02P211(@)(@@)(@@)(@@) $ ( 4920 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف عليكم الشرك الأصغر : الرياء ، يقول الله يوم القيامة إذا جزى الناس بأعمالهم : اذهبوا إلى الذين كنتم تراؤون في الدنيا فانظروا هل تجدون عندهم جزاء ) )(@)(@@) ( حم ) عن محمود بن لبيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4921 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف عليكم بعدي كل منافق عليم اللسان ) )(@)(@@) ( طب هب ) عن عمران بن حصين رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4922 ) قال النبي :(@)(@@) | 30 ( إن أدنى الرياء شرك ، وأحب العبيد إلى الله تعالى الأتقياء الأخفياء الذين إذا غابوا لم يفتقدوا وإذا شهدوا لم يعرفوا ، أولائك أئمة الهدى ومصابيح العلم ) )(@)(@@) ( طب ك ) عن ابن عمر ومعاذ رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 4923 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلا : لرجل له دار من لؤلؤة واحدة منها غرفها وأبوابها ) )(@)(@@) ( هناد في الزهد ) عن عبد الله بن عمير مرسلا .(@)(@@)(@@)(@@) $ ( 4924 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلا رجل صرف الله وجهه عن النار قبل الجنة ، ومثل له شجرة ذات ظل ، فقال : أي رب قدمني إلى هاذه الشجرة فأكون في ظلها ، فقال الله : هل عسيت أن تسألني غيره ، قال : لا وعزتك فقدمه الله إليها ، ومثل له شجرة ذات ظل وثمر ، فقال : أي رب قدمني إلى هاذه 
ms527	 الشجرة فأكون في ظلها وآكل من ثمرها ، فقال الله : هل عسيت إن أعطيتك ذالك أن تسألني غيره ؟ فيقول : لا وعزتك ، فيقدمه الله إليها ، فيمثل الله له شجرة أخرى ذات ظل وثمر وماء ، فيقول : أي رب ، قدمني إلى هاذه الشجرة فأكون في ظلها وآكل من ثمرها وأشرب من مائها ، فيقول له : هل عسيت إن فعلت أن تسألني غيره ؟ فيقول : لا ، وعزتك لا أسألك غيره فيقدمه الله إليها ، فيبرز له باب الجنة فيقول : أي رب PageV02P212 قدمني إلى باب الجنة فأكون تحت سجاف الجنة فأرى أهلها فيقدمه الله إليها فيرى الجنة وما فيها فيقول : أي رب أدخلني الجنة ، فيدخل الجنة ، فإذا دخل الجنة قال : هاذا لي ؟ فيقول الله له : تمن ، فيتمنى ويذكره الله عز وجل ، سل من كذا وكذا ، حتى إذا انقطعت به الأمالي قال الله : هو لك وعشرة أمثاله ، ثم يدخله الله الجنة ، فيدخل عليه زوجتاه من الحور العين ، فيقولان : الحمد لله الذي أحياك لنا وأحيانا لك ، فيقول : ما أعطي أحد مثل ما أعطيت ، وأدنى أهل النار عذابا ينعل من نار بنعلين تغلي دماغه من حرارة نعليه ) )(@)(@@) ( حم م ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4925 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلة لرجل ينظر في ملكه ألفي سنة يرى أقصاه كما يرى أدناه ، ينظر أزواجه وخدمه وسرره ، وإن أفضلهم منزلة لمن ينظر في وجه الله تبارك وتعالى كل يوم مرتين ) )(@)(@@) ( حم ك ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4926 ) قال النبي :(@)(@@) | 30 ( إن أدنى أهل الجنة منزلة لمن ينظر إلى جنانه وأزواجه ونعمه وخدمه وسرره مسيرة ألف سنة ، وأكرمهم على الله من ينظر إلى وجهه الكريم غدوة وعشية ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4927 ) قال النبي :(@)(@@) | 30 ( إن أرحم ما يكون الله بالعبد إذا وضع في حفرته ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4928 ) قال النبي :(@)(@@) | 30 ( إن أرواح الشهداء في جوف طير خضر لها قناديل معلقة تحت العرش تسرح من الجنة حيث شاءت ثم تأوي 
ms528	 إلى تلك القناديل ، فاطلع إليهم ربهم اطلاعة فقال : هل تشتهون شيئا ؟ قالوا : أي شيء نشتهي ونحن نسرح من الجنة حيث شئنا ، فيفعل ذالك بهم ثلاث مرات ، فلما رأوا أنهم لم يتركوا من أن يسألوا ، قالوا : يا رب ، نريد أن ترد أرواحنا في أجسادنا حتى نرجع إلى PageV02P213 الدنيا فنقتل في سبيلك مرة أخرى ، فلما رأى أن ليس لهم حاجة تركوا ) )(@)(@@) ( م ت ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4929 ) قال النبي :(@)(@@) | 30 ( إن أرواح الشهداء في طير خضر تعلق من ثمار الجنة ) )(@)(@@) ( ت ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4930 ) قال النبي :(@)(@@) | 30 ( إن أرواح المؤمنين في السماء السابعة ينظرون إلى منازلهم في الجنة ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4931 ) قال النبي :(@)(@@) | 30 ( أن أرواح المؤمنين في طير خضر تعلق بشجر الجنة ) )(@)(@@) ( ه ) عن أم بشر بن البراء بن معرور وكعب بن مالك رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4932 ) قال النبي :(@)(@@) | 30 ( إن أزواج أهل الجنة ليغنين أزواجهن بأحسن أصوات ما سمعها أحد قط ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4933 ) قال النبي :(@)(@@) | 30 ( إن أسرع أمتي لحوقا بي امرأة من أحمس ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4934 ) قال النبي :(@)(@@) | 30 ( إن أسرع صدقة إلى السماء أن يصنع الرجل طعاما طيبا ثم يدعو عليه أناسا من إخوانه ) )(@)(@@) ( ابن أبي الدنيا في كتاب الإخوان ) عن حيان بن أبي جبلة ( ز ) .(@)(@@)(@@)(@@) $ ( 4935 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس بلاء الأنبياء ثم الذين يلونهم ثم الذين يلونهم ) )(@)(@@) ( ك ) عن فاطمة بنت اليمان رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4936 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس تصديقا للناس أصدقهم حديثا ، وإن أشد الناس تكذيبا أكذبهم حديثا ) )(@)(@@) ( أبو الحسن القزويني في أماليه ) عن أبي أمامة PageV02P214 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4937 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس عذابا يوم القيامة المصورون ) )(@)(@@) ( حم م ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4938 ) قال النبي :(@)(@@) | 30 ( إن أشد الناس ندامة يوم القيامة رجل باع آخرته بدنيا 
