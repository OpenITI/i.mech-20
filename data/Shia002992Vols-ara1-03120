ms3113	 عنه عبد الله بن عبد الرحمان الأصم.(@)(@@) الكافي: ج 6، ك 6، ب 78، ح 7.(@)(@@) وروى عنه عروة بن أخي شعيب PageV10P398(@)(@@) العقرقوفي.(@)(@@) الكافي: ج 1، ك 2، ب 16، ح 2.(@)(@@) وروى عنه الأصم.(@)(@@) الكافي: ج 6، ك 6، ب 112، ح 8.(@)(@@) * وروى عن أبي حمزة، وروى عنه الحارث بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 80، ح 21.(@)(@@) * وروى عن أبي الصباح، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 1، ك 4، ب 129، ح 17.(@)(@@) * وروى عن حريز، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 7، ح 462 (الاستبصار:(@)(@@) ج 3، ح 329).(@)(@@) * وروى عن عيسى بن حسان، وروى عنه هارون بن خارجة.(@)(@@) التهذيب: ج 9، ح 349.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه يونس.(@)(@@) الكافي: ج 4، ك 2، ب 39، ح 8.(@)(@@) * وروى عن المفضل، وروى عنه محمد بن الصغير حفيده.(@)(@@) الكافي: ج 2، ك 1، ب 107، ح 4، 5، 16.(@)(@@) * وروى عن يزيد الصائغ، وروى عنه يحيى الحلبي.(@)(@@) الكافي: ج 7، ك 2، ب 29، ح 8.(@)(@@) * وروى عن الزهري، وروى عن الحكم بن نافع الحمصي أبي اليمان.(@)(@@) الفقيه: ج 3، ح 212.(@)(@@) وروى أبان بن عبد الملك، عن بكر الأرقط، عن أبي عبد الله (عليه السلام)، أو عن شعيب عنه (عليه السلام).(@)(@@) شعيب بن يعقوب * روى عن أبي عبد الله (عليه السلام)، وروى عنه حماد بن عيسى.(@)(@@) الكافي: ج 7، ك 1، ب 6، ح 3. والتهذيب:(@)(@@) ج 4، ح 962، و ج 9، ح 770 (الاستبصار: ج 4، ح 452).(@)(@@) * وروى عن أبي بصير، وروى عنه حماد بن عيسى.(@)(@@) الكافي: ج 5، ك 2، ب 100، ح 3، و ج 6، ك 2، ب 6، ح 3، و ب 42، ح 4. والفقيه:(@)(@@) ج 4، ح 473. والتهذيب: ج 2، ح 221 (الاستبصار: ج 1، ح 1145)، و 873 (الاستبصار: ج 1، ح 1509)، و 877، و 1109 (الاستبصار: ج 1، ح 1124)، و ج 4، ح 43 (الاستبصار: ج 2، ح 49)، و ج 7، ح 1125، 1919، و ج 8، PageV10P399(@)(@@) ح 564 (الاستبصار: ج 3، ح 1267).(@)(@@) شعيب الحداد * روى عن أبي عبد الله (عليه السلام)، وروى عنه محمد بن أبي حمزة.(@)(@@) الكافي: ج 5، ك 3، ب 79، ح 2.(@)(@@) والتهذيب: ج 7، ح 1885 (الاستبصار:(@)(@@) ج 3، ح 1037).(@)(@@) * وروى عن أبي عبد الله (عليه السلام)، أو عن المعلى بن خنيس عن أبي عبد الله (ع)، وروى عنه عبد الله 
ms3114	 بن المغيرة.(@)(@@) التهذيب: ج 8، ح 143 (الاستبصار:(@)(@@) ج 3، ح 1004).(@)(@@) * وروى عن بشار بن يسار، وروى عنه صفوان.(@)(@@) الكافي: ج 5، ك 2، ب 92، ذيل ح 4.(@)(@@) وروى عنه منصور بن يونس.(@)(@@) الكافي: ج 5، ك 2، ب 92، ح 4.(@)(@@) والتهذيب: ج 7، ح 204.(@)(@@) * وروى عن ضريس الكناسي، وروى عنه صفوان بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 33، ح 4.(@)(@@) * وروى عن محمد بن إسحاق المدائني، وروى عنه علي بن الحسن بن رباط.(@)(@@) التهذيب: ج 9، ح 1237.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه صفوان.(@)(@@) الكافي: ج 2، ك 1، ب 97، ح 16.(@)(@@) وروى عنه علي بن الحسن بن رباط.(@)(@@) التهذيب: ج 7، ح 1533 (الاستبصار:(@)(@@) ج 3، ح 847).(@)(@@) * وروى عن معلى بن خنيس، وروى عنه صفوان.(@)(@@) التهذيب: ج 8، ح 142 (الاستبصار:(@)(@@) ج 3، ح 1003).(@)(@@) وروى عنه عبد الله بن المغيرة.(@)(@@) الكافي: ج 6، ك 2، ب 18، ح 1، 2.(@)(@@) والتهذيب: ج 8، ح 87 (الاستبصار:(@)(@@) ج 3، ح 962).(@)(@@) * وروى عن يزيد الصائغ، وروى عنه يحيى الحلبي.(@)(@@) الكافي: ج 7، ك 2، ب 5، ح 3.(@)(@@) شعيب العقرقوفي * روى عن أبي عبد الله (عليه السلام)، وروى عنه ابن أبي عمير. PageV10P400(@)(@@) الكافي: ج 2، ك 1، ب 154، ح 2.(@)(@@) وروى عنه ابن محبوب.(@)(@@) الكافي: ج 2، ك 1، ب 163، ح 8.(@)(@@) وروى عنه إسماعيل بن عمر.(@)(@@) الكافي: ج 6، ك 1، ب 7، ح 1.(@)(@@) وروى عنه الحسن بن محبوب.(@)(@@) الكافي: ج 2، ك 1 ب 76، ح 1.(@)(@@) وروى عنه صفوان بن يحيى.(@)(@@) الكافي: ج 5، ك 3، ب 63، ح 2.(@)(@@) والتهذيب: ج 7، ح 1809 (الاستبصار:(@)(@@) ج 3، ح 631).(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 5، ك 2، ب 126، ح 2.(@)(@@) وروى عنه غالب بن عثمان.(@)(@@) الفقيه: ج 4، ح 856.(@)(@@) وروى عنه النضر بن سويد.(@)(@@) التهذيب: ج 9، ح 282 (الاستبصار:(@)(@@) ج 4، ح 314).(@)(@@) وروى عنه يونس.(@)(@@) الروضة: ح 279.(@)(@@) وروى عنه يونس بن يعقوب.(@)(@@) الكافي: ج 4، ك 3، ب 180، ح 5.(@)(@@) والتهذيب: ج 5، ح 672، 1717.(@)(@@) * وروى عن أبي الحسن (عليه السلام)، وروى عنه صفوان بن يحيى.(@)(@@) التهذيب: ج 7، ح 1957 (الاستبصار:(@)(@@) ج 3، ح 687).(@)(@@) وروى عنه النضر.(@)(@@) الفقيه: ج 2، ح 1159.(@)(@@) * وروى يعقوب بن يزيد، عن رجل من