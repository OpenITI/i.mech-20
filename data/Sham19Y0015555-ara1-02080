@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : نظر، عاين، تطلع إلى. (هلو).(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) (بالتشديد): كثر، ضاعف. (فوك أبو الوليد ص376).(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : هذر، اكثر الكلام، تحذلق، (فوك، ألكالا).(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : اغتاب، ثلب، عاب. (ىفوك، ألكالا) وفي معجم ألكالا:(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) ت من أحد وقلت عيب منه. ولا يحتاج 
ms2063	 السيد انجلمان (في معجم الأسبانية ص123) إلى ما يستند إليه ليفسر معنى هذا الفعل وقد أخطأ حين قال أن المعنى المذكور لا علاقة له بمادة(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) . لأن الفعل(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) ليس الا اختصار(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) الكلام.(@)(@@) ت(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : مطاوع(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) بمعنى كثر وضاعف (فوك).(@)(@@) است(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : غازر، وهب شيئا ليرد عليه أكثر مما أعطى (لي، معجم مسلم).(@)(@@) است(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) ه: طلب غزارته وكثرته. ففي فالتون (ص36): الخراج عمود الملك وما است(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) بمثل العدل ولا استنزر بمثل الجور.(@)(@@) است(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : أعطى كأسا مملوء للشرب (معجم مسلم).(@)(@@) است(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : جمع كثيرا من الجند.(@)(@@) ففي أماري (ص395) فاستجاش وحسد واست(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) واستمد.(@)(@@) غزير. يقول العامة: غزير يرفع عينه أي كثيرا ما يرفع عينه (معجم مسلم).(@)(@@) غزير، والجمع(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) اء: ثرثار، مهذار، كثير الكلام. (فوك، ألكالا).(@)(@@) غزارة: هذر، ثرثرة. (فوك، ألكالا).(@)(@@) غزارة: نهجة، ضوضاء، لغط، جلبة، صخب، هرج ومرج. (فوك، ألكالا، المقدمة 2: 194).(@)(@@) وانظر معجم الأسبانية (ص122). غزارة والواحدة غزارة: نوع من الخيزران تتخذ منه الحصر وأقلام الكتابة (محيط المحيط).(@)(@@) م(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) : هذر، ثرثار (فوك) والأصح هو م(@)(@)(@@)(@@)(@@) || AUTO غزر(@)(@)(@@) اسم الفاعل.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) : شك، طعن طعنات متواترة. (بوشر) وفي ألف ليلة (برسل 1: 220): أخذ سكينا و(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) في رجليه.(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) : لذع اللسان (بوشر).(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) : زغزغ، دغدغة (بوشر).(@)(@@) ي(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) : يغمز (بوشر).(@)(@@) ت(@)(@)(@@)(@@)(@@) || AUTO غزغز(@)(@)(@@) : وخز، نغز، نخز (أ