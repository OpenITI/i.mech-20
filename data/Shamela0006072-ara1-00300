ms281	 الآخرة قال الله تعالى {وإن يوما عند ربك كألف سنة مما تعدون}(@)(@@)(@@)(@@) | 4152 - (@)(@@) أنس بن مالك(@)(@@) عمر الذباب أربعون يوما والذباب كله في النار إلا النحل(@)(@@)(@@)(@@) | 4153 - (@)(@@) جابر(@)(@@) عرش إبليس في البحر يبعث سراياه في كل يوم يفتنون الناس فأعظمهم منزلة أعظمهم فتنة للناس(@)(@@)(@@)(@@) | 4154 - (@)(@@) زيد بن أرقم(@)(@@) عذاب القبر حق فمن لم يؤمن به عذب بها وشفاعتي يوم القيامة حق فمن لم يؤمن بها لم يكن من أهلها(@)(@@)(@@)(@@) | 4155 - (@)(@@) عائشة(@)(@@) عذاب القبر حق لا يسمعه الجن والإنس ويسمعه غيرهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4156 - (@)(@@) ابن عباس(@)(@@) عضة نملة أشد على الشهيد من السلاح بل هو أشهى عنده من شراب بارد لذيذ في يوم صائف(@)(@@)(@@)(@@) | 4157 - (@)(@@) أنس بن مالك(@)(@@) عزيمة مني على أمتي أن لا يتكلموا في القدر(@)(@@)(@@)(@@) | 4158 - (@)(@@) عائشة(@)(@@) عدد درج الجنة عدد آي القرآن فمن دخل الجنة من أهل القرآن فليس فوقه درجة(@)(@@) فصل(@)(@@)(@@)(@@) | 4159 - (@)(@@) ابن عمر(@)(@@) عسى أن يبعثي ربك مقاما محمودا يجلسني معه على السرير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4160 - (@)(@@) جابر(@)(@@) عسى أن يكذبني واحد وهو متكىء على أريكته يبلغه الحديث عني فيقول ما قال ذا رسول الله دع هذا وهات القرآن(@)(@@)(@@)(@@) | 4161 - (@)(@@) أبو هريرة(@)(@@) عسى أحدكم أن يرى الجهاد مغنما والزكاة مغرما والصلة منا(@)(@@)(@@)(@@) | 4162 - (@)(@@) جابر(@)(@@) عسى أحدكم أن يتخذ الصبة على رأس ميل أو ميلين فيأتي الجمعة فلا يشهدها ثم يأتي الجمعة فلا يشهدها ثم يأتي الجمعة فلا يشهدها فيطبع الله عز وجل على قلبه(@)(@@)(@@)(@@) | 4163 - (@)(@@) عمر بن الخطاب(@)(@@) على العرش استوى استوى حتى يسمع أطيط كأطيط الرحل(@)(@@)(@@)(@@) | 4164 - (@)(@@) أنس بن مالك(@)(@@) عاش نوح ألف سنة وأربعمائة سنة ودعا قومه ألف سنة إلا خمسين سنة وعاش عوج بن عنق ثلاثة آلاف سنة وسبعمائة سنة وكان من الجبابرة وكان يخوض البحر ويأخذ السمك بيده فيشويه في عين الشمس ويأكله(@)(@@) فصل(@)(@@)(@@)(@@) | 4165 - (@)(@@) أنس بن مالك(@)(@@) على عرش الجبار جل جلاله ثلثمائة(@)(@@) PageV00P000(@)(@@) وستون برجا من ياقوتة حمراء أو زمردة خضراء أو ياقوت أبيض كل برج أوسع من الدنيا سبعين ألف مرة سبعين ألف مرة سبعين 
ms282	 ألف مرة(@)(@@)(@@)(@@) | 4166 - (@)(@@) سمرة بن جندب(@)(@@) على اليد ما أخذت حتى تؤديه(@)(@@)(@@)(@@) | 4167 - (@)(@@) حمزة بن عمرو(@)(@@) على ذروة كل بعير شيطان فإذا ركبتموها فسموا الله عز وجل ولا تقصروا عن حاجاتكم(@)(@@)(@@)(@@) | 4168 - (@)(@@) أبو هريرة(@)(@@) على كل سلامى من الإنسان صدقة كل يوم طلعت عليه الشمس فتعدل بين اثنين صدقة وتعين الرجل على دابته صدقة(@)(@@) السلاميات هي العظام بين كل مفصلين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4169 - (@)(@@) أبو هريرة(@)(@@) على كل نفس من بني آدم كتب حظه من الزنا أدرك ذلك لا محالة فالعين زناها النظر والأذن زناها السمع واليد زناها البطش والرجل زناها المشي واللسان زناه الكلام والقلب يهوى ويتمنى ويصدق ذلك أو يكذبه الفرج(@)(@@) فصل(@)(@@)(@@)(@@) | 4170 - (@)(@@) سلمان الفارسي(@)(@@) علي بن أبي طالب ينجز عداتي ويقضي ديني(@)(@@)(@@)(@@) | 4171 - (@)(@@) عمران بن حصين(@)(@@) علي مني وأنا منه وهو ولي كل مؤمن بعدي(@)(@@)(@@)(@@) | 4172 - (@)(@@) أم سلمة(@)(@@) علي وشيعته هم الفائزون يوم القيامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4173 - (@)(@@) جابر(@)(@@) علي مني بمنزلة هرون من موسى إلا إنه لا نبي بعدي(@)(@@)(@@)(@@) | 4174 - (@)(@@) ابن عباس(@)(@@) علي مني مثل رأسي من بدني(@)(@@)(@@)(@@) | 4175 - (@)(@@) جابر بن عبد الله(@)(@@) علي خير البشر من شك فيه فقد كفر يعني بعد الصديق والفاروق وعثمان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4176 - (@)(@@) عبد الله بن جعفر(@)(@@) علي أصلي وجعفر فرعي أو جعفر أصلي وعلي فرعي(@)(@@)(@@)(@@) | 4177 - (@)(@@) ابن عباس(@)(@@) علي وفاطمة والحسن والحسين أهلي وأبو بكر وعمر أهل الله وأهل الله عز وجل أفضل من أهلي(@)(@@)(@@)(@@) | 4178 - (@)(@@) أنس بن مالك(@)(@@) علي يزهر في الجنة ككوكب الصبحة لأهل الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4179 - (@)(@@) ابن عباس(@)(@@) علي باب حطة من دخل منه كان مؤمنا ومن خرج منه كان كافرا(@)(@@)(@@)(@@) | 4180 - (@)(@@) علي بن أبي طالب(@)(@@) علي بن أبي طالب أعلم الناس بالله والناس حبا وتعظيما لأهل لا إله إلا الله(@)(@@)(@@)(@@) | 4180 - (@)(@@) مكرر حذيفة(@)(@@) علي قسيم النار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4181 - (@)(@@) أبو ذر(@)(@@) علي باب علمي ومبين لأمتي ما أرسلت به من بعدي حبه إيمان وبغضه نفاق والنظر إليه رأفة ومودته عبادة(@)(@@)(@@)(@@) | 4182 - (@)(@@) حذيفة(@)(@@) علي أخي وابن عمي(@)(@@) فصل(@)(@@)(@@)(@@) | 4183 - (@)(@@) أبو أمامة(@)(@@) عرض علي ربي عز وجل ليجعل 
ms283	 بطحاء مكة ذهبا فقلت لا يا رب ولكن أشبع يوما وأجوع ثلاثا فإذا جعت تضرعت إليك وذكرتك وإذا شبعت حمدتك وشكرتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4184 - (@)(@@) أنس بن مالك(@)(@@) عرضت علي محاسن أعمال أمتي فلم أر شيئا أحسن من إخراج القذاة من المسجد وعرضت علي مساوىء أمتي فلم أر أعظم من رجل تعلم سورة أو آية ثم نسيها(@)(@@)(@@)(@@) | 4185 - (@)(@@) حذيفة بن أنس(@)(@@) عرضت على أمتي البارحة أدنى هذه الحرة أولها إلى آخرها صوروا لي من الطين حتى لأنا أعرف بالإنسان منهم من أحدكم بصاحبه(@)(@@)(@@)(@@) | 4186 - (@)(@@) أبو ذر(@)(@@) عرضت علي أمتي بأعمالها حسنها وسيئها فرأيت في محاسن أعمالها الأذى يماط عن الطريق ورأيت في سيء أعمالها النخاعة في المسجد لا تدفن(@)(@@)(@@)(@@) | 4187 - (@)(@@) أنس بن مالك(@)(@@) عرضت علي الأيام فرأيت فضل يوم الجمعة وبهاءه ونوره ورأيت فيه نكتة سوداء مثل شامة فساءني فقلت يا جبريل ما هذه النكتة السوداء في هذا البهاء والنور قال هذه الساعة تقوم في يوم الجمعة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4188 - (@)(@@) أبو هريرة(@)(@@) عرضت علي النار فرأيت عمرو بن لحي بن قمعة بن خندف يجر قصبه في النار وهو أول من غير عهد إبراهيم وسيب السائبة(@)(@@)(@@)(@@) | 4189 - (@)(@@) خريم بن فاتك(@)(@@) عدلت شهادة الزور بالإشراك بالله عز وجل(@)(@@) ذكر الفصول من ذوات الألف واللام(@)(@@)(@@)(@@) | 4190 - (@)(@@) ابن عمر(@)(@@) العلم دين والصلاة دين فانظروا ممن تأخذون هذا العلم وكيف تصلون هذه الصلاة فإنكم تسئلون يوم القيامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4191 - (@)(@@) ابن عمر(@)(@@) العلم حد الإسلام وعماد الدين(@)(@@)(@@)(@@) | 4192 - (@)(@@) علي(@)(@@) العلم خزائن ومفتاحه السؤال فسلوا يرحمكم الله عز وجل فإنه يؤجر فيه أربعة السائل والمتعلم والمستمع والمحب(@)(@@)(@@)(@@) | 4913 - (@)(@@) جابر(@)(@@) العلم خير من العمل وملك الدين الورع وإن العالم ممن يعمل بالعلم وإن كان قليلا(@)(@@)(@@)(@@) | 4194 - (@)(@@) عائشة(@)(@@) العلم علمان فعلم ثابت في القلب وعلم في اللسان فذلك حجة على عباده(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4195 - (@)(@@) أبو الدرداء وأنس(@)(@@) العلم خليل المؤمن والحلم وزيره والعقل دليله والعمل قائده والرفق والده واللين أخوه والصبر أميره وجنوده(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4196 - (@)(@@) ابن عمر(@)(@@) العلم زين والتقوى كرم والصبر خير مركب نعم وزير الإيمان العلم 
ms284	 وزين العلم الرفق وخير القول ما صدقه الفعل(@)(@@)(@@)(@@) | 4197 - (@)(@@) عبد الله بن عمر(@)(@@) العلم ثلاثة وما سوى ذلك فهو فضل آية محكمة أو سنة قائمة أو فريضة عادلة(@)(@@)(@@)(@@) | 4198 - (@)(@@) أبو هريرة(@)(@@) العلم والعالم والعمل في الجنة فإذا علم ويعمل كان العمل والعلم في الجنة والعالم في النار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4199 - (@)(@@) ابن عمر(@)(@@) العلم شجرة أصلها بمكة وفرعها بالمدينة وأغصانها بالعراق وثمرها بخراسان وورقها بالشام(@)(@@)(@@)(@@) | 4200 - (@)(@@) ابن عباس(@)(@@) العلم والمال يستران كل عيب والفقر والجهل يكشفان كل عيب(@)(@@) فصل(@)(@@)(@@)(@@) | 4201 - (@)(@@) أنس بن مالك(@)(@@) العالم إذا أراد بعلمه وجه الله عز وجل هابه كل شيء وإذا أراد بعلمه أن يكنز به الكنوز هاب من كل شيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4202 - (@)(@@) أنس بن مالك(@)(@@) العالم إذا مات بكى عليه كل شيء حتى الحيتان في البحر(@)(@@)(@@)(@@) | 4203 - (@)(@@) أنس(@)(@@) العالم بالعامة والعبادة بالرجل وحده(@)(@@)(@@)(@@) | 4204 - (@)(@@) معاذ بن جبل(@)(@@) العالم أمين الله عز وجل في الأرض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4205 - (@)(@@) أبو الدرداء(@)(@@) العالم والمتعلم شريكان في الخير وسائر الناس لا خير فيهم(@)(@@)(@@)(@@) | 4206 - (@)(@@) جابر(@)(@@) العالم الذي عقل عن الله تعالى فعمل بطاعته واجتنب سخطه(@)(@@)(@@)(@@) | 4206 - (@)(@@) مكرر جندب(@)(@@) العالم بغير عمل كالمصباح يحرق نفسه ويضيء للناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4207 - (@)(@@) ابن عباس(@)(@@) العالم عالمان عالم طلب بعلمه الله لم يأخذ عليه طمعا ولم يشتر به ثمنا وعالم طلب بعلمه الدنيا اشترى به ثمنا وأخذ عليه طمعا بخل به على عباد الله يلجمه يوم القيامة بلجام من نار فينادي عليه ملك من الملائكة ألا إن هذا فلان بن فلان آتاه الله في دار الدنيا علما فاشترى به ثمنا وأخذ عليه طمعا فلا يزال ينادي عليه حتى يفرغ من الناس ثم يصنع الله به ما أحب(@)(@@) فصل(@)(@@)(@@)(@@) | 4207 - (@)(@@) مكرر أبو الدرداء(@)(@@) العلماء هم ورثة الأنبياء إن الأنبياء لم يورثوا دينارا ولا درهما إنما ورثوا العلم ليعمل به فمن أخذ به فقد أخذ بحظ وافر(@)(@@)(@@)(@@) | 4208 - (@)(@@) عمر(@)(@@) العلماء إذا حضروا ربهم عز وجل كان بين أيديهم رتوة بحجر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4209 - (@)(@@) البراء بن عازب(@)(@@) العلماء ورثة الأنبياء يحبهم أهل السماء ويستغفر لهم الحيتان 
ms285	 في البحر إذا ماتوا(@)(@@)(@@)(@@) | 4210 - (@)(@@) أنس وحذيفة(@)(@@) العلماء أمناء الرسل على عباد الله عز وجل ما لم يخالطوا السلطان ويداخلوا الدنيا فإذا خالطوا السلطان وداخلوا الدنيا فقد خانوا الرسل فاحذروهم واخشوهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4211 - (@)(@@) عثمان بن عفان(@)(@@) العلماء أمناء أمتي(@)(@@)(@@)(@@) | 4212 - (@)(@@) أنس(@)(@@) العلماء ثلاثة رجل عاش به الناس وعاش بعلمه ورجل عاش به الناس وأهلك نفسه ورجل عاش بعلمه ولم يعش به أحد غيره(@)(@@)(@@)(@@) | 4213 - (@)(@@) علي(@)(@@) العلماء رجلان رجل عالم أخذ بعلمه فهذا ناج وعالم تارك لعلمه فهذا هالك وإن أهل النار ليتأذوا من ريح العالم التارك لعلمه(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 4214 - (@)(@@) جابر بن عبد الله(@)(@@) العين حق تدخل الجمل القدر والرجل القبر(@)(@@)(@@)(@@) | 4215 - (@)(@@) أسماء بنت يزيد(@)(@@) العين حق وإنه ليدرك الفارس قبل غيره أي يضربه ويهلكه(@)(@@)(@@)(@@) | 4216 - (@)(@@) ابن عباس(@)(@@) العين حق ولو أن شيئا سابق القدر لسبقته العين وإذا استغسلتم فاغسلوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4217 - (@)(@@) ابن عباس(@)(@@) العين حق تستنزل الحالق الحالق الجبل الشاهق(@)(@@)(@@)(@@) | 4218 - (@)(@@) أبو هريرة(@)(@@) العين حق يحفرها الشيطان وحسد ابن آدم(@)(@@)(@@)(@@) | 4219 - (@)(@@) عبد الله بن جراد(@)(@@) العين والنفس كادا يسبقان القدر فتعوذوا بالله من العين والنفس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4220 - (@)(@@) معاوية بن أبي سفيان(@)(@@) العين وكاء السه فإذا نامت العينان استطلق الوكاء(@)(@@) السه حلقة الدبر(@)(@@)(@@)(@@) | 4221 - (@)(@@) الحسين بن علي(@)(@@) العبادة سبعون بابا أفضلها طلب الرزق الحلال(@)(@@) فصل(@)(@@)(@@)(@@) | 4222 - (@)(@@) أنس(@)(@@) العبادة عشرة أجزاء تسعة منها في الصمت والعاشرة كسب اليد من الحلال(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4222 - (@)(@@) مكرر أبو موسى(@)(@@) العزلة سلامة(@)(@@)(@@)(@@) | 4223 - (@)(@@) معقل بن يسار(@)(@@) العيادة في الهرج كالهجرة إلي(@)(@@)(@@)(@@) | 4224 - (@)(@@) أنس(@)(@@) العيادة فواق ناقة(@)(@@)(@@)(@@) | 4225 - (@)(@@) ابن عباس(@)(@@) العيادة بعد ثلاث سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4226 - (@)(@@) عائشة(@)(@@) العيادة سنة عودوا غبا فإن أغمي على مريض فحتى يفيق(@)(@@)(@@)(@@) | 4227 - (@)(@@) ابن مسعود(@)(@@) العدة عطية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4228 - (@)(@@) علي بن أبي طالب(@)(@@) العدة دين ويل لمن وعد ثم أخلف ويل له ويل له(@)(@@)(@@)(@@) | 4229 - (@)(@@) أبو أمامة(@)(@@) العارية مؤادة(@)(@@)(@@)(@@) | 4230 - (@)(@@) علي(@)(@@) العمامة حاجز بين المسلمين والمشركين(@)(@@)(@@)(@@) | 4231 - (@)(@@) ابن عباس(@)(@@) العافية عشرة أجزاء تسعة منها في الصمت والعاشرة اعتزالك عن الناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4232 - (@)(@@) بريدة الأسلمي(@)(@@) العقيقة تذبح لسبع أو أربع عشر 
ms286	 أو لواحد وعشرين(@)(@@)(@@)(@@) | 4233 - (@)(@@) عمرو بن رافع المزني(@)(@@) العجوة والصخرة من الجنة يعني صخرة بيت المقدس(@)(@@)(@@)(@@) | 4234 - (@)(@@) ابن عباس(@)(@@) العمرة من الحج بمنزلة الرأس من الجسد وبمنزلة الزكاة من الصيام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4235 - (@)(@@) عمرو بن حزم(@)(@@) العمرة هي الحج الأصغر(@)(@@)(@@)(@@) | 4236 - (@)(@@) عائشة(@)(@@) العسيلة هي الجماع(@)(@@)(@@)(@@) | 4237 - (@)(@@) أبو هريرة(@)(@@) العطسة عند الحديث شاهد عدل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4238 - (@)(@@) أم سلمة(@)(@@) العطسة الشديدة والتثاؤب الرفيع من الشيطان(@)(@@)(@@)(@@) | 4239 - (@)(@@) ابن عمر(@)(@@) العربية كلام أهل الجنة وكلام أهل السماء وكلامهم إذا وقفوا بين يدي الله عز وجل بالموقف(@)(@@) فصل(@)(@@)(@@)(@@) | 4240 - (@)(@@) أبو هريرة(@)(@@) العطاس من الله والتثاؤب من الشيطان فإذا تثاءب أحدكم فلا يقل هاه هاه فإن الشيطان يضحك في جوفه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4241 - (@)(@@) ابن عباس(@)(@@) العباس مني وأنا منه لا تؤذوا العباس فتؤذوني من سب العباس فقد سبني(@)(@@)(@@)(@@) | 4242 - (@)(@@) ابن عمر(@)(@@) العاقل الذي عقل عن الله عز وجل أمره(@)(@@)(@@)(@@) | 4243 - (@)(@@) رافع بن خديج(@)(@@) العامل على الصدقة بالحق كالغازي في سبيل الله عز وجل حتى يرجع إلى بيته(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4244 - (@)(@@) ابن عباس(@)(@@) العائد في هبته كالكلب يعود في قيئه ليس لنا مثل السوء(@)(@@)(@@)(@@) | 4245 - (@)(@@) أنس(@)(@@) العامل الناصح بيده في الجنة والعامل الغاش بيده في النار(@)(@@)(@@)(@@) | 4246 - (@)(@@) علي(@)(@@) العمائم تيجان العرب والاحتباء حيطانها وجلوس المؤمن في المسجد رباطه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4247 - (@)(@@) ابن عباس(@)(@@) العمائم وقار للمؤمن وعز للعرب فإذا وضعت العرب عمائمها فقد وضعت عزها(@)(@@)(@@)(@@) | 4248 - (@)(@@) ابن عباس(@)(@@) العيدان واجبان على كل حالم من ذكر وأنثى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4249 - (@)(@@) ابن عمر(@)(@@) العرب بعضها لبعض أكفاء قبيلة بقبيلة وحي بحي ورجل برجل والموالي بعضها لبعض أكفاء إلا حائك أو حجام(@)(@@)(@@)(@@) | 4250 - (@)(@@) المقبري(@)(@@) العجم يبدأون بكبارهم إذا كتبوا فإذا كتب أحدكم إلى أخيه فليبدأ بنفسه(@)(@@)(@@)(@@) | 4250 - (@)(@@) مكرر أنس بن مالك(@)(@@) العرب نور الله في الأرض وفناؤهم ظلمة فإذا ذهب العرب آظلمت الأرض وذهب النور(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4251 - (@)(@@) أبو هريرة(@)(@@) العاشوراء يوم العاشر(@)(@@)(@@)(@@) | 4252 - (@)(@@) أبو هريرة(@)(@@) العي من الشيطان وليس العي عي اللسان ولكن قلة المعرفة بالحق(@)(@@) العي قطع اللسان عن الجواب(@)(@@)(@@)(@@) | 4253 - (@)(@@) زيد بن ثابت(@)(@@) العمري سبيلها سبيل الميراث يعني إذا قال 
ms287	 هي لك ما عشت فإنها ترجع إلى صاحبها فأما إذا قال هي لك ولعقبك فهي لهم(@)(@@)(@@)(@@) | 4254 - (@)(@@) عبد الله المزني(@)(@@) العيال أحد اليسارين وتعرضوا للرزق فإذا غلب أحدكم فليستدن على الله وعلى رسوله صلى الله عليه وسلم واستعينوا على الرزق بالصدقة(@)(@@)(@@)(@@) | 4255 - (@)(@@) يزيد بن مرثد(@)(@@) العنكبوت شيطان فاقتلوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4256 - (@)(@@) عبد الله بن عمر(@)(@@) العسل في كل عشرة زق زق(@)(@@) فصل(@)(@@)(@@)(@@) | 4256 - (@)(@@) مكرر أم سعد وزيد بن ثابت(@)(@@) العرش على ملك من لؤلؤ على صورة ديك رجلاه في التخوم السفلى وعنقه مثنية تحت العرش وجناحاه في المشرق والمغرب فإذا سبح الله ذلك الملك لم يبق شيء إلا سبح الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4257 - (@)(@@) بريدة الأسلمي(@)(@@) العهد الذي بيننا وبينهم الصلاة فمن تركها فقد كفر(@)(@@)(@@)(@@) | 4258 - (@)(@@) علي بن أبي طالب(@)(@@) العدل حسن ولكن في الأمراء أحسن السخاء حسن ولكن في الأغنياء أحسن الورع حسن ولكن في العلماء أحسن الصبر حسن ولكن في الفقراء أحسن التوبة حسن ولكن في الشباب أحسن الحياء حسن ولكن في النساء أحسن(@)(@@)(@@)(@@) | 4259 - (@)(@@) أنس بن مالك(@)(@@) العدل في أمتي خطفات(@)(@@)(@@)(@@) | 4260 - (@)(@@) أبو الدرداء(@)(@@) العبد من الله عز وجل والله منه ما لم يخدم فإذا خدم وقع عليه الحساب(@)(@@) PageV00P000(@)(@@) [4261 جابر بن عبد الله(@)(@@) العبد بين مخافتين بين أجل قد مضى لا يدري ما الله صانع فيه وبين أجل قد بقي لا يدري ما الله قاض فيه فليتزود العبد من نفسه لنفسه ومن دنياه لآخرته فوالذي نفس محمد بيده ما بعد الموت من مستعتب ولا بعد دار إلا الجنة أو النار(@)(@@)(@@)(@@) | 4262 - (@)(@@) ابن عباس(@)(@@) العبد لا يعطى من الغنيمة شيء ويعطى من خرثى المتاع وأمانه جائز(@)(@@)(@@)(@@) | 4263 - (@)(@@) عائشة(@)(@@) العبد لا يؤم إلا أهله(@)(@@)(@@)(@@) | 4264 - (@)(@@) فضالة بن عبيد(@)(@@) العبد آمن من عذاب الله عز وجل ما استغفر الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4265 - (@)(@@) الزبير بن العوام(@)(@@) العباد عباد الله والبلاد بلاد الله فحيث وجدت خيرا فآقم واتق الله عز وجل(@)(@@)(@@)(@@) | 4266 - (@)(@@) أبو سعيد الخدري(@)(@@) العشق من غير ريبة كفارة للذنوب(@)(@@)(@@)(@@) | 4267 - (@)(@@) أبو سعيد 
ms288	 الخدري(@)(@@) العرف ينقطع فيما بين الناس ولا ينقطع فيما بين الله وبين من افتعله(@)(@@)(@@)(@@) | 4268 - (@)(@@) عبد الرحمن بن غنم الأشعري(@)(@@) العتل الزنيم هو الشديد الخلق المفخخ الآكل الشروب الواجد للطعام وللشراب الظلوم للناس رحيب الجوف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الغين(@)(@@) PageV03P095(@)(@@) ب(@)(@@)(@@)(@@) | 4269 - (@)(@@) الحكم بن عمير(@)(@@) غضوا الأبصار واهجروا الدعاء واجتنبوا أعمال أهل النار(@)(@@)(@@)(@@) | 4270 - (@)(@@) أسماء بنت أبي بكر(@)(@@) غيروا الشيب وجنبوه السواد(@)(@@)(@@)(@@) | 4271 - (@)(@@) الزبير بن العوام(@)(@@) غيروا الشيب ولا تشبهوا باليهود(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4272 - (@)(@@) أنس(@)(@@) غيروا الشيب فإنه يزيد في شباب أحدكم وجماله ومجامعته للنساء(@)(@@)(@@)(@@) | 4272 - (@)(@@) مكرر الحكم بن عمير اليماني(@)(@@) غضوا الأبصار واهجروا الدغار واجتنبوا أعمال أهل النار(@)(@@) الدغار جمع داغر وهو المفسد(@)(@@)(@@)(@@) | 4273 - (@)(@@) جابر(@)(@@) غطوا الإناء وأوكوا السقاء فإن في السنة ليلة ينزل فيها وباء لا يمر بإناء لا يغطى ولا سقاء لم يوك إلا وقع فيه من ذلك الوباء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4274 - (@)(@@) جابر بن عبد الله(@)(@@) غطواء الإناء وأوكوا السقاء وأطفئوا السراج وأغلقوا الباب فإن الشيطان لا يحل سقاء ولا يفتح بابا ولا يكشف إناءا(@)(@@) فصل(@)(@@)(@@)(@@) | 4275 - (@)(@@) أبو موسى(@)(@@) غفر الله لك يا عثمان ما قدمت وما أخرت وما أعلنت وما أخفيت وما أبديت وما كان وما هو كائن إلى يوم القيامة(@)(@@)(@@)(@@) | 4275 - (@)(@@) مكرر ابن عباس(@)(@@) غفر الله لك يا معاوية ما قرئت(@)(@@)(@@)(@@) | 4276 - (@)(@@) أبو سعيد(@)(@@) غفر الله عز وجل لرجل ماط غصن شوك عن الطريق ما تقدم من ذنبه وما تأخر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4277 - (@)(@@) أبو هريرة(@)(@@) غزا نبي من الأنبياء فقال لا يغزو معي رجل تزوج امرأة ولم يبن بها ولا رجل له غنم ينتظر ولادها ولا بنا بناء لم يفرغ منه(@)(@@)(@@)(@@) | 4278 - (@)(@@) حذيفة(@)(@@) غزا أطاطس بن أسمانوس بني اسرائيل فسباهم وأحرق بيت المقدس وأحرقها بالنيران وحصل منها ألف وتسعمائة سفينة ملأى حتى أوردها الرومية(@)(@@)(@@)(@@) | 4279 - (@)(@@) جابر(@)(@@) غفار غفر الله لها وأسلم سالمها الله عز وجل ما أنا أقوله ولكن الله عز وجل قاله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4280 - (@)(@@) أبو هريرة(@)(@@) غفار وأسلم ومزينه ومن كان من جهينة خير من الحليفين غطفان وأسد وتيم وهوزان دبرا لهم دبرا فإنهم 
ms289	 أهل الخيل والوبر(@)(@@)(@@)(@@) | 4281 - (@)(@@) قبيص بن شماس(@)(@@) غبار المدينة شفاء من الجذام(@)(@@)(@@)(@@) | 4282 - (@)(@@) جابر(@)(@@) غلظ القلوب والجفاء في أهل الشرق والإيمان والسكينة في أهل الحجاز(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4283 - (@)(@@) أبو هريرة(@)(@@) غلظ جلد الكافر اثنان وسبعون ذراعا بذراع الجبار وضرسه مثل أحد(@)(@@)(@@)(@@) | 4284 - (@)(@@) أبو أمامة(@)(@@) غبن المسترسل حرام(@)(@@)(@@)(@@) | 4285 - (@)(@@) أنس بن مالك(@)(@@) غسل الإناء وطهارة الفناء يورثان الغنى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4286 - (@)(@@) أبو الدرداء(@)(@@) غسل الرأس يزيد في الحفظ وترك الوسخ ينقص من الحفظ(@)(@@)(@@)(@@) | 4287 - (@)(@@) جابر(@)(@@) غسل يوم الجمعة واجب على كل مسلم محتلم(@)(@@)(@@)(@@) | 4288 - (@)(@@) أبو هريرة(@)(@@) غسل يوم الجمعة واجب كغسل من الجنابة(@)(@@) فصل(@)(@@)(@@)(@@) | 4289 - (@)(@@) سهل بن سعد(@)(@@) غدوة في سبيل الله أو روحة في سبيل الله عز وجل خير من الدنيا وما فيها وموضع سوط في الجنة خير من الدنيا وما فيها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4290 - (@)(@@) أبو الدرداء(@)(@@) غزوة في البحر مثل عشر غزوات في البر والذي يسدر في البحر كالمتشحط في دمه في سبيل الله عز وجل سبحانه(@)(@@)(@@)(@@) | 4291 - (@)(@@) جابر(@)(@@) غفر لرجل ممن كان قبلكم كان سمحا إذا باع سمحا إذا اقتضى(@)(@@)(@@)(@@) | 4292 - (@)(@@) أبو هريرة(@)(@@) غلب درهم مائة ألف درهم رجل معه درهمان فتصدق بأحدهما ورجل كان له مال كثير فتصدق منها بمائة ألف درهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4293 - (@)(@@) عائشة(@)(@@) غشيكم السكرتان سكرة حب العيش وحب الجهل فعند ذلك لا تأمرون بمعروف ولا تنهون عن منكر والقائمون بالكتاب والسنة كالسابقين الأولين من المهاجرين والأنصار(@)(@@)(@@)(@@) | 4294 - (@)(@@) علي بن أبي طالب(@)(@@) غريبتان كلمة حكمة من سفيه فأقبلوها وكلمة سفه من حليم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4294 - (@)(@@) مكرر أنس(@)(@@) غنيمتان غنمهما كثير من الناس الصحة والفراغ(@)(@@)(@@)(@@) | 4295 - (@)(@@) عقبة بن عامر(@)(@@) غيرتان أحدهما يحبها الله والأخرى يبغضها الله الغيرة من الريبة يحبها الله والغيرة من غير الريبة يبغضها الله عز وجل(@)(@@) ذكر الفصول من ذوات الألف واللام(@)(@@)(@@)(@@) | 4296 - (@)(@@) أبو بكر الصديق(@)(@@) الغسل يوم الجمعة كفارة والمشي إلى الجمعة كفارة وكل قدم منها عمل عشرين سنة فإذا فرغ من صلاة الجمعة اجيزاهما مائتي سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4297 - (@)(@@) أبو هريرة(@)(@@) الغسل واجب في هذه الأيام يوم الجمعة ويوم الفطر ويوم النحر 
ms290	 ويوم عرفة(@)(@@)(@@)(@@) | 4298 - (@)(@@) أبو أمامة(@)(@@) الغسل يوم الجمعة ينسل الخطايا من أصول الشعر سلا(@)(@@)(@@)(@@) | 4299 - (@)(@@) سلمان بن عامر(@)(@@) الغلام مرتهن بعقيقته فاهريقوا منه دما وأميطوا عنه الأذى(@)(@@) تأوله أحمد بن حنبل على الشفاعة يقول إن مات الغلام ولم يعق عنه لم يشفع من والديه(@)(@@)(@@)(@@) | 4300 - (@)(@@) أبي بن كعب(@)(@@) الغلام الذي قتله الخضر طبع يوم طبع كافرا ولولا ذلك لأرهق أبويه طغيانا وكفرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4301 - (@)(@@) أبو هريرة(@)(@@) الغرباء في الدنيا أربعة قرآن في جوف ظالم ومسجد في نادي قوم لا يصلون فيه ومصحف في بيت لا يقرأ فيه ورجل صالح مع قوم سوء(@)(@@)(@@)(@@) | 4302 - (@)(@@) أنس بن مالك(@)(@@) الغبار في سبيل الله عز وجل إسفار الوجوه يوم القيامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4303 - (@)(@@) ابن عباس(@)(@@) الغدو والرواح في تعلم العلم أفضل عند الله من الجهاد في سبيل الله عز وجل(@)(@@)(@@)(@@) | 4303 - (@)(@@) مكرر أبو أمامة(@)(@@) الغدو والرواح إلى المساجد من الجهاد في سبيل الله(@)(@@)(@@)(@@) | 4304 - (@)(@@) زيد بن خالد(@)(@@) الغلول من جمر جهنم والنياحة من عمل الجاهلية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4305 - (@)(@@) عمر بن الخطاب(@)(@@) الغزاة أولياء الله عز وجل قبل حسناتهم ومحا سيئاتهم فطوبى للغزاة في سبيل الله دعوه فأجابهم وسألوه فأعطاهم(@)(@@) فصل(@)(@@)(@@)(@@) | 4306 - (@)(@@) معاذ بن جبل(@)(@@) الغزو غزوان فأما من غزا ابتغاء وجه الله وأطاع الإمام وأنفق الكريمة وياسر الشريك واجتنب الفساد في الأرض فإن نومه ونبهه أجر كله وأما من غزا فخرا ورياء وسمعة وعصى الإمام وأفسد في الأرض فإنه لا يرجع بالكفاف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4307 - (@)(@@) صفوان بن أمية(@)(@@) الغرق شهادة والبطن والنفساء(@)(@@)(@@)(@@) | 4307 - (@)(@@) مكرر جابر بن عتيدة(@)(@@) الغريق شهيد(@)(@@)(@@)(@@) | 4308 - (@)(@@) أبو هريرة(@)(@@) الغنم أموال الأنبياء(@)(@@)(@@)(@@) | 4309 - (@)(@@) عمرو بن شرحبيل(@)(@@) الغنم بركة والإبل عز لأهلها والخيل معقود في نواصيها الخير إلى يوم القيامة والعبد أخوك فأحسن إليه وإن وجدته مغلوبا فأعنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4310 - (@)(@@) ابن عباس(@)(@@) الغريب إذا مرض فنظر عن يمينه وعن شماله ومن أمامه ومن خلفه فلم ير أحدا يعرفه غفر الله له ما تقدم من ذنبه(@)(@@)(@@)(@@) | 4311 - (@)(@@) أبو سعيد(@)(@@) الغريب في غربته كالمجاهد في سبيل الله يرفع الله بكل قدم درجة 
ms291	 ويكتب له خمسين حسنه الغريب في غربته وجبت الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4312 - (@)(@@) أنس بن مالك(@)(@@) الغلاء والرخص جندان من جنود الله عز وجل يسمى أحدهما الرغبة والآخر الرهبة فإذا أراد أن يرخصه قذف الرهبة في قلوب التجار فأخرجوه من أيديهم وإذا أراد أن يغليه قذف الرغبة في قلوب التجار فرغبوا فيه(@)(@@) فصل(@)(@@)(@@)(@@) | 4313 - (@)(@@) أنس بن مالك(@)(@@) الغضب جمرة في قلب ابن آدم ألم تروا إلى حمرة العينين وانتفاخ الأوداج عند الغضب(@)(@@) فإذا أحس أحدكم بذلك فليقل أعوذ بالسميع العليم من الشيطان الرجيم الأوداج هي العروق التي أحاطت بالعنق يقطعها الذابح(@)(@@)(@@)(@@) | 4314 - (@)(@@) معاوية بن أبي سفيان(@)(@@) الغضب من الشيطان وإن الشيطان خلق من نار وإنما يطفى النار بالماء فإذا غضب أحدكم فليتوضأ(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4315 - (@)(@@) معاوية بن جندة(@)(@@) الغضب يفسد الإيمان كما يفسد الصبر العسل(@)(@@) فصل(@)(@@)(@@)(@@) | 4316 - (@)(@@) أنس بن مالك(@)(@@) الغنى ستون ألفا فمن لم يملك ستين ألفا فهو فقير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4317 - (@)(@@) أنس(@)(@@) الغنى غنى النفس والفقر فقر النفس(@)(@@)(@@)(@@) | 4318 - (@)(@@) ابن مسعود(@)(@@) الغنى اليأس مما في أيدي الناس ومن مشى منكم إلى طمع من طمع الدنيا فليمش رويدا(@)(@@)(@@)(@@) | 4319 - (@)(@@) أنس بن مالك(@)(@@) الغناء واللهو ينبتان في القلب النفاق كما ينبت الماء العشب والذي نفسي بيده إن القرآن والذكر لينبتان الإيمان في القلب كما ينبت الماء العشب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4320 - (@)(@@) أبو سعيد وجابر(@)(@@) الغيبة أشد من الزنا لأن الرجل يزني فيتوب يتوب الله عليه وإن صاحب الغيبة لا يغفر له حتى يغفر له صاحبها(@)(@@)(@@)(@@) | 4321 - (@)(@@) أبو هريرة(@)(@@) الغيبة أشد من القتل(@)(@@)(@@)(@@) | 4322 - (@)(@@) ابن عمر(@)(@@) الغيبة تنقض الوضوء والصلاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4323 - (@)(@@) معاذ(@)(@@) الغيبة أخو الربا وهو مصارعه(@)(@@)(@@)(@@) | 4324 - (@)(@@) أبو هريرة(@)(@@) الغيبة ذكرك أخاك بما يكره إن كان فيه ما تقول فقد اغتبته وإن لم يكن فيه فقد بهته(@)(@@)(@@)(@@) | 4325 - (@)(@@) معاذ بن جبل(@)(@@) الغيبة إن قلت ما في أخيك المسلم لم تزكه(@)(@@)(@@)(@@) | 4326 - (@)(@@) أبو سعيد(@)(@@) الغيرة من الإيمان والبذا من النفاق البذا الذي لا يغار ويقال المذال أيضا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4327 - (@)(@@) عبد الله بن عمرو(@)(@@) الغفلة في ثلاث الغفلة عن ذكر الله عز وجل 
ms292	 والغفلة فيما بين صلاة الفجر إلى طلوع الشمس والغفلة أن يغفل الرجل حتى يركبه الدين(@)(@@)(@@)(@@) | 4328 - (@)(@@) عامر بن مالك(@)(@@) الغنيمة الباردة الصوم في الشتاء أما ليله فطويل وأما نهاره فقصير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الفاء(@)(@@) PageV03P119(@)(@@)(@@)(@@) | 4329 - (@)(@@) أبو الدرداء(@)(@@) فرغ الله عز وجل إلى كل عبد من خمس من أجله ورزقه ومضجعه وأثره وشقي أم سعيد(@)(@@)(@@)(@@) | 4330 - (@)(@@) عبد الرحمن بن عوف(@)(@@) فرض الله عليكم شهر رمضان وسننت لكم قيامه فمن صامه وقامه إيمانا واحتسابا خرج من ذنوبه كيوم ولدته أمه(@)(@@)(@@)(@@) | 4331 - (@)(@@) نبيط بن شريط(@)(@@) فضل الله عز وجل أهل المدن على أهل القرى كفضل أهل السماء على أهل الأرض من أجل الجمعة والجماعة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4332 - (@)(@@) أم هاني بنت أبي طالب(@)(@@) فضل الله عز وجل قريشا بسبع خصال لم يعطها أحد قبلهم ولا يعطاها أحد بعدهم إني منهم وإن النبوة فيهم وإن الحجابة فيهم وإن السقاية فيهم ونصرهم على الفيل وعبدوا الله عشر سنين لم يعبده غيرهم وأنزل الله فيهم سورة من القرآن لم يشرك فيها غيرهم(@)(@@)(@@)(@@) | 4332 - (@)(@@) مكرر علي بن أبي طالب(@)(@@) فضل الماشي خلف الجنازة على الماشي أمامها كفضل الصلاة المكتوبة على التطوع(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 4333 - (@)(@@) ابن عمر(@)(@@) فضلت على آدم صلى الله عليه وسلم بخصلتين كان شيطاني كافرا فأعانني الله عليه حتى أسلم وكان أزواجي خيرا لي وكان شيطان آدم كافرا وزوجته عونا عليه(@)(@@)(@@)(@@) | 4334 - (@)(@@) أبو هريرة(@)(@@) فضلت على الأنبياء بست أعطيت جوامع الكلم ونصرت بالرعب وأحلت لي الغنائم وجعلت لي الأرض مسجدا وطهورا وأرسلت إلى الخلق كافة وختم بي النبوة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4335 - (@)(@@) أنس بن مالك(@)(@@) فضلت على الناس بأربعة بالسخاء والشجاعة وكثرة الجماع وشدة البطش(@)(@@)(@@)(@@) | 4335 - (@)(@@) مكرر عقبة بن عامر(@)(@@) فضلت سورة الحج بسجدتين فمن لم يسجدهما فلا يقرأها(@)(@@)(@@)(@@) | 4336 - (@)(@@) معقل بن يسار(@)(@@) فضلت بالمفصل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4336 - (@)(@@) مكرر جابر أو أبي سعيد(@)(@@) فضلت هذه الآية على القرآن كله إلا ما شاء ربك إن ربك فعال لما يريد(@)(@@)(@@)(@@) | 4337 - (@)(@@) عباد بن سعد(@)(@@) فضلت خديجة على نساء النبي صلى الله عليه وسلم كما فضلت مريم على نساء 
ms293	 العالمين(@)(@@)(@@)(@@) | 4338 - (@)(@@) أبو هريرة(@)(@@) فضلت المرأة على الرجل بتسعة وتسعين من اللذة ولكن الله عز وجل ألقى عليهن الحياء(@)(@@)(@@)(@@) | 4339 - (@)(@@) ابن عباس(@)(@@) فضلت بنو هاشم على الناس بسبع خصال بقرابتهم مني وببراعة علم عالمهم وبالرأي الفاضل وبالجمال والشجاعة والحظوة عند النساء فتحت القرى كلها بالسيف وفتحت المدينة بالقرآن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4340 - (@)(@@) أبو هريرة(@)(@@) فقدت أمة من بني اسرائيل لا يدرى ما فعلت ولا أراها إلا الفأر ألا تروها إذا وضع لها ألبان الجمل لم تشربه وإذا وضع لها ألبان الشاة شربته(@)(@@) فصل(@)(@@)(@@)(@@) | 4341 - (@)(@@) أبو هريرة(@)(@@) فضل القرآن على ساير الكلام كفضل الله عز وجل على ساير خلقه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4342 - (@)(@@) ابن عباس(@)(@@) فضل حملة القرآن على الذي لم يحمله كفضل الخلق على المخلوق(@)(@@)(@@)(@@) | 4342 - (@)(@@) مكرر بعض أصحاب النبي صلى الله عليه وسلم(@)(@@) فضل قراءة القرآن نظرا على من يقرأه ظاهرا كفضل الفريضة على النافلة(@)(@@)(@@)(@@) | 4343 - (@)(@@) حذيفة(@)(@@) فضل العلم خير من فضل العبادة وخير من دينكم الورع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4344 - (@)(@@) عبد الرحمن بن عوف(@)(@@) فضل العالم علي العابد سبعون درجة ما بين كل درجتين كما بين السماء والأرض(@)(@@)(@@)(@@) | 4345 - (@)(@@) عبد الله بن عمرو(@)(@@) فضل العالم على العابد سبعون درجة ما بين كل درجتين حضر الفرس السريع المضمر مائة عام وذلك أن الشيطان يضع البدعة للناس فيبصرها العالم فينهى عنها العابد مقبل على وعبادته لا يتوجه لها ولا يعرفها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4346 - (@)(@@) أبو سعيد(@)(@@) فضل العالم على العابد كفضلي على أمتي(@)(@@)(@@)(@@) | 4347 - (@)(@@) معاذ بن جبل(@)(@@) فضل العالم على العابد كفضل القمر ليلة البدر على سائر الكواكب(@)(@@)(@@)(@@) | 4348 - (@)(@@) ابن عباس(@)(@@) فضل عمل المهاجر على الأعرابي بسبعين ضعفا وفضل عمل العالم علي العابد بسبعين ضعفا وفضل عمل السر على العلانية بسبعين ضعفا ومن استوت سريرته وعلانيته باهى الله به ملائكته ثم يقول هذا عبدي حقا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4349 - (@)(@@) ابن مسعود(@)(@@) فضل صلاة الليل على صلاة النهار كفضل صدقة السر على صدقة العلانية(@)(@@)(@@)(@@) | 4350 - (@)(@@) أنس بن مالك(@)(@@) فضل رجب على سائر الأشهر كفضل القرآن على سائر الكلام(@)(@@)(@@)(@@) | 4351 - (@)(@@) أنس(@)(@@) فضل شعبان على سائر الأيام كفضلي 
ms294	 على سائر الأنبياء(@)(@@)(@@)(@@) | 4351 - (@)(@@) مكرر(@)(@@) فضل الجمعة في شهر رمضان على سائر الجمع كفضل رمضان على سائر الشهور(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4352 - (@)(@@) البراء بن عازب(@)(@@) فضل الجمعة في رمضان كفضل رمضان على سائر الشهور(@)(@@)(@@)(@@) | 4352 - (@)(@@) مكرر عائشة(@)(@@) فضل الصلاة التي يستاك لها على الصلاة التي لا يستاك لها سبعون ضعفا(@)(@@)(@@)(@@) | 4353 - (@)(@@) أنس بن مالك(@)(@@) فضل الوقت الأول من الصلاة على الوقت الآخر كفضل الآخرة على الدنيا(@)(@@)(@@)(@@) | 4354 - (@)(@@) حذيفة(@)(@@) فضل الدار القريبة من المسجد على الدار البعيدة كفضل الغازي على القاعد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4355 - (@)(@@) أنس بن مالك(@)(@@) فضل الشاب العابد الذي تعبد في شبابه على الشيخ الذي تعبد بعدما كبرت سنه كفضل المرسلين على سائر الناس(@)(@@)(@@)(@@) | 4356 - (@)(@@) الحسين بن علي(@)(@@) فضل البنفسج على الأدهان كفضل الإسلام على سائر الأديان وما من ورقة من ورق الهندبا إلا عليها قطرة من ماء الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4356 - (@)(@@) مكرر أبو سعيد(@)(@@) فضل دهن البنفسج على سائر الأدهان كفضلي على سائر الخلق بارد في الصيف حار في الشتاء(@)(@@)(@@)(@@) | 4357 - (@)(@@) أنس بن مالك(@)(@@) فضل عائشة على سائر النساء كفضل الثريد على سائر الطعام(@)(@@)(@@)(@@) | 4357 - (@)(@@) عائشة(@)(@@) فضل عائشة على النساء كفضل تهامة على ما سواها من الأرض وفضل الثريد على الطعام(@)(@@)(@@)(@@) | 4358 - (@)(@@) أنس بن مالك(@)(@@) فضل مشايخ المسلمين على شباب المسلمين كفضل رب العالمين على سائر الخلق من المؤمنين والمؤمنات بأجمعهم والكفار جميعا وكفضل النبي على سائر الأمم والأنبياء جميعا(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 4359 - (@)(@@) عبد الله بن جراد(@)(@@) في الجنة شجرة تسمى السخاء منها يخرج السخاء ولن يلج الجنة شحيح وإذا ابتغيتم المعروف ففي حسان الوجوه من الرجال فابتغوا(@)(@@)(@@)(@@) | 4360 - (@)(@@) أبو سعيد(@)(@@) في الجنة طير فيه سبعون ألف ريشة فتجيء حتى تقع على صحفة الرجل من أهل الجنة ثم تنتفض فتخرج من تحت كل ريشة لون أبيض من الثلج وأحلى من العسل وألين من الزبد ليس فيها لون يشبه صاحبه ثم تطير فتذهب(@)(@@)(@@)(@@) | 4361 - (@)(@@) أنس بن مالك(@)(@@) في الجنة كثيب من مسك يقال له السوق يتحدث عليه أهل الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4362 - (@)(@@) معاوية بن أبي سفيان(@)(@@) في الجنة بحر 
ms295	 الماء وبحر اللبن وبحر الخمر وبحر العسل ثم تتفجر الأنهار بعد(@)(@@)(@@)(@@) | 4363 - (@)(@@) عمرو بن عوف(@)(@@) في الجمعة ساعة من نهار لا يسأل فيها عبد شيئا إلا أعطاه سؤله حين تقام الصلاة إلى الانصراف منها(@)(@@)(@@)(@@) | 4364 - (@)(@@) الحسين بن علي(@)(@@) في الجمعة ساعة لا يوافقها رجل يحتجم فيها إلا مات(@)(@@) فصل(@)(@@)(@@)(@@) | 4365 - (@)(@@) أم سلمة(@)(@@) في السماء ملكان أحدهما يأمر بالشدة والآخر يأمر باللين وكلاهما مصيب جبريل وميكائيل ونبيان أحدهما يأمر باللين والآخر يأمر بالشدة وكل مصيب إبراهيم ونوح ولي صاحبان أحدهما يأمر باللين والآخر يأمر بالشدة وكل مصيب أبو بكر وعمر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4365 - (@)(@@) أبو هريرة(@)(@@) في السماء الدنيا ثمانون ألف ملك يستغفرون لمن أحب أبا بكر وعمر وفي السماء الثانية ثمانون ألف ملك يلعنون من أبغض أبا بكر وعمر(@)(@@)(@@)(@@) | 4366 - (@)(@@) عثمان بن أبي العاص(@)(@@) في الأرض أمانان أنا أمان والاستغفار أمان وأنا مذهوب بي ويبقى أمان الاستغفار عند كل حدث وذنب(@)(@@)(@@)(@@) | 4367 - (@)(@@) أبو هريرة(@)(@@) في المؤمن ثلاث خصال الطيرة والظن والحسد فمخرجه من الطيرة أن لا يرجع ومخرجه من الظن أن لا يحقق ومخرجه من الحسد أن لا يبغي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4368 - (@)(@@) بريدة الأسلمي(@)(@@) في الإنسان ثلثمائة وستون مفصل على كل عضو منها صدقة فمن لم يطق ذلك فإن ركعتي الضحى يجزيا عنه(@)(@@)(@@)(@@) | 4369 - (@)(@@) أنس بن مالك(@)(@@) في السواك عشر خصال مطهرة للفم ومرضاة للرب ومسخطة للشيطان ومحبة للحفظة ويشد اللثة ويطيب الفم ويقطع البلغم ويطفي المرة ويجلو البصر ويوافق السنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4370 - (@)(@@) علي بن أبي طالب(@)(@@) في الزنا ست خصال ثلاثة في الدنيا وثلاثة في الآخرة فأما في الدنيا فيذهب بنور الوجه ويقطع الرزق ويسرع الفنا وأما في الآخرة فغضب الرب وسوء الحساب والدخول أو الخلود في النار(@)(@@)(@@)(@@) | 4371 - (@)(@@) ابن عباس(@)(@@) في البطيخ عشر خصال هو طعام وشراب ويغسل المثانة ويقطع الأبردة وهو ريحان وأشنان ويغسل البطن ويكثر ماء الصلب ويكثر الجماع وينقي البشرة(@)(@@)(@@)(@@) | 4371 - (@)(@@) مكرر صهيب(@)(@@) في التوراة سورة تدعى العزيزة ويدعى قارئها العزيز وهي يس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4372 - (@)(@@) فاطمة بنت قيس(@)(@@) في المال حق سوى 
ms296	 الزكاة(@)(@@)(@@)(@@) | 4372 - (@)(@@) مكرر عمران(@)(@@) في كتاب الله عز وجل ثمان آيات للعين لا يقرأها عبد في دار فيصيبهم ذلك اليوم عين أنس أو جن فاتحة الكتاب سبع آيات وآية الكرسي آية(@)(@@)(@@)(@@) | 4373 - (@)(@@) أبو هريرة(@)(@@) في صدر الجراد مكتوب جند الله الأعظم(@)(@@)(@@)(@@) | 4373 - (@)(@@) مكرر أبو ذر(@)(@@) في اللبن صدقة(@)(@@)(@@)(@@) | 4374 - (@)(@@) عمر بن الخطاب(@)(@@) في طعام العرس مثقال من ريح الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4375 - (@)(@@) معاوية بن حيدة(@)(@@) في كل إبل سائمة من كل أربعين بنت لبون ولا يفرق إبل من حسابها من أعطاها مؤتجرا فله أجرها ومن منعها فإنا آخذوها وشطر إبله عزمة من عزمات ربنا لا يحل لآل محمد منها شيء(@)(@@)(@@)(@@) | 4375 - (@)(@@) مكرر عبد الله بن عمرو(@)(@@) في كل قرن من أمتي سابقون(@)(@@)(@@)(@@) | 4376 - (@)(@@) أنس(@)(@@) في الأربعين بعد المائتين خير أولادكم البنات وفي الخمسين خير نسائكم العقيمات وفي الستين يغبط الرجل الذي ليس أهل ولا ولد وفي السبعين بعد المائتين البلاء المبين وفي الثمانين السيف وفي التسعين حلت لأمتي الرهبانية وفي الثلاثمائة نعم البيت القبر(@)(@@)(@@)(@@) | 4376 - (@)(@@) مكرر ابن مسعود(@)(@@) في ثلاثين من البقر تبيع أو تبيعه وفي أربعين مسنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4377 - (@)(@@) عبد(@)(@@) في الإبل فرع وفي الغنم فرع ويعق عن الغلام ولا يمس رأسه بدم(@)(@@)(@@)(@@) | 4377 - (@)(@@) مكرر أبو هريرة(@)(@@) في ما سقت السماء والعيون العشر وما سقي بالنضح نصف العشر(@)(@@) النضح جمع الناضح وهو الإبل(@)(@@)(@@)(@@) | 4378 - (@)(@@) أبو هريرة(@)(@@) في بيض النعام يصيبه المحرم ثمنه(@)(@@)(@@)(@@) | 4379 - (@)(@@) معاذ بن جبل(@)(@@) في الصلب الدية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4380 - (@)(@@) أبي بن كعب(@)(@@) في المذي الوضوء(@)(@@)(@@)(@@) | 4381 - (@)(@@) سلمان الفارسي(@)(@@) في رجب يوم وليلة من صام ذلك اليوم وقام تلك الليلة كان له من الأجر كمن صام مائة سنة وقام مائة سنة وهي لثلاث بقين من رجب(@)(@@) في ذلك اليوم بعث الله محمدا نبيا(@)(@@)(@@)(@@) | 4381 - (@)(@@) مكرر علي بن أبي طالب(@)(@@) في أول ليلة من ذي الحجة ولد إبراهيم فمن صام ذلك اليوم كان كفارة ثمانين سنة وفي تسع من ذي الحجة أنزل توبة داود فمن صام ذلك اليوم كانت كفارة ستين سنة(@)(@@) PageV00P000(@)(@@) فصل 
ms297	(@)(@@)(@@)(@@) | 4382 - (@)(@@) عمرو بن العاص(@)(@@) فضل ما بين صيامنا وصيام أهل الكتاب أكلة السحر(@)(@@)(@@)(@@) | 4383 - (@)(@@) محمد بن حاطب(@)(@@) فضل ما بين الحلال والحرام الدف والصوت في النكاح(@)(@@)(@@)(@@) | 4384 - (@)(@@) ركانة(@)(@@) فرق ما بيننا وبين المشركين العمائم على القلانس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4385 - (@)(@@) أبو سعيد(@)(@@) فاتحة الكتاب شفاء من السم(@)(@@)(@@)(@@) | 4386 - (@)(@@) أبو الدرداء(@)(@@) فاتحة القرآن لتجزي ما لا يجزي شيء من القرآن ولو أن فاتحة الكتاب جعلت في كفة الميزان وجعل القرآن في الكفة الأخرى فضلت فاتحة الكتاب على القرآن سبع مرات(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4387 - (@)(@@) أبو هريرة(@)(@@) فاتحة الكتاب هي أم القرآن وهي السبع المثاني إحداهن بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 4388 - (@)(@@) ابن عباس(@)(@@) فاطمة سيدة نساء العالمين ما خلا مريم بنت عمران(@)(@@)(@@)(@@) | 4389 - (@)(@@) المسور بن مخرمة(@)(@@) فاطمة بضعة مني فمن أغضبها أغضبني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4390 - (@)(@@) ابن عباس(@)(@@) فارس عصبتنا أهل البيت لأن إسماعيل عم ولد إسحق واسحق عم ولد إسماعيل(@)(@@)(@@)(@@) | 4391 - (@)(@@) ابن عمر(@)(@@) فواتح الغيب خمس لا يعلمهن إلا الله المطر لا يعلمه إلا الله وعنده علم الساعة وما تدري نفس ماذا تكسب غدا وما تدري نفس بأي أرض تموت(@)(@@)(@@)(@@) | 4392 - (@)(@@) جابر بن عبد الله(@)(@@) فطرة الإسلام خمس السواك والختان وتقليم الأظفار وقص الشارب وحلق العانة فإنها طهارة للمؤمنين ويكتب الله بكل شعرة تسقط من جسده عشر حسنات(@)(@@)(@@)(@@) | 4393 - (@)(@@) عائشة(@)(@@) فتنة في فإذا سئلتم عني فلا تشكوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4394 - (@)(@@) حذيفة(@)(@@) فتنة الرجل في أهله وماله ونفسه وولده وجاره يكفرها الصيام والصلاة والصدقة والأمر بالمعروف والنهي عن المنكر(@)(@@)(@@)(@@) | 4395 - (@)(@@) الفضل بن عباس(@)(@@) فضوح الدنيا أهون من فضوح الآخرة(@)(@@)(@@)(@@) | 4396 - (@)(@@) عبد الله بن عمرو(@)(@@) فقراء المهاجرين سبقوا الأغنياء إلى الجنة بأربعين خريفا(@)(@@)(@@)(@@) | 4397 - (@)(@@) أبو موسى(@)(@@) فناء أمتي بالطعن والطاعون وخز أعدائكم من الجن وفي كل شهادة(@)(@@) الوخز الطعن بالإبرة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4397 - (@)(@@) مكرر أنس(@)(@@) فناء أمتي ما بين الخمسين إلى الستين ولن يعذب الله إبناء الثمانين من أمتي(@)(@@)(@@)(@@) | 4398 - (@)(@@) ابن عباس(@)(@@) فقيه واحد أشد على الشيطان من ألف عابد(@)(@@)(@@)(@@) | 4399 - (@)(@@) جابر بن عبد الله(@)(@@) فراش للرجل وفراش لا مرأته وفراش للضيف والرابع للشيطان(@)(@@) PageV00P000(@)(@@) [4400 - علي 
ms298	(@)(@@) فطرك لأخيك المسلم وإدخالك السرور عليه أعظم أجرا من صيامك بمائة ألف ضعف(@)(@@) فصل(@)(@@)(@@)(@@) | 4401 - (@)(@@) جابر بن عبد الله(@)(@@) فروا من فضول الدنيا كما تفرون من الحرام وهونوا على أنفسكم الدنيا كما تتهون الجيفة ونوروا قلوبكم بتفكر الآخرة وتوبوا إلى الله من فضول الدنيا وسيئات أعمالكم حتى تنجوا من شدة يوم القيامة(@)(@@)(@@)(@@) | 4402 - (@)(@@) أبو هريرة(@)(@@) فروا من المجذوم كفراركم من الأسد(@)(@@)(@@)(@@) | 4403 - (@)(@@) أبو موسى(@)(@@) فكوا العاني وأجيبوا الداعي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4404 - (@)(@@) عبد الله بن عمرو(@)(@@) فرقوا بين أولادكم في المضاجع إذا بلغوا سبع سنين(@)(@@) فصل في تفسير آي من القرآن(@)(@@)(@@)(@@) | 4405 - (@)(@@) ابن عباس(@)(@@) {فاذكروني أذكركم} يقول اذكروني يا معشر العباد بطاعتي أذكركم بمغفرتي(@)(@@)(@@)(@@) | 4406 - (@)(@@) أنس بن مالك(@)(@@) {فلما تجلى ربه للجبل جعله دكا} وضع إبهامه على قريب من طرف أنملة خضرة فساخ الجبل(@)(@@)(@@)(@@) | 4407 - (@)(@@) أنس بن مالك(@)(@@) فلما تجلى ربه جعله دكا طارت لعظمته ستة أجبل فوقعت ثلاثة بالمدينة وثلاثة بمكة أحد وورقا ورضوى بالمدينة ووقع بمكة ثور وثبير وحرى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4408 - (@)(@@) أبي بن كعب(@)(@@) {فلما بلغا مجمع بينهما} افريقية(@)(@@)(@@)(@@) | 4409 - (@)(@@) ابن عباس(@)(@@) فاقرءوا ما تيسر من القرآن مائة آية(@)(@@)(@@)(@@) | 4409 - (@)(@@) مكرر علي بن أبي طالب(@)(@@) {فتلقى آدم من ربه كلمات فتاب عليه} فقال إن الله أهبط آدم بالهند وحواء بجدة وإبليس ببيسان والحية بأصبهان وكان للحية قوائم كقوائم البعير ومكث آدم بالهند مائة سنة باكيا على خطيئته حتى بعث الله إليه جبريل عليه السلام قال يا آدم ألم أخلقك بيدي ألم أنفخ فيك من روحي ألم أسجد لك ملائكتي ألم أزوجك حواء أمتي قال نعم قال فما هذا البكاء قال وما يمنعني من البكاء وقد أخرجت من جوار الرحمن قال فعليك بهذه الكلمات التي أعلمكهن فإن الله قابل توبتك وغافر ذنبك قال وما هن قال قل اللهم إني أسألك بحق محمد وآل محمد سبحانك لا إله إلا أنت عملت سوءا وظلمت نفسي فاغفر لي إنك أنت الغفور الرحيم اللهم إني أسألك بحق محمد وآل محمد سبحانك لا إله إلا أنت عملت سوءا 
ms299	 وظلمت نفسي تب علي إنك أنت التواب الرحيم فهؤلاء الكلمات التي تلقى آدم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4410 - (@)(@@) ابن مسعود(@)(@@) {فيوفيهم أجورهم} يدخلهم الجنة ويزيدهم من فضله الشفاعة لمن وجبت له النار ممن صنع إليهم المعروف في الدنيا(@)(@@)(@@)(@@) | 4411 - (@)(@@) أنس بن مالك(@)(@@) فوربك لنسألهم أجمعين عما كانوا يعملون عن قول لا إله إلا الله(@)(@@)(@@)(@@) | 4412 - (@)(@@) جابر(@)(@@) {فسوف يأتي الله بقوم يحبهم ويحبونه} هو لأقوام من اليمن ثم من كندة(@)(@@)(@@)(@@) | 4413 - (@)(@@) أبي بن كعب(@)(@@) {فطفق مسحا بالسوق} والأعناق قطع سوقها وعراقبها بالسيف(@)(@@) سميت الساق ساقا لأنها سوق الجسد(@)(@@)(@@)(@@) | 4414 - (@)(@@) أبي بن كعب(@)(@@) {فارتدا على آثارهما قصصا} يقصان الأثر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4414 - (@)(@@) مكرر أبي بن كعب(@)(@@) {فأبوا أن يضيفوهما} كانوا أهل فدية لئام(@)(@@)(@@)(@@) | 4415 - (@)(@@) أبو هريرة(@)(@@) {فإن له معيشة ضنكا} عذاب القبر(@)(@@)(@@)(@@) | 4416 - (@)(@@) أنس بن مالك(@)(@@) {فمحونا آية الليل وجعلنا آية النهار مبصرة} هو هذا السواد الذي يكون منه في القمر(@)(@@)(@@)(@@) | 4416 - (@)(@@) مكرر ابن عمر(@)(@@) {فمن تصدق به فهو كفارة له} هو الرجل يكسر سنه أو يخرج من جسده فيعفو عنه فتحط عنه من خطاياه بقدر ما عفا عنه من جسده إن كان نصف الدية فنصف خطاياه وإن كان ربع الدية فربع خطاياه وإن كان ثلث الدية فثلث خطاياه وإن كان الدية كلها فخطاياه كلها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4417 - (@)(@@) جابر بن عبد الله(@)(@@) {فإما نذهبن بك فإنا منهم منتقمون} نزلت في علي بن أبي طالب أنه ينتقم من الناكثين والقاسطين بعدي(@)(@@)(@@)(@@) | 4417 - (@)(@@) مكرر أم سلمة(@)(@@) {فيهن خيرات حسان} خيرات الأخلاق حسان الوجوه(@)(@@)(@@)(@@) | 4418 - (@)(@@) أنس بن مالك(@)(@@) {فألهمها فجورها وتقواها} ألزمها(@)(@@) فصل من ذوات الألف واللام(@)(@@)(@@)(@@) | 4418 - (@)(@@) مكرر أنس(@)(@@) الفقر شين عند الناس وزين عند الله يوم القيامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4419 - (@)(@@) عائشة(@)(@@) الفقر راحة والغنى عقوبة والعقل هدية من الله عز وجل والجهل ضلالة والموت غنيمة والمعصية مصيبة(@)(@@)(@@)(@@) | 4420 - (@)(@@) ابن عمر(@)(@@) الفقر أمانة فمن كتمه كان عادة ومن باح به فقد قلد إخوانه المسلمين(@)(@@)(@@)(@@) | 4421 - (@)(@@) أبو سعيد(@)(@@) الفقر إلى من يحبني أسرع من السيل من أعلى الوادي إلى أسفله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4422 - (@)(@@) ابن عباس(@)(@@) الفقر فقران 
ms300	 فقر الدنيا وفقر الآخرة فقر الدنيا غنى الآخرة وغنى الدنيا فقر الآخرة(@)(@@) ذلك الهلاك حب مالها وزينتها فذلك فقر الآخرة وعذاب الدنيا(@)(@@)(@@)(@@) | 4423 - (@)(@@) علي بن أبي طالب(@)(@@) الفقر مخزون عند الله لا يبتلى به إلا من أحب من المؤمنين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4424 - (@)(@@) علي(@)(@@) الفقراء أصدقاء الله تعالى ورأس مالهم الليل والنهار فطوبى لمن أتجر قبل أن يذهب رأس ماله(@)(@@)(@@)(@@) | 4424 - (@)(@@) مكرر علي(@)(@@) الفقراء أصدقاء الله والمرضى أحباء الله فمن مات على التوبة فله الجنة وتوبوا ولا تيأسوا فإن باب التوبة مفتوح من قبل المغرب لا يسد حتى تطلع الشمس منه(@)(@@)(@@)(@@) | 4425 - (@)(@@) أنس بن مالك(@)(@@) الفقراء مناديل الأغنياء يمسحون بهم من ذنوبهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4426 - (@)(@@) أبو هريرة(@)(@@) الفقير إذا اشتهى شيئا ولم يجد ما يشتريه فصبر على ذلك فكسر شهوته فإن أجره أعظم من غني يتصدق بأربعمائة ألف درهم(@)(@@)(@@)(@@) | 4426 - (@)(@@) مكرر أبو ذر(@)(@@) الفقير عند الغنى قينة والضعيف عند القوي قينة والمملوك عند المالك قينة فليتق الله وليكلفه ما يستطع وليعنه عليه فإن لم يفعل فلا يعذبه(@)(@@)(@@)(@@) | 4427 - (@)(@@) ابن مسعود(@)(@@) الفاقة لأصحابي سعادة والغنى للمؤمن في آخر الزمان سعادة إن استطعتم أن تكونوا أغنياء فكونوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4427 - (@)(@@) ابن مسعود(@)(@@) الفاجر الراجي رحمة الله أقرب إليها من العبد المجتهد الآيس منها الذي لا يرجو أن ينالها وهو مطيع لله(@)(@@)(@@)(@@) | 4428 - (@)(@@) ابن عمر(@)(@@) الفتنة ها هنا الفتنة ها هنا من حيث يطلع قرن الشيطان أو قال قرن الشمس(@)(@@) فصل(@)(@@)(@@)(@@) | 4429 - (@)(@@) أبو أمامة(@)(@@) الفردوس طرة في الجنة(@)(@@)(@@)(@@) | 4429 - (@)(@@) مكرر عبد الله بن عمرو(@)(@@) الفلق سجن في جهنم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4430 - (@)(@@) أنس(@)(@@) الفجر فجران يقال السرحان وهو الكذوب يذهب طولا ولا يذهب عرضا والفجر الآخر يذهب عرضا ولا يذهب طولا(@)(@@)(@@)(@@) | 4431 - (@)(@@) ابن عباس(@)(@@) الفجر فجران فجر يحرم فيه الطعام وتحل فيه الصلاة وفجر تحرم فيه الصلاة ويحل فيه الطعام(@)(@@)(@@)(@@) | 4431 - (@)(@@) مكرر ابن عباس(@)(@@) الفخذ عورة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4432 - (@)(@@) أبو هريرة(@)(@@) الفخذ عورة والفرج فاحشة(@)(@@)(@@)(@@) | 4433 - (@)(@@) أبو هريرة(@)(@@) الفخر والخيلاء في الفدادين من أهل الوبر والسكينة في أهل الغنم(@)(@@) الفداد الزراع منها الذي لا يرجو 