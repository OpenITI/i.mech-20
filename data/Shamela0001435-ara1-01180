ms1161	 عن مسعر، عن زياد بن علاقة، عن عمه، قال: كان النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «اللهم إني أعوذ بك من منكرات الأخلاق، والأعمال والأهواء» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) وعم زياد بن علاقة هو: قطبة بن مالك صاحب النبي صلى الله عليه وسلم " (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٢ - (@)(@@) حدثنا أحمد بن إبراهيم الدورقي قال: حدثنا إسماعيل بن إبراهيم قال: حدثنا الحجاج بن أبي عثمان، عن أبي الزبير، عن عون بن عبد الله، عن ابن عمر، قال: بينا نحن نصلي مع رسول الله صلى الله عليه وسلم، إذ قال رجل من القوم: الله أكبر كبيرا، والحمد لله كثيرا، وسبحان الله بكرة وأصيلا، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من القائل كذا وكذا؟» (@)(@@) فقال رجل من القوم: أنا يا رسول الله، PageV05P575 قال: (@)(@@) @MATN@ «عجبت لها فتحت لها أبواب السماء» (@)(@@) قال ابن عمر: (@)(@@) @MATN@ «ما تركتهن منذ سمعت من رسول الله صلى الله عليه وسلم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب من هذا الوجه» (@)(@@) وحجاج بن أبي عثمان هو: حجاج بن ميسرة الصواف ويكنى أبا الصلت، وهو ثقة عند أهل الحديث " (@) (@)(@) (@)(@@)(@@)(@@) || باب أي الكلام أحب إلى الله (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٣ - (@)(@@) حدثنا أحمد بن إبراهيم الدورقي قال: حدثنا إسماعيل بن إبراهيم قال: أخبرنا الجريري، عن أبي عبد الله الجسري، عن عبد الله بن الصامت، عن أبي ذر، أن رسول الله صلى الله عليه وسلم عاده، - أو أن أبا ذر عاد رسول الله صلى الله عليه وسلم - فقال: بأبي أنت وأمي يا رسول الله، أي الكلام أحب إلى الله عز وجل؟ قال: (@)(@@) @MATN@ " ما اصطفى الله لملائكته: سبحان ربي وبحمده، سبحان ربي وبحمده " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب في العفو والعافية (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٤ - (@)(@@) حدثنا أبو هشام الرفاعي محمد بن يزيد الكوفي قال: حدثنا يحيى بن اليمان قال: حدثنا سفيان، عن زيد العمي، عن أبي إياس معاوية PageV05P576 بن قرة، عن أنس بن مالك، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الدعاء لا يرد بين الأذان والإقامة» ، (@)(@@) قالوا: فماذا نقول يا رسول الله؟ قال: (@)(@@) @MATN@ «سلوا الله 
ms1162	 العافية في الدنيا والآخرة» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد زاد يحيى بن اليمان في هذا الحديث هذا الحرف، قالوا: فماذا نقول؟ قال: (@)(@@) @MATN@ «سلوا الله العافية في الدنيا والآخرة» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع، وعبد الرزاق، وأبو أحمد، وأبو نعيم، عن سفيان، عن زيد العمي، عن معاوية بن قرة، عن أنس، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «الدعاء لا يرد بين الأذان والإقامة» : (@)(@@) وهكذا روى أبو إسحاق الهمداني، هذا الحديث عن بريد بن أبي مريم الكوفي، عن أنس، عن النبي صلى الله عليه وسلم نحو هذا، وهذا أصح (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٦ - (@)(@@) حدثنا أبو كريب محمد بن العلاء قال: أخبرنا أبو معاوية، عن عمر بن راشد، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «سبق المفردون» ، (@)(@@) قالوا: وما المفردون يا رسول الله؟ قال: (@)(@@) @MATN@ «المستهترون في ذكر الله، يضع الذكر عنهم أثقالهم فيأتون يوم القيامة خفافا» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٧ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو معاوية، عن الأعمش، عن PageV05P577 أبي صالح، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لأن أقول سبحان الله، والحمد لله، ولا إله إلا الله والله أكبر، أحب إلي مما طلعت عليه الشمس» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٨ - (@)(@@) حدثنا أبو كريب قال: حدثنا عبد الله بن نمير، عن سعدان القبي، عن أبي مجاهد، عن أبي مدلة، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " ثلاثة لا ترد دعوتهم: الصائم حتى يفطر، والإمام العادل، ودعوة المظلوم يرفعها الله فوق الغمام ويفتح لها أبواب السماء ويقول الرب: وعزتي لأنصرنك ولو بعد حين " : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وسعدان القبي هو: سعدان بن بشر، وقد روى عنه عيسى بن يونس، وأبو عاصم، وغير واحد من كبار أهل الحديث، وأبو مجاهد هو: سعد الطائي، وأبو مدلة هو: مولى أم المؤمنين عائشة، وإنما نعرفه بهذا الحديث، ويروى عنه هذا الحديث أطول من هذا وأتم (@)(@) (@)(@@)(@@)(@@) ||| ٣٥٩٩ - (@)(@@) حدثنا 
ms1163	 أبو كريب قال: حدثنا عبد الله بن نمير، عن موسى بن عبيدة، عن محمد بن ثابت، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اللهم انفعني بما علمتني، وعلمني ما ينفعني، وزدني علما، الحمد لله على كل حال، وأعوذ بالله من حال أهل النار» : (@)(@@) @MATN@ «هذا حديث غريب من هذا الوجه» (@)(@@) (@)PageV05P578 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء إن لله ملائكة سياحين في الأرض (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٠ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، أو عن أبي سعيد، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " إن لله ملائكة سياحين في الأرض فضلا عن كتاب الناس، فإذا وجدوا أقواما يذكرون الله تنادوا: هلموا إلى بغيتكم، فيجيئون فيحفون بهم إلى سماء الدنيا، فيقول الله: أي شيء تركتم عبادي يصنعون، فيقولون: تركناهم يحمدونك ويمجدونك ويذكرونك، قال: فيقول: فهل رأوني، فيقولون: لا، قال: فيقول: فكيف لو رأوني؟ قال: فيقولون: لو رأوك لكانوا أشد تحميدا، وأشد تمجيدا، وأشد لك ذكرا، قال: فيقول: وأي شيء يطلبون؟ قال: فيقولون: يطلبون الجنة، قال: فيقول: وهل رأوها؟ قال: فيقولون: لا، فيقول: فكيف لو رأوها؟ قال: فيقولون: لو رأوها؟ لكانوا أشد لها طلبا، وأشد عليها حرصا، قال: فيقول: فمن أي شيء يتعوذون؟ قالوا: يتعوذون من النار، قال: فيقول: وهل رأوها؟ فيقولون: لا، فيقول: فكيف لو رأوها؟ فيقولون: لو رأوها لكانوا منها أشد هربا، وأشد منها خوفا، وأشد منها تعوذا، قال: فيقول: فإني أشهدكم أني قد غفرت لهم، PageV05P579 فيقولون: إن فيهم فلانا الخطاء لم يردهم إنما جاءهم لحاجة، فيقول: هم القوم لا يشقى لهم جليس " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» ، (@)(@@) @MATN@ «وقد روي عن أبي هريرة من غير هذا الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠١ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو خالد الأحمر، عن هشام بن الغاز، عن مكحول، عن أبي هريرة، قال: قال لي رسول الله صلى الله عليه وسلم (@)(@@) @MATN@ " أكثر من قول: لا حول ولا قوة إلا بالله، فإنها من كنز الجنة " قال مكحول، فمن قال لا حول ولا قوة 
ms1164	 إلا بالله ولا منجى من الله إلا إليه: كشف عنه سبعين بابا من الضر أدناهن الفقر. هذا حديث ليس إسناده بمتصل، مكحول لم يسمع من أبي هريرة (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٢ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لكل نبي دعوة مستجابة، وإني اختبأت دعوتي شفاعة لأمتي، وهي نائلة إن شاء الله من مات منهم لا يشرك بالله شيئا» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) (@)PageV05P580 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٣ - (@)(@@) حدثنا أبو كريب قال: حدثنا ابن نمير، وأبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " يقول الله عز وجل: أنا عند ظن عبدي بي وأنا معه حين يذكرني، فإن ذكرني في نفسه ذكرته في نفسي، وإن ذكرني في ملأ ذكرته في ملأ خير منهم، وإن اقترب إلي شبرا اقتربت منه ذراعا، وإن اقترب إلي ذراعا اقتربت إليه باعا، وإن أتاني يمشي أتيته هرولة " . هذا حديث حسن صحيح. ويروى عن الأعمش في تفسير هذا الحديث: (@)(@@) @MATN@ «من تقرب مني شبرا تقربت منه ذراعا، يعني بالمغفرة والرحمة» ، (@)(@@) وهكذا فسر بعض أهل العلم هذا الحديث. قالوا: إنما معناه يقول: إذا تقرب إلي العبد بطاعتي وبما أمرت تسارع إليه مغفرتي ورحمتي (@)PageV05P581 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٤ - (@)(@@) حدثنا أبو كريب قال: حدثنا أبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «استعيذوا بالله من عذاب جهنم، واستعيذوا بالله من عذاب القبر. استعيذوا بالله من فتنة المسيح الدجال، واستعيذوا بالله من فتنة المحيا والممات» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) (@)PageV05P582 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيى بن موسى قال: أخبرنا يزيد بن هارون قال: أخبرنا هشام بن حسان، عن سهيل بن أبي صالح، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " من قال حين يمسي ثلاث مرات: أعوذ بكلمات الله التامات من شر ما خلق، لم يضره حمة تلك الليلة " قال سهيل: فكان أهلنا تعلموها فكانوا يقولونها كل 
ms1165	 ليلة فلدغت جارية منهم فلم تجد لها وجعا: (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وروى مالك بن أنس، هذا الحديث عن سهيل بن أبي صالح، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم وروى عبيد الله بن عمر، وغير واحد هذا الحديث عن سهيل، ولم يذكروا فيه عن أبي هريرة (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيى بن موسى قال: أخبرنا وكيع قال: أخبرنا أبو فضالة الفرج بن فضالة، عن أبي سعيد الحمصي، أن أبا هريرة، قال: دعاء حفظته من رسول الله صلى الله عليه وسلم لا أدعه: (@)(@@) @MATN@ «اللهم اجعلني أعظم شكرك، وأكثر ذكرك، وأتبع نصيحتك، وأحفظ وصيتك» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيى بن موسى قال: أخبرنا أبو معاوية قال: أخبرنا الليث هو ابن أبي سليم، عن زياد، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ما من رجل يدعو الله بدعاء إلا استجيب له، فإما أن يعجل في الدنيا، وإما أن يدخر له في الآخرة، وإما أن يكفر عنه من ذنوبه بقدر ما دعا، ما لم يدع بإثم أو قطيعة رحم أو يستعجل» . (@)(@@) قالوا: يا رسول الله وكيف يستعجل؟ قال: (@)(@@) @MATN@ " يقول: دعوت ربي فما استجاب لي " : (@)(@@) @MATN@ «هذا حديث غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@) حدثنا يحيى قال: أخبرنا يعلى بن عبيد، قال: أخبرنا يحيى بن عبيد الله، عن أبيه، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ما من عبد يرفع يديه حتى يبدو إبطه يسأل الله مسألة، إلا آتاها إياه ما لم يعجل» ، (@)(@@) قالوا: يا رسول الله وكيف عجلته؟ قال: (@)(@@) @MATN@ " يقول: قد سألت وسألت ولم أعط شيئا " وروى هذا الحديث الزهري، عن أبي عبيد مولى ابن أزهر، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «يستجاب لأحدكم ما لم يعجل، يقول دعوت فلم يستجب لي» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيي بن موسى قال: أخبرنا أبو داود قال: أخبرنا صدقة بن موسى قال: أخبرنا محمد بن واسع، عن سمير بن نهار العبدي، عن أبي هريرة، قال: قال رسول 
ms1166	 الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن حسن الظن بالله من حسن عبادة الله» : (@)(@@) @MATN@ «هذا حديث غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيى بن موسى قال: أخبرنا عمرو بن عون قال: أخبرنا أبو عوانة، عن عمر بن أبي سلمة، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لينظرن أحدكم ما الذي يتمنى فإنه لا يدري ما يكتب له من أمنيته» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا يحيى بن موسى قال: أخبرنا جابر بن نوح، قال: أخبرنا محمد بن عمرو، عن أبي سلمة، عن أبي هريرة، قال: كان رسول الله صلى الله عليه وسلم يدعو فيقول: (@)(@@) @MATN@ «اللهم متعني بسمعي وبصري واجعلهما الوارث مني، وانصرني على من يظلمني، وخذ منه بثأري» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@) حدثنا أبو داود سليمان بن الأشعث السجزي قال: حدثنا قطن البصري قال: أخبرنا جعفر بن سليمان، عن ثابت، عن أنس، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ليسأل أحدكم ربه حاجته كلها حتى يسأل شسع نعله إذا انقطع» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) وروى غير واحد هذا الحديث عن جعفر بن سليمان، عن ثابت البناني، عن النبي صلى الله عليه وسلم ولم يذكروا فيه عن أنس (@)(@) (@)(@@) حدثنا صالح بن عبد الله قال: أخبرنا جعفر بن سليمان، عن ثابت البناني، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ليسأل أحدكم ربه حاجته حتى يسأله الملح، وحتى يسأله شسع نعله إذا انقطع» (@)(@@) وهذا أصح من حديث قطن، عن جعفر بن سليمان " (@)(@) (@)(@@)(@@)(@@) | ٤٦ - أبواب المناقب عن رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) || باب في فضل النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٥ - (@)(@@) حدثنا خلاد بن أسلم قال: حدثنا محمد بن مصعب قال: حدثنا الأوزاعي، عن أبي عمار، عن واثلة بن الأسقع، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الله اصطفى من ولد إبراهيم، إسماعيل، واصطفى من ولد إسماعيل بني كنانة، واصطفى من بني كنانة قريشا، واصطفى من قريش بني هاشم، واصطفاني من بني هاشم» : (@)(@@) @MATN@ «هذا حديث 
ms1167	 حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٦ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا سليمان بن عبد الرحمن الدمشقي قال: حدثنا الوليد بن مسلم قال: حدثنا الأوزاعي قال: حدثني شداد أبو عمار قال: حدثني واثلة بن الأسقع، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الله اصطفى كنانة من ولد إسماعيل، واصطفى قريشا من كنانة، واصطفى هاشما من قريش، واصطفاني من بني هاشم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)PageV05P583 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٧ - (@)(@@) حدثنا يوسف بن موسى البغدادي قال: حدثنا عبيد الله بن موسى، عن إسماعيل بن أبي خالد، عن يزيد بن أبي زياد، عن عبد الله بن الحارث، عن العباس بن عبد المطلب، قال: قلت: يا رسول الله إن قريشا جلسوا فتذاكروا أحسابهم بينهم، فجعلوا مثلك كمثل نخلة في كبوة من الأرض، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الله خلق الخلق فجعلني من خيرهم من خير فرقهم وخير الفريقين، ثم تخير القبائل فجعلني من خير قبيلة، ثم تخير البيوت فجعلني من خير بيوتهم، فأنا خيرهم نفسا، وخيرهم بيتا» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وعبد الله بن الحارث هو: ابن نوفل (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٨ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو أحمد قال: حدثنا سفيان، عن يزيد بن أبي زياد، عن عبد الله بن الحارث، عن المطلب بن أبي وداعة، قال: جاء العباس إلى رسول الله صلى الله عليه وسلم فكأنه سمع شيئا فقام النبي صلى الله عليه وسلم على المنبر فقال: (@)(@@) @MATN@ «من أنا» ؟ (@)(@@) قالوا: أنت رسول الله عليك السلام. قال: (@)(@@) @MATN@ «أنا محمد بن عبد الله بن عبد المطلب، إن الله خلق الخلق فجعلني في خيرهم فرقة، ثم جعلهم فرقتين فجعلني في خيرهم فرقة، ثم جعلهم قبائل فجعلني في خيرهم قبيلة، ثم جعلهم بيوتا فجعلني في خيرهم بيتا وخيرهم نفسا» . (@)(@@) هذا حديث حسن (@)PageV05P584 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٠٩ - (@)(@@) حدثنا أبو همام الوليد بن شجاع بن الوليد البغدادي قال: حدثنا الوليد بن مسلم، عن الأوزاعي، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة، قال: قالوا يا رسول الله متى وجبت لك النبوة؟ قال: 
ms1168	 (@)(@@) @MATN@ «وآدم بين الروح والجسد» : (@)(@@) @MATN@ «هذا حديث حسن غريب من حديث أبي هريرة لا نعرفه إلا من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٠ - (@)(@@) حدثنا الحسين بن يزيد الكوفي قال: حدثنا عبد السلام بن حرب، عن ليث، عن الربيع بن أنس، عن أنس بن مالك، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أنا أول الناس خروجا إذا بعثوا، وأنا خطيبهم إذا وفدوا، وأنا مبشرهم إذا أيسوا، لواء الحمد يومئذ بيدي، وأنا أكرم ولد آدم على ربي ولا فخر» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@)PageV05P585 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١١ - (@)(@@) حدثنا الحسين بن يزيد قال: حدثنا عبد السلام بن حرب، عن يزيد أبي خالد، عن المنهال بن عمرو، عن عبد الله بن الحارث، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أنا أول من تنشق عنه الأرض فأكسى الحلة من حلل الجنة، ثم أقوم عن يمين العرش ليس أحد من الخلائق يقوم ذلك المقام غيري» . (@)(@@) هذا حديث حسن غريب (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٢ - (@)(@@) حدثنا بندار قال: حدثنا أبو عاصم قال: حدثنا سفيان وهو الثوري، عن ليث وهو ابن أبي سليم قال: حدثني كعب قال: حدثني أبو هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «سلوا الله لي الوسيلة» (@)(@@) قالوا: يا رسول الله وما الوسيلة؟ قال: (@)(@@) @MATN@ «أعلى درجة في الجنة لا ينالها إلا رجل واحد أرجو أن أكون أنا هو» . (@)(@@) هذا حديث غريب وإسناده ليس بالقوي. وكعب ليس هو بمعروف، ولا نعلم أحدا روى عنه غير ليث بن أبي سليم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٣ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عامر قال: حدثنا زهير بن محمد، عن عبد الله بن محمد بن عقيل، عن الطفيل بن أبي بن كعب، عن أبيه، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ " مثلي في النبيين كمثل رجل بنى دارا فأحسنها وأكملها وأجملها وترك منها موضع لبنة، فجعل الناس يطوفون بالبناء ويعجبون منه، ويقولون: لو تم موضع تلك اللبنة، وأنا في النبيين موضع تلك اللبنة " (@)(@) (@)(@@) وبهذا الإسناد عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «إذا 
ms1169	 كان يوم القيامة كنت إمام النبيين وخطيبهم وصاحب شفاعتهم، غير فخر» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٤ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا عبد الله بن يزيد المقرئ قال: حدثنا حيوة قال: أخبرنا كعب بن علقمة، سمع عبد الرحمن بن جبير، أنه سمع عبد الله بن عمرو، أنه سمع النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «إذا سمعتم المؤذن فقولوا مثل ما يقول، ثم صلوا علي، PageV05P586 فإنه من صلى علي صلاة صلى الله عليه بها عشرا، ثم سلوا لي الوسيلة فإنها منزلة في الجنة لا تنبغي إلا لعبد من عباد الله وأرجو أن أكون أنا هو، ومن سأل لي الوسيلة حلت عليه الشفاعة» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) قال محمد: عبد الرحمن بن جبير هذا قرشي وهو مصري وعبد الرحمن بن جبير بن نفير شامي (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن ابن جدعان، عن أبي نضرة، عن أبي سعيد، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أنا سيد ولد آدم يوم القيامة ولا فخر، وبيدي لواء الحمد ولا فخر، وما من نبي يومئذ آدم فمن سواه إلا تحت لوائي، وأنا أول من تنشق عنه الأرض ولا فخر» . (@)(@@) وفي الحديث قصة وهذا حديث حسن (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٦ - (@)(@@) حدثنا علي بن نصر بن علي قال: حدثنا عبيد الله بن عبد المجيد قال: حدثنا زمعة بن صالح، عن سلمة بن وهرام، عن عكرمة، عن ابن عباس، قال: جلس ناس من أصحاب رسول الله صلى الله عليه وسلم ينتظرونه قال: فخرج حتى إذا دنا منهم سمعهم يتذاكرون فسمع حديثهم، فقال بعضهم: عجبا إن الله عز وجل اتخذ من خلقه خليلا، اتخذ من إبراهيم خليلا، وقال آخر: ماذا بأعجب من كلام موسى كلمه تكليما، وقال PageV05P587 آخر: فعيسى كلمة الله وروحه، وقال آخر: آدم اصطفاه الله. فخرج عليهم فسلم وقال: (@)(@@) @MATN@ «قد سمعت كلامكم وعجبكم إن إبراهيم خليل الله وهو كذلك وموسى نجي الله وهو كذلك، وعيسى روحه وكلمته وهو كذلك وآدم اصطفاه الله وهو كذلك، ألا 
ms1170	 وأنا حبيب الله ولا فخر، وأنا حامل لواء الحمد يوم القيامة ولا فخر، وأنا أول شافع وأول مشفع يوم القيامة ولا فخر، وأنا أول من يحرك حلق الجنة فيفتح الله لي فيدخلنيها ومعي فقراء المؤمنين ولا فخر، وأنا أكرم الأولين والآخرين ولا فخر» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٧ - (@)(@@) حدثنا زيد بن أخزم الطائي البصري قال: حدثنا أبو قتيبة سلم بن قتيبة قال: حدثني أبو مودود المدني قال: حدثنا عثمان بن الضحاك، عن محمد بن يوسف بن عبد الله بن سلام، عن أبيه، عن جده، قال: (@)(@@) @MATN@ «مكتوب في التوراة صفة محمد وعيسى ابن مريم يدفن معه» (@)(@@) قال: فقال أبو مودود وقد بقي في البيت موضع قبر: (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) هكذا قال: عثمان بن الضحاك، والمعروف الضحاك بن عثمان المديني (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٨ - (@)(@@) حدثنا بشر بن هلال الصواف البصري قال: حدثنا جعفر بن سليمان الضبعي، عن ثابت، عن أنس بن مالك، قال: (@)(@@) @MATN@ «لما كان اليوم الذي دخل فيه رسول الله صلى الله عليه وسلم المدينة أضاء منها كل شيء، فلما كان اليوم الذي مات فيه أظلم منها كل شيء، وما نفضنا PageV05P588 عن رسول الله صلى الله عليه وسلم الأيدي وإنا لفي دفنه حتى أنكرنا قلوبنا» : (@)(@@) @MATN@ «هذا حديث غريب صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ميلاد النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦١٩ - (@)(@@) حدثنا محمد بن بشار العبدي قال: حدثنا وهب بن جرير قال: حدثنا أبي، قال: سمعت محمد بن إسحاق، يحدث عن المطلب بن عبد الله بن قيس بن مخرمة، عن أبيه، عن جده، قال: (@)(@@) @MATN@ «ولدت أنا ورسول الله صلى الله عليه وسلم عام الفيل» ، (@)(@@) قال: وسأل عثمان بن عفان قباث بن أشيم أخا بني يعمر بن ليث: أنت أكبر أم رسول الله صلى الله عليه وسلم؟ فقال: (@)(@@) @MATN@ «رسول الله صلى الله عليه وسلم أكبر مني وأنا أقدم منه في الميلاد» ، (@)(@@) قال: (@)(@@) @MATN@ «ورأيت خذق الفيل أخضر محيلا» . (@)(@@) هذا حديث حسن غريب لا نعرفه إلا من حديث محمد بن إسحاق (@)PageV05P589 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في بدء نبوة النبي 
ms1171	 صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٠ - (@)(@@) حدثنا الفضل بن سهل أبو العباس الأعرج البغدادي قال: حدثنا عبد الرحمن بن غزوان قال: أخبرنا يونس بن أبي إسحاق، عن أبي بكر بن أبي موسى الأشعري، عن أبيه، قال: (@)(@@) @MATN@ «خرج أبو طالب إلى الشام وخرج معه النبي صلى الله عليه وسلم في أشياخ من قريش، فلما أشرفوا على الراهب هبطوا فحلوا رحالهم، فخرج إليهم الراهب وكانوا قبل ذلك يمرون به فلا يخرج إليهم ولا يلتفت» . (@)(@@) قال: (@)(@@) @MATN@ " فهم يحلون رحالهم، فجعل يتخللهم الراهب حتى جاء فأخذ بيد رسول الله صلى الله عليه وسلم، فقال: هذا سيد العالمين، هذا رسول رب العالمين، يبعثه الله رحمة للعالمين " ، فقال له أشياخ من قريش: ما علمك، فقال: إنكم حين أشرفتم من العقبة لم يبق شجر ولا حجر إلا خر ساجدا ولا يسجدان إلا لنبي، وإني أعرفه بخاتم النبوة أسفل من غضروف كتفه مثل التفاحة، ثم رجع فصنع لهم طعاما، فلما أتاهم به وكان هو في رعية الإبل، قال: أرسلوا إليه، فأقبل وعليه غمامة تظله، فلما دنا من القوم وجدهم قد سبقوه إلى فيء الشجرة، فلما جلس مال فيء الشجرة عليه، فقال: انظروا إلى فيء الشجرة مال عليه، قال: فبينما هو قائم عليهم وهو يناشدهم أن لا يذهبوا به إلى الروم، فإن الروم إن رأوه عرفوه بالصفة فيقتلونه، PageV05P590 فالتفت فإذا بسبعة قد أقبلوا من الروم فاستقبلهم، فقال: ما جاء بكم؟ قالوا: جئنا، إن هذا النبي خارج في هذا الشهر، فلم يبق طريق إلا بعث إليه بأناس وإنا قد أخبرنا خبره فبعثنا إلى طريقك هذا، فقال: هل خلفكم أحد هو خير منكم؟ قالوا: إنما أخبرنا خبره بطريقك هذا. قال: أفرأيتم أمرا أراد الله أن يقضيه هل يستطيع أحد من الناس رده؟ قالوا: لا، قال: فبايعوه وأقاموا معه قال: أنشدكم بالله أيكم وليه؟ قالوا: أبو طالب، فلم يزل يناشده حتى رده أبو طالب وبعث معه أبو بكر بلالا وزوده الراهب من الكعك والزيت ": (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه إلا من هذا 
ms1172	 الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب في مبعث النبي صلى الله عليه وسلم، وابن كم كان حين بعث؟ (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢١ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا محمد بن بشار قال: حدثنا ابن أبي عدي، عن هشام بن حسان، عن عكرمة، عن ابن عباس، قال: (@)(@@) @MATN@ «أنزل على رسول الله صلى الله عليه وسلم وهو ابن أربعين، فأقام بمكة ثلاث عشرة وبالمدينة عشرا، وتوفي وهو ابن ثلاث وستين» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا ابن أبي عدي، عن هشام، عن عكرمة، عن ابن عباس، قال: (@)(@@) @MATN@ «قبض النبي صلى الله عليه وسلم وهو ابن PageV05P591 خمس وستين سنة» : " (@)(@@) هكذا حدثنا محمد بن بشار، وروى عنه محمد بن إسماعيل، مثل ذلك (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٣ - (@)(@@) حدثنا قتيبة، عن مالك بن أنس، ح وحدثنا الأنصاري قال: حدثنا معن قال: حدثنا مالك بن أنس، عن ربيعة بن أبي عبد الرحمن، أنه سمع أنس بن مالك، يقول: (@)(@@) @MATN@ «لم يكن رسول الله صلى الله عليه وسلم بالطويل البائن، ولا بالقصير، ولا بالأبيض الأمهق، ولا بالآدم، وليس بالجعد القطط، ولا بالسبط، بعثه الله على رأس أربعين سنة فأقام بمكة عشر سنين وبالمدينة عشرا، وتوفاه الله على رأس ستين سنة، وليس في رأسه ولحيته عشرون شعرة بيضاء» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب في آيات نبوة النبي صلى الله عليه وسلم وما قد خصه الله عز وجل به (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٤ - (@)(@@) حدثنا محمد بن بشار، ومحمود بن غيلان، قالا: أخبرنا أبو داود الطيالسي قال: حدثنا سليمان بن معاذ الضبي، عن سماك بن حرب، PageV05P592 عن جابر بن سمرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن بمكة حجرا كان يسلم علي ليالي بعثت، إني لأعرفه الآن» . (@)(@@) هذا حديث حسن غريب (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٥ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يزيد بن هارون قال: حدثنا سليمان التيمي، عن أبي العلاء، عن سمرة بن جندب، قال: (@)(@@) @MATN@ " كنا مع رسول الله صلى الله عليه وسلم نتداول في قصعة من غدوة حتى الليل يقوم عشرة ويقعد عشرة، قلنا: فما كانت تمد " ؟ قال: (@)(@@) @MATN@ «من 
ms1173	 أي شيء تعجب ‍ ما كانت تمد إلا من هاهنا وأشار بيده إلى السماء» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وأبو العلاء اسمه: يزيد بن عبد الله بن الشخير (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٦ - (@)(@@) حدثنا عباد بن يعقوب الكوفي قال: حدثنا الوليد بن أبي ثور، عن السدي، عن عباد بن أبي يزيد، عن علي بن أبي طالب، قال: (@)(@@) @MATN@ " كنت مع النبي صلى الله عليه وسلم بمكة فخرجنا في بعض نواحيها فما استقبله جبل ولا شجر إلا وهو يقول: السلام عليك يا رسول الله " : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) وروى غير واحد عن الوليد بن أبي ثور، وقال: عن عباد بن أبي يزيد، منهم فروة بن أبي المغراء (@)PageV05P593 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٧ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا عمر بن يونس، عن عكرمة بن عمار، عن إسحاق بن عبد الله بن أبي طلحة، عن أنس بن مالك، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم خطب إلى لزق جذع واتخذوا له منبرا، فخطب عليه فحن الجذع حنين الناقة، فنزل النبي صلى الله عليه وسلم فمسه فسكت» (@)(@@) وفي الباب عن أبي، وجابر، وابن عمر، وسهل بن سعد، وابن عباس، وأم سلمة. حديث أنس هذا حديث حسن صحيح غريب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٨ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا محمد بن سعيد قال: حدثنا شريك، عن سماك، عن أبي ظبيان، عن ابن عباس، قال: جاء أعرابي إلى رسول الله صلى الله عليه وسلم، فقال بم أعرف أنك نبي؟ قال: (@)(@@) @MATN@ «إن دعوت هذا العذق من هذه النخلة تشهد أني رسول الله؟» (@)(@@) فدعاه رسول الله صلى الله عليه وسلم، فجعل ينزل من النخلة حتى سقط إلى النبي صلى الله عليه وسلم، ثم قال: (@)(@@) @MATN@ «ارجع فعاد» ، (@)(@@) فأسلم الأعرابي: (@)(@@) @MATN@ «هذا حديث حسن غريب صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٢٩ - (@)(@@) حدثنا بندار قال: حدثنا أبو عاصم قال: حدثنا عزرة بن ثابت قال: حدثنا علباء بن أحمر قال: حدثنا أبو زيد بن أخطب، قال: (@)(@@) @MATN@ «مسح رسول الله صلى الله عليه وسلم يده على وجهي ودعا لي» (@)(@@) قال عزرة: إنه عاش مائة وعشرين سنة وليس في رأسه 
ms1174	 إلا شعيرات بيض: (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) وأبو زيد اسمه: عمرو بن أخطب (@)PageV05P594 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٠ - (@)(@@) حدثنا إسحاق بن موسى الأنصاري قال: حدثنا معن، قال: عرضت على مالك بن أنس، عن إسحاق بن عبد الله بن أبي طلحة، أنه سمع أنس بن مالك، يقول: قال أبو طلحة لأم سليم: لقد سمعت صوت رسول الله صلى الله عليه وسلم - ضعيفا - أعرف فيه الجوع فهل عندك من شيء؟ فقالت: نعم، فأخرجت أقراصا من شعير، ثم أخرجت خمارا لها فلفت الخبز ببعضه، ثم دسته في يدي وردتني ببعضه، ثم أرسلتني إلى رسول الله صلى الله عليه وسلم قال: فذهبت به إليه فوجدت رسول الله صلى الله عليه وسلم جالسا في المسجد ومعه الناس، قال: فقمت عليهم، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أرسلك أبو طلحة؟» (@)(@@) فقلت نعم. قال: (@)(@@) @MATN@ «بطعام؟» (@)(@@) فقلت نعم، فقال رسول الله صلى الله عليه وسلم لمن معه: (@)(@@) @MATN@ «قوموا» ، (@)(@@) قال: فانطلقوا، فانطلقت بين أيديهم حتى جئت أبا طلحة فأخبرته، فقال أبو طلحة: يا أم سليم قد جاء رسول الله صلى الله عليه وسلم والناس معه وليس عندنا ما نطعمهم. قالت أم سليم: الله ورسوله أعلم. قال: فانطلق أبو طلحة حتى لقي رسول الله صلى الله عليه وسلم، فأقبل رسول الله صلى الله عليه وسلم وأبو طلحة معه حتى دخلا، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هلمي يا أم سليم ما عندك؟» (@)(@@) فأتته بذلك الخبز، فأمر به رسول الله صلى الله عليه وسلم ففت وعصرت أم سليم بعكة لها فأدمته، ثم قال فيه رسول الله صلى الله عليه وسلم ما شاء الله أن يقول، ثم قال: (@)(@@) @MATN@ «ائذن لعشرة» ، (@)(@@) فأذن لهم فأكلوا حتى شبعوا، ثم خرجوا، ثم قال: PageV05P595 (@)(@@) @MATN@ «ائذن لعشرة» ، (@)(@@) فأذن لهم فأكلوا حتى شبعوا، ثم خرجوا، فأكل القوم كلهم وشبعوا والقوم سبعون أو ثمانون رجلا: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣١ - (@)(@@) حدثنا إسحاق بن موسى الأنصاري قال: حدثنا معن قال: حدثنا مالك بن أنس، عن إسحاق بن عبد الله بن أبي 
ms1175	 طلحة، عن أنس بن مالك، قال: (@)(@@) @MATN@ «رأيت رسول الله صلى الله عليه وسلم وحانت صلاة العصر والتمس الناس الوضوء فلم يجدوا، فأتي رسول الله صلى الله عليه وسلم بوضوء فوضع رسول الله صلى الله عليه وسلم يده في ذلك الإناء وأمر الناس أن يتوضئوا منه» (@)(@@) قال: (@)(@@) @MATN@ «فرأيت الماء ينبع من تحت أصابعه، فتوضأ الناس حتى توضئوا من عند آخرهم» (@)(@@) وفي الباب عن عمران بن حصين، وابن مسعود، وجابر. (@)(@@) @MATN@ «وحديث أنس حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٢ - (@)(@@) حدثنا الأنصاري إسحاق بن موسى قال: حدثنا يونس بن بكير قال: أخبرنا محمد بن إسحاق قال: حدثني الزهري، عن عروة، عن عائشة، أنها قالت: (@)(@@) @MATN@ «أول ما ابتدئ به رسول الله صلى الله عليه وسلم من النبوة حين أراد الله كرامته ورحمة العباد به أن لا يرى شيئا إلا جاءت كفلق الصبح، فمكث على ذلك ما شاء الله أن يمكث، وحبب إليه الخلوة فلم يكن شيء أحب إليه من أن يخلو» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)PageV05P596 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٣ - (@)(@@) حدثنا محمد بن بشار، قال: حدثنا أبو أحمد الزبيري قال: حدثنا إسرائيل، عن منصور، عن إبراهيم، عن علقمة، عن عبد الله، قال: إنكم تعدون الآيات عذابا وإنا كنا نعدها على عهد رسول الله صلى الله عليه وسلم بركة، لقد كنا نأكل الطعام مع النبي صلى الله عليه وسلم ونحن نسمع تسبيح الطعام. قال: وأتي النبي صلى الله عليه وسلم بإناء فوضع يده فيه فجعل الماء ينبع من بين أصابعه، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «حي على الوضوء المبارك والبركة من السماء» (@)(@@) حتى توضأنا كلنا: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء كيف كان ينزل الوحي على النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٤ - (@)(@@) حدثنا إسحاق بن موسى الأنصاري قال: حدثنا معن قال: حدثنا مالك، عن هشام بن عروة، عن أبيه، عن عائشة، أن الحارث بن هشام، سأل رسول الله صلى الله عليه وسلم: كيف يأتيك الوحي؟ فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أحيانا يأتيني مثل صلصلة الجرس 
ms1176	 وهو أشده علي، وأحيانا يتمثل لي الملك رجلا فيكلمني فأعي ما يقول» . (@)(@@) قالت عائشة: (@)(@@) @MATN@ «فلقد رأيت رسول الله صلى الله عليه وسلم ينزل عليه الوحي في اليوم الشديد البرد فيفصم عنه وإن جبينه ليتفصد عرقا» . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P597 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في صفة النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع قال: حدثنا سفيان، عن أبي إسحاق، عن البراء، قال: (@)(@@) @MATN@ «ما رأيت من ذي لمة في حلة حمراء أحسن من رسول الله صلى الله عليه وسلم، له شعر يضرب منكبيه، بعيد ما بين المنكبين، لم يكن بالقصير ولا بالطويل» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٦ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا حميد بن عبد الرحمن قال: حدثنا زهير، عن أبي إسحاق، قال: سأل رجل البراء: أكان وجه رسول الله صلى الله عليه وسلم مثل السيف؟ قال: (@)(@@) @MATN@ «لا مثل القمر» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٧ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا أبو نعيم قال: حدثنا المسعودي، عن عثمان بن مسلم بن هرمز، عن نافع بن جبير بن مطعم، عن علي، قال: (@)(@@) @MATN@ «لم يكن رسول الله صلى الله عليه وسلم بالطويل ولا بالقصير شثن الكفين والقدمين، ضخم الرأس، ضخم الكراديس طويل المسربة، إذا مشى تكفأ تكفؤا كأنما ينحط من صبب لم أر قبله ولا بعده مثله صلى الله عليه وسلم» . (@)(@@) هذا حديث حسن صحيح. PageV05P598 حدثنا سفيان بن وكيع قال: حدثنا أبي، عن المسعودي، بهذا الإسناد نحوه (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٨ - (@)(@@) حدثنا أبو جعفر محمد بن الحسين بن أبي حليمة من قصر الأحنف، وأحمد بن عبدة الضبي، وعلي بن حجر المعنى واحد، قالوا: حدثنا عيسى بن يونس قال: حدثنا عمر بن عبد الله مولى غفرة قال: حدثني إبراهيم بن محمد، من ولد علي بن أبي طالب قال: كان علي، إذا وصف النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ " ليس بالطويل الممغط ولا بالقصير المتردد وكان ربعة من القوم، ولم يكن بالجعد القطط ولا بالسبط كان جعدا رجلا ولم يكن بالمطهم، 
ms1177	 ولا بالمكلثم، وكان في الوجه تدوير، أبيض مشرب، أدعج العينين، أهدب الأشفار، جليل المشاش، والكتد، أجرد ذو مسربة شثن الكفين والقدمين، إذا مشى تقلع كأنما يمشي في صبب، وإذا التفت التفت معا، بين كتفيه خاتم النبوة وهو خاتم النبيين، أجود الناس صدرا، وأصدق الناس لهجة، وألينهم عريكة، وأكرمهم عشرة، من رآه بديهة هابه، ومن خالطه معرفة أحبه، يقول ناعته: لم أر قبله ولا بعده مثله " : (@)(@@) @MATN@ «هذا حديث ليس إسناده بمتصل» . (@)(@@) قال أبو جعفر: سمعت الأصمعي، يقول في تفسير صفة النبي صلى الله عليه وسلم: الممغط الذاهب طولا. وسمعت أعرابيا يقول في كلامه: تمغط في نشابته أي مدها مدا شديدا. وأما المتردد: فالداخل بعضه في بعض قصرا. وأما القطط. فالشديد الجعودة، والرجل الذي في شعره حجونة أي: ينحني قليلا. PageV05P599 وأما المطهم، فالبادن الكثير اللحم. وأما المكلثم: فالمدور الوجه. وأما المشرب: فهو الذي في بياضه حمرة. والأدعج: الشديد سواد العين، والأهدب، الطويل الأشفار، والكتد، مجتمع الكتفين، وهو الكاهل. والمسربة، هو الشعر الدقيق الذي هو كأنه قضيب من الصدر إلى السرة. والشثن: الغليظ الأصابع من الكفين والقدمين. والتقلع: أن يمشي بقوة. والصبب: الحدور، نقول: انحدرنا في صبوب وصبب. وقوله: جليل المشاش، يريد رءوس المناكب. والعشرة: الصحبة، والعشير: الصاحب. والبديهة: المفاجأة، يقال بدهته بأمر: أي فجأته (@) (@)(@) (@)(@@)(@@)(@@) || باب في كلام النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٣٩ - (@)(@@) حدثنا حميد بن مسعدة قال: حدثنا حميد بن الأسود، عن أسامة بن زيد، عن الزهري، عن عروة، عن عائشة، قالت: (@)(@@) @MATN@ «ما كان رسول الله صلى الله عليه وسلم يسرد سردكم هذا، ولكنه كان يتكلم بكلام يبينه، فصل، يحفظه من جلس إليه» : (@)(@@) @MATN@ «هذا حديث حسن صحيح لا نعرفه إلا من حديث الزهري» ، (@)(@@) وقد رواه يونس بن يزيد، عن الزهري (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٠ - (@)(@@) حدثنا محمد بن يحيى قال: حدثنا أبو قتيبة سلم بن قتيبة، عن عبد الله بن المثنى، عن ثمامة، عن أنس بن مالك، قال: (@)(@@) @MATN@ «كان رسول الله PageV05P600 صلى الله عليه وسلم يعيد الكلمة ثلاثا لتعقل عنه» : (@)(@@) @MATN@ «هذا حديث حسن صحيح 
ms1178	 غريب، إنما نعرفه من حديث عبد الله بن المثنى» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب في بشاشة النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤١ - (@)(@@) حدثنا قتيبة قال: حدثنا ابن لهيعة، عن عبيد الله بن المغيرة، عن عبد الله بن الحارث بن جزء، قال: (@)(@@) @MATN@ «ما رأيت أحدا أكثر تبسما من رسول الله صلى الله عليه وسلم» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)(@) (@)(@@) وقد روي عن يزيد بن أبي حبيب، عن عبد الله بن الحارث بن جزء مثل هذا. (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٢ - (@)(@@) حدثنا بذلك أحمد بن خالد الخلال قال: حدثنا يحيى بن إسحاق قال: حدثنا الليث بن سعد، عن يزيد بن أبي حبيب، عن عبد الله بن الحارث بن جزء، قال: (@)(@@) @MATN@ «ما كان ضحك رسول الله صلى الله عليه وسلم إلا تبسما» : (@)(@@) @MATN@ «هذا حديث صحيح غريب لا نعرفه من حديث ليث بن سعد إلا من هذا الوجه» (@)(@@) (@)PageV05P601 (@)(@) (@)(@@)(@@)(@@) || باب في خاتم النبوة (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٣ - (@)(@@) حدثنا قتيبة قال: حدثنا حاتم بن إسماعيل، عن الجعد بن عبد الرحمن، قال: سمعت السائب بن يزيد، يقول: ذهبت بي خالتي إلى النبي صلى الله عليه وسلم، فقالت: يا رسول الله إن ابن أختي وجع، (@)(@@) @MATN@ «فمسح برأسي ودعا لي بالبركة وتوضأ فشربت من وضوئه، فقمت خلف ظهره فنظرت إلى الخاتم بين كتفيه فإذا هو مثل زر الحجلة» : (@)(@@) @MATN@ " الزر: يقال بيض لها " وفي الباب عن سلمان، وقرة بن إياس المزني، وجابر بن سمرة، وأبي رمثة، وبريدة الأسلمي، وعبد الله بن سرجس، وعمرو بن أخطب، وأبي سعيد: (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٤ - (@)(@@) حدثنا سعيد بن يعقوب الطالقاني قال: حدثنا أيوب بن جابر، عن سماك بن حرب، عن جابر بن سمرة، قال: (@)(@@) @MATN@ " كان خاتم رسول الله صلى الله عليه وسلم: - يعني الذي بين كتفيه - غدة حمراء مثل بيضة الحمامة " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P602 (@)(@) (@)(@@)(@@)(@@) || باب في صفة النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٥ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا عباد بن العوام قال: أخبرنا الحجاج هو ابن أرطاة، عن سماك بن حرب، عن جابر بن سمرة، قال: (@)(@@) @MATN@ " كان في ساقي رسول 
ms1179	 الله صلى الله عليه وسلم حموشة، وكان لا يضحك إلا تبسما، وكنت إذا نظرت إليه قلت: أكحل العينين وليس بأكحل " : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٦ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا أبو قطن قال: حدثنا شعبة، عن سماك بن حرب، عن جابر بن سمرة، قال: (@)(@@) @MATN@ «كان النبي صلى الله عليه وسلم ضليع الفم، أشكل العينين، منهوس العقب» . (@)(@@) هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٧ - (@)(@@) حدثنا أبو موسى محمد بن المثنى، قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن سماك بن حرب، عن جابر بن سمرة، قال: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم ضليع الفم، أشكل العينين، منهوس العقب» (@)(@@) قال شعبة: قلت لسماك: ما ضليع الفم؟ قال: واسع الفم. قلت: ما أشكل العين؟ قال: طويل شق العين. قلت: ما منهوس العقب؟ قال: قليل اللحم. (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P603 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٨ - (@)(@@) حدثنا قتيبة قال: حدثنا ابن لهيعة، عن أبي يونس، عن أبي هريرة، قال: (@)(@@) @MATN@ «ما رأيت شيئا أحسن من رسول الله صلى الله عليه وسلم كأن الشمس تجري في وجهه، وما رأيت أحدا أسرع في مشيه من رسول الله صلى الله عليه وسلم كأنما الأرض تطوى له، إنا لنجهد أنفسنا، وإنه لغير مكترث» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٤٩ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن أبي الزبير، عن جابر، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «عرض علي الأنبياء، فإذا موسى ضرب من الرجال كأنه من رجال شنوءة، ورأيت عيسى ابن مريم، فإذا أقرب الناس من رأيت به شبها عروة بن مسعود، ورأيت إبراهيم فإذا أقرب من رأيت به شبها صاحبكم يعني نفسه، ورأيت جبريل فإذا أقرب من رأيت به شبها دحية» . (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب في سن النبي صلى الله عليه وسلم وابن كم كان حين مات (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥٠ - (@)(@@) حدثنا أحمد بن منيع، ويعقوب بن إبراهيم الدورقي، قالا: حدثنا إسماعيل ابن علية، عن خالد الحذاء، قال: حدثني عمار، مولى بني هاشم قال: سمعت ابن عباس، يقول: (@)(@@) @MATN@ «توفي رسول الله 
ms1180	 صلى الله عليه وسلم وهو ابن خمس وستين» (@)(@@) (@)PageV05P604 (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥١ - (@)(@@) حدثنا نصر بن علي الجهضمي قال: حدثنا بشر بن المفضل قال: حدثنا خالد الحذاء قال: حدثنا عمار، مولى بني هاشم قال: حدثنا ابن عباس، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم توفي وهو ابن خمس وستين» : (@)(@@) @MATN@ «هذا حديث حسن الإسناد صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥٢ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا روح بن عبادة قال: حدثنا زكريا بن إسحاق قال: حدثنا عمرو بن دينار، عن ابن عباس، قال: (@)(@@) @MATN@ «مكث النبي صلى الله عليه وسلم بمكة ثلاث عشرة - يعني يوحى إليه - وتوفي وهو ابن ثلاث وستين» (@)(@@) وفي الباب عن عائشة، وأنس، ودغفل بن حنظلة ولا يصح لدغفل سماع من النبي صلى الله عليه وسلم. وحديث ابن عباس حديث حسن غريب من حديث عمرو بن دينار (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥٣ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن أبي إسحاق، عن عامر بن سعد، عن جرير بن عبد الله، عن معاوية بن أبي سفيان، أنه قال: سمعته يخطب يقول: (@)(@@) @MATN@ «مات رسول الله صلى الله عليه وسلم وهو ابن ثلاث وستين» (@)(@@) وأبو بكر، وعمر، وأنا ابن ثلاث وستين: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥٤ - (@)(@@) حدثنا العباس العنبري، والحسين بن مهدي البصري، قالا: حدثنا عبد الرزاق، عن ابن جريج، قال: أخبرت عن ابن شهاب الزهري، عن عروة، عن عائشة، وقال: الحسين بن مهدي، في حديثه: ابن جريج، عن PageV05P605 الزهري، عن عروة، عن عائشة، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم مات وهو ابن ثلاث وستين» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد رواه ابن أخي الزهري، عن الزهري، عن عروة، عن عائشة، مثل هذا (@) (@)(@) (@)(@@)(@@)(@@) || باب مناقب أبي بكر الصديق رضي الله عنه واسمه عبد الله بن عثمان ولقبه عتيق (@)(@) (@)(@@)(@@)(@@) ||| ٣٦٥٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا عبد الرزاق قال: أخبرنا الثوري، عن أبي إسحاق، عن أبي الأحوص، عن عبد الله، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أبرأ إلى كل خليل من خله، ولو كنت متخذا خليلا 