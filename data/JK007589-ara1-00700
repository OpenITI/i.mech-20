ms681	(@)(@@) % أشب ما كنت قط أهرم ما % % كنت فسبحان خالق البدع % 4(@)(@@) % إذا أخذت المرآة أسلفني % % وجهي وما مت هول مطلعي % % 5(@)(@@) % شغفت بالخرد الحسان وما % % يصلح وجهي إلا لذي ورع % % 6(@)(@@) % كي يعبد الله في الفلاة ولا % % يشهد فيه مشاهد الجمع % % PageV01P2695 البحر : - 1(@)(@@) % توهمت قد سوفت بالغوث راجيا % لغوثك لا بل طالبا يتضرع % 2(@)(@@) % وقد سبقت كفيك كفا مماجد % أتسلو عن المعروف أم تتوجع % 3(@)(@@) % نوالك يابن الأكرمين مناهزا % به فرصا قد أمكنت فهي شرع % 4(@)(@@) % ولا يرينك اليوم تدفع حقه % % إلى غده وانظر غدا كيف تصنع % 5(@)(@@) % هنالك لا أرضى بشيء سوى الغنى % % إذا الدهر أعطاك الذي كان يمنع % % 6(@)(@@) % ألم تر أن المطل عند ذوي الحجا % % رياضة وغد شيمة لا تطوع % % 7(@)(@@) % يخادعها عن فضلها وهي خبة % ويؤنسها بالمعتفى وهي تفزع % % 8(@)(@@) % وأنت فتى فتيان أهل زمانه % % وبارعهم طولا فلم لا تبرع % 9(@)(@@) % تخادع حيات الرجال فتعتلي % % وتسأل ما فوق السؤال فتخدع % 10(@)(@@) % فبادر أكفا يبتدرن إلى العلا % % وغاير عيونا نحوها تتطلع % % PageV01P2696 11(@)(@@) % ولا تشجين السائلين بمطلهم % % فتشكي وتعطي والعطاء مضيع % % 12(@)(@@) % ولست إذا قطعت نفسا بجامع % تفاريقها من بعد ما تتقطع % % 13(@)(@@) % كأني إذا استهللت بين قوابلي % % بدا لي ما ألقى ببابك أجمع % % PageV01P2697 البحر : - 1(@)(@@) % شمري نحو العطاء المنتجع % واستدلي بالثناء المستمع % 2(@)(@@) % رجع الملك جديدا كالذي % % كان في بدأته حين طلع % 3(@)(@@) % دولة سببها ذو كنية % وسم الملك بها وهو جذع % % 4(@)(@@) % كنية السفاح أهداها له % % مع ميراث النبي المتبع % 5(@)(@@) % ولقد كنيها من بعده % % معشر لم يلبسوا تلك الخلع % % 6(@)(@@) % أو كسوها فأساءوا لبسها % % بالتعري من سرابيل الورع % % PageV01P2698 البحر : - 1(@)(@@) % ولست مقارعا جيشا ولكن % % برأيي يستضيء ذوو القراع % 2(@)(@@) % وإني للقوي على المعالي % % وما أنا بالقوي على الصراع % PageV01P2699 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % لا شب قرن أبي حفص ولا زرعا % % 2(@)(@@) % لئن هجاني وفرط الجهل أوقعه % % لقد تزوج أيضا بعدما صلعا % % 3(@)(@@) % قد قلت إذ قيل قد زفت حليلته % % صبرا كأني بقرن 
ms682	 الشيخ قد طلعا % % 4(@)(@@) % طلقتها منه إن عفت له أبدا % ما أبصرت منه ذاك المنظر الشنعا % % 5(@)(@@) % أقبح بوجه أبي حفص وعفتها % % هذان شيئان لا والله لا اجتمعا % % PageV01P2700 البحر : - 1(@)(@@) % لخالد بيت سوء مثل ساكنه % بلعنة الله محفوف الترابيع % 2(@)(@@) % يأوي إليه نسيات له مجن % سلين بالفسق هم العرى والجوع % 3(@)(@@) % من كل بيضاء ما في وصلها طمع % لطامع بل رجاء غير مقطوع % % 4(@)(@@) % لا يتقين بأيديهن مس يد % لكن بأرجل سمحات مطاويع % % PageV01P2701 البحر : - 1(@)(@@) % بكيت فلم تترك لعينك مدمعا % زمانا طوى شرخ الشباب فودعا % % 2(@)(@@) % سقى الله أوطارا لنا ومآربا % تقطع من أقرانها ما تقطعا % % 3(@)(@@) % ليالي تنسيني الليالي حسابها % % بلهنية أقضي بها الحول أجمعا % % 4(@)(@@) % سدى غرة لا أعرف اليوم باسمه % % وأعمل فيه اللهو مرأى ومسمعا % % 5(@)(@@) % إذ ما قضيت اليوم لم أبك عهده % % وأخلفت أدنى منه ظلا وأفنعا % % 6(@)(@@) % فأصبحت أقتص العهود التي خلت % بآهة محقوق بأن يتفجعا % % 7(@)(@@) % أحن فأستسقي لها الغيث مرة % وأثني فأستسقي لها العين أدمعا % % 8(@)(@@) % لأحسنت الأيام بيني وبينها % % بديئا وإن عفت على ذاك مرجعا % % 9(@)(@@) % أعاذل أن أعطي الزمان عنانه % % فقد كنت أثني منه رأسا وأخدعا % % 10(@)(@@) % ليالي لو نازعته رجع أمسه % % ثنى جيده طوعا إلي ليرجعا % % PageV01P2702 11(@)(@@) % وقد أغتدي للطير والطير هجع % ولو أوجست مغداي ما بتن هجعا % % 12(@)(@@) % بخلين تما بي ثلاثة إخوة % جسومهم شتى وأرواحهم معا % % 13(@)(@@) % بني خلة لم يفسد المحل بينهم % ولا طمع الواشون في ذاك مطمعا % % 14(@)(@@) % مطيعين أهواء توافت على هوى % فلو أرسلت كالنبل لم تعد موقعا % % 15(@)(@@) % تجلي عيون الناظرين فجاءة % لنا منظرا مروى من الحسن مشبعا % % 16(@)(@@) % إذا ما رفعنا مقبلين لمجلس % % طلعنا جميعا لا نغادر مطلعا % % 17(@)(@@) % كمنطقة الجوزاء لاحت بسحرة % بعقب غمام لائح ثم أقشعا % % 18(@)(@@) % إذا ما دعا منه خليل خليله % % بأفديك لباه مجيبا فأسرعا % % 19(@)(@@) % وإن هو ناداه سحيرا لدلجة % تنبه نبهان الفؤاد سرعرعا % % 20(@)(@@) % كأن له في كل عضو ومفصل % وجارحة قلبا من الجمر أصمعا % % PageV01P2703 21(@)(@@) % فشمر 
ms683	 للإدلاج حتى كأنما % % تلف به الأرواح سمعا سمعمعا % % 22(@)(@@) % كأني ما روحت صحبي عشية % % نساجل مخضر الجنابين مترعا % % 23(@)(@@) % إذا رنقت شمس الأصيل ونفضت % على الأفق الغربي ورسا مذعذعا % % 24(@)(@@) % وودعت الدنيا لتقضي نحبها % % وشول باقي عمرها فتشعشعا % % 25(@)(@@) % ولاحظت النوار وهي مريضة % وقد وضعت خدا إلى الأرض أضرعا % % 26(@)(@@) % كما لاحظت عواده عين مدنف % توجع من أوصابه ما توجعا % % 27(@)(@@) % وظلت عيون النور تخضل بالندى % % كما اغرورقت عين الشجي لتدمعا % % 28(@)(@@) % يراعينها صورا إليها روانيا % ويلحظن ألحاظا من الشجو خشعا % % 29(@)(@@) % وبين إغضاء الفراق عليهما % % كأنهما خلا صفاء تودعا % % 30(@)(@@) % وقد ضربت في خضرة الروض صفرة % من الشمس فاخضر اخضرارا مشعشعا % % PageV01P2704 31(@)(@@) % وأذكى نسيم الروض ريعان ظله % % وغنى مغني الطير فيه فسجعا % % 32(@)(@@) % وغرد ربعي الذباب خلاله % % كما حثحث النشوان صنجا مشرعا % % 33(@)(@@) % فكانت أرانين الذباب هناكم % على شدوات الطير ضربا موقعا % % 34(@)(@@) % وفاضت أحاديث الفكاهات بيننا % % كأحسن ما فاض الحديث وأمتعا % % 35(@)(@@) % كأن جفوني لم تبت ذات ليلة % كراها قذاها لا تلائم مضجعا % % 36(@)(@@) % كأني ما نبهت صحبي لشأنهم % % إذا ما ابن آوى آخر الليل وعوعا % % 37(@)(@@) % فثاروا إلى آلاتهم فتقلدوا % % خرائط حمرا تحمل السم منقعا % % 38(@)(@@) % منمقة ما استودع القوم مثلها % % ودائعهم إلا لكي لا تضيعا % % 39(@)(@@) % محملة زادا خفيفا مناطه % من البندق الموزون قل وأقنعا % % 40(@)(@@) % نكير لئن كانت ودائع مثلها % % حقائب أمثالي ويذهبن ضيعا % % PageV01P2705 41(@)(@@) % علام إذا توهي الحمالة عاتقي % % وكان مصونا أن يذال مودعا % % 42(@)(@@) % وما جشمتني الطير ما أنا جاشم % بأسبابها إلا ليجشمن مضلعا % % 43(@)(@@) % فلله عينا من رآهم وفد غدوا % % مزبين مشهورا من الزي أروعا % % 44(@)(@@) % إذا نبضوا أوتارهم فتجاوبت % لها زفرات تصرع الطير خولعا % % 45(@)(@@) % كأن دوي النحل أحرى دويها % % إذا ما حفيف الريح أوعاه مسمعا % % 46(@)(@@) % هنالك تغدو الطير ترتاد مصرعا % وحسبانها المكذوب يرتاد مرتعا % % 47(@)(@@) % ولله عينا من رآهم إذا انتهوا % % إلى موقف المرمى فأقبلن نزعا % % 48(@)(@@) % وقد وقفوا للحائنات وشمروا % % لهن إلى الأنصاف سوقا وأذرعا % % 49(@)(@@) % وظلوا كأن 
ms684	 الريح تزفي عليهم % بها قزعا ملء السماء مقزعا % % 50(@)(@@) % وقد أغلقوا عقد الثلاثين منهم % بمجدولة الأقفاء جدلا موشعا % % PageV01P2706 51(@)(@@) % وجدت قسي القوم في الطير جدها % % فظلت سجودا للرماة وركعا % % 52(@)(@@) % هنالك تلقى الطير ما طيرت به % % على كل شعب جامع فتصدعا % % 53(@)(@@) % وتعقب بالبين الذي برحت به % % لكل محب كان منها مروعا % % 54(@)(@@) % فظل صحابي ناعمين ببؤسها % % وظلت على حوض المنية شرعا % % 55(@)(@@) % فلو أبصرت عيناك يوما مقامنا % % رأيت له من حلة الطير أمرعا % % 56(@)(@@) % طرائح من سود بيض نواصع % تخال أديم الأرض منهن أبقعا % % 57(@)(@@) % نؤلف منها بين شتى وإنما % % نشتت من ألافها ما تجمعا % % 58(@)(@@) % فكم ظاعن منهن مزمع رحلة % قصرنا نواه دون ما كان أزمعا % % 59(@)(@@) % وكم قادم منهن مرتاد منزل % % أناخ به منا منيخ فجعجعا % % 60(@)(@@) % كأن لباب التبر عند انتضائها % % جرى ماؤه في ليطها فتريعا % % PageV01P2707 61(@)(@@) % تراك إذا ألقيت عنها بناتها % % سفرت به عن وجه عذراء برقعا % % 62(@)(@@) % كأن قراها والفروز التي به % % وإن لم تجدها العين إلا تتبعا % % 63(@)(@@) % مزر سحيق الورس فوق صلاءة % أدب عليها دارج الذر أكرعا % % 64(@)(@@) % لها أول طوع اليدين وآخر % إذا سمته الإغراق فيها تمنعا % % 65(@)(@@) % تدين لمقرون أمرت مريره % عجوز صناع لم تدع فيه مصنعا % % 66(@)(@@) % تأيت صميم المتن حتى إذا انتهى % % رضاها أمرته مرائر أربعا % % 67(@)(@@) % تلذ قرينيه عقود كأنها % % رؤوس مدارى ما أشد وأوكعا % % 68(@)(@@) % ولا عيب فيها غير أن نذيرها % % يروع قلوب الطير حتى تصعصعا % % 69(@)(@@) % على أنها مكفولة الرزق ثقفة % وإن راع منها ما يروع وأفزعا % % 70(@)(@@) % متاح لراميها الرمايا كأنما % % دعاها له داعي المنايا فأسمعا % % PageV01P2708 71(@)(@@) % تؤوب بها قد أمتعتك وغادرت % من الطير مفجوعا به ومفجعا % % 72(@)(@@) % لها عولة أولى بها ما تصيبه % % وأجدر بالإعوال من كان موجعا % % 73(@)(@@) % وما ذاك إلا زجرها لبناتها % % مخافة أن يذهبن في الجو ضيعا % % 74(@)(@@) % فيخرجن حينا حائنا ما انتحينه % % وإن تخذ التسبيح منهن مفزعا % % 75(@)(@@) % تقلب نحو الطير عينا بصيرة % كعينك بل أذكى ذكاء وأسرعا % % 76 
ms685	(@)(@@) % مربعة مقسومة بشباكها % % كتمثال بيت الوشي حيك مربعا % % 77(@)(@@) % لإبدائها في الجو عند طحيرها % % عجاريف لو مرت بطود تزعزعا % % 78(@)(@@) % تقاذف عنها كل ملساء حدرة % تمر مرورا بالقضاء مشيعا % % 79(@)(@@) % أمون من العظعاظ عند مروقها % % وإن عارضتها الريح نكباء زعزعا % % 80(@)(@@) % يحاذرها العفريت عند انصلاتها % % فيعجله الإشفاق أن يتسمعا % % PageV01P2709 81(@)(@@) % تقول إذا راع الرمي حفيفها % % رويدك لا تجزع من الموت مجزعا % % 82(@)(@@) % فإن أخطأته استوهلته لأختها % % فتلحقه الأخرى مروعا مفزعا % % 83(@)(@@) % وإن ثقفته أنفذته وقدرت % له ما يوازيه من الأرض مصرعا % % 84(@)(@@) % فيقضي المذكي في الصريع قضاءه % وهاتيك يأبى غربها أن تورعا % % 85(@)(@@) % أتت ما أتت من كيدها ثم صممت % % تدر دريرا يخطف الطير ميلعا % % 86(@)(@@) % كأن بنات الماء في صرح متنه % % إذا ما علا روق الضحى فترفعا % % 87(@)(@@) % زاربي كسرى بثها في صحانه % % ليحضر وفدا أو ليجمع مجمعا % % 88(@)(@@) % تريك ربيعا في خريف وروضة % على لجة بدعا من الأمر مبدعا % % 89(@)(@@) % تخايل فوق الماء زهوا كما زهت % % عوائد عيد ما ائتلين تصنعا % % 90(@)(@@) % تلبس أصنافا من البز خلعة % % حريرا وديباجا وريطا مقطعا % % PageV01P2710 91(@)(@@) % فبين خيابوذ زهته شياته % % فزينه ريش تراه موزعا % % 92(@)(@@) % يمد إليه حسنه وجماله % خلال بنات الماء عينا وإصبعا % % 93(@)(@@) % وأخضر كالطاووس يحسب رأسه % بخضراء من حر الحرير مقنعا % % 94(@)(@@) % يتيه بمنقار عليه حبائل % تخيلن في ضاحيه جزعا مجزعا % % 95(@)(@@) % يلوح على إسطامه وشي صفرة % ترقش منها متنه فتلمعا % % 96(@)(@@) % كملعقة الصيني أخدمها يدا % صناعا وإن كانت يد الله أصنعا % % 97(@)(@@) % وعينين حمراوين يطرف عنهما % % كأن حجاجيه بفصين رصعا % % 98(@)(@@) % ومن أعقف أحذاه منقاره اسمه % % أضد بديع الخلق فيه فأبدعا % % 99(@)(@@) % مزين بسربال من الريش ناصع % له زبرج يحكي الثغام المترعا % % 100(@)(@@) % مشين بجيد ذي سواد وزعرة % ورأس شبيه الجيد أسود أقرعا % % PageV01P2711 101(@)(@@) % مطرف أطراف الجناح كأنه % % بنان عروس بالخضاب تقمعا % % PageV01P2712 البحر : - 1(@)(@@) % إذا ما شنطف نكهت أماتت % فمن ندمائها قتلى وصرعى % % 2(@)(@@) % لها وجه رأيت البط فيه % % كشق عجانها والدود يسعى % % 3(@)(@@) % يلاقي الأنف من فمها 
ms686	 عذابا % وترى العين فيه شر مرعى % % 4(@)(@@) % وإن سكوتها عندي لبشرى % % وإن غناءها عندي لمنعى % % 5(@)(@@) % فقرطها بعقرب شهرزور % إذا غنت وطوقها بأفعى % % 6(@)(@@) % ودعها حيث لا تسعى وترعى % % حماها الله أن تسقى وترعى % % 7(@)(@@) % فإن جاءت فلا أهلا وسهلا % وإن ذهبت فلا حفظا ورجعى % % 8(@)(@@) % ولا رزقت شفاء من غليل % إذا بركت لنائكها وأقعى % % PageV01P2713 البحر : - 1(@)(@@) % أيا شجرات الله ليس بقاطع % لك الدهر شربا أنت فيه شوارع % 2(@)(@@) % تحير دفاع من الماء خلفه % % لسقياك دفاع له متدافع % 3(@)(@@) % إذا قدر الجهال وشك انقطاعه % % أتى مدد من ربه متتابع % 4(@)(@@) % فلا يرتجي الأعداء فيكم رجاءهم % % فليس لغرس الله ذي العرش قالع % 5(@)(@@) % ولا يطمع الحساد في قطع شربكم % % فليس لما أجرت يد الله قاطع % % 6(@)(@@) % يد الله درع لا تزال تقيكم % وترس لكم ترفض عنه القوارع % 7(@)(@@) % وليست على ما يحفظ الله ضيعة % ولكن ما لا يحفظ الله ضائع % % 8(@)(@@) % تعيشون ما عشتم وللحبل واصل % تقوم به الدنيا وللشمل جامع % % 9(@)(@@) % وللدين أنصار وللملك شيعة % وللعرف معطاء وللجار مانع % % 10(@)(@@) % وما تتقذاكم عيون جلية % ولا تلفظ التقريظ فيكم مسامع % % PageV01P2714 البحر : - 1(@)(@@) % تتجافى جنوبهم % عن وطىء المضاجع % 2(@)(@@) % كلهم بين خائف % مستجير وطامع % 3(@)(@@) % تركوا لذة الكرى % % للعيون الهواجع % 4(@)(@@) % ورعوا أنجم الدجى % % طالعا بعد طالع % % 5(@)(@@) % لو تراهم إذا هم % خطروا بالأصابع % % 6(@)(@@) % وإذا هم تأوهوا % % عند مر القوارع % % 7(@)(@@) % وإذا باشروا الثرى % % بالخدود الضوارع % % 8(@)(@@) % واستهلت عيونهم % % فائضات المدامع % % 9(@)(@@) % ودعوا يا مليكنا % % يا جميل الصنائع % 10(@)(@@) % أعف عنا ذنوبنا % % للوجوه الخواشع % PageV01P2715 11(@)(@@) % أعف عنا ذنوبنا % % للعيون الدوامع % % 12(@)(@@) % أنت إن لم يكن لنا % % شافع خير شافع % % 13(@)(@@) % فأجيبوا إجابة % لم تقع في المسامع % % 14(@)(@@) % ليس ما تصنعونه % % أوليائي بضائع % % 15(@)(@@) % تاجروني بطاعتي % % تربحوا في البضائع % % 16(@)(@@) % وآبذلوا لي نفوسكم % % إنها في ودائعي % % PageV01P2716 البحر : - 1(@)(@@) % كل الهدايا قد رأيت صنوفها % % إلا الكلام ففيه ما لم يسمع % % 2(@)(@@) % فجعلت إهدائي إليك مدائحا % مثل الرياض من الكلام المبدع % PageV01P2717 البحر : - 1(@)(@@) % كل 
ms687	 شيء أهديه غير بديع % لك عندي إلا اعتذارا بديعا % % 2(@)(@@) % أي شيء أهدي إليك وفي وج % % هك ما تشتهي النفوس جميعا % % 3(@)(@@) % منك تهدي الدنيا إلينا الهدايا % % فيباري بها خريف ربيعا % % PageV01P2718 البحر : - 1(@)(@@) % حسام لا يليق عليه جفن % سريع في ضريبته ذريع % 2(@)(@@) % ترى وقعاته أبدا خطايا % % إلى أن يسبطر له صريع % 3(@)(@@) % ويرعد متنه من غير هز % كريعان السراب زهاه ريع % 4(@)(@@) % يقول القائلون إذا رأوه % % لأمر ما تغوليت الدروع % % PageV01P2719 البحر : - 1(@)(@@) % عجبت لعمر الله من جار جارة % لعرسك محمود إذا الضيف ودعه % % 2(@)(@@) % وإن كان يلقاه بأجهم طلعة % وينزله في غير رحب ولا سعه % PageV01P2720 البحر : - 1(@)(@@) % لطرفها وهو مصروف كموقعه % في القلب حين يروع القلب موقعه % 2(@)(@@) % تصد بالطرف لا كالسهم تصرفه % عني ولكنه كالسهم تنزعه % 3(@)(@@) % ونزعها السهم من قلبي كموقعه % % فيه وكل أليم المس موجعه % PageV01P2721 البحر : - 1(@)(@@) % سأقسم دمعي إذ غدرت فدمعة % على مدح سيرتها فيك ضيع % 2(@)(@@) % وأخرى على مافيك من حسن منظر % غدوت وقد أصحبته قبح مسمع % 3(@)(@@) % وأخرى على رأي أصبت برشده % فضل وأداني إلى شر مطمع % % 4(@)(@@) % وأخرى على جد سعيد يصونني % % وحسبك أن أبكيت حرا بأربع % % PageV01P2722 البحر : - 1(@)(@@) % يا أبا سهل نثاك المستمع % ونداك المرتجى والمنتجع % 2(@)(@@) % ولك النعمة لا أجحدها % % ما بدا ضوء نهار فسطع % 3(@)(@@) % غير أني بعد هذا قائل % % قول ذي ود ونصح إن نفع % 4(@)(@@) % لك عرض ليس من عاداته % % أن يرى فيه من الذم طبع % 5(@)(@@) % وقليل الرين فيه بين % وكذا العرض إذا العرض نصع % % 6(@)(@@) % والأخ المخلص إن أقذيته % % فالقذى فيك إلى أن ينتزع % % 7(@)(@@) % وأنا الخل الذي استخلصته % % فرأى موضع نصح فصدع % % 8(@)(@@) % ليس يرضى ماجد من نفسه % بنوال كل يوم يرتجع % 9(@)(@@) % لك جار كلما قلت جرى % % فتشوقت له قيل انقطع % 10(@)(@@) % فرح ينتج منه ترح % % وأمان يجتنى منه فزع % PageV01P2723 11(@)(@@) % كل يوم لي منه روعة % % وفعال الحر أولى بالروع % % 12(@)(@@) % لا تكن كالدهر في أفعاله % % كلما أعطى عطاياه فجع % % 13(@)(@@) % ليس لي 
ms688	 عندك حق غير ما % % تتقاضاه المعالي والرفع % % 14(@)(@@) % والذي يحكم فيه بيننا % % كرم منك وجود قد بدع % % 15(@)(@@) % وأرى الشافع في تعجيله % % قد تراخى بعدما كان شفع % 16(@)(@@) % لا أحب الرزق يجري أمره % كلما أملته مجرى المتع % % 17(@)(@@) % أوثق العقدة إن أنكحتني % % ما تراني كفأه أو لا فدع % 18(@)(@@) % جد بإدرارك ما أجريته % أو بإعتاقي من رق الطمع % % 19(@)(@@) % وجواد ناكث قلت له % % بعدما قفى العطايا بالرجع % % 20(@)(@@) % لا تخادع في متاع زائل % فكأن قد طار منه ما وقع % % PageV01P2724 21(@)(@@) % حسب من خادع في معروفه % أن ما صح من الدنيا خدع % % 22(@)(@@) % إنما ضيع مثر ما اقتنى % % واقتنى غير كذاب ما اصطنع % 23(@)(@@) % ليت شعري آملال جره % % حين ساهرتك طول المجتمع % 24(@)(@@) % أم عوار فاحش مني بدا % % وخلال الخير والشر لمع % 25(@)(@@) % ذاك أم هذا دهاني في الذي % % كنت أرجوه فأجلى وانقشع % % PageV01P2725 البحر : - 1(@)(@@) % أحسن ما كان الدقيق موقعا % % من رجل أفلس حتى أدقعا % % 2(@)(@@) % إذا أتى يسعى حثيثا مسرعا % % من بعد ما مس الغلاء الأشنعا % % 3(@)(@@) % ولحق السبعين أو ترفعا % % عن ذاك لا يرحم من تضرعا % % 4(@)(@@) % ومد ذو العيلة فيه الإصبعا % % يشكو إلى الله ويمري المدمعا % % 5(@)(@@) % وأصبح القوم البطان جوعا % % وخشي الجائع أن لا يشبعا % % 6(@)(@@) % يا من تناهى منظرا ومسمعا % % جمال وجه وثناء أروعا % % 7(@)(@@) % أفزعني الدهر فكن لي مفزعا % % فكم تسمحت وكم تمنعا % % 8(@)(@@) % وكم تحسنت وكم تشنعا % % ولم يزل فضلك فيه مرتعا % % 9(@)(@@) % للمقحطين الممحلين ممرعا % % وكبر ظني أن تقول مسمعا % % 10(@)(@@) % لبيك لبيك لعا ودعدعا % % بدلت من بؤسك عيشا خروعا % % PageV01P2726 11(@)(@@) % يشهد أني حافظ من ضيعا % % PageV01P2727 البحر : - 1(@)(@@) % ولي أصدقاء كثيرو السلا % % م علي وما فيهم نافع % 2(@)(@@) % إذا أنا أدلجت في حاجة % لها مطلب نازح شاسع % 3(@)(@@) % فلي أبدا معهم وقفة % وتسليمة وقتها ضائع % 4(@)(@@) % وفي موقف المرء عن حاجة % % تيممها شاغل قاطع % % 5(@)(@@) % ترى كل غث كثير الفضو % % ل مصحفه مصحف جامع % % 6(@)(@@) % يقول الضمير له طالعا % ألا قبح الرجل الطالع 
ms689	 % % 7(@)(@@) % يحدثني من أحاديثه % % بما لا يلذ به السامع % % 8(@)(@@) % أحاديث هن كمثل الضري % % ع آكله أبدا جائع % 9(@)(@@) % غدوت وفي الوقت لي فسحة % فضاق بي المنهل الواسع % 10(@)(@@) % تقدمت فاعتافني أسره % إلى أن تقدمني التابع % % PageV01P2728 11(@)(@@) % وفاتت بلقيانه حاجتي % % ألا هكذا النكد البارع % % 12(@)(@@) % أولئك لا حيهم مؤنس % % صديقا ولا ميتهم فاجع % % PageV01P2729 البحر : - 1(@)(@@) % أأحمد لا والله لا ذقت فيشتي % % فإن شئت فانسبني إلى الخنث أو دع % 2(@)(@@) % أإياي تستغوي بما أنت قائل % % طمعت لعمر الله في غير مطمع % 3(@)(@@) % ألا طالما حرضتني غير مؤتل % على آستك تحريض امرئ بي مولع % % 4(@)(@@) % تحوم على أيري ولست تذوقه % % ولو مت فاصبر للحكاك أو اجزع % % PageV01P2730 البحر : - 1(@)(@@) % فطر توسط يومه الأسبوعا % % وافقت فيه من السعود طلوعا % % 2(@)(@@) % واها له فطر غدا بربيعه % % وربيعك الغدق الحيا مربوعا % % 3(@)(@@) % فالناس والأنعام طرا قد غدوا % % في المرتعين الممرعين رتوعا % % 4(@)(@@) % وكأن فيه من فعالك سندسا % وكأن فيه من الرياض قطوعا % % 5(@)(@@) % ما أفرح الملبوس من أيامنا % % بك لاعدمت وأكسف المخلوعا % % 6(@)(@@) % تتحسر الأيام عنك وكلها % % تشكو فراقك آسفا مفجوعا % % 7(@)(@@) % رحل الصيام وشهره وكلاهما % % لهج بذكرك ما يفيق نزوعا % % 8(@)(@@) % ولقد تناجت بالرجوع مناهما % % لو ملكا بعد المضي رجوعا % % 9(@)(@@) % أقسمت بالشهر الذي أخضلته % % بالجود والتقوى ندى ودموعا % % 10(@)(@@) % للبسته لبسا أطاب نسيمه % % يا بن الأطايب محتدا وفروعا % % PageV01P2731 11(@)(@@) % وخلعته خلع العروس شعارها % % قد ردعته من العبير ردوعا % % 12(@)(@@) % أعبقته من طيب ريحك نفحة % كادت تكون ثناءك المسموعا % % 13(@)(@@) % لم لا يكون كذا وقد ألبسته % % فلبست فيه سكينة وخشوعا % % 14(@)(@@) % وكددت فيه بالبكاء مدامعا % وجهدت فيه بالزفير ضلوعا % % 15(@)(@@) % ورفدت فيه كل أشعث بائس % % ما زال عن طلباته مدفوعا % % 16(@)(@@) % أحييت في الشهر المبارك ليله % وفقيره وقتلت عنه الجوعا % % 17(@)(@@) % بيد إذا قست الأنامل فجرت % من كل أنملة لها ينبوعا % % 18(@)(@@) % أنشأت تكحل بالهجوع معاشرا % بعد السهاد وما اكتحلت هجوعا % % 19(@)(@@) % ما كان ليلك مذ أهل هلاله % % إلا سجودا كله وركوعا % % 20(@)(@@) % وطوى نهارك 
ms690	 فيه صوم طاهر % جعل المآثم محرما ممنوعا % % PageV01P2732 21(@)(@@) % صوم غدت عين الخنا مطروفة % فيه وراح لسانه مقطوعا % % 22(@)(@@) % وتساجلت عيناك في آنائه % % ويداك صوبا لا يزال هموعا % % 23(@)(@@) % جعل الإله عوارفا أسديتها % % حللا على ابنك ذي العلا ودروعا % % 24(@)(@@) % هذي تزينه وتلك تجنه % % من كل مكروه أحم وقوعا % % 25(@)(@@) % واسعد أبا سهل بعيدك نازلا % فوق الحوادث منزلا مرفوعا % % 26(@)(@@) % في حيث تلقى أنف مجدك شامخا % ويرى عدوك أنفه مجدوعا % % 27(@)(@@) % وتبيت من وقع القوارع آمنا % ويبيت من يهوى رداك مروعا % % 28(@)(@@) % أضحى أبو روح سليلك موردا % أضحى بنو الآمال فيه شروعا % % 29(@)(@@) % خرق له كف يكون سماحها % % كرما إذا كان السماح ولوعا % % 30(@)(@@) % متكلف فوق الطباع مكارما % سمينه المتكلف المطبوعا % % PageV01P2733 31(@)(@@) % لولاه لم تلق النوال مفرقا % أبدا ولا شمل العلا مجموعا % % 32(@)(@@) % ما الطالب المخدوع طالب رفده % % ووجدت طالب شأوه المخدوعا % % 33(@)(@@) % عمر الإله بعمره في غبطة % خططا تضيء بوجهه وربوعا % % 34(@)(@@) % حتى ترى السادات أتباعا له % % وتراه مثلك سيدا متبوعا % % 35(@)(@@) % أقسمت ما لقيت ذل مطالب % كبرا ولا عز الزمان خضوعا % % 36(@)(@@) % من كان عند المعضلات مضعفا % أو كان عند المجحفات منوعا % % 37(@)(@@) % فكم اجتديت فما وجدت مبخلا % وكم امتحنت فما وجدت جزوعا % % 38(@)(@@) % أصبحت تحفظ كل مجد ضائع % حفظا كحفظك دينك المشروعا % % 39(@)(@@) % وأراك نلت من الأمور أجلها % % بدءا وفزت بخيرها مرجوعا % % 40(@)(@@) % ولقد أقول لسائلي عن مجدكم % % غلب المصابيح الصباح سطوعا % % PageV01P2734 41(@)(@@) % لله سؤدد آل سهل سؤددا % لم يمس مغمورا ولا مفروعا % % 42(@)(@@) % قوما تراهم يفتقون مكارما % مرتوقة أو يرتقون صدوعا % % 43(@)(@@) % لا يعدمون صنيعة مصنوعة % تهدي إليهم منطقا مصنوعا % % 44(@)(@@) % يعطون ما يعطونه وكأنما % % يستودعون الأرض منه زروعا % % 45(@)(@@) % من لم يزاول عرفهم ونكيرهم % % لم يضح مشتارا ولا ملسوعا % % 46(@)(@@) % ولما شهدت لهم بغير جلية % ولما رفعت بقدرهم موضوعا % % PageV01P2735 البحر : - 1(@)(@@) % شفيعك من قلبي مكين مشفع % وحظك من ودي حريز ممنع % 2(@)(@@) % فلا تسأليني في هواك زيادة % فأيسره مرض وأدناه مقنع % 3(@)(@@) % لو أن ازديادي في 
ms691	 الهوى ينقص الهوى % % إذا لخلا منه المحبون أجمع % 4(@)(@@) % كلانا ادعى أن الفضيلة في الهوى % % له وكلانا صادق ليس يدفع % % 5(@)(@@) % يقاسي المقاسي شجوه دون غيره % % وكل بلاء عند لاقيه أوجع % % 6(@)(@@) % وكنت ومالي في نهاري مؤنس % ولا سكن في الليل والناس هجع % 7(@)(@@) % أبيت رقيب الصبح حتى كأنني % % أرجى مكان الصبح وجهك يطلع % % 8(@)(@@) % أصعد أنفاسي وأحدر عبرتي % % بحيث يرى ذاك الإله ويسمع % 9(@)(@@) % ولولا مدى يوم لنفسي تفلتت % على إثر أنفاسي التي تتقطع % % 10(@)(@@) % إلى الله أشكو لا إلى الناس إنما % % مكان الشكايا من يضر وينفع % % PageV01P2736 البحر : - 1(@)(@@) % إن كنت صفعانا ولي ضيعة % وأنت بذبخت ولا تصفع % 2(@)(@@) % فإنما تدعى إذا ضيعة % لأن من يملكها الأضيع % 3(@)(@@) % هذا لعمري عجب عاجب % يا من قفاه منظر مسمع % % 4(@)(@@) % لو صح ما قلت لكان الغنى % % يضر والفقر الذي ينفع % % 5(@)(@@) % دفعت من أمك في طيزها % % إن كان ما قلت الذي يدفع % % 6(@)(@@) % ويحك ما أسخاك من لابس % أكل ما تلبسه تخلع % % 7(@)(@@) % ما كل من كان له نحلة % ينحلها الناس كما تصنع % % PageV01P2737 البحر : - 1(@)(@@) % يا ليت شعري لو سئلت وقد % % أنشدت مدحي فيك من سمعه % 2(@)(@@) % ماذا أثبت عليه قائله % هل كنت تلقى في الجواب سعه % 3(@)(@@) % كلا لأنك إن صدقت فقد % % أقررت أنك أرضع الرضعه % 4(@)(@@) % ومتى كذبت فتلك شرهما % % والإفك يجمع مأثما وضعه % % 5(@)(@@) % وإن استرحت إلى السكوت فما % % لك فيه من لؤم الكرام دعه % % 6(@)(@@) % أتراك توهمهم إذا سألوا % % فسكت أمرا لا تلام معه % % 7(@)(@@) % كلا ولكن يعلمون معا % أن قد سلكت مسالك الخدعه % 8(@)(@@) % كتم اللسان عليك فاستمعت % % فطن لما جمجمت مستمعه % 9(@)(@@) % وكذا عقول ذوي العقول على % % أسرار أهل الجهل مطلعه % % 10(@)(@@) % قد كنت تبت من الهجاء فإن % % شاء اللئام أعدتها جذعه % % PageV01P2738 البحر : - 1(@)(@@) % يا سامعا بالأمس قينة خالد % % ولرب يوم في الخسار مضيع % 2(@)(@@) % نعم الغناء سمعت إلا أنه % % نعم الشراب عليه دهن الخروع % PageV01P2739 البحر : - 1(@)(@@) % ولي طيلسان ناحل غير أنه % % ثبوت لهبات الرياح 
ms692	 الزعازع % 2(@)(@@) % وما ذاك إلا أنه متهتك % % يخلي سبيل الريح غير منازع % 3(@)(@@) % أراه كضوء الشمس بالعين رؤية % ويمنعني من لمسه بالأصابع % % 4(@)(@@) % شكى ثقل اسم الطيلسان لضعفه % فسميته ساجا فها ذاك نافعي % % PageV01P2740 البحر : - 1(@)(@@) % وقع الفراق وما يزال يروعني % % فكأن واقع شره متوقع % PageV01P2741 البحر : - 1(@)(@@) % يا رب لهفان على صنيعه % قصر فيها بيد مضيعه % 2(@)(@@) % وقد أتت سامعة مطيعه % ثم ابتغاها صعبة منيعه % 3(@)(@@) % فلم يجدها المشتري مبيعه % وعظمت في فوتها الوضيعه % % 4(@)(@@) % حتى إذا أعيت على الذريعة % % عض البنان عضة وجيعه % % 5(@)(@@) % من حر ما لاقى من الفجيعه % % يا بن فراس إنها وديعه % % 6(@)(@@) % أودعتنيها فدع الخديعه % ثم السلام وهي القطيعه % 7(@)(@@) % لا زلت ذا أحدوثة شنيعه % % مقذوفة في أذن سميعه % % 8(@)(@@) % تدعوإليك نقمة سريعه % % PageV01P2742 البحر : - 1(@)(@@) % عاصيت كل هوى مطاع % وملكت قلبي بالزماع % 2(@)(@@) % ورعيت حق مودتي % % إذا لم أجدك لها براع % 3(@)(@@) % ونهيت نفسي عن هوا % % ك فسمحت بعد النزاع % 4(@)(@@) % فعلى مودتك السلا % % م فإنه خير الوداع % % 5(@)(@@) % إذا تفرقت الفجا % % ج بنا بفرقة لا اجتماع % % 6(@)(@@) % ليس التضرع للهوى % % من شيمة البطل الشجاع % 7(@)(@@) % فاذهب فقبلك ما سلو % % ت عن الشبيبة والرضاع % % PageV01P2743 البحر : - 1(@)(@@) % قلت لخود ضفتها مرة % من أهل بيت الشرف الأرفع % % 2(@)(@@) % وقد بدت ساق لها خدلة % كأنما تمشي على خروع % % 3(@)(@@) % يتبعها ردف لها راجح % % ينوخ فيها أكثر الإصبع % % 4(@)(@@) % يا ربة المنزل هل عندكم % % من مطعم للزب أو مطمع % % 5(@)(@@) % قالت على كم أنت من شعبة % فقلت قول القائل الأروع % 6(@)(@@) % على ثلاث ضيفكم قائما % فهل تقومون على أربع % 7(@)(@@) % قالت نعم والله يا دافني % % وصائني عن ذلة المصرع % % 8(@)(@@) % نحن أصحاء بلا علة % فما لنا الآن وللمضجع % % 9(@)(@@) % قلت لقد قلت ألا فعلي % % فأي ردف ثم لم تشرع % % 10(@)(@@) % ردف إذا لاقاك مستهدفا % قالت له الشهوة قم فادفع % % PageV01P2744 11(@)(@@) % فلم أزل أشفي حرارتها % % بمثل رأس الرجل الأصلع % % 12(@)(@@) % وخير ما تقريكه حرة % أن تدخل الأصلع في الأفلع % % 13(@)(@@) % نعم 
ms693	 القرى ذاك ولكنه % % يصلح للشبعان لا الجوع % % 14(@)(@@) % أحسبها أم الفتى مدرك % % خطيب أهل الأدب المصقع % % 15(@)(@@) % تلك التي لو عدلت فيشتي % % عن خرقها الواسع لم يرقع % 16(@)(@@) % سوف يرى الديوث من ذا غدا % % يخزي ويلقي الذل في المجمع % 17(@)(@@) % قد كان لولا أنه حائن % في منظر عني وفي مسمع % % PageV01P2745 البحر : - 1(@)(@@) % بك تمت لي السلامة يا سا % % لم يا سيد الأنام جميعا % % 2(@)(@@) % إذ لك اسم من السلامة مشتق % ق وإذ كنت لي إليها شفيعا % % 3(@)(@@) % فقلت تمي لخادمي فأطاعت % ك بحق ومن أطاع أطيعا % % 4(@)(@@) % فابق ما دام طيب نشرك في الن % % اس وما عاقب الخريف الربيعا % % PageV01P2746 البحر : - 1(@)(@@) % أصبح يعقوب وتبجيله % للخبز مرئي ومسموع % 2(@)(@@) % رغيفه في قدر ديناره % % بتلكم السكة مطبوع % 3(@)(@@) % بل آية الكرسي مكتوبة % فهو طوال الدهر ممنوع % % 4(@)(@@) % لا يشتكي ضيف له كظة % لكنه يقتله الجوع % % PageV01P2747 البحر : - 1(@)(@@) % بدعة عندي كاسمها بدعه % لا إفك في ذاك ولا خدعه % 2(@)(@@) % يجتمع الظرف لجلاسها % % والحسن والإحسان في بقعه % 3(@)(@@) % يا أيها السائل عن حظها % % للناس جزء ولها تسعه % 4(@)(@@) % كأنما غنت لشمس الضحى % % فألبستها حسنها خلعه % 5(@)(@@) % ممن قضى الله بإحسانه % % ما أحسنت قمرية سجعه % 6(@)(@@) % لها مسير في أغانيها % % توسط الإبطاء والسرعه % 7(@)(@@) % كأنما رقة مسموعها % % رقة شكوى سبقت دمعه % % 8(@)(@@) % تهدي إلى قلبك ما يشتهي % % كأنها قد أطلعت طلعه % % 9(@)(@@) % تحسن في البدأة لكنها % % أحسن من بدأتها الرجعة % % 10(@)(@@) % لو أسندت ميتا إلى نحرها % % أو عودها ثاب من الضجعه % % PageV01P2748 11(@)(@@) % غنت فلم تحوج إلى زامر % % هل يحوج الصبح إلى شمعه % 12(@)(@@) % وشيع الزمر أعاجيبها % % من ظبية أوفت على تلعه % % 13(@)(@@) % فكان تاجا زاد في بهجة % لا كمة غطت على صلعه % % 14(@)(@@) % ويح ابن أيوب لقد فاته % % منها السماع اللذ والصنعه % % 15(@)(@@) % فما يبالي بعدما ناله % % مما وصفنا ما دهى سمعه % 16(@)(@@) % وكم شقي ملكت قلبه % % فقطعته قطعة قطعه % 17(@)(@@) % عانده في أمرها نحسه % وساعدتها الأنجم السبعه % 18(@)(@@) % كذاك من يقرب من خطة % تكن 
ms694	 له الخطة بالشفعة % 19(@)(@@) % ظلت وقد أبدت لنا وجهها % % في ضحوة الجمعة كالجمعه % % 20(@)(@@) % كأنما تجلو لأبصارنا % % من شمس يوم غائم لمعه % % PageV01P2749 21(@)(@@) % أقسمت لومكنت من شدوها % % وكان وترا لا أرى شفعه % % 22(@)(@@) % لم أحفل الملك ولا ملكه % % ما حنت النيب ولا نزعه % % 23(@)(@@) % وكان قلبي أبدا ظرفه % % وكان سمعي أبدا قمعه % % 24(@)(@@) % وخلتني ما دمت تلقاءها % % من جنة الخلد على ترعه % % 25(@)(@@) % طفل على من حصلت عنده % % فبعض تطفيل الفتى رفعه % % 26(@)(@@) % واستفتح الباب الذي دونها % % تفتح لدى فتحكه قلعه % % 27(@)(@@) % تلك ربع فانتجع روضه % % فلن يعاب الحر بالنجعه % % 28(@)(@@) % حافظ على مجلسها جاهدا % فإنه ناهيك من متعه % % 29(@)(@@) % وحدث الناس به فاخرا % فإنه ما شئت من سمعه % 30(@)(@@) % أسمعنيها سيد ماجد % يفوز بالمجد لدى القرعه % PageV01P2750 31(@)(@@) % لكنه عودني ظالما % أن يتبع الفرحة بالفجعه % % 32(@)(@@) % بيناه قد ألبسني نخوة % بالعطف إذ ألبسني خشعه % % 33(@)(@@) % وبينما وجهي به مسفر % إذ برقعت وجهي به سفعه % % 34(@)(@@) % يفيق لي من سكر لذاته % % إفاقة تتبعها هجعه % % 35(@)(@@) % أدعى فأسعى فأرى حاجبا % جهما لديه المنع والمنعه % % 36(@)(@@) % فشافع يحفزه شافع % % ورقعة تحفزها رقعه % % 37(@)(@@) % والنفس في لبس وفي حيرة % % والجسم نضو يشتكي ظلعه % % 38(@)(@@) % من دفعة تتبعها جذبة % وجذبة تتبعها دفعه % 39(@)(@@) % يجذبني للدفع ذو قوة % يدفعني للجذب في سرعه % % 40(@)(@@) % ويحي كم تعذب لي جرعة % منه وكم تملح لي جرعه % % PageV01P2751 41(@)(@@) % كأنه في فعله نحلة % % تتبع منها مجة لسعه % % 42(@)(@@) % خير حديث من أخ صدقه % % يا من أبت أعراقه وضعه % 43(@)(@@) % عبدك إن أنصفت من بانة % فإن تعديت فمن نبعه % 44(@)(@@) % ها هو مبد لك مكنونه % فقد أضاقت حاله ذرعه % 45(@)(@@) % ولو رجا ودك دون الجدا % % ما كظ ما قد سمته وسعه % % 46(@)(@@) % لكنه يلحظ منك القلى % % عن ظنة قد زلزلت ربعه % % 47(@)(@@) % وما بكت عيناه من حسرة % ولا شكا بين الحشا لذعه % % 48(@)(@@) % ولا رآه الله مستعطفا % أصل الرضا منك ولا فرعه % 49(@)(@@) % فكيف استعطف مستنفري % % لا لطماح يبتغي قذعه % % 50(@)(@@) % ولا 
ms695	 لذنب جئته موجب % ردي إذا جئت ولم أدعه % % PageV01P2752 51(@)(@@) % والحر ما استنفزته نافر % ولو تلقى أنفه جدعه % % 52(@)(@@) % في بلغ الإخوان لي عصمة % وفي رجاء الله لي شبعه % % 53(@)(@@) % متى توددت إلى مبغض % أو يممت بي قدمي صقعه % % 54(@)(@@) % فلا أقال الله لي عثرة % ولا أقل الله لي صرعه % % 55(@)(@@) % أما درى من جار في حكمه % % من ملك أني أرى خلعه % 56(@)(@@) % شرطي من الأملاك من لاأرى % % لي كل يوم معه وقعه % % 57(@)(@@) % لا يتبع الصفوة لي بالقذى % % ولا الطمأنينة بالفزعه % 58(@)(@@) % ممن يؤاخي سيفه غمده % % ولا يؤاخي سيفه نطعه % % 59(@)(@@) % ولا يرى أني إذا زرته % قصدت للهرسة والمقعه % % 60(@)(@@) % دع ذا وجاوزه إلى غيره % % وارض لمن أغضبته طبعه % % PageV01P2753 61(@)(@@) % وأمن شواظا فار من غيظه % % يكفك حلم راجح قمعه % % 62(@)(@@) % حاشاه أن تتبعه عزة % من عزة تتبعها خضعه % % 63(@)(@@) % ولو رأيت اليأس من عفوه % % لم ير مني هذه الخنعه % % 64(@)(@@) % وما على عبد أخي طاعة % ضيعه مولى ولم يرعه % % 65(@)(@@) % أغضبه حتى طغا جهله % فلم يقل في لومه قذعه % % 66(@)(@@) % يا أيها المأمول في دهره % % زع من عرامي بالندى وزعه % 67(@)(@@) % بادر بمعروفك آفاته % % فبنية الدنيا على القلعه % 68(@)(@@) % وازرع زروعا ترتضي ريعها % % يوما فكل حاصد زرعه % 69(@)(@@) % قد كنت من عرفك ذا سلوة % لو لم تكن ذوقتني طلعه % 70(@)(@@) % لكن تشوفت إلى ينعه % % بطلعه فامنح يدي ينعه % % PageV01P2754 71(@)(@@) % هل يمنع الحر جنى حظه % % من هز هزا لينا جذعه % % PageV01P2755 البحر : - 1(@)(@@) % رفعت إلى وديك أبصار همتي % % لترفع من قدري فهل أنت رافع % 2(@)(@@) % وإني وصدق المرء من خير قوله % % لراض بحظي من ضميرك قانع % 3(@)(@@) % ومستيقن أني لديك بربوة % لها شرف مما تجن الأضالع % 4(@)(@@) % ولكن بي من بعد ذلك حاجة % إلى أن يرى راء ويسمع سامع % % 5(@)(@@) % ليكبت أعدائي ويرغم حسدي % % ويقمعهم عن شرة البغي قامع % % 6(@)(@@) % فقد شك في حالي لديك معاشر % % وفي مثل حالي للشكوك مواضع % % 7(@)(@@) % ولن يوقن الشكاك ما لم يقم لهم % % على السر برهان 
ms696	 من الجهر ناصع % % 8(@)(@@) % أأن قلت إني ما انتجعتك مجدبا % أبا أحمد تحمي علي المراتع % % 9(@)(@@) % فلست غنيا عنك ما ذر شارق % ولو سال بالرزق التلاع الدوافع % 10(@)(@@) % شهدت متى استغنيت عنك بأنني % % غني عن الماء الذي أنا جارع % PageV01P2756 11(@)(@@) % فكيف الغنى عمن بمعروفه الغنى % % وعمن بكفيه الغيوث الروابع % 12(@)(@@) % مديحي وإن نوهته لك مبذل % وخدي وإن صعرته لك ضارع % % 13(@)(@@) % لمثلك يستبقي العفيف سؤاله % % ويقنى الحياء الحر والرمح شارع % % 14(@)(@@) % أتعلمني من مدح غيرك صائما % صياما له قدما علا في طابع % % 15(@)(@@) % وحلأت نفسي عن شرائع جمة % لترويني مما لديك الشرائع % % 16(@)(@@) % وما كنت أخشى أن تخيب ذريعتي % % لديك إذا خابت لديك الذرائع % % 17(@)(@@) % فلا أكن المحروم منك نصيبه % % بلا أسوة إني لذلك جازع % % 18(@)(@@) % متى استبطأ العافون رفدك أم متى % % تقاضاك أثمان المدائح بائع % % 19(@)(@@) % وقد وعدت عنك الأماني مواعدا % % مطلن بها والحادثات فواجع % % 20(@)(@@) % أحاذر أن يرميني الدهر دونها % % بحتف وحاشاك الحتوف الصوارع % % PageV01P2757 21(@)(@@) % وإني لأرجو أن يكون مطالها % % لتجنيني ما أثمرت وهو يانع % % 22(@)(@@) % قبولك ميلي وانقطاعي وخدمتي % % قصاري ولكن للقضاء توابع % 23(@)(@@) % ومقصود ما يبغى من السيف مضرب % حسام إذا لاقى الضريبة قاطع % 24(@)(@@) % على أنه من بعد ذلك يبتغى % % له رونق يستأنق العين رائع % % 25(@)(@@) % كذلك محض الود منك فريضتي % % ونافلتي فيك الجدا والمنافع % 26(@)(@@) % فكن عندما أملت منك فلم تكن % % لتخلفني منك البروق اللوامع % % 27(@)(@@) % وعش أبدا في غبطة وسلامة % % وأمن إذا راعت سواك الروائع % % 28(@)(@@) % فأنت لنا واد خصيب جنابه % وأنت لنا طود من العز فارع % % PageV01P2758 البحر : - 1(@)(@@) % فتى إن أجد في مدحه فلأنني % % وجدت مجالا فيه للقول واسعا % % 2(@)(@@) % وإن لا أجد في مدحه فلأنني % % وثقت به حتى اختصرت الذرائعا % % 3(@)(@@) % ومن يتكل لا يحتفل في ذريعة % ولا يسع إلا خافض البال وادعا % % 4(@)(@@) % كفى طالبا عرفا إذا أم أهله % % من المدح ما أعفى به الشعر طائعا % % 5(@)(@@) % على أنه لو زارهم غير مادح % كفاه بهم دون الشوافع شافعا % % 6(@)(@@) % أبا 
ms697	 حسن إن لا أكن قلت طائلا % فإني لم أنهض من الفكر واقعا % % 7(@)(@@) % مدحتك مدح المستنيم إلى امرىء % كريم فقلت الشعر وسنان هاجعا % % 8(@)(@@) % وإن أك قد أحسنت فيه فإنه % % بما أحسنت قبلي يداك الصنائعا % % 9(@)(@@) % فعلت فأبدعت البدائع فاعلا % فأبدع فيك القائلون البدائعا % % 10(@)(@@) % فلا زلت تسدي صالحا وأنيره % فتحسن متبوعا وأحسن تابعا % % PageV01P2759 البحر : - 1(@)(@@) % ألا ليس شيبك بالمتزع % فهل أنت من غيه مرتدع % 2(@)(@@) % وهل أنت تارك شكوى الزمان % % إذا لست تشكو إلى مستمع % 3(@)(@@) % عتبت على المقرض المقتضي % % وما ظلم المسلف المرتجع % 4(@)(@@) % بلى إن من ظلمه لومه % % وما ألأم المعطي المنتزع % % 5(@)(@@) % وطول البقاء حبيب الفتى % % ولكن بأي مقيت شفع % % 6(@)(@@) % نحب البقاء وفيه الغنا % % ء والعيش متصل منقطع % % 7(@)(@@) % إذا المرء طالت به مدة % علا الشيب مفرقه أو صلع % % 8(@)(@@) % فمحبوبه مع مكروهه % % إذا ما اجتنى منه أريا لسع % 9(@)(@@) % وشيخوخة المرء أمنية % متى ما تناهى إليها هلع % 10(@)(@@) % ألا فعزاءك عما مضى % % فليس يؤوب إلى من جزع % PageV01P2760 11(@)(@@) % ولا تعدل الدهر في غدره % % بإخوانه فعليه طبع % % 12(@)(@@) % ألا وازدرع ما جدا مدحة % فإنك حاصد ما تزدرع % % 13(@)(@@) % ولا تعدون ابن عبد العزي % % ز والحكم حكمك إن لم يرع % % 14(@)(@@) % ولم لا يريع لزراعه % % كريم أثير ومدح زرع % % 15(@)(@@) % ألا فامر أخلاف معروفه % % فإنك إن تمرها ترتضع % % 16(@)(@@) % يكنى بليلى على أنه % % ينوب عن الفلق المنصدع % % 17(@)(@@) % وإن كان كالليل في ظله % % وفي وسعه كل شيء وسع % 18(@)(@@) % فتى ضاف بغداد يقري اللهى % % فكل بريقه مرتبع % % 19(@)(@@) % ولم ير ضيف قرى قبله % % مضيفا ولا كان فيما سمع % 20(@)(@@) % فتى لا تزال لسؤاله % % عطايا على سائل تقترع % % PageV01P2761 21(@)(@@) % تنادت قرائن أمواله % % ألا للتفرق ما نجتمع % 22(@)(@@) % جواد غدا كل ذي خلة % بما ضر ثروته منتفع % 23(@)(@@) % جلا عرضه وجلا سيفه % % جميعا فما فيهما من طبع % 24(@)(@@) % فهذا لزينته آمنا % % وذاك لبذلته إن فزع % % 25(@)(@@) % يلاقي القوافي في درعه % % ويلقى الحروب ولم يدرع % % 26(@)(@@) % وما يعرف الدرع 
ms698	 إلا الندى % % أو الصبر في كل يوم مصع % % 27(@)(@@) % إذا قيل عافيه عاف أني % % ل قلت لهم بل جناب ربع % % 28(@)(@@) % إذا امتيح جم لممتاحه % % ويأبى صفاه إذا ما قرع % % 29(@)(@@) % قريب النوال بعيد المنا % % ل يقرب في شرف مرتفع % % 30(@)(@@) % كمثل السحاب نأى شخصه % ولم ينأ منه صبيب همع % % PageV01P2762 31(@)(@@) % ولا عيب فيه سوى نائل % يلاقي السؤال بخد ضرع % % 32(@)(@@) % على أنه قد كفى السائلي % % ن فاترعوا وهو لا يترع % % 33(@)(@@) % أعف العفاة فقد أصبحت % % عطاياه تنتجع المنتجع % % 34(@)(@@) % فسائله شامخ باذخ % ونائله خاشع منقمع % 35(@)(@@) % تولت سماحته أمره % % وفيها خلال الخليع الورع % 36(@)(@@) % فخانته واقتطعت ماله % % ألا حبذا الخائن المقتطع % 37(@)(@@) % ولكنها وفرت عرضه % % وصانته عن كل قيل قذع % 38(@)(@@) % ولم تضطلع باختزان الثرا % % ء لكنها بالعلا تضطلع % 39(@)(@@) % أطاع السماحة في ماله % % فأي الثناء له لم يطع % % 40(@)(@@) % فلا يعجب الناس من مقول % غدا في مدائحه ينزرع % % PageV01P2763 41(@)(@@) % وحسب الكريم إذا ما حبا % % وحسب اللئيم إذا ماشبع % % 42(@)(@@) % يرى المال يعطى كمثل القذا % % أميط وليس كأنف جدع % % 43(@)(@@) % متى ينخدع لك عن ماله % % فليس عن المجد بالمنخدع % % 44(@)(@@) % يميت الرياء ويحيى الندى % % فيعطي ويخفي الذي يصطنع % % 45(@)(@@) % على أنه المسك يأبى ثنا % % ه إلا انتشارا وإن لم يمع % % 46(@)(@@) % يسر العطايا وآلاؤه % % يرين إذاعة ما لم يذع % % 47(@)(@@) % ومن فعل الخير مستخفيا % أشاعت مساعيه ما لم يشع % 48(@)(@@) % أبا ليلة البدر خذها إلي % % ك تصدق فيك ولا تخترع % % 49(@)(@@) % مهذبة مثل ممدوحها % % من الخلع اللائي لا تختلع % % 50(@)(@@) % هي الدهر تاج على ربها % % وقرطان في أذني مستمع % % PageV01P2764 51(@)(@@) % يقول الوعاة إذا أنشدت % أألصخر يقتلع المقتلع % % 52(@)(@@) % أتيت نوالك من بابه % % ولست الخدوع ولست الخدع % % 53(@)(@@) % وما ساءني فوت ما فاتني % % وإن كان كالعضو مني نزع % % 54(@)(@@) % لأني على ثقة أنني % % متى رمت رفدك لم يمتنع % % 55(@)(@@) % سبقت بأشياء أسديتها % % وأنت المخيلة لا تنقشع % % 56(@)(@@) % ومدت وسائل أعدمتها % % وأنت الوسيلة لا تنقطع % % 57(@)(@@) % فما فاتني فكأن لم يفت 
ms699	 % وما ضاع لي فكأنما لم يضع % 58(@)(@@) % وأقسم بالله إن لم أهب % نصيبي منك وإن لم أبع % % 59(@)(@@) % ولكنني في يدي علة % وأرجو بيمنك أن تتزع % % 60(@)(@@) % وإن يك لي سبب قاطع % % فما أملي فيك بالمنقطع % PageV01P2765 61(@)(@@) % ومن يعترض مثلكم لا يقف % % ومن يقتحم مثلكم لا يكع % 62(@)(@@) % وكم من مسيء أتى سابقا % ويا رب محسن قوم تبع % % 63(@)(@@) % ومن حاربته الليالي اشتكى % % ومن سالمته الليالي مجع % 64(@)(@@) % ومسبعة الدهر مشحونة % % ومن حل بين سباع سبع % % 65(@)(@@) % فلا تحرمني على علتي % % فأحظى بحظي لهيف وجع % % 66(@)(@@) % جرى الشعراء لكي يبدعوا % % فلم يجدوا غير ما تصطنع % % 67(@)(@@) % وحاولت إبداع أكرومة % % على أوليك فلم تستطع % % 68(@)(@@) % فأصبحتم قد تكافأتم % ولا بدع حاولتم ممتنع % % 69(@)(@@) % فلا تطلبوا بعدها بدعة % % وكونوا كسائر من يتبع % % 70(@)(@@) % أقول وقد أرهنوك الأمي % % ر لا بالذميم ولا بالجدع % PageV01P2766 71(@)(@@) % ولا بالهدان ولا بالددا % % ن كلا ولا بالجبان الهلع % 72(@)(@@) % ولا بالقليل ولا بالذلي % % ل كلا ولا بالبخيل الجشع % % 73(@)(@@) % وفى للأمير أناس غدا % % رهينتهم كل مرعى مرع % 74(@)(@@) % وفى للأمير أناس غدا % % رهينتهم كل طود فرع % % 75(@)(@@) % فأنى يخيس أناس غدت % رهينتهم كل خير جمع % % 76(@)(@@) % وفى حاجب راهنا قوسه % % وراقب فيها الحديث الشنع % 77(@)(@@) % وقومك أحنى على رهنهم % % وما البدر من عود نبع فرع % 78(@)(@@) % وآل أبى دلف معشر % يرون المكارم دينا شرع % % 79(@)(@@) % إذا أبدىء الطول منهم أعي % % د أو أوتر العرف فيهم شفع % % 80(@)(@@) % ترى في ذراهم غنى المجتدي % % وعز الذليل وأمن الفزع % % PageV01P2767 81(@)(@@) % وفيهم مذاقان للذائقي % % ن حلو لذيذ ومر بشع % % 82(@)(@@) % بنوا في الجبال جبال العلا % % فتلك الجبال لها تختشع % % 83(@)(@@) % وما امتنعوا من عدو بها % % ولكنها بهم تمتنع % % 84(@)(@@) % سمت بجدودهم رتبة % جدود الملوك لها تصطرع % % 85(@)(@@) % هم المبدعون بديع العلا % % إذا كان غيرهم المتبع % % 86(@)(@@) % وما الدين إلا مع التابعي % % ن لكنما المجد للمبتدع % 87(@)(@@) % يضيق على مادحي غيرهم % % مقال لمداحهم يتسع % 88(@)(@@) % هم يبسطون لسان العيي % % ي مجدا يصنع غير 
ms700	 الصنع % 89(@)(@@) % وهم يقطعون لسان البلي % % غ جودا يقنع غير القنع % % 90(@)(@@) % يفوه مداحهم أنهم % % يمدونهم من إناء ترع % % PageV01P2768 91(@)(@@) % ويسكت مداحهم أنهم % % يجودونهم من نجاء همع % % 92(@)(@@) % فكم بسطوا من لسان امرىء % فأسرف في الطول حتى ذرع % % 93(@)(@@) % وكم قطعوا من لسان امرىء % وإن كان لم يدم لما قطع % % 94(@)(@@) % هم غضبوا للعلا فاشتروا % % مدائح بيعت فلم تستبع % % 95(@)(@@) % سموا فاشتروها بأحسابهم % % ولم يشتروها لوهي رقع % 96(@)(@@) % وكم راقع حسبا واهيا % بمدح وإن كان لا يرتقع % 97(@)(@@) % ولم يعلهم جودهم بل علوا % % فجاءوا بكل نوال منع % % 98(@)(@@) % علوا فسقوا كل من تحتهم % % فكم من عليل بهم قد نقع % % 99(@)(@@) % كسقف السماء أغاث العبا % % د شكرا لرفعه إذ رفع % 100(@)(@@) % وحق العلو على المعتلي % % حنو وعطف على المتضع % PageV01P2769 101(@)(@@) % كأنكم يا بني قاسم % كواكب من قمر تنقلع % 102(@)(@@) % هو البدر أداكم أنجما % تواضع في فلك يرتفع % % 103(@)(@@) % كساكم أبو دلف خيمه % فكل بسكته منطبع % % 104(@)(@@) % وكنتم أناسا لكم شيمة % قد استشعر اليأس منها الطمع % % 105(@)(@@) % وفي الناس مما خصصتم به % تفاريق لكن متى تجتمع % % 106(@)(@@) % وما بات عانيكم كانعا % ولا هم جاركم مكتنع % % 107(@)(@@) % وقدما وددتم وعوديتم % وهيهات من ضر ممن نفع % % 108(@)(@@) % فليس يعافكم ذائق % وليس يسيغكم مبتلع % % PageV01P2770 البحر : - 1(@)(@@) % هل أنت من مرتجيك مستمع % يا من إليه يوائل الفزع % 2(@)(@@) % أصغ إليه فلم يحابك في ال % % مدح ولا قال وهو مخترع % 3(@)(@@) % يا من إذا أشرقت محاسنه % ظلت رؤوس العداة تنقمع % 4(@)(@@) % ومن إذا غربت مكائده % كادت قلوب العتاة تنخلع % 5(@)(@@) % ومن إذا أمطرت فواضله % % عاد الصفا وهو معشب مرع % % 6(@)(@@) % ما أعذر القرن في تذبذبه % % يهوي إليك الشبا وينقدع % % 7(@)(@@) % قد علم القرن عند حيصته % % عنك بأي السيوف تضطبع % % 8(@)(@@) % وقد درى حين زال مطمعه % % فيك بأي الدرع تدرع % % 9(@)(@@) % أنت الذي أصبحت عوارفه % % درعا له والدروع تنصدع % % 10(@)(@@) % وأنت من لم تزل مكائده % % سيفا له والسيوف تنقطع % % PageV01P2771 11(@)(@@) % تصرع من شئت عند لبسهما % % يوم الوغى والجدود 