ms123	 وآخرهما تنزع ) )(@)(@@) ( حم م د ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1111 ) قال النبي :(@)(@@) | 30 ( إذا انتهى أحدكم إلى الصف وقد تم فليجبذ إليه رجلا يقيمه إلى جنبه ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1112 ) قال النبي :(@)(@@) | 30 ( إذا انتهى أحدكم إلى المجلس فإن وسع له فليجلس ، وإلا فلينظر إلى أوسع مكان يراه فليجلس فيه ) )(@)(@@) ( البغوي طب هب ) عن شيبة بن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1113 ) قال النبي :(@)(@@) | 30 ( إذا انتهى أحدكم إلى المجلس فليسلم ، فإن بدا له PageV01P176 أن يجلس فليجلس ، ثم إذا قام فليسلم فليست الأولى بأحق من الآخرة ) )(@)(@@) ( حم د ت حب ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1114 ) قال النبي :(@)(@@) | 30 ( إذا أنزل الله بقوم عذابا أصاب العذاب من كان فيهم ثم بعثوا على أعمالهم ) )(@)(@@) ( حم خ ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1115 ) قال النبي :(@)(@@) | 30 ( إذا أنفق الرجل على أهله نفقة وهو يحتسبها كانت له صدقة ) )(@)(@@) ( حم ق ن ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1116 ) قال النبي :(@)(@@) | 30 ( إذا أنفقت المرأة من بيت زوجها عن غير أمره فلها نصف أجره ) )(@)(@@) ( ق د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1117 ) قال النبي :(@)(@@) | 30 ( إذا أنفقت المرأة من بيت زوجها غير مفسدة كان لها أجرها بما أنفقت ولزوجها أجره بما كسب ، وللخازن مثل ذالك لا ينقص بعضهم من أجر بعض شيئا ) )(@)(@@) ( ق 4 ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1118 ) قال النبي :(@)(@@) | 30 ( إذا انفلتت دابة أحدكم بأرض فلاة فليناد يا عباد الله احبسوا علي دابتي ، فإن لله في الأرض حاضرا سيحبسه عليكم ) )(@)(@@)(@@)(@@) $ ( 4 ) و ابن السنى ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1119 ) قال النبي :(@)(@@) | 30 ( إذا انقطع شسع أحدكم فلا يمش في نعل واحدة حتى يصلح شسعه ، ولا يمش في خف واحد ، ولا يأكل بشماله ، ولا يحتب بالثوب الواحد ، ولا يلتحف الصماء ) )(@)(@@) ( م د ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1120 ) قال النبي :(@)(@@) | 30 ( إذا انقطع شسع نعل 
ms124	 أحدكم فلا يمش في الأرض حتى يصلحها ) )(@)(@@) ( خد م ن ) عن أبي هريرة ( طب ) عن شداد بن أوس رضي الله عنهما .(@)(@@) PageV01P177(@)(@@)(@@)(@@) $ ( 1121 ) قال النبي :(@)(@@) | 30 ( إذا انقطع شسع نعل أحدكم فليسترجع فإنها من المصائب ) )(@)(@@) ( البزار عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1122 ) قال النبي :(@)(@@) | 30 ( إذا أوقف الله العباد نادى مناد ليقم من أجره على الله فليدخل الجنة ، قيل : من ذا الذي أجره على الله ؟ قال : العافون عن الناس ، فقام كذا وكذا ألفا فدخلوا الجنة بغير حساب ) )(@)(@@) ( ابن أبي الدنيا في ذم الغضب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1123 ) قال النبي :(@)(@@) | 30 ( إذا أوى أحدكم إلى فراشه فلينفضه بداخلة إزاره ، فإنه لا يدري ما خلفه عليه ، ثم ليضطجع على شقه الأيمن ، ثم ليقل باسمك ربي وضعت جنبي وبك أرفعه ، إن أمسكت نفسي فارحمها ، وإن أرسلتها فاحفظها بما تحفظ به عبادك الصالحين ) )(@)(@@) ( ق د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1124 ) قال النبي :(@)(@@) | 30 ( إذا أويت إلى فراشك فقل : الحمد لله الذي من علي فأفضل ، والحمد لله رب العالمين رب كل شيء وإله كل شيء ، أعوذ بك من النار ) )(@)(@@) ( البزار ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1125 ) قال النبي :(@)(@@) | 30 ( إذا أويت إلى فراشك فقل : اللهم رب السماوات السبع وما أظلت ، ورب الأرضين وما أقلت ، ورب الشياطين وما أضلت ، كن لي جارا من شر خلقك كلهم جميعا أن يفرط علي أحد منهم أو أن يبغي ، عز جارك وجل ثناؤك ولا إلاه غيرك ولا إلاه إلا أنت ) )(@)(@@) ( ت ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1126 ) قال النبي :(@)(@@) | 30 ( إذا أويت إلى فراشك فقل : باسمك اللهم وضعت جنبي ، طهر لي قلبي ، وطيب كسبي ، واغفر لي ذنبي ) )(@)(@@) ( ابن السنى ) في عمل يوم وليلة عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1127 ) قال النبي :(@)(@@) | 30 ( إذا باتت المرأة هاجرة فراش زوجها لعنتها الملائكة PageV01P178 حتى تصبح ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1128 ) قال النبي :(@)(@@) | 30 ( إذا باع أحدكم الشاة أو اللقحة 
