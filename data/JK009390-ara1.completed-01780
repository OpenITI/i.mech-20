ms1761	 القمر ليلة البدر لا يبصره منكم إلا البصير ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16021 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا لم تجتبوا دينارا ولا درهما تنتهك ذمة وذمة رسوله ، يشد الله قلوب أهل الذمة فيمنعون ما في أيديهم ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16022 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا نزل ابن مريم فيكم فأمكم ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16023 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا نزل ابن مريم فيكم وإمامكم منكم ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16024 ) قال النبي :(@)(@@) | 30 ( كيف أنتم وصاحب القرن قد التقم القرن ، وحنا الجبهة ، وأصغى السمع ينتظر متى يؤمر بالنفخ فينفخ ، قالوا : كيف نصنع ؟ قال : قولوا حسبنا الله ونعم الوكيل ، على الله توكلنا ) )(@)(@@) ( حم ت حب ك ) عن أبي سعيد ( حم ك ) عن ابن عباس ( حم طب ) عن زيد بن أرقم أبو الشيخ في العظمة عن أبي هريرة ، ( حل ) عن جابر ، الضياء عن أنس رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 16025 ) قال النبي :(@)(@@) | 30 ( كيف بالوليمة يدعون الشبعان ويطردون الغرثان PageV05P468 ويدعون ) )(@)(@@) ( قط ) في الأفراد عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16026 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا أتت عليكم أمراء يصلون الصلاة لغير ميقاتها ، صل الصلاة لميقاتها واجعل صلاتك معهم سبحة ) )(@)(@@) ( د ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16027 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا جمعكم الله كما يجمع النبل في الكنانة خمسين ألف سنة لا ينظر إليكم ) )(@)(@@) ( طب ك ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16028 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا غدا أحدكم في حلة وراح في حلة ، ووضعت بين يديه صحفة ورفعت أخرى وسترتم بيوتكم كما تستر الكعبة ، أنتم اليوم خير منكم يومئذ ) )(@)(@@) ( ت ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16029 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا كنتم من دينكم كرؤية الهلال ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16030 ) قال النبي :(@)(@@) | 30 ( كيف بكم بزمان يوشك أن 
ms1762	 يأتي يغربل الناس فيه غربلة ، ويبقى حثالة من الناس قد مرجت عهودهم وأماناتهم واختلفوا وكانوا هاكذا ، وشبك بين أصابعه ، تأخذون بما تعرفون ، وتدعون ما تنكرون ، وتقبلون على أمر خاصتكم ، وتذرون أمر عامتكم ) )(@)(@@) ( ه ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16031 ) قال النبي :(@)(@@) | 30 ( كيف تقولون لفرح رجل انفلتت منه راحلته تجر زمامها بأرض قفر ليس بها طعام ولا شراب ، وعليها له طعام وشراب ، فطلبها فلم يجدها حتى شق عليه ، ثم مرت بجذل شجرة فتعلق زمامها فوجدها متعلقة به ، أما PageV05P469 والله ، لله أشد فرحا بتوبة عبده من الرجل براحلته ) )(@)(@@) ( حم م ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16032 ) قال النبي :(@)(@@) | 30 ( كيف وقد قيل ) )(@)(@@) ( خ ) عن عقبة بن الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16033 ) قال النبي :(@)(@@) | 30 ( كيف يقدس الله أمة لا يأخذ ضعيفها حقه من قويها وهو غير متعتع ) )(@)(@@) ( ع هق ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16034 ) قال النبي :(@)(@@) | 30 ( كيف يقدس الله أمة لا يؤخذ من شديدهم لضعيفهم ) )(@)(@@) ( ه حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16035 ) قال النبي :(@)(@@) | 30 ( كيلوا طعامكم فإن البركة في الطعام المكيل ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16036 ) قال النبي :(@)(@@) | 30 ( كيلوا طعامكم يبارك لكم فيه ) )(@)(@@) ( حم خ ) عن المقدام بن معديكرب ( تخ ه ) عن عبد الله بن بسر ( حم ه ) عن أبي أيوب ( طب ) عن أبي الدرداء رضي الله عنهم .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 16037 ) قال النبي :(@)(@@) | 30 ( كيسان صلوا على صاحبكم ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16038 ) قال النبي :(@)(@@) | 30 ( كيف تهلك أمة أنا أولها وعيسى ابن مريم آخرها ) )(@)(@@) ( كر ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV05P470(@)(@@)(@@)(@@) $ ( 16039 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا أظلكم الموت الأبيض موت الفجاءة ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16040 ) قال النبي :(@)(@@) | 30 ( كيف تهلك أمة أنا في أولها وعيسى بن مريم في آخرها ، والمهدي من أهل بيتي في وسطها ) )(@)(@@) ( ك ) في تاريخه ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16041 ) قال النبي :(@)(@@) | 30 ( كيف 
ms1763	 يا ع| ائشة ولم يقل ساعة قط من ليل أو نهار رب اغفر لي خطيئتي يوم الدين ) )(@)(@@) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 16042 ) قال النبي :(@)(@@) | 30 ( كيف لا يشق علي وأنتم أعوان الشيطان على أخيكم ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16043 ) قال النبي :(@)(@@) | 30 ( كيف بك يا ا| بن عمر إذا عمرت في حثالة من الناس يخبئون رزق سنة ويضعف اليقين ) )(@)(@@) ( خ ) في رواية حماد بن شاكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16044 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا ابتليتم بعبد قد سخرت له أنهار الأرض وثمارها ، فمن اتبعه أطعمه وأكفره ، ومن عصاه حرمه ومنعه ، إن الله تعالى يعصم المؤمنين يومئذ بما يعصم به الملائكة من التسبيح ، إن بين عينيه كافر يقرؤه كل كاتب وغير كاتب ) )(@)(@@) ( طب ) عن أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 16045 ) قال النبي :(@)(@@) | 30 ( كيف بك يا عبد الرحمان إذا كان عليكم أمراء يطفئون السنة ، ويؤخرون الصلاة عن ميقاتها ؟ قال : فكيف تأمرني يا رسول الله ؟ قال : يسألني ابن أم عبد كيف يفعل ؟ ، لا طاعة لمخلوق في معصية الله ) )(@)(@@) ( طب حم ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV05P471(@)(@@)(@@)(@@) $ ( 16046 ) قال النبي :(@)(@@) | 30 ( كيف بكم إذا أتت عليكم أمراء يصلون الصلاة لغير وقتها ، قيل : ما تأمرني ؟ قال : صل الصلاة لوقتها لميقاتها ، واجعل صلاتك معهم سبحة ) )(@)(@@) ( حب هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16047 ) قال النبي :(@)(@@) | 30 ( كيف أنت يا ثوبان إذا تداعت عليكم الأمم كتداعيكم على قصعة الطعام ، تصيبون منه ؟ قال : أمن قلة ؟ قال : لا أنتم يومئذ كثير ، ولاكن يلقى في قلوبكم الوهن ، قالوا : وما الوهن يا رسول الله ؟ قال : حبكم الدنيا وكراهيتكم القتال ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16048 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا التقتكم فتنة فتتخذ سنة يربو فيها الصغير ، ويهرم فيها الكبير ، وإذا ترك منها شيء قيل : تركت سنة ، إذا كثر قراؤكم ، وقل علماؤكم ، وكثر أمراؤكم ، وقلت أمناؤكم ، والتمست الدنيا بعمل الآخرة ، وتفقه لغير الله ) )(@)(@@) ( حل ) عن ابن 
ms1764	 مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16049 ) قال النبي :(@)(@@) | 30 ( كيف تصنعون في فتنة تكون في أقطار الأرض كأنها صياصي بقر تبعوا هاذا وأصحابه وأشار إلى عثمان ) )(@)(@@) ( حم طب ) عن مرة البهزي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16050 ) قال النبي :(@)(@@) | 30 ( كيف بك يا أبا رافع إذا افتقرت ؟ قال : أفلا أتقدم في ذالك ؟ قال : بلى ، ما مالك ؟ قال : أربعون ألفا وهي لله ، قال : لا ، أعط بعضا وأمسك بعضا ، وأصلح إلى ولدك ، قال : أو لهم علينا حق كما لنا عليهم ؟ قال : نعم ، حق الولد على الوالد أن يعلمه كتاب الله والرمي والسباحة وأن يورثه طيبا ) )(@)(@@) ( حل ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16051 ) قال النبي :(@)(@@) | 30 ( كيف أنتم وصاحب الصور قد التقم القرن ، وحنى PageV05P472 ظهره ، ينظر تجاه العرش كأن عينيه كوكبان دريان لم يطرف قط مخافة أن يؤمر من قبل ذالك ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16052 ) قال النبي :(@)(@@) | 30 ( كيف أنتم بعدي إذا شبعتم من خبز البر والزيت ، وأكلتم ألوان الطعام ، ولبستم ألوان الثياب ، فأنتم اليوم خير أم ذاك ؟ قالوا : ذاك ، قال : بل أنتم اليوم خير ) )(@)(@@) ( هق كر ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16053 ) قال النبي :(@)(@@) | 30 ( كيف لك بلا إلاه إلا الله يوم القيامة ؟ ) )(@)(@@) ( طب ) عن أسامة قال : أوجرت رجلا بالرمح وهو يقول لا إلاه إلا الله ، فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 16054 ) قال النبي :(@)(@@) | 30 ( كيف تفلح والدنيا أحب إليك من أحنى الناس عليك ؟ ) )(@)(@@) ( خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16055 ) قال النبي :(@)(@@) | 30 ( كيف بك إذا خرجت من خيبر تعدو بك قلوصك ليلة بعد ليلة ؟ قاله لابن أبي الحقيق ) )(@)(@@) ( خ ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16056 ) قال النبي :(@)(@@) | 30 ( كيف بروعة المؤمن ؟ ) )(@)(@@) ( طب ) عن عمرو بن يحيى بن أبي حسن عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 16057 ) قال النبي :(@)(@@) | 30 ( كيف ترى جعيلا وكيف ترى فلانا ؟ فجعيل خير من ملء الأرض مثل هاذا ، إنه رأس قومه فأتلفهم ) )(@)(@@) الروياني ( حل ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16058 ) قال النبي :(@)(@@) | 30 ( كيف بك إذا بقيت 
ms1765	 في حثالة من الناس قد مرجت عهودهم وأماناتهم ، واختلفوا فصاروا هاكذا ، وشبك بين أصابعه ؟ قال : الله ورسوله أعلم ، قال : اعمل بما تعرف ودع ما تنكر ، وإياك والتلون في دين الله وعليك بخاصة ودع عوامهم ) )(@)(@@) ( طب ) عن سهل بن سعد الشيرازي عن الحسن مرسلا .(@)(@@) PageV05P473(@)(@@)(@@)(@@) $ ( 16059 ) قال النبي :(@)(@@) | 30 ( كيف تقرأ إذا قمت في الصلاة ؟ قال : الحمد لله رب العالمين ، قال : قل : بسم الله الرحمان الرحيم ) )(@)(@@) ( قط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16060 ) قال النبي :(@)(@@) | 30 ( كيف أنتم وربع الجنة لكم ولسائر الناس ثلاثة أرباعها ، كيف أنتم وثلثها ، كيف أنتم والشطر ؟ أهل الجنة يوم القيامة عشرون ومائة صف أنتم منها ثمانون صفا ) )(@)(@@) ( حم طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16061 ) قال النبي :(@)(@@) | 30 ( كيف أنت إذا كنت في حثالة من الناس واختلفوا حتى يكونوا هاكذا وشبك بين أصابعه ؟ خذ ما تعرف ، ودع ما تنكر ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16062 ) قال النبي :(@)(@@) | 30 ( كيف تقدس أمة لا يؤخذ لضعيفها من قويها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16063 ) قال النبي :(@)(@@) | 30 ( كيف أنتم في قوم مرجت عهودهم وأيمانهم وأماناتهم وصاروا هاكذا ؟ وشبك بين أصابعه قالوا : كيف نصنع يا رسول الله ؟ قال : اصبروا وخالقوا الناس بأخلاقهم وخالفوهم في أعمالهم ) )(@)(@@) ( بز ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16064 ) قال النبي :(@)(@@) | 30 ( كيف ترون إذا أخرتم في زمان حثالة من الناس قد مرجت عهودهم ونذورهم ، فاشتكوا فكانوا هاكذا ؟ وشبك بين أصابعه قالوا : الله ورسوله أعلم ، قال : تأخذون ما تعرفون ، وتدعون ما تنكرون ، ويقبل أحدكم على خاصة نفسه ، ويذر أمر العامة ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16065 ) قال النبي :(@)(@@) | 30 ( كيف أنت يا عوف إذا افترقت هاذه الأمة على ثلاث PageV05P474 وسبعين فرقة ، واحدة منها في الجنة وسائرهن في النار ؟ قال : وكيف ذالك ؟ قال : إذا كثرت الشرط وملكت الإماء ، وقعدت الحملان على المنابر ، واتخذ القرآن مزامير وزخرفت المساجد ، ورفعت المنابر ، اتخذ الفيء دولا ، والزكاة مغرما ، والأمانة مغنما ، وتفقه في الدين 
ms1766	 لغير الله ، وأطاع الرجل امرأته ، وعق أمه ، وأقصى أباه ، ولعن آخر هاذه الأمة أولها ، وساد القبيلة فاسقهم ، وكان زعيم القوم أرزلهم ، وأكرم الرجل اتقاء شره ، فيومئذ ذاك ، ويفزع الناس يومئذ إلى الشام ، وإلى مدينة يقال لها دمشق ، من خير مدن الشام ، فتحصنهم من عدوهم ، قيل ؛ وهل تفتح الشام ؟ قال : نعم وشيكا ، ثم تقع الفتن بعد فتحها ، ثم تجيء فتنة غبراء مظلمة ، ثم يتبع الفتن بعضها بعضا ، حتى يخرج رجل من أهل بيتي يقال له المهدي ، فإن أدركته فاتبعه ، وكن من المهتدين ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16066 ) قال النبي :(@)(@@) | 30 ( كيف أنت يا برير ؟ قاله لأبي ذر ) )(@)(@@) ( طب ) عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 16067 ) قال النبي :(@)(@@) | 30 ( كيف بإحداكن إذا نبحتها كلاب الحوأب ؟ ) )(@)(@@) ( حم ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 16068 ) قال النبي :(@)(@@) | 30 ( كيف تجدين أبا عبد الله ؟ أكرميه فإنه من أشبه أصحابي بي خلقا يعني عثمان ، قاله لرقية ) )(@)(@@) وتعقب ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16069 ) قال النبي :(@)(@@) | 30 ( كيف أنت يا عثمان إذا لقيتني يوم القيامة وأوداجك PageV05P475 تشخب دما ؟ فأقول : من فعل بك هاذا ؟ فتقول : بين خاذل ، وقاتل ، وآمر ، فبينا نحن كذالك إذ ينادي مناد من تحت العرش : إن عثمان قد حكم في أصحابه ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 16070 ) قال النبي :(@)(@@) | 30 ( كيف وقد قيل ؟ ) )(@)(@@) ( خ ) عن عقبة بن الحارث أنه تزوج فأتته امرأة فقالت : قد أرضعتكما ، فسأل رسول الله عن ذالك قال : فذكره .(@)(@@)(@@)(@@) $ ( 16071 ) قال النبي :(@)(@@) | 30 ( كيف أبعث هاذين وهما من الدين بمنزلة السمع والبصر من الراس يعني أبا بكر وعمر رضي الله عنهما ) )(@)(@@) ( طب ) و أبو نعيم في فضائل الصحابة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16072 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا شبعتم من ألوان الطعام ؟ قالوا : أو يكون ذالك ؟ قال : نعم ، قد أدركتموه أو من قد أدركه منكم ، فكيف أنتم إذا عدا أحدكم في حلة وراح في أخرى ؟ قالوا : أو يكون ذالك ؟ قال : كأنكم قد أدركتموه 
ms1767	 أو من أدركه منكم ، كيف أنتم إذا سترتم بيوتكم كما تستر الكعبة ؟ قالوا : رغبة عن الكعبة ؟ قال : لا ، ولاكن من فضل تجدونه ، قالوا : نحن خير اليوم أو يومئذ ؟ قال : لا بل أنتم أفضل ) )(@)(@@) هناد عن سعيد بن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16073 ) قال النبي :(@)(@@) | 30 ( كيف أنتم إذا وقعت فيكم خمس ، وأعوذ بالله أن تكون فيكم أو تدركوهن : ما ظهرت الفاحشة في قوم قط فعمل بها بينهم علانية إلا ظهر فيهم الطاعون والأوجاع التي لم تكن في أسلافهم ، وما منع قوم الزكاة إلا منعوا القطر من السماء ، ولولا البهائم لم تمطروا ، وما بخس قوم المكيال والميزان إلا أخذوا بالسنين ، وشدة المؤونة ، وجور السلطان عليهم ، ولا حكم أمراؤهم بغير ما أنزل الله إلا سلط عليهم عدوهم فاستنفذوا بعض ما في أيديهم ، وما عطلوا كتاب PageV05P476 الله وسنة رسوله إلا جعل الله بأسهم بينهم ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16074 ) قال النبي :(@)(@@) | 30 ( كيف بك يا عائشة إذا رجع الناس إلى المدينة فكانت كالرمانة المحشوية يطعمهم الله من فوق رءوسهم ومن تحت أرجلهم ومن الجنة ؟ ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) ||| ( المحلى بأل من هاذا الحرف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 16075 ) قال النبي :(@)(@@) | 30 ( الكافر يلجمه العرق يوم القيامة حتى يقول أرحني ولو إلى النار ) )(@)(@@) ( خط ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16076 ) قال النبي :(@)(@@) | 30 ( الكبائر : الإشراك بالله ، وعقوق الوالدين ، وقتل النفس ، واليمين الغموس ) )(@)(@@) ( حم خ ت ن ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16077 ) قال النبي :(@)(@@) | 30 ( الكبائر : الإشراك بالله ، وقذف المحصنة ، وقتل النفس المؤمنة ، والفرار يوم الزحف ، وأكل مال اليتيم ، وعقوق الوالدين المسلمين ، وإلحاد بالبيت قبلتكم أحياء وأمواتا ) )(@)(@@) ( هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16078 ) قال النبي :(@)(@@) | 30 ( الكبائر : الشرك بالله ، والإياس من روح الله ، والقنوط من رحمة الله ) )(@)(@@) البزار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16079 ) قال النبي :(@)(@@) | 30 ( الكبائر : الشرك بالله ، وقتل النفس ، وعقوق PageV05P477 الوالدين ، أل