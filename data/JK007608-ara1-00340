ms321	 نبأة % طوامح ألحاظ إلى كل مارق % 58(@)(@@) % ذواكر للنجوى بيوم طعانه % ينسي رؤوس الخيل جذب العلائق % % PageV01P1125 59(@)(@@) % تروع جنان الليث إن لم تذمه % % وتطعن في الأقران إن لم تعانق % % 60(@)(@@) % هنيئا لك العيد المضاعف سعده % % كما ضاعف الوسمي نبت الحدائق % 61(@)(@@) % وكم مثل هذا العيد قضيت فرضه % % بمكة في ظل البنود الخوافق % % 62(@)(@@) % وقدت إليه العيس عجلى مروعة % تناهز في أنماطها والنمارق % 63(@)(@@) % مدفعة تحت السياط كأنها % % إذا جنت الظلماء ، أيدي النقانق % 64(@)(@@) % ويعنتها الحادون أو توسع الخطا % % إلى قرب دار الموقف المتضائق % % 65(@)(@@) % وأي مقام للورى تحت ظله % % مهيب يطاطي من عيون الحدائق % 66(@)(@@) % وأكثر ما تلقى به العين أو ترى % % إفاضة مخلوق إلى قرب خالق % 67(@)(@@) % ثمانين أعطيت المنى في مرورها % % ولم ترم عن مسراك فيها بعائق % 68(@)(@@) % وأكبر ظني أن أرى منك عارضا % يؤممها في مثل تلك البوارق % PageV01P1126 69(@)(@@) % أبا أحمد هذا طلابي ، وهذه % مناي التي أمتك دون الخلائق % % 70(@)(@@) % وإني لأرجو منك ما لا أذيعه % مخافة واش أو عدو مماذق % % 71(@)(@@) % ولا بد من يوم حميد ، كأنه % من النقع في أثناء برد شبارق % 72(@)(@@) % عظيم دوي الصوت في سمع سامع % % بعيد سماع الصوت من نطق ناطق % % 73(@)(@@) % أعد عناي فيه روحا وراحة % % وكم سعة للمرء غب المضائق % 74(@)(@@) % وهذا مقالي فيك غيث ، وربما % % رميت العدا من وقعه بالصواعق % % 75(@)(@@) % إذا أنت يوما سمتنيه ، فإنما % % تكلفني قطع الذرى والشواهق % 76(@)(@@) % وحسبك منه ما رضيت استماعه % وأكثر ما في الناس لغو المناطق % % PageV01P1127 البحر : طويل 1(@)(@@) % ألا يا لقومي للخطوب الطوارق % % وللعظم يرمى كل يوم بعارق % 2(@)(@@) % وللدهر يعري جانبي من أقاربي % % ويقطع ما بيني وبين الأصادق % % 3(@)(@@) % ويوري بقلبي نار وجد شواظها % % تريني الليالي ضوءه في مفارقي % % 4(@)(@@) % وللنائبات استهدفتني نصالها % % على شرف يرميننا بالفلائق % 5(@)(@@) % وللنفس قد طارت شعاعا من الجوى % % لفقد الصفايا وانقطاع العلائق % % 6(@)(@@) % لها كل يوم موقف مع مودع % % وملتفت في عقب ماض مفارق % % 7(@)(@@) % نجوم من الإخوان يرمي بها الردى % % مقاربها فوت العيون 
ms322	 الروامق % % 8(@)(@@) % كأني ، إذا تبعت آثار غارب % بعيني ، لم أنظر إلى ضوء شارق % 9(@)(@@) % ولا دار إلا سوف يجلى قطينها % % على نعق غربان الخطوب النواعق % % 10(@)(@@) % ويخرج منها بالكرائم حادث % % ويدخلها صرف الردى بالبوائق % % PageV01P1128 11(@)(@@) % كأنا قذى يرمي به السيل كلما % % تطاوح ما بين الربى والأبارق % % 12(@)(@@) % أعض بناني إصبعا ثم إصبعا % على ثامر من فرع مجد ووارق % 13(@)(@@) % وعقد من الأخدان أوهى نظامه % كرور الرزايا واعتقاب الطوارق % % 14(@)(@@) % أرد الشجا قبل الزفير تجلدا % وأغلب دمعي قبل بل الحمالق % 15(@)(@@) % كأني بعد الذاهبين رذية % % تزجى وراء الماضيات السوابق % 16(@)(@@) % ولا ريب أني مبرك في مناخهم % وأني بالماضين أول لاحق % 17(@)(@@) % فأين الملوك الأقدمون تساندوا % % إلى جذم أحساب كرام المعارق % 18(@)(@@) % بهاليل مناعون للضيم أحسنوا % % بلائهم عند النصول الذوالق % % 19(@)(@@) % عواصب بالتيجان فوق جماجم % وضاء المجالي واضحات المفارق % % 20(@)(@@) % إذا رثموا المسك العرانين خلتهم % أسود الشرى سافت دما بالمناشق % % PageV01P1129 21(@)(@@) % فحول أطلن الهدر والخطر بالقنا % % ضوارب للأذقان ميل الشقائق % % 22(@)(@@) % هم انتعلوا العلياء قيل نعالهم % وداسوا طلى الأعداء قبل النمارق % 23(@)(@@) % ترى كل حر الملطمين كأنه % عتيق المهارى من جياد عتائق % 24(@)(@@) % إذا قام ساوى الرمح حتى يمسه % بغارب ممطوط النجاد وعاتق % % 25(@)(@@) % وراء الدجى يعشو إلى ضوء وجهه % % كأن على عرنينه ضوء بارق % % 26(@)(@@) % وأين الملاجي العاصمات من الردى % % إذا طرقت إحدى الليالي بطارق % % 27(@)(@@) % مصاعب لم تعط الرؤوس لقائد % % ولا استوسقت قبل المنايا لسائق % % 28(@)(@@) % فشن عليه الأزلم العود غارة % بلا قرع أرماح ولا نقع مازق % % 29(@)(@@) % وشل بها شل الطرائد بالقنا % % وكعكعها من جلة ودرادق % % 30(@)(@@) % لتبكي أبا الفتح العيون بدمعها % % وألسننا من بعدها بالمناطق % % PageV01P1130 31(@)(@@) % إذا هب من تلك الغليل بدامع % تسرع من هذا الغرام بناطق % % 32(@)(@@) % شقيقي إذا التاث الشقيق وأعرضت % خلائق قومي جانبا عن خلائقي % % 33(@)(@@) % كأن جناني يوم وافي نعيه % % فري أديم بين أيدي الخوالق % % 34(@)(@@) % فمن لأوابي القول يبلو عراكها % % ويحذفها حذف النبال الموارق % 35(@)(@@) % إذا صاح في أعقابها أطردت له % ثواني بالأعناق 
ms323	 طرد الوسايق % % 36(@)(@@) % وسومها ملس المتون كأنها % % نزائع من آل الوجيه ولاحق % % 37(@)(@@) % تغلغل في أعقابهن وسومه % % بأبقى بقاء من وسوم الأيانق % 38(@)(@@) % ففي الناس منها ذائق غير آكل % وقد كان منها آكلا غير ذائق % % 39(@)(@@) % ومن للمعاني في الأكمة ألقيت % إلى باقر غيب المعاني وفاتق % % 40(@)(@@) % يطوح في أثنائها بضميره % % مرير القوى ولاج تلك المضايق % PageV01P1131 41(@)(@@) % تسنم أعلا طودها غير عاثر % % وجاوز أقصى دحضها غير زالق % % 42(@)(@@) % طوى منه بطن الأرض ما تستعيده % % على الدهر منشورا بطون المهارق % 43(@)(@@) % مضى طيب الأردان يأرج ذكره % % أريج الصبا تندى لعرنين ناشق % % 44(@)(@@) % كان جميع الناس أثنوا عشية % % على بعض أمطار الربيع المغادق % 45(@)(@@) % أمدوه من طيب لغير كرامة % وضموه في ثوب جديد البنائق % 46(@)(@@) % وما احتاج بردا غير برد عفافه % ولا عرف طيب غير تلك الخلائق % % 47(@)(@@) % مرافق شعب كالهشائهم وسدوا % % بمنقطع البيداء غير المرافق % 48(@)(@@) % قد اعتنقوا الأجداث لا من صبابة % % ويا رب زهد في الضجيع المعانق % 49(@)(@@) % وما الميت إن واراه ستر من الثرى % % بأقرب مما دون رمل الشقائق % 50(@)(@@) % وفارقني عن خلة غير طرقة % تضمنها صدر امرىء غير ماذق % PageV01P1132 51(@)(@@) % تروق ماء الود بيني وبينه % وطاح القذى عن سلسل الطعم رائق % 52(@)(@@) % سقاك وهل يسقيك إلا تعلة % % لغير الردى قطر الغمام الدوافق % 53(@)(@@) % من المزن حمحام ، إذا التج لجة % أضاءت تواليه زناد البوارق % % 54(@)(@@) % سلافة غيث شلشلتها همية % نتيجة أنواء السحاب الرقارق % 55(@)(@@) % ومستنبت روضا عليك منورا % على صابح من ماء مزن وغابق % 56(@)(@@) % وما فرحي إن جاورتك حديقه % % وقبرك مملوء بغر الحدائق % 57(@)(@@) % سخا لك من ريح الزفير بحاصب % مقيم ومن ماء الشؤون بوادق % % 58(@)(@@) % فما العهد مني إن لهوت بثابت % ولا الود مني إن سلوت بصادق % PageV01P1133 البحر : سريع 1(@)(@@) % تعيف الطير ، فأنبأنه % أن ابن ليلى علقته علوق % % 2(@)(@@) % وإن سجلا من دم آمن % أفرغه الطعن بوادي العقيق % % 3(@)(@@) % يا ناعي الفارس قد أصبحت % % ضباع ذي العرعر منه نغوق % 4(@)(@@) % تعلم من تنعى إلى قومه % % طار ذراعاك 
ms324	 بعضب ذلوق % % 5(@)(@@) % بعدا لأرماح تميم لقد % هددن عادي بناء عتيق % 6(@)(@@) % قرعن في أصل كريم الثرى % % وجلن في فرع عزيز العروق % 7(@)(@@) % حدوا له من حيث لا يتقي % % عيرا من الطعن ملاء الوسوق % 8(@)(@@) % كان ذا المطلع أمسى الردى % % رصيده وأزور عنه الفريق % % 9(@)(@@) % قالت لها النفس على عارها % % ما لك لا تنقض هذا الطريق % 10(@)(@@) % ما كان بالراجع عن نهجه % % لو وقف السيف له في المضيق % PageV01P1134 11(@)(@@) % لا يدع الذابل من طعمه % على صبوح بدم ، أو غبوق % 12(@)(@@) % كان أعلاه لسان فما % % يغبه الدهر بلال بريق % % 13(@)(@@) % كم بات رباء لسيارة % طارقة غير أوان الطروق % % 14(@)(@@) % في قنة عيطاء ممطولة % % كأنها قلة رأس حليق % 15(@)(@@) % يزايل الليل على رحله % ويؤثر القوم بطعم الخفوق % % 16(@)(@@) % ويغتدي بعد عراك السرى % % يعارض الركب بوجه طليق % 17(@)(@@) % أوفى ، كما جلى على رهوة % أزرق وإلى نظرات بنيق % % 18(@)(@@) % يسل عينيه على مرية % عن زجل الطير قبيل الشروق % % 19(@)(@@) % يعترق اللحم على بارق % وينتقي العظم برمل الشقيق % 20(@)(@@) % أو حية الرعن ذوى رأسه % % مشترق الشمس بطود زليق % PageV01P1135 21(@)(@@) % يعقد أولاه بأخراته % لفاف بنت الرقم الخنفقيق % % 22(@)(@@) % كعمة الألوث مالت به % بين الندامى نزوات الرحيق % % 23(@)(@@) % جامع لين وصيال معا % أطراق ذي حلم وصول الحنيق % % 24(@)(@@) % يدير في فيه ذليق الشبا % % مثل لماظ الرجل المستذيق % % 25(@)(@@) % تخال ما تطرح أشداقه % % ما لطخ المحض بقعب الغبوق % % 26(@)(@@) % مستجمع فرق عن وثبة % % نشطك حبل العربي الربيق % % 27(@)(@@) % نعم كعام الثغر يشجو به % فم المنايا ونصاح الفتوق % % 28(@)(@@) % تضمه في الروع من درعه % أم لها منه أذى أو عقوق % 29(@)(@@) % زال وأبقى ، عند أعقابه % خديم مال عرفته الحقوق % 30(@)(@@) % مضى ووصاهم بأن يقبلوا % % دعوى العدا فيهم وحكم الصديق % % PageV01P1136 31(@)(@@) % كان هوى للنفس ، لو أنني % % في حلق القد وأنت الطليق % % 32(@)(@@) % ما كنت بالهائب طرق الردى % % ما سلم العضب ، وأنت الرفيق % 33(@)(@@) % ما أنا باللاقي بذات النقا % % خيل وغى مشعلة بالعنيق % 34(@)(@@) % ماطلها الماء ، فلما سلت % عن الروى ماطلها 
ms325	 بالعليق % 35(@)(@@) % ولابن ليلى عارضا رمحه % يحدو بخفان جمالا ونوق % % 36(@)(@@) % يأبى إذا الضيم غدا مضغة % % سلسالة سائغة في الحلوق % % 37(@)(@@) % يروح من يرجو له غرة % قد خضخض السجل بجال عميق % % 38(@)(@@) % يحدث النفس بما فاته % تطاول الغمر لمجنى السحوق % % 39(@)(@@) % استبدل الحي بعقبانه % أغربة بعدك حمق النغيق % % 40(@)(@@) % خاطرت الشول بأذنابها % % لما انطوى قرقار ذاك الفنيق % % PageV01P1137 41(@)(@@) % قد نطق الصامت من بعده % واصرد النابل بعد المروق % % 42(@)(@@) % مخيلة لا مطر خلفها % % تلمع منها شولان البروق % 43(@)(@@) % ما الحي بالضاحك عن مثله % % ولا وجوه الحي مذ غاب روق % % 44(@)(@@) % ولا أغب الأرض تمسي بها % % ظل صفيق ونسيم رقيق % % 45(@)(@@) % لا أغفلت قبرك حنانة % % خرقاء بالقطر صناع البروق % % 46(@)(@@) % ما أبدع المقدار فيما جنى % % لكنه حمل غير المطيق % % PageV01P1138 البحر : طويل 1(@)(@@) % الوي حيازيمي عليك تحرقا % وأشكو قصور الدمع فيك وما رقا % % 2(@)(@@) % فيا شمل لبي لا تزال مبددا % ويا جفن عيني لا تزال مؤرقا % % 3(@)(@@) % فقد كنت أستسقي الدموع لمثلها % % وما جم دمع العين إلا ليهرقا % % 4(@)(@@) % أعاينت هذا الدهر إن سر مرة % أساء ، وإن صفى لنا الود رنقا % % 5(@)(@@) % كأني أنادي منه صماء صلدة % وصل فلاة لا يلين على الرقا % % 6(@)(@@) % إذا غفل الحادون ثار مساورا % وإن روجع النجوى أرم وأطرقا % % 7(@)(@@) % طلوع الثنايا ينفذ الليل لحظه % % إذا ما رنا ، جواب أرض ، وحملقا % % 8(@)(@@) % له المنظر العاري وكل هنيئة % % تغاور بالأنقاء بردا مشرقا % % 9(@)(@@) % كان زماما ضاع من أرحبية % % تلوى بأقواز النقا ، وتعلقا % % 10(@)(@@) % تلمظ شيئا كالجباب ، وغامرت % به وثبة أمضى من الليث مصدقا % % PageV01P1139 11(@)(@@) % رشاء الردى لو عض بالطود هاضه % ولو شم ما لاقى على الأرض أحرقا % % 12(@)(@@) % دويهية يحمي الطريق مجره % % إذا نفخ الركبان نام وأرقا % % 13(@)(@@) % وما العيش إلا غمة وارتياحة % % ومفترق بعد الدنو وملتقى % % 14(@)(@@) % هو الدهر يبلي جدة بعد جدة % فيا لابسا أبلى طويلا وأخلقا % % 15(@)(@@) % فكم من علي فيك حلق وانهوى % % وكم من غني نال منك وأملقا % % 16(@)(@@) % ومن قبل ما أردى جذاما وحميرا 
ms326	 % وأطرق زور الموت عوجا وعملقا % % 17(@)(@@) % وأبقى على دار السمؤل بركه % % وقاد إلى ورد المنون محرقا % % 18(@)(@@) % ففارق هذا الأبلق الفرد بغتة % % وودع ذا بعد النعيم الخورنقا % % 19(@)(@@) % فما البأس والإقدام نجى عتيبة % % ولا الجود والإعطاء أبقى المحلقا % % 20(@)(@@) % أراه سنانا للقريب مسددا % وسهما إلى النأي البعيد مفوقا % % PageV01P1140 21(@)(@@) % إذا ما عدا لم تبصر البيض قطعا % ولا الزغف مناعا ولا الجرد سبقا % % 22(@)(@@) % ولا في مهاوي الأرض إن رمت مهبطا % ولا في مراقي الجو إن رمت مرتقى % % 23(@)(@@) % ولا الحوت إن شق البحار بفائت % ولا الطيران مد الجناح وحلقا % % 24(@)(@@) % وللعمر نهج إن تسنمه الفتى % % إلى الغاية القصوى أزل وأزلقا % % 25(@)(@@) % ألا قاتل الله الذي جاء غازيا % فقارعنا عن مخة الساق وانتقى % % 26(@)(@@) % وكم من عليل قد شرقت بيومه % % جوى ، بعد ما قالوا أبل وأفرقا % % 27(@)(@@) % وآخر طلقت السرور لفقده % % وقد راح للدنيا النشوز مطلقا % % 28(@)(@@) % بنفسي من أفقدت دارا أنيقة % من العيش واستودعت بيداء سملقا % % 29(@)(@@) % وأبدلته من ظل فينان ناضر % ظلال صفيح كالغمام مطبقا % % 30(@)(@@) % وخففت عن أيدي الأقارب ثقله % % وحملته ثقل الجنادل والنقا % % PageV01P1141 31(@)(@@) % جلست عليه طامعا ثم جاءني % % من اليأس أمر أن أخب وأعنقا % % 32(@)(@@) % وما من هوان خطأ الترب فوقه % وخطى له بيتا من الأمر ضيقا % % 33(@)(@@) % وقد كان فوق الأرض يسحق نأيه % % فصار وراء الأرض أنأى وأسحقا % % 34(@)(@@) % خليلي زما لي من العيس جسرة % مضبرة الأضلاع أدماء سهوقا % % 35(@)(@@) % تمر كما مرت أوائل بارق % يشق الدجى والعارض المتألقا % % 36(@)(@@) % كأن يد القسطار بين فروجها % % يقلب في الكف اللجين المطرقا % % 37(@)(@@) % وحطا لجامي في قذال طمرة % % كأن بها من ميعة الشد أولقا % % 38(@)(@@) % تعير الفتى ظهرا قصيرا ، كأنه % قرا النقنق الطاوي وعنقا عشنقا % % 39(@)(@@) % لعلي أفوت الموت إن جد جده % وأعظم ظني أن ينال ويلحقا % % 40(@)(@@) % وهل يأمن الإنسان من فجآته % % وإن حث بالبيداء خيلا وأينقا % % PageV01P1142 41(@)(@@) % لقد سل هذا الرزء من عيني الكرى % % وغصص بالماء الزلال وأشرقا % % 42(@)(@@) % ومما يعزى المرء ما شاء أنه 
ms327	 % % يرى نفسه في الميتين معرقا % % 43(@)(@@) % ولو غير هذا الموت نالك ظفره % % وولاك غربا للمنايا مذلقا % % 44(@)(@@) % لكان وراء الثار منا . . . . . % عصائب تختار المنون على البقا % % 45(@)(@@) % إذا ضربوا ردوا الحديد مثلما % وإن طعنوا ردوا الوشيج مدققا % % 46(@)(@@) % بكل قصير يفلق الهام أبيض % % وكل طويل يهتك السرد أورقا % % 47(@)(@@) % إذا اهتز من خلف السنان حسبته % % بأعلى النجاد الأرقم المتشدقا % % 48(@)(@@) % ولكنه القرن الذي لا نرده % وهل لامرىء رد إذا الليث حققا % % 49(@)(@@) % يقود الفتى ما زم بالضيم أنفه % % وقد قاد أبطالا وقد جر فيلقا % % 50(@)(@@) % مشقق أعراف الخطابة صامت % % ولاقي صدور الخيل يوم الوغى لقا % % PageV01P1143 51(@)(@@) % ولم تغن عنه الخط قوم درؤها % % ولا البيض أجرى القين فيهن رونقا % % 52(@)(@@) % سقاه ، وإن لم ترو للقلب غلة % وما كان ظني أن أقول له سقا % % 53(@)(@@) % ولا زالت الأنواء تحبوه مرعدا % من المزن ملآن الحيازيم مبرقا % % 54(@)(@@) % إذا قيل ولى عاد يحدو عشاره % % وإن قيل أرقا دمعة القطر أغدقا % % 55(@)(@@) % وأعلم أن لا ينفع الغيث هالكا % ولا يشعر المندوب بالهام إن زقا % % 56(@)(@@) % ولو كان بالسقيا يعود أنا له % كما لو سقي عاري القضيب لأورقا % % 57(@)(@@) % ولكن أداري خاطرا متلهفا % وقلبا بما خلف التراب معلقا % % PageV01P1144 البحر : بسيط تام 1(@)(@@) % لا يبعد الله فتيانا رزئتهم % رزء الغصون ، وفيها الماء والورق % 2(@)(@@) % إن يرحلوا اليوم عن داري فإنهم % % جيران قلبي أقاموا بعد ما انطلقوا % % 3(@)(@@) % بانوا فكل نعيم بعدهم كمد % % باق وكل مساغ بعدهم شرق % % 4(@)(@@) % أراك تجزع للقوم الذين مضوا % % فهل آمنت على القوم الذين بقوا % % 5(@)(@@) % لا يلبث المرء يبلى شرخ جدته % % من الزمان جديد ما له خلق % 6(@)(@@) % هدى الغرام دموعي في مسالكه % عليهم ، وأضلت صبري الطرق % 7(@)(@@) % وكيف ينعم بالتغميض بعدهم % عين أعان عليها الدمع والأرق % 8(@)(@@) % إني لأعجب بعد اليوم من كبد % % تدمى لهم كيف تندي وهي تحترق % % PageV01P1145 البحر : كامل تام 1(@)(@@) % لولا يذم الركب عندك موقفي % % حييت قبرك ، يا أبا إسحق % 2(@)(@@) % كيف اشتياقك مذ نأيت إلى أخ % قلق 
ms328	 الضمير إليك بالأشواق % 3(@)(@@) % هل تذكر الزمن الأنيق وعيشنا % % يحلو على متأمل ومذاق % % 4(@)(@@) % لا بد للقرباء أن يتزايلوا % % يوما ، بعذر قلى وعذر فراق % 5(@)(@@) % أمضي وتعطفني إليك نوازع % % بتنفس كتنفس العشاق % % 6(@)(@@) % وأذود عن عيني الدموع ولو خلت % % لجرت عليك بوابل غيداق % 7(@)(@@) % ولو أن في طرفي قذاة من ثرى % % وأراك ما قذيتها من ماقي % % 8(@)(@@) % إن تمض فالمجد المرجب خالد % % أو تفن فالكلم العظام بواقي % % 9(@)(@@) % مشحوذة تدمى بغير مضارب % كالسيف أطلق في طلى الأعناق % % 10(@)(@@) % يقبلن كالجيش المغير يؤمه % % كمش الإزار مقلص عن ساق % PageV01P1146 11(@)(@@) % قرطات أذان الملوك خليقة % % بمواضع التيجان والأطواق % % 12(@)(@@) % عقدوا بها المجد الشرود وأثلوا % % درجا إلى شرف العلى ومراقي % % 13(@)(@@) % أوترتها أيام باعك صلب % وكددتها بالنزع والإغراق % 14(@)(@@) % حتى إذا مرحت قواك شددتها % % باسم على عقب الليالي باقي % % 15(@)(@@) % كنجائب قعدت بها أرماقها % % محسورة ، فمشين بالأعراق % PageV01P1147 البحر : طويل 1(@)(@@) % أمن ذكر دار بالمصلى إلى منى % % تعاد كما عيد السليم المؤرق % 2(@)(@@) % حنينا إليها والتواء من الجوى % % كأنك في الحي الولود المطرق % % 3(@)(@@) % أألله ، إني إن مررت بأرضها % % فؤادي مأسور ودمعي مطلق % 4(@)(@@) % أكر إليها الطرف ثم أرده % % بإنسان عين في صرى الدمع يغرق % 5(@)(@@) % هواي يمان كيف لا كيف نلتقي % % وركبي منقاد القرينة معرق % % 6(@)(@@) % فواها من الربع الذي غير البلى % % وآها على القوم الذين تفرقوا % % 7(@)(@@) % أصون تراب الأرض كانوا حلولها % % وأحذر من مري عليها وأشفق % 8(@)(@@) % ولم يبق عندي للهوى غير أنني % % إذا الركب مروا بي على الدار أشهق % PageV01P1148 البحر : رجز تام 1(@)(@@) % يا حسن الخلق قبيح الأخلاق ! % إني على ذاك إليك مشتاق % 2(@)(@@) % رب مصاف علق بمذاق % % إن مودات القلوب أرزاق % 3(@)(@@) % يا هل لدائي من هواك أفراق % % هيهات ما أعضل داء العشاق % PageV01P1149 البحر : - 1(@)(@@) % يا ليلة كرم الزمان بها لو أن الليل باق % % لو أن الليل باق % 2(@)(@@) % كان اتفاق بيننا % % جار على غير اتفاق % 3(@)(@@) % واستروح المهجور من % % زفرات هم واشتياق % PageV01P1150 البحر : كامل تام 1(@)(@@) % ولقد أقول لصاحب 
ms329	 نبهته % فوق الرحالة والمطي رواقي % % 2(@)(@@) % أو ما شممت بذي الأبارق نفحة % % خلصت إلى كبد الفتى المشتاق % 3(@)(@@) % فجنى نسيم الشيح من نجد له % % حرق الحشى وتحلب الآماق % % 4(@)(@@) % آها على نفحات نجد ! إنها % % رسل الهوى وأدلة الأشواق % 5(@)(@@) % أسقيت بالكأس التي سقيتها % % أم هل خطتك إلي كف الساقي % % 6(@)(@@) % فأوى وقال : أرى بقلبك لسعة % للحب ليس لدائها من راق % 7(@)(@@) % فصف الغرام لمفرق من دائه % % إني لأقدم منك في العشاق % % 8(@)(@@) % أبثثته كمدي وطول تجلدي % % وأليم ما بي من نوى وفراق % 9(@)(@@) % أشكو إليه بياض سود مفارقي % % ويظل يعجب من سواد الباقي % % PageV01P1151 البحر : خفيف تام 1(@)(@@) % أيها الرائح المغذ تحمل % حاجة للمعذب المشتاق % % 2(@)(@@) % أقرعني السلام أهل المصلى % % وبلاغ السلام بعد التلاقي % % 3(@)(@@) % وإذا ما مررت بالخيف فاشهد % أن قلبي إليه بالأشواق % % 4(@)(@@) % وإذا ما سئلت عني فقل نضو هوى ما أظنه اليوم باق % % و هوى ما أظنه اليوم باق % 5(@)(@@) % ضاع قلبي فانشده لي بين جمع % ومنى عند بعض تلك الحداق % % PageV01P1152 البحر : طويل 1(@)(@@) % كفى حزنا إني صديق وصادق % % وما لي من بين الأنام صديق % 2(@)(@@) % فكيف أريغ الأبعدين لخلة % % وهذا قريب غادر ، وشقيق % PageV01P1153 البحر : طويل 1(@)(@@) % إذا قلت أن القرب يشفي من الجوى % % أبي القلب أن يزداد إلا تشوقا % % 2(@)(@@) % وإن أنا أضمرت السلو تراجعت % % من الشوق أخلاق يزلن التخلقا % % 3(@)(@@) % وكم لي من ليل يجدد لي الهوى % % إذا أشأم البرق اليماني وأعرقا % % 4(@)(@@) % أصانع لحظي أن يطول ذبابه % % إليك ، وأنهى الدمع أن يترقرقا % % 5(@)(@@) % مخافة واش يثلم الحب قوله % % وهيهات طال الحب منا وأورقا % % 6(@)(@@) % غدونا على الأعداء نحمي مودة % ونمنع عن أطرافها أن تمزقا % % 7(@)(@@) % فما أنت إلا السهم صافح ثغره % % وما أنا إلا العضب صادم مفرقا % % 8(@)(@@) % إذا كنت لي خلا فحسبي من الورى % % بقاؤك ، لولا أنت ما طال لي بقا % % 9(@)(@@) % جمعنا فلا نحفل بما صنع الهوى % % وخفنا على الأيام أن نتفرقا % % PageV01P1154 البحر : سريع 1(@)(@@) % لو كان ما تطلبه غاية % كنت المصلي وأنا 
ms330	 السابق % % 2(@)(@@) % تظنني أرغب عن موقف % يحضر فيه الشوق والشائق % % 3(@)(@@) % فكرت حتى لم أجد فكرة % تقدح إلا ولها عائق % 4(@)(@@) % لو كنت في أثناء سري إذا % % علمت أني قائل صادق % 5(@)(@@) % قلبي جنيب لك لا يرعوى % % وودك القائد والسائق % % 6(@)(@@) % ولحظ عينيك رمى مقلتي % % كان نومي تحتها عاشق % % 7(@)(@@) % فاصبر ، فإن الصبر أحرى إذا % % ضاق عليك المسلك الضايق % % 8(@)(@@) % فالنطق الطاهر ما بيننا % % مترجم والنظر الفاسق % % PageV01P1155 البحر : متقارب تام 1(@)(@@) % وليل تمزق عنه النسي % % م واستلب الجو غربا وشرقا % % 2(@)(@@) % ونيلوفر فتحته الرياح % وعانقه الماء صفوا ورنقا % % PageV01P1156 البحر : كامل تام 1(@)(@@) % ما وقع الواشوان في ولفقوا % % قل لي ، فإما حاسد أو مشفق % 2(@)(@@) % في كل يوم ظهر داري مغرب % لكلامهم وجبين دارك مشرق % % 3(@)(@@) % وإلى متى عودي على أيديهم % ملقى ينيب دائبا ويحرق % % 4(@)(@@) % كم يسبك الذهب المصفى مرة % قد لاح جوهره وبان الرونق % 5(@)(@@) % يحلو لهم عرضي فيستطرونه % % ويصل عرضهم الذليل فيبصق % % 6(@)(@@) % نفضوا عيوبهم علي ، وإنما % % وجدوا مصحا في الأديم فمزقوا % % 7(@)(@@) % من لي بمن أن بان عيب خليله % % غطاه عن شانيه ، أو من يصدق % 8(@)(@@) % وإذا الحليم رمى بسر صديقه % % عمدا ، فأولى بالوداد الأحمق % 9(@)(@@) % من كان يغتاب الرجال وهم أن % % يبلو الأصادق فالصديق المطرق % 10(@)(@@) % وإذا تألقت الثغور لسبة % لم يدر ثغرا أو سنا يتألق % PageV01P1157 11(@)(@@) % لا تملك الفحشاء جانب سمعه % % ويزل قول الهجر عنه ويزلق % 12(@)(@@) % جار الزمان فلا جواد يرتجى % % للنائبات ولا صديق يشفق % % 13(@)(@@) % وطغى علي فكل رحب ضيق % إن قلت فيه ، وكل حبل يخنق % 14(@)(@@) % أمر شحي للعزم غير مرشح % % واليوم من ليل العجاجة أبلق % % 15(@)(@@) % دعني فإن الدهر يقصف همتي % % ويجد من أملي الذي أتعلق % % 16(@)(@@) % الموت يركض في نواحي دهرنا % % وكأن صرف النائبات مطرق % PageV01P1158 البحر : منسرح 1(@)(@@) % برقت بالوعد في دجى أملي % % والغيث لا يقتضى إذا برقا % % 2(@)(@@) % حاشاك أن أقتضيك منقبة % % تسلك منها إلى العلى طرقا % % 3(@)(@@) % فانهض لها أنها الغلام تجد % % حبلا ضنينا بكف من علقا % % 4 
ms331	(@)(@@) % وكم صريخ نهضت تنصره % % والطعن يسترعف القنا علقا % % 5(@)(@@) % دع العدا عن جوانبي بيد % يروع فيها النضار والورقا % % PageV01P1159 البحر : بسيط تام 1(@)(@@) % أهز عاسية العيدان آبية % % على الخوابط لا لينا ولا ورقا % % 2(@)(@@) % وما مدحتهم أني رجوتهم % % لكنه عوذ من شرهم ورقا % % 3(@)(@@) % قالوا : نعدك للجلى ، فقلت لهم : % حسبي من الري ما لا يبلغ الشرقا % % 4(@)(@@) % ناموا خليين عما بي ، فلم تركوا % % وهنا علي مطال الهم والأرقا % % 5(@)(@@) % كفى بقوم هجاء أن مادحهم % يهدي الثناء إلى أعراضهم فرقا % % 6(@)(@@) % من لم يبال بأعقاب الحديث غدا % % فما يبالي أمان القول أم صدقا % % PageV01P1160 البحر : خفيف تام 1(@)(@@) % قمر غاض ضوءه في المحاق % يوم جد انطلاقه وانطلاقي % % 2(@)(@@) % جامد اللحظ حيرة البين إلا % أن منه ذوب المهراق % % 3(@)(@@) % صار در الدموع يخلف ثغري % % في حواشي تلك الخدود الرقاق % % 4(@)(@@) % عز صبري يوم اللقاء ، ولكن % فضحته الأشجان يوم الفراق % 5(@)(@@) % يا عريق الهوى ستقضي إذا ما % % طلع البين من ثنايا العراق % % 6(@)(@@) % يوم لا غير زفرة من فؤاد % ذي قروح ورشة من مآق % 7(@)(@@) % نسرق الدمع في الجيوب حياء % وبنا ما بنا من الإشفاق % 8(@)(@@) % كاد طل الدموع يلتذ لولا % % هز سير الرسيم والإعناق % 11(@)(@@) % بيننا ، يا بني المغيرة ، يوم % لو رآنا العدو أضمرنا ما % % 12(@)(@@) % شهقة الضرب في الطلى والهوادي % % رنة الطعن في الكلى والصفاق % % PageV01P1161 15(@)(@@) % حمرت نجدة وليس بذمر % % و جميعا والليل ملقي الرواق % 17(@)(@@) % ونجوم تنوب عنها العوالي % % من سماء العجاج في الآفاق % 19(@)(@@) % حرم حشوه القنا وفناء % % ذو طراز من الجياد العتاق % % 20(@)(@@) % أمعيني على بلوغ الأماني % % وشفائي من علتي واشتياقي % % 21(@)(@@) % وخليلي لما جفاني خليل % % صدحتي غصصته بفراق % % 23(@)(@@) % حين وافقت نيتي في التصافي % % ذقت مني الوفاء عذب المذاق % % 25(@)(@@) % أينعت بيننا المودة حتى % % جللتنا والدهر بالأوراق % 28(@)(@@) % وسوامي اللحاظ في الروع تلقا % % خارجا من ثيابه الأخلاق % % 29(@)(@@) % قم نبادر مرمى الزمان ببين % فسهام الخطوب في الأفواق % % 34(@)(@@) % كلما كرت الليالي علينا % % شق فيها الوفاء جيب الشقاق % % PageV01P1162 35(@)(@@) % في 
ms332	 جبين الزمان منك ومني % % غرة كوكبية الائتلاق % 36(@)(@@) % لا تزال الأيام تضدر منا % % عن إخاء لم نقذه بفراق % % PageV01P1163 البحر : متقارب تام 1(@)(@@) % لقاؤك جر علي الفراقا % % وما زادني القرب إلا اشتياقا % % 2(@)(@@) % جلوت علي هدي الوداد % فأسلفتها بالقبول الصداقا % % 3(@)(@@) % وأسرفت بالبشر حتى ظننت أنك أصجعت فيه النفاقا % % ت أنك أضجعت فيه النفاقا % % 4(@)(@@) % وحاشاك من تهمة في المغيب % % فكيف حضور يضم الرفاقا % % 5(@)(@@) % وكان الزعيم بهذا الإخا % % ء يوما حسوناه كأسا دهاقا % % 6(@)(@@) % نحرنا الدنان على صدره % فلله أي دماء أراقا % % 7(@)(@@) % شرقنا بلذاته والسرور % % يلوي إزارا ويرخي نطاقا % % 10(@)(@@) % يشقق والليل رطب الذيو % % غلائل تندى نسيما رقاقا % % 11(@)(@@) % سقى الله دهرا حبانا الوداد مبتدها فشكرنا العراقا % % د مبتدها ، فشكرنا العراقا % % 12(@)(@@) % وما زلت أعجب من حفظه % % لنا القرب حتى نسينا الفراقا % % PageV01P1164 13(@)(@@) % اتقتص من جسدي بالبعاد % % وما زود البلع منك العناقا % % PageV01P1165 البحر : طويل 1(@)(@@) % أبا حسن لي في الرجال فراسة % تعودت منها أن تقول فتصدقا % % 2(@)(@@) % وقد خبرتني عنك أنك ماجد % % سترقى من العلياء أبعد مرتقى % % 3(@)(@@) % فوفيتك التعظيم قبل أوانه % % وقلت أطال الله للسيد البقا % % 4(@)(@@) % وأضمرت منه لفظة لم أبح بها % % إلى أن أرى اطلاقها لي مطلقا % 5(@)(@@) % فإن عشت أو إن مت فاذكر بشارتي % % وأوجب بها حقا عليك محققا % % 6(@)(@@) % وكن لي في الأولاد والأهل حافظا % إذا ما اطمأن الجنب في موضع البقا % % PageV01P1166 البحر : طويل 1(@)(@@) % سننت لهذا الرمح غربا مذلقا % % وأجريت في ذا الهندواني رونقا % % 2(@)(@@) % وسومت ذا الطرف الجواد وإنما % % شرعت له نهجا فخب وأعنقا % % 3(@)(@@) % لئن برقت مني مخايل عارض % % لعينيك يقضي أن يجود ويغدقا % % 4(@)(@@) % فليس بساق قبل ربعك مربعا % وليس براق قبل جوك مرتقى % % 5(@)(@@) % وإن صدقت منه الليالي مخيلة % % تكن بجديد الماء أول من سقى % % 6(@)(@@) % ويغدو لمن يروي جنابك مرويا % زلالا وللأعداء دونك مصعقا % 7(@)(@@) % وإن تر ليثا لائذا لفريسة % % يراصد غرات المقادير مطرقا % % 8(@)(@@) % فما ذاك إلا أن يوفر طعمها % % عليك ، إذا جلى إليها وحققا % % 9(@)(@@) % وإن 
ms333	 يرق يوما في المعالي فإنه % % سما ليوقى وطء رجلك مزلقا % % 10(@)(@@) % وإن يسع في الأمر العظيم فإنما % % سعى لك في ذاك الطريق مطرقا % % PageV01P1167 11(@)(@@) % وإن يصب السهم الذي راش نصله % % فما كان إلا في هواك مفوقا % % 12(@)(@@) % وإن ينهض الغرس الذي هو غارس % يكن لك مجنى في الخطوب ومعلقا % % 13(@)(@@) % لتجنيه دون الناس ما كان مثمرا % وتلبس طلا منه ما كان مورقا % % 14(@)(@@) % فنم وادعا واستسقني فستنتضي % % حساما إذا ما مر بالعظم طبقا % % 15(@)(@@) % وجر ذيول العز أنى أجره % % لهاما إذا ما أظلم الليل أبرقا % % 16(@)(@@) % وجيشا جناحاه يزمان بالردى % % خفوقان ما نالا من الأرض مخفقا % % 17(@)(@@) % به كل طعان يلوث برأسه % % عنيق المذاكي ما يثير من النقا % % 18(@)(@@) % لدن غدوة حتى ترى الشمس ورسة % % كأن على الغيطان ثوبا مزبرقا % % 19(@)(@@) % وركب أغذوا بالركاب ، فنشفوا % % ثمائلها بالجوب غربا ومشرقا % % 20(@)(@@) % وكل معراة الضلوع كأنما % % أقاموا عليها جازرا متعرقا % % PageV01P1168 21(@)(@@) % فإن راشني دهري أكن لك بازيا % يسرك محصورا ويرضيك مطلقا % % 22(@)(@@) % أشاطرك العز الذي أستفيده % % بصفقة راض إن غنيت وأملقا % % 23(@)(@@) % فتذهب بالشطر الذي كله غنى % % وأذهب بالشطر الذي كله شقا % % 24(@)(@@) % وتأخذ منه ما أنام وما حلا % % وأخذ منه ما أمر وأرقا % % 25(@)(@@) % فغيري إما طار غادر صحبه % دوين المعالي واقعين وحلقا % % 26(@)(@@) % فإن تسلف التبجيل قبل أوانه % % أعضك به وجها من الود مونقا % % 27(@)(@@) % وإن تعطني الإعظام قولا فإنني % % سأعطيك فعلا منه أذكى وأعبقا % % 28(@)(@@) % لعل الليالي أن يبلغن منية % ويقرعن لي بابا من الحظ مغلقا % % 29(@)(@@) % نظار ولا تستبط عزمي فلن ترى % % علوقا ، إذا ما لم تجد متعلقا % % 30(@)(@@) % وليس ينال الأمر إلا بحازم % من القوم أحمى ميسما ثم ألصقا % % PageV01P1169 31(@)(@@) % فإن قعدت بي السن يوما فإنه % % سينهض بي مجدي إليها محققا % % 32(@)(@@) % فوالله لا كذبت ظنك إنه % % لعار إذا ما عاد ظنك مخفقا % 33(@)(@@) % فإن الذي ظن الظنون صوادقا % نظير الذي قوى الظنون وحققا % % PageV01P1170 البحر : رجز تام 1(@)(@@) % جاء بها قالصة عن ساق % روعاء من إرث أبي 
ms334	 الغيداق % % 2(@)(@@) % تحن والحنة للمشتاق % % ما أولع الحنين بالنياق % 3(@)(@@) % تمشي على نعل دم مراق % ليست بذي هلب ولا طراق % 4(@)(@@) % تذكري رمل النقا واشتياقي % % وبرد ماء ألعس وساقي % % 5(@)(@@) % ينزع من أثعوب جم باقي % % حمضها في قلص عتاق % % 6(@)(@@) % مناشط العشب على الملاق % % أشعث بادي جنجن التراقي % % 7(@)(@@) % كأنه في السمل الأخلاق % % من تيهه ذو التاج والأطواق % % 8(@)(@@) % نحارة للإبل المناقي % % فواقها أدنى من الفواق % 9(@)(@@) % أسفع إلا موضع النطاق % % ينزل حد الصارم الذلاق % 10(@)(@@) % منازل العقال والرباق % % موطن المنزل للرفاق % PageV01P1171 11(@)(@@) % مرت على الأقوار والبراق % مر جرور لعارض الشهاق % % 12(@)(@@) % طائرة بالقرب الخفاق % % منفلت الدلو من العراقي % % 13(@)(@@) % تحثو على نجد ثرى العراق % % كأنها بعض الهباب الباقي % % 14(@)(@@) % والليل أعمى شارق الرواق % % نذير قوم جد في اللحاق % % 15(@)(@@) % ينذر جيشا عجل الإرهاق % أقبل لا يحفل ما يلاقي % % PageV01P1172 البحر : رجز تام 1(@)(@@) % نبهت مني ، يا أبا الغيداق % أصم لا يسمع صوت الراقي % % 2(@)(@@) % صل صفا ملعن البصاق % % ريقته تهزأ بالدرياق % 3(@)(@@) % كأنه أم من الاطراق % % تلقى الرجال عنده الملاقي % % 4(@)(@@) % ينظر من عين بلا حملاق % إن نام لا يكلؤها بماق % % 5(@)(@@) % آثاره في القور والبراق % تستوقف الركب عن الإعناق % 6(@)(@@) % يشم منك موضع النطاق % بوخزة من ذرب حذاق % % 7(@)(@@) % يكتمه في هرت الأشداق % % ليك من حديدة الحلاق % 8(@)(@@) % ترى على اللبات والتراقي % % أهالة من سمه المراق % % 9(@)(@@) % مثل القذى لجلج في المآقي % % ينحب بالماضي جنان الباقي % % 10(@)(@@) % رزقك أدته يد الخلاق % % لكنه مر من الأرزاق % PageV01P1173 11(@)(@@) % قد حان ألا أن يقيه الواقي % % من ابتغى جهلا بما يلاقي % % 12(@)(@@) % تجربة السيف على الأعناق % ألم يعقك اليوم عني عاق % 13(@)(@@) % حتى لقيت أذني عناق % سوف أغني بك في الرفاق % 14(@)(@@) % حدوا كحدو البدن بالقياقي % % محملا غوارب النياق % % 15(@)(@@) % من لاذعات الكلم البواقي % % نهزا سيجليها إلى العراق % 16(@)(@@) % إني ارتقيت بعد ضعف الساق % % روابيا مزلقة المراقي % % 17(@)(@@) % أهدفت للإرعاد والإبراق % نصب مسيل العارض البعاق % % 18(@)(@@) % ترقع عرضا منك ذا انخراق % كما رفدت 
ms335	 النعل بالطراق % 19(@)(@@) % حذار من مذروبة ذلاق % % ترفع عنك جانب الرواق % % 20(@)(@@) % هواجما مقطوعة الرباق % حتى على الأذان والأحداق % % PageV01P1174 21(@)(@@) % تنتزع الأصول بالأعراق % % يلجا بها الحر إلى الإباق % 22(@)(@@) % أعقدها مواضع الأطواق % % لها على الأعناق وسم باق % 23(@)(@@) % مثل وسوم الإبل المناق % % نزيعة من جلب العراق % 24(@)(@@) % تقنى لغير الشم والعناق % تميطها ، وهي إلى التصاق % 25(@)(@@) % لا تقلع القوباء بالأرياق % % عجت لأعراضكم الأخلاق % 26(@)(@@) % أفلق في جماجم أفلاق % وأجهز اليوم على أرماق % 27(@)(@@) % لا تأمن النار على الأحراق % % هذا ونبلي لك في الإيفاق % 28(@)(@@) % فكيف بعد النزع والأغراق % % PageV01P1175 البحر : - 1(@)(@@) % ما لخيال الحبيب قد طرقا % % وما لهذا المحب قد قلقا % % 2(@)(@@) % سألت بإنسان عينه لجج % % ولو لم يكن سابحا لقد غرقا % % PageV01P1176 البحر : بسيط تام 1(@)(@@) % ضاعت ديونك عند الغيد أعناقا % % وما قضينك لما جئت مشتاقا % % 2(@)(@@) % تحملوا ، وعيون الحي ناظرة % وعاق طرفك يوم الجزع ما عاقا % % PageV01P1177 البحر : بسيط تام 1(@)(@@) % خلوا عليك مطال السفر وانطلقوا % % وأسلفوك سلوا قبل أن عشقوا % % 2(@)(@@) % لو ينصفوني الهوى ما كان عندهم % برد القلوب وعندي الشوق والأرق % % PageV01P1178 البحر : طويل 1(@)(@@) % وردنا بها بين العذيب وضارج % % تريكة جون أسأرتها البوارق % 2(@)(@@) % وقد ذعذع الليل النجوم لغورها % % كبيض الأداخي بعثرته النقانق % % PageV01P1179 البحر : مجزوء الخفيف 1(@)(@@) % دولة تطلب الفرا % % ر ، ومجد محلق % 2(@)(@@) % هو يأس مكذب % ورجاء مصدق % % 3(@)(@@) % قد بنيتم فشيدوا % % وغرستم ، فأورقوا % % PageV01P1180 البحر : مجزوء الكامل 1(@)(@@) % أترى نراح من الفراق % يوما ، ونأخذ في التلاقي % % 2(@)(@@) % فأغض من جزعي وامحو الدمع من بين المآقي % % حو الدمع من بين المآقي % % 3(@)(@@) % وأروح في ظفر القوى % % وقد انتصفت من الفراق % PageV01P1181 البحر : خفيف تام 1(@)(@@) % يا أراك الحمى تراني أراكا % % أي قلب جنى عليه جناكا % % 2(@)(@@) % أعطش الله كل فرع بنعمان من الماطر الروى وسقاكا % % الروى وسقاكا % % 3(@)(@@) % أي نور لناظري ، إذا ما % % مر يوم ، وناظري لا يراكا % % 9(@)(@@) % لم تدع فيك نائبات الليالي % % أثرا للهوى سوى مغناكا % % 10(@)(@@) % وأثاف كأنهن رذايا % % وأسارى لا ينظرون فكاكا % % 11(@)(@@) % وشجيج طم الزمان 
ms336	 نواصيه كما شعث الوليد السواكا % % ه ، كما شعث الوليد السواكا % % 12(@)(@@) % الذميل الذميل يا ركب أني % % لضمين أن لا يخيب سراكا % % 14(@)(@@) % جئيهم مخمس الركاب فنادوا % % جنب الورد لا نقعت صداكا % % 17(@)(@@) % ورأيت العدو حيث تراه % % ورآك العدو حيث يراكا % % 19(@)(@@) % زدت سبقا على أبيك ، وكانت % غاية المجد لو لحقت أباكا % % PageV01P1182 22(@)(@@) % من إذا غالنا الضلال رأينا % % ه قواما لديننا أو مساكا % % 26(@)(@@) % من طموح خطمته وجموح % % بك أعضضته الشكيم فلاكا % % 27(@)(@@) % لم تزل تطعن المولين حتى % % حسبت من قنا الظهور قناكا % % 28(@)(@@) % ورجال تحككوا ، فأفاقوا % % بجذيل قد عودوه الحكاكا % % 30(@)(@@) % ضربوا في جوانب الطود فانظر % حمق العاجزين كيف أحاكا % % 32(@)(@@) % طاح في حد مخلبيك وخست % أكلة الذئب أن تقارب فاكا % % 34(@)(@@) % طلب الأمر فانثنى بغرور % كان فوتا ، فخاله إدراكا % % 36(@)(@@) % كيف تقذى عين ويألم طرف % نظر اليوم وجهك الضحاكا % % 40(@)(@@) % كل يوم فضل علي جديد % % وعلاء أنا له من علاكا % % 41(@)(@@) % يا ديار الأحباب كيف تغير % كلما قيل قد بلغت مناكا % % PageV01P1183 42(@)(@@) % وإذا ما طويت عنك التقاضي % % عني الطول منك بي فاقتضاكا % % PageV01P1184 البحر : طويل 1(@)(@@) % لقد جثمت تعبيسة في المضاحك % تمد بأضباع الدموع السوافك % % 2(@)(@@) % فكفكف صدور السمهري بعزمة % على كل ملآن من الضغن فاتك % % 3(@)(@@) % إذا ما أضل النقع طرق سنانه % % تسرع من حجب الكلى في مسالك % % 4(@)(@@) % وليل مريض النجم من صحة الدجى % % خطته بنا أيدي الهجان الأوارك % 5(@)(@@) % بركب فروا برد الظلام وقلصوا % % حواشيه في أيدي القلاص الرواتك % % PageV01P1185 البحر : طويل 1(@)(@@) % يصافحه نشر الخزامى ، كأنما % % يمسح أعطاف الرماح السواهك % % 2(@)(@@) % فجاءت باسد الحديد ترقرقت % % عليها بماء الشمس غدر الترائك % 3(@)(@@) % بدت تزلق الأبصار في لمعانها % % على أنها في ثوب اقتم حالك % % 4(@)(@@) % تلف بأعراف الجياد رماحها % % وتنشر من أطمار بيض بواتك % % 5(@)(@@) % وتنكح أوتار الحنايا نبالها % % فتشرد عنها في نصال فوارك % % 6(@)(@@) % ألف بلألاء السماح فروجها % % تبيض أعجاس القسي العواتك % 7(@)(@@) % بيوم طراد قنع الشمس نقعه % تردوا بموار الدماء الصوائك % % 8(@)(@@) % ولا يألمون الطعن حتى كأنهم 
ms337	 % % أسروا ضلوعا من كعوب النيازك % PageV01P1186 البحر : طويل 1(@)(@@) % ولا يوم إلا أن ترامي رماحه % قلوب تميم في صدور المهالك % 2(@)(@@) % وقد شرت ذود العوالي أنامل % % ولكنها بين الطلى في مبارك % % 3(@)(@@) % تطل دماء من نحور أعزة % كحقن أفاويق الضروع الحواشك % 4(@)(@@) % الكني فتى فهر إلى البيض والقنا % % فإني قذاة في عيون المآلك % % 5(@)(@@) % ولي أمل من دون مبرك نضوه % يقلقل أثباج المطي البوارك % 6(@)(@@) % سقى الله ظمأن المنى كل عارض % % من الدم ملآن الملاطين حاشك % % 7(@)(@@) % يزمجر من وقع الصفيح على الطلى % % ويرعد من وقع القنا بالحوارك % % 8(@)(@@) % بطعن إذا بادت عواليه قومت % % من القوم منآد الضلوع الشوابك % PageV01P1187 البحر : بسيط تام 1(@)(@@) % دع الذميل إلى الغايات والرتكا % % ماذا الطلاب أترجو بعدها دركا % % 2(@)(@@) % ما لي أكلفها التهجير دائبة % % على الوجى وقوام الدين قد هلكا % % 3(@)(@@) % حل الغروض فلا دار ملائمة % % ولا مزور إذا لاقيته ضحكا % % 4(@)(@@) % أمسى يقوض عنا العز خلفه % % وثور المجد عنا بعد ما بركا % % 5(@)(@@) % اليوم صرحت الجلى ، وقد تركت % بين الرجاء وبين اليأس معتركا % % 6(@)(@@) % تمثل الخطب مظنونا لتالفه % فسوف نلقاه موجودا ومدركا % % 7(@)(@@) % رزيئة لم تدع شمسا ولا قمرا % ولا غماما ولا نجما ولا فلكا % % 8(@)(@@) % لو كان يقبل من مفقودها عوض % % لأنفق المجد فيها كلما ملكا % % 9(@)(@@) % قد أدهش الملك قبل اليوم من حذر % وإنما اليوم أذرى دمعه وبكى % % 10(@)(@@) % أمسى بها عاطلا من بعد حليته % وهادما من بناء المجد ما سمكا % % PageV01P1188 11(@)(@@) % من للجياد مراعيها شكائمها % % يحملن شوك القنا اللذاع والشككا % % 12(@)(@@) % يطا بها تحت أطراف القنا زلقا % % من الدماء ومن هام العدا نبكا % % 13(@)(@@) % من للظبى يختلي زرع الرقاب بها % % حكم القصاقص لا عقل لما سفكا % % 14(@)(@@) % من للقنا جعلت أيدي فوارسه % % من القلوب لها الأطواق والمسكا % % 15(@)(@@) % من للأسود نهاها عن مطاعمها % % فكم رددن فريسا بعد ما انتهكا % % 16(@)(@@) % من للعزائم والآراء يطلعها % % مطالع البيض يجلو ضؤها الحالكا % % 17(@)(@@) % من للرقاق إذا أشفت على عطب % % يغدو لها بلغا بالطول أو مسكا 
ms338	 % % 18(@)(@@) % من للخطوب ينجي من مخالبها % % وينزع الظفر منها كلما سدكا % % 19(@)(@@) % ومن معشر أخذوا الفضلى فما تركوا % % منها لمن يطلب العلياء متركا % % 20(@)(@@) % قدوا من البيض خلقا والحيما خلقا % عيصا ألف بعيص المجد فاشتبكا % % PageV01P1189 21(@)(@@) % لو أنهم طبعوا لم ترض أوجههم % % دراري الليل لو كانت لها سلكا % % 22(@)(@@) % هم أبدعوا المجد لا إن كان أولهم % % رأى من الجد فعلا قبله فحكى % % 23(@)(@@) % الراكبين ظهورا قلما ركبت % % والمالكين عنانا قلما ملكا % % 24(@)(@@) % هيهات لا ألبس الأعداء بعدهم % % يوم الجراء ، لجاما يقرع الحنكا % % 25(@)(@@) % ولا أريحت على العلياء حافلة % % لها سنام من الأجمام قد تمكا % % 26(@)(@@) % يا صفقة من بياع كلها غرر % من ضامن للعلى من بعدها الدركا % % 27(@)(@@) % خلالها كل ذئب مع أكيلته % من واقع طاروا من عاجز فتكا % % 28(@)(@@) % الموت أخبث من أن يرتضي أبدا % لا سوقة بدلا منه ولا ملكا % % 29(@)(@@) % كالعلق والعلق لو خيرت بينهما % % لم ترض بالدون يوما أن يكون لكا % % 30(@)(@@) % راق تفرد بالإحسان يفرعها % % وزايد النجم في العلياء واشتركا % % PageV01P1190 31(@)(@@) % اللين يمطيك من أخلاقه ذللا % والضيم يخرج منه الآبي المعكا % % 32(@)(@@) % غمر العطية لا يبقي على نشب % % وإن رأى قلبي الرأي محتنكا % % 33(@)(@@) % لا تتبعوا في المساعي غير أخمصه % % فأخصر الطرق في العلياء ما سلكا % % 34(@)(@@) % ما مثل قبرك يستسقى الغمام له % وكيف يسقي القطار النازل الفلكا % % 35(@)(@@) % لا يبعد الله أقواما رزئتهم % لو ثلموا من جنوب الطود لا أنهتكا % % 36(@)(@@) % فقدتهم مثل فقد العين ناظرها % % يبكي عليها بها يا طول ذاك بكا % % 37(@)(@@) % إذا رجا القلب أن ينسيه غصته % ما يحدث الدهر أدمى قرحه ونكا % % 38(@)(@@) % إن يأخذ الموت منا من نضن به % فما نبالي بمن بقى ومن تركا % % 39(@)(@@) % إني أرى القلب ينزو لأدكارهم % % نزو القطاطة مدوا فوقها الشركا % % 40(@)(@@) % لا تبصر الدهر بعد اليوم مبتسما % إن الليالي أنست بعده الضحكا % % PageV01P1191 البحر : بسيط تام 1(@)(@@) % يا ظبية البان ترعى في خمائله % % ليهنك اليوم أن القلب مرعاك % % 2(@)(@@) % الماء عندك مبذول لشاربه % % وليس 
ms339	 يرويك الأمد معي الباكي % % 3(@)(@@) % هبت لنا من رياح الغور رائحة % % بعد الرقاد عرفناها برياك % % 4(@)(@@) % انثنينا إذا ما هزنا طرب % % على الرحال تعللنا بذكراك % % 5(@)(@@) % سهم أصاب وراميه بذي سلم % % من بالعراق ، لقد أبعدت مرماك % 6(@)(@@) % وعد لعينيك عندي ما وفيت به % يا قرب ما كذبت عيني عيناك % 7(@)(@@) % حكت لحاظك ما في الريم من ملح % يوم اللقاء فكان الفضل للحاكي % % 8(@)(@@) % كأن طرفك يوم الجزع يخبرنا % % بما طوى عنك من أسماء قتلاك % % 9(@)(@@) % أنت النعيم لقلبي والعذاب له % فما أمرك في قلبي وأحلاك % 10(@)(@@) % عندي رسائل شوق لست أذكرها % % لولا الرقيب لقد بلغتها فاك % % PageV01P1192 11(@)(@@) % سقى منى وليالي الخيف ما شربت % % من الغمام وحياها وحياك % 12(@)(@@) % إذ يلتقي كل ذي دين وماطله % منا ويجتمع المشكو والشاكي % % 13(@)(@@) % لما غدا السرب يعطو بين أرحلنا % % ما كان فيه غريم القلب إلاك % 14(@)(@@) % هامت بك العين لم تتبع سواك هوى % % من علم البين أن القلب يهواك % 15(@)(@@) % حتى دنا السرب ، ما أحييت من كمد % قتلى هواك ولا فاديت أسراك % % 16(@)(@@) % يا حبذا نفحة مرت بفيك لنا % % ونطفة غمست فيها ثناياك % % 17(@)(@@) % وحبذا وقفة ، والركب مغتفل % على ثرى وخدت فيه مطاياك % 18(@)(@@) % لو كانت اللمة السوداء من عددي % % يوم الغميم لما أفلت إشراكي % % PageV01P1193 البحر : كامل تام 1(@)(@@) % يا قلب ليتك حين لم تدع الهوى % % علقت من يهواك مثل هواكا % % 2(@)(@@) % لو كان حر الوجد يعقب بعده % برد الوصال غفرت ذاك لذاكا % % 3(@)(@@) % لا بل شجيت بمن يبيت مسلما % خالي الضلوع ولا يحس شجاكا % % 4(@)(@@) % إن يصبحوا صاحين من خمر الهوى % % فلقد سقوك من الغرام دراكا % % 5(@)(@@) % يا ليت شغلك بالأسى أعداهم % % أولا فليت فراغهم أعداكا % % 6(@)(@@) % أهوى وذلا في الهوى وطماعة % % أبدا ، تعالى الله ما أشقاكا % % 7(@)(@@) % يا قلب كيف علقت في أشراكهم % % ولقد عهدتك تفلت الإشراكا % % 8(@)(@@) % أكثبت حتى أقصدتك سهامهم % قد كنت عن أمثالها إنهاكا % % 9(@)(@@) % إن ذبت من كمد ، فقد جر الهوى % % هذا السقام علي من مجركا % % 10(@)(@@) % لا 
ms340	 تشكون إلي وجدا بعدها % % هذا الذي جرت علي يداكا % % PageV01P1194 11(@)(@@) % لأعاقبنك بالغليل ، فإنني % % لولاك لم أذق الهوى لولاكا % % 12(@)(@@) % يا عاذل المشتاق دعه فإنه % % يطوي على الزفرات غير حشاكا % % 13(@)(@@) % لو كان قلبك قلبه ما لمته % % حاشاكا مما عنده حاشاك % % PageV01P1195 البحر : بسيط تام 1(@)(@@) % أما تحرك للأقدار نابضة % % أما يغير سلطان ولا ملك % % 2(@)(@@) % قد هادن الدهر حتى لأقراع له % % وأطرق الخطب حتى ما به حرك % % 3(@)(@@) % كل يفوت الرزايا أن يقعن به % أما لأيدي المنايا فيهم درك ؟ % 4(@)(@@) % قد قصر الدهر عجزا عن لحاقهم % % فأين أين ذميل الدهر والرتك % 5(@)(@@) % أخلت السبعة العليا طرايقها % % أم أخطأت نهجها أم سمر الفلك ؟ % PageV01P1196 البحر : طويل 1(@)(@@) % أفي كل يوم أنت رام بهمة % % إلى حيث لا ترمي النجوم الشوابك % % 2(@)(@@) % وما كل ما منيت نفسك خاليا % تنال ولا تفضي إليه المسالك % % 3(@)(@@) % يقولون رم تلق الذي أنت طالب % فأين العواقي دونها والمهالك % 4(@)(@@) % وكم سعي ساع جر حتفا لنفسه % ولولا الخطى ما شاك ذا الرجل شائك % % 5(@)(@@) % ألا ربما حياك رزقك طالعا % ورحلك محطوط ونضوك بارك % % PageV01P1197 البحر : - 1(@)(@@) % ورب غاو منطقه % % بسكتة ، والحلوم تعترك % 2(@)(@@) % وللفتى من وقاره جنن % إن كثرت من عدو الشكك % 3(@)(@@) % ثار به الجهل فابتسمت له % % ورب جان عقابه الضحك % PageV01P1198 البحر : طويل 1(@)(@@) % أيا راكبا ترمي به الليل جسرة % لها نمرق من نيها ووراك % 2(@)(@@) % قراها ربيع الواديين وأتمكت % % قراها عهاد باللوى وركاك % % 3(@)(@@) % لها هاديا عين وأذن سميعة % إذا غار أو غر العيون سماك % % 4(@)(@@) % تحمل ألوكا ربما حملت به % % رذايا المطايا ، مشيهن سواك % 5(@)(@@) % وأبلغ عماد الدين أما بلغته % % بأن سلاح اللوم عندي شاك % 6(@)(@@) % أفي الرأي أن تسترعي الذئب ثلة % وغوثك بطء والخطوب وشاك ؟ % 7(@)(@@) % أردت وقاء الرجل والنعل عقرب % مراصدة ، والأفعوان شراك % 8(@)(@@) % وكان أبوك القرم هادم عرشه % % فلم أنت أعماد له وسماك % 9(@)(@@) % يكون سماما للمعادين ناقعا % وأنت لأرماق العداة مساك % % 10(@)(@@) % ألا فاحذروها ، أول السيل دفعة % ورب ضئيل عاد وهو ضناك % % PageV01P1199 11(@)(@@) % نذار 