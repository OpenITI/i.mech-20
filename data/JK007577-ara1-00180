ms161	 محتزم بالحزم منتطق % % 34(@)(@@) % آثارهم في سماء الملك لائحة % % تهدي وذكرهم مسك لمنتشق % % 35(@)(@@) % وحل من الأنصار منتسبا % % في معشر صبر عند الوغى صدق % % 36(@)(@@) % حزب النبي الألى إن روعة دهمت % % ملء الفضا لم تهن ذرعا ولم تضق % % 37(@)(@@) % يا قائد الخيل تردي في أعنتها % % هزلى الأباطن والأنساء والصفق % % 38(@)(@@) % من كل أحمر وردي تنازعه % % ظباء وجرة في الألوان والخلق % % 39(@)(@@) % وأشهب في سماء النقع مخترق % % كأنه قاذف يهوي لمسترق % % 40(@)(@@) % وأدهم اللون إن أبداك غرته % % تخال زنجية تفتر عن يقق % % PageV01P640 41(@)(@@) % كأنه وهو بالظلماء مشتمل % % خاضت قوائمه نهرا من الفلق % % 42(@)(@@) % وأبلق شغفت حور العيون به % % كأنما عطفتها نسبة الحدق % % 43(@)(@@) % تشارك الليل في أحكام صنعته % % واليوم واتفقا فيه على البلق % % 44(@)(@@) % أنت الذي خاصمت فيك السيوف إلى % % أن خلص الحق رهن الملك من غلق % % 45(@)(@@) % وأنت أمنت حقا ثغر أندلس % % وقلب ساكنها يرتج من خفق % % 46(@)(@@) % قد عاودت دولة الإسلام جدتها % % والكفر مشتمل بالواهق الخلق % % 47(@)(@@) % فأقلق البيض واهزز كل غالبة % % فالدين في مرح والكفر في وهق % % 48(@)(@@) % حتى إذا الروم رامت فرصة ونزا % % يوما منافقها الأشقى عن النفق % % 49(@)(@@) % فاهزز بوعبك قبل الجيش ما جمعوا % % واضرب بسعدك قبل الصارم الذلق % % 50(@)(@@) % واستقبل الفتح والنصر الذي نطقت % % آثاره بصحيح غير مختلق % % PageV01P641 51(@)(@@) % وإن شكت مرهفات الهند من ظمأ % % فسقها عللا صرفا من العلق % % 52(@)(@@) % وإن هم جنحوا للسلم واعتلقوا % % منها بمستحتكم الأسباب والعلق % % 53(@)(@@) % فاجنح لها بكتاب الله مقتديا % % إذ ذاك واستبق فلا من ظباك بق % % 54(@)(@@) % واهنأ بقابل أعياد مواسمها % % منظومة ككعوب الرمح في نسق % % 55(@)(@@) % في ظل مملكة من دون ساحتها % % ردء من الله يحمي حوزها ويق % % 56(@)(@@) % مولاي دونكها عقدا فرائده % % تزهى بمنتظم الإبداع متسق % % 57(@)(@@) % يودها الدوح في أغصانه زهرا % % غضا وتحسدها دارين في العبق % % 58(@)(@@) % تزري بطيب أواليها أواخرها % % كذلك السبق يبدو آخر الطلق % % 59(@)(@@) % لو جئت في حلبة العرب التي سبقت % % ما كنت في القوم إلا حائز السبق % % 60(@)(@@) % وإن تأخر بي 
ms162	 عن جيلهم زمني % % فربما جاء معنى الصفح في اللحق % % PageV01P642 61(@)(@@) % والعقل كالبحر إن هالتك هيبته % % فالشعر يسبر منه منتهى العمق % % 62(@)(@@) % فإن وفيت بحق المدح فهو جنى % % روض بإنعامك السيح العمام سق % % 63(@)(@@) % وإن عجزت فعن عذر وثقت به % % من رام عد الحصى والقطر لم يطق % % 64(@)(@@) % وإن وفيت ببعض القصد ريتما % % يكفي من العقد ما قد حف بالعنق % % PageV01P643 البحر : طويل 1(@)(@@) % نديمي عللني بمشمولة واسق % % ولا تولجن سمعي حديثا عن العشق % % 2(@)(@@) % فقد ضاق ميدان الشباب عن الهوى % % فآثرت النفس الرجوع إلى الحق % % 3(@)(@@) % وهذا زمان الزهو حيالك باسما % % تلوح سمات البشر في وجهه الطلق % % 4(@)(@@) % وقد قاد يوم الغيم سحبا كأنها % % رقاق أتت تمشي الهوينا على رفق % % 5(@)(@@) % كأن حداة الرعد ظلت طريقها % % فهزت لكيما تهتدي مشعل البرق % % 6(@)(@@) % وكعبة روض زارها القطر والتقت % % بميقاتها جوابة الغرب والشرق % % 7(@)(@@) % وقد قلب السوسان فيها رداءه % % كأن النعامى أبرزته ليستسق % % 8(@)(@@) % كأن عليل النرجس اهتاج داؤه % % وقد قعدت تبكيه ساجعة الورق % % 9(@)(@@) % وقد أشفق الغيم الظليل بمائه % % فتنفث فيه سحبه والصبا ترقي % % 10(@)(@@) % حللت بها والورد هدي مقرب % % فتوبت في رضابها بانة الزق % % PageV01P644 11(@)(@@) % وسيلتها حمراء والغيم عاكف % % فضاء لها جوي وضاع بها أفق % % 12(@)(@@) % وقد هرمت مما تطاول عمرها % % ومما محت أعضاءها حمية الدق % % 13(@)(@@) % وحييت أكواسي بها فكأنها % % جسوم تشف الروح في بدأة الخلق % % 14(@)(@@) % تخال بها الإبريق عند سجوده % % إماما يطيل المكث في أحرف الحلق % % 15(@)(@@) % يرددها كي يكسب الطبع دربة % % بهن ولكن ليس يفصح في النطق % % 16(@)(@@) % وعود حنا أضلاعه فوق كافىء % % يفوه بما بوحي البيان وما يلقي % % 17(@)(@@) % ويعرب عما في الضمير كأننا % % قصدنا سطيحا أو جلسنا إلى شق % % 18(@)(@@) % عكفنا عليه والبروق كأنها % % مطهمة شقر تبارت إلى السبق % % 19(@)(@@) % وقد شاب فود الليل من روعة الضيا % % وطارت قلوب النجم من شدة الخفق % % 20(@)(@@) % إذا ما الليالي أنهجت بردة الصبا % % وسدت إلى اللذات سالكة الطرق % % PageV01P645 21(@)(@@) % تعلل بنزر من زمان مساعد % % فمالك إن ولى سبيل 
ms163	 إلى اللحق % % PageV01P646 البحر : طويل 1(@)(@@) % أمحي رسوم الأنس إن شئت أن تبقي % % ذمائي فوف من ودادكم حقي % % 2(@)(@@) % فليس أخو الترجيح تحسبه أخا % % إذا لم يكن عونا على العدل والرفق % % 3(@)(@@) % عكوفا على اللذات من قبل فوتها % % حريصا على الإرشاد في منهج الحق % % 4(@)(@@) % فخذ منهم أوفى وأصدق لهجة % % فليس أخو التمويه مثل أخي الصدق % % 5(@)(@@) % فكم ليلة بتنا نعاطي وداده % % ألذ من العتبى وأشهى من العشق % % 6(@)(@@) % إذا طارق منهم تأنس للقرى % % نحرت له دني ووسدته زق % % 7(@)(@@) % وقلت لساقينا أدرها سلافة % % على صرخة المزمار أو نغمة الورق % % 8(@)(@@) % فقام بها تحذو أشعة خده % % فما قدر الحذاق فيها على الفرق % % 9(@)(@@) % رقيق حواشي الأنس حين ظهوره % % أبيح له مالي ومكن من رق % % 10(@)(@@) % إذا رمت منه ساقيا ومحدثا % % فمن ثغره يلقي ومن لحظه يسقي % % PageV01P647 11(@)(@@) % من الجانب الغربي أطلع كأسه % % كما طلع المريخ من جانب الشرق % % 12(@)(@@) % سلاف إذا لاحت لمحلولك الدجى % % تعهدت لها الطراق في سبل الطرق % % 13(@)(@@) % بذلنا لها أثمانها قبل ذوقها % % لأن شميم المسك أغنى عن الذوق % % 14(@)(@@) % توالت لها الأحقاب في أرض بابل % % فجاءت بنقض الجسم كاملة الخلق % % 15(@)(@@) % إذا ما أتتها نوبة بعد نوبة % % تعذبت فيها الروح من خشية الدق % % 16(@)(@@) % فخذها على وشي البطاح مبادرا % % لعطف من الدنيا ورغد من الرزق % % 17(@)(@@) % كأن رداء الروض من رقم صانع % % لطيف التهدي في الصناعة والحذق % % 18(@)(@@) % يلين إلى قحط الهجير بنانه % % فتسأله النوار عن زابر الودق % % 19(@)(@@) % فما لبست يوما خليق ثيابها % % وما غضت الأجفان إلا لتستسق % % 20(@)(@@) % تسوق النعامى كل ما ينعش القوى % % بفضل مزاج في لطيف من الصدق % % PageV01P648 21(@)(@@) % إذا ما سرى الوسمي في شبح الثرى % % تمخضت الأكوان مفتوقة الرتق % % 22(@)(@@) % فيصنع من ميت التراب عجائبا % % كما صنع الإكسير من حجر الطلق % % 23(@)(@@) % أليس على الأزهار للشمس سطوة % % فتخشى من الأنوار حتى من البرق % % 24(@)(@@) % إذا نفس الإصباح جن جنونها % % فريح الصبا تذكي وورقاؤها ترقي % % 25(@)(@@) % تشققت الأزهار عن جامد الثرى % % كذا جامد 
ms164	 الألفاظ أصل لمشتق % % 26(@)(@@) % وصامتة القلبين تحسب عودها % % مشوقا إذا غنى يذوب من الشوق % % 27(@)(@@) % له قطع مخروط وجيد غزالة % % ومنقار طاووس وجفنة مستسق % % 28(@)(@@) % وقد ولفت أجزاؤه فتحكمت % % على نسبة ترضي بواسطة الربق % % 29(@)(@@) % وقد مدت الأوتار فيه لحكمة % % فجاء بديع الخلق مستحسن النطق % % 30(@)(@@) % إذا جست الغيداء أوسط جيده % % سمعت الذي تبدي كمثل الذي تلق % % PageV01P649 31(@)(@@) % فتحسب فيه من سليمان زاجلا % % يترجم منه عن سطيح وعن شق % % 32(@)(@@) % يجيب خرير الماء نغمة عودها % % بما جاء للقمري منه على وفق % % 33(@)(@@) % كأن غدير النهر في الدوح دارع % % على تعب منه إلى الظل مستلق % % 34(@)(@@) % إذا رفعت عنه الظلال رواقها % % تعد بها النينان في الطول والعمق % % 35(@)(@@) % كأن نجوم الليل والليل راحل % % قلوب هفت يوم الفراق من الخفق % % 36(@)(@@) % وتحسب خيط الفجر مرود فضة % % يجول من الآفاق في حدق زرق % % 37(@)(@@) % فسابق إلى اللذات تحظ بحوزها % % فقد وقفوا حوز الرهان على السبق % % PageV01P650 البحر : كامل تام 1(@)(@@) % يا صانعي لله ما أحكمته % % فلأنت بين الصانعين رئيس % % 2(@)(@@) % أحكمت تاجي يوم صغت رقوشه % % فصبت إليه مفارق ورؤوس % % 3(@)(@@) % وأقمت من محرابه فكأنه % % مجلى إناء الماء فيه غروس % % PageV01P651 البحر : سريع 1(@)(@@) % يا سيدي أفديك بالنفس % % فككت ما عميت بالأمس % % 2(@)(@@) % ولم يكن شأني ولكنني % % صرفت فيه قوة الحدس % % 3(@)(@@) % ونلت منه شرفا خالدا % % يأبى دروس المرء في الرمس % % 4(@)(@@) % ولم أجد عندي جزاء له % % سواي فأملكني بلا فلس % % PageV01P652 البحر : سريع 1(@)(@@) % لو أنني فيك بذلت الذنا % % حسبتها كالثمن البخس % % 2(@)(@@) % يا قرة العين وقيت الردى % % من أعين الجنة والإنس % % 3(@)(@@) % لله ذهن منك مهما سرى % % في مشكل لم يبق من لبس % % 4(@)(@@) % شريعة الآداب لما أتت % % قامت على أنملك الخمس % % 5(@)(@@) % وليس بدعا ما تحليته % % لا ينكر النور على الشمس % % PageV01P653 البحر : طويل 1(@)(@@) % ووجه غرست البذر فيه بنظرة % % فياليت كفي متعت بجنى غرس % % 2(@)(@@) % كأن احمرار الخد تحت عذاره % % علامة مولانا على أحمر الطرس % % 3(@)(@@) % وبينهما في صحة الأمر نسبة % % لذلك أمضيت الغرام 
ms165	 على نفس % % PageV01P654 البحر : طويل 1(@)(@@) % ودير أنخنا في قراراته العيسا % % بحلة رهبان إلاههم عيسا % % 2(@)(@@) % عكوف على التمثال يستلمونه % % ويعنون بالإنجيل حفظا وتدريسا % % 3(@)(@@) % زعقنا بهم بعد العشي فهيمنون % % كأنا ذعرنا غابة منه أو خيسا % % 4(@)(@@) % وقلنا بنو سبل جوانح للقرى % % فقال زعيم القوم رحبا وتأنيسا % % 5(@)(@@) % فقلنا هواء الشام غال نفوسنا % % فهل لك في شيء ينفس تنفيسا % % 6(@)(@@) % فقال أخمر وهي شيء محرم % % عليكم لبئس المسلمون إذا بئسا % % 7(@)(@@) % فقلت دع الإنكار إنا عصابة % % يطيعون فيما تشتهي النفس إبليسا % % 8(@)(@@) % فقام يجر المسح ثم أتى بها % % فأبصرت كيوانا تناول برحبيسا % % 9(@)(@@) % وصارفته فيها لجينا بعسجد % % فناولني كأسا وناولته كيسا % % 10(@)(@@) % فلله من عيش نعمنا بلهوه % % حمدنا به منا مقيلا وتعريسا % % PageV01P655 البحر : طويل 1(@)(@@) % طرقنا ديور القوم وهنا وتليسا % % وقد قدسوا الروح المقدس تقديسا % % 2(@)(@@) % وقد رفعوا الإنجيل فوق رؤوسهم % % وقد قدسوا الروح المقدس تقديسا % % 3(@)(@@) % فما استيقظوا إلا لصكة بابهم % % فأدهش رهبانا وخوف قسيسا % % 4(@)(@@) % وقام لنا البطريق يسعى ملبيا % % وقد لين الناقوس رفقا وتأنيسا % % 5(@)(@@) % فقلنا له أمنا فإنا عصابة % % أتينا لتثليث وإن شئت تسديسا % % 6(@)(@@) % وما قصدنا إلا الكؤوس وإنما % % لحنا له في القول خبثا وتدليسا % % 7(@)(@@) % ففتحت الأبواب بالرحب منهم % % وعرس طلاب المدامة تعريسا % % 8(@)(@@) % فلما رأى زقي أمامي ومزهري % % فقال أتأنيسا لحنت وتلبيسا % % 9(@)(@@) % فقام إلى دن ففض ختامه % % فكبس أجرام الغياهب تكبيسا % % 10(@)(@@) % سلافا حواها القار لبسا فخلته % % مثالا من الياقوت في الحبر مغموسا % % PageV01P656 11(@)(@@) % وطاف بها رطب البنان مزنر % % فأبصرت عبدا صير الحر مرؤوسا % % 12(@)(@@) % إلى أن سطا بالقوم سلطان نومهم % % ورأس فتيل الشمع نكس تنكيسا % % 13(@)(@@) % وثبت إليه للعناق فقال لي % % بحق الهوى هب لي من الضم تنفيسا % % 14(@)(@@) % كتبت بدمع العين صفحة خده % % فطلس حبر الشعر كتبي تطليسا % % 15(@)(@@) % فبئس الذي احتلنا وكدنا عليهم % % وبئس الذي قد أضمر واقبل ذا بيسا % % 16(@)(@@) % فبتنا يرانا الله شر عصابة % % تطيع بعصيان الشريعة إبليسا % % PageV01P657 البحر : رجز تام 1(@)(@@) % يا واحد العليا بلا إلباس % % ابعث 
ms166	 بسهم من أبي العباس % % 2(@)(@@) % واعلم بأني لا أقلد مذهب أبي % % سفيان يوما خيفة الوسواس % % 3(@)(@@) % ولجد من شرح الكتاب تحيزي % % هذا إذا اختلف انتماء الناس % % 4(@)(@@) % فابعث به طيا بكل خفية % % كالطيف في جنح الظلام الغاس % % 5(@)(@@) % كي لا ينازع فيه غير مقصر % % جاري أبو عبد الله الفاسي % % 6(@)(@@) % ومن العجائب أن أكون وإنني % % إن قست أمرا صح فيه قياسي % % 7(@)(@@) % حالفت معتاد الرماة لفعلتي % % فبعثت نحو السهم بالقرطاس % % PageV01P658 البحر : طويل 1(@)(@@) % وعصبة شر من يهود لقيتها % % يجانبها داعي الهدى ويحاشيها % % 2(@)(@@) % إذا أمنوا واستوثقوا الباب أعلنوا % % خبائث ما كان اللسان ليفشيها % % 3(@)(@@) % كأن رؤوس القوم عند صلاتهم % % وقد أومأت للأرض صفر شواشيها % % 4(@)(@@) % أقاح أمالتها الرياح على الثرى % % وقد أسقطت عنها بياض حواشيها % % PageV01P659 البحر : رمل تام 1(@)(@@) % يا هلالا يا قضيبا يا رشا % % إن تبدى أو تثنى أو مشا % % 2(@)(@@) % يا غزالا ورده في أدمعي % % كلما شاء ومرعاه الحشا % % 3(@)(@@) % قد فشا فيك هيامي في الورى % % وهو لولا دمع عيني ما فشا % % 4(@)(@@) % ولكم آثرت كتمان الهوى % % غير أن الدمع بالسر وشا % % 5(@)(@@) % كيف بالكتمان يوما لامرىء % % سره في خده قد نقشا % % 6(@)(@@) % أو بسلوان لمن في رية % % جمسه والقلب في وادي الأشا % % 7(@)(@@) % خذ فؤادي لك مني هبة % % حرة وافعل بقلبي ما تشا % % 8(@)(@@) % بعت فيك النوم بالسهد فلا % % فرق عندي بين صبح وعشا % % 9(@)(@@) % كم ليال بت في ظلمائها % % أمتطي من نار شوقي فرشا % % 10(@)(@@) % كلما صحت بها واكبدي % % مادت الأرض لما بي دهشا % % PageV01P660 11(@)(@@) % وكأن النجم شرب ثمل % % واصل الثملة حتى ارتعشا % % 12(@)(@@) % وكأن الصبح في الليل وقد % % ملأ الأرجاء مما جيشا % % 13(@)(@@) % ثائر راقب منه فرصة % % ثم لما أمكنته بطشا % % 14(@)(@@) % وتخال الأفق ثغرا قاصيا % % غلب الروم عليه الحبشا % % 15(@)(@@) % ملئت من جوهر الدمع يدي % % عجبا أقبل في قلبي الرشا % % 16(@)(@@) % وجرى من ماء عيني نهر % % حين أرسلت دموعي مجهشا % % 17(@)(@@) % فاعجبوا من جوهر لا يقتنى % % ولنهر ليس يروي عطشا % % 18(@)(@@) % يا نديمي فؤادي 
ms167	 كلما % % نفحت ريح النعامى انتعشا % % 19(@)(@@) % آنسا قلبي بتذكار الحمى % % فالحمى من أهله قد أوحشا % % 20(@)(@@) % صاع يوم البين قلبي فانجثى % % بين أخفاف المطايا وانبشا % % PageV01P661 21(@)(@@) % وامزجاها قهوة عطرية % % كرمت كرما وطابت عرشا % % 22(@)(@@) % فإذا أبصرها ذو قرة % % ظنها بالبعد نارا فعشا % % 23(@)(@@) % وإذا قبلها شاربها % % قطب الوجه لها وانكمشا % % 24(@)(@@) % فسلا الساقي الذي أترعها % % حببا أودعها أوحنشا % % PageV01P662 البحر : رمل تام 1(@)(@@) % يا حبيبا من لعيني أن تراه % % قد رمى حبك قلبي وبراه % % 2(@)(@@) % لم يدع هجرك لي من رمق % % آه مما فعل البين وآه % % 3(@)(@@) % ودعاني نجوة داعي الهوى % % فاستجاب القلب مني إذ دعاه % % 4(@)(@@) % يا لقلبي كلما هبت صبا % % شفه الوجد لأيام صباه % % 5(@)(@@) % من عذيري من غريم باللوى % % ماطل ألوى بديني ولواه % % 6(@)(@@) % إن يكن لم يرع عهدي في الهوى % % فوقاه الله ربي ورعاه % % 7(@)(@@) % يا نسيم الريح بلغ خبري % % إن أتيت الربع أو جئت حماه % % 8(@)(@@) % واقر أحبابي سلامي بعد أن % % تبدأ الربع بتقبيل ثراه % % 9(@)(@@) % قد جفاني النوم من بعدهم % % من رسول بين جفني وكراه % % 10(@)(@@) % ولقد كنت صبورا إنما % % صدع البين فؤادي وكواه % % PageV01P663 11(@)(@@) % جل ما ألقاه من فرط الجوى % % حسبي الله فلا رب سواه % % PageV01P664 البحر : بسيط تام 1(@)(@@) % أبا العلاء تلقاك الزمان بما % % تهوى وأجنت لك الدنيا مجانيها % % 2(@)(@@) % وأسعد الله بيتا أنت عامره % % وشيد العز عليا أنت بانيها % % 3(@)(@@) % هديتي لك ود لو بعثت به % % لم يستطع حمله الدنيا ومن فيها % % 4(@)(@@) % وقدرة الوقت إن فكرت تقصر عن % % نفسي وتقصر نفسي عن أمانيها % % 5(@)(@@) % وقد بعثت بنزر النزر محتقر % % إن الهدايا على قدر مهديها % % 6(@)(@@) % فانظر بعين الرضا والسمع لا نظرت % % عين العدو لمرأى فيك يرضيها % % PageV01P665 البحر : طويل 1(@)(@@) % دعوتك للود الذي جنباته % % تداعت مبانيها وهمت بأن تهي % % 2(@)(@@) % وقلت لعهد الوصل والقرب بعدما % % تناءى أأسلو عن حياتي وأنتهي % % 3(@)(@@) % ومن شام من جو الشبيبة بارقا % % ولم تنهه عنه النهى كيف ينتهي % % PageV01P666 البحر : بسيط تام 1(@)(@@) % عهد الشباب سقى أيامك الأولا % % سح 
ms168	 من الدمع إن شح الحيا هطلا % % 2(@)(@@) % وإن حبا الله حياها من يأت حيا % % يوما وأسعف طالبا بما سألا % % 3(@)(@@) % فجاد حيك منها غير مفسده % % مجلجل يطأ الأوهاد والقللا % % 4(@)(@@) % يغادر الدوح من بعد الذوى خظلا % % يختال في حلل موشية وحلا % % 5(@)(@@) % فكم لنا فيه إذ عهد الهوى كثب % % وإذ خضاب شباب الفود ما نصلا % % 6(@)(@@) % من عهد أنس تفيأت السرور لدى % % روضاته وجنيت اللهو والغزلا % % 7(@)(@@) % ومن شموس وأقمار إذا طلعت % % كانت مشارقها الأستار والكللا % % 8(@)(@@) % فاليوم لا وصل إلا أن نرى لهم % % نهدي تحيتنا الأسحار والأصلا % % 9(@)(@@) % يا لائمي وقد لج الغرام ذرا % % لومي وإن كنتما في مرية فسلا % % 10(@)(@@) % قد أنب اللوم قلبي في تقلبه % % حولا وراود يثي مربعا كملا % % PageV01P667 11(@)(@@) % لا الجفن مني على شحط المزار جفا % % دمعي ولا القلب من بعد البعاد سلا % % 12(@)(@@) % كم لذت بالدهر أن يدني النوى فأبى % % وبالتعلل أن يجدي فما فعلا % % 13(@)(@@) % وليس تروي غليلا أو تعل صدى % % ظماء عزمك ما أودت هل أهلا % % 14(@)(@@) % وفتية نحرت نحر الفلاة ضحى % % بالعزم واتخذت ظهر الدجى جملا % % 15(@)(@@) % أنضاء أفيح إن ظلوا وإن ظمئوا % % شاموا الندى واستبدلوا البيض والأملا % % 16(@)(@@) % غالت سوائمها شهب السنين فما % % أبقت مراسا ولا حولا ولا مللا % % 17(@)(@@) % تبغي الندى وحيث لج الجود مورده % % عذب وتنتجع الأملاك والدولا % % 18(@)(@@) % أجلت قدح سفاري في ركابهم % % ففاز قداحي فيما رمته وعلا % % 19(@)(@@) % حتى أنخنا المطايا في حمى ملك % % عن منهج العدل والإحسان ما عدلا % % 20(@)(@@) % لله يوسف في الأملاك إن وردت % % عنه العفاة جنابا للندى خضلا % % PageV01P668 21(@)(@@) % كانت مواهبه قبل اللقاء لهم % % نهبا وكانت لهم جناته نزلا % % 22(@)(@@) % جزل العطاء لو أن البحر نائله % % لقل في جوده الفياض ما بذلا % % 23(@)(@@) % آراؤه شهب تهدي وسيرته % % ما إن ترى عوجا فيها ولا خللا % % 24(@)(@@) % من دوحة الأزد حيث الحي من يمن % % بشط غسان من بعد السرى نزلا % % 25(@)(@@) % ثم استراد جناب الله خزرجه % % حتى أحل بأعلى يثرب الحللا % % 26(@)(@@) % من كل 
ms169	 أروع تبدو في أسرته % % سمات يعرب تأبى الشوب والدخلا % % 27(@)(@@) % مطعام مسغبة إن ضن صوب حيا % % مطعان هيجاء لا جبنا ولا بخلا % % 28(@)(@@) % يأبى الموارد أن تؤتى مشارعها % % حتى إذا أرسلت رعيانها الرسلا % % 29(@)(@@) % ترى الملوك وقوفا دون مورده % % لا يوردون به إلا إذا نهلا % % 30(@)(@@) % حتى إذا أنزل الله الكتاب بما % % أنار أبصار أرباب النهى وجلا % % PageV01P669 31(@)(@@) % أوت نبي الهدى لما استجار بها % % والناس في فترة قد كذبوا الرسلا % % 32(@)(@@) % وجالدت دونه الأحزاب جاهدة % % وجدلت بظبا برهانه الجدلا % % 33(@)(@@) % فأصبحت في نواديها أدلته % % تعلو وملته قد هاضت المللا % % 34(@)(@@) % يا ناصر الدين لما قل ناصره % % ومطلع الجود والإحسان قد أفلا % % 35(@)(@@) % لولا التشهد والترداد منك له % % لم يسمع الناس يوما من لسانك لا % % 36(@)(@@) % . . . الجزيرة أمر لا تقر به % % وهاج مرجلها من فتنة وغلا % % 37(@)(@@) % فقر راجفها لما احتللت بها % % ورضت بالعدل منها الميل فاعتدلا % % 38(@)(@@) % واهتزت الأرض في ريعانها وربت % % كأن ملكك شمس حلت الحملا % % 39(@)(@@) % حتى إذا برقت للروع بارقة % % أقبلتها البيض والعسالة الذبلا % % 40(@)(@@) % وكلما عذلتك النفس وادعة % % جعلت سيفك فيها يسبق العذلا % % PageV01P670 41(@)(@@) % في فتية ذمرت منها العلا صعدا % % قد ساغ صبر المنايا عندها وحلا % % 42(@)(@@) % تضيء أوجهها والحرب كالحة % % وشاب مفرقها بالنقع واكتهلا % % 43(@)(@@) % لو رامت الشهب في أقصى مراكزها % % لم تبق في الجو بهراما ولا زحلا % % 44(@)(@@) % أرسلت منها على الأعداء داهية % % دهياء ما وجدت في دفعها قبلا % % 45(@)(@@) % حتى إذا سألتك السلم مائلة % % حكمت فيها كتاب الله ممتثلا % % 46(@)(@@) % وصرت والدين ضاح في هواجرها % % ظلال أمن وسلم أمن السبلا % % 47(@)(@@) % فكادت الشاء ترعى والذئاب معا % % وكادت الناس فيها تأمن الأجلا % % 48(@)(@@) % فدم وملكك للإسلام خير حمى % % يغني الخطوب ويكفي الحادث الجللا % % 49(@)(@@) % واسعد بعيد أعاد الدهر مبتهجا % % في ظل ريعانه والسعد مقتبلا % % 50(@)(@@) % وازلف بصوم حييت الذكر وافده % % قرى وأخلصت فيه القول والعملا % % PageV01P671 51(@)(@@) % أثنى عليك بما أوليت من عمل % % بر وودع أرضى راحل رحلا % % 52(@)(@@) % ودون ملكك من روض البيان نهى 
ms170	 % % أرحت فيها القوافي فاغتدت مثلا % % 53(@)(@@) % تنبيك عن قدم في العرب راسخة % % والطرف يعرف منه العتق إن صهلا % % PageV01P672 البحر : طويل 1(@)(@@) % تذكرت عهدا للشباب الذي ولى % % فصاب له تسكاب دمعي وانهلا % % 2(@)(@@) % وقلت وقد آنست بارقة الهوى % % عهود الصبا يا ما ألذ وما أحلا % % 3(@)(@@) % إذ العيش غض والشبيبة روضة % % أزاهرها تجنى وأنوارها تجلا % % 4(@)(@@) % عهود منى ألوى لجدتها المدى % % وقلص من إيناسها ذلك الظلا % % 5(@)(@@) % وما كان إلا كالخيال لنائم % % ألم ويا سرعان ما قوض الرحلا % % 6(@)(@@) % فلله من ضيف حميد مقامه % % لدينا فلو طال المقام لما ملا % % 7(@)(@@) % نوى ظعنا قبل الوداع مبادرا % % فجاد الحيا مثواه أن يتماحلا % % 8(@)(@@) % وخلفنا نأتي الرسوم فنشتكي % % إليها وهل تشفي الرسوم جوى كلا % % 9(@)(@@) % ومما شجاني أن مررت بمكتب % % فهيج وجدي للزمان الذي ولا % % 10(@)(@@) % وكم قدم قد أقدمت لغرامها % % وخط على تعذيب مهجته دلا % % PageV01P673 11(@)(@@) % بعيد عن الأبصار سام مكانه % % فلله ما أبهى ولله ما أعلا % % 12(@)(@@) % خميلة ذكر جادها واكف المنى % % فمن حكمة تروى ومن آية تتلا % % 13(@)(@@) % وقد حل فيه من مهى الإنس فتية % % أوانس لا يعرفن شيحا ولا رملا % % 14(@)(@@) % تراع من الوسمي إن كان ساقطا % % عليها وتستخفي النسيم إذا اعتلا % % 15(@)(@@) % وليس لديها للعذار توقع % % فترهب يوما عقربا منه أو صلا % % 16(@)(@@) % إذا ما بكى منهم لديغ لدرة % % وجادت بدر الدمع مقلته النجلا % % 17(@)(@@) % وسال بصفح الخد در دموعه % % رأيت شقيق الروض بالغيم قد طلا % % 18(@)(@@) % وما كان إلا أن وقفت فأسرعوا % % يريشون من أهداب أحداقهم نبلا % % 19(@)(@@) % وهبوا إلى أعطافهم ولحاظهم % % فكم صعدة هزت وكم صارم سلا % % 20(@)(@@) % رويدكم يا قوم إنا بنو الهدى % % آآل كتاب الله لا تنسوا الفضلا % % PageV01P674 21(@)(@@) % قصارى منانا أن نفوز بنظرة % % ونقنع من نيل الوصال بما قلا % % 22(@)(@@) % إلى الله أشكو ما ألاقي من الجوى % % وبعض الذي ألقاه من لاعج أجلا % % 23(@)(@@) % ويالك من نفس إذا برقت لها % % عهود الهوى قالت لوارده أهلا % % 24(@)(@@) % ومن نظرة دلت على جفني البكا % % ومن 
ms171	 خطرة نادت إلى قلبي الخبلا % % 25(@)(@@) % أبا جعفر جاريت كل معلم % % ففت بنيه في طريقتك المثلا % % 26(@)(@@) % ويا حضرة أضحى أبو جعفر بها % % فكان لها أهلا وكانت له أهلا % % 27(@)(@@) % بقيت كناسا للظباء ومربعا % % جنابك لا يشكو عفاء ولا محلا % % PageV01P675 البحر : كامل تام 1(@)(@@) % وفدت عقيلتك التي أهديتها % % حسناء تسحب للبيان ذيولا % % 2(@)(@@) % فهفا لها النادي وحل لها الحبا % % أهل الكلام مصاعبا وقيولا % % 3(@)(@@) % وهي العقيلة من قريش أحرزت % % من منصب الشرف المنيف جليلا % % 4(@)(@@) % فبلغت لما أن ظفرت بقربها % % أملا ملأت به يدي وسولا % % 5(@)(@@) % وكأنني لما سمعت بديعها % % ورشفت منها مرفقا مشمولا % % 6(@)(@@) % دنف تناءت بالأحبة داره % % حبا ووجه من نحب رسولا % % 7(@)(@@) % وحبوت منك يدا حبتني بالمنى % % منها ثناء دائما موصولا % % PageV01P676 البحر : طويل 1(@)(@@) % وجودك حيى الملك والدين والدنيا % % وجودك أحيا المجد والسيرة العليا % % 2(@)(@@) % وجدك أولى الأمن واليمن والهدى % % وجدك جلى الخطب والموئد الدهيا % % 3(@)(@@) % لك الله من ملك سعيد زمانه % % تكنفتنا عدلا وأوسعتنا رعيا % % 4(@)(@@) % إذا ألمت أو أملتك عصابة % % تواسي الذي استجدى وتأسو الذي أعيا % % 5(@)(@@) % ألم تر أن الدهر أذعن طائعا % % لما شئت لا يعصيك أمرا ولا نهيا % % 6(@)(@@) % فقابل عيد مقبل لك بالمنى % % وطالع سعد حاكم لك بالبقيا % % 7(@)(@@) % وداع دعا حي على بيعة الرضا % % فإنجاز وعد أالله أصبح مأتيا % % 8(@)(@@) % هلموا إلى تقبيل راحة يوسف % % فمن وجهه البشرى ومن كفه السقيا % % 9(@)(@@) % ألا الرحمن نصر نبيه % % فحيا تحيات العلا ذلك الحيا % % 10(@)(@@) % همام أجد الدين بعد اختلافه % % وألبسه من عدل أيامه وشيا % % PageV01P677 11(@)(@@) % وفرق بين الحق والشك إذ جرى % % على سنن الفاروق في هديه جريا % % 12(@)(@@) % فمن نوره الأرجاء باهرة السنا % % ومن ذكره الأفواه عاطرة الريا % % 13(@)(@@) % أهاب فلبى الفتح داعيه إذ دعا % % وأصرخه النصر المؤزر إذ أيا % % 14(@)(@@) % هو السحب جودا والكواكب همة % % وبدر الدجى وجها وشمس الضحى رأيا % % 15(@)(@@) % فلو راع صرف الدهر يوما بجيشه % % لأصبح نسيا آخر الدهر منسيا % % 16(@)(@@) % من القوم شادوا الدين بدءا ودافعوا % % بأسيافهم عن 
ms172	 ركنه الوهن والوهيا % % 17(@)(@@) % من القوم جادوا بالنفوس كأنما % % يسقون في ورد الردى الشهد والأريا % % 18(@)(@@) % من القوم آووا خاتم الرسل أحمدا % % وهم عضدوا التنزيل والحق والوحيا % % 19(@)(@@) % بدور لسار أو بحور لسائل % % فمن تلق منهم تلق أروع بدريا % % 20(@)(@@) % فمن أدهم أضفى عليه مسجيا % % رداء كلون البرس ألحف زنجيا % % PageV01P678 21(@)(@@) % ومن أشقر كالبرق يستبق الصبا % % ومن أشهب يفري أديم الدجى فريا % % 22(@)(@@) % ومن أحمر تحت العجاج كأنه % % سنا شفق يلتاح في الليلة الدجيا % % 23(@)(@@) % ومن أشعل رش النجيع احمراره % % وقد سامت الهيجاء مرجلها غليا % % 24(@)(@@) % وأصفر حلاه الأصيل نضاره % % ووشى بنيل النيل أعرافه وشيا % % 25(@)(@@) % عراب كما تنصاع قتم كواسر % % إذا استعجلوها من مرابطها العليا % % 26(@)(@@) % حرام عليها أن يفوت قنيصها % % ولو أنها تبغي الفراقد والجديا % % 27(@)(@@) % ولا يحملون النار عن ثقة بها % % سنابكها تستحضر الزند والوريا % % 28(@)(@@) % حشاياهم عند الكرى صهواتها % % فأحلامهم بالسبي صادقة الرؤيا % % 29(@)(@@) % ألا في سبيل الله سيرتك التي % % ينادي بها الإيمان حي هلا حيا % % 30(@)(@@) % تجليت للدنيا فأشرق نورها % % وقد كان وجه الدهر ذا مقلة عميا % % PageV01P679 31(@)(@@) % فكم نصرة لله جهرا قضيتها % % وكم نعمة غماء قضيتها خفيا % % 32(@)(@@) % وكم كربة جليت داج ظلامها % % وداع لنصر الله لم تره الأيا % % 33(@)(@@) % وكم وثقت بالنصر منك كتيبة % % بعثت بها لا تعرف الجهد والونيا % % 34(@)(@@) % تدوخ أقطار العدو بعدوها % % وتقهرهم قتلا وترهقهم خزيا % % 35(@)(@@) % فلم تبق إلا من حمتها جفونها % % أو الشنب المعسول والشفة اللميا % % 36(@)(@@) % وأهيف ساجي المقلتين إذا انتهى % % تثنى لنا غصنا ولا حظنا ظبيا % % 37(@)(@@) % جرت سانحات بيننا وبوارحا % % فكانت لنا غنما وكانت لهم نعيا % % 38(@)(@@) % فيا حلم الملك الذي عم عدله % % جميع الورى إن أشكل النص والفتيا % % 39(@)(@@) % ومن قوله فصل ومن فعله هدى % % ومن ملكه رشد به أذهب الغيا % % 40(@)(@@) % لمعنى حباك الله بالملك ناشئا % % أهل العلم في المهد مهديا % % PageV01P680 41(@)(@@) % ودونكها يصبو الحليم لحسنها % % وتسبي عقول السامعين لها سبيا % % 42(@)(@@) % تصير حر الشعر عبدا وإن يكن % % محل من الإبداع غايته القصيا 
ms173	 % % 43(@)(@@) % تجرر ذيل الزهو عند جريره % % وطائيه تطوي وتكند كنديا % % 44(@)(@@) % ويهتز عطف الملك عند سماعها % % كهزة كفيك الجسام اليمانيا % % 45(@)(@@) % نتيجة قلب ممحض لك وده % % تبيد الليالي وهي باقية تحيا % % 46(@)(@@) % فلا زلت يا أقصى الملوك مآثرا % % وأمضاهم في الله أبيض هنديا % % 47(@)(@@) % رضاك لرضوان الإله مبلغ % % وحبك ذخر في الممات وفي المحيا % % PageV01P681 
