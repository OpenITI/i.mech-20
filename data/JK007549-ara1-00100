ms81	 من عرب إلي جوادهم % إلا تركت جوادهم محسورا % % 25(@)(@@) % أبقت مراكضة الرهان مجربا % عند المواطن يرزق التبشيرا % % 26(@)(@@) % فإذا هززت قطعت كل ضريبة % ومضيت لا طبعا ولا مبهورا % % 27(@)(@@) % إني إذا مضر علي تحدبت ، % لاقيت مطلع الجبال وعورا % % 28(@)(@@) % مدت بحورهم فلست بقاطع % بحرا يمد من البحور بحورا % % 29(@)(@@) % الضاربون على النصارى جزية ، % وهدى لمن تبع الكتاب ونورا % % 30(@)(@@) % إنا تفضل في الحياة حياتنا % % ونسود من دخل القبور قبورا % % PageV01P284 31(@)(@@) % ألله فضلنا وأخرى تغلبا % لن تستطيع لما قضى تغييرا % % 32(@)(@@) % فينا المساجدوا الامام ولا ترى % أشراف تغلب سائلا وأجيرا % % 33(@)(@@) % إن الأخيطل لو يفاضل خندفا % لقى الهوان هناك والتصغيرا % % 34(@)(@@) % و إذا الدعاء علا بقيس ألجموا % % شعثا ملامع كالقنا وذكورا % % 35(@)(@@) % ألباعثين برغم آنف تغلب % في كل منزلة عليك أميرا % % 36(@)(@@) % أفبالصليب ومارسرجس تتقي % % شهباء ذات مناكب جمهورا % % 37(@)(@@) % عاينت مشعلة الرعال كأنها % % طير تغاول في شمام وكوررا % % 38(@)(@@) % جنح الأصييل وقد قضينا لتغلب % نحبا قضين قضاءه ونذورا % % 39(@)(@@) % أسلمت أحمر وابن عبد محرق % و وجدت يومئذ أزب نفورا % % 40(@)(@@) % فإذا وطئنك يا أخيطل وطأة % لم يرج عظمك بعدهن جبورا % % PageV01P285 41(@)(@@) % فإذا سمعت بحرب قيس بعدها % % فضعوا السلاح وكفروا تكفيرا % % 42(@)(@@) % تركوا شعيث بني مليل مسلما % والشعثمين وأسلموا شعرورا % % 43(@)(@@) % وأجر مطرد الكعوب كأنه % مسد ينازع من لصاف جرورا % % 44(@)(@@) % و كأن تغلب يوم لاقوا خيلنا % % خربان ذي حسم لقين صقورا % % 45(@)(@@) % إنا نصدق بالذي قلنا لكم ، % ويكون قولك يا فرزدق زورا % % 46(@)(@@) % لعن الاله نسية من تغلب % يرفعن من قطع العباء خدورا % 47(@)(@@) % الجاعلين لمار سرجس حجهم % و حجيج مكة يكثروا التكبيرا % % 48(@)(@@) % من كل حنكلة ترى جلبابها % % فروا وتقلب للعباءة نيرا % % 49(@)(@@) % و كأنما بصق الجراد بليتها % % فالوجه لا حسنا ولا منضورا % % 50(@)(@@) % لقى الأخيطل أمه مخمورة % قبحا لذلك شاربا مخمورا % % PageV01P286 52(@)(@@) % لم يجر مذ خلقت على أنيابها % % ماء السواك ولم تمس طهورا % % 53(@)(@@) % لقحت لأشهب بالكناسة داجن % خنزيرة فتوالدا خنزيرا % % PageV01P287 البحر : طويل 1(@)(@@) % ألا بكرت سلمى فجد 
ms82	 بكورها ، % وشق العصا بعد اجتماع أميرها % % 2(@)(@@) % إذا نحن قلنا قد تباينت النوى % % ترقرق سلمى عبرة أو تميزها % % 3(@)(@@) % لها قصب ريان قد شجيت به % خلاخيل سلمى المصمتات وسورها % % 4(@)(@@) % غذا نحن لم نملك لسلمى زيارة % نفسنا جدا سلمى على من يزورها % % 5(@)(@@) % فهل تبلغني الحاج مضبورة القرى % % بطيء بمور الناعجات فتورها % % 6(@)(@@) % نجاة يصل المرو تحت أظلها % % بلاحقة الأظلال حام هجيرها % % 7(@)(@@) % أل ليت شعري عن سليط ألم تجد % سليط سوى غسان جارا يجيرها % % 8(@)(@@) % لقد ضمنوا الأحساب صاحب سوأة % يناجي بها نفسا لئيما ضميرها % % 10(@)(@@) % ستعلم ما يغنى حكيم ومنقع % إذا الحرب لم يرجع بصلح سفيرها % % 11(@)(@@) % ألا ساء ما تبلى سليط إذا ربت % جواشنها وازداد عرضا ظهورها % % PageV01P288 14(@)(@@) % عضاريط يشوون الفراسن بالضحى % % إذا ما السرايا حث ركضا مغيرها % % 15(@)(@@) % فما في سليط فارس ذو حفيظة ، % و معقلها يوم الهياج جعورها % % 16(@)(@@) % أضجوا الروايا بالمزاد ، فإنكم % ستكفون كرا لخيل تدمى نحورها % % 17(@)(@@) % عجبت من الداعي جحيشا وصائدا % وعيساء يسعى بالعلاب نفيرها % % 18(@)(@@) % أساعية عيساء والضان حفل % فما حاولت عيساء أم ما عذيرها % % 19(@)(@@) % إذا ما تعاظمتم جعورا فشرفوا % % جحيشا إذا آبت من الصيف عيرها % % 20(@)(@@) % أناسا يخالون العباءة فيهم % قطيفة مرعزي يقلب نيرها % % 22(@)(@@) % إذا قيل أن تركبوا ذات ناطح % من الحرب يلوى بالرداء نذيرها % % 23(@)(@@) % وما بكم صبر على مشرفية % تعض فراخ الهام ، أو تسطيرها % % 24(@)(@@) % تمنيتم أن تسلبوا القاع أهله ، % كذاك المنى غرت جحيشا غرورها % % PageV01P289 25(@)(@@) % وقد كان في بقعاء ري لشائكم % وتلعة ، والجوباء يجري غديرها % % 26(@)(@@) % تناهوا ولا تستوردوا مشرفية % تطير شؤون الهام منها ذكورها % % 27(@)(@@) % كأن السليطيين أنقاض كمأة % لأول جان ، بالعصا يستثيرها % % 28(@)(@@) % غضبتم عليها أو تغنيتم بها % % أن اخضر من بطن التلاع غميرها % % 29(@)(@@) % فلو كان حلم نافع في مقلد % لما وغرت من غير جرم صدورها % % 30(@)(@@) % بنو الخطفى والخيل أيام سوقة % جلوا عنكم الظلماء وانشق نورها % % 31(@)(@@) % و في بئر حصن أدركنها حفيظة % و قد رد فيها مرتين حفيرها % % 32(@)(@@) % فجئنا 
ms83	 وقد عادت مراعا وبركت % عليها مخاض لم تجد من يثيرها % % 33(@)(@@) % لئن ضل يوما بالمجشر رأيه ، % وكان لعوف حاسدا لا يضيرها % % 34(@)(@@) % فأولى وأولى أن أصيب مقلدا % بغاشية العدوى سريع نشورها % % PageV01P290 35(@)(@@) % لقد جردت يوم الحداب نساؤهم % فساءت مجاليها ، وقلت مهورها % % PageV01P291 البحر : بسيط تام 1(@)(@@) % يا عين جودي بدمع هاجه الذكر % فما لدمعك بعد اليوم مدخر % 2(@)(@@) % إن الخليفة قد وارى شمائله % غبراء ملحودة في جولها زور % 3(@)(@@) % أمسى بنوها وقد جلت مصيبتهم % مثل النجوم هوى من بينها القمر % 4(@)(@@) % كانوا شهودا فلم يدفع منيته % عبد العزيز ولا روح ولا عمر % 5(@)(@@) % و خالد لو أراد الدهر فديته % أغلوا مخاطرة لو يقبل الخطر % 6(@)(@@) % قد شفني روعة العباس من فزع % لما أتاه بدير القسطل الخبر % PageV01P292 البحر : وافر تام 1(@)(@@) % لقد نادى أميرك بابتكار % و لم يلووا عليك ولم تزارى % % 2(@)(@@) % وقد رفع الظعائن يوم رهبى % % بروح من فؤادك مستطار % 3(@)(@@) % ذكرتك بالجموم ويوم مروا % % على مران راجعني ادكاري % % 4(@)(@@) % و تيم يفخرون ضرب تيم % كضرب الزيف بار على التجار % 5(@)(@@) % وتعرف بالمنازل ، يا ابن تيم ، % لئيم الضرب مطرف النجار % 6(@)(@@) % رويدا لافتخارك يا بن تيم % رقيقا ما عتقت من الإسار % 7(@)(@@) % تذكر هل تفاخر يا بن تيم % بفرع أو لأصلك من قرار % 8(@)(@@) % فما عرفوا السباق وما تجلت % وجوه التيم من قتم الغبار % 9(@)(@@) % أتطلب سابق الحلبات تيم % تقدم في المواطن إذ يجاري % % 10(@)(@@) % صريحا لم تلد أبويه تيم ، % ولم ينسب لأخت بني حذار % PageV01P293 11(@)(@@) % لعمر أبيك ما شجرات تيم % من النبع العتيق ولا النضار % 12(@)(@@) % ة قد علمت تميم أن تيما % بعيد حين ينسب من نزار % 13(@)(@@) % فأنتم عائذون بآل سعد % بعقد الحلف أو سبب الجوار % 14(@)(@@) % نعد تميمنا وتعد تيما ، % فقد أرديت في اللجج الغمار % 15(@)(@@) % لنا عمرو عليك وآل سعد ، % وثروة دارم وحصى الجمار % 16(@)(@@) % وجواز الحجيج لنا عليكم % و عادى المكارم والمنار % 17(@)(@@) % و خالي من خزيمة يا بن تيم % عظيم البيت مرتفع السواري % % 18(@)(@@) % لقد 
ms84	 وجد ابن برزة يوم جارى % % بطيئا عن مرافعة الخطار % 19(@)(@@) % فكيف ترى جذابي يا ابن تيم % وقد قرنتم قرن البكار % 20(@)(@@) % فلست مفارقا قرني ، حتى % % يطول تصعدي بك وانحداري % % PageV01P294 21(@)(@@) % وما بالميس يرحل وفد تيم ، % ولكن بالسوية والحصار % 22(@)(@@) % وجدنا التيم من سبأ وتيم % مجاورة القرود مع الوبار % 23(@)(@@) % فان تجزوا بنعمتنا شكرتم % رياحا أو فوارس ذي الخمار % 24(@)(@@) % أتعدل ليل أيسر ، مستنيما ، % بليل الملجمات على سفار % 25(@)(@@) % توالى في المرابط مقربات ، % طواهن المغار على اقورار % 26(@)(@@) % نعشيها الغبوق على بنينا ، % و نطعمها المحيل على الصفار % 27(@)(@@) % وقد علم ابن أبحر أن خيلي % % غداة الجمد صادقة الغوار % 28(@)(@@) % قرعن بنا كتائب آل نصر ، % وزحف المنذرين وذي المرار % 29(@)(@@) % و هامات الجبابر قد صدعنا % % كأن عظامها فلق المحار % 30(@)(@@) % فما شهدت رجال التيم حربا % و لا أيام طخفة والنسار % PageV01P295 البحر : - 1(@)(@@) % يا صاحبي هل الصباح منير % أم هل للوم عواذلي تفتير ؟ % 2(@)(@@) % أني تكلف بالغميم حاجة % نهيا حمامة دونها ، وحفير % 3(@)(@@) % عادات قلبك حين خف به الهوى % % لولا تسكنه لكاد يطير % 4(@)(@@) % إن العواذل لم يجدن كوجدنا % % فلهن منك تعبد وزفير % 5(@)(@@) % ينهين من علق الهوى بفؤاده % حتى استبين بسمعه توقير % 6(@)(@@) % هلا غضبت لنا ، وأنت أمير % إن اليسير بذا الزمان عسير % 7(@)(@@) % يا قلب هل لك في العزاء فانه % قد عيل صبرك والكريم صبور % 8(@)(@@) % يا بشر إنك لم تزل في نعمة % بالبغض نحوك والعداوة عور % 9(@)(@@) % وكتمت سرك في الفؤاد مجمجما ؛ % إن الكتوم لسره لجدير % 10(@)(@@) % فسقى ديارك حيث كنت مجلجل % هزج يرن على الديار مطير % PageV01P296 11(@)(@@) % ولقد ذكرتك باليمامة ذكرة ؛ % إن المحب لمن يحب ذكور % 12(@)(@@) % والعيس منعلة السريح من الوجى % % وكأنهن من الهواجر عور % 13(@)(@@) % يا بشر حق لبشرك التبشير % يأتيك من قبل الإله بشير % 14(@)(@@) % بشر أبو مروان إن عاسرته % عسر وعند يساره ميسزر % 15(@)(@@) % قد كان حقك أن تقول الكرم ابنها % % وابن اللئيمة للئام نصور % 16(@)(@@) % لا يدخلن عليك ، إن دخولهم % رجس وإن خروجهم تطهير 
ms85	 % 17(@)(@@) % أمسى سراقة قد عوى لشقائه ، % خطب ، وأمك يا سراق ، يسير % 18(@)(@@) % أسراق ! قد علمت معد أنني % % قدما مطالعه عليك وعور % % 19(@)(@@) % يا آل بارق لو تقدم ناصح % للبارقي فانه مغرور % 20(@)(@@) % كالسامري غداة ضل بقومه ، % والعجل يعكف حوله ويخور % PageV01P297 21(@)(@@) % إني بنى لي من يزيد بناؤه % طولا ، وباعك يا سراق قصير % 22(@)(@@) % لو كنت تعلم ما جهلت فوارسي % % أيام طخفة والدماء تمور % 23(@)(@@) % هلا بذي نجب علمت بلاءنا % % يا آل بارق ، فيم سب جرير % 24(@)(@@) % أنصرت قين بني قفيرة محلبا ؟ % فضغا وأسلم تغلب الخنزير % 25(@)(@@) % قد كان في كلب يخاف شذاته % مني وما لقي الغواة نذير % % 26(@)(@@) % أسراق إنك قد تركت مخلفا % و غبار عثيرها عليك يثور % % 27(@)(@@) % وعلقت في مرس يمد قرينه % حتى التوى بك محصد مشزور % 28(@)(@@) % لحصاد بارق كان أهون ضيعة % و المخلبان ودونك المنحور % % 29(@)(@@) % من مخدر قطع الطريق بلعلع % تهوي مخالبه معا فيسور % 30(@)(@@) % تؤتى الكرام مهو رهن سياقة % ونساء بارق ما لهن مهور % PageV01P298 31(@)(@@) % إن الملامة والمذلة فاعلموا % % قدر لأول بارق مقدور % 33(@)(@@) % وإذا انتسبت إلى شنوءة تدعي ، % قالوا : ادعاء أبي سراقة زور % 34(@)(@@) % اني بني لي زاخر من خندف % لليلك فيه مناير وسرير % 35(@)(@@) % أسراق ! إنك لو تفاضل خندفا % بثقت عليك من الفرات بحور % 36(@)(@@) % أسراق ! إنك لا نزارا نلتم ، % والحي من يمن عليك نصير % 37(@)(@@) % أسراق ! إن لنا العراق ونجده % والغور ، ويل أبيك ، حين نغور % 38(@)(@@) % أرجا سراقة أن يفاضل خندفا % وأبو سراقة في الحصى مكثور % PageV01P299 البحر : متقارب تام 1(@)(@@) % زار القبور أبو مالك ، % فكان كألأم زوارها % % 2(@)(@@) % ستبكي عليه دروم العشاء % خبيث تنسم أسحارها % % 5(@)(@@) % تنوح بنات أبي مالك % ببوق لصاري وزمارها % % 6(@)(@@) % لقد سرني وقع خيل الهذيل ، % وترغيم تغلب في دارها % % 7(@)(@@) % وفات الهذيل بني تغلب ، % وجحاف قيس بأوتارها % % 8(@)(@@) % تحضون قيسا ولا تصبرون % لزبن الحروب وإضرارها % % PageV01P300 البحر : بسيط تام 1(@)(@@) % تنعي النعاة أمير المؤمنين لنا % % يا خير من حج بيت الله واعتمرا % % 2(@)(@@) % حملت أمرا عظيما فاصطبرت له 
ms86	 % وقمت فيه بأمر الله ، يا عمرا % % 3(@)(@@) % فالشمس كاسفة ليست بطالعة ، % تبكي عليك نجوم الليل والقمرا % % PageV01P301 البحر : كامل تام 1(@)(@@) % طرب الحمام بذي الأراك فهاجبني ؛ % لا زلت في غلل وأيك ناضر % 2(@)(@@) % شبهت منزلة براح ، وقد أتى % % حول المحيل خلال جفن داثر % 3(@)(@@) % نشرت عليك فبشرت بعد البلى % % ريح يمانية بيوم ماطر % 4(@)(@@) % إن قال صحبتك الرواح فقل لهم % حيوا الغزيز ومن به من حاضر % 5(@)(@@) % نهوى الخليط ولو أقمنا بعدهم ؛ % إن المقيم مكلف بالسائر % 6(@)(@@) % إن المطي بنا يخدن ضحى عد % واليوم يوم لبانة وتزاور % 7(@)(@@) % سنح الهوى فكتمت صحبي حاجة % بلغت تجلد ذي العزاء الصابر % 8(@)(@@) % جزعا بكيت على الشباب وشاقني % % عرفان منزلة بجزعي ساجر % 9(@)(@@) % أما الفؤاد ، فلن يزال متيما % بهوى جمانة أو بريا العاقر % 10(@)(@@) % طرقت بمخترق الفلاة مشردا ، % جعل الوساد ذراع حرف ضامر % PageV01P302 11(@)(@@) % يا أم طلحة ! ما لقينا مثلكم % في المنجدين ولا بغور الغائر % 12(@)(@@) % رهبان مدين لو رأوك تنزلوا % % و العصم من شعف العقول الفادر % 13(@)(@@) % لمن الحمول من الاياد تحملت % كالدوم أو ظلل السفين العابر % 14(@)(@@) % يحدو بهن مشمر عن ساقه % مثل المنيح نحى قداح الياسر % 15(@)(@@) % قربن مفرعة الكواهل بزلا ، % من كل مطرد الجديل عذافر % 16(@)(@@) % نهد المحال ، إذا حدين ، مفرج ، % سبط المشافر مخلف أو فاطر % 17(@)(@@) % منه بمجتمع الأخادع نابع % يغشى الذفارى كالكحيل القاطر % 18(@)(@@) % وإذا الأزمة أعلقت أزرارها ، % جرجرن بين لها وبين حناجر % 19(@)(@@) % زال الجمال بنخل يثرب بالضحى % % أو بالرواجح من إباض العامر % 20(@)(@@) % ليت الزبير بنا تلبس حبله ، % ليس الوفي لجاره كالغادر % PageV01P303 21(@)(@@) % وجد الزبير بذي السباع مجاشعا % للحيثلوط ونزوة من ضاطر % 23(@)(@@) % باتوا وقد قتل الزبير كأنهم % خور صوادر عن نجيل قراقر % 24(@)(@@) % ولدت قفيرة أم صعصعة ابنها % % فوق المزنم بين وطبي جازر % 26(@)(@@) % عزبت قفيرة في الغريب وراحت % بالكف بين قوادم وأواخر % 28(@)(@@) % علق الأخيطل في حبالي بعدما % % عثر الفرزدق لالعا للعاثر % 29(@)(@@) % لقي الأخيطل ما لقيت وقبله % طاح البعيث بغير عرض وافر % 30(@)(@@) % وإذا 
ms87	 رجوا أن ينقضوا مني قوى ، % مرست قواي عليهم ومرائري % % 31(@)(@@) % و منوا بملتهم العنان مناقل % عند الرهان مقرب ومحاضر % 32(@)(@@) % إني نزلت بمفرع من خندف % في أهل مملكة وملك قاهر % 33(@)(@@) % كانت فواضلنا عليك عظيمة % من سيب مقتدر عزيز قادر % PageV01P304 34(@)(@@) % ماذا تقول وقد عرفت لخندف % زهر النجوم وكل بحر زاخر % 37(@)(@@) % إن القصائد قد وطئن مجاشعا ، % ووطئن تغلب ما لها من زاخر % 38(@)(@@) % نبئت تغلب يعبدون صليبهم % بالرقتين إلى جنوب الماخر % 39(@)(@@) % يستنصرون بمار سرجس وابنه % بعد الصليب وما لهم من ناصر % 40(@)(@@) % كذب الأخيطل ما توقف خيلنا % % عند اللقاء ، وما ترى في السامر % 41(@)(@@) % رجعا نقص لها الحديد من الوجى % % بعد ابتراء سنابك ودوابر % 42(@)(@@) % سائل بهن أبا ربيعة كلهم % واسأل بني غبر غداة الحائر % 43(@)(@@) % وطئت جياد بني تميم تغلبا % يوم الهذيل غداة حيي هاجر % 44(@)(@@) % وإذا رجعن وقد وطئن عدونا % % 45(@)(@@) % حدرتك من شرفي خزار خيلنا ، % والحرب ذات تقحم وتراتر % PageV01P305 46(@)(@@) % خسر الأخيطل والصليب وتغلب % ويكال ، ما جمعوا ، بمد خاسر % 47(@)(@@) % وابتعت ويل أبيك ، ألأم شربة % بفساد تغلب بئس ربح التاجر % 48(@)(@@) % أد الجزى ودع الفخار بتغلب ، % واخسا بمنزلة الذليل الصاغر % 49(@)(@@) % أنبئت تغلب بعدما جدعتهم ، % يتعذرون وما لهم من عاذر % 50(@)(@@) % والتغلبية ، حين غب غبيبها ، % تهوي مشافرها لشر مشافر % 53(@)(@@) % إن الأخيطل لن يقوم لبزل ، % أنيابها كشبا الزجاج قساور % 54(@)(@@) % فينا الخلافة والنبوة والهدى % % و ذو والمشورة كل يوم تشاور % 55(@)(@@) % و رجا الأخيطل أن يكدر بحرنا % % فأصاب حومة ذي لجاج غامر % 56(@)(@@) % بين الحواجب واللحى من تغلب % لؤم تورث كابرا عن كابر % 57(@)(@@) % يا ابن الخبيثة ! أين من أعددتم % لبني فزارة أو لحي عامر % PageV01P306 58(@)(@@) % و إذا لقيت قروم فرعي خندف % يبذخن بعد تزايف وتخاطر % 59(@)(@@) % خليت عن سنن الطريق ولم تزل % فيهم ملوك أسرة ومنابر % PageV01P307 البحر : بسيط تام 1(@)(@@) % حيوا المقام وحيوا ساكن الدار % ما كدت تعرف إلا بعد إنكار % 2(@)(@@) % إذا تقادم عهد الحي هيجني % % خيال طيبة الأردان معطار % 3(@)(@@) % لا يأمنن 
ms88	 قوب نقض مرته % إني أرى الدهر ذا نقض وإمرار % 4(@)(@@) % قد أطلب الحاجة القصوى فأدركها % % على الأنوف وسوما ذات أحبار % 5(@)(@@) % إلا بغر من الشيزى مكللة % يجري السديف عليها المربع الواري % % 6(@)(@@) % إذا أقول تركت الجهل هيجني % % رسم بذي البيض أو رسم بدوار % 7(@)(@@) % تمسي الرياح به حنانة عجلا % سوف الروائم بوا بين أظآر % 8(@)(@@) % هل بالنقيعة ذات السدر من أحد % أو منبت الشيح من روضات أعيار % 9(@)(@@) % سقيت من سبل الجوزاء غادية % وكل واكفه السعدين مدرار % 10(@)(@@) % قد كدت أن فراق الحي يشفعني % % أنسى عزاي وأبدى اليوم أسراري % % PageV01P308 11(@)(@@) % لولا الحياء لهاج الشوق مختشع % مثل الحمامة من مستوقد النار % 12(@)(@@) % لما رمتني بعين الريم فاقتتلت % قلبي رميت بعين الأجدل الضاري % % 13(@)(@@) % ملء العيون جمالا ثم يونقني % % لحن لبيث وصوت غير خوار % 14(@)(@@) % قومي تميم هم القوم الذين هم % ينفون تغلب عن بحبوحة الدار % % 15(@)(@@) % النازلون الحمى لم يرع قبلهم ؛ % والمانعون بلا حلف ولا جار % 16(@)(@@) % ساقتك خيلي من الأشراف معلمة % حتى نزلت جحيشا غير مختار % 17(@)(@@) % لن تستطيع إذا ما خندف خطرت % شم الجبال ولج المزبد الجاري % % 18(@)(@@) % ترمي خزيمة من أرمي ويغضب لي % % أبناء مر بنو عراء مذكار % 19(@)(@@) % إن الذين اجتنوا مجدا ومكرمة % تلكم قريشي والأنصار أنصاري % % 20(@)(@@) % و الحي قيس بأعلى المجد منزلة % فاستكرموا من فروع زندها وارى % % PageV01P309 21(@)(@@) % قومي فأصلهم أصلي ، وفرعهم % فرعي وعقدهم عقدي وإمراري % % 22(@)(@@) % منا فوارس ذي بهدى وذي نجب % و المعلمون صباحا يوم ذي قار % 23(@)(@@) % مسترعفين بجزء في أوائلهم % وقعنب ، وحماة غير أغمار % 24(@)(@@) % قد غل في الغل بسطاما فوارسنا % % واستودعوا نعمة في آل حجار % 25(@)(@@) % ما أوقد الناس من نيران مكرمة % إلا اصطلينا وكنا موقدي النار % 26(@)(@@) % إنا لنبلو سيوفا غير محدثة ، % في كل معتقد التاجين جبار % 27(@)(@@) % إني لسباق غايات أفوز بها % % إذا أطيل لها شغلي وإضماري % % 28(@)(@@) % يا خزر تغلب إني قدء وسمتكم % يا خزر تغلب وسوما ذات أحبار % 29(@)(@@) % لا تفخرن ، فإن الله أنزلكم ، % يا خزر 
ms89	 تغلب دار الذل والعار % 30(@)(@@) % ما فيكم حكم ترضى حكومته % للمسلمين ولا مستشهد شاري % % PageV01P310 31(@)(@@) % قوم إذا حاولوا حجا لبيعهم % صروا الفلوس وحجوا غير أبرار % 32(@)(@@) % جئني بمثل بني بدر لقومهم % أو مثل أسرة منظور بن سيار % 33(@)(@@) % أو مثل آل زهير والقنا قصد ، % والخيل في رهج منها وإعصار % 34(@)(@@) % أو عامر بن طفيل في مركبه ؛ % أو حارث يوم نادى القوم : يا حار % 35(@)(@@) % أو فارس كشريح يوم نحمله % نهد المراكل يحمي عورة الجار % 36(@)(@@) % أو آل شمخ ، وهل في الناس مثلهم % للمتعفين ولاطلاب أوتار % 37(@)(@@) % نبأت أنك بالخابور ممتنع ، % ثم انفرجت انفراجا بعد إقرار % 38(@)(@@) % قد كان دوني من النيران مقتبس % أخزيت قومك واستشعلت من ناري % % 39(@)(@@) % لم تدر أمك ما الحكم الذي حكمت % إذ مسها سكر من دنها الضاري % % PageV01P311 البحر : متقارب تام 1(@)(@@) % بان الخليط غداة الجناب ، % ولم تقض نفسك أوطارها % % 2(@)(@@) % فلا تكثروا طول شك الخلاج % وشدوا على العيس أكوارها % % 3(@)(@@) % سأرمي بها قاتمات الفجاج % ونهجر هندا وزوارها % % 4(@)(@@) % ألا قبح الله يوم الزبير % بلاء القيون وأخبارها % % 6(@)(@@) % فانا وجدنا ابن جوخي القيون % لئيم المواطن خوارها % % 7(@)(@@) % ولو خير القين بين الحياة % و بين المنية لاختارها % % 8(@)(@@) % أنمت بعين على خزية ، % فأغض على الذل أشفارها % % 9(@)(@@) % وقد يعلم الحي من مالك % % مناخ الدهيم ، وأيسارها % % 10(@)(@@) % أخذنا على الخور قد تعلمون % رداف الملوك وأصهارها % % 11(@)(@@) % ونكفيهم ، ثم لا يشكرون ، % مراس الحروب ، وإضرارها % % PageV01P312 13(@)(@@) % أنا ابن الفوارس يوم الغبيط % و ما تعرف العوذ أمهارها % % 14(@)(@@) % لحقنا بأبجر والحوفزان % وقد مدت الخيل إعصارها % % 15(@)(@@) % و راية ملك كظل العقاب % ضربنا على الرأس جبارها % % 16(@)(@@) % وكنا ، إذا حومة أعرضت ، % نخوض إلى الموت أغمارها % % 17(@)(@@) % فأفسدت تغلب كل الفساد ، % وشمت القيون وأكيارها % % 18(@)(@@) % و حامي الفوارس يوم الكعيل % ولم تحم تغلب أدبارها % % 19(@)(@@) % تركتم لقيس بنات الصريح % و عون النساء وأبكارها % % 20(@)(@@) % وضعتم بحزة حمل السلاح % و لم تضع الحرب أوزارها % % 21(@)(@@) % فان البرية لو جمعت % لألفيت تغلب أشرارها % % 23(@)(@@) % ولو أصبح 
ms90	 الناس حربا عدى % لقيس وخندف ما ضارها % % PageV01P313 24(@)(@@) % أخذنا عليكم عيون البحور % وبر البلاد وأمصارها % % 25(@)(@@) % ونحن ورثنا ، فخل الطريق ، % جوابي عاد وآبارها % % 26(@)(@@) % وأدعو الإله وتدعو الصليب ، % وأدعو قريشا ، وأنصارها % % 27(@)(@@) % كفوا خزر تغلب نصر الرسول % و نقض الأمور وإمرارها % % PageV01P314 البحر : كامل تام 1(@)(@@) % % إن السوابق عندها التبشير % 2(@)(@@) % و لقد نهيتك أن تسب مخرقا % وفراش أمك كلبتان وكير % 3(@)(@@) % يا ليت جاركم استجار مخرقا % يوم الخريبة والعجاج يثور % PageV01P315 البحر : كامل تام 1(@)(@@) % ما هاج شوقك من رسوم ديار % بلوى عنيق أو بصلب مطار % 2(@)(@@) % أبقى العواصف من معالم رسمها % % شذب الخيام ومربط الأمهار % 3(@)(@@) % أمن الفراق تعبت يوم عنيزة ، % كهواك يوم شقائق الأحفار % 5(@)(@@) % ورأيت نارك إذ أضاء وقودها ، % فرأيت أحسن مصطلين ونار % 6(@)(@@) % أما البعيث فقد تبين أنه % عبد ، فعلك في البعيث تماري % % 7(@)(@@) % واللؤم قد خطم البعيث وأرزمت % أم الفرزدق عند شر حوار % 8(@)(@@) % إن الفرزدق والبعيث وأمه % و أبا البعيث لشر ما إستار % 9(@)(@@) % طاح الفرزدق في الرهان ، وعمه % غمر البديهة صادق المضمار % 10(@)(@@) % ترجو الهوادة يا فرزدق بعدما % % أطفأت نارك واصطليت بناري % % 11(@)(@@) % إني لتحرق من قصدت لشتمه % ناري ويلحق بالغواة سعاري % % PageV01P316 12(@)(@@) % تبا لفخرك بالضلال ولم يزل % ثوبا أبيك مدنسين بعار % 13(@)(@@) % ماذا تقول وقد علوت عليكم % و المسلمون بما أقول قواري % % 14(@)(@@) % و إذا سألت قضى القضاة عليكم % وإذا افتخرت علا عليك فخاري % % 15(@)(@@) % فأنا النهار علا عليك بضوئه ، % والليل يقبض بسطة الأبصار % 16(@)(@@) % إنا لنربع بالخميس ترى له % رهجا ونضرب قونس الجبار % 17(@)(@@) % إذ لا تغار على البنات مجاشع % يوم الحفاظ ، ولا يفون بجار % 18(@)(@@) % أني لقومك مثل عدوة خيلنا % % بالشعب بوم مجزل الأمرار % 19(@)(@@) % قومي الذين يزيد سمعي ذكرهم % سمعا ، وكان بضوئهم إبصاري % % 20(@)(@@) % إن القصائد لن يزلن سوائحا % حمرا مساحلهن غير مهار % 21(@)(@@) % هل تشكرون لمن تدارك سبيكم % % والمردفات يملن بالأكوار % PageV01P317 22(@)(@@) % إني لتعرف في الثغور فوارسي ، % ويفرجون قتام كل غبار % 23(@)(@@) % نحن البناة دعائما وسواريا % يعلون كل دعائم 
ms91	 وسوار % 24(@)(@@) % تدعو ربيعة والقميص مفاضة % تحت النجاد ، تشد بالأزرار % 25(@)(@@) % إن البعيث وعبد آل مقاعس % لا يقرآن بسورة الأحبار % 26(@)(@@) % أبلغ بني وقبان أن نساءهم % خور بنات موقع خوار % 27(@)(@@) % كنتم بني أمة فأغلق دونكم % باب المكارم ، يا بني النخوار % 28(@)(@@) % أبني قفيرة ! قد أناخ إليكم % يوم التقاسم لؤم آل نزار % 29(@)(@@) % إن اللئام بني اللئام مجاشع % و الأخبثون محل كل ازار % 34(@)(@@) % سار القصائد واستبحن مجاشعا % ما بين مصر إلى جنوب وبار % 35(@)(@@) % يتلاومون وقد أباح حريمهم % قين ، أحلهم بدار بوار % PageV01P318 36(@)(@@) % لا تفخرن إذا سمعت مجاشعا % يتخاورون تخاور الأثوار % 37(@)(@@) % أعلي تغضب أن قفيرة أشبهت % منه مكان مقلد وعذار % 39(@)(@@) % قال الفرزدق ، إذ أتاه حديثها ، % ليست نوار مجاشع بنوار % 40(@)(@@) % تدعو ضريس بني الحتاة إذا انتشت % و تقول ويحك من أحس سواري % % 41(@)(@@) % % بحديث جعثن ما ترنم الأكيار % PageV01P319 البحر : بسيط تام 1(@)(@@) % حي الهدملة من ذات المواعيس ، % فالحنوا أصبح قفرا غير مأنوس % % 2(@)(@@) % حي الديار التي شبهتها خللا % أو منهجا من % % 3(@)(@@) % بين المخيصر فالعزاف منزلة % كالوحي من عهد موسى في القراطيس % 4(@)(@@) % لا وصل إذ صرفت هند ولو وقفت % لاستفتني وذا المسحين في القوس % 5(@)(@@) % لو لم ترد وصلنا جادت بمطرف ، % مما يخالط حب القلب منفوس % 6(@)(@@) % قد كنت خدنالنا يا هند فاعتبري % % ماذا يريبك من شيبي وتقويسي % % 7(@)(@@) % لما تذكرت بالديرين أرقني % % صوت الدجاج وقرع بالنواقيس % 8(@)(@@) % فقلت للركب إذ جد الرحيل بنا % % ما بعد يبرين من باب الفراديس % 9(@)(@@) % عل الهوى من بعيد أن يقربه % أم النجوم ومر القوم بالعيس % 10(@)(@@) % لو قد علون سماويا موارده % من نحو دومة خبت قل تعريسي % % PageV01P320 11(@)(@@) % هل دعوة من جبال الثلج مسمعة % أهل الإياد وحيا بالنباريس % 12(@)(@@) % إني ، إذا الشاعر المغرور حربني ، % جار لقبر على مران مرموس % 13(@)(@@) % قد كان أشوس أباء ، فأورثنا % % شغبا على الناس في أبنائه الشوس % 14(@)(@@) % نحمي ونغتصب الجبار بجنبه % في محصد من حبال القد مخموس % 15(@)(@@) % يخزى الوشيظ إذا قال الصميم لهم 
ms92	 % عدوا الحصى ثم قيسوا بالمقاييس % 16(@)(@@) % لا يستطيع امتناعا فقع قرقرة % بين الطريقين باليد الأماليس % 17(@)(@@) % وابن اللبون ، إذا ما لز في قرن ، % لم يستطع صولة البزل القناعيس % 18(@)(@@) % إنا ، إذا معشر كشت بكارتهم ، % صلنا بأصيد سام غير معكوس % 19(@)(@@) % هل من حلوم لأقوام فتنذرهم % ما جرب الناس من عضى وتضريسي % % 20(@)(@@) % إني جعلت فما ترجى مقاسرتي % % نكلا لمستعصب الشيطان عتريس % PageV01P321 21(@)(@@) % أحمي مواسم تشفي كل ذي خطل % مستوضع بلبنان الجن مسلوس % 22(@)(@@) % من يتبع غير متبوع فإن لنا ، % في ابني نزار نصيبا غير مخسوس % 23(@)(@@) % وابنا نزار أحلاني بمنزلة % في رأس أرعن عادي القداميس % 24(@)(@@) % إني امرؤ من نزار في أرومتهم % مستحصد أجمى فيهم وعريسي % % 25(@)(@@) % لا تفخرن على قوم عرفت لهم % نور الهدى وعرين العز ذي الخيس % 26(@)(@@) % قوم لهم خص إبراهيم دعوته % إذ يرفع البيت سورا فوق تأسيس % % 27(@)(@@) % نحن الذين ضربنا الناس عن عرض % حتى استقاموا وهم أتباع إبليس % 28(@)(@@) % أقصر فإن نزارا لن يفاضلها % % فرع لئيم وأصل غير مغروس % 29(@)(@@) % قد جربت عركي في كل معترك % غلب الأسود فما بال الضغابيس % 30(@)(@@) % يلفى الزلازل أقوام دلفت لهم % بالمنجنيق وصكا بالملاطيس % PageV01P322 31(@)(@@) % لما جمعت غواة الناس في قرن ، % غادرتهم بين محسور ومفروس % 32(@)(@@) % كانوا كهاو ورد من حالقى جبل % ومغرق في عباب البحر مغموس % 33(@)(@@) % خيلي التي وردت نجران ثم ثنت % يوم الكلاب بورد غير محبوس % 34(@)(@@) % قد أفعمت واديي نجران معلمة % بالدارعين وبالخيل الكراديس % 35(@)(@@) % قد نكتسي بزة الجبار نجنبه % و البيض نضربه فوق القوانيس % 36(@)(@@) % نحن الذين هزمنا جيش ذي نجب % والمنذرين اقتسرنا يوم قابوس % 37(@)(@@) % تدعوك تيم وتيم في قرى سبأ % قد عض أعناقهم جلد الجواميس % 38(@)(@@) % و التيم ألأم من يمشي وألأمهم % أو لاد ذهل بنو السود المدانيس % 39(@)(@@) % تدعى لشر أب يا مرفقي جعل ، % في الصيف يدخل بيتا غير مكنوس % PageV01P323 البحر : رجز تام 1(@)(@@) % إن تضرساني تجدا مضرسا % % قد لبس الدهر وأبقى ملبسا % % 2(@)(@@) % خلقت شكسا للأعادي مشكسا % % أكوى الأسرين وأقطع 
ms93	 النسا % % 3(@)(@@) % من شاء من حر الجحيم استقبسا % % PageV01P324 البحر : طويل 1(@)(@@) % ما ذات أرواق تصدى لجؤذر % بحيث تلاقى عازب فالأواعس % 2(@)(@@) % بأحسن منها يوم قالت : ألا ترى % % لمن حولنا فيهم غيور ونافس % 3(@)(@@) % تر ثم شربا باردا لا يناله ، % على هوله ، إلا رد أو مخالس % 4(@)(@@) % بني مالك لا يردكم حين قينكم % فيقبسكم من حر ناري قابس % 5(@)(@@) % و إياكم والقين لا يشأمنكم % كما كان مشوؤما لذبيان داحس % 6(@)(@@) % بني مالك فات الفرزدق مجدنا % % و مات ابن ليلى وهو من ذاك يائش % 7(@)(@@) % فما زال معقولا عقال عن العلى % % ومازال محبوسا عن المجد حابس % PageV01P325 البحر : طويل 1(@)(@@) % غذا ذكرت نفسي شريكا تقطعت % على مضر حي للمقامة رائس % 2(@)(@@) % و كان أخا المولى إذا خاف عثرة % شريك ، وخصم الأصيد المتشاوس % 3(@)(@@) % فما كان أبلانا من الدهر نبوة % لدى الباب أو عض السنين الأحامس % 4(@)(@@) % لقد غادروا بالعيص علق مضنة ، % و لم تر عيني مثله علق لابس % 5(@)(@@) % وقالو : ألا تبكي تميم أخاهم % أبا الصلت زين الوفد سم الفوارس % PageV01P326 البحر : بسيط تام 1(@)(@@) % أبلغ أبا هرمز عني مغلغلة % و ابني حدية صعرورا وفرناس % 2(@)(@@) % ما كنت أول ضاغ صكه حجر % ألوت به منجنيق ذات أمراس % 3(@)(@@) % أبعت بيتك إذ عضتك مجحفة % من السنين عوان ذات أضراس % PageV01P327 البحر : طويل 1(@)(@@) % ألا حي أطلال الرسوم الدوارس % وآري أمهار ، وموقد قابس % 2(@)(@@) % لقد خبرتني النفس أني مزايل % شبابي ووصل المنفسات الأوانس % 3(@)(@@) % وأصبحت من هند على قرب دارها % % أخا اليأس أوراج قلبلا كآيس % 4(@)(@@) % و طامحة العينين مطروفة الهوى % % عن الزوج أو منسوبة الحال عانس % 5(@)(@@) % بني عاصم أوفوا بذمة جاركم ، % و لم تضربوا منها برطب ويابس % 6(@)(@@) % إذا ما دعا جنباء قال ابن ديسق : % لعالك فيها عاليا غير تاعس % 7(@)(@@) % جرت لأخي كلب غداة تأبست % عبيد برد البزل منها القناعس % 8(@)(@@) % ألا إن حمادا سيوفي بذمة % عليك ورد الأبلخ المتشاوس % 9(@)(@@) % ألستم لئاما إذ ترومون جاركم % و لولاهم لم تدفعوا كف لامس % 10(@)(@@) % فإنك 
ms94	 لاق للأغر ابن ديسق % فوارس سلابين بز الفوارس % PageV01P328 11(@)(@@) % فلا أعرفن الخيل تعدو عليكم % فتطعن في ذي جوشن متقاعس % 12(@)(@@) % إذا اطردوا لم يخف داء ظهورهم % على ما بنا من نحضها المتكاوس % PageV01P329 البحر : كامل تام 1(@)(@@) % أبلغ رياحا مردها وكهولها % % عني وعمم فيهم وتخصص % 2(@)(@@) % إني أهاب ، وما أراني فاعلا ، % رهط ابن وقاص ورهط الأخوص % 3(@)(@@) % لولا الذي عهدت إلي سراتهم % لجهدت جهد بديهة ابن الأخوص % PageV01P330 البحر : كامل تام 1(@)(@@) % ولقد رحلت إليكم عيدية % لا يرعوين إلى جنين مجهض % % 2(@)(@@) % أصبحن من نقوى حفير دلحا % بلوى أشيقر جائلات الأعرض % 3(@)(@@) % ولقد علون من السماوة معلما % خلجا موارده بعيد المركض % 4(@)(@@) % وإذا الأدلة خاطروا مجهولها ، % مشقوا ليالي خمسها المستوفض % 5(@)(@@) % يسرون ليلهم فلما غوروا % % خفق الخباء بمنزل لم يخفض % 6(@)(@@) % جعلوا القسيي من السراء عماده % وبكل أبيض في الغماد مفضض % 7(@)(@@) % وإذا قربن خوامسا من صلصل ، % صبحن دومة والحصى لم يرمض % 8(@)(@@) % إني لمعتمد الخليفة زائرا ، % وأراه أهل زيارتي وتعرضي % % 9(@)(@@) % ليس البري كمن يمرض قلبه % فأنا المشايع ، قلبه لم يمرض % 10(@)(@@) % فوثقت ، ما سلم الخليفة ، بالغنى ، % ليس البحور إلى الثماد البرض % PageV01P331 11(@)(@@) % بحر تفيض له سجال بالندى ، % وإليه جارية البحور الفيض % 12(@)(@@) % يجزيك ربك حسن قرضك إنه % حسن المعونة ، واسع المتقرض % 13(@)(@@) % و الله قدر أن تكون خليفة % خير البرية ، وارتضاك المرتصي % % 14(@)(@@) % يا ابن الفوارع ، والتقت أعياصه % لفا بمتسع البطاح الأعرض % 15(@)(@@) % أعطاك ربك من جظيل عطائه % ملكا كعوب قناته لم ترفض % 16(@)(@@) % هل يزجرني أن أقول لظالم % إن كنت صاحب خلة فتحمض % 17(@)(@@) % و إذا أمية حصلت أنسابها % % كنت المجان من الصريح الأمخض % PageV01P332 البحر : وافر تام 1(@)(@@) % ما أرضى بنصح بني كليب % و ما أنا عن عريفهم براضي % % 2(@)(@@) % و ما أنسى ضيعهم بحجر % وبالقصبات محبسهم مخاضي % % 3(@)(@@) % ولو شاء الأطبة أخبروني % % بداء في قلوبهم المراض % 4(@)(@@) % و كم دافعت من خطل ظلوم % وأشوس في الحكومة ذي اعتراض % 5(@)(@@) % شديد من ورائهم ضريري ، % بطيء بعد مرتي انتفاضي % % PageV01P333 البحر 
ms95	 : رجز تام 1(@)(@@) % إن سليطا كأسمها سليط % لولا بنو عمرو وعمر عيط % 2(@)(@@) % قلت ديافيون أو نبيط % % PageV01P334 البحر : طويل 1(@)(@@) % أقمنا وربتنا الديار ، ولا أرى % % كمربعنا بين الحنيين مربعا % % 2(@)(@@) % ألا حب بالوادي الذي ربما نرى % % به من جميع الحي مرأى ومسمعا % % 3(@)(@@) % ألا لا تلوما القلب أن يتخشعا ، % فقد هاجت الأحزان قلبا مفزعا % 4(@)(@@) % وجودا لهند بالكرامة منكما ، % وما شئتما أن تمنعا بعد فامنعا % % 5(@)(@@) % وما حفلت هند تعرض حاجتي % % ولا نوم عيني الغشاش المروعا % % 6(@)(@@) % بعيني من جار على غربة النوى % % أراد بسلمانين بينا فودعا % % 7(@)(@@) % لعلك في شك من البين بعدما % % رأيت الحمام الورق في الدار وقعا % % 8(@)(@@) % كأن غماما في الخدور التي غدت % دنا ثم هزته الصبا فترفعا % % 9(@)(@@) % فليت ركاب الحي يوم تحملوا % % بحومانة الدراج أصبحن ظلعا % % 10(@)(@@) % بني مالك إن الفرزدق لم يزل % % فلو المخازي من لدن أن تيفعا % % PageV01P335 11(@)(@@) % رميت ابن ذي الكيرين حتى تركته % قعود القوافي ذا علوب موقعا % % 12(@)(@@) % وفقأت عيني غالب عند كيره % وأقلعت عن أنف الفرزدق أجدعا % % 13(@)(@@) % مددت له الغايات حتى نخسته % جريح الذنابى فاني السن مقطعا % % 14(@)(@@) % ضغا قردكم لما اختطفت فؤاده ، % ولابن وثيل كان خدك أضرعا % % 15(@)(@@) % وما غر أولاد القيون مجاشعا % بذي صولة يحمى العرين الممنعا % % 16(@)(@@) % ويا ليت شعري ما تقول مجاشع % و لم تترك كفاك في الفوس منزعا % % 17(@)(@@) % وأية أحلام رددن مجاشعا ، % يعلون ذيفانا من السم منقعا % % 18(@)(@@) % ألا ربما بات الفرزدق قائما % على حر نار تترك الوجه أسفعا % % 19(@)(@@) % و كان المخازي طالما نزلت به % فيصبح منها قاصر الطرف أخضعا % % 20(@)(@@) % و إن ذياد الليل لا تستطيعه % و لا الصبح حتى يستنير فيسطعا % % PageV01P336 21(@)(@@) % تركت لك القينين قيني مجاشع % ولا يأخذان النصف شتى ولا معا % % 22(@)(@@) % و قد وجداني حين مدت حبالنا % % أشد محاماة ، وأبعد منزعا % % 23(@)(@@) % و إني أخو الحرب التي يصطلى بها % % إذا حملته فوق حال تشنعا % % 24(@)(@@) % و أدركت من قد كان قبلي ولم أدع % لمن كان بعدي 
ms96	 في القصائد مصنعا % % 25(@)(@@) % تفجع بسطام وخبره الصدى % % وما يمنع الأصداء ألا تفجعا % % 27(@)(@@) % سيترك زيق صهر آل مجاشع % ويمنع زيق ما أراد ليمنعا % % 28(@)(@@) % أتعدل مسعودا وقيسا وخالدا % بأقيان ليلى لا ترى لك مقنعا % % 29(@)(@@) % و لما غررتم من أناس كريمة % لؤمتم وضقتم بالكرائم أذرعا % % 30(@)(@@) % فلو لم تلاقوا قوم حدراء قومها % % لو سدها كير القيون المرقعا % % 31(@)(@@) % رأى القين أختان الشناءة قد جنوا % % من الحرب جرباء المساعر سلفعا % % PageV01P337 32(@)(@@) % وإنك لو راجعت شيبان بعدها % % لأبت بمصاوم الخياشم أجدعا % % 33(@)(@@) % إذا فوزت عن نهر بين تقادفت % % بحدراء دار لا تريد لتجمعا % % 34(@)(@@) % و اضحت ركاب القين من خيبة السرى % % و نقل حديد القين حسرى وظلعا % % 35(@)(@@) % وحدراء لو لم ينجها الله برزت % إلى شر ذي حرث دمالا ومزرعا % % 36(@)(@@) % و قد كان نجسا طهرت من جماعه % و آب إلى شر المضاجع مضجعا % % 40(@)(@@) % حميدة كانت للفرزدق جارة % ينادم حوطا عندها والمقطعا % % 41(@)(@@) % سأذكر ما لم تذكروا عند منقر % وأثني بعار من حميدة أشنعا % % 45(@)(@@) % تلاقي ليربوع إياد أرومة ، % % 52(@)(@@) % دعاكم حواري الرسول فكنتم % عضاريط يا خشب الخلاف المصرعا % % 54(@)(@@) % أغرك جار ضل قائم سيفه ، % فلا رجع الكفين إلا مكنعا % % PageV01P338 55(@)(@@) % و آب ابن ذيال جميعا وأنتم % تعدون غنما رحله المتمزعا % % 56(@)(@@) % فلا تدع جارا من عقال ترى له % ضواغط يلثقن الازار وأضرعا % % 57(@)(@@) % فلا قين شر من أبي القين منزلا % ولا لؤم إلا دون لؤمك ، صعصعا % % 58(@)(@@) % تعدون عقر النيب أفضل سعيكم % بنى ضوطري هلا الكمي المقنعا % % 59(@)(@@) % وتبكي على ما فات قبلك دارما ، % وإن تبك لا تترك بعينك مدمعا % % 60(@)(@@) % لعمرك ما كانت حماة مجاشع % كراما ولا حكام ضبة مقنعا % % 61(@)(@@) % أتعدل يربوعا خناثى مجاشع % إذا هز بالأيدي القنا ، فتزعزعا % % 63(@)(@@) % وجدت ليربوع ، إذا ما عجمتهم ، % منابت نبع لم يخالطن خروعا % % 64(@)(@@) % هم القوم لو بات الزبير إليهم % لما بات مفلولا ولا متطلعا % % 65(@)(@@) % وقد علم الأقوام أن سيوفنا % % عجمن حديد البيض حتى تصدعا % % PageV01P339 66(@)(@@) % ألا رب جبار 
ms97	 عليه مهابة ، % سقيناه كأس الموت حتى تضلعا % % 67(@)(@@) % نقود جيادا لم تقدها مجاشع % تكون من الأعداء مرأى ومسمعا % % 68(@)(@@) % تداركن بسطاما فأنزل في الوغى % % عناقا ومال السرج حتى تقعقعا % % 69(@)(@@) % دعا هانىء بكرا وقد عض هانئا % عرى الكبل فينا الصيف والمتربعا % % 70(@)(@@) % ونحن خضبنا لابن كبشة تاجه % ولاقى امرأ في ضمة الخيل مصقعا % % 71(@)(@@) % و قابوس أعضضنا الحديد ابن منذر % و حسان إذ لا يدفع الدل مدفعا % % 72(@)(@@) % و قد جعلت يوما بطخفة خيلنا % % مجرا لذي التاج الهمام ومصرعا % % 73(@)(@@) % و قد جرب الهرماس أن سيوفنا % % عضضن برأس الكبش حتى تصدعا % % 74(@)(@@) % و نحن تداركنا بحيرا وقد حوى % % نهاب العنابين الخميس ليربعا % % 75(@)(@@) % فعاين بالمروت أمنع معشر % صريخ رياح ، واللواء المزعزعا % % PageV01P340 76(@)(@@) % فوارس لا يدعون يال مجاشع % إذا كان يوما ذا كواكب أشنعا % % 77(@)(@@) % و منا الذي أبلى صدى بن مالك % و نفر طيرا عن جعادة وقعا % % 78(@)(@@) % فدع عنك لوما في جعادة ، إنما % % وصلناه إذ لاقى ابن بيبة أقطعا % % 79(@)(@@) % ضربنا عميد الصمتين فأعولت % دعائم عرش الحي أن يتضعضعا % % 80(@)(@@) % ولو شهدت يوم الوقيطين خيلنا % % لما قاظت الأسرى القطاط ولعلعا % % 81(@)(@@) % ربعنا وأردفنا الملوك فظللوا % % وطاب الأحاليب الثمام المنزعا % % 82(@)(@@) % فتلك مساع لم تنلها شجاشع % سبقت فلا تجزع من الموت مجزعا % % PageV01P341 البحر : كامل تام 1(@)(@@) % بان الخليط برامتين فودعوا ، % أو كلما رفعوا لبين بجزع % 2(@)(@@) % ردو الجمال بذي طلوح بعدما % % هاخ المصيف وقد تولى المربع % 3(@)(@@) % إن الشواحج بالضحى هيجني % % في دار زينب والحمام الوقع % 4(@)(@@) % بعت الغراب فقلت بين عاجل % وجرى به الصرد الغداة الألمع % 5(@)(@@) % إن الجميع تفرقت أهواؤهم % إن النوى بهوى الأحبة تفجع % % 6(@)(@@) % كيف العزاء ولم أجد مذ بنتم % قلبا يقر ولا شرابا ينقع % % 7(@)(@@) % و لقد صدقتك في الهوى وكذبتني % % وخلبتني بمواعد لا تنفع % 8(@)(@@) % قد خفت عندكم الوشاة ولم يكن % لينال عندي سرك المستودع % 9(@)(@@) % كانت إذا نظرت لعيد زينة % هش الفؤاد وليس فيها مطمع % 10(@)(@@) % تركت حوائم صاديات هيما ، % منع الشفاء وطاب 
ms98	 هذا المشرع % PageV01P342 11(@)(@@) % أيام زينب لا خفيف حلمها % % همشى الحديث ، ولا رواد سلفع % 12(@)(@@) % بان الشباب حميدة أيامه ، % ولو ان ذلك يشترى أو يرجع % 13(@)(@@) % رجف العظام من لبيلى وتقادمت % سني ، وفي لمصلح مستمتع % 14(@)(@@) % و تقول بوزع قد دببت على العصا % % هلا هزئت بغيرنا يا بوزع % 15(@)(@@) % ولقد رأيتك في العذارى مرة ، % و رأيت رأسي وهو داج أفرع % % 16(@)(@@) % كيف الزيارة والمخاوف دونكم ، % و لكم أمير شناءة لا يربع % % 17(@)(@@) % يا أثل كابة لا حرمت ثرى الندا % % هل رام بعدي ساجر فالأجرع % % 18(@)(@@) % و سقى الغمام منيزلا بعنيزة % إما تصاف جدا ، وإما تربع % 19(@)(@@) % حيوا الديار وسائلوا أطلالها % % هل ترجع الخبر الديار البلقع % % 20(@)(@@) % و لقد حبست صحبي الدموع كأنها % % سح الرذاذ على الرداء استرجعوا % % PageV01P343 21(@)(@@) % قالوا تعز فقلت لست بكائن % مني العزاء وصدع قلبي يقرع % 22(@)(@@) % فسقاك حيث حللت غير فقيدة % % 23(@)(@@) % هل تذكرين زماننا بعنيزة % و الأبرقين وذاك مالا يرجع % % 24(@)(@@) % إن الأعادي قد لقوا لي هضبة % تني معاولهم إذا ما تقرع % 25(@)(@@) % ما كنت أقذف من عشيرة ظالم % إلا تركت صفاهم يتصدع % 26(@)(@@) % أعددت للشعرائ كأسا مرة % عندي ، مخالطها السمام المنقع % 27(@)(@@) % هلا نهاهم تسعة قتلتهم ، % أو أربعون حدوتهم فاستجمعوا % % 29(@)(@@) % كانوا كمشتركين لما بايعوا % % خسروا وشف عليهم فاستوضعوا % % 30(@)(@@) % أفينتهون وقد قضيت قضلءهم % أم يصطلون حريق نار تسفع % 31(@)(@@) % ذاق الفرزدق والأخيطل حرها % % والبارقي ، وذاق منها البلتع % PageV01P344 32(@)(@@) % و لقد قسمت لذي الرقاع هدية % و تركت فيه وهية لا ترقع % 33(@)(@@) % و لقد صككت بني الفدوكس صكة % فلقوا كمل لقي القريد الأصلع % % 34(@)(@@) % و هن الفرزدق يوم جرب سيفه % قين به حمم وآم أربع % 35(@)(@@) % أخزيت قومك في مقام قمته % أيام طخفة والسروج تقعقع % 36(@)(@@) % لا يعجبنك أن ترى لمجاشع % جلد الرجال ففي القلوب الخولع % % 37(@)(@@) % و يريب من رجع الفراسة فيهم % رهل الطفاطف والعظام تخرع % 39(@)(@@) % إنا لنعرف من نجار مجاشع % هد الحفيف كما يحف الخروع % 40(@)(@@) % أيفا يشون وقد رأوا حفائهم % قد عضه 
ms99	 فقضى عليه الأشجع % 41(@)(@@) % % لو حل جاركم إلي منعته % 42(@)(@@) % أجحفتم جحف الخزير ونمتم % وبنو صفية ليلهم لا يهجع % PageV01P345 43(@)(@@) % وضع الخزير فقيل : أين مجاشع ؟ % فشحا جحافله جراف هبلع % 44(@)(@@) % و مجاشع قصب هوت أجوافه % غروا الزبير فأي جار ضيعوا % % 45(@)(@@) % إن الرزية من تضمن قبره % وادي السباع ، لكل جنب مصرع % 46(@)(@@) % لما أتى خبر الزبير تواضعت % سور المدينة والجبال الخشع % % 47(@)(@@) % وبكى الزبير بناته في مأتم ، % ماذا يرد بكاء من لا يسمع % 48(@)(@@) % قال النوائح من قريش : إنما % % غذر الحتاة ولين والأقرع % % 49(@)(@@) % ترك الزبير ، على منى لمجاشع ، % سوء الثناء إذا تقضى المجمع % 50(@)(@@) % قتل الأجارب يا فرزدق جاركم % % فكلوا مزاود جاركم فتمتعوا % % 51(@)(@@) % أحباريات شقائق مولية % بالصيف صعصعهن باز أسفع % 52(@)(@@) % % بالخيل تنحط والقنا يتزعزع % PageV01P346 53(@)(@@) % لحمى فوارس يحسرون دروعهم % هزج الرواح ، وديمة لا تقلع % 54(@)(@@) % فاسأل معاقل بالمدينة عندهم % نور الحكومة والقضاء المقنع % 55(@)(@@) % من كان يذكر ما يقال ضحى غد % عند الأسنة ، والنفوس تطلع % 56(@)(@@) % كذب الفرزدق ، إن قومي قبلهم % ذادوا العدو عن الحمى فاستو سعوا % % 57(@)(@@) % منعوا الثغور بعارض ذي كوكب ، % لولا تقدمنا لضاق المطلع % % 58(@)(@@) % إن الفوارس يا فرزددق قد حموا % % حسبا أشم ونبعة لا تقطع % % 59(@)(@@) % عمدا عمدت لما يسوء مجاشعا ، % و أقول ما لعلمت تميم فاسمعوا % % 60(@)(@@) % لا تتبع النخبات يوم عظيمة % بلغت عزائمه ، ولكن تتبع % 61(@)(@@) % هلا سألت بني تميم : أينا % % يحمي الذمار ، ويستجار فيمنع % 62(@)(@@) % من كان يستلب الجبابر تاجهم % ويضر ، إذ رفع الحديث ، وينفع % PageV01P347 63(@)(@@) % أيفايشون ولم تزن أيامهم % أيامنا ، ولنا اليفاع الأرفع % 64(@)(@@) % منا الفوارس قد علمت ورائس % تهدى قنابله عقاب تلمع % % 65(@)(@@) % و لنا عليك إذا الجباة تفارطوا % % جاب له مدد وحوض مترع % 66(@)(@@) % هلا عددت فوارسا كفوارسي ، % يوم ابن كبشة في الحديد مقنع % 67(@)(@@) % خضبوا الأسنة والأعنة إنهم % نالوا مكارم لم ينلها تبع % 68(@)(@@) % وابن الرباب بذات كهف قارعوا % % إذ فض بيضته حسام مصدع % 69(@)(@@) % و اسنزلوا حسان وابني منذر % % أيام طخفة والسروج نقعقع % % 70(@)(@@) % تلك 
ms100	 المكارم لم تجد أيامها % % لمجاشع فقفوا ثعالة فارضعوا % % 71(@)(@@) % لا تظمأون وفي نحيح عمكم % مروى ، وعند بني سويد مشبع % 72(@)(@@) % نزف العروق إذا رضعتم عمكم % أنف به خثم ولحي مقنع % PageV01P348 73(@)(@@) % قتل الخيار بنو المهلب عنوة % فخذوا القلائد بعده وتقنعوا % % 74(@)(@@) % وطيء الخيار ولا تخاف مجاشع % حتى تحطم في حشاه الأضلع % 75(@)(@@) % و دعا الخيار بني عقال دعوة % جزعا وليس غلى عقال مجزع % % 76(@)(@@) % لو كان فاعترفوا وكيع منكم % فزعت عمان فما لكم لم تفزعوا % % 77(@)(@@) % هتف الخيار غداة أدرك روحه % بمجاش ع وأخو حتات يسمع % % 78(@)(@@) % لا يفزعن بنو المهلب ، إنه % لا يدرك الترة الذليل الأخضع % 79(@)(@@) % هذا كما تركوا مزادا مسلما ، % فكأنما ذبح الخروف الأبقع % % 80(@)(@@) % زعم الفرزدق أن سيقتل مربعا ؛ % أبشر بطول سلامة يا مربع % 81(@)(@@) % إن الفرزدق قد تبين لؤمه % حيث التقت حششاؤه والأخدع % % 82(@)(@@) % حوق الحمار أبوك فاعلم علمه % و نفاك صعصعة الدعي المسبع % PageV01P349 83(@)(@@) % و زعمت أمكم حصانا حرة % كذبا ، قفيرة أمكم والقوبع % 84(@)(@@) % وبنو قفيرة قد أجابوا نهشلا % باسم العبودة قبل أن يتصعصعوا % % 85(@)(@@) % هذي الصحيفة من قفيرة فاقرأوا % % عنوانها ، وبشر طين تطبع % 86(@)(@@) % كانت قفيرة بالقعود مربة % تبكي إذا أخذ الفصيل الروبع % % 89(@)(@@) % إلا السلام ووكف عين تدمع % % 90(@)(@@) % بئس الفوارس يا نوار مجاشع % خور إذا أكلوا خزيرا ضفدعوا % % 91(@)(@@) % يغدون قد نفخ الخزير بطونهم % رغدا وضيف بني عقال يخفع % 92(@)(@@) % أين الذين بسيف عمرو قتلوا ؛ % أم أين أسعد فيكم المسترضع % 93(@)(@@) % حربتم عمرا فلما استوقدت % نار الحروب بغرب لم تمنعوا % % 94(@)(@@) % و بأبرقي ضحيان لاقوا خزية % تلك المذلة والرقاب الخضع % PageV01P350 95(@)(@@) % خور لهم زبد إذا ما استأمنوا % % وإذا تتابع في الزمان الأمرع % 96(@)(@@) % هل تعرفون على ثنيه أقرن % أنس الفوارس يوم شك الأسلع % 97(@)(@@) % و زعمت ويل أبيك أن مجاشعا % لو يسمعون دعاء عمرو ورعوا % % 101(@)(@@) % هلا غضبت على قروم مقاعس % إذ عجلوا لكم الهوان فأسرعوا % % 115(@)(@@) % سعد بن زيدمناة عز فاضل % جمع السعود وكل خير يجمع % 116(@)(@@) % يكفي بني سعد 