ms7761	 ( نهى النبي عن بيع الثمرة حتى يبدو صلاحها ، وعن السنبل حتى يبيض ، وعن البسر حتى يزهو ) ( عب ) . )(@)(@@)(@@)(@@) $ 19857 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( أمرع النبي بجزور فنحرت ، فانتهب الناس لحمها ، فبعث للناس مناديا يقول : إن الله ورسوله ينهيانكم عن النهبة ، فردوه فقسمه بينهم ) ( د ، عب ) . )(@)(@@)(@@)(@@) $ 19858 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كتب لنوح من كل شيء اثنان ، أو قال : زوجان ، فأخذ ما كتب له ، فضلت عليه حبلتان فجعل يلتمسهما ، فلقيه ملك ، فقال : ما تبغي ؟ قال : حبلتين ، قال : إن الشيطان ذهب بهما ، قال الملك : أنا آتيك به وبهما ، قال له : إن لك فيهما شريك قال الملك : أنا شريك فأحسن مشاركته ، قال : لي الثلث وله الثلثان ، قال الملك : أحسنت ، وأنت محسان إن لك أن تأكل عنبا وزبيبا وخلا تطبخه حتى يذهب ثلثاه ويبقى الثلث ، قال ابن سيرين : فوافق ذلك كتاب عمر بن الخطاب رضي الله عنه ) ( عب ) . )(@)(@@)(@@)(@@) $ 19859 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 كانوا يحبون أن ينصرفوا من صلاة الصبح وأحدهم يرى مواقع نبله ) ( ص ، وسيمويه ، والبغوي ، ط ) . )(@)(@@)(@@)(@@) $ 19860 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( لم أعلم من التطوع شيئا كان أعز عليهم أن يتركوا من الوتر ، والركعتين قبل صلاة الفجر ، وكانوا يحبون ما أخروا من الوتر وهو من الليل ، كانوا يحبون أن يبكروا بالركعتين قبل صلاة الصبح وهما من النهار ) ( ابن جرير ، عب ) . )(@)(@@)(@@)(@@) $ 19861 حدثنا هشيم ، أنبأنا منصور ، عن ابن سيرين ، وأنبأنا خالد بن PageV21P418 حفصة ، عن أبي العلاء قال :(@)(@@) | 30 ( بينا النبي يصلي إذ أقبل رجل في بصره سوء ، فمر على بئر عليها خصفة فوقع في البئر ، فضحك بعض أصحاب رسول الله ، فلما قضى النبي صلاته ، قال : من كان منكم ضحك فليعد الوضوء ، وليعد الصلاة ) ( عب ) . )(@)(@@)(@@)(@@) $ 19862 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يرف بصره إلى السماء وهو يصلي ، فأمر بالخشوع ، فرمى ببصره نحو مسجده ) ( عب ) . )(@)(@@)(@@)(@@) $ 19863 عن ابن سيرين رضي الله عنه 
ms7762	 قال :(@)(@@) | 30 ( كان رسول الله يرفع بصره إلى السماء وهو يصلي ، حتى أنزل الله تعالى : { الذين هم في صلاتهم خاشعون } ، أو غيرها ، فإن لم تكن تلك ، فلا أدري ما هي ، فصوب برأسه ) ( عب ) . )(@)(@@)(@@)(@@) $ 19864 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كان الرجل إذا لم يصبر أن ينظر كذا وكذا يؤمر أن يغمض عينيه ) ( عب ) . )(@)(@@)(@@)(@@) $ 19865 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كان المؤذنون يجعلون أصابعهم في آذانهم ، وأول من وضع إحدى يديه عند أذنيه ابن الأصم مؤذن الحجاج ) ( ض ) . )(@)(@@)(@@)(@@) $ 19866 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( إن رسول الله كان إذا سلم عليه وهو في القوم ، قالوا : السلام عليكم ، وإذا كان وحده قالوا : السلام عليك ي اا رسول الله ) ( كر ) . )(@)(@@)(@@)(@@) $ 19867 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( نبئت أن النبي كانت ترجله الحائض ويقول : إن حيضتها ليست في يدها ) ( ش ) . )(@)(@@) PageV21P419(@)(@@)(@@)(@@) $ 19868 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كانوا يكرهون أن يستقبلوا واحدة من القبلتين ) ( ص ) . )(@)(@@)(@@)(@@) $ 19869 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( عاهد حي ي بن أخطب رسول الله أن لا يظاهر عليه أحدا ، وجعل الله تعالى عليه كفيلا ، فلما كان يوم قريظة أتي به وبابنه سلما ، فقال النبي : لم توف العهد ، فأمر به ، فضربت عنقه وعنق ابنه ) ( ش ) . )(@)(@@)(@@)(@@) $ 19870 عن معمر ، عن أيوب ، عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن رجلا من الأنصار وسع لرجل من المهاجرين في داره ، ثم إن الأنصاري احتاج إلى داره ، فجحده المهاجري ، فاختصما إلى النبي ، ولم يكن للأنصاري بينة ، فحلف المهاجري ، ثم إن الأنصاري حضره الموت ، فقال لبنيه : إنه رضي بها من الله ، وإني رضيت بالله منها ، وإنه سيندم فيردها عليكم فلا تقبلوها ، فلما توفي الأنصاري ندم المهاجري ، فجاء إلى بني الأنصاري فقال : اقبلوا داركم فأبوا ، فذكر ذلك للنبي ، فذكروا أن أباهم أمرهم أن لا يقبلوها ، فقال النبي : أتستطيع أن تحملها من سبع أرضين ، ولم يأمر ولد الأنصاري أن 
ms7763	 يقبضوها ) . )(@)(@@)(@@)(@@) $ 19871 عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن النبي أطعمم جدة مع ابنها السدس ، وكانت أول جدة ورثت في الإسلام ) ( ش ، عب ) . )(@)(@@)(@@)(@@) $ 19872 عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن سيرين قال : ( نبئت أن أول جدة أطعمت السدس أم أب مع ابنها ) ( ص ) . )(@)(@@)(@@)(@@) $ 19873 عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن رسول الله أطعم جدة السدس وكانت من خزاعة ) ( ص ) . )(@)(@@)(@@)(@@) $ 19874 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( بلغني أن الشام لا تزال PageV21P420 موائمة حتى يكون بدؤها من الشام ) ( ش ) . )(@)(@@)(@@)(@@) $ 19875 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كنا نتحدث أن تكون ردة شديدة حتى يرجع ناس من العرب يعبدون الأصنام بذي الخلصة ) ( ش ) . )(@)(@@)(@@)(@@) $ 19876 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( لم يختلف في الأهلة حتى قتل عثمان رضي الله عنه ) ( كر ) . )(@)(@@)(@@)(@@) $ 19877 عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن عمر بن الخطاب كان تصدق بفرس أو حمل عليها ، فوجد بعض نتاجها يباع ، فسأل النبي : أشتريه ؟ فقال النبي : دعها حتى تلقاها وولدها ) ( عب ) . )(@)(@@)(@@)(@@) $ 19878 عن ابن سيرين رضي الله عنه :(@)(@@) | 30 ( أن رجلا نذر : كلما ولد له ولد حتى يحلب ويصر فيشرب ويسقي أباه إلا حج وحج به ، قال : ففعل ذلك بأولاده ، ثم ولد له ولد ، فبلغ حتى حلب وصر وشرب وسقى أباه ، فمات أبوه قبل أن يحج به ، فسأل النبي ، فقال : حج عن أبيك ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 19879 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( جاء بشير بن سعد بابنه النعمان إلى النبي ليشهده على نحل نحله إياه ، فقال النبي : أكل بنيك نحلت مثل ه اذا ؟ فقال : لا ، فقال النبي : قاربوا بين أولادكم ، وأبى أن يشهد ) ( عب ) . )(@)(@@)(@@)(@@) $ 19880 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( كان أهل الصفة إذا أمسوا ، انطلق الرجل بالرجل ، والرجل بالرجلين ، والرجل بالجماعة ، فأما سعد بن عبادة رضي الله عنه فكان ينطلق بثمانين كل ليلة يعشيهم ) ( ابن أبي الدنيا ، كر ، عب ) . )(@)(@@)(@@)(@@) $ 19881 عن محمد بن 
ms7764	 سيرين رضي الله عنه قال :(@)(@@) | 30 ( بلغني أن سعد بن عبادة رضي الله عنه قال : ( ي اا رسول الله إن أم سعد في حياتها كانت تحج من مالي ، PageV21P421 وتصدق ، وتصل الرحم ، وتنفق من مالي ، وإنها قد مات ت ، فهل ينفعها أن أفعل ذلك عنها ؟ قال : نعم ) ابن جرير . )(@)(@@)(@@)(@@) $ 19882 عن محمد بن سيرين ، عن أنس رضي الله عنه قال :(@)(@@) | 30 ( شهدت عبيد الله بن زياد وأتي برأس الحسين رضي الله عنه فجعل ينكت بقضيب في يده ، فقلت : أما إنه كان أشبههم برسول الله ) ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 19883 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( لم تر ه اذه الحمرة التي في آفاق االسماء حتى قتل الحسين بن علي رضي الله عنه ، ولم يفقدوا الخيل البلق في المغازي والجيوش حتى قتل عثمان رضي الله عنه ) ( كر ) . )(@)(@@)(@@)(@@) $ 19884 عن محمد بن سيرين رضي الله عنه قال :(@)(@@) | 30 ( نظر النبي إلى الحسين بن علي رضي الله عنه فقال : ي اا بني اللهم سلمه وسلم منه ) ( كر ) . )(@)(@@)(@@)(@@) $ 19885 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( أقعص أبا جهل ابنا عفراء ، وذفف عليه ابن مسعود رضي الله عنه ) ( ش ) . )(@)(@@)(@@)(@@) $ 19886 عن محمد بن سيرين قال :(@)(@@) | 30 ( نبئت أن النبي رأى حذيفة رضي الله عنه فراغ عنه ، فقال : لم لم أرك ؟ فعقال : بلى ي اا رسول الله ول اكن كنت جنبا ، فقال : إن المؤمن لا ينجس ) ( ص ) . )(@)(@@)(@@)(@@) $ 19887 عن ابن سيرين قال :(@)(@@) | 30 ( جاء رجل إلى ابن مسعود رضي الله عنه فقال : إن رجلا رهنني فرسا فركبتها ، قال : ما أصبت من ظهرها فهو ربا ) ( عب ) . )(@)(@@)(@@)(@@) $ 19888 عن ابن سيرين رضي الله عنه قال :(@)(@@) | 30 ( قال علي رضي الله عنه : لو أتيت به لرجمته ، يعني : الذي يقع على جارية امرأته ، وأما ابن مسعود رضي الله عنه : فلا يدري ما أحدث بعده ) ( عب ، هق ، ه ) . )(@)PageV21P422(@)(@@)(@@)(@@) |||| 726 ( مراسيل محمد بن الحنفية رضي الله عنه )(@)(@@) $(@)(@@)(@@)(@@) $ 19889 عن محمد بن الحنفية رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال له 
ms7765	 : أجد غما لا أعرف له سببا وقد ضاق قلبي ، فقال محمد : عم لم تعرف له سببا ، عقوبة ذنب لم تفعله ، فقال الرجل : ما معنى ذلك ؟ فقال : المعنى في ذلك أن القلب يهم بالمعصية فلا تساعده الجوارح فيعاقب بالغم دون الجوارح ) ( كر ) . )(@)(@@)(@@)(@@) $ 19890 عن محمد بن علي رضي الله عنه قال :(@)(@@) | 30 ( غسل النبي في قميص : وتولى علي سفلته ، والفضل محتضنه ، والعباس يصب الماء ، والفضل يقول : أرحني قطعت وتيني ، إني لأجد شيئا ينزل علي ، قال : وغسل من بئر سعد بن خيثمة بقباء ، وهي البئر التي يقال لها : بئر أريس ) ( ش ) . )(@)(@@)(@@)(@@) $ 19891 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( من أحب رجلا على عدل ظهر منه ، وهو في علم الله من أهل النار ، آجره الله كما لو كان من أهل الجنة ، ومن أبغض رجلا على جور ، وهو في علم الله من أهل الجنة آجره الله كما لو كان من أهل النار ) ( عب ) . )(@)(@@)(@@)(@@) $ 19892 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( من أحب رجلا لله أثابه الله ثواب من أحب رجلا من أهل الجنة وإن كان الذي أحبه من أهل النار لأنه أحبه على خصلة حسنة رآها منه ، ومن أبغض رجلا أثابه الله ثواب من أبغض رجلا من أهل النار وإن كان الذي أبغضه من أهل الجنة ، لأنه أبغضه على خصلة سيئة رآها منه ) ( كر ) . )(@)(@@)(@@)(@@) $ 19893 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( خرج رسول الله من بعض حجره ، فجلس عند بابها ، وكان إذا جلس وحده لم يأته أحد حتى يدعوه ، قال : ادع لي أبا بكر ، فجاء فجلس بين يديه ، فناجاه طويلا ثم أمره فجلس عن يمينه PageV21P423 أو عن يساره ، ثم قال : ادع لي عمر ، فجاء فجلس إلى النبي فناجاه طويلا ، فرفع عمر صوته فقال : ي اا رسول الله هم رأس الكفر ، هم الذين زعموا أنك ساحر ، وأنك كاهن ، وأنك كذاب ، وأنك مفتر ، ولم يدع شيئا مما كان أهل مكة يقولونه إلا ذكره ، فأمره أن يجلس من 
ms7766	 الجانب الآخر ، فجلس أحدهما عن يمينه ، والآخر عن يساره ، ثم دعا الناس فقال : ألا أحدثكم بمثل صاحبيكم ه اذين ؟ قالوا : نعم ي اا رسول الله فأقبل بوجهه إلى أبي بكر رضي الله عنه فقال : إن إبراهيم كان ألين في الله من الدهن في اللبن ، ثم أقبل على عمر رضي الله عنه فقال : إن نوحا كان أشد في الله من الحجر ، وإن الأمر أمر عمر ، فتجهزوا فقاموا فتبعوا أبا بكر ، فقالوا : ي اا أبا بكر إنا كرهنا أن نسأل عمر ، ما ه اذا الذي ناجاك به رسول الله ؟ قال : قال لي : كيف تأمرني في غزو مكة ؟ قلت : ي اا رسول الله هم قومك ، حتى رأيت أنه سيطيعني ، ثم دعا عمر ، فقال عمر : إنهم لرأس الكفر ، حتى ذكر كل سوء كانوا يقولونه ، وايم الله ، لا تذل العرب حتى تذل أهل مكة فأمركم بالجهاز لتعزوا مكة ) ( ش ) . )(@)(@@)(@@)(@@) $ 19894 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( اتقوا ه اذه الفتن فإنها لا يستشرف لها أحد إلا استبقته ، ألا إن ه اؤلاء القوم لهم أجل ومدة ، لو آجتمع من في الأرض أن يزيلوا ملكهم لم يقدروا على ذلك حتى يكون الله تعالى هو الذي يأذن فيه ، أتستطيعون أن تزيلوا ه اذه الجبال ؟ ) ( ش ) . )(@)(@@)(@@)(@@) $ 19895 عن ابن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( دخل عمر بن الخطاب رضي الله عنه وأنا عند أختي أم كلثوم بنت علي رضي الله عنهما فضمني وقال : آلطفيه ي اا كلثوم ) ( كر ) . )(@)(@@)(@@)(@@) $ 19896 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( وقع بين علي وطلحة رضي الله عنهما كلام ، فقال طلحة لعلي : ومن جرأتك أنك سميت باسمه وكنيت بكنيته ، وقد قال : لا يجتمعان وفي لفظ : وقد نهى رسول الله : أن PageV21P424 يجمعهما أحد من أمته بعده فقال علي : إن الجريء من اجترأ على الله ورسوله ، ادعوا لي فلانا وفلانا لنفر من قريش ، فجاؤوا فشهدوا أن رسول الله قال لعلي : إنه سيولد لك بعدي غلام وفي لفظ : ولد نحلته اسمي 
ms7767	 وكنيتي ، ولا يحل لأحد من أمتي بعده ) ( ابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ 19897 عن علي بن الحسين رضي الله عنهما قال :(@)(@@) | 30 ( كتب ملك الروم إلى عبد الملك بن مروان يهدده ويتوعده ويحلف له ليحمل إليه مائة ألف في البر ، ومائة ألف في البحر ، أو يؤدي الجزية ، فسقط في يده ، فكتب إلى الحجاج أن اكتب إلى ابن الحنفية فتهدده وتوعده ، ثم أعلمني ما يرد عليك ، فكتب الحجاج إلى ابن الحنفية رضي الله عنه بكتاب شديد يهدده ويتوعده فيه بالقتل ، فكتب إليه ابن الحنفية : إن لله تعالى ثلاثمائة وستين لحظة إلى خلقه ، وأنا أرجو أن ينظر الله تعالى إلي نظرة يمنعني بها منك ، فبعث الحجاج بكتابه إلى عبد الملك ؛ فكتب عبد الملك إلى ملك الروم بنسخته ، فقال ملك الروم : ما خرج ه اذا منك ، ولا أنت كتبت به ، ما خرج إلا من بيت نبوة ) ( كر ) . )(@)(@@)(@@)(@@) $ 19898 عن ابن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( وقع بين طلحة وبين علي كلام ، فقال لعلي : إنك تسمنى باسمه وتكنى بكنيته وقد نهى رسول الله عن ذلك أن يجمعا لأحد من أمته فقال علي : إن الجريء من اجترأ على الله وعلى رسوله ، ي اا فلان ادع لي فلانا وفلانا فجاء نفر من أصحاب رسول الله من قريش ، فشهدوا أن رسول الله رخص لعلي رضي الله عنه أن يجمعهما وحرمهما على أمته من بعده ) ( كر ) . )(@)(@@)(@@)(@@) $ 19899 عن محمد بن الحنفية رضي الله عنه قال :(@)(@@) | 30 ( قدمت على معاوية بن أبي سفيان ، فسألني عن العمرى ، فقلت : جعلها رسول الله لمن أعطيها ، قال : تقولون ذلك ؟ قلت : نعم ، فإني أشهد أني سمعت رسول الله يقول : من أعمر عمرى فهي له يرثها من عقبه من يرثه ) ( كر ) . )(@)PageV21P425(@)(@@)(@@)(@@) |||| 727 ( مراسيل محمد بن كعب القرظي رضي الله عنه )(@)(@@)(@@)(@@) $ 19900 عن محمد بن كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( والذي نفسي بيده ما أنزلت ه اذه الآيات إلا في أهل القدر : { إن المجرمين في ضلال وسعر . . . } إلى آخر السورة ) ( كر ) . )(@)(@@)(@@)(@@) $ 19901 عن محمد بن 
ms7768	 كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( جمع القرآن في زمان رسول الله خمسة نفر من الأنصار : معاذ بن جبل ، وعبادة بن الصامت ، وأبي بن كعب ، وأبو الدرداء ، وأبو أيوب رضي الله عنهم ) ( ش ) . )(@)(@@)(@@)(@@) $ 19902 عن محمد بن كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( خلق الله تعالى الأرواح قبل أن يخلق الأجساد ، فأخذ ميثاقهم ) ( ش ) . )(@)(@@)(@@)(@@) $ 19903 حدثنا أبو معشر ، عن محمد بن كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر فلا يجلس على مائدة يشرب عليها الخمر ، ومن كان يؤمن بالله واليوم الآخر فعليه الجمعة يوم الجمعة إلا صبيا أو امرأة أو مملوكا ، ومن استغنى بلهو أو تجارة استغنى الله تعالى عنه والله غني حميد ) ( عب ) . )(@)(@@)(@@)(@@) $ 19904 عن محمد بن كعب القرظي رضي الله عنه :(@)(@@) | 30 ( أن عليا لقي فاطمة رضي الله عنه يوم أحد ، فقال : خذي السيف غير مذموم ، فقال رسول الله : ي اا علي إن كنت أحسنت القتال اليوم ، فقد أحسنه أبو دجانة ، ومصعب بن عمير ، والحارث بن الصمة وسهل بن حنيف : ثلاثة من الأنصار ، ورجل من قريش ) ( ش ) . )(@)(@@) PageV21P426(@)(@@)(@@)(@@) $ 19905 عن محمد بن كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( لعن رسول الله الحكم ، وما ولد إلا الصالحين وهم قليل ففرحت بها لعمر بن عبد العزيز ) ( عب ، كر ) . )(@)(@@)(@@)(@@) $ 19906 حدثني يزيد بن زياد مولى بني هاشم ، عن محمد بن كعب القرظي رضي الله عنه قال :(@)(@@) | 30 ( حدثت أن عتبة بن ربيعة وكان سيدا حليما ، قال ذات يوم وهو جالس في نادي قريش ورسول الله جالس وحده في المسجد : ي اا معشر قريش ألا أقوم إلى ه اذا فأكلمه ، فأعرض عليه أمورا لعله أن يقبل بعضها ، فنعطيه أيها شاء ، ويكف عنا ؟ وذلك حين أسلم حمزة ابن عبد المطلب رضي الله عنه ، ورأوا أصحاب رسول الله يزيدون ويكثرون ، فقالوا : بلى 
ms7769	 ، فقم ي اا أبا الوليد فكلمه ، فقام عتبة حتى جلس إلى رسول الله فقال : ي اا ابن أخي إنك منا حيث قد علمت من السعة في العشيرة ، والمكان في النسب ، وإنك قد أتيت قومك بأمر عظيم : فرقت به جماعتهم ، وسفهت به أحلامهم ، وعبت به آلهتهم ودينهم ، وكفرت من مضى من آبائهم ، فاسمع مني أعرض عليك أمورا تنظر فيها لعلك أن تقبل منها بعضها ، فقال رسول الله : قل ي اا أبا الوليد أسمع ، فقال : ي اا ابن أخي إن كنت إنما تريد بما جئت من ه اذا القول مالا جمعنا لك من أموالنا حتى تكون أكثرنا مالا ، وإن كنت إنما تريد شرفا شرفناك علينا حتى لا نقطع أمرا دونك ، وإن كنت تريد ملكا ملكناك علينا ، وإن كان ه اذا الذي يأتيك رئي ، تراه ولا تستطيع أن ترده عن نفسك ، طلبنا لك الطبيب وبذلنا فيه أموالنا حتى نبرئك منه ، فإنه ربما غلب التابع على الرجل حتى يداوى منه ، أو لعل ه اذا الذي تأتي به شعر جاش به صدرك ، وإنكم لعمري ، ي اا بني عبد المطلب تقدرون منه على ما لا يقدر عليه أحد حتى إذا فرغ عنه ورسول الله يستمع منه ، قال رسول الله : أفرغت ي اا أبا الوليد ؟ قال : نعم ، قال : فاسمع مني ، قال : أفعل ، فقال PageV21P427 رسول الله : { بسم الله الرحيم . ح أم . تنزيل من الرحم ان الرحيم . كتاب فصلت آياته قرآنا عربيا لقوم يعلمون } ، فمضى رسول الله فقرأها عليه ، فلما سمعها عتبة أنصت له ، وألقى بيده خلف ظهره معتمدا عليها يسمع منه ، حتى انتهى رسول الله للسجدة فسجد فيها ثم قال : قد سمعت ي اا أبا الوليد ما سمعت ، فأنت وذاك فقام عتبة إلى أصحابه ، فقال بعضهم لبعض : نحلف بالله لقد جاءكم أبو الوليد بغير الوجه الذي ذهب به فلما جلس إليهم قالوا : ما وراءك ي اا أبا الوليد ؟ فقال : ورائي أني والله قد سمعت قولا ما سمعت بمثله قط والله ما هو بالشعر ، ولا بالسحر ، ولا بالكهانة ي 
ms7770	 اا معشر قريش أطيعوه واجعلوها في ، خلوا بين ه اذا الرجل وبين ما هو فيه واعتزلوه ، فوالله ليكونن لقوله الذي سمعت نبأ فإن تصبه العرب فقد كفيتموه بغيركم ، وإن يظهر على العرب فملكه ملككم ، وعزه عزكم ، وكنتم أسعد الناس به ، قالوا : سحرك والله ي اا أبا الوليد بلسانه فقال : ه اذا رأي ي لكم ، فاصنعوا ما بدا لكم ) ( هق ، في الدلائل ، كر ) . )(@)(@@)(@@)(@@) $ 19907 عن محمد بن كعب القرظي رضي الله عنهم قال :(@)(@@) | 30 ( لما رجع رسول الله حين أسري به ، فبلغ ذا طوى ، قال : ي اا جبريل إني أخاف أن يكذبوني ، قال : وكيف يكذبونك وفيهم أبو بكر الصديق ) ( والزبير ابن بكار بن إسحاق ) . )(@)(@@)(@@)(@@) $ 19908 عن محمد بن كعب القرظي رضي الله عنه : $ 30 ( أن رسول الله دخل على أسماء بنت أبي بكر الصديق رضي الله عنه حين ولد عبد الله بن الزبير رضي الله عنه ، فقال : أهو هو ، أهو هو ؟ فقيل ي اا رسول الله إن أسماء تركت رضاع عبد الله لما سمعتك تقول : أهو هو ؟ فقال : أرضعيه ولو بماء عينيك ، كبش من ذئاب ، ذئاب عليها ثياب ، ليمنعن الحرم ، وليقتلن به ) ( كر ) .(@)PageV21P428(@)(@@)(@@)(@@) |||| 728 ( مراسيل محمد بن شهاب ، الزهري رضي الله عنه [ / ب )(@)(@@)(@@)(@@) $ 19909 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( ثلاثة ليسوا من أمة محمد : الجعدي ، والناثي ، والقدري , 3 ) ( كر ) . )(@)(@@)(@@)(@@) $ 19910 من مسند من لم يسم عن النزهري رضي الله عنه :(@)(@@) | 30 ( أن يحي اى من الأنصار من بني حارثة أخبره أن ناسا من أصحاب رسول الله أتوا رسول الله ، فقالوا : ي اا رسول الله أرأيت شيئا نجدها في صدورنا من وسوسة الشيطان ، لأن يقع أحدنا من الثريا أحب إليه من أن يتكلم بها ، فقال رسول الله : أقد وجدتم ذلك ؟ قالوا : نعم ، قال : ذلك صريح الإيمان ؛ إن الشيطان يريد العبد فيما دون ذلك ، فإذا عصم العبد منه وقع فيما هنالك ) ( محمد بن عثمان الأذرعي في كتاب الوسوسة ) . )(@)(@@)(@@)(@@) $ 19911 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يرفع يديه 
ms7771	 عند صدره في الدعاء ، ثم يمسح بهما وجهه ) ( عب ) . )(@)(@@)(@@)(@@) $ 19912 حدثنا أبو الأسود ، حدثنا ابن لهيعة ، عن محمد بن المهاجر من أهل مصر ، عن ابن شهاب رضي الله عنه قال :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } ، والمعوذتين بعد صلاة الجمعة حين يسلم الإمام قبل أن يتكلم سبعا سبعا ، كان ضامنا هو وماله وولده من الجمعة إلى الجمعة ) ( عب ) . )(@)(@@)(@@)(@@) $ 19913 عن معمر ، عن الزهري رضي الله عنه قال : $ 30 ( كان راجز يرجز للنبي ، فنزل ابنه بعد ما مات ، فقال : أرجز لك ي اا رسول الله ؟ قال : نعم ، PageV21P429 فقال عمر رضي الله عنه ) انظر ما تقول : فقال : أقول :(@)(@@) تالله لولا الله ما اهتدينا %~% ولا تصدقنا ولا صلينا(@)(@@) فأنزلن سكينة علينا %~% وثبت الأقدام إذ لاقينا(@)(@@) والمشركون قد بغوا علينا %~% إذ يقولون اكفروا أبينا(@)(@@) قال عمر رضي الله عنه : صدقت ؛ فقال النبي : من يقل ه اذه ؟ قال : أبي ي اا رسول الله قالها ، قال : رحمه الله تعالى ، قال : ي اا رسول الله قد يأبى الناس الصلاة عليه مخافة أن يكون قتل نفسه ، فقال : كلا بل مات مجاهدا ، له أجران اثنان ) . ( قال الزهري : وكان ضرب رجلا من المشركين بسيفه ، فرجع السيف فأصاب نفسه بسيفه فمات ) ( عب ) . ) $(@)(@@)(@@)(@@) $ 19914 عن الزهري ، عن عبد الرحم ان بن أسعد المعقق ، عن عبد الرحم ان بن الحارث بن هشام ، عن أبيه : أنه قال :(@)(@@) | 30 ( ي اا رسول الله حدثني بأمر أعتصم به ، قال : املك عليك ه اذا ، وأشار إلى لسانه ) . ( حب ، وأبو نعيم ، كر ) . وقال : ه اذا حديث غريب من حديث الزهري ، لم يذكره محمد بن يحي اى الذهلي في الزهريات ) . )(@)(@@)(@@)(@@) $ 19915 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أن النبي مر بأعرابي يبيع شيئا ، فقال : عليك بأول السوم أو بأول سومه ، فإن الربح مع السماح ) ( ش ) . )(@)(@@)(@@)(@@) $ 19916 عن الزهري ، حدثني عطاء بن يزيد :(@)(@@) | 30 ( أنه حدثه بعض أصحاب رسول الله قال : قيل ي اا رسول الله : أي الناس أفضل ؟ قال : من جاهد بنفسه وماله في سبيل الله ، قالوا : ثم 
ms7772	 من ي اا رسول الله ؟ قال : مؤمن في شعب من الشعاب يتقي الله ويدع الناس من شره ) ( كر ، ه ) . )(@)(@@)(@@)(@@) $ 19917 عن الزهري رضي الله عنه قال : $ 30 ( قال رسول الله لحسان : هل قلت في أبي بكر قيلا ؟ قال : نعم ، قال : قل وأنا أسمع ، قال :(@)(@@) PageV21P430(@)(@@) وثاني آثنين في الغار المنيف %~% وقدطاف العدو به إذ يصعد الجبلا(@)(@@) وكان ردف رسول الله قد علموا %~% من البرية لم يعدل به رجلا(@)(@@) [ / ش(@)(@@) فضحك رسول الله حتى بدت نواجذه { وقال صدقت ي اا حسان هو كما قلت ) ( ابن النجار ) . ) $(@)(@@)(@@)(@@) $ 19918 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( كانوا يتراهنون على عهد رسول الله ، وأول من أعطى فيه عمر بن الخطاب ) ( ش ) . )(@)(@@)(@@)(@@) $ 19919 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أنه كان ينكر الجلد مع الرجم ، ويقول : قد رجم رسول الله ولم يذكر الجلد ) ( عب ) . )(@)(@@)(@@)(@@) $ 19920 أنبأنا معمر ، عن الزهري ، قال :(@)(@@) | 30 ( سأل رجل رسول الله : فقال : الرجل يجد مع امرأته رجلا أيقتله ؟ فقال النبي : لا ، إلا بالبينة ، فقال سعد بن عبادة رضي الله عنه : وأي بينة أبين من السيف ؟ فقال النبي : ألا تسمعون إلى ما يقول سيدكم ؟ قالوا : لا تلمه ي اا رسول الله فإنه رجل غيور ، والله ما تزوج امرأة قط إلا بكرا ، ولا طلق امرأة قط فاستطاع أحد منا أن يتزوجها ، فقال النبي : يأبى تعالى إلا بالبينة ) ( عب ) . )(@)(@@)(@@)(@@) $ 19921 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( مضت السنة أن يحد العبد والأمة أهلوهما في الفاحشة ، إلا أن يرفع أمرهما إلى السلطان ، فليس لأحد أن يفتات على السلطان ) ( عب ) . )(@)(@@)(@@)(@@) $ 19922 عن معمر ، عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إذا شربوا فاجلدوهم ، ثم إذا شربوا فاجلدوهم ، ثم إذا شربوا فاجلدوهم ، ثم إذا شربوا فاقتلوهم ، ثم قال : إن الله تعالى وضع عنهم القتل ، فإذا شربوا فاجلدوهم ، ثم إذا شربوا فاجلدوهم ذكرها أربع مرات ) ( عب ) . )(@)(@@) PageV21P431(@)(@@)(@@)(@@) $ 19923 عن ابن جريج قال :(@)(@@) | 30 ( سئل ابن شهاب رضي الله عنه كم جلد رسول الله في الخمر ؟ قال 
ms7773	 : لم يكن رسول الله فرض فيها حدا ، كان يأمر من يحضره يضربونه بأيديهم ونعالهم ، حتى يقول رسول الله : ارفعوا ، وفرض فيها أبو بكر رضي الله عنه أربعين ، وفرض فيها عمر رضي الله عنه ثمانين سوطا ) ( عب ) . )(@)(@@)(@@)(@@) $ 19924 عن عمر بن حبيب قال :(@)(@@) | 30 ( سمعت ابن شهاب رضي الله عنه يقول : قال رسول الله : من شرب الخمر فاضربوه ، ثم إن شرب الثانية فاضربوه ، ثم إن شرب الخمر فاضربوه ، ثم إن شرب الرابعة فاقتلوه ، قال : فأتي برجل قد شرب فضربه ، ثم الثانية فضربه ، ثم الثالثة فضربه ، ثم الرابعة فضرب ، ووضع الله تعالى القتل ) ( عب ) . )(@)(@@)(@@)(@@) $ 19925 عن الزهري رضي الله عنه قال(@)(@@) | 30 : ( بلغنا عن رسول الله قال في الكتاب الذي كتبه بين قريش والأنصار : ولا ت تركوا مفرجا أن تعينوه في فكاك أو عقل ) ( عب ) . )(@)(@@)(@@)(@@) $ 19926 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( قد كانت ديون تكون على عهد رسول الله ، ما علمنا حرا بيع في دين ) ( عب ) . )(@)(@@)(@@)(@@) $ 19927 أنبأنا معمر ، عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( قدم رسول الله وأهل المدينة يسلفون في الثمار ، فقال : من سلف في ثمرة فهو ربا إلا بكيل معلوم إلى أجل معلوم ) ( عب ) . )(@)(@@)(@@)(@@) $ 19928 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( فرائض البقر مثل فرائض الإبل ، غير أنه لا أسنان فيها ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 19929 عن معمر ، عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( نهى رسول الله أن يطرق الرجل أهله بعد العتمة ) ( عب ) . )(@)(@@)(@@)(@@) $ 19930 عن الزهري ، عن رجل أظنه قال من أبناء النقباء ، عن أبيه قال : PageV21P432(@)(@@) | 30 ( كنا نصلي مع رسول الله ، ثم نرجع إلى رحالنا ، وأحدنا يبصر مواقع النبل ) ( ش ) . )(@)(@@)(@@)(@@) $ 19931 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أن رجالا من أصحاب النبي أصيبت أبصارهم ، فكانوا يؤمون عشائرهم ، منهم : عبد الله بن أم مكتوم ، وعتبان بن مالك ، ومعاذ بن عفراء ) ( عب ) . )(@)(@@)(@@)(@@) $ 19932 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( إني لأتجوز في صلاتي إذا سمعت بكاء الصبي ) ( عب ) . )(@)(@@)(@@)(@@) $ 19933 عن معمرم قال :(@)(@@) | 30 
ms7774	 ( سئل عن الزهري رضي الله عنه عن ضرب الخدم ؟ فقال : كانوا يضربونهم ولا يلعنونهم ) . )(@)(@@)(@@)(@@) $ 19934 عن الزهري :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كان يضرب النساء والخدم ) ( عب ) . )(@)(@@)(@@)(@@) $ 19935 عن ابن شهاب رضي الله عنه قال :(@)(@@) | 30 ( اجتمع في مسجد رسول الله : عمر بن الخطاب ، وعلي وجعفر ابنا أبي طالب ، والعباس بن عبد المطلب رضي الله عنه ، فذكروا المعروف ، فقال علي : المعروف حصن من الحصون ، وكنز من الكنوز ، فلاع يزهدنك فيه كفر من كفره ، فقد يشكرك عليه من لم ينتفع منه بشيء ، وقد تدرك بشكر الشاكر ما أضاع الكفور الجاحد ، وقال جعفر : ي اا أهل المعروف إلى اصطناع ما ليس للطالبين إليهم منه ، ولأنك إذا اصطنعت معروفا ، كان لك أجره وفخره ، وثناؤه ومجده ، فما بالك تطلب شكر ما أتيت إلى نفسك من غيرك ؛ وقال العباس رضي الله عنه : المعروف أحصن الحصون ، وأعظم الكنوز ، ولن يتم إلا بثلاث : تعجيله ، وستره ، وتصغيره ، لأنك إذا عجلته : هنأته ، وإذا صغرته : عظمته ، وإذا سترته : أتممته ، وقال عمر بن الخطاب رضي الله عنه : لكل شيء أنف ، وأنف المعروف سراحه ؛ فخرج رسول الله فقال : فيم أنتم ؟ قالوا : كنا نذكر المعروف ، فقال : المعروف معروف كاسمه ، PageV21P433 وأهل المعروف في الدنيا أهل المعروف في الآخرة ) ابن النجار . )(@)(@@)(@@)(@@) $ 19936 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( أوتر النبي على دابته ) ( عب ) . )(@)(@@)(@@)(@@) $ 19937 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه كان يوتر أول الليل ، وعمر رضي الله عنه آخر الليل ، فسألهما النبي عن وترهما ؟ فأخبراه ، فقال : قوي ه اذا ، وحذر ه اذا ، قال : وقال النبي : أضرب لكما مثلكما مثل رجلين أخذا في مفازة ليلا ، فقال أحدهما : ما أريد أن أنام حتى أقطعها ، وقال الآخر : أنام نومة ثم أقوم فأقطعها ، فأصبحا في المنزل جميعا ) ( عب ) . )(@)(@@)(@@)(@@) $ 19938 عن الزهري رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رأى في ثوبه دما فانصرف من الصلاة ) ( ض ) . )(@)(@@)(@@)(@@) $ 19939 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( مر رسول الله برجل يتوضأ 
ms7775	 ، يغرف الماء في وضوئه ، فقال : ي اا عبد الله لا تسرف ، فقال : ي اا نبي الله وفي الوضوء إسراف ؟ قال : نعم ) ( ص ) . )(@)(@@)(@@)(@@) $ 19940 عن الزهري ، عن رجل من الأنصار ، عن أبيه قال :(@)(@@) | 30 ( رأيت رسول الله أكل من كتف شاة ثم قام إلى الصلاة ولم يتوضأ ) ( عب ) . )(@)(@@)(@@)(@@) $ 19941 عن ابن شهاب رضي الله عنه قال :(@)(@@) | 30 ( اعتدت بريرة ثلاث حيض ) ( عب ) . )(@)(@@)(@@)(@@) $ 19942 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( ضرب رسول الله لنفر من المهاجرين والأنصار بسهامهم يوم بدر كاملة ، وكانوا غيبا عنها بعذر كان بهم ، منهم من الأنصار : أبو لبابة بن عبد المنذر ، والحارث بن حاطب رضي الله عنهما ) ( طب ) . )(@)(@@)(@@)(@@) $ 19943 عن صالح بن كيسان قال :(@)(@@) | 30 ( اجتمعت أنا والزهري رضي الله عنه PageV21P434 ونحن نطلب العلم ، فقال لي : تعال حتى نكتب السنن ، فكتبنا ما جاء عن النبي ، ثم قال : تعال حتى نكتب كل ما جاء عن الصحابة ، فإنه سنة ، وقلت أنا : ليس بسنة فلا نكتبه ، فقال : بل هو سنة ، فكتب ولم أكتب ، فأنجح وضيعت ) يعقوب بن سفيان ، ( هق ، في المدخل ، كر ) . )(@)(@@)(@@)(@@) $ 19944 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( مضت السنة بأن يرث كل ميت وارثه الحي ، ولا يرث الموتى بعضهم من بعض ) ( عب ) . )(@)(@@)(@@)(@@) $ 19945 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( قال رجل من بني الديلة بن بكر : لوددت أني رأيت رسول الله ، وسمعت منه ، فقال له رجل : انطلق معي ، فقال : إني أخاف أن تقتلني خزاعة ، فلم يزل به حتى انطلق ؛ فلقيه رجل من خزاعة فعرفه ، فضرب بطنه بالسيف ، قال : قد أخبرتك أنهم سيقتلوني فبلغ ذلك رسول الله ، فقام فحمد الله تعالى وأثنى عليه ، ثم قال : إن الله تعالى هو حرم مكة ليس الناس حرموها ، وإنما أحلت لي ساعة من نهار ، وهي بعد حرم ، وإن أعدى الناس على الله ثلاثة : من قتل فيها ، أو قتل غير قاتله ، أو طلب بدخول الجاهلية ، فلأدين ه اذا الرجل ) ( ش ) . )(@)(@@)(@@)(@@) $ 19946 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( بلغني أن الرايات السود 
ms7776	 تخرج من خراسان ، فإذا هبطت من عقبة خراسان هبطت تبغي الإسلام ، فلا يردها إلا ريات الأعاجم من قبل المغرب ) ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 19947 عن الزهري : قال :(@)(@@) | 30 ( يبعث من الكوفة بعثان : بعث إلى مرو ، وبعث إلى الحجاز ، فيخسف بثلث بعثه إلى الحجاز ؛ وثلث يمسخون تحول وجوههم بين أكتافهم ، فهم يرون أدبارهم كما يرون فروجهم ، يمشون القهقرى بأعقابهم كما كانوا يمشون بصدور أرجلهم ؛ ويبقى الثلث فيسيرون إلى مكة ) ( نعيم ) . )(@)(@@)(@@)(@@) $ 19948 عن ابن شهاب رضي الله عنها :(@)(@@) | 30 ( أن رسول الله قال لعائشة PageV21P435 رضي الله عنها :(@)(@@) $ 30 ( إن قومك لأسرع الناس فناء ، فبكت عائشة ، فقال : ما يبكيك ؟ لعلك تظنين بني تيم دون قريش ؛ إني لم أرد رهطك خاصة ، ول اكني أردت قريشا كلها ، يفتح الله تعالى عليهم الدنيا ، فتستشرفهم العيون ، وتستجلبهم المنايا ، فهم أسرع الناس فناء ) ( نعيم ) . ) $(@)(@@)(@@)(@@) $ 19949 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( في خروج السفياني : ( ترى علامة في السماء ) نعيم . )(@)(@@)(@@)(@@) $ 19950 عن الزهري رضي الله عنه أنه قيل له :(@)(@@) | 30 ( كنا لا نزال نحسن الظن بالرجل من أهل القرآن ، وأهل المساجد ثم يخالف ، قال : ذلك النقص ، ثم قال : إن الناس كانوا في حياة رسول الله أهل سنة ، ولم يكن لهم كثير عبادة ، ول اكنهم كانوا يؤدون الأمانة ، ويصدقون النية ، فلما مات رسول الله ، هبط الناس درجة ، وكانوا على شريعة من أمرهم مع أبي بكر وعمر رضي الله عنهما ، فلما مات عمر هبط الناس درجة وكانوا مع عثمان رضي الله عنه حسنة علانيتهم فلا بأس بحالهم حتى قتل عثمان ، انهتك الحجاب ؛ وكان الناس في فتنتهم قد استحلوا الدماء فتقاطعوا وتدابروا حتى انكشفت ، ثم ألفهم الله تعالى في زمان معاوية ، فكانوا أهل دنيا يتنافسون فيها ، ويتصنعون لها ، ثم حضرتهم فتنة ابن الزبير ، فكانت الصيلم ، ثم صلحوا على يدي عبد الملك بن مروان ؛ فأنت منكر معهم ما تذكر من حسن ظنك بهم وخلافهم ، فليس يزال ه اذا الأمر ينتقص حتى يكون أسعد أهل الإسلام أصحاب الحمام والكلاب ، يعبدون الله على 
ms7777	 الأمر ، ولا يعرفون حلالا ولا حراما ) ( كر ) . )(@)(@@)(@@)(@@) $ 19951 عن الزهري ، عن أيوب بن بشير بن أكال قال :(@)(@@) | 30 ( سمعت معاوية بن أبي سفيان قال : قال رسول الله : صبوا علي من سبع قرب من آبار شتى حتى أخرج إلى الناس وأعهد إليهم ، فخرج عاصبا رأسه ، حتى صعد المنبر ، فحمد الله تعالى ، وأثنى عليه ، ثم قال : إن عبدا من عباد الله خير بين الدنيا وبين ما عند الله ، PageV21P436 فاختار ما عند الله ، فلم يلقنها إلا أبو بكر ، فبكى وقال : نفديك بآبائنا وأمهاتنا وأبنائنا فقال رسول الله : على رسلك ، أفضل الناس عندي في الصحبة وذات اليد ابن أبي قحافة ، انظروا ه اذه الأبواب الشوارع في المسجد فسدوها إلا ما كان من باب أبي بكر رضي الله عنه فإني رأيت عليه نورا ) ( طس ، كر ، وقال : ه اذا وهم ، فإن معاوية لم يرو ه اذا الحديث ، وإنما رواه الزهري ، عن أيوب بن النعمان أحد بني معاوية مرسلا ، فظن ( أحد بني ) معاوية ( حدثني ) معاوية فغير حدثني بسمعت ، ونسب ماوية إلى أبي سفيان ) . )(@)(@@)(@@)(@@) $ 19952 عن يونس بن بلال ، عن الزهري ، قال : لا أظنه إلا رفعه قال :(@)(@@) | 30 ( ما من أمة يعملون بطاعة الله مائة سنة ، فتأتي عليهم ، وهم يعملون بطاعة الله إلا أكلوا مثلها ، فإن أت ت عليهم المائة وهم يعملون بمعصية الله إلا هلكوا وأبيدوا ، وفكان مما رحم الله ه اذه الأمة خلافة عمر بن عبد العزيز ) ( كر ) . )(@)(@@)(@@)(@@) $ 19953 عن ابن شهاب رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : أمتي أمة مرحومة ، لا عذاب عليها في الآخرة ، عذابها في الدنيا الزلازل والبلايا ، فإذا كان يوم القيامة أعطى الله تعالى كل رجل من أمتي رجلا من الكفار من يأجوج ومأجوج ، فيقال : ه اذا فداؤك من النار ؛ فقال رجل : ي اا رسول الله فأين القصاص ؟ فسكت ) ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 19954 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( من قتل في الحرم قتل في الحرم ، ومن قتل في الحل ثم دخل الحرم أخرج إلى الحل وقتل ، فقيل : تلك السنة 
ms7778	 ) ( عب ) . )(@)(@@)(@@)(@@) $ 19955 عن الزهري رضي الله عنه قال :(@)(@@) | 30 ( دمشق معقل المسلمين من الروم إذا وقعت الملاحم ، وعلامة ملاحم الروم إذا بنيت مدينة من دمشق على أربعة أميال PageV21P437 قبل المغرب يكون على سياق وتعجل الرحلة إلى دمشق ، فإنها فسطاط المسلمين يومئذ ، ولا ينالها مكروه إلا من الغساني الذي يخرج من الشطرجانة والمعقل مكة ، وقد بقي لها على ذلك شيء من ولد العباس ، والمعقل جبل الخليل ولبنان ) ( كر ) . )(@)(@@)(@@)(@@) $ 19956 - عن الزهري رضي الله عنه : ' أن رسول الله صلى الله عليه وسلم قضى في الأنف | بالدية ، وفي الذكر بالدية ، وفي اليدين بالدية ، وفي الرجلين بالدية ' ( عب ) . |(@)(@@)(@@)(@@) $ 19957 - عن الزهري رضي الله عنه قال : ' قضت السنة أن عمد الصبي | والمجنون خطأ ، ومن قتل صبيا لم يبلغ الحلم أقدناه به ' ( ب ) . |(@)(@@)(@@)(@@) $ 19958 - عن ابن شهاب رضي الله عنه قال : ' قضى رسول الله صلى الله عليه وسلم في المرأة | التي ضربت صاحبتها فقتلتها وما في بطنها بديتها على العاقلة ، وفي جنينها غرة ' | ( عب ) . |(@)(@@)(@@)(@@) $ 19959 - عن معمر ، عن الزهري وقتادة رضي الله عنهما قال : ' قضى | رسول الله صلى الله عليه وسلم في الجنين بغرة عبد أو أمة ' ( طب ، عن الهذلي ) . |(@)(@@)(@@)(@@) $ 19960 - عن الزهري رضي الله عنه قال : ' سألني عمر بن عبد العزيز | رضي الله عنه عن القسامة ؟ فقلت : قضى بها رسول الله صلى الله عليه وسلم والخلفاء بعده ' ( عب ، | ش ) . |(@)(@@)(@@)(@@) $ 19961 - عن معمر ، عن الزهري رضي الله عنه قال : ' دية اليهودي | والنصراني والمجوسي ، وكل ذمي دية المسلم ، قال : وكذلك كانت على عهد | رسول الله صلى الله عليه وسلم وأبي بكر وعمر وعثمان رضي الله عنهم ، حتى كان معاوية فجعل في | بيت المال نصفها ، وأعطى أهل المقتول نصفها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19962 - عن الزهري رضي الله عنه : ' أن النبي صلى الله عليه وسلم كان يشرب قائما ' | ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 19963 - عن معمر ، عن الزهري رضي الله عنه قال : ' نكح رجل من قومي | PageV21P438 | في عهد النبي صلى الله عليه وسلم امرأة من أهل الكتاب ' ( عب ) . |(@)(@@)(@@)(@@) $ 19964 - عن ابن جريج ، عن ابن 
ms7779	 شهاب رضي الله عنه قال : ' جرت السنة | في ابن الملاعنة أن يرثها ابنها ، وترث أمه منه ما فرض الله لها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19965 - عن ابن شهاب رضي الله عنه قال : ' من وصية النبي صلى الله عليه وسلم عتاب بن | أسيد أن لا لعان بين أربع وبين أزواجهن : اليهودية ، والنصرانية عند المسلم ، | والأمة عند الحر ، والحرة عند العبد ' ( عب ) . |(@)(@@)(@@)(@@) $ 19966 - عن الزهري رضي الله عنه قال : ' حدثني من لا أتهم من الأنصار : | أن رسول الله صلى الله عليه وسلم كان إذا توضأ أو تنخم ابتدروا نخامته فمسحوا بها وجوههم | وجلودهم ، فقال رسول الله صلى الله عليه وسلم : لم تفعلون هذا ؟ قالوا : نلتمس به البركة ، فقال | رسول الله صلى الله عليه وسلم : من أحب أن يحبه الله ورسوله ، فليصدق الحديث ، وليؤد الأمانة ، | ولا يؤذ جاره ' ( هب ) . |(@)(@@)(@@)(@@) $ 19967 - عن ابن شهاب رضي الله عنه قال : ' خرج قبل خروج النبي صلى الله عليه وسلم | أبو سلمة بن عبد الأسد ، وأم سلمة ، ومصعب بن عمير ، وعثمان بن مظعون ، | وأبو حذيفة بن عتبة بن ربيعة ، وعبد الله بن جحش ، وعمار بن ياسر ، وشماس بن | عثمان بن الشريد ، وعامر بن ربيعة ، ومعه امرأته أم عبد الله بنت أبي خيثمة ، فنزل | أبو سلمة ، وعبد الله بن جحش في بني عمرو بن عوف في أصحاب لهم ، ثم خرج | عمر بن الخطاب وعياش بن أبي ربيعة في أصحاب لهم ، فنزلوا على بني عمرو بن | عوف ' ( كر ) . |(@)(@@)(@@)(@@) $ 19968 - عن ابن شهاب رضي الله عنه قال : ' بلغنا أن خديجة بنت خويلد | رضي الله عنها كانت أول من آمن بالله ورسوله ، وماتت قبل أن تفرض الصلاة ' | ( ش ) . |(@)(@@)(@@)(@@) $ 19969 - عن الزهري رضي الله عنه قال : ' ما اتخذ رسول الله صلى الله عليه وسلم قاضيا | حتى مات ، ولا أبو بكر ، ولا عمر رضي الله عنهما ، إلا أنه قال لرجل في آخر | PageV21P439 | خلافته : اكفني بعض أمور الناس - يعني عليا - ' ( عب ) . |(@)(@@)(@@)(@@) $ 19970 - أنبأنا معمر ، عن الزهري ، أو قتادة أو كليهما : ' أن يهوديا جاء | يتقاضى النبي صلى الله عليه 
ms7780	 وسلم ، فقال النبي صلى الله عليه وسلم : قد قضيتك ، فقال اليهودي : بينتك ؟ فجاء | خزيمة الأنصاري رضي الله عنه فقال : أنا أشهد أنه قد قضاك ، فقال النبي صلى الله عليه وسلم : | ما يدريك ؟ فقال : إني أصدقك بأعظم من ذلك ، أصدقك بخبر السماء ، فأجاز | رسول الله صلى الله عليه وسلم شهادته بشهادة رجلين ' ( قط ) . |(@)(@@)(@@)(@@) $ 19971 - عن ابن شهاب رضي الله عنه قال : ' هاجر الزبير بن العوام | رضي الله عنه إلى أرض الحبشة ، ثم قدم على النبي صلى الله عليه وسلم ، ثم هاجر إلى المدينة ' | أبو نعيم في المعرفة . |(@)(@@)(@@)(@@) $ 19972 - عن الزهري رضي الله عنه قال : ' تصدق عبد الرحمن بن عوف | رضي الله عنه بشطر ماله في عهد رسول الله صلى الله عليه وسلم بأربعة آلاف ، ثم تصدق بأربعين | ألفا ، ثم تصدق بأربعين ألف دينار ، ثم حمل على خمسمائة فرس في سبيل الله ، | ثم حمل على ألف وخمسمائة راحلة في سبيل الله ، وكانت عامة ماله من التجارة ' | أبو نعيم . ( كر ) ، له مثله . |(@)(@@)(@@)(@@) $ 19973 - عن الزهري رضي الله عنه قال : ' قدم سعيد بن زيد رضي الله عنه | من الشام بعد مقدم النبي صلى الله عليه وسلم من بدر ، فكلم النبي صلى الله عليه وسلم في سهمه ، فقال : لك | سهمك ، قال : وأجري يا رسول الله ! قال : وأجرك ' ( أبو نعيم ) . |(@)(@@)(@@)(@@) $ 19974 - عن الزهري رضي الله عنه قال : ' مر رسول الله صلى الله عليه وسلم بعبد الله بن | حذافة وهو يصلي يجهر بصوته ، فقال له النبي صلى الله عليه وسلم : لا تسمعني يا حذافة ! | وأسمع الله تعالى ' ( عب ) . |(@)(@@)(@@)(@@) $ 19975 - عن الزهري رضي الله عنه : ' أن أبا لبابة لما تاب الله تعالى عليه . | قال : يا نبي الله ! إن من توبتي أن أهجر دار قومي التي أصبت فيها الذنب وأجاورك | PageV21P440 | وأتخلع من مالي صدقة إلى الله وإلى رسوله ، فقال رسول الله صلى الله عليه وسلم : يجزئك عن ذلك | الثلث يا أبا لبابة ' ( عب ) . |(@)(@@)(@@)(@@) $ 19976 - عن معمر ، عن الزهري رضي الله عنه قال : ' إن حذيفة ابن اليمان | رضي الله عنه 