ms101	 مكي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1440 - (@)(@@) عميرة بن زياد الكندي كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب عميلة وعنتره وعنبس وعنبسه)(@)(@@)(@@)(@@) | 1441 - (@)(@@) عميلة الفزاري من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1442 - (@)(@@) عنبس بن عقبة ثقة من أصحاب عبد الله حدثنا أبو نعيم ثنا الأعمش عن يزير بن حيان قال إن كان عنبس ليركع فتقع العصافير على ظهره ما يحسبنه إلا قدم حائط(@)(@@)(@@)(@@) | 1443 - (@)(@@) عنبسة بن سعيد الرازي ثقة(@)(@@)(@@)(@@) | 1444 - (@)(@@) عنبسة العابد كوفى ثقة(@)(@@)(@@)(@@) | 1445 - (@)(@@) عنترة بن عبد الرحمن كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1446 - (@)(@@) عنترة أبو هارون كوفى تابعي ثقة(@)(@@)(@@)(@@) | (باب العوام وعوانة وعوف وعون)(@)(@@)(@@)(@@) | 1447 - (@)(@@) العوام بن حوشب بن يزيد بن رويم الشيباني من أنفسهم كوفى ثقة رجل صالح وكان أبوه على شرط الحجاج وكان رجل سوء وكان العوام صاحب سنة ثبت صالح وكان أخوه خراش على شرطة يوسف بن عمر وروى نحوا من مائتي حديث أو أكثر قليلا وروى عن النخعي والتيمى وروى عنه يزيد بن هارون وهشيم والناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1448 - (@)(@@) عوانة بن الحكم عن عبد الله بن صالح العجلي قال كان عوانة بن الحكم الكلبي صاحب أدب وكان من أهل الكوفة وكان إذا أراد أن يسأل الرجل عربي أنت أم مولى قال له صليبة أنت أم من أنفسهم فإن كان عربيا قال صليبة وإن كان مولى قال من أنفسهم وقال رجل لعوانة بن الحكم أجمل الناس جرير بن عبد الله قال له عوانة أجمل الناس من نزل جبريل على صورته يعني دحية الكلبي(@)(@@)(@@)(@@) | 1449 - (@)(@@) عوف بن مالك بن عوف الجشمي كوفي تابعي ثقة من أصحاب عبد الله بن مسعود كنيته أبو الأحوص(@)(@@)(@@)(@@) | 1450 - (@)(@@) عوف والد أبي الأحوص من أصحاب النبي صلى الله عليه وسلم ذكره في ترجمة ولده(@)(@@)(@@)(@@) | 1451 - (@)(@@) عون بن عبد الله بن عتبة بن مسعود ثقة مدني(@)(@@)(@@)(@@) | 1452 - (@)(@@) عون بن عبد الله بن عسدس مدني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1453 - (@)(@@) عون بن موسى الليثي بصرى ثقة(@)(@@)(@@)(@@) | (باب عياش وعياض وعيزار)(@)(@@)(@@)(@@) | 1454 - (@)(@@) عياش بن عباس مصري ثقة(@)(@@)(@@)(@@) | 1455 - (@)(@@) عياش بن الوليد الأزرق بصرى ثقة وقد كتبت عنه 
ms102	(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1456 - (@)(@@) عياش العامري ثقة روى عنه الأسود بن هلال وهو في عداد الشيوخ روى عنه الثوري(@)(@@)(@@)(@@) | 1457 - (@)(@@) عياض بن عبد الله بن أبي سرح مدني تابعي ثقة(@)(@@)(@@)(@@) | 1458 - (@)(@@) عيزار بن حريث كوفى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب عيسى وعيينة)(@)(@@)(@@)(@@) | 1459 - (@)(@@) عيسى بن حطان ثقة(@)(@@)(@@)(@@) | 1460 - (@)(@@) عيسى بن حفص بن عاصم بن عمر بن الخطاب مدني ثقة(@)(@@)(@@)(@@) | 1461 - (@)(@@) عيسى بن سعيد مصرى تابعي ثقة(@)(@@)(@@)(@@) | 1462 - (@)(@@) عيسى بن سنان لا بأس به(@)(@@)(@@)(@@) | 1463 - (@)(@@) عيسى بن طلحة بن عبيد الله تابعي ثقة مدني روى عن عبد الله بن عمرو(@)(@@)(@@)(@@) | 1464 - (@)(@@) عيسى بن عبد الرحمن السلمي ثقة(@)(@@)(@@)(@@) | 1465 - (@)(@@) عيسى بن عمر الأسدي ثقة رجل صالح كان أحد قراء الكوفة رأسا في القرآن(@)(@@)(@@)(@@) | 1466 - (@)(@@) عيسى بن أبي عيسى الحناط ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1467 - (@)(@@) عيسى بن يونس بن أبي إسحاق السبيعي كوفى ثقة سكن الثغر وكان ثبتا في الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1468 - (@)(@@) عيينة بن عبد الرحمن بن جوشن بصرى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب الغين غالب وغسان وغضيف وغيلان)(@)(@@)(@@)(@@) | 1469 - (@)(@@) غالب بن عبد الله بن سعد بصرى ثقة(@)(@@)(@@)(@@) | 1470 - (@)(@@) غسان بن برزين الطهوي بصرى ثقة(@)(@@)(@@)(@@) | 1471 - (@)(@@) غضيف بن الحارث شامي تابعي ثقة(@)(@@)(@@)(@@) | 1472 - (@)(@@) غيلان بن جرير المعولي بصرى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1473 - (@)(@@) غيلان المقرى شامي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب الفاء فرات وفراس وفرافصة)(@)(@@)(@@)(@@) | 1474 - (@)(@@) فرات القزاز كوفى ثقة(@)(@@)(@@)(@@) | 1475 - (@)(@@) فراس بن يحيى كوفى ثقة من أصحاب الشعبي في عداد الشيوخ ليس بكثير الحديث(@)(@@)(@@)(@@) | 1476 - (@)(@@) الفرافصة مدني تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب فرقد وفضالة وفضل)(@)(@@)(@@)(@@) | 1477 - (@)(@@) فرقد السبخي بصرى لا بأس به(@)(@@)(@@)(@@) | 1478 - (@)(@@) فضالة الزهراني بصرى تابعي ثقة(@)(@@)(@@)(@@) | 1479 - (@)(@@) الفضل بن الحسن الضمري مصرى تابعي ثقة(@)(@@)(@@)(@@) | 1480 - (@)(@@) الفضل بن دكين أبو نعيم الأحول كوفى ثقة ثبت في الحديث(@)(@@)(@@)(@@) | 1481 - (@)(@@) الفضل بن العباس بن عبد المطلب من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1482 - (@)(@@) الفضل بن مبشر الأنصاري لا بأس به(@)(@@)(@@)(@@) | 1483 - (@)(@@) الفضل بن مهلهل أخو مفضل ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1484 - (@)(@@) الفضل بن الموتمر العتكي بصرى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب فضيل وفطر)(@)(@@)(@@)(@@) | 1485 - (@)(@@) فضيل بن عمرو الفقيمي كوفى ثقة وهو أسن من أخيه الحسن وكان فضيل من أصحاب 
ms103	 إبراهيم النخعي ثقة ثبت روى عنه أخوه الحسن بن عمرو(@)(@@)(@@)(@@) | 1486 - (@)(@@) فضيل بن عياض كوفى ثقة متعبد رجل صالح سكن مكة(@)(@@)(@@)(@@) | 1487 - (@)(@@) فضيل بن غزوان الضبي كوفى ثقة وكان عثمانيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1488 - (@)(@@) فضيل بن مرزوق جائز الحديث ثقة وكان فيه تشيع وهو كوفي وفي موضع آخر كوفى ثقة(@)(@@)(@@)(@@) | 1489 - (@)(@@) فطر بن خليفة الحناط كوفى ثقة حسن الحديث وكان فيه تشيع قليل(@)(@@)(@@)(@@) | (باب فلفلة وفهد)(@)(@@)(@@)(@@) | 1490 - (@)(@@) فلفلة الجعفي كوفي تابعي ثقة(@)(@@)(@@)(@@) | 1491 - (@)(@@) فهد بن حيان بصرى ضعيف الحديث وقد كتبت عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1492 - (@)(@@) فهد بن عوف لا بأس به كان من أروى الناس عن فضيل باب القاف(@)(@@)(@@)(@@) | 1493 - (@)(@@) قابوس بن أبي ظبيان الجنبي كوفى لا بأس به(@)(@@)(@@)(@@) | 1494 - (@)(@@) القاسم بن أبي بزة مكي ثقة(@)(@@)(@@)(@@) | 1495 - (@)(@@) القاسم بن حسان كوفي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1496 - (@)(@@) القاسم بن عبد الله بن عمر بن حفصى العدوى متروك الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1497 - (@)(@@) القاسم بن عبد الرحمن بن عبد الله بن مسعود وكان على قضاء الكوفة وكان لا يأخذ على القضاء أجرا ثقة رجل صالح(@)(@@)(@@)(@@) | 1498 - (@)(@@) القاسم بن الفضل الحداني بصرى ثقة(@)(@@)(@@)(@@) | 1499 - (@)(@@) القاسم بن مالك المزني كوفي ثقة(@)(@@)(@@)(@@) | 1500 - (@)(@@) القاسم بن محمد بن أبي بكر الصديق وكان من خيار التابعين وفقهائهم مدني تابعي ثقة نزه رجل صالح(@)(@@)(@@)(@@) | 1501 - (@)(@@) القاسم بن مخيمرة كوفى ثقة سكن الشام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1502 - (@)(@@) القاسم بن معن حدثنا أبو مسلم حدثني أبى حدثني أبي عبد الله قال بينا القاسم بن معن يقضى في داره بالكوفة بين الناس إذ قيل الأمير وإخوته يعنى موسى بن عيسى قال ماله قال يخاصم إخوته قال ويحه وله رفعة ناد من له حاجة حتى إذا لم يبق أحد قال أدخل الأمير وإخوته قال فدخل موسى يخطر حتى جلس إلى جانبه قال لا مع خصمايك يا غلام ساو بين ركبهم فأجلسهم بين يديه قال موسى فأغاظني غيظة ثم علمت إنما أراد وجه الله فأحببته(@)(@@)(@@)(@@) | 1503 - (@)(@@) القاسم بن مهران بصرى ثقة(@)(@@)(@@)(@@) | 1504 - (@)(@@) القاسم بن الوليد الهمداني ثقة وهو في عداد الشيوخ(@)(@@)(@@)(@@) | 1505 - (@)(@@) القاسم أبو عبد الرحمن 
ms104	 شامي تابعي ثقة يكتب حديثه وليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1506 - (@)(@@) قاسم العرفطى من ولد خالد بن عرفطة المخزومي صاحب رسول الله صلى الله عليه وسلم عن محمد بن طلحة عن أبيه قال كنا نرى أكثر تبع الدجال قوم ينتحلون حب علي رضي الله عنه يعني الرافضة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1507 - (@)(@@) القاسم الكلبي بصرى ثقة(@)(@@)(@@)(@@) | (باب قبيصة وقتادة)(@)(@@)(@@)(@@) | 1508 - (@)(@@) قبيصة بن جابر الأسدي من أصحاب عمر وعبد الله ثقة وكان يعد من الفصحاء حدثنا أبو مسلم حدثنا أبي عبد الله قال كان عبد الملك بن عمير إذا ذكر الفصحاء قال فصحاء الناس ثلاثة الحسن البصري وموسى بن طلحة القرشي وقبيصة بن جابر الأسدي(@)(@@)(@@)(@@) | 1509 - (@)(@@) قبيصة بن حريث تابعي ثقة(@)(@@)(@@)(@@) | 1510 - (@)(@@) قبيصة بن ذؤيب مدني تابعي ثقة(@)(@@)(@@)(@@) | 1511 - (@)(@@) قبيصة بن عقبة ثقة(@)(@@)(@@)(@@) | 1512 - (@)(@@) قبيصة بن هلب كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1513 - (@)(@@) قتادة بن دعامة السدوسي يكنى أبا الخطاب بصرى تابعي ثقة وكان ضرير البصر وكان يتهم بقدر وكان لا يدعو إليه ولا يتكلم فيه حدثنا محمد بن يوسف الفريابي عن فضيل بن عياض قال قيل لطاووس هذا قتادة يأتيك قال لئن جاء لأقومن قيل إنه فقيه قال إبليس أفقه منه قال رب بما أغويتنى وثنا عن عثمان بن محمد العبسي قال قيل للشعبى رأيت قتادة قال نعم فرأيت كناسة بين حشين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب قثم وقرثع وقرة وقزعة)(@)(@@)(@@)(@@) | 1514 - (@)(@@) قثم بن العباس من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1515 - (@)(@@) قراد أبو نوح قال يحيى ليس به بأس(@)(@@)(@@)(@@) | 1516 - (@)(@@) القرثع كوفي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1517 - (@)(@@) قرة بن إياس المزني والد معاوية من أصحاب رسول الله صلى الله عليه وسلم دخل عليه ثلاث نسوة فقال أما واحدة فمرضع والأخرى بكر والأخرى ثيب فقيل له بم علمت قال أما المرضع فلما قعدت أمسكت ثدييها بيديها وأما البكر فلما دخلت لم تلتفت إلى أحد وأما الثيب فلما دخلت نظرت ورمت بعينها(@)(@@)(@@)(@@) | 1518 - (@)(@@) قرة بن عبد الرحمن المعافري يكتب حديثه(@)(@@)(@@)(@@) | 1519 - (@)(@@) قريش بن أنس قال يحيى ليس به بأس قال بن الجنيد قد كتب عنه 
ms105	 يحيى(@)(@@)(@@)(@@) | 1520 - (@)(@@) قريش بن حيان قال يحيى ثقة(@)(@@)(@@)(@@) | 1521 - (@)(@@) قزعة بن سويد بن حجير الباهلى لا بأس به وفيه ضعف وأبوه ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1522 - (@)(@@) قزعة بن يحيى مولى زياد بصرى تابعي ثقة(@)(@@)(@@)(@@) | (باب قسامة وقطبة)(@)(@@)(@@)(@@) | 1523 - (@)(@@) قسامة بن زهير بصرى تابعي ثقة(@)(@@)(@@)(@@) | 1524 - (@)(@@) قطبة بن عبد العزيز كوفى ثقة روى عن الأعمش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1525 - (@)(@@) قطبة بن العلاء بن المنهال الغنوي كان يحدث عن أبيه حديثا طويلا في قصة الجمل ولم تطب نفسي أن أكتب عنه لأنه كان على شرط الكوفة وكان أبوه ثقة(@)(@@)(@@)(@@) | (باب قيس)(@)(@@)(@@)(@@) | 1526 - (@)(@@) قيس بن الحارث المذحجي شامي ثقة(@)(@@)(@@)(@@) | 1527 - (@)(@@) قيس بن الحارث ثقة(@)(@@)(@@)(@@) | 1528 - (@)(@@) قيس بن حفص بصرى لا بأس به كتبنا عنه شيئا يسيرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1529 - (@)(@@) قيس بن أبي حازم الأحمسي فخذ من بجيلة من أصحاب عبد الله وسمع من أبي بكر الصديق ثقة(@)(@@)(@@)(@@) | 1530 - (@)(@@) قيس بن الربيع الأسدي الناس يضعفونه وكان شعبة يروى عنه وكان معروفا بالحديث صدوقا ويقال إن ابنه أفسد عليه كتبه بأخرة فترك الناس حديثه(@)(@@)(@@)(@@) | 1531 - (@)(@@) قيس بن سعد مكي ثقة(@)(@@)(@@)(@@) | 1532 - (@)(@@) قيس بن طلق بن على بن شيبان الحنفي يمامي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1533 - (@)(@@) قيس بن عاصم من أصحاب النبي صلى الله عليه وسلم وكان من خيارهم من بنى تميم حدثنا أبو داود الحفري عن سفيان عن الأغر عن خليفة بن حصين أن جده قيسا لما أسلم أمره النبي صلى الله عليه وسلم أن يغتسل بماء وسدر وقال النبي صلى الله عليه وسلم لقيس هذا سيد أهل الوبر(@)(@@)(@@)(@@) | 1534 - (@)(@@) قيس بن عباد بصرى تابعي ثقة من كبار التابعين(@)(@@)(@@)(@@) | 1535 - (@)(@@) قيس بن عبد عم الشعبي من أصحاب عبد الله ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1536 - (@)(@@) قيس بن مسلم كوفى ثقة من كبار شيوخ سفيان وشعبة ويقال إنه كان يرى الارجاء(@)(@@)(@@)(@@) | 1537 - (@)(@@) قيس بن وهب كوفي ثقة روى عن مرة الهمداني وكان يميل على على بعض الميل وقد شهد مع على تلك المشاهد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1538 - (@)(@@) قيس الخارفي كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب الكاف)(@)(@@)(@@)(@@) | 1539 - (@)(@@) كامل أبو العلاء كوفى ثقة(@)(@@)(@@)(@@) | (باب كثير)(@)(@@)(@@)(@@) | 1540 
