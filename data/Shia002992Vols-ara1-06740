ms6721	 301.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى إبراهيم بن عمر.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 179.(@)(@@) وروى عنه عبد الله بن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) * وروى عن حماد بن عيسى الجهني، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى حماد بن عيسى.(@)(@@) * وروى عن خالد بن الحجاج، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 137 (الاستبصار:(@)(@@) ج 3، ح 255).(@)(@@) * وروى عن زكريا الخزاز، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 5، ك 2، ب 159، ح 55.(@)(@@) * وروى عن زياد بن مروان، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 4، ب 25، ح 22.(@)(@@) * وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 3، ح 469 (الاستبصار:(@)(@@) ج 1، ح 1869)، و ح 694. PageV21P283(@)(@@) * وروى عن زياد بن مروان القندي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 97، ح 20.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى زياد بن مروان القندي.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 1504 (الاستبصار:(@)(@@) ج 1، ح 1869).(@)(@@) * وروى عن زياد القندي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 4، ك 1، ب 13، ح 1.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 9، ح 1، وب 108، ح 85، و ج 3، ك 4، ب 31، ح 15، و ج 6، ك 6، ب 102، ح 4.(@)(@@) وروى عنه عبد الله بن جعفر.(@)(@@) الكافي: ج 6، ك 6، ب 106، ح 1.(@)(@@) * وروى عن سليمان بن الحسين كاتب علي بن يقطين.(@)(@@) التهذيب: ج 5، ح 1603.(@)(@@) * وروى عن صفوان بن يحيى، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى أبان بن تغلب، ومعاوية بن عمار.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى عيص بن القاسم، وإلى عبد الله بن سليمان، والى أبان بن عثمان.(@)(@@) وروى عنه محمد بن يحيى العطار.(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد.(@)(@@) وروى عنه الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى معاوية بن عمار.(@)(@@) وروى 
ms6722	 عنه الصفار.(@)(@@) التهذيب: ج 7، ح 357 (الاستبصار:(@)(@@) ج 3، ح 289).(@)(@@) وروى عنه العباس بن هلال، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 3، ب 16، ح 4.(@)(@@) * وروى عن عبد الحميد، وروى عنه سهل.(@)(@@) الروضة: ح 178.(@)(@@) * وروى عن عبد ربه بن رافع، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 126.(@)(@@) * وروى عن عبد الله بن جبلة، وروى عنه محمد بن أحمد النهدي.(@)(@@) الكافي: ج 4، ك 3، ب 203، ح 5، و ج 5، PageV21P284(@)(@@) ك 2، ب 40، ح 10. والتهذيب: ج 5، ح 962، و ج 6، ح 1069.(@)(@@) * وروى عن عبد الله بن الفضل النوفلي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 52، ح 6.(@)(@@) * وروى عن عثمان بن عيسى، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1836.(@)(@@) وروى عنه محمد بن موسى.(@)(@@) الكافي: ج 2، ك 4، ب 15، ح 20.(@)(@@) * وروى عن علي بن أحمد، وروى عنه الصفار.(@)(@@) التهذيب: ج 7، ح 1871.(@)(@@) * وروى عن علي بن أسباط، وروى عنه علي بن إبراهيم.(@)(@@) الكافي: ج 3، ك 3، ب 66، ح 5.(@)(@@) والتهذيب: ج 1، ح 928.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 1، ك 4، ب 57، ح 3.(@)(@@) * وروى عن علي بن جعفر، وروى عنه أحمد بن أبي عبد الله.(@)(@@) التهذيب: ج 9، ح 75.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 4، ب 28، ح 4، و ج 6، ك 6، ب 16، ح 7. والتهذيب: ج 9، ح 366.(@)(@@) وروى عنه سعد.(@)(@@) التهذيب: ج 4، ح 390.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 4، ح 358.(@)(@@) * وروى عن علي بن النعمان، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 731 (الاستبصار:(@)(@@) ج 1، ح 1400).(@)(@@) * وروى عن علي بن يقطين، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 6، ك 7، ب 8، ح 1.(@)(@@) * وروى عن عمرو بن إبراهيم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 7، ب 15، ح 14.(@)(@@) والتهذيب: ج 9، ح 454.(@)(@@) * وروى عن عمرو بن عثمان، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 3، ح 106.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 2، ح 480 (الاستبصار:(@)(@@) ج 1، ح 1024، وفيه الصفار فقط).(@)(@@) * وروى عن غياث بن كلوب، وروى عنه الصفار. PageV21P285(@)(@@) التهذيب: ج 9، ح 
ms6723	 1347.(@)(@@) * وروى عن محمد بن إبراهيم النوفلي، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 2، ب 5، ح 8. والتهذيب:(@)(@@) ج 4، ح 564.(@)(@@) * وروى عن محمد بن أبي بكر، وروى عنه الصفار.(@)(@@) التهذيب: ج 8، ح 1114.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 21، ح 16.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 366 (الاستبصار:(@)(@@) ج 1، ح 1197).(@)(@@) وروى عن محمد بن أبي حمزة، أو غيره، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 70، ح 15.(@)(@@) والتهذيب: ج 7، ح 108 (الاستبصار:(@)(@@) ج 3، ح 262، وفيه محمد بن أحمد بن يحيى).(@)(@@) * وروى عن محمد بن أبي عمير، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى يعقوب بن عثيم، وإلى محمد بن حمران، وجميل بن دراج، وإلى حفص بن البختري، وإلى رفاعة بن موسى النخاس، وإلى حماد ابن عثمان، ومحمد بن أبي عمير، ومعاوية ابن عمار. والتهذيب: ج 5، ح 739 (الاستبصار: ج 2، ح 963، وفيه ابن أبي عمير فقط).(@)(@@) وروى عنه عبد الله بن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى حفص بن البختري. والتهذيب: ج 6، ح 120.(@)(@@) وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 4، ح 567، و ج 7، ح 1453 (الاستبصار: ج 3، ح 798، وفيه علي بن الحسن بن فضال)، و ج 8، ح 347، و 712 (الاستبصار: ج 3، ح 762)، و ج 9، ح 733.(@)(@@) وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 1، ح 449 (الاستبصار:(@)(@@) ج 1، ح 449، وفيه ابن أبي عمير فقط)، و ج 4، ح 412، و 680، و ج 9، ح 725، و 946، و 1205 (الاستبصار: ج 4، ح 667).(@)(@@) وروى عنه محمد.(@)(@@) التهذيب: ج 4، ح 971.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1101 (الاستبصار: PageV21P286(@)(@@) ج 3، ح 530).(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى عبد الله ابن سليمان، وإلى أبان بن عثمان، وإلى محمد بن حكيم، وإلى خالد بن أبي العلاء الخفاف وإلى حمزة بن حمران.(@)(@@) والتهذيب: ج 7، ح 1469 (الاستبصار:(@)(@@) ج 3، ح 815، وفيه الصفار فقط).(@)(@@) وروى عنه محمد بن 
ms6724	 يحيى العطار.(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد.(@)(@@) وروى عنه الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى حماد بن عثمان، وإلى معاوية بن عمار، وإلى محمد ابن أبي عميره.(@)(@@) * وروى عن محمد بن أسلم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 5، ك 2، ب 63، ح 2.(@)(@@) * وروى عن محمد بن إسماعيل، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 839 (الاستبصار:(@)(@@) ج 1، ح 1472).(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) الكافي: ج 1، ك 4، ب 54، ح 3.(@)(@@) * وروى عن محمد بن إسماعيل بن بزيع، وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 7، ح 1072 (الاستبصار:(@)(@@) ج 3، ح 501)، و ج 8، ح 623 (الاستبصار: ج 3، ح 1304).(@)(@@) * وروى عن محمد بن جعفر، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 32، ح 12.(@)(@@) * وروى عن محمد بن جعفر العقبي، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 26.(@)(@@) * وروى عن محمد بن جمهور، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 50، ح 13.(@)(@@) * وروى عن محمد بن الحسن بن زياد، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 1277.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى الميثمي.(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 7، ح 356.(@)(@@) * وروى عن محمد بن الحسن الميثمي، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 9، ح 491. PageV21P287(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 6، ك 7، ب 23، ح 6.(@)(@@) * وروى عن محمد بن سنان، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 4، ك 1، ب 16، ح 3.(@)(@@) وروى عنه سعد.(@)(@@) التهذيب: ج 3، ح 819.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 5، ب 15، ح 11.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 2، ح 238، و ج 3، ح 759.(@)(@@) * وروى عن محمد بن شعيب.(@)(@@) الفقيه: ج 4، ح 637.(@)(@@) وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 7، ك 1، ب 36، ح 5.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 1، ح 842، و 898.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 1، ب 4، ح 6، و 7.(@)(@@) * وروى عن محمد بن عمر، وروى عنه محمد بن الحسن 
ms6725	 الصفار.(@)(@@) التهذيب: ج 4، ح 141.(@)(@@) * وروى عن محمد بن عمر بن يزيد، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 13.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 2، ح 480 (الاستبصار:(@)(@@) ج 1، ح 1024، وفيه الصفار فقط).(@)(@@) * وروى عن محمد بن الفضيل، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1247 (الاستبصار:(@)(@@) ج 1، ح 509).(@)(@@) * وروى عن محمد بن مرازم، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 46.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 2، ب 60، ح 2.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 5، ك 2، ب 159، ح 29.(@)(@@) والروضة: ح 163.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 4، ك 2، ب 6، ح 11.(@)(@@) وروى عنه محمد بن أحمد النهدي.(@)(@@) الكافي: ج 5، ك 2، ب 18، ح 5.(@)(@@) * وروى عن محمد بن يزيد، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 3، ح 106. PageV21P288(@)(@@) * روى عن مروك بن عبيد، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 1، ح 94 (الاستبصار: ج 1، ح 140)، و ج 3، ح 160 (الاستبصار:(@)(@@) ج 1، ح 1686).(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) التهذيب: ج 6، ح 1140.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 3، ح 789.(@)(@@) * وروى عن مصعب، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 91، ح 4.(@)(@@) * وروى عن النضر بن سويد، وروى عنه سعد بن عبد الله، وعبد الله ابن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى هشام بن سالم.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) التهذيب: ج 1، ح 1280.(@)(@@) * وروى عن ياسر القمي، وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 4، ح 241 (الاستبصار:(@)(@@) ج 2، ح 161).(@)(@@) * وروى عن يحيى المبارك.(@)(@@) الفقيه: ج 4، ح 864. والتهذيب: ج 9، ح 1119 (الاستبصار: ج 4، ح 617).(@)(@@) وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 80، ح 3، وب 126، ح 3، وك 7، ب 7، ح 6.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 2، ب 74، ح 5.(@)(@@) وروى عنه عبد الله بن جعفر.(@)(@@) الكافي: ج 6، ك 7، ب 7، ح 6.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 4، ك 3، ب 212، ح 20، و ج 7، ك 
ms6726	 1، ب 4، ح 5، وك 3، ب 48، ح 9، و 10، وك 6، ب 1، ح 2، وك 7، ب 17، ح 15، و 16. والتهذيب: ج 5، ح 1578، و ج 9، ح 749، و ج 10، ح 573.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 901 (الاستبصار:(@)(@@) ج 2، ح 1061)، و ج 6، ح 509.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 6، ح 334، و ج 7، ح 1377 (الاستبصار: ج 3، ح 734)، و ج 9، ح 352، و ج 10، ح 513، و 604.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 5، ح 933. PageV21P289(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 10، ح 1069 (الاستبصار:(@)(@@) ج 4، ح 1110).(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) التهذيب: ج 8، ح 1118، و 1139.(@)(@@) وروى عنه موسى بن الحسن.(@)(@@) الكافي: ج 3، ك 3، ب 7، ح 2.(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 4، ح 1048.(@)(@@) * وروى عن يزيد بن حماد، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 163.(@)(@@) * وروى عن الحجال، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1158.(@)(@@) * وروى عن الغفاري.(@)(@@) التهذيب: ج 1، ح 1538.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 63، ح 1.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 700.(@)(@@) * وروى عن القندي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 102، ح 9.(@)(@@) * وروى عن الوشاء، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 88، ح 2.(@)(@@) وروى عنه محمد بن موسى.(@)(@@) التهذيب: ج 4، ح 910 (الاستبصار:(@)(@@) ج 2، ح 441).(@)(@@) * وروى عن أبي عبد الله مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 3، ب 157، ح 9.(@)(@@) * وروى عن بعض أصحابنا، عن أبي عبد الله عليه السلام، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 5، ك 3، ب 82، ح 12.(@)(@@) والتهذيب: ج 7، ح 1292 (الاستبصار:(@)(@@) ج 4، ح 1111).(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله عليه السلام، وروى عنه محمد ابن أحمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 1213.(@)(@@) * وروى عن رجل، عن أبي عروة أخي شعيب، أو عن شعيب العقرقوفي، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 224.(@)(@@) * وروى عن عدة من أصحابنا، عن PageV21P290(@)(@@) أبي عبد الله عليه 
ms6727	 السلام، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 4، ب 26، ح 4.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 21، ح 2.(@)(@@) والتهذيب: ج 1، ح 937.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 1465 (الاستبصار:(@)(@@) ج 1، ح 745).(@)(@@) * وروى عن عدة من أصحابنا، عن علي بن أسباط، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 814 (الاستبصار:(@)(@@) ج 1، ح 1464).(@)(@@) وروى مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 1، ب 28، ح 11، و ج 6، ك 8، ب 48، ح 14. والتهذيب: ج 6، ح 357.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 3، ب 7، ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 76، ح 8.(@)(@@) وروى عنه سهل بن زياد الآدمي.(@)(@@) الكافي: ج 6، ك 6، ب 6، ح 6.(@)(@@) وروى مرفوعا عن أمير المؤمنين عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 7، ب 11، ح 3.(@)(@@) * وروى عمن ذكره عن أبي عبد الله عليه السلام، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 203، و ح 23، و ج 5، ك 2، ب 63، ح 4.(@)(@@) وروى سهل بن زياد، عن يعقوب ابن يزيد أو غيره، عن سليمان كاتب علي ابن يقطين.(@)(@@) الروضة: ح 187.(@)(@@) يعقوب بن يقطين * روى عن أبي الحسن عليه السلام، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 3، ك 4، ب 55، ح 4.(@)(@@) والتهذيب: ج 1، ح 402، و 559 (الاستبصار: ج 1، ح 551)، و ج 3، ح 777، و ج 7، ح 1112 (الاستبصار:(@)(@@) ج 3، ح 534).(@)(@@) وروى عنه النضر.(@)(@@) التهذيب: ج 1، ح 448 (الاستبصار: PageV21P291(@)(@@) ج 1، ح 448).(@)(@@) * وروى عن العبد الصالح عليه السلام، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 3، ك 4، ب 31، ح 14.(@)(@@) والتهذيب: ج 1، ح 1444 (الاستبصار:(@)(@@) ج 1، ح 731)، و ج 2، ح 483، و 552 (الاستبصار: ج 1، ح 1093، وفيه محمد ابن الحسين، بدل الحسين بن سعيد، وأيضا فيه أبو الحسن موسى عليه السلام، بدل العبد الصالح عليه السلام)، و ج 3، ح 36 (الاستبصار:(@)(@@) ج 1، ح 1567)، و ح 287 (الاستبصار:(@)(@@) ج 1، ح 1737).(@)(@@) وروى عنه محمد بن الحسين. 
ms6728	(@)(@@) التهذيب: ج 2، ح 155 (الاستبصار:(@)(@@) ج 1، ح 1093، وفيه أبو الحسن موسى عليه السلام).(@)(@@) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 1، ح 53 (الاستبصار: ج 1، ح 306).(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 50، ح 8.(@)(@@) وروى عنه محمد بن عيسى اليقطيني.(@)(@@) التهذيب: ج 1، ح 871.(@)(@@) * وروى عن علي بن يقطين أخيه، وروى عنه الحسن بن علي بن يقطين.(@)(@@) الكافي: ج 1، ك 7، ب 22، ح 1.(@)(@@) يعقوب السراج * روى عن أبي عبد الله عليه السلام، وروى عنه ابن محبوب.(@)(@@) الكافي: ج 2، ك 1، ب 123، ح 4، و ج 6، ك 2، ب 82، ح 3، وك 8، ب 17، ح 14.(@)(@@) والروضة: ح 23، و 285. والتهذيب:(@)(@@) ج 8، ح 948.(@)(@@) وروى عنه الحسن بن محبوب.(@)(@@) الكافي: ج 1، ك 4، ب 83، ح 1.(@)(@@) والتهذيب: ج 8، ح 311.(@)(@@) وروى عنه محمد بن سنان.(@)(@@) الكافي: ج 1، ك 4، ب 71، ح 11.(@)(@@) * وروى عن جابر، وروى عنه ابن محبوب.(@)(@@) الكافي: ج 2، ك 1، ب 25، ح 1.(@)(@@) وروى عنه الحسن بن محبوب.(@)(@@) الكافي: ج 2، ك 1، ب 24، ح 1. PageV21P292(@)(@@) يوسف بن عقيل * روى عن عاصم بن حميد، وروى عنه النضر بن سويد.(@)(@@) التهذيب: ج 9، ح 1283.(@)(@@) * وروى عن محمد بن قيس، وروى أبو جعفر، عن أبيه، عنه.(@)(@@) التهذيب: ج 9، ح 823.(@)(@@) وروى عنه الحسن.(@)(@@) التهذيب: ج 4، ح 809.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 4، ح 839، و ج 6، ح 457، و ج 7، ح 133 (الاستبصار: ج 3، ح 249)، و ح 206، و 420، و ج 8، ح 985، و ج 9، ح 279 (الاستبصار:(@)(@@) ج 4، ح 312)، و ح 595 (الاستبصار:(@)(@@) ج 4، ح 401)، و ح 720، و 876، و ج 10، ح 945.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 159، ح 2، و ج 4، ك 2، ب 73، ح 1، و ج 5، ك 3، ب 169، ح 3، و ج 7، ك 3، ب 45، ح 15، وك 6، ب 19، ح 11. والتهذيب: ج 2، ح 362، و ج 3، ح 871، و ج 4، ح 525، و ج 9، ح 1280 (الاستبصار: ج 4، ح 703)، و ج 10، ح 92، و 517.(@)(@@) وروى عنه النضر.(@)(@@) التهذيب: ج 10، ح 439.(@)(@@) * وروى عن موسى بن حبيب، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 7، ب 36، ح 21.(@)(@@) يونس * روى عن أبي عبد الله عليه 
ms6729	 السلام وروى عنه ابن فضال.(@)(@@) الكافي: ج 4، ك 3، ب 21، ح 3، وب 202، ح 10. والتهذيب: ج 5، ح 950.(@)(@@) وروى عنه الحسين بن أحمد المنقري.(@)(@@) التهذيب: ج 7، ح 1833.(@)(@@) * وروى عنه محمد بن حباب.(@)(@@) التهذيب: ج 1، ح 1523.(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الروضة: ح 81.(@)(@@) وروى عنه محمد بن الوليد.(@)(@@) التهذيب: ج 4، ح 679.(@)(@@) * وروى عن أبي الحسن عليه PageV21P293(@)(@@) السلام، وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 3، ك 5، ب 6، ح 4. والتهذيب:(@)(@@) ج 7، ح 1209 (الاستبصار: ج 3، ح 622، وفيه أبو الحسن الرضا عليه السلام).(@)(@@) وروى عنه عبد العزيز بن المهتدي.(@)(@@) الكافي: ج 3، ك 3، ب 5، ح 2.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 1، ب 46، ح 12، و ج 6، ك 8، ب 5، ح 11، و ج 7، ك 4، ب 35، ح 5. والتهذيب: ج 1، ح 627 (الاستبصار: ج 1، ح 27)، و ج 6، ح 219، و ج 10، ح 1107 (الاستبصار:(@)(@@) ج 4، ح 1124)، و ح 1135.(@)(@@) * وروى عن أبي الحسن موسى عليه السلام، وروى عنه أحمد الخراساني.(@)(@@) الكافي: ج 3، ك 3، ب 60، ح 2.(@)(@@) * وروى عن أبي الحسن الماضي عليه السلام.(@)(@@) التهذيب: ج 10، ح 130 (الاستبصار:(@)(@@) ج 4، ح 791، و 841، وفي الأخير، يونس ابن عبد الرحمن)، و ح 228 (الاستبصار:(@)(@@) ج 4، ح 791، و 841، وفي الأخير يونس ابن عبد الرحمن).(@)(@@) وروى الريان بن الصلت، أو رجل عنه، عنه.(@)(@@) التهذيب: ج 7، ح 1015.(@)(@@) وروى عنه صفوان.(@)(@@) الكافي: ج 7، ك 3، ب 12، ح 2، وب 33، ح 6.(@)(@@) وروى عنه صفوان بن يحيى.(@)(@@) الفقيه: ج 4، ح 182.(@)(@@) وروى عنه عبد الله بن الصلت.(@)(@@) الروضة: ح 461.(@)(@@) * وروى عن العبد الصالح عليه السلام، وروى الريان بن الصلت، أو رجل عنه، عنه.(@)(@@) الكافي: ج 5، ك 2، ب 152، ح 1.(@)(@@) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه أحمد بن أشيم.(@)(@@) التهذيب: ج 1، ح 980.(@)(@@) وروى عنه أحمد بن الفضل.(@)(@@) الكافي: ج 6، ك 6، ب 6، ح 9.(@)(@@) وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 5، ك 2، ب 113، ح 10، وك 3، ب 84، ح 5. والتهذيب: ج 7، ح 958 (الاستبصار: ج 3، ح 473).(@)(@@) وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 6، ك 4، ب 12، ح 13.(@)(@@) والتهذيب: ج 9، ح 7. PageV21P294(@)(@@) وروى عنه 