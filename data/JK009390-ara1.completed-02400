ms2386	 النار كما بين السماء والأرض ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22255 ) قال النبي :(@)(@@) | 30 ( من صام أول يوم من رجب عدل ذالك بصيام سنة ، ومن صام سبعة أيام أغلق عنه سبعة أبواب النيران ، ومن صام من رجب عشرة أيام نادى مناد من السماء أن سل تعطه ) )(@)(@@) أبو نعيم وابن عساكر عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22256 ) قال النبي :(@)(@@) | 30 ( من صام يوما من رجب عدل صيام شهر ، ومن صام منه سبعة أيام أغلقت عنه أبواب الجحيم السبعة ، ومن صام منه ثمانية أيام فتحت له أبواب الجنة الثمانية ، ومن صام منه عشرة أيام بدل الله سيئاته حسنات ، ومن صام منه ثمانية عشر يوما نادى مناد أن الله قد غفر لك ما مضى فاستأنف العمل ) )(@)(@@) الخطيب عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22257 ) قال النبي :(@)(@@) | 30 ( من صام يوما من رجب كان كصيام سنة ، ومن PageV07P253 صام سبعة أيام غلقت عنه سبعة أبواب جهنم ، ومن صام ثمانية أيام فتحت له ثمانية أبواب الجنة ، ومن صام عشرة أيام لم يسأل الله شيئا إلا أعطاه ، ومن صام خمسة عشر يوما نادى مناد من السماء : قد غفرت لك ما سلف فاستأنف العمل ، قد بدلت سيئاتك حسنات ، ومن زاد زاده الله . وفي رجب حمل نوح بالسفينة فصام نوح وأمر من معه أن يصوموا وجرت بهم السفينة ستة أشهر إلى آخر ذالك لعشر خلون من المحرم ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22258 ) قال النبي :(@)(@@) | 30 ( من صبر على لأواء المدينة وجهدها كنت له شهيدا أو شفيعا يوم القيامة لينحازن الإيمان إلى المدينة كما ينحاز السيل الدمن ) )(@)(@@) ( عب ) عن عروة مرسلا .(@)(@@)(@@)(@@) $ ( 22259 ) قال النبي :(@)(@@) | 30 ( من صبغ بالسواد لم ينظر الله إليه يوم القيامة ، ومن نتف شيبه قمعه الله بمقامع من نار يوم القيامة ) )(@)(@@) ( كر ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22260 ) قال النبي :(@)(@@) | 30 ( من صدق الله تعالى نجا ، ومن عرفه اتقى ، ومن أحبه استحيى ، ومن رضي بقسمته استغنى ، ومن حذره أمن 
ms2387	 ، ومن أطاعه فاز ، ومن توكل عليه اكتفى ، ومن كانت همته عند نومه ويقظته لا إلاه إلا الله وكانت الدنيا تحثه على الآخرة وتحذره الفاقرة ) )(@)(@@) أبو عبد الرحمان السلمي عن الحكم بن عمير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22261 ) قال النبي :(@)(@@) | 30 ( من صلى في مسجد قباء كان له كأجر عمرة ) )(@)(@@) ( عق ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P254(@)(@@)(@@)(@@) $ ( 22262 ) قال النبي :(@)(@@) | 30 ( من صلى في مسجد قباء يوم الاثنين ويوم الخميس انقلب بايجر عمرة ) )(@)(@@) ابن سعد عن ظهير بن رافع الحاربي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22263 ) قال النبي :(@)(@@) | 30 ( من صلى الصلوات الخمس يتم ركوعهن وسجودهن ، وصام رمضان ، كان حقا على الله أن يغفر له ، إن هاجر في سبيل الله أو مكث في أرضه التي ولد بها ) )(@)(@@) ( حم ) و محمد بن نصر عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22264 ) قال النبي :(@)(@@) | 30 ( من صلى ركعتين يتم ركوعه وسجوده لم يسأل الله تعالى شيئا إلا أعطاه إياه عاجلا أو آجلا ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22265 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح فهو في ذمة الله ، يا ابن آدم لا يطلبنك الله بشيء من ذمته ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22266 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح في جماعة فهو في ذمة الله ، فمن أخفر ذمة الله كبه الله في النار على وجهه ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22267 ) قال النبي :(@)(@@) | 30 ( من صلى في مسجد جماعة أربعين ليلة ، لا تفوته الركعة الأولى من صلاة الظهر ، كتب الله له بها عتقا من النار ) )(@)(@@) ( هب ) و ابن عساكر وابن النجار عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22268 ) قال النبي :(@)(@@) | 30 ( من صلى صلاة الصبح فهو في ذمة الله تعالى فلا تخفروا الله في ذمته فإنه من أخفر ذمته طلبه الله تعالى حتى يكبه على وجهه ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22269 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة فهو في ذمة الله ، فإياكم أن PageV07P255 يطلبكم الله بشيء من ذمته ) )(@)(@@) ( حل ) عن 
ms2388	 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22270 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر ثم جلس في مصلاه يذكر الله تعالى صلت عليه الملائكة ، وصلاتهم عليه : اللهم اغفر له ، اللهم ارحمه ، ومن جلس ينتظر الصلاة صلت عليه الملائكة ، وصلاتهم عليه : اللهم اغفر له ، اللهم ارحمه ) )(@)(@@) ( حم ) و ابن جرير وصححه ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22271 ) قال النبي :(@)(@@) | 30 ( من صلى قبل طلوع الشمس وقبل غروبها ، وشهد أن لا إلاه إلا الله دخل الجنة ) )(@)(@@) ( طس ) عن عمارة بن رويبة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22272 ) قال النبي :(@)(@@) | 30 ( من صلى في مسجدي أربعين صلاة لا تفوته صلاة ، كتبت له براءة من النار ، وبراءة من العذاب ، وبراءة من النفاق ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22273 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة والعشاء الآخرة في جماعة لا تفوته ركعة كتب له براءتان : براءة من النار ، وبراءة من النفاق ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22274 ) قال النبي :(@)(@@) | 30 ( من صلى العصر وجلس على خير حتى يمسي ، كان أفضل ممن أعتق ثمانية من ولد إسماعيل ) )(@)(@@) ( حم هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22275 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة فهو في ذمة الله ، فإياكم أن يطلبكم الله بشيء من ذمته ) )(@)(@@) الحكيم ( ع ) عن أنس رضي الله عنه .(@)(@@) PageV07P256(@)(@@)(@@)(@@) $ ( 22276 ) قال النبي :(@)(@@) | 30 ( من صلى أربعين يوما صلاة الفجر وعشاء الآخرة في جماعة ، أعطاه الله براءتين : براءة من النار ، وبراءة من النفاق ) )(@)(@@) الخطيب وابن عساكر وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22277 ) قال النبي :(@)(@@) | 30 ( من صلى في يوم اثنتي عشرة ركعة حرم الله لحمه على النار ) )(@)(@@) ( ع ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22278 ) قال النبي :(@)(@@) | 30 ( من صلى الخمس فليس من الغافلين ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22279 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح فهو في ذمة الله ، فلا تخفروا الله في ذمته ) )(@)(@@) أبو نعيم عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22280 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة فهو في ذمة الله ، فلا تخفروا 
ms2389	 الله تعالى في ذمته ) )(@)(@@) ( حم ) و الروياني ( ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22281 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة فله ذمة الله ، ومن يخفر ذمة الله كنت خصمه ، ومن خاصمته خصمته ) )(@)(@@) ( طب ) عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22282 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة فهو في ذمة الله ، فاتق الله يا ابن آدم أن يطلبك الله بشيء من ذمته ) )(@)(@@) ( حب ) عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22283 ) قال النبي :(@)(@@) | 30 ( من صلى صلاة الفجر ثم جلس في مصلاه حتى تطلع الشمس كان له حجاب من النار ) )(@)(@@) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22284 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح فهو في ذمة الله ، فلا تخفروا الله PageV07P257 في عهده ، فمن قتله طلبه الله حتى يكبه في النار على وجهه ) )(@)(@@) ( ه ) و ابن عساكر عن أبي بكر الصديق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22285 ) قال النبي :(@)(@@) | 30 ( من صلى العشاء والغداة في جماعة فكأنما قام الليل ) )(@)(@@) ( حب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22286 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح فهو مؤمن وهو في جوار الله ، فلا تخفروا الله في جواره ) )(@)(@@) ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22287 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح ثم قعد يذكر الله حتى تطلع الشمس ، جعل الله بينه وبين النار سترا ) )(@)(@@) عن السيد الحسن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22288 ) قال النبي :(@)(@@) | 30 ( من صلى العشاء الآخرة في جماعة فكأنما صلى الليل كله ، ومن صلى الغداة في جماعة فكأنما صلى النهار كله ) )(@)(@@) ( طب ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22289 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح قبل أن تطلع الشمس فليمض في صلاته ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22290 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح في مسجد جماعة ، ثم مكث حتى يسبح سبحة الضحى ، كان له كأجر حاج ومعتمر تام له حجته وعمرته ) )(@)(@@) ( طب ) عن أبي أمامة وعتبة بن عبد رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22291 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة في جماعة ثم جلس يذكر الله 
ms2390	 حتى تطلع الشمس ، ثم قام يركع ركعتين انقلب بأجر حجة وعمرة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22292 ) قال النبي :(@)(@@) | 30 ( من صلى ليلة القدر : العشي والفجر في جماعة ، فقد أخذ من ليلة القدر بالنصيب الوافر ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@) PageV07P258(@)(@@)(@@)(@@) $ ( 22293 ) قال النبي :(@)(@@) | 30 ( من صلى من أول شهر رمضان إلى آخره جماعة فقد أخذ بحظه من ليلة القدر ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22294 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر ثم قعد يذكر الله حتى تطلع الشمس وجبت له الجنة ) )(@)(@@) ابن السني وابن النجار عن سهيل بن معاذ عن أبيه .(@)(@@)(@@)(@@) $ ( 22295 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر ثم قعد في مجلسه يذكر الله تعالى حتى تطلع الشمس ، ثم قام فصلى ركعتين حرمه الله على النار أن تلفحه ) )(@)(@@) ( هب ) عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22296 ) قال النبي :(@)(@@) | 30 ( من صلى الغداة ثم ذكر الله حتى تطلع الشمس ، ثم قام فصلى ركعتين أو أربع ركعات لم تمس جلده النار ) )(@)(@@) ( هب ) عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22297 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح ثم قرأ { قل هو الله أحد } مائة مرة قبل أن يتكلم ، فكلما قرأ { قل هو الله أحد } غفر له ذنب سنة ) )(@)(@@) ابن السني ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22298 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر فقعد في مقعده ، فلم يلغ بشيء من أمر الدنيا يذكر الله عز وجل حتى يصلي الضحى أربع ركعات ، خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) ابن السني عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22299 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر في جماعة وجلس في محرابه فقرأ مائة مرة { قل هو الله أحد } غفر الله له الذنوب التي بينه وبين الله ، التي لا PageV07P259 يطلع عليها إلا الله ) )(@)(@@) الديلمي عن أنس رضي الله عنه وقال : حديث غريب وإسناده صحيح تفرد به أبو جعفر محمد بن عبد الله بن برزة عن الحارث بن أبي أسامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22300 ) قال 
ms2391	 النبي :(@)(@@) | 30 ( من صلى الصلوات لوقتها وأسبغ لها وضوءها ، وأتم لها قيامها وخشوها وركوعها وسجودها خرجت وهي بيضاء مسفرة تقول : حفظك الله كما حفظتني ، ومن صلى الصلوات لغير وقتها ولم يسبغ لها وضوءها ، ولم يتم لها خشوعها ولا ركوعها ولا سجودها ، خرجت وهي سوداء مظلمة تقول : ضيعك الله كما ضيعتني ، حتى إذا كانت حيث شاء الله ، لفت كما يلف الثوب الخلق ثم ضرب بها وجهه ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22301 ) قال النبي :(@)(@@) | 30 ( من صلى الفجر في جماعة وقعد في مصلاه وقرأ ثلاث آيات من أول سورة الأنعام وكل الله به سبعين ملكا يسبحون الله ويستغفرون له إلى يوم القيامة ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22302 ) قال النبي :(@)(@@) | 30 ( من صلى قبل الظهر أربعا كن له كعتق رقبة من بني إسماعيل ) )(@)(@@) ( ش طب ) عن عمر الأنصاري عن أبيه .(@)(@@)(@@)(@@) $ ( 22303 ) قال النبي :(@)(@@) | 30 ( من صلى أربعا قبل الظهر كان له أجره كعتق رقبة أو قال : أربع رقبات من ولد إسماعيل ) )(@)(@@) ( طس ) عن صفوان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22304 ) قال النبي :(@)(@@) | 30 ( من صلى قبل الظهر أربع ركعات كأنما تهجد بهن من ليلته ، ومن صلاهن بعد العشاء كن له كمثلهن من ليلة القدر ) )(@)(@@) ( طس ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22305 ) قال النبي :(@)(@@) | 30 ( من صلى أربعا قبل الظهر وأربعا بعده لم تمسه النار ) )(@)(@@) ابن جرير عن أم حبيبة رضي الله عنها .(@)(@@) PageV07P260(@)(@@)(@@)(@@) $ ( 22306 ) قال النبي :(@)(@@) | 30 ( من صلى قبل العصر أربع ركعات غفر الله له مغفرة عزما ) )(@)(@@) أبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22307 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات قبل العصر حرم الله بدنه على النار ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22308 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات قبل العصر حرم الله شحمه على النار ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22309 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات قبل العصر لم تمسه النار ) )(@)(@@) ( طس ) عن ابن عمرو ، وفيه حجاج بن نصير 
ms2392	 ضعفه الأكثرون .(@)(@@)(@@)(@@) $ ( 22310 ) قال النبي :(@)(@@) | 30 ( من صلى بعد المغرب ركعتين قبل أن ينطق مع أحد ، يقرأ في الأولى ب { الحمد } و { قل يا أيها الكافرون } ، وفي الركعة الثانية ب { الحمد } و { قل هو الله أحد } خرج من ذنوبه كما تخرج الحية من سلخها ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22311 ) قال النبي :(@)(@@) | 30 ( من صلى المغرب في جماعة كتب له حجة مبرورة ، وعمرة متقبلة ، وكأنما قام ليلة القدر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22312 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات بعد المغرب كان كمن عقب غزوة بعد غزوة في سبيل الله عز وجل ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P261(@)(@@)(@@)(@@) $ ( 22313 ) قال النبي :(@)(@@) | 30 ( من صلى المغرب وصلى بعدها ركعتين قبل أن يتكلم أسكنه الله في حظيرة القدس ، فإن صلى أربعا كان كمن حج حجة بعد حجة ، فإن صلى ستا غفر له ذنوب خمسين سنة ) )(@)(@@) ابن شاهين عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22314 ) قال النبي :(@)(@@) | 30 ( من صلى عشرين ركعة بين المغرب والعشاء يقرأ في كل ركعة فاتحة الكتاب و { قل هو الله أحد } حفظه الله في نفسه وماله ودنياه وآخرته ) )(@)(@@) نظام الملك في السداسيات عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22315 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات بعد المغرب قبل أن يكلم أحدا رفعت له في عليين ، وكان كمن أدرك ليلة القدر في المسجد الأقصى ، وهي خير من قيام نصف ليلة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22316 ) قال النبي :(@)(@@) | 30 ( من صلى في اليوم والليلة اثنتي عشرة ركعة تطوعا بنى الله له بيتا في الجنة ) )(@)(@@) ( حم ش ) و ابن زنجويه ( م د ن ه ) وابن جرير عن أم حبيبة ، ( ن عق ) عن أبي هريرة ، ( حم طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22317 ) قال النبي :(@)(@@) | 30 ( من صلى ثنتي عشرة ركعة من النهار يحافظ عليهن ، بنى الله له بيتا في الجنة ) )(@)(@@) ابن النجار عن عائشة رضي الله 
ms2393	 عنها .(@)(@@)(@@)(@@) $ ( 22318 ) قال النبي :(@)(@@) | 30 ( من صلى في يوم ثنتي عشرة ركعة بنى الله له بيتا في الجنة ، ومن بنى لله مسجدا بنى الله له بيتا في الجنة ) )(@)(@@) ( طب ) عن أم حبيبة رضي الله عنها .(@)(@@) PageV07P262(@)(@@)(@@)(@@) $ ( 22319 ) قال النبي :(@)(@@) | 30 ( من صلى يوم الجمعة وصام يومه ، وعاد مريضا ، وشهد جنازة ، وشهد نكاحا وجبت له الجنة ) )(@)(@@) ( طب ) و أبو سعد السمان في مشيخته عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22320 ) قال النبي :(@)(@@) | 30 ( من صلى الجمعة كتبت له حجة متقبلة ، فإن صلى العصر كانت له عمرة ، فإن يمسي في مكانه لم يسأل الله شيئا إلا أعطاه ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22321 ) قال النبي :(@)(@@) | 30 ( من صلى ثنتي عشرة ركعة مع صلاة النهار بنى الله له بيتا في الجنة ) )(@)(@@) ( كر ) عن أم حبيبة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22322 ) قال النبي :(@)(@@) | 30 ( من صلى ركعتين في السر رفع الله عنه اسم النفاق ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22323 ) قال النبي :(@)(@@) | 30 ( من صلى ركعتين ليلة الجمعة قرأ بفاتحة الكتاب وخمس عشرة مرة { ذا زلزلت } أمنه الله من عذاب القبر ، ومن أهوال يوم القيامة ) )(@)(@@) أبو سعد الإدريسي في تاريخ سمرقند ، وابن النجار والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22324 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات خلف العشاء الآخرة ، فقرأ في الركعتين الأوليين : { قل يا أيها الكافرون } و { قل هو الله أحد } ، وقرأ في الأخريين : { تبارك الذي بيده الملك } و { الم تنزيل . . . } كتبن PageV07P263 له كأربع ركعات من ليلة القدر ) )(@)(@@) ابن نصر وأبو الشيخ ( طب هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22325 ) قال النبي :(@)(@@) | 30 ( من صلى العشاء في جماعة ، وصلى أربع ركعات قبل أن يخرج من المسجد ، كان كعدل ليلة القدر ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22326 ) قال النبي :(@)(@@) | 30 ( من صلى العشاء الآخرة في جماعة في رمضان فقد أدرك ليلة القدر ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22327 ) قال النبي :(@)(@@) | 30 ( من صلى المغرب والعشاء 
ms2394	 في جماعة حتى ينقضي شهر رمضان فقد أصاب من ليلة القدر بحظ وافر ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22328 ) قال النبي :(@)(@@) | 30 ( من صلى أربع ركعات بعد العشاء ثم أوتر فنام على وتره ، فهو في صلاة حتى يصبح ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22329 ) قال النبي :(@)(@@) | 30 ( من صلى ثنتي عشرة ركعة بنى الله له بها قصرا في الجنة من ذهب ) )(@)(@@) ( ت ) غريب ، ( ه ) و ابن جرير عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22330 ) قال النبي :(@)(@@) | 30 ( من صلى الضحى وصام ثلاثة أيام من الشهر ، ولم يترك الوتر في سفر ولا حضر كتب له أجر شهيد ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22331 ) قال النبي :(@)(@@) | 30 ( من صلى الضحى ركعتين لم يكتب من الغافلين ، ومن صلى أربعا كتب من القانتين ، ومن صلى ستا كفي ذالك اليوم ، ومن صلى ثمانيا كتبه الله تعالى من العابدين ، ومن صلى ثنتي عشرة ركعة بنى الله له بيتا في الجنة ، وما من يوم ولا ليلة إلا لله من يمن به على عباده وصدقة ، وما من الله على PageV07P264 أحد من عباده أفضل من أن يلهمه ذكره ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22332 ) قال النبي :(@)(@@) | 30 ( من صلى من الضحى عشر ركعات ، بني له بيت في الجنة ) )(@)(@@) ابن جرير عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22333 ) قال النبي :(@)(@@) | 30 ( من صلى الصلوات الخمس فأتمهن وأقامهن وصلاهن لوقتهن ، جاء يوم القيامة وله على الله عهد أن لا يعذبه ، ومن لم يصلهن ولم يقمهن جاء يوم القيامة وليس له على الله عهد ، إن شاء غفر له ، وإن شاء عذبه ) )(@)(@@) ( ص ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22334 ) قال النبي :(@)(@@) | 30 ( من صلى في ليلة بمائة آية لم يكتب من الغافلين ، ومن صلى في ليلة بمائتي آية كتب من القانتين المخلصين ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22335 ) قال النبي :(@)(@@) | 30 ( من صلى صلاة فلم تأمره بالمعروف ، ولم تنهه عن الفحشاء والمنكر 
ms2395	 ، لم يزدد بها من الله إلا بعدا ) )(@)(@@) ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 22336 ) قال النبي :(@)(@@) | 30 ( من صلى وهو منتعل ناداه ملك : يا عبد الله استأنف العمل فقد غفر الله لك ما تقدم من ذنبك ) )(@)(@@) جعفر بن محمد بن جعفر الحسيني وفي كتاب العروس ، والديلمي من طريقه عن نافع عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22337 ) قال النبي :(@)(@@) | 30 ( من صلى ليلة الفطر والأضحى لم يمت قلبه يوم تموت القلوب ) )(@)(@@) ( طس ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22338 ) قال النبي :(@)(@@) | 30 ( من صلى الصبح كان في جوار الله حتى يمسي ، ومن صلى صلاة العصر كان في جواره فلا تخفروا الله في جواره ، فإن من يخفر الله في جواره يطلبه الله ثم يدركه ، ثم يكبه على منخره ) )(@)(@@) نعيم بن حماد في الفتن PageV07P265 عن زيد بن أسلم عمن حدثه مرسلا .(@)(@@)(@@)(@@) $ ( 22339 ) قال النبي :(@)(@@) | 30 ( من صلى بعد المغرب ثنتي عشرة ركعة ، يقرأ في كل ركعة { قل هو الله أحد } أربعين مرة صافحته الملائكة يوم القيامة ، ومن صافحته الملائكة يوم القيامة أمن الصراط والحساب والميزان ) )(@)(@@) السمرقندي عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22340 ) قال النبي :(@)(@@) | 30 ( من صلى علي مرة واحدة كتب الله له بها عشر حسنات ) )(@)(@@) ( حم حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22341 ) قال النبي :(@)(@@) | 30 ( من صلى علي صلى الله عليه عشرا ، بها ملك موكل حتى يبلغنيها ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22342 ) قال النبي :(@)(@@) | 30 ( من صلى علي صلاة صلى الله عليه ، فأكثروا أو أقلوا ) )(@)(@@) الحاكم في الكنى ، ( طب ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22343 ) قال النبي :(@)(@@) | 30 ( من صلى علي صلاة صلى الله عليه وملائكته بها سبعين صلاة ، فليقل عبد من ذالك أو ليكثر ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22344 ) قال النبي :(@)(@@) | 30 ( من صلى علي صلاة صلى الله عليه بها عشرا ، فليكثر علي عبد من الصلاة أو ليقل ) )(@)(@@) ( عب ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22345 ) قال النبي 
