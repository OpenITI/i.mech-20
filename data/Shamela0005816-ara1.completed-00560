ms541	 الكوفة(@)(@@)(@@)(@@) $ 2409 - حريز الكندي الشامي يروي المراسيل روى حريز بن عثمان عن عمرو بن قيس عنه(@)(@@)(@@)(@@) $ 2410 - حنين مولى السابين أدرك زمن عثمان روى عن بعض أصحاب النبي صلى الله عليه وسلم روى عنه ابنه نافع بن حنين وعطاء PageV04P186(@)(@@)(@@)(@@) $ 2411 - حنين بن أبي المغيرة يروي عن أبي رافع روى عنه عمرو بن أبي عمرو(@)(@@)(@@)(@@) $ 2412 - حجير بن الربيع العدوى البصري يروي عن عمر وعمران بن حصين روى عنه حميد بن هلال وأبو نعامة وهم إخوة أربعة حجير وحريث ويعقوب وسليمان بنو الربيع(@)(@@)(@@)(@@) $ 2413 - حازم بن جابر يروي عن بن مسعود روى عنه أبو حصين(@)(@@)(@@)(@@) $ 2414 - حازم بن هشام يروي عن أبي عسيب صاحب النبي صلى الله عليه وسلم روى عنه التبوذكي(@)(@@)(@@)(@@) $ 2415 - حزم بن عبد الخثعمي يروي عن عبد الله بن عمرو روى عنه أبو سهيل بن مالك وهو الذي يقال له حرام بن عبد عمرو(@)(@@)(@@)(@@) $ 2416 - حزم بن أبي كعب يروي عن معاذ بن جبل روى عنه بن جابر(@)(@@)(@@)(@@) $ 2417 - حزن بن بشير الخثعمي يروي عن البراء روى عنه الثوري وشريك ثنا يوسف بن يعقوب المقري بواسط قال ثنا زكريا بن PageV04P187 يحيى وحمويه قال ثنا شريك عن حزن بن بشر قال رأيت على البراء بن عازب عمامة سوداء(@)(@@)(@@)(@@) $ 2418 - حنان بن خارجة السلمي يروي عن عبد الله بن عمرو روى عنه العلاء بن عبد الله بن رافع(@)(@@)(@@)(@@) $ 2419 - حديج بن صرمي الحميري يروي عن عبد الله بن عمرو روى عنه سهيل بن حسان والإفريقي(@)(@@)(@@)(@@) $ 2420 - حديج بن عمرو يروي عن المستورد بن شداد روى عنه الحارث بن يزيد(@)(@@)(@@)(@@) $ 2421 - حزام بن حكيم بن حزام يروي عن أبيه روى عنه زيد بن رفيع الجزري وعطاء بن أبي رباح(@)(@@)(@@)(@@) $ 2422 - حزام بن دراج يروي عن علي بن أبي طالب PageV04P188 رضى الله عنه روى عنه الزهري وقد قيل حرام بن دراج(@)(@@)(@@)(@@) $ 2423 - حطان بن عبد الله الرقاشي بصرى يروي عن على وأبي موسى روى عنه الحسن ويونس بن جبير مات في خلافة 
ms542	 عبد الملك وولاية بشر بن مروان على العراق(@)(@@)(@@)(@@) $ 2424 - حطان بن خفاف أبو الجويرية الجرمي وجرم من اليمن يروي عن بن عباس روى عنه الثوري وشعبة(@)(@@)(@@)(@@) $ 2425 - حارثة بن سليم يروي عن بن الزبير روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 2426 - أبو عشانة اسمه حي بن يؤمن المعافري مصري يروي عن عقبة بن عامر روى عنه عمرو بن الحارث مات سنة ثمان عشرة ومائة(@)(@@)(@@)(@@) $ 2427 - حي بن مالك يروي عن عبد الله بن عمرو روى عنه حي بن عبد الله المعافري(@)(@@)(@@)(@@) $ 2428 - حي شيخ يروي عن عروة البارقي روى عنه شبيب بن غرقدة PageV04P189(@)(@@)(@@)(@@) $ 2429 - حويرث بن رباب يروي عن عمر روى عنه محمد بن إبراهيم التيمي(@)(@@)(@@)(@@) $ 2430 - حلال بن أبي حلال العتكي واسم أبيه زرارة يروي المراسيل روى عنه قتادة(@)(@@)(@@)(@@) $ 2431 - حميري بن بشير يروي عن معقل بن يسار روى عنه قتادة(@)(@@)(@@)(@@) $ 2432 - حميري بن كراثة الربعي كان ممن افتتح الأبلة يروي المراسيل روى حماد بن سلمة عن أبيه عنه(@)(@@)(@@)(@@) $ 2433 - حنبل بن عبد الله يروي عن الهرماس بن زياد وله صحبة روى عنه عبد السلام بن هاشم البزار أبو عثمان البصري ثنا محمد بن علي البصري ثنا عثمان بن طالوت بن عباد ثنا عبد السلام البزار قال ثنا حنبل بن عبد الله روى عن الهرماس بن زياد قال رأيت النبي صلى الله عليه وسلم يصلي في نعلين(@)(@@)(@@)(@@) $ 2434 - حبيش بن شريح أبو حفصة الحبشي من أهل القدس يروي عن عبادة بن الصامت روى عنه علي بن أبي حملة PageV04P190(@)(@@)(@@)(@@) $ 2435 - حبيش يروي عن على روى عنه عبد الرحمن بن قيس(@)(@@)(@@)(@@) $ 2436 - حامية بن رئاب يروي عن سلمان روى عنه الصلت الدهان(@)(@@)(@@)(@@) $ 2437 - حميل شيخ يروي عن بن عمر روى عنه ابنه جروة بن حميل(@)(@@)(@@)(@@) $ 2438 - حضين بن المنذر بن الحارث بن وعلة بن عمرو بن ثعلبة بن عمرو بن ذهل بن شيبان أبو ساسان الرقاشي وأبو ساسان لقب كنيته أبو محمد يروي عن عثمان وعلى والمهاجر بن قنفذ روى عنه 
ms543	 الحسن وعبد الله الداناج مات حضين سنة سبع وتسعين وأمه بنت بكر بن وائل(@)(@@)(@@)(@@) $ 2439 - حمان الهنائي شيخ بصرى يروي عن معاوية المراسيل روى عنه أبو شيخ الهنائي(@)(@@)(@@)(@@) $ 2440 - حوارى بن زياد يروي عن بن عمر روى عنه جعفر بن إياس PageV04P191(@)(@@)(@@)(@@) $ 2441 - حبحاب بن أبي الحبحاب يروي عن أنس بن مالك روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 2442 - حجية بن عدى الأسدي الكوفي يروي عن على روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 2443 - حمار الأسدي يروي عن عبد الله بن عمرو روى عنه أبو العميس(@)(@@)(@@)(@@) $ 2444 - أبو شيخ الهنائي اسمه حيوان بن خالد البصري يروي عن أخيه أتاهم كتاب عمر وهو مع عثمان بن أبي العاص روى عنه قتادة(@)(@@)(@@)(@@) $ 2445 - حجار بن أبجر الكوفي يروي عن على ومعاوية عداده في أهل الكوفة روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 2446 - الحواري مولى عبد الله بن شقيق وقد قيل أبو الحواري يروي عن أنس بن مالك قال كنا ننقل الماء لرسول الله PageV04P192 صلى الله عليه وسلم في جلود الإبل يوم شج وجهه ثنا عمر بن محمد الهمداني قال ثنا محمد بن عبد الرحيم صاعقة قال ثنا أبو سلمة المنهال بن بحر قال ثنا الحواري مولى عبد الله بن شقيق قال سمعت أنس بن مالك يقول كنا ننقل الماء(@)(@@)(@@)(@@) $ 2447 - حماس بن عمرو والد أبي عمرو بن حماس الليثي يروي عن عمر عداده في أهل المدينة روى عنه ابنه أبو عمرو(@)(@@)(@@)(@@) $ 2448 - حرقوس بن بشير ويقال بشير وقد قيل حرقوص بالصاد يروي عن علي روى عنه الهيثم بن بدر(@)(@@)(@@)(@@) $ 2449 - الحطم بن عبد الله شيخ يروي عن على روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 2450 - حنتف بن السجف يروي عن بن عمر روى عنه الحسن البصري(@)(@@)(@@)(@@) $ 2451 - حملة بن عبد الرحمن العكي يروي عن عمر بن الخطاب روى شعبة عن شيخ له عنه(@)(@@)(@@)(@@) $ 2452 - الحدثان شيخ يروي عن على روى عنه عاصم بن النعمان الليثي(@)(@@)(@@)(@@) $ 2453 - حبال بن رفيدة التيمي يروي عن الحسن وهو حبال بن 
ms544	 PageV04P193 أبي الحبال روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2454 - حدمر مولى عبس يروي المقاطيع كنيته أبو القاسم روى عنه ليث بن أبي سليم(@)(@@)(@@)(@@) ||| (ومن النساء)(@)(@@)(@@)(@@) $$ 2455 - حبيبة بنت شريق قالت سمعت علي بن أبي طالب عن النبي صلى الله عليه وسلم أنها أيام أكل وشرب روى عنها عيسى بن مسعود بن بن الحكم الزرقي وهى جدته(@)(@@)(@@)(@@) $$ 2456 - حبيبة بنت ميسرة بن أبي خيثم من بنى فهر تروى عن أم كرز الكعبية روى عنها عطاء بن أبي رباح(@)(@@)(@@)(@@) $$ 2457 - حفصة بنت عبد الرحمن بن أبي بكر تروى عن عائشة روى عنها عطاء بن أبي رباح وأهل الحجاز وكانت تحت المنذر بن الزبير(@)(@@)(@@)(@@) $$ 2458 - حفصة بنت سيرين أخت محمد بن سيرين تروي عن أم عطية الأنصارية وسمعت أنس بن مالك روى عنها هشام بن حسان PageV04P194 ثنا محمد بن إسحاق الثقفي قال ثنا أبو همام قال ثنا علي بن مسهر عن عاصم عن حفصة قالت سألني أنس بن مالك عن يحيى بن أبي عمرة قلت توفي قال في أي شيء قلت في الطاعون فقال إن رسول الله صلى الله عليه وسلم كان يقول الطاعون شهادة لكل مسلم(@)(@@)(@@)(@@) $$ 2459 - حكيمة جدة يحيى بن أبي سفيان تروى عن أم سلمة روى عنها يحيى بن أبي سفيان بن سعد بن الأخنس(@)(@@)(@@)(@@) $$ 2460 - حكيمة بنت أميمة تروى عن أمها أميمة بنت رقيقة ولها صحبة روى عنها بن جريج(@)(@@)(@@)(@@) $$ 2461 - حبة بنت المطلب بن أبي وداعة السهمي قالت كانت عائشة تصلى بعد العصر ركعتين روى عنها طلق بن حبيب(@)(@@)(@@)(@@) $$ 2462 - حكيمة بنت يعلى بن مرة تروي عن أبيها عن النبي صلى الله عليه وسلم قال من التقط لقطة يسيرة درهما أو حبلا أو شبه ذلك فليعرفه ثلاثة أيام فإن كان فوق ذلك فليعرفه ستة أيام حدثناه محمد بن علي بن المثنى قال ثنا أبو حيثمة قال ثنا يزيد بن هارون PageV04P195 قال أنا إسرائيل بن يونس أخبرني عمر بن عبد الله بن يعلى بن مرة عن جدته حكيمة عن أبيها 
ms545	 يعلى 6(@)(@@)(@@)(@@) $$ 2463 - حميضة بنت ياسر تروى عن جدتها يسيرة وكانت من المهاجرات روى عنها هانئ بن عثمان الكوفي وحميضة أمه(@)(@@)(@@)(@@) || (باب الخاء)(@)(@@) قال أبو حاتم وممن شافه الصحابة وروى عنهم ممن ابتدأ اسمه على الخاء(@)(@@)(@@)(@@) $ 2464 - خالد بن معدان بن أبي كريب الكلاعي يروي عن أبي أمامة والمقدام بن معديكرب ولقي سبعين رجلا من أصحاب النبي صلى الله عليه وسلم كنيته أبو عبد الله وكان من خيار عباد الله قدم العباس بن الوليد واليا على حمص فحضر يوم الجمعة الصلاة وخالد بن معدان في الصف فلما رآه إذا على العباس ثوب حرير فقام إليه خالد وشق الصفوف حتى أتاه فقال يا بن أخي إن رسول الله صلى الله عليه وسلم نهى الرجال عن لبس هذا فقال يا عم هلا قلت أخفى من هذا فقال وعمك ما قلت والله لا سكنت بلدا أنت فيه فخرج منها وسكن الطرطوس فكتب العباس إلى أبيه يخبره بذلك فكتب الوليد إليه يا بنى الحقه PageV04P196 بعطائه أينما كان فإنا لا نأمن أن يدعو علينا بدعوة فنهلك فأقام بالطوس متعبدا مرابطا إلى أن مات سنة أربع ومائة وقد قيل سنة ثمان ومائة ويقال سنة ثلاث ومائة(@)(@@)(@@)(@@) $ 2465 - خالد بن زيد الجهني يروي عن أبيه روى عنه عبد الله محمد بن عقيل(@)(@@)(@@)(@@) $ 2466 - خالد بن حكيم بن حزام بن خويلد القرشي يروي عن أبي عبيدة بن الجراح وخالد بن الوليد روى عمرو بن دينار عن أبي نجيح عنه(@)(@@)(@@)(@@) $ 2467 - خالد بن المهاجر بن خالد بن الوليد بن المغيرة المخزومي القرشي حجازي يروي عن بن عباس روى عنه الزهري ومحمد بن أبي بكر(@)(@@)(@@)(@@) $ 2468 - خالد بن الوليد السكسكي أدرك الجاهلية عداده في أهل الشام يروي المراسيل روى عنه يحيى بن الضحاك(@)(@@)(@@)(@@) $ 2469 - خالد بن سعد الكوفي يروي عن أبي مسعود الأنصاري روى PageV04P197 عنه إبراهيم النخعي ومنصور وكان مولى لأبي مسعود الأنصاري(@)(@@)(@@)(@@) $ 2470 - خالد بن أسلم أخو زيد بن أسلم مولى عمر بن الخطاب يروي عن بن عمر روى 
ms546	 عنه الزهري وزيد بن أسلم(@)(@@)(@@)(@@) $ 2471 - خالد بن أبي أيوب الأنصاري يروي عن أبيه روى عنه أيوب بن خالد(@)(@@)(@@)(@@) $ 2472 - خالد بن زيد بن جارية يروي عن بن عمر روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 2473 - خالد بن الربيع العبسي يروي عن حذيفة روى عنه أبو وائل(@)(@@)(@@)(@@) $ 2474 - خالد بن أيمن المعافري ويقال المعاوري يروي المراسيل روى عنه عمرو بن شعيب(@)(@@)(@@)(@@) $ 2475 - خالد بن الحويرث القرشي يروي عن عبد الله بن عمرو روى عنه علي بن زيد بن جدعان PageV04P198(@)(@@)(@@)(@@) $ 2476 - خالد بن الربيع العتكي يروي عن حذيفة بن اليمان روى عنه أبو وائل(@)(@@)(@@)(@@) $ 2477 - خالد بن أبي أمية يروي عن عمرو بن حريث عداده في أهل الكوفة روى عنه الصباح(@)(@@)(@@)(@@) $ 2478 - خالد بن ربعي الأسدي كوفي يروي عن بن مسعود روى عنه عبد الملك بن عمير(@)(@@)(@@)(@@) $ 2479 - خالد بن جرير بن عبد الله البجلي يروي عن جرير بن عبد الله روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 2480 - خالد بن يسار أخو صدقة بن يسار يروي المقاطيع يروى عن بن عقيل وغيره روى عنه موسى بن عبيدة الربذي(@)(@@)(@@)(@@) $ 2481 - أبو خلدة اسمه خالد بن دينار السعدي الخياط يروي عن أنس بن مالك روى عنه وكيع وكان بن مهدى يحسن الثناء عليه(@)(@@)(@@)(@@) $ 2482 - خالد بن أبي حيان مولى هزيلة امرأة من بنى دينار ولدت PageV04P199 في بنى سلمة بالمدينة يروي عن جابر روى عنه يعقوب بن محمد بن طحلاء(@)(@@)(@@)(@@) $ 2483 - خالد الربعي يروي عن أنس بن مالك روى عنه هشام بن حسان وأبو الأشهب وحميد الكندي العنبري(@)(@@)(@@)(@@) $ 2484 - خالد بن مضرب العبدي كوفي يروي عن بن أبي أوفى روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2485 - خالد بن خالد بن عمرو بن حريث يروي عن جده عمرو بن حريث روى عنه بن عيينة(@)(@@)(@@)(@@) $ 2486 - خالد بن دينار يروي عن بن عباس روى عنه العلاء بن المسيب(@)(@@)(@@)(@@) $ 2487 - خالد بن جبر يروي عن بن عمر روى عنه جعفر بن ربيعة(@)(@@)(@@)(@@) $ 2488 - خالد بن خلاد النجاري الأنصاري المدني يروي عن 
ms547	 أنس بن مالك وهو الذي يقال له خلاد بن خلاد روى عنه عمرو بن يحيى المازني PageV04P200(@)(@@)(@@)(@@) $ 2489 - خالد بن نشيط أبو العريان يروي عن أنس بن مالك والحسن روى عنه مروان الفزاري(@)(@@)(@@)(@@) $ 2490 - خالد بن رافع يروي المراسيل روى عنه مالك بن عبد(@)(@@)(@@)(@@) $ 2491 - خالد بن زيد المزني يروي عن أبي موسى روى عنه أبو حبيب(@)(@@)(@@)(@@) $ 2492 - خالد بن جابر بن سمرة العامري السوائي يروي عن أبيه روى عنه ابنه حرب بن خالد(@)(@@)(@@)(@@) $ 2493 - خالد بن دريك يروي عن عمران بن حصين روى عنه أسيد بن عبد الرحمن(@)(@@)(@@)(@@) $ 2494 - خالد بن حيي مولى عثمان بن عفان يروي عن أبي هريرة روى عنه زيد بن واقد(@)(@@)(@@)(@@) $ 2495 - خالد بن يزيد يروي عن العرباض بن سارية روى عنه سفيان بن حسين PageV04P201(@)(@@)(@@)(@@) $ 2496 - خالد بن سعيد بن أبي سعيد المدني يروي عن جده أبي سعيد روى عنه داود بن صالح(@)(@@)(@@)(@@) $ 2497 - خالد بن زيد بن حارثة الأنصاري يروي عن بن عمر روى عنه معتمر بن سليمان(@)(@@)(@@)(@@) $ 2498 - خالد بن زيد الأنصاري أدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم منهم أنس بن مالك ويرسل الأخبار كثيرا روى عنه مجمع بن يحيى ثنا أبو يعلى قال ثنا إبراهيم بن الحجاج قال ثنا بن المبارك عن مجمع بن يحيى الأنصاري قال حدثني عمي خالد بن زيد قال قال رسول الله صلى الله عليه وسلم بريء من الشح من أدى الزكاة وقرى الضيف وأعطى في النائبة مرسل(@)(@@)(@@)(@@) $ 2499 - خالد بن عبيد بن سارة المخزومي المكي يروي عن عبد الله بن جعفر وعبد الله بن عمر روى عنه عطاء وابنه جعفر بن خالد وهو الذي يقال له خالد بن سارة نسب إلى جده(@)(@@)(@@)(@@) $ 2500 - خالد السبائي يروي عن بن عباس روى عنه يونس بن PageV04P202 أبي إسحاق(@)(@@)(@@)(@@) $ 2501 - خالد بن غلاق أبو حسان العيشي من تيم الله بن ربيعة يروي عن أبي هريرة روى عنه الجريري ثنا عبد الله بن محمد قال ثنا إسحاق بن إبراهيم 
ms548	 قال ثنا المخزومي قال ثنا وهيب قال ثنا أبو مسعود وهو سعيد بن إياس الجريري عن خالد القيسي قال قلت يا أبا هريرة هل سمعت من خليلك شيئا تطيب به أنفسنا فقال نعم سمعته يقول صغاركم دعاميص الجنة قال المخزومي الصغار الأطفال والدعاميص يكون في أسفل الجب(@)(@@)(@@)(@@) $ 2502 - خالد بن سبيع يروي عن حذيفة روى عنه صخر بن بدر(@)(@@)(@@)(@@) $ 2503 - خالد بن سيحان بصرى شهد تستر مع أبي موسى روى عنه العوام بن مزاحم والعوام بن حوشب PageV04P203(@)(@@)(@@)(@@) $ 2504 - خالد بن عبد الله بن الحسين القرشي مولى عثمان بن عفان عداده في أهل الشام يروي عن أبي هريرة روى عنه زيد بن واقد وإسماعيل بن عبيد الله بن أبي المهاجر ثنا عمرو بن محمد الهمداني ثنا عمرو بن عثمان بن سعيد ثنا الوليد بن مسلم عن سعيد بن عبد العزيز عن إسماعيل بن عبيد الله بن أبي المهاجر عن خالد بن عبد الله بن حسين عن أبي هريرة قال ما رأيت أحدا أكثر أن يقول أستغفر الله وأتوب إليه من رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 2505 - خالد بن سلمة المخزومي والد عكرمة ومحمد يروي عن بن عمر روى عنه ابنه محمد(@)(@@)(@@)(@@) $ 2506 - خالد شيخ يروي عن أبي هريرة روى عنه سالم بن غيلان(@)(@@)(@@)(@@) $ 2507 - خالد بن سمير السدوسي بصرى يروي عن بن عمر وأنس بن مالك روى عنه الأسود بن شيبان(@)(@@)(@@)(@@) $ 2508 - خالد بن عبد الله بن رباح يروي عن معاوية روى عنه الزهري(@)(@@)(@@)(@@) $ 2509 - خالد بن عمير العدوى يروي عن عتبة بن غزوان عداده في أهل البصرة روى عنه حميد بن هلال وأبو نعامة PageV04P204(@)(@@)(@@)(@@) $ 2510 - خالد بن عرعرة التيمي يروي عن على روى عنه سماك بن حرب والقاسم بن عوف(@)(@@)(@@)(@@) $ 2511 - خالد بن أبي عثمان يروي عن أبي الطفيل روى عنه يعقوب بن إسحاق الحضرمي(@)(@@)(@@)(@@) $ 2512 - خالد العماني يروي عن عائشة روى عنه يزيد العبدي(@)(@@)(@@)(@@) $ 2513 - خالد بن اللجلاج أبو إبراهيم العامري أخو العلاء بن اللجلاج عداده في أهل 
ms549	 الشام كان من أفاضل أهل زمانه يروي عن عمر بن الخطاب وأبيه وعبد الرحمن بن عائش روى عنه مكحول وعبد الرحمن بن يزيد بن جابر(@)(@@)(@@)(@@) $ 2514 - خالد بن معتب يروي عن أنس بن مالك روى عنه شيبة بن نصاح PageV04P205(@)(@@)(@@)(@@) $ 2515 - خالد بن الواشمة يروي عن عائشة روى عنه بجير بن أوس(@)(@@)(@@)(@@) $ 2516 - خالد بن كيسان يروي عن الربيع بنت معوذ بن عفراء روى عنه عيسى بن يزيد أبو معاذ(@)(@@)(@@)(@@) $ 2517 - خالد بن عبد الله بن أسيد وأدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الزهري وهو الذي يروي عن قبيصة بن ذؤيب(@)(@@)(@@)(@@) $ 2518 - خالد بن محدوج الواسطي أبو روح يروي عن أنس بن مالك روى عنه أبو أسامة(@)(@@)(@@)(@@) $ 2519 - خالد بن رباح الأنصاري يروي عن أبي قتادة روى عنه ثابت البناني(@)(@@)(@@)(@@) $ 2520 - خالد بن محمد بن عبد الله يروي عن معاوية وابن الزبير وأم سلمة روى عنه بن جريج PageV04P206(@)(@@)(@@)(@@) $ 2521 - خالد بن الفرز يروي عن أنس بن مالك روى عنه الحسن بن صالح بن حي(@)(@@)(@@)(@@) $ 2522 - خالد بن وهبان بن خالة أبي ذر الغفاري يروي عن أبي ذر روى عنه الناس(@)(@@)(@@)(@@) $ 2523 - خالد بن كيسان يروي عن بن عمر وابن الزبير روى عنه أيوب بن ثابت(@)(@@)(@@)(@@) $ 2524 - خالد بن ذكوان أبو الحسن المديني وقد قيل أبو حسين سكن البصرة يروي عن الربيع بنت معوذ بن عفراء ولها صحبة روى عنه حماد بن سلمة وبشر بن المفضل وأهل البصرة(@)(@@)(@@)(@@) $ 2525 - خالد بن أبى مسلم الطائفي يروي عن عبد الله بن عمرو روى عنه يعلى بن عطاء والنعمان بن سالم(@)(@@)(@@)(@@) $ 2526 - خالد بن يزيد أبو عبد الرحمن يروي عن المغيرة بن شعبة ومعاوية روى عنه معاوية بن صالح والناس PageV04P207(@)(@@)(@@)(@@) $ 2527 - خالد بن مساور يروي عن أبي هريرة روى عنه شعيب بن الحبحاب وقد قيل خالد بن يسار(@)(@@)(@@)(@@) $ 2528 - خالد الجدلي كوفي يروي عن جابر بن سمرة روى عنه ابنه معبد بن خالد(@)(@@)(@@)(@@) $ 2529 - خلاد بن السائب بن خلاد 
ms550	 الأنصاري من بلحارث بن الخزرج يروي عن أبيه روى عنه عطاء بن يسار وقتادة وهو خلاد بن السائب بن خلاد بن سويد بن ثعلبة بن عمرو بن حارثة بن امرئ القيس بن ثعلبة بن الخزرج أمه مارية بنت الحارث بن سلامان من أزد شنوءة(@)(@@)(@@)(@@) $ 2530 - خلاد بن خلاد الأنصاري يروي عن أنس بن مالك روى عنه عمرو بن يحيى الأنصاري(@)(@@)(@@)(@@) $ 2531 - خلاد بن السائب الجهني يروي عن أبيه روى عنه الزهري وقتادة ويحيى بن أبي كثير PageV04P208(@)(@@)(@@)(@@) $ 2532 - خليفة بن كعب التميمي أبو ذبيان بصرى يروي عن بن الزبير روى عنه جعفر بن ميمون(@)(@@)(@@)(@@) $ 2533 - خليفة الواسطي مولى أشجع يروي عن أسماء بنت أبي بكر روى عنه ابنه خلف بن خليفة(@)(@@)(@@)(@@) $ 2534 - خليفة مولى عمرو بن حريث القرشي يروي عن عمرو بن حريث روى عنه ابنه فطر بن خليفة(@)(@@)(@@)(@@) $ 2535 - خليفة بن حصين بن قيس بن عاصم المنقري يروي عن جماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل الكوفة روى عنه الأغر(@)(@@)(@@)(@@) $ 2536 - خليفة بن أبي حبيب أخو يزيد بن أبي حبيب يروي عن جماعة من التابعين روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 2537 - خليفة بن قيس مولى خالد بن عرفطة حليف بنى زهرة يروى PageV04P209 عن خالد بن عرفطة عداده في أهل الكوفة روى عنه عبد الرحمن بن إسحاق(@)(@@)(@@)(@@) $ 2538 - خليفة بن عبد الله الغبري يروي عن عائذ بن عمرو روى شعبة عن بسطام عنه(@)(@@)(@@)(@@) $ 2539 - خليد بن سعد مولى أبي الدرداء عداده في أهل الشام يروي عن أبي الدرداء روى عنه طلحة بن نافع كان يسكن بيت المقدس(@)(@@)(@@)(@@) $ 2540 - خليد بن عبد الله العصري البصري أبو سليمان العبدي عداده في أهل البصرة يروي عن أبي الدرداء روى عنه قتادة ويقال إن هذا مولى لأبي الدرداء وهو الذي يروي عن الأحنف بن قيس(@)(@@)(@@)(@@) $ 2541 - خليد الثوري يروي عن على وعمار روى عنه نسير بن ذعلوق عداده في أهل الكوفة(@)(@@)(@@)(@@) $ 2542 - خليد يروي عن بن عمر روى عنه السدى أحسبه 
ms551	 الأول(@)(@@)(@@)(@@) $ 2543 - خطاب بن خفاف أبو جويرية الجرمي اليماني يروى عن PageV04P210 بن عباس روى عنه الثوري(@)(@@)(@@)(@@) $ 2544 - خطاب بن جبير بن حية الثقفي البصري يروي عن عمر روى عنه ابنه محمد بن خطاب(@)(@@)(@@)(@@) $ 2545 - خارجة بن زيد بن ثابت الأنصاري المدني كنيته أبو زيد من فقهاء المدينة من السبعة يروي عن أبيه وهو أخو إسماعيل بن زيد روى عنه الزهري وأبو الزناد مات سنة تسع وتسعين وقد قيل سنة مائة وهو بن سبعين سنة(@)(@@)(@@)(@@) $ 2546 - خارجة بن الصلت بن صحار التميمي يروي عن عمه روى عنه الشعبي واسم عمه علاقة بن صحار السليطي وسليط من تميم(@)(@@)(@@)(@@) $ 2547 - خارجة بن الصلت البرجمي يروي عن بن مسعود روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2548 - خارجة بن العوام يروي عن أبي هريرة روى عنه ابنه(@)(@@)(@@)(@@) $ 2549 - خبيب بن عبد الله بن الزبير بن العوام يروي عن أبيه روى عنه ابنه الزبير بن خبيب مات سنة ثلاث وتسعين قبل أن يستخلف عمر بن عبد العزيز أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام المخزومي PageV04P211(@)(@@)(@@)(@@) $ 2550 - خرشة بن الحر الفزاري أخو سلامة بن الحر عداده في أهل الكوفة وكان يتيما في حجر عمر يروى عن بن عمر وأبي ذر روى عنه سليمان بن مسهر الفزاري مات سنة أربع وسبعين في ولاية بشر بن مروان على العراق(@)(@@)(@@)(@@) $ 2551 - خرشة بن حبيب السلمي أخو أبي عبد الرحمن السلمي يروي عن علي بن أبي طالب روى عنه هلال بن يساف(@)(@@)(@@)(@@) $ 2552 - خثيم بن عمرو يروي عن بن مسعود روى عنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 2553 - خثيم بن مروان يروي عن أبي هريرة روى عنه كلثوم بن جبر ويقال بن مرزوق(@)(@@)(@@)(@@) $ 2554 - خثيم بن مروان بن قيس السلمي يروي عن عمر بن الخطاب روى يحيى بن سعيد الأنصاري عن أبيه عنه PageV04P212(@)(@@)(@@)(@@) $ 2555 - خثيم بن القارة المكي جد عبد الله بن عثمان بن خثيم يروي عن عمر روى عنه عياض بن وهب بن عبيد الله بن أبي حبيبة(@)(@@)(@@)(@@) $ 2556 - خضير السلمي 
ms552	 يروي عن عبادة بن الصامت روى عنه عمير بن هانئ(@)(@@)(@@)(@@) $ 2557 - خضير بن الأسود يروي عن أبي أمامة الباهلي روى عنه عبد الرحمن بن سوار الهلالي(@)(@@)(@@)(@@) $ 2558 - أبو راشد الحبراني من أهل الشام وقد قيل إن اسمه خضر بن خرط فان صح ذلك فهو غريب روى عنه أهل الشام(@)(@@)(@@)(@@) $ 2559 - خباب يروي عن أبي بكر روى عنه ابنه عطاء بن خباب(@)(@@)(@@)(@@) $ 2560 - خنيس بن عبد الرحمن بن نعيم الغفاري يروي عن عبد الله بن سلام روى عنه قيس بن عبد الملك(@)(@@)(@@)(@@) $ 2561 - خيثمة بن عبد الرحمن بن أبي سبرة الجعفي الكوفي واسم أبي سبرة يزيد بن مالك يروي عن علي وعبد الله بن عمرو وابن عمر روى عنه الأعمش ومنصور مات قبل أبي وائل ثنا محمد بن إسحاق الثقفي قال ثنا عقبة بن مكرم قال ثنا مسلم بن قتيبة عن شعبة عن نعيم بن PageV04P213 أبي هند قال رأيت أبا وائل في جنازة خيثمة على حمار يبكي واضعا يده على رأسه يقول واعيشاه واعيشاه(@)(@@)(@@)(@@) $ 2562 - خيثمة بن مالك يروي عن أبي الدرداء روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 2563 - خيثمة بن أبي خيثمة البصري يروي عن أنس روى عنه بشير بن سلمان والأعمش ومنصور(@)(@@)(@@)(@@) $ 2564 - خمير أبو مالك الحميري يروي عن عبد الله بن عمرو روى عنه عبد الكريم بن الحارث(@)(@@)(@@)(@@) $ 2565 - خمير بن مالك يروي عن بن مسعود روى عنه أبو إسحاق السبيعي وعبد الله بن عيسى(@)(@@)(@@)(@@) $ 2566 - خازم بن القاسم البصري يروي عن أبي عسيب روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 2567 - خشف بن مالك الطائي عداده في أهل الكوفة يروي عن عمر وابن مسعود روى عنه زيد بن جبير الطائي(@)(@@)(@@)(@@) $ 2568 - خداش بن إسماعيل الكوفي شهد الجمل روى عنه محمد بن سواء PageV04P214(@)(@@)(@@)(@@) $ 2569 - خزيمة بن ثابت بن خزيمة بن ثابت يروي عن جده روى عنه الزهري(@)(@@)(@@)(@@) $ 2570 - خميل يروي عن نافع بن عبد الحارث روى عنه حبيب بن أبى ثابت(@)(@@)(@@)(@@) $ 2571 - خزاعي بن زياد بن عبد الله بن 
ms553	 المغفل بصرى يروي عن عبد الله بن مغفل روى عنه الهيثم بن جهم المؤذن(@)(@@)(@@)(@@) $ 2572 - خطاف مولى لعثمان بن أبي العاص روى عنه المبارك بن فضالة(@)(@@)(@@)(@@) $ 2573 - خيار بن سلمة أبو زياد عداده في أهل الشام يروي عن عائشة روى عنه خالد بن معدان(@)(@@)(@@)(@@) $$ 2574 - خصيلة بنت واثلة بن الأسقع تروى عن أبيها روى عنها أهل الشام PageV04P215(@)(@@)(@@)(@@) $$ 2575 - خالدة بنت طلق تروى عن أبيها قال أتينا النبي صلى الله عليه وسلم فبايعناه روى عنها سراج بن عقبة بن طلق بن علي(@)(@@)(@@)(@@) $$ 2576 - خيرة مولاة أم سلمة والدة الحسن بن أبي الحسن يروي عنها ابنها الحسن بن أبي الحسن عن أم سلمة في عمار تقتلك الفئة الباغية(@)(@@)(@@)(@@) || (باب الدال)(@)(@@) قام أبو حاتم وممن روى من الصحابة وشافههم ممن ابتدأ اسمه على الدال(@)(@@)(@@)(@@) $ 2577 - داود بن كردوس الثعلبي يروي عن عمر بن الخطاب عداده في أهل الكوفة روى عنه السفاح بن مطر(@)(@@)(@@)(@@) $ 2578 - داود بن فراهيج مولى بنى قيس بن الحارث بن فهر أصله من المدينة قدم البصرة وحدثهم بها يروي عن أبي هريرة وأبي سعيد روى عنه شعبة والناس(@)(@@)(@@)(@@) $ 2579 - داود بن خيثمة يروي عن أبي موسى روى عنه شبيب بن عبد الملك(@)(@@)(@@)(@@) $ 2580 - داود بن محمد بن نجيح يروي عن أبي هريرة روى عنه سعيد بن أبي هلال PageV04P216(@)(@@)(@@)(@@) $ 2581 - داود بن إسماعيل الأنصاري من أهل المدينة يروي عن بن عمر روى عنه عاصم بن سويد الأنصاري وأهل بلده(@)(@@)(@@)(@@) $ 2582 - داود بن أبي عاصم بن عروة بن مسعود بن معتب بن مالك بن عمرو بن كعب بن سعد بن عوف بن ثقيف الثقفي الحجازي يروي عن بن عمر روى عنه يعقوب بن عطاء ويزيد بن أبي زياد وهو الذي يقال له داود بن عاصم أمه أم حبيبة بنت أمية بن زيد بن حلس من بني الحارث بن عبد مناة بن كنانة(@)(@@)(@@)(@@) $ 2583 - داود الغفاري يروي عن سعد بن أبي وقاص روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 2584 - داود السراج الثقفي يروي عن 
ms554	 أبي سعيد الخدري روى عنه قتادة(@)(@@)(@@)(@@) $ 2585 - داود بن إسماعيل بن مجمع يروي عن بن عمر روى عنه عاصم بن سويد الأنصاري PageV04P217(@)(@@)(@@)(@@) $ 2586 - داود بن سليمان أبو اليمان الخشك كوفي يروي عن بن أبي أوفى روى عنه عبد الله بن نمير ومروان بن معاوية(@)(@@)(@@)(@@) $ 2587 - داود بن عامر المازني الأنصاري وهو الذي يقال له داود بن أبي داود يروي المراسيل روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 2588 - دينار أبو عبد الله القراظ مولى خزاعة من أهل المدينة يروي عن سعد بن أبي وقاص وأبي هريرة روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 2589 - دينار الكوفي يروي عن عمرو بن الحارث بن المصطلق روى عنه ابنه عيسى بن دينار الأزدي(@)(@@)(@@)(@@) $ 2590 - دينار مولى أبي رهم أبو حازم التمار وقد قيل مولى بنى غفار يروي عن البياضي رجل من أصحاب النبي صلى الله عليه وسلم روى عنه محمد بن إبراهيم التيمي ومحمد بن عمرو بن علقمة(@)(@@)(@@)(@@) $ 2591 - دينار أبو العيزار يروي عن على روى عنه عبد الله بن ميسرة PageV04P218 وابنه أيوب بن دينار عداده في أهل الكوفة(@)(@@)(@@)(@@) $ 2592 - دينار شيخ يروي عن على عداده في أهل الكوفة روى عنه ابنه أيوب بن دينار(@)(@@)(@@)(@@) $ 2593 - دينار الحجام مولى جرم حجم زيد بن أرقم روى عنه يونس بن عبد الله الجرمي(@)(@@)(@@)(@@) $ 2594 - دينار الحجام حجم أنس بن مالك روى عنه النضر بن شميل أحسبه أبا طالب الحجام الذي روى عنه قتادة(@)(@@)(@@)(@@) $ 2595 - دينار أبو كثير يروي عن بن عمر روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 2596 - دينار بن دينار الشامي يروي عن أبي الدرداء روى عنه الهيثم الأعمى(@)(@@)(@@)(@@) $ 2597 - دينار أبو سعيد عقيصا يروي عن الحسن والحسين روى عنه سالم بن أبي مريم(@)(@@)(@@)(@@) $ 2598 - دينار أبو فاطمة يروي عن أبي رافع روى عنه سعيد بن أبي عروبة(@)(@@)(@@)(@@) $ 2599 - درهم أبو هند كان من العباد يروي عن معقل بن يسار روى عنه حاجب بن عمر PageV04P219(@)(@@)(@@)(@@) $ 2600 - درهم أبو عبيد يروي عن على روى عنه عبادة بن مسلم(@)(@@)(@@)(@@) $ 2601 - درهم مولى حمزة يروي 
ms555	 عن أبي هريرة روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 2602 - دثار بن عبيد بن الأبرص الشاعر الأسدي عداده في أهل الكوفة يروي عن على روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 2603 - دخين الحجري من أهل مصر يروي عن عقبة بن عامر روى عنه بكر بن سوادة وكعب بن علقمة كنيته أبو الهيثم وكان كاتبا لعقبة بن عامر(@)(@@)(@@)(@@) $ 2604 - أبو طلحة الخولاني اسمه درع بن عبد الله من أهل بيت المقدس وكان واليا عليها يروي عن جماعة من الصحابة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 2605 - ديسم السدوسي يروي عن بشير بن الخصاصية روى عنه أيوب PageV04P220 السختياني(@)(@@)(@@)(@@) $ 2606 - دخيل بن أبي الخليل واسم أبيه صالح بن أبي مريم الضبعي من أهل البصرة يروي عن أبي هريرة روى عنه مطر الوراق(@)(@@)(@@)(@@) $ 2607 - دلجة بن قيس يروي عن الحكم بن عمرو الغفاري روى عنه أبو تميمة السلى(@)(@@)(@@)(@@) $ 2608 - دجاجة يروي عن عثمان بن عفان روى عنه ابناه الدرباس وعمرو(@)(@@)(@@)(@@) $ 2609 - دغفل شيخ يروي عن أنس بن مالك روى عنه الزهري(@)(@@)(@@)(@@) $$ 2610 - دقرة بنت غالب الراسبية من أهل البصرة تروى عن عائشة روى عنها أهل البصرة وقد قيل أنها ابنة أذينة ويشتبه أن يكون أذينة أمها(@)(@@)(@@)(@@) || (باب الذال)(@)(@@) قال أبو حاتم وممن شافه الصحابة وروى عنهم ممن ابتدأ اسمه على الذال(@)(@@)(@@)(@@) $ 2611 - ذكوان أبو صالح السمان وهو الذي يقال له الزيات كان PageV04P221 يجلب السمن والزيت إلى الكوفة فنسب إليهما وهو والد سهيل بن أبي صالح يروي عن أبي هريرة وسعد بن أبي وقاص روى عنه الأعمش وابنه والناس وهو مولى جويرية بنت الأحمس الغطفاني مات سنة إحدى ومائة(@)(@@)(@@)(@@) $ 2612 - ذكوان أبو عمرو مولى عائشة بنت أبي بكر يروي عن عائشة وكانت دبرته وكان يؤمها في شهر رمضان في المصحف روى عنه بن أبي مليكة قتل ليالي الحره سنة ثلاث وستين(@)(@@)(@@)(@@) $ 2613 - الذيال بن حنظلة بن حنيفة بن حذيم يروي عن أبيه وله صحبة روى عنه البصريون من حديث المقدمي عن محمد بن عثمان عن الذيال عن حنظلة(@)(@@)(@@)(@@) $ 2614 
ms556	 - الذيال بن عبيد بن حنظلة بن حنيفة بن حذيم يروي عن جده حنظلة روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 2615 - الذيال بن حرملة الأسدي كوفي يروي عن جابر بن عبد الله روى عنه حصين وفطر بن خليفة والأجلح ثنا إبراهيم بن هريم PageV04P222 قال ثنا عبد بن حميد قال ثنا يعلى بن عبيد عن الأجلح عن الذيال بن حرملة عن جابر قال أقبلنا مع النبي صلى الله عليه وسلم عن السفر حتى دفعنا إلى حائط من حيطان بني النجار فإذا فيه جمل لا يدخل الحائط أحد إلا شد عليه فذكروا ذلك للنبي صلى الله عليه وسلم فأتاه فدعاه فجاء واضعا مشفره في الأرض حتى برك بين يديه فقال صلى الله عليه وسلم هاتوا خطاما وخطمه ودفعه إلى صاحبه ثم التفت وقال ما بين السماء والأرض شيء إلا يعلم أني رسول الله إلا عاصي الجن والإنس(@)(@@)(@@)(@@) $ 2616 - ذو الكلاع أبو شراحيل بن عم كعب عداده في أهل الشام يروي عن عوف بن مالك روى عنه أزهر بن سعد الكلاعي(@)(@@)(@@)(@@) $ 2617 - ذهيل بن عوف بن الشماخ يروي عن أبي هريرة روى سهيل بن أبي صالح عن سليط عنه(@)(@@)(@@)(@@) $ 2618 - ذباب بن مرة يروي عن علي بن أبي طالب روى عنه الحكم(@)(@@)(@@)(@@) $ 2619 - ذهل بن كعب يروي عن عمر روى عنه سماك بن حرب PageV04P223(@)(@@)(@@)(@@) $ 2620 - ذواد العقيلي يروي عن سعد بن أبي وقاص روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 2621 - ذريح النخعي أبو المثنى من أهل الكوفة يروي عن على روى عنه الحارث بن جميلة(@)(@@)(@@)(@@) $ 2622 - ذفيف مولى بن عباس يروي عن بن عباس روى عنه حميد بن قيس مات سنة سبع ومائة(@)(@@)(@@)(@@) $$ 2623 - ذرة روت عن عائشة روى عنها زيد بن اسلم(@)(@@)(@@)(@@) || (باب الراء)(@)(@@) قال أبو حاتم وممن روى عن أصحاب رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الراء(@)(@@)(@@)(@@) $ 2624 - الربيع بن خثيم الثوري التميمي الكوفي كنيته أبو يزيد بن ثور بن عبد مناة بن أدبن طابخة بن إلياس بن مضر من العباد 
ms557	 الثمانية أخباره في العبادة والزهد أشهر من أن يحتاج إلى الإغراق في ذكرها يروى PageV04P224 عن بن مسعود روى عنه أهل الكوفة مات بعد قتل الحسين بن علي سنة ثلاث وستين ثنا محمد بن معاذ قال ثنا الفرياناني قال ثنا محمد بن فضيل عن أبيه عن سعيد بن مسروق عن الربيع بن خثيم أنه سرق له فرس وقد أعطى به عشرين ألفا فاجتمع عليه حيه وقالوا ادع الله عليه فقال اللهم إن كان غنيا فاغفر له وإن كان فقيرا فأعنه(@)(@@)(@@)(@@) $ 2625 - الربيع بن زياد عامل معاوية على خراسان يروي عن أبي بن كعب روى عنه قتادة روى عن الربيع بن زياد بن أنس بن الذيال الحارثي وذاك أن عثمان بن عفان رضي الله عنه في السنة التاسعة والعشرين عزل أبا موسى الأشعري عن البصرة وعثمان بن العاص عن فارس وولى البصرة وفارس كلها عبد الله بن عامر بن كريز فانفذ عبد الله بن عامر في أول سنة ثلاثين الربيع بن زياد إلى سجستان وولاه عليها ففتح سجستان على يديه قد ذكرنا تلك القصة بتمامها في فضائل سجستان(@)(@@)(@@)(@@) $ 2626 - الربيع بن معبد بن أبي الحقيق روى عنه يزيد بن زياد القرظي(@)(@@)(@@)(@@) $ 2627 - الربيع بن قزيع أحد بنى غطفان كنيته أبو الجارود عداده في أهل الكوفة يروي عن بن عمر روى عنه الثوري وشعبة PageV04P225(@)(@@)(@@)(@@) $ 2628 - الربيع بن البراء بن عازب الأنصاري أخو إبراهيم ويحيى عداده في أهل الكوفة يروي عن أبيه روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2629 - الربيع بن نضيلة كوفي يروي عن سلمان روى عنه علي بن ربيعة(@)(@@)(@@)(@@) $ 2630 - الربيع بن عميلة الفزاري أخو يسير بن عميلة عداده في أهل الكوفة يروي عن بن مسعود روى عنه ابنه الركين بن الربيع(@)(@@)(@@)(@@) $ 2631 - الربيع بن لوط بن أخي البراء بن عازب يروي عن البراء روى عنه بن جريج ويحيى بن سليم(@)(@@)(@@)(@@) $ 2632 - الربيع بن أبي بن كعب الأنصاري يروي عن أبيه روى عنه موسى بن دهقان(@)(@@)(@@)(@@) $ 2633 - ربيع بن حراش من عباد أهل 
ms558	 الكوفة وقرائهم يروي عن جماعة من الصحابة روى عنه عبد الملك بن عمير وأخوه ربعي آلى أن لا تفتر أسنانه ضاحكا حتى يعلم أين مصيره فما ضحك إلا بعد موته وله فيه قصة طويلة ثنا القطان بالرقة قال ثنا حكيم بن يوسف الرقي قال ثنا عبيد الله PageV04P226 بن عمرو عن عبد الملك بن عمير عن ربعي بن حراش عن أخيه الأوسط أنه مرض وثقل قال فخرجت في حاجة فأغمي عليه وسجي وقيل قد مات فأتيته فبينا نحن جلوس عنده إذ فتح عينيه فقلت سبحان الله أبعد الموت قال إني لقيت ربي فتلقاني منه بروح وريحان ورب غير غضبان وكساني ثيابا خضرا من سندس وإستبرق وإني استأذنت الله عز وجل لأبشركم وأخبركم أن الأمر أهون مما في أنفسكم ولكن لا تغتروا وإن رسول الله صلى الله عليه وسلم أقسم أن لا يبرح حتى أرجع إليه قال فكأنها حصاة ألقيت في ماء فرسبت(@)(@@)(@@)(@@) $ 2634 - الربيع بن ركين الكوفي يروي عن أنس بن مالك روى عنه أهل الكوفة مات سنة أربع ومائة(@)(@@)(@@)(@@) $ 2635 - الربيع بن سبرة بن معبد الجهني يروي عن أبيه وأنس روى عنه الزهري وابناه عبد العزيز وعبد الملك وعمارة بن غزية PageV04P227(@)(@@)(@@)(@@) $ 2636 - الربيع بن عبد الله من تيم الرباب يروي عن بن عمر روى عنه مزاحم بن زفر(@)(@@)(@@)(@@) $ 2637 - الربيع بن أنس بن زياد البكري سكن مرو يروي عن أنس بن مالك روى عنه بن المبارك وأبو جعفر الرازي والناس يتقون حديثه ما كان من رواية أبي جعفر عنه لأن فيها اضطراب كثير(@)(@@)(@@)(@@) $ 2638 - الربيع بن عتبة الباهلي يروي عن أبي أمامة روى عنه عبد الملك بن عتبة(@)(@@)(@@)(@@) $ 2639 - الربيع بن علي شيخ يروي عن علي بن أبي طالب روى عنه قتادة(@)(@@)(@@)(@@) $ 2640 - الربيع بن سليم مولى أنس بن مالك يروي عن أنس روى عنه زيد بن الحباب العكلي(@)(@@)(@@)(@@) $ 2641 - ربيعة بن عبد الله بن عبيد الله بن الهدير بن عبد العزى بن عامر PageV04P228 بن الحارث بن حارثة بن سعد 
ms559	 بن تيم بن مرة التيمي القرشي عم محمد بن المنكدر عداده في أهل المدينة يروي عن عمر بن الخطاب روى عنه بن أبي مليكة مات سنة ثلاث وتسعين أمه سمية بنت قيس بن الحارث بن نضلة بن عوف بن عبيد بن عويج بن عدى بن كعب(@)(@@)(@@)(@@) $ 2642 - ربيعة بن ناجذ الأسدي الأزدي الكوفي يروي عن على روى عنه أبو صادق وقيل ربيعة بن ناجذ الأسلمي(@)(@@)(@@)(@@) $ 2643 - ربيعة الجرشي يروي عن أبي هريرة روى عنه يحيى بن ميمونة الحضرمي(@)(@@)(@@)(@@) $ 2644 - ربيعة بن شيبان السعدي أبو الحوراء يروي عن الحسن بن علي عداده في أهل البصرة روى عنه يزيد بن أبي مريم(@)(@@)(@@)(@@) $ 2645 - ربيعة بن سلمة اليماني يروي عن عثمان وعلى روى عنه مسلم بن يسار(@)(@@)(@@)(@@) $ 2646 - ربيعة بن دراج يروي عن عمر وعلى روى الزهري عن رجل عنه PageV04P229(@)(@@)(@@)(@@) $ 2647 - ربيعة بن يورا مصري يروي عن فضالة بن عبيد روى عنه عبد الله بن مسروح(@)(@@)(@@)(@@) $ 2648 - ربيعة بن عمرو الجرشي من العباد شامي كان يقص أيام معاوية يروي عن معاوية روى عنه أهل الشام قتل بمرج راهط(@)(@@)(@@)(@@) $ 2649 - ربيعة بن لقيط التجيبي من أهل مصر يروي عن عبد الله بن حوالة روى عنه أهل مصر(@)(@@)(@@)(@@) $ 2650 - ربيعة بن عباد الديلي شيخ من أهل المدينة وقد قيل إن له صحبة وفيه نظر مات سنة خمس وتسعين(@)(@@)(@@)(@@) $ 2651 - ربيعة بن الغاز يروي عن عائشة روى عنه خالد بن معدان(@)(@@)(@@)(@@) $ 2652 - ربيعة بن الأبيض يروي عن علي بن أبي طالب رضي الله عنه روى عنه بن أشوع(@)(@@)(@@)(@@) $ 2653 - ربيعة بن الحارث يروي عن الفضل بن العباس روى عنه عبد الله PageV04P230 بن نافع بن العمياء(@)(@@)(@@)(@@) $ 2654 - ربيعة القيسي ملاعب الأسنة يروي عن أبي الدرداء روى عنه حبيب بن عبيد(@)(@@)(@@)(@@) $ 2655 - ربيعة بن أبي هلال الأسلمى يروي عن بن الزبير روى عنه ابنه خالد بن ربيعة ويقال ربيعة بن هلال(@)(@@)(@@)(@@) $ 2656 - ربيعة بن زرارة العتكي أبو الحلال بصرى يروي عن عثمان بن عفان روى عنه هشيم وقد 
ms560	 قيل إن اسمه زرارة بن ربيعة(@)(@@)(@@)(@@) $ 2657 - ربيعة بن عبد الرحمن بن حصن الغنوي يروي عن جدته سراء ولها صحبة روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 2658 - ربيعة بن زياد يروي المراسيل روى عنه وبرة الحارثي(@)(@@)(@@)(@@) $ 2659 - ربيعة بن قيس يروي عن عقبة بن عامر روى بكر بن سوادة عن رجل عنه(@)(@@)(@@)(@@) $ 2660 - ربيعة بن أبي عبد الرحمن مولى التيميين واسم أبى عبد الرحمن PageV04P231 فروخ وهو الذي يقال له ربيعة الرأي كنيته أبو عثمان وقد قيل أبو عبد الرحمن كان من فقهاء المدينة وعنه أخذ مالك الفقه يروي عن أنس بن مالك روى عنه مالك والثوري مات سنة ثلاث وثلاثين ومائة(@)(@@)(@@)(@@) $ 2661 - ربيعة بن يزيد القصير الدمشقي كنيته أبو شعيب وكان من خيار أهل الشام يروي عن واثلة بن الأسقع روى عنه الأوزاعي وسعيد بن عبد العزيز وأهل الشام قتل غازيا بالمغرب ثنا محمد بن المنذر قال ثنا أبو زرعة قال ثنا أبو مسهر قال ثنا عبد الرحمن بن عامر قال سمعت ربيعة بن يزيد يقول ما أذن مؤذن صلاة الظهر منذ أربعين سنة إلا وأنا في المسجد إلا أن أكون مريضا أو مسافرا قال أبو حاتم خرج ربيعة بن يزيد غازيا نحو المغرب في بعث بعثه هشام بن عبد الملك واستعمل عليهم كلثوم بن عياض القشيري قتل ربيعة بن يزيد غازيا في ذلك البعث بالمغرب وكان يزيد صاحبا لمعاوية PageV04P232(@)(@@)(@@)(@@) $ 2662 - ربيعة بن الصلت من أهل الشام يروي عن عائشة روى عنه خالد بن سعدان(@)(@@)(@@)(@@) $ 2663 - راشد بن سعد الحمصي المقراي ومقرأ قرية بدمشق من أهل الشام يروي عن ثوبان ويعلى بن مرة روى عنه أهل الشام ومات في ولاية هشام بن عبد الملك سنة ثلاث عشرة ومائة(@)(@@)(@@)(@@) $ 2664 - راشد بن أبي سكنة الشامي يروي عن معاوية روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 2665 - راشد بن يسار مملوك لعبد الله بن أبي أوفى رأى خمسة من أصحاب رسول الله صلى الله عليه وسلم منهم مرداس أو بن مرداس روى عنه أهل الكوفة 