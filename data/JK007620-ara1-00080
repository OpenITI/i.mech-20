ms61	 % % إذا خطرت وتلحقها القبول % PageV01P225 11(@)(@@) % كأن يد المعز حنت عليها % % مخافة أن تضر بها السيول % 12(@)(@@) % شفى مرض العواصم عامري % تنم على خلائقه الشمول % 13(@)(@@) % جلا صدأ القذى عنها وصحت % فليس سوى النسيم بها عليل % 14(@)(@@) % وآمن سربها من كل خطب % فأم النائبات بها ثكول % 15(@)(@@) % كريم يستر المعروف حتى % % كأن كثير ما يعطي قليل % 16(@)(@@) % تغير على سوابقه الفيافي % % وتضرب في صوارمه الفلول % 17(@)(@@) % تزور جياده أرض الأعادي % % وأطراف الرماح لها دليل % 18(@)(@@) % طلعن من الجزيرة في هنات % تقاضاها الطوائل والدخول % 19(@)(@@) % وجبن معاقل الأعداء حتى % % تناذرت الركائب والخيول % 20(@)(@@) % إذا خدعتهم بالنقع قالوا % % نعام الدو أفزعها الرعيل % PageV01P226 21(@)(@@) % وإن صدقتهم الخرصان عنها % % ولاحت في عجاجتها النصول % 22(@)(@@) % أجارهم الفرار من العوالي % % وقد ينجو من القدر الذليل % 23(@)(@@) % وحلوا بالسماوة في شعاب % يذم لها من الطلب الخمول % 24(@)(@@) % رعوا فيها الهشيم وقد تباهت % بزينتها المخازم والهجول % 25(@)(@@) % إذا سرحت قلاص الحي أمنا % وسارت عن منازلها الحمول % 26(@)(@@) % ثووا أسرى الخدار وقد أريحت % مطيهم وسالمها الذميل % 27(@)(@@) % طلاب لا يروعه عثار % وعزم لا ينفره نكول % 28(@)(@@) % وملك شاده ظعن الهوادي % % تزول الراسيات ولا يزول % 29(@)(@@) % حماه من مخاتلة الليالي % % فتى مثل المراد به جليل % 30(@)(@@) % تحاذر بأسه سمر العوالي % % ففيها من مهابته ذبول % PageV01P227 31(@)(@@) % ويطلع في ظلام النقع منها % % نجوما في النحور لها أفول % 32(@)(@@) % من القوم الذين لهم أكف % يبادرها فتنجاب المحول % 33(@)(@@) % كهولهم إذا غضبوا شباب % ومردهم إذا حلموا كهول % 34(@)(@@) % إذا راعت سيوفهم المطايا % % تمنت أن مالكها بخيل % 35(@)(@@) % غدت غررا على هام الأعادي % % وهز على مناسمها حجول % 36(@)(@@) % وقفر قيدت فيه الدياجي % % فما لخضابها عنه نضول % 37(@)(@@) % تستر فيه ضوء الصبح خوفا % فنم بسيره السيف الصقيل % 38(@)(@@) % تمر به السحائب خائفات % فليس لها بساحته همول % 39(@)(@@) % أقاموا في غياهبه العوالي % % منارا ما يضل به سبيل % 40(@)(@@) % حذار فإن في حلب ليوثا % وآجام الرماح لهن غيل % PageV01P228 41(@)(@@) % ومن بطن الشآم إلى دجيل % مراتع نبتها الأسل الطويل % 42 
ms62	(@)(@@) % يشيد دونها لبني كلاب % بيوت ما يضام لها نزيل % 43(@)(@@) % تسيل شعابها بندى ثمال % فليس لها إلى كلأ رحيل % 44(@)(@@) % تغمد جرمها إن طاح حلم % وضلت عن هدايتها عقول % 45(@)(@@) % وصنها فهي في يمناك عضب % يزينك حمله وبه تصول % 46(@)(@@) % فدونك عاجلت وخز العوالي % % كأن الرمح يطعنه التليل % 47(@)(@@) % وتحت لوائكم صعب أباء % % فلم يركب لها ظهر ذلول % 48(@)(@@) % أرى إبلي شوارع من قنوعي % % موارد ما يبل بها غليل % 49(@)(@@) % ولم تعرف لمصعبها قيود % ولم يملك لشاردها جديل % 50(@)(@@) % وآمالي مطرحة بطاء % % ينازع دونها قدر مطول % PageV01P229 51(@)(@@) % أعيذ نمير ودك من أوامي % % وقد أودى بجمته النهول % 52(@)(@@) % فهل يرضى لك الكرم اطراحي % % ولو أني لجودكم عذول % 53(@)(@@) % فما يسمو الزمان إلى قراعي % % وظل جنابكم أبدا ظليل % 54(@)(@@) % ولا تسطو علي يد الليالي % % وظني في رجائكم جميل % PageV01P230 البحر : طويل 1(@)(@@) % أما تريان البرق في غلس الدجى % % تميل به ريح الصبا فيميل % 2(@)(@@) % خليلي هبا واسعداني بنظرة % إليه فطرفي بالبكاء كليل % 3(@)(@@) % وفي تلعات ، السفح لو تلمحانها % % غزال أحم المقلتين كحيل % 4(@)(@@) % رحلنا قبيل الصبح ننشد أهلنا % % ونحن بأعلى الرقمتين نزول % 5(@)(@@) % فألثمني والليل بيني وبينه % غروب أقاح ظلمهن شمول % 6(@)(@@) % أعارضه في غفلة الركب لاثما % % كما خصلت غصن الأراك قبول % 7(@)(@@) % أبث سراري إن حب عذيبة % أقام وويب الناس كيف يزول % 8(@)(@@) % فليت الليالي في الغوير قصيرة % % فداهن ليل بالحيار طويل % PageV01P231 البحر : طويل 1(@)(@@) % أظن نسيم الريح من حيث أرسلا % % أعاد على برق اللوا ما تحملا % % 2(@)(@@) % وما لاح مختالا علينا بعلمه % وعرض بالدهناء إلا ليسألا % % 3(@)(@@) % روى مجملا والبان يتلو حديثه % ففسر ما قال النسيم وفصلا % % 4(@)(@@) % وخير بالمحل الركائب بعد ما % % ضمنا لها خصب العذيب تعللا % % 5(@)(@@) % فما كان إلا صادقا غير أنه % حديث هوينا فيه أن يتأولا % % 6(@)(@@) % وهل علم البرق اليماني أننا % % طرفنا به طرفا من الليل أكحلا % % 7(@)(@@) % وما باله خص الغضا بابتسامة % وسل على رمل الشقيقة منصلا % % 8(@)(@@) % وفي الركب طاو لو أتى الذئب ضافه 
ms63	 % على الزاد إما غادة أو تفضلا % % 9(@)(@@) % إذا خطرت في جانب البشر نفحة % ترنح في أعطافه وتململا % % 10(@)(@@) % يعد أناتي للعدو قساوة % % وطوع قيادي للصديق تدللا % % PageV01P232 11(@)(@@) % يلوم على عيش تبرضت عفوه % وأي حسام لم يصادف مفصلا % % 12(@)(@@) % إليك فإني قد عقلت ركائبي % % فلم أر عارا مثل أن أترحلا % % 13(@)(@@) % رمى البخل طلاب الغنى في سؤاله % وكنت على وجهي أضن وأبخلا % % 14(@)(@@) % وأثقل رفد ما امتطى المن ظهره % وشر ثراء ما أتاك تطولا % % 15(@)(@@) % لأخلف غيث بالسؤال انتجاعه % وأجذب روض بالمذلة يجتلى % % 16(@)(@@) % عذيري من الأيام تلقى بثابت % من البشر روضا أو من الجود جدولا % % 17(@)(@@) % كريم إذا ضن الغمام فكفه % كفيل بطرد العام أغير ممحلا % % 18(@)(@@) % يغير على جنح الظلام بغرة % تعلم وجه البدر أن يتهللا % % 19(@)(@@) % دعته إلى بذل الندى أريحية % تعود منها أن يقول ويفعلا % % 20(@)(@@) % نوال يعم الأرض حتى كأنه % تضمن أرزاق الورى وتكفلا % % PageV01P233 21(@)(@@) % إذا استحدث المجد الطريف أبت له % مناصبه إلا القديم المؤثلا % % 22(@)(@@) % علا وجدت والدهر في حجر أمه % وخير خليليك الذي كانت أولا % % 23(@)(@@) % من القوم حلوا في السماء فمنهم % السحائب تمري والأهلة تجتلى % % 24(@)(@@) % أقمت عزيز الدولة الجود واصفا % لما غاب من أفعالهم وممثلا % % 25(@)(@@) % خلقت ودين البخل عال مناره % فكنت نبيها بالسماحة مرسلا % % 26(@)(@@) % ولاموك في إتلاف مالك بالندى % % وحاشاك أن تغنى وأن تتمولا % % 27(@)(@@) % عمرت من الإحسان ما كان دارسا % وأوضحت في المعروف ما كان مشكلا % % 28(@)(@@) % فإن كنت فذا في الزمان فإنما % % سلكت سبيلا كان قبلك مهملا % % 29(@)(@@) % فداؤك مثر ما أعد سوامه % ونيرانه إلا لترعى وتصطلى % % 30(@)(@@) % أذم لها من نحرها بخل كفه % فهل أمنت من ذلة أن تذللا % % PageV01P234 31(@)(@@) % أبوك الذي عم الأنام نواله % فلم يبق جيدا من نداه معطلا % % 32(@)(@@) % وكم قصد الدهر الكرام بجوره % فما وجدوا إلا عليه المعولا % % 33(@)(@@) % ومن لبدور الأفق والمزن أن ترى % % بنانك مبسوطا ووجهك مقبلا % % 34(@)(@@) % وما جاءك التشريف إلا دلالة % عليك ورأيا فيك أن يتبدلا % % 35(@)(@@) % بأبيض ماضي 
ms64	 الشفرتين تضمنت % يمينك عنه أن يعود مفللا % % 36(@)(@@) % وأجرد نهد لم يجد غير ظله % رسيلا ولم يملك من الأرض منزلا % % 37(@)(@@) % يفوت مجال الطرف حتى تخاله % من البرق لولا أنه كان أعجلا % % 38(@)(@@) % وهيفاء طوع الريح قد خلع الدجا % % عليها هلالا بالنجوم مكللا % % 39(@)(@@) % لها من خلال المشرفي صقاله % ومن شيم الخطي أن يتميلا % % 40(@)(@@) % وصافية مثل الرياض تزورها ال % % الجنائب نشوى والسحائب حفلا % % PageV01P235 41(@)(@@) % لأحسن منها ما تزف غرائبي % % إليك وتكسوك الثناء المبجلا % % 42(@)(@@) % شوارد كانت في القياد أبية % فما قرعت بابا من القوم مقفلا % % 43(@)(@@) % أغار عليها أن يراض جموحها % % لغيرك أو ترجو سواك مؤملا % % 44(@)(@@) % ولو رامها داعي النوال تقاصرت % خطاها وأكدى الفكر فيها وأجبلا % % 45(@)(@@) % ولكنه ود صريح وذمة % بعيد على أمراسها أن تحللا % % PageV01P236 البحر : مجزوء الوافر 1(@)(@@) % تأمل من يلومك في % % هواك ويكره العذلا % % 2(@)(@@) % فإن ألفيته صبا % % فهلا نفسه عذلا % % 3(@)(@@) % وإن نكر الهوى جهلا % فذاك عدو ما جهلا % % PageV01P237 البحر : رجز تام 1(@)(@@) % ثورها ناشطة عقالها % % قد ملأت من بدنها جلالها % % 2(@)(@@) % فلم تزل أشواقه تسوقها % % حتى رمت من الوجى رحالها % % 3(@)(@@) % ماذا على الناقة من غرامه % لو أنه أنصف أو رثى لها % % 4(@)(@@) % أراد لها أن تشرب ماء حاجر % أريها يطلب أم كلالها % % 5(@)(@@) % إن لها على القلوب ذمة % لأنها قد عرفت بلبالها % % 6(@)(@@) % كانت لها مع الصبا تحية % أعجلها السائق أن تنالها % % 7(@)(@@) % كم تسأل البارق عن سويقة % ولا يجيب عامدا سؤالها % % 8(@)(@@) % خوفا على قلوبها إن علمت % إن الغوادي درست أطلالها % % 9(@)(@@) % مسارح رعت بها منيعة % فما رأى طاردها انشلالها % % 10(@)(@@) % وحيث مدت في الجميم بوعها % % وقامصت من مرح إفالها % % PageV01P238 11(@)(@@) % وسرحت لاعبة كأنما % % تحسبها من سفه فصالها % % 12(@)(@@) % قد ناكرت من الوجى أخفافها % % وناحلت من ضمر ظلالها % % 13(@)(@@) % وامتدت الفلاة دون خطوها % % كأنها قد كرهت زوالها % % 14(@)(@@) % فعللوها بحديث حاجر % ولتصنع الفلاة ما بدا لها % % PageV01P239 البحر : سريع 1(@)(@@) % قد زجر الشعر لكم فآله % وطالما جربت أقواله % % 2(@)(@@) % فلم يزل يخبر 
ms65	 فيما مضى % % عنك كأن الله أوحى له % 3(@)(@@) % وقد رأى جيشك والنصر في % % لوائه يسحب أذياله % 4(@)(@@) % والرحبة الخضراء جذلانة % بملكك المقبل مختاله % % 5(@)(@@) % ومسلم من دونها مسلم % لا يمنع الشيء إذا ناله % 6(@)(@@) % إذا هوت خيلك عن بالس % حدا إلى الموصل أجماله % 7(@)(@@) % فاعرف له البشرى وكن ضامنا % % ظنونه فيك وآماله % 8(@)(@@) % إنك إن أنطقته بالغنى % % فتحت دون الغيب أقفاله % 9(@)(@@) % ولم ترد من بعده كاهنا % يجمجم القول إذا قاله % 10(@)(@@) % يا طالبا قومي وعندي لهم % رسائل بالنصح حماله % PageV01P240 11(@)(@@) % قل لهم عني وما يكذب % الرائد في أخباره آله % 12(@)(@@) % إياكم من أسد باسل % قد مر للوثبة أشباله % % 13(@)(@@) % أروع لا يعرف جيرانه % حوادث الدهر وأوحاله % 14(@)(@@) % كأنه متن ردينية % ذابلة في الكف عساله % % 15(@)(@@) % ما زوحمت في المجد أعمامه % إلا إذا عدد أخواله % % 16(@)(@@) % أما سمعتهم بأحاديثه % شاردة في الأرض جواله % % 17(@)(@@) % في كل أفق من دجى نقعه % غمامة بالدم هطاله % % 18(@)(@@) % وقائع في الأرض مشهورة % % زلزل منها الشام زلزاله % 19(@)(@@) % يا ناصر الملك وقد غاله % من هفوات الملك ما غاله % 20(@)(@@) % كم ضيعوه فتداركته % والليث لا يسلم أغياله % PageV01P241 21(@)(@@) % في كل يوم منهم راحل % ينتجع الذل ويسعى له % 22(@)(@@) % ونازح عن عز أوطانه % ينفق في الغربة أمواله % 23(@)(@@) % جار ولو احسن تدبيره % % ما خرج البدر عن الهالة % % 24(@)(@@) % وأنت من دونهم لابد % تجاهد الدهر وأهواله % 25(@)(@@) % في معرك تقتل أبطاله % أو مغرم تحمل أثقاله % 26(@)(@@) % ما عرفت فيهم نميرية % من بعد وثاب وأمثاله % 27(@)(@@) % ولا لهم بينك في ظالم % ينادم الجوزاء إنزاله % 28(@)(@@) % لو طلبوا سلمك كانت لهم % قربى على ودك محتالة % 29(@)(@@) % لكنهم غرهم خلب % شاموا على غلهم آله % 30(@)(@@) % ما أظهر الرأي لدى فكرة % فيه وما أكثر جهالة % PageV01P242 31(@)(@@) % خذها بعفو الفكر ما فارقت % سلافة الطبع وسلساله % 32(@)(@@) % إن لحقت سامعها نشوة % فإنها صهباء جرياله % 33(@)(@@) % خالصة فيك فما تدعي % % صبابة الحب وبلباله % % 34(@)(@@) % ولا مضى الثاقب من فكرها % % في منزل ينعت أطلاله % 35(@)(@@) % يشغلها 
ms66	 مدحك عن غيره % ولم تكن تصلح إلا له % PageV01P243 البحر : طويل 1(@)(@@) % يقصر مالي في الحوادث عن بذلي % % فما عذر دهر لا يجود على مثلي % % 2(@)(@@) % رمتني رجال بالوعيد كأنما % % تروم مرامي أو تنازعني فضلي % % 3(@)(@@) % وقد أمنوا أن يمنع السب من فمي % % فهل أمنوا أن يمنع الضرب من نصلي % % 4(@)(@@) % ويحسبني دهري أروم عطاءه % فيوسعني قبل السؤال من البخل % 5(@)(@@) % وهل كنت أرضى أن أنال حطامه % وأعلم أن الحظ فيه مع الجهل % 6(@)(@@) % أنفت من الدنيا فما طلبت يدي % % ولا طمعت نفسي ولا وخدت إبلي % % 7(@)(@@) % ومن كان في برد القناعة رافلا % أصاب الغنى في الفقر والخصب في المحل % 8(@)(@@) % ألام إذا ما ناوش الدهر جانبي % % وأي حسام لا يحادث بالصقل % 9(@)(@@) % وما هو في ما بيننا من ضغينة % بمطرح قولي ولا جاهل فعلي % % 10(@)(@@) % وكنت أمني النفس بندا من الغنى % % يحسن معروفي ويوسع في ف % PageV01P244 11(@)(@@) % أما وقد فارقت آل عذيبة % فلا خير في حزن من العيش أو سهل % 12(@)(@@) % ألا إنما واريت يا أم عامر % عهود الصبا بين الصفائح والرمل % PageV01P245 البحر : مجزوء الرمل 1(@)(@@) % أيها النفس أقلي % % فلقد أكثرت ثقلي % % 2(@)(@@) % إنما أصلح من أمرك % ما يفسد عقلي % % 3(@)(@@) % لست أرضى لك بالعز % الذي يوجب ذلي % % 4(@)(@@) % وهوى الأكثر والعي % ش يرجى بالأقل % 5(@)(@@) % قد تعلقت من الدنيا % % بأمر مضمحل % 6(@)(@@) % وتمسكت من الناس % بعقد مثل حل % 7(@)(@@) % فإذا حاولت تحقيقا % فجهلا فوق جهل % 8(@)(@@) % يا حلال الترب ما % % أبلاكم إلا ويبلي % % 9(@)(@@) % نحن نتلوكم وما % % السابق إلا كالمصلي % % 10(@)(@@) % قد بذلنا لكم من % دمعنا جهد المقل % PageV01P246 11(@)(@@) % ولحقناكم من الدهر % بجاد مشمعل % 12(@)(@@) % كم أطيل الخوض في ليل % من الفكر مضل % PageV01P247 البحر : وافر تام 1(@)(@@) % أراني منك يا كعب بن عمرو % % على قرب المودة في تقال % 2(@)(@@) % عليك إذا حسدت طلاب فضلي % % وليس علي أن أذر المعالي % % 3(@)(@@) % حويت فضائلا ما نلت منها % % سوى بث العداوة في الرجال % 4(@)(@@) % وما ذنبي إلى الأقوام إلا % مكاثرتي لأطراف العوالي 
ms67	 % % 5(@)(@@) % وإني لا أعد الرفد جودا % لمن حملته ذل السؤال % 6(@)(@@) % ولا أبغي طريف المال إلا % لتروى راحتاي من النوال % 7(@)(@@) % عرفت الدهر معرفتي بنيه % % فلست أفر من نوب الليالي % % PageV01P248 البحر : بسيط تام 1(@)(@@) % أستغفر الله من تركي وإخلالي % % وهفوة خطرت مني على بالي % % 2(@)(@@) % قضيت عمري بدرس ما حظيت به % وكيف ينفع علم بين جهال % 3(@)(@@) % وزاد زهدي في أني عرفتهم % فما أسيت على جاه ولا مال % 4(@)(@@) % قيدت باليأس عزمي عن مطالبه % فلتحمد الله أفراسي وأجمالي % % 5(@)(@@) % أعد أصدق آمالي مخادعة % إذا تعلق أقوام بآمالي % % 6(@)(@@) % وللقناعة عندي منة شكرت % والشكر أحسن إعظام وإجلال % 7(@)(@@) % قرنتها بثراء غير مكتسب % وعفة بين إكثار وإقلال % 8(@)(@@) % ميراث قوم كفاني بعد عهدهم % فتوى الظنون بإحرام وإحلال % 9(@)(@@) % سقى الربيع ربيع جاد هاطله % بكل أسحم صافي الذيل هطال % 10(@)(@@) % وخص رمس سنان من مواهبه % ببارد كسلاف الخمر سلسال % PageV01P249 11(@)(@@) % فقد أعانا على زهد بميسرة % وأغنياني ع ، شد وترحال % 12(@)(@@) % أرحت جسمي فلم تنصب جوارحه % وقد أضر بها في الحرص أمثالي % % 13(@)(@@) % وما جعلت اغترابي للغنى سببا % إذا تفرغ أقوام لأشغال % 14(@)(@@) % قالوا جميلا ولكن قلما فعلوا % % منه وصدقت أقوالي بأفعالي % % 15(@)(@@) % وقد أجد ابن عمي في مخالفتي % % رأيا فصادف عندي غير إجفالي % % 16(@)(@@) % كن كيف شئت جفاء أو مواصلة % فقد خلقت بلا عم ولا خال % 17(@)(@@) % وخل عنك جدالي أو معاتبتي % % فإن ذلك فضل القيل والقال % 18(@)(@@) % وعصبة ألف الأحرار جمعهم % على تقلب أوقات وأحوال % 19(@)(@@) % من كل معترف بالشر مضطغن % وقاصد بلئيم الطبع مختال % 20(@)(@@) % بيت المكائد إلا أنه طال % وموضع السوء إلا أنه خالي % % PageV01P250 21(@)(@@) % عووا علي وهرتني كلابهم % فما عبئت برسم الدمنة البالي % % 22(@)(@@) % الحق أبلج فاعرف من تنازعه % ودع وساوس أفكار وأقوال % 23(@)(@@) % وللعداوة أسباب وأظهرها % % فيها تباين أغراض وأشكال % 24(@)(@@) % والناس شتى وإن عمتهم صور % هي التناسب بين الماء والآل % 25(@)(@@) % تبارك الله هل للخير من أثر % يقفى فيتبع فيه سابقا تالي % % 26(@)(@@) % وهل تبين سيف أن 
ms68	 منزله % في رأس غمدان دار غير محلال % 27(@)(@@) % أم هل لسابور علم من مدائنه % فيستهل لآثار وأطلال % 28(@)(@@) % يا شائدا رفع الإيوان مجتهدا % خفض عليك فإن الحادر العالي % % 29(@)(@@) % وقد عجبت من الرهبان إذ صدقوا % % للنسك عن ذبح خلان وأطفال % 30(@)(@@) % يكفيك قوتك مما أنت تذخره % % وما يصونك من بيت وسربال % PageV01P251 31(@)(@@) % لم يولموا حيوان البر واقتصروا % % على كوامن في الأفواه اغفال % 32(@)(@@) % فحرموا الصيد جهدا وهو أيسر في % % العقول لو علموا من صيد مغتال % 33(@)(@@) % ومدية الذبح أوحى من عذابهم % للسانحات على رفق وإمهال % 34(@)(@@) % أم عندهم أن حيا لا يحس إذا % % هيهات ما ذاك إلا خبط جهال % 35(@)(@@) % ما أكثر الجهل في فسق وفي نسك % والمضحكين بأقوال وأعمال % 36(@)(@@) % انخت عنسي وسارت في الورى حكمي % % فجال فكري وشخصي غير جوال % 37(@)(@@) % ولست من ود إخواني على ثقة % فكيف آمن حسادي وأقيالي % % 38(@)(@@) % فاسمع كلامي وافهم ما أريد به % واستوص خيرا بأغراض وأمثال % 39(@)(@@) % واجعل عظاتي نورا تستضيء به % فهي المصابيح ما شبت لقفال % 40(@)(@@) % وخل مدحي إذا ما ضمني جدثي % % فلا انتفاع لترب فيه منهال % PageV01P252 البحر : خفيف تام 1(@)(@@) % كان شملي بهم جميعا ولكن قد قنعنا من وصلكم بالخيال % ورضينا من وعدكم بالمطال % 2(@)(@@) % وصبرنا على ملالكم الزا % % ئد عن كل مذهب في الملال % 3(@)(@@) % ورأينا دياركم فعرفنا % % كل رسم بال بجسم بالي % % 4(@)(@@) % دارسات وناحلين فبما يف % % رق بين العشاق والأطلال % 5(@)(@@) % أيها اللائمون كفوا فما أغفل % من نام عن طول الليالي % % 6(@)(@@) % خبرونا عن الكرى واسمعوا % % منا حديث الغرام والبلبال % 7(@)(@@) % ما لأيامنا تمر قصارى % % د وحالوا في سائر الأحوال % 8(@)(@@) % أكذا تصنع الصبابة أم عا % % د علينا الصيام في شوال % % 9(@)(@@) % أم رمانا ببعده ناصر الملك % % ببيض الظبا وسمر العوالي % % 10(@)(@@) % ففراق الكرام يفعل في الأج % % سام ما تفعلون في الأموال % PageV01P253 11(@)(@@) % حفظ الله معشرا ضيعوا العه % د وحالوا في سائر الأحوال % 12(@)(@@) % كان شملي بهم جميعا ولكن % فرقت بيننا صروف الليالي % % 13(@)(@@) % قيل لي 
ms69	 لم بعدت عنهم وهل يص % لح أن تترك العبيد الموالي % % 14(@)(@@) % قلت لا تعجلوا علي فلو سر % ت لكانت نهاية الإخلال % 15(@)(@@) % أي شيء إلي من أمرهم حتى % % يكون إرتحالهم بارتحالي % % 16(@)(@@) % فرقت بيننا صروف الليالي % % سام ما تفعلون في الأموال % 17(@)(@@) % حاش لله ليس فشتكة الأتب % سام ما تفعلون في الأموال % 18(@)(@@) % رأس مالي ترك الفضول وما أت % رك من أجل حبكم رأس مالي % % 19(@)(@@) % ومن السخف والرقاعة تطفي % % لي عليهم يوم الوغا في القتال % 20(@)(@@) % ومسيري أذب في ظهر عجفا % % ء تباري أعضاءها بالهزال % PageV01P254 21(@)(@@) % عاطلا من جميع ما يصحب % س ويا رب عاطل وهو حالي % % 22(@)(@@) % ليس غير المقام أستر بالجد % ران ما يعلمون من سوء حالي % % 23(@)(@@) % ولعمري لو أنصفوني لما قصرت % رت عن نفعهم على كل حال % 24(@)(@@) % دارسات وناحلين فبما يف % % ت عليهم بالسعد والأقبال % 25(@)(@@) % كان حدي مثل اسم جدي قالا % % تركوني برسم زجر الفال % 26(@)(@@) % أحمد الله ما كسادي سوى الرخ % ص فإن النفاق في كل غال % 27(@)(@@) % يا خليلي عرضا بي فما أع % لم أني خطرت منهم ببال % 28(@)(@@) % وانشدا دارس الرسوم كما ين % شد ربع من الرسوم الخوالي % % 29(@)(@@) % أيها اللائمون كفوا فما أغفل % نستما منه سامعا لمقالي % % 30(@)(@@) % يا أجل الملوك عما وخالا % عند ذكر الأعمام والأخوال % PageV01P255 31(@)(@@) % ومثير الحرب العوان من المه % إلى يوم وقعة الدجال % 32(@)(@@) % والذي لم يزل تجود يديه % مزنة تستهل قبل السؤال % 33(@)(@@) % ليت شعري بأي فيء أداريك % ك فقد قل في رضاك احتيالي % % 34(@)(@@) % ليس يغنى جدي ولا ينفع الهز % د وحالوا في سائر الأحوال % 35(@)(@@) % بليال سود الدياجي طوال % ت بجهدي عليك من أثقالي % % 36(@)(@@) % وأراني في كل يوم إلى خلف % كأني خرجت في الحبال % 37(@)(@@) % ما لمخلاتي الصغيرة لا % % تدخل معكم في جملة الأعدال % 38(@)(@@) % أتراني أرضي بهذا وفي الدنيا % % ظهور الفلا وأيدي الحبال % 39(@)(@@) % لا ونعماك ما مقامي على التق % إلا من حديث المحال % 40(@)(@@) % افتحوا دوني الطريق وردوا % % لي 
ms70	 إلى عسقلان بدر الجمال % PageV01P256 41(@)(@@) % ودعوني أصيح عند ابن حمدان % ن صياحا يشق حلو السلال % 42(@)(@@) % ما اتفقنا إلا على صحبة % الدهر ولكن بدا لكم فبدا لي % % PageV01P257 البحر : طويل 1(@)(@@) % جهلتم فما وجه النهار بواضح % لديكم ولا طرف الدجى بكحيل % 2(@)(@@) % وغركم طول المقام سفاهة % كأنكم لم تسمعوا برحيل % 3(@)(@@) % إذا وقف العاني عليكم فإنما % % يمر برسم في الديار محيل % 4(@)(@@) % فإن نلتم خصب الجسوم نضارة % فرب كلام كالهلال نحيل % PageV01P258 البحر : سريع 1(@)(@@) % مرت تثنى وبها هزة % % يخدع عطفي غصنها المائل % 2(@)(@@) % كلمعة البارق مجتازة % % بمائها في البلد الماحل % 3(@)(@@) % ترنو إلى الرائع من شيبه % تلفت الظبي إلى الحابل % PageV01P259 البحر : كامل تام 1(@)(@@) % قد غادر الشعراء من يتردم % إن كان يسمع ما أقول ويفهم % 2(@)(@@) % لي كل يوم آية مشهورة % فيه إذا نثرت عليه الأنجم % 3(@)(@@) % وكواكب قد بان كيف تنالها % % الأيدي ولكن أين من يتعلم % 4(@)(@@) % فندى فحسبك إن مثلي شاكر % وغنى فحسبي إن مثلك منعم % 5(@)(@@) % لا تحفلن إذا بقيت بناطق % غيري فليس مع الفرات تيمم % 6(@)(@@) % ودع الكلام لمن يسير ثناؤه % والريح حسرى والكواكب نوم % 7(@)(@@) % قد كان قبلك واهبون وفاتهم % مدحي وماتوا والمواهب معهم % 8(@)(@@) % لم يبق بعدهم حديث سائر % فيها ولا حاد بها يترنم % 9(@)(@@) % لا يدعي الفصحاء فيك عريبة % والبيض تنثر والأسنة تنظم % 10(@)(@@) % % نطقت بمدحك قبل أن يتكلموا % % PageV01P260 11(@)(@@) % تجري جيادك في البلاد ومالها % % شأو يرام ولا مدى يتوهم % 12(@)(@@) % ويرد جدك كل خطب نازل % حتى يحل به القضاء المبرم % 13(@)(@@) % عجبا لوجهك كيف بارق بشره % تهمى سحائبه ولا يتغيم % 14(@)(@@) % ولحاسديك وهل تأخر منهم % من كان يمكن أنه يتقدم % 15(@)(@@) % ما تنزل الأفلاك غير نجومها % % أبدا ولا الغيل إلا الضيغم % 16(@)(@@) % ومعرضين نحورهم لذوابل % ما زال يمطر من أسنتها الدم % 17(@)(@@) % حاربتهم فتنصروا ولو انهم % نظروا الصواب لسالموك وأسلموا % % 18(@)(@@) % % ما ليس تطلبه سيوفك منهم % 19(@)(@@) % يمضي صليب الأرمني عليهم % وأبوك ذل له الصليب الأعظم % 20(@)(@@) % ما يصنع الحسب الكريم بعاجز % يبنى 
ms71	 له الشرف الرفيع ويهدم % PageV01P261 21(@)(@@) % لا يذكروا حلبا وبيضك دونها % % مشهورة فهي الظبا وهم هم % 22(@)(@@) % ولربما قال الجبان بقلبه % ما لا يقوم به اللسان ولا الفم % 23(@)(@@) % صعبت ففاز بها الذي لا يمتطى % % وأبت فمارنها الذي لا يحطم % 24(@)(@@) % % والنقع ليل والأسنة أنجم % 25(@)(@@) % في حيث يرتاب الحسام بحدة % ويخون صدر السمهري اللهذم % 26(@)(@@) % شرفا بني العباس إن حسامكم % ماض يطبق في العدى ويصمم % 27(@)(@@) % حملت لواءكم السحاب أنامل % أندى عليه من السحاب وأكرم % 28(@)(@@) % فكأنما حكمت على عذباته % أن لا يفارقها النسور الحوم % 29(@)(@@) % % ركن الحطيم ولا سقاكم زمزم % 30(@)(@@) % ونظرتم تلك المعالم حجرة % عنكم كما نظر الثراء المعدم % PageV01P262 31(@)(@@) % لكن أعاد لكم تراث محمد % طعن ترد به الحقوق وتغرم % 32(@)(@@) % ومتوج لمعت أسرة وجهه % حتى أضاء بها الزمان المظلم % 33(@)(@@) % غضبان يطلب حقكم بعزائم % % كالدهر يعطي ما يشاء ويحرم % 34(@)(@@) % ومن العجائب أن بيض سيوفه % تبكي دما وكأنها تتبسم % 35(@)(@@) % فالآن سلمت القلوب إليكم % وتيقنت أن الخلافة فيكم % 36(@)(@@) % ما كان حملكم القضيب بنافع % حتى يضاف إليه هذا المخذم % 37(@)(@@) % والخوف أدعى للقلوب وإنما % % خلقت على حكم الطباع جهنم % 38(@)(@@) % % شرفا وأفصح بي الزمان الأعجم % 39(@)(@@) % عرضت قبلك بالمديح فأعرضوا % % وجلوت أبكار القريض وقد عموا % % 40(@)(@@) % وفطنت بي فلبست ما لم يلبسوا % % من وشيه وغنمت ما لم يغنموا % % PageV01P263 41(@)(@@) % وهي القوافي ما يفرط عندها % % في العارفات ولا تضيع الأنعم % 42(@)(@@) % تبقى مخلدة وكل غريبة % حاشا علاك فإنها تتصرم % 43(@)(@@) % وأبيهم ما كنت أتبع خلبا % خمدت بوارقه وبحرك مفعم % 44(@)(@@) % إن أعرضوا عنها فإن عقودها % % در لمثل نحورهم لا ينظم % 45(@)(@@) % فاض الفرات بزعمهم فوردته % وتركت كل غمامة تتجهم % 46(@)(@@) % تربت يد سألت سواك وأجدبت % أرض بغير سحاب كفك توسم % 47(@)(@@) % فالعز إلا في جنابك ذلة % والمال إلا من نداك محرم % 48(@)(@@) % وغريبة سبق الوشاة بأول % منها وحسن الشعر حين يتمم % 49(@)(@@) % غنت كما سجع الحمام وربما % % زأرت كما هدر الفنيق المقرم % 50(@)(@@) % كالكاعب الحسناء إلا أنها % % من 
ms72	 فقدها الأكفاء قبلك آيم % PageV01P264 51(@)(@@) % أظهرت فيها المعجزات لأمة % ذل البليغ بها وعز المفحم % 52(@)(@@) % لو كان في نظم القريض نبوة % % صلى علي السامعون وسلموا % % PageV01P265 البحر : بسيط تام 1(@)(@@) % فإن دعوا بك تحميها فما ظلموا % % فما تخالفها عرب ولا عجم % 2(@)(@@) % يجري القضاء بما تهوى فإن جمحت % عنها القلوب أطاعت أمرها القمم % 3(@)(@@) % تروي وتحيي نفوس العائذين بها % % فعندها نعم في طيها نقم % 4(@)(@@) % كأنما هي للأعمار مالكة % فمن مضاربها تعطي وتخترم % 5(@)(@@) % نادت نمير فلبتها وقد لؤمت % فيها الكرام وماتت دونها الهمم % 6(@)(@@) % فضارب الخوف عنها وهي مغمدة % % وليس كل ضراب أن يراق دم % 7(@)(@@) % أغنى كتابك عن جيش تجهزه % ووقر السيف لما أقنع القلم % 8(@)(@@) % يا همة حمل الإسلام منتها % % ونعمة صغرت في جنبها النعم % 9(@)(@@) % هل عند قبر شبيب منك معرفة % فربما صنعت ما تصنع الديم % 10(@)(@@) % دعتك رمته والترب بينكما % % ومن فروض العلى أن تسمع الرحم % PageV01P266 11(@)(@@) % فلم يكن بك فيما قاله حصر % ولا بسمعك عما قاله صمم % 12(@)(@@) % عليك إذا أبصرتها وعموا % % فإن دعوا بك تحميها فما ظلموا % % 13(@)(@@) % ماتوا ولكنهم أحيا بذكرهم % % إن الثناء وجود ما له عدم % 14(@)(@@) % أحيت سيوفك ميت العز في مضر % وأسفرت بسناها عنهم الظلم % 15(@)(@@) % كانت لهم آية في الفخر واحدة % % حتى خلقت فصار الدين والكرم % 16(@)(@@) % قالت عداتك طرق المجد خافية وما % % عليك إذا أبصرتها وعموا % % 17(@)(@@) % كم خلة لك راموا ستر شارفها % % حتى رأوه صباحا ليس ينكتم % 18(@)(@@) % أطلعت منها شموسا غير آفلة % وعاندوك فقالوا إنها شيم % 19(@)(@@) % ما أيقنوا لغريب من بدائعها % % إلا وقد جهلوا فوق الذي علموا % % 20(@)(@@) % ولا أطاعوك إلا بعد معرفة % بأن مثلك لا يعصيه مثلهم % PageV01P267 21(@)(@@) % شفت سيوفك داء من عقوقهم % لها ورب شفاء كله سقم % 22(@)(@@) % يا ابن الألى رضعوا خلف الندى فربوا % % بدره ثم ماتوا قبل ما فطموا % % 23(@)(@@) % لا تأسفن لموتاهم إذا ذهبوا % % فما مضى أحد منهم وأنت هم % 24(@)(@@) % ما يخبر الناس عن قوم بقيتهم % أبو سلامة إلا 
ms73	 أنهم سلموا % % PageV01P268 البحر : بسيط تام 1(@)(@@) % أما فؤادي فقد رقت جوانحه % عن الغرام وخانتني عزائمه % 2(@)(@@) % ولست أنكر ما فيه لبعدكم % وكيف أنكره والله عالمه % PageV01P269 البحر : مديد تام 1(@)(@@) % ما على الواشين من حرج % مثل ما بي ليس ينكتم % 2(@)(@@) % زعموا أني أحبكم % وغرامي فوق ما زعموا % % PageV01P270 البحر : وافر تام 1(@)(@@) % إذا عزت صفاتك أن تراما % % قضينا في الحديث بها ذماما % % 2(@)(@@) % وما قصرت يد دون الثريا % % فخافت عند عارفها ملاما % % 3(@)(@@) % لك النسب الذي من سار فيه % فما يخشى الضلال ولا الظلاما % % 4(@)(@@) % إذا طلعت بدور بني حميد % فحق للكواكب أن تضاما % % 5(@)(@@) % أما وقبورهم فلقد أجنت % عظاما في ضرائحها عظاما % % 6(@)(@@) % لقد أبقيت مجدهم وماتوا % % فكانوا لا حياة ولا حماما % % 7(@)(@@) % ورب منازع لك في المعالي % % سهرت على الطلاب لها وناما % % 8(@)(@@) % يحدث عن لقائك بالأماني % % فقال العارفون بها سلاما % % 9(@)(@@) % ومجتاز بأرضك حذرته % سيوفك إن يريد بها مقاما % % 10(@)(@@) % أدل بجده فكفاك جد % يفل سعوده الجيش اللهاما % % PageV01P271 11(@)(@@) % ضربناه بذكرك وهو لفظ % % فكان القلب واليد والحساما % % 12(@)(@@) % عجبت لقصده المولى بعزم % يقصر أن ينال به الغلاما % % 13(@)(@@) % حلفت بها خماصا كالحنايا % % وإن كانت لسرعتها سهاما % % 14(@)(@@) % تخب بمحرمين تسنموها % % وأموا فوقها البلد الحراما % % 15(@)(@@) % ليوم فيه دولتك اطمأنت % قواعدها حقيق أن يضاما % % 16(@)(@@) % أبيت اللعن إن كثرت شجوني % % فإني قد وجدت لها مساما % % 17(@)(@@) % فإن بلغت إليك بي الليالي % % فقد زجيتها عاما فعاما % % 18(@)(@@) % وروتني سحابك في بلاد % كثيرا ما شكوت بها الأواما % % 19(@)(@@) % وأغناني عطاؤك عن أناس % حسبتهم ولا بلغوا كراما % % 20(@)(@@) % بعثت إلى نوالهم رجاء % % تعلم كي ينتجع الجهاما % % PageV01P272 21(@)(@@) % فإن أكدى لئيم الظن فيهم % فإني قد عرفت به اللئاما % % 22(@)(@@) % وما لي والبخيل وقد كفتني % % مواهبك التي كفت الأناما % % 23(@)(@@) % إذا ضن السراب على نداه % فقد نالت يد الصادي الغماما % % 24(@)(@@) % وما غبت مكارمك القوافي % % وإن كانت زيارتها لماما % % 25(@)(@@) % وكيف يضيع جودك في كريم % أعد لشكره هذا الكلاما % % 26(@)(@@) % قصائد إن ترنح سامعوها 
ms74	 % % فإني قد أبحت بها المداما % % 27(@)(@@) % تزور صبابة وأحن شوقا % % كلانا يدعي فيك الغراما % % 28(@)(@@) % إذا زفت إليك علمت أني % % ملكت لكل جامحة زماما % % 29(@)(@@) % ولولا أنها وجدتك كفؤا % لكانت في الصدور من الأيامي % % 30(@)(@@) % ولو قصدت سواك لقلت فيها % % أراني الله نقبك في السلامى % % PageV01P273 البحر : بسيط تام 1(@)(@@) % إذا اتقى القوم قبل الصيد في حرم % % جعلت كل مكان حله حرما % % 2(@)(@@) % لا تحمد الدهر في فعل يجود به % فليس يقصد لا بخلا ولا كرما % % 3(@)(@@) % قالوا أتيناه لما ناله هرم % وما أصابوا ولكن لم يزل هرما % % 4(@)(@@) % ما سر كسري ولم تذهب مدائنه % ولا سنانا وقد أنفى له الهرما % % 5(@)(@@) % تأتي لياليه إسعافا وكلهم % أصغى إلى البين مغترا فلا جرما % % PageV01P274 البحر : طويل 1(@)(@@) % يقولون شهب الليل تحكم فيهم % وأقسم ما سارت بعدل ولا ظلم % 2(@)(@@) % إذا فكر الإنسان في الدهر لم يجد % بيانا وألفى جهله غاية العلم % 3(@)(@@) % فعش فيهم أعمى وإن كنت مبصرا % سفيها وإن نزهت نفسك بالحلم % 4(@)(@@) % فما العيش إلا ما غنمت نهابه % ولا العمر إلا طارق زار في حلم % 5(@)(@@) % لعمري لقد أنحى الزمان بحربه % علي ولكن ما جنحت إلى السلم % PageV01P275 البحر : بسيط تام 1(@)(@@) % إليك عني فليس الخوف من شيمي % % سيطرد الهم ما يسمو من الهمم % 2(@)(@@) % إذا سررت فما ثغري بمبتسم % % وإن جزعت فما دمعي بمنسجم % 3(@)(@@) % يا ناشد العز مطويا على ضمد % ما يدرك المجد بين الشاء والنعم % 4(@)(@@) % أمامك القاع فاقذفها مضمرة % كأنما وضحت أخفافها بدم % 5(@)(@@) % حتى تراها وقد أودى الكلال بها % % وفي مناسمها عقل من الخدم % 6(@)(@@) % وصاحب كغرار العضب مفترش % نمارق الرمل طلاع على الظلم % 7(@)(@@) % يخالس الصبح والظلماء تحجبه % تستر البرق بين الوابل الردم % 8(@)(@@) % يهب يعثر في أذياله وسنا % كأنما النوم بين الساق والقدم % 9(@)(@@) % هلم نرسلها هوجاء سامية % لا يمنع السيف فيها خدعة القلم % 10(@)(@@) % إنا إذا الحي لا ترعى سوائمه % إلا تذكر ريح الضال والسلم % PageV01P276 11(@)(@@) % وأخمد البرق حتى في بيوتهم % ما يظهر الزند 
ms75	 ما فيه من الضرم % 12(@)(@@) % وراحت النيب في الأنساع ساغبة % تنافس الخيل إن عللن باللجم % 13(@)(@@) % نبنا عن الغيث أحيانا فحلتنا % % لا يعدم الغيث فيها هاطل الديم % 14(@)(@@) % هلم طيف سليمى قد جلوت لنا % % غياهب الصد لولا خدعة الحلم % 15(@)(@@) % نشدتك الله هل أنسيت ليلتنا % % على الثنية دون السفح من إضم % 16(@)(@@) % وليلة الحي إذ أغرى الرقيب بنا % % فما اتقينا بغير الخمر واللثم % 17(@)(@@) % فكيف تقذف ودا كنت تحفظه % لقد خصمتك لو صرنا إلى حكم % 18(@)(@@) % لولا عقابيل وجدي قلت حبهم % % كخلب البرق لم يمطر ولم يدم % 19(@)(@@) % وبانة السفح تغريني بذكرهم % وجدا فيا ليتها باتت كعهدهم % 20(@)(@@) % هل الأجيرع يشفي من يمر به % بالعرف أم ذاك مع أيامنا القدم % PageV01P277 21(@)(@@) % ونشقة خطرت والركب مشتمل % ذؤابه الليل بين الأينق الرسم % 22(@)(@@) % شاقت طلى حانها وافى رحالهم % % سكرا من السير أو ضعفا من السقم % 23(@)(@@) % آها لقلبك من نجد وساكنه % لقد علقت بشعب غير ملتئم % 24(@)(@@) % ما هبت الريح إلا من جوانبه % ولا علا الشيح إلا ذروة العلم % 25(@)(@@) % لله ليلك كم أفنيت من جلد % حتى الصباح وكم أبقيت من ألم % PageV01P278 البحر : منسرح 1(@)(@@) % وصاحب كلما هممت به % وهبت لؤم العقوق للكرم % 2(@)(@@) % حاول نيل الكرام مقتصرا % على الذي شاد من عيوبهم % 3(@)(@@) % يمر متع في ذمة الخمول فما % % تغض من لواذع الكلم % 4(@)(@@) % لو ضربت بالسيوف راحته % لما تندت من بخله بدم % 5(@)(@@) % فدى لمن لا يزال نائله % يخلف جودا سحائب الديم % 6(@)(@@) % يمنح حتى تدوم نعمته % إن العطايا تمائم النعم % PageV01P279 البحر : متقارب تام 1(@)(@@) % أيا ملك الروم شتما لهم % وفي ظاهر القول لم أشتم % 2(@)(@@) % تجاوزت في البخل حد الكلاب % % ففي أي طائفة تنتمي % % 3(@)(@@) % وأظهرت في البطرم المعجزات % % وكنت بفعلك في بطرم % PageV01P280 البحر : كامل تام 1(@)(@@) % يا غائبا ببعاده وحمامه % جار الزمان عليك في أحكامه % 2(@)(@@) % لتطل ليالي الدهر بعدك إنه % سيان بين صباحه وظلامه % 3(@)(@@) % سودته في ناظري كأنما % % خلعت لياليه على أيامه % PageV01P281 البحر : وافر تام 1 
ms76	(@)(@@) % أما حياكم عبق النسيم % فيخبر عن ثرى تلك الرسوم % 2(@)(@@) % وتنجده الذوافر حين ترخى % % عليه ذوائب الليل البهيم % 3(@)(@@) % أما ذا البرق بيض بني عدي % فكيف رمى فؤادك بالهموم % 4(@)(@@) % هنيئا للمدامع بث وجدي % % لقد خبرن عن خلق كريم % 5(@)(@@) % أمنك الطيف هب مع الخزامى % % يخادع عطفه ولع النسيم % 6(@)(@@) % رأى قرب الحسام وغار منه % فحاكمنا إلى العهد القديم % 7(@)(@@) % أحن إذا أصاب الغيث نجدا % وقعقع بالرعود على الغيوم % 8(@)(@@) % ولما كنت أطرب للغوادي % % ظننت خلائقي زهر الغميم % 9(@)(@@) % أفي مجدي طمعت أخا الهوينا % % وما بال البويزل والقروم % 10(@)(@@) % تناكرك القبائل من نزار % كأنك فيهم خلق اللئيم % PageV01P282 11(@)(@@) % وعزمي يستقل الأفق دارا % ويأنف من مصاحبة النجوم % 12(@)(@@) % وترب يدعيه المسك طيبا % إذا وسمته أندية الحميم % 13(@)(@@) % يعز به إذا سفه النعامى % % ويعرض عن منازعة الحليم % 14(@)(@@) % وروض مل حر الشمس حتى % % تفيأ بالسحائب والغيوم % 15(@)(@@) % إذا عبثت به ريح الصبا النعامى % % تمايل طربه الرجل السقيم % 16(@)(@@) % صحبت إليه أكوار المطايا % % فجادت بالغوارب والرسيم % 17(@)(@@) % وقبل نوره أفواه خيلي % % فغازلهن من نصب الشكيم % 18(@)(@@) % فبتن كأنهن بأل حزن % وذاك الربد تلعب بالحلوم % 19(@)(@@) % لهن إذا سرحن به مراح % مراح الحمد في الحسب الصميم % 20(@)(@@) % وحي من خفاجة رحت فيه % على جرداء حالية الأديم % PageV01P283 21(@)(@@) % أبيح الخمر فيه حمى همومي % % فأطربها وتفتك بالنديم % 22(@)(@@) % وكحلاء الجفون قرعت منها % % نجاد السيف بالعقد النظيم % 23(@)(@@) % وأحياء حبائلهم كراهم % طرقتهم بقاطعة النميم % 24(@)(@@) % أفي فضلي يباريني غوي % وأين الوجه يبذل للسهوم % 25(@)(@@) % فلا لك ما نسبت إلى سنان % ولا عزيت خؤولك في تميم % 26(@)(@@) % نجوم الليل يسهرها حذاري % % وسمر الخط يرعدها عزيمي % % 27(@)(@@) % ودمعي في جفون الركب يبدو % % كدمع الغيث في حدق النجيم % 28(@)(@@) % وقد خبرت عن نشب قليل % فهل خبرت عن خلق ذميم % PageV01P284 البحر : وافر تام 1(@)(@@) % تحاذر أن أسبك يا ابن سلمى % % كأن أباك في حسب كريم % 2(@)(@@) % وبالشهباء من حزن ابن عمرو % بيوت ما رفعن على لئيم % % 3(@)(@@) % إذا ما شئت هب 
ms77	 إلي منها % % مذربة الأسنة كالنجوم % PageV01P285 البحر : رمل تام 1(@)(@@) % لست من عدنان إن لم ترها لست من عدنان إن لم ترها % % كذئاب القاع يرعين اللجم % 2(@)(@@) % كل نشوان يبادي عطفه % غصن البانة والرمح الأصم % 3(@)(@@) % قد أغاروا فحووا ما بالفنا % % من تمام وقوام وهضم % % 4(@)(@@) % يا بني قيلة لا تخدعكم % هجمة الليث إذا الليث هجم % 5(@)(@@) % إن أسياف نزار طبعت % لطلاكم وعراقيب النعم % 6(@)(@@) % رب خل طمح الغي به % فوهبنا اللؤم فيه للكرم % 7(@)(@@) % وابن عم قد بلونا سره % فلبسناه على ما قد كتم % 8(@)(@@) % ونديم عبها في ليلة % غط فيها الكأس جلباب الظلم % 9(@)(@@) % كلما حاربنا ضوء الضحى % % حالف الصبح علينا وابتسم % 10(@)(@@) % إن تريني بمضلات الغنى % % أحمل الجود على ظهر العدم % PageV01P286 11(@)(@@) % فأبي النفس عن ذل المنى % % وخفيف الظهر عن حمل النعم % PageV01P287 البحر : متقارب تام 1(@)(@@) % صرفت بعدلك صرف الزمان % وأحيت عطاياك ميت الكرم % 2(@)(@@) % فلا زال بشرك قبل النوال % كما ابتسم الغيث ثم انسجم % % 3(@)(@@) % وسيفك يسبق شأو السحاب % ب ذاك بماء وهذا بدم % PageV01P288 البحر : بسيط تام 1(@)(@@) % استغفر الله سري في الهوى علن % وقد قنعت فقلت عندي المنن % 2(@)(@@) % عرفت دهري فلم أحفل بحادثة % فيه فلا فرح عندي ولا حزن % 3(@)(@@) % فن من العيش لا تخشى عواقبه % ولا تثار به الأحقاد والاحن % 4(@)(@@) % ضل الذين رأوا في النسل فائدة % % ولو أصابوا لما ربوا ولا حضنوا % % 5(@)(@@) % وقد تصافى رجال لو كشفت لهم % سجية الناس خافوا كل من أمنوا % % 6(@)(@@) % يجري القضاء بما تعيا العقول به % وينصر الجهل حتى يعبد الوثن % 7(@)(@@) % والظلم طبع ولولا الشر ما حمدت % في صنعة البيض لا هند ولا يمن % 8(@)(@@) % ذممت دهرك إذ نابتك نائبة % بمثل ما تشتكيه يعرف الزمن % 9(@)(@@) % خفض عليك فإن العمر مخترم % والموت منتظر والحر ممتحن % 10(@)(@@) % ولا يغرك خلق راق ظاهره % فليس تصندق لا عين ولا أذن % PageV01P289 11(@)(@@) % صحبت قوما يعد الشر عندهم % حزما تشير به الآراء والفطن % 12(@)(@@) % عموا عن الرشد واعتادت نفوسهم % فعل القبيح 
ms78	 فظنوا أنه حسن % 13(@)(@@) % وقد توالت على قصدي سهامهم % % ولي من الزهد في أوطانهم جنن % 14(@)(@@) % رضيت عيشي فلا حرص ولا طمع % وصنت عرضي فلا عار ولا درن % 15(@)(@@) % إذا سغبت فجسم لا حياة به % وإن ظمئت فماء ما له ثمن % 16(@)(@@) % خير المشارب ما تبقى الحياة به % في فطرة الخلق لا ماء ولا لبن % 17(@)(@@) % وأفضل القوت ما جادت لطالبه % يد الثرى وقراه العارض الهتن % 18(@)(@@) % لا أطلب الرزق من سيف ولا قلم % ولا يمارس في ما أكسب المهن % 19(@)(@@) % ورثت مال أناس طال عهدهم % غنيت منهم وما خبرت كيف غنوا % % 20(@)(@@) % وأفسدوا بجوار الروم عيشهم % % إن حاربوا أسروا أو سالموا دهنوا % % PageV01P290 21(@)(@@) % فما تخلف عنهم غير حادثة % تلوكها هذه الأحداث والفتن % 22(@)(@@) % هي العواصم مرمى كل فاقرة % فليس تسكن لولا أنها وطن % 23(@)(@@) % وقد تقدم فيها معشر دفنوا % % حتى يحوروا وعندي أنهم دفنوا % % 24(@)(@@) % أهون علي بدنياهم وإن كثرت % على محبتها الأظعان والإحن % 25(@)(@@) % يا دمنة الشر لا جادتك سارية % فطالما درست من جودك الدمن % 26(@)(@@) % يمضي الزمان وتعفو كل حادثة % فيه وقد ثبتت من ظلمك السنن % 27(@)(@@) % ألفت شرك حتى ما أراع به % وكيف تفرق سيفك البارق المزن % 28(@)(@@) % وأضحكتني حقود منك بادية % وهل يضيق برسم دارس عطن % 29(@)(@@) % تبارك الله ما في الخلق مشكلة % وليس يطمع في إدراكه المنن % 30(@)(@@) % ولا تهب من الأحلام راقدة % % إلا ويغبر في أجفانها الوسن % PageV01P291 31(@)(@@) % يا عالم المصر هل أضمرت خافية % عن البصائر في ايضاحها شجن % 32(@)(@@) % أم ليس عندك إلا حيلة لفتى % تصيبه وحديث كله طنن % 33(@)(@@) % رميت خصمك بالتقليد متبعا % % فيه وأنت بما أنكرته قمن % 34(@)(@@) % وكيف تصدق في الأخبار مرسلة % وما أراك مع الإسناد مؤتمن % 35(@)(@@) % وكم تضمن قوم في جدالهم % أن يفهموك فما أوفوا بما ضمنوا % % 36(@)(@@) % خف من جليسك واصمت إن بليت به % فالعي أفضل مما يجلب اللسن % 37(@)(@@) % ولا يغرك قول سار في مثل % فما ابن سيرين مأمون ولا الحسن % 38(@)(@@) % كل الأنام لأم 
ms79	 غير منجبة % فما زكى فيهم عرق ولا غصن % 39(@)(@@) % ولا تقدم منهم معشر خمدوا % % فلا تغرك أخبار الذين فنوا % % PageV01P292 البحر : طويل 1(@)(@@) % توق كلامي يا ابن عمرو فإنه % أسنة عار لا يبل طعينها % % 2(@)(@@) % فقد نازعتني العز فيك قبائل % ملأت عليها دهرها ما يهينها % % 3(@)(@@) % وفارقتها مستبدلا دار غربة % ألا إن أوطان الغنا ما يصونها % % 4(@)(@@) % توقد من غيظ علي صدورها % % وتزور من خوف إلي عيونها % % 5(@)(@@) % غدت فقر مني تثير مخازيا % % بأعراضها لو كان لؤم يشينها % % 6(@)(@@) % خلائق ندب أطمعتكم سهولها % % ستفزعكم عما قليل حزونها % % 7(@)(@@) % وكيف يرام الذل مني وعامر % تقضى بأطراف العوالي ديونها % % 8(@)(@@) % وما نكرت بيض السيوف صدورها % % ولا جهلت سمر الرماح متونها % % 9(@)(@@) % نبذتك نبذ العار مني فلو صبت % إليك شمالي فارقتها يمينها % % 10(@)(@@) % ولو كنت برقا بالغوير بدت به % منازل سلمى سهلها ووجينها % % PageV01P293 11(@)(@@) % لأعرضت عنه والجوى في مقره % ونازعت نفسا جن منها جنونها % % 12(@)(@@) % متى أنأ غاد بالغميم وصحبتي % % تجاود هطال الغوادي شؤنها % % 13(@)(@@) % على ضمر باريتهم بحنينها % % غراما وبارها سقاما حنينها % % 14(@)(@@) % تجد إذا هبت رياح مريضة % ضلالك منها إن توعك لينها % % 15(@)(@@) % إذا خلن غدران الغوير صوارما % % تمنين لو أجفانهن جفونها % % 16(@)(@@) % فإن بقلبي من فراق عذيبة % طماعة شك لا عراني يقينها % % PageV01P294 البحر : كامل تام 1(@)(@@) % يا ناصر الأمر الذي بسيوفه يا ناصر الأمر الذي بسيوفه % ذلت أعاديه وعز الدين % 2(@)(@@) % أرهفت في ظلم الخطوب عزائما % تثني بها الأقدار وهي سكون % 3(@)(@@) % أكثرت حاجاتي إليك مثقلا % ورجاء مثلك كالحديث شجون % 4(@)(@@) % إن كنت واهبها فجودك غامر % أو شافعا فيها فأنت مكين % PageV01P295 البحر : رمل تام 1(@)(@@) % ما على أحسنكم لو أحسنا % % إنما نسأل شيئا هينا % % 2(@)(@@) % قد شجانا اليأس من بعدكم % فغدونا بأحاديث المنى % % 3(@)(@@) % وعدوا بالوصل من طيفكم % مقلة لم تدر فيكم وسنا % % 4(@)(@@) % لا وسحر بين أجفانكم % فتن الحب به من فتنا % % 5(@)(@@) % وحديث من مواعيدكم % تحسد العين عليه الأذنا % % 6(@)(@@) % ما رحلت العيس عن أرضكم % فرأت عيناي شيئا حسنا 
ms80	 % % 7(@)(@@) % يا بني عذرة إن ضفناكم % فدم الهرماس منكم عندنا % % 8(@)(@@) % أخذت سمركم الثأر به % لست أعني لكم سمر القنا % % 9(@)(@@) % وسللتم فيه ألحاظكم % فعرفنا بالسيوف اليمنا % % 10(@)(@@) % هل لنا نحوكم من عودة % ومن التعليل قولي هل لنا % % PageV01P296 11(@)(@@) % كم أسلي النفس عن حبكم % وهي لا تزداد إلا حزنا % % 12(@)(@@) % ولعمري لو وجدنا راحة % من هواكم لطلبنا شجنا % % 13(@)(@@) % يا نديمي على ذكرهم % وحديث الشوق قد أسكرنا % % 14(@)(@@) % بين بصرى وضمير عرب % % يأمن الخائف فيهم ما جنى % % 15(@)(@@) % كلما شنت عليهم غارة % أغمدوا البيض وسلوا الأعينا % % 16(@)(@@) % طلعت للحسن فيهم مزنة % أنبتت في كل حقف غصنا % % 17(@)(@@) % ما لقلبي ليس يشفى داؤه % كلما زال ضنى عاد ضنا % % 18(@)(@@) % كل يوم صبوة عذرية % من هواكم تتلاقى الدمنا % % 19(@)(@@) % لو سلمنا من تباريح الهوى % % لذكرنا جملة من أمرنا % % 20(@)(@@) % وشكرنا لابن نصر منة % أنطقت بالمدح فيه الألسنا % % PageV01P297 21(@)(@@) % مغرم بالجود ما يحمله % نصب الفقر على حب الغنى % % 22(@)(@@) % كلما عرض بالحمد له % أكثر السوم وأغلى الثمنا % % 23(@)(@@) % ما تراه كيف ما مالت به % عقب الأيام إلا محسنا % % 24(@)(@@) % وقريب بعدت همته % رب أمر ما نأى حتى دنا % % 25(@)(@@) % وإذا ما أقبلت غائرة % كقنا الخط خفافا لدنا % % 26(@)(@@) % صاح محمود على فراطها % % لا فتى يعطفها إلا أنا % % 27(@)(@@) % خلقت للجود منه راحة % علمتنا أن نذم المزنا % % 28(@)(@@) % يا عماد الحزم نعتا صادقا % % ومن الألقاب مين والكنى % % 29(@)(@@) % لا أرى عتبك إلا ظاهرا % خير شكوى عاشق ما أعلنا % % 30(@)(@@) % كنت ترمي زمني دوني فقد % صرت أخشى أن يكون الزمنا % % PageV01P298 31(@)(@@) % ما تعاملنا بحمد الله في % % سبب يوجب خلفا بينا % % 32(@)(@@) % غير شعر ربما أهديته % لك إذ صادف وقتا ممكنا % % 33(@)(@@) % ليس في الأعداء من يفهمه % فيقولوا إنه ما أحسنا % % 34(@)(@@) % ولعمري إن في حبهم % ما يرى سحبان إلا ألكنا % % 35(@)(@@) % كل يوم لي منهم نوبة % تذر الحر بهم ممتحنا % % 36(@)(@@) % وعلى العلات لا زلت بما % % أكره التصريح فيه فطنا % % 37(@)(@@) % أنكروا حرصي على السلم 