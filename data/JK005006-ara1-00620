ms601	 الربيع بن روح عن محمد بن حرب عن الزبيدي عن عدي بن عبد الرحمن الطائي عن داود بن أبي هند عنه .(@)(@@) العلاء بن اللحلاح عنه(@)(@@) 5221 - حديث : أوصاني خليلي . . . الحديث ( 1 ) .(@)(@@) غريب من حديثه عن أبي هريرة لم يروه عنه غير أيوب بن ينط ، تفرد به مبشر بن إسماعيل .(@)(@@) العلاء بن زياد عن أبي هريرة(@)(@@) 5222 - حديث : أن منزل المؤمن في الجنة مسيرة الراكب . . . الحديث ( 2 ) .(@)(@@) تفرد به إبراهيم بن طهمان عن الحجاج بن الحجاج عن قتادة عن عطاء .(@)(@@) عبيد الله الزنجي عن أبي هريرة(@)(@@) 5223 - حديث : أول ما يرفع من هذه الأمة الخشوع ( 3 ) . . .(@)(@@) غريب من حديث الثوري عن يحيى بن عبيد الله عن أبيه .(@)(@@) 5224 - حديث : ما خلا يهوديان بمسلم . . . الحديث ( 4 ) . PageV05P222(@)(@@) غريب من حديث الثوري عن يحيى عن أبيه ما كتبته إلا عن الحسن بن إبراهيم المقرئ عن ( المعري ) ( ) بن محمد عن أبي بشر عن الأشجعي ( 1 ) عن الثوري وغيره لا يذكر فيه الثوري .(@)(@@) 5225 - حديث : عمل قليل في سنة . . . الحديث .(@)(@@) تفرد به يحيى بن عبيد الله ( 2 ) عن أبيه .(@)(@@) عبيدة بن سفيان ( 3 ) عنه(@)(@@) 5226 - حديث : إن الرجل ليغضب الغضبة . . . الحديث .(@)(@@) تفرد به أبو غسان الكتابي محمد بن يحيى الذهلي عنه ولا يعلم عمر بن عبيدة بن سفيان اسند غير هذا .(@)(@@) عكرمة عنه(@)(@@) 5227 - حديث : لا يزني الزاني . . . الحديث ( 4 ) .(@)(@@) غريب من عمارة بن أبي حفصة ( 5 ) عنه عن النبي ، تفرد به محمد بن دينار PageV05P223 الطاحي ( 1 ) مرفوعا ، ولا نعلم حدث به عن الصلت بن محمد أبو همام الخاركي ( 2 ) .(@)(@@) 5528 - حديث : الهر من متاع البيت ( 3 ) .(@)(@@) تفرد به حفص بن عمر العدني عن الحكم بن أبان عنه .(@)(@@) 5529 - حديث : سمعت النبي يحكي موسى على المنبر .(@)(@@) غريب من حديث عكرمة عنه ، تفرد به الحكم بن أبان ( 4 ) عتبة وعنه أمية بن شبل وعنه هشام بن يوسف الصنعاني ( 5 ) .(@)(@@) 5230 - حديث : كان قدومنا المدينة سنة خمس من الهجرة . . . الحديث ( 6 ) .(@)(@@) تفرد به عبد الله بن محمد بن 
ms602	 عمارة الأنصاري يعرف بابن القداح عن سليمان بن داود بن الحصين عن أبيه ( 7 ) عن عكرمة وفيه سن ابن عباس .(@)(@@) عامر الشعبي عن أبي هريرة(@)(@@) 5231 - حديث : أن النبي نهى في غزوة أوطاس أن يقع الرجل على حامل ( 8 ) ز PageV05P224(@)(@@) غريب من حديث داود بن أبي هند ( 1 ) عنه ، تفرد به الحجاج بن أرطأة ( 2 ) عنه ، ولا نعلم حدث به غير إسماعيل بن عياش .(@)(@@) 5232 - حديث : إذا طلع النجم رفع عن كل بلد العاهة ( 3 ) .(@)(@@) غريب من حديث الشعبي عنه ، ومن حديث زكريا بن أبي زائدة عنه إن كان شيخنا محمد بن سليمان الباهلي ضبطه فإنا لم نكتبه بهذا الإسناد إلا عنه ، وإنما يعرف من حديث أبي حنيفة ( 4 ) عن عطاء بن أبي رباح ( 5 ) عن أبي هريرة .(@)(@@) 5233 - حديث : نهى رسول الله عن بيع الغرر ( 6 ) .(@)(@@) تفرد به أحمد بن محمد بن زرك عن روح بن عبادة ووراه أحمد بن حنبل ( 7 ) وعبد الله بن هاشم عن روح ( 8 ) فلم يذكرا بيع الغرر . PageV05P225(@)(@@) 5234 - حديث : لا ( أبغض ) ( ) بني تميم بعد ثلاث . . . الحديث .(@)(@@) تفرد به داود بن أبي هند عنه وهو صحيح عنه لم يروه / عنه غير عبد الوارث بن سعيد ( 1 ) وتابعه مسلمة بن سليمان .(@)(@@) 5235 - حديث : أهل الدرجات العلى . . . الحديث ( 2 ) .(@)(@@) غريب من حديثه عن أبي هريرة ، تفرد به يونس بن أبي إسحاق عن الشعبي .(@)(@@) 5236 - حديث : أن النبي قال : لا تبايعوا بالحصى . . . الحديث ( 2 ) .(@)(@@) قال ابن صاعد : وهو غريب ما سمعناه إلا من عبد الله بن هاشم الطوسي ( 4 ) عن روح عن شعبة عن بيان ( 5 ) عنه .(@)(@@) 5237 - حديث : قال : من أدرك الصبح وهو جنب . . . الحديث ( 6 ) .(@)(@@) تفرد به هشيم بن سيار ولم أجده إلا عند الهيثم بن جميل . PageV05P226(@)(@@) 5238 - حديث : نهى رسول الله أن تنكح المرأة على عمتها . . . الحديث ( 1 ) .(@)(@@) تفرد به جعفر الطيالسي عن يحيى بن معين عن يزيد بن عبد ربة ( 2 ) عن بقية بن الوليد ( 3 ) عن شعبة عن داود بن أبي هند 
ms603	 عنه .(@)(@@) عروة بن الزبير عن أبي هريرة(@)(@@) 5239 - حديث : لا يجرئ والد ولده . . . الحديث ( 4 ) .(@)(@@) غريب من حديث هشام عن أبيه ، تفرد به قيس بن الربيع ولم يروه عنه غير بكر بن بكار ولم نكتبه إلا عن شيخنا أبي الأسود عبيد الله بن موسى بن إسحاق الأنصاري .(@)(@@) 5240 - حديث : إن الناس يكثرون وأصحابي يقلون . . . الحديث ( 5 ) . PageV05P227(@)(@@) 5241 - حديث : اسرعوا بالجنازة . . . الحديث ( 1 ) .(@)(@@) غريبان من حديثه عن أبي هريرة ، تفرد بهما عصمة بن الفضل عن هشام .(@)(@@) 5242 - حديث : آخر قرية من قرى الإسلام خرابا المدينة ( 2 ) .(@)(@@) تفرد به جنادة بن سلم عن هشام عن أبيه عنه .(@)(@@) 5243 - حديث : من قال لا إله إلا الله موقنا . . . الحديث ( 3 ) .(@)(@@) تفرد به الحسين بن حميد عن سيار بن فروح عن قزعة بن سويد ( 4 ) عن عمرو بن دينار عن عروة قال الحسين وحدثني به مرة أخرى فلم يذكر عروة .(@)(@@) عطاء عن أبي هريرة(@)(@@) 5244 - حديث : سجدنا مع النبي في ( ^ إذا السماء انشقت ) . . . الحديث ( 5 ) . PageV05P228(@)(@@) تفرد به شخينا محمد بن جعفر عن عيسى بن عبد الله الطيالسي عن محمد بن سابق ( 1 ) عن زائدة عن سفيان وشعبة عن أيوب بن موسى ( 2 ) عن عطاء بن يسار ، وقال في موضع آخر غريب من حديث محمد بن المنكدر عن عطاء تفرد به محمد بن إسحاق ، وتفرد به محمد بن إسماعيل الحساني ( 3 ) عن / يزيد بن هارون عن أبي إسحاق .(@)(@@) 5245 - حديث : لا يبولن أحدكم في الماء الدائم . . . الحديث ( 4 ) .(@)(@@) تفرد به الحارث بن عبد الرحمن بن أبي ذباب ( 5 ) عن عطاء بن يسار .(@)(@@) 5246 - حديث : كان رسول الله إذا اقيمت الصلاة . . . الحديث ( 6 ) .(@)(@@) تفرد به زياد البكائي عن محمد بن عمارة عن إسماعيل بن الفضل عن المعافى بن سليمان ( 7 ) عن زهير عن محمد بن جحادة عن عمرو بن دينار ( 8 ) عن عطاء بن يسار ( عن زهير وتابعه ) ( ) أن النبي خرج من الخلاء فأتى بطعام . . . الحديث . وهذا يقويان عن إسماعيل بن الفضل عن مشايخه عن زهير وتابعه 
ms604	 زياد PageV05P229 البكائي ( 1 ) ، تفرد به ابن جحادة عن عمرو عن عطاء عن أبي هريرة والصواب عن عمرو عن سعيد بن الحويرث عن ابن عباس(@)(@@) 5247 - حديث : طهور إناء أحدكم . . . الحديث ( 2 ) .(@)(@@) تفرد به إبراهيم بن أبي يحيى عن صفوان بن سليم عن عطاء بن يسار وحميد بن عبد الرحمن عنه .(@)(@@) 5248 - حديث : الناس تبع لقريش . . . الحديث ( 3 ) . تفرد به إبراهيم بن أبي يحيى عن صفوان عن عطاء بن يسار وحده .(@)(@@) 5249 - حديث : إذا أقيمت الصلاة . . . الحديث .(@)(@@) تفرد به محمد بن أشكاب عن عبيد الله بن موسى مرفوعا يعني إبراهيم بن إسماعيل بن مجمع ( 4 ) عن الزهري عن عطاء بن يسار ( 5 ) .(@)(@@) 5250 - حديث : كان رسول الله إذا ركع قال : اللهم لك ركعت . . . الحديث ( 6 ) . PageV05P230(@)(@@) تفرد به إبراهيم بن أبي يحيى عن صفوان بن سليم عن عطاء بن يسار .(@)(@@) 5251 - حديث : إذا صلى بالقوم فإن المن فله ولهم . . . الحديث .(@)(@@) غريب من حديث صفوان بن سليم عن عطاء بن يسار ، تفرد به أسامة بن زيد الليثي ( 1 ) ، ولم يروه عنه غير محمد بن عمر الواقدي ( 2 ) .(@)(@@) 5252 - حديثك بينما رجل مستلقي نظر إلى النجوم . . . الحديث ( 3 ) .(@)(@@) تفرد به عبد الله بن جعفر بن نجيح ( 4 ) عن زيد بن أسلم عن عطاء بن يسار .(@)(@@) 5253 - حديث : إذا أقيمت الصلاة . . . الحديث ( 5 ) .(@)(@@) تفرد به عبد الرحمن بن واقد ( 6 ) عن أيوب بن سيار عن صفوان بن سليم عن عطاء بن يسار وقال في موضع آخر تفرد به شيخنا محمد بن أحمد بن أسيد بن الهروي عن أبي حاتم الرازي ( 7 ) عن محمد بن يزيد بن سنان عن معقل بن عبد الله عن عمرو بن دينار عن عطاء بن يسار .(@)(@@) 5254 - حديث : كان من تلبية رسول الله / لبيك . . . الحديث ( 8 ) . PageV05P231(@)(@@) تفرد به مروان بن عبيد عن بشر بن سيرن عن زكريا بن إسحاق ( 1 ) عن عمرو بن دينار عن عطاء بن يسار , .(@)(@@) 5255 - حديث : إذا أفلس الرجل . . . الحديث ( 2 ) .(@)(@@) تفرد به أشعث بن سعيد أبو 
ms605	 الربيع عن عمرو بن دينار عن عطاء بن يسار .(@)(@@) 5256 - حديث : من أتى داره يستجاب له عند الكرب . . . . الحديث .(@)(@@) تفرد به هشام بن سعد عن زيد بن أسلم ( 3 ) عن عطاء بن يسار ، تفرد به عنه حبيب بن أبي حبيب الكاتب ( 4 ) .(@)(@@) 5257 - حديث : من خرج مجاهدا . . . الحديث ( 5 ) .(@)(@@) تفرد به أبو حفص عمرو بن علي الصيرفي عن أبي معاوية عن هلال بن ميمون PageV05P232 الفلسطيني عن عطاء بن يزيد الليثي .(@)(@@) 5258 - حديث : أن رسول الله نهى عن كل ناب من السباع .(@)(@@) تفرد به عطاء بن عجلان عن عطاء بن أبي رباح عن أبي هريرة .(@)(@@) 5259 - حديث : لا تمتلئ جهنم . . . الحديث .(@)(@@) تفرد به أبو مطرف بن أبي الوزير ( 1 ) عن سفيان بن عيينة عن عمرو عن عطاء .(@)(@@) 5260 - حديث : أيما صلاة لا يقرأ فيها بفاتحة الكتاب . . . الحديث ( 2 ) .(@)(@@) تفرد به سوار بن عمارة الرملي ( 3 ) عن ابن عيينة عن ابن أبي نجيح عن عطاء .(@)(@@) 5261 - حديث : لا تسبوا الدهر . . . الحديث ( 4 ) .(@)(@@) تفرد به سفيان بن عيينة عن عمرو بن دينار عنه .(@)(@@) 5262 - حديث : أفطر الحاجم والمحجوم ( 5 ) .(@)(@@) تفرد به أبو حاتم الرازي عن محمد بن عبد الله الأنصاري عن ابن جريج ( 6 ) . PageV05P233 عنه ، والمحفوظ عن داود العطار ( 1 ) عن ابن جريج .(@)(@@) 5263 - حديث : نهى رسول الله عن النظر في النجوم ( 2 ) .(@)(@@) تفرد به عقبة بن عبد الله الرفاعي الأصم ( 3 ) عن عطاء بن أبي رباح .(@)(@@) 5264 - حديث : الجنة مائه درجة . . . الحديث . ( 4 ) .(@)(@@) تفرد به شريك عن محمد بن جحادة وعنه يزيد بن هارون . 5265 - حديث : من بات طاهر . . . الحديث ( 5 ) .(@)(@@) غريب من حديث سليمان الأحول خال ابن أبي نجيح عنه ، تفرد به الحسن بن ذكوان ( 6 ) وعنه عبد الله بن المبارك ( 7 ) . PageV05P234(@)(@@) 5266 - حديث : جعل رسول الله في الصلاة إذنا بالتسبيح للرجال . . . الحديث ( 1 ) . 1 تفرد به علي بن عبد الله العامري عن عبد الكريم بن أبي أمية البصري .(@)(@@) 5267 - حديث : أن النبي توضأ ثلاثا ثلاثا . . . الحديث ( 2 ) .(@)(@@) غريب من حديث 
ms606	 عطاء عنه ، تفرد به عامر بن عبد الواحد الأحول ( 3 ) عنه ، لم يروه عنه غير همام بن يحيى ( 4 ) .(@)(@@) 5268 - حديث : من مات مريضا . . . الحديث ( 5 ) .(@)(@@) غريب / من حديث ابن جريج عن عطاء ، تفرد به سليمان بن هودة عن علي بن مهران عن ابن جريج . PageV05P235(@)(@@) 5269 - حديث : جاء رجل إلى النبي فقال إني لا أحب الموت . . . الحديث .(@)(@@) تفرد به طلحة بن عمرو عن عطاء ، تفرد به سلم بن سليمان .(@)(@@) 5270 - حديث : خمس من الصلاة . . . الحديث ( 1 ) .(@)(@@) تفرد به همام بن مسلم عن ابن جريج ، ولم يروه عنه غير سليمان بن الربيع .(@)(@@) 5271 - حديث : نهى رسول الله عن الشغار ( 2 ) .(@)(@@) تفرد به يزيد بن عياض عن صفوان عن عطاء .(@)(@@) 5272 - حديث : قال رسول الله مثل الغازي في سبيل الله عز وجل . . . الحديث ( 3 ) .(@)(@@) غريب من حديث قتادة عن عطاء بن أبي رباح عنه ، تفرد به الحكم بن عبد الملك عنه ، ولم يروه عنه غير الحسن بن بشر .(@)(@@) 5273 - حديث : رأيت أبا هريرة يكبر في كل خفض ورفع . . . الحديث ( 4 ) .(@)(@@) غريب من حديث شعبة عن عبد الكريم المعلم ( 5 ) ، تفرد به أبو داود الطيالسي ، PageV05P236 ولا أعلم رواه عنه غير عمرو بن علي الفلاس .(@)(@@) عجلان ( 1 ) عن أبي هريرة(@)(@@) 5274 - حديث : رأى رسول الله رجلا ممسكا بيد رجل . . . الحديث .(@)(@@) تفرد به العباس بن محمد بن عمرو بن الحارث الجمحي عن أبي الوليد الطيالسي ( 2 ) عن خالد بن الحارث ( 3 ) عنه .(@)(@@) 5275 - حديث : إذا توضأ أحدكم فلا يشبك بين أصابعه . . . الحديث ( 4 ) .(@)(@@) غريب من حديث عبد الله بن عبد العزيز العمري ( 5 ) العابد وهو قليل الحديث ، تفرد به عتيق بن يعقوب .(@)(@@) 5276 - حديث : إن النبي أمر بوضع الحوائج . . . الحديث .(@)(@@) تفرد به زهير بن محمد ( 6 ) عن محمد بن عجلان عن أبيه .(@)(@@) 5277 - حديث : قال رسول الله : الحسب المال والكرم والتقوى ( 7 ) . PageV05P237(@)(@@) تفرد به معدي بن سليمان ( 1 ) عن ابن عجلان ، غريب عن أبي هريرة .(@)(@@) عراك بن مالك عن أبي هريرة(@)(@@) 5278 - حديث :(@)(@@) غريب من 
ms607	 حديث عثمان بن أبي سليمان بن جبير بن مطعم ( 5 ) عن عراك ، تفرد به سفيان بن عيينة عن عمر / .(@)(@@) 5280 - حديث : إذا أفلس الرجل ( 6 ) . PageV05P238(@)(@@) تفرد به سليمان بن بلال عن خثيم بن عراك عن أبيه ، وتفرد به منصور بن سلمة .(@)(@@) 5281 - حديث : ليس على المسلم في عبده . . . الحديث ( 1 ) .(@)(@@) غريب من حديث سليمان بن فليح عن عبد الله بن دينار عن سليمان بن سيار عن عراك ، تفرد به يحيى بن عثمان بن صفوان السهمي ( 2 ) عن عمرو بن الربيع بن طارق ( 3 ) والنضر بن عبد الجبار المروزي عن سليمان .(@)(@@) عمران بن أبي أنس عن أبي هريرة(@)(@@) 5282 - حديث : قال النبي ابتغوا الخير عند حسان الوجوه ( 4 ) .(@)(@@) تفرد به يزيد بن عبد الملك النوفلي عن عمران .(@)(@@) عمرو بن عثمان عن أبي هريرة(@)(@@) 5283 - حديث : الاستئذان ثلاث . . . الحديث ( 5 ) . PageV05P239(@)(@@) تفرد به دهثم بن قران ( 1 ) عن يحيى بن أبي كثير ( 2 ) عنه ، ولم يروه عنه غير عمر بن عمران الطفاوي .(@)(@@) غالب بن شعوذ ( 3 ) عن أبي هريرة(@)(@@) 5284 - حديث : شيعت أبا هريرة من دمشق إلى الكسرة فقال عند وداعنا إياه . . . الحديث .(@)(@@) تفرد به الوليد بن مسلم عن إسماعيل بن عبد الله العكي عن غالب .(@)(@@) الفضل بن عثمان عن أبي هريرة .(@)(@@) 5285 - حديث : لما خلق الله عز وجل العقل . . . الحديث ( 4 ) .(@)(@@) غريب من حديث الثوري عن الفضل عنه تفرد به سيف بن محمد ( 5 ) عنه ، ولا نعلم حدث به عنه غير الحسن بن عرفة ( 6 ) . PageV05P240(@)(@@) الفرزدق الشاعر واسمه همام بن غالب عن أبي هريرة(@)(@@) 5286 - حديث : نظر أبو هريرة إلى قدمي . . . الحديث ( 1 ) .(@)(@@) وفيه أن بالمغرب بابا . . . الحديث ، تفرد به أشعث ( بن ) ( ) الحمداني ( 2 ) عن الفرزدق ، وتفرد به صلة بن سليمان عن أشعث ، وتفرد به أبو حيدرة حيدون بن عبد الله عن خالد .(@)(@@) القاسم بن محمد عن أبي هريرة(@)(@@) 5286 م - حديث : من تصدق بتمرة أو باللقمة من كسب طيب . . . الحديث ( 3 ) .(@)(@@) تفرد به عبد العزيز بن الحصين ، وتفرد به محمد بن 
ms608	 عبد الله بن يزيد الشيباني الحراني عن أبيه عنه وقال في موضع آخر ، تفرد به علي بن عاصم ( 4 ) عن ابن عون عبد الله عن القاسم ولا أعلم رواه عنه غير حمدون بن عباد البزار ( 5 ) واسمه أحمد ، ورواه عباد بن منصور عن القاسم ، وتفرد به عبد الرحيم بن هارون الكسائي عنه ، ورواه في موضع آخر فقال : غريب من حديث أيوب / الغساني عن القاسم ، تفرد به معمر بن راشد عنه . PageV05P241(@)(@@) 5287 - حديث : إن الله عز وجل هو يقبل الصدقات . . . الحديث ( 1 ) .(@)(@@) تفرد به عدي بن عبد الرحمن عن داود بن أبي هند عن عباد بن منصور ( 2 ) ، وتفرد به الزبيدي عنه ، وتفرد به الربيع بن روح ( 3 ) عن محمد بن حرب عن الزبيدي .(@)(@@) 5288 - حديث : من خرج غازيا . . . الحديث ( 4 ) .(@)(@@) تفرد به حارثة بن عكيم ( ويقال ) ( ) الحارث بن سليمان عن عقبة بن علقمة عن الأوزاعي عن يحيى بن أبي كثير عن القاسم .(@)(@@) 5289 - حديث : جاء جبريل إلى النبي وهو يبكي . . . الحديث .(@)(@@) غريب من حديث القاسم عنه ، تفرد به عباد بن منصور ( 5 ) ، وتفرد به عباد بن صهيب عنه ، وتفرد به الحسن بن كثير عنه .(@)(@@) 5290 - حديث : إن رسول الله كان لا يقنت في صلاة الصبح . . . الحديث ( 6 ) . PageV05P242(@)(@@) غريب من حديث القاسم عنه ، ومن حديث الحكم عنه لم نكتبه إلا من رواية عبد الرحمن المسعودي عن الحكم ، تفرد به محمد بن سليمان بن أبي فاطمة عن أبي عبد الرحمن المقري عن المسعودي .(@)(@@) 5291 - حديث : قال النبي يا أبا هريرة أد الفرائض فإذا أنت أعبد الناس . . . الحديث ( 1 ) .(@)(@@) غريب من حديث القاسم عنه ومن حديث الحكم عنه ، تفرد به محمد بن سليمان عن أبي عبد الرحمن عن المسعودي عنه .(@)(@@) قيس ( 2 ) عن أبي هريرة(@)(@@) 5292 - حديث : إن معاذ بن جبل سأل النبي فقال : يا رسول الله علمني عملا . . . الحديث ( 3 ) .(@)(@@) تفرد به شيخنا محمد بن القاسم بن محمد الأزدي عن علي بن الحسن الأنصاري ( بن ) ( ) زيد أبي أيوب عن يعلى ومحمد ابني 
ms609	 عبيد عن إسماعيل عنه .(@)(@@) قسامة بن زهير ( 4 ) عن أبي هريرة(@)(@@) 5293 - حديث : إن رسول الله قال : إذا حضر المؤمن . . . الحديث .(@)(@@) تفرد به هشام الدستوائي ( 5 ) عن قتادة عنه . PageV05P243(@)(@@) كميل بن زياد ( 1 ) عن أبي هريرة(@)(@@) 5294 - حديث : قال : خرجت مع رسول الله إلى حائط . . . الحديث ( 2 ) .(@)(@@) غريب من حديث جابر بن الحر عن عبد الرحمن بن عائش ( 3 ) عن كميل ، تفرد به عنه أبو أحمد الزبيري ( 4 ) كثير بن عبيد والد أبي العنبس عن أبي هريرة .(@)(@@) 5295 - حديث : أنه صلى على جنازة فكبر أربعا ( 5 ) .(@)(@@) غريب من حديث أبي العنبس سعيد بن كثير بن عبيد ( 6 ) عن أبيه ، تفرد به إبراهيم بن إسماعيل بن بشير بن سلمان عن حفص عنه مرفوعا .(@)(@@) محمد بن سيرين عن أبي هريرة(@)(@@) 5296 - حديث : أتاكم أهل اليمن . . . الحديث ( 7 ) .(@)(@@) تفرد به حصين بن مخارق عن داود بن أبي هند عنه .(@)(@@) 5297 - حديث : إن عيسى ابن مريم نازل . . . الحديث ( 8 ) بمثله . PageV05P244(@)(@@) 5298 - حديث : إلا أدلكم على ما يرفع الله به الدرجات . . . الحديث ( 1 ) بمثله .(@)(@@) 5299 - حديث : من تاب قبل طلوع الشمس . . . الحديث ( 2 ) بمثله .(@)(@@) 5300 - حديث : من كان يؤمن بالله واليوم الآخر ( 3 ) .(@)(@@) تفرد به حصين عن داود وصالح المري ويونس بن عبيد عنه .(@)(@@) 5031 - حديث : لله عز وجل مائة اسم غير اسم . . . الحديث ( 4 ) .(@)(@@) تفرد به حصين عن داود عنه ، ورواه عوف عنه ، وتفرد به حمد بن عبيد عن أبي عبيدة معمر بن المثنى ( 5 ) عن عوف ، وقال في موضع ثالث ، تفرد به عبد العزيز بن الحصين عن أيوب وهشام عنه بطوله ، ولم يروه عنه غير خالد بن مخلد ( 6 ) ، وقال في موضع رابع غريب من حديث مسعر عن عاصم تفرد به أبو اليقظان عبد الرحمن بن عبد الله بن مسلم الحراني عن عمه أبي PageV05P245 قتادة الحراني ( 1 ) عن مسعر ولم نكتبه إلا عن أبي الحسين علي بن الحسن بن أحمد الحراني وكان ضعيفا .(@)(@@) 5302 - حديث : إن في الجنة شجرة . . . الحديث ( 2 ) بمثله .(@)(@@) 5303 
ms610	 - حديث : إن الزمان قد استدار كهيئة يوم خلق الله السموات . . . الحديث .(@)(@@) تفرد به محمد بن معمر عن روح عن أشعث عنه .(@)(@@) 5304 - حديث : الغرق شهادة ( 3 ) .(@)(@@) غريب من حديث أبي عبيدة معمر بن المثنى عن عوف بن أبي جميلة عنه ، تفرد به أحمد بن عبيد عنه .(@)(@@) 5305 - حديث : ما عرض له أمران قط . . . الحديث ( 4 ) .(@)(@@) تفرد به أبو زكريا الطحان سهل بن زياد عن أيوب عنه .(@)(@@) 5306 - حديث : الحياء من الإيمان ( 5 ) . PageV05P246(@)(@@) تفرد به عبد الرحمن بن هارون عن هشام بن حسان عنه .(@)(@@) 5307 - حديث : مرت امرأة من بني إسرائيل بكلب . . . الحديث ( 1 ) .(@)(@@) غريب من حديث المغيرة بن أبي لبيد عنه ، تفرد به محمد بن إسحاق عنه ، وهو غريب عنه .(@)(@@) 5308 - حديث : / أصلي في الثوب الواحد . . . الحديث ( 2 ) .(@)(@@) تفرد به معتمر بن سليمان عن سليمان بن الزيات عنه .(@)(@@) 5309 - حديث : إذا ولغ الكلب . . . الحديث ( 3 ) .(@)(@@) تفرد به أبو جنادة حصين بن مخارق عن داود بن أبي هند ويونس بن عبيد عن ابن سيرين .(@)(@@) 5310 - حديث : سباب المسلم فسوق . . . الحديث ( 3 ) . PageV05P247(@)(@@) تفرد به محمد بن الحسن الأسدي عن أبي هلال عنه .(@)(@@) 5311 - حديث : إن النبي نهى أن يبيع حاضر لباد . . . الحديث ( 1 ) .(@)(@@) تفرد به مردوية محمد بن سعيد الخزاعي عن عبد الأعلى عن هشام بن حسان .(@)(@@) 5312 - حديث : يكون المهدي في أمتي . . . الحديث ( 2 ) .(@)(@@) غريب من حديث هشام عنه ، تفرد به محمد بن مروان العقيلي ، تفرد به عنه أبو يزيد الحربي عمرو بن يزيد .(@)(@@) 5313 - حديث : في قوله عز وجل ( ^ ومن يقتل مؤمنا متعمدا ) ( 3 ) . . . الحديث ( 4 ) .(@)(@@) تفرد به الحجاج بن الأسود عن ابن سيرين ، وتفرد به العلاء بن ميمون عنه . PageV05P248(@)(@@) 5314 - حديث : ابن السبيل أول شارب ( 1 ) .(@)(@@) تفرد به إبراهيم عن هشيم عن عوف عنه ، وغيره يقول عن عوف عن رجل عنه .(@)(@@) 5315 - حديث : من قرأ يس في ليلة غفر له ( 2 ) .(@)(@@) تفرد به محمد بن كثير المصيص عن مخلد عن هشام عنه .(@)(@@) 5316 - حديث : إذا كان الحر فأبردوا بالصلاة 
ms611	 . . . الحديث ( 3 ) .(@)(@@) غريب من حديث قتادة عنه ، تفرد به حماد بن سلمة ( 4 ) عنه ، وعنه الخصيب بن ناصح ( 5 ) .(@)(@@) 5317 - حديث : رأيت كأني أنزع على غنم سود . . . الحديث ( 6 ) . PageV05P249(@)(@@) تفرد به المغيرة بن مسلم عن مطر ، وتفرد به شبابة عنه .(@)(@@) 5318 - حديث : نهى رسول الله عن الاختصار في الصلاة . . . الحديث ( 1 ) .(@)(@@) تفرد به عمرو بن ميمون عن أبي هلال الراسي عنه .(@)(@@) 5319 - حديث : قال رسول الله : لو كان الدين عند الثريا . . . الحديث ( 2 ) .(@)(@@) غريب من حديثه عن أبي هريرة وهو غريب من حديث عوف عنه ، تفرد به يحيى بن الحجاج أبو أيوب الحاقاني ( 3 ) عنه ، وغيره يرويه عن عوف عن شهر بن حوشب .(@)(@@) 5320 - حديث : لو أن الله عز وجل يؤاخذني وعيسى ابن مريم بذنوبنا . . . الحديث .(@)(@@) غريب من حديث محمد عنه ، تفرد به فضيل بن عياض وعنه حسين بن علي الجعفي ( 4 ) .(@)(@@) 5321 - حديث : مع الغلام عقيقة . . . الحديث ( 5 ) .(@)(@@) تفرد به عبد الله بن المختار / عنه عن أبي هريرة ، والمحفوظ عن سلمان بن عامر الضبي ( 6 ) . PageV05P250(@)(@@) 5322 - حديث : وهب المؤمن كفارة لذنوبه .(@)(@@) تفرد به عبد الله بن المختار ( 1 ) عنه ، وتفرد به عنه إسرائيل ( 2 ) .(@)(@@) 5323 - حديث : أوصاني رسول الله بثلاث . . . الحديث ( 3 ) . بمثله سواء .(@)(@@) 5324 - حديث : خصلتان لا يجتمعان في منافق . . . الحديث ( 4 ) .(@)(@@) تفرد به خلف بن أيوب عن عوف الأعرابي عنه .(@)(@@) 5325 - حديث : إن النبي أتته هدية وهو قائم يصلي . . الحديث ( 5 ) .(@)(@@) تفرد به العباس بن الفضل الأنصاري ( 6 ) عن هشام بن حسان عنه .(@)(@@) 5326 - حديث : قال النبي تحت كل شعرة جنابة . . . الحديث ( 7 ) .(@)(@@) غريب من حديث محمد عنه ، تفرد به مالك بن دينار وعنه الحارث بن وجيه . PageV05P251(@)(@@) 5327 - حديث : من ذرعه القيء . . . الحديث ( 1 ) .(@)(@@) تفرد به خالد بن نزار عن القاسم بن مبرور عن عباد بن كثير عن أيوب عنه .(@)(@@) 5328 - حديث : يكون المهدي في أمتي إن قصر فسبع . . . الحديث ( 2 ) .(@)(@@) غريب من حديثه عن أبي هريرة ، وغريب من حديث هشام عنه ، تفرد به محمد بن مروان 
ms612	 العقيلي عنه ، ولا نعلم حدث به غير أبي يزيد الجرمي .(@)(@@) 5329 - حديث : إن النبي نهى عن المجثمة . . . الحديث ( 3 ) .(@)(@@) تفرد به حمدان بن عمر السمسار عن شبابة عن معمر بن مطر .(@)(@@) 5330 - حديث : إن الملائكة تلعن أحدكم إذا أشار إلى أخيه بحديدة ( 4 ) . PageV05P252(@)(@@) تفرد به إسحاق بن زيد الرازي عن مغيرة بن مسلم عن مطر عنه ، وقال في موضع آخر قال ابن صاعد لم يسمع هذا إلا من أبي عبيد الله المخزومي ( 1 ) عن سفيان عن أيوب عنه .(@)(@@) 5331 - حديث : تسموا باسمي . . . الحديث ( 2 ) .(@)(@@) غريب من حديث موسى بن عبيدة عن هشام عنه ، تفرد به بهلول بن مورق عنه .(@)(@@) 5332 - حديث : من رآني في المنام . . . الحديث ( 3 ) .(@)(@@) غريب من حديث أيوب ومن حديث الخليل بن مرة عنه تفرد به الحسن بن عتبة عن الحسن عن ابن الخليل عن أبيه .(@)(@@) 5333 - حديث : احتاج رجل من الأنصار فقالت له امرأته . . . الحديث .(@)(@@) تفرد به عبد الرحيم بن هارون الغساني عن هشام عنه .(@)(@@) 5334 - حديث : صلى رسول الله إحدى صلاتي العشى . . . الحديث ( 4 ) . PageV05P253(@)(@@) تفرد به يزيد بن هارون عن سفيان بن حسين عنه .(@)(@@) 5335 - / حديث : عائد المريض يخوض من رحمة الله . . . الحديث ( 1 ) .(@)(@@) تفرد به أحمد بن الحسن البصري وكان ضعيفا عن أبي عاصم عن المفضل بن لاحق عن ابن سيرين .(@)(@@) 5336 - حديث : في قوله عز وجل ( ^ ومن يقتل مؤمنا ) ( 2 ) . . . الحديث ( 3 ) .(@)(@@) تفرد به الحجاج الأسود عنه ، وتفرد به العلاء بن ميمون عنه ، وتفرد به محمد بن جامع القطان عنه .(@)(@@) 5337 - حديث : اتقوا النار لو بشق تمرة ( 4 ) .(@)(@@) غريب من حديث عبد الله بن عون ( 5 ) عنه ، تفرد به حماد بن سلمة عنه ، ولم PageV05P254 يروه غير أحمد بن الأمي عن عبد الملك بن يزيد عنه .(@)(@@) 5338 - حديث : إذا اشتد الحر . . . الحديث ( 1 ) .(@)(@@) تفرد به عبد الله بن الحسين بن عطاء بن سيار عن صفوان بن سليم عن حجاج بن المنذر عن محمد .(@)(@@) 5339 - حديث : إن أمرأة أتت النبي ومعها ابن لها . . . الحديث ( 2 
ms613	 ) .(@)(@@) في الدعاء ، تفرد به أبو عبيدة الناجي سعيد بن زربي ( 3 ) عنه .(@)(@@) 5340 - حديث : الحسنة بعشر أمثالها . . . الحديث ( 4 ) .(@)(@@) تفرد به القاسم بن إسحاق بن الصلت الكندي عن مالك بن دينار ( 5 ) عن أيوب السختياني ، ولم نكتبه إلا عن شيخنا أبي علي الكوكبي .(@)(@@) 5341 - حديث : سئل رسول الله أي الناس خير . . . الحديث بمثله .(@)(@@) وفيه قال القاسم كانت محبوبة لا تتكلم إلا يوم الأربعاء ، تفرد به القاسم بهذا الإسناد وهما غريبان من حديث أيوب ومن حديث مالك بن دينار .(@)(@@) 5342 - حديث : سبق العلم وجف القلم وقضى القضاء . . . الحديث ( 6 ) . PageV05P255(@)(@@) غريب من حديث ابن عون عنه ، تفرد به الهيثم بن سهل عن عبد الحميد الحماني عنه .(@)(@@) 5343 - حديث : إن النبي ما عرض له أمران ( 1 ) .(@)(@@) تفرد به أبو زياد سهل بن زياد عن أيوب .(@)(@@) 5344 - حديث : ادعو الله عز وجل وأنتم موقنون بالإجابة . . . الحديث ( 2 ) .(@)(@@) تفرد به صالح بن بشير المري عن هشام بن حسان عنه .(@)(@@) 5345 - حديث : إن النبي قال في قصة ذي اليدين ( 3 ) .(@)(@@) غريب من حديث يحيى بن عتيق عن محمد ، تفرد به حماد بن زيد عن يحيى ، ورواه حماد بن زيد عن جماعة فيهم يحيى وقال في موضع آخر غريب من حديث عبد الله بن محمد بن سيرين عن أبيه وتفرد به / سعيد بن عبد الرحمن الجمحي عنه ولا نعلم حدث به عنه غير عبد الله بن وهب .(@)(@@) 5346 - حديث : أما يخثى الذي يرفع رأسه قبل الإمام . . . الحديث ( 4 ) .(@)(@@) تفرد به حفص عن إبارهيم بن طمهمان ( 5 ) عن أيوب عنه قال المقدسي : PageV05P256 والمحفوظ من حديث محمد بن زياد ولكن كذا كان يعني ( لهم ) ( ) .(@)(@@) 5347 - حديث : المضمضة والاستنشاق ثلاثا للجنب فريضة ( 1 ) .(@)(@@) هكذا حدث به غير محمد بن مهران السواق شيخنا ، من أصله ، وهو غريب من حديث الثوري ، عن خالد ، وأنما يعرف هذا من رواية بركة بن محمد عن يوسف بن أسباط عن الثوري ، وهذا غريب من رواية همام بن مسلم ، تفرد به سليمان بن الربيع عنه .(@)(@@) 5348 - حديث 
ms614	 : احتج آدم وموسى . . . الحديث ( 2 ) .(@)(@@) غريب من حديث سعيد بن عبد الرحمن أخي أبي حرة عنه ، تفرد به أبو علي الحنفي عبد الله بن عبد المجيد عنه .(@)(@@) 5349 - حديث : قال الله عز وجل : أهل شغل الله عز وجل في الدنيا . . . الحديث .(@)(@@) غريب من حديث ابن عون ( 3 ) عن ابن سيرين ( 4 ) عنه ، لم نكتبه إلا عن شيخنا يعني محمد بن القاسم الأزدي .(@)(@@) 5350 - حديث : أختصمت الجنة والنار . . . الحديث ( 5 ) . PageV05P257(@)(@@) غريب من حديث صالح بن مسمار وكان من العباد عن ابن سيرين ، تفرد به جعفر بن برقان عنه ، وتفرد به أبو سعيد هشام بن منصور بن شبيب المخامري عن كثير بن هشام عن جعفر .(@)(@@) 5351 - حديث : إن لله عز وجل ملائكة في السماء أعرف ببني آدم . . . الحديث ( 1 ) .(@)(@@) غريب من حديثه عن أبي هريرة ، تفرد به منصور بن زاذان عنه ، وتفرد به زيد بن الحواري عن منصور ولم يروه عنه غير سلام الطويل المدائني .(@)(@@) 5352 - حديث : الندم توبة ( 2 ) .(@)(@@) تفرد به مورق بن ( كس ) ( ) عن أبي هلال الراسبي ( 3 ) عن ابن سيرين .(@)(@@) 5353 - حديث : بينما كلب يطوف على رأس ركبه . . . الحديث .(@)(@@) تفرد به ابن وهب عن جرير بن حازم ( 4 ) ، تفرد به جرير عن أيوب عنه .(@)(@@) 5354 - حديث : تعوذوا بالله من وجب الحزن . . . الحديث ( 5 ) . PageV05P258(@)(@@) غريب من حديث سليمان التيمي عنه ، تفرد به جعفر بن علي الجريري عن محمد بن الفضل عن التيمي .(@)(@@) 5355 - حديث : أوصاني خليلي بثلاث . . . الحديث ( 1 ) .(@)(@@) تفرد به أبو عمر المازني حفص بن عمر عن يحيى بن دينار عنه / وقال في موضع آخر تفرد به سعيد بن محمد بن أيوب عن سهل عن هشام بن حسان عنه .(@)(@@) 5356 - حديث : لا يبيع حاضر لباد ( 2 ) .(@)(@@) تفرد به يحيى بن دينار عن ابن سيرين ، ولم يروه عنه غير حفص بن عمر أبو عمر المازني .(@)(@@) 5357 - حديث : سمع النبي يقول : نعى شاهانشاه . . . الحديث ( 3 ) . من غريب من حديث محمد عنه ، تفرد به عاصم بن سليمان الأحول عنه ، وتفرد به أبو 
ms615	 مالك النخعي عبد بالملك بن حسين عنه .(@)(@@) 5358 - حديث : إن الله عز وجل من على قوم فألمهمهم فأدخلهم الجنة . . . الحديث ( 4 ) . PageV05P259(@)(@@) غريب من حديث يونس بن عبيد عنه ، تفرد به أبو عمر الضرير حفص بن عمر بهذا الإسناد .(@)(@@) 5359 - حديث : إن رسول الله حين سلم في ركعتين . . . الحديث ( 1 ) .(@)(@@) تفرد به علي بن عبد الله الرازي عن عبد الكريم عن ابن سيرين عنه وعن عمران بن حصين ( 2 ) بهذه الألفاظ .(@)(@@) 5360 - حديث : لا يمنعن أحدكم جاره . . . الحديث ( 3 ) .(@)(@@) غريب من حديث أيوب عنه ، تفرد به محمد بن عيسى بن الطباع عن حماد بن زيد عن أيوب .(@)(@@) 5361 - حديث : عن رسول الله قال : في الركاز الخمس ( 4 ) .(@)(@@) تفرد به هشيم عن منصور بن زاذان عنه .(@)(@@) محمد بن زياد عن أبي هريرة(@)(@@) 5362 - حديث : الولد للفراش . . . الحديث ( 5 ) . PageV05P260(@)(@@) تفرد به عبد الله بن محمد بن سنان عن محمد بن سنان عن سلميان عنه .(@)(@@) 5363 - حديث : يخرجن من المدينة رجال رغبة عنها . . . الحديث ( 1 ) .(@)(@@) غريب من حديث منصور بن سعد عن محمد بن زياد وعمار بن أبي عمار ، تفرد به أبو ربيعة فهد بن عوف عنه ، ولم يروه عنه غير عبد الله بن محمد بن سنان .(@)(@@) 5364 - حديث : إن رجلا أعتق ستة مماليك . . . الحديث ( 2 ) .(@)(@@) تفرد به عبد الله بن المختار عنه ، وتفرد به عنه إسرائيل .(@)(@@) 5365 - حديث : تسحروا فإن في السحور بركة . . . الحديث ( 3 ) .(@)(@@) تفرد به أسيد بن عمرو عن عمرو بن حكام عن شعبة عنه .(@)(@@) 5366 - حديث : الدابة جرحها جبار . . . الحديث ( 4 ) .(@)(@@) تفرد به آدم بن أبي إياس ( 5 ) عن شعبة عنه بقوله ( ( الرجل جبار ) ) .(@)(@@) 5367 - حديث : خيركم إسلاما أحاسنكم أخلاقا ( 6 ) . PageV05P261(@)(@@) غريب من حديث محمد بن زياد عنه ، وغريب من حديث حماد بن زيد عنه ، تفرد به أسد بن موسى عنه .(@)(@@) 5368 - حديث : من سئل من علم . . . الحديث ( 1 ) .(@)(@@) غريب من حديث / محمد عنه ، تفرد به محمد بن أحمد بن المثنى عن يحيى بن إسحاق ، وأنما يعرف هذا من حديث 
ms616	 علي بن الحكم عن عطاء بن أبي رباح عن أبي هريرة .(@)(@@) 5369 - حديث : ليس السائل بهذا الطواف . . . الحديث .(@)(@@) غريب من حديث الحارث بن محمد بن زياد عن أبيه ، تفرد به القاسم بن يحيى الضرير القرشي عنه .(@)(@@) 5370 - حديث : أما يخشى أحدكم ( 2 ) .(@)(@@) بألفاظ مختلفة أورده في مواضع ، قال : تفرد به سعيد بن أبي عروبة ( 3 ) عن علي بن ثابت الأنصاري أخي عذرة ( 4 ) عن محمد بن زياد ، ورواه عبد الوهاب بن محمد بن سهل صاحب الساج عن محمد بن زياد ، وتفرد به عبد الوهاب بن عطاء ( 5 ) عن محمد بن فروخ أبي سهل الساجي البصري هذا ، وقال : تفرد به أبو PageV05P262 ربيعة عن منصور ، ورواه علي بن الربيع بن الركين عن أبيه عن الربيع بن بدر الكندي عن محمد بن زياد ، وتفرد به محمد بن يوسف بن محمد بن سوقة عن علي بن الربيع ، ورواه موسى بن سيار الأهوازي عن محمد بن زياد وتفرد به عنه عمرو بن فايد ورواه عبد الوارث بن سعيد ( 1 ) عن عبد العزيز بن صهيب عن محمد بن زياد ، وتفرد به وهب بن محمد البناني عنه ، وقال : تفرد به إسرائيل عن عبد الله بن المختار عن محمد بن زياد ، وقال : تفرد به عبد الله بن محمد بن سنان عن محمد بن سنان عن سليم بن حيان عن محمد بن زياد .(@)(@@) محمد بن قيس بن مخرمة عن أبي هريرة بالشك(@)(@@) 5371 - حديث : لما نزلت ( ^ من يعمل سوءا ) . . . الحديث ( 2 ) .(@)(@@) تفرد به سفيان بن عيينة عن ابن محيصن قارئ أهل مكة .(@)(@@) محمد بن ثابت عن أبي هريرة(@)(@@) 5372 - حديث : كان رسول الله يدعوا : اللهم انفعنا بما علمتنا . . . الحديث ( 3 ) .(@)(@@) 5373 - حديث : إذا قال الرجل لأخيه جزاك الله خيرا ( 4 ) . PageV05P263(@)(@@) 5374 - وحديث : صلوا على أنبياء الله ورسله . . . الحديث ( 1 ) .(@)(@@) تفرد بهذه الأحاديث موسى بن عبيدة عن محمد بن ثابت .(@)(@@) محمد بن عبد الله بن المطلب ( 2 ) عنه(@)(@@) 5375 - حديث : دخلت على رقية وفي يدها مشط . . . الحديث .(@)(@@) غريب من حديث 
ms617	 زيد بن أبي أنيسة عنه ، تفرد به عنه أبو عبد الرحمن خالد بن يزيد ، ولم يروه عنه غير محمد بن سلمة وفي متنه نظر ولست أدري الوهم فيه على من أدخل لأن أبا هريرة أسلم زمن خيبر ورقية بنت رسول الله توفيت عام بدر ، والله أعلم .(@)(@@) موسى بن طلحة عن أبي هريرة(@)(@@) 5376 - حديث : أصدق كلمة قالها شاعر كلمة لبيد ( 3 ) .(@)(@@) غريب من حديث عبد الملك بن عمير عنه ، تفرد به أبو أسامة عن زائدة عنه ، ومشهور عن عبد الملك عن أبي سلمة عن أبي هريرة .(@)(@@) موسى بن يسار ( 4 ) عنه(@)(@@) 5377 - حديث : لا تحاسدوا . . . الحديث .(@)(@@) تفرد به جناجة بن سلم عن عبيد الله بن عمر عن موسى عنه .(@)(@@) موسى بن وردان عنه(@)(@@) 5378 - حديث : تهادوا تحابوا . . . الحديث ( 5 ) . PageV05P264(@)(@@) تفرد به عمار بن إسماعيل ختن أبي قبيل عن موسى بن وردان عنه .(@)(@@) 5379 - حديث : إن النبي قال : يا بني هاشم يا بني قصي . . . الحديث ( 1 ) .(@)(@@) تفرد به همام بن إسماعيل عن موسى بن وردان ( 2 ) .(@)(@@) مجاهد عن أبي هريرة(@)(@@) 5380 - حديث : ما عمل أحب إلى الله عز وجل من عمل في العشر . . . الحديث ( 3 ) .(@)(@@) تفرد به أبو كريب عن أبي مصعب بدر بن مصعب الحراني عن عمر بن ذر عن مجاهد .(@)(@@) 5381 - حديث : توجد رائحة الجنة . . . الحديث .(@)(@@) غريب من حديث هارون عنه عن أبي هريرة تفرد به علقمة بن مرثد ( 4 ) عنه .(@)(@@) 5382 - حديث : أوصاني خليلي بثلاث . . . الحديث ( 5 ) . PageV05P265(@)(@@) تفرد به أبو ركين يحيى بن محمد بن قيس عن ليث عن مجاهد بهذه الألفاظ .(@)(@@) 5383 - حديث : المراء في القرآن كفر ( 1 ) .(@)(@@) تفرد به الحارث بن سليمان عن عقبة بن علقمة عن الأوزاعي عن ليث عنه .(@)(@@) 5384 - حديث : إن النبي نهى عن الدباء . . . الحديث ( 2 ) .(@)(@@) تفرد به شيخنا أبو بكر محمد بن صالح بن خلف الحواري عن أبي الأشعث العجلي ( 3 ) عن محمد بن بكر ( 4 ) عن شعبة عن أبي إسحاق عنه مرفوعا ورواه شيخنا أبو عبيد القاسم بن إسماعيل وأحمد 
ms618	 بن علي بن العلاء عن أبي الأشعث العجلي عن ابن أبي عروبة أنه نهى موقوفا ورفعه زهير وعمار بن زريق ( 5 ) عن أبي إسحاق .(@)(@@) 5385 - حديث : استقيموا ولن تحصوا . . . الحديث ( 6 ) . PageV05P266(@)(@@) تفرد به أبو أيوب التمار يحيى بن ميمون عن عطاء عن ليث عنه .(@)(@@) 5386 - حديث : خللوا أصابعكم . . . الحديث ( 1 ) بمثله .(@)(@@) 5387 - / حديث : إذا أحب الله عز وجل عبد . . . الحديث ( 2 ) .(@)(@@) وفيه ذكر عائشة ، غريب من حديثه عن أبي هريرة وعائشة ، تفرد به عطاء بن السائب عنه ، ولا أعلم حدث به عنه غير محمد بن فضيل .(@)(@@) 5388 - حديث : إن رسول الله قضى في جنين امرأة من بني لحيان . . . الحديث ( 3 ) .(@)(@@) تفرد به في ترجمة سعيد .(@)(@@) 5389 - حديث : إن مرض المؤمن كفارة . . . الحديث .(@)(@@) تفرد به يحيى بن ميمون بن عطاء ( 4 ) أبو أيوب عن ليث ( 5 ) عنه . PageV05P267(@)(@@) 5390 - حديث : لا تلقوا الركبان . . . الحديث ( 1 ) .(@)(@@) تفرد به محمد بن مسلم الطائفي ( 2 ) عن ابن أبي نجيح وتفرد به عمران بن أبان الواسطي ( 3 ) .(@)(@@) 5391 - حديث : سمعت رسول الله يقول : دينار تنفقه على نفسك . . . الحديث ( 4 ) .(@)(@@) غريب من حديث التيمي سليمان ( 5 ) عن مجاهد ، تفرد به يحيى بن كثير أبو النضر ( 6 ) عنه .(@)(@@) مهاجر بن علقمة عن أبي هريرة(@)(@@) 5392 - حديث : لا تنكح البكر حتى تستأمر . . . الحديث ( 7 ) .(@)(@@) تفرد به أبو حنيفة ( 8 ) عن شيبان ( 9 ) عن يحيى بن أبي كثير عن مهاجر عنه . PageV05P268 وغيره يرويه مرسلا ، ورواه سابق الرقي عن محمد بن خالد الرقي عن أبي حنيفة .(@)(@@) المحرر بن أبي هريرة عن أبيه(@)(@@) 5393 - حديث : كنت في البعث الذين بعثهم رسول الله مع علي بن أبي طالب ببراءة . . . الحديث ( 1 ) .(@)(@@) غريب من حديث سليمان الشيباني عن الشعبي عنه ، وغريب من حديث شعبة عنه ، تفرد به حميد بن زنجويه ( 2 ) عن النضر بن شميل ( 3 ) عنه ، والمحفوظ عن المغيرة عن الشعبي وقال حميد بن زنجويه : ليس عندي عن النضر عن شعبة عن مغيرة وغيره ورواه قيس بن الربيع عن الشيباني ، وتفرد به عفان 
ms619	 عن قيس وقال في موضع آخر غريب من حديث إبراهيم بن المهاجر بن جابر الأحمس ( 4 ) عن المحرر عن أبيه ، تفرد به خارجة بن مصعب ( 5 ) عنه ، وتفرد به صالح بن بيان عن خارجة .(@)(@@) 5394 - حديث ما اهل مهل قط . . . الحديث ( 6 ) . PageV05P269(@)(@@) تفرد به محمد بن المنكدر عن محرر عن أبيه ، وتفرد به ياسين الزيات عنه ، وحدث به محمد بن أبان البلخي عن عبد الرزاق عن الثوري عن ابن المنكدر ( نظر ) ( ) فيه والصواب ياسين(@)(@@) مسلم بن شهاب الزهري / عن أبي هريرة(@)(@@) 5395 - حديث : لو ينبغي لأحد أن يسجد لأحد . . . الحديث ( 1 ) .(@)(@@) غريب من حديث الزهري عن أبيه عن أبي هريرة ، تفرد به نعيم بن حماد عن رشدين عن عقيل عنه .(@)(@@) مالك عن أبي هريرة(@)(@@) 5396 - حديث : آية المنافق ثلاث . . . الحديث ( 2 ) .(@)(@@) تفرد به محمد بن طلحة التيمي عن أبي سهيل نافع بن مالك عن أبيه عن أبي هريرة .(@)(@@) مطر القرشي عن أبي هريرة(@)(@@) 5397 - حديث : أوصاني خليلي بثلاث . . . الحديث ( 3 ) .(@)(@@) تفرد به بقية عن مسلم بن زياد عن مطر القرشي عنه .(@)(@@) مكحول عنه(@)(@@) 5398 - حديث : نور الحكمة الجوع . . . الحديث ( 4 ) . PageV05P270(@)(@@) غريب من حديث مكحول الدمشقي عن أبي هريرة ما كتبته إلا عن أبي بكر بن أبي شيبة عن عبيدة بن عبيد أبي المضاء عن يحيى بن حسان عن صالح بن عبد الكريم مكحول .(@)(@@) 5399 - حديث : من طلب الدنيا حلالا . . . الحديث ( 1 ) .(@)(@@) غريب من حديثه عن أبي هريرة ، وغريب من حديث حجاج بن فرافصة عنه ، تفرد به الثوري عنه .(@)(@@) المليح بن عبد الله عن أبي هريرة(@)(@@) 5400 - حديث : إن الذي يسجد قبل الإمام ( 2 ) ويرفع قبله . . . الحديث .(@)(@@) تفرد به بكر بن صدقة عن محمد بن عجلان عن محمد بن عمرو بن علقمة ( 3 ) عن أبي المليح عنه . .(@)(@@) نافع مولى ابن عمر ( 4 ) عن أبي هريرة(@)(@@) 5401 - حديث : صلاة في مسجدي هذا . . . الحديث ( 5 ) .(@)(@@) تفرد به يعقوب بن عبد الرحمن عن موسى بن عقبة عن نافع ، وتفرد به حسان بن غالب عنه 
ms620	 .(@)(@@) 5402 - حديث : إذا أحب الله عبدا . . . الحديث ( 6 ) .(@)(@@) تفرد به ابن جريج ( 7 ) عن موسى بن عقبة عن نافع . PageV05P271(@)(@@) نافع بن أبي نافع ( 1 ) عن أبي هريرة(@)(@@) 5403 - حديث : لا سبق إلا في خف . . . الحديث ( 2 ) .(@)(@@) غريب من حديث محمد بن عمرو عن نافع ، تفرد به الثوري عنه ، وتفرد به مصعب بن ماهان ( 3 ) عن الثوري .(@)(@@) نعيم بن عبد الله المجمر ( 4 )(@)(@@) 5404 - حديث : سألت النبي كيف نصلي عليك . . . الحديث ( 5 ) .(@)(@@) تفرد به عمرو بن الحصين عن مسلمة بن علقمة عن داود بن أبي هند عنه .(@)(@@) 5405 - حديث : أنتم الغر المحجلون من أثر الوضوء . . . الحديث ( 6 ) .(@)(@@) غريب من حديث عمارة بن غزية عن نعيم تفرد به سليمان بن بلال عنه .(@)(@@) الوليد بن رباح ( 7 ) عنه(@)(@@) 5406 - حديث : / لا يقبل الله صلاة بغير طهور . . . الحديث ( 8 ) . PageV05P272(@)(@@) غريب من حديثه عنه ، تفرد به أبو بشر عنه . 5407 - حديث : إن الله عز وجل حرم مكة ( 1 ) مثله .(@)(@@) همام بن منبه عن أبي هريرة(@)(@@) 5408 - حديث : إن النبي حبس في تهمة . . . الحديث ( 2 ) .(@)(@@) تفرد به محمد بن الحسن عن الخضر بن أبي فاطمة عن وهب بن نافع عن كادح بن رحمة عن مسعر عن محمد بن جحادة عن همام .(@)(@@) هزيل عنه(@)(@@) 5409 - حديث : الرجل جبار . . . الحديث ( 3 ) .(@)(@@) غريب من حديث هزيل بن شرحبيل ( 4 ) عنه ، لم يروه غنه غير أبي قيس عبد الرحمن بن ثروان ( 5 ) ، تفرد به زياد بن عبد الله البكائي ( 6 ) عن الأعمش واختلف على أبي قيس في إسناد هذا الحديث ، رواه محمد بن طلحة ( 7 ) عنه عن هزيل عن عبد الله PageV05P273 قال أظنه مرفوعا وهذا أيضا غريب من حديث هزيل عن عبد الله ، تفرد به محمد بن طلحة عنه ورواه الثوري عنه عن هزيل فأرسله وهو أصح من قول من وصله .(@)(@@) هلال ( 1 ) عن أبي هريرة(@)(@@) 5410 - حديث : قال : كان النبي إذا دخل بيته قمنا حتى يدخل .(@)(@@) تفرد به محمد بن هلال ( 2 ) عن أبيه عن أبي هريرة .(@)(@@) يحيى بن 