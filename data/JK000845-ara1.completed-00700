ms681	 اخبار ذى القرنين .(@)(@@)(@@)(@@) $ كتاب النوادر(@)(@@) لابى جعفر محمد بن أحمد الكوفى ص كتاب الطب .(@)(@@)(@@)(@@) $ كتاب النوادر(@)(@@) لابن الحر الكوفى عبد الله بن جبلة ص كتاب الرجال .(@)(@@)(@@)(@@) $ كتاب النوادر فى الحديث(@)(@@) لابى حمزة ثابت ابن دينار الثمالى الكوفى الشيعى المتوفى سنة 150 خمسين ومائة .(@)(@@)(@@)(@@) $ كتاب النوادر الصغير(@)(@@) لابى عبد الرحمن يونس ابن حبيب النحوى .(@)(@@)(@@)(@@) $ كتاب النوادر الكبير(@)(@@) لابى عمرو إسحاق ابن مرار الشيبانى .(@)(@@)(@@)(@@) $ كتاب نوادر قتيبة بن مسلم(@)(@@) لابن المدينى على ابن عبد الله ص الاخبار .(@)(@@)(@@)(@@) $ كتاب النوادر(@)(@@) لابى جعفر القمى محمد بن على ص كتاب البواب .(@)(@@)(@@)(@@) $ كتاب النوادر والشوارد(@)(@@) للحافظ حسن ابن عبد الرحمن الرامهرمزى ص ادب الموائد .(@)(@@)(@@)(@@) $ كتاب النوازل والاحكام(@)(@@) لابى محمد عبد العزيز ابن ابى الطيب الحسن بن يوسف الزياتى الفاسى المالكى المتوفى سنة 1055 خمس وخمسين والف .(@)(@@)(@@)(@@) $ كتاب النواهى(@)(@@) لابن بابويه القمى محمد بن أحمد ص الامالى .(@)(@@)(@@)(@@) $ كتاب النورانية(@)(@@) تأليف . . . . شرحه حاجى بابا ابن إبراهيم بن عثمان الرومى المتوفى سنة . . . سماه السلطانية .(@)(@@)(@@)(@@) $ كتاب النهاية فى خمسمائة من آيات القرآن التى فيها مدار الفقه(@)(@@) لابن المتوج أحمد بن عبد الله بن على الشيعى المتوفى سنة 810 عشر وثمانمائة .(@)(@@)(@@)(@@) $ كتاب النهر(@)(@@) لابى إسحاق إبراهيم الثقفى الشيعى ص اخبار المختار . PageV02P347(@)(@@)(@@)(@@) $ كتاب النهر(@)(@@) لابى عبد الله الغلابى محمد بن زكريا ص كتاب الاجواد .(@)(@@)(@@)(@@) $ كتاب النهروان(@)(@@) لابى عبد الله الجعفى جابر ص التفسير .(@)(@@)(@@)(@@) $ كتاب النهروان(@)(@@) لابن المدينى على بن عبد الله ص الاخبار .(@)(@@)(@@)(@@) $ كتاب الواحد والجمع(@)(@@) لابى زيد سعيد بن اوس الخزرجى ص بيوتات العرب .(@)(@@)(@@)(@@) $ كتاب الواحدة(@)(@@) فى الاخبار والمناقب والمثالب فى ثمانية اجزاء تأليف محمد بن الحسين بن جمهور البصرى الشيعى المتوفى سنة 210 عشر ومائتين .(@)(@@)(@@)(@@) $ كتاب الواسطة(@)(@@) لابى جعفر محمد بن على الطوسى الشيعى ص كتاب الشرائع .(@)(@@)(@@)(@@) $ كتاب الواضح(@)(@@) فى النحو لابى بكر محمد بن قاسم الانبارى ص الفات القطع .(@)(@@)(@@)(@@) $ كتاب الوافدين(@)(@@) لابى عبد الله الغلابى محمد بن زكريا ص كتاب الاجواد .(@)(@@)(@@)(@@) $ كتاب الوثائق(@)(@@) لابى عبد الله محمد الباجى ص كتاب السجلات .(@)(@@)(@@)(@@) $ كتاب الوجود والحق والخطاب الصدق(@)(@@) للشيخ عبد الغنى 
ms682	 النابلسى ص ابانة النص .(@)(@@)(@@)(@@) $ كتاب الوجود الحق والمقيد والمطلق(@)(@@) للشيخ أحمد بن زين الدين الاحسائى الشيعى ص بيان حجة الاجماع .(@)(@@)(@@)(@@) $ كتاب الوحش(@)(@@) لابى على هشام بن إبراهيم الكوفى الكرمانى .(@)(@@)(@@)(@@) $ كتاب الوحوش(@)(@@) لابن السكيت يعقوب بن إسحاق ص كتاب الابل .(@)(@@)(@@)(@@) $ كتاب الوحوش(@)(@@) لابى عثمان سعدان بن المبارك الضرير .(@)(@@)(@@)(@@) $ كتاب الوحوش(@)(@@) لابى محمد ثابت بن ابى ثابت سعيد الكوفى . PageV02P348(@)(@@)(@@)(@@) $ كتاب الود والالفة(@)(@@) لابن خفيف الشيرازى محمد ص آداب المريدين .(@)(@@)(@@)(@@) $ كتاب الوزارة ومقامة السياسة(@)(@@) للوزير لسان الدين محمد بن عبد الله المعروف بابن الخطيب ص استنزال اللطف الموجود .(@)(@@)(@@)(@@) $ كتاب الوسيلة(@)(@@) لابى جعفر محمد الطوسى المذكور ايضا .(@)(@@)(@@)(@@) $ كتاب الوشى(@)(@@) للمبرد ابى العباس محمد بن يزيد ص ادب الجليس .(@)(@@)(@@)(@@) $ كتاب الوصايا(@)(@@) لابن يقطين محمد بن عيسى ص بعد الاسناد .(@)(@@)(@@)(@@) $ كتاب الوصايا(@)(@@) لابى سعيد أحمد بن محمد بن زياد ابن الاعرابى ص الجمع والتفريق .(@)(@@)(@@)(@@) $ كتاب الوصول إلى معرفة الاصول(@)(@@) لابى عبد الله أحمد بن محمد الطبرى ص كتاب الكشف .(@)(@@)(@@)(@@) $ كتاب الوصية(@)(@@) لهشام بن الحكم ص اختلاف الناس .(@)(@@)(@@)(@@) $ كتاب الوضوء والصلاة وغيره من الفقه(@)(@@) للدورقى ص التفسير .(@)(@@)(@@)(@@) $ كتاب الوضوء والصلاة وغيرها من الفقه(@)(@@) لسعد بن إبراهيم القمى ص احتجاج الشيعة .(@)(@@)(@@)(@@) $ كتاب الوضوء والصلاة(@)(@@) لابن فضال على بن حسن الكوفى ص التفسير .(@)(@@)(@@)(@@) $ كتاب الوعيد(@)(@@) للسيد مرتضى الموسوى الشيعى الشريف ص الآيات الباهرة .(@)(@@)(@@)(@@) $ كتاب الوفاة(@)(@@) لابى موسى المستعطف عيسى ص الفرق بين الآل .(@)(@@)(@@)(@@) $ كتاب الوفود(@)(@@) لابن المدينى على بن عبد الله ص الاخبار .(@)(@@)(@@)(@@) $ كتاب الوقف والابتداء(@)(@@) لابى زكريا يحيى بن زياد الفراء ص آلة الكتاب . PageV02P349(@)(@@)(@@)(@@) $ كتاب الوقف(@)(@@) لابن ابى حاتم محمد القزوينى الشيعى ص البيان والايضاح .(@)(@@)(@@)(@@) $ كتاب الوقوف(@)(@@) لابى بكر أحمد بن كامل المتوفى سنة 350 خمسين وثلاثمائة .(@)(@@)(@@)(@@) $ كتاب الولائم(@)(@@) لابن المدينى المذكور .(@)(@@)(@@)(@@) $ كتاب الولاية(@)(@@) له ايضا .(@)(@@)(@@)(@@) $ كتاب الولاية(@)(@@) لابن عقدة الكوفى أحمد بن محمد ص اخبار ابى حنيفة .(@)(@@)(@@)(@@) $ كتاب الهاآت(@)(@@) لابن مجاهد أحمد بن موسى البغدادى المقرى .(@)(@@)(@@)(@@) $ كتاب الهاآت(@)(@@) لابى طاهر عبد الواحد بن عمر ابن محمد بن هاشم البزار البغدادى المتوفى سنة 349 تسع واربعين وثلاثمائة .(@)(@@)(@@)(@@) $ كتاب 
ms683	 الهاآت المكنى فى القرآن(@)(@@) لابى الحسن على بن حمزة الكسائى ص اختلاف العدد .(@)(@@)(@@)(@@) $ كتاب الهجاء(@)(@@) لابى بكر محمد بن قاسم الانبارى ص لفات القطع والوصل .(@)(@@)(@@)(@@) $ كتاب الهجاء(@)(@@) لابى الحسن الكسائى ايضا .(@)(@@)(@@)(@@) $ كتاب الهجاء(@)(@@) لابى حاتم سهل بن محمد السجستانى ص كتاب الاتباع .(@)(@@)(@@)(@@) $ كتاب الهجاء(@)(@@) لابى الحسن على بن عيسى الرمانى ص الايجاز .(@)(@@)(@@)(@@) $ كتاب هجاء حسان لقريش(@)(@@) لابن المدينى على ابن عبد الله ص الاخبار .(@)(@@)(@@)(@@) $ كتاب الهدايا(@)(@@) لابى عبد الله محمد بن خلف ابن المرزبان ص اخبار ابى قبيس .(@)(@@)(@@)(@@) $ كتاب الهداية(@)(@@) لابن بابويه القمى محمد بن أحمد ص الامالى .(@)(@@)(@@)(@@) $ كتاب الهداية(@)(@@) شرح مختصر الحرمى قي النحو لابى PageV02P350 السحين محمد بن عبد الله الوراق المتوفى سنة 381 احدى وثمانين وثلاثمائة .(@)(@@)(@@)(@@) $ كتاب الهداية(@)(@@) فى فقه الحنابلة لعبد الرحمن بن محمد ابن على بن محمد الحلوانى البغدادى الحنبلى المتوفى سنة 546 ست واربعين وخمسمائة .(@)(@@)(@@)(@@) $ كتاب الهمز(@)(@@) لابى الحسن على بن محمد بن عبيد ابن الزبير الاسدى المعروف بابن الكوفى المتوفى سنة 348 ثمان واربعين وثلاثمائة .(@)(@@)(@@)(@@) $ كتاب الهمزة(@)(@@) لابى بكر محمد بن قاسم الانبارى ص الفات القطع .(@)(@@)(@@)(@@) $ كتاب الهمزة(@)(@@) لابى حاتم سهل بن محمد السجستانى ص كتاب الاتباع .(@)(@@)(@@)(@@) $ كتاب الهوش والتوش(@)(@@) لابى زيد سعيد بن اوس الخزرجى ص بيوتات العرب .(@)(@@)(@@)(@@) $ كتاب الياآت(@)(@@) لابن مجاهد أحمد بن موسى البغدادى المقرى المذكور .(@)(@@)(@@)(@@) $ كتاب الياآت(@)(@@) لابى طاهر البزار عبد الواحد المذكور .(@)(@@)(@@)(@@) $ كتاب فى اليرقان(@)(@@) لابى الحسن سعيد بن هبة الله الطبيب المتوفى سنة 494 اربع وتسعين واربعمائة .(@)(@@)(@@)(@@) $ كتاب اليسر بعد العسر(@)(@@) لابى الحسن على بن محمد الشابشتى المتوفى سنة 390 تسعين وثلاثمائة .(@)(@@)(@@)(@@) $ كتاب اليقين الموضوع فى مسجد اليقين(@)(@@) للشيخ الاكبر محيى الدين ابن عربى ص الاستمساك .(@)(@@)(@@)(@@) $ كتاب اليواغيث فى خواص البراغيث(@)(@@)(@@)(@@) $ كتاب اليوم والليلة(@)(@@) لابى أحمد محمد بن ابى عمير الازدى الشيعى ص الاحتجاج .(@)(@@)(@@)(@@) $ الكتابة العلية على الرسالة الجنبلاطية(@)(@@) للشيخ عبد الغنى النابلسى ص ابانة النص . PageV02P351(@)(@@)(@@)(@@) $ الكتيبة الكامنة فى شعراء المائة الثامنة(@)(@@) لابن الخطيب لسان الدين محمد الوزير ص الاستنزال .(@)(@@)(@@)(@@) $ كثيب الانوار فى ذكر الله العزيز الجبار(@)(@@) للشيخ 
ms684	 محمد بن أحمد المعروف بابن عقيلة المكى المتوفى بها سنة 1150 خمسين ومائة والف .(@)(@@)(@@)(@@) $ كثير الاخيار(@)(@@) لفخر الدين أحمد الفارسى ص سر الخلافة .(@)(@@)(@@)(@@) $ كحل الابصار(@)(@@) تأليف محمد بن الحسن القزوينى الشيعى ص رسالة التهجد .(@)(@@)(@@)(@@) $ كحل الاحداق فى جواهر آل إسحاق(@)(@@) لضياء الدين اسماعيل بن محمد بن أحمد بن إسحاق فرغ منها سنة 1159 تسع وخمسين ومائة والف .(@)(@@)(@@)(@@) $ كحل الطرف فى علم الصرف(@)(@@) للحاج عبد الله لقندهارى ص تحرير الاصول .(@)(@@)(@@)(@@) $ الكحل النفيس لجلاء عين الرئيس(@)(@@) فى شرح القصيدة العينية للحكيم داود بن عمر الانطاكى الضرير .(@)(@@)(@@)(@@) $ كرامات الاولياء(@)(@@) لشهاب الدين العجمى أحمد بن أحمد الوفائى .(@)(@@)(@@)(@@) $ كرامات العلماء من علماء الشيعة الامامية(@)(@@) تأليف محمد ابن سليمان التنكانبى الشيعى ص اسرار المصائب .(@)(@@)(@@)(@@) $ كروم التهانى لتفسير السبع المثانى(@)(@@) تأليف محمد ابن على بن حسن بن شداد ص الدرة الخطيرة اولها الحمد لله الذى انزل الفرقان وجعل الفاتحة فى الصلاة سببا لفلاح الانسان الخ .(@)(@@)(@@)(@@) $ كروم عريش التهانى فى الكلام على صلوات مشيش ابن دانى(@)(@@) لقطب الدين مصطفى البكرى ص الابتهالات السامية اولها الحمد لله رب العالمين بكل المحامد العلية الخ .(@)(@@)(@@)(@@) $ الكر والنفى فى الامانة والامامة عن المماثلة PageV02P352 فى الاستدلال بين طريق النبوة والامامة(@)(@@) لابى الفتح محمد الكراجكى الشيعى ص الاستبصار .(@)(@@)(@@)(@@) $ كسر الاصنام الجاهلية فى كفر جماعة الصوفية(@)(@@) لمير صدر الدين محمد بن إبراهيم الشيرازى الشيعى ص الاسفار .(@)(@@)(@@)(@@) $ كسر مفتاح القدر(@)(@@) للشيخ طاهر بن ابى الخير يحيى ابن سالم العمرانى اليمنى الشافعى المتوفى سنة 587 سبع وثمانين وخمسمائة رد فيه على جعفر بن يحيى الزيدى .(@)(@@)(@@)(@@) $ كسر الناموس فى شرح القاموس(@)(@@) لفخر الاسلام عبد الله بن شرف الدين الحسنى ملك اليمن المتوفى سنة 973 ثلاث وسبعين وتسعمائة .(@)(@@)(@@)(@@) $ كشاف اصطلاحات الفنون والعلوم(@)(@@) تأليف محمد على بن على التهانوى الهندى فرغ من تأليفه سنة 1158 ثمان وخمسين ومائة والف .(@)(@@)(@@)(@@) $ حاشية على الكشاف فى التفسير(@)(@@) لكمل الدين محمد ابن محمود البابرتى وحاشية لمحيى الدين محمد بن على القره باغى الرومى .(@)(@@)(@@)(@@) $ شرح شواهد الكشاف(@)(@@) فى التفسير لابن الطبيب الفاسى محمد ص الازهار 
ms685	 الندية .(@)(@@)(@@)(@@) $ كشاف القناع عن الاقناع(@)(@@) للشيخ منصور بن يونس النهوتى الحنبلى المتوفى سنة 1051 احدى وخمسين والف . 4 (@)(@@)(@@)(@@) $ الكشاف فى معرفة الاطراف(@)(@@) فى الحديث لشمس الدين محمد بن على بن حسن بن حمزة الدمشقى الحسنى المتوفى سنة 765 خمس وستين وسبعمائة .(@)(@@)(@@)(@@) $ كشف الآيات لطلاب الآيات الباهرات(@)(@@) تأليف محمد رضا بن عبد الله الطوسى الشيعى فرغ منها سنة 1067 سبع وستين والف .(@)(@@)(@@)(@@) $ كشف الاباطيل فى عبادة الصور والتماثيل(@)(@@) تأليف كرنيليوس فنديك الافريقى ص ارواء الظماء .(@)(@@)(@@)(@@) $ الكشف الاتم فى الاسم الاعظم(@)(@@) لزين العابدين محمد سبط المرصفى ص الادلة البهية .(@)(@@)(@@)(@@) $ كشف الارب عن سر الادب(@)(@@) لابراهيم الاحدب الطرابلسى ص ابداع الابداء . PageV02P353(@)(@@)(@@)(@@) $ كشف الارواح(@)(@@) فى التصوف فارسى للشيخ جمال الدين محمد الاردستانى ص استقامت نامه .(@)(@@)(@@)(@@) $ كشف الازار عن مشوهات الاوزار وسبيل الاتصال لمن رام الانفصال(@)(@@) تأليف الاديب محمد الجنبيهى اولها(@)(@@) ( مجارى الهوى مهلا دهتك المطامع % فهل انت فى نيل السعادة طامع )(@)(@@) الخ نظما ونثرا فى كراريس مطبوع .(@)(@@)(@@)(@@) $ كشف الاستار عن حكم الشفعة بالجوار(@)(@@) للشوكانى محمد بن على ص ابطال دعوى الاجماع .(@)(@@)(@@)(@@) $ كشف الاستار عن خواص الاسرار(@)(@@) للشيخ الاكبر محيى الدين ابن عربى ص الاستمساك اولها(@)(@@) ( يا طالب الاسرار فى الاسماء % ان الذى تبغيه عند الماء ) منظومة .(@)(@@)(@@)(@@) $ كشف الاستار عن وجه عويصات الافكار(@)(@@) اولها الحمد لله الذى شرف الانسان بخلقه الفصاحة الخ فرغ منها مؤلفه سنة 1072 اثنتيين وسبعين والف .(@)(@@)(@@)(@@) $ كشف الاستار عن مسئلة الاقرار(@)(@@) تأليف حسين ابن محمد المحلى المصرى الشافعى المتوفى سنة 1170 سبعين ومائة والف .(@)(@@)(@@)(@@) $ كشف الاستار عن نزهة الغبار(@)(@@) للمحلى ايضا .(@)(@@)(@@)(@@) $ كشف الاستار فى فضائل اهل البيت الابرار(@)(@@) للسيد محمد هادى بن مهدى بن دلدار على الكهنوى الهندى المجتهد الشيعى المتوفى سنة . . .(@)(@@)(@@)(@@) $ كشف الاستار الوهمية عن جمال محيا النفحة القدسية(@)(@@) للبكرى تأليف الصديق بن عمرخان المدنى المتوفى سنة . . اولها الحمد لله المتفرد لوحدة الافعال الخ من كتب الخديوية .(@)(@@)(@@)(@@) $ كشف الاسرار الازلية وتحقيق دوائر الانوار الابدية فى شرح كتاب الازل(@)(@@) تأليف ابى المدد على بن محمد ابن أحمد المتوفى سنة 1008 ثمان 
ms686	 والف . PageV02P354(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) تأليف الحافظ الخطيب البغدادى أحمد ص الاسماء المهمة .(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) تركى فى التصوف لاحمد بن عيسى خليفة المرمره وى ص جامع الاسرار اولها الحمد لله رب العالمين الخ .(@)(@@)(@@)(@@) $ كشف الاسرار العلمية بدار الضرب المصرية(@)(@@) تأليف منصور بن بعرة الذهبى الكاملى فرغ منها سنة 1135 خمس وثلاثين ومائة والف من كتب الخديوية .(@)(@@)(@@)(@@) $ كشف اسرار علوم المقربين(@)(@@) لعبد الله بن جعفر باعلوى ص الايفاء .(@)(@@)(@@)(@@) $ كشف الاسرار عن اسم محمد المختار(@)(@@) صلى الله عليه وسلم لمصطفى الكمالى الحلبى ص جنة النصر .(@)(@@)(@@)(@@) $ كشف الاسرار عن علم الغبار(@)(@@) للقلصادى على ابن محمد ص اشرف المسالك .(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) فى اصول الفقه لظهير الدين محمد ابن عمر بن محمد البخارى النوحاباذى الفقيه الحنفى المتوفى سنة 668 ثمان وستين وستمائة .(@)(@@)(@@)(@@) $ كشف الاسرار فى شرح الاستبصار(@)(@@) من كتب الشيعة للسيد نعمة الله الجزائرى ص الانوار النعمانية .(@)(@@)(@@)(@@) $ كشف الاسرار فى حل خيال الابزار(@)(@@) للشيخ حسين بن طعمة البيتمانى ص ذخيرة الاسلام .(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) فى شرح الطريقة المحمدية مرفى حرف الطاء .(@)(@@)(@@)(@@) $ كشف الاسرار صغير(@)(@@) للسيد عبد القادر بن عمر ابن محمد هاشم الكيلانى الهندى الشهير بشاه المتوفى سنة 1154 اربع وخمسين ومائة والف .(@)(@@)(@@)(@@) $ كشف الاسرار فى رسم مصاحف الامصار(@)(@@) لابى يحيى محمد بن محمود بن محمد الشيرازى القارى الشافعى المقرى اوله الحمد لله الذى كرم بنى آدم باشرف عطائه الخ مرتب على خمسة وعشرين بابا . PageV02P355(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) فى الكلام لابى على الاسكافى محمد ابن أحمد الشيعى ص ازالة الران .(@)(@@)(@@)(@@) $ كشف الاسرار النورانية القرآنية فيما يتعلق بالاجرام السماوية والارضية والحيوان والنبات والجواهر المعدنية(@)(@@) تأليف محمد بن أحمد الاسكندرانى الطبيب نزيل دمشق المتوفى سنة 1307 سبع وثلاثمائة والف اوله حمدا وشكرا لمن ابدع الكائنات الآلية الخ .(@)(@@)(@@)(@@) $ كشف الاسرار وهتك الاستار(@)(@@) فى التفسير على طريق المفسرين للشيخ الاكبر محيى الدين محمد بن على العربى ص الاستمساك فى خمس مجلدات موجود بدار الكتب للسلطان محمد الفاتح مفقود منها الجزء الرابع .(@)(@@)(@@)(@@) $ كشف الاسرار كبير(@)(@@) فى التصوف لشاه كدا ايضا .(@)(@@)(@@)(@@) $ كشف الاسرار المحررة الكامنة 
ms687	 فى الفاظ الجوهرة(@)(@@) كلاهما لعبد المعطى السملاوى ص احكام القول .(@)(@@)(@@)(@@) $ كشف الاسرار(@)(@@) تأليف يوسف بن كوندك الرومى الامام بجامع اياصوفيه المتوفى سنة . . . من كتب اياصوفيه .(@)(@@)(@@)(@@) $ كشف الاسعاد فى شرح قصيدة بانت سعاد(@)(@@) لبدر الدين محمد بن أحمد المعروف بالبدير المقدسى ص غنية الطلاب اوله الحمد لله رب العالمين على السراء والضراء الخ .(@)(@@)(@@)(@@) $ كشف الاسف فى الصلاة والسلام على سيد اهل الشرف(@)(@@) للسيد محمد معروف البرزنحبى ص ازهار الحمائل .(@)(@@)(@@)(@@) $ كشف الاشكال فى مسئلة الافعال(@)(@@) للشيخ محمد عقيلة المكى ص الاحسان .(@)(@@)(@@)(@@) $ كشف الاعراب(@)(@@) تركى فى النحو للسيد مصطفى عزت ابن مصطفى بستان الطوسيه وى الرومى نقيب الاشراف ورئيس العلماء بالقسطنطينية المتوفى بها سنة 1294 اربع وتسعين ومائتين والف اولها الحمد لله الذى هدانا لهذا وما كنا لنهتدى لولا ان هدانا الله الخ مطبوع . PageV02P356(@)(@@)(@@)(@@) $ الكشف الآلهى عن شديد الضعف والموضوع والواهى(@)(@@) للشيخ محمد بن محمد بن محمد الحسينى الطرابلسى فرغ منها سنة 1146 ست واربعين ومائة والف .(@)(@@)(@@)(@@) $ كشف الالتباس عما وسوس به الخناس(@)(@@) للسيد محمد صديق خان الهندى ص ابجد العلوم وهو فى الرد على الرافضة بلسان الهند .(@)(@@)(@@)(@@) $ كشف الالتباس فيما خفى على كثير من الناس(@)(@@) فى الاحاديث الموضوعة لغرس الدين محمد بن أحمد الخليلى ثم المدنى ص اتحاف اهل الكياسة .(@)(@@)(@@)(@@) $ كشف الالتباس فى نسب بنى العباس(@)(@@) لابى عبد الله محمد بن القاسم الديباجى الحلى النسابة ص تذييل الاعقاب .(@)(@@)(@@)(@@) $ كشف الالتباس فيما بين اصحاب الظاهر واصحاب القياس(@)(@@) لابى محمد على بن أحمد الظاهرى ص التلخيص والتخليص .(@)(@@)(@@)(@@) $ كشف الالتباس(@)(@@) لمحمد المفيد الشيعى ص احكام النساء .(@)(@@)(@@)(@@) $ كشف البأساء باذكار الصباح والمساء(@)(@@) للسيد محمد معروف البرزنحبى المذكور .(@)(@@)(@@)(@@) $ كشف الباس فى كلمات يقولها كثير من الناس(@)(@@) لابن عزوز محمد مكى التونسى ص ارشاد الحيران .(@)(@@)(@@)(@@) $ كشف البراهين فى شرح زاد المسافرين(@)(@@) فى اصول الدين كلاهما لابن ابى جمهور محمد الاحسائى الشيعى اولها ان اول ما صرفت فيه القوى أو توجهت اليه الهمم واحق ما نطق به اللسان أو رقم به القلم الخ .(@)(@@)(@@)(@@) $ كشف تاج التراجم من دائرة الجود 
ms688	 والمراحم(@)(@@) المنسوبة للشيخ الاكبر محيى الدين تأليف . . .(@)(@@)(@@)(@@) $ الكشف التام عن ارث ذوى الارحام(@)(@@) فى الفرائض لحسين بن محمد المحلى ص فتح رب البرية اوله الحمد لله الذى PageV02P357 وفق للفرائض من ارتضاه وقسم الارزاق بين عباده بما اراده واقتضاه الخ .(@)(@@)(@@)(@@) $ كشف التعمية فى حكم التسمية(@)(@@) لمحمد بن الحسن الحر العاملى الشيعى ص اثبات الهداة .(@)(@@)(@@)(@@) $ كشف التلبيس ورفع التدليس ونحر عدو الله ابليس(@)(@@) تأليف الشيخ جعفر الواعظ من كتب الزيتونة .(@)(@@)(@@)(@@) $ كشف التمويهات فى شرح التنبيهات(@)(@@) لسيف الدين ابى الحسن على بن ابى على الآمدى ص الباهر .(@)(@@)(@@)(@@) $ كشف التمويه والالباس على اغمار الشيعة فى امر القياس(@)(@@) لابن الجنيد محمد بن أحمد الاسكافى ص ازالة الران .(@)(@@)(@@)(@@) $ كشف التمويه والغمة(@)(@@) للفضائرى ابى عبد الله الحسين ابن عبيد الله ص البيان عن حياة الانسان .(@)(@@)(@@)(@@) $ كشف تمويه حليف الكذب عما افترق من سن فى الاشعار والنسب(@)(@@) لابى الحسن الشمشاطى على ابن محمد ص اخبار ابى تمام .(@)(@@)(@@)(@@) $ كشف الجلباب عن احكام تتعلق بالمحراب(@)(@@) لابن زياد وجيه الدين عبد الرحمن اليمنى ص اثبات سنة رفع اليدين .(@)(@@)(@@)(@@) $ كشف الجلباب عن علم الحساب(@)(@@) لعبد الله بن جعفر باعلوى اليمنى ص الايفاء .(@)(@@)(@@)(@@) $ كشف الحال فى نقد الرجال(@)(@@) لواحد من علماء الهند مطبوع بها .(@)(@@)(@@)(@@) $ كشف حال المشايخ الاحمدية واحوالهم الشيطانية(@)(@@) لابن تيمية تقى الدين أحمد الحرانى ص اثبات الصفات .(@)(@@)(@@)(@@) $ الكشف الحثيث عمن رمى بوضع الحديث(@)(@@) لابى عبد الله محمد من كتب اياصوفيه .(@)(@@)(@@)(@@) $ كشف الحجاب(@)(@@) فى التصوف للشيخ عبد الله الختلانى الصوفى المتوفى سنة . . . PageV02P358(@)(@@)(@@)(@@) $ كشف الحجاب فى تهذيب المشايخ للاصحاب(@)(@@) لعلوان الحموى على بن عطية الهيتى ص اسنى المقاصد .(@)(@@)(@@)(@@) $ كشف الحجاب فى علم الحساب(@)(@@) تأليف بطرس ابن بولس البستانى اللبنانى ص دائرة المعارف .(@)(@@)(@@)(@@) $ كشف الحجاب من كلام رب الارباب(@)(@@)(@@)(@@) $ كشف الحجب المسبلة شرح التحفة المرسلة(@)(@@) لابى الخير عبد الرحمن بن عبد الله السويدى ص حديقة الزوراء اوله الحمد لمن عين الاعيان بقبضه الخ .(@)(@@)(@@)(@@) $ كشف الحقائق بكنه الدقائق(@)(@@) تأليف محمد ابن عبد الملك الديلمى ص برهان المحبة اولها الحمد لله ذى الجلال والجمال والجود والفضل 
ms689	 والكمال الخ فرغ منها سنة 589 تسع وثمانين وخمسمائة مرتب على الابواب والفصول فى مجلد .(@)(@@)(@@)(@@) $ كشف الحقائق(@)(@@) فى التصوف فارسى للشيخ عبد العزيز ابن محمد النسفى الصوفى فرغ منها سنة 680 ثمانين وستمائة اولها حمد وسباس بى نهاية خدايراكه الخ .(@)(@@)(@@)(@@) $ كشف الحقائق المكتومة من القواعد المسموعة والمفهومة(@)(@@)(@@)(@@) $ كشف الحقائق(@)(@@) من شروح الشفا فى الحكمة لابن المطهر حسن بن يوسف الحلى الشيعى ص الابحاث المفيدة .(@)(@@)(@@)(@@) $ كشف الحيرة(@)(@@) لسلامة بن محمد القمى الشيعى ص كتاب الحج .(@)(@@)(@@)(@@) $ كشف الخافى من كتاب الكافى فى علمى العروض والقوافى(@)(@@) لمحيى الدين عبد القادر الطبرى ص الاساطين .(@)(@@)(@@)(@@) $ كشف الخدر عن حال الخضر(@)(@@) لابى سعيد الخادمى محمد بن مصطفى ص البريقة فى شرح الطريقة .(@)(@@)(@@)(@@) $ كشف الخفا ومزيل الالباس عما اشتهر من الاحاديث على السنة الناس(@)(@@) لاسماعيل بن محمد العجلونى ص الاجوبة المحققة .(@)(@@)(@@)(@@) $ كشف الدقائق(@)(@@) شرح الرسالة الزينية فى النحو . PageV02P359(@)(@@)(@@)(@@) $ كشف الران عن وجه البان بافصح اللسان(@)(@@)(@@)(@@) $ الكشف الربانى على المورد الرحمانى(@)(@@) ارجوزة لاحمد ابن الشرقاوى شمس التحقيق شرحه أحمد الحامدى الشهير بالطاهر اوله الحمد لله ذاتا وصفة وفعلا الخ .(@)(@@)(@@)(@@) $ كشف رموز غرر الاحكام وتنوير درر الاحكام(@)(@@) لعبد الحليم بن الشيخ بير قدم بن نصوح بن موسى الرومى الحنفى فرغ منها سنة 1060 ستين والف .(@)(@@)(@@)(@@) $ كشف الرموز فى حل الكنوز(@)(@@) للشيخ محمد المعروف بالصحفى الخلوتى المتوفى ببروسه سنة 1146 ست واربعين ومائة والف شرح فيه مقالة شيخه المصرى .(@)(@@)(@@)(@@) $ كشف الريب عن عماء الغيب(@)(@@) لعبد الجواد بن شعيب ابن أحمد القنائى المصرى الشافعى المتوفى سنة 1073 ثلاث وسبعين والف .(@)(@@)(@@)(@@) $ كشف الريب وبيان السر الغموض فى العمل بدائرة رجال الغيب وبالبسيط ذات العروض(@)(@@) تأليف عبد الله ابن عبد الرحمن الطولونى الموقت المتوفى سنة . . . اوله الحمد لله المعطى فلا مانع لما اعطى الخ فرغ منها سنة 1151 احدى وخمسين ومائة والف .(@)(@@)(@@)(@@) $ كشف الزور والبهتان من صنعة بنى ساسان(@)(@@)(@@)(@@) $ الكشف الساطع فى حل الجفر الجامع(@)(@@) لمحسن ابن على الخفارى الدمشقى المتوفى سنة . . . اوله يا من تقدس عن الحدوث والزوال الخ .(@)(@@)(@@)(@@) $ كشف الستر عن 
ms690	 حكم الصلاة بعد الوتر(@)(@@) لابن حجر العسقلانى شهاب الدين أحمد ص اتباع الاثر .(@)(@@)(@@)(@@) $ كشف الستر عن فريضة الوتر(@)(@@) للشيخ عبد الغنى النابلسى ص ابانة النص .(@)(@@)(@@)(@@) $ كشف الستور عن صحة المهايأة فى المأجور(@)(@@) للسيد محمود نسيب المعروف بابن حمزة المفتى الدمشقى ص الاحاديث المتواترة اوله الحمد لله رب العالمين الخ .(@)(@@)(@@)(@@) $ كشف السرائر على الاشباه والنظائر(@)(@@) فى الفروع لمحمد بن عمر الدمشقى المعروف بالكفيرى ص الاحكام . PageV02P360(@)(@@)(@@)(@@) $ كشف السرائر(@)(@@) لمحمد المفيد الشيعى ص احكام النساء(@)(@@)(@@)(@@) $ كشف السر الغامض فى شرح ديوان ابن الفارض(@)(@@) للنابلسى ايضا .(@)(@@)(@@)(@@) $ كشف الشبهات فى بيان التوحيد وما يخالف والرد على المشركين(@)(@@) لمحمد بن عبد الوهاب النجدى الوهابى ص تفسير الفاتحة .(@)(@@)(@@)(@@) $ كشف الضر فى نظم الدر(@)(@@) شرح تائية ابن الفارض لركن الدين الشيرازى اوله الحمد لله الذى نور قلوب عباده العارفين الخ .(@)(@@)(@@)(@@) $ كشف الطرة عن العزة(@)(@@) للآلوسى السيد محمود البغدادى ص روح المعانى .(@)(@@)(@@)(@@) $ كشف الظنون فى اسماء الشروح والمتون(@)(@@) لكمال الدين محمد البكرى ص تشنيف السمع .(@)(@@)(@@)(@@) $ كشف العقائد(@)(@@) فى شرح وترجمة العقائد النسفية بالتركية للسيد محمد راسم الملطى ص . . اولها حمد وسباس لا يحصى اول شيرازه بند نسخة اثبات وامحا تقدس وتعالى جنابنه احرادر الخ فى مجلد .(@)(@@)(@@)(@@) $ الكشف عن الاغلاط التسعة من بيت الساعة(@)(@@) للشيخ عبد الغنى النابلسى .(@)(@@)(@@)(@@) $ الكشف عن مناهج الادلة فى عقائد الملة(@)(@@) لابى الوليد محمد بن رشد القرطبى . . . اولها وبعد حمد الله الذى اختص من يشاء بحكمته الخ .(@)(@@)(@@)(@@) $ كشف الغايات فى شرح ما اكتفت علم التجليات(@)(@@)(@@)(@@) $ كشف الغشاء عن تفسير قوله تعالى @QB@ لله ملك السماوات والأرض يخلق ما يشاء @QE@(@)(@@) لبرهان الدين إبراهيم بن محمد ابن عيسى الصعيدى الميمونى الشافعى المتوفى سنة 1079 تسع وسبعين والف اوله الحمد لله الذى بيده ملك الارضين والسموات الخ .(@)(@@)(@@)(@@) $ كشف الغطا عن الابصار باغلاط تواريخ بلغار PageV02P361 واكاذيبها الصريحة لاولى الابصار(@)(@@) لشهاب الدين المرجانى ص اعلام ابناء الدهر .(@)(@@)(@@)(@@) $ كشف الغطا عن حقائق التوحيد وعقائد الموحدين وذكر الائمة الاشعريين ومن خالفهم من المبتدعين(@)(@@) لبدر الدين الحسين بن عبد الرحمن بن محمد اليمنى المعروف بابن 
ms691	 الاهدل المتوفى سنة 855 خمس وخمسين وثمانمائة .(@)(@@) اولها الحمد لله الذى تعرف إلى خلقه باحديته الخ فى مجلد .(@)(@@)(@@)(@@) $ كشف الغطا عن الصلاة الوسطى(@)(@@) للسيد محمد مرتضى الزبيدى ص اتحاف الاصفياء .(@)(@@)(@@)(@@) $ كشف الغطاء عن مبهمات الشريعة الغراء(@)(@@) للشيخ جعفر الحناجى النجفى ص حق المبين .(@)(@@)(@@)(@@) $ كشف الغطا عن مسئلة ابن العطا(@)(@@) للسيد عبد الرحمن ابن سليمان بن يحيى مقبول الاهدل اليمنى المتوفى سنة 1250 خمسين ومائتين والف .(@)(@@)(@@)(@@) $ كشف الغطا عما وقع فى تبرع الدين من اللبس والغطا(@)(@@) لابن زياد وجيه الدين عبد الرحمن اليمنى ص اثبات سنة رفع الدين(@)(@@)(@@)(@@) $ كشف الغطاء عن مسئلة البدا(@)(@@) للحاج عبد الله القندهارى نزيل المشهد الرضوى ص تحرير الاصول .(@)(@@)(@@)(@@) $ كشف الغطاء عن معائب ميرزا محمد عدو العلماء(@)(@@) للشيخ جعفر ايضا .(@)(@@)(@@)(@@) $ كشف الغطا(@)(@@) فى الاصول لمحمد حسن القزوينى الحائرى ص تلخيص الفوائد .(@)(@@)(@@)(@@) $ كشف الغمامة عن احكام العمامة(@)(@@) لابن طولون محمد الدمشقي ص ارشاد المرتضى(@)(@@)(@@)(@@) $ كشف الغمة عن حكم المقبوض عما فى الذمة(@)(@@) لابن زياد ايضا .(@)(@@)(@@)(@@) $ كشف الغمة فى احكام اهل الذمة(@)(@@) لابن جماعة بدر الدين محمد ص ايضاح الدليل . PageV02P362(@)(@@)(@@)(@@) $ كشف الغمة النفسانية فى معرفة الصورة الانسانية(@)(@@) لشمس الدين محمد بن منصور المقدسى المتوفى سنة . . اولها اول ما افتتح بعد حمد من بهر الابصار نور ظهوره الخ .(@)(@@)(@@)(@@) $ كشف الغموض فى علم العروض(@)(@@) لعبد السلام ابن على بن الحسين فرغ منها سنة 991 احدى وتسعين وتسعمائة .(@)(@@)(@@)(@@) $ كشف الغوامض فى احوال الانبياء(@)(@@) تأليف محمد ابن يحيى البشاغرى المتوفى سنة . . . قال ابتدأ بتأليفه فى ربيع الاول من سنة 838 ثمان وثلاثين وثمانمائة .(@)(@@)(@@)(@@) $ كشف الغوامض فى شرح منظومة الفرائض(@)(@@) لكمال الدين محمد بن مصطفى الصديقى الدمشقى ص تشنيف الاسماع .(@)(@@)(@@)(@@) $ كشف الغوامض فى الفرائض(@)(@@) لسبط الماردينى محمد ص ارشاد الفارض .(@)(@@)(@@)(@@) $ كشف غوامض القرآن(@)(@@) لفخر الدين طريح بن محمد النجفى الشيعى ص الاحتجاج .(@)(@@)(@@)(@@) $ كشف غوامض المنقول فى مشكل الآيات والآثار واخبار الرسول(@)(@@) لزين العابدين محمد سبط المرصفى ص الادلة البهية .(@)(@@)(@@)(@@) $ كشف الغياهب عن مشكلات اعمال الكواكب(@)(@@) لرمضان بن صالح بن عمر بن حجازى السفطى الفلكى 
ms692	 المتوفى بمصر سنة 1158 ثمان وخمسين ومائة والف .(@)(@@)(@@)(@@) $ كشف الغين عمن بوادى سرده من ذرية السبطين(@)(@@) للشيخ محمد بن ابى بكر الاشخر النسابة المتوفى سنة 991 احدى وتسعين وتسعمائة .(@)(@@)(@@)(@@) $ كشف الغيوب فى شرح جلاء القلوب(@)(@@) تأليف محمد امين الادرنه وى الرومى المدرس المتوفى سنة 1210 عشر ومائتين والف .(@)(@@)(@@)(@@) $ كشف الفتن عن لوامع المنن(@)(@@) شرح سنة ابيات فى حوادث مصر اولها الحمد لله الذى علم الانسان خواص الاحرف الجفرية الخ . PageV02P363(@)(@@)(@@)(@@) $ كشف الفوائد شرح قواعد العقائد(@)(@@) لابن المطهر حسن بن يوسف الحلى الشيعى ص الابحاث المفيدة .(@)(@@)(@@)(@@) $ كشف القناع عن الاقناع(@)(@@) من فروع الحنابلة .(@)(@@)(@@)(@@) $ كشف القناع عما ادعى فى مسئلة المعية من الاجماع(@)(@@) للشيخ أحمد بن المبارك ص الابريز .(@)(@@)(@@)(@@) $ كشف القناع الرفيع عن مسئلة التبرع بما يستحق الرضيع(@)(@@) للشرنبلالى حسن بن عمار الحنفى ص الابتسام اولها الحمد لله الولى الحميد الخ .(@)(@@)(@@)(@@) $ كشف القناع عن شوارد الطلاق والاختلاع(@)(@@) تأليف محمد شهية الحسنى المفلوطى الشافعى المتوفى سنة 1163 ثلاث وستين ومائة والف اولها الحمد لله الجامع بين من اراد من العباد الخ ص الدرر البهية .(@)(@@)(@@)(@@) $ كشف القناع عن صريح الدليل فى الرد على من قال فى الرضاع بالتنزيل(@)(@@) ليوسف البحرانى الشيعى ص اعلام القاصدين .(@)(@@)(@@)(@@) $ كشف القناع عن عور الاجماع(@)(@@) لمحمد بن عبد النبى النيسابورى الشيعى الاخبارى ص امالى العباسى .(@)(@@)(@@)(@@) $ كشف القناع عن متن وشرح ابى شجاع(@)(@@) فى الفروع تأليف عبد الرحمن المحلى الشافعى نزيل دمياط المتوفى سنة 1098 ثمان وتسعين والف .(@)(@@)(@@)(@@) $ كشف القناع عن معرفة الوقت من الارتفاع(@)(@@) للشيخ محمد الطندائى الخالدى نزيل دمشق الشام المتوفى بها سنة 1266 ست وستين ومائتين والف .(@)(@@)(@@)(@@) $ كشف القناع عن هول الوداع(@)(@@) لمحمد بن عبد العزيز المكى المتوفى سنة 954 اربع وخمسين وتسعمائة .(@)(@@)(@@)(@@) $ كشف القناع فى وصف الوداع(@)(@@) فى الادب لابن العليف محمد الحجازى . PageV02P364(@)(@@)(@@)(@@) $ كشف قناع المخدرات من بعض اسرار دقائق الصفات(@)(@@) للغدامسى من الزيتونة .(@)(@@)(@@)(@@) $ كشف القناع المعجب عن حدود عنقاء مغرب(@)(@@) تأليف محمد بن محمود بن على الدامونى البكرى اولها حمدا لمن ابرز الحقيقة المحمدية والرقيقة الاحمدية الخ 
ms693	 فى مجلد كبير فرغ منه سنة 1209 تسع ومائتين والف .(@)(@@)(@@)(@@) $ كشف القناع والنقاب لازالة الشبه عن وجه قواعد الاعراب(@)(@@) للشيخ محمد بن عبد الكريم الرومى المعروف بزلف نكار المتوفى سنة 964 اربع وستين وتسعمائة .(@)(@@)(@@)(@@) $ كشف الكروب فى فتح جميع الابواب واللغوب(@)(@@) من شروح الدور الاعلى لحسين بن اسماعيل بن مصطفى الحصارى الرومى فرغ منه سنة 1205 خمس ومائتين والف اوله الحمد لله رب العالمين والصلاة والسلام على نبينا محمد وآله وصحبه اجمعين الخ .(@)(@@)(@@)(@@) $ كشف الكروب فى معرفة الحروب(@)(@@) لعماد الدين موسى بن محمد بن يحيى اليوسفى المصرى المتوفى سنة 759 تسع وخمسين وسبعمائة .(@)(@@)(@@)(@@) $ كشف الكروب لملاقاة الحبيب والتوسل بالمحبوب(@)(@@) للشيخ إبراهيم اللقانى المصرى ص اجمال الوسائل .(@)(@@)(@@)(@@) $ كشف الكنوز(@)(@@) لجمال الدين محمد بن أحمد الاردستانى المتوفى سنة 879 تسع وسبعين وثمانمائة .(@)(@@)(@@)(@@) $ كشف اللبس عن المسائل الخمس(@)(@@) لاحمد بن المبارك السلجماسى ص الذهب الابريز .(@)(@@)(@@)(@@) $ كشف اللثام على نعم الله تعالى ونعم رسوله صلى الله عليه وسلم(@)(@@) لسراج الدين أحمد الحلبى الفاسى ص الدر النفيس .(@)(@@)(@@)(@@) $ كشف اللثام عن آداب الايمان والاسلام(@)(@@) للسيد محمد مرتضى الزبيدى ص تاج العروس .(@)(@@)(@@)(@@) $ كشف اللثام عن اسئلة الامام(@)(@@) لحسين بن محمد المحلى PageV02P365 الشافعى المتوفى سنة 1170 سبعين ومائة والف اوله حمدا لمن فقه فى الدين من ارتضاه من عباده الخ فى مجلد .(@)(@@)(@@)(@@) $ كشف اللثام عن قواعد الاحكام(@)(@@) فى الفقه لمحمد ابن الحسن الاصبهانى الشيعى المعروف بالفاضل الهندى ص التفسير .(@)(@@)(@@)(@@) $ كشف اللثام شرح افهام الافهام فى عقائد دين الاسلام(@)(@@) للشيخ حسين العصفور البحرانى الشيعى ص انوار اللامعات .(@)(@@)(@@)(@@) $ كشف اللثام شرح صلوات المشيشية لعبد السلام(@)(@@) لابن الفتوح محمد بن مصطفى البكرى الصديقى ص تشنيف الاسماع .(@)(@@)(@@)(@@) $ كشف اللثام شرح عمدة الاحكام(@)(@@) فى الحديث للسفارينى ابى العون محمد بن سالم ص الاجوبة النجدية .(@)(@@)(@@)(@@) $ كشف اللثام عن مخدرات الافهام(@)(@@) فى شرح البسملة تأليف الشيخ أحمد بن عبد المنعم المصرى الدمنهورى ص اتحاف البرية اوله ندعوك اللهم باسمائك الحسنى الخ .(@)(@@)(@@)(@@) $ كشف اللثام عمن جاء من الاحاديث النبوية فى شمائل المصطفى صلى الله عليه وسلم 
ms694	(@)(@@) تأليف محمد بن محمد ابن عمر الروضى المالكى فرغ منها سنة 1103 ثلاث ومائة والف .(@)(@@)(@@)(@@) $ كشف اللثام عن وجه التورية والاستخدام(@)(@@) لابن حجة الحموى تقى الدين ابى بكر على بن عبد الله ص امان الخائفين .(@)(@@)(@@)(@@) $ كشف اللغات(@)(@@) فارسى لعبد الرحيم الهندى مطبوع بها .(@)(@@)(@@)(@@) $ كشف المبهم مما فى السلم اعنى سلم الثبوت فى المنطق(@)(@@) لمحمد بشير الدين ابن محمد كريم الدين العثمانى القنوجى الهندى فرغ منها سنة 1265 خمس وستين ومائتين والف .(@)(@@)(@@)(@@) $ كشف المجانة عن الغسل فى الاجانة(@)(@@) رسالة للسيد محمود نسيب المعروف بابن حمزة الدمشقى ص الاحاديث المتواترة اوله الحمد لله الذى انزل من السماء ماء طهورا الخ .(@)(@@)(@@)(@@) $ كشف المحجة لثمرة البهجة(@)(@@) لرضى الدين على الطاوسى الشيعى ص الاسرار . PageV02P366(@)(@@)(@@)(@@) $ كشف المخبآت فى اهم منافع الحيوانات(@)(@@) تأليف محمد فوزى الطبيب المصرى ص الظواهر البديعية .(@)(@@)(@@)(@@) $ كشف المخبا عن فنون اوروبا(@)(@@) لاحمد فارس الشدياق ص الجاسوس .(@)(@@)(@@)(@@) $ كشف المراتب(@)(@@) فارسى فى التصوف للسيد نظام الدين محمود النيسابورى ص اسوة الكسوة(@)(@@)(@@)(@@) $ كشف المراد شرح تجريد الإعتقاد(@)(@@) من كتب آياصوفيه .(@)(@@)(@@)(@@) $ كشف المروط عن مخدرات ماللوضوء من الشروط(@)(@@) للشيخ محمد بن سليمان الكردى المدنى ص الثغر البسام .(@)(@@)(@@)(@@) $ كشف المريب فى العمل بالمجيب(@)(@@) للشيخ محمد ابن أحمد المزى المالكى المتوفى سنة 750 خمسين وسبعمائة اوله الحمد لله الكريم الوهاب الخ رتبه على مقدمة وثلاثة واربعين بابا فى مجلد .(@)(@@)(@@)(@@) $ كشف المستور فى جواب اسئلة عبد الشكور(@)(@@) لابى العرفان إبراهيم بن حسن الكورانى ص ابداء النعمة .(@)(@@)(@@)(@@) $ كشف المشكلات وايضاح المعضلات(@)(@@) فى تفسير القرآن لكمال الدين ابى الفتح موسى بن يونس بن منعة الموصلى الشافعى .(@)(@@)(@@)(@@) $ كشف المطالب فى شرح الربع المجيب(@)(@@) تأليف محمد ابن أحمد التيمورى الوالى الحنفى رتبه على مقدمة وعشرين بابا وخاتمة اوله الحمد لله الذى جعل الشمس ضياء الخ .(@)(@@)(@@)(@@) $ كشف المعانى عن متشابه المثانى(@)(@@) لابن جماعة بدر الدين محمد بن إبراهيم ص ايضاح الدليل .(@)(@@)(@@)(@@) $ كشف المعانى والبيان عن رسائل بديع الزمان(@)(@@) للاحدب إبراهيم الطرابلسى الاديب ص ابداع الابداء .(@)(@@)(@@)(@@) $ كشف المعضل فيمن عقل(@)(@@) للشرنبلالى حسن ابن عمار ص الابتسام 
ms695	 اوله الحمد لله المنعم بفضله ولا راد له الخ . PageV02P367(@)(@@)(@@)(@@) $ كشف المعنى فى تفسير اسماء الله الحسنى(@)(@@) للشيخ الاكبر محيى الدين ابن عربى ص الاستمساك .(@)(@@)(@@)(@@) $ كشف المغيب فى الحساب بالربع المجيب(@)(@@) للشيخ على بن إبراهيم بن محمد الطعم الانصارى الموقت بالجامع الاموى المتوفى سنة 777 سبع وسبعين وسبعمائة رتبه على مائتى وخمسة ابواب .(@)(@@)(@@)(@@) $ كشف المقال فى معرفة الرجال(@)(@@) تأليف علم الهدى محمد بن محمد محسن بن مرتضى من علماء الشيعة ص نضد الايضاح .(@)(@@)(@@)(@@) $ كشف الملمات فيما ابتدعه القراء من الالحان والنغمات(@)(@@) لزين الدين محمد بن محمد المرصفى ص الادلة البهية .(@)(@@)(@@)(@@) $ كشف المناهج والتفاتيح فى تخريج احاديث المصابيح(@)(@@) يأتى فى الميم .(@)(@@)(@@)(@@) $ كشف النقاب بشرح ملحة الاعراب(@)(@@) للشيخ على بن محمد بن ابى بكر بن إبراهيم بن ابى القاسم بن مطير الحكمى اليمنى المتوفى سنى 1041 احدى واربعين والف .(@)(@@)(@@)(@@) $ كشف النقاب عن احكام الزينة واللباس والحجاب(@)(@@) لابن باكير محمد بن مصطفى الجزائرى ص اقامة البراهين .(@)(@@)(@@)(@@) $ كشف النقاب عن احوال المحراب(@)(@@) لابن زياد عبد الرحمن اليمنى ص اثبات سنة رفع اليدين .(@)(@@)(@@)(@@) $ كشف النقاب عن انساب الاربعة الاقطاب(@)(@@) للشيخ عبد القادر بن محمد الطبرى الحسينى ص الاساطين اوله الحمد لله والصلاة والسلام على اكمل خلق الله الخ .(@)(@@)(@@)(@@) $ كشف النقاب عن انواع الشراب(@)(@@) تأليف رشيد غازى بن ابى عبيد أحمد بن سليمان الصيرفى الدمشقى الكاتب ولد سنة 1274 اربع وسبعين ومائتين والف اوله حمدا لمن اسكر احباءه بشهى خمرة ذكره وسقاهم شرابا طهورا جزاء القيام بشكره الخ فى مجلد صغير مطبوع فى بيروت(@)(@@)(@@)(@@) $ كشف النقاب الحاجب على مختصر ابن الحاجب(@)(@@) فى الاصول لابن فرحون إبراهيم بن على المدنى ص تسهيل المهمات . PageV02P368(@)(@@)(@@)(@@) $ كشف النقاب عن مخدرات ملحة الاعراب(@)(@@) اوله سبحانك لا احصى ثناء عليك الخ .(@)(@@)(@@)(@@) $ كشف النقاب فى حياة الانبياء اذا تواروا فى التراب(@)(@@) للواعظ محمد حجازى القلقشندى ص اتحاف السائل .(@)(@@)(@@)(@@) $ كشف النقاب فى شرح تحفة الطلاب(@)(@@) فى رسم الخط لمؤلف المتن مر فى التاء .(@)(@@)(@@)(@@) $ كشف النقاب فى شرح دالية ابن الحجازى(@)(@@) لشعيب بن اسماعيل الكيالى الشافعى 
ms696	 المتوفى سنة 1172 اثنتين وسبعين ومائة والف .(@)(@@)(@@)(@@) $ كشف النقاب فى شرح رشف الرضاب(@)(@@) لعبد الهادى نجا الابيارى ص باب الفتوح اوله نحمد من الف بين المختلفات تستهل براعة كل مؤلف الخ .(@)(@@)(@@)(@@) $ كشف النقاب للاصحاب والاحباب(@)(@@) للكافيه جى محمد بن سليمان ص الانوار اوله الحمد لله الكريم الوهاب الخ فى اعجاز القرآن .(@)(@@)(@@)(@@) $ كشف النقاب والران عن وجوه مخدرات اسئلة تقع فى بعض سور القرآن(@)(@@) لاحمد بن أحمد الفيومى الغرقاوى المالكى ص القول التام .(@)(@@)(@@)(@@) $ كشف النور عن اصحاب القبور(@)(@@) لعبد الغنى النابلسى ص ابانة النص .(@)(@@)(@@)(@@) $ الكشف والبيان عن علم معرفة الانسان(@)(@@) شرح القصيدة العينية لابن سينا مر فى القصائد .(@)(@@)(@@)(@@) $ الكشف والالهام عن حقائق سر التوكل والاعتصام(@)(@@) تركى تأليف أحمد بن عبد الله الخطيب الرومى الحنفى المتوفى سنة 1225 خمس وعشرين ومائتين والف اوله الحمد لله الملك الواحد الجليل الفرد الصمد القادر هو الله الجميل الخ . PageV02P369(@)(@@)(@@)(@@) $ الكشف والبيان عن مشائخ الزمان(@)(@@) للخطيب العمرى محمد امين الموصلى ص حدائق الزهر .(@)(@@)(@@)(@@) $ الكشف والتبيان عما يتعلق بالنسيان(@)(@@) للنابلسى عبد الغنى ص ابانة النص .(@)(@@)(@@)(@@) $ الكشف والتبيين فى غرور الخلق اجمعين(@)(@@) للغزالى حجة الاسلام ابى حامد محمد ص تعليق الاصول .(@)(@@)(@@)(@@) $ كشف الهموم عن المهموم(@)(@@) للشيخ محمد بن أحمد ابن على العمرى الموصلى المتوفى سنة 1199 تسع وتسعين ومائة والف .(@)(@@)(@@)(@@) $ كشف اليقين فى اصول الدين(@)(@@) لم يذكر مؤلفه موجود بدار الكتب المنسوبة لشيخ الاسلام عارف حكمت فى المدينة المنورة .(@)(@@)(@@)(@@) $ كشف اليقين فى فضائل امير المؤمنين(@)(@@) لابن المطهر الحلى المذكور .(@)(@@)(@@)(@@) $ الكشكول الصافية فى شرح الواردات السعدية(@)(@@) لاحمد رشيد النوشهرى الرومى ص الفيوضات الحبيبية .(@)(@@)(@@)(@@) $ الكشكول فيما جرى على آل الرسول(@)(@@) لابن المطهر ايضا .(@)(@@)(@@)(@@) $ كعبة الطائفين وبهجة العاكفين على قصيدة حزب العارفين(@)(@@) تأليف محمد بن سليمان المتوفى سنة . . اوله الحمد لله الذى نزه قلوب اوليائه عن الالتفات إلى متاع الدنيا الخ هو من رجال القرن الثانى عشر .(@)(@@)(@@)(@@) $ كعبه مدار(@)(@@) منظومة فارسية لمير تقى الدين محمد ص سرمه سليمان .(@)(@@)(@@)(@@) $ كفاية الاتقياء ومنهاج الاصفياء شرح هداية الاذكياء(@)(@@) للسيد ابى بكر بن محمد شطا الدمياطى 
ms697	 فرغ منها سنة 1302 اثنتين وثلاثمائة والف اوله الحمد لله الذى خص عباده الاخيار الخ . PageV02P370(@)(@@)(@@)(@@) $ كفاية التايق إلى تدريب الوامق(@)(@@) لشعيب الكيالي مر فى حرف التاء .(@)(@@)(@@)(@@) $ كفاية التعريف فى علم التصريف(@)(@@) لابن هشام جمال الدين عبد الله ص الاعراب .(@)(@@)(@@)(@@) $ كفاية التعليم فى وضع التقويم(@)(@@) لشهاب الدين أحمد ابن غلام الحاسب الكوم الريشى المتوفى سنة . .(@)(@@)(@@)(@@) $ كفاية الحذاق فى علم وضع الاوفاق(@)(@@) لموسى بن محمد ابن موسى القليبى العمرى الغوتى المالكى المتوفى سنة . . من كتب الخديوية .(@)(@@)(@@)(@@) $ كفاية ذوى الالباب فى فهم معونة الطلاب(@)(@@) لاحمد بن سليمان بن يغرا بن إبراهيم التغناسى المغربى فرغ منها سنة 1109 تسع ومائة والف اولها الحمد لله الذى خلق السموات وقدر الاوقات الخ .(@)(@@)(@@)(@@) $ كفاية الراوى والسامع وهداية الرائى والسامع(@)(@@) لقوام الدين يوسف بن الحسين الرومى المعروف بقاضى بغداد الحنفى المتوفى سنة 922 اثنتين وعشرين وتسعمائة .(@)(@@)(@@)(@@) $ كفاية السائل من انفع الوسائل(@)(@@) تأليف محمد بن محمد الزهرى الحنفى المتوفى سنة . .(@)(@@)(@@)(@@) $ كفاية السول فى علم الاصول(@)(@@) تأليف حسين ابن الامام قاسم بن محمد بن على اليمنى المتوفى سنة 1050 خمسين والف شرحها عبد الرحمن بن محمد بن شرف الدين الحجافى اليمنى المتوفى سنة 1053 ثلاث وخمسين والف .(@)(@@)(@@)(@@) $ الكفاية شرح النقابة(@)(@@) من فروع الحنفية لابن الامشاطى محمود بن أحمد ص القول السديد اوله الحمد لله الذى من علينا بالكفاية الخ . من كتب الخديوية .(@)(@@)(@@)(@@) $ الكفاية شرح الهداية(@)(@@) فى الاصول كلاهما لنور الدين أحمد بن محمود بن ابى بكر البخارى الصابونى الحنفى المتوفى سنة 508 ثمان وخمسمائة اوله الحمد لله الواجب وجوده وبقاؤه الواسع جوده وعطاؤه الخ . PageV02P371(@)(@@)(@@)(@@) $ كفاية الصبيان(@)(@@) للسيد محمد بن خليل الطرابلسى المعروف بالقاوقجى ص الاعتماد فى الإعتقاد .(@)(@@)(@@)(@@) $ كفاية الشعبى(@)(@@) فى الفقه والعبادات والمواعظ للقاضى ابى جعفر محمود بن عمر الشعبى الحنفى المتوفى سنة . . اولها المجلس الاول فى فرائض الصلاة الخ .(@)(@@)(@@)(@@) $ كفاية الطالب الربانى لرسالة ابن ابى زيد القيروانى(@)(@@) مر فى الرسائل .(@)(@@)(@@)(@@) $ كفاية الطالب فى نظم كافية ابن الحاجب(@)(@@) للسيد محمد معروف البرزنحبى ص ازهار الخميلة .(@)(@@)(@@)(@@) $ كفاية الطالب فى علم الطالع 
ms698	 والغارب(@)(@@) تأليف محمد الصقلى البرجى الاندلسى . من الزيتونة .(@)(@@)(@@)(@@) $ كفاية الطالب لعلم الوقت وبغية الراغب فى معرفة الدائر وفضله والسمت(@)(@@) للفلكى رمضان بن صالح السفطى ص بغية الوطر .(@)(@@)(@@)(@@) $ كفاية الطالب النبيل فى حل الفاظ مختصر الشيخ خليل(@)(@@) من فروع المالكية يأتى فى الميم .(@)(@@)(@@)(@@) $ كفاية الطالبين فى شرح الالفية(@)(@@) فارسى لشرف الدين على بن حجة الله الشولستانى الشيعى ص توضيح الاقوال .(@)(@@)(@@)(@@) $ كفاية الطبيب فى الطب(@)(@@) لنجم الدين أحمد بن اسعد الدمشقى الطبيب المعروف بابن العالمة المتوفى سنة 652 اثنتين وخمسين وستمائة .(@)(@@)(@@)(@@) $ كفاية الطلاب فى علم الفرائض والحساب(@)(@@) لعلاء الدين على بن عثمان الحوارى الخليلى المقدسى المتوفى سنة 833 ثلاث وثلاثين وثمانمائة .(@)(@@)(@@)(@@) $ كفاية العوام فى حفظ الصحة وتدبير الاسقام(@)(@@) تأليف يوحنا ورتبات الطبيب نزيل بيروت .(@)(@@)(@@)(@@) $ كفاية العوام فيما يجب عليهم من علم الكلام(@)(@@) تأليف محمد بن شافع المصرى الشافعى المعروف بالفضالى المتوفى سنة 1236 ست وثلاثين ومائتين والف . PageV02P372(@)(@@)(@@)(@@) $ كفاية الغلام فى اركان الاسلام(@)(@@) للشيخ عبد الغنى النابلسى ص ابانة النص .(@)(@@)(@@)(@@) $ الكفاية فى تحصين الرواية(@)(@@) لابن الاهدل اليمنى حسين ابن عبد الرحمن ص تحفة الزمن .(@)(@@)(@@)(@@) $ الكفاية فى العبادات(@)(@@) لعامر بن شراحيل الشعبى الزاهد المتوفى سنة 103 ثلاث ومائة .(@)(@@)(@@)(@@) $ الكفاية القانع فى معرفة الصانع(@)(@@) للسيد عبد الهادى ابن إبراهيم الملقب بالوزير الصنعانى الزيدى ص البديعية .(@)(@@)(@@)(@@) $ شرح كفاية القنوع(@)(@@) لعيسى بن عثمان بن على الفلورينه وى المتوفى سنة . . اوله الحمد لله الذى زين سناء الدنيا الخ .(@)(@@)(@@)(@@) $ كفاية المبتدى فى الرياضيات(@)(@@) لمصطفى الدمياطى الفلكى ص الدر فى الجيب .(@)(@@)(@@)(@@) $ كفاية المبتدى فى الفقه(@)(@@) لابى الفتح محمد بن على ابن محمد بن عثمان الحلوانى البغدادى المعروف بابن المراق الحنبلى المتوفى سنة 505 خمس وخمسمائة .(@)(@@)(@@)(@@) $ شرح كفاية المتحفظ(@)(@@) فى اللغة لابن الطيب الفاسى محمد صاحب الازهار الندية .(@)(@@)(@@)(@@) $ كفاية المتعبد فى الاذكار والدعوات(@)(@@) للزاهد المقسى أحمد ص طلب الزاد .(@)(@@)(@@)(@@) $ كفاية المتعبد وتحفة المتزهد(@)(@@) للمنذرى زكى الدين عبد العظيم بن عبد القوى ص زوال الظمأ اوله الحمد لله الموفق لصالح الاعمال الخ .(@)(@@)(@@)(@@) $ كفاية المحتاج إلى توجيه المنهاج(@)(@@) اعنى منهاج النووى فى الفروع 
ms699	 لمحمد بن ابى بكر أحمد المعروف بابن قاضى شهبة ص الاعلام .(@)(@@)(@@)(@@) $ كفاية المحتاج إلى معرفة منازل الحاج(@)(@@) من كتب آياصوفية .(@)(@@)(@@)(@@) $ كفاية المحتاج فى علم العلاج(@)(@@) للشيخ داود بن عمر الضرير الانطاكى الطبيب ص تزيين الاسواق . PageV02P373(@)(@@)(@@)(@@) $ كفاية المحتاج فى مسائل الحاج(@)(@@) لاحمد الحلى الشيعى ص عدة الداعى .(@)(@@)(@@)(@@) $ كفاية المحتاج لمعرفة ما ليس فى الديباج(@)(@@) للشيخ أحمد بابا السودانى ص التحديث والتأنيث .(@)(@@)(@@)(@@) $ كفاية المحتاج من الطلاب إلى معرفة المسائل الفلكية بالحساب(@)(@@) للشيخ حسن بن خليل الكراديسى المتوفى سنة 887 سبع وثمانين وثمانمائة اوله الحمد لله الذى خلقنا واوجدنا من العدم الخ مرتب على تسعة عشر بابا وخاتمة .(@)(@@)(@@)(@@) $ كفاية المحتاج من خبر صاحب التاج(@)(@@)(@@)(@@) $ كفاية المريد على شرح عقيدة اهل التوحيد(@)(@@) تأليف محمد بن عبد الله بن محمد مؤمن الرماصى الجزائرى فرغ منها سنة 1124 اربع وعشرين ومائة والف .(@)(@@)(@@)(@@) $ كفاية المريد وحلية العبيد(@)(@@) للشيخ محمد الخروبى الطرابلسى المغربى ص رسالة ذى الافلاس .(@)(@@)(@@)(@@) $ كفاية المستفيد فى علم التجويد(@)(@@) للشيخ عبد الغنى النابلسى ص ابانة النص .(@)(@@)(@@)(@@) $ كفاية المستقنع لادلة المقنع(@)(@@) من فروع الشافعية يأتى فى حرف الميم .(@)(@@)(@@)(@@) $ كفاية المفرطين(@)(@@) فى شرح الشافية للشيخ محمد ابن طاهر بن على الكجراتى الهندى المتوفى سنة . .(@)(@@)(@@)(@@) $ كفاية المنتهى شرح كفاية المبتدى(@)(@@) للبركوى فى الصرف تأليف الفاضل سليمان سرى الرومى أحد عضو مجلس المعارف اولها حامدا لمن كان كفاية فى البداية والنهاية الخ مطبوع .(@)(@@)(@@)(@@) $ كفاية المنصورى(@)(@@) لغياث الدين منصور بن مير صدر الدين الشيرازى ص اساس الهندسة .(@)(@@)(@@)(@@) $ الكلام السديد فى تحرير علم التوحيد(@)(@@) للدمنهورى أحمد بن عبد المنعم ص اتحاف البرية .(@)(@@)(@@)(@@) $ الكلام على ابن قتيبة فى تصحيف العلماء(@)(@@) لابن درستويه عبد الله بن جعفر ص احتجاج القراء . PageV02P374(@)(@@)(@@)(@@) $ الكلام على كل الصيد فى جوف الفرا(@)(@@) للسخاوى شمس الدين محمد ص الاجوبة العلية .(@)(@@)(@@)(@@) $ الكلام على المكسرات مخدرها ومسكرها(@)(@@) للزاهد المقسى ص تحفة السلاك .(@)(@@)(@@)(@@) $ الكلام فى بياض المدة ورسوب البول وبياض المنى(@)(@@) لاسحق بن عمران الطبيب الافريقى ص الادوية المفردة .(@)(@@)(@@)(@@) $ الكلام فى فنون الخبر المختلف بغير اثر(@)(@@) لمحمد ابن محمد المفيد الشيعى ص 
ms700	 احكام النساء .(@)(@@)(@@)(@@) $ الكلام فى وجوه اعجاز القرآن(@)(@@) للمفيد ايضا .(@)(@@)(@@)(@@) $ الكلام فى الوعيد الفاخر فى الاوائل والاواخر(@)(@@) لابى منصور عبد القاهر بن طاهر بن محمد البغدادى الشافعى المتوفى باسفرائن سنة 429 تسع وعشرين واربعمائة .(@)(@@)(@@)(@@) $ الكلام المبرم فى نقض القول المحقق المحكم(@)(@@) تأليف محمد عبد الحى اللكنوى الهندى المتوفى سنة 1289 ص الاجوبة الفاضلة .(@)(@@)(@@)(@@) $ الكلام المختار فى بيان منشأ الثلوج والامطار على مذهب اهل السنة والجماعة(@)(@@) لمحمد انيس بن محمد الطالوى الدمشقى ص تراجم الطائفة الارتقية .(@)(@@)(@@)(@@) $ الكلام المسوق لبيان مسائل المسبوق(@)(@@) لنوح ابن مصطفى الرومى ص اشرف المسالك اولها الحمد لله حق حمده الخ .(@)(@@)(@@)(@@) $ الكلام المعروف فى اعمال الكسوف والخسوف(@)(@@) للشيخ رمضان بن صالح السفطى ص بغية الوطر .(@)(@@)(@@)(@@) $ كلام الملوك ملوك الكلام(@)(@@) لعبد العلى بن ناصر الحويزى ص ديوان .(@)(@@)(@@)(@@) $ كلدستة تركيب(@)(@@) فى الطب فارسى لواحد من اطباء الهند .(@)(@@)(@@)(@@) $ كلدستة حيدرى(@)(@@) فارسى فى تذكرة الشعراء تأليف محمد حيدر نحش الحيدرى الهندى المتوفى سنة(@)(@@)(@@)(@@) $ كلدستة رياض عرفان ووفيات دانشوران نادره دان(@)(@@) فى التاريخ والتراجم تركى للسيد اسماعيل بليغ بن إبراهيم البرسوى PageV02P375 الشهير بشاهين اميرزاده المتوفى سنة 1142 اثنتين واربعين ومائة والف اوله(@)(@@) ( يا رب قلمم رشحه فيضكله ترايله % ) الخ فى مجلد مطبوع .(@)(@@)(@@)(@@) $ كلدستة نازنينان(@)(@@) فارسى فى تذكرة الشعراء لمولوى كريم الدين الهندى .(@)(@@)(@@)(@@) $ كلدستة نشاط(@)(@@) فارسى فى تذكرة الشعراء تأليف ذو الفقار على الهندى المتخلص بنشاط .(@)(@@)(@@)(@@) $ كلزار خليل(@)(@@) رسالة فارسية للشاعر ظهورى الترشيزى ص ديوان .(@)(@@)(@@)(@@) $ كلزار صلحا ووفيات عرفا(@)(@@) فى تراجم المشايخ والعلما والشعر للسيد أحمد بن الشيخ فخر الدين محمد البرسوى المعروف باشرف زاده المتوفى سنة 1224 اربع وعشرين ومائتين والف اوله حمد وثناى فراو ان وشكر وسباس بى بايان الخ .(@)(@@)(@@)(@@) $ كلزار عرفان(@)(@@)(@)(@@)(@@)(@@) $ كلزار مضامين(@)(@@) فارسى لميرزا خان الهندى .(@)(@@)(@@)(@@) $ كلستان ارم(@)(@@) فارسى فى المثنويات لرضاقلى خان العجمى المتخلص بهدايت ص اجمل التواريخ .(@)(@@)(@@)(@@) $ كلستان خليل(@)(@@) فارسى لميرزا إبراهيم الكازرونى المتخلص بنادرى المتوفى سنة 1258 ثمان وخمسين ومائتين والف .(@)(@@)(@@)(@@) $ كلستان عشاق وبستان المشتاق(@)(@@) لعبد القادر ابن عثمان الرومى الكاتب نزيل اليمن كان حيا سنة 1040 اربعين 