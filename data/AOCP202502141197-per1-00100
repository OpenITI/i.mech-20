ms81	 %~% گسسته شود از میان داوری(@)(@@) (@@) نجویی ز من خون پنجاه تن %~% که گشتند اینجای بیجان ز من(@)(@@) (@@) 193 نمایی به من دختران مرا %~% همان بنده و چاکران مرا(@)(@@) (@@) که من خود بدین سانم از مردگان %~% و پوشیده رویانم از بردگان(@)(@@) (@@) بدو شاه گفتا که یزدان گوا %~% که بدهم ترا جمله برگ و نوا(@)(@@) (@@) نیارم ازین کشتگان هیچ یاد %~% کشان سرنبشت این چنین اوفتاد(@)(@@) (@@) ترا با گرامیترت هر که هست %~% بدارم من ای خیره خونریز دست(@)(@@) (@@) 1935 که تو خود مکافات یابی ز چرخ %~% بدی باشدت زین پس از چرخ برخ(@)(@@) (@@) ز هرسو که خواهی به راهت کنم %~% عفو هرچه کردی گناهت کنم(@)(@@) (@@) چو با تو مرا جنگ و کینه نبود %~% نبایست با منت کین آزمود(@)(@@) (@@) کنون یافتستی سزاوار خویش %~% سزایست اگر پیچی از کار خویش(@)(@@) (@@) بفرمود پس قیس را تا ببرد %~% ورا تا به دز با دو ده مرد گرد(@)(@@) (@@) 194 چو نزدیک دز رفت بطریق خواند %~% یکی دخت با او سختها براند(@)(@@) (@@) سراسر گذشته برو یاد کرد %~% دلش پس به زنهار شه شاد کرد(@)(@@) (@@) پدر را چو دختر چنان دید خوار %~% به رومی زبان نوحه برداشت زار* دا5(@)(@@) (@@) بزاری زمانی بروبر گریست %~% که چونانش بدروز بایست زیست(@)(@@) (@@) بشد خواهران را سراسر بخواند %~% همان چاکران را سراسر بخواند(@)(@@) (@@) 1945 بنزدیک او جمله خویشان شدند %~% همه خاک بر سر پریشان شدند(@)(@@) (@@) چو بدرود کردند پس خان و مان %~% سپردند دز قیس را در زمان(@)(@@) (@@) خروشنده نزدیک شاه آمدند %~% وز آنجای جویای راه آمدند(@)(@@) (@@) ز فرخ همای آنچه درخواستند %~% کزو رفتن راه را خواستند(@)(@@) (@@) ز دیبا و از گوهر و سیم و زر %~% هم از پیشکاران و اسپ و سپر(@)(@@) (@@) 195 بفرمودشان شاه دادن بسی %~% وز آنجایشان کرد خشند کسی(@)(@@) (@@) پس آنگاه قیس اندر آن دز بگشت %~% به هر گنجخانه همه برگذشآت(@)(@@) (@@) در گنج خانه بسی مهر کرد %~% سپرد و بنزدیک شه ره سپره(@)(@@) (@@) بیامد به شه گفت چندانست مال %~% به دز 
ms82	 در که هوان کشیدن په سائ PageV01P079(@)(@@) ![image filename](./0550Anonymous.HumayNama_0145.jpg)(@)(@)(@@) (@@) ازو بخش لشکر ببائدت داد %~% چنان چون سزا باشد از راه داد(@)(@@) (@@) 188 دگر را سپردن به ده مرد گرد %~% که نتوان کنون آن سوی شام برد(@)(@@) (@@) چو از روم ما بازگشتن گریم %~% به ده کاروان بیش با خود بریم(@)(@@) (@@) شه آن کرد کآن نامور رای دید %~% کجا رای خوبش دل آرای دید(@)(@@) (@@) شب آمد ببودند تا بامداد %~% ز پیروزه چون بهرمان بام داد(@)(@@) (@@) بشد شاه با قیس و چندی سوار %~% به دز بر شدند و شه نامدار(@)(@@) (@@) 1885 در گنجها پاک بگشود و دید %~% ببخشید بخش سپه چون سزید56a 4(@)(@@) (@@) دگر را سراسر همه مهر کرد %~% نشاند اندر آن دز امین چند مرد(@)(@@) (@@) برایشان یکی را بزرگی فزود %~% دو روز و دو شب شاد بر دز ببود(@)(@@) (@@) فرود آمد و باز برداشت راه %~% به راه کشن رفت شاه و سپاه(@)(@@) گفتار اندر رفتن بطریق به عموریه و خبردادن(@)(@@) به قیصر از همای(@)(@@) (@@) هم از پیش او تیز بطریق رفت %~% به عموریه روی بنهاد تفت(@)(@@) (@@) 1890 بشد پیش قیصر بنالید زار %~% خود و خویش و پیوند و دختر چهار(@)(@@) (@@) ز کردار قیس و ز رنج همای %~% چو قیصر ورا دید نالان چو نای(@)(@@) (@@) به تن مستمند و به دو چشم کور %~% چو از چنگ شیر ژیان خسته گور(@)(@@) (@@) ورا گفت هرگز که دید این شگفت %~% که دربند و دز از تو دشمن گرفت(@)(@@) (@@) کجا مرغ نتواند آنجا پرید %~% نه باد بزان بر سر دز بزید(@)(@@) (@@) 11893 نپرید هرگز در آن ره عقاب %~% نه از ابر بر کوه جستش شهاب(@)(@@) (@@) نه آبست بر ره نه آباذجای %~% چگونه گذر کرد از آنجا همای(@)(@@) (@@) که باشد همای از کجا آمدست %~% که در کام تند اژدها آمدست(@)(@@) (@@) بدین ره که او آمد از سوی ما %~% نپرید پرندهاندر هوا(@)(@@) (@@) از شیر و ز جادو و خونخواره دد %~% که از هر سه خیره بماندی خرد PageV01P080(@)(@@) ![image filename](./0550Anonymous.HumayNama_0146.jpg)(@)(@)(@@) (@@) 1900 
ms83	 اگر زان کجا راه پرداختست %~% همه کشور من برانداختست(@)(@@) (@@) ازو مرمرا جای بیمست و باک %~% فرو برد خواهد سر ما به خاک(@)(@@) (@@) تو نشنیدهای تا چرا آمد اوی %~% بدین مرز ما از چه دادست روی* 65(@)(@@) (@@) که امروز کس نیست اندر جهان %~% مرا دشمن از آشکار و نهان(@)(@@) (@@) که با من کند در جهان هنبری %~% شمارد همی جنگ من سرسری(@)(@@) (@@) 1904 بدو گفت بطریق کای شهریار %~% شنیدم ز خویشان او یک سوار(@)(@@) (@@) کجا شاه شامش فرستاده است %~% به دخترش از عشق دل داده است(@)(@@) (@@) بکشتست در راه جادو و شیر %~% ز دد نیز پرداخت گرد دلیر(@)(@@) (@@) از دربند بگذشت و دز را گرفت %~% من از دولت او بماندم شگفت(@)(@@) (@@) مرا این چنین زار و بد روز کرد %~% ز خان و ز مانم برآورد گرد(@)(@@) (@@) 191 از آن پس که تو دانی ای شهریار %~% که من چون بدم در جهان نامدار(@)(@@) (@@) ترا تا چه پیش آید از وی کنون %~% چه مایه بریزد درین مرز خون(@)(@@) (@@) بزودی تو پیگار او را بساز %~% همان دیر کانگاه گردد دراز(@)(@@) (@@) کنون چاره کن کار خود را که هست %~% ترا بر همه چارهآ کار دست(@)(@@) (@@) اگر سست گیری شود بر تو سخت %~% بپیچد ز تو روی فرخنده بخت(@)(@@) (@@) 1915 پدیدست وقت همه کار مرد %~% بدانسان که هنگام درمان درد(@)(@@) (@@) چو آن وقت و هنگام هردو گذشت %~% ز تو رنج هر دو به تو بازگشت(@)(@@) (@@) به هر کار در مردم پیشبین %~% نهاده بر اسپ مرادست زین(@)(@@) (@@) نه اکنون زدست این مثل در جهان %~% که باشد همی پیشبین پیشدان(@)(@@) (@@) ورا گفت قیصر نگفتی دروغ %~% گرفتم ز گفت تو دانش فروغ(@)(@@) (@@) 1920 سپه سازم اکنون فزون از قیاس %~% به پند نکو از تو دارم سپاس7a 7(@)(@@) (@@) ز دانا هرآنکس که نشنود پند %~% به دانش نشد در جهان ارجمند(@)(@@) (@@) نیوشیدن پند دانش نمای %~% فزاید هش و فر و فرهنگ و رای(@)(@@) (@@) مرا پند تو دلپذیر آمدست %~% که پیوسته رسمت هژیر 
ms84	 آمدست(@)(@@) (@@) تو بنشین به جایی که داری تو رای %~% که چون تاخته گردد از من همای(@)(@@) (@@) 1925 فرستم ترا سوی دز باز شاد %~% نمانم حق و حرمت تو ز یاد PageV01P081(@)(@@) ![image filename](./0550Anonymous.HumayNama_0147.jpg)(@)(@)(@@) (@@) بفرمودش از گنج ده بدره زر %~% همیدون قبای و کلاه و کمر(@)(@@) (@@) دو سد اسپ و استر غلام وکنیز %~% بدادش چو بایست هرگونه چیز(@)(@@) (@@) وزان پس سپه ساختن کار بست %~% چو شد ساخته تاختن کار بست(@)(@@) (@@) نه چندان سپه گرد شد بر درش %~% که دانست داننده حد و مرش(@)(@@) گفتار اندر پذیره شدن قیصر با لشکر همای را(@)(@@) (@@) 1930 برون آمد از شهر و ره برگرفت %~% رخ آسمان گرد لشکر گرفت(@)(@@) (@@) از غریدن کوس شد گوش کر %~% به رفتن بر آورد هر اسپ پر(@)(@@) (@@) چنان هر زمانی بنالید نای %~% که گردون درآورد گفتی ز پای(@)(@@) (@@) تبیره نشد جز چو تندر دمان %~% تو پنداشتی زو سرآمد زمان(@)(@@) (@@) ز لشکر چو دریای چین دشت گشت %~% چو دریا اگر هیچ سان گشت دشت(@)(@@) (@@) 194 یکی ماهه ره راندش از پیش باز %~% کشن لشکرش روز و شب تیزتاز(@)(@@) (@@) چو یکروزه ره ماند نزدیک شاه %~% فرود آمد و بود یک چند گاه(@)(@@) (@@) سراپرده و خیمه زد سدهزار %~% میان چو دریا یکی مرغزار6 570(@)(@@) (@@) خبر یافت زو شاه گردن فراز %~% که آمد به یک منزلی او فراز(@)(@@) (@@) چنان ساخت لشکرگه خود که پشت %~% بدش از سوی کوه سنگ درشت(@)(@@) (@@) 1940 چپ و راستش بیشه بر هر کنار %~% گشاده ز پیش اندرش مرغزار(@)(@@) (@@) ز آب و علف بهره بودش بسی %~% نشد مر علف را به جایی کسی(@)(@@) (@@) فرستاد کارآگهان را چو باد %~% به لشکرگه قیصر بدنژاد(@)(@@) (@@) نهان تا بدیدند لشکرش را %~% سراپرده و ساز و اخترش را(@)(@@) (@@) چو دیدند ماندند اندر شگفت %~% دل یک یک اندیشهآ آن گرفت(@)(@@) (@@) 194 که با قیصر ار آنکه جنگ آورد %~% به ما بر جهان تار و تنگ آورد(@)(@@) (@@) از پس روی کردند چون باد و دود %~% ز قیصر خبر 
