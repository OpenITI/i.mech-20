ms121	 نفس راكب % 132(@)(@@) % أظل إذا هزته ريح ولألأت % له الشمس أمواجا طوال الغوارب % 133(@)(@@) % كأني أرى فيهن فرسان بهمة % يليحون نحوي بالسيوف القواضب % 134(@)(@@) % فإن قلت لي قد يركب اليم طاميا % ودجلة عند اليم بعض المذانب % 135(@)(@@) % فلا عذر فيها لامرىء هاب مثلها % % وفي اللجة الخضراء عذر لهائب % 136(@)(@@) % فإن احتجاجي عنك ليس بنائم % وإن بياني ليس عني بعازب % 137(@)(@@) % لدجلة خب ليس لليم إنها % % ترائي بحلم تحته جهل واثب % 138(@)(@@) % تطامن حتى تطمئن قلوبنا % % وتغضب من مزح الرياح اللواعب % 139(@)(@@) % وأجرافها رهن بكل خيانة % وغدر ففيها كل عيب لعائب % 140(@)(@@) % ترانا إذا هاجت بها الريح هيجة % نزلزل في حوماتها بالقوارب % PageV01P478 141(@)(@@) % نوائل من زلزالها نحو خسفها % % فلا خير في أوساطها والجوانب % % 142(@)(@@) % زلازل موج في غمار زواجر % وهدات خسف في شطوط خوارب % 143(@)(@@) % ولليم إعذار بعرض متونه % وما فيه من آذيه المتراكب % 144(@)(@@) % ولست تراه في الرياح مزلزلا % بما فيه إلا في الشداد الغوالب % % 145(@)(@@) % وإن خيف موج عيذ منه بساحل % خلي من الأجراف ذات الكباكب % 146(@)(@@) % ويلفظ ما فيه فليس معاجلا % غريقا بغت يزهق النفس كارب % 147(@)(@@) % يعلل غرقاه إلى أن يغيثهم % % بصنع لطيف منه خير مصاحب % 148(@)(@@) % فتلفى الدلافين الكريم طباعها % % هناك رعالا عند نكب النواكب % 149(@)(@@) % مراكب للقوم الذين كبا بهم % % فهم وسطه غرقى وهم في مراكب % 150(@)(@@) % وينقض ألواح السفين فكلها % % منج لدى نوب من الكسر نائب % PageV01P479 151(@)(@@) % وما أنا بالراضي عن البحر مركبا % ولكنني عارضت شغب المشاغب % 152(@)(@@) % صدقتك عن نفسي وأنت مراغمي % % وموضع سري دون أدنى الأقارب % 153(@)(@@) % وجربت حتى ما أرى الدهر مغربا % علي بشيء لم يقع في تجاربي % % 154(@)(@@) % أرى المرء مذ يلقى التراب بوجهه % إلى أن يوارى فيه رهن النوائب % 155(@)(@@) % ولو لم يصب إلا بشرخ شبابه % لكان قد استوفى جميع المصائب % 156(@)(@@) % ومن صدق الأخيار داووا سقامه % بصحة آراء ويمن نقائب % 157(@)(@@) % وما زال صدق المستشير معاونا % على الرأي لب المستشار المحازب % 158(@)(@@) % وأبعد أدواء الرجال ذوي الضنى % % من 
ms122	 البرء داء المستطب المكاذب % 159(@)(@@) % فلا تنصبن الحرب لي بملامتي % % وأنت سلاحي في حروب النوائب % 160(@)(@@) % وأجدى من التعنيف حسن معونة % برأي ولين من خطاب المخاطب % PageV01P480 161(@)(@@) % وفي النصح خير من نصيح موادع % ولا خير فيه من نصيح مواثب % 162(@)(@@) % ومثلي محتاج إلى ذي سماحة % كريم السجايا أريحي الضرائب % 163(@)(@@) % يلين على أهل التسحب مسه % ويغضي لهم عند اقتراح الغرائب % 164(@)(@@) % له نائل ما زال طالب طالب % ومرتاد مرتاد وخاطب خاطب % 165(@)(@@) % ألا ماجد الأخلاق حر فعاله % تباري عطاياه عطايا السحائب % 166(@)(@@) % كمثل أبي العباس إن نواله % نوال الحيا يسعى إلى كل طالب % 167(@)(@@) % يسير نحوي عرفه فيزورني % % هنيئا ولم أركب صعاب المراكب % 168(@)(@@) % يسير إلى ممتاحه فيجوده % ويكفي أخا الإمحال زم الركائب % 169(@)(@@) % ومن يك مثلا للحيا في علوه % يكن مثله في جوده بالمواهب % 170(@)(@@) % وإن نفاري منه وهو يريغني % % لشيء لرأي فيه غير مناسب % PageV01P481 171(@)(@@) % وإن قعودي عنه خيفة نكبة % للؤم مهز وانثناء مضارب % 172(@)(@@) % أقر على نفسي بعيبي لأنني % % أرى الصدق يمحو بينات المعايب % 173(@)(@@) % لؤمت لعمر الله فيما أتيته % % وإن كنت من قوم كرام المناصب % 174(@)(@@) % لهم حلم إنس في عرامة جنة % وبأس أسود في دهاء ثعالب % 175(@)(@@) % يصولون بالأيدي إذا الحرب أعملت % سيوف سريج بعد أرماح زاعب % 176(@)(@@) % ولا بد من أن يلؤم المرء نازعا % إلى الحمأ المسنون ضربة لازب % 177(@)(@@) % فقل لأبي العباس لقيت وجهه % وحسبك مني تلك دعوة صاحب % 178(@)(@@) % أما حق حامي عرض مثلك أن يرى % % له الرفد والترفيه أوجب واجب % 179(@)(@@) % أمن بعد ما لم ترع للمال حرمة % وأسلمته للجود غير مجاذب % 180(@)(@@) % فأعطيت ذا سلم وحرب ووصلة % وذنب عطايا أدركت كل هارب % PageV01P482 181(@)(@@) % ولم تشخص العافين لكن أتتهم % لهاك جليبات لأكرم جالب % 182(@)(@@) % علما بأن الظعن فيه مشقة % وأن أمر الربح ربح الجلائب % 183(@)(@@) % تكلفني هول السفار وغوله % رفيق شتاء مقفعل الرواجب % 184(@)(@@) % ولا سيما حين ارتدى الماء كبره % وشاغب أنفاس الصبا والجنائب % 185(@)(@@) % وهرت على مستطرقي البر قرة % يمس 
ms123	 أذاها دون لوث العصائب % 186(@)(@@) % كأن تمام الود والمدح كله % هوي الفتى في البحر أو في السباسب % 187(@)(@@) % لعمري لئن حاسبتني في مثوبتي % % بخفضي لقد أجريت عادة حاسب % 188(@)(@@) % حنانيك قد أيقنت أنك كاتب % له رتبة تعلو به كل كاتب % 189(@)(@@) % فدعني من حكم الكنابة إنه % عدو لحكم الشعر غير مقارب % 190(@)(@@) % وإلا فلم يستعمل العدل جاعل % أجد مجد قرن ألعب لاعب % PageV01P483 191(@)(@@) % أيعزب عنك الرأي في أن تثيبني % % مقيما مصونا عن عناء المطالب % 192(@)(@@) % فتلفى وألفى بين صافي صنيعة % وصافي ثناء لم يشب بالمعاتب % 193(@)(@@) % وتخرج من أحكام قوم تشددوا % % فقد جعلوا آلاءهم كالمصائب % 194(@)(@@) % أيذهب هذا عنك يا ابن محمد % وأنت معاذ في الأمور الحوازب % 195(@)(@@) % لك الرأي والجود اللذان كلاهما % % زعيم بكشف المطبقات الكوارب % 196(@)(@@) % وما زلت ذا ضوء ونوء لمجدب % وحيران حتى قيل بعض الكواكب % % 197(@)(@@) % تغيث وتهدي عند جدب وحيرة % بمحتفل ثر وأزهر ثاقب % 198(@)(@@) % وأحسن عرف موقعا ما تناله % يدي وغرابي بالنوى غير ناعب % 199(@)(@@) % أراك متى ثوبتني في رفاهة % زففت إلي الملك بين الكتائب % 200(@)(@@) % وأنت متى ثوبتني في مشقة دع اللوم إن اللوم عون النوائب % % ولا تتجاوز فيه حد المعاتب % PageV01P484 201(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 202(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 203(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % 204(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 205(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 206(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 207(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % 208(@)(@@) % فأصبحت في الإثراء أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 209(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % 210(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير أتاه الفقر من كل جانب % PageV01P485 211(@)(@@) % ولما دعاني للمثوبة سيد % % يرى 
ms124	 المدح عارا قبل بذل المثاوب % 212(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 213(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % 214(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 215(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 216(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 217(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التعرير بعد التجارب % 218(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 219(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % 220(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % PageV01P486 221(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 222(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 223(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % 224(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 225(@)(@@) % فملت إلى خان مرث بناؤه % % مميل غريق الثوب لهفان لاغب % 226(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 227(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % 228(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 229(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % 230(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % PageV01P487 231(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 232(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 233(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % 234(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف به ذي مثالب % 235(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجب % 236(@)(@@) % إذا ظلت البيداء تطفو إكامها % % وترسب في غمر من الآل ناضب % 237(@)(@@) % فدع عنك ذكر البر إني رأيته % لمن خاف هول البحر شر 
ms125	 المهاوب % 238(@)(@@) % كلا نزليه صيفه وشتاؤه % خلاف لما أهواه غير مصاقب % 239(@)(@@) % لهاث مميت تحت بيضاء سخنة % وري مفيت تحت أسحم صائب % 240(@)(@@) % يجف إذا ما أصبح الريق عاصبا % ويغدق لي والريق ليس بعاصب % PageV01P488 241(@)(@@) % ويمنع مني الماء واللوح جاهد % ويغرقني والري رطب المحالب % % 242(@)(@@) % وما زال يبغيني الحتوف مواربا % يحوم على قتلي وغير موارب % 243(@)(@@) % فطورا يغاديني بلص مصلت % وطورا يمسيني بورد الشوارب % 244(@)(@@) % إلى أن وقاني الله محذور شره % بعزته والله أغلب غالب % 245(@)(@@) % فأفلت من ذؤبانه وأسوده % وحرابه إفلات أتوب تائب % 246(@)(@@) % وأما بلاء البحر عندي فإنه % % طواني على روع مع الروح واقب % 247(@)(@@) % ولو ثاب عقلي لم أدع ذكر بعضه % ولكنه من هوله غير ثائب % % 248(@)(@@) % ولم لا ولو ألقيت فيه وصخرة % لوافيت منه القعر أول راسب % 249(@)(@@) % ولم أتعلم قط من ذي سباحة % سوى الغوص والمضعوف غير مغالب % 250(@)(@@) % فأيسر إشفاقي من الماء أنني % % أمر به في الكوز مر المجانب % PageV01P489 251(@)(@@) % وأخشى الردى منه على كل شارب % % فكيف بأمنيه على نفس راكب % 252(@)(@@) % أظل إذا هزته ريح ولألأت % له الشمس أمواجا طوال الغوارب % 253(@)(@@) % كأني أرى فيهن فرسان بهمة % يليحون نحوي بالسيوف القواضب % 254(@)(@@) % فإن قلت لي قد يركب اليم طاميا % ودجلة عند اليم بعض المذانب % 255(@)(@@) % فلا عذر فيها لامرىء هاب مثلها % % وفي اللجة الخضراء عذر لهائب % 256(@)(@@) % فإن احتجاجي عنك ليس بنائم % وإن بياني ليس عني بعازب % 257(@)(@@) % لدجلة خب ليس لليم إنها % % ترائي بحلم تحته جهل واثب % 258(@)(@@) % تطامن حتى تطمئن قلوبنا % % وتغضب من مزح الرياح اللواعب % 259(@)(@@) % وأجرافها رهن بكل خيانة % وغدر ففيها كل عيب لعائب % 260(@)(@@) % ترانا إذا هاجت بها الريح هيجة % نزلزل في حوماتها بالقوارب % PageV01P490 261(@)(@@) % نوائل من زلزالها نحو خسفها % % فلا خير في أوساطها والجوانب % % 262(@)(@@) % زلازل موج في غمار زواجر % وهدات خسف في شطوط خوارب % 263(@)(@@) % ولليم إعذار بعرض متونه % وما فيه من آذيه المتراكب % 264(@)(@@) % ولست تراه في الرياح مزلزلا % بما فيه إلا في الشداد الغوالب 
ms126	 % % 265(@)(@@) % وإن خيف موج عيذ منه بساحل % خلي من الأجراف ذات الكباكب % 266(@)(@@) % ويلفظ ما فيه فليس معاجلا % غريقا بغت يزهق النفس كارب % 267(@)(@@) % يعلل غرقاه إلى أن يغيثهم % % بصنع لطيف منه خير مصاحب % 268(@)(@@) % فتلفى الدلافين الكريم طباعها % % هناك رعالا عند نكب النواكب % 269(@)(@@) % مراكب للقوم الذين كبا بهم % % فهم وسطه غرقى وهم في مراكب % 270(@)(@@) % وينقض ألواح السفين فكلها % % منج لدى نوب من الكسر نائب % PageV01P491 271(@)(@@) % وما أنا بالراضي عن البحر مركبا % ولكنني عارضت شغب المشاغب % 272(@)(@@) % صدقتك عن نفسي وأنت مراغمي % % وموضع سري دون أدنى الأقارب % 273(@)(@@) % وجربت حتى ما أرى الدهر مغربا % علي بشيء لم يقع في تجاربي % % 274(@)(@@) % أرى المرء مذ يلقى التراب بوجهه % إلى أن يوارى فيه رهن النوائب % 275(@)(@@) % ولو لم يصب إلا بشرخ شبابه % لكان قد استوفى جميع المصائب % 276(@)(@@) % ومن صدق الأخيار داووا سقامه % بصحة آراء ويمن نقائب % 277(@)(@@) % وما زال صدق المستشير معاونا % على الرأي لب المستشار المحازب % 278(@)(@@) % وأبعد أدواء الرجال ذوي الضنى % % من البرء داء المستطب المكاذب % 279(@)(@@) % فلا تنصبن الحرب لي بملامتي % % وأنت سلاحي في حروب النوائب % 280(@)(@@) % وأجدى من التعنيف حسن معونة % برأي ولين من خطاب المخاطب % PageV01P492 281(@)(@@) % وفي النصح خير من نصيح موادع % ولا خير فيه من نصيح مواثب % 282(@)(@@) % ومثلي محتاج إلى ذي سماحة % كريم السجايا أريحي الضرائب % 283(@)(@@) % يلين على أهل التسحب مسه % ويغضي لهم عند اقتراح الغرائب % 284(@)(@@) % له نائل ما زال طالب طالب % ومرتاد مرتاد وخاطب خاطب % 285(@)(@@) % ألا ماجد الأخلاق حر فعاله % تباري عطاياه عطايا السحائب % 286(@)(@@) % كمثل أبي العباس إن نواله % نوال الحيا يسعى إلى كل طالب % 287(@)(@@) % يسير نحوي عرفه فيزورني % % هنيئا ولم أركب صعاب المراكب % 288(@)(@@) % يسير إلى ممتاحه فيجوده % ويكفي أخا الإمحال زم الركائب % 289(@)(@@) % ومن يك مثلا للحيا في علوه % يكن مثله في جوده بالمواهب % 290(@)(@@) % وإن نفاري منه وهو يريغني % % لشيء لرأي فيه غير مناسب % PageV01P493 291(@)(@@) % وإن قعودي عنه خيفة نكبة % للؤم مهز وانثناء 
ms127	 مضارب % 292(@)(@@) % أقر على نفسي بعيبي لأنني % % أرى الصدق يمحو بينات المعايب % 293(@)(@@) % لؤمت لعمر الله فيما أتيته % % وإن كنت من قوم كرام المناصب % 294(@)(@@) % لهم حلم إنس في عرامة جنة % وبأس أسود في دهاء ثعالب % 295(@)(@@) % يصولون بالأيدي إذا الحرب أعملت % سيوف سريج بعد أرماح زاعب % 296(@)(@@) % ولا بد من أن يلؤم المرء نازعا % إلى الحمأ المسنون ضربة لازب % 297(@)(@@) % فقل لأبي العباس لقيت وجهه % وحسبك مني تلك دعوة صاحب % 298(@)(@@) % أما حق حامي عرض مثلك أن يرى % % له الرفد والترفيه أوجب واجب % 299(@)(@@) % أمن بعد ما لم ترع للمال حرمة % وأسلمته للجود غير مجاذب % 300(@)(@@) % فأعطيت ذا سلم وحرب ووصلة % وذنب عطايا أدركت كل هارب % PageV01P494 301(@)(@@) % ولم تشخص العافين لكن أتتهم % لهاك جليبات لأكرم جالب % 302(@)(@@) % علما بأن الظعن فيه مشقة % وأن أمر الربح ربح الجلائب % 303(@)(@@) % تكلفني هول السفار وغوله % رفيق شتاء مقفعل الرواجب % 304(@)(@@) % ولا سيما حين ارتدى الماء كبره % وشاغب أنفاس الصبا والجنائب % 305(@)(@@) % وهرت على مستطرقي البر قرة % يمس أذاها دون لوث العصائب % 306(@)(@@) % كأن تمام الود والمدح كله % هوي الفتى في البحر أو في السباسب % 307(@)(@@) % لعمري لئن حاسبتني في مثوبتي % % بخفضي لقد أجريت عادة حاسب % 308(@)(@@) % حنانيك قد أيقنت أنك كاتب % له رتبة تعلو به كل كاتب % 309(@)(@@) % فدعني من حكم الكنابة إنه % عدو لحكم الشعر غير مقارب % 310(@)(@@) % وإلا فلم يستعمل العدل جاعل % أجد مجد قرن ألعب لاعب % PageV01P495 311(@)(@@) % أيعزب عنك الرأي في أن تثيبني % % مقيما مصونا عن عناء المطالب % 312(@)(@@) % فتلفى وألفى بين صافي صنيعة % وصافي ثناء لم يشب بالمعاتب % 313(@)(@@) % وتخرج من أحكام قوم تشددوا % % فقد جعلوا آلاءهم كالمصائب % 314(@)(@@) % أيذهب هذا عنك يا ابن محمد % وأنت معاذ في الأمور الحوازب % 315(@)(@@) % لك الرأي والجود اللذان كلاهما % % زعيم بكشف المطبقات الكوارب % 316(@)(@@) % وما زلت ذا ضوء ونوء لمجدب % وحيران حتى قيل بعض الكواكب % % 317(@)(@@) % تغيث وتهدي عند جدب وحيرة % بمحتفل ثر وأزهر ثاقب % 318(@)(@@) % وأحسن عرف موقعا ما تناله 
ms128	 % يدي وغرابي بالنوى غير ناعب % 319(@)(@@) % أراك متى ثوبتني في رفاهة % زففت إلي الملك بين الكتائب % 320(@)(@@) % وأنت متى ثوبتني في مشقة % % رأيتك في شخص المثيب المعاقب % PageV01P496 321(@)(@@) % ولو لم يكن في العرف صاف مهنأ % وذو كدر والعرف شتى المشارب % 322(@)(@@) % إذا لم يقل أعلى النوابغ رتبة % لمقول غسان الملوك الأشايب % 323(@)(@@) % علي لعمرو نعمة بعد نعمة % لوالده ليست بذات عقارب % 324(@)(@@) % وما عقرب أدهى من البين إنه % % له لسعة بين الحشا والترائب % 325(@)(@@) % ومن أجل ما راعى من البين قوله % % كليني لهم يا أميمة ناصب % 326(@)(@@) % أبيت سوى تكليفك العرف معفيا % به صافيا من مؤذيات الشوائب % 327(@)(@@) % بل المجد يأبى غير سومك نفسه % ورفعك عن طود المنيل المحاسب % 328(@)(@@) % فصبرا على تحميلك الثقل كله % وإن عز تحميل القروم المصاعب % 329(@)(@@) % ولا يعجبن الناس من سعي متعب % مشيح لجدوى مستريح مداعب % 330(@)(@@) % فمن ساد قوما أوجب الطول أن يرى % % مجدا لأدناهم وهم في الملاعب % PageV01P497 331(@)(@@) % ومن لم يزل في مصعد المجد راقيا % صعاب المراقي نال عليا المراتب % 332(@)(@@) % ألم ترني أتعبت فكري محككا % لك الشعر كي لا أبتلى بالمتاعب % 333(@)(@@) % نحلتك حليا من مديح كأنه % % هوى كل صب من عناق الحبائب % % 334(@)(@@) % أنيقا حقيقا أن تكون حقاقه % من الدر لا بل من ثدي الكواعب % 335(@)(@@) % وأنت له أهل فإن تجزني به % % أزدك وإن تمسك أقف غير عاتب % 336(@)(@@) % فإن سألتني عنك يوما عصابة % شهدت على نفسي بسوء المناقب % 337(@)(@@) % وقلت دعاني للندى فأتيته % فأمسكه بل بثه في المناهب % 338(@)(@@) % وما احتجزت مني لهاه لحاجز % ولا احتجبت عني هناك بحاجب % 339(@)(@@) % ولكن تصدت وانحرفت لحرفتي % % ففاءت ولم تظلم إلى خير واهب % 340(@)(@@) % وما قلت إلا الحق فيك ولم تزل % % على منهج من سنة المجد لاحب % PageV01P498 341(@)(@@) % وإني لأشقى الناس إن زر ملبسي % % على إثم أفاك وحسرة خائب % 342(@)(@@) % وكنت الفتى الحر الذي فيه شيمة % تشيم عن الأحرار حد المخالب % 343(@)(@@) % ولست كمن يعدو وفي كلماته % تظلم مغصوب وعدوان غاصب % 344(@)(@@) % يحاول 
ms129	 معروف الرجال وإن أبوا % % تعدى على أعراضهم كالمكالب % 345(@)(@@) % وأصبح يشكو الناس في الشعر جامعا % شكاية مسلوب وتسليط سالب % 346(@)(@@) % فلا تحرمني كي تجد عجيبة % لقوم فحسب الناس ماضي العجائب % 347(@)(@@) % ولا تنتقص من قدر حظي إقامتي % % سألتك بالداعين بين الأخاشب % 348(@)(@@) % وما اعتقلتني رغبة عنك يممت % % سواك ولكن أي رهبة راهب % 349(@)(@@) % كأني أرى بالظعن طعن مطاعن % % وبالضرب في الأقطار ضرب مضارب % 350(@)(@@) % وليس جزائي أن أخيب لأنني % % جبنت ولم أخلق عتاد محارب % PageV01P499 351(@)(@@) % يطالب بالإقدام من عد محربا % وسمي مذ ناغى بقود المقانب % % 352(@)(@@) % ولم يمش قيد الشبر إلا وفوقه % % عصائب طير تهتدي بعصائب % 353(@)(@@) % فأما فتى ذو حكمة وبلاغة % فطالبه بالتسديد وسط المخاطب % 354(@)(@@) % أثبني ورفهني وأجزل مثوبتي % % وثابر على إدرار بري وواظب % 355(@)(@@) % لتأتيني جدواك وهي سليمة % من العيب ما فيها اعتلال لعائب % 356(@)(@@) % أثقل إدلالي لتحمل ثقله % % بطوع المراضي لا بكره المغاضب % 357(@)(@@) % وما طلب الرفد الهنيء ببدعة % ولا عجب المسترفديه بعاجب % 358(@)(@@) % وذاك مزيد في معاليك كله % وفي صدق هاتيك القوافي السوارب % 359(@)(@@) % وما حق باغيك المزيد انتقاصه % ولا سيما والمال جم الحلائب % 360(@)(@@) % وأنت الذي يضحى وأدنى عطائه % بلوغ الأماني بل قضاء المآرب % PageV01P500 361(@)(@@) % وتوزن بالأموال آمال وفده % وإرفاد قوم بالظنون الكواذب % 362(@)(@@) % أقمت لكي تزداد نعماك نعمة % وتغنى بوجه ناضر غير شاحب % 363(@)(@@) % وكي لا يقول القائلون أثابهدع اللوم إن اللوم عون النوائب % % ولا تتجاوز فيه حد المعاتب % 364(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 365(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 366(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % 367(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 368(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 369(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 370(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % PageV01P501 371(@)(@@) % فأصبحت في الإثراء 
ms130	 أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 372(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % 373(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير أتاه الفقر من كل جانب % 374(@)(@@) % ولما دعاني للمثوبة سيد % % يرى المدح عارا قبل بذل المثاوب % 375(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 376(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % 377(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 378(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 379(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 380(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التعرير بعد التجارب % PageV01P502 381(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 382(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % 383(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % 384(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 385(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 386(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % 387(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 388(@)(@@) % فملت إلى خان مرث بناؤه % % مميل غريق الثوب لهفان لاغب % 389(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 390(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % PageV01P503 391(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 392(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % 393(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % 394(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 395(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 396(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % 397(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف 
ms131	 به ذي مثالب % 398(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجب % 399(@)(@@) % إذا ظلت البيداء تطفو إكامها % % وترسب في غمر من الآل ناضب % 400(@)(@@) % فدع عنك ذكر البر إني رأيته % لمن خاف هول البحر شر المهاوب % PageV01P504 401(@)(@@) % كلا نزليه صيفه وشتاؤه % خلاف لما أهواه غير مصاقب % 402(@)(@@) % لهاث مميت تحت بيضاء سخنة % وري مفيت تحت أسحم صائب % 403(@)(@@) % يجف إذا ما أصبح الريق عاصبا % ويغدق لي والريق ليس بعاصب % 404(@)(@@) % ويمنع مني الماء واللوح جاهد % ويغرقني والري رطب المحالب % % 405(@)(@@) % وما زال يبغيني الحتوف مواربا % يحوم على قتلي وغير موارب % 406(@)(@@) % فطورا يغاديني بلص مصلت % وطورا يمسيني بورد الشوارب % 407(@)(@@) % إلى أن وقاني الله محذور شره % بعزته والله أغلب غالب % 408(@)(@@) % فأفلت من ذؤبانه وأسوده % وحرابه إفلات أتوب تائب % 409(@)(@@) % وأما بلاء البحر عندي فإنه % % طواني على روع مع الروح واقب % 410(@)(@@) % ولو ثاب عقلي لم أدع ذكر بعضه % ولكنه من هوله غير ثائب % % PageV01P505 411(@)(@@) % ولم لا ولو ألقيت فيه وصخرة % لوافيت منه القعر أول راسب % 412(@)(@@) % ولم أتعلم قط من ذي سباحة % سوى الغوص والمضعوف غير مغالب % 413(@)(@@) % فأيسر إشفاقي من الماء أنني % % أمر به في الكوز مر المجانب % 414(@)(@@) % وأخشى الردى منه على كل شارب % % فكيف بأمنيه على نفس راكب % 415(@)(@@) % أظل إذا هزته ريح ولألأت % له الشمس أمواجا طوال الغوارب % 416(@)(@@) % كأني أرى فيهن فرسان بهمة % يليحون نحوي بالسيوف القواضب % 417(@)(@@) % فإن قلت لي قد يركب اليم طاميا % ودجلة عند اليم بعض المذانب % 418(@)(@@) % فلا عذر فيها لامرىء هاب مثلها % % وفي اللجة الخضراء عذر لهائب % 419(@)(@@) % فإن احتجاجي عنك ليس بنائم % وإن بياني ليس عني بعازب % 420(@)(@@) % لدجلة خب ليس لليم إنها % % ترائي بحلم تحته جهل واثب % PageV01P506 421(@)(@@) % تطامن حتى تطمئن قلوبنا % % وتغضب من مزح الرياح اللواعب % 422(@)(@@) % وأجرافها رهن بكل خيانة % وغدر ففيها كل عيب لعائب % 423(@)(@@) % ترانا إذا هاجت بها الريح هيجة % نزلزل في حوماتها بالقوارب % 424(@)(@@) % نوائل من زلزالها نحو خسفها 
ms132	 % % فلا خير في أوساطها والجوانب % % 425(@)(@@) % زلازل موج في غمار زواجر % وهدات خسف في شطوط خوارب % 426(@)(@@) % ولليم إعذار بعرض متونه % وما فيه من آذيه المتراكب % 427(@)(@@) % ولست تراه في الرياح مزلزلا % بما فيه إلا في الشداد الغوالب % % 428(@)(@@) % وإن خيف موج عيذ منه بساحل % خلي من الأجراف ذات الكباكب % 429(@)(@@) % ويلفظ ما فيه فليس معاجلا % غريقا بغت يزهق النفس كارب % 430(@)(@@) % يعلل غرقاه إلى أن يغيثهم % % بصنع لطيف منه خير مصاحب % PageV01P507 431(@)(@@) % فتلفى الدلافين الكريم طباعها % % هناك رعالا عند نكب النواكب % 432(@)(@@) % مراكب للقوم الذين كبا بهم % % فهم وسطه غرقى وهم في مراكب % 433(@)(@@) % وينقض ألواح السفين فكلها % % منج لدى نوب من الكسر نائب % 434(@)(@@) % وما أنا بالراضي عن البحر مركبا % ولكنني عارضت شغب المشاغب % 435(@)(@@) % صدقتك عن نفسي وأنت مراغمي % % وموضع سري دون أدنى الأقارب % 436(@)(@@) % وجربت حتى ما أرى الدهر مغربا % علي بشيء لم يقع في تجاربي % % 437(@)(@@) % أرى المرء مذ يلقى التراب بوجهه % إلى أن يوارى فيه رهن النوائب % 438(@)(@@) % ولو لم يصب إلا بشرخ شبابه % لكان قد استوفى جميع المصائب % 439(@)(@@) % ومن صدق الأخيار داووا سقامه % بصحة آراء ويمن نقائب % 440(@)(@@) % وما زال صدق المستشير معاونا % على الرأي لب المستشار المحازب % PageV01P508 441(@)(@@) % وأبعد أدواء الرجال ذوي الضنى % % من البرء داء المستطب المكاذب % 442(@)(@@) % فلا تنصبن الحرب لي بملامتي % % وأنت سلاحي في حروب النوائب % 443(@)(@@) % وأجدى من التعنيف حسن معونة % برأي ولين من خطاب المخاطب % 444(@)(@@) % وفي النصح خير من نصيح موادع % ولا خير فيه من نصيح مواثب % 445(@)(@@) % ومثلي محتاج إلى ذي سماحة % كريم السجايا أريحي الضرائب % 446(@)(@@) % يلين على أهل التسحب مسه % ويغضي لهم عند اقتراح الغرائب % 447(@)(@@) % له نائل ما زال طالب طالب % ومرتاد مرتاد وخاطب خاطب % 448(@)(@@) % ألا ماجد الأخلاق حر فعاله % تباري عطاياه عطايا السحائب % 449(@)(@@) % كمثل أبي العباس إن نواله % نوال الحيا يسعى إلى كل طالب % 450(@)(@@) % يسير نحوي عرفه فيزورني % % هنيئا ولم أركب صعاب المراكب % PageV01P509 451(@)(@@) % يسير إلى ممتاحه 
ms133	 فيجوده % ويكفي أخا الإمحال زم الركائب % 452(@)(@@) % ومن يك مثلا للحيا في علوه % يكن مثله في جوده بالمواهب % 453(@)(@@) % وإن نفاري منه وهو يريغني % % لشيء لرأي فيه غير مناسب % 454(@)(@@) % وإن قعودي عنه خيفة نكبة % للؤم مهز وانثناء مضارب % 455(@)(@@) % أقر على نفسي بعيبي لأنني % % أرى الصدق يمحو بينات المعايب % 456(@)(@@) % لؤمت لعمر الله فيما أتيته % % وإن كنت من قوم كرام المناصب % 457(@)(@@) % لهم حلم إنس في عرامة جنة % وبأس أسود في دهاء ثعالب % 458(@)(@@) % يصولون بالأيدي إذا الحرب أعملت % سيوف سريج بعد أرماح زاعب % 459(@)(@@) % ولا بد من أن يلؤم المرء نازعا % إلى الحمأ المسنون ضربة لازب % 460(@)(@@) % فقل لأبي العباس لقيت وجهه % وحسبك مني تلك دعوة صاحب % PageV01P510 461(@)(@@) % أما حق حامي عرض مثلك أن يرى % % له الرفد والترفيه أوجب واجب % 462(@)(@@) % أمن بعد ما لم ترع للمال حرمة % وأسلمته للجود غير مجاذب % 463(@)(@@) % فأعطيت ذا سلم وحرب ووصلة % وذنب عطايا أدركت كل هارب % 464(@)(@@) % ولم تشخص العافين لكن أتتهم % لهاك جليبات لأكرم جالب % 465(@)(@@) % علما بأن الظعن فيه مشقة % وأن أمر الربح ربح الجلائب % 466(@)(@@) % تكلفني هول السفار وغوله % رفيق شتاء مقفعل الرواجب % 467(@)(@@) % ولا سيما حين ارتدى الماء كبره % وشاغب أنفاس الصبا والجنائب % 468(@)(@@) % وهرت على مستطرقي البر قرة % يمس أذاها دون لوث العصائب % 469(@)(@@) % كأن تمام الود والمدح كله % هوي الفتى في البحر أو في السباسب % 470(@)(@@) % لعمري لئن حاسبتني في مثوبتي % % بخفضي لقد أجريت عادة حاسب % PageV01P511 471(@)(@@) % حنانيك قد أيقنت أنك كاتب % له رتبة تعلو به كل كاتب % 472(@)(@@) % فدعني من حكم الكنابة إنه % عدو لحكم الشعر غير مقارب % 473(@)(@@) % وإلا فلم يستعمل العدل جاعل % أجد مجد قرن ألعب لاعب % 474(@)(@@) % أيعزب عنك الرأي في أن تثيبني % % مقيما مصونا عن عناء المطالب % 475(@)(@@) % فتلفى وألفى بين صافي صنيعة % وصافي ثناء لم يشب بالمعاتب % 476(@)(@@) % وتخرج من أحكام قوم تشددوا % % فقد جعلوا آلاءهم كالمصائب % 477(@)(@@) % أيذهب هذا عنك يا ابن محمد % وأنت معاذ في الأمور الحوازب 
ms134	 % 478(@)(@@) % لك الرأي والجود اللذان كلاهما % % زعيم بكشف المطبقات الكوارب % 479(@)(@@) % وما زلت ذا ضوء ونوء لمجدب % وحيران حتى قيل بعض الكواكب % % 480(@)(@@) % تغيث وتهدي عند جدب وحيرة % بمحتفل ثر وأزهر ثاقب % PageV01P512 481(@)(@@) % وأحسن عرف موقعا ما تناله % يدي وغرابي بالنوى غير ناعب % 482(@)(@@) % أراك متى ثوبتني في رفاهة % زففت إلي الملك بين الكتائب % 483(@)(@@) % وأنت متى ثوبتني في مشقة % % رأيتك في شخص المثيب المعاقب % 484(@)(@@) % ولو لم يكن في العرف صاف مهنأ % وذو كدر والعرف شتى المشارب % 485(@)(@@) % إذا لم يقل أعلى النوابغ رتبة % لمقول غسان الملوك الأشايب % 486(@)(@@) % علي لعمرو نعمة بعد نعمة % لوالده ليست بذات عقارب % 487(@)(@@) % وما عقرب أدهى من البين إنه % % له لسعة بين الحشا والترائب % 488(@)(@@) % ومن أجل ما راعى من البين قوله % % كليني لهم يا أميمة ناصب % 489(@)(@@) % أبيت سوى تكليفك العرف معفيا % به صافيا من مؤذيات الشوائب % 490(@)(@@) % بل المجد يأبى غير سومك نفسه % ورفعك عن طود المنيل المحاسب % PageV01P513 491(@)(@@) % فصبرا على تحميلك الثقل كله % وإن عز تحميل القروم المصاعب % 492(@)(@@) % ولا يعجبن الناس من سعي متعب % مشيح لجدوى مستريح مداعب % 493(@)(@@) % فمن ساد قوما أوجب الطول أن يرى % % مجدا لأدناهم وهم في الملاعب % 494(@)(@@) % ومن لم يزل في مصعد المجد راقيا % صعاب المراقي نال عليا المراتب % 495(@)(@@) % ألم ترني أتعبت فكري محككا % لك الشعر كي لا أبتلى بالمتاعب % 496(@)(@@) % نحلتك حليا من مديح كأنه % % هوى كل صب من عناق الحبائب % % 497(@)(@@) % أنيقا حقيقا أن تكون حقاقه % من الدر لا بل من ثدي الكواعب % 498(@)(@@) % وأنت له أهل فإن تجزني به % % أزدك وإن تمسك أقف غير عاتب % 499(@)(@@) % فإن سألتني عنك يوما عصابة % شهدت على نفسي بسوء المناقب % 500(@)(@@) % وقلت دعاني للندى فأتيته % فأمسكه بل بثه في المناهب % PageV01P514 501(@)(@@) % وما احتجزت مني لهاه لحاجز % ولا احتجبت عني هناك بحاجب % 502(@)(@@) % ولكن تصدت وانحرفت لحرفتي % % ففاءت ولم تظلم إلى خير واهب % 503(@)(@@) % وما قلت إلا الحق فيك ولم تزل % % على منهج من سنة 
ms135	 المجد لاحب % 504(@)(@@) % وإني لأشقى الناس إن زر ملبسي % % على إثم أفاك وحسرة خائب % 505(@)(@@) % وكنت الفتى الحر الذي فيه شيمة % تشيم عن الأحرار حد المخالب % 506(@)(@@) % ولست كمن يعدو وفي كلماته % تظلم مغصوب وعدوان غاصب % 507(@)(@@) % يحاول معروف الرجال وإن أبوا % % تعدى على أعراضهم كالمكالب % 508(@)(@@) % وأصبح يشكو الناس في الشعر جامعا % شكاية مسلوب وتسليط سالب % 509(@)(@@) % فلا تحرمني كي تجد عجيبة % لقوم فحسب الناس ماضي العجائب % 510(@)(@@) % ولا تنتقص من قدر حظي إقامتي % % سألتك بالداعين بين الأخاشب % PageV01P515 511(@)(@@) % وما اعتقلتني رغبة عنك يممت % % سواك ولكن أي رهبة راهب % 512(@)(@@) % كأني أرى بالظعن طعن مطاعن % % وبالضرب في الأقطار ضرب مضارب % 513(@)(@@) % وليس جزائي أن أخيب لأنني % % جبنت ولم أخلق عتاد محارب % 514(@)(@@) % يطالب بالإقدام من عد محربا % وسمي مذ ناغى بقود المقانب % % 515(@)(@@) % ولم يمش قيد الشبر إلا وفوقه % % عصائب طير تهتدي بعصائب % 516(@)(@@) % فأما فتى ذو حكمة وبلاغة % فطالبه بالتسديد وسط المخاطب % 517(@)(@@) % أثبني ورفهني وأجزل مثوبتي % % وثابر على إدرار بري وواظب % 518(@)(@@) % لتأتيني جدواك وهي سليمة % من العيب ما فيها اعتلال لعائب % 519(@)(@@) % أثقل إدلالي لتحمل ثقله % % بطوع المراضي لا بكره المغاضب % 520(@)(@@) % وما طلب الرفد الهنيء ببدعة % ولا عجب المسترفديه بعاجب % PageV01P516 521(@)(@@) % وذاك مزيد في معاليك كله % وفي صدق هاتيك القوافي السوارب % 522(@)(@@) % وما حق باغيك المزيد انتقاصه % ولا سيما والمال جم الحلائب % 523(@)(@@) % وأنت الذي يضحى وأدنى عطائه % بلوغ الأماني بل قضاء المآرب % 524(@)(@@) % وتوزن بالأموال آمال وفده % وإرفاد قوم بالظنون الكواذب % 525(@)(@@) % أقمت لكي تزداد نعماك نعمة % وتغنى بوجه ناضر غير شاحب % 526(@)(@@) % وكي لا يقول القائلون أثابه % وعاقبه والقول جم المشاعب % 527(@)(@@) % وصوني عن التهجين عرفك موجب % مزيدك لي في الرفد يا ابن المرازب % 528(@)(@@) % بوجهك أضحى كل شيء منورا % وأبرز وجها ضاحكا غير قاطب % 529(@)(@@) % فلا تبتذله في المغاضب ظالما % فلم تؤت وجها مثله للمغاضب % 530(@)(@@) % نشرت على الدنيا شعاعا أضاءها % % وكانت ظلاما مدلهم الغياهبدع اللوم إن اللوم عون النوائب % % PageV01P517 531(@)(@@) % ولا 
ms136	 تتجاوز فيه حد المعاتب % فما كل من حط الرحال بمخفق % 532(@)(@@) % ولا كل من شد الرحال بكاسب % وفي السعي كيس والنفوس نفائس % 533(@)(@@) % وليس بكيس بيعها بالرغائب % وما زال مأمول البقاء مفضلا % 534(@)(@@) % على الملك والأرباح دون الحرائب % حضضت على حطبي لناري فلا تدع % 535(@)(@@) % لك الخير تحذيري شرور المحاطب % وأنكرت إشفاقي وليس بمانعي % % 536(@)(@@) % طلابي أن أبغي طلاب المكاسب % ومن يلق ما لاقيت في كل مجتنى % 537(@)(@@) % من الشوك يزهد في الثمار الأطايب % أذاقتني الأسفار ما كره الغنى % % 538(@)(@@) % إلي وأغراني برفض المطالب % فأصبحت في الإثراء أزهد زاهد % 539(@)(@@) % وإن كنت في الإثراء أرغب راغب % حريصا جبانا أشتهي ثم أنتهي % % 540(@)(@@) % بلحظي جناب الرزق لحظ المراقب % ومن راح ذا حرص وجبن فإنه % % PageV01P518 541(@)(@@) % فقير أتاه الفقر من كل جانب % ولما دعاني للمثوبة سيد % % 542(@)(@@) % يرى المدح عارا قبل بذل المثاوب % تنازعني رغب ورهب كلاهما % % 543(@)(@@) % قوي وأعياني اطلاع المغايب % فقدمت رجلا رغبة في رغيبة % 544(@)(@@) % وأخرت رجلا رهبة للمعاطب % أخاف على نفسي وأرجو مفازها % % 545(@)(@@) % وأستار غيب الله دون العواقب % ألا من يريني غايتي قبل مذهبي % % 546(@)(@@) % ومن أين والغايات بعد المذاهب % ومن نكبة لاقيتها بعد نكبة % 547(@)(@@) % رهبت اعتساف الأرض ذات المناكب % وصبري على الإقتار أيسر محملا % 548(@)(@@) % علي من التعرير بعد التجارب % لقيت من البر التباريح بعدما % % 549(@)(@@) % لقيت من البحر ابيضاض الذوائب % سقيت على ري به ألف مطرة % 550(@)(@@) % شغفت لبغضيها بحب المجادب % ولم أسقها بل ساقها لمكيدتي % % PageV01P519 551(@)(@@) % تحامق دهر جد بي كالملاعب % إلى الله أشكو سخف دهري فإنه % % 552(@)(@@) % يعابثني مذ كنت غير مطايب % أبى أن يغيث الأرض حتى إذا ارتمت % 553(@)(@@) % برحلي أتاها بالغيوث السواكب % % سقى الأرض من أجلي فأضحت مزلة % 554(@)(@@) % تمايل صاحيها تمايل شارب % لتعويق سيري أو دحوض مطيتي % % 555(@)(@@) % وإخصاب مزور عن المجد ناكب % فملت إلى خان مرث بناؤه % % 556(@)(@@) % مميل غريق الثوب لهفان لاغب % فلم ألق فيه م ستراحا لمتعب % % 557(@)(@@) % ولا نزلا أيان ذاك لساغب % فما زلت في 
ms137	 خوف وجوع ووحشة % 558(@)(@@) % وفي سهر يستغرق الليل واصب % يؤرقني سقف كأني تحته % % 559(@)(@@) % من الوكف تحت المدجنات الهواضب % تراه إذا ما الطين أثقل متنه % 560(@)(@@) % تصر نواحيه صرير الجنادب % وكم خان سفر خان فانقض فوقهم % % PageV01P520 561(@)(@@) % كما انقض صقر الدجن فوق الأرانب % ولم أنس ما لاقيت أيام صحوه % 562(@)(@@) % من الصر فيه والثلوج الأشاهب % وما زال ضاحي البر يضرب أهله % 563(@)(@@) % بسوطي عذاب جامد بعد ذائب % % فإن فاته قطر وثلج فإنه % % 564(@)(@@) % رهين بساف تارة أو بحاصب % فذاك بلاء البر عندي شاتيا % 565(@)(@@) % وكم لي من صيف به ذي مثالب % ألا رب نار بالفضاء اصطليتها % % 566(@)(@@) % من الضح يودي لفحها بالحواجب % إذا ظلت البيداء تطفو إكامها % % 567(@)(@@) % وترسب في غمر من الآل ناضب % فدع عنك ذكر البر إني رأيته % 568(@)(@@) % لمن خاف هول البحر شر المهاوب % كلا نزليه صيفه وشتاؤه % 569(@)(@@) % خلاف لما أهواه غير مصاقب % لهاث مميت تحت بيضاء سخنة % 570(@)(@@) % وري مفيت تحت أسحم صائب % يجف إذا ما أصبح الريق عاصبا % PageV01P521 571(@)(@@) % ويغدق لي والريق ليس بعاصب % ويمنع مني الماء واللوح جاهد % 572(@)(@@) % ويغرقني والري رطب المحالب % % وما زال يبغيني الحتوف مواربا % 573(@)(@@) % يحوم على قتلي وغير موارب % فطورا يغاديني بلص مصلت % 574(@)(@@) % وطورا يمسيني بورد الشوارب % إلى أن وقاني الله محذور شره % 575(@)(@@) % بعزته والله أغلب غالب % فأفلت من ذؤبانه وأسوده % 576(@)(@@) % وحرابه إفلات أتوب تائب % وأما بلاء البحر عندي فإنه % % 577(@)(@@) % طواني على روع مع الروح واقب % ولو ثاب عقلي لم أدع ذكر بعضه % 578(@)(@@) % ولكنه من هوله غير ثائب % % ولم لا ولو ألقيت فيه وصخرة % 579(@)(@@) % لوافيت منه القعر أول راسب % ولم أتعلم قط من ذي سباحة % 580(@)(@@) % سوى الغوص والمضعوف غير مغالب % فأيسر إشفاقي من الماء أنني % % PageV01P522 581(@)(@@) % أمر به في الكوز مر المجانب % وأخشى الردى منه على كل شارب % % 582(@)(@@) % فكيف بأمنيه على نفس راكب % أظل إذا هزته ريح ولألأت % 583(@)(@@) % له الشمس أمواجا طوال الغوارب % كأني أرى فيهن فرسان بهمة % 584 
ms138	(@)(@@) % يليحون نحوي بالسيوف القواضب % فإن قلت لي قد يركب اليم طاميا % 585(@)(@@) % ودجلة عند اليم بعض المذانب % فلا عذر فيها لامرىء هاب مثلها % % 586(@)(@@) % وفي اللجة الخضراء عذر لهائب % فإن احتجاجي عنك ليس بنائم % 587(@)(@@) % وإن بياني ليس عني بعازب % لدجلة خب ليس لليم إنها % % 588(@)(@@) % ترائي بحلم تحته جهل واثب % تطامن حتى تطمئن قلوبنا % % 589(@)(@@) % وتغضب من مزح الرياح اللواعب % وأجرافها رهن بكل خيانة % 590(@)(@@) % وغدر ففيها كل عيب لعائب % ترانا إذا هاجت بها الريح هيجة % PageV01P523 591(@)(@@) % نزلزل في حوماتها بالقوارب % نوائل من زلزالها نحو خسفها % % 592(@)(@@) % فلا خير في أوساطها والجوانب % % زلازل موج في غمار زواجر % 593(@)(@@) % وهدات خسف في شطوط خوارب % ولليم إعذار بعرض متونه % 594(@)(@@) % وما فيه من آذيه المتراكب % ولست تراه في الرياح مزلزلا % 595(@)(@@) % بما فيه إلا في الشداد الغوالب % % وإن خيف موج عيذ منه بساحل % 596(@)(@@) % خلي من الأجراف ذات الكباكب % ويلفظ ما فيه فليس معاجلا % 597(@)(@@) % غريقا بغت يزهق النفس كارب % يعلل غرقاه إلى أن يغيثهم % % 598(@)(@@) % بصنع لطيف منه خير مصاحب % فتلفى الدلافين الكريم طباعها % % 599(@)(@@) % هناك رعالا عند نكب النواكب % مراكب للقوم الذين كبا بهم % % 600(@)(@@) % فهم وسطه غرقى وهم في مراكب % وينقض ألواح السفين فكلها % % PageV01P524 601(@)(@@) % منج لدى نوب من الكسر نائب % وما أنا بالراضي عن البحر مركبا % 602(@)(@@) % ولكنني عارضت شغب المشاغب % صدقتك عن نفسي وأنت مراغمي % % 603(@)(@@) % وموضع سري دون أدنى الأقارب % وجربت حتى ما أرى الدهر مغربا % 604(@)(@@) % علي بشيء لم يقع في تجاربي % % أرى المرء مذ يلقى التراب بوجهه % 605(@)(@@) % إلى أن يوارى فيه رهن النوائب % ولو لم يصب إلا بشرخ شبابه % 606(@)(@@) % لكان قد استوفى جميع المصائب % ومن صدق الأخيار داووا سقامه % 607(@)(@@) % بصحة آراء ويمن نقائب % وما زال صدق المستشير معاونا % 608(@)(@@) % على الرأي لب المستشار المحازب % وأبعد أدواء الرجال ذوي الضنى % % 609(@)(@@) % من البرء داء المستطب المكاذب % فلا تنصبن الحرب لي بملامتي % % 610(@)(@@) % وأنت سلاحي في حروب النوائب % وأجدى من التعنيف حسن 
ms139	 معونة % PageV01P525 611(@)(@@) % برأي ولين من خطاب المخاطب % وفي النصح خير من نصيح موادع % 612(@)(@@) % ولا خير فيه من نصيح مواثب % ومثلي محتاج إلى ذي سماحة % 613(@)(@@) % كريم السجايا أريحي الضرائب % يلين على أهل التسحب مسه % 614(@)(@@) % ويغضي لهم عند اقتراح الغرائب % له نائل ما زال طالب طالب % 615(@)(@@) % ومرتاد مرتاد وخاطب خاطب % ألا ماجد الأخلاق حر فعاله % 616(@)(@@) % تباري عطاياه عطايا السحائب % كمثل أبي العباس إن نواله % 617(@)(@@) % نوال الحيا يسعى إلى كل طالب % يسير نحوي عرفه فيزورني % % 618(@)(@@) % هنيئا ولم أركب صعاب المراكب % يسير إلى ممتاحه فيجوده % 619(@)(@@) % ويكفي أخا الإمحال زم الركائب % ومن يك مثلا للحيا في علوه % 620(@)(@@) % يكن مثله في جوده بالمواهب % وإن نفاري منه وهو يريغني % % PageV01P526 621(@)(@@) % لشيء لرأي فيه غير مناسب % وإن قعودي عنه خيفة نكبة % 622(@)(@@) % للؤم مهز وانثناء مضارب % أقر على نفسي بعيبي لأنني % % 623(@)(@@) % أرى الصدق يمحو بينات المعايب % لؤمت لعمر الله فيما أتيته % % 624(@)(@@) % وإن كنت من قوم كرام المناصب % لهم حلم إنس في عرامة جنة % 625(@)(@@) % وبأس أسود في دهاء ثعالب % يصولون بالأيدي إذا الحرب أعملت % 626(@)(@@) % سيوف سريج بعد أرماح زاعب % ولا بد من أن يلؤم المرء نازعا % 627(@)(@@) % إلى الحمأ المسنون ضربة لازب % فقل لأبي العباس لقيت وجهه % 628(@)(@@) % وحسبك مني تلك دعوة صاحب % أما حق حامي عرض مثلك أن يرى % % 629(@)(@@) % له الرفد والترفيه أوجب واجب % أمن بعد ما لم ترع للمال حرمة % 630(@)(@@) % وأسلمته للجود غير مجاذب % فأعطيت ذا سلم وحرب ووصلة % PageV01P527 631(@)(@@) % وذنب عطايا أدركت كل هارب % ولم تشخص العافين لكن أتتهم % 632(@)(@@) % لهاك جليبات لأكرم جالب % علما بأن الظعن فيه مشقة % 633(@)(@@) % وأن أمر الربح ربح الجلائب % تكلفني هول السفار وغوله % 634(@)(@@) % رفيق شتاء مقفعل الرواجب % ولا سيما حين ارتدى الماء كبره % 635(@)(@@) % وشاغب أنفاس الصبا والجنائب % وهرت على مستطرقي البر قرة % 636(@)(@@) % يمس أذاها دون لوث العصائب % كأن تمام الود والمدح كله % 637(@)(@@) % هوي الفتى في البحر أو في السباسب % لعمري لئن 
ms140	 حاسبتني في مثوبتي % % 638(@)(@@) % بخفضي لقد أجريت عادة حاسب % حنانيك قد أيقنت أنك كاتب % 639(@)(@@) % له رتبة تعلو به كل كاتب % فدعني من حكم الكنابة إنه % 640(@)(@@) % عدو لحكم الشعر غير مقارب % وإلا فلم يستعمل العدل جاعل % PageV01P528 641(@)(@@) % أجد مجد قرن ألعب لاعب % أيعزب عنك الرأي في أن تثيبني % % 642(@)(@@) % مقيما مصونا عن عناء المطالب % فتلفى وألفى بين صافي صنيعة % 643(@)(@@) % وصافي ثناء لم يشب بالمعاتب % وتخرج من أحكام قوم تشددوا % % 644(@)(@@) % فقد جعلوا آلاءهم كالمصائب % أيذهب هذا عنك يا ابن محمد % 645(@)(@@) % وأنت معاذ في الأمور الحوازب % لك الرأي والجود اللذان كلاهما % % 646(@)(@@) % زعيم بكشف المطبقات الكوارب % وما زلت ذا ضوء ونوء لمجدب % 647(@)(@@) % وحيران حتى قيل بعض الكواكب % % تغيث وتهدي عند جدب وحيرة % 648(@)(@@) % بمحتفل ثر وأزهر ثاقب % وأحسن عرف موقعا ما تناله % 649(@)(@@) % يدي وغرابي بالنوى غير ناعب % أراك متى ثوبتني في رفاهة % 650(@)(@@) % زففت إلي الملك بين الكتائب % وأنت متى ثوبتني في مشقة % % PageV01P529 651(@)(@@) % رأيتك في شخص المثيب المعاقب % ولو لم يكن في العرف صاف مهنأ % 652(@)(@@) % وذو كدر والعرف شتى المشارب % إذا لم يقل أعلى النوابغ رتبة % 653(@)(@@) % لمقول غسان الملوك الأشايب % علي لعمرو نعمة بعد نعمة % 654(@)(@@) % لوالده ليست بذات عقارب % وما عقرب أدهى من البين إنه % % 655(@)(@@) % له لسعة بين الحشا والترائب % ومن أجل ما راعى من البين قوله % % 656(@)(@@) % كليني لهم يا أميمة ناصب % أبيت سوى تكليفك العرف معفيا % 657(@)(@@) % به صافيا من مؤذيات الشوائب % بل المجد يأبى غير سومك نفسه % 658(@)(@@) % ورفعك عن طود المنيل المحاسب % فصبرا على تحميلك الثقل كله % 659(@)(@@) % وإن عز تحميل القروم المصاعب % ولا يعجبن الناس من سعي متعب % 660(@)(@@) % مشيح لجدوى مستريح مداعب % فمن ساد قوما أوجب الطول أن يرى % % PageV01P530 661(@)(@@) % مجدا لأدناهم وهم في الملاعب % ومن لم يزل في مصعد المجد راقيا % 662(@)(@@) % صعاب المراقي نال عليا المراتب % ألم ترني أتعبت فكري محككا % 663(@)(@@) % لك الشعر كي لا أبتلى بالمتاعب % نحلتك حليا من مديح كأنه 