ms101	 شهرآشوب 3: 331.(@)(@@) (١) الرياض النضرة ٢: ٢١٣، كنز العمال ٦: ٤٠٢.(@)(@@) (٢) مجمع الزوائد ٩: ١١٠ وفيه: ولا سألت الله عز وجل شيئا إلا أعطانيه غير أنه قيل لي لا نبي بعدك.(@)(@@) (٣) الصحيح: ناجية بن كعب الأسدي ابن خفاف العنزي الكوفي.(@)(@@) تهذيب التهذيب ١٠: ٣٩٩، تقريب التهذيب ٢: ٢٩٤، أسد الغابة ٥: ٦، تجريد أسماء الصحابة 2: 109.(@)(١، ٢) المحلى ٥: ١١٧، فتح القدير ١: ٤٦٧، شرح كنز الدقائق ١: ٦٨ الهداية 1: 65. وقد مرت الإشارة في المقدمة ص 35 - 39 أن في الحديث سقط وتصحيف وذكرنا صحيحه وأنه هكذا: حدثني معاوية بن عبد الله بن عبيد الله ابن أبي رافع، عن أبيه، عن جده، عن علي رضي الله عنه قال: لما أخبرت رسول الله صلى الله عليه وآله بموت أبي طالب بكى ثم قال لي: اذهب فاغسله وكفنه وواره قال ففعلت ثم أتيته فقال لي: اذهب فاغتسل، قال: وجعل رسول الله صلى الله عليه وآله يستغفر له أياما ولا يخرج من بيته.(@)(@@) وفي رواية أخرى: قال: اذهب فوار أباك ثم لا تحدث شيئا حتى تأتيني فذهبت فواريته وجئته فأمرني فاغتسلت ودعا لي. راجع المقدمة فصل وقفة مع النسائي ص 35 - 39.(@)(@@) (١) مجمع الزوائد ٩: ١٢٢ وقال: رواه الطبراني في الأوسط وإسناده حسن، كنوز الحقايق: ٢٥، الرياض النضرة ٢: ١٨٩، فيه: قال علي: ما رمدت عيناي منذ مسح رسول الله صلى الله عليه وسلم وجهي.(@)(@@) (٢) سورة المجادلة: ١٢.(@)(@@) (١) سورة المجادلة: ١٣.(@)(@@) (٢) صحيح الترمذي ٢: ٢٢٧، تفسير الطبري ٢٨: ١٥، كنز العمال ١: ٢٦٨، ذخائر العقبى: ١٠٩ وقال: أخرجه أبو حاتم، أسباب النزول: 308، الرياض النضرة 2: 200.(@)(@@) (3) غزوة العشيرة هي الغزوة الثانية من غزواته صلى الله عليه وآله، سيرة ابن هشام 2: 248.(@)(@@) (١) المناقب لابن شهرآشوب ٣: ٣٠٩، مسند أحمد ٤: ٢٦٢، الرياض النضرة ٢: ٢٢٣، مجمع الزوائد ٩: ١٣٧، كنز العمال ٦: ٣٩٩، وهناك في كتب الحديث والفضائل أخبار كثيرة في أخبار النبي صلى الله عليه وآله عن قتل علي (ع)، المستدرك ٣: ١٤٠، مشكل الآثار ١: ٣٥١، تاريخ الطبري ٢: ١٢٣، وأخرجه البغوي والطبراني وابن مردويه وأبو نعيم وابن عساكر وابن النجار، سيرة ابن هشام ٢: ٢٤٩.(@)(@@) (٢) المستدرك ٣: ١٣٨.(@)(@@) (١) الإصابة ٨: ١٨٣، مسند أحمد ٦: ٣٠٠، ورواه غير واحد من أئمة الحديث، مستدرك الصحيحين ٣: ١٣٨ وفيه: روى بسنده عن أبي موسى عن أم سلمة الحديث.(@)(@@) وفي الإصابة ٨: ١٨٣ جاء الحديث بلفظ آخر 
ms102	 وذلك في ترجمة ليلى الغفارية التي خرجت مع النبي صلى الله عليه وآله فكانت تداوي الجرحى والمرضى.(@)(@@) (٢) المستدرك ٣: ١٢٢ وفيه: هذا حديث صحيح على شرط الشيخين.(@)(@@) وقد جاء الحديث في كافة المصادر النبوية منها: مسند أحمد ٣: ٣٣، حلية الأولياء ١: ٦٧، أسد الغابة ٣: ٢٨٢، الإصابة ١: ٢٢، الاستيعاب ٢: ٤٢٣، كنز العمال ٦: ١٥٥، مجمع الزوائد ٥: ١٨٦.(@)(@@) (١) مرت الإشارة إلى مصادر الحديث.(@)(@@) (٢) المستدرك ٢: ١٤٨، المطالعات في مختلف المؤلفات ٢: ١٩٣ - ٢١٠ وفيه سلسلة الرواة من الصحابة لهذا الحديث مع مصادرها وصورها المختلفة، الغدير ٩: ٢٠ - ٢٣.(@)(@@) (٣) الحافظ أبو معاوية يزيد بن زريع التميمي البصري المتوفى ١٨٣.(@)(@@) تهذيب التهذيب ١١: ٣٢٥ تذكرة الحفاظ ١: ٢٥٦، رجال الصحيحين 2: 573 شذرات الذهب 1: 298.(@)(@@) (١) المسند لأحمد بن حنبل ٦: ٢٨٩، مسند أبو داود ٣: ٩٠ وفيه: قال النبي صلى الله عليه وآله: ويحك يا ابن سمية تقتلك الفئة الباغية.(@)(@@) (٢) حلية الأولياء ٤: ١٧٢، تاريخ بغداد ١٣: ١٨٦.(@)(@@) (٣) كنز العمال ٧: ٧٢ وفيه: فجعل يمسح التراب عن رأس عمار ومنكبه ويقول: الحديث.(@)(@@) (4) في رواية: بينما أنا عند معاوية.(@)(@@) (١) مسند أحمد ٢: ١٦٤ وفيه: بعد تمام الحديث هكذا: قال معاوية:(@)(@@) فما بالك معنا؟ قال: إن أبي شكاني إلى رسول الله صلى الله عليه وآله فقال: أطع أباك ما دام حيا ولا تعصه، فأنا معكم ولست أقاتل.(@)(@@) (٢) تاريخ بغداد ٧: ٤١٤.(@)(@@) (٣) كنز العمال ٧: ٧٢، الإصابة ١ ق ٤: ١٢٥، أسد الغابة ٢: ٢١٧، الرياض النضرة 1: 14.(@)(@@) (١) الإمامة والسياسة ٢: ١٠٦، نور الأبصار: ٨٩، مجمع الزوائد ٩: ٢٩٦، حلية الأولياء ٤: ٢٠، ميزان الاعتدال ٣: ٣١١، واسم أم عمار سمية بنت مسلم ابن لخم الخياط، أعلام النساء ٢: ٢٦١، أسد الغابة ٥: ٤٨١، الدر المنثور: ٢٥٢ تاريخ اليعقوبي ٢: ١٦٤ وفيه: ولما قتل عمار بن ياسر واشتدت الحرب في تلك العشية ونادى الناس: قتل صاحب رسول الله وقد قال رسول الله صلى الله عليه وآله: تقتل عمار الفئة الباغية.(@)(@@) (٢) مسند أبو داود: ٢٩، مسند أحمد ٣: ٢٦، ٣٢، ٤٥، ٤٨، ٧٠، ٨٢، ٩٥.(@)(@@) (٣) مسند أحمد ٣: ٥٦، تفسير الطبري ١٠: ١٠٩، البداية والنهاية ٧: ٢٧٨ وفيه: وهذا الحديث له طرق متعددة وألفاظ كثيرة.(@)(@@) (١) ميزان الاعتدال ٢: ٢٦٣.(@)(@@) (٢ - ٣) المستدرك ٢: ١٤٥، سنن البيهقي