ms1001	 ليث بن أبي سليم، عن بشر، عن أنس، نحوه ولم يرفعه (@)(@) (@)(@@)(@@)(@@) ||| ٣١٢٧ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا أحمد بن أبي الطيب قال: حدثنا مصعب بن سلام، عن عمرو بن قيس، عن عطية، عن أبي سعيد الخدري، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اتقوا فراسة المؤمن فإنه ينظر بنور الله» ، (@)(@@) ثم قرأ: @QB@ {إن في ذلك لآيات للمتوسمين} @QE@ [الحجر: ٧٥] : (@)(@@) @MATN@ " هذا حديث غريب، إنما نعرفه من هذا الوجه وقد روي عن بعض أهل العلم في تفسير هذه الآية: @QB@ {إن في ذلك لآيات للمتوسمين} @QE@ [الحجر: ٧٥] قال: للمتفرسين " (@)PageV05P298 (@)(@) (@)(@@) باب: ومن سورة النحل (@)(@) (@)(@@)(@@)(@@) ||| ٣١٢٨ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا علي بن عاصم، عن يحيى البكاء قال: حدثني عبد الله بن عمر، قال: سمعت عمر بن الخطاب، يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أربع قبل الظهر بعد الزوال تحسب بمثلهن في صلاة السحر» ، (@)(@@) قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «وليس من شيء إلا وهو يسبح الله تلك الساعة» ، (@)(@@) ثم قرأ @QB@ {يتفيأ ظلاله عن اليمين والشمائل سجدا لله} @QE@ [النحل: ٤٨] الآية كلها. (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث علي بن عاصم» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٢٩ - (@)(@@) حدثنا أبو عمار قال: حدثنا الفضل بن موسى، عن عيسى بن عبيد، عن الربيع بن أنس، عن أبي العالية، قال: حدثني أبي بن كعب، قال: لما كان يوم أحد أصيب من الأنصار أربعة وستون رجلا، ومن المهاجرين ستة منهم حمزة، فمثلوا بهم، فقالت الأنصار: لئن أصبنا منهم يوما مثل هذا لنربين عليهم قال: فلما كان يوم فتح مكة، فأنزل الله تعالى @QB@ {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير للصابرين} @QE@ [النحل: ١٢٦] PageV05P299 فقال رجل: لا قريش بعد اليوم، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «كفوا عن القوم إلا أربعة» . (@)(@@) @MATN@ «هذا حديث حسن غريب من حديث أبي بن كعب» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة بني إسرائيل (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٠ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن الزهري قال: أخبرني سعيد بن المسيب، عن أبي هريرة، 
ms1002	 قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «حين أسري بي لقيت موسى - قال فنعته - فإذا رجل - حسبته قال - مضطرب رجل الرأس، كأنه من رجال شنوءة» . (@)(@@) قال: (@)(@@) @MATN@ «ولقيت عيسى» - (@)(@@) قال فنعته - قال: (@)(@@) @MATN@ «ربعة أحمر كأنما خرج من ديماس - يعني الحمام - ورأيت إبراهيم» ، (@)(@@) قال: (@)(@@) @MATN@ «وأنا أشبه ولده به» . (@)(@@) قال: (@)(@@) @MATN@ " وأتيت بإناءين أحدهما لبن والآخر فيه خمر، فقيل لي: خذ أيهما شئت، فأخذت اللبن فشربته، فقيل لي: هديت للفطرة - أو أصبت الفطرة - أما إنك لو أخذت الخمر غوت أمتك " : PageV05P300 (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣١ - (@)(@@) حدثنا إسحاق بن منصور قال: أخبرنا عبد الرزاق قال: أخبرنا معمر، عن قتادة، عن أنس (@)(@@) @MATN@ " أن النبي صلى الله عليه وسلم أتي بالبراق ليلة أسري به ملجما مسرجا، فاستصعب عليه، فقال له جبريل: أبمحمد تفعل هذا؟ فما ركبك أحد أكرم على الله منه " ، قال: (@)(@@) @MATN@ «فارفض عرقا» : (@)(@@) @MATN@ «هذا حديث حسن غريب، ولا نعرفه إلا من حديث عبد الرزاق» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٢ - (@)(@@) حدثنا يعقوب بن إبراهيم الدورقي قال: حدثنا أبو تميلة، عن الزبير بن جنادة، عن ابن بريدة، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لما انتهينا إلى بيت المقدس قال جبريل بإصبعه، فخرق به الحجر، وشد به البراق» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٣ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن عقيل، عن الزهري، عن أبي سلمة، عن جابر بن عبد الله، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لما كذبتني قريش قمت في الحجر فجلى الله لي بيت المقدس، فطفقت أخبرهم عن آياته وأنا أنظر إليه» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وفي الباب عن مالك بن صعصعة، وأبي سعيد، وابن عباس، وأبي ذر، وابن مسعود (@)PageV05P301 (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٤ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عمرو بن دينار، عن عكرمة، عن ابن عباس، في قوله تعالى: @QB@ {وما جعلنا الرؤيا التي أريناك إلا فتنة للناس} @QE@ [الإسراء: ٦٠] قال: (@)(@@) @MATN@ «هي رؤيا عين أريها النبي صلى الله عليه وسلم ليلة أسري به إلى بيت المقدس» . (@)(@@) قال: @QB@ {والشجرة الملعونة في القرآن} @QE@ [الإسراء: ٦٠] (@)(@@) @MATN@ «هي شجرة الزقوم» . (@)(@@) @MATN@ «هذا 
ms1003	 حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٥ - (@)(@@) حدثنا عبيد بن أسباط بن محمد قرشي كوفي قال: حدثنا أبي، عن الأعمش، عن أبي صالح، عن أبي هريرة، عن النبي صلى الله عليه وسلم في قوله تعالى: @QB@ {وقرآن الفجر إن قرآن الفجر كان مشهودا} @QE@ [الإسراء: ٧٨] قال: (@)(@@) @MATN@ «تشهده ملائكة الليل وملائكة النهار» . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وروى علي بن مسهر، عن الأعمش، عن أبي صالح، عن أبي هريرة، وأبي سعيد، عن النبي صلى الله عليه وسلم نحوه. حدثنا بذلك علي بن حجر قال: حدثنا علي بن مسهر، عن الأعمش، فذكر نحوه (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٦ - (@)(@@) حدثنا عبد الله بن عبد الرحمن قال: أخبرنا عبيد الله بن موسى، عن إسرائيل، عن السدي، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم في قول الله: @QB@ {يوم ندعو كل أناس بإمامهم} @QE@ [الإسراء: ٧١] قال: (@)(@@) @MATN@ " يدعى أحدهم فيعطى كتابه بيمينه، ويمد له في جسمه ستون ذراعا، ويبيض وجهه، ويجعل على رأسه تاج من لؤلؤ يتلألأ، فينطلق إلى أصحابه فيرونه من بعد فيقولون: اللهم ائتنا بهذا وبارك لنا في هذا، حتى يأتيهم فيقول لهم: أبشروا لكل رجل منكم مثل هذا، " قال: (@)(@@) @MATN@ " وأما الكافر فيسود وجهه PageV05P302 ويمد له في جسمه ستون ذراعا على صورة آدم فيلبس تاجا، فيراه أصحابه فيقولون: نعوذ بالله من شر هذا، اللهم لا تأتنا بهذا " ، قال: (@)(@@) @MATN@ " فيأتيهم فيقولون: اللهم أخزه، فيقول: أبعدكم الله فإن لكل رجل منكم مثل هذا " : (@)(@@) @MATN@ " هذا حديث حسن غريب، والسدي اسمه: إسماعيل بن عبد الرحمن " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٧ - (@)(@@) حدثنا أبو كريب قال: حدثنا وكيع، عن داود بن يزيد الزعافري، عن أبيه، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم في قوله: @QB@ {عسى أن يبعثك ربك مقاما محمودا} @QE@ [الإسراء: ٧٩] وسئل عنها قال: (@)(@@) @MATN@ «هي الشفاعة» : (@)(@@) @MATN@ " هذا حديث حسن، وداود الزعافري هو: داود الأودي بن يزيد بن عبد الرحمن وهو عم عبد الله بن إدريس " (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٨ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن ابن أبي نجيح، عن مجاهد، عن أبي معمر، عن ابن مسعود، قال: دخل رسول 
ms1004	 الله صلى الله عليه وسلم مكة عام الفتح وحول الكعبة ثلاث مائة وستون نصبا، فجعل النبي صلى الله عليه وسلم يطعنها بمخصرة في يده - وربما قال بعود - ويقول: (@)(@@) @MATN@ " @QB@ {جاء الحق وزهق} @QE@ [الإسراء: ٨١] الباطل إن الباطل كان زهوقا @QB@ {جاء الحق وما يبدئ الباطل وما يعيد} @QE@ [سبأ: ٤٩] (@)(@@) @MATN@ «.» (@)(@@) هذا حديث حسن صحيح " وفيه عن ابن عمر (@)PageV05P303 (@)(@) (@)(@@)(@@)(@@) ||| ٣١٣٩ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا جرير، عن قابوس بن أبي ظبيان، عن أبيه، عن ابن عباس، قال: (@)(@@) @MATN@ " كان النبي صلى الله عليه وسلم بمكة ثم أمر بالهجرة فنزلت عليه @QB@ {وقل رب أدخلني مدخل صدق وأخرجني مخرج صدق واجعل لي من لدنك سلطانا نصيرا} @QE@ [الإسراء: ٨٠] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٠ - (@)(@@) حدثنا قتيبة قال: حدثنا يحيى بن زكريا بن أبي زائدة، عن داود بن أبي هند، عن عكرمة، عن ابن عباس، قال: قالت قريش ليهود: أعطونا شيئا نسأل هذا الرجل، فقال: سلوه عن الروح، فسألوه عن الروح، فأنزل الله تعالى @QB@ {ويسألونك عن الروح قل الروح من أمر ربي وما أوتيتم من العلم إلا قليلا} @QE@ [الإسراء: ٨٥] ، قالوا: أوتينا علما كثيرا أوتينا التوراة، ومن أوتي التوراة فقد أوتي خيرا كثيرا، فأنزلت @QB@ {قل لو كان البحر مدادا لكلمات ربي لنفد البحر} @QE@ [الكهف: ١٠٩] إلى آخر الآية. هذا حديث حسن صحيح غريب من هذا الوجه (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤١ - (@)(@@) حدثنا علي بن خشرم قال: أخبرنا عيسى بن يونس، عن الأعمش، عن إبراهيم، عن علقمة، عن عبد الله، قال: كنت أمشي مع النبي صلى الله عليه وسلم في حرث بالمدينة وهو يتوكأ على عسيب فمر بنفر من اليهود، فقال بعضهم: لو سألتموه، فقال بعضهم: لا تسألوه فإنه يسمعكم ما تكرهون، فقالوا له: يا أبا القاسم حدثنا عن الروح، فقام النبي صلى الله عليه وسلم ساعة ورفع رأسه إلى السماء فعرفت أنه يوحى إليه حتى PageV05P304 صعد الوحي، ثم قال: (@)(@@) @MATN@ " @QB@ {الروح من أمر ربي وما أوتيتم من العلم إلا قليلا} @QE@ [الإسراء: ٨٥] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٢ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا الحسن بن موسى، وسليمان بن حرب، 
ms1005	 قالا: حدثنا حماد بن سلمة، عن علي بن زيد، عن أوس بن خالد، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " يحشر الناس يوم القيامة ثلاثة أصناف: صنفا مشاة، وصنفا ركبانا، وصنفا على وجوههم " ، قيل: يا رسول الله، وكيف يمشون على وجوههم؟ قال: (@)(@@) @MATN@ «إن الذي أمشاهم على أقدامهم قادر على أن يمشيهم على وجوههم، أما إنهم يتقون بوجوههم كل حدب وشوك» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد روى وهيب، عن ابن طاوس، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم شيئا من هذا (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٣ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا يزيد بن هارون قال: أخبرنا بهز بن حكيم، عن أبيه، عن جده، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إنكم محشورون رجالا وركبانا وتجرون على وجوهكم» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٤ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود، ويزيد بن هارون، وأبو الوليد - واللفظ لفظ يزيد والمعنى واحد -، عن شعبة، عن عمرو PageV05P305 بن مرة، عن عبد الله بن سلمة، عن صفوان بن عسال، أن يهوديين قال أحدهما لصاحبه: اذهب بنا إلى هذا النبي نسأله، فقال: لا تقل له نبي فإنه إن سمعها تقول نبي كانت له أربعة أعين، فأتيا النبي صلى الله عليه وسلم فسألاه عن قول الله عز وجل @QB@ {ولقد آتينا موسى تسع آيات بينات} @QE@ [الإسراء: ١٠١] فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لا تشركوا بالله شيئا، ولا تزنوا، ولا تقتلوا النفس التي حرم الله إلا بالحق، ولا تسرقوا، ولا تسحروا، ولا تمشوا ببريء إلى سلطان فيقتله، ولا تأكلوا الربا، ولا تقذفوا محصنة، ولا تفروا من الزحف، - شك شعبة -، وعليكم اليهود خاصة ألا تعتدوا في السبت» (@)(@@) فقبلا يديه ورجليه وقالا: نشهد أنك نبي، قال: (@)(@@) @MATN@ «فما يمنعكما أن تسلما» ؟ (@)(@@) قالا: إن داود دعا الله، أن لا يزال في ذريته نبي، وإنا نخاف إن أسلمنا أن تقتلنا اليهود: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٥ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا سليمان بن داود، عن شعبة، عن أبي 
ms1006	 بشر، عن سعيد بن جبير، ولم يذكر عن ابن عباس، وهشيم، عن أبي بشر، عن سعيد بن جبير، عن ابن عباس، @QB@ {ولا تجهر بصلاتك ولا تخافت} @QE@ [الإسراء: ١١٠] بها قال: (@)(@@) @MATN@ " نزلت بمكة كان رسول الله صلى الله عليه وسلم إذا رفع صوته بالقرآن سبه المشركون ومن أنزله ومن جاء به، فأنزل الله @QB@ {ولا تجهر بصلاتك} @QE@ [الإسراء: ١١٠] فيسب القرآن ومن أنزله ومن جاء به @QB@ {ولا تخافت بها} @QE@ [الإسراء: ١١٠] عن أصحابك بأن تسمعهم حتى يأخذوا عنك القرآن " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P306 (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٦ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا هشيم قال: حدثنا أبو بشر، عن سعيد بن جبير، عن ابن عباس، في قوله: @QB@ {ولا تجهر بصلاتك ولا تخافت بها وابتغ بين ذلك سبيلا} @QE@ [الإسراء: ١١٠] قال: (@)(@@) @MATN@ " نزلت ورسول الله صلى الله عليه وسلم مختف بمكة، فكان إذا صلى بأصحابه رفع صوته بالقرآن، فكان المشركون إذا سمعوه شتموا القرآن ومن أنزله ومن جاء به، فقال الله لنبيه: @QB@ {ولا تجهر بصلاتك} @QE@ [الإسراء: ١١٠] أي بقراءتك، فيسمع المشركون فيسب القرآن، @QB@ {ولا تخافت بها} @QE@ [الإسراء: ١١٠] عن أصحابك @QB@ {وابتغ بين ذلك سبيلا} @QE@ [الإسراء: ١١٠] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٧ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن مسعر، عن عاصم بن أبي النجود، عن زر بن حبيش، قال: قلت لحذيفة بن اليمان: أصلى رسول الله صلى الله عليه وسلم في بيت المقدس؟ قال: لا، قلت: بلى، قال: أنت تقول ذاك يا أصلع، بم تقول ذلك؟ قلت: بالقرآن. بيني وبينك القرآن، فقال حذيفة: من احتج بالقرآن فقد أفلح. - قال سفيان: يقول فقد احتج، وربما قال: قد فلج - فقال: @QB@ {سبحان الذي أسرى بعبده ليلا من المسجد الحرام إلى المسجد الأقصى} @QE@ [الإسراء: ١] قال: أفتراه صلى فيه؟ قلت: لا، قال: (@)(@@) @MATN@ «لو صلى فيه لكتب عليكم فيه الصلاة كما كتبت الصلاة في المسجد الحرام» (@)(@@) قال حذيفة: (@)(@@) @MATN@ «قد أتي رسول الله صلى الله عليه وسلم بدابة طويلة الظهر، ممدودة. هكذا خطوه مد بصره، فما زايلا ظهر البراق حتى رأيا الجنة والنار ووعد الآخرة أجمع، ثم رجعا عودهما على 
ms1007	 بدئهما» . (@)(@@) قال: ويتحدثون أنه ربطه، لم؟ ليفر منه وإنما سخره له عالم الغيب والشهادة: PageV05P307 (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٨ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن علي بن زيد بن جدعان، عن أبي نضرة، عن أبي سعيد، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أنا سيد ولد آدم يوم القيامة ولا فخر، وبيدي لواء الحمد ولا فخر، وما من نبي يومئذ آدم فمن سواه إلا تحت لوائي، وأنا أول من تنشق عنه الأرض ولا فخر» ، (@)(@@) قال: (@)(@@) @MATN@ " فيفزع الناس ثلاث فزعات، فيأتون آدم، فيقولون: أنت أبونا آدم فاشفع لنا إلى ربك، فيقول: إني أذنبت ذنبا أهبطت منه إلى الأرض ولكن ائتوا نوحا، فيأتون نوحا، فيقول: إني دعوت على أهل الأرض دعوة فأهلكوا، ولكن اذهبوا إلى إبراهيم، فيأتون إبراهيم فيقول: إني كذبت ثلاث كذبات " ، ثم قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " ما منها كذبة إلا ما حل بها عن دين الله. ولكن ائتوا موسى، فيأتون موسى، فيقول: إني قد قتلت نفسا، ولكن ائتوا عيسى، فيأتون عيسى، فيقول: إني عبدت من دون الله، ولكن ائتوا محمدا " ، قال: (@)(@@) @MATN@ «فيأتونني فأنطلق معهم» - (@)(@@) قال ابن جدعان: قال أنس: فكأني أنظر إلى رسول الله صلى الله عليه وسلم - قال: (@)(@@) @MATN@ " فآخذ بحلقة باب الجنة فأقعقعها فيقال: من هذا؟ فيقال: محمد فيفتحون لي، ويرحبون بي، فيقولون: مرحبا، فأخر ساجدا، فيلهمني الله من الثناء والحمد، فيقال لي: ارفع رأسك وسل تعط، واشفع تشفع، وقل يسمع PageV05P308 لقولك، وهو المقام المحمود الذي قال الله @QB@ {عسى أن يبعثك ربك مقاما محمودا} @QE@ [الإسراء: ٧٩] " قال سفيان: ليس عن أنس، إلا هذه الكلمة. (@)(@@) @MATN@ «فآخذ بحلقة باب الجنة فأقعقعها» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد روى بعضهم هذا الحديث عن أبي نضرة، عن ابن عباس، الحديث بطوله (@) (@)(@) (@)(@@) باب: ومن سورة الكهف (@)(@) (@)(@@)(@@)(@@) ||| ٣١٤٩ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عمرو بن دينار، عن سعيد بن جبير، قال: قلت لابن عباس: إن نوفا البكالي يزعم أن موسى صاحب بني إسرائيل ليس بموسى صاحب الخضر، قال: كذب 
ms1008	 عدو الله، سمعت أبي بن كعب، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ " قام موسى خطيبا في بني إسرائيل، فسئل: أي الناس أعلم؟ فقال: أنا أعلم، فعتب الله عليه إذ لم يرد العلم إليه، فأوحى الله إليه أن عبدا من عبادي بمجمع البحرين هو أعلم منك، قال: أي رب، فكيف لي به؟ فقال له: احمل حوتا في مكتل فحيث تفقد الحوت فهو ثم، فانطلق وانطلق معه فتاه وهو يوشع بن نون فجعل موسى حوتا في مكتل، فانطلق هو وفتاه يمشيان حتى إذا أتيا الصخرة، فرقد موسى وفتاه فاضطرب الحوت في المكتل حتى PageV05P309 خرج من المكتل فسقط في البحر " ، قال: (@)(@@) @MATN@ " وأمسك الله عنه جرية الماء، حتى كان مثل الطاق وكان للحوت سربا. وكان لموسى ولفتاه عجبا، فانطلقا بقية يومهما وليلتهما ونسي صاحب موسى أن يخبره، فلما أصبح موسى @QB@ {قال لفتاه آتنا غداءنا لقد لقينا من سفرنا هذا نصبا} @QE@ [الكهف: ٦٢] " قال: (@)(@@) @MATN@ " ولم ينصب حتى جاوز المكان الذي أمر به @QB@ {قال أرأيت إذ أوينا إلى الصخرة فإني نسيت الحوت وما أنسانيه إلا الشيطان أن أذكره واتخذ سبيله في البحر عجبا قال} @QE@ [الكهف: ٦٤] موسى @QB@ {ذلك ما كنا نبغ فارتدا على آثارهما قصصا} @QE@ [الكهف: ٦٤] " قال: (@)(@@) @MATN@ «فكانا يقصان آثارهما» - (@)(@@) قال سفيان: يزعم ناس أن تلك الصخرة عندها عين الحياة ولا يصيب ماؤها ميتا إلا عاش - قال: (@)(@@) @MATN@ «وكان الحوت قد أكل منه، فلما قطر عليه الماء عاش» ، (@)(@@) قال: (@)(@@) @MATN@ " فقصا آثارهما حتى أتيا الصخرة، فرأى رجلا مسجى عليه بثوب، فسلم عليه موسى، فقال: أنى بأرضك السلام؟ قال: أنا موسى، قال: موسى بني إسرائيل؟ قال: نعم، قال: يا موسى إنك على علم من علم الله علمكه الله لا أعلمه، وأنا على علم من علم الله علمنيه لا تعلمه، فقال موسى: @QB@ {هل أتبعك على أن تعلمن مما علمت رشدا قال إنك لن تستطيع معي صبرا وكيف تصبر على ما لم تحط به خبرا قال ستجدني إن شاء الله صابرا ولا أعصي لك أمرا} @QE@ [الكهف: ٦٦] قال له الخضر: @QB@ {فإن 
ms1009	 اتبعتني فلا تسألني عن شيء حتى أحدث لك منه PageV05P310 ذكرا} @QE@ [الكهف: ٧٠] قال: نعم، فانطلق الخضر وموسى يمشيان على ساحل البحر، فمرت بهما سفينة فكلماهم أن يحملوهما فعرفوا الخضر فحملوهما بغير نول فعمد الخضر إلى لوح من ألواح السفينة فنزعه، فقال له موسى: قوم حملونا بغير نول فعمدت إلى سفينتهم فخرقتها @QB@ {لتغرق أهلها لقد جئت شيئا إمرا قال ألم أقل إنك لن تستطيع معي صبرا قال لا تؤاخذني بما نسيت ولا ترهقني من أمري عسرا} @QE@ [الكهف: ٧١] ثم خرجا من السفينة فبينما هما يمشيان على الساحل وإذا غلام يلعب مع الغلمان فأخذ الخضر برأسه فاقتلعه بيده، فقتله، قال له موسى: @QB@ {أقتلت نفسا زكية بغير نفس لقد جئت شيئا نكرا قال ألم أقل لك إنك لن تستطيع معي صبرا} @QE@ [الكهف: ٧٤] قال: وهذه أشد من الأولى @QB@ {قال إن سألتك عن شيء بعدها فلا تصاحبني قد بلغت من لدني عذرا فانطلقا حتى إذا أتيا أهل قرية استطعما أهلها فأبوا أن يضيفوهما فوجدا فيها جدارا يريد أن ينقض} @QE@ [الكهف: ٧٦] يقول: مائل، فقال الخضر بيده هكذا @QB@ {فأقامه} @QE@ [الكهف: ٧٧] فقال له موسى: قوم أتيناهم فلم يضيفونا ولم يطعمونا @QB@ {لو شئت لاتخذت عليه أجرا قال هذا فراق بيني وبينك سأنبئك بتأويل ما لم تستطع عليه صبرا} @QE@ [الكهف: ٧٧] " قال رسول الله PageV05P311 صلى الله عليه وسلم: (@)(@@) @MATN@ «يرحم الله موسى لوددنا أنه كان صبر حتى يقص علينا من أخبارهما» . (@)(@@) قال: وقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الأولى كانت من موسى نسيان» . (@)(@@) وقال: (@)(@@) @MATN@ " وجاء عصفور حتى وقع على حرف السفينة ثم نقر في البحر، فقال له الخضر: ما نقص علمي وعلمك من علم الله إلا مثل ما نقص هذا العصفور من البحر " قال سعيد بن جبير: وكان يعني ابن عباس، يقرأ: (@)(@@) @MATN@ «وكان أمامهم ملك يأخذ كل سفينة صالحة غصبا» (@)(@@) وكان يقرأ: (@)(@@) @MATN@ «وأما الغلام فكان كافرا» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) ورواه الزهري، عن عبيد الله بن عبد الله بن عتبة، عن ابن عباس، عن أبي بن كعب، عن النبي صلى الله عليه وسلم، 
ms1010	 وقد رواه أبو إسحاق الهمداني، عن سعيد بن جبير، عن ابن عباس، عن أبي بن كعب، عن النبي صلى الله عليه وسلم. قال أبو مزاحم السمرقندي: سمعت علي بن المديني يقول: حججت حجة وليس لي همة إلا أن أسمع من سفيان يذكر في هذا الحديث الخبر حتى سمعته يقول: حدثنا عمرو بن دينار، وقد كنت سمعت هذا من سفيان من قبل ذلك، ولم يذكر فيه الخبر " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٠ - (@)(@@) حدثنا عمرو بن علي قال: حدثنا أبو قتيبة سلم بن قتيبة قال: حدثنا عبد الجبار بن العباس، عن أبي إسحاق، عن سعيد بن جبير، عن ابن عباس، عن أبي بن كعب، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الغلام الذي قتله الخضر طبع يوم طبع كافرا» : (@)(@@) PageV05P312 (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥١ - (@)(@@) حدثنا يحيى بن موسى قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن همام بن منبه، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إنما سمي الخضر لأنه جلس على فروة بيضاء فاهتزت تحته خضراء» . (@)(@@) هذا حديث حسن صحيح غريب (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٢ - (@)(@@) حدثنا جعفر بن محمد بن فضيل الجزري، وغير واحد قالوا: حدثنا صفوان بن صالح قال: حدثنا الوليد بن مسلم، عن يزيد بن يوسف الصنعاني، عن مكحول، عن أم الدرداء، عن أبي الدرداء، عن النبي صلى الله عليه وسلم في قوله: @QB@ {وكان تحته كنز لهما} @QE@ [الكهف: ٨٢] قال: (@)(@@) @MATN@ «ذهب وفضة» (@)(@@) حدثنا الحسن بن علي الخلال قال: حدثنا صفوان بن صالح قال: حدثنا الوليد بن مسلم، عن يزيد بن يوسف الصنعاني، عن يزيد بن يزيد بن جابر، عن مكحول، بهذا الإسناد نحوه (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٣ - (@)(@@) حدثنا محمد بن بشار - وغير واحد المعنى واحد واللفظ لابن بشار -، قالوا: حدثنا هشام بن عبد الملك قال: حدثنا أبو عوانة، عن قتادة، عن أبي رافع، عن حديث أبي هريرة، عن النبي صلى الله عليه وسلم في السد قال: (@)(@@) @MATN@ " يحفرونه كل يوم، حتى إذا كادوا يخرقونه قال الذي عليهم: ارجعوا فستخرقونه غدا، فيعيده الله كأشد ما كان، حتى 
ms1011	 إذا بلغ مدتهم وأراد الله أن يبعثهم PageV05P313 على الناس. قال الذي عليهم: ارجعوا فستخرقونه غدا إن شاء الله واستثنى " ، قال: (@)(@@) @MATN@ " فيرجعون فيجدونه كهيئته حين تركوه فيخرقونه، فيخرجون على الناس، فيستقون المياه، ويفر الناس منهم، فيرمون بسهامهم في السماء فترجع مخضبة بالدماء، فيقولون: قهرنا من في الأرض وعلونا من في السماء، قسوة وعلوا، فيبعث الله عليهم نغفا في أقفائهم فيهلكون، فوالذي نفس محمد بيده إن دواب الأرض تسمن وتبطر وتشكر شكرا من لحومهم " : (@)(@@) @MATN@ «هذا حديث حسن غريب إنما نعرفه من هذا الوجه مثل هذا» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٤ - (@)(@@) حدثنا محمد بن بشار وغير واحد، قالوا: حدثنا محمد بن بكر البرساني، عن عبد الحميد بن جعفر قال: أخبرني أبي، عن ابن ميناء، عن أبي سعد بن أبي فضالة الأنصاري، وكان من الصحابة قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ " إذا جمع الله الناس يوم القيامة ليوم لا ريب فيه، نادى مناد: من كان أشرك في عمل عمله لله أحدا فليطلب ثوابه من عند غير الله فإن الله أغنى الشركاء عن الشرك " : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث محمد بن بكر» (@)(@@) (@)PageV05P314 (@)(@) (@)(@@) باب: ومن سورة مريم (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٥ - (@)(@@) حدثنا أبو سعيد الأشج، ومحمد بن المثنى، قالا: حدثنا ابن إدريس، عن أبيه، عن سماك بن حرب، عن علقمة بن وائل، عن المغيرة بن شعبة، قال: بعثني رسول الله صلى الله عليه وسلم إلى نجران، فقالوا لي: ألستم تقرءون @QB@ {يا أخت هارون} @QE@ [مريم: ٢٨] وقد كان بين عيسى وموسى ما كان، فلم أدر ما أجيبهم. فرجعت إلى رسول الله صلى الله عليه وسلم فأخبرته، فقال: (@)(@@) @MATN@ «ألا أخبرتهم أنهم كانوا يسمون بأنبيائهم والصالحين قبلهم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب، لا نعرفه إلا من حديث ابن إدريس» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٦ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا النضر بن إسماعيل أبو المغيرة، عن الأعمش، عن أبي صالح، عن أبي سعيد الخدري، PageV05P315 قال: قرأ رسول الله صلى الله عليه وسلم @QB@ {وأنذرهم يوم الحسرة} @QE@ [مريم: ٣٩] قال: (@)(@@) @MATN@ " يؤتى بالموت كأنه كبش أملح حتى يوقف على 
ms1012	 السور بين الجنة والنار، فيقال: يا أهل الجنة فيشرئبون، ويقال: يا أهل النار فيشرئبون، فيقال: هل تعرفون هذا؟ فيقولون: نعم، هذا الموت، فيضجع فيذبح، فلولا أن الله قضى لأهل الجنة الحياة والبقاء، لماتوا فرحا، ولولا أن الله قضى لأهل النار الحياة فيها والبقاء، لماتوا ترحا " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٧ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا الحسين بن محمد قال: حدثنا شيبان، عن قتادة، في قوله: @QB@ {ورفعناه مكانا عليا} @QE@ [مريم: ٥٧] قال: حدثنا أنس بن مالك، أن نبي الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لما عرج بي رأيت إدريس في السماء الرابعة» . (@)(@@) وفي الباب عن أبي سعيد عن النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «وهذا حديث حسن صحيح» (@)(@@) وقد رواه سعيد بن أبي عروبة، وهمام، وغير واحد، عن قتادة، عن أنس، عن مالك بن صعصعة، عن النبي صلى الله عليه وسلم حديث المعراج بطوله، (@)(@@) @MATN@ «وهذا عندي مختصر من ذاك» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٨ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا يعلى بن عبيد قال: حدثنا عمر بن ذر، عن أبيه، عن سعيد بن جبير، عن ابن عباس، قال: قال رسول الله صلى الله عليه وسلم لجبريل: (@)(@@) @MATN@ «ما يمنعك أن تزورنا أكثر مما تزورنا؟» (@)(@@) قال: فنزلت هذه الآية @QB@ {وما نتنزل إلا بأمر ربك له ما بين أيدينا وما خلفنا} @QE@ [مريم: ٦٤] إلى آخر الآية. PageV05P316 هذا حديث حسن. حدثنا الحسين بن حريث قال: حدثنا وكيع، عن عمر بن ذر، نحوه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٥٩ - (@)(@@) حدثنا عبد بن حميد قال: أخبرنا عبيد الله بن موسى، عن إسرائيل، عن السدي، قال: سألت مرة الهمداني، عن قول الله عز وجل: @QB@ {وإن منكم إلا واردها} @QE@ [مريم: ٧١] فحدثني أن عبد الله بن مسعود، حدثهم، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يرد الناس النار ثم يصدرون منها بأعمالهم، فأولهم كلمح البرق، ثم كالريح، ثم كحضر الفرس، ثم كالراكب في رحله، ثم كشد الرجل، ثم كمشيه» . (@)(@@) @MATN@ «هذا حديث حسن، ورواه شعبة، عن السدي فلم يرفعه» ، (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٠ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا 
ms1013	 شعبة، عن السدي، عن مرة، عن عبد الله بن مسعود، @QB@ {وإن منكم إلا واردها} @QE@ [مريم: ٧١] قال: (@)(@@) @MATN@ «يردونها ثم يصدرون بأعمالهم» (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي، عن شعبة، عن السدي، بمثله، قال عبد الرحمن، قلت لشعبة: إن إسرائيل، حدثني عن السدي، عن مرة، عن عبد الله، عن النبي صلى الله عليه وسلم، قال شعبة: وقد سمعته من السدي (@)(@@) @MATN@ «مرفوعا ولكني أدعه عمدا» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦١ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد العزيز بن محمد، عن سهيل بن أبي صالح، عن أبيه، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم PageV05P317 قال: (@)(@@) @MATN@ " إذا أحب الله عبدا نادى جبريل: إني قد أحببت فلانا فأحبه " ، قال: (@)(@@) @MATN@ " فينادي في السماء، ثم تنزل له المحبة في أهل الأرض، فذلك قول الله: @QB@ {إن الذين آمنوا وعملوا الصالحات سيجعل لهم الرحمن ودا} @QE@ [مريم: ٩٦] ، وإذا أبغض الله عبدا نادى جبريل: إني قد أبغضت فلانا، فينادي في السماء ثم تنزل له البغضاء في الأرض " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روى عبد الرحمن بن عبد الله بن دينار، عن أبيه، عن أبي صالح، عن أبي هريرة، عن النبي صلى الله عليه وسلم نحو هذا (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٢ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن الأعمش، عن أبي الضحى، عن مسروق، قال: سمعت خباب بن الأرت، يقول: (@)(@@) @MATN@ «جئت العاص بن وائل السهمي أتقاضاه حقا لي عنده» ، (@)(@@) فقال: لا أعطيك حتى تكفر بمحمد فقلت: (@)(@@) @MATN@ «لا، حتى تموت ثم تبعث» ، (@)(@@) قال: وإني لميت ثم مبعوث فقلت: (@)(@@) @MATN@ «نعم» . (@)(@@) فقال: إن لي هناك مالا وولدا فأقضيك. فنزلت: @QB@ {أفرأيت الذي كفر بآياتنا وقال لأوتين مالا وولدا} @QE@ [مريم: ٧٧] الآية حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، نحوه. (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P318 (@)(@) (@)(@@) باب: ومن سورة طه (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٣ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا النضر بن شميل قال: أخبرنا صالح بن أبي الأخضر، عن الزهري، عن سعيد بن المسيب، عن أبي هريرة، قال: لما قفل رسول الله صلى الله عليه وسلم من خيبر أسرى ليلة حتى أدركه 
ms1014	 الكرى أناخ فعرس، ثم قال: (@)(@@) @MATN@ «يا بلال اكلأ لنا الليلة» ، (@)(@@) قال: فصلى بلال، ثم تساند إلى راحلته مستقبل الفجر، فغلبته عيناه فنام، فلم يستيقظ أحد منهم، وكان أولهم استيقاظا النبي صلى الله عليه وسلم، فقال: (@)(@@) @MATN@ «أي بلال» ، (@)(@@) فقال بلال: بأبي أنت يا رسول الله، أخذ بنفسي الذي أخذ بنفسك. فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اقتادوا» ، (@)(@@) ثم أناخ فتوضأ فأقام الصلاة. ثم صلى مثل صلاته للوقت في تمكث، ثم قال: @QB@ {وأقم الصلاة لذكري} @QE@ [طه: ١٤] (@)(@@) @MATN@ «هذا حديث غير محفوظ، رواه غير واحد من الحفاظ عن الزهري، عن سعيد بن المسيب، أن النبي صلى الله عليه وسلم، ولم يذكروا PageV05P319 فيه عن أبي هريرة. وصالح بن أبي الأخضر يضعف في الحديث، ضعفه يحيى بن سعيد القطان وغيره من قبل حفظه» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة الأنبياء (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٤ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا الحسن بن موسى قال: حدثنا ابن لهيعة، عن دراج، عن أبي الهيثم، عن أبي سعيد، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الويل واد في جهنم يهوي فيه الكافر أربعين خريفا قبل أن يبلغ قعره» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه مرفوعا إلا من حديث ابن لهيعة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٥ - (@)(@@) حدثنا مجاهد بن موسى البغدادي، والفضل بن سهل الأعرج، وغير واحد قالوا: حدثنا عبد الرحمن بن غزوان أبو نوح قال: حدثنا ليث بن سعد، عن مالك بن أنس، عن الزهري، عن عروة، عن عائشة، أن رجلا قعد بين يدي النبي صلى الله عليه وسلم فقال: يا رسول الله، إن لي مملوكين يكذبونني ويخونونني ويعصونني، وأشتمهم وأضربهم فكيف أنا منهم؟ قال: (@)(@@) @MATN@ «يحسب ما خانوك وعصوك وكذبوك وعقابك إياهم، فإن كان عقابك إياهم بقدر ذنوبهم كان كفافا، لا لك ولا عليك، وإن كان عقابك إياهم دون ذنوبهم كان فضلا لك، PageV05P320 وإن كان عقابك إياهم فوق ذنوبهم اقتص لهم منك الفضل» . (@)(@@) قال: فتنحى الرجل فجعل يبكي ويهتف، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " أما تقرأ كتاب الله @QB@ {ونضع الموازين القسط ليوم القيامة فلا تظلم نفس شيئا 
ms1015	 وإن كان مثقال} @QE@ [الأنبياء: ٤٧] الآية " . فقال الرجل: والله يا رسول الله ما أجد لي ولهم شيئا خيرا من مفارقتهم، أشهدك أنهم أحرار كلهم: (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث عبد الرحمن بن غزوان» (@)(@@) وقد روى أحمد بن حنبل، عن عبد الرحمن بن غزوان، هذا الحديث (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٦ - (@)(@@) حدثنا سعيد بن يحيى الأموي قال: حدثني أبي قال: حدثنا محمد بن إسحاق، عن أبي الزناد، عن عبد الرحمن الأعرج، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " لم يكذب إبراهيم في شيء قط إلا في ثلاث: قوله: @QB@ {إني سقيم} @QE@ [الصافات: ٨٩] ولم يكن سقيما، وقوله: لسارة أختي، وقوله: @QB@ {بل فعله كبيرهم هذا} @QE@ [الأنبياء: ٦٣] " . هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٧ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع، ووهب بن جرير، وأبو داود، قالوا: حدثنا شعبة، عن المغيرة بن النعمان، عن سعيد بن جبير، عن ابن عباس، قال: قام رسول الله صلى الله عليه وسلم بالموعظة فقال: PageV05P321 (@)(@@) @MATN@ «يا أيها الناس، إنكم محشورون إلى الله عراة غرلا» ، (@)(@@) ثم قرأ @QB@ {كما بدأنا أول خلق نعيده وعدا علينا} @QE@ [الأنبياء: ١٠٤] إلى آخر الآية. قال: (@)(@@) @MATN@ " أول من يكسى يوم القيامة إبراهيم، وإنه سيؤتى برجال من أمتي فيؤخذ بهم ذات الشمال، فأقول: رب أصحابي، فيقال: إنك لا تدري ما أحدثوا بعدك، فأقول كما قال العبد الصالح: @QB@ {وكنت عليهم شهيدا ما دمت فيهم فلما توفيتني كنت أنت الرقيب عليهم وأنت على كل شيء شهيد إن تعذبهم فإنهم عبادك وإن تغفر لهم} @QE@ [المائدة: ١١٨] إلى آخر الآية، فيقال: هؤلاء لم يزالوا مرتدين على أعقابهم منذ فارقتهم " حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن المغيرة بن النعمان، نحوه. (@)(@@) @MATN@ «هذا حديث حسن صحيح» . (@)(@@) ورواه سفيان الثوري، عن المغيرة بن النعمان، نحوه.: (@)(@@) @MATN@ «كأنه تأوله على أهل الردة» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة الحج (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٨ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن ابن جدعان، عن الحسن، عن عمران بن حصين، أن النبي صلى الله عليه وسلم لما نزلت 
ms1016	 @QB@ {يا أيها الناس اتقوا ربكم إن زلزلة الساعة شيء PageV05P322 عظيم} @QE@ [الحج: ١] - إلى قوله - @QB@ {ولكن عذاب الله شديد} @QE@ [الحج: ٢] ، قال: أنزلت عليه هذه الآية وهو في سفر، فقال: (@)(@@) @MATN@ «أتدرون أي يوم ذلك؟» (@)(@@) فقالوا: الله ورسوله أعلم، قال: (@)(@@) @MATN@ " ذلك يوم يقول الله لآدم: ابعث بعث النار، فقال: يا رب وما بعث النار؟ قال: تسع مائة وتسعة وتسعون إلى النار وواحد إلى الجنة " ، قال: (@)(@@) @MATN@ «فأنشأ المسلمون يبكون» ، (@)(@@) فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «قاربوا وسددوا، فإنها لم تكن نبوة قط إلا كان بين يديها جاهلية» ، (@)(@@) قال: (@)(@@) @MATN@ «فيؤخذ العدد من الجاهلية فإن تمت وإلا كملت من المنافقين وما مثلكم والأمم إلا كمثل الرقمة في ذراع الدابة أو كالشامة في جنب البعير» ، (@)(@@) ثم قال: (@)(@@) @MATN@ «إني لأرجو أن تكونوا ربع أهل الجنة» (@)(@@) فكبروا، ثم قال: (@)(@@) @MATN@ «إني لأرجو أن تكونوا ثلث أهل الجنة» (@)(@@) فكبروا، ثم قال: (@)(@@) @MATN@ «إني لأرجو أن تكونوا نصف أهل الجنة» (@)(@@) فكبروا قال: ولا أدري؟ قال: الثلثين أم لا؟. (@)(@@) @MATN@ «هذا حديث حسن صحيح، قد روي من غير وجه عن عمران بن حصين عن النبي صلى الله عليه وسلم» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٦٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا هشام بن أبي عبد الله، عن قتادة، عن الحسن، عن عمران بن حصين، قال: كنا مع النبي صلى الله عليه وسلم في سفر فتفاوت بين أصحابه في السير فرفع رسول الله صلى الله عليه وسلم صوته بهاتين الآيتين @QB@ {يا أيها الناس PageV05P323 اتقوا ربكم إن زلزلة الساعة شيء عظيم} @QE@ [الحج: ١] - إلى قوله - @QB@ {ولكن عذاب الله شديد} @QE@ [الحج: ٢] فلما سمع ذلك أصحابه حثوا المطي وعرفوا أنه عند قول يقوله، فقال: (@)(@@) @MATN@ «هل تدرون أي يوم ذلك» ؟ (@)(@@) قالوا: الله ورسوله أعلم، قال: (@)(@@) @MATN@ " ذلك يوم ينادي الله فيه آدم فيناديه ربه فيقول: يا آدم ابعث بعث النار، فيقول: أي رب، وما بعث النار؟ فيقول: من كل ألف تسع مائة وتسعة وتسعون إلى النار وواحد في الجنة " فيئس القوم، حتى ما أبدوا بضاحكة، فلما رأى رسول الله صلى الله عليه 
ms1017	 وسلم الذي بأصحابه قال: (@)(@@) @MATN@ «اعملوا وأبشروا فوالذي نفس محمد بيده إنكم لمع خليقتين ما كانتا مع شيء إلا كثرتاه، يأجوج ومأجوج، ومن مات من بني آدم وبني إبليس» (@)(@@) قال: فسري عن القوم بعض الذي يجدون، فقال: (@)(@@) @MATN@ «اعملوا وأبشروا فوالذي نفس محمد بيده ما أنتم في الناس إلا كالشامة في جنب البعير أو كالرقمة في ذراع الدابة» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٠ - (@)(@@) حدثنا محمد بن إسماعيل وغير واحد، قالوا: حدثنا عبد الله بن صالح، قال: حدثني الليث، عن عبد الرحمن بن خالد، عن ابن شهاب، عن محمد بن عروة بن الزبير، عن عبد الله بن الزبير، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إنما سمي البيت العتيق لأنه لم يظهر عليه جبار» : (@)(@@) @MATN@ «هذا حديث حسن غريب، وقد روي هذا الحديث عن الزهري، عن النبي صلى الله عليه وسلم مرسلا» . (@)(@@) PageV05P324 حدثنا قتيبة قال: حدثنا الليث، عن عقيل، عن الزهري، عن النبي صلى الله عليه وسلم نحوه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧١ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا أبي، وإسحاق بن يوسف الأزرق، عن سفيان، عن الأعمش، عن مسلم البطين، عن سعيد بن جبير، عن ابن عباس، قال: (@)(@@) @MATN@ " لما أخرج النبي صلى الله عليه وسلم من مكة، قال أبو بكر: أخرجوا نبيهم ليهلكن " فأنزل الله تعالى @QB@ {أذن للذين يقاتلون بأنهم ظلموا وإن الله على نصرهم لقدير} @QE@ [الحج: ٣٩] الآية فقال أبو بكر: (@)(@@) @MATN@ «لقد علمت أنه سيكون قتال» . (@)(@@) هذا حديث حسن. وقد رواه غير واحد عن سفيان، عن الأعمش، عن مسلم البطين، عن سعيد بن جبير مرسلا، وليس فيه عن ابن عباس (@)PageV05P325 (@)(@) (@)(@@) باب: ومن سورة المؤمنون (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٣ - (@)(@@) حدثنا يحيى بن موسى، وعبد بن حميد، وغير واحد المعنى واحد، قالوا: حدثنا عبد الرزاق، عن يونس بن سليم، عن الزهري، عن عروة بن الزبير، عن عبد الرحمن بن عبد القاري، قال: سمعت عمر بن الخطاب، يقول: كان النبي صلى الله عليه وسلم إذا أنزل عليه الوحي سمع عند وجهه كدوي النحل فأنزل عليه يوما فمكثنا ساعة فسري عنه فاستقبل القبلة 
ms1018	 ورفع يديه وقال: (@)(@@) @MATN@ «اللهم زدنا ولا تنقصنا، وأكرمنا ولا تهنا، وأعطنا ولا تحرمنا، وآثرنا ولا تؤثر علينا، وارضنا وارض عنا» ، (@)(@@) ثم قال صلى الله عليه وسلم: (@)(@@) @MATN@ «أنزل علي عشر آيات، من أقامهن دخل الجنة» ، (@)(@@) ثم قرأ: @QB@ {قد أفلح المؤمنون} @QE@ [المؤمنون: ١] حتى ختم عشر آيات حدثنا محمد بن أبان قال: حدثنا عبد الرزاق، عن يونس بن سليم، عن يونس بن يزيد، عن الزهري، بهذا الإسناد نحوه بمعناه.: (@)(@@) @MATN@ «وهذا أصح من الحديث الأول» (@)(@@) سمعت إسحاق بن منصور، يقول: روى أحمد بن حنبل، وعلي بن المديني، وإسحاق بن إبراهيم، عن عبد الرزاق، عن يونس بن سليم، عن يونس بن يزيد، عن الزهري، هذا الحديث،: (@)(@@) @MATN@ «ومن سمع من عبد الرزاق قديما فإنهم إنما PageV05P326 يذكرون فيه عن يونس بن يزيد، وبعضهم لا يذكر فيه عن يونس بن يزيد، ومن ذكر فيه يونس بن يزيد فهو أصح، وكان عبد الرزاق ربما ذكر في هذا الحديث يونس بن يزيد وربما لم يذكره، وإذا لم يذكر فيه يونس، فهو مرسل» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٤ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا روح بن عبادة، عن سعيد، عن قتادة، عن أنس بن مالك، أن الربيع بنت النضر أتت النبي صلى الله عليه وسلم وكان ابنها حارثة بن سراقة أصيب يوم بدر، أصابه سهم غرب، فأتت رسول الله صلى الله عليه وسلم فقالت: أخبرني عن حارثة لئن كان أصاب خيرا احتسبت وصبرت، وإن لم يصب الخير اجتهدت في الدعاء، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «يا أم حارثة إنها جنان في جنة، وإن ابنك أصاب الفردوس الأعلى والفردوس ربوة الجنة وأوسطها وأفضلها» . (@)(@@) هذا حديث حسن صحيح غريب من حديث أنس (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان قال: حدثنا مالك بن مغول، عن عبد الرحمن بن سعيد بن وهب الهمداني، أن عائشة، زوج النبي صلى الله عليه وسلم قالت: سألت رسول الله صلى الله عليه وسلم عن هذه الآية: @QB@ {والذين يؤتون ما آتوا وقلوبهم وجلة} @QE@ [المؤمنون: ٦٠] قالت عائشة: أهم الذين يشربون الخمر ويسرقون؟ 
ms1019	 قال: (@)(@@) @MATN@ " لا يا بنت الصديق، ولكنهم PageV05P327 الذين يصومون ويصلون ويتصدقون، وهم يخافون أن لا تقبل منهم @QB@ {أولئك يسارعون في الخيرات وهم لها سابقون} @QE@ [المؤمنون: ٦١] " . وروي هذا الحديث عن عبد الرحمن بن سعيد، عن أبي حازم، عن أبي هريرة، عن النبي صلى الله عليه وسلم نحو هذا (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٦ - (@)(@@) حدثنا سويد قال: أخبرنا عبد الله بن المبارك، عن سعيد بن يزيد أبي شجاع، عن أبي السمح، عن أبي الهيثم، عن أبي سعيد الخدري، عن النبي صلى الله عليه وسلم قال: @QB@ {وهم فيها كالحون} @QE@ [المؤمنون: ١٠٤] قال: (@)(@@) @MATN@ «تشويه النار فتقلص شفته العالية حتى تبلغ وسط رأسه، وتسترخي شفته السفلى حتى تضرب سرته» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@) باب: ومن سورة النور (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٧ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا روح بن عبادة، عن عبيد الله بن الأخنس قال: أخبرني عمرو بن شعيب، عن أبيه، عن جده، قال: كان رجل يقال له: مرثد بن أبي مرثد، وكان رجلا يحمل الأسرى من مكة حتى يأتي بهم المدينة، قال: وكانت امرأة بغي بمكة يقال لها: عناق وكانت صديقة له، وإنه كان وعد رجلا من أسارى مكة يحمله، قال: فجئت حتى انتهيت إلى ظل حائط من حوائط مكة في ليلة مقمرة، قال: فجاءت عناق فأبصرت سواد ظلي بجنب PageV05P328 الحائط فلما انتهت إلي عرفت، فقالت: مرثد؟ فقلت: مرثد. فقالت: مرحبا وأهلا هلم فبت عندنا الليلة. قال: قلت: يا عناق حرم الله الزنا، قالت: يا أهل الخيام، هذا الرجل يحمل أسراءكم، قال: فتبعني ثمانية وسلكت الخندمة فانتهيت إلى كهف أو غار فدخلت، فجاءوا حتى قاموا على رأسي فبالوا فظل بولهم على رأسي وعماهم الله عني، قال: ثم رجعوا ورجعت إلى صاحبي فحملته وكان رجلا ثقيلا حتى انتهيت إلى الإذخر، ففككت عنه أكبله فجعلت أحمله ويعييني حتى قدمت المدينة، فأتيت رسول الله صلى الله عليه وسلم فقلت: يا رسول الله، أنكح عناقا؟ فأمسك رسول الله صلى الله عليه وسلم فلم يرد علي شيئا حتى نزلت الزاني لا ينكح إلا زانية أو مشركة 
ms1020	 والزانية لا ينكحها إلا زان أو مشرك، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يا مرثد الزاني لا ينكح إلا زانية أو مشركة والزانية لا ينكحها إلا زان أو مشرك، فلا تنكحها» : (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه إلا من هذا الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣١٧٨ - (@)(@@) حدثنا هناد قال: حدثنا عبدة بن سليمان، عن عبد الملك بن أبي سليمان، عن سعيد بن جبير، قال: سئلت عن المتلاعنين في إمارة PageV05P329 مصعب بن الزبير أيفرق بينهما فما دريت ما أقول، فقمت من مكاني إلى منزل عبد الله بن عمر، فاستأذنت عليه، فقيل لي إنه قائل فسمع كلامي فقال لي: ابن جبير؟ ادخل، ما جاء بك إلا حاجة، قال: فدخلت فإذا هو مفترش بردعة رحل له، فقلت: يا أبا عبد الرحمن، المتلاعنان أيفرق بينهما؟ فقال: (@)(@@) @MATN@ " سبحان الله نعم، إن أول من سأل عن ذلك فلان ابن فلان، أتى النبي صلى الله عليه وسلم فقال: يا رسول الله أرأيت لو أن أحدنا رأى امرأته على فاحشة كيف يصنع؟ إن تكلم تكلم بأمر عظيم، وإن سكت سكت على أمر عظيم " ، قال: (@)(@@) @MATN@ " فسكت النبي صلى الله عليه وسلم فلم يجبه، فلما كان بعد ذلك أتى النبي صلى الله عليه وسلم فقال: إن الذي سألتك عنه قد ابتليت به، فأنزل الله هذه الآيات في سورة النور @QB@ {والذين يرمون أزواجهم ولم يكن لهم شهداء إلا أنفسهم} @QE@ [النور: ٦] حتى ختم الآيات " قال: (@)(@@) @MATN@ " فدعا الرجل فتلاهن عليه ووعظه، وذكره وأخبره: أن عذاب الدنيا أهون من عذاب الآخرة، فقال: لا، والذي بعثك بالحق ما كذبت عليها، ثم ثنى بالمرأة ووعظها وذكرها، وأخبرها: أن عذاب الدنيا أهون من عذاب الآخرة، فقالت: لا، والذي بعثك بالحق ما صدق، فبدأ بالرجل فشهد أربع شهادات بالله إنه لمن الصادقين، والخامسة أن لعنة الله عليه إن كان من الكاذبين، ثم ثنى بالمرأة فشهدت أربع شهادات بالله إنه لمن الكاذبين، والخامسة أن غضب الله عليها إن كان من الصادقين، ثم فرق بينهما (@)(@@) @MATN@ «وفي الباب عن سهل بن سعد.» (@)(@@) وهذا حديث 