ms21	(@)(@@) 21 ز میدان‌های عمر خویش بگذشتی و می‌دانی %~% که هرگز باز نائی تو سوی این شهره میدان‌ها(@)(@@) 22 که آراید چه گوئی هر شبی این سبز گنبد را %~% بدین نو رسته نرگس‌ها و زراندود پیکان‌ها(@)(@@) 23 اگر بیدار و هشیاری و گوشت سوی من داری %~% بیاموزم تو را یک یک زبان چرخ و دوران‌ها(@)(@@) 24 همی گویند کاین کهسارهای محکم و عالی %~% نرسته ستند در عالم مگر کز نرم باران‌ها(@)(@@) 25 زمین کو مایه‌تنهاست دانا را همی گوید %~% که اصلی هست جان‌ها را که سوی او شود جان‌ها(@)(@@) 26 به تاریکی دهد مژده همیشه روشنائی مان %~% که از دشوارها هرگز نباشد خالی آسان‌ها(@)(@@) 27 به مال و قوت دنیا مشو غره چو دانستی %~% که روزی آهوان بودند آن پرآرد انبان‌ها(@)(@@) 28 وگر دشواریی بینی مشو نومید از آسانی %~% که از سرگین همی روید چنین خوش بوی ریحان‌ها(@)(@@) 29 چهارت بند بینم کرده اندر هفتمین زندان %~% چرا ترسی اگر از بند بجهانند و زندان‌ها(@)(@@) 30 در این صندوق ساعت عمرها را دهر بی‌رحمت %~% همی برما بپیماید بدین گردنده پنگان‌ها(@)(@@) 31 ز عمر این جهانی هر که حق خویش بستاند %~% برون باید شدنش از زیر این پیروزه ایوان‌ها(@)(@@) 32 چو زین منزلگه کم بیشها بیرون شود زان پس %~% نیابد راه سوی او زیادت‌ها و نقصان‌ها(@)(@@) 33 در این الفنج گه جویند زاد خویش بیداران %~% که هم زادست بر خوان‌ها و هم مال است در کان‌ها(@)(@@) 34 بماند تشنه و درویش و بیمار آنکه نلفنجد %~% در این ایام الفغدن شراب و مال و درمان‌ها(@)(@@) 35 که را ناید گران امروز رفتن بر ره طاعت %~% گران آید مر آن کس را به روز حشر میزان‌ها(@)(@@) 36 به نعمت‌ها رسند آنها که ورزیدند نیکی‌ها %~% به شدتها رسند آنها که بشکستند پیمان‌ها(@)(@@) 37 خداوند جهان باتش بسوزد بد فعالان را %~% برین قایم شده‌است اندر جهان بسیار برهان‌ها(@)(@@) 38 ازیرا ما خداوند درختانیم و سوی ما %~% سزای 
ms22	 سوختن گشتند بد گوهر مغیلان‌ها(@)(@@) 39 بدی با جهل یارانند هر کو بد کنش باشد %~% نپرهیزد زبد گرچه مقر آید به فرقان‌ها(@)(@@) 40 نبینی حرص این جهال بر کردار بد زان پس %~% که پیوسته همی درند بر منبر گریبان‌ها(@)(@@) 41 به زیر قول چون مبرم نگر فعل چو نشترشان %~% به سان نامه‌های زشت زیر خوب عنوان‌ها(@)(@@) 42 ز بهتان گویدت پرهیز کن وانگه به طمع خود %~% بگوید صد هزاران بر خدای خویش بهتان‌ها(@)(@@) 43 اگر یک دم به خوان خوانی مرورا مژده‌ور گردد %~% به خوانی در بهشت عدن پر حلوا و بریان‌ها(@)(@@) 44 به باغی در که مرغان از درختانش به پیش تو %~% فرود افتد چو بریان شکم آگنده بر خوان‌ها(@)(@@) 45 چنین باغی نشاید جز که مر خوارزمیانی را %~% که بردارند بر پشت و به گردن بار کپان‌ها(@)(@@) 46 چنین چو گفتی ای حجت که بر جهال این امت %~% فرو بارد ز خشم تو همی اندوه طوفان‌ها(@)(@@) 47 بر این دیوان اگر نفرین کنی شاید که ایشان را %~% همی هر روز پرگردد به نفرین تو دیوان‌ها PageV1P009(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای گشته جهان و دیده دامش را %~% صد بار خریده مر دلامش را(@)(@@) 2 بر لفظ زمانه هر شبانروزی %~% بسیار شنوده‌ای کلامش را(@)(@@) 3 گفته‌است تو را که «بی مقامم من» %~% تا چند کنی طلب مقامش را(@)(@@) 4 بارنده به دوستان و یاران بر %~% نم نیست غم است مر غمامش را(@)(@@) 5 چون داد نوید رنج و دشواری %~% آراسته باش مر خرامش را(@)(@@) 6 بر یخ بنویس چون کند وعده %~% گفتار محال و قول خامش را(@)(@@) 7 جز کشتن یار خویش و فرزندان %~% کاری مشناس مر حسامش را(@)(@@) 8 چون چاشت کند ز خویش و پیوندت %~% تو ساخته باش کار شامش را(@)(@@) 9 گر بر تو سلام خوش کند روزی %~% دشنام شمار مر سلامش را(@)(@@) 10 کس را به نظام دیده‌ای حالی %~% کو رخنه نکرد مر نظامش را(@)(@@) 11 وز 
ms23	 باب و ز مام خویش نربودش %~% یا زو نر بود باب و مامش را(@)(@@) 12 پرهیز کن از جهان بی‌حاصل %~% ای خورده جهان و دیده دامش را(@)(@@) 13 و آگاه کن ای برادر از غدرش %~% دور و نزدیک و خاص و عامش را(@)(@@) 14 آن را که همی ازو طمع دارد %~% گو «ساخته باش انتقامش را»(@)(@@) 15 گر بر فلک است بام کاشانه‌ش %~% چون دشت شمار پست بامش را(@)(@@) 16 من کز همه حال و کارش آگاهم %~% هرگز طلبم مراد و کامش را(@)(@@) 17 وین دل که حلال او نمی‌جوید %~% چون خواهد جست مر حرامش را(@)(@@) 18 آن را طلب ای جهان که جویایست %~% این بی‌مزه ناز و عز و رامش را(@)(@@) 19 واشفته بدو سپاری و برکه %~% شاهنشه ری کنی غلامش را(@)(@@) 20 وز مشتری و قمر بیارائی %~% مرقبقب زین و اوستامش را(@)(@@) 21 آخر بدهی به ننگ و رسوائی %~% بی شک یک روز لاف و لامش را(@)(@@) 22 هرچند که شاه نامور باشد %~% نابوده کنی نشان و نامش را(@)(@@) 23 واشفته کنی به دست بیدادی %~% احوال به نظم و نغز و رامش را(@)(@@) 24 بشنو پدرانه ای پسر پندی %~% آن پند که داد نوح سامش را(@)(@@) 25 پرهیز کن از کسی که نشناسد %~% دنیی و نعیم بی‌قوامش را(@)(@@) 26 وز دل به چراغ دین و علم حق %~% نتواند برد مر ظلامش را(@)(@@) 27 زو دست بشوی و جز به خاموشی %~% پاسخ مده ای پسر پیامش را(@)(@@) 28 بگذارش تا به دین همی خرد %~% دنیای مزور و حطامش را(@)(@@) 29 منگر به مثل جز از ره عبرت %~% رخساره خشک چون رخامش را(@)(@@) 30 بل تا بکشد به مکر زی دوزخ %~% دیو از پس خویشتن لگامش را(@)(@@) 31 بر راه امام خود همی نازد %~% او را مپذیر و مه امامش را(@)(@@) 32 دیوی است حریص و کام او حرصش %~% بشناس به هوش دیو و کامش را(@)(@@) 33 چون صورت و 
ms24	 راه دیو او دیدی %~% بگذار طریقت نغامش را(@)(@@) 34 وانکه بگزار شکر ایزد را %~% وین منت و نعمت تمامش را(@)(@@) 35 وامی است بزرگ شکر او بر تو %~% بگزار به جهد و جد وامش را(@)(@@) 36 شکری بگزار علم و دینش را %~% زان به که شراب یا طعامش را PageV1P010(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 پادشا بر کام‌های دل که باشد پارسا %~% پارسا شو تا شوی بر هر مرادی پادشا(@)(@@) 2 پارسا شو تا بباشی پادشا بر آرزو %~% کارزو هرگز نباشد پادشا بر پارسا(@)(@@) 3 پادشا گشت آرزو بر تو ز بی‌باکی تو %~% جان و دل بایدت داد این پادشا را باژ و سا(@)(@@) 4 آز دیو توست چندین چون رها جوئی ز دیو %~% تو رها کن دیو را تا زو بباشی خود رها(@)(@@) 5 دیو را پیغمبران دیدند و راندندش ز پیش %~% دیو را نادان نبیند من نمودم مر تو را(@)(@@) 6 خویشتن را چون فریبی چون نپرهیزی ز بد %~% چو نهی چون خود کنی عصیان بهانه بر قضا(@)(@@) 7 چونکه گر تو بد کنی زان دیو را باشد گناه %~% ور یکی نیکی کنی زان مر تورا باید ثنا(@)(@@) 8 چون نیندیشی که می‌بر خویشتن لعنت کنی %~% از خرد بر خویشتن لعنت چرا داری روا(@)(@@) 9 جز به دست تو نگیرد ملک کس دیو ای شگفت %~% جز به لفظ تو نگیرد نیز مر کس را جفا(@)(@@) 10 دست و قولت دست و قول دیو باشد زین قیاس %~% ور نباشی تو نباشد دیو چیزی سوی ما(@)(@@) 11 چند گردی گرد این و آن به طمع جاه و مال %~% کز طمع هرگز نیاید جز همه درد و بلا(@)(@@) 12 گرچه موش از آسیا بسیار یابد فایده %~% بی گمان روزی فرو کوبد سر موش آسیا(@)(@@) 13 ای چرای گور گرد دشت روز و شب چرا %~% ننگری کاین روز و شب جوید همی از تو چرا(@)(@@) 14 چون چرا جوئی از انک از تو چرا جوید 
ms25	 همی %~% این چرا جستن ز یکدیگر چرا باید چرا(@)(@@) 15 مر ستوران را غذا اندر گیا بینم همی %~% باز بی‌دانش گیا را خاک و آب آمد غذا(@)(@@) 16 چون بقای هر دو را علت نیامد جز غذا %~% نیست باقی بر حقیقت نه ستور و نه گیا(@)(@@) 17 خاک و آب مرده آمد کیمیای زندگی %~% مردگان چونند یارب زندگی را کیمیا!(@)(@@) 18 چند پوشاند زگاه صبح تا هنگام شام %~% خاک را خورشید صورت گشتن این رنگین ردا(@)(@@) 19 این ردای خاک و آب آمد سوی مرد خرد %~% گرچه نور آمد به سوی عام نامش یا ضیا(@)(@@) 20 ای برادر جز به زیر این ردا اندر نشد %~% این همه بوی و مزه بسیار با خاک آشنا(@)(@@) 21 کشت زار ایزد است این خلق و داس اوست مرگ %~% داس این کشت ای برادر همچنین باشد سزا(@)(@@) 22 اوت کشت و اوت خواهد هم درودن بی‌گمان %~% هر که کارد بدرود پس چون کنی چندین مرا(@)(@@) 23 کردمت پیدا که بس خوب است تا قول آن حکیم %~% کاین جهان را کرد ماننده به کرد گندنا(@)(@@) 24 مست گشتی زان خطا دانی صوابی را همی %~% وین نباشد جز خطا وز مست ناید جز خطا(@)(@@) 25 بر مراد خویشتن گوئی همی در دین سخن %~% خویشتن را سغبه گشتی تکیه کردی بر هوا(@)(@@) 26 دین دبستان است و امت کودکان نزد رسول %~% در دبستان است امت ز ابتدا تا انتها(@)(@@) 27 گر سرودی بر مراد خود بگوید کودکی %~% جز که خواری چیز ناید ز اوستاد و جز قفا(@)(@@) 28 حجتی بپذیر و برهانی ز من زیرا که نیست %~% آن دبیرستان کلی را جز این جزوی گوا(@)(@@) 29 مادر فرقان چو دانی تو که هفت آیت چراست %~% یا شهادت را چرا بنیاد کرده‌ستند لا(@)(@@) 30 بر قیاس خویش دانی هیچ کایزد در کتاب %~% از چه معنی چون دو زن کرده‌است مردی را بها(@)(@@) 31 ور زنی کردن چو کشتن 
ms26	 نیست از روی قیاس %~% هر دو را کشتن چو یکدیگر چرا آمد جزا(@)(@@) 32 وز قیاس تو رسول مصطفائی نیز تو %~% زانکه مردم بود همچون تو رسول مصطفا(@)(@@) 33 وز قیاس تو چو با پرند پرنده همه %~% پر دارد نیز ماهی چون نپرد در هوا(@)(@@) 34 وز قیاست بوریا گر همچو دیبا بافته است %~% قیمتی باشد به علم تو چو دیبا بوریا!(@)(@@) 35 بیش ازین ای فتنه گشته بر قیاس و رای خویش %~% کردمی ظاهر ز عیبت گر مرا کردی کرا(@)(@@) 36 نیستی آگه چه گویم مر تو را من جز همانک %~% عامه گوید «نیستی آگه ز نرخ لوبیا»(@)(@@) 37 کهربای دین شده ستی دانه را رد کرده‌ای %~% کاه بربائی همی از دین به سان کهربا(@)(@@) 38 مبتلای درد عصبانی به طاعت باز گرد %~% درد عصیان را جز از طاعت نیابد کس دوا(@)(@@) 39 گر تو را باید که مجروح جفا بهتر شود %~% مرهمی باید نهادن بر سرش نرم از وفا(@)(@@) 40 راست گوی و راه جوی و از هوا پرهیز کن %~% کز هوا چیزی نژاد و هم نزاید جز عنا(@)(@@) 41 گر براندیشی بریده‌ستی رهی دور و دراز %~% چون نیندیشی که این رفتن بر این سان تا کجا(@)(@@) 42 بی عصا رفتن نیابد چون همی بینی که سگ %~% مر غریبان را همی جامه به درد بی عصا(@)(@@) 43 پاره کرده‌ستند جامه دین بر تو بر لاجرم %~% آن سگان مست گشته روز حرب کربلا(@)(@@) 44 آن سگان کز خون فرزندانش می‌جویند جاه %~% روز محشر سوی آن میمون و بی‌همتا نیا(@)(@@) 45 آن سگان که‌ت جان نگردد بی‌عوار از عیبشان %~% تا نشوئی تن به آب دوستی‌ی اهل عبا(@)(@@) 46 چون به حب آل زهرا روی شستی روز حشر %~% نشنود گوشت ز رضوان جز سلام و مرحبا(@)(@@) 47 ای شده مدهوش و بیهش پند حجت گوش دار %~% کز عطای پند برتر نیست در دنیا عطا(@)(@@) 48 بر طریق راست رو چون نال 
ms27	 گردنده مباش %~% گاه با باد شمال و گاه با باد صبا(@)(@@) 49 جز به خشنودی و خشم ایزد و پیغمبرش %~% من ندارم از کسی در دل نه خوف و نه رجا(@)(@@) 50 خوب دیبائی طرازیدم حکیمان را کزو %~% تا قیامت مر سعادت را نبیند کس جزا(@)(@@) 51 گر به خواب اندر کسائی دیدی این دیبای من %~% سوده کردی شرم و خجلت مر کسائی را کسا PageV1P011(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 خواهی که نیاری به سوی خویش زیان را %~% از گفتن ناخوب نگه‌دار زبان را(@)(@@) 2 گفتار زبان است ولیکن نه مرا نیز %~% تا سود به یک سو نهی از بهر زیان را(@)(@@) 3 گفتار به عقل است که را عقل ندادند %~% مر گاو و خر و اشتر و دیگر حیوان را(@)(@@) 4 مردم که سخن گوید زان است که دارد %~% عقلی که پدید آرد برهان و بیان را(@)(@@) 5 پس بچه عقل آمد گفتار و نزیبد %~% که بچه عقل تو زیان دارد جان را(@)(@@) 6 جان و خرد از امر خدایند و نهانند %~% پیدا نتوان کرد مر این جفت نهان را(@)(@@) 7 تن جفت نهان است و به فرمانت روان است %~% تاثیر چنین باشد فرمان روان را(@)(@@) 8 فرمان روان جان و روان زی تو فرستاد %~% تا پروریش ای بخرد جان و روان را(@)(@@) 9 گر قابل فرمانی دانا شوی ورنی %~% کردی به جهنم بدل از جهل جنان را(@)(@@) 10 زنهار به توفیق بهانه نکنی زانک %~% معذور ندارند بدین خرد و کلان را(@)(@@) 11 بشناس که توفیق تو این پنج حواس است %~% هر پنج عطا ز ایزد مر پیر و جوان را(@)(@@) 12 سمع و بصر و ذوق و شم و حس که بدو یافت %~% جوینده ز نایافتن خیر امان را(@)(@@) 13 دیدن ز ره چشم و شنیدن ز ره گوش %~% بوی از ره بینی چو مزه کام و زبان را(@)(@@) 14 پنجم ز ره دست پساوش که بدانی %~% نرمی ز درشتی 
ms28	 چو زخز خار خلان را(@)(@@) 15 محسوس بود هرچه در این پنج حس آید %~% محسوس مر این را دان معقول جز آن را(@)(@@) 16 این پنج در علم ازان بر تو گشادند %~% تا باز شناسی هنر و عیب جهان را(@)(@@) 17 اجسام ز اجرام و لطافت ز کئافت %~% تدویر زمین را و تداویر زمان را(@)(@@) 18 ارکان و موالید بدو هستی دارند %~% تا نیر درو مشمر در وی حدثان را(@)(@@) 19 این را که همی بینی از گرمی و سردی %~% از تری و خشکی و ضعیفی و توان را(@)(@@) 20 گرمای حزیران را مر سردی دی را %~% مر ابر بهاری را مر باد خزان را(@)(@@) 21 وین از پی آن نیست که تا نیست شود طبع %~% وین نیست عرض طالع علم سرطان را(@)(@@) 22 قصد دبران نیست سوی نیستی او %~% یاری گر او دان به حقیقت دبران را(@)(@@) 23 ترتیب عناصر نشناسی نشناسی %~% اندازه هرچیز مکین را و مکان را(@)(@@) 24 مر آتش سوزان را مر باد سبک را %~% مر آب روان را و مر این خاک گران را(@)(@@) 25 وز علم و عمل هرچه تو را مشکل گردد %~% شاید که بیاموزی ای خواجه مر آن را PageV1P012(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 خداوندی که در وحدت قدیم است از همه اشیا %~% نه اندر وحدتش کثرت نه محدث زین همه تنها(@)(@@) 2 چه گوئی از چه او عالم پدید آورد از لولو %~% که نه مادت بد و صورت نه بالا بود و نه پهنا(@)(@@) 3 همی گوئی که بر معلول خود علت بود سابق %~% چنان چون بر عدد واحد و یا بر کل خود اجزا(@)(@@) 4 به معلولی چو یک حکم است و یک وصف آن دو عالم را %~% چرا چون علت سابق توانا باشد و دانا(@)(@@) 5 هر آنچ امروز نتواند به فعل آوردن از قوت %~% نیاز و عجز اگر نبود ورا چه دی و چه فردا(@)(@@) 6 همی گوئی زمانی بود 
ms29	 از معلول تا علت %~% پس از ناچیز محض آورد موجودات را پیدا(@)(@@) 7 زمانی کز فلک زاید فلک نابوده چون باشد %~% زمان و چیز ناموجود و ناموجود بی‌مبدا(@)(@@) 8 اگر هیچیز را چیزی نهی قایم به ذات خود %~% پس آمد نفس وحدت را مضاد و مثل در آلا(@)(@@) 9 و گر زین صورت هیچیز حرف و صوت می‌خواهی %~% مسلم شد که بی‌معلول نبود علت اسما(@)(@@) 10 تقدم هست یزدان را چو بر اعداد وحدان را %~% زمان حاصل مکان باطل حدث لازم قدم بر جا(@)(@@) 11 مکن هرگز بدو فعلی اضافت گر خرد داری %~% بجز ابداغ یک مبدع کلمح العین او ادنا(@)(@@) 12 مگو فعلش بدان گونه که ذاتش منفعل گردد %~% چنان کز کمترین قصدی به گاه فعل ذات ما(@)(@@) 13 مجوی از وحدت محضش برون از ذات او چیزی %~% که او عام است و ماهیات خاص اندر همه احیا(@)(@@) 14 گر از هر بینشش بیرون کنی وصفی برو مفزا %~% دو باشد بی‌خلاف آنگه نه فرد و واحد و یکتا(@)(@@) 15 اگر چه بی‌عدد اشیا همی بینی در این عالم %~% ز خاک و باد و آب و آتش و کانی و از دریا(@)(@@) 16 چو هاروت ار توانستی که اینجا آئی از گردون %~% از اینجا هم توانی شد برون چون زهره زهرا(@)(@@) 17 ز گوهر دان نه از هستی فزونی اندر این معنی %~% که جز یک چیز را یک چیز نبود علت انشا(@)(@@) 18 خرد دان اولین موجود زان پس نفس و جسم آنگه %~% نبات و گونه حیوان و آنگه جانور گویا(@)(@@) 19 همی هریک به خود ممکن بدو موجود ناممکن %~% همی هریک به خود پیدا بدو معدوم ناپیدا(@)(@@) 20 چه گوئی چیست این پرده بر این سان بر هوا برده %~% چو در صحرای آذرگون یکی خرگاه از مینا(@)(@@) 21 به خود جنبد همی ور نی کسی می‌داردش جنبان %~% و یا بهر چه گردان شد بدین سان گرد این بالا(@)(@@) 22 
ms30	 چو در تحدید جنبش را همی نقل مکان گوئی %~% و یا گردیدن از حالی به حالی دون یا والا(@)(@@) 23 بیان کن حال و جایش را اگر دانی مرا ورنی %~% مپوی اندر ره حکمت به تقلید از سر عمیا(@)(@@) 24 چو نه گنبد همی گوئی به برهان و قیاس آخر %~% چه گوئی چیست از بیرون این نه گنبد خضرا(@)(@@) 25 اگر بیرون خلا گوئی خطا باشد که نتواند %~% بدو در صورت جسمی بدین سان گشته اندروا(@)(@@) 26 وگر گوئی ملا باشد روا نبود که جسمی را %~% نهایت نبود و غایت به سان جوهر اعلا(@)(@@) 27 چه می‌دارد بدین گونه معلق گوی خاکی را %~% میان آتش و آب و هوای تندر و نکبا(@)(@@) 28 گر اجزای جهان جمله نهی مایل بر آن جزوی %~% که موقوف است چون نقطه میان شکل نه سیما(@)(@@) 29 چرا پس چون هوا او را به قهر از سوی آب آرد %~% به ساعت باز بگریزد به سوی مولد و منشا(@)(@@) 30 اگر ضدند اخشیجان را هر چار پیوسته %~% بوند از غایت وحدت برادروار در یک جا(@)(@@) 31 و گر گوئی که در معنی نیند اضداد یک دیگر %~% تفاوت از چه شان آمد میان صورت و اسما(@)(@@) 32 ز اول هستی خود را نکو بشناس و آنگاهی %~% عنان برتاب از این گردون وزین بازیچه غبرا(@)(@@) 33 تو اسرار الهی را کجا دانی که تا در تو %~% بود ابلیس با آدم کشیده تیغ در هیجا(@)(@@) 34 تو از معنی همان بینی که در بستان جان پرور %~% ز شکل و رنگ گل بیند دو چشم مرد نابینا PageV1P013(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای کرده قال و قیل تو را شیدا %~% هیچ از خبر شدت به عیان پیدا(@)(@@) 2 تا غره گشته‌ای به سخن‌هائی %~% کاینها خبر دهند همی زانها!(@)(@@) 3 تا گوش و چشم یافته‌ای بنگر %~% تا بر شنوده هست گوا بینا(@)(@@) 4 چون دو گوا گذشت بر آن دعوی %~% آنگاه راست گوی 
