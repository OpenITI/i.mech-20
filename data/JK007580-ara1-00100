ms81	 %~% لواتي تحسن حفظ الوداد(@)(@@) 19 ما نسيتن هالكا في الأوان ال %~% أودى من قبل هلك إياد ،(@)(@@) 21 فتسلبن واستعرن جميعا %~% من قميص الدجى ، ثياب حداد PageV01P396(@)(@@) 22 ثم غردن في المآتم ، واندبن %~% ن بشجو مع الغواني الخراد(@)(@@) 23 قصد الدهر من أبي حمزة الاو %~% اب مولى حجى ، وخدن اقتصاد ،(@)(@@) 24 وفقيها ، أفكاره شدن ، للنع %~% مان ، ما لم يشده شعر زياد(@)(@@) 25 فالعراقي ، بعده ، للحجاز %~% قليل الخلاف سهل القياد ،(@)(@@) 26 وخطيبا لو قام بين وحوش %~% علم الضاريات بر النقاد ،(@)(@@) 27 راويا للحديث ، لم يحوج المع %~% من صدقه إلى الإسناد ،(@)(@@) 28 أنفق العمر ناسكا يطلب العلم %~% م بكشف عن أصله ، وانتقاد(@)(@@) 29 مستقى الكف من قليب زجاج %~% بغروب اليراع ، ماء مداد(@)(@@) 30 ذا بنان ، لا تلمس الذهب الأح %~% زهدا في العسجد المستفاد ،(@)(@@) 32 واغسلاه بالدمع ، إن كان طهرا ، %~% وادفناه بين الحشى والفؤاد PageV01P397(@)(@@) 33 واحبواه الاكفان مع ورق المصحف %~% كبرا عن أنفس الأبراد ،(@)(@@) 34 واتلوا النعش بالقراءة والتس %~% بيح ، لا بالنحيب والتعداد(@)(@@) 35 أسف غير نافع ، واجتهاد %~% لا يودي إلى غناء اجتهاد .(@)(@@) 36 طالما أخرج الحزين جوى الحز %~% ن إلى غير لائق بالسداد(@)(@@) 37 مثل ما فاتت الصلاة سليما %~% ن فانحنى على رقاب الجياد ،(@)(@@) 38 وهو من سحرت له الإنس والجن %~% ن ، بما صح من شهادة صاد(@)(@@) 39 خاف غدر الأنام ، فاستودع الري %~% ح سليلا ، تغذوه در العهاد(@)(@@) 40 وتوخى له النجاة وقد أيقن %~% أن الحمام بالمرصاد ،(@)(@@) 41 فرمته به على جانب الكر %~% سي أم اللهيم أخت النآذ .(@)(@@) 42 كيف أصبحت في محلك بعدي %~% يا جديرا مني بحسن افتقاد ، PageV01P398(@)(@@) 43 قد أقر الطبيب عنك بعجز ؛ %~% وتقضى تردد العواد(@)(@@) 44 وانتهى اليأس منك ، واستشعر الوج %~% بان لا معاد حتى المعاد ،(@)(@@) 45 هجد الساهرون حولك للتمريض %~% ويح لأعين الهجاد .(@)(@@) 46 انت من أسرة مضوا غير مغرو %~% رين من عيشة بذات ضماد(@)(@@) 47 لا يغيركم الصعيد وكونوا %~% فيه مثل السيوف في الاغماد ،(@)(@@) 48 فعزيز علي خلط الليالي %~% رم أقدامكم برم الهوادي(@)(@@) 49 %~% بين وافقت رأيه في المراد 
ms82	(@)(@@) 50 ورأيت الوفاء للصاحب الأو %~% ول ، من شيمة الكريم الجواد(@)(@@) 51 وخلعت الشباب غضا فيا %~% تك أبليته مع الأنداد(@)(@@) 52 فاذهبا خير ذاهبين حقيقين %~% ن بسقيا روائح وغواد PageV01P399(@)(@@) 53 ومراث ، لو أنهن دموع %~% لمحون السطور في الإنشاد(@)(@@) 54 زحل أشرف الكواكب دارا ، %~% من لقاء الردى ، على ميعاد(@)(@@) 55 ولنار المريخ من حدثان الدهر %~% مطف وان علت في اتقاد ،(@)(@@) 57 فليكن للمحسن الأجل الممدود %~% رغما لآنف الحساد ،(@)(@@) 58 وليطب عن اخيه نفسا وابنا %~% ء أخيه جرائح الاكباد .(@)(@@) 59 وإذا البحر غاض عني ولم أر %~% و فلا ري بادخار الثماد .(@)(@@) 60 كل بيت للهدم ، ما تبتني الور %~% قاء ، والسيد الرفيع العماد(@)(@@) 61 والفتى ظاعن ويكفيه ظل %~% السدر ضرب الاطناب والأوتاد .(@)(@@) 62 بان أمر الإله ، واختلف النا %~% س ، فداع إلى ظلال وهاد ،(@)(@@) 63 والذي حارت البرية فيه %~% حيوان مستحدث من جماد ، PageV01P400(@)(@@) 64 واللبيب اللبيب من ليس يغت %~% ر بكون ، مصيره للفساد(@)PageV01P401(@)(@@) البحر : سريع(@)(@@) 1 أحسن بالواجد من وجده ، %~% صبر يعيد النار في زنده(@)(@@) 2 ومن أبى في الرزء غير الأسى %~% كان بكاه منتهى جهده(@)(@@) 3 فليذرف الجفن على جعفر %~% إذ كان لم يفتح على نده(@)(@@) 4 والشيء لا يكثر مداحه ، %~% إلا إذا قيس إلى ضده(@)(@@) 5 لولا غضا نجد وقلامه ، %~% لم يثن بالطيب على رنده(@)(@@) 6 ليس الذي يبكى على وصله ، %~% مثل الذي يبكي على صده ،(@)(@@) 7 والطرف يرتاح إلى غمضه %~% وليس يرتاح إلى سهده .(@)(@@) 8 كان الأسى فرضا لو أن الردى %~% قال لنا أفدوه فلم نفده .(@)(@@) 9 هل هو إلا طالع للهدى ، %~% سار من الترب إلى سعده ؟(@)(@@) 10 فبات أدنى من يد بيننا ، %~% كأنه الكوكب في بعده PageV01P402(@)(@@) 11 يا دهر ، يا منجز إيعاده %~% والموت لو يعلم في ورده(@)(@@) 12 أي جديد لك لم تبله ؛ %~% واي اقرانك لم ترده ؟(@)(@@) 13 تستأسر العقبان في جوها %~% وتنزل الأعصم من فنده ،(@)(@@) 14 أرى ذوي الفضل واضدادهم %~% يجمعهم سيلك في مده(@)(@@) 15 إن لم يكن رشد الفتى نافعا ، %~% فغيه أنفع من رشده(@)(@@) 16 تجربة الدنيا وأفعالها ، %~% حثت 
ms83	 أخا الزهد على زهده(@)(@@) 17 والقلب ، من أهوائه ، عابد %~% ما يعبد الكافر من بده(@)(@@) 18 إن زماني ، برزاياه لي ، %~% صيرني أمرح في قده(@)(@@) 19 كأننا في كفه ماله %~% ينفق ما يختار من نقده .(@)(@@) 20 لو عرف الإنسان مقداره %~% لم يفخر المولى على عبده ، PageV01P403(@)(@@) 21 أمس الذي مر ، على قربه ، %~% يعجز أهل الأرض عن رده(@)(@@) 22 أضخى الذي أجل في سنه %~% مثل الذي عوجل في مهده ،(@)(@@) 23 ولا يبالي الميت ، في قبره ، %~% بذمه شيع أم حمده(@)(@@) 24 والواحد المفرد ، في حتفه ، %~% كالحاشد المكثر من حشده(@)(@@) 25 وحالة الباكي لآبائه ، %~% كحالة الباكي على ولده .(@)(@@) 26 ما رغبة الحي بابنائه %~% عما جنى الموت على جده(@)(@@) 27 ومجده أفعاله ، لا الذي %~% من قبله كان ولا بعده .(@)(@@) 28 لولا سجاياه وأخلاقه ، %~% لكان كالمعدوم في وجده(@)(@@) 29 تشتاق أيار نفوس الورى ، %~% وإنما الشوق إلى ورده(@)(@@) 30 تدعو بطول العمر افواهنا %~% لمن تناهى القلب في وده . PageV01P404(@)(@@) 31 يسر ، إن مد بقاء له ، %~% وكل ما يكره في مده .(@)(@@) 32 افضل ما في النفس يغتالها ، %~% فنستعيذ الله من جنده .(@)(@@) 33 وآفة العاشق من طرفه %~% وآفة الصارم من حده .(@)(@@) 34 كم صائن عن قبلة خده ، %~% سلطت الأرض على خده ،(@)(@@) 35 وحامل ثقل الثرى جيده %~% وكان يشكو الضعف من عقده .(@)(@@) 36 ورب ظمآن إلى مورد ، %~% والموت لم يعلم في ورده ،(@)(@@) 37 ومرسل الغارة ، مبثوثة ، %~% من أدهم اللون ومن ورده ،(@)(@@) 38 يخوض بحرا نقعه ماؤه ، %~% يحمله السابح في لبده(@)(@@) 39 اشجع من قلب خطية ، %~% على طويل الباع ، ممتده(@)(@@) 40 يرى وقوع الزرق في درعه ، %~% مثل وقوع الزرق في جلده ، PageV01P405(@)(@@) 41 لا يصل الرمح إلى طرفه %~% ولا إلى الحكم من سرده ،(@)(@@) 42 يلقى عليه الطعن القاءك الحسب %~% حسب على المسرع في عقده(@)(@@) 43 بلحظة منه فما دونها %~% يرد غرب الجيش عن قسده ،(@)(@@) 44 أمهله الدهر ، فأودى به %~% مبيضه ، يحدى بمسوده(@)(@@) 45 فيا أخا المفقود في خمسة ، %~% كالشهب ، ما سلاك عن فقده(@)(@@) 46 جاءك هذا الحزن مستجديا %~% أجرك في الصبر ، فلا تجده(@)(@@) 47 سلم 
ms84	 إلى الله ، فكل الذي %~% ساءك ، أو سرك ، من عنده(@)(@@) 48 لا يعدم الأسمر في غابه %~% حتفا ، ولا الأبيض في غمده(@)(@@) 49 إن الذي الوحشة في داره %~% تؤنسه الرحمة في لحده(@)(@@) 50 لا أوحشت دارك من شمسها ؛ %~% ولا خلا غابك من أسده(@)PageV01P406(@)(@@) البحر : كامل تام(@)(@@) 1 يا راعي الود ، الذي أفعاله %~% تغني ، بظاهر أمرها ، عن نعتها(@)(@@) 2 لو كنت حيا ما قطعتك فاعتذر %~% عني إليك لخلة بأمتها ،(@)(@@) 3 فالارض تعلم أني متصرف %~% من فوقها ، وكأنني من تحتها .(@)(@@) 4 غدرت بي الدنيا وكل مصاحب %~% صاحبتهن غدر الشمال بأختها ،(@)(@@) 5 شغفت بوامقها الحريص وأظهرت %~% مقتي ، لما أطهرته من مقتها(@)(@@) 6 لا بد للحسناء من ذام ولا %~% ذام لنفسي غير سيء بختها .(@)(@@) 7 ولقد شركتك في أساك مشاطرا %~% وحللت في وادي الهموم وخبتها(@)(@@) 8 وكرهت ، من بعد الثلاث ، تجشمي %~% طرق العزاء على تغير سمتها(@)(@@) 9 وعلي أن أقضي صلاتي ، بعدها %~% فاتت ، إذا لم آتها في وقتها(@)(@@) 10 إن الصروف كما علمت صوامت %~% عنا ، وكل عبارة في صمتها ، PageV01P407(@)(@@) 11 متفقة للدهر ، إن تستفته %~% نفس امرء عن جرمه يفتها ،(@)(@@) 12 وتكون كالورق الذنوب على الفتى ، %~% ومصابه ريح تهب لحتها .(@)(@@) 13 جازاك ربك بالجنان ، فهذه %~% دار وإن حسنت تغر بسحتها(@)(@@) 14 ضل الذي قال : البلاد قديمة ، %~% بالطبع كانت ، والأنام كنبتها(@)(@@) 15 وأمامنا يوم ، تقوم هجوده ، %~% من بعد إبلاء العظام ورفتها ،(@)(@@) 16 لا بد للزمن المسيء بنا إذا %~% قويت حبال اخوة ، من بتها .(@)(@@) 17 فالله يرحم من مضى متفضلا %~% ويقيك من جزل الخطوب وشختها(@)(@@) 18 ويطيل عمرك للصديق ، فطوله %~% سبب إلى غيظ العداة وكبتها .(@)PageV01P408(@)(@@) البحر : طويل(@)(@@) 1 رويدا عليها ! إنها مهجات ، %~% وفي الدهر محيا لامرء وممات .(@)(@@) 2 أرى غمرات ينجلين عن الفتى ، %~% ولكن توافي بعدها غمرات .(@)(@@) 3 ولا بد للإنسان من سكر ساعة ، %~% تهون عليه ، غيرها ، السكرات(@)(@@) 4 إلا إنما الأيام أبناء واحد ، %~% وهذي الليالي كلها أخوات(@)(@@) 5 فلا تطلبن من عند يوم وليلة %~% خلاف الذي مرت به السنوات .(@)PageV01P409(@)(@@) البحر : طويل(@)(@@) 1 أسألت أتي الدمع فوق أسيل ، %~% ومالت 
ms85	 لظل بالعراق ظليل .(@)(@@) 2 أيا جارة البيت الممنع جاره ، %~% غدوت ، ومن لي عندكم بمقيل ؟(@)(@@) 3 لغيري زكاة من جمال فإن تكن %~% زكاة جمال ، فاذكري ابن سبيل(@)(@@) 4 وأرسلت طيفا خان لما بعثته ، %~% فلا تثقي ، من بعده ، برسول(@)(@@) 5 خيال أرانا نفسه متجنبا ، %~% وقد زار من صافي الوداد وصول .(@)(@@) 6 نسيت مكان العقد من دهش النوى ، %~% فعلقته ، من وجنة ، بمسيل(@)(@@) 7 وكنت ، لأجل السن ، شمس غدية ، %~% ولكنها ، للبين ، شمس أصيل(@)(@@) 8 أسرت أخانا بالخداع وإنه %~% يعد ، إذا اشتد الوغى ، بقبيل(@)(@@) 9 فإن تطلقيه تملكي شكر قومه %~% وإن تقتليه تؤخذي بقتيل(@)(@@) 10 وإن عاش لا قى ذلة ، واختياره %~% وفاة عزيز ، لا حياة ذليل PageV01P410(@)(@@) 11 وكيف يجر الجيش يطلب غارة %~% أسير لمجرور الذيول ، كحيل ؟(@)PageV01P411(@)(@@) البحر : طويل(@)(@@) 1 هو الهجر ، حتى ما يلم خيال ، %~% وبعض صدود الزائرين وصال(@)(@@) 2 فتى تقصر الأبصار عن قسماته ، %~% ولا ستر إلا هيبة وجلال(@)(@@) 3 إلى حارم قاد العتاق ، سواهما ، %~% لها من نشاط بالكماة زمال ،(@)(@@) 4 فجاش عليها البحر ، وهو كتائب ، %~% وخرت إليها الشهب ، وهي نصال(@)(@@) 5 فوراس قوالون للخيل : أقدمي ، %~% وليس على غير الرؤوس مجال ،(@)(@@) 6 لهم أسف يزداد إثر الذي مضى %~% من الدهر ، سلما ، ليس فيه قتال(@)(@@) 7 بأيديهم السمر العوالي كأنما %~% يشب ، على أطرافهن ، ذبال(@)(@@) 8 ومأكولة الأغماد ، مرهفة الظبى ، %~% يراها قراع دائم وصقال ،(@)(@@) 9 حكت رونق البيض الحسان ، وفعلها ، %~% وليس لها إلا الغمود حجال(@)(@@) 10 وجاد عليها الضرب والركض ، بعدما %~% أضر بها مطل ، وطال سؤال PageV01P412(@)(@@) 11 فسيف له غمد من الدم قانئ ، %~% وطرف له ، مما يثير ، جلال(@)(@@) 12 وكيف لقاء ابن الحسين مخالف ، %~% يحدث عن أفعاله ، فيهال(@)(@@) 13 بني الغدر هل ألفيتم الحرب مرة %~% وهل كف طعن عنكم ونضال ؟(@)(@@) 14 وهل أظلمت سحم الليالي عليكم ، %~% وما حان من شمس النهار زوال ؟(@)(@@) 15 وهل طلعت شعث النواصي عوابسا %~% رعال ترامى ، خلفهن ، رعال ؟(@)(@@) 16 لها عدد الرمل المبر على الحصى %~% ولكنها عند اللقاء جبال(@)(@@) 17 فإن تسلموا من سورة الحرب مرة %~% وتعصمكم شم الأنوف ، طوال(@)(@@) 18 ففي 
ms86	 كل يوم غارة مشمعلة ، %~% وفي كل عام غزوة ونزال .(@)(@@) 19 خذوا الآن ما يأتيكم بعد هذه ، %~% ولا تحسبوا ذا العام ، فهو مثال ،(@)(@@) 20 ألا رب أعداء غذاهم ، فأذعنوا ، %~% فعاد ، وهم ، فيما لديه ، عيال PageV01P413(@)(@@) 21 وفي الخيل عن ماء المخاضة عفة ، %~% وهن إلى ماء النفوس نهال ،(@)(@@) 22 وقد فل من فرسانهن صوارم %~% وحطم في لباتهن إلال ،(@)(@@) 23 يردن دماء الروم ، وهي غريضة ، %~% ويتركن ورد الماء ، وهو زلال(@)(@@) 24 تجاوزه بالوثب كل طمرة %~% تمازج في فيها دم ورؤال ،(@)(@@) 25 تدانت به الأقران حتى تجاثأت ، %~% كأن قتال الفيلقين جدال ،(@)(@@) 26 وقد علم الرومي أنك حتفه ، %~% على أن بعض الموقتنين يخال ،(@)(@@) 27 فما كبروا ، حتى يكونوا فريسة ، %~% ولا بلغوا أن يقصدوا ، فينالوا(@)(@@) 28 فإن أبا الأشبال يخشاه مثله ، %~% ويأمن منه آرض ونمال .(@)(@@) 29 ولم يصرهن العز منه %~% وإنما صراهن منه أنهن ضئال .(@)(@@) 30 فلا زلت بدرا كاملا في ضيائه ، %~% على أنه عند التمام هلال ، PageV01P414(@)(@@) 31 فما لخميس لم تقده عرامة ، %~% ولا لزمان لست فيه جمال ،(@)(@@) 32 وفي ، لمن رام المعالي ، بقية ، %~% وعندي ، إذا عي البليغ ، مقال(@)PageV01P415(@)(@@) البحر : طويل(@)(@@) 1 أليس الذي قاد الجياد مغذة ، %~% روافل في ثوب من النقع ذائل ،(@)(@@) 2 يكاد يذيب اللجم تأثير حقدها ، %~% فيمنعها ، من ذاك ، برد المناهل(@)(@@) 3 وما وردتها من صدى ، غير أنها %~% تريد بورد الماء حفظ المساحل(@)(@@) 4 وعادت كأن الرثم ، بعد ورودها ، %~% أعرن احمرار الأفق فوق الجحافل(@)(@@) 5 ومهما يكن يحسبه حثا على الندى %~% فيغدو على أمواله بالغوائل(@)(@@) 6 فما ناح قمري ، ولا هب عاصف %~% من الريح ، إلا خاله صوت سائل(@)(@@) 7 أطاعك هذا الخلق خوفا ورغبة ؛ %~% فوا عجبا من تغلب ابنة وائل(@)(@@) 8 أكان لها ، في غير عدنان ، نسبة ، %~% فتأمل أن تعصيك دون القبائل ؟(@)(@@) 9 بدوسر جاورت الفرات ، مكرما %~% كأنك نجم في علو المنازل ،(@)(@@) 10 فزينتماها في البلاد ، وزادها %~% أحقكما بالفضل من كل فاضل ، PageV01P416(@)(@@) 11 إذا عد خلخالا لها ، كنت تاجها ، %~% ولم تزل التيجان فوق الخلاخل(@)(@@) 12 لأمر أحل الزج في عقب القنا %~% ورفعت الخرصان فوق 
ms87	 العوامل(@)(@@) 13 تنازع فيك الشبه بحر وديمة ، %~% ولست إلى ما يزعمان بمائل(@)(@@) 14 إذا قيل بحر فهو ملح مكدر ، %~% وأنت نمير الجود عذب الشمائل ،(@)(@@) 15 ولست بغيث ، فوك للدر معدن ، %~% ولم نلف درا في الغيوث الهواطل(@)(@@) 16 إذا ما أخفت المرء جن ، مخافة ، %~% فأيقن أن الأرض كفة حابل ،(@)(@@) 17 يرى نفسه ، في ظل سيفك ، واقفا ، %~% إليك ، الأماني ، ما حلمت بغائل(@)(@@) 18 يظن سنيرا ، من تفاوت لحظه ، %~% ولبنان ، سارا في القنا والقنابل(@)(@@) 19 إذا أجأ وافى ، يجدد عهده %~% بنا ، أم تراها زورة من مواسل ؟(@)(@@) 20 أتتنا ، من الأتراك ، أعلام طيء ، %~% تقود من السودان حرة راجل PageV01P417(@)(@@) 21 وجاشت ، من الأوزاع ، رملة عالج ، %~% وما شئت من صم الحصى والجنادل(@)(@@) 22 وهيهات ، هيهات ، الجبال صوامت ، %~% وهذا كثير النطق ، جم الصواهل(@)(@@) 23 وإن ركبوا الجرد العتاق لغارة ، %~% بد وافي وثاق ركب نوق وجامل(@)(@@) 24 فكم فارس عوضته ، من جواده ، %~% بأثمن ، إلا أنه غير صاهل .(@)(@@) 25 إذا الناس حلوا شعرهم بنشيدهم ، %~% فدونك مني كل حسناء عاطل(@)(@@) 26 ومن كان يستدعي الجمال بحلية ، %~% فقد البرى والمراسل ،(@)(@@) 27 كأن حراما أن تفارق صارما ، %~% يكون لما أضمرت أول فاعل(@)(@@) 28 فمن صارم بالكف ، يحمل ، كلها ؛ %~% ومن صارم يختص بعض الأنامل ،(@)(@@) 29 فمقبض هذا السيف دون ذبابه ؛ %~% ومقبض ذاك السيف دون الحمائل(@)(@@) 30 فليت اليالي سامحتني بناظر %~% يراك ومن لي بالضحى في الأصائل ؟ PageV01P418(@)(@@) 31 فلو أن عيني متعتها بنظرة(@)(@@) 32 حسامك للأعمار أبرى من الردى ؛ %~% وعفوك للجاني أعز المعاقل(@)PageV01P419(@)(@@) البحر : متقارب تام(@)(@@) 1 لتذكر قضاعة أيامها ؛ %~% وتزه بأملاكها حمير ،(@)(@@) 2 فعامل كسرى على قرية %~% من الطف ، سيدها المنذر(@)(@@) 3 فهلا تقل بغاة اللجين ، %~% ونائلك الذهب الأحمر ؟(@)(@@) 4 ومن يطلب الدر في لجة %~% ومن فيك أشرفه ينثر ؟(@)(@@) 5 شغلت ، على المرء ، من %~% اثنتين ، فخصهما المفخر :(@)(@@) 6 يشار إليك بدعاءة ؛ %~% ويثني على فضلك الخنصر ،(@)(@@) 7 فمن أجل ذا رفعت هذه %~% إلى خالق الخلق ، تستغفر ،(@)(@@) 8 لأن لها عنده زلفة ، %~% وفاعل ما فعلت يؤجر .(@)(@@) 9 ترى المعدمين طريق الغنى ، %~% وتهدي إلى الأمن من 
ms88	 يذعر(@)(@@) 10 ومن فضل ذي كسيت خاتما %~% يزين ، وعريت البنصر(@)PageV01P420(@)(@@) البحر : بسيط تام(@)(@@) 1 أرحتني ، فارحت الضمر القودا ، %~% والعجز كان طلابي عندك الجودا(@)(@@) 2 وقد أنست إلى حلمي ، وأوحشني %~% كر العواذل تأنيبا وتفنيدا(@)(@@) 3 ردي كلامك ما أمللت مستمعا ؛ %~% ومن يمل من الأنفاس ترديدا ؟(@)(@@) 4 باتت عرى النوم من عيني محللة ، %~% وبات كوري ، على الوجناء ، مشدودا(@)(@@) 5 كأن جفني سقطا نافر فزع ، %~% إذا أراد وقوعا ، ريع ، أو ذيدا(@)(@@) 6 ظن الدجى فظة الاظفار كاسرة ، %~% والصبح نسرا ، فما ينفك مزؤودا(@)(@@) 7 تناعس البرق ، اي لا أستطيع سرى ، %~% فنام صحبي ، وأمسى يقطع البيدا(@)(@@) 8 كأنه غار منا أن نصاحبه ، %~% وخاف أن نتقاضاك المواعيدا(@)(@@) 9 من يخبر الليل ، إذ جنت حنادسه ، %~% والرمل عني ، لما طل أو جيدا(@)(@@) 10 أني أراح لأصوات الحداة به ، %~% وللركائب يخبطن الجلاميدا PageV01P421(@)(@@) 11 كأنهن غروب ، ملؤها تعب ، %~% فهن يمتحن بالأرسان ، تقويدا(@)PageV01P422(@)(@@) البحر : كامل تام(@)(@@) 1 سنح الغراب ، لنا فبت أعيفه ، %~% خبرا ، أمض من الحمام لطيفه(@)(@@) 2 زعمت غوادي الطير أن لقاءها %~% بسل ، تنكر ، عندنا ، معروفه(@)(@@) 3 ولقد ذكرتك يا أمامة ، بعدما %~% نزل الدليل إلى التراب يسوفه(@)(@@) 4 والعيس تعلن بالحنين اليكم %~% ولغامها ، كالبرس ، طار نديفه(@)(@@) 5 فنسيت ما كلفتنيه ، طالما %~% كلفتني ما ضرني تكليفه(@)(@@) 6 وهواك عندي كالغناء ، لأنه %~% حسن لدي ثقيله وخفيفه(@)PageV01P423(@)(@@) البحر : كامل تام(@)(@@) 1 النار ، في طرفي تبالة ، أنؤر ، %~% رقدت ، فأيقظها ، لخولة ، معشر(@)(@@) 2 طابت لطيب الموقدين ، كأنما %~% سمر ، تروح به الحواطب ، مجمر(@)(@@) 3 يتهللون طلاقة ، وكلومهم %~% ينهل منهن النجيع الأحمر(@)(@@) 4 لا يعرفون سوى التقدم آسيا ،(@)(@@) 5 من كل من لولا تسعر بأسه ، %~% لا خضر في يمنى يديه الأسمر(@)(@@) 6 يذكي تلهب ذهنه أوقاته ، %~% فكأنما هو بالغدو مهجر(@)(@@) 7 وضجيع طفلهم الحسام وإن توي %~% منهم فتى ، فمع المهند يقبر(@)(@@) 8 فكأنهم يرجون لقيا ربهم %~% بالبيض ، تشفع عنده وتكفر(@)(@@) 9 أنا من أقام الحرف ، وهي كأنها %~% نون بدارك ، والمعالم أسطر(@)(@@) 10 بالسعد جادتك السماء لتسعدي ، %~% والغفر عل ذنوب أهلك تغفر PageV01P424(@)(@@) 11 غصن الشباب عصى السحاب فلم 
ms89	 يعد %~% ذا خضرة ، إذ كل غصن أخضر(@)(@@) 12 قد اورقت عمد الخيام وأعشبت %~% شعب الرحال ، ولون رأسي أغبر(@)(@@) 13 ولقد سلوت عن الشباب كما سلا %~% غيري ، ولكن للحزين تذكر(@)(@@) 14 ونسيت ما منع العهوى بتنوفة %~% عقم الجديل بها ، وأعقب أخدر(@)(@@) 15 سلت سيوف سرابها لترو عني ، %~% وسواي عاذل من يراع ويذعر(@)(@@) 16 ليت اللوائم عنك أسرة شدقم %~% ببطاح مكة للمناسك تنحر(@)PageV01P425(@)(@@) البحر : كامل تام(@)(@@) 1 إن كنت مدعيا مودة زينب %~% فاسكب دموعك يا غمام ، ونسكب(@)(@@) 2 فمن الغمائم ، لو علمت ، غمامة %~% سوداء ، هدباها نظير الهيدب(@)(@@) 3 يا سعد أخبية الذين تحملوا ، %~% لما ركبت دعيت سعد المركب(@)(@@) 4 غادرتني كبنات نعش ثابتا ، %~% وجعلت قلبي مثل قلب العقرب(@)(@@) 5 بالجفن بارزت القلوب ، وإنما %~% بالنصل يبرز كل شهم محرب(@)(@@) 6 كم قبلة لك في الضمائر ، لم أخف %~% فيها الحسابن لأنها لم تكتب(@)(@@) 7 ومتى خلوت بها ، من أجلك ، لم أرع %~% فيها بطلعة عاذل من مرقب(@)(@@) 8 ورسول أحلام إليك بعثته ، %~% فأتى ، على يأس ، بنجح المطلب(@)(@@) 9 وكأن حبك قال : حظك في السرى ، %~% فالطم بأيدي العيس وجه السبب(@)(@@) 10 واهجم على جنح الدجى ، ولو انه %~% أسد يصول ، من الهلال بمخلب PageV01P426(@)(@@) 11 وهجيرة ، كالهجر ، موج سرابها ، %~% كالبحر ، ليس لمائها من طحلب(@)(@@) 12 أوفى بها الحرباء عودي منبر ، %~% للظهر إلا أنه لم يخطب(@)(@@) 13 فكأنه رام الكلام ، ومسه %~% عي فأسعده لسان الجندب(@)(@@) 14 كلفتها جدلية رملية %~% نضبت ولم تلحق بأهل التنضب(@)PageV01P427(@)(@@) البحر : متقارب تام(@)(@@) 1 توقتك سرا وزارت جهارا ، %~% وهل تطلع الشمس إلا نهارا ؟(@)(@@) 2 كأن الغمام لها عاشق %~% يساير هودجها أين ، سارا ،(@)(@@) 3 وبالأرض من حبها صفرة ، %~% فما تنبت الأرض إلا بهارا .(@)(@@) 4 فدتك ندامى لنا كالقسي ، لا %~% يستقيمون إلا ازورارا(@)(@@) 5 اذبت الحصى كمدا إذا رمي %~% ت ، بالدر ، يوم رميت الجمارا(@)PageV01P428(@)(@@) البحر : وافر تام(@)(@@) 1 تفهم ، يا صريع البين ، بشرى %~% أتت من مستقل مستقيل(@)(@@) 2 دعيت بصارع فتداركته %~% مبالغة ، فرد إلى فعيل(@)(@@) 3 كما قالوا : عليم ، إذ أرادوا %~% تناهي العلم في الله الجليل(@)(@@) 4 
ms90	 قد استحييت منك ، فلا تكلني %~% إلى شيء ، سوى عذر جميل(@)(@@) 5 وقد أنقذت ما حقي عليه %~% قبيح الهجو ، أو شتم الرسول(@)(@@) 6 وذاك ، على انفرادك ، قوت يوم ، %~% إذا أنفقت إنفاق البخيل(@)(@@) 7 فكيف ، وأنت علوي السجايا ، %~% فليس ، إلى اقتصادك ، من سبيل(@)(@@) 8 فهب أني دعوتك للتصافي %~% على غير المعتقة الشمول(@)(@@) 9 على راح من الآداب صرف %~% ونقل من بسيط أو طويل ،(@)(@@) 10 وقد يقوي الفصيح ، فلا تقابل %~% ضعيف البر إلا بالقبول ، PageV01P429(@)(@@) 11 فان الوزن وهو أتم وزن %~% يقام صغاه بالحرف العليل ،(@)(@@) 12 فإن يك ما بعثت به قليلا ، %~% فلي حال أقل من القليل .(@)PageV01P430(@)(@@) البحر : طويل(@)(@@) 1 أوالي نعت الراح ، من شعف بها ، %~% كانك خال للمدامة أو عم(@)(@@) 2 وأنت أبوها إن غدت كرمية ؛ %~% وإن سكنت راء فوالدها كرم(@)(@@) 3 فكيف طرقت الشأم ، والشأم دونه %~% جبال تردي بالرباب وتعتم ؟(@)(@@) 4 ومن بعض جارات العراقين بابل %~% وعانة ، والصهباء عندها جم(@)(@@) 5 ألم تر أن الأولين إليهما %~% نموا حسب الخمر ، الذي رفع النظم ؟(@)(@@) 6 فإياك والكأس التي بت ناعتا ، %~% فما شربها إلا السفاهة والاثم(@)(@@) 7 واحلف ما حطت مكانك غربة %~% ولا سودت علياك أثوابك السحم(@)(@@) 8 وإن الغنى والفقر في مذهب النهى %~% لسيان ، بل أعفى من الثروة العدم(@)(@@) 9 وما نلت مالا ، قط ، إلا ومال بي ؛ %~% ولا درهما إلا ودر بي الهم ،(@)(@@) 10 لك الخير ! قد أنفذت ما هو ملبسي %~% حياء ، وعند الله من قائل علم ، PageV01P431(@)(@@) 11 ول أنه أضعاف أضعاف مثله ، %~% من التبر لم يثبت له في نداك اسم(@)(@@) 12 وأهون به في راحة أريحية %~% كآخر ماض ، ليس من شأنه الضم(@)(@@) 13 فمني تفصير ، ومنك تفضل %~% بعذر ، فلا حمد لدي ولا ذم(@)(@@) 14 فلو كنت شعرا كنت أحسن منشد %~% سليم القوافي ، لا زحاف ولا خرم(@)PageV01P432(@)(@@) البحر : طويل(@)(@@) 1 طربن لضوء البارق المتعالي %~% ببغداد ، وهنا ، ما لهن وما لي(@)(@@) 2 سمت نحوه الأبصار ، حتى كأنها ، %~% بناريه من هنا وثم ، صوالي(@)(@@) 3 إذا طال عنها سرها لو رؤوسها %~% تمد إليه في رؤوس عوالي .(@)(@@) 4 
ms91	 تمنت قويقا والصراة حيالها %~% تراب لها من أينق وجمال(@)(@@) 5 إذا لاح إيماض سترت وجوهها ، %~% كأني عمرو ، والمطي سعالي(@)(@@) 6 وكم هو نضو أن يطير مع الصبا %~% إلى الشام لولا حبسه بعقال ،(@)(@@) 7 ولولا حفاظي قلت للمرء صاحبي : %~% بسيفك قيدها فلست أبالي ،(@)(@@) 8 أأبغي لها شرا ، ولم أر مثلها %~% سفاير ليل ، أو سفائن آل(@)(@@) 9 وهن منيفات إذا جبن واديا %~% توهمننا ، منهن ، فوق جبال(@)(@@) 10 لقد زارني طيف الخيال فهاجني ، %~% فهل زار هذي الإبل طيف خيال ؟ PageV01P433(@)(@@) 11 لعل كراها قد أراها جذابها %~% ذوائب طلح بالعقيق وضال(@)(@@) 12 ومسرحها في ظل أحوى ، كأنها ، %~% إذا أظهرت فيه ذوات حجال(@)(@@) 13 حلمنا بأسنان الكهول ، وهذه %~% شوارف تزهاها حلوم إفال(@)(@@) 14 ترى العود منها باكيا ، فكأنه %~% فصيل حماه الخلف رب عيال .(@)(@@) 15 فآبك هذا اخضر الحال معرضا %~% وأزرق ، فاشرب وارع ناعم بال(@)(@@) 16 ستنسى مياها بالفلاة نميرة %~% كنسيانها وردا بعين أثال(@)(@@) 17 وان ذهلت عما أجن صدورها %~% فقد ألهبت وجدا نفوس رجال(@)(@@) 18 ولو وضعت في دجلة الهام لم تفق %~% من الجرع إلا والقلوب خوال .(@)(@@) 19 تذكرن مرا بالمناظر آجنا %~% عليه من الأرطى فروع هدال ،(@)(@@) 20 وأعجبها خرق العضاه أنوفها %~% بمثل إبار ، حددت ، ونصال PageV01P434(@)(@@) 21 تلون زبورا في الحنين ، منزلا ، %~% عليهن فيه الصبر غير حلال(@)(@@) 22 وأنشدن من شعر المطايا قصيدة ، %~% وأودعتها في الشوق كل مقال ،(@)(@@) 23 أمن قيل عود أم رواية ، %~% أتتهن عن عم لهن وخال ؟(@)(@@) 24 كأن المثاني والمثالث بالضحى %~% تجاوب في غيد ، رفعن ، طوال(@)(@@) 25 كأن ثقيلا أولا تزدهى به %~% ضمائر قوم ، في الخطوب ، ثقال(@)(@@) 26 بكى سامري الجفن إن لامس الكرى %~% له هدب جفن ، مسه بسجال(@)(@@) 27 فليت سنيرا بان منه ، لصحبتي ، %~% بروقي غزال مثل روق غزال .(@)(@@) 28 ومن لي بأني في جناح غمامة ، %~% تشبهها ، في الجنح ، أم رئال(@)(@@) 29 تهاداني الأرواح حتى تحطني %~% على يد ريح بالفرات شمال ،(@)(@@) 30 فيا برق ! ليس الكرخ داري وإنما %~% رماني إليه الدهر منذ ليال PageV01P435(@)(@@) 31 فهل فيك من ماء المعرة قطرة %~% تغيث بها 
ms92	 ظمآن ليس بسال ؟(@)(@@) 32 دعا رجب جيش الغرام فأقبلت %~% رعال ، ترود الهم ، بعد رعال(@)(@@) 33 يغرن علي ، الليل ، إذ كل غارة %~% يكون لها ، عند الصباح ، توال(@)(@@) 34 ولاح هلال مثل نون أجادها %~% بجاري النضار الكاتب ابن الهلال(@)(@@) 35 فذكرني بدر السماوة ، بادنا ، %~% شفا لاح من بدر السماءة ، بال(@)(@@) 36 وقد دميت خمس لها عنمية ، %~% بإدمانها ، في الأزم ، شوك سيال(@)(@@) 37 تقول ظباء الحزم ، والدمع ناظم %~% على عقد الوعساء ، عقد ضلال(@)(@@) 38 لقد حرمتنا أثقل الحلي أختنا %~% فما وهبت إلا سموط لآلي(@)(@@) 39 فإن صلحت للناظمين دموعنا %~% فأنتن ، منها ، والكثيب حوال(@)(@@) 40 جهلتن أن اللؤلؤ الذوب عندنا %~% رخيص ، وأن الجامدات غوال PageV01P436(@)(@@) 41 ولو كان حقا ما ظننتن ، لاغتدت %~% مسافة هذا البر سيف أوال(@)(@@) 42 أإخواننا ، بين الفرات وجلق ، %~% يد الله ، لا خبرتكم بمحال(@)(@@) 43 أنبئكم أني ، على العهد ، سالم ، %~% ووجهي لما يبتذل بسؤال(@)(@@) 44 وأني تيممت العراق لغير ما %~% تيممه غيلان ، عند بلال(@)(@@) 45 فأصبحت محمودا بفضلي وحده ، %~% على بعد انصاري وقلة مالي .(@)(@@) 46 ندمت على أرض العواصم ، بعدما %~% غدوت بها ، في السوم ، غير مغال(@)(@@) 47 ومن دونها يوم من الشمس عاطل %~% وليل بأطراف الأسنة حال(@)(@@) 48 وشعث مداريها الصوارم والقنا ، %~% وليس لها إلا الكماة فوال(@)(@@) 49 أروح فلا أخشى المنايا وأتقي %~% تدنس عرض ، أو ذميم فعال ،(@)(@@) 50 إذا ما حبال ، من خليل ، تصرمت ، %~% علقت بخل غيره بحبال ، PageV01P437(@)(@@) 51 ولو أنني في هالة البدر قاعد %~% لما هاب يومي رفعتي وجلالي .(@)PageV01P438(@)(@@) البحر : طويل(@)(@@) 1 مغاني اللوى من شخصك اليوم أطلال ، %~% وفي النوم مغنى من خيالك محلال(@)(@@) 2 معانيك شتى ، والعبارة واحد ، %~% فطرفك مغتال ، وزندك مغتال(@)(@@) 3 وأبغضت فيك النخل ، والنخل يانع ، %~% وأعجبني من حبك الطلح والضال(@)(@@) 4 وأهوى لجراك السماوة والقطا %~% ولو أن صنفيه وشاة وعذال(@)(@@) 5 حملت من الشامين اطيب جرعة %~% وأنزرها ، والقوم بالقفر ظلال ،(@)(@@) 6 يلوذ بأقطار الزجاجة ، بعدما %~% أريقت ، لما أهديت في الكثر ، أمثال(@)(@@) 7 فسقيا لكأس من فم مثل خاتم %~% من الدر لم يهمهم بتقبيله خال .(@)(@@) 8 صحبت 
ms93	 كرانا والركاب سفائن %~% كعادك فينا والركائب أجمال ،(@)(@@) 9 أعمت الينا ، أم فعال ابن مريم %~% فعلت ، وهل يعطى النبوة مكسال ؟(@)(@@) 10 كأن الخزامى جمعت لك حلة ، %~% عليك بهافي اللون والطيب سربال PageV01P439(@)(@@) 11 عجبت ، وقد جزت الصراة رفلة ، %~% وما خضلت مما تسربلت إذيال .(@)(@@) 12 متى ينزل الحي الكلابي بالسا ، %~% يحييك عني ظاعنون وقفال ؟(@)(@@) 13 تحية ود ، ما الفرات وماؤه %~% بأعذب منها ، وهو أزرق سلسال(@)(@@) 14 فإن زعموا أن الهجير استشفهم %~% إليها ، فمنها في المزايد أسمال(@)(@@) 15 أتعلم ذات القرط والشنف أنني %~% يشنفني بالزأر أغلب رئبال ؟(@)(@@) 16 فيا دارها بالحزن ، إن مزارها %~% قريب ، ولكن دون ذلك أهوال ؟(@)(@@) 17 إذا نحن أهللنا بنؤيك ساءنا ، %~% فهلا ، بوجه المالكية ، إهلال(@)(@@) 18 تصاحب في البيداء ذئبا وذابلا ، %~% كلا صاحبيها في التنوفة عسال(@)(@@) 19 إذا اعزب الرعيان عنها سوامها %~% أريح عليها ، الليل ، هيق وذيال(@)(@@) 20 تسيء بنا يقظى ، فأما إذا سرت %~% رقادا ، فإحسان إلينا ، وإجمال PageV01P440(@)(@@) 21 بكت ، فكأن العقد نادى فريده : %~% هلم لعقد الحلف قلب وخلخال ،(@)(@@) 22 وهل يحزن الدمع الغريب قدومه %~% على قدم كادت من اللين تنهال ؟(@)(@@) 23 تحلى النقا درين : دمعا ولؤلؤا ؛ %~% وولت أصيلا وهي كالشمس معطال(@)(@@) 24 بأشنب معطار الغريزة مقسم %~% لسائفه ، أن القسيمة متفال(@)(@@) 25 فلا أخلف الدمع الذي فاض شأنها %~% دعاء لها ، بل أخلف النظم لأآل(@)(@@) 26 وغنت لنا في دار سابور قينة %~% من الورق ، مطراب الأصائل ، ميهال(@)(@@) 27 رأت زهرا غضا ، فهاجت بمزهر ، %~% مثانية احشاء لطفن وأوصال(@)(@@) 28 فقلت : تغني ، كيف شئت ، فإنما %~% غناؤك عندي ، يا حمامة ، إعوال(@)(@@) 29 وتحسدك البيض الحوالي قلادة %~% بجيدك فيها من شذا المسك تمثال(@)(@@) 30 ظلمن ، وبيت الله ، كم من قلائد %~% تؤازرها سور لهن وأحجال PageV01P441(@)(@@) 31 فآليت ما تدري الحمائم بالضحى ، %~% أأطواق حسن ، تلك ، أم هن أغلال(@)(@@) 32 بدت حية قصرا ، فقلت لصاحبي : %~% حياة وشر ، بئس ما زعم الفال !(@)(@@) 33 أتبصر نارا أوقدت لخويلد ، %~% ودون سناها ، للنجائب ، إرقال(@)(@@) 34 وأقتال حرب يفقد السلم فيهم %~% على غيرهم أمضى القضاء وإقتال(@)(@@) 35 وعرض فلاة يحرم السيف وسطها ، %~% ألا إن 
ms94	 إحرام الصوارم إحلال(@)(@@) 36 إذا فدحت فالمشرفي زنادها ، %~% وإن هي حشت ، فالعوامل أجذال(@)(@@) 37 تمنيت أن الخمر حلت لنشوة %~% تجهلني ، كيف اطمأنت بي الحال(@)(@@) 38 فأذهل أني بالعراق على شفى %~% رزي الأماني لا أنيس ولا مال(@)(@@) 39 مقل من الأهلين : يسر وأسرة ، %~% كفى حزنا ، بين مشت وإقلال .(@)(@@) 40 طويت الصبا طي السجل وزارني %~% زمان له بالشيب حكم وأسجال PageV01P442(@)(@@) 41 متى سألت بغداد عني وأهلها %~% فإني عن أهل العواصل سأآل(@)(@@) 42 إذا جن ليلي جن لبي ، وزائد %~% خفوق فؤادي ، كلما خفق الآل(@)(@@) 43 وماء بلادي كان أنجع مشربا ، %~% ولو أن ماء الكرخ صهباء جريال(@)(@@) 44 حروف سرى جاءت لمعنى اردته %~% برتني أسماء لهن وأفعال(@)(@@) 45 يحاذرن من لدغ الأزمة ، لا اهتدى %~% مخبرها أن الأزمة أصلال(@)(@@) 46 فيا وطني ! إن فاتني بك سابق ، %~% من الدهر ، فلينعم لساكنك البال(@)(@@) 47 فإن أستطع في الحشر آتك زائرا ؛ %~% وهيهات ، لي يوم القيامة أشغال(@)(@@) 48 وكم ماجد في سيف دجلة لم أشم %~% له بارقا ، والمرء كالمزن هطال(@)(@@) 49 من الغر ، تراك الهواجر ، معرض %~% عن الجهل قذاف الجواهر مفضال(@)(@@) 50 سيطلبني رزقي ، الذي لو طلبته %~% لما زاد ، والدنيا حظوظ وإقبال PageV01P443(@)(@@) 51 إذا صدق الجد افترى العم ، للفتى ، %~% مكارم ، لا تكري ، وإن كذب الخال(@)PageV01P444(@)(@@) البحر : كامل تام(@)(@@) 1 أودى ، فليت الحادثات كفاف ، %~% مال المسيف وعنبر المستاف ،(@)(@@) 2 الطاهر الآباء والابناء وال %~% أثواب والآراب والآلاف(@)(@@) 3 رغت الوعود ، وتلك هدة واجب %~% جبل هوى في آل عبد مناف(@)(@@) 4 بخلت ، فلما كان ليلة فقده ، %~% سمح الغمام بدمعه الذراف(@)(@@) 5 ويقال إن البخر غاض وإنها %~% ستعود سيفا لجة الرجاف(@)(@@) 6 ويحق في رزء الحسين تغير الحرسين ، %~% الحسين ، تغير ال(@)(@@) 7 ذهب الذي غدت الذوابل بعد ه %~% رعش المتون كليلة الاطراف ،(@)(@@) 8 وتعطفت لعب الصلال من الأسى ، %~% فالزج عند اللهذم الرعاف(@)(@@) 9 وتيقنت ابطالها مما رأت %~% أن لا تقومها بغمز ثقاف(@)(@@) 10 شغل الفوارس بثها ، وسيوفها %~% تحت القوائم جمة الترجاف PageV01P445(@)(@@) 11 ولو انهم نكبوا الغمود لهالهم %~% كمد الظبي ، وتفلل الأسياف .(@)(@@) 12 طار 
ms95	 النواعب يوم فاد نواعيا ، %~% فندبنه لموافق ومناف(@)(@@) 13 أسف أسف بها وأثقل نهضها %~% بالحزن فهي على التراب هواف(@)(@@) 14 ونعيبها كنحيبها ، وحدادها ، %~% أبدا ، سواد قوادم وخواف(@)(@@) 15 لا خاب سعيك من خفاف أسحم %~% كسحيم الأسدي ، أو كخفاف(@)(@@) 16 من شاعر ، للبين ، قال قصيدة ، %~% يرثى الشريف على روي القاف(@)(@@) 17 جون كبنت الجون يصرخ دائبا ، %~% ويميس في برد الحزين الضافي(@)(@@) 18 عقرت ركائبك ابن دأية غاديا %~% أي امرئ نطق وأي قواف(@)(@@) 19 بنيت على الإيطاء سالمة من %~% الإقواء ، والإكفاء ، والإصراف(@)(@@) 20 حسدته ملبسه البزاة ومن لها %~% لما نعاه لها ، بلبس غداف PageV01P446(@)(@@) 21 والطير أغربة ، عليه بأسرها ، %~% فتخ السراة ، وساكنات لصاف(@)(@@) 22 هلا استعاض من السرير جواده %~% وثاب كل قرارة ونياف ؟(@)(@@) 23 هيهات صادم للمنايا عسكرا %~% لا ينثني بالكر والإيجاف(@)(@@) 24 %~% معه ، فذاك له خليل واف ؟(@)(@@) 25 إن زاره الموتى كساهم في البلى %~% أكفان أبلج مكرم الأضياف(@)(@@) 26 والله إن يخلع عليهم حلة %~% يبعث إليه بمثلها أضعاف(@)(@@) 27 نبذت مفاتيح الجنان ، وإنما %~% رضوان بين يديه للإتحاف(@)(@@) 28 يا لابس الدرع الذي هو تحتها ، %~% بحر ، تلفع في غدير صاف(@)(@@) 29 بيضاء زرق السمر واردة لها ، %~% ورد الصوادي الورق زرق نطاف(@)(@@) 30 والنبل تسقط فوقها ونصالها %~% كالريش ؛ فهو على رجاها طاف PageV01P447(@)(@@) 31 يزهى إذا حرباؤها صلي الوغى %~% حرباء كل هجيرة مهياف(@)(@@) 32 فلذاك تبصره لكبر عاده %~% يوفي على جذل ، بكل قذاف(@)(@@) 33 الركب إثرك آجمون لزادهم ، %~% واللهج صادفة عن الأخلاف(@)(@@) 34 والآن ألقى المجد أخمص رجله ، %~% لم يقتنع جزعا بمشية حاف(@)(@@) 35 تكبيرتان حيال قبرك للفتى ، %~% محسوبتان بعمرة وطواف(@)(@@) 36 لو تقدر الخيل التي زايلتها %~% أنحت بايديها على الأعراف(@)(@@) 37 فارقت دهرك ساخطا أفعاله ،(@)(@@) 39 هلا دفنتم سيفه في قبره ، %~% معه ، فذاك له خليل واف ؟(@)(@@) 52 فارقت دهوك ساخطا أفعاله ، %~% وهو الجدير بقلة الإنصاف(@)(@@) 53 ولقيت ربك ، فاسترد لك الهدى %~% ما نالت الأيام بالإتلاف PageV01P448(@)(@@) 54 وسقاك أمواه الحياة مخلدا ؛ %~% وكساك شرخ شبابك الأفواف(@)(@@) 55 أبقيت فينا كوكبين سناهما %~% في الصبح والظلماء ليس بخاف(@)(@@) 56 
ms96	 متأنقين وفي المكارم أرتعا ، %~% متألقين بسؤدد وعفاف(@)(@@) 57 قدرين في الأرداء ، بل مطرين في ال %~% إجداء ، بل قمرين في الأسداف(@)(@@) 58 رزقا العلاء ، فاهل نجد كلما %~% نطقا الفصاحة مثل أهل دياف(@)(@@) 59 ساوى الرضي المرتضى وتقاسما %~% خطط العلى بتناصف وتصاف(@)(@@) 60 حلفا ندى سبقا وصلى الأطهر %~% المرضي ، فيا لثلاثة أحلاف(@)(@@) 61 أنتم ذو النسب القصير فطولكم %~% باد على الكبراء والأشراف(@)(@@) 62 والراح إن قيل ابنة العنب اكتفت %~% بأب عن الأسماء والأوصاف(@)(@@) 63 ما زاغ بيتكم الرفيع ، وإنما %~% بالوجد أدركه خفي زحاف PageV01P449(@)(@@) 64 والشمس دائمة البقاء وإن تنل %~% بالشكو فهي سريعة الأخطاف .(@)(@@) 65 ويخال موسى جدكم ، لجلاله %~% في النفس صاحب سورة الأعراف(@)(@@) 66 الموقدي نار القرى الآصال وال %~% أسحار ، بالأهضام والأشعاف(@)(@@) 67 حمراء ساطعة الذوائب في الدجى %~% ترمي بكل شرارة كطراف(@)(@@) 68 نار لها ضرمية ، كرمية ، %~% تأريثها إرث عن الأسلاف(@)(@@) 69 تسقيك والأري الضريب ولو عدت %~% نهي الإله لثلثت بسلاف(@)(@@) 70 يمسي الطريد أمامها وكأنه %~% أسد الشرى أو طائر بشراف(@)(@@) 71 وإذا تضيفت النعام ضياءها %~% حميل الهبيد لها مع الألطاف(@)(@@) 72 مفتنة في ظلها وحرورها ، %~% تغنيك في المشتى وفي المصطاف(@)(@@) 73 زهراء يحلم في العواصف جمرها %~% وتقر ، إلا هزة الأعطاف PageV01P450(@)(@@) 74 سطعت فما يستطيع إطفاء لها %~% زحل ، ونور الحق ليس بطاف(@)(@@) 75 تصل الوقود ولا خمود ولو جرى %~% باليم صوب الوابل الغراف(@)(@@) 76 شبت بعالية العراق ونورها %~% يغشى منازل نائل وإساف(@)(@@) 77 وقدورهم مثل الهضاب رواكدا ؛ %~% وجفانهم كرحيبة الأفياف(@)(@@) 78 من كل جائشة العشي مفيئة %~% بالمير جير مرافد وصحاف(@)(@@) 79 دهماء ، راكبة ثلاثة أجبل %~% عظما ، وإن حسبت ثلاث أثاف(@)(@@) 80 يا مالكي سرح القريض أتتكما %~% مني حمولة مسنتين عجاف(@)(@@) 81 لا تعرف الورق الجين وإن تسل %~% تخبر عن القلام والخذراف(@)(@@) 82 وأنا الذي أهدي أقل بهارة %~% حسنا حسن روضة مئناف(@)(@@) 83 أوضعت في طرق التشرف ساميا %~% بكما ، ولو لم أسلك طريقي العافي(@)PageV01P451(@)(@@) البحر : وافر تام(@)(@@) 1 من نزل السماك فحل مهدا %~% تغذيه ، بدرتها ، الثدي(@)(@@) 2 أهل بصوته ، فأهل شكرا %~% به الأقوام 
ms97	 ، وافتخر الندي(@)(@@) 3 بيوم قدومه وجبت علينا ال %~% النذور وسيق للبيت الهدي(@)(@@) 4 كني محمد ! نسبي مفيدي %~% ودادك ، والهوى أمر بدي(@)(@@) 5 وسر المجد مولود كريم %~% أبان وفوده خبر جلي(@)(@@) 6 علو زائد بأبي علي ، %~% أتاك ، بفضله ، الله العلي(@)(@@) 7 بنو الفهم ، الذين بنى علاهم %~% أبو الفهم الهمام الهبرزي(@)(@@) 8 كأن ضيوفهم ، والنار تذكى %~% لهم ، بتوقد الشعرى ، صلي(@)(@@) 9 سموا في الجاهلية بالمعالي %~% وزادوا بعدما بعث النبي(@)(@@) 10 فعاش محمد عمر الثريا ، %~% فإن ثرى الكرام به ثري PageV01P452(@)(@@) 11 وبلغ فيه والده أمورا ، %~% عدوهما بهما شرق ردي(@)(@@) 12 هناء من غريب ، أو قريب ، %~% كلا وصفيه حق لا فري(@)(@@) 13 ولولا ما تكلفنا الليالي %~% لطال القول ، واتصل الروي(@)(@@) 14 ولكن القريض له مغان ، %~% وأولاها به الفكر الخلي(@)(@@) 15 إذا نأت ، العراق ، بنا المطايا ، %~% فلا كنا ولا كان المطي(@)(@@) 16 على الدنيا السلام ، فما حياة ، %~% إذا فارقتكم إلا نعي(@)(@@) 17 وشيدوا بيت مكرمة وعز %~% له بمحمد معنى خبي(@)PageV01P453(@)(@@) البحر : طويل(@)(@@) 1 نبي من الغربان ليس على شرع %~% يخبرنا أن الشعوب إلى الصدع(@)(@@) 2 أصدقه في مرية وقد امترت %~% صحابة موسى ، بعد آياته التسع(@)(@@) 3 كأن بفيه كاهنا أو منجما %~% يحدثنا عما لقينا من الفجع(@)(@@) 4 وما كان أفعى أهل نجران مثله ، %~% ولكن ، للإنس ، الفضيلة في السمع(@)(@@) 5 وما قام في عليا زغاوة منذر ، %~% فما بال سحم ينتجين إلى بقع !(@)(@@) 6 تلاق تفرى عن فراق تذمه %~% مآق ، وتكسير الصحائح في الجمع(@)(@@) 7 وشكلين ، ما بين الأثافي واحد ، %~% وآخر موف من أراك على فرع .(@)(@@) 8 أتى ، وهو طيار الجناح ، وإن مشى %~% أشاح بما أعيا سطيحا من السجع(@)(@@) 9 يجيب سماويات لون ، كأنما %~% شكرن بشوق أو سكرن من البتع(@)(@@) 10 ترى كل خطباء القميص ، كأنها %~% خطيب ، تنمى في الغضيض ، من الينع PageV01P454(@)(@@) 11 إذا وطئت عودا برجل حسبتها %~% ثقيلة حجل تلمس العودذا الشرع .(@)(@@) 12 متى ذن أنف البرد سر تم فليته %~% عقيب التنائي ، كان عوقب بالجدع(@)(@@) 13 وما أورقت أوتاد دارك فليته %~% وادرة حتى أسقيت سبل الدمع 
ms98	(@)(@@) 14 ذكرت بها قطعا ، من الليل ، وافيا ، %~% مضى ، كمضي السهم أقصر من قطع(@)(@@) 15 وما شب نارا ، في تهامة ، سامر ، %~% يد الدهر ، إلا أب قلبك في سلع(@)(@@) 16 حكت وهي تجلى ناظر السبع اجتلى ، %~% مع الليل ، أكلى ، والركاب على سبع(@)(@@) 17 حملت لها قلب الجبان ولم أزل %~% شجاع الهوى ، لولا رحيل بني شجع(@)(@@) 18 وفي الحي أعرابية الإصل محضة %~% من القوم ، أعرابية القول بالطبع(@)(@@) 19 وقد درست نحو السرى ، فهي لبة ، %~% بما كان من جر البعير ، أو الرفع(@)(@@) 20 ألفت الملا ، حتى تعلمت ، بالفلا ، %~% رنو الطلا أو صنعة الآل في الخدع PageV01P455(@)(@@) 21 ومن يترقب صولة الدهر يلقها %~% وشيكا ، وهل ترضي الأوساد بالوكع ؟(@)(@@) 22 إذا الضبع الشهباء حلت بساحتي %~% نضوت عليها كل موارة الضبع(@)(@@) 23 وقال الوليد : النبع ليس بمثمر ، %~% وأخطأ ، سرب الوحش من ثمر النبع(@)(@@) 24 أودعكم يا أهل بغداد ، والحشا %~% على زفرات ، ما ينين من اللذع(@)(@@) 25 وداع ضنى لم يستقل وإنما %~% تحامل ، من بعد العثار ، على ظلع(@)(@@) 26 إذا أط نسع قلت ، والدوم كاربي : %~% أجدكم ! لم تفهموا طرب النسع(@)(@@) 27 فبئس البديل الشام منكم وأهله %~% على أنهم قومي ، وبينهم ربعي(@)(@@) 28 ألا زودني شربة ولو انني %~% قدرت إذا أفنيت دجلة بالجرع(@)(@@) 29 وأني لنا من ماء دجلة نغبة %~% على الخمس من بعد المفاوز والربع(@)(@@) 30 وساحرة الأطراف ، يجني سرابها ، %~% فتصلب حرباء بريا على جذع PageV01P456(@)(@@) 31 وما الفصحاء الصيد ، والبدو دارها %~% بأفصح قولا من إمائكم الوكع(@)(@@) 32 أدرتم مقالا ، في الجدال ، بألسن ، %~% خلقن فجانبن المضرة للنفع .(@)(@@) 33 ساعرض إن ناجيت من غيركم فتى %~% وأجعل زورا من بناني في سمعي .(@)(@@) 34 غذيت النعام الروح دون مزاركم ، %~% وأسهرني زأر الضراغمة الفدع(@)(@@) 35 وماذا عني النوم خوف وثوبها ، %~% ولكن جرسا حال في أذني سمع .(@)(@@) 36 وكم جبت أرضا ، ما انتعلت بمروها ، %~% وجاوزت أخرى ما شددت لها شسعي(@)(@@) 37 وبت بمستن اليرابيع ، راقدا ، %~% يطوفن حولي : من فرادى ومن شفع(@)(@@) 38 أبيت ، فلم أطعم نقيع فراقكم ، %~% مطاوعة حتى غلبت على النشع(@)(@@) 39 فناديت عنسي 
ms99	 من دياركم : هلا ، %~% وقلت لسقبي ، عن حياضكم ، هدع(@)(@@) 40 صحبت إليكم كل أطلس شاحب %~% ينوط ، إلى هاديه ، أبيض كالرجع PageV01P457(@)(@@) 41 عليه لباس الخلد ، حسنا ونضرة ، %~% ولم يرب إلا في الجحيم من الصنع(@)(@@) 42 وأبرزه من ناره القين أخضرا %~% كأن غيث فيها بالتلهب والسفع(@)(@@) 43 ولولا الوغى ، في الحرب ، أسمع ربه %~% أليل المنايا في المثار من النقع(@)(@@) 44 ويأبى ذباب أن يطور ذبابه ، %~% ولو ذاب من أرجائه عمل الرصع(@)(@@) 45 تلون للأقران ، في هبواته ، %~% تلون غول القفر للعاجز المجع(@)(@@) 46 تقول بدا في سندس أو مورد %~% من اللبس أو عصب يروقك أو نصع(@)(@@) 47 يدر به خلف المنون دم الطلى ، %~% ويكبر عن فطر الولائد والرضع(@)(@@) 48 فيالك من امن تقلده الفتى %~% وبات به الأعداء في خطة بدع .(@)(@@) 49 ولما ضربنا قونس الليل من عل %~% تسرى بنضج الزعفران أو الردع(@)(@@) 50 كأن الدجى نوق عرفن من الونى ، %~% وأنجمها فيها قلائد من ودع PageV01P458(@)(@@) 51 لبست حدادا ، بعدكم ، كل ليلة ، %~% من الدهم ، لا الغر الحسان ولا الدرع(@)(@@) 52 اظن الليالي ، وهو خون غوادر ، %~% بردي إلى بغداد ، ضيقة الذرع(@)(@@) 53 وكان اختياري أن أموت لديكم %~% حميدا ، فما ألفيت ذلك في الوسع(@)(@@) 54 فليت حمامي حم لي في بلادكم %~% وجالت رمامي في رياحكم المسع(@)(@@) 55 وليت قلاصا ، ملعراق خلعنني ، %~% جعلن ، ولم يفعلن ذاك ، من الخلع(@)(@@) 56 فدونكم خفض الحياة فإننا %~% نصبنا المطايا بالفلاة على القطع(@)(@@) 57 تعجلت ، إن لم أثن جهدي عليكم ، %~% سحاب الرزايا وهي صائبة الوقع .(@)PageV01P459(@)(@@) البحر : وافر تام(@)(@@) 1 كفى بشحوب أوجهنا دليلا %~% على إزماعنا ، عنك ، الرحيلا(@)(@@) 2 أبت صنفا النواعب : من نياق %~% وطير ، أن نقيم ، وأن نقيلا(@)(@@) 3 تأملنا الزمان ، فما وجدنا ، %~% إلى طيب الحياة به سبيلا .(@)(@@) 4 ذر الدنيا ، إذا لم تحظ منها ، %~% وكن فيها كثيرا ، أو قليلا(@)(@@) 5 وأصبح واحد الرجلين : إما %~% مليكا في المعاشر ، أو أبيلا(@)(@@) 6 ولو جرت النباهة في طريق ال %~% خمول إلي لاخترت الخمولا(@)(@@) 7 يصرد زاجر الصردان جبنا ، %~% ويوصل حبل من وصل الحبولا(@)(@@) 8 وتقتل أم 
ms100	 ليلى أم عمرو %~% لمن يغدو سميتها قتيلا(@)(@@) 9 أرى الحيوان مشتبه السجايا ، %~% كأن جميعه عدم العقولا(@)(@@) 10 نسيت أبي كما نيست ركابي %~% وتلك الخيل ، أعوج والجديلا PageV01P460(@)(@@) 11 كأن جيادنا في الدار أسرى %~% سكوتا لا وجيف ولا صهيلا(@)(@@) 12 حجول قيونها ، كحجول قين ، %~% أجاد ، من الحديد ، لها كبولا(@)(@@) 13 فما تدري أخلخالا مشوفا %~% يقل الرسغ أم قيدا ثقيلا .(@)(@@) 14 يفجعنا ابن دأية بابن أنس %~% نفارقه ، فلا تبع الحمولا(@)(@@) 15 وقلده الرماة بأرجوان %~% وعاد شبابه رحضا غسيلا(@)(@@) 16 كلفنا بالعراق ونحن شرخ ، %~% فلم نلمم به ، إلا كهولا(@)(@@) 17 وشارفنا فراق أبي علي ، %~% فكان أعز داهية نزولا(@)(@@) 18 سقاه الله ، أبلج فارسيا ، %~% أبت أنوار سودده الأفولا(@)(@@) 19 يعد الثوب زغفا سابريا ، %~% ويرضى الخل هنديا صقيلا(@)(@@) 20 كأن أراقما نفثت سماما %~% عليه ، فعاد مبيضا نحيلا PageV01P461(@)(@@) 21 ومن تعلق به حمة الأفاعي ، %~% يعش ، إن فاته أجل ، عليلا(@)(@@) 22 كأن فرنده ، واليوم حمت %~% افاض بصفحه سجلا سجيلا(@)(@@) 23 تردد ماؤه علوا وسفلا ، %~% وهم ، فما تمكن أن يسيلا(@)(@@) 24 أجاد الهالكي به احتفاظا ، %~% فلم يطق السروب ولا الهمولا(@)(@@) 25 إذا ما كالئ الاضغان يوما %~% رآه رعى به كلأ وبيلا(@)(@@) 26 يكاد سناه يحرق من فراه %~% ويغرق من نجا منه كلولا(@)(@@) 27 فذلك شبه عزمك يا ابن حمد %~% ولكن لا نبو ولا فلولا(@)(@@) 28 لشرفت القوافي والمعاني %~% بلفظك والأخلة والخليلا .(@)(@@) 29 إذا المنهوك فهت به انتصارا %~% له من غيره ، فضل الطويلا(@)(@@) 30 وأنت فكاك دائرتي قريض %~% وهندسة ، حللت بها الشكولا PageV01P462(@)(@@) 31 كملت ، فزد على النعمان ، ملكا ، %~% مزيدك عن أخي ذبيان قيلا(@)(@@) 32 وقد كافأت عن شعر بشعر ، %~% ولكن حاز من بدأ الجميلا(@)(@@) 33 بهرت ويوم عمرك في شروق %~% فدام ضحى ، ولا بلغ الأصيلا(@)(@@) 34 وردنا ماء دجلة خير ماء %~% وزرنا أشرف الشجر ، النخيلا(@)(@@) 35 وزلنا بالغليل ، وما اشتفينا ؛ %~% وغاية كل شيء أن يزولا .(@)(@@) 36 ولو لم ألق غيرك ، في اغترابي ، %~% لكان لقاؤك الحظ الجزيلا(@)(@@) 37 ستحمل ناجيات العيس مني %~% صديقا عن ودادك لن يحولا(@)(@@) 38 يؤمل فيك إسعاف 