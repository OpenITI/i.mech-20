ms4251	 العباس بن عامر، وروى عنه سلمة بن الخطاب.(@)(@@) الكافي: ج 1، ك 4، ب 109، ح 3.(@)(@@) * وروى عن عمر وبن شمر، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 111، ح 14.(@)(@@) وروى عنه سلمة بن الخطاب.(@)(@@) الكافي: ج 1، ك 4، ب 111، ح 38.(@)(@@) * وروى عن محمد بن الحسن الأشعري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 7، ك 2، ب 58، ح 2.(@)(@@) * وروى عن محمد بن عبيد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 3، ب 9، ح 3.(@)(@@) * وروى عن محمد بن علي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 86 (الإستبصار: ج 1، ح 958).(@)(@@) * وروى عن بعض أصحابنا، عن أبي جعفر الثاني عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 91، ح 3.(@)(@@) علي بن شجرة * روى عن أبي عبد الله عليه السلام، وروى عنه يونس.(@)(@@) الروضة: ح 82.(@)(@@) * وروى عن أبي الوفاء المرادي، وروى عنه الحجال.(@)(@@) الكافي: ج 3، ك 3، ب 40، ح 6.(@)(@@) والتهذيب: ج 1، ح 904.(@)(@@) * وروى عن بشير النبال، وروى عنه ابن فضال.(@)(@@) الكافي: ج 5، ك 2، ب 68، ح 3.(@)(@@) والتهذيب: ج 7، ح 60.(@)(@@) * وروى عن محمد بن بكر بن جناح.(@)(@@) الكافي: ج 4، ك 2، ب 9، ح 5. والتهذيب:(@)(@@) ج 4، ح 504 (الإستبصار: ج 2، ح 236).(@)(@@) * وروى عن حفص بن غياث، PageV13P320(@)(@@) وروى عنه علي بن أسباط.(@)(@@) الكافي: ج 5، ك 2، ب 136، ح 5.(@)(@@) * وروى عن عبيد بن زرارة، وروى عنه الحسين بن محمد بن سماعة.(@)(@@) التهذيب: ج 2، ح 997 (الإستبصار:(@)(@@) ج 1، ح 918).(@)(@@) * وروى عن عيسى بن راشد، وروى عنه الحجال.(@)(@@) الكافي: ج 3، ك 3، ب 44، ح 3.(@)(@@) * وروى عن محمد بن مروان، وروى عنه أبو إسماعيل السراج.(@)(@@) الكافي: ج 3، ك 4. ب 32، ح 24.(@)(@@) والتهذيب: ج 2، ح 429.(@)(@@) * وروى عن بعض ولد ميثم، عن أمير المؤمنين عليه السلام، وروى عنه علي بن أسباط.(@)(@@) الكافي: ج 3، ك 4، ب 102، ح 4.(@)(@@) علي بن الصلت * روى عن ابن أخي شهاب بن عبد ربه، وروى عنه النضر بن سويد.(@)(@@) الكافي: ج 6، ك 6، ب 42، ح 2.(@)(@@) * وروى عن إسماعيل بن حبيب، وروى عنه محمد بن جمهور.(@)(@@) الكافي: ج 1، ك 3، ب 23، ح 10.(@)(@@) * وروى عن بكر 
ms4252	 بن محمد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 88 (الإستبصار: ج 1، ح 953).(@)(@@) * وروى عن حكم بن حبيب، وروى عنه محمد بن جمهور.(@)(@@) الكافي: ج 1، ك 3، ب 23، ح 10.(@)(@@) * وروى عن زرعة، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 1، ب 10، ح 2.(@)(@@) وروى عنه الحسين.(@)(@@) التهذيب: ج 5، ح 605.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 5، ح 559. (الإستبصار:(@)(@@) ج 2، ح 881، 885، وفي الأول صدر الحديث، وفي الثاني ذيله)، و 622.(@)(@@) * وروى عن زرعة بن محمد، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 4، ك 2، ب 13، ح 3.(@)(@@) علي بن العباس * روى عن أحمد بن محمد بن أبي نصر، وروى محمد بن أبي عبد الله عمن PageV13P321(@)(@@) ذكره، عنه.(@)(@@) الكافي: ج 1، ك 3، ب 11، ح 4.(@)(@@) * وروى عن إسماعيل بن إسحاق، وروى عنه أحمد بن محمد والكوفي.(@)(@@) الكافي: ج 5، ك 1، ب 1، ح 6. والتهذيب:(@)(@@) ج 6، ح 216.(@)(@@) * وروى عن الحسن بن عبد الرحمان، وروى عنه بعض أصحابنا.(@)(@@) الروضة: ح 57.(@)(@@) وروى عنه علي بن محمد.(@)(@@) الروضة: ح 214، و 431، و 432.(@)(@@) * وروى عن الحسن بن عبد الرحمان الحماني، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 1، ك 3، ب 11، ح 7.(@)(@@) * وروى عن الحسين بن عبد الرحمان، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 2، ك 3، ح 1.(@)(@@) * وروى عن علي بن حماد، وروى عنه علي بن محمد.(@)(@@) الروضة: ح 574.(@)(@@) * وروى عن علي بن ميسر، وروى عنه بعض أصحابنا.(@)(@@) الكافي: ج 1، ك 2، ب 18، ح 7.(@)(@@) * وروى عن القاسم بن الربيع الصحاف، وروى عنه محمد بن إسماعيل البرمكي.(@)(@@) الفقيه، المشيخة: في طريقه إلى محمد بن سنان.(@)(@@) * وروى عن محمد بن زياد، وروى عنه علي بن محمد.(@)(@@) الروضة: ح 199.(@)(@@) علي بن عبد العزيز * روى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 3، ح 360.(@)(@@) وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 23، ح 6.(@)(@@) وروى عنه أبان.(@)(@@) الفقيه: ج 2، ح 947.(@)(@@) وروى عنه ثعلبة.(@)(@@) الكافي: ج 4، ك 2، ب 1، ح 3. والتهذيب:(@)(@@) ج 4، ح 419.(@)(@@) وروى عنه عبد الله بن مسكان.(@)(@@) الكافي: ج 4، ك 3، ب 79، ح 6.(@)(@@) والتهذيب: ج 5، ح 276.(@)(@@) وروى عنه علي بن الحكم.(@)(@@) التهذيب: 
ms4253	 ج 2، ح 1406. PageV13P322(@)(@@) وروى عنه هارون بن حمزة.(@)(@@) الكافي: ج 5، ك 2، ب 8، ح 5. والفقيه:(@)(@@) ج 3، ح 509. والتهذيب: ج 6، ح 885.(@)(@@) * وروى عن أبي غرة، وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 4، ك 3، ب 129، ح 6.(@)(@@) والتهذيب: ج 5، ح 389 (الإستبصار:(@)(@@) ج 2، ح 771).(@)(@@) * وروى عن عبد الحميد الطائي، وروى عنه أبان.(@)(@@) الروضة: ح 321.(@)(@@) * وروى عن مراد بن خارجة، وروى عنه الحسين بن المختار.(@)(@@) الكافي: ج 3، ك 4، ب 74، ح 2.(@)(@@) والتهذيب: ج 3، ح 35 (الإستبصار:(@)(@@) ج 1، ح 1566).(@)(@@) علي بن عبد الله * روى عن أبي عبد الله عليه السلام، وروى عنه عمر وبن عثمان.(@)(@@) الكافي: ج 4، ك 3، ب 28، ح 48.(@)(@@) * وروى عن أبي خديجة، وروى عنه محمد بن علي.(@)(@@) الكافي: ج 5، ك 3، ب 187، ح 4.(@)(@@) * وروى عن أبيه، وروى عنه محمد ابن عيسى بن محمد.(@)(@@) التهذيب: ج 3، ح 239.(@)(@@) * وروى عن سليمان، روى عنه عبد الله ابن جبلة.(@)(@@) التهذيب: ج 9، ح 1156 (الإستبصار:(@)(@@) ج 4، ح 555).(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 3، ك 4، ب 85، ح 13.(@)(@@) والتهذيب: ج 2، ح 25، و 778.(@)(@@) * وروى عن علي بن حسان، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 42، و 43، و 44.(@)(@@) * وروى عن علي بن منصور، وروى عنه الحسن بن الحسين.(@)(@@) الكافي: ج 3، ك 3، ب 83، ح 2.(@)(@@) * وروى عن يزيد بن إسحاق، وروى عنه الحسن بن الحسين.(@)(@@) الكافي: ج 3، ك 4، ب 75، ح 3.(@)(@@) * وروى عن يعقوب بن إبراهيم بن سعد، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 7، ك 2، ب 7، ح 3. والفقيه:(@)(@@) ج 4، ح 656. والتهذيب: ج 9، ح 963. PageV13P323(@)(@@) * وروى مضمرة وروى عنه السياري.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 10.(@)(@@) علي بن عطية * روى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 1، ح 1440.(@)(@@) وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 3، ك 4، ب 7، ح 3، و ج 5، ك 2، ب 76، ح 1، و ج 6، ك 8، ب 21، ح 10. والروضة: ح 360. والتهذيب:(@)(@@) ج 2، ح 118 (الإستبصار: ج 1، ح 997)، و ج 4، ح 515 (الإستبصار:(@)(@@) ج 1، ح 997)، و ج 7، ح 166.(@)(@@) * وروى عن أبي الحسن موسى عليه السلام، وروى عنه محمد بن أبي عمير. 
ms4254	(@)(@@) التهذيب: ج 5، ح 897.(@)(@@) ورأى كتب أبي الحسن عليه السلام متربة، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 2، ك 4، ب 29، ح 9.(@)(@@) * وروى عن أبيه.(@)(@@) الفقيه: ج 2، ح 1417.(@)(@@) * وروى عن خيثمة، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 1، ك 3، ب 2، ح 5، و ج 2، ك 1، ب 119، ح 5.(@)(@@) * وروى عن زرارة، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 6، ح 936، و ج 10، ح 216.(@)(@@) وروى عنه أحمد بن هلال، وأمية بن علي القيسي، ومحمد بن أبي عمير.(@)(@@) التهذيب: ج 5، ح 1052 (الإستبصار:(@)(@@) ج 2، ح 615).(@)(@@) * وروى عن علي بن رئاب، وروى عنه علي بن حسان.(@)(@@) الكافي: ج 1، ك 4، ب 94، ح 3.(@)(@@) * وروى عن هشام بن أحمر، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 2، ك 1، ب 48، ح 26، و ج 5، ك 2، ب 53، ح 7. والتهذيب: ج 7، ح 4.(@)(@@) علي بن عقبة * روى عن أبي جعفر وأبي عبد الله عليهما السلام، وروى عنه ابن فضال.(@)(@@) الكافي: ج 3، ك 5، ب 9، ح 3. والتهذيب:(@)(@@) ج 4، ح 13 (الإستبصار: ج 2، ح 35). PageV13P324(@)(@@) * روى عن أبي عبد الله عليه السلام، وروى عنه أبو محمد الحجال.(@)(@@) التهذيب: ج 7، ح 12.(@)(@@) وروى عنه ابن فضال.(@)(@@) الكافي: ج 1، ك 1، ب 72، ح 3، و ب 75، ح 6 وذيله.(@)(@@) وروى عنه الحسن.(@)(@@) التهذيب: ج 9، ح 871 (الإستبصار:(@)(@@) ج 4، ح 455).(@)(@@) وروى عنه الحسن بن علي بن فضال.(@)(@@) التهذيب: ج 10، ح 774 (الإستبصار:(@)(@@) ج 4، ح 1040).(@)(@@) وروى عنه الحجال.(@)(@@) الكافي: ج 3، ك 1، ب 72، ح 8.(@)(@@) * وروى عن أبي الحسن عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 3، ك 4، ب 25، ح 9.(@)(@@) وروى عنه أبي الحسن الأول عليه السلام، وروى عنه ابن فضال.(@)(@@) الكافي: ج 3، ك 5، ب 2، ح 9.(@)(@@) * وروى عن أبي حمزة، وروى عنه ابن فضال.(@)(@@) الكافي: ج 2، ك 1، ب 77، ح 1.(@)(@@) * وروى عن أبي خالد القماط، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 7، ك 4، ب 1، ح 1.(@)(@@) وروى عنه ابن فضال.(@)(@@) الكافي: ج 2، ك 1، ب 78، ح 2.(@)(@@) * وروى عن أبي الخطاب، وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 5، ك 2، ب 53، ح 13.(@)(@@) والتهذيب: ج 7، ح 9.(@)(@@) * وروى عن أبي كهمس، وروى عنه ابن فضال.(@)(@@) الكافي: 
ms4255	 ج 2، ك 1، ب 37، ح 11، و ج 4، ك 3، ب 131، ح 10، و ج 4، ك 3، ب 131، ح 10، و ج 6، ك 8، ب 45، ح 3، و ب 46، ح 2. والتهذيب: ج 5، ح 367 (الإستبصار: ج 2، ح 753، وفيه أبو كهمس بدل أبي كهمس).(@)(@@) * وروى عن أبيه، وروى عنه ابن فضال.(@)(@@) الكافي: ج 1، ك 3، ب 35، ح 3، و ج 2، ك 1، ب 94، ح 4، و ب 116، ح 2، و ب 121، ح 2، و ج 3، ك 3، ب 13، ح 1، و ج 4، ك 3، ب 8، ح 6، و ج 5، ك 3، ب 190، ح 12، و ج 6، ك 8، ب 7، ح 1، و ب 38، ح 12. والروضة: ح 451.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 7، ك 1، ب 30، ح 4. PageV13P325(@)(@@) والتهذيب: ج 9، ح 840.(@)(@@) وروى عنه الحسن.(@)(@@) التهذيب: ج 1، ح 434، 1239.(@)(@@) * وروى عن ابن بكير، وروى عنه ابن فضال.(@)(@@) الكافي: ج 6، ك 7، ب 37، ح 6.(@)(@@) * وروى عن أسباط بن سالم مولى أبان، وروى عنه ابن فضال.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 21.(@)(@@) * وروى عن إسحاق بن عمار، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 6، ك 8، ب 14، ح 1.(@)(@@) * وروى عن أيوب، وروى عنه ابن فضال.(@)(@@) الكافي: ج 2، ك 1، ب 78، ح 3.(@)(@@) * وروى عن أيوب بن راشد، وروى عنه ابن فضال.(@)(@@) الكافي: ج 1، ك 2، ب 22، ح 4، و ج 3، ك 5، ب 2، ح 16.(@)(@@) * وروى عن أيوب بن الحر، وروى عنه ابن فضال.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 8.(@)(@@) * وروى عن بريد بن معاوية، وروى عنه ابن فضال.(@)(@@) الكافي: ج 7، ك 1، ب 37، ح 1. والفقيه:(@)(@@) ج 4، ح 613. والتهذيب: ج 9، ح 910.(@)(@@) وروى عنه الحسن بن علي بن فضال.(@)(@@) الروضة: ح 35.(@)(@@) * وروى عن بريد بن معاوية العجلي، وروى عنه ابن فضال.(@)(@@) الكافي: ج 5، ك 3، ب 7، ح 2.(@)(@@) * وروى عن بريد العجلي، وروى عنه ابن فضال.(@)(@@) الكافي: ج 7، ك 1، ب 8، ح 2. والتهذيب:(@)(@@) ج 9، ح 761.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) التهذيب: ج 7، ح 1592.(@)(@@) وروى عنه الحسن بن علي بن فضال.(@)(@@) الفقيه: ج 4، ح 508.(@)(@@) * وروى عن جارود أبي المنذر، وروى عنه الحسن بن علي بن فضال.(@)(@@) الكافي: ج 2، ك 1، ب 66، ح 3.(@)(@@) * وروى عن الحسين بن موسى، وروى عنه الحسن بن علي.(@)(@@) الكافي: 
