ms438	 PageV1P686(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به صبر یافت نهال امید نشو و نمائی %~% فتاد پادشهی عاقبت به فکر گدائی(@)(@@) 2 گدا به خسروی افتاد کز حمایت طالع %~% فکند ظل همایون برو بزرگ همائی(@)(@@) 3 سری که بود ز پستی گران رسید به گردون %~% چو ماه شد علم از عون آفتاب لوائی(@)(@@) 4 به گل فرو شده خاشاک بحر غم بسر آمد %~% ز نیم جنبش دریای لطف لجه سخائی(@)(@@) 5 برنگ نخل خزان دیده بودم از غم دوران %~% سهیل وار ز دورم نواخت لعل بهائی(@)(@@) 6 اگر چه بخت به دامن کشید پای مرادم %~% رساند دست امیدم ولی به ذیل عطائی(@)(@@) 7 به تن رجوع کن ای جان نیم‌رفته که دل را %~% خراب یافت مسیحا دمی و کرد دوائی(@)(@@) 8 به گو شمال زمانم اگر رسید چه قانون %~% کشید ناله بافغان فغان رسید به جائی(@)(@@) 9 جه جا حریم در پادشاه‌زاده اعظم %~% که دو راست به دوران او عظیم جلائی(@)(@@) 10 نهال نورس بستان احمدی که به گردش %~% هنوز جز دم روح‌القدس نگشته هوائی(@)(@@) 11 خلاصه نسب پاک حیدری که شنیده %~% نسب ز عمر ابد نسبتش نوید بقائی(@)(@@) 12 سمی حیدر صفدر که صفدران جهان را %~% نیامداست چه او در نظر صفوف گشائی(@)(@@) 13 ولی عهد ابد انتساب خسرو دوران %~% که بسته است به عهدش زمانه عهد وفائی(@)(@@) 14 چراغ دوده فروز خدایگان سلاطین %~% که رنگ شب ببرد گر دهد به ماه ضیائی(@)(@@) 15 دمادم است که تدبیر شه رساند جهان را %~% برای تربیت او به تازه برگ و نوائی(@)(@@) 16 سیاهی که به زنجیر عدل بسته بر آتش %~% ز شوق او شده دیوانه خوی سلسله خائی(@)(@@) 17 فلک که دارد از انجم هزار دیده روشن %~% ز راه اوست به دامان دیده کحل ربائی(@)(@@) 18 سپهر تیز روش در رکاب غاشیه داری %~% هلال پشت خمش بر جناب ناصیه سائی(@)(@@) 19 به وضع شخص جلالش فلک حقیر لباسی %~% بقدر قد بلندش ملک قصیر قیائی 
ms439	(@)(@@) 20 به جنب مشعل درگاه عالیش مه گردون %~% همان مه است ولی ماه مشتبه به شهابی(@)(@@) 21 شب از جلای وطن دم زند چو نعل سمندش %~% زند به آینه مه صلای کسب جلائی(@)(@@) 22 حسام او که به سر نیز وا نمی‌شود از سر %~% بلاست بر سر اعدای دین و طرفه بلائی(@)(@@) 23 شه جهان به جهانگیریش کند چه اشارت %~% شود ز جانب او هر اشاره قلعه گشائی(@)(@@) 24 فلک به رقص درآید ز خرمی چو برآید %~% ز کوی خسرویش در بسیط خاک صدائی(@)(@@) 25 زهی رسانده منادی رسان خوان عطایت %~% ز نشه کرم حیدری به خلق صلائی(@)(@@) 26 به ناز می‌نگرد حرص درد و کون که دارد %~% به مرغزار سخا بی‌تو آهوانه چرائی(@)(@@) 27 ز ریزش مطر لطف بی‌دریغ تو رسته %~% ز مزرع دل مردم قریب مهر گیائی(@)(@@) 28 توئی که از پی گنجایش جلال تو باید %~% ازین وسیع‌تر اندر قیاس ارض و سمائی(@)(@@) 29 فلک ز بهر صعود تو با رفیع مقامی %~% جهان برای نزول تو با وسیع فضائی(@)(@@) 30 بنا نهنده این نه بنا مگر نهد از نو %~% به قدر رتبه و شان تو در زمانه بنائی(@)(@@) 31 ز بار حلم تو کز عرش اعظم‌ست گران‌تر %~% بهم رسانده سپهر بلند قد دوتائی(@)(@@) 32 کند چو از جرس محمل جلال تو دعوی %~% نهم سپهر چه باشد ورای هرزه درائی(@)(@@) 33 اجل به تیغ و سنان تو کار خویش گذارد %~% نهی به تمشیت کاردین چو رو به عزائی(@)(@@) 34 عجب که کلک هوس در قلمرو تو برآید %~% صبی غیر مکلف به قصد خط خطائی(@)(@@) 35 به چرخ داده قضا مهر داری تو همانا %~% کز آفتاب به گردن فکنده مهر طلائی(@)(@@) 36 مصلی‌ایست به عهدت فلک که بهر مصلی %~% بدوش می‌کشد از کهکشان همیشه ردائی(@)(@@) 37 برای خصم تو گردیده در بلندی و پستی %~% سپهر تفرقه بازی زمانه حادثه زائی(@)(@@) 38 آیا گل چمن حیدری که در چمن تو %~% سخن 
ms440	 رسانده به معجز کمینه نغمه سرائی(@)(@@) 39 دمی که در طلب نظم بنده حکم معلی %~% به من رساند در ابلاغ اهتمام نمائی(@)(@@) 40 هزار سجده بی‌اختیار کردم و گشتم %~% مدد ز ناطقه جوئی زبان به مدح گشائی(@)(@@) 41 دو چیز باعث تاخیر شد که هریک از آنها %~% چو درد بنده نبودش به هیچ چیز دوائی(@)(@@) 42 یکی تهیه ترتیب رطب و یا بس دیوان %~% که فکر می‌طلبد آن مهم فکر رسائی(@)(@@) 43 یکی دگر عدم کاتبان که آن چه ز نظمم %~% تمام بود و نبودش ز خط لباس صفائی(@)(@@) 44 پس از تجسس کامل که یک دو کاتب کاهل %~% به ناز و عشوه نمودند و دلبرانه لقائی(@)(@@) 45 بهر طریق که بود آن چه گشته بود مرتب %~% رجوع گشت به ایشان به میزبانه ادائی(@)(@@) 46 بر آستان که مهم دو روزه را به دو هفته %~% تعهدی که نمودند هم نکرد بقائی(@)(@@) 47 که پای خامه ایشان نداشت چون قدم من %~% تحرکی که تواند رسید زود به جائی(@)(@@) 48 غرض که مختصری شد نوشته تا رسد اکنون %~% ز پرتو نظر تربیت به قدر و بهائی(@)(@@) 49 تتمه سخنان نیز بعد ازین متعاقب %~% به عرض می‌رسد البته بی‌قضا و بلائی(@)(@@) 50 نکوترین صور سود این که خود برساند %~% سخن به سمع همایون مدیح پیشه گدائی(@)(@@) 51 فغان که پای رسیدن به آن جناب ندارد %~% ز دست رفته ضعیفی به گل فرو شده پائی(@)(@@) 52 دو پا اگرچه به یک موزه کرده شخص توجه %~% کجا رود چه کندره سیر بپای عصائی(@)(@@) 53 فلک حشم ملکا محتشم گدای در تو %~% ز همت است گدائی به التفات سزائی(@)(@@) 54 تهی ست ارچه کفش لیک از کمال تو کل %~% به دست‌یاری همت ز دست کوس غنائی(@)(@@) 55 ولیک می‌کند از شاه و شاه‌زاده عالم %~% گدائی نظر فیض بخش قدر فزائی(@)(@@) 56 که تا زبان بودش بعد ازین به شغل ثنایت %~% بود گدای غنی طبع پادشاه ستائی 