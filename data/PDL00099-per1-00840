ms833	 از خیال %~% آماده تر زوهم و مهیاتر از یقین(@)(@@) 42 از بس دونده باد به یال اندرش نهان %~% از بس جننده برق به نعل اندرش مکین(@)(@@) 43 کف از لبش چکیده چو آویزهای در %~% کوه از سمش ‌کفیده چو دندان‌های سین(@)(@@) 44 گاهش ز خوی بدن شده پرلولو عدن %~% گاهش زکف دهن شده پرگوهر ثمن(@)(@@) 45 گه شد به بیشه‌ای‌که زمین پیش او فلک %~% گه شد به پشته‌یی که فلک پبش او زمبن(@)(@@) 46 بس رودها نبشت به پهنای روزگار %~% لیکن بسی شگرف‌تر از وهم دوربین(@)(@@) 47 وز تیغ‌هاگذشت به باریکی صراط %~% لیکن بسی درازتر از روز واپسین(@)(@@) 48 ناگه برآمد ابری و بارید آنچنانک %~% گفتی ذخیره دارد دریا در آستین(@)(@@) 49 این طرفه تر که شب شد و ظلمات نیستی %~% گفتی به‌ گرد هستی حصنی ‌کشد حصین(@)(@@) 50 گفتم بتا بیا که بمانیم و صبحگاه %~% رانیم تا که باز برآید شب از کمین(@)(@@) 51 گفتا تبارک‌الله از این رای و این خرد %~% وین ‌کار و این کفایت و این‌ یار و این آب معین(@)(@@) 52 بالله که تیر بارد اگر بر سرم ز چرخ %~% بالله ‌که تیغ روید اگر در رهم ز طین(@)(@@) 53 نه نان خورم نه آب نه راحت ‌کنم نه خواب %~% رانم به‌ کوه و جوی و جرو رود و پارگین(@)(@@) 54 روزی دو بسپرم ره و آنگاه بسترم %~% رنج سفر ز درگه دارای جم نگین(@)(@@) 55 شاهنشه زمانه محمد شه آنکه هست %~% آثار فرخش همه درخورد آفرین(@)(@@) 56 عفوش نپرسد ار ز کسی بنگرد خلاف %~% شاهین نترسد ار مگسی برکشد طنین(@)(@@) 57 در چشم می نیاید خصمش ز بس نزار %~% در هم می‌نگنجد بختش ز بس سمین(@)(@@) 58 پروانه‌ایست قدرتش از قدرت خدای %~% دیباچه‌ایست هستیش از هستی آفرین(@)(@@) 59 رایش به چرخ بینش مهری بود منیر %~% شخصش در آفرینش رکنی بود رکین(@)(@@) 60 آثار او مهذب و اخلاق او نکو %~% رایات او مظفر و آیات 
ms834	 او مبین(@)(@@) 61 بر تار عنکبوت کند حزمش ار نظر %~% از یمن او چه سد سکندر شود متین(@)(@@) 62 بر آب شور بحر کند جودش ار گذر %~% از فیض او چو چشمه‌ کوثر شود معین(@)(@@) 63 از سیر صبح و شام بود عزم او بدل %~% از نور مهر و ماه بود رای او عجین(@)(@@) 64 ای چاکری ز فوج نظامت فراسیاب %~% وی ‌کهتری ز خیل سپاهت سبکتکین(@)(@@) 65 طوقیست نعل رخش تو برگردن ینال %~% تاجیست خاک راه تو بر تارک تکین(@)(@@) 66 موهوب تست هرچه به جان‌ها بود هنر %~% منهوب تست هرچه به‌کانها بود دفین(@)(@@) 67 رای تو حل و عقد زمین را بود ضمان %~% حکم تو نشر و طی زمان را بود ضمین(@)(@@) 68 آبستنند مهر ترا در رحم بنات %~% آماده‌اند حکم ترا در شکم بنین(@)(@@) 69 رمح ترا برزم لقب‌ کاشف القلوب %~% تیغ ترا به جنگ صف قاطع‌الوتین(@)(@@) 70 خندد امل چو کلک تو گرید به ‌گاه مهر %~% گرید اجل چو تیغ تو خندد به روز کین(@)(@@) 71 آنی ز روز بخت تو در بایه شهور %~% روزی ز ماه عمر تو سرمایه سنین(@)(@@) 72 هرجا که آفتیست به خصم تو می‌رسد %~% چون در عبارت عربی برحروف لین(@)(@@) 73 هون عدو شمیده ز شمشیرت آنچنانک %~% در گوش او علامت شین است حرف شین(@)(@@) 74 شب‌اها سه ساله دوریم از آستان تو %~% سودی نداشت جز دو جهان ناله و انین(@)(@@) 75 حنانه‌وار شد تنم از ناله همچو نال %~% وز دوری دو تن من و حنانه در حنین(@)(@@) 76 آن از محمد عرب آن ماه راستان %~% من از محمد عجم آن شاه راستین(@)(@@) 77 حنانه را نواخت به الطاف خود رسول %~% تا در بهشت تازه نهالی شود رزین(@)(@@) 78 من نیز سبزکرده شاه ار شوم رواست %~% در آستان شه ‌که بهشتیست دلنشین(@)(@@) 79 قاآنیا سخن به درازا کشید سخت %~% ترسم‌کزین ملول شود خسرو گزین(@)(@@) 80 تا از زمان اثر بود و 
ms835	 از مکان خبر %~% شاه زمین به تخت خلافت بود مکین PageV1P384(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ماه من دارد ز سیم ساده یک خرمن سرین %~% من به‌ گرد خرمنش همچون‌ گدایان خوشه چین(@)(@@) 2 یک طبق بلور را ماندکه بشکافد ز هم %~% نیمی افتد بر یسار و نیمی افتد بر یمین(@)(@@) 3 درشب تاریک چون مه خانه را روشن ‌کند %~% کس نمی‌پرسد تو آخر قرص ماهی یا سرین(@)(@@) 4 خسرو پرویز اگر خود زر دست‌افشار داشت %~% سیم دست افشار دارد آن نگار نازنین(@)(@@) 5 گنج باد آورد گنجی بود کش آورد باد %~% گنج بادآور شنیدی ‌گنج بادآور ببین(@)(@@) 6 در شب مهتاب از شلوار چون افتد برون %~% یک بغل برف از هوا باریده گفتی بر زمین(@)(@@) 7 هیچ جفتی را نشاید بی‌قرین خواندن به دهر %~% جز سرین او که جفتست و به خوبی بی‌قرین(@)(@@) 8 گنج سیمست آن سرین دزددل و دل دزد او %~% گنج چون خود دزد باشد دزدکی گردد امین(@)(@@) 9 چرب و شیرینست چندانی که چون نامش برم %~% از زبان من گهی روغن چکد گه انگبین‌(@)(@@) 10 آن سرین کاو چون پری پنهان بود از چشم خلق %~% چون من از هر سو دو صد دیوانه دارد در کمین(@)(@@) 11 ای ‌دریغا کاش افسون پری دانستمی %~% تا پری را دیدمی بی‌گاه و گه صبح و پسین(@)(@@) 12 آن پری را نیست افسونی به غیر از سیم و من %~% مانده‌ام بی‌سیم از آن با من نگردد همنشین(@)(@@) 13 نی‌ که او سیمست و من همچون‌ گدا در پیش او %~% بهر سیم آرم برون دست طمع از آستین(@)(@@) 14 نام‌او شعر مرا ماندکه چون آری به لب %~% آبت آید در دهن بی‌خود نمایی آفرین(@)(@@) 15 آن سرین کان ماه دارد من اگر می‌داشتم %~% دادمی‌ کز من نباشد هیچ ‌کس اندوهگین(@)(@@) 16 وقف رندان قلندر کردمی چون خانقاه %~% تا شوند آنجا پی‌ دفع منی عزلت‌ گزین(@)(@@) 17 دی به من گفتا کسی وصف سرین 
ms836	 کردن به دست %~% گفتم آری بد بود مبرود را سرکنگبین(@)(@@) 18 گر ز لفظ زشت افتد معنی زیبا به دست %~% ننگ‌گوهر نیست‌‌ گر جوید کسی از پارگین(@)(@@) 19 قهوه بس تلخست‌ کش نوشند مردم صبح و شام %~% لیک بس شیرین شود چون گشت با شکر عجین(@)(@@) 20 از سرین گفتن مرا در دل مرادی دیگرست %~% فهم معنی‌ گر توانی حجتی دارم متین(@)(@@) 21 چیست دانی خواهش دل خواهش دل ‌کیست عشق %~% عش چبود شور حق حق ‌کیست رب‌العالمین(@)(@@) 22 آدمی را میل هست و شهوتی اندر نهاد %~% کافریدست از ازل در جان او جان‌آفرین(@)(@@) 23 گرچه زان شهوت مراد ابن شهوت مشهور نیست %~% لیک ازین خواهش ‌بدان خواهش ترا گردد معین(@)(@@) 24 زانکه لفظ شهوت‌انگیز آورد دل را بشور %~% تاکند گم ‌کرده خود را سراغ از آن و این(@)(@@) 25 تشنگی باید که خیزد تشنه در تحصل آب %~% تا سراب از آب بشناسد سداب از یاسمین(@)(@@) 26 مقصد و مقصود جانها رنگ و تاب آب هست %~% پس در اول حال عطشان آب می‌داند یقین(@)(@@) 27 در شراب ار آب نبود رنگ و تاب آب هست %~% پس ‌در اول حال عطشان آب می‌داند یقین(@)(@@) 28 مرد بخرد را به دل سودا ز جای دیگرست %~% کش گهی از خال جوید گه ‌ز خط‌ گه از جبین(@)(@@) 29 راستی عشاق را سوز و نوای دیگرست %~% گه ز چنگ عندلبب و گه ز چنگ رامتین(@)(@@) 30 بوی پیراهن چنان یعقوب را بینا کند %~% بوی یوسف فرق کن از بوی یوسف آفرین(@)(@@) 31 گر به تنها طیب چشم‌ کور را کردی بصر %~% هیچ نابینا نبودی در تمام ملک چین(@)(@@) 32 تین و زیتونی که یزدان خورده در قرآن قسم %~% فهم‌ آن زاول‌ که قصدش چیست زین زیتون و تین(@)(@@) 33 در همین زیتون و تین خواهد یقین شد آنکه هست %~% طعم آن شیرینی مطلق بهر چیزی ضمین(@)(@@) 34 مقصد حق شور عشق تست و شرح 
