ms41	 افتراق ملتقى % % 2(@)(@@) % عاننا الدهر فأضحى شملنا % % بعد ما كان جميعا فرقا % % 3(@)(@@) % وهي الأيام من عاداتها % % رد صفو العيش طرقا رنقا % % 4(@)(@@) % كل شيء غيرت مني النوى % % بعدكم إلا الجوى والحرقا % % 5(@)(@@) % خان فيكم حسن صبرى ، ووفى % % لكم الدمع فآلى لا رقا % % 6(@)(@@) % ليت من يغبط أبناء الهوى % % ذاق ما يلقون فيه : من شقا % % PageV01P219 البحر : كامل تام 1(@)(@@) % أشتاقكم فإذا نظرت إليكم % % زاد الدنو صبابتي وتشوقي % % 2(@)(@@) % فمتى أفيق وبعدكم يذكي جوى % % قلبي ، ويضرم شوقه أن نلتقي ؟ ! % PageV01P220 البحر : طويل 1(@)(@@) % خليلى ، زورابى رويقة إنني % % إليها ، على قرب الزيارة ، شيق % 2(@)(@@) % خليلى ، ما ألتذ عيشا ، ولا له % إذا ما نأت عني رويقة رونق % % 3(@)(@@) % إذا برزت بين النساء حسبتها % % هى الشمس ، أو من وجهها الشمس تشرق % 4(@)(@@) % تنازعهم نزرا عليه سكينة % وتعرض عن لهو الحديث وتطرق % % PageV01P221 البحر : بسيط تام 1(@)(@@) % نافقت دهري فوجهي ضاحك جذل % % طلق ، وقلبي ، كئيب ، مكمد ، باك % % 2(@)(@@) % وراحة القلب في الشكوى ، ولذتها % % لو أمكنت ، لا تساوي ذلة الشاكي % % PageV01P222 البحر : مجزوء الكامل 1(@)(@@) % يا قلب مت كمدا على % % من غبت عنه وغاب عنك % % 2(@)(@@) % لا تلتقي بدلا به % % وسيلتقي الأبدال منك % % PageV01P223 البحر : كامل تام 1(@)(@@) % لا ذنب للصب المشوق ، إذا بدت % أسراره ، يوم النوى ، للعذل % 2(@)(@@) % زفراته نمت ، ولم يفصح بما % % يخفي فجاء الدمع بالخبر الجلي % % 3(@)(@@) % أفنى صدودك في الدنو تصبري % % وأتى الفراق فبز حسن تجملي % % 4(@)(@@) % فالعمر أجمع بين هجر سالف % ماض وبين آنف مستقبل % % PageV01P224 البحر : بسيط تام 1(@)(@@) % نفسى الفداء لمن قبلته عجلا % والبين يعجب من وجدى ومن عجلى % 2(@)(@@) % فمال عني بفيه ثم عرض لي % % خدا جرى فيه ماء الحسن والخجل % % 3(@)(@@) % فأخلصت أدمعي توريد وجنته % % فزاد إشراق ذاك الورد بالبلل % 4(@)(@@) % فارتاع من حر أنفاسي وحرقة اح % % شائي ونهيي فاه العذب بالقبل % % 5(@)(@@) % ورابه ما رأى من روعتي فبكى % % وقال : لا كان ذا توديع مرتحل % PageV01P225 البحر : بسيط تام 1(@)(@@) % ونازح ، في فؤادي من هواه صدى % % لم يرو غلته بالعل والنهل % % 2(@)(@@) % في 
ms42	 فيه ما في جنان الخلد من درر % % ومن أقاح ومن خمر ومن عسل % % 3(@)(@@) % لو كنت أعلم أن البين يفجؤني % % رويت قبل النوى قلبي من القبل % % PageV01P226 البحر : طويل 1(@)(@@) % بنفسي عذول ، لام فيكم ، فرد لي % % بذكركم روح الحياة عذول % % 2(@)(@@) % لحى ناصحا فيكم ، فأذكى صبابتي % % وتذكي الرياح النار وهي بليل % % 3(@)(@@) % أسوف صعيد الأرض إذ وافق اسمه % % صعيدا به أهل الحبيب نزول % % 4(@)(@@) % وأغدو على أسوان أسوان في الحشا % % لبعدى عنها لوعة وغليل % PageV01P227 البحر : كامل تام 1(@)(@@) % ما استجهلتك معالم ورسوم % % إلا ليعلن سرك المكتوم % % 2(@)(@@) % أو بعد ناهية المشيب جهالة % % يأبى الوقار عليك والتحليم % % 3(@)(@@) % ما جرت في داجي الشباب فكيف إذ % % وضحت بفودك للمشيب نجوم % % 4(@)(@@) % ومنهاأعواذلى ، كفوا ، فليس بمسمعي % % نصح ، وبعض الناصحين ملوم % 5(@)(@@) % وقرت دواعى البين سمعي بعدهم % % فلمن يعنف ناصح ويلوم ؟ ! % 6(@)(@@) % لي كل يوم روعة بمودع % ونوى ، فهمى طارف وقديم % 7(@)(@@) % وعلى الركائب ماطل بديوننا % % عسر القضاء مع اليسار ، ظلوم % 8(@)(@@) % متبسم عن ذي غروب واضح % % يعزى إليه اللؤلؤ المنظوم % % 9(@)(@@) % في وجهه ماء الملاحة حائر % % فقلوبنا الظمأى عليه تحوم % 10(@)(@@) % أتبعتم قرحى الجفون كليلة % تصحي بدمعي تارة وتغيم % PageV01P228 11(@)(@@) % مسمولة بمدامع حالت دما % وجدي عليك وإن رحلت مقيم % % 12(@)(@@) % لي مقلة قذيت ببعدك برها % % فيض الدموع ، وعقها التهويم % 13(@)(@@) % ساوى بعادك ليلها ونهارها % % كل ، كما قضت الهموم ، بهيم % 14(@)(@@) % كم أنشأت ذكراك بين جوانحي % % من زفرة قلبي بها موسوم % 15(@)(@@) % نفس يقوم له إعوجاج أضالعي % % ويضيق عن نزواته الحيزوم % 16(@)(@@) % ما أخطأت فيك عاداتها % % لكن تقريف الكلوم أليم % PageV01P229 البحر : مجزوء الكامل 1(@)(@@) % إن لم تطيقا يوم رامه % % أن تسعدا ، فذرا الملامه % 2(@)(@@) % عنفتماني أن مرر % % ت بمنزل أقضي ذمامه % 3(@)(@@) % هو منزل الأحباب ، لم % % يدع البلى إلا رمامه % 4(@)(@@) % وعلي حق أن تصا % % فح سحب أجفاني رغامه % % 5(@)(@@) % وأبيكما ، لأروي % % ن ، ولو بسح دم أوامه % 6(@)(@@) % ما الدمع للأطلال ل % % كن أهلها أجروا سجامه % % 7(@)(@@) % فإلام لومكما ! أفى % % رعي العهود علي آمه % 8 
ms43	(@)(@@) % واها لقلب لا يفو % % ز بسلوة تشفي هيامه % % 9(@)(@@) % غرضا لبين لا يزا % % ل مقرطسا فيه سهامه % 10(@)(@@) % أبدا يد الأيام تق % رف كلما اندملت كلامه % % PageV01P230 البحر : كامل تام 1(@)(@@) % إن لم أبح بهواك قلن لوائمى : % ذا مبطل ما الكتم شيمة هائم % % 2(@)(@@) % وإن آدعى خوف الوشاة ، فما الهوى % % للخوف مذ خلق الهوى بملائم % % 3(@)(@@) % لا تكذبن ، فما لأبناء الهوى % % رأى يحذرهم عواقب نادم % 4(@)(@@) % شغلت قلوبهم بروعات النوى % % والهجر عن خوف الزمان العارم % % 5(@)(@@) % فتراهم صورا كظل ماثل % لا يرعوون لزاجر أو لائم % % 6(@)(@@) % واها لأيام الحمى لو أنها % % دامت ، وهل عيش يسر بدائم % % 7(@)(@@) % إذا أجتلي القمر المردى بالدجى % % يجلو الشموس على القضيب الناعم % % 8(@)(@@) % سكري بناظره وراح رضابه % % وكئوسه ، طول الزمان ، ملازمي % % 9(@)(@@) % ما غال عقلي قط سحر جفونه % % إلا جعلت ذؤابتيه تمائمي % % 10(@)(@@) % ثم افترقنا بغتة ، فإذا الذي % % كنا نسر به فكاهة حالم % % PageV01P231 البحر : طويل 1(@)(@@) % أأحبابنا ، مذ أفردتني منكم % صروف الليالي أفردتني بالهم % % 2(@)(@@) % وحملت ثقل الشوق عنكم وإنني % % لأضعف عن حمل التشوق والسقم % % 3(@)(@@) % كأني عود أو هن الثقل صحبه % % فردوا عليه ثقلهن على رغم % % PageV01P232 البحر : بسيط تام 1(@)(@@) % قل للذين نأوا ، والقلب دارهم : % وجداننا كل شيء بعدكم عدم % % 2(@)(@@) % جهلت أنسي بكم والدار دانية % % حتى إذا نزحت أدمى يدي الندم % % PageV01P233 البحر : كامل تام 1(@)(@@) % كم قد جزعت لبين من فارقته % % وصبرت عنه والحشا يتضرم % % 2(@)(@@) % كالقوس ترمي السهم ثم ترن من % % جزع ، ويبدو اليأس منه ، فتكظم % % 3(@)(@@) % والوجد لو أجدى على ذي لوعة % ما مات بالكمد القديم متمم % PageV01P234 البحر : طويل 1(@)(@@) % وهاج لي الشوق القديم حمامة % على غصن في غيضة تترنم % % 2(@)(@@) % دعت شجوها محزونة لم تفض لها % % دموع ، ففاضت أدمعي ، مزجها دم % 3(@)(@@) % فقلت لها : إن كنت خنساء لوعة % ووجدا فإني في البكاء متمم % % PageV01P235 البحر : وافر تام 1(@)(@@) % سهرت بخرتبرت ، فطال ليلى % علي ، ولم يطل ليل النيام % 2(@)(@@) % أفكر في مفارقتي رجالا % هم الكرماء أبناء الكرام % 3(@)(@@) % كأني السهم يفرد ، باعتماد % لنزع 
ms44	 القوس ، من بين السهام % PageV01P236 البحر : كامل تام 1(@)(@@) % مالي وللجبل الأغر وإنما % % كل الهوى جبل أشم بهيم % 2(@)(@@) % موف على أرض الشآم كأنما % % جون السحائب في ذراه جثوم % 3(@)(@@) % ما زال مطرح ناظري حتى إذا % % لاحت بفودي للمشيب نجوم % % 4(@)(@@) % فارقته ، ونأيت عنه ، ومانأى % % وجدى به ، وهوى الكريم كريم % 5(@)(@@) % فإذا ذكرت النازلين بسهله % % وبهم ، وإن شطت نواى ، أهيم % 6(@)(@@) % دارت بي الأرض الفضاء كأنما % % بى الموم أو لعبت بى الخرطوم % % PageV01P237 البحر : رمل تام 1(@)(@@) % ما يريد الشوق من قلب معنى % % ذكر الألاف والوصل فحنا % % 2(@)(@@) % حسبه ما عنده من شوقه % % وكفاه من جواه ما أجنا % % 3(@)(@@) % كلما شاهد شملا جامعا % طار شوقا وهفا وجدا وأنا % % 4(@)(@@) % عاضه الدهر من القرب نوى % ومن الغبطة بالأحباب حزنا % % 5(@)(@@) % فرثى من رحمة عاذله % % ورأى الحاسد فيه ما تمنى % % 6(@)(@@) % ويحه من زفرة تعتاده % % وهموم جمة ، تطرق وهنا % % 7(@)(@@) % يا زمان القرب ، سقيا لك ، من % % زمن ، لو كان قرب الدار أغنى % % 8(@)(@@) % لم تكن إلا كظل زائل % % والمسرات تلاشى ثم تفنى % % 9(@)(@@) % ساءنا ما سرنا من عيشنا % % بعد ما راق لنا مرأى ومجنى % % 10(@)(@@) % فافترقنا بعد ما كنا صدى % % إن دعونا ، وكفانا قول : كنا % % PageV01P238 11(@)(@@) % وكذا الأيام من عاداتها % % أنها تعقب سهل العيش حزنا % % 12(@)(@@) % خلق للدهر ما أولى امرأ % % نعمة منه فملاه وهنا % % 13(@)(@@) % وكذا الباخل ما أسدى يدا % قط إلا كدر المن ومنا % % 14(@)(@@) % قل لأحباب نأت دارهم % وعلى قربهم أقرع سنا % % 15(@)(@@) % ساء ظني باصطباري بعدكم % % ولقد كنت به أحسن ظنا % % 16(@)(@@) % لأبيحن الجوى من كبدي % - موضعا لم يبتذل عزا وضنا % % 17(@)(@@) % وأذيلن دموعا لو رأت % % فيضهن المزن خالتهن مزنا % % 18(@)(@@) % أسفا لا بل حياء أنني % % بعدكم باق ، وإن أصبحت مضنى % % 19(@)(@@) % لا صفا لي العيش من بعدكم % % ما تمادت مدة البين وعشنا % % 20(@)(@@) % وعجيب ، والتنائي دونكم % % أنكم مني إلى قلبي أدنى % % PageV01P239 21(@)(@@) % حيث كنتم ففؤادي داركم % % وعلى أشباحكم أغمض جفنا % % PageV01P240 البحر : رجز تام 1(@)(@@) % يا ناق شطت دراهم فحني 
ms45	 % % وأعلني الوجد الذي تجني % % 2(@)(@@) % ما أرزمت وهنا لفقد إلفها % % إلا رمت جوارحى بوهن % % 3(@)(@@) % تذكرت ألافها ، فهيجت % لاعج شوقي ، وذكرت خدني % % 4(@)(@@) % أبكي اشتياقا ، وتحن وحشة % فقد شجاني حزنها وحزني % % 5(@)(@@) % حسبك قد طال الحنين والأسى % % وما رأى طول الحنين يغني % % 6(@)(@@) % ولا تملى من مسير وسرى % في مهمه سهل ووعر حزن % 7(@)(@@) % حتى تناخي تحت بانات الحمى % % سقى الحمى والبان صوب المزن % % 8(@)(@@) % أهوى الحمى وأهله وبانه % % وإن نأيت وتناءوا عني % % 9(@)(@@) % شطوا وشطت بي داري عنهم % % وهم إلى قلبي أدنى مني % % 10(@)(@@) % لم يذكروا لي قط إلا امتلات % % بالدمع أجفاني ، وقالت : قطني % % PageV01P241 11(@)(@@) % وهم أعز إن نأوا وإن دنوا % % مما حوى خلبي وضم جفني % % 12(@)(@@) % نفسي فداء من أورى بالحمى % % والبان عن أسمائهم وأكني % % 13(@)(@@) % هم ، إذا قلت : سقى أرض الحمى % % وبانه صوب الحيا ، من أعني % % 14(@)(@@) % ضنا بهم عن أن يطور ذكرهم % % بمسمع ، وهم مكان الضن % 15(@)(@@) % أحببتهم من قبل ينجاب دجى % % فودي عن الصبح ويذوي غصني % % 16(@)(@@) % حبا جرى مجرى الحياة من دمى % % أصم عن كل نصيح أذنى % % 17(@)(@@) % فلو تعوضت بهم عصر الصبا % % لبان في صفقة بيعي غبني % % 18(@)(@@) % فارقتهم أشغف ما كنت بهم % % وعدت قد أدمت بناني سني % % 19(@)(@@) % ألزم كفي فؤادا ماله % % من بعدهم روح سوى التمني % % 20(@)(@@) % لكنني أدعو لجمع شملنا % % مسير الشهب ، ومجرى السفن % % PageV01P242 البحر : كامل تام 1(@)(@@) % أعلمت ما فعلت به أجفانه % % سحت فباحت بالهوى أشجانه % % 2(@)(@@) % نمت على حسراته زفراته % % وكذا ينم على الضرام دخانه % % 3(@)(@@) % وأخو الهوى مثل الكتاب : دليل ذا % % ك عيانه ودليل ذا عنوانه % % 4(@)(@@) % تحكي البروق فؤاده فضرامها % % أشواقه ، وخفوقها خفقانه % % 5(@)(@@) % ضمن الهوى ألا يزال أخا ضنى % وضمانة فوفى بذاك ضمانه % % 6(@)(@@) % يا مدعي السلوان عن أحبابه % % أين السلو ، وأين منك أوانه % % 7(@)(@@) % شطت ديارك عنهم وهفا بك الش % % وق المبرح والتظت نيرانه % % 8(@)(@@) % وأبان بيهم هواك فما عسى % % بك فاعل هذا الهوى وبيانه % % 9(@)(@@) % كاتمت واشيك الهوى قبل النوى % % فبدا له من 
ms46	 بعدها كتمانه % % 10(@)(@@) % وعصاك دمعك عند خطرة ذكرهم % % وبقدر طاعتك الهوى عصيانه % % PageV01P243 11(@)(@@) % فإذا تبادر من جفونك خلته % % عقدا وهي مرجانه وجمانه % % 12(@)(@@) % لو أيقن الحنق الحسود عليهم % حظي لحالت رحمة أضغانه % % 13(@)(@@) % بين المحب وبينهم من هجرهم % % بين طويل برحه وزمانه % % 14(@)(@@) % أبدوا له ملل القريب ، مع النوى % % وتناسي النائي ، وهم جيرانه % % 15(@)(@@) % وتخلق الطيف الطروق بخلقهم % % فإذا ألم يروعني هجرانه % % 16(@)(@@) % وهم الصبا : أيامه محبوبة % وإن اعتدى في غيه شيطانه % % 17(@)(@@) % وجمالهم كفارة لملالهم % % والهجر ذنب يرتجى غفرانه % % 18(@)(@@) % لو يعلمون مكانهم ما أضرموا % % قلبي بهجرهم وهم سكانه % % 19(@)(@@) % ولجهلهم طرفوا بطول صدودهم % % وملالهم طرفي وهم إنسانه % % PageV01P244 البحر : بسيط تام 1(@)(@@) % أهكذا أنا باقي العمر مغترب % % ناء عن الأهل والأوطان والسكن % 2(@)(@@) % لا تستقر جيادى في معرسها % % حتى أروعها بالشد والظعن % PageV01P245 البحر : كامل تام 1(@)(@@) % أين السرور من المروع بالنوى % % أبدا ، فلا وطن ، ولا خلان % 2(@)(@@) % عيد البرية موسم لعويله % % وسرورهم فيه له أحزان % % 3(@)(@@) % وإذا رأى الشمل الجميع تزاحمت % في قلبه الأمواه والنيران % % PageV01P246 البحر : طويل 1(@)(@@) % قسم الهوى دهر المروع بالنوى % % شطرين بين شؤونه وشجونه % % 2(@)(@@) % هو في الدجى كالشمع : يقطر دمعه % % نارا فتحرقه مياه جفونه % % 3(@)(@@) % فإذا بدا وضح الصباح رأيته % % مثل الحمام ينوح فوق غصونه % % PageV01P247 البحر : بسيط تام 1(@)(@@) % منصور ، دارك أضحت منك موحشة % قد أقفرت بعد سكان وجيران % 2(@)(@@) % أضحى الذي كان منها أمس أضحكني % % وسرني هاج أشجاني وأبكاني % % 3(@)(@@) % عهدتها ناديا للهو ، مجتمعا % للأنس ، ملعب أتراب وولدان % 4(@)(@@) % فأصبحت ما بها مما عهدت بها % % سوى صدى ، كلما ناديت لباني % % PageV01P248 البحر : طويل 1(@)(@@) % وقد أفردتنى الحادثات ، فليس لى % % أنيس ، ولا في طارق الخطب أعوان % 2(@)(@@) % كأني من غير التراب نبت بي ال % % بلاد ، فما لي في البسيطة أوطان % 3(@)(@@) % أجول كما جالت قذاة بمقلة % % وأسرى ، وساري النجم في الأفق حيران % PageV01P249 البحر : طويل 1(@)(@@) % سلا قلبه ما غال حسن سلوه % % ورداه في غي الهوى وغلوه % % 2(@)(@@) % وما باله يشكو الفراق ؟ وأين من % % قساوته شكوى الهوى 
ms47	 وعتوه % 3(@)(@@) % وما خلته مهوى الهوى ومقيله % % ومأوى الأسى والبث عند هدوه % 4(@)(@@) % تثوب إليه في الصباح شجونه % % ويأوي إليه الهم عند هدوه % % 5(@)(@@) % بنفسي من أهدى إلي تحية % على بعده ، وافت بريا دنوه % % 6(@)(@@) % فأذكر من لم تنسه عهده النوى % % ولا طمعت في يأسه ونبوه % % 7(@)(@@) % يحن اشتياقا بالأصائل والضحا % % ويرتاح في روحاته وغدوه % PageV01P250 البحر : طويل 1(@)(@@) % ألا من لصاد ، والموارد جمة % له علل من بردها لم يروه % % 2(@)(@@) % يغان عليه حين يسمع نبأة % بذكرهم ، أودعوة من منوه % 3(@)(@@) % إذا ما دعاه الشوق خر كأنما % % به الموت لولا أنه المتأوه % % PageV01P251 البحر : بسيط تام 1(@)(@@) % بكاء مثلي من وشك النوى سفه % وأمر صبري بعد البين مشتبه % % 2(@)(@@) % فما يسوفني في قربهم أمل % وليس في اليأس لي روح ولارفه % 3(@)(@@) % أكاتم الناس أشجاني وأحسبها % % تخفى فتعلنها الأسقام والوله % % 4(@)(@@) % كأنني من ذهول الهم في سنة % % وناظري قرح الأجفان منتبه % % 5(@)(@@) % أذنبت ، ثم أحلت الذنب من سفه % على النوى ، ولبئس العادة السفه % 6(@)(@@) % أقمت طوعا وساروا ثم أندبهم % % ألا صحبت نواهم حيثما اتجهوا % % 7(@)(@@) % أضر بي ناظر تدمى محاجره % % وخاطر ، مذ نأوا ، حيران منشده % 8(@)(@@) % فما يلائم ذا بعد النوى فرح % ولا يروق لهذا منظر نزه % % 9(@)(@@) % سقيا لدهر ، نعمنا في غضارته % % إذ في الحوادث عما ساءنا بله % % 10(@)(@@) % وعيشنا لم يخالط صفوه كدر % % وودنا لم تشب إخلاصه الشبه % % PageV01P252 11(@)(@@) % مضى ، وجاء زمان لا نسر به % كل البرية منه في الذي كرهوا % % PageV01P253 البحر : بسيط تام 1(@)(@@) % يا قلب ، رفقا بما أبقيت من جلدي % % كم ذا الحنين إلى من أنت مثواه % % 2(@)(@@) % ما غاب عني فأنساه ولست أرى % % في الخلق لي عوضا عنه ، فأسلاه % 3(@)(@@) % قد كنت في القرب أرعاه ، وأحفظه % % ومذ بعدت تولى حفظه الله % % PageV01P254 البحر : سريع 1(@)(@@) % ما وجد من فارق أحبابه % % كوجد من فارق روح الحياه % 2(@)(@@) % فارقت من أمواله عنده % عارية مضمونة للعفاه % 3(@)(@@) % من طاب للجاني جناه ومن % % كفر بالعفو ذنوب الجناه % 4(@)(@@) % أعز من أجفان عينى على 
ms48	 % % عيني ومن قلب حباه هواه % % 5(@)(@@) % إذا مدحناماجدا غيره % فما أردنا بمديح سواه % % 6(@)(@@) % فمن يساوي فقد هذا بمح % % بوب إذا ما غاب عنه سلاه % % PageV01P255 البحر : كامل تام 1(@)(@@) % بأبى هوى فارقته ، ولمثله % % لو كان يوجد مثله خلق الهوى % % 2(@)(@@) % حاز الجمال بأسره ، لم يحو من % فتن الملاحة يوسف ما قد حوى % % 3(@)(@@) % في القلب منه غلة فلو اغتدى % % في ماء خديه غريقا ما ارتوى % % 4(@)(@@) % يلحى عليه خلى بال ما درى % % دمع الغرام ، ولا درى كيف الجوى % % 5(@)(@@) % متكلف مقت النصيحة ماله % % رشد المحب ، ولا عليه إن غوى % % 6(@)(@@) % وأنا المروع بالنوى لو أنني % % أحببتها لجرت بفرقتها نوى % % 7(@)(@@) % فعلام يلحى الللائمون بجهلهم % % من جرحه في الحب عندهم شوى % % PageV01P256 البحر : طويل 1(@)(@@) % لئن غربت شمسي المنيرة في النوى % % فليلي وصبحي في الظلام سواء % % 2(@)(@@) % ففي أسودي قلبي وطرفي محله % % وإن بعدت أرض بنا وسماء % % 3(@)(@@) % ترحل غربا وارتحلت مشرقا % وخلف ارتحال الظاعنين عناء % % 4(@)(@@) % إذا زادنا الترحال بعدا ، فما الذي % % يقربنا إن كان ثم لقاء % % 5(@)(@@) % بلى إن لطف الله يجمع شملنا الش % % تيت ويدني الدار كيف يشاء % % PageV01P257 البحر : منسرح 1(@)(@@) % لم يبق لى فى هواكم أرب % سلوتكم والقلوب تنقلب % % 2(@)(@@) % وضعت عني أثقال حبكم % وحامل الحب مثقل تعب % 3(@)(@@) % وردي قذى ودكم وغضي أج % % نى عليه ، من فعلكم عجب % 4(@)(@@) % إلام دمعي من هجركم سرب % % قان وقلبي من غدركم يجب % % 5(@)(@@) % إن كان هذا لأن تعبدنى ال % % حب فقد أعتقتني الريب % % 6(@)(@@) % أريتموني نهج السلو وقد % % كانت بي الطرق عنه تنشعب % % 7(@)(@@) % أحببتكم فوق ما توهمه الن % % اس ، وخنتم أضعاف ما حسبوا % % PageV01P258 البحر : طويل 1(@)(@@) % وقد كنت أرجو أن أراك ، وبيننا % % مفاوز أدناها الشناخيب والسهب % % 2(@)(@@) % فلما تدانينا يئست وزادني % % تباريح شوق ضقت ذرعا بها القرب % % PageV01P259 البحر : طويل 1(@)(@@) % تبذل حتى قد مللت عتابه % % وأعرضت عنه لا أريد اقترابه % % 2(@)(@@) % إذا سقطت من مفرق المرء شعرة % تأفف منها أن تمس ثيابه % % PageV01P260 البحر : طويل 1(@)(@@) % أيا نازحا لم أحتسب 
ms49	 بعد داره % % وقد كان ، لو نلت المنى ، قربه حسبي % % 2(@)(@@) % تعرضت الأخطار دون لقائنا % % وصد التنائي عن مواصلة الكتب % % 3(@)(@@) % وقد صار يأتى بعد حول مجرم % كتابك مقصورا على اللوم والعتب % 4(@)(@@) % فيا أنس قلبي ، لا تزدني وحشة % ويا روح كربي لا تكن سبب الكرب % % PageV01P261 البحر : بسيط تام 1(@)(@@) % يا من به سلوتي عن كل مفتقد % ومن مودته أدنى من النسب % 2(@)(@@) % شكوت همك بي لما اشتكيت ، فلا % % زلت الموقى من الآلام والنوب % % 3(@)(@@) % أبل جسمي من أوصابه وأرى % % قلبي من الهم لا ينفك ذا وصب % 4(@)(@@) % وداؤه باطن لا طب يبلغه % % إن لم يداركه لطف غير محتسب % 5(@)(@@) % وما الذي ناله من دائه عجب % لكن سلامته من أعجب العجب % % PageV01P262 البحر : طويل 1(@)(@@) % أيا غائبا يدنيه شوقي على النوى % % لأنت إلى قلبى من الفكر أقرب % 2(@)(@@) % وما غاب من أفقاه : عيي وخاطري % % له مطلع من ذا وفي تلك مغرب % % 3(@)(@@) % غبطتك نعمى ، فزت دوني بنيلها % % وفخرا له ذيل على السحب يسحب % % 4(@)(@@) % جوارك من يحمي على الدهر جاره % % ويطلب منه جوده كيف يطلب % % 5(@)(@@) % هو البحر تروى الأرض عند سكونه % % وتغرق في تياره حين يغضب % 6(@)(@@) % فمن لي لو كنت الرسول ببابه % % لتبرد رؤياه حشا تتلهب % % 7(@)(@@) % وأبلغ ما أنفقت في أملي له % % من العمر عشرا . كلها لي متعب % 8(@)(@@) % فما رق لي فيها نسيم أصائلي % % ولا راق لي فيها من الهم مشرب % % 9(@)(@@) % ولولا رجاء الصالح الملك الذي % % به طال واستعلى على الشرق مغرب % % 10(@)(@@) % وأني سآوى من حماه إلى حمى % يرى كل خطب دونه يتذبذب % % PageV01P263 11(@)(@@) % لمت وما موتي عجيب وقد نأت % % بي الدار عنه ، بل بقائي أعجب % PageV01P264 البحر : طويل 1(@)(@@) % وما سكنت نفسى إلى الصبر عنكم % % ولا رضيت بعد الديار من القرب % % 2(@)(@@) % ولكن أيامي قضب بشتاتنا % % ففارقكم جسمي وجاوركم قلبي % % 3(@)(@@) % ولو جمعتنا الدار بعد تفرق % % لكنتم من الدنيا ونعمتها حسبي % % PageV01P265 البحر : طويل 1(@)(@@) % لئن فرق الدهر المشتت شملنا % % فأصبحت في شرق وأمسيت في غرب % % 2 
ms50	(@)(@@) % لقد عزه تفريق صادق ودنا % % وأعجزه إبعاد قلبك من قلبي % % PageV01P266 البحر : وافر تام 1(@)(@@) % أبا البركات لي مولى جواد % % مواهبه كمنهل السحاب % % 2(@)(@@) % يحكم في مكارمه الأماني % % ولو كلفته رد الشباب % % 3(@)(@@) % فما بالي أرى ما أبتغيه % % بعيدا عند منقطع السراب % % 4(@)(@@) % وعذرك في قضا شغلى قضاء % يصرفه ، فما عذر الجواب % % PageV01P267 البحر : خفيف تام 1(@)(@@) % لي صديق أفضي إليه بسري % % وخبايا صدري ومكنون قلبي % % 2(@)(@@) % لا أرى دونه لسري سترا % في مناجاته ومضمون كتبي % % 3(@)(@@) % لو أتتني صحيفتي في حياتي % % قلت خذها فانظر قبائح ذنبي % % 4(@)(@@) % وهو إن جاءه كتاب طواه % وطواه عني اطراحا لعتبي % % 5(@)(@@) % وأرى أن كتبه ليس فيها % % غير سبى ، وغير نقصى وثلبى % % 6(@)(@@) % فلهذا عذرته ولعمري % % إن عذري لمؤلم مثل ضربي % % PageV01P268 البحر : وافر تام 1(@)(@@) % وما أشكو تلون أهل ودي % % ولو أجدت شكيتم شكوت % % 2(@)(@@) % مللت عتابهم ويئست منهم % % فما أرجوهم فيمن رجوت % % 3(@)(@@) % إذا أدمت قوارصهم فؤادي % % كظمت على أذاهم وانطويت % % 4(@)(@@) % ورحت عليهم طلق المحيا % % كأني ما سمعت ولا رأيت % % 5(@)(@@) % تجنوا لي ذنوبا ما جنتها % % يداي ولا أمرت ولا نهيت % % 6(@)(@@) % ولا والله ما أضمرت غدرا % كما قد أظهروه ، ولا نويت % 7(@)(@@) % ويوم الحشر موعدنا ، وتبدو % % صحيفة ما جنوه وما جنيت % PageV01P269 البحر : طويل 1(@)(@@) % أيا منقذي ، والحادثات تنوشني % % ودافع همي إذ ترادف بعثه % % 2(@)(@@) % لساني عن شكري أياديك مفحم % % وأنت ، فأعلى من ثناء أبثه % % 3(@)(@@) % تحملت عني كل خطب يؤودني % % وناهلتني عيشي ، وقد بان خبثه % % 4(@)(@@) % فدى لك ، يا طوع الإخاء أمينه % % على غيبه مستكره الود رثه % % 5(@)(@@) % نسي لما يولى ، وما طال عهده % % ملول لمن يهوى وما دام لبثه % % 6(@)(@@) % وما أشتكي شوقي إليك تجلدا % على أنه بلبال قلبي وبثه % % 7(@)(@@) % وقاسمني قلبي على الصبر عنكم % % ولا عجب إن بان بعدك حنثه % % 8(@)(@@) % وما زال يثنيه إليك حفاظه % % وغدر صروف الدهر عنك تحثه % % 9(@)(@@) % وشاركني فيه هواك ، فهمه % % وأفكاره عندي وعندك مكثه % % 10(@)(@@) % وما ضعضعتني الحادثات وإنني % % كعهدك وعر الخلق في الخطب 
ms51	 وعثه % % PageV01P270 11(@)(@@) % جريء على الأهوال والموت محجم % % مرير القوي ، والدهر قد بان نكثه % % 12(@)(@@) % كظوم على غيظ يضيق به الحشا % % فلست وإن آد اصطباري أبثه % % 13(@)(@@) % ولم أرث الصبر الجميل كلالة % ولكنه عن مرشد لي إرثه % % 14(@)(@@) % عن الممترى أخلاف دهر تشابهت % أطايبه إلا عليه وغثه % % 15(@)(@@) % نداه ربيع ينعش الناس سيبه % % إذا أخلف الوسمى جاد ملثه % % 16(@)(@@) % يضاعف داء الحاسدين كماله % % على أنه يشفي من الداء نفثه % % PageV01P271 البحر : مجزوء الكامل 1(@)(@@) % يا ثانيا للنفس ، وه % و لناظري أعز ثالث % % 2(@)(@@) % ونجي فكري دون سا % % ئر من أناجي أو أحادث % % 3(@)(@@) % أشكو فراقك فهو أو % % جع ما لقيت من الحوادث % % 4(@)(@@) % شكوى مشوق يستري % % ح إليك ، والمصدور نافث % 5(@)(@@) % وألوم دهرا جد في % % تشتيت شملي وهو عابث % % 6(@)(@@) % إني علقت من اصطبا % % ري عنك أسبابا رثائث % 7(@)(@@) % عاهدته ألا تضع % % ضعه النوى وأراه ناكث % % 8(@)(@@) % وكأن قلبي حين يخ % % طر ذكركم في كف ضابث % % 9(@)(@@) % وبقاي بعد فراقكم % % خطب ، لعمر أبيك ، كارث % PageV01P272 البحر : مجزوء الكامل 1(@)(@@) % يا من هواه على التنا % % ئي والتداني في ازدياد % % 2(@)(@@) % أصبحت مغتربا لبع % % دك ، بين أهلي في بلادي % % 3(@)(@@) % مستوحشا مع كثرة ال % % خلان وحشة ذي انفراد % % 4(@)(@@) % وأقل ما لاقيت بع % % دك من تباريح البعاد % % 5(@)(@@) % شوق إليك أباح في % % ض مدامعي وحمى رقادي % % PageV01P273 البحر : طويل 1(@)(@@) % أساكن قلبي والمهامه بيننا % % وإنسان عيني والمزار بعيد % % 2(@)(@@) % تمثلك الأشواق لي كل ليلة % % فهمي جديد والفراق جديد % % 3(@)(@@) % ومعظم همي أن عمر فراقنا % % مديد وعمري للشقاء مديد % % 4(@)(@@) % فيا صخر ما الخنساء مثلي ولا نهى % % بوادر دمعي ما قضاه لبيد % PageV01P274 البحر : طويل 1(@)(@@) % أبا حسن ، وافى كتابك شاهرا % صوارم عتب كل صفح لها حد % % 2(@)(@@) % فقابلت بالعتبى مضيض عتابه % % ولم يتجهمه الحجاج ولا الجحد % % 3(@)(@@) % وأعجبني عي لديه ولم أزل % % إذا لم تكن خصمي لي الحجج اللد % % 4(@)(@@) % فيا حبذا ذنب إلي نسبته % % وما خطأ مني أتاه ولا عمد % % 5(@)(@@) % ولو كان ما بلغته فظننته 
ms52	 % % لكفره حق الأخوة والود % % 6(@)(@@) % فأهلا بعتب تستريح ببثه % % ويؤمننى أن يستمر بك الحقد % 7(@)(@@) % لقد راق في قلبي ولذ سماعه % % بسمعي فزدني من حديثك يا سعد % % PageV01P275 البحر : طويل 1(@)(@@) % ألا أبلغا عني أناسا صحبتهم % % فما حفظو عهدا ، ولا راعوا الودا % % 2(@)(@@) % بأني وإن حالت بي الحال لم أقل % % لهم واصفا شوقا ولا شاكيا وجدا % % 3(@)(@@) % خذوا بزمامي ، قد رجعت إليكم % رجوع مريد لا يرى منكم بدا % % 4(@)(@@) % ولكن لى الأعواض فى الناس منكم % وكل سماء من سمائكم أندى % % PageV01P276 البحر : طويل 1(@)(@@) % أأحبابنا ، خطب التفرق شاغل % عن العتب لكن جاش بالكمد الصدر % % 2(@)(@@) % لأسرع ما حلتم عن العهد بعدما % % تصرم في حفظي ودادكم العمر % % 3(@)(@@) % ولا عجب ، أنتم بنو الدهر ، مثله : % عهودكم غدر وودكم ختر % % 4(@)(@@) % كأنكم الدنيا : تمد رجاءنا % % بزخرفها ، والموت فيها لنا قصر % 5(@)(@@) % مللتم فملتم نحو داعية القلى % % وخنتم فدنتم بالذي شرع الغدر % % 6(@)(@@) % وأنساكم حفظ العهود ملالكم % % كما قد تنسى لب شاربها الخمر % 7(@)(@@) % وإني لتثنيني إليكم حفيظتي % % إذا ما ثناكم عن محافظتي الغمر % % 8(@)(@@) % وأكذب رأي العين فيكم وإنكم % % لتقضون في هجري بما خيل الفكر % % 9(@)(@@) % أساهل فيما راب منكم ودون ما % % أؤمل : من إنصافكم مسلك وعر % 10(@)(@@) % لهجتم بهجري ، والديار قريبة % وما قرب دار حال من دونها الهجر % % PageV01P277 11(@)(@@) % وأغضى تجنيكم جفوني على القذى % % إلى أن تقضى ذلك الزمن النضر % 12(@)(@@) % فلما تفرقنا أتتني قوارص % % بها ينفض الأحلاس في السفر السفر % 13(@)(@@) % أسركم أن خلتم الدهر ساءنا % % وقرت بنا ، لاقرت ، الأعين الخزر % 14(@)(@@) % وجاهر بالشحناء قوم عهدتم % % يسوءهم ، لو لم أغب عنهم ، الجهر % 15(@)(@@) % وأصغيتم إذ لم تقولوا وطالما % % تعرض في الأسماع من ذكرى الوقر % PageV01P278 البحر : مديد تام 1(@)(@@) % وكتاب منك فاجأني % % كبشير جاء بالظفر % 2(@)(@@) % رد لي شرخ الشباب وما % % غالت الأيام من عمري % % 3(@)(@@) % ظنه الرائي مكاتبة % وهو أصدف على درر % % PageV01P279 البحر : مجزوء الخفيف 1(@)(@@) % يا بعيدا أحله الش % % وق قلبي وناظري % % 2(@)(@@) % ما نأى من خياله % % حاضر في ضمائري % % 3(@)(@@) % والتنائي 
ms53	 إذا صفا % % ودنا ، غير ضائر % % PageV01P280 البحر : طويل 1(@)(@@) % يكاثر ماء الرزم عند ادكاركم % % دموعي ، ولكن ذا برود ، وذى قطر % 2(@)(@@) % ولو لم أعرها بعدكم كل من بكى % % لأعظمها عن أن يكاثرها القطر % % PageV01P281 البحر : وافر تام 1(@)(@@) % أشمس الدولة اسمع بث شوق % % يضيق بمثله ذرع الصبور % % 2(@)(@@) % لقد أوحشت دنيا ، كنت أنسى % % بها وسلبتني رغد السرور % % 3(@)(@@) % إذا ما الشمس لم تظهر بأرض % % فما طيب الحياة بغير نور % 4(@)(@@) % وإن أصبحت في خلدي مقيما % بحيث يجول فكري من ضميري % % 5(@)(@@) % فقرب الدار خير من بعاد % % ورؤيا العين أشفى للصدور % % PageV01P282 البحر : طويل 1(@)(@@) % أأحبابنا ، ما مصر بعدكم مصر % ولكنها قفر ، إليكم بها فقر % 2(@)(@@) % وإن تخل يوما بقعة من شخوصكم % % فلم يخل يوما من مودتكم صدر % 3(@)(@@) % وإن تنئكم عنا المهامه والسرى % % تقربكم منا المودة والذكر % % 4(@)(@@) % رحلتم ، فعاد الدهر ليلا بأسره % % وليس له إلا بأوبتكم فجر % 5(@)(@@) % ترى فاض ما ألقى نم الهم والأسى % % لبعدكم ، فاسود من صبغه الدهر % 6(@)(@@) % وكيف ألوم الليل إن طال بعدكم % % وقد غاب عني منكم الشمس والبدر % % 8(@)(@@) % تذكره أحبابه الأنجم الزهر % % فيا ويحه ماذا به صنع الذكر % % 9(@)(@@) % هم مثلها بعدا ونورا ورفعة % ولكن لها ، إذ شبهت بهم ، الفخر % 10(@)(@@) % وقد كنت أشكو هجرهم في دنوهم % % فمن لي لو دام التداني والهجر % % 11(@)(@@) % سقى مصر جود الصالح الملك إنه % % هو الوابل المحي البرية لا القطر % PageV01P283 12(@)(@@) % ففيها كرام أسعروا بجوانحى % % ببعدهم جمرا ، به يحرق الجمر % 13(@)(@@) % ومن عادتي الصبر الجميل وليس لي % % على بعدهم ، لادر النوى ، صبر % 14(@)(@@) % إذا ما أمين الدين عن ادكاره % % ذهلت كأني خامرت لبي الخمر % % 15(@)(@@) % يذكرنيه الفاضلون ، وإن غدوا % % جداول إن قيسوا به ، وهو البحر % 16(@)(@@) % إذا حضر النادي فرضوى رجاحة % وإن قال فالدر المنظم والسحر % 17(@)(@@) % ويعجبني منه تدفق علمه % % وأعجب منه كيف يجمعه صدر % % 18(@)(@@) % تناءت بنا الداران والود مصقب % % فللقرب شطر ، والبعاد له شطر % 19(@)(@@) % كأن الليالي إذ قضت بفراقنا % % قضى جورها أن ليس تجمعنا مصر % % 20 
ms54	(@)(@@) % أحل بها إن غاب عنها ، وإن أغب % % يحل بها ، فاعجب لما صنع الدهر % 21(@)(@@) % فليت تلاقينا ولو بعض ساعة % % يحم وشيكا ، قبل أن ينفذ العمر % PageV01P284 22(@)(@@) % لأحظى برؤياه وأشكر منه % % وإن لم يقم عني بواجبه الشكر % % PageV01P285 البحر : بسيط تام 1(@)(@@) % لأشكرن اهتماما منك يذكرني % % في البعد حتى كأني مصقب الدار % % 2(@)(@@) % بعدت عنه فما أنكرت خلته % % مع التنائي وكم أنكرت من جار % % PageV01P286 البحر : كامل تام 1(@)(@@) % أصبحت بعدك يا شقيق النفس في % % بحر من الهم المبرح زاخر % 2(@)(@@) % متفردا بالهم ، من لي ساعة % % برفاق شعيا ، أو علالة داهر % % PageV01P287 البحر : طويل 1(@)(@@) % كتابى ، ولولا أن يأسي قد نهى اش % % تياقي لذاب الطرس من حر أنفاسي % % 2(@)(@@) % وبعد فعندي وحشة لو تقسمت % % على الخلق لم يستأنس الناس بالناس % % PageV01P288 البحر : كامل تام 1(@)(@@) % مالي وللشفعاء فيما أرتجي % % من حسن رأيك في ، وهو شفيعي % % 2(@)(@@) % أعذبت لي من جود كفك موردى % % فصفا وأمرع من نداك ربيعي % % 3(@)(@@) % وبك اعتليت وطلت من ساميته % % فخرا بمجدك لا بحسن صنيعي % % 4(@)(@@) % وقضى ببعدي عنك دهر جائر % % وإلى جنابك ، إن سلمت ، رجوعي % % PageV01P289 البحر : وافر تام 1(@)(@@) % نظام الدين لا سقيا لخطب % % رمانا بالنوى بعد اجتماع % % 2(@)(@@) % عدا حتى على حسن اصطباري % % وضن علي حتى بالوداع % 3(@)(@@) % فما قلبي لسلوان مطيع % % ولا السلوان عنك بمستطاع % % 4(@)(@@) % ولو أملت أن ألقاك حتى % % أبثك مضمر القلب الشعاع % 5(@)(@@) % لسرتني الأماني أو لسرت % % جوى قلبي لبعدك والتياعي % % PageV01P290 البحر : طويل 1(@)(@@) % مواصلتي كتبي إليك تزيدني % % إليك اشتياقا ، بل عليك تأسفا % 2(@)(@@) % ولي أسوة فى الناس لو نفع الأسى % % فمن قبلنا يعقوب فارق يوسفا % % 3(@)(@@) % ولكن نفسي قد تملكها الأسى % % وقلبي ، إذا سكنته بالأسى هفا % % 4(@)(@@) % وما أحسب الأيام تقنع بالنوى % % ولا أن صرف الدهر بالفرقة اشتفى % % PageV01P291 البحر : طويل 1(@)(@@) % وابتزني رأي عز الدين مستلبا % من بعدما عمني إحسانه وضفا % % 2(@)(@@) % أضافني عتبه هما شجيت به % % أبان عن ناظري طيب الكرى ونفى % % 3(@)(@@) % أتته عني أحاديث مزخرفة % % ما إن بها عنه ، وهو الألمعي ، خفا 
ms55	 % % 4(@)(@@) % لكنها وافقت من قلبه مللا % لم يستبن صحة الدعوى ولا كشفا % % 5(@)(@@) % وما الرضا ببعيد من خلائقه % وهي السلافة راقت رقة وصفا % % 6(@)(@@) % يا من حوى قصبات السبق أجمعها % % فما يرى اثنان في تفضيله اختلفا % % 7(@)(@@) % أنفقت مذهب عمري في رضاك وما % % رأيت منفق عمر واجدا خلفا % % 8(@)(@@) % لكنني اعتضت منه حسن رأيك لي % % فنلت منه العلا والعز والشرفا % % 9(@)(@@) % حتى إذا أنا ماثلت النجوم علا % وقلت : قد نلت من أيامي الزلفا % % 10(@)(@@) % أريتني بعد بشر هجرة وقلى % وبعد بر ولطف ، قسوة وجفا % % PageV01P292 11(@)(@@) % فعدت صفر يد مما ظفرت به % % كأن ما نلته من كفي اختطفا % % 12(@)(@@) % هبني أتيت بجهل ما قذفت به % % فأين حلمك والفضل الذي عرفا % % 13(@)(@@) % ولا ، ومن يعلم الأسرار حلفة من % % يبر فيما أتى ، إن قال ، أو حلفا % % 14(@)(@@) % ما حدثتني نفسي عند خلوتها % % بما تعنفني فيه إذا انكشفا % % 15(@)(@@) % لكنها شقوة حانت ، وأقضية % حبتني الهم مذ عامين والأسفا % % 16(@)(@@) % تداولتني أمور غير واحدة % لو حمل الطود أدنى ثقلها نسفا % % 17(@)(@@) % وأقصدتني سهام الحاسدي على % % فوزي بقربك حتى قرطسوا الهدفا % % 18(@)(@@) % وبعد ما نالني إن جدت لي برضا % فقد غفرت لدهري كل ما سلفا % % 19(@)(@@) % وذاك ظني ، فإن يصدق فأنت لما % % رجوت أهل ، وإن يخفق فوا أسفا % % 20(@)(@@) % حاشاك تغدو ظنوني فيك مخفقة % أو ينثني أملي باليأس منصرفا % PageV01P293 21(@)(@@) % وجنتي من زماني حسن رأيك بي % % أكرم بها جنة لا البيض والزغفا % % 22(@)(@@) % ألفت منك حنوا منذ كنت ، وقد % % فقدته وشديد فقد ما ألفا % % 23(@)(@@) % وغير مستنكر منك الحنو على % % مثلي ولو زاغ يوما ضلة وهفا % % 24(@)(@@) % فعد لأحسن ما عودت من حسن % % يا من إذا جاد وفى أو أذم وفى % % 25(@)(@@) % واسلم لنا ثالثا للنيرين علا % وزد إذا نقصا ، واشرف إذا كسفا % % 26(@)(@@) % أيامنا بك أعياد بأجمعها % % فدم لنا ما دجا ليل ، وما عكفا % % PageV01P294 البحر : كامل تام 1(@)(@@) % لكنني أشكو قوارص من % % تلقائهم ، قلبي لها يجف % 2(@)(@@) % وملالة منهم يبين على % % أثنائها الشنآن والشنف % 3 
ms56	(@)(@@) % أنكرت قسوتهم ، وأعرفهم % كرماء إما استعطفوا عطفوا % % 4(@)(@@) % قطعوا أواصر بيننا وشجت % أسبابها الأنساب والسلف % % 5(@)(@@) % وإذا سلمت ، أبا سلامة ، لي % % فمصاب كل رزية ظلف % % 6(@)(@@) % لى سلوة بك عن بني زمني % % فليجهدوا في الغدر أو ليفوا % % 7(@)(@@) % قارعت دونى الحادثات ، فلا % % طرقت فناءك ، ما دجا السدف % 8(@)(@@) % وكفيت آمالي بجودك أن % % تضحي إلى الرغبات تشترف % % 9(@)(@@) % فغدوت لا خطبا أخاف ولا % % أنا إثر شيء فائت أسف % PageV01P295 البحر : كامل تام 1(@)(@@) % يابن الألى جمع الفخار لبيتهم % ما شتتوه من العطاء ، وفرقوا % % 2(@)(@@) % وتملكوا رق الأكارم بالذي % % فكوا به رق العناة وأطلقوا % % 3(@)(@@) % أشكو إلى علياك هما ضاق عن % % كتمانه صدري وما هو ضيق % % 4(@)(@@) % وطوارقا للهم أقريها الكرى % % وتلظ بي صبحا ، فما تتفرق % 5(@)(@@) % لو لم أمن النفس أنك كاشف % كرباتها عنها لكادت تزهق % 6(@)(@@) % أنا عائذ بك من عقوق محبط % عملي فعصياني لأمرك موبق % % 7(@)(@@) % لا تلزمني بالهوان وحمله % إن احتمال الهون ثقل مرهق % % 8(@)(@@) % دعني وقطع الأرض دون معاشر % % كل علي لغير جرم محنق % % 9(@)(@@) % تغلي علي صدورهم من غيظهم % % فتكاد من غيظ علي تحرق % % 10(@)(@@) % تعشى إذا نظروا إلى عيونهم % % حتى كأن الشمس دوني تشرق % PageV01P296 11(@)(@@) % كسدت على بضائعي فيهم ، فلا % أدبي ولا نسبي عليهم ينفق % % 12(@)(@@) % أعيا علي رضاهم فيئست من % % إدراكه ما النجم شيء يلحق % % 13(@)(@@) % إن أغشهم قالوا خلوب ماذق % % أو أجفهم ، قالوا : عدو أزرق % 14(@)(@@) % قد أفسدوا عيشي علي ، وعيشهم % % فأنا الشقي بهم وبي أيضا شقوا % % 15(@)(@@) % % ألا يكدر بالهموم ، ويمذق % 16(@)(@@) % وعسى قلوب أعضلت أدواؤها % % فى قربنا بعد التفرق تفرق % 17(@)(@@) % فضل الأقارب برهم وحنوهم % % فإذا جفوني فالأباعد أرفق % % 18(@)(@@) % أتظنني أرجو عواطف ودهم % % إنى إذا عبد المطامع ، أخرق % 19(@)(@@) % بيني وبينهم هنات في الحشا % % منها ندوب ، ما بقيت وما بقوا % % 20(@)(@@) % لا تغترر برجائهم أن يحسنوا % % كم قد رأينا من رجاء يخفق % PageV01P297 21(@)(@@) % خذ ما تراه ودع أحاديث المنى % % إن الأماني فيهم لا تصدق % 22(@)(@@) % وأغث فإن السيل قد بلغ الزبى 
ms57	 % % حقا ، وأدركنى قبيل أمزق % PageV01P298 البحر : بسيط تام 1(@)(@@) % إيها ، بحقك مجد الدين تعلم أن % بر عنك أو السلوان من خلقي % % 2(@)(@@) % أو أنني بعد بعدي عنك مغتبط % % بالعيش ، إني به ، لا تكذبن شقي % % 3(@)(@@) % يا ويح قلبي من شوق يقلقله % % إلى لقائك ماذا من نواك لقي % % 4(@)(@@) % وناظر قرحت أجفانه أسفا % عليك في لجة من دمعه غرق % % 5(@)(@@) % وبعد ما بي فإشفاقي يهددني % % بشوب رأيك بالتكدير والرنق % % 6(@)(@@) % وأن قلبك قد رانت عليه من ال % % واشين بي جفوة يهماء كالغسق % % 7(@)(@@) % ونافسوني في حسنى ظنونك بي % % حتى غدوت وسوء الشك فى نسق % 8(@)(@@) % بهم تباريح أشواقى إليك ، وما % % أجن من زفرات بالجوى نطق % % 9(@)(@@) % أما كفاهم نوى داري وبعدك عن % % عيني وفرقة إخوان الصبا الصدق % % 10(@)(@@) % وأنني كل يوم قطب معركة % دريئة السمر والهندية الذلق % % PageV01P299 11(@)(@@) % أغشى الوغى مفردا من أسرتي وهم % % هم إذا الخيل خاضت لجة العلق % % 12(@)(@@) % هم المحامون والأشبال مسلمة % % والملتقون الردى بالأوجه الطلق % % 13(@)(@@) % وموضعي منك لا تسمو الوشاة له % % ولا يغيره كيسي ولا حمقي % % 14(@)(@@) % وإنما قالة جاءت فضاق لها % % صدرى ، ولو غيرك المعني لم يضق % % 15(@)(@@) % كذبتها ، ثم ناجتني الظنون بأن % الدهر ليس بمأمون ، فلا تثق % % 16(@)(@@) % كم قد أغص بما تمرى مذاقته % % ونغص البارد السلسال بالشرق % 17(@)(@@) % توقع الخوف ممن أنت آمنه % % قد تنكأ الكلم كف الآسي الرفق % % 18(@)(@@) % فقلت مالي وكتمي ما تخالجني % % فيه الظنون كفعل المغضب الملق % 19(@)(@@) % أدعو لما بي صدى صوتي وموضع شك % % واي وحامل ثقلي حيث لم أطق % % 20(@)(@@) % فإن يكن ما نمى زورا ، وأحسبه % فعنده العفو عن ذي الهفوة العقق % % PageV01P300 21(@)(@@) % وإن يكن وأحاشي مجده ثلجت % % عتباه حر حشا بالهم محترق % % 22(@)(@@) % هو الأبي الذي تخشى بوادره % % ويرتجى عفوه في سورة الحنق % 23(@)(@@) % عتباه تلقى ذنوبي قبل معذرتي % % وماء وجهي مصون فيه لم يرق % % 24(@)(@@) % لا غيرت رأيه الأيام في ، ولا % % نالت مكاني منه لقعة الحدق % % PageV01P301 البحر : طويل 1(@)(@@) % أأحبابنا ، هلا سبقتم بوصلنا % % صروف الليالي قبل أن 
ms58	 نتفرقا % % 2(@)(@@) % تشاغلتم بالهجر ولوصل ممكن % % وليس إلينا في الحوادث مرتقى % % 3(@)(@@) % كأنا أخذنا من صروف زماننا % % أمانا ، ومن جور الحوادث موثقا % % PageV01P302 البحر : كامل تام 1(@)(@@) % بعدت مسافة بيننا وتوحشت % % حتى على طيف الخيال الطارق % % 2(@)(@@) % ويئست من أن نلتقي ، لكنني % % ألقى تذكركم بقلب خافق % % 3(@)(@@) % وأغيض العبرات وهي فرائد % % من لؤلؤ ، فتفيض سمط عقائق % % PageV01P303 البحر : طويل 1(@)(@@) % أبا حسن ، لولا التعلل بالمنى % % قضى كمدا قلب إليك مشوق % 2(@)(@@) % إذا ما اعترته ذكرة منك خلته % % جناحا وهي عظماه ، فهو خفوق % 3(@)(@@) % يزيد اشتياقا كلما زاد يأسه % % فيا عجبا لليأس كيف يشوق % % 4(@)(@@) % وما ساءني أني لبعدك جازع % % لأن جميل الصبر عنك عقوق % PageV01P304 البحر : كامل تام 1(@)(@@) % لا تفسدن نصيحتى بشقاق % وأبيك ما السلوان من أخلاقى % % 2(@)(@@) % حظر الوفاء علي أن أسلو فلا % % فك السلو من الغرام وثاقي % % 3(@)(@@) % لا ترجون لي الشفاء من الجوى % % واليأس كل اليأس من إفراقي % % 4(@)(@@) % كيف الإفاقة للديغ أخي الهوى % % من دائه والسم في الدرياق % % 5(@)(@@) % سقم الجفون سقامه ، وشفاؤه % % فيها فمنها الداء وهي الراقي % % 6(@)(@@) % وأغن راعتني النوى بفراقه % % ولكم فجعت ولا كذا بفراق % % 7(@)(@@) % أخلو بأفكاري ، لتدنى شخصه % % خدع المنى من قلبي الخفاق % % 8(@)(@@) % وأكرر التسآل عنه لجاهل % % علمى ، وتلك علالة المشتاق % 9(@)(@@) % فإذا تسامح لي الزمان بقربه % % من بعد بيني فرقة وشقاق % % 10(@)(@@) % باثثته وجدي وقلت يرق لي % % فأجابني بالصمت والإطراق % % PageV01P305 11(@)(@@) % ويلو مني فيه رفيق يدعى % % نصحي ، أضاع النصح حق رفاقي % % 12(@)(@@) % إيها كلانا يشتكي حر الهوى % % لكن جهلت تباين العشاق % % 13(@)(@@) % أنت استضأت بناره متبصرا % وأنا صليت بجمره المحراق % 14(@)(@@) % أتلومني بعد الهبوب من الكرى % % وحشاك مثلوج ودمعك راق % 15(@)(@@) % لا در درك سوف يفردك الهوى % % مني فلا تتعجلن فراقي % % 16(@)(@@) % أسلمتني للوجد إن أرضاك أن % % أضنى فكل رضاي أنك باقي % % 17(@)(@@) % إن جرت عن نهج الكرام فمرشد % لك مرشد بمكارم الأخلاق % % 18(@)(@@) % فاعمد لمجدالدين تلق المجد ما % % لاقيته ، أكرم به من لاق % 19(@)(@@) % فإذا وصلت إلى أغر محجب % مخلوقة 
ms59	 كفاه للإنفاق % % 20(@)(@@) % فاربع بربع لا يزال نزيله % % حسن الثناء وخشية الخلاق % % PageV01P306 21(@)(@@) % وابلغ تحية نازح قذفت به % % أيدي النوى في أسحق الآفاق % 22(@)(@@) % قد كان بالشامي يعرف برهة % من دهره ، والآن فهو عراقي % % 23(@)(@@) % أنضى الوجيف ركابه وجياده % % فكأنهن قلائد الأعناق % % 24(@)(@@) % وهو الجليد على خطوب زمانه % % لا يشتكي منها سوى الأشواق % 25(@)(@@) % ينزو لذكر أبي سلامة قلبه % فيكاد يمرق من حشا وصفاق % 26(@)(@@) % واهتف به : يا خير من أرجوه ل % لأواء أو أدعوه يوم تلاق % 27(@)(@@) % بي لوعتان عليك يضعف عنهما % % جلدي من الأشواق والإشفاق % % 28(@)(@@) % فالشوق أنت به العليم ، وغالب الإ % % شفاق مما أنت في ملاق % 29(@)(@@) % وإذا آخطأتك الحادثات ، فكل ما % % ألقاه محمول على الأحداق % 31(@)(@@) % أتظن أني بعد بعدك باقي % % أجزي عن الأشواق بالأشواق % PageV01P307 33(@)(@@) % أأبا المظفر دعوة تشفي الظما % % مني ، وإن أضحى بها إحراقي % % 34(@)(@@) % لم أستكن أبدا لخطب نازل % % إلا لبعدك ، فهو غير مطاق % 35(@)(@@) % فإذا أطعت الوجد فيك أطاعني % % قلبي ، ويبدي ، إن عصيت ، شقاقي % % 36(@)(@@) % فإذا ذكرتك خلت أني شارب % % ثمل سقاه من المدامة ساقي % % 37(@)(@@) % يا راكب الشدنية الغيداق % ومتابع الزملان بالإعناق % % 38(@)(@@) % في فتية وصلوا السرى حتى انبرت % % أجسامهم أخفى من الأرماق % 39(@)(@@) % من كل مهتز بكف نعاسه % % هز الوليد ثناية المخراق % % 40(@)(@@) % وضع النعاس على الأكف خدودهم % % فكأنهم خلقوا بلا أعناق % % 41(@)(@@) % إما بلغم سالمين ، فبلغوا % % أوفى تحية مشئم لعراقي % % 42(@)(@@) % وتوسموا ذاك المحيا وامتروا % % تلك البنان مفاتح الأرزاق % % PageV01P308 43(@)(@@) % من آل منقذ الذين عراصهم % % ملأى من الزوار والطراق % 44(@)(@@) % اللابسين من المكارم جنة % ما للمعايب غيرها من واق % % 45(@)(@@) % يتهللون لدى النوال ، وفي الوغى % % يسطون بالإرعاد والإبراق % 46(@)(@@) % يأيها المولى الذي ببعاده % % عني ، قربت من الردى المعتاق % 47(@)(@@) % لي أنة الشاكي الشجي لما به % % إما ذكرت ، ولوعة المشتاق % % 48(@)(@@) % وإذا الجفون نظرن بعدك نزهة % عاقبتهن بدمعي المهراق % % 49(@)(@@) % لا تطلبن مني المسرة ، إنها % % عذراء ، قد متعتها بطلاق % 50(@)(@@) % أما أبوك فداؤه مستحكم % ما إن له بسواك من إفراق 
ms60	 % 51(@)(@@) % كيف السلو له وأنى صبره % % عن مصطفى بمكارم الأخلاق % 52(@)(@@) % ذو مهجة تنزو إليك ومقلة % % تبكي عليك إليك بالأشواق % % PageV01P309 53(@)(@@) % لما علمت بعجزه عن نظم ما % % ينهي إليك وذاك باستحقاق % % 54(@)(@@) % أجريت طرفي في سباقك دونه % % وعهدته أبدا من السباق % % 55(@)(@@) % وبذلت جهدي بالنيابة عنه بال % % نزر القليل من الكثير الباقي % % 56(@)(@@) % جريا على شغفي بكم ومحبتي % % لكم وحفظ العهد والميثاق % % PageV01P310 البحر : مجزوء الكامل 1(@)(@@) % قد كنت أحسب أن آ % % مد منتهى أمد الفراق % % 2(@)(@@) % وأسكن القلب الخفو % % ق إليكم بمنى التلاقي % % 3(@)(@@) % وأقول قد رق الزما % % ن لبرح وجدي واشتياقي % % 4(@)(@@) % وإذا به مستصغر % ما قد لقيت وما ألاقي % % 5(@)(@@) % يقضي بتشتيتي وإر % % جاء اللقاء إلى التلاقي % % PageV01P311 البحر : وافر تام 1(@)(@@) % ضياء الدين ، ما شوق دعاني % % فاسمعني بمصر من العراق % 2(@)(@@) % بمحدود فأشرحه ولا في % % قوى الأقلام تسطير اشتياقي % % 3(@)(@@) % ولكني سأرجئه وأرجو % % مشافهتي به عند التلاقي % % 4(@)(@@) % إذا ما كنت جارك ذا اشتياق % إليك فكيف بي بعد الفراق % 5(@)(@@) % ولي شكوى من الأيام أضحت % % لها نفسي تردد في التراقيي % % 6(@)(@@) % أكلف من أذاها فوق وسعي % % وأحمل كارها غير المطاق % % 7(@)(@@) % ويلزمني الإباء الصبر فيما % % ينوب وطعمه مر المذاق % % 8(@)(@@) % ومغفور لها ، إن أسعفتني % % بقربك ما لقيت وما ألاقي % % PageV01P312 البحر : خفيف تام 1(@)(@@) % كم إلى كم يلحي المحب المشوق % وهو من سكرة الهوى لا يفيق % % 2(@)(@@) % حملوه ، وهو الضعيف من التع % % نيف فيهم واللوم ما لا يطيق % % 3(@)(@@) % شجعوه على القطيعة والص % % ب من الصد والفراق فروق % 4(@)(@@) % ولحوه من ساحل البحر والمس % % كين في لجة الغرام غريق % 5(@)(@@) % والسقيم العاني يعاني من الأو % % صاب ما لا عانى المعافي الطليق % 6(@)(@@) % يا عذولي إليك عني فما أن % % ت كما تدعي الصديق الصدوق % % 7(@)(@@) % ليس للصب من تباريح ما يل % % قى معين ولا رفيق رفيق % % 8(@)(@@) % إنما الحب كالقيامة : ما في % % ه حميم ولا شقيق شفيق % % 9(@)(@@) % وأخو الوجد ما إلى قلبه المح % % جوب بالحب للسلو طريق % % 10(@)(@@) % خانه 