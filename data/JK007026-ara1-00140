ms121	 فافعلوا . |(@)(@@) 564 - ( 68 ) وعن حذيفة أنه دخل المسجد فرأى رجلا | لا يتم الركوع ولا السجود ، فقال : مذ كم صليت ؟ قال : مذ أربعين | سنة ، قال : / ما صليت ، ولو مت مت على غير الفطرة التي فطر الله | عز وجل عليها محمدا [ صلى الله عليه وسلم ] ، إن الرجل ليخف صلاته ويتم الركوع | والسجود . |(@)(@@) 565 - ( 69 ) حدثنا محمد بن غالب ، قال : حدثنا سعيد بن | سليمان ، قال : حدثنا محمد المدني ، عن ابن شهاب ، عن عامر بن سعد ، | عن أبيه ، قال : | PageV01P388(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من أهان قريشا أهانه الله ' . |(@)(@@) 566 - ( 70 ) حدثنا محمد بن الهيثم بن حماد بن واقد ، قال : | حدثنا محمد بن كثير بن أبي عطاء ، عن الأوزاعي ، عن عبد الله بن | عبد الرحمن ، عن أنس ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' فضل عائشة على النساء كفضل الثريد على | سائر الطعام ' . |(@)(@@) 567 - ( 71 ) حدثنا محمد ، قال : حدثنا سعيد بن أبي مريم ، | قال : أخبرنا نافع بن عمر ، قال : حدثني ابن أبي مليكة ، عن المسور بن | مخرمة ، قال :(@)(@@) قال عمر بن الخطاب لعبد الرحمن بن عوف : ألم نجد فيما أنزل | علينا أن جاهدوا كما جاهدتم أول مرة ، فإنا لا نجدها ؟ قال : أسقط فيما | أسقط من القرآن ، قال عمر : أنخشى أن يرجع الناس كفارا ؟ قال : ما شاء | الله ، قال : لئن رجع الناس كفارا ليكونن أمراؤهم فلان وفلان | PageV01P389 | ووزراؤهم . |(@)(@@) 568 - ( 72 ) حدثنا محمد ، قال : حدثنا ابن أبي مريم ، قال : | أخبرنا الليث بن سعد ، قال : أخبرني يحيى بن سعيد ، قال : أخبرني رجل | من قريش مرضي - قال ابن أبي مريم : يريد نافع بن عمر - عن ابن | أبي مليكة ، عن المسور ، عن عبد الرحمن بن عوف بآخر الحديث ، قال | عمر : لئن كان ذلك ، لا يكون إلا بنو أمية وبنو مخزوم من [ الأمر | بسبيل ؟ ] . |(@)(@@) 569 - ( 73 ) حدثنا محمد بن غالب ، قال : حدثنا أبو سلمة | المنقري ، قال : أخبرنا همام ، عن قتادة ، عن أنس بن مالك ، قال :(@)(@@) أتيت رسول الله [ صلى الله عليه وسلم ] بقناع فيه رطب ، فجعل يقبض 
ms122	 القبضة فيبعث بها | إلى بعض أزواجه ، ثم أكل أكل رجل يعرف أنه يشتهيه . |(@)(@@) 570 - ( 74 ) حدثنا محمد ، قال : حدثنا أبو سلمة ، قال : حدثنا | جرير بن حازم ، قال : حدثنا يعلى بن حكيم ، أظنه عن سعيد بن جبير ، عن | ابن عمر : | PageV01P390(@)(@@) أن النبي [ صلى الله عليه وسلم ] قال : ' الحياء والإيمان قرنا جميعا ، / وإذا رفع | أحدهما رفع الآخر ' .(@)(@@) قال محمد : حدثنا أبو سلمة في سؤال [ ابن استويه ؟ ] في الفوائد | وأسنده ، وحدثنا به في جملة حديث جرير بن حازم ولم يقل فيه : عن | النبي [ صلى الله عليه وسلم ] . |(@)(@@) 571 - ( 75 ) حدثنا محمد ، قال : حدثنا أحمد بن محمد بن | أيوب ، قال : حدثنا إبراهيم بن سعد ، عن محمد بن إسحاق ، عن | شريك بن عبد الله ، عن يزيد بن أبي زياد ، عن عبد الله بن الحارث ، | عن ابن عباس ، قال :(@)(@@) لما كان يوم فتح مكة جاء العباس بن عبد المطلب بمجاشع بن | مسعود السلمي إلى النبي [ صلى الله عليه وسلم ] ، فقال : أقسمت لنبايعنه على الهجرة ، فقال | النبي [ صلى الله عليه وسلم ] : ' لا هجرة إن الهجرة قد مضت لأهلها ، ولكن أبايعه على | الإسلام ' . فبايعه رسول الله [ صلى الله عليه وسلم ] وقال : ' أبررت قسم عمي ، ولا | هجرة ' . | PageV01P391 |(@)(@@) 572 - ( 76 ) حدثنا محمد ، قال : حدثني داود بن شبيب ، قال : | حدثنا أبو هلال - فيما أحسب - عن قتادة ، عن أنس :(@)(@@) عن النبي [ صلى الله عليه وسلم ] قال : ' من يرد هوان قريش يهنه الله ' . |(@)(@@) 573 - ( 77 ) حدثنا محمد ، قال : حدثنا عارم إملاء من أصله ، | قال : حدثنا أبو هلال ، عن قتادة :(@)(@@) عن النبي [ صلى الله عليه وسلم ] نحوه ، ولم يذكر أنسا . |(@)(@@) 574 - ( 78 ) حدثنا محمد ، قال : حدثنا أبو حذيفة : حدثنا | سفيان ، عن أبيه ، عن أبي الضحى ، عن ابن عباس ، قال :(@)(@@) جاء العباس إلى النبي [ صلى الله عليه وسلم ] فقال : إنك قد تركت فينا ضغائن منذ | صنعت الذي صنعت ، فقال النبي [ صلى الله عليه وسلم ] : ' لا يبلغوا الخير - أو قال : | الإيمان - حتى يحبوكم لله ولقرابتي ، أترجو سلهم - حي من مراد - | شفاعتي ولا يرجو بنو عبد المطلب 
ms123	 شفاعتي ! ' . | PageV01P392 |(@)(@@) 575 - ( 79 ) حدثنا محمد ، قال : حدثنا حجاج بن الشاعر ، قال | حدثنا أبو أحمد ، قال : حدثنا سفيان ، عن أبي إسحاق ، عن البراء | - أو غيره - قال :(@)(@@) جاء رجل بالعباس من الأنصار قد أسره ، فقال العباس : يا رسول | الله ليس هذا أسرني ، أسرني رجل من القوم أنزع من هيئته كذا ، فقال | رسول الله [ صلى الله عليه وسلم ] : ' لقد أيدك الله بملك كريم ' . |(@)(@@) 576 - ( 80 ) حدثنا محمد ، قال : حدثنا مسلم بن إبراهيم ، / | قال : حدثنا سوار أبو حمزة صاحب الحلي ، قال : حدثنا ثابت ، عن أنس :(@)(@@) أن النبي [ صلى الله عليه وسلم ] استعمل المقداد على جريدة خيل ، فلما قدم عليه | قال : ' كيف رأيتهم ؟ ' قال : رأيتهم يرفعوني ويضعوني حتى ظننت أني لست | ذاك ، فقال النبي [ صلى الله عليه وسلم ] : ' هو ذاك ' ، فقال له المقداد بن الأسود : والذي | بعثك ، لا أعمل على أحد أبدا ، فكانوا يقولون له : تقدم فصل ، فيأبى . |(@)(@@) 577 - ( 81 ) حدثنا محمد ، قال : حدثنا مسلم بن إبراهيم ، قال : | حدثنا الحسن بن أبي جعفر ، قال : حدثنا محمد بن جحادة ، عن الحسن ، | عن عمران بن حصين : | PageV01P393(@)(@@) أن النبي [ صلى الله عليه وسلم ] قال : ' لا يدخل الجنة أحد حتى يعمل مثل أحد ذهبا ' ، | قالوا : ومن يستطيع أن يعمل مثل أحد ذهبا ، قال : ' سبحان الله ، | والحمد لله ، ولا إله إلا الله ، والله أكبر ، مثل أحد ' . |(@)(@@) 578 - ( 82 ) حدثنا أحمد بن الوليد ، قال : حدثنا عبد الوهاب بن | عطاء ، قال : أخبرنا ابن عون ، عن محمد ، عن أبي هريرة ، أن رجلا قام | إلى عمر فقال : أيصلي الرجل في الثوب الواحد ؟ فقال : إذا وسع الله | عليكم فأوسعوا ، جمع رجل عليه ثيابه ، صلى رجل في إزار ورداء ، في | إزار وقميص ، في إزار وقباء ، في سراويل ورداء ، في سراويل وقميص ، | في سراويل وقباء ، في تبان وقميص ، في تبان وقباء ، قال ابن عون : | وأحسبه قال : في تبان ورداء . |(@)(@@) 579 - ( 83 ) حدثنا جعفر بن محمد الصائغ قال : حدثنا عاصم بن | علي ، قال : حدثنا يزيد بن إبراهيم التستري ، قال : سمعت قتادة ، يحدث | عن أنس :(@)(@@) أنه مشى إلى النبي 
ms124	 [ صلى الله عليه وسلم ] بإهالة سنخة وخبز وشعير ، وكان يقول : | والذي نفس محمد بيده ، ما أصبح في آل محمد صاع من بر ، ولا صاع من | تمر ، وهم يومئذ أهل تسعة أبيات . | PageV01P394 |(@)(@@) 580 - ( 84 ) حدثنا إسحاق بن الحسن بن ميمون ، قال : حدثنا | أبو حذيفة ، قال : حدثنا الثوري ، عن أبي إسحاق ، عن مصعب بن سعد ، | عن عكرمة بن أبي جهل ، قال :(@)(@@) قال لي / النبي [ صلى الله عليه وسلم ] يوم جئته : ' مرحبا بالراكب المهاجر ، مرحبا | بالراكب المهاجر ' ، قلت : والله يا رسول الله ، لا أدع نفقة أنفقتها عليك | إلا أنفقت مثلها في سبيل الله . |(@)(@@) 581 - ( 85 ) حدثنا إسحاق ، قال : حدثنا أبو حذيفة ، قال : حدثنا | سفيان الثوري ، عن محمد بن عمرو ، عن أبي سلمة ، عن عائشة ، قالت :(@)(@@) إذا جاوز الختان الختان وجب الغسل ، فعلته أنا ورسول الله [ صلى الله عليه وسلم ] | فاغتسلنا . |(@)(@@) 582 - ( 86 ) حدثنا إسحاق ، قال : حدثنا أبو سلمة المنقري ، | قال : حدثنا الحارث بن نبهان ، عن مالك بن دينار ، عن الحسن ، عن | أنس : | PageV01P395(@)(@@) عن النبي [ صلى الله عليه وسلم ] قال : ' ليؤيدن الله الدين بأقوام لا خلاق لهم ' . |(@)(@@) 583 - ( 87 ) حدثنا أحمد ، قال : حدثنا أبو معمر ، قال : حدثنا | عبد الوارث : حدثنا محمد بن جحادة ، عن منصور بن المعتمر ، عن | عمارة بن عمير التميمي ، عن ربيع بن عميلة ، عن سمرة بن جندب ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' أحب الك لام إلى الله عز وجل أربع : سبحان | الله ، والحمد لله ، ولا إله إلا الله ، والله أكبر ، لا يضرك بأيهن بدأت ' . |(@)(@@) 584 - ( 88 ) قال : ' لا تسموا رباحا ، ولا نافعا ، ولا يسارا ، | ولا أفلح ' ، فإنما هو أربع ، لا تزدن علي . |(@)(@@) 585 - ( 89 ) حدثنا محمد بن إسماعيل السلمي : قال : حدثنا | محمد بن عبد الله الأنصاري ، قال : حدثنا هشام بن حسان ، عن ابن | سيرين ، عن أبي هريرة ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' إن الله وتر يحب الوتر فأوتروا يا أهل | القرآن ' . | PageV01P396 |(@)(@@) 586 - ( 90 ) حدثنا محمد ، قال : حدثنا عبد الله بن رجاء ، | قال : حدثنا حرب بن 
ms125	 شداد ، عن يحيى بن أبي كثير ، قال : حدثني | حية بن حابس التميمي ، أن أباه أخبره :(@)(@@) أنه سمع رسول الله [ صلى الله عليه وسلم ] يقول : ' لا شيء في الهام ، والعين حق ، | وأصدق الطير الفأل ' . |(@)(@@) 587 - ( 91 ) حدثنا محمد ، قال : حدثنا عبد الله بن رجاء ، | قال : حدثنا حرب بن شداد ، قال : حدثني [ يحيى بن أبي كثير ، عن ] | عمران بن حطان ، أنه سأل عبد الله بن عباس عن لبس الحرير ، قال : سل | عنه عائشة ، فسألت عائشة فقالت : سل عبد الله بن عمر ، فسألت ابن | عمر ، فقال : حدثني أبو حفص :(@)(@@) أن رسول الله / [ صلى الله عليه وسلم ] قال : ' من لبس الحرير في الدنيا فلا خلاق له | في الآخرة ' . |(@)(@@) 588 - ( 92 ) حدثنا محمد ، قال : حدثنا الحسن بن سوار ، قال : | حدثنا يزيد بن إبراهيم ، عن محمد بن سيرين ، عن عبد الله بن عباس ، قال : | PageV01P397(@)(@@) كنت ردف النبي [ صلى الله عليه وسلم ] ، فأتاه رجل فقال : يا رسول الله ، إن أمي | عجوز كبيرة ، إن حرمتها خشي أن يقتلها ، وإن حملتها لم تستمسك ، | فأمره أن يحج عنها . |(@)(@@) 589 - ( 93 ) حدثنا يوسف بن موسى المروذي ، قال : حدثنا علي | ابن حجر ، قال : حدثنا شريك ، عن أبي إسحاق ، عن أبي بردة ، عن أبي موسى : | عن النبي [ صلى الله عليه وسلم ] قال : ' لا نكاح إلا بولي ' . | 590 - ( 94 ) حدثنا أحمد بن زهير ، قال : حدثنا أبو نعيم ، قال | حدثنا إسرائيل ، عن أبي إسحاق ، عن الأسود ، عن أبي موسى ، قال :(@)(@@) لقد ذكرنا ابن أبي طالب صلاة كنا نصليها مع رسول الله [ صلى الله عليه وسلم ] ، إما | نسيناها وإما تركناها عمدا ، كان يكبر كلما رفع ، وكلما وضع ، وكلما سجد . | PageV01P398 |(@)(@@) 591 - ( 95 ) حدثنا أحمد ، قال : حدثنا أبو نعيم ، قال : حدثنا | زهير ، عن أبي إسحاق ، عن بريد بن أبي مريم ، عن رجل من بني تميم ، | عن أبي موسى ، قال :(@)(@@) لقد ذكرنا ابن أبي طالب صلاة كنا نصليها مع رسول الله [ صلى الله عليه وسلم ] إما | نسيناها وإما تركناها عمدا ، يكبر في كل رفع ووضع وقيام وقعود . |(@)(@@) 592 - ( 96 
ms126	 ) حدثنا أحمد ، قال : حدثنا أبو نعيم ، قال : حدثنا | موسى بن محمد الأنصاري ، عن يزيد بن أبي زياد ، عن عبد الرحمن بن | أبي ليلى ، عن البراء بن عازب ، قال :(@)(@@) صليت خلف رسول الله [ صلى الله عليه وسلم ] ، فكبر يرفع يديه حتى حاذى بأذنيه . |(@)(@@) 593 - ( 97 ) حدثنا محمد ، قال : حدثنا أبو نعيم ، قال : حدثنا | موسى بن محمد الأنصاري ، عن يزيد بن أبي زياد ، عن عدي بن ثابت ، | عن البراء بن عازب ، مثله . | PageV01P399 |(@)(@@) 594 - ( 98 ) حدثنا أحمد بن زهير ، قال : حدثنا مالك بن | إسماعيل أبو غسان ، قال : حدثنا زهير ، قال : حدثني محمد بن إسحاق ، | قال : حدثني خبيب بن عبد الرحمن ، عن حفص بن عاصم ، عن | أبي هريرة ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' إن منبري / على حوضي ، وإن ما بين بيتي | ومنبري روضة من رياض الجنة ، وصلاة في مسجدي كألف صلاة فيما | سواه من المساجد إلا المسجد الحرام ' . | 3595 - ( 99 ) قال : وحدثني المسور بن رفاعة ، عن أبي سلمة ، | عن أبي هريرة ، مثله . |(@)(@@) 596 - ( 100 ) حدثنا محمد بن إسماعيل ، قال : حدثنا قطبة بن | العلاء ، قال : حدثني أبي العلاء بن منهال ، عن هشام بن عروة ، عن أبيه ، | عن عائشة ، قالت :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من التمس محامد الناس بمعاصي الله عاد | حامده له ذاما ' . | PageV01P400 |(@)(@@) 597 - ( 101 ) حدثنا محمد ، قال : حدثنا أيوب بن سليمان ، | قال : أبو بكر بن أبي أويس ، عن سليمان بن بلال ، عن ابن عجلان ، عن | أبيه ، عن أبي هريرة :(@)(@@) أن رسول ا لله [ صلى الله عليه وسلم ] قال : ' إنما مثل المؤمن كخامة الزرع ، تكفؤها | الريح والشيء اليسير ، وإنما مثل الكافر مثل الأرزة لا تزال شديدة على | ساق حتى يجعفها الله ' . |(@)(@@) 598 - ( 102 ) وبإسناده ، أن رسول الله [ صلى الله عليه وسلم ] قال : ' إذا هلك | كسرى فلا كسرى بعده ، وإذا هلك قيصر فلا قيصر بعده ، وأيم الذي نفسي | بيده ، لتنفقن كنوزهما في سبيل الله عز وجل ' . |(@)(@@) 599 - ( 103 ) وأن رسول الله [ صلى الله عليه وسلم ] قال : ' نصرت بالرعب ، | وأوتيت جوامع 
ms127	 الكلام ، وبينا أنا نائم إذ أتيت بمفاتيح خزائن الأرض | فوضعت في يدي ' .(@)(@@) قال : ' ثم يقول أبو هريرة على إثر هذا : فذهب أبو القاسم ولم يتند | منها بشيء ، ثم أنتم تهدرونها . |(@)(@@) 600 - ( 104 ) حدثنا محمد بن إسماعيل ، قال : حدثنا نعيم بن | PageV01P401 | حماد ، قال : حدثنا محمد بن ثور الصنعاني ، عن ابن جريج ، قال : كنت | أنا وعطاء خلف المقام عشية ليس معنا أحد ، إذ جاءنا الأعمش فقال : | يا أبا محمد ، أنبأتني أنك سمعت جابرا يقول :(@)(@@) أهللنا بالحج خالصا ؟(@)(@@) قال عطاء : قد أخبرتك بذلك ، فدعنا عنك ، قال ابن جريج : فقلت | لعطاء : تخبر أهل العراق بمثل هذا ؟ فقال عطاء : سمعت أبا هريرة يقول : | لولا آية / في كتاب الله عز وجل ما حدثتكم بشيء ، ثم قرأ : @QB@ إن الذين يكتمون ما أنزلنا من البينات والهدى من بعد @QE@ الآية [ البقرة : 159 ] . قال | عطاء : لولا هذه الآية ما حدثت بشيء . |(@)(@@) 601 - ( 105 ) حدثنا محمد ، قال : حدثنا مسلم بن إبراهيم ، | قال : رأيت شعبة لا مرة ولا مرتين يأتي القاسم بن الفضل فيسأله عن | حديث محمد بن علي ، ويحسب واحدا واحدا ، ويعقد شعبة بيده . |(@)(@@) 602 ( 106 ) حدثنا محمد بن إسماعيل ، قال : حدثنا عبد الله | بن صالح ، قال : حدثني الليث بن سعد ، قال : حدثني جرير بن حازم ، | عن أيوب السختياني ، عن محمد بن سيرين ، عن عمران بن حصين ، | قال جرير : وحدثني أيوب ، عن أبي قلابة الجرمي ، عن أبي المهلب ، | عن عمران بن حصين ، قال : | PageV01P402(@)(@@) توفي رجل من الأنصار وترك ستة أعبد ليس له مال غيرهم ، فأعتقهم | جميعا عند موته ، فرفع ذلك إلى النبي [ صلى الله عليه وسلم ] ، فجزأهم ثلاثة أجزاء ، ثم | أقرع بينهم ، فأعتق الثلث وأرق الثلثين .(@)(@@) قال محمد بن سيرين : لو لم يبلغني عن رسول الله [ صلى الله عليه وسلم ] لكان رأيي . |(@)(@@) 603 ( 107 ) قال جرير : قال خالد الحذاء ، عن أبي قلابة به | كما قال أيوب ، غير أنه قال عمران بن حصين : قال رسول الله [ صلى الله عليه وسلم ] حين | ذكر له أمره : ' لو علمت بالذي صنع ما صليت عليه ' . |(@)(@@) 604 
ms128	 - ( 108 ) حدثنا عبيد الله بن عبد الواحد ، قال : حدثنا | أبو معمر ، قال : حدثنا عبد الله بن معاذ ، عن معمر ، عن جابر الجعفي ، | عن الشعبي ، عن جابر بن عبد الله ، قال :(@)(@@) سئل رسول الله [ صلى الله عليه وسلم ] عن ذبيحة المرأة والغلام ، قال : ' لا بأس ، إذا | ذكر اسم الله ' |(@)(@@) 605 - ( 109 ) حدثنا أحمد بن الوليد ، قال : حدثنا شاذان ، قال : | وأخبرنا شريك ، عن هلال ، عن عبد الله بن عكيم ، قال : سمعت ابن | مسعود بدأ باليمين قبل الحديث ، قال : والله ، إن منكم إلا سيخلوا الله | PageV01P403 | به عز وجل كما يخلو أحدكم بالقمر ليلة البدر ، فيقول : ابن آدم ، ماغرك | بي ، ابن آدم ، ما عملت فيما علمت ، ابن آدم ، ماذا أجبت / المرسلين . |(@)(@@) 606 - ( 110 ) حدثنا محمد بن عبد الله بن مهرا الدينوري ، | قال : حدثنا إبراهيم بن مسلم الوكيعي الخوارزمي ، قال : حدثنا علي بن | عاصم ، عن محمد بن سوقة ، عن إبراهيم ، عن الأسود ، عن عبد الله بن | مسعود ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من عزى مصابا فله مثل أجره ' . |(@)(@@) 607 - ( 111 ) حدثنا محمد ، قال : حدثنا إبراهيم بن مسلم ، | قال : حضرت وكيعا وعنده أحمد بن حنبل وخلف ، فذكر علي بن | عاصم ، فقال خلف : غلط في حديث ابن مسعود ، قال : ما هو ؟ قال : | حديث ابن سوقة ، فقال وكيع : أخبرنا إسرائيل ، عن محمد بن سوقة ، عن | إبراهيم ، عن الأسود ، عن عبد الله بن مسعود ، قال :(@)(@@) قال النبي [ صلى الله عليه وسلم ] : ' من عزى مصابا فله مثل أجره ' .(@)(@@) قال : وقيس حدثنا بهذا الإسناد موقوفا . | PageV01P404 |(@)(@@) 608 - ( 112 ) حدثنا محمد ، قال : حدثنا أحمد بن يونس ، قال : | حدثنا زهير ، قال : حدثنا أبو خالد ، عن أبي يعفور ، عن ابن أبي أوفى ، قال : | غزونا مع رسول الله [ صلى الله عليه وسلم ] سبع غزوات نأكل فيهن الجراد . |(@)(@@) 609 - ( 113 ) حدثنا محمد بن الهيثم بن حماد القاضي ، قال : | حدثني محمد بن الفضل السدوسي أبو النعمان ، قال : حدثنا حماد بن | زيد ، عن أيوب ، عن محمد ، عن أبي العجفاء السلمي ، قال : قال | عمر بن الخطاب :(@)(@@) ألا 
ms129	 لا تغالوا بصدق النساء ، فإنها لو كانت مكرمة في الدنيا أو يقول | عند الله عز وجل ، كان أولاكم بها رسول الله [ صلى الله عليه وسلم ] ، فو الله ما أنكح امرأة | من بناته ولا نكح امرأة من نسائه على أكثر من اثنتي عشرة أوقية ، وإن أحدكم | ليغالي بصدقة امرأته حتى تبقى لها عداوة في نفسه ، فيقول : قد كلفت إليك | علق القربة ، قال يحيى بن عتيق : عرق القربة . | PageV01P405(@)(@@) قال : وأخرى تقولونها في مغازيكم : قتل فلان شهيدا ، ولعله أن | يكون قد أوقر دف راحلته ذهبا أو ورقا ، فلا تقولوا ذلكم ، ولكن قولوا | كما قال الله عز وجل ، أو كما قال رسول الله [ صلى الله عليه وسلم ] : ' من قتل في سبيل | الله أو مات / فهو شهيد ' . |(@)(@@) 610 - ( 114 ) حدثنا محمد بن الهيثم ، قال : حدثنا موسى بن | مسعود أبو حذيفة ، قال : حدثنا سفيان بن سعيد الثوري ، عن الأعمش ، | عن الشعبي ، عن مسروق ، عن عائشة ،(@)(@@) وحدثنا أبو حذيفة ، قال : حدثنا سفيان ، عن عاصم ، عن الشعبي ، | عن مسروق ، عن عائشة ، | وحدثنا أبو حذيفة ، قال : حدثنا سفيان عن الأعمش ، عن أبي | الضحى ، عن مسروق ، عن عائشة ، قالت : خيرنا رسول الله [ صلى الله عليه وسلم ] فاخترناه ، فلم | نعده طلاقا . |(@)(@@) 611 - ( 115 ) حدثنا محمد ، قال : حدثنا إسحاق بن إبراهيم | الحنيني أبو يعقوب ، عن مالك والعمري ، عن نافع ، عن ابن عمر ،(@)(@@) أن النبي [ صلى الله عليه وسلم ] نهى عن النجش . | PageV01P406 |(@)(@@) 612 ( 116 ) حدثنا محمد بن غالب بن حرب ، قال : حدثني | حفص بن عمر العمري ، قال : حدثني عبد الله بن بكر عبد الله المزني ، | عن الحسن ، عن الأسود بن سريع ، قال :(@)(@@) كنت مع رسول الله [ صلى الله عليه وسلم ] في غزوة أو في بعض المغازي - فجاوز | قوم إلى الذرية يقتلونها ، فبلغ ذلك رسول الله [ صلى الله عليه وسلم ] ، فقال : ' ما بال أقوام | تجاوزوا إلى الذرية يقتلونها ! ' فقال رجل : إنما هم أبناء المشركين ، فقال : | ' إن خياركم أبناء المشركين ، إنها ليس من نسمة إلا تولد على الفطرة ، ثم | لا يزال من ذلك حتى يعرب 
ms130	 عنها لسانها ، فأبواها يهودانها وينصرانها ' . |(@)(@@) 613 - ( 117 ) حدثنا محمد بن غالب ، قال : حدثنا حفص بن | عمر العمري ، قال : حدثنا عبد الله بن بكر المزني ، عن محمد بن | سيرين قال : حدثني أبو هريرة :(@)(@@) أن رجلا قال : يا رسول الله ، أيصلي الرجل في ثوب واحد ؟ فقال : | ' أوكلكم يجد ثوبين ' . |(@)(@@) 614 - ( 118 ) حدثنا أحمد بن الوليد ، قال : حدثنا شاذان | أسود بن عامر ، قال : قيل لحماد : ذكرت عن النبي [ صلى الله عليه وسلم ] أنه كان يتعوذ من | الجنون والجذام ؟ قال : | PageV01P407(@)(@@) نعم ، قيل له : من ذكره ؟ قال : قتادة ، عن أنس ، عن / | النبي [ صلى الله عليه وسلم ] . |(@)(@@) 615 - ( 119 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | حماد بن سلمة ، عن قتادة ، عن الحسن ، عن سمرة بن جندب :(@)(@@) أن النبي [ صلى الله عليه وسلم ] نهى عن بيع الحيوان بالحيوان نسيئة . |(@)(@@) 616 - ( 120 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | حماد ، عن قتادة ، عن شهر ، عن عبد الرحمن بن غنم ، عن عمرو بن | خارجة :(@)(@@) عن النبي [ صلى الله عليه وسلم ] قال : كنت آخذ بزمام ناقة رسول الله [ صلى الله عليه وسلم ] ولعابها | يسيل بين كتفي ، فقال : ' إن الله عز وجل قد أعطى كل ذي حق حقه ، ألا | إنه لا يجوز لوارث وصية ، الولد للفراش وللعاهر الحجر ، ومن ادعى إلى | غير أبيه وانتمى إلى غير مواليه فعليه لعنة الله والملائكة والناس أجمعين ، | لا يقبل الله منه صرفا ولا عدلا ' . | PageV01P408 |(@)(@@) 617 - ( 121 ) حدثنا أحمد : حدثنا شاذان ، قال : حدثنا | شريك ، عن عاصم ، عن أبي وائل ، عن مسروق ، عن أم سلمة ، قالت :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من أصحابي من لا يراني ولا أراه بعد أن | أموت أبدا ' ، قال : فبلغ ذلك عمر فأتاها يسرع أو يشتد فقال : أنشدك | بالله ، أنا منهم ؟ قالت : اللهم لا ، ولا أزكي بعدك أحدا . |(@)(@@) 618 - ( 122 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | حماد بن سلمة ، عن سلمة بن كهيل ، عن إبراهيم بن سويد ، عن علقمة أنه | صلى بهم الظهر أو العصر خمسا ، فقيل له ، فقال 
ms131	 : كذاك يا أعور ؟ فسجد | سجدتي السهو ،(@)(@@) ثم حدث عن النبي [ صلى الله عليه وسلم ] أنه فعل مثله . |(@)(@@) 619 - ( 123 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | شعبة ، عن الحكم ، عن إبراهيم ، عن علقمة ، عن عبد الله : | PageV01P409(@)(@@) عن النبي [ صلى الله عليه وسلم ] أنه صلى خمسا ، فلما انصرف قيل له : أزيد في | الصلاة ؟ قال : ' وما ذاك ؟ ' قالوا : صليت خمسا ، قال : فسجد سجدتي | السهو . |(@)(@@) 620 - ( 124 ) حدثنا أحمد ، قال حدثنا شاذان ، قال : أخبرنا | شعبة ، عن عاصم ، عن عكرمة :(@)(@@) أن النبي [ صلى الله عليه وسلم ] قال : ' من لم يسجد على أنفه فلا صلاة له ' |(@)(@@) 621 - ( 125 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | شريك عن جابر ، عن عكرمة ، عن النبي [ صلى الله عليه وسلم ] نحوه . |(@)(@@) 622 - ( 126 ) / حدثنا محمد بن غالب ، قال : حدثنا سيف بن | مسكين السلمي ، قال : أخبرنا معمر بن يزيد السلمي ، قال : حدثنا قتادة ، | عن سعيد بن المسيب ، عن أبي هريرة ، قال : | PageV01P410(@)(@@) نظر رسول الله [ صلى الله عليه وسلم ] إلى رجل في إصبعه خاتم من ذهب ، فقال : | ' ألم أنه عن هذا ! لعن الله لابسه ' . |(@)(@@) 623 - ( 127 ) قال : ونظر رسول الله [ صلى الله عليه وسلم ] إلى حمار وقد وسم في | وجهه ، فقال : ' ألم أنه عن هذا ، لعن الله فاعله ' . |(@)(@@) 624 - ( 128 ) حدثنا محمد ، قال : حدثنا سيف بن مسكين ، | قال : حدثنا مسكين بن النعمان أبو الخطاب ، قال : حدثنا يزيد الرقاشي ، | عن عبد الرحمن بن غنم ، عن أبي سعيد الخدري ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من شرب الخمر من أمتي في الدنيا حرم | شربها في الآخرة ، ومن تحلى من أمتي بالذهب في الدنيا حرم حليته في | الآخرة ، ومن لبس من أمتي الحرير في الدنيا حرم لبسه في الآخرة ' . |(@)(@@) 625 - ( 129 ) حدثنا جعفر بن محمد الصائغ ، قال : حدثنا | أحمد بن عبد الملك بن واقد الحراني ، قال : حدثنا محمد بن سلمة ، عن | محمد بن إسحاق ، عن عبد الملك بن عمير ، عن أبي بردة بن أبي موسى | الأشعري ، عن أبيه ، قال : | PageV01P411(@)(@@) دخلت على النبي 
ms132	 [ صلى الله عليه وسلم ] ومعي ابنا عم لي وهو يستاك ، فقالا : | يا رسول الله ، استعملنا فإن عندنا - ذكر كلمة - ، فقال رسول الله [ صلى الله عليه وسلم ] | وإن السواك لفي شفته : ' لا نريد أن نستعمل على عملنا من حرص عليه ' ، | قال أبو موسى : يا رسول الله : ما علمت أنهما جاء لشيء من هذا حتى | تكلما . |(@)(@@) 626 - ( 130 ) حدثنا جعفر ، قال : حدثنا عبد الله بن مروان | أبو شيخ الحراني ، عن موسى بن أعين ، عن حفص بن محمد النضري ، | عن أيوب السختياني ، عن عكرمة ، عن ابن عباس :(@)(@@) أن رسول الله [ صلى الله عليه وسلم ] عق عن الحسن والحسين ابني فاطمة كبشا | كبشا . |(@)(@@) 627 - ( 131 ) حدثنا أحمد بن ملاعب أبو الفضل ، قال : حدثنا | أبو غسان مالك بن إسماعيل ، قال : حدثنا هريم بن سفيان ، قال : حدثنا | هشام بن عروة ، عن أبيه ، عن عائشة / ، قالت :(@)(@@) كنت ألعب بالبنات في بيت رسول الله [ صلى الله عليه وسلم ] فيدخل علي | رسول الله [ صلى الله عليه وسلم ] وعندي صواحبي ، فينقمعن ، فيسربهن إلي . | PageV01P412 |(@)(@@) 628 - ( 132 ) حدثنا أحمد ، قال : حدثنا أبو غسان ، قال : حدثنا | هريم ، عن سعيد بن أبي سعيد ، عن أنس ، قال :(@)(@@) كن أمهات المؤمنين يأكلن الجراد ويتهادينه بينهن . |(@)(@@) 629 - ( 133 ) حدثنا أحمد ، قال : حدثنا أبو غسان ، قال : حدثنا | هريم ، عن أبي إسحاق ، عن أبي الأحوص ، عن عبد الله ، قال : نزل | القرآن على سبعة أحرف . |(@)(@@) 630 - ( 134 ) حدثنا أحمد ، قال : حدثنا أبو غسان ، قال : حدثنا | هريم عن سعيد بن أبي عروبة ، عن عامر الأحول ، عن عطاء ، عن ابن | عباس ، قال : إذا آلى الرجل من امرأته على دون الحد شهرا أو شهرين | أو ثلاثة فقد برئت يمينه ولا يدخل عليه شيء . |(@)(@@) 631 - ( 135 ) حدثنا أحمد بن الوليد الفحام ، قال : حدثنا | عبد الوهاب ، قال : أخبرنا ابن عون ، عن محمد ، | PageV01P413(@)(@@) أن النبي [ صلى الله عليه وسلم ] لما حلق رأسه ، كان أول من قام إليه أبو طلحة ، فأخذ | منه ، ثم قام الناس .(@)(@@) فذكرت ذلك لعبيدة ، فقال : لأن تكون عندي شعرة واحدة ، فذكر | الحديث ، انقطع 
ms133	 من كتاب الشيخ أبي جعفر . |(@)(@@) 632 - ( 136 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن ابن عباس ، قال :(@)(@@) كنا نسافر مع رسول الله [ صلى الله عليه وسلم ] بين مكة والمدينة لا نخاف إلا الله | نصلي ركعتين . |(@)(@@) 633 - ( 137 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن ابن عباس ، قال : ما نهي [ عنه ] في | القرآن كبير ، وقد ذكرت النظرة . | PageV01P414 |(@)(@@) 634 - ( 138 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، أن ابن عمر قال : صلاة الليل مثنى مثنى | والوتر ركعة من آخر الليل . |(@)(@@) 635 - ( 139 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن رجل ، أن ابن عمر قال :(@)(@@) حفظت عن رسول الله [ صلى الله عليه وسلم ] عشر صلوات : ركعتين قبل صلاة | الفجر ، وركعتين قبل صلاة الظهر ، وركعتين بعد صلاة الظهر ، وركعتين بعد | صلاة المغرب ، وركعتين بعد صلاة العشاء . |(@)(@@) 636 - ( 140 ) حدثنا أحمد / ، قال : حدثنا عبد الوهاب قال : | أخبرنا ابن عون ، عن محمد ، أن ابن عمر كان يكره الوتر من أول الليل ، | ويقول : ألا ترى أنك تشفع صلاتك ! |(@)(@@) 637 - ( 141 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، أن ابن عمر قال : تكفيك قراءة الإمام . PageV01P415 |(@)(@@) 638 - ( 142 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، أن رجلا كتب عند ابن عمر : بسم الله | الرحمن الرحيم لفلان ، فقال ابن عمر : مه ! اسم الله هو له . |(@)(@@) 639 - ( 143 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : ذكروا المسك عند ابن عمر ، فقال : | أو ليس أطيب طيبكم المسك . |(@)(@@) 640 - ( 144 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : قدم ابن الزبير وابن عمر - يعني | بمكة - جالسا ، فمشى ، فقال : ارمل ، قال : فدفع فرمل ، قال : حسبك | ثلاث إن شئت ، قال : فلج ابن الزبير فرملهن كلهن . |(@)(@@) 641 - ( 145 ) وعن محمد قال : قال 
ms134	 ابن عمر لرجل : إن أطعتني | انتظرت حتى إذا أهللت المحرم انطلقت إلى قرن اعتمرت منه . |(@)(@@) 642 - ( 146 ) وعن محمد ، قال : رأيت ابن عمر يطوف بالبيت ، | فالتفت خلفه فأبصر رجلا أو رجلين ، فدنا من الحجر فقبله . |(@)(@@) 643 - ( 147 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد بن سيرين :(@)(@@) أن النبي [ صلى الله عليه وسلم ] رأى حذيفة ، فدعاه ، فذهب فاغتسل ، ثم جاء إلى | رسول الله [ صلى الله عليه وسلم ] فقال : إني كنت جنبا ، قال : ' المؤمن لا ينجس ' . | PageV01P416(@)(@@) قال ابن عون : أنبئت أنه قال : المسلم لا ينجس . |(@)(@@) 644 - ( 148 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، أن رجلا سأل ابن عمر فقال : إن أهلنا | ينبذون لنا شرابا عشاء ، حتى إذا أصبحنا شربناه ، فقال ابن عمر : أنهاك | عن المسكر من الشراب قليله وكثيره ، وأشهد الله عليك أن أهل خيبر | ينتبذون شرابا من كذا وكذا يسمونها كذا وكذا ، وهي الخمر ، فذكر أربعة | أشربة إحداهن العسل . |(@)(@@) 645 - ( 149 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : مر ابن عمر على رجل وهو يؤذن | فقال : أوتر أذانك ، أوتر أذانك . |(@)(@@) 646 - ( 150 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | حدثنا ابن عون ، عن محمد ، عن عبيدة ، قال : إن ابن الزبير هذا مر بنا | إلى أبيه ، قال : فقالوا : اشهد أنه قال : ما من مؤمنين يموت بينهم ثلاثة | لم يبلغوا الحنث إلا لم يدخلوا النار أبدا ، قال : يقال لهم : ادخلوا | الجنة ، فيقولون : حتى يدخلها أبوانا ، ثم يقال لهم : ادخلوا الجنة ، | قال : فيقولون : حتى يدخلها أبوانا ثم يقال لهم : ادخلوا الجنة أنتم | وأبواكم . |(@)(@@) 647 - ( 151 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، أن ابن عباس شرب لبنا فقيل له ، فقال : | PageV01P417 | لا أباليه بالة ، اسمح يسمح لك . |(@)(@@) 648 - ( 152 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن رجل - قال ابن عون : إن لم يكن ابن | عباس فلا أدري 
ms135	 من هو - قال : ما كنت أرى دما واحدا يجزئ عن أكثر | من واحد . |(@)(@@) 649 - ( 153 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن عقبة بن عبد الغفار ، قال : نهانا | أبو سعيد أن نخلط بين الزبيب والتمر . |(@)(@@) 650 - ( 154 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : أظنه ذكره عن مسلم بن يسار فإن لم | يكن ذكره عنه فلا أدري ، عن ابن مسعود قال :(@)(@@) لعنت الواشرة والواشمة والواصلة والنامصة . | PageV01P418 |(@)(@@) 651 - ( 155 ) حدثنا أحمد بن الوليد الفحام ، قال : حدثنا | شاذان ، قال : وأخبرنا حماد بن سلمة ، عن النعمان بن راشد ، عن | الزهري ، قال : كان عمر إذا أتاه مال العراق أو خمس العراق لم يدع | رجلا من بني هاشم أعزب إلا زوجه ، ولا رجلا ليست له خادم إلا | أخدمه . |(@)(@@) 652 - ( 156 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | حماد بن زيد ، عن هشام ، عن ابن سيرين ، قال : قتل بصفين سبعين ألفا ، | ما أحصوهم إلا بالقصب ، جعل على كل جسد قصبة ثم أحصوهم . |(@)(@@) 653 - ( 157 ) حدثنا أحمد ، قال : شاذان قال : وأخبرنا حماد بن | سلمة ، عن علي بن زيد ، عن الحسن ، أن جنديا كان مع / علي بصفين ، | قال حماد : ولم يكن يقاتل . |(@)(@@) 654 - ( 158 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | حماد بن سلمة ، عن أبي عمران ، عن جندب قال : كنا نصيب من ثمار | أهل الذمة وأعلافهم ، ولا نشاركهم في نسائهم وأموالهم ، ونسخر العلج | يهدينا إلى الطريق . | PageV01P419 |(@)(@@) 655 - ( 159 ) حدثنا أحمد بن الوليد قال : حدثنا شاذان ، قال : | وأخبرنا سفيان بن سعيد الثوري ، عن ليث ، عن طاوس ، عن ابن عباس ، | قال : قال علي : ما قتلت عثمان ولا مالأت ولا أمرت ، ولكني | غلبت . |(@)(@@) 656 - ( 160 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | سفيان بن سعيد ، عن جعفر بن برقان ، عن نافع ، عن ابن عمر ، قال : إذا | أدركت الإمام فوجدته على حال فاصنع كما يصنع . |(@)(@@) 657 - ( 161 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | سفيان بن سعيد ، عن عاصم 
ms136	 ، عن سعيد بن جبير ، عن ابن عباس ، قال : | رخصة للمريض في الوضوء بالتيمم بالصعيد ، قال : فإن كان مجدورا كأنه | صمغة فكيف يصنع ؟ قال : يتيمم . |(@)(@@) 658 - ( 162 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | سفيان بن سعيد ، عن الأوزاعي ، عن الزهري ، عن أبي أمامة بن سهل بن | حنيف ، قال : دخل زيد والإمام راكع فركع حتى استوى بالصف . | PageV01P420 |(@)(@@) 659 - ( 163 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | سفيان ، عن معمر ، عن الزهري ، عن أبي أمامة بن سهل بن حنيف ، قال : | دخل زيد المسجد والإمام راكع فركع حتى استوى بالصف . |(@)(@@) 660 - ( 164 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | سفيان بن سعيد ، عن ابن جريج ، عن سليمان بن موسى ، رفعه إلى | النبي [ صلى الله عليه وسلم ] قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] ' الأذنان من الرأس ' . |(@)(@@) 661 - ( 165 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | فرج بن فضالة ، عن يحيى بن سعيد ، عن نافع ، عن ابن عمر ، قال : | الأذنان من الرأس . |(@)(@@) 662 - ( 166 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | سفيان الثوري ، عن رجل قد سماه ، عن نافع ، عن ابن عمر ، قال : الأذنان | من الرأس . |(@)(@@) 663 - ( 167 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : حدثنا | سفيان بن سعيد ، عن محمد بن عجلان ، عن ابن عمر ، أنه كان / يمسح | بمقدم رأسه . | PageV01P421 |(@)(@@) 664 - ( 168 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | سفيان بن سعيد ، عن الأعمش ، عن أبي وائل ، عن عبد الله ، قال : إذا | رأيت الرجل يقرأ القرآن منكوسا فإن ذلك منكوس القلب . |(@)(@@) 665 - ( 169 ) حدثنا أحمد ، قال : حدثنا شاذان ، قال : أخبرنا | سفيان بن سعيد ، عن يونس ، عن الحسن ، عن النبي [ صلى الله عليه وسلم ] ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' تحت كل شعرة جنابة ، فبلوا الشعر ، وأنقوا | البشر . |(@)(@@) 766 - ( 170 ) حدثنا أحمد بن الوليد الفحام ، قال : حدثنا | عبد الوهاب بن عطاء ، قال أخبرنا ابن عون ، عن محمد ، عن عبيدة ، | قال : جاء رجل وامرأته إلى علي ، مع كل واحد منهما فئام من الناس 
ms137	 ، | فبعث الحكمين ، فقال : رويدكما حتى أخبركما بالذي عليكما ، تدريان ما | عليكما ؟ إن رأيتما أن تجمعا جمعتما ، وإن رأيتما أن تفرقا فرقتما ، ثم قال | للمرأة : أرضيت بما صنعا ؟ قالت : رضيت بكتاب الله علي ولي ، ثم قال | للرجل : أرضيت بما صنعا ؟ أرضى أن يجمعا ولا أرضى أن يفرقا ، | فقال علي : كذبت ، والله لا تبرح حتى ترضى بما رضيت . | PageV01P422 |(@)(@@) 667 - ( 171 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : قال عبيدة : قد أحدثه الناس أشربه | لا أدري ما هي ، فما شربت شرابا مذ عشرين سنة إلا لبنا وماء أو عسلا | وماء . |(@)(@@) 668 - ( 172 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، قال : سألت عبيدة عن الجد ، فقال : قد | حفظت عن عمر فيه مئة قضية مختلفة . |(@)(@@) 669 - ( 173 ) حدثنا أحمد ، قال : حدثنا عبد الوهاب ، قال : | أخبرنا ابن عون ، عن محمد ، عن عبيدة ، قال : قال عمر : لقد قضيت في | الجد قضايا مختلفة ، وأن أعش إلى الصيف أقضي فيه قضية تقضي به | المرأة على [ أدنى ؟ ] ذيلها . | ( أخر الجزء والحمد لله حق حمده | وصلواته على محمد وآله ) | PageV01P423 ( فارغة ) | PageV01P424 |(@)(@@) | المنتقى من السادس عشر | من حديث | أبي جعفر ابن البحتري(@)(@@) | PageV01P425 ( فارغة ) | PageV01P426 |(@)(@@) | ( الجزء فيه المنتقى من السادس عشر | من حديث أبي جعفر محمد بن عمرو بن البختري الرزاز )(@)(@@) | ( رواية أبي الحسين علي بن محمد بن عبد الله بن بشران المعدل | عنه ) | ( رواية أبي عبد الله الحسين بن أحمد بن محمد بن طلحة ) | ( رواية الشيخة الصالحة فاطمة بنت محمد بن علي بن البزازة | رحمها الله ) | ( سماع لعبد الله بن أحمد بن محمد المقدسي | ثم وقفه رضي الله عنه وتقبل سعيه ) | PageV01P427 |(@)(@@) | ( بسم الله الرحمن الرحيم )(@)(@@) 670 - ( 1 ) أخبرنا أبو جعفر محمد بن عمرو بن البختري | الرزاز قراءة عليه في رجب من سنة تسع وثلاثين وثلاثمئة : حدثنا | سعدان بن نصر : حدثنا سفيان بن عيينة ، عن أيوب ، عن أبي قلابة ، عن | زهدم الجرمي ، عن أبي موسى الأشعري ، قال :(@)(@@) رأيت رسول الله [ صلى الله عليه وسلم 
ms138	 ] يأكل الدجاج . |(@)(@@) 671 - ( 2 ) حدثنا سعدان : حدثنا روح بن عبادة ، عن سعيد بن | أبي عروبة ، عن علي بن الحكم ، عن ميمون بن مهران ، عن سعيد بن | جبير ، عن ابن عباس :(@)(@@) أن رسول الله [ صلى الله عليه وسلم ] نهى عن كل ذي ناب من السباع ، وعن كل ذي | PageV01P428 | مخلب من الطير . |(@)(@@) 672 - ( 3 ) أخبرنا عباس بن محمد : حدثنا يعلى بن عبيد : حدثنا | الأعمش ، عن أبي سفيان ، عن جابر ، قال :(@)(@@) سمعت رسول الله [ صلى الله عليه وسلم ] قبل موته بثلاث يقول : ' لا يموت أحدكم | إلا وهو حسن الظن بالله ( عز وجل ) ' . |(@)(@@) 673 - ( 4 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) قال رجل للنبي [ صلى الله عليه وسلم ] : أي الصلاة أفضل ؟ قال : ' طول القنوت ' . |(@)(@@) 674 - ( 5 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' مثل الصلوات المكتوبات كمثل نهر جار | عذب على باب أحدكم يغتسل منه كل يوم خمس مرات ' . | PageV01P429 |(@)(@@) 675 - ( 6 ) أخبرنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' إذا أكل أحدكم الطعام فليمص أصابعه ، فإنه | لا يدري في أي طعامه البركة ' . |(@)(@@) 676 - ( 7 ) حدثنا عباس : أخبرنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) دخل النبي [ صلى الله عليه وسلم ] على عائشة ( رضي الله عنه ) وعندها صبي يسيل | منخراه دما ، فقال : ' ما هذا ؟ ، فقالت : به العذرة ، فقال : ' ويلكن لا تقتلن | أولادكن ، فأيما امرأة أصاب ولدها العذرة أو وجع في رأسه فلتأخذ قسطا | هنديا فلتحكه بالماء ، ثم لتسعطه إياه ' ، ثم أمر عائشة فصنعت ذلك فبرأ . |(@)(@@) 677 - ( 8 ) أخبرنا عباس : / حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) مرض أبي بن كعب مرضا ، فبعث إليه النبي [ صلى الله عليه وسلم ] طيبا ، فكواه على | أكحله . | PageV01P430 |(@)(@@) 678 - ( 9 ) قال : وكان جابر مجاورا لمكة ستة أشهر ، فكان | يأتيه في منزله في بني فهر ، فسأله رجل : أكنتم 
ms139	 تسمون أحدا من أهل | القبلة ( مشركا ) ؟ قال : معاذ الله ، قال : فهل كنتم تسمون أحدا من أهل | القبلة ) كافرا ؟ قال : لا . |(@)(@@) 679 - ( 10 ) أخبرنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) قال رسول الله [ صلى الله عليه وسلم ] : ' من خاف ألا يستيقظ من آخر الليل فليوتر من | أول الليل ثم ليرقد ، ومن طمع أن يقوم من آخر الليل فإن قيام آخر الليل | محضور ، وذلك أفضل ' . |(@)(@@) 680 - ( 11 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر :(@)(@@) أن أهل قباء أتوا النبي [ صلى الله عليه وسلم ] فقالوا : إن الحمى قد اشتدت علينا ، | فقال : ' إن شئتم أن ترفع عنكم رفعت ، وإن شئتم كانت لكم طهورا ' ، | قالوا : لا ، بل تكون لنا طهورا . | PageV01P431 |(@)(@@) 681 - ( 12 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال :(@)(@@) قال النبي [ صلى الله عليه وسلم ] : ' إذا سقطت لقمة أحدكم فليمط ما عليها وليأكلها ، | ولا يدعها للشيطان ' . |(@)(@@) 682 - ( 13 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال : حدثني أبو سعيد ، قال :(@)(@@) دخلت على رسول الله [ صلى الله عليه وسلم ] وهو يصلي على حصير . |(@)(@@) 683 - ( 14 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن جابر ، قال : حدثني أبو سعيد ، قال :(@)(@@) دخلت على رسول الله [ صلى الله عليه وسلم ] [ وهو يصلي ] في ثوب واحد متوشحا به . |(@)(@@) 684 - ( 15 ) حدثنا عباس : حدثنا يعلى : حدثنا الأعمش ، عن | أبي سفيان ، عن أنس بن مالك ، قال : لقينا معاذا فقلنا : حدثنا من غرائب | حديث رسول الله [ صلى الله عليه وسلم ] قال :(@)(@@) كنت ردف رسول الله [ صلى الله عليه وسلم ] على حمار ، فقال : ' يا معاذ ' ، قلت : | لبيك يا رسول الله ، قال : ' تدري ما حق الله على العباد ؟ قال : قلت : | الله ورسوله أعلم ، قال : ' أن يعبدوه ولا يشركوا به شيئا ' ، ثم قال : | PageV01P432 | ' تدري ما حق العباد على الله إذا فعلوا ذلك ؟ ' قال : قلت : الله | ورسوله أعلم ، قال : ' فإن حق العباد على الله إذا فعلوا ذلك 
ms140	 ألا | يعذبهم ' . |(@)(@@) 685 - ( 16 ) حدثنا محمد بن عبيد الله بن يزيد : حدثنا يزيد بن | هارون : حدثنا حماد بن سلمة ، عن ثابت ، عن عبد الله بن رباح ، عن | أبي قتادة ، قال :(@)(@@) كنا مع رسول الله [ صلى الله عليه وسلم ] في سفر ، / فقال : ' إلا تدركوا الماء | تعطشوا ' ، فانطلق سرعان الناس يريد الماء ، ولزمت رسول الله [ صلى الله عليه وسلم ] تلك | الليلة ، فمالت برسول الله راحلته ، فنعس رسول اله فمال ، فدعمته | فادعم ، ومال فدعمته فادعم ، ثم مال ثم فدعمته فادعم ، ثم مال حتى كاد | أن ينجفل على راحلته فدعمته ، فانتبه ، فقال : ' من الرجل ؟ ' ، فقلت : | أبو قتادة ، فقال : ' حفظك الله بما حفظت به رسول الله ' ، ثم قال : ' لو | عرسنا ' ، فمال إلى شجرة فنزل ، فقال : ' انظر هل ترى أحدا ' ؟ فقلت : | هذا راكب ، هذان راكبان ، حتى بلغ سبعة ، فقال : ' احفظوا علينا صلاتنا ' ، | قال : فنمنا فما أيقظنا إلا حر الشمس فانتبهنا ، فركب رسول الله [ صلى الله عليه وسلم ] وسار | وسرنا هنيهة ، ثم نزل فقال ' معكم ماء ؟ ' ، فقلت : نعم ، ميضأة فيها | شيء من ماء ، قال : ' فائتني بها ' فأتيته بها ، فقال : ' مسوا منها مسوا | PageV01P433 | منها ' ، فتوضأ القوم وبقي في الميضأة جرعة ، فقال : ' ازدهر بها | يا أبا قتادة ، فإنه سيكون لها شأن ' .(@)(@@) ثم أذن بلال ، فصلى الركعتين قبل الفجر ، ثم صلى الفجر ، ثم ركب | وركبنا ، فقال بعض لبعض : قرطنا في صلاتنا ، فقال رسول الله [ صلى الله عليه وسلم ] : ' ما | تقولون ؟ إن كان أمر دنياكم فشأنكم ، وإن كان أمر دينكم فإلي ' ، قلنا : | يا رسول الله قرطنا في صلاتنا ، قال : ' لا تفريط في النوم ، إنما التفريط | في اليقظة ، فإذا كان ذلك فصلوها من الغد لوقتها ، ثم قال : ' ظنوا | بالقوم ' ، فقلنا : إنك قلت بالأمس : إلا تدركوا الماء تعطشوا ، فأتى | الناس الماء ، فقال : ' أصبح الناس وقد فقدوا نبيهم ، فقال بعض القوم : إن | رسول الله [ صلى الله عليه وسلم ] بالماء ، وفي القوم أبو بكر وعمر ، قالا : أيها الناس ، إن | رسول الله لم يكن ليسبقكم إلى الماء ويخلفكم ، وإن يطع الناس أبا بكر | وعمر يرشدوا ' قالها 