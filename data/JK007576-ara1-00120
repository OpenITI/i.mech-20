ms101	 أكبر % أبى الله أن يختال في عطفه الكبر % 70(@)(@@) % أبي كحد السيف من غير نبوة % إذا ما مضاء الذمر قل به الذمر % % PageV01P345 71(@)(@@) % هو النجد يقري الرمح والسيف كفه % % بعضوين يلفى فيهما العمر والذكر % % 72(@)(@@) % وما حسن إلا مليك متوج % أفاض الغنى من راحتيه فلا فقر % % 73(@)(@@) % كأن حبيا ساكنا فيض ودقه % % وقد يحتبي منه لقصاده البدر % 74(@)(@@) % إذا ما جرى في محفل حسن ذكره % % تعلق تشريفا بأذياله الفخر % % 75(@)(@@) % فلا زال والتوحيد معتصم به % % تزان به الدنيا ويخدمه الدهر % PageV01P346 البحر : كامل تام 1(@)(@@) % بكرت تغازله الدمى الأبكار % % فهفا له حلم وطاش وقار % 2(@)(@@) % وأظنه مترنحا من نشوة % كاساتها بهوى العيون تدار % 3(@)(@@) % يا لومي ، ومتى بليت بلوم % % إلا وهم بيليتي أغمار % 4(@)(@@) % فكوا الغضنفر من إشار غزالة % قيداه خلخال لها وسوار % % 5(@)(@@) % ما أحرقت خدي سواكب أدمعي % % إلا بماء في حشاه نار % 6(@)(@@) % والماء منفجر من النار التي % % في القلب منها يستطير شرار % % 7(@)(@@) % عجبي لأضداد علي تناصرت % جورا علي وليس لي أنصار % % 8(@)(@@) % فخذوا الهوى عني بنقل ملاحة % عن أعين يرنو بهن صوار % % 9(@)(@@) % ومباسما تجلو شقائق روضة % للأقحوانة بينها نوار % % 10(@)(@@) % إن المها تمهي سيوف جفونها % % فحذار منها لو يطاق حذار % % PageV01P347 11(@)(@@) % من كل مشربة بجريال الصبا % % لونا كما لمس اللجين نضار % 12(@)(@@) % في خلقها الإنسي من وحشية % % كحل وحسن تلفت ونفار % % 13(@)(@@) % طرفي برجعته إلي أذاقتي % % منها الردى لا طرفها السحار % 14(@)(@@) % % غرضا له ، فالجرح من جبار % % 15(@)(@@) % طرقت تهادى في اختياله شبيبة % ت خطي مطيل الوجد وهي قصار % % 16(@)(@@) % سفرت فما درت الظنون ضميرها % % أسفورها من صبحها إسفار % % 17(@)(@@) % حتى إذا خافت مراقبها ، علا % % منها على الوجه المنير عجار % % 18(@)(@@) % وكأنما زهر النجوم حمائم % بيض ، مغاربها لها أوكار % % 19(@)(@@) % وكأنما تذكي ذكاء توهجا % فيه يذوب من الدجنة قار % % 20(@)(@@) % يا هذه لا تسألي عن عبرتي % % عيني على عيني عليك تغار % % PageV01P348 21(@)(@@) % هل كان نهدك صنو قلبك تتقي % % عن لمسه في صدرك الأزرار % % 22(@)(@@) % ما كنت 
ms102	 أحسب غصن بان في نقا % % تشكو أليم القطف منه ثمار % 23(@)(@@) % نصلت سهمي مقلتيك ليصميا % % بنصال سحر الطرف فهي حرار % % 24(@)(@@) % وهما المعلى والرقيب وإنما % % فربوعه بالمعتقين أواهل % 25(@)(@@) % لا ثأر يدرك منك في المهج التي % % أرديتها أو منك يدرك ثار % 26(@)(@@) % هلا التفت كما تلفت مغزل % لترى مكان الخشف وهي نوار % % 27(@)(@@) % وبردت حر الشوق بالبرد الذي % % شهد ومسك دونه وعقار % % 28(@)(@@) % إني دفعت إلى هواك وغربة % هتفت بها العزمات والأسفار % % 29(@)(@@) % وغرست عمري في الزماع فمررت % لفمي جناه نجائب وقفار % % 30(@)(@@) % وجعلت داري في النوى فمؤانسي % % وحش الفلا ومجالسي الأكوار % % PageV01P349 31(@)(@@) % لولا ذرى الحسن الهمام وفضله % ما قر بي في الخافقين قرار % % 32(@)(@@) % هذا الذي بذلت أنامله الندى % % وهدي الكرام إليه لما حاروا % % 33(@)(@@) % هذا الذي سل السيوف مجاهدا % فبضربها للمشركين دمار % % 34(@)(@@) % هذا الذي جر الرماح لحربهم % % سعي الأساود ، جيشه الجرار % % 35(@)(@@) % قهرت ظبا توحيده تثليثهم % وقضى بذاك الواحد القهار % % 36(@)(@@) % غضبا على الأعلاج منه فربه % يرضى به ونبيه المختار % % 37(@)(@@) % فلوجهه البادي عليه سنا الهدى % % ضربت وجوه عداته الأقدار % % 38(@)(@@) % أما علا حسن فبين مصامها % % شرفا وبين الفرقدين جوار % % 39(@)(@@) % خلصت خلائقه ولم يعلق بها % % جبرية لم يرضها الجبار % % 40(@)(@@) % وسما له حلم وجل تنفضل % وزكا له فرع وطاب نجار % % PageV01P350 41(@)(@@) % يندى بلا وعد وكم من عارض % من غير برق صوبه مدرار % % 42(@)(@@) % % وبناته بالمكرمات بحار % % 43(@)(@@) % وإذا عفا صفحا عفا عن قدرة % والحلم في الملك القدير فخار % % 44(@)(@@) % سلت صوارمه الحداد ففلقت % هاما عليها للجياد عثار % % 45(@)(@@) % في جحفل كالبحر ماج بضمر % فتكت على صهواتها الأذمار % % 46(@)(@@) % لا يجزعون من المنون كأنما % % آجالهم لنفوسهم أعمار % % 47(@)(@@) % فصعيد وجه الأرض منه مبعثر % وذرور عين الشمس منه غبار % % 48(@)(@@) % إن الحروب وأنتم آسادها % % فتكاتكم في عربها أبكار % % 49(@)(@@) % أضحت لصونكم الثغور كأعين % % وشفاركم من حولها أشفار % % 50(@)(@@) % زانت سيادتكم كرامة بركم % % خير الملوك السادة الأبرار % % PageV01P351 51(@)(@@) % يا من عتاق الخيل توسم باسمه % والدرهم المضروب والدينار % % 52(@)(@@) % وبكل 
ms103	 أرض تستنير بذكره % % خطب من الفصحاء أو أشعار % % 53(@)(@@) % خدمت رئاستك السعود وأصبحت % للفضل تحسد عصرك الأعصار % % 54(@)(@@) % ورجال دولتك الذين لقدرهم % % بك في الورى الإجلال والإكبار % % 55(@)(@@) % فمن المقدم والزمام كفاية % نجح بها الإيراد والإصدار % % 56(@)(@@) % فهما وزيراك اللذان عليهما % % لنفوذ أمركف السداد مدار % % 57(@)(@@) % جبلان يقترنان للرأي الذي % % لعداك منه مذلة وصغار % % 58(@)(@@) % فالملك بينهما حديث حسنه % قطعت لياليها به السمار % % 59(@)(@@) % وكأن ذا سمع وذا بصر له % % حسدتهما الأسماع والأبصار % % 60(@)(@@) % والليث إبراهيم قائدك الذي % % تدمى بصولته له أظفار % % PageV01P352 61(@)(@@) % يرمي شداد المعضلات بنفسه % % بطل الكفاح وذمرها المغوار % % 62(@)(@@) % وإذا تفجر جدول من غمده % % شرقت بماء غمامه الفجار % 63(@)(@@) % وعبيدك الغلمان إن ناديتهم % % نهضوا ، مواثبة الأسود ، وثاروا % % 64(@)(@@) % ومشوا مع التأييد قامات إلى % % هيجاء مشي حماتها أشبار % % 65(@)(@@) % سبحوا إلى الأعلاج إذ لم ينزلوا % % من فلكهم فحجالها تيار % % 66(@)(@@) % ورموهم بجنادل فكأنها % % لأجورها عند الإله جمار % % 67(@)(@@) % وبكل سهم واقع لكنه % % بثلاث أجنحة له طيار % % 68(@)(@@) % وحموا حمى الأسوار وهي وراءهم % % حتى كأنهم لها الأسوار % % 69(@)(@@) % وكأنما حر المنايا عندهم % % برد إذا ما اشتد منه أوار % 70(@)(@@) % لا يتقي في الضرب سيفك مغفرا % فله من القدر المطاع غرار % % PageV01P353 71(@)(@@) % لو أن أعراضا تجوهر أصبحت % في كفك العزمات وهي شفار % % 72(@)(@@) % أو أن للأرض الجماد تنقلا % حجت إلى أمصارك الأمصار % % 73(@)(@@) % فليهنك الشهر المعظم إنه % ضيف قراه البر والإيثار % 74(@)(@@) % أصبحت فيه لوجه ربك صائما % لكن لكفك بالندى إفطار % % 75(@)(@@) % ضيف أتاك به لتعرف حقه % فلك بقدرة ربه دوار % % 76(@)(@@) % لا زالت الأيام وافدة على % % ما تشتهي منها وما تختار % PageV01P354 البحر : طويل 1(@)(@@) % وجفنين أوفى بالمنية فيهما % % عليك من الغزلان وسنان أحور % 2(@)(@@) % فجفن له عضب من اللحظ مرهف % وجفن به ماض من الهند مبتر % 3(@)(@@) % وأمضاهما حدا فلا تغترر به % % غرار الذي فيه من السحر جوهر % % PageV01P355 البحر : متقارب تام 1(@)(@@) % حسان تدير بسحر الهوى % % عيون المها في وجوه البدور % % 2(@)(@@) % طوال الفروع قصار الخطا % % ثقال الروادف هيف 
ms104	 الخصور % % 3(@)(@@) % تطيب أفواههن الحديث % بحمر الشفاه وبيض الثغور % % 4(@)(@@) % كما مر بالورد والأقحوان % نسيم مشوب بريا العبير % % PageV01P356 البحر : بسيط تام 1(@)(@@) % إذا رأيت ملوك الأرض قد نظروا % % إلى السماء فكل الخوف في النظر % % 2(@)(@@) % فإنهم يتقون البطش من ملك % منفذ أمره كاللمح بالبصر % % PageV01P357 البحر : طويل 1(@)(@@) % خلت منك أيام الشبيبة فاعمرها % % وماتت لياليها من العمر فانشرها % % 2(@)(@@) % وهذا لعمري كله غير كائن % فأخراك واصلها ودنياك % % 3(@)(@@) % أرى لك نفسا في هواك مقيمة % وقد طال ذا منها ، لك الويل ، فاقصرها % % 4(@)(@@) % وكم سيئات أحصيت فنسيتها % % وأنت متى تقرأ كتابك تذكرها % % 5(@)(@@) % فيا رب إني في الخضوع لقائل : % ذنوبي عيوبي يوم ألقاك فاسترها % % PageV01P358 البحر : خفيف تام 1(@)(@@) % يا ذنوبي ثقلت والله ظهري % % بان عذري فكيف يقبل عذري % % 2(@)(@@) % كلما تبت ساعة عدت أخرى % % لضروب من سوء فعلي وهجري % % 3(@)(@@) % تقلت خطواتي وفودي تفرى % % غيهب الليل فيه عن نور فجر % % 4(@)(@@) % دب موت السكون في حركاتي % % وخبا في رماده حمر جمري % % 5(@)(@@) % وأنا حيث سرت آكل رزقي % % غير أن الزمان يأكل عمري % % 6(@)(@@) % كلما مر منه وقت بربح % من حياتي وجدت في الريح خسري % % 7(@)(@@) % يا رفيقا بعبده ومحيطا % علمه باختلاف سري وجهري % % 8(@)(@@) % مل بقلبي إلى صلاح فسادي % % منه واجبر برأفة منك كسري % % 9(@)(@@) % وأجرني مما جناه لساني % % وتناجت به وساوس فكري % % PageV01P359 البحر : متقارب تام 1(@)(@@) % أرى الشيخ يكرهف نفسه % مشيبا أفاض عليه النهارا % % 2(@)(@@) % وضعفا يهد قوى جسمه % وينقل منه خطاه قصارا % % 3(@)(@@) % فكيف يجشمها طفلة % يطير بها القلب عنه نفارا % % 4(@)(@@) % وعار على الشيخ تقريبه % فتاة ترى قربة منه عارا % % 5(@)(@@) % وقد جبل الغانيات . الصغار % على بغضهن الشيوخ الكبارا % % PageV01P360 البحر : طويل 1(@)(@@) % غريب بأرض المغربين أسير % سيبكي عليه منبر وسرير % 2(@)(@@) % إذا زال لم يسمع بطيب ذكره % % ولم ير ذاك اللهو منه منير % % 3(@)(@@) % وتندبه البيض الصوارم والقنا % % وينهل دمع بينهن غزير % % 4(@)(@@) % سيبكيه في زاهيه والزاهر الندى % % وطلابه والعرف ثم نكير % % 5(@)(@@) % إذا قيل في أغمات قد مات 
ms105	 جوده % % فما يرتجى بعد الممات نشور % % 6(@)(@@) % مضى زمن والملك مستأنس به % % وأصبح عنه اليوم وهو نفور % % 7(@)(@@) % أذل بني ماء السماء زمانهم % % وذل بني ماء الزمان كثير % % 8(@)(@@) % برأي من الدهر المضلل فاسد % % متى صلحت للصالحين دهور % % 9(@)(@@) % فما ماؤها إلا بكاء عليهم % يفيض على الأكباد منه بحور % % 10(@)(@@) % فيا ليت شعري هل أبيتن ليلة % % أمامي وخلفي روضة وغدير % % PageV01P361 11(@)(@@) % بمنبتة الزيتون مورثة العلى % % تغني حمام أو ترن طيور % % 12(@)(@@) % بزاهرها السامي الذي جا / ه الحيا % % تشير الثريا نحونا ونشير % % 13(@)(@@) % ويلحظنا الزاهي وسعد سعوده % % غيورين والصب المحب غيور % % 14(@)(@@) % تراه عسيرا لا يسيرا مناله % % ألا كل ما شاء الإله يسير % % PageV01P362 البحر : طويل 1(@)(@@) % حجبت فلا والله ما ذاك عن أمري % % فأصغ فدتك النفس سمعا إلى عذري % % 2(@)(@@) % فما صار إخلال المكارم لي هوى % ولا دار إخجال لمثلك في صدري % % 3(@)(@@) % ولكنه لما أحالت محاسني % % يد الدهر شلت عنك دأبا يد الدهر % % 4(@)(@@) % عدمت من الخدام كل مهذب % أشير إليه بالخفي من الأمر % 5(@)(@@) % ولم يبق إلا كل أدكن ألكن % فلا آذن في الإذن يبرأ من عسر % % 6(@)(@@) % حمار إذا يمشي ونسر محلق % % إذا طار ، بعدا للحمار وللنسر % % 7(@)(@@) % وليس بمحتاج أتانا حمارهم % % ولا نسرهم مما يحن إلى وكر % % 8(@)(@@) % وهل كنت إلا البارد العذب إنما % % به يشتفي الظمآن من غلة الصدر % % 9(@)(@@) % ولو كنت ممن يشرب الخمر كنتها % % إذا نزعت نفسي إلى لذة الخمر % % 10(@)(@@) % وأنت ابن حمديس الذي كنت مهديا % لنا السحر ، إذ لم يأت في زمن السحر % % PageV01P363 البحر : بسيط تام 1(@)(@@) % وصفت حسنك للسالي فجن به % كأن للسمع منه رؤية البصر % 2(@)(@@) % فلم يزل في وجوه الحسن مقتبلا % بالوصف في صور منها إلى صور % 3(@)(@@) % وكيف يخفى عليه ما كلفت به % % إذا الدلائل دلته على القمر % % PageV01P364 البحر : طويل 1(@)(@@) % إذا ما الهواء اعتل كان اعتلالنا % % محيطا بما يجريه فينا التنفس % 2(@)(@@) % وربتما كان الغذاء مضرة % يذم به العقبى جهول وكيس % 3(@)(@@) % وأمراضنا أسبابهن كثيرة % تحل بأجسام 
ms106	 فتهلك أنفس % PageV01P365 البحر : بسيط تام 1(@)(@@) % قل للأساة أسأتم في علاجكم % % فممرضي من ضنى جسمي هو الآسي % % 2(@)(@@) % . . . . . . . . . . . . . . . . . . . . . % شمسا من النار لم تطلع على الناس % % 3(@)(@@) % ولو وجدت مزاج القلب معتدلا % ببرد أنفاسها في حر أنفاسي % % 4(@)(@@) % لله ما رضت منها بالخضوع وما % % ألامنيه لقلبي إلا قلبي القاسي % % 5(@)(@@) % خدعت قرن الهوى حتى فتكت به % % بالله قل هل بخدع القرن من باس % % PageV01P366 البحر : طويل 1(@)(@@) % لأمر طويل الهم نزجي العرامسا % % وتطوي بنا أخفاقهن البسابسا % % 2(@)(@@) % وتذعر بالبيداء عينا شواردا % تذكر بالأحداق عينا أوانسا % % 3(@)(@@) % عذارى ترى الحسن البديع مطابقا % لأنواعها في خلقه ومجانسا % % 4(@)(@@) % أعاذل دعني أطلق العبرة التي % % عدمت لها من أجمل الصبر حابسا % % 5(@)(@@) % فإني امرؤ آوى إلى الشجن الذي % % وجدت له في حبة القلب ناخسا % % 6(@)(@@) % لقدرت أرضي أن تعود لقومها % % فساءت ظنوني ثم أصبحت يائسا % % 7(@)(@@) % وعزيت فيها النفس لما رأيتها % % تكابد داء قاتل السم ناحسا % % 8(@)(@@) % وكيف وقد سيمت هوانا وصيرت % مساجدها أيدي النصارى كنائسا % % 9(@)(@@) % إذا شاءت الرهبان بالضرب أنطقت : % مع الصبح والإمساء فيهعا النواقسا % % 10(@)(@@) % لئن كان أعيا كل طب علاجها % % فكم جرب في السيف أعيا المداوسا % % PageV01P367 11(@)(@@) % فك صقيلة كاد الزمان بلادها % % وكانت على أهل الزمان محارسا % % 12(@)(@@) % فكم أعين بالخوف أمست سواهرا % وكانت بطيب الأمن منهم نواعسا % % 13(@)(@@) % أرى بلدي قد سامه الروم ذلة % وكان بقومي عزه متقاعسا % % 14(@)(@@) % وكانت بلاد الكفر تلبس خوفه % فأضحى لذاك الخوف منهن لابسا % % 15(@)(@@) % عدمت أسودا منهم عربية % ترى بين أيديها العلوج فرائسا % % 16(@)(@@) % فلم تر عيني مثلهم في كتيبة % مضارب أبطال الحروب مداعسا % % 17(@)(@@) % ويا رب براق النضال تخاله % من النقع ليلا مشرق الشهب دامسا % % 18(@)(@@) % خلوا بين أطراف القنا بكماته % لطعن من الفرسان يخلي القوانسا % % 19(@)(@@) % وما خلت أن النار يبرد حرها % % على سعف لاقته في القيظ يابسا % % 20(@)(@@) % أما ملئت غزوا قلورية بهم % وأرادوا بطاريقا بها وأشاوسا % % PageV01P368 21(@)(@@) % هم فتحوا أغلاقها بسيوفهم % وهم تركوا الأنوار فيها حنادسا % % 22(@)(@@) % وساقوا بأيدي السبي بيضا 
ms107	 حواسرا % تخال عليهن الشعور برانسا % % 23(@)(@@) % يخوضون بحرا كل حين إليهم % ببحر يكون الموج فيه فوارسا % % 24(@)(@@) % وحربية ترمي بمحرق نفطها % % فيغشى سعوط الموت فيها المعاطسا % % 25(@)(@@) % تراهن في حمر اللبود وصفرها % % كمثل بنات الزنج زفت عرائسا % % 26(@)(@@) % إذا عثنت فيها التنانير خلتها % % تفتح للبركان عنها منافسا % % 27(@)(@@) % أفي قصريني رقعة يعمرونها % % ورسم من الإسلام أصبح دارسا % % 28(@)(@@) % ومن عجب أن الشياطين صيرت % % بروج النجوم المحرقات مجالسا % % 29(@)(@@) % وأضحت لهم سرقوسة دار منعة % يزورون بالديرين فيا النواوسا % % 30(@)(@@) % مشوا في بلاد أهلها تحت أرضها % % وما مارسوا منهم أبيا ممارسا % % PageV01P369 31(@)(@@) % ولو شققت تلك القبور لأنهضت % إليهم من الأجداث أسدا عوابسا % % 32(@)(@@) % ولكن رأيت الغيل إن غاب ليثه % تبختر في أرجائه الذئب مائسا % % PageV01P370 البحر : طويل 1(@)(@@) % ووردية في اللون والفوح شعشعت % فأبدت نجوما في شعاع من الشمس % % 2(@)(@@) % نفيت هموم النفس منها بشربة % دبيب حمياها يرق عن الحس % 3(@)(@@) % كأن يدي من فضة فإذا حوت % زجاجتها عادت مذهبة الخمس % PageV01P371 البحر : طويل 1(@)(@@) % ولما التقى الأجسام من غير ريبة % وقد تلفت بالشوق فيهن أنفس % 2(@)(@@) % جينا ، ولم تنسب إلينا جناية ، % ثمار نعيم تجتنى حين تغرس % 3(@)(@@) % ولما استقل النجم يرفع راية % يحل بها نور ويرحل حندس % % 4(@)(@@) % تنهدت مرتاع الفؤاد وإنما % % تنهدت للصبح الذي يتنفس % % 5(@)(@@) % فيا صبح لا تقبل فإنك موحش % ويا ليل لا تدبرفإنك مؤنس % % PageV01P372 البحر : متقارب تام 1(@)(@@) % شموس دعاهن وشك الفراق % % فلبين في القضب الميس % 2(@)(@@) % تريق المدامع كالساقيات % من السكر يعشرن بالأكؤس % % 3(@)(@@) % طوالع نحو غروب تريك % جسوم الديار بلا أنفس % % 4(@)(@@) % تزرر صونا عليها الخدور % فتبكي عيون المها الكنس % % 5(@)(@@) % وقد زار عذب اللمى في الأقلح % % أجاج الدموع من النرجس % % 6(@)(@@) % وقامت على قدم فرقة % إذا وقف العزم لم تجلس % % 7(@)(@@) % ولم يبق إلا انصراف الدجى % % بزهر كواكبه الخنس % 8(@)(@@) % ومحو النهار بكافورة % % من النور عنبرة الحندس % % 9(@)(@@) % ألا غفلة من رقيب عتيد % يلاحظنا نظرة الأشوس % 10(@)(@@) % فنهدي على عجل قبلة % إلى شفة الرشإ في الألقس 
ms108	 % PageV01P373 11(@)(@@) % غدا يتقطع أقرانهم % ويتصل السير في البسبس % % 12(@)(@@) % ويكلأ ذمر على ضامر % خبيئة خدر على عرمس % % 13(@)(@@) % ويصبح من وصل سلمى الغني % يقلب منه يدي مفلس % % PageV01P374 البحر : طويل 1(@)(@@) % وخفاقة الرايات في جوف نقعها % % ترى الجرد فيها بالكماة تكدس % 2(@)(@@) % زبون ربا سم بأطراف سمرها % % كأن ثعابينا بها تتنفس % 3(@)(@@) % تروقك كالحسناء يضحك سنها % % وترتاع منها وهي كالغول تعبس % 4(@)(@@) % وتقلع أرواح العداة أسنة % تراهن منهم في الحيازيم تغرس % % 5(@)(@@) % فكم طعنة نجلاء تحسبها فما % له هرت في الذمر بالدم تقلس % % 6(@)(@@) % صببنا عليها ضربنا من صوارم % فغاصت بها من أسرها القلب أنفس % 7(@)(@@) % ونحن بني الثغر الذين نفوسهم % % ذكور بأبكار المنايا تعرس % 8(@)(@@) % فمن عزمنا هندية الضرب تنتضى % % ومن زندنا نارية البأس تقبس % PageV01P375 البحر : طويل 1(@)(@@) % وأبيض ماض لا يقي من غراره % غداة قراع الهام درع ولا ترس % 2(@)(@@) % يمج سريعا في فم الجرح حده % من السم ما سقته من ملكها الفرس % % 3(@)(@@) % إذا ما بدا من غمده قلت : رفعت % بخارا لطيفا فوق جدوله الشمس % 4(@)(@@) % يفرق بين الرأس والجسم حده % وإن كان لم تشعر بضربته النفس % 5(@)(@@) % فمضربه في هامة القرن مأتم % ومضربه في كف صاحبه عرس % % PageV01P376 البحر : طويل 1(@)(@@) % حللت بيومي إذ رحلت عن الأمس % وسرت ولم أعمل جوادي ولا عنسي % % 2(@)(@@) % مراحل دنيانا مراحلنا التي % % ترانا عليها نقطع العيش بالخمس % % 3(@)(@@) % ونحن بدار يعقب الخوف أمنها % % وتذهب فيها وحشة الأمن بالأنس % % 4(@)(@@) % ليال وأيام بساعاتها سعت % لتفريقها ما بين جسمك والنفس % % 5(@)(@@) % وإني وإن أصبحت منها مسلما % لأكثر قولي : ليت شعري هل أمسي % % 6(@)(@@) % ومن حل في سبعين عاما كأنه % % علاج عليل في مواصلة النكس % % 7(@)(@@) % فما فهم الأشياء بالدرس وحده % ولكنه بدء التفهم والدرس % % 8(@)(@@) % وكم حكم في خط قوم كثيرة % وأفضل منها لمعة من سنا الحس % PageV01P377 البحر : طويل 1(@)(@@) % إلى كم أراني في هوى النفس خائضا % ولم أتق الإغراق منها على نفسي % % 2(@)(@@) % وقد شملتني شيبة لم أبت بها % % فما لي في ليلي 
ms109	 وقد طلعت شمسي % % 3(@)(@@) % غرست بكفي المعاصي جاهدا % % ولاشك أني أجتني ثمر الغرس % 4(@)(@@) % إلى الله أشكو جملة أرتدي بها % % وأصبح منها في الذنوب كما أمسي % % 5(@)(@@) % فيا وحشي من سوء ما قدمت يدي % % إذا لم يكن في القبر من رحمة أنسي % % PageV01P378 البحر : طويل 1(@)(@@) % وريحانة في النفس منبت غصنها % % لها نفس يحيي بنفحته النفسا % % 2(@)(@@) % إذا أقبلت كانت بتقويم خلقها % % ومشيتها بالشمس تستوقف الشمسا % % 3(@)(@@) % فتاة إذا استعطفت باللين قلبها % % على الصب أضحى وهو من حجر أقسى % % 4(@)(@@) % ولا شك أن الماء رطب وكلما % % شقيت حديدا فيه زاد به يبسا % % PageV01P379 البحر : كامل أحذ 1(@)(@@) % كملت لي الخمسون والخمس % ووقعت في مرض له نكس % 2(@)(@@) % ووجدت بالأضداد في جسدي % % غصن يلين وقامة تقسو % % 3(@)(@@) % وتموت فيها الجن والإنس % % لحظ الهصور جآذر خنس % 4(@)(@@) % وابيض من فودي من شعري % % وحف كأن سواده النقس % % 5(@)(@@) % والعمر يذبل في منابته % % غرس ، ويلبس نضرة غرس % % 6(@)(@@) % أصغيت للأيام إذ نطقت % بالوعظ فهي نواطق خرس % 7(@)(@@) % وفهمت بعد اللبس ما شرحت % والشرح يذهب عنده اللبس % % 8(@)(@@) % أضحى بوحشتي المشيب ، ولي % % بعد الشباب بذكره أنس % 9(@)(@@) % ومسايرا زمنين في عمري % % مصباح ذا قمر ، وذا شمس % 10(@)(@@) % دنيا الفتى تفنى لذا خلقت % وتموت فيهتا الجن والإنس % PageV01P380 11(@)(@@) % إنا لأدم كلنا ولد % وحمامنا بحمامه جنس % % 12(@)(@@) % وأقل ما يبقى الجدار إذا % % ما انهد تحت بنائه الأس % 13(@)(@@) % يا رب إن النار عاتية % وبكل سامعة لها حس % 14(@)(@@) % لا تجعلن جسدي لها حطبا % فيه تحرق مني النفس % % 15(@)(@@) % وارفق بعيد ، لحظه جزع % يوم الحساب ، ونطقه همس % % PageV01P381 البحر : بسيط تام 1(@)(@@) % حمى حمى الملك منه صارم ذكر % مقابل الجود بالعلياء في الباس % % 2(@)(@@) % يرعى الرعايا بعين من حفيظته % % ويبسط العدل منه لين قاس % % 3(@)(@@) % كأن سورة كسرى عند سورته % % سكون صورة كسرى وهو في الكاس % % PageV01P382 البحر : بسيط تام 1(@)(@@) % لو أن ربع شبابي غير مندرس % ما بت أوحش من جور المها الأنس % 2(@)(@@) % من كل روضة حسن زهرها أرج % تهدي 
ms110	 الهوى لي في لحظ وفي أنس % % 3(@)(@@) % لما تظلم من أطرافها عنم % فاسحل أقحوان الظلم واللعس % % 4(@)(@@) % تدير بالسحر عيني أم شادنة % بفاتر اللحظ للألباب مختلس % 5(@)(@@) % وما رأيت مهاة قبلها وصفت % في السرب بالشمم المعشوق لا الخنس % % 6(@)(@@) % لها محاسن ، من غبن الشباب غدت % % محاسن الغيد منها وهي كالدلس % % 7(@)(@@) % تصبي الحليم وتسبيه فمبصرها % % كمنتش في خبال السكر منغمس % % 8(@)(@@) % شمس شموس عن الشيب الذي جمحت % عنه ، وذات عنان للصبا سلس % % 9(@)(@@) % إني لأعجب ، والآرام مجبنة ، % من رئم خدر لليث الغيل مفترس % % 10(@)(@@) % لاح القتير فأقمار البراقع لم % % تطلع علي وقضب البان لم تمس % % PageV01P383 11(@)(@@) % حتى كأن بياض الشيب منتقل % إلى سواد عيون الخرد الأنس % % 12(@)(@@) % إن فاتني قنص الغزلان نافرة % فقد ترى من خيول الهم ما فرسي % % 13(@)(@@) % كم أشهب صاد غزلان الصوار فما % % لأشهبي راسخ الأرساغ في دهس % 14(@)(@@) % ست وستون عاما كيف تدرك بي % % من عمرها ينتهي منها إلى السدس % % 15(@)(@@) % لله در شباب لست ناسيه % لو أنه كان إنسانا لقلت نسي % % 16(@)(@@) % يسقي محاسن ذات الربع معطشها % % سحا بكل ضحوك البرق منبجس % % 17(@)(@@) % وداخلات على الظلماء سبسبها % % بكل خرق عريق في العلى ندس % 18(@)(@@) % كأنها وهي ترمي المقفرات بهم % % من الوجيف نبال ، والهزال قسي % % 19(@)(@@) % مثل الحواجب لاذت وهي ظامئة % بأعين بالفلا مطموسة درس % 20(@)(@@) % لا يحبسن الماء إلا في ثمائلها % % تيها فتحرس نقطا بالكبود حسي % % PageV01P384 21(@)(@@) % من كل دامية الأخفاف مرقلة % % ترتاع من صوت حاد خلفها شرس % 22(@)(@@) % مستوحش من كلام الإنس تؤنسه % % من جوع من ذئاب المهمه الطلس % % 23(@)(@@) % ماذا تقول ولج البحر يسحبه % % إن السفينة لا تجري على اليبس % % 24(@)(@@) % قف بالتفكير يا هذا على زمن % جم الخطوب ومثل صرفه وقس % 25(@)(@@) % ولا تكن عنده للسلم ملتمسا % فالأري في فم صل غير ملتمس % % 26(@)(@@) % إن الفتى في يديه المال عارية % كالثوب عري منه غيره وكسي % % 27(@)(@@) % وإنه لينميه ويودعه % من الصبابة بين الحرص والحرس % 28(@)(@@) % إن الهوا لمحيط بالنفوس فقل % % هل حظها 
ms111	 منه غير الفوت بالنفس % 29(@)(@@) % إني امرؤ وطباع الحق تعضدني % % مطهر العرض لا أدنو من الدنس % 30(@)(@@) % ألفت حسن سك ت لا أعاب به % ولي بيان مقال غير ملتبس % PageV01P385 31(@)(@@) % فما أحرك في فكي عن غضب % لسان منتهش الأعراض منتهس % 32(@)(@@) % قد يعقل العاقل النحرير منطقه % ورب نطق غداف الغي كالخرس % % 33(@)(@@) % والجهل في شيمة الإنسان أقتل من % % تخلخل النبض في بحران منتقس % % PageV01P386 البحر : طويل 1(@)(@@) % فعوضت شيبا من شبابي كأنني % % توليت عن ظل برغمي إلى الشمس % % 2(@)(@@) % وقطعي بعيش بعد ستين حجة % أرى فيه لبسا والتخوف في اللبس % % 3(@)(@@) % ذنوبي تنمي كل يوم تكسبا % فيومي بها في اليوم أثقل من أمسي % % 4(@)(@@) % ألا آمن الرحمن خوفي بعفوه % % فإني من نفسي أخاف على نفسي % % PageV01P387 البحر : مخلع البسيط 1(@)(@@) % أسلمني الدهر للرزايا % % وغير الحادثات قفشي % % 2(@)(@@) % وكنت أمشي ولست أعيا % % فصرت أعيا ولست أمشي % % 3(@)(@@) % كأنني إذ كبرت نسر % يطعمه فرخه بعش % PageV01P388 البحر : كامل تام 1(@)(@@) % أسعاد إن كمال خلقك راعني % % فرأيت بدر التم عنه ناقصا % % 2(@)(@@) % أرضاب فيك سلافة نشواتها % % يمشين من طرب بقدك راقصا % 3(@)(@@) % بحر بعيني لم يزل إنسانها % % فيه على در المدامع عائصا % 4(@)(@@) % كم أحور لما رآك رأيته % % يرنو إلى تفتير طرفك شاخصا % % 5(@)(@@) % هل ظن ثغرك أقحوانا ناضرا % % ترعاه غزلان الفلاة خمائصا % % 6(@)(@@) % حتى إذ لاح ابتسامك يجتلي % % درا على عينيه ولى ناكصا % % 7(@)(@@) % لا تقنصيه كما قضت متيما % فالرئم لا يغدو لرئم قانصا % % PageV01P389 البحر : - 1(@)(@@) % نومي على ظهر الفراش منغص % والليل فيه زيادة لا تنقص % 2(@)(@@) % من عاديات كالذئاب تذاءبت % وسرت على عجل فما تتربص % 3(@)(@@) % جعلت دمي خمرا تداوم شربها % % مسترخصات منه ما لا يرخص % 4(@)(@@) % فترى البعوض مغنيا بربابه % والبق تشرب والبراغث ترقص % % PageV01P390 البحر : طويل 1(@)(@@) % بأي وفي في زمانك تختص % فيغلو غلوا في يديك به رخص % 2(@)(@@) % وكم من عدو كامن في مصادق % وموضع أمن فيه يحترس اللص % % 3(@)(@@) % وكم فرس في الحسن أكمل خلقه % % فلما عدا في الشأو أدركه النقص 
ms112	 % % 4(@)(@@) % وكم منظر في البزل قدم في السرى % % فلما استمر النص أخره النص % % 5(@)(@@) % كذاك خليل المرء يدعو اختباره % إلى ما يكون الزهد فيه أو الحرص % 6(@)(@@) % ولا خير في خلق يذم لجهله % % ويحمد منه قبل خبرته الشخص % % 7(@)(@@) % وما المال إلا كالجناح لناهض % وقد يعتريه عن حوائجه القص % 8(@)(@@) % وكم فاضل ملبوسه دون قدره % وعا الجوهر الأجسام لا الدر والفص % % PageV01P391 البحر : بسيط تام 1(@)(@@) % خذ بالأشد إذا ما الشرع وافقه % % ولا تمل بك في أهوائك الرخص % 2(@)(@@) % ولا تكن كبني الدنيا ، رأيتهم % % إن أدبرت زهدوا أو أقبلت حرصوا % % PageV01P392 البحر : سريع 1(@)(@@) % وزاهد في المال لا ينثني % % في قمم العلياء عن حرصه % 2(@)(@@) % ليست ترى عيناه شبها له % % مبرا في الفضل من نقصه % 3(@)(@@) % كأنما العالم مرآته % فما يرى فيها سوى شخصه % PageV01P393 البحر : منسرح 1(@)(@@) % صحاتنا بالزمان أمراض % ودهرنا مبرم ونقاض % 2(@)(@@) % ولليالي في صرفها عبر % فهي سهام ونحن أغراض % PageV01P394 البحر : طويل 1(@)(@@) % ومرو صدى الروضات يسحب دائبا % على الأرض منه جملة تتبعض % 2(@)(@@) % إذا ما جرى واهتز للعين مزبدا % حسبت به فروا من النسر ينفض % 3(@)(@@) % وتنساب منه حية غير أنها % % تطول على قدر المساب وتعرض % 4(@)(@@) % وتحسبه إن حبكت متنه الصبا % % عمودا علاه النقش وهو مفضض % 5(@)(@@) % له رعدة تعتاده في انحداره % % كما تبسط الكف العنان وتقبض % 6(@)(@@) % كأن له في الجسم روحا إذا جرى % % به نهضة والجسم بالروح ينهض % 7(@)(@@) % وما هو إلا دمع عين كأنها % % لطول بكاء دهرها لا تغمض % 8(@)(@@) % إذا سرحت للسقي من كل جانب % رأيت بقاع الأرض منها تروض % % 9(@)(@@) % يقيم عليها الأنس ، والصبح مقبل % ويرحل عنها الوحش ، والليل معرض % % PageV01P395 البحر : متقارب تام 1(@)(@@) % ومن سفن القفر سباحة % من الآل بحرا إذا ما اعترض % 2(@)(@@) % لها شرة لا تبالي بها % % أطال لها سبسب أم عرض % 3(@)(@@) % إذا خفق البرد بي خلتني % % على كورها طائرا ينتفض % % 4(@)(@@) % وإن يعرض البعض من سيرها % % تر العيس من خلفها تنقرض % % 5(@)(@@) % فلو عوض المرء منها الصبا % % لما 
ms113	 رضيت نفسه بالعوض % % 6(@)(@@) % هي القوس ، إني لسهم لها % % أصيب بكل فلاة غرض % 7(@)(@@) % إذا انبسطت للسرى أيأست % سنا البرق مني أو تنقبض % 8(@)(@@) % وعذب الدموع دليل على % % بكاء تبسم برق ومض % 9(@)(@@) % كأني من البعد إذ شمته % جست بعرقي عرفا نبض % 10(@)(@@) % ترفع نحو ربوع الحمى % % وحل عزاليه وانخفض % PageV01P396 11(@)(@@) % وجاد على الترب من صوبه % بري الصدى وشفاء المرض % PageV01P397 البحر : وافر تام 1(@)(@@) % أيا خلج المدامع لا تغيضي % % وذوبي غير جامدة وفيضي % % 2(@)(@@) % فقد قلب التأسي بالرزايا % % أسى ملأ التراقي بالجريض % % 3(@)(@@) % أراك على الرحيل بأرض محل % فقير الرحل من زاد عريض % % 4(@)(@@) % فدع أشر الجموح وكن ذليلا % لعز الله كالعود المروض % 5(@)(@@) % فلست منعما بيدي حبيب % ولا بمعذب بيدي بغيض % % 6(@)(@@) % وأشقى الناس في الأخرى ابن دنيا % % يقول لنفسه في الغي خوضي % % 7(@)(@@) % أما شرحت له عبر الليالي % % معاني بعد ملتبس الغموض % % 8(@)(@@) % وناحت هذه الدنيا عليه % % فظن نياحها شدو القريض % % 9(@)(@@) % فلا يغتر بالحدثان غمر % لذيذ النوم في طرف غضيض % 10(@)(@@) % فقد يصمي الردى في الوكر فرخا % فيرتع منه في لحم غريض % % PageV01P398 11(@)(@@) % ويبلي غير مستبق حياة % لقشعم شاهق ميت النهوض % 12(@)(@@) % ويلحمه ابنه ما اختار نهسا % بمنسره المدمى من أنيض % 13(@)(@@) % وساعات الفتى سود وبيض % ترحل سود لمته ببيض % 14(@)(@@) % يذوق المرء في محياه موتا % جفوف الزهر في الروض الأريض % % 15(@)(@@) % وأشراك الردى في الغيب تخفى % % كما يخفين في ترب الحضيض % % 16(@)(@@) % عجبت لجمعه فيهن صيدا % % بها بين القشاعم والبعوض % % 17(@)(@@) % رأيت الخلق مرضى لا يداوى % % لهم كلب من الزمن العضوض % 18(@)(@@) % ولا آس لهم إلا مريض % فهل يجدي المريض على المريض % % 19(@)(@@) % يواصل فيهم فتك ابن آوى % % وهم في غفلة البهم الربيض % 20(@)(@@) % وما ينجو امرؤ من قبضتيه % % يدل يسبق منجرد قبيض % % PageV01P399 21(@)(@@) % وقالوا الزكرمي أذيق كأسا % يحول بها الجريض عن القريض % 22(@)(@@) % فقدتم في المعلى كبر حظ % له بالفائزين ندى مفيض % % 23(@)(@@) % يطير به جناح الطبع سبقا % من الإحسان في جو عريض % % 24(@)(@@) % ولو 
ms114	 مزجت حلاوته بنفط % لساغ وجل عن خصر الفضيض % % 25(@)(@@) % لقد عدم المعمى منه فكا % ومات لموته علم العروض % 26(@)(@@) % أبا حفص تركت بكل حزن % عليك الفضل ذا قلب مهيض % 27(@)(@@) % يروي الله تربا نمت فيه % % فباكي المزن مبتسم الوميض % % 28(@)(@@) % فقد أبقيت ألسنة البرايا % % بفخرك في حديث مستفيض % PageV01P400 البحر : كامل أحذ 1(@)(@@) % وابن السماء ينير مطلعه % فيسر مولده بني الأرض % 2(@)(@@) % فكأنه في أفقه ضلع % نحلت وقد عريت من النحض % PageV01P401 البحر : مخلع البسيط 1(@)(@@) % ولى شبابي وراع شيبي % % مني سرب المها وفضه % 2(@)(@@) % كأنما المشط في يميني % % تجر منه خيوط فضه % PageV01P402 البحر : طويل 1(@)(@@) % ومعرضة ولت تمد تجنبا % فصار خطاها عن مشيبي والوخط % % 2(@)(@@) % عسى للرضى في بعض خلقك رقية % مجربة يرقى بها خلق السخط % % 3(@)(@@) % عقيله حي لا ترى ذات بينهم % % تراع ببين من نواهم ولا شحط % % 4(@)(@@) % ترى ما ترى من بأسهم في عداتهم % % بأطراف بيض الهند والأسل الخطي % % 5(@)(@@) % أخاديد ضرب يحقر الشكل شكلها % % وآثار طعن يزدرين على السقط % % PageV01P403 البحر : طويل 1(@)(@@) % وثابتة الوقفين جوالة القرط % أصبت رشادي في هواها ولم أخطي % % 2(@)(@@) % إذا مشطت فرعا تفرع ليله % وطال من القينات فيه سرى المشط % % 3(@)(@@) % تقوم فيغشاها له بحر ظلمة % ترى قدما منها تقبل بالشط % % PageV01P404 البحر : طويل 1(@)(@@) % إذا كان في الكتب اتصال لقائنا % % فكل فراق موجع في انقطاعها % % 2(@)(@@) % وإن كانت الأيام مطبوعة على % % خلافي فقل من لي بنقل طباعها % % 3(@)(@@) % فلا تقطعوا عنا سطور رسالة % تمثل لي أشخاصكم في سماعها % % 4(@)(@@) % فلي كبد بالبين منكم تصدعت % وطول اغترابي زائد في انصداعها % % 5(@)(@@) % لأصبحت في الدنيا حريصا عليكم % ألا إن مثلي زاهد في متاعها % % PageV01P405 البحر : رجز تام 1(@)(@@) % حتى متى بين اللوى فالأجرع % لوما ، فما أمره في مسمعي % % 2(@)(@@) % ويحك لو كنت وفيا لم تقل : % ' ويحك لا تبك برسم بلقع ' % 3(@)(@@) % وهو الحمى سقيا لأيام الحمى % % فإنها ولت ولما ترجع % 4(@)(@@) % مالك لا تبكي بكاء بالأسى % % بين رسوم وبوالي أربع % 5(@)(@@) % بأدمع بين الجفون حوم % وأدمع 
ms115	 على الخدمد وقع % 6(@)(@@) % وزفرة موصولة بزفرة % تصعد عن نار حشى ملذع % % 7(@)(@@) % وقفت في الدار بعين لا ترى % % تغير الربع وأذن لا تعي % % 8(@)(@@) % ولوعة بالشوق غير لوعتي % % وأضلع في الوجد غير أضلعي % % 9(@)(@@) % وإنما يبكي بكائي شجنا % ووجع يعرف فيه وجعي % % 10(@)(@@) % لو أنطق المربع وهو أخرس % تضرع ، أنطقه تضرعي % % PageV01P406 11(@)(@@) % ووقعة ردت قيان ورقه % نوائحا بالحزن يبكين معي % % 12(@)(@@) % كأنها وما لها من أدمع % أعارها القطر سجال أدمعي % % 13(@)(@@) % يا منزلا تنشره يد البلى % % نشر يمان خلق لم يرقع % 14(@)(@@) % بالله خبرني أأنت ربعهم % أم أنت مرعى للظباء الرتع % % 15(@)(@@) % فقال : بل ربعهم وإنما % % تحملت عني شموس مطلعي % % 16(@)(@@) % أدرئة الغوط سترن ظبية % % تدير عيني فتنة في البرقع % % 17(@)(@@) % سيف وسهم لحظها ولهذم % يا عجبا لفتكها المنوع % % 18(@)(@@) % كأنما تبسم إن مازحتها % % عن برد بين بروق لمع % % 19(@)(@@) % كأقحوان روضة يصقله % مدوس شمس في الندى المميع % % 20(@)(@@) % كأن في فيها سلاف قهوة % صرف بماء ظلمها مشعشع % % PageV01P407 21(@)(@@) % إذا رضيع الكاس أصغى سحرا % إلى صفير الطائر المرجع % % 22(@)(@@) % خصت من الصوت بمعنى مؤيس % من لغة الوصل ولفظ مطمع % % 23(@)(@@) % ومهمه متصل بمهمة % مرت بمواج السراب مترع % % 24(@)(@@) % كأن منشور الملاء فوقه % % متى تمل ذكاء عنها ترفع % 25(@)(@@) % كأنما جندبه مرجع % نغمة شاد ذي لحون مسمع % % 26(@)(@@) % يذيب صم الصخر حر لاذع % يقبض فيه روح كل زعزع % % 27(@)(@@) % لكل غار فيها ماء ، وشوى % % فيه أوار الشمس كل ضفدع % % 28(@)(@@) % لا نار تذكى في الدجى لسفره % إلا بريق مقلة السمعمع % 29(@)(@@) % تعسل منه جانباه إن عدا % % مثل اضطراب السمهري المشرع % % 30(@)(@@) % يقفو راذيا جنحا في السير لا % % لا توضع عنهن سياط المزمع % % PageV01P408 31(@)(@@) % يصك منها دأيات دملت % % فهي بشم الأنف فيها ترتعي % % 32(@)(@@) % وذات أخفاف سرت أربعها % % منتعلات بالرياح الأربع % % 33(@)(@@) % كأنها وللنجاة ما نجت % % منهوشة بين أفاع لسع % % 34(@)(@@) % تحدى بسحر ساهر في نغضة % شهم الجنان لوذعي ألمعي % % 35(@)(@@) % والشهب كالشهب لسبق أرسلت % لمغرب فيه أفول المطلع % 36(@)(@@) % كأنها 
ms116	 واضعة خدودها % % لهجعة فيه وإن لم تهجع % PageV01P409 البحر : طويل 1(@)(@@) % ومحسودة لا تحسد الغيد مثلها % % لها في عميم الخلق حسن منوع % 2(@)(@@) % إذا انعطفت فالحوط بالبدر ينثني % % وإن نظرت فالعين بالسحر تنبع % % 3(@)(@@) % ولما تلاقينا تكلم مقول % بسر الهوى منها ، ومني مدمع % % 4(@)(@@) % بدرين مستورين فالدر منهما % % يرى جاربا بالشوق واللفظ يسمع % % 5(@)(@@) % شكوت ونطق بيننا فلأينا % % ببرح الجوى في مذهب الحكم يقطع % % 6(@)(@@) % ومالت إلى تأنيسنا بعد وحشة % بأجوف لم تخلق لجنبيه أضلع % % 7(@)(@@) % تمد إلى تنغيمه سبط أنمل % كأقلام در بالعقيق تقمع % % 8(@)(@@) % إذا وتر هزته بالنقر خلته % يئن من الآلام أو يتضرع % 9(@)(@@) % وينبض كالشريان إن عبثت به % % وجسته منها باللطافة إصبع % % 10(@)(@@) % عوامل سحر في عوامل أنمل % بها يخفض القلب الطروب ويرفع % PageV01P410 البحر : طويل 1(@)(@@) % ولما رأت طير الفراق نواعبا % وقد هم بالتوديع كل مودع % % 2(@)(@@) % شكت ما شكا المحزون من عزمة النوى % % فأبكت لها عيني غزال مروع % % 3(@)(@@) % ولم أر في خد يزرر قبلها % % من الغيد شهبا في غمامة برقع % % 4(@)(@@) % وقد سفرت عن صفرة عبر الأسى % % لعيني بها عن وجد قلب مفجع % % 5(@)(@@) % وأقبل در النحر فوق تريبها % % يصافحه من خدها در أدمع % % 6(@)(@@) % فيا رب إن البين أضحت صروفه % % علي وما لي من معين فكن معي % % 7(@)(@@) % على قرب عذالي وبعد حبائبي % % وأمواه أجفاني ونيران أضلعي % % PageV01P411 البحر : خفيف تام 1(@)(@@) % كل يوم مودع أو مودع % بفراق من الزمان متنوع % 2(@)(@@) % فانقطاع الوصال كم يتمادى % % وحصاة الفؤاد كم تتصدع % 3(@)(@@) % ليت شعري هل أرتدي بظلام % لا يراني الضياء فيه مروع % 4(@)(@@) % بحداء من واصف البين غاد % ونعيب من حالك اللون أبقع % % 5(@)(@@) % فبنار الأسى يحرق قلب % وبماء الهوى يغرق مدمع % 6(@)(@@) % هذه عادة الليالي فلمها % % وهي لا تسمع الملامة ، أو دع % 7(@)(@@) % تطعن الحي فالجسوم بواق % في يد السقم والنفوس تشيع % % 8(@)(@@) % وكأن الحسان زودن صبري % % فهو بالبين بينه نيوزع % % 9(@)(@@) % كل نمامة الرياح تلاقي % % منه أنفاس روضة تتضوع % % 10(@)(@@) % يلمع الماء في سنا 
ms117	 الخد منها % % فكأن الرحيق منه يشعشع % % PageV01P412 11(@)(@@) % تنتحي بالأراك ثغر أقاح % للندى فيه ريقة تتميع % % 12(@)(@@) % نصلت في القوام باللحظ منها % % صعدة في يد الملاحة تشرع % 13(@)(@@) % تجرح القلب ، والأديم صحيح % فعن السحر منه حدثت فاسمع % % 14(@)(@@) % قف وقوف الحيا بدمنة ربع % ضيع الدمع فيه رسم مضيع % % 15(@)(@@) % دارس لا تزال غبر السوافي % % تفرق الترب فيه ثمت تجمع % % 16(@)(@@) % كم به من سوانح في المغاني % % آمنات من نبأة الخوف ترتع % 17(@)(@@) % وظباء كأنهن دماه ، % حين ترنو ، لو أنها تتبرقع % 18(@)(@@) % وحبيس على الفلا زمخري % خاضب أفتخ الجناحين أقزع % 19(@)(@@) % رافع في الهواء طولى عليها % % عنق كاللواء في الجيش يرفع % 20(@)(@@) % تحسب العين رجله نصب رحل % % أصلم ليت أنه كان أجدع % PageV01P413 21(@)(@@) % إن ثوب الصبا يمزق مني % % ما الذي بالخضاب منه يرقع % 22(@)(@@) % فعصتني الفناة كيدا وكانت % في الهوى من يدي إلى الفم أطوع % 23(@)(@@) % أنبت الدهر في المفارق شيبا % بهموم في مضمر القلب يزرع % % 24(@)(@@) % وابتدا والنوى بيمناه تبدي % % صورة الماء في السراب ، فتخدع % % 25(@)(@@) % بشمال تثني عليها جنوبا % بهبوب ، يقلقل الكور زعزع % % 26(@)(@@) % كلما أمرعت ببقل جفال % قلت بالحمر من حمى القيظ تلذع % 27(@)(@@) % حيث أذكت ذكاء فيها أوارا % % يلفح الوجه في اللثام فيسفع % 28(@)(@@) % وإذا ما لمست جدول ماء % خلته حية من الحر تلسع % 29(@)(@@) % أنا نبع لا خروع عند عمري % % وأرى العود منه نبع وخروع % % 30(@)(@@) % لست أثني عن السرى في طريق % خيم الليل فوقه وهو خيدع % % PageV01P414 31(@)(@@) % فكأني خلقت جواب أرض % أصل العزم حشوها وهي تقطع % 32(@)(@@) % وكأني في مقول من زماني % % مثل وافد على كل مسمع % % PageV01P415 البحر : طويل 1(@)(@@) % أيا جزعي بالدار إذ عن لي الجزع % وقاد حمامي من حمائمه السجع % 2(@)(@@) % وعاودني فيها رداعي ولم أشم % ترائب عواد يضمخها الردع % 3(@)(@@) % وقفت بها والنفس من كل مقلة % تذوب بنار في الضلوع لها لذع % 4(@)(@@) % مطلا مطيل النوح لو أن دمنة % لها بصر تحت الحوادث أو سمع % 5(@)(@@) % طلول عقت آياتها فكأنما % % غرابيبها جزع وأدمانها 
ms118	 ودع % 6(@)(@@) % حكى الربع منها بالصدى إذ سألته % كلامي حتى قيل هل يمزح الربع % % 7(@)(@@) % تخط مع المحل الجنوب بمحوها % % سطور البلى فيها وتعجبها المسع % 8(@)(@@) % ولم يبق إلا ملعب يبعث الأسى % % ويدعو الفتى منه إلى الشوق ما يدعو % % 9(@)(@@) % ومجموعة جمع الثلاث ولم تزد % عليه صوالي النار أوجهها سفع % % 10(@)(@@) % لبسن حداد الثكل وهي مقيمة % على ميت نار لا يفارقها فجع % % PageV01P416 11(@)(@@) % ومضروبة بين الرسوم وما جنت % عقاب النوى من هامها الضرب والقلع % 12(@)(@@) % ومحلولك ما فك زيجا ولا له % % بسر قضاء النجم علم ولا طبع % 13(@)(@@) % أبان لنا عن بيننا فلسانه % % علينا له قطع أتيح له القطع % % 14(@)(@@) % إذا لم تكن للحي دارا فما لها % % إذا وقف المشتاق فيها جرى الدمع % % 15(@)(@@) % ليالي عودي يكتسي ورق الصبا % % وإذ أنا إلف للجآذر لا سمع % % 16(@)(@@) % وينبو عن اللوم المعنف مسمعي % % بمن حسنها بين الحسان له سمع % 17(@)(@@) % فتاة لها في النفس أصل من الهوى % % وكل هوى في النفس من غيرها بدع % % 18(@)(@@) % وتبلغ بنت الكرم من فرح الفتى % % بلذتها ما ليس يبلغه البتع % % 19(@)(@@) % يصد الهوى عن قطف رمان صدرها % % وإن راق في خوط القوام له ينع % % 20(@)(@@) % وكم من قطوف دانيات ودونها % % تعرض أشراع من الرمح أو شرع % % PageV01P417 21(@)(@@) % تريك جبينا يخجل الشمس هيبة % وخلقا عميما في الشباب له جمع % % 22(@)(@@) % وتبسم في جنح الدجى وهو عابس % فيضحك منها عن بروق لها لمع % % 23(@)(@@) % وبيد أبادت عيسنا بيبابها % % فهن غراث في عجاف لها رتع % % 24(@)(@@) % إذا سمع الحادي بها السمع ظنه % كريما على نشز لمأدبة يدعو % % 25(@)(@@) % فكم من هزيل في اقتفاء هزيلة % ليأكل منها فضل ما أكل السبع % % 26(@)(@@) % فإن يهلك الإيحاف حرفا بمهمه % % فإنهما السيف المجرد والنطع % 27(@)(@@) % نحوت عليها كل حرف بعامل % من العزم مخصوص به الخفض والرفع % % 28(@)(@@) % وعاركت دهري في عريكة بازل % ينوء به هاد كما انتصب الجذع % % 29(@)(@@) % وما خار عودي عند غمز ملمة % وهل خار عند الغمز في يدك النبع % % 30 
ms119	(@)(@@) % وملتحف بالصقل من لمع بارق % يطير فراش الهام من حده القرع % PageV01P418 31(@)(@@) % أقام مع الأحقاب حتى كأنما % % لحديه عنه من حوادثها دفع % 32(@)(@@) % وتحسب أهوال الحروب لشيبه % وكل خضاب في ذوائبه ردع % 33(@)(@@) % إذا سل واهتزت مضاربه حكى % % أخا السل هزته بأفكلها الربع % 34(@)(@@) % وتحسر منه أنفس هلكت به % % فما صارم في الأرض من غمده سقع % % 35(@)(@@) % أأذكى عليه القين بالريح ناره % وأمكنه في الطبع بينهما طبع % % 36(@)(@@) % أصاعقة منقضة من غراره % % يهولك في هام الرواسي لها صدع % 37(@)(@@) % وجامدة فاضت فقلنا تعجبا % أنهر تمشت فوقه الريح أو درع % % 38(@)(@@) % وأحكمها داود عن وحي ربه % بلطف يد ، قاسي الحديد لها شمع % 39(@)(@@) % ترى الحلقات الجعد منها حبائكا % مسمرة فيها مساميرها القرع % % 40(@)(@@) % سرابية المرأى وإن لم يرد بها % % على الذمر طعن يتقيه ولا مصع % % PageV01P419 41(@)(@@) % وعذراء يغشاها ذكور أسنة % وتثنى لجمع كلما افترق الجمع % % 42(@)(@@) % ومنجرد كالسيد يعمل أرضه % فيبني سماء فوقه سمكها النقع % % 43(@)(@@) % متى يمنع الجري الجياد من الونى % % ففي يده بذل من الجري لا منع % % 44(@)(@@) % له بصر مستخرج خبء ليلة % إذا الحس أهداه إلى قلبه السمع % % 45(@)(@@) % ويمرق بي في السبق في كل حلبة % فتحسبه سهما يطير به النزع % % 46(@)(@@) % برأيي وعزمي أكمل الله صبغتي % % ولولا الحيا والشمس ما كمل الزرع % % PageV01P420 البحر : طويل 1(@)(@@) % ونورية للنار فيها ذؤابة % تذوب بها ذوب النضار المميع % % 2(@)(@@) % تنوب مناب الشمس بعد غروبها % % إذا بزغت كالشمس في رأس مطلع % % 3(@)(@@) % تكتم ما تلقاه إلا شكية % تعبر عنها في إشارة إصبع % % 4(@)(@@) % وتحسبها تلقي ضروبا من الجوى % % تحكم فيها من غرامي المنوع % % 5(@)(@@) % كسقمي وإيراقي وصبري وموقفي % % وصمتي وإطراقي ولوني وأدمعي % % PageV01P421 البحر : بسيط تام 1(@)(@@) % وأخضر حصلت نفسي به ونجت % وما تفارق منه روعة روعي % % 2(@)(@@) % رغا وأزبد والنكباء تغضبه % كما تعبث شيطان بمصروع % PageV01P422 البحر : بسيط تام 1(@)(@@) % سر تحظ باليسر إن كابدت في أفق % عسرا فقد يجد الدرياق من لسعا % % 2(@)(@@) % وربما ضاق رزق المرء في بلد % حتى إذا سار 
ms120	 عنه در واتسعا % % PageV01P423 البحر : طويل 1(@)(@@) % مرابعهم للوحش أضحت مراتعا % % فقف صابرا تسعد على الحزن جازعا % % 2(@)(@@) % فمن مبلغ الغادين عنا بأننا % % وقفنا واجرينا بهن المدامعا % % 3(@)(@@) % معالم أضحت من دماها عواطلا % فقل في نفوس قد هجرن المطامعا % % 4(@)(@@) % وفينا بمثياق العهود لربعها % % كأن عهود الربع كانت شرائعا % % 5(@)(@@) % فمن دمنة تحت القطوب كمينة % بها وثلاث راكدات سوافعا % % 6(@)(@@) % ومن خط رمس دارس فكأنما % % أمر البلى محوا عليها الأصابعا % % 7(@)(@@) % تأوه منه شيق الركب نائحا % فطرب فيه ملغط الطير ساجعا % % 8(@)(@@) % وما زلت أجري الدمع من حرق الأسى % % وأدعو هوى الأحباب لو كان سامعا % % 9(@)(@@) % وأفحص عن آثارهم ترب أرضهم % % كأني قد أودعت فيها ودائعا % % 10(@)(@@) % كأن حصاة القلب كانت زجاجة % مقارعة من لاعج الشوق صادعا % % PageV01P424 11(@)(@@) % أمات ربوع الدار فقدان أهلها % % فأبصرت منها الآهلات بلاقعا % % 12(@)(@@) % كأن حداء العيس في السير نعيها % % وقد سقيت سما من البين ناقعا % % 13(@)(@@) % أدار البلى ولى الصبا عنك لاهيا % فمن لي بأن ألقى الصبا فيك راجعا % % 14(@)(@@) % أما ولبان در لي أسحم به % % ومن كان أهلي بودي مراضعا % % 15(@)(@@) % لقد دخلت بي منك في الحزن لوعة % حرمت بها من ذمة الصبر راجعا % % 16(@)(@@) % أيا هذه إن العلى لتهز بي % % حساما على صرف الحوادث قاطعا % % 17(@)(@@) % ذويني أكن للعزم والليل والسرى % % وللحرب والبيداء والنجم سابعا % % PageV01P425 البحر : كامل تام 1(@)(@@) % بك يا صبور القلب هام جزوعه % أوكل شيء من هواك يروعه % % 2(@)(@@) % فإذا وصلت خشيت منك قطيعة % فالعيش أنت وصوله وقطوعه % 3(@)(@@) % لا تتهمني في الوفاء فإنني % % كتمت سرك والدموع تذيعه % 4(@)(@@) % نقل الهوى قلبي إلى عيني التي % % منها تفجر بالبكا ينبوعه % % 5(@)(@@) % أبكيتني فأذعت سرك مكرها % فعلام تعذلني وأنت تذيعه % 6(@)(@@) % قال العذول : لقد خضغت لحبه % % فأحببته . عز المحب خضوعه % 7(@)(@@) % أقصر فما يجتث أصل علاقة % جذبت بأطراف الملام فروعه % % 8(@)(@@) % وكأن لومك رافضي ميت % وكأن سمعي إذ نعاه بقيعه % 9(@)(@@) % يا من لذي أرق يطول نزاعه % شوقا إلى من طال عنه نزوعه % 10 