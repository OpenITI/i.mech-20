ms421	 ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4005 ) قال النبي : $ 30 ( اللهم ارحم خلفائي الذين يأتون من بعدي الذين يروون أحاديثي وسنتي ويعلمونها الناس ) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4006 ) قال النبي :(@)(@@) | 30 ( اللهم ارزقني حبك وحب من ينفعني حبه عندك ، اللهم ما رزقتني مما أحب فاجعله قوة لي فيما تحب ، اللهم وما زويت عني مما أحب فاجعله فراغا لي فيما تحب ) )(@)(@@) ( ت ) عن عبد الله بن يزيد الخطمي رضي الله عنه .(@)(@@) PageV02P075(@)(@@)(@@)(@@) $ ( 4007 ) قال النبي :(@)(@@) | 30 ( اللهم ارزقني عينين هطالتين تشفيان القلب بذروف الدموع من خشيتك قبل أن تكون الدموع دما والأضراس جمرا ) )(@)(@@) ( ابن عساكر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4008 ) قال النبي :(@)(@@) | 30 ( اللهم استر عورتي وآمن روعتي واقض عني ديني ) )(@)(@@) ( طب ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4009 ) قال النبي :(@)(@@) | 30 ( اللهم أصلح ذات بيننا ، وألف بين قلوبنا واهدنا سبيل السلام ، ونجنا من الظلمات إلى النور ، وجنبنا الفواحح ما ظهر منها وما بطن ، اللهم بارك لنا في أسماعنا وأبصارنا وقلوبنا وأزواجنا وذرياتنا وتب علينا إنك أنت التواب الرحيم ، واجعلنا شاكرين لنعمتك مثنين بها قابلين لها وأتمها علينا ) )(@)(@@) ( طب ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4010 ) قال النبي :(@)(@@) | 30 ( اللهم أصلح لي ديني الذي هو عصمة أمري ، وأصلح لي دنياي التي فيها معاشي ، وأصلح لي آخرتي التي فيها معادي ، واجعل الحياة زيادة لي في كل خير ، واجعل الموت راحة لي من كل شر ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4011 ) قال النبي :(@)(@@) | 30 ( اللهم اعف عني فإنك عفو كريم ) )(@)(@@) ( طس ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4012 ) قال النبي :(@)(@@) | 30 ( اللهم أعني على غمرات الموت وسكرات الموت ) )(@)(@@) ( ت ه ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4013 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للحاج ولمن استغفر له الحاج ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4014 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للمتسرولات من أمتي ) )(@)(@@) ( البيهقي في الأدب ) عن علي رضي الله عنه .(@)(@@) PageV02P076(@)(@@)(@@)(@@) $ ( 4015 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي 
ms422	 خطيئتي وجهلي وإسرافي في أمري وما أنت أعلم به مني ، اللهم اغفر لي خطئي وعمدي وهزلي وجدي وكل ذالك عندي ، اللهم اغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت ، أنت المقدم وأنت المؤخر وأنت على كل شيء قدير ) )(@)(@@) ( ق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4016 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنبي ، ووسع لي في داري ، وبارك لي في رزقي ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4017 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنوبي وخطاياي كلها ، اللهم أنعشني واجبرني واهدني لصالح الأعمال والأخلاق فإنه لا يهدي لصالحها ولا يصرف سيئها إلا أنت ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4018 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي وارحمني وألحقني بالرفيق الأعلى ) )(@)(@@) ( ق ت ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4019 ) قال النبي :(@)(@@) | 30 ( اللهم أغنني بالعلم ، وزيني بالحلم ، وأكرمني بالتقوى ، وجملني بالعافية ) )(@)(@@) ( ابن النجار ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4020 ) قال النبي :(@)(@@) | 30 ( اللهم افتح مسامع قلبي لذكرك ، وارزقني طاعتك وطاعة رسولك وعملا بكتابك ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4021 ) قال النبي :(@)(@@) | 30 ( اللهم اقسم لنا من خشيتك ما يحول بيننا وبين معاصيك ، ومن طاعتك ما تبلغنا به جنتك ، ومن اليقين ما يهون علينا مصيبات الدنيا ، ومتعنا بأسماعنا وأبصارنا وقوتنا ما أحييتنا واجعله الوارث منا ، واجعحل ثأرنا على من ظلمنا ، وانصرنا على من عادانا ، ولا تجعل مصيبتنا في ديننا ، ولا تجعل الدنيا أكبر همنا ولا مبلغ علمنا ، ولا تسلط علينا من لا يرحمنا ) )(@)(@@) ( ت ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4022 ) قال النبي :(@)(@@) | 30 ( اللهم الطف بي في تيسير كل عسير ، فإن تيسير كل PageV02P077 عسير عليك يسير ، وأسألك اليسر والمعافاة في الدنيا والآخرة ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4023 ) قال النبي :(@)(@@) | 30 ( اللهم إليك أشكو ضعف قوتي وقلة حيلتي وهواني على الناس ، يا أرحم الراحمين ، إلى من تكلني ؟ إلى عدو يتجهمني أم إلى قريب ملكته أمري ، إن لم تكن ساخطا علي فلا 
ms423	 أبالي غير أن عافيتك أوسع لي ، أعوذ بنور وجهك الكريم الذي أضاءت له السماوات والأرض وأشرقت له الظلمات ، وصلح عليه أمر الدنيا والآخرة أن تحل علي غضبك ، أو تنزل علي سخطك ، ولك العتبى حتى ترضى ولا حول ولا قوة إلا بك ) )(@)(@@) ( طب ) عن عبد الله بن جعفر رضي الله عنه قال ابن عباس رضي الله عنه كان هذا دعاء رسول الله في حجة الوداع عشية عرفة .(@)(@@)(@@)(@@) $ ( 4024 ) قال النبي :(@)(@@) | 30 ( اللهم أمتعني بسمعي وبصري حتى تجعلهما الوارث مني ، وعافني في ديني وفي جسدي ، وانصرني ممن ظلمني حتى تريني فيه ثأري ، اللهم إني أسلمت نفسي إليك وفوضت أمري إليك ، وألجأت ظهري إليك ، وخليت وجهي إليك لا ملجأ ولا منجى منك إلا إليك ، آمنت برسولك الذي أرسلت ، وبكتابك الذي أنزلت ) )(@)(@@) ( ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4025 ) قال النبي :(@)(@@) | 30 ( اللهم أنت خلقت نفسي وأنت توفاها ، لك مماتها ومحياها ، إن أحييتها فاحفظها ، وإن أمتها فاغفر لها ، اللهم إني أسألك العافية ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4026 ) قال النبي :(@)(@@) | 30 ( اللهم انفعني بما علمتني وعلمني ما ينفعني وزدني علما ، الحمد لله على كل حال وأعوذ بالله من حال أهل النار ) )(@)(@@) ( ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4027 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم حرم مكة فجعلها حراما ، وإني حرمت المدينة ما بين مأزميها أن لا يراق فيها دم ولا يحمل فيها سلاح لقتال ، ولا PageV02P078 يخبط فيها شجرة إلا لعلف ، اللهم بارك لنا في مدينتنا ، اللهم بارك لنا في صاعنا ، اللهم بارك لنا في مدنا ، اللهم اجعل مع البركة بركتين ، والذي نفسي بيده ما من المدينة شعب ولا نقب إلا عليه ملكان يحرسانها حتى تقدموا إليها ) )(@)(@@) ( م ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4028 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم كان عبدك وخليلك دعاك لأهل مكة بالبركة وأنا محمد عبدك ورسولك أدعوك لأهل المدينة أن تبارك لهم في مدهم وصاعهم مثلي ما باركت لأهل مكة مع البركة بركتين ) )(@)(@@) ( ت ) عن 
ms424	 علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4029 ) قال النبي :(@)(@@) | 30 ( اللهم إنا نسألك موجبات رحمتك وعزائم مغفرتك والسلامة من كل إثم ، والغنيمة من كل بر ، والفوز بالجنة ، والنجاة من النار ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4030 ) قال النبي :(@)(@@) | 30 ( اللهم إن قلوبنا وجوارحنا بيدك لم تملكنا منها شيئا فإذا فعلت ذالك بنا فكن أنت ولينا ) )(@)(@@) ( حل ) عن ججابر رضي الله عنه .(@)(@@)(@@)(@@) $ 4031 قال النبي :(@)(@@) | 30 ( اللهم إنك تسمع كلامي وترى مكاني وتعلم سري وعلانيتي ، لا يحفى عليك شيء من أمري ، وأنا البائس الفقير المستغيث المستجير الوجل المشفق المقر المعترف بذنبه ، أسألك مسألة المسكين ، وأبتهل إليك ابتهال المذنب الذليل ، وأدعوك دعاء الخائف الضرير ، من خضعت لك رقبته ، وفاضت لك عبرته ، وذل لك جسمه ، ورغم لك أنقه ، اللهم لا تجعلني بدعائك شقيا ، وكن بي رؤوفا رحيما يا خير المسؤولين ويا خير المعطين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4032 ) قال النبي :(@)(@@) | 30 ( اللهم إنك سألتنا من أنفسنا ما لا نملكه إلا بك ، اللهم فأعطنا منها ما يرضيك عنا ) )(@)(@@) ( ابن عساكر ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P079(@)(@@)(@@)(@@) $ ( 4033 ) قال النبي :(@)(@@) | 30 ( اللهم إنك لست بإلاه استحدثناه ولا برب ابتدعناه ، ولا كان لنا قبلك من إلاه نلجا إليه ونذرك ، ولا أعانك على خلقنا أحد فنشركه فيك تباركت وتعاليت ) )(@)(@@) ( طب ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4034 ) قال النبي :(@)(@@) | 30 ( اللهم إني أتخذ عندك عهدا لن تخلفنيه فإنما أنا بشر ، فأيما مؤمن آذيته أو شتمته أو جلدته أو لعنته فاجعلها له صلاة وزكاة وقربة تقربه بها إليك يوم القيامة ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4035 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك التوفيق لمحابك من الأعمال ، وصدق التوكل عليك ، وحسن الظن بك ) )(@)(@@) ( حل ) عن الأوزاعي مرسلا ( الحكيم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4036 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك الثبات في الأمر ، وأسألك عزيمة الرشد ، وأسألك شكر نعمتك ، وحسن عبادتك ، وأسألك لسانا صادقا ، وقلبا سليما ، وأعوذ بك من شر ما تعلم ، وأسألك من 
ms425	 خير ما تعلم ، وأستغفرك مما تعلم إنك أنت علام الغيوب ) )(@)(@@) ( ت ن ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4037 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك الصحة والعفة والأمانة وحسن الخلق والرضا بالقدر ) )(@)(@@) ( البزار طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4038 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك العفة والعافية في دنياي وديني وأهلي ومالي ، اللهم استر عورتي ، وآمن روعتي ، واحفظني من بين يدي ومن خلفي وعن يميني وعن شمالي ومن فوقي ، وأعوذ بك أن أغتال من تحتي ) )(@)(@@) ( البزار ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4039 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك الهدى والتقى والعفاف والغنى ) )(@)(@@) ( م ت ه ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4040 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك إيمانا يباشر قلبي حتى أعلم أنه لا PageV02P080 يصيبني إلا ما كتبت لي ، ورضني من المعيشة بما قسمت لي ) )(@)(@@) ( البزار ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4041 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك باسمك الطاهر الطيب المبارك الأحب إليك ، الذي إذا دعيت به أجبت ، وإذا سئلت به أعطيت ، وإذا استرحمت به رحمت ، وإذا استفرجت به فرجت ) )(@)(@@) ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4042 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك رحمة من عندك تهدي بها قلبي ، وتجمع بها أمري ، وتلم بها شعثي ، وتصلح بها غائبي ، وترفع بها شاهدي ، وتزكي بها عملي ، وتلهمني بها رشدي ، وترد بها ألفتي ، وتعصمني بها من كل سوء ، اللهم أعطني إيمانا ويقينا ليس بعده كفر ، ورحمة أنال بها شرف كرامتك في الدنيا والآخرة ، اللهم إني أسألك الفوز في القضاء ونزل الشهداء وعيي السعداء والنصر على الأعداء ، اللهم إني أنزل بك حاجتي ، فإن قصر رأيي وضعف عملي افتقرت إلى رحمتك ، فأسألك يا قاضي الأمور ، ويا شافي الصدور كما تجير بين البحور ، أن تجيرني من عذاب السعير ، ومن دعوة الثبور ، ومن فتنة القبور ، اللهم ما قصر عنه رأيي ولم تبلغه نيتي ، ولم تبلغه مسألتي من خير وعدته أحدا من خلقك ، أو خير أنت معطيه أحدا من عبادك ، فإني 
ms426	 أرغب إليك فيه ، وأسألك برحمتك يا رب العالمين ، اللهم يا ذا الحبل الشديد والأمر الرشيد أسألك الأمن يوم الوعيد ، والجنة يوم الخلود مع المقربين الشهود ، الركع السجود الموفين بالعهود إنك رحيم ودود ، وإنك تفعل ما تريد ، اللهم اجعلنا هادين مهتدين غير ضالين ولا مضلين ، سلما لأوليائك وعدوا لأعدائك ، نحب بحبك من أحبك ، ونعادي بعدواتك من خالفك ، اللهم هاذا الدعاء وعليك الإجابة ، وهاذا الجهد وعليك التكلان ، اللهم اجعل لي نورا في قلبي ، ونورا في قبري ، ونورا بين يدي ، ونورا من خلفي ، ونورا عن يميني ، ونورا عن شمالي ، ونورا من فوقي ، ونورا من تحتي ، ونورا في سمعي ، ونورا في بصري ، ونورا في شعري ، ونورا في بشري ، ونورا في لحمي ، PageV02P081 ونورا في دمي ، ونورا في عظامي ، اللهم أعظم لي نورا ، وأعطني نورا ، واجعل لي نورا ، سبحان الذي تعطف بالعز وقال به ، سبحان الذي لبس المجد وتكرم به ، سبحان الذي لا ينبغي التسبيح إلا له ، سبحان ذي الفضل والنعم ، سبحان ذي المجد والكرم ، سبحان ذي الجلال والإكرام ) )(@)(@@) ( ت ) و محمد بن نصر في الصلاة ( طب ) والبيهقي في الدعوات عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4043 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك صحة في إيمان ، وإيمانا في حسن خلق ، ونجاحا يتبعه فلاح ، ورحمة منك وعافية ، ومغفرة منك ورضوانا ) )(@)(@@) ( طس ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4044 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك عيشة نقية وميتة سوية ، ومردا غير مخزي ولا فاضح ) )(@)(@@) ( البزار طب ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4045 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك غناي وغنى مولاي ) )(@)(@@) ( طب ) عن أبي صرمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4046 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك من الخير كله عاجله وآجله ما علمت منه وما لم أعلم ، وأعوذ بك من الشر كله عاجله وآجله ما علمت منه وما لم أعلم ، اللهم إني أسألك من خير ما سألك به عبدك ونبيك ، وأعوذ بك من شر ما عاذ به عبدك ونبيك ، اللهم إني أسألك الجنة وما قرب إليها 
ms427	 من قول أو عمل ، وأعوذ بك من النار وما قرب إليها من قول أو عمل ، وأسألك أن تجعل كل قضاء قضيته لي خيرا ) )(@)(@@) ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4047 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك من الخير كله ما علمت منه وما لم أعلم ، وأعوذ بك من الشر كله ما علمت منه وما لم أعلم ) )(@)(@@) ( الطيالسي طب ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4048 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك من فضلك ورحمتك فإنه لا PageV02P082 يملكهما إلا أنت ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4049 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك وأتوجه إليك بنبيك محمد نبي الرحمة ، يا محمد إني توجهت بك إلى ربي في حاجتي هاذه لتقضى لي ، اللهم فشفعه في ) )(@)(@@) ( ت ه ك ) عن عثمان بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4050 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ برضاك من سخطك ، وبمعافاتك من عقوبتك ، وأعوذ بك منك لا أحصي ثناء عليك أنت كما أثنيت على نفسك ) )(@)(@@) ( م 4 ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4051 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من البرص والجنون والجذام ومن سيىء الأسقام ) )(@)(@@) ( حم د ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4052 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من التردي والهدم والغرق والحرق ، وأعوذ بك أن يتخبطني الشيطان عند الموت ، وأعوذ بك أن أموت في سبيلك مدبرا ، وأعوذ بك أن أموت لديغا ) )(@)(@@) ( ن ك ) عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4053 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الجوع فإنه بئس الضجيع ، وأعوذ بك من الخيانة فإنها بئست البطانة ) )(@)(@@) ( د ن ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4054 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الشقاق والنفاق وسوء الأخلاق ) )(@)(@@) ( د ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4055 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من العجز والكسل والجبن والبخل والهرم ، وأعوذ بك من عذاب القبر ، وأعوذ بك من عذاب النار ، وأعوذ بك من فتنة المحيا والممات 
ms428	 ) )(@)(@@) ( حم ق 3 ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4056 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من العجز والكسل ، والجبن PageV02P083 والبخل ، والهرم والقسوة ، والغفلة والعيلة ، والذلة والمسكنة ، وأعوذ بك من الفقر والكفر ، والفسوق والشقاق والنفاق ، والسمعة والرياء ، وأعوذ بك من الصمم والبكم ، والجنون والجذام ، والبرص وسيىء الأسقام ) )(@)(@@) ( ك والبيهقي في الدعاء ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4057 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من العجز والكسل ، والجبن والبخل ، والهرم وعذاب القبر وفتنة الدجال ، اللهم آت نفسي تقواها ، وزكها أنت خير من زكاها ، أنت وليها ومولاها ، اللهم إني أعوذ بك من علم لا ينفع ، ومن قلب لا يخشع ، ومن نفس لا تشبع ، ومن دعوة لا يستجاب لها ) )(@)(@@) ( حم ) و عبد بن حميد ( م ن ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4058 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الفقر والقلة والذلة ، وأعوذ بك من أن أظلم أو أظلم ) )(@)(@@) ( د ن ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4059 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الكسل والهرم ، والمأثم والمغرم ، ومن فتنة القبر وعذاب القبر ، ومن فتنة النار وعذاب النار ومن شر فتنة الغنى ، وأعوذ بك من فتنة الفقر ، وأعوذ بك من فتنة المسيح الدجال ، اللهم اغسل عني خطاياي بالماء والثلج والبرد ، ونق قلبي من الخطايا كما ينقى الثوب الأبيض من الدنس ، وباعد بيني وبين خطاياي كما باعدت بين المشرق والمغرب ) )(@)(@@) ( ق ت ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4060 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الهم والحزن ، والعجز والكسل ، والبخل والجبن ، وضلع الدين وغلبة الرجال ) )(@)(@@) ( حم ( 2 ) ق 3 ) عن أنس رضي الله عنه .(@)(@@) PageV02P084(@)(@@)(@@)(@@) $ ( 4061 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من جار السوء في دار المقامة ، فإن جار البادية يتحول ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4062 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من خليل ماكر ، عيناه ترياني وقلبه يرعاني ، إن رأى حسنة دفنها ، وإن رأى سيئة أذاعها ) )(@)(@@) ( ابن 
ms429	 النجار ) عن سعيد المقبري مرسلا .(@)(@@)(@@)(@@) $ ( 4063 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من زوال نعمتك ، وتحول عافيتك ، وفجأة نقمتك ، وجميع سخطك ) )(@)(@@) ( م د ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4064 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر الأعميين : السيل والبعير الصؤول ) )(@)(@@) ( طب ) عن عائشة بنت قدامة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4065 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر سمعي ، ومن شر بصري ، ومن شر لساني ، ومن شر قلبي ، ومن شر منيي ) )(@)(@@) ( د ك ) عن شكل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4066 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر ما عملت ومن شر ما لم أعمل ) )(@)(@@) ( م د ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4067 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من عذاب القبر ، وأعوذ بك من عذاب النار ، وأعوذ بك من فتنة المحيا والممات ، وأعوذ بك من فتنة المسيح الدجال ) )(@)(@@) ( خ ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4068 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من علم لا ينفع ، وعمل لا يرفع ، ودعاء لا يسمع ) )(@)(@@) ( حم حب ك ) عن أنس رضي الله عنه .(@)(@@) PageV02P085(@)(@@)(@@)(@@) $ ( 4069 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من علم لا ينفع ، وقلب لا يخشع ، ودعاء لا يسمع ، ونفس لا تشبع ، ومن الجوع فإنه بئس الضجيع ، ومن الخيانة فإنها بئست البطانة ، ومن الكسل والبخل والجبن ، ومن الهرم ، وأن أرد إلى أرذل العمر ، ومن فتنة الدجال وعذاب القبر ، ومن فتنة المحيا والممات ، اللهم إنا نسألك قلوبا أواهة مخبتة منيبة في سبيلك ، اللهم إنا نسألك عزائم مغفرتك ، ومنجيات أمرك ، والسلامة من كل إثم ، والغنيمة من كل بر ، والفوز بالجنة ، والنجاة من النار ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4070 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من غلبة الدين ، وغلبة العدو ، وشماتة الأعداء ) )(@)(@@) ( ن ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4071 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من غلبة الدين ، وغلبة العدو ، ومن بوار الأيم ، ومن فتنة المسيح 
ms430	 الدجال ) )(@)(@@) ( قط ) في الأفراد ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4072 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من فتنة النساء ، وأعوذ بك من عذاب القبر ) )(@)(@@) ( الخرائطي في اعتلال القلوب ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4073 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من قلب لا يخشع ، ومن دعاء لا يسمع ، ومن نفس لا تشبع ، ومن علم لا ينفع ، أعوذ بك من هاؤلاء الأربع ) )(@)(@@) ( ت ن ) عن ابن عمرو ( د ن ه ك ) عن أبي هريرة ( ن ) عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4074 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من منكرات الأخلاق والأعمال والأهواء والأدواء ) )(@)(@@) ( ت طب ك ) عن عم زياد بن علاقة الجملي .(@)(@@)(@@)(@@) $ ( 4075 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من يوم السوء ، ومن ليلة السوء ، ومن ساعة السوء ، ومن صاحب السوء ، ومن جار السوء في دار المقامة ) PageV02P086 )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4076 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بوجهك الكريم واسمك العظيم من الكفر والفقر ) )(@)(@@) ( طب ) في السنة عن عبد الرحمن بن أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4077 ) قال النبي :(@)(@@) | 30 ( اللهم اهد قريشا فإن عالمها يملا طباق الأرض علما ، اللهم كما أذقتهم عذابا فأذقهم نوالا ) )(@)(@@) ( خط و ابن عساكر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4078 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لامتي في بكورها ) )(@)(@@) ( حم ( 4 ) حب ) عن صخر الغامدي ( ه ) عن ابن عمر ( طب ) عن ابن عباس وعن ابن مسعود وعن عبد الله بن سلام وعن عمران بن حصين وعن كعب بن مالك وعن النواس بن سمعان رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4079 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لأمتي في بكورها يوم الخميس ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4080 ) قال النبي :(@)(@@) | 30 ( اللهم لعلمك الغيب وقدرتك على الخلق ، أحيني ما علمت الحياة خيرا لي ، وتوفني إذا علمت الوفاة خيرا لي ، اللهم وأسألك خشيتك في الغيب والشهادة ، وأسألك كلمة الإخلاص في الرضا والغضب ، وأسألك القصد في الفقر والغنى ، وأسألك نعيما 
ms431	 لا ينفد ، وأسألك قرة عين لا تنقطع ، وأسألك الرضا بالقضاء ، وأسألك برد العيي بعد الموت ، وأسألك لذة النظر إلى وجهك والشوق إلى لقائك في غير ضراء مضرة ، ولا فتنة مضلة ، اللهم زينا بزينة الإيمان واجعلنا هداة مهتدين ) )(@)(@@) ( ن ك ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4081 ) قال النبي :(@)(@@) | 30 ( اللهم حببب الموت إلى من يعلم أني رسولك ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@) PageV02P087(@)(@@)(@@)(@@) $ ( 4082 ) قال النبي :(@)(@@) | 30 ( اللهم حجة لا رياء فيها ولا سمعة ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4083 ) قال النبي :(@)(@@) | 30 ( اللهم رب الناس ، مذهب الباس ، اشف أنت الشافي لا شافي إلا أنت ، إشف شفاء لا يغادر سقما ) )(@)(@@) ( حم ( 1 ) خ 3 ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4084 ) قال النبي :(@)(@@) | 30 ( اللهم رب جبريل وميكائيل وإسرافيل ومحمد : نعوذ بك من النار ) )(@)(@@) ( طب ك ) عن والد أبي المليح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4085 ) قال النبي :(@)(@@) | 30 ( اللهم رب جبريل وميكائيل ورب إسرافيل ، أعوذ بك من حر النار ومن عذاب القبر ) )(@)(@@) ( ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4086 ) قال النبي :(@)(@@) | 30 ( اللهم ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ) )(@)(@@) ( ق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4087 ) قال النبي :(@)(@@) | 30 ( اللهم زدنا ولا تنقصنا ، وأكرمنا ولا تهنا ، وأعطنا ولا تحرمنا ، وآثرنا ولا تؤثر علينا ، وأرضنا وارض عنا ) )(@)(@@) ( ت ك ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4088 ) قال النبي :(@)(@@) | 30 ( اللهم طهر قلبي من النفاق ، وعملي من الرياء ، ولساني من الكذب ، وعيني من الخيانة فإنك تعلم خائنة الأعين وما تخفي الصدور ) )(@)(@@) ( الحكيم خط ) عن أم معبد الخزاعية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4089 ) قال النبي :(@)(@@) | 30 ( اللهم عافني في بدني ، اللهم عافني في سمعي ، اللهم عافني في بصري ، اللهم إني أعوذ بك من الكفر والفقر ، اللهم إني أعوذ بك من عذاب القبر ، لا إلاه إلا أنت ) )(@)(@@) ( د ك ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4090 ) قال النبي :(@)(@@) | 30 ( اللهم عافني في جسدي ، وعافني في بصري واجعله الوارث مني 
ms432	 ، لا إلاه إلا الله الحليم الكريم ، سبحان الله رب العرش العظيم ، PageV02P088 الحمد لله رب العالمين ) )(@)(@@) ( ت ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4091 ) قال النبي :(@)(@@) | 30 ( اللهم عافني في قدرتك ، وأدخلني في رحمتك ، واقض أجلي في طاعتك ، واختم لي بخير عمل واجعل ثوابه الجنة ) )(@)(@@) ( ابن عساكر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4092 ) قال النبي :(@)(@@) | 30 ( اللهم كما حسنت خلقي فحسن خلقي ) )(@)(@@) ( حم ( 1 ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4093 ) قال النبي :(@)(@@) | 30 ( اللهم لا تكلني إلى نفسي طرفة عين ، ولا تنزع مني صالح ما أعطيتني ) )(@)(@@) ( البزار ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4094 ) قال النبي :(@)(@@) | 30 ( اللهم لا عيش إلا عيش الآخرة ) )(@)(@@) ( حم ق 3 ) عن أنس ( حم ق ) عن سهل بن سعد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4095 ) قال النبي :(@)(@@) | 30 ( اللهم لا يدركني زمان ، ولا تدركوا زمانا لا يتبع فيه العليم ، ولا يستحيا فيه من الحليم ، قلوبهم قلوب الأعاجم ، وألسنتهم ألسنة العرب ) )(@)(@@) ( حم ( 3 ) عن سهل بن سعد ( ك ) عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4096 ) قال النبي :(@)(@@) | 30 ( اللهم لك أسلمت وبك آمنت وعليك توكلت وإليك أنبت وبك خاصمت ، اللهم إني أعوذ بعزتك ، لا إلاه إلا أنت أن تضلني ، أنت الحي الذي لا يموت والجن والإنس يموتون ) )(@)(@@) ( م ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4097 ) قال النبي :(@)(@@) | 30 ( اللهم لك الحمد شكرا ولك المن فضلا ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4098 ) قال النبي :(@)(@@) | 30 ( اللهم لك الحمد كالذي نقول وخيرا مما نقول ، PageV02P089 اللهم لك صلاتي ونسكي ومحياي ومماتي وإليك مآبي ولك رب تراثي ، اللهم إني أعوذ بك من عذاب القبر ووسوسة الصدر وشتات الأمر ، اللهم إني أسألك من خير ما تجيء به الرياح ، وأعوذ بك من شر ما تجيء به الريح ) )(@)(@@) ( ت هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4099 ) قال النبي :(@)(@@) | 30 ( اللهم متعني بسمعي وبصري واجعلهما الوارث مني وانصرني على من ظلمني وخذ منه بثأري ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه 
ms433	 .(@)(@@)(@@)(@@) $ ( 4100 ) قال النبي :(@)(@@) | 30 ( اللهم من آمن بك وشهد أني رسولك فحبب إليه لقاءك وسهل عليه قضاءك وأقلل له من الدنيا ، ومن لم يؤمن بك ويشهد أني رسولك فلا تحبب إليه لقاءك ، ولا تسهل عليه قضاءك ، وكثر له من الدنيا ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4101 ) قال النبي :(@)(@@) | 30 ( اللهم من آمن بي وصدقني وعلم أن ما جئت به هو الحق من عندك فأقلل ماله وولده وحبب إليه لقاءك وعجل له القضاء ، ومن لم يؤمن بي ولم يصدقني ولم يعلم أن ما جئت به هو الحق من عندك فأكثر ماله وولده وطول عمره ) )(@)(@@) ( ه ) عن عمرو بن غيلان الثقفي ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4102 ) قال النبي :(@)(@@) | 30 ( اللهم من ولي من أمر أمتي شيئا فشق عليهم فاشقق عليه ، ومن ولي من أمر أمتي شيئا فرفق بهم فارفق به ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4103 ) قال النبي :(@)(@@) | 30 ( اللهم واقية كواقية الوليد ) )(@)(@@) ( ع ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4104 ) قال النبي :(@)(@@) | 30 ( الله ورسوله مولى من لا مولى له والخال وارث من لا وارث له ) )(@)(@@) ( ن ه ) عن عمر رضي الله عنه .(@)(@@) PageV02P090(@)(@@)(@@)(@@) $ ( 4105 ) قال النبي :(@)(@@) | 30 ( ألم أنهك أن ترفعي شيئا لغد فإن الله يأتي برزق كل غد ) )(@)(@@) ( حم ( 1 ) هب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4106 ) قال النبي :(@)(@@) | 30 ( ألم تروا إلى الإنسان إذا مات شخص بصره ، فذاك حين يتبع بصره نفسه ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4107 ) قال النبي :(@)(@@) | 30 ( ألم تروا ما قال ربكم ؟ قال : ما أنعمت على عبادي من نعمة إلا أصبح فريق منهم بها كافرين ، يقولون الكواكب وبالكواكب ) )(@)(@@) ( حم م ن ) عن أبي هريرة ( ن ) عن زيد بن خالد الجهني رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4108 ) قال النبي :(@)(@@) | 30 ( ألم تعلموا ما لقي صاحب بني إسرائيل كانوا إذا أصابهم البول قطعوا ما أصابه البول منهم فنهاهم عن ذالك فعذب في قبره ) )(@)(@@) ( د ن ه حب ك 
ms434	 هق ) عن عبد الرحمن بن حسنة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4109 ) قال النبي :(@)(@@) | 30 ( ألهم إسماعيل هاذا اللسان العربي إلهاما ) )(@)(@@) ( ك هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4110 ) قال النبي :(@)(@@) | 30 ( ألهوا والعبوا فإني أكره أن يرى في دينكم غلظة ) )(@)(@@) ( هب ) عن المطلب بن عبد الله .(@)(@@)(@@)(@@) $ ( 4111 ) قال النبي :(@)(@@) | 30 ( إلياس والخضر أخوان أبوهما من الفرس وأمهما من الروم ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4112 ) قال النبي :(@)(@@) | 30 ( أليس الدهر كله غدا ) )(@)(@@) ( ابن سعد ) عن زيد بن أسلم مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 4113 ) قال النبي :(@)(@@) | 30 ( أليس قد مكث هاذا بعده سنة فأدرك رمضان فصامه PageV02P091 وصلى كذا وكذا سجدة في السنة فلما بينهما أبعد مما بين السماء والأرض ) )(@)(@@) ( ه حب هق ) عن طل حة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4114 ) قال النبي :(@)(@@) | 30 ( إليك انتهت الأماني يا صاحب العافية ) )(@)(@@) ( طس هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4115 ) قال النبي :(@)(@@) | 30 ( إليك ربي حببني ، وفي نفسي لك رب ذللني ، وفي أعين الناس فعظمني ، ومن سيىء الأخلاق جنبني ) )(@)(@@) ( ابن لال ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 4116 ) قال النبي :(@)(@@) | 30 ( إلبس الإزار والرداء والنعلين فإن لم يكن إزار فسراويل ، فإن لم يكن نعلان فخفان ، ولا تلبس البرنس ولا ثوبا مسه الورس والزعفران ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما أن رجلا سأل النبي ما نلبس إذا أحرمنا ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 4117 ) قال النبي :(@)(@@) | 30 ( البسوا البياض وكفنوا بها موتاكم ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4118 ) قال النبي :(@)(@@) | 30 ( البسوا الصوف وشمروا وكلوا في أنصاف البطون تدخلوا في ملكوت السماوات ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4119 ) قال النبي :(@)(@@) | 30 ( التقى مؤمنان على باب الجنة مؤمن غني ومؤمن فقير كانا في الدنيا ، فادخل الفقير الجنة ، وحبس الغني ما شاء الله أن يحبس ثم أدخل الجنة فلقيه الفقير فقال أي أخي ماذا حبسك ، والله لقد احتبست حتى خفت عليك PageV02P092 فقال أي أخي : إني احتبست 
ms435	 بعدك محبسا قطيعا كريها ، ما وصلت إليك حتى سال مني العرق ما لو ورده ألف بعير كلها أكلت حمضا لصدرت عنه رواء ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4120 ) قال النبي :(@)(@@) | 30 ( التقى القوم فاقتتلوا قتالا شديدا فقتل زيد بن حارثة ، وأخذ الراية جعفر ، ثم مكث ما شاء الله أن يمكث ثم قتل ، ثم أخذ الراية عبد الله بن رواحة ثم مكث ما شاء الله أن يمكث ثم قتل ، ثم أخذ الراية خالد بن الوليد ، ثم قال : الآن حمي الوطيس ) )(@)(@@) ابن عائذ في مقاريه وابن عساكر عن العطاف بن خالد المخزومي مرسلا .(@)(@@)(@@)(@@) $ ( 4121 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأول والعشر الأواخر ، التمسوها في العشر الأواخر ، التمسوها في السبع الأواخر ، لا تسألني عن شيء بعدها ) )(@)(@@) ( حم ن ) و ابن خزيمة والطحاوي والروياني ( حب ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4122 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر في العشر الأواخر من رمضان وترا ) )(@)(@@) ( حم ع ) و ابن خزيمة ( حل ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4123 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر في العشر الأواخر من رمضان ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4124 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر يعني ليلة القدر فإن ضعف أحدكم أو عجز فلا يغلبن على السبع البواقي ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4125 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر في تاسعه وسابعه وخامسه ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@) PageV02P093(@)(@@)(@@)(@@) $ ( 4126 ) قال النبي :(@)(@@) | 30 ( التمسوا هاذه الليلة ليلة ثلاث وعشرين ) )(@)(@@) مالك ( حم ) وابن خزيمة وأبو عوانة والطحاوي عن عبد الله بن أنيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4127 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر في العشر الباقيات من رمضان : في التاسعة والسابعة والخامسة ) )(@)(@@) ابن نصر والخطيب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4128 ) قال النبي :(@)(@@) | 30 ( الحق بسلفنا الصالح عثمان بن مظعون ) )(@)(@@) ( طب ) عن الأسود بن سريع رضي الله عنه قال لما مات إبراهيم ابن رسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 4129 ) قال 
ms436	 النبي :(@)(@@) | 30 ( الحق فيها : الصلاة خير من النوم ) )(@)(@@) ( حل ) عن أبي محذورة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4130 ) قال النبي :(@)(@@) | 30 ( الحق بخالد بن الوليد فلا يقتلن ذرية ولا عسيفا ) )(@)(@@) ( ك ) عن رباح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4131 ) قال النبي :(@)(@@) | 30 ( ألحقوا الفرائض بأهلها فما بقي فهو ولأولى رجل ذكر ( ( حب ) عن ا$ بن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4132 ) قال النبي :(@)(@@) | 30 ( الحقي بسلفنا الخير عثمان بن مظعون ) )(@)(@@) و ابن سعد ( طب ك ) عن ابن عباس قال : لما ماتت زينب بنت رسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 4133 ) قال النبي :(@)(@@) | 30 ( الزمها فإن الجنة تحت أقدامها يعني الوالدة ) )(@)(@@) ( حم ك ) و ابن سعد والبغوي وابن أبي خيثمة والباوردي وابن قانع ( ض ) عن معاوية بن جاهمة بن العباس بن مرداس عن أبيه ( حم ) وأبو نعيم .(@)(@@)(@@)(@@) $ ( 4134 ) قال النبي :(@)(@@) | 30 ( الزم رجلها فثم الجنة ) )(@)(@@) ( ه طب ) و أبو نعيم عن PageV02P094 معاوية السلمي عن أبيه .(@)(@@)(@@)(@@) $ ( 4135 ) قال النبي :(@)(@@) | 30 ( الله الله في قبط مصر فإنكم ستظهرون عليهم فيكونون لكم عدة دعوانا في سبيل الله ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4136 ) قال النبي :(@)(@@) | 30 ( الله أكبر ، الله أكبر كبيرا ، الله أكبر كبيرا ، الله أكبر كبيرا ، الحمد لله كثيرا ، وسبحان الله بكرة وأصيلا ( ثلاثا ) ، أعوذ بالله من الشيطان الرجيم من نفخه ونفثه وهمزه ) )(@)(@@) ( ش د ) عن ابن زهير بن مطعم عن العباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4137 ) قال النبي :(@)(@@) | 30 ( الله أكبر الله أكبر الله أكبر لا إلاه إلا الله وحده ، صدق وعده ، ونصر عبده ، وهزم الأحزاب وحده ، ألا إن كل شيء في الجاهلية تذكر وتدعي من دم أو مال تحت قدمي ، إلا ما كان من سقاية الحاج وسدانة البيت ، ألا إن دية الخطا شبه العمد ما كان بالسوط والعصى مائة من الإبل فيها أربعون في بطونها أولادها ) )(@)(@@) ( د ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4138 ) قال النبي :(@)(@@) | 30 ( الله أعلم بما كانوا عاملين ) )(@)(@@) ( ط خ د ن ) عن ابن عباس رضي الله عنهما قال : سئل رسول الله في 
ms437	 أولاد المشركين فقال فذكره ( ط ) عن ابن عباس عن أبي بن كعب ( خ م د ن ) عن أبي هريرة ( د ) والحكيم عن عائشة عبد بن حميد عن أبي سعيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4139 ) قال النبي :(@)(@@) | 30 ( الله أعلم بما كانوا عاملين إذ خلقهم ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4140 ) قال النبي :(@)(@@) | 30 ( الله أكبر خربت خيبر ، إنا نزلنا بساحة فساء صباح المنذرين ) )(@)(@@) ( طب ) عن أنس عن طلحة رضي الله عنهما .(@)(@@) PageV02P095(@)(@@)(@@)(@@) $ ( 4141 ) قال النبي :(@)(@@) | 30 ( الله أكبر أعطيت مفاتيح الشام ، والله إني لابصصر قصورها الحمر من مكاني هاذا ، الله أكبر أعطيت مفاتيح فارس والله إني لأنظر المدائن وأنظر قصورها البيض من مكاني هاذا ، الله أكبر أعطيت مفاتيح اليمن والله إني لأنظر إلى أبواب صنعاء من مكاني هاذا ) )(@)(@@) ( حم ن ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4142 ) قال النبي :(@)(@@) | 30 ( الله ورسوله وجبريل عنك راضون ) )(@)(@@) ( طب ) عن محمد بن عبد الله بن أبي رافع عن أبيه عن جده أن رسول الله بعث عليا رضي الله عنه مبعثا فلما قدم قال له فذكره .(@)(@@)(@@)(@@) $ 4143 قال النبي :(@)(@@) | 30 ( الله أكبر هاذا كما قالت بنو إسرائيل لموسى اجعل لنا إلاها كما لهم آلهة لتركبن سنن من كان قبلكم ) )(@)(@@) الشافعي ( حم هق ) في المعرفة ( طب ) عن أبي واقد الليثي رضي الله عنه قال : قلنا : يا رسول الله اجعل لنا ذات أنواط قال فذكره .(@)(@@)(@@)(@@) $ ( 4144 ) قال النبي :(@)(@@) | 30 ( الله أكبر الله أكبر ، الحمد لله الذي رد كيده إلى الوسوسة ) )(@)(@@) ( حم د ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4145 ) قال النبي :(@)(@@) | 30 ( الله الله ربي لا أشرك به شيئا ) )(@)(@@) ( ه ) عن أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4146 ) قال النبي :(@)(@@) | 30 ( الله أكبر ، الله أكبر ، الله أكبر ، بسم الله على نفسي وديني ، بسم الله على أهلي ومالي ، بسم الله على كل شيء أعطاني ربي ، بسم الله خير الأسماء ، بسم الله رب الأرض ورب السماء ، بسم الله الذي لا يضر مع اسمه داء ، بسم الله افتتحت وعلى الله 
ms438	 توكلت ، الله ، الله ، ربي لا أشرك به أحدا ، أسألك اللهم بخيرك من خيرك الذي لا يعطيه أحد غيرك ، عز جارك PageV02P096 وجل ثناؤك ولا إلاه إلا أنت اجعلني في عياذك وجوارك من كل سوء ومن الشيطان الرجيم ، اللهم إني أستجيرك من جميع كل شيء خلقت ، وأحترس بك منهن ، وأقدم بين يدي بسم الله الرحمان الرحيم ، قل هو الله أحد ، الله الصمد ، لم يلد ولم يولد ، ولم يكن له كفوا أحد ، من أمامي ومن خلفي وعن يميني وعن شمالي ، ومن فوقي ومن تحتي يقرأ في هاذه الست قل هو الله أحد إلى آخر السورة ) )(@)(@@) ابن سعد وابن السني في عمل يوم وليلة عن أبان عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4147 ) قال النبي :(@)(@@) | 30 ( الله أضن بدم عبده المؤمن من أحدكم بكريمة ماله حتى يقبضه على فراشه ) )(@)(@@) الحكيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4148 ) قال النبي :(@)(@@) | 30 ( الله المزوج وجبريل الشاهد ) )(@)(@@) ( طب هق ) عن زينب بنت جحش رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4149 ) قال النبي :(@)(@@) | 30 ( الله أحق بالفتاء والوفاء اشترها جذعة سمينة فانسك بها عنك ) )(@)(@@) ( هق ) عن سنان بن سلمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4150 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل فناء أمتي بالطعن والطاعون ) )(@)(@@) الباوردي عن أسامة بن شريك عن أبي موسى الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4151 ) قال النبي :(@)(@@) | 30 ( اللهم لا خير إلا خير الآخرة فبارك في الأنصار والمهاجرة ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4152 ) قال النبي :(@)(@@) | 30 ( اللهم إني أحرم ما بين جبليها كما حرم إبراهيم مكة ، اللهم بارك لهم في صاعهم ومدهم ) )(@)(@@) ( حم خ م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4153 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبناء الأنصار ولأبناء أبناء الأنصار ) )(@)(@@) ( خ ت ) عن أنس ( ط حم م ) عن زيد بن أرقم ( طب ) عن خزيمة بن ثابت ( ش ) عن أبي سعيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4154 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبناء الأنصار ولأزواج الأنصار ولذراري الأنصار ، الأنصار كرشي وعيبتي ، ولو أن الناس أخذوا شعبا وأخذت الأنصار شعبا لأخذت 
ms439	 شعب الأنصار ، ولولا الهجرة لكنت امرءا من الأنصار ) )(@)(@@) ( حم ) عن النضر بن أنس عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4155 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبناء الأنصار ولأبناء الأنصار ولأولاد الأنصار وموالي الأنصار ) )(@)(@@) ( حم م ) عن أنس ( طب ) عن عوف بن سلمة بن عوف عن أبيه .(@)(@@)(@@)(@@) $ ( 4156 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبناء الأنصار ، ولأبناء أبناء الأنصار ، وللكنائن والجيران ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4157 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبنائها وأبناء أبنائها وحشمها ) )(@)(@@) عبد بن حميد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4158 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأنصار ولأبناء الأنصار ، ولأبناء أبناء الأنصار ، ولنساء الأنصار ، ولنساء أبناء الأنصار ، ولنساء أبناء أبناء الأنصار ) )(@)(@@) ( حم ش طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4159 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لهم في مكيالهم وبارك لهم في صاعهم ومدهم يعني المدينة ) )(@)(@@) مالك ( خ م ن ) و الدارمي ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4160 ) قال النبي :(@)(@@) | 30 ( اللهم لا سهل إلا ما جعلته سهلا وأنت تجعل الحزن PageV02P098 إذا شئت سهلا ) )(@)(@@) ابن أبي عمر ( حب ) وابن السني في عمل يوم وليلة عنه .(@)(@@)(@@)(@@) $ ( 4161 ) قال النبي :(@)(@@) | 30 ( اللهم أقبل بقلبي إلى دينك واحفظ من وراءنا برحمتك ) )(@)(@@) ( ع ص ) عن ابن أبي عمر .(@)(@@)(@@)(@@) $ ( 4162 ) قال النبي :(@)(@@) | 30 ( اللهم توفني فقيرا ولا توفني غنيا واحشرني في زمرة المساكين ، فإن أشقى الأشقياء من اجتمع عليه فقر الدنيا وعذاب الآخرة ) )(@)(@@) ( عد هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4163 ) قال النبي :(@)(@@) | 30 ( اللهم ارزقني اللهم اهدني ) )(@)(@@) ابن أبي عاصم ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4164 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الفقر وعذاب القبر وفتنة المحيا وفتنة الممات ) )(@)(@@) ( طب ) عن عثمان بن أبي العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4165 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من البخل والكسل وأرذل العمر وعذاب القبر وفتنة المحيا والممات ) )(@)(@@) ( م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4166 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الكسل والهرم 
ms440	 ، والجبن والبخل ، وسوء الكبر وفتنة الدجال وعذاب القبر ) )(@)(@@) ( ش ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4167 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من البخل وأعوذ بك من الجبن ، وأعوذ بك من أن أرد إلى أرذل العمر ، وأعوذ بك من فتنة الدنيا ، وأعوذ بك من عذاب القبر ) )(@)(@@) ( حم خ م ش حب ) عن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4168 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من بطن لا تشبع ، وأعوذ بك من صلاة لا تنفع ، وأعوذ بك من دعاء لا يسمع ، وأعوذ بك من قلب لا يخشع ) PageV02P099 )(@)(@@) ( حب ) و سمويه ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4169 ) قال النبي :(@)(@@) | 30 ( اللهم إني أول من أحيا أمرك إذا أماتوه ) )(@)(@@) ( حم م د ن ه ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4170 ) قال النبي :(@)(@@) | 30 ( اللهم استر عورتي ، وآمن روعتي ، واقض ديني ) )(@)(@@) بقي بن مخلد وابن منده وأبو نعيم عن ابن جندب عن أبيه .(@)(@@)(@@)(@@) $ ( 4171 ) قال النبي :(@)(@@) | 30 ( اللهم اقبل بقلوبهم وبارك لنا في صاعنا ومدنا ) )(@)(@@) ( حم ) و الروياني ( طس حل ض ) عن أنس بن زيد بن ثابت .(@)(@@)(@@)(@@) $ ( 4172 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لنا في مدنا وصاعنا واجعل مع البركة بركتين ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4173 ) قال النبي :(@)(@@) | 30 ( اللهم أحسن عاقبتي في الأمور كلها ، وأجرني من خزي الدنيا وعذاب الآخرة ، من كان ذالك دعاؤه مات قبل أن يصيبه البلاء ) )(@)(@@) ( طب ) عن بشر بن أرطأة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4174 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الإسلام بعمر بن الخطاب ) )(@)(@@) ( ك ) عن ابن عباس ( طب ) عن ثوبان ابن عساكر عن علي والزبير رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4175 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الإسلام بأبي جهل بن هشام ، أو بعمر بن الخطاب ) )(@)(@@) ( ت طب ) و ابن عساكر عن ابن عباس ( طب ك ) عن ابن مسعود رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4176 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الإسلام بأحب هاذين الرجلين إليك PageV02P100 بعمر بن الخطاب أو بأبي جهل بن هشام ) )(@)(@@) ( حم ( 1 ) و 