ms21	 ينفخ الفحما % % 23(@)(@@) % حتى غدا مثل نصل السيف منصلتا ، % يقرو الأماعز من لبنان والأكما % % PageV01P078 البحر : بسيط تام 1(@)(@@) % قالت بنو عامر : خالوا بني اسد ، % يا بؤس للجهل ، ضرارا لأقوام % 2(@)(@@) % يأبى البلاء ، فلا نبغي بهم بدلا ، % و لا نريد خلاء بعد إحكام % 3(@)(@@) % فصالحونا جميعا ، إن بدا لكم ، % و لا تقولوا لنا أمثالها ، عام % 4(@)(@@) % إني لأخشى عليكم أن يكون لكم ، % من أجل بغضائهم ، يوم كأيام % 5(@)(@@) % تبدو كواكبه ، والشمس طالعة ، % لا النور نور ، ولالإظلام إظلام % 6(@)(@@) % أو تزجروا مكفهرا لا كفاء له ، % كالليل يخلط أصراما بأصرام % 7(@)(@@) % مستحقبي حلق الماذي ، يقدمهم % % سشم العرانين ، ضرابون للهام % 8(@)(@@) % لهم لواء بكفي ماجد بطل ، % لا يقطع الخرق إلا طرفه سام % 9(@)(@@) % يهدي كتائب خضرا ، ليس يعصمها % % إلا ابتدار ، إلى موت ، بإللجام % 10(@)(@@) % كم غادرت خيلنا منكم ، بمعترك ، % للخامعات ، أكفا بعد أقدام % PageV01P079 11(@)(@@) % يا رب ذات خليل قد فجعن به ، % ومؤتمين ، وكانوا غير أيتام % 12(@)(@@) % والخيل تعلم أنا ، في تجاولها % % عند الطعان ، أولو بؤسى وإنعام % 13(@)(@@) % و لوا ، وكبشهم يكبو لجبهته ، % عند الكماة صريعا ، جوفه دام % PageV01P080 البحر : بسيط تام 1(@)(@@) % لا يبعد الله جيرانا ، تركتهم % مثل المصابيح ، تجلو ليلة الظلم % 2(@)(@@) % لا يبرمون ، إذا ما الأفق جلله % برد الشتاء ، من الإمحال ، كالأدم % % 3(@)(@@) % هم الملوك وأبناء الملوك لهم % فضل على الناس ، في اللأواء والنعم % 4(@)(@@) % أحلام عاد ، وأجساد مطهرة % من المعقة والآفات والإثم % PageV01P081 البحر : كامل تام 1(@)(@@) % جمع محاشك يا يزيد ، فإنني % % أعددت يربوعا لكم وتميما % % 2(@)(@@) % و لحقت بالنسب الذي عيرتني ، % و تركت أصلك ، يا يزيد ، ذميما % % 3(@)(@@) % عيرتني نسب الكرام ، وإنما % % فخر المفاخر إن يعد كريما % % 4(@)(@@) % حدبت عل بطون ضنة كلها ، % إن ظالما فيهم ، وإن مظلوما % % 5(@)(@@) % لولا بنو عوف بن بهثة أصبحت ، % بالنعف ، أم بني أبيك عقيما % % PageV01P082 البحر : طويل 1(@)(@@) % أبلغ بني ذبيان أن لا أخا لهم % بعبس إذا حلوا الدماخ فأظلما % % 2(@)(@@) % بجمع ، كلون الأعبل الجون لونه ، % ترى ، في نواحيه ، زهيرا وحذيما % % 3(@)(@@) % هم يردون الموت ، عند لقائه 
ms22	 ، % إذا كان ورد الموت ، لا بد ، أكرما % % PageV01P083 البحر : وافر تام 1(@)(@@) % ألم أقسم عليك لتخبرني ، % أمحمول ، على النعش ، الهمام % 2(@)(@@) % فإني لا ألام على دخول ؛ % و لكن ما وارءك يا عصام ؟ % 3(@)(@@) % فإن يهلك أبو قابوس يهلك % ربيع الناس ، والشهر الحرام % 4(@)(@@) % و نمسك ، بعده ، بذناب عيش % أجب الظهر ، ليس له سنام % PageV01P084 البحر : وافر تام 1(@)(@@) % أتاركة تدللها قطام ، % وضنا بالتحية والكلام % 2(@)(@@) % فإن كان الدلال ، فلا تلجي ؛ % وإن كان الوداع ، فبالسلام % 3(@)(@@) % فلو كانت ، غداة البين ، منت ، % وقد رفعوا الخدور على الخيام % 4(@)(@@) % صفحت بنظرة ، فرأيت منها ، % تحيت الخدر ، واضعة القرام % 5(@)(@@) % ترائب يستضيء الحلي فيها ، % كجمر النار بذر بالظلام % 6(@)(@@) % كأن الشذر والياقوت ، منها ، % على جيداء فاترة البغام % 7(@)(@@) % خلت بغزالها ، ودنا عليها % % أراك الجزع ، أسفل من سنام % 8(@)(@@) % تسف بريره ، وترود فيه ، % إلى دبر النهار ، من البشام % 9(@)(@@) % كأن مشعشعا من بصرى ، % نمته البخت ، مشدود الختام % 10(@)(@@) % نمين قلاله من بيت راس % إلى لقمان ، في سوق مقام % PageV01P085 11(@)(@@) % غذا فضت خواتمه علاه % يبيس القمحان ، من المدام % 12(@)(@@) % على انيابها بغريض مزن ، % تقبله الجباه من الغمام % 13(@)(@@) % فأضحت في مداهن باردات ، % بمنطلق الجنوب ، على الجهام % 14(@)(@@) % تلذ لطعمه ، وتخال فيه ، % إذا نبهتها ، بعد المنام % 15(@)(@@) % فدعها عنك ، إذ شطت نواها ، % ولجت ، من بعادك ، في غرام % 16(@)(@@) % ولكن ما أتاك عن ابن هند ، % من الحزم المبين ، والتمام % 17(@)(@@) % فداء ، ما تقل النعل مني % % إلى أعلى الذؤابة ، للهمام % 18(@)(@@) % ومغزاه قبائل غائظات ، % على الذهيوط ، في لجب لهام % 19(@)(@@) % يقدن مع امرىء يدع الهوينا ، % و يعمد للمهمات العظام % 20(@)(@@) % أعين على العدو ، بكل طرف ، % وسلهبة تجلل في السمام % PageV01P086 21(@)(@@) % وأسمر مارن ، يلتاح ، فيه ، % سنان ، مثل نبراس النهام % 22(@)(@@) % وأنبأه المنبىء أن حيا % حلولا من حرام ، أو جذام % 23(@)(@@) % و أن القوم نصرهم جميع ، % فئام مجلبون إلى فئام % 24(@)(@@) % فأوردهن بطن الأتم ، شعثا ، % يصن المشي كالحدإ التوام % 25(@)(@@) % على إثر الأدلة والبغايا ، % و خفق الناجيات من الشآم % 26(@)(@@) % فباتوا ساكنين ، وبات يسري 
ms23	 ، % يقربهم له ليل التمام % 27(@)(@@) % فصبحهم بها صهباء صرفا ، % كأن رؤوسهم بيض النعام % 28(@)(@@) % فذاق الموت من بركت عليه ، % و بالناجين أظفار دوام % 29(@)(@@) % وهن ، كأنهن نعاج رمل ، % يسوين الذيول على الخدام % 30(@)(@@) % يوصين الرواة ، إذا ألموا ، % بشعث مكرهين على الفطام % PageV01P087 31(@)(@@) % و أضحى ساطعا بجبال حمسى ، % دقاق الترب ، مختزم القتام % 32(@)(@@) % فهم الطالبون ليدركوه ، % وما راموا بذلك من مرام % 33(@)(@@) % إلى صعب المقادة ، ذي شريس ، % نماه ، في فروع المجد ، نام % 34(@)(@@) % أبوه قبله ، وأبو أبيه ، % بنوا مجد الحياة على إمام % 35(@)(@@) % فدوخت العراق ، فكل قصر % يجلل خندق منه ، وحام % 36(@)(@@) % وما تنفك محلولا عراها ، % على متناذر الأكلاء ، طام % PageV01P088 البحر : كامل تام 1(@)(@@) % طلعوا عليك براية معروفة % يوم الأبيس ، إذ لقيت لئيما % % 2(@)(@@) % قوم تدارك ، بالعقيرة ، ركضهم % أولاد زردة ، إذ تركت ذميما % PageV01P089 البحر : وافر تام 1(@)(@@) % و لست بذاخر لغد طعاما ، % حذار غد ، لكل غد طعام % 2(@)(@@) % تمحضت المنون له بيوم % أتى ، ولكل حاملة تمام % PageV01P090 البحر : سريع 1(@)(@@) % هذا غلام حسن وجهه ، % مستقبل الخير ، سريع التمام % 2(@)(@@) % للحارث الأكبر ، والحارث % الأصغر ، والأعرج خير الأنام % 3(@)(@@) % ثم لهند ، ولهند ، وقد % % أسرع ، في الخيرات ، منه إمام % 4(@)(@@) % خمسة آبائهم ، ما هم ؟ % هم خير من يشرب صوب الغمام % % PageV01P091 البحر : وافر تام 1(@)(@@) % ألا أبلغ ، لديك ، أبا حريث ؛ % وعاقبة الملامة للمليم % 2(@)(@@) % فكيف ترى معاقبتي وسعيي % % بأذواد القيصمة ، والقصيم % 3(@)(@@) % فنمت الليل ، إذ أوقعت فيكم ، % قبائل عامر وبني تميم % 4(@)(@@) % وساغ لي الشارب ، وكنت قبلا ، % أكاد أغص بالماء الحميم % PageV01P092 البحر : رجز تام 1(@)(@@) % نفس عصام سودت عصاما ، % و علمته الكر والإقداما % % 2(@)(@@) % وصيرته ملكا هماما ، % حتى علا ، وجاوز الأقواما % % PageV01P093 البحر : وافر تام 1(@)(@@) % لعمرك ، ما خشيت على يزيد ، % من الفخر المضلل ، ما أتاني % % 2(@)(@@) % كأن التاج ، معصوبا عليه ، % لأذواد أصبن بذي أبان % 3(@)(@@) % فحسبك أن تهاض بمحكمات % يمر بها الروي على لساني % % 4(@)(@@) % فقبلك ما شتمت وقاذ عوني ، % فما نزر الكلام ولا شجاني % % 5(@)(@@) % يصد الشاعر الثنيان عني ، % صدود البكر عن قرم هجان % 6 
ms24	(@)(@@) % أثرت الغي ، ثم نزعت عنه ، % كما حاد الأزب عن الظعان % 7(@)(@@) % فإن يقدر عليك أبو قبيس ، % تمط بك المعيشة في هوان % 8(@)(@@) % و تخضب لحية ، غدرت وخانت ، % بأحمر ، من نجيع الجوف ، آني % % 9(@)(@@) % وكنت أمينة ، لو لم تخنه ، % و لكن لا أمانة لليمان % PageV01P094 البحر : وافر تام 1(@)(@@) % فإن يقدر علي أبو قبيس ، % تجدني ، عنده ، حسن المكان % 2(@)(@@) % تجدني كنت خيرا منك غيبا ، % و أمضى باللسان وبالسنان % 3(@)(@@) % و أي الناس أغدر من شآم ، % له صردان ، منطلق اللسان % 4(@)(@@) % فإن الغدر ، قد علمت معد ، % بناه ، في بني ذبيان ، باني % % 5(@)(@@) % و إن الفحل تنزع خصيتاه ، % فيصبح جافرا قرح العجان % PageV01P095 البحر : وافر تام 1(@)(@@) % غشيت منازلا بعريتنات ، % فأعلى الجزع للحي المبن % 2(@)(@@) % تعاورهن صرف الدهر ، حتى % % عفون ، وكل منهمر مرن % 3(@)(@@) % وقفت بها القلوض ، على اكتئاب ، % وذاك تفارط الشوق المعني % % 4(@)(@@) % أسائلها ، وقد سفحت دموعي ، % كأن مفيضهن غروب شن % 5(@)(@@) % بكاء حمامة ، تدعو هديلا ، % مفجعة ، على فنن ، تغني % % 6(@)(@@) % الكني يا عيين إليك قولا % سأهديه إليك ، إليك عني % % 7(@)(@@) % قوافي كالسلام ، إذا استمرت ، % فليس يرد مذهبها التظني % % 8(@)(@@) % بهن أدين من يبغي أذاني ، % مداينة المداين ، فليدنيب % % 9(@)(@@) % أتخذل ناصري وتعز عبسا ، % أيربوع بن غيظ للمعن % 10(@)(@@) % كأنك من جمال بني أقيش ، % يقعقع ، خلف رجليه ، بشن % PageV01P096 11(@)(@@) % تكون نعامة طورا ، وطورا % هوي الريح ، تنسج كل فن % 12(@)(@@) % تمن بعادهم ، واستبق منهم ، % فإنك سوف تترك والتمني % % 13(@)(@@) % لدى جرعاء ، ليس بها أنيس ؛ % و ليس بها الدليل بمطمئن % 14(@)(@@) % إذا حاولت ، في أسد ، فجورا ، % فإني لست منك ، ولست مني % % 15(@)(@@) % فهم درعي ، التي استلأمت فيها ، % إلى يوم النسار ، وهم مجني % % 16(@)(@@) % وهم وردوا الجفار على تميم ؛ % و هم أصحاب يوم عكاظ ، إني % % 17(@)(@@) % شهدت لهم مواطن صادقات ، % أتينهم بود الصدر مني % % 18(@)(@@) % وهم ساروا لحجر في خميس ، % وكانوا ، يوم ذلك ، عند ظني % 19(@)(@@) % وهم زحفوا ، لغسان ، بزحف % رحيب السرب ، أرعن ، مرجحن % 20(@)(@@) % بكل مجرب ، كالليث يسمو % % على أوصال ذيال ، رفن % PageV01P097 21(@)(@@) % وضمر كالقداح ، مسومات ، % عليها 
ms25	 معشر أشباه جن % 22(@)(@@) % غداة تعاورته ، ثم ، بيض ، % دفعن إليه في الرهج المكن % 23(@)(@@) % ولو أني أطعتك في أمور ، % قرعت ندامة ، من ذاك ، سني % % PageV01P098 البحر : وافر تام 1(@)(@@) % وأعيار صوادر عن حماتا ، % لبين الكفر والبرق الدواني % % 2(@)(@@) % ألا زعمت بنو عبس بأني ، % ألا كذبوا ، كبير السن فان % PageV01P099 البحر : وافر تام 1(@)(@@) % نات بسعاد عنك نوى شطون ، % فبانت ، والفؤاد بها رهين % 2(@)(@@) % و حلت في بني القين بن جسر ، % فقد نبغت لنا ، منهم ، شؤون % 3(@)(@@) % تأوبني ، بعملة ، اللواتي % % منعن النوم ، إذ هدأت عيون % 4(@)(@@) % كأن الرحل شد به خذوف ، % من الجونات ، هادية عنون % 5(@)(@@) % من المستعرضات بعين نخل ، % كأن بياض لبته سدين % 6(@)(@@) % كقوس الماسخي ، أرن فيها ، % من الشرعي ، مربوع متين % 7(@)(@@) % إلى ابن محرق أعملت نفسي ، % و راحلتي ، وقد هدت العيون % 8(@)(@@) % اتيتك عاريا خلقا ثيابي ، % على خوف ، تظن بي الظنون % 9(@)(@@) % فألفيت الأمانة لم تخنها ؛ % كذلك كان نوح لا يخون % PageV01P100 البحر : طويل 1(@)(@@) % فتى ، تم فيه ما يسر صديقه ؛ % على أن فيه ما يسيء المعاديا % % 2(@)(@@) % فتى ، كملت أخلاقه ، غير أنه % جواد ، فما يبقي على المال باقيا % % PageV01P101 البحر : رمل تام 1(@)(@@) % سألتني عن أناس هلكوا ، % أكل الدهر عليهم وشرب % PageV01P102 البحر : متقارب تام 1(@)(@@) % بعاري النواهق ، صلت الجبين ، % يستن كالتيس في الحلب % PageV01P103 البحر : طويل 1(@)(@@) % متى تأته ، تعشو إلى ضوء ناره ، % تجد خير نار ، عندها خير موقد % PageV01P104 البحر : وافر تام 1(@)(@@) % فأضحت بعدما وصلت بدار % شطون ، لا تعاد ولا تعود % PageV01P105 البحر : طويل 1(@)(@@) % حباء شقيق فوق أحجار قبره ، % و ما كان يحبى ، قبله ، قبر وافد % PageV01P106 البحر : كامل تام 1(@)(@@) % بالدر والياقوت زين نحرها ، % و مفصل من لؤلؤ وزبرجد % PageV01P107 البحر : طويل 1(@)(@@) % إذا تلقهم لا تلق للبيت عورة ، % ولا الجار محروما ، ولا الأمر ضائعا % % PageV01P108 البحر : بسيط تام 1(@)(@@) % صبرا بغيض بن ريث ، إنها رحم ، % حبتم بها فأناختكم بجعجاع % PageV01P109 البحر : بسيط تام 1(@)(@@) % يا مانع الضيم أن يغشى سراتهم ، % و حامل الإصر عنهم ، بعدما غرقوا % % PageV01P110 البحر : طويل 1(@)(@@) % إذا غضبت لم يشعر 
ms26	 الحي أنها % % غضوب ، وإن نالت رضى لم تزهزق % PageV01P111 البحر : طويل 1(@)(@@) % وعريت من مال وخير جمعته ، % كما عريت ، مما تمر ، المغازل % PageV01P112 البحر : سريع 1(@)(@@) % الطاعن الطعنة ، يوم الوغى ، % ينهل منها الأسل الناهل % PageV01P113 البحر : طويل 1(@)(@@) % جزى ربه عني عدي بن حاتم ، % جزاء الكلاب العاويات ، وقد فعل % % 2(@)(@@) % ظللنا ببرقاء اللهيم ، تلفنا % % قبول نكاد من ظلالتها نمسي % % 3(@)(@@) % إذا أنا لم أنفع خليلي بوده ، % فإن عدوي لا يضرهم بغضي % % PageV01P114 البحر : بسيط تام 1(@)(@@) % خيل صيام ، وخيل غير صائمة ، % تحت العجاج ، وأخرى تعلك اللجما % % PageV01P115 البحر : سريع 1(@)(@@) % ألمم برسم الطلل الأقدم ، % بجانب السكران ، فالأيهم % PageV01P116 البحر : طويل 1(@)(@@) % تعدو الذئاب على من لا كلاب له ، % و تتقي مربض المستنفر الحامي % % 2(@)(@@) % فلن أذكر النعمان إلا بصالح ، % فإن له عندي يديا وأنعما % % PageV01P117 
ms27	