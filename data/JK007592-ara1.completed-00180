ms161	 لعمري عاليين على الورى ، % و عليهما ، لا شك ، أصبح عاليا % % 5(@)(@@) % لا زال في نعم محدثة له ، % و قديمة تبقى عليه كما هيا % % PageV01P940 البحر : كامل تام 1(@)(@@) % أمسى يحدثني ، فقلت لصاحبي : % أمحدث أم محدث من فيه % 2(@)(@@) % يا ويح ريحان نحييه به ، % والويل للكأس التي نسقيه % PageV01P941 البحر : سريع 1(@)(@@) % قد غضبت بنت النميريه ، % ولي سواها ألف سريه % % 2(@)(@@) % إذا غدت يوما إلى حاجة ، % سارت على ألفين جنيه % % 3(@)(@@) % وإن جرى ذكري لها أعرضت ، % ومسحت ذكري بلا نيه % % 4(@)(@@) % و ضاحكت بنتا لها غثة ، % و جارة عرجاء قصريه % % 5(@)(@@) % يطنها الشيعة باب الهدى ، % و خلف ذاك الباب بريه % % PageV01P942 البحر : مجزوء الرجز 1(@)(@@) % يا راكبا فوق بغل % للأرض منها دوي % 2(@)(@@) % له إذا ما تمشى % % قفا إليها شهي % 3(@)(@@) % يعرف الرسم منها % % شسع عليها خفي % % 4(@)(@@) % بما تتيه ، على النا % % س ، قل لنا يا شقي % PageV01P943 البحر : مجتث 1(@)(@@) % كم غدوة وعشيه % نعمت بالقادسيه % % 2(@)(@@) % و كم هجير وقتني % % من حر شمس ذكيه % % 3(@)(@@) % معشرات كروم % أبناؤها حبشيه % % 4(@)(@@) % لم يبق من وهج الشم % % س بينهن بقيه % % 5(@)(@@) % يسكرن أنهار ماء % زرقا ، عذابا ، نقيه % % 6(@)(@@) % تحكي ذوائبها في % % رواحها والمجيه % % 7(@)(@@) % عقاربا شاءلات % أذنابها محميه % % 8(@)(@@) % تدب فوق زجاج % مصقولة طبريه % % 9(@)(@@) % و إن أردت سقتني % % خمارة قبطيه % % 10(@)(@@) % ترنو بعين غزال ، % سحارة بابليه % % PageV01P944 11(@)(@@) % جاءت إلي تهادى % % عشية شاطريه % % 12(@)(@@) % في قرطق خصرته % مناطق ذهبيه % % 13(@)(@@) % قد زردت فوق فرع % من فوقه شمسيه % % 14(@)(@@) % يا طيب ذلك عيشا ، % لو صالحتني المنيه % % 15(@)(@@) % سقيا لعصر شبابي ، % إذ لمتي سبجيه % % 16(@)(@@) % و إذ أمد ردائي ، % بقامة خطيه % % 17(@)(@@) % فالآن آنست للعذ % % ل ، واستمعت الوصيه % % 18(@)(@@) % و بيضت شعرات % في مفرقي فضيه % % PageV01P945 البحر : مجزوء الرمل 1(@)(@@) % قل لمن حيا فأحيا % % ميتا يحسب حيا : % 2(@)(@@) % ما الذي ضرك لو % % أبقيت في الكأس بقيا % % 3(@)(@@) % أتراني مثل ، أو لا ، % كيفما قد قيل فيا % % 4(@)(@@) % يا خليلي اسقياني % % قهوة ذات حميا % % 5(@)(@@) % إن يكن رشدا ، فرشدا ، % أو يكن 
ms162	 غيا ، فغيا % % 6(@)(@@) % قد تولى الليل عنا ، % وطواه القرب طيا % % 7(@)(@@) % وكأن الصبح ، لما % % لاح من تحت الثريا % % 8(@)(@@) % ملك أقبل في تا % % ج يفدى ويحيا % % PageV01P946 البحر : طويل 1(@)(@@) % خليلي إني قد أراني ناعيا % % لكم صحو نفسي فاتركوا صحوها ليا % % 2(@)(@@) % ألم يك في شرط السقاة عليكما ، % بأن الندامى تترك العقل واهيا ؟ % PageV01P947 البحر : طويل 1(@)(@@) % أيا وادي الأحباب سقيت واديا ، % ولا زلت مسقيا ، وإن كنت خاليا % % 2(@)(@@) % فلا تنس أطلال الدجيل وماءه ، % ولا نخلات الدير إن كنت ساقيا % % 3(@)(@@) % ألا رب يوم قد لبست ظلاله ، % كما أغمد القين الحسام اليمانيا % % 4(@)(@@) % و لم أنس قمري الحمام عشية % على فرعها تدعو الحمام البواكيا % % 5(@)(@@) % إذا ما جرى حاكت رياض أزاهر % جوانبه ، وانصاع في الأرض جاريا % % 6(@)(@@) % و إن ثقبته العين لاقت قراه % تخال الحصى فيها نجوما رواسيا % % 7(@)(@@) % فيا لك شوقا بعد ما كدت أرعوي ، % و أهجر أسباب الهوى والتصابيا % % 8(@)(@@) % و أصبحت أرفو الشيب ، وهو مرقع % علي ، وأخفي منه ما ليس خافيا % % 9(@)(@@) % و قد كاد يكسوني الشباب جناحه ، % فقد حاد عن رأسي ، وخلف ماضيا % % 10(@)(@@) % مضى فمضى طيب الحياة وأسخطت % خلائق دنيا كنت عنهن راضيا % % PageV01P948 11(@)(@@) % ولم آت ما قد حرم الله في الهوى ، % ولم أترك مما عفا الله باقيا % % 12(@)(@@) % إذا ما تمشت في عين خريدة ، % فليست تخطاني إلى من ورائيا % % 13(@)(@@) % فيا عاذلي دعني وشأني ، ولا تكن % شج في الذي أهوى ، ودعني لما بيا % % 14(@)(@@) % و ليل كجلباب الشباب قطعته % بفتيان صدق لا تمل الأمانيا % % 15(@)(@@) % سروا ثم حطوا عن قلاص خوامس % كما عطل الرامي القسي الحوانيا % % 16(@)(@@) % ألم تعلما يا عاذلي بأنما % % يميني مرعى في الندى وشماليا % % 17(@)(@@) % وأعددت للحرب العوان طمرة ، % وأسمر مطرور الحديدة عاليا % % 18(@)(@@) % ولا بد من حتف يلاقيك يومه ، % فلا تجزعن من ميتة هي ما هيا % % 19(@)(@@) % و جمع سقينا أرضه من دمائه ، % ولم كان عافانا قبلنا العوافيا % % 20(@)(@@) % ودسناهم بالضرب والطعن دوسة % أماتت حقودا ، ثم أحييت معاليا % % PageV01P949 21(@)(@@) % خدوا حظكم من 
ms163	 خيرنا ، إن شرنا % % مع الشر لا يزداد إلا تماديا % % 22(@)(@@) % فرشنا لكم منا جناح مودة ، % وأنتم زمانا تلجئون الدواهيا % % 23(@)(@@) % أظنكم من حاطب الليل جمعت % حبائله عقاربا وأفاعيا % % PageV01P950 البحر : رجز تام 1(@)(@@) % يا رب جاري نهر قضي ، % مضطرب على حصى نقي % 2(@)(@@) % و تربة ذات ثرى وضي ، % و زهر مبتسم ربعي % 3(@)(@@) % مكتهل ومرضع صبي ، % كأنه فرائد الحلي % 4(@)(@@) % باكر بالغداة والعشي ، % ريق الندى في شبم غدري % 5(@)(@@) % ظل ببال فارغ خلي ، % و ما ادعى من شبع وري % 6(@)(@@) % قد عاذ بالجن من الإنسي ، % محكما في سمك اللجي % 7(@)(@@) % يلفظها بمعول دري % لفظ نصال الغرض الرمي % 8(@)(@@) % صبحته بأجل وجي ، % ومقلة تلحق بالقصي % 9(@)(@@) % % كأنها دينار صيرفي % 10(@)(@@) % واتصلت برأيه القوي ، % ساق كغصن الذهب المجلي % PageV01P951 11(@)(@@) % و في سلاح بطل كمي ، % % PageV01P952 البحر : بسيط تام 1(@)(@@) % أما ترى الأرض قد أعطتك زهرتها % % مخضرة ، واكتسى بالنور عاريها % % 2(@)(@@) % فللسماء بكاء في حدائقها ، % وللرياض ابتسام في نواحيها % % PageV01P953 البحر : خفيف تام 1(@)(@@) % وكأن المجر جدول ماء % نور الأقحوان في جانبيه % 2(@)(@@) % وكأن الهلال نصف سوار ، % و الثريا كف تشير إليه % PageV01P954 البحر : مجزوء الرمل 1(@)(@@) % رب أمر تتقيه ، % جر أمرا ترتجيه % 2(@)(@@) % خفي المحبوب منه ، % و بدا المكروه فيه % 3(@)(@@) % فاترك الدهر وسلم % % ه إلى عدل يليه % PageV01P955 البحر : مخلع البسيط 1(@)(@@) % قد كشف الدهر عن يقيني ، % قناع شكي في كل شي % 2(@)(@@) % لا بد من أن يحل موت % عقد نفس من كل حي % PageV01P956 البحر : وافر تام 1(@)(@@) % ألا سايا نفس إن ترضي بقوت ، % و أنت عزيزة أبدا غنيه % % 2(@)(@@) % دعي عنك المطامع والأماني ، % فكم أمنية جلبت منيه % % PageV01P957(@)(@@)(@@)(@@) | البحر : رجز تام 1(@)(@@) % لي صاحب قد لا مني ، وزادا ، % في تركي الصبوح ثم عادا % % 2(@)(@@) % وقال : لا تشرب بالنهار ، % وفي ضياء الفجر والأسحار % 3(@)(@@) % إذا وشى بالليل صبح ، فافتضح ، % وذكر الطائر شجو ، فصدح % 4(@)(@@) % و النجم في حوض الغروب وارد ، % و الفجر في إثر الظلام طارد % 5(@)(@@) % ونفض الليل على الورد الندى ، % وحركت أغصانه ريح الصبا % % 6 
ms164	(@)(@@) % و قد بدت فوق الهلال كرته ، % كهامة الأسود شابت لحيته % % 7(@)(@@) % فنور الدار ببعض نوره ، % و الليل قد أزيح من ستوره % 8(@)(@@) % وقدت المجرة الظلاما ، % تحسبها في ليلها ، إذا ما % % 9(@)(@@) % تنفس الصبح ، ولما يشتعل ، % بين النجوم مثل فرق مكتهل % 10(@)(@@) % وقال : شرب الليل قد آذانا ، % و طمس العقول والأذهانا % % PageV01P958 11(@)(@@) % وشكت الجن إلى إبليس ، % لأنهم في أضيق الحبوش % 12(@)(@@) % أما ترى البستان كيف نورا ، % و نشر المنثور بردا أصفرا % % 13(@)(@@) % و ضحك الورد على الشقائق ، % و اعتنق القطر اعتناق الوامق % 14(@)(@@) % في روضة كحلة العروس ، % و خدم كهامة الطاووس % 15(@)(@@) % و يا سمين في ذرى الأغصان ، % منتظما كقطع العقيان % 16(@)(@@) % والسرو مثل قطع الزبرجد ، % قد استمد الماء من ترب ندي % % 17(@)(@@) % وفرش الخشخاش جيبا وفتق ، % كأنه مصاحف بيض الورق % % 18(@)(@@) % حتى إذا ما انتشرت أوراقه ، % و كاد أن يرى إلينا ساقه % % 19(@)(@@) % صار كأقداح من البلور ، % كأنما تجسمت من نور % 20(@)(@@) % وبعضه عريان من أثوابه ، % قد أخجل الأعين من أصحابه % % PageV01P959 21(@)(@@) % تبصره بعد انتشار الورد ، % مثل الدبابيس بأيدي الجند % 22(@)(@@) % و السوسن الآزر منشور الحلل ، % كقطن قد مسه بعض البلل % % 23(@)(@@) % نور في حاشيتي بستانه ، % و دخل البستان في ضمانه % % 24(@)(@@) % و قد بدت فيه ثمار الكبر ، % كأنها حمائم من عنبر % 25(@)(@@) % وحلق البهار فوق الآس ، % جمجمة كهامة الشماس % 26(@)(@@) % حبال نسيج مثل شيب النصف ، % وجوهر من زهر مختلف % 27(@)(@@) % وجلنار مثل جمر الخد ، % أو مثل أعراف ديوك الهند % 28(@)(@@) % والأقحوان كالثنايا الغر ، % قد صقلت نوارها بالقطر % 29(@)(@@) % قل لي : أهذا حسن بالليل ، % ويلي مما تشتهي وعولي % % 30(@)(@@) % وأكثر الفصول والأوصافا ، % فقلت : قد جنبتك الخلافا % % PageV01P960 31(@)(@@) % بت عندنا ، حتى إذا الصبح سفر ، % كأنه جدول ماء منفجر % 32(@)(@@) % قمنا إلى زاد لنا معد ، % و قهوة صراعة للجلد % 33(@)(@@) % كأنما حبابها المنثور ، % كواكب في فلك تدور % 34(@)(@@) % ولا تقل لقد ألفت منزلي ، % فتفسد القول بعذر مشكل % 35(@)(@@) % فقال : هذا أول الجنون ، % متى ثوى الضب بوادي النون % 36(@)(@@) % دعوتكم إلى الصبوح ثم 
ms165	 لا % % أكون فيه ، إذ أجبتم ، أولا % % 37(@)(@@) % لي حاجة لا بد من قضائها ، % فتستريح النفس من عنائها % % 38(@)(@@) % ثم أجي والصبح في عنان ، % من قبل أن يبدأ بالآذان % 39(@)(@@) % ثم مضى يعد بالبكور ، % وهز رأس فرح مسرور % 40(@)(@@) % فقمت منه خائفا مرتاعا ، % وقلت : ناموا ، ويحكم ، سراعا % % PageV01P961 41(@)(@@) % ونحن نصغي السمع نحو الباب ، % فلم نجد حسا من الكذاب % 42(@)(@@) % حتى تبدت حمرة الصباح ، % وأوجع الندمان سوط الراح % 43(@)(@@) % وقامت الشمس على الرؤوس ، % و ملك السكر على النفوس % 44(@)(@@) % جاء بوجه بارد التبسم ، % مفتضح لما جنى مدمم % 45(@)(@@) % يعثر وسط الدار من حيائه ، % و يكشف الأهداب من ورائه % % 46(@)(@@) % تعطعط القوم به حتى بدر ، % و افتتح القول بعي وحصر % % 47(@)(@@) % لتأخذ العين من الرقاد % حظا إلى تعلية المنادي % % 48(@)(@@) % فمسحت جنوبنا المضاجعا ، % و لم أكن للنوم قبل طائعا % % 49(@)(@@) % ثمة قمنا والظلام مطرق ، % والطير في أوكارها لا تنطق % 50(@)(@@) % وقد تبدى النجم في سواده ، % كحلة الراهب في حداده % % PageV01P962 51(@)(@@) % وقال : يا قوم اسمعوا كلامي ، % لا تسرعوا ظلما إلى ملامي % % 52(@)(@@) % فجاءنا بقصة كذابه ، % لم يفتح القلب لها أبوابه % % 53(@)(@@) % فعذر العنين يوم السابع ، % إلى عروس ذات حظ ضائع % 54(@)(@@) % قالوا : اشربوا ! فقلت : قد شربنا ، % أتيتنا ، ونحن قد سكرنا % % 55(@)(@@) % فلم يزل من شأنه منفردا ، % يرفع بالكأس إلى فيه يدا % % 56(@)(@@) % والقوم من مستيقظ نشوان ، % أو غرق في نومه وسنان % 57(@)(@@) % كأنه آخر خيل الحلبه ، % له من السواس ألف ضربه % % 58(@)(@@) % مجتهدا كأنه قد أفلحنا ، % يطلع في آثارها مفتحا % % 59(@)(@@) % فاسمع ، فإني للصبوح عائب ، % عندي من أخباره العجائب % 60(@)(@@) % إذا أردت الشرب عند الفجر ، % و النجم في لجة ليل يسري % % PageV01P963 61(@)(@@) % و كان برد بالنسيم يرتعد ، % و ريقه على الثنايا قد جمد % 62(@)(@@) % وللغلام ضجرة وهمهمه ، % وشتمة في صدره مجمجمه % % 63(@)(@@) % يمشي بلا رجل من النعاس ، % ويدفق الكأس على الجلاس % 64(@)(@@) % و يلعن المولى ، إذا دعاه ، % ووجهه إن جاء في قفاه % 65(@)(@@) % و غن أحس من نديم صوتا ، % قال مجيبا طعنة وموتا % % 66 
ms166	(@)(@@) % و إن يكن للقوم ساق يعشق ، % فجفنه بجفنه مدبق % 67(@)(@@) % ورأسه كمثل فرق قد مطر ، % و صدغه كالصولحان المنكسر % % 68(@)(@@) % أعجل من مسواكه وزينته ، % و هيئة تنظر حسن صورته % % 69(@)(@@) % % محمولة في الثوب والأعطاف % 70(@)(@@) % كأنما عض على دماغ ، % متهم الأنفاس والأرفاغ % % PageV01P964 71(@)(@@) % فإن طردت الكأس بالسنور ، % وجئت بالكانون والسمور % 72(@)(@@) % فأي فضل للصبوح يعرف ، % على الغبوق ، والظلام مسدف % 73(@)(@@) % يحس من رياحه الشمائل ، % صوارما ترسب في المفاصل % 74(@)(@@) % وقد نسيت شرر الكانون ، % كأنه نثار ياسمين % 75(@)(@@) % يرمي به الجمر إلى الأحداق ، % فإن ونى قرطس في الآماق % 76(@)(@@) % و ترك النياط بعد الخمد ، % ذا نقط سود كجلد الفهد % 77(@)(@@) % وقطع المجلس في اكتئاب ، % و ذكر حرق النار للثياب % 78(@)(@@) % ولم يزل للقوم شغلا شاغلا ، % و اصبحت جبابهم مناخلا % % 79(@)(@@) % حتى إذا ما ارتفعت شمس الضحى % % قيل : فلان وفلان قد أتى % % 80(@)(@@) % و ربما كان ثقيلا يحتشم ، % فطول الكلام حينا وجشم % % PageV01P965 81(@)(@@) % % و زال عنا عيشنا اللذيذا % % 82(@)(@@) % ولست في طول النهار آمنا ، % ما حادث لم يك قبلا كائنا % % 83(@)(@@) % أو خبر يكره ، أو كتاب % يقطع طيب اللهو والشراب % 84(@)(@@) % فاسمع ألى مثالب الصبوح ، % في الصيف قبل الطائر الصدوح % 85(@)(@@) % حين حلا النوم وطاب المضجع ، % وانحسر الليل ، ولذ المهجع % 86(@)(@@) % وانهزم البق وكن رتعا ، % على الدماء واردات شرعا % % 87(@)(@@) % من بعد ما قد أكلوا الأجسادا ، % وطيروا عن الورى الرقادا % % 88(@)(@@) % فقرب الزاد إلى نيام ، % ألسنهم ثقيلة الكلام % 89(@)(@@) % من بعد أن دب عليه النمل ، % وحية تقذف سما ، صل % 90(@)(@@) % و عقرب ممدودة قتاله ، % وجعل ، وفارة بواله % % PageV01P966 91(@)(@@) % و للمغني عارض في حلقه ، % ونفسه قد قدحت في حذقه % 92(@)(@@) % و إن أردت الشرب عند الفجر ، % والصبح قد سل سيوف الحر % 93(@)(@@) % فساعة ، ثم تجيك الدامغه ، % بنارها ، فلا يسوغ شائغه % % 94(@)(@@) % ويسخن الشراب والمزاج ، % ويكثر الخلاف والضجاج % 95(@)(@@) % من معشر قد جرعوا حميما ، % و طعموا من زادهم سموما % % 96(@)(@@) % و غيمت أنفاسهم أقداخهم ، % و عذبت أقداحهم أرواحهم % % 97(@)(@@) % وأولعوا بالحك والتفرك ، % و عصب 
ms167	 الآباط مثل المرتك % 98(@)(@@) % وصار ريحانهم كالقت ، % فكلهم لكلهم ذو مقت % 99(@)(@@) % وبعضهم يمشي بلا رجلين ، % وأذن كحقة الدباق % 100(@)(@@) % وبعضهم محمرة عيناه ، % من السموم محرق خداه % PageV01P967 101(@)(@@) % وبعضهم عند ارتفاع الشمس % يحس جوعا مؤلما للنفس % 102(@)(@@) % فإن أسر ما به تهوسا ، % ولم يطق من ضعفه تنفسا % % 103(@)(@@) % و طاف في أصداغه الصداع ، % ولم يكن بمثله انتفاع % 104(@)(@@) % وكثرت حدته وضجره ، % وصار كالحمى يطير شرره % % 105(@)(@@) % وهم بالعربدة الوحشيه ، % و صرف الكاسات والتحيه % % 106(@)(@@) % وظهرت مشقة في حلقه ، % و مات كل صاحب من فرقه % % 107(@)(@@) % و إن دعا الشقي بالطعام ، % خيط جفنيه على المنام % 108(@)(@@) % وكلما جاءت صلاة واجبه ، % فسا عليها ، فتولت هاربه % % 109(@)(@@) % فكدر العيش بيوم أبلق ، % أقطاره بلهوه لم تلتق % 110(@)(@@) % فمن أدام للشقاء هذا % % من فعله ، والتذه التذاذا % % PageV01P968 111(@)(@@) % لم يلف إلا دنس الأثواب ، % مهوسا ، مهوس الأصحاب % 112(@)(@@) % فازداد سهوا وضنى وسقما ، % و لا تراه الدهر إلا قدما % % 113(@)(@@) % % و ذا يريد ماله وحرمته % 113(@)(@@) % ذا شارب وظفر طويل ، % ينغص الزاد على الأكيل % 114(@)(@@) % و مقلة مبيضة المآقي ، % و أذن كحقمة الدباق % 115(@)(@@) % وجسد عليه جلد من وسخ ، % كأنه أشرب نفطا ، أو لطخ % % 116(@)(@@) % تخال تحت ابطه ، إذا عرق ، % لحية قاض قد نجا من الغرق % % 117(@)(@@) % و ريقه كمثل طوق من أدم ، % وليس من ترك السؤال يحتشم % % 118(@)(@@) % في صدره من واكف وقاطر % % كأثر الذرق على الكنادر % 119(@)(@@) % هذا كذا وما تركت أكثر ، % فجربوا ما قلته ، وفكروا % % PageV01P969 
