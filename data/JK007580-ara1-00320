ms301	 العبث الحنيف المخضرما(@)(@@) 3 وقد هاج في الإسلام كل مولد %~% وأطرب ذا نسك وآخر مجرما(@)(@@) 4 لك النصح مني لا أغاديك خاتلا %~% بمكر ، ولكني أغاديك مكرما(@)(@@) 5 إذا ما حذرت الصقر يوما فحاذري %~% أخا الإنس أياما ، وإن كان محرما(@)(@@) 6 يصوغ لك الغاوي ، قلادة هالك %~% من الدم تخبي وجدك المتضرما(@)(@@) 7 وكم سحتت كفاه مثلك في ضحى %~% شبيبتها ، إذ لم تر الدهر مهرما(@)(@@) 8 وراع ، بقهر ، من جناحك آمنا ، %~% فظل ، على الريش ، النهوض محرما(@)(@@) 9 كما قيد السلطان حلف جناية %~% ليقتص منه ، أو ليغرم مغرما(@)(@@) 10 فزوري وبار القفر من كل وابر ، %~% وإلا فرومي خلف ذلك مخرما PageV01P1398(@)(@@) 11 بحيث توافين الصحابي معوزا %~% من الناس والماء السحابي خضرما(@)(@@) 12 وحلي بقاف إن أطلقت بلوغه %~% فأفني لديه عمرك المتصرما(@)PageV01P1399(@)(@@) البحر : وافر تام(@)(@@) 1 عجبت له بنى بزجاج راح %~% دوين العقل سدا من حديد(@)(@@) 2 ولم يحتج إلى عون بقطر ، %~% ولم يك صاحب الأيد الشديد(@)(@@) 3 رأى شمس المدام تغور فيه %~% وتطلع من ذرى قدح جديد(@)(@@) 4 مقيما غير ذي سفر تكفى %~% بندمانيه من جم العديد(@)(@@) 5 كذي القرنين ، لكن ضل هذا ، %~% ويسر ذاك للرأي السديد(@)PageV01P1400(@)(@@) البحر : وافر تام(@)(@@) 1 كأني كنت في أزمان عاد ، %~% أعاشر آل قيل ، أو مريد(@)(@@) 2 وما عفت الحوادث عن شجاع %~% فتعفو عن عتيبة أو دريد(@)(@@) 3 أريد الآن مغفرة ، فإني %~% أراقب حتف مغفرة بريد(@)(@@) 4 وإن صوارد الأيام تأتي %~% على عقبانها ، وعلى الصريد(@)PageV01P1401(@)(@@) البحر : بسيط تام(@)(@@) 1 لو كان يدري أويس ما جنت يده %~% لاختار ، دون مغار الثلة ، العدما(@)(@@) 2 فإن من أقبح الأشياء يفعلها %~% شاكي المجاعة يوما ، أن يريق دما(@)(@@) 3 يا أوس هيهات كم قابلت هاجرة %~% أذكت عليك وقود الحر فاحتدما(@)(@@) 4 وكم طرقت عتودا بين أعنزة %~% وهنا ففريت عن أحشائه الأدما(@)(@@) 5 مطردا بت لم تبن الخيام ضحى ، %~% ولا تراع ، إذا ما بيتك انهدما(@)(@@) 6 وما كسوت إذا قر أتى جسدا %~% ولا حذوت ، حذارا للوجى ، قدما(@)(@@) 7 جمعت في أكل ربي سلة وردى %~% نفس 
ms302	 ، فهلا سرقت القرص والحدما(@)(@@) 8 قد يقصر النفس ، إعظاما لبارئه ، %~% على القفار منيب طالما ائتدما(@)(@@) 9 ألا تصوم لوجه الله محتسبا ، %~% أم غير صومك أمسى الهم والسدما(@)(@@) 10 أتضمر التوب من ضأن تروعها %~% أم كان ذلك داء فيكم قدما PageV01P1402(@)(@@) 11 ولو ظفرت على حال بحالية %~% جزأتها ونبذت السور والخدما(@)(@@) 12 وهل ندمت على طفل فجعت به %~% أما ، ومثلك لا يستشعر الندما(@)(@@) 13 ولا يوارى ، إذا حلت منيته %~% ولا إذا مات ، في غار له ردما(@)(@@) 14 وكم ثوى لك جد ما درى فطن ، %~% منكم ، على أي أمر ، إذ مضى قدما(@)PageV01P1403(@)(@@) البحر : كامل تام(@)(@@) 1 إركع لربك في نهارك واسجد ، %~% ومتى أطقت تهجدا فتهجد(@)(@@) 2 وإذ غلا البر النقي ، فشارك ال %~% الفرس الكريم وساو طرفك تمجد(@)(@@) 3 واجعل لنفسك من سليط ضيائها %~% أدما ، ونزر حلاوة من عنجد(@)(@@) 4 وارسم بفخار شرابك ، لا ترد %~% قدح اللجينشش ولا إناء العسجد(@)(@@) 5 يكفيك صيفك من ثيابك ساتر %~% وإذا شتوت فقطعة من برجد(@)(@@) 6 أنهاكأن تلي الحكومة أو ترى %~% حلف الخطابة أو إمام المسجد(@)(@@) 7 وذر الإمارة ، واتخاذك درة %~% في المصر تحسبها حسام المنجد(@)(@@) 8 تلك الأمور كرهتها لأقارب %~% وأصادق فآبخل بنفسك أو جد(@)(@@) 9 ولقد وجدت ولاء قوم سبة %~% فاصرف ولاءك للقديم الموجد(@)(@@) 10 ولتحل عرسك بالتقى فنظامه %~% أسنى لها من لؤلؤ وزبرجد PageV01P1404(@)(@@) 11 كل يسبح ، فافهم التقديس في %~% صوت الغراب ، وفي صياح الجدجد(@)(@@) 12 وانزل بعرضك في أعز محلة ، %~% فالغور ليس بموطن للمنجد(@)PageV01P1405(@)(@@) البحر : بسيط تام(@)(@@) 1 يدعو الغراب أناس حاتما ، سفها ، %~% لأنه بفراق عندهم حتما(@)(@@) 2 هذا التكذب ، ما للجون معرفة ، %~% ولا يبالي أنال المدح أم شتما(@)(@@) 3 السيد البر من لا يستجيز أذى %~% ولا يبوح بسر عنده كتما(@)(@@) 4 الغامر ، الطارق المحتاج نائله ، %~% إذا ابن مرية من أماته يتما(@)(@@) 5 لا يرفع الصوت بالقول الهراء ضحى %~% ولا يدب إلى جاراته عتما(@)(@@) 6 والعمر كالذابل الخطي قد بسطت %~% له كعوب ، ولكن بالردى ختما(@)PageV01P1406(@)(@@) البحر : كامل تام(@)(@@) 1 أكتم حديثك عن أخيك ، ولا تكن 
ms303	 %~% أسرار قلبك مثل أسرار اليد(@)(@@) 2 ولكل عصر حائد ، ومقدم %~% للحرب ، يضرب في جبين الأصيد(@)(@@) 3 فمضى يزيد ومخلد في دولة ، %~% وثنى الزمان إلى يزيد ومزيد(@)(@@) 4 وتقارب الأسماء ليس بموجب %~% كون التقارب في الفعالش الأزيد(@)(@@) 5 فالغمر نافى الغمر عند قياسه %~% والسيد غير مشابه للسيد(@)(@@) 6 وتدير الأوطان حب وطال ما %~% قنص الحملم على الغصون الميد(@)(@@) 7 ظلم الأنام ، فناص بيدك مفردا ، %~% حتى تعد من الرجال البيد(@)(@@) 8 ومتى رزقت شجاعة وبلاغة ، %~% أوطنت من ربع العلى بمشيد(@)(@@) 9 فالطير سؤددها الرفيع ، وعزها ، %~% قسمما على قسمائها والصيد(@)(@@) 10 وإذا الحمام أتى فما يكفيكه %~% نفر الجبان ، ولا حياد الحيد PageV01P1407(@)(@@) 11 ومقيد عند القضاء كمطلق %~% فيما ينوب ومطلق كمقيد(@)(@@) 12 فالظبية الغيداء ، صبحها الردى ، %~% أدماء ترتع في النبات الأغيد(@)(@@) 13 قدر يريك حليف ضعف أيدا %~% ويرد قرن الأيد ضد مؤيد(@)PageV01P1408(@)(@@) البحر : بسيط تام(@)(@@) 1 جاران : شاك ومسرور بحالته ، %~% كالغيث يبكي ، وفيه بارق بسما(@)(@@) 2 مال الدفين أتى الوراث فاقتسموا %~% ولم يراعوه في ثلث له قسما(@)(@@) 3 لا أطعموا منه مسكينا ، ولا بذلوا %~% عرفا ، ولا كفروا ، في حنثه ، قسما(@)(@@) 4 أوصى ، فلم يقبلوا منه ، وعاهدهم %~% فقابلوا بخلاف كل ما رسما(@)(@@) 5 والعيش داء ، وموت المرء عافية ، %~% إن داؤه ، بتواري شخصه ، حسما(@)(@@) 6 أنفاسه كخطاه ، والبقاء له %~% مسافة ، فهو يفنى كلما انتسما(@)(@@) 7 منازل الأنفس الأجساد يظعنها %~% وفد الحمام ، فكم من منزل طسما(@)PageV01P1409(@)(@@) البحر : كامل تام(@)(@@) 1 أما المجاور ، فارعه وتوقه ، %~% واستعف ربك من جوار الملحد(@)(@@) 2 ليس الذي جحد المليك ، وقد بدت %~% آياته ، بأخ لمن لم يجحد(@)(@@) 3 وأرى التوحد ، في حياتك ، نعمة ، %~% ف ' ن استطعت بلووغه فتوحد(@)PageV01P1410(@)(@@) البحر : بسيط تام(@)(@@) 1 لم يكفها نور خديها ونور نقا %~% في ثغرها ، فأصارت عشرها عنما(@)(@@) 2 كانت أضر لأهل النسك من صنم ، %~% فليبعد الله تلك الخود والصنما(@)(@@) 3 لم يغنم القيل ، عدت في الإماء له ، %~% بل مظهر الزهد في أمثالها غنما(@)PageV01P1411(@)(@@) البحر : كامل تام(@)(@@) 1 لا تبدأوني بالعداوة منكم ، %~% فمسيحكم عندي نظير محمد(@)(@@) 2 أيغيث 
ms304	 ضوء الصبح ناظر مدلج %~% أم نحن أجمع في ظلام سرمد(@)(@@) 3 كمه البصائر لا يبين لها الهدى %~% أو مبصر ، أبدا ، بعيني أرمد(@)(@@) 4 جسد يعذب في الحياة حسبته %~% مستشعرا حسد العظام الهمد(@)(@@) 5 إن السيوف تراح في أغمادها ، %~% وتظل في تعب ، إذا لم تغمد(@)(@@) 6 من لي بجسم لا يحس رزية %~% لكن يعد كتربة ، أو جلمد(@)(@@) 7 روح إذا اتصلت بشخص لم يزل %~% هو وهي ، في مرض العناء المكمد(@)(@@) 8 إن كنت من ريح فيا ريح آسكني %~% أو كنت من لهب ، فيا لهب اخمد(@)PageV01P1412(@)(@@) البحر : كامل تام(@)(@@) 1 كفي دموعك ، للتفرق ، واطلبي %~% دمعا يبارك مثل دمع الزاهد(@)(@@) 2 فبقطرة منه تبوح جهنم %~% - فيما يقال - حديث غير مشاهد(@)(@@) 3 خافي إلهك ، واحذري من أمة ، %~% لم يلبسوا في الدين قوب مجاهد(@)(@@) 4 أكلوا فأفنوا ثم غنوا وانتشوا %~% في رقصهم وتمتعوا بالشاهد(@)(@@) 5 حالت عهود الخلق ، كم من مسلم ، %~% أمسى يروم شفاعة بمعاهد(@)(@@) 6 وهو الزمان قضى بغير تناصف %~% بين الأنام فضاع جهد الجاهد(@)(@@) 7 سهد الفتى لمطالب ما نالها ، %~% وأصابها من بات ليس بساهد(@)PageV01P1413(@)(@@) البحر : بسيط تام(@)(@@) 1 نفضت عني ترابا ، وهو لي نسب ، %~% وذاك يحسب من قطع الفتى الرحما(@)(@@) 2 يا هون ما أوعد الله العباد به ، %~% إن صار جسمي في تحريقه فحما(@)(@@) 3 وإنما هو تخليد بلا أمد %~% تمضي الدهور وصالي النار ما رحما(@)PageV01P1414(@)(@@) البحر : كامل تام(@)(@@) 1 الله صورني ، ولست بعالم ، %~% لم ذاك ، سبحان القدير الواحد(@)(@@) 2 فلتشهد الساعات والأنفاس لي %~% أني برئت من الغوي الجاحد(@)PageV01P1415(@)(@@) البحر : بسيط تام(@)(@@) 1 إسمع مقالة ذي لب وتجرة %~% يفدك ، في اليوم ما في دهره علما(@)(@@) 2 إذا أصاب الفتى خطب يضر به %~% فلا يظن غوي أنه ظلما(@)(@@) 3 قد طال عمري طول الظفر ، فاتصلت %~% به الأذاة ، وكان الحظ لو قلما(@)PageV01P1416(@)(@@) البحر : كامل تام(@)(@@) 1 لا شام للسلطان ، إلا أن يرى %~% نعم البداوة كالنعام الطارد(@)(@@) 2 ويكون ، للبادين ، عذب مياهه ، %~% مثل المدامة لا تحل لوارد(@)(@@) 3 وتظل أبيات لهم شعرية %~% كبيوت شعر في 
ms305	 البلاد شوارد(@)(@@) 4 ويقوم ملك في الأنام ، كأنه %~% ملك يبرح بالخبيث المارد(@)(@@) 5 صنع اليدين بقتل كل مخالف %~% بالسيف يضرب في الحديد البارد(@)(@@) 6 قالوا : سيملكنا إمام عادل %~% يرمي أعادينا بسهم صارد(@)(@@) 7 والأرض موطن شرة وضغائن %~% ما أسمحت بسرور يوم فارد(@)(@@) 8 ولو أن فيها ناظرا ، كالمشتري ، %~% يعطي السعود وكاتبا كعطارد !(@)PageV01P1417(@)(@@) البحر : بسيط تام(@)(@@) 1 أما حياتي فما لي عندها فرج %~% فليت شعري عن موتي إذا قدما(@)(@@) 2 صحبت عيشا أعانيه ويغلبني %~% مثل الوليد يقود المصعب السدما(@)(@@) 3 وقد مللت زمانا شره لهب %~% إذا دنا لخبو ، عاد فاحتدما(@)(@@) 4 من باعني بحياتي ميتة سرحا ، %~% بايعته ، وأهان الله من ندما(@)(@@) 5 إذا أظلت من الإهواء مهلكة %~% فلا تهيب رداها وامضين قدما(@)(@@) 6 والنفس تسمو ، فإن تسغب فبغيتها %~% قوت ، متى أعطيته حاولت أدما(@)(@@) 7 في طبعها حبها الدنيا ، وقد علمت %~% أن المنية فينا حادث قدما(@)(@@) 8 والخير أجمع في غبراء تأدم بي %~% هذا التراب ، ويفري الجسم والأدما(@)(@@) 9 فالآن شارفت جيش الحتف ، واقتربت %~% دار أكاد إليها أرفع القدما(@)(@@) 10 حم القضاء ، فما يرثي لباكية ، %~% ولو أفاضت على إثر الدموع دما PageV01P1418(@)(@@) 11 من يغن يخدمه أقوام على طمع %~% ولا يرون لمن أخطا الغنى خدما(@)(@@) 12 والله صور أشباحا لها خبر %~% والشخص بعد وجود يقتضي عدما(@)(@@) 13 وشاد إيوان كسرى معشر طلبوا %~% ثباته ، وتمادى الوقت فانهدما(@)PageV01P1419(@)(@@) البحر : كامل تام(@)(@@) 1 جهل مرامي أن تكون موافقي ، %~% وشكوك نفسي بينهن تعادي(@)(@@) 2 ليس التكثر من خليقة صادق %~% فاذهب لعادك أستمر لعادي(@)(@@) 3 لو كان لي غيم لجاد بمائه ، %~% من غير إبراق ، ولا إرعاد(@)(@@) 4 أخلف ، إذا أوعدت غافر زلة %~% من جارم وأنل بلا ميعاد(@)(@@) 5 ولقد غدوت لأمة وبإمة %~% قزميتين وهمة من عاد(@)(@@) 6 والجسم يهوي بالطباع إلى الثرى ى %~% ويبين فيه تكلف الإصعاد(@)(@@) 7 وإخال نفسي حين تفقد شخصها %~% تلقى الذي عملته قبل معاد(@)(@@) 8 لا تشربن ما عشت من دم أبيض %~% سبط ، ولا سوود يلحن جعاد(@)(@@) 9 دعة ، لمثلك ، ترك دعد للنوى ، %~% وسعادة 
ms306	 لك هجرة لسعاد(@)(@@) 10 لم تبلغالآراب شدة ساعد %~% ما لم يعنها الله بالإسعاد(@)PageV01P1420(@)(@@) البحر : بسيط تام(@)(@@) 1 إن شئت أن تحفظي من أنت صاحبة %~% له ، فلا تدخلي في المصر حماما(@)(@@) 2 وإن بدوت فلا يؤنسك مرشفة %~% ضحى ، تناجين سوارا وزماما(@)(@@) 3 فكم عصيتن من ناه وناهية ؛ %~% وكم فضحتن آباء وأعماما(@)(@@) 4 ما صانكن سوى الأزواج من أحد ؛ %~% وأول الدهر أعييتن هماما(@)(@@) 5 وما بكيت رميما ، وهي نائية ، %~% فلا تعرض لها ، في النوم ، إلماما(@)(@@) 6 إذا تولت على هجر ومقلية(@)PageV01P1421(@)(@@) البحر : كامل تام(@)(@@) 1 أروى دم قلبا ، وتلك سفاهة ؛ %~% - والدهر من عجل ومن إرواد(@)(@@) 2 فروائح ، وبواكر ، ومعارف ، %~% ومناكر ، وحواضر ، وبواد(@)(@@) 3 وجواد قوم ، عد من بخلائهم ، %~% وحليف بخل عد في الأجواد(@)(@@) 4 والخلق أطوار ، يزيل شخوصهم ، %~% بعد المثول ، مثبت الأطواد(@)(@@) 5 شيم ، من الدنيا ، يجاز بها المدى ، %~% ستشاكل الأذواء بالأذواد(@)(@@) 6 واد من الموت الزؤام ، وكلنا %~% أشفى ليدفع فوق جرف الوادي(@)(@@) 7 سفر يطول من الأنام على كرى %~% من غفلة وكرى من الأزواد(@)(@@) 8 وأوادم الزمن الطويل كثيرة ، %~% وأوادم الطعم الشهي أواد(@)(@@) 9 وأمض من ثقل العيادة للفتى %~% نوب تكون عوادي العواد(@)(@@) 10 لا يفجعنك ، والخطوب كثيرة ، %~% أن الغوادر ، للفراق ، غواد PageV01P1422(@)(@@) 11 عمدت لنا الأيام فهي دوائب %~% لترد أقداما مكان هواد(@)(@@) 12 فطوارق جاءتهم بطوارد ، %~% ونوادب قامت لهم بنواد(@)(@@) 13 هم بأسودة القلوب ، مناخه %~% للبض حين أنخن بالأفواد(@)PageV01P1423(@)(@@) البحر : وافر تام(@)(@@) 1 دموعي لا تجيب على الرزايا ، %~% ولولا ذاك ما فتئت سجوما(@)(@@) 2 رضا بقضاء ربك ، فهو حتم ، %~% ولا تظهر ، لحادثة ، وجوما(@)(@@) 3 ولم زحلا أو المريخ فيها %~% ولا تلم الذي خلق النجوما(@)(@@) 4 ولست أقول : إن الشهب ، يوما ، %~% لبعث محمد جعلت رجوما(@)(@@) 5 فأمسك غرب فيك ، ولا تعود ، %~% على القول الجراءة والهجوما(@)PageV01P1424(@)(@@) البحر : كامل تام(@)(@@) 1 أذكر إلهك إن هببت من الكرى %~% وإذا هممت لهجعة ورقاد(@)(@@) 2 إحذر مجيئك ، في الحساب ، بزائف ، %~% فالله ربك أنقد النقاد(@)(@@) 3 تغشى جهنم دمعة من تائب %~% فتبوخ وهي شديدة الإيقاد(@)PageV01P1425(@)(@@) البحر : وافر تام 
ms307	(@)(@@) 1 وجدت الموت للحيوان داء ، %~% وكيف أعالج الداء القديما !(@)(@@) 2 وما دنياك إلا دار سوء ، %~% ولست على إساءتها مقيما(@)(@@) 3 أرى ولد الفتى عبئا عليه ، %~% لقد سعد الذي أمسى عقيما(@)(@@) 4 أما شاهدت كل أبي وليد ، %~% يؤم طريق حتف مستقيما ؟(@)(@@) 5 فإما أن يربيه عدوا ، %~% وإما أن يخلفه يتيما(@)PageV01P1426(@)(@@) البحر : كامل تام(@)(@@) 1 قلدتني الفتيا فتوجني غدا %~% تاجا بإعفائي من التقليد(@)(@@) 2 ومن الرزية أ ، يكون فؤادك %~% الوقاد في جسد عليه بليد(@)(@@) 3 وحوادث الأيام تولد جلة %~% وتعود تصغر ضد كل وليد(@)PageV01P1427(@)(@@) البحر : وافر تام(@)(@@) 1 أجسما فيه هذي الروح ، هلا %~% غبطت ، لفقدها الألم ، السلاما(@)(@@) 2 أجدك لن ترى الإنسان إلا %~% قليل الرشد محتملا ملاما(@)(@@) 3 وتحمله الغريزة ، وهو شيخ ، %~% على ما كان يفعله غلاما(@)(@@) 4 وأيسر من ركوب الظلم ، جهلا ، %~% ركوبك في مآربك الظلاما(@)(@@) 5 وقد يبغي السلامة مستجير ، %~% فيترك ، من مخافته ، السلاما(@)(@@) 6 وكم حلم الأديم من ابن دهر %~% حديث السن ما بلغ احتلاما(@)PageV01P1428(@)(@@) البحر : كامل أحذ(@)(@@) 1 إن شئت كل الخيرش يجمع في %~% الأولى فبت كالصارم الفرد(@)(@@) 2 ماذا يروقالعين من أشر %~% عقباه صائرة إلى درد(@)(@@) 3 وتصاغ ، للبيض ، الأساور من %~% لبس الأساور سابغ الزرد(@)(@@) 4 وأمن على المال الرجال ولا %~% تأمنهم أبدا على الخرد(@)PageV01P1429(@)(@@) البحر : كامل تام(@)(@@) 1 قال المنجم والطبيب كلاهما : %~% لا تحشر الأجساد ، قلت إليكما(@)(@@) 2 إن صح قولكما فلست بخاسر ، %~% أو صح قولي ، فالخسار عليكما(@)(@@) 4 طهرت ثوبي للصلاة ، وقبله %~% طهر ، فأين الطهر من جسديكما(@)(@@) 5 وذكرت ربي في الضمائر مؤنسا %~% خلدي بذاك ، فأوحشا خلديكما(@)(@@) 6 وبكرت في البردين أبغي رحمة %~% منه ، ولا ترعان في برديكما(@)(@@) 7 إن لم تعد بيدي منافع بالذي %~% آتي ، فهل من عائد بيديكما ؟(@)(@@) 8 برد التقي ، وإن تهلل نسجه ، %~% خير بعلم الله من برديكما(@)PageV01P1430(@)(@@) البحر : كامل تام(@)(@@) 1 قد يرفع الأقوام إن سئلوا : %~% هل تخفضون ؟ وقولهم : ربما(@)(@@) 2 يسقون في القيظ الحميم ، وفي %~% حين الصنابر باردا شبما(@)(@@) 3 الناصبين ، لماء شربهم ، %~% قاماتهم ، والناصبين بما(@)PageV01P1431(@)(@@) البحر : كامل تام(@)(@@) 1 
ms308	 لا تكرموا جسدي ، إذا ما حل بي %~% ريب المنون ، فلا فضيلة للجسد(@)(@@) 2 كالبرد كان على اللوابس نافقا %~% حتى إذا فنيت بشاشته كسد(@)(@@) 3 أرواحنا ظلمت فتلك بيوتها %~% درس خوين منالضغائن والحسد(@)(@@) 4 واروه من قبل الفساد فإنه %~% جسم إذا فقدت حرارته فسد(@)(@@) 5 لا تغبطوا رجلا على ما ناله %~% إن بات قد ساد الرجال ، ولم يسد(@)(@@) 6 فحوادث الأيام غير توارك %~% نسر النجوم ، ولا السماك ، ولا الأسد(@)PageV01P1432(@)(@@) البحر : -(@)(@@) 1 قال زمان الناس في صفوه ، قال زمان الناس في صفوه ، %~% وربه سلاك أو هيما(@)(@@) 2 كم غادة لي ، أيما غادة ، %~% غادرتها من بعلها أيما(@)(@@) 3 كانت نظير الشمس ، في خدرها ، %~% وغيبت عنه ، فقد غيما(@)(@@) 4 لا تحمل المرأة علما بأن %~% علما بأن الحس(@)(@@) 5 إن خيمت ، أو ظعنت للسرى ، %~% فهو على أسرارها خيما(@)(@@) 6 ترائب نعمها قيم %~% فصير الترب لها قيما(@)PageV01P1433(@)(@@) البحر : مجزوء الرجز(@)(@@) 1 ما جلب الخير إلى %~% صاحب عقل فكسد(@)(@@) 2 أشد خطب يتقد %~% فراق روح وجسد(@)(@@) 3 يذكر أن سوف يعم %~% أهل شر وحسد(@)(@@) 4 طوفان نار كائن ، %~% يخرج من قلب الأسد(@)(@@) 5 أصيغة العالم ذا ، %~% أم طال دهر ففسد(@)(@@) 6 أهون ، من سؤالهم ، %~% حطبك في ريح وسد(@)(@@) 7 إن لم يجئك ، بغنى ، %~% يوم ، فقد سد مسد(@)PageV01P1434(@)(@@) البحر : سريع(@)(@@) 1 ألمم بدار النسك إلمامه %~% فالنفس بالباطل همامه(@)(@@) 2 وإن رأيت الخود مختاله %~% يصلح أن تجعل شمامه(@)(@@) 3 تطرح في الموم الفتى واسمها %~% أسماء أو زينب أو مامه(@)(@@) 4 فعد عنها وتعوض بها %~% سوداء ، للأينق ، زمامه(@)(@@) 5 غمازة ، في الجنح ، ضحاكة %~% لأسقيات الحي رمامه(@)(@@) 6 قد حدثت سرك طلابه %~% عين بما في الصدر نمامه(@)(@@) 7 وشر ما أعطيه مكثر %~% يد ، لما تملك ضمامه(@)PageV01P1435(@)(@@) البحر : طويل(@)(@@) 1 أجم رحيلي ما أجمت مواردي ، %~% وكان دخولي في ذوي العدد الجم(@)(@@) 2 أشمس نهاري كم خلت لك حجة %~% فهل لك من خال فيعرف ، أو عم ؟(@)(@@) 3 لعمري ! لقدما صاغك الله قادرا %~% بغير أب ، عند القياس ، ولا أم(@)(@@) 4 رحمتك يا مخلوقة الإنس 
ms309	 ، إنما %~% حياتك موت ، والمطاعم كالسم(@)(@@) 5 فإن تحرمي عقلا سعدت لغبطة ؛ %~% وإن ترزقيه فهو مبتعث الهم(@)(@@) 6 ولن يجمع الناس ، الذين رأيتهم ، %~% على الحمد ، لكن يجمعون على الذم(@)PageV01P1436(@)(@@) البحر : متقارب تام(@)(@@) 1 إذا اجتمع اثنان ، في منزل ، %~% على خزية فضحا للأبد(@)(@@) 2 تبد الحظوظعلى أهلها %~% ولكن تباد ، ومن لم يبد(@)(@@) 3 وفي وحدة المرء ستر له %~% فكن مثل سيفك حلف الربد(@)(@@) 4 ولا تعرضن لبنت الكروم %~% أخت الشرور وأم الزبد(@)(@@) 5 فإن وسعت للفتى ساعة %~% فسوف تغادره في كبد(@)(@@) 6 وما زلت بعد غراب الصبا %~% قرين البزاة فقع يا لبد(@)PageV01P1437(@)(@@) البحر : طويل(@)(@@) 1 لعمري ! لقد أغنتك صورة واحد %~% من الإنس ، في الأقوام عن كنية واسم(@)(@@) 2 ولكن بيان زيد فيك ، وإنما %~% جرينا من الأمر القديم على رسم(@)(@@) 3 وما كان فينا من سجية مخطىء ، %~% فقد وجدت في حي عاد وفي طسم(@)(@@) 4 إذا ما تفرقنا خلصنا من الأذى ، %~% ولم يحوج الراعي المسيم إلى الوسم(@)(@@) 5 تحمل عن الأرض المريضة غاديا ، %~% ولا ترض للداء العياء سوى الحسم(@)(@@) 6 وما فتئت روح الفتى في نوائب %~% تمارسها ، حتى استقلت عن الجسم(@)(@@) 7 صبرنا لحكم الله ، والنفس حرة ، %~% وقد علمت فضل التفاوت في القسم(@)PageV01P1438(@)(@@) البحر : متقارب تام(@)(@@) 1 يسمون بالجهل عبد الرحيم %~% وعبد العزيز ، وعبد الصمد(@)(@@) 2 وما بلغوا أن يكونوا له %~% عبيدا ، وذلك أقصى الأمد(@)(@@) 3 ولكنه خالق العالمين : %~% ذائب أجزائهم والجمد(@)(@@) 4 تعمده يغنك ، بالهدي ، أن %~% تدرس مغنيهم ، والعمد(@)(@@) 5 إذا كان ما نالني ، بالقضاء ، %~% فمن سوء رأيي طول الكمد(@)(@@) 6 ولم يبق ، في الأمر ، من حيلة ، %~% فيقصر من عمر ، أو يمد(@)(@@) 7 وإن ثمودا أتت بحرهم %~% خطوب فما تركت من ثمد(@)(@@) 8 رأيت الفتى شب حتى انتهى ، %~% وما زال يفنى إلى أن همد(@)(@@) 9 كمصباح ليل بدا يستنير ، %~% ثم تناقص حتى خمد(@)(@@) 10 ولولا الذي بان من حكمه ، %~% لقلنا : طويل زمان سمد PageV01P1439(@)(@@) 11 إذا طفئت في الثرى أعين %~% فقد أمنت من عمى أو رمد(@)PageV01P1440(@)(@@) البحر : متقارب تام(@)(@@) 1 تغيبت في منزلي 
ms310	 برهة %~% ستير العيوب فقيد الحسد(@)(@@) 2 فلما مضى العمر ، إلا الأقل ، %~% وحم لروحي فراق الجسد(@)(@@) 3 بعثت شفيعا إلى صالح ، %~% وذاك ممن القوم رأي فسد(@)(@@) 4 فيسمع مني سجع الحمام %~% وأسمع منه زئير الأسد(@)(@@) 5 فلا يعجبني هذا النفاق %~% فكم نفقت محنة ما كسد(@)PageV01P1441(@)(@@) البحر : طويل(@)(@@) 1 تمنيت أني من هضاب يلملم ، %~% إذا ما أتاني الرزء لم أتلملم(@)(@@) 2 فمي أخذت منه الليالي ، وإنني %~% لأشرب منه في إناء مثلم(@)(@@) 3 وأودى بظلم الثغر صبح وحندس %~% متى ينظرا في نير العين يظلم(@)(@@) 4 فذاهبنا كالترب ليس بناطق %~% وغابرنا مثل الأسير المكلم(@)(@@) 5 يحبب دنيانا إلينا قطينها %~% فمن ينأ عنهم يسل عنها ويسلم(@)(@@) 6 متى تنفرد لا تغبط المال مثريا ، %~% ويستغن لا يجهل ولا يتحلم(@)(@@) 7 ومن شأن هذا الخلق غش وظنة ، %~% ومن يتقرب منهم يتظلم(@)(@@) 8 فإن يسأل الباقي الثرى عن معاشر %~% ألمت به ، يخبر ولا يتكلم(@)(@@) 9 وكان حلول الروح في الجسم نكبة %~% على خير معيا ، أو على شر معلم(@)(@@) 10 فهل كف وقت لم يكن لعطارد %~% شبا ظفر في الأربعاء مقلم PageV01P1442(@)(@@) 11 هي الدار يثويها الفتى ثم يغتدي ، %~% ويتركها للوارث المتسلم(@)PageV01P1443(@)(@@) البحر : طويل(@)(@@) 1 أشد عقابا من صلاة أضعتها %~% وصوم ليوم واجب ، ظلم درهم(@)(@@) 2 إذا لم يكن يوما لديني تعلق . . . %~% بغيري ، رجيت السعادة ، فافهم(@)(@@) 3 وعشت صنوف العيش ، كهلا وشارخا ؛ %~% فيا لحياة كاليماني المسهم(@)(@@) 4 وأعجب للهرار سمي ضيغما %~% وللعير يدعى بالجواد المطهم(@)(@@) 5 وما جدل الأقوام إلا تعلة %~% مصورة عن باطل متوهم(@)PageV01P1444(@)(@@) البحر : طويل(@)(@@) 1 إذا لم يكن للميت أهل فقلما %~% يزور أناس قبره للتذمم(@)(@@) 2 وإن مست الأرزاء نفسك لم يكن %~% لها ناصر إلا بحسن التغمم(@)(@@) 3 وهل رد حيا مالك بن نويرة %~% نكير علي أو بكاء متمم ؟(@)(@@) 4 زممت المطايا للوجيف ، ولم تكن %~% تنال المعالي بالمطي المزمم(@)(@@) 5 ولكن بأطراف القنا وكعوبه ، %~% وضرب الهوادي بالحديد المسمم(@)(@@) 6 وجذب رداء يدرج النمل فوقه %~% لتعميم رأس الهبرزي المعمم(@)(@@) 7 رويدك ! لم تبلغ ، من الدهر ، لذة ، %~% إذا لم 
ms311	 تعش عيش الغبي المذمم(@)(@@) 8 وتسمع فيه ما يصم ذوي النهى ، %~% فلا روح إلا بالحمام المصمم(@)(@@) 9 وحظك فيه نبذة الفيل ، إن دنا %~% إليها نأت عن أنفه بالتشمم(@)(@@) 10 وأخلقني مر الزمان وكره %~% فصار أديمي كالسقاء المرمم PageV01P1445(@)(@@) 11 فعد ، جسدي ، للعنصر الطهر تسترح %~% إذا صرت تقضي الفرض عند التيمم(@)PageV01P1446(@)(@@) البحر : بسيط تام(@)(@@) 1 يا لهف نفسي على أني رجعت إلى %~% هذي البلاد ، ولم أهلك ببغداذا(@)(@@) 2 إذا رأيت أمورا لا توافقني %~% قلت : الإياب إلى الأوطان أدى ذا(@)PageV01P1447(@)(@@) البحر : طويل(@)(@@) 1 أرى جزء شهد بين أجزاء علقم ، %~% ولبا ينادي باللبيب : لتعقم(@)(@@) 2 وأسقام دين ، إن يرج شفاءها %~% صحيح ، يطل منه العناء ويسقم(@)(@@) 3 وصبحا وإظلاما كأن مداهما %~% من السر ، في لونيهما ، برد أرقم(@)(@@) 4 وحكما لهذا الدهر ، صاح بقائم %~% من العالم : اجلس ، أو دعا جالسا : قم(@)(@@) 5 كأن سرور النفس من خطإ الفتى ، %~% متى ما يكن ينكر عليه فينقم(@)PageV01P1448(@)(@@) البحر : طويل(@)(@@) 1 مناطق غلمان وأحجال أنس %~% تغر ، وأعمال الفتى بالخواتم(@)(@@) 2 وكم ذلة مدت أياد لدفعها %~% وقد علقت من أهلها بالعراتم(@)(@@) 3 فإن عديا فر من خوف نكبة ، %~% وآضت سبيا أخته بنت حاتم(@)(@@) 4 وما زالت الحمر الزواهر للقرى %~% تكشف غمات الوجوه القواتم(@)(@@) 5 فقارب وباعد ، واحب وابخل ولا تقل %~% وقولن وجاهر بالمراد وكاتم(@)(@@) 6 لكل زمان أسرة ، ليس أنجم %~% بدت مغربا مثل النجوم العواتم(@)(@@) 7 أنعمان ما سر ابن حنتمة الذي %~% سررت به ، من شرب ما في الحناتم(@)(@@) 8 وأحسن من مدح امرئ الصدق عنده %~% بما ليس فيه ، رميه بالمشاتم(@)(@@) 9 تشابه أهل الأرض : عبد وسيد ، %~% وما قيل في أعراسهم والمآتم(@)(@@) 10 هم أسفوا للخطب موجب فرحة %~% وهشوا لأمر ، وهو إحدى السلاتم PageV01P1449(@)(@@) 11 وقد هدم النعمى هميم بن غالب %~% لما سار من أقواله في الأهاتم(@)(@@) 12 وأجمل من سوق المئين سكوته %~% عن الفخر ، والأفواه رهن الرواتم(@)PageV01P1450(@)(@@) البحر : كامل أحذ(@)(@@) 1 يا واعظي بالصمت ! ما لك لا %~% تلقي إلي حديثك اللذا(@)(@@) 2 ترى المرء جبار الحياة وإن دنت(@)(@@) 2 إن الجديدين 
ms312	 ، اللذين هما %~% سبقان ، بذاني وما بذا(@)(@@) 3 كالنابلين غدت سهامهما %~% ليست مريشة ولاقذا(@)(@@) 4 وكأن ، للساعات ، أجنحة ، %~% فإخالهن بها قطا حذا(@)(@@) 6 قدر ينادي الحتف من كثب %~% دع ذا إلى الميقات لأو خذ ذا(@)(@@) 7 أملي بياض الصبح أنبته ، %~% وعهدته بالأمس منجذا(@)(@@) 8 خل السرور لمن يغر به %~% وآغبدإلهك واحدا فذا(@)PageV01P1451(@)(@@) البحر : طويل(@)(@@) 1 أخفت حلوم الناس أم كان من مضى ، %~% من القوم ، جهالا خفاف حلوم ؟(@)(@@) 2 فلا تأسفن الشاة إن أدني ابنها %~% لشفرة عات للرجال ظلوم(@)(@@) 3 فلو حمل الخضراء أصبح بينهم %~% لآض ذبيحا ، أو نجا بكلوم(@)(@@) 4 أناس متى تهرب إلى القبر منهم ، %~% فأنت ، بعلم الله ، غير ملوم(@)PageV01P1452(@)(@@) البحر : طويل(@)(@@) 1 متى ما تشاهد نعمة ، كنعامة %~% مطردة ، ترتع بألف ظليم(@)(@@) 2 ونخشى عذابا في الممات ، وإننا %~% لأهل عذاب ، في الحياة ، أليم(@)(@@) 3 وما كذبتني لأمتي إن لأمتي ، %~% إذا ادرع الأقوام ، ثوب مليم(@)(@@) 4 فيا ليت يومي يوم أشعث عامل %~% وليلي ، من الإشفاق ، ليل سليم(@)(@@) 5 وما كنت في الرزء الجليل بصابر ؛ %~% ولا عند خطب ، هزني ، بحليم(@)(@@) 6 وأشعر أن العقل يصحب تارة %~% وينفر أخرى ، وهو غير عليم(@)(@@) 7 وقال أناس ليس عيسى مقربا %~% فقيل : ولا موساكم بكليم(@)PageV01P1453(@)(@@) البحر : وافر تام(@)(@@) 1 لو انك ، مثل ما ظنوا ، كريم ، %~% لما فتنتك بنت الكرم هذي(@)(@@) 2 ولا أصبحت فاقد كل عقل ، %~% تباذي ، في المجالس ، أو تهاذي(@)PageV01P1454(@)(@@) البحر : طويل(@)(@@) 1 نصحتك لا تقدم على فعل سوءة ؛ %~% وخف من إله للزمان قديم(@)(@@) 2 بنو آدم لم أدر ما غرض الذي %~% نماهم ، وهل فيهم صحيح أديم ؟(@)(@@) 3 ولست ترى إلا عليما كجاهل ، %~% على علمه ، أو مثريا كعديم(@)(@@) 4 وما عندهم من خيرة لمعاشر ؛ %~% وكم من مدام برحت بمديم(@)(@@) 5 فلا تشربنها ما حييت ، وإن تمل %~% إلى الغي ، فاشربها بغير نديم(@)PageV01P1455(@)(@@) البحر : كامل تام(@)(@@) 1 من يوق لا يكلم وإن عمدت له %~% نبل تغادر شخصه كالقنفذ(@)(@@) 2 بلغته مرهفة النصال وأثبتت %~% فيما عليه ، وكلها لم تنفذ(@)PageV01P1456(@)(@@) البحر : طويل(@)(@@) 1 إذا لم تكن دنياك دار إقامة 
ms313	 %~% فما لك تبنيها بناء مقيم ؟(@)(@@) 2 أرى النسل ذنبا للفتى لا يقاله ، %~% فلا تنكحن الدهر غير عقيم(@)(@@) 3 فحال وحيد لم يخلف مناسبا ، %~% تشابه حالي عامر وتميم(@)(@@) 4 وأعجب من جهل الذين تكاثروا %~% بمجد لهم ، من حادث وقديم(@)(@@) 5 وأحلف ، ما الدنيا بدار كرامة ، %~% ولا عمرت من أهلها بكريم(@)(@@) 6 سأرحل عنها لا أؤمل أوبة %~% ذميما تولى عن جوار ذميم(@)(@@) 7 وما صح ود الخل فيها ، وإنما %~% تغر بود ، في الحياة ، سقيم(@)(@@) 8 فلا تتعلل بالمدام ، وإن تجز %~% إليها الدنايا ، فاخش كل نديم(@)(@@) 9 وجدت بني الدنيا ، لدى كل موطن ، %~% يعدون فيها شقوة كنعيم(@)(@@) 10 تزيدك فقرا كلما ازددت ثروة %~% فتلقى غنيا في ثياب عديم PageV01P1457(@)(@@) 11 فساد وكون حادثان كلاهما %~% شهيد بأن الخلق صنع حكيم(@)PageV01P1458(@)(@@) البحر : طويل(@)(@@) 1 إذا بلغ الإنسان خمسين حجة ، %~% فلا يمتهن دينا برد سلام(@)(@@) 2 ليشغل بذكر الله عن كل شاغل %~% فذلك عند اللب خير كلام(@)(@@) 3 ومن شيم الأيام ، وهي كثيرة ، %~% فناء كبير واقتبال غلام(@)(@@) 4 ملام لنفسي حق عندي لمثلها %~% وكنت حقيقا عندها بملام(@)(@@) 5 وإظلام عين ، بعده ظلمة الثرى ؛ %~% فقل في ظلام زيد فوق ظلام(@)PageV01P1459(@)(@@) البحر : طويل(@)(@@) 1 جرى المين فيهم ، كابرا بعد كابر ، %~% عن الخبر يحكى لا عن السلف الحبر(@)(@@) 2 خبرت بني الدنيا وأصبحت راغبا %~% إليهم ، كأني ما شفاني بهم خبر(@)(@@) 3 جبلة ظلم ، لا قوام بحربها ، %~% وصيغة مكسور ما لمكسورها جبر(@)(@@) 4 تلاوتكم ليست لرشد ، ولا هدى %~% ولكن لكم فيها التكاثر والكبر(@)(@@) 5 %~% بعشرين ، ما فيها ادغام ولا نبر(@)(@@) 6 وما العيش إلا عبر أسفار ظاعن %~% لمقلته مما يمارسه العبر(@)(@@) 7 تغبرتها بالسير حتى تركتها %~% طليح ركاب ما لأخلاقها غبر(@)(@@) 8 وقد مات من بعد التغشمر جهلها %~% فغيب ، إلا أن هامتها القبر(@)(@@) 9 حديث أتانا عن يمان ومشئم %~% وأولى البرايا ، بالذي فري ، الكبر(@)(@@) 10 خف الله ، حتى في جنى النحل ذقته ، %~% فما جمعت إلا لأنفسها الدبر PageV01P1460(@)(@@) 11 إذا أنت زوجت العجوز على الصبا %~% فأيامها صن ، عليك ، وصنبر(@)(@@) 12 وتطم أرماح 
ms314	 الوغى إبر صغا %~% بها القول : كم طعن يهيجه أبر(@)(@@) 13 وصبرك فضل فيك إنء كنت قادرا %~% وإلا فعجز من خلائقك الصبر(@)(@@) 14 لقاؤك ما فيه ، لمثلي ، خيرة ، %~% ولالك فانظر أين يلتمس الشبر(@)PageV01P1461(@)(@@) البحر : طويل(@)(@@) 1 بدا شيبه مثل النهار ، ولم يكن %~% يشابه فجرا ، أو نجوم ظلام(@)(@@) 2 يحدثها ما لا تريد استماعه ، %~% ولم يبق ، عند الشيخ ، غير كلام(@)(@@) 3 تقول له في النفس ، غير مبينة %~% خذ المهر مني وانصرف بسلام(@)(@@) 5 تود لو ان الله أعطاه حتفه %~% وكيف لها ، من بعده ، بغلام ؟(@)PageV01P1462(@)(@@) البحر : طويل(@)(@@) 1 أرى البحر ملحا لا يجود لوارد %~% بورد ، فعومي في السراب وعامي(@)(@@) 2 تميلين عن نهج اليقين ، كأنما %~% سرى بك أعمى ، أو عراك تعامي(@)(@@) 3 سمام أفاع في اهتضام خوادر %~% وختل ذئاب في حلوم نعام(@)(@@) 4 وكم مر عام لم أكن بعض أهله ؛ %~% وكم نبذت ، خلفي ، أهلة عام(@)(@@) 5 فبعدا لنفس لا تزال ذليلة %~% لحب شراب أو لحب طعام(@)PageV01P1463(@)(@@) البحر : طويل(@)(@@) 1 بيوت فمهدوم يرى ومقوض %~% بكسر ، وبيت من قريض له كسر(@)(@@) 2 حوادث فيها رائحات ومغتد %~% وأمران عسر في البرية أة يسر(@)(@@) 3 فإن رجالا كان نسر لديهم %~% إلها ، عليهم ، قبلنا ، طلع النسر(@)(@@) 4 وعاشوا يرون اليسر إفضال مكثر %~% على مقتر ثم انقضى الناس واليسر(@)(@@) 5 لهم سنة ألا يضيع معدم %~% إذا سنة أزرى بأنجمها الأسر(@)(@@) 6 وما ربح الدنيا بممكن تاجر %~% على حالة ، بل كل أعمالها خسر(@)(@@) 7 حياة كجسر بين موتين : أول %~% وثان ، وفقد الشخص أن يعبر الجسر(@)PageV01P1464(@)(@@) البحر : طويل(@)(@@) 1 دعي ، وذري ، الأقدار تمضي لشأنها ، %~% فلم تحم ملكا لا دمشق ولا مصر(@)(@@) 2 ولا الحرة السوداء حاطت سيادة ؛ %~% ولا البصرة البيضاء حصنها البصر(@)(@@) 3 نروم قياسا للحوادث ضلة %~% وتلك أصول ليس يجمعها حصر(@)(@@) 4 وعند ضياء الفجر صليت الضحى %~% وعند غروب الشمس أذنت العصر(@)(@@) 5 وما يجمل التقصير في كل موطن ، %~% وكل مفروض الصلاة له قصر(@)(@@) 6 إذا لم يكن بد من الموت فلقه %~% أفض به الفودان أم فري الخصر(@)(@@) 7 علي 
ms315	 مضى ، من بعد نصر وعزة ؛ %~% وحمزة أودى قبل أن ينزل النصر(@)(@@) 8 فإني أرى ذرية الشيخ آدم %~% قديما ، عليهم ، بالردى ، أخذ الإصر(@)PageV01P1465(@)(@@) البحر : بسيط تام(@)(@@) 1 نحس الحياة ، على الأحياء ، مشتمل ؛ %~% وساكنو الأرض في لؤم بلا كرم(@)(@@) 2 فالبعد للعيش أداني إلى تلف ؛ %~% وللشبيبة قادتني إلى الهرم(@)(@@) 3 لا يعجبنك إقبال يريك سنا ، %~% إن الخمود _ لعمري _ غاية الضرم(@)(@@) 4 وهي السعادة للحجرين : فائزة %~% مغنى ثمود وحجر البيت والحرم(@)(@@) 5 لا فرق بين بني فهر وغيرهم %~% في دولة ، وشهور الحل كالحرم(@)(@@) 6 قد أبرمت هذه الأجزاع ، لا سأما %~% بالزائرين ، ولكن طبن عن برم(@)PageV01P1466(@)(@@) البحر : بسيط تام(@)(@@) 1 كل البلاد ذميم لا مقام به %~% وإن حللت ديار الوبل والرهم(@)(@@) 2 إن الحجاز عن الخيرات محتجز %~% وما تهامة إلا معدن التهم(@)(@@) 3 والشام شوم ، وليس اليمن في يمن %~% ويثرب الآن تثريب على الفهم(@)PageV01P1467(@)(@@) البحر : طويل(@)(@@) 1 إذا كنت قد جاوزت خمسين حجة %~% ولم ألق خيرا فالمنية لي ستر(@)(@@) 2 وما أتوقى والخطوب كثيرة %~% من الدهر ، إلا أن يحل بي الهتر(@)(@@) 3 أحاديث عن قيل بن عتر ورهطه ، %~% رويدك ما قيل ووالده عتر ؟(@)(@@) 4 عدت أمنا الدنيا غلينا مسيئة %~% لها ، عندنا ، من كل ناحية وتر(@)(@@) 5 ونحن كركب الموج ما بين بعضهم %~% وبين الردى ، إلا الذراع أو الفتر(@)PageV01P1468(@)(@@) البحر : بسيط تام(@)(@@) 1 لا تحدث القطع في كف ولا قدم ؛ %~% ولا تعرض مدى الدنيا لسفك دم(@)(@@) 2 وخل من صور الأشباح ، مقتدرا ، %~% يحلها ، فهو رب الدهر والقدم(@)(@@) 3 وتصبح الذرة الصغرى له أمة ؛ %~% والشمس والبدر معدودين في الخدم(@)(@@) 4 وقد أسفت لخير إذ علمت به %~% وما أسفت عليه كيف لم يدم(@)(@@) 5 وما انتفاعي بندمان أسر به %~% إذا الفراق رماني منه بالندم(@)(@@) 6 وإن حسرة نفس غير هينة %~% مصيرها بعد إيجاد إلى عدم(@)(@@) 7 لو شك بالطعن ميت لم يجد ألما ، %~% فالرمح فيه كأشفى الخرز في الأدم(@)(@@) 8 سيان إلباسه ما لان من كفن ، %~% وطرحه في لظى للنار محتدم(@)PageV01P1469(@)(@@) البحر : طويل(@)(@@) 1 أجل 
ms316	 سلاح يتقي المرء قرنه %~% به أجل يوم الهياج مؤخر(@)(@@) 2 ورب كمي يحمل السيف ، صارما ، %~% إلى الحرب ، والأقدار تلهو وتسخر(@)(@@) 3 وكنزك في الغبراء ، لا بد ، ضائع ، %~% ولكن لذي الخضراء يحمي ويذخر(@)(@@) 4 تفاخر ، ظنا منك أنك ماجد ، %~% وحسبك ، من ذام ، غدوك تفخر(@)(@@) 5 وما شرف الإنسان إلا عطية %~% حدتها الليالي ، والقضاء المسخر(@)PageV01P1470(@)(@@) البحر : بسيط تام(@)(@@) 1 النفس ، ما لم تذق موتا ، مشارفة %~% إن لم يحم ، بقدر ، يومها يحم(@)(@@) 2 إن تطفأ النار عن جزل فإن لها %~% يعفى ويخبأ ما أبقت من الفحم(@)(@@) 3 وبعض جسمك يرمي بعضه بأذى ، %~% وأكثر الشر يأتي من ذوي الرحم(@)(@@) 4 ويشتهي الناس ما لا يسعفون به ، %~% وشركة الخلق دون الحمل في الوحم(@)PageV01P1471(@)(@@) البحر : بسيط تام(@)(@@) 1 %~% حتى أتى الشيب إبراهيم عن أمم(@)(@@) 2 كذبتم ، ونجوم الليل شاهدة ، %~% أن المشيب قديما حل في اللمم(@)(@@) 3 هذا بياض رسول الموت يبعثه %~% في كل عصر إلى الأجيال والأمم(@)(@@) 4 وما أسيت على الدنيا مزايلة %~% ولا تأست على البالي من الرمم(@)(@@) 5 شقت وعقت ، ولم أحمد ، ولا حمدت %~% ثم انصرفنا : كلانا سيئ الهمم(@)(@@) 6 ورغبتي في بنيها غير كائنة ؛ %~% وكيف يرغب خدن العقل في اللمم(@)(@@) 7 لا خير فيهم وإن هم عظموا رجبا ، %~% دون الشهور ، فقد شانوه بالصمم(@)(@@) 8 لم تعط قط أنوفا ، جدعت ، شمما ؛ %~% فليت كفك لم تجدع أخا الشمم(@)(@@) 9 لا تحكم العقد في حلف ولا عدة %~% فإن طبعك يدعى ناقض الذمم(@)(@@) 10 وللزمان مغار في نفوسهم ؛ %~% يكفيك أن تضع الهندي بالقمم(@)PageV01P1472(@)(@@) البحر : طويل(@)(@@) 1 لعمري ، لقد عز المباح عليكم ، %~% زهان بجهل ما يصان ويحظر(@)(@@) 2 وفي الحق أشباه من الذهب الذي %~% نشاهده ثقل ومكث ومنظر(@)PageV01P1473(@)(@@) البحر : بسيط تام(@)(@@) 1 عرفت من أم دفر شيمة عجبا %~% دلت على اللؤم وهي العنف بالخدم(@)(@@) 2 ومن يهنها تصنه عن مكارهها %~% بعض الصيانة ، فارفضها بلا ندم(@)(@@) 3 وما لنفسي خلاص من نوائبها ، %~% ولا لغيري ، إلا الكون في العدم(@)PageV01P1474(@)(@@) البحر : بسيط تام(@)(@@) 1 فضيلة النطق في الإنسان تمزجها %~% نقيصة الكذب 
ms317	 المعدود في النقم(@)(@@) 2 أصدق إلى أن تظن الصدق مهلكة %~% وعند ذلك فاقعد كاذبا وقم(@)(@@) 3 فالمين ميتة مضطر ألم بها ؛ %~% والحق كالماء يجفى خيفة السقم(@)PageV01P1475(@)(@@) البحر : طويل(@)(@@) 1 دع القوم ! سلوا بالضغائن ، بينهم ، %~% خناجر وآشرب ما سقتك الخناجر(@)(@@) 2 بهجت بفرع لا ثبات لأصله ، %~% ففيم تلاحي أو علام تشاجر ؟(@)(@@) 3 إذا أنتض هاجرت القبائح والخنى %~% فأنت ، على قرب الديار ، مهاجر(@)(@@) 4 تعرض ، للطير السوانح ، زاجر ؛ %~% أما لك من عقل يكفك زاجر(@)(@@) 5 ولكنها أرت من يحبها %~% محاجر تسقى ، دونهن ، المحاجر(@)(@@) 6 متى ما فعلت الخير ثم كفرته %~% فلا تأسفن ! إن المهيمن آجر(@)(@@) 7 ولو لم يبر الحر إلا مخافة %~% من الخزي ، بين الناس ، إن قيل فاجر(@)(@@) 8 فنزه جميلا ، جئته ، عن جزاية %~% تؤمل ، أو ربح ، كأنك تاجر(@)(@@) 9 وبالجد زار اللت أهل ضلالة %~% وعظمت العزى وأكرم باجر(@)(@@) 10 شتونا وصفنا وارتبعنا فلم يدم %~% شتاء وزال الروض عنا وناجر(@)PageV01P1476(@)(@@) البحر : بسيط تام(@)(@@) 1 لقد أسفت ، وماذا رد لي أسفي ، %~% لما تفكرت في الأيام والقدم(@)(@@) 2 في العدم كنا ، وحكم الله أوحدنا ، %~% ثم اتفقنا على ثان من العدم(@)(@@) 3 سيان عام ويوم في ذهابهما ، %~% كأن ما دام ، ثم انبت ، لم يدم(@)PageV01P1477(@)(@@) البحر : طويل(@)(@@) 1 أرى كل أم ، عبرها غير مبطىء ، %~% وما أم دفر بالتي بان عبرها(@)(@@) 2 هي النفس تهوى الرحب ، في كل منزل ، %~% فكيف بها إن ضاق في الأرض قبرها(@)(@@) 3 وآخر عهد القوم بي يوم تنطوي %~% علي جرور الورد يكره زبرها(@)(@@) 4 وهل يرتحي خضر الملابس ظاعن %~% وقد مزقت ، في باطن الترب ، غبرها ؟(@)(@@) 5 أتتني أنباء ، كثير شجونها ، %~% لها طرق أعيا على الناس خبرها(@)(@@) 6 هفا دونها قس النصارى ، وموبذ ال %~% مجوس ، وديان اليهود ، وحبرها(@)(@@) 7 وخطوا أحاديثا لهم في صحائف %~% لقد ضاعت الأوراق فيها وحبرها(@)(@@) 8 تخالفت الأشياع في عقب الردى ، %~% وتلك بحار ليس يدرك عبرها(@)(@@) 9 وقيل : نفوس الناس تستطيع فعلها ؛ %~% وقال رجال : بل تبين جبرها(@)(@@) 10 ولو خلقت أجسادنا من صبارة ، %~% لقل ، على كر الحوادث ، صبرها 
ms318	 PageV01P1478(@)(@@) 11 يجيئك شهرا ناجر ، بعد قرها ، %~% وصنبرها ، بعد المقيظ ، ووبرها(@)(@@) 12 وما أحرزت ، نفس المدجج ، في الوغى %~% مضبرة ، يستأسر ، الوحش ، ضبرها(@)(@@) 13 أو النثرة الحصداء ، قورب نسجها ، %~% لها حلق هال ، الأسنة ، عبرها(@)(@@) 14 إذا أودعتها جثة وتعرضت %~% لبيض الظبى ، لم يمكن السيف هبرها(@)(@@) 15 وأودت بنووبر وببر فما حمى %~% عزيز ، ولا شم توقل وبرها(@)(@@) 16 وقد سمي المرء الهزبر ، تفاؤلا ، %~% وليس بباق ، في الليالي ، هزبرها(@)(@@) 17 نوائب ألقت في العقول جرائحا %~% عصى ، كل آس ، في البرية ، سبرها(@)(@@) 18 لي القوت فليغمر سرنديب حطها %~% من الدر أو يكثر تبانة غبرها(@)PageV01P1479(@)(@@) البحر : بسيط تام(@)(@@) 1 أعدد لكل زمان ما يشاكله %~% إن البراقع يستثبتن بالشبم(@)(@@) 2 فإن ضربت بسيف الهند في ومد %~% فسيف إفرنجة المخبوء للشبم(@)PageV01P1480(@)(@@) البحر : طويل(@)(@@) 1 عجبت لورقاء الجناحين شأنها %~% إذا غني الأقوام بالمال ، فقرها(@)(@@) 2 غدت أمس في قرية صفرية ، %~% بقرية يوعي بها ، الزاد ، نقرها(@)(@@) 3 فما أخذت إلا ثلاثا ونحوها %~% من الحب ، حتى جاء ، بالحتف ، صقرها(@)(@@) 4 وما رجعت يوما إلى عقر دارها ، %~% وكان بكفي ذلك الشهم عقرها(@)(@@) 5 أرى أدهم الظلماء يعقب شقرة %~% فتودي بنا دهم الجياد وشقرها(@)(@@) 6 فعظم أخا النسك التقي لدينه ، %~% ونفسك فاحقر ، نافع لك حقرها(@)(@@) 7 ولا تقرإ الكتب المضلل درسها ، %~% وقد وضحت طرق الهداية ، فاقرها(@)(@@) 8 فيا مهجة كالعود أمست مناخة %~% إذا شكت الأثقال ضوعف وقرها(@)(@@) 9 متى سمعت أذني مقالة ناصح %~% أتيح لها ، عن قاتل النصح ، وقرها(@)PageV01P1481(@)(@@) البحر : بسيط تام(@)(@@) 1 العيش أدى إلى شر ومهلكة %~% لولا الحياة لكان الجسم كالصنم(@)(@@) 2 من يفقد الحس لا يقذف بمخزية %~% إن الذباب متى يعلو الجنى ينم(@)(@@) 3 هذا الأنام له شأن يراد به ، %~% وأنت غيري ، وليس الأري كالهنم(@)(@@) 4 معنى خبيء على ما بان منه ، كما %~% تبنى الزوائد من يا أوس لا تنم(@)(@@) 5 وحاجة النفس ترضيها بما سخطت ، %~% وكم تجرأ رب الإبل بالغنم(@)(@@) 6 دع الكعاب التي لم يدن مأكلها ، %~% من لؤلؤ الثغر ، إلا قانىء العنم(@)PageV01P1482(@)(@@) البحر : طويل(@)(@@) 1 أرى أمنا - والحمد 
ms319	 لله ربنا - %~% يهب علينا ، بالحوادث ، مورها(@)(@@) 2 فما زيد منها ، قبضة الكف ، زبدها ، %~% ولا عمرت فيها لخي ر عمورها(@)(@@) 3 ولم تدر يوما ضأنها ومعيزها %~% بما احتلفت آسادها ونمورها(@)(@@) 4 تشتت فيها رأينا ، وتوفقت ، %~% على ريبة ، أمواهها وخمورها(@)(@@) 5 توامر ، فيما لا يحل ، نفوسنا %~% بتيهاء ، لا تخفى علينا أمورها(@)PageV01P1483(@)(@@) البحر : بسيط تام(@)(@@) 1 إن طاب خيمك في الدنيا فلا تخم %~% ولا تضن بمقتول على الرخم(@)(@@) 2 فالجسم إن زايلته الروح صار لقى %~% كلا على القوم ما فيه من الضخم(@)PageV01P1484(@)(@@) البحر : بسيط تام(@)(@@) 1 آضت سويداء قلب من تلهبها %~% حمراء ، والنار تنضو حلة الفحم(@)(@@) 2 كأنما الليث ألقى لون مقلته ، %~% ليلا عليها ، فقد سلت من السحم(@)(@@) 3 والترب نقليه ظلما ، وهو والدنا ، %~% وكم لنا فيه من قربى ومن رحم(@)PageV01P1485(@)(@@) البحر : طويل(@)(@@) 1 عقولكم ، في كل حال ، بكية ، %~% ولكن دموع الباكيات غزار(@)(@@) 2 يعود فنيد الملك ، إن عاد جده %~% معد إليكم أو أبوه نزار(@)(@@) 3 وما صح للمرء المحصل أنه %~% بكوفان قبر ، للإمام ، يزار(@)(@@) 4 أخو الدين من عادى القبيح واصبحت %~% له حجرة ، من عفة ، وإزار(@)PageV01P1486(@)(@@) البحر : بسيط تام(@)(@@) 1 دنياك هذي منام إن جرى حلم %~% فيها فأمل غبطة الحلم(@)(@@) 2 وقد يرى أنه باك حليف كرى %~% فيستجد سرورا ، فاقد الألم(@)(@@) 3 فاضرب وليدك ، وادلله على رشد ، %~% ولا تقل : هو طفل غير محتلم(@)(@@) 4 ورب شق برأس جر منفعة %~% وقس على نفع شق الرأس في القلم(@)PageV01P1487(@)(@@) البحر : بسيط تام(@)(@@) 1 كم باد في حدثان الدهر من ملإ ؛ %~% وساد في دول الأيام من قزم(@)(@@) 2 والسعد فوق سروج الخيل ، يمسكها %~% لأهلها ، وهي لم تشدد إلى الحزم(@)(@@) 3 والليث ، إن ولج الحرمان منه ، فما %~% نجى الفريسة من أضنيابه الأزم(@)PageV01P1488(@)(@@) البحر : بسيط تام(@)(@@) 1 أطرق ، كأنك في الدنيا بلا نظر ، %~% واصمت ، كأنك مخلوق بغير فم(@)(@@) 2 وإن هممت بمين فاتخذ لفما %~% مضاعفات ، لتثني اللفظ باللفم(@)PageV01P1489(@)(@@) البحر : بسيط تام(@)(@@) 1 نخشى السعير ، ودنيانا ، وإن عشقت ، %~% مثل الوطيس تلظى ، ملؤه سعر(@)(@@) 2 ما زلت أغسل وجهي للطهور 
ms320	 به ، %~% مسيا وصبحا ، وقلبي حشوه ذعر(@)(@@) 3 كأنما رمت إنقاء لحالكه ، %~% حتى اتقاني ، بصافي لونه ، الشعر(@)PageV01P1490(@)(@@) البحر : بسيط تام(@)(@@) 1 كلم بسيفك قوما ، إن دعوتهم ، %~% من الكلوم ، فما يصغون للكلم(@)(@@) 2 ذو النون ، إن كان سيف الهند ، أبلغ من %~% ذي النون في الوعظ بل من نون والقلم(@)PageV01P1491(@)(@@) البحر : بسيط تام(@)(@@) 1 حاجي نظيم جمان والحياة معي %~% سلك قصير فيأبى جمعها القصر(@)(@@) 2 أما المراد فجم ، لا يحيط به %~% شرح ، ولكن عمر المرء مختصر(@)(@@) 3 والدهر يخطب أهل اللب ، مذ عقلوا %~% ما خاف عيا ، ولا أزرى به الحصر(@)(@@) 4 والغي فيكل شيء ليس يعدمه %~% باغيه حتى من الأعناب يعتصر(@)(@@) 5 والشر في عالم شاهدته خاق %~% ما صدهم عن أذاه الحر والخصر(@)(@@) 6 فالصم من عنصر ، الإفساد حاسدة %~% لصحة السمع ، خلدا ، ما له بصر(@)PageV01P1492(@)(@@) البحر : بسيط تام(@)(@@) 1 إذا أمنت على مال أخا ثقة %~% فاحذر أخاك ، ولا تأمن على الحرم(@)(@@) 2 فالطبع في كل جيل طبع ملأمة(@)PageV01P1493(@)(@@) البحر : بسيط تام(@)(@@) 1 أرمى ، وجدك ، من رامي بني ثعل ، %~% حتف ، لديه إزاء الحوض ، والعقر(@)(@@) 2 يغشاهم الكره ، في الدنيا ، فآدبهم %~% منه كآدب قيس ليس ينتقر(@)(@@) 3 إن عوضوا بذنوب أسلفت سقرا %~% فلم ترمهم ، على علاتها ، سقر(@)(@@) 4 أغناهم الله من مال ، وأفقرهم %~% إن الرشاد فما آستغنوا بل افتقروا(@)(@@) 5 ويحقرون أخا الإعدام بينهم %~% وإن أفضل منهم للذي احتقروا(@)(@@) 6 كأنما العمر سلك مده قدر ، %~% فيه الفواقر ، لا در ولا فقر(@)(@@) 7 ولاحت النار كالشقراء يحبسها %~% عن مهرها القيد وهنا ، فهي لا تقر(@)(@@) 8 بدت بليل ، كعين الديك ، عن شحط ، %~% أو عرفه ، بمحل ، دونه أقر(@)(@@) 9 يعاقر الراح شرب ، حولها ، سهد ، %~% تروي التراب نجيعا سوق ما عقروا(@)PageV01P1494(@)(@@) البحر : بسيط تام(@)(@@) 1 هل يأمن الفتيان الخطب آونة ، %~% وللمقادير إعلام باعلام(@)(@@) 2 أولاهما أن يغادى ، في مدى بردى ، %~% هذا النهار ، فكونوا أهل أحلام(@)(@@) 3 هو الجديد ، فيطويه الزمان بلى ، %~% ويرجع الدهر إظلاما بإظلام(@)(@@) 4 دنياك فيما توالي غير محسنة %~% فلم تزل ذات أولاد وأخلام(@)(@@) 5 حسب الحياة 