ms110	 بن أبي عبيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سليمان بن صرد وعين الوردة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مرج راهط وبيعة مروان ومقتل الضحاك بن قيس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مصعب وولايته العراق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل عبد الله بن الزبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل سعيد بن العاص.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث يا حميرا ومقتل ابن الأشعث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بلال الخارجي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نجدة أبى فديك .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث الأزارقة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث روشنقباد .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شبيب الحروري وصالح بن مسرح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المطرف بن المغيرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (دير) الجماجم وخلع عبد الرحمن بن الأشعث.(@)PageV00P105(@)(@@)(@@)(@@) $DIC_BIB$ كتاب يزيد بن المهلب ومقتله بالعقر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خالد بن عبد الله القسري، ويوسف بن عمر وموت هشام وولاية الوليد (بن يزيد) (كتاب زيد بن علي عليه السلام) كتاب يحيى (بن زيد).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الضحاك الخارجي.(@)(@@) قرأت بخط أحمد بن الحارث الخراز: قالت العلماء أبو مخنف بأمر العراق واخبارها وفتوحها يزيد على غيره. والمدائني بأمر خراسان والهند وفارس. والواقدي بالحجاز والسيرة. وقد اشتركوا في فتوح الشام.(@)(@@)(@@)(@@) $BIO_MAN$ أبو الفضل نصر بن مزاحم(@)(@@) من طبقة أبى مخنف، من بنى منقر وكان عطارا. ومزاحم بن يسار المنقري. وتوفى.. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الغارات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل حجر بن عدي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل الحسين بن علي (عليهما السلام).(@)(@@)(@@)(@@) $BIO_MAN$ إسحاق بن بشر(@)(@@) من أصحاب السير والاحداث. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المبتداء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الردة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الفتوح).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حفر زمزم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألوية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفين.(@)(@@)(@@)(@@) $BIO_MAN$ سيف بن عمر(@)(@@) الأسدي التميمي. أحد أصحاب السير والاحداث. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفتوح الكبير والردة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل ومسير عايشة وعلى (عليه السلام) وروى عن سيف شعيب بن إبراهيم بن.. .(@)(@@)(@@)(@@) $BIO_MAN$ عبد المنعم(@)(@@) ابن إدريس بن سنان بن ابنة وهب بن منبه. مات سنة ثمان وعشرين ومائتين وبلغ فوق المائة سنة وعمى آخر عمره. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المبتداء.(@)(@@)(@@)(@@) $BIO_MAN$ معمر بن راشد(@)(@@) من أهل الكوفة، 
ms111	 يروى عنه عبد الرزاق، من أصحاب السير والاحداث. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المغازي.(@)(@@)(@@)(@@) $BIO_MAN$ لقيط المحاربي(@)(@@) وهو أبو هلال لقيط بن بكير المحاربي الكوفي، من بنى محارب بن حفصة، من الرواة للعلم، المصنفين للكتب. وكان سيئ الخلق شاعرا، عاش إلى سنة تسعين ومائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السمر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحراب واللصوص.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الجن.(@)(@@)(@@)(@@) $BIO_MAN$ أبو اليقظان النسابة(@)(@@) حكى الحسين بن فهم عن الدمشقي قال: قال الزبير قال المدائني: أبو اليقظان هو سحيم بن حفص. وسحيم(@)PageV00P106 لقب واسمه عامر بن حفص. وكان لحفص ابن يقال له محمد. وكان أكبر ولده. وكان حفص أسود شديد السواد ويعرف بالأسود. وقال أبو اليقظان: سمتني أمي خمسة عشر يوما عبيد الله. قال المدائني: فإذا قلت، حدثنا أبو اليقظان، فهو أبو اليقظان. وإذا قلت، سحيم بن حفص وعامر بن حفص وعامر بن أبي محمد وعامر بن الأسود وسحيم بن الأسود. وعبيد الله بن فايد وأبو اسحق، فهو أبو اليقظان. وكان عالما بالاخبار والأنساب والمآثر والمثالب، ثقة فيما يرويه. وتوفى سنة سبعين ومائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف تميم بعضها بعضا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار تميم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب خندف واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسب الكبير ويحتوي على نسب أياد كنانة. أسد بن خزيمة.(@)(@@) (الهون بن خزيمة). هذيل بن مدركة. قريش. بنى طابخة. قيس عيلان. ربيعة بن نزار. تيم بن مرة. وغير ذلك من النسب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر، رايته بخط ابن سعدان.(@)(@@)(@@)(@@) $BIO_MAN$ خالد بن طليق(@)(@@) ابن محمد بن عمران بن حصين الخزاعي. اخباري راوية من النسابين. وكان معجبا تياها، ولاه المهدى قضاء البصرة وبلغ من تيهه أنه كان إذا أقيمت الصلاة قام في موضعه، فربما قام وحده. فقال له مره إنسان استوفى الصف فقال: بل يستوي الصف بي. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المآثر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المزوجات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنافرات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرهان .(@)(@@)(@@)(@@) $BIO_MAN$ الزهري(@)(@@) واسمه عبيد الله بن سعد الزهري، من أصحاب السير. وله من الكتب، كتاب فتوح خالد بن الوليد. 
ms112	(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي مريم(@)(@@) أبو عبد الله سعيد بن الحكم بن أبي مريم، نسابة اخباري. وله من الكتب، كتاب النسب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المآثر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوافل العرب.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار محمد بن السائب(@)(@@) وهو أبو النصر محمد بن السائب الكلبي. ومن خط ابن الكوفي، محمد بن مالك بن السائب بن بشر بن عمرو بن الحارث بن (عبد الحارث بن) عبد العزى بن امرؤ (القيس) بن عامر بن النعمان بن عامر بن عبد ود بن عوف بن كنانة بن عذرة بن زيد اللات بن رفيدة بن كلب. من علماء الكوفة بالتفسير والاخبار وأيام الناس.(@)(@@) ويتقدم الناس بالعلم بالأنساب وكان له ابن يعرف بالعباس يروى عنه. ويحكى ان سليمان بن علي أقدم محمد ابن السائب من الكوفة إلى البصرة وأجلسه في داره. فجعل يمل على الناس (تفسير) القرآن حتى بلغ إلى آية من سورة براءة ففسرها على خلاف ما (كان) يعرف، فقالوا لا نكتب هذا التفسير، فقال محمد: والله لا أمليت(@)PageV00P107 حرفا حتى يكتب تفسير هذه الآية على ما أنزله الله.(@)(@@) فرفع ذلك إلى سليمان بن علي، فقال: اكتبوا كما يقول ودعوا ما سوى ذلك. وقال هشام بن محمد: قال لي أبى اخذت نسب قريش عن أبي صالح واخذه أبو صالح عن عقيل بن أبي طالب. قال: واخذت نسب كنده عن أبي الكناس الكندي وكان اعلم الناس. واخذت نسب معد بن عدنان عن النجاد بن أوس العدوي وكان احفظ من رأيت وسمعت به. واخذت نسب أياد عن عدى بن زياد الأيادي وكان عالما بأياد.(@)(@@) قال هشام واخذت نسب ربيعة عن أبي وعن خراش بن إسماعيل العجلي. قال محمد بن السائب: سئلني عبد الله بن حسن عن اسم سكينة ابنة الحسين عليه السلام فقلت: أميمة فقال: أصبت. وتوفى محمد بن السائب بالكوفة سنة ست وأربعين ومائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفسير القرآن.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار هشام الكلبي (@)(@@) قال محمد بن سعد كاتب الواقدي: هو هشام بن محمد بن السائب بن بشر، عالم بالنسب واخبار 
ms113	 العرب و أيامها ومثالبها ووقائعها. اخذ عن أبيه وعن جماعة من الرواة. قال اسحق الموصلي: كنت إذا رأيت ثلاثة يرون ثلاثة يدنون . إذا رأى الهيثم بن عدي، هشاما الكلبي . وعلوية إذا رأى مخارقا. وأبا نواس إذا رأى أبا العتاهية.(@)(@@) وتوفى هشام في سنة ست ومائتين. وله من الكتب المصنفة ما انا ذاكره على ترتيبه من خط أبى الحسن ابن الكوفي،(@)(@@)~:section: كتبه في الاحلاف(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف عبد المطلب وخزاعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف الفضول وقصة الغزال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف كلب وتميم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المغيرات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف أسلم في قريش(@)(@@)~:section: كتبه في المآثر والبيوتات والمنافرات والمؤودات(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنافرات كتاب بيوتات قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل قيس عيلان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المؤودات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيوتات ربيعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الكنى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار العباس بن عبد المطلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطب علي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شرف قصي بن كلاب وولده في الجاهلية والاسلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب بنى طابخة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب قيس عيلان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب ربيعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب اليمن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المثالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوافل يحتوي على نوافل قريش، نوافل كنانة، نوافل أسد، نوافل تميم، نوافل قيس، نوافل أياد، نوافل ربيعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تسمية من نفل من عاد و ثمود والعماليق وخبرهم وبنى إسرائيل من العرب وقصة الهجريين (14) وأسماء قبائلهم. نوافل قضاعة.(@)(@@) نوافل اليمن.(@)PageV00P108(@)(@@)~:section: ومن كتب هشام(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ادعاء زياد معاوية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار زياد بن أبيه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صنائع قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المشاجرات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المناقلات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعاتبات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المشاغبات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ملوك الطوائف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ملوك كندة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيوتات اليمن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ملوك اليمن من التبابعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب افتراق (ولد معد).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب تفرق) ولد نزار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفرق الأزد كتاب طسم وجديس. (كتاب من قال بيتا من الشعر فنسب إليه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعرفات من النساء في قريش.)(@)(@@)~:section: كتبه في اخبار الأوائل(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث آدم وولده.(@)(@@)(@@)(@@) $DIC_BIB$ 
