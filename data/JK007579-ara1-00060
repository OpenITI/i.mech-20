ms41	(@)(@@) % أيا من بين باطية ودن % وعود في يدي غاو مغن % 2(@)(@@) % إذا لم تنه نفسك عن هواها % % وتحسن صونها ، فإليك عني % % 3(@)(@@) % فإن اللهو والملهى جنون ، % ولست من الجنون وليس مني % % 4(@)(@@) % وأي قبيح أقبح من لبيب % يرى متطربا في مثل سني % % 5(@)(@@) % إذا ما لم يتب كهل لشيب ، % فليس بتائب ما عاش ، ظني % % PageV01P175 البحر : مجزوء الكامل 1(@)(@@) % أين القرون بنو القرون % وذوو المدائن والحصون % 2(@)(@@) % وذوو التجبر في المجا % % لس ، والتكبر في العيون % 3(@)(@@) % كانوا اللوك ، فأيهم % لم يفنه ريب المنون % 4(@)(@@) % أو أيهم لم يلف ، في % % دار البلى علق الرهون % 5(@)(@@) % ولو علوا في عيشة ، % ليست لأنفسهم بدون % 6(@)(@@) % صاروا حديثا بعدهم ، % إن الحديث لذو شجون % 7(@)(@@) % والدهر دائبة عجا % % ئب صرفه ، جم الفنون % PageV01P176 البحر : كامل تام 1(@)(@@) % كم من أخ لك نال سلطانا ، % فكأنه ليس الذي كانا % % 2(@)(@@) % ما أسكر الدنيا لصاحبها % % وأضرها للعقل أحيانا % % 3(@)(@@) % دار لها شبه ملبسة ، % تدع الصحيح العقل سكرانا % % PageV01P177 البحر : خفيف تام 1(@)(@@) % أين من كان قبلنا أين أينا % % من أناس كانوا جمالا ورزينا % % 2(@)(@@) % إن دهرا أتى عليهم ، فأفنى % % منهم الجمع سوف يأتي علينا % % 3(@)(@@) % خدعتنا الآمال حتى طلبنا % % وجمعنا لغيرنا وسعينا % % 4(@)(@@) % وابتنينا ، وما نفكر في الده % ر وفي صرفه ، غداة ابتنينا % % 5(@)(@@) % وابتغينا من المعاش فضولا ، % لو قنعنا بدونها لاكتفينا % % 6(@)(@@) % ولعمري لنمضين ولا نمضي % % بشيء منها إذا ما مضينا % % 7(@)(@@) % وافترقنا في المقدرات ، وسوى % % الله في الموت بيننا واستوينا % % 8(@)(@@) % كم رأينا من ميت كان حيا ، % ووشيكا يرى بنا ما رأينا % % 9(@)(@@) % ما لنا نأمل المنايا كأنا % % لا نراهن يهتدين إلينا % % 10(@)(@@) % عجبا لامرىء تيقن أن ال % % الموت حقا فقر بالعيش عينا % % PageV01P178 البحر : مجزوء الكامل 1(@)(@@) % إن الزمان ولو يلين % ن لأهله ، لمخاشن % PageV01P179 البحر : هزج 1(@)(@@) % أيا واها لذكر الله ، % يا واها له ، واها ! % 2(@)(@@) % لقد طيب ذكر الل % بالتسبيح أفواها % % 3(@)(@@) % فيا أنتن من زبل ، % على زبل ، إذا تاها % % 4(@)(@@) % أرى قوما يتيهون ، % بهاما رزقوا جاها % % PageV01P180 البحر 
ms42	 : خفيف تام 1(@)(@@) % إنما الشيب ، لابن آدم ، ناع % قام في عارضيه ثم نعاه % PageV01P181 البحر : طويل 1(@)(@@) % إذا ما سألت المرء هنت عليه ، % يراك حقيرا من رغبت إليه % 2(@)(@@) % فلا تسألن المرء إلا ضرورة ، % ووفر عليه كل ذات يديه % 3(@)(@@) % ومن جاء يبغي ما لديك فأرضه % بجهدك ، واترك ما يكون لديه % PageV01P182 البحر : مجزوء الكامل 1(@)(@@) % ألمرء منظور إليه ، % مادام يرجى ما لديه % 2(@)(@@) % من كنت تبغي أن تكو % % ن ، الدهر ، ذا فضل عليه % 3(@)(@@) % فابذل له ما في يديك % ك وغض عما في يديه % PageV01P183 البحر : مجزوء الكامل 1(@)(@@) % المرء يخدعه مناه ، % والدهر يسرع في بلاه % 2(@)(@@) % يا ذا الهوى مه لا تكن % ممن تعبده هواه ! % 3(@)(@@) % واعلم بأن المرء مر % تهن بما كسبت يداه % 4(@)(@@) % كم من أخ لك لا ترى % % متصرفا ، فيما تراه % 5(@)(@@) % أمسى قريب الدار في % % الأجداث قد شحطت نواه % 6(@)(@@) % قد كان مغترا بيو % م وفاته ، حتى أتاه % 7(@)(@@) % الناس في غفلاتهم ، % والموت دائرة رحاه % 8(@)(@@) % فالحمد لله الذي % % ويهلك ما سواه % PageV01P184 البحر : كامل تام 1(@)(@@) % قل للذين تشبهوا بذوي التقى : % لا يلعبن بنفسه متشبه % 2(@)(@@) % هيهات لا يخفى التقى من ذي التقى % % هيهات لا يخفى امرؤ متآله % 3(@)(@@) % إن القلوب إذا طوت أسرارها ، % أبدت لك الأسرار منها الأوجه % PageV01P185 البحر : طويل 1(@)(@@) % تصبر عن الدنيا ودع كل تائه % مطيع هوى ، يهوي به في المهامه % 2(@)(@@) % دع الناس والدنيا فبين مكالب % عليها بأنياب ، وبين مشافه % 3(@)(@@) % ومن لم يحاسب نفسه في أموره % يقع في عظيم مشكل متشابه % 4(@)(@@) % وما فاز أهل الفضل إلا بصبرهم % عن الشهوات ، واحتمال المكاره % PageV01P186 البحر : مديد تام 1(@)(@@) % إنما الذنب على من جناه ، % لم يضر قبل جهولا سواه % 2(@)(@@) % فسد الناس جميعا ، فأمسى % % خيرهم من كف عنا أذاه % PageV01P187 البحر : متقارب تام 1(@)(@@) % ألا يا بني آدم استنبهوا ، % أما قد نهيتم فلا تنتهوا % % 2(@)(@@) % أيا عجبا من ذوي الاعتبا % % ر ما منهم اليوم مستنبه % 3(@)(@@) % طغى الناس حتى رأيت اللبيب % في غي طغيانه يعمه % PageV01P188 البحر 
ms43	 : طويل 1(@)(@@) % وإني لمشتاق إلى ظل صاحب ، % يروق ويصفو ، إن كدرت عليه % 2(@)(@@) % عذيري من الإنسان لا إن جفوته % صفا لي ولا إن كنت طوع يديه % PageV01P189 البحر : وافر تام 1(@)(@@) % أرى الدنيا لمن هي في يديه % عذابا ، كلما كثرت لديه % 2(@)(@@) % تهين المكرمين لها بصغر % وتكرم كل من هانت عليه % 3(@)(@@) % إذا استغنيت عن شيء ، فدعه % وخذ ما أنت محتاج إليه % PageV01P190 البحر : خفيف تام 1(@)(@@) % أنا بالله وحده وإليه % إنما الخير كله في يديه % 2(@)(@@) % أحمد الله وهو ألهمني الحمد % د على المن والمزيد لديه % 3(@)(@@) % كم زمان بكيت منه قديما % ثم لما مضى بكيت عليه % PageV01P191 البحر : كامل تام 1(@)(@@) % نام الخلي لأنه خلو % عمن يؤرق عينه الشجو % 2(@)(@@) % ما إن يطيب لذي الرعاية لل % % أيام لا لعب ، ولا لهو % 3(@)(@@) % إذ كان يسرف في مسرته ، % فيموت ، من أعضائه جزو % 4(@)(@@) % وإذا المشيب رمى بوهنته % وهت القوى وتقارب الخطو % 5(@)(@@) % وإذا استحال بأهله زمن ، % كثر القذى ، وتكدر الصفو % PageV01P192 البحر : طويل 1(@)(@@) % أيا عجبا للناس في طول ما سهوا % % وفي طول ما اغتروا وفي طول ما لهوا % % 2(@)(@@) % يقولون نرجو الله ثم افتروا به % ولو أنهم يرجون خافوا كما رجوا % % 3(@)(@@) % تصابى رجال ، من كهول وجلة ، % إلى اللهو ، حتى لا يبالون ما أتوا % % 4(@)(@@) % فيا سوءة للشيب إذ صار أهله % إذا هيجتهم للصبا صبوة ، صبوا % % 5(@)(@@) % أكب بنو الدنيا عليها ، وإنهم % لتنهاهم الأيام عنها لو انتهوا % % 6(@)(@@) % مضى قبلنا قوم قرون نعدهم % % ونحن وشيكا سوف نمضي كما % % 7(@)(@@) % ألا في سبيل الله أي ندامة % نوت ، كما مات الألى ، كلما خلوا % % 8(@)(@@) % ولم نتزود للمعاد وهوله ، % كزاد الذين استعصموا الله واتقوا % % 9(@)(@@) % ألا أين أين الجامعون لغيرهم ، % وما غلبوا غشما عليه وما احتووا % % 10(@)(@@) % رأيت بني الدنيا ، إذا ما سموا بها ، % هوت بهم الدنيا على قدر ما سموا % % PageV01P193 11(@)(@@) % وكل بني الدنيا ، ولو تاه تائه ، % قد اعتدلوا في النقص والضعف واستووا % % 12(@)(@@) % ولم أر مثل الصدق أحلى لوحشة % ولا مثل إخوان الصلاح 
ms44	 إذا اتقوا % % PageV01P194 البحر : وافر تام 1(@)(@@) % كأن الأرض قد طويت عليا ، % وقد أخرجت مما في يديا % % 2(@)(@@) % كأني يوم يحثو الترب قومي ، % مهيلا ، لم أكن في الناس حيا % % 3(@)(@@) % كأن القوم قد دفنوا وولوا % % وكل غير ملتفت إليا % % 4(@)(@@) % كأن قد صرت منفردا ، وحيدا ، % ومرتهنا ، هناك ، بما لديا % % 5(@)(@@) % كأن الباكيات علي ، يوما ، % وما يغني البكاء علي شيا % % 6(@)(@@) % ذكرت منيتي ، فبكيت نفسي ، % ألا أسعد أخيك ، أي أخيا ! % PageV01P195 البحر : خفيف تام 1(@)(@@) % إن أسوا يوم ي مر عليا ، % يوم لا رغبة تكون إليا % % 2(@)(@@) % كم تغر الدنيا وكم يجد ال % % الإنسان فيها شيئا ويحرم شيئا % % 3(@)(@@) % تنشر الحادثات طورا ، وتطوي ، % إنما الحادثات نشرا ، وطيبا % % 4(@)(@@) % وطباع الأسنان مختلفات % رب وعر الأخلاق سهل المحيا % % PageV01P196 البحر : بسيط تام 1(@)(@@) % إن السلامة أن نرضى بما قضيا ، % ليسلمن ، بإذن الله ، من رضيا % % 2(@)(@@) % المرء يأمل ، والآمال كاذبة ، % والمرء تصحبه الآمال ما بقيا % % 3(@)(@@) % يا رب باك على ميت وباكية % لم يلبثا بعد ذاك الميت أن بكيا % % 4(@)(@@) % ورب ناع نعى حينا أحبته % ما زال ينعى إلى أن قيل قد نعيا % % 5(@)(@@) % علمي بأني أذوق الموت نغص لي % % طيب الحياة ، فما تصفوا الحياة ليا % % 6(@)(@@) % كم من أخ تغتذي دود التراب به ، % وكان صبا بحلو العيش ، مغتذيا % % 7(@)(@@) % يبلى مع الميت ذكر الذاكرين له ، % من غاب غيبة من لا يرتجى نسيا % % 8(@)(@@) % من مات مات رجاء الناس منه فو % لوه الجفاء ، ومن لا يرتجى جفيا % % 9(@)(@@) % إن الرحيل عن الدنيا ليزعجني ، % إن لم يكن رائحا بي كان مغتديا % % 10(@)(@@) % الحمد لله ، طوبى للسعيد ، ومن % لم يسعد الله بالتقوى ، فقد شقيا % % PageV01P197 11(@)(@@) % كم غافل عن حياض الموت في لعب ، % يمسي ، ويصبح ركابا لما هويا % % 12(@)(@@) % ومنقض ما تراه العين منقطع % ما كل شيء بدا إلا لينقضيا % % PageV01P198 البحر : طويل 1(@)(@@) % ركنا إلى الدنيا الدنئة ضلة % وكشفت الأطماع منا المساويا % % 2(@)(@@) % وإنا لنرمى كل يوم بعبرة ، % نراها ، فما تزداد إلا تماديا % % 3(@)(@@) % نسر بدار أورثتنا تضاغنا % عليها ، ودار 
ms45	 أورثتنا تعاديا % % 4(@)(@@) % إذا المرء لم يلبس ثيابا من التقى % % تقلب عريانا وإن كان كاسيا % % 5(@)(@@) % أخي ! كن على يأس من الناس كلهم % جميعا وكن ما عشت لله راجيا % % 6(@)(@@) % ألم تر أن الله يكفي عباده % فحسب عباد الله بالله كافيا % % 7(@)(@@) % وكم من هناة ، ما عليك ، لمستها % % من الناس يوما أو لمست الأفاعيا % % 8(@)(@@) % أخي ! قد أبى بخلي وبخلك أن يرى % % لذي فاقة مني ومنك مؤاسيا % % 9(@)(@@) % كلانا بطين جنبه ، ظاهر الكسى ، % وفي الناس من يمسي ويصبح عاريا % % 10(@)(@@) % كأني خلقت للبقاء مخلدا % وأن مدة الدنيا له ليس ثانيا % % PageV01P199 11(@)(@@) % إلى الموت إلا أن يكون لمن ثوى % % من الخلق طرا ، حيثما كان لاقيا % % 12(@)(@@) % حسمت المنى يا موت حسما مبرحا % وعلمت يا موت البكاء البواكيا % % 13(@)(@@) % ومزقتنا ، يا موت ، كل ممزق ، % وعرفتنا يا موت منك الدواهيا % % 14(@)(@@) % ألا يا طويل السهو أصبحت ساهيا % وأصبحت مغترا ، وأصبحت لاهيا % % 15(@)(@@) % أفي كل يوم نحن نلقى جنازة % وفي كل يوم منك نسمع مناديا % % 16(@)(@@) % وفي كل يوم منك نرثي لمعول % وفي كل يوم نحن نسعد باليا % % 17(@)(@@) % ألا أيها الباني لغير بلاغة ، % ألا لخراب الدهر أصبحت بانيا % % 18(@)(@@) % ألا لزوال العمر أصبحت بانيا ؛ % وأصبحت مختالا ، فخورا ، مباهيا % % 19(@)(@@) % كأنك قد وليت عن كل ما ترى ، % وخلفت من خلفته عنك ساليا % % PageV01P200 
