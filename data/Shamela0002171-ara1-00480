ms461	 شريف محتشم وثقه أبو حاتم مات 228 د ت س(@)(@@)(@@)(@@) | 3586- (@)(@@) عبيد الله بن محمد بن يزيد بن خنيس المخزومي عن أبيه وإسماعيل بن أبي أويس وعنه مسلم والسراج وطائفة مات 252 م(@)(@@)(@@)(@@) | 3587- (@)(@@) عبيد الله بن مسلم القرشي عن أبيه وله صحبة وعنه هارون بن موسى الفراء ومرة جاء مسلم بن عبيد الله د ت س(@)(@@)(@@)(@@) | 3588- (@)(@@) عبيد الله بن مسلم عن معاذ بن جبل وعنه أبو رملة ويحيى بن عبيد الله التيمي ق(@)(@@)(@@)(@@) | 3589- (@)(@@) عبيد الله بن معاذ بن معاذ أبو عمرو العنبري عن أبيه ومعتمر والطبقة وعنه مسلم وأبو داود(@)(@@) PageV00P000(@)(@@) والبغوي والساجي قال أبو داود كان يحفظ نحو عشرة آلاف حديث وكان فصيحا مات 237 خ م د س(@)(@@)(@@)(@@) | 3590- (@)(@@) عبيد الله بن المغيرة السبائي عن بن جزء الزبيدي وعبيد الله بن الخيار وعنه بن إسحاق وبكر بن نضر صدوق مات 131 ت ق(@)(@@)(@@)(@@) | 3591- (@)(@@) عبيد الله بن المغيرة الكناني عن بن عباس وعنه أبو شيبة يحيى بن عبد الرحمن غير معروف ق(@)(@@)(@@)(@@) | 3592- (@)(@@) عبيد الله بن مقسم عن أبي هريرة وابن عمر وطائفة وعنه أبو حازم الاعرج وسهيل وابن عجلان خ م د س ق(@)(@@)(@@)(@@) | 3593- (@)(@@) عبيد الله بن موسى أبو محمد العبسي الحافظ أحد الاعلام على تشيعه وبدعته سمع هشام بن عروة وإسماعيل بن أبي خالد وابن جريج وعنه البخاري والدارمي وعبد والحارث بن محمد ثقة مات في ذي القعدة سنة 213 ع(@)(@@)(@@)(@@) | 3594- (@)(@@) عبيد الله بن النضر القيسي عن أبيه وعنه بن مهدي والتبوذكي وثقه بن معين د(@)(@@)(@@)(@@) | 3595- (@)(@@) عبيد الله بن هرير الانصاري عن أبيه وغيره وعنه بن أبي فديك والواقدي شيخ د(@)(@@)(@@)(@@) | 3596- (@)(@@) عبيد الله بن الوازع الكلابي عن أيوب السختياني وهشام بن عروة وعنه حفيده عمرو بن عاصم صدوق ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3597- (@)(@@) عبيد الله بن أبي الوزير عن مبشر بن إسماعيل وعنه أبو داود لا أعرفه د(@)(@@)(@@)(@@) | 3598- (@)(@@) عبيد الله بن الوليد الوصافي عن طاوس وعطاء بن أبي رباح وعنه وكيع وأبو معاوية وآخرون ضعفوه ت ق(@)(@@)(@@)(@@) | 3599- (@)(@@) عبيد الله بن زيد الحراني عن حديج 
ms462	 بن معاوية ومعقل بن عبيد الله وعنه ابنه محمد س(@)(@@)(@@)(@@) | 3600- (@)(@@) عبيد الله بن يزيد الطائفي عن بن عباس وعنه سعيد بن السائب وغيره وثق س(@)(@@)(@@)(@@) | 3601- (@)(@@) عبيد الله بن أبي يزيد المكي من الموالي عن بن عباس وجمع وعنه شعبة وابن عيينة وعدة صدوق مات 126 وعاش ستا وثمانين سنة ع(@)(@@)(@@)(@@) | 3602- (@)(@@) عبيد الله بن يوسف الجبيري أبو حفص البصري عن يحيى القطان وطبقته وعنه بن ماجة وابن خزيمة وابن صاعد ق(@)(@@)(@@)(@@) | 3603- (@)(@@) عبيد الله مولى باهلة عن الضحاك وعنه عيسى بن عبيد د(@)(@@)(@@)(@@) | 3604- (@)(@@) عبيد بن أسباط بن محمد عن أبيه وابن إدريس وعدة وعنه الترمذي وابن ماجة ومحمد بن يحيى بن منده وطائفة وثق مات 25 ت ق(@)(@@)(@@)(@@) | 3605- (@)(@@) عبيد بن إسماعيل الهباري عن بن عيينة والمحاربي وعنه البخاري وابن بجير مات 25 خ(@)(@@)(@@)(@@) | 3606- (@)(@@) عبيد بن أبي أمية الطنافسي اللحام عن الشعبي وجماعة وعنه ابناه عمر ويعلى وثقه بن معين ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3607- (@)(@@) عبيد بن البراء بن عازب عن أبيه وعنه ثابت بن عبيد ومحارب بن دثار وثق م د س ق(@)(@@)(@@)(@@) | 3608- (@)(@@) عبيد بن تعلى الطائي عن أبي أيوب وعنه بكير بن الاشج وغيره والاصح بكير عن أبيه عنه وثقه النسائي د(@)(@@)(@@)(@@) | 3609- (@)(@@) عبيد بن ثمامة المرادي عن عبد الله بن جزء الزبيدي وعنه عبد الملك بن أبي كريمة لا يعرف د(@)(@@)(@@)(@@) | 3610- (@)(@@) عبيد بن جبر أبو جعفر المصري عن مولاه أبي بصرة وعنه كليب بن ذهل د(@)(@@)(@@)(@@) | 3611- (@)(@@) عبيد بن جريج عن أبي هريرة وطائفة وعنه زيد بن أسلم ويزيد بن أبي حبيب وجماعة خ م د س ق(@)(@@)(@@)(@@) | 3612- (@)(@@) عبيد بن الحسن المزني عن بن أبي أوفى وعبد الرحمن بن معقل وعنه سفيان وشعبة وجماعة صدوق م د ق(@)(@@)(@@)(@@) | 3613- (@)(@@) عبيد بن حنين عن أبي موسى وزيد بن ثابت وطائفة وعنه أبو الزناد ويحيى بن سعيد وثقه بن سعد مات 105 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3614- (@)(@@) عبيد بن خالد السلمي البهزي له صحبة وحديثان وعنه تميم بن سلمة أو سعد بن عبيدة وغيره د س(@)(@@)(@@)(@@) | 3615- (@)(@@) عبيد بن خالد المحاربي ويقال عبيدة له 
ms463	 صحبة ورواية عنه عمة الاشعث بن أبي الشعثاء س(@)(@@)(@@)(@@) | 3616- (@)(@@) عبيد بن الخشخاش عن أبي ذر وعنه أبو عمر الشامي س(@)(@@)(@@)(@@) | 3617- (@)(@@) عبيد بن رفاعة الزرقي عن أسماء بنت عميس وغيرها وعنه أولاده وعبد الواحد بن أيمن 4(@)(@@) *- عبيد بن زيد الفزاري عن سمرة وعنه ابنه سعيد ق(@)(@@)(@@)(@@) | 3618- (@)(@@) عبيد بن السباق الثقفي عن زيد بن ثابت وجماعة وعنه ابنه سعيد والزهري وجماعة ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3619- (@)(@@) عبيد بن سعيد بن أبان الاموي أخو يحيى عن الاعمش وطائفة وعنه بن أخيه سعيد وإسحاق بن راهويه وطائفة وثقه أبو حاتم م س ق(@)(@@)(@@)(@@) | 3620- (@)(@@) عبيد بن سلمان الكلبي عن أبي ذر وطائفة وعنه ابنه البختري ويزيد بن عبد الملك قال أبو حاتم مجهول ق(@)(@@)(@@)(@@) | 3621- (@)(@@) عبيد بن سوية بن أبي سوية عن عبد الرحمن بن حجيرة وعنه حيوة بن شريح وابن لهيعة توفي 135 د(@)(@@) *- عبيد بن أبي صالح عن صفية بنت شيبة وعنه ثور بن يزيد ق(@)(@@)(@@)(@@) | 3622- (@)(@@) عبيد بن الطفيل عن عبد الرحمن بن أبي بكر المليكي وعنه عمر بن شبة ق(@)(@@)(@@)(@@) | 3623- (@)(@@) عبيد بن عبد الرحمن المزني البصري يقال له عبيد الصيد عن بن سيرين والحسن وعنه سفيان قال بن معين صويلح د(@)(@@)(@@)(@@) | 3624- (@)(@@) عبيد بن أبي عبيد عن أبي هريرة وعنه عاصم بن عبيد الله وفليح وثق د ق(@)(@@)(@@)(@@) | 3625- (@)(@@) عبيد بن عقيل الهلالي البصري المعلم عن أبي عمرو بن العلاء وعدة وعنه أبو قلابة والحارث بن أبي أسامة قال أبو حاتم صدوق مات 207 د س(@)(@@)(@@)(@@) | 3626- (@)(@@) عبيد بن عمير الليثي قاص مكة عن عمر وأبي وعائشة وعنه ابنه عبد الله وابن أبي مليكة وعمرو بن دينار ذكر ثابت البناني أنه قص على عهد عمر وهذا بعيد مات 74 ع(@)(@@)(@@)(@@) | 3627- (@)(@@) عبيد بن عمير مولى بن عباس عن مولاه وعنه بن أبي ذئب والصحيح أن بينهما عطاء د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3628- (@)(@@) عبيد بن فيروز عن البراء بن عازب وعنه القاسم أبو عبد الرحمن وسليمان بن عبد الرحمن الدمشقي الكبير وثقه أبو حاتم 4(@)(@@)(@@)(@@) | 3629- (@)(@@) عبيد بن القاسم الاسدي الكوفي عن هشام بن عروة والاعمش 
ms464	 وعنه أحمد بن المقدام وابن معين ووهاه وقال غيره متهم ق(@)(@@)(@@)(@@) | 3630- (@)(@@) عبيد بن أبي مريم عن عقبة بن الحارث وعنه بن أبي مليكة وثق خ د ت س(@)(@@)(@@)(@@) | 3631- (@)(@@) عبيد بن مهران الكوفي المكتب عن أبي الطفيل وإبراهيم النخعي وعنه السفيانان والفضيل وجماعة م س(@)(@@)(@@)(@@) | 3632- (@)(@@) عبيد بن ميمون عن محمد بن جعفر وغيره وعنه ابنه محمد وغيره مات سنة أربع ومائتين ق(@)(@@)(@@)(@@) | 3633- (@)(@@) عبيد بن نسطاس عن المغيرة بن شعبة والقاضي شريح وعنه ابنه أبو يعفور عبد الرحمن بن عبيد ومنصور وثقه بن معين ق(@)(@@)(@@)(@@) | 3634- (@)(@@) عبيد بن نضيلة الخزاعي الكوفي المقرئ عن بن مسعود وعن علقمة وجماعة وعنه إبراهيم النخعي وحمران بن أعين وثقه النسائي مات 74 م 4(@)(@@)(@@)(@@) | 3635- (@)(@@) عبيد بن هشام أبو نعيم الحلبي القلانسي عن مالك وعبيد الله بن عمرو وخلق وعنه أبو داود والفريابي وأبو عروبة قال أبو حاتم صدوق وقال النسائي ليس بالقوي د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3636- (@)(@@) عبيد بن واقد عن طائفة كزربي أبي يحيى وسعيد بن عطية الليثي وعنه عمر بن شبة والفلاس ضعفه أبو حاتم ت(@)(@@)(@@)(@@) | 3637- (@)(@@) عبيد بن وسيم الجمال الكوفي عن سلمان أبي شداد وجماعة وعنه سويد بن سعيد ويحيى الحماني وثق ق(@)(@@)(@@)(@@) | 3638- (@)(@@) عبيد بن وكيع بن الجراح عن أبيه وعنه النسائي س(@)(@@)(@@)(@@) | 3639- (@)(@@) عبيد بن يحيى الاسدي عن أبي بكر النهشلي وجماعة وعنه هلال بن العلاء وغيره وثق س(@)(@@)(@@)(@@) | 3640- (@)(@@) عبيد بن يعيش الكوفي العطار عن أبي بكر بن عياش ونحوه وعنه مسلم ومطين وعدة وثقوه مات 229 في رمضان م س(@)(@@)(@@)(@@) | 3641- (@)(@@) عبيد سنوطا عن خولة بنت قيس وعنه المقبري وعمر بن كثير وثق ت(@)(@@)(@@)(@@) | 3642- (@)(@@) عبيد عن مولاه عبد الله بن السائب المخزومي وعنه ابنه يحيى د س(@)(@@)(@@)(@@) | 3643- (@)(@@) عبيدة بن بلال عن فرقد السبخي وعنه عيسى غنجار ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3644- (@)(@@) عبيدة بن حميد الكوفي الحذاء عن الاسود بن قيس ومنصور وعبد الملك بن عمير وعنه أحمد وهناد وخلق عاش بضعا وثمانين سنة توفي 19 خ 4(@)(@@)(@@)(@@) | 3645- (@)(@@) عبيدة بن أبي رائطة التميمي الكوفي عن بن المنكدر وعبد الملك بن عمير وعنه عفان 
ms465	 وأبو سلمة التبوذكي وطائفة وثقه بن معين ت(@)(@@)(@@)(@@) | 3646- (@)(@@) عبيدة بن سفيان عن أبي هريرة وغيره وعنه محمد بن عمرو بن علقمة وغيره وثقه النسائي م 4(@)(@@)(@@)(@@) | 3647- (@)(@@) عبيدة السلماني بن عمرو وقيل عبيدة بن قيس الكوفي أحد الائمة أسلم في حياة النبي صلى الله عليه وسلم روى عن علي وابن مسعود وعنه إبراهيم وابن سيرين وأبو إسحاق قال بن عيينة كان يوازي شريحا في العلم والقضاء مات 72 وقيل 73 ع(@)(@@)(@@)(@@) | 3648- (@)(@@) عبيدة بن مسافع الديلي عن أبي سعيد الخدري وعنه ابنه مالك وبكير بن الاشج وثقه بن حبان د س(@)(@@)(@@)(@@) | 3649- (@)(@@) عبيدة أبوخداش عن أبي جري الهجيمي وعنه يونس بن عبيد وعبد السلام أبو الخليل د س(@)(@@)(@@)(@@) | 3650- (@)(@@) عبيدة بن الاسود الهمداني الكوفي عن مجالد وجماعة وعنه عثمان بن أبي شيبة وعبد الله بن عمر بن أبان وجماعة قواه أبو حاتم الرازي ت ق(@)(@@)(@@)(@@) | 3651- (@)(@@) عبيدة بن معتب الضبي عن إبراهيم النخعي والشعبي وعنه شعبة ووكيع وعدة قال أحمد تركوا حديثه د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3652- (@)(@@) عبيس بن ميمون الرقاشي الخزاز عن القاسم بن محمد وبكر بن عبد الله وطائفة وعنه قتيبة والقواريري وخلق ضعفه بن معين وغيره ق(@)(@@)(@@)(@@) | 3653- (@)(@@) عتاب بن أسيد بن أبي العيص بن أمية أبو عبد الرحمن أمير مكة من زمن الفتح عنه بن المسيب وعطاء وجماعة أرسلوا فإنه مات يوم موت الصديق وله خمس وعشرون سنة 4(@)(@@)(@@)(@@) | 3654- (@)(@@) عتاب بن بشير عن خصيف وثابت بن عجلان وعدة وعنه بن راهويه وعلي بن حجر وخلق قال أحمد أحاديثه عن خصيف منكرة وقال بن معين ثقة مات 188 خ د ت س(@)(@@)(@@)(@@) | 3655- (@)(@@) عتاب بن حنين عن أبي سعيد الخدري وعنه عمرو بن دينار س(@)(@@)(@@)(@@) | 3656- (@)(@@) عتاب بن زياد المروزي عن أبي حمزة السكري وطائفة وعنه أحمد وابن معين وأبو حاتم مات 212 ق(@)(@@)(@@)(@@) | 3657- (@)(@@) عتاب بن عبد العزيز عن جدته صفية بنت عطية وعنه يزيد بن هارون وأبو عاصم د(@)(@@)(@@)(@@) | 3658- (@)(@@) عتاب بن المثنى عن مولاه بهز بن حكيم وعنه أحمد بن سعيد الدارمي وعباس العنبري ت(@)(@@)(@@)(@@) | 3659- (@)(@@) عتاب 
ms466	 مولى هرمز عن أنس وعنه شعبة وثق ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3660- (@)(@@) عتبان بن مالك الخزرجي السالمي بدري عنه أنس بن مالك ومحمود بن الربيع توفي زمن معاوية خ م س ق(@)(@@)(@@)(@@) | 3661- (@)(@@) عتبة بن أبي حكيم عن مكحول وعبادة بن نسي وطائفة وعنه يحيى بن حمزة وابن شابور وابن المبارك مختلف في توثيقه وقال أبو حاتم صالح الحديث مات بصور 4 147(@)(@@)(@@)(@@) | 3662- (@)(@@) عتبة بن حماد أبو خليد الدمشقي القارئ عن الاوزاعي وطائفة وعنه هشام الازرق وأيوب بن محمد الوزان حكى العباس بن الوليد البيروتي عنه أنه قرأ الموطأ على مالك في أربعة أيام فالله أعلم ق(@)(@@)(@@)(@@) | 3663- (@)(@@) عتبة بن حميد الضبي عن عكرمة وطائفة وعنه أبو معاوية وابن عيينة وطائفة ضعفه أحمد د ت ق(@)(@@)(@@)(@@) | 3664- (@)(@@) عتبة بن عبد الله أبو العميس المسعودي أخو عبد الرحمن المسعودي الكوفي عن الشعبي وابن أبي مليكة والطبقة وعنه شعبة وأبو نعيم وطائفة وثقه أحمد ع(@)(@@)(@@)(@@) | 3665- (@)(@@) عتبة بن عبد الله اليحمدي المروزي عن مالك وجماعة وعنه النسائي وابن خزيمة والحسن بن سفيان وثقه النسائي مات 244 س(@)(@@)(@@)(@@) | 3666- (@)(@@) عتبة بن عبد الله عن أسماء بنت عميس وعنه عبد الحميد بن جعفر لا يعرف ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3667- (@)(@@) عتبة بن عبد الملك عن زرارة بن كريم وغيره وعنه عبد الصمد بن عبد الوارث ويعقوب الحضرمي وثق د(@)(@@)(@@)(@@) | 3668- (@)(@@) عتبة بن عبد السلمي أبو الوليد له صحبة ورواية وعنه خالد بن معدان وعبد الله بن ناسح وجماعة مات سنة 87 د ق(@)(@@)(@@)(@@) | 3669- (@)(@@) عتبة بن غزوان المازني بدري جليل أسلم بعد ستة رجال وكان من الرماة المذكورين وهو الذي اختط البصرة مات على المشهور في سنة 17 وله سبع وخمسون سنة روى عنه خالد بن عمير وجماعة م ت س ق(@)(@@)(@@)(@@) | 3670- (@)(@@) عتبة بن فرقد السلمي صحابي نزل الكوفة وعنه قيس بن أبي حازم والشعبي س(@)(@@)(@@)(@@) | 3671- (@)(@@) عتبة بن محمد بن الحارث بن نوفل عن بن عباس وجماعة وعنه بن جريج وجماعة وثق د س(@)(@@)(@@)(@@) | 3672- (@)(@@) عتبة بن أبي عتبة مسلم عن جماعة منهم عبيد بن حنين وعنه إسماعيل بن جعفر 
