ms2801	 8119) .(@)(@@)(@@)(@@) $ 15155-(@)(@@) قد كنت أسمعها منكم فتؤذينى فلا تقولوا ما شاء الله وما شاء محمد (ابن حبان، وسمويه، والضياء عن جابر بن سمرة)(@)(@@) أخرجه ابن حبان (13/32، رقم 5725) .(@)(@@)(@@)(@@) $ 15156-(@)(@@) قد كنت أكره لكم أن تقولوا ما شاء الله وشاء محمد ولكن قولوا ما شاء الله ثم ما شاء محمد (الحكيم عن حذيفة)(@)(@@) ذكره الحكيم (4/143) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15157-(@)(@@) قد كنت أكرهها منكم فقولوا ما شاء الله ثم ما شاء محمد (أحمد، والنسائى، وأبو داود، وابن أبى عمر، وابن خزيمة، والضياء عن حذيفة)(@)(@@) أخرجه أحمد (5/393، رقم 23387) ، وأبو داود (4/295، رقم 4980) . وأخرجه أيضا: ابن ماجه (1/685، رقم 2118) .(@)(@@)(@@)(@@) $ 15158-(@)(@@) قد كنت نهيتكم عن زيارة القبور فقد أذن لمحمد فى زيارة قبر أمه فزوروها فإنها تذكركم الآخرة (الترمذى - حسن صحيح - عن بريدة)(@)(@@) أخرجه الترمذى (3/370، رقم 1054) .(@)(@@)(@@)(@@) $ 15159-(@)(@@) قد مات كسرى فلا كسرى بعده فإذا هلك قيصر فلا قيصر بعده والذى نفسى بيده لتنفقن كنوزهما فى سبيل الله (مسلم عن أبى هريرة)(@)(@@) أخرجه مسلم (4/2236، رقم 2918) .(@)(@@)(@@)(@@) $ 15160-(@)(@@) قد هجرت الشرك ولكنه الجهاد هل لك أحد باليمن قال أبوين قال أذنا لك قال لا قال ارجع فاستأذنهما فإن أذنا لك فجاهد وإلا فبرهما (ابن حبان عن أبى سعيد)(@)(@@) أخرجه ابن حبان (2/165، رقم 422) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15161-(@)(@@) قد يتوجه الرجلان إلى المسجد فينصرف أحدهما وصلاته أفضل من الآخر إذا كان أفضلها عقلا وينصرف الآخر وصلاته لا تعدل مثقال ذرة (الطبرانى، وابن عساكر عن أبى أيوب)(@)(@@) أخرجه الطبرانى (4/149، رقم 3970) ، وابن عساكر (37/202) قال الهيثمى (8/28) : فيه محمد بن رجاء السختيانى، ولم أعرفه، وبقية رجاله ثقات.(@)(@@)(@@)(@@) $ 15162-(@)(@@) قدر الله المقادير وكتبها قبل أن يخلق السموات والأرضين بخمسين ألف سنة (أحمد، والترمذى - حسن صحيح غريب - والطبرانى عن ابن عمرو)(@)(@@) أخرجه أحمد (2/169، رقم 6579) ، والترمذى (4/458، رقم 2156) ، وقال: حسن صحيح غريب. وأخرجه أيضا: البزار (6/426، رقم 2456) ، وعبد بن حميد (ص 136، رقم 343) ، والرافعى (3/448) .(@)(@@)(@@)(@@) $ 15163-(@)(@@) قدمت المدينة ولأهل المدينة يومان يلعبون فيهما فى الجاهلية وإن الله قد أبدلكم بهما خيرا منهما يوم الفطر ويوم النحر (البيهقى فى السنن الكبرى، وشعب الإيمان عن أنس)(@)(@@) PageV00P000(@)(@@) أخرجه 
ms2802	 البيهقى فى السنن الكبرى (3/277، رقم 5918) ، وفى شعب الإيمان (3/341، رقم 3709) . وأخرجه أيضا: أحمد (3/178، رقم 12850) ، وأبو يعلى (6/452، رقم 3841) .(@)(@@)(@@)(@@) $ 15164-(@)(@@) قدمت خير مقدم من الجهاد الأصغر إلى الجهاد الأكبر مجاهدة العبد هواه (الديلمى عن جابر)(@)(@@) أخرجه أيضا: البيهقى فى الزهد (2/165، رقم 373) ، وقال: هذا فيه ضعف. والخطيب (13/523) .(@)(@@)(@@)(@@) $ 15165-(@)(@@) قدموا أكثركم قرآنا (ابن أبى شيبة عن عمرو بن سلمة عن أبيه)(@)(@@) أخرجه ابن أبى شيبة (1/302، رقم 3456) .(@)(@@)(@@)(@@) $ 15166-(@)(@@) قدموا اليمامى من الطين فإنه من أحسنكم له مسا (ابن حبان عن طلق)(@)(@@) أخرجه ابن حبان (3/404، رقم 1122) .(@)(@@)(@@)(@@) $ 15167-(@)(@@) قدموا خياركم لتزكوا صلاتكم وكلوا الحلال يتم لكم صومكم وأشركوا مع لا إله إلا الله أعمالا زاكية ترجح موازينكم يوم القيامة (الديلمى عن جابر)(@)(@@)(@@)(@@) $ 15168-(@)(@@) قدموا قريشا ولا تقدموها وتعلموا منها ولا تعلموها (الشافعى، وابن جرير، والبيهقى فى المعرفة عن ابن شهاب)(@)(@@) PageV00P000(@)(@@) أخرجه الشافعى (1/278) .(@)(@@)(@@)(@@) $ 15169-(@)(@@) قدموا قريشا ولا تقدموها وتعلموا من قريش ولا تعلموها ولولا أن تبطر قريش لأخبرتها ما لخيارها عند الله (الطبرانى عن عبد الله بن السائب. أبو نعيم فى الحلية، والديلمى عن أنس بلاغا)(@)(@@) حديث عبد الله بن السائب: أخرجه أيضا: ابن أبى عاصم (2/637، رقم 1519) قال المناوى (4/512) : فيه أبو معشر قالوا ضعيف.(@)(@@) حديث أنس: أخرجه أبو نعيم فى الحلية (9/64) .(@)(@@)(@@)(@@) $ 15170-(@)(@@) قده بيده (الطبرانى عن ابن عباس)(@)(@@) أخرجه الطبرانى (11/34، رقم 10954) عن ابن عباس أن النبى - صلى الله عليه وسلم - مر برجل يطوف بالبيت ورجل يقوده بخزام فى أنفه فى نذر كان عليه فقطعه وقال: قده بيده ومر برجل قد ربط يده إلى إنسان بسير أو بخيط أو شىء غير ذلك فقطعه وقال النبى - صلى الله عليه وسلم -: قده بيده. وأخرجه أيضا: أحمد (1/364، رقم 3443) ، والبخارى (2/586، رقم 1541) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15171-(@)(@@) قرآن فى صلاة خير من قرآن فى غير صلاة وقرآن فى غير صلاة خير مما سواه من الذكر والذكر خير من الصدقة والصدقة خير من الصيام والصيام جنة حصينة من النار ولا قول إلا بعمل ولا قول وعمل إلا بنية ولا قول وعمل ونية إلا 
ms2803	 باتباع السنة (أبو نصر السجزى فى الإبانة عن أبى هريرة وقال غريب المتن والإسناد)(@)(@@) أخرجه أيضا: ابن عدى (3/44، ترجمة 601 خالد بن عبد الدائم) وقال: لا بأس به إذا حدث عن ثقة وحدث عن ثقة، وابن حبان فى الضعفاء (1/280، ترجمة 297 خالد بن عبد الدائم) وقال: يروى المناكير التى لا تشبه حديث الثقات.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15172-(@)(@@) قراء القرآن ثلاثة رجل قرأ القرآن فاتخذه بضاعة فاستجر به الملوك واستمال به الناس ورجل قرأ القرآن فأقام حروفه وضيع حدوده كثر هؤلاء من قراء القرآن لا كثرهم الله تعالى ورجل قرأ القرآن فوضع دواء القرآن على داء قلبه فأسهر به ليله وأظمأ به نهاره وقاموا فى مساجدهم وخنوا به تحت برانسهم فبهؤلاء يدفع الله البلاء ويزيل من الأعداء وينزل غيث السماء فوالله لهؤلاء من قراء القرآن أعز من الكبريت الأحمر (ابن حبان فى الضعفاء، وأبو نصر السجزى فى الإبانة، والديلمى عن بريدة. وقال السجزى: غريب لم يروه غير أحمد بن ميثم وفيه مقال. البيهقى فى شعب الإيمان عن الحسن قوله)(@)(@@) حديث بريدة: أخرجه ابن حبان فى الضعفاء (1/148، ترجمة 79) ، وقال بعد أن ذكر الحديث وغيره: هذان حديثان لا أصل لهما. وأورده ابن الجوزى فى العلل المتناهية (1/117، رقم 159) ، وقال: لا يصح.(@)(@@) حديث الحسن: أخرجه البيهقى فى شعب الإيمان (2/531، رقم 2621) .(@)(@@) PageV00P000(@)(@@) ومن غريب الحديث: "خنوا": بكوا.(@)(@@)(@@)(@@) $ 15173-(@)(@@) قراءة الرجل القرآن فى غير المصحف ألف درجة وقراءته فى المصحف تضاعف على ذلك إلى ألفى درجة (الطبرانى، وابن عدى، والبيهقى فى شعب الإيمان عن عثمان بن عبد الله بن أوس بن أبى أوس الثقفى عن جده وصحح)(@)(@@) أخرجه الطبرانى (1/221، رقم 601) قال الهيثمى (7/165) : فيه أبو سعيد بن عون، وثقه ابن معبد فى رواية وضعفه فى أخرى، وبقية رجاله ثقات، وابن عدى (7/299، رقم 2203 أبو سعيد بن عوذ) ، والبيهقى فى شعب الإيمان (2/407، رقم 2218) .(@)(@@)(@@)(@@) $ 15174-(@)(@@) قراءة القرآن فى الصلاة أفضل من قراءة القرآن فى غير الصلاة وقراءة القرآن فى غير الصلاة أفضل من التسبيح والتكبير والتسبيح أفضل من 
ms2804	 الصدقة والصدقة أفضل من الصوم والصوم جنة من النار (الدارقطنى فى الأفراد، والبيهقى فى شعب الإيمان، وأبو نصر عن عائشة)(@)(@@) أخرجه البيهقى فى شعب الإيمان (2/413، رقم 2243) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15175-(@)(@@) قراءة القرآن فى الصلاة أفضل من قراءة القرآن فى غير الصلاة وقراءة القرآن فى غير الصلاة أفضل من الذكر والذكر أفضل من الصدقة والصدقة أفضل من الصيام والصيام جنة من النار ونوم الصائم عبادة ونفسه تسبيح ومن أصبح صائما سبحت له أعضاؤه وأضاءت له السموات نورا واستغفر له كل ملك فى السماء فإن سبح أو هلل يتلقاه سبعون ألف ملك يكتبونها إلى أن توارت بالحجاب ولا قول إلا بعمل ولا قول وعمل إلا بالنية ولا قول وعمل ونية إلا بإصابة السنة ومن رضى من الله بالقليل من الرزق رضى الله منه باليسير من العمل (أبو نصر عن وهب بن وهب أبى البخترى عن جعفر بن محمد عن أبيه عن جده وقال: وهب ليس بالقوى وفى الإسناد إرسال)(@)(@@) أورده الذهبى فى الميزان (5/304، ترجمة 6351 عمرو بن جميع) وقال: كذبه ابن معين وقال الدارقطنى متروك وقال ابن عدى: كان يتهم بالوضع وقال البخارى منكر الحديث.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15176-(@)(@@) قراءتك نظرا تضاعف على قراءتك ظاهرا كفضل المكتوبة على النافلة (ابن مردويه عن عثمان بن عبد الله بن أوس الثقفى عن عمرو بن أوس)(@)(@@)(@@)(@@) $ 15177-(@)(@@) قربيه فقد بلغت محلها (مسلم عن جويرية أن رسول الله - صلى الله عليه وسلم - قال هل من طعام قالت ما عندنا إلا عظم من شاة أعطيت مولاتى من الصدقة قال ... فذكره)(@)(@@) أخرجه مسلم (2/754، رقم 1073) .(@)(@@)(@@)(@@) $ 15178-(@)(@@) قربيه فما أقفر بيت من أدم فيه خل (الترمذى - حسن غريب - عن أم هانئ)(@)(@@) أخرجه الترمذى (4/279، رقم 1841) ، وقال: حسن غريب. وفى الحديث أن النبى - صلى الله عليه وسلم - دخل على أم هانئ بنت أبى طالب فقال: هل عندكم شىء؟ قالت: لا إلا كسر يابسة وخل. فذكره.(@)(@@)(@@)(@@) $ 15179-(@)(@@) قرسوا الماء فى الشنان ثم صبوا عليكم ما بين الأذانين من صلاة الصبح قاله للمحمومين (البغوى عن بعض الصحابة)(@)(@@) PageV00P000(@)(@@) أخرجه أيضا: ابن أبى 
ms2805	 شيبة (5/63، رقم 23724) ، وفى الحديث أن رسول الله - صلى الله عليه وسلم - غزا بأصحابه فمر قوم مسغبون يعنى جياعا بشجرة خضرا فأكلوا منها فكأنما مرت بهم ريح فأخمدتهم(@)(@@)(@@)(@@) $ …(@)(@@) فذكره.(@)(@@)(@@)(@@) $ 15180-(@)(@@) قرصت نملة نبيا من الأنبياء فأمر بقرية النمل فأحرقت فأوحى الله إليه أن قرصتك نملة أحرقت أمة من الأمم تسبح (البخارى، ومسلم، وأبو داود، والنسائى، وابن ماجه عن أبى هريرة)(@)(@@) أخرجه البخارى (3/1099، رقم 2856) ، ومسلم (4/1759، رقم 2241) ، وأبو داود (4/367، رقم 5266) ، وابن ماجه (2/1075، رقم 3225) .(@)(@@)(@@)(@@) $ 15181-(@)(@@) قرض الشىء خير من صدقته (البيهقى عن أنس)(@)(@@) أخرجه البيهقى (5/354، رقم 10736) .(@)(@@)(@@)(@@) $ 15182-(@)(@@) قرض مرتين فى عفاف خير من صدقة مرة (ابن النجار عن أنس. الديلمى عن ابن مسعود)(@)(@@) حديث أنس: أخرجه الديلمى (3/221، رقم 4644) .(@)(@@)(@@)(@@) $ 15183-(@)(@@) قرض مرتين كصدقة مرة (أبو الشيخ، وأبو نعيم فى المعرفة عن محمد المزنى بن مهند)(@)(@@) PageV00P000(@)(@@) أورده الحافظ فى الإصابة (6/38، ترجمة 7820 محمد المزنى والد مهند) ، وقال: أخرجه الباوردى عن مطين. وقال أبو نعيم: لا يصح له صحبة ولا رؤية فيما أرى.(@)(@@)(@@)(@@) $ 15184-(@)(@@) قريش خالصة الله فمن نصب لها حربا سلب ومن أرادها بسوء خزى فى الدنيا والآخرة (ابن عساكر عن عمرو بن العاصى)(@)(@@) أخرجه ابن عساكر (8/306) .(@)(@@)(@@)(@@) $ 15185-(@)(@@) قريش سادة العرب وقيس فرسانها وتميم رحاها (الرامهرمزى فى الأمثال عن الوضين بن مسلم مرسلا)(@)(@@) أخرجه الرامهرمزى (1/149، رقم 112) .(@)(@@)(@@)(@@) $ 15186-(@)(@@) قريش على مقدمة الناس يوم القيامة ولولا أن تبطر قريش لأخبرتها بما لمحسنها عند الله من الثواب (ابن عدى عن جابر)(@)(@@) أخرجه ابن عدى (1/302، ترجمة 129 إسماعيل بن يحيى بن عبد الله) ، وقال: هذا الحديث بهذا الإسناد باطل.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15187-(@)(@@) قريش والأنصار وجهينة ومزينة وأسلم وأشجع وغفار موالى ليس لهم مولى دون الله ورسوله (ابن أبى شيبة، والبخارى، ومسلم عن أبى هريرة. أحمد، والطبرانى، والضياء عن زيد بن خالد الجهنى)(@)(@@) حديث أبى هريرة: أخرجه ابن أبى شيبة (6/400، رقم 32370) ، والبخارى (3/1290، رقم 3313) ، ومسلم(@)(@@) (4/1954، رقم 2520) .(@)(@@) حديث زيد بن خالد: أخرجه أحمد (5/193، رقم 21734) ، والطبرانى (5/250، رقم 5247) .(@)(@@)(@@)(@@) $ 15188-(@)(@@) قريش ولاة الناس فى الخير والشر إلى يوم القيامة (أحمد، والترمذى 
ms2806	 - حسن صحيح غريب - وابن جرير عن عمرو بن العاصى. الطبرانى عن معاوية)(@)(@@) حديث عمرو بن العاص: أخرجه أحمد (4/203، رقم 17841) ، والترمذى (4/503، رقم 2227) ، وقال: حسن غريب صحيح.(@)(@@) حديث معاوية: أخرجه الطبرانى (19/360، رقم 847) .(@)(@@)(@@)(@@) $ 15189-(@)(@@) قريش ولاة هذا الأمر فبر الناس تبع لبرهم وفاجرهم تبع لفاجرهم (أحمد، وابن جرير عن أبى بكر وسعد معا)(@)(@@) أخرجه أحمد (1/5، رقم 18) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15190-(@)(@@) قزوين باب من أبواب الجنة هى اليوم فى أيدى المشركين وستفتح على يدى أمتى من بعدى المفطر فيها كالصائم فى غيرها والقاعد فيها كالمصلى فى غيرها وإن الشهيد فيها يركب يوم القيامة على براذين من نور فيساق إلى الجنة ثم لا يحاسب على ذنب أذنبه ولا عمل عمله وهو فى الجنة خالدا ويزوج من الحور العين ويسقى من الألبان والعسل والسلسبيل مع ما له عند الله من المزيد (أبو العلاء الحسن بن أحمد العطار فى فضائل قزوين، والرافعى عن على)(@)(@@) أخرجه الرافعى (1/16) .(@)(@@) ومن غريب الحديث: "براذين" مفردها البرذون، وهى الخيول والبغال غير العربية.(@)(@@)(@@)(@@) $ 15191-(@)(@@) قزوين باب من أبواب الجنة يحشر من مقبرتها كذا وكذا ألف شهيد (الخطيب فى فضائل قزوين، والرافعى عن أبى هريرة)(@)(@@) أخرجه الرافعى (1/21) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15192-(@)(@@) قسم الحفظ عشرة أجزاء فتسعة فى الترك وجزء فى سائر الناس وقسم البخل عشرة أجزاء فتسعة فى فارس وجزء فى سائر الناس وقسم السخاء عشرة أجزاء فتسعة فى السودان وجزء فى سائر الناس وقسم الحياء عشرة أجزاء فتسعة فى العرب وجزء فى سائر الناس وقسم الكبر عشرة أجزاء فتسعة فى الروم وواحد فى سائر الناس (الخطيب فى كتاب البخلاء عن سيف بن عمر عن بكر بن وائل عن محمد بن مسلم. [الديلمى عن أنس] )(@)(@@) حديث أنس: أخرجه الديلمى (2/37، رقم 2229) .(@)(@@)(@@)(@@) $ 15193-(@)(@@) قسم الله الأرض نصفين فجعلنى فى خيرهما ثم قسم النصف على ثلاثة فكنت فى خير ثلث منها ثم اختار العرب من الناس ثم اختار قريشا من العرب ثم اختار بنى هاشم من قريش ثم اختار بنى عبد المطلب من بنى هاشم ثم اختارنى من بنى عبد المطلب 
ms2807	 (ابن سعد عن جعفر بن محمد بن على بن حسين عن أبيه معضلا)(@)(@@) أخرجه ابن سعد (1/20) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15194-(@)(@@) قسم ربنا رحمته مائة جزء فأنزل منها جزءا فى الأرض فهو الذى يتراحم به الناس والطير والبهائم وبقيت عنده مائة رحمة إلا رحمة واحدة لعباده يوم القيامة (الطبرانى عن عبادة بن الصامت)(@)(@@) أخرجه الطبرانى كما فى مجمع الزوائد (10/214) قال الهيثمى: فيه إسحاق بن يحيى لم يدرك عبادة، وبقية رجاله غير إسحاق رجال الصحيح.(@)(@@)(@@)(@@) $ 15195-(@)(@@) قسم من الله لا يدخل الجنة بخيل (ابن عساكر عن ابن عباس وقال: غريب جدا وفيه محمد بن زكريا الغلابى ضعيف)(@)(@@) أخرجه ابن عساكر (57/373) ، وقال: غريب جدا والغلابى ضعيف.(@)(@@)(@@)(@@) $ 15196-(@)(@@) قسمت الحكمة عشرة أجزاء فأعطى على تسعة أجزاء والناس جزءا واحدا وعلى أعلم بالواحد منهم (أبو نعيم فى الحلية، والأزدى فى الضعفاء، وأبو على الحسين بن على البرذعى فى معجمه، وابن النجار، وابن الجوزى فى الواهيات عن ابن مسعود)(@)(@@) PageV00P000(@)(@@) أخرجه أبو نعيم فى الحلية (1/65) ، وابن الجوزى فى العلل المتناهية (1/241، رقم 385) ، وقال: لا يصح وفيه مجاهيل. وأخرجه أيضا: الديلمى (3/227، رقم 4666) ، والذهبى فى الميزان (1/266، ترجمة 498 أحمد بن عمران بن سلمة) ، وقال: هذا كذب.(@)(@@)(@@)(@@) $ 15197-(@)(@@) قسمت النار سبعين جزءا فللآمر تسعة وستون وللقاتل جزء وحسبه (أحمد عن رجل. البيهقى فى شعب الإيمان عن ابن مسعود)(@)(@@) حديث رجل من الصحابة: أخرجه أحمد (5/362، رقم 23116) . قال الهيثمى (7/299) : رجاله رجال الصحيح غير محمد بن إسحاق، وهو ثقة، ولكنه مدلس. وأخرجه أيضا: البيهقى فى شعب الإيمان (4/349، رقم 5360) .(@)(@@)(@@)(@@) $ 15198-(@)(@@) قص فلأن أقعد هذا المقعد من حين أصلى الغداة إلى أن تشرق الشمس أحب إلى من أن أعتق أربع رقاب ولأن أقعد من حين أصلى العصر إلى أن تغرب الشمس أحب إلى من أن أعتق أربع رقاب (أحمد، والطبرانى، والضياء عن أبى أمامة)(@)(@@) PageV00P000(@)(@@) أخرجه أحمد (5/261، رقم 22308) ، والطبرانى (8/260، رقم 8013) قال الهيثمى (1/190) : رجاله موثقون.(@)(@@)(@@)(@@) $ 15199-(@)(@@) قصاص أهل الذمة من أمتى يوم القيامة يخفف عنهم من عذابهم (الحاكم فى تاريخه عن أبى هريرة وفيه 
ms2808	 محمد بن مخلد الحمصى يروى الأباطيل)(@)(@@) أخرجه أيضا: الديلمى (3/221، رقم 4643) .(@)(@@)(@@)(@@) $ 15200-(@)(@@) قصوا أظافيركم وادفنوا قلاماتكم ونقوا براجمكم ونظفوا لثاتكم من الطعام واستاكوا ولا تدخلوا على قلحا بخرا (الحكيم عن عبد الله بن بسر المازنى)(@)(@@) ذكره الحكيم (1/185) .(@)(@@) ومن غريب الحديث: "براجمكم": العقد التى فى ظهور الأصابع والتى يجتمع فيها الوسخ. "قلحا": القلح هو صفرة تعلو الأسنان ووسخ يركبها. "بخرا": الأبخر هو من كان فمه له رائحة كريهة.(@)(@@)(@@)(@@) $ 15201-(@)(@@) قصوا الشوارب مع الشفاه (ابن قانع، والطبرانى عن الحكم بن عمير)(@)(@@) أخرجه ابن قانع (1/205) ، والطبرانى (3/219، رقم 3195) قال الهيثمى (5/167) : فيه عيسى بن إبراهيم بن طهمان، وهو متروك.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15202-(@)(@@) قصوا الشوارب وأعفوا اللحى (أحمد عن أبى هريرة)(@)(@@) أخرجه أحمد (2/229، رقم 7132) .(@)(@@)(@@)(@@) $ 15203-(@)(@@) قصوا شاربكم فإن بنى إسرائيل لم يفعلوا فزنت نساؤهم (الديلمى عن ابن عمر)(@)(@@) أخرجه الديلمى (3/205، رقم 4578) .(@)(@@)(@@)(@@) $ 15204-(@)(@@) قضاعة بن معد وبه كان يكنى (ابن السنى عن عائشة)(@)(@@)(@@)(@@) $ 15205-(@)(@@) قضى إذا تشاجروا فى الطريق بسبعة أذرع (البخارى عن أبى هريرة)(@)(@@) أخرجه البخارى (2/874، رقم 2341) .(@)(@@)(@@)(@@) $ 15206-(@)(@@) قضى أن الخصمين يقعدان بين يدى الحاكم (أحمد، والحاكم عن عبد الله بن الزبير)(@)(@@) أخرجه أحمد (4/4، رقم 16149) ، والحاكم (4/106، رقم 7029) ، وقال: صحيح الإسناد. وأخرجه أيضا: البيهقى (10/135، رقم 20243) .(@)(@@)(@@)(@@) $ 15207-(@)(@@) قضى أن الخصمين يقعدان بين يدى الحكم (أبو داود عن ابن الزبير)(@)(@@) أخرجه أبو داود (3/302، رقم 3588) . وأخرجه أيضا: أحمد (4/4، رقم 16149) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15208-(@)(@@) قضى أن السرقة إذا وجدت عند الرجل غير المتهم فإن شاء سيدها أخذها بالثمن وإن شاء اتبع سارقه (الطبرانى عن أسيد بن حضير)(@)(@@) أخرجه الطبرانى (1/205، رقم 555) . وأخرجه أيضا: الحاكم (2/41، رقم 2255) ، وقال: صحيح على شرط الشيخين.(@)(@@)(@@)(@@) $ 15209-(@)(@@) قضى أن العقل ميراث بين ورثة القتيل على قرابتهم فما فضل فللعصبة (أبو داود، والنسائى عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أبو داود (4/189، رقم 4564) ، والنسائى (8/42، رقم 4801) . وأخرجه أيضا: البيهقى (8/58،(@)(@@) رقم 15844) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15210-(@)(@@) قضى أن المعدن جبار والبئر جبار والعجماء جرحها جبار وقضى فى الركاز الخمس وقضى أن ثمر النخل لمن أبرها إلا أن يشترط المبتاع وأن ملك المملوك 
ms2809	 لمن باعه إلا أن يشترط المبتاع وقضى أن الولد للفراش وللعاهر الحجر وقضى بالشفعة بين الشركاء فى الأرضين والدور وقضى فى الجنين المقتول بغرة عبد أو أمة وقضى فى الرحبة تكون من الطريق ثم يريد أهلها البنيان فيها فقضى أن يترك للطريق منها سبع أذرع وقضى فى النخلة أو النخلتين أو الثلاث يختلفون فى حقوق ذلك فقضى أن لكل نخلة من أولئك مبلغ جريدها حريم لها وقضى فى شرب النخل من السيل أن الأعلى يشرب قبل الأسفل ويترك الماء إلى الكعبين ثم يرسل الماء إلى الأسفل الذى يليه فكذلك حتى تنقضى الحوائط أو يفنى الماء وقضى أن المرأة لا تعطى من مالها شيئا إلا بإذن زوجها وقضى للجدتين من الميراث بالسدس بينهما بالسواء وقضى أن من أعتق شركا فى مملوك فعليه جواز عتقه إن كان له وقضى أن لا ضرر ولا ضرار وقضى أنه(@)(@@) PageV00P000(@)(@@) ليس لعرق ظالم حق وقضى بين أهل المدينة فى النخل لا يمنع نقع بئر وقضى بين أهل البادية أن لا يمنع فضل ماء ليمنع فضل الكلإ لعمل الكلإ وقضى فى الدية الكبرى المغلظة ثلاثين ابنة لبون وثلاثين حقة وأربعين خلفة وقضى فى الدية الصغرى ثلاثين ابنة لبون وثلاثين حقة وعشرين ابنة مخاض وعشرين بنى مخاض ذكور (عبد الله بن أحمد فى زوائده على المسند، وأبو عوانة، والطبرانى عن عبادة بن الصامت)(@)(@@) أخرجه عبد الله بن أحمد فى زوائده على المسند (5/326، رقم 2830) قال الهيثمى (4/203) : إسحاق لم يدرك عبادة. وأبو عوانة (4/159، رقم 6373) . .(@)(@@)(@@)(@@) $ 15211-(@)(@@) قضى أن اليمين على المدعى عليه (البخارى، ومسلم، وأبو داود، والترمذى عن ابن عباس)(@)(@@) أخرجه البخارى (2/888، رقم 2379) ، ومسلم (3/1336، رقم 1711) ، وأبو داود (3/311، رقم 3619) ، والترمذى (3/626، رقم 1342) ، وقال: حسن صحيح.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15212-(@)(@@) قضى أن حفظ الحوائط بالنهار على أهلها وأن حفظ الماشية بالليل على أهلها وأن ما أصابت الماشية بالليل فهو على أهلها (مالك، والشافعى، وابن أبى شيبة، وأحمد، وأبو داود، والنسائى، وابن ماجه، وابن حبان، والدارقطنى، والحاكم عن حرام بن محيصة عن البراء 
ms2810	 بن عازب. أبو داود عن حرام بن محيصة عن أبيه)(@)(@@) حديث حرام بن محيصة عن البراء بن عازب: أخرجه مالك (2/747، رقم 1435) ، والشافعى (1/195) ، وابن أبى شيبة (7/303، رقم 36300) ، وأحمد (4/295، رقم 18629) ، وأبو داود (3/298، رقم 3570) ، والنسائى فى الكبرى (3/411، رقم 5785) ، وابن ماجه (2/781، رقم 2332) ، والدارقطنى (3/155) ، والحاكم (2/55، رقم 2303) . وأخرجه أيضا: البيهقى (8/341، رقم 17454) .(@)(@@) حديث حرام بن محيصة عن أبيه: أخرجه أبو داود (3/298، رقم 3569) . وأخرجه أيضا: ابن حبان (13/354، رقم 6008) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15213-(@)(@@) قضى أن عقل أهل الكتابين نصف عقل المسلمين (أحمد، وابن ماجه عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أحمد (2/224، رقم 7092) . وأخرجه أيضا: ابن ماجه (2/883، رقم 2644) .(@)(@@)(@@)(@@) $ 15214-(@)(@@) قضى أن من قتل خطأ فديته مائة من الإبل ثلاثون بنت مخاض وثلاثون بنت لبون وثلاثون حقة وعشر بنى لبون ذكر (أبو داود، وابن ماجه عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أبو داود (4/184، رقم 4541) ، وابن ماجه (2/878، رقم 2630) . وأخرجه أيضا: أحمد (2/183، رقم 6719)(@)(@@) وللحديث أطراف أخرى منها: "من قتل خطأ".(@)(@@)(@@)(@@) $ 15215-(@)(@@) قضى أن من كان عقله فى البقر على أهل البقر مائتى بقرة ومن كان عقله فى الشاء على أهل الشاء ألفى شاة (أحمد، وابن ماجه عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أحمد (2/217، رقم 7033) ، وابن ماجه (2/878، رقم 2630) . وأخرجه أيضا: النسائى (8/42، رقم 4801) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15216-(@)(@@) قضى الله فى الحق بشاهدين فإن جاء بشاهدين أخذ حقه وإن جاء بشاهد واحد حلف مع شاهده (الدارقطنى فى الأفراد عن ابن عمرو)(@)(@@) أخرجه أيضا: الديلمى (3/209، رقم 4595) .(@)(@@)(@@)(@@) $ 15217-(@)(@@) قضى بالجوار (أحمد عن على وابن مسعود معا)(@)(@@) أخرجه أحمد (1/114، رقم 923) .(@)(@@)(@@)(@@) $ 15218-(@)(@@) قضى بالدية على العاقلة (ابن ماجه عن المغيرة بن شعبة)(@)(@@) أخرجه ابن ماجه (2/879، رقم 2633) .(@)(@@)(@@)(@@) $ 15219-(@)(@@) قضى بالدين قبل الوصية وأن أعيان بنى الأم يتوارثون دون بنى العلات (ابن أبى شيبة، وأحمد، والترمذى وضعفه، وابن ماجه، والحاكم عن على)(@)(@@) أخرجه ابن أبى شيبة (6/8، رقم 29054) ، وأحمد (1/144، رقم 1221) ، والترمذى (4/416، رقم 2094) ، وابن ماجه (2/906، رقم 2715) ، والحاكم (4/373، رقم 7967) . وأخرجه أيضا: 
ms2811	 أبو يعلى (1/257، رقم 300) ، والبيهقى (6/267، رقم 12341) .(@)(@@)(@@)(@@) $ 15220-(@)(@@) قضى بالسلب للقاتل (أبو داود عن خالد بن الوليد. الطبرانى عن عوف بن مالك)(@)(@@) PageV00P000(@)(@@) حديث خالد بن الوليد: أخرجه أبوداود (3/72، رقم 2721) عن عوف بن مالك الأشجعى وخالد بن الوليد.(@)(@@) حديث عوف بن مالك: أخرجه الطبرانى (18/52، رقم 92) .(@)(@@) ومن غريب الحديث: "السلب" هو ما يكون على المقتول فى الحرب من سلاح وملابس أو معه كالدابة وغيرها.(@)(@@)(@@)(@@) $ 15221-(@)(@@) قضى بالشفعة فى كل ما لم يقسم فإذا وقعت الحدود وصرفت الطرق فلا شفعة (أحمد، والبخارى، وابن ماجه عن جابر)(@)(@@) أخرجه أحمد (3/372، رقم 15041) ، والبخارى (2/883، رقم 2363) ، وابن ماجه (2/835، رقم 2499) .(@)(@@)(@@)(@@) $ 15222-(@)(@@) قضى بالشفعة فيما لم يقسم وتصرف حدوده (الطيالسى عن جابر)(@)(@@) أخرجه الطيالسى (ص235، رقم 1691) .(@)(@@)(@@)(@@) $ 15223-(@)(@@) قضى بالشفعة للجار (النسائى عن جابر)(@)(@@) أخرجه النسائى (7/321، رقم 4705) . وأخرجه أيضا: البخارى فى التاريخ الكبير (1/111) .(@)(@@)(@@)(@@) $ 15224-(@)(@@) قضى بالعمرى أنها لمن وهبت له (البخارى، ومسلم عن جابر)(@)(@@) أخرجه البخارى (2/925، رقم 2482) ، ومسلم (3/1246، رقم 1625) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15225-(@)(@@) قضى باليمين مع الشاهد الواحد (أحمد، وابن أبى شيبة، ومسلم، وأبو داود، وابن ماجه عن ابن عباس. أحمد، والترمذى، وابن ماجه، والبيهقى، والطبرانى فى الأوسط عن جابر. أبو داود، والترمذى، وابن ماجه، والبيهقى عن أبى هريرة. البيهقى عن ابن عمرو. الباوردى، والطبرانى، والحاكم، والضياء عن بلال بن الحارث المزنى. الطبرانى، وأبو نعيم فى الحلية، والبيهقى عن زيد بن ثابت. ابن قانع عن شعيب بن عبد الله بن الزبير بن ثعلبة عن أبيه عن جده. أبو عوانة، وابن قانع، والطبرانى، والبيهقى عن سرق. البيهقى عن على. أحمد، والطبرانى، والدارقطنى، والبيهقى عن سعد بن عبادة. ابن قانع، والبيهقى عن شعيب بن عبد الله بن شعيب العنبرى عن أبيه عن جده. أحمد، والطبرانى، والبيهقى عن عمارة بن حزم. النقاش فى القضاء عن ابن عمر. ابن أبى شيبة عن أبى جعفر مرسلا. [الطبرانى فى الأوسط وفى الصغير عن أبى سعيد] )(@)(@@) PageV00P000(@)(@@) حديث ابن عباس: أخرجه أحمد (1/323، رقم 2970) ، وابن أبى شيبة (4/340، رقم 20828) ، ومسلم (3/1336، رقم 1711) ، وأبو داود (3/311، رقم 3619) ، وابن ماجه (2/793، 
ms2812	 رقم 2370) . وأخرجه أيضا: الشافعى (1/149) ، والنسائى فى الكبرى (3/490، رقم 6011) ، وقال: هذا إسناد جيد. وابن الجارود (ص 252، رقم 1006) ، وأبو عوانة (4/56، رقم 6010) ، والدارقطنى (4/214) ، والبيهقى (10/167، رقم 20422) .(@)(@@) حديث جابر: أخرجه أحمد (3/305، رقم 14317) ، والترمذى (3/628، رقم 1344) ، وابن ماجه (2/793، رقم 2369) ، والبيهقى (10/169، رقم 20439) ، والطبرانى فى الأوسط (7/229، رقم 7349) . وأخرجه أيضا: ابن الجارود (ص 252، رقم 1008) ، والدارقطنى (4/212) .(@)(@@) PageV15P163(@)(@@) حديث أبى هريرة: أخرجه أبو داود (3/309، رقم 3610) ، والترمذى (3/627، رقم 1343) ، وقال: حسن غريب. وابن ماجه (2/793، رقم 2368) ، والبيهقى (10/169، رقم 20436) . وأخرجه أيضا: الشافعى (1/150) ، والنسائى فى الكبرى (3/491، رقم 6014) ، والدارقطنى (4/213) . وابن الجارود (ص 252، رقم 1007) ، وابن حبان (11/462، رقم 5073) ، وأبو عوانة (4/56، رقم 6011) ، وأبو يعلى (12/36، رقم 6683) .(@)(@@) حديث ابن عمرو: أخرجه البيهقى (10/172، رقم 20456) . وأخرجه أيضا: الطبرانى فى الأوسط (2/9، رقم 1059) .(@)(@@) حديث بلال بن الحارث المزنى: أخرجه الطبرانى (1/370، رقم 1139) قال الهيثمى (4/202) : رجاله ثقات.(@)(@@) PageV15P164(@)(@@) حديث زيد بن ثابت: أخرجه الطبرانى (5/150، رقم 4909) قال الهيثمى (4/202) : فيه عثمان بن الحكم الجذامى، قال أبو حاتم: ليس بالمتقن، وبقية رجاله ثقات، وأبو نعيم فى الحلية (8/326) ، والبيهقى (10/172، رقم 20457) . وأخرجه أيضا: أبو عوانة (4/57، رقم 6019) ، والطحاوى (4/144) .(@)(@@) حديث سرق: أخرجه أبو عوانة (4/58، رقم 6027) ، والبيهقى (10/172، رقم 20458) .(@)(@@) حديث على: أخرجه البيهقى (10/170، رقم 20446) . وأخرجه أيضا: الصيداوى فى معجم الشيوخ (1/326) .(@)(@@) حديث سعد بن عبادة: أخرجه أحمد (5/285، رقم 22513) ، والطبرانى (6/16، رقم 5361) ، والدارقطنى(@)(@@) (4/214) . والبيهقى من طريق الحاكم (10/171، رقم 20450) . وأخرجه أيضا: الشافعى (1/149) ، وأبو عوانة(@)(@@) (4/58، رقم 6025) .(@)(@@) PageV15P165(@)(@@) حديث عمارة بن حزم: أخرجه أحمد (رقم 28423) وانظر جامع المسانيد (9/315) ، والطبرانى كما فى مجمع الزوائد (4/202) . أخرجه أيضا: أبو عوانة (4/58، رقم 6024) ، وابن قانع (2/249) . قال الهيثمى: رجاله ثقات.(@)(@@) حديث ابن عمر: قال الهيثمى (4/202) : رواه الطبرانى فى الأوسط، وفيه محمد بن عبد الله بن عبيد، وهو متروك.(@)(@@) حديث أبى جعفر: أخرجه ابن أبى شيبة (4/544، رقم 22998) . وأخرجه أيضا: الشافعى (1/150) ، والبيهقى(@)(@@) (10/171، رقم 20448) .(@)(@@) حديث أبى سعيد: أخرجه الطبرانى فى الأوسط (5/98، رقم 4782) ، والصغير (2/9، رقم(@)(@@) 684) قال 
ms2813	 الهيثمى (4/202) : فيه عباد الرحمن بن زيد بن أسلم، وهو ضعيف.(@)(@@)(@@)(@@) $ 15226-(@)(@@) قضى على ابنته فاطمة بخدمة البيت وقضى على على بما كان خارجا من البيت من الخدمة (أبو نعيم فى الحلية عن ضمرة بن حبيب مرسلا)(@)(@@) PageV00P000(@)(@@) أخرجه أبو نعيم فى الحلية (6/104) . وأخرجه أيضا: ابن أبى شيبة (6/10، رقم 29069) ، وهناد (2/386، رقم 750) .(@)(@@)(@@)(@@) $ 15227-(@)(@@) قضى فى الأصابع عشرا عشرا من الإبل (أحمد عن أبى موسى)(@)(@@) أخرجه أحمد (4/403، رقم 19626) . وأخرجه أيضا: ابن أبى شيبة (6/9، رقم 29060) ، والنسائى فى الكبرى(@)(@@) (4/243، رقم 7049) ، وأبو يعلى (13/319، رقم 7335) ، والدارقطنى (3/210) .(@)(@@)(@@)(@@) $ 15228-(@)(@@) قضى فى الأصابع عشرا عشرا وفى اليد بخمسين (الطبرانى عن ابن عباس)(@)(@@) أخرجه الطبرانى (10/291، رقم 10699) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15229-(@)(@@) قضى فى الأنف إذا جدع الدية كاملة وإن جدعت ثندوته فنصف العقل خمسون من الإبل أو عدلها من الذهب أو الورق أو مائة بقرة أو ألف شاة وفى اليد إذا قطعت نصف العقل وفى الرجل نصف العقل وفى المأمومة ثلث العقل ثلاث وثلاثون من الإبل أو قيمتها من الذهب أو الورق أو البقر أو الشاء والجائفة مثل ذلك وفى الأصابع فى كل أصبع عشر من الإبل وفى الأسنان خمس من الإبل فى كل سن وقضى أن عقل المرأة بين عصبتها من كانوا لا يرثون منها شيئا إلا ما فضل عن ورثتها وإن قتلت فعقلها بين ورثتها وهم يقتلون قاتلهم (أحمد، وأبو داود عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أحمد (2/224، رقم 7092) ، وأبو داود (4/189، رقم 4564) .(@)(@@) ومن غريب الحديث: "ثندوته": الثندوتان للرجل كالثديين للمرأة. "الورق": الفضة. "المأمومة": الشجة التى تصل إلى أم الدماغ. "العقل": الدية. "الجائفة": الطعنة التى تصل إلى الجوف.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15230-(@)(@@) قضى فى الجنين بغرة عبد (ابن ماجه عن حمل بن مالك بن النابغة)(@)(@@) أخرجه ابن ماجه (2/882، رقم 2641) .(@)(@@)(@@)(@@) $ 15231-(@)(@@) قضى فى الجنين بغرة عبد أو أمة (أحمد، والترمذى، والنسائى، وابن ماجه عن أبى هريرة. الطبرانى عن المغيرة بن شعبة ومحمد بن مسلمة معا)(@)(@@) حديث أبى هريرة: أخرجه أحمد (2/236، رقم 7216) ، والترمذى (4/23، رقم 1410) ، وقال: حسن صحيح. والنسائى 
ms2814	 (8/47، رقم 4817) ، وابن ماجه (2/882، رقم 2639) .(@)(@@) حديث المغيرة بن شعبة ومحمد بن مسلمة: أخرجه الطبرانى (19/227، رقم 507) .(@)(@@)(@@)(@@) $ 15232-(@)(@@) قضى فى الجنين بغرة عبد أو أمة أو فرس أو بغل (أبو داود عن أبى هريرة)(@)(@@) أخرجه أبو داود (4/193، رقم 4579) .(@)(@@)(@@)(@@) $ 15233-(@)(@@) قضى فى الدية على أهل الإبل مائة من الإبل وعلى أهل البقر مائتى بقرة وعلى أهل الشاء ألفى شاة وعلى أهل الحلل مائتى حلة (أبو داود عن عطاء بن أبى رباح مرسلا. أبو داود عن عطاء عن جابر)(@)(@@) PageV00P000(@)(@@) حديث عطاء المرسل: أخرجه أبو داود (4/184، رقم 4543) .(@)(@@) حديث عطاء عن جابر: أخرجه أبو داود (4/184، رقم 4544)(@)(@@)(@@)(@@) $ 15234-(@)(@@) قضى فى السن خمسا من الإبل (ابن ماجه عن ابن عباس)(@)(@@) أخرجه ابن ماجه (2/885، رقم 2651) قال البوصيرى (3/127) : هذا إسناد صحيح رجاله ثقات.(@)(@@)(@@)(@@) $ 15235-(@)(@@) قضى فى العين القائمة السادة لمكانها بثلث الدية (أبو داود، والنسائى عن عمرو بن شعيب عن أبيه عن جده)(@)(@@) أخرجه أبو داود (4/190، رقم 4567) ، والنسائى فى الكبرى (4/243، رقم 7044) .(@)(@@)(@@)(@@) $ 15236-(@)(@@) قضى فى دية الخطأ عشرين بنت مخاض وعشرين بنى مخاض ذكور وعشرين بنت لبون وعشرين جذعة وعشرين حقة (أحمد، والترمذى، والنسائى، وابن ماجه عن ابن مسعود)(@)(@@) أخرجه أحمد (1/450، رقم 4303) ، والترمذى (4/10، رقم 1386) ، وقال: لا نعرفه مرفوعا إلا من هذا الوجه. والنسائى (8/43، رقم 4802) ، وابن ماجه (2/879، رقم 2631) . وأخرجه أيضا: أبو داود (4/184، رقم 4545) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15237-(@)(@@) قضى فى دية المكاتب يقتل يودى ما أدى من مكاتبته دية الحر وما بقى دية المملوك (أبو داود، والنسائى عن ابن عباس)(@)(@@) أخرجه أبو داود (4/193، رقم 4581) ، والنسائى (8/46، رقم 4810) .(@)(@@)(@@)(@@) $ 15238-(@)(@@) قضى فى سيل مهزور أن يمسك الماء حتى يبلغ الكعبين ثم يرسل الأعلى إلى الأسفل (ابن ماجه، وأبو داود عن عمرو بن شعيب عن أبيه عن جده. الطبرانى عن عامر بن ربيعة. عبد الرزاق عن أبى حازم القرظى عن أبيه عن جده)(@)(@@) حديث عمرو بن شعيب عن أبيه عن جده: أخرجه ابن ماجه (2/830، رقم 2482) ، وأبو داود (3/316، رقم 3639) .(@)(@@) حديث عامر بن ربيعة: أخرجه الطبرانى كما فى مجمع الزوائد (4/161) 
ms2815	 وقال الهيثمى: فيه عاصم بن عبيد الله وهو ضعيف.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15239-(@)(@@) قضى فى سيل مهزور الأعلى فوق الأسفل ليسقى الأعلى إلى الكعبين ثم يرسل من هو أسفل منه (ابن ماجه عن محمد بن عقبة بن أبى مالك عن عمه ثعلبة بن أبى مالك القرظى. البغوى، وابن قانع، والطبرانى، والضياء عن أبى مالك بن ثعلبة بن أبى مالك عن أبيه. الحاكم عن عائشة)(@)(@@) حديث محمد بن عقبة بن أبى مالك عن عمه ثعلبة بن أبى مالك القرظى: أخرجه ابن ماجه (2/829، رقم 2481) قال البوصيرى (3/83) : إسناده ضعيف.(@)(@@) حديث أبى مالك بن ثعلبة بن أبى مالك عن أبيه: قال الهيثمى (4/161) : رواه الطبرانى فى الكبير، وفيه عاصم بن عبيد الله، وهو ضعيف.(@)(@@) حديث عائشة: أخرجه الحاكم (2/71، رقم 2362) ، وقال: صحيح على شرط الشيخين.(@)(@@)(@@)(@@) $ 15240-(@)(@@) قضى فى شرب النخل من السيل أن الأعلى فالأعلى يشرب قبل الأسفل ويترك الماء إلى الكعبين ثم يرسل الماء إلى الأسفل الذى يليه فكذلك حتى تنقضى الحوائط (ابن ماجه عن عبادة بن الصامت)(@)(@@) PageV00P000(@)(@@) أخرجه ابن ماجه (2/830، رقم 2483) قال البوصيرى (3/84) : هذا إسناد ضعيف. وأخرجه أيضا: البيهقى (6/154، رقم 11639) .(@)(@@) ومن غريب الحديث: "الحوائط" جمع الحائط وهو البستان.(@)(@@)(@@)(@@) $ 15241-(@)(@@) قضى فى كل شركة لم تقسم ربعة أو حائط لا يحل له أن يبيع حتى يؤذن شريكه فإن شاء أخذ وإن شاء ترك فإذا باع ولم يؤذنه فهو أحق به (مسلم، والنسائى عن جابر)(@)(@@) أخرجه مسلم (3/1229، رقم 1608) ، والنسائى (7/320، رقم 4701) .(@)(@@) ومن غريب الحديث: "ربعة" المنزل. "حائط" البستان.(@)(@@)(@@)(@@) $ 15242-(@)(@@) قضى للجدة بالسدس (الطبرانى عن المغيرة بن شعبة ومحمد بن مسلمة معا)(@)(@@) أخرجه الطبرانى (19/228، رقم 510) .(@)(@@)(@@)(@@) $ 15243-(@)(@@) قطع العرق مسقمة والحجامة خير منه (الديلمى عن عبد الله بن جراد)(@)(@@) أخرجه الديلمى (3/220، رقم 4641) .(@)(@@)(@@)(@@) $ 15244-(@)(@@) قطعت ظهر الرجل (أبو نعيم عن أبى موسى أن النبى - صلى الله عليه وسلم - سمع رجلا يمدح رجلا قال ... فذكره)(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15245-(@)(@@) قفلة كغزوة (أحمد، وأبو داود، والحاكم، والبيهقى فى شعب الإيمان، والسنن الكبرى عن ابن عمرو)(@)(@@) أخرجه أحمد (2/174، رقم 6625) ، وأبو داود (3/5، رقم 2487) ، والحاكم 
ms2816	 (2/83، رقم 2399) ، وقال: صحيح على شرط مسلم. والبيهقى فى شعب الإيمان (4/34، رقم 4275) ، وفى السنن الكبرى (9/28، رقم 17623) . وأخرجه أيضا: ابن الجارود (ص 260، رقم 1039) .(@)(@@)(@@)(@@) $ 15246-(@)(@@) قفوا على مشاعركم هذه فإنكم على إرث من إرث أبيكم إبراهيم (أبو داود، والباوردى عن يزيد بن شيبان عن ابن مربع الأنصارى)(@)(@@) أخرجه أبو داود (2/189، رقم 1919) .(@)(@@)(@@)(@@) $ 15247-(@)(@@) قل إذا أصبحت بسم الله على أهلى ومالى اللهم رضنى بما قضيت لى وعافنى فى ما أبقيت حتى لا أحب تعجيل ما أخرت ولا تأخير ما عجلت (أبو نعيم عن بكر بن عبد الله المزنى قال قلت يا رسول الله إنى رجل محارف لا ينمى لى مال قال ... فذكره)(@)(@@) أخرجه أيضا: الديلمى (5/400، رقم 8551) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15248-(@)(@@) {قل أعوذ برب الفلق} [الفلق: 1] و {قل أعوذ برب الناس} [الناس: 1] ما تعوذ الناس بأفضل منها (النسائى عن معاذ بن عبد الله بن خبيب عن أبيه)(@)(@@) أخرجه النسائى (8/250، رقم 5429) .(@)(@@)(@@)(@@) $ 15249-(@)(@@) قل أعوذ بكلمات الله التامات التى لا يجاوزهن بر ولا فاجر من شر ما ذرأ فى الأرض ومن شر ما يخرج منها ومن شر ما يعرج فى السماء وما ينزل منها ومن شر كل طارق إلا طارقا يطرق بخير يا رحمن (البيهقى، وابن عساكر عن أبى العالية أن خالد بن الوليد قال يا رسول الله إن كائدا من الجن يكيدنى قال ... فذكره)(@)(@@) أخرجه ابن عساكر (16/229) . وأخرجه أيضا: الطبرانى (4/114، رقم 3838) .(@)(@@)(@@)(@@) $ 15250-(@)(@@) قل اللهم إنى أسألك نفسا بك مطمئنة تؤمن بلقائك وترضى بقضائك وتقنع بعطائك (الطبرانى، والضياء عن أبى أمامة)(@)(@@) أخرجه الطبرانى (8/99، رقم 7490) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15251-(@)(@@) قل اللهم إنى أعوذ بك من شر سمعى ومن شر بصرى ومن شر لسانى ومن شر قلبى ومن شر منيى (أحمد، والترمذى - حسن غريب - والنسائى، والطبرانى، والبغوى، وابن قانع، وسمويه، والحاكم، والضياء عن شتير بن شكل عن أبيه وما له غيره)(@)(@@) أخرجه أحمد (3/429، رقم 15580) ، والترمذى (5/523، رقم 3492) ، وقال: حسن غريب. والنسائى(@)(@@) (8/255، رقم 5444) ، والطبرانى (7/310، رقم 7225) ، وابن قانع (1/348) ، والحاكم (1/715، رقم 1953) ، وقال: صحيح الإسناد. وأخرجه أيضا: البخارى فى الأدب المفرد 
ms2817	 (ص 231، رقم 663) ، وأبو داود (2/92، رقم 1551) ، وابن سعد (6/45) .(@)(@@)(@@)(@@) $ 15252-(@)(@@) قل اللهم اجعل سريرتى خيرا من علانيتى واجعل علانيتى صالحة اللهم إنى أسألك من صالح ما تؤتى الناس من المال والأهل والولد غير الضال ولا المضل (الترمذى وضعفه عن عمر)(@)(@@) أخرجه الترمذى (5/573، رقم 3586) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15253-(@)(@@) قل اللهم فاطر السموات والأرض عالم الغيب والشهادة رب كل شىء ومليكه أشهد أن لا إله إلا أنت أعوذ بك من شر نفسى ومن شر الشيطان وشركه قلها إذا أصبحت وإذا أمسيت وإذا أخذت مضجعك (الضياء، وأحمد، وابن أبى شيبة، وأبو داود، والترمذى - حسن صحيح - وابن حبان، وابن السنى، والحاكم عن أبى هريرة)(@)(@@) أخرجه الضياء (1/113، رقم 30) ، وقال: إسناده صحيح. وأحمد (1/9، رقم 51) ، وابن أبى شيبة (5/322، رقم 26523) ، وأبو داود (4/316، رقم 5067) ، والترمذى (5/467، رقم 3392) ، وقال: حسن صحيح. وابن حبان(@)(@@) (3/242، رقم 962) ، والحاكم (1/694، رقم 1892) ، وقال: صحيح الإسناد. وأخرجه أيضا: الطيالسى (ص 4، رقم 9) ، والبخارى فى الأدب المفرد (ص 412، رقم 1202) ، والدارمى (2/378، رقم 2689) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15254-(@)(@@) قل سبحان الله والحمد لله ولا إله إلا الله والله أكبر ولا حول ولا قوة إلا بالله فإنهن الباقيات الصالحات وهن يحططن الخطايا كما تحط الشجرة ورقها وهن من كنوز الجنة (الطبرانى، وابن مردويه عن أبى الدرداء)(@)(@@) قال الهيثمى (10/90) : رواه ابن ماجه باختصار، رواه الطبرانى بإسنادين فى أحدهما عمر بن راشد اليمامى، وقد وثق على ضعفه، وبقية رجاله رجال الصحيح.(@)(@@)(@@)(@@) $ 15255-(@)(@@) قل سبحان الملك القدوس رب الملائكة والروح جللت السموات والأرض بالعزة والجبروت (الطبرانى عن البراء أن رجلا اشتكى الوحشة قال فذكره)(@)(@@) أخرجه الطبرانى (2/24، رقم 1171) قال الهيثمى (10/128) : فيه محمد بن أبان الجعفى، وهو ضعيف.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15256-(@)(@@) {قل هو الله أحد} [الاخلاص: 1] تعدل ثلث القرآن (ابن ماجه، والطبرانى فى الأوسط، والضياء عن أنس بن مالك. أحمد، والبخارى، وأبو داود، والنسائى، وابن حبان عن أبى سعيد. البخارى عن أبى سعيد عن أخيه قتادة بن النعمان. مسلم عن أبى الدرداء. النسائى، والطبرانى، والبيهقى فى شعب الإيمان عن أبى أيوب. الترمذى - صحيح - وابن ماجه عن أبى هريرة. الطبرانى عن 
ms2818	 ابن مسعود. أحمد، وابن ماجه عن أبى مسعود الأنصارى. الطبرانى عن معاذ. أحمد، والطبرانى، والبيهقى فى شعب الإيمان عن أم كلثوم بنت عقبة بن أبى معيط)(@)(@@) حديث أنس: أخرجه ابن ماجه (2/1244، رقم 3788) ، والطبرانى فى الأوسط (6/39، رقم 5730) ، والضياء(@)(@@) (7/60، رقم 2465) ، وقال: إسناده صحيح.(@)(@@) حديث أبى سعيد: أخرجه أحمد (3/23، رقم 11197) ، والبخارى (6/2449، رقم 6267) ، وأبو داود (2/72، رقم 1461) ، والنسائى (2/171، رقم 995) ، وابن حبان (3/71، رقم 791) .(@)(@@) PageV00P000(@)(@@) حديث أبى سعيد عن أخيه قتادة بن النعمان وهو أخيه لأمه: أخرجه البخارى (4/1915، رقم 4726) .(@)(@@) حديث أبى الدرداء: أخرجه مسلم (1/556، رقم 811) .(@)(@@) حديث أبى أيوب: أخرجه النسائى فى الكبرى (6/174، رقم 10523) ، والطبرانى (4/166، رقم 4024) ، والبيهقى فى شعب الإيمان (2/506، رقم 2544) .(@)(@@) حديث أبى هريرة: أخرجه الترمذى (5/168، رقم 2899) ، وقال: حسن صحيح. وابن ماجه (2/1244، رقم 3787) .(@)(@@) حديث عبد الله بن مسعود: أخرجه الطبرانى (10/140، رقم 10245) .(@)(@@) حديث أبى مسعود: أخرجه أحمد (4/122، رقم 17147) ، وابن ماجه (2/1245، رقم 3789) .(@)(@@) حديث معاذ: أخرجه الطبرانى (20/112، رقم 223) .(@)(@@) حديث أم كلثوم: أخرجه أحمد (6/403، رقم 27315) ، والطبرانى (25/74، رقم 182) ، والبيهقى فى شعب الإيمان (2/507، رقم 2545) . وأخرجه أيضا: أبو يعلى (2/295، رقم 1017) ، والبزار (5/251، رقم 1866) .(@)(@@) PageV15P180(@)(@@)(@@)(@@) $ 15257-(@)(@@) {قل هو الله أحد} [الاخلاص: 1] تعدل ثلث القرآن و {قل يا أيها الكافرون} [الكافرون: 1] تعدل ربع القرآن (الطبرانى، والحاكم عن ابن عمر)(@)(@@) أخرجه الطبرانى (12/405، رقم 13493) ، والحاكم (1/754، رقم 2078) ، وقال: صحيح.(@)(@@)(@@)(@@) $ 15258-(@)(@@) {قل هو الله أحد} [الاخلاص: 1] نسبة الله (الديلمى عن أبى هريرة)(@)(@@) أخرجه الديلمى (3/216، رقم 4622) .(@)(@@)(@@)(@@) $ 15259-(@)(@@) {قل هو الله أحد} [الاخلاص: 1] والمعوذتين حين تمسى وحين تصبح ثلاث مرات تكفيك من كل شىء (ابن سعد، وعبد بن حميد، وأبو داود، والترمذى - حسن صحيح غريب - والنسائى، وعبد الله بن أحمد فى زوائده على المسند، والطبرانى، وابن السنى، والضياء عن معاذ بن عبد الله بن خبيب عن أبيه)(@)(@@) أخرجه ابن سعد (4/351) ، وعبد بن حميد (ص 178، رقم 494) ، وأبو داود (4/321، رقم 5082) ، والترمذى (5/567، رقم 3575) ، وقال: حسن صحيح غريب. والضياء (9/287، رقم 249) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15260-(@)(@@) {قل يا أيها الكافرون} [الكافرون: 1] تعدل ربع القرآن و {إذا زلزلت} [الزلزلة: 
ms2819	 1] تعدل ربع القرآن و {إذا جاء نصر الله والفتح} [النصر: 1] تعدل ربع القرآن (البيهقى فى شعب الإيمان عن أنس)(@)(@@) أخرجه البيهقى فى شعب الإيمان (2/501، رقم 2530) .(@)(@@)(@@)(@@) $ 15261-(@)(@@) قلب ابن آدم مثل العصفور يتقلب فى اليوم سبع مرات (البيهقى فى شعب الإيمان عن أبى عبيدة بن الجراح)(@)(@@) أخرجه البيهقى فى شعب الإيمان (1/474، رقم 754) . وأخرجه أيضا: الحاكم (4/342، رقم 7850) ، وقال: صحيح على شرط مسلم. والديلمى (3/207، رقم 4586) ، وأبو نعيم فى الحلية (5/216) .(@)(@@)(@@)(@@) $ 15262-(@)(@@) قلب الشيخ شاب على حب اثنتين حب العيش والمال (مسلم، وأبو داود عن أبى هريرة)(@)(@@) أخرجه مسلم (2/724، رقم 1046) ، وابن ماجه (2/1415، رقم 4233) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15263-(@)(@@) قلب الشيخ شاب على حب اثنتين طول الحياة وكثرة المال (أحمد، والترمذى - حسن صحيح - والحاكم عن أبى هريرة. ابن عدى، وابن عساكر عن أنس قال ابن عدى: مشهور)(@)(@@) حديث أبى هريرة: أخرجه أحمد (2/358، رقم 8684) ، والترمذى (4/570، رقم 2338) ، وقال: حسن صحيح. وأخرجه أيضا: الحميدى (2/459، رقم 1069) ، وابن ماجه (2/1415، رقم 4233) ، والبيهقى (3/368، رقم(@)(@@) 6299) .(@)(@@) حديث أنس: أخرجه ابن عدى (3/374) ، وابن عساكر (53/118)(@)(@@)(@@)(@@) $ 15264-(@)(@@) قلب الشيخ شاب فى حب اثنتين طول الأمل وحب المال (ابن عساكر عن أبى هريرة)(@)(@@) أخرجه ابن عساكر (52/406) .(@)(@@)(@@)(@@) $ 15265-(@)(@@) قلب المؤمن حلو يحب الحلاوة (البيهقى فى شعب الإيمان عن أبى أمامة وقال: منكر وفى إسناده من هو مجهول، والخطيب عن أبى موسى وقال: موضوع)(@)(@@) حديث أبى أمامة: أخرجه البيهقى فى شعب الإيمان (5/99، رقم 5934) ، وقال: متن الحديث منكر، وفى إسناده من هو مجهول.(@)(@@) PageV00P000(@)(@@) حديث أبى موسى: أخرجه الخطيب (3/113) . وأخرجه أيضا: الديلمى (3/208، رقم 4589) .(@)(@@)(@@)(@@) $ 15266-(@)(@@) قلب ليس فيه شىء من الحكمة كبيت خرب فتعلموا وعلموا وتفقهوا ولا تموتوا جهالا فإن الله لا يعذر على الجهل (ابن السنى عن ابن عمر)(@)(@@) أخرجه أيضا: الديلمى (3/208، رقم 4590) .(@)(@@)(@@)(@@) $ 15267-(@)(@@) قلة الحياء كفر (الحكيم، والشيرازى فى الألقاب عن عقبة بن عامر)(@)(@@) ذكره الحكيم (4/48) ، وقال: وروى عن رسول الله - صلى الله عليه وسلم - ثم ذكره.(@)(@@)(@@)(@@) $ 15268-(@)(@@) قلة العيال أحد اليسارين (القضاعى عن على. الديلمى عن بكر بن عبد الله المزنى عن أبيه 
ms2820	 بسندين ضعيفين. [القضاعى عن معاذ] )(@)(@@) حديث عبد الله المزنى: أخرجه الديلمى (3/90، رقم 4254) .(@)(@@) حديث معاذ: أخرجه القضاعى (1/53، رقم 31) .(@)(@@) وللحديث أطراف أخرى منها: "التدبير نصف العيش".(@)(@@)(@@)(@@) $ 15269-(@)(@@) قلت لجبريل ليلة أسرى بى إن قومى لا يصدقونى فقال يصدقك أبو بكر وهو الصديق (ابن سعد عن أبى وهب مولى أبى هريرة)(@)(@@) PageV00P000(@)(@@) أخرجه أيضا: الطبرانى فى الأوسط (7/166، رقم 7173) قال الهيثمى (9/41) : فيه أبو وهب عن أبى هريرة، ولم أعرفه، وبقية رجاله ثقات.(@)(@@)(@@)(@@) $ 15270-(@)(@@) قلت لجبريل يا جبريل ما لى لا أرى إسرافيل يضحك ولم يأتنى أحد من الملائكة إلا رأيته يضحك قال جبريل ما رأينا ذلك الملك ضاحكا منذ خلقت النار (البيهقى فى شعب الإيمان عن المطلب)(@)(@@) أخرجه البيهقى فى شعب الإيمان (1/521، رقم 913) .(@)(@@)(@@)(@@) $ 15271-(@)(@@) قلت يا جبريل هل ترى ربك قال إن بينى وبينه سبعين ألف حجاب من نور أو نار لو رأيت أدناها لاحترقت (سمويه عن أنس)(@)(@@) أخرجه أيضا: الطبرانى فى الأوسط (6/278، رقم 6407) ، والديلمى (2/312، رقم 3411) . قال الهيثمى(@)(@@) (1/79) : فيه قائد الأعمش قال أبو داود: عنده أحاديث موضوعة، وذكره ابن حبان فى الثقات وقال: يهم.(@)(@@)(@@)(@@) $ 15272-(@)(@@) قلت يا رب شفعنى فيمن قال لا إله إلا الله قال ذاك إلى (الديلمى عن أنس)(@)(@@) أخرجه الديلمى (3/225، رقم 4660) .(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 15273-(@)(@@) قلما أنعم الله على قوم نعمة إلا أصبح كثير منهم بها كافرين (الطبرانى عن أبى الدرداء)(@)(@@) قال الهيثمى (2/212) : رواه البزار، والطبرانى فى الكبير، وفيه إسماعيل بن عياش، وفيه كلام.(@)(@@)(@@)(@@) $ 15274-(@)(@@) قلما يوجد فى آخر أمتى درهم من حلال أو أخ يوثق به (ابن عساكر عن ابن عمر)(@)(@@) أخرجه ابن عساكر (48/229) .(@)(@@)(@@)(@@) $ 15275-(@)(@@) قلن مثل ما يقول يعنى المؤذن فإن لكن بكل حرف ألف حسنة قال عمر يا رسول الله هذا للنساء فما للرجال قال لهم الضعف يا ابن الخطاب (الخطيب عن عمر)(@)(@@) أخرجه ابن الجوزى فى العلل المتناهية (1/392، رقم 660) ، وقال: حديث لا يصح.(@)(@@)(@@)(@@) $ 15276-(@)(@@) قلوب لاهية وأيد عاملة وألسنة لاغية (ابن أبى الدنيا فى ذم الملاهى، والبيهقى عن يحيى بن أبى كثير قال مر رسول الله - صلى 