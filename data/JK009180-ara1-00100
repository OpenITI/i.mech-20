ms81	 اذكروا نعمت الله ) ^ | بالتاء ( آ 33 ) ^ ( ولؤلؤ ) ^ بغير ألف ، ( آ 43 ) ^ ( سنت الله في الذين ) ^ بالتاء ، | ( آ 43 ) ^ ( ولن تجد لسنت الله ) ^ بالتاء . ومن سورة يس ( يس : 61 ) | ^ ( وأن اعبدون ) ^ بلا ياء ، ( آ 60 ) ^ ( أن لا تعبدوا الشيطان ) ^ بإثبات | النون . ومن سورة الصافات ( الصافات : 11 ) ^ ( أم من خلقنا ) ^ مقطوع ، | ( آ 36 ) ^ ( ائنا لتاركوا آلهتنا ) ^ بالياء والنون ، ( آ 106 ) ^ ( إن هذا لهو البلؤ | المبين ) ^ بالواو ، ( آ 57 ) ^ ( ولولا نعمت ربي ) ^ بالتاء . ومن سورة ص | ( س 38 آ 3 ) ^ ( ولات حين مناص ) ^ مقطوع ، ( آ 13 ) ^ ( لئيكة ) ^ بغير | ألف ، ( آ 46 ) ^ ( ذكرى الدار ) ^ بالياء ، ( آ 9 ) ^ ( أم عندهم خزائن | رحمت ربك ) ^ بالتاء ، ( آ 6 ) ^ ( وانطلق الملأ منهم ) ^ بغير واو وبغير | ألف ، ( آ 39 ) ^ ( هذا عطاؤنا ) ^ بالواو . ومن سورة الزمر ( الزمر : 53 ) | ^ ( لا تقنطوا من رحمة الله ) ^ يعني بالهاء ، ( آ 57 ) ^ ( ولولا أن الله | هدايني ) بالياء . ومن سورة المؤمن ( فاطر : 73 ) ^ ( أين ما كنتم ) ^ | مقطوع ، ( آ 85 ) ^ ( سنت الله التي قد خلت ) ^ بالتاء ، وكذلك ( آ 6 ) | ^ ( حقت كلمت ربك ) ^ بالتاء ( آ 16 ) ^ ( يوم هم بارزون ) ^ مقطوع ، ( آ 9 ) | ^ ( ومن تقى السيئات ) بياء واحدة ، ( آ 18 ) ^ ( لدى الحناجر ) ^ بالياء ، | ( آ 38 ) ^ ( يا قوم اتبعون ) ^ يعني بغير ياء . ومن سورة حم السجدة | ( السجدة : 40 ) ^ ( أم من يأتي آمنا ) ^ مقطوعة ، ( آ 47 ) ^ ( وما تخرج | من ثمرات ) ^ بتاء . ومن سورة عسق ( الشورى : 34 ) ^ ( ويعف عن | كثير ) ^ يعني بغير واو ، ( آ 24 ) ^ ( ويمح الله الباطل ) ^ بغير واو ، ( آ 30 ) | ^ ( فبما كسبت أيديكم ويعفوا عن كثير ) ^ بالواو والألف ، ( آ 51 ) ^ ( أو | من وراءي حجاب ) ^ بالياء ، ليس في القرآن غيرها ، ومن سورة PageV01P266 | الزخرف ( الزخرف : 37 ) ^ ( أهم يقسمون رحمة ربك ) ^ بالتاء ، | ^ ( ورحمت ربك خير مما يجمعون ) ^ بالتاء ، ( آ 13 ) ^ ( ثم تذكروا نعمة | ربكم ) ^ بالهاء ، ( آ 49 ) ^ ( أية الساحر ) ^ بغير ألف ( آ 19 ) ^ ( وجعلوا | الملائكة الذين هم عبد الرحمن ) ^ بغير ألف . ومن سورة الدخان | ( س 44 آ 33 ) ^ ( ما فيه بلؤا ^ يعني بواو وألف ، ( آ 43 ) ^ ( إن شجرة | الزقوم ) ^ بالتاء . ومن سورة الجاثية 
ms82	 ( الجاثية : 28 ) ^ ( كل أمت تدعى ) ^ | بالتاء . ومن سورة الفتح ( ق : 29 ) ^ ( سيماهم ) ^ بالألف . من سورة | ق ( س 50 آ 14 ) ^ ( الأيكة ) ^ بالألف ، ( آ 19 ) ^ ( وجاءت سكرة الموت ) ^ | يعني بهاء ومن سورة الذاريات ( الذاريات : 47 ) ^ ( والسماء بنيناها | بأييد ) ^ بيائين . ومن سورة الطور ( الطور : 29 ) ^ ( فما أنت بنعمت | ربك ) ^ بالتاء ومن سورةالنجم ( النجم : 51 ) ^ ( وثمودا فما أبقى ) ^ | بالألف ، ( آ 11 ) ^ ( ما كذب الفؤاد ما رأى ) ^ بالياء والألف ، ( آ 18 ) | ^ ( لقد رأى من آيات ربه الكبرى ) ^ يعني بالياء ، ليس في القرآن غيره | إلا هذين الحرفين ، ( آ 29 ) ^ ( فأعرض عمن ) ^ موصول ، ( آ 20 ) | ^ ( ومنوة الثالثة ) ^ بالواو ، ( آ 57 ) ^ ( أزفت الآزفت ) ^ بالتاء . ومن سورة | القمر ( القمر : 5 ) ^ ( فما تغن النذر ) ^ بغير ياء ، ( آ 6 ) ^ ( يوم يدع الداع ) ^ | بغير ياء ، ( آ 8 ) ^ ( إلى الداع ) ^ بغير ياء ، ومن سورة الرحمن تعالى | ( الرحمن : 31 ) ^ ( أية الثقلان ) ^ بغير ألف . ومن سورة الواقعة | ( الواقعة : 61 ) ^ ( في مالا تعلمون ) ^ مقطوعة ، ( آ 89 ) ^ ( وجنت نعيم ) ^ | بالتاء . ومن سورة الحديد ( الحديد : 4 ) ^ ( أين ما كنتم ) ^ مقطوعة . | ومن سورة المجادلة ( المجادلة : 8 ) ^ ( ومعصيت الرسول ) ^ بالتاء . ومن | سورة الحشر ^ ( لكي لا ) ^ مقطوعة ، ( الحشر : 9 ) ^ ( والذين تبوءو ) ^ | PageV01P267 | بواوين بغير ألف ، ( آ 7 ) ^ ( كي لا يكون دولة ) ^ مقطوعة . ومن سورة | الممتحنة ( الممتحنة : 4 ) ^ ( إنا برءاؤا منكم ) ^ بواو ، ( آ 12 ) ^ ( على أن لا | يشركن ) ^ بإثبات النون يعني في ^ ( إن ) ^ : ومن سورة الصف | ( الصف : 7 ) ^ ( وهو يدعى ) ^ بالياء . ومن سورة المنافقين ( المنافقين : 10 ) | ^ ( وانفقوا من ما رزقناكم ) ^ مقطوع ، ومن سورة التحريم ( التحريم : 10 ) | ^ ( امرأت نوح ) ^ بالتاء ، ^ ( وامرأت لوط ) ^ بالتاء ، ( آ 11 ) ^ ( امرأت | فرعون ) ^ بالتاء . ومن سورة نون ( القلم : 6 ) ^ ( بابيكم المفتون ) ^ بيائين ، | ( آ 24 ) ^ ( أن لا يدخلنها اليوم ) ^ بإثبات النون . ومن سورة الحاقة | ( الحاقة : 11 ) ^ ( طغا الماء ) ^ بالألف . ومن سورة سأل سائل ( المعارج : | 34 ) ^ ( على صلاتهم ) ^ بالألف . ومن سورة الجن ( الجن : 5 ) ^ ( ظننا ) ^ | بنونين . ومن سورة القيامة ( القيامة : 3 ) ^ ( أن لن نجمع ) ^ مقطوع ، | ومن سورة هل أتى على الإنسان ( الإنسان : 15 ) ^ ( قواريرا ) بألفين ، ( آ 41 ) | ^ ( سلاسلا ) ^ بالألف . ومن سورة 
ms83	 النازعات ( النازعات : 20 ) ^ ( فأريه | الآية الكبرى ) ^ بالياء . ومن سورة النازعات المطففين ( س 83 آ 18 و 19 ) ^ ( لفي | علين وما أدراك ما عليون ) ^ بياء واحدة . ومن سورة إذا السماء | انشقت ( س 84 آ 14 ) ^ ( ألن يحور ) ^ بغير نون . ومن سورة الشمس | وضحاها ( س 91 آ 13 ) ^ ( ناقة الله ) ^ بالهاء ومن سورة لأيلف | ( س 106 آ 2 ) ^ ( إلفهم ) ^ بغير ياء وألف . من سورة أرأيت ( س 107 آ 5 ) | ^ ( عن صلاتهم ) ^ بغير الواو .(@)(@@) [ أن لا ] عشرة مواضع في القرآن بالنون ، في الأعراف | ( س 7 آ 105 ) ^ ( حقيق على أن لا أقول ) ^ و ( آ 169 ) ^ ( أن لا يقولوا | على الله إلا الحق ) ^ وفي التوبة ( س 9 آ 118 ) ^ ( أن لا ملجأ من الله ) ^ | PageV01P268 | وفي هود ( س 11 آ 26 ) ^ ( أن لا تعبدوا إلا الله ) ^ ، ( آ 14 ) ^ ( وأن لا إله | إلا هو فهل أنتم مسلمون ) ^ وفي الحج ( س 22 آ 26 ) ^ ( أن لا تشرك بي | شيئا ) ^ ، وفي الدخان ( س 44 آ 19 ) ^ ( وأن لا تعلوا على الله ) ^ ، وفي | يس ( يس 36 آ 60 ) ^ ( أن لا تعبدوا الشيطان ) ^ ، وفي الممتحنة ( س 60 | آ 12 ) ^ ( على أن لا يشركن ) ، وفي سورة نون ( س 68 آ 24 ) ^ ( أن لا | يدخلنها اليوم ) ^ . | PageV01P269 |(@)(@@) | ما كتب في المصاحف على غير الخط(@)(@@) [ 345 ] قال ابن أبي داود ولم يذكر محمد بن عيسى حروفا من | خطوط المصاحف كتبت على غير الخط ، منها إبراهيم كتبوه في | القرآن كله ه ي ميم وكتبوه في سورة البقرة ^ ( إبرهم ) ^ ليس فيها ياء ، | وكتبوه ( س 10 آ 22 ) ^ ( لئن نجيتنا ) ^ موصولة بغير ألف ، وكتبوا في | المؤمن ( س 40 آ 22 ) ^ ( من واقي ) ^ بالياء ، وكتبوا في المصاحف | ( س 11 آ 87 ) ^ ( نشؤا ) ^ مكان ^ ( نشاء ) ^ وقد كتبوها أيضا في بعض | السور بالألف ، وكتبوا ( س 17 آ 7 ) ^ ( ليسؤا ) ^ بواو واحدة ، وكتبوا | ( س 60 آ 4 ) ^ ( برءاؤا منكم ) ^ بواو واحدة وبألف واحدة ، وكتبوا ( س 2 | آ 61 ، س 3 آ 112 ) ^ ( باءو ) ^ بواو واحدة ، وكتبوا ( س 3 آ 184 ) وغيره 
ms84	 | ^ ( جاءو ) ^ بواو واحدة ، وكتبوا ( س 81 آ 8 ) ^ ( المؤدة ) ^ بواو واحدة ، | وكتبوا ( س 2 آ 166 ) وغيره ^ ( ورأوا العذاب ) ^ بغير ألف في آخرها ، | وكتبوا ^ ( وإذا الرسل أقتت ) ^ بألف بغير واو . | PageV01P270 |(@)(@@) [ 346 ] قال أبو حاتم السجستاني قد كتب في القرآن حروف | على غير هجاء مثل ^ ( العلماء ) ^ ، ومثل ^ ( برءؤا ) ^ لأن نظير العلماء : | العلماء ونظير البروا البراع . قال أبو حاتم ومما يكتب في المصحف | على غير القياس في الهجاء ^ ( نشاء ) ^ كتب بعضها ، وفي هود ( هود : | 8 ) ^ ( ونشؤا ) ^ [ قال أبو بكر الهجاء في الخط هو الهجاه بالهاء من أن | يهجا الرجل في الشعر فهو بلا هاء ] . |(@)(@@) [ 347 ] وقال يحيى بن حكيم حدثنا يحيى بن حماد قال حدثنا | عبد العزيز بن المختار عن عبد الله بن فيروز قال حدثني يزيد الفارسي | قال زاد عبيد الله بن زياد في المصحف ألفي حرف فلما قدم الحجاج | ابن يوسف بلغه ذلك فقال من ولي ذلك لعبيد الله ؟ قالوا ولي ذاك له | يزيد الفارسي ، فأرسل إلي فانطلقت إليه وأنا لا أشك أن سيقتلني | فلما دخلت عليه قال ما بال ابن زياد زاد في المصحف ألفي حرف ؟ | قال قلت أصلح الله الأمير أنه ولد بكلاء البصرة فتوالت تلك عني ، | قال صدقت فخلا عني ، وكان الذي زاد عبيد الله في المصحف كان | مكانه في المصحف ^ ( قالوا ) ^ قاف لام و ^ ( كانوا ) ^ كاف نون واو فجعلها | عبيد الله ' قالوا ' قاف ألف لآم واو ألف وجعل ' كانوا ' كاف ألف نون واو ألف | PageV01P271 |(@)(@@) | ما غير الحجاج في مصحف عثمان(@)(@@) [ 348 ] قال أبو بكر كان في كتاب أبي حدثنا رجل فسألت أبي | من هو ؟ فقال حدثنا عباد بن صهيب عن عوف بن أبي جميلة أن | الحجاج بن يوسف غير في مصحف عثمان أحد عشر حرفا ، قال | كانت في البقرة ( س 2 آ 159 ) ^ ( لم يتسن وانظر ) ^ فغيرها ^ ( لم يتسنه ) ^ | بالهاء ، كانت في المائدة ( س 5 آ 48 ) ^ ( شريعة ومنهاجا ) ^ فغيره | ^ ( شرعة ومنهاجا ) ^ وكانت في يونس ( س 10 آ 22 ) وهو الذي ينشر | كم ) ^ فغيره ^ ( يسيركم ) ^ ، وكانت 
ms85	 في يوسف ( س 12 آ 45 ) ^ ( أنا آتيكم | بتأويله ) ^ فغيرها ^ ( أنا أنبئكم بتأويله ) ^ ، وكانت في المؤمنين ( س 23 | آ 85 - 89 ) ^ ( سيقولون لله ) لله لله ثلاثتهن فجعل الأخريين ^ ( الله الله ) ^ | وكان في الشعراء في قصة نوح ( س 26 آ 116 ) ^ ( من المخرجين ) ^ ، | وفي قصة لوط ( آ 167 ) ^ ( من المرجومين ) ^ فغير قصة نوح ^ ( من | المرجومين ) ^ وقصة لوط ^ ( من المخرجين ) ^ ، وكانت في الزخرف | ( س 43 آ 32 ) ^ ( نحن قسمنا بينهم معائشهم ) ^ فغيرها ^ ( معيشتهم ) ^ ، | وكانت الذين كفروا ( س 47 آ 15 ) ^ ( من ماء غير يسن ) ^ فغيرها ^ ( من | ماء غير آسن ) ^ ، وكانت في الحديد ( س 57 آ 7 ) ^ ( فالذين آمنوا منكم | PageV01P272 | واتقوا لهم أجر كبير ) ^ فغيرها ^ ( منكم وأنفقوا ) ^ ، وكانت في إذا | الشمس كورت ( س 81 آ 24 ) ^ ( وما هو على الغيب بظنين ) ^ فغيرها | ^ ( بضنين ) ^ . | PageV01P273 |(@)(@@) | باب | تجزئة المصاحف(@)(@@) [ 349 ] حدثنا عبد الله حدثنا محمود بن آدم المروزي حدثنا بشر | ابن السري حدثنا محمد بن مسلم عن إبراهيم بن ميسرة عن عثمان بن | عبد الله بن أوس عن المغيرة ابن شعبة قال استأذن رجل على رسول | الله [ $ ] وهو بين مكة والمدينة فقال إنه قد فاتني الليلة جزئي من | القرآن فإني لا أوثر عليه شيئا . |(@)(@@) [ 350 ] حدثنا عبد الله حدثنا يعقوب بن سفيان حدثنا ابن أبي | مريم قال أخبرنا يحيى بن أيوب قال حدثني ابن الهاد قال سألني نافع | PageV01P274 | ابن جبير فقال في كم تقرأ القرآن ؟ فقلت ما أحزبه فقال نافع لا | تقل ما أحزبه فإن رسول الله [ $ ] كان يقول قرأت جزءا من القرآن ، | قال حسبت أنه ذكره عن المغيرة بن شعبة . |(@)(@@) [ 351 ] حدثنا عبد الله حدثنا محمد بن عبد الملك الدقيقي حدثنا | يزيد بن هارون حدثنا همام حدثنا قتادة قال اسباع القرآن ، السبع | الأول في النساء ( س 4 آ 76 ) ^ ( إن كيد الشيطان كان ضعيفا ) ^ والثاني في | الأنفال ( س 8 آ 36 ) ^ ( والذين كفروا إلى جهنم يحشرون ) ^ ، والثالث | في الحجر ( س 15 آ 49 ) ^ ( نبيء عبادي أني أنا الغفور الرحيم ) ^ والرابع | خاتمة المؤمنين ( س 33 آ 
ms86	 118 ) ، والخامس خاتمة سبأ ( س 34 آ 54 ) ، | والسادس خاتمة الحجرات ( س 49 آ 18 ) والسابع ما بقي من القرآن . |(@)(@@) [ 352 ] حدثنا عبد الله حدثنا هارون بن سليمان حدثنا عبد الله | ابن بكر حدثنا سعيد بن أبي عروبة أن قتادة قال سبع القرآن ، فأما | أول سبع ( س 4 آ 76 ) ^ ( فقاتلوا أولياء الشيطان إن كيد الشيطان كان | ضعيفا ) ^ والسبع الثاني في الأنفال ( س 8 آ 74 ) ^ ( والذين آووا ونصروا ) ^ | والثالث في النحل ( س 16 آ 41 ) ^ ( والذين هاجروا في الله من بعد ما | ظلموا لنبوءهم في الدنيا حسنة ) ^ إلى آخر الآية ، والرابع في أربع . | PageV01P275 | آيات يعني من الحج ، أولهن ( س 22 آ 52 ) ^ ( وما أرسلنا من قبلك من | رسول ولا نبي إلا إذا تمنى ألقي الشيطان ) ^ إلى ( 55 آ ) ^ ( عذاب يوم | عقيم ) ^ ، وسقط هارون على آخر الحديث . |(@)(@@) [ 353 ] حدثنا عبد الله حدثنا هارون بن سليمان ويحيى بن حكيم | قالا حدثنا عبد الله بن بكر السهمي حدثنا عمرو بن منخل السدوسي | عن مطهر بن خالد الربعي عن سالم [ وقال يحيى سلام ] أبي محمد | الحماني [ قال أبو بكر بن أبي داود ليس هو سالم ولا سلام إنما هو | راشد أبو محمد الحماني ] ، قال جمع الحجاج بن يوسف الحفاظ | والقراء ، قال فكنت فيهم ، فقال أخبروني عن القرآن كله كم هو من | حرف ؟ قال فجعلنا نحسب حتى أجمعوا أن القرآن كله ثلاثمائة ألف | حرف وأربعين ألف وسبع مائة ونيف وأربعين حرفا . قال فأخبروني | إلى أي حرف ينتهي نصف القرآن ، فحسبوا فأجمعوا أنه ينتهي في | الكهف ( س 18 آ 19 ) ^ ( وليتلطف ) ^ في الفاء ، قال فأخبروني بأسباعه | على الحروف ، [ قال يحيى على عدد الحروف ] قال فإذا أول سبع في | النساء ( س 4 آ 55 ) ^ ( فمنهم من آمن به ومنهم من صد ) ^ في الدال ، | والسبع الثاني في الأعراف ( س 7 آ 147 ) ^ ( أولئك حبطت ) ^ في التاء ، | PageV01P276 | والسبع الثالث في الرعد ( س 13 آ 35 ) ^ ( أكلها دائم ) ^ في الألف آخر | أكلها ، والسبع الرابع في الحج ( س 22 آ 
ms87	 34 ) ^ ( لكل أمة جعلنا | منسكا ) في الألف ، والسبع الخامس في الأحزاب ( س 33 آ 36 ) | ^ ( وما كان لمؤمن ولا مؤمنة ) ^ في الهاء ، والسبع السادس في الفتح | ( س 48 آ 6 ) ^ ( الظانين بالله ظن السوء ) ^ في الواو ، والسابع ما بقي | من القرآن . قال فأخبروني بأثلاثة ، قالوا الثلث الأول رأس مائة آية | من براءة 0 ( س 9 آ 100 ) ، والثلث الثاني رأس إحدى ومائة من طسم | الشعراء ( س 26 آ 101 ) ، والثلث الثالث ما بقي من القرآن . |(@)(@@) [ 354 ] قال عمرو وحدثني يزيد بن علوان عن المجاشعي [ قال | يحيى توبة بن علوان عن المجاشعي ] ، قال وكان من قراء الناس عن | أبي محمد الحماني قال وسألنا عن أرباعه فإذا أول ربع خاتمة سورة | الأنعام ( س 6 آ 165 ) ، والربع الثاني الكهف ^ ( وليتلطف ) ^ ( س 18 | آ 19 ) ، والربع الثالث خاتمة الزمر ( س 39 آ 75 ) ، والرابع ما بقي من | القرآن |(@)(@@) [ 355 ] قال وقال مطهر بن خالد عن أبي محمد الحماني قال | علمناه في أربعة أشهر وكان الحجاج يقرأه في كل ليلة . [ قال ابن أبي | داود حدثنا هذا الحديث هارون بن سليمان حدثنا عبد الله بن زكرياء | قال أبو بكر وهو في كتابي عن يحيى بن حكيم ، عن عبد الله ، | وأشك في سمعتي هذا من يحيى ، فأما من هارون فلا شك فيه ] . | PageV01P277 |(@)(@@) [ 356 ] حدثنا عبد الله حدثنا محمد بن عامر بن إبراهيم عن أبيه | عن الفيض بن موسى حدثنا عبد الواحد العطار عن هلال الوراق | وعاصم الجحدري أنهما قالا نصف القرآن خاتمة الكهف ( س 18 | آ 110 ) وخاتمة ^ ( قل أعوذ برب الناس ) ^ وثلث القرآن خاتمة براءة | ( س 9 آ 129 ) وخاتمة طسم القصص ( س 28 آ 88 ) وآخر القرآن . وربع | القرآن خاتمة الأنعام ( س 6 آ 165 ) ، وخاتمة الكهف ( س 18 آ 110 ) ، | وخاتمة يس ( س 36 آ 83 ) ، وآخر القرآن . |(@)(@@) [ 357 ] حدثنا عبد الله حدثنا محمد بن عامر بن إبراهيم عن أبيه | عن الفيض بن موسى حدثنا عبد الواحد العطار عن هلال الوراق | وعاصم الجحدري 
ms88	 أنهما قالا وخمس القرآن خاتمة المائدة ( س 5 | آ 120 ) ، وخاتمة يوسف ( س 12 آ 111 ) ، وخاتمه الفرقان ( س 25 آ 77 ) | وخاتمة حم السجدة ( س 41 آ 54 ) ، وآخر القرآن . وسدس القرآن | خاتمة الكهف ( س 18 آ 110 ) ، وخاتمة طسم القصص ( س 28 آ 88 ) ، | وخاتمة الدخان ( س 44 : 59 ) ، وآخر القرآن - وسبع القرآن | ^ ( يصدون عنك صدودا ) ^ في النساء ( النساء : 61 ) ، وفي سورة الأعراف | ( س 7 آ 170 ) ^ ( إنا لا نضيع أجر المصلحين ) ^ ، وفي سورة إبراهيم | ( س 14 آ 25 ) ^ ( لعلهم يتذكرون ) ^ وفي المؤمنين ( س 23 آ 55 ) | ^ ( أيحسبون أنما نمدهم به من مال وبنين ) ^ وفي سبأ ( س 34 آ 20 ) | PageV01P278 | ^ ( فاتبعوه إلا فريقا من المؤمنين ) ^ ، وخاتمة الفتح ( س 48 آ 29 ) ، وآخر | القرآن . وثمن القرآن البقرة وآل عمران ( س 3 ) ، وخاتمة الأنعام | ( س 6 ) ، وخاتمة هود ( س 11 ) ، وخاتمة الكهف ( س 18 ) ، وخاتمة | الشعراء ( س 26 ) ، وخاتمة يس ( س 36 ) ، وخاتمة الذاريات ( س 51 ) | وآخر القرآن ، ولم يحفظ التسع ، وعشر القرآن البقرة ومائة من | آل عمران ( س 3 آ 100 ) ، وخاتمة المائدة ( س 5 ) ، وخاتمة الأنفال ( س 8 ) | وخاتمة يوسف ( س 12 ) ، وخاتمة الكهف ( س 18 ) ، وخاتمة الفرقان | ( س 25 ) وخاتمة الأحزاب ( س 33 ) ، وخاتمة حم السجدة ( س 41 ) ، | وخاتمة الواقعة ( س 56 ) ، وآخر القرآن . وفي قولهم القرآن كله ستة | آلاف آية ومائتان وأربع آيات وهو مائة وأربعة عشر سورة مع فاتحة | الكتاب . | PageV01P279 |(@)(@@) | باب | وأنتم تتلون الكتاب أفلا تعقلون(@)(@@) [ 358 ] حدثنا عبد الله ثنا محمد بن يحيى ثنا مسلم بن إبراهيم | ثنا صدقة ، قال وحدثنا الحسن بن أبي جعفر ، عن مالك بن دينار ، | عن ثمامة بن عبد الله بن أنس ، عن أنس ، قال قال رسول الله [ $ ] | ' أتيت ليلة أسري بي على قوم تقرض شفاههم بمقاريض من نار ، | كلما قرضت رجعت قال : قلت : من هؤلاء ؟ قال هؤلاء خطباء | أمتك ، الذين يقولون ما لا يفعلون ، وهم يتلون الكتاب أفلا يعقلون . |(@)(@@) [ 359 ] حدثنا عبد الله نا نصر بن علي ، عن مسلم 
ms89	 بن إبراهيم ، | عن صدقة وحده ، ولم أضبط عنه آخر الآية . | PageV01P280 |(@)(@@) | باب | ذلك بأن منهم صديقين ورهبانا(@)(@@) [ 360 ] حدثنا عبد الله نا عمي ويعقوب بن سفيان قال حدثنا | يحيى بن عبد الحميد ، نا نصير بن زياد الطائي نا الصلت | الدهان ، عن حامية - يعني ابن رباب - قال سمعت سلمان في قوله | ^ ( ذلك بأن منهم صديقين ورهبانا ) ^ قال : هم أصحاب الحزب | والصوامع فدعوهم فيها ، قال سلمان : قرأت على النبي [ $ ] ^ ( ذلك | بأن منهم قسيسين ورهبانا ) ^ قال : فاقرأ : ^ ( ذلك بأن منهم صديقين | ورهبانا ) ^ جميعا . |(@)(@@) [ 361 ] حدثنا عبد الله حدثنا شعيب بن أيوب ، حدثنا يحيى بن | آدم ، قال : أسباع القرآن : | PageV01P281 | السبع الأول : خمسمائة وسبع وأربعون آية . | والسبع الثاني : خمسمائة وتسعون آية . | والسبع الثالث : ستمائة آية وواحد وخمسون آية . | والسبع الرابع : تسعمائة وثلاثة وخمسون آية . | والسبع الخامس : ثمانمائة آية وثمانون وستون آية . | والسبع السادس : تسعمائة آية وست وثمانون آية . | والسبع الآخر : ألف آية وستمائة وأربع وعشرون آية . | فجميع أي القرآن : ستة آلاف ومائتان آية وتسع وعشرون آية في | الجملة ، نقصان ثلاثين آية خطأ في الحساب . | وجميع حروف القرآن : ثلاثمائة ألف حرف ، واحد وعشرون | ألف حرف ، ومائتا حرف ، وخمسون حرفا . |(@)(@@) [ 362 ] قال يحيى بن آدم : حدثنيه يزيد بن أسحم ، قال أعطانيه حمزة الزيات من كتابه : | فيصير كل سبع من أسباع القرآن : خمسة وأربعون ألف حرف ، | وثمانمائة حرف ، واثنان وتسعون حرفا ، يبقى ستة أحرف . | قال أبو بكر بن أبي داود : القائل حدثنيه يزيد بن أسحم عن | يحيى بن آدم . | وأسباع القرآن : | PageV01P282 | السبع الأول : في النساء : ^ ( يصدون عنك صدودا ) ^ | والسبع الثاني : في الأعراف : ^ ( إنا لا نضيع أجر المصلحين ) ^ | والسبع الثالث : في إبراهيم قوله : ^ ( كشجرة طيبة أصلها ثابت | وفرعها في السماء ) ^ إلى قوله ^ ( لعلهم يتذكرون ) ^ | والسبع الرابع : في المؤمنين قوله : ^ ( نمدهم به من مال وبنين ) ^ | والخامس : في سبأ ^ ( فاتبعوه إلا فريقا من المؤمنين ) ^ | والسادس : خاتمة الفتح . | والسابع : بقية القرآن . | PageV01P283 | صفحة فارغة | PageV01P284 | بسم الله الرحمن الرحيم | الجزء الرابع | توكلت على الله وحده |(@)(@@) [ 363 ] أخبرنا القاضي أبو الفضل محمد بن عمر بن يوسف 
ms90	 | الأرموي ، قراءة عليه ، قال : أخبرنا الشيخ الجليل أبو جعفر محمد | ابن أحمد بن المسلمة المعدل ، قال أخبرنا أبو عمرو عثمان بن محمد | المعروف بابن الآدمي قال : أخبرنا أبو بكر عبد الله بن أبي داود سليمان | ابن الأشعث السجستاني الأزدي ، حدثنا يعقوب بن سفيان حدثنا | عبد الله بن الزبير الحميدي ، حدثنا أبو الوليد عبد الملك بن عبد الله بن | مسعود ، عن إسماعيل بن عبد الله بن قسطنطين ، [ قال ابن أبي داود : | وهو أحد القراء عن حميد الأعرج ] أنه حسب حروف القرآن فوجد | النصف الأول من القرآن ينتهي إلى خمس وستين آية من سورة الكهف | عند قوله ( س 18 آ 67 ) ^ ( هل أتبعك على أن تعلمني مما علمت | رشدا قال إنك لن تستطيع ) ^ ، وهو الربع الثاني والسدس الثالث | والثمن الرابع والعشر الخامس ، وصارت ^ ( معي صبرا ) ^ من النصف | PageV01P285 | الآخر إلى أن يختم القرآن ، والثلث الأول ينتهي إلى بعض إحدى | وتسعين آية من براءة عند قوله ( س 9 آ 90 ) ^ ( كذبوا الله ورسوله | سيصيب ) ^ إلى الباء من ^ ( سيصيب ) ^ وهو السدس الثاني والسبع | الثالث ، وصارت الباء من ' سيصيب ' من الثلث الثاني ، والثلث | الأوسط ينتهي إلى بعض ست وأربعين آية في سورة العنكبوت عند | قوله ( س 29 آ 46 ) ^ ( إلا بالتي هي أحسن إلا ) ^ ، وهو السدس | الرابع والسبع السادس ، وصارت ^ ( الذين ظلموا ) ^ من الثلث الآخر | والثلث الآخر ينتهي إلى أن يختم القرآن . والربع الأول ينتهي إلى ، | أول آية من سورة الأعراف إلى ( س 7 آ 2 ) ^ ( وذكرى للمؤمنين ) ^ ، | وهو الثمن الثاني ، وصارت ^ ( اتبعوا ) ^ من الربع الثاني ، والربع | الثاني ينتهي إلى ( س 18 آ 67 ) ^ ( إنك لن تستطيع ) ^ حيث انتهى | النصف ، والربع الثالث إلى بعض مائة وثمانية وأربعين آية من سورة | الصافات عند ( س 37 آ 148 ) ^ ( فآمنوا فمتعناهم ) ^ وهو الثمن | السادس ، وصارت ^ ( إلى حين ) ^ من الربع الآخر ، والربع الآخر إلى | أن يختم . والخمس الأول ينتهي إلى بعض اثنتين وثمانين آية من | سورة المائدة عند قوله ( س 5 آ 80 ) ^ ( أن سخط الله عليهم ) ^ وهو | العشر الثاني 
ms91	 ، وصارت ^ ( وفي العذاب هم خالدون ) ^ من الخمس | الثاني ، والخمس الثاني ينتهي إلى بعض ست وأربعين آية من سورة | يوسف عند قوله تعالى ( س 12 آ 46 ) ^ ( ارجع إلى الناس ) ^ وهو | العشر الرابع ، وصارت ^ ( لعلهم ) ^ من الخمس الثالث ، والخمس | الثالث ينتهي إلى بعض إحدى وعشرين آية من سورة الفرقان عند قوله | ( س 25 آ 21 ) ^ ( أو نرى ربنا ) ^ وهو العشر السادس ، وصارت | PageV01P286 | ^ ( لقد استكبروا ) ^ من الخمس الرابع ، والخمس الرابع ينتهي إلى بعض | خمسة وأربعين آية من سورة حم السجدة عند قوله ( س 41 آ 46 ) | ^ ( من عمل صالحا فلنفسه ومن ) ^ هو العشر الثامن ، وصارت ^ ( أساء | فعليها ) ^ من الخمس الآخر ، والخمس الآخر ينتهي إلى أن يختم | القرآن . والسدس الأول ينتهي إلى بعض إحدى وأربعين ومائة من | سورة النساء عند قوله ( س 4 آ 142 ) ^ ( إلى الصلاة قاموا ) ^ وصارت | ^ ( كسالى ) ^ من السدس الثاني ، والسدس الثاني ينتهي إلى إحدى | وتسعين آية من سورة براءة في ( س 9 آ 90 ) ^ ( سيصيب ) ^ إلى الباء ، | وهو الثلث الأول والسبع الثالث ، فصارت الباء من ^ ( سيصيب ) ^ من | السدس الثالث ، والسدس الثالث ينتهي إلى بعض خمسة وستين آية | من سورة الكهف عند ( س 18 آ 67 ) ^ ( إنك لن تستطيع ) ^ وهو الأول | يعني النصف الأول والربع الثاني والثمن الرابع والعشر الخامس ، | وصارت ^ ( معي صبرا ) ^ من السدس الرابع ، والسدس الرابع ينتهي إلى | بعض ست وأربعين آية من سورة العنكبوت . عند قوله ( س 29 آ 46 ) | ^ ( بالتي هي أحسن إلا ) ^ وهو السبع السادس ، فصارت ^ ( الذين | ظلموا ) ^ من السدس الخامس ، والسدس الخامس ينتهي إلى بعض أربع | وثلاثين آية من حم الجاثية عند قوله ( س 45 آ 35 ) ^ ( فاليوم لا | يخرجون منها ) ^ وصارت ^ ( ولا هم يستعتبون ) ^ من السدس الآخر ، | والسدس الآخر ينتهي إلى أن يختم القرآن . والسبع الأول ينتهي إلى | بعض ست وخمسين آية من سورة النساء عند قوله ( س 4 آ 57 ) | ^ ( أزواج مطهره وند ) ^ وصارت ^ ( خلهم ) ^ من السبع الثاني ، والسبع | الثاني ينتهي إلى مائة وتسع وستين آية من الأعراف عند قوله ( س 7 
ms92	 آ | PageV01P287 | 167 ) ^ ( إن ربك لسريع ال ) ^ وصارت ^ ( عقاب ) ^ من السبع الثالث ، | والسبع الثالث ينتهي إلى بعض أربع وعشرين آية من سورة إبراهيم | عند قوله ( س 14 آ 22 ) ^ ( وما كان لي علي ) ^ وصارت ^ ( كم ) ^ من | السبع الرابع ، والسبع الرابع ينتهي إلى بعض سبع وأربعين آية من | سورة المؤمنين عند قوله ( س 23 آ 49 ) ^ ( آتينا موسى الكتاب ) ^ | وصارت ^ ( لعلهم يهتدون ) ^ من السبع الخامس ، والسبع الخامس | ينتهي إلى بعض ثمان عشرة آية من سورة سبأ عند ( س 34 آ 18 ) | ^ ( قرى ظاهرة وقدر ) ^ وصارت ^ ( نا ) ^ من السبع السادس ، والسبع | السادس ينتهي إلى آخر حرف من الآية الثانية من سورة الحجرات ( س | 49 آ 2 ) ^ ( وأنتم لا تشعرون ) ^ وصارت ^ ( إن الذين يغضون ) ^ من | السبع الآخر ، والسبع الآخر إلى أن يختم القرآن . والثمن الأول ينتهي | إلى بعض مائة وخمسة وتسعين آية من سورة آل عمران عند قوله ( س | 3 آ 197 ) ^ ( متاع قليل ثم مأ ) ^ وصارت الواو والياء والهاء الميم التي | في ^ ( مأواهم ) ^ من الثمن الثاني ، والثمن الثاني ينتهي إلى انقضاء أول | آية من سورة الأعراف عند ( س 7 آ 2 ) ^ ( وذكرى للمؤمنين ) ^ وهو | الربع الأول ، وصارت ^ ( اتبعوا ما أنزل إليكم ) ^ من الثمن الثالث ، | والثمن الثالث ينتهي إلى بعض سبع وثلاثين آية من سورة هود عند | ( س 11 آ 40 ) ^ ( وفار ) ^ وصار ^ ( التنور ) ^ من الثمن الرابع ، والثمن | الرابع ينتهي إلي خمس وستين آية من سورة الكهف عند ( س 18 آ | 67 ) ^ ( إنك لن تستطيع ) ^ حيث انتهى إلى النصف الأول وهو الربع | الثاني والعشر الخامس ، وصارت ^ ( معي صبرا ) ^ من الثمن الخامس ، | والثمن الخامس ينتهي إلى آخر سورة الشعراء ( س 26 آ 227 ) ^ ( أي | PageV01P288 | منقلب ينقلبون ) ^ الياء من الثمن الخامس والنون والقاف واللام والباء | والواو والنون من الثمن السادس ، والثمن السادس ينتهي إلى بعض | مائة وثمانية وأربعين آية من سورة الصافات عند ( س 37 آ 148 ) | ^ ( فآمنوا فمتعناهم ) ^ وهو الربع الثالث ، وصارت ^ ( إلى حين ) ^ من | الثمن السابع ، والثمن السابع ينتهي إلى أول عشر من سورة 
ms93	 النجم | إلى قوله ( س 53 آ 10 ) ^ ( فأوحى إلى عبده ما أوحى ) ^ وصارت | ^ ( ما كذب الفؤاد ) ^ من الثمن الآخر ، والثمن الآخر إلى أن يختم | القرآن . والتسع الأول ينتهي إلى بعض مائة وثلاثة وأربعين آية من | سورة آل عمران ( س 3 آ 143 ) ^ ( فقد رأيتموه وأنتم ) ^ قالوا : والألف | آخر التسع الأول وصارت النون والتاء والميم من التسع الثاني ، والتسع | الثاني ينتهي إلى بعض أربع وخمسين آية من سورة الأنعام عند ( س 6 | آ 53 ) ^ ( ليقولوا أهؤلاء من الله عليهم من بيننا ) ^ وصارت ^ ( أليس الله | بأعلم بالشاكرين ) ^ من التسع الثالث ، والتسع الثالث ينتهي في بعض | إحدى وتسعين آية من سورة براءة عند ( س 9 آ 90 ) ^ ( سيصيب ) ^ | إلى الباء ، وهو الثلث الأول والسدس الثاني ، وصارت الباء من | ^ ( سيصيب ) ^ من التسع الرابع والتسع الرابع ينتهي إلى بعض إحدى | عشرة من سورة النحل ( س 16 آ 11 ) ^ ( من كل الثمرات إن في ) ^ | وصارت ^ ( ذلك ) ^ من التسع الخامس ، والتسع الخامس ينتهي في بعض | ثمان وعشرين آية من سورة الحج عند ( س 22 آ 30 ) ^ ( وأحلت | لكم الأ ) ^ وصارت النون والعين والألف والميم التي في ^ ( الأنعام ) ^ من | التسع السادس ، والتسع السادس ينتهي في بعض ست وأربعين آية من | سورة العنكبوت ( 29 آ 46 ) ^ ( ولا تجادلوا أهل الكتاب إلا بالتي هي | PageV01P289 | أحسن إلا ) ^ وهو الثلث الأوسط والسدس الرابع ، وصارت ^ ( الذين | ظلموا ) ^ من التسع السابع ، والتسع السابع ينتهي إلى بعض تسع آيات | من أول سورة حم المؤمن عند ( س 40 آ 10 ) ^ ( ينادون لمقت الله أكبر | من مقتكم أن ) ^ وصارت الفاء والسين والكاف والميم من ^ ( أنفسكم ) ^ | في التسع الثامن ، والتسع الثامن ينتهي إلى بعض سبع عشرة آية من | أول سورة الواقعة عند ( 56 آ 15 ) ^ ( وقليل من الآخرين على ) ^ | وصارت ^ ( سرر ) ^ من التسع الآخر ، والتسع الآخر إلى أن يختم | القرآن . والعشر الأول ينتهي إلى بعض إحدى وتسعين آية من سورة | آل عمران عند ( س 3 آ 92 ) ^ ( لن تنالوا البر حتى تنفقوا مما ) ^ | وصارت ^ ( تحبون ) ^ من العشر الثاني 
ms94	 ، والعشر الثاني ينتهي إلى بعض | اثنتين وثمانين آية من سورة المائدة عند ( س 5 آ 80 ) ^ ( لبئسما قدمت | لهم أنفسهم أن سخط الله عليهم ) ^ وهو الخمس الأول ، وصارت | ^ ( وفي العذاب ) ^ من العشر الثالث ، والعشر الثالث ينتهي إلى بعض | اثنتين وثلاثين آية من سورة الأنفال عند ( س 8 آ 32 ) ^ ( فأمطر علينا | حجارة من السماء أو ائتنا ) ^ وصارت ^ ( بعذاب أليم ) ^ من العشر الرابع ، | والعشر الرابع ينتهي إلى بعض ست وأربعين آية من يوسف عند | قوله تعالى ( س 12 آ 46 ) ^ ( ارجع إلى الناس ) ^ وهو الخمس الثاني ، | وصارت ^ ( لعلهم يعلمون ) ^ من العشر الخامس ، والعشر الخامس ينتهي | إلى خمس وستين آية من سورة الكهف عند قوله ( س 18 آ 67 ) | ^ ( إنك لن تستطيع ) ^ وهو النصف الأول والربع الثاني والسدس الثالث ، | والثمن الرابع ، وصارت ^ ( معي صبرا ) ^ من العشر السادس ، والعشر | السادس ينتهي إلى بعض إحدى وعشرين آية من سورة الفرقان عند | PageV01P290 | ( س 25 آ 21 ) ^ ( لولا أنزل علينا الملائكة أو نرى ربنا ) ^ وهو الخمس | الثالث ، وصارت ^ ( لقد استكبروا في أنفسهم ) ^ في العشر السابع ، | والعشر السابع ينتهي إلى بعض إحدى وثلاثين آية من سورة الأحزاب | ( س 33 آ 31 ) ^ ( ومن يقنت منكن لله ورسوله وتعمل ) ^ وصارت | ^ ( صالحا ) ^ من العشر الثامن ، والعشر الثامن ينتهي إلى بعض خمس | وأربعين آية من سورة حم السجدة عند ( س 41 آ 46 ) ^ ( من عمل | صالحا فلنفسه ومن ) ^ وهو الخمس الرابع ، وصارت ^ ( أساء فعليها ) ^ من | العشر التاسع ، والعشر التاسع ينتهي إلى بعض خمس وعشرين آية من | سورة الحديد عند ( س 57 آ 26 ) ^ ( وجعلنا في ذريتهما النبوة | والكتاب ) ^ وصارت ^ ( فمنهم مهتد وكثير منهم فاسقون ) ^ في العشر | العاشر ، والعشر العاشر ينتهي إلى آخر القرآن . | PageV01P291 |(@)(@@) | باب | كتابة المصاحف ](@)(@@) | أخذ الأجرة على كتابة المصاحف(@)(@@) [ 364 ] حدثنا محمد بن إسماعيل الأحمسي وعلي بن محمد بن | أبي الخصيب قالا حدثنا وكيع عن علي بن المبارك عن أبي حكيمة | العبدي قال كنت أكتب المصاحف بالكوفة فيمر علينا علي رضى الله عنه فيقوم | فينظر فيعجبه خطنا ويقول هكذا 
ms95	 نوروا ما نور الله . | PageV01P292 |(@)(@@) [ 365 ] حدثنا عبد الله حدثنا عمي حدثنا أبو نعيم حدثنا عبد | الملك بن شداد قال حدثني سليمان أن أبا حكيمة حدثه أنه كان | يكتب المصاحف بالكوفة فمر به علي عليه السلام وهو يكتب فقال ، | أجل قلمك فقططت منه ثم كتبت وهو قائم فقال نوره كما نوره الله | عز وجل . |(@)(@@) [ 366 ] حدثنا عبد الله حدثنا محمد بن إسماعيل الأحمسي حدثنا | وكيع عن عبد الملك بن شداد الأزدي عن عبيد الله بن سليمان العبدي | عن أبي حكيمة قال ، كان علي عليه السلام يمر علينا ونحن بالكوفة | نكتب المصاحف ، فيقوم فينظر إلينا ويعجبه خطنا فقال أجل قلمك | فقططت القلم فقال هكذا نوروا ما نور الله . | PageV01P293 |(@)(@@) [ 367 ] حدثنا عبد الله حدثنا عبد الله بن محمد بن النعمان حدثنا | ابن أبي بزة حدثنا محمد بن عبد الملك أبو جابر حدثنا عبد الملك بن | شداد الجديدي [ بطن من الأزد وهذا من بني جديد عن عبيد الله بن | سليمان ] قال سمعت أبا حكيمة بهذا . |(@)(@@) [ 368 ] حدثنا عبد الله حدثنا عبد الله بن الصباح ويحيى بن | حكيم قالا حدثنا حماد بن واقد عن مالك بن دينار قال : دخل علي | جابر بن زيد وأنا أكتب المصحف فقال لي : مالك صنعة إلا أن تنقل | كتاب الله من ورقة إلى ورقة ، هذا والله كسب حلال هذا والله كسب | الحلال . |(@)(@@) [ 369 ] حدثنا عبد الله حدثنا عبد الله بن الصباح ويحيى بن | حكيم قالا حدثنا عبد العزيز بن عبد الصمد حدثنا مالك بن دينار قال | دخل علي جابر بن زيد وأنا أكتب مصحفا ، فقلت له كيف ترى | صنعتي هذه يا أبا الشعثاء . فقال نعم الصنعة صنعتك ، ما أحسن هذا | تنقل كتاب الله من ورقة إلى ورقة وآية إلى آية . وكلمة إلى كلمة ، | PageV01P294 | هذا الحلال لا بأس به . |(@)(@@) [ 370 ] حدثنا عبد الله حدثنا يعقوب بن سفيان حدثنا موسى بن | إسماعيل حدثنا عبد الملك قال ، دخل أبو الشعثاء على مالك بن | دينار فقال ، يا أبا الشعثاء كيف ترى صنعتي هذه ؟ قال 
ms96	 نعمت | الصنعة صنعتك تنتقل كتاب الله من ورقة إلى ورقة ، ونعمت الصنعة | صنعتك فالزمها . |(@)(@@) [ 371 ] حدثنا عبد الله حدثنا محمد بن عبد الملك الدقيقي حدثنا | يزيد قال أخبرنا الربيع قال ، سمعت الحسن وسئل عن كتاب | المصاحف ، فقال لا بأس به على غير شرط . |(@)(@@) [ 372 ] حدثنا عبد الله حدثنا إسحاق بن إبراهيم حدثنا الحجاج | حدثنا الربيع بهذا . |(@)(@@) [ 373 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا عيسى بن | حنيفة قال ، كان مالك بن دينار يكتب المصاحف ولا يشارط يكتب | المصحف في بيته فإذا أتى بأجره أخذ ما يعلم أنه أجرته ويرد ما سوى | ذلك . | PageV01P295 |(@)(@@) [ 374 ] حدثنا عبد الله حدثنا أحمد بن هاشم الرملي حدثنا | ضمرة عن ابن شوذب قال ، كان مطر ومالك بن دينار يكتبان | المصاحف ولا يشترطان فما أعطيا من شيء قبلاه . |(@)(@@) [ 375 ] حدثنا عبد الله حدثنا أبو عمير الرملي حدثنا ضمرة عن | السري عن مطر قال ، كان حبرا هذه الأمة لا يريان بأسا على الأخذ | على المصاحف [ ابن المسيب والحسن ] . | PageV01P296 |(@)(@@) [ 376 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا المحاربي | عن ليث عن مجاهد أن رجلا كتب له مصحفا فأعطاه أجره . |(@)(@@) [ 377 ] حدثنا عبد الله حدثنا محمد بن إسماعيل الأحمسي حدثنا | وكيع عن معمر بن سليمان عن أبي جعفر قال لا بأس بكتاب | المصاحف بالأجر . |(@)(@@) [ 378 ] حدثنا عبد الله حدثنا زياد بن أيوب وعبد الله بن سعيد | قالا حدثنا ابن أبي غنية حدثنا الأعمش قال حدثت عن سعيد بن جبير | قال ، سئل ابن عباس عن كتاب المصاحف فقال إنما هو مصور . | PageV01P297 |(@)(@@) | وقد كره الأجرة على كتاب المصاحف(@)(@@) [ 379 ] حدثنا عبد الله حدثنا أبو عمير الرملي حدثنا ضمرة عن | ابن شوذب قال سمعت أيوب يقول ما هو إلا شيء حدثنا الشيخ عنه . | [ يعني مطر ومالك والشيخ الحسن ] . |(@)(@@) [ 380 ] حدثنا عبد الله حدثنا عبد الله بن إسماعيل حدثنا المحاربي | عن عبيدة عن إبراهيم أن علقمة اشترى ورقا فأعطى أصحابه فكتبوه | له . |(@)(@@) [ 381 ] حدثنا عبد الله حدثنا هارون بن إسحاق 
ms97	 ومحمد بن | إسماعيل الأحمسي قالا حدثنا وكيع عن سفيان عن منصور عن | إبراهيم أن علقمة أراد أن يكتب مصحفا فأمر أصحابه فكتبوه . |(@)(@@) [ 382 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا ابن فضيل | PageV01P298 عن أشعث عن ابن سيرين قال نكره لكاتب المصحف أن يأخذ على | كتابها أجرا . |(@)(@@) [ 383 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا المحاربي | عن أشعث عن ابن سيرين أنه كره كتاب المصاحف أن تباع . |(@)(@@) [ 384 ] حدثنا عبد الله حدثنا محمد بن عبد الله بن الحسن حدثنا | شيبان مهدي بن ميمون قال سألت محمد بن سيرين عن كتاب | المصاحف فقال كره كتابها واستكتابها وبيعها وشراها . |(@)(@@) [ 385 ] حدثنا عبد الله حدثنا محمد بن بشار حدثنا ابن أبي عدي | عن ابن عون عن محمد أنه كره بيع المصاحف وشراها وأن يستأجر | على كتابها . | PageV01P299 |(@)(@@) | [ باب ] | النصراني يكتب المصاحف(@)(@@) [ 386 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا عبد السلام | حدثنا ابن أبي ليلى [ أو سفيان عن ابن أبي ليلى ] أن عبد الرحمن بن | عوف استكتب رجلا من أهل الحيرة نصرانيا مصحفا فأعطاه ستين | درهما . |(@)(@@) [ 387 ] حدثنا عبد الله حدثنا محمد بن إسماعيل الأحمسي حدثنا | وكيع عن سفيان عن ابن أبي ليلى عن أخيه عيسى عن أبيه عبد | الرحمن بن أبي ليلى أنه كتب له رجل من الحيرة مصحفا بسبعين | درهما . | PageV01P300 |(@)(@@) [ 388 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا ابن علية | عن شعبة عن منصور عن إبراهيم أن علقمة كتب له نصراني مصحفا . |(@)(@@) [ 389 ] حدثنا عبد الله حدثنا يونس بن حبيب حدثنا أبو داود | حدثنا شعبة بهذا . | PageV01P301 |(@)(@@) | الجنب يكتب المصاحف(@)(@@) [ 390 ] حدثنا عبد الله حدثنا علي بن محمد بن أبي الخصيب | حدثنا وكيع حدثنا سفيان عن ليث عن مجاهد كره أن يكتب الجنب | ' بسم الله الرحمن الرحيم ' . |(@)(@@) [ 391 ] حدثنا عبد الله حدثنا يعقوب بن سفيان حدثنا أبو نعيم | حدثنا سفيان بهذا . |(@)(@@) [ 392 ] حدثنا عبد الله حدثنا أسيد بن عاصم حدثنا الحسين عن | سفيان بهذا . |(@)(@@) [ 393 ] حدثنا 
ms98	 عبد الله حدثنا علي بن محمد بن أبي الخصيب | حدثنا وكيع عن سفيان عن جابر عن عامر أنه كره أن يكتب الجنب | ' بسم الله الرحمن الرحيم ' . | PageV01P302 |(@)(@@) [ 394 ] حدثنا عبد الله حدثنا أسيد حدثنا الحسين عن سفيان | بهذا . | PageV01P303 |(@)(@@) | تكتب المصاحف مشقا(@)(@@) [ 395 ] حدثنا عبد الله حدثنا المسيب بن واضح ومحمد بن آدم | قالا حدثنا مخلد بن حسين عن واصل وهشام عن ابن سيرين أنه كره | أن تكتب المصاحف مشقا ، وزاد المسيب ، قيل لابن سيرين لم كره | ذلك ؟ قال لأن فيه نقص ، ألا ترى الألف كيف يغرقها ينبغي أن | ترد . | PageV01P304 |(@)(@@) | تكتب المصاحف في الكراديس(@)(@@) [ 396 ] حدثنا عبد الله حدثنا عبد الله بن محمد بن النعمان حدثنا | أبو نعيم حدثنا مندل عن الوليد بن ثعلبة عن عبد الله مؤدب | الضحاك قال ، كان يكره الكراريس يعني المصاحف تكتب فيها . |(@)(@@) | يكتب العلم في مثل المصاحف(@)(@@) [ 397 ] حدثنا عبد الله حدثنا كثير بن عبيد حدثنا بقية قال دفع | إلى بحير مصحفا لخالد بن معدان فيه علمه أخذه منه مكتوبا في تختين | وله دفتي المصحف وله عرى أزرار . |(@)(@@) [ 398 ] حدثنا عبد الله حدثنا علي بن خشرم قال أخبرنا وكيع بن | PageV01P305 | الجراح عن الوليد بن ثعلبة عن عبد الله مؤدب الضحاك عن الضحاك | قال ، لا تتخذوا الحديث كراسي ككراسي المصحف . |(@)(@@) [ 399 ] حدثنا عبد الله حدثنا علي قال أخبرنا وكيع عن الحسن بن | صالح عن ليث عن مجاهد أنه كرهها . |(@)(@@) [ 400 ] حدثنا عبد الله حدثنا علي أنبأنا وكيع عن أبي عوانة | وضاح عن سليمان بن أبي العتيك عن أبي معشر عن إبراهيم أنه | كرهها . | PageV01P306 |(@)(@@) | من أحق بكتابة المصاحف(@)(@@) [ 401 ] حدثنا عبد الله حدثنا محمد بن عبد الملك الدقيقي حدثنا | عمرو بن عون قال أنبأنا هشيم عن العوام عن إبراهيم التميمي قال ، | قال عبد الله لا يكتب المصاحف إلا مضري . قال أبو بكر هذا من | أجل اللغات . |(@)(@@) | تعظيم المصاحف(@)(@@) [ 402 ] حدثنا عبد الله حدثنا موسى بن سفيان حدثنا عبد الله | حدثنا عمرو بن المغيرة عن إبراهيم قال كان يقال عظموا 
ms99	 المصاحف . |(@)(@@) [ 403 ] حدثنا عبد الله حدثنا علي بن أبي الخصيب حدثنا وكيع | PageV01P307 | عن سفيان عن مغيرة عن إبراهيم قال كان يقال عظموا المصاحف . |(@)(@@) | تصغير المصاحف(@)(@@) [ 404 ] حدثنا عبد الله حدثنا عبد الله بن سعيد حدثنا أبو خالد | عن سفيان عن مغيرة عن إبراهيم قال كانوا يكرهون أن يكتبوا | المصاحف في الشيء الصغير ، يقول عظموا القرآن . |(@)(@@) [ 405 ] حدثنا عبد الله حدثنا محمد بن الربيع حدثنا يزيد حدثنا | شعبة عن المغيرة عن إبراهيم قال كانوا يكرهون تصغير المصحف | والتعشير والفواتح . |(@)(@@) [ 406 ] حدثنا عبد الله حدثنا إسحاق بن إبراهيم حدثنا أبو داود | حدثنا أبو بكر بن عياش عن الأعمش عن إبراهيم أن علي بن أبي | PageV01P308 | طالب رضى الله عنه كان يكره أن يكتب القرآن في الشي الصغير . |(@)(@@) [ 407 ] حدثنا عبد الله حدثنا أحمد بن سنان حدثنا محمد بن | عبيد وأبو معاوية قالا حدثنا الأعمش عن إبراهيم قال كان علي رضي الله عنه | يكره أن يكتب القرآن [ قال أبو معاوية المصحف ] في الشيء الصغير . |(@)(@@) [ 408 ] حدثنا عبد الله حدثنا إسحاق بن إبراهيم حدثنا سعد بن | الصلت حدثنا الأعمش عن إبراهيم عن علي رضي الله عنه قال لا تكتب | المصاحف صغارا . |(@)(@@) [ 409 ] حدثنا عبد الله حدثنا محمد بن بشار حدثنا يحيى حدثنا | سفيان عن سليمان الأعمش عن إبراهيم أن عليا عليه السلام كره أن | تتخذ المصاحف صغار . | PageV01P309 |(@)(@@) | كتابة المصاحف حفظا(@)(@@) [ 410 ] حدثنا عبد الله حدثنا محمد بن بشار حدثنا محمد حدثنا | شعبة عن الحكم عن خيثمة قال : قال عمر بن الخطاب ، من يدلني | على رجل ؟ فقال له رجل ، هل لك في رجل يقرأ القرآن عن ظهر | قلبه ؟ قال فتطاول عمر وقال من هو . قال ابن أم عبد . فتقاصر عمر | وقال إنه لأحداهم بذلك ، . [ قال أبو بكر قيل في هذا الحديث يملي | القرآن عن ظهر قلبه ] . | PageV01P310 | صفحة فارغة | PageV01P311 | صفحة فارغة | PageV01P312 | صفحة فارغة | PageV01P313 | صفحة فارغة | PageV01P314 |(@)(@@) [ 411 ] حدثنا عبد الله حدثنا أحمد بن سنان حدثنا أبو معاوية | حدثنا الأعمش عن إبراهيم عن علقمة قال وحدثنا عن خيثمة عن 
ms100	 | قيس بن مروان قال وهو الذي أتى عمر ، قال جاء رجل إلى عمر | وهو يعرفه فقال ، يا أمير المؤمنين جئتك من الكوفة وتركت بها رجلا | يملي المصاحف عن ظهر قلبه ، قال فغضب عمر وانتفخ حتى كاد أن | يملا ما بين شعبتي الرجل ، قال من هو ويحك ؟ قال هو عبد الله بن | مسعود ، قال فما زال يطفا ويتسرى عنه الغضب حتى عاد إلى حالته | التي كان عليها ، ثم قال ويحك والله ما أعلم بقى من الناس أحد هو | أحق بذلك منه ، وسأحدثك عن ذلك ، كان رسول الله [(@)(@@) | ] يسمر | عند أبي بكر الليلة كذلك في الأمر من أمر المسلمين ، وأنه سمر عنده | ذات ليلة وأنا معه فخرج رسول الله [(@)(@@) ] يمشي وخرجنا معه نمشي ، | فإذا رجل قائم يصلي في المسجد ، فقام رسول الله [(@)(@@) | ] يسمع قراءته ، | فلما كدنا أن نعرف الرجل قال ، من سره أن يقرأ القرآن رطبا كما | أنزل فليقرأه على قراءة ابن أم عبد . قال ثم جلس الرجل يدعو فجعل | رسول الله [(@)(@@) ] يقول ، سل تعطه سل تعطه ، قال فقال عمر ، فقلت | والله لأغدون إليه ولأبشرنه ، قال فغدوت إليه لأبشره فوجدت أبا | بكر قد سبقني إليه فبشره فلا والله ما سابقته قط إلى خير إلا سبقني | إليه . | PageV01P315 |(@)(@@) | كتابة الفواتح والعدد في المصاحف(@)(@@) [ 412 ] حدثنا عبد الله حدثنا هارون بن سليمان حدثنا روح | حدثنا سفيان الثوري عن المغيرة عن إبراهيم قال ، كانوا يكرهون النقط | والتعشير وإحصار الصور . |(@)(@@) [ 413 ] حدثنا عبد الله حدثنا محمد بن بشار حدثنا محمد بن | شعبة عن المغيرة عن إبراهيم قال كانوا يكرهون تصغير المصاحف | والفواتح والعواشر . |(@)(@@) [ 414 ] حدثنا عبد الله حدثنا هارون بن سليمان حدثنا روح | حدثنا شعبة عن المغيرة عن إبراهيم أنه كان يكره العواشر والفواتح | وتصغير المصحف وأن يكتب فيه سورة كذا وكذا . | PageV01P316 |(@)(@@) [ 415 ] حدثنا عبد الله حدثنا محمد بن حاتم بن بزيع حدثنا أبو | الجواب حدثنا عمار عن الأعمش قال سألت إبراهيم عن التعشير في | المصحف ويكتب سورة كذا وكذا فكرهه وكان يقول جردوا القرآن . |(@)(@@) [ 416 ] حدثنا 