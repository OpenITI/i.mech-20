ms321	(@)(@@) % لشتان ما بين البياضين معجب % أنيق ومشنوء إلى العين أنكد % 366(@)(@@) % تضاحك في أفنان رأسي ولحيتي % % وأقبح ضحاكين شيب وأدرد % 367(@)(@@) % وكنت جلاء للعيون من القذى % % فقد جعلت تقذي بشيبي وترقد % 368(@)(@@) % هي الأعين النجل التي كنت تشتكي % % مواقعها في القلب والرأس أسود % 369(@)(@@) % فما لك تأسى الآن لما رأيتها % % وقد جعلت مرمى سواك تعمد % 370(@)(@@) % تشكى إذا ما أقصدتك سهامها % % وتأسى إذا نكبن عنك وتكمد % PageV01P1199 371(@)(@@) % كذلك تلك النبل من وقعت به % % ومن صرفت عنه من القوم مقصد % 372(@)(@@) % إذا عدلت عنا وجدنا عدولها % % كموقعها في القلب بل هو أجهد % 373(@)(@@) % تنكب عنا مرة فكأنما % % منكبها عنا إلينا مسدد % 374(@)(@@) % كفى حزنا أن الشباب معجل % قصير الليالي والمشيب مخلد % 375(@)(@@) % إذا حل جارى المرء شأو حياته % % إلى أن يضم المرء والشيب ملحد % 376(@)(@@) % أرى الدهر أجرى ليله ونهاره % % بعدل فلا هذا ولا ذاك سرمد % 377(@)(@@) % وجار على ليل الشباب فضامه % نهار مشيب سرمد ليس ينفد % 378(@)(@@) % وعزاك عن ليل الشباب معاشر % فقالوا نهار الشيب أهدى وأرشد % 379(@)(@@) % وكان نهار المرء أهدى لسعيه % % ولكن ظل الليل أندى وأبرد % 380(@)(@@) % أأيام لهوي هل مواضيك عود % وهل لشباب ضل بالأمس منشد % PageV01P1200 381(@)(@@) % أقول وقد شابت شواتي وقوست % قناتي وأضحت كدنتي تتخدد % 382(@)(@@) % ودب كلال في عظامي أدبني % % جنيب العصا أنأد أو أتأيد % 383(@)(@@) % وبورك طرفي فالشخاص حياله % % قرائن من أدنى مدى وهي فرد % 384(@)(@@) % ولذت أحاديثي الرجال وأعرضت % سليمى وريا عن حديثي ومهدد % 385(@)(@@) % وبدل إعجاب الغواني تعجبا % فهن روان يعتبرن وصدد % 386(@)(@@) % لما تؤذن الدنيا به من صروفها % % يكون بكاء الطفل ساعة يولد % 387(@)(@@) % وإلا فما يبكيه منها وإنها % % لأفسح مما كان فيه وأرغد % 388(@)(@@) % إذا أبصر الدنيا استهل كأنه % % بما سوف يلقى من أذاها يهدد % 389(@)(@@) % وللنفس أحوال تظل كأنها % % تشاهد فيها كل غيب سيشهد % 390(@)(@@) % رزحت على مر الليالي وكرها % % وهل عن فناء من فناءين عندد % PageV01P1201 391(@)(@@) % محار الفتى شيخوخة أو منية % ومرجوع وهاج المصابيح رمدد % 392(@)(@@) % وقد أغتدي 
ms322	 للوحش والوحش هجد % ولو نذرت بي لم تبت وهي هجد % 393(@)(@@) % فيشقى بي الثور القصي مكانه % بحيث يراعيه الأصل الخفيدد % 394(@)(@@) % ترى كل ركاع على مرتع % % يخر لرمحي ساجدا بل يسجد % 395(@)(@@) % إذا غازلته بالصريم نعاجه % % كما غازلت زيرا أوانس خرد % 396(@)(@@) % أمرت به رمحا غيورا فخاضه % ذليقا كما شك النقيلة مسرد % 397(@)(@@) % فخر لروقيه صريعا تخاله % يعصفر من تاموره أو يفرصد % 398(@)(@@) % كأن سناني حين وافاه كوكب % أصيب به قطع من المزن أقهد % 399(@)(@@) % وقد أشرب الكأس الغريض مزاجها % % على ما تغناه الغريض ومعبد % 400(@)(@@) % يطوف بها للشرب أبيض مخطف % يجود له بالراح أسود أكبد % PageV01P1202 401(@)(@@) % بمولية خضراء ينغم وسطها % % ويهدل في أرجائها ويهدهد % 402(@)(@@) % إذا شئت راقت ناظري نظائر % % بمصطبحي والأدم حولي رود % 403(@)(@@) % وصيف وإبريق ودوم ومرشق % على شرف كل الثلاثة أجيد % 404(@)(@@) % وأنجب ما ولدت منه مسرة % إذا ما بنات الصدر ظلت تولد % 405(@)(@@) % حديث نتاج من بني المزن أمه % معنسة مما تعتق صرخد % 406(@)(@@) % وبيضاء يخبو درها من بياضها % % ويذكو له ياقوتها والزبرجد % 407(@)(@@) % لها سنة كالشمس تبرز تارة % % وطورا يواريها صبير منضد % 408(@)(@@) % إذا ما التقى السكران سكرا شبابها % % وأكوابها كادت من اللين تعقد % 409(@)(@@) % لهوت بها ليلا قصيرا طويله % % ومالي إلا كفها متوسد % 410(@)(@@) % وكم مثلها من ظبية قد تفيأت % ظلالي وأغصان الشبيبة ميد % PageV01P1203 411(@)(@@) % لعبت بأولى الدهر فاغتال شرتي % % بأخرى حقود والجرائم تحقد % 412(@)(@@) % فصبرا على ما اشتد منه فإنما % % يقوم لما يشتد من يتشدد % 413(@)(@@) % وما الدهر إلا كابنه فيه بكرة % وهاجرة مسمومة الجو صيخد % 414(@)(@@) % تذيق الفتى طورى رخاء وشدة % % حوادثه والحول بالحول يطرد % 415(@)(@@) % وعزى أناسا أن كل حديقة % وإن أغدفت أفنانها ستخضد % 416(@)(@@) % ومالي عزاء عن شبابي علمته % % سوى أنني من بعده لا أخلد % 417(@)(@@) % وأن مشيبي واعد بلحاقه % % وإن قال قوم إنه يتوعد % 418(@)(@@) % على أن في المأمول من فضل صاعد % % عزاء جميلا بل شبابا يجدد % 419(@)(@@) % ستظهر نعماه علي فأغتدي % % وغصن شبابي لين المتن أغيد % 420 
ms323	(@)(@@) % وتصطاد لي جدواه ما كنت صائدا % بشرخ الشباب الغض بل هي أصيد % PageV01P1204 421(@)(@@) % وأفضل ما صيدت به العين كالدمى % % مهور وأثمان من العين تنقد % 422(@)(@@) % وهل يستوي رام مراميه لحظه % ورام مراميه لجين وعسجد % 423(@)(@@) % وما أملي في المذحجي بمنته % ولكنه كالشيء بلت به اليد % 424(@)(@@) % إلى أين بي عن صاعد وانتجاعه % وقد راده الرواد قبلي فأحمدوا % % 425(@)(@@) % ولي بأبي عيسى إليه وسيلة % يفك بها أصفاد عان ويصفد % 426(@)(@@) % ومالي لا أغدو وهذان معمدي % % وما لهما إلا العوارف معمد % 427(@)(@@) % لعمري لئن أضحت وزارة صاعد % % تثنى لقد أضحى كريما يوحد % 428(@)(@@) % وزارته شفع وذاك بحقه % كما أنه وتر إذا عد سؤدد % 429(@)(@@) % هو الرجل المشروك في جل ماله % ولكنه بالخير والحمد مفرد % 430(@)(@@) % يقرض إلا أن ما قيل دونه % % ويوصف إلا أنه لا يحدد % PageV01P1205 431(@)(@@) % أرق من الماء الذي في حسامه % % طباعا وأمضى من شباه وأنجد % 432(@)(@@) % وأجدى وأندى بطن كف من الحيا % % وآبى إباء من صفاة وأجمد % 433(@)(@@) % وأبهر نورا للعيون من التي % % تضاهيه في العلياء حين تكبد % 434(@)(@@) % وأوقر من رضوى ولو شاء نسفها % % إذن لم يلقها طرفة العين مركد % 435(@)(@@) % طويل التأني لا العجول ولا الذي % % إذا طرقته نوبة يتبلد % 436(@)(@@) % له سورة مكتنة في سكينة % كما اكتن في الغمد الجراز المهند % 437(@)(@@) % إذا شامها قرت قلوب مقرها % % وإن سل منها فالفرائض ترعد % 438(@)(@@) % يلاقي العدا والأولياء ابن مخلد % لقاء امرىء في الله يرضى ويعبد % 439(@)(@@) % بجهل كجهل السيف والسيف منتضى % وحلم كحلم السيف والسيف مغمد % 440(@)(@@) % وليس بجهل الأغبياء ذوي العمى % % ولكنه جهل به الله يعبد % PageV01P1206 441(@)(@@) % عرام زعيم بالهدى أو فبالردى % % إذا ما اعتدى قوم عن القصد عند % 442(@)(@@) % قرى من ملي بالقرى حين يبتغى % % كلا نزليه اللذ والكره محمد % 443(@)(@@) % عتيد لديه الخير والشر لامرىء % بغى أو بغى خيرا وللخير أعتد % 444(@)(@@) % صموت بلا عي له من بلائه % % نواطق تستدعي الرجاء وتزأد % 445(@)(@@) % كفى الوعد والإبعاد بالقول نفسه % بأفعاله والفعل للفعل أشهد % 446(@)(@@) % إذا 
ms324	 اقتفرت آثاره فعدوه % ومولاه موعود هناك وموعد % 447(@)(@@) % عزيز غدا فوق التودد عزه % وإحسانه في ظله يتودد % 448(@)(@@) % يغض عن السؤال من طرف عينه % % لكيلا يرى الأحرار كيف تعبد % 449(@)(@@) % ويطرق إطراق الذليل وإنه % % هناك لسامي ناظر العين أصيد % 450(@)(@@) % إذا من لم يمنن بمن يمنه % وقال لنفسي أيها الناس أمهد % PageV01P1207 451(@)(@@) % وكل امتنان لا يمن فإنه % % أخف مناطا في الرقاب وأوكد % 452(@)(@@) % تجاوز أن يستأنف المجد بالندى % % وفي كل ما استرفدته فهو أجود % 453(@)(@@) % ومن لم يزد في مجده بذل ماله % وجاد به فهو الجواد المقلد % 454(@)(@@) % ترى نائلا من نائل ثم ينتهي % % إلى صاعد إسناده حين يسند % 455(@)(@@) % كأن أباه يوم سماه صاعدا % رأى كيف يرقى في المعالي ويصعد % 456(@)(@@) % جرى وجرى الأكفاء شأوا ولم يزل % % منازعه الطولى يضام ويضهد % 457(@)(@@) % فلما تناهى من يباريه في العلا % % تمادى يباري أمسه اليوم والغد % 458(@)(@@) % جواد ثنى غرب الجياد بغربه % وظل يجاري ظله وهو أوحد % 459(@)(@@) % وما أغرق المداح إلا غلابه % وراء مغالي مدحهم فيه مخلد % 460(@)(@@) % وأسلاف صدق من عرانين مذحج % طوال المساعي ليس فيهم مزند % % PageV01P1208 461(@)(@@) % بنوا مجده في هضبة مذحجية % ذؤابتها بين الفراقد فرقد % 462(@)(@@) % أولئك أوعال المعالي مسهل % لهم مرتقى في الوعر منها ومصعد % 463(@)(@@) % ألم تر زلفى صاعد عند ربه % % بلى قد رأى الساهي ومن يتفقد % 464(@)(@@) % بدت قبلة الدنيا وللنكر فوقها % % ظلال وثدي العرف فيها مجدد % 465(@)(@@) % فلما تولى الأمر نكر منكر % وعرف معروف وأصلح مفسد % 466(@)(@@) % وأصبح شمل الناس وهو مؤلف % % وعهدي بشمل الناس وهو مبدد % 467(@)(@@) % حماهم وأفشى العرف فيهم فكلهم % من الشر ممنوع من الخير ممجد % 468(@)(@@) % إذا أحسنوا جوزوا جزاء مضاعفا % وما اقترفوا من سيىء متعمد % 469(@)(@@) % ولما التقى خصب المراد وأمنه % تيقظ مسبوت ونام مسهد % 470(@)(@@) % فلم يمتنع مرعى على متعيش % ولم ينقطع شرب ولم ينب مرقد % PageV01P1209 471(@)(@@) % فأضحوا وما في راحة الموت مرغب % لحي ولا في لذة العيش مزهد % 472(@)(@@) % ليحلل ذراه من تلدد حائرا % فما في ذراه 
ms325	 حائر يتلدد % 473(@)(@@) % وطاغ عهدنا أمره وهو حادث % جليل فأمسى أمره وهو معهد % 474(@)(@@) % تمادت به الطغوى ولم يدر أنه % % يسوغ أكالا له ثم يزرد % 475(@)(@@) % فصادف قتال الطغاة بمرصد % قريب وهل يخلو من الله مرصد % % 476(@)(@@) % أتيح له من ذي الغناءين صاعد % مصاع ومكر أعجمي مولد % 477(@)(@@) % فعجمته كتمانه أين عهده % وتوليده عرفانه أين يعمد % 478(@)(@@) % رماه بحول لا يطاق وقوة % ولي بكلتا العدتين مؤيد % 479(@)(@@) % رأى صيده من أفضل الصيد كله % على أنه من شر ما يتصيد % 480(@)(@@) % فبث له تلك الحبائل حازم % من القوم كياد قديما مكيد % PageV01P1210 481(@)(@@) % موفق آراء وزير موفق % يعاضده والركن بالركن يعضد % 482(@)(@@) % إذا ناب عنه في الأمور رأيته % % كلا مشهديه لا يدانيه مشهد % 483(@)(@@) % عطارده ما أخبت الحرب نارها % % ومريخه ما دامت الحرب توقد % 484(@)(@@) % ومن تنقذوه تضمنوا ما يعيشه % % وما تغرسوه لا يزل يتعهد % 484(@)(@@) % وأولى امرئ أن تشملوه بفضلكم % % نقذكم والموت أسود أربد % 484(@)(@@) % وإني لمهد للموفقش شكره % % وشكركم عن كل من يتشهد % % 484(@)(@@) % ومن شكر النعنى عموما فشكره % إذا هي خصته أجم وأحشد % 484(@)(@@) % أراني إذا ما فزت منها بجانب % كأني مخصوص بها متوحد % 484(@)(@@) % وكنت امرأ أوفى الصنيعة شكرها % % وإن كان غيري بالصنيعة يقصد % 484(@)(@@) % وأنتموإن كنتم عممتم بمننكم % فقد خصني من ذاك ما لست أجحد % PageV01P1211 484(@)(@@) % فمن مبلغ عني الأمير الذي به % % رسا الأس وانتص البناء المسند % % 484(@)(@@) % شكرتكم شكر امرئ ذي حشاشة % بكم أصبحت في جسمه تتردد % % 484(@)(@@) % قتلت الذي استحيا النساء واصبحت % وئيدته في البر والبحر توأد % 484(@)(@@) % وآنق من عقد العقيلة جيدها % % وأحسن من سربالها المتجرد % 484(@)(@@) % أظلت سيوف الموت أهل بلاده % فكشفتم أظلالها وهي ركد % % 484(@)(@@) % وعرى لمرضاة الإله مناصلا % غضابا ليس فيهن معضد % 484(@)(@@) % أبا أحمد أبليت أمة حمد % بلاء سيرضاه ابن عمك أحمد % 484(@)(@@) % حقنت دماء العقر والعقر بعدما % % هريقت حراما والخللون وقد % % 484(@)(@@) % وأمنت ليل الخائفين فهاجد % وشاكر نعمى قائمق يتهجد % % 484(@)(@@) % بك ارتجع الإسلام بعد ذهابه % وعاد منار الدين 
ms326	 وهو مشيد % % PageV01P1212 484(@)(@@) % وقتل أجذال العبادة عنوة % وهم ركع بين السولري وسجد % 484(@)(@@) % ينال اليهود الفاسقون أمنه % ويشقى به قوم إلى الله هود % 484(@)(@@) % حصرت عميد الزنج حتى تخاذلت % قواه وأودى زاده المتزود % 484(@)(@@) % فظلولم تقتلهيلفظ نفسه % وظلولم تأسرهوهو مقيد % 484(@)(@@) % وكانت نواحيه كثافا تزل % % تحيفها سحتا كأنك مبرد % 484(@)(@@) % ولكنه يرنو إلى ما لبستم % وما تحته أسى وأعلى وأمجد % 484(@)(@@) % وإن تكفروا فالله شاكر سعيه % % على الكافريهوالنبي محمد % 484(@)(@@) % ليشكر بنو الإسلام نعمة صاعد % بل الناس طرا قوله لا تفنند % 484(@)(@@) % يصول على أعدائه كل صولة % % يضيق لها منهم مقام ومقعد % % 484(@)(@@) % فطورا بأقلام تجرد للحبا % % وطورا بأسياف حداد تخرد % PageV01P1213 484(@)(@@) % إذا ما اجتبى مالا فمالا أحاله % قتالا وزلزالا لمن يتمرد % 484(@)(@@) % وما مذحج إذ كان منهابمعزل % عن الحمد ما لم يجحد الحق جحد % 484(@)(@@) % وإني على رغم الأعادي لقائل % وإن أبرقوا لي بالوعيد وأرعدوا % % 484(@)(@@) % ولو قاس باستيجابكم ما منحتم % لأطفأ نارا في حشاه توقد % 484(@)(@@) % لاطفأ نارا قد تعالى شوظها % % وأوقد نورا كاد لولاه يخمد % 484(@)(@@) % أمذحج أحسنت النضال فأبشري % % بشكرك عند الله والقرض يشكد % 484(@)(@@) % لئن نصر الأنصار بدءا نبيهم % لقد عدتم بالنصر والعود أحمد % 484(@)(@@) % وأنتم وهم فرعان صنوان تلتقي % % مناسبكم في منصب لا يزهد % 484(@)(@@) % يمانون ميمونو النقائب فيكم % مناصحة صرف لمن يتمعدد % 484(@)(@@) % حماة وكتاب تسوس أكفكم رماحا % وأقلاما بها الملك يعمد % PageV01P1214 484(@)(@@) % معربة أقلامكم نبتت لكم % بحيث التقى طلح وضال وغرقد % 484(@)(@@) % لذلك آختها الرماح فأصبحت % تقوم في أيديكم وتأود % 484(@)(@@) % إذا ما سلكتم في الصدور صدورها % % تقصد فيها عن دماء تفصد % 484(@)(@@) % فأهون عليكم في المعالي ونيلها % % هناك بما يدمى وما يتقصد % 484(@)(@@) % ولم تسلكوا فيما أتيتم مضلة % ولكن لكم فيه طريق معبد % 484(@)(@@) % وما نلتم أن جددتم % ولكن جددتم والمضيعون سمد % 484(@)(@@) % أرى من تعاطى ما بلغتم كرائم % % منال الثريا وهو أكمه مقعد % 484(@)(@@) % وضد لكم لا زال يسفل جده % ولا برحت أنفاسه تتصعد % 484(@)(@@) % يرى زبرج الدنيا يرف عليكم 
ms327	 % ويغضي عن استحقاقكم فهو يفأد % 484(@)(@@) % تدبرنا منكم نجوم ثواقب % تبهرم في تدبيرها وتعطرد % PageV01P1215 485(@)(@@) % تفرق عنه المكائد جنده % وتزدادهم جندا وجيشك محصد % 486(@)(@@) % ولو كنت لم تزدهم وقتلتهم % لكان له في قتلهم متبرد % 487(@)(@@) % ولكن بغى حتى نصرت فلم تكن % تنقصه إلاوأنت تزيد % 488(@)(@@) % ولابس سيف القرن عند استلابه % أخر له من كاسريه وأكيد % 489(@)(@@) % وما زلت قدما تشفع الكيد للعدا % % بكيد ومن اللقاء ربك تنجد % 490(@)(@@) % نزلت به تأبى القرى غير نفسه % % وذاك قرى من مثله لك معتد % 491(@)(@@) % بأرعن لو يرمى به عرض يذبل % لأصبح مرسى صخره وهو جدجد % 492(@)(@@) % إذا اجتاز بحرا كاد ينزح ماؤه % وإن ضاف برا كادت الأرض تجرد % 493(@)(@@) % فما رمته حتى الستقل برأسه % % مكان قناة الظهر أسمر وأجود % % 494(@)(@@) % تطير عليه لحية منه أصبحت % له راية يهدي بها الجيش مطرد % PageV01P1216 495(@)(@@) % تراه عيون الناظرين ودونه % % حجاب وباب من جهنم مؤصد % 496(@)(@@) % يسير له في الدهم رأس معطن % وجثمانه بالقاع شلو مقدد % 497(@)(@@) % مناك له في مقداره فكأنما % % تقوض ثهلان عليه وصندد % 498(@)(@@) % ولم تأل إنذارا له غير أنه % % رأى أن متن البحر صرح ممرد % 499(@)(@@) % حدوت به نحو النجاة كأنما % % محجتها البيضاء سحل ممدد % 500(@)(@@) % فلما أيى إلا البوار شللته % إلى النار بئس المورد المتورد % 501(@)(@@) % سكنت سكونا كان رهنا بعدوة % عماس كذاك الليث للوثب يلبد % 502(@)(@@) % وحامى أبو العباس في كل موطن % على يومه ثوب من الشر مجسد % 503(@)(@@) % محاماة مقدام حيود عن الهوى % % ولكنه عن جانب العار أحيد % 504(@)(@@) % وما شبل ذاك الليث إلا شبيهه % وغير عجيب أن ترى الشبل يأسد % PageV01P1217 505(@)(@@) % وما بئس عون المرء كان ابن مخلد % نصيحك والأعداء نحوك صمد % 506(@)(@@) % مضى لك إذ كل الحديد من الظبا % % وحاطك إذ رث النسيج المسرد % 507(@)(@@) % وهت كل درع فانثنى كل منصل % سوى صاعد والموت للموت ينهد % 508(@)(@@) % فلا يبعد الرأي الذي اخترته به % وقربته بل من أبى ذاك يبعد % 509(@)(@@) % أما لئن استبطنته دون من دنت % إليك بهالقربى 
ms328	 وهنبث حسد % 510(@)(@@) % لكم داخل بين الخصيمين مصلح % % كما انغل بين العين والجفن مرود % 511(@)(@@) % ترى العين والملمول يبطن جفنها % % إذا ما غدا إنسانها وهو أرمد % 512(@)(@@) % تشكى فلا يجدي عليها لصيقها % % فتدني الذييجدي وقرباه أبعد % 513(@)(@@) % وما زلت مفتوحا عليك بصاعد % تفوز وتستعلي وتحظى وتسعد % 514(@)(@@) % بتدبيره طورا وطورا بيمنه % % وما قاده التدبير فاليمن أقود % PageV01P1218 515(@)(@@) % فمن يمنه إن غاب عنك مديدة % فنالك دون الدرع أزرق مصرد % 516(@)(@@) % فلما أراك الله غرة وجهه % تراءى لك السعد الذي كنت تعهد % 517(@)(@@) % برأت به من كل ما أنت ضامن % وأنت لشروى تلك منه معود % 518(@)(@@) % وبدلت من قرح بقتح مسير % بأمثاله غاظ الحسود المحسد % 519(@)(@@) % ألا ذلك الفتح المبين هناؤه % % فتم ولاقاه يزيد ومزيد % 520(@)(@@) % ومن يمنه أن دمر العبد وابنه % وملاح قن فالثلاثة همد % 521(@)(@@) % وأتبع أهل الفسق من أوليائه % % فوافاه والباقون فل مشرد % 522(@)(@@) % كأني بهم قد قيل عند بوارهم % % رعوا ظمأهم حتى إذا تم أوردوا % % 523(@)(@@) % زروع سقاها الله ريا فأثمرت % % عتيا فأضحت وهي للنار تحصد % 524(@)(@@) % يقول مقالي في نصيحك من مشى % % ويقدمهم في ذاكمن يتبغدد % PageV01P1219 525(@)(@@) % وما قيل فيه من مديح فإنه % % مديحك والنيات نحوك عمد % 526(@)(@@) % إذا ما الأعادي حاولت كيد صاعد % غدا يتعالى والأعادي توهد % 527(@)(@@) % وحارب عن نعمائه ريب دهره % % من البر والمعروف جند مجند % 528(@)(@@) % وأهل لذاك المذحجي ابن مخلد % مع الخلد لو أن ابن آدم مخلد % 529(@)(@@) % حلفت بمن حلاه كل فضيلة % % بأمثالها ساد المسود المسود % 530(@)(@@) % لقد نال منهاة العلاء وإنه % % بأن ابنه مثل العلاء لأسعد % 531(@)(@@) % ألا ذلك الفوز الذي لا إخاله % % على غيره من سائر القوم يحشد % 532(@)(@@) % فتى الدين والدنيا الذي أذعنا له % % ففي خنصر منه لصعبين مقود % 533(@)(@@) % هو التاج والإكليل في كل محفل % بل السيف سيف الدولة المتقلد % 534(@)(@@) % يزين ويحمي وهو في السلم زينة % لمن يرتديه وهو في الحرب مزود % PageV01P1220 535(@)(@@) % وليس بأن يلقى ولكن بأن يرى % % بآرائه اللاقون والهام تجلد % 536(@)(@@) % تراه عن 
ms329	 الحرب العوان بمعزل % وآثاره فيهاوإن غاب شهد % 537(@)(@@) % كما احتجب المقدار والحكم حكمه % على الناس طرا ليس عنه معرد % 538(@)(@@) % إذا ما نبا سيف فلاحظ رأيه % فموقعه ممن توخى ممهد % 539(@)(@@) % فتى روحه ضوء بسيط كيانه % ومسكن تلك الروح نور مجسد % 540(@)(@@) % صفا ونفى عنه القذى فكأنه % إذا ما استشفه العقول مصعد % 541(@)(@@) % فتى هاجر الدنيا وحرم ريقها % % وهل ريقها إلا الرحيق المورد % 542(@)(@@) % ولو طمعت في عطفه ووصاله % أباحته منها مرشفا لا يصرد % 543(@)(@@) % أباها وقد عنت له من بناتهام أبين ضلوعي جمرة تتوقد % على ما مضى أم حسرة تتجدد % 544(@)(@@) % خليلي ما بعد الشباب رزية % يجم لها ماء الشؤون ويعتد % PageV01P1221 545(@)(@@) % فلا تلحيا إن فاض دمع لفقده % % فقل له بحر من الدمع يثمد % 546(@)(@@) % ولا تعجبا للجلد يبكي فربما % % تفطر عن عين من الماء جلمد % 547(@)(@@) % شباب الفتى مجلوده وعزاؤه % % فكيف وأنى بعده يتجلد % 548(@)(@@) % وفقد الشباب الموت يوجد طعمه % صراحا وطعم الموت بالموت يفقد % 549(@)(@@) % رزئت شبابي عودة بعد بدأة % وهن الرزايا بادئات وعود % 550(@)(@@) % سلبت سواد العارضين وقبله % بياضهما المحمود إذ أنا أمرد % 551(@)(@@) % وبدلت من ذاك البياض وحسنه % % بياضا ذميما لا يزال يسود % % 552(@)(@@) % لشتان ما بين البياضين معجب % أنيق ومشنوء إلى العين أنكد % 553(@)(@@) % تضاحك في أفنان رأسي ولحيتي % % وأقبح ضحاكين شيب وأدرد % 554(@)(@@) % وكنت جلاء للعيون من القذى % % فقد جعلت تقذي بشيبي وترقد % PageV01P1222 555(@)(@@) % هي الأعين النجل التي كنت تشتكي % % مواقعها في القلب والرأس أسود % 556(@)(@@) % فما لك تأسى الآن لما رأيتها % % وقد جعلت مرمى سواك تعمد % 557(@)(@@) % تشكى إذا ما أقصدتك سهامها % % وتأسى إذا نكبن عنك وتكمد % 558(@)(@@) % كذلك تلك النبل من وقعت به % % ومن صرفت عنه من القوم مقصد % 559(@)(@@) % إذا عدلت عنا وجدنا عدولها % % كموقعها في القلب بل هو أجهد % 560(@)(@@) % تنكب عنا مرة فكأنما % % منكبها عنا إلينا مسدد % 561(@)(@@) % كفى حزنا أن الشباب معجل % قصير الليالي والمشيب مخلد % 562(@)(@@) % إذا حل جارى المرء شأو حياته % % إلى أن يضم المرء 
ms330	 والشيب ملحد % 563(@)(@@) % أرى الدهر أجرى ليله ونهاره % % بعدل فلا هذا ولا ذاك سرمد % 564(@)(@@) % وجار على ليل الشباب فضامه % نهار مشيب سرمد ليس ينفد % PageV01P1223 565(@)(@@) % وعزاك عن ليل الشباب معاشر % فقالوا نهار الشيب أهدى وأرشد % 566(@)(@@) % وكان نهار المرء أهدى لسعيه % % ولكن ظل الليل أندى وأبرد % 567(@)(@@) % أأيام لهوي هل مواضيك عود % وهل لشباب ضل بالأمس منشد % 568(@)(@@) % أقول وقد شابت شواتي وقوست % قناتي وأضحت كدنتي تتخدد % 569(@)(@@) % ودب كلال في عظامي أدبني % % جنيب العصا أنأد أو أتأيد % 570(@)(@@) % وبورك طرفي فالشخاص حياله % % قرائن من أدنى مدى وهي فرد % 571(@)(@@) % ولذت أحاديثي الرجال وأعرضت % سليمى وريا عن حديثي ومهدد % 572(@)(@@) % وبدل إعجاب الغواني تعجبا % فهن روان يعتبرن وصدد % 573(@)(@@) % لما تؤذن الدنيا به من صروفها % % يكون بكاء الطفل ساعة يولد % 574(@)(@@) % وإلا فما يبكيه منها وإنها % % لأفسح مما كان فيه وأرغد % PageV01P1224 575(@)(@@) % إذا أبصر الدنيا استهل كأنه % % بما سوف يلقى من أذاها يهدد % 576(@)(@@) % وللنفس أحوال تظل كأنها % % تشاهد فيها كل غيب سيشهد % 577(@)(@@) % رزحت على مر الليالي وكرها % % وهل عن فناء من فناءين عندد % 578(@)(@@) % محار الفتى شيخوخة أو منية % ومرجوع وهاج المصابيح رمدد % 579(@)(@@) % وقد أغتدي للوحش والوحش هجد % ولو نذرت بي لم تبت وهي هجد % 580(@)(@@) % فيشقى بي الثور القصي مكانه % بحيث يراعيه الأصل الخفيدد % 581(@)(@@) % ترى كل ركاع على مرتع % % يخر لرمحي ساجدا بل يسجد % 582(@)(@@) % إذا غازلته بالصريم نعاجه % % كما غازلت زيرا أوانس خرد % 583(@)(@@) % أمرت به رمحا غيورا فخاضه % ذليقا كما شك النقيلة مسرد % 584(@)(@@) % فخر لروقيه صريعا تخاله % يعصفر من تاموره أو يفرصد % PageV01P1225 585(@)(@@) % كأن سناني حين وافاه كوكب % أصيب به قطع من المزن أقهد % 586(@)(@@) % وقد أشرب الكأس الغريض مزاجها % % على ما تغناه الغريض ومعبد % 587(@)(@@) % يطوف بها للشرب أبيض مخطف % يجود له بالراح أسود أكبد % 588(@)(@@) % بمولية خضراء ينغم وسطها % % ويهدل في أرجائها ويهدهد % 589(@)(@@) % إذا شئت راقت ناظري نظائر % % بمصطبحي والأدم حولي رود % 590(@)(@@) % وصيف وإبريق ودوم ومرشق % على 
ms331	 شرف كل الثلاثة أجيد % 591(@)(@@) % وأنجب ما ولدت منه مسرة % إذا ما بنات الصدر ظلت تولد % 592(@)(@@) % حديث نتاج من بني المزن أمه % معنسة مما تعتق صرخد % 593(@)(@@) % وبيضاء يخبو درها من بياضها % % ويذكو له ياقوتها والزبرجد % 594(@)(@@) % لها سنة كالشمس تبرز تارة % % وطورا يواريها صبير منضد % PageV01P1226 595(@)(@@) % إذا ما التقى السكران سكرا شبابها % % وأكوابها كادت من اللين تعقد % 596(@)(@@) % لهوت بها ليلا قصيرا طويله % % ومالي إلا كفها متوسد % 597(@)(@@) % وكم مثلها من ظبية قد تفيأت % ظلالي وأغصان الشبيبة ميد % 598(@)(@@) % لعبت بأولى الدهر فاغتال شرتي % % بأخرى حقود والجرائم تحقد % 599(@)(@@) % فصبرا على ما اشتد منه فإنما % % يقوم لما يشتد من يتشدد % 600(@)(@@) % وما الدهر إلا كابنه فيه بكرة % وهاجرة مسمومة الجو صيخد % 601(@)(@@) % تذيق الفتى طورى رخاء وشدة % % حوادثه والحول بالحول يطرد % 602(@)(@@) % وعزى أناسا أن كل حديقة % وإن أغدفت أفنانها ستخضد % 603(@)(@@) % ومالي عزاء عن شبابي علمته % % سوى أنني من بعده لا أخلد % 604(@)(@@) % وأن مشيبي واعد بلحاقه % % وإن قال قوم إنه يتوعد % PageV01P1227 605(@)(@@) % على أن في المأمول من فضل صاعد % % عزاء جميلا بل شبابا يجدد % 606(@)(@@) % ستظهر نعماه علي فأغتدي % % وغصن شبابي لين المتن أغيد % 607(@)(@@) % وتصطاد لي جدواه ما كنت صائدا % بشرخ الشباب الغض بل هي أصيد % 608(@)(@@) % وأفضل ما صيدت به العين كالدمى % % مهور وأثمان من العين تنقد % 609(@)(@@) % وهل يستوي رام مراميه لحظه % ورام مراميه لجين وعسجد % 610(@)(@@) % وما أملي في المذحجي بمنته % ولكنه كالشيء بلت به اليد % 611(@)(@@) % إلى أين بي عن صاعد وانتجاعه % وقد راده الرواد قبلي فأحمدوا % % 612(@)(@@) % ولي بأبي عيسى إليه وسيلة % يفك بها أصفاد عان ويصفد % 613(@)(@@) % ومالي لا أغدو وهذان معمدي % % وما لهما إلا العوارف معمد % 614(@)(@@) % لعمري لئن أضحت وزارة صاعد % % تثنى لقد أضحى كريما يوحد % PageV01P1228 615(@)(@@) % وزارته شفع وذاك بحقه % كما أنه وتر إذا عد سؤدد % 616(@)(@@) % هو الرجل المشروك في جل ماله % ولكنه بالخير والحمد مفرد % 617(@)(@@) % يقرض إلا أن ما قيل دونه % % ويوصف إلا 
ms332	 أنه لا يحدد % 618(@)(@@) % أرق من الماء الذي في حسامه % % طباعا وأمضى من شباه وأنجد % 619(@)(@@) % وأجدى وأندى بطن كف من الحيا % % وآبى إباء من صفاة وأجمد % 620(@)(@@) % وأبهر نورا للعيون من التي % % تضاهيه في العلياء حين تكبد % 621(@)(@@) % وأوقر من رضوى ولو شاء نسفها % % إذن لم يلقها طرفة العين مركد % 622(@)(@@) % طويل التأني لا العجول ولا الذي % % إذا طرقته نوبة يتبلد % 623(@)(@@) % له سورة مكتنة في سكينة % كما اكتن في الغمد الجراز المهند % 624(@)(@@) % إذا شامها قرت قلوب مقرها % % وإن سل منها فالفرائض ترعد % PageV01P1229 625(@)(@@) % يلاقي العدا والأولياء ابن مخلد % لقاء امرىء في الله يرضى ويعبد % 626(@)(@@) % بجهل كجهل السيف والسيف منتضى % وحلم كحلم السيف والسيف مغمد % 627(@)(@@) % وليس بجهل الأغبياء ذوي العمى % % ولكنه جهل به الله يعبد % 628(@)(@@) % عرام زعيم بالهدى أو فبالردى % % إذا ما اعتدى قوم عن القصد عند % 629(@)(@@) % قرى من ملي بالقرى حين يبتغى % % كلا نزليه اللذ والكره محمد % 630(@)(@@) % عتيد لديه الخير والشر لامرىء % بغى أو بغى خيرا وللخير أعتد % 631(@)(@@) % صموت بلا عي له من بلائه % % نواطق تستدعي الرجاء وتزأد % 632(@)(@@) % كفى الوعد والإبعاد بالقول نفسه % بأفعاله والفعل للفعل أشهد % 633(@)(@@) % إذا اقتفرت آثاره فعدوه % ومولاه موعود هناك وموعد % 634(@)(@@) % عزيز غدا فوق التودد عزه % وإحسانه في ظله يتودد % PageV01P1230 635(@)(@@) % يغض عن السؤال من طرف عينه % % لكيلا يرى الأحرار كيف تعبد % 636(@)(@@) % ويطرق إطراق الذليل وإنه % % هناك لسامي ناظر العين أصيد % 637(@)(@@) % إذا من لم يمنن بمن يمنه % وقال لنفسي أيها الناس أمهد % 638(@)(@@) % وكل امتنان لا يمن فإنه % % أخف مناطا في الرقاب وأوكد % 639(@)(@@) % تجاوز أن يستأنف المجد بالندى % % وفي كل ما استرفدته فهو أجود % 640(@)(@@) % ومن لم يزد في مجده بذل ماله % وجاد به فهو الجواد المقلد % 641(@)(@@) % ترى نائلا من نائل ثم ينتهي % % إلى صاعد إسناده حين يسند % 642(@)(@@) % كأن أباه يوم سماه صاعدا % رأى كيف يرقى في المعالي ويصعد % 643(@)(@@) % جرى وجرى الأكفاء شأوا ولم يزل % % منازعه الطولى يضام 
ms333	 ويضهد % 644(@)(@@) % فلما تناهى من يباريه في العلا % % تمادى يباري أمسه اليوم والغد % PageV01P1231 645(@)(@@) % جواد ثنى غرب الجياد بغربه % وظل يجاري ظله وهو أوحد % 646(@)(@@) % وما أغرق المداح إلا غلابه % وراء مغالي مدحهم فيه مخلد % 647(@)(@@) % وأسلاف صدق من عرانين مذحج % طوال المساعي ليس فيهم مزند % % 648(@)(@@) % بنوا مجده في هضبة مذحجية % ذؤابتها بين الفراقد فرقد % 649(@)(@@) % أولئك أوعال المعالي مسهل % لهم مرتقى في الوعر منها ومصعد % 650(@)(@@) % ألم تر زلفى صاعد عند ربه % % بلى قد رأى الساهي ومن يتفقد % 651(@)(@@) % بدت قبلة الدنيا وللنكر فوقها % % ظلال وثدي العرف فيها مجدد % 652(@)(@@) % فلما تولى الأمر نكر منكر % وعرف معروف وأصلح مفسد % 653(@)(@@) % وأصبح شمل الناس وهو مؤلف % % وعهدي بشمل الناس وهو مبدد % 654(@)(@@) % حماهم وأفشى العرف فيهم فكلهم % من الشر ممنوع من الخير ممجد % PageV01P1232 655(@)(@@) % إذا أحسنوا جوزوا جزاء مضاعفا % وما اقترفوا من سيىء متعمد % 656(@)(@@) % ولما التقى خصب المراد وأمنه % تيقظ مسبوت ونام مسهد % 657(@)(@@) % فلم يمتنع مرعى على متعيش % ولم ينقطع شرب ولم ينب مرقد % 658(@)(@@) % فأضحوا وما في راحة الموت مرغب % لحي ولا في لذة العيش مزهد % 659(@)(@@) % ليحلل ذراه من تلدد حائرا % فما في ذراه حائر يتلدد % 660(@)(@@) % وطاغ عهدنا أمره وهو حادث % جليل فأمسى أمره وهو معهد % 661(@)(@@) % تمادت به الطغوى ولم يدر أنه % % يسوغ أكالا له ثم يزرد % 662(@)(@@) % فصادف قتال الطغاة بمرصد % قريب وهل يخلو من الله مرصد % % 663(@)(@@) % أتيح له من ذي الغناءين صاعد % مصاع ومكر أعجمي مولد % 664(@)(@@) % فعجمته كتمانه أين عهده % وتوليده عرفانه أين يعمد % PageV01P1233 665(@)(@@) % رماه بحول لا يطاق وقوة % ولي بكلتا العدتين مؤيد % 666(@)(@@) % رأى صيده من أفضل الصيد كله % على أنه من شر ما يتصيد % 667(@)(@@) % فبث له تلك الحبائل حازم % من القوم كياد قديما مكيد % 668(@)(@@) % موفق آراء وزير موفق % يعاضده والركن بالركن يعضد % 669(@)(@@) % إذا ناب عنه في الأمور رأيته % % كلا مشهديه لا يدانيه مشهد % 670(@)(@@) % عطارده ما أخبت الحرب نارها % % ومريخه ما دامت الحرب 
ms334	 توقد % 671(@)(@@) % ولكنه يرنو إلى ما لبستم % وما تحته أسى وأعلى وأمجد % 671(@)(@@) % وأولى امرئ أن تشملوه بفضلكم % % نقذكم والموت أسود أربد % 671(@)(@@) % ومن شكر النعنى عموما فشكره % إذا هي خصته أجم وأحشد % 671(@)(@@) % أراني إذا ما فزت منها بجانب % كأني مخصوص بها متوحد % PageV01P1234 671(@)(@@) % وكنت امرأ أوفى الصنيعة شكرها % % وإن كان غيري بالصنيعة يقصد % 671(@)(@@) % وأنتموإن كنتم عممتم بمننكم % فقد خصني من ذاك ما لست أجحد % 671(@)(@@) % شكرتكم شكر امرئ ذي حشاشة % بكم أصبحت في جسمه تتردد % % 671(@)(@@) % وآنق من عقد العقيلة جيدها % % وأحسن من سربالها المتجرد % 671(@)(@@) % فظلولم تقتلهيلفظ نفسه % وظلولم تأسرهوهو مقيد % 671(@)(@@) % ومن تنقذوه تضمنوا ما يعيشه % % وما تغرسوه لا يزل يتعهد % 671(@)(@@) % أظلت سيوف الموت أهل بلاده % فكشفتم أظلالها وهي ركد % % 671(@)(@@) % وإني لمهد للموفقش شكره % % وشكركم عن كل من يتشهد % % 671(@)(@@) % فمن مبلغ عني الأمير الذي به % % رسا الأس وانتص البناء المسند % % 671(@)(@@) % وعرى لمرضاة الإله مناصلا % غضابا ليس فيهن معضد % PageV01P1235 671(@)(@@) % أبا أحمد أبليت أمة حمد % بلاء سيرضاه ابن عمك أحمد % 671(@)(@@) % حقنت دماء العقر والعقر بعدما % % هريقت حراما والخللون وقد % % 671(@)(@@) % وأمنت ليل الخائفين فهاجد % وشاكر نعمى قائمق يتهجد % % 671(@)(@@) % بك ارتجع الإسلام بعد ذهابه % وعاد منار الدين وهو مشيد % % 671(@)(@@) % قتلت الذي استحيا النساء واصبحت % وئيدته في البر والبحر توأد % 671(@)(@@) % وقتل أجذال العبادة عنوة % وهم ركع بين السولري وسجد % 671(@)(@@) % حصرت عميد الزنج حتى تخاذلت % قواه وأودى زاده المتزود % 671(@)(@@) % ولو قاس باستيجابكم ما منحتم % لأطفأ نارا في حشاه توقد % 671(@)(@@) % ينال اليهود الفاسقون أمنه % ويشقى به قوم إلى الله هود % 671(@)(@@) % وما مذحج إذ كان منهابمعزل % عن الحمد ما لم يجحد الحق جحد % PageV01P1236 671(@)(@@) % وكانت نواحيه كثافا تزل % % تحيفها سحتا كأنك مبرد % 671(@)(@@) % يصول على أعدائه كل صولة % % يضيق لها منهم مقام ومقعد % 671(@)(@@) % فطورا بأقلام تجرد للحبا % % وطورا بأسياف حداد تخرد % 671(@)(@@) % إذا ما اجتبى مالا فمالا أحاله % قتالا وزلزالا لمن يتمرد % 671(@)(@@) % وإني على رغم الأعادي لقائل 
ms335	 % وإن أبرقوا لي بالوعيد وأرعدوا % % 671(@)(@@) % ليشكر بنو الإسلام نعمة صاعد % بل الناس طرا قوله لا تفنند % 671(@)(@@) % يرى زبرج الدنيا يرف عليكم % ويغضي عن استحقاقكم فهو يفأد % 671(@)(@@) % لاطفأ نارا قد تعالى شوظها % % وأوقد نورا كاد لولاه يخمد % 671(@)(@@) % أمذحج أحسنت النضال فأبشري % % بشكرك عند الله والقرض يشكد % 671(@)(@@) % لئن نصر الأنصار بدءا نبيهم % لقد عدتم بالنصر والعود أحمد % PageV01P1237 671(@)(@@) % وأنتم وهم فرعان صنوان تلتقي % % مناسبكم في منصب لا يزهد % 671(@)(@@) % وما نلتم أن جددتم % ولكن جددتم والمضيعون سمد % 671(@)(@@) % وإن تكفروا فالله شاكر سعيه % % على الكافريهوالنبي محمد % 671(@)(@@) % أرى من تعاطى ما بلغتم كرائم % % منال الثريا وهو أكمه مقعد % 671(@)(@@) % يمانون ميمونو النقائب فيكم % مناصحة صرف لمن يتمعدد % 671(@)(@@) % ولم تسلكوا فيما أتيتم مضلة % ولكن لكم فيه طريق معبد % 671(@)(@@) % فأهون عليكم في المعالي ونيلها % % هناك بما يدمى وما يتقصد % 671(@)(@@) % إذا ما سلكتم في الصدور صدورها % % تقصد فيها عن دماء تفصد % 671(@)(@@) % لذلك آختها الرماح فأصبحت % تقوم في أيديكم وتأود % 671(@)(@@) % معربة أقلامكم نبتت لكم % بحيث التقى طلح وضال وغرقد % PageV01P1238 671(@)(@@) % حماة وكتاب تسوس أكفكم رماحا % وأقلاما بها الملك يعمد % 671(@)(@@) % تدبرنا منكم نجوم ثواقب % تبهرم في تدبيرها وتعطرد % 671(@)(@@) % وضد لكم لا زال يسفل جده % ولا برحت أنفاسه تتصعد % 672(@)(@@) % تفرق عنه بالمكائد جنده % وتزدادهم جندا وجيشك محصد % 673(@)(@@) % ولو كنت لم تزدهم وقتلتهم % لكان له في قتلهم متبرد % 674(@)(@@) % ولكن بغى حتى نصرت فلم تكن % تنقصه إلاوأنت تزيد % 675(@)(@@) % ولابس سيف القرن عند استلابه % أخر له من كاسريه وأكيد % 676(@)(@@) % وما زلت قدما تشفع الكيد للعدا % % بكيد ومن اللقاء ربك تنجد % 677(@)(@@) % نزلت به تأبى القرى غير نفسه % % وذاك قرى من مثله لك معتد % 678(@)(@@) % بأرعن لو يرمى به عرض يذبل % لأصبح مرسى صخره وهو جدجد % PageV01P1239 679(@)(@@) % إذا اجتاز بحرا كاد ينزح ماؤه % وإن ضاف برا كادت الأرض تجرد % 680(@)(@@) % فما رمته حتى استقل برأسه % % مكان قناة الظهر أسمر أجرد % % 681(@)(@@) % تطير عليه لحية منه 
ms336	 أصبحت % له راية يهدي بها الجيش مطرد % 682(@)(@@) % تراه عيون الناظرين ودونه % % حجاب وباب من جهنم مؤصد % 683(@)(@@) % يسير له في الدهم رأس معطن % وجثمانه بالقاع شلو مقدد % 684(@)(@@) % مناك له في مقداره فكأنما % % تقوض ثهلان عليه وصندد % 685(@)(@@) % ولم تأل إنذارا له غير أنه % % رأى أن متن البحر صرح ممرد % 686(@)(@@) % حدوت به نحو النجاة كأنما % % محجتها البيضاء سحل ممدد % 687(@)(@@) % فلما أيى إلا البوار شللته % إلى النار بئس المورد المتورد % 688(@)(@@) % سكنت سكونا كان رهنا بعدوة % عماس كذاك الليث للوثب يلبد % PageV01P1240 689(@)(@@) % وحامى أبو العباس في كل موطن % على يومه ثوب من الشر مجسد % 690(@)(@@) % محاماة مقدام حيود عن الهوى % % ولكنه عن جانب العار أحيد % 691(@)(@@) % وما شبل ذاك الليث إلا شبيهه % وغير عجيب أن ترى الشبل يأسد % 692(@)(@@) % وما بئس عون المرء كان ابن مخلد % نصيحك والأعداء نحوك صمد % 693(@)(@@) % مضى لك إذ كل الحديد من الظبا % % وحاطك إذ رث النسيج المسرد % 694(@)(@@) % وهت كل درع فانثنى كل منصل % سوى صاعد والموت للموت ينهد % 695(@)(@@) % فلا يبعد الرأي الذي اخترته به % وقربته بل من أبى ذاك يبعد % 696(@)(@@) % أما لئن استبطنته دون من دنت % إليك بهالقربى وهنبث حسد % 697(@)(@@) % لكم داخل بين الخصيمين مصلح % % كما انغل بين العين والجفن مرود % 698(@)(@@) % ترى العين والملمول يبطن جفنها % % إذا ما غدا إنسانها وهو أرمد % PageV01P1241 699(@)(@@) % تشكى فلا يجدي عليها لصيقها % % فتدني الذييجدي وقرباه أبعد % 700(@)(@@) % وما زلت مفتوحا عليك بصاعد % تفوز وتستعلي وتحظى وتسعد % 701(@)(@@) % بتدبيره طورا وطورا بيمنه % % وما قاده التدبير فاليمن أقود % 702(@)(@@) % فمن يمنه إن غاب عنك مديدة % فنالك دون الدرع أزرق مصرد % 703(@)(@@) % فلما أراك الله غرة وجهه % تراءى لك السعد الذي كنت تعهد % 704(@)(@@) % برأت به من كل ما أنت ضامن % وأنت لشروى تلك منه معود % 705(@)(@@) % وبدلت من قرح بقتح مسير % بأمثاله غاظ الحسود المحسد % 706(@)(@@) % ألا ذلك الفتح المبين هناؤه % % فتم ولاقاه يزيد ومزيد % 707(@)(@@) % ومن يمنه أن دمر العبد وابنه % وملاح 
ms337	 قن فالثلاثة همد % 708(@)(@@) % وأتبع أهل الفسق من أوليائه % % فوافاه والباقون فل مشرد % PageV01P1242 709(@)(@@) % كأني بهم قد قيل عند بوارهم % % رعوا ظمأهم حتى إذا تم أوردوا % % 710(@)(@@) % زروع سقاها الله ريا فأثمرت % % عتيا فأضحت وهي للنار تحصد % 711(@)(@@) % يقول مقالي في نصيحك من مشى % % ويقدمهم في ذاكمن يتبغدد % 712(@)(@@) % وما قيل فيه من مديح فإنه % % مديحك والنيات نحوك عمد % 713(@)(@@) % إذا ما الأعادي حاولت كيد صاعد % غدا يتعالى والأعادي توهد % 714(@)(@@) % وحارب عن نعمائه ريب دهره % % من البر والمعروف جند مجند % 715(@)(@@) % وأهل لذاك المذحجي ابن مخلد % مع الخلد لو أن ابن آدم مخلد % 716(@)(@@) % حلفت بمن حلاه كل فضيلة % % بأمثالها ساد المسود المسود % 717(@)(@@) % لقد نال منهاة العلاء وإنه % % بأن ابنه مثل العلاء لأسعد % 718(@)(@@) % ألا ذلك الفوز الذي لا إخاله % % على غيره من سائر القوم يحشد % PageV01P1243 719(@)(@@) % فتى الدين والدنيا الذي أذعنا له % % ففي خنصر منه لصعبين مقود % 720(@)(@@) % هو التاج والإكليل في كل محفل % بل السيف سيف الدولة المتقلد % 721(@)(@@) % يزين ويحمي وهو في السلم زينة % لمن يرتديه وهو في الحرب مزود % 722(@)(@@) % وليس بأن يلقى ولكن بأن يرى % % بآرائه اللاقون والهام تجلد % 723(@)(@@) % تراه عن الحرب العوان بمعزل % وآثاره فيهاوإن غاب شهد % 724(@)(@@) % كما احتجب المقدار والحكم حكمه % على الناس طرا ليس عنه معرد % 725(@)(@@) % إذا ما نبا سيف فلاحظ رأيه % فموقعه ممن توخى ممهد % 726(@)(@@) % فتى روحه ضوء بسيط كيانه % ومسكن تلك الروح نور مجسد % 727(@)(@@) % صفا ونفى عنه القذى فكأنه % إذا ما استشفه العقول مصعد % 728(@)(@@) % فتى هاجر الدنيا وحرم ريقها % % وهل ريقها إلا الرحيق المورد % PageV01P1244 729(@)(@@) % ولو طمعت في عطفه ووصاله % أباحته منها مرشفا لا يصرد % 730(@)(@@) % أباها وقد عنت له من بناتهاه % % كواعب يصبين الحليم ونهد % 731(@)(@@) % فما حظه مما حوت غير أنه % % يؤثل فيها الأجر أو يتحمد % 732(@)(@@) % فتى يبدأ العافين بالبذل معفيا % فإن عاد عاف فهو بالبذل أعود % 733(@)(@@) % رجاء مزجيه لديه كوعده % وموعده إياه عهد مؤكد % 734(@)(@@) % فتى لا 
ms338	 هدى إلا مصابيح رأيه % ولا غوث إلا فضله المتعود % 735(@)(@@) % حكيم أقاليم البلاد كريمها % % مسائله يهدى وعافيه يرفد % 736(@)(@@) % وأحسن شيء حكمة أخت نعمة % وكلتاهما تبغى لديه فتوجد % 737(@)(@@) % رآه رضيعا كل ماضي بصيرة % فقالوا جميعا قنة ستطود % 738(@)(@@) % فصدقهم منه لعشر كوامل % خلون له طود به الأرض توتد % PageV01P1245 739(@)(@@) % غدا المجد والتمجيد يكتنفانه % جميعا وكم من ماجد لا يمجد % 740(@)(@@) % أخو حسب ماعده قط فاخرا % على أنه في كل حي معدد % 741(@)(@@) % فمطرف مما تكسب محدث % وآخر قدموس على الدهر متلد % 742(@)(@@) % ولا خير في البنيان غير مشرف % ولا خير في تشريفه أو يوطد % 743(@)(@@) % وماء كفقد الماء أعلاه غرمض % وأسفله للمستميحين حرمد % 744(@)(@@) % وسائره ملح أجاج مرنق % خبيث كريه ورده حين يورد % 745(@)(@@) % سقيت به خوصا حراجيج بعدما % % سقى ماءها التهجير خمس عمرد % 746(@)(@@) % مراسيل ما فيهن إلا نجيبة % مطول إذا ماطلتها السير جلعاد % 747(@)(@@) % أمون على الحاج البعيد مرامه % وإن خان متنيها السديف المسرهد % 748(@)(@@) % من اللائي تزداد اندماجا ومنة % إذا هي أضناها السفار العطود % PageV01P1246 749(@)(@@) % كما جدلت فاستحكمت عند جدلها % % مرائر في أيدي الممرين تمسد % 750(@)(@@) % إذا استكرهت فهي الجنائب أعصفت % % وإن نهنهت فهي النعام المطرد % % 751(@)(@@) % وإن فترت فهي الصوار وراءه % مكاسيب أمثال اليسيب توسد % 752(@)(@@) % وقف يرد الخف يدمى فمروه % بما عل من تلك الدماء مجسد % 753(@)(@@) % عسفت ودو كالسماء قطعته % إذا انجاب منه فدفد عن فدفد % 754(@)(@@) % لألقى أبا عيسى العلاء بن صاعد % أجل فتى يسمى إليه ويوفد % 755(@)(@@) % فيعذب ليملح من العيش آسن % ويسهل لي وعر من الدهر قردد % 756(@)(@@) % بني مخلد أهلا بأيام دهركم % وبعدا لمن يشجى بهاوهو مبعد % 757(@)(@@) % شكى طولها مستثقلو العرف إذ غدت % وفي كلها للعرف عيد معيد % 758(@)(@@) % بكم عمرت أوطان كل مروءة % وقد جعلت تلكالمغاني تأبد % PageV01P1247 759(@)(@@) % لكم كل فياض يبيت لناره % مناد ينادي الحائرينألا اهتدوا % % 760(@)(@@) % إذا ما شتا كادت أنامل كفه % تذوب سماحا والأنامل جمد % 761(@)(@@) % ومنكم أبو عيسى الذي باكر العلا % % ولم يلهه 
ms339	 عيش رفيه ولا دد % 762(@)(@@) % على بحره يروى الظماء ونحوه % يشير إذا ما غص بالماء مزرد % 763(@)(@@) % ألا تلكم النعمى التي ليس شكرها % % سوى منن أضحت لكم تتقلد % 764(@)(@@) % وحاكة شعر أحسنوا المدح فيكم % بما امتثلوا مما فعلتم وجودوا % % 765(@)(@@) % فباعوه منكم بالرغائب نافقا % لديكم هنيئا نقدكم لا ينكد % 766(@)(@@) % ولولا مساعيكم وجود أكفكم % إذا ما أجادوا أو أجادوا وأكسدوا % % 767(@)(@@) % فلا تحمدوا مداحكم إن تغلغلوا % % إلى ممدوح فيكم بل الله فاحمدوا % % 768(@)(@@) % كرمتم فجاش المغجمون بمدحكم % % إذا رجزوا فيكم أثبتم فقصدوا % % PageV01P1248 769(@)(@@) % كما أزهرت جنات عدن وأثمرت % % فأضحت وعجم الطير فيها تغرد % 770(@)(@@) % أذلها أبا عيسى لبوسا فإنها % % ستبقى ويبلى الأتمحي العضد % 771(@)(@@) % وعش عيش محبور بدار إقامة % % وأمثالها سيارة فيك شرد % 772(@)(@@) % وفيها لمن قدمت ذكراه ملبس % تظل به والطرف نحوك أقود % 773(@)(@@) % وكل مديح في امرىء فهو في ابنه % وإن كان موسوما به حين ينشد % 774(@)(@@) % إليك بلا زاد رحلت مؤملا % وقلت لنفسي والركائب وخد % 775(@)(@@) % عتقت من الأطماع يوم لقائه % % ورق ذوي الأطماع رق مؤبد % 776(@)(@@) % وما شافعي إلا سماحك وحده % % ولا وصلتي إلا المديح المجود % 777(@)(@@) % ومن ذا الذي يعفو نداك بشافع % % ويصحبه عند انتجاعك مزود % % 778(@)(@@) % وإن امرءا أضحى رجاؤك زاده % % وإن لم يزود غيره لمزود % PageV01P1249 البحر : - 1(@)(@@) % رددت علي مدحي بعد مطل % وقد دنست ملبسه الجديدا % % 2(@)(@@) % وقلتأمدح به من شئت غيري % % ومن ذا يقبل المديح الرديدا % % 3(@)(@@) % ولا سيما وقد أعمقت فيه % % مخازيك اللواتي لن تبيدا % % 4(@)(@@) % وما للحي في أكفان موت % لبوس بعدما امتلأت صديدا % % PageV01P1250 البحر : - 1(@)(@@) % تحلبت الأنواء بعد جمودها % % وأقبلت الخيرات بعد صدودها % % 2(@)(@@) % بوجه أبي الصقر الذي راح واغتدى % % كشمس الضحى محفوفة بسعودها % % 3(@)(@@) % ولما أتى بغداد بعد قنوطها % % وفترة داعيها وإيباس عودها % % 4(@)(@@) % إذا ظلل قد لوحت ببروقها % % إلى ظلل قد أرجفت برعودها % % 5(@)(@@) % سحائب قيست بالبلاد فألقيت % غطاء على أغوارها ونجودها % % 6(@)(@@) % حدتها النعامى مثقلات فأقبلت % تهادى رويدا سيرها كركودها % % 7(@)(@@) % غيوث رأى الإمحال فيها حمامه 
ms340	 % قرين حياة الأرض بعد همودها % % 8(@)(@@) % أظلت فقل الحرث والنسلهذه % % فتوح سماء أقبلت في سدودها % % 9(@)(@@) % فأطفأ نيران الغليل مواطر % مضرمة نيرانها في وقودها % % 10(@)(@@) % سقتنا ونيران الصدى كبروقها % % فقد بردت أكبادنا ببرودها % % PageV01P1251 11(@)(@@) % ولم نسق إلا بالوزير ويمنه % فبورك في أيامه وعهودها % % 12(@)(@@) % دعا الله لما أغبرت الأرض دعوة % % بأمثالها تغدوا الربى في برودها % % 13(@)(@@) % فكم بركات أذعنت بنزولها % % لدعوته إذ أمعنت في صعودها % % 14(@)(@@) % سما سموة نحو السماء بغرة % % مسومة قدما بسيما سجودها % % 15(@)(@@) % وكفين تستحيي السماء إذا رأت % % رفودهما من ضنها برفودها % % 16(@)(@@) % فلما تلقتها الثلاث رعت لها % % مع الجاه عند الله حرمة جودها % % 17(@)(@@) % فجادت سماء الله جودا غدت له % % عقيم بقاع الأرض مثل ولودها % % 18(@)(@@) % بغاشية من رحمة الله لم ترث % نسياتها إلا كريث نقودها % % 19(@)(@@) % سقتنا ومرعانا فروت وأفضلت % % لدجلة فضلا فاغتدت في مدودها % % 20(@)(@@) % حيا جعلت فيه الحياة فأصبحت % بنات الثرى قد أنشرت من لحودها % % PageV01P1252 21(@)(@@) % فمن مبلغ عنا الأمير رسالة % % فلا برحت نعماك داء حسودها % % 22(@)(@@) % بقيت كما تبقى معاليك إنها % % تبيد الهضاب الشم قبل بيودها % % 23(@)(@@) % رأيناك ترعانا بعين ذكية % أتى الناس طرا نومهم من سهودها % % 24(@)(@@) % هي العين لم توثر كراها ولم يزل % تهجدها أولى بها من هجودها % % 25(@)(@@) % ونعماك في هذا الوزير فإننا % % نعوذ بنعمى ربنا من جحودها % % 26(@)(@@) % وكيف جحود الناس نعماء منعم % تناغى بها أطفالهم في مهودها % % 27(@)(@@) % لعمريلقد قلدته الأمر كافيا % يلذ التي أعيت شفاء لدودها % % 28(@)(@@) % وزير إذا قاد الأمور تتابعت % فأصبح آبيها جنيب مقودها % % 29(@)(@@) % أخو ثقة لو حارب الأسد أذعنت % أو الجن ذلت بعد طول مرودها % % 30(@)(@@) % ملي بأن يغشى الغمار وأن يرى % % مصادرها بالرأي قبل ورودها % % PageV01P1253 31(@)(@@) % وذو طاعة لله في كل حالة % % ومعصية للنفس عند عنودها % % 32(@)(@@) % صدوع بأحكام الكتاب معود % عزائمه التوقيف عند حدودها % % 33(@)(@@) % وهت قبة الإسلام حتى اجتبيته % فقد أصبحت معمودة بعمودها % % 34(@)(@@) % بآرائه أضحت سيوفك تنتضى % % فتغمد من هام العدا في غمودها % % 35(@)(@@) % غدا خير ذي عون 