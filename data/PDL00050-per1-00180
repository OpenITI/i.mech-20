ms171	 بیابان عدم عالم سرابی بیش نیست %~% تشنگان را بهر سود اندر زیان انداخته(@)(@@) 11 ظاهر و باطن تویی و طالب و مطلوب تو %~% و آن دگر نامی است اندر هر زبان انداخته(@)(@@) 12 در محیط هستیت عالم بجز یک موج نیست %~% باد تقدیرت به هر جانب روان انداخته(@)(@@) 13 صد هزاران گوهر معنی و صورت هر نفس %~% موج این دریا به پیدا و نهان انداخته(@)(@@) 14 باز دریای جلالت ناگهان موجی زده %~% جمله را در قعر بحر بی‌کران انداخته(@)(@@) 15 جمله یک چیز است موج و گوهر و دریا ولیک %~% صورت هریک خلافی در میان انداخته(@)(@@) 16 روی خود بنموده هر دم در هزاران آینه %~% در هر آیینه رخت دیگر نشان انداخته(@)(@@) 17 آفتابی در هزاران آبگینه تافته %~% پس به رنگ هریکی تابی عیان انداخته(@)(@@) 18 در همه صورت تویی و نیست خود صورت تو را %~% وین حقیقت حیرتی در رهروان انداخته(@)(@@) 19 جمله یک نور است لیکن رنگ‌های مختلف %~% اختلافی در میان انس و جان انداخته(@)(@@) 20 تا جمال تو نبینند بی‌نقاب انقلاب %~% بر رخ از غیرت ردای جاودان انداخته(@)(@@) 21 یک کرشمه کرده با خود جنبشی عشق قدیم %~% در دو عالم اینهمه شور و فغان انداخته(@)(@@) 22 در گلستان روی خود دیده به چشم بلبلان %~% غلغلی از بلبلان در گلستان انداخته(@)(@@) 23 جنبش عشق قدیم از خود به خود دیده مقیم %~% در میانه تهمتی بر بلبلان انداخته(@)(@@) 24 یک سخن با خویشتن گفته و زان هر ذره را %~% در زبان صد گونه تقدیر و بیان انداخته(@)(@@) 25 آشکارا کرده اسرار تو هم گفتار تو %~% پس بهانه بر زبان ترجمان انداخته(@)(@@) 26 گشته‌ام سرگشته از وصف کمال کبریات %~% ای کمال تو یقین را در گمان انداخته(@)(@@) 27 گرچه از دریای توحید آب حیوان می‌کشم %~% مانده‌ام از تشنگی بر لب زبان انداخته(@)(@@) 28 تهمت دریا کشم خواهم که دریایی شوم %~% کاندرو موجی نباشد هر زمان انداخته(@)(@@) 29 تا عراقی لنگر 
ms172	 من شد دین دریای ژرف %~% کشتی سیر مرا شد بادبان انداخته PageV1P325(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای جلالت فرش عزت جاودان انداخته %~% عکس نورت تابشی بر کن فکان انداخته(@)(@@) 2 نقشبند فطرتت نقش جهان انگیخته %~% بر بساط لامکان شکل مکان انداخته(@)(@@) 3 چیست عالم نیم ذره در فضای کبریات %~% آفتاب قدرتت تابی بر آن انداخته(@)(@@) 4 کیست جان از عکس انوار جمالت تابشی %~% چیست تن خاکی درو آب روان انداخته(@)(@@) 5 تا شود سیراب ز آب معرفت هر دم گیا %~% فیض مهرت قطره‌ای در کشت جان انداخته(@)(@@) 6 کرده عکس روی تو آیینه دل گلشنی %~% بلبل جان غلغلی در گلستان انداخته(@)(@@) 7 یک نظر کرده خروش از عالمی برخاسته %~% یک سخن گفته غریوی در جهان انداخته(@)(@@) 8 ز استماع آن سخن مستان عشقت صبح‌وار %~% جامه پاره کرده و جان در میان انداخته(@)(@@) 9 ز آرزوی قرب تو مرغان قدسی هر نفس %~% های و هوی فتنه‌ای در آشیان انداخته(@)(@@) 10 آفتاب جذبه تو شبنم اشباح را %~% در زمانی از زمین تا آسمان انداخته(@)(@@) 11 تا دهد از تو نشانی بی‌نشان آدمی %~% در مثال ذات تو وصف نشان انداخته(@)(@@) 12 تا به نور روی تو بیند جمال روی تو %~% در دو چشمش نور تو کحل عیان انداخته(@)(@@) 13 برکشیده بهر مشتی خاک ایوان جهان %~% بر بساطش نه سماط و هشت خوان انداخته(@)(@@) 14 باد سلطان جلالت در نوشته فرش کون %~% سنگ بطلان در سرای انس و جان انداخته(@)(@@) 15 در فضای لایزالی کوس قدوسی زده %~% گوی در میدان وحدت جاودان انداخته(@)(@@) 16 نور قدست خرمن چون و چرایی سوخته %~% خنجر وصفت سر وهم و بیان انداخته(@)(@@) 17 کم زند تا لاف توحید تو هر کس غیرتت %~% بر سر دار ملامت ریسمان انداخته(@)(@@) 18 خود که باشد ذره تا دعوی خورشیدی کند %~% هیچ دیدی قطره دریا در دهان انداخته(@)(@@) 19 در حقیقت هستی عالم خیالی بیش نیست %~% وین خیالی چند ما را در گمان انداخته 
ms173	(@)(@@) 20 کی به انوار تو بینم آخر این ذرات را %~% باز در کتم تو آری هم چنان انداخته(@)(@@) 21 کی به میدان تو یابم این دو سه گوی جهان %~% در خم چوگان وحدت ناگهان انداخته(@)(@@) 22 هم ببینم عاقبت این کشتی افلاک را %~% موج دریای ظهورت بادبان انداخته(@)(@@) 23 ای خوش ار بینیم بی‌ما گوهر بحر بقات %~% کشتی ما در محیط بیکران انداخته(@)(@@) 24 غرق دریا حیاتیم و چو دریا خشک لب %~% دم به دم از تشنگی بر لب زبان انداخته(@)(@@) 25 ذره‌ای خاکیم حیران در هوای مهر تو %~% در سر از سودات شوری در جهان انداخته(@)(@@) 26 تا مگر یابیم از عشق تو بوی زندگی %~% خویشتن را در میان کشتگان انداخته(@)(@@) 27 یک نظر کرده به مشتاقان ز روی دوستی %~% در سر هریک ز عشقت صد فغان انداخته(@)(@@) 28 زان نظر مسکین عراقی را حیاتی بخش نیز %~% چند باشد مرده‌ای در خاکدان انداخته PageV1P326(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 منم ز عشق سر از عرش برتر آورده %~% به زیر پای سر نه فلک درآورده(@)(@@) 2 به بحر نیستی از بیخودی فرو رفته %~% سر خودی ز در بیخودی در آورده(@)(@@) 3 نهاده پای طرب بر سر بساط نیاز %~% گرفته دست تمنا و بر سر آورده(@)(@@) 4 همای همت من باز کرده بال طرب %~% دو کون و هر چه درو زیر یک پر آورده(@)(@@) 5 اساس قصر جلالم عنایت ازلی %~% بسی ز کنگره عرش برتر آورده(@)(@@) 6 برید شوق من از خلعت صفات مرا %~% به ملک وصل مثالی مقرر آورده(@)(@@) 7 ز آسمان به من از روح قدس هر نفسی %~% برید جانم روح معطر آورده(@)(@@) 8 به بوستان جهان بهر گلبنان حیات %~% هزار جوی روان به ز کوثر آورده(@)(@@) 9 برای صدرنشینان درگهم رضوان %~% ز شاخ طوبی صد چتر بر سر آورده(@)(@@) 10 فلک به مشعله داری درگهم هر شب %~% دو صد هزار مشاعل ز اختر آورده(@)(@@) 11 به حضرتم خضر آب حیات جان 
ms174	 افزا %~% بهر صبوح به جام سکندر آورده(@)(@@) 12 محیط خاطر من هر زمان به هر موجی %~% هزار گوهر الهام بر سر آورده(@)(@@) 13 زمین فهم من از فیض تازه بر دارد %~% درخت فضل من از غیب نوبر آورده(@)(@@) 14 رسید شمه‌ای از طیب خلق من به صبا %~% از آن به صبح نسیم معطر آورده(@)(@@) 15 هزار خم ز می صاف عشق نوشیده %~% از آن به دردکشان یک دو ساغر آورده(@)(@@) 16 خراب کرده رسوم جهان بی‌معنی %~% ورای رسم جهان رسم دیگر آورده(@)(@@) 17 به نزد اهل معانی نکرده یک دعوی %~% هزار شاهد معنی به محضر آورده(@)(@@) 18 رسیده بر سر گنج جواهر عزت %~% از آن خزانه دمی بس توانگر آورده(@)(@@) 19 برای غمزدگان منطق طرب زایم %~% مفرح سخن روح‌پرور آورده(@)(@@) 20 ز مرغزار عراق آمده به وادی هند %~% از آن ریاض نسیمی برابر آورده(@)(@@) 21 به هند طوطی نطقم تبرزد افشانده %~% به مولتان سخنی همچو شکر آورده PageV1P327(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای رخت مجمع جمال شده %~% مطلع نور ذوالجلال شده(@)(@@) 2 عاشق روت لم‌یزل گشته %~% شاکر خوت لایزال شده(@)(@@) 3 ذروه عرش و قسوه ملکوت %~% زیر پای تو پایمال شده(@)(@@) 4 در نوشته سرادق جبروت %~% محرم پرده وصال شده(@)(@@) 5 با جمال قدم لقای تو را %~% در ملاقات اتصال شده(@)(@@) 6 هرچه او خواسته شده موجود %~% وآنچه ناخواسته محال شده(@)(@@) 7 بهر تو نیستی شده همه هست %~% همه هست از تو با کمال شده(@)(@@) 8 از پی جرعه‌دان مجلس تو %~% طینت آدمی سفال شده(@)(@@) 9 ساقی مجلس تو فیض قدم %~% جرعه‌ای خیر انتیال شده(@)(@@) 10 کرده دعوی عقل کل باطل %~% معجزاتت گواه حال شده(@)(@@) 11 سایه از تاب آفتاب رخت %~% در نهان خانه زوال شده(@)(@@) 12 از بیان تو شکل میم و دو نون %~% حل کن مشکلات ضال شده(@)(@@) 13 عقل در مکتب هدایت تو %~% دیو بوده ملک خصال شده(@)(@@) 14 از شب و روز زلف و رخسارت %~% عالم مهتری نکال 
ms175	 شده(@)(@@) 15 ز انعکاس شعاع طلعت تو %~% آفتاب آینه مثال شده(@)(@@) 16 تا حکایت کند ز عکس رخت %~% روی خورشید با جمال شده(@)(@@) 17 تا نشانی دهد ز ابرویت %~% ماه در هر مهی هلال شده(@)(@@) 18 تا معطر ریاض قدس شود %~% از سر کوی تو شمال شده(@)(@@) 19 هر سحر مقبلان قدسی را %~% روی خوبت خجسته فال شده(@)(@@) 20 دل دیوانگان روحانی %~% در سر آن دو زلف و خال شده(@)(@@) 21 حلقه‌داران چرخ بر در تو %~% حلقه در گوش چون هلال شده(@)(@@) 22 ورد ارواح در جوانب قدس %~% الف و حا و میم و دال شده(@)(@@) 23 برده نامت مسیح در سر گور %~% مرده در شور و وجد و حال شده(@)(@@) 24 ز آب رویت خلیل را آتش %~% گلشن و منبع زلال شده(@)(@@) 25 حاجت سایل از در تو روا %~% بیش از اندیشه سال شده(@)(@@) 26 ابرش عزم پیروان تو را %~% ساحت لامکان مجال شده(@)(@@) 27 صفه آسمان و صدر بهشت %~% چاکرت را صف نعال شده(@)(@@) 28 از مدیح تو عاجز آمده عقل %~% ناطقه در ثنات لال شده(@)(@@) 29 قدر تو در جهان نگنجیده %~% نعت تو برتر از خیال شده(@)(@@) 30 نظری کن به مفلس عوری %~% دل و دین رفته جاه و مال شده(@)(@@) 31 عمر در ناخوشی بسر برده %~% عیس بی‌خوشدلی وبال شده(@)(@@) 32 کرده در شرع تو شروع ولیک %~% نفس بر پای او عقال شده(@)(@@) 33 بر در قرب تو چگونه بود %~% مرغکی پر شکسته بال شده(@)(@@) 34 راه ده بر درت عراقی را %~% ای درت جمله را مآل شده PageV1P328(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 که برد از من بی‌دل بر جانان خبری %~% یا که آرد ز نسیم سر کویش اثری(@)(@@) 2 جز صبا کیست کزین خسته برد پیغامی %~% جز نسیم از بر دلدار که آرد خبری(@)(@@) 3 ای صبا چند روزی گرد گلستان و چمن %~% چند آشفته کنی طره هر خوش پسری(@)(@@) 4 ای صبا صبح دمی بر سر 
ms176	 کویش بگذر %~% تا معطر شود آفاق ز تو هر سحری(@)(@@) 5 بوسه زن خاک کف پای حمیدالدین را %~% که چنو یار ندارم به جهان دگری(@)(@@) 6 رو سحر خاک کف پای کریم‌الدین بوس %~% تا معطر شود آفاق ز تو هر سحری(@)(@@) 7 آنکه چون من همه کس از دل و جان بنده اوست %~% گرچه در خاطر او نیست کسی را خطری(@)(@@) 8 خدمت بنده به وجهی که توانی برسان %~% که: بیا کز غم هجرانت شدم دربدری(@)(@@) 9 در غم هجر تو تنها نه منم کز یاران %~% هر کسی راست به قدر خود ازین غم قدری(@)(@@) 10 برسان خدمت و گو: ای رخت از جان خوشتر %~% چند نالد ز فراق رخ تو لابه‌گری(@)(@@) 11 تو چه دانی که چها کرد فراقت با من %~% داند این آنکه ازین غم بود او را قدری(@)(@@) 12 غم هجران تو ای دوست چنان کرد مرا %~% که ببینی نشناسی که منم یا دگری(@)(@@) 13 به دو چشم تو که چون چشم تو بیمار توام %~% چه شود گر بفرستی ز دو عالم شکری(@)(@@) 14 دوستان منتظر مقدم میمون تواند %~% بیش ازین خود نشکیبند بیا زودتری(@)(@@) 15 گر عزیمت کنی ای دوست به سوی ملتان %~% چه مبارک بود آن عزم و چه نیکو سفری(@)(@@) 16 بر خیال تو شب و روز همی گریم زار %~% چه کنم همرهم و می‌دهمش دردسری(@)(@@) 17 تا نگویی که چرا رفت سراسیمه ما %~% در نمانم ز جوابت بشنو ماحضری(@)(@@) 18 بر خود و دیده خود غیرتم آمد رفتم %~% تا نبیند رخ زیبای تو هر مختصری(@)(@@) 19 من که بر دیده خود رشک برم چون بینم %~% که ببیند رخ تو دیده کوته‌نظری(@)(@@) 20 از برای دل من روی به هر کس منمای %~% کان رخ انصاف دریغ است به هر دیده‌وری(@)(@@) 21 از درت خسته عراقی سبب غیرت رفت %~% ورنه بودی به سر راه تو هر بی‌بصری PageV1P329(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دلا در بزم عشق یار 
ms177	 هان تا جان برافشانی %~% که با خود در چنان خلوت نگنجی گر همه جانی(@)(@@) 2 چو گشتی سر گران زان می سبک جان برفشان بر وی %~% که در بزم سبک روحان نکو نبود گران جانی(@)(@@) 3 تو آنگه زو خبر یابی که از خود بیخبر گردی %~% تو آنگه روی او بینی که از خود رو بگردانی(@)(@@) 4 بدو آن دم شوی زنده که جان در راه او بازی %~% ازو داد آن زمان یابی که از خود داد بستانی(@)(@@) 5 بدو او را چو خواهی دید پس دیده چه می‌داری %~% بدو چون زنده خواهی ماند پس جان را چه می‌مانی(@)(@@) 6 به روی او برافشان جان و دیده در ره او باز %~% تو را معشوق آخر به که مشتاقی و پژمانی(@)(@@) 7 مشو چون گوی سرگردان فگن خود را درین میدان %~% رساند خود تو را چوگان به جولانگاه سلطانی(@)(@@) 8 همای عشق اگر یک ره تو را در زیر پر گیرد %~% نه سدره‌ات آشیان آید نه از فردوس وامانی(@)(@@) 9 نشین با خویشتن برخیز و در فتراک عشق آویز %~% مگر خود را ز دست خود طفیل عشق برهانی(@)(@@) 10 ز بهر راحتت تن را مرنجان جان نکو نبود %~% که جان را در خطر داری و تن را در تن آسانی(@)(@@) 11 تو خود انصاف ده آخر مروت کی روا دارد %~% ستوری را شکرخایی و طوطی را مگس رانی(@)(@@) 12 درین وحشت سرا امنی نخواهی یافتن هرگز %~% درین محنتکده روحی نخواهی دید تا دانی(@)(@@) 13 چو عیسی عزم بالا کن برون بر جان ازین پستی %~% میا اینجا که خر گیرند دجالان یونانی(@)(@@) 14 ولی بی‌عون ربانی مرو در ره که این غولان %~% بگردانند از راهت به تخییلات نفسانی(@)(@@) 15 برون از شرع هر راهی که خواهی رفت گمراهی %~% خلاف دین هر آن علمی که خواهی خواند شیطانی(@)(@@) 16 ز صرافان یونانی دغل مستان که قلابند %~% ندارند قلبشان سکه ز دارالضرب ایمانی(@)(@@) 17 
ms178	 تو را دل لوح محفوظ است و علم از فلسفی گیری %~% تو را خورشید همسایه چراغ از کوچه گیرانی(@)(@@) 18 دلت آیینه غیب است و هر دانا درو بینی %~% طلسم عالم جسمی و گنج عالم جانی(@)(@@) 19 ور از خورشید وجدانی شود چشم دلت روشن %~% نه روی آن و این بینی نه نقش این و آن خوانی(@)(@@) 20 به شب در آب نتوان دید عکس انجم و افلاک %~% ولی در روز بنماید ز تاب مهر نورانی(@)(@@) 21 ازین معنی حقیقت بین نظر بر هر چه اندازد %~% همه انوار حق بیند نبیند صورت فانی(@)(@@) 22 چنین دولت تو را ممکن تو از بی‌دولتی دایم %~% چو دونان مانده اندر ره اسیر نفس شهوانی(@)(@@) 23 هوای دنیی دون را تو از بی‌همتی مپسند %~% که وامانی به مرداری درین وادی ظلمانی(@)(@@) 24 چه بینی سبزه دنیا که چشم جان کند خیره %~% تماشای دل خود کن اگر در بند بستانی(@)(@@) 25 دلی تا باشد اصطبل ستور و گلخن شیطان %~% نیابد از مشام جان نسیم روح ریحانی(@)(@@) 26 اگر خواهی که این گلخن گلستانی شود روشن %~% میان دربند روز و شب عمارت را چو بستانی(@)(@@) 27 اگر شاخ وفا بینی ز دیده آب ده او را %~% وگر خار جفا بینی بزن راه پشیمانی(@)(@@) 28 بروب از صحن میدانش صفات نفس بدفرمان %~% برآور قصر و ایوانش به ذکر و شکر یزدانی(@)(@@) 29 مراعات زمین دل بدین سان گر کنی یک چند %~% گلستانی شود روشن نظاره‌گاه اخوانی(@)(@@) 30 درو از مشرب عرفان روان صد چشمه حیوان %~% درو از منبع اخلاق جاری هم دو صد خانی(@)(@@) 31 کشیده طوبی ایمان سر از طاعت به علیین %~% غصونش پرتو احسان ثمارش ذوق وجدانی(@)(@@) 32 فروزان از سر هر غصن صد قندیل در میدان %~% نمایان نور هر قندیل خورشیدی درخشانی(@)(@@) 33 خرد در صحن بستانش کمر بسته به فراشی %~% ملک بر قصر ایوانش ادا کرده ثنا خوانی(@)(@@) 34 ز یک سو طوطی 
ms179	 اذکار خندان از شکر خایی %~% ز یک سو بلبل اسرار نالان از خوش الحانی(@)(@@) 35 نوای بلبل اسرار کرده عقل را بیدار %~% که: آخر در چنین گلزار خاموش از چه میمانی(@)(@@) 36 به عشرتگاه مستان آی اگر عیش ابد خواهی %~% به نزهتگاه جانان آی اگر جویای جانانی(@)(@@) 37 شراب از دست جانان خور چه نوشی از کف رضوان %~% بساط بزم رحمن بین چه بینی بزم رضوانی(@)(@@) 38 بساط وصل گسترده سماط عشرت افکنده %~% به جام شوق در داده شراب ذوق حقانی(@)(@@) 39 نموده شاهد معنی جمال از پرده صورت %~% ز چشم خویش کرده مست جان انسی و جانی(@)(@@) 40 ز بهر نقل سرمستان ز لب کرده شکرخایی %~% برای چشم مشتاقان ز رخ کرده گل‌افشانی(@)(@@) 41 روان کرده لب ساقی لبالب جام مشتاقی %~% حضورش کرده در باقی حدیث نفس انسانی(@)(@@) 42 عنایت گفته با همت که: اندر منزل اول %~% چه دیدی باش تا بینی جمال منزل ثانی(@)(@@) 43 چه شینی در گلستانی که دارد حد و پایانی %~% چه خوش باشی به بستانی چو طاووس گلستانی(@)(@@) 44 هزار و یک مقام آنجا اگر چه بگذری لیکن %~% ز حد جمله اسما تجاوز کرد نتوانی(@)(@@) 45 تجلی صفات آنجا گرت صد نقش بنماید %~% تو را یک رنگ گرداند ببینی روی یکسانی(@)(@@) 46 گهت از لطف بنوازد گهت از قهر بگدازد %~% گهی از بسط خوش باشی گهی از فیض پژمانی(@)(@@) 47 گهی از انس همچون برق خوش خندی درین گلزار %~% گه از هیبت بسان ابر اشک از دیده بارانی(@)(@@) 48 بساط رسم را طی کن براق وهم را پی کن %~% تو را عز خدایی بس که دل در بند فرمانی(@)(@@) 49 برون شو ز آشیان جان مکن منزل درین بستان %~% نگیرد در قفس آرام سیمرغ بیابانی(@)(@@) 50 مشعبد باز وقت اینجا دمی صد مهره غلتاند %~% تو بر نطع مراد او ازان چون مهره غلتانی(@)(@@) 51 ورای بوستان دل یکی صحراست بی‌پایان %~% به پای جان توان 
ms180	 رفتن در آن صحرای حیرانی(@)(@@) 52 در آن صحرا شو و می‌بین ورای عرش علیین %~% سرا بستان قدسی و بهشت آباد سبحانی(@)(@@) 53 فضایی سر بسر انوار از سبحات قیومی %~% ریاضی سر بسر گلزار از نفحات ربانی(@)(@@) 54 ز آثار غبار او منور چشم گردونی %~% ز ازهار ریاض او معطر جان روحانی(@)(@@) 55 حضور اندر حضور آنجا نهان اطوار در انوار %~% ظهور اندر ظهور آنجا عیان اسرار کتمانی(@)(@@) 56 ازل آنجا ابد بینی ابد آنجا ازل یابی %~% ز نور تابش کیسان ببینی تاب کیسانی(@)(@@) 57 بخود نتوان رسید آنجا ولیکن گر شوی بیخود %~% از آن اوج هوا می‌پر به بال و پر وجدانی(@)(@@) 58 هزاران ساله ره می‌بر به یک پرواز در یکدم %~% همی کن کار صد ساله درین یکدم به آسانی(@)(@@) 59 چه حاجت خود تو را آنجا به سیر و طیر چون کونین %~% همه در قبض تو جمعند و تو در قبض ربانی(@)(@@) 60 ببینی هر چه هست و بود و خواهد بود در یکدم %~% بدانی آنچه می‌بینی ببینی آنچه می‌دانی(@)(@@) 61 کند چشم تو کار گوش گوشت کار چشم آنجا %~% تنت رنگ روان گیرد روانت رنگ جسمانی(@)(@@) 62 بنور لم یزل بینی جمال لایزالی را %~% به علم سرمدی دانی همه اسرار پنهانی(@)(@@) 63 وگر موج محیط او رباید خود تو را از تو %~% نه از آتش ضرر یابی و نی از آب تاوانی(@)(@@) 64 نه از حد و نه از قید و نه از وصل و نه از هجران %~% نه از درد و نه از درمان نه از دشوار و آسانی(@)(@@) 65 تو را چون از تو بستاند نمانی جمله او ماند %~% تو آنگه خواه انالحق گوی و خواهی گوی سبحانی(@)(@@) 66 عجب نبود درین دریا گر آویزی به زلف یار %~% غریق بحر در هر چیز آویزد ز حیرانی(@)(@@) 67 چو با بحر آشنا گشتی شدی از خویش بیگانه %~% چو آن زلفت به دست آمد برستی از 