ms181	 جر اندر بماند چونش گیرد تن به جر(@)(@@) 14 پیش جان تو سپر کرده‌است یزدان تنت را %~% تو چرا جان را همی داری به پیش تن سپر(@)(@@) 15 خواب و خور کار تن تیره است تو مر جانت را %~% چون کنی رنجه چو گاو و خر ز بهر خواب و خور(@)(@@) 16 مردمان از تو بخندند ای برادر بی گمان %~% چون پلاس ژنده را سازی زدیبا آستر(@)(@@) 17 گر شکر خوردی پریرو دی یکی نان جوین %~% همبر است امروز ناچار آن جوین با آن شکر(@)(@@) 18 داد تن دادی بده جان را به دانش داد او %~% یافت از تو تن بطر در کار جانت کن نظر(@)(@@) 19 جانت آزادی نیابد جز به علم از بندگی %~% گر بدین برهانت باید شو به دین اندر نگر(@)(@@) 20 مردم دانا مسلمان است نفروشدش کس %~% مردم نادان اگر خواهی ز نخاسان بخر(@)(@@) 21 تن به جان یابد خطر زیرا که تن زنده بدوست %~% جان به دانش زنده ماند زان بدون یابد خطر(@)(@@) 22 جان مردم را دو قوت بینم از علم و عمل %~% چون درختی که‌ش عمل برگ است و از علم است بر(@)(@@) 23 جانت را دانش نگه دارد زدوزخ همچنانک %~% بر نگه دارد درختان را از آتش وز تبر(@)(@@) 24 گر نتابی سر ز دانش از تو تابد آفتاب %~% وز سعادت ای پسر بر آسمان سایدت سر(@)(@@) 25 مر تو را بر آسمان باید شدن زیرا خدای %~% می نخواند جز تو را نزدیک خویش از جانور(@)(@@) 26 بر فلک بی‌پا و پر دانی که نتوانی شدن %~% پس چرا بر ناوری از دین و دانش پای و پر(@)(@@) 27 از حریصی‌ی کار دنیا می‌نپردازی همی %~% خانه بس تنگ است و تاری می‌نبینی راه در(@)(@@) 28 خاک را بر زر گزیده‌ستی چو نادانان ازانک %~% خاک پیش توست و زر را می نیابی جز خبر(@)(@@) 29 همچو کرم سرکه‌ای ناگه زشیرین انگبین %~% با خرد چون 
ms182	 کرم چون گشتی به بیهوشی سمر(@)(@@) 30 بس ترش و تنگ جای است این ازیرا مر تو را %~% خم سرکه است این جهان بنگر به عقل ای بی‌بصر(@)(@@) 31 جانت را اندر تن خاکی به دانش زر کن %~% چون همی ناید برون هرگز مگر کز خاک زر(@)(@@) 32 همچنان کاندر جهان آتش نسوزد زر همی %~% زر جانت را نسوزد آتش سوزان سقر(@)(@@) 33 ره گذار است این جهان ما را بدو دل در مبند %~% دل نبندد هوشیار اندر سرای ره‌گذر(@)(@@) 34 زیر پای روزگار اندر بماندم شصت سال %~% تا به زیر پای بسپردم سر این مردم سپر(@)(@@) 35 دست و پایم خشک بسته است این جهان بی دست و پای %~% زیب و فرم پاک برده‌است اینچنین بی زیب و فر(@)(@@) 36 نیستم با چرخ گردان هیچ نسبت جز بدانک %~% همچو خود بینم همی او را مقیم اندر سفر(@)(@@) 37 کار من گفتار خوب و رای علم و طاعت است %~% کار این دولاب گشتن گاه زیر و گه زبر(@)(@@) 38 نیستم فرزند او زیرا که من زو بهترم %~% جانور فرزند ناید هرگز از بی‌جان پدر(@)(@@) 39 نیست جز دولاب گردون چون به گشتن‌های خویش %~% آب ریزد بر زمین می تا بروید زو شجر(@)(@@) 40 وانگهی پیداست چون زو فایده جمله توراست %~% کاین ز بهر تو همی گردد چنین بی‌حد و مر(@)(@@) 41 مردم از ترکیب نیکو خود جهانی دیگر است %~% مختصر لیکن سخن‌گوی است و هم تدبیر گر(@)(@@) 42 پس همی بینی که جز از بهر ما یزدان ما %~% نافریده‌است این جهان را ای جهان مختصر(@)(@@) 43 تن تو را گور است بی‌شک مر تو را پس وعده کرد %~% روزی از گورت برون آرد خدای دادگر(@)(@@) 44 تنت همچون گور خاک است ای پسر مپسند هیچ %~% جانت را در خاک تیره جاودانه مستقر(@)(@@) 45 خاک تیره بد مقر است ای برادر شکر کن %~% ایزدت را تا برون آردت از این تیره 
ms183	 مقر(@)(@@) 46 انچه گفتم یاد گیر و آنچه بنمودم ببین %~% ور نه همچون کور و کر عامه بمانی کور و کر PageV1P100(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای به هوا و مراد این تن غدار %~% مانده به چنگال باز آز گرفتار(@)(@@) 2 در غم آزت چو شیر شد سر چون قیر %~% وان دل چون تازه شیر تو شده چون قار(@)(@@) 3 آز تو را گل نماید ای پسر از دور %~% لیک نباشد گلش مگر همه جز خار(@)(@@) 4 آز گر او را امین کنی بستاند %~% او نه به بسیار چی ز عمر تو بسیار(@)(@@) 5 بار و بزه از تو بر خره کرده‌است %~% ای شده چوگانت پشت در بزه و بار(@)(@@) 6 مر خر بد را به طمع کاه و جو آرد %~% زیرک خر بنده زیر بار به خروار(@)(@@) 7 خر سپس جو دوید و تو سپس نان %~% اکنون در زیر بار می‌رو خروار(@)(@@) 8 خوار که کردت به پایگاه شه و میر %~% در طلب خواب و خور جز این تن خوشخوار(@)(@@) 9 تن که تو را خوار کرد چون که نگوئیش %~% «خوش مخوراد آن عدو که کرد مرا خوار»(@)(@@) 10 چاکر خویشت که کرد جز گلوی تو %~% اینت والله بزرگ و زشت یکی عار!(@)(@@) 11 گر تو بدانستیئی که فضل تو بر خر %~% چیست کجا ماندیی نژند و شکم خوار(@)(@@) 12 فضل تو بر گاو و خر به عقل و سخن بود %~% عقل و سخن نیست جز که هدیه جبار(@)(@@) 13 عقل و سخن مر تو را به کار کی آید %~% چون تو به می مست کرده‌ای دل هشیار(@)(@@) 14 کار خرد چیز نیست جز همه تدبیر %~% کار سخن نیز نیست جز همه گفتار(@)(@@) 15 کردی تدبیر تو ولیک همه بد %~% گفتی لیکن سرود یافه و بی کار(@)(@@) 16 چون که خرد را دلیل خویش نکردی %~% بر نرسیدی ز گشت گنبد دوار(@)(@@) 17 هیچ نگفتی که: این که کرد و چرا کرد 
ms184	 %~% کار عظیم است چیست عاقبت کار(@)(@@) 18 من چه به کارم خدای را که ببایست %~% کردن چندین هزار کار و بیاوار(@)(@@) 19 گرش نبودم به کار بیهدگی کرد %~% بیهدگی ناید از مهیمن قهار(@)(@@) 20 واکنون تدبیر چیست تام بباید %~% بد چو برون بایدم همی شد از این دار(@)(@@) 21 عقل ز بهر تفکر است در این باب %~% بر تن و جان تو ای پسر سر و سالار(@)(@@) 22 عقل تو ایدر ز بهر طاعت و علم است %~% پس تو چرائی بد و منافق و طرار(@)(@@) 23 آتش دادت خدای تا نخوری خام %~% نه ز قبل سوختن بدو سر و دستار(@)(@@) 24 چون به زمستان تو به آفتاب بخسپی %~% پس چه تو ای بی‌خرد چه آن خر بی‌کار(@)(@@) 25 نیست خبر سرت را هنوز کنون باش %~% جو نسپرده است پای تو خر با بار(@)(@@) 26 چرخ همی بنددت به گشت زمان پای %~% روزی از اینجا برون کشدت چو کفتار(@)(@@) 27 عمر تو را چون به موش خویش جهان خورد %~% خواهی تو عمر باش و خواهی عمار(@)(@@) 28 تنت چو تار است و جانت پود و تو جامه %~% جامه نماند چو پود دور شد از تار(@)(@@) 29 چندین در معصیت مدو به چپ و راست %~% چون شتر بی‌مهار و اسپ بی‌افسار(@)(@@) 30 یاد نیاید ز طاعتت نه ز توبه %~% اکنون که‌ت تن ضعیف نیست و نه بیمار(@)(@@) 31 راست که افتادی و زخواب و زخور ماند %~% آنگه زاری کنی و خواهش و زنهار(@)(@@) 32 بی‌گنهی تات کار پیش نیاید %~% وانگه که‌ت تب گلو گرفت گنه‌کار(@)(@@) 33 چونت بخواهند باز عاریتی جان %~% از دلت آنگه دهی به معصیت اقرار(@)(@@) 34 تو بسگالی که نیز باز نگردی %~% سوی بلا گرت عافیت دهد این بار(@)(@@) 35 وانگه چون به‌شدی زمنظر توبه %~% باز درافتی به‌چاه جهل نگونسار(@)(@@) 36 عذر طرازی که «میر توبه‌م بشکست» %~% نیست دروغ تو را خدای خریدار(@)(@@) 37 راست نگردد دروغ و زرق 
ms185	 به چاره %~% معصیتت را بدین دروغ میاچار(@)(@@) 38 میر گرت یک قدح شراب فرو ریخت %~% چون که تو از دین برون شدی ز بن و بار(@)(@@) 39 میر چه گوئی که بر تو بر در مزگت %~% ای شده گم ره به دوخته‌است به مسمار(@)(@@) 40 چون که بدان یک قدح که داد تو را میر %~% با تو نه دین و نه قول ماند و نه کردار(@)(@@) 41 بلکه تو را دل به سوی عصیان مانده است %~% چون سوی طباخ چشم مردم ناهار(@)(@@) 42 نیک نبودی تو خود کنون چه حدیث است %~% کز حشم و میر زور یافتی و یار(@)(@@) 43 ای به شب تار تازنان به چپ و راست %~% برزنی آخر سر عزیز به دیوار(@)(@@) 44 روزی پیش آیدت به آخر کان روز %~% دست نگیرد تو را نه میر و نه بندار(@)(@@) 45 گر تو نگهدار دین و طاعتی امروز %~% ایزد باشد تو را به حشر نگه‌دار(@)(@@) 46 امروز آزار کس مجوی که فردا %~% هم ز تو بی‌شک به‌جان تو رسد آزار(@)(@@) 47 آنچه نخواهی که من به پیش تو آرم %~% پیش من از قول و فعل خویش چنان مار(@)(@@) 48 جان مرا گر سوی تو جانت عزیز است %~% سوی من ای هوشیار خوار مپندار(@)(@@) 49 چون ندهی داد و داد خویش بخواهی %~% نیست جزین هیچ اصل و مایه پیکار(@)(@@) 50 داد تو داده است کردگار تو را نیز %~% داد ز طاعت به‌داد باید ناچار(@)(@@) 51 ور ندهی داد کردگار به طاعت %~% بر تو کسی نیست جز که هم تو ستمگار(@)(@@) 52 هدیه نیابی ز کس تو جز که زحجت %~% حکمت چون در و پند سخته به معیار PageV1P101(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 یکی خانه کردند بس خوب و دلبر %~% درو همچنو خانه بی‌حد و بی‌مر(@)(@@) 2 به خانه مهین درنشاندند جفتان %~% به یک جا دو خواهر زن و دو برادر(@)(@@) 3 دو زن خفته‌اند و دو مرد ایستاده %~% نهفته زنان زیر 
