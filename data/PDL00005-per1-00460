ms441	 من که می خوردن درین ایام چون باید(@)(@@) 7 نخست اندر میان باری می بیجاده گون باید %~% پس آنگه ساقی پاکیزه چون سیمین ستون باید(@)(@@) 8 دو سه رودی بیکجا ساخته چون ارغنون باید %~% سرود مطرب ساده طرب را رهنمون باید(@)(@@) 9 به هر دوری که می خوردی طرب کردن فزون باید %~% موافق دوستان یکدل همی نیک آزمون باید(@)(@@) 10 دل اندر شادی و رامش به آرام وسکون باید %~% زمجلس دشمن خسرو به هر حالی برون باید(@)(@@) 11 می اکنون لعل تر گردد که گل رخسار بنماید %~% تو گویی گل همی هر روز در می رنگ بفزاید(@)(@@) 12 می از گل گونه بستاند گل از می رنگ برباید %~% گل و می را تو پنداری که یک مادر همی زاید(@)(@@) 13 نگارینا بدین شادی مرا گر می دهی شاید %~% می اکنون ده که می تن را همی چون روح درباید(@)(@@) 14 طبیب من گلست و گل مرا جز می نفرماید %~% دل زاهدکه می بیندبه می حقا که بگراید(@)(@@) 15 گل آنک وقت آن آمد که چشم از خواب بگشاید %~% چو روی خوبرویان مجلس خسرو بیاراید(@)(@@) 16 نگارا بوستان اکنون ندانی کز چه سان باشد %~% گشاده آسمان دیدستی اندر شب چنان باشد(@)(@@) 17 ازین سو نسترن باشد از آن سو ارغوان باشد %~% بهشتی در میان باشد بهاری بر کران باشد(@)(@@) 18 درختان را همه پوشش پرند و پرنیان باشد %~% هوای بوستان همچون هوای دوستان باشد(@)(@@) 19 بیا در بوستان چونان که رسم باستان باشد %~% تو سروی و گلی و سرو و گل در بوستان باشد(@)(@@) 20 گلی لیکن ز تو تا سرخ گل چندان میان باشد %~% که از قدر بلند شاه تا هفت آسمان باشد(@)(@@) 21 نگارا چند ره گفتی که چون وقت بهار آید %~% ترا بامن گه می خوردن و بوس و کنار آید(@)(@@) 22 بهار آمد همی گوی برو تا گل به بار آید %~% همی نومیدیم زین وعده نومیدوار آید 
ms442	(@)(@@) 23 ترا زین وعده اندر دل به روزی صد هزار آید %~% مرا آری بدین گفتارت ای جان استوار آید(@)(@@) 24 چو چیزی از تو بشنیدم دل آن را خواستار آید %~% گر اندر دل نداری باد پیمودن چه کار آید(@)(@@) 25 ترا ترسم که بوس من همی بر چشم خوار آید %~% ندانی کز لبم بوی بساط شهریار آید(@)(@@) 26 دلا یار دگر جستی بدین کار از تو خوشنودم %~% تو از زاری بیاسودی من از خواری بیاسودم(@)(@@) 27 تن اندر مهر آن کز من نیندیشد بفرسودم %~% روان اندر هوا و مهر بد مهری بیالودم(@)(@@) 28 نه روزی راست بنشستم نه یک شب شادبغنودم %~% نه برامید آن کاخر مگر زین کار برسودم(@)(@@) 29 نگاری بر کفم دادی که چون آواش بشنودم %~% بر آن کس کاین نگاراز کف او گم شد ببخشودم(@)(@@) 30 بدین خوبی که تو کردی ترا بسیار بستودم %~% محل و جاه تو ای دل بر خسرو بیفزودم(@)(@@) 31 بهار آمد من و هر روز نو باغی و نوجایی %~% به گشتن هر زمان عزمی به بودن هر زمان رایی(@)(@@) 32 قدح پر باده رنگین به دست باده پیمایی %~% چو مرغ از گل به گل هر ساعتی دیگر تماشا یی(@)(@@) 33 نگاری با من و رویی نه رویی بلکه دیبایی %~% ازین خوشی ازین کشی ازین در کار زیبایی(@)(@@) 34 خردمندی که از رایم خبر دارد به ایمایی %~% غزلگویی که مرغان را به بانگ آرد به آوایی(@)(@@) 35 من و چنگی و آن دلبر که او را نیست همتایی %~% زمن کرده مدیح شاه را هزمان تقاضایی(@)(@@) 36 امیر عالم عادل نبیره خسرو غازی %~% جلال دولت عالی امین ملت تازی(@)(@@) 37 ملک بو احمد محمود زیبای سرافرازی %~% شهنشاهی که روز جنگ با شیران کند بازی(@)(@@) 38 ایا شاه جهانداری که فردی و بی انباز ی %~% چه اندر مملکت گیری چه اندر مملکت سازی(@)(@@) 39 بزرگی راو شاهی را هم انجام و هم آغازی %~% جهانداری زتو 
ms443	 نازد تو از فضل و هنر نازی(@)(@@) 40 تو آن شاهی که گیتی را زبد کیشان بپردازی %~% به تیغ و تیر خان و مان بدخواهان بر اندازی(@)(@@) 41 نباشد بس عجب شاها! اگر شادی کندشاهی %~% ز چون تو شه که شاهان چون ستاره اندو تو چون ماهی(@)(@@) 42 چنان کز تو به نزدیک منست ای خسرو آگاهی %~% ز تو تا خسروان چندان بودکز ماه تاماهی(@)(@@) 43 ایا مرگاه شاهی را به جای یوسف چاهی %~% جهان از عیب و آهو پاک باشد تا تو بر گاهی(@)(@@) 44 زبس پرهیز و بی طمعی و ازبس دست کوتاهی %~% ولایت را نکو داری رعیت را نکو خواهی(@)(@@) 45 نکو رویی نکو خویی نکو طبعی نکو خواهی %~% ترا پرهیز پیران داد یزدان در به برناهی(@)(@@) 46 امیرا در دل هر کس ترا جایی همی بینم %~% دل هر مهتری را سوی تو رایی همی بینم(@)(@@) 47 به تو هر راد مردی را تو لایی همی بینم %~% نه در گیتی چو تو پیری و برنایی همی بینم(@)(@@) 48 نه در شاهی ترا یاری و همتایی همی بینم %~% دلت را چون فراخ و پهن دریایی همی بینم(@)(@@) 49 زتو اندر جهان پیوسته آوایی همی بینم %~% زعدل تو ولایت را چو دیبایی همی بینم(@)(@@) 50 ترا زین کاردانی کارفرمایی همی بینم %~% ز رای ملک آرا ملک آرایی همی بینم(@)(@@) 51 اگر فضل و هنر باید همی فضل و هنر داری %~% وگر اصل و گهر باید همی اصل و گهرداری(@)(@@) 52 به هر کاری توان داری زهر علمی خبر داری %~% زمال و ملک دنیا نام نیکو دوست ترداری(@)(@@) 53 همه گفت نکو نامی چوسیم و زر ز بر داری %~% نداندکس که تو اندر نکو نامی چه سر داری(@)(@@) 54 زنام بدهمیشه خویشتن را برحذر داری %~% شهان رسم دگردارندو تو رسم دگرداری(@)(@@) 55 به رسم نیکو از شاهان گیتی سر زبر داری %~% همه راه و نهادو عادت و رسم پدر داری 
ms444	(@)(@@) 56 پسر کو چون پدر باشد ستایش را سزا باشد %~% پدر کز جان و دل چونان پسر جوید و رواباشد(@)(@@) 57 پسر نزد پدر زیرا گرامی تر عطا باشد %~% به خاصه چون پسر نیکو خو و نیکو لقا باشد(@)(@@) 58 پسر باید که چون تو نیکنام و پارسا باشد %~% خطا گفتم چو تو اندر جهان دیگر کجا باشد(@)(@@) 59 هر آن کس کو بی اندیشه سخن گوید خطا باشد %~% چگونه پارسا باشد کسی کو پادشا باشد(@)(@@) 60 کسی کو پادشاه و مهتر و فرمانروا باشد %~% به آن کوشد که او را همت و کام وهوا باشد(@)(@@) 61 به رنج دل تو پروردی امیرا نیکنامی را %~% چنان چون مادر دلسوز فرزندگرامی را(@)(@@) 62 سخا را دوستر داری مر نامی را %~% ثنارا بیشتر جویی که غمگین شادکامی را(@)(@@) 63 عطای تو بر آورده ست خاصی را و عامی را %~% چو نام تو یمینی و امینی و نظامی را(@)(@@) 64 بشوید رای تو از روی شبها تیره فامی را %~% کف جود تو چون پدرام گرداند نظامی را(@)(@@) 65 هزار آلت فزون داری بزرگی و همامی را %~% جهان پیش تو زین گردن نهاده مر غلامی را(@)(@@) 66 دل سلطان نگه داری ترا هر روز به باشد %~% چنین باشی جهان از قدر تو بسیار که باشد(@)(@@) 67 پسر کو با پدر همدل بود هر روز مه باشد %~% به خاصه چون پدر گیتی گشای و تاج ده باشد(@)(@@) 68 چنین بایدکه هر کس رابتو احسنت و زه باشد %~% کمانت روز و شب با دشمن سلطان بزه باشد(@)(@@) 69 حدیث تو همه با دشمنانش «دار» و «ده » باشد %~% جواب تو مرایشان را به هر گفتار نه باشد(@)(@@) 70 همیشه دامنت با دامن طاعت گره باشد %~% ترا با دیگران اندر چنین معنی فره باشد(@)(@@) 71 جز از سلطان زهر شاهی که باشددر هنر بیشی %~% چنان چون کاندر آن بیشی به قدر و منزلت پیشی(@)(@@) 72 معین دینی و 
ms445	 ویران کننده بدعت کیشی %~% بدان ماندکه دین پاک را نزدیکتر خویشی(@)(@@) 73 ولی رادر دهن نوشی عدو را بر جگر نیشی %~% عدو خیشست و تو چون ماه تابان آفت خیشی(@)(@@) 74 جز از نیکی نفرمایی جز از نیکی نیندیشی %~% خویی داری نکو و آنگه به صورت چون خوی خویشی(@)(@@) 75 ز چندین مال و چندین زر که بر پاشی و بپر یشی %~% عجب باشد که باشددر جهان تنگی و درویشی(@)(@@) 76 امیرا همتی داری که با او هیچ برنایی %~% ندانم با چنین همت کرا باشد توانایی(@)(@@) 77 جهانداری به خود کامی عطا پاشی به خود رایی %~% بزرگان را عطا دادن بیاموزی و بنمایی(@)(@@) 78 ترا باید جهان تا تو مراورا کارفرمایی %~% در گفتار دربندی در کردار بگشایی(@)(@@) 79 چو نوشروان به عدل و داد گیتی را بیارایی %~% به تیغ تیز باغ پادشاهی را بپیرایی(@)(@@) 80 به وقتی کر شرف گویند با خورشید همتایی %~% دل سلطان نگه داری بپنهانی و پیدایی(@)(@@) 81 خداوندا بدین مایه بکردم برتو استادی %~% نه زان گفتم من این کز تو پدر را نیست آزادی(@)(@@) 82 تو اندر خدمت سلطان مثل با جنبش بادی %~% فزونتر کو ترا فرمود هرگز پای ننهادی(@)(@@) 83 به خدمت کردن بسیار داد خویشتن دادی %~% بدین سلطان ز تو شادست و تو از خویشتن شادی(@)(@@) 84 همایونی بر سلطان زمادر نیکدل زادی %~% به فرخ فال بر گیتی در اقبال بگشادی(@)(@@) 85 زعدل وداد تو گم گشت نام جور و بیدادی %~% همیشه همچنین باید همیشه همچنین بادی(@)(@@) 86 خداوندا ندیدم هیچ سالاری به سنگ تو %~% نه اندر کارها شاهی به آیین و به هنگ تو(@)(@@) 87 نباشد کوه را وقت درنگ تو در نگ تو %~% جهان هرگز نخواهد تا توباشی آدرنگ تو(@)(@@) 88 به وقت کارزار خصم و روز نام و ننگ تو %~% فلک درگردن آویزد شغا و نیملنگ تو(@)(@@) 89 نیاید هیچ شاهی سوی تو هرگز به جنگ تو %~% ور آید باز گرداند 
ms446	 ز راه او را خدنگ تو(@)(@@) 90 به آتش ماند اندر جنگ تیغ آب رنگ تو %~% خداوند آب گردانید آتش را به چنگ تو(@)(@@) 91 اجل خواهد که همچون تیغ مردمخوار تو باشد %~% قضا خواهد که همچون تیر جان او بار تو باشد(@)(@@) 92 ز بیم تیغ تو آن را که دشمن دار تو باشد %~% همه ساله دو رخ بر گونه دینار تو باشد(@)(@@) 93 ظفر درجنگها دایم سپهسالار تو باشد %~% جهان راچشم و گوش و دل سوی گفتار تو باشد(@)(@@) 94 همیشه دولت و پیروزی اندر کار تو باشد %~% خدای اندر همه وقتی معین و یار تو باشد(@)(@@) 95 اجل با تیغ تو باشد کجا پیکار تو باشد %~% قضا باتیغ تو آنجا رود کآزار تو باشد(@)(@@) 96 به وقتی کز دولشکر گاه بانگ کوس برخیزد %~% خروش کوس گردان را زخواب خوش برانگیزد(@)(@@) 97 علامت کش به گوش نیزه منجوق اندر آویزد %~% برآید نیلگون ابری که گل برزعفران بیزد(@)(@@) 98 یلان را سرخی اندر روی با زردی در آمیزد %~% بخندد تیغ و از چشمش بوقت خنده خون ریزد(@)(@@) 99 چو گویند اینک آمد میر تا با خصم بستیزد %~% ز دو لشکر نماند هیچ سالاری که نگریزد(@)(@@) 100 کسی کز مرگ نندیشد نه از کشتن بپرهیزد %~% ز بیم و هیبت شمشیر او بر اسب خون میزد(@)(@@) 101 گر اندرو وهم گنجیدی جهان میدان تو بودی %~% ور اندر عقل شایستی سپهر ایوان تو بودی(@)(@@) 102 چو هندوی فلان رضوان به در دربان تو بودی %~% درخت طوبی اندر ساحت بستان تو بودی(@)(@@) 103 همیدون کوثر اندر ژرف ماهیدان تو بودن %~% به خلوت هر شبی حور دگر مهمان تو بودی(@)(@@) 104 هر آن چیزی کز آن اندیشه کردی زان تو بودی %~% از ایزد آیتی چون نام تو درشان توبادی(@)(@@) 105 پس از فرمان ایزد در جهان فرمان تو بودی %~% بقای این جهان اندر گرامی جان تو بودی(@)(@@) 106 امیرا! توبه هر خوبی و نیکویی 
ms447	 سزاواری %~% ازیرا خوب کرداری چنان چون خوب دیداری(@)(@@) 107 توان گفتن ترا کاندر جهان فردی و بی یاری %~% به دانایی و بینایی و بیداری و هشیاری(@)(@@) 108 حدیث ملک و کار عالم و شغل جهانداری %~% تو اندرخواب به ورزی که دیگر کس به بیداری(@)(@@) 109 بخیلی را همی اندر دیار خویش نگذاری %~% کریمی را ورادی را همی آیین پدید آری(@)(@@) 110 بکوشی تادل کس را به گفتاری نیازاری %~% تو گر خواهی چنین چیزی ندانی کرد پنداری(@)(@@) 111 سزای تو ترا شاها ندانم آفرین گفتن %~% همی شرم آیدم زین خام گفتاری چنین گفتن(@)(@@) 112 خجل گشتم ز بس حلم ترا کوه وزمین گفتن %~% فرو ماندم ز بس جود ترا ما معین گفتن(@)(@@) 113 حدیث تیغ و تیرو قصه تاج و نگین گفتن %~% ترا بر کشوری یا برفزونتر زان امین گفتن(@)(@@) 114 جلال وهمت و قدر ترا چرخ برین گفتن %~% پناه داد و دین خواندن بلای کفرو کین گفتن(@)(@@) 115 چه خوانم مرترا شاها که دل شد سیر ازین گفتن %~% بگو تامن بگردانم ترا مدح متین گفتن(@)(@@) 116 خداوندا! گهر دانی که شهری پر گهر بیند %~% بکوشد تا بچیند هر چه درقیمت ز بربیند(@)(@@) 117 چو بر گردد گهر هر جای از جنس دگر بیند %~% زمین را از گهر چون گلستان بارور بیند(@)(@@) 118 همه گوهر سزای تاج و زیبای کمر بیند %~% کمینه گوهر اندر قیمت یک تنگ زر بیند(@)(@@) 119 بماند خیره در چندین گهر کز پیش در بیند %~% نداند زان چه برگیرد که اندر پیش بر بیند(@)(@@) 120 گهرهای بهایی گونه گون اندر گذر بیند %~% گذرها را همه پراز لآلی و گهر بیند(@)(@@) 121 جوان دولت خداوندا! جوانبخت و جوان بادی %~% فراوان دوستان داری به کام دوستان بادی(@)(@@) 122 جهانداری ترا زیبد خداوند جهان بادی %~% ز دولت بهره ور بادی به شاهی شادمان بادی(@)(@@) 123 همیشه کامران بودی هماره کامران بادی %~% به از نوشین روان گفتی به از نوشیروان بادی 
