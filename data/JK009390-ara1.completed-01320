ms1301	 من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11551 ) قال النبي :(@)(@@) | 30 ( خذ الأمر بالله بالتدبير ، إذا رأيت في عاقبته خيرا فأمض ، وإن خفت غيا فأمسك ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11552 ) قال النبي :(@)(@@) | 30 ( خذ هاذه فتحصر بها يوم القيامة ، فإن المتحصرين يومئذ قليل ، قال : يا رسول الله لماذا قال : آية بيني وبينك يوم القيامة ) )(@)(@@) PageV04P269 ( حم ع ) و ابن خزيمة ( حب طب ض ) عن عبد الله بن أنيس الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11553 ) قال النبي :(@)(@@) | 30 ( خذ هاذا ولا تضربه ، فإني قد رأيته يصلي مقبلنا من خيبر ، وإني قد نهيت عن ضرب أهل الصلاة ) )(@)(@@) ( حم طب ص ) عن أبي أمامة ( خط ) عن المعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11554 ) قال النبي :(@)(@@) | 30 ( خذ هاذا واستوص بهه خيرا فإني رأيته يصلى ، وإني نهيت عن قتل المصلين ) )(@)(@@) ( ص هب ) عن عمر بن أبي أبيه .(@)(@@)(@@)(@@) $ ( 11555 ) قال النبي :(@)(@@) | 30 ( خذ فاغز في سيل الله فقاتلوا من كفر بالله ، لا تغلوا وعلا تغدروا ولا تمثلوا ، ولا تقتلوا وليدا ، فهاذا عهد الله ومسيرة نبيه ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11556 ) قال النبي :(@)(@@) | 30 ( خذ هاذا العرجون فتحصن به ، فإنك إذا خرجت أضاء لك عشرا أمامك ، وعشرا خلفك ، إذا دخلت فاضرب به مثل الحجر الأخش فى أستار البيت فإن ذالك الشيطان ) )(@)(@@) ( طب ) عن قتادة بن النعمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11557 ) قال النبي :(@)(@@) | 30 ( خذه فتموله أو تصدق به وما جاءك من هاذا المال وأنت غير مشرف ولا سائل فخذه ، ومالا ، فلا تتبعه نفسك ) )(@)(@@) ( حم خ م ن ) عن أبي هريرة عن سالم بن عبد الله بن عمر عن أبيه عن جده ( خ د ) عن الزهري عن السائب بن يزيد عن حويطب بن عبد العزى عن عبد الله بن السعدى عن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 11558 ) قال النبي :(@)(@@) | 30 ( خذها وأنا ابن العواتك ) )(@)(@@) عن سل يم ( كر ) عن جابر PageV04P270 قال : رأيت رسول الله يوما ضرب بسيفه في سبيل الله وقال فذكره .(@)(@@)(@@)(@@) $ ( 11559 ) قال النبي :(@)(@@) | 30 ( خذهن قبل أن 
ms1302	 يحال بينك وبينهن : الباقيات الصالحات فإنهن من كنوز الجنة : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11560 ) قال النبي :(@)(@@) | 30 ( خذوا متاعكم عنها وأرسلوها فإنها ملعونة ) )(@)(@@) ( حب ) عن عمران بن حصين أن امرأة لعنت ناقة لها فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 11561 ) قال النبي :(@)(@@) | 30 ( خذوها يا بني طلحة خالدة تالدة لا ينزعها منكم إلا ظالم يعني حجابة الكعبة ) )(@)(@@) ابن سعد ( طب كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11562 ) قال النبي :(@)(@@) | 30 ( خذوا من قول قريش ) )(@)(@@) ( كر ) عن الشعبي عن عامر بن شهر الهمداني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11563 ) قال النبي :(@)(@@) | 30 ( خذوا العطاء ما دام عطاء ، وإذا صار رشوة علاى الدين فلا تأخذوه ، ولستم بتاركيه يمنعكم الفقر والحاجة ، أصلا إن رحى الإسلام دائرة ، فدوروا مع الكتاب حيث دار ، ألا إن الكتاب والسلطان سيفترقان فلا تفارقوا الكتاب ، ألا إنه سيكون عليكم أمراء يقضون لأنفسهم ما يقضون إن عصيتموهم قتلوكم ، وإن أطعتموهم أضلوكم ، قالوا : مريم ، نشروا بالمناشير ، وحملوا علاى الخشب ، موت في طاعة الله خير من حياة في معصية الله ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11564 ) قال النبي :(@)(@@) | 30 ( خذوا العطاء ما كان إنما هو رشاء فاتركوه ، ولا أراكم تفعلون ، يحملكم علاى ذالك الفقر والحاجة ، ألا وإن رحى بني مرخ قد دارت ، وبان رحى الأسلام دائرة ، ( سقط : وإن الكتاب والسلطان سيفترفان فدوروا مع الكتاب حيثما دار ، وستكون عليكم أئمة إن أطعتموهم أضلوكم ، ) وإن PageV04P271 عصيتموهم قتلوكم ، قالوا : كيف نصنع يا رسول الله ؟ كونوا كأصحاب عيسى نصبوا علاى الخشب ونشروا بالمناشير ، موت في طاعة خير من حياة في معصية ) )(@)(@@) ( كر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11565 ) قال النبي :(@)(@@) | 30 ( خذوا من العبادة بقدر ما تطيقون ، وإياكم أن يتعود أحدكم عبادة فيرجع عنها ، فإنه ليس شيء أشد علاى الله من أن يتعود الرجل العبادة ثم يرجع عنها ) )(@)(@@) الديلمى عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11566 ) قال النبي :(@)(@@) | 30 ( خذوا ما بال عليه من 
ms1303	 التراب فألقوه ، واهرقوا علاى مكانه ماء ) )(@)(@@) ( د ) عن عبد الله بن معقل ابن مقرن مرسلا .(@)(@@)(@@)(@@) $ ( 11567 ) قال النبي :(@)(@@) | 30 ( خذوا الناس بالميسر ولا تملوهم ، فإن المؤمنين رفقاء رحماء ) ) الديلمي عن أنس رضي الله عنه(@)(@@)(@@)(@@) $ ( 11568 ) قال النبي :(@)(@@) | 30 ( خذوا ما وجدتم وليس لكم إلا ذالك قاله للغرماء ) )(@)(@@) ( حم ) وعبد بن حميد ( ت ) حسن صحيح عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11569 ) قال النبي :(@)(@@) | 30 ( خذوا علاى أيدي سفهائكم قبل أن يعمهم الله بعقاب ) )(@)(@@) ابن النجار عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11570 ) قال النبي :(@)(@@) | 30 ( خذوا له عثكالافيه مائة شمراخ فاضربوه ضربة واحدة وخلوا سبيله ) )(@)(@@) ( حم طب ) عن سعيد بن المسيب بن عنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11571 ) قال النبي :(@)(@@) | 30 ( خذوا ودعوا الثلث ، فإن علم تدعوا الثلث فدعوا الربع ) )(@)(@@) ( طب ) عن سهل بن أبي خيثمة أن النبي قاله للخراص .(@)(@@) PageV04P272(@)(@@)(@@)(@@) $ ( 11572 ) قال النبي :(@)(@@) | 30 ( خذوا من عرض لحاكم واعفوا طولها ) )(@)(@@) أبو عبيد الله بن مخلد الذوري العطار في حزبه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11573 ) قال النبي : ((@)(@@) | 30 خذواليعلم يهود أن في ديننا فسحة وأني بعثت بالحنيفية السمحة ) )(@)(@@) الديلمي من وجه آخر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11574 ) قال النبي :(@)(@@) | 30 ( خذوا من هاذا ودعوا هاذا يعني يأخذ من عنفقته ويدع لحيته ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الخاء مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11575 ) قال النبي :(@)(@@) | 30 ( خرج رجل ممن كان قبلكم فى حلة له يختال فيها ، فأمر الله الأرض فأخذته يتجلجل فيها إلاى يوم القيامة ) )(@)(@@) ( ت ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11576 ) قال النبي :(@)(@@) | 30 ( خرج نبى من الأنبياء بالناس يستسقون الله تعالاى ، فإذا هو بنملة رافعة بعض قوائمها إلاى السماء فقال : ارجعوا فقد استجيب لكم من أجل هاذه النملة ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11577 ) قال النبي :(@)(@@) | 30 ( خرجت من لدن آدم من نكاح غير سفاح ) )(@)(@@) ابن سد عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11578 ) قال النبي :(@)(@@) | 30 ( خرجت من نكاح غير سفاح 
ms1304	 ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@) PageV04P273(@)(@@)(@@)(@@) $ ( 11579 ) قال النبي :(@)(@@) | 30 ( خرجت من نكاح ولم أخرج من سفاح ، من لدن آدم إلى إن ولدني أبي وأمي لم يصبني من سفاح الجاهلية شيء العدني ) )(@)(@@) ( عد طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11580 ) قال النبي :(@)(@@) | 30 ( خرجت وأنا أريد أن أن أخبركم بليلة القدر فتلاحى رجلان فاختلجت مني فاطلبوها في العشر الأواخر في سابعة تبقى ، أو تاسعة تبقى ، أو خامسة تبقى ) )(@)(@@) الطيالسى عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11581 ) قال النبي :(@)(@@) | 30 ( خروج الآيات بعضها علاى أثر بعض يتتابعن كما تتابع الخرز في النظام ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11582 ) قال النبي :(@)(@@) | 30 ( خروج الإمام يوم الجمعة للصلاة يقطع الصلاة ، وكلامه يقطع الكلام ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11583 ) قال النبي :(@)(@@) | 30 ( خرجت من نكاح ولم أخرج من سفاح ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ( عب ) عن جعفر بن محممد عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 11584 ) قال النبي :(@)(@@) | 30 ( خرجت لصلاة الصبح فلقيني شيطان في السدة ، سدة المسجد ، فزحمني حتى إني أجد مس شعره فاستمكنت منه فخنقته ، حتى إني لأجد برد لسانه علاى يدي ، فلولا دعوة أخي سليمان لأصبح مقتولا تنظرون إليه ) )(@)(@@) عبد بن حميد وابن مردويه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11585 ) قال النبي :(@)(@@) | 30 ( خرجت إليكم وعقد بينت لي ليلة القدر ومسيح الضلالة ، فكان تلاح بين رجلين بسدة المسجد فأتيتهما لأحجز بينهما فأنسيتهما ، PageV04P274 وسأشدو لكم منهما شدوا ، أما ليلة القدر فالتمسوها في العشر الأواخر وترا ، وأما مسيح الضلالة فإنه أعور العين ، أجلاى الجبهة عريض النحر ، فيه دفا كأنه عبد العزى بن قطن قال : يا رسول الله هل يضرني شبهه قال : لا ، أنت امرؤ كافر ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11586 ) قال النبي :(@)(@@) | 30 ( خرجت طائفة من بني إسرائيل حتى أتوا مقبرة لهم ، قالوا : لو صلينا ركعتين ودعونا الله أن يخرج لنا رجلا ممن قد مات فنسأله عن الموت ، ففعلوا 
ms1305	 ، فبينما هم كذالك إذ أطلع رجل رأسه من قبر بين عينيه أثر السجود ، فقال : يا هاؤلاء ما أردتم إلي ؟ فقد مت منذ مائة سنة فما سكنت عني حرارة الموت حتى الآن ، فادعوا الله أن يعيدني كما كنت ) )(@)(@@) عبد بن حميد ، ( ع ) وابن منيع ، ( ص ) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11587 ) قال النبي :(@)(@@) | 30 ( خرجت بنو إسرائيل في طلب زكريا ليقتلوه ، فخرج هاربا في البرية فانفرجت له شجرة فدخل فيها ، فبقيت هدبة من ثوبه ، فجاءوا حتى قاموا عليها ، فنشروه بالمنشار ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11588 ) قال النبي :(@)(@@) | 30 ( خرج نبي الله داود ذات ليلة فقال : لا يسأل الله أحد إلا استجيب له ، ألا أن يكون ساحرا أو عشارا ) )(@)(@@) ( ك ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11589 ) قال النبي :(@)(@@) | 30 ( خرج من عندي خليلي جبريل آنفا فقال : يا محمد والذي بعثك بالحق ، إن لله عبدا من عباده عبد الله تعالاى خمسمائة سنة علاى رأس جبل في البحر عرضه وطوله خمسون ذراعا في ثلاثين ذراعا ، والبحر محيط به بأربعة آلاف فرسخ من كل ناحية ، وأخرج الله له عينا عذبة بعرض الإصبع تبض بماء عذب فتستنقع في أسفل الجبل ، وشجرة رمان تخرج في كل PageV04P275 ليلة رمانة فتغذيه يومه ، فإذا أمسى نزل فأصاب من الوضوء وأخذ تلك الرمانة فأكلها ثم قام لصلاته ، فسأل ربه عند وقت الأجل أن يقبضه ساجدا وإن لا يجعل للأرض ولا لشيء يفسده عليه سبيلا حتى يبعثه وهو ساجد ففعل ، فنحن نمر عليه إذا هبطنا وإذا عرجنا فنجد له في العلم أنه يبعث يوم القيامة فيوقف بين يدي الله تعالاى فيقول له الرب تبارك وتعالاى : أدخلوا عبدي الجنة برحمتي ، فيقول : يا رب بل بعملي ، فيقول الله : حاسبوا عبدي بنعمتي عليه وبعمله ، فتوجد نعمة البصر قد أحاطت بعبادة خمسمائة سنة وبقيت نعمة الجسد فضلا عليه ، فيقول : أدخلوا عبدي النار ، فيجر إلاى النار ، فينادى يا رب برحمتك أدخلني الجنة ، فيقول : ردوه فيوقف بين يديه فيقول يا عبدي 
ms1306	 من خلقك ولم تك شيئا ؟ فيقول : أنت يا رب ، فيقول يا من قواك لعبادة خمسمائة سنة ؟ فيقول : أنت يا رب ، فيقول : من أنزلك في جبل وسط اللجة وأخرج لك الماء العذب من الماء المالح ، وأخرج لك كل ليلة رمانة ، وإنما تخرج مرة في السنة ، وسألتني أن أقبضك ساجدا ففعلت ذالك بك ، فيقول : أنت يا رب ، فقال الله : فذالك برحمتي ، وبرحمتي أدخلك الجنة ، قال جبريل : إنما الأشياء برحمة الله يا محمد ) )(@)(@@) الحكيم ( ك ) ونعقب ( ع ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع الزاي(@)(@@) من الجامع الصغير وزوائده ) 3 $(@)(@@)(@@)(@@) $ ( 11590 ) قال النبي :(@)(@@) | 30 ( خزائن الله الكلام ، إذا أراد شيئا يقول له كن فيكون ) )(@)(@@) أبو الشيخ في العضمة عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV04P276(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11591 ) قال النبي :(@)(@@) | 30 ( خزاعة منى وأنا منهم ، خزاعة الوالدة والولد ) )(@)(@@) الديلمي عن بشر بن عصمة المري رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع الشين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11592 ) قال النبي :(@)(@@) | 30 ( خشية الله رأس كل حكمة ، والورع سيد العمل ) )(@)(@@) القضاعي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع الصاد(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11593 ) قال النبي :(@)(@@) | 30 ( خصاء أمتي الصيام والقيام ) )(@)(@@) ( حم طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11594 ) قال النبي :(@)(@@) | 30 ( خص البلاء بمن عرف الناس ، وعاش فيهم لم يعرفهم ) )(@)(@@) القضاعي عن محمد بن علي مرسلا .(@)(@@)(@@)(@@) $ ( 11595 ) قال النبي :(@)(@@) | 30 ( خصال ست ما من مسلم يموت في واحدة منهن إلا كان ضامنا علاى الله أن يدخله الجنة : رجل خرج مجاهدا فإن مات في وجهه كان ضامنا علاى الله ، ورجل تبع جنازة فإن مات في وجهه كان ضامنا علاى الله ، PageV04P277 ورجل توضأ فأحسن الوضوء ثم خرج إلاى المسجد لصلاة فإن مات في وجهه كان ضامنا علاى الله ، ورجل في بيته لا يغتاب المسلمين ولا يجر إليه سخطا ولا تبعة ، فإن مات في وجهه كان ضامنا علاى الله ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11596 ) قال النبي :(@)(@@) | 30 ( خصال لا تنبغي في المسجد : لا 
ms1307	 يتخذ طريقا ، ولا يشهر فيه سلاح ، ولا يقبض فيه بقوس ، ولا ينثر فيه نبل ، ولا يمر فيه بلحم نيء ، ولا يضرب فيه حد ، ولا يقتص فيه من أحد ، ولا يتخذ سوقا ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11597 ) قال النبي :(@)(@@) | 30 ( خصلتان معلقتان في أعناق المؤذنين للمسلمين : صيامهم وصلاتهم ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11598 ) قال النبي :(@)(@@) | 30 ( خصلتان من كانتا فيه كتبه الله شاكرا صابرا ، ومن لم يكونا فيه لم يكتبه الله لا شاكرا ولا صابرا : من نظر في دينه إلى من هو فوقه فاقتدى به ، ونظر في دنياه إلى من هو دونه فحمد الله على ما فضله به عليه كتبه الله شاكرا صابرا ، ومن نظر في دينه إلى من هو دونه ، ونظر في دنياه إلى من هو فوقه فأسف على ما فاته منه لم يكتبه الله شاكرا ولا صابرا ) )(@)(@@) ( ت ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11599 ) قال النبي :(@)(@@) | 30 ( خصلتان لا تجتمعان في مؤمن : البخل وسوء الخلق ) )(@)(@@) ( خد ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11600 ) قال النبي :(@)(@@) | 30 ( خصلتان لا يجتمعان في منافق : حسن سمت ، ولا فقه في الدين ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11601 ) قال النبي :(@)(@@) | 30 ( خصلتان لا يحافظ عليهما عبد مسلم إلا دخل PageV04P278 الجنة ، ألا وهما يسير ومن يعمل بهما قليل : يسبح الله في دبر كل صلاة عشرا ، ويحمده عشرا ، ويكبره عشرا فذالك ومائة باللسان وألف وخمسمائة فى الميزان ، ويكبر أربعا وثلاثين إذاأخذ مضجعه ، ويحمده ثلاثا وثلاثين ، ويسبح ثلاثا وثلاثين فتلك مائة باللسان وألف في المييزان ، فأيكم يعمل في اليوم والليلة ألفين وخمسمائة سيئة ) )(@)(@@) ( حم خد 4 ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11602 ) قال النبي :(@)(@@) | 30 ( خصلتان لا يحل منعهما : الماء والنار ) )(@)(@@) البزار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11603 ) قال النبي :(@)(@@) | 30 ( خصلتان من أخلاق العرب وهما من عمود الدين يوشك أن يدعوهما ، الحياء والأخلاق الكريمة ) )(@)(@@) أبو الشيخ عن ابن عمرو رضي الله 
ms1308	 عنه .(@)(@@)(@@)(@@) $ ( 11604 ) قال النبي :(@)(@@) | 30 ( خصلتان لا يحافظ عليهما عبد مسلم إلا دخل الجنة ، ألا وهما يسير ومن يعمل بهما قليل : يسبح الله في دبر كل صلاة عشرا ، ويحمده عشرا ، ويكبره عشرا فذالك خمسون ومائة باللسان وألف وخمسمائة في الميزان ، ويكبر أربعا وثلاثين إذا أخذ مضجعه ، ويحمد ثلاثا وثلاثين ، ويسبح ثلاثا وثلاثين ، فتلك مائة باللسان وألف في الميزان ، فأيكم يعمل في اليوم والليلة ألفين وخمسمائة ا قالوا : يا رسول الله كيف هما يسير ومن يعمل بهما قليل ؟ قال : يأتي أحدكم الشيطان في منامه فينومه قبل أن يقرأها ، ويأتيه في صلاته فيذكره حاجة قبل أن يقولها ) )(@)(@@) ( عب ش حم د ت ) حسن صحيح ( ن ه حب ) و ابن السني ( هب ) وابن شاهين في الترغيب وابن جرير عن ابن عمرو رضي الله عنه .(@)(@@) PageV04P279(@)(@@)(@@)(@@) ||| ( الخاء مع الضاد(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11605 ) قال النبي :(@)(@@) | 30 ( خضاب الإسلام الصفرة ، وخضاب الإيمان الحمرة ) )(@)(@@) الديلمي عن عبد الله بن هداج رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع الطاء(@)(@@) من الجامع الصغير وزوائده(@)(@@)(@@)(@@) $ ( 11606 ) قال النبي :(@)(@@) | 30 ( خطوتان : إحداهما أحب الخطا إلاى الله عز وجل ، والأخرى أبغض الخطا إلاى الله ، فأما التي يحبها : فرجل نظر إلاى خلل في الصف فسده ، وأما التي يبغض : فإذا أراد الرجل أن يقوم مد رجله اليمنى ووضع يده عليها وأثبت اليسرى ثم قام ) )(@)(@@) ( ك هق ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11607 ) قال النبي :(@)(@@) | 30 ( خفف علاى داود القرآن ، فكان يأمر بدوابه فتسرج فيقرأ القرآن من قبل أن تسرج دوابه ، ولا يأكل إلا من عمل يده ) )(@)(@@) حم خ ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P280(@)(@@)(@@)(@@) $ ( 11608 ) قال النبي :(@)(@@) | 30 ( خففوا بطونكم وظهوركم لقيام الصلاة ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الخاء مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11609 ) قال النبي :(@)(@@) | 30 ( خلفت فيكم شيئين لن تضلوا بعدهما : كتاب الله وسنتي ، ولن يتفرقا حتى يردا علي الحوض ) )(@)(@@) أبو بكر الشافعي في الغيلانيات عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11610 
ms1309	 ) قال النبي :(@)(@@) | 30 ( خلق الإنسان والحية ، سواء إن رآها أفزعته ، وإن لدغته أوجعته ، فاقتلوها حيث وجدتموها ) )(@)(@@) الطيالسي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11611 ) قال النبي :(@)(@@) | 30 ( خلق الله آدم علاى صورته ، وطوله ستون ذراعا ، ثم قال : اذهب فسلم علاى أولائك النفر ، وهم نفر من الملائكة جلوس فاستمع ما يحيونك ، فإنها تحيتك وتحية ذريتك ، فذهب فقال : السلام عليكم ، فقالوا : السلام عليك ورحمة الله ، فزادوه ورحمة الله ، فكل من يدخل الجنة علاى صورة آدم في طوله ستون ذراعا فلم تزل الخلق تنقص بعده حتى الآن ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11612 ) قال النبي :(@)(@@) | 30 ( خلق الله آدم فضرب كتفه اليمنى فأخرج ذرية بيضاء كأنهم اللبن ، ثم ضرب كتفه اليسرى فخرجت ذرية سوداء كأنهم الحمم ، قال : PageV04P281 هاؤلاء في الجنة ولا أبالي ، وهاولاء في النار ولا أبالي ) )(@)(@@) ابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11613 ) قال النبي :(@)(@@) | 30 ( خلق الله آدم من تراب الجابية وعجنه بماء الجنة ) )(@)(@@) الحكيم ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11614 ) قال النبي :(@)(@@) | 30 ( خلق الله التربة يوم السبت وخلق فيها الجبال يوم الأحد ، وخلق الشجر يوم الإثنين ، وخلق المكروه يوم الثلاثاء ، وخلق يوم الأربعاء وبث فيها الدواب يوم الخميس وخلق آدم بعد العصر من يوم الجمعة آخر الخلق في آخر ساعة من ساعات الجمعة فيما بين العصر إلاى الليل ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11615 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل الجن ثلاثة أصناف : صنف حيات وعقارب وخشاش الأرض ، وصنف كالريح في الهواء ، وصنف عليهم الحساب والعقاب ، وخلق الله الإنس ثلاثة أصناف كالبهائم ، وصنف أجسادهم أجساد بني آدم وأرواحهم أرواح الشياطين ، وصنف في ظل الله يوم لا ظل إلا ظله ) )(@)(@@) الحكيم وابن أبي الدنيا في مكائد الشيطان وأبو الشيخ في العظمة وابن مردويه عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11616 ) قال النبي :(@)(@@) | 30 ( خلق الله الحور العين من الزعفران ) )(@)(@@) عن أبي أمامة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11617 ) قال النبي :(@)(@@) | 30 
ms1310	 ( خلق الله الخلق فكتب آجالهم وأعمالهم وأرزاقهم ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11618 ) قال النبي :(@)(@@) | 30 ( خلق الله جنة عدن وغرس أشجارها بيده فقال لها PageV04P282 تكلمي ، فقالت : قد أفلح المؤمنون ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11619 ) قال النبي :(@)(@@) | 30 ( خلق الله مائة رحمة ، فوضع رحمة واحدة بين خلقه يتراحمون بها ، وخبأ عنده مائة إلا واحدة ) )(@)(@@) ( م ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11620 ) قال النبي :(@)(@@) | 30 ( خلق الله يحيى بن زكريا في بطن أمه مؤمنا ، وخلق فرعون في بطن أمه كافرا ) )(@)(@@) ( عد طب ) عن ابن مسعزد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11621 ) قال النبي :(@)(@@) | 30 ( خلقان يحبهما الله ، وخلقان يبغضهما الله ، فأما اللذان يحبهما الله : فالسخاء والسماحة ، وأما اللذان يبغضهما الله : فسوء الخلق والبخل ، وإذا أراد الله بعبد خيرا استعمله على قضاء حوائج الناس ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11622 ) قال النبي :(@)(@@) | 30 ( خلقت الملائكة من نور ، وخلق الجان من مارج من نار ، وخلق آدم مما وصف لكم ) )(@)(@@) ( حم م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11623 ) قال النبي :(@)(@@) | 30 ( خلقت التخلة والرمان والعنب من فضل طينة آدم ) )(@)(@@) ابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11624 ) قال النبي :(@)(@@) | 30 ( خلل أصابع يديك ورجليك ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11625 ) قال النبي :(@)(@@) | 30 ( خللوا بين أصابعكم لا يخلل الله بينها بالنار ، ويل للأعقاب من النار ) )(@)(@@) ( قط ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11626 ) قال النبي :(@)(@@) | 30 ( خللوا بين أصابعكم لا يخللها الله يوم القيامة PageV04P283 بالنار ) )(@)(@@) ( قط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11627 ) قال النبي :(@)(@@) | 30 ( خللوا لحاكم وقصوا أظفاركم ، فإن الشيطان يجري ما بين اللحم والظفر ) )(@)(@@) ( خط ) في الجامع و ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11628 ) قال النبي :(@)(@@) | 30 ( خليلي من هاذه الأمة أويس القرني ) )(@)(@@) ابن سعد عن رجل مرسلا .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11629 ) قال النبي :(@)(@@) | 30 ( خل عنه يا عمر فلهي أسرع فيهم من نضح النبل ) )(@)(@@) ( ت ) حسن صحيح غريب ( ن 
ms1311	 ) عن أنس أن عمر قال لابن رواحة بين يدي رسول الله وفي حرم الله تقول الشعر ؟ قال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 11630 ) قال النبي :(@)(@@) | 30 ( خل عنه يا عمر ، فوالذي نفسي بيده لكلامه أشد عليهم من وقع النبل ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11631 ) قال النبي :(@)(@@) | 30 ( خلقان يحبهما الله ، وخلقان يبغضهما الله عز وجل : فأما اللذان يحبهما الله فالسخاء والسماحة وأما اللذان يبغضهما الله تعالى فسوء الخلق والبخل ) )(@)(@@) الديلمي عن ابن عمير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11632 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل مكة فوضعها على المكروهات والدرجات ) )(@)(@@) ( ك ) في تاريخه عن أبي هريرة وابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11633 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل أحجارا قبل أن يخلق السماوات والأرض بألف سنة ثم أمر أن يوقد عليها ، اتخذها الله لإبليس ولفرعون ومن حلف باسمه كاذبا ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@) PageV04P284(@)(@@)(@@)(@@) $ ( 11634 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل الدنيا على سبعة آماد ، والأمد : الدهر الطويل الذي لا يحصيه إلا الله ، فهن من الدنيا قبل خلق آدم ستة آماد ، ومنذ خلق الله آدم إلى أن تقوم الساعة أنتم في أمد واحد ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11635 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل كفة الميزان ملء السماوات والأرض ، فقالت الملائكة : يا ربنا ما تزن بهاذا ؟ قال : أذن به ما شئت ، وخلق الله الصراط كحد السيف أو كحد الموسى ، فقالت الملائكة : يا ربنا من تجيز على هاذا ؟ قال : أجيز عليه من شئت ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11636 ) قال النبي :(@)(@@) | 30 ( خلق الله تعالى الخلق ، وقضى القضية ، وأخذ ميثاق النبيين ، وعرشه على الماء ، فأخذ أهل اليمين بيمينه ، وأخذ أهل الشمال بيده الأخرى ، وكلتا يدي الرحمان يمين ، فقال : يا أصحاب اليمين فاستجابوا له ، فقالوا : لبيك ربنا وسعديك ، قال : ألست بربكم ؟ قالوا : بلى ، قال : يا أصحاب الشمال فاستجابوا له فقالوا : لبيك ربنا وسعديك ، قال : ألست بربكم ؟ قالوا : بلى ، فخلط بعضهم ببعض ، فقال قائل منهم : رب لم 
ms1312	 خلطت بيننا ؟ قال : لهم أعمال من دون ذالك هم لها عاملون أن يقولوا يوم القيامة إنا كنا عن هاذا غافلين ثم ردهم في صلب آدم ، فأهل الجنة أهلها ، وأهل النار أهلها ، قيل : يا رسول الله فما الأعمال ؟ قال : يعمل كل قوم بمنزلتهم ) )(@)(@@) عبد بن حميد والحكيم ( عق طب ) وأبو الشيخ في العظمة وابن مردويه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11637 ) قال النبي :(@)(@@) | 30 ( خلق الله تعالى ملكين يردان السلام على من سلم علي من شرق البلاد وغربها إلا من سلم علي في داري فإني أرد عليه السلام بنفسي ، ولا سيما أهل المدينة فإني أرد عليهم لأحسابهم وأنسابهم ، قيل : وهل تعرفهم وهم يتناسلون من بعدك ؟ قال : وهل لا يعرف الجار جاره ؟ وهل لا يعرف PageV04P285 الجار جاره ، وهل لا يعرف الجار جاره ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11638 ) قال النبي :(@)(@@) | 30 ( خلق الله تعالى لوحا من درة بيضاء دفتاه من زبرجدة خضراء ، كتابه نور يلحظ به في كل يوم ثلاثمائة وستين لحظة ويحيي ويميت ويخلق ويرزق ويفعل ما يشاء ) )(@)(@@) أبو الشيخ في العظمة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11639 ) قال النبي :(@)(@@) | 30 ( خلق الله ثلاثة أشياء بيده ، خلق آدم بيده ، وكتب التوراة بيده ، وغرس الفردوس بيده ) )(@)(@@) عن الحارث بن نوفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11640 ) قال النبي :(@)(@@) | 30 ( خلق الله الملائكة من نور ، وإن منهم لملائكة أضغر من الذباب ، وخلق الله الملائكة ثم يقول : ليكن أحلف ليكن ألفان ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11641 ) قال النبي :(@)(@@) | 30 ( خلق الله مكة فحفها بالملائكة قبل أن يخلق شيئا من الأرض كلها بألف عام ، ثم وصلها بالمدينة ، ووصل المدينة ببيت المقدس ، وخلق الأرض بعد ألف عام خلقا واحدا ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11642 ) قال النبي :(@)(@@) | 30 ( خلق الله آدم من طينة الجابية ، وعجنه بماء من ماء زمزم ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11643 ) قال النبي :(@)(@@) | 30 ( خلق الله السماء الدنيا من الموج المكفوف ، وفي لفظ 
ms1313	 : من دخان وماء ثم رفعها وجعل فيها سراجا مضيئا وقمرا منيرا ، وحفها بالنجوم وجعلها رجوما للشياطين ، وحفظها مت كل شيطان رجيم ، وخلق الأرض من الزبد الجفاء والماء ، وجعلها على صخرة فوق ظهر حوت يتفجر منها الماء لو انخرق منها خرق لأذرت الأرض ومن عليها ) )(@)(@@) ( كر ) عن ابن مسعود وابن عباس PageV04P286 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11644 ) قال النبي :(@)(@@) | 30 ( خلق الله جنة عدن بيده ، خلق فيها ما لا عين رأت ، ولا خطر على قلب بشر ، ثم قال لها تكلمي فقالت : قد أفلح المؤمنون ، فقال : وعزتي لا يجاورتي فيك بخيل ) )(@)(@@) ( طب ) في السنة وتمام ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11645 ) قال النبي :(@)(@@) | 30 ( خلق الله آدم عليه السلام حين خلقه ، فضرب كتفه اليمنى فأخرج ذرية بيضاء كأنهم اللبن ، ثم ضرب كتفه اليسرى فأخرج ذرية سوداء كأنهم الحمم ، فقال للذي في يمينه : هاؤلاء في الجنة ولا أبالي ، وقال للذي في كتفه اليسرى : هاؤلاء في النار ولا أبالي ) )(@)(@@) ( حم كر طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11646 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل أول الأيام يوم الأحد ، وخلقت الأرض في يوم الأحد ويوم الاثنين ، وخلقت الجبال ، وشقت الأنهار ، وغرس في الأرض الثمار ، وقدر في كل أرض قوتها يوم الثلاثاء ويوم الأربعاء ، ثم استوى إلى السماء وهي دخان فقال لها وللأرض ائتيا طوعا أو كرها قالتا أتينا طائعين فقضاهن سبع سموات في يومين ، وأوحى في كل سماء أمرها في يوم الخميس ويوم الجمعة ، وكان آخر الخلق في آخر الساعات يوم الجمعة ، فلما كان يوم السبت لم يكن فيه خلق ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11647 ) قال النبي :(@)(@@) | 30 ( خلق الله عز وجل الأرض يوم الأحد والاثنين ، وخلق الجبال يوم الثلاثاء وما فيهن من منافع ، وخلق يوم الأربعاء والماء والمدائن والعمران والخراب ، وخلق يوم الخميس السماء ، وخلق يوم الجمعة PageV04P287 النجوم والسمس والقمر والملائكة إلى ثلاث ساعات بقين منه فخلق في أول ساعة من هاذه الثلاث ساعات الآجال حين يموت من مات 
ms1314	 ، وفي الثانية ألقى الألفة على كل شيء مما ينتفع به الناس ، وفي الثالثة آدم وأسكنه الجنة وأمر إبليس بالسجود له ، وأخرجه منها في آخر ساعة ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11648 ) قال النبي :(@)(@@) | 30 ( خلق الله اللؤم فحفه بالبخل والملل ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11649 ) قال النبي :(@)(@@) | 30 ( خلق كل إنسان من بني آدم على ستين وثلاثمائة مفصل ، فمن كبر الله وحمد الله وهلل الله وسبح الله واستغفر الله ، وعزل حجرا عن طريق ، أو عزل شوكة عن الطريق ، أو عزل عظما عن طريق الناس ، أو أمر بمعروف ، أو نهى عن منكر عدد تلك الستين والثلاثمائة فإنه يحشر يوم القيامة وقد زحزح نفسه عن النار ) )(@)(@@) ( م ) و أبو الشيخ في العظمة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11650 ) قال النبي :(@)(@@) | 30 ( خلق الحور العين من تسبيح الملائكة فليس فيهن أذى ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11651 ) قال النبي :(@)(@@) | 30 ( خلق الناس على طبقات شتى ، منهم من يولد مؤمنا ويحيى مؤمنا ويموت مؤمنا ، منهم يحيى بن زكريا ، ومنهم من يولد كافرا ويحيى كافرا ويموت كافرا ، منهم فرعون وذو الأوتاد ) )(@)(@@) ( قط كر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11652 ) قال النبي :(@)(@@) | 30 ( خلقت المرأة من ضلع أعوح ، إن تقمها تكسرها ، وإن تتركها تعش معها على عوجها ) )(@)(@@) العسكري في الأمثال عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11653 ) قال النبي :(@)(@@) | 30 ( خلقت ربنا فسويت ، وقدرت ربنا فقضيت ، وعلى عرشك استويت ، وأمت فأحييت ، وأطعمت وأسقيت وأرويت ، وحملت في برك PageV04P288 وبحرك على فلكك وعلى دوابك وأنعامك ، فاجعل لي عندك وليجة ، واجعل لي عندك زلفى وحسن مآب ، واجعلني ممن يخاف مقامك ووعيدك ويرجو لقاءك ، واجعلني أتوب إليك توبة نصوحا ، وأسألك عملا متقبلا ، وعملا نجيحا ، وسعيا مشكورا ، وتجارة لن تبور ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11654 ) قال النبي :(@)(@@) | 30 ( خلقت أنا وأبو بكر وعمر من طينة واحدة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الخاء مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده 
ms1315	 )(@)(@@)(@@)(@@) $ ( 11655 ) قال النبي :(@)(@@) | 30 ( خمس بخمس : ما نقض قوم العهد إلا سلط عليهم عدوهم ، وما حكموا بغير ما أنزل الله إلا فشا فيهم الفقر ، ولا ظهرت فيهم الفاحشة إلا فشا فيهم الموت ، ولا طففوا المكيال إلا منعوا النبات وأخذا بالسنين ، ولا منعوا الزكاة إلا حبس عنهم القطر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11656 ) قال النبي :(@)(@@) | 30 ( خمس تجب للمسلم على أخيه : رد السلام ، وتشميت العاطس ، وإجابة الدعوة ، وعيادة المريض ، واتباع الجنازة ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 11657 ) قال النبي :(@)(@@) | 30 ( خمس خصال يفطرن الصائم وينقضن الوضوء : الكذب ، والغيبة ، والنميمة ، والنظر بشهوة ، واليمين الكاذبة ) )(@)(@@) الأزدي في الضعفاء ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11658 ) قال النبي :(@)(@@) | 30 ( خمس دعوات يستجاب لهن : دعوة المظلوم حتى ينتصر ، ودعوة الحاج حتى يصدر ، ودعوة الغازي حتى يقفل ، ودعوة المريض PageV04P289 حتى يبرأ ، ودعوة الأخ لأخيه بظهر الغيب ، وأسرع هاذه الدعوات إجابة : دعوة الأخ لأخيه بظهر الغيب ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11659 ) قال النبي :(@)(@@) | 30 ( خمس صلوات افترضهن الله عز وجل : من أحسن وضوءهن ، وصلاهن لوقتهن ، وأتم ركوعهن وخشوعهن كان له على الله عهد أن يغفر له ، ومن لم يفعل فليس له على الله عهد ، إن شاء غفر له ، وإن شاء عذبه ) )(@)(@@) ( د هق ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11660 ) قال النبي :(@)(@@) | 30 ( خمس صلوات كتبهن الله على العباد ، فمن جاء بهن لم يضيع منهن شيئا استخفافا بحقهن كان له عند الله عهد أن يدخله الجنة ، ومن لم يأت بهن فليس له عند الله عهد ، إن شاء عذبه ، وإن شاء أدخله الجنة ) )(@)(@@) ( مالك حم د ن ه حب ك ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11661 ) قال النبي :(@)(@@) | 30 ( خمس صلوات من حافظ عليهن كانت له نورا وبرهانا ونجاة يوم القيامة ، ومن لم يحافظ عليهن لم يكن له نور يوم القيامة ولا برهان ولا نجاة ، وكان يوم القيامة مع فرعون وقارون وهامان وأبي بن خلف ) )(@)(@@) ابن 
ms1316	 نصر عن أبي عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11662 ) قال النبي :(@)(@@) | 30 ( خمس فواسق تقتلن في الحل والحرم : الحية ، والغراب الأبقع ، والفأرة ، والكلب العقور ، والحديا ) )(@)(@@) ( م ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11663 ) قال النبي :(@)(@@) | 30 ( خمس قتلهن حلال في الحرم : الحية والعقرب ، والحدأة ، والفأرة ، والكلب العقور ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11664 ) قال النبي :(@)(@@) | 30 ( خمس كلهن فاسقة يقتلهن المحرم ، ويقتلن في PageV04P290 الحرم : الفأرة ، والعقرب ، والحية ، والكلب العقور ، والغراب ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11665 ) قال النبي :(@)(@@) | 30 ( خمس لا يعلمهن إلا الله : إن الله عنده علم الساعة ، وينزل الغيث ، ويعلم ما في الأرحام ، وما تدري نفس ماذا تكسب غدا ، وما تدري نفس بأي أرض تموت ) )(@)(@@) ( حم ) و الروياني عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11666 ) قال النبي :(@)(@@) | 30 ( خمس ليال لا ترد فيهن الدعوة : أول ليلة من رجب ، وليلة النصف من شعبان ، وليلة الجمعة ، وليلة الفطر ، وليلة النحر ) )(@)(@@) ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11667 ) قال النبي :(@)(@@) | 30 ( خمس ليس لهن كفارة : الشرك بالله ، وقتل النفس بغير حق ، وبهت المؤمن ، والفرار من الزحف ، ويمين صابرة يقتطع بها مالا بغير حق ) )(@)(@@) ( حم ) و أبو الشيخ في التوبيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11668 ) قال النبي :(@)(@@) | 30 ( خمس من الإيمان ، من لم يكن فيه شيء منخهن فلا إيمان له : التسليم لأمر الله ، والرضا بقضاء الله ، والتفويض إلى الله ، والتوكل على الله ، والصبر عند الصدمة الأولى ) )(@)(@@) البزار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11669 ) قال النبي :(@)(@@) | 30 ( خمس من الدواب كلهن فاسق يقتلن في الحرم : الغراب ، والحدأة ، والعقرب ، والفأرة ، والكلب العقور ) )(@)(@@) ( ق ت ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11670 ) قال النبي :(@)(@@) | 30 ( خمس من الدواب ليس على المحرم في قتلهن جناح : الغراب ، والحدأة ، والفأرة ، والعقرب ، والكلب العقور ) )(@)(@@) ( مالك حم PageV04P291 ق د ن ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11671 ) قال النبي :(@)(@@) | 30 ( خمس من العبادة : النظر إلى المصحف ، والنظر إلى الكعبة ، والنظر إلى 
ms1317	 الوالدين ، والنظر في زمزم وهي تحط الخطايا ، والنظر في وجه العالم ) )(@)(@@) ( قط ن ) لم يذكر الصحابي المروي عنه هاذا الحديث .(@)(@@)(@@)(@@) $ ( 11672 ) قال النبي :(@)(@@) | 30 ( خمس من العبادة : قلة الطعم ، والقعود في المساجد ، والنظر إلى الكعبة ، والنظر في لمصحف ، والنظر إلى وجه العالم ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11673 ) قال النبي :(@)(@@) | 30 ( خمس من الفطرة : الختان ، والاستحداد ، وقص الشارب ، وتقليم الأظفار ، ونتف الإبط ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11674 ) قال النبي :(@)(@@) | 30 ( خمس من أوتيهن لم يعذر على ترك عمل الآخرة : زوجة صالحة ، وبنون أبرار ، وحسن مخالطة الناس ، ومعيشة في بلده ، وحب آل محمد ) )(@)(@@) ( فر ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11675 ) قال النبي :(@)(@@) | 30 ( خمس من حق المسلم على المسلم : رد التحية ، وإجابة الدعوة ، وشهود الجنازة ، وعيادة المريض ، وتشميت العاطس إذا حمد الله ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11676 ) قال النبي :(@)(@@) | 30 ( خمس من سنن المرسلين : الحياء ، والحلم ، والحجامة ، والتعطر ، والنكاح ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11677 ) قال النبي :(@)(@@) | 30 ( خمس من سنن المرسلين : الحياء ، والحلم ، والحجامة ، والسواك ، والتعطر ) )(@)(@@) ( تخ ) و الحكيم والبزار والبغوي ( طب ) وأبو نعيم في المعرفة PageV04P292 ( هب ) عن حصين الخطمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11678 ) قال النبي :(@)(@@) | 30 ( خمس من عملهن في يوم كتبه الله من أهل الجنة : من صام يوم الجمعة ، وراح إلى الجمعة ، وعاد مريضا ، وشهد جنازة ، وأعتق رقبة ) )(@)(@@) ( ع حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11679 ) قال النبي :(@)(@@) | 30 ( خمس من فعل واحدة منهم كان صامنا على الله : من عاد مريضا ، أو خرج غازيا ، أو دخل على إمامه يريد تعزيره وتوقيره ، أو قعد في بيته فسلم الناس منه وسلم من الناس ) )(@)(@@) ( حم طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11680 ) قال النبي :(@)(@@) | 30 ( خمس من قبص في شيء منهن فهو شهيد : المقتول في سبيل الله شهيد ، والغريق في سبيل الله شهيد ، والمبطون في سبيل الله شهيد ، والمطعون في سبيل الله شهيد ، والنفساء في سبيل الله 
ms1318	 شهيدة ) )(@)(@@) ( ن ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11681 ) قال النبي :(@)(@@) | 30 ( خمس هن من قواصم الظهر : عقوق الوالدين ، والمرأة يأتمنها زوجها تخونه ، والإمام يطيعه الناس ويعصي الله ، ورجل وعد عن نفسه خيرا فأخلف ، واعتراض المرء في أنساب الناس ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11682 ) قال النبي :(@)(@@) | 30 ( خمس يعجل الله لصاحبها العقوبة : البغي ، والغدر ، وعقوق الوالدين ، وقطيعة الرحم ، ومعروف لا يشكر ) )(@)(@@) ابن لال عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11683 ) قال النبي :(@)(@@) | 30 ( خمسة لا جمعة عليهم : المرأة ، والمسافر ، والعبد ، والصبي ، وأهل البادية ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 11684 ) قال النبي :(@)(@@) | 30 ( خمروا الآنية ، وأوكئوا الأسقية ، وأجيفوا PageV04P293 الأبواب ، واكفتوا صبيانكم عند المساء ، فإن للجن انتشارا وخطفة ، وأطفئوا المصابيح عند الرقاد ، فإن القويسقة ربما اجترت الفتيلة فأحرقت أهل البيت ) )(@)(@@) ( خ ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11685 ) قال النبي :(@)(@@) | 30 ( خمروا وجوه موتاكم ولا تشبهوا باليهود ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11686 ) قال النبي :(@)(@@) | 30 ( خمر فخذك يا معمر فإن الفخذ عورة ) )(@)(@@) ( طب ) عن جرهد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11687 ) قال النبي :(@)(@@) | 30 ( خمس من الإيمان : من لم يكن فيه شيء منهن فلا إيمان له ، التسليم لأمر الله ، والرضا بقضاء الله ، والتفويض إلى الله ، والتوكل على الله ، والصبر عند الصدمة الأولى ، ولم يطعم أمر حقيقة الإسلام حتى يأمنه الناس على دمائهم وأموالهم ، فقال قائل : يا رسول الله أي الإسلام أفضل ؟ قال : من سلم المسلمون من لسانه ويده ، علامات لمنار الطريق : شهادة أن لا إلاه إلا الله ، وإقام الصلاة ، وإيتاء الزكاة ، والحكم بكتاب الله ، وطاعة النبي الأمي ، والتسليم على بني آدم إذا لقيتهم ) )(@)(@@) ( بز ) وضعفه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11688 ) قال النبي :(@)(@@) | 30 ( خمس من جاء بهن يوم القيامة مع إيمان دخل الجنة : من حافظ على الصلوات الخمس على وضوئهن وركوعهن وسجودهن ومواقيتهن ، وصام رمضان ، وحج البيت إن استطاع إليه سبيلا ، وأعطى الزكاة من ماله طيبة بها نفسه 
ms1319	 ، وأدى الأمانة ، قيل : يا نبي الله وما أداء الأمانة ؟ قال : الغسل من الجنابة ، إن الله لم يأمن ابن آدم على شيء من دينه غيرها ) )(@)(@@) محمد بن نصر وابن جرير ( طب ) عن أبي الدرداء رضي الله عنهما وحسن .(@)(@@) PageV04P294(@)(@@)(@@)(@@) $ ( 11689 ) قال النبي :(@)(@@) | 30 ( خمس في الصلاة من الشيطان : العطاس ، والنعاس ، والتثاؤب ، والرعاف ، والحيض ) )(@)(@@) الديلمي عن عمارة بن عيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11690 ) قال النبي :(@)(@@) | 30 ( خمس فتن ، أعلم أن أربعا قد مضت ، والخامسة كائنة فيكم ، فإن أدركت الخامسة فاستطعت أن تقعد في بيتك فافعل ، وإن استطعت أن تبتغي نفقا في الأرض فتدخل فيه فافعل ) )(@)(@@) الديلمي عن عديبن ثابت عن أبي عن جده .(@)(@@)(@@)(@@) $ ( 11691 ) قال النبي :(@)(@@) | 30 ( خمس يفطرن الصائم وينقضن الوضوء : الكذب ، والغيبة ، والنميمة ، والنظر بالشهوة واليمين الكاذبة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الخاء مع اللام ألف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11692 ) قال النبي :(@)(@@) | 30 ( خلافة النبوة ثلاثون سنة ، ثم يؤتي الله الملك من يشاء ) )(@)(@@) ( د ك ) عن سفينة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) ||| ( الخاء مع الياء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11693 ) قال النبي :(@)(@@) | 30 ( خيار أئمتكم الذين تحبونهم ويحبونكم ، وتصلون عليهم ويصلون عليكم ، وشرار أئمتكم الذين تبغضونهم ويبغضونكم ، وتلعنونهم PageV04P295 ويلعنونكم ) )(@)(@@) ( م ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11694 ) قال النبي :(@)(@@) | 30 ( خيار المؤمنين القانع ، وشرارهم الطامع ) )(@)(@@) القضاعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11695 ) قال النبي :(@)(@@) | 30 ( خيار أمتي أحداؤهم الذين آذا غضبوا رجعوا ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11696 ) قال النبي :(@)(@@) | 30 ( خيار أمتي الذين إذا رءوا ذكر الله ، وشرار أمتي المشاءون بالنميمة ، المفرقون بين الأحبة ، الباغون البراء العنت ) )(@)(@@) ( حم ) عن عبد الرحمان بن غنم ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11697 ) قال النبي :(@)(@@) | 30 ( خيار أمتي الذين يشهدون أن لا إلاه إلا الله وأني رسول الله ، الذين إذا أحسنوا استبشروا ، وإذا أساءوا استغفروا ، وشرار أمتي الذين ولدوا في النعيم وغذوا به ، وإنما نهمتهم ألوان الطعام والثياب ويتشدقون في الكلام ) )(@)(@@) ( حل ) عن عروة بن رويم مرسلا 
ms1320	 .(@)(@@)(@@)(@@) $ ( 11698 ) قال النبي :(@)(@@) | 30 ( خيار أمتي أولها ، وآخرها نهج أعوج ليسوا مني ولست منهم ) )(@)(@@) ( طب ) عن عبد الله بن السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11699 ) قال النبي :(@)(@@) | 30 ( خيار أمتي علماءها ، وخيار علمائها رحماؤها ، ألا وإن الله تعالى ل| يغفر للعالم أربعين ذنبا قبل أن يغفر للجاهل ذنبا واحدا ، ألا وإن العالم الرحيم يجيء يوم القيامة وإن نوره قد أضاء يمشي فيه ما بين المشرق والمغرب كما يضيء الكوكب الدري ) )(@)(@@) ( حل خط ) عن أبي هريرة ( القضاعي ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11700 ) قال النبي :(@)(@@) | 30 ( خيار أمتي في كل قرن خمسمائة ، والأبدال PageV04P296 أربعون ، فلا الخمسمائة ينقصون ولا الأربعون ، كلما مات رجل أبدل الله من الخمسمائة مكانه ، وأدخل في الأربعين مكانه : يعفون عمن ظلمهم ، ويحسنون إلى من أساء إليهم ، ويتواسون فيما آتاهم الله ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11701 ) قال النبي :(@)(@@) | 30 ( خيار أمتي : من دعا إلى الله تعالى وحبب عباده إليه ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11702 ) قال النبي :(@)(@@) | 30 ( خياركم : أحاسنكم أخلاقا ) )(@)(@@) ( حم ق ت ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11703 ) قال النبي :(@)(@@) | 30 ( خياركم : أحاسنكم أخلاقا ، الموطؤون أكنافا ، وشراركم : الثرثارون المتفيهقون المتشدقون ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11704 ) قال النبي :(@)(@@) | 30 ( خياركم : أحسنكم قضاء للدين ) )(@)(@@) ( ت ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11705 ) قال النبي :(@)(@@) | 30 ( خياركم : أطولكم أعمارا ، وأحسنكم أخلاقا ) )(@)(@@) ( حم ) و البزار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11706 ) قال النبي :(@)(@@) | 30 ( خياركم : أطوالكم أعمارا ، وأحسنكم أعمالا ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11707 ) قال النبي :(@)(@@) | 30 ( خياركم الذين إذا رؤا ذكر الله بهم ، وشراركم : المشاءون بالنميمة ، المفرقون بين الأحبة ، الباغون البراء العنت ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV04P297(@)(@@)(@@)(@@) $ ( 11708 ) قال الن