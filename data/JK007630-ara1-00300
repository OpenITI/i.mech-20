ms281	 يرمي بها % % سهل العنان الجانب الأوعرا % % 18(@)(@@) % يرد من غرتها معتما % على الدآدي غلسا مقمرا % % 19(@)(@@) % ينص من أرساغها والمطا % % إما جناحا طار أو منسرا % % 20(@)(@@) % قل لعميد الدولة أفلح بها % % قد سلم الخصم وزال المرا % % PageV01P846 21(@)(@@) % فانظر إلى الأعقاب من صدرها % % لا بد للمعتم أن يفجرا % % 22(@)(@@) % ركبتها بزلاء مخطومة % تحمل منك الأسد القسورا % % 23(@)(@@) % ترمي بدار الذل من خلفها % % ظهرا وتبغي في العلا مظهرا % % 24(@)(@@) % ناجية تأخذ من حظها % % مقبلة ما تركت مدبرا % % 25(@)(@@) % حتى استقلت بك بحبوحة % تشرف بالبادية الحضرا % % 26(@)(@@) % محمية الأرجاء أن هيجت % زعزعت الأبيض والأسمرا % % 27(@)(@@) % تذكرك المجد بوفد الجدا % % وسامر الليل ونار القرى % % 28(@)(@@) % وغلمة حولك من عامر % شرطك مدعوا ومستنصرا % % 29(@)(@@) % تحسبها إن غضبت جنة % وجانب الزاب بها عبقرا % % 30(@)(@@) % تأمر في ذاك وتنهى بما % % أنفت ان ينهى وأن يؤمرا % % PageV01P847 31(@)(@@) % عدوك الآمل ما لا يرى % % أصبح من بعدك مستوزرا % % 32(@)(@@) % دعوة داع لم يجد حظه % أشقى له منك ولا أخسرا % % 33(@)(@@) % قد أنكرت بعدك خطابها % % فلا ترى كفئا ولا ممهرا % % 34(@)(@@) % وابتذلت حتى غدا ظهرها % % أجلب مما ركضت أدبرا % % 35(@)(@@) % بين بني العاهات منبوذة % % يزاحم الأعمى بها الأعورا % % 36(@)(@@) % واستامها المفلس لما غدت % تباع بالفلس فلا تشترى % % 37(@)(@@) % كانت بكم مغنى هوى آهلا % فاليوم أضحت طللا مقفرا % % 38(@)(@@) % وساقها سالبها ظلكم % للذئب يرعى سرحها مصحرا % % 39(@)(@@) % دامية من ندم كفه % يأكلها الإبهام والخنصرا % % 40(@)(@@) % ينشد منكم وطرافاته % ويسأل الركبان مستخبرا % % PageV01P848 41(@)(@@) % كعاشق فارق أحبابه % طوعا وسام الليل طيف الكرى % % 42(@)(@@) % أين له أين بكم نادما % معتذرا إلا بأن يعذرا % % 43(@)(@@) % ما أخلق العاثر يمشي به % كسيره أن يبتغي مجبرا % % 44(@)(@@) % لا يعرف المعروف في أمره % معمر حتى يرى المنكرا % % 45(@)(@@) % يا نعمة ما صاحبت صاحبا % وعقلة النعمة أن تشكرا % % 46(@)(@@) % غدا يوافيك بأيمانه % % جاحدك الغامط مستبصرا % % 47(@)(@@) % بغدرة يرغب في بسطها % % وزلة يسأل أن تغفرا % % 48(@)(@@) % فثم فاردد قادرا رأيك ال % % شارد وابرد صدرك الموغرا % % 49(@)(@@) % واجر من الصفح على عادة 
ms282	 % مثلك مستول عليها جرى % % 50(@)(@@) % والتحم الجرح فقد طوحت % جنباه بالمسبار واستنهرا % % PageV01P849 51(@)(@@) % بادر بها الفوت فما شلوها % % أول ميت بك قد أنشرا % % 52(@)(@@) % واركب مطاها فقد استخضعت % ذلا لأن تلجم أو تثقرا % % 53(@)(@@) % وروض البعد وتأديبه % لك الرقاب الذل والأظهرا % % 54(@)(@@) % غرس فتي أنت أنشأته % فلا تدع غيرك مستثمرا % % 55(@)(@@) % ما أسس القادر إلا بنى % % علوا ولا يخلق إلا فرى % % 56(@)(@@) % واسئل مواعيدي في مثلها % % هل أخلفت أو كذبت مزجرا % % 57(@)(@@) % لو نزل الوحي على شاعر % قمت بشيرا فيكم منذرا % % 58(@)(@@) % أو أدعى المعجز من ليس بال % % نبي كنت المعجز المبهرا % % 59(@)(@@) % كم آية لي لو تحفظتم % بها وفأل بعلاكم جرى % % 60(@)(@@) % يشكر مقروءا ويشكو إذا % % صح الذي حدث أو خبرا % % PageV01P850 61(@)(@@) % لا حق من قدم حقا به % يعطى ولا فوزة ما يشترى % % 62(@)(@@) % وجل حظي عندكم فيه ما % % أجود ما قال وما أشعرا % % 63(@)(@@) % تناسيا من حيث تقضي العلا % % وتوجب القدرة أن أذكرا % % 64(@)(@@) % كنتم ربيعي وثرى أرضي % % يلقى الحيا ظمآن مستبشرا % % 65(@)(@@) % فما لربعي دارسا هامدا % مذ صرتم الأنواء والأبحرا % % 66(@)(@@) % إليكم الصرخة لا منكم % ما أخون الحظ وما أجورا % % 67(@)(@@) % قد أكلتني بعدكم فترة % ما أكلت إلا فتى مقترا % % 68(@)(@@) % واستعذبت لحمي وإن لم تجد % إلا ممرا طعمه ممقرا % % 69(@)(@@) % كنت على البلة من مائكم % منتفضا في ورقي مصفرا % % 70(@)(@@) % فكيف حالي ونوى داركم % قد منع القطرة أن تقطرا % % PageV01P851 71(@)(@@) % من لي بصون العمر في ظله % سني أحصيهن والأشهرا % % 72(@)(@@) % ومن لكم غيري طباق الملا % % ما راضه فيكم وما سيرا % % 73(@)(@@) % حتى لقد سمي بكم مسرفا % حيث يسمى مادحا مكثرا % % 74(@)(@@) % أقسمت إن فاتكم الدهر بي % % ليندمن بعدي من قصرا % % 75(@)(@@) % يا عروتي الوثقى أعد نظرة % في خلة منبوذة بالعرا % % 76(@)(@@) % تلاف بالعاجل ميسورها % % وصب لو مؤتشلا منزرا % % 77(@)(@@) % واضمن على جودك من أجل ما % % قد أنعم الوادي وعم الثرى % % 78(@)(@@) % ولا تدعني ودعاء الصبا % % في معشر أشقى بهم معسرا % % 79(@)(@@) % نبه على أن أختصاصي بكم 
ms283	 % يخرجكم بالرغم مني يرا % % 80(@)(@@) % واطلع طلوع البدر ما ضره % سراراه ليلة ما أقمرا % % PageV01P852 81(@)(@@) % واستخدم النيروز واسعد به % % مستعملا في العز مستعمرا % % 82(@)(@@) % يوم من الأيام لكن رأى % % له عليها الفضل والمفخرا % % 83(@)(@@) % كأنه من نخوة قلد ال % % تسويد عن أمرك أو أمرا % % 84(@)(@@) % ينسب كسرى فإن أختاركم % دينا فقد وافقكم عنصرا % % 85(@)(@@) % يقسم والصدق قمين به % بما حبا الأرض وما نورا % % 86(@)(@@) % أنك تبقى مالكا خالدا % ما رد منه الدهر أو كررا % % PageV01P853 البحر : - 1(@)(@@) % لو كنت تبلو غداة السفح أخباري % % علمت أن ليس ما عيرت بالعار % 2(@)(@@) % شوق إلى الوطن المحبوب جاذب أض % % لاعي ودمع جرى من فرقة الجار % 3(@)(@@) % ووقفة لم أكن فيها بأول من % بان الخليط فداوى الوجد بالدار % 4(@)(@@) % ولمت في البرق زفراتي فلو علمت % عيناك من أين ذاك البارق الساري % % 5(@)(@@) % طارت شرارته من جو كاظمة % تحت الدجى بلباناتي وأوطاري % % 6(@)(@@) % من كل مبتسم عن مثل ومضته % وذائب ريقه في مزنه الجاري % % 7(@)(@@) % وخافق بفؤادي في حيا هطل % خفوق شعشاعه من غير إضرار % 8(@)(@@) % وطائش من لحاظ يوم ذي سلم % ملكن وردي ولم يمكلن إصداري % % 9(@)(@@) % رميت أحسب أني في بني جشم % فرد سهمي ورامي مهجتي قاري % % 10(@)(@@) % هل بالديار على لومي ومعذرتي % % عدوى تقام على وجدي وتذكاري % % PageV01P854 11(@)(@@) % أم أنت تعذل فيما لا تزيد به % إلا مداواة حر النار بالنار % 12(@)(@@) % تنكرت أن رأت شيبي وقد حسبت % أيام عمري فصدت أم عمار % 13(@)(@@) % أما تريني ذوى غصني وناحلني % % ظلي وراب الهوى صبري وإقصاري % % 14(@)(@@) % وقوربت خطواتي من هنا وهنا % % فبدلت أذرع منها بأشبار % 15(@)(@@) % مطردا تجتفيني العين راكدة % عند الملوك رياحي بعد إعصار % 16(@)(@@) % فما خضعت ولكن خاننيزمني % % ولا ذللت ولكن غاب أنصاري % % 17(@)(@@) % وقد أكون وما تقضى بلهنية % إلا بمتعة آصالي وأسحاري % % 18(@)(@@) % موسعا لي رواق الأنس قالصة % عني ذلاذل أبواب وأستار % 19(@)(@@) % مع الوسائد أو فوق المضاجع إن % ملت مجالس ألاف وسمار % 20(@)(@@) % أشري المودات والأموال مقترحا % منها الصفايا بأخلاقي وأشعاري 
ms284	 % % PageV01P855 21(@)(@@) % أيام لي من بني عبد الرحيم حمى % % راعين حق العلا دانين حضار % 22(@)(@@) % مرفرفين على حقي بحفظهم % رامين نحوي بأسماع وأبصار % 23(@)(@@) % فاليوم تنبذني الأبواب مطرحا % نبذ المعرة تحت الزفت والقار % 24(@)(@@) % يمل مدحي ولا يصغي لمعتبتي % % ولا يراقب تخويفي وإنذاري % % 25(@)(@@) % ينقص الفضل ميزاتي ويصغرني % % ما كان فيه غذا أنصفت إكباري % % 26(@)(@@) % هذا وهم بعد يرعوني وإن شحطوا % % ويلحظوني على بعد من الدار % 27(@)(@@) % علقت باسمهم فاستبقني ويفي % % أني علقت بحبل غير جوار % 28(@)(@@) % بالأطهرين ثرى والأطيبين ندى % والأسمحين على عسر وإقتار % 29(@)(@@) % والناصرين لما قالوا بما فعلوا % % والفاتلين على شزر وإمرار % 30(@)(@@) % لا يعدم الجار فيهم عز أسرته % ولا يكون قراهم خجلة الجار % PageV01P856 31(@)(@@) % ولا يردون في صدر الحقوق إذا % % توجهت بتساويف وأعذار % 32(@)(@@) % يأوي الطريد إليهم غير مهتضم % ويرحل الضيف عنهم غير مختار % 33(@)(@@) % سريت منهم بشهب في دجى أملي % % تضيء لي واهتدى ليلي بأقمار % 34(@)(@@) % صحبتهم والصبا ريعان في ورقي % % فما نبوا بي حتى حان إصفاري % % 35(@)(@@) % مقربا يحسبوني ذيل أنعمهم % حتى ترى الناس يقتافون آثاري % % 36(@)(@@) % حتى لو أني أدعى باسم بعضهم % لم ينب جهري عن الداعي وإسراري % % 37(@)(@@) % حموا شبولا حمى سرحى وعشت إلى % % أن ذب عني منهم ضيغم ضاري % % 38(@)(@@) % قضيت في شرف الدين الذي ضمنت % لي المنى ووقى زجري وأطياري % % 39(@)(@@) % وحرمت يده لحمي على زمني % % وكنت منه لأنياب وأظفار % 40(@)(@@) % أغر قامت بقولي فيه معجزتي % % في الفضل وانكشفت بالصدق أخباري % % PageV01P857 41(@)(@@) % وسار بأيمي ما أرسلته مثلا % في الأرض في كل بيت فيه سيار % 42(@)(@@) % مبارك تطرد اللأواء رؤيته % طرد الظلام بزند البلجة الواري % % 43(@)(@@) % وزير ملك خلت في عدل سيرته % صحيفة الملك من إثم وأوزار % 44(@)(@@) % يزين الحق في عينيه منبته % على نوازع عرق فيه نعار % 45(@)(@@) % شبت به الدولة الشمطاء وارتجعت % زمانها بين إعراس وإعذار % 46(@)(@@) % وأقلع الدهر عما كان يثلمه % من عرشها بعد تصميم وإصرار % 47(@)(@@) % طورا هشيما تلظى ثم يرفل من % تدبيره بين جنات وأنهار % 48(@)(@@) % يذب 
ms285	 عنها وقد ريعت جوانبها % % برأيه المكتسي أو سيفه العاري % % 49(@)(@@) % تهفو مرارا به غمطا لنعمته % ثم تعود بحلو الصفح غفار % 50(@)(@@) % فكم تموت ويحييها برجعته % وكم تعق أباها الخالق الباري % % PageV01P858 51(@)(@@) % شيمة لؤم لها تنسى إذا قرنت % منه بشيمة حر وابن أحرار % 52(@)(@@) % من طينة الملك ملموما على كرم % لم تنحت صخرة منه بمنقار % 53(@)(@@) % يهتز فخرا بعرض لا يلم به % وصم القنا وأديم غير عوار % 54(@)(@@) % بين وزير تغص الصدر جلسته % يختال أو ملك في الفرس جبار % 55(@)(@@) % تقسموا الأرض يفتضون عذرتها % % بعدلهم بين عمال وعمار % 56(@)(@@) % ورثتهم سوددا وازددت بينهم % زيادة السيف بين الماء والنار % 57(@)(@@) % إن تخل من وجهك الزوراء مكرهة % فإن صدك عنها صد مختار % 58(@)(@@) % أو ينض بعدك عنها حسنها فلها % % بقرب غيرك أثواب من العار % 59(@)(@@) % أما الديار فقفر والقطين بها % % يود من قلق لو أنه ساري % % 60(@)(@@) % قد خضخض السجل جاليها فما يجد ال % % ساقي سوى حماة ما بين أحجار % PageV01P859 61(@)(@@) % وطار بالرزق عنها أجدل علقت % منه المنى بحديد الظفر عقار % 62(@)(@@) % قامت بأذنابها أقدامهم وهوت % رءوسها في هوى مستهدم هاري % % 63(@)(@@) % فالأرض مردودة بالفلس لو عرضت % والملك يغلو لمبتاع بدينار % 64(@)(@@) % وصاحب الأرض مملوك يصرفه % مجعجع بين نهاء وأمار % 65(@)(@@) % حلس العرينة خاف تحت لبدته % ويكسب الليث مع سعى وإصحار % 66(@)(@@) % مدبر لعبت أيد بدولته % مشلولة بين إقبال وإدبار % 67(@)(@@) % يدعوك معترفا بالحق فيك وما اس % % تدناك مثل إعتراف بعد إنكار % 68(@)(@@) % يا جاره أمس قد لانت عريكته % % فاعطف له وأرع فيه حرمة الجار % 69(@)(@@) % وانهض لها نهضة الشاري ببطشته ال % % كبرى وحاشا لك التمثيل بالشاري % % 70(@)(@@) % قد أعقم الرأي فاستدرك بقيتها % % منك برأي ولوج البطن مذكار % PageV01P860 71(@)(@@) % فلم تزل واريا في كل مشكلة % بقدحها جاريا في كل مضمار % 72(@)(@@) % واملل بجودك أهواء موزعة % حتى تفيء لإذعان وإقرار % % 73(@)(@@) % واسع لمنتظر آيات عودك لم % يغنم سوى الصبر من غم وإنظار % 74(@)(@@) % لا يشتكيك وإن طال الجفاء به % إلا إليك بإخفاء وإظهار % % 75 
ms286	(@)(@@) % لم يبق إلا الذما منه وأحسبه % لليوم أو لغد ميتا بلا ثار % 76(@)(@@) % لولا عوائد من نعماك تنشلني % % وإن أتت من قبيل الطارق الطاري % % 77(@)(@@) % تزورني والنوى بيني وبينكم % أهلا بها من حفي بيوزوار % 78(@)(@@) % فجددوها مراعاة فبي ظما % لو كان في البحر لم يخلق بتيار % 79(@)(@@) % لموا كسوري فما في الأرض منقبة % أعلى بصاحبها من جبر أكساري % % 80(@)(@@) % اليد منكم فلا تلقوا أشاجعها % % لفاصم من يد العلياء بشار % PageV01P861 81(@)(@@) % وإن أغب عنكم فالشعر يذكرني % % وحسبكم بالقوافي رب إذكار % 82(@)(@@) % فاستجلها يا عميد الدولتين فقد % وافى بها الشوق من عون وإبكار % 83(@)(@@) % عرائسا أنت مولى الناس خاطبها % % وبعلها وأبوها عفو افكاري % % 84(@)(@@) % وانظر إليها ما قد أعطيت شرفا % مرددا بين أحماء وأصهار % 85(@)(@@) % والمهرجان وعيد الفطر قد وليا % % زفافها بين صواغ وعطار % 86(@)(@@) % يومان للفرس أو للعرب بينهما % % حظ السعادة مقسوم بمقدار % 87(@)(@@) % هذا بتاج أبيه عاصب وعلى % % هذا اختيال فتى بالسيف خطار % 88(@)(@@) % تصاحبا صحبة الخلين واتفقا % % سلما ولم يذكران أضغان ذي قار % 89(@)(@@) % فالبسهما بين عيش ناعم وتقى % وبين صوم تزكيه وإفطار % 90(@)(@@) % ما طاف بالبيت ماحي زلة وسعى % % شعث أمام الصفا أنضاء أسفار % PageV01P862 91(@)(@@) % تنصبوا لهجير الشمس وافترشوا % % ليل السرى بين أقتاب وأكوار % 92(@)(@@) % نصوا الركاب بمصر واحد وهم % شتى أباديد آفاق وأمصار % 93(@)(@@) % حتى أهلوا فلبوا حاسرين إلى ال % % داعي مباذل أشعار وأبشار % 94(@)(@@) % وما جرى الدم في الوادي وقد نحروا % % وسربل البيت من حجب وأستار % 95(@)(@@) % مخلد الملك تفضي كل شارقة % إلى وفاق لما تهوى وإيثار % PageV01P863 البحر : - 1(@)(@@) % لمن الظعن تهتدي وتجور % سائق منجد وشوق يغير % 2(@)(@@) % تتبع الخطو قاهرا بين أيدي % % ها ومن خلفها هوى مقهور % 3(@)(@@) % وهي في طاعة التلفت حيا % % ت وفي طاعة الجبال سطور % 4(@)(@@) % ووراء الحدوج في البيد أروا % % ح المقيمين في الديار تسير % 5(@)(@@) % رفعوها وهي الخدور وراحوا % % وهي مما تحوي القلوب صدور % 6(@)(@@) % يا عقيدي على الغرام بليل % قم وفيا وغيرك المأمور % 7(@)(@@) % وأعرني إن كان مما يعار 
ms287	 ال % % قلب أو كنت أنت ممن يعير % % 8(@)(@@) % لي وتر بين الركاب وأولى % % من توليت نصره الموتور % 9(@)(@@) % حكمت في دمي فتاة من الح % % ي مباح لها الدم المحظور % 10(@)(@@) % غادة بين ظبية البان والبا % % ن اهتزاز في خلقها وفتور % PageV01P864 11(@)(@@) % بهما تخلس العقول وترعى % % في حمى كل مهجة وتغير % 12(@)(@@) % فمتى استعصمت فعاقلتاها % % رشأ أحور وغصن نضير % 13(@)(@@) % من عذيري منها وأين من القا % % تل يجني ولا يقاد عذير % 14(@)(@@) % قامرتني بطرفها يوم ذي البا % % ن وراحت ولبي المقمور % 15(@)(@@) % دونها من إبائها شيمة الغد % % ر ومن قومها القنا المشجور % 16(@)(@@) % قال عنها الواشون حقا فعفنا % % وقنعنا بالطيف والطيف زور % 17(@)(@@) % ومن النزح صادق وهو مذمو % % م لدينا وكاذب مشكور % 18(@)(@@) % زارنا بالعراق زورة ذي الجن % % ب وماوان دونه فجفير % 19(@)(@@) % يركب الليل قعدة والليالي % % صهوات فرسانهن البدور % 20(@)(@@) % يقطع التيه والجمال دليل % بين عينيه والظلام خفير % PageV01P865 21(@)(@@) % فإذا مضجعي القضيض مهيد % وإذا ليلي الطويل قصير % % 22(@)(@@) % ما لظمياء تنطوي شرة العم % % ر فيبلى وحسنها منشور % 23(@)(@@) % وعظ الشيب والحوادث فيها % % وفؤادي ذاك المصر الجسور % 24(@)(@@) % ومشير وليته صفحة الإع % % راض عنها والحب لا يستشير % 25(@)(@@) % نكر البيض والصبابة بالبي % % ض وأين الصبا وأين النكير % 26(@)(@@) % إن تراني على يديك خفيفا % سلس السهم مقودي والقتير % 27(@)(@@) % لينا تحت غمزة الحائل الفا % % طر تنماع طينتي وتخور % 28(@)(@@) % فبما أكره الحفيظ ولا يط % % عم نوما على انتباهي الغيور % 29(@)(@@) % غير عودي الملوي وغير عصايال % % ملتحى بالملامة المقشور % 30(@)(@@) % حيث حكمي فصل القضاء على الده % % ر وأمري على الحسان أمير % PageV01P866 31(@)(@@) % فخذ الآن كيف شئت بحبلي % % قد كفاك الجذاب أني أسير % 32(@)(@@) % يا بني الدهر كم يصم على الزج % % ر وكم يكمه السميع البصير % 33(@)(@@) % سقم ماطل أما آن أن يف % % رق شيئا على الرقي المسحور % 34(@)(@@) % ملك الجور أمركم فالفتى المغ % % رور بالعيش فيكم معذور % 35(@)(@@) % فتساقيتم الفراق بكأس % هي فيكم على السماء تدور % 36(@)(@@) % كل يوم حق مضاع عليكم % ووفاء 
ms288	 لديكم مكفور % 37(@)(@@) % يفرح المنتشي بها اليوم أو ين % % سى غدا ما يكابد المغمور % 38(@)(@@) % وثناء تشكو تجارة أعرا % % ضكم منه وهو فيكم يبور % 39(@)(@@) % وجناح إذا المنى ريشته % عاد فيكم باليأس وهو كسير % 40(@)(@@) % وأخ وجهه الحيا البارد العذ % % ب ومكنونه الأجاج المرير % PageV01P867 41(@)(@@) % عدتي منه رثة وعديدي % % يوم ألقى العدا به مكثور % 42(@)(@@) % ومتى هز للحقوق نبا من % % ه صديق يكور ثم يحور % 43(@)(@@) % وافترقنا وقد سلا الغادر الها % % جر منا وما سلا المهجور % 44(@)(@@) % لو تأسى بكامل كل من يس % % أل نصفا لم تلق خلقا يجور % 45(@)(@@) % تلك طرق على المسالك عميا % % ء وظهر على العراك عسير % 46(@)(@@) % وعناء على النواظر أن يط % % لب للشمس في السماء نظير % 47(@)(@@) % ترك الناس خلفه سابق النا % % س وقافت به الصبا والدبور % 48(@)(@@) % وسما للعلا فأشرق من أش % % رف أفلاكها الهلال المنير % 49(@)(@@) % طالبا قدر نفسه يكفل السع % % ي له النجاح والمقدور % 50(@)(@@) % همة قارنت قرينا من السع % % د فسارت في الأفق حيث يسير % PageV01P868 51(@)(@@) % وعطايا رأت معينا من الشك % % ر فدامت ماكل معطى شكور % 52(@)(@@) % ولد الدهر منك والدهر هم % ما تمنت على الشباب الدهور % 53(@)(@@) % واستقلت بنعمة الله جنبا % % ك وكل بثقلها مبهور % 54(@)(@@) % ورأى الناس معجزاتك فاستي % % قن من شك واستجاب الكفور % 55(@)(@@) % فسماح أعمى مسحت بكفي % % ك عليه فارتد وهو بصير % 56(@)(@@) % ودفين من الفضائل نادا % % ك من الترب ميته المقبور % 57(@)(@@) % مستجيرا من الردى بك فانتا % % ش فاعجب بميت يستجير % 58(@)(@@) % جدت عذب الندى غزيرا وجود ال % % غيث ملح في سحبه منزور % 59(@)(@@) % وتعذرت عن كثيرك والبح % % ر وقد قل رفده معذور % 60(@)(@@) % في زمان غذا الرجال سخوا في % % ه فما فرط نيلهم تبذير % PageV01P869 61(@)(@@) % جود من لا غدا يخاف ولا اليو % % م عليه مسيطر ومشير % 62(@)(@@) % سائر بالثناء وهو مقيم % وغني بالذكر وهو فقير % 63(@)(@@) % زاده بالثنا ولوعا ووجدا % قول قوم هذا هو التدبير % 64(@)(@@) % لك يومان في الندى شائع با % % د وملقى قرامه 
ms289	 مستور % 65(@)(@@) % فعطاء وربه مشكور % وعطاء وربه مأجور % 66(@)(@@) % قد أريقت إلا لديك المروءا % % ت وضاقت إلا عليك الأمور % 67(@)(@@) % وتفردت بالمحاسن في ده % % ر بأوصافه تشاه الدهور % 68(@)(@@) % ملك العجز فيه ناصية الفض % % ل فطالت ذرى الجبال الصخور % 69(@)(@@) % وتواصى الرجال باللؤم حتى ال % % مجد عار والجود ذنب كبير % 70(@)(@@) % أقحطت أوجه البلاد ومن حو % % لك للخصب روضة وغدير % PageV01P870 71(@)(@@) % فإلى بابك الحوائج يجدو % % ولك العير في العلا والنفير % 72(@)(@@) % عادة من ورائها شافع النف % % س وأصل بفرعه منصور % 73(@)(@@) % واكتساب أعاره شرف المي % % راث والمجد أول وأخير % 74(@)(@@) % ويمينا بمن تمد بأعرا % % قك في الفخر أن يسود جدير % 75(@)(@@) % دوحة من ثمارها أنت والمغ % % رس منها بهرام أو أردشير % 76(@)(@@) % خير ما تربة على الأرض لم يش % % عب على اللؤم طينها المفطور % 77(@)(@@) % طاب صلصال عيصها وبريا % % ها ثرى ماجد وماء طهور % 78(@)(@@) % قومك الغالبون عزا وهم قو % % مي على الأرض وهي ماء يمور % 79(@)(@@) % ركبوا الدهر وهو بعد فتي % جذع وهو قارح مقرور % 80(@)(@@) % ملكوا الناس آمرين وما في الن % اس إلا مستعبد مأمور % PageV01P871 81(@)(@@) % كل خوف بهم أمان ومهجو % % ر خراب بعدلهم معمور % 82(@)(@@) % أي مجد يضمنا وفخار % يوم أنسابنا إليه تصير % 83(@)(@@) % إن يفتنا الخطيب والمنبر المن % % صوب فالتاج حظنا والسرير % 84(@)(@@) % حسبنا أن تعلم الملك منا % % والسياسات فيه والتدبير % 85(@)(@@) % وكفيناه أمر رستم في الحر % % ب إذا عدد الرجال الذكور % 86(@)(@@) % والذي سقى من الدم ذو الأكت % % اف حتى روى الثرى سابور % 87(@)(@@) % ولدوا منك كوكبا ضوءه السا % % ري دليل عليهم ونذير % 88(@)(@@) % واستسلوا لفخرهم من لساني % % صارما غربه الكلام الغزير % 89(@)(@@) % تحطم الذبل الصعاد ويسري % % صدأ السيف وهو ماض طرير % 90(@)(@@) % فلهذا إذا مدحتك في عز % ي أسدي وفي علائي أنير % PageV01P872 91(@)(@@) % منك وأن تحسن الصنيع وتر % % عى ومني التنميق والتجبير % 92(@)(@@) % وكلانا بحظه من أخيه % جذل يوم كسبه مسرور % 93(@)(@@) % غير أني يبقى الذي أع % % طي ويفنى عطاؤك الموفور % 94(@)(@@) % كل كنز 
ms290	 في الأرض تأكله الأر % % ض وكنزي مؤبد مذخور % 95(@)(@@) % وسوى ما أقول جندلة تق % % ذف في الماء أو سفاء يطير % 96(@)(@@) % كلم أعور المعادن مطرو % % ق ومعنى مردد مطرور % 97(@)(@@) % سرقات خلس كما يرد المذ % % عور خوفا أن يصطلى المقرور % 98(@)(@@) % ولعمري إن القريض إذا ع % % د كثير وما يسير يسير % 99(@)(@@) % لي وحدي إعجازه والدعاوي % % طبق الأرض فيه والتزوير % 100(@)(@@) % ويطيق المغمرون الذي أب % % دع فيه طريقة المسطور % PageV01P873 101(@)(@@) % غرقوا منه في بحور الأعاري % % ض وكيف المنصوب والمجرور % 102(@)(@@) % واليتامى من دره في خليج % ضيق ليس منه هذي البحور % 103(@)(@@) % وإذا المهرجان جاءك يهدي % % ه فقد طاب زائر ومزور % 104(@)(@@) % ذاك يوم فرد ذا كلم فص % % ل وكل بفضله مشهور % 105(@)(@@) % فاقتبل منهما السعود وباكر % % صفوة العيش فالمعاش البكور % 106(@)(@@) % وتمل الزمان تجري على حك % % مك قسرا أيامه والشهور % 107(@)(@@) % تقع الدائرات دونك حسرى % % ورحاها على عداك تدور % 108(@)(@@) % غصة الغيظ حظ حاسدك البا % % غي وحظاك غبطة وسرور % 109(@)(@@) % نام عنك المكلفون وليلي % % ساهر ما لنجمه تغوير % 110(@)(@@) % نفس طال كان لولاك يغنى ال % % عفو منه ويقنع الميسور % PageV01P874 111(@)(@@) % فوفاء أبا الوفاء فلم تق % % ض إذا ما لم تقض في النذور % 112(@)(@@) % كن غيورا علي من أن يلي غي % % رك نصري إن الكريم غيور % 113(@)(@@) % فكثير الجزاء منك قليل % وقليل من آخرين كثير % PageV01P875 البحر : - 1(@)(@@) % نفرها عن وردها بحاجر % شوق يعوق الماء في الحناجر % 2(@)(@@) % وردها على الطوى سواغبا % % ذل الغريب وحنين الزاجر % 3(@)(@@) % فطفقت تقنعها جراتها % % من شبع دار وري حاضر % 4(@)(@@) % يكسعها التراب في أعطافها % % تساند الأعضاد بالكراكر % 5(@)(@@) % ذاك على سكون من أقلقها % % وأنها وافية لغادر % 6(@)(@@) % مغرورة الأعين من أحبابها % % بخالب الإيماض غير ماطر % 7(@)(@@) % تقابل المذموم من عهودهم % بكل قلب ولسان شاكر % 8(@)(@@) % وهي بأرماح الملال والقلى % % مطرودة منخوسة الدوابر % 9(@)(@@) % تشكو إليهم غدرهم كما اشتكت % عقيرة إلى شفار العاقر % 10(@)(@@) % قد وقروا عنها وكانت مدة % تسمع منهم كل سمع وافر % PageV01P876 11(@)(@@) % وكلما ليموا 
ms291	 على جفائها % % تواكلوا فيها إلى المعاذر % 12(@)(@@) % فليت شعر جدبها إذ صوحوا % % أين الخصيب الكث في المشافر % 13(@)(@@) % وهبهم عن السيول عجزوا % % فأين بالقاطر بعد القاطر % 14(@)(@@) % كانت لها واسعة ركابهم % وكيلهم في الحظ كيل الخاسر % 15(@)(@@) % ففيم ضاقوا فتناسوا حقها % % والدهر يعطيهم بسهم وافر % 16(@)(@@) % كانت وهم في طي أغمادهم % لم تتبرزهم يمين شاهر % 17(@)(@@) % وافرة أقسامها فما لها % % لم تقتضب من هذه المناشر % 18(@)(@@) % هل ذخرتهم دون من فوق الثرى % % إلا ليوم النفع بالذخائر % 19(@)(@@) % لو شاوروا مجد ابن أيوب لما % % فاتتهم حزامة المشاور % 20(@)(@@) % إذن لقد تعلموا ولقنوا % % رعي الحقوق منه والأواصر % PageV01P877 21(@)(@@) % لله راع منهم مستيقظ % لم يتظلم طول ليل الساهر % 22(@)(@@) % يرى الصباح كل من توقظه ال % % عليا وما لليله من آخر % 23(@)(@@) % جرى إلى غايته فنالها % % مخاطرا والسبق للمخاطر % 24(@)(@@) % ما برحت تبعثه همته % في طلب الجسائم الكبائر % 25(@)(@@) % حتى أناف آخذا بحقه % من العلا أخذ العزيز القادر % 26(@)(@@) % رد عميد الرؤساء دارس ال % % مجد وأحيا كل فضل داثر % 27(@)(@@) % حلق حتى اشتط في سمائه % بحاكم في نفسه وآمر % 28(@)(@@) % وبعد في الغيب له بقية % ناطقة الأنباء والبشائر % 29(@)(@@) % ولم يقصر قومه عن سودد % يخبر عن أولهم بالآخر % 30(@)(@@) % ولا استزلوا عن مقام شرف % توارثوه كابرا عن كابر % PageV01P878 31(@)(@@) % لكنه زاد بنفس فضلت % فضل يد الذارع شبر الشابر % 32(@)(@@) % والشمس مع أن النجوم قومها % % تنسخهن بالضياء الباهر % 33(@)(@@) % وخير من كاثرك الفخر به % شهادة الأنفس للعناصر % 34(@)(@@) % هون في الجود عليه فقره % أن المعالي إخوة المفاقر % 35(@)(@@) % فالمال منه بين مفن واهب % والناس بين مقتن وذاخر % 36(@)(@@) % ولن ترى الكف القليل وفرها % % في الناس إلا لابن عرض وافر % 37(@)(@@) % من راكب تحمله وحاجة % أم الطريق من بنات داعر % 38(@)(@@) % ضامرة تركبت نسبتها % % شطرين من ضامرة وضامر % 39(@)(@@) % يقطع عني مطرح العينين لا % % أسومه مشقة المسافر % 40(@)(@@) % من أسهلت أو أحزنت رحلته % فحظه حظ المجير العابر % PageV01P879 41(@)(@@) % بلغ على قرب المدى وعجب % قولي بلغ حاضرا 
ms292	 عن حاضر % 42(@)(@@) % ناد بها الأوحد يا أكرم من % تثنى عليه عقد الخناصر % 43(@)(@@) % لم تسد الناس بحظ غالط % متفق ولا بحكم جائر % 44(@)(@@) % ولا وزرت الخلفاء عرضا % % بل عن يقين من عليم خابر % 45(@)(@@) % ما هزك القائم حتى اختبرت % بالجس حديك يمين القادر % 46(@)(@@) % خليفتان اصطفياك بعد ما % % تنخلا سريرة الضمائر % 47(@)(@@) % وجربا قبلك كل ناكل % فعرفا فضل الجراز الباتر % 48(@)(@@) % لم تك كالقبائل في حباله % والدين منه مسحل المرائر % 49(@)(@@) % يأكل مال الله غير حرج الص % در بما جر من الجرائر % 50(@)(@@) % فانعم بما أعطيت من رأيهما % % وكاثر المجد به وفاخر % PageV01P880 51(@)(@@) % واكتس ما ألحفت في ظليهما % % من ردن زاك وذيل طاهر % 52(@)(@@) % فحسب أعدائك كبتا وكفى % % كبا على الجباه والمناخر % 53(@)(@@) % إن الذي مات ففات منهما % % بقاك ذخرا بعده للغابر % 54(@)(@@) % فابق على ما رغموا مملكا % % أزمة الدسوت والمنابر % 55(@)(@@) % ما دامت المروة أختا للصفا % % والبيت بين ماسح ودائر % 56(@)(@@) % واجلس لأيام التهاني مالئا % % صدورها بالمجد والمآثر % 57(@)(@@) % تطلع منها كل يوم شارق % بمهرجان وبعيد زائر % 58(@)(@@) % لك الزكي البر من أيامها % % وللأعادي كل يوم فاجر % 59(@)(@@) % واسمع أناديك بكل غادة % غربية لم تجر في الخواطر % 60(@)(@@) % مؤيسة الغرام في باطنها % % مطعمة في نفسها بالظاهر % PageV01P881 61(@)(@@) % وهي على كثرة من يحبها % % وحسنها قليلة الضرائر % 62(@)(@@) % تستولد الوداد والأموال من % كل عقيم في الولاد عاقر % 63(@)(@@) % فلست تدري فكرة من شاعر % جاءت بها أو نفثة من ساحر % 64(@)(@@) % ملكك الود عزيز رقها % % وهي من الكرائم الحرائر % 65(@)(@@) % تفضل في وصفك ما تفضله % في الروض أسآر الغمام الباكر % 66(@)(@@) % لاتشتكيك والملال حظها % % منك وأن ريعت بهجر الهاجر % 67(@)(@@) % في سالف الوصف وفي مستأنف ال % % جفاء بين شاكر وعاذر % 68(@)(@@) % واعرف لها اعترافها إذ أنصقت % واعرف لها في الجور فضل الصابر % PageV01P882 البحر : - 1(@)(@@) % لعمر الواشيات بأم عمرو % لقد أغرين والتأنيب يغري % % 2(@)(@@) % حسدن مودة فحملن إفكا % وعبن وعائب الحسناء يفرى % % 3(@)(@@) % يردن على الوفاء نزوع خلقي % % وما ساومني شططا كغدري 
ms293	 % % 4(@)(@@) % وهل هيفاء إن غدرت وجارت % سوى غصن من الأرواح يجري % % 5(@)(@@) % وقلن تلونت لك حين ملت % وليس على الملالة كل هجر % 6(@)(@@) % تقلبها أصابيغ الغواني % % على الطعمين في حلو ومر % 7(@)(@@) % وأين من الحفاظ لها فؤادي % % إذا لم ألق زلتها بعذر % 8(@)(@@) % ومن يصبح هواك له أميرا % عليك فداره في كل أمر % 9(@)(@@) % وأبعد ما ظفرت به حبيب % جراحته تصح بكل سبر % 10(@)(@@) % وإن أحبتي لبنو زماني % % كلا العودين من سنخ ونجر % PageV01P883 11(@)(@@) % فهبني مبدلا خلا بخل % فهل أنا مبدل دهرا بدهر % 12(@)(@@) % سألبس ما كسيت ورب كاس % يزخرفك الملابس وهو معري % % 13(@)(@@) % وأحملهم وإياهم بقلب % يفي بالثقل لي إن خان ظهري % % 14(@)(@@) % ولست بواجد قلبا صحيحا % إذا نخلت دفينة كل صدر % 15(@)(@@) % فلا تتعن لائمة بعذلي % % ولا تغمز فما تسطيع كسري % % 16(@)(@@) % ولا يخف الصديق شبا لساني % % على عرض ولا لسعات فكري % % 17(@)(@@) % فلا ألقى بغير الصبر قرنا % % لعلي أجتني ثمرات صبري % % 18(@)(@@) % وإن ضعفت أواصر من رجال % % شددت بأسرة الكرماء أسري % % 19(@)(@@) % وفاء من الوزير علي ظل % يقيني الضيم من حر وقر % 20(@)(@@) % وأحجب نائبات الدهر منه % بخوص لا تحصلني وشزر % PageV01P884 21(@)(@@) % تراني أعين الأيام منه % بوافي الظل أخضر مسبكر % 22(@)(@@) % وكيف يريني وحماه بابي % % وهيبته عن الأبصار ستري % % 23(@)(@@) % ودوني من حمايته خميس % أخو عرضين يبهم كل ثغر % 24(@)(@@) % تزمجر في جوانبه أسود % على ألبادها أسلات نصر % 25(@)(@@) % تظفر باسمه الميمون أني % % سرت حتى الحوادث ليس تسري % % 26(@)(@@) % نفذت برشده فنفضت طرفي % % وصلت بحده فقضيت نذري % % 27(@)(@@) % وكيف يضل أو يخشى ابن ليل % سطا بمهند وسرى ببدر % 28(@)(@@) % أقول لمنفضين ترحلوها % % مطايا أزمة وركاب ضر % 29(@)(@@) % تعسف عيشهم فطوى عليهم % وأيديهم على سغب وفقر % 30(@)(@@) % يمنون الطوى ليلا بليل % وتعريس السرى فجرا بفجر % PageV01P885 31(@)(@@) % وراء الرزق مختبطين ترمي % % بهم أصدارها قفرا بقفر % 32(@)(@@) % وراءكم ارجعوا فتضيفوها % % بيوتا لا مجاعة وهي تقري % % 33(@)(@@) % تصرف باليفاع مطنبوها % % مع الكرمين من حلب ونحر % 34(@)(@@) % إذا ما احتلها الطراق لاحت 
ms294	 % لأيديهم عصامة كل عسر % 35(@)(@@) % بنو عبد الرحيم على حباها % % بنو الأبوين من لسن وفخر % 36(@)(@@) % وإن ببابل منهم لطودا % % يضعضع كل أرعن مشمخر % 37(@)(@@) % وبحرا من بني سعد عميقا % بغير قرارة وبغير قعر % 38(@)(@@) % حمى حرم الوزارة منه عاص % على الأقران في كر وفر % 39(@)(@@) % خضيب النار والأظفار مما % % يقد على فريسته ويفري % % 40(@)(@@) % إذا ما هيج عنها ثار منه % إلى الهجاج عاصفة بقر % PageV01P886 41(@)(@@) % إذا الغارات طفن به كفته % زماجر بين همهمة وهمر % 42(@)(@@) % فما يمنع يبت ما بين نسر % مع العيوق مجنوب ونسر % 43(@)(@@) % كفاها بالسياسة بعد عجز % وأمنها على حذر وذعر % 44(@)(@@) % ربى في حجرها وتداولتها % % مناكح منه شفعا بعد وتر % 45(@)(@@) % فما نفرت من الغرباء إلا % أوت منه إلى ولد وصهر % 46(@)(@@) % وإن تظفر بعذرتها رجال % حظوا بطلاقة الزمن الأغر % 47(@)(@@) % وأعقبهم على الأيام ذكرا % فعصرك بالكفاية خير عصر % 48(@)(@@) % براك الله سهما دق عما % % تريس له بنو ثعل وتبري % % 49(@)(@@) % إذا الرامي ثلاثا أو رباعا % أصاب أصبت من عشر بعشر % 50(@)(@@) % فداؤك مغلق الجنبين يأوي % % إلى صدر يضيق بكل سر % PageV01P887 51(@)(@@) % إذا ثقلت وسوق الرأي أقعى % % يحك بظهره من غير عسر % 52(@)(@@) % ومعتل البنان على العطايا % % يظل البخل في عرض التحري % % 53(@)(@@) % يجود وما عليه فضول حق % على عدم ويمنع وهو مثري % % 54(@)(@@) % ومولى وهو حر عبدته % هباتك في زمان غير حر % 55(@)(@@) % رعيت له أواصر محكمات % علقنك معلق المرس الممر % 56(@)(@@) % تذكرها بعهد منك حي % وشكر الملك يقتل كل شكر % 57(@)(@@) % ولكن ما لشعري في هنات % تطارحني الظلامة ليت شعري % % 58(@)(@@) % وما عتب اسميه التجني % % وننبزه الأعادي باسم غدر % 59(@)(@@) % أشكا في وفائي بعد علم % وقدحا في حفاظي بعد خبر % 60(@)(@@) % وإعراضا عن الشيم اللواتي % % عليها طينتي طبعت وفطري % % PageV01P888 61(@)(@@) % أأعزف عنكم أبغي بصوني % % لساني مع معاسرة وفكر % 62(@)(@@) % وإني لا أرى الدنيا كفاء % لشيء فيه منقصة لقدري % % 63(@)(@@) % وأحمل ملء أضلاعي جراحا % ولم أحمل لعيب خدش ظفر % 64(@)(@@) % أبغضا أم لأني سني 
ms295	 مدت % فدام عليكم ردي وكري % % 65(@)(@@) % ولم يملل مديحكم لساني % % فكيف مللتم من طول عمري % % 66(@)(@@) % وكيف وزنتم بي من عساه % يود بباعه لو قاس فتري % % 67(@)(@@) % فهل في الأرض أفسق في حديث % من العازي إلي مقام شر % 68(@)(@@) % وما أنا من وشايته وإني ال % % ذي رقاه من خلي وخمري % % 69(@)(@@) % مطار لست منه وليس مني % % بعيد الشوط في نفعي وضري % % 70(@)(@@) % فإن أنصف فإن يدا تولت % كسوري تهتدي لمكان جبري % % PageV01P889 71(@)(@@) % وإن أحرم قضاء العدل أرجع % إلى كفئين من هجر وصبر % 72(@)(@@) % وأعلم بعدأنك أنت باق % على العهدين من صلتي وبري % % 73(@)(@@) % وأنك لو رأيت الترب فوقي % % لقمت بقدرة فوليت نشري % % 74(@)(@@) % تسمعها سمعت الخير توع ال % % فصاحة بين معتبة وشكر % 75(@)(@@) % أنلها الود واجتلها هنيئا % ولولا الود لم تقنع بمهر % 76(@)(@@) % وغاد صبيحة النيروز منها % % بنشطة ثيب وحياء بكر % 77(@)(@@) % وطاول مدة الأيام واسحب % ذيول الملك من بيض وخضر % 78(@)(@@) % إلى أن ترجع الغبراء ماء % وتمشي الراسيات بها وتجري % % 79(@)(@@) % أناوبك المديح مدى حياتي % % وأنشده أمامك يوم حشري % % PageV01P890 البحر : - 1(@)(@@) % الليل بعد اليأس أطمع ناظري % % في عطفة السالي ووصل الهاجر % 2(@)(@@) % غلط الكرى بزيارة لم أرضها % % مخلوسة جاءت بكره الزائر % 3(@)(@@) % هاج الرقاد بها غراما كامنا % فذممته وحمدت ليل الساهر % 4(@)(@@) % ما كان إلا لمحة من بارق % منه تقارب أول من آخر % 5(@)(@@) % ملت فكان الغادر الناسي بها % % أحظى لدي من الوفي الذاكر % 6(@)(@@) % والوصل ما برد الغليل وشره % ما عاد يوقد في الغليل الفاتر % 7(@)(@@) % هل رفد ذات الطوق يوما عائد % بسوى الخديعة من سحاب عابر % 8(@)(@@) % أم عند ليلاتي الطوال ببابل % من رد أيامي القصار بحاجر % 9(@)(@@) % راميت من خنساء من لا يتقى % % بحشى تذوب ولا بجفن قاطر % 10(@)(@@) % وصبرت لكن ما صبرت جلادة % عنها ولم أظفر بأجر الصابر % PageV01P891 11(@)(@@) % قدرت على قتل النفوس ضعيفة % يا للرجال من الضعيف القادر % 12(@)(@@) % من منصفي من ظالم لم أنتصر % منه على أني كثير الناصر % 13(@)(@@) % عاصيت حكم العاذلين 
ms296	 وسامني % % فأطعته حكم العسوف الجائر % 14(@)(@@) % ومن البلية أن تنكر عهده % إذا أنكرت قصبي بنان الضافر % 15(@)(@@) % لم أبك يوما نضرة بوصاله % حتى بكيت على الشباب الناضر % 16(@)(@@) % أعدى إلى شعري حؤول وفائه % بالغدر حتى حال لون غدائري % % 17(@)(@@) % فاليوم أوراقي لأول جارد % خورا وعيداني لأول كاسر % 18(@)(@@) % قد كنت أشوس لا تهز خصائلي % % كف المهجهج بالحسام الباتر % 19(@)(@@) % آوى إلى حصن الشباب يجود لي % % ما لا يحوط قبائلي وعشائري % % 20(@)(@@) % فالآن قلبي في ضلوع حمامة % حصاء سربها صفير الصافر % PageV01P892 21(@)(@@) % لكنني ألقى الحوادث من بني % % عبد الرحيم بباطش وبقاهر % 22(@)(@@) % هم خير ماحملت فقامت حرة % حصناء عن كرم وذيل طاهر % 23(@)(@@) % ولدتهم أم الفضائل أخوة % متشابهين أصاغرا كأكابر % 24(@)(@@) % كالراح كل بنانها منها وإن % بان اختلاف أباهم وخناصر % 25(@)(@@) % وتنجلت لتجيء بعد بمثلهم % فأبت على الميلاد بطن العاقر % 26(@)(@@) % أبناء تيجان الأسرة قوبلوا % % في الفخر بين مزارب وأكاسر % 27(@)(@@) % فإذا أنتضوها ألسنا عربية % فسيوف أندية وقضب منابر % 28(@)(@@) % وإذا الرواية في السيادة ضعفت % نقلوا الرياسة كابرا عن كابر % 29(@)(@@) % كانوا الرءوس قديمها وحديثها % % في مؤمن في دهره أو كافر % 30(@)(@@) % وعلى كمال الملك منهم مسحة % فعليك صورة غائب في حاضر % PageV01P893 31(@)(@@) % قف في شمائل فخره متفرسا % وخذ الخفي على قياس الظاهر % 32(@)(@@) % جمع الغرائب في السيادة رأيه % حتى التأمن وهن غير نظائر % 33(@)(@@) % ورمى صدورا لحادثات بعزمة % فأصابهن بقاصد وبعائر % 34(@)(@@) % ملأ الوسائد من سطاه وبشره % قمر يناط بصدر ليث خادر % 35(@)(@@) % وورى له زند العواقب رأيه % فأراه واردها طريق الصادر % 36(@)(@@) % شد الوزارة منه كف فاتل % من بعد ما انتقضت بكف الناسر % 37(@)(@@) % وسطت يمين أخيه منه بمثلها % % فهما يمينا قوة وتآزر % 38(@)(@@) % كالنيرين متى تغيب شمس الضحى % % تخلف بدر في الدجنة باهر % 39(@)(@@) % بأبي المعالي ريض كل محارن % ونمى الكسير على عصاب الجابر % 40(@)(@@) % من كان مقهور الرجاء مخيب ال % % مسعي فراجيه شريك القاهر % PageV01P894 41(@)(@@) % يا من يسد فريج كل ثنية % فتقت ويكعم كل خطب فاغر % 42 
ms297	(@)(@@) % ويتم كل نقيصة بكماله % كالرمح متموعا بباع عاشر % 43(@)(@@) % لا تهتدي طرق الصلاح بغيركم % والناس بين مضلل أو حائر % 44(@)(@@) % والملك ما لم تقدحوه دجنة % يقتاف سائرها بنجم غائر % 45(@)(@@) % فإن اعترتكم هفوة أو صدكم % غضب المنيل على الغموط الكافر % 46(@)(@@) % ورأيتم نعماءكم وصنيعكم % لا في المقر لكم ولا في الشاكر % 47(@)(@@) % فلكم غدا أيام وصل طولها % % موف على اليوم القصير الهاجر % 48(@)(@@) % لا غرني هذا الصدود فإنه % صد المدل وليس صد الغادر % 49(@)(@@) % كانت لكم وغدا تصير إليكم % طوعا بخير عواقب ومصادر % 50(@)(@@) % ولرب معتزل تعطل فاغتدى % % سبب البلاء على المولى الناظر % PageV01P895 51(@)(@@) % ومقلد أمرا يكون بجيده % حلى الذبيحة سومت للجازر % 52(@)(@@) % خلدت للحسنات تنثرها يدا % فيدا وينظمها لسان الشاعر % 53(@)(@@) % بك ذدت عن ظهري فلم أربع على % % ظلع ولم أصفق بكف الخاسر % 54(@)(@@) % إما حضرت فجنتي أو بنت عن % وطني فجودك خير زاد مسافر % 55(@)(@@) % ما غاب وجهك لا يغب عن ناظري % % إلا ذكرتك بالهلال الزاهر % 56(@)(@@) % فإذا عدمت ندى يديك تعللت % خلات حالي بالغمام الماطر % 57(@)(@@) % عوضا وهل شيء يحل بعائض % من بعد وجهك أو نداك الغامر % 58(@)(@@) % فاذهب على كرم شرعت طريقه % والناس فيه على مدق الحافر % 59(@)(@@) % واذكر نسايا الشعر عندك إنها % % لا تنفع الذكرى لغير الذاكر % 60(@)(@@) % وتلق يوم المهرجان بأول % من عمر عزك لا يراع بآخر % PageV01P896 61(@)(@@) % يوم يمت إليه طالع سعده % بوشائج من سعده وأواصر % 62(@)(@@) % ويقوم مفتخرا بأنك وهو من % بيت العلا فيبذ كل مفاخر % 63(@)(@@) % ولعمر من نسك الحجيج لبيته % دأبا وخاطر فيه كل مخاطر % 64(@)(@@) % لأحق يوم أن يكون معظما % يوم يضمك وهو طين الفاطر % PageV01P897 البحر : - 1(@)(@@) % وأم يفوز بأعلانها % % بنوها ويدهون من سرها % % 2(@)(@@) % عجوز ولود تعد البعول % كثيرا وكل أبو عذرها % % 3(@)(@@) % إذا نتجت طامثا كان ذا % % ك أشبه في الحزم من طهرها % % 4(@)(@@) % يطاها بنوها وهم مسلمو % % ن حتى تعود إلى كفرها % % 5(@)(@@) % تدبرها أختها في الرضاع % فتمضي الأمور على امرها % % 6(@)(@@) % إذا ولدت بطنها للتمام 
ms298	 % فتى شهرته على ظهرها % % 7(@)(@@) % لها الفخر بالذكر والإنتساب % % إليها وتبعد عن ذكرها % % PageV01P898 البحر : - 1(@)(@@) % بطرفك والمسحور يقسم بالسحر % أعمدا رماني أم أصاب ولا يدري % % 2(@)(@@) % تعرض لي في القانصين مسدد ال % % إشارة مدلول السهام على النحر % 3(@)(@@) % رمى اللحظة الأولى فقلت مجرب % وكررها أخرى فأحسست بالشر % 4(@)(@@) % فهل ظن ما قد حرم الله من دمي % % مباحا له أم نام قوم على الوتر % 5(@)(@@) % بنجد ونجد دار جود وذمة % مطال بلا عسر ومطل بلا عذر % 6(@)(@@) % وسمراء ود البدر لو حال لونه % إلى لونها في صبغة الأوجه السمر % 7(@)(@@) % خليلي هل من وقفة والتفاتة % إلى القبة السوداء من جانب الحجر % 8(@)(@@) % وهل من أرانا الحج بالخيف عائد % إلى مثلها أو عدها حجة العمر % 9(@)(@@) % فلله ما أوفى اللات على منى % لأهل الهوى لو لم تحن ليلة النفر % 10(@)(@@) % لقد كنت لا أوتى من الصبر قبلها % % فهل تعلمان اليوم إلى أين مضى صبري % % PageV01P899 11(@)(@@) % وكنت ألوم العاشقين ولا أرى % % مزية ما بين الوصال إلى الهجر % 12(@)(@@) % فأعدي إلى الحب صحبة أهله % ولم يدري قلبي أن داء الهوى يسري % % 13(@)(@@) % أيشرد لبي يا غزالة حاجر % وأنت بذات البان مجموعة الأمر % 14(@)(@@) % خذي لحظ عيني في الغصوب إضافة % إلى القلب أو ردي فؤادي إلى صدري % % 15(@)(@@) % وإلا فظهر الهجر أوطا مركبا % % إذا خنت واستوطأت لي مركب الغدر % 16(@)(@@) % وإني لجلد العزم أملك شهوتي % % وأعرف أيامي وأقوى على سري % % 17(@)(@@) % وأحمل أثقال الحبيب خفيفة % ولكن حمل الضيم ثقل على ظهري % % 18(@)(@@) % ولا يملك المولى وفائي بنكثه % ولا يشتري معروف ودي بالنكر % 19(@)(@@) % ومن دون ضيمي بسطة الأرض والسرى % % وخوض الدياجي وامتعاض الفتى الحر % 20(@)(@@) % وإني من مولى الملوك ورأيه % وسلطانه بين المجرة والنسر % PageV01P900 21(@)(@@) % فلا انا مغمود ولا أنا مسلم % وفي سيفه عزي وفي يده نصري % % 22(@)(@@) % تعالى بركن الدين صوتي وشيدت % محاسنه وصفي وسار بها ذكري % % 23(@)(@@) % وكان إلى الدهر بالشر ناظرا % فغمض عني جوده ناظر الدهر % 24(@)(@@) % وإن كان هذا القول قدما 
ms299	 يطيعني % % فقد زاد بسطا في لساني وفي فكري % % 25(@)(@@) % وكنت له نجما فلما مدحته % كساني سنا إقباله بلجة الفجر % 26(@)(@@) % إليك مليك الأرض ألقت ملوكها اض % % طرارا عنان النهي في الأرض والأمر % 27(@)(@@) % ودان لك الغر الميامين من بني % % بويه كما دان الكواكب للبدر % 28(@)(@@) % رأوك فتاهم في الشجاعة والندى % % وشيخهم المتبوع في الرأي والعمر % 29(@)(@@) % فأعطوك طوعا ما تعذر منهم % على كل باغ بالكراهة والقسر % 30(@)(@@) % نظمت لهم عقد العلا وفضلتهم % فأصبحت وسط العقد في ذلك النحر % PageV01P901 31(@)(@@) % لكم أول الدنيا القديم وعنكم % يكون قيام الأمر في ساعة الحشر % 32(@)(@@) % وما الملك إلا ما اختبى متمدحا % بأيامكم فيه المحجلة الغر % 33(@)(@@) % ولا الدهر إلا ما تقلب صرفه % على ما قسمتم من يسار ومن عسر % 34(@)(@@) % ولا تطعم الدنيا بنيها سوى الذي % % تشيرون من حلو إليه ومن مر % 35(@)(@@) % بكم يصبح الدين الحنفي آمنا % إذا بات مخلوع الفؤاد من الذعر % 36(@)(@@) % ما برحت أبياتكم في ابتنائه % دعائم للخطي والقضب البتر % 37(@)(@@) % وأنت الذي كنت الذخيرة منهم % قديما إذا الرحمن بارك في الذخر % 38(@)(@@) % فلو بقى الماضون منهم تمثلوا % % مملكك في ملك وعصرك في عصر % 39(@)(@@) % إذا ما أراد الله إحياء دولة % بغاك بنوها بالخديعة والمكر % 40(@)(@@) % وإن شاء في دهمان قوم إبادة % رماهم بدهم من جيادك أو شقر % PageV01P902 41(@)(@@) % ومن مل طول العمر والعز قاده % لك الحين في حبل الشناءة والغمر % 42(@)(@@) % قسمت بكفيك المنية والغنى % % للهفان يستجدي وعضبان يستشري % % 43(@)(@@) % فأنت غذا شمت الظبا قاتل العدا % % وأنت إذا شمت الندى قاتل الفقر % 44(@)(@@) % فلا زال معقودا عطاؤك بالغنى % % ولا زال معقودا لواؤك بالنصر % 45(@)(@@) % وزارك بالنيروز أيمن قادم % % سرى لك في وفد الرجاء الذي يسري % % 46(@)(@@) % جديدا على العام الجديد مؤمرا % كما أمرك الماضي على العبد والحر % 47(@)(@@) % تزخرف منه الأرض في حلى روضها % % بما كسيت من صبغ أيامك الخضر % 48(@)(@@) % كأن الربيع من صفاتك يمتري % % وشائعه ومن سجاياك يستقري % % 49(@)(@@) % فطاول به عد السنين مفاوتا % بعمرك مقدار الإحاطة 
ms300	 والحصر % 50(@)(@@) % متى تطو ملكا تنتشر لك بعده % ممالك لا تبلى على الطي والنشر % PageV01P903 51(@)(@@) % وحياك مني بالمديح مبشر % خمائل لم تنبت على سبل القطر % 52(@)(@@) % لها مدد من خاطر غير ناضب % ملئ إذا كافا الصنيعة بالشكر % 53(@)(@@) % خدمتك منها بالمحصنة التي % % عليها أحامي والمخدرة البكر % 54(@)(@@) % فكرمتني لما قبلت نكاحها % % وزيدت من فضلي وضاعفت من قدري % % 55(@)(@@) % وملكتني قلبا كريما ولم أكن % أظن قلوب الأسد تملك بالشعر % 56(@)(@@) % فقمت على ظل من الأنس بارد % ومن هيبة الملك العقيم على الجمر % 57(@)(@@) % ولكنها قد موطلت بمهورها % % ولا بد في عقد النكاح من المهر % 58(@)(@@) % ومما شجاها أن تضل وسيرها % % مع النجم أو تظما على ساحل البحر % 59(@)(@@) % وخير العطايا ما يراد به العلا % % وما كل جود باللجين وبالتبر % 60(@)(@@) % وما بي إلا أن نسيت فراعني % % لتعلم أني من رعاك على ذكر % PageV01P904 البحر : - 1(@)(@@) % كم النوى قد جزع الصابر % وقنط المهجور يا هاجر % 2(@)(@@) % أأحمد البادون في عيشهم % ما ذم من بعدهم الحاضر % 3(@)(@@) % أم كان يوم البين حاشاكم % أول شيء ما له آخر % 4(@)(@@) % ما لقلوب جبلت لدنة % يعطفها العاجم والكاسر % 5(@)(@@) % قست على البعد وقد ظن بال % % وفي منها أنه الغادر % 6(@)(@@) % قد آن للناسين أن يرعووا % % شيئا فما عذرك يا ذاكر % 7(@)(@@) % أما يهز الشوق عطفا ولا % % يجذب هذا الوطن الساحر % 8(@)(@@) % كم يمطل الملسوع في الوعد بالر % اقي وكم ينتظر الناظر % 9(@)(@@) % قد صدع العظم وأخلق متى % % شظي أن لا ينفع الجابر % 10(@)(@@) % لا تتركوا المحصوص في أسركم % يخلف ريشا إنه طائر % PageV01P905 11(@)(@@) % الله يا فاتل أمراسها % % أن يتولى أمرها الناسر % 12(@)(@@) % اقبل من الباذل واقنع بما % % يعطيك من باطنه الظاهر % 13(@)(@@) % ولا تكشف عن خفيات ما % % يخفيه عنك الهائب السائر % 14(@)(@@) % وشاور الإقبال من قبل ما % % تشاور الرأي وتستامر % 15(@)(@@) % وانهض بجد فلكم ناهض % % بالحزم والحزم به عاثر % 16(@)(@@) % سعدك في أمثالها ضامن % أنك فيها الفائز الظافر % 17(@)(@@) % قد أهمل النوام في سرحها % % ما كان يرعى 