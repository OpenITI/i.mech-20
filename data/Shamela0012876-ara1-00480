ms461	 خبر ثان {فيها من} بعض {أساور من ذهب ولؤلؤا} مرصع بالذهب {ولباسهم فيها حرير}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P576(@)(@@) {وقالوا الحمد لله الذي أذهب عنا الحزن} جميعه {إن ربنا لغفور} للذنوب {شكور} للطاعة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P576(@)(@@) {الذي أحلنا دار المقامة} الإقامة {من فضله لا يمسنا فيها نصب} تعب {ولا يمسنا فيها لغوب} إعياء من التعب لعدم التكليف فيها وذكر الثاني التابع للأول للتصريح بنفيه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P576(@)(@@) {والذين كفروا لهم نار جهنم لا يقضى عليهم} بالموت {فيموتوا} يستريحوا {ولا يخفف عنهم من عذابها} طرفة عين {كذلك} كما جزيناهم {يجزئ كل كفور} كافر بالياء والنون المفتوحة مع كسر الزاي ونصب كل(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P576(@)(@@) {وهم يصطرخون فيها} يستغيثون بشدة وعويل يقولون {ربنا أخرجنا} منها {نعمل صالحا غير الذي كنا نعمل} فيقال لهم {أو لم نعمركم ما}(@)(@@) وقتا {يتذكر فيه من تذكر وجاءكم النذير} الرسول فما أجبتم {فذوقوا فما للظالمين} الكافرين {من نصير} يدفع العذاب عنهم(@)(@@) PageV01P576(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P577(@)(@@) {إن الله عالم غيب السماوات والأرض إنه عليم بذات الصدور} بما في القلوب فعلمه بغيره أولى بالنظر إلى حال الناس(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P577(@)(@@) {هو الذي جعلكم خلائف في الأرض} جمع خليفة أي يخلف بعضكم بعضا {فمن كفر} منكم {فعليه كفره} أي وبال كفره {ولا يزيد الكافرين كفرهم عند ربهم إلا مقتا} غضبا {ولا يزيد الكافرين كفرهم إلا خسارا} للآخرة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P577(@)(@@) {قل أرأيتم شركاءكم الذين تدعون} تعبدون {من دون الله} أي غيره وهم الأصنام الذين زعمتم أنهم شركاء الله تعالى {أروني} أخبروني {ماذا خلقوا من الأرض أم لهم شرك} شركة مع الله {في} خلق {السماوات أم آتيناهم كتابا فهم على بينة} حجة {منه} بأن لهم معي شركة لا شيء من ذلك {بل إن} ما {يعد الظالمون} الكافرون {بعضهم بعضا إلا غرورا} باطلا بقولهم الأصنام تشفع لهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P577(@)(@@) {إن الله يمسك السماوات والأرض أن تزولا} أي يمنعهما من الزوال {ولئن} لام قسم {زالتا إن} ما {أمسكهما} يمسكهما {من أحد من بعده} أي سواه {إنه كان حليما غفورا} في تأخير عقاب الكفار(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P577(@)(@@) {وأقسموا} أي كفار مكة {بالله جهد أيمانهم} 
ms462	 غاية اجتهادهم فيها {لئن جاءهم نذير} رسول {ليكونن أهدى من إحدى الأمم} اليهود والنصارى وغيرهم أي أي واحدة منها لما رأوا من تكذيب بعضهم بعضا إذ قالت اليهود ليست النصارى على شيء وقالت النصارى ليست اليهود على شيء {فلما جاءهم نذير} محمد صلى الله عليه وسلم {ما زادهم} مجيئه {إلا نفورا} تباعدا عن الهدى(@)(@@) PageV01P577(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P578(@)(@@) {استكبارا في الأرض} عن الإيمان مفعول له {ومكر} العمل {السيء} من الشرك وغيره {ولا يحيق} يحيط {المكر السيء إلا بأهله} وهو الماكر ووصف المكر بالسيء أصل وإضافته إليه قيل استعمال آخر قدر فيه مضاف حذرا من الإضافة إلى الصفة {فهل ينظرون} ينتظرون {إلا سنة الأولين} سنة الله فيهم من تعذيبهم بتكذيبهم رسلهم {فلن تجد لسنة الله تبديلا ولن تجد لسنة الله تحويلا} أي لا يبدل بالعذاب غيره ولا يحول إلى غير مستحقه(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P578(@)(@@) {أو لم يسيروا في الأرض فينظروا كيف كان عاقبة الذين من قبلهم وكانوا أشد منهم قوة} فأهلكهم الله بتكذيبهم رسلهم {وما كان الله ليعجزه من شيء} يسبقه ويفوته {في السماوات ولا في الأرض إنه كان عليما} أي بالأشياء كلها {قديرا} عليها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P578(@)(@@) {ولو يؤاخذ الله الناس بما كسبوا} من المعاصي {ما ترك على ظهرها} أي الأرض {من دابة} نسمة تدب عليها {ولكن يؤخرهم إلى أجل مسمى} أي يوم القيامة {فإذا جاء أجلهم فإن الله كان بعباده بصيرا} فيجازيهم على أعمالهم بإثابة المؤمنين وعقاب الكافرين = 36 سورة(@)(@@)(@@)(@@) | يس(@)(@@) مكية إلا آية 45 فمدنية وآياتها 83 نزلت بعد سورة الجن بسم الله الرحمن الرحيم(@)(@@) PageV01P578(@)(@@)(@@)(@@) | يس(@)(@@) } الله أعلم بمراده به(@)(@@) PageV01P578(@)(@@) {والقرآن الحكيم} المحكم بعجيب النظم وبديع المعاني(@)(@@) PageV01P578(@)(@@) {إنك} يا محمد {لمن المرسلين(@)(@@) PageV01P578(@)(@@) {على} متعلق بما قبله {صراط مستقيم} أي طريق الأنبياء قبلك التوحيد والهدى والتأكيد بالقسم وغيره رد لقول الكفار له لست مرسلا(@)(@@) PageV01P579(@)(@@) {تنزيل العزيز في} ملكه {الرحيم} بخلقه خبر مبتدأ مقدر أي القرآن(@)(@@) PageV01P579(@)(@@) {لتنذر} به {قوما} متعلق بتنزيل {ما أنذر آباؤهم} أي لم ينذروا في زمن الفترة {فهم} أي القوم {غافلون} عن الإيمان والرشد 
ms463	(@)(@@) PageV01P579(@)(@@) {لقد حق القول} وجب {على أكثرهم} بالعذاب {فهم لا يؤمنون} أي الأكثر(@)(@@) PageV01P579(@)(@@) {إنا جعلنا في أعناقهم أغلالا} بأن تضم إليها الأيدي لأن الغل يجمع اليد إلى العنق {فهي} أي الأيدي مجموعة {إلى الأذقان} جمع ذقن وهي مجتمع اللحيين {فهم مقمحون} رافعون رؤوسهم لا يستطيعون خفضها وهذا تمثيل والمراد أنهم لا يذعنون للإيمان ولا يخفضون رؤوسهم له(@)(@@) PageV01P579(@)(@@) {وجعلنا من بين أيديهم سدا ومن خلفهم سدا} بفتح السين وضمها في الموضعين {فأغشيناهم فهم لا يبصرون} تمثيل أيضا لسد طرق الإيمان عليهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P579(@)(@@) {وسواء عليهم أأنذرتهم} بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه {أم لم تنذرهم لا يؤمنون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P579(@)(@@) {إنما تنذر} ينفع إنذارك {من اتبع الذكر} القرآن {وخشي الرحمن بالغيب} خافه ولم يره {فبشره بمغفرة وأجر كريم} هو الجنة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P579(@)(@@) {إنا نحن نحيي الموتى} للبعث {ونكتب} في اللوح المحفوظ {ما قدموا} في حياتهم من خير وشر ليجازوا عليه {وآثارهم} ما استن به بعدهم {وكل شيء} نصبه بفعل يفسره {أحصيناه} ضبطناه {في إمام مبين} كتاب بين هو اللوح المحفوظ(@)(@@) PageV01P579(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {واضرب} اجعل {لهم مثلا} مفعول أول {أصحاب} مفعول ثان {القرية} أنطاكية {إذ جاءها} إلى آخره بدل اشتمال من أصحاب القرية {المرسلون} أي رسل عيسى(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {إذ أرسلنا إليهم اثنين فكذبوهما} إلى آخره بدل من إذ الأولى {فعززنا} بالتخفيف والتشديد قوينا الإثنين {بثالث فقالوا إنا إليكم مرسلون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {قالوا ما أنتم إلا بشر مثلنا وما أنزل الرحمن من شيء إن} ما {أنتم إلا تذكبون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {قالوا ربنا يعلم} جار مجرى القسم وزيد التأكيد به وباللام على ما قبله لزيادة الإنكار في {إنا إليكم لمرسلون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {وما علينا إلا البلاغ المبين} التبليغ المبين الظاهر بالأدلة الواضحة وهي إبراء الأكمه والأبرص والمريض وإحياء الميت(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {قالوا إنا تطيرنا} تشاءمنا {بكم} لانقطاع المطر عنا بسببكم {لئن} لام قسم {لم تنتهوا لنرجمنكم} بالحجارة {وليمسنكم منا عذاب أليم} مؤلم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P580(@)(@@) {قالوا طائركم} شؤمكم {معكم} بكفركم {أئن} همزة استفهام دخلت على إن الشرطية وفي همزتها التحقيق 
ms464	 والتسهيل وإدخال ألف بينها بوجهيها وبين الأخرى {ذكرتم} وعظتم وخوفتم وجواب الشرط محذوف أي تطيرتم وكفرتم وهو محل الاستفهام والمراد به التوبيخ {بل أنتم قوم مسرفون} متجاوزون الحد بشرككم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P580(@)(@@) {وجاء من أقصا المدينة رجل} هو حبيب النجار كان قد آمن بالرسل ومنزله بأقصى البلد {يسعى} يشتد عدوا لما سمع بتكذيب القوم الرسل {قال يا قوم اتبعوا المرسلين}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P580(@)(@@) {اتبعوا} تأكيد للأول {من لا يسألكم أجرا} على رسالته {وهم مهتدون} فقيل له أنت على دينهم(@)(@@) PageV01P580(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) فقال {وما لي لا أعبد الذي فطرني} خلقني أي لا مانع لي من عبادته الموجود مقتضيها وأنتم كذلك {وإليه ترجعون} بعد الموت فيجازيكم بكفركم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {أأتخذ} في الهمزتين منه ما تقدم في أأنذرتهم وهو استفهام بمعنى النفي {من دونه} أي غيره {آلهة} أصناما {إن يردن الرحمن بضر لا تغن عني شفاعتهم} التي زعمتموها {شيئا ولا ينقذون} صفة آلهة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {إني إذا} أي إن عبدت غير الله {لفي ضلال مبين} بين(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {إني آمنت بربكم فاسمعون} أي اسمعوا قولي فرجموه فمات(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {قيل} له عند موته {ادخل الجنة} وقيل دخلها حيا {قال يا} حرف تنبيه {ليت قومي يعلمون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {بما غفر لي ربي} بغفرانه {وجعلني من المكرمين}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {وما} نافية {أنزلنا على قومه} أي حبيب {من بعده} بعد موته {من جند من السماء} أي ملائكة لإهلاكهم {وما كنا منزلين} ملائكة لإهلاك أحد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P581(@)(@@) {إن} ما {كانت} عقوبتهم {إلا صيحة واحدة} صاح بهم جبريل {فإذا هم خامدون} ساكنون ميتون(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P581(@)(@@) {يا حسرة على العباد} هؤلاء ونحوهم ممن كذبوا الرسل فأهلكوا وهي شدة التألم ونداؤها مجاز أي هذا أوانك فاحضري {ما يأتيهم من رسول إلا كانوا به يستهزءون} مسوق لبيان سببها لاشتماله على استهزائهم المؤدي إلى إهلاكهم المسبب عنه الحسرة(@)(@@) PageV01P581(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {ألم يروا} أي أهل مكة القائلون للنبي لست مرسلا والاستفهام للتقرير أي علموا {كم} خبرية بمعنى كثيرا معمولة لما بعدها معلقة لما قبلها عن العمل والمعنى إنا {أهلكنا قبلهم} كثيرا {من القرون} الأمم {أنهم} أي المهلكين 
ms465	 {إليهم} أي المكذبين {لا يرجعون} أفلا يعتبرون بهم وأنه إلخ بدل مما قبله برعاية المعنى المذكور(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {وإن} نافية أو مخففة {كل} أي كل الخلائق مبتدأ {لما} بالتشديد بمعنى إلا أو بالتخفيف فاللام فارقة وما مزيدة {جميع} خبر المبتدأ أي مجموعون {لدينا} عندنا في الموقف بعد بعثهم {محضرون} للحساب خبر ثان(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {وآية لهم} على البعث خبر مقدم {الأرض الميتة} بالتخفيف والتشديد {أحييناها} بالماء مبتدأ {وأخرجنا منها حبا} كالحنطة {فمنه يأكلون}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {وجعلنا فيها جنات} بساتين {من نخيل وأعناب وفجرنا فيها من العيون} أي بعضها(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {ليأكلوا من ثمره} بفتحتين وضمتين أي ثمر المذكور من النخيل وغيره {وما عملته أيديهم} أي لم تعمل الثمر {أفلا يشكرون} أنعمه تعالى عليهم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {سبحان الذي خلق الأزواج} الأصناف {كلها مما تنبت الأرض} من الحبوب وغيرها {ومن أنفسهم} من الذكور والإناث {ومما لا يعلمون} من المخلوقات العجيبة الغريبة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {وآية لهم} على القدرة العظيمة {الليل نسلخ} نفصل {منه النهار فإذا هم مظلمون} داخلون في الظلام(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {والشمس تجري} إلى آخره من جملة الآية لهم أو آية أخرى والقمر كذلك {لمستقر لها} أي إليه لا تتجاوزه {ذلك} أي جريها {تقدير العزيز} في ملكه {العليم} بخلقه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P582(@)(@@) {والقمر} بالرفع والنصب وهو منصوب بفعل يفسره ما بعده {قدرناه} من حيث سيره {منازل} ثمانية وعشرين منزلا في ثمان وعشرين ليلة من كل شهر ويستتر ليلتين إن كان الشهر ثلاثين يوما وليلة إن كان تسعة وعشرين يوما {حتى عاد} في آخر منازله في رأي العين {كالعرجون القديم} أي كعود الشماريخ إذا عتق فإنه يرق ويتقوس ويصفر(@)(@@) PageV01P582(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {لا الشمس ينبغي} يسهل ويصح {لها أن تدرك القمر} فتجتمع معه في الليل {ولا الليل سابق النهار} فلا يأتي قبل انقضائه {وكل} تنوينه عوض عن المضاف إليه من الشمس والقمر والنجوم {في فلك} مستدير {يسبحون} يسيرون نزلوا منزلة العقلاء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وآية لهم} على قدرتنا {أنا حملنا ذريتهم} وفي قراءة ذرياتهم أي آباءهم الأصول {في الفلك} أي سفينة نوح {المشحون} المملوء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وخلقنا 
ms466	 لهم من مثله} أي مثل فلك نوح وهو ما عملوه على شكله من السفن الصغار والكبار بتعليم الله تعالى {ما يركبون} فيه(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وإن نشأ نغرقهم} مع إيجاد السفن {فلا صريخ} مغيث {لهم ولا هم ينقذون} ينجون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {إلا رحمة منا ومتاعا إلى حين} أي لا ينجيهم إلا رحمتنا لهم وتمتيعنا إياهم بلذاتهم إلى انقضاء آجالهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وإذا قيل لهم اتقوا ما بين أيديكم} من عذاب الدنيا كغيرهم {وما خلفكم} من عذاب الآخرة {لعلكم ترحمون} أعرضوا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {وإذا قيل} أي قال فقراء الصحابة {لهم أنفقوا} علينا {مما رزقكم الله} من الأموال {قال الذين كفروا للذين آمنوا} استهزاء بهم {أنطعم من لو يشاء الله أطعمه} في معتقدكم هذا {إن} ما {أنتم} في قولكم لنا ذلك مع معتقدكم هذا {إلا في ضلال مبين} بين وللتصريح بكفرهم موقع عظيم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P583(@)(@@) {ويقولون متى هذا الوعد} بالبعث {إن كنتم صادقين} فيه(@)(@@) PageV01P583(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P584(@)(@@) قال تعالى {ما ينظرون} أي ينتظرون {إلا صيحة واحدة} وهي نفخة إسرافيل الأولى {تأخذهم وهم يخصمون} بالتشديد أصله يختصمون نقلت حركة التاء إلى الخاء وأدغمت في الصاد أي وهم في غفلة عنها بتخاصم وتبايع وأكل وشرب وغير ذلك وفي قراءة يخصمون كيضربون أي يخصم بعضهم بعضا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {فلا يستطيعون توصية} أي أن يوصوا {ولا إلى أهلهم يرجعون} من أسواقهم وأشغالهم بل يموتون فيها(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {ونفخ في الصور} هو قرن النفخة الثانية للبعث وبين النفختين أربعون سنة {فإذا هم} أي المقبورون {من الأجداث} القبور {إلى ربهم ينسلون} يخرجون بسرعة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {قالوا} أي الكفار منهم {يا} للتنبيه {ويلنا} هلاكنا وهو مصدر لا فعل له من لفظه {من بعثنا من مرقدنا} لأنهم كانوا بين النفختين نائمين لم يعذبوا {هذا} أي البعث {ما} أي الذي {وعد} به {الرحمن وصدق} فيه {المرسلون} أقروا حين لا ينفعهم الإقرار وقيل يقال لهم ذلك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {إن} ما {كانت إلا صيحة واحدة فإذا هم جميع لدينا} عندنا {محضرون}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {فاليوم 
ms467	 لا تظلم نفس شيئا ولا تجزون إلا} جزاء {ما كنتم تعملون}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {إن أصحاب الجنة اليوم في شغل} بسكون الغين وضمها عما فيه أهل النار مما يتلذذون به كافتضاض الأبكار لا شغل يتعبون فيه لأن الجنة لا نصب فيها {فاكهون} ناعمون خبر ثان لإن والأول في شغل(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {هم} مبتدأ {وأزواجهم في ظلال} جمع ظلة أو ظل خبر أي لا تصيبهم الشمس {على الأرائك} جمع أريكة وهو السرير في الحجلة أو الفرش فيها {متكئون} خبر ثان متعلق على(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {لهم فيها فاكهة ولهم} فيها {ما يدعون} يتمنون(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {سلام} مبتدأ {قولا} أي بالقول خبره {من رب رحيم} بهم أي يقول لهم سلام عليكم(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P584(@)(@@) {و} يقول {امتازوا اليوم أيها المجرمون} أي انفردوا عن المؤمنين عند اختلاطهم بهم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P584(@)(@@) {ألم أعهد إليكم} آمركم {يا بني آدم} على لسان رسلي {أن لا تعبدوا الشيطان} لا تطيعوه {إنه لكم عدو مبين} بين العداوة(@)(@@) PageV01P584(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {وأن اعبدوني} وحدوني وأطيعوني {هذا صراط} طريق {مستقيم}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {ولقد أضل منكم جبلا} خلقا جمع جبيل كقديم وفي قراءة بضم الباء {كثيرا أفلم تكونوا تعقلون} عداوته وإضلاله أو ما حل بهم من العذاب فتؤمنون ويقال لهم في الآخرة(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {هذه جهنم التي كنتم توعدون} بها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {اصلوها اليوم بما كنتم تكفرون}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {اليوم نختم على أفواههم} أي الكفار لقولهم والله ربنا ما كنا مشركين {وتكلمنا أيديهم وتشهد أرجلهم} وغيرها {بما كانوا يكسبون} فكل عضو ينطق بما صدر منه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {ولو نشاء لطمسنا على أعينهم} لأعميناها طمسا {فاستبقوا} ابتدروا {الصراط} الطريق ذاهبين كعادتهم {فأنى} فكيف {يبصرون}(@)(@@) حينئذ أي لا يبصرون(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {ولو نشاء لمسخناهم} قردة وخنازير أو حجارة {على مكانتهم} وفي قراءة مكاناتهم جمع مكانة بمعنى مكان أي في منازلهم {فما استطاعوا مضيا ولا يرجعون} أي لم يقدروا على ذهاب ولا مجيء(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {ومن نعمره} بإطالة أجله {ننكسه} وفي قراءة بالتشديد من التنكيس {في الخلق} فيكون بعد قوته وشبابه ضعيفا وهرما {أفلا يعقلون} أن القادر على ذلك المعلوم عندهم قادر 
ms468	 على البعث فيؤمنون وفي قراءة بالتاء(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P585(@)(@@) {وما علمناه} أي النبي {الشعر} رد لقولهم إن ما أتى به من القرآن شعر {وما ينبغي} يسهل {له} الشعر {إن هو} ليس الذي أتى به {إلا ذكر} عظة {وقرآن مبين} مظهر للأحكام وغيرها(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P585(@)(@@) {لينذر} بالياء والتاء به {من كان حيا} يعقل ما يخاطب به وهم المؤمنون {ويحق القول} بالعذاب {على الكافرين} وهم كالميتين لا يعقلون ما يخاطبون به(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P585(@)(@@) {أو لم يروا} يعلموا والاستفهام للتقرير والواو الداخلة عليها للعطف {أنا خلقنا لهم} في جملة الناس {مما عملت أيدينا} عملناه بلا شريك ولا معين {أنعاما} هي الإبل والبقر والغنم {فهم لها مالكون} ضابطون(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P585(@)(@@) {وذللناها} سخرناها {لهم فمنها ركوبهم} مركوبهم {ومنها يأكلون(@)(@@) PageV01P585(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {ولهم فيها منافع} كأصوافها وأوبارها وأشعارها {ومشارب} من لبنها جمع مشرب بمعنى شرب أو موضعه {أفلا يشكرون} المنعم عليهم بها فيؤمنون أي ما فعلوا ذلك(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {واتخذوا من دون الله} أي غيره {آلهة} أصناما يعبدونها {لعلهم ينصرون} يمنعون من عذاب الله تعالى بشفاعة آلهتهم بزعمهم(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {لا يستطيعون} أي آلهتهم نزلوا منزلة العقلاء {نصرهم وهم} أي آلهتهم من الأصنام {لهم جند} بزعمهم نصرهم {محضرون} في النار معهم(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {فلا يحزنك قولهم} لك لست مرسلا وغير ذلك {إنا نعلم ما يسرون وما يعلنون} من ذلك وغيره فنجازيهم عليه(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {أو لم ير الإنسان} يعلم وهو العاصي بن وائل {أنا خلقناه من نطفة} مني إلى أن صيرناه شديدا قويا {فإذا هو خصيم} شديد الخصومة لنا {مبين} بينها في نفي البعث(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {وضرب لنا مثلا} في ذلك {ونسي خلقه} من المني وهو أغرب من مثله {قال من يحيي العظام وهي رميم} أي بالية ولم يقل رميمة بالتاء لأنه اسم لا صفة وروي أنه أخذ عظما رميما ففتته وقال للنبي صلى الله عليه وسلم أترى يحيي الله هذا بعد ما بلي ورم فقال صلى الله عليه وسلم نعم ويدخلك النار(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P586(@)(@@) {قل يحييها الذي أنشأها أول مرة وهو بكل خلق} مخلوق {عليم} مجملا ومفصلا 
ms469	 قبل خلقه وبعد خلقه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P586(@)(@@) {الذي جعل لكم} في جملة الناس {من الشجر الأخضر} المرخ والعفار أو كل شجر إلا العناب {نارا فإذا أنتم منه توقدون} تقدحون وهذا دال على القدرة على البعث فإنه جمع فيه بين الماء والنار والخشب فلا الماء يطفيء النار ولا النار تحرق الخشب(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P586(@)(@@) {أو ليس الذي خلق السماوات والأرض} مع عظمهما {بقادر على أن يخلق مثلهم} أي الأناسي في الصغر {بلى} أي هو قادر على ذلك أجاب نفسه {وهو الخلاق} الكثير الخلق {العليم} بكل شيء(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P586(@)(@@) {إنما أمره} شأنه {إذا أراد شيئا} أي خلق شيء {أن يقول له كن فيكون} أي فهو يكون وفي قراءة بالنصب عطفا على يقول(@)(@@) PageV01P586(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P587(@)(@@) {فسبحان الذي بيده ملكوت} ملك زيدت الواو والتاء للمبالغة أي القدرة على {كل شيء وإليه ترجعون} تردون في الآخرة = 37 سورة(@)(@@)(@@)(@@) | الصافات(@)(@@) مكية وآياتها 182 نزلت بعد الأنعام بسم الله الرحمن الرحيم(@)(@@) PageV01P587(@)(@@) {و(@)(@@)(@@)(@@) | الصافات (@)(@@) صفا} الملائكة تصف نفوسها في العبادة أو أجنحتها في الهواء تنتظر ما تؤمر به(@)(@@) PageV01P587(@)(@@) {فالزاجرات زجرا} الملائكة تزجر السحاب أي تسوقه(@)(@@) PageV01P587(@)(@@) {فالتاليات} أي قراء القرآن يتلونه {ذكرا} مصدر من معنى التاليات(@)(@@) PageV01P587(@)(@@) {إن إلهكم} يا أهل مكة {لواحد}(@)(@@) PageV01P587(@)(@@) {رب السماوات والأرض وما بينهما ورب المشارق} أي والمغارب للشمس ولها كل يوم مشرق ومغرب(@)(@@) PageV01P587(@)(@@) {إنا زينا السماء الدنيا بزينة الكواكب} أي بضوئها أو بها والإضافة للبيان كقراءة تنوين زينة المبينة بالكواكب(@)(@@) PageV01P587(@)(@@) {وحفظا} منصوب بفعل مقدر أي حفظناها بالشهب {من كل} متعلق بالمقدر {شيطان مارد} عات خارج عن الطاعة(@)(@@) PageV01P587(@)(@@) {لا يسمعون} أي الشياطين مستأنف وسماعهم هو في المعنى المحفوظ عنه {إلى الملإ الأعلى} الملائكة في السماء وعدي السماع بإلى لتضمنه معنى الإصغاء وفي قراءة بتشديد الميم والسين أصله يتسمعون أدغمت التاء في السين {ويقذفون} أي الشياطين بالشهب {من كل جانب} من آفاق السماء(@)(@@) PageV01P587(@)(@@) {دحورا} مصدر دحره أي طرده وأبعده وهو مفعول له {ولهم} في الآخرة {عذاب واصب} دائم(@)(@@) PageV01P587(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {إلا من خطف الخطفة} مصدر أي المرة والاستثناء من ضمير يسمعون أي لا يسمع 
ms470	 إلا الشيطان الذي سمع الكلمة من الملائكة فأخذها بسرعة {فأتبعه شهاب} كوكب مضيء {ثاقب} يثقبه أو يحرقه أو يخبله(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {فاستفتهم} استخبر كفار مكة تقريرا أو توبيخا {أهم أشد خلقا أم من خلقنا} من الملائكة والسماوات والأرضين وما فيهما وفي الإتيان بمن تغليب العقلاء {إنا خلقناهم} أي أصلهم آدم {من طين لازب} لازم يلصق باليد المعنى أن خلقهم ضعيف فلا يتكبروا بإنكار النبي والقرآن المؤدي إلى هلاكهم اليسير(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {بل} للانتقال من غرض إلى آخر وهو الإخبار بحاله وحالهم {عجبت} بفتح التاء خطابا للنبي صلى الله عليه وسلم أي من تكذيبهم إياك {و} هم {يسخرون} من تعجبك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {وإذا ذكروا} وعظوا بالقرآن {لا يذكرون} لا يتعظون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {وإذا رأوا آية} كانشقاق القمر {يستسخرون} يستهزءون بها(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {وقالوا} فيها {إن} ما {هذا إلا سحر مبين} بين وقالوا منكرين للبعث(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {أئذا متنا وكنا ترابا وعظاما أئنا لمبعوثون} في الهمزتين في الموضعين التحقيق وتسهيل الثانية وإدخال ألف بينهما على الوجهين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {أو آباؤنا الأولون} بسكون الواو عطفا بأو وبفتحها والهمزة للاستفهام والعطف بالواو والمعطوف عليه محل إن واسمها أو الضمير في لمبعوثون والفاصل همزة الاستفهام(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {قل نعم} تبعثون {وأنتم داخرون} أي صاغرون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P588(@)(@@) {فإنما هي} ضمير مبهم يفسره {زجرة} أي صيحة {واحدة فإذا هم} أي الخلائق أحياء {ينظرون} ما يفعل بهم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P588(@)(@@) {وقالوا} أي الكفار {يا} للتنبيه {ويلنا} هلاكنا وهو مصدر لا فعل له من لفظه وتقول لهم الملائكة {هذا يوم الدين} يوم الحساب والجزاء(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P588(@)(@@) {هذا يوم الفصل} بين الخلائق {الذي كنتم به تكذبون} ويقال للملائكة(@)(@@) PageV01P588(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {احشروا الذين ظلموا} أنفسهم بالشرك {وأزواجهم} قرناءهم من الشياطين {وما كانوا يعبدون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {من دون الله} أي غيره من الأوثان {فاهدوهم} دلوهم وسوقوهم {إلى صراط الجحيم} طريق النار(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {وقفوهم} احبسوهم عند الصراط {إنهم مسئولون} عن جميع أقوالهم وأفعالهم ويقال لهم توبيخا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {ما لكم لا تناصرون} لا ينصر بعضكم بعضا كحالكم في الدنيا ويقال لهم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {بل هم اليوم مستسلمون} منقادون أذلاء 
ms471	(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {وأقبل بعضهم على بعض يتساءلون} يتلاومون ويتخاصمون(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {قالوا} أي الأتباع منهم للمتبوعين {إنكم كنتم تأتوننا عن اليمين} عن الجهة التي كنا نأمنكم منها لحلفكم أنكم على الحق فصدقناكم واتبعناكم المعنى أنكم أضللتمونا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P589(@)(@@) {قالوا} أي المتبعون لهم {بل لم تكونوا مؤمنين} وإنما يصدق الإضلال منا أن لو كنتم مؤمنين فرجعتم عن الإيمان إلينا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {وما كان لنا عليكم من سلطان} قوة وقدرة تقهركم على متابعتنا {بل كنتم قوما طاغين} ضالين مثلنا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {فحق} وجب {علينا} جميعا {قول ربنا} بالعذاب أي قوله {لأملأن جهنم من الجنة والناس أجمعين} {إنا} جميعا {لذائقون} العذاب بذلك القول ونشأ عنه قولهم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {فأغويناكم} المعلل بقولهم {إنا كنا غاوين}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) قال تعالى {فإنهم يومئذ} يوم القيامة {في العذاب مشتركون} أي لاشتراكهم في الغواية(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {إنا كذلك} كما نفعل بهؤلاء {نفعل بالمجرمين} غير هؤلاء أي نعذبهم التابع منهم والمتبوع(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {إنهم} أي هؤلاء بقرينة ما بعده {كانوا إذا قيل لهم لا إله إلا الله يستكبرون}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) {ويقولون أئنا} في همزتيه ما تقدم {لتاركوا آلهتنا لشاعر مجنون} أي لأجل محمد(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P589(@)(@@) قال تعالى {بل جاء بالحق وصدق المرسلين} الجائين به وهو أن لا إله إلا الله(@)(@@) PageV01P589(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P590(@)(@@) {إنكم} فيه التفات {لذائقوا العذاب الأليم}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P590(@)(@@) {وما تجزون إلا} جزاء {ما كنتم تعملون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {إلا عباد الله المخلصين} أي المؤمنين استثناء منقطع أي ذكر جزاؤهم في قوله(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {أولئك لهم} في الجنة {رزق معلوم} بكرة وعشيا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {فواكه} بدل أو بيان للرزق وهو ما يؤكل تلذذا لا لحفظ صحة لأن أهل الجنة مستغنون عن حفظها بخلق أجسامهم للأبد {وهم مكرمون} بثواب الله سبحانه وتعالى(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {في جنات النعيم}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {على سرر متقابلين} لا يرى بعضهم قفا بعض(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {يطاف عليهم} على كل منهم {بكأس} هو الإناء بشرابه {من معين} من خمر يجري على وجه الأرض كأنهار الماء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {بيضاء} أشد بياضا من اللبن {لذة} لذيذة {للشاربين} بخلاف خمر الدنيا فإنها كريهة عند الشرب(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {لا فيها غول} ما 
ms472	 يغتال عقولهم {ولا هم عنها ينزفون} بفتح الزاي وكسرها من نزف الشارب وأنزف أي يسكرون بخلاف خمر الدنيا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {وعندهم قاصرات الطرف} حابسات الأعين على أزواجهن لا ينظرن إلى غيرهم لحسنهم عندهن {عين} ضخام الأعين حسانها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P590(@)(@@) {كأنهن} في اللون {بيض} للنعام {مكنون} مستور بريشه لا يصل إليه غبار ولونه وهو البياض في صفرة أحسن ألوان النساء(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P590(@)(@@) {فأقبل بعضهم} بعض أهل الجنة {على بعض يتساءلون} عما مر بهم في الدنيا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P590(@)(@@) {قال قائل منهم إني كان لي قرين} صاحب ينكر البعث(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P590(@)(@@) {يقول} لي تبكيتا {أئنك لمن المصدقين} بالبعث(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P590(@)(@@) {أئذا متنا وكنا ترابا وعظاما أئنا} في الهمزتين في الثلاثة مواضع ما تقدم {لمدينون} مجزيون ومحاسبون أنكر ذلك أيضا(@)(@@) PageV01P590(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {قال} ذلك القائل لإخوانه {هل أنتم مطلعون} معي إلى النار لننظر حاله فيقولون لا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {فاطلع} ذلك القائل من بعض كوى الجنة {فرآه} أي رأى قرينه {في سواء الجحيم} في وسط النار(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {قال} له تشميتا {تالله إن} مخففة من الثقيلة {كدت} قاربت {لتردين} لتهلكني بإغوائك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {ولولا نعمة ربي} علي بالإيمان {لكنت من المحضرين} معك في النار وتقول أهل الجنة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {أفما نحن بميتين}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P591(@)(@@) {إلا موتتنا الأولى} أي التي في الدنيا {وما نحن بمعذبين} هو استفهام تلذذ وتحدث بنعمة الله تعالى من تأبيد الحياة وعدم التعذيب(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {إن هذا} الذي ذكرت لأهل الجنة {لهو الفوز العظيم}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {لمثل هذا فليعمل العاملون} قيل يقال لهم ذلك وقيل هم يقولونه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {أذلك} المذكور لهم {خير نزلا} وهو ما يعد للنازل من ضيف وغيره {أم شجرة الزقوم} المعدة لأهل النار وهي من أخبث الشجر المر بتهامة ينبتها الله في الجحيم كما سيأتي(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {إنا جعلناها} بذلك {فتنة للظالمين} أي الكافرين من أهل مكة إذ قالوا النار تحرق الشجر فكيف تنبته(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {إنها شجرة تخرج في أصل الجحيم} أي قعر جهنم وأغصانها ترتفع إلى دركاتها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {طلعها} المشبه بطلع النخل {كأنه رؤوس الشياطين} الحيات القبيحة المنظر(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {فإنهم} أي الكفار {لآكلون 
ms473	 منها} مع قبحها لشدة جوعهم {فمالئون منها البطون}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {ثم إن لهم عليها لشوبا من حميم} أي ماء حار يشربونه فيختلط بالمأكول منها فيصير شوبا له(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {ثم إن مرجعهم لإلى الجحيم} يفيد أنهم يخرجون منها لشرب الحميم وأنه خارجها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P591(@)(@@) {إنهم ألفوا} وجدوا {آباءهم ضالين}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P591(@)(@@) {فهم على آثارهم يهرعون} يزعجون إلى اتباعهم فيسرعون إليه(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P591(@)(@@) {ولقد ضل قبلهم أكثر الأولين} من الأمم الماضية(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P591(@)(@@) {ولقد أرسلنا فيهم منذرين} من الرسل مخوفين(@)(@@) PageV01P591(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {فانظر كيف كان عاقبة المنذرين} الكافرين أي عاقبتهم العذاب(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {إلا عباد الله المخلصين} أي المؤمنين فإنهم نجوا من العذاب لإخلاصهم في العبادة أو لأن الله أخلصهم لها على قراءة فتح اللام(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {ولقد نادانا نوح} بقوله رب إني مغلوب فانتصر {فلنعم المجيبون} له نحن أي دعانا على قومه فأهلكناهم بالغرق(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {ونجيناه وأهله من الكرب العظيم} أي الغرق(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {وجعلنا ذريته هم الباقين} فالناس كلهم من نسله عليه السلام وكان له ثلاثة أولاد سام وهو أبو العرب والفرس والروم وحام وهو أبو السودان ويافث وهو أبو الترك والخزر ويأجوج ومأجوج وما هنالك(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {وتركنا} أبقينا {عليه} ثناء حسنا {في الآخرين} من الأنبياء والأمم إلى يوم القيامة(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P592(@)(@@) {سلام} منا {على نوح في العالمين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {إنا كذلك} كما جزيناهم {نجزي المحسنين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {إنه من عبادنا المؤمنين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {ثم أغرقنا الآخرين} كفار قومه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {وإن من شيعته} أي ممن تابعه في أصل الدين {لإبراهيم} وإن طال الزمان بينهما وهو ألفان وستمائة وأربعون سنة وكان بينهما هود وصالح(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {إذ جاء ربه} أي تابعه وقت مجيئه {بقلب سليم} من الشك وغيره(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {إذ قال} في هذه الحالة المستمرة له {لأبيه وقومه} موبخا {ماذا} ما الذي {تعبدون}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {أئفكا} في همزتيه ما تقدم {آلهة دون الله تريدون} وإفكا مفعول له وآلهة مفعول به لتريدون والإفك أسوأ الكذب أي أتعبدون غير الله(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P592(@)(@@) {فما ظنكم برب العالمين} إذ عبدتم غيره أنه يترككم بلا عقاب لا وكانوا نجامين فخرجوا إلى عيد 
ms474	 لهم وتركوا طعامهم عند أصنامهم زعموا التبرك عليه فإذا رجعوا أكلوه وقالوا للسيد إبراهيم اخرج معنا(@)(@@) PageV01P592(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P593(@)(@@) {فنظر نظرة في النجوم} إيهاما لهم أنه يعتمد عليها ليعتمدوه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P593(@)(@@) {فقال إني سقيم} عليل أي سأسقم(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {فتولوا عنه} إلى عيدهم {مدبرين}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {فراغ} مال في خفية {إلى آلهتهم} وهي الأصنام وعندها الطعام {فقال} استهزاء {ألا تأكلون} فلم ينطقوا(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) فقال {ما لكم لا تنطقون} فلم يجب(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {فراغ عليهم ضربا باليمين بالقوة فكسرها فبلغ قومه ممن رآه(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {فأقبلوا إليه يزفون} أي يسرعون المشي فقالوا له نحن نعبدها وأنت تكسرها(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {قال} لهم موبخا {أتعبدون ما تنحتون} من الحجارة وغيرها أصناما(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {والله خلقكم وما تعملون} من نحتكم ومنحوتكم فاعبدوه وحده وما مصدرية وقيل موصولة وقيل موصوفة(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {قالوا} بينهم {ابنوا له بنيانا} فاملأوه حطبا وأضرموه بالنار فإذا التهب {فألقوه في الجحيم} النار الشديدة(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {فأرادوا به كيدا} بإلقائه في النار لتهلكه {فجعلناهم الأسفلين} المقهورين فخرج من النار سالما(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P593(@)(@@) {وقال إني ذاهب إلى ربي} مهاجر إليه من دار الكفر {سيهدين} إلى حيث أمرني ربي بالمصير إليه وهو الشام فلما وصل إلى الأرض المقدسة قال(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P593(@)(@@) {رب هب لي} ولدا {من الصالحين}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P593(@)(@@) {فبشرناه بغلام حليم} أي ذي حلم كثير(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P593(@)(@@) {فلما بلغ معه السعي} أي أن يسعى معه ويعينه قيل بلغ سبع سنين وقيل ثلاث عشرة سنة {قال يا بني إني أرى} أي رأيت {في المنام أني أذبحك} ورؤيا الأنبياء حق وأفعالهم بأمر الله تعالى {فانظر ماذا ترى} من الرأي شاوره ليأنس بالذبح وينقاد للأمر به {قال يا أبت} التاء عوض عن ياء الإضافة {افعل ما تؤمر} به {ستجدني إن شاء الله من الصابرين} على ذلك(@)(@@) PageV01P593(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {فلما أسلما} خضعا وانقادا لأمر الله تعالى {وتله للجبين} صرعه عليه ولكل إنسان جبينان بينهما الجبهة وكان ذلك بمنى وأمر السكين على حلقه فلم تعمل شيئا بمانع من القدرة الإلهية(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {وناديناه أن يا إبراهيم}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {قد صدقت الرؤيا} بما أتيت به مما 
ms475	 أمكنك من أمر الذبح أي يكفيك ذلك فجملة ناديناه جواب لما بزيادة الواو {إنا كذلك} كما جزيناك {نجزي المحسنين} لأنفسهم بامتثال الأمر بإفراج الشدة عنهم(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {إن هذا} الذبح المأمور به {لهو البلاء المبين} أي الاختبار الظاهر(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {وفديناه} أي المأمور بذبحه وهو إسماعيل أو إسحاق قولان {بذبح} بكبش {عظيم} من الجنة وهو الذي قربه هابيل جاء به جبريل عليه السلام فذبحه السيد إبراهيم مكبرا(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {وتركنا} أبقينا {عليه في الآخرين} ثناء حسنا(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P594(@)(@@) {سلام} منا {على إبراهيم}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {كذلك} كما جزيناه {نجزي المحسنين} لأنفسهم(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {إنه من عبادنا المؤمنين}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {وبشرناه بإسحاق} استدل بذلك على أن الذبيح غيره {نبيا} حال مقدرة أي يوجد مقدرا نبوته {من الصالحين}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {وباركنا عليه} بتكثير ذريته {وعلى إسحاق} ولده بجعلنا أكثر الأنبياء من نسله {ومن ذريتهما محسن} مؤمن {وظالم لنفسه} كافر {مبين} بين الكفر(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {ولقد مننا على موسى وهارون} بالنبوة(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {ونجيناهما وقومهما} بني إسرائيل {من الكرب العظيم} أي استعباد فرعون إياهم(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {ونصرناهم} على القبط {فكانوا هم الغالبين}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {وآتيناهما الكتاب المستبين} البليغ البيان فيما أتى به من الحدود والأحكام وغيرها وهو التوراة(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {وهديناهما الصراط} الطريق {المستقيم}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P594(@)(@@) {وتركنا} أبقينا {عليهما في الآخرين} ثناء حسنا(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P594(@)(@@) {سلام} منا {على موسى} وهارون(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P594(@)(@@) {إنا كذلك} كما جزيناهما {نجزي المحسنين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P594(@)(@@) {إنهما من عبادنا المؤمنين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P594(@)(@@) {وإن إلياس} بالهمزة أوله وتركه {لمن المرسلين} قيل هو بن أخي هارون أخي موسى وقيل غيره أرسل إلى قوم ببعلبك ونواحيها(@)(@@) PageV01P594(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {إذ} منصوب باذكر مقدرا {قال لقومه ألا تتقون} الله(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {أتدعون بعلا} اسم صنم لهم من ذهب وبه سمي البلد أيضا مضافا إلى بك أي أتعبدونه {وتذرون} تتركون {أحسن الخالقين} فلا تعبدونه(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {الله ربكم ورب آبائكم الأولين} برفع الثلاثة على إضمار هو وبنصبها على البدل من أحسن(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {فكذبوه فإنهم لمحضرون} في النار(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {إلا عباد الله المخلصين} أي المؤمنين منهم فإنهم نجوا منها(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P595(@)(@@) {وتركنا عليه في الآخرين} ثناء حسنا(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {سلام} 
ms476	 منا {على إل ياسين} قيل هو إلياس المتقدم ذكره وقيل هو ومن آمن معه فجمعوا معه تغليبا كقولهم للمهلب وقومه المهلبون وعلى قراءة آل ياسين بالمد أي أهله المراد به إلياس أيضا(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {إنا كذلك} كما جزيناه {نجزي المحسنين}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {إنه من عبادنا المؤمنين}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {وإن لوطا لمن المرسلين}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) اذكر {إذ نجيناه وأهله أجمعين}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {إلا عجوزا في الغابرين} أي الباقين في العذاب(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {ثم دمرنا} أهلكنا {الآخرين} كفار قومه(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {وإنكم لتمرون عليهم} على آثارهم ومنازلهم في أسفاركم {مصبحين} أي وقت الصباح يعني بالنهار(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {وبالليل أفلا تعقلون} يا أهل مكة ما حل بهم فتعتبرون به(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P595(@)(@@) {وإن يونس لمن المرسلين}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P595(@)(@@) {إذ أبق} هرب {إلى الفلك المشحون} السفينة المملوءة حين غاضب قومه لما لم ينزل بهم العذاب الذي وعدهم به فركب السفينة فوقفت في لجة البحر فقال الملاحون هنا عبد أبق من سيده تظهره القرعة(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P595(@)(@@) {فساهم} قارع أهل السفينة {فكان من المدحضين} المغلوبين بالقرعة فألقوه في البحر(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P595(@)(@@) {فالتقمه الحوت} ابتلعه {وهو مليم} أي آت بما يلام عليه من ذهابه إلى البحر وركوبه السفينة بلا إذن من ربه(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P595(@)(@@) {فلولا أنه كان من المسبحين} الذاكرين بقوله كثيرا في بطن الحوت لا إله إلا أنت سبحانك إني كنت من الظالمين(@)(@@) PageV01P595(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {للبث في بطنه إلى يوم يبعثون} لصار بطن الحوت قبرا له إلى يوم القيامة(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {فنبذناه} أي ألقيناه من بطن الحوت {بالعراء} بوجه الأرض أي بالساحل من يومه أو بعد ثلاثة أو سبعة أيام أو عشرين أو أربعين يوما {وهو سقيم} عليل كالفرخ الممعط(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {وأنبتنا عليه شجرة من يقطين} وهي القرع تظله بساق على خلاف العادة في القرع معجزة له وكانت تأتيه وعلة صباحا ومساء يشرب من لبنها حتى قوي(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {وأرسلناه} بعد ذلك كقبله إلى قوم بنينوى من أرض الموصل {إلى مائة ألف أو} بل {يزيدون} عشرين أو ثلاثين أو سبعين ألفا(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {فآمنوا} عند معاينة العذاب الموعودين به {فمتعناهم} أبقيناهم ممتعين بما لهم 
ms477	 {إلى حين} تنقضي آجالهم فيه(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P596(@)(@@) {فاستفتهم} استخبر كفار مكة توبيخا لهم {ألربك البنات} بزعمهم أن الملائكة بنات الله {ولهم البنون} فيختصون بالأسنى(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {أم خلقنا الملائكة إناثا وهم شاهدون} خلقنا فيقولون ذلك(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {ألا إنهم من أفكهم} كذبهم {ليقولون}(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {ولد الله} بقولهم الملائكة بنات الله {وإنهم لكاذبون} فيه(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {أصطفى} بفتح الهمزة للاستفهام واستغني بها عن همزة الوصل فحذفت أي أختار {البنات على البنين}(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {ما لكم كيف تحكمون} هذا الحكم الفاسد(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {أفلا تذكرون} بإدغام التاء في الذال أنه سبحانه وتعالى منزه عن الولد(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {أم لكم سلطان مبين} حجة واضحة أن لله ولدا(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {فأتوا بكتابكم} التوراة فأروني ذلك فيه {إن كنتم صادقين} في قولكم ذلك(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {وجعلوا} أي المشركون {بينه} تعالى {وبين الجنة} أي الملائكة لاجتنانهم عن الأبصار {نسبا} بقولهم إنها بنات الله {ولقد علمت الجنة إنهم} أي قائلي ذلك {لمحضرون} للنار يعذبون فيها(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P596(@)(@@) {سبحان الله} تنزيها له {عما يصفون} بأن لله ولدا(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P596(@)(@@) {إلا عباد الله المخلصين} أي المؤمنين استثناء منقطع أي فإنهم ينزهون الله تعالى عما يصفه هؤلاء(@)(@@) PageV01P596(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {فإنكم وما تعبدون} من الأصنام(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {ما أنتم عليه} أي على معبودكم وعليه متعلق بقوله {بفاتنين} أي أحدا(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {إلا من هو صال الجحيم} في علم الله تعالى(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) قال جبريل للنبي صلى الله عليه وسلم {وما منا} معشر الملائكة أحد {إلا له مقام معلوم} في السماوات يعبد الله فيه لا يتجاوزه(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {وإنا لنحن الصافون} أقدامنا في الصلاة(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {وإنا لنحن المسبحون} المنزهون الله عما لا يليق به(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {وإن} مخففة من الثقيلة {كانوا} أي كفار مكة {ليقولون}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {لو أن عندنا ذكرا} كتابا {من الأولين} أي من كتب الأمم الماضية(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P597(@)(@@) {لكنا عباد الله المخلصين} العبادة له(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) قال تعالى {فكفروا به} بالكتاب الذي جاءهم وهو القرآن الأشرف من تلك الكتب {فسوف يعلمون} عاقبة كفرهم(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {ولقد سبقت كلمتنا} بالنصر {لعبادنا المرسلين} وهي لأغلبن أنا ورسلي(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) أو هي قوله {إنهم 
ms478	 لهم المنصورون}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {وإن جندنا} أي المؤمنين {لهم الغالبون} الكفار بالحجة والنصرة عليهم في الدنيا وإن لم ينتصر بعض منهم في الدنيا ففي الآخرة(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {فتول عنهم} أي أعرض عن كفار مكة {حتى حين} تؤمر فيه بقتالهم(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {وأبصرهم} إذ نزل بهم العذاب {فسوف يبصرون} عاقبة كفرهم(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {فقالوا استهزاء متى نزول هذا العذاب قال تعالى تهديدا لهم {أفبعذابنا يستعجلون}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {فإذا نزل بساحتهم} بفنائهم قال الفراء العرب تكتفي بذكر الساحة عن القوم {فساء} بئس صباحا {صباح المنذرين} فيه إقامة الظاهر مقام المضمر(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {وتول عنهم حتى حين}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P597(@)(@@) {وأبصر فسوف يبصرون} كرر تأكيدا لتهديدهم وتسلية له صلى الله عليه وسلم(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P597(@)(@@) {سبحان ربك رب العزة} الغلبة {عما يصفون} بأن له ولدا(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P597(@)(@@) {وسلام على المرسلين} المبلغين عن الله التوحيد والشرائع(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P597(@)(@@) {والحمد لله رب العالمين} على ن(@)(@@)(@@)(@@) | ص(@)(@@) رهم وهلاك الكافرين = 38 سورة ص(@)(@@) PageV01P597(@)(@@) مكية وآياتها 86 أو 88 آية نزلت بعد القمر بسم الله الرحمن الرحيم(@)(@@) PageV01P598(@)(@@)(@@)(@@) | ص(@)(@@) } الله أعلم بمراده به {والقرآن ذي الذكر} أي البيان أو الشرف وجواب هذا القسم محذوف أي ما الأمر كما قال كفار مكة من تعدد الآلهة(@)(@@) PageV01P598(@)(@@) {بل الذين كفروا} من أهل مكة {في عزة} حمية وتكبر عن الإيمان {وشقاق} خلاف وعداوة للنبي صلى الله عليه وسلم(@)(@@) PageV01P598(@)(@@) {كم} أي كثيرا {أهلكنا من قبلهم من قرن} أي أمة من الأمم الماضية {فنادوا} حين نزول العذاب بهم {ولات حين مناص} أي ليس الحين حين فرار والتاء زائدة والجملة حال من فاعل نادوا أي استغاثوا والحال أن لا مهرب ولا منجى وما اعتبر بهم كفار مكة(@)(@@) PageV01P598(@)(@@) {وعجبوا أن جاءهم منذر منهم} رسول من أنفسهم ينذرهم ويخوفهم النار بعد البعث وهو النبي صلى الله عليه وسلم {وقال الكافرون} فيه وضع الظاهر موضع المضمر {هذا ساحر كذاب}(@)(@@) PageV01P598(@)(@@) {أجعل الآلهة إلها واحدا} حيث قال لهم قولوا لا إله إلا الله أي كيف يسع الخلق كلهم إله واحد {إن هذا لشيء عجاب} أي عجيب(@)(@@) PageV01P598(@)(@@) {وانطلق الملأ منهم} من مجلس اجتماعهم 
ms479	 عند أبي طالب وسماعهم فيه من النبي صلى الله عليه وسلم قولوا لا إله إلا الله {أن امشوا} يقول بعضهم لبعض امشوا {واصبروا على آلهتكم} اثبتوا على عبادتها {إن هذا} المذكور من التوحيد {لشيء يراد} منا(@)(@@) PageV01P598(@)(@@) {ما سمعنا بهذا في الملة الآخرة} أي ملة عيسى {إن} ما {هذا إلا اختلاق} كذب(@)(@@) PageV01P598(@)(@@) {أأنزل} بتحقيق الهمزتين وتسهيل الثانية وإدخال ألف بينهما على الوجهين وتركه {عليه} على محمد {الذكر} أي القرآن {من بيننا} وليس بأكبرنا ولا أشرفنا أي لم ينزل عليه قال تعالى {بل هم في شك من ذكري} وحيي أي القرآن حيث كذبوا الجائي به {بل لما} لم {يذوقوا عذاب} ولو ذاقوه لصدقوا النبي صلى الله عليه وسلم فيما جاء به ولا ينفعهم التصديق حينئذ(@)(@@) PageV01P598(@)(@@) {أم عندهم خزائن رحمة ربك العزيز} الغالب {الوهاب} من النبوة وغيرها فيعطونها من شاءوا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {أم لهم ملك السماوات والأرض وما بينهما} إن زعموا ذلك {فليرتقوا في الأسباب} الموصلة إلى السماء فيأتوا بالوحي فيخصوا به من شاءوا وأم في الموضعين بمعنى همزة الإنكار(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {جند ما} أي هم جند حقير {هنالك} في تكذيبهم لك {مهزوم} صفة جند {من الأحزاب} صفة جند أيضا أي كالأجناد من جنس الأحزاب المتحزبين على الأنبياء قبلك وأولئك قد قهروا وأهلكوا فكذا نهلك هؤلاء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {كذبت قبلهم قوم نوح} تأنيث قوم باعتبار المعنى {وعاد وفرعون ذو الأوتاد} كان يتد لكل من يغضب عليه أربعة أوتاد يشد إليها يديه ورجليه ويعذبه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {وثمود وقوم لوط وأصحاب الأيكة} أي الغيضة وهم قوم شعيب عليه السلام {أولئك الأحزاب}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {إن} ما {كل} من الأحزاب {إلا كذب الرسل} لأنهم إذا كذبوا واحدا منهم فقد كذبوا جميعهم لأن دعوتهم واحدة وهي دعوة التوحيد {فحق} وجب {عقاب}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {وما ينظر} ينتظر {هؤلاء} أي كفار مكة {إلا صيحة واحدة} هي نفخة القيامة تحل بهم العذاب {ما لها من فواق} بفتح الفاء وضمها رجوع(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) {وقالوا} لما نزل {فأما من أوتي كتابه بيمينه} إلخ {ربنا عجل لنا قطنا} أي كتاب أعمالنا 
ms480	 {قبل يوم الحساب} قالوا ذلك استهزاء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P599(@)(@@) قال تعالى} اصبر على ما يقولون واذكر عبدنا داود ذا الأيد} أي القوة في العبادة كان يصوم يوما ويفطر يوما ويقوم نصف الليل وينام ثلثه ويقوم سدسه {إنه أواب} رجاع إلى مرضاة الله(@)(@@) PageV01P599(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P600(@)(@@) {إنا سخرنا الجبال معه يسبحن} بتسبيحه {بالعشي} وقت صلاة العشاء {والإشراق} وقت صلاة الضحى وهو أن تشرق الشمس ويتناهى ضوءها(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P600(@)(@@) {و} سخرنا {الطير محشورة} مجموعة إليه تسبح معه {كل} من الجبال والطير {له أواب} رجاع إلى طاعته بالتسبيح(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P600(@)(@@) {وشددنا ملكه} قويناه بالحرس والجنود وكان يحرس محرابه في كل ليلة ثلاثون ألف رجل {وآتيناه الحكمة} النبوة والإصابة في الأمور {وفصل الخطاب} البيان الشافي في كل قصد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P600(@)(@@) {وهل} معنى الاستفهام هنا التعجيب والتشويق إلى استماع ما بعده {أتاك} يا محمد {نبأ الخصم إذ تسوروا المحراب} محراب داود أي مسجده حيث منعوا الدخول عليه من الباب لشغله بالعبادة أي خبرهم وقصتهم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P600(@)(@@) {إذ دخلوا على داود ففزع منهم قالوا لا تخف} نحن {خصمان} قيل فريقان ليطابق ما قبله من ضمير الجمع وقيل اثنان والضمير بمعناهما والخصم يطلق على الواحد وأكثر وهما ملكان جاءا في صورة خصمين وقع لهما ما ذكر هنا على سبيل الفرض لتنبيه داود عليه السلام على ما وقع منه وكان له تسع وتسعون امرأة وطلب امرأة شخص ليس له غيرها وتزوجها ودخل بها {بغى بعضنا على بعض فاحكم بيننا بالحق ولا تشطط} تجر {واهدنا} أرشدنا {إلى سواء الصراط} وسط الطريق الصواب(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P600(@)(@@) {إن هذا أخي} أي على ديني {له تسع وتسعون نعجة} يعبر بها عن المرأة {ولي نعجة واحدة فقال أكفلنيها} أي اجعلني كافلها {وعزني} غلبني {في الخطاب} أي الجدال وأقره الآخر على ذلك(@)(@@) PageV01P600(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P601(@)(@@) {قال لقد ظلمك بسؤال نعجتك} ليضمها {إلى نعاجه وإن كثيرا من الخلطاء} الشركاء {ليبغي بعضهم على بعض إلا الذين آمنوا وعملوا الصالحات وقليل ما هم} ما لتأكيد القلة فقال الملكان صاعدين في صورتيهما إلى السماء قضى الرجل على نفسه فتنبه داود 