ms81	 هماره باکفی چون ابر %~% خورشید صفت بتابدت سیما(@)(@@) 54 چون باد قلم دود در انگشتم %~% گر مدح تکاورت‌کنم املا(@)(@@) 55 چون برق‌کشد ضمیر من شعله %~% گر وصف بلارکت‌کنم انشا(@)(@@) 56 گر خشم‌کنی به چشمه خورشید %~% چون شب‌پره زو حذرکند حربا(@)(@@) 57 ور چشم زنی به جانب ناهید %~% سوی تو چمد زگنبد خضرا(@)(@@) 58 اخلاق تو آبگینه یارد ساخت %~% از نرم دلی ز صخره صما(@)(@@) 59 گرد سپهت به چشم بدخواهان %~% یک بادیه افعی است و اژدرها(@)(@@) 60 شخص تو جهان پیر برناکرد %~% از دانش پیرو طالع برنا(@)(@@) 61 رخسار تو آیینه است و خصمت دیو %~% زان در تو چو بنگرد شود رسوا(@)(@@) 62 تا لمعه و نور خیزد از خورشید %~% تا فتنه و شور زاید از صهبا(@)(@@) 63 دارم دو هزار شکوه از طالع %~% لیک آن دو هزار شکوه باشد تا PageV1P088(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوشینه چون‌کشید شه زنگ لشکرا %~% سلطان روم را ز سر افتاد افسرا(@)(@@) 2 باز سفید روز بپرید از آشیان %~% زاغ شب سیاه بگسترد شهپرا(@)(@@) 3 تاریک شد سپهر چو ظلمات وندرو %~% تا زان ستاره چون به سیاهی سکندرا(@)(@@) 4 چونان شبی درازکه پنداشتی قضا %~% یکره بریده نافش با روز محشرا(@)(@@) 5 افروخت چهره زین تل خاکستری سهیل %~% چون از درون توده خاکستر اخگرا(@)(@@) 6 گفتی فرشته است به بالای اهرمن %~% روشن فلک فراز هوای مکدرا(@)(@@) 7 گردون پرستاره برآن قیرگون هوا %~% چون بر سر نجاشی اکلیل قیصرا(@)(@@) 8 یاگفتئی به‌کین تهمتن به سر نهاد %~% پولادوند دیو زراندود مغفرا(@)(@@) 9 وز اختران معاینه دیدم‌کنار چرخ %~% زانگونه‌کز قراضه زر نطع زرگرا(@)(@@) 10 مرغ هوا و ماهی دریا به خواب و من %~% بیدار و چشم دوخته در چشم اخترا(@)(@@) 11 کز در صدای سندان برخاست‌کانچنانک %~% پنداشتی ز چرخ بغرید تندرا(@)(@@) 12 گفتم هلاکیی‌‌که به در حلقه می‌زنی %~% گفتا نگارگفتم بخ بخ درا درا(@)(@@) 13 برجستم و دویدم و در راگشود و بست %~% کردم سلام و تنگ‌کشیدمش دربرا(@)(@@) 14 بوییدمش 
ms82	 دمادم موی مجعدا %~% بوسیدمش پیاپی قند مکررا(@)(@@) 15 هر غمزه‌اش به جانم صد جعبه ناوکا %~% هر مژه‌اش به چشمم صد قبضه خنجرا(@)(@@) 16 از فرق تا قدم همه خان مجسما %~% وز پای تا به سر همه روح مصورا(@)(@@) 17 بر چشم اشکبارم مالید زلف خویش %~% وین قصه راست شدکه به بحر است عنبرا(@)(@@) 18 بر روی زرد من لب شیرین به عشوه سود %~% وین حرف شد یقین‌که به نی هست شکرا(@)(@@) 19 بنشاندمش به مجلس و از زلفکان او %~% از بهر خویش‌کردم بالین و بسترا(@)(@@) 20 بی‌شمع و بی‌چراغ ز روی منورش %~% شد همچو روز روشن بزمم منورا(@)(@@) 21 آری چراغ و شمع نباید به حکم عقل %~% چون چهره برفروزد خورشید خاورا(@)(@@) 22 گفتم بهل‌که عود به مجمر در افکنم %~% شکرانه قدوم تو ترک سمنبرا(@)(@@) 23 گفتا به‌عود و مجمر حالی چه حاجتست %~% با زلف و چهر من چه‌کنی عود و مجمرا(@)(@@) 24 ماگرم‌گفتگوکه برآمد ز آسمان %~% ابری سیاه تیره‌تر از جان‌کافرا(@)(@@) 25 گفتی‌که دزد مخزن شاه است از آن قبل %~% کش بود آستین همه پر در وگوهرا(@)(@@) 26 هر در وگوهری‌که فروریخت در زمان %~% شد همچوگنج قارون در خاک مضمرا(@)(@@) 27 جادوست‌گفتئی‌که به نیرنگ و جادویی %~% کرد از بخار خشک روان لؤلؤ ترا(@)(@@) 28 چون بختیان مست‌که‌کف برلب آورند %~% توفید و ریخت‌کف ز دهانش‌ بر اغبرا(@)(@@) 29 گو بنگرش نشیب سپهر ار ندیده‌کس %~% در قلزمی معلق دیوی شناورا(@)(@@) 30 سیلی ز هرکرانه روان شدکه هیچ‌کس %~% نارست بی‌سفینه‌گذشتن به معبرا(@)(@@) 31 گفتم‌کنون چه بایدگفتا شراب ناب %~% زان می‌که‌چون سهیل درخشد به ساغرا(@)(@@) 32 آوردمش به پیش شرابی‌که‌گفتئی %~% جان راگرفته‌اند به تدبیر جوهرا(@)(@@) 33 زان می‌که‌گر برابر آبستنی نهند %~% بینند روی بچه ز زهدان مادرا(@)(@@) 34 چشم خروس ریختم از نای بلبله %~% وز حلق بط فشاندم خون‌کبوترا(@)(@@) 35 او مست جام می‌شد و من مست چشم او %~% یاللعجب‌که مستی من بدفزون ترا(@)(@@) 36 آری شراب را بود ار صد هزار شور 
ms83	 %~% با شور عشق یار نباشد برابرا(@)(@@) 37 باری ز هرکران سخنی رفت در میان %~% زان سان‌که هست رسم حریفان همسرا(@)(@@) 38 تا رفته رفته پرسشی از حال من نمود %~% هم زان قبل‌که مهتری از حال‌کهترا(@)(@@) 39 گفتا چه‌می‌کنی و چسانی و حال چیست %~% مسکینی از جفای جهان با توانگرا(@)(@@) 40 گفتم میان فقر و غنایم وزین قبل %~% خنثاست بخت‌من‌که نه ماده است و نه نرا(@)(@@) 41 نفسم صبور و قلب شکور است لاجرم %~% خشنودم از زمانه برزق مقدرا(@)(@@) 42 لیکن به حکم آن‌که ضرور است اکتساب %~% آهنگ پای‌بوس ملک دارم ایدرا(@)(@@) 43 گفتا به فصل دی‌که سخن بفسرد به‌کام %~% گویی سفرکنم نکنم هیچ باورا(@)(@@) 44 حاشاکه وحی صادق دانم حدیث تو %~% نه خود تو جبرئیلی و نه من پیمبرا(@)(@@) 45 فصلی چنین‌که‌گویی از برف‌کوهسار %~% ز استبرق سفید به سرکرده چادرا(@)(@@) 46 فصلی چنین‌که‌گویی‌کردند تعبیه %~% تأثیر پشت سوهان در طبع صرصرا(@)(@@) 47 بالله اگر نگاه برون آید از دو چشم %~% چون سنگ بفسرد به میان ره اندرا(@)(@@) 48 گفتم ز شوق درگه دارای روزگار %~% نهراسم از نسیم دی و باد آذرا(@)(@@) 49 گیرم جهنده باد بود نیش ناچخا %~% گیرم فسرده آب بود نوک نشترا(@)(@@) 50 ایدون به پشت‌گرمی الطاف‌کردگار %~% در یخ چنان روم‌که در آتش سمندرا(@)(@@) 51 گفتا ز مال و حال چه داری بسیج راه %~% گفتم هلا بنقد دو اسب تکاورا(@)(@@) 52 یک اسب بنده نیز به لار است و دزد پار %~% بر دست وکس درین ستمم نیست یاورا(@)(@@) 53 گفتا جز این دو هیچ ضرور است‌گفتمش %~% یک مشت زر دو اسب تکاور یک استرا(@)(@@) 54 ارباب جاه نقدی اگر وام من دهند %~% اسباب راه یکسره‌گردد میسرا(@)(@@) 55 گفتا به قرض‌کس ندهد یک قراضه زر %~% بس تجربت‌که رفته درین باب مرمرا(@)(@@) 56 اکنو منت رهی بنمایم به حکم عقل %~% لیکن به شرط آنکه شود بخت یاورا(@)(@@) 57 گر خدمتی امیر بفرمایدت بری %~% در نزد اولیای خدیو مظفرا(@)(@@) 58 فرض‌افتدش‌که‌هرچه توخواهی 
ms84	 ببخشدت %~% از شوق خدمت ملک ملک پرورا(@)(@@) 59 گفتم مرا به خدمت میر بزرگوار %~% ایدون وسیله باید راوی سخنورا(@)(@@) 60 گفتاکه بهتر از اسدالله خان‌که هست %~% درگوش میرگفتش چون سکه برزرا(@)(@@) 61 خانی‌که‌صیت‌جود وسخایش به‌شرق‌وغرب %~% ساریست چون فروغ مه و مر انورا(@)(@@) 62 در زورقی‌که دم زنی از حزم و عزم او %~% او‌کار بادبان‌کند این‌کار لنگرا(@)(@@) 63 وصف حلاوت سخنش چون رقم‌کنی %~% نبود عجب‌که خامه بچسبد به دفترا(@)(@@) 64 از شش جهت‌گریخت نیارد عدوی او %~% مانند مهره‌یی‌که درافتد به ششدرا(@)(@@) 65 مانا شکافت زهره چرخ از عتاب او %~% ورنه سبب‌کدام‌که چرخ است اخضرا(@)(@@) 66 محروم باد حاسد او از لقای او %~% زیراکزین بتر نتوان یافت‌کیفرا(@)(@@) 67 صدرا امیر دیوان دانم‌که با تواش %~% صدقیست بینهایت و مهریست بیمرا(@)(@@) 68 تنها نه با جناب تو از فرط اتحاد %~% چون یک روان پاک بود در دو پیکرا(@)(@@) 69 با خلق روزگار چنان مهربان بود %~% کاورا دعاکنند به محراب و منبرا(@)(@@) 70 دانی تو بلکه شهری لابلکه عالمی %~% کاری‌که او نمود درین مرز و‌کشورا(@)(@@) 71 ملکی‌گشود و مملکتی را نمود امن %~% بی‌زحمت سیاست و بی‌رنج لشکرا(@)(@@) 72 چو‌ن‌موسی‌کلیم به‌یک چوب‌دست‌کرد %~% ملکی ز ملک مصر فزون‌تر مسخرا(@)(@@) 73 ماران فتنه خورد بیکره عصای او %~% ناگشته چون عصای کلیم‌الله اژدرا(@)(@@) 74 نازل ز آسمان شود اسما از آن بود %~% نامش نبی‌که هست نبی‌سان به‌گوهرا(@)(@@) 75 آزادکرده‌کرم اوست هرکه هست %~% چه طفل شیرخوار و چه شیخ معمرا(@)(@@) 76 با عدل او عجب نه‌که زالی چو آفتاب %~% با طشت زر به باختر آید ز خاورا(@)(@@) 77 اندر سه مه ذخیره سی ساله خرج‌کرد %~% از بهر نیک‌نامی شاه فلک فرا(@)(@@) 78 هرکس‌کند ذخیره زر و سیم وگنج و مال %~% او را بود ذخیره شه مهرگسترا(@)(@@) 79 ایدون‌گواه عدل وی این داستان بس است %~% کاید به‌گوش خلق حدیثی مزورا(@)(@@) 80 کامد به شهر شیراز از یک دو روزه راه %~% گم‌گشت بارگیری بارش همه زرا(@)(@@) 81 هر دزد و هر طریده‌که 
ms85	 دیدش به رهگذار %~% گشتش ز ره به خطه شیراز رهبرا(@)(@@) 82 غیر از رضای شاه‌که جوید به جان و دل %~% آید به چشم هردو جهانش محقرا(@)(@@) 83 درگفت می‌نیاید القصه آنچه‌کرد %~% او ازکمال و قدر در این بوم و این برا(@)(@@) 84 یک روز دم زنی اگر اندر حضور وی %~% در حق من شود همه‌کامم میسرا(@)(@@) 85 تا خود چه می‌شودکه من از یک‌کلام تو %~% یک عمر بر حوایج‌گردم مظفرا(@)(@@) 86 تا رسم در زمان بود ازگفته‌های نغز %~% تا نام در جهان بود ازکلک و دفترا(@)(@@) 87 بادش عدو نوان و بداندیش ناتوان %~% دولت جوان و حکم روان یار در برا(@)(@@) 88 نصرت قرین و چرخ معین فتح همنشین %~% حاسد غمین و بخت سمین خصم لاغرا PageV1P089(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عید شد ساقی بیا درگردش آور جام را %~% پشت‌پا زن دور چرخ وگردش ایام را(@)(@@) 2 سین ساغر بس بود ای ترک ما را روز عید %~% گو نباشد هفت سین رندان دردآشام را(@)(@@) 3 خلق را بر لب حدیث جامة نو هست و من %~% از شراب‌کهنه می‌خواهم لبالب جام را(@)(@@) 4 هرکسی شکر نهد بر خوان و بر خواند دعا %~% من ز لعل شکرینت طالبم دشنام را(@)(@@) 5 هر تنی را هست سیم و دانة‌گندم به دست %~% مایلم من دانة خال تو سیم اندام را(@)(@@) 6 سیر برخوانست مردم را و من از عمر سیر %~% بی‌دل آرامی‌که برده است از دلم آرام را(@)(@@) 7 پسته و بادام نقل روز نوروز است و من %~% با لب و چشمت نخواهم پسته و بادام را(@)(@@) 8 عود اندر عید می‌سوزند و من نالان چو عود %~% بی‌بتی‌کز خال هندو ره زند اسلام را(@)(@@) 9 یکدگر راخلق‌می‌بوسند ومن زین‌غم هلاک %~% گرچه بوسد دیگری آن شوخ شیرین‌کام را(@)(@@) 10 سرکه بردستارخوان‌خلق وهمچون‌سرکه دوست %~% می‌کند بر ما ترش‌ رنگین رخ‌گلفام را(@)(@@) 11 خلق را در سال روزی عید و من از چهر شاه %~% عید دارم سال و ماه 
ms86	 و هفته صبح و شام را(@)(@@) 12 لاجرم این عید خاص من‌که بادا پایدار %~% کر و فرش بشکند بازار عید عام را(@)(@@) 13 آسمان دین و دولت‌کز هلالی شکل تیغ %~% گاه‌کین بر هیأت جوزاکند بهرام را(@)(@@) 14 بانگ‌رب ارحم برآید از زمین و آسمان %~% هر زمان‌کان سام صولت برکشد صمصام را(@)(@@) 15 خصم از روی خرد با وی ندارد دشمنی %~% اقتضایی هست آخر علت سرسام را(@)(@@) 16 در دل او نیست‌کین دشمنان آری به طبع %~% آدمی در دل نگیردکینة انعام را(@)(@@) 17 کاش پیش از انعقاد نطفة اعدای تو %~% ایزد اندر نار نیران سوختی ارحام را(@)(@@) 18 هرکه باوی‌کینه‌جوید عقل‌گویدکاین سفیه %~% کین نیاغازیدی ار آگه بدی انجام را(@)(@@) 19 خصم‌بگریزد ز سهمش آری‌آری اشکبوس %~% چون‌کشدگرزگران دل بگسلد رهام را(@)(@@) 20 بدر دنیا صدر دین ای‌کاندر ایوان می‌کند %~% گفت جان بخشت مصور صورت الهام را(@)(@@) 21 باتو هرکس‌کین سگالد نیست‌هشیار ار نه‌مرد %~% تا خرد دارد نخاردگردن ضرغام را(@)(@@) 22 جاودان مانی و خوانی هر صباح روز عید %~% عید شد ساقی بیا درگردش آور جام را PageV1P090(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر تاج زر نهند ازین پس به سر مرا %~% بر درگه امیر نبینی دگر مرا(@)(@@) 2 او باز تیز پنجه و من صعوه ضعیف %~% روزی بهم فروشکند بال و پر مرا(@)(@@) 3 او آفتاب روشن و من ذره حقیر %~% با نورش از وجود نیابی اثر مرا(@)(@@) 4 اوگنج شایگان و منم آن‌گداکه هست %~% برگنج باز دیده حسرت نگر مرا(@)(@@) 5 بی‌اژدها چگونه بودگنج لاجرم %~% از بیم جان به‌گنج نیایدگذر مرا(@)(@@) 6 عزت چو در قناعت و ذلت چو در طمع %~% باید قناعت از همه‌کس بیشتر مرا(@)(@@) 7 من آن همای اوج‌کمالم‌که بد مدام %~% سیمرغ‌وار قاف قناعت مقر مرا(@)(@@) 8 یارب چه روی داده‌که باید به پیش خلق %~% موسیچه‌وار این همه دم لابه مرمرا(@)(@@) 9 هر روز روزیم چون دهد روزی آفرین %~% باید غذا ز بهر چه لخت جگر مرا(@)(@@) 10 بگذشت صیت فضل 
