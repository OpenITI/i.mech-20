ms1061	 بن غيلان قال: حدثنا أبو داود، عن شعبة، عن الأعمش، عن مجاهد، عن ابن عمر، قال: انفلق القمر على عهد رسول الله صلى الله عليه وسلم، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اشهدوا» . (@)(@@) هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٨٩ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا محمد بن كثير قال: حدثنا سليمان بن كثير، عن حصين، عن محمد بن جبير بن مطعم، عن أبيه، قال: (@)(@@) @MATN@ " انشق القمر على عهد النبي صلى الله عليه وسلم حتى صار فرقتين: على هذا الجبل، وعلى هذا الجبل، فقالوا: سحرنا محمد فقال بعضهم: لئن كان سحرنا فما يستطيع أن يسحر الناس كلهم " : وقد روى بعضهم هذا الحديث عن حصين، عن جبير بن محمد بن جبير بن مطعم، عن أبيه، عن جده جبير بن مطعم، نحوه (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٠ - (@)(@@) حدثنا أبو كريب، وأبو بكر بندار، قالا: حدثنا وكيع، عن سفيان، عن زياد بن إسماعيل، عن محمد بن عباد بن جعفر المخزومي، PageV05P398 عن أبي هريرة، قال: (@)(@@) @MATN@ " جاء مشركو قريش يخاصمون النبي صلى الله عليه وسلم في القدر فنزلت @QB@ {يوم يسحبون في النار على وجوههم ذوقوا مس سقر إنا كل شيء خلقناه بقدر} @QE@ [القمر: ٤٩] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة الرحمن (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩١ - (@)(@@) حدثنا عبد الرحمن بن واقد أبو مسلم قال: حدثنا الوليد بن مسلم، عن زهير بن محمد، عن محمد بن المنكدر، عن جابر قال: خرج رسول الله صلى الله عليه وسلم على أصحابه، فقرأ عليهم سورة الرحمن من أولها إلى آخرها فسكتوا، فقال: (@)(@@) @MATN@ " لقد قرأتها على الجن ليلة الجن فكانوا أحسن مردودا منكم، كنت كلما أتيت على قوله @QB@ {فبأي آلاء ربكما تكذبان} @QE@ [الرحمن: ١٣] قالوا: لا بشيء من نعمك ربنا نكذب فلك الحمد " : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث الوليد بن مسلم عن زهير بن محمد» (@)(@@) قال ابن حنبل: (@)(@@) @MATN@ " كأن زهير بن محمد الذي وقع بالشام ليس هو الذي يروى عنه بالعراق، كأنه رجل آخر قلبوا اسمه، يعني: لما يروون عنه من المناكير " . PageV05P399 وسمعت محمد بن إسماعيل البخاري، 
ms1062	 يقول: (@)(@@) @MATN@ «أهل الشام يروون عن زهير بن محمد مناكير، وأهل العراق يروون عنه أحاديث مقاربة» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة الواقعة (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٢ - (@)(@@) حدثنا أبو كريب قال: حدثنا عبدة بن سليمان، وعبد الرحيم بن سليمان، عن محمد بن عمرو، قال: حدثنا أبو سلمة، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " يقول الله: أعددت لعبادي الصالحين ما لا عين رأت، ولا أذن سمعت، ولا خطر على قلب بشر، فاقرءوا إن شئتم: @QB@ {فلا تعلم نفس ما أخفي لهم من قرة أعين جزاء بما كانوا يعملون} @QE@ [السجدة: ١٧] وفي الجنة شجرة يسير الراكب في ظلها مائة عام لا يقطعها، واقرءوا إن شئتم، @QB@ {وظل ممدود} @QE@ [الواقعة: ٣٠] وموضع سوط في الجنة خير من الدنيا وما فيها، واقرءوا إن شئتم: @QB@ {فمن زحزح عن النار وأدخل الجنة فقد فاز وما الحياة الدنيا إلا متاع الغرور} @QE@ [آل عمران: ١٨٥] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٣ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبد الرزاق، عن معمر، عن قتادة، عن أنس، أن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ " إن في الجنة لشجرة يسير الراكب في ظلها مائة عام لا يقطعها، واقرأوا إن شئتم: @QB@ {وظل ممدود وماء مسكوب} @QE@ [الواقعة: ٣١] " : PageV05P400 (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وفي الباب عن أبي سعيد (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٤ - (@)(@@) حدثنا أبو كريب قال: حدثنا رشدين بن سعد، عن عمرو بن الحارث، عن دراج، عن أبي الهيثم، عن أبي سعيد الخدري، عن النبي صلى الله عليه وسلم في قوله: @QB@ {وفرش مرفوعة} @QE@ [الواقعة: ٣٤] قال: (@)(@@) @MATN@ «ارتفاعها كما بين السماء والأرض، ومسيرة ما بينهما خمس مائة عام» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث رشدين» (@)(@@) وقال بعض أهل العلم: معنى هذا الحديث: (@)(@@) @MATN@ «وارتفاعها كما بين السماء والأرض» (@)(@@) قال: (@)(@@) @MATN@ «ارتفاع الفرش المرفوعة في الدرجات، والدرجات ما بين كل درجتين كما بين السماء والأرض» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٥ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا الحسين بن محمد قال: حدثنا إسرائيل، عن عبد الأعلى، عن أبي عبد الرحمن، عن علي قال: قال رسول الله صلى الله عليه وسلم: @QB@ {وتجعلون رزقكم أنكم تكذبون} 
ms1063	 @QE@ [الواقعة: ٨٢] قال: (@)(@@) @MATN@ «شكركم، تقولون مطرنا بنوء كذا وكذا وبنجم كذا وكذا» : (@)(@@) PageV05P401 (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه مرفوعا إلا من حديث إسرائيل» (@)(@@) ورواه سفيان الثوري، عن عبد الأعلى، عن أبي عبد الرحمن السلمي، عن علي، نحوه ولم يرفعه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٦ - (@)(@@) حدثنا أبو عمار الحسين بن حريث الخزاعي المروزي قال: حدثنا وكيع، عن موسى بن عبيدة، عن يزيد بن أبان، عن أنس قال: قال رسول الله صلى الله عليه وسلم في قوله: @QB@ {إنا أنشأناهن إنشاء} @QE@ [الواقعة: ٣٥] قال: (@)(@@) @MATN@ «إن من المنشآت اللائي كن في الدنيا عجائز عمشا رمصا» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه مرفوعا إلا من حديث موسى بن عبيدة، وموسى بن عبيدة ويزيد بن أبان الرقاشي يضعفان في الحديث» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٧ - (@)(@@) حدثنا أبو كريب قال: حدثنا معاوية بن هشام، عن شيبان، عن أبي إسحاق، عن عكرمة، عن ابن عباس، قال: قال أبو بكر: يا رسول الله قد شبت، قال: (@)(@@) @MATN@ «شيبتني هود، والواقعة، والمرسلات، وعم يتساءلون، وإذا الشمس كورت» : (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه من حديث ابن عباس إلا من هذا الوجه» (@)(@@) وروى علي بن صالح، هذا الحديث عن أبي إسحاق، عن أبي جحيفة، نحو هذا، وقد روي عن أبي إسحاق، عن أبي ميسرة، شيء من هذا مرسلا (@)PageV05P402 (@)(@) (@)(@@) باب: ومن سورة الحديد (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٨ - (@)(@@) حدثنا عبد بن حميد، وغير واحد، والمعنى واحد، قالوا: حدثنا يونس بن محمد قال: حدثنا شيبان بن عبد الرحمن، عن قتادة، قال: حدث الحسن، عن أبي هريرة، قال: بينما نبي الله صلى الله عليه وسلم جالس وأصحابه إذ أتى عليهم سحاب، فقال نبي الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هل تدرون ما هذا؟» (@)(@@) فقالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «هذا العنان هذه روايا الأرض يسوقه الله تبارك وتعالى إلى قوم لا يشكرونه ولا يدعونه» (@)(@@) ثم قال: (@)(@@) @MATN@ «هل تدرون ما فوقكم» ؟ (@)(@@) قالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «فإنها الرقيع، سقف محفوظ، وموج مكفوف» ، (@)(@@) ثم قال: (@)(@@) @MATN@ «هل تدرون كم بينكم وبينها؟» (@)(@@) قالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «بينكم وبينها مسيرة خمس مائة سنة» . (@)(@@) ثم قال: (@)(@@) @MATN@ «هل 
ms1064	 تدرون ما فوق ذلك؟» (@)(@@) قالوا: PageV05P403 الله ورسوله أعلم. قال: (@)(@@) @MATN@ «فإن فوق ذلك سماءين، ما بينهما مسيرة خمسمائة عام» (@)(@@) حتى عد سبع سماوات، ما بين كل سماءين ما بين السماء والأرض، ثم قال: (@)(@@) @MATN@ «هل تدرون ما فوق ذلك؟» (@)(@@) قالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «فإن فوق ذلك العرش وبينه وبين السماء بعد ما بين السماءين» . (@)(@@) ثم قال: (@)(@@) @MATN@ «هل تدرون ما الذي تحتكم» ؟ (@)(@@) قالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «فإنها الأرض» . (@)(@@) ثم قال: (@)(@@) @MATN@ «هل تدرون ما الذي تحت ذلك» ؟ (@)(@@) قالوا: الله ورسوله أعلم. قال: (@)(@@) @MATN@ «فإن تحتها أرضا أخرى، بينهما مسيرة خمس مائة سنة» (@)(@@) حتى عد سبع أرضين، بين كل أرضين مسيرة خمس مائة سنة. ثم قال: (@)(@@) @MATN@ «والذي نفس محمد بيده لو أنكم دليتم بحبل إلى الأرض السفلى لهبط على الله» . (@)(@@) ثم قرأ @QB@ {هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم} @QE@ [الحديد: ٣] . هذا حديث غريب من هذا الوجه. ويروى عن أيوب، ويونس بن عبيد، وعلي بن زيد، قالوا: لم يسمع الحسن من أبي هريرة، وفسر بعض أهل العلم هذا الحديث، فقالوا: إنما هبط على علم الله وقدرته وسلطانه. علم الله وقدرته وسلطانه في كل مكان، وهو على العرش كما وصف في كتابه (@)PageV05P404 (@)(@) (@)(@@) باب: ومن سورة المجادلة (@)(@) (@)(@@)(@@)(@@) ||| ٣٢٩٩ - (@)(@@) حدثنا عبد بن حميد، والحسن بن علي الحلواني، المعنى واحد، قالا: حدثنا يزيد بن هارون قال: حدثنا محمد بن إسحاق، عن محمد بن عمرو بن عطاء، عن سليمان بن يسار، عن سلمة بن صخر الأنصاري، قال: كنت رجلا قد أوتيت من جماع النساء ما لم يؤت غيري، فلما دخل رمضان تظاهرت من امرأتي حتى ينسلخ رمضان فرقا من أن أصيب منها في ليلتي فأتتابع في ذلك إلى أن يدركني النهار وأنا لا أقدر أن أنزع، فبينما هي تخدمني ذات ليلة إذ تكشف لي منها شيء فوثبت عليها، فلما أصبحت غدوت على قومي فأخبرتهم خبري فقلت: انطلقوا معي إلى رسول الله صلى الله عليه وسلم فأخبره بأمري، فقالوا: لا والله لا نفعل، نتخوف أن ينزل فينا قرآن أو 
ms1065	 يقول فينا رسول الله صلى الله عليه وسلم مقالة يبقى علينا عارها، ولكن اذهب أنت فاصنع ما بدا لك. قال: فخرجت فأتيت رسول الله صلى الله عليه وسلم فأخبرته خبري، فقال: (@)(@@) @MATN@ «أنت بذاك؟» (@)(@@) قلت: أنا بذاك. قال: (@)(@@) @MATN@ «أنت بذاك؟» (@)(@@) قلت: أنا بذاك. PageV05P405 قال: (@)(@@) @MATN@ «أنت بذاك؟» (@)(@@) قلت: أنا بذاك، وها أنا ذا فأمض في حكم الله فإني صابر لذلك. قال: (@)(@@) @MATN@ «أعتق رقبة» . (@)(@@) قال: فضربت صفحة عنقي بيدي، فقلت: لا والذي بعثك بالحق ما أصبحت أملك غيرها. قال: (@)(@@) @MATN@ «فصم شهرين» . (@)(@@) قلت: يا رسول الله وهل أصابني ما أصابني إلا في الصيام. قال: (@)(@@) @MATN@ «فأطعم ستين مسكينا» : (@)(@@) قلت: والذي بعثك بالحق لقد بتنا ليلتنا هذه وحشى، ما لنا عشاء. قال: (@)(@@) @MATN@ «اذهب إلى صاحب صدقة بني زريق، فقل له فليدفعها إليك فأطعم عنك منها وسقا ستين مسكينا، ثم استعن بسائره عليك وعلى عيالك» (@)(@@) قال: فرجعت إلى قومي، فقلت: وجدت عندكم الضيق وسوء الرأي، ووجدت عند رسول الله صلى الله عليه وسلم السعة والبركة، أمر لي بصدقتكم فادفعوها إلي فدفعوها إلي: (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) قال محمد: (@)(@@) @MATN@ " سليمان بن يسار لم يسمع عندي من سلمة بن صخر، ويقال: سلمة بن صخر، وسلمان بن صخر " وفي الباب عن خولة بنت ثعلبة وهي امرأة أوس بن الصامت (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٠ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا يحيى بن آدم قال: حدثنا عبيد الله الأشجعي، عن سفيان الثوري، عن عثمان بن المغيرة الثقفي، عن سالم بن أبي الجعد، عن علي بن علقمة الأنماري، عن علي بن أبي طالب، قال: لما نزلت: @QB@ {يا أيها الذين آمنوا إذا ناجيتم} @QE@ [المجادلة: ١٢] الرسول فقدموا بين يدي PageV05P406 نجواكم صدقة قال لي النبي صلى الله عليه وسلم (@)(@@) @MATN@ «ما ترى؟ دينار؟» (@)(@@) قلت: لا يطيقونه، قال: (@)(@@) @MATN@ «فنصف دينار؟» ، (@)(@@) قلت: لا يطيقونه. قال: (@)(@@) @MATN@ «فكم؟» (@)(@@) قلت: شعيرة. قال: (@)(@@) @MATN@ «إنك لزهيد» . (@)(@@) قال: فنزلت @QB@ {أأشفقتم أن تقدموا بين يدي نجواكم صدقات} @QE@ [المجادلة: ١٣] الآية. قال: (@)(@@) @MATN@ «فبي خفف الله عن هذه الأمة» . (@)(@@) @MATN@ " هذا حديث حسن غريب إنما نعرفه من هذا الوجه، ومعنى قوله شعيرة: يعني وزن 
ms1066	 شعيرة من ذهب، وأبو الجعد اسمه: رافع " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠١ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا يونس، عن شيبان، عن قتادة قال: حدثنا أنس بن مالك، أن يهوديا أتى على النبي صلى الله عليه وسلم وأصحابه فقال: السام عليكم، فرد عليه القوم، فقال نبي الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هل تدرون ما قال هذا؟» (@)(@@) قالوا: الله ورسوله أعلم، سلم يا نبي الله. قال: (@)(@@) @MATN@ «لا ولكنه قال كذا وكذا، ردوه علي» ، (@)(@@) فردوه قال: (@)(@@) @MATN@ " قلت: السام عليكم؟ " قال: نعم. قال نبي الله صلى الله عليه وسلم عند ذلك: (@)(@@) @MATN@ " إذا سلم عليكم أحد من أهل الكتاب فقولوا: عليك ما قلت " ، قال: @QB@ {وإذا جاءوك حيوك بما لم يحيك به الله} : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P407 (@)(@) (@)(@@) باب: ومن سورة الحشر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٢ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن نافع، عن ابن عمر، قال: (@)(@@) @MATN@ " حرق رسول الله صلى الله عليه وسلم نخل بني النضير وقطع، وهي البويرة، فأنزل الله @QB@ {ما قطعتم من لينة أو تركتموها قائمة على أصولها فبإذن الله وليخزي الفاسقين} @QE@ [الحشر: ٥] " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٣ - (@)(@@) حدثنا الحسن بن محمد الزعفراني قال: حدثنا عفان بن مسلم قال: حدثنا حفص بن غياث قال: حدثنا حبيب بن أبي عمرة، عن سعيد بن جبير، عن ابن عباس، في قول الله عز وجل: @QB@ {ما قطعتم من لينة أو تركتموها قائمة على أصولها} @QE@ [الحشر: ٥] قال: (@)(@@) @MATN@ «اللينة النخلة» ، (@)(@@) وليخزي الفاسقين قال: (@)(@@) @MATN@ «استنزلوهم من حصونهم» ، (@)(@@) قال: (@)(@@) @MATN@ " أمروا بقطع النخل فحك في صدورهم. فقال المسلمون: قد قطعنا بعضا وتركنا بعضا، فلنسألن رسول الله صلى الله عليه وسلم هل لنا فيما قطعنا من أجر؟ وهل علينا فيما تركنا من وزر؟ فأنزل الله تعالى: @QB@ {ما قطعتم من لينة أو تركتموها قائمة على أصولها} @QE@ [الحشر: ٥] (@)(@@) @MATN@ «الآية. هذا حديث حسن غريب. PageV05P408 وروى بعضهم هذا الحديث عن حفص بن غياث، عن حبيب بن أبي عمرة، عن سعيد بن جبير،» (@)(@@) مرسلا ولم يذكر فيه عن ابن عباس (@)(@@) @MATN@ «حدثنا بذلك عبد الله بن عبد الرحمن، عن هارون بن معاوية، عن حفص بن غياث، 
ms1067	 عن حبيب بن أبي عمرة، عن سعيد بن جبير، عن النبي صلى الله عليه وسلم» (@)(@@) مرسلا " : (@)(@@) @MATN@ «سمع مني محمد بن إسماعيل هذا الحديث» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٤ - (@)(@@) حدثنا أبو كريب قال: حدثنا وكيع، عن فضيل بن غزوان، عن أبي حازم، عن أبي هريرة: (@)(@@) @MATN@ " أن رجلا من الأنصار بات به ضيف فلم يكن عنده إلا قوته وقوت صبيانه، فقال لامرأته: نومي الصبية، وأطفئي السراج، وقربي للضيف ما عندك " ، فنزلت هذه الآية: @QB@ {ويؤثرون على أنفسهم ولو كان بهم خصاصة} @QE@ [الحشر: ٩] (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@) باب: ومن سورة الممتحنة (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عمرو بن دينار، عن الحسن بن محمد هو ابن الحنفية، عن عبيد الله بن أبي رافع، قال: سمعت علي بن أبي طالب يقول: بعثنا رسول الله صلى الله عليه وسلم أنا والزبير والمقداد بن الأسود فقال: (@)(@@) @MATN@ «انطلقوا حتى تأتوا روضة خاخ فإن بها ظعينة معها كتاب، PageV05P409 فخذوه منها فأتوني به» ، (@)(@@) فخرجنا تتعادى بنا خيلنا حتى أتينا الروضة، فإذا نحن بالظعينة فقلنا: أخرجي الكتاب، فقالت: ما معي من كتاب، قلنا: لتخرجن الكتاب أو لتلقين الثياب، قال: فأخرجته من عقاصها قال: فأتينا به رسول الله صلى الله عليه وسلم، فإذا هو من حاطب بن أبي بلتعة إلى أناس من المشركين بمكة يخبرهم ببعض أمر النبي صلى الله عليه وسلم فقال: (@)(@@) @MATN@ «ما هذا يا حاطب؟» (@)(@@) قال: لا تعجل علي يا رسول الله، إني كنت امرأ ملصقا في قريش ولم أكن من أنفسها، وكان من معك من المهاجرين لهم قرابات يحمون بها أهليهم وأموالهم بمكة، فأحببت إذ فاتني ذلك من نسب فيهم أن أتخذ فيهم يدا يحمون بها قرابتي، وما فعلت ذلك كفرا وارتدادا عن ديني ولا رضا بالكفر. فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «صدق» ، (@)(@@) فقال عمر بن الخطاب: دعني يا رسول الله أضرب عنق هذا المنافق، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ " إنه قد شهد بدرا، فما يدريك لعل الله اطلع على أهل بدر، فقال: اعملوا ما شئتم فقد غفرت 
ms1068	 لكم " . قال: وفيه أنزلت هذه السورة @QB@ {يا أيها الذين آمنوا لا تتخذوا عدوي وعدوكم أولياء تلقون إليهم بالمودة} @QE@ [الممتحنة: ١] السورة. قال عمرو: (@)(@@) @MATN@ «وقد رأيت ابن أبي رافع وكان كاتبا لعلي PageV05P410» (@)(@@) هذا حديث حسن صحيح " وفيه عن عمر، وجابر بن عبد الله وروى غير واحد عن سفيان بن عيينة، هذا الحديث نحو هذا، وذكروا هذا الحرف وقالوا: لتخرجن الكتاب أو لتلقين الثياب. وهذا حديث قد روي أيضا عن أبي عبد الرحمن السلمي، عن علي بن أبي طالب، نحو هذا الحديث. وذكر بعضهم فيه: لتخرجن الكتاب أو لنجردنك (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٦ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبد الرزاق، عن معمر، عن الزهري، عن عروة، عن عائشة، قالت: " ما كان رسول الله صلى الله عليه وسلم يمتحن إلا بالآية التي قال الله @QB@ {إذا جاءك المؤمنات يبايعنك} @QE@ [الممتحنة: ١٢] الآية (@)(@) (@)(@@) قال معمر: فأخبرني ابن طاووس، عن أبيه، قال: (@)(@@) @MATN@ «ما مست يد رسول الله صلى الله عليه وسلم يد امرأة إلا امرأة يملكها» . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٧ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا أبو نعيم قال: حدثنا يزيد بن عبد الله الشيباني، قال: سمعت شهر بن حوشب، قال: حدثتنا أم سلمة الأنصارية، قالت: قالت امرأة من النسوة: ما هذا المعروف الذي لا ينبغي لنا أن نعصيك فيه؟ قال: (@)(@@) @MATN@ «لا تنحن» ، (@)(@@) قلت: يا رسول الله إن بني فلان قد أسعدوني على عمي ولا بد لي من قضائهم، فأبى علي، PageV05P411 فعاتبته مرارا، فأذن لي في قضائهن، فلم أنح بعد قضائهن ولا غيره حتى الساعة، ولم يبق من النسوة امرأة إلا وقد ناحت غيري: (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) وفيه عن أم عطية قال عبد بن حميد: (@)(@@) @MATN@ " أم سلمة الأنصارية هي: أسماء بنت يزيد بن السكن " (@) (@)(@) (@)(@@) باب: ومن سورة الصف (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٠٩ - (@)(@@) حدثنا عبد الله بن عبد الرحمن قال: أخبرنا محمد بن كثير، عن الأوزاعي، عن يحيى بن أبي كثير، عن أبي سلمة، عن عبد الله بن سلام، قال: قعدنا نفر من أصحاب رسول الله صلى الله عليه وسلم فتذاكرنا، فقلنا: 
ms1069	 لو نعلم أي الأعمال أحب إلى PageV05P412 الله لعملناه، فأنزل الله تعالى @QB@ {سبح لله ما في السموات وما في الأرض وهو العزيز الحكيم يا أيها الذين آمنوا لم تقولون ما لا تفعلون} ، قال عبد الله بن سلام: (@)(@@) @MATN@ «فقرأها علينا رسول الله صلى الله عليه وسلم» (@)(@@) قال أبو سلمة: (@)(@@) @MATN@ «فقرأها علينا ابن سلام» (@)(@@) قال يحيى: (@)(@@) @MATN@ «فقرأها علينا أبو سلمة» (@)(@@) قال ابن كثير: (@)(@@) @MATN@ «فقرأها علينا الأوزاعي» (@)(@@) قال عبد الله: (@)(@@) @MATN@ «فقرأها علينا ابن كثير» . (@)(@@) وقد خولف محمد بن كثير، في إسناد هذا الحديث عن الأوزاعي، فروى ابن المبارك، عن الأوزاعي، عن يحيى بن أبي كثير، عن هلال بن أبي ميمونة، عن عطاء بن يسار، عن عبد الله بن سلام، أو عن أبي سلمة عن عبد الله بن سلام، وروى الوليد بن مسلم، هذا الحديث، عن الأوزاعي، نحو رواية محمد بن كثير (@) (@)(@) (@)(@@) باب: ومن سورة الجمعة (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٠ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا عبد الله بن جعفر قال: حدثني ثور بن زيد الديلي، عن أبي الغيث، عن أبي هريرة، قال: كنا عند رسول الله صلى الله عليه وسلم حين أنزلت سورة الجمعة فتلاها، فلما بلغ @QB@ {وآخرين منهم لما يلحقوا بهم} @QE@ [الجمعة: ٣] PageV05P413 قال له رجل: يا رسول الله من هؤلاء الذين لم يلحقوا بنا؟ فلم يكلمه، قال: وسلمان فينا قال: فوضع رسول الله صلى الله عليه وسلم يده على سلمان فقال: (@)(@@) @MATN@ «والذي نفسي بيده لو كان الإيمان بالثريا لتناوله رجال من هؤلاء» . (@)(@@) ثور بن زيد مدني، وثور بن يزيد شامي، وأبو الغيث اسمه: سالم مولى عبد الله بن مطيع مدني. هذا حديث غريب، وعبد الله بن جعفر هو: والد علي بن المديني ضعفه يحيى بن معين، وقد روي هذا الحديث عن أبي هريرة عن النبي صلى الله عليه وسلم من غير هذا الوجه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١١ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا هشيم قال: أخبرنا حصين، عن أبي سفيان، عن جابر، قال: (@)(@@) @MATN@ «بينما النبي صلى الله عليه وسلم يخطب يوم الجمعة قائما إذ قدمت عير المدينة فابتدرها أصحاب 
ms1070	 رسول الله صلى الله عليه وسلم حتى لم يبق منهم إلا اثنا عشر رجلا فيهم أبو بكر، وعمر» ، (@)(@@) ونزلت هذه الآية @QB@ {وإذا رأوا تجارة أو لهوا انفضوا إليها وتركوك قائما} @QE@ [الجمعة: ١١] . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) حدثنا أحمد بن منيع قال: حدثنا هشيم قال: أخبرنا حصين، عن سالم بن أبي الجعد، عن جابر، عن النبي صلى الله عليه وسلم بنحوه،: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P414 (@)(@) (@)(@@) باب: ومن سورة المنافقين (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٢ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبيد الله بن موسى، عن إسرائيل، عن أبي إسحاق، عن زيد بن أرقم، قال: كنت مع عمي فسمعت عبد الله بن أبي ابن سلول، يقول لأصحابه: @QB@ {لا تنفقوا على من عند رسول الله حتى ينفضوا} @QE@ [المنافقون: ٧] و @QB@ {لئن رجعنا إلى المدينة ليخرجن الأعز منها الأذل} @QE@ [المنافقون: ٨] فذكرت ذلك لعمي، فذكر ذلك عمي للنبي صلى الله عليه وسلم، فدعاني النبي صلى الله عليه وسلم فحدثته، فأرسل رسول الله صلى الله عليه وسلم، إلى عبد الله بن أبي وأصحابه، فحلفوا ما قالوا، فكذبني رسول الله صلى الله عليه وسلم وصدقه، فأصابني شيء لم يصبني شيء قط مثله، فجلست في البيت، فقال عمي: ما أردت إلا أن كذبك رسول الله صلى الله عليه وسلم ومقتك، فأنزل الله تعالى @QB@ {إذا جاءك المنافقون} @QE@ [المنافقون: ١] فبعث إلي رسول الله صلى الله عليه وسلم فقرأها، ثم قال: (@)(@@) @MATN@ «إن الله قد صدقك» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٣ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبيد الله بن موسى، عن إسرائيل، عن السدي، عن أبي سعيد الأزدي قال: حدثنا زيد بن أرقم، قال: غزونا مع رسول الله صلى الله عليه وسلم وكان معنا أناس من الأعراب PageV05P415 فكنا نبتدر الماء، وكان الأعراب يسبقونا إليه، فسبق أعرابي أصحابه، فيسبق الأعرابي فيملأ الحوض ويجعل حوله حجارة ويجعل النطع عليه حتى يجيء أصحابه. قال: فأتى رجل من الأنصار أعرابيا فأرخى زمام ناقته لتشرب فأبى أن يدعه فانتزع قباض الماء، فرفع الأعرابي خشبة فضرب بها رأس الأنصاري فشجه، فأتى عبد الله 
ms1071	 بن أبي رأس المنافقين فأخبره وكان من أصحابه، فغضب عبد الله بن أبي، ثم قال: @QB@ {لا تنفقوا على من عند رسول الله حتى ينفضوا} @QE@ [المنافقون: ٧] - يعني الأعراب - وكانوا يحضرون رسول الله صلى الله عليه وسلم عند الطعام، فقال عبد الله: إذا انفضوا من عند محمد فأتوا محمدا بالطعام، فليأكل هو ومن عنده، ثم قال لأصحابه: لئن رجعتم إلى المدينة ليخرجن الأعز منها الأذل، قال زيد: وأنا ردف رسول الله صلى الله عليه وسلم قال: فسمعت عبد الله بن أبي، فأخبرت عمي، فانطلق فأخبر رسول الله صلى الله عليه وسلم (@)(@@) @MATN@ «فأرسل إليه رسول الله صلى الله عليه وسلم» (@)(@@) فحلف وجحد، قال: (@)(@@) @MATN@ «فصدقه رسول الله صلى الله عليه وسلم وكذبني» ، (@)(@@) قال: فجاء عمي إلي، فقال: ما أردت إلا أن مقتك رسول الله صلى الله عليه وسلم وكذبك والمسلمون. قال: فوقع علي من الهم ما لم يقع على PageV05P416 أحد. قال: (@)(@@) @MATN@ «فبينما أنا أسير مع رسول الله صلى الله عليه وسلم في سفر قد خفقت برأسي من الهم، إذ أتاني رسول الله صلى الله عليه وسلم فعرك أذني وضحك في وجهي، فما كان يسرني أن لي بها الخلد في الدنيا» ، (@)(@@) ثم إن أبا بكر لحقني فقال: ما قال لك رسول الله صلى الله عليه وسلم؟ قلت: (@)(@@) @MATN@ «ما قال لي شيئا، إلا أنه عرك أذني وضحك في وجهي» . (@)(@@) فقال: أبشر، ثم لحقني عمر، فقلت له مثل قولي لأبي بكر (@)(@@) @MATN@ «فلما أصبحنا قرأ رسول الله صلى الله عليه وسلم سورة المنافقين» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٤ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا ابن أبي عدي قال: أخبرنا شعبة، عن الحكم بن عتيبة، قال: سمعت محمد بن كعب القرظي، منذ أربعين سنة يحدث عن زيد بن أرقم، أن عبد الله بن أبي، قال في غزوة تبوك: @QB@ {لئن رجعنا إلى المدينة ليخرجن الأعز منها الأذل} @QE@ [المنافقون: ٨] قال: فأتيت النبي صلى الله عليه وسلم، فذكرت ذلك له، فحلف ما قاله، فلامني قومي وقالوا: ما أردت إلى هذه، فأتيت البيت ونمت 
ms1072	 كئيبا حزينا، فأتاني النبي صلى الله عليه وسلم أو أتيته، فقال: (@)(@@) @MATN@ «إن الله قد صدقك» (@)(@@) قال: فنزلت هذه الآية: @QB@ {هم الذين يقولون لا تنفقوا على من عند رسول الله حتى ينفضوا} @QE@ [المنافقون: ٧] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عمرو بن دينار، سمع جابر بن عبد الله يقول: كنا في غزاة - قال سفيان: يرون أنها غزوة PageV05P417 بني المصطلق فكسع رجل من المهاجرين رجلا من الأنصار، فقال المهاجري: يا للمهاجرين وقال الأنصاري: يا للأنصار، فسمع ذلك النبي صلى الله عليه وسلم فقال: (@)(@@) @MATN@ «ما بال دعوى الجاهلية؟» (@)(@@) قالوا: رجل من المهاجرين كسع رجلا من الأنصار، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «دعوها فإنها منتنة» ، (@)(@@) فسمع ذلك عبد الله بن أبي ابن سلول، فقال: أوقد فعلوها؟ والله لئن رجعنا إلى المدينة ليخرجن الأعز منها الأذل، فقال عمر: يا رسول الله، دعني أضرب عنق هذا المنافق، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «دعه لا يتحدث الناس أن محمدا يقتل أصحابه» (@)(@@) وقال غير عمرو، فقال: له ابنه عبد الله بن عبد الله: والله لا تنقلب حتى تقر أنك الذليل، ورسول الله صلى الله عليه وسلم العزيز، ففعل: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٦ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا جعفر بن عون قال: أخبرنا أبو جناب الكلبي، عن الضحاك بن مزاحم، عن ابن عباس قال: (@)(@@) @MATN@ «من كان له مال يبلغه حج بيت ربه، أو يجب عليه فيه زكاة، فلم يفعل، يسأل الرجعة عند الموت» ، (@)(@@) فقال رجل: يا ابن عباس، اتق الله، فإنما يسأل PageV05P418 الرجعة الكفار؟ فقال: سأتلو عليك بذلك قرآنا: @QB@ {يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله ومن يفعل ذلك فأولئك هم الخاسرون وأنفقوا مما رزقناكم من قبل أن يأتي أحدكم الموت فيقول رب لولا أخرتني إلى أجل قريب فأصدق} - إلى قوله - @QB@ {والله خبير بما تعملون} @QE@ [المنافقون: ١١] قال: (@)(@@) @MATN@ «فما يوجب الزكاة؟» (@)(@@) قال: إذا بلغ المال مائتين فصاعدا. قال: (@)(@@) @MATN@ «فما يوجب الحج؟» (@)(@@) قال: الزاد والبعير 
ms1073	 حدثنا عبد بن حميد قال: حدثنا عبد الرزاق، عن الثوري، عن يحيى بن أبي حية، عن الضحاك، عن ابن عباس، عن النبي صلى الله عليه وسلم بنحوه. هكذا روى سفيان بن عيينة، وغير واحد هذا الحديث عن أبي جناب، عن الضحاك، عن ابن عباس، قوله، ولم يرفعه، (@)(@@) @MATN@ " وهذا أصح من رواية عبد الرزاق، وأبو جناب القصاب، اسمه: يحيى بن أبي حية وليس هو بالقوي في الحديث " (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة التغابن (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٧ - (@)(@@) حدثنا محمد بن يحيى قال: حدثنا محمد بن يوسف قال: حدثنا إسرائيل قال: حدثنا سماك بن حرب، عن عكرمة، عن ابن عباس، وسأله، رجل عن هذه الآية: @QB@ {يا أيها الذين آمنوا إن من أزواجكم وأولادكم عدوا لكم فاحذروهم} @QE@ [التغابن: ١٤] قال: (@)(@@) @MATN@ «هؤلاء رجال أسلموا من أهل مكة وأرادوا أن يأتوا النبي صلى الله عليه وسلم، فأبى أزواجهم وأولادهم أن يدعوهم أن يأتوا رسول الله صلى الله عليه وسلم، فلما أتوا رسول الله PageV05P419 صلى الله عليه وسلم رأوا الناس قد فقهوا في الدين هموا أن يعاقبوهم» ، (@)(@@) فأنزل الله عز وجل: @QB@ {يا أيها الذين آمنوا إن من أزواجكم وأولادكم عدوا لكم فاحذروهم} @QE@ [التغابن: ١٤] الآية:: هذا حديث حسن صحيح " (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة التحريم (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٨ - (@)(@@) حدثنا عبد بن حميد قال: أخبرنا عبد الرزاق، عن معمر، عن الزهري، عن عبيد الله بن عبد الله بن أبي ثور، قال: سمعت ابن عباس يقول: لم أزل حريصا أن أسأل عمر عن المرأتين من أزواج النبي صلى الله عليه وسلم اللتين قال الله عز وجل: @QB@ {إن تتوبا إلى الله فقد صغت قلوبكما} @QE@ [التحريم: ٤] حتى حج عمر، وحججت معه، فصببت عليه من الإداوة فتوضأ، فقلت: يا أمير المؤمنين، من المرأتان من أزواج النبي صلى الله عليه وسلم اللتان قال الله: @QB@ {إن تتوبا إلى الله فقد صغت قلوبكما} @QE@ [التحريم: ٤] فقال لي: واعجبا لك يا ابن عباس قال الزهري: وكره والله ما سأله عنه ولم يكتمه: فقال: هي عائشة، وحفصة، قال: ثم أنشأ يحدثني الحديث فقال: PageV05P420 كنا معشر قريش نغلب النساء، 
ms1074	 فلما قدمنا المدينة وجدنا قوما تغلبهم نساؤهم، فطفق نساؤنا يتعلمن من نسائهم، فتغضبت يوما على امرأتي، فإذا هي تراجعني، فأنكرت أن تراجعني، فقالت: ما تنكر من ذلك؟ فوالله إن أزواج النبي صلى الله عليه وسلم ليراجعنه، وتهجره إحداهن اليوم إلى الليل. قال: قلت في نفسي: قد خابت من فعلت ذلك منهن وخسرت قال: وكان منزلي بالعوالي في بني أمية، وكان لي جار من الأنصار، كنا نتناوب النزول إلى رسول الله صلى الله عليه وسلم قال: فينزل يوما فيأتيني بخبر الوحي وغيره، وأنزل يوما فآتيه بمثل ذلك. قال: فكنا نحدث أن غسان تنعل الخيل لتغزونا. قال: فجاءني يوما عشاء فضرب علي الباب، فخرجت إليه، فقال: حدث أمر عظيم. قلت: أجاءت غسان قال: أعظم من ذلك، طلق رسول الله صلى الله عليه وسلم نساءه. قال: قلت في نفسي: خابت حفصة وخسرت، قد كنت أظن هذا كائنا، قال: فلما صليت الصبح شددت علي ثيابي، ثم انطلقت حتى دخلت على حفصة، فإذا هي تبكي، فقلت: أطلقكن رسول الله صلى الله عليه وسلم؟ قالت: لا أدري، هو ذا معتزل في هذه المشربة قال: فانطلقت فأتيت غلاما أسود، فقلت: استأذن لعمر، قال: فدخل ثم خرج PageV05P421 إلي، قال: قد ذكرتك له فلم يقل شيئا. قال: فانطلقت إلى المسجد، فإذا حول المنبر نفر يبكون، فجلست إليهم، ثم غلبني ما أجد فأتيت الغلام فقلت: استأذن لعمر، فدخل، ثم خرج إلي، قال: قد ذكرتك له فلم يقل شيئا، قال: فانطلقت إلى المسجد أيضا فجلست، ثم غلبني ما أجد، فأتيت الغلام، فقلت: استأذن لعمر، فدخل، ثم خرج إلي فقال: ذكرتك له فلم يقل شيئا. قال: فوليت منطلقا، فإذا الغلام يدعوني، فقال: ادخل فقد أذن لك، قال: فدخلت، فإذا النبي صلى الله عليه وسلم متكئ على رمل حصير، فرأيت أثره في جنبه فقلت: يا رسول الله، أطلقت نساءك؟ قال: (@)(@@) @MATN@ «لا» . (@)(@@) قلت: الله أكبر، لقد رأيتنا يا رسول الله وكنا معشر قريش نغلب النساء، فلما قدمنا المدينة وجدنا قوما تغلبهم نساؤهم، فطفق نساؤنا 
ms1075	 يتعلمن من نسائهم، فتغضبت يوما على امرأتي، فإذا هي تراجعني، فأنكرت ذلك، فقالت: ما تنكر؟ فوالله إن أزواج النبي صلى الله عليه وسلم ليراجعنه وتهجره إحداهن اليوم إلى الليل، قال: فقلت لحفصة: أتراجعين رسول الله صلى الله عليه وسلم؟ قالت: نعم، وتهجره إحدانا اليوم إلى الليل، فقلت: قد خابت من فعلت ذلك منكن وخسرت، أتأمن إحداكن أن يغضب الله عليها لغضب رسول الله صلى الله عليه وسلم، فإذا هي قد هلكت؟ فتبسم النبي صلى الله عليه وسلم. قال: فقلت لحفصة: لا تراجعي رسول الله صلى الله عليه وسلم، ولا تسأليه شيئا، وسليني ما بدا لك، ولا يغرنك إن كانت صاحبتك PageV05P422 أوسم منك، وأحب إلى رسول الله صلى الله عليه وسلم. قال: فتبسم أخرى، فقلت: يا رسول الله، أستأنس؟ قال: (@)(@@) @MATN@ «نعم» . (@)(@@) قال: فرفعت رأسي فما رأيت في البيت إلا أهبة ثلاثة. قال: فقلت يا رسول الله، ادع الله أن يوسع على أمتك، فقد وسع على فارس والروم وهم لا يعبدونه، فاستوى جالسا، فقال: (@)(@@) @MATN@ «أفي شك أنت يا ابن الخطاب؟ أولئك قوم عجلت لهم طيباتهم في الحياة الدنيا» . (@)(@@) قال: وكان أقسم أن لا يدخل على نسائه شهرا، فعاتبه الله في ذلك وجعل له كفارة اليمين قال الزهري، فأخبرني عروة، عن عائشة، قالت: فلما مضت تسع وعشرون دخل علي النبي صلى الله عليه وسلم بدأ بي قال: (@)(@@) @MATN@ «يا عائشة، إني ذاكر لك شيئا فلا تعجلي حتى تستأمري أبويك» (@)(@@) قالت: ثم قرأ هذه الآية: @QB@ {يا أيها النبي قل لأزواجك} @QE@ [الأحزاب: ٢٨] الآية. قالت: علم والله أن أبوي لم يكونا يأمراني بفراقه، قالت: فقلت: أفي هذا أستأمر أبوي؟ فإني أريد الله ورسوله والدار الآخرة. قال معمر، فأخبرني أيوب، أن عائشة، قالت له: يا رسول الله، لا تخبر أزواجك أني اخترتك، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إنما بعثني الله مبلغا ولم يبعثني متعنتا» . (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب قد روي من غير وجه عن ابن عباس» (@)(@@) (@)PageV05P423 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة ن (@)(@) (@)(@@)(@@)(@@) ||| ٣٣١٩ - (@)(@@) حدثنا يحيى بن موسى قال: 
ms1076	 حدثنا أبو داود الطيالسي قال: حدثنا عبد الواحد بن سليم، قال: قدمت مكة فلقيت عطاء بن أبي رباح فقلت: يا أبا محمد إن ناسا عندنا يقولون في القدر، فقال عطاء: لقيت الوليد بن عبادة بن الصامت، قال: حدثني أبي، قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ " إن أول ما خلق الله القلم، فقال له: اكتب، فجرى بما هو كائن إلى الأبد " وفي الحديث قصة. هذا حديث حسن صحيح غريب وفيه عن ابن عباس (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الحاقة (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٠ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبد الرحمن بن سعد، عن عمرو بن أبي قيس، عن سماك بن حرب، عن عبد الله بن عميرة، عن الأحنف بن قيس، عن العباس بن عبد المطلب قال: زعم أنه كان جالسا في البطحاء في عصابة، ورسول الله صلى الله عليه وسلم جالس فيهم، إذ مرت عليهم سحابة فنظروا إليها، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هل تدرون ما اسم هذه؟» (@)(@@) قالوا: نعم، PageV05P424 هذا السحاب، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «والمزن؟» (@)(@@) قالوا: والمزن قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «والعنان؟» (@)(@@) قالوا: والعنان ثم قال لهم رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هل تدرون كم بعد ما بين السماء والأرض؟» (@)(@@) قالوا: لا، والله ما ندري، قال: (@)(@@) @MATN@ «فإن بعد ما بينهما إما واحدة، وإما اثنتان، أو ثلاث وسبعون سنة، والسماء التي فوقها كذلك، حتى عددهن سبع سموات كذلك» ، (@)(@@) ثم قال: (@)(@@) @MATN@ «فوق السماء السابعة بحر بين أعلاه وأسفله كما بين السماء إلى السماء، وفوق ذلك ثمانية أوعال بين أظلافهن وركبهن مثل ما بين سماء إلى سماء، ثم فوق ظهورهن العرش، بين أسفله وأعلاه مثل ما بين سماء إلى سماء، والله فوق ذلك» (@)(@@) قال عبد بن حميد: سمعت يحيى بن معين يقول: (@)(@@) @MATN@ «ألا يريد عبد الرحمن بن سعد أن يحج حتى يسمع منه هذا الحديث» . (@)(@@) @MATN@ «هذا حديث حسن غريب» ، (@)(@@) وروى الوليد بن أبي ثور، عن سماك، نحوه ورفعه وروى شريك، عن سماك، بعض هذا 
ms1077	 الحديث ووقفه ولم يرفعه، (@)(@@) @MATN@ " وعبد الرحمن هو: ابن عبد الله بن سعد الرازي " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢١ - (@)(@@) حدثنا يحيى بن موسى قال: حدثنا عبد الرحمن بن عبد الله بن سعد الرازي وهو الدشتكي، أن أباه، أخبره، أن أباه أخبره قال: رأيت رجلا ببخارى على بغلة، وعليه عمامة سوداء، يقول: (@)(@@) @MATN@ «كسانيها رسول الله صلى الله عليه وسلم» (@)(@@) (@)PageV05P425 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة سأل سائل (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٢ - (@)(@@) حدثنا أبو كريب قال: حدثنا رشدين بن سعد، عن عمرو بن الحارث، عن دراج أبي السمح، عن أبي الهيثم، عن أبي سعيد، عن النبي صلى الله عليه وسلم في قوله: @QB@ {كالمهل} @QE@ [الكهف: ٢٩] قال: (@)(@@) @MATN@ «كعكر الزيت، فإذا قربه إلى وجهه سقطت فروة وجهه فيه» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث رشدين» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الجن (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٣ - (@)(@@) حدثنا عبد بن حميد قال: حدثني أبو الوليد قال: حدثنا أبو عوانة، عن أبي بشر، عن سعيد بن جبير، عن ابن عباس قال: (@)(@@) @MATN@ «ما قرأ رسول الله صلى الله عليه وسلم على الجن ولا رآهم،» (@)(@@) انطلق رسول الله صلى الله عليه وسلم في طائفة من أصحابه عامدين إلى سوق عكاظ، وقد حيل بين الشياطين وبين خبر السماء، وأرسلت عليهم الشهب، فرجعت الشياطين إلى قومهم، فقالوا: ما لكم؟ قالوا: حيل بيننا وبين خبر السماء، وأرسلت علينا الشهب فقالوا: PageV05P426 ما حال بيننا وبين خبر السماء إلا أمر حدث، فاضربوا مشارق الأرض ومغاربها، فانظروا ما هذا الذي حال بينكم وبين خبر السماء؟ قال: فانطلقوا يضربون مشارق الأرض ومغاربها، يبتغون ما هذا الذي حال بينهم وبين خبر السماء، فانصرف أولئك النفر الذين توجهوا نحو تهامة إلى رسول الله صلى الله عليه وسلم وهو بنخلة عامدا إلى سوق عكاظ، وهو يصلي بأصحابه صلاة الفجر، فلما سمعوا القرآن استمعوا له، فقالوا: هذا والله الذي حال بينكم وبين خبر السماء. قال: فهنالك رجعوا إلى قومهم، فقالوا: يا قومنا @QB@ {إنا سمعنا قرآنا عجبا يهدي إلى الرشد فآمنا به ولن نشرك بربنا أحدا} @QE@ [الجن: ٢] فأنزل الله تبارك وتعالى على نبيه: @QB@ {قل أوحي إلي 
ms1078	 أنه استمع نفر من الجن} @QE@ [الجن: ١] وإنما أوحي إليه قول الجن " (@) (@)(@) (@)(@@) وبهذا الإسناد عن ابن عباس قال: قول الجن لقومهم: @QB@ {لما قام عبد الله يدعوه كادوا يكونون عليه لبدا} @QE@ [الجن: ١٩] قال: (@)(@@) @MATN@ " لما رأوه يصلي وأصحابه يصلون بصلاته ويسجدون بسجوده، قال: تعجبوا من طواعية أصحابه له قالوا لقومهم: @QB@ {لما قام عبد الله يدعوه كادوا يكونون عليه لبدا} @QE@ [الجن: ١٩] (@)(@@) @MATN@ «.» (@)(@@) هذا حديث حسن صحيح " (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٤ - (@)(@@) حدثنا محمد بن يحيى قال: حدثنا محمد بن يوسف قال: حدثنا إسرائيل قال: حدثنا أبو إسحاق، عن سعيد بن جبير، عن ابن عباس قال: (@)(@@) @MATN@ " كان الجن يصعدون إلى السماء يستمعون الوحي، فإذا PageV05P427 سمعوا الكلمة زادوا فيها تسعا، فأما الكلمة فتكون حقا، وأما ما زادوه فيكون باطلا، فلما بعث رسول الله صلى الله عليه وسلم منعوا مقاعدهم، فذكروا ذلك لإبليس، ولم تكن النجوم يرمى بها قبل ذلك، فقال لهم إبليس: ما هذا إلا من أمر قد حدث في الأرض، فبعث جنوده فوجدوا رسول الله صلى الله عليه وسلم قائما يصلي بين جبلين أراه قال: بمكة، فلقوه فأخبروه، فقال: هذا الحدث الذي حدث في الأرض " . هذا حديث حسن صحيح (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة المدثر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٥ - (@)(@@) حدثنا عبد بن حميد قال: أخبرنا عبد الرزاق قال: حدثنا معمر، عن الزهري، عن أبي سلمة، عن جابر بن عبد الله قال: سمعت رسول الله صلى الله عليه وسلم وهو يحدث عن فترة الوحي، فقال في حديثه: (@)(@@) @MATN@ " بينما أنا أمشي سمعت صوتا من السماء فرفعت رأسي، فإذا الملك الذي جاءني بحراء جالس على كرسي بين السماء والأرض فجثثت منه رعبا، فرجعت فقلت: (@)(@@) @MATN@ «زملوني زملوني» ، (@)(@@) فدثروني " ، فأنزل الله عز وجل: @QB@ {يا أيها المدثر قم فأنذر} @QE@ [المدثر: ٢] - إلى قوله - @QB@ {والرجز فاهجر} @QE@ [المدثر: ٥] قبل أن تفرض الصلاة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» . (@)(@@) PageV05P428 وقد رواه يحيى بن أبي كثير، عن أبي سلمة بن عبد الرحمن أيضا (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٦ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا الحسن بن موسى، عن ابن لهيعة، عن دراج، عن أبي الهيثم، عن أبي سعيد، عن رسول الله صلى 
ms1079	 الله عليه وسلم قال: (@)(@@) @MATN@ «الصعود جبل من نار يتصعد فيه الكافر سبعين خريفا، ثم يهوي به كذلك أبدا» . (@)(@@) هذا حديث غريب إنما نعرفه مرفوعا من حديث ابن لهيعة. وقد روي شيء من هذا عن عطية، عن أبي سعيد، موقوفا (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٧ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن مجالد، عن الشعبي، عن جابر بن عبد الله قال: قال ناس من اليهود لأناس من أصحاب النبي صلى الله عليه وسلم: هل يعلم نبيكم كم عدد خزنة جهنم؟ قالوا: لا ندري حتى نسأله، فجاء رجل إلى النبي صلى الله عليه وسلم، فقال: يا محمد، غلب أصحابك اليوم. قال: (@)(@@) @MATN@ «وبم غلبوا؟» (@)(@@) قال: سألهم يهود: هل يعلم نبيكم كم عدد خزنة جهنم؟ قال: (@)(@@) @MATN@ «فما قالوا؟» (@)(@@) قال: قالوا: لا ندري حتى نسأل نبينا. قال: (@)(@@) @MATN@ " أفغلب قوم سئلوا عما لا يعلمون؟ فقالوا: لا نعلم حتى نسأل نبينا، لكنهم قد سألوا نبيهم، فقالوا: أرنا الله جهرة، علي بأعداء الله، إني سائلهم عن تربة الجنة وهي الدرمك " ، فلما جاءوا قالوا: يا أبا القاسم، كم عدد خزنة جهنم؟ قال: (@)(@@) @MATN@ «هكذا وهكذا في مرة عشرة، وفي مرة تسعة» ، (@)(@@) قالوا: نعم، قال لهم النبي صلى الله عليه وسلم: PageV05P429 (@)(@@) @MATN@ «ما تربة الجنة؟» (@)(@@) قال: فسكتوا هنيهة، ثم قالوا: خبزة يا أبا القاسم، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الخبز من الدرمك» . (@)(@@) هذا حديث إنما نعرفه من هذا الوجه من حديث مجالد (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٨ - (@)(@@) حدثنا الحسن بن الصباح البزار قال: حدثنا زيد بن حباب قال: أخبرنا سهيل بن عبد الله القطعي، وهو أخو حزم بن أبي حزم القطعي، عن ثابت، عن أنس بن مالك، عن رسول الله صلى الله عليه وسلم أنه قال في هذه الآية: @QB@ {هو أهل التقوى وأهل المغفرة} @QE@ [المدثر: ٥٦] قال: (@)(@@) @MATN@ " قال الله عز وجل: أنا أهل أن أتقى، فمن اتقاني فلم يجعل معي إلها، فأنا أهل أن أغفر له " . هذا حديث غريب، وسهيل ليس بالقوي في الحديث، وقد تفرد سهيل بهذا الحديث عن ثابت (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة القيامة (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٢٩ - (@)(@@) حدثنا ابن 
ms1080	 أبي عمر قال: حدثنا سفيان بن عيينة، عن موسى بن أبي عائشة، عن سعيد بن جبير، عن ابن عباس، قال: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم إذا نزل عليه القرآن يحرك به لسانه يريد أن يحفظه» ، (@)(@@) فأنزل الله تبارك وتعالى: @QB@ {لا تحرك به لسانك لتعجل به} @QE@ [القيامة: ١٦] قال: فكان يحرك به شفتيه، وحرك سفيان شفتيه،: (@)(@@) @MATN@ «هذا حديث حسن صحيح» . (@)(@@) PageV05P430 قال علي: قال يحيى بن سعيد: (@)(@@) @MATN@ «وكان سفيان الثوري يحسن الثناء على موسى بن أبي عائشة خيرا» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٠ - (@)(@@) حدثنا عبد بن حميد، قال: أخبرني شبابة، عن إسرائيل، عن ثوير، قال: سمعت ابن عمر يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " إن أدنى أهل الجنة منزلة لمن ينظر إلى جنانه وأزواجه وخدمه وسرره مسيرة ألف سنة، وأكرمهم على الله من ينظر إلى وجهه غدوة وعشية، ثم قرأ رسول الله صلى الله عليه وسلم: @QB@ {وجوه يومئذ ناضرة إلى ربها ناظرة} @QE@ [القيامة: ٢٣] " : (@)(@@) @MATN@ «هذا حديث غريب» ، (@)(@@) وقد روى غير واحد عن إسرائيل، مثل هذا مرفوعا، وروى عبد الملك بن أبجر، عن ثوير، عن ابن عمر، قوله ولم يرفعه، وروى الأشجعي، عن سفيان، عن ثوير، عن مجاهد، عن ابن عمر، قوله ولم يرفعه، ولا نعلم أحدا ذكر فيه عن مجاهد، غير الثوري، حدثنا بذلك أبو كريب قال: حدثنا عبيد الله الأشجعي، عن سفيان، (@)(@@) @MATN@ " ثوير يكنى أبا جهم، وأبو فاختة اسمه: سعيد بن علاقة " (@)PageV05P431 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة عبس (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣١ - (@)(@@) حدثنا سعيد بن يحيى بن سعيد الأموي، قال: حدثني أبي، قال: هذا ما عرضنا على هشام بن عروة، عن أبيه، عن عائشة قالت: أنزل: @QB@ {عبس وتولى} @QE@ [عبس: ١] في ابن أم مكتوم الأعمى، أتى رسول الله صلى الله عليه وسلم فجعل يقول: يا رسول الله أرشدني، وعند رسول الله صلى الله عليه وسلم رجل من عظماء المشركين، فجعل رسول الله صلى الله عليه وسلم يعرض عنه ويقبل على الآخر، ويقول: (@)(@@) @MATN@ «أترى بما أقول بأسا؟» (@)(@@) فيقول: لا، ففي هذا أنزل: (@)(@@) @MATN@ «هذا حديث غريب» ، (@)(@@) وروى بعضهم هذا الحديث عن 