ms361	 عفير بن معدان .(@)(@@)(@@)(@@) $ * وأبو عاتكة طريف بن سليمان ، يروي عن : أنس بن مالك .(@)(@@) 1240 - حدثنا أبو بكر بن علي ، قال : حدثنا يحيى بن أيوب ، قال : حدثنا ابن علية ، قال : حدثنا سعيد الجريري ، عن أبي عائذ سيف السعدي ، وأثنى عليه خيرا ، عن يزيد بن البراء ، وكان أميرا بعمان ، وكان خير الأمراء . (@)(@@) 1241 - أخبرني أحمد بن شعيب ، قال : أنبأ أبو الوليد البسري ، قال : حدثنا الوليد بن مسلم ، قال : حدثنا أبو عائذ عفير بن معدان ، أنه سمع أبا دوس ، يحدث عن أبي عائذ اليحصبي ، عن عمارة بن عكرمة ، قال : PageV02P706 سمعت رسول الله [ صلى الله عليه وسلم ] يقول : إن الله جل ثناؤه يقول : إن عبدي كل عبدي الذي يذكرني ، وهو ملاق قرنه .(@)(@@) 1242 - أخبرني أبو عبد الرحمن النسائي ، قال : أنبأ علي بن الحسن بن الحسين ، قال : ثنا حماد بن خالد ، قال : سألت شيخا يقال له : طريف بن سليمان أبو عاتكة ، وكان قد أتى عليه مائة سنة وأربع سنين ، فقلت له : ربما اختلط عليك عقلك ؟ قال : نعم ، قلت : سمعت من أنس بن مالك : طلب العلم فريضة على كل مسلم ؟ قال : نعم 2 / 24 . PageV02P707(@)(@@)(@@)(@@) ||| ( حرف الباء في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو العباس )(@)(@@)(@@)(@@) $ * أبو العباس السائب بن فروخ المكي الشاعر .(@)(@@)(@@)(@@) $ * وأبو العباس القاسم بن كثير الإسكندراني .(@)(@@)(@@)(@@) $ * وأبو العباس الفضل بن العلاء ، يروي عن : سفيان الثوري .(@)(@@)(@@)(@@) $ * وأبو العباس الفضل بن زياد ، يحدث عن : عباد بن عباد .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن عقبة الطحان ، يحدث عن : الثوري .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن المغيرة .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن أبي الوليد الدمشقي ، عن سعيد بن عبد العزيز .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن خالد ، يروي عن : شعبة ، وهو أبو العباس الضرير ، يحدث عنه : المعلى بن أسد .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن مسلم ، يروي عن : الأوزاعي ، والثوري ، ومالك .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن يزيد بن عمير بن أبي عمار ، يروي عن : ضمرة شامي .(@)(@@)(@@)(@@) $ * وأبو العباس الوليد بن نافع الحراني ، يروي عن : شعبة .(@)(@@)(@@)(@@) $ * وأبو العباس وهب بن جرير بن حازم .(@)(@@)(@@)(@@) $ * وأبو العباس صدقة بن خالد الدمشقي .(@)(@@)(@@)(@@) $ * وأبو العباس محمد 
ms362	 بن السماك القاص . PageV02P708(@)(@@)(@@)(@@) $ * وأبو العباس المغيرة بن جميل بن أثير الكندي .(@)(@@)(@@)(@@) $ * وأبو العباس عبد الملك بن عبد الرحمن شامي ، يروي عن : ابن أبي عبلة ، سكن البصرة .(@)(@@)(@@)(@@) $ * وأبو العباس عتبة بن أبي حكيم .(@)(@@)(@@)(@@) $ * وأبو العباس يحيى بن أيوب البصري .(@)(@@)(@@)(@@) $ * وأبو العباس حماد ، عن أبي رجاء العطاردي ، يحدث عنه : شيبان بن فروخ الأيلي .(@)(@@) سمعت العباس بن محمد الدوري ، قال : سمعت يحيى بن معين ، يقول : سمع حبيب بن أبي ثابت ، من أبي العباس الشاعر .(@)(@@) قال يحيى : وسألت ابن أبي العباس الشاعر ، عن اسم أبي العباس ، فقال : اسمه السائب بن فروخ .(@)(@@) حدثني عبد الله بن أحمد بن حنبل ، قال : سمعت أبي يقول : أبو العباس الشاعر ، اسمه : السائب بن فروخ ، وهو أبو العلاء بن أبي العباس .(@)(@@) قال عبد الله في موضع آخر : سألت أبي ، ويحيى بن معين عن أبي العباس الشاعر الذي ، روى عنه : عمرو بن كثير ، وحبيب بن أبي ثابت ؟ فقالا : السائب بن فروخ .(@)(@@) 1243 - حدثنا عمرو بن علي ، قال : حدثنا الفضل بن العلاء أبو العباس PageV02P709 الكوفي ، قال : حدثنا سفيان الثوري ، عن حميد الطويل ، عن أنس بن مالك ، قال : آخر صلاة صلاها رسول الله [ صلى الله عليه وسلم ] في ثوب متوشحا [ به ] .(@)(@@) 1244 - حدثنا أبو جعفر محمد بن عبد الملك الدقيقي ، قال : حدثنا وليد ابن خالد أبو العباس الأعلم الواسطي ، قال : حدثنا محمد بن ثابت ، قال : حدثنا عمرو بن دينار ، عن طاوس ، عن عامر بن سعد ، عن أسامة بن زيد ، قال : ذكر الطاعون عند النبي [ صلى الله عليه وسلم ] ، فقال : إذا سمعتم به في أرض فلا تدخلوها ، وإذا وقع بأرض وأنتم بها فلا تفروا منها ، فإنه رجس سلط على طائفة من بني إسرائيل .(@)(@@) قال أبو جعفر : هكذا أملاه علينا عن طاوس ، وهكذا قال : سلط .(@)(@@) 1245 - حدثنا علي بن عبد العزيز صاحب أبي عبيد ، قال : حدثنا عبد الله بن هارون الهروي ، قال : حدثنا ذياب بن محمد أبو العباس المديني ، قال : حدثنا أبو حازم بن دينار ، عن سهل بن سعد الساعدي ، قال : قال رسول الله [ صلى 
ms363	 الله عليه وسلم ] : ساعتان يتقبل فيهما الدعاء : حضور النداء بالصلاة ، والصف في سبيل الله .(@)(@@) 1246 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن رافع ، عن الوليد بن عقبة أبي العباس الطحان ، عن سفيان ، عن ابن جريج ، عن عطاء ، قال : من رأى القنوت فلم يقنت فعليه سجدتا السهو ( 2 / 25 ) . PageV02P710 وأخبرني أحمد بن شعيب ، قال : حدثنا العباس بن الوليد ، قال : حدثنا الوليد بن الوليد أبو العباس ، قال : حدثنا سعيد بن عبد العزيز .(@)(@@) وأخبرني أحمد بن شعيب ، قال : حدثنا عمرو بن منصور ، قال : حدثنا معلى بن أسد ، قال : حدثنا الوليد بن خالد أبو العباس الضرير .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : صدقة بن خالد أبو العباس مولى أم البنين ، وكان صدقة بن خالد يكتب عند المحدثين في ألواح ، وأهل الشام لا يكتبون عند المحدث ، يسمعون ثم يجيئون إلى المحدث ، فيأخذون سماعهم منه .(@)(@@) 1247 - حدثنا إبراهيم بن يعقوب ، قال : حدثني يزيد بن عبد ربه ، قال : حدثنا بقية بن الوليد ، قال : حدثني عتبة بن أبي حكيم ، قال : دخلت على سليمان بن موسى ، وهو يتغدى ، فقال : ادن يا أبا العباس .(@)(@@) 1248 - أخبرني أحمد بن شعيب ، [ قال : أخبرنا إبراهيم بن عبد العزيز ابن مروان بن شجاع ، قال : حدثنا الوليد بن نافع أبو العباس الحراني ، قال : حدثنا شعبة بن الحجاج أبو بسطام .(@)(@@) 1249 - وأخبرني أحمد بن شعيب ، قال : وفي كتاب عبد الله بن سعيد إلينا ، حدثنا المغيرة بن جميل بن أثير أبو العباس الكندي ] ، قال : حدثني سليمان بن علي بن عبد الله بن عباس قال : حدثني أبي ، عن جدي عبد الله بن PageV02P711 عباس ، عن رسول الله [ صلى الله عليه وسلم ] قال : إن الولاء ليس يحول ولا ينقل .(@)(@@)(@@)(@@) |||| ( من كنيته أبو عباد )(@)(@@)(@@)(@@) $ * أبو عباد عبد الله بن سعيد بن أبي سعيد المقبري .(@)(@@)(@@)(@@) $ * وأبو عباد محمد بن عباد ، روي عن : شعبة .(@)(@@)(@@)(@@) $ * وأبو عباد يحيى بن عباد الهنائي ، يروى عن : شعبة .(@)(@@)(@@)(@@) $ * وأبو عباد عبيد بن واقد .(@)(@@) 1250 - حدثنا محمد بن المثنى أبو موسى ، قال : حدثنا عبيد 
ms364	 بن واقد أبو عباد ، قال : حدثنا محمد بن عيسى بن كيسان الهذلي ، قال : حدثنا محمد ابن المنكدر ، عن حماد ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : خلق الله جل ثناؤه ألف أمة ، منها ستمائة في البحر ، وأربعمائة في البر ، فأول شيء يهلك من هذه الأمة الجراد ، فإذا هلك تتابعت مثل النظام إذا قطع سلكه .(@)(@@) حدثنا محمد بن بشار بندار ، ويزيد بن سنان ، قالا [ حدثنا ] : صفوان بن عيسى ، قال : حدثنا أبو عباد عبد الله بن سعيد بن أبي سعيد المقبري ، عن جده ، عن أبي هريرة .(@)(@@) سمعت العباس ، عن يحيى ، قال : أبو عباد هو عبد الله بن سعيد بن أبي سعيد المقبري .(@)(@@) قال : وسمعت يحيى يقول : إبراهيم بن أبي عبلة أبو عبلة اسمه شمر . PageV02P712(@)(@@)(@@)(@@) ||| ( حرف التاء في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته ] أبو عتاب ، أو عتيق )(@)(@@)(@@)(@@) $ * أبو عتاب منصور بن المعتمر .(@)(@@)(@@)(@@) $ * وأبو عتاب سهل بن حماد الدلال ، عن : شعبة .(@)(@@)(@@)(@@) $ * وأبو عتيق عبد الرحمن بن عبد الله بن محمد بن عبد الرحمن بن أبي بكر الصديق ، انتهى .(@)(@@)(@@)(@@) |||| ( من كنيته أبو عتبة )(@)(@@)(@@)(@@) $ * أبو عتبة عباد بن عباد الخواص .(@)(@@)(@@)(@@) $ * وأبو عتبة ضمرة بن حبيب .(@)(@@)(@@)(@@) $ * وأبو عتبة عبد الرحمن بن يزيد بن جابر .(@)(@@)(@@)(@@) $ * وأبو عتبة بكر الأعنق ، يروي عنه : أبو علي الحنفي .(@)(@@)(@@)(@@) $ * [ وأبو عتبة مولى ولد مروان ] .(@)(@@)(@@)(@@) $ * وأبو عتبة إسماعيل بن عياش الحمصي . PageV02P713(@)(@@)(@@)(@@) $ * [ وأبو عتبة الحسين بن علي بن مسلم الحمصي ] ، يحدث عن : معاوية بن يحيى .(@)(@@)(@@)(@@) $ * [ وأبو عتبة الوليد بن الوليد بن سمرة ] .(@)(@@)(@@)(@@) $ * وأبو عتبة أحمد بن الفرج المعروف بالحجازي ، يروي عن : بقية ، وعن [ أبي ] حيوة شريح بن يزيد ( 2 / 26 ) .(@)(@@) 1251 - حدثنا أبو موسى محمد بن المثنى ، قال : حدثنا الوليد بن الوليد بن سمرة أبو عتبة من ولد عبد الرحمن بن سمرة ، قال : حدثني سعيد بن عبد العزيز ، قال : قال مكحول : لا تقصر الصلاة حتى تكون ثلاثين ميلا .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول في حديث المسعودي ، عن أبي عتبة ، يقال : إن أبا عتبة هو مولى ولد مروان .(@)(@@) 1252 - حدثنا ابن 
ms365	 أبي الدنيا ، قال : حدثنا محمد بن الحسين ، قال : حدثني أحمد بن سهل الأزدي ، قال : حدثني عباد بن عباد أبو عتبة الخواص ، قال : رأيت شيخا في مسجد بيت المقدس كأنه قد احترق بالنار ، عليه مدرعة سوداء وعمامة سوداء ، طويل الصمت ، كريه المنظر ، كثير الشعر ، شديد الكآبة ، فقلت : رحمك الله لو غيرت لباسك ، فقد علمت ما جاء في [ لبس ] البياض ، قال : فبكى ، ثم قال : هذا أشبه بلباس أهل المصيبة ، وإنما أنا وأنت في الدنيا في حداد ، وكأني بي وبك قد دعينا ، قال : فما تم كلامه حتى غشي عليه . PageV02P714(@)(@@)(@@)(@@) ||| ( حرف الثاء في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو عثمان )(@)(@@)(@@)(@@) $ * أبو عثمان عبيد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب رضي الله عنه .(@)(@@)(@@)(@@) $ * وأبو عثمان عبيد الله صاحب الألقاب ، يروي عنه : محمد بن المثنى .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد الله بن عثمان بن خثيم .(@)(@@)(@@)(@@) $ * وأبو عثمان النهدي عبد الرحمن بن مل .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد الرحمن بن عمرو الحراني .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد الرحمن بن عثمان ، يحدث عنه : عبد الرحمن بن يحيى ابن إسماعيل الدمشقي .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد الملك ، يروي عن : الأعمش ، حدث عنه : المعتمر بن سليمان .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد الملك بن قدامة ، يروي عنه : حجاج بن المنهال .(@)(@@)(@@)(@@) $ * وأبو عثمان عبد السلام بن هاشم البصري .(@)(@@) 1253 - حدثنا أبو موسى محمد بن المثنى ، قال : حدثني عبيد الله أبو عثمان صاحب الألقاب ، قال : حدثنا بشر بن سباع ، عن ابن أبي مليكة ، أن عثمان بن عفان كان يخضب بالسواد . PageV02P715(@)(@@) سمعت هلال بن العلاء ، يقول : سمعت حسين بن عياش يقول : سمعت أبا خيثمة زهيرا يقول : اسم أبي عثمان النهدي عبد الرحمن بن مل .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : سمعت يحيى [ بن معين ] يقول : اسم أبي عثمان النهدي عبد الرحمن بن مل .(@)(@@) 1254 - أخبرني أحمد بن شعيب ، قال أنبأ محمد بن يحيى بن محمد ، قال : حدثنا عبد الرحمن بن عمرو أبو عثمان الحراني ، قال : حدثنا محمد بن فضيل ، قال : حدثنا عمارة بن القعقاع ، عن إبراهيم ، عن علقمة ، عن عبد الله ، قال 
ms366	 : قال رسول الله [ صلى الله عليه وسلم ] : إن أهل بيتي هؤلاء اختارهم الله للآخرة ، ولم يخترهم للدنيا ، وسيلقون بعدي تشريدا وتطريدا وبلاء شديدا .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن عبيد المعتزلي ، يروي عن : الحسن ، حدث عنه : شعبة ، ويحيى القطان .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو البكالي .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن الأزهر ، يروي عنه : علي بن حجر .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن عاصم الكلابي .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن عون الواسطي .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن محمد بن أبي رزين ، يحدث عن : الثوري ، روى عنه : أبو موسى الزمن . PageV02P716(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن محمد الناقد .(@)(@@)(@@)(@@) $ * وأبو عثمان عمرو بن مرزوق ، يروي عن : شعبة .(@)(@@)(@@)(@@) $ * [ وأبو عثمان عمر بن سالم .(@)(@@)(@@)(@@) $ * وأبو عثمان عفان بن مسلم .(@)(@@)(@@)(@@) $ * وأبو عثمان الصفار : عمار بن مطر ( 2 / 27 ) ] .(@)(@@) أنبأ أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : أخبرنا [ سعيد بن الحكم المنبجي ، يروي عن : ] أبي عثمان عمرو بن الأزهر ، عن يونس .(@)(@@) 1255 - أخبرني أحمد بن شعيب ، قال : أخبرني سعيد بن الحكم المبنجي ، قال : حدثنا عمار بن مطر أبو عثمان الصفار ، قال : حدثنا مالك ، عن نافع ، عن ابن عمر ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إذا جاءكم من ترضون دينه [ الحديث ] .(@)(@@) قال أبو عبد الرحمن : هذا كذب .(@)(@@) 1256 - وأخبرني أحمد بن شعيب ، قال : أنبأ سويد ، قال : أنبأ PageV02P717 عبد الله ، عن الربيع بن صبيح ، عن أبي عثمان عمر بن سالم ، عن القاسم ، عن عائشة قالت : قال رسول الله [ صلى الله عليه وسلم ] : ما أسكر الفرق فالحسوة منه حرام .(@)(@@) حدثنا العباس ، قال : سمعت يحيى يقول : [ عمر بن سالم هو أبو عثمان الذي يروي عنه ] مهدي بن ميمون وهو أنصاري .(@)(@@) وفي موضع آخر : حدثنا العباس ، قال : سمعت يحيى يقول : روى مهدي بن ميمون عن أبي عثمان الأنصاري ، قال يحيى : يقولون إنه عمر بن سالم .(@)(@@) 1257 - أخبرني أبو عبيد علي بن الحسين القاضي ، عن الحسن بن محمد الزعفراني ، قال : حدثنا أسباط بن محمد ، قال : حدثنا مطرف ، عن أبي عثمان عمر بن سالم ، قال : حرم الله عز وجل من النسب 
ms367	 سبعا ، ومن الصهر سبعا ، وقرأ هذه الآية : @QB@ حرمت عليكم أمهاتكم وبناتكم @QE@ حتى ختم الآية ، وقال : ولا تنكحوا ما نكح آباؤكم من النساء .(@)(@@)(@@)(@@) $ * وأبو عثمان الجعد بن عثمان ، حدث عن : أنس بن مالك ، شعبة عنه .(@)(@@)(@@)(@@) $ * وأبو عثمان حجاج الصواف . PageV02P718(@)(@@)(@@)(@@) $ * [ وأبو عثمان حسان بن وبرة ، حدث عنه : حجاج ] .(@)(@@)(@@)(@@) $ * وأبو عثمان خالد بن الحارث الهجيمي .(@)(@@)(@@)(@@) $ * [ وأبو عثمان حريز بن عثمان ] .(@)(@@) حدثنا العباس بن محمد ، عن يحيى بن معين قال : كنية حجاج الصواف أبو عثمان .(@)(@@) وخالد بن الحارث أبو عثمان .(@)(@@) قال ] يحيى ] : وقد روى منصور بن المعتمر ، عن أبي عثمان ، وأبو عثمان هذا مولى المغيرة بن شعبة .(@)(@@) 1258 - حدثنا محمد بن المثنى قال : حدثنا معاذ بن معاذ ، قال : حدثنا جرير بن عثمان أبو عثمان ، ولا أعلم أن أحدا من أهل الشام أفضله عليه .(@)(@@)(@@)(@@) $ * وأبو عثمان محمد بن شريك ، يحدث عن : عمرو بن دينار .(@)(@@)(@@)(@@) $ * وأبو عثمان محمد بن بكر البرساني .(@)(@@)(@@)(@@) $ * وأبو عثمان مورق العجلي .(@)(@@)(@@)(@@) $ * وأبو عثمان مسلم بن يسار الطنبذي مصري .(@)(@@)(@@)(@@) $ * وأبو عثمان مروان العجلي . PageV02P719(@)(@@) 1259 - حدثني أبو محمد الحسن بن علي بن عفان ، قال : حدثنا أبو أسامة ، قال : حدثنا محمد بن شريك أبو عثمان المكي ، قال : حدثنا عمرو بن دينار ، قال : اشترى عمرو بن أبي عقرب من عمرو بن عثمان [ شيئا ] بعضه عنده وبعضه ليس عنده ، فأتيا عبد الله بن عمر ، فاستفتياه في ذلك ، فقال : أوفه ما كان عندك ، ولا توفه ما لم يكن عندك ، فأتى ابن عباس فسأله ، فقال : مثل ذلك .(@)(@@)(@@)(@@) $ * وأبو عثمان ربيعة بن أبي عبد الرحمن الفقيه .(@)(@@)(@@)(@@) $ * وأبو عثمان زياد بن المصفر ، روى عنه : الثوري .(@)(@@) حدثنا عيسى بن يونس ، قال : حدثنا عبد الله بن وهب ، قال : سمعت عبد الله بن لهيعة ، يقول : حدثني الحكيم بن محمد بن قيس ، قال : قلت لربيعة بن أبي عبد الرحمن يا أبا عثمان .(@)(@@)(@@)(@@) $ * وأبو عثمان عنبسة بن أبي سفيان .(@)(@@)(@@)(@@) $ * وأبو عثمان الصنعاني شراحيل بن مرثد .(@)(@@)(@@)(@@) $ * [ أخبرني أحمد بن شعيب بن علي ، عن هشام بن عمار ، قال : حدثنا عبد الملك بن محمد الصنعاني ، قال : حدثنا راشد بن 
ms368	 داود ، قال : حدثني أبو عثمان الصنعاني شراحيل بن مرشد ] .(@)(@@)(@@)(@@) $ * أبو عثمان أحمد بن عثمان بن أبي المطوس .(@)(@@)(@@)(@@) $ * وأبو عثمان أيوب ، يحدث عن : عبد الله بن أبي قيس . PageV02P720(@)(@@)(@@)(@@) $ * وأبو عثمان هشام بن لاحق المدائني .(@)(@@)(@@)(@@) $ * وأبو عثمان قتيبة بن قدامة الرواسي ، روى عنه : وكيع .(@)(@@)(@@)(@@) $ * وأبو عثمان الوليد بن أبي الوليد ، روى عنه : حيوة بن شريح .(@)(@@) 1260 - حدثنا محمد بن عمرو بن حنان ، قال : حدثنا بقية بن الوليد ، قال : حدثني عمرو بن محمد الطائي ، قال : سمعت أبا عثمان ( 2 / 28 ) أيوب ، [ يحدث ] عن عبد الله بن أبي قيس ، قال : سمعت عائشة زوج النبي [ صلى الله عليه وسلم ] تقول : رأيت رسول الله [ صلى الله عليه وسلم ] يخرج إلى صلاة الفجر ورأسه يقطر الماء من جنابة ، [ غير حلم ] ثم يصوم يومه ذلك .(@)(@@) 1261 - حدثني محمد بن عبد الله بن عبد الحكم ، وربيع بن سليمان الجيزي ، قالا : ثنا أبو زرعة وهب الله بن راشد ، قال : حدثنا حيوة بن شريح ، قال : حدثنا أبو عثمان الوليد بن أبي الوليد ، قال : رأيت شعر عثمان عمرو بن الجموح الأنصاري من بني سلمة صاحب رسول الله [ صلى الله عليه وسلم ] مصبوغا بصفرة ، ورأيته جعل شعر رأسه ضفيرتين .(@)(@@)(@@)(@@) $ * وأبو عثمان سليم بن عثمان ، يحدث عن : محمد بن زياد .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن عبد الملك بن واقد الحراني .(@)(@@)(@@)(@@) $ * وأبو عثمان [ سعيد بن ] عبد الجبار الشامي ، ليس بشيء .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن عبيد الهنائي .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن عبد الجبار البصري ، يروي عن : حاتم بن إسماعيل ، وسعيد بن سليم الضبي . PageV02P721(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد [ بن مرجانة ] .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن مروان الرهاوي ، يروي عنه : ابن وارة .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد سالم القداح .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن المغيرة الصياد .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن سليمان .(@)(@@)(@@)(@@) $ * وأبو عثمان سعيد بن شبيب طرسوسي ، شيخ صالح ، يروي عن : ابن أبي زائدة .(@)(@@) 1262 - حدثني أبو حميد أحمد بن محمد بن المغيرة بن سنان البزاز الحمصي ، قال : ثنا أبو عثمان سليم بن عثمان ، قال : حدثنا محمد بن زياد ، قال : سمعت أبا أمامة الباهلي 
ms369	 يقول : قال رسول الله [ صلى الله عليه وسلم ] : من قال : لا إله إلا الله وحده لا شريك له ، له الملك وله الحمد ، يحيي ويميت ، وهو حي لا يموت ، بيده الخير ، وهو على كل شيء قدير ، لم يسبقها عمل ولم تبق معها سيئة .(@)(@@) 1263 - حدثنا [ أبو ] خالد [ يزيد ] بن سنان ، قال : حدثنا الحجاج ابن نصير ، قال : حدثنا سعيد بن سليم الضبي أبو عثمان ، قال : سمعت أنس بن مالك يقول : أسر إلي رسول الله [ صلى الله عليه وسلم ] شيئا ، وقال : لا تخبر به أحدا حتى آمرك ، قال : فمات ولم يأمرني ، فلا أخبر به أحدا حتى أموت .(@)(@@)(@@)(@@) $ * وأبو عثمان يحيى بن يزيد المخزومي ، روى عنه : ابن الحباب . PageV02P722(@)(@@)(@@)(@@) $ * وأبو عثمان يزيد بن مرثد ، يحدث عن : أبي الدرداء ، يروي عنه : خالد بن معدان .(@)(@@)(@@)(@@) $ * وأبو عثمان يزيد بن صهيب الفقير .(@)(@@) سمعت العباس بن محمد يقول : عن يحيى بن معين ، قال : يزيد الفقير كنيته أبو عثمان .(@)(@@) قال : وسألت يحيى ، عن حديث يرويه ابن المبارك ، عن معمر ، عن أبي عثمان ، من أبو عثمان هذا ؟ قال : شيخ له .(@)(@@) 1264 - حدثني عبد الصمد بن عبد الوهاب صميد ، قال : حدثنا يحيى ابن صالح الوحاظي ، قال : حدثنا عبيد الله بن عمرو ، عن عبد الكريم ، عن أبي عثمان يزيد الفقير ، أن جبريل علم النبي [ صلى الله عليه وسلم ] إذا كان في مجلس وأراد أن يقوم ، أن يقول : سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت وحدك لا شريك لك ، أستغفرك اللهم ، وأتوب إليك . PageV02P723(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عثيم ، وأبو عثيمة ] )(@)(@@)(@@)(@@) $ * أبو عثيم سعيد بن حدير الحضرمي .(@)(@@)(@@)(@@) $ * وأبو عثيمة سلمة بن مجنون ، يروي عنه : الثوري .(@)(@@) 1265 - حدثنا إبراهيم بن يعقوب بن إسحاق الجوزجاني ، قال : حدثنا ابن أبي مريم ، قال : أخبرنا قاسم بن سلام ، قال : حدثني عبيد الله بن عبيد [ الرحمن ] الأشجعي ، عن سفيان ، عن أبي عثيمة ، واسمه : سلمة بن مجنون ، قال : كان بيني وبين رجل ( 2 / 29 ) منازعة ، فقلت له : يا روسبي ، فقدمني إلى أبي هريرة فضربني الحد .(@)(@@) 1266 - حدثنا عمران بن بكار ، قال 
ms370	 : حدثنا أبو المغيرة عبد القدوس بن الحجاج ، قال : حدثنا صفوان بن عمرو ، قال : حدثنا أبو عثيم سعيد بن حدير الحضرمي ، قال : لما أسكن الله جل ثناؤه آدم وحواء الجنة ، وذكر حديثا طويلا في آخره ، فبعث الله إليهما ملائكة يدفعون في رقابهما حتى أخرجوهما من الجنة عريانين ، وإبليس معهما . PageV02P724(@)(@@)(@@)(@@) ||| ( حرف الجيم في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو العجفاء ، وأبو العجماء ] )(@)(@@)(@@)(@@) $ * أبو العجفاء [ السلمي هرم بن نسيب .(@)(@@)(@@)(@@) $ * وأبو العجماء ، يروي ، عنه : الشيباني .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : أبو العجفاء السلمي اسمه هرم .(@)(@@) وفي موضع آخر : حدثنا العباس بن محمد ، قال : حدثنا يحيى [ بن معين ] ، قال : حدثنا ابن مهدي ، قال : اسم أبي العجفاء هرم .(@)(@@) حدثني صالح بن أحمد ، قال : حدثنا علي بن المديني ، قال : حدثنا أبو العجفاء هرم بن نسيب . PageV02P725(@)(@@)(@@)(@@) ||| ( [ حرف الحاء والخاء في العين فارغ ] )(@)(@@)(@@)(@@) ||| ( حرف الدال في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عدي ] )(@)(@@)(@@)(@@) $ * أبو عدي الزبير بن عدي كوفي ، كان قاضي الري .(@)(@@)(@@)(@@) $ * وأبو عدي أرطأة بن المنذر حمصي .(@)(@@)(@@)(@@) $ * وأبو عدي اليمان بن عدي الحضرمي .(@)(@@)(@@)(@@) $ * وأبو العدبس تبيع ابن سليمان [ روى عنه : أبو العنبس ] .(@)(@@)(@@)(@@) $ * وأبو عدي إبراهيم والد محمد بن أبي عدي .(@)(@@) قال البخاري : كنية أرطأة بن المنذر السكوني أبو عدي ، قاله : أحمد بن حنبل .(@)(@@) 1267 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن صدقة ، قال : حدثنا يمان بن عدي أبو عدي الحضرمي ، عن محمد بن زياد الألهاني ، عن أبي أمامة ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إن أعظم الناس جرما يوم PageV02P726 القيامة رجل أحرز ظهر امرئ مسلم بغير حق .(@)(@@) حدثني محمد بن يعقوب بن الفرجي ، قال : حدثني سليمان بن أيوب ، قال : حدثني عمر بن أبي خليفة ، قال : حدثنا إبراهيم ، ويكنى أبا عدي ، قال : وهو أبو محمد بن أبي عدي .(@)(@@) [ قال ] حدثني صالح بن أحمد بن حنبل ، قال : سمعت علي بن المديني يقول : أبو العدبس الأسدي منيع بن سليمان . PageV02P727(@)(@@)(@@)(@@) ||| ( حرف الذال في العين )(@)(@@)(@@)(@@) $ * أبو عذبة الحضرمي .(@)(@@) 1268 - حدثنا الحسن بن علي بن عياش ، قال : حدثنا عصام بن 
ms371	 خالد ، قال : حدثنا صفوان بن عمرو ، عن عمرو بن سليم الحضرمي ، عن أبي عذبة الحضرمي ، قال : حججت في خلافة عمر بن الخطاب ، فنزلت المدينة ، فقلت : لأصحابي احفظوا علي رحلي حتى أشهد صلاة الظهر مع أمير المؤمنين ، قال : فخرج عمر ليصلي بنا ، وقد جاءه بريد ، فأخبره أن أهل العراق قد حصبوا أميرهم ، فخرج غضبان ، فصلى بنا ، فسها في صلاته حتى جعل الناس يقولون : سبحان الله ، سبحان الله ( 2 / 30 ) ، فلما انصرف ، قال : من ههنا من أهل الشام ؟ وذلك أول ما قدم الحاج ، فقام رجل ، ثم قام آخر ، فقمت ثالثا ، أو رابعا ، فقال عمر : يا أهل الشام ! استعدوا لأهل العراق ، فإن الشيطان قد باض فيهم وفرخ ، اللهم إنهم قد لبسوا علي فألبس عليهم ، وعجل لهم الغلام الثقفي يحكم فيهم بحكم الجاهلية ، لا يقبل من محسنهم ، ولا يتجاوز عن مسيئهم . PageV02P728(@)(@@)(@@)(@@) ||| ( حرف الراء في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو العريان ] )(@)(@@)(@@)(@@) $ * أبو العريان [ بركة ] المجاشعي ، حدث عنه : خالد الحذاء .(@)(@@)(@@)(@@) $ * وأبو العريان الهيثم بن الأسود .(@)(@@)(@@)(@@) $ * وأبو العريان موسى بن أبي مروان مروزي ، روى عنه أبو تميلة .(@)(@@)(@@)(@@) $ * [ وأبو العريان أنيس .(@)(@@)(@@)(@@) $ * وأبو العريان خالد بن نشيط ، يروي عنه : مروان بن معاوية ] .(@)(@@) 1269 - حدثنا يزيد بن سنان ، قال : حدثنا [ أبو ] كامل ، قال : حدثنا عبد العزيز بن المختار ، قال : حدثنا خالد الحذاء ، عن أبي العريان المجاشعي ، قال : بعثنا المختار في ألفي فارس إلى محمد بن علي بن الحنفية ، فكنا عنده فكان ابن عباس يذكر المختار ، فيقول : أدرك بثأرنا وقضى ديوننا ، وأنفق علينا ، قال : وكان محمد بن علي لا يقول فيه خيرا ولا شرا .(@)(@@) 1270 - حدثنا محمد بن إسماعيل الصائغ ، قال : حدثنا سنيد بن داود ، قال : حدثنا إسماعيل بن علية ، عن خالد الحذاء ، عن أنيس أبي العريان ، عن ابن عباس ، في قوله تعالى : ^ ( واكتب لنا في هذه الدنيا حسنة PageV02P729 وفي الآخرة إنا هدنا إليك قال : فلم يعطها ) @QB@ قال @QE@ ( عذابي أصيب به من أشاء ورحمتي وسعت كل شيء فسأكتبها للذين يتقون ويؤتون الزكاة ) ^ إلى قوله : ^ ( الذين يتبعون الرسول النبي الأمي ) ^ الآية . (@)(@@) 1271 - حدثنا 
ms372	 أبو بكر وكيل دار العباس بحمص ، قال : حدثنا شريح ابن يونس ، قال : حدثنا مروان بن معاوية ، قال : حدثنا أبو العريان خالد بن نشيط ، قال : دعينا إلى دعوة فيها الحسن البصري ، فأكلنا فأتي بنبيذ ، فشرب الحسن وشربنا . PageV02P730(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عروة ] )(@)(@@)(@@)(@@) $ * أبو عروة موسى بن ميسرة ، يروي عنه : أبو أويس .(@)(@@)(@@)(@@) $ * وأبو عروة القاسم بن مخيمرة .(@)(@@)(@@)(@@) $ * وأبو عروة معمر بن راشد .(@)(@@)(@@)(@@) $ * وأبو عروة الحسن بن عبيد الله صاحب إبراهيم النخعي .(@)(@@)(@@)(@@) $ * وأبو عروة جرير ، يحدث عنه : سليمان بن بلال .(@)(@@) 1272 - حدثني أبو يونس محمد بن أحمد بن يزيد ، قال : حدثني إسماعيل بن أبي أويس ، عن أبيه ، عن أبي عروة موسى بن ميسرة الديلي ، وابن أخيه ثور الديلي بن زيد ، عن عكرمة ، عن ابن عباس ، أن رسول الله [ صلى الله عليه وسلم ] قال : لتركبن سنن من كان قبلكم شبرا بشبر ، وذراعا بذراع ، وباعا بباع ، حتى لو أن أحدهم دخل جحر ضب دخلتم ، وحتى لو أن أحدهم ضاجع أمه بالطريق لفعلتم ، [ قال ] ولا أعلمهما إلا حدثاني مثل ذلك سواء عن أبي الغيث سالم مولى ابن مطيع ، عن أبي هريرة ، عن رسول الله [ صلى الله عليه وسلم ] .(@)(@@) 1273 - حدثنا إبراهيم بن يعقوب قال : حدثنا ابن أبي مريم ، قال : حدثنا سليمان بن بلال ، قال : أخبرني أبو عروة جرير ، شيخ كبير حسن PageV02P731 الهيئة ، قال : سمعت عطاء بن يسار يقول : من وقاه الله شرهما دخل الجنة ما بين الفخذين وما بين اللحيين .(@)(@@)(@@)(@@) $ * وأبو عرابة غاضرة بن عروة .(@)(@@)(@@)(@@) $ * وأبو عرفجة عمير .(@)(@@)(@@)(@@) $ * وأبو عروبة ، والد سعيد ، وسعيد هذا يروي عن : أبي عروبة ( 2 / 31 ) .(@)(@@) 1274 - أخبرني القاضي البرقي ، عن أبي سلمة ، قال : حدثنا الحارث ابن نبهان ، عن مالك بن دينار ، قال : أخبرني أبو عروبة وكان خيرا من سعيد ، أن ابن الزبير ، كان يكره للمؤذن أن يكون أعمى ، وقال : أعمى الله قلوبهم .(@)(@@) سمعت العباس ، يقول : سمعت يحيى يقول : أدرك أبو عروبة زمن ابن الزبير ، قال : لا أدري .(@)(@@) [ سمعت العباس يقول : سمعت يحيى يقول : أبو عروبة هو أبو سعيد بن أبي عروبة الذي 
ms373	 يروي عن ابن الزبير ، أنه كان يكره للمؤذن أن يكون أعمى قلت ليحيى : سمع أبو عروبة من ابن الزبير ؟ قال : لا أدري ] .(@)(@@) [ و ] سمعت العباس بن محمد ، عن يحيى بن معين قال : أبو عروبة اسمه مهران والد سعيد . PageV02P732(@)(@@) 1275 - حدثنا معاوية بن صالح ، قال : ثنا خالد بن مخلد ، قال : ثنا أبو عرفجة عمير من همدان ، قال : سمعت الشعبي يقول : إذا دخلت على أخيك المسلم فأطعمك وسقاك ، فكل واشرب ، [ و ] لا تسأله عن شيء . PageV02P733 (@)(@@)(@@)(@@) ||| ( حرف الزاي في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عزة ] )(@)(@@)(@@)(@@) $ * أبو عزة الحكم بن القاسم الحنفي ، يحدث عن : أبي الرباب ، روى عنه : يونس بن محمد .(@)(@@)(@@)(@@) $ * وأبو عزة الحكم بن طهمان .(@)(@@)(@@)(@@) $ * وأبو عزة الحكم بن عطية الدباغ .(@)(@@)(@@)(@@) $ * وأبو عزة الهذلي يسار بن عبد .(@)(@@) 1276 - أخبرني أحمد بن شعيب ، قال : أنبأ بشر بن آدم ، قال : حدثنا محمد بن عون ، قال : حدثنا أبو عزة الحكم بن طهمان ، قال : حدثنا أبو يزيد ، عن عكرمة ، عن ابن عباس ، قال : احتجم رسول الله [ صلى الله عليه وسلم ] وأعطى الحجام أجره .(@)(@@) سمعت العباس ، يقول : سمعت يحيى يقول : الحكم بن عطية هو أبو عزة الدباغ ، قدم الكوفة ، يروي عنه : أبو الوليد ، والتبوذكي .(@)(@@) قال أبو بشر : وبلغني عن بعض أهل العلم ، أنه قال : الحكم بن طهمان أبو عزة الدباغ حدث ، قال : حدثنا أبو الرباب مولى معقل بن يسار ، عن معقل PageV02P734 ابن يسار ، قال : قال النبي [ صلى الله عليه وسلم ] : من أكل من هذه الشجرة ، فلايقربن مصلانا . PageV02P735(@)(@@)(@@)(@@) ||| ( حرف الشين في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو العشراء ، وأبو عشانة ] )(@)(@@)(@@)(@@) $ * أبو العشراء أسامة بن مالك بن قهطم ، ويقال : يسار بن بكر ، ويقال : عطارد بن بكر .(@)(@@)(@@)(@@) $ * وأبو عشانة حي بن يؤمن ، روى عنه : عمرو بن الحارث ، وابن لهيعة .(@)(@@) قال محمد بن إسماعيل البخاري : أبو العشراء الدارمي لم يرو عنه غير حماد بن سلمة ، واسمه : عطارد بن بلز ، ويقال : [ اسمه ] يسار بن بلز بن مسعود بن خولى [ بن حرملة ] بن قتادة من بني [ مولة بن عبد الله بن ] فقيم بن دارم ، وفي [ حديثه و 
ms374	 ] اسمه ، وسماعه من أبيه نظر .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو عشانة حي بن يؤمن . PageV02P736(@)(@@)(@@)(@@) ||| ( حرف الصاد في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عصمة ] )(@)(@@)(@@)(@@) $ * أبو عصمة ريحان بن سعيد .(@)(@@)(@@)(@@) $ * وأبو عصمة نوح بن أبي مريم ، قاضي مرو ، وهو يزيد بن جعونة .(@)(@@)(@@)(@@) $ * وأبو عصام رواد بن الجراح العسقلاني .(@)(@@)(@@)(@@) $ * وأبو عاصم خالد بن عبيد .(@)(@@) 1277 - حدثنا عبد الرحمن بن محمد بن سلام الطرسوسي ، قال : حدثنا ريحان بن سعيد بن المثنى أبو عصمة القرشي ، قال : حدثنا عباد بن منصور ، عن هشام بن عروة ، عن أبيه ، عن عائشة ، قالت : قال لي رسول الله [ صلى الله عليه وسلم ] ( 2 / 32 ) يا عائشة ! كنت لك كأبي زرع لأم زرع .(@)(@@) 1278 - وروى أبو تميلة يحيى بن واضح ، قال : حدثنا خالد بن عبيد أبو عصام ، عن عبد الله بن بريدة ، عن أبيه ، قال : ذهب بي رسول الله [ صلى الله عليه وسلم ] إلى موضع بالبادية قريب من مكة ، فإذا أرض يابسة حولها مسيل ، فقال : من ههنا تخرج الدابة .(@)(@@) 1279 - وذكر أحمد بن سنان المروزي ، قال : حدثني أبو عصمة أحمد بن عبد ربه ، قال : حدثنا خارجة بن مصعب ، قال : أخبرني أبي ، أنه شهد عليا يوم النهر ، فقال : اطلبوا ذا العضيدة .(@)(@@) سمعت العباس يقول : سمعت يحيى يقول : رواد أبو عصام ، ليس به بأس ، إنما غلط في حديث سفيان . PageV02P737(@)(@@)(@@)(@@) ||| ( حرف الطاء في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عطاء ، وأبو عطية ، وأبو العطوف ، وأبو عطاف ] )(@)(@@)(@@)(@@) $ * أبو عطاء يزيد بن عطاء السكسكي .(@)(@@)(@@)(@@) $ * وأبو عطاء خليفة بن عبد الواحد .(@)(@@)(@@)(@@) $ * وأبو عطية جبير بن عطية .(@)(@@)(@@)(@@) $ * وأبو عطية الوداعي مالك بن عامر ، حدث عنه : ابن سيرين .(@)(@@)(@@)(@@) $ * وأبو عطية عمرو بن [ أبي ] جندب .(@)(@@)(@@)(@@) $ * وأبو العطوف الجراح بن المنهال ، ضعيف .(@)(@@)(@@)(@@) $ * [ وأبو عطاف ] .(@)(@@) 1280 - حدثنا محمد بن عوف ، قال : حدثنا أبو اليمان ، قال : حدثنا ابن عياش ، عن يزيد بن سعيد ، عن أبي عطاء يزيد بن عطاء السكسكي ، عن معاذ بن سعد السكسكي ، عن جنادة بن أبي أمية ، أنه سمع عبادة بن الصامت يذكر ، أن رجلا أتى النبي 
ms375	 [ صلى الله عليه وسلم ] ، فقال : يا رسول الله ! ما أمد أمتك من الرخا ؟ فلم يرد عليه شيء ، حتى سأله ثلاث مرات كل ذلك لا يجيبه ، فانصرف الرجل ، فقال النبي [ [ صلى الله عليه وسلم ] ] : أين السائل ؟ فردوه عليه فقال : سألتني عن شيء ما سألني عنه أحد من أمتي ؟ PageV02P738 مدة أمتي من الرخاء مائة سنة ، قالها مرتين أو ثلاثا ، فقال رجل : يا رسول الله ! فهل لذلك من أمارة أو علامة أو آية ؟ قال : نعم . الخسف ، والرجفة ، وترسل الشياطين الملجمة على رؤوس الناس .(@)(@@) 1281 - حدثنا محمد بن عوف ، قال : حدثنا أبو عبد الرحمن المقرئ ، قال : حدثنا أبو عطاء خليفة بن عبد الواحد الحرسي ، عن أشعث بن عبد الملك ، عن الحسن : في جنب اغتسل ولن يتمضمض ولم يستنشق وصلى ، قال : لا إعادة عليه .(@)(@@) سمعت العباس بن محمد ، عن يحيى بن معين قال : أبو عطاف بصري ، يروي عنه : الجريري ، قلت له : فيروي عنه غير الجريري ؟ قال : لا أعلمه .(@)(@@) وأبو عطية الذي يروي عنه : محمد بن سيرين ، اسمه : مالك بن عامر .(@)(@@) وأبو عطية الوادعي عمرو بن أبي جندب .(@)(@@) وفي موضع آخر : أبو عطية الوادعي مالك بن عامر ، وهو الهمداني .(@)(@@) قال : أبو العطوف اسمه الجراح بن المنهال .(@)(@@) 1282 - أخبرني محمد [ بن إسماعيل ] بن إبراهيم ، عن أبيه ، عن محمد بن عمر ، قال : أبو عطية عمرو بن جندب ، ويقال : مالك بن عامر الهمداني ، من أصحاب عبد الله شهد مشاهد علي رضي الله عنه ، هلك في ولاية عبد الملك . PageV02P739(@)(@@) 1283 - أخبرني أبو علاثة عمرو بن خالد ، عن أبيه ، قال : قلت لأبي العطوف الجراح بن المنهال في الحمام ، رأيت أنس بن مالك ، قال : شهدت جنازته .(@)(@@) قال أبي : وكان العطوف قاضي العباس بن محمد أخي أبي جعفر . PageV02P740 (@)(@@)(@@)(@@) ||| ( حرف الفاء في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عفان ، وأبو عفراء ] )(@)(@@)(@@)(@@) $ * أبو عفان غالب بن خطاف القطان .(@)(@@)(@@)(@@) $ * وأبو عفان عثمان بن خالد .(@)(@@)(@@)(@@) $ * وأبو عفراء صالح بن عبد الله بن أبي فروة ( 2 / 33 ) .(@)(@@) 1284 - حدثنا عبيد الله بن عبد الكريم أبو زرعة الرازي ، قال : حدثنا سعيد 
ms376	 بن محمد قال : حدثنا عثمان بن خالد أبو عفان ، قال : أخبرني عبد الله ابن عمرو بن وهب مولى زيد بن ثابت ، عن أبيه ، عن خارجة بن زيد ، عن زيد ابن ثابت ، قال : قال رسول الله [ صلى الله عليه وسلم ] : [ ما ] كان بين عثمان ورقية وبين لوط من مهاجر . [ الحديث ] . PageV02P741(@)(@@)(@@)(@@) ||| ( حرف القاف في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو عقيل )(@)(@@)(@@)(@@) $ * أبو عقيل الدورقي بشير بن عقبة ، روى عنه : عبد الرحمن بن مهدي .(@)(@@)(@@)(@@) $ * وأبو عقيل يحيى بن المتوكل .(@)(@@)(@@)(@@) $ * وأبو عقيل زهرة بن معبد بن عبد الله بن هشام .(@)(@@)(@@)(@@) $ * وأبو عقيل واقع بن سحبان .(@)(@@)(@@)(@@) $ * وأبو عقيل هاشم بن بلال [ الدمشقي ] ، قاضي واسط .(@)(@@)(@@)(@@) $ * وأبو عقيل معمر الجرمي ، ابن عم أبي قلابة .(@)(@@)(@@)(@@) $ * وأبو عقيل عبد الله بن عقيل الثقفي كوفي .(@)(@@)(@@)(@@) $ * وأبو عقيل محمد بن عمر بن الفضل ، يروي عنه : عمرو بن علي .(@)(@@)(@@)(@@) $ * وأبو عقيل حبان بن الحارث ، [ قال ] : أتيت علي بن أبي طالب عليه السلام ، روى عنه : شبيب بن غرقدة .(@)(@@)(@@)(@@) $ * [ وأبو عقيل يحيى بن حبيب بن إسماعيل ] .(@)(@@)(@@)(@@) $ * وأبو عقال هلال بن يزيد ، يروي حديث عسقلان .(@)(@@)(@@)(@@) $ * [ وأبو عقبة جابر بن قطن ] .(@)(@@) 1285 - حدثنا عمرو بن علي ، قال : حدثنا أبو قتيبة ، قال : حدثنا أبو عقيل بشير بن عقبة ، قال : حدثنا أبو نضرة ، قال : قدم علينا طلحة والزبير PageV02P742 فما رأيت رجلين أشبه بما وصف الله جل ثناؤه في كتابه منهما ، تعرف نعت الله فيهما .(@)(@@) حدثني عبد الله بن أحمد ، قال : سمعت أبي يقول : أبو عقيل الدورقي بشير بن عقبة .(@)(@@) 1286 - حدثنا محمد بن عبد الله بن عبد الحكم ، والربيع بن سليمان الجيزي ، قالا : حدثنا أبو زرعة قال : حدثنا حيوة ، قال : حدثنا أبو عقيل زهرة بن معبد بن عبد الله بن هشام ، أنه سمع عبد الله بن هشام ، يقول : كنا مع رسول الله [ صلى الله عليه وسلم ] ، وهو آخذ بيد عمر بن الخطاب رضي الله عنه ، فقال عمر : والله لأنت يا رسول الله أحب إلي من كل شيء إلا نفسي ، فقال له رسول الله [ صلى الله عليه وسلم ] : لا والذي نفسي 
ms377	 بيده ، حتى أكون أحب إليك من نفسك ، فقال عمر : لأنت الآن أحب والله إلي من نفسي ، فقال رسول الله [ صلى الله عليه وسلم ] : الآن يا عمر .(@)(@@) 1287 - أخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، عن يحيى بن آدم ، قال : حدثنا أبو عقيل ، وهو يحيى بن المتوكل ، وكان بالمدينة ، ثم تحول إلى الشام ، وأثنى عليه أبو بكر بن عياش ، عن القاسم بن عبيد الله ، عن سالم بن عبد الله ، عن أبيه ، قال رسول الله [ صلى الله عليه وسلم ] : ليس منا من غشنا .(@)(@@) 1288 - أخبرني أحمد بن شعيب ، قال : أنبأ عمرو بن علي ، قال : حدثنا محمد بن عمر بن الفضل أبو عقيل شيخ ثقة ، قال : حدثنا كعب بن PageV02P743 جراد ، قال : سمعت أبا الدرداء ، يقول : محجوب عن كرامة الله من جر إزاره .(@)(@@) 1289 - حدثنا محمد بن عبد الله بن يزيد ، قال : حدثنا أبي ، قال : حدثنا حيوة بن شريح ، قال : حدثنا أبو عقيل زهرة بن معبد ، عن عمه ، عن عقبة بن عامر الجهني ، عن عمر بن الخطاب ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من توضأ فأحسن الوضوء ، ثم رفع بصره إلى السماء ، ثم قال : أشهد أن لا إله إلا الله وحده لا شريك له ، وأشهد أن محمدا عبده ورسوله ، فتحت له ثمانية أبواب من الجنة .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو عقيل هاشم بن ( 2 / 34 ) بلال قاضي واسط ، يحدث عنه : شعبة وهشيم ، ثقة .(@)(@@) وأبو عقيل صاحب بهية اسمه : يحيى بن المتوكل ، ليس حديثه بشيء .(@)(@@) وأبو عقيل الدورقي ، ثقة ، وهو بشير بن عقبة .(@)(@@) وأبو عقيل زهرة بن معبد [ المدني ، روى عنه : حيوة بن شريح والليث ] .(@)(@@) [ أخبرني عبد الله بن أحمد ، عن أبيه ، قال : أبو عقيل عبد الله بن عقيل الثقفي : ثقة ] . PageV02P744(@)(@@) حدثنا إبراهيم بن مرزوق ، قال : حدثنا مسلم بن إبراهيم ، عن أبي عقيل بشير بن عقبة ، قال : حدثنا أبو نضرة ، قال : إبراهيم بن مرزوق .(@)(@@) 1290 - وحدثنا أبو بكر بن أبي الدنيا ، قال : حدثني محمد بن 
ms378	 الحسين ، قال : حدثني أبو عقيل قال : سمعت مطرف الشقري ، يقول لعبد العزيز بن سليمان : رأيت فيما يرى النائم ، كأن قائلا يقول في وسط مسجد البصرة : قطع ذكر الموت قلوب الخائفين ، فوالله ما تراهم إلا والهين ، قال : فخر عبد العزيز مغشيا عليه ، وكان مطرف يختم القرآن في كل يوم وليلة .(@)(@@) 1291 - أخبرني أحمد بن شعيب ، عن محمود بن غيلان ، قال : حدثنا أبو النضر هاشم بن القاسم ، قال : حدثنا أبو عقيل الثقفي عبد الله بن [ عقيل ، عن عبد الله بن يزيد ، عن ربيعة بن يزيد الدمشقي ، وعطية بن قيس ، عن عطية بن ] سعد ، وكان من أصحاب النبي [ صلى الله عليه وسلم ] ، أن رسول الله [ صلى الله عليه وسلم ] قال : لا يكون الرجل من المتقين حتى يدع ما لا بأس به ، حذرا لما به البأس .(@)(@@) 1292 - أخبرني أبو جعفر العقيلي ، قال : أنبأ محمد بن عيسى ، قال : حدثنا أبو عقيل يحيى بن حبيب بن إسماعيل بن عبد الله بن حبيب بن أبي ثابت قال : حدثنا عمي ، قال : حدثنا جرير بن عبد الحميد ، عن الأعمش ، قال : كان حبيب بن أبي ثابت عروس القراء .(@)(@@) قال أبو بكر بن عياش : مات حبيب بن أبي ثابت في شهر رمضان سنة تسع عشرة ومائة .(@)(@@) وأبو عقبة جابر بن قطن ، قال : رأيت ثابتا . PageV02P745(@)(@@)(@@)(@@) ||| ( حرف اللام في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو علي )(@)(@@)(@@)(@@) $ * أبو علي الحسين بن عياش بن عمر أبي وائل ، يروي عنه : أبو الأحوص .(@)(@@)(@@)(@@) $ * وأبو علي الحسين بن عمران ، روى عنه : الثوري .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن علي بن الحسن البراد ، مديني .(@)(@@)(@@)(@@) $ * وأبو علي الحسين بن يزيد الكوفي .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن محمد بن أعين الحراني ، يروي عن : معقل بن عبيد .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن [ حماد ] سجادة .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن خمير الحرازي ، يروي عنه : عمران بن بكار .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن عبد العزيز الجروي ، عن : بشر بن بكر ، ويحيى بن حسان .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن موسى الأشيب .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن واقع [ الرملي ] ، يروي عن : ضمرة بن ربيعة .(@)(@@)(@@)(@@) $ * وأبو علي 
ms379	 الحسن بن بشر .(@)(@@)(@@)(@@) $ * وأبو علي الحسن بن الربيع .(@)(@@) 1293 - أخبرني أحمد بن شعيب ، قال : أنبأ عبيدة بن الطيب النسائي قال : حدثنا الحسن بن بشر أبو علي ، قال : حدثنا المعافى بن عمران ، PageV02P746 عن ابن جريج ، عن أبي الزبير ، عن جابر ، أن رسول الله [ صلى الله عليه وسلم ] أبى أن يأكل الضب ، وقال : لا أدري لعله من القرون الأولى التي مسخت .(@)(@@) 1294 - حدثنا أحمد بن شعيب ، قال : حدثني إسماعيل بن المتوكل ، قال : حدثنا الحسن بن الربيع أبو علي ، قال : حدثنا فضل بن مهلهل ، عن حبيب بن أبي عمرة ، قال : أتيت سعيد بن جبير ، فقال لي : ما جاء بك لعلك جئت تقاضاني ، قلت : جئت لأتحدث كما كنت أتحدث ، قال : فلاتقاضاني حتى أقضيك ، فإني سمعت ابن عباس يحدث ، عن النبي [ صلى الله عليه وسلم ] : أنه من مشى إلى أخيه بحقه كان له ( 2 / 35 ) صدقة : وكل معروف صدقة .(@)(@@)(@@)(@@) $ * وأبو علي الحسين بن [ قيس ] الرحبي ، وهو [ حنش ] .(@)(@@)(@@)(@@) $ * وأبو علي الحسين بن واقد .(@)(@@)(@@)(@@) $ * وأبو علي الحسين بن زياد .(@)(@@)(@@)(@@) $ * وأبو علي حسان .(@)(@@)(@@)(@@) $ * وأبو علي حرمي بن حفص .(@)(@@) 1295 - حدثني عبد العزيز بن منيب أبو الدرداء المروزي ، قال : سمعت أبا معاذ النحوي الفضل بن خالد ، قال : سمعت أبا علي الحسين بن واقد ، يقول : قدمت على الأعمش فقرأت عليه [ القرآن ] ، فما أخذ علي حرفا واحدا ، وقال : ما قدم علينا علج من خراسان أقرأ منك فأنكرت قوله علج ، فقال : لا تنكر إنما العلج عندنا : الرجل ، إذا قبض على اللحية . PageV02P747(@)(@@) 1296 - أخبرني أحمد بن شعيب ، قال : أنبأ عمرو بن منصور ، قال : حدثنا حسان أبو علي ، قال : حدثنا يعقوب ، عن عمرو بن أبي عمرو ، عن العلاء بن عبد الرحمن ، عن أبيه ، عن أبي هريرة ، أن رسول الله [ صلى الله عليه وسلم ] قال لعبد الله بن عمرو : وكيف بك يا عبد الله ! إذا كنت في حثالة من الناس ، وقد مرجت أماناتهم وعهودهم ، واختلفوا ، فكانوا هكذا ، وأدخل بعض أصابعه في بعض ، قال عبد الله : فكيف تأمرني يا رسول الله ؟ فقال رسول الله [ صلى الله 
ms380	 عليه وسلم ] : تعمل ما تعرف ، وتدع ما تنكر ، وتعمل بخاصة نفسك ، وتدع عنك عوام الناس .(@)(@@)(@@)(@@) $ * وأبو علي إسماعيل بن نشيط .(@)(@@)(@@)(@@) $ * وأبو علي جعفر بن ميمون .(@)(@@)(@@)(@@) $ * وأبو علي ثمامة بن شفي .(@)(@@)(@@)(@@) $ * وأبو علي سنيد بن داود .(@)(@@)(@@)(@@) $ * وأبو علي الفضيل بن عياض .(@)(@@)(@@)(@@) $ * وأبو علي فضيل بن عيسى ، يروي عن : أبي عوانة .(@)(@@) 1297 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن سهل بن عسكر ، قال : حدثنا القاسم بن كثير ، قال : سمعت عبد الرحمن بن شريح ، عن أبي علي إسماعيل بن نشيط ، قال : سمعت سعد بن مسعود ، في قول الله جل وعز : ' إنا أطعنا سادتنا وكبراءنا فأضلونا السبيلا قال : إن السادة : الملوك ، والكبراء : العلماء . PageV02P748(@)(@@) سمعت أبا زرعة عبيد الله بن عبد الكريم ، قال : سنيد بن داود كنيته أبو علي .(@)(@@) أخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، قال : حدثنا الفضيل بن عياض أبو علي .(@)(@@)(@@)(@@) $ * وأبو علي عبيد بن علي .(@)(@@)(@@)(@@) $ * وأبو علي [ عبد الله ] بن عبد المجيد الحنفي بصري .(@)(@@)(@@)(@@) $ * وأبو علي عبد الرحيم بن سليمان الرازي .(@)(@@)(@@)(@@) $ * وأبو علي عيسى بن دينار .(@)(@@)(@@)(@@) $ * وأبو علي عثام بن علي .(@)(@@)(@@)(@@) $ * وأبو علي عمرو بن فائد القدري .(@)(@@)(@@)(@@) $ * وأبو علي عبد الرحمن بن بحر الخلال .(@)(@@)(@@)(@@) $ * وأبو علي عمرو بن مالك الجنبي ، يحدث عنه : أبو هانئ الخولاني .(@)(@@) 1298 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن سهل بن إسماعيل أبو بكر الطبراني ، قال : حدثنا عبد الرحمن بن بحر أبو علي الخلال ، قال : أنبأ مبارك بن سعيد ، قال : حدثنا يحيى بن أبي كثير ، قال : حدثني عكرمة ، أن امرأته أخبرته ، أن عائشة أم المؤمنين أخبرتها ، أن رسول الله [ صلى الله عليه وسلم ] قال : تقطع اليد في المجن . PageV02P749(@)(@@) 1299 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : أنبأ عبد الله بن المبارك ، عن عيسى بن دينار أبي علي ، قال : سمعت أبي يقول : سمعت عمرو بن الحارث يقول : سمعت عبد الله بن مسعود ، يقول : ما صمت مع رسول الله [ صلى الله عليه وسلم ] تسعة وعشرين أكثر مما صمت معه ثلاثين .(@)(@@)(@@)(@@) $ * وأبو علي محمد 