ms541	(@)(@@) % خوارج مثل أنضية المغالي % % حدا أعجازها الريش الظهار % % PageV01P2129 البحر : - 1(@)(@@) % من كان من طالبي الأنباء يسألني % % عن الكلاب لماذا تنبح القمرا % % 2(@)(@@) % فليس يعرف لم ينبحنه أحد % إلا امرؤ كان كلبا مثلها عصرا % % 3(@)(@@) % وهو المكنى أباه بعد مهلكه % بطاهر ولعمر الله ما طهرا % % 4(@)(@@) % فسائلوه لماذا كان ينبحه % فإن صاحبكم يوفيكم الخبرا % % PageV01P2130 البحر : - 1(@)(@@) % أبا منذر بالله إلا صدقتني % % علام ولم خنثتني يا أخا النضر % 2(@)(@@) % أذمت لقائي حرمة لك نكتها % % فلم أشفها أم قلت ما قلت بالحزر % % 3(@)(@@) % فكيف وألحاظي حداد كأنها % % نصال وألفاظي أشد من الصخر % % 4(@)(@@) % وكيف ولي في كل عضو ومفصل % وجارحة قلبان شهمان من جمر % % 5(@)(@@) % ولو عزمت نفسي على قطع لجة % من البحر سبحا ما نكلت عن البحر % 6(@)(@@) % ولو مس ثوبي ثوب أمك مسة % لأولدها خمسين مثلك في شهر % % 7(@)(@@) % فأية آياتي وأي أدلتي % % تدل على التخنيث يا ابن أبي عمرو % % 8(@)(@@) % بعيني ربوخ في استها أير نائك % % نظرت ولم تنظر بناظرتي صقر % % 9(@)(@@) % أراك خلاف الحق رأي بمثله % % كفرت وعلقت الصليب على النحر % % 10(@)(@@) % وما كان من لا يقدر الله قدره % ويشفعه بابن ليقدرني قدري % % PageV01P2131 11(@)(@@) % فإن كنت في ريب ولم تر آية % تبين ما قد لبس الشك من أمري % % 12(@)(@@) % فجرب على إحدى بناتك فحلتي % % متى شئت فالتجريب أثلج للصدر % % 13(@)(@@) % فلو لقيتني بكرهن لقاءة % لما نسيت أيري إلى آخر الدهر % % PageV01P2132 البحر : - 1(@)(@@) % منع المخنث أحمد % قسي عمارة ديره % 2(@)(@@) % تيها بأن ملك الحما % % ر عدمت قلة خيره % % 3(@)(@@) % وأظن بالمأبون ظن % نا لا أظن بغيره % % 4(@)(@@) % ما تاه أن ملك الحما % % ر بل استعف بأيره % % PageV01P2133 البحر : - 1(@)(@@) % يا من إذا ما رأته عين والده % % بين الرجال أتقاهم بالمعاذير % % 2(@)(@@) % أقسمت بالله أن لو كنت لي ولدا % لما جعلتك إلا في المطامير % 3(@)(@@) % عليك وجه كساه الله لعنته % كأن خرطومه خرطوم خنزير % % 4(@)(@@) % وما استفدت من الديوان فائدة % فيما علمنا سوى نشر الطوامير % % 5(@)(@@) % أنت فضل وفضلة الشيء لغو % % ثم 
ms542	 أردفت ذلة التصغير % 6(@)(@@) % حقر الفضل ثم صغر عنه % % زادك الله ياصغير الحقير % % 7(@)(@@) % ثم أعرجت فاحتواك انتقاص % في است سوء وجسم سوء ضرير % % 8(@)(@@) % ثم بردت فانتصفت من النا % % ر ببرد يربي على الزمهرير % % 9(@)(@@) % فقبول النفوس إياك عندي % % آية فيك للطيف الخبير % % 10(@)(@@) % إن قوما أصبحت تنفق فيهم % % لعلى خطة من التسخير % PageV01P2134 11(@)(@@) % أو أناس غدوا وراحوا من الظر % % ف على حالة الفقير الوقير % % 12(@)(@@) % فمتى ظفروا بزور ظريف % أعجبتهم زخارف التزوير % % 13(@)(@@) % كالأعاريب لم يروا درمك البر % % ر فهم يكبرون خبز الشعير % % 14(@)(@@) % وكذا القوم لم يروا لجة البح % % ر فهم يعظمون ماء الغدير % 15(@)(@@) % ياثقيلا على القلوب خفيفا % في الموازين دون وزن النقير % % 16(@)(@@) % طرسخيفا وقع مقيتا فطورا % كسفاة وتارة كثبير % % 17(@)(@@) % أشهد الله أن وزنك عندي % % دون وزن النقير والقطمير % % 18(@)(@@) % لست حاشاك بالحقير ولكن % % أنت لاشك من حقير الحقير % % PageV01P2135 البحر : - 1(@)(@@) % أتت من بريدينا ضرطة % فأرسلها مثلا سائرا % % 2(@)(@@) % كذا إل وهب لهم فضلهم % % يورثه أول آخرا % % 3(@)(@@) % مضوا بلغاء بأفواههم % % وأستاههم كابرا كابرا % % 4(@)(@@) % وأبقوا لنا خلفا صالحا % فلم يلف عن قصدهم جائرا % 5(@)(@@) % أبا حسن يا لها ضرطة % تركت السمير بها سامرا % % 6(@)(@@) % وزدت بها شاعرا فطنة % وأنبغت من لم يكن شاعرا % % PageV01P2136 البحر : - 1(@)(@@) % أتت من بريدينا فلتة % فصك بها الناس أقصى حجر % 2(@)(@@) % لئن شنع الناس في أمره % % لذاك بتشنيعه في الخبر % % 3(@)(@@) % أبا حسن قد جرت عادة % فحاذر وأعتد عتاد الحذر % % 4(@)(@@) % ولا تحضر الدار في الحاضري % % ن إلا وأنت وثيق الثفر % % 5(@)(@@) % وأعف حتارك واستبقه % % فقد وسعته ضخام الكمر % % PageV01P2137 البحر : - 1(@)(@@) % زلزلت ضرطته بالصيمره % فأعادت كل دار مقبره % 2(@)(@@) % وأما لولا محاباة الفتى % % لأبيه كان فيمن دمره % % 3(@)(@@) % ضرطة حابت أبا ضارطها % % أثبتوها في البنين البرره % % 4(@)(@@) % واحذروا ضرطة وهب بعدها % % إنها ريح عقيم منكره % % PageV01P2138 البحر : - 1(@)(@@) % جدك شيبان العظيم الفخر % حقا كما البلبل جد الصقر % % 2(@)(@@) % نجر لعمري بائن من نجر % % لم تظلم الدنيا بأم دفر % % 3(@)(@@) % وأنت 
ms543	 فيها من ولاة الأمر % % لولا دليل كبياض الفجر % % 4(@)(@@) % يشرح بالإيمان كل صدر % % لقلت بالدهر كأهل الدهر % % 5(@)(@@) % مما أرى من سوء هذا القدر % % وليس لي في عاجل من صبر % % PageV01P2139 البحر : - 1(@)(@@) % رأيتك لم تحسن ثوابي ولم تجب % كتابي فماذا كان في الخلق والأمر % % 2(@)(@@) % لعمري لقد علمتني كيف أتقي % % معاودة التجريب إن كنت ذا حجر % % 3(@)(@@) % وقبحت عندي صورة الحرص والغنى % % وحسنت عندي صورة اليأس والفقر % % 4(@)(@@) % أما وحذاري من أماني بعدها % % لقد مكرت بي فعلتي أيما مكر % % 5(@)(@@) % دعتني إلى لمس الكواكب قاعدا % وذلك شيء لا يكون يد الدهر % % 6(@)(@@) % دع البذل لم خستني أن لم تجيبني % % جوابي ولم أهبطت قدري إلى القعر % % 7(@)(@@) % أكنت خسيس القدر لم حصت حيصة % عن الفضل أعدتك الخساسة في القدر % % 8(@)(@@) % فهلا بذلت الوعد ثم مطلته % فعللت تعليل المجامل ذي المكر % % 9(@)(@@) % ولكن رأيت الحسم للبذل كله % % صوابا لأن الرعد يؤذن بالقطر % % 10(@)(@@) % أذلك أم هلا منعت مصرحا % فأيأستني لكن خلقت من الصخر % % PageV01P2140 11(@)(@@) % جمودا وصمتا لابرحت كما أرى % % وهاتيك لو أحسست فاقرة الظهر % % 12(@)(@@) % وفي دعوتي عقر أليم مضيضه % أبا جعفر لو كنت تألم من عقر % 13(@)(@@) % أبا جعفر صبرا فما زلت صابرا % على الذم لاتعدم ذميما من الصبر % % PageV01P2141 البحر : - 1(@)(@@) % الحمد لله لا شريك له % مدبر الأمر منزل القطر % 2(@)(@@) % عضدت يا بنين أصبحا لك في الت % % تدبير مثل اليدين للظهر % 3(@)(@@) % وشكرها ذاك أن تقيل وأن % % تصفح يا ذا السناء والفخر % 4(@)(@@) % يا أكمل الناس في فضائله % % من أهل بدو وساكني حضر % 5(@)(@@) % بحق من تجب الحقوق له % من هاشمييك أنجم الدهر % 6(@)(@@) % صلنا بأن تكمل الرضا لأبي % % إسحاق تسعد بالحمد والأجر % 7(@)(@@) % وهبت شطر الرضا له فهب ال % % كل فليس الكمال في الشطر % % 8(@)(@@) % قد فاز بالمجلس الشريف فبد % دله بلحظ الرضا من الشزر % % 9(@)(@@) % أنت الثقاف الذي يقام به الز % زيغ وأنت المقيل للعثر % % 10(@)(@@) % أنت الذي أنزلته همته % منزلة الفرقدين والنسر % PageV01P2142 11(@)(@@) % وأنت في عفة السريرة 
ms544	 وال % % علم شبيه بجدك الحبر % 12(@)(@@) % ما نعمة الله فيه راضية % صدك عنه بوجهك النضر % 13(@)(@@) % كم قائل حين قيلإن أبا % % إسحاق غاد غدا مع السفر % 14(@)(@@) % ما مثل داك الفتى يعرض لل % % بر وآفاته ولا البحر % % 15(@)(@@) % أما ونعماك إنها قسم % قام مقام اليمين والنذر % % 16(@)(@@) % لاأدع النصح ما استطعت وإن % % لاقيتني بالعبوس والزجر % % 17(@)(@@) % إني شهيد بأنك اليوم إن % غاب فواقا فجعت بالصبر % % 18(@)(@@) % وكيف بالصبر وامتزاجكما % % مثل امتزاج الزلال والخمر % % 19(@)(@@) % صنه عن العنف إن مغمزه % من عودك اللدن لا من الصخر % % 20(@)(@@) % وفي تعدي الحدود مفسدة % وليس كل الأمور بالقسر % % PageV01P2143 21(@)(@@) % أما ترى العود إن عنفت به % % جاوزت تقويمه إلى الكسر % % 22(@)(@@) % ولست من يكسر الصحيح ألا % بل جابر الكسرجابرالفقر % % 23(@)(@@) % ما زلت ضد الزمان تصلح ما % % يفسد مذ كنت من بني العشر % % 24(@)(@@) % تجبر ما تكسر الحوادث فال % % كسر عليها وأنت للجبر % % 25(@)(@@) % خذها عروسا لا أقتضيك لها % % غير الرضا عن فتاك من مهر % % 26(@)(@@) % وإن تماديت في مساءتنا % % فيه شكونا إلى أبي الصقر % % PageV01P2144 البحر : - 1(@)(@@) % كبرت وفي خمس وخمسين مكبر % % وشبت فألحاظ المها منك نفر % 2(@)(@@) % إذا ما رأتك البيض صدتوربما % % غدوت وطرف البيض نحوك أصورص وما ظلمتك الغانيات بصدها % % 3(@)(@@) % وإن كان من أحكامها ما يجور % % أعر طرفك المرآة وانظر فإن نبا % % 4(@)(@@) % بعينيك عنك الشيب فالبيض أعذر % % إذا شنئت عين الفتى وجه نفسه % % 5(@)(@@) % فعين سواه بالشناءة أجدر % % ن % PageV01P2145 البحر : - 1(@)(@@) % أبو عثمان والرمي % ي من غاشية القصر % % 2(@)(@@) % يهيمان إلى القصر % % طوال الدهر والشهر % % 3(@)(@@) % يفران من الكاس % % ونغم العود والزمر % % 4(@)(@@) % إلى قفر من الأرض % % وما يصنع بالقفر % % 5(@)(@@) % مع الهدهد والبل % % بل والصلصل في وكر % 6(@)(@@) % ويكتنان بالأكوا % % خ والرمضاء كالجمر % % 7(@)(@@) % مغان لم يكن يصبو % % إليهن ذوو الحجر % % 8(@)(@@) % فهلا آثرا القينا % % ت في الدر وفي الشذر % % 9(@)(@@) % وصهباء لها طوق % شبيه اللؤلؤ الحدر % % 10(@)(@@) % كمثل النار في النور % % ومثل المسك في النشر % % PageV01P2146 11(@)(@@) % كما آثرها السي % % يد 
ms545	 وابن السيد الغمر % % 12(@)(@@) % شهنشاه خراسان % أخو العزة والقهر % % 13(@)(@@) % خذاهان خذاهان % خذاهان إلى الحشر % % 14(@)(@@) % أبو بكر أبو بكر % أبو بكر ابوبكر % 15(@)(@@) % أبو البرق أبو الرعد % أبو الريح أبو القطر % % 16(@)(@@) % أبو الحزم أو العزم % % أبو الدهي أبو المكر % % 17(@)(@@) % أخو النجدة والبأس % % أخو الإقداموالصبر % % 18(@)(@@) % أخو الهامة والقام % % ة والشدة في الأسر % 19(@)(@@) % أخو العز أخو الجاه % % أخو المال أخو الوفر % % 20(@)(@@) % فتى التعزيم والطب % فتى التنجيم والزجر % % PageV01P2147 21(@)(@@) % فتى الإعراب والإغرا % % ب في النظم وفي النثر % % 22(@)(@@) % فتى الخط فتى الضبط % % فتى النهي فتى الأمر % % 23(@)(@@) % فتى يغرف من بحر % % فتى يقلع من صخر % % 24(@)(@@) % فتى الشطرنج والنرد % % فتى الفلج فتى القمر % % 25(@)(@@) % وما أدراك ما الليث % % وما غرك بالببر % % 26(@)(@@) % وما أدراك ما السيل % % وما غرك بالبحر % % 27(@)(@@) % وما أدراك بالموت % % وما غرك بالدهر % % 28(@)(@@) % لسان الملك في البدو % % لسان الملك في الحضر % % 29(@)(@@) % إذا أوفى على المن % % بر مثل القمر البدر % % 30(@)(@@) % وقد سربل بالليل % % وقد برقع بالفجر % % PageV01P2148 31(@)(@@) % سواد فيه وضاح % % كريم الخيم والنجر % % 32(@)(@@) % على هامته شاشي % ية سوداء كالنسر % % 33(@)(@@) % وقد أصغى له الناس % % وجلى نظر الصقر % % 34(@)(@@) % وقد جهور في الصوت % % بصدر أيما صدر % % 35(@)(@@) % وكم أنفق في الحمد % % وكم أنفق في الأجر % % 36(@)(@@) % وكم أحصى له المحصو % % ن بالعد وبالحزر % % 37(@)(@@) % ثوابا منه كالريع % % لمدح فيه كالبذر % % 38(@)(@@) % ألا هاتيكم العليا % % ء والفخر لدى الفخر % % 39(@)(@@) % أنا ابن الطالقاني % وقد أنذرت بالزأر % % 40(@)(@@) % فقلللمتحدي % قصاراكم على السبر % % PageV01P2149 41(@)(@@) % فما أصبحت من بأس % ولا شعري بذي فقر % % 42(@)(@@) % وما مثلي من قيس % بأهل الغدر والختر % % 43(@)(@@) % برومي وبصري % % وما المصر من الكفر % % 44(@)(@@) % من الروم من البصر % % ة ذات المد والجزر % % 45(@)(@@) % وما الضليل كالهادي % % ولا الجاهل كالحبر % % 46(@)(@@) % أنا المبطن في السر % % كما أظهر في الجهر % 47(@)(@@) % أبيتالملق الكا % % ذب خوف الضرس والظفر % % 48(@)(@@) % فلا ظهر سوى بطن % % ولا بطن سوى ظهر % % 49(@)(@@) % أنا المعتاض من جوب % فيافي الأرض 
ms546	 بالجمر % % 50(@)(@@) % ملوكي بعيد الرأ % % ي من زيغ ومن عثر % % PageV01P2150 51(@)(@@) % قياني جواد الكف % ف بالمهر وبالجذر % % 52(@)(@@) % وقدما فاز من سم % مح بالجذر وبالمهر % % 53(@)(@@) % أسر البيض بالوصل % % وأشجي البيض بالهجر % % 54(@)(@@) % قسمت الدهر شطرين % % فللثغروللثغر % 55(@)(@@) % فبأس لي في شطر % ولهو لي في شطر % % 56(@)(@@) % وفي صوتي كالبم % وكالزير وكالنبر % % 57(@)(@@) % أنا الفحل أنا الفحل % % بلا عي ولا هذر % % 58(@)(@@) % عليكم سكتة العي % % ولي شقشقة الهدر % % 59(@)(@@) % ولو صيحت بالجن % للج الجن في الفر % % 60(@)(@@) % وما حربي بالصفو % % ولا سلمي بالكدر % PageV01P2151 61(@)(@@) % أنا المثني على نفسي % % ثناء ليس بالنذر % % 62(@)(@@) % ومن يمدحني بعدي % % بغزر مثل ذا الغزر % % 63(@)(@@) % وما شعر سوى شعري % % بمحض الحسب الدثر % % 64(@)(@@) % ثنائي مسك دارين % وذكري عنبر الشحر % % 65(@)(@@) % ألا من لي بتعويذ % من العين على النحر % % 66(@)(@@) % فقد خفت ولم أظلم % % سهام النظر الشذر % % 67(@)(@@) % على نفس مفداة % ووجه حسن نضر % % 68(@)(@@) % أعيذ النفس بالله % % فإني أسد الهصر % % 69(@)(@@) % أعيذ النفس بالله % % فإني جابر الكسر % % 70(@)(@@) % أعيذ النفس بالله % % فإني علم السفر % % PageV01P2152 71(@)(@@) % أعيذ النفس بالله % % فإني أوحد العصر % % PageV01P2153 البحر : - 1(@)(@@) % وكم معان وألفاظ مهذبة % أرسلتها فقرا تختال في غرر % 2(@)(@@) % وصاحب الشيب ما لم تبل جدته % من صبغه شيبة في عز منتصر % 3(@)(@@) % رأى مظالم شيب في مسائحه % % لم يجنها السن لكن رؤية العبر % % 4(@)(@@) % يضج منها أديم فيه رونقه % ريان ليس عليه آية الكبر % % 5(@)(@@) % واستنجد الفكر محتالا فأنجده % بصبغة نشرت ليلا على الشعر % % 6(@)(@@) % ولا جناح على حام حقيقته % لاظلم في دفع ظلم عند ذي بصر % % 7(@)(@@) % وإنما الظلم منع الشيب لمته % عند انقضاء الشباب اللدن والوطر % % PageV01P2154 البحر : - 1(@)(@@) % أبا الصقر حسب المادحيك إذا غلوا % % أشد غلو أن يقولوا أبا الصقر % % 2(@)(@@) % ملأت يدي جدوى وقلبي مودة % % تدفقتا في المحتدين وفي الصدر % % 3(@)(@@) % أنلت نوالا لو سواك أناله % لآيسني من عودة آخرالدهر % % 4(@)(@@) % لأنك أعطيت الجزيل وإنما % % يرجي المرجي عودة النائل النزر % % 5(@)(@@) % ولكنك المرء الذي لم تزل له % عوائد 
ms547	 بالمعروف والنائل الغمر % % 6(@)(@@) % تنيل الذي لولاك أعيا مناله % وتعطي التي تعطي الأمان من الفقر % % 7(@)(@@) % فلا يحسد الحساد أن سحابة % أظلت بها كفاك مقلعة القطر % % 8(@)(@@) % ولو أن يوما منك يمنع من غد % وإن كان ما أعطيت في اليوم ذا قدر % % 9(@)(@@) % نوالك كالسيل المسهل بعضه % لبعض طريق الجري في السهل والوعر % % 10(@)(@@) % إذا حل قطع منه بالأرض بركه % تديث مجراه لآخر كالبحر % % PageV01P2155 البحر : - 1(@)(@@) % غير الحياة إلى الشعو % % ر سريعة وإلى الثغور % % 2(@)(@@) % فتراهما يتغيرا % % ن وكل عضو ذو وفور % % 3(@)(@@) % هذي تشيب وهذه % % تبلى على مر الشهور % 4(@)(@@) % يسود أبيضها ويب % يض البهيم بغير نور % % 5(@)(@@) % حتى إذا غير المما % % ت أتت على أهل القبور % % 6(@)(@@) % بدأ البلى بسوى الثغو % % ر هنالكم وسوى الشعور % % 7(@)(@@) % فالموت يستبقي الذي % % تبلي الحياة من الأمور % % 8(@)(@@) % والعيش يستبقي الذي % % تبلي المنية غير زور % % PageV01P2156 البحر : - 1(@)(@@) % قد قلت إذ قالوا بجهلهم % ما حب أيرك كوة قذره % % 2(@)(@@) % الأير شبوط ولست ترى % % كمحبة الشبوط للعذره % % PageV01P2157 البحر : - 1(@)(@@) % قلبي من الضيق مما ضم قرقرها % % يحوي افتتانا بما يحويه مئزرها % % 2(@)(@@) % راقت محاسنها عينا أراق دما % بعد الدموع حذار البين محجرها % % 3(@)(@@) % غراء غصت بما فيها دمالجها % % كما شكا قلقا بالقلب قرقرها % % 4(@)(@@) % معسولة الريق يحكي طيب نكهتها % % بعد الكرى وغؤورالنجم منشرها % % 5(@)(@@) % غصن رطيب أعالي خلقها ونقا % % تحت النطاق إذا تهتز يبهرها % % 6(@)(@@) % ماء الشباب بخديها إذا سفرت % جرت به الراح حتى أنت تبصرها % % 7(@)(@@) % يقول لي الناس إذ مال الوشاة بها % % عني وغيرها بعدي مغيرها % % 8(@)(@@) % عليك بالهجر عل الهجر يرجعها % % إلى الوصال ولاأستطيع أهجرها % % 9(@)(@@) % وكيف أهجر من نفسي معلقة % بذكره وهو ناس ليس يذكرها % % 10(@)(@@) % ومن عجائب ما يبلى المحب به % % أني على ذاك أرجوها وأحذرها % % PageV01P2158 البحر : - 1(@)(@@) % أنفس قد ظمئن ليس إلى ال % % ماء ولكن إلى مجاج الثغور % % 2(@)(@@) % وعيون أبين عطفا على الغم % ض اشتياقا إلى لثام البدور % % 3(@)(@@) % وقلوب شفاؤهن من السق % % م نهود الثدي فوق الصدور 
ms548	 % % 4(@)(@@) % وهوى ليس ينقضي ما تثنت % كثب في الغصون فوق الخصور % % PageV01P2159 البحر : - 1(@)(@@) % بين أجفانه عقار تدور % وعلى وجنتيه ورد نضير % 2(@)(@@) % وله بين حلتيه من البا % % ن قضيب حواه دعص وثير % 3(@)(@@) % لو رأته حور الحنان لحارت % % منه في خالص الجمال الحور % 4(@)(@@) % ما لأهل الجفاء في هجره عذ % % ر وفي هجرهم هو المعذور % % PageV01P2160 البحر : - 1(@)(@@) % رأيت جحظة يخشى الناس كلهم % إذا هم عاينوه الفالج الذكرا % % 2(@)(@@) % تخال ما برقاب الناس من ميل % عنه إذا ما تراءى وجهه صعرا % % 3(@)(@@) % وإن تبدى بصوت خر سامعه % للبرد ميتا ولو درعته سقرا % % 4(@)(@@) % تخاله أبدا من قبح منظره % % مجاذبا وترا أو بالعا حجرا % % 5(@)(@@) % كأنه ضفدع في لجة هرم % إذا شدا نغما أو كرر النظرا % % 6(@)(@@) % لو كان لله في تخليدنا قدر % مع قربه ما أردنا ذلك القدرا % % PageV01P2161 البحر : - 1(@)(@@) % يا أيها الموعوظ في لشكوه % % أبصر هداك ففي العظات بصائر % 2(@)(@@) % وإذا قدرت على المظالم فانزجر % أو لا ففي الغير الحوادث زاجر % 3(@)(@@) % ومتى وعظت بعلة فنضوتها % % فاحذر فقد يوفى البلاء الحاذر % % 4(@)(@@) % لا تحدثن لك الإقالة جرأة % فالله من بعد الإقالة قادر % % 5(@)(@@) % وارهب من الأقران قرنا ماله % إلا العواقب والعقوبة ناصر % % PageV01P2162 البحر : - 1(@)(@@) % جزى الله عني قبح وجهي سعادة % كما قد جزاه والإله قدير % 2(@)(@@) % ذعرت به قوما فأدوا إتاوة % كأني عليهم عند ذاك أمير % % 3(@)(@@) % فدى نفسه من قبح وجهي سيد % وزير أبوه سيد ووزير % % 4(@)(@@) % فلا يقطعن الرزق عني قاسم % فليس له مني سواه خفير % % 5(@)(@@) % عرفت له الإجراء وهو صنيعه % وأنكرت منه الهجر وهو نكير % % 6(@)(@@) % وما قدر ما يجري وغيبة وجهه % تطيل علي الليل وهو قصير % % 7(@)(@@) % لرؤيته عندي أجل من الذي % % يحل به من ملكه ويسير % 8(@)(@@) % فلا تجعلن الهجر دأبا فإنه % بإتمام ما أسدى إلي جدير % % 9(@)(@@) % وإلا فما لي حاجة في نواله % % وإني إلى ما دونه لفقير % % 10(@)(@@) % وهل نعمة حتى تكون مودة % وهل روضة حتى يكون غدير % % PageV01P2163 11(@)(@@) % وكل كثير تافه 
ms549	 عند وجهه % وكل كبير غيره فصغير % % 12(@)(@@) % أنائله يغترني عن لقائه % % ومجلسه إني إذا لغرير % % PageV01P2164 البحر : - 1(@)(@@) % دع الفكر في أمري فقدري لا يفي % % بحملك يوما في عبء المفكر % 2(@)(@@) % ولا تتكلف لي التكاليف إنني % % مليء بعذر النائل المتعذر % 3(@)(@@) % ولست كممنوع يرى العذر علة % ولا طالب يسرا بإرهاق معسر % 4(@)(@@) % لك العذر مبسوطا وحق لمن يرى % % ملام مليم أن يرى عذر معذر % 5(@)(@@) % ولكن إذا ما عاد في العود ماؤه % فأورق لمستذري ذراك وأثمر % 6(@)(@@) % هي ابنة حر زوجت منك حرة % فإن مهرت مهرا رغيبا فأجدر % 7(@)(@@) % وإلا فحسبي أن أصون كريمتي % % بكفء كريم مثلك ابن مدبر % % 8(@)(@@) % كفاني مهرا بالكفاءة إنها % % هي المهر للمتمهر المتخير % % 9(@)(@@) % ولو مهر الأحماء صهرا لكنته % ولم تغل بالدنيا على متكثر % % 10(@)(@@) % وأنت بأن تحبى على أن قبلتها % % أحق ولكنا ظلمناك فاغفر % % PageV01P2165 البحر : - 1(@)(@@) % إنفاق أيام الحياة على % % رزق أراصد قبضه خسر % 2(@)(@@) % والربح أجمع في لقاء فتى % بلقائه يستخلف العمر % 3(@)(@@) % كابن الوزير فإنه رجل % لا يستقل بأن يرى شكر % 4(@)(@@) % ملك تراه فلا ترى أبدا % إلا سعودا كلها زهر % % 5(@)(@@) % فاطلب لقاء أبي الحسين ولا % % يلفتك عنه القل والكثر % % 6(@)(@@) % ما في قعودك عنه عند غنى % منحتكه أيامه عذر % 7(@)(@@) % أتعد نائل كفه عوضا % منه لهنك للفتى الغمر % 8(@)(@@) % لا تكفرن الله نعمته % فيه فيسقط حظك الكفر % 9(@)(@@) % أو ليس كفرا أن تقومه % بالقيمة الصغرى لك الصغر % 10(@)(@@) % قومه بالدنيا سعادتها % % وخلودها فلعله العشر % PageV01P2166 11(@)(@@) % واعلم بأن العسر ما منحت % عيناك رؤية قاسم يسر % 12(@)(@@) % واعلم بأن اليسر ما منعت % % عيناك رؤية قاسم عسر % 13(@)(@@) % يا من غدا ذخري لنائبتي % % إذ لا سواه من الورى ذخر % 14(@)(@@) % لا تولني البتراء إنك من % % نجر يشاكل غيره البتر % 15(@)(@@) % واثبت على الحسنى فقد طمحت % نحوي ونحوك أعين خزر % % 16(@)(@@) % وتمام ما أسديت إذنك لي % % أولا فعرفك كله نكر % 17(@)(@@) % كل الصنائع أو يخالطها % % صافي رضاك مناهل كدر % 18(@)(@@) % لا تحسبن جداك أسكرني % % حتى 
ms550	 نسيتك ليس بي سكر % % PageV01P2167 البحر : - 1(@)(@@) % أيادي بني الجراح عندي كثيرة % وأكثر منها أنها لا تكدر % 2(@)(@@) % هم القوم ينسون الأيادي منهم % عليك ولكن المواعيد تذكر % % 3(@)(@@) % وإن كنت قد أهملت بعد رعاية % وأغفلت حتى قيل أشعث أغبر % % 4(@)(@@) % وقلدت شغلا ضره لي معجل % % سريع وأما نفعه فمؤخر % % 5(@)(@@) % أروح وأغدو فيه أنصب عامل % وأصفره كفا فكم أتصبر % 6(@)(@@) % إذا بعت صوني حر وجهي وراحتي % % بجوع فمن مني أتب وأخسر % % 7(@)(@@) % ألا حبذا الأعمال في كل حالة % إذا كان منها وجه نفع ميسر % % 8(@)(@@) % فأما إذا كدت وأكدت على الفتى % % فما هي بالمعروف بل هي منكر % % 9(@)(@@) % وإن أبا عبد الإله لسيد % % وفي الحال لو يعنى بحالي مغير % 10(@)(@@) % وإن له من فضله لمحركا % على أنها الأخلاق قد تتنكر % % PageV01P2168 11(@)(@@) % وإن كان كالإبريز يصدأ غيره % ويأتي عليه ما أتى وهو أحمر % % 12(@)(@@) % سأزجر عنه اللوم من كل لائم % حفاظا له ما دام لي عنه مزجر % 13(@)(@@) % وأعذره ما دام للعذر موضع % وأنظره ما دامت النفس تنظر % % 14(@)(@@) % وأحسبه يوما ستزهاه نفسه % فيفعل في أمري التي هي أفخر % % 15(@)(@@) % ونفس أبي عبد الإله ضنينة % به أن تراه حيث يكدى ويعذر % % 16(@)(@@) % وما هي عن لوم له بمفيقة % % إلى أن تراه حيث يسدى ويشكر % % 17(@)(@@) % أعني أبا عبد الإله ولا تقل % أعنت فأعياني القضاء المقدر % % 18(@)(@@) % ففي الأمر إن عاينته متيسر % وفي الأمر إن آتيته متعذر % % 19(@)(@@) % أيعطش أمثالي وواديك فائض % ويجدب أمثالي وواديك أخضر % % 20(@)(@@) % أبى ذاك أن الطول منك سجية % وأنك بيت المجد بالحمد تعمر % % PageV01P2169 21(@)(@@) % وأنك لم تؤثر على الحق لذة % بحكم هوى فالحق عندك مؤثر % % 22(@)(@@) % وما زلت تختار الأمور بحكمة % فأفضلها الأمر الذي تتخير % % PageV01P2170 البحر : - 1(@)(@@) % أتاني عن جاريك أن قد قطعته % وفي لؤمك المشهور ما شئت من عذر % 2(@)(@@) % فهب ذلك الدينار صاحب طالعي % % من الأنجم السيارة السبعة الزهر % 3(@)(@@) % وأنت الذي تجريه لي وتنيره % وفيه الذي أرجو من الرزق والعمر % 4(@)(@@) % ألست حقيقا بالدعاء بكدرة 
ms551	 % وأن أتلقى ذاك إن كان بالشكر % % PageV01P2171 البحر : - 1(@)(@@) % راجعت بعد الجهل حجرا % وأطلعت زاجرة وزجرا % % 2(@)(@@) % ومن الحوادث أن نس % كت وقد صحبت الفتك عصرا % % 3(@)(@@) % ورأيت ما تجري علي % ي أحق بي عقبا وصدرا % % 4(@)(@@) % ووجدت عيشي في اللئا % % م أعف لي وأخف وزرا % % 5(@)(@@) % فقصدت ربحا حاضرا % ورفضت أمرا كان خسرا % 6(@)(@@) % أغلقت حانوتي لطو % % ل كساده وفتحت عمرا % % 7(@)(@@) % فأفادني فتحي له % جاها ومعروفا وقدرا % % 8(@)(@@) % يا طيلسان الحمدوي % ي لقد شفعت وكنت وترا % % 9(@)(@@) % عمرو أخوك أصبته % لي مكسبا فأفدت وفرا % % 10(@)(@@) % كالحمدوي وكسبه % بل ثروة فينا وذكرى % % PageV01P2172 11(@)(@@) % لا تبعدن من صاحبي % % ن نفيتما ضعة وفقرا % % 12(@)(@@) % يا عمرو صبرا للقصا % % ص بما جنيت علي صبرا % % 13(@)(@@) % بل كل هنيئا كسب أن % % فك قد منحتك منه شطرا % % 14(@)(@@) % لك شطر كسبي كلما % % حبرت في الخرطوم شعرا % % 15(@)(@@) % أحبيت منك بحيلتي % % لك مستغلا كان قبرا % % 16(@)(@@) % فاشكر شريكك إذ جزى % % عرفا وقد أسديت نكرا % % 17(@)(@@) % وسل المفند في هجا % % ئك هل ظلمت الحق سرا % % 18(@)(@@) % أم هل أسأت إليك في % % أمر وقد أحييت أمرا % % 19(@)(@@) % صادفت ذكرك كالسرا % % ر فقلت فيك فصار بدرا % % 20(@)(@@) % نوهت باسمك محسنا % بعد الخمول ألا فشكرا % % PageV01P2173 21(@)(@@) % واعذر أخاك وإن فحص % ت فما أراك الفحص غدرا % % 22(@)(@@) % وإذا سمعت هجاءه % فاجعل وقارك ثم وقرا % % 23(@)(@@) % فعساك إن لم تكتسب % % مجدا ستكسب ثم أجرا % % 24(@)(@@) % لم يحرز القصبات من % % لم يحتمل جدعا وعقرا % % 25(@)(@@) % ولئن فطنت لتحسنن % ن بحجة جحدا وكفرا % % 26(@)(@@) % ما حجتي إن قلت لي % % قل لي متى أعدمت فخرا % % 27(@)(@@) % ما كنت سرا قط بل % % ما زلت بالخرطوم جهرا % % 28(@)(@@) % حسبي بأنفي دون شع % % رك مفخرا ضخما وذخرا % % 29(@)(@@) % ما زال خرطومي وفي % يا لي غنى لي عنك دهرا % % 30(@)(@@) % كم أكسباني قبل شع % % رك وزنا بيضا وصفرا % % PageV01P2174 31(@)(@@) % كم وقفة لي قد حشر % ت بها جموع الناس حشرا % % 32(@)(@@) % أنا فيل ربي لم أزل % % لهوا لإخواني وسخرا % % 33 
ms552	(@)(@@) % والقس فيالي فكم % % أكسبته جذرا وجدرا % % 34(@)(@@) % كم قد فتنت بمنظري % % شمطاء عانسة وبكرا % % 35(@)(@@) % يجبي الدراهم بي ويج % % بي تارة زيتا وخمرا % % 36(@)(@@) % مالي هنالك حجة % يا عمرو فاللهم غفرا % % 37(@)(@@) % لا تلحيني إن جعل % % تك للجدا كلبا وصقرا % % PageV01P2175 البحر : - 1(@)(@@) % وضعت كقضبان اللجي % ن وصلن بالياقوت الأحمر % 2(@)(@@) % أطراف كف فوق خد % د منه ماء الحسن يقطر % % 3(@)(@@) % ورنت بمقلة جؤذر % % وسنان ساجي الطرف أحور % % 4(@)(@@) % تهدي بلحظتها السلا % % م إلي والأعداء حضر % % 5(@)(@@) % وركابها مزمومة % وراءها حاد مشمر % % 6(@)(@@) % والدمع في آماقها % % حذر المراقب قد تحير % % 7(@)(@@) % والشوق في الأحشاء عم % ما قد تعالج عنه مخبر % % 8(@)(@@) % بت القوى من حبلنا % % فأذاقنا فقد التصبر % % 9(@)(@@) % بين مشت عاجل % وصفاء ود قد تكدر % 10(@)(@@) % يا نظرة لي والنوى % % نحوي بعين الموت تنظر % % PageV01P2176 11(@)(@@) % والبدر في أحداجه % % بالرقم والديباج يستر % % 12(@)(@@) % ومليكه لزواله % % ماضي العزيمة غير مقصر % % 13(@)(@@) % بكروا لبينهم وقل % % بي في هواه بهم مبكر % % 14(@)(@@) % بكت العيون عليهم % كبكاي إذ بانوا وأغزر % % 15(@)(@@) % فسقاهم هزج الروا % % عد ضاحك الأرجاء ممطر % % 16(@)(@@) % وكست ديارهم الريا % % ض غرائب الوشي المحبر % % 17(@)(@@) % فلقد كسوا بفراقهم % % أحشاي نيرانا تسعر % % PageV01P2177 البحر : - 1(@)(@@) % أشد بأيامنا لتشهرها % % وقل بها معلنا لتظهرها % % 2(@)(@@) % وابغ ازديادا بنشر أنعمها % % لا تخف إحسانها فتكفرها % % 3(@)(@@) % من حلب الصنع أن تبادر بالن % نعمة موليكها فتشكرها % % 4(@)(@@) % إنا غدونا على خلال فتى % كرمها ربنا وطهرها % % 5(@)(@@) % باكرنا بالصبوح مدلجا % لنشوة شاءها فبكرها % % 6(@)(@@) % عاج بنا مائلا إلى حلل % قصور ملك له تخيرها % % 7(@)(@@) % من إرثه عن أبي محمده % % يا لك مأوى العلا ومفخرها % % 8(@)(@@) % أحكم إتقانها بحكمته % % وشاد بنيانها وقدرها % % 9(@)(@@) % وسط رياض دنا الربيع لها % % فحاك أبرادها ونشرها % % 10(@)(@@) % وجادها من سحابه ديم % ورد أنوارها وعصفرها % % PageV01P2178 11(@)(@@) % وساق ما حولها جداولها % % فشق أنهارها وفجرها % % 12(@)(@@) % فارتوت الماء من جوانبها % % فزانها ربنا ونضرها % % 13(@)(@@) % فهي لفرط اهتزاز رونقها % % تخيل نطقا لمن تبصرها % % 14(@)(@@) % كأنها في ابتهاج زهرتها % % وجه فتى للسرور 
ms553	 يسرها % % 15(@)(@@) % إذا بدا وجهه لزهرتها % % حار لها تارة وحيرها % % 16(@)(@@) % واختار من أحسن السقوف لها % % أفضلها قيمة وعرعرها % % 17(@)(@@) % مشعرة بالشموس من ذهب % % بين عيون تنير مشعرها % % 18(@)(@@) % كأنها في احمرارها شمس % يعشى لها من دنا فأبصرها % % 19(@)(@@) % أمامها بركة مرخمة % ترضى إذا ما رأيت مرمرها % % 20(@)(@@) % أعارها البحر من جداوله % % لجا غزير المياه أخضرها % % PageV01P2179 21(@)(@@) % كأنما الناظر المطيف بها % % فوق سماء حنى لينظرها % % 22(@)(@@) % رباع ملك يريك منظرها % % أنبل ذي بهجة وأكبرها % % 23(@)(@@) % لو قابلتها نبلا خلائقنا % % لم نك في حسنها لنعشرها % % 24(@)(@@) % ثم أتى مبدعا بمائدة % عظمها جاهدا وكبرها % % 25(@)(@@) % محفوفة شهوة النفوس على % % أحسن نضد تروق مبصرها % % 26(@)(@@) % تخالها في الرواء من سعة % كدارة البدر حين دورها % % 27(@)(@@) % ثم انثنينا إلى الشراب وقد % % جاء بآلاته فأحضرها % % 28(@)(@@) % من تحف ما تغب فائدة % لم تك في وهمنا ولم نرها % % 29(@)(@@) % وقينة إن منحت رؤيتها % % رضيت مسموعها ومنظرها % % 30(@)(@@) % إذا بدت للعيون طلعتها % % أبدت لها سرها ومضمرها % % PageV01P2180 31(@)(@@) % شمس من الحسن في معصفرة % ضاهت بلون لها معصفرها % % 32(@)(@@) % في وجنات تحمر من خجل % كأن ورد الربيع حمرها % % 33(@)(@@) % يسعى إليها بكأسه رشأ % أنثه الله حين ذكرها % % 34(@)(@@) % تشبه أعلاه لا تغادره % وينثني مشيها مؤزرها % % 35(@)(@@) % يقول من رآه وعاينها % % سبحان من صاغه وصورها % % 36(@)(@@) % في كفه كالشهاب لاح على % % ظلماء ليل دجت فنورها % % 37(@)(@@) % كأن زرق الدبا جوانبها % % تاح لها تائح فنفرها % % 38(@)(@@) % إن برزت للهواء غيرها % % أو قرعت بالمزاج كدرها % % 39(@)(@@) % فليس للشارب الحصيف سوى % % أن تتراءى له فيبدرها % % 40(@)(@@) % ثم أتت سرعا مجامره % تمنحها ندها وعنبرها % % PageV01P2181 41(@)(@@) % يا لذة للعيون قد علمت % بأنها جمعت لتبهرها % % 42(@)(@@) % أو شهوة للنفوس ما برحت % % تبدي لنا حسنها لنشهرها % % 43(@)(@@) % يا حسرتي كيف غاب وهب ولم % % يكن لنا حاضرا فيحضرها % % 44(@)(@@) % إذا أتى سالما كمنيتنا % % أعادها محسنا وكررها % % 45(@)(@@) % أحسن من كل ما بدأت % به أخلاقه إذ بدا وأظهرها % % 46(@)(@@) % من كرم يستبي معاشره % وعشرة لا نذم مخبرها % % 47(@)(@@) % وخدمة 
ms554	 للصديق دائمة % تجشمها النفس كي يوقرها % % 48(@)(@@) % تواضع لا تشوبه ضعة % وشيمة لا يرى تفترها % % 49(@)(@@) % أيا خلال كملن فيه لقد % % حسنها الله ثم كثرها % % 50(@)(@@) % ويا أبا القاسم اغتنم مدحي % % تغنم من المكرمات أفخرها % % PageV01P2182 51(@)(@@) % واعلم بأني امرؤ إذا سنحت % للفظه المأثرات حبرها % % 52(@)(@@) % ثم حدا نطقها بفطنته % % فساقها موشكا وسيرها % % 53(@)(@@) % ها إنها مدحة مبالغة % إن امرؤ منصف تدبرها % % PageV01P2183 البحر : - 1(@)(@@) % زارتك بعد النوم غير زوور % بين الظليم ومكنس اليعفور % 2(@)(@@) % فكأنما نفحاتها بعد الكرى % % نفحات وانية الهبوب حسير % 3(@)(@@) % قالت معرسنا بآخر منة % تزجي لطيمة عازب ممطور % PageV01P2184 البحر : - 1(@)(@@) % لو يدوم الشباب مدة عمري % % لم تذم لي بشاشة الأوطار % 2(@)(@@) % كل شيء له تناه وحد % كل شيء يجري إلى مقدار % % PageV01P2185 البحر : - 1(@)(@@) % فيم اجتهادي في محاولة الغنى % % وما للغنى عند الجواد به قدر % 2(@)(@@) % يفوز بجمع المال من كان باخلا % ومالي إلا الحمد من ذاك والشكر % % 3(@)(@@) % وما أنا إلا محرز المجد والعلا % % وذلك كنزي لا اللجين ولا التبر % % 4(@)(@@) % وإن يقض لي الله الرجوع فإنه % علي له إلا أفارقكم نذر % 5(@)(@@) % ولا أبتغي عنكم شخوصا ورحلة % يد الدهر إلا أن يفرقنا الدهر % % 6(@)(@@) % فما العيش إلا قرب من أنت آلف % وما الموت إلا نأيه عنك والهجر % % PageV01P2186 البحر : - 1(@)(@@) % سقيا لعيش مضى ما فيه تكدير % أيام تحكم فينا الأعين الحور % 2(@)(@@) % إذ الوصال بوصل الدهر متصل % مستصد حبله والهجر مهجور % 3(@)(@@) % نمسي ونصبح لا واش يطيف بنا % % ولا رقيب خفي اللحظ محذور % 4(@)(@@) % والشمل مؤتلف والدار جامعة % منا وربع الهوى واللهو معمور % 5(@)(@@) % حتى رمتنا صروف الدهر قاصدة % بفرقة حين خانتنا المقادير % % 6(@)(@@) % واستصحب الدمع عينا غير راقئة % لما غدت بحدوج الجيرة العير % % 7(@)(@@) % لا تنكرا جزعي يا صاحبي على % % ما فات والصب إما هام معذور % % 8(@)(@@) % وعللاني إن الصبر ممتنع % والحزن مكتنع والدمع محدور % % 9(@)(@@) % فليس يذهب ما في القلب من حزن % % إلا كؤوس لها في الجسم تفتير % 10(@)(@@) % أو شدو محسنة غنت على طرب % صوتا 
ms555	 تراطن فيه البم والزير % PageV01P2187 11(@)(@@) % يا دار أقوت بأوطاس وغيرها % % من بعد ساكنها الأمطار والمور % PageV01P2188 البحر : - 1(@)(@@) % بدل الطرف من النوم السهر % حين صد الظبي عني وهجر % 2(@)(@@) % رشأ أودع قلبي حسرة % وحمى عيني بالدمع النظر % % 3(@)(@@) % ردفه دعص وأعلى خصره % % غصن غض تجلاه قمر % % 4(@)(@@) % وله ثغر شتيت نبته % وبعينيه مع السقم حور % % 5(@)(@@) % بأبي ذاك حبيبا هاجرا % لم يدع لي الحب عنه مصطبر % % 6(@)(@@) % عللاني عن ملمات الذكر % % وانفيا بالكأس عن قلبي الفكر % % 7(@)(@@) % واسمعاني الآن صوتا طال ما % % كادت النفس عليه تنفطر % % 8(@)(@@) % حبذا الحج وأيام منى % % ومصلانا وتقبيل الحجر % % PageV01P2189 البحر : - 1(@)(@@) % وشيخ ينظف أعفاجه % % غلام له حادر أشقر % 2(@)(@@) % فمبعره مثل حلقومه % % وإن قلت مبعره أطهر % % 3(@)(@@) % أحب الطهارة من داخل % فلم يرض منها بما يظهر % % 4(@)(@@) % وما استدخل الأير من شهوة % ولكن به المذهب الأكبر % % 5(@)(@@) % رأى طهر ظاهره لا يتم % م أو يظهر الأدم الأحمر % 6(@)(@@) % وصان أنامله أن تمس % س ما يتحامى وما يقذر % % 7(@)(@@) % لذلك ليست تزال استه % % يخضخضها مخوض أعجر % % 8(@)(@@) % يغيب وبرنسه أحمر % ويبدو وبرنسه أصفر % % PageV01P2190 البحر : - 1(@)(@@) % مني الهجاء ومنك الصبر فاصطبر % لشر منتظر يا شر منتظر % 2(@)(@@) % أنت اللئيم فإن تصبر فمن قحة % على الهوان وإن تجزع فمن خور % % 3(@)(@@) % رأيت عيبك شعري حين تألمه % شبيه عض أخيك الكلب بالحجر % % 4(@)(@@) % انظر إلى الكلب مرميا لنعلم أن % % لم تترك شبها منه ولم تذر % % PageV01P2191 البحر : - 1(@)(@@) % قوم إذا وعدوا العفا % % ة تربصوا بهم الدوائر % 2(@)(@@) % وتوقعوا فجآتهم % % كتوقع الوحش النوافر % % 3(@)(@@) % وكأنهم من خوفهم % حمر نوافر من قساور % % 4(@)(@@) % فأقل ما يرضيهم % أن يسجنوهم في المقابر % 5(@)(@@) % ما فيهم عن منكر % ناه ولا بالعرف آمر % % 6(@)(@@) % بل كلهم بالشر أم % مار عن الخيرات زاجر % % 7(@)(@@) % فالحمد زور عندهم % والذم من خير الذخائر % % 8(@)(@@) % والجود عار عندهم % % والبخل من أعلى المفاخر % % 9(@)(@@) % غرض لطالب شهوة % غرض لرام بالنواقر % % PageV01P2192 البحر : - 1(@)(@@) % مديحك من تبتغي رفده % هجاء وإن كنت لا تظهره % % 2 
ms556	(@)(@@) % لأنك طالبت ما عنده % كأنك ترقيه أو تسحره % % PageV01P2193 البحر : - 1(@)(@@) % سألتك حاجة فسعيت فيها % % بتعذير نتيجته اعتذار % 2(@)(@@) % وهان عليك منقلبي كئيبا % وللحسرات في الأحشاء نار % % 3(@)(@@) % وليس لصاحب الحاجات إلا % كريم فيه جد وانشمار % % 4(@)(@@) % إذا ما نام عنها سائلوها % % تنبه لا يقر له قرار % % 5(@)(@@) % سواء عنده في كل حال % أفاتت حاجة أم فات ثار % 6(@)(@@) % كأن أخاه عضو منه فيها % % ففيه تحز بالفوت الشفار % % 7(@)(@@) % ويلحى نفسه أن يعذروه % % وليس له على القدر الخيار % % 8(@)(@@) % له عند الغدو لها وفيها % % حذار الفوت قلب مستطار % % 9(@)(@@) % يحامي أن يفوت بها قضاء % كأن المكرمات له ذمار % % PageV01P2194 البحر : - 1(@)(@@) % ماأنس لا أنس خبازا مررت به % % يدحو الرقاقة وشك اللمح بالبصر % 2(@)(@@) % ما بين رؤيتها في كفه كرة % وبين رؤيتها قوراء كالقمر % % 3(@)(@@) % إلا بمقدار ما تنداح دائرة % في صفحة الماء يرمى فيه بالحجر % % PageV01P2195 البحر : - 1(@)(@@) % غلط الطبيب علي غلطة مورد % عجزت محالته عن الإصدار % 2(@)(@@) % والناس يلحون الطبيب وإنما % % خطأ الطبيب إصابة المقدار % % PageV01P2196 البحر : - 1(@)(@@) % بني صامت قد أصبحت دار خالد % مقدسة البطنان ملعونة الظهر % 2(@)(@@) % بها شهداء السلم لم يشهدوا الوغى % % ولا سمعوا باسم الرباط ولا الثغر % % 3(@)(@@) % ولكن كما ألقتهم أمهاتهم % قذفن بهم في كل مظلمة القعر % % 4(@)(@@) % وما استمتعوا من صدر أم بضمة % ولا سقطوا في قعر مهد ولا حجر % % 5(@)(@@) % فعز علينا أن تكون رمامهم % % ودائع دار الفاسقين إلى الحشر % % 6(@)(@@) % هي الدار يؤوي ليلها كل فاسق % وفاسقة مقبوحة السر والجهر % % 7(@)(@@) % لها رب سوء مثلهاخلقت له % % وفاقا وكان الأمر يقدر للأمر % % 8(@)(@@) % إذا جمعت ضيفانه ونساؤه % فبطن على بطن ونحر على نحر % % 9(@)(@@) % خليطان فوضى من رجال ونسوة % يبيتون يحيون الفسوق إلى الفجر % 10(@)(@@) % فمن لعنة تغشى ضجيعي خطيئة % ومن رحمة تغشى شهيدين في قبر % % PageV01P2197 11(@)(@@) % كأني أراهم بين رجس ورجسة % تحندس من سوءاتهم ليلة القدر % % 12(@)(@@) % يبيتون لم يخشوا من الله نقمة % ولا حفلوا منه بكيد ولا مكر % % 13(@)(@@) % تكاد نجوم الليل وهي زواهر 
ms557	 % تهاوى عليهم أو تحار فلا تسري % % 14(@)(@@) % فلو وافقتهم ليلة القدر لم تزل % % تقاعس عن ميقاتهم آخر الدهر % % PageV01P2198 البحر : - 1(@)(@@) % أبا العباس قد ذكت الجمار % وطاب الليلواجتوي النهار % 2(@)(@@) % وفي الغدوات والآصال برد % يحب له الكساء المستزار % % 3(@)(@@) % وقد كاد الربيع يكون كهلا % شهيدايالشقائق والبهار % % 4(@)(@@) % وإن حبس الكساء تجهمته % إذا ما جاء أيام حرار % % 5(@)(@@) % وقالتجئت والكتان أولى % % بلابسه وأنت اليوم عار % 6(@)(@@) % وما للملمس الصوفي معنى % % إذا طاب ارتداء واتزار % % 7(@)(@@) % فعجل بالكساء فإن قلبي % % إليه مستهام مستطار % % 8(@)(@@) % ولا تخسسه معتلا عليه % % بإعجاليكحاشاك الضرار % % 9(@)(@@) % فليس يليق بالسادات مطل % يزور في عواقبه اعتذار % % 10(@)(@@) % أعيذك أن تقابل مثل ودي % % بعارفة يكدرها انتظار % PageV01P2199 11(@)(@@) % فإنك لم تزل غرض اختياري % % وفيك لمن تخيرك الخيار % % 12(@)(@@) % وكيف تدافعوني عن كساء % % وحبكم شعاري والدثار % % PageV01P2200 البحر : - 1(@)(@@) % أبا حسن طال المطال ولم يكن % % غريمك ممطولا وإني لصابر % 2(@)(@@) % وقفت عليك النفس لا أنا وارد % % على طول أيامي ولا أنا صادر % % 3(@)(@@) % إذا كنت تنسى والمذكر غائب % % وتدفع أمري والمذكر حاضر % % 4(@)(@@) % فيا ليت شعري والحوادث جمة % % متى تنجز الوعد الذي أنا ناظر % % 5(@)(@@) % عذرتك لو كان المطال وقد سقى % % جنابي ربيع من سمائك باكر % % 6(@)(@@) % فأما ولم يبلل جنابي بقطرة % فما لك مني في مطالك عاذر % % 7(@)(@@) % وإن كنت لا ألحاك إلا بهاجس % تناجى به تحت الصدور الضمائر % % 8(@)(@@) % متى استبطأ العافون رفدك أم متى % % تقاضاك أثمان المحامد شاعر % % 9(@)(@@) % ليهنىء رجالا لا تزال تجودهم % % سحائب من كلتا يديك مواطر % % 10(@)(@@) % تظل تجافي المن عنهم تحفيا % وقد غتهم معروفك المتواتر % % PageV01P2201 11(@)(@@) % منحتهم مالا وجاها كلاهما % % لهم منه حظ يملأ الكف وافر % % 12(@)(@@) % وعطلتني عما غمرتهم به % % وريعي أزكى ريع ما أنت عامر % 13(@)(@@) % عنيت بهم حتى كأنك والد % لهم وهم دوني بنوك الأصاغر % % 14(@)(@@) % وغادرتني خلف العناية ضائعا % ولله ماذا يا ابن يحيى تغادر % % 15(@)(@@) % أراني دها شعري لديك اقتصاره % عليك وإن لم تبتذله المعاشر % % 16(@)(@@) % وإن لم ينوه ربه باسم نفسه 
ms558	 % % فأنت له من أجل ذلك حاقر % % 17(@)(@@) % ولم أر شيئا أخلقته صيانة % % سواي وشعري مذ بدت لي المناظر % % 18(@)(@@) % ولو شئت لم تذهب على حوليتي % % هنات لأسماء الرجال شواهر % % 19(@)(@@) % وقوف على باب وتشييع موكب % وإنشاد جماع وتلك مقادر % % 20(@)(@@) % ولو أنني أرضى بهن خلائقا % لأضحى لي اسم بطرف الشمس باهر % % PageV01P2202 21(@)(@@) % ولكنني أعطي الصيانة حقها % % فهل ذاك للأحرار عندك ضائر % % 22(@)(@@) % يخوفني من ذاك أنك إنما % % تخص بجدواك القوافي الحواسر % % 23(@)(@@) % ويؤمنني من ذاك أن لست جاهلا % فتستر بالأسماء ما أنت ساتر % % 24(@)(@@) % على أنني قد جاش صدري جيشة % % فقلت وقد تعصي الحليم الهواجر % % 25(@)(@@) % أرى الدهر في نصر الأباطيل مجلبا % وفي الله يوما للحقائق ناصر % % 26(@)(@@) % ألم تحزن الأداب حزنا يشفها % % وتجري له منها الدموع البوادر % % 27(@)(@@) % قواف مصونات تقرب دونها % % قواف بأبواب الرجال سوافر % % 28(@)(@@) % أما وأبي أبكار شعر عقائل % نكحن بلا مهروهن مهائر % % 29(@)(@@) % لئن أحظيت يوما عليهن ضرة % لما هن من تحظى عليه الضرائر % 30(@)(@@) % وإنك للمرء الجلي بصيرة % % ولكن مع الأهواء تعشى البصائر % % PageV01P2203 31(@)(@@) % وقد قيلكم من رشدة في كريهة % ومن غية تلقى عليها الشراشر % % 32(@)(@@) % وكم أمة ورهاء قد فاز قدحها % % بما حرمته السيدات الحرائر % % 33(@)(@@) % ومن دون ما قد سمتني في كرائمي % % يقول امرؤ نعم البعول المقابر % % 34(@)(@@) % وما كن في بعل بجد رواغب % % ولو كان كفء الشمس لولا المفاقر % % 35(@)(@@) % سيسألني الأقوام عما أثبتني % % به فبماذا أنت إياي آمر % % 36(@)(@@) % أأخبرهم بالحق وهي شكية % % أم الإفكفالإسلام عن ذاك زاجر % % 37(@)(@@) % وإن امرأ باع الثناء من امرىء % فباء بحرمان وإثم لخاسر % % 38(@)(@@) % أتحرمني الجدوى وأطريك كاذبا % فتحظى وأشقى بالذي أنا وازر % % 39(@)(@@) % شهدت إذا أني لنفسي ظالم % % وأنك إن كلفتني ذاك جائر % % 40(@)(@@) % وهبني كتمت الحق أو قلت غيره % أتخفى على أهل العقول السرائر % % PageV01P2204 41(@)(@@) % أبى ذاك أن السر في الوجه ناطق % % وأن ضمير القلب في العين ظاهر % % 42(@)(@@) % وحسبك من شكواي في كل مجلس % نئيمي وأنفاسي عليك الزوافر % % 43(@)(@@) % وصمتيومطي حاجبيوإشاحتي 
ms559	 % % بوجهي إذا سمى لي اسمك ذاكر % % 44(@)(@@) % سئلت فلم تحرم سواي وإنه % % لوتر وإني لو أشاء لثائر % % 45(@)(@@) % ولكن عفوي عفو حر ولم يكن % % ليسبقني لولاه بالوتر واتر % 46(@)(@@) % ولو ثوبت تلك المدائح ألحقت % بها أخريات للثواب شواكر % % 47(@)(@@) % إذا أنشدت قال الألى يسمعونها % % ألا ليتنا لمنشديها منابر % % PageV01P2205 البحر : - 1(@)(@@) % أقول وقد رأيت أبا المثنى % % أثور أنت ويحك أم ثبير % % 2(@)(@@) % لعمرك ما عرضت وطلت حتى % % تعاون فيك أعوان كثير % % PageV01P2206 البحر : - 1(@)(@@) % شكوت إلى بدري هواه فقال لي % % ألست ترى بدر السماء الذي يسري % % 2(@)(@@) % فقلتبلى قالالتمسه فإنه % % نظيري وشبهي في علوي وفي قدري % % 3(@)(@@) % فإن نلته فاعلم بأنك نائلي % % وإن لم تنله فابغ أمرا سوى أمري % % 4(@)(@@) % فكان كلا البدرين صعبا مرامه % لي الويل من بدر السماء ومن بدري % % PageV01P2207 البحر : - 1(@)(@@) % هي الفتاة إذا اعتلت مفاصلها % % بالنومواعتلت الأفواه بالسحر % 2(@)(@@) % طابت هناك لحين لا يطيب له % إلا الرياض كأن ليست من البشر % % PageV01P2208 البحر : - 1(@)(@@) % أما رأيت الدهر كيف يجري % % يظهر ما أكتمه من عمري % % 2(@)(@@) % بأحرف يخطها في شعري % % يمحو بها غض الشباب النضر % % 3(@)(@@) % إذا محا سطرا بدا في سطر % % PageV01P2209 البحر : - 1(@)(@@) % يقول وقد سددوا نحوه % % أيورا كمثل أيور الحمر % % 2(@)(@@) % ألا وأبيك ابنة العامري % ي لا يدعي القوم أني أفر % % PageV01P2210 البحر : - 1(@)(@@) % كان العزير زمانا % لا در در العزير % 2(@)(@@) % إن سيل عن قائل الشع % % رقرظ الناس غيري % % 3(@)(@@) % وكان ذاك لأني % % لم أهد للشيخ أيري % % 4(@)(@@) % حتى إذا شمت فيه % % أيرا كجردان عير % % 5(@)(@@) % أضحى يرى الناس أني % % في الشعر فوق زهير % 6(@)(@@) % وقال ليذاك قولي % % ما احتل قسك ديري % % 7(@)(@@) % نحن الرواة الألى سا % % ر ذكرهم أي سير % % 8(@)(@@) % وقولنا القوخل يروى % % قدما بشر وخير % % 9(@)(@@) % فاشدد يديك بنفعي % % ولا تعرض لضيري % % 10(@)(@@) % علمت أن هجائي % % لما جفا البرج طيري % % PageV01P2211 11(@)(@@) % وأنه لي حرب % % إذا ضننت بميري % % PageV01P2212 البحر : - 1(@)(@@) % رأيتك تعطي المال إعطاء واهب % إذا المرء أعطى المال إعطاء مشتري % % 2(@)(@@) % ولست بمبتاع المحامد باللهى 
ms560	 % % فتلفى جوادا جوده جود متجر % 3(@)(@@) % ولست بمجبول على ذلك الندى % % فتلفى جوادا جوده جود مجبر % 4(@)(@@) % ولكن رأيت العرف عرفا لعينه % % فجدت ببذل العرف جود مخير % % 5(@)(@@) % وفي الناس من يعطي عطاء متاجر % وآخر يعطي كالسحاب المسخر % % 6(@)(@@) % وأنت وسطت الحالتينولم تزل % % لك الواسطات الزهر من كل جوهر % % 7(@)(@@) % فدونك مدحا أخطأ الناس بابه % زمانا طويلا معشر بعد معشر % 8(@)(@@) % ومهما يصنه الناس عن غير أهله % % فغير مصون عنك يا ابن المدبر % PageV01P2213 البحر : - 1(@)(@@) % كما لو أردنا أن نحيل شبابنا % % مشيبا ولم يأن المشيبتعذرا % % 2(@)(@@) % كذلك تعيينا إحالة شيبنا % % شبابا إذا ثوب الشباب تحسرا % % 3(@)(@@) % أبى الله تدبير ابن آدم نفسه % وألا يكون العبد إلا مدبرا % % 4(@)(@@) % ولا صبغ إلا صبغ من صبغ الدجى % % دجوجية والصبح أنور أزهرا % % PageV01P2214 البحر : - 1(@)(@@) % أملي فيه ليأسي قاهر % فلذا قلبي عليه صابر % 2(@)(@@) % وهو المحسن والمجمل بي % % وأنا الراجي له والشاكر % % 3(@)(@@) % طرفه يخبرني عن قلبه % % أنني يوما عليه قادر % % PageV01P2215 البحر : - 1(@)(@@) % يا أيها المبدي الشماتة انتظر % عقباكإن الموت كأس مدير % PageV01P2216 البحر : - 1(@)(@@) % وهب خادما لم يوف نعماك شكرها % % فبدل عرف عنده بنكير % 2(@)(@@) % فما ذنب طفل كان تسبيب كونه % % رجاؤكيا مرجو كل فقير % % 3(@)(@@) % أيحسن أن جر العيال رجاؤكم % % وخاس نداكم وهو خير خفير % % 4(@)(@@) % غياثكم يا آل وهب فإنني % % وإن لم أكن أعمى أضر ضرير % % PageV01P2217 البحر : - 1(@)(@@) % مديحك من تطالب منه رفدا % هجاء منك فيه بالضمير % 2(@)(@@) % لأنك لم تثق منه بمجد % ينوب عن المديح ولا بخير % % PageV01P2218 البحر : - 1(@)(@@) % أناديك يا من ليس في سمعه وقر % نداء محق لا ينهنهه الزجر % 2(@)(@@) % فهل يسمع الإحسان والحسن والحجا % % تظلم مظلوم ظلامته الهجر % % 3(@)(@@) % ومنع الجدا المبذول حتى كأنني % % لقى لا يرجى فيه حمد ولا أجر % % 4(@)(@@) % أقاسمدع قدري وما يستحقه % وقدرك فارفعه فما مثله قدر % % 5(@)(@@) % وصلني بأعفى نائليك من الجدا % % أو اليأس تمهر حرمة ما لها مهر % % 6(@)(@@) % أأعدو وأمري لا يسوء منافسي % % وأمرك أمر لا يعارضه أمر % % 7(@)(@@) % وقد أملتك 