ms41	 تراهمو % % بأفق علي للنجوم صحابا % % PageV01P142 البحر : - 1(@)(@@) % أهلا وسهلا بوافي الفضل كم شهدت % % آثاره بفخار غير محجوب % % 2(@)(@@) % واستأمنته على أسرارها دول % % قرت بها عينها في كل مطلوب % % 3(@)(@@) % لم لا يكون أمينا في ممالكها % % وهو العزيز عليها وابن يعقوب % % PageV01P143 البحر : - 1(@)(@@) % بروحي خطيبا جاور الترب فاغتدى % % عليه حدادا لبس كل خطيب % % 2(@)(@@) % وولى فأضحت للمنابر وحشة % % وللورق نوح فوق كل قضيب % % 3(@)(@@) % يذكرني مغنى حماه جماله % % فلله ذكرى منزل وحبيب % % PageV01P144 البحر : - 1(@)(@@) % سقى قبر إسماعيل منبجس الحيا % % وأرسى هضاب المزن حول هضابه % % 2(@)(@@) % وعاش لنا ملك نلوذ بظله % % ونغفر ذنب الدهر بعد احتقابه % % 3(@)(@@) % فما السعد إلا لمحة في جبينه % % وما العز الا وقفة عند بابه % % PageV01P145 البحر : - 1(@)(@@) % ما اسم شيء فرغت منه فلا % % أقول فيه ولا أقول به % % 2(@)(@@) % مشتبه لأمر كاد أكثره % % يخفى على الفكر في تقلبه % % 3(@)(@@) % لكن اذا ماجعلت دأبك في ال % % قلب فما أمره بمشتبه % % PageV01P146 البحر : - 1(@)(@@) % سلام على عهد الصبابة والصبا % % سلام بعيد الدار لا غرو ان صبا % % 2(@)(@@) % مفارق أوطان له وشبيبه % % اذا شرقت أهل التواصل غربا % % 3(@)(@@) % يعاود أحشاه من الشوق فاطر % ويتلو عليه آخر الآي من سبا % % 4(@)(@@) % وما زال صبا بالأحبة والها % إلى أن حكاه دمعه فتصببا % % PageV01P147 البحر : - 1(@)(@@) % أبواب سلطاننا خصت بأربعة % % تفردوا في صفات وفق مذهبه % % 2(@)(@@) % من مثل كاتبه أو مثل حاجبه % % أو مثل شاعره أو مثل مطربه % % PageV01P148 البحر : - 1(@)(@@) % رب مليح بأسه فاتك % % في الصحب حتى كلهم قد عجب % % 2(@)(@@) % يرهب قلب الليث يوم الوغى % % وهو غزال قلبه ما رهب % % PageV01P149 البحر : - 1(@)(@@) % لفلان في الديوان صورة حاضر % % وكأنه من جملة الغياب % % 2(@)(@@) % لم يدر ما مخرومة وجريده % % سبحان رازقه بغير حساب % % PageV01P150 البحر : - 1(@)(@@) % وأدهم اللون حندسي % في جريه للورى عجائب % % 2(@)(@@) % يقصر جري الرياح عنه % % فكلها خلفه جنائب % % PageV01P151 البحر : - 1(@)(@@) % أرسلت نجلي واثقا بمكارم % % أورثتها عن سادة أنجاب % % 2(@)(@@) % لاغرو ان أعربت عن أحسابهم % % فأبو البقاء أحق بالإعراب % % PageV01P152 البحر : - 1(@)(@@) % أرى لصواب يا إبري صفات 
ms42	 % % تحث على الخلاعة والتصابي % % 2(@)(@@) % فبادره فأنت به خبير % % فمثلك لا يدل على صواب % % PageV01P153 البحر : - 1(@)(@@) % سر بنا عن دمشق يا طالب العي % % ش فما للمقام للمرء رغبه % % 2(@)(@@) % رخصت أنفس الخلائق بالطا % % عون فيها فكل نفس بحبه % % PageV01P154 البحر : - 1(@)(@@) % يا مذكري بيت السعيد بأنعم % % أتت السيادة والعلى من بابها % % 2(@)(@@) % شكرتك نفس أنت أصل حياتها % % وبقائها وطعامها وشرابها % % PageV01P155 البحر : - 1(@)(@@) % أهلا وسهلا بك من قادم % % أطلع أنسي بعد طول المغيب % % 2(@)(@@) % و كنت مخذولا فقال الهنا % % نصر من الله وفتح قريب % % PageV01P156 البحر : - 1(@)(@@) % فلان الدين قد أعليت قدري % % وصح إلى مودتك انتسابي % % 2(@)(@@) % ألم ترني بلغت الأفق حتى % % بعثت لك الهلال مع الشهاب % % PageV01P157 البحر : - 1(@)(@@) % قالوا فلان قد جفت أفكاره % % نظم القريض فلا يكاد يجيبه % % 2(@)(@@) % هيهات نظم الشعر منه بعد ما % % سكن التراب وليده وحبيبه % % PageV01P158 البحر : - 1(@)(@@) % لي في ندى ومحاسن % % خبر يلذ ويستطاب % % 2(@)(@@) % فأنا وراحة مالكي % % كالبحر يمطره السحاب % % PageV01P159 البحر : - 1(@)(@@) % و قطايف رقت جسوما مثل ما % % غلظت قلوبا فهي لي أحساب % % 2(@)(@@) % تحلو فما تغلو ويشهد قطرها ال % % فياض أن ندى علي سحاب % % PageV01P160 البحر : - 1(@)(@@) % دعاه لذكر الحمى مذهب % % و شوق أقام فما يذهب % % 2(@)(@@) % أمصر سقتك غوادي السرور % % و جادك من أفقها صيب % % 3(@)(@@) % ذكرت زمانك حيث الوصال % % و حيث الصبا طيب طيب % % 4(@)(@@) % و بيض الوجوه بها نجتلى % % و سود الشعور بها تسحب % % 5(@)(@@) % و كم قمر فيك سافرت عنه % % و عقرب أصداغه غيهب % % 6(@)(@@) % فما كان بالسفر المستجاد % % و قد أطلع القمر العقرب % % 7(@)(@@) % و إن حف بي للنوى مهلك % فكم صح لي باللقا مطلب % % 8(@)(@@) % و إن طمعت في ليالي الحمى % % مناي فكم قد فشا أشعب % % 9(@)(@@) % وقد يحسب المرء ما فاته % % فيأتيه أضعاف ما يحسب % % 10(@)(@@) % لعمرك ما الصبح بالمستنير % % و قد فاتني ذلك المغرب % % PageV01P161 11(@)(@@) % عسى خبر من كتاب الشهاب % % يخبر عنها بما أرقب % % PageV01P162 البحر : - 1(@)(@@) % عد مدنف القلب صبه % % يا محوج الدمع صبه % % 2(@)(@@) % أخذت جملة قلبي % % فلم 
ms43	 تدع منه حبه % % 3(@)(@@) % أخذ الأمام مديحي % % في كل صاحب رتبه % % 4(@)(@@) % قاضي القضاة الملبي % % تاج السراة الألبه % % 5(@)(@@) % مولاي هنئت صوما % % جليل قرب وقربه % % 6(@)(@@) % يا نعمة للمرجى % % و للمعاند نشبه % % 7(@)(@@) % هذا يفطر فاه % % و ذا يفطر قلبه % % PageV01P163 البحر : - 1(@)(@@) % يا ساكني مصر تبت للفراق يد % قد صيرت بعدكم حزني أبا لهب % % 2(@)(@@) % و مهجتي في ضلوعي من جوى وضنا % % حمالة الهم أو حمالة الحطب % % 3(@)(@@) % عن مدمعي وندى كف الامير الا % % حدث عن البحر يا رائيه بالعجب % % 4(@)(@@) % أمير حاجب ملك غير أن له % % نور المهابة يغنيه عن الحجب % % 5(@)(@@) % يا منعشي حيث شخصي في دمشق وفي % % تفليس مالي ودمع العين في حلب % % 6(@)(@@) % كتب التواريح تملينا وتخبرنا % % عن سادة من ذوي العلياء والرتب % % 7(@)(@@) % و أنت بالفضل تملينا معاينة % % و السيف أصدق أنباء من الكتب % % PageV01P164 البحر : - 1(@)(@@) % حمائم وادي السفح إن بلابلا % تثير أسى المضى وإن قيل تطرب % % 2(@)(@@) % أحنذ إلى أهلي وأهوى لقاءهم % % و أين من المشتاق عنقاء مغرب % % 3(@)(@@) % و إني لطلاب الغنى غير باب من % % يقول الرجا هذا الصحيح المجرب % % 4(@)(@@) % فتى الفضل يحيى خالد بك ذكره % فيا حبذا من فضله الابن والأب % % 5(@)(@@) % لك النفح من مسك الثنا فابق لي رجا % وأهلي وأولادي الذين تغيبوا % % 6(@)(@@) % و إن لم يكن إلا أبو المسك أوهموا % % فانك أشهى في الفؤاد وأعذب % % 7(@)(@@) % خدمتك مداحا فلم لا أرى الغنى % % و برك موصول فلم لا أشبب % % PageV01P165 البحر : - 1(@)(@@) % صب بمصر حيث أولاده % % بالشام يذري الدمع مصبوبا % % 2(@)(@@) % ذو كبد حرى وهم بعضها % % فالكل يشكو الشوق ألهوبا % % 3(@)(@@) % لو شاء أن يجمع شملي بهم % % غوث الورى مابت مكروبا % % 4(@)(@@) % كافل دين الله سيف له % % لا زال للأمة محبوبا % % 5(@)(@@) % لو شق صدر الليث عن قلبه % % رأيت فيه اسمك مكتوبا % % 6(@)(@@) % بالقلم الرعبي من أجله % % فظل قلب الليث مرعوبا % % 7(@)(@@) % لازلت ذا عمر به لا ترى % % الاصنيع الخير محسوبا % % PageV01P166 البحر : - 1(@)(@@) % طربت بعهد الصبا بعد ما % % سقيت بنار 
ms44	 الاسى والحرب % % 2(@)(@@) % و حمر ذهني بياض المشيب % % فها أنا فيه الشفا والطرب % % 3(@)(@@) % و لولا الهنا بزمان الرئيس % % أمين العلا هد حالي العطب % % 4(@)(@@) % و مقدمه من حمى المرج قد % % شفاني من هرج مرج الكرب % % 5(@)(@@) % يوقرني وده لا جفا % % و يروي الصدى بره لا نضب % % 6(@)(@@) % دعاني شيخا رضا سيدي % % فهذبني غيظه المقتضب % % 7(@)(@@) % فأحسن لي في الوفا والجفا % % و شيخني في الرضا والغضب % % PageV01P167 البحر : - 1(@)(@@) % كم عاذل يغري وواش يتعب % % و مراقب بل خائف يترقب % % 2(@)(@@) % في كل معنى من صدودك مهلك % يحمي به من تبر خدك مطلب % % 3(@)(@@) % أهواك مثل هوى ابن يعقوب الثنا % % فكأن مرهب كل عدل مرغب % % 4(@)(@@) % يا قادما والجود تلو ركابه % % و العدل يعشب ما يشاء ويعجب % % 5(@)(@@) % يا من حمدت من الكتابة إنني % % تملى معاليها علي واكتب % % 6(@)(@@) % لا زلت ذا السرين في ألقابه % % هذا عطا يخفى وهذا منصب % % PageV01P168 البحر : - 1(@)(@@) % ياصاحب الحسن البديع تركتني % % يعقوب جانس ضره أيوبا % % 2(@)(@@) % شعري بحسنك لا يزال مشببا % يصف الأسى وبناره مشبوبا % % 3(@)(@@) % لولا امتداح محب دين الله ما % % فارقت أغزال المديح وثوبا % % 4(@)(@@) % يا من أحبته العلى وأحبتها % % أنت المحب أو المحب وجوبا % % 5(@)(@@) % لك راحة تعب الثراء بعتبها % % ما اكرم المتعوب والمعتوبا % % 6(@)(@@) % نصب خفضت العيش فيه فحبذا % % تصريفك المخفوض والمنصوبا % % 7(@)(@@) % عش للفضائل والهبات حيببها الط % % اءي أو طائيها المحبوبا % % PageV01P169 البحر : - 1(@)(@@) % تخيلت في انشاء لفظي نجعة % % فما نشأت لي لمعة بسحاب % % 2(@)(@@) % وكم خلت في فن الحساب إفادة % % فكان حساب الدهر غير حسابي % % 3(@)(@@) % إلى أن دعا باب التقى رائد الرجا % % فكان النوال الغمر رجع جوابي % % 4(@)(@@) % فيالوزير عن تقاه وبره % % رويت حديث المكرمات صحابي % % 5(@)(@@) % ويالكريم لست أحتاج عنده % إلى دفتر آتي به وكتاب % % 6(@)(@@) % فتحت به باب المدائح والرجا % % وأغلقت عن قصد المكارم بابي % % 7(@)(@@) % فإن قصرت منه صحيفة مدحتي % % فما قصرت والله صحف ثوابي % % PageV01P170 البحر : - 1(@)(@@) % يا سائلي عن أموري % % يكفيك حالي جوابا % 2(@)(@@) % شيبت موارد عيسى 
ms45	 % % والشعر والشعر شابا % % 3(@)(@@) % لكن نداء علي % أنشا لشعري سحابا % % 4(@)(@@) % أعاده لي نعمى % % كادت تعيد الشبابا % % 5(@)(@@) % يا من أدار ثنائي % % على علاه شرابا % % 6(@)(@@) % يا أجلب الناس حمدا % لبابه وثوابا % % 7(@)(@@) % شراب دار مديحي % % وافاك يخدم بابا % % PageV01P171 البحر : - 1(@)(@@) % حمى ملة الاسلام خير سيوفها % % وزاد على فضل السيوف فأخصبا % % 2(@)(@@) % هو البحر من أي المعاني قصدته % % رأيت اتفاق الاسم والفعل معجبا % % 3(@)(@@) % يغيب فيا واها علينا وحسرة % ويأتي فيا أهلا وسهلا ومرحبا % % 4(@)(@@) % ويسفر وجه العيش عند قدومه % ويفتر حتى مبسم الزهر في الربا % % 5(@)(@@) % وماالشام الا شامة تحت ظله % فلله ما أشهى وأزهى وأطيبا % % 6(@)(@@) % بأبوابه عذ حيث حاذرت مهلكا % وبين يديه قف اذا رمت مطلبا % % 7(@)(@@) % فلا زال ذا باب إذا رامه الورى % % رأوا للهنا بابا صحيحا مجربا % % PageV01P172 البحر : - 1(@)(@@) % عجزت عن راتبي الادنى فواحربا % % واها لأشهر عام عجزت طلبا % % 2(@)(@@) % وان أتوني وقالوا إنها نصف % فإن أطيب نصفيها الذي ذهبا % % 3(@)(@@) % يا سادة حجبت عنا غمائمهم % % وليس غيثهم المعهود محتجبا % % 4(@)(@@) % يا خاتم الوزرا عدلا ومعرفة % يا مربع الغربا يا منجع الأدبا % % 5(@)(@@) % نعم الخواتيم أعمال تصاغ لكم % % حلي الجنان اذا صاغ الورى ذهبا % % 6(@)(@@) % حاشا النبات الذي أنشأته لكموا % % يذوي وقد أنشأت أيديكم سحبا % % 7(@)(@@) % كفوا ابن غنام أو كفوا أخا شجر % % من قبل أن تتلقوا نارهم حطبا % % PageV01P173 البحر : - 1(@)(@@) % أحبتي في دمشق ما ترك الن % % وى لقلبي من بعدكم حبه % % 2(@)(@@) % وكنت أرجو اللقا بمصر عسى % % تسركم من جوارنا طربه % % 3(@)(@@) % جوار قوم بنورهم فرجت % % عني وعن كل وافد كربه % % 4(@)(@@) % شهادة الناس فيهمو قبلت % % بالعدل حتى شهادة الحسبه % % 5(@)(@@) % يا سيدا ما وجدت غير قرى % % نعماه في محضر ولا غربه % % 6(@)(@@) % ليالي الصوم ماقطعت لها % % فطرا وأيام العام بالنسبه % % 7(@)(@@) % فليهنأ القرب من حماك به % % صوما وفطرا ولتهنك القربه % % PageV01P174 البحر : - 1(@)(@@) % أيها البحر الذي عن % % ه روى الناس العجائب % % 2(@)(@@) % من علوم طالعات % في سما الفضل كواكب % % 3(@)(@@) % وأياد ليس يخلو % % حاضر 
ms46	 منها وغائب % % 4(@)(@@) % هي للداني بحار % وهي للنائي سحائب % % 5(@)(@@) % أنا مالي اليوم الا % بث حمدي لك راتب % % 6(@)(@@) % أنا للشكر المهنى % % وابن شكر للمواهب % % PageV01P175 البحر : - 1(@)(@@) % يا صاحبا لي ان يغب فعهوده % % لم تنس حيث تناست الغياب % % 2(@)(@@) % أرسلت تمرا بل نوى فقبلته % % بيد الوداد فما عليك عتاب % % 3(@)(@@) % واذا تباعدت الجسوم فودنا % % باق ونحن على النوى أحباب % % PageV01P176 البحر : - 1(@)(@@) % بروحي هيفاء المعاطف حلوة % % تكاد بألحاظ المحبين تشرب % % 2(@)(@@) % لقد عذبت ألفاظها وصفاتها % % على أن قلبي في هواها معذب % % 3(@)(@@) % تجاسر عود اللهو يشبه صوتها % % فمن أجل هذا أصبح العود يضرب % % 4(@)(@@) % وأجرت دموع العاشقين بلعبها % % فقال الاسى دعها تخوض وتلعب % % PageV01P177 البحر : - 1(@)(@@) % قدمت كما ترضى السيادة والعلى % % على الشام من نعمى يديك سحاب % % 2(@)(@@) % ولا برحت خدام وصفك ما على % % محاسنها للواصفين حجاب % % 3(@)(@@) % لعزمك يمن والمقاصد مرشد % ورأيك نجح والمقال صواب % % PageV01P178 البحر : - 1(@)(@@) % أبا الحسن الإمام عليك منا % % سلام الله نفاح العياب % % 2(@)(@@) % روينا من نداك الغمر لما % % علوت إلى السحاب بلا ارتياب % % 3(@)(@@) % فكل بني الولا إن غبت يوما % تقول لنا علي في السحاب % % PageV01P179 البحر : - 1(@)(@@) % يا كاتب الملك تهنأ به % % هلال عيد سعده واجب % % 2(@)(@@) % كحاجب مقترن بالبها % % فحبذا الكاتب والحاجب % % 3(@)(@@) % نحن رعاياك فلا مغضب % % منا على الدهر ولا عاتب % % 4(@)(@@) % تجمعت فيه مزايا الهنا % % فكلنا في دهره راغب % % PageV01P180 البحر : - 1(@)(@@) % يا من أرى نسبي بيت المديح له % لو لم يكن لي لا بيت ولا نسب % % 2(@)(@@) % لا تأمرني بمدح الحاضرين فما % % أراه بل لا أرى قلبي له يجب % % 3(@)(@@) % بيني وبين مديح القوم فاصلة % ما دام لي في معاني مدحكم سبب % % PageV01P181 البحر : - 1(@)(@@) % بالله عج الحمى البدري مدكرا % % بيتا نظيما وقل يا بيت مطلوبي % % 2(@)(@@) % أنت الحبيب ولكني أعوذ به % % من أن أكون محبا غير محبوب % % 3(@)(@@) % وحق تربة يحيى يا محمده % لا غير الصدق مني صبر أيوب % % PageV01P182 البحر : - 1(@)(@@) % غدا فيك قلبي أحمدي صبابة % % فاحراقه بالنار منك عجيب % % 2(@)(@@) % ولحظك سهم لا 
ms47	 يرد فحبذا % % للحظك سهم في الحشا ونصيب % % 3(@)(@@) % ويا عاذلي اني لنقلك صابر % % وإني مقيم ما أقام عسيب % % 4(@)(@@) % غريب غرام في غريب محاسن % % وكل غريب للغريب نسيب % % PageV01P183 البحر : - 1(@)(@@) % جاء هلال العام عام الهنا % % مبشرا اذ قدم الصاحب % % 2(@)(@@) % فقلت إذ شبهته حاجبا % في حالتيه هكذا الواجب % % 3(@)(@@) % وزيرنا الأول لكنه % % جاء وفي خدمته حاجب % % PageV01P184 البحر : - 1(@)(@@) % في أمان الله أني سرت يا % % أجزل الناس ثناء وثوابا % % 2(@)(@@) % ورعاك الله فينا ملكا % ملك الأنفس ملكا لا يخابا % % 3(@)(@@) % لمواطي طرقه كم مؤمن % % قائل يا ليتني كنت ترابا % % PageV01P185 البحر : - 1(@)(@@) % مضى بالصبا إيرى الذي كنت داعيا % وكان لما تهواه أي مجيب % % 2(@)(@@) % وكنت اذا أبصرته لك قائما % نظرت إلى ذي لبدتين أريب % % 3(@)(@@) % وأفلست مع هذا المصاب فيا لها % % رزية مال أو فراق حبيب % % PageV01P186 البحر : - 1(@)(@@) % يا خيل كتاب مضوا لبيوتهم % % بأبي الشموس الجانحات غواربا % % 2(@)(@@) % كم من حمارقد تعبت بسوقه % % من خلفهم فغدوت أمشي راكبا % % 3(@)(@@) % حال متى علم ابن يحيى شرحها % % جاء الزمان إلي منها تائبا % % PageV01P187 البحر : - 1(@)(@@) % حمى الله شمس المكرمات من الأذى % % ولا نظرت عيناي يوم مغيبه % % 2(@)(@@) % لقد أبقت الأيام منه لأهلها % % بقية صافي المزن غير مشوبه % % 3(@)(@@) % كأن سجاياه اللطيفة قهوة % حباب حمياها بياض مشيبه % % PageV01P188 البحر : - 1(@)(@@) % يا سيدي يا ملاذ الطالبين ومن % % بعلمه ونداه أنجح الطلبا % % 2(@)(@@) % مباشر والجامع المعمور قد منعوا % % وافى الحوالة عن قصدي فوا حربا % % 3(@)(@@) % فإن أتوك وقالوا إنها نصف % فإن أطيب نصفيه الذي ذهبا % % 4(@)(@@) % خمسون قالت لفكر كان ذا أدب % أبعد خمسين مني تبتغي الأدبا % % PageV01P189 البحر : - 1(@)(@@) % أهلا بمقدمك السعيد فإنه % % يا بحر أهدى للشآم عجابا % % 2(@)(@@) % فاذا أرادوا الجو كنت غمامة % واذا أرادوا الرأي كنت شهابا % % 3(@)(@@) % واذا دنا من لثم نعلك تربة % ود الموحد لو يكون ترابا % % PageV01P190 البحر : - 1(@)(@@) % صرفت إلى الباب الشهابي مقصدي % % وحمدي حتى ليس في الناس مذهب % % 2(@)(@@) % فلا منزل للقوم يرصد أفقه % % بفكري ولا والله باب مجرب % % 3(@)(@@) % وحسبي أن أدعى 
ms48	 نباتي غرسه % فلا طرس إلا وهو بالحمد معشب % % PageV01P191 البحر : - 1(@)(@@) % أرجو اللقاء الصاحبي كما % % أفلت في دمشق وهو غائب % % 2(@)(@@) % حتى لقد صح مقال قائل % % دمشق لا يوجد فيها صاحب % % PageV01P192 البحر : - 1(@)(@@) % قالوا أمن عرض بجسمك مؤلم % أمسيت في صعد تئن وفي صبب % % 2(@)(@@) % فأجبتهم روحي الفداء لمالك % قد كان في هذا العروض هو السبب % % PageV01P193 البحر : - 1(@)(@@) % عين البرايا جملت مملكة % قامت فروض الهنا بواجبها % % 2(@)(@@) % فحبذا في البلاد ما جمعت % % في الحسن من عينها وحاجبها % % PageV01P194 البحر : - 1(@)(@@) % صناعة النظم تجنبتها % % وذاك يا منيتي الواجب % 2(@)(@@) % بحر العطايا قد نحا غيرنا % % فأنت بورى وأنا هارب % % PageV01P195 البحر : - 1(@)(@@) % أيها العاذل الغبي تأمل % % من غدا في صفاته القلب ذائب % % 2(@)(@@) % وتعجب لطرة وجبين % إن في الليل والنهار عجائب % % PageV01P196 البحر : - 1(@)(@@) % لأيام مولانا العزيز عواطف % على قاصديه من ندى وثواب % % 2(@)(@@) % فما مصر إلا جنة ساكن % ندى رزقه يأتي بغير حساب % % PageV01P197 البحر : - 1(@)(@@) % صب إلى أحبابه ما سلا % % بالله في بعد ولا قرب % % 2(@)(@@) % صب عليه الدمع هتانه % فياله صب على صب % PageV01P198 البحر : - 1(@)(@@) % أحسن بها ياسيدي أنعما % لم أرها إلا لكم تنسب % 2(@)(@@) % فلم أقل حين فشا عرفها % % من أين هذا النفس الطيب % % PageV01P199 البحر : - 1(@)(@@) % قالوا عن الفتح قد بعدت فهل % % ذكرك عند الصحاب بالنسب % % 2(@)(@@) % أفي حواشي الغلمان قلت ألا % % ياليتني كنت في حواشي الكتب % % PageV01P200 البحر : - 1(@)(@@) % بعث الرئيس لرزقه البابا % % خابت ورمت الرازق الوهابا % % 2(@)(@@) % فأتى الي الرزق يسعى منشدا % كس أخت رزق لا يدق البابا % % PageV01P201 البحر : - 1(@)(@@) % دم يا أخي الدين والدنيا معا % تملى بيوت الفضل منك وتكتب % % 2(@)(@@) % مدح ومنتسب ومسكن نزهة % كل الثلاثة عنك باب طيب % % PageV01P202 البحر : - 1(@)(@@) % لك الله ما أزكى وأشرف همة % وأكرم نفسا في المكارم راغبه % % 2(@)(@@) % تسمى عطايا الشعر جائزة له % % وأنت تسميها بفضلك واجبه % % PageV01P203 البحر : - 1(@)(@@) % بهاء دين الله حكمت في % % ولاء قلبي والثنا الواجب % % 2(@)(@@) % أعتقني الهم فكان الولا % % لابن عقيل بن أبي طالب % % PageV01P204 البحر : - 1(@)(@@) % بدا كرم الوجه الخصيبي بعد 
ms49	 ما % % تقضى كريم الدين وهو منيب % % 2(@)(@@) % وما كان ذا خصب لعبسة وجهه % % ولكنما وجه الكريم خصيب % % PageV01P205 البحر : - 1(@)(@@) % هلال عين العبد يا سيدي % % كحاجب وصفي له واجب % % 2(@)(@@) % لا عجب قاضي قضاة الورى % % وافى وفي خدمته حاجب % % PageV01P206 البحر : - 1(@)(@@) % بخديك ذا اسم وفعل مصاب % % وخادم حسن لست فيه أعاب % % 2(@)(@@) % وما شئت الا أن أذل عواذلي % % على أن رأيي في هواك صواب % % PageV01P207 البحر : - 1(@)(@@) % شكرا لأقلامك اللاتي جرت لمدى % % في الفضل أضحى لباغي شأوه التعبا % % 2(@)(@@) % حلت واطربت المصغي وحزت بها % % فضل السباق فسماها الورى قصبا % % PageV01P208 البحر : - 1(@)(@@) % يا عجبا من طوق طاقيتي % % عن لبس يوم واجد قد غلب % % 2(@)(@@) % وشاش رأسي انقلبت حاله % عندي وقالوا الشاش لا ينقلب % % PageV01P209 البحر : - 1(@)(@@) % شيخ إسلام الورى دم للورى % % وابنك المحبوب في الوصف نبي % % 2(@)(@@) % شيخ اقرآء حديث السن يا % % حبذا الآن بني وأبي % % PageV01P210 البحر : - 1(@)(@@) % لقد قر طرف مصل بمصر % % بمسجد هذا الكريم انجذب % % 2(@)(@@) % ودار النحاس به غيرت % % فصارت لعمري دار الذهب % % PageV01P211 البحر : - 1(@)(@@) % لقد أسعد الله رأي الذي % % بنى مسجدا وصفه قد وجب % % 2(@)(@@) % لدار النحاس به حلية % % فدار النحاس كدار الذهب % % PageV01P212 البحر : - 1(@)(@@) % لا أظلم الشيب فمن قبله % % ما كان لي في عيش نصيب % % 2(@)(@@) % كلا ولا قبل سواد الصبا % % كأنما أبيض خدي مشيب % % PageV01P213 البحر : - 1(@)(@@) % عافية بشرت بعافية السل % % طان اكرم بيمنها الصاحب % % 2(@)(@@) % حجبه هذي لهذه خدمت % % يا حسن هذا الوزير والحاجب % % PageV01P214 البحر : - 1(@)(@@) % خليلي لا نوم لنا عند من له % % فسا زاد حتى شاع خطب مهبه % % 2(@)(@@) % فلا تقربا هذا النسيم فإنه % % إذا هب كان الموت أيسر خطبه % % PageV01P215 البحر : - 1(@)(@@) % إذا سألوني عن هوى قد كتمته % % سكت أراعي واشيا ورقيبا % % 2(@)(@@) % وجاوب عني سائل من مدامعي % % فلله دمعا سائلا ومجيبا % % PageV01P216 البحر : - 1(@)(@@) % فديتك من ملك يكاتب عبده % بأحرفه اللاتي حكتها الكواكب % % 2(@)(@@) % ملكت بها رقي وأنحلني الأسى % % فها أنا ذا عبد رقيق مكاتب % % PageV01P217 البحر : - 1(@)(@@) % لحاك الله يا مولاي كم ذا % % تصب من الأذى قبلي 
ms50	 وصوبي % % 2(@)(@@) % خطفت عمامتي فسكت عنها % % وزدت لجاجة فخطفت ثوبي % % PageV01P218 البحر : - 1(@)(@@) % وذي عذل لما رآني عاشقا % كواعب غزلان تدل وتطرب % % 2(@)(@@) % لحاني فأجريت المدامع أنهرا % فقلت له دعهم يخوضوا ويلعبوا % % PageV01P219 البحر : - 1(@)(@@) % شكرا لنعماك يا غوث العفاة ولا % % زالت مدائحك العليآء تنتحب % % 2(@)(@@) % قد جدت بالقطر حتى زدت في طمع % % وأول الغيث قطر ثم ينسكب % % PageV01P220 البحر : - 1(@)(@@) % فتحت للناس أبواب المقاصد لا % % تعطلت من حماك الرحب أبواب % % 2(@)(@@) % هذا له سبب فيما يحاوله % % وذا له من مقال الشعر أسباب % % PageV01P221 البحر : - 1(@)(@@) % مبقل الوجه أدار الطلا % فقال لي في حبها عاتبي % % 2(@)(@@) % عن أحمر المشروب ما تلتهي % % قلت ولا عن أخضر الشارب % % PageV01P222 البحر : - 1(@)(@@) % وأغيد يشكو خصره جور ردفه % % ويمسي بليل الشعر وهو يعاتبه % % 2(@)(@@) % يشبع ذا لحما وذا بات جائعا % وشبع الفتى لؤم اذا جاع صاحبه % % PageV01P223 البحر : - 1(@)(@@) % يا حبذا بدل أتى عمن مضى % % من قومه في الفضل والاحساب % % 2(@)(@@) % بدل من الابدال في أوصافه % % يعزى إلى قطب من الأقطاب % % PageV01P224 البحر : - 1(@)(@@) % أمولاي صبرا على مبرم % له كل يوم لديك اكتساب % % 2(@)(@@) % تقول لجودك حاجاته % % سيفتح باب اذا سد باب % % PageV01P225 البحر : - 1(@)(@@) % يا سيد الوزرا إهنأ بها خلعا % يقوم من قالها الأوفى بما يجب % % 2(@)(@@) % سحابة الطرحة العلياء طالعة % % وأول الغيث قطر ثم ينسكب % % PageV01P226 البحر : - 1(@)(@@) % يا مالكا تقصر عن وصفه % % بدائع الشاعر والكاتب % % 2(@)(@@) % في بابك العلم وفيض الندى % % فلا خلا بابك من طالب % % PageV01P227 البحر : - 1(@)(@@) % أيا دار اليمن من كل وجهة % عليك ولا زال الهنا لك يجلب % % 2(@)(@@) % ولا عدم القصاد بابك إنه % % لنجح الرجا باب صحيح مجرب % % PageV01P228 البحر : - 1(@)(@@) % هنئتها خلعة مجددة % % بكل سعد وكل مرغوب % % 2(@)(@@) % بهرت حسنا بها فحيث ترى % % يقال ذا يوسف بن يعقوب % % PageV01P229 البحر : - 1(@)(@@) % وراهن قلبي خفوق البروق % % وكان لدمعي عليه الغلب % % 2(@)(@@) % جرت مع دمعي غوادي الحيا % % فقال الغرام لقلبي وجب % % PageV01P230 البحر : - 1(@)(@@) % أقول لقلبي العاني تصبر % % وإن بعد المساعد والحبيب % % 2(@)(@@) % عسى الهم الذي أمسيت فيه % % يكون وراءه فرج 
ms51	 قريب % % PageV01P231 البحر : - 1(@)(@@) % ناعورة بمنازل البحر اقتضت % % في حالة التشبيه بث عجائب % % 2(@)(@@) % فلك يدور على المجرة مطلقا % أسى الكواكب وهي ذات ذوائب % % PageV01P232 البحر : - 1(@)(@@) % اعجب لها ناعورة قلبها % % للماء منشى العيش والعشب % % 2(@)(@@) % تعبانة الجسم ولكنها % % كما ترى طيبة القلب % % PageV01P233 البحر : - 1(@)(@@) % حجبتني فازددت عندي علا % برغم من أقبل كالعاتب % % 2(@)(@@) % وقلت لا أعدم من سيدي % % من كان عيني فغدى حاجبي % % PageV01P234 البحر : - 1(@)(@@) % أمولاي ان عدوي الزمان % % يعوق عن قصدك الواجب % % 2(@)(@@) % مخافة أشكو اليك أذاه % % فأشكو العدو إلى الصاحب % % PageV01P235 البحر : - 1(@)(@@) % أنكروا حالي التي قد صلحت % % بعد دهر صم عن عاتبه % % 2(@)(@@) % ثم قالوا لم هذا قلت ذي % % صدقات السر من كاتبه % % PageV01P236 البحر : - 1(@)(@@) % تزوج سيف الدين حسناء ناسبت % % اليه وأقصت معشرا وأقاربا % % 2(@)(@@) % ولم تستشر في أمرها غير نفسها % % ولم ترض الا قائم السيف صاحبا % % PageV01P237 البحر : - 1(@)(@@) % وافى لي البابا بمشط لم أجد % % الا الذي قدمت عليه ثوابا % % 2(@)(@@) % وأني الي اليوم بفتح حلقه % % فامنن علي وسد هذا البابا % % PageV01P238 البحر : - 1(@)(@@) % أقول لدباب على المردفي الدجى % % تأخر عن الظبي الذي عز جانبه % % 2(@)(@@) % فقد بث عبد الله جند انتقامه % % على الليل حتى ما تدب عقاربه % % PageV01P239 البحر : - 1(@)(@@) % مسئلة الدار غدت % % بيني وبين من أحب % % 2(@)(@@) % لولا مشيبي ما جفت % % لولا جفاها لم أشب % % PageV01P240 البحر : - 1(@)(@@) % حلا دمعي لخدي في هواكم % % فما أحلى بصحن الخد سكبا % % 2(@)(@@) % وناسب حالتي لما دعوتم % % كلانا قد جرى للحب صبا % % PageV01P241 البحر : - 1(@)(@@) % ولاعب يعرب شطرنجه % عن فهمه المتقد الصائب % % 2(@)(@@) % يغيب لكن ذهنه حاضر % يا حبذا من حاضر غائب % % PageV01P242 البحر : - 1(@)(@@) % يا خليلا جعلته العين والقل % % ب وأصفيته سرائر حبي % % 2(@)(@@) % لا عجيب اذا جلبت لي الض % % ر فهذي عادات عيني وقلبي % % PageV01P243 البحر : - 1(@)(@@) % تأملت في الحمام تحت مآزر % % روادف غيد ما سناها بغائب % % 2(@)(@@) % كأني من هذي وهاتيك ناظر % بياض العطايا في سواد المطالب % % PageV01P244 البحر : - 1(@)(@@) % أحاول صبرا عن هوى قد ألفته % % ولا أجد الصبر المحاول يعذب % 2(@)(@@) % والقى به ثوب 
ms52	 المشيب مطبقا % فأغسله بالدمع والطبع أغلب % % PageV01P245 البحر : - 1(@)(@@) % أسعد بها ياقمري برزة % % سعيدة الطالع والغارب % % 2(@)(@@) % صرعت طيرا وسكنت الحشى % % فما تعديت عن الواجب % % 3(@)(@@) % يا ناصر الدين والدنيا بقيت لنا % % وللسطا والعطا والحلم والأدب % % 4(@)(@@) % تخط أحسن خط أنت واضعه % % في الحرب والسلم بالهندي والعرب % % 5(@)(@@) % فديتك غصنا ليس يبرح مثمرا % % من الحسن في الدنيا بكل غريب % % 6(@)(@@) % تفتح في وجناته الورد أحمرا % % فيا ليت ذاك الورد كان نصيبي % % 7(@)(@@) % وخاطر عنت الأشواق تعجبه % % جآذر الترك لازي الأعاريب % % 8(@)(@@) % من كل أهيف ضاقت عينه فمتى % % يجود لي من تلاقيه بمطلوبي % % 9(@)(@@) % يا زائري قاضي القضاة ليهنكم % % ما حقق التجريب من أبوابه % % 10(@)(@@) % أقسمت ما الحجر المكرم للغنى % % الا الذين تغشون من أعتابه % % PageV01P246 11(@)(@@) % لئن عذر الصاحب المرتجى % % لتأخير معلومي الواجب % % 12(@)(@@) % فقد رم حالي تاج العلى % % وناب الصديق عن الصاحب % % 13(@)(@@) % شكرا لها من أنعم قد شادها % % نعم العماد فمكنت أسبابي % % 14(@)(@@) % قالوا الحساب فقلت ان عوائدي % % أعطى على يده بغير حساب % % 15(@)(@@) % بشر أمير المعالي باتصال هنا % يحفه السعد من أقصى جوانبه % % 16(@)(@@) % واكتب على بيت سكناه العزيز به % % عزا يدوم وإقبالا لصاحبه % % 17(@)(@@) % يا سادة قد ظفرت عندهمو % % بيمن قصد ونجح مطلوب % % 18(@)(@@) % حاشاكمو أن يبيت جاركمو % % يشكو إلى الناس ضر أيوب % % 19(@)(@@) % جاءت الي الشوربا فحبذا % % يا سيدي منك طعام معجب % % 20(@)(@@) % أفاد جسمي قوة فها أنا % % كما يقال الأسد المشورب % % PageV01P247 21(@)(@@) % وغائب تذكرني كتبه % % لياليا دمعي لها في انسكاب % % 22(@)(@@) % فهاك بالمرسل من أدمعي % % حديث شجوي من كتاب الشهاب % % 23(@)(@@) % عذيري منه معرضا متجنيا % كأني له نحو الوداد أجاذب % % 24(@)(@@) % قسا فوق ما تقسو الجبال فلم يجب % % ندائي وأصداء الجبال تجاوب % % 25(@)(@@) % مولاي قد جئنا لنحمل قصة % % نحو الوزير فقم مع الأصحاب % % 26(@)(@@) % فاليوم حاجتنا اليك وانما % % يدعى الطبيب لشدة الأوصاب % % 27(@)(@@) % يغيب الذي أهواه عني ساعة % % فأسأم من ليل طويل أراقبه % % 28(@)(@@) % وكيف يطيب الليل عندي والكرى % % وليس إلى جنبي خليل ألاعبه % % 29(@)(@@) % علقتها 
ms53	 غيداء حالية الطلا % % تجني على عقل المحب ولبه % % 30(@)(@@) % بخلت بلؤلؤ ثغرها عن لاثم % فتطوقت بمثال ما بخلت به % % PageV01P248 31(@)(@@) % يا حسن كتاب الحساب وخلفهم % % غلمانهم بدفاتر وتعابي % % 32(@)(@@) % كم قد رجوت وفي حساب مثلهم % % فلقيته لكن بغير حساب % 33(@)(@@) % يا غائبين تعللنا لغيبتهم % % بطيب لهو ولا والله لم يطب % % 34(@)(@@) % ذكرت والكاس في كفي لياليكم % % فالكاس في راحة والقلب في تعب % % 35(@)(@@) % أمولاي شكرا لليراع الذي أرى % % بياض العطايا في سواد المطالب % % 36(@)(@@) % لقد قمت بالمسنون والفرض في الندى % % تضيع هذا المال في غير واجب % % 37(@)(@@) % دامت بسعدك للعداة مهالك % يا مطلب الجود الذي لا يحجب % % 38(@)(@@) % والله ما ندري إذا ما فاتنا % % طلب اليك من الذي نتطلب % % 39(@)(@@) % يا حبذا ملك حثششششش الجيوش إلى % % خوض الوغى بشريق اللون محبوب % % 40(@)(@@) % تعجلوا الفال في نحر العدى فغدوا % % حمر الحلى والمطايا والجلابيب % % PageV01P249 41(@)(@@) % أهنيك بالعيد السعيد قدومه % % واشكر برا أنت من قبل واهبه % % 42(@)(@@) % لعمري لقد أصبحت عين زماننا % % فيا حبذا عين الزمان وحاجبه % % 43(@)(@@) % ليهنك يا عين الزمان وأهله % % ويهني الورى عام بسعدك آيب % % 44(@)(@@) % به للبرايا حاجب من هلاله % % ولحت فيا لله عين وحاجب % % 45(@)(@@) % للصاحب بن الصاحب الناصر من % % دعاه رأي في الصلاة الراتبة % % 46(@)(@@) % يمنح من قبل امتداح مجده % % جائزة ثم يراها واجبه % % 47(@)(@@) % لا غرو إن جئت النسيب بمدحة % من غير ما غزل وغير نسيب % % 48(@)(@@) % هزت رؤس السامعين بوصفه % % طربا فلم تحتج إلى تشبيب % % 49(@)(@@) % يا سيدي شكرا لها من أنعم % وقتي بها من بعد مصر خصيب % % 50(@)(@@) % قسما لقد أفردت في نظم وفي % % ود ففي الحالين أنت حبيب % % PageV01P250 51(@)(@@) % لا تنكروا حمرة الأظافر من % % فلان والقمل منه منسرب % % 52(@)(@@) % حمرتها من دماء ما قتلت % % والدم في النصل شاهد عجب % % 53(@)(@@) % إن الأمير سليمان اعتلى رتبا % في الخبر والخبر استعلت على الرتب % % 54(@)(@@) % مجانس الحسن بالحسان في صفة % وفارس الخيل وجه الترك والعرب % % 55(@)(@@) % يا ملاذي الغوث من عائلة % % ليس من تكليفهم لي مهرب 
