ms936	(@)(@)(@@)(@@)(@@) $ الخلجى:(@)(@)(@@) الحسين...(@)(@)(@@)(@@)(@@) $ الخيامى:(@)(@)(@@) زين الدين...(@)(@)PageV06P056(@)(@)(@@)(@@)(@@) || «د»(@)(@)(@@)(@@)(@@) $ الداعى:(@)(@)(@@) محمود الآملى.(@)(@)(@@)(@@)(@@) $ الداودى:(@)(@)(@@) احمد المهنا.(@)(@)(@@)(@@)(@@) $ الدرانى: اسماعيل...(@)(@)(@@)(@@)(@@) $ الدرانى: ابو طالب...(@)(@)(@@)(@@)(@@) $ الدشتكى: أحمد...(@)(@)(@@)(@@)(@@) $ الدشتكى: عبد الله...(@)(@)(@@)(@@)(@@) $ ابن دقماق:(@)(@)(@@) على...(@)(@)(@@)(@@)(@@) $ الدوانى:(@)(@)(@@) اسعد... غ(@)(@)PageV06P057(@)(@)(@@)(@@)(@@) || «ر»(@)(@)(@@)(@@)(@@) $ الرازانى: ابو طالب...(@)(@)(@@)(@@)(@@) $ الرازانى : محمد بن اسماعيل الدارانى.(@)(@)(@@)(@@)(@@) $ الرازى:(@)(@)(@@) خضر الحبله رودى.(@)(@)(@@)(@@)(@@) $ ابن راشد: الحسن...(@)(@)(@@)(@@)(@@) $ ابن راشد : الحسن بن محمد(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ ابن راشد : الحسين القطيفى.(@)(@)(@@)(@@)(@@) $ رجب بن محمد بن رجب البرسى.(@)(@)(@@) رضى الدين الحافظ صاحب «مشارق الأنوار» و«مشارق الامان» . وقد فرغ من الثانى فى 811 كما ذكره صاحب «رياض العلماء» وقال:(@)(@)(@@) عندنا منه نسخة وإنه فرغ من بعض تصانيفه عام 813. وأما «مشارق الأنوار» فهو مطبوع ذكر فيه: أن بين ولادة المهدى (ع) وتأليفه خمسمائة وثمانية عشر سنة، ولما كانت الولادة 255 فيصير المجموع سبعمائة وثلاث وسبعين من الهجرة، ويكون الثانى من أواخر تصانيفه. ويأتى أبو طالب بن رجب البرسى واحتمال أنه ابن صاحب الترجمه. ونقل الكفعمى فى «المصباح» الكبير جملة من خواص الأسماء الحسنى عن بعض تصانيف رجب بن محمد بن رجب الحافظ. وذكرنا له فى «الذريعة» : «اسرار الأئمة» و«انشاء التوحيد» و«الدر الثمين» و«ديوان البرسى» و«تفسير سورة التوحيد» مختصرا و«الألفين فى وصف سادة الكونين» .(@)(@)PageV06P058(@)(@)(@@)(@@)(@@) $ ابن رجب: احمد...(@)(@)(@@)(@@)(@@) $ ابن رجب : ابو طالب...(@)(@)(@@)(@@)(@@) $ الرستمدارى:(@)(@)(@@) محمد بن فخر...(@)(@)(@@)(@@)(@@) $ الرضوى: محسن... القمى.(@)(@)(@@)(@@)(@@) $ الرضوى : محمد... القمى.(@)(@)(@@)(@@)(@@) $ الرضى:(@)(@)(@@) على بن محمد بن الحسن.(@)(@)(@@)(@@)(@@) $ رضى الدين: الحسين القطيفى.(@)(@)(@@)(@@)(@@) $ رضى الدين : رجب بن محمد بن رجب.(@)(@)(@@)(@@)(@@) $ رضى الدين : عبد الملك القمى.(@)(@)(@@)(@@)(@@) $ رضى الدين : على بن عبد الحميد النيلى.(@)(@)(@@)(@@)(@@) $ رضى الدين : على بن محمد بن عبد الحميد(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ رضى الدين : محمد الجزينى.(@)(@)(@@)(@@)(@@) $ ركن الدين:(@)(@)(@@) الحسن بن عبد بن أحمد.(@)(@)PageV06P059(@)(@)(@@)(@@)(@@) || «ز»(@)(@)(@@)(@@)(@@) $ ابن زمان:(@)(@)(@@) عبد الله بن على بن سعيد.(@)(@)(@@)(@@)(@@) $ ابن زنبور:(@)(@)(@@) عبد الحسين النيلى.(@)(@)(@@)(@@)(@@) $ الزيدى:(@)(@)(@@) الحسين بن محمد بن يحيى.(@)(@)(@@)(@@)(@@) $ الزينبى:(@)(@)(@@) عبد الحميد...(@)(@)(@@)(@@)(@@) $ زين الدين: ابو الحسن الخطى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ زين الدين : على...(@)(@)(@@)(@@)(@@) $ زين الدين : على الأحسائى.(@)(@)(@@)(@@)(@@) $ زين الدين : على الاسترابادى.(@)(@)(@@)(@@)(@@) $ زين الدين : على البياضى.(@)(@)(@@)(@@)(@@) $ زين الدين : على التولينى (التولانى) .(@)(@)(@@)(@@)(@@) $ زين الدين : على بن الحسن بن علاله(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ زين الدين : على الخازن.(@)(@)(@@)(@@)(@@) $ زين الدين : على بن 
ms937	 دقماق.(@)(@)(@@)(@@)(@@) $ زين الدين : على السرابشنوى(@)(@)(@@) .(@)(@)PageV06P060(@)(@)(@@)(@@)(@@) $ زين الدين : على العيناثى.(@)(@)(@@)(@@)(@@) $ زين الدين : على بن فضل(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ زين الدين : على اللويزى.(@)(@)(@@)(@@)(@@) $ زين الدين الخيامى(@)(@)(@@) الشيخ الفقيه من تلاميذ على بن يونس. رأيت نسخة «الشرايع» بخط محمد بن اسماعيل الهرقلى الذى كتبها 703 وقرئها على العلامة الحلى وفى ظهر النصف الأخير منها إجازة وإنهاء بخط على بن يونس لتلميذه صاحب الترجمة القارى عليه هذا الجزء من «الشرايع» وتأريخ خط المجيز المذكور 806-ذ 1 قم 1171 وذ 13: 49.(@)(@)(@@)(@@)(@@) $ زين الشرف:(@)(@)(@@) عبد على بن محمد.(@)(@)PageV06P061(@)(@)(@@)(@@)(@@) || «س»(@)(@)(@@)(@@)(@@) $ الساوجى:(@)(@)(@@) محمد...(@)(@)(@@)(@@)(@@) $ السبزوارى: الحسين...(@)(@)(@@)(@@)(@@) $ السبزوارى : نصير الطبرى...(@)(@)(@@)(@@)(@@) $ السبزوارى : نظام الدين الحسينى.(@)(@)(@@)(@@)(@@) $ السبيعى:(@)(@)(@@) احمد...(@)(@)(@@)(@@)(@@) $ السرابشنوى:(@)(@)(@@) على...(@)(@)(@@)(@@)(@@) $ سعد الدين:(@)(@)(@@) محمد الاعرجى.(@)(@)(@@)(@@)(@@) $ السكيكى:(@)(@)(@@) الحسن...(@)(@)(@@)(@@)(@@) $ سلطان بن حسن الحسينى.(@)(@)(@@) كان تلميذ الفقيه زين الدين على ابن الحسن الأسترآبادى.(@)(@)(@@) كتب بخطه نسخة من «تحرير الاحكام» للعلامة الحلى الى آخر النكاح فى رجب 833 ثم قرأه على شيخه المذكور فى نفس السنة فكتب الشيخ بخطه على حاشية آخر الكتاب شهادة القرائة والسماع والبلاغ لصاحب الترجمة بغاية التجليل. والنسخة هذه موجودة فى (الرضوية) .(@)(@)(@@) (-ذ 1 قم 1106) أقول: والشيخ زين الدين على الأسترابادى هو استاذ الحسن بن حمزة(@)(@)PageV06P062(@) ابن محسن الموسوى النجفى (-ذ 1 قم 1105) وقد مر فى ص 45 ترجمة الحسن بن على النجار أنه كتب بخطه «التحرير» عام 833 وأنه كتب الحسن بن حمزة بن محسن الموسوى عليه بخطه أنه[أنهاه أدام الله أيامه وسيادته-الى قوله-رابع عشر شهر رمضان 836] فلعل القارى عليه هو صاحب الترجمة فقرأ أولا على زين الدين فى 833 ثم قرأ ثانيا على تلميذه الرشيد السيد حسن المذكور. ومر أن للسيد حسن هذا إجازة أخرى على هذه النسخة من «التحرير» كتبها للسيد عبد على عام 862 (-ص 30-32) .(@)(@)(@@)(@@)(@@) $ سلطان حسن القمى الحسينى(@)(@)(@@) المجاور للنجف الأشرف. كتب بخطه بالحضرة الغروية «جوامع الجامع» وقرأه على أستاذه السيد الأجل جعفر بن أحمد الملحوس الحسينى -ص 23 فكتب له الاجازة على جنب إسمه هكذا: [أنها دامت سيادته فى عدة مجالس آخرها يوم الخميس 11 ج 2-838 هجرية نبوية. وكتب 
ms938	 الفقير إلى الله تعالى جعفر بن احمد الملحوس الحسينى عفا الله عنه]. والنسخة عند الشيخ صالح الجزائرى فى النجف. ولعله متحد مع السيد سلطان بن حسن المذكور آنفا.(@)(@)(@@)(@@)(@@) $ سليمان العيناثى العاملى:(@)(@)(@@) يروى عنه ظهير الدين محمد بن زين الدين على بن الحسام العيناثى. وهو يروى عن الشيخ شمس الدين بن المجاهد من تلاميذ الشيخ السعيد ابى عبد الله محمد بن مكى الشهيد 786.(@)(@)(@@)(@@)(@@) $ السميطارى (المطارى) :(@)(@)(@@) محمد...(@)(@)(@@)(@@)(@@) $ السوراوى (1) :(@)(@)(@@) مقداد بن عبد الله السيورى.(@)(@)PageV06P063(@)(@)(@@)(@@)(@@) $ سيد منجم:(@)(@)(@@) محمد الحسينى.(@)(@)(@@)(@@)(@@) $ السيورى (1) : عبد الله...(@)(@)(@@)(@@)(@@) $ السيورى : مقداد بن عبد الله.(@)(@)PageV06P064(@)(@)(@@)(@@)(@@) || «ش»(@)(@)(@@)(@@)(@@) $ الشارى:(@)(@)(@@) الحسين بن المرتضا.(@)(@)(@@)(@@)(@@) $ الشامى: احمد الحلى.(@)(@)(@@)(@@)(@@) $ الشامى : جمال الدين...(@)(@)(@@)(@@)(@@) $ شاه: لطيف(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شاه : محمد...(@)(@)(@@)(@@)(@@) $ شاه : نعمة الله...(@)(@)(@@)(@@)(@@) $ ابن شبيب: عبد الله.(@)(@)(@@)(@@)(@@) $ شرف الدين: الحسن الفتال.(@)(@)(@@)(@@)(@@) $ شرف الدين : على السرابشنوى.(@)(@)(@@)(@@)(@@) $ شرف الدين : على اليزدى المعمائى.(@)(@)(@@)(@@)(@@) $ شرف الدين : مقداد بن عبد الله.(@)(@)(@@)(@@)(@@) $ شرف الدين بن جمال الدين(@)(@)(@@) بن شمس الدين بن سليمان. الظاهر أنه كان من علماء جبل عامل، من تلاميذ زين الدين على بن محمد بن يونس البياضى مؤلف «الصراط المستقيم» -ذ 15 قم 219 (م 877) فانه كتب بخطه «الرسالة اليونسية» تأليف البياضى فى حياة مؤلفها(@)(@)PageV06P065(@) وفرغ منها 864. والنسخة عند السيد محمد الزنجانى. وقد أحال البياضى إلى «اليونسية» فى «الصراط المستقيم» الذى فرغ من تأليفه 854 فيظهر منه أن الكاتب استنسخ اليونسية بعد عشر سنوات من تأليفها.(@)(@)(@@)(@@)(@@) $ شرف الدين الفتال:(@)(@)(@@) الحسن الفتال.(@)(@)(@@)(@@)(@@) $ شرف الدين المعمائى:(@)(@)(@@) على اليزدى.(@)(@)(@@)(@@)(@@) $ شرف الدين المكى:(@)(@)(@@) من تلاميذ أبى عبد الله مقداد بن عبد الله السيورى الحلى (م 826) يروى عن صاحب الترجمة أبو الحسين محمد الحلى أستاد المولى العالم الزاهد على الآملى المذكور فى «إحياء الدائر» .(@)(@)(@@)(@@)(@@) $ ابن شرفشاه: جلال الدين الحسينى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ ابن شرفشاه : عبد الله...(@)(@)(@@)(@@)(@@) $ الشريف الجرجانى:(@)(@)(@@) على الجرجانى.(@)(@)(@@)(@@)(@@) $ الشقراوى:(@)(@)(@@) على بن هلال.(@)(@)(@@)(@@)(@@) $ ابن شمال:(@)(@)(@@) محمد المشغرى.(@)(@)(@@)(@@)(@@) $ شمس الدين: محمد الاخرس.(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد الاسترابادى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد الجبعى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد الجرجانى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد الحر(@)(@)(@@) .(@)(@)PageV06P066(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد بن عبد على بن نجدة.(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد العريضى...(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد اللاهيجى. 
ms939	(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد المشغرى.(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد بن مكى.(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد الموسوى.(@)(@)(@@)(@@)(@@) $ شمس الدين : محمد بن موسى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شمس الدين الحسينى.(@)(@)(@@) رأيت بخطه «كفاية الأثر فى النصوص على الأئمة الاثنى عشر» -ذ 18: 86-88 كتبه فى «يعقوب محله» فى 14 شوال 872. والنسخة فى مكتبة (الخوانسارى) . وذكرنا فى ذ 7: 31-32 «الحقايق الايمانية» لشمس الدين بن محمد الحسينى.(@)(@)(@@)(@@)(@@) $ شمس الدين بن مجاهد.(@)(@)(@@) من تلاميذ الشهيد محمد بن مكى (م 786) . يروى عنه سليمان العيناثى العاملى شيخ إجازة ظهير الدين محمد بن على بن الحسام العيناثى-ص 63.(@)(@)(@@)(@@)(@@) $ شمس المعالى:(@)(@)(@@) محمد كيا.(@)(@)(@@)(@@)(@@) $ شهاب الدين: احمد الاحسائى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ شهاب الدين : احمد الصوفى.(@)(@)(@@)(@@)(@@) $ شهاب الدين : احمد المهنا.(@)(@)(@@)(@@)(@@) $ ابن الشهيد:(@)(@)(@@) على بن محمد بن مكى.(@)(@)(@@)(@@)(@@) $ الشيبانى:(@)(@)(@@) محمد الأرجى.(@)(@)(@@)(@@)(@@) $ الشيرازى: عماد الدين بن تاج الدين(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ الشيرازى : محمد الآملى(@)(@)(@@) .(@)(@)PageV06P067(@)(@)(@@)(@@)(@@) || «ص»(@)(@)(@@)(@@)(@@) $ الصارمى:(@)(@)(@@) الحسين.(@)(@)(@@)(@@)(@@) $ صائن الدين:(@)(@)(@@) على تركه.(@)(@)(@@)(@@)(@@) $ ابن صخرة:(@)(@)(@@) عبد على بن محمد.(@)(@)(@@)(@@)(@@) $ الصديقى:(@)(@)(@@) اسعد الدوانى.(@)(@)(@@)(@@)(@@) $ الصريحانى:(@)(@)(@@) احمد...(@)(@)(@@)(@@)(@@) $ الصنعانى:(@)(@)(@@) الحسين الفقعانى.(@)(@)(@@)(@@)(@@) $ الصوفى: احمد...(@)(@)(@@)(@@)(@@) $ الصوفى : الحسن المعلم الهمدانى.(@)(@)(@@)(@@)(@@) $ الصوفى : عبد الكريم الجيلى.(@)(@)(@@)(@@)(@@) $ الصهيونى:(@)(@)(@@) محمد...(@)(@)(@@)(@@)(@@) $ الصيمرى (1) :(@)(@)(@@) مفلح...(@)(@)PageV06P068(@)(@)(@@)(@@)(@@) || «ض»(@)(@)(@@)(@@)(@@) $ ضياء الدين:(@)(@)(@@) على بن محمد بن مكى.(@)(@)PageV06P069(@)(@)(@@)(@@)(@@) || «ط»(@)(@)(@@)(@@)(@@) $ ابو طالب الدرانى(@)(@)(@@) (الورانى خ. ل. ) الراوى عن والده عن محمد بن مكى الشهيد 786. ويروى عن المترجم له الحسين بن على بن الحسام العيناثى كما فى إجازة العيناثى لتلميذه، من غير إسم لوالده. والتلميذ هو الحسين بن مرتضا بن ابراهيم الشارى-ذ 1: 187: 11 يروى صاحب الترجمة، أيضا عن شيخه أبى العباس أحمد بن فهد الحلى م 841 لكن صاحب «رياض العلماء» ترجمه فى باب الكنى بعنوان أبو طالب بن اسماعيل الرازانى (الرازى خ. ل. ) وقال: إنه يروى بعض المسائل عن والده عن الشهيد. أقول: رأيت بعض تلك المسائل ومنها «تزاحم الحقوق» . أوله: [يجوز فتح باب فى الطريق النافذ وإحداث روشن وساباط... ] فى اثنى عشر صفحة، جاء فى آخرها: [هذه مسائل منقولة عن الشيخ الأجل العلامة أبو طالب ابن الشيخ اسماعيل الرازانى عن أبيه عن الشهيد. ره]رأيت النسخة فى كتب السيد محمد تقى بن محمد باقر المدرس الرضوى المشهدى نزيل طهران.(@)(@)(@@)(@@)(@@) $ ابو 
ms940	 طالب بن رجب.(@)(@)(@@) حكى المجلسى الثانى فى كتاب الدعاء بعد نقل «الجوشن الصغير» -ذ 5: 287 عن «مهج الدعوات» صورة ما كتب فى بعض نسخه، وهذا لفظه: [يقول كاتبه الفقير الى الله تعالى أبو طالب بن رجب: وجدت دعاء الجوشن وخبره وفضله فى كتاب من كتب جدى السعيد تقى الدين الحسن بن داود بغير هذه الرواية، فأحببت إثباته فى هذا المكان]ثم ذكر الخبر الذى أورده المجلسى فى ذيل «الجوشن الكبير» الذى نقله عن الكفعمى.(@)(@)(@@) وقال المجلسى بعد نقل قول الكاتب: [وهذا ليس من كلام السيد ابن طاوس، وانما زاده(@)(@)PageV06P070(@) ابن رجب، ولعله مروى فى كليهما، وان كان الظاهر أنه اشتبه على هذا الشيخ]ومراد المجلسى:(@)(@)(@@) أن الخبر الذى نقله ابن رجب عن كتاب جده إنما هو فى فضل «الجوشن الكبير» المنقول فى «المصباح» للكفعمى وليس «الجوشن الصغير» المروى فى «المهج» فاشتبه على ابن رجب فى نقله فى ذيل ما فى «المهج» من «الجوشن الصغير» . وبالجملة يظهر من توصيف المجلسى له ب «الشيخ» و«ابن الشيخ رجب» أنه من العلماء. أقول: ولعله ابن الشيخ رجب بن محمد بن رجب البرسى الحلى صاحب «مشارق الانوار» -ذ 21 قم 3826 وغيره، الذى نقل الكفعمى عن بعضها خواص الاسماء الحسنى فى «المصباح» وأن جده الشيخ تقى الدين الحسن بن على بن داود الحلى صاحب «الرجال» -ذ 10: 84 وغيره من التصانيف ومعاصر العلامة الحلى.(@)(@)(@@) -احمد بن رجب فى ص 7.(@)(@)(@@)(@@)(@@) $ الطالشى:(@)(@)(@@) محمد...(@)(@)(@@)(@@)(@@) $ الطاووسى:(@)(@)(@@) يعقوب...(@)(@)(@@)(@@)(@@) $ طاهر بن عرب بن ابراهيم الاصفهانى.(@)(@)(@@) المولى فخر الدين أبو الحسن المعروف بحافظ طاهر، مؤلف «الدر الفريد» -ذ 8: 68 توجد إجازته للمولى نجم الدين محمد بن إسحاق بن موفق فى 857 بخطه فى مجموعة «كنز السالكين» -ذ 8: 187 الموجودة بمكتبة (فخر الدين النصيرى) ثم انتقلت الى جامعة طهران-ذ 9: 780 وذكرنا تأليفاته فى ذ 3: 368 وفى ذ 8: 68. وهو مقدم على المولى طاهر بن مؤمن القارى صاحب «التجريد فى التجويد» .(@)(@)(@@)(@@)(@@) $ الطبرى:(@)(@)(@@) نصير...(@)(@)(@@)(@@)(@@) $ الطبسى:(@)(@)(@@) معين الدين...(@)(@)(@@)(@@)(@@) $ الطرازى:(@)(@)(@@) مظفر بن زين.(@)(@)(@@)(@@)(@@) $ الطهرانى:(@)(@)(@@) ابو بكر...(@)(@)PageV06P071(@)(@)(@@)(@@)(@@) $ ابن طى: على...(@)(@)(@@)(@@)(@@) $ ابن طى 