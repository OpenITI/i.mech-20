ms141	 % % 664(@)(@@) % هوى كل صب من عناق الحبائب % % أنيقا حقيقا أن تكون حقاقه % 665(@)(@@) % من الدر لا بل من ثدي الكواعب % وأنت له أهل فإن تجزني به % % 666(@)(@@) % أزدك وإن تمسك أقف غير عاتب % فإن سألتني عنك يوما عصابة % 667(@)(@@) % شهدت على نفسي بسوء المناقب % وقلت دعاني للندى فأتيته % 668(@)(@@) % فأمسكه بل بثه في المناهب % وما احتجزت مني لهاه لحاجز % 669(@)(@@) % ولا احتجبت عني هناك بحاجب % ولكن تصدت وانحرفت لحرفتي % % 670(@)(@@) % ففاءت ولم تظلم إلى خير واهب % وما قلت إلا الحق فيك ولم تزل % % PageV01P531 671(@)(@@) % على منهج من سنة المجد لاحب % وإني لأشقى الناس إن زر ملبسي % % 672(@)(@@) % على إثم أفاك وحسرة خائب % وكنت الفتى الحر الذي فيه شيمة % 673(@)(@@) % تشيم عن الأحرار حد المخالب % ولست كمن يعدو وفي كلماته % 674(@)(@@) % تظلم مغصوب وعدوان غاصب % يحاول معروف الرجال وإن أبوا % % 675(@)(@@) % تعدى على أعراضهم كالمكالب % وأصبح يشكو الناس في الشعر جامعا % 676(@)(@@) % شكاية مسلوب وتسليط سالب % فلا تحرمني كي تجد عجيبة % 677(@)(@@) % لقوم فحسب الناس ماضي العجائب % ولا تنتقص من قدر حظي إقامتي % % 678(@)(@@) % سألتك بالداعين بين الأخاشب % وما اعتقلتني رغبة عنك يممت % % 679(@)(@@) % سواك ولكن أي رهبة راهب % كأني أرى بالظعن طعن مطاعن % % 680(@)(@@) % وبالضرب في الأقطار ضرب مضارب % وليس جزائي أن أخيب لأنني % % PageV01P532 681(@)(@@) % جبنت ولم أخلق عتاد محارب % يطالب بالإقدام من عد محربا % 682(@)(@@) % وسمي مذ ناغى بقود المقانب % % ولم يمش قيد الشبر إلا وفوقه % % 683(@)(@@) % عصائب طير تهتدي بعصائب % فأما فتى ذو حكمة وبلاغة % 684(@)(@@) % فطالبه بالتسديد وسط المخاطب % أثبني ورفهني وأجزل مثوبتي % % 685(@)(@@) % وثابر على إدرار بري وواظب % لتأتيني جدواك وهي سليمة % 686(@)(@@) % من العيب ما فيها اعتلال لعائب % أثقل إدلالي لتحمل ثقله % % 687(@)(@@) % بطوع المراضي لا بكره المغاضب % وما طلب الرفد الهنيء ببدعة % 688(@)(@@) % ولا عجب المسترفديه بعاجب % وذاك مزيد في معاليك كله % 689(@)(@@) % وفي صدق هاتيك القوافي السوارب % وما حق باغيك المزيد انتقاصه % 690(@)(@@) % ولا سيما والمال جم الحلائب % وأنت الذي يضحى وأدنى عطائه 
ms142	 % PageV01P533 691(@)(@@) % بلوغ الأماني بل قضاء المآرب % وتوزن بالأموال آمال وفده % 692(@)(@@) % وإرفاد قوم بالظنون الكواذب % أقمت لكي تزداد نعماك نعمة % 693(@)(@@) % وتغنى بوجه ناضر غير شاحب % وكي لا يقول القائلون أثابه % 694(@)(@@) % وعاقبه والقول جم المشاعب % وصوني عن التهجين عرفك موجب % 695(@)(@@) % مزيدك لي في الرفد يا ابن المرازب % بوجهك أضحى كل شيء منورا % 696(@)(@@) % وأبرز وجها ضاحكا غير قاطب % فلا تبتذله في المغاضب ظالما % 697(@)(@@) % فلم تؤت وجها مثله للمغاضب % نشرت على الدنيا شعاعا أضاءها % % 698(@)(@@) % وكانت ظلاما مدلهم الغياهب % كأنك تلقاء الخليقة كلها % % 699(@)(@@) % مشارق شمس أشرقت لمغارب % ليهن فتى أطراك أن نال سؤله % 700(@)(@@) % لديك وأن لم يحتقب وزر كاذب % رضا الله في تلك الحقائب والغنى % % PageV01P534 701(@)(@@) % جميعا ألا فوزا لتلك الحقائب % كأني أراني قائلا إن أعانني % % 702(@)(@@) % نداك على ريب الخطوب الرواهب % جزيت العلا من مستغاث أجابني % % 703(@)(@@) % جواب ضحوك البرق داني الهيادب % وفي مستماحي العرف بارق خلب % 704(@)(@@) % ولامع رقراق ونار حباحب % تسحبت في شعري ولان لجلدتي % % 705(@)(@@) % ثراه فما استخشنت مس المساحب % وليس عجيبا أن ينوب تكرم % 706(@)(@@) % غذيت به عن آمل لك غائب % أقمه مقامي ناطقا بمدائحي % % 707(@)(@@) % لديك وقد صدرتها بالمناسبدع اللوم إن اللوم عون النوائب % % ولا تتجاوز فيه حد المعاتب % 708(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 709(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 710(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % PageV01P535 711(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 712(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 713(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 714(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % 715(@)(@@) % فأصبحت في الإثراء أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 716(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % 717(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير 
ms143	 أتاه الفقر من كل جانب % 718(@)(@@) % ولما دعاني للمثوبة سيد % % يرى المدح عارا قبل بذل المثاوب % 719(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 720(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % PageV01P536 721(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 722(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 723(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 724(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التعرير بعد التجارب % 725(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 726(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % 727(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % 728(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 729(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 730(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % PageV01P537 731(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 732(@)(@@) % فملت إلى خان مرث بناؤه % % مميل غريق الثوب لهفان لاغب % 733(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 734(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % 735(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 736(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % 737(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % 738(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 739(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 740(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % PageV01P538 741(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف به ذي مثالب % 742(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجبه % % 743(@)(@@) % إذا ظلت البيداء تطفو إكامها % % وترسب في غمر من الآل ناضب % 744 
ms144	(@)(@@) % فدع عنك ذكر البر إني رأيته % لمن خاف هول البحر شر المهاوب % 745(@)(@@) % كلا نزليه صيفه وشتاؤه % خلاف لما أهواه غير مصاقب % 746(@)(@@) % لهاث مميت تحت بيضاء سخنة % وري مفيت تحت أسحم صائب % 747(@)(@@) % يجف إذا ما أصبح الريق عاصبا % ويغدق لي والريق ليس بعاصب % 748(@)(@@) % ويمنع مني الماء واللوح جاهد % ويغرقني والري رطب المحالب % % 749(@)(@@) % وما زال يبغيني الحتوف مواربا % يحوم على قتلي وغير موارب % 750(@)(@@) % فطورا يغاديني بلص مصلت % وطورا يمسيني بورد الشوارب % PageV01P539 751(@)(@@) % إلى أن وقاني الله محذور شره % بعزته والله أغلب غالب % 752(@)(@@) % فأفلت من ذؤبانه وأسوده % وحرابه إفلات أتوب تائب % 753(@)(@@) % وأما بلاء البحر عندي فإنه % % طواني على روع مع الروح واقب % 754(@)(@@) % ولو ثاب عقلي لم أدع ذكر بعضه % ولكنه من هوله غير ثائب % % 755(@)(@@) % ولم لا ولو ألقيت فيه وصخرة % لوافيت منه القعر أول راسب % 756(@)(@@) % ولم أتعلم قط من ذي سباحة % سوى الغوص والمضعوف غير مغالب % 757(@)(@@) % فأيسر إشفاقي من الماء أنني % % أمر به في الكوز مر المجانب % 758(@)(@@) % وأخشى الردى منه على كل شارب % % فكيف بأمنيه على نفس راكب % 759(@)(@@) % أظل إذا هزته ريح ولألأت % له الشمس أمواجا طوال الغوارب % 760(@)(@@) % كأني أرى فيهن فرسان بهمة % يليحون نحوي بالسيوف القواضب % PageV01P540 761(@)(@@) % فإن قلت لي قد يركب اليم طاميا % ودجلة عند اليم بعض المذانب % 762(@)(@@) % فلا عذر فيها لامرىء هاب مثلها % % وفي اللجة الخضراء عذر لهائب % 763(@)(@@) % فإن احتجاجي عنك ليس بنائم % وإن بياني ليس عني بعازب % 764(@)(@@) % لدجلة خب ليس لليم إنها % % ترائي بحلم تحته جهل واثب % 765(@)(@@) % تطامن حتى تطمئن قلوبنا % % وتغضب من مزح الرياح اللواعب % 766(@)(@@) % وأجرافها رهن بكل خيانة % وغدر ففيها كل عيب لعائب % 767(@)(@@) % ترانا إذا هاجت بها الريح هيجة % نزلزل في حوماتها بالقوارب % 768(@)(@@) % نوائل من زلزالها نحو خسفها % % فلا خير في أوساطها والجوانب % % 769(@)(@@) % زلازل موج في غمار زواجر % وهدات خسف في شطوط خوارب % 770(@)(@@) % ولليم إعذار بعرض متونه % وما فيه من آذيه المتراكب % PageV01P541 771 
ms145	(@)(@@) % ولست تراه في الرياح مزلزلا % بما فيه إلا في الشداد الغوالب % % 772(@)(@@) % وإن خيف موج عيذ منه بساحل % خلي من الأجراف ذات الكباكب % 773(@)(@@) % ويلفظ ما فيه فليس معاجلا % غريقا بغت يزهق النفس كارب % 774(@)(@@) % يعلل غرقاه إلى أن يغيثهم % % بصنع لطيف منه خير مصاحب % 775(@)(@@) % فتلفى الدلافين الكريم طباعها % % هناك رعالا عند نكب النواكب % 776(@)(@@) % مراكب للقوم الذين كبا بهم % % فهم وسطه غرقى وهم في مراكب % 777(@)(@@) % وينقض ألواح السفين فكلها % % منج لدى نوب من الكسر نائب % 778(@)(@@) % وما أنا بالراضي عن البحر مركبا % ولكنني عارضت شغب المشاغب % 779(@)(@@) % صدقتك عن نفسي وأنت مراغمي % % وموضع سري دون أدنى الأقارب % 780(@)(@@) % وجربت حتى ما أرى الدهر مغربا % علي بشيء لم يقع في تجاربي % % PageV01P542 781(@)(@@) % أرى المرء مذ يلقى التراب بوجهه % إلى أن يوارى فيه رهن النوائب % 782(@)(@@) % ولو لم يصب إلا بشرخ شبابه % لكان قد استوفى جميع المصائب % 783(@)(@@) % ومن صدق الأخيار داووا سقامه % بصحة آراء ويمن نقائب % 784(@)(@@) % وما زال صدق المستشير معاونا % على الرأي لب المستشار المحازب % 785(@)(@@) % وأبعد أدواء الرجال ذوي الضنى % % من البرء داء المستطب المكاذب % 786(@)(@@) % فلا تنصبن الحرب لي بملامتي % % وأنت سلاحي في حروب النوائب % 787(@)(@@) % وأجدى من التعنيف حسن معونة % برأي ولين من خطاب المخاطب % 788(@)(@@) % وفي النصح خير من نصيح موادع % ولا خير فيه من نصيح مواثب % 789(@)(@@) % ومثلي محتاج إلى ذي سماحة % كريم السجايا أريحي الضرائب % 790(@)(@@) % يلين على أهل التسحب مسه % ويغضي لهم عند اقتراح الغرائب % PageV01P543 791(@)(@@) % له نائل ما زال طالب طالب % ومرتاد مرتاد وخاطب خاطب % 792(@)(@@) % ألا ماجد الأخلاق حر فعاله % تباري عطاياه عطايا السحائب % 793(@)(@@) % كمثل أبي العباس إن نواله % نوال الحيا يسعى إلى كل طالب % 794(@)(@@) % يسير نحوي عرفه فيزورني % % هنيئا ولم أركب صعاب المراكب % 795(@)(@@) % يسير إلى ممتاحه فيجوده % ويكفي أخا الإمحال زم الركائب % 796(@)(@@) % ومن يك مثلا للحيا في علوه % يكن مثله في جوده بالمواهب % 797(@)(@@) % وإن نفاري منه وهو يريغني % % لشيء لرأي فيه 
ms146	 غير مناسب % 798(@)(@@) % وإن قعودي عنه خيفة نكبة % للؤم مهز وانثناء مضارب % 799(@)(@@) % أقر على نفسي بعيبي لأنني % % أرى الصدق يمحو بينات المعايب % 800(@)(@@) % لؤمت لعمر الله فيما أتيته % % وإن كنت من قوم كرام المناصب % PageV01P544 801(@)(@@) % لهم حلم إنس في عرامة جنة % وبأس أسود في دهاء ثعالب % 802(@)(@@) % يصولون بالأيدي إذا الحرب أعملت % سيوف سريج بعد أرماح زاعب % 803(@)(@@) % ولا بد من أن يلؤم المرء نازعا % إلى الحمأ المسنون ضربة لازب % 804(@)(@@) % فقل لأبي العباس لقيت وجهه % وحسبك مني تلك دعوة صاحب % 805(@)(@@) % أما حق حامي عرض مثلك أن يرى % % له الرفد والترفيه أوجب واجب % 806(@)(@@) % أمن بعد ما لم ترع للمال حرمة % وأسلمته للجود غير مجاذب % 807(@)(@@) % فأعطيت ذا سلم وحرب ووصلة % وذنب عطايا أدركت كل هارب % 808(@)(@@) % ولم تشخص العافين لكن أتتهم % لهاك جليبات لأكرم جالب % 809(@)(@@) % علما بأن الظعن فيه مشقة % وأن أمر الربح ربح الجلائب % 810(@)(@@) % تكلفني هول السفار وغوله % رفيق شتاء مقفعل الرواجب % PageV01P545 811(@)(@@) % ولا سيما حين ارتدى الماء كبره % وشاغب أنفاس الصبا والجنائب % 812(@)(@@) % وهرت على مستطرقي البر قرة % يمس أذاها دون لوث العصائب % 813(@)(@@) % كأن تمام الود والمدح كله % هوي الفتى في البحر أو في السباسب % 814(@)(@@) % لعمري لئن حاسبتني في مثوبتي % % بخفضي لقد أجريت عادة حاسب % 815(@)(@@) % حنانيك قد أيقنت أنك كاتب % له رتبة تعلو به كل كاتب % 816(@)(@@) % فدعني من حكم الكنابة إنه % عدو لحكم الشعر غير مقارب % 817(@)(@@) % وإلا فلم يستعمل العدل جاعل % أجد مجد قرن ألعب لاعب % 818(@)(@@) % أيعزب عنك الرأي في أن تثيبني % % مقيما مصونا عن عناء المطالب % 819(@)(@@) % فتلفى وألفى بين صافي صنيعة % وصافي ثناء لم يشب بالمعاتب % 820(@)(@@) % وتخرج من أحكام قوم تشددوا % % فقد جعلوا آلاءهم كالمصائب % PageV01P546 821(@)(@@) % أيذهب هذا عنك يا ابن محمد % وأنت معاذ في الأمور الحوازب % 822(@)(@@) % لك الرأي والجود اللذان كلاهما % % زعيم بكشف المطبقات الكوارب % 823(@)(@@) % وما زلت ذا ضوء ونوء لمجدب % وحيران حتى قيل بعض الكواكب % % 824(@)(@@) % تغيث وتهدي عند جدب 
ms147	 وحيرة % بمحتفل ثر وأزهر ثاقب % 825(@)(@@) % وأحسن عرف موقعا ما تناله % يدي وغرابي بالنوى غير ناعب % 826(@)(@@) % أراك متى ثوبتني في رفاهة % زففت إلي الملك بين الكتائب % 827(@)(@@) % وأنت متى ثوبتني في مشقة % % رأيتك في شخص المثيب المعاقب % 828(@)(@@) % ولو لم يكن في العرف صاف مهنأ % وذو كدر والعرف شتى المشارب % 829(@)(@@) % إذا لم يقل أعلى النوابغ رتبة % لمقول غسان الملوك الأشايب % 830(@)(@@) % علي لعمرو نعمة بعد نعمة % لوالده ليست بذات عقارب % PageV01P547 831(@)(@@) % وما عقرب أدهى من البين إنه % % له لسعة بين الحشا والترائب % 832(@)(@@) % ومن أجل ما راعى من البين قوله % % كليني لهم يا أميمة ناصب % 833(@)(@@) % أبيت سوى تكليفك العرف معفيا % به صافيا من مؤذيات الشوائب % 834(@)(@@) % بل المجد يأبى غير سومك نفسه % ورفعك عن طود المنيل المحاسب % 835(@)(@@) % فصبرا على تحميلك الثقل كله % وإن عز تحميل القروم المصاعب % 836(@)(@@) % ولا يعجبن الناس من سعي متعب % مشيح لجدوى مستريح مداعب % 837(@)(@@) % فمن ساد قوما أوجب الطول أن يرى % % مجدا لأدناهم وهم في الملاعب % 838(@)(@@) % ومن لم يزل في مصعد المجد راقيا % صعاب المراقي نال عليا المراتب % 839(@)(@@) % ألم ترني أتعبت فكري محككا % لك الشعر كي لا أبتلى بالمتاعب % 840(@)(@@) % نحلتك حليا من مديح كأنه % % هوى كل صب من عناق الحبائب % % PageV01P548 841(@)(@@) % أنيقا حقيقا أن تكون حقاقه % من الدر لا بل من ثدي الكواعب % 842(@)(@@) % وأنت له أهل فإن تجزني به % % أزدك وإن تمسك أقف غير عاتب % 843(@)(@@) % فإن سألتني عنك يوما عصابة % شهدت على نفسي بسوء المناقب % 844(@)(@@) % وقلت دعاني للندى فأتيته % فأمسكه بل بثه في المناهب % 845(@)(@@) % وما احتجزت مني لهاه لحاجز % ولا احتجبت عني هناك بحاجب % 846(@)(@@) % ولكن تصدت وانحرفت لحرفتي % % ففاءت ولم تظلم إلى خير واهب % 847(@)(@@) % وما قلت إلا الحق فيك ولم تزل % % على منهج من سنة المجد لاحب % 848(@)(@@) % وإني لأشقى الناس إن زر ملبسي % % على إثم أفاك وحسرة خائب % 849(@)(@@) % وكنت الفتى الحر الذي فيه شيمة % تشيم عن الأحرار حد المخالب % 850 
ms148	(@)(@@) % ولست كمن يعدو وفي كلماته % تظلم مغصوب وعدوان غاصب % PageV01P549 851(@)(@@) % يحاول معروف الرجال وإن أبوا % % تعدى على أعراضهم كالمكالب % 852(@)(@@) % وأصبح يشكو الناس في الشعر جامعا % شكاية مسلوب وتسليط سالب % 853(@)(@@) % فلا تحرمني كي تجد عجيبة % لقوم فحسب الناس ماضي العجائب % 854(@)(@@) % ولا تنتقص من قدر حظي إقامتي % % سألتك بالداعين بين الأخاشب % 855(@)(@@) % وما اعتقلتني رغبة عنك يممت % % سواك ولكن أي رهبة راهب % 856(@)(@@) % كأني أرى بالظعن طعن مطاعن % % وبالضرب في الأقطار ضرب مضارب % 857(@)(@@) % وليس جزائي أن أخيب لأنني % % جبنت ولم أخلق عتاد محارب % 858(@)(@@) % يطالب بالإقدام من عد محربا % وسمي مذ ناغى بقود المقانب % % 859(@)(@@) % ولم يمش قيد الشبر إلا وفوقه % % عصائب طير تهتدي بعصائب % 860(@)(@@) % فأما فتى ذو حكمة وبلاغة % فطالبه بالتسديد وسط المخاطب % PageV01P550 861(@)(@@) % أثبني ورفهني وأجزل مثوبتي % % وثابر على إدرار بري وواظب % 862(@)(@@) % لتأتيني جدواك وهي سليمة % من العيب ما فيها اعتلال لعائب % 863(@)(@@) % أثقل إدلالي لتحمل ثقله % % بطوع المراضي لا بكره المغاضب % 864(@)(@@) % وما طلب الرفد الهنيء ببدعة % ولا عجب المسترفديه بعاجب % 865(@)(@@) % وذاك مزيد في معاليك كله % وفي صدق هاتيك القوافي السوارب % 866(@)(@@) % وما حق باغيك المزيد انتقاصه % ولا سيما والمال جم الحلائب % 867(@)(@@) % وأنت الذي يضحى وأدنى عطائه % بلوغ الأماني بل قضاء المآرب % 868(@)(@@) % وتوزن بالأموال آمال وفده % وإرفاد قوم بالظنون الكواذب % 869(@)(@@) % أقمت لكي تزداد نعماك نعمة % وتغنى بوجه ناضر غير شاحب % 870(@)(@@) % وكي لا يقول القائلون أثابه % وعاقبه والقول جم المشاعب % PageV01P551 871(@)(@@) % وصوني عن التهجين عرفك موجب % مزيدك لي في الرفد يا ابن المرازب % 872(@)(@@) % بوجهك أضحى كل شيء منورا % وأبرز وجها ضاحكا غير قاطب % 873(@)(@@) % فلا تبتذله في المغاضب ظالما % فلم تؤت وجها مثله للمغاضب % 874(@)(@@) % نشرت على الدنيا شعاعا أضاءها % % وكانت ظلاما مدلهم الغياهب % 875(@)(@@) % كأنك تلقاء الخليقة كلها % % مشارق شمس أشرقت لمغارب % 876(@)(@@) % ليهن فتى أطراك أن نال سؤله % لديك وأن لم يحتقب وزر كاذب % 877(@)(@@) % رضا الله في تلك الحقائب والغنى % % جميعا ألا فوزا لتلك الحقائب 
ms149	 % 878(@)(@@) % كأني أراني قائلا إن أعانني % % نداك على ريب الخطوب الرواهب % 879(@)(@@) % جزيت العلا من مستغاث أجابني % % جواب ضحوك البرق داني الهيادب % 880(@)(@@) % وفي مستماحي العرف بارق خلب % ولامع رقراق ونار حباحب % PageV01P552 881(@)(@@) % تسحبت في شعري ولان لجلدتي % % ثراه فما استخشنت مس المساحب % 882(@)(@@) % وليس عجيبا أن ينوب تكرم % غذيت به عن آمل لك غائب % 883(@)(@@) % أقمه مقامي ناطقا بمدائحي % % لديك وقد صدرتها بالمناسب % 884(@)(@@) % ذمامي ترعى لا ذمام سفينة % وحقي لا حق القلاص الذعالب % 885(@)(@@) % وفي الناس أيقاظ لكل كريمة % كأنهم العقبان فوق المراقب % 886(@)(@@) % يراعون أمثالي فيستنقذونهم % % وهم في كروب جمة وذباذب % 887(@)(@@) % إلى الله أشكو غمة لا صباحها % % ينير ولا تنجاب عني بجائب % 888(@)(@@) % نشوب الشجا في الحلق لا هو سائغ % % ولا هو ملفوظ كذا كل ناشب % PageV01P553 البحر : - 1(@)(@@) % أسالم قد سلمت من العيوب % % ألا فاسلم كذاك من الخطوب % 2(@)(@@) % وقد حسنت أخلاقا وخلقا % فقد أصبحت مصباح القلوب % 3(@)(@@) % مصدق كنية حسناء واسم % وكم سمة مكذبة كذوب % 4(@)(@@) % فيما قمرا ينير بلا أفول % ويا شمسا تضيء بلا غروب % 5(@)(@@) % أغثني يا أبا حسن أغثني % % فأنت المستغاث لدى الكروب % 6(@)(@@) % أجرني من نقائص قد أضرت % % بعبدك يا ربيع ذوي الجدوب % 7(@)(@@) % وما وجه استقائي من غدير % وأنت البحر والموج الغضوب % 8(@)(@@) % وأنى تستمد من السواقي % % لتنضبها ولست بذي نضوب % 9(@)(@@) % أينقص كامل عرفا أتاه % % إلى حر ليس بذي ذنوب % 10(@)(@@) % أبى النقصان فعل أخي كمال % يجل عن المناقص والعيوب % PageV01P554 11(@)(@@) % جواد بالتلاد وللمعالي % % كسوب أو يزيد على الكسوب % 12(@)(@@) % أعيذك أن تخفف من دروعي % % فإني من زماني في حروب % 13(@)(@@) % وما تلك الدروع سوى هبات % تجود علي من يدك الوهوب % 14(@)(@@) % أصون بها المقاتل من زمان % على الأحرار عداء وثوب % 15(@)(@@) % فلا توسع له في جيب درعي % % فقد تؤتى الدروع من الجيوب % 16(@)(@@) % ولا تجعل إلي له مساغا % فقد تؤتى الحصون من النقوب % 17(@)(@@) % أترضى أن أراع وأنت جاري % % بأشباه الغصوب أو الغصوب % 18(@)(@@) % وجارك حين يغشى الضيم 
ms150	 جارا % أعز من المحلقة الطلوب % 19(@)(@@) % تروعني النقائص كل شهر % مع التعب المبرح والدؤوب % 20(@)(@@) % كأني حين أذكرهن أرمى % % بسهم في فؤادي ذي نشوب % PageV01P555 21(@)(@@) % وحسبي رائعا أهوال بحر % يظل العقل منها ذا عزوب % 22(@)(@@) % تسامى فيه أمواج صعاب % كأن زهاءهن زهاء لوب % 23(@)(@@) % أظل إذا طغوت على ذراها % % أهلل من محاذرة الرسوب % 24(@)(@@) % تلاعب بي تلاعب ذات جد % غوارب متن مجداد لعوب % 25(@)(@@) % أعيد ركوبه صبحا ومسيا % وما هو بالذلول ولا الركوب % 26(@)(@@) % وكم يوم أراني الموت فيه % % جنون الموج في هوج الجنوب % 27(@)(@@) % وقاني شره من بعد يأس % دفاع الله دفاع الريوب % 28(@)(@@) % فمن يطرب إذا هبت جنوب % فلست لها وعيشك بالطروب % 29(@)(@@) % ولكني لها مذ كنت قال % قلى المملوك لوالي الضروب % 30(@)(@@) % ولو حيت بريا الروض أنفي % % ولو جاءت بكل حيا سكوب % PageV01P556 31(@)(@@) % إذا سقطت خشيت لها هبوبا % وإن هبت جزعت من الهبوب % 32(@)(@@) % ولم لا وهي زلزلة ولكن % بركب الماء لا ركب السهوب % 33(@)(@@) % وبلبلة لأهل البر تجري % % فكل من أذاها في ضروب % 34(@)(@@) % تثير عجاجة وتثير حمى % % لعذب الماء طرا والشروب % 35(@)(@@) % وتذهب بالعقول إذا تداعت % أزامل جوها الزجل الصخوب % 36(@)(@@) % ويضحى ما اكتسته كل أرض % يميد مرنحا ميد الشروب % 37(@)(@@) % ويمسي النخل والشجراء منها % % وجلهما صريع للجنوب % 38(@)(@@) % فتلك الريح مما أجتويه % وعلام المشاهد والغيوب % 39(@)(@@) % ومما أشتهيه درور رزقي % % وأن أعطاه موفور الذنوب % 40(@)(@@) % وأن ألقاه يضحك من بعيد % نقي الصفحتين من الشحوب % PageV01P557 41(@)(@@) % وليس بواجب ما أشتهيه % % ولكن إن تطول ذو وجوب % 42(@)(@@) % تسنم ظهر مكرمة أنيخت % لتركبها ولا تك بالهيوب % 43(@)(@@) % وما ينحو بك العافون إلا % طريقا لست عنه بذي نكوب % PageV01P558 البحر : - 1(@)(@@) % ما استب قط اثنان إلا غلبا % % شرهما نفسا وأما وأبا % % PageV01P559 البحر : - 1(@)(@@) % لقد رأينا عجبا من العجب % بين جمادى وجمادى ورجب % 2(@)(@@) % من ذنباني تعدى طوره % فاجتمع الذنب عليه والذنب % 3(@)(@@) % علج ترقى رتبة فرتبة % ولم يكن أهلا لهاتيك الرتب % 4(@)(@@) % فزل من تلك المراقي زلة % أصبح منها 
ms151	 مشفيا على العطب % 5(@)(@@) % وهكذا كل ارتقاء في العلا % % قريب عهد بارتقاء في الكرب % 6(@)(@@) % خوله الله فلم يشكر له % % ولن ترى شكرا لمدخول النسب % 7(@)(@@) % فسلط الله عليه جهله % فكان في تدميره أقوى سبب % 8(@)(@@) % أقبل جيش لا يريد حربه % فارتاع روعا يعتري أهل الريب % 9(@)(@@) % وساء ظنا بوزير لم يخن % % عهدا وهل يصدأ مكنون الذهب % 10(@)(@@) % فلم يدع أمرا يقود حتفه % إلا أتاه جاهدا ثم اضطرب % PageV01P560 11(@)(@@) % كان كمن خاف حريقا واقعا % فزاد فيه حطبا على حطب % 12(@)(@@) % أخلق بأن تغشاه منه قطعة % يأتي عليه لفحها دون اللهب % 13(@)(@@) % انظر إليه وإلى تدبيره % فإن فيه عجبا من العجب % 14(@)(@@) % روع طفلا لم يكن ترويعه % من المداراة ولا أخذ الأهب % 15(@)(@@) % وأسخط السادة سخطا ساقه % تلقاءه سخط من الله وجب % 16(@)(@@) % ثم رأى أن لم يوفق رأيه % فأطلق الطفل وأمسى في رهب % 17(@)(@@) % فهو مقيم بين خوف وردى % % مما أتى أو بين خوف وحرب % 18(@)(@@) % وهكذا الجاهل قدما لم يزل % % من جهله في تعب وفي نصب % 19(@)(@@) % قد اشترى طول سهاد بكرى % وقد شرى طول هدوء بتعب % 20(@)(@@) % شبهت دعواه القيام بالذي % % قلد من أمر بدعواه العرب % PageV01P561 21(@)(@@) % قد قلت إذ خبرت عن تبليحه % وأنه في زفرات وكرب % 22(@)(@@) % بعدا لمن أصبح من أحواله % في صعد عال وأمسى في صبب % 23(@)(@@) % ما فعلت خيل له قد ضمرت % أما لديها هرب ولا طلب % 24(@)(@@) % بل جبنه يمنعها إقدامها % % وحينه يمنعه من الهرب % 25(@)(@@) % ما أقبح النعماء يكسى ثوبها % % وأحسن النعماء عنه تستلب % 26(@)(@@) % ما كان ما أعطيه من كسبه % لكنه فارقه بما اكتسب % 27(@)(@@) % يا غامط النعمة أيقن أنها % % قد غضب الله لها كل الغضب % 28(@)(@@) % ولن ترى الله وليا لامرىء % عادى أبا الصقر الوزير المنتجب % 29(@)(@@) % وكل من عادى محقا مقبلا % فإنه من أمره في و كتب % 30(@)(@@) % والحمد لله العظيم شأنه % % على الذي أبلى وأولى ووهب % PageV01P562 البحر : - 1(@)(@@) % أرى الصبر محمودا وعنه مذاهب % فكيف إذا ما لم يكن 
ms152	 عنه مذهب % 2(@)(@@) % هناك يحق الصبر والصبر واجب % % وما كان منه كالضرورة أوجب % 3(@)(@@) % فشد امرؤ بالصبر كفا فإنه % له عصمة أسبابها لا تقضب % 4(@)(@@) % هو المهرب المنجي لمن أحدقت به % مكاره دهر ليس منهن مهرب % 5(@)(@@) % أعد خلالا فيه ليس لعاقل % % من الناس إن أنصفن عنهن مرغب % 6(@)(@@) % لبوس جمال جنة من شماتة % شفاء أسى يثنى به ويثوب % 7(@)(@@) % فيا عجبا للشيء هذي خلاله % وتارك ما فيه من الحظ أعجب % 8(@)(@@) % وقد يتظنى الناس أن أساهم % وصبرهم فيهم طباع مركب % 9(@)(@@) % وأنهما ليسا كشيء مصرف % يصرفه ذو نكبة حين ينكب % % 10(@)(@@) % فإن شاء أن يأسى أطاع له الأسى % % وإن شاء صبرا جاءه الصبر يجلب % PageV01P563 11(@)(@@) % ولكن ضروريان كالشيء يبتلى % % به المرء مغلوبا وكالشيء يذهب % 12(@)(@@) % وليسا كما ظنوهما بل كلاهما % % لكل لبيب مستطاع مسبب % 13(@)(@@) % يصرفه المختار منا فتارة % يراد فيأتي أو يذاد فيذهب % 14(@)(@@) % إذا احتج محتج على النفس لم تكد % % على قدر يمنى لها تتعتب % 15(@)(@@) % وساعدها الصبر الجميل فأقبلت % إليها له طوعا جنائب نجنب % 16(@)(@@) % وإن هو مناها الأباطيل لم تزل % % تقاتل بالعتب القضاء وتغلب % 17(@)(@@) % فتضحي جزوعا إن أصابت مصيبة % % وتمسي هلوعا إن تعذر مطلب % 18(@)(@@) % فلا يعذرن التارك الصبر نفسه % بأن قيل إن الصبر لا يتكسب % PageV01P564 البحر : - 1(@)(@@) % يا بن حرب كسوتني طيلسانا % يتجنى على الرياح الذنوبا % % 2(@)(@@) % طيلسان إذا تنفست فيه % % صاح يشكو الصبا ويشكو الجنوبا % % 3(@)(@@) % وتهب الرياح في أرض غيري % % فتهب الفزور فيه هبوبا % % 4(@)(@@) % تتغنى إحدى نواحيه صوتا % فتشق الأخرى عليه الجيوبا % % 5(@)(@@) % فإذا ما عذلته قال مهلا % % لن يكون الكريم إلا طروبا % % 6(@)(@@) % طال رفوي له فأودى بكسبي % % يا بن حرب تركتني محروبا % % PageV01P565 البحر : - 1(@)(@@) % وله المحب إلى الحبيب % وله المريض إلى الطبيب % 2(@)(@@) % بان الحبيب فبان عن % % ك بلذتي حسن وطيب % 3(@)(@@) % إني لتذكرني الحبي % % ب سوالف الرشأ الربيب % 4(@)(@@) % والبدر فوق الغصن وال % % غصن الرطيب على الكثيب % 5(@)(@@) % عرج على ذكر الصدي % % ق وعد عن ذكر الحبيب 
ms153	 % 6(@)(@@) % كم مكثر لي مخبث % ومقل قول لي مطيب % PageV01P566 البحر : - 1(@)(@@) % عدوك من صديقك مستفاد % فلا تستكثرن من الصحاب % 2(@)(@@) % فإن الداء أكثر ما تراه % يحول من الطعام أو الشراب % 3(@)(@@) % إذا انقلب الصديق غدا عدوا % مبينا والأمور إلى انقلاب % 4(@)(@@) % ولو كان الكثير يطيب كانت % مصاحبة الكثير من الصواب % 5(@)(@@) % ولكن قل ما استكثرت إلا % سقطت على ذئاب في ثياب % 6(@)(@@) % فدع عنك الكثير فكم كثير % يعاف وكم قليل مستطاب % 7(@)(@@) % وما اللجج الملاح بمرويات % وتلقى الري في النطف العذاب % PageV01P567 البحر : - 1(@)(@@) % هل بالديار سوى صداك مجيب % أم هل بهن على بكاك مثيب % 2(@)(@@) % ومن العجائب أن تسائل دارهم % عنهم وقلبك وقلبك فيهم مجنوب % PageV01P568 البحر : - 1(@)(@@) % بدر وشمس ولدا كوكبا % % أقسمت بالله لقد أنجبا % % 2(@)(@@) % ثلاثة تشرق أنوارها % % لا بدلت من مشرق مغربا % % 3(@)(@@) % بدر وشمس أبوا مشتر % ما نازعت شرواه أم أبا % % 4(@)(@@) % قد قلت إذ بشرت بالمشتري % % قول امرىء لم يخش أن يكذبا % % 5(@)(@@) % يا آل بشر أبشروا كلكم % فقد ولدتم مطلبا مهربا % % 6(@)(@@) % تبارك الله وسبحانه % أي شهاب منكم أثقبا % % 7(@)(@@) % إن طاب أو طبتم فما أبعدت % فروع مجد أشبهت منصبا % % 8(@)(@@) % ولا عجيب لا ولا منكر % أن تلدوا الأطيب فالأطيبا % % 9(@)(@@) % أصبحتم والله يبقيكم % منجع الحر إذا أجدبا % % 10(@)(@@) % مهما انتقصناه إذا زدتم % من نعم الله فلن يحسبا % % PageV01P569 11(@)(@@) % أنتم أناس بأياديكم % يستغفر الدهر إذا أذنبا % % 12(@)(@@) % فليشكر الدهر لكم إنه % أرضى بكم من بعدما أغضبا % % 13(@)(@@) % إذا جنى الدهر على أهله % وزاد في عدتكم أعتبا % % 14(@)(@@) % إن أبا العباس إلا يكن % أرخ بالفلج فقد شببا % % 15(@)(@@) % قد بيض الأوجه بابن له % قالت له آمالنا مرحبا % % 16(@)(@@) % وذاك مفتاح لإقبالكم % كذا قضى الله ولن يغلبا % % 17(@)(@@) % وقد تفاءلت له زاجرا % كنيته لا زاجرا ثعلبا % 18(@)(@@) % إني تأملت له كنية % إذا بدا مقلوبها أعجبا % % 19(@)(@@) % يصوغها العكس أبا سابع % وذاك فأل لم يعد معطبا % % 20(@)(@@) % بل ذاك فأل صامن سبعة % مثل الصقور استشرفت أرنبا % % PageV01P570 21(@)(@@) % يأتون 
ms154	 من صلب فتى ماجد % لا كذب الله ولا خيبا % % 22(@)(@@) % وقد أتاه منهم واحد % فلينتظر ستة غيبا % % 23(@)(@@) % في مدة تعمرها نعمة % % يجعلها الله له ترتبا % % 24(@)(@@) % حتى نراه جاسا بينهم % % أجل من رضوى ومن كبكبا % % 25(@)(@@) % كالبدر وافى الأرض في نوره % بين نجوم سبعة فاحتبى % % 26(@)(@@) % يعدي على الدهر إذا ما اعتدى % % ويؤمن الناس إذا استرهبا % % 27(@)(@@) % وليشكر الناجم عن هذه % % فإنها من بعض ما بوبا % % 28(@)(@@) % أسدى وألحمت أخ لم أزل % % أحمد ما سدى وما سببا % % 29(@)(@@) % واسعد أبا العباس مستوهبا % من ملك أعطاه ما استوهبا % % 30(@)(@@) % عمرت والمولود حتى ترى % % أولاده خلفكما موكبا % % PageV01P571 31(@)(@@) % من فتية مثل أسود الشرى % % وصبية تحسبهم ربربا % % 32(@)(@@) % دونكموها يا بني مرثد % لا تعدموا أمثالها مكسبا % % 33(@)(@@) % يا رب جد لكم في العلى % % قد جعل المال لكم ملعبا % % 34(@)(@@) % لا سلب الله سرابيلكم % من هذه النعمى ولن تسلبا % % 35(@)(@@) % وادرعوا من عرفكم جنة % تفل ناب الدهر والمخلبا % % 36(@)(@@) % قلت لباغيكم وراجيكم % % ما أبعد الغيث وما أقربا % % 37(@)(@@) % سما فأعلى عن يد ملمسا % منه وأدنى من فم مشربا % % 38(@)(@@) % كم سبسب جاب مديح لكم % % ما جاب من إحسانكم سبسبا % % 39(@)(@@) % بل خاض روضا بين غدرانه % يرضيه إن صعد أو صوبا % % 40(@)(@@) % قد قلت قولا فيكم معجبا % أن لم أكن ذا حمق معجبا % % PageV01P572 41(@)(@@) % قللته فيكم وهذبته % عمدا وما قلل من هذبا % % 42(@)(@@) % ومثلكم خص بأمثاله % ومثلكم عن مثله ثوبا % % 43(@)(@@) % ولي لديكم صاحب فاضل % أحب أن يرعى وأن يصحبا % % 44(@)(@@) % مبارك الطائر ميمونه % حدثني عن ذاك من جربا % % 45(@)(@@) % بل عندكم من يمنه شاهد % قد أفصح القول وقد أعربا % % 46(@)(@@) % جاء فجاءت معه غرة % يقبل الناس بها كوكبا % % 47(@)(@@) % يا حبذا بشرى ابن عماركم % ما أحسن العقبى التي أعقبا % % 48(@)(@@) % كان بشيرا بفتى منكم % بل بربيع منكم أخصبا % % 49(@)(@@) % وما أرى الله امرأ وجهه % إلا أراه ولدا طيبا % % 50(@)(@@) % قلت لحساد له ألهبوا % % أو أطفئوا جمركم الملهبا % % PageV01P573 51(@)(@@) % إن أبا العباس مستصحب % يرضى 
ms155	 أبا العباس مستصحبا % % 52(@)(@@) % لكن في الشيخ عزيرية % قد تركته شرسا مشغبا % % 53(@)(@@) % فاشدد أبا العباس كفا به % فقد ثقفت المخطب المحربا % % 54(@)(@@) % كلم به مليته مقولا % وازحم به ملئته منكبا % % 55(@)(@@) % حاول به أمرأ وقلب به % % أمرا تجده حولا قلبا % % 56(@)(@@) % باقعة إن أنت خاطبته % أعرب أو فاكهته أغربا % % 57(@)(@@) % يصلح للجد وما هزله % بدون ما يحظى وما يجتبى % % 58(@)(@@) % أدبه الدهر بتصريفه % فأحسن التأديب إذ أدبا % % 59(@)(@@) % وظرفه نور لآدابه % إذ لم ينور كل من أعشبا % % 60(@)(@@) % تقصر الدهر أحاديثه % وتعجب الأمرد والأشيبا % % PageV01P574 61(@)(@@) % وقد غدا يشكر نعماكم % في كل واد موجزا مطنبا % % 62(@)(@@) % ولم يحاول مستزادي له % % ولم يجد في فعلكم معتبا % % 63(@)(@@) % لكن بدأت القول مستوهبا % فيه لحسن الرأي مستجلبا % % 64(@)(@@) % صونوه لي واوعوه لي واملأوا % % يديه لي لا بل بما استوجبا % % 65(@)(@@) % ذاك نصيبي من عطاياكم % إن حكم الحق بأن أنصبا % % 66(@)(@@) % دع ذا وجاوزه إلى غيره % يا أكرم السادة مستعتبا % % 67(@)(@@) % كم موعد منك وكم موعد % % أكدى ولست البارق الخلبا % % 68(@)(@@) % أأمست الحيتان في ذمة % أم أصبحت من يمها هربا % % 69(@)(@@) % حظي من الأسبوع لا تنسه % ولا يكونن سهمي الأخيبا % % 70(@)(@@) % لا يخطئني منك لوزينج % إذا بدا أعجب أو عجبا % % PageV01P575 71(@)(@@) % لم تغلق الشهوة أبوابها % % إلا أبت زلفاه أن يحجبا % % 72(@)(@@) % لو شاء أن يذهب في صخرة % لسهل الطيب له مذهبا % % 73(@)(@@) % يدور بالنفخة في جامه % دورا ترى الدهن له لولبا % % 74(@)(@@) % عاون فيه منظر مخبرا % مستحسن ساعد مستعذبا % % 75(@)(@@) % كالحسن المحسن في شدوه % تم فأضحى مطربا مضربا % % 76(@)(@@) % مستكثف الحشو ولكنه % أرق قشرا من نسيم الصبا % % 77(@)(@@) % كأنما قدت جلابيبه % % من أعين القطر الذي قببا % % 78(@)(@@) % يخال من رقة خرشائه % % شارك في الأجنحة الجندبا % % 79(@)(@@) % لو أنه صور من خبزه % ثغر لكان الواضح الأشنبا % % 80(@)(@@) % من كل بيضاء يحب الفتى % % أن يجعل الكف لها مركبا % % PageV01P576 81(@)(@@) % مدهونة زرقاء مدفونة % شهباء تحكي الأزرق الأشهبا % % 82(@)(@@) % ملذ عين وفم حسنت % وطيبت حتى صبا من صبا 
ms156	 % % 83(@)(@@) % ذيق لها اللوز فلا مرة % مرت على الذائق إلا أبى % % 84(@)(@@) % وانتقد السكر نقاده % وشاوروا في نقده المذهبا % % 85(@)(@@) % فلا إذا العين رأتها نبت % ولا إذا الضرس علاها نبا % % 86(@)(@@) % لا تنكروا الإدلال من وامق % وجه تلقاءكم المطلبا % % 87(@)(@@) % إني تسحبت على طولكم % % بدءا فما استخشنته مسحبا % % 88(@)(@@) % فلينصف الود فتى ماجد % أضحى التقاضي معه متعبا % % 89(@)(@@) % كأنه لم يدر أن العلا % % تزري على العرف إذا أنصبا % % 90(@)(@@) % يا رب معروف له قيمة % كدر صافيه بأن يطلبا % % PageV01P577 91(@)(@@) % تبرع التحفة زين لها % % وعيبها الفاحش أن تخطبا % % 92(@)(@@) % وعزة المعروف في ذله % % وذلة العرف إذا استصعبا % % PageV01P578 البحر : - 1(@)(@@) % أحمد الله مبدئا ومعيدا % % حمد من لم يزل إليه منيبا % % 2(@)(@@) % أنا في خطتي وأهلي ومالي % % وكأني أمسيت فردا غريبا % % 3(@)(@@) % من وعيد نما إلي عن القا % % ضي فما يستقر قلبي وجيبا % % 4(@)(@@) % أوحشتني مخافتيه فأصبح % % ت حريبا من كل أنس سليبا % % 5(@)(@@) % مع أمني من أن يقارف جورا % في قضاء معاقبا أو مثيبا % % 6(@)(@@) % ولعمري لئن أمنت أمينا % إن في الحق أن أهاب مهيبا % % 7(@)(@@) % أنا في غمة من الأمر غما % % ء أطيل التصعيد والتصويبا % % 8(@)(@@) % ولما ذاك خيفتي جنف القا % % ضي ولا أنني غدوت مريبا % % 9(@)(@@) % غير أني يسوؤني أن قرما % شب في صدره علي لهيبا % % 10(@)(@@) % وأرى ما يرق ستري لديه % خطة تخلق الخلاق القشيبا % % PageV01P579 11(@)(@@) % وحقيق بأن يشح على الست % % ر لديه من كان منا لبيبا % % 12(@)(@@) % ملأتني تقاته الله أمنا % وارتقابا كسا عذاري مشيبا % % 13(@)(@@) % لو يلم الذي ألم بركني % % منه بالشاهقات أضحت كثيبا % % 14(@)(@@) % أيها الحاكم الذي إن نقل في % % ه نقل مكثرا ومطيبا % % 15(@)(@@) % والذي لا يخاف مادحه الإث % % م لدى مدحه ولا التكذيبا % % 16(@)(@@) % والذي لم يزل يجاري ذوي الفض % % ل فيستتبع الثناء جنيبا % % 17(@)(@@) % يملأ القلب صامتا وتراه % يملأ الصدر سائلا ومجيبا % % 18(@)(@@) % إن قضى طبق المفاصل أو % % ساءل أعيا أو قال قال مصيبا % % 19(@)(@@) % مالك بعد مالك وكذا الأن % % جم يتلو العقيب 
ms157	 منها العقيبا % % 20(@)(@@) % كل يوم يعلم الناس علما % زائدا كل راغب ترغيبا % % PageV01P580 21(@)(@@) % شرقت شمسه لمسترشديه % حين لم يأل غيرها تغريبا % % 22(@)(@@) % والذي لم يزل لجار وراج % جبلا عاصما ومرعى خصيبا % % 23(@)(@@) % كلما استنجداه واستمجداه % % سألا حاتما وهزا شبيبا % % 24(@)(@@) % يشهد الله أن ديني دين % يرتضيه شهادة ومغيبا % % 25(@)(@@) % لم أعاند به الطريق ولا أض % حى لدين المعاندين نسيبا % % 26(@)(@@) % وكفى شاهدا بذاك مليك % لم تزل عينه علي رقيبا % % 27(@)(@@) % فإن ارتبت باليمن وما حق % ق يمين حلفتها أن تريبا % % 28(@)(@@) % فاسأل ابنيك ذا العلاء أبا العب % باس واسأل أبا العلاء النجيبا % % 29(@)(@@) % النقيين ظاهرا والنقيي % % ن ضميرا والمعجزين ضريبا % % 30(@)(@@) % الشبيهين في الطهارة بالما % % ء إذا فتشا وبالمسك طيبا % % PageV01P581 31(@)(@@) % الصريحين في الصلاح إذا ما % % خلط الناس رائبا وحليبا % % 32(@)(@@) % اللذين اغتدى وراح بعيدا % منهما الغي والرشاد قريبا % % 33(@)(@@) % وإذا ما ثنا امرىء كان تاري % % خا جعلنا ثناهما تشبيبا % % 34(@)(@@) % فهما يشهدان لي بالذي قل % ت وما يشهدان لي تغبيبا % % 35(@)(@@) % شاهدي من تراه عدلا وتلقى % % منه وجها إذا أتاك حبيبا % % 36(@)(@@) % وإذا كان شاهدي بضعة من % ك فحسبي أمنت أن تستريبا % % 37(@)(@@) % وعسى قارفي يكون ظنينا % وعسى عائبي يكون معيبا % % 38(@)(@@) % من عذيري من معشر لا ألبا % % ء وأعيوا أن يقبلوا تلبيبا % % 39(@)(@@) % ليس يألون كل ما أصلح الل % ه فسادا وما بنى تخريبا % % 40(@)(@@) % قاتلي الصالحين إما افتراسا % ظاهرا منهم وإما دبيبا % % PageV01P582 41(@)(@@) % من سباع ومن أفاع وكل % مفسد ما استحنت النيب نيبا % % 42(@)(@@) % غلب الجهل والسفاه عليهم % % فتراهم يزندقون الأديبا % % 43(@)(@@) % أنزل الله في التنابز بالأل % % قاب نهيا فأفحشوا التلقيبا % % 44(@)(@@) % لقبوا المؤمنين بالكفر ظلما % وأطالوا عليهم التأليبا % % 45(@)(@@) % واستحلوا محارم الله بالظن % ن ولم يرهبوا له ترهيبا % % 46(@)(@@) % فعل من لا يرجو النشور إذا ما % % ت ولا يتقي الإله حسيبا % % 47(@)(@@) % والمحلو محارم الله أولى % % أن يرى السيف من طلاهم خضيبا % % 48(@)(@@) % فاقتل الوالغين في مهج الأب % % رار تقتل كلبا عقورا وذيبا % % 49(@)(@@) % إنهم من 
ms158	 أتاك بالأمس يغزو % % ك فلا تبقين منهم عريبا % % 50(@)(@@) % حملوا حملة على الدين تحكي % % حملة الروم رافعين الصليبا % % PageV01P583 51(@)(@@) % وأرادوا بك العظيمة لكن % % أوسع الله سعيهم تخييبا % % 52(@)(@@) % وكأن الغوغاء لما تغاووا % % فرموا داركم قضوا تحصيبا % % 53(@)(@@) % زعموا أن ذاك غزو وحج % % تبب الله أمرهم تتبيبا % % 54(@)(@@) % وثب الشعر وثبة فاستحلوا % % رجم قاضي وكان ذاك عجيبا % % 55(@)(@@) % ما لهم لا سقاهم الله غيثا % بل عذابا من السماء صبيبا % % 56(@)(@@) % ما على حاكم من الشعر أم ما % % ذا عليه إن كان عاما جديبا % % 57(@)(@@) % أإليه أمر السحاب أم التس % % عير تبا لذاك رأيا عزيبا % % 58(@)(@@) % هكذا ظلمهم لكل بريء % دع مقالي وسائل التجريبا % % 59(@)(@@) % شيعة للضلال ذات نقيب % قبحت شيعة وخاب نقيبا % % 60(@)(@@) % ليس ينفك قادحا في تقي % قائما بالهنات فيه خطيبا % % PageV01P584 61(@)(@@) % فاحصد الظالمين بالسيف حصدا % إن في حصدهم لريعا رغيبا % % 62(@)(@@) % فإن ارتبت في العقوبة بالقت % % ل فأدب وأحسن التأديبا % % 63(@)(@@) % أنا راج بعدل قاضي أمنا % ومحلا لديه بل تقريبا % % 64(@)(@@) % بل خصوصا به ينفلني التأ % % هيل منه ويفرض الترحيبا % % 65(@)(@@) % قلت للسائلي بكم أيها الرا % % ئد صادفت مستردا عشيبا % % 66(@)(@@) % في ذرا قبة غدت لبني حم % % اد الأكرمين مردا وشيبا % % 67(@)(@@) % وتدت بالحجا ولم تعدم العل % % م عمادا ولا التقى تطنيبا % % 68(@)(@@) % قبة أصبحت نجوم المعا % % لي لأعالي سمائها تذهيبا % % 69(@)(@@) % ولكم غمة أظلت فكانت % % لي إلى ما أحبه تسبيبا % % 70(@)(@@) % وخناق قد ضاق بي فتولى % % ضيقه قطعه فعاد رحيبا % % PageV01P585 71(@)(@@) % إن لي ناصرا يذبب عني % % كان مذ كنت يحسن التذبيبا % % 72(@)(@@) % يا سمي النبي ذي الصفح والتا % % بع مسعاته التي لن تخيبا % % 73(@)(@@) % قل كما قال يوسف الخير يا يو % % سف للمرتجيك لا تثريبا % % 74(@)(@@) % وتصفح وجوه قولي وقلب % جانبيه وأنعم التقليبا % % 75(@)(@@) % والمجازاة بذل ودي ونصري % % ودعائي لك القريب المجيبا % % 76(@)(@@) % ومديح يضم لفظا فصيحا % غير مستكره ومعنى جليبا % % 77(@)(@@) % هذبته رياضة من مجيد % في مجيد يفوقه تهذيبا % % 78(@)(@@) % فاتق الله أيها الحاكم العا % % دل فيمن 
ms159	 يضحي ويمسي نخيبا % % 79(@)(@@) % إن من رعته وإن أنت لم تق % % تله قتلا قتلته تعذيبا % % PageV01P586 البحر : - 1(@)(@@) % إذا دام للمرء السواد ولم تدم % غضارته ظن السواد خضابا % % 2(@)(@@) % فكيف يظن الشيخ أن خضابه % يظن سوادا أو يخال شبابا % % PageV01P587 البحر : - 1(@)(@@) % إن كنت من جهل حقي غير معتذر % وكنت من رد مدحي غير مثئب % 2(@)(@@) % فأعطني ثمن الطرس الذي كتبت % فيه القصيدة أو كفارة الكذب % PageV01P588 البحر : - 1(@)(@@) % حماه الكرى هم سرى فتأوبا % % فبات يراعي النجم حتى تصوبا % % 2(@)(@@) % أعيني جودا لي فقد جدت للثرى % % بأكثر مما تمنعان وأطيبا % % 3(@)(@@) % بني الذي أهديته أمس للثرى % % فلله ما أقوى قناتي وأصلبا % % 4(@)(@@) % فإن تمنعاني الدمع أرجع إلى أسى % إذا فترت عنه الدموع تلهبا % % PageV01P589 البحر : - 1(@)(@@) % أبا حسن لا زلت منا على قرب % على غير تلك الحال في الخوف والرعب % 2(@)(@@) % سقى الله أيام الصيام وإن مضت % بغير الذي نهوى من الأكل والشرب % 3(@)(@@) % على أنها قد أحسنت في اجتماعنا % % وإدنائها قلبا يميل إلى قلب % 4(@)(@@) % أقلب طرفي في ربيع مبكر % % من العلم والآداب تترى وفي الكتب % 5(@)(@@) % لقاؤك للأبدان روح وراحة % وما كل من تلقاه بعدك ذا لب % 6(@)(@@) % صرفت قلوب الناس عن كل صاحب % إليك بما ألبست من قلة العجب % 7(@)(@@) % إذا نحن فارقنا حديثك خلتنا % % نرد إلى الأسماع نوعا من السب % 8(@)(@@) % وإن نحن عبرنا عن الحق قصرت % حلوم أناس عن مقامي وعن ذبي % % PageV01P590 البحر : - 1(@)(@@) % أغضبني بالأمس ما سمتني % % فارضني منه ولا تغضب % 2(@)(@@) % وكن إذا استعتبت من جفوة % يا بن علي خير مستعتب % 3(@)(@@) % أظهر ما تضمر لي كله % حملك إياي على الأجرب % 4(@)(@@) % وأنني عاتبت فيما جرى % % علي من ذاك فلم أعتب % 5(@)(@@) % بل قلت في شبداز ما قلته % واضع قدري رافع المركب % 6(@)(@@) % وبين شبداز وبرذونكم % لي مركب مني لم ينكب % 7(@)(@@) % رجلي أولى بي إني امرؤ % إذا عدمت الطرف لم أركب % 8(@)(@@) % ما أنا بالراضي ببعض الذي % % أصبحت ترضى لي فلا تكذب % PageV01P591 البحر : - 1(@)(@@) % لا أقذع 
ms160	 السلطان في أيامه % % خوفا لسطوته ومر عقابه % 2(@)(@@) % وإذا الزمان أصابه بصروفه % حاذرت رجعته ووشك مثابه % 3(@)(@@) % وأعد لؤما أن أهم بعضه % إذ فلت الأيام من أنيابه % 4(@)(@@) % تالله أهجو من هجاه زمانه % حرمت مواثبتيه عند وثابه % 5(@)(@@) % فليعلم الرؤساء أني راهب % للشر والمرهوب من أسبابه % 6(@)(@@) % طب بأحكام الهجاء مبصر % أهل السفاه بزيغه وصوابه % 7(@)(@@) % حرم الهجاء على امرىء إلا امرأ % وقع الهجاء عليه من أضرابه % 8(@)(@@) % أو طالبا قوتا حماه قادر % ظلما حقوق طعامه وشرابه % PageV01P592 البحر : - 1(@)(@@) % نفر من الخلطاء والأصحاب % تجري مودتهم مع الأنساب % 2(@)(@@) % ما زلت بينهم كأني نازل % في منزل من صحة وشباب % 3(@)(@@) % أكفى وأعفى غير ما متجشم % تعبا ولا نصبا من الأنصاب % 4(@)(@@) % آثرتكم بمودتي وتركتهم % متغيظين علي جد غضاب % 5(@)(@@) % حتى إذا ما جاش بحر المشتري % % لكم ففاض وعب أي عباب % 6(@)(@@) % وكلتم زحلا بأمري وحده % وكذاك حق الجاهل الخياب % 7(@)(@@) % أنا من أصابته الصواعق بعدما % % رجى حيا فيه حياة جناب % 8(@)(@@) % ليبكني الأعداء إني رحمة % لهم فكيف تظن بالأحباب % 9(@)(@@) % أسخطت إخواني وأخفق مطمعي % % فبقيت بين الدور والأبواب % 10(@)(@@) % ماذا أقول لمن أراجع بعدما % % وحدتكم وكفرت بالأرباب % PageV01P593 11(@)(@@) % تالله آمل عدل شيء بعدكم % أو أرتجي للظن يوم صواب % 12(@)(@@) % فاز الورى من ريحكم بسحائب % هطلت وفزت بسافيات تراب % PageV01P594 البحر : - 1(@)(@@) % لغيرك لا لك التفسير أنى % % يفسر لابن بجدتها الغريب % 2(@)(@@) % كلامك ما أترجم لا كلامي % % وإن أصبحت لي فيه نصيب % 3(@)(@@) % أأعرفه ولست له نسيبا % وتجهله وأنت له نسيب % 4(@)(@@) % معاذ الله ليس يظن هذا % % من القوم الأديب ولا الأريب % 5(@)(@@) % بلى ترجمت عن شعري لقوم % فصيح الشعر عندهم جليب % 6(@)(@@) % عساهم أن يجيلوا الطرف فيه % % فإن سألوا أجابهم مجيب % 7(@)(@@) % وإن ضلوا فمرشدهم قريب % وإن سألوه ألفوه يجيب % PageV01P595 البحر : - 1(@)(@@) % يا غصنا من لؤلؤ رطب % فيه سرور العين والقلب % 2(@)(@@) % أحسن بي يوم أرانيكم % وما على المحسن من عتب % 3(@)(@@) % لكنه أعقبني حسرة % فدمعتي سكب على سكب % 4(@)(@@) % مظلوم ما 