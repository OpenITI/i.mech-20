ms81	 جئتهم % وتراءت لك تلك الكلل ؛ % 4(@)(@@) % قل لهم بالله عني إنني % % حافظ ميثاقهم إن سألوا ؛ % 5(@)(@@) % أي سر في فؤادي لهم % غير مأمون عليه الرسل . % 6(@)(@@) % صف لهم حالي وخذ في شرحه % علهم أن يعلموا ما جهلوا ؛ % 7(@)(@@) % واطرح ذكر دمي عندهم ؛ % ليس يودي عندهم من قتلوا . % 8(@)(@@) % كم أثاروا من جوى في مهجتي % % عندما قالوا سلا ؛ قلت سلوا . % 9(@)(@@) % كل شيء متلقى منهم % بقبول ؛ قطعوا أو وصلوا % % 10(@)(@@) % آه كم أتبع زفرات الهوى % % زفرات بعدها تتصل . % PageV01P330 11(@)(@@) % آه مالي ولأسباب الهوى % % ما لها عني لا تنفصل % % 12(@)(@@) % بأبي من إن تثنى أو رنا % % تخجل البيض وتعنو الأسل % 13(@)(@@) % وتغار الشمس منه إن بدا % % ويغور القمر المكتمل . % 14(@)(@@) % مقلتاه سحرت لبي ولا % % يسحر الألباب إلا المقل ؛ % 15(@)(@@) % كيف كتمان صباباتي به % وبها يضرب فيه المثل % 16(@)(@@) % أترى يصرفني عن حبه % % عاذلي إن طال منه العذل % 17(@)(@@) % لا . . ومن أخرسني عن عذله ؛ % ذاك أصل عنه لا أنتقل . % PageV01P331 البحر : - 1(@)(@@) % قرأت من الصبابة كل فن % فسل عما بدا لك وامتحني ؛ % 2(@)(@@) % ولا تسأل من العشاق غيري % % فقد أخذت فنون العشق عني ؛ % 3(@)(@@) % وقل ما شئت في لومي فإن لم % تجد لي نحوه ميلا . . فدعني . % 4(@)(@@) % بروحي ؛ لين الأعطاف عذب % % اللمى مر الجفا حلو التثني % % 5(@)(@@) % رشيق القد وضاح المحيا ؛ % فقل ما شئت في بدر وغصن ؛ % 6(@)(@@) % أصرح باسمه طورا وطورا % أخاف حواسدي فيه فأكنى ؛ % 7(@)(@@) % وأقطع في ترجي الوصل عمري % % وما يجدي الترجي والتمني . % PageV01P332 البحر : - 1(@)(@@) % قد أجبنا هواك لما دعانا % % وعصينا العذول حين نهانا . % 2(@)(@@) % ووردنا من بحر حبك وردا % صافيا دونه الكماة تفانى ؛ % 3(@)(@@) % وبذلنا النفوس ثم ولم نن % % كل ضرابا مندونه وطعانا % % 4(@)(@@) % واستطبنا طعم المنون على % % ذاك ؛ كأن المنون فيه منانا % % 5(@)(@@) % كم حطمنا على رباك جهارا % تارة صارما وطورا سنانا ؛ % 6(@)(@@) % ووصلنا إلى حماك وصلنا % % صولة تترك الشجاع جبانا ؛ % 7(@)(@@) % ورأينا صعب الأمور ذلولا % رب صعب على المحبين هانا ؛ % 8(@)(@@) % يا زماني بحاجر و المصلى % وبوادي النقا 
ms82	 ؛ سقيت زمانا ؛ % 9(@)(@@) % كم عمرنا تلك الربى بالأماني % % إذ أخذنا من الليالي أمانا . % 10(@)(@@) % ونهضنا بلا ثوان وما فاز % % بإدراك سؤله من تواني % % PageV01P333 11(@)(@@) % وجررنا من السرور ذيولا % وسحبنا من الهنا أردانا . % 12(@)(@@) % في رياض قد حاكت السحب فيها % % من مناديل زهرها ألوانا . ؛ % 13(@)(@@) % ما رضينا من بعدهن ربوعا % لا ؛ ولا بعد أهلها سكانا ؛ % 14(@)(@@) % يا حلولا بالسفح من شعب نعمان % % سقى صيب الحيا نعمانا ؛ % 15(@)(@@) % لم نزل ذاكري العهود ؛ فهل تخطر بالبال منكم ذكرانا . . % % PageV01P334 البحر : - 1(@)(@@) % صدقت ؛ الصبر أجمل يا فلان ؛ % فهل لي من لواحظه أمان % 2(@)(@@) % نصحت ؛ ولم تزل خلا شفيقا ؛ % فمن لي لو وعت مني الأذان % % 3(@)(@@) % عرفتك بالوفاء فكن معيني % % على وجدي فمثلي من يعان ؛ % 4(@)(@@) % وفي كلل الأحبة والحنايا . . % فؤاد بان عني يوم بانوا ؛ % 5(@)(@@) % تملكه كحيل الطرف ألمى % % عنت لجماله الغيد الحسان ؛ % 6(@)(@@) % يقاتل باللحاظ ولا سهام % ويطعن بالقوام ؛ ولا سنان ؛ % 7(@)(@@) % لساحر طرفه غزل وفتك % بنا ؛ وكذا يكون الافتتان . % PageV01P335 البحر : - 1(@)(@@) % طول ؛ فشوقي باعه أطول % ولم فلا أسمع ؛ لا أعقل % 2(@)(@@) % الحب لا يخرج عن مهجتي % % والعذل في أذني لا يدخل ؛ % 3(@)(@@) % قد ملأ القلب الهوى قبله % فدعه حتى يخرج الأول ؛ % 4(@)(@@) % وانظر إلى من في غرامي به % % شاركني من قبلك العذل ؛ % 5(@)(@@) % فشبهة العذل إذا ما بدا % % وجه الذي همت به تبطل % 6(@)(@@) % وقلت بي من حبه جنة % صدقت ؛ فانصح رجلا يعقل . % PageV01P336 البحر : - 1(@)(@@) % كم ذا الجفا وإلى متى الهجر % شب الهوى وتعذر الصبر ؛ % 2(@)(@@) % ذهبت قوى قد كنت أعرفها % % وتجلد أودى به الدهر ؛ % 3(@)(@@) % حتام أحمل فيك من كلفي % % ما لا يطيق لحمله الصخر % 4(@)(@@) % ومعنف أدى نصيحته % % لو لم يكن في مسمعي وقر % 5(@)(@@) % ماذا على العذال لو عذروا % % إذ في الهوى العذري لي عذر ؛ % 6(@)(@@) % عيني هذا وقت جودكما % % فتدفقا فكلاكما بحر . % PageV01P337 البحر : - 1(@)(@@) % أظبا كناس ؛ أم أسود عرين % عرضت لنا بالسفح من يبرين % 2(@)(@@) % كيف الحياة لمن أضل فؤاده % ما بين بيض طلى وسود عيون % 3(@)(@@) % ما كنت 
ms83	 أحسب أن آساد الشرى % % تضحي فرائس للظباء العين % 4(@)(@@) % بأبي الذي ما قل فيه تصبري % % إلا وزادت في هواه شجوني ؛ % 5(@)(@@) % رشأ يصول من القوام بذابل ؛ % ومن الجفون بصارم مسنون ؛ % 6(@)(@@) % ترك الورى من لحظه وقوامه % ما بين مضروب وبين طعين % 7(@)(@@) % بعت الفؤاد بوقفة يوم النوى % % فمضى ؛ وعدت بصفقة المغبون . % PageV01P338 البحر : - 1(@)(@@) % من علم اللفظ سحر الناظر الساجي % % وصاغ تحت الطلى حقين من عاج % 2(@)(@@) % ومن أقام قضيب البان منتصبا % على كثيب من الأرداف رجراج % % 3(@)(@@) % وأطلع البدر من لألاء غرتها % % يضيء في جنح ليل الطرة الداجي % % 4(@)(@@) % لله ما حاز ذاك القد من هيف % وذلك الخد من حسن وإبهاج ؛ % 5(@)(@@) % شمس تنقل من أحشاء من فتنت % من الأنام بأفلاك وأبراج . % 6(@)(@@) % فلا تسل كم سبت وجدا وكم قتلت % يوم الفراق ولكن سل عن الناجي % % PageV01P339 البحر : - 1(@)(@@) % يا قاتل الله عيني كم أضن بها % % وليس ترضى سوى قتلي وإهلاكي . % 2(@)(@@) % يا عين ؛ ما كان ظني فيك أن تردي % % بمهجتي بين سفاح وسفاك % % 3(@)(@@) % غررت يا عين قلبي بالغرام وما % % قد كان أغناه عن هذا ؛ وأغناك ؛ % 4(@)(@@) % كلفته حمل أعباء الهوى فغدا % % صبا ؛ وما كان يدري الحب لولاك ؛ % PageV01P340 البحر : - 1(@)(@@) % أي سيف نضته لي جفناكا % % أي رمح هزته لي عطفاكا % % 2(@)(@@) % كنت لا أعرف الغرام إلى أن % عرفتني فنونه عيناكا . % 3(@)(@@) % أنت أخفيتني نحولا ؛ فقل لي % % كيف أقوى على احتمال جفاكا % % 4(@)(@@) % لو لشمس الضحى برزت لقالت % لعن الله من أحب سواكا . % 5(@)(@@) % أو رأى البدر نور وجهك نادى % % ته دلالا فأنت أهل لذاكا % % PageV01P341 البحر : - 1(@)(@@) % هم أودعوه الذي أودعوا ؛ % فلوموه إن شئتم أو دعوا ؛ % 2(@)(@@) % فعن ذلك الأمر لا ينتهي % % وعن ذلك الشان لا يرجع ؛ % 3(@)(@@) % وفي الركب فتانة ؛ في الحشا % % لها مستقر ومستودع ؛ % 4(@)(@@) % حمتها النصال بأيدي الرجال % وبيض الظبي والقنا الشرع ؛ % 5(@)(@@) % حداهم برغمي غراب النوى % % وهبت بهم ريحها الزعزع ؛ % 6(@)(@@) % أقامت شجوني من بعدهم % وأزمع صبري إذ أزمعوا % % 7(@)(@@) % سقى الله من أجلهم لعلعا % وأين وأين 
ms84	 ترى لعلع % 8(@)(@@) % أحيي الربوع وهم مقصدي % % وإن قلت حييت يا مربع % 9(@)(@@) % وقد كان قدما بهم عامرا ؛ % فها هو من بعدهم بلقع ؛ % 10(@)(@@) % وفي أثر العيس لما سروا % % فتى قلبه مؤلم موجع ؛ % PageV01P342 11(@)(@@) % محب قضية أشجانه % % إلى دولة الحسن لا ترفع ؛ % 12(@)(@@) % وهون قوم عليه الهوى % % فأصبح من ورده يكرع % 13(@)(@@) % توهمه سلسا صعبه ؛ % وكم حاذق في الهوى يخدع % 14(@)(@@) % هو الموت لا جسد ناحل % ولا طول سهد ولا مدمع ؛ % 15(@)(@@) % ولا الريح تسري ولا بارق % يظل على بارق يلمع ؛ % 16(@)(@@) % فهاتيك علات أهل الهوى % % ولي دونهم في الهوى منزع % 17(@)(@@) % وخالي الحشا سامني سلوة % ولم يدر ما حوت الأضلع % 18(@)(@@) % يلوم شجيا عن الحب ما % % خلا منه عضو ولا موضع % 19(@)(@@) % فيا عاذلي أين من يرعوي % % ويا ناصحي ؛ أين من يسمع % % PageV01P343 البحر : - 1(@)(@@) % مقيم في اقترابي وابتعادي % % على عهد المحبة والوداد ؛ % 2(@)(@@) % خيالك لا يبرح قيد فكري % % وحبك ليس ينزح عن فؤادي ؛ % 3(@)(@@) % خلقت لشقوتي ولطول حيني % % على شرط اختياري وانتقادي ؛ % 4(@)(@@) % ولولا سحر عينك لم تجدني % % وحقك في الهوى سلس القياد ؛ % 5(@)(@@) % فزدني ما استطعت فلى وصدا % فحاكمنا غدا رب العباد . . % 6(@)(@@) % وقد يعمى الهوى بصري فأدعو % % عليك بغير قصد واعتماد % 7(@)(@@) % ولولا أن تنم بنا اللواحي % % وتسلقنا بألسنة حداد ؛ % 8(@)(@@) % لكنت أريك صبرا في انتقاص % بليت به ووجدا في ازدياد % 9(@)(@@) % وقلبا لا ترق له وترثي % % وقد رقت له فيك الأعادي ؛ % 10(@)(@@) % وخال عن هواك أطال لومي % % ودون سماعه خرط القتاد ؛ % PageV01P344 11(@)(@@) % فقلت له رويدك لا تلمني % % فلومك غير مجد في اعتقادي . . % 12(@)(@@) % أمأسور فؤادك أم فؤادي % % ومسلوب رقادك أم رقادي % % PageV01P345 البحر : - 1(@)(@@) % برح الشوق فواصل % أنت عما بي غافل ؛ % 2(@)(@@) % زر ؛ فأيام المحبين % % كما قيل قلائل ؛ % 3(@)(@@) % قد تركت القلب مني % % ذاهبا والعقل ذاهل % 4(@)(@@) % بأبي بدرا بدا لي % % في سماء الحسن كامل ؛ % 5(@)(@@) % كلما فوق سهما . . % لم يصب إلا المقاتل % 6(@)(@@) % ردفه للخصر منه % ظالم ؛ والقد عادل ؛ % 7(@)(@@) % أقوام ذاك أم غصن نق % % ا 
ms85	 في الدوح مائل % 8(@)(@@) % وعيون فاترات % تلك أم أسحار بابل % 9(@)(@@) % وخدود قانيات % أم ورود في غلائل % 10(@)(@@) % قيدتني عارضاه % لهواه بسلاسل ؛ % PageV01P346 11(@)(@@) % قال لي لما رآني % % من هواه في حبائل % 12(@)(@@) % حاجبي المقرون نون % وعذاري سال سائل % 13(@)(@@) % قد مضى العمر وولى % لم أفز منه بطائل ؛ % 14(@)(@@) % لست أصغي في هواه % لوشاة أو عواذل ؛ % 15(@)(@@) % إن دين الحب حق % وسلوي عنه باطل ؛ % 16(@)(@@) % فدع العاذل فيه % فليقل ما هو قائل . % 17(@)(@@) % هو لا شك لما بي % % من جوى في القلب جاهل ؛ % 18(@)(@@) % أنكر العاذل وجدي % % وعلى الوجد دلائل ؛ % 19(@)(@@) % وكفى السقم دليلا % ودم في الخد هامل . % PageV01P347 البحر : - 1(@)(@@) % يا طلعة القمر المنير % يا قامة الغصن النصير ؛ % 2(@)(@@) % يا جنة الخلد التي % % تركت فؤادي في السعير % 3(@)(@@) % يا من يجل عن المشا % % به والمماثل والنظير ؛ % 4(@)(@@) % يا آسري في حبه % هل من فكاك للأسير % % 5(@)(@@) % أودى بعزم تجلدي % % ما في لحاظك من فتور ؛ % 6(@)(@@) % يوم تكون به لدي % يتم لي فيه سروري % % 7(@)(@@) % وأقول يا يوم اللقا % % عمرت من يوم قصير . % PageV01P348 البحر : - 1(@)(@@) % يا من أطال التجني % % منك الصدود ؛ ومني . % 2(@)(@@) % مولاي ؛ إن طال هذا % % علي ؛ فاعلم بأني . % 3(@)(@@) % أفديك قل لي ماذا % % الذي بدا لك مني % % 4(@)(@@) % تركتني مستهاما . . % حيران أقرع سني ؛ % 5(@)(@@) % أشكو إليك الذي بي % % وأنت تعرض عني % % 6(@)(@@) % ولم ترق لحالي % % ولا رثيت لحزني ؛ % PageV01P349 البحر : - 1(@)(@@) % يا طرف أنجد بالدموع % فأنت جالب محنتي ؛ % 2(@)(@@) % واصبر على فقد المنام % فأنت أصل بليتي ؛ % 3(@)(@@) % ولقد نصحتك لو سمعت % ولو قبلت نصيحتي ؛ % 4(@)(@@) % أن اللواحظ ربما % % قتلت بأول نظرة % 5(@)(@@) % . . . خالفتني وعصيتني % % وفعلت فعلتك التي % % PageV01P350 البحر : - 1(@)(@@) % أنا والله منك في % % محن لا أطيقها ؛ % 2(@)(@@) % بين قلب تذيبه % % ودموع تريقها % % 3(@)(@@) % كيف تسلوك مهجة % ليس يطغى حريقها % % 4(@)(@@) % كيف تنساك أضلع ؛ % ليس يهدا خفوقها % % PageV01P351 البحر : - 1(@)(@@) % يا كعبة الحسن التي % % حجي إليها واعتماري ؛ % 2(@)(@@) % يا جنة الخلد التي . . % لم ألق منها غير نار % 3(@)(@@) % يا ربرب الحسن الذي % % خضعت 
ms86	 له الأسد الضواري % % 4(@)(@@) % يهنيك عزك ؛ إنني % % في قيد ذل ؛ وانكسار ؛ % 5(@)(@@) % لو أن لي بك قوة % لأخذت من عينك ثاري ؛ % 6(@)(@@) % لكن ؛ هواك علي جار % وهد أركان اصطباري % % PageV01P352 البحر : - 1(@)(@@) % يا جبين القمر التم % ويا قد القضيب ؛ % 2(@)(@@) % والذي أمرض جسمي % % في الهوى ؛ وهو طبيبي % % 3(@)(@@) % لا تطل هجران صب % مغرم القلب كئيب ؛ % 4(@)(@@) % فلقد طال لطول الهج % % ر حزني ونحيبي ؛ % 5(@)(@@) % واعتراني الشك ؛ هل أنت % عدوي أم حبيبي % % PageV01P353 البحر : - 1(@)(@@) % أترى يسلو الهوى وله % عند سكان الحمى وله % 2(@)(@@) % مغرم في قلبه حزن % فصل الهجران مجمله ؛ % 3(@)(@@) % عظمت أسقامه فغدا % % لا يراه من تأمله % 4(@)(@@) % لو رأى من ظل يعذله % % وجه من في الحب أنحله ؛ % 5(@)(@@) % قال أما فيك لا حرج ؛ % إن قضى وجدا ؛ يحق له % % PageV01P354 البحر : - 1(@)(@@) % أصخ لشكيتي وارفق % بجسم فيك قد نحلا ؛ % 2(@)(@@) % وقل لي من أحل دمي % % ومن ذا حرم القبلا % 3(@)(@@) % وإن تنكر ضنى جسدي % % ولم تعطف علي ؛ ولا . . . % 4(@)(@@) % فكف النبل من عينيك ؛ % يكفي بعض ما فعلا . % 5(@)(@@) % ولا تطلع لنا خداك % % ورد راضها الخضلا . % PageV01P355 البحر : - 1(@)(@@) % كن كما شئت ؛ إن حبك فني % % وجميع العشاق تأخذ عني ؛ % 2(@)(@@) % لو أراد الفؤاد عنك سلوا ؛ % قلت ؛ سرعن جوانحي لست مني % % 3(@)(@@) % أتراني أسلو لطول صدود % لا ؛ وما فيك من بدائع حسن ؛ % 4(@)(@@) % كل من يعشق الملاح سيبلى % % بصدود وفرقة وتجني . % PageV01P356 البحر : - 1(@)(@@) % يكفيك يا ذات اللمى يكفيك % ما قد لقيت من الصبابة فيك ؛ % 2(@)(@@) % داوي ضنى في القلب أنت جلبته % فدواء دائي رشفة من فيك ؛ % 3(@)(@@) % أفديك قد عبثت صبابات الهوى % % بي ؛ فارفقي يا منيتي أفديك ؛ % 4(@)(@@) % والله ما ترك الهوى مني سوى % % جسم نحيل أو دم مسفوك % PageV01P357 البحر : - 1(@)(@@) % يا طلعة البدر وقد القضيب % متى بطيب الوصل عيشي يطيب % % 2(@)(@@) % ويا غريب الحسن رفقا بمن % غربه هذا الجمال الغريب % 3(@)(@@) % أشمت أعدائي بطول الجفا ؛ % قل لي عدو أنت لي أم حبيب % PageV01P358 البحر : - 1(@)(@@) % حتام أكتم فيك الشوق والكمدا % % وأنفق العمر في وجدي عليك 
ms87	 سدى % % 2(@)(@@) % وكم أردد زفراتي وأكتمها ؛ % إذا انقضت نهد أتبعتها نهدا . % PageV01P359 البحر : - 1(@)(@@) % وساتر خده بمصحفه % % قلت له والفؤاد في قلق ؛ % 2(@)(@@) % خفت على الخد من لواحظنا % % يا غصن حتى استترت بالورق % % PageV01P360 البحر : - 1(@)(@@) % قاتلي في هواه من غير ذنب % قل لعينيك أي ذنب لقلبي % % 2(@)(@@) % وسل السمهري قدك لم ذا % % خصني بالغرام من دون صحبي % % 3(@)(@@) % مر عمري على الصدود فهل يغلط % دهري بيوم وصل وقرب % PageV01P361 البحر : - 1(@)(@@) % ترفق بجسم قد أضر به الهوى % % وقلب معنى فيك فارقه الصبر ؛ % 2(@)(@@) % فلم يبق مني الحب غير بقية % وعما قريب سوف يذهبها الهجر % PageV01P362 البحر : - 1(@)(@@) % قال له الحاسدون لاظفروا % % منه بغير البعاد والصد % 2(@)(@@) % ما باله قد سلاك قال لهم % % حاشاه هذا فؤاده عندي % % PageV01P363 البحر : - 1(@)(@@) % ومعذبي من لا أبوح بذكره % ما دمت في أسر الهوى وقياده ؛ % 2(@)(@@) % صنم غدا يدعو إلى دين الهوى % % لولا التقية كنت من عباده % % PageV01P364 البحر : - 1(@)(@@) % أنا من إذا سمع الورى % % غزلي الرقيق وما حوى ؛ % 2(@)(@@) % قالوا أجاد ؛ وما دروا % % أني نطقت عن الهوى % % PageV01P365 البحر : - 1(@)(@@) % حسبي من التعنيف حسبي ؛ % أنا ما عشقت بغير قلبي ؛ % 2(@)(@@) % دعني ؛ ومن أهوى فقد % % ملكته روحي ولبي % % PageV01P366 البحر : - 1(@)(@@) % وبديع الحسن ألمى % % أحور العينين أحوم ؛ % 2(@)(@@) % أنا أبكي من جفاه % وهو مني يتبسم ؛ % 3(@)(@@) % كدت أن أهلك فيه % % غير أن الله سلم . % PageV01P367 البحر : - 1(@)(@@) % ومر التجنب حلو اللمى % % لألبابنا باللحاظ استرق ؛ % 2(@)(@@) % بدا فلق الصبح من وجهه % فقلت أعوذ برب الفلق ؛ % 3(@)(@@) % ولم أدر لما رنا طرفه ؛ % عدو رمى ؛ أم حبيب رمق % % PageV01P368 البحر : - 1(@)(@@) % حمامة الأيك مهلا % فقد أطلت نواحي . % 2(@)(@@) % أتشتكين بعادا % وأنت ذات جناح % PageV01P369 البحر : - 1(@)(@@) % أنا والله مغرم % بك صب معذب ؛ % 2(@)(@@) % لي دمع مرقرق % وفؤاد مذبذب ؛ % PageV01P370 البحر : - 1(@)(@@) % قال العذول إلام تعشقه % وكم تصبو إليه % 2(@)(@@) % فأجبته دعني أخادعه ؛ % فقلبي في يديه % PageV01P371 البحر : - 1(@)(@@) % وأحور المقلتين أحوى % % كأنه البدر مستديرا ؛ % 2(@)(@@) % لما رأى خده رياضا % أفاض من عينه غديرا ؛ % PageV01P372 البحر : - 1(@)(@@) % نفسي الفداء لمن عاتبته وله 
ms88	 % في مهجتي فتكات البيض والأسل ؛ % 2(@)(@@) % فظل ينثر من ألفاظه دررا % أرق من أدمعي فيه ومن غزلي . % PageV01P373 البحر : - 1(@)(@@) % عجب الناس عندما حجبوا % % منه هلالا ذا بهجة وسناء ؛ % 2(@)(@@) % قلت لا تعجبوا لبدر تمام % حجبته سحابة الرقباء % PageV01P374 البحر : - 1(@)(@@) % لابدع أن يخسف بدر السما % % ذاك لمعنى قد تحققته ؛ % 2(@)(@@) % لما بدا لي وجهه مشبها % وجه حبيبي حين فارقته ؛ % 3(@)(@@) % ذكرت محبوبي من أجله % % صعدت أنفاسي فأحرقته % % PageV01P375 البحر : - 1(@)(@@) % مولاي رفقا بصب % عذبته بصدودك ؛ % 2(@)(@@) % فجل نار فؤادي % % من جلنار خدودك % PageV01P376 البحر : - 1(@)(@@) % بأبي قوام منك لم % يحك الرديني اعتداله ؛ % 2(@)(@@) % ولواحظ قد أورثت % فتك الصوارم عن كلاله % PageV01P377 البحر : - 1(@)(@@) % دعهم يقولوا ؛ فبي فوق الذي قالوا % % سقم وسهد ودمع فيك همال ؛ % 2(@)(@@) % يا من أفند جهلا في محبته % ما لي عليك سوى الحساد عذال ؛ % 3(@)(@@) % ما حركوا بملامي منهم شفة ؛ % إلا وزادوا غرامي فيك لا زالوا . % PageV01P378 البحر : - 1(@)(@@) % دمنا بأكناف العقيق خوالي % % حييت من دمن ومن أطلال ؛ % 2(@)(@@) % وسقت سماء الشوق ربعك دائما % بسحائب من مقلتي ثقال % 3(@)(@@) % لله كم أرخصت فيك مدامعا % قد كن من قبل الفراق غوالي ؛ % PageV01P379 البحر : - 1(@)(@@) % أقول لعذل راموا اصطباري % % وصبري عنك عين المستحيل ؛ % 2(@)(@@) % هبوا وجدي كما قلتم قبيحا % فدلوني على الصبر الجميل . % PageV01P380 البحر : - 1(@)(@@) % أيا طلعة القمر الزاهر % ويا قامة الغصن الناضر % 2(@)(@@) % غرامي ليس له أول % فهل لصدودك من آخر % PageV01P381 البحر : - 1(@)(@@) % قالوا نراك طويت عن ذكر الصبا % % كشحا ؛ ومثلك من يحن إليه ؛ % 2(@)(@@) % فأجبت شيبني الزمان ولم أجد % طعم الصبا ؛ حتى أنوح عليه % PageV01P382 البحر : - 1(@)(@@) % جزى الله بالحسنى عذولي وإن يكن % أثار لهيبا في الفؤاد وسعرا ؛ % 2(@)(@@) % وما ذاك إلا أنه حين لامني % % توهم سهوا من فؤادي فذكرا . % PageV01P383 البحر : - 1(@)(@@) % يا قليل الحفظ للذمم % أي شرع فيه حل دمي % % 2(@)(@@) % هل لمن أتلفت مهجته % يا شقيق النفس من حكم % PageV01P384 البحر : - 1(@)(@@) % وأهيف مشروط الخدود لطرفه % إذا ما رنا فعل السيوف القواضب ؛ % 2(@)(@@) % له غرة فتانة تنتمي إلى % % هلال وطرف ينتمي لمحارب % % 3 
ms89	(@)(@@) % يعيبونه جهلا بشرط خدوده % % وما فيه لا والله عيب لعايب ؛ % 4(@)(@@) % ولكنما هاتيك أسياف لحظه % بهن فلول من قراع الكتائب % PageV01P385 البحر : - 1(@)(@@) % مشروطة خطرت ترنح قامة % % يزري الذوابل لينها وشطاطها ؛ % 2(@)(@@) % قامت قيامة عاشقيها في الهوى % % لما بدت وبدت لهم أشراطها ؛ % PageV01P386 البحر : - 1(@)(@@) % ولم أخف السقام لأجل موتي % % سقاما ؛ أو لإشمات الأعادي ؛ % 2(@)(@@) % ولكني خشيت إذا تمادى % % يبين محل سرك في فؤادي % % PageV01P387 البحر : - 1(@)(@@) % كيف أقوى على التثامي ثغرا % من حبيبي أو ارتشاف لماه % 2(@)(@@) % ولحاتي تصدني عن مرامي % % كلما رمت أن أقبل فاه . % PageV01P388 البحر : - 1(@)(@@) % وثلاث لما بدت لي منها % % سلبتني بهن ثوب وقاري ؛ % 2(@)(@@) % حاجباها ومقلتاها وما تنثر % من در لفظها السحار ؛ % 3(@)(@@) % كالقسي المعطفات وكالأس % % هم مبرية وكالأوتار % PageV01P389 البحر : - 1(@)(@@) % رأى عاذلي من همت فيه صبابة % ولم يبق لي فيه اصطبار ولا جلد ؛ % 2(@)(@@) % فقال أهذا الشادن الأحور الذي % % رماك بطرف منه قلت نعم وقد % PageV01P390 البحر : - 1(@)(@@) % وتنكر وجدي وما سار من % نظامي فيها مسير المثل ؛ % 2(@)(@@) % وها أنا والله في حبها % % صريغ الغواني جريح المقل % PageV01P391 البحر : - 1(@)(@@) % لي مقلة مقروحة لبعدكم % فيها لسحب أدمعي تراكم ؛ % 2(@)(@@) % ردوا عليها نومها تفضلا % لعلها في النوم أن تراكم % PageV01P392 البحر : - 1(@)(@@) % لي مقلة مقروحة لفراقكم % ما انفك بحر دموعها متدفقا ؛ % 2(@)(@@) % جنت وزال رقادها من بعدكم % % بيد الفراق فعوذوها بالرقا % % PageV01P393 البحر : - 1(@)(@@) % أما الوشاة فأنت أعلم منهم % بجميع ما ابديه أو أخفيه ؛ % 2(@)(@@) % وكذا العواذل قد سددت مسامعي % % عن عذلهم ما عشت لست أعيه ؛ % 3(@)(@@) % صنفان ؛ أمرهما يسير هين ؛ % أما الرقيب فحار أمري فيه . % PageV01P394 البحر : - 1(@)(@@) % إن كنت تنكر دمعي للفراق وقد % % جرى فأظهر ما قد كنت أخفيه ؛ % 2(@)(@@) % فلا تسل غير طرفي عن مدامعه ؛ % لا تأخذ الماء إلا من مجاريه % % PageV01P395 البحر : - 1(@)(@@) % أهيل المنحنى رفقا بصب % أخذتم قلبه وتركتموه ؛ % 2(@)(@@) % فكل من غرامي واصطباري % % غداة البين قد أضعفتموه ؛ % PageV01P396 البحر : - 1(@)(@@) % بأهل المنحنى عرج وأبلغ % من الصب المشوق بهم سلامه ؛ % 2(@)(@@) % وإياك الحريق بنار قلبي % % إذا جئت الغضا ؛ ولك السلامه 
ms90	 % % PageV01P397 البحر : - 1(@)(@@) % أفدي غزالا صاد القلوب معا % فكلها في هواه مشتركة ؛ % 2(@)(@@) % أبدى لها صدغه وعارضه % هذاك فخ ؛ وهذه شبكة . % PageV01P398 البحر : - 1(@)(@@) % يا ساكني السفح مذ رحلتم % % دمعي من بعدكم غزير ؛ % 2(@)(@@) % أسرتموني ؛ فأطلقوني % % ها أنا في حبكم أسير % PageV01P399 البحر : - 1(@)(@@) % قد كتب الله على خده % % بالمسك سطرا دق معناه ؛ % 2(@)(@@) % فقلت للعشاق لما بدا % % صبرا على ما كتب الله % PageV01P400 البحر : - 1(@)(@@) % ظننت وقد نظرت إلى سناها % % بأن النيرات لها ضرائر ؛ % 2(@)(@@) % فمذ أبصرت ليل الفرع منها % % رأيت الفرق مثل الصبح ظاهر ؛ % PageV01P401 البحر : - 1(@)(@@) % يا من بطول التجافي % % والهجر أمرض صبه ؛ % 2(@)(@@) % أنت الطبيب ؛ فمن لي % % من ريق فيك بشربه % PageV01P402 البحر : - 1(@)(@@) % لا ذقت حر صبابتي % % وكفيت ما ألقى بها ؛ % 2(@)(@@) % فالنار من أسمائها % % والموت من ألقابها % % PageV01P403 البحر : - 1(@)(@@) % غالطتني بقولها ؛ % لي وقد برح القلى ؛ % 2(@)(@@) % سوف آتيك في الكرى % % قلت رديه أولا % % PageV01P404 البحر : - 1(@)(@@) % وبابلي لحاظ % ذي قامة سمهرية ؛ % 2(@)(@@) % سكرت من مقلتيه % لأنها بابليه % % PageV01P405 البحر : - 1(@)(@@) % لي فيك قلب ما انتهى % % عن غيه ولا ارعوى ؛ % 2(@)(@@) % وأضلع مما بها . . % كادت تطير في الهوا % % PageV01P406 البحر : - 1(@)(@@) % أيا شادنا أغرى السهاد بناظري % % وأنحل جسمي حبه وبراني ؛ % 2(@)(@@) % تعيش وتبقى أنت في نعمة فما . . % أراك إذا طال الصدود تراني % % PageV01P407 البحر : - 1(@)(@@) % كم أكتم لوعتي وكم أخفيها % % والدمع إذا جرى دما يبديها % % 2(@)(@@) % يا مالك مهجتي رويدا بشج ؛ % ها مهجته لديك ؛ فانظر فيها ؛ % PageV01P408 البحر : - 1(@)(@@) % أترى صحا وأفاقمن سكر الجوى % % 2(@)(@@) % ولوى عنان عهود سكان اللوى % % 3(@)(@@) % هيهات ؛ بل أذكت جواه يد النوى ؛ % % 4(@)(@@) % وغدت يد التذكار تنشر ما انطوى ؛ % % 5(@)(@@) % وإلى العقيق صبا وقد كان ارعوى ؛ % % 6(@)(@@) % وبدا له من بعد ما اندمل الهوى % % برق تألق موهنا لمعانه % % 7(@)(@@) % فأباح من سر الغرام مصونه % % 8(@)(@@) % وأسال الأض من ماء العيون عيونه % % 9(@)(@@) % وأطال لوعته وزاد حنينه % % 10(@)(@@) % آها له برقا أثار شجونه % % PageV01P409 11(@)(@@) % كالسيف أخلصت القيون متونه % % 12(@)(@@) % يبدو كحاشية الرداء ودونه % % صعب الذرى متمنع أركانه % % 13(@)(@@) % مذ لاح جانسه بلفظ 
ms91	 متفق ؛ % % 14(@)(@@) % شرب الدموع وقد شرى حتى شرق ؛ % % 15(@)(@@) % وأصابه سكر الغرام فلم يفق % % 16(@)(@@) % ونفى الكرى فجفونه لم تنطبق ؛ % % 17(@)(@@) % وأراد يشفى قرح ناظره الأرق ؛ % % 18(@)(@@) % فمضى لينظر كيف لاح فلم يطق % نظرا إليه وصده سبحانه % 19(@)(@@) % أترى الفؤاد إلى السلو يطيعه ؛ % % 20(@)(@@) % ويصح عن دعوى الغرام رجوعه % % PageV01P410 21(@)(@@) % والبرق يفي سره ويذيعه ؛ % % 22(@)(@@) % هبه حكى ما قد روته دموعه ؛ % % 23(@)(@@) % في الحب ؛ أين لهيبه وولوعه % % 24(@)(@@) % فالنار ما اشتملت عليه ضلوعه % والماء ما سمحت به أجفانه % % PageV01P411 البحر : - 1(@)(@@) % قال الحسن أثغرك أم برد جامد % أم الدر نضده الناضد % % 2(@)(@@) % فقال السيد ووجهك أم قمر طالع % % وقدك أم غصن مائد % 3(@)(@@) % فقال الحسن أيا منكرا فرط حبي له % % وما أنا في حبه واحد % 4(@)(@@) % أما لي من أدمعي حجة % عليك ومن سقمي شاهد % 5(@)(@@) % فقال السيد لي والله صبري غدا ناقصا % فشوقي طول المدى زايد % 6(@)(@@) % فديتك صلني فقد شف % % ني السقام وملني العائد ؛ % 7(@)(@@) % فقال الحسن أطلت سهادي فحتى متى % % تطيل سهادي يا راقد % 8(@)(@@) % سمعت الوشاة وما زخرفوا % % وصدقت ما قاله الحاسد % 9(@)(@@) % فقال السيد لقد حل ما حل بي منك من % % غرام أقر له الجاحد ؛ % 10(@)(@@) % خلقت لكل الورى فتنة % فضل بك الناسك الزاهد ؛ % PageV01P412 البحر : - 1(@)(@@) % إلى غيركم قلبي المتيم لا يصبو % % ومن أجلكم زند الهوى فيه لا يخبو % % 2(@)(@@) % وأني وجيش الحب بالقلب محدق % وكيف يكف النار من دونه الحرب % 3(@)(@@) % فقال الحسن الهبل % % 4(@)(@@) % يلومني العذال في ولهي بكم % % وإني إلى قول العواذل لا أصبو ؛ % 5(@)(@@) % وماذا عسى تجدي الملامة في الهوى % % لمن لا له في الحب جسم ولا قلب % 6(@)(@@) % فقال السيد % % 7(@)(@@) % يمينا بكم ما حلت عن صدق ودكم % % وتربة صبري إنني للهوى ترب ؛ % 8(@)(@@) % ولولا هواكم ما طربت لمنشد % ولا شاقني من ذكره الجزع والشعب % 9(@)(@@) % فقال الحسن % % 10(@)(@@) % أحبابي أنتم غبتم أم دنيتم % % وسيان عندي منكم البعد والقرب ؛ % PageV01P413 11(@)(@@) % وحاشاكم أن تهجروني بعدما % % علمتم بأني مغرم بكم صب % PageV01P414 البحر : - 1 
ms92	(@)(@@) % متيم شفه السقام % تشجيه إن غنت الحمام ؛ % 2(@)(@@) % في حب ساجي الرنا غرير % في ريقه الشهد والمدام ؛ % 3(@)(@@) % فقال الحسن الهبل % % 4(@)(@@) % كأنه في الأثيل منه % بدر دجى حفه الظلام % 5(@)(@@) % أنفقت صبري على هواه % وحظي السهد والسقام ؛ % 6(@)(@@) % فقال السيد % % 7(@)(@@) % عذب اللمى ؛ كم أهيم فيه % وجدا ؛ ولا ينفع الهيام ؛ % 8(@)(@@) % وكم قطعت الظلام سهدا % حتى جفا جفني المنام ؛ % 9(@)(@@) % فقال الحسن % % 10(@)(@@) % يمنعني وصله لحيني % % كأنما وصله حرام ؛ % PageV01P415 11(@)(@@) % ولا كتاب ولا جواب % ولا سلام ولا كلام ؛ % 12(@)(@@) % فقال السيد % % 13(@)(@@) % يا قمرا حل عقد صبري % % فما لسري به انكتام ؛ % 14(@)(@@) % الله في مغرم عميد % قد شفه الشوق والغرام % 15(@)(@@) % فقال الحسن % % 16(@)(@@) % وكم خلي يلوم جهلا % وكل من حب لا يلام ؛ % 17(@)(@@) % قالت له مقلتاك مهلا % لا عذل ؛ فالسابق الحسام % 18(@)(@@) % فقال السيد % % 19(@)(@@) % ملكت يا مالكي قيادي % % وصح في كفك الزمام ؛ % 20(@)(@@) % فافعل كما تشتهي فإني % % لم أرض إلاك والسلام ؛ % PageV01P416 21(@)(@@) % فقال الحسن % % 22(@)(@@) % وأبد للحاسدين وجها % لو أبصروا حسنه لهاموا ؛ % 23(@)(@@) % و لا تصخ للوشاة وارفق % بمغرم دمعه سجام ؛ % 24(@)(@@) % فقال السيد % % 25(@)(@@) % أفديك ؛ قد برح الجفا بي % % وقد وهت للقلى العظام ؛ % 26(@)(@@) % وجل مقصودي التلاقي % % أستغفر الله والكلام % 27(@)(@@) % فقال الحسن % % 28(@)(@@) % حملتني في هواك مالا % % يقوى على حمله شمام % 29(@)(@@) % وأمل العاذلون صبري ؛ % يا بعد ما املوا وراموا ؛ % 30(@)(@@) % فقال السيد % % PageV01P417 31(@)(@@) % ما بعد الموت قل وجد % عني ولم ينقض الغرام ؛ % 32(@)(@@) % لكنني قد خفيت سقما % عنه ؛ فلم يلقني الحمام % % 33(@)(@@) % فقال الحسن % % 34(@)(@@) % وفاتر الطرف ليس يرعى % % لديه عهد ولا ذمام ؛ % 35(@)(@@) % بعده الحاسدون عني ؛ % فوصله قط لا يرام . % 36(@)(@@) % فقال السيد % % 37(@)(@@) % أغر حلو اللمى رقيق % للبدر من حسنه التمام ؛ % 38(@)(@@) % يحق لي أن أهيم فيه ؛ % وحق في مثله الهيام % 39(@)(@@) % فقال الحسن % % 40(@)(@@) % ألحاظه كالسهام فعلا % بل فوق ما تفعل السهام % PageV01P418 41(@)(@@) % وقده كالقضيب لينا ؛ % بل دونه السمر والبشام ؛ % 42(@)(@@) % فقال السيد الجرموزي % % 43(@)(@@) % مهفهف حسنه بديع % يقصر عن وصفه 
ms93	 النظام % 44(@)(@@) % في صفحة الخد منه راح % و خاله مسكه ختام . ؛ % PageV01P419 البحر : - 1(@)(@@) % وروضة باكرتها زائرا % والليل قد أزمع للسير ؛ % 2(@)(@@) % قبلت من خيرتها أنملا % لطيفة ما مسها غيري ؛ % 3(@)(@@) % فيا لها في الحسن من روضة % تصبح الزائر بالخير ي % % PageV01P420 البحر : - 1(@)(@@) % يا حبذا يومي بحده % % وبرود عيشي مستجده ؛ % 2(@)(@@) % والغيم قد نشرت يدا % % ه على رقيق الأفق برده % 3(@)(@@) % وعيون نرجسها المراض % تنبهت من بعد رقده ؛ % 4(@)(@@) % والأقحوان غصونه % % نحو الحدائق مستمده ؛ % 5(@)(@@) % وزهوره تحكي الثغور % مقبلات فيه ورده ؛ % 6(@)(@@) % وترى البنفسج والشقيق % % الغض والريحان عنده ؛ % 7(@)(@@) % فاغنم بها صفو المعيشة ؛ % فالنوائب مستعده % 8(@)(@@) % صفو المعاش كما علمت % من العواري المسترده ؛ % 9(@)(@@) % فالعيش مقتبل الصبا % % والعمر لم يبلغ أشده . % PageV01P421 البحر : - 1(@)(@@) % ومشبب بالرقمتين و حاجر % و برامة ؛ دعني وما لا أعرف ؛ % 2(@)(@@) % شبب بحده ؛ أو فدع فهي التي % % أضحت بأنواع المحاسن توصف . % 3(@)(@@) % من أين تلقى مثل حدة أنبني % % هيهات ؛ مثل جمالها لا يعرف % 4(@)(@@) % ما شعب بوان النضير نظيرها % % في الحسن لو أن المخالف ينصف ؛ % 5(@)(@@) % و الصغد يوما لو حكاها بهجة % نادته حسبك أيها المتكلف % % 6(@)(@@) % ومنها % % 7(@)(@@) % وترى حميسا في مجاريه له % ما بين منعطف الغصون تعطف ؛ % 8(@)(@@) % ينساب في الروض انسياب أراقم % أو مثل ما سل الحسام المرهف % 9(@)(@@) % نظم الربيع بها بديع زهورها ؛ % فموشع ومدبج ومفوف . % PageV01P422 البحر : - 1(@)(@@) % سر بنا نحو حدة و سناع % والإكام التي بسفح القاع . % 2(@)(@@) % فذيلته بقولي % % 3(@)(@@) % حيث روض الصبا أريض وغصن % % اللهو رطب وشملنا في اجتماع ؛ % 4(@)(@@) % وكؤوس السرور بين الندامى % % دائرات من كف ذات قناع % 5(@)(@@) % واغتنم لذة التصابي فأيا % % م التداني سريعة الانقطاع % PageV01P423 البحر : - 1(@)(@@) % أرى الروضة الغناء لولا شعوبها % % حوت من معاني الحسن كل غريب ؛ % 2(@)(@@) % يهون لعمري ترك صنعا لأجلها % % وصبر الفتى لولا لقاء شعوب % % PageV01P424 البحر : - 1(@)(@@) % ما زلت عن درن الدنايا صائنا % عرضا غدا كالجوهر الشفاف ؛ % 2(@)(@@) % فإذا جرى مرحا بميدان الصبا % % مهر الهوى الجمته بعفافي ؛ % 3(@)(@@) % وإذا همو وصفوا محاسن شادن % مستكمل 
ms94	 لمحاسن الأوصاف ؛ % 4(@)(@@) % أبديت فيه من النسيب غرائبا % ووصفت منه ما عدا الأرداف . % PageV01P425 البحر : - 1(@)(@@) % تغزلت حتى قيل إني عاشق % وشببت حتى قيل فاقد أوطان % 2(@)(@@) % وما بي من عشق وفقد ؛ وإنما % % أتيت من الشعر البديع بأفنان . % PageV01P426 البحر : - 1(@)(@@) % لم استطع نحوكم خروجا % فكن أخا المكرمات عاذر ؛ % 2(@)(@@) % لأنني قد سكنت بيتا % دارت على بابه الدوائر % 3(@)(@@) % فأجاب عليه القاضي محمد عافاه الله بأبيات أولها % % 4(@)(@@) % شعرك يا بن الكرام أضحى % % ما بيننا في الديار دائر % 5(@)(@@) % ولم أكن شاعرا بأن النبية % % كابن النبية شاعر % PageV01P427 البحر : - 1(@)(@@) % الحمد لله ؛ نلنا السؤل والأربا % % وأذهب الله عنا الهم والنصبا ؛ % 2(@)(@@) % بالعود من ناعط لا كان من بلد % نلنا العناء به والهم والكربا ؛ % 3(@)(@@) % متى أرى ناعطا دون البلاد وقد % % أذكر سنا البرق في أحشائها لهبا % % 4(@)(@@) % لا ينظر المرؤ منه قصد ناحية % إلا رأى منه أو من أهله عجبا ؛ % 5(@)(@@) % قوم لهم خلق تشقى العيون بها % % سود المعارف ؛ لا عجما ولا عربا ؛ % 6(@)(@@) % وقد وجدت مكان القول ذا سعة % فقل بما شئت ؛ لازورا ولا كذبا ؛ % 7(@)(@@) % وقف أبثك بعضا من عجائبه % % واسمع فعندي منه للسميع نبا % % 8(@)(@@) % جزنا به والشتا ملق كلاكله % والبرد من فوقه قد شقق الحجبا ؛ % 9(@)(@@) % في ليلة من جمادى ذات أندية % لا ينظر المرؤ من ظلمائها الطنبا ؛ % 10(@)(@@) % لا ينبح الكلب فيها غير واحدة % حتى يلف على خشومه الذنبا % % PageV01P428 11(@)(@@) % قد نشر الجو رايات الرياح به % وأرسل القر فيه عسكرا لجبا ؛ % 12(@)(@@) % وشن غاراته حتى أثار به % % حربا ضروسا تثير الويل والحربا ؛ % 13(@)(@@) % وغيم النقع من ركض الرياح به % حتى تقنع منه الجو وانتقبا ؛ % 14(@)(@@) % واستقبلت خيم الأجناد جاهدة % % في كسر كل عمود كان منتصبا % % 15(@)(@@) % وأطفأت كل نار في الخيام فلو % % أن الجحيم يلاقي بردها لخبا ؛ % 16(@)(@@) % والخيل خاشعة الأبصار خاضعة % لا تستطيع لما قد نالها هربا ؛ % 17(@)(@@) % ما يطرحون لها في الأرض من علف % إلا وراح بأيدي الريح منتهبا ؛ % 18(@)(@@) % وكل شخص صريع لا يطيق قوى 
ms95	 % % قد لفت الريح منه الرأس والركبا ؛ % 19(@)(@@) % أما الطعام فمثل الماء في عدم % لا نستطيع له في حالة طلبا ؛ % 20(@)(@@) % ظللت أبكي ربيعا في جوانبه % حزنا وأنشد في أرجائه رجبا % % PageV01P429 21(@)(@@) % وقلت للركب هبوا لا أبا لكم % قد جاء ما وعد الرحمن واقتربا . . % 22(@)(@@) % فاسمع لشيء يسير من عجائب لا % % تحصى ومن يدعي حصرا فقد كذبا . % 23(@)(@@) % يا من صبا حين هبت في السحير صبا % % ما أنت أول قلب للنسيم صبا ؛ % 24(@)(@@) % ومنها % % 25(@)(@@) % فقل لنجل علي أنت يا ولدي % % وافقت يوما بموج الريح مضطربا . % PageV01P430 البحر : - 1(@)(@@) % مجيئك يا صدر الأفاضل نعمة % لخالقنا في مثلها نكثر الحمدا ؛ % 2(@)(@@) % ولو أنني أستطيع سعيا إليكم % % سعيت على عيني ولكنها رمدا % % 3(@)(@@) % لقد أنكرت طعم الهدو فصرت مذ % ثلاث ليال لا اقر ولا أهدا ؛ % 4(@)(@@) % جعلن على إنسان عيني غشاوة % وصيرن ما بيني وبين الورى سدا ؛ % 5(@)(@@) % وأهد إلى العبد الدعاء فإنه % % إلى صاحب الآلام أحسن ما يهدى % % 6(@)(@@) % عليك من الله العلي تحية % % تفوح فيحكي نشرها المسك والندا . % PageV01P431 البحر : - 1(@)(@@) % يا أيها القاضي الذي % % نعماؤه لا تجحد ؛ % 2(@)(@@) % حاشا لمثلك أنه % % عن نصر مثلي يرقد % 3(@)(@@) % ولقد قصدتك والفتى % % من للمكارم يقصد % 4(@)(@@) % وغدوت لاسمك رافعا % عند الندا ؛ يا أحمد ؛ % 5(@)(@@) % لما علمت بأنك العلم المنادى المفرد ؛ العلم المنادى المفرد ؛ % العلم المنادى المفرد ؛ % 6(@)(@@) % فانهض لها أكرومة % بكرا عليها يحسد ؛ % 7(@)(@@) % كم من يد لك في الورى % % غراء تتبعها يد ؛ % PageV01P432 البحر : - 1(@)(@@) % أبا حسن أنت المرجى لها فهل % لموعد آمالي لديك نجاز . % 2(@)(@@) % فأنت المجلي في الكرام حقيقة % وغيرك يابن الأكرمين مجاز ؛ % 3(@)(@@) % لطال ورودي ذلك البحر ظاميا % فأمنع من دون الورى وأجاز . % 4(@)(@@) % وغيري على رغمي يروح ويغتدي % % بما دون أشعاري هناك يجاز . % PageV01P433 البحر : - 1(@)(@@) % الآن ؛ حين انتهى السلوان والجلد % فقصروا أقصروا في الهجر واقتصدوا ؛ % 2(@)(@@) % قلتم حملنا غراما لا تطيق له % جبال رضوى ولا يقوى له أحد % 3(@)(@@) % هذا وما وجدت يوما جوانحكم % % من الصبابة إلا بعض ما أجد % 4 
ms96	(@)(@@) % ولا أثار الجوى نارا بأضلعكم ؛ % وفي ضلوعي لظى الأشواق تتقد ؛ % 5(@)(@@) % ولا جفا النوم من بعدي نواظركم ؛ % وناظري بعدكم أودى به السهد % 6(@)(@@) % ولا جرت للنوى يوما مدامعكم ؛ % ومدمعي أبدا في الخد يطرد % 7(@)(@@) % فكيف حالي ؛ ووجدي كل آونة % يمد شوقي ؛ وصبري ماله مدد % PageV01P434 البحر : - 1(@)(@@) % فيم الجفا وعلام الصد والملل % ما بالها انقطعت ما بيننا الرسل % 2(@)(@@) % شتان ما بيننا في الحب ؛ حظكم % مني الوفاء ؛ وحظي منكم الملل % 3(@)(@@) % قال الحواسد إني قد سلوتكم % يا كذب ما ذكروا عني وما نقلوا ؛ % 4(@)(@@) % لا فزت يا سادتي منكم بعطف رضى % % إن كان لي عنكم من بعدكم بدل . % 5(@)(@@) % ولا أرى الله طرفي غر أوجهكم ؛ % إن كان بعدكم بالنوم يكتحل ؛ % 6(@)(@@) % ولا بلغت مرادي من وصالكم ؛ % إن كان يلوي فؤادي عنكم عذل ؛ % 7(@)(@@) % نأيتم فنأى السلوان واتسعت % أبواب صبري حتى ضاقت الحيل ؛ % 8(@)(@@) % وكان ظني بكم قبل النوى حسنا ؛ % حتى نأيتم فخاب الظن والأمل ؛ % 9(@)(@@) % حملت فوق الذي أقوى وكنت فتى ؛ % لاناقة لي في هذا ولا جمل % 10(@)(@@) % والهجر يفعل في الأحشاء لاعجه % ما ليس تفعله العسالة الذبل ؛ % PageV01P435 11(@)(@@) % وقد أتيت بوصف الوق مختصرا % وعند مالكي التفصيل والجمل % 12(@)(@@) % وموجب العتب أني صرت مذ زمن % ما جاءني منكم كتب ولا رسل . % PageV01P436 البحر : - 1(@)(@@) % نقضت بعد النوى عهدي وميثاقي % % ونمت عن نار أشجاني وأشواقي % % 2(@)(@@) % وكنت لي خير مصحوب ؛ فعدت % % مع الأيام تجهد في ضيمي وإرهاقي % % 3(@)(@@) % فمن لنار اشتياقي أنت مضرمها % % وجدا وداء فراق ماله راق % % 4(@)(@@) % أظن أن بعادي عنك غير ما . . % عهدت من يم غر وأخلاق ؛ % 5(@)(@@) % يا ناقضا عقد عهدي إنني أبدا % مهما بقيت على عهدي الهوى باقي ؛ % 6(@)(@@) % الله في كبد حنت إليك فلو % قدرت أودعتها كتبي وأوراقي ؛ % 7(@)(@@) % وفي فؤاد بسيف البين منصدع % قامت حروب الهوى فيه على ساق % 8(@)(@@) % لا شمت بارق قرب منك إن طمعت % إلى رجوعك ؛ طعم النوم أحداقي ؛ % 9(@)(@@) % ولا حظيت بوصل إن صحبت سوى % % شوق ودمع على الخدين مهراق % 10(@)(@@) % أما 
ms97	 وقد غبت عني لا أراع إذا % من الزمان لإرعاد وإبراق ؛ % PageV01P437 11(@)(@@) % فليصنع الدهر ما شاءت نوائبه % فما عساني من بعد النوى لاقي % % PageV01P438 البحر : - 1(@)(@@) % يقبل الأرض إعظاما وإجلالا % % صب تحمل من هجرانكم ؛ مالا . . . % 2(@)(@@) % أنكرتم حاله من بعد معرفة % به وكيف وقد ميزتم الحالا . . % 3(@)(@@) % يخفي الأسى ولسان السقم يظهره % والدمع يضربه في الناس أمثالا ؛ % 4(@)(@@) % الله في مغرم أنحلتموه أسى % ما حاف عن ودكم يوما ولا حالا ؛ % 5(@)(@@) % ما زال يندب مذ زمت ركائبكم % % منازلا أقفرت منكم وأطلالا ؛ % PageV01P439 البحر : - 1(@)(@@) % يا هاجرين ؛ ولا نب ولا سبب % ترفقوا بفؤاد ليس يحتمل ؛ % 2(@)(@@) % حملتوني من أفراط هجركم % % ما ليس يحمله سهل ولا جبل ؛ % 3(@)(@@) % لأن جفوتم فباب العذر متسع % وإن قطعتم فحبل الود متصل % 4(@)(@@) % أليس من عجب أني أبثكم % شوقي وعندكم التفصيل والجمل % % PageV01P440 البحر : - 1(@)(@@) % وألجأتني تصاريف الزمان إلى % % جميل رأيك والمعروف من شيمك ؛ % 2(@)(@@) % ولا وسيلة لي أدلي إليك بها % % إلا رجائي وتعويلي على كرمك ؛ % 3(@)(@@) % حاشاك يا كعبة المعروف أن فتى % يخشى الزمان وقد وافي إلى حرمك ؛ % 4(@)(@@) % لا غرو ؛ أنا وجدنا كل مكرمة % تروى لسيفك أو تعزا إلى قلمك . % PageV01P441 البحر : - 1(@)(@@) % أيا من تجرعت من فقده % % كؤوسا من الصبر مر المذاق ؛ % 2(@)(@@) % لإن غاب شخصك عن ناظري % % فإن ودادك في القلب باقي ؛ % 3(@)(@@) % وسوف قريبا يعود التمام % لبدر التواصل بعد المحاق ؛ % 4(@)(@@) % لعل الذي قدر الافتراق % % يمن قريبا لنا بالتلاقي % % 5(@)(@@) % وما جف دمعي يوم الوداع سلوا % ولا قل فيك اشتياقي ؛ % 6(@)(@@) % ولكن بكيت لخوف الفراق % فأفنيته قبل يوم الفراق % 7(@)(@@) % وليس الدموع دليل الفجوع . . . . % ولو أنهن جرحن المآقي ؛ % 8(@)(@@) % فرب امريء دمعه فايض % ولكنه فائض عن نفاق % 9(@)(@@) % وذي حزن قد عصته الدموع % وأحشاؤه للنوى في احتراق . % PageV01P442 البحر : - 1(@)(@@) % أبثك فرط اشتياق إليك % % به ظل يعذرني من عذل ؛ % 2(@)(@@) % وإني ؛ وإن غبت عن ناظري % % على العهد طول المدى لم أزل ؛ % 3(@)(@@) % عقود ودادك في خاطري % % منظمة ؛ عقدها لا يحل . % PageV01P443 البحر : - 1(@)(@@) % وإن ترد أن ترى فؤادي 
ms98	 % % وما الذي فيه من ودادك ؛ % 2(@)(@@) % فانظر إلى قلبك اختبارا % وقس فؤادي على فؤادك . % PageV01P444 البحر : - 1(@)(@@) % ولقد وصفت البين قبل حصوله % % وسلكت فيه مسلك الشعراء ؛ % 2(@)(@@) % حتى رميت بدائه لتفاؤلي % % بوقوعه فأنا القتيل بدائي . % PageV01P445 البحر : - 1(@)(@@) % والله ما اخترت عنك من بدل ؛ % ومن يبيع النعيم بالبوس % 2(@)(@@) % لكن زمان ؛ وقيت جفوته % % أبدلني البوم بالطواويس % PageV01P446 البحر : - 1(@)(@@) % مولاي كنت أود الحياة % إذ كنت عندك ؛ % 2(@)(@@) % أما وقد غبت عني ؛ % لا خير في العيش بعدك . % PageV01P447 البحر : - 1(@)(@@) % أتيتك عن بعد وفقر وحاجة % ولي فيك ظن لاشك فوقه ؛ % 2(@)(@@) % وإن امرءا وافاك من بعد أرضه % حقيق بأن يقضي نداك حقوقه % PageV01P448 البحر : - 1(@)(@@) % إليك ضياء الدين واصل سيره % % لتفريج هم منه ضاق به صدرا ؛ % 2(@)(@@) % تجشم أثقال السرى يرتجي الغنى % % ولكنه عند الضيا يحمد المسرى % % PageV01P449 البحر : - 1(@)(@@) % مدحك يا بن الكرام فرض % وفي سواك المديح ندب % 2(@)(@@) % قياس كفيك في العطايا % % بالبحر عند العقول كذب ؛ % 3(@)(@@) % البحر يخشى وأنت ترجى % % والبحر ملح وأنت عذب . % PageV01P450 البحر : - 1(@)(@@) % أمولاي قد ضمنا مجلس % قطوف السرور به دانيه ؛ % 2(@)(@@) % وليس يتم نظام السرور % % إلا بحضرتك العاليه ؛ % PageV01P451 البحر : - 1(@)(@@) % أنا وحدي في المكان % لم يكن لي فيه ثاني ؛ % 2(@)(@@) % لا كحيل الطرف يسبيك % بقد خيزراني % % 3(@)(@@) % وبطرف بابلي مثلما % % سل اليماني ؛ % 4(@)(@@) % حاذق بالسقي للشرب % بصير بالأغاني % % 5(@)(@@) % لا ؛ ولا ذات دلال % بنت ست وثمان % % 6(@)(@@) % تتبدى بدر تم % وتثنى غصن بان ؛ % 7(@)(@@) % لا ؛ ولا حمراء تنقي % % الهم عن كل جنان % 8(@)(@@) % بنت كرم طال ما قد % عتقت وسط الدنان ؛ % 9(@)(@@) % قبل أن يبتدئ الخالق % في خلق الزمان ؛ % 10(@)(@@) % خل عن هذا وهذا % % للأعادي والشواني % % PageV01P452 11(@)(@@) % ليس من شانك يا % % مولاي حاشاك وشاني ؛ % 12(@)(@@) % كل هذا سوف نلقاه % جميعا في الجنان % 13(@)(@@) % إنما عندي ما شئت % من الكتب الحسان % 14(@)(@@) % وجليس حسن العشرة % يزري بابن هاني ؛ % 15(@)(@@) % فأتنا فردا ودعنا % % من فلان وفلان ؛ % 16(@)(@@) % واغتنم يومك % % فالدهر كثير الدوران . % PageV01P453 البحر : - 1(@)(@@) % ولما تناسى سيدي كتب عبده % ولم يأتنا منه 
ms99	 كتاب ولا رسل ؛ % 2(@)(@@) % أتيناه نطوي الأرض شوقا وإنما % % لنا الحظ في إتياننا وله الفضل ؛ % 3(@)(@@) % ولله أسنى الحمد والشكر إذ قضى % % بأن ضمنا من بعد فرقتنا الشمل ؛ % PageV01P454 البحر : - 1(@)(@@) % وما زال منكم حيث حل ركابنا % % فتى ماجد يجري على حكمه الدهر ؛ % 2(@)(@@) % فلا زلتم آل المطهر ؛ إنما . . . % بكم تدفع البلوى ؛ ويستدفع الضر % 3(@)(@@) % ملكتم رقاب العالمين بجودكم % % وإحسانكم ؛ حتى استوى العبد والحر % 4(@)(@@) % ألا في علاكم فليقل كل قائل % ففيكم لعمري يحسن النظم والنثر . % 5(@)(@@) % وقال في أثناء هذا الكتاب % % 6(@)(@@) % واشكو إلى المولى جوى عن أقله % يضيق لعمري البر أجمع والبحر % 7(@)(@@) % أعلل مقروح الفؤاد بذكركم % % فهل مر لي يوما ببالكم ذكر % 8(@)(@@) % ولم أدر إذ زمت ركائب بينكم % وقد خانني في ذلك الموقف الصبر ؛ % 9(@)(@@) % أهل ما أراه الموت أو حادث النوى % % وهل هو شوق بين جنبي أم جمر % PageV01P455 البحر : - 1(@)(@@) % جمال الهدى والمكرمات ومن له % % علي لا يداني حصرهن لسان ؛ % 2(@)(@@) % وسابق أرباب المكارم عن يد % إذا ضمها يوم الفخار رهان % 3(@)(@@) % وشيعي آل المصطفى سادة الورى % % جميعا ؛ ومن هم للأنام أمان ؛ % 4(@)(@@) % وليث الوغى إن قهقرت أسد الشرى % % وقيل غداة الروع أين فلان % % 5(@)(@@) % يروم بنو العلياء شأوك في العلى % % فأتعبتهم مذ كنت قط وكانوا ؛ % 6(@)(@@) % وما زلت مقداما لكل كريهة % قريناك فيها مرهف وسنان ؛ % 7(@)(@@) % تجاهد أهل البغي حتى تخرموا % % فأعطوا على الرغم القياد ودانوا ؛ % 8(@)(@@) % وما زانك المجد الأثيل ؛ وإنما % % لعمري بك المجد الأثيل يزان ؛ % 9(@)(@@) % رجوتك بعد الله فيما أهمني % % وأي عزيز قد رجاك يهان % 10(@)(@@) % ووجهت آمالي خماصا لعلها % % تعود من الإحسان وهي بطان ؛ % PageV01P456 11(@)(@@) % وفي النفس حاجات وفيك فطانة % سكوتي خطاب عندها وبيان % 12(@)(@@) % ومثلك من يرجى لكل عظيمة % ومثلي على ما أرتجيه يعان ؛ % 13(@)(@@) % ولا زلت محروس الجناب بحفظ من % له كل حين في البرية شان . % PageV01P457 البحر : - 1(@)(@@) % أيا شرف الإسلام دمت مشرفا % ولا زال ذا فخر برتبتك الفخر % 2(@)(@@) % ألم تر أن المجد أتلع جيده % % لمجدك إذ أضحى 
ms100	 وأنت له صدر ؛ % 3(@)(@@) % وأصبح منك الجود حالي نحره ؛ % فلا مر عصر أنت فيه ولا دهر ؛ % 4(@)(@@) % حليت أزالا إذ حللت بسوحها ؛ % ففي انفها شنف وفي أذنها شذر ؛ % 5(@)(@@) % وصغت عقود النظم والنثر يافعا % فعاد إلى ريعانه منهما العمر % 6(@)(@@) % وقلدت القريض لآلئا ؛ % ولا عجب فالدر معدنه البحر ؛ % 7(@)(@@) % وقد عم منك الجود نجدا وغوره % % وأصبح سهلا من هواطله الوعر ؛ % 8(@)(@@) % فجد لي بهاتيك الوريقات عاجلا % لأفعل فيها مثلما يفعل الهر % 9(@)(@@) % ولا غرو يا مولاي إن قرئت بأن % % تداول سمع المرء أنمله العشر % 10(@)(@@) % فأجاب عليه بقوله % % PageV01P458 11(@)(@@) % أشهد أتاني من نظامك أم خمر % بفي برود وهو في كبدي جمر % 12(@)(@@) % زواهر أفق أم أزاهر روضة % أم الدر هاتيك العقود أم السحر % 13(@)(@@) % طوت خبر الطائي حين نشرتها % % برقتها ؛ يا حبذا الطي والنشر ؛ % 14(@)(@@) % فيا ما أحيلاها ؛ عروس بلاغة % تجلت ؛ فحبات القلوب لها مهر ؛ % 15(@)(@@) % وغيداء لا ترضى النجوم قلائدا ؛ % وتأنف أن الشمس في أذنها شذر % 16(@)(@@) % تحاكي الصبا لطفا وزهر الربى شذى % % وتفعل بالألباب ما يفعل الخمر % 17(@)(@@) % أجاد معانيها ووشى برودها ؛ % فتى ماجد أضحى به يفخر الدهر ؛ % 18(@)(@@) % رقيق حواشي النظم والبارع الذي % % غدت غرة للدهر أيامه الغر ؛ % 19(@)(@@) % تحكم في فن البلاغة فاغتدى ؛ % له في المعاني الصعبة النهي والأمر ؛ % 20(@)(@@) % وكم من عروض قال يشهد أنه الخليل % % و بحر شاهد أنه البحر % PageV01P459 البحر : - 1(@)(@@) % أما لليالي الماضيات معاد % فيهدؤ قلب أو يعود رقاد % 2(@)(@@) % أما أدركت قلب النوى لي رحمة % فقد طال شوق مقلق وسهاد % 3(@)(@@) % إذا رمت بث الشوق يوما إليكم % % فما لي سوى دمعي الهتون مداد % 4(@)(@@) % لنا أمل في الله جل جلاله % وللدهر فينا مقصد ومراد . % PageV01P460 البحر : - 1(@)(@@) % وكنت أرى أني الصبور على النوى % % فقد نقضت أيدي النوى مرر الصبر ؛ % 2(@)(@@) % فإن يجمع الله المهيمن شملنا % % فذاك الذي أرجوه في مقبل العمر ؛ % 3(@)(@@) % وإن حالت الأيام بيني وبينكم % % فبالله ؛ ألا ما مررتم على قبري . % PageV01P461 البحر : - 1(@)(@@) % وأقسم لو جاراك يحيى بن خالد % لأقسم 