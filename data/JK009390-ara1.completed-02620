ms2601	 طب هب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24372 قال النبي :(@)(@@) | 30 ( هاهنا ائتزر ، فإن أبيت فهاهنا فوق الكعبين ، فإن أبيت فإن الله لا يحب كل مختال فخور ) )(@)(@@) ( حم ك ) عن جابر بن سليم الهجيمي رضي الله عنه .(@)(@@) PageV08P049(@)(@@)(@@)(@@) ||| ( الهاء مع الباء(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24373 قال النبي :(@)(@@) | 30 ( هبط جبريل فقال يا محمد إن الله يقرئك السلام ويقول لك : تأتي يوم القيامة كل أمة عطاشا إلا من أحب أبا بكر وعمر وعثمان وعليا ) )(@)(@@) الرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24374 قال النبي :(@)(@@) | 30 ( هبط آدم وحواء عريانين جميعا ، عليهما ورق الجنة ، فأصابه الحر حتى قعد يبكي ويقول : يا حواء قد آذاني الحر ، فجاء جبريل بقطن وأمرها أن تغزل وعلمها وعلم آدم الحياكة ، وعلمه وأمره أن ينسج ، وكان آدم لم يجامع امرأته في الجنة حتى هبط منها للخطيئة التي أصاباها بأكلهما الشجرة ، وكان كل واحد منهما ينام على حدة ، ينام أحدهما في البطحاء ، والآخر من ناحية أخرى حتى أتاه جبريل فأمره أن يأتي أهله وعلمه كيف يأتيها ، فلما أتاها جاءه جبريل فقال : كيف وجدت امرأتك ؟ قال : صالحة ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24375 قال النبي :(@)(@@) | 30 ( هبط ملكان لم يهبطا منذ كانت الأرض فبشراني أن الحسن والحسين سيدا شباب أهل الجنة ، فقلت : أبوهما خير منهما ، وعثمان شبيه إبراهيم خليل الرحمن ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهاء مع الجيم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24376 قال النبي :(@)(@@) | 30 ( هجاهم حسان فشفى واستشفى ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@) PageV08P050(@)(@@)(@@)(@@) $ 24377 قال النبي :(@)(@@) | 30 ( هجر المسلم أخاه كسفك دمه ) )(@)(@@) ابن قانع عن أبي حدرد رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهاء مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24378 قال النبي :(@)(@@) | 30 ( هدايا العمال حرام كلها ) )(@)(@@) ( ع ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24379 قال النبي :(@)(@@) | 30 ( هدايا العمال غلول ) )(@)(@@) ( حم هق ) عن أبي حميد الساعدي رضي الله عنه .(@)(@@)(@@)(@@) $ 24380 قال النبي :(@)(@@) | 30 ( هدية الله تعالى إلى المؤمن ، السائل على بابه ) )(@)(@@) ( خط ) في رواة مالك 
ms2602	 عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24381 قال النبي :(@)(@@) | 30 ( هدم المتعة النكاح ، والطلاق والعدة والميراث ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24382 قال النبي :(@)(@@) | 30 ( هدايا الأمراء غلول ) )(@)(@@) أبو سعيد النقش في كتاب القضاة عن أبي حميد الساعدي وعن أبي سعيد وعن أبي هريرة ، الرافعي عن جابر رضي الله عنهم .(@)(@@)(@@)(@@) $ 24383 قال النبي :(@)(@@) | 30 ( هدايا السلطان سحت وغلول ) )(@)(@@) ابن عساكر عن عبد الله بن سعد رضي الله عنه .(@)(@@) PageV08P051(@)(@@)(@@)(@@) $ 24384 قال النبي :(@)(@@) | 30 ( هدية الله للمؤمن السائل على بابه ) )(@)(@@) أبو نعيم والديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24385 قال النبي :(@)(@@) | 30 ( هدية الأمراء غلول ) )(@)(@@) ابن جرير عن جابر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهاء مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24386 قال النبي :(@)(@@) | 30 ( هل أنت إلا إصبع دميت ، وفي سبيل الله ما لقيت ) )(@)(@@) ( حم ق ت ن ) عن جندب البجلي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24387 قال النبي :(@)(@@) | 30 ( هل أنتم تاركون لي أمرائي ، لكم صفوة أمرهم ، وعليهم كدره ) )(@)(@@) ( د ) عن عوف بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24388 قال النبي :(@)(@@) | 30 ( هل أنتم تاركون لي أمرائي ، إنما مثلكم ومثلهم كمثل رجل استرعى إبلا أو غنما فرعاها ثم تحين سقيها فأوردها حوضا فشرعت فيه فشربت صفوة وتركت كدره ، فصفوه لكم ، وكدره عليهم ) )(@)(@@) ( م ) عن عوف بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24389 قال النبي :(@)(@@) | 30 ( هل تدرون أين تغرب هاذه ؟ تغرب في عين حامية ) )(@)(@@) ( د ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24390 قال النبي :(@)(@@) | 30 ( هل تدرون كم بين السماء والأرض ؟ بينهما مسيرة خمسمائة سنة ، ومن كل سماء إلى سماء مسيرة خمسمائة سنة ، وكثف كل سماء خمسمائة سنة ، وفوق السماء السابعة بحر بين أعلاه وأسفله كما بين السماء PageV08P052 والأرض ، ثم فوق ذالك ثمانية أوعال بين ركبهن وأظلافهن كما بين السماء والأرض ، ثم فوق ذالك العرش ، بين أعلاه وأسفله كما بين السماء والأرض ، والله سبحانه وتعالى فوق ذلك ، وليس يخفى عليه من أعمال بني آدم 
ms2603	 شيء ) )(@)(@@) ( حم ت ك ) عن العباس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24391 قال النبي :(@)(@@) | 30 ( هل تدرون ما الكوثر ؟ هو نهر أعطانيه ربي في الجنة ، عليه خير كثير ، ترد عليه أمتي يوم القيامة ، آنيته عدد الكواكب ، يختلج العبد منهم فأقول : يا رب إنه من أمتي ؟ فيقال : إنك لا تدري ما أحدثوا بعدك ؟ ( حم م د ن ) عن أ$ نس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24392 قال النبي :(@)(@@) | 30 ( هل تدرون ماذا قال ربكم الليلة ؟ قال الله : أصبح من عبادي مؤمن بي وكافر ، فأما من قال : مطرنا بفضل اله ورحمته فذالك مؤمن بي كافر بالكواكب ، وأم من قال : مطرنا بنوء كذا وكذا : فذالك كافر بي ومؤمن بالكواكب ) )(@)(@@) ( حم ق د ن ) عن زيد بن خالد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24393 قال النبي :(@)(@@) | 30 ( هل تدرون ما هاذا ؟ هاذا العنان ، هاذه روايا الأرض يسوقه الله إلى قوم لا يشكرونه ولا يدعونه ، هل تدرون ما فوقكم ؟ فإنها الرقيع : سقف محفوظ ، وموج مكفوف ، هل تدرون كم بينكم وبينها ؟ بينكم وبينها خمسمائة سنة ، هل تدرون من فوق ذلك ؟ فإن فوق ذلك سماءين ما بينهما مسيرة خمسمائة سنة في عدد سبع سماوات ، ما بين كل سماءين كما بين السماء والأرض ، هل تدرون ما فوق ذالك فإن فوق ذالك العرش ، وبينه وبين السماء بعد مثل ما بين السماءين ، هل تدرون ما الذي تحتكم ؟ فإنها الأرض ، هل تدرون ما الذي تحت ذالك ؟ فإن تحتها أرض أخرى بينهما مسيرة خمسمائة سنة ، حتى عد سبع أرضين بين كل أرضين مسيرة خمسمائة سنة ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24394 قال النبي :(@)(@@) | 30 ( هل ترون قبلتي هاهنا ، فوالله ما يخفى علي PageV08P053 خشوعكم ولا ركوعكم ، إني لأراكم من وراء ظهري ) )(@)(@@) مالك ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24395 قال النبي :(@)(@@) | 30 ( هل ترون ما أرى : إني لأرى مواقع الفتن خلال بيوتكم كمواقع القطر ) )(@)(@@) ( حم ق ) عن أسامة رضي الله عنه .(@)(@@)(@@)(@@) $ 24396 قال النبي :(@)(@@) | 30 ( هل تضارون في رؤية الشمس بالظهيرة 
ms2604	 صحوا ليس معها سحاب ، وهل تضارون في رؤية القمر ليلة البدر صحوا ليس فيها سحاب ، ما تضارون في رؤية الله يوم القيامة إلا كما تضارون في رؤية أحدهما ، إذا كان يوم القيامة ، أذن مؤذن ليتبع كل أمة ما كانت تعبد ، فلا يبقى أحد كان يعبد غير الله من الأصنام والأنصاب إلا يتساقطون في النار ، حتى إذا لم يبق إلا من كان يعبد الله من بر وفاجر ، وغير أهل الكتاب ، فيدعى اليهود فيقال لهم : ما كنتم تعبدون ؟ قالوا : كنا نعبد عزيرا ابن الله ، فيقال : كذبتم ، ما اتخذ الله من صاحبة ولا ولد ، فماذا تبغون ؟ قالوا : عطشنا يا ربنا فاسقنا فيشار إليهم : ألا تردون ؟ فيحشرون إلى النار كأنها سراب يحطم بعضها بعضا فيتساقطون في النار . ثم يدعى النصارى فيقال لهم : ما كنتم تعبدون ؟ قالوا : كنا نعبد المسيح ابن الله ، فيقال لهم : كذبتم ، ما اتخذ الله من صاحبة ولا ولد ، فيقال لهم : ماذا تبغون ؟ فيقولون : عطشنا يا ربنا فاسقنا ، فيشار إليهم ألا تردون فيحشرون إلى جهنم كأنها سراب يحطم بعضها بعضا فيتساقطون في النار ، حتى إذا لم يبق إلا من كان يعبد الله من بر وفاجر ، أتاهم رب العالمين في أدنى صورة من التي رأوه فيها ، قال : فما تنتظرون ؟ تتبع كل أمة ما كانت تعبد ، قالوا يا ربنا فارقنا الناس في الدنيا أفقر ما كنا إليهم ولم نصاحبهم ، فيقول : أنا ربكم . فيقولون : نعوذ بالله منك لا نشرك بالله شيئا مرتين أو ثلاثا حتى إن بعضهم ليكاد أن ينقلب ، فيقول : هل بينكم وبينه آية فتعرفونه بها ؟ فيقولون : نعم الساق ، PageV08P054 فيكشف عن ساق ، فلا يبقى من كان يسجد لله من تلقاء نفسه إلا أذن الله له بالسجود ، ولا يبقى من كان يسجد اتقاء ورياء إلا جعل الله ظهره طبقة واحدة كلما أراد أن يسجد خر على قفاه ، ثم يرفعون رؤوسهم ، وقد تحول في الصورة التي رأوه فيها أول مرة فيقول : أنا ربكم ، فيقولون : أنت ربنا ، ثم يضرب الجسر على جهنم وتحل الشفاعة ويقولون : اللهم سلم 
ms2605	 سلم ، قيل : يا رسول الله ! وما الجسر ؟ قال : دحض مزلة ، فيه خطاطيف وكلاليب وحسكة تكون بنجد فيها شويكة يقال لها السعدان ، فيمر المؤمنون كطرف العين وكالبرق وكالريح وكالطير وكأجاويد الخيل والركاب : فناج مسلم ، ومخدوش مرسل ، ومكدوس في نار جهنم ، حتى إذا خلص المؤمنون من النار ، فوالذي نفسي بيده ، ما من أحد منكم بأشد مناشدة لله في استيفاء الحق من المؤمنين لله يوم القيامة لإخوانهم الذين في النار يقولون : ربنا كانوا يصومون معنا ويصلون ويحجون ، فيقال لهم : أخرجوا من عرفتم ، فتحرم صورهم على النار ، فيخرجون خلقا كثيرا قد أخذت النار إلى نصف ساقه وإلى ركبتيه ، فيقولون : ربنا ما بقي فيها أحد ممن أمرتنا به ، فيقول الله عز وجل : ارجعوا فمن وجدتم في قلبه مثقال دينار من خير فأخرجوه ، فيخرجون خلقا كثيرا ، ثم يقولون : ربنا لم نذر فيها أحدا ممن أمرتنا به ، ثم يقول : ارجعوا فمن وجدتم في قلبه مثقال نصف دينار من خير فأخرجوه فيخرجون خلقا كثيرا ، ثم يقولون : ربنا لم نذر فيها ممن أمرتنا أحدا ، ثم يقول : ارجعوا فمن وجدتم في قلبه مثقال ذرة من خير فأخرجوه ، فيخرجون خلقا كثيرا ، ثم يقولون : ربنا لم نذر فيها خيرا ، فيقول الله : شفعت الملائكة ، وشفع النبيون ، وشفع المؤمنون ، ولم يبق إلا أرحم الراحمين فيقبض قبضة من النار فيخرج منها قوما لم يعملوا خيرا قط قد عادوا حمما فيلقيهم في نهر في أفواه الجنة يقال نهر الحياة ، فيخرجون كما تخرج الجنة في حميل السيل ، ألا ترونها تكون إلى الحجر أو الشجر ما يكون إلى الشمس أصيفر وأخيضر وما يكون منها إلى الظل يكون أبيض فيخرجون كاللؤلؤ في رقابهم الخواتيم يعرفهم أهل الجنة : هاؤلاء عتقاء الله من النار الذين أدخلهم الجنة بغير عمل عملوه ولا خير قدموه ، ثم يقول : ادخلوا الجنة فما PageV08P055 رأيتموه فهو لكم ، فيقولون : ربنا أعطيتنا ، ما لم تعط أحدا من العالمين ، فيقول : لكم عندي أفضل من هاذا ، فيقولون : يا ربنا ! أي شيء أفضل من هاذا ؟ فيقول : رضاي فلا أسخط عليكم بعده أبدا 
ms2606	 ؟ ) )(@)(@@) ( حم ق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24397 قال النبي :(@)(@@) | 30 ( هل تضارون في رؤية الشمس في الظهيرة ليست في سحابة ، هل تضارون في رؤية القمر ليلة البدر ليست في سحابة ؟ فوالذي نفسي بيده ، لا تضارون في رؤية ربكم عز وجل إلا كما تضارون في رؤية أحدهما ، فيلقى العبد فيقول : أي فل ألم أكرمك ، وأسودك ، وأزوجك ، وأسخر لك الخيل والإبل ، وأذرك ترأس وتربع ؟ فيقول : بلى أي رب ، فيقول : أفظننت أنك ملاقي ؟ فيقول : لا ، فيقول : فإني أنساك كما نسيتني ، ثم يلقى الثاني فيقول له : أي فل ! ألم أكرمك ، وأسودك ، وأزوجك ، وأسخر لك الخيل والإبل ، وأذرك ترأس وتربع ، فيقول : بلى أي رب ، فيقول : أفظننت أنك ملاقي ؟ فيقول : لا ، فيقول : إني أنساك كما نسيتني ، ثم يلقى الثالث فيقول له مثل ذلك ، فيقول : رب آمنت بك وبكتابك وبرسلك ، وصليت وصمت وتصدقت ويثنى بخير ما استطاع ، فيقول : هاهنا إذن ، ثم يقال : الآن نبعث شاهدا عليك ، ويتفكر في نفسه ، من ذا الذي يشهد علي ؟ فيختم على فيه ، ويقال لفخذه انطقي ، فتنطق فخذه ولحمه وعظامه بعمله ، وذلك ليعذر من نفسه ، وذلك المنافق ، وذلك الذي يسخط الله عليه ؟ ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24398 قال النبي :(@)(@@) | 30 ( هل تمارون في القمر ليلة البدر ليس دونه سحاب ؟ هل تمارون في رؤية الشمس ليس دونها سحاب ؟ فإنكم ترونه كذلك ، يحشر الله الناس يوم القيامة فيقول : من كان يعبد شيئا فليتبعه ، فيتبع من كان يعبد الشمس الشمس ، ويتبع من كان يعبد القمر القمر ، ويتبع من كان يعبد الطواغيت الطواغيت ، PageV08P056 وتبقى هاذه الأمة فيها منافقوها ، فيأتيهم الله في صورة غير صورته التي يعرفون ، فيقول : أنا ربكم ، فيقولون : نعوذ بالله منك ، هذا مكاننا حتى يأتينا ربنا ، فإذا جاءنا عرفناه ، فيأتيهم الله في صورته التي يعرفون ، فيقول : أنا ربكم ، فيقولون : أنت ربنا فيتبعونه ، ويضرب الصراط بين ظهراني جهنم ، فأكون أول من يجوز من الرسل بأمته ، ولا يتكلم يومئذ أحد إلا الرسل ، وكلام الرسل يومئذ : اللهم سلم سلم ، وفي جهنم 
ms2607	 كلاليب مثل شوك السعدان غير أنه لا يعلم ما قدر عظمها إلا الله تخطف الناس بأعمالهم ، فمنهم من يوبق بعمله ، ومنهم من يخردل ثم ينجو حتى إذا فرغ الله من القضاء بين العباد وأراد أن يخرج برحمته من أراد من أهل النار ، أمر الملائكة أن يخرجوا من النار من كان لا يشرك بالله شيئا يقول : لا إله إلا الله فيخرجونهم ويعرفونهم بآثار السجود ، وحرم الله على النار أن تأكل آثار السجود ، فيخرجون من النار ، وقد آمتحشوا ، فيصب عليهم ماء الحياة فينبتون كما تنبت الحبة في حميل السيل ، ثم يفرغ الله من القضاء بين العباد ، ويبقى رجل بين الجنة والنار ، وهو آخر أهل النار دخولا الجنة مقبلا بوجهه قبل النار ، فيقول : يا رب اصرف وجهي عن النار ، فقد قشبني ريحها وأحرقني ذكاؤها ، فيقول : هل عسيت أن أفعل ذلك بك أن تسأل غير ذلك ؟ فيقول : لا وعزتك ، فيعطي الله ما يشاء من عهد وميثاق ، فيصرف الله وجهه عن النار ، فإذا أقبل به على الجنة ورأى بهجتها سكت ما شاء الله أن يسكت ثم قال : يا رب قدمني عند باب الجنة ، فيقول الله : أليس قد أعطيت العهد والميثاق أن لا تسأل غير الذي كنت سألت ؟ فيقول : يا رب لا أكون أشقى خلقك ، فيقول : فما عسيت إن أعطيتك ذلك أن لا تسأل غيره ؟ فيقول : لا ، وعزتك لا أسألك غير ذلك ، فيعطي ربه ما شاء من عهد وميثاق فيقدمه إلى باب الجنة ، فإذا PageV08P057 بلغ بابها فرأى زهرتها وما فيها من النضرة والسرور فيسكت ما شاء الله أن يسكت فيقول : يا رب أدخلني الجنة ، فيقول الله : ويحك يا ابن آدم ما أغدرك ، أليس قد أعطيت العهد والميثاق أن لا تسأل غير الذي أعطيت ؟ فيقول : يا رب لا تجعلني أشقى خلقك ، فيضحك الله منه ثم يأذن له في دخول الجنة ، فيقول : تمن ، فيتمنى حتى إذا انقطعت أمنيته قال الله تعالى : زد من كذا وكذا ، أقبل يذكره ربه ، حتى إذا انتهت به الأماني قال الله عز وجل : لك 
ms2608	 ذلك ومثله معه ) )(@)(@@) ( حم ق ) عن أبي هريرة وعن أبي سعيد رضي الله عنهما ( ز ) . لكنه قال : ( وعشرة أمثاله ) .(@)(@@)(@@)(@@) $ 24399 قال النبي :(@)(@@) | 30 ( هل تنصرون إلا بضعفائكم ؟ بدعوتهم وإخلاصهم ؟ ( حل ) عن س$ عد رضي الله عنه .(@)(@@)(@@)(@@) $ 24400 قال النبي :(@)(@@) | 30 ( هل تنصرون وترزقون إلا بضعفائكم ؟ ) )(@)(@@) ( خ ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 24401 قال النبي :(@)(@@) | 30 ( هل قرأ معي أحد منكم آنفا ؟ إني أقول ما لي أنازع القرآن ) )(@)(@@) ( حم ت ن ه حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24402 قال النبي :(@)(@@) | 30 ( هل من أحد يمشي على الماء إلا ابتلت قدماه ، كذلك صاحب الدنيا لا يسلم من الذنوب ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24403 قال النبي :(@)(@@) | 30 ( هل منكم رجل إذا أتى أهله فأغلق عليه بابه ، وألقى عليه ستره ، واستر بستر الله قالوا : نعم ، قال : ثم يجلس بعد ذلك فيقول : فعلت كذا ، فعلت كذا فسكتوا ، ثم أقبل على النساء فقال : هل منكن من تحدثن ؟ فسكتن ، فجثت فتاة كعاب على أحد ركبتيها وتطاولت لرسول الله ليراها ويسمع كلامها ، فقالت : يا رسول الله ! إنهم ليحدثون ، وإنهن ليحدثن ، فقال : هل تدرون مثل ذلك ؟ إنما مثل ذلك مثل شيطانة لقيت شيطانا في السكة ، فقضى حاجته والناس PageV08P058 ينظرون إليه ، ألا إن طيب الرجال ما ظهر ريحه ولم يظهر لونه ، ألا إن طيب النساء ما ظهر لونه ولم يظهر ريحه ، ألا لا يفضين رجل إلى رجل ، ولا امرأة إلى امرأة إلا إلى ولد أو والد ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24404 قال النبي :(@)(@@) | 30 ( هلاك أمتي على يدي غلمة من قريش ) )(@)(@@) ( حم خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24405 قال النبي :(@)(@@) | 30 ( هلك المتقذرون ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24406 قال النبي :(@)(@@) | 30 ( هلك المتنطعون ) )(@)(@@) ( حم م د ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24407 قال النبي :(@)(@@) | 30 ( هلك كسرى ثم لا يكون كسرى بعده ، وقيصر ليهلكن ثم لا يكون قيصر بعده وليقسمن كنوزهما في سبيل الله ) )(@)(@@) ( م 
ms2609	 ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24408 قال النبي :(@)(@@) | 30 ( هلكت الرجال حين أطاعت النساء ) )(@)(@@) ( حم طب ك ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24409 قال النبي :(@)(@@) | 30 ( هلا أخذتم إهابها فدبغتموه فانتفعتم به ؟ ، إنما حرم أكلها ( حم م 4 ) عن ا$ بن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 24410 قال النبي :(@)(@@) | 30 ( هلا تركتموه ؟ لعله أن يتوب فيتوب الله عليه يعني ماعزا ) )(@)(@@) ( د ك ) عن نعيم بن هزال رضي الله عنه ( ز ) .(@)(@@) PageV08P059(@)(@@)(@@)(@@) $ 24411 قال النبي :(@)(@@) | 30 ( هلم إلى الغذاء المبارك يعني السحور ) )(@)(@@) ( حم د ن حب ) عن العرباض رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24412 قال النبي :(@)(@@) | 30 ( هلم إلى جهاد لا شوكة فيه : الحج ) )(@)(@@) ( طب ) عن الحسين رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24413 قال النبي :(@)(@@) | 30 ( هل تدرون أي يوم هاذا ؟ إن هاذا أوسط أيام التشريق ، هل تدرون أي بلد هاذا ؟ هاذا المشعر الحرام ، إني لا أدري لعلي لا ألقاكم بعد هذا ألا وإن دماءكم وأموالكم وأعراضكم عليكم حرام كحرمة يومكم هذا في بلدكم هاذا حتى تلقوا ربكم ، فيسألكم عن أعمالكم ، إلا فليبلغ أدناكم أقصاكم ، ألا هل بلغت ) )(@)(@@) ( طب ) عن سراء بنت نبهان رضي الله عنها .(@)(@@)(@@)(@@) $ 24414 قال النبي :(@)(@@) | 30 ( هل قرأ معي أحد ، قد عجبت ، قلت : من هاذا الذي ينازعني القرآن ، إذا قرأ الإمام فلا تقرأوا إلا بأم القرآن ، فإنه لا صلاة لمن لم يقرأ بها ) )(@)(@@) ( ك ) وتعقب عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 24415 قال النبي :(@)(@@) | 30 ( هل أدلكم على اسم الله الأعظم ؟ : دعاء يونس ، فقال رجل : يا رسول الله ! هل كانت ليونس خاصة ، قال : ألا تسمع قوله عز وجل : { ونجيناه من الغم وكذالك ننجي المؤمنين } فأيما مسلم دعا بها في مرضه أربعين مرة فمات في مرضه ذلك أعطي أجر شهيد ، وإن برأ برأ مغفورا له ) )(@)(@@) ( ك ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 24416 قال النبي :(@)(@@) | 30 ( هل كان معكم لهو ؟ فإن الأنصار يحبون اللهو ؟ ) )(@)(@@) PageV08P060 ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24417 قال النبي :(@)(@@) | 30 ( هل 
ms2610	 ترون الشمس في يوم لا غيم فيه ، وترون القمر في ليلة لا غيم فيها ، فإنكم سترون ربكم ، حتى إن أحدكم ليحاضره ربه محاضرة فيقول : عبدي هل تعف ذنب كذا وكذا ؟ فيقول : رب ألم تغفر لي ؟ فيقول : بمغفرتي صرت إلى هاذا ؟ ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24418 قال النبي :(@)(@@) | 30 ( هل أخذتك أم ملدم قط ؟ قال : وما أم ملدم ؟ قال : حر يكون بين الجلد والعظم ، قال : لا ، قال : فهل أخذ هاذا الصداع ؟ قال : وما الصداع ؟ قال : عروق تضرب على الإنسان في رأسه ، قال : لا ، قال : من أحب أن ينظر إلى رجل من أهل النار فلينظر إلى هاذا ) )(@)(@@) ( حم ) و هناد عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24419 قال النبي :(@)(@@) | 30 ( هل من لهو ؟ ) )(@)(@@) ( حم ) عن روح بنت أبي لهب قالت : دخل علينا رسول الله حين تزوجت ابنة أبي لهب فقال فذكره .(@)(@@)(@@)(@@) $ 24420 قال النبي :(@)(@@) | 30 ( هل لك مال ؟ فقدم مالك بين يديك ، فإن المرء مع ماله ، إنقدمه أحب أن يلحقه ، وإن خلفه أحب أن يتخلف معه ) )(@)(@@) ابن المبارك عن عبد الله بن عبيد قال قال رجل : يا رسول الله ما لي لا أحب الموت ؟ قال فذكره .(@)(@@)(@@)(@@) $ 24421 قال النبي :(@)(@@) | 30 ( هل تدرون ما يقول ربكم ؟ فإن ربكم يقول : من صلى الصلوات لوقتها وحافظ عليها ولم يضيعها استخفافا بحقها فله علي عهد أن أدخله الجنة ، ومن لم يصلها لوقتها ولم يحافظ عليها وضيعها استخفافا بحقها فلا عهد له علي ، إن شئت عذبته ، وإن شئت غفرت له ) )(@)(@@) ( طس ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24422 قال النبي :(@)(@@) | 30 ( هل لك يا با راشد أن تعتقه فيعتق الله عز وجل منك بكل عضو منه عضوا منك من النار ) )(@)(@@) ابن عساكر عن أبي راشد الأزدي رضي الله عنه .(@)(@@) PageV08P061(@)(@@)(@@)(@@) $ 24423 قال النبي :(@)(@@) | 30 ( هل تسمعوو ما أسمع ؟ إني لأسمع أطيط السماء ولا تلام أن تئط ، ما فيها موضع قدم إلا عليه ملك ساجد أو قائم ) )(@)(@@) ابن أبي حاتم في التفسير وأبو الشيخ في 
ms2611	 العظمة عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ 24424 قال النبي :(@)(@@) | 30 ( هل تسمعون ما أسمع ؟ أطت السماء وحق لها أن تئط ، ليس منها موضع قدم إلا وعليه ملك قائم أو راكع أو ساجد ) )(@)(@@) ابن منده وابن عساكر عن عبد الرحمن بن العلاء ابن سعد عن أبيه .(@)(@@)(@@)(@@) $ 24425 قال النبي :(@)(@@) | 30 ( هل تدرون ما الشديد ؟ إن الشديد كل الشديد الذي يملك نفسه الغضب ، تدرون ما الرقوب ؟ إن الربوب الذي له الولد لم يقدم منهم شيئا ، تدرون ما الصعلوك ؟ إن الصعلوك كل الصعلوك الرجل له المال لم يقدم منه شيئا ) )(@)(@@) ( هب ) عن حفصة أو ابن حفصة رضي الله عنهما .(@)(@@)(@@)(@@) $ 24426 قال النبي :(@)(@@) | 30 ( هل تدرون ما الكنود ؟ هو الكفور الذي ينزل وحده ، ويمنع رفده ، ويشبع بطنه ، ويجيع عبده ، ولا يعطي في النائبة قومه منهم الوليد بن المغيرة ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 24427 قال النبي :(@)(@@) | 30 ( هل تملك لسانك ؟ فلا تقل بلسانك إلا معروفا ، ولا تبسط يدك إلا إلى خير ) )(@)(@@) ( هب ) عن الأسود بن أصرم رضي الله عنه .(@)(@@)(@@)(@@) $ 24428 قال النبي :(@)(@@) | 30 ( هل جزاء الإحسان إلا الإحسان ، هل تدرون ما يقول ربكم ؟ هل جزاء من أنعمنا عليه بالتوحيد إلا لجنة ) )(@)(@@) أبو نعيم الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24429 قال النبي :(@)(@@) | 30 ( هل تدرون من هاذا ؟ هاذا جبريل أتاكم ليعلمكم دينكم خذوا عنه ، فوالذي نفسي بيده ما شبه علي منذ أتاني قبل يومي هاذا ، وما عرفته حتى ولى ) )(@)(@@) ( حب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 24430 قال النبي :(@)(@@) | 30 ( هل منكم أحد طعم اليوم ؟ من كان لم يطعم منكم PageV08P062 فليصم ، ومن طعم فليتم بقية يومه ، وائذنوا أهل العروض فليتموا بقية يومهم يعني يوم عاشوراء ) )(@)(@@) ( حب ) عن محمد بن صيفي الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ 24431 قال النبي :(@)(@@) | 30 ( هل تدرون ما هاذا ؟ هاذا كتاب من رب العالمين فيه أسماء أهل الجنة وأسماء آبائهم وقبائلهم ثم أجمل على آخرهم فلا يزاد فيهم ولا ينقص منهم أبدا ، قالوا : ففيم إذن نعمل إن كان 
ms2612	 هاذا أمر قد فرغ منه ؟ قال : بل سددوا وقاربوا ، فإن صاحب الجنة يختم له بعمل أهل الجنة ، وإن عمل أي عمل ، فرغ ربكم من العباد ، فرغ ربكم من الخلق ، فريق في الجنة وفريق في السعير ، العمل إلى خواتمه ) )(@)(@@) ابن جرير عن رجل من الصحابة .(@)(@@)(@@)(@@) $ 24432 قال النبي :(@)(@@) | 30 ( هل أنتم منتهون أصلاتان معا ؟ ) )(@)(@@) ( ش ) عن ابن عباس رضي الله عنهما أن النبي خرج يوما إلى الصبح فإذا رجل يركع قال فذكره .(@)(@@)(@@)(@@) $ 24433 قال النبي :(@)(@@) | 30 ( هل بقي أحد من والديك ؟ ) )(@)(@@) قال : أمي ، قال : قاتل في سبيل الله في برها ، إذا فعلت ذلك فأنت حاج ومعتمر ومجاهد ، وإذا رضيت عليك أمك فاتق الله وبرها ) )(@)(@@) | ( طس ) عن أ$ نس رضي الله عنه .(@)(@@)(@@)(@@) $ 24434 قال النبي :(@)(@@) | 30 ( هل قرأ أحد منكم ب { سبح اسم ربك الأعلى } ؟ قد قلت ما لي أنازعها ) )(@)(@@) عبد الرزاق عن عمرن بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ 24435 قال النبي :(@)(@@) | 30 ( هل تدرون ما هاذا ؟ هاذا الإنسان وهاذا أجله ، وهاذا أمله ، معاطي الأمل فيختلجه الأجل دون ذالك ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه أن النبي غرز عودا ثم غرز إلى جنبه آخر ، ثم غرز الثالث فأبعده قال فذكره .(@)(@@) PageV08P063(@)(@@)(@@)(@@) $ 24436 قال النبي :(@)(@@) | 30 ( هل تدرون ما يقول ربكم تبارك وتعالى ؟ قال : وعزتي وجلالي لا يصليها عبد لوقتها إلا أدخلته الجنة ، ومن صلاها لغير وقتها ، إن شئت رحمته ، وإن شئت عذبته ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24437 قال النبي :(@)(@@) | 30 ( هل تقرأون خلفي شيئا من القرآن لا تفعلوا إلا بأم القرآن سرا في أنفسكم ) )(@)(@@) ( طب ) عن ابن عمر عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 24438 قال النبي :(@)(@@) | 30 ( هل قرأ أحد منكم آنفا في الصلاة ، إني أقول ما لي أنازع القرآن ) )(@)(@@) ( طب ) عن عبد الله بن بحينة رضي الله عنه .(@)(@@)(@@)(@@) $ 24439 قال النبي :(@)(@@) | 30 ( هل تدرون ما اسم هاذا الجبل ؟ هاذا حمت ، جبل من جبال الجنة ، اللهم بارك فيه ، وبارك لأهله فيه ) )(@)(@@) ( طب ) عن كثير بن عبد الله 
ms2613	 عن أبيه عن جده .(@)(@@)(@@)(@@) $ 24440 قال النبي :(@)(@@) | 30 ( هل أنت مبلغ عني قومك ما آمرك به ؟ قل لهم : لا يجمع أحدهم بيعا وسلفا ، ولا يبع أحدهم بيع غرر ، ولا يبع أحدهم ما ليس عنده ) )(@)(@@) ( طب ) عن عتاب بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24441 قال النبي :(@)(@@) | 30 ( هل منكم من أحد يريد أن يؤتيه الله علما بغير تعلم وهدى بغير هداية ؟ هل منكم من أحد يريد أن يذهب الله عنه العمى ويجعله بصيرا ؟ ألا من رغب في الدنيا وطال أمله فيها أعمى الله تعالى قلبه على قدر ذلك ، ومن زهد في الدنيا وقصر أمله فيها أعطاه الله تعالى علما بغير تعلم ، وهدى بغير هداية ، ألا سيكون بعدكم قوم لا يستقيم لهم الملك إلا بالقتل والتجبر ، ولا الغنى إلا بالفخر والتبخل ، ولا المحبة إلا بالاستخراج في الدين واتباع الهوى ، ألا فمن أدرك ذلك الزمان منكم ، فصبر للفقر وهو يقدر على الغنى ، وصبر للذل وهو يقدر على العز ، وصبر للبغضة وهو يقدر على المحبة لا يريد بذلك إلا وجه الله أعطاه الله ثواب خمسين صديقا ) )(@)(@@) ( حل ) عن الالحسن مرسلا .(@)(@@) PageV08P064(@)(@@)(@@)(@@) $ 24442 قال النبي :(@)(@@) | 30 ( هل تنتج إبل قومك صحاح آذانها فتعمد إلى الموسى فتقطع آذانها فتقول هاذه بحيرة ، فتشقها أو تشق جلودها وتقول هاذه حرم فتحرمها عليك وعلى أهلك ما أعطاه الله لك ، ساعد الله أشد من ساعدك ، وموسى الله أحد من موساك ) )(@)(@@) ( حل حم طب ك هق ) عن أبي الأحوص عن أبيه .(@)(@@)(@@)(@@) $ 24443 قال النبي :(@)(@@) | 30 ( هل تدرون من المؤمن ؟ المؤمن من لا يموت حتى يملأ الله مسامعه مما يحب ، ولو أن عبدا اتقى الله في جوف بيت إلى سبعين بيتا على كل بيت باب من حديد ألبسه الله رداء عمله حتى يتحدث الناس به ويزيدون ، قالوا : وكيف يزيدون ؟ قال : لو أن التقي يستطيع أن يزيد في بره لزاد ، وكذلك الفاجر يتحدث الناس بفجوره ويزيدون ، لأنه لو يستطيع أن يزيد في فجوره لزاد ) )(@)(@@) الحكيم ( ك ) في تاريخه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24444 
ms2614	 قال النبي :(@)(@@) | 30 ( هل أنت مستوص ؟ هل أنت مستوص ؟ إذا أردت أمرا فتدبر عاقبته فإن كان رشدا فامضه ، وإن كان سوى ذالك فانته ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن وهب بن ورد المكي رضي الله عنه .(@)(@@)(@@)(@@) $ 24445 قال النبي :(@)(@@) | 30 ( هلا شققت عن قلبه فنظرت أصادق هو أم كاذب ؟ ) )(@)(@@) ( ع طب ض ) عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ 24446 قال النبي :(@)(@@) | 30 ( هلا انتفعتم بجلدها إنما حرم أكلها ) )(@)(@@) مالك والشافعي ( حم خ م ن حب ) عن ابن عباس رضي الله عنهما قال : وجد النبي شاة ميتة ، قال فذكره .(@)(@@)(@@)(@@) $ 24447 قال النبي :(@)(@@) | 30 ( هلا تركت الشيخ في بيته حتى أجيئه يعني أبا بكر ) )(@)(@@) ( ك ) عن أسماء رضي الله عنها .(@)(@@)(@@)(@@) $ 24448 قال النبي :(@)(@@) | 30 ( هلا تركت الشيخ حتى آتيه ؟ إنا لنحفظه ، لأيادي ابنه علينا ) )(@)(@@) ( ك ) وتعقب عن القاسم بن محمد عن أبيه عن أبي بكر رضي الله عنه قال PageV08P065 الذهبي : القاسم لم يدرك أباه ولا أبوه أبا بكر رضي الله عنه .(@)(@@)(@@)(@@) $ 24449 قال النبي :(@)(@@) | 30 ( هلا قلت خذها وأنا الغلام الأنصاري فإن مولى القوم منهم ) )(@)(@@) أبو نعيم عن عقبه بن عبد الرحمن عن أبيه .(@)(@@)(@@)(@@) $ 24450 قال النبي :(@)(@@) | 30 ( هلاك أمتي في ثلاث : في العصبية ، والقدرية ، والرواية من غير ثبت ) )(@)(@@) ( بز ) و ابن أبي حاتم في السنة ، ( عق طب ) وابن عساكر عن ابن عباس وضعف ( طس ) عن أبي قتادة رضي الله عنهم .(@)(@@)(@@)(@@) $ 24451 قال النبي :(@)(@@) | 30 ( هلاك أمتي في الكتاب واللبن ، أما الكتاب فيقرأون القرآن ويتأولونه على غير تأويله ، ويحبون اللبن فيبدون فيدعون الجماعات والجمع ) )(@)(@@) ( حم هب ) و أبو نصر السجزي في الإبانة عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 24452 قال النبي :(@)(@@) | 30 ( هلك المكثرون إلا من قال بالمال هاكذا وهاكذا وهاكذا ، وقليل ما هم ) )(@)(@@) ( حم ) و هناد وعبد بن حميد ( ع ) عن أبي سعيد ، ( طب ) عن عبد الرحمن بن أبزى رضي الله عنه .(@)(@@)(@@)(@@) $ 24453 قال النبي :(@)(@@) | 30 ( هلموا إلي هاذا رسول من رب العالمين جبريل نفث في روعي أن نفسا 
