ms2041	 -(@)(@@) عكرمة بن سليمان بن كثير بن عامر مولى بني شيبة روى عن اسمعيل بن عبد الله بن قسطنطين روى عنه أحمد بن محمد بن عبد الله بن القاسم بن نافع بن ابى بزة المكى.(@)(@@)(@@)(@@) $ 44 -(@)(@@) عكرمة بن طارق روى عنه أبو عقيل المروزى شاه بن حاجب.(@)(@@)(@@)(@@) $ 45 -(@)(@@) عكرمة بن قتادة بن يحيى بن عبد الله بن ابى قتادة الانصاري أبو الوليد روى عن أبيه قتادة بن يحيى روى عنه أحمد بن منصور الرمادي.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عتابا(@)(@@)(@@)(@@) $ 46 -(@)(@@) عتاب بن اسيد القرشى المكى صاحب النبي صلى الله عليه وسلم وعامله على مكة روى عنه سعيد بن المسيب وعبد الله بن عبيدة وعمرو بن عبد الله ابن ابى عقرب سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 47 -(@)(@@) عتاب بن شمير روى عن النبي صلى الله عليه وسلم روى عنه ابنه مجمع بن عتاب بن شمير سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 48 -(@)(@@) عتاب بن حنين المكى ويقال عتاب بن ابى حنين سمع ابا سعيد الخدرى روى عنه عمرو بن دينار ويحيى بن عبد الله بن صيفي سمعت أبي يقول ذلك. PageV07P011(@)(@@)(@@)(@@) $ 49 -(@)(@@) عتاب سمع ابا سعيد روى مسلم بن ابراهيم عن عبد الله بن ميسرة عنه وروى سهل بن حماد العقوى عن ابى ليلى عنه.(@)(@@)(@@)(@@) $ 50 -(@)(@@) عتاب مولى هرمز بصري روى عن أنس روى عنه شعبة سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عتاب مولى هرمز ثقة، ثنا عبد الرحمن قال سألت ابى عن عتاب مولى هرمز فقال شيخ.(@)(@@)(@@)(@@) $ 51 -(@)(@@) عتاب روى عن زيد بن أرقم روى عنه فراس سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 52 -(@)(@@) عتاب بن اعين كوفى نزيل الرى أبو القاسم روى عن الاعمش واسمعيل بن ابى خالد والثوري والمسعودي ومسعر وابى العميس وسعد بن اوس وخلف بن حوشب وشريك روى عنه جرير بن عبد الحميد وعبد الرحمن ابن الحكم بن بشير وهشام بن عبيد الله وعبد الصمد بن 
ms2042	 عبد العزيز المقري وابن حميد سمعت أبي يقول بعض ذلك وبعضه من قبلي، نا عبد الرحمن قال سألت أبي عنه فقال ثقة، ثنا عبد الرحمن قال سألت أبا زرعة عنه فقال كوفى سكن الرى لا بأس به.(@)(@@)(@@)(@@) $ 53 -(@)(@@) عتاب بن سماك بن قربا النخعي سمع إبراهيم النخعي روى عنه الوسيم بن جميل عم قتيبة بن سعيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 54 -(@)(@@) عتاب بن حرب المزني البصري سمع صالح بن رستم سمع منه إبراهيم بن محمد بن عرعرة وعمرو بن علي سمعت أبي يقول ذلك ويقول ضعفه عمرو بن على.(@)(@@)(@@)(@@) $ 55 -(@)(@@) عتاب بن عبد العزيز سمع رحالا القريعى روى عنه يزيد بن هارون وعلي بن نصر سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 56 -(@)(@@) عتاب بن بشير الحرانى أبو الحسن سمع خصيفا وعلى بن بذيمة سمعت أبي يقول ذلك، قال أبو محمد روى عنه محمد بن عيسى ابن الطباع وابن نفيل(@)(@@) PageV07P012(@)(@@) الحرانى، ثنا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال سئل احمد بن حنبل عن عتاب بن بشير فقال أرجو أن لا يكون به بأس روى بأخرة احاديث منكرة وما ارى الا انها من قبل خصيف.(@)(@@) نا عبد الرحمن نا إبراهيم بن يعقوب الجوزجاني فيما كتب إلي قال سمعت أحمد بن حنبل يقول احاديث عتاب عن خصيف منكرة، ثنا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلى قال أنا عثمان بن سعيد قال قلت ليحيى بن معين عتاب بن بشير؟ فقال ثقة، نا عبد الرحمن قال سمعت أبا زرعة وقيل له عتاب بن بشير احفظ أو محمد بن سلمة؟ قال عتاب احب إلى.(@)(@@)(@@)(@@) $ 57 -(@)(@@) عتاب بن زياد بن ورقاء سمع الشعبي وعكرمة وسعيد بن جبير روى عنه حفص بن غياث وأبو أحمد الزبيري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 58 -(@)(@@) عتاب بن زياد المروزى سمع ابن المبارك وابا حمزة السكرى كتب عنه أبي بالري وروى عنه سمعت أبي يقول ذلك، نا عبد الرحمن قال سئل ابى عنه فقال ثقة. 
ms2043	(@)(@@)(@@)(@@) $ 59 -(@)(@@) عتاب بن سعيد روى عن ابن أبي ذئب روى عنه عبد الله بن محمد بن أسماء ابن اخى جويربة بن اسماء.(@)(@@)(@@)(@@) $ 60 -(@)(@@) عتاب بن محمد بن شوذب ابن أخي عبد الله بن شوذب روى عن كعب بن عبد الرحمن روى عنه موسى بن اسمعيل الجبلى (1) ومحمد بن زياد السهمى البلخى سمعت أبي يقول ذلك، قال أبو محمد وروى عن اسمعيل ابن ابى خالد.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عوفا(@)(@@)(@@)(@@) $ 61 -(@)(@@) عوف بن مالك الاشجعى أبو عبد الرحمن له صحبة نزل الشام(@)(@@) روى عنه أبو هريرة ويزيد بن الاصم وسالم أبو النضر مولى عمر بن عبيد الله وشداد أبو عمار وعبد الحميد بن عبد الرحمن بن زيد بن الخطاب وجبير بن نفير PageV07P013(@)(@@) وابو ادريس الخولانى وأبو بردة بن أبي موسى الاشعري وسليم بن عامر وعمرو بن عبد الله الحضرمي وراشد بن سعد وعبادة بن اوفى ومعدى كرب ابن عبد كلال وابو عبلة والد ابراهيم وحبيب بن عبيد وشريح بن عبيد وكثير ابن مرة ومسلم بن قرظة وعامر الشعبى سمعت بعض ذلك من أبي وبعضه من قبلى.(@)(@@)(@@)(@@) $ 62 -(@)(@@) عوف بن مالك بن نضلة أبو الاحوص الجشمى روى عن عبد الله بن مسعود وابيه مالك بن نضلة روى عنه أبو إسحاق الهمداني والحسن البصري ومورق العجلى وعقبة بن وساج وعمارة بن عمير وسلمة بن كهيل وحميد بن هلال وعلى بن الاقمر وعطاء بن السائب سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال أبو الاحوص ثقة.(@)(@@)(@@)(@@) $ 63 -(@)(@@) عوف بن مالك الجابري سمع عليا رضي الله عنه روى عنه أبو الضحاك يحيى بن مسلم سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 64 -(@)(@@) عوف بن مالك أبو غسان المرادى روى عن يوسف بن عبدة روى عنه وهب بن إبراهيم الفامى الرازي.(@)(@@)(@@)(@@) $ 65 -(@)(@@) عوف بن حصيرة (1) الشامي روى عن الشعبى قوله سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 66 -(@)(@@) عوف بن الحارث بن الطفيل رضيع عائشة روى عن 
ms2044	 عائشة(@)(@@) وام سلمة وابن الزبير روى عنه الزهري وبكير بن عبد الله بن الاشج وعامر بن عبد الله بن الزبير وابو الرجال محمد بن عبد الرحمن سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 67 -(@)(@@) عوف بن ابى جدر روى عن السائب بن خباب روى عنه سعيد بن أبي هلال ومحمد بن عجلان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 68 -(@)(@@) عوف بن ابى حداثة روى عن أبي سعيد الخدري روى عنه PageV07P014(@)(@@) جعد (1) بن عبد الرحمن.(@)(@@)(@@)(@@) $ 69 -(@)(@@) عوف بن مجالد ويقال مجالد بن يزيد روى عن زيد بن ثابت روى عنه أبو الزناد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 70 -(@)(@@) عوف البكالى روى عن عمرو البكالي روى عنه يحيى بن أبي عمرو السيباني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 71 -(@)(@@) عوف بن أبي جميلة الأعرابي أبو سهل العبدى الهجرى واسم ابى جميلة رزينة سمعت أبي يقول ذلك، نا عبد الرحمن حدثني أبي نا عمرو بن علي الصيرفي قال سمعت ابا بحر عبد الرحمن بن عثمان البكراوي يقول قلت لعوف ابن من؟ قال عوف بن رزينة، قال أبو محمد روى عن ابى رجاء العطاردي وابى عثمان النهدي وابى العالية وابى المنهال سيار بن سلامة وأبي نضرة وعبد الله بن عمرو ابن هند الجملى والحسن ومحمد بن سيرين وطلق بن حبيب واسحاق بن سويد ويزيد الفارسى وخزاعي بن زياد وشهر بن حوشب وخليد العصرى وانس بن سيرين وزرارة بن اوفى، روى عنه يحيى بن سعيد القطان ومعتمر بن سليمان وروح بن عبادة ويزيد بن هارون والنضر بن شميل والانصاري وهوذة بن خليفه، نا عبد الرحمن، نا أبي نا الانصاري نا عوف بن ابى جميلة وكان يقال له عوف الصدوق.(@)(@@) نا عبد الرحمن نا أبو نشيط محمد بن هارون نا الوليد بن عتبة قال سمعت مروان بن معاوية يقول كان عوف الاعرابي يسمى الصدوق، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سألت ابى عن عوف الاعرابي فقال ثقة صالح الحديث.(@)(@@) نا عبد الرحمن قال ذكره 
ms2045	 أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال عوف بن ابى جميلة ثقة، نا عبد الرحمن قال سألت ابى عن عوف الاعرابي فقال صدوق صالح الحديث. PageV07P015(@)(@@)(@@)(@@) $ 72 -(@)(@@) (عوف بن مجالد روى عن..- 1) .(@)(@@)(@@)(@@) $ 73 -(@)(@@) عوف بن محمد أبو غسان البصري روى عن حماد بن سلمة ومهدى ابن ميمون ومحمد بن مسلم الطائفي سمع منه أبي وروى عنه وسألته عنه فقال هو ثقة.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عائذا(@)(@@)(@@)(@@) $ 74 -(@)(@@) عائذ بن عمرو المزني له صحبة روى عنه الحسن ومعاوية بن قرة وعامر الاحول وخليفة بن عبد الله العنبري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 75 -(@)(@@) عائذ بن نضلة الحنفي أبو ماجد روى عن عبد الله بن مسعود روى عنه يحيى بن عبد الله الجابر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 76 -(@)(@@) عائذ بن نصيب الاسدي والد هشام بن عائذ روى عن ابن عمر وجابر بن سمرة روى عنه شعبة وقيس وابنه هشام بن عائذ بن نصيب سمعت أبي يقول ذلك.(@)(@@) حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى(@)(@@) ابن معين قال عائذ بن نصيب ثقة، نا عبد الرحمن قال سألت ابى عن عائذ بن نصيب فقال هو شيخ.(@)(@@)(@@)(@@) $ 77 -(@)(@@) عائذ الجعفي روى عن النبي صلى الله عليه وسلم روى عنه الجعد ابن الصلت سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 78 -(@)(@@) عائذ بن ابى ضب الكعبي ثم الحبترى روى عن أبي هريرة روى عنه أبو رشدين القاسم بن عمير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 79 -(@)(@@) عائذ بن شريح الحضرمي روى عن أنس روى عنه يوسف بن أسباط ومخلد بن يزيد والفضل بن موسى السيناني سمعت أبي يقول ذلك وسمعته يقول في حديثه صنعة (2) وروى عنه بكر بن بكار الاصبهاني.(@)(@@)(@@)(@@) $ 80 عائذ البلوى روى عن رجل من أهل المدينة عن مروان بن PageV07P016(@)(@@) الحكم عن النبي صلى الله عليه وسلم روى سعيد بن أبي أيوب عن عبد العزيز بن عبد الملك عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 81 -(@)(@@) عائذ بن ربيعة النميري سمع قرة 
ms2046	 بن دعموص النميري روى عنه دلهم بن دهثم العجلى ابودهثم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 82 -(@)(@@) عائذ بن بشير العجلي روى عن عطاء مرسل وروى عن علقمة ابن مرثد وعمرو بن مرة روى عنه يحيى بن اليمان سمعت أبي يقول ذلك (نا يعقوب بن اسحاق في كتابه إلي أنا عثمان بن سعيد الدارمي قال سألت يحيى بن معين عن عائذ بن بشير كيف حديثه؟ فقال ضعيف - 1) .(@)(@@)(@@)(@@) $ 83 -(@)(@@) عائذ بن حبيب أبو احمد القرشى ويقال أبو هشام الاحول روى عن هشام بن عروة وحجاج بن ارطاة وابن أبي عروبة روى عنه ابن الطباع(@)(@@) وابن نفيل سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول عائذ بن حبيب ثقة وهو اخو الربيع بن حبيب، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال عائذ بن حبيب صويلح.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال قلت لابي - عائذ بن حبيب؟ قال ذاك ليس به بأس قد سمعنا منه، نا عبد الرحمن أنا علي بن أبي طاهر فيما كتب إلى قال ثنا أبو بكر الأثرم قال سمعت ابا عبد الله احمد ابن حنبل ذكر عائذ بن حبيب فأحسن الثناء عليه وقال كان شيخا جليلا عاقلا (قال أبو محمد ثنا عنه أبو سعيد الاشج - 2) .(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عرفجة(@)(@@)(@@)(@@) $ 84 -(@)(@@) عرفجة بن شريح ويقال ابن ضريح سمع النبي صلى الله عليه وسلم (3) يقول ستكون هنات وهنات، روى عنه أبو حازم الاشجعى وزياد بن PageV07P017(@)(@@) علاقة وابو يعفور وقدان (يعنى اسمه - 1) العبدي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 85 -(@)(@@) عرفجة بن اسعد بن كرب انه اصيب انفه يوم الكلاب فأمره النبي صلى الله عليه وسلم ان يتخذ انفا من ذهب روى عنه ابن ابنه عبد الرحمن بن طرفة بن عرفجة بن اسعد سمعت ابى يقول ذلك(@)(@@)(@@)(@@) $ 86 -(@)(@@) عرفجة بن عبد الله 
ms2047	 الثقفي روى عن علي وعبد الله بن مسعود وعائشة روى عنه منصور وعطاء بن السائب وعمر بن عبد الله بن يعلى بن مرة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 87 -(@)(@@) عرفجة السلمى روى عن أبي بكر الصديق رضي الله عنه روى عنه محمد بن عبيد الله أبو عون الثقفي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 88 -(@)(@@) عرفجة بن عبد الواحد روى عن عاصم بن بهدلة (2) روى عنه سهيل بن أبي صالح سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عجلان(@)(@@)(@@)(@@) $ 89 -(@)(@@) عجلان مولى المشمعل روى عن أبي هريرة روى عنه ابن أبي ذئب سمعت أبي يقول ذلك، وسمعته يقول قال يحيى بن سعيد القطان سألت ابن ابى ذئب أهو أبو محمد بن عجلان؟ فقال لا، وقال آدم بن ابى اياس حدثنا ابن أبي ذئب قال حدثنا عجلان أبو محمد بن عجلان، ووهم فيه آدم.(@)(@@)(@@)(@@) $ 90 -(@)(@@) عجلان مولى فاطمة بنت عتبة بن ربيعة القرشى والد محمد بن عجلان سمع ابا هريرة وفاطمة بنت عتبة روى عنه بكير بن عبد الله بن الاشج وابنه محمد بن عجلان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 91 -(@)(@@) عجلان مولى لآل يزيد بن الهاد انه سمع أبا هريرة روى عنه يزيد ابن عبد الله بن أسامة بن الهاد سمعت أبي يقول ذلك. PageV07P018(@)(@@)(@@)(@@) $ 92 -(@)(@@) عجلان بن سمعان سمع أبا هريرة روى عنه طلحة بن صالح سمعت أبي يقول ذلك، وسمعته يقول هو مجهول وطلحة مجهول.(@)(@@)(@@)(@@) $ 93 -(@)(@@) عجلان بن سهيل الباهلى سمع أبا أمامة الباهلي روى عنه سليمان بن موسى ورجاء بن أبي سلمة سمعت أبي يقول ذلك، وسمعته يقول روى حديثا واحدا لا اعلم بحديثه بأسا وأدخله بعض الناس في كتاب الضعفاء يحول منه.(@)(@@)(@@)(@@) $ 94 -(@)(@@) عجلان بن سالم سمع ابا قرصافة روى عنه ريان بن الجعد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 95 -(@)(@@) عجلان أبو غالب الخراساني روى عن ابن عباس روى عنه محمد بن عون الخراساني سمعت أبي يقول ذلك، وسألته عنه فقال هو شيخ.(@)(@@)(@@)(@@) $ 96 -(@)(@@) عجلان بن عبد الله من 
ms2048	 بني عدي روى عن مالك بن دينار روى عنه ضرار بن صرد وعبد الرحمن بن صالح العتكي، نا عبد الرحمن قال سئل أبو زرعة عنه فقال بصري لا بأس به.(@)(@@)(@@)(@@) $ 97 -(@)(@@) عجلان مولى ثقيف بصرى روى عن ابى بكرة وسمرة بن جندب قولهما روى حماد بن سلمة عن بحر بن مرار عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عصمة(@)(@@)(@@)(@@) $ 98 -(@)(@@) عصمة بن قيس السلمى له صحبة روى حريز بن عثمان عن ابى الوليد الازهر بن راشد عن عصمة بن قيس السلمى أنه أتى النبي صلى الله عليه وسلم فقال ما اسمك؟ قال عصمة (1) بن قيس قال بل انت عصمة بن قيس، سمعت أبي يقول ذلك، قال أبو محمد هكذا رواه اسمعيل بن عياش عن حريز بن عثمان، قال أبو محمد واختلف عن حريز فحدثنا أبو زرعة الدمشقي نا على بن عياش نا حريز بن عثمان قال حدثنى الوليد بن ازهر الهوزنى (2) عن عصمة صاحب النبي صلى الله عليه وسلم انه كان يتعوذ من فتنة المغرب.(@)(@@)(@@)(@@) $ 99 -(@)(@@) عصمة بن السرح قال شهدت مع النبي صلى الله عليه وسلم حنينا PageV07P019(@)(@@) نا عبد الرحمن قال حدثني أبي نا أبو جميل أحمد بن عبد الله بن عياض المكى بالرى(@)(@@) نا حسين بن عاصم الفزارى المكى نا سعيد بن مزاحم مولى معاوية بن أبي سفيان عن عصمة بن عبد الله بن عصمة عن ابيه عن جده عصمة بن السرح.(@)(@@)(@@)(@@) $ 100 -(@)(@@) عصمة أبو حكيمة الغزال سمع ابا عثمان النهدي روى عنه الضحاك بن يسار وحماد بن سلمة سمعت أبي يقول ذلك، نا عبد الرحمن قال سألت أبي عنه فقال محله الصدق.(@)(@@)(@@)(@@) $ 101 -(@)(@@) عصمة بن عروة الفقيمى روى عن مغيرة بن مقسم روى عنه الحسن بن عمر سمعت أبي يقول ذلك، وسألته عنه فقال مجهول.(@)(@@)(@@)(@@) $ 102 -(@)(@@) عصمة بن بشير البراجمى سمع الفزع روى عنه سيف بن هارون البرجمى سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 103 -(@)(@@) عصمة بن زامل الطائى روى عن أبيه روى عنه 
ms2049	 وكيع وجميل ابن حماد الطائي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 104 -(@)(@@) عصمة بن سالم الهنائى روى عن اشعث بن جابر الحدانى وثابت البنانى روى عنه نوح بن قيس ومسلم بن إبراهيم سمعت أبي يقول ذلك، قال أبو محمد جعل البخاري هذا الاسم الواحد اسمين فسمعت ابى يقول هما واحد فجعلهما واحدا، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلى فقال نا مسلم بن إبراهيم نا عصمة بن سالم الهنائى وكان صدوقا.(@)(@@)(@@)(@@) $ 105 -(@)(@@) عصمة بن زاهر روى عن الأعمش روى عنه على بن نصر الجهضمى ثنا عبد الرحمن قال سئل أبو زرعة عنه فقال يروى عنه الحروف قلت ما حاله؟ قال شيخ.(@)(@@)(@@)(@@) $ 106 -(@)(@@) عصمة بن محمد المدينى الأنصاري روى عن يحيى بن سعيد الانصاري روى عنه أبو حجر عمرو بن رافع سمعت أبي يقول ذلك، وسألته عنه فقال مدينى ليس بقوى.(@)(@@)(@@)(@@) $ 107 -(@)(@@) عصمة بن سليمان الخزاز كوفي سكن بغداد روى عن سفيان الثوري وزهير بن معاوية وحماد بن زيد وجرير بن حازم وعامر بن يساف(@)(@@) PageV07P020(@)(@@) وخلف بن خليفة روى عنه ابى وسألته عنه فقال ما كان به بأس كان احمد بن حنبل في حانوته.(@)(@@)(@@)(@@) $ 108 -(@)(@@) عصمة بن الفضل النيسابوري أبو الفضل روى عن أبي معاوية الضرير وحرمى بن عمارة وعبد المجيد بن عبد العزيز ويحيى بن آدم سمع منه أبي، نا عبد الرحمن قال سئل عنه ابى فقال هو صدوق.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عزرة(@)(@@)(@@)(@@) $ 109 -(@)(@@) عزرة بن قيس البجلي روى عن خالد بن الوليد روى عنه أبو وائل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 110 -(@)(@@) عزرة بن قيس اليحمدى البصري روى عن ام الفيض مولاة عبد الملك بن مروان قالت سألت عبد الله بن مسعود روى عنه أحمد بن إسحاق الحضرمي ومسلم بن إبراهيم، نا عبد الرحمن أخبرنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سئل يحيى بن معين عن عزرة بن قيس هذا فقال لا شئ.(@)(@@)(@@)(@@) $ 111 -(@)(@@) عزرة بن تيمم روى عن أبي 
ms2050	 هريرة روى عنه قتادة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 112 عزرة بن عبد الرحمن الخزاعي كوفي روى عن سعيد بن جبير والشعبى وابن ابزى روى عنه قتادة سمعت أبي يقول ذلك، قال أبو محمد روى عن راشد بن حبيش عن عبادة بن الصامت روى عنه وقاء بن اياس، حدثنا عبد الرحمن حدثنا صالح بن أحمد قال قال ابى عزرة روى عنه قتادة وسليمان التيمي وداود بن أبي هند وخالد الحذاء، حدثنا عبد الرحمن نا صالح بن أحمد(@)(@@) نا علي يعني ابن المديني قال قلت ليحيى بن سعيد القطان من يعرف عزرة صاحب قتادة؟ قال يحيى بلى والله والله انى اعرفه.(@)(@@) نا عبد الرحمن نا عباس بن محمد الدوري قال سمعت يحيى بن معين يقول عزرة الذى يروى عنه قتادة ثقة، نا عبد الرحمن نا محمد بن أحمد بن البراء قال قال علي بن المديني عزرة بن عبد الرحمن ثقة روى عنه قتادة وسليمان التيمي(@)(@@) PageV07P021(@)(@@) وعبد الكريم الجزرى وغيرهم ولم يسمع من البراء.(@)(@@)(@@)(@@) $ 113 -(@)(@@) عزرة بن دينار روى عن الزبير بن خريق روى عنه جعفر بن برقان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 114 -(@)(@@) عزرة بن ثابت بن ابى زيد هو عمرو بن اخطب الانصاري سمع ثمامة وابا الزبير ويحيى بن عقيل روى عنه يزيد بن زريع وصفوان بن عيسى ووكيع وابو عاصم وأبو نعيم ومسلم بن إبراهيم سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال عزرة بن ثابت ثقة، نا عبد الرحمن قال سألت ابى عن عزرة بن ثابت فقال ليس به بأس.(@)(@@)(@@)(@@) $ 115 -(@)(@@) عزرة بن حزام سمع الربيع بن خثيم ووى عنه أبو طعمة نسير ابن ذعلوق سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عواما(@)(@@)(@@)(@@) $ 116 -(@)(@@) عوام بن مراجم القيسي روى عن خالد بن سيحان روى عنه شعبة سمعت أبي يقول ذلك، حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال 
ms2051	 عوام بن مراجم ثقة، نا عبد الرحمن قال سئل ابى عن العوام بن مراجم فقال صالح.(@)(@@)(@@)(@@) $ 117 -(@)(@@) عوام بن حوشب الشيباني الربعي كنيته أبو عيسى روى عن(@)(@@) ابراهيم التيمى وحبيب بن أبي ثابت وسلمة بن كهيل روى عنه شعبة وهشيم ومحمد ابن الحسن المزني ويزيد بن هارون سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلى قال سألت أبي عن العوام بن حوشب فقال ثقة ثقة، حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال العوام بن حوشب ثقة، نا عبد الرحمن قال سألت ابى عن العوام بن حوشب فقال صالح، نا عبد الرحمن قال سئل أبو زرعة عن عوام بن حوشب فقال ثقة.(@)(@@)(@@)(@@) $ 118 -(@)(@@) عوام بن حمزة المازنى سمع ابا عثمان النهدي وابا نضرة وبكر(@)(@@) PageV07P022(@)(@@) ابن عبد الله وسليمان بن فنة روى عنه يحيى بن سعيد القطان وعيسى بن يونس والنضر بن شميل وغندر وعمرو بن النعمان سمعت أبى يقول ذلك، نا عبد الرحمن نا صالح بن أحمد بن محمد بن حنبل حدثنا على بن المديني قال سألت يحيى يعني ابن سعيد القطان عن العوام بن حمزة فقال ما اقربه من مسعود بن على ومسعود ابن على لم يكن به بأس.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين أنه قال العوام بن حمزة المازنى ليس بشئ، نا عبد الرحمن قال سئل أبو زرعة عن العوام بن حمزة المازنى فقال شيخ، قيل كيف ترى استقامة حديثه؟ فقال لا أعلم إلا خيرا.(@)(@@)(@@)(@@) $ 119 -(@)(@@) عوام بن اعين الشيباني روى عن جبلة بن سحيم روى عنه أبو سعيد الأشج، نا عبد الرحمن قال سألت أبي عنه فقال لا أعرفه شيخ مجهول لا أعلم روى عنه غير أبى سعيد الاشج.(@)(@@)(@@)(@@) $ 120 -(@)(@@) عوام بن سلميان المزني المديني روى عن (..روى عنه..- 1) سمعت أبي يقول ذلك ويقول هو مجهول.(@)(@@)(@@)(@@) $ 121 -(@)(@@) عوام بن ابى 
ms2052	 العوام سمع هشام بن عروة روى عنه أبو سلمة موسى بن اسمعيل سمعت أبي يقول ذلك ويقول هو مجهول.(@)(@@)(@@)(@@) $ 122 -(@)(@@) عوام بن المقطع رجل من كلب يعد في البصريين سمع اباه روى عنه بكر بن معبد سمعت أبي يقول ذلك (ويقول هما مجهولان - 2) .(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عميرة(@)(@@)(@@)(@@) $ 123 -(@)(@@) عميرة بن سعد أبو السكن اليمامى الهمداني روى عن على رضي الله عنه روى عنه طلحة بن مصرف والزبير بن عدي سمعت أبي يقول PageV07P023(@)(@@) ذلك، نا عبد الرحمن نا صالح بن أحمد بن محمد بن حنبل نا علي يعني ابن المديني قال سمعت يحيى يعنى القطان يقول لم يكن عميرة بن سعد ممن يعتمد عليه.(@)(@@)(@@)(@@) $ 124 -(@)(@@) عميرة بن زياد روى عن ابن مسعود روى عنه طلحة بن مصرف وأبو إسحاق الهمداني سمعت أبي يقول ذلك ويقول عميرة بن سعد وعميرة بن زياد وعمار بن مالك ليسوا واحدا وهم مختلفون في النسب والتحديث وكان بعض الناس جعلهم واحدا.(@)(@@)(@@)(@@) $ 125 -(@)(@@) عميرة بن كوهان روى عن على رضي الله عنه سمعت أبي يقول ذلك ويقول هو مجهول.(@)(@@)(@@)(@@) $ 126 -(@)(@@) عميرة بن يثربى الضبى قاضى اهل البصرة روى عن أبي بن كعب روى عنه انس بن سيرين وابو حرب بن أبي الأسود سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 127 -(@)(@@) عميرة بن ابى ناجية المصري روى عن يزيد بن ابى حبيب(@)(@@) روى عنه عبد الله بن وهب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 128 -(@)(@@) عميرة بن عبد المؤمن أبو سماعة الرهاوى سمع عصام(@)(@@) بن بشير سمعت أبي يقول ذلك، قال أبو محمد وروى عنه أبي ومحمد بن مسلم، نا عبد الرحمن قال سئل أبي عنه فقال صدوق.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عوسجة(@)(@@)(@@)(@@) $ 129 -(@)(@@) عوسجة مولى ابن عباس روى عن ابن عباس روى عنه عمرو ابن دينار سمعت أبي يقول ذلك، نا عبد الرحمن قال سئل ابى عنه فقال ليس بمشهور، نا عبد الرحمن قال سئل أبو زرعة عنه فقال مكي ثقة.(@)(@@)(@@)(@@) $ 130 -(@)(@@) عوسجة روى عن 
ms2053	 أبيه روى عنه سليمان بن قرم الضبي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 131 -(@)(@@) عوسجة بن الرماح روى عن عبد الله بن ابى الهذيل روى عنه(@)(@@) PageV07P024(@)(@@) عاصم الأحول سمعت أبى يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عوسجة بن الرماح ثقة.(@)(@@)(@@)(@@) $ 132 -(@)(@@) عوسجة بن زياد روى عن عبد الصمد بن علي بن عبد الله بن عباس روى عنه ابن ابنه جعفر بن أحمد بن عوسجة نزيل سامرا.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عصاما(@)(@@)(@@)(@@) $ 133 -(@)(@@) عصام المزني له صحبة روى عنه ابنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 134 -(@)(@@) عصام بن يحيى روى عن أبي قلابة روى عنه معاوية بن صالح سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 135 -(@)(@@) عصام بن قدامة أبو محمد البجلى ويقال الجدلي روى عن مالك(@)(@@) ابن نمير الخزاعى وعكرمة روى عنه علي بن مسهر ووكيع واشعث بن شعبة وأبو نعيم سمعت أبي يقول ذلك، قال أبو محمد روى عنه أبو خالد الاحمر وعقبة بن خالد وعبد الله بن نمير والفريابي، حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عصام بن قدامة الجدلي صالح، نا عبد الرحمن قال سألت ابى عن عصام بن قدامة قال لا بأس به، نا عبد الرحمن قال سئل أبو زرعة عن عصام بن قدامة فقال كوفي لا بأس به.(@)(@@)(@@)(@@) $ 136 -(@)(@@) عصام بن بشير بن الحارث بن كعب سمع انس بن مالك واباه روى عنه سعيد بن مروان وعميرة بن عبد المؤمن الرهاويان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 137 -(@)(@@) عصام بن راشد روى عن يزيد بن ابى حبيب وموسى بن وردان روى عنه مروان بن معاوية سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 138 عصام بن زيد روى عن محمد بن المنكدر روى عنه عبد الله بن نافع الصائغ.(@)(@@)(@@)(@@) $ 139 -(@)(@@) عصام بن حميد روى عن ... (1) روى عنه أبو المليح.(@)(@@)(@@)(@@) $ 140 -(@)(@@) عصام بن طليق (روى عن..روى عنه..قرئ على PageV07P025(@)(@@) الدوري عن يحيى بن معين انه 
ms2054	 قال عصام بن طليق - 1) ليس بشئ، نا عبد الرحمن قال سئل أبو زرعة عن عصام بن طليق فقال ضعيف الحديث.(@)(@@)(@@)(@@) $ 141 -(@)(@@) عصام بن خالد أبو اسحاق الحمصى روى عن صفوان بن عمرو روى عنه أحمد بن محمد بن حنبل سمعت أبي يقول ذلك، قال أبو محمد روى عن عصام بن خالد محمد بن عوف الحمصي ومحمد بن مسلم الرازي وغيرهما.(@)(@@)(@@)(@@) $ 142 عصام بن المثنى الحمصى روى عن أبيه عن عبد الله بن بسر المازني صاحب النبي صلى الله عليه وسلم روى عنه عمرو بن عثمان بن سعيد بن كثير بن دينار ومحمد بن عوف الطائي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 143 -(@)(@@) عصام بن يزيد الاصبهاني ويعرف بجبر خادم سفيان الثوري روى عن الثوري ومالك بن انس وشريك وعبد الواحد بن زيد وعبد الرحمن ابن عمر رسته روى عنه ابناه محمد وروح، نا عبد الرحمن نا محمد بن يحيى بن منده الأصبهاني باصبهان حدثنى عبد الله بن عمر يعني اخا عبد الرحمن رسته قال سمعت عبد الرحمن بن مهدى وذكر جبر فقال عصام كان ابدا يسأل سفيان عن المسائل.(@)(@@)(@@)(@@) $ 144 -(@)(@@) عصام بن يوسف الزاهد البلخى روى عن عبد المجيد بن عبد العزيز بن أبي رواد روى عن عاصم بن زمزم البلخى.(@)(@@)(@@)(@@) $ 145 -(@)(@@) عصام بن رواد العسقلاني أبو صالح روى عن ابيه وآدم بن ابى اياس روى عنه ابى وكتبت انا عنه، نا عبد الرحمن قال سئل أبي عنه فقال صدوق.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عويمرا(@)(@@)(@@)(@@) $ 146 -(@)(@@) عويمر أبو الدرداء له صحبة وهو عويمر بن قيس بن زيد ابن قيس بن امية بن عامر بن عدى بن كعب بن خزرج بن الحارث من الخزرج من بلحارث بن الخزرج ويقال اسمه عامر بن مالك وعويمر لقبه نزل الشام، نا عبد الرحمن نا أحمد بن سنان حدثنا أبو احمد الزبيري نا مسعر PageV07P026(@)(@@) عن القاسم بن عبد الرحمن قال كان أبو الدرداء من الذين اوتوا العلم.(@)(@@) حدثنا عبد الرحمن نا أبي نا أبو 
ms2055	 نعيم نا القاسم بن معن عن منصور عن مسلم يعنى ابا الضحى عن مسروق قال شاممت أصحاب محمد صلى الله عليه وسلم فوجدت علمهم انتهى إلى ستة إلى على وعمر وعبد الله ومعاذ وابى الدرداء وزيد بن ثابت، نا عبد الرحمن أنا يونس بن عبد الاعلى قراءة قال أنا ابن وهب قال أخبرني حيى بن عبد الله عن عبد الرحمن الحجرى قال قال أبو ذر لابي الدرداء ما حملت ورقاء ولا اظلت خضراء اعلم منك يا ابا الدرداء.(@)(@@) نا عبد الرحمن نا الحسن بن على بن مهران المتوفى نا علي بن بحر بن بري ثنا سفيان بن عيينة عن ابن ابى مليكة (قال سمعت يزيد بن معاويه 1) يقول ان ابا الدرداء من الفقهاء العلماء الذين يشفون من الداء (قال أبو محمد ليس هذا يزيد بن معاوية بن ابى سفيان - 1) .(@)(@@) (نا علي بن الحسن الهسنجاني نا سعيد بن الحكم يعنى ابن ابى مريم قال نا الليث عن عبد الله بن سعيد قال رأيت ابا الدرداء دخل المسجد مسجد النبي صلى الله عليه وسلم ومعه من الاتباع مثل ما يكون مع السلطان بين سائل عن فريضة وبين سائل عن حساب وبين سائل عن شعر وبين سائل عن حديث وبين سائل عن معضلة - 2) نا عبد الرحمن حدثني أبي نا عبد الرحمن بن محمد ابن سلام بطرسوس نا قبيصة عن سفيان عن ثور عن خالد بن معدان قال كان عبد الله بن عمر ويقول حدثونا عن العاقلين معاذ وابى الدرداء.(@)(@@) روى عنه ام الدرداء امرأته وابو ادريس الخولانى وعطاء بن يسار سمعت أبي يقول ذلك، قال أبو محمد روى عنه فضالة بن عبيد وانس بن مالك وابو امامة وعبد الله بن عمرو وعلقمة بن قيس وزيد بن وهب وسعيد بن المسيب وابنه بلال وأبو سلمة بن عبد الرحمن وخالد بن معدان ومعدان بن ابى طلحة واسد بن وداعة وسليم بن عامر وطاوس وعبد الرحمن بن جبير وعمرو PageV07P027(@)(@@) ابن الاسود وشريح بن عبيد وابو الزاهرية 
ms2056	 وجبير بن نفير ويريد بن خمير وحبيب بن عبيد وعبد الرحمن بن غنم ويوسف بن عبد الله بن سلام وابو عبد الرحمن السلمى.(@)(@@)(@@)(@@) $ 147 -(@)(@@) عويمر بن اشقر له صحبة مديني روى عنه عباد بن تميم ومحمد بن يحيى بن حبان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 148 -(@)(@@) عويمر بن عبد الله السلمى رأى ابا ايوب يتفلى في المسجد روى عنه يعقوب بن عتبة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى علباء(@)(@@)(@@)(@@) $ 149 -(@)(@@) علباء السلمي له صحبة روى عنه جعفر بن عبد الله بن ابى الحكم الأنصاري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 150 -(@)(@@) علباء روى عن على رضي الله عنه (روى عنه - 1) ابن اخيه عمرو بن غزى سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 151 -(@)(@@) علباء بن احمر اليشكرى روى عن عمرو بن اخطب وعكرمة روى عنه داود بن أبي الفرات وعزرة بن ثابت وحسين بن واقد سمعت أبى يقول ذلك، نا عبد الرحمن حدثنى محمد بن حمويه بن الحسن قال سمعت أبا طالب قال سألت أحمد بن حنبل عن علباء بن احمر فقال لا بأس به ما اعلم الا خيرا، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال علباء بن احمر ثقة، نا عبد الرحمن قال سئل أبو زرعة عن علباء فقال بصرى ثقة.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عباية(@)(@@)(@@)(@@) $ 152 -(@)(@@) عباية بن بجير روى عن النبي صلى الله عليه وسلم انه خرج إليه فاسلم وانكر عليه ميسم ابله عند الخطام وامره فوسمها عند الورك روى عنه ابنه يزيد بن عباية.(@)(@@)(@@)(@@) $ 153 -(@)(@@) عباية بن رداد روى عن عمر رضي الله عنه روى عنه محمد بن PageV07P028(@)(@@) المنتشر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 154 -(@)(@@) عباية بن رفاعة بن رافع بن خديج سمع جده رافع بن خديج وابن عمر روى عنه أبو حيان التيمى وسعيد بن مسروق وابو بلج وابو بشر وعاصم بن كليب سمعت أبي يقول ذلك، نا عبد الرحمن أنا يعقوب بن إسحاق فيما 
ms2057	 كتب إلي قال نا عثمان بن سعيد قال قلت ليحيى بن معين عباية بن رفاعة بن رافع ما حاله؟ فقال ثقة.(@)(@@)(@@)(@@) $ 155 -(@)(@@) عباية بن ربعى الأسدي كوفي روى عن علي وأبى أيوب وابن عباس روى عنه خيثمة بن عبد الرحمن وسلمة بن كهيل والاعمش وموسى بن طريف سمعت أبي يقول ذلك، نا عبد الرحمن قال سألت أبي عنه فقال كان من عتق الشيعة قلت ما حاله؟ قال شيخ(@)(@@)(@@)(@@) $ 156 - عباية بن عبد الله الشامي روى عن سالم بن عبد الله ومجاهد روى عنه مسلم بن إبراهيم، نا عبد الرحمن قال سألت ابى عن عباية بن عبد الله فقال لا بأس به(@)(@@)(@@)(@@) $ 157 -(@)(@@) عباية بن بكر بن ابى ليلى المزني روى عن ابراهيم بن اسمعيل بن مجمع روى عنه اسمعيل بن أبي أويس سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عفيفا(@)(@@)(@@)(@@) $ 158 -(@)(@@) عفيف الكندى ابن عم الاشعث بن قيس له صحبة روى عنه ابناه اياس ويحيى بن عفيف الكندي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 159 -(@)(@@) عفيف بن معدى كرب سمع عمر بن الخطاب رضي الله عنه(@)(@@) (روى عنه..- 1) سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 160 -(@)(@@) عفيف بن عمرو السهمى روى عن رجل من بني اسد انه سأل ابا ايوب الأنصاري روى عنه بكير بن عبد الله بن الاشج ومالك بن أنس سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 161 -(@)(@@) عفيف بن سالم الموصلي روى عن الاوزاعي وخليد بن دعلج روى عنه عيسى بن إبراهيم البركى والنفيلي وداود بن رشيد سمعت أبي يقول PageV07P029(@)(@@) ذلك، وروى عن سفيان الثوري روى عنه محمد بن عثمان الموصلي، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول عفيف بن سالم الموصلي ثقة، نا عبد الرحمن قال سألت ابى عن عفيف بن سالم فقال ثقة لا بأس به.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عفان(@)(@@)(@@)(@@) $ 162 -(@)(@@) عفان بن سعيد روى عن ابن الزبير روى عنه مسعر بن كدام سمعت أبي 
ms2058	 يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 163 -(@)(@@) (عفان الازدي مع ابن عمر روى عنه قتادة سمعت أبي يقول ذلك ويقول هو مجهول - 1)(@)(@@)(@@)(@@) $ 164 -(@)(@@) عفان بن جبير الطائى روى عن ابى حريز أو جرير روى عنه سعد أبو غيلان الشيباني وجعفر بن عون سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 165 -(@)(@@) عفان بن مسلم الصفار أبو عثمان روى عن شعبة وسليمان بن المغيرة والأسود بن شيبان وحماد بن سلمة وحماد بن زيد سمعت أبي يقول ذلك، قال أبو محمد وروى عنه أبو بكر بن أبي شيبة والحسن بن محمد بن الصباح وأبي(@)(@@) وأبو زرعة.(@)(@@) نا عبد الرحمن انا الحسن بن محمد بن الصباح قال سمعت (2) يحيى بن سعيد القطان يقول ما ابا لى إذا وافقنى عفان من خالفني، حدثنا عبد الرحمن أنا عبد الله ابن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت ابى يقول عفان اثبت من عبد الرحمن بن مهدي لزمنا عفان عشر سنين ببغداد، قال أبو محمد سألت أبي عن عفان فقال ثقة متقن متين(@)(@@)(@@)(@@) $ 166 -(@)(@@) عفان بن سيار الجرجاني روى عن مسعر وعبد العزيز بن أبي رواد ومحمد بن مسلم الطائفي وخارجة بن مصعب روى عنه عيسى بن ابى فاطمة PageV07P030(@)(@@) الرازي وهشام بن عبيد الله وعيسى بن زياد الرازي سمعت أبي يقول ذلك وسألته عنه فقال هو شيخ.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عيينة(@)(@@)(@@)(@@) $ 167 -(@)(@@) عيينة بن عاصم بن السعر بن نقادة الأسدي روى عن أبيه عن جده عن نقادة الاسدي قال قال النبي صلى الله عليه وسلم ألم ارك تسم في الوجه؟ قلت بلى، سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 168 -(@)(@@) عيينة بن عبد الرحمن بن جوشن الغطفانى روى عن أبيه وأبى الزبير ومروان الاصفر روى عنه شعبة وابو بحر البكراوى ومحمد بن عبد الله الأنصاري سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن نا أبي نا علي بن محمد الطنافسي نا وكيع عن عيينة بن عبد الرحمن ابن جوشن الغطفانى وكان ثقة، نا عبد الرحمن أنا عبد 
ms2059	 الله بن أحمد بن محمد بن حنبل فيما كتب إلى قال سئل أبي عن عيينة بن عبد الرحمن فقال ليس به بأس صالح(@)(@@) الحديث.(@)(@@) نا عبد الرحمن نا عباس بن محمد الدوري قال سمعت يحيى بن معين يقول عيينة بن عبد الرحمن ثقة، نا عبد الرحمن قال سألت ابى عن عيينة بن عبد الرحمن فقال صدوق.(@)(@@)(@@)(@@) $ 169 -(@)(@@) عيينة بن عبد الرحمن روى عن عبيد الله بن عمر روى عنه.. (1) نا عبد الرحمن قال سألت أبي عنه فقال ضعيف الحديث.(@)(@@)(@@)(@@) $ 170 -(@)(@@) عيينة والد سفيان بن عيينة (وهو عيينة بن ابى عمران مولى بنى هلال الكوفى روى عن الحسن روى عنه ابنه سفيان بن عينية - 2) سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول كان أبو سفيان بن عيينة صيرفيا بالكوفة فر من طارق وما سمعت أحدا حدث عنه غير ابنه سفيان.(@)(@@)(@@)(@@) $ 171 -(@)(@@) عيينة بن الغصن روى عن الحسن روى عنه جرير بن عبد الحميد PageV07P031(@)(@@) ونعيم بن ميسرة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عريبا(@)(@@)(@@)(@@) $ 172 -(@)(@@) عريب المليكى راعى رسول الله صلى الله عليه وسلم جد يزيد بن عبد الله بن عريب روى عن النبي صلى الله عليه وسلم روى عنه ابنه عبد الله بن عريب من رواية أبي مهدي سعيد بن سنان وسعيد ضعيف الحديث روى عن يزيد بن عبد الله بن عريب عن ابيه عن جده عريب المليكى.(@)(@@)(@@)(@@) $ 173 -(@)(@@) عريب بن حميد أبو عمار الهمداني الدهنى كوفى روى عن على وقيس بن سعد بن عبادة روى عنه أبو إسحاق الهمداني، نا عبد الرحمن أنا أبو بكر بن(@)(@@) أبي خيثمة فيما كتب إلى قال سألت أحمد بن حنبل ويحيى بن معين عن ابى عمار فقالا اسمه عريب بن حميد وهو كوفى ثقة.(@)(@@)(@@)(@@) $ 174 -(@)(@@) عريب المشرقي روى عن عبد الرحمن اليامى روى عنه عبد الجبار ابن العباس الهمداني الشامي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى 
ms2060	 عنه العلم ممن يسمى عطافا(@)(@@)(@@)(@@) $ 175 -(@)(@@) عطاف بن خالد أبو صفوان القرشى المخزومى المدينى روى عن زيد بن أسلم ونافع وعبد الرحمن بن حرملة روى عنه الوليد بن مسلم وابو اليمان وآدم العسقلاني وابو صالح كاتب الليث ويحيى بن عبد الله بن بكير سمعت أبي يقول ذلك قال أبو محمد (روى عن..- 1) روى عنه أبو عامر العقدي.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي عن ابى سلمة الخزاعى عن عبد الرحمن بن مهدي انه ذهب إلى عطاف فلم يرضه، نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال سألت احمد بن حنبل عن عطاف بن خالد - فقال هو من اهل المدينة ثقة صحيح الحديث روى نحو مائة حديث.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد فيما كتب إلى قال سئل أبي عن عطاف PageV07P032(@)(@@) ابن خالد فقال ليس به بأس، قال عبد الله وسئل ابى عن يحيى بن حمزة وعطاف فقال ما اقربهما عطاف صالح الحديث، ثنا عبد الرحمن قال قرئ على العباس بن محمد قال سمعت يحيى بن معين يقول عطاف بن خالد ليس به بأس ثقة صالح الحديث.(@)(@@) نا عبد الرحمن قال سألت أبي عن عطاف بن خالد فقال صالح ليس بذاك محمد بن اسحاق وعطاف هما باب رحمة (1) نا عبد الرحمن قال سئل أبو زرعة(@)(@@) عن عطاف بن خالد فقال ليس به بأس.(@)(@@)(@@)(@@) $ 176 -(@)(@@) عطاف الشامي روى عن هشام بن عروة روى عنه زكريا بن منظور، حدثنا عبد الرحمن قال سمعت أبي يقول ذلك، وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 177 -(@)(@@) عطاف المعلم الدمشقي روى عن الأوزاعي ومالك بن انس ادركه هشام بن عمار واحمد بن ابى الحوارى سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عطاردا(@)(@@)(@@)(@@) $ 178 -(@)(@@) عطارد بن برز ابوا لعشراء الدارمي ويقال اسمه اسامة بن مالك ابن قهطم روى عن ابيه ولا بيه صحبة روى عنه حماد بن سلمة سمعت أبي 