ms281	 " ج ".(@)(@@)(@@)(@@) $ 2993 - أبو مسروق، اسمه عبد الله وابنه الهيثم، قال حمدوية: سمعت أصحابنا يذكرونهما، وكلاهما فاضلان " صه " " كش ".(@)(@@)(@@)(@@) $ 2994 - أبو مصعب الزيدي، ثقة من أصحاب الكاظم عليه السلام " صه " " جخ " قال الشيخ أبو علي: ولعل المراد بالنسبة البنوة، ولذا ذكره في الحاوي في الثقات، لكن في الوجيزة " ق " فتأمل (1) انتهى.(@)(@@)(@@)(@@) $ 2995 - أبو مليك " ظم " لم أظفر على الزيادة من الاسم والوصف.(@)(@@)(@@)(@@) $ 2996 - أبو موسى الضرير البجلي، عيسى بن المستفاد، مجمع عنه المنتهى.(@)(@@)(@@)(@@) $ 2997 - أبو موسى المشاجعي، هارون بن عمر بن عبد العزيز، مجمع عنه المنتهى.(@)(@@)(@@)(@@) $ 2998 - أبو النمير مولى الحارث بن المغيرة النصري، غير معلوم. الظاهر أنه في هذه الطبقة، روى الصدوق عنه بوسائط.(@)(@@)(@@)(@@) $ 2999 - أبو نواس الشاعر، كان في زمن الرضا عليه السلام ومدحه كثيرا، وربما يظهر من مدايحه حسن عقيدته، واسمه الحسن بن هاني على ما في " ب " وكذا في القاموس.(@)(@@)(@@)(@@) $ 3000 - أبو الوليد الكوفي، مثنى بن راشد، مجمع عنه المنتهى.(@)(@@)(@@)(@@) $ 3001 - أبو هاشم الجعفري، اسمه داود بن القاسم، أحد عظماء هذه(@)(@@) PageV01P385(@)(@@) الطائفة، لقى " ج " و " دي " و " ري " والصاحب عليهم السلام.(@)(@@)(@@)(@@) $ 3002 - أبو همام، له مسائل، عنه أحمد بن محمد بن عيسى " ست " اسمه إسماعيل بن همام " صه " تقدم في الأسماء.(@)(@@)(@@)(@@) $ 3003 - أبو يحيى الموصلي " ضا " حمدوية عن العبيدي عن يونس، قال: أبو يحيى الموصلي ولقبه كوكب الدم، كان شيخا من الأخيار، قال العبيدي: أخبرني الحسن بن علي بن يقطين أنه كان يعرفه أيام أبيه له فضل " كش " وفي " تعق " اسمه زكريا.(@)(@@)(@@)(@@) $ 3004 - أبو يحيى الواسطي، له كتاب " ست " عنه أحمد بن أبي عبد الله " ست " تقدم سهيل بن زياد أبو يحيى الواسطي وفي " تعق " استظهر انه هو ومن القرائن رواية أحمد عنه كما فيه أيضا ولا يخلو من شئ.(@)(@@)(@@)(@@) $ 3005 - أبو يزيد المكي " ضا " لم أقف على اسمه ولا وصفه في كتب الرجال.(@)(@@)(@@)(@@) $ 3006 - أبو اليسع سهل بن اليسع، وهو من أصحاب " ظم " و " ضا " عليهما السلام الا أنه لم يذكر له هذه الكنية في الأسماء، 
ms282	 فلاحظ.(@)(@@)(@@)(@@) $ 3007 - أبو يعقوب البصري، إسحاق بن محمد البصري الغالي، وقد مر يوسف بن السخت البصري أيضا، ويأتي لفارس بن حاتم والثلاثة في هذه الطبقة.(@)(@@)(@@)(@@) $ 3008 - أبو يعقوب الجعفي، عنه أحمد بن ميثم بكتابه " ست " وفي المنتهى ظاهر " ست " كونه اماميا، ورواية جماعة كتابه تدل على الاعتماد عليه، وفي بعض الكتب نقله عن " جش " وكأنه ليس فيه.(@)(@@)(@@)(@@) $ 3009 - أبو يعلى القمي حمزة بن يعلى الأشعري، مجمع عنه المنتهى.(@)(@@)(@@)(@@) $ 3010 - أبو اليقظان الأسدي عمار، وفي " تعق " أشرنا في عمار إلى ظهور اتحاده مع البكري، قلت: نقلناه هناك عن المجمع أيضا في المنتهى.(@)(@@)(@@)(@@) $ 3011 - أبو يقظان البكري عمار.(@)(@@)(@@)(@@) $ 3012 - أبو يوسف، يعقوب بن السكيت.(@)(@@)(@@)(@@) $ 3013 - أبو يوسف الكاتب الأنباري، يعقوب بن يزيد.(@)(@@) ابن أبي الزرقاء، تقدم مع أبي السمهري، وفي آخر الحديث قال أبو جعفر الثاني PageV01P386(@)(@@) عليه السلام أشهدكم أني أبرأ إلى الله عز وجل جلاله منهما انهما فتانان ملعونان وفي " كش " زاد عليه، فلاحظ.(@)(@@)(@@)(@@) $ 3014 - ابن أبي جهمة، جهم بن أبي الجهم " تعق ".(@)(@@)(@@)(@@) $ 3015 - ابن أبي سعيد المكاري، اسمه الحسين بن أبي سعيد، وقد تقدم أنه من الواقفة.(@)(@@)(@@)(@@) $ 3016 - ابن أبي عثمان، الحسن بن علي بن أبي عثمان " غين " في المنتهى.(@)(@@)(@@)(@@) $ 3017 - ابن أبي نصر البزنطي، أحمد بن عمرو بن أبي نصر، كما عن المجمع أقول: كونه أحمد بملاحظة البزنطي، والا فهو عمر وزيد أبي بصير كما لا يخفى، فحينئذ يكون في التالية.(@)(@@)(@@)(@@) $ 3018 - ابن أبي عمران، موسى بن رنجويه " تعق " وفي المنتهى ابن عمران كما مر في ترجمته، ومضى في الكنى أيضا.(@)(@@)(@@)(@@) $ 3019 - ابن أبي عمير المشهور، محمد بن زياد بن عيسى " تعق ".(@)(@@)(@@)(@@) $ 3020 - ابن بقاح، هو الحسن بن علي بن بقاح الذي يروى عن أصحاب " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3021 - ابن بنت الياس، هو الحسن بن علي الوشاء، من أصحاب " ظم " عليه السلام، وقد مضى في عنوانين: أحدهما هذا، والآخر في ابن زياد الوشاء.(@)(@@)(@@)(@@) $ 3022 - ابن بندار العاصمي، دعا لهما أبو الحسن عليه السلام " صه ".(@)(@@)(@@)(@@) $ 3023 - ابن جعدة، واقفي " ظم 
ms283	 " في نسخة، وفي أخرى أبو الجعدة، وقد تقدم أنه من أصحابه.(@)(@@)(@@)(@@) $ 3024 - ابن جمهور، اسمه محمد، وكانه محمد بن الحسن بن جمهور، وقد تقدم في عنوانين.(@)(@@)(@@)(@@) $ 3025 - ابن حمدون الكاتب النديم، اسمه أحمد بن إبراهيم، تقدم أنه كان خصيصا بأبي الحسن وأبي محمد عليهما السلام.(@)(@@)(@@)(@@) $ 3026 - ابن خانبة، هو أحمد بن عبد الله بن مهران، وتقدم فيه. PageV01P387(@)(@@)(@@)(@@) $ 3027 - ابن راشة المتطبب " دي " في نسخة، وفي أخرى أبو راشة، كما تقدم.(@)(@@)(@@)(@@) $ 3028 - ابن السراج، وابن أبي سعيد، وعلي بن أبي حمزة البطائني، كانوا من أهل الضلال " صه " وكأنه أحمد بن أبي بشر، وقد تقدم.(@)(@@)(@@)(@@) $ 3029 - ابن السكيت اللغوي، اسمه يعقوب بن إسحاق، كما تقدم (@)(@@)(@@)(@@) $ 3030 - ابن عبدك، من أهل جرجان، يكنى أبا محمد محمد بن علي العبدكي، من كبار المتكلمين في الإمامة، وكان يذهب إلى الوعيد، وكذلك الصرام.(@)(@@)(@@)(@@) $ 3031 - ابن مياح المدائني، اسمه الحسين، ضعيف، يروي عن أبيه.(@)(@@)(@@)(@@) $ 3032 - ابن نمير، هو عبد الله وابنه محمد، هما من علماء العامة، كان أحمد بن حنبل يعظم ابن نمير تعظيما عجيبا. وقال ابن صالح: ما رأيت بالعراق مثله.(@)(@@)(@@)(@@) $ 3033 - ابن نهيك، اسمه عبد الله بن أحمد بن نهيك، ويقال: عبيد الله، وهو أيضا في السابقة.(@)(@@)(@@)(@@) $ 3034 - البرقي، هو الأب عند الاطلاق، وقد يأتي لابنه أحمد، واطلاقه عليه مطلقا قليل.(@)(@@)(@@)(@@) $ 3035 - البلالي، الظاهر أنه محمد بن علي بن بلال، وهو من رجال علي الهادي العسكري عليهما السلام، ويحتمل أباه علي، وهو من رجال الجواد عليه السلام أيضا، وفي رجال " ري " عليه السلام محمد بن بلال.(@)(@@)(@@)(@@) $ 3036 - الجاموراني، هو محمد بن أحمد أبو عبد الله الرازي، قد تقدم في الكنى.(@)(@@)(@@)(@@) $ 3037 - الجواني، هو علي بن إبراهيم بن محمد بن الحسن بن محمد، ولعل نسبته إلى قرية جوانية من نواحي مدينة نسبة إلى بلد جده، والا فقد قيل: إن هذا ولد بالمدينة ونشأ بالكوفة ومات بها، فقد صار هذا نسبة لأولاده.(@)(@@)(@@)(@@) $ 3038 - الجرمي، هو علي بن الحسن الطاهري، وأما إسماعيل بن عبد الرحمن الجرمي فهو في 
ms284	 التالية على الظاهر.(@)(@@)(@@)(@@) $ 3039 - الحماني، له كتاب المناقب، عنه أحمد بن ميثم " ست ". PageV01P388(@)(@@)(@@)(@@) $ 3040 - الخيراني، هو ابن خيران الخادم مولى الرضا عليه السلام، وخيران هذا من أصحاب الجواد والهادي عليهما السلام ثقة. وأما ابنه فلم أظفر بذاته ولا وصفه مدحا أو ذما.(@)(@@)(@@)(@@) $ 3041 - الدهقان، هو إبراهيم الدهقان، من أصحاب الهادي عليه السلام ظاهر، وأما غيره فهو في الطبقة السابقة، كما مرت إليه الإشارة.(@)(@@)(@@)(@@) $ 3042 - الزبيري، والزبيريون في أصحابنا ثلاثة: عبد الله بن عبد الرحمن وأبو محمد عبد الله بن هارون، وأبو عمرو محمد بن عمرو بن عبد الله بن مصعب بن الزبير.(@)(@@)(@@)(@@) $ 3043 - الساباطي، اسمه عمرو بن سعيد " صه ".(@)(@@)(@@)(@@) $ 3044 - الشباب الصيرفي، هو محمد بن الوليد " تعق " يروي عنه سهل، ضعيف كما مر في الأسماء عن " صه " و " غض ".(@)(@@)(@@)(@@) $ 3045 - الطاطري، هو علي بن الحسن الجرمي المتقدم، وقد مر في الأسماء.(@)(@@)(@@)(@@) $ 3046 - الطيالسي، محمد بن خالد، تقدم في الأسماء أنه أيضا في الطبقة السابقة.(@)(@@)(@@)(@@) $ 3047 - العاصمي، اسمه عيسى بن جعفر بن عاصم " صه " ذكر ذلك مع ابن بندار، وأنه دعا له أبو الحسن عليه السلام ويقال: لأحمد بن محمد بن أحمد بن طلحة بن عاصم، المعبر عنه قليلا بأحمد بن محمد بن عاصم.(@)(@@)(@@)(@@) $ 3048 - العامري، عثمان بن عيسى الرواسي، قد تقدم في الأسماء، وأما حسين بن عثمان العامري فيأتي في التالية، وكذا عبيد بن كثير العامري في الطبقات الآتية.(@)(@@)(@@)(@@) $ 3049 - العمري، هو عثمان بن سعيد في هذه الطبقة. وأما حفص بن عمرو، ففي السابقة من أصحاب أبي محمد عليه السلام.(@)(@@)(@@)(@@) $ 3050 - الغفاري، اسمه عبد الله بن إبراهيم الغفاري، عنه الحسن بن فضال وغيره، قد تقدم في الأسماء. PageV01P389(@)(@@)(@@)(@@) $ 3051 - الفهري، لعنه علي بن محمد عليهما السلام، وكأنه محمد بن نصير النميري، صرح به " كش ".(@)(@@)(@@)(@@) $ 3052 - المحمودي، اسمه محمد بن أحمد بن حماد أبو علي كما مضى.(@)(@@)(@@)(@@) $ 3053 - المخزومي، من خاصة أبي الحسن وثقاته، ومن أهل الورع والعلم والفقه، وروي أن أمه كانت من ولد جعفر بن أبي طالب، وكأنه المغيرة بن 
ms285	 توبة المخزومي.(@)(@@)(@@)(@@) $ 3054 - المسلي، هو محمد بن عبد الله المسلي، ومسلية قبيلة من مذحج قد تقدم، وهو في هذه الطبقة، ويطلق على غيره وهو في غيرها.(@)(@@)(@@)(@@) $ 3055 - المشرقي، يقال: لهشام بن إبراهيم المشرقي الختلي، وقد تقدم في الأسماء.(@)(@@)(@@)(@@) $ 3056 - الميثمي، هو أحمد بن الحسن بن إسماعيل بن ميثم، واقفي ثقة، تقدم في الأسماء.(@)(@@)(@@)(@@) $ 3057 - النخعي، اسمه أيوب بن نوح، ويجئ لغيره " صه " والنوفلي هو النخعي، وكأنه أشهر بهذا اللقب.(@)(@@)(@@)(@@) $ 3058 - النوفلي الذي يروي عن السكوني، اسمه الحسين بن يزيد.(@)(@@)(@@)(@@) $ 3059 - النهيكي، الأصح أنه عبد الله، ويقال: عبيد الله أيضا، وقد تقدم في الأسماء.(@)(@@)(@@)(@@) $ 3060 - الوشاء بالتشديد، اسمه الحسن بن زياد، وتقدم في الأسماء.(@)(@@)(@@)(@@) $ 3061 - اليعقوبي هو داود بن علي الهاشمي، وقد تقدم.(@)(@@)(@@)(@@) $$ 3062 - زينب بنت محمد بن يحيى " ج " وهو غير العطار قطعا، فإنه من مشايخ الكليني، فهي: اما في طبقة أبيها، أو الراوي عنه.(@)(@@)(@@)(@@) $$ 3063 - الرباب، امرأة داود بن كثير الرقي، في التالية أيضا.(@)(@@)(@@)(@@) $$ 3064 - زهراء، أم أحمد بن الحسين، وهو أحمد بن داود البغدادي " ج ".(@)(@@)(@@)(@@) $$ 3065 - سرية، جدة أبي طاهر أحمد بن عيسى، وهي أم ولد تدعى سرية " ق " هكذا وجدته في تلخيص الميرزا. والظاهر أن النسخة مغلوطة، أو وقع سهو منه، PageV01P390(@)(@@) إذ أبو طاهر هو أخو أحمد بن محمد بن عيسى وليس كنية له، فسقط محمد بعد الابن والأخ قبل أحمد.(@)(@@)(@@)(@@) $$ 3066 - سعيدة ومنة أختا محمد بن أبي عمير.(@)(@@)(@@)(@@) $$ 3067 - قنواء بنت رشيد أو زبيد " ق " في التالية أيضا.(@)(@@)(@@)(@@) $$ 3068 - كلثوم، روت عن الرضا عليه السلام كتابا، عنها محمد بن إسماعيل بن بزيع " جش ". PageV01P391(@)(@@)(@@)(@@) || الطبقة السادسة والعشرون(@)(@@)(@@)(@@) $ 3069 - آدم أبو الحسين النخاس الكوفي، وفي " جش " و " صه " ابن الحسين، وفي " ست " ابن المتوكل كما يأتي. والظاهر أنه النخاس الآتي الثقة، والله أعلم.(@)(@@)(@@)(@@) $ 3070 - آدم بياع اللؤلؤ الكوفي " ق " وفي " ست " ما يأتي في ابن المتوكل، ويحتمل الاتحاد.(@)(@@)(@@)(@@) $ 3071 - آدم بن الحسين النخاس، كوفي ثقة " جش " " صه " " د " له أصل، عنه إسماعيل بن مهران " جش " والنجاشي في أكثر 
ms286	 " صه " وفي بعض " جش " سهو.(@)(@@) وفي " ق " أبو الحسين النخاس، كما تقدم، ذكره الميرزا واستظهره.(@)(@@)(@@)(@@) $ 3072 - آدم بن صبيح الكوفي " ق " هكذا في التلخيص، لم أقف له على مدح فيترك ما تفرد به.(@)(@@)(@@)(@@) $ 3073 - آدم بن عبد الله القمي " ق " ابن عبد الله بن سعد الأشعري القمي " قي " هو والد إسحاق الذي يروي عن الرضا عليه السلام، ويمكن استفادة الوثاقة من كونه قميا، فتأمل.(@)(@@)(@@)(@@) $ 3074 - آدم بن عيينة بن أبي عمران الهلالي الكوفي " ق " لم يوجد له ما يوجب قبول حديثه.(@)(@@)(@@)(@@) $ 3075 - آدم بن المتوكل أبو الحسين بياع اللؤلؤ، كوفي ثقة، له أصل رواه جماعة، منهم عبيس، وفي " د " " ق " " جش " مهمل، وليس في " صه " وهو يؤيد الاهمال كما قيل.(@)(@@) وفيه نظر، والظاهر اتحاد الأربعة، يروي عن الصادق عليه السلام.(@)(@@)(@@)(@@) $ 3076 - أبان بن أبي عمران الفزاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3077 - أبان بن أرقم الأسدي " ق " ليس في " صه " ولا غيره، وكأنه مهمل. PageV01P392(@)(@@)(@@)(@@) $ 3078 - أبان بن أرقم السنبسي الطائي الكوفي أبو الأرقم " ق " الظاهر أنه مهمل.(@)(@@)(@@)(@@) $ 3079 - أبان بن أرقم العنزي القيسي الكوفي، أسند عنه " ق " وفيه مدح كما مر في المقدمات.(@)(@@)(@@)(@@) $ 3080 - أبان بن تغلب بن رباح أبو بكر سعيد البكري الجريري مولى بني جرير " ست " " جش " " د " وابن سعيد سهو على الظاهر، وهو ثقة جليل عظيم المنزلة في الأصحاب، لقى " ين " " قر " " ق " عليهم السلام، وفيه روايات على جلالته.(@)(@@)(@@)(@@) $ 3081 - أبان بن راشد الليثي " ق " الظاهر أنه مهمل.(@)(@@)(@@)(@@) $ 3082 - أبان بن صدقة الكوفي " ق " وهو كنظائره غير مطبوع الحديث ولا مقبول القول لا أتكل على ما تفرد به.(@)(@@)(@@)(@@) $ 3083 - أبان بن عبد الرحمن أبو عبد الله البصري، أسند عنه " ق " وفيه مدح ولا يدل على التوثيق.(@)(@@)(@@)(@@) $ 3084 - أبان بن عبد الملك الثقفي، شيخ من أصحابنا، روى عن أبي عبد الله كتاب الحج " جش " أقول: لم يصرح فيه بالتوثيق، الله م الا أن يقال: إن هذا التعظيم أعلى منه.(@)(@@)(@@)(@@) $ 3085 - أبان بن عبد الملك الخثعمي الكوفي، أسند عنه " ق " ويحتمل اتحاده 
ms287	 مع الثقفي المتقدم، وإن كان ظاهر الشيخ التغاير، ولا يسمن الاتحاد والتغاير مع عدم وجود ما يوجب القبول فيهما.(@)(@@)(@@)(@@) $ 3086 - أبان بن عبد ة الصيرفي الكوفي " ق " وهو كأضرابه غير معلوم الحال لا يعتد به.(@)(@@)(@@)(@@) $ 3087 - أبان بن عثمان الأحمر البجلي، روى عن " ق " و " ظم " عليهما PageV01P393(@)(@@) السلام " ست " " جش " عنه جماعة منهم أحمد البزنطي " ست " وفي " صه " " كش " عن معد قال: إنه من الناووسية، وأجمعت العصابة على تصحيح ما يصح عنه، وقبول قوله قوي.(@)(@@)(@@)(@@) $ 3088 - أبان بن عمرو بن أبي عبد الله الجذلي الكوفي " ق " أقول: الجذلي بالذال المهملة والمعجمة. وفي القاموس يأتي ان الجذل الطعان بالكسر لقب علقمة من مشاهير العرب.(@)(@@)(@@)(@@) $ 3089 - أبان بن عمر الأسدي، ختن آل ميثم بن يحيى التمار، شيخ من أصحابنا ثقة " صه " " جش " " د " ثم فيهما لم يرو عنه الاعبيس بن هشام وعباس بن هشام أظهر، كما تقدم في الطبقة السابقة.(@)(@@)(@@)(@@) $ 3090 - أبان بن مصعب الواسطي " ق " غير معلوم الحال، فلا اعتداد بحديثه، والله أعلم.(@)(@@)(@@)(@@) $ 3091 - إبراهيم أبو إسحاق البصري، كما في " ق ".(@)(@@)(@@)(@@) $ 3092 - إبراهيم يلقب أبو السفاتج ويكنى أبا إسحاق، وقيل: يكنى أبا يعقوب ومن قال هذا اسمه إسحاق بن عبد العزيز، ويأتي في إسحاق أنه يروي عن الصادق عليه السلام.(@)(@@)(@@)(@@) $ 3093 - إبراهيم بن أبي البلاد، يحيى بن سليم، ثقة روى عن " ق " و " ظم " " ضا " عليهم السلام وعمر دهرا، وكان للرضا عليه السلام إليه رسالة وأثنى عليه، عنه محمد بن سهل بن اليسع.(@)(@@)(@@)(@@) $ 3094 - إبراهيم بن أبي زياد الكرخي، يروي عن " ق " و " ظم " عليهما السلام يروي عنه ابن محبوب وابن أبي عمير وصفوان، وفي " تعق " كل ذلك يشعر بوثاقته، ونقل عن خاله الحكم بحسنه، واحتمل البعض بأنه ابن عثمان الملقب بأبي أيوب الثقة الآتي، ولعله ناش من الاشتراك في الراوي.(@)(@@)(@@)(@@) $ 3095 - إبراهيم بن أبي سمال واقفي " صه " " جش " " ظم " ثقة وربما يشك في وقفه، وفي " ست " له كتاب، عنه الحسن بن علي بن فضال. PageV01P394(@)(@@)(@@)(@@) $ 3096 - إبراهيم بن أبي فاطمة " ق 
ms288	 ".(@)(@@)(@@)(@@) $ 3097 - إبراهيم بن أبي المثنى عبد الاعلى كوفي " ق " (@)(@@)(@@)(@@) $ 3098 - إبراهيم الأحمري " ق " " قي " الكوفي " ق " ولعله مع ابن عبد الله الآتي متحدان، وقد احتمله الميرزا.(@)(@@)(@@)(@@) $ 3099 - إبراهيم بن الأزرق الكوفي بياع الطعام، روى عنه وعن " ق " عليه السلام " قر " كذا في تلخيص الأقوال.(@)(@@)(@@)(@@) $ 3100 - إبراهيم بن إسحاق الحارثي " ق " وفي " قي " لقبه بما فيه وزاد التكنية بأبي إسحاق، والرجل غير معلوم الوصف، فلا أرى العمل بحديثه.(@)(@@)(@@)(@@) $ 3101 - إبراهيم بن أحمد، غير مذكور في كتب الرجال، الا أنه موجود في طريق بعض روايات شيخنا الصدوق، يروي عن داود بن عمرو، ويروي عنه أحمد بن الحسين غزوان.(@)(@@)(@@)(@@) $ 3102 - إبراهيم بن إسحاق بن أزور، شيخ لا بأس به " صه " عن " قي " الظاهر أنه في هذه الطبقة، والله أعلم.(@)(@@)(@@)(@@) $ 3103 - إبراهيم بن إسماعيل بن إبراهيم بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام " ق " قال في التلخيص: وليس في بعض النسخ.(@)(@@)(@@)(@@) $ 3104 - إبراهيم بن بشر، له مسائل إلى الرضا عليه السلام، عنه محمد بن عبد الحميد " جش " وفيه دلالة أو اشعار على كونه اماميا.(@)(@@)(@@)(@@) $ 3105 - إبراهيم الجرزي " ق " الظاهر أنه من أصحابه عليه السلام لم أظفر على ما يوجب قبول حديثه.(@)(@@)(@@)(@@) $ 3106 - إبراهيم بن جعفر بن محمود الأنصاري المدني " ق " من أصحابه عليه السلام على الظاهر.(@)(@@)(@@)(@@) $ 3107 - إبراهيم بن جميل أخو طربال الكوفي " ق " روى عنه علي بن شجرة، وإبراهيم بن إسحاق " قر " وكلهم في هذه الطبقة كما دريت وتدري في محله.(@)(@@)(@@)(@@) $ 3108 - إبراهيم بن حبيب القرشي " ق ". PageV01P395(@)(@@)(@@)(@@) $ 3109 - إبراهيم بن الحسن بن علي بن الحسين أبو علي، مدني نزل الكوفة " ق ".(@)(@@)(@@)(@@) $ 3110 - إبراهيم بن حيان الأسدي الكوفي، نزل واسط " قر ".(@)(@@)(@@)(@@) $ 3111 - إبراهيم بن حيان الواسطي " ق " والظاهر اتحاده مع الأول، الا أنه قد قيل إن في بعض النسخ الأول بالنون والثاني بالياء (@)(@@)(@@)(@@) $ 3112 - إبراهيم بن خالد العطار، له كتاب، عنه ابن نهيك العبدي، يعرف بابن ملبقة، روى عن " ق " عليه السلام وعن " ضح " يعرف بابن أبي مليكة بالميم المضمومة 
ms289	 واللام المفتوحة والياء المثناة.(@)(@@)(@@)(@@) $ 3113 - إبراهيم بن خربوذ المكي " ق ".(@)(@@)(@@)(@@) $ 3114 - إبراهيم بن زياد أبو أيوب الخزاز الكوفي " ق " اسمه قيل: إبراهيم بن عثمان، وقيل: ابن عيسى وسيأتي.(@)(@@)(@@)(@@) $ 3115 - إبراهيم بن زياد الخارفي الكوفي " ق " والخارف اسم محلة أو بطن من همدان أو حافظ النخل، وبلا لام لقب مالك بن عبده أبو قبيلة من همدان، والكل محتمل.(@)(@@)(@@)(@@) $ 3116 - إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف الزهري المدني " ق " وجده الاعلى على الظاهر من أصحاب " ل " صلى الله عليه وآله الا أن حاله غير معلوم.(@)(@@)(@@)(@@) $ 3117 - إبراهيم بن سعيد المدني، أسند عنه " ق " وفيه مدح غير واف للقبول.(@)(@@)(@@)(@@) $ 3118 - إبراهيم بن سلمة الكناني " ق " لم أجده في غيره، وهو كأشباهه مجهول الحال، فلا يقبل حديثه.(@)(@@)(@@)(@@) $ 3119 - إبراهيم بن سليمان بن أبي داحة " صه " " جش " ابن داحة " ست " " د " عن الجاحظ " جش " المزني و " جش " المدني " صه " وكان وجه أصحابنا بالبصرة فقها وكلاما وأدبا وشعرا، يحكى عنه الجاحظ كثيرا، يروي عن " ق ". PageV01P396(@)(@@)(@@)(@@) $ 3120 - إبراهيم بن سماعة الكوفي " ق " وهو كأضرابه مطعون فقاهة.(@)(@@)(@@)(@@) $ 3121 - إبراهيم بن سنان، من رجال " ق " عليه السلام " قي ".(@)(@@)(@@)(@@) $ 3122 - إبراهيم بن السندي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3123 - إبراهيم بن شعيب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3124 - إبراهيم بن شعيب المزني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3125 - إبراهيم بن شعيب بن ميثم الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3126 - إبراهيم الشعيري، يروي عنه ابن أبي عمير، وفيه اشعار بوثاقته، ولا يبعد كونه أخا إسماعيل بن أبي زياد السكوني الشعيري، الا في بعض الروايات عن ابن أبي عمير عن صاحب الشعير " تعق " أقول: لم أقف على ما يدل على اخوته الا الاتحاد في الوصف، وما استدركه أخيرا غير مناف لما ذكره أولا، كما لا يخفى.(@)(@@)(@@)(@@) $ 3127 - إبراهيم بن صباح الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3128 - إبراهيم الصيقل " ق ".(@)(@@)(@@)(@@) $ 3129 - إبراهيم بن غمرة الغفاري مدني، وهو ابن أبي عمرو مولاهم " ق ".(@)(@@)(@@)(@@) $ 3130 - إبراهيم بن عاصم، ذكره " كش " في أصحابنا الذين روى عنهم ابن إسماعيل بن بزيغ، فالظاهر أنه من أصحابنا المعروفين 
ms290	 من المشايخ، والله أعلم، هكذا ذكره الميرزا " ره " وليس بمتجه، كما لا يخفى.(@)(@@)(@@)(@@) $ 3131 - إبراهيم بن عبد الحميد، ثقة، له أصل، عنه ابن أبي عمير وصفوان، من أصحاب أبي عبد الله عليه السلام وأدرك " ضا " وأخوه الصباح قيل: وهو أخو محمد بن عبد الله بن زرارة لامه، وكونه واقفا منوط بكلام هنا.(@)(@@)(@@)(@@) $ 3132 - إبراهيم بن عباد البرجمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3133 - إبراهيم بن عبادة الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3134 - إبراهيم بن عبد الرحمن بن أمية بن محمد بن عبد الله بن ربيعة الخزاعي أبو محمد المدني، أسند عنه " ق " وفيه مدح لا يخفى.(@)(@@)(@@)(@@) $ 3135 - إبراهيم بن عبد الله الأحمري " قر " " ق " كوفي " ق " روى عنه وعن PageV01P397(@)(@@) أبي عبد الله عليه السلام، روى عنه سيف بن عميرة " قر ".(@)(@@)(@@)(@@) $ 3136 - إبراهيم بن عبد الله بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام الهاشمي المدني، قتل سنة خمس وأربعين ومائة لخمس بقين من ذي القعدة " ق ".(@)(@@)(@@)(@@) $ 3137 - إبراهيم بن عبيد أبو غرة الأنصاري " قر " " ق ".(@)(@@)(@@)(@@) $ 3138 - إبراهيم بن عثمان، وقيل: ابن عيسى أبو أيوب الخزاز، ثقة كبير المنزلة يروي عن " ق " و " ظم " عليهما السلام وقد مر بعنوان زياد، فتأمل.(@)(@@)(@@)(@@) $ 3139 - إبراهيم بن عربي الأسدي مولاهم، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3140 - إبراهيم بن عطية الواسطي " ق ".(@)(@@)(@@)(@@) $ 3141 - إبراهيم بن علي بن الحسن بن علي بن أبي رافع المدني " ق ".(@)(@@)(@@)(@@) $ 3142 - إبراهيم بن عمر اليماني الصنعاني، شيخ من أصحابنا، ثقة، روى عن أبي جعفر " قر " عليهما السلام ذكر ذلك أبو العباس. وقال " غض ": ضعيف جدا، و " جش " توثيقه أرجح من تضعيف " غض " عنه حماد.(@)(@@)(@@)(@@) $ 3143 - إبراهيم بن غريب كوفي " ق ".(@)(@@)(@@)(@@) $ 3144 - إبراهيم الغفاري " ق ".(@)(@@)(@@)(@@) $ 3145 - إبراهيم بن الفضل المدني أبو إسحاق " ق ".(@)(@@)(@@)(@@) $ 3146 - إبراهيم بن الفضل الهاشمي المدني، أسند عنه " ق " ولا يبعد كونه المتقدم، فتأمل.(@)(@@)(@@)(@@) $ 3147 - إبراهيم الكرخي بغدادي " ق " " قي " من أبناء العجم فيه وفي " يب " ابن أبي زياد الكرخي عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3148 - إبراهيم بن المتكلم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3149 - إبراهيم 
ms291	 بن المثنى " ق " ثم قال الميرزا بعده: مرتين.(@)(@@)(@@)(@@) $ 3150 - إبراهيم بن محرز الجعفي " ق ".(@)(@@)(@@)(@@) $ 3151 - إبراهيم بن محمد بن أبي يحيى أبو إسحاق، مولى أسلم، مدني، روى PageV01P398(@)(@@) عن " قر " و " ق " عليهما السلام وكان خاصيا بحديثنا والعامة تضعفه، وفيه امارة على قبول حديثه، بل له تأييدات أخر.(@)(@@)(@@)(@@) $ 3152 - إبراهيم بن عبد الله الجعفري، أسند عنه " ق " وفيه مدح الا أنه كما قيل: يحتمل كونه إبراهيم بن أبي الكرام، فحينئذ يدخل في السابقة.(@)(@@)(@@)(@@) $ 3153 - إبراهيم بن محمد بن علي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3154 - إبراهيم بن محمد بن يحيى المدني، أسند عنه " ق " وفي بعض ابن أبي يحيى، وهو الصحيح وقد تقدم في ترجمته.(@)(@@)(@@)(@@) $ 3155 - إبراهيم المخارقي، روى " كش " أنه وصف عقيدته لأبي عبد الله عليه السلام فقال: رحمك الله وأوصاه بالورع، وعن بعض النسخ الخارفي فهو ابن الزياد المتقدم.(@)(@@)(@@)(@@) $ 3156 - إبراهيم بن مرثد الأزدي " قر " " ق " الكندي أبو سفيان أخو أبي صادق الكوفي " ق ".(@)(@@)(@@)(@@) $ 3157 - إبراهيم بن معاد، روى عنه في قوله تعالي " أن الذين ارتدوا على أدبارهم " حديث التعاقد بين القوم " قر ".(@)(@@)(@@)(@@) $ 3158 - إبراهيم بن معرض الكوفي " ق " " قر " روى عنه وعن " ق " عليهما السلام روى عنه منصور بن حازم، وحصين بن مخارق " قر ".(@)(@@)(@@)(@@) $ 3159 - إبراهيم بن معقل بن قيس أخو إسحاق " ق ".(@)(@@)(@@)(@@) $ 3160 - إبراهيم بن منير الكوفي " ق ".(@)(@@)(@@)(@@) $ 3161 - إبراهيم بن المفضل بن قيس بن رمانة الأشعري مولاهم، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3162 - إبراهيم بن مهاجر " ق ".(@)(@@)(@@)(@@) $ 3163 - إبراهيم بن مهاجر الأزدي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3164 - إبراهيم بن مهزم الأسدي يعرف بابن أبي بردة، ثقة ثقة، روى عن " ق " و " ظم " عليهما السلام وعمر عمرا طويلا " صه " " جخ ". PageV01P399(@)(@@)(@@)(@@) $ 3165 - إبراهيم بن ميمون بياع الهروي " ق ".(@)(@@)(@@)(@@) $ 3166 - إبراهيم بن نصر بن القعقاع الجعفي، كوفي روى عن أبي عبد الله وأبي الحسن عليهما السلام، ثقة صحيح الحديث " صه " " جش " أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3167 - إبراهيم بن ميمون الكوفي " ق " وقد مر مرارا أن مثله مجهول الحال، فلا يقبل حديثه.(@)(@@)(@@)(@@) $ 3168 - إبراهيم 
ms292	 بن نعيم الصحاف الكوفي " ق ".(@)(@@)(@@)(@@) $ 3169 - إبراهيم بن نعيم بضم الميم وفتح العين أبو الصباح بفتح الأول وتشديد الباء الكناني، قال له الصادق عليه السلام: أنت ميزان لا عين فيه، رأى أبا جعفر عليه السلام روى عن " ظم " عليه السلام قال أبو العباس: يسميه الصادق عليه السلام بالميزان الثقة.(@)(@@)(@@)(@@) $ 3170 - إبراهيم بن هارون الخارفي " ق ".(@)(@@)(@@)(@@) $ 3171 - إبراهيم بن هلال بن جابان الكوفي " ق " غير موصوف بوصف من المدح والذم، فلا يقبل حديثه فقاهة.(@)(@@)(@@)(@@) $ 3172 - إبراهيم بن يحيى ثقة، وهو ابن أبي البلاد، وقد تقدم.(@)(@@)(@@)(@@) $ 3173 - أجلح - بالجيم - بن عبد الله أبو حجية الكندي، وثقه ابن معين وغيره، وضعفه النسائي، وهو صدوق شيعي، مات سنة خمس وأربعين ومائة، وهو المنقول عن الذهبي.(@)(@@)(@@)(@@) $ 3174 - أحمد بن أبي الأكراد، روى عن أحمد بن الحارث " ق " وكذا يروي عنه المفضل بن عمر كما يأتي، لم أجد له مدحا في كتب الرجال.(@)(@@)(@@)(@@) $ 3175 - أحمد بن بشر بن عمار الصيرفي " ق " مجهول الحال غير مطبوع المقال فقاهة، والله أعلم.(@)(@@)(@@)(@@) $ 3176 - أحمد بن بشير أبو بكر العمري الكوفي " ق " وهو كسابقه مجهول الوصف.(@)(@@)(@@)(@@) $ 3177 - أحمد بن ثابت الحنفي الكوفي، ويقال: الهمداني " ق ". PageV01P400(@)(@@)(@@)(@@) $ 3178 - أحمد بن جابر الكوفي، أخو زيد الفتات " ق " " قي ".(@)(@@)(@@)(@@) $ 3179 - أحمد بن الحارث، روى عنه المفضل بن عمر " ق " " قي " وأحمد بن أبي الأكراد " ق " وقد مر في عنوانه.(@)(@@)(@@)(@@) $ 3180 - أحمد بن سليم القبي بالباء الموحدة أو القتي بالتاء المثناة من فوق الكوفي.(@)(@@)(@@)(@@) $ 3181 - أحمد بن عاند بن حبيب " جش " " د " " ق " العبسي الكوفي أبو علي، أسند عنه " ق " قال علي بن فضال حين سأله معد عن حاله: صالح كان يسكن بغداد، قال: لم ألقه كان صحب أبا خديجة وأخذ عنه، وهو في السابقة أيضا.(@)(@@)(@@)(@@) $ 3182 - أحمد بن عبد العزيز الجوهري، له كتاب السقيفة " ست " الكوفي أبو شبل " ق ".(@)(@@)(@@)(@@) $ 3183 - أحمد بن عبيد الأزدي الكوفي مولى " ق ".(@)(@@)(@@)(@@) $ 3184 - أحمد بن عمران الحلبي " قر " أقول: ذكره في رجاله عليه السلام يحتمل أن يكون ناشيا من 
ms293	 الكنية بأبي جعفر، فالظاهر أن هذا من أصحاب " ج " بناءا على كون أبيه من أصحاب " ق " أو " ضا " عليهما السلام، فهو في السابقة.(@)(@@)(@@)(@@) $ 3185 - أحمد بن عمرو بن سعيد، يروي عنه عبد الله بن المغيرة، وفيها اشعار بالاعتماد عليه " تعق ".(@)(@@)(@@)(@@) $ 3186 - أحمد بن غزال المزني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3187 - أحمد بن مبشر الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3188 - أحمد بن مزيد بن باكر الأسدي الكاهلي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3189 - أحمد بن معاذ الجعفي الكوفي " ق " وفي " د " عنه الميرزا ذكره في رجال " ج " الظاهر أنه من رجال " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3190 - إدريس لم ينسب " ق " كذا ذكره في تلخيص الأقوال.(@)(@@)(@@)(@@) $ 3191 - إدريس بن عبد الله الأزدي الكوفي " ق " " جخ ".(@)(@@)(@@)(@@) $ 3192 - إدريس بن عبد الله الأصبهاني " ق " " جخ ". PageV01P401(@)(@@)(@@)(@@) $ 3193 - إدريس بن عبد الله البكري " ق ".(@)(@@)(@@)(@@) $ 3194 - إدريس بن عبد الله بن الحسن بن علي بن أبي طالب عليهما السلام الهاشمي المدني " ق ".(@)(@@)(@@)(@@) $ 3195 - إدريس بن عبد الله القمي " ق " يجئ أخوه عبد الملك بن عبد الله القمي.(@)(@@)(@@)(@@) $ 3196 - إدريس بن عبد الله الهمداني المرهبي " ق " " جخ ".(@)(@@)(@@)(@@) $ 3197 - إدريس بن هلال، روى عنه محمد بن سنان على ما في " يه " لكنه غير مذكور في كتب الرجال، والله أعلم بالحال.(@)(@@)(@@)(@@) $ 3198 - إدريس بن يزيد بن عبد الرحمن، أبو عبد الله الأزدي الكوفي " ق " " جخ ".(@)(@@)(@@)(@@) $ 3199 - أديم بن الحر الجعفي، مولاهم الحذاء، كوفي ثقة، له أصل " صه " " جش " صاحب " ق " عليه السلام يروي عنه نيفا وأربعين حديثا " صه ".(@)(@@)(@@)(@@) $ 3200 - أرطارة بن الأشعث البصري " ق ".(@)(@@)(@@)(@@) $ 3201 - أرطاة بن حبيب الأسدي، كوفي ثقة، روى عن " ق " عليه السلام " جش " " صه " وزاد الأول له كتاب عنه محمد بن الحسين بن أبي الخطاب، قد وصفه في " مشكا " بالثقة.(@)(@@)(@@)(@@) $ 3202 - أسباط بن سالم بياع الزطي " ق " " ست " " جش " الكوفي " ق " أبو علي مولى بني عدي من كندة روى عن " ق " و " ظم " عليهما السلام ذكره أبو العباس وغيره في الرجال " جش ".(@)(@@)(@@)(@@) $ 3203 - أسباط بن عروة البصري " ق ".(@)(@@)(@@)(@@) $ 3204 - أسباط بن محمد بن 
ms294	 عمرو القرشي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3205 - إسحاق بن أبان، هو ابن محمد بن أحمد " تعق " أقول: وقد نسب إلى الجد الاعلى، كما سيجئ.(@)(@@)(@@)(@@) $ 3206 - إسحاق بن إبراهيم الأزدي، أبو إبراهيم الكوفي " ق ". PageV01P402(@)(@@)(@@)(@@) $ 3207 - إسحاق بن إبراهيم الأزدي الكوفي العطار " ق " ثم كرر مزيدا أبو يعقوب، أسند عنه.(@)(@@)(@@)(@@) $ 3208 - إسحاق بن إبراهيم الجعفي " ق ".(@)(@@)(@@)(@@) $ 3209 - إسحاق أبو هارون الجرجاني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3210 - إسحاق بن أبي جعفر الفراء الكوفي " ق ".(@)(@@)(@@)(@@) $ 3211 - إسحاق بن بريد أبو يعقوب الطائي الكوفي " ق " مولى كوفي ثقة، روى عن " ق " عليه السلام، وأبوه عن " قر " عليه السلام ومن الأصحاب من صحف أبوه، فقال: يزيد بالمثناة من تحت والزاي.(@)(@@)(@@)(@@) $ 3212 - إسحاق بن بشر أبو حذيفة الكاهلي الخراساني، ثقة من العامة، ذكروه في رجال " ق " عليه السلام " صه " " جش " وفي " ق " ابن بشر أبو حذيفة الخراساني، أسند عنه.(@)(@@)(@@)(@@) $ 3213 - إسحاق بياع اللؤلؤ الكوفي " ق " وفي " تعق " في الصحيح عن صفوان عن ابن مسكان عنه، وفيه اشعار بالاعتماد بل الوثاقة، ويظهر من روايته كونه شيعيا انتهى.(@)(@@)(@@)(@@) $ 3214 - إسحاق بن جرير واقفي " ظم " البجلي الكوفي " ق " أبو يعقوب، روى عن " ق " عليه السلام، ثقة فحديثه مقبول ان قلنا باعتبار الموثق.(@)(@@)(@@)(@@) $ 3215 - إسحاق بن جندب، أبو إسماعيل الفرايفي، ثقة روى عن " ق " عليه السلام، له كتاب رواه عبيس " جش ".(@)(@@)(@@)(@@) $ 3216 - إسحاق بن خليد البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3217 - إسحاق بن شعيب بن ميثم الأسدي، مولاهم كوفي التمار، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3218 - إسحاق بن عبد العزيز الكوفي، روى عن " ق " عليه السلام " جخ " " صه " البزاز الملقب بأبي يعقوب، ويلقب أبا السفاتج و " غض " ضعفه، وقد تقدم أنه ابن إبراهيم. PageV01P403(@)(@@)(@@)(@@) $ 3219 - إسحاق بن عبد الله أبو السفاتج الكوفي " ق ".(@)(@@)(@@)(@@) $ 3220 - إسحاق بن عبد الله بن سعد بن مالك الأشعري، قمي ثقة، روى عن " ق " و " ظم " عليهما السلام وابنه أحمد مشهور " صه " " جش ".(@)(@@)(@@)(@@) $ 3221 - إسحاق العطار الطويل الكوفي " ق ".(@)(@@)(@@)(@@) $ 3222 - إسحاق العقرقوفي " ق ".(@)(@@)(@@)(@@) $ 3223 - إسحاق بن عمار الكوفي الصيرفي أبو يعقوب، كان شيخنا من 
ms295	 أصحابنا روى عن " ق " و " ظم " ثقة امامي، عنه ابن أبي عمير وصفوان، وهذا غير ابن عمار الساباطي، بل هو ابن عمار بن حيان مولى بني تغلب، واخوته يونس وقيس وإسماعيل وابنا أخيه الآخر علي وبشر كانا من وجوه من روى الحديث.(@)(@@)(@@)(@@) $ 3224 - إسحاق بن عمار الساباطي، له أصل وكان فطحيا إلا أنه ثقة، وأصله معتمد عليه " ست " وتوهم في " صه " اتحاده مع السابق وكونه فطحيا ثقة، وتوقف فيما ينفرد به. والصواب كما ذهب إليه غير واحد التغاير، وهو من الفطحية والسابق من الامامية، وحديثه موثق والسابق صحيح، وطائفته ساباطية منسوبة إلى التغلبية والكوفية.(@)(@@)(@@)(@@) $ 3225 - إسحاق بن غالب الأسدي والبتي، عربي أصيل، ثقة وأخوه عبد الله كذلك، وكانا شاعرين رويا عن " ق " عليه السلام، له كتاب عنه صفوان " جش ".(@)(@@)(@@)(@@) $ 3226 - إسحاق بن فروخ مولى آل طلحة " ق ".(@)(@@)(@@)(@@) $ 3227 - إسحاق بن الفضل بن عبد الرحمن الهاشمي المدني " ق ".(@)(@@)(@@)(@@) $ 3228 - إسحاق بن محمد بن أحمد بن أبان بن مراد بن عبد الله بن عقبة بن الحارث النخعي أخو الأشتر، وهو معدن التخليط، له كتب في التخليط، عنه الجرمي " جش " " صه " وفي " غض " انه كان فاسد المذهب، كذابا في الرواية، وضاعا في الحديث الخ. والإسحاقية تنسب إليه، والجرمي هو علي الطاطري.(@)(@@)(@@)(@@) $ 3229 - إسحاق المدائني، هو ابن عمار الساباطي، لان ساباط من قرى المدائن " تعق " أقول: مجرد ذلك لا يصلح لكونه قرينة على الاتحاد، الا أن ينضم إليه PageV01P404(@)(@@) امارات أخر، فيعمل على ظاهر العنوان وهو التعدد، فلا يعمل بقوله للجهالة.(@)(@@)(@@)(@@) $ 3230 - إسحاق بن المرادي الكوفي " ق " ثم فيهم أي في رجال " ق " إسحاق المرادي، عنه ابن مسكان، كرره لذكر من يروي عنه أو ذكره سهوا، والله أعلم.(@)(@@)(@@)(@@) $ 3231 - إسحاق بن منصور العرزمي " ق ".(@)(@@)(@@)(@@) $ 3232 - إسحاق بن هلال، عنه ابن أبي عمير كما قيل، ففيه اشعار بوثاقته " تعق ".(@)(@@)(@@)(@@) $ 3233 - إسحاق بن الهيثم كوفي " ق ".(@)(@@)(@@)(@@) $ 3234 - إسحاق بن يحيى الكاهلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3235 - إسحاق بن يزيد بن إسماعيل الطائي على ما في " صه " وقد تقدم في 
ms296	 ابن بريد بالموحدة وفي " تعق " حكم خالي بحسنه، والظاهر أن للصدوق طريقا إليه، ثم نفى البعد عن كونه إسحاق بن جرير بن يزيد وهو بعيد.(@)(@@)(@@)(@@) $ 3236 - أسد بن إسماعيل " ق " ولم أظفر له على مدح ولا ذم، فهو كنظائره مجهول الحال غير مقبول المقال فقاهة.(@)(@@)(@@)(@@) $ 3237 - أسد بن سعيد الخثعمي الكوفي.(@)(@@)(@@)(@@) $ 3238 - أسد بن عامر القيسي " ق " وعن نسخة ابن عمار.(@)(@@)(@@)(@@) $ 3239 - أسد بن عطاء الكوفي " ق ".(@)(@@)(@@)(@@) $ 3240 - أسد بن معلى بن أسد القمي البصري، رجل من أصحابنا، أخباري بصري، له كتاب أخبار صاحب الزنج " جش " وفي رجال الميرزا بدله " لم " وفي نسخة صحيحة من " جش " كما في المنتهى جل اي جليل والراء سهو من الناسخ لجهالته بالمعنى، ولعله في السابقة أيضا.(@)(@@)(@@)(@@) $ 3241 - أسد بن يحيى البصري " ق ".(@)(@@)(@@)(@@) $ 3242 - إسرائيل بن أسامة بياع الزطي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3243 - إسرائيل بن عائذ المدني المخزومي " ق ".(@)(@@)(@@)(@@) $ 3244 - إسرائيل بن يونس بن أبي إسحاق الكوفي " ق ". PageV01P405(@)(@@)(@@)(@@) $ 3245 - أسعد بن سعيد النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3246 - أسعد بن عمرو الأسلمي " ق ".(@)(@@)(@@)(@@) $ 3247 - الأسقع الكندي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3248 - أسلم أبو تراب مولى، يروي عنه معاوية بن وهب " ق ".(@)(@@)(@@)(@@) $ 3249 - أسلم بن عائذ المدني " ق ".(@)(@@)(@@)(@@) $ 3250 - إسماعيل بن إبراهيم بن بزة القصير، كوفي " ق " ثقة " صه " " جش " عنه محمد بن زياد " ست " علي بن الحسين " جش ".(@)(@@)(@@)(@@) $ 3251 - إسماعيل أبو أحمد الكاتب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3252 - إسماعيل بن أبي خالد، روى أبوه عن " قر " عليه السلام وهو عن " ق " وكلاهما ثقتان من أهل الكوفة من أصحابنا الإمامية.(@)(@@)(@@)(@@) $ 3253 - إسماعيل بن أبي زياد المدعو بالسكوني الشعيري في " ست " ابن أبي زياد، له كتاب وله كتاب النوادر، وقد اختلفوا فيه اختلافا عظيما واشتهر عاميته، واحتمال التشيع غير بعيد، ومع عدمه قبول روايته قوي، كيف ويظهر من الأساطين كونه اماميا، والله أعلم.(@)(@@)(@@)(@@) $ 3254 - إسماعيل بن أبي زياد السلمي، كوفي ثقة، روى عن " ق " عليه السلام وفي " ق " ابن زياد كما يأتي، وفي " مشكا " ابن أبي زياد السلمي، لم نظفر له بأصل ولا كتاب. 
ms297	(@)(@@)(@@)(@@) $ 3255 - إسماعيل بن أبي سارة في الكافي في الصحيح عن ابن أبي عمير عنه، ويحتمل أن يكون أخا الحسن بن أبي سارة، فيشير إلى نباهته أيضا " تعق " أقول: إن أيضا إشارة إلى أن اخوته له فيها اشعار بالنباهة كرواية ابن أبي عمير، فتأمل.(@)(@@)(@@)(@@) $ 3256 - إسماعيل بن أبي سمال باللام، وقيل: بالكاف. وهو أخو إبراهيم كان واقفيا ثقة، وقد تقدم أخوه في عنوان إبراهيم أبي بكر، وهو أيضا مثله.(@)(@@)(@@)(@@) $ 3257 - إسماعيل بن أبي يحيى الهاشمي، مولاهم الكوفي الصيرفي " ق ".(@)(@@)(@@)(@@) $ 3258 - إسماعيل بن بشار البصري " ق " قال الميرزا: والذي رأيته بالمثناة PageV01P406(@)(@@) والمهملة كما يأتي، وهو الذي وجدته في النسخ المعتمدة من كتب الحديث أيضا.(@)(@@)(@@)(@@) $ 3259 - إسماعيل بن جابر، ثقة ممدوح له أصول، رواها عنه صفوان بن يحيى، روى عنهما عليهما السلام، وما ورد فيه من الذم منظور فيه.(@)(@@)(@@)(@@) $ 3260 - إسماعيل بن جعفر بن أبي كثير المدني " ق ".(@)(@@)(@@)(@@) $ 3261 - إسماعيل بن جعفر " ق " لم أجد له وصفا غير العنوان، فالأقرب عدم قبول حديثه.(@)(@@)(@@)(@@) $ 3262 - إسماعيل بن جعفر بن عثمان بن عيسى العامري " قي " " ق ".(@)(@@)(@@)(@@) $ 3263 - إسماعيل بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام الهاشمي المدني " قي " " ق ".(@)(@@)(@@)(@@) $ 3264 - إسماعيل بن جفينة، وهو ابن عبد الرحمن أو ابن عبد الله، كما يأتي في عنوانهما.(@)(@@)(@@)(@@) $ 3265 - إسماعيل بن حازم الجعفي الكوفي، مولى نهم " ق ".(@)(@@)(@@)(@@) $ 3266 - إسماعيل بن حازم السلمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3267 - إسماعيل بن حقيبة بالمهملة، هو ابن جفينة المتقدم، والآتي في عنوان ابن عبد الله وابن عبد الرحمن.(@)(@@)(@@)(@@) $ 3268 - إسماعيل بن الخطاب السلمي " ق " روى " كش " حديثا فيه لم يعلم صحته ولا فساده، فالأقوى التوقف في روايته واليه منه في " صه ".(@)(@@)(@@)(@@) $ 3269 - إسماعيل بن رباح الكوفي " ق " وفي " تعق " بالباء الموحدة وقد يوجد بالمثناة، عنه ابن أبي عمير في الصحيح، وفيه اشعار بوثاقته، وعمل بخبره الأصحاب في باب دخول الوقت في أثناء الصلاة.(@)(@@)(@@)(@@) $ 3270 - إسماعيل بن زياد السلمي الكوفي " ق " وقد سبق ابن أبي زياد.(@)(@@)(@@)(@@) $ 3271 
ms298	 - إسماعيل بن سالم، عنه ابن أبي عمير، ويحتمل كونه ابن سلام " تعق " أقول: وفيه دلالة على نباهته بل وثاقته.(@)(@@)(@@)(@@) $ 3272 - إسماعيل بن سلام، في ترجمة علي بن يقطين روى معجزة عن " ظم " PageV01P407(@)(@@) عليه السلام يظهر كونه من الشيعة ومأمونا على سرهم، ولعله ابن سلام السابق " تعق ".(@)(@@)(@@)(@@) $ 3273 - إسماعيل بن سيار " غين " ويأتي ابن يسار بتقديم الياء، كذا ذكره في المنتهى، ويظهر منه اتحاده مع ابن يسار الآتي ووقوع التصحيف، وهو غير معلوم، خال عن الامارة.(@)(@@)(@@)(@@) $ 3274 - إسماعيل بن شعيب السمان الأسدي الكوفي " ق " (@)(@@)(@@)(@@) $ 3275 - إسماعيل بن شعيب بن ميثم الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3276 - إسماعيل بن صدقة الكوفي القراطيسي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3277 - إسماعيل بن عامر، ابن أبي عمير عن حماد عنه، كما في ترجمة المفضل بن عمر، وفيه اشعار بوثاقته، ويظهر من تلك الرواية حسن عقيدته، وهو والد علي بن إسماعيل بن عامر الآتي عن " ظم " ويحتمل كونه عمار وقيل له عامر فتأمل " تعق " فعلى هذا يكون أخا إسحاق الثقة الجليل الآتي، فتأمل.(@)(@@)(@@)(@@) $ 3278 - إسماعيل بن عبد الحميد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3279 - إسماعيل بن عبد الخالق وعاش إلى أيام " ق " عليه السلام يروي عنه وعن " ظم " عليه السلام والظاهر كونه من الأخيار الفضلاء، عنه البرقي محمد بن خالد.(@)(@@)(@@)(@@) $ 3280 - إسماعيل بن عبد الرحمن الجرمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3281 - إسماعيل بن عبد الرحمن الجعفي الكوفي، تابعي سمع أبا الطفيل عامر بن واثلة " قر " " ق " " صه " مات في حياة " ق " عليه السلام وترحم عليه، وكان فقيها، ووثقه ابن نمير، فحديثه معتبر.(@)(@@)(@@)(@@) $ 3282 - إسماعيل بن عبد الرحمن حقينة الكوفي " ق " وقيل: جفينة وقد مر، وهو قليل الحديث، قال معد: سألت علي بن فضال عن إسماعيل جفينة قال: صالح، وفي " ق " ابن عبد الله حقيبة، كما يأتي.(@)(@@)(@@)(@@) $ 3283 - إسماعيل بن عبد الرحمن السدي أبو محمد القرشي المفسر الكوفي PageV01P408(@)(@@) " ق " الظاهر أنه عبد الرحمن بن أبي كريمة، والظاهر جلالته ببعض العنايات.(@)(@@)(@@)(@@) $ 3284 - إسماعيل بن عبد العزيز الأموي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3285 - إسماعيل بن عبد الله الأعمش الكوفي، روى 
ms299	 عنه ابن أبي عمير " ق " وفي " تعق " وهو يشعر بوثاقته، وربما يأتي في الروايات بدون ذكر الأب وهو هذا.(@)(@@)(@@)(@@) $ 3286 - إسماعيل بن عبد الله الحارثي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3287 - إسماعيل بن عبد الله حقيبة " ق " وقد تقدم ابن عبد الرحمن وإسماعيل جفينة.(@)(@@)(@@)(@@) $ 3288 - إسماعيل بن عبد الله الرماح الكوفي، روى عنه أبان " ق ".(@)(@@)(@@)(@@) $ 3289 - إسماعيل بن عبد الله بن محمد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام " ق ".(@)(@@)(@@)(@@) $ 3290 - إسماعيل بن علي المسلي أبو عبد الرحمن، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3291 - إسماعيل بن علي الهمداني " ق ".(@)(@@)(@@)(@@) $ 3292 - إسماعيل بن عمار الصيرفي الكوفي أخو إسحاق " كش " بسند ضعيف كان " ق " عليه السلام إذا رآهما وقد يجمعهما لأقوام يعني الدنيا والآخرة، وورد فيهما حديث صحيح.(@)(@@)(@@)(@@) $ 3293 - إسماعيل بن قدامة بن حمامة الضبي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3294 - إسماعيل القصير، له كتاب، عنه محمد بن زياد " ست " وهو ابن إبراهيم، وقد تقدم.(@)(@@)(@@)(@@) $ 3295 - إسماعيل بن كثير السلمي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3296 - إسماعيل بن كثير العجلي الكوفي أبو معمر " ق ".(@)(@@)(@@)(@@) $ 3297 - إسماعيل بن محمد بن إسماعيل بن هلال المخزومي أبو محمد، وجه أصحابنا المكيين، كان ثقة فيما يرويه، يروي عنه ابن أبي عمير، وفيها دلالة أخرى على وثاقته.(@)(@@)(@@)(@@) $ 3298 - إسماعيل بن محمد الحميري السيد الشاعر يكنى أبا عمر " ق " ثقة PageV01P409(@)(@@) جليل القدر عظيم الشأن والمنزلة رحمه الله " صه ".(@)(@@)(@@)(@@) $ 3299 - إسماعيل بن محمد المهري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3300 - إسماعيل بن مسلم المكي " ق ".(@)(@@)(@@)(@@) $ 3301 - إسماعيل بن يحيى بن عمارة البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3302 - إسماعيل بن يسار " ق " " قي " قال الميرزا: وكأنه أحد اللآتيين.(@)(@@)(@@)(@@) $ 3303 - إسماعيل بن يسار النصري " ق ".(@)(@@)(@@)(@@) $ 3304 - إسماعيل بن يسار الهاشمي، مولى إسماعيل بن علي بن عبد الله بن العباس، ذكره أصحابنا بالضعف " صه " " جش " عنه محمد بن الحسين بن أبي الخطاب.(@)(@@)(@@)(@@) $ 3305 - أسلم مولى علي بن يقطين، يأتي بلا ألف " تعق ".(@)(@@)(@@)(@@) $ 3306 - الأسود بن أبي الأسود الليثي، مولاهم الكوفي الحناط " ق ".(@)(@@)(@@)(@@) $ 3307 - الأسود بن رزين أبوع بد 
ms300	 الله المزني، روى عن " ق " عليه السلام ذكره أصحاب الرجال، له كتاب العتق " جش ".(@)(@@)(@@)(@@) $ 3308 - الأسود بن عاصم الهمداني، كوفي أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3309 - أسيد بن حبيب الجهني " ق ".(@)(@@)(@@)(@@) $ 3310 - أسيد بن عبد الرحمن أبو أحمد الكوفي الكلالي " ق ".(@)(@@)(@@)(@@) $ 3311 - أسيد بن عياض الكوفي " ق " " جخ ".(@)(@@)(@@)(@@) $ 3312 - الأشجع السلمي، من شعراء أهل البيت، دخل على " ق " عليه السلام " ب " وهو من الشعراء المتكلمين، وفي الوجيزة " ح " وقد تأمل فيه أبو علي، وهو في محله.(@)(@@)(@@)(@@) $ 3313 - أشعث البارقي الكوفي " ق ":(@)(@@)(@@)(@@) $ 3314 - أشعث بن سعيد أبو الربيع البصري السمان " ق " " جخ ".(@)(@@)(@@)(@@) $ 3315 - أشعث بن سويد النهدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3316 - أشعر بن الحسن الجعفي الكوفي " ق " " جخ ". PageV01P410(@)(@@)(@@)(@@) $ 3317 - أشيم بن عبد الله أبو صالح الخراساني " ق ".(@)(@@)(@@)(@@) $ 3318 - أصرم بن حوشب " ست " " جش " " صه " البجلي عامي ثقة، روى عن " ق " عليه السلام " صه " " جش " عنه البرقي أبو أحمد، وفي " ضح " ابن حوشب بالمهملة المفتوحة والواو الساكنة والمعجمة والموحدة.(@)(@@)(@@)(@@) $ 3319 - الياس بن عمرو البجلي، شيخ من أصحاب " ق " عليه السلام متحقق بهذا الامر، وهو جد الحسن بن علي ابن بنت الياس " صه " " جش " الصيرفي كما في ترجمة الحسن. قيل: والظاهر أن هذا والأول واحد، فتأمل (1).(@)(@@)(@@)(@@) $ 3320 - أنس بن أبي القاسم الحضرمي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3321 - أنس بن الأسود الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3322 - أيوب بن الحرق، ثقة مولى طريف روى عن " ق " عليه السلام يعرف بأخي أديم، له أصل " جش " عنه أحمد بن أبي عبد الله " ست " ولعله في السابقة، وطريقه عال.(@)(@@)(@@)(@@) $ 3323 - أيوب بن راشد البزاز " ق ".(@)(@@)(@@)(@@) $ 3324 - أيوب بن زياد النهدي، مولاهم كوفي أسند عنه " ق " وكثيرا ما يأتي أبو زياد النهدي ولعله هو، كما احتمله بعض الأفاخم.(@)(@@)(@@)(@@) $ 3325 - أيوب بن سعيد الخطابي " ق ".(@)(@@)(@@)(@@) $ 3326 - أيوب بن شعيب القزاز الكوفي " ق ".(@)(@@)(@@)(@@) $ 3327 - أيوب بن عثمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 3328 - أيوب بن عطية الأعرج " ق ".(@)(@@)(@@)(@@) $ 3329 - أيوب بن عطية أبو عبد الرحمن الحذاء، ثقة، روى عن " ق " عليه السلام له كتاب يرويه صفوان بن يحيى، 