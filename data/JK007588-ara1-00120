ms101	 كل طاري % % 3(@)(@@) % يا عليا عن كل ضد وند % وبريا من كل عيب وعار % 4(@)(@@) % أنت بدر العلى فكيف وقد ضم % ت إليه زهر النجوم الدراري % % 5(@)(@@) % قد أتاك الهناء يرفل في ثو % ب ثناء باق على الآثار % 6(@)(@@) % بهلال كأنما غرة الشه % ر برؤياه ليلة الإبدار % 7(@)(@@) % وجواد حاز المدى وهو في المه % د سليم الخطى أمين العثار % 8(@)(@@) % وحسام قد قلد المجد ماض % غير خالي القراب ماضي الغرار % 9(@)(@@) % حزت فيه المنى فأطلعت منه % قمر المجد في سماء الفخار % 10(@)(@@) % فاز من فاز منه يوم تجلى % % بجلاء القلوب والأبصار % PageV01P344 11(@)(@@) % وأقر العيون منه بمأمو % % ل له المكرمات دار قرار % 12(@)(@@) % قد تحلت بذكره غرة المجد % د وسارت شوارد الأشعار % 13(@)(@@) % حسر الدهر عنه و نجاب غيم ال % % غيث عن كوكب العلاء الساري % % 14(@)(@@) % فتمل الهناء و سعد به حل % ف سرور صاف من الأكدار % 15(@)(@@) % ولئن خلته صغيرا فما زا % % ل صغار الكرام غير صغار % 16(@)(@@) % والفتى عند قدره وعلاه % وكبار اللئام غير كبار % 17(@)(@@) % فوقاك الإله فيه وفي مج % دك ما يتقى من الأقدار % 18(@)(@@) % أبدا ما استقل ركب وما جا % % د بري البلاد صوب قطار % 19(@)(@@) % كوكب تستنير حتى تراه % قمرا باهرا أبا أقمار % PageV01P345 البحر : طويل 1(@)(@@) % سواي لمن لم يعشق المجد عاشق % وغيري لمن لم يصطف الحمد وامق % 2(@)(@@) % عزفت عن الأحباب غير ذوي النهى % % فلست بمشتاق وغيرك شائق % 3(@)(@@) % أحبك ما حنت سلوب وما شدا % % طروب وما تاق العشيات تائق % 4(@)(@@) % ومالي لا يقتادني نحوك الهوى % % وعندي حاد من هواك وسائق % 5(@)(@@) % أأثني عناني عنك أطلب مطلبا % وأترك خيرا منه إني لمائق % 6(@)(@@) % يطيع النوى من خاف في أرضه الطوى % % ولولا احتباس الغيث ما شيم بارق % 7(@)(@@) % أيا بن علي إن ترديت فاشتمل % رداء المعالي إنه بك لائق % 8(@)(@@) % فأنت الحقيق بالعلاء وبالثنا % % إذا الحق يوما أوجبته الحقائق % 9(@)(@@) % لعمري لئن كنت امرأ فاته الغنى % % فحسبي غنى أني بجودك واثق % 10(@)(@@) % وقد علقتني النائبات 
ms102	 فويحها % % أما علمت أني بحبلك عالق % PageV01P346 11(@)(@@) % ألم تدر أني من أبي اليمن نازل % بحيث تحاماني الخطوب الطوارق % 12(@)(@@) % ألم يغنني بحر بجودك زاخر % ألم يحمني طود بعزك شاهق % 13(@)(@@) % ألم يك لي من حسن رأيك صارم % لهام العدى والفقر والدهر فالق % 14(@)(@@) % لقد برحت كفاك في الجود بالحيا % % فلا عاقها إلا عن البخل عائق % 15(@)(@@) % سماؤك مدرار وريحك غضة % وعزك قهار ومجدك باسق % 16(@)(@@) % وما برحت منك الخلائق تعتلي % % إلى سؤدد لا تدعيه الخلائق % 17(@)(@@) % إذا ما تنوخي سما لفضيلة % تخلى مجاريه وقل المرافق % 18(@)(@@) % توسطت منهم بيت فخر عماده % صدور القنا والمرهفات الذوالق % 19(@)(@@) % بنى أول منهم وشيد آخر % إلى مثله تسمو العيون الروامق % 20(@)(@@) % سمت بسعيد في تنوخ وغيرها % % ذوائب مجد بالنجوم لواصق % PageV01P347 21(@)(@@) % بأزهر لو ألقى على البدر مسحة % ببهجته لم يمحق البدر ماحق % 22(@)(@@) % أغر إذا أجرى الكرام إلى مدى % % شآهم جواد للسوابق سابق % 23(@)(@@) % فتى عطر الأيام من طيب ذكره % شذى تتهاداه الأنوف النواشق % 24(@)(@@) % وزينت به الدنيا فباهت وطاولت % مغربها تيها به والمشارق % 25(@)(@@) % أنامله للمكرمات مفاتح % على أنها للحادثات مغالق % 26(@)(@@) % غمائم غر ليس تدرى هباتها % % أهن سيوب أم سيول دوافق % 27(@)(@@) % تألى على الإسراف في بذل ماله % فلم يقتصر والصادق العزم صادق % 28(@)(@@) % فوالله ما أدري أتلك مواعد % تقدمن من إحسانه أم مواثق % 29(@)(@@) % بقيت لعبد عائد بك سعده % وعشت لعيش خالد لا يفارق % 30(@)(@@) % ولا زلت مأمولا لأيام عزك الب % % بواقي ومأمونا عليك البوائق % PageV01P348 31(@)(@@) % نطقت بمدح أنت أهل لخيره % ومن شرفي أني بمدحك ناطق % 32(@)(@@) % شرفت به والفخر فخرك مثل ما % % تعطر من فض اللطيمة فاتق % 33(@)(@@) % ولست أبالي عند من بات كاسدا % إذا هو أضحى وهو عندك نافق % 34(@)(@@) % غرائب من أبكار مدح كأنها % % كرائم من أزهار نور فتائق % 35(@)(@@) % تشوق وتصبي السامعين كأنما % % بها يتغنى معبد أو مخارق % 36(@)(@@) % تمر بأفواه الرواة كأنها % % مصفقة من خمر عانة عاتق % 37(@)(@@) % لقد حدقت بي من أياديك أنعم % فعندي من 
ms103	 شكري لهن حدائق % 38(@)(@@) % فإن أنا لم أطلق لساني بحمدها % % فأم العلى والمجد مني طالق % PageV01P349 البحر : كامل تام 1(@)(@@) % يا حسنه قمرا وأنت سماؤه % أطلعته فجلا الظلام ضياؤه % 2(@)(@@) % يا سعده من قادم سر السرو % % ر به وهنئ بالخلود هناؤه % 3(@)(@@) % وافاك في جيش الفخار متوجا % بالحمد خفاقا عليه لواؤه % 4(@)(@@) % قمر كفى الأقمار سعدا أنها % % أشباهه في المجد أو أكفاؤه % 5(@)(@@) % يمسي ويصبح في البقاء شريكها % % أبدا كما هي في العلى شركاؤه % 6(@)(@@) % كفلت علاك له بكل فضيلة % إن النبيه نبيهة أبناؤه % 7(@)(@@) % من كنت أنت أباه كان لمجده % أن يستطيل وأن يشاد بناؤه % 8(@)(@@) % تنمى الفروع إلى الأصول وخيرها % % وأجلها فرع إليك نماؤه % 9(@)(@@) % من كان من نجل البدور ونجرها % % لم يعدها إشراقه وعلاؤه % 10(@)(@@) % ولقد ثلثت النيرين بثالث % لولاك أعجز ناظرا نظراؤه % PageV01P350 11(@)(@@) % لا فرق بينهما يعد وبينه % في الفضل لولا بأسه وسخاؤه % 12(@)(@@) % من ذا يذم الشمس عم ضياؤها % % أم من يعيب البدر تم بهاؤه % 13(@)(@@) % وهما هما لكن من لمؤمل % أكدت مطالبه وخاب رجاؤه % 14(@)(@@) % وطريد خوف لا يحاول منعه % سدت مطالعه وعز نجاؤه % 15(@)(@@) % وأسير دهر لا يرام فكاكه % وقتيل فقر لا يرى إحياؤه % 16(@)(@@) % لم يعط هذا الدهر قط فضيلة % كندى أبي اليمن الجزيل عطاؤه % 17(@)(@@) % إن الكرام لداء كل ملمة % أعيا على الفلك العلي دواؤه % 18(@)(@@) % ما مر خطب ممرض إلا وفي % % أيدي بني عبد اللطيف شفاؤه % 19(@)(@@) % إن الميسر وهو كوكب سعدهم % ليجل عن رأد الضحى إمساؤه % 20(@)(@@) % ولد إذا فخرت بآباء العلى % % أولادها فخرت به أباؤه % PageV01P351 21(@)(@@) % من رام مشبهه سوى أسلافه % في المكرمات الغر طال عناؤه % 22(@)(@@) % ملك الجمال فأشرقت لألاؤه % وحبا الجميل فأغرقت آلاؤه % 23(@)(@@) % مثل الحيا سطعت لوامع برقه % في أفقه وتبجست أنواؤه % 24(@)(@@) % قلدت منه مهندا ما سل إل % % راق رونقه وراع مضاؤه % 25(@)(@@) % تسمو بأخمصه المنابر واطئا % وتتيه إن رقيت بها خطباؤه % 26(@)(@@) % ويجل قدر المدح عاطر مدحه % ويطول عن حسن الثناء ثناؤه % 27(@)(@@) % وكأنما 
ms104	 أخلاقه أعراقه % وكأنما أفعاله أسماؤه % 28(@)(@@) % جارى الأصول فجده من جده % في النائبات ومن أبيه إباؤه % 29(@)(@@) % فتهنه وتمل عيشك لابسا % فضفاض عيش لا يضيق فضاؤه % 30(@)(@@) % وتهن إخوته الذين ورودهم % دين على الأيام حل قضاؤه % PageV01P352 31(@)(@@) % حتى تراهم من تنوخ أسرة % كرم الزمان بأنهم كرماؤه % 32(@)(@@) % و ستعل و بق فما لراج منية % إلا بقاؤك للعلى وبقاؤه % 33(@)(@@) % إني هجرت العالمين إلى الذي % % هجر الغبي إلى الأبي صفاؤه % 34(@)(@@) % شكرا وكيف جحود فضل مؤمل % شهدت بباهر فضله أعداؤه % 35(@)(@@) % لا يصلت البطل المقارع سيفه % إلا إذا ما الرمح قل غناؤه % PageV01P353 البحر : رمل تام 1(@)(@@) % ما على فضلك ذا من مفضل % يا أبا اليمن سعيد بن علي % % 2(@)(@@) % من يكن مثلك في الجود يكن % غاية الضارب عند المثل % 3(@)(@@) % أنت بدر التم في السعد إذا % % ذكر السعد وشمس الحمل % 4(@)(@@) % مثل ما كنيت أو سميت لا % % زلت محروس العلى والأجل % 5(@)(@@) % فابق واسلم وسام واسعد أبدا % و عل و فخر و عد و قهر وطل % 6(@)(@@) % ما همى غيث حكى برك بي % % وصفا عيش حكى ودك لي % % PageV01P354 البحر : هزج 1(@)(@@) % أيا ما أحسن المنثو % % ر منظوما ومنثورا % % 2(@)(@@) % وما أطيبه نشرا % وما أشرقه نورا % % 3(@)(@@) % ويا للورد ما أبها % % ه منظورا ومخبورا % % 4(@)(@@) % يقل المسك مفتوقا % له والروض ممطورا % % 5(@)(@@) % كأن عوارضا غرا % به أو أعينا حورا % % 6(@)(@@) % تراه كأنما أهدى % % أكفا لم تزر زورا % % 7(@)(@@) % عذارى غلن أيديه % ن تختيما وتسويرا % % 8(@)(@@) % قصرنا عنده عيشا % على اللذات مقصورا % % 9(@)(@@) % سرورا والفتى من صا % % حب الأيام مسرورا % % 10(@)(@@) % كأنا بأبي اليمن % صحبنا العمر معمورا % % PageV01P355 11(@)(@@) % صفاء ما نرى فيه % مدى الأيام تكديرا % % PageV01P356 البحر : مجزوء الكامل 1(@)(@@) % مولاي تصبر عن أديبك % حقا وتعرض عن حبيبك % 2(@)(@@) % أو ما نصابك من عل % ي والعلى أدنى نصيبك % 3(@)(@@) % أو ما ضربت فهل قدر % ت على شبيهك أو ضريبك % 4(@)(@@) % من مثل شاعرك الذي % % بهر البرية أو خطيبك % 5(@)(@@) % يهدي إليك محاسنا % تدع المحان 
ms105	 من عيوبك % 6(@)(@@) % نفحات مدح لم تزل % تعنيك عن نفحات طيبك % 7(@)(@@) % أما دمشق فقد حوت % قمرا تطلع من جيوبك % 8(@)(@@) % لولا طلوعك لم تنر % فالله يؤمن من مغيبك % 9(@)(@@) % لله روح صباك كم % ترد المنى وندى جنوبك % 10(@)(@@) % كم تكتم النعمى وما % % ينفك جودك أن يشي بك % PageV01P357 البحر : متقارب تام 1(@)(@@) % طربت وما كان ذاك الطرب % إلى دعج في المها أو شنب % 2(@)(@@) % ولكن إلى كل ماضي الجنا % % ن سبط البنان كريم الحسب % 3(@)(@@) % كمثل أبي اليمن في العالمين % وهل مثل نائله في السحب % 4(@)(@@) % إذا كنت جارا لجار له % فكيف تخاف صروف النوب % 5(@)(@@) % يطول بأطول أصل وفرع % وينمى إلى خير جد وأب % 6(@)(@@) % يدل عليهم وهل للهلا % % ل معدى عن البدر إما انتسب % 7(@)(@@) % يرى المجد أفضل ما يقتني % % ه والحمد أشرف ما يكتسب % 8(@)(@@) % شريف المرام منيف المقام % غريب الندى والنهى والأدب % 9(@)(@@) % فتى بالعلى أبدا مغرم % وبالجود مغرى وبالمجد صب % 10(@)(@@) % تعود بالجود صرف المهم % ودفع الملم وكشف الكرب % PageV01P358 البحر : رمل تام 1(@)(@@) % كم توالت يا سعيد بن علي كم توالت يا سعيد بن علي % % لك عندي من أياد هطل % 2(@)(@@) % بادئات عائدات أبدا % لا ترى الوسمي إلا بالولي % % 3(@)(@@) % كلما وافت يد بعد يد % هون الآخر قدر الأول % 4(@)(@@) % كرم يضعف شكري عنده % وندى يقصر عنه أملي % % 5(@)(@@) % وسجايا لو عدت أخلاقه % لم تجدها في الغمام المسبل % 6(@)(@@) % شامل الفضل غريب الحلم لا % % ينظر العلياء إلا من عل % PageV01P359 البحر : وافر تام 1(@)(@@) % أمد الله ظلك يا سعيد % علي فإنه الظل المديد % 2(@)(@@) % وعشت تصاحب الدنيا خلودا % وتصحبك الأيامن والسعود % 3(@)(@@) % إذا ما كان مثلك لي مجيرا % ومثلك لا يجود به الوجود % 4(@)(@@) % فإن بعيد ما أرجو قريب % وإن قريب ما أخشى بعيد % 5(@)(@@) % علوت بني الورى كرما وجودا % وحسبك من على كرم وجود % 6(@)(@@) % نماك أب نماه خير جد % كذا الآباء تنميها الجدود % 7(@)(@@) % هم بدءوا العلى فسموا علوا % % وأنت لخير ما بدؤوا معيد 
ms106	 % 8(@)(@@) % وما جحدت محاسن فخر قوم % خلائقك الحسان بها شهود % 9(@)(@@) % ولو سجد الورى لأبر خلق % يدا وندى لك السجود % 10(@)(@@) % وسدت فما أحق بكل مجد % سواك إذا تفرد من يسود % PageV01P360 البحر : خفيف تام 1(@)(@@) % كنت أدعوك في مداواة حالي % % بنداك الفياض من كل سقم % 2(@)(@@) % وقد اعتل بعد جسمي فما عن % د أياديك من مداواة جسمي % % 3(@)(@@) % وإذا كنت لي على الدهر عونا % فمحال أن يمكن الدهر ظلمي % % PageV01P361 البحر : سريع 1(@)(@@) % يا بن علي ما أضيعت على % أمست بتأييدك مضبوطه % 2(@)(@@) % من كان مغبوطا بإدراكها % % فهي بإدراكك مغبوطه % 3(@)(@@) % كم من يد ليست بمجحودة % ونعمة ليست بمغموطه % 4(@)(@@) % حزت بها شكري ودلت على % % محبة ب لنفس مخلوطه % 5(@)(@@) % والماجد المفضال لا يأمن ال % % مال غداة الجود تفريطه % 6(@)(@@) % قد وصل الثوب ولا عذر لي % % أن ألبس الثوب بلا فوطه % 7(@)(@@) % لا سيما وهي بحكم الندى % % في عقد ميعادك مشروطه % 8(@)(@@) % كيف وأخلاقك مرضية % أصحبها والحال مسخوطه % 9(@)(@@) % لا قبض الدهر يدي عن غنى % وهي إلى جودك مبسوطه % PageV01P362 البحر : كامل تام 1(@)(@@) % أيام دهرك كلها أعياد % أبدا عليك بما تشاء تعاد % 2(@)(@@) % لا يدعونك بالجواد مقصر % وأقل حقك أن يقال جواد % 3(@)(@@) % ولئن غدوت الفرد في نيل العلى % % والمجد فالقمر المنير فراد % 4(@)(@@) % وأما وجودك يا سعيد فإنه % ذخر لكل مؤمل وعتاد % 5(@)(@@) % لقد ستفاد بك الزمان فضيلة % ما خالها أبد الزمان تفاد % 6(@)(@@) % كم من يد لك قد وسمت بعهدها % % جودا كما وسم الرياض عهاد % 7(@)(@@) % أوليتني نعما أقل ثنائها % % بيني وبين الفكر فيه جهاد % 8(@)(@@) % كلفتني بنداك عد مناقب % يفنى الثناء وما لهن نفاد % 9(@)(@@) % فبعطفك الإنجاء والإنجاد لي % % وبكفك الإسعاف والإسعاد % 10(@)(@@) % لا زال ربعك للمطالب مربعا % يحيى به الوراد والرواد % PageV01P363 11(@)(@@) % وبقيت ما بقي الرجاء فإنه % جسم ونائلك الجزيل فؤاد % PageV01P364 البحر : طويل 1(@)(@@) % أقول لدهر ضامني بعد عزة % بما فل من حدي وما هد من ركني % % 2(@)(@@) % أيا دهر إن حملتني ويك منة % لمولي جميل فلتكن 
ms107	 لأبي اليمن % 3(@)(@@) % فلست بداع غيره عند كربة % إذا لم يفرجها فلا فرجت عني % % 4(@)(@@) % كفى بسعيد في النوائب مسعدا % سيبلغ منها فوق ما بلغت مني % % 5(@)(@@) % فتى ليس كالمزن الهطول بنانه % ولكنه أندى بنانا من المزن % PageV01P365 البحر : سريع 1(@)(@@) % ما لأبي اليمن علينا يد % لكن أيادينا جميعا عليه % 2(@)(@@) % لأنه يعتد إسداءه ال % % جميل إسداء جميل إليه % 3(@)(@@) % كأنما نعطيه من جود أي % دينا الذي نأخذه من يديه % PageV01P366 البحر : بسيط تام 1(@)(@@) % أما أبو اليمن فلتفخر به اليمن % والفخر والدهر والأيام والزمن % 2(@)(@@) % فاق الأنام علاء والكرام ندى % وليس مستنكرا أن يحسن الحسن % 3(@)(@@) % أغر أزهر أزهر فياض له منن % لا تستقل بأدنى شكرها المنن % 4(@)(@@) % تغرب الجود حتى حل في يده % فليس للجود إلا كفه وطن % PageV01P367 البحر : سريع 1(@)(@@) % أخلاقه أحلى من الأمن % وكفه أندى من المزن % 2(@)(@@) % إذا وصفناه ولم نسمه % قال الورى ذاك أبو اليمن % 3(@)(@@) % ذاك الذي لو لم نبح ب سمه % لم يجهل العالم من نعني % % PageV01P368 البحر : وافر تام 1(@)(@@) % وليس الشكر بعد الجود إلا رأيتك تقتضي شكر الرجال % ولست بمقتضى بذل النوال % 2(@)(@@) % غراما بالمحامد والمساعي % % ووجدا بالمكارم والمعالي % % 3(@)(@@) % ولست بعاطل من حلي حمد % وكل مؤمل بنداك حال % 4(@)(@@) % وليس الشكر بعد الجود إلا % % أسير الجود من قبل السؤال % 5(@)(@@) % علوت عن الثناء وأي خرق % سواك عن الثناء المحض عال % 6(@)(@@) % وأين الشكر من هذي العطايا % % وأين الحمد من هذا الجلال % 7(@)(@@) % سلا العذري عمن بات يهوى % % ولست عن الندى يوما بسال % 8(@)(@@) % بقيت مملأ غفلات عيش % نمير الورد ممدود الظلال % 9(@)(@@) % تعمر والميسر فيه عمرا % جديدا ثوبه والدهر بال % 10(@)(@@) % تسر به وتمنحه أمين ال % % فطام حميد عاقبة الفصال % PageV01P369 11(@)(@@) % بيمنك يا أبا اليمن استطلنا % % إلى العلياء من كرم الخلال % 12(@)(@@) % سعيدا يا سعيد تفوز منه % بأيام كأيام الوصال % 13(@)(@@) % لقد شرفت بك الدنيا وطالت % بك الأيام فخرا والليالي % % 14(@)(@@) % فعشت بها تسربل منك فخرا % وتلبس منك أثواب الجمال % PageV01P370 البحر : وافر 
ms108	 تام 1(@)(@@) % دعتني حاجة فبعثت وفدا % حقيقا بالمطالب أن يعودا % % 2(@)(@@) % ثناء لا يزور الدهر إلا % مليكا قاهرا وأخا ودودا % % 3(@)(@@) % ولو أني أشاء هززت قوما % ولكني أراك أغض عودا % % PageV01P371 البحر : كامل تام 1(@)(@@) % قد عدتني فشفيت من سقمي % % وحميت إذ ألممت من ألمي % % 2(@)(@@) % ووسمت مغناي الجديب فقد % أثرى بموطئ ذلك القدم % 3(@)(@@) % ومواطئ الأقدام حيث خطا ال % % كرماء مثل مواقع الديم % 4(@)(@@) % وعيادتي في الحال توجبها % % أبدا عليك سجية الكرم % 5(@)(@@) % إن لم يعد حالي نداك إذا % فبم الشفاء لها من العدم % PageV01P372 البحر : كامل تام 1(@)(@@) % أما الزمان فلم يزل ينحي % % أبدا علي بمؤلم الجرح % 2(@)(@@) % فلئن نوائبه سمحن على % % ما كان منه بماجد سمح % 3(@)(@@) % فلأثنين على يد فتحت % باب الرجاء إلى أبي الفتح % PageV01P373 البحر : متقارب تام 1(@)(@@) % عسى باخل بلقاء يجود % عسى ما مضى من تدان يعود % 2(@)(@@) % عسى موقف أنشد القلب فيه % فيوجد ذاك الفؤاد الفقيد % 3(@)(@@) % عناء سهرت إلى هاجد % وأين من الساهرين الهجود % 4(@)(@@) % إذا طال عهدك بالنازحين % تغير ود وحالت عهود % 5(@)(@@) % أأحمل يا هجر جور البعاد % وجورك إني إذا للجليد % 6(@)(@@) % أيا كمدي ألليلي انقضاء % أيا كبدي ألناري خمود % 7(@)(@@) % مرضت فهل من شفاء يصاب % وهيهات والداء طرف وجيد % 8(@)(@@) % ويا حبذا مرضي لو يكو % % ن ممرضي اليوم فيمن يعود % 9(@)(@@) % أيا غرم ما أتلفت مقلتاه % وقد يحمل الثأر من لا يقيد % 10(@)(@@) % ومنى الوصال فأهدى الصدود % وما وعد ذي الخلف إلا وعيد % PageV01P374 11(@)(@@) % خليلي إن خان خل ألا % % حليف على هجره أو عقيد % 12(@)(@@) % وهل إن وفى لي بعهد الوصال % أينقص هذا الجوى أم يزيد % 13(@)(@@) % ويا قلب إن أخلق الوجد منك % فأنى لي اليوم قلب جديد % 14(@)(@@) % إلى م تحوم حيام العطاش % إذا مورد عن عز الورود % 15(@)(@@) % تمنى زرود ولم تحترق % بنار الصبابة لولا زرود % 16(@)(@@) % وتمسي تهيم بماء الغوير % وقد ذاد عن ورده من يذود % 17(@)(@@) % إذا الري جاوز أيدي الكرام % فلا ساغ لي منه عذب برود 
ms109	 % 18(@)(@@) % فأنقع من ورده ذا الصدى % % وأنفع من برده ذا الوقود % 19(@)(@@) % وما ذا تريد من الباخلين % إذا لم تجد عندهم ما تريد % 20(@)(@@) % أتأمل إسعاد قوم إذا % % كفيت أذاهم فأنت السعيد % PageV01P375 21(@)(@@) % عمرت أروض خطوب الزما % % ن لو أن جامحها يستقيد % 22(@)(@@) % وما كان أجدرني بالعلا % % ء لو قد تنبه حظ رقود % 23(@)(@@) % ومن لي بيوم أبي المقام % تقام على الدهر فيه الحدود % 24(@)(@@) % سلا الخلق جمعا عن المكرمات % وأما العميد فصب عميد % 25(@)(@@) % غذاه هواها وليدا فلي % س يسلوه حتى يشيب الوليد % 26(@)(@@) % يغنيه وجد بها غالب % ويصبيه شوق إليها شديد % 27(@)(@@) % على أنه لم تخنه النوى % % ولم يدر في حبها ما الصدود % 28(@)(@@) % فتى لم يفته الثناء الجميل % ولم يعد فيه المحل المجيد % 29(@)(@@) % ولم ينب عنه رجاء شريف % ولم يخل منه مقام حميد % 30(@)(@@) % سما للعلى ودنا للندى % % وذو الفضل يقرب وهوا لبعيد % PageV01P376 31(@)(@@) % من القوم سادوا وجادوا وقل % لهم أن يسودو الورى أو يجودوا % % 32(@)(@@) % بني أسد إنما أنتم % بدور علاء نمتها أسود % 33(@)(@@) % أليس لكم ما بنى الكامل ال % % أمين علوا وشاد السديد % 34(@)(@@) % سماء على قمراها لكم % ومنكم كواكبها والسعود % 35(@)(@@) % لنا من ذرى العز طود أشم % ومن رغد العيش روض مجود % 36(@)(@@) % فما المحل كالفقر إلا قتيل % وما الخوف كالجور إلا طريد % 37(@)(@@) % كأنا سقانا بنعماه أو % حمانا بظل علاه العميد % 38(@)(@@) % فتى لم تزل عاقرا في ذرا % % ه أم الحوادث وهي الولود % 39(@)(@@) % يظفر في ظله الخائبون % وتنهض بالعاثرين الجدود % 40(@)(@@) % إذا نحن عذنا ولذنا به % فمن ذا نشيم ومن ذا نرود % PageV01P377 41(@)(@@) % كسا الفخر والدهر والعالمي % % ن فخرا به أبدا لا يبيد % 42(@)(@@) % فلا يدعه زين كتابه % حسود يصاديه خاب الحسود % 43(@)(@@) % فما خصهم ما يعم الأنام % ولا جهلوا ما أراد المريد % 44(@)(@@) % وإن غرسوا غرسه في الكرام % فما كل عود وإن طاب عود % 45(@)(@@) % من الكظمي الغيظ والمحسنين % إذا برحت بالصدور الحقود % 46(@)(@@) % فمت بحزم إلى جوده % ينلك مع 
ms110	 العفو بر وجود % 47(@)(@@) % إذا كنت سيد قوم ولم % تسعهم بحلم فأنت المسود % 48(@)(@@) % يفيد فيحزنه جوده % إذا كان دون العلى ما يفيد % 49(@)(@@) % ويبدي فيعظم معروفه % ولكن يصغره ما يعيد % 50(@)(@@) % كأوبة أحبابه عنده % حلول وفود يليهم وفود % PageV01P378 51(@)(@@) % وك لبين أن تستقل الركاب % بهم أو تشد لعاف فتود % 52(@)(@@) % يجل على أن يرى راكبا % طريقا عن القصد فيها يحيد % 53(@)(@@) % ويشرف عن فعل ما لا يشق % ويكرم عن حمل ما لا يؤود % 54(@)(@@) % غني بآرائه البيض أن % تظاهره عدة أو عديد % 55(@)(@@) % وقفت القوافي على حمده % وما رجزي عنده والقصيد % 56(@)(@@) % يقصر عن قدره جهدها % % وفي عفوها عن أناس مزيد % 57(@)(@@) % أنال فكل جواد بخيل % وقال فكل بليغ بليد % 58(@)(@@) % كأنك من سيبه تستميح % متى جئت من علمه تستفيد % 59(@)(@@) % كلا الزاخرين كفيلاك أن % تفيض سيول وتطمو مدود % 60(@)(@@) % له فقر لو تجسدن لم % يفضلن إلا بهن العقود % PageV01P379 61(@)(@@) % فيظلمن إن قيل نور نضير % ويبخسن إن قيل در نضيد % 62(@)(@@) % وإني وإن كنت لم تعدني % % نفائس بيض من الغر غيد % 63(@)(@@) % ليحسن بي في هواك الغلو % ويقبح بي عن نداك القعود % 64(@)(@@) % مضى الأكرمون فأمسى يشيد % بذكر مناقبهم من يشيد % 65(@)(@@) % كأن لم يبينوا بما خلدوا % % وليس المحامد إلا الخلود % 66(@)(@@) % مناقب تشرد ما لم يكن % لها من نظام القوافي قيود % 67(@)(@@) % وما زال يحفظ منها المضاع % لديك ويجمع منها البديد % 68(@)(@@) % فداء عطائك ذاك الجزيل % يا حمز شكري هذا الزهيد % 69(@)(@@) % وجدت فكنت حيا لا يغب % سقى الكون ريا وجيد الوجود % 70(@)(@@) % بلغت من الفضل أقصى مداه % فما يستزيد لك المستزيد % PageV01P380 71(@)(@@) % وطال أبو الفتح أن لا يكون % طريف العلى لكما والتليد % 72(@)(@@) % فلولاه أعوز أهل الزمان % شبيهك في عصرهم والنديد % 73(@)(@@) % لقد صدقت في نداه الظنون % فلا كذبت في علاه الوعود % PageV01P381 البحر : وافر تام 1(@)(@@) % أليس من العجائب أن مثلي % % وأنت صفيه يشكو الزمانا % % 2(@)(@@) % وما جارت خطوب الدهر إلا % وجدتك من حوادثها أمانا % 3(@)(@@) % ولا 
ms111	 ابتسمت ثغور النور إلا % ذكرت بها خلائقك الحسانا % % 4(@)(@@) % خلقت أبر هذا الخلق كفا % % وأجداهم وأنداهم بنانا % % 5(@)(@@) % فلو أن العلى كانت قناة % لكنت أبا الحسين لها سنانا ) % PageV01P382 
ms112	