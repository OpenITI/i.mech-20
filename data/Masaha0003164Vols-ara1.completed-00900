ms886	 ) :(@)(@)(@@) -عبد الله بن اسماعيل بن محاسن.(@)(@)(@@)(@@)(@@) $ معية (ابن... ) :(@)(@)(@@) -الحسن...(@)(@)(@@)(@@)(@@) $ معية (ابن... ) : -محمد بن القاسم بن الحسين بن القاسم.(@)(@)(@@)(@@)(@@) $ مفتي الشيعة:(@)(@)(@@) -يوسف بن ناصر بن محمد بن حماد.(@)(@)(@@)(@@)(@@) $ المقري:(@)(@)(@@) -أحمد بن يوسف بن أبي بكر.(@)(@)(@@)(@@)(@@) $ مكي بن محمد بن حامد بن أحمد(@)(@)(@@) ، جمال الدين أبو محمد النبطي العاملي.(@)(@)PageV05P218(@)(@)(@@) هو والد محمد بن مكي (734-786) (ص 205-207) . حكى صاحب «المعالم» في «الإجازة الكبيرة» عن خط الشهيد، أنه كتب: أن والده الشيخ جمال الدين أبا محمد مكي كان من تلاميذ الشيخ نجم الدين طومان بن أحمد العاملي (ص 102-103) ومن المترددين إليه إلى حين سفر طومان إلى الحجاز ووفاته بطيبة في 728. ويظهر من «الأربعين» للشهيد أن فخر المحققين (ص 185) أجاز للشهيد في داره بالحلة 751 وأجازه أبو الحسن علي بن أحمد بن طراد (ص 133-134) في 754 وإجازة تاج الدين بن معية (ص 197) له ولولديه كانت في 776. فمن تأريخ ولادة الشهيد 734 وتأريخ إجازة فخر المحققين له وعمره 17 سنة ومن عدم روايته من والده مع كثرة مشايخه، يظهر أنه ما أدرك والده كبيرا وأنه توفي في صغر الشهيد.(@)(@)(@@)(@@)(@@) $ ملك الأئمة:(@)(@)(@@) -بدر الدين الناوندي.(@)(@)(@@)(@@)(@@) $ ملك الأئمة: -محمد بن اسحاق الدشتكي.(@)(@)(@@)(@@)(@@) $ ملك الشعراء:(@)(@)(@@) -الحسن بن محمد الرامي.(@)(@)(@@)(@@)(@@) $ ملك العلماء:(@)(@)(@@) -عبد الله بن محمد الحسيني العريضي.(@)(@)(@@)(@@)(@@) $ ملك العلماء: -محمد بن الحسن بن محمد بن كجيل.(@)(@)(@@)(@@)(@@) $ ملك العلماء: -محمد بن هلال الآوي.(@)(@)(@@)(@@)(@@) $ ملك الفضلاء:(@)(@)(@@) -عبد الرحمان بن علي بن أبي الحسن.(@)(@)PageV05P219(@)(@)(@@)(@@)(@@) $ ملك الفقهاء:(@)(@)(@@) -علي بن محمد بن علي نصير الدين الكاشي.(@)(@)(@@)(@@)(@@) $ المناري (1) :(@)(@)(@@) -الحسن بن يوسف بن هلال.(@)(@)(@@)(@@)(@@) $ المناري: -موسى بن الحسن بن يوسف بن الهلال.(@)(@)(@@)(@@)(@@) $ المنجم:(@)(@)(@@) -أبو اسحاق اينجو.(@)(@)(@@)(@@)(@@) $ المنجم باشي:(@)(@)(@@) -الحسن بن محمد بن محمد بن الحسن الطوسي.(@)(@)(@@)(@@)(@@) $ المنشي:(@)(@)(@@) -الحسن الكاشي.(@)(@)(@@)(@@)(@@) $ المنشي: -عبد العزيز بن محاسن بن سرايا.(@)(@)(@@)(@@)(@@) $ المنشي: -محمود بن يحيى بن محمد بن سالم الحلي.(@)(@)(@@)(@@)(@@) $ المنصور:(@)(@)(@@) -الحسن بن محمد بن مكي.(@)(@)(@@)(@@)(@@) $ منظور (ابن... ) :(@)(@)(@@) -محمد بن مكرم بن علي...(@)(@)PageV05P220(@)(@)(@@)(@@)(@@) $ المؤرخ:(@)(@)(@@) -حمد الله المستوفي.(@)(@)(@@)(@@)(@@) $ المؤرخ: -عبد الرزاق بن أحمد بن محمد (ابن الفوطي) .(@)(@)(@@)(@@)(@@) $ المؤرخ: -محمد 
ms887	 بن الحسن بن اسفنديار.(@)(@)(@@)(@@)(@@) $ الموسوي:(@)(@)(@@) -الحسن بن علي بن المازندراني.(@)(@)(@@)(@@)(@@) $ الموسوي: -عبد الحميد بن فخار بن معد.(@)(@)(@@)(@@)(@@) $ الموسوي: -محمد بن أحمد بن ابي المعالي العلوي.(@)(@)(@@)(@@)(@@) $ الموسوي: -محمد بن محمد ابي الحسن...(@)(@)(@@)(@@)(@@) $ الموسوي: -هبة الله بن أبي محمد الحسن...(@)(@)(@@)(@@)(@@) $ موسى بن جعفر بن عيسى بن مبارك الحداد الحلي.(@)(@)(@@) الظاهر أنه من تلاميذ فخر المحققين م 771. وقد كتب في حياته شرحه على «نهج المسترشدين» الموسوم «معراج اليقين» وفرغ من الكتابة في 3 ج 1-768 أي قبل وفاة الشارح بثلاث سنين. والنسخة موجودة عند الشيخ عباس القمي بمشهد خراسان. ومر أحمد بن الحداد في (ص 11-12) .(@)(@)(@@)(@@)(@@) $ موسى بن الحسن بن يوسف بن هلال بن النعمان.(@)(@)(@@) أبو الحسن المناري.(@)(@)(@@) مر والده وأستاذه الحسن في ص 54 وكتب صاحب الترجمة كتاب «الشرائع» بخطه في عدة سنين وكان يقرؤه على والده في تلك المدة، فكتب والده في آخر الجزء الأول منه ما صورته:(@)(@)(@@) [أنهاه-أيده الله تعالى-قراءة وبحثا وفهما واستشراحا، وفقه الله وإيانا لمراضيه وذلك في مجالس آخرها نهار الاثنين 28 ع 1-756 وحسبنا الله ونعم الوكيل وأنا الفقير إلى الله حسن بن يوسف المناري عفى الله عنه، حامدا مصليا على محمد وآله (ع) ].(@)(@)PageV05P221(@)(@)(@@) وكتب أيضا ما هو قريب من ذلك أيضا بخطه في آخر الجزء الثاني، الذي فرغ المجاز المذكور من كتابته في 3-ع 1-758 وذكر والده أن آخر مجالس الإنهاء والقراءة كان نهار الأحد 25 محرم 759. والنسخة رأيتها بمشهد خراسان عند الشيخ عباس القمي مؤلف الكنى والألقاب. وعلى ظهرها خطوط صاحب الترجمة بتواريخ أولاده. ومنهم الحسن بن موسى المناري المولود 767 وأحمد بن موسى ومحمد بن موسى. ومن البنات، زينب بنت موسى، ولدت 766 وفاطمة ولدت 776. وفي آخر هذه النسخة فوائد كثيرة منها «كتابة المحقق الحلي إلى محفوظ بن وشاح» و«جواب ابن وشاح للمحقق» و«مراثي العلماء لابن وشاح» و«رثاء ابن وشاح للمحقق» .(@)(@)(@@) ومر محمد بن محفوظ بن وشاح في ص 198.(@)(@)(@@)(@@)(@@) $ موسى بن الحسين بن العود.(@)(@)(@@) توفي قبل 761 وصفه ولده محمد بن موسى في إجازته 
ms888	 لأخيه الحسين بن موسى في تلك السنة، بالشيخ الإمام.(@)(@)(@@) ومرت الإجازة في ترجمة المجاز ص 59 ولعله من أجداد محمد بن علي بن الحسين العودي العاملي تلميذ الشهيد الثاني.(@)(@)(@@)(@@)(@@) $ الموصلي (1) :(@)(@)(@@) -الحسن بن اسحاق بن ابراهيم بن عباس.(@)(@)(@@)(@@)(@@) $ الموصلي: -عبد الرحمان بن علي بن أبي الحسن.(@)(@)(@@)(@@)(@@) $ الموصلي: -علي بن الحسين بن القاسم بن منصور.(@)(@)(@@)(@@)(@@) $ مؤيد الدين:(@)(@)(@@) -محمد بن علي بن محمد بن أحمد بن محمد.(@)(@)PageV05P222(@)(@)(@@)(@@)(@@) $ المؤيدي:(@)(@)(@@) -محمد بن شمس الدين روبال.(@)(@)(@@)(@@)(@@) $ المؤيدي: -يحيى بن حمزة بن علي.(@)(@)(@@)(@@)(@@) $ المهدي.(@)(@)(@@) أو السيد المير مهدي. ذكر في «تأريخ أولاد الأطهار ص 145» أن السلطان غازان محمود والسلطان خدابنده المغولي استبصر بدلالة المير مهدي هذا وذلك في سنة 702.(@)(@)(@@)(@@)(@@) $ مهذب الدين:(@)(@)(@@) -محمود بن يحيى بن محمد بن سالم.(@)(@)(@@)(@@)(@@) $ المهنا (ابن... ) :(@)(@)(@@) -سالم بن حمد بن حماد...(@)(@)(@@)(@@)(@@) $ مهنا بن سنان بن عبد الوهاب.(@)(@)(@@) ابن نميلة بن محمد بن ابراهيم بن عبد الوهاب قاضي المدينة ابن الأمير أبي عمارة المهنا الأكبر ابن الأمير أبي هاشم داود بن الأمير أبي فليتة أحمد بن القاسم شمس الدين بن أبي علي عبيد الله ابن أبي الحسن طاهر بن أبي الحسن يحيى النسابة ابن أبي الحسن جعفر الحجة ابن أبي علي عبيد الله الأعرج الأول ابن الحسين الأصغر. هو نجم الدين الجعفري العبيدلي الحسيني المدني. قال العسقلاني في «الدرر الكامنة 5: 138» مهنا بن سنان بن عبد الوهاب بن نميلة الحسيني الإمامي المدني قاضي المدينة.(@)(@)(@@) اشتغل كثيرا. وكان حسن الفهم جيد النظم. ولأمراء المدينة فيه اعتقاد.(@)(@)(@@) وكانوا لا يقطعون أمرا دونه. وكان كثير النفقة متحببا إلى المجاورين، ويحضر مواعيد الحديث، ويترضى عن الصحابة إذا ذكروا ويتبرأ من فقهاء الإمامية مع تحقيق المعرفة وحسن المحاضرة ومات سنة 754. أقول: للمترجم(@)(@)PageV05P223(@) له إجازتان من العلامة الحلي في إحداهما ذكر فهرس تصانيفه في ذي الحجة 709 (ذ 1: 178) وتاريخ الأي 720 (ذ 5: 238) وله أيضا إجازة من فخر المحققين (ذ 1: 236) والإجازات كلها موجودة فيها المدح والثناء الكثير ويظهر منها أنه كان مرجعا للأحكام والقضاء في المدينة. ولما زار العتبات بالعراق كتب «المسائل 
ms889	 المهنائية» (ذ 5: 236-239) وأرسلها إلى العلامة ليكتب جواباتها وتكون له أفضل ما ظفر به بعد فوز زيارة المشاهد، فأجاب عنها العلامة. وقد قرأ السائل الجوابات على العلامة بداره في الحلة 717 كما في نسخة (عبد الحسين الحجة بكربلا) وقد وصف العلامة السائل في أول جواب المسألة الأولى بقوله: [السيد الكبير، النقيب الحسيب النسيب، المعظم المرتضى، عز السادة، زين السيادة، معدن المجد والفخار، والحكم والآثار، الجامع للقسط الأوفى من فضائل الأخلاق، والفائز بالسهم المعلى من طيب الأعراق، مزين ديوان القضاء بإظهار الحق على المحجة البيضاء عند ترافع الخصم، نجم الحق والملة والدين مهنا بن سنان الحسيني القاطن بمدينة جدة]وبعد رجوعه إلى المدينة سأله الشيخ عز الدين بن نور الدين علي أبي سعيد (ص... ) أن ينسخ المسائل والجوابات له، فنسخها صاحب الترجمة. ومن نسخته انتشرت النسخ. وتوجد نسخة من «الخرايج» للقطب الراوندي (ذ 7: 145-146) في مكتبة (سلطان العلماء بطهران» ذكر كاتبها أنه استنسخها عن خط السيد مهنا بن سنان بن عبد الوهاب الذي فرغ منها 748-هذا وقد ذكر ابن كثير في حوادث 716 من «البداية والنهاية» دخول المهنا إلى العراق ولقاءه بملك التتر خرابنده (كذا) ثم قال:(@)(@)(@@) وكان صاحب مكة الأمير خميصة بن أبي نمى الحسني قد قصد ملك التتر خرابنده لينصره على أهل مكة فساعده الروافض هناك فجهزوا معه جيشا من خراسان. فلما مات خرابنده بطلت ذلك وعاد خميصة خائبا ومعه أمير من كبراء الروافض من التتر يقال له الدلقندي وقد جمع لخميصة أموالا كثيرة ليقيم به الرفض في الحجاز فوقع بهما أخو المهنا مع العرب فنهب ما كان معهما(@)(@)PageV05P224(@) لأمن اموال فلما بلغت ذلك إلى الناصر، رضي عنه وغسل ذلك ذنبه. فأكرمه نائب الشام وأفتى ابن تيمية بالأموال لصالح المسلمين.(@)(@)(@@)(@@)(@@) $ المهندس:(@)(@)(@@) -عبد الرحمان بن محمد بن ابراهيم (ابن العتايقي) .(@)(@)(@@)(@@)(@@) $ مير:(@)(@)(@@) -محمد الآوي.(@)(@)(@@)(@@)(@@) $ مير: -المهدي...(@)(@)(@@)(@@)(@@) $ مير بزرگ:(@)(@)(@@) -كمال الدين بن قوام الدين.(@)(@)(@@)(@@)(@@) $ المير حسيني:(@)(@)(@@) -حسين بن عالم بن محمد. غ(@)(@)PageV05P225(@)(@)(@@)(@@)(@@) || «ن»(@)(@)(@@)(@@)(@@) $ ناصر الدين:(@)(@)(@@) -ابن حمزة.(@)(@)(@@)(@@)(@@) $ ناصر الدين: -حمزة بن حمزة بن 
ms890	 محمد.(@)(@)(@@)(@@)(@@) $ ناصر الدين: -عبد المطلب بن پادشاه.(@)(@)(@@)(@@)(@@) $ ناصر الدين: -يونس بن أحمد الحسيني.(@)(@)(@@)(@@)(@@) $ ناصر الدين بن عبد المطلب بن پادشاه الحسيني الجزائري.(@)(@)(@@) قال في «الرياض» : أورده علي بن عبد الحميد في «الرجال» (ذ 10: 157) من المقاربين لعصر العلامة الحلي. مر في (أنوار: 189) .(@)(@)(@@)(@@)(@@) $ ناظر الأوقاف:(@)(@)(@@) -الحسن بن محمد بن شرفشاه.(@)(@)(@@)(@@)(@@) $ ناظر الأوقاف: -الحسن بن محمد بن محمد بن الحسن الطوسي.(@)(@)(@@)(@@)(@@) $ ناظر المارستان:(@)(@)(@@) -الحسن بن محمد بن علي بن زهرة.(@)(@)(@@)(@@)(@@) $ الناموسي:(@)(@)(@@) -محمد بن علي...(@)(@)PageV05P226(@)(@)(@@)(@@)(@@) $ النباطي (1) :(@)(@)(@@) -الحسن الفتوني العاملي...(@)(@)(@@)(@@)(@@) $ النباطي: -محمد بن جعفر...(@)(@)(@@)(@@)(@@) $ النباطي: -مكي بن محمد بن حامد بن أحمد.(@)(@)(@@)(@@)(@@) $ نجدة (ابن... ) :(@)(@)(@@) -عبد علي...(@)(@)(@@)(@@)(@@) $ نجدة (ابن... ) : -محمد بن عبد علي الكركي.(@)(@)(@@)(@@)(@@) $ النجفي:(@)(@)(@@) -علي بن عبد الكريم بن علي بن محمد.(@)(@)(@@)(@@)(@@) $ النجفي: -علي بن عبد المجيد النيلي.(@)(@)(@@)(@@)(@@) $ نجم (ابن... ) :(@)(@)(@@) -الحسن بن ايوب.(@)(@)(@@)(@@)(@@) $ نجم (ابن... ) : -الحسن بن...(@)(@)(@@)(@@)(@@) $ نجم الدين:(@)(@)(@@) -الحسن بن علي بن الحسن الطبري.(@)(@)(@@)(@@)(@@) $ نجم الدين: -الحسين بن اردشير بن محمد.(@)(@)(@@)(@@)(@@) $ نجم الدين: -خضر بن محمد بن نعيم...(@)(@)(@@)(@@)(@@) $ نجم الدين: -سليمان بن عبد القوي.(@)(@)PageV05P227(@)(@)(@@)(@@)(@@) $ نجم الدين: -طومان بن أحمد...(@)(@)(@@)(@@)(@@) $ نجم الدين: -عبد الله بن حمدويه.(@)(@)(@@)(@@)(@@) $ نجم الدين: -مهنا بن سنان.(@)(@)(@@)(@@)(@@) $ نجيح (ابن... ) :(@)(@)(@@) -محمد...(@)(@)(@@)(@@)(@@) $ النرسي (1) :(@)(@)(@@) -علي بن الحسين القاسم...(@)(@)(@@)(@@)(@@) $ النسابة:(@)(@)(@@) -احمد بن علي بن محمد بن أحمد بن علي الأعرج.(@)(@)(@@)(@@)(@@) $ النسابة: -علي بن عبد الحميد الحسيني.(@)(@)(@@)(@@)(@@) $ النسابة: -علي بن محمد بن احمد بن علي.(@)(@)(@@)(@@)(@@) $ نصرة بن صادق بن المجتبى.(@)(@)(@@) هو السيد تاج الدين نصرة بن كمال الدين صادق بن نظام الدين المجتبي ب