ms1	(@)(@)(@@) ![image filename](./0550Anonymous.HumayNama_0066.jpg)(@)(@)(@@) به نام آیزد دانا، توانا، بخشاینده، بخشا یشگر(@)(@@) ~~سپاس از خدایی که جان آفرید سپهر و زمین و زمان آفرید(@)(@@) (@@) خداییستروزی ده جانور %~% نموده سوی خود ره جانور(@)(@@) (@@) نیازشبجز آفریدن نبود %~% همیدون به مردم گزیدن نبود(@)(@@) (@@) همه چیز چون خواست خود آفرید %~% چنان کش ببایست هم برگزید(@)(@@) (@@) چرا آنکه بگزید بگزایدش %~% بکاهد گه و گه بیفزایدش(@)(@@) (@@) کرا راه این راز بسته شدست %~% ز چون و چرا دلش رسته شدست(@)(@@) (@@) به راز جهاندار راه تو نیست %~% درین ژرف دریا شناه تو نیست(@)(@@) (@@) جهان داور آن کرد کش خواست بود %~% نه کژ هرچه کردش همه راست بود(@)(@@) (@@) کند هرچه خواهد که کرد آنچه خواست به یاور نبودش نیاز و نه هست %~%(@)(@@) نبودش ز بن رنج آز و نه هست %~% که بر هرچه کرد و کند پادشاست(@)(@@) (@@) از آزست و از آرزو بی نیاز %~% نه اندر نشیبست و نه بر فراز(@)(@@) (@@) وزو نیست فارغ فراز و نشیب %~% نه نازش ز شادی نه رنج از نهیب(@)(@@) (@@) ز کژی و ز کاستی هست دور %~% صبورست در کار بنده صبور(@)(@@) ~~خداییست روزیده و دادگر نداند کس او را که چونست و چند که دور از(@)(@@) نیازست و از آرزو چو ما رشک و آزش زگیتی مدان %~% فرا آفریدست پست و بلند(@)(@@) %~% رون از گمانست و دور از فکر %~% به چیزی نیازش ز گیتی مدان %~% وزو آرزو راست بسته گلو4 5 PageV01P001(@)(@@) ![image filename](./0550Anonymous.HumayNama_0067.jpg)(@)(@)(@@) (@@) بدان کرد هستی وی از نیستی %~% همی تا تو بر هستیش ایستی(@)(@@) (@@) چرا هست او خود کند نیست باز %~% پس از نیستی هستی آرد فراز(@)(@@) (@@) ببندد در نیستی زان سپس %~% نیابد در نیستی هیچ کس(@)(@@) (@@) دهد جای نیکان به نیکان مدام %~% بدان را همان پای بندد به دام(@)(@@) (@@) بهشتست و دوزخ ورا دو سرای %~% به هر دو درون آدمیست را جای(@)(@@) (@@) کسی کو بود پاک و نیکوسرشت %~% دهد جای او جاودان در بهشت(@)(@@) (@@) همان را که بد باشد و بد گهر %~% کند 
ms2	 هاویه مسکنش بی مگر(@)(@@) (@@) گرت هست رای بهشت خدای %~% به گفتار بیغامبر او گرای(@)(@@) گفتار اندر ستایش محمد المصطفی علیه السلام(@)(@@) (@@) رسول خداوند گیهان خدیو %~% محمد که بست او ز ما دست دیو(@)(@@) (@@) فرسته جهان داور داد را %~% بکنده بن و بیخ بیداد را(@)(@@) (@@) بیاراسته گیتی از راستی %~% شده خوار ازو کژی و کاستی(@)(@@) (@@) به نیکی ازو خلق را دسترس %~% نه در دلش کژی نه در سر هوس(@)(@@) (@@) 3نهاد نکو زو پدید آمده %~% دلش بند دین را کلید آمده(@)(@@) ~~ره راست از رای او خاسته تن کژی از کار او کاسته(@)(@@) (@@) سوی دین همه خلق را راهبر %~% بداندیش اسلام را چاه بر 3(@)(@@) ~~به تیغ و سخن کرده اسلام راسترسیده به هر چیزش الهام راست(@)(@@) (@@) ازو خیره گشته سران عرب سروش آمده ز آسمان سوی او %~% دزم دل شده(@)(@@) کافران عرب %~% مه چاردهآ شب نه چون روی او(@)(@@) ~~ز هامون به گردون سواره شده سروش سپهرش نظاره شده(@)(@@) ~~سخن گفته بر عرش با یک خدای بداده خدایش همه کام و رای(@)(@@) (@@) نباشد پس از وی فرسته دگر %~% نه چون دینش دینی خجسته دگر(@)(@@) (@@) ز ما باد بر جان پاکش درود %~% فزونتر ز ریگ بیابان و رود PageV01P002(@)(@@) ![image filename](./0550Anonymous.HumayNama_0068.jpg)(@)(@)(@@) (@@) فری بر همه یاورانش تمام %~% که بودند یک یک پس وی امام(@)(@@) (@@) مگیراد کس را دل از آن ملال %~% که بازش نگیرد ترحم ز آل(@)(@@) گفتار اندر ستایش خرد(@)(@@) (@@) همی تا توانی خرد را ستای %~% که داده خرد راست خوبی خدای(@)(@@) (@@) خرد هست جان را چراغ بهشت %~% که یابد بدو بوی باغ بهشت(@)(@@) (@@) دو چشم روان از خرد روشن است %~% روان را ز تیر بلا جوشن است(@)(@@) (@@) شود از خرد جان همی رستگار %~% رساند خرد جان سوی کردگار(@)(@@) (@@) خرد هر دو گیتی به مردم دهد %~% بدو مردم از بند بسته رهد(@)(@@) (@@) به مردم خدایست داده خرد %~% ز بندست او را گشاده خرد(@)(@@) (@@) کرابیشتر جانش بینندهتر %~% دلش راه یزدان گزینندهتر(@)(@@) (@@) به یزدان رساند 
ms3	 خرد مرد را %~% که گمره نماند خرد مرد را4 20(@)(@@) (@@) 5 به آتش پرستی کنی رای به %~% به نزدیک آتش کنی جای به(@)(@@) (@@) نشاید بی آتش بر آسود هیچ %~% بود خانهها را ز آتش بسیچ(@)(@@) (@@) تموز آورد یاد کم توشه مرد %~% دریغ از تف مهر بایدش خورد(@)(@@) (@@) چنین است گردنده فصل جهان %~% که هست آشکارش ترا هر نهان(@)(@@) (@@) همان آدمی را ز طبع چهار %~% تنست ای شگفتی شده مایهدار(@)(@@) (@@) 5ز خون و ز صفرا و سودا بساز %~% بدن وز رطوبت نکردم دراز(@)(@@) (@@) که بی آز اندر جهان نیست کس %~% تنومند با آز بستست بس(@)(@@) (@@) مرا آز بیشست در شاعری %~% که هستم شده چیره بر شاعری PageV01P003(@)(@@) ![image filename](./0550Anonymous.HumayNama_0069.jpg)(@)(@)(@@) (@@) چنان خواندم از دفتر باستان %~% ز کرده به هم گفتهآ راستان(@)(@@) (@@) که بد شهریاری به شام اندرون %~% ز هر شاه لشکرش و کشور فزون(@)(@@) (@@) جوانمرد و دانا دل و پاک مغز %~% به هر کام بودش همه کار نغز(@)(@@) (@@) نبودش پسر کش نشستی به جای %~% همان اخترش زو بماندی به پای(@)(@@) (@@) چه شاهی که او را نباشد پسر %~% چه شاهی تهی مانده از برگ و بر(@)(@@) (@@) یکی دخترش بود مانند ماه %~% زره گرد ماهش ز مشک سیاه(@)(@@) (@@) به بالا چو بر رفتهآ سروی بلند %~% فروهشته بر ماه مشکین کمند(@)(@@) ~~به یاقوت سرخ اندرش در ناب ز یاقوت رخشنده در خوشاب(@)(@@) ~~دلش سنگ سخت و برش پرنیاننمایان ز بر گوهرش پرنیان4 32(@)(@@) ~~شب و روز با هم زموی و ز رویبود روز با شب گر از هیچ روی(@)(@@) (@@) به گشی طاووس و کبر پلنگ %~% شده پیشکارش بت چین و گنگ(@)(@@) (@@) دو چشمش دو نرگس خدنگیش خار %~% پراز سحرواز رنگ و خواب و خمار(@)(@@) (@@) لبش بسد شکر آمیغ بود %~% رخش ماه و زلف سیه میغ بود(@)(@@) (@@) پری را ز رخسار او رشک بیش %~% پری پیشکارش سزا بود بیش(@)(@@) (@@) به یک وادی اندر یکی قصر بود %~% درو جای آن فتنهآ عصر بود(@)(@@) (@@) سرش بر ثریا و بن 
ms4	 در ثری %~% نبد شاه را دز چنان دیگری(@)(@@) (@@) ز مادر چو زاد او ورا شهریار %~% به خوش نام خواندش گل کامکار PageV01P004(@)(@@) ![image filename](./0550Anonymous.HumayNama_0070.jpg)(@)(@)(@@) (@@) در آن دز یکی دایه و ده کنیز %~% بدو هرچه بایست از برگ نیز(@)(@@) (@@) پدر هر به ده روز رفتی برش %~% گهر شاندی بر سر و افسرش(@)(@@) (@@) برو نام یزدان بخواندی بسی %~% نبودی برش راه دیگر کسی(@)(@@) (@@) گرامیتر آن دختر از جانش بود %~% همه کرده کشور به فرمانش بود(@)(@@) (@@) نبردی ز مردان کسش پیش نام %~% ز مردان نبد یافته هیچ کام(@)(@@) (@@) پدر بود دیده ورا روی و بس %~% ز مردان و دیگر نبد دیده کس(@)(@@) (@@) بدین دز درون بود تا سال بیست %~% چنان چون همی خواست آنجای زیست(@)(@@) (@@) به هر هفته از دز به بام آمدی %~% به دیدار هامونش کام آمدی(@)(@@) (@@) بگشتی بر آن بام دز بر نه دیر %~% پس آنگاه از افراز رفتی بزیر(@)(@@) (@@) چنان پارسا بود و پاکیزه رای %~% کزو بد سرافگنده هر پارسای* «ل(@)(@@) (@@) زنان را کجا پارسایی بود %~% بسی بهتر از پادشایی بود(@)(@@) (@@) هرآن زن که او پارسایی گزید %~% چنان دان که او پادشایی گزید(@)(@@) (@@) زن از پارسایی شود نامور %~% بدانسان که مرد جوان از هنر(@)(@@) (@@) گل کامکار آن گزین دخت شاه %~% شد از پارسایی سزاوار گاه(@)(@@) (@@) بدان دز درون خرم و شاد بود %~% ز اندیشه و انده آزاد بود(@)(@@) (@@) ز مردان نیامد ورا یاد هیچ %~% به مردان نبودی دلش شاد هیچ(@)(@@) (@@) همی تا برآمد بدین روزگار %~% به مصر اندرون بود یک شهریار(@)(@@) (@@) ورا یک پسر بود نامش همای %~% به سر برش سایه فگنده همای(@)(@@) (@@) جوانمرد بود و هنرمند بود %~% نکو روی بود و خردمند بود(@)(@@) (@@) به مردی و خوبی همالش نبود %~% گذشته بجز بیست سالش نبود(@)(@@) (@@) شب و روز کارش نبد جز شکار %~% همی گشت اندر جهان هاموار(@)(@@) (@@) به روم و به توران و ایران زمین %~% بگشت و به هندوستان و به چین(@)(@@) (@@) مگر یابد او دختری را همال %~% که دیدار داردش 
ms5	 فرخ به فال(@)(@@) (@@) ز دخت شهان چون نشانی نیافت %~% عتان از سوی کشور شام تافت(@)(@@) (@@) ازو چون خبر شد بر شاه شام %~% %~% پذیره شدش با سپاهی تمام(@)(@@) ~~به شهر دمشقش فرود آورید بجز در خور تاج و گاهش ندید PageV01P005(@)(@@) ![image filename](./0550Anonymous.HumayNama_0071.jpg)(@)(@)(@@) (@@) سرایی خوشش داد همچون بهشت %~% سرایی چو باغی در اردیبهشت(@)(@@) (@@) بدو اندرون باغ و آب روان %~% که از دیدنش تازه گشتی روان4 42(@)(@@) (@@) همه باغ او پر گل و لاله بود %~% گل و لالهش از ابر پر ژاله بود(@)(@@) (@@) در آن باغ در می گرفتی همای %~% در آن باغ بودش شب و روز جای(@)(@@) (@@) هشدی شاد هر روز سوی شکار %~% که بودی شکارش همه روز، کار(@)(@@) (@@) چو جان داشتی شاه شامش مدام %~% به رویش بدی شادمان شاه شام(@)(@@) (@@) چنان کردی اندیشه کین شاهزاد %~% ندارد به دل در بجز راه داد(@)(@@) (@@) تدیدم چنین پر هنر یک پسر %~% نباشد چنین یک پسر پرهنر(@)(@@) (@@) سزاوار این جفت دخت منست %~% که خورشید رویست و سیمین تنست(@)(@@) (@@) ولیکن چه سودست کان دلربای %~% نیارد به مردان همی کام و رای(@)(@@) (@@) برش نام مردان نیارند برد %~% چو بردند سرشان بباید سپرد(@)(@@) (@@) من این را بدارم بسی روزگار %~% بود کز پی دشمن آید به کار(@)(@@) (@@) دهم گنج تا بخشد و خوش خورد %~% ازو نام در کشورم گسترد(@)(@@) (@@) مگر دخترم زو بدارد خبر %~% شود جفت این نام گستر پسر(@)(@@) (@@) بفرمود گنجور را تا ز گنج %~% دهد هرچه خواهد ندارد به رنج(@)(@@) (@@) برین سال بگذشت چون پنج شش %~% پسر را همی بود با شاه خوش(@)(@@) (@@) نکرد از پسر نزد دخترش یاد %~% شه ارچند بود از پسر گشته شاد(@)(@@) (@@) که رشک آمدش یاد کردن از اوی %~% سخنها بر دختر نامجوی(@)(@@) (@@) دگر کش ز دختر همی شرم بود %~% سخن مرد را دخت خودکی شنود(@)(@@) (@@) قضا را یکی روز وقت سحر %~% همای از در شهر شد بی خبر «!(@)(@@) (@@) به نخچیر گاهی که بد نزد دز %~% نرفته درو هیچ مردم هگرز(@)(@@) (@@) بی اندازه 
ms6	 نخچیر بود اندر اوی %~% ز هر سو گوزنان شده پوی پوی(@)(@@) (@@) چو آن روز شد تا بدانجا همای %~% یکی جای دید او عجب دلگشای(@)(@@) (@@) شده تیز رفتار گاو و گوزن %~% بیفگند بسیار گاو و گوزن(@)(@@) (@@) چو شد مانده و تشنه از آفتاب %~% به سایه گرایید دل پر ز تاب(@)(@@) (@@) به در بود نزدیک راند اسپ تیز %~% چه اسپی که چون باد شد نیم خیز PageV01P006(@)(@@) ![image filename](./0550Anonymous.HumayNama_0072.jpg)(@)(@)(@@) (@@) چو نزدیکی بارهآ دز رسید %~% فرود آمد و یک زمان آرمید(@)(@@) (@@) در دز چنان دید بسته که سنگ %~% به سایه بر باره کردش درنگ(@)(@@) (@@) کلاه کیانی نهاد او ز سر %~% بنزدیک دز بد یکی آبخور(@)(@@) (@@) برفت و ز آن آب لختی بخورد %~% به جای آمد و یک زمان تکیه کرد(@)(@@) (@@) ستورش یکی شنه برداشت سخت %~% که لرزید ازو دز بسان درخت(@)(@@) (@@) گل کامکارش چو شنه شنید %~% برآمد به بام و مر او را بدید(@)(@@) (@@) بکی دست بالین خود کرده بود %~% دو چشمش همی هر زمان میغنود(@)(@@) (@@) ز بام اندرون چون گل کامکار %~% رخی دید وی را چو چینی نگار(@)(@@) (@@) دمیده شده سنبل از سنبله %~% همان پایکوبش به گل بر گله(@)(@@) (@@) سر هر دو زلف سیه نیم تاب %~% دو نرگس همیدون شده نیم خواب(@)(@@) (@@) گل روی خوبش چو قطرهآ گلاب %~% پر از خوی نمود از تف آفتاب(@)(@@) (@@) بدانسان مر او را چو دختر بدید %~% لب از رشک رویش به دندان گزید* 52(@)(@@) (@@) فرو فتنه شد دل ورا در زمان %~% پری برد وی را ز خوبی گمان(@)(@@) (@@) همی گفت نیست آدمی این پریست %~% مرا کرده از جان و از دل بریست(@)(@@) (@@) دو چشمش دو جادوست با دوکمان %~% زنان تیر بر جان ودل هر زمان(@)(@@) (@@) بدین جایگاه از کجا آمدست %~% که ما را ز عشقش بلا آمدست(@)(@@) (@@) مرا در دل از وی چنان عشق خاست %~% که جانم شود گر به عشقش رواست(@)(@@) (@@) نبد نزد من قیمت هیچ مرد %~% نه از مرد کس پیش من یاد کرد(@)(@@) (@@) ندانم 
ms7	 چه مرد است این خوب چهر %~% کزو در دل من بگسترد مهر(@)(@@) (@@) اگر نیست رویم نموده پری %~% توان کرد با عشق او داوری(@)(@@) (@@) بپرسم ورا تا چه مردست وی %~% که بر تن شدم خون ز خوبیش خوی(@)(@@) (@@) از عشقش مرا در دل آمد نهیب %~% ندانم ز عشقش فراز از نشیب(@)(@@) (@@) از آن پس کم از مرد ننگ آمدی %~% جهان بر من از مرد تنگ آمدی(@)(@@) (@@) شدم عاشق مردی از یک نظر %~% چه خواهد گذشتن مرا زو به سر(@)(@@) (@@) همی کردش اندیشه با دل چنین %~% که در خواب خوش شد همای گزین(@)(@@) (@@) گل کامکار آمد از بام زیر %~% زمانی همی بود بر جای دیر PageV01P007(@)(@@) ![image filename](./0550Anonymous.HumayNama_0073.jpg)(@)(@)(@@) (@@) دل خویشتن را همی پند داد %~% چو نشنود رفت او در دز گشاد(@)(@@) (@@) گشاده دو رخ رفت نزد همای %~% سر گیسوانش رسیده به پای(@)(@@) (@@) به آواز گفت ای به خواب اندرون %~% که بودت بدین جایگه رهنمون(@)(@@) (@@) چرا آمدی نزد این دز فراز %~% به چه چیز بودت ازین دز نیاز4 5(@)(@@) (@@) همای این چو بشنید بر کرد سر %~% چمان سرو دید آفتابش زبر(@)(@@) (@@) نگه کرد سوی گل کامکار %~% گلش دید بر رخ شکفته به بار(@)(@@) (@@) رخش چون مه چارده شب نمود %~% به پای آمد و رقتش از پیش زود(@)(@@) (@@) ببوسید سد راه پیشش زمین %~% ورا گفت ایا تو ز خوبان گزین(@)(@@) (@@) منم راه گم کرده مردی جوان %~% فتادستم از راه وز کاروان(@)(@@) (@@) بدین دز رسیدم چو ناگه فراز %~% ز خورشید بودم به سایه نیاز(@)(@@) (@@) بد از تشنگی کام من کافته %~% جگر بودم از تشنگی تافته(@)(@@) (@@) بخوردم ازین آبگیر آب سیر %~% بخفتم زمانی درین سایه دیر(@)(@@) (@@) به خوش خواب در بودم از تو به گوش %~% رسیدم چو گفتار خوشتر ز نوش(@)(@@) (@@) سر از خواب برکردم اندرزمان %~% ترا دیدم از سر شدم هش رمان(@)(@@) (@@) که چون روی تو ماه بر چرخ نیست %~% ز خوبی ترا جز همه برخ نیست(@)(@@) (@@) به بالا و رفتار کبکیی و سرو %~% به رخساره 
ms8	 و موی مشکی و پرو(@)(@@) (@@) پرئ دختری یا بت حور زاد %~% نگویی مرا تو ز نام و نژاد(@)(@@) (@@) چه خوانم ترا ماه یا مشتری %~% که هستت مه و مشتری مشتری(@)(@@) (@@) غریبم ببخشای بر جان من %~% ممان جان من تا برآید ز تن(@)(@@) (@@) که گر بازگردی ز پیشم بزار %~% برآید ز تن جان من زینهار(@)(@@) (@@) بگفت این و لرزید چون برگ بید %~% دلش گشته از جان شیرین نمید(@)(@@) (@@) دل دختر شاه بر وی بسوخت %~% به شیرین زبانی دلش بر فروخت4 52(@)(@@) (@@) ورا گفت ای رادمرد جوان %~% به دز در گر آیی مرا میهمان(@)(@@) (@@) نرا باز گویم که من کیستم %~% درین دز پناه از پی چیستم(@)(@@) (@@) بگفت و درون شد به دز همچو باد %~% همه راز بر دایهآ خود گشاد(@)(@@) (@@) فرستاد هم در زمان دایه را %~% که آورد زود آن گرانمایه را PageV01P008(@)(@@) ![image filename](./0550Anonymous.HumayNama_0074.jpg)(@)(@)(@@) (@@) درآمد چو از در همای گزین %~% ببوسید سد بار دیکر زمین(@)(@@) (@@) بشد دختر شاه و دستش گرفت %~% نشاندش به پر مایه جای شگفت(@)(@@) (@@) ز دو پای کردش برون موزه زود %~% همی هر زمان روی و مویش ستود(@)(@@) (@@) بفرمود جلاب و پس خوان نهاد %~% به خوان بر چو خوالیگرش نان نهاد(@)(@@) (@@) بیاورد هر خوردنی بیش و کم %~% بخوردند چون نان دو عاشق به هم(@)(@@) (@@) یه می دست بردند و می خواستند %~% شهانه یکی مجلس آراستند(@)(@@) (@@) بپرسید باز از سمنبر همای %~% که بس خوب داری درین قلعه جای(@)(@@) (@@) بهشت برین را همی ماند این %~% چنین است گویی بهشت برین(@)(@@) (@@) مرا گفت باید ترا از نژاد %~% به من بر همه راز خویشت گشاد(@)(@@) (@@) که تا چون پرستم ترا بر چه سان %~% بگوی از نژادم تو نام و نشان(@)(@@) (@@) بت ماهآ چهره نژادش بگفت %~% نماندش ازین روی رازی نهفت(@)(@@) (@@) همای دلاور همه راز خویش %~% همیدون همه گفت هر کم و بیش(@)(@@) (@@) پس آنگه ببوسید گلروی را %~% چنین گفت دلبر سمنبوی را(@)(@@) (@@) که باید مرا رفت پیش پدرت %~% که هستم من امروز خویش 
ms9	 پدرت2 د5(@)(@@) (@@) شب آیم دگر نزد تو ماهروی %~% که روز آمدن ایدرم نیست روی(@)(@@) (@@) بوم هر شبی نزد تو تا سحر %~% سحرگه روم زود نزد پدر(@)(@@) (@@) که من نیستم ناجوانمرد کس که نان و نمک را حقش بر منست %~% ز تو(@)(@@) مرمرا بوس و دیدار بس %~% برش اعتقاد دلم روشنست(@)(@@) (@@) پسندید دختر هرآنچ او بگفت %~% ز شادی رخش همچوگل برشکفت(@)(@@) (@@) زمین بوس کرد و برون شد همای %~% هم آنگه به اسپ اندر آورد پای(@)(@@) (@@) گه شام در شهر شد دل دژم %~% نزد با کس از این به گفتار دم(@)(@@) (@@) هم از گرد ره سوی شه رفت تیز %~% شه آنگاه شد مر ورا نیم خیز(@)(@@) (@@) بپرسیدش از راه وز صیدگاه %~% ببوسید بس وی زمین پیش شاه(@)(@@) (@@) به شه گفت امروز دیر آمدم %~% ز بس رنج از صید سیر آمدم(@)(@@) (@@) نخواهم دگر رفت سوی شکار %~% پری تا نبینم مگر آشکار(@)(@@) (@@) به صیدم درون رخ نماید پری %~% کسدم ارر در زمان جان بری PageV01P009(@)(@@) ![image filename](./0550Anonymous.HumayNama_0075.jpg)(@)(@)(@@) (@@) 2،5همه روز با تو خورم من شراب %~% شب آید گرایم سراز سوی خواب(@)(@@) (@@) مرا دیدن تو به از دو جهان %~% که هستی گرامی مرا همچو جان(@)(@@) (@@) ز بهرم فدا کردهای خواسته %~% ز من شد همه گنج تو کاسته(@)(@@) (@@) به جای من آن کردی از مردمی %~% که آن کرد نتواند ایچ آدمی(@)(@@) (@@) شهش گفت آن کن کجا بایدت %~% که در دل ازو شادی افزایدت(@)(@@) (@@) 2فتاده چو بر سرت نام منست %~% چنان دان که کام تو کام منست4 2(@)(@@) (@@) بر من گرامی تری از روان %~% مبادا تتت یک زمان ناتوان(@)(@@) (@@) به آرامگه شو که هستی نژند %~% ز نخچیرگاه ای یل دیوبند(@)(@@) (@@) زمین را ببوسید سد ره همای %~% بشد تا همانجا کجا بدش جای(@)(@@) (@@) کنیزی بدی مونسش روز و شب %~% بیامد گشاده به خنده دو لب(@)(@@) (@@) 1بدو گفت امروز دیر آمدی %~% ز نخچیرگه همچو شیر آمدی(@)(@@) (@@) نگویی سخن باکس از خشم وکین %~% مگر شیر افگندهای از کمین(@)(@@) (@@) ورا گفت امروز گشتم 
ms10	 دژم %~% دل من از آن روی شد جفت غم(@)(@@) (@@) که دیدم پری را به نخچیرگاه %~% دلم را به دیدار برد او ز راه(@)(@@) (@@) ز نخچیر بس کردم از این سبب %~% خورم باده هر روز تا گاه شب(@)(@@) (@@) 22شب اندر شبستان بخسپم به کام %~% نباید که جایی بمانم به دام(@)(@@) (@@) پس آنگاه گفتا که من ماندهام %~% همه روز نیز اسپ را راندهام(@)(@@) (@@) بباید غنودن شب دیر یاز %~% نه می خواهم و نه بت رود ساز(@)(@@) (@@) همانگاه رفت از سوی جای خواب %~% به روی گل کامکارش شتاب(@)(@@) (@@) نبد روی رفتنش نزدیک او %~% فروزان نشد رای تاریک او(@)(@@) (@@) 22به بستر بر بود پیچان چو مار %~% تو گفتی مگر بسترش بود خار(@)(@@) (@@) ز پیچیدن و ناله ناسود هیچ %~% وز اندیشه تا روز نغنود هیچ(@)(@@) (@@) رمیده بود خواب عاشق ز چشم %~% بود خواب با چشم عاشق به خشم(@)(@@) (@@) کجا خواب یابد دو چشم کسی %~% که بر دل بود بار عشقش بسی4(@)(@@) (@@) به آب و به آتش درون کس نخفت %~% که با این دو هرگز نشد خواب جفت(@)(@@) (@@) سحرگه چو بر زد سر از چرخ مهر %~% بزز آب بندود روی سپهر PageV01P010(@)(@@) ![image filename](./0550Anonymous.HumayNama_0076.jpg)(@)(@)(@@) (@@) پرون آمد از خانهآ خود همای %~% بر شاه شد شه نشاندش به جای(@)(@@) (@@) بفرمود شه خوان که خوالیگران %~% نهادند و خوردند نان سروران(@)(@@) (@@) به می دست بردند و بودند شاد %~% به باده جهان را شمردند باد(@)(@@) (@@) چنان برشد آوای خنیاگران %~% که کردند می آرزو اختران(@)(@@) (@@) همی خورد می فرخ اختر همای %~% دلش داشت شب را به دلدار رای(@)(@@) (@@) میش کارگر نامد از عشق یار %~% همی خورد تا شد ز شب روز تار(@)(@@) (@@) چو شب قیرگون جامه در سر کشید %~% ازو روز شد دامن اندر کشید(@)(@@) (@@) برون آمد از پیش شه ناگهان %~% همای و شد از سوی خانه نهان(@)(@@) (@@) یکی اسپ بگزید و بر کرد زین %~% چه اسپی که بودش ز اسپان گزین(@)(@@) (@@) برو برنشست و برون شد ز شهر %~% نبد با روانش جز 
ms11	 از مهر بهر(@)(@@) (@@) ره دز گرفت و براند اسپ تیز %~% ز غم در دلش خاسته رستخیز(@)(@@) (@@) چو اسپش بنزدیکی دز رسید %~% یکی شنه یکره دگر برکشید(@)(@@) (@@) دگرباره زان شنه آگاه شد %~% نگارین و بر بام چون ماه شد(@)(@@) (@@) شب تیره را روشنی روز داد %~% رخش روشنایی دل افروز داد(@)(@@) (@@) 2همای هنرپیشه را دید زیر %~% پیاده شده زاسپ چون شرزه شیر(@)(@@) (@@) بزیر آمد از بام خود در گشاد %~% دلش گشت از روی دلدار شاد4 12(@)(@@) (@@) همای هنرمند شادی فزود %~% گل کامکارش لطافت نمود(@)(@@) (@@) به بر در گرفتش سوی خانه برد %~% نشستنگه خویش او را سپرد(@)(@@) (@@) بفرمود خوان را گل کامکار %~% نهادن سزاوار از بهر یار(@)(@@) (@@) 25چو خوان اسپری گشت می خواستند %~% دگرباره مجلس بیاراستند(@)(@@) (@@) به بوسه ز لبها بجستند کام %~% ولیکن نزاندند کامی تمام(@)(@@) (@@) مزیدند یاقوت شکر فروش %~% گرفتند بهره ز ناز و ز نوش(@)(@@) (@@) نگشتند گرد در رای دیو %~% از ایشان نیازرد گیهانخدیو(@)(@@) (@@) درازی شب شد چو کوته به می %~% همای همایون فرخنده پی(@)(@@) (@@) 251 برون آمد و اسپ را برنشست %~% سوی شهر راندش چو آذرگشسپ؟(@)(@@) (@@) فرود آمد و رفت در خانه زود %~% سوی خوابگه شد نهانی غنود PageV01P011(@)(@@) ![image filename](./0550Anonymous.HumayNama_0077.jpg)(@)(@)(@@) (@@) ندانست کس از شدن و آمدنش %~% نهانی بماند آمدن چون شدنش(@)(@@) (@@) بدینسان همی رفت هر شب به راه %~% نهانی ز شاه و ز خویشان شاه(@)(@@) (@@) پس آنگاه روزی مگر شاه شام %~% بر دختر خویش شد شادکام(@)(@@) (@@) ورا دید گلنار چون شنبلید %~% دل شه چو مرغی ز بر بر پرید(@)(@@) (@@) بپرسید و گفت ای گل کامکار %~% چرا زردآ رویی و کرده نهار(@)(@@) (@@) رسیده گرت هست دردی بگوی %~% به درمانش تا من شوم چاره جوی(@)(@@) (@@) بخوانم پزشکان ز هر کشوری %~% که درمان بدانند از هر دری(@)(@@) (@@) مرا در جهان نیست جز تو کسی %~% که نامم ازو زنده ماند بسی 55(@)(@@) (@@) 226 گرامیترم نیست از تو روان %~% ز تو هست همواره بختم جوان(@)(@@) (@@) مرا بازگویی اگر درد خویش %~% سزد کم دل از درد 
ms12	 تو هست ریش(@)(@@) (@@) بدو گفت دختر که ای شهریار %~% به کام تو بادا همه روزگار(@)(@@) (@@) تو بادی دل افروز و دل شادکام %~% به فرمان تو هفت کشور تمام(@)(@@) (@@) چنان دان که بر تن مرا تب رسید %~% تبم چندگاهی همه شب رسید(@)(@@) (@@) از آن شد مرا گونهآ روی زرد %~% که تن مرمرا تب همه رنجه کرد(@)(@@) (@@) کنون چون بدیدم فر روی شاه %~% شوم کوهی ارچه شدستم چوکاه(@)(@@) (@@) مدار از من اندیشه در دل دگر %~% ز بهرم ازین بیش انده مخور(@)(@@) (@@) که هستم شده من کنون تندرست %~% بدم گرچه یکچند بیمار و سست(@)(@@) (@@) ازو این چو بشنید شه در زمان %~% ورا رخ ببوسید و شد شادمان(@)(@@) (@@) 2ز دیدار دختر چو برداشت بهر %~% برون آمد و شد دگر ره به شهر(@)(@@) (@@) بیامد همای گزین را بخواند %~% بر خویش نزدیک تختش نشاند(@)(@@) (@@) همه راز دختر بدو باز گفت %~% نماند از همای هنرور نهفت(@)(@@) (@@) پس آنگه ورا گفت فرخ همای %~% که ای شاه دانادل نیکرای(@)(@@) (@@) به جای پسر دختر آید اگر %~% بود پارسا به ز سیسد پسر(@)(@@) (@@) چو با پارسایی بود دخت یار %~% پدر زو شود بی شکی بختیار(@)(@@) (@@) پدر را غم دختر افزون بود %~% دل از درد دختر پر از خون بود(@)(@@) (@@) فروزنده آن شاه را اخترست %~% که او را به دل در غم دخترست 5a PageV01P012(@)(@@) ![image filename](./0550Anonymous.HumayNama_0078.jpg)(@)(@)(@@) (@@) ولیکن چو شد دخت زیبا بزرگ %~% ببایدش شوهر دلیر و سترگ(@)(@@) (@@) به خانه چرا دخت دارند دیر %~% چو شد زن دل از مهر او کن تو سیر(@)(@@) (@@) ترا جفت دختر بباید گزید %~% که زن ایزد از بهر مرد آفرید(@)(@@) (@@) بداند هر آنکس که باشد هژیر %~% که زن را ز شوهر نباشد گزیر(@)(@@) (@@) خردمند شاهی و بیدارتر %~% درین کار بنگر تو هشیارتر(@)(@@) (@@) شهش گفت باز ای خردمتد مرد %~% بدیدی بس اندر جهان گرم و سرد(@)(@@) (@@) همه راست گفتی به دانش سخن %~% تو اندیشه کردی ز رای کهن(@)(@@) (@@) بر دختر خود روم من چو باز %~% بگویم که اندر 
ms13	 جهان جفت ساز(@)(@@) (@@) که بی جفت مادر ترا زاده نیست %~% هنرمند بی جفت آزاده نیست(@)(@@) (@@) بگفت این و خوان خواست و می خواست باز %~% همی بود با باده و روذ ساز(@)(@@) (@@) نه چونان همای گزین خورد می %~% که بر دانش او ستم کرد می(@)(@@) (@@) ز ناگفتنیها زبان بسته داشت %~% چه گر دل ز تیر هوا خسته داشت(@)(@@) (@@) خنک بر کسی کو هوا آزمود %~% که بر سر ستم از زبانش نبود(@)(@@) (@@) به عشق اندرون مست چون بست لب %~% بود ایمن از سرزنش روز و شب(@)(@@) (@@) چنان دان که پیوسته اندر نبید %~% زبانست بند سخن را کلید(@)(@@) (@@) گشاید سخن چون زبانت ز بند %~% سرت زو به جان یابد و تن گزند(@)(@@) (@@) بر مهتران چون می افزون خوری %~% زبان را بود با سرت داوری(@)(@@) (@@) همای همایون چنان خورد می %~% که سر از زبانش نیازرد می4 0(@)(@@) (@@) بخورد و برفت از بر شاه شاد %~% بیامدن غنود از بر گاه شاد(@)(@@) (@@) چو پاسی گذشت از شب دیریاز %~% به دیدار دلبندش آمد نیاز(@)(@@) (@@) سر از خواب برکرد و آمد به در %~% نهاد از بر اسپ خود زین زر(@)(@@) (@@) درآورد با ساز در اسپ پای %~% ز دروازه شد باز بیرون همای(@)(@@) (@@) 3.5 نگهبان دروازه بردی گمان %~% که نخچیر را بسته دارد میان(@)(@@) (@@) دگر کش درم بیش دادی همای %~% چو شب رفتن از شهر بودیش رای(@)(@@) (@@) چو بر راه دز راند شهزاده تیز %~% ز پیشش گوزنی بجست از نخیز(@)(@@) (@@) سبک خیز کرد اسپ را از پسش %~% به دشتی که نه خار بد نه خسش PageV01P013(@)(@@) ![image filename](./0550Anonymous.HumayNama_0079.jpg)(@)(@)(@@) (@@) شبی بد ز مهتاب مانند روز %~% چو روی همای گزین دلفروز(@)(@@) (@@) 2 همی شد گوزن و همی راند شاه %~% به راندن درون شاه گم کرد راه(@)(@@) (@@) رسید او به کوهی سر اندر سپهر %~% که بد سرش گفتی پر از ماه و مهر(@)(@@) (@@) برو آتشی دید افروخته %~% سیاهی شب زو شده سوخته(@)(@@) (@@) نهان شد بر که گوزنش ز چشم %~% بتازید نزدیک آتش به 
ms14	 خشم(@)(@@) گفتار اندر جنگ همای با زنگی برکوه(@)(@@) (@@) بر آتش او زنگیی دید مست %~% یکی طاس ده من درو می به دست(@)(@@) (@@) نشسته دو چندان که کوهی ز قار %~% ازو دیو پنهان شده در دهار(@)(@@) (@@) سری راست مانند دیگی کلان %~% دو بینی ز دوزخ دو راه دخان(@)(@@) (@@) بزیر لب سهمناک و ستبر %~% درفشنده دندانش چون برق از ابر 10a(@)(@@) (@@) همه موی تار سرش پر گره %~% بکردارزنگار خوردهزره(@)(@@) (@@) بر انگشت ناخن چو بر ساج عاج %~% چو الماس عاج وچو انقاس ساج(@)(@@) (@@) 2دو پایش چو دو آبنوسین ستون %~% گهی بر سرش مهتر از بیستون(@)(@@) (@@) چو شهزاده را دید برجست زود %~% چو دودی و تیغی چو آتش ربود(@)(@@) (@@) دوید و برآورد تا برزند %~% به شهزاده و سرش را بفگند(@)(@@) (@@) همای دلاور سپر پیش داشت %~% ز سر زخم شمشیر زنگی بگاشت(@)(@@) (@@) بزد نعرهای زنگی دیوچهر %~% که لرزنده شد زو زمین و سپهر(@)(@@) (@@) 32 ز بانگش که و سنگ ریزنده گشت %~% دد و دام هر سو گریزنده گشت(@)(@@) (@@) چنان در فتادش به که بانگ تیز %~% که بانگ دم صور در رستخیز(@)(@@) (@@) بترسید از آن بانگ فرخ همای %~% نهادن نیارستش از پیش پای(@)(@@) (@@) به دل گفت زار اوفتادم به دام %~% ازین بود بیمم به دل در مدام(@)(@@) (@@) که جایی بپیچم من از بدکنش %~% به پستی گرایم ز بالا منش(@)(@@) (@@) 23نه نامست با دشمنم در نبرد %~% نه شایم گریزنده شد زو به درد PageV01P014(@)(@@) ![image filename](./0550Anonymous.HumayNama_0080.jpg)(@)(@)(@@) (@@) ه کام نهنگ اندرون ماندهام %~% بلا را به چنگ اندرون ماندهام(@)(@@) (@@) رهایی اگر یابم از چنگ دیو %~% به من بر ببخشود گیهان خدیو(@)(@@) (@@) وگرنه دریغا جوانی و عشق %~% همیدون همه کامرانی و عشق(@)(@@) (@@) دریغا گل کامکارگزین %~% کجا نیست آگه نگارم ازین(@)(@@) (@@) ز من تا در مرگ گامیست راه %~% تبه گشت خواهم بخیره تباه0b 3(@)(@@) (@@) به خاک افگند زنگی از زین مرا %~% که خواهد پس از من ازوکین مرا(@)(@@) (@@) همی گفت با خود همی ریخت آب %~% ز دو دیده بر روی چون آفتاب 
