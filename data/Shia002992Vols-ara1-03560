ms3546	 7، ح 1472.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 3، ك 4، ب 80، ح 11، و ج 5، ك 3، ب 70، ح 2. والتهذيب: ج 7، ح 1706.(@)(@@) * وروى عن محمد بن خالد، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 6، ب 53، ح 14.(@)(@@) * وروى عن محمد بن سرو، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 5، ح 570 (الاستبصار:(@)(@@) ج 2، ج 865).(@)(@@) * وروى عن محمد بن عبد الحميد، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 91.(@)(@@) * وروى عن محمد بن عيسى، وروى PageV11P460(@)(@@) عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 104، ح 2.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 6، ب 81، ح 4، و ب 121، ح 4 و 5، و ب 126، ح 1، و ب 127، ح 2.(@)(@@) * وروى عن موسى بن عمر البصري، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 7، ح 1339.(@)(@@) * وروى عن يعقوب بن يزيد، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 6، ب 106، ح 1، وك 7، ب 7، ح 6.(@)(@@) * وروى عن السياري، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 7، ب 31، ح 4، وك 8، ب 61، ح 1.(@)(@@) * وروى مضمرة، وروى عنه محمد ابن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 1403 (الاستبصار:(@)(@@) ج 4، ح 610، وفيه محمد بن يحيى العطار، عن عبد الله بن جعفر، عن أبي محمد (عليه السلام)، والاختلاف في الراوي لعله من باب اختلاف الطريق).(@)(@@) * وروى مرفوعا عن أبي عبد الله (عليه السلام)، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 6، ب 80، ح 7.(@)(@@) عبد الله بن جعفر الحميري * روى عن أبي محمد الحسن بن علي العسكري (عليه السلام).(@)(@@) الفقيه: ج 3، ح 1471.(@)(@@) * وروى عن أبي محمد الحسن بن علي (عليه السلام).(@)(@@) الفقيه: ج 3، ح 1529.(@)(@@) * وروى عن أبي عمرو (العمري)، وروى عنه محمد بن عبد الله، ومحمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 76، ح 1.(@)(@@) * وروى عن إبراهيم بن مهزيار.(@)(@@) الكافي: ج 1، ك 4، ب 117، ح 6.(@)(@@) * وروى عن إبراهيم بن هاشم، وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى إبراهيم بن هاشم وروى عنه والد الصدوق (رحمه الله) مشيخة الفقيه: في طريقه إلى أبي همام، PageV11P461(@)(@@) إسماعيل بن 
ms3547	 همام، وفي طريقه إلى إبراهيم بن هاشم.(@)(@@) * وروى عن أحمد بن أبي عبد الله، وروى عنه والد الصدوق.(@)(@@) مشيخة الفقيه: في طريقه إلى محمد بن حكيم.(@)(@@) * وروى عن أحمد بن أبي عبد الله البرقي، وروى عنه محمد بن الحسن والد الصدوق.(@)(@@) مشيخة الفقيه: في طريقه إلى حكم بن حكيم ابن أخي خلاد.(@)(@@) * وروى عن أحمد بن إسحاق أبي علي، وروى عنه محمد بن عبد الله، ومحمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 76، ح 1.(@)(@@) * وروى عن أحمد بن محمد بن عيسى، وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى الحسن بن محبوب، ومصادف.(@)(@@) وروى عنه والد الصدوق (قدس سره) مشيخة الفقيه: في طريقه إلى عبد الله ابن بكير ومعاوية بن ميسرة، ومعمر ابن يحيى، وخالد بن نجيح، ومنصور بن يونس، وأبي همام إسماعيل بن همام.(@)(@@) * وروى عن أحمد بن محمد بن عيسى الأشعري، وروى عنه محمد بن الحسن، ووالد الصدوق.(@)(@@) مشيخة الفقيه: في طريقه إلى أحمد بن محمد بن عيسى الأشعري.(@)(@@) * وروى عن أحمد بن محمد بن مطهر، وروى عنه محمد بن الحسن، ووالدي الصدوق.(@)(@@) مشيخة الفقيه: في طريقه إلى أحمد بن مطهر.(@)(@@) * وروى عن أيوب بن نوح الحلبي.(@)(@@) الفقيه: ج 3، ح 1305.(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى محمد بن علي الحلبي.(@)(@@) وروى عنه محمد بن الحسن بن أحمد بن الوليد.(@)(@@) مشيخة الفقيه: في طريقه إلى هشام بن سالم.(@)(@@) وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى محمد بن علي الحلبي وروى عنه والد الصدوق (قدس سره) مشيخة الفقيه: في طريقه إلى هشام بن PageV11P462(@)(@@) سالم، ومحمد بن علي الحلبي، وعبد الله ابن سنان.(@)(@@) * وروى عن الحسن بن ظريف، وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه محمد بن الحسن بن أحمد ابن الوليد.(@)(@@) مشيخة الفقيه: في طريقه إلى هشام بن سالم.(@)(@@) وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في 
ms3548	 طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى هشام بن سالم، وإلى زرارة بن أعين، وإلى حريز ابن عبد الله، وإلى حماد بن عيسى.(@)(@@) * وروى عن الحسن بن مالك.(@)(@@) الفقيه: ج 3، ح 1301، و ج 4، ح 605.(@)(@@) * وروى عن علي بن إسماعيل، وروى عنه محمد بن الحسن، ومحمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى إسحاق بن عمار.(@)(@@) * وروى عن علي بن إسماعيل بن عيسى، وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى زرارة بن أعين، وحريز بن عبد الله، وحماد بن عيسى.(@)(@@) * وروى عن علي بن الحكم، وروى عنه محمد بن الحسن، ووالد الصدوق.(@)(@@) مشيخة الفقيه: في طريقه إلى علي بن سويد.(@)(@@) * وروى عن علي بن الريان بن الصلت، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 5، ح 701 (الاستبصار:(@)(@@) ج 2، ح 946).(@)(@@) * وروى عن محمد بن الحسين بن أبي الخطاب، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 51، 842.(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى ثعلبة بن ميمون.(@)(@@) وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى أبي أيوب PageV11P463(@)(@@) الخزاز، وعمار بن مروان الكلبي، وثعلبة ابن ميمون.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى إبراهيم بن أبي البلاد، وثعلبة بن ميمون.(@)(@@) * وروى عن محمد بن عبد الجبار، وروى عنه محمد بن الحسن، ومحمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى عبد الله ابن جبلة.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد، وخالد بن ماد القلانسي، وعبد الله بن جبلة.(@)(@@) وروى عنه محمد بن عبد الحميد، وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد.(@)(@@) * وروى عن محمد بن عثمان العمري.(@)(@@) الفقيه: ج 2، ح 1526.(@)(@@) وروى عنه محمد بن الحسن، ومحمد بن موسى بن المتوكل، ووالد الصدوق 
ms3549	 (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى محمد بن عثمان العمري.(@)(@@) * وروى عن محمد بن عيسى، وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى إسماعيل ابن جابر، وحريز بن عبد الله.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) * وروى عن محمد بن عيسى بن عبيد، وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى حنان بن سدير، وياسين الضرير.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه، في طريقه إلى زرارة بن أعين، وحريز بن عبد الله، وحماد بن عيسى، وحنان بن سدير، وياسين الضرير.(@)(@@) * وروى عن محمد بن الفضل البغدادي، وروى عنه محمد بن الحسين ابن أحمد.(@)(@@) التهذيب: ج 6، ح 198. PageV11P464(@)(@@) * وروى عن محمد بن الوليد، وروى أبو القاسم بن قولويه، عن أبيه، عنه.(@)(@@) التهذيب: ج 6، ح 824.(@)(@@) وروى عنه محمد.(@)(@@) التهذيب: ج 6، ح 826.(@)(@@) * وروى عن هارون بن مسلم، وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى مسعدة بن صدقه.(@)(@@) * وروى عن هارون بن مسلم بن سعدان، وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى القاسم ابن عروة.(@)(@@) * وروى عن يعقوب بن يزيد، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 120.(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) مشيخة الفقيه: في طريقه إلى حفص بن البختري، وحريز بن عبد الله، ويعقوب ابن يزيد.(@)(@@) وروى عنه محمد بن الحسن بن أحمد ابن الوليد.(@)(@@) مشيخة الفقيه: في طريقه إلى هشام بن سالم.(@)(@@) وروى عنه محمد بن موسى بن المتوكل.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه والد الصدوق (قده).(@)(@@) مشيخة الفقيه: في طريقه إلى حفص بن البختري، وحريز بن عبد الله، ويعقوب ابن يزيد.(@)(@@) * وروى مضمرة.(@)(@@) الفقيه: ج 3، ح 853.(@)(@@) عبد الله بن جندب * روى عن أبي الحسن (عليه السلام)، وروى عنه حماد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 107، ح 18.(@)(@@) وروى عنه صفوان بن يحيى. 
ms3550	(@)(@@) الكافي: ج 6، ك 6، ب 62، ح 1، و 2.(@)(@@) * وروى عن أبي الحسن موسى (عليه السلام).(@)(@@) الفقيه: ج 1، ح 666.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 2، ب 30، ح 6، و ج 3، ك 4، ب 25، ح 17، و ج 4، ك 3، ب 165، ح 7. والتهذيب: ج 2، ح 416، PageV11P465(@)(@@) و ج 5، ح 615.(@)(@@) * وروى عن الرضا (عليه السلام)، وروى عنه عبد العزيز بن المهتدي.(@)(@@) الكافي: ج 1، ك 4، ب 33، ح 1.(@)(@@) * وروى عن أبيه، وروى عنه إسماعيل بن سهل.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 1.(@)(@@) * وروى عن إبراهيم بن شعيب، وروى عنه إبراهيم بن أبي البلاد.(@)(@@) التهذيب: ج 5، ح 617.(@)(@@) * وروى عن سفيان بن السمط، وروى عنه بن سنان.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 15.(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 2، ك 1، ب 202، ح 1، وك 3، ب 13، ح 15، و ج 6، ك 1، ب 38، ح 7، وك 8، ب 2، ح 1، و ب 37، ح 1، و ب 56، ح 2. والتهذيب: ج 8، ح 394.(@)(@@) * وروى عن سفيان بن السمط البجلي، وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 2، ك 1، ب 172، ح 4.(@)(@@) * وروى عن معاوية بن وهب، وروى عنه الحسين بن بشار.(@)(@@) التهذيب: ج 4، ح 486 (الاستبصار:(@)(@@) ج 2، ح 219، وفيه يسار بدل بشار).(@)(@@) * وروى عن هشام بن سالم، وروى عنه صفوان بن يحيى.(@)(@@) الفقيه: ج 4، ح 767.(@)(@@) * وروى عن بعض أصحابه، عن أبي عبد الله (عليه السلام)، وروى عنه بن فضال.(@)(@@) الكافي: ج 6، ك 6، ب 53، ح 2.(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله (عليه السلام)، وروى عنه محمد بن عبد الحميد.(@)(@@) الكافي: ج 4، ك 3، ب 28، ح 47.(@)(@@) * وروى عن رجل من أصحابنا، عن أبي عبد الله (عليه السلام)، وروى عنه محمد بن سنان.(@)(@@) الكافي: ج 6، ك 9، ب 1، ح 2.(@)(@@) * وروى مرفوعا عن أبي جعفر (عليه السلام)، وروى عنه سعد بن سعد.(@)(@@) الكافي: ج 6، ك 3، ب 18، ح 2.(@)(@@) * وروى عمن أخبره، عن أبي عبد الله (عليه السلام)، وروى عنه أبو أيوب.(@)(@@) الكافي: ج 6، ك 7، ب 37، ح 11.(@)(@@) * وروى علي بن أسباط، عن إبراهيم ابن أبي البلاد أو عبد الله بن جندب، عن إبراهيم بن شعيب. PageV11P466(@)(@@) الكافي: ج 4، ك 3، ب 165، ح 9.(@)(@@) عبد الله 
ms3551	 بن الحسن العلوي * وروى عن الفتح بن يزيد، وروى عنه محمد بن الحسن.(@)(@@) الكافي: ج 1، ك 3، ب 4، ح 1، و ج 5، ك 3، ب 96، ح 2.(@)(@@) * وروى عن الفتح بن يزيد الجرجاني، وروى عنه محمد بن الحسن.(@)(@@) الكافي: ج 1، ك 3، ب 17، ح 1، و ب 22، ح 3، و ب 26، ح 4، و ج 6، ك 6، ب 9، ح 6، و ج 7، ك 4، ب 14، ح 16، و ب 23، ح 5، و ب 54، ح 4. والتهذيب:(@)(@@) ج 10، ح 758 (الاستبصار: ج 4، ح 1036)، و 825، 1161.(@)(@@) عبد الله بن الحكم * روى عن أبي جعفر (عليه السلام).(@)(@@) الفقيه: ج 3، ح 1143.(@)(@@) * وروى عن أبي عبد الله (عليه السلام).(@)(@@) الفقيه: ج 3، ح 98.(@)(@@) وروى عنه أبو عمران الأرمني.(@)(@@) الفقيه: ج 3، ح 891، 892. والتهذيب:(@)(@@) ج 7، ح 783، و ج 10، ح 1058.(@)(@@) * وروى عن جابر، وروى عنه أبو عمران الأرمني.(@)(@@) الكافي: ج 2، ك 3، ب 9، ح 1 و 2.(@)(@@) * وروى عن عيسى بن عطية، وروى عنه أبو عمران الأرمني.(@)(@@) الكافي: ج 7، ك 7، ب 18، ح 2.(@)(@@) * وروى عن معاوية بن عمار، وروى عنه أبو عمران الأزدي.(@)(@@) الكافي: ج 2، ك 2، ب 20، ح 9.(@)(@@) * وروى مضمرة، وروى عنه أبو عمران الأرمني.(@)(@@) التهذيب: ج 10، ح 615.(@)(@@) عبد الله بن حماد * روى عن أبي بصير، وروى عنه إبراهيم بن إسحاق.(@)(@@) الكافي: ج 5، ك 2، ب 49، ح 10.(@)(@@) والتهذيب: ج 6، ح 1175.(@)(@@) * وروى عن أبي بكر بن أبي سماك، وروى عنه إبراهيم بن إسحاق الأحمر.(@)(@@) الكافي: ج 3، ك 1، ب 15، ح 7.(@)(@@) * وروى عن أبي مريم الأنصاري، PageV11P467(@)(@@) وروى عنه إبراهيم بن إسحاق الأحمر.(@)(@@) الكافي: ج 1، ك 6، ب 9، ح 2.(@)(@@) * وروى عن بن مسكان، وروى عنه إبراهيم بن إسحاق.(@)(@@) الروضة: ح 336.(@)(@@) * وروى عن إسماعيل بن سهل، وروى عنه إبراهيم بن إسحاق الأحمري.(@)(@@) التهذيب: ج 4، ح 236 (الاستبصار:(@)(@@) ج 2، ح 139).(@)(@@) * وروى عن بريد بن معاوية، وروى عنه إبراهيم بن إسحاق.(@)(@@) الكافي: ج 1، ك 4، ب 22، ح 2.(@)(@@) * وروى عن جميل بن دراج، وروى عنه إبراهيم بن إسحاق.(@)(@@) الكافي: ج 5، ك 2، ب 138، ح 3.(@)(@@) * وروى عن حذيفة بن منصور، وروى عنه إبراهيم بن إسحاق النهاوندي.(@)(@@) التهذيب: ج 7، ح 1411 (الاستبصار:(@)(@@) ج 3، ح 755).(@)(@@) * وروى عن خطاب بن سلمة، وروى عنه 
