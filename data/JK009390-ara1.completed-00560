ms541	 له عمله بعمل أهل النار ، وإن الرجل ليعمل الزمن الطويل بعمل أهل النار ثم يختم عمله بعمل أهل الجنة ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P231(@)(@@)(@@)(@@) $ ( 5067 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل أو المرأة بطاعة الله تعالى ستين سنة ثم يحضرهما الموت فيضاران في الوصية فتجب لهما النار ) )(@)(@@) ( د ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5068 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل بعمل أهل الخير سبعين سنة ، فإذا أوصى حاف في وصيته فيختم له بشر عمله فيغل النار وإن الرجل ليعمل بعمل أهل الشر سبعين سنة فيعدل في وصيته فيختم له بخير عمله فيدخل الجنة ) )(@)(@@) ( حم ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5069 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل عمل الجنة فيما يبدو للناس وهو من أهل النار ، وإن الرجل ليعمل عمل أهل النار فيما يبدو للناس وهو من أهل الجنة ) )(@)(@@) عبد بن حميد ( ق ) عن سهل بن سعد رضي الله عنه زاد ( خ ) وإنما الأعمال بخواتيمها .(@)(@@)(@@)(@@) $ ( 5070 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليقوم في الصلاة فيدعوا الدعوة فيغفر له ولمن وراءه من الناس ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5071 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليكون له المنزله عند الله فما يبلغها بعمل ، فلا يزال الله يبتليه بما يكره حتى يبلغه إياها ) )(@)(@@) ( حب ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5072 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليلجمه العرق يوم القيامة فيقول : رب أرحني ولو إلى النار ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5073 ) قال النبي :(@)(@@) | 30 ( إن الرجل لينصرف وما كتب له إلا عشر صلاته ، تسعها ، ثمنها ، سبعها ، سدسها ، خمسها ، ربعها ، ثلثها ، نصفها ) )(@)(@@) ( حم PageV02P232 د حب ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5074 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليوضع الطعام بين يديه فما يرفع حتى يغفر له بقول : بسم الله إذا وضع ، والحمد لله إذا رفع ) )(@)(@@) ( الضياء ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5075 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل 
ms542	 الجنة ليعطى قوة مائة رجل في الأكل والشرب والشهوة والجماع ؛ حاجة أحدهم عرق يفيض من جلده فإذا بطنه قد ضمر ) )(@)(@@) ( طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5076 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل النار ليعظم للنار حتى يكون الضرس من أضراسه كاحد ) )(@)(@@) ( حم ) عن زيد بن أرقم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5077 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل عليين ليشرف على أهل الجنة فتضيء الجنة لوجهه كأنها كوكب دري ) )(@)(@@) ( د ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5078 ) قال النبي :(@)(@@) | 30 ( إن الرحم شجنة آخذة بحجزة الرحمان تصل من وصلها وتقطع من قطعها ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5079 ) قال النبي :(@)(@@) | 30 ( إن الرحمة لا تنزل على قوم فيهم قاطع رحم ) )(@)(@@) ( خد ) عن ابن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5080 ) قال النبي :(@)(@@) | 30 ( إن الرزق لا تنقصه المعصية ولا تزيده الحسنة ، وترك الدعاء معصية ) )(@)(@@) ( طص ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5081 ) قال النبي :(@)(@@) | 30 ( إن الرزق ليطلب العبد أكثر مما العبد يطلبه أجله ) )(@)(@@) ( طب عد ) عن أبي الدرداء رضي الله عنه .(@)(@@) PageV02P233(@)(@@)(@@)(@@) $ ( 5082 ) قال النبي :(@)(@@) | 30 ( إن الرسالة والنبوة قد انقطعت فلا رسول بعدي ولا نبي ولاكن المبشرات رؤيا الرجل المسلم وهي جزء من أجزاء النبوة ) )(@)(@@) ( حم ت ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5083 ) قال النبي :(@)(@@) | 30 ( إن الرقى والتمائم والتولة شرك ) )(@)(@@) ( حم د ه ك هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5084 ) قال النبي :(@)(@@) | 30 ( إن الركن والمقام ياقوتتان من ياقوت الجنة طمس الله تعالى نورهما ، ولو لم يطمس نورهما لأضاءتا ما بين المشرق والمغرب ) )(@)(@@) ( حم ت حب ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5085 ) قال النبي :(@)(@@) | 30 ( إن الرو ح إذا قبض تبعه البصر ) )(@)(@@) ( حم م ه ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5086 ) قال النبي :(@)(@@) | 30 ( إن الزناة يأتون تشتعل وجوههم نارا ) )(@)(@@) ( طب ) عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5087 ) قال النبي :(@)(@@) | 30 ( إن الساعة 
ms543	 لا تقوم حتى يكون عشر آيات : الدخان ، والدجال والدابة ، وطلوع الشمس من مغربها ، وثلاثة خسوف : خسف بالمشرق ، وخسف بالمغرب ، وخسف بجزيرة العرب ، ونزول عيسى ، وفتح يأجوج ومأجوج ، ونار تخرج من قعر عدن تسوق الناس إلى المحشر تبيت معهم حيث باتوا ، وتقيل معهم حيث قالوا ) )(@)(@@) ( حم م 4 ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@) PageV02P234(@)(@@)(@@)(@@) $ ( 5088 ) قال النبي :(@)(@@) | 30 ( إن السحور بركة أعطاكموها الله فلا تدعوها ) )(@)(@@) ( حم ن ) عن رجل .(@)(@@)(@@)(@@) $ ( 5089 ) قال النبي :(@)(@@) | 30 ( إن السعادة كل السعادة طول العمر في طاعة الله ) )(@)(@@) ( خط ) عن المطلب عن أبيه .(@)(@@)(@@)(@@) $ ( 5090 ) قال النبي :(@)(@@) | 30 ( إن السعيد لمن جنب الفتن ولمن ابتلي فصبر ) )(@)(@@) ( د ) عن المقداد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5091 ) قال النبي :(@)(@@) | 30 ( إن السقط ليراغم ربه إذا دخل أبواه النار فيقال : أيها السقط المراغم ربه أدخل أبويك الجنة فيجرهما بسرره حتى يدخلهما الجنة ) )(@)(@@) ( ه ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5092 ) قال النبي :(@)(@@) | 30 ( إن السلام اسم من أسماء الله تعالى فأفشوه بينكم ) )(@)(@@) ( عق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5093 ) قال النبي :(@)(@@) | 30 ( إن السلام اسم من أسماء الله تعالى وضع في الأرض فأفشوا السلام بينكم ) )(@)(@@) ( خد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5094 ) قال النبي :(@)(@@) | 30 ( إن السلام اسم من أسماء الله وضعه في الأرض تحية لأهل ديننا ، وأمانا لأهل ذمتنا ) )(@)(@@) ( طب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5095 ) قال النبي :(@)(@@) | 30 ( إن السلف يجري مجرى شطر الصدقة ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5096 ) قال النبي :(@)(@@) | 30 ( إن السماوات السبع ، والأرضين السبع ، والجبال PageV02P235 لتلعن الشيخ الزاني ، وإن فروج الزناة ليؤذي أهل النار نتن ريحها ) )(@)(@@) ( البزار ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5097 ) قال النبي :(@)(@@) | 30 ( إن السيد لا يكون بخيلا ) )(@)(@@) ( خط ) في كتاب البخلاء عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5098 ) قال النبي :(@)(@@) | 30 ( إن الشاهد يرى ما لا يرى الغائب ) )(@)(@@) ( ابن سعد ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5099 ) قال النبي :(@)(@@) | 30 ( إن الشديد كل الشديد الذي يملك نفسه عند الغضب 
ms544	 ) )(@)(@@) ( ابن منده هب ) عن خصفة أو ابن حصفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5100 ) قال النبي :(@)(@@) | 30 ( إن الشمس تطلع مع قرن شيطان فإذا طلعت قارنها ، وإذا ارتفعت فارقها ، ثم إذا استوت قارنها فإذا زالت فارقها ، وإذا تدلت للغروب قارتها فإذا غربت فارقها فلا تصلوا هاذه الأوقات الثلاثة ) )(@)(@@) ( مالك حم ه هق ) عن عبد الله الصنابحي ( ز ) .(@)(@@)(@@)(@@) $ ( 5101 ) قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله لا يخسفان لموت أحد ولا لحياته ، فإذا رأيتم ذالك فادعوا الله وكبروا ، وصلوا وتصدقوا ، يا أمة محمد والله ما من أحد أغير من الله أن يزني عبده ، أو تزني أمته ، يا أمة محمد والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا ، اللهم هل بلغت ؟ ) )(@)(@@) ( مالك حم ق د ن ) وابن خزيمة عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5102 ) قال النبي :(@)(@@) | 30 ( إن الشمس والقمر إذا رأى أحدهما من عظمة الله تعالى شيئا حاد عن مجره فانكسف ) )(@)(@@) ( ابن النجار ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5103 ) قال النبي :(@)(@@) | 30 ( إن الشمس والقمر ثوران عقيران في النار ) PageV02P236 )(@)(@@) ( الطيالسي ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5104 ) قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا يخسفان لموت أحد ولاكنهما خلقان من خلقه ، وإن الله يحدث في خلقه ما شاء ، وإن الله عز وجل إذا تجلى لشيء من خلقه يخشع له ، فأيهما حدث فصلوا حتى ينجلي أو يحدث الله أمرا ) )(@)(@@) ( ن ) عن قبيصة الهلالي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5105 ) قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ، ولاكنهما آيتان من آيات الله يخوف الله بهما عبادة فإذا رأيتم ذالك فصلوا وادعوا حتى ينكشف ما بكم ) )(@)(@@) ( خ ن ) عن أبي بكرة ( ق ن ه ) عن ابن مسعود ( ق ن ) عن ابن عمر ( ق ) عن المغيرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 5106 ) قال النبي :(@)(@@) | 30 ( إن الشهر يكون تسعة وعشرين يوما ) )(@)(@@) ( خ ت ) عن أنس ( ق ) عن أم سلمة ( م ) عن جابر وعائشة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 5107 ) قال النبي :(@)(@@) | 30 
ms545	 ( إن الشياطين تغدو براياتها إلى الأسواق فيدخلون مع أول داخل ، ويخرجون مع آخر خارج ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5108 ) قال النبي :(@)(@@) | 30 ( إن الشيخ يملك نفسه ) )(@)(@@) ( حم طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5109 ) قال النبي :(@)(@@) | 30 ( إن الشيطان إذا سمع النداء بالصلاة أحال له ضراط حتى لا يسمع صوته ، فإذا سكت رجع فوسوس ، فإذا سمع الإقامة ذهب حتى لا يسمع صوته ، فإذا سكت رجع فوسوس ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5110 ) قال النبي :(@)(@@) | 30 ( إن الشيطان إذا سمع النداء بالصلاة ذهب حتى يكون مكان الروحاء ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P237(@)(@@)(@@)(@@) $ ( 5111 ) قال النبي :(@)(@@) | 30 ( إن الشيطان حساس لحاس فاحذروه على أنفسكم ، من بات وفي يده ريح غمر فأصابه شيء فلا يلومن إلا نفسه ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5112 ) قال النبي :(@)(@@) | 30 ( إن الشيطان ذئب الإنسان ، كذئب الغنم يأخذ الشاة القاصية والناحية ، فاياكم والشعاب وعليكم بالجماعة والعامة والمسجد ) )(@)(@@) ( حم ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5113 ) قال النبي :(@)(@@) | 30 ( إن الشيطان عرض لي فشد علي ليقطع الصلاة علي فأمكنني الله تعالى منه فذعته ولقد هممت أن أوثقه إلى سارية حتى تصبحوا فتنظروا إليه فذكرت قول سليمان : رب هب لي ملكا لا ينبغي لأحد من بعدي فرده الله خاسئا ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5114 ) قال النبي :(@)(@@) | 30 ( إن الشيطان قال : وعزتك يا رب لا أبرح أغوي عبادك ما دامت أرواحهم في أجسادهم ، فقال الرب : وعزتي وجلالي لا أزال أغفر لهم ما استغفروني ) )(@)(@@) ( حم ع ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5115 ) قال النبي :(@)(@@) | 30 ( إن الشيطان قد أيس أن يعبده المصلون ، ولاكن في التحريش بينهم ) )(@)(@@) ( حم م ت ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5116 ) قال النبي :(@)(@@) | 30 ( إن الشيطان قعد لابن آدم بأطرقه ، فقعد له بطريق PageV02P238 الإسلام فقال : تسلم وتذر دينك ودين آبائك وآباء آبائك فعصاه فأسلم ، ثم قعد له بطريق الهجرة فقال : تهاجر وتدع أرضك 
ms546	 وسماءك ، وإنما مثل المهاجر كمثل الفرس في الطول فعصاه فهاجر ، ثم قعد له بطريق الجهاد فقال : تجاهد فهو جهد النفس والمال فتقاتل فتقتل ، فتنكح المرأة ، ويقسم المال ، فعصاه فجاهد ، فمن فعل ذالك كان حقا على الله أن يدخله الجنة ، ومن قتل كان حقا على الله أن يدخله الجنة ، وإن غرق كان حقا على الله أن يدخله الجنة ، وإن وقصته دابته كان حقا على الله أن يدخله الجنة ) )(@)(@@) ( حم ن ) و البغوي وابن قانع ( حب ع طب هب ض ) عن سبرة بن فاكه رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5117 ) قال النبي :(@)(@@) | 30 ( إن الشيطان لم يلق عمر منذ أسلم إلا خر لوجهه ) )(@)(@@) ( طب ) عن سديسة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5118 ) قال النبي :(@)(@@) | 30 ( إن الشيطان ليأتي أحدكم وهو في صلاته فيأخذ بشعرة من دبره فيمدها فيرى أنه أحدث ، فلا ينصرف حتى يسمع صوتا أو يجد ريحا ) )(@)(@@) ( حم ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5119 ) قال النبي :(@)(@@) | 30 ( إن الشيطان ليستحل الطعام الذي لم يذكر اسم الله عليه ، وإنه جاء لهاذا الأعرابي ليستحل به فأخذت بيده ، وجاء لهاذه الجارية ليستحل بها فأخذت بيدها ، فوالذي نفسي بيده إن يده في يدي مع أيديهما ) )(@)(@@) ( حم م د ن ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5120 ) قال النبي :(@)(@@) | 30 ( إن الشيطان ليفرق منك يا عمر ) )(@)(@@) ( حم ت حب ) عن بريدة رضي الله عنه .(@)(@@) PageV02P239(@)(@@)(@@)(@@) $ ( 5121 ) قال النبي :(@)(@@) | 30 ( إن الشيطان واضع خطمه على قلب ابن آدم ، فإن ذكر الله تعالى خنس ، وإن نسي الله التقم قلبه ) )(@)(@@) ( ابن أبي الدنيا ع هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5122 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يأتي أحدكم في صلاته فيلبس عليه حتى لا يدري كم صلى ، فإذا وجد ذالك أحدكم فليسجد سجدتين وهو جالس قبل أن يسلم ثم يسلم ) )(@)(@@) ( ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5123 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يأتي أحدكم فيقول من خلق السماء ؟ فيقول : الله ، فيقول : من خلق الأرض ؟ فيقول : الله ، فيقول : من خلق 
ms547	 الله ؟ فإذا وجد ذالك أحدكم فليقل : آمنت بالله ورسوله ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5124 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يأتي أحدكم فيقول : من خلقك ؟ فيقول : الله ، فيقول : فمن خلق الله ؟ فإذا وجد أحدكم ذالك فليقل : آمنت بالله ورسله ، فإن ذالك يذهب عنه ) )(@)(@@) ( ابن أبي الدنيا في مكائد الشيطان ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5125 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يجري من ابن آدم مجرى الدم ) )(@)(@@) ( حم ق د ) عن أنس رضي الله عنه ( ق د ه ) عن صفية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5126 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يحب الحمرة ، فاياكم والحمرة وكل ثوب ذي شهرة ) )(@)(@@) ( الحاكم في الكنى وابن قانع عد هب ) عن رافع بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5127 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يحضر أحدكم عند كل شيء من شأنه PageV02P240 حتى يحضره عند طعامه ، فإذا سقطت من أحدكم اللقمة فليمط ما كان بها من أذى ثم ليأكلها ولا يدعها للشيطان ، فإذا فرغ فليلعق أصابعه فإنه لا يدري في أي طعامه تكون البركة ) )(@)(@@) ( م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5128 ) قال النبي :(@)(@@) | 30 ( إن الشيطان يهم بالواحد ويهم بالإثنين فإذا كانوا ثلاثة لم يهم بهم ) )(@)(@@) ( البزار ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5129 ) قال النبي :(@)(@@) | 30 ( إن الصائم إذا أكل عنده لم تزل تصلي عليه الملائكة حتى يفرغ من طعامه ) )(@)(@@) ( حم ت هب ) عن أم عمارة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5130 ) قال النبي :(@)(@@) | 30 ( إن الصالحين يشدد عليهم وإنه لا يصيب مؤمنا نكبة من شوكة فما فوق ذالك إلا حطت عنه بها خطيئة ورفع له بها درجة ) )(@)(@@) ( حم حب ك هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5131 ) قال النبي :(@)(@@) | 30 ( إن الصبحة تمنع بعض الرزق ) )(@)(@@) ( حل ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5132 ) قال النبي :(@)(@@) | 30 ( إن الصبر عند الصدمة الأولى ) )(@)(@@) ( حم ق 4 ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5133 ) قال النبي :(@)(@@) | 30 ( إن الصخرة العظيمة لتلقى من شفير جهنم فتهوي بها سبعين عاما ما 
ms548	 تفضي إلى قرارها ) )(@)(@@) ( ت ) عن عتبة بن غزوان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5134 ) قال النبي :(@)(@@) | 30 ( إن الصداع والمليلة لا يزالان بالمؤمن وإن ذنوبه مثل أحد فما يدعانه وعليه من ذنوبه مثقال حبة من خردل ) )(@)(@@) ( حم طب ) عن أبي الدرداء رضي الله عنه .(@)(@@) PageV02P241(@)(@@)(@@)(@@) $ ( 5135 ) قال النبي :(@)(@@) | 30 ( إن الصدقة على ذي قرابة يضعف أجرها مرتين ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5136 ) قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لنا ، وإن مولى القوم منهم ) )(@)(@@) ( ت ن ك ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5137 ) قال النبي :(@)(@@) | 30 ( إن الصدقة لا تزيد المال إلا كثرة ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5138 ) قال النبي :(@)(@@) | 30 ( إن الصدقة لا تنبغي لآل محمد إنما هي أوساخ الناس ) )(@)(@@) ( حم م ) عن عبد المطلب بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5139 ) قال النبي :(@)(@@) | 30 ( إن الصدقة لتطفىء عن أهلها حر القبور ، وإنما يستظل المؤمن يوم القيامة في ظل صدقته ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5140 ) قال النبي :(@)(@@) | 30 ( إن الصدقة لتطفىء غضب الرب وتدفع ميتة السوء ) )(@)(@@) ( ت حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5141 ) قال النبي :(@)(@@) | 30 ( إن الصدقة يبتغى بها وجه الله تعالى ، والهدية يبتغى بها وجه الرسول وقضاء الحاجة ) )(@)(@@) ( طب ) عن عبد الرحمن بن علقمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5142 ) قال النبي :(@)(@@) | 30 ( إن الصدق يهدي إلى البر ، وإن البر يهدي إلى الجنة ، وإن الرجل ليصدق حتى يكتب عند الله صديقا ، وإن الكذب يهدي إلى الفجور ، وإن الفجور يهدي إلى النار ، وإن الرجل ليكذب حتى يكتب عند الله PageV02P242 كذابا ) )(@)(@@) ( ق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5143 ) قال النبي :(@)(@@) | 30 ( إن الصعيد الطيب طهور ما لم تجد الماء ولو إلى عشر حجج ، فإذا وجدت الماء فأمسه بشرتك ) )(@)(@@) ( حم د ت ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5144 ) قال النبي :(@)(@@) | 30 ( إن الصعيد الطيب وضوء المسلم ، وإن لم يجد الماء عشر سنين ، فإذا وجد الماء فليمسه بشرته فإن ذالك هو خير ) )(@)(@@) ( حم 
ms549	 ت حب ك ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5145 ) قال النبي :(@)(@@) | 30 ( إن الصفا الزلال الذي لا تثبت عليه أقدام العلماء الطمع ) )(@)(@@) ( ابن المبارك وابن قانع ) عن سهل بن حسان .(@)(@@)(@@)(@@) $ ( 5146 ) قال النبي :(@)(@@) | 30 ( إن الصلاة قربان المؤمن ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5147 ) قال النبي :(@)(@@) | 30 ( إن الصلاة والصيام والذكر يضاعف على النفقة في سبيل الله تعالى بسبعمائة ضعف ) )(@)(@@) ( د ك ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5148 ) قال النبي :(@)(@@) | 30 ( إن الصلوات الخمس يذهبن بالذنوب كما يذهب الماء الدرن ) )(@)(@@) ( محمد بن نصر ) عن عثمان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5149 ) قال النبي :(@)(@@) | 30 ( إن الضاحك في الصلاة والملتفت والمفقع أصابعه بمنزلة واحدة ) )(@)(@@) ( حم طب هق ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5150 ) قال النبي :(@)(@@) | 30 ( إن الطير إذا أصبحت سبحت ربها وسألته قوت يومها ) )(@)(@@) ( خط ) عن علي رضي الله عنه .(@)(@@) PageV02P243(@)(@@)(@@)(@@) $ ( 5151 ) قال النبي :(@)(@@) | 30 ( إن الظلم ظلمات يوم القيامة ) )(@)(@@) ( ق ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5152 ) قال النبي :(@)(@@) | 30 ( إن العار ليلزم المرء يوم القيامة حتى يقول : يا رب لإرسالك بي إلى النار أيسر علي مما ألقى ، وإنه ليعلم ما فيها من شدة العذاب ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5153 ) قال النبي :(@)(@@) | 30 ( إن العبد آخذ عن الله تعالى أدبا حسنا ، إذا وسع عليه وسع ، وإذا أمسك عليه أمسك ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5154 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا أخطأ خطيئة نكتت في قلبه نكتة سوداء ، فإن هو نزع واستغفر وتاب صقل قلبه ، وإن عاد زيد فيها حتى تعلو على قلبه ، وهو الران الذي ذكر الله تعالى : { كلا بل ران على قلوبهم ما كانوا يكسبون } ) )(@)(@@) ( حم ت ن ه حب ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5155 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا صلى في العلانية فأحسن ، وصلى في السر فأحسن قال الله تعالى : هاذا عبدي حقا ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5156 
ms550	 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا قام يصلي أتي بذنوبه كلها فوضعت على رأسه وعاتقيه ، فكلما ركع أو سجد تساقطت عنه ) )(@)(@@) ( طب حل هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5157 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا كان همه الآخرة كف الله تعالى عليه ضيعته ، وجعل غناه في قلبه ، فلا يصبح إلا غنيا ، ولا يمسي إلا غنيا ، وإذا كان همه الدنيا ، أفشى الله تعالى ضيعته وجعل فقره بين عينيه ، فلا يمسي إلا فقيرا ، ولا يصبح إلا فقيرا ) )(@)(@@) ( حم ) في الزهد عن الحسن مرسلا .(@)(@@) PageV02P244(@)(@@)(@@)(@@) $ ( 5158 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا لعن شيئا صعدت اللعنة إلى السماء فتغلق أبواب السماء دونها ، ثم تهبط إلى الأرض فتغلق أبوابها دونها ، ثم تأخذ يمينا وشمالا ، فإذا لم تجد مساغا رجعت إلى الذي لعن ، فإن كان لذالك أهلا ، وإلا رجعت إلى قائلها ) )(@)(@@) ( د ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5159 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا مرض أوحى الله إلى ملائكته : أنا قيدت عبدي بقيد من قيودي فإن أقبضه أغفر له ، وإن أعافه فحينئذ يقعد لا ذنب له ) )(@)(@@) ( ك ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5160 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا نصح لسيده ، وأحسن عبادة ربه ، كان له أجره مرتين ) )(@)(@@) ( مالك حم ق د ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5161 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا وضع في قبره وتولى عنه أصحابه حتى إنه يسمع قرع نعالهم ، أتاه ملكان فيقعدانه فيقولان له : ما كنت تقول في هاذا الرجل لمحمد ؟ فأما المؤمن فيقول : أشهد أنه عبد الله ورسوله ، فيقال : أنظر إلى مقعدك من النار قد أبدلك الله به مقعدا من الجنة فيراهما جميعا ويفسح له في قبره سبعون ذراعا ويملا عليه خضرا إلى يوم يبعثون ، وأما الكافر أو المنافق فيقال له : ما كنت تقول في هاذا الرجل ؟ فيقول : لا أدري ؟ كنت أقول ما يقول الناس فيقال له : لا دريت ولا تليت ، ثم يضرب بمطراق من حديد ضربة بين أذنيه فيصيح صيحة يسمعها من 
ms551	 يليه غير الثقلين وضيق عليه قبره حتى تختلف أضلاعه ) )(@)(@@) ( حم ق د ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5162 ) قال النبي : $ 30 ( إن العبد المؤمن إذا كان في انقطاع من الدنيا وإقبال من الآخرة ، نزل إليه من السماء ملائكة بيض الوجوه كأن وجوههم الشمس ، معهم PageV02P245 كفن من أكفان الجنة ، وحنوط من حنوط الجنة حتى يجلسوا منه مد البصر ، ثم يجيء ملك الموت حتى يجلس عند رأسه فيقول : أيتها النفس الطيبة ، اخرجي إلى مغفرة من الله ورضوان فتخرج فتسيل كما تسيل القطرة من في السقاء فيأخذها ، فإذا أخذها لم يدعوها في يده طرفة عين حتى يأخذوها فيجعلوها في ذالك الكفن وفي ذالك الحنوط ، ويخرج منها كأطيب نفحة مسك وجدت على وجه الأرض ، فيصعدون بها فلا يمرون على ملأ من الملائكة إلا قالوا : ما هاذا الروح الطيب ؟ فيقولون : فلان بن فلان بأحسن أسمائه التي كانوا يسمونه بها في الدنيا حتى ينتهوا به إلى سماء الدنيا ، فيستفتحون له ، فيفتح له ، فيشيعه من كل سماء مقربوها إلى السماء التي تليها ، حتى ينتهي إلى السماء السابعة فيقول الله عز وجل : اكتبوا كتاب عبدي في عليين ، وأعيدوا عبدي إلى الأرض ، فإني منها خلقتهم وفيها أعيدهم ومنها أخرجهم تارة أخرى ، فتعاد روحه فيأتيه ملكان فيجلسانه فيقولان له : من ربك ؟ فيقول : ربي الله ، فيقولان له : ما دينك ؟ فيقول : ديني الإسلام ، فيقولان له : ما هذا الرجل الذي يعث فيكم فيقول : هو رسول الله ، فيقولان له : وما علمك ؟ فيقول : قرأت كتاب الله فآمنت به وصدقت ، فينادي مناد من السماء : أن صدق عبدي فأفرشوه من الجنة ، وألبسوه من الجنة ، وافتحوا له بابا إلى الجنة فيأتيه من روحها وطيبها ويفسح له في قبره مد بصره ، ويأتيه رجل حسن الوجه حسن الثياب ، طيب الريح فيقول : أبشر بالذي يسرك ، هاذا يومك الذي كنت توعد ، فيقول له : من أنت ؟ فوجهك الوجه يجيء بالخير ، فيقول : أنا عملك الصالح ، فيقول : رب أقم الساعة ، رب أقم الساعة ، حتى أرجع إلى أهلي ومالي .(@)(@@) وإن العبد الكافر إذا كان في 
ms552	 انقطاع من الدنيا وإقبال من الآخرة نزل إليه من السماء ملائكة سود الوجوه معهم المسوح فيجلسون منه مد البصر ، ثم يجيء ملك الموت حتى يجلس عند رأسه ، فيقول : أيتها النفس الخبيثة ، اخرجي إلى سخط من الله وغضب فيفرق في جسده فينتزعها كما ينتزع السفود من الصوف المبلول PageV02P246 فيأخذها ، فإذا أخذها لم يدعوها في يده طرفة عين حتى يجعلوها في تلك المسوح ، ويخرج مننها كأنتن ريح جيفة وجدت على وجه الأرض ، فيصعدون بها فلا يمرون بها على ملأ من الملائكة إلا قالوا : ما هاذا الروح الخبيث ؟ فيقولون : فلان بن فلان بأقبح أسمائه التي كان يسمى بها في الدنيا ، حتى ينتهي به إلى السماء الدنيا ، فيستفتح له فلا يفتح له ، ثم قرأ لا تفتح لهم أبواب السماء ، فيقول الله عز وجل : اكتبوا كتابه في سجين في الأرض السفلى فتطرح روحه طرحا ، فتعاد روحه في جسده ، ويأتيه ملكان فيجلسانه فيقولان له : من ربك ؟ فيقول : هاه هاه لا أدري ، فيقولان له : ما دينك ، فيقول : لا أدري ، فيقولان له : ما هاذا الرجل الذي بعث فيكم ؟ فيقول : هاه هاه لا أدري ، فينادي مناد من السماء أن كذب عبدي فأفرشوه من النار ، وافتحوا له بابا إلى النار فيأتيه من حرها وسمومها ، ويضيق عليه قبره حتى تختلف أضلاعه ، ويأتيه رجل قبيح الوجه ، قبيح الثياب ، منتن الريح ، فيقول : أبشر بالذي يسوءك ، هاذا يومك الذي كنت توعد ، فيقول : من أنت ؟ فوجهك الوجه يحيء بالشر فيقول : أنا عملك الخبيث ، فيقول : رب لا تقم الساعة ) )(@)(@@) | ( حم د و ا| بن خزيمة ك هب والضياء ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5163 ) قال النبي :(@)(@@) | 30 ( إن العبد ليؤجر في نفقته كلها إلا في البناء ) )(@)(@@) ( ه ) عن جناب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5164 ) قال النبي :(@)(@@) | 30 ( إن العبد ليبلغ بحسن خلقه عظيم درجات الآخرة وشرف المنازل وإنه لضعيف العبادة ، وإنه ليبلغ بسوء خلقه أسفل درك جهنم وإنه لعابد ) )(@)(@@) ( سمويسه طب ) والضياء عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5165 ) قال النبي :(@)(@@) | 30 ( إن العبد ليتصدق بالكسرة 
ms553	 تربو عند الله حتى تكون مثل أحد ) )(@)(@@) ( طب ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5166 ) قال النبي :(@)(@@) | 30 ( إن العبد ليتكلم بالكلمة ما يبتين فيها يزل بها في النار PageV02P247 أبعد ما بين المشرق والمغرب ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5167 ) قال النبي :(@)(@@) | 30 ( إن العبد ليتكلم بالكلمة من رضوان الله لا يلقي لها بالا يرفعه الله بها درجات ، وإن العبد ليتكلم بالكلمة من سخط الله لا يلقي لها بالا يهوي بها في جهنم ) )(@)(@@) ( حم خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5168 ) قال النبي :(@)(@@) | 30 ( إن العبد ليذنب الذنب فيدخل به الجنة يكون نصب عينيه تائبا فارا حتى يدخل به الجنة ) )(@)(@@) ( ابن المبارك ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 5169 ) قال النبي :(@)(@@) | 30 ( إن العبد ليعمل الذنب فإذا ذكره أحزنه ، وإذا نظر الله إليه قد أحزنه غفر له ما صنع قبل أن يأخذ في كفارته بلا صلاة ولا صيام ) )(@)(@@) ( حل و ابن عساكر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5170 ) قال النبي :(@)(@@) | 30 ( إن العجب ليحبط عمل سبعين سنة ) )(@)(@@) ( فر ) عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5171 ) قال النبي :(@)(@@) | 30 ( إن العدة عطية ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن الحسن مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 5172 ) قال النبي :(@)(@@) | 30 ( إن العرافة حق ولا بد للناس من العرفاء ، ولاكن ، العرفاء في النار ) )(@)(@@) ( د ) عن رجل .(@)(@@)(@@)(@@) $ ( 5173 ) قال النبي :(@)(@@) | 30 ( إن العرق يوم القيامة ليذهب في الأرض سبعين باعا ، وإنه ليبلغ إلى أفواه الناس أو إلى آذانهم ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5174 ) قال النبي :(@)(@@) | 30 ( إن العشر عشر الأضحى ، والوتر يوم عرفة ، والشفع PageV02P248 يوم النحر ) )(@)(@@) ( حم ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5175 ) قال النبي :(@)(@@) | 30 ( إن العلماء إذا حضروا ربهم كان معاذ بن جبل بين أيديهم رتوة بحجر ) )(@)(@@) ( حل ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5176 ) قال النبي :(@)(@@) | 30 ( إن العين لتولع بالرجل باذن الله تعالى حتى يصعد حالقا ثم يتردى منه ) )(@)(@@) ( حم ع ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5177 
ms554	 ) قال النبي :(@)(@@) | 30 ( إن الغادر ينصب له لواء يوم القيامة فيقال : ألا هاذه غدرة فلان ابن فلان ) )(@)(@@) ( مالك ق د ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5178 ) قال النبي :(@)(@@) | 30 ( إن الغسل يوم الجمعة ليسل الخطايا من أصول الشعر استلالا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5179 ) قال النبي :(@)(@@) | 30 ( إن الغضب من الشيطان ، وإن الشيطان خلق من النار ، وإنما تطفا النار بالماء ، فإذا غضب أحدكم فليتوضأ ) )(@)(@@) ( حم د ) عن عطية العوفي .(@)(@@)(@@)(@@) $ ( 5180 ) قال النبي :(@)(@@) | 30 ( إن الغنم من دواب الجنة فامسحوا رغامها وصلوا في مرابضها ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5181 ) قال النبي :(@)(@@) | 30 ( إن الغيرة من الإيمان ، وإن البذاء من النفاق ) )(@)(@@) ( هق ) عن زيد بن أسلم مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 5182 ) قال النبي :(@)(@@) | 30 ( إن الفتنة تجيء فتنسف العباد نسفا ، وينجو العالم منها بعلمه ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P249(@)(@@)(@@)(@@) $ ( 5183 ) قال النبي :(@)(@@) | 30 ( إن الفتنة ترسل ويرسل معها الهوى والصبر ، فمن اتبع الهوى قتلته سوداء ، ومن اتبع الصبر كانت قتلته بيضاء ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5184 ) قال النبي :(@)(@@) | 30 ( إن الفحح والتفحح ليسا من الإسلام في شيء ، وإن أحسن الناس إسلاما أحسنهم خلقا ) )(@)(@@) ( حم ع طب ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5185 ) قال النبي :(@)(@@) | 30 ( إن الفخذ عورة ) )(@)(@@) ( ك ) عن جرهد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5186 ) قال النبي :(@)(@@) | 30 ( إن القاضي العدل ليجاء به يوم القيامة فيلقى من شدة الحساب ما يتمنى أن لا يكون قضى بين اثنين في تمرة ) )(@)(@@) ( قط و البزار أي في الألقاب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5187 ) قال النبي :(@)(@@) | 30 ( إن القبر أول منازل الآخرة فإن نجا منه فما بعده أيسر منه ، وإن لم ينج منه فما بعده أشد منه ) )(@)(@@) ( ت ه ك ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5188 ) قال النبي :(@)(@@) | 30 ( إن القرآن مثله كمثل جراب فيه مسك قد ربطت فاه ، فإن فتحته 