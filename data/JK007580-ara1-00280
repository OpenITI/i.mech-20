ms261	 ما طابوا ولا مجدوا(@)(@@) 4 أما إلى كل شر عن فانتبهوا %~% بل لم يناموا ، ولكن عن تقى هجدوا(@)(@@) 5 والناس يطغون في دنياهم أشرا %~% لولا المخافة مازكوا ولا سجدوا(@)PageV01P1213(@)(@@) البحر : كامل تام(@)(@@) 1 لم لا أؤمل رحمة من قادر %~% والسؤل يطلب في السحاب الأسول(@)(@@) 2 والدهر أكوان ، تمر سريعة ، %~% ويكون آخرها نظير الأول(@)(@@) 3 ويؤلف الوقت المديد قصارها %~% حتى يعد من الزمان الأطول(@)(@@) 4 والعقل يزجر ، والطباع مع النهى ، %~% كالفيل يضرب رأسه بالمغول(@)(@@) 5 دنياك أم قد أجاب مليكها ، %~% فيها وفي الأبناء ، دعوة جرول(@)(@@) 6 وتجول فوق الساكنين ، كأنها %~% ورهاء هاجرة ، غدت في مجول(@)(@@) 7 والفقر أروح ، في الحياة ، من الغنى ؛ %~% والموت يجعل خائلا كمخول(@)(@@) 8 إن اللقاح ، وإن أتاك بثروة %~% فأقل منه أذى حيال الحول(@)(@@) 9 والمرء يعقد ، بالبعيد ، رجاءه ، %~% كالرسل رجي في النياق الشول(@)(@@) 10 كم أحرز ، المال ، المقيم ، بجده ، %~% وسرى الحريص فعاد غير ممول PageV01P1214(@)(@@) 11 ورأيت شر الجار يشمل جاره %~% كرحى الفم انتزعت بذنب المقول(@)PageV01P1215(@)(@@) البحر : بسيط تام(@)(@@) 1 في كل أمرك تقليد رضيت به %~% حتى مقالك : ربي واحد أحد(@)(@@) 2 وقد أمرنا بفكر في بدائعه %~% وان تفكر فيه معشر لحدوا(@)(@@) 3 وأهل كل جدال يمسكون به %~% إذا رأوا نور حق ظاهر جحدوا(@)PageV01P1216(@)(@@) البحر : كامل تام(@)(@@) 1 شعر كساه الدهر صبغة حاذق %~% لونا أقام بحاله لم ينصل(@)(@@) 2 شبحي ، وإن نلت الثريا ، للثرى %~% طعم ، وعنصر خيرنا كالعنصل(@)(@@) 3 والناس كلهم بغى ما فاته ، %~% وغدا يحاول مطلبا لم يحصل . . .(@)(@@) 4 متنصل من غير ذنب فيهم ، %~% وأخو ذنوب ليس بالمتنصل(@)(@@) 5 لو خيروا بين الحياة وغيرها %~% ما كانت الدنيا اختيار محصل(@)(@@) 6 وأرى الفتى بلغ المآرب والعلى %~% بالحظ ، لا بسنانه والمنصل(@)(@@) 7 جسم يذم النفس ، وهي تذمه ، %~% في مجمل ، من أمرها ، ومفصل(@)(@@) 8 يتقاطعون ، وفي القطيعة راحة ، %~% من بؤس عيش ، بالأذاة ، موصل(@)(@@) 9 تلقى النفوس حتوفها من مظلم ، %~% أو مصبح أو مظهر أو مؤصل(@)(@@) 10 فكأن روحك لم يحل بشخصه ، %~% والراح ما دبت له في مفصل(@)PageV01P1217(@)(@@) البحر : بسيط تام 
ms262	(@)(@@) 1 حوادث الدهر أملاك ، لها قنص ، %~% والإنس وحش فقد أودى به الطرد(@)(@@) 2 وما تبقي سهام المرء كثرتها %~% فاقض الحياة ، وأنت الصارم الفرد(@)(@@) 3 والشيب شابوا على جهل ومنقصة %~% والمرد ، في كل أمر باطل ، مردوا(@)(@@) 4 والعيش ، كالماء ، تغشاه حوائمنا ، %~% فصادرون ، وقوم إثرهم وردوا(@)(@@) 5 ومد وقتي مثل القصر ، غايته ، %~% وفي الهلاك تساوى الدر والبرد(@)(@@) 6 يا رب أفواه غيد ملئت شنبا %~% ثم استحال ، ففي أوطانه الدرد(@)(@@) 7 يغدو على درعه الزراد يحكمها %~% وهل ينجيه مما قدر الزرد ؟(@)PageV01P1218(@)(@@) البحر : كامل تام(@)(@@) 1 آليت ، أرغب في قميص مموه ، %~% فأكون شارب حنظل من حنضل(@)(@@) 2 نجى المعاشر من براثن صالح %~% رب يفرج كل أمر معضل(@)(@@) 3 ما كان لي فيها جناح بعوضة %~% والله ألبسهم جناح تفضل(@)PageV01P1219(@)(@@) البحر : بسيط تام(@)(@@) 1 عجبت للمدنف المشفي على تلف ، %~% ومن يحدث عنه ، بالردى ، خلدوا(@)(@@) 2 فهل بلاد يعري الموت ساكنها %~% فيبتغى ، في الثريا ، ذلك البلد ؟(@)(@@) 3 يشقى الوليد ، ويشقى والداه به %~% وفاز من لم يوله ، عقله ، ولد(@)(@@) 4 إذا تلبس بالشجعان جبنهم ، %~% وبالكرام أسر الضن ، أو صلدوا(@)(@@) 5 عظم ونحض تبنى ، منهما ، طلل ، %~% كأنها الأرض منها السهل والجلد(@)PageV01P1220(@)(@@) البحر : كامل تام(@)(@@) 1 هي غربتان : فغربة من عاقل %~% ثم اغتراب من محكم عقله(@)(@@) 2 والطبع يثبت كالهضاب ، ومن يرم %~% نقلا له يعجز ويعي بنقله(@)(@@) 3 والحق يثقل كل غاو ظالم ، %~% وأخو الديانة ما يحس بثقله(@)PageV01P1221(@)(@@) البحر : بسيط تام(@)(@@) 1 إن جاد بالمال سمح ، يبتغي شرفا ، %~% قالت معاشر : ما في كفه جود(@)(@@) 2 لو ماجد النجم أهل الأرض ، عارضه ، %~% منهم ، رجال ، فقالوا : أنت ممجود(@)(@@) 3 فالرأي هجرانك الدنيا وساكنها %~% فأنت من جود هذي النفس منجود(@)(@@) 4 لا تذهب الوجد في إيثار وجدهم %~% فإن ذمك بين الإنس موجود(@)(@@) 5 وإن تهجدت لم تعدم ثواب تقى %~% وإن هجدت فإن الليل مهجود(@)PageV01P1222(@)(@@) البحر : كامل تام(@)(@@) 1 للخير منزلتان عند معاشر ، %~% وله على رأي ثلاث منازل(@)(@@) 2 والله يغفر ، في الحساب ، لنسوة ، %~% جاهدن ، إذ فقد الحيا ، بمغازل(@)(@@) 3 فكسبن منها ما يقوم 
ms263	 بأنفس ، %~% والصبر يبدن في الزمان الهازل(@)(@@) 4 أتصدقت بالخيط ، ثم هوت إلى %~% حمراء ، فاعتصمت بخيط الغازل(@)(@@) 5 وأنالت المسكين أكلة جائع ، %~% فغدت كرضوى في المقام الآزل(@)(@@) 6 إن البعوضة من تقى موزونة %~% بالفيل ، عند مليكها ، والبازل(@)(@@) 7 وتصون حبة خردل قدم الفتى %~% عن زلة ، واليوم حلف زلازل(@)(@@) 8 خف دعوة المظلوم فهي سريعة %~% طلعت فجاءت بالعذاب النازل(@)(@@) 9 عزل الأمير عن البلاد ، وما له %~% إلا دعاء ضعيفها من عازل(@)PageV01P1223(@)(@@) البحر : كامل تام(@)(@@) 1 عز الذي بالموت رد غنينا %~% كفقيرنا ، ومقيمنا كالراحل(@)(@@) 2 ما أسرع التغيير إن مره القلا %~% بسرابه فالليل إثمد كاحل(@)(@@) 3 أعيا الخلاص من السقام ، وصورة %~% قمر المنير إلى هلال ناحل(@)(@@) 4 أعجبت للطفل الوليد بمهده %~% لم يخط ، كيف سرى بغير رواحل(@)(@@) 5 قد عاش يوميه وعمر ثالثا ، %~% ثم استراح من المدى المتماحل(@)(@@) 6 كم سار من سنة أبوه ، فيا له %~% قطع المسافة في ثلاث مراحل(@)(@@) 7 رفعت له لجج البحار ، فعامها ، %~% ونجا وأصبح سالما بالساحل(@)PageV01P1224(@)(@@) البحر : بسيط تام(@)(@@) 1 نقضي الحياة ، ولم يفصد لشاربنا %~% دن ، ولا عودنا ، في الجدب ، مفصود(@)(@@) 2 نفارق العيش لم نظفر بمعرفة %~% أي المعاني ، بأهل الأرض ، مقصود(@)(@@) 3 لم تعطنا ، العلم ، أخبار يجيء بها %~% نقل ، ولا كوكب في الأفق مرصود(@)(@@) 4 وابيض ما اخضر من نبت الزمان بنا %~% وكل زرع ، إذا ما هاج ، محصود(@)PageV01P1225(@)(@@) البحر : كامل تام(@)(@@) 1 لا يغبطن ماش فوارس شزب %~% ما فارس إلا كآخر راجل(@)(@@) 2 ويداي في دنياي ، وهي حبيبة ، %~% كيدي أبي لهب غدا في الآجل(@)(@@) 3 وإذا افتكرت ، فما يهيج تفكري ، %~% فيما أكابد عير لوم الناجل(@)(@@) 4 وأرحت أولادي فهم في نعمة %~% عدم ، التي فضلت نعيم العاجل(@)(@@) 5 ولو أنهم ظهروا لعانوا شدة ، %~% ترميهم في متلفات هواجل(@)(@@) 6 أسوئ بحال الظبي ، وهو مربب %~% في الإنس ، يمرح في حلى وجلاجل(@)(@@) 7 أطلب لنفسك يا أغن محلة %~% في حيث لا تدميك زجلة زاجل(@)(@@) 8 لولا نوافر ، في القديم ، تناسلت ، %~% ما أنضج الظبيات غلي مراجل(@)(@@) 9 وسوالف القمر السواكن بالفلا %~% عذبن 
ms264	 أيدي أيد بمناجل(@)(@@) 10 لا تأسفن حواجل الغربان فال %~% فتيان كلهم بقيد حاجل PageV01P1226(@)(@@) 11 وسجل موت راح يكتبه الردى %~% لمساجل منا وغير مساجل(@)PageV01P1227(@)(@@) البحر : بسيط تام(@)(@@) 1 أودوا إلى الله ، ما أود ومفخرها %~% شيء يعد ، ولا أود ولا أود(@)(@@) 2 طوبى لموؤودة في حال مولدها ، %~% ظلما ، فليت أباها الفظ موؤود(@)(@@) 3 يا رب ، هل أنا بالغفران في ظعني %~% مزود ؟ إن قلبي منك مزؤود(@)(@@) 4 والناس كالأيك ، مخبو لعاضده ، %~% إلى اليبوس ، وماض ، وهو يمؤود(@)PageV01P1228(@)(@@) البحر : كامل تام(@)(@@) 1 غلت الشرور ولو عقلنا صيرت %~% دية القتيل كرامة للقاتل(@)(@@) 2 هذي حبال الشمس ، وهي ضعيفة %~% دامت ، وكم أبلت حبالة خاتل(@)PageV01P1229(@)(@@) البحر : بسيط تام(@)(@@) 1 الصبر يوجد ، إن باء له كسرت ، %~% لكنه ، بسكون الباء ، مفقود(@)(@@) 2 ويحمد الصابر الموفي على غرض ، %~% لا عاجز ، بعرى التقصير ، معقود(@)(@@) 3 وقد نفت عنك ، إغماضا ، ملاحية %~% في كرمها ، وكأن النجم عنقود(@)(@@) 4 والمهر ، يعطيه أنثى ، غير منصفة ، %~% سيب من الله ، والمهرية القود(@)(@@) 5 والنقد يهديإلى الدينار مكرمة %~% فليته بعد حسن الضرب منقود(@)(@@) 6 لا يحمل الليل هم الساهرين به ؛ %~% ولا يجانب حزنا وهو مرقود(@)PageV01P1230(@)(@@) البحر : كامل تام(@)(@@) 1 أسررت إذ مر السنيح تفاؤلا %~% والفأل من رأسي لعمرك فائل(@)(@@) 2 أرأيت فعل الدهر في أمم مضت %~% قبلا ، ومرج قبائل بقبائل(@)(@@) 3 أسرج كميتك في الكتائب جائلا ، %~% ودع الكميت أخا الحباب الجائل(@)(@@) 4 خسر الذي باع الخلود وعيشه %~% بنعيم أيام تعد ، قلائل(@)(@@) 5 وتخير المغرور طول بقائه ، %~% سفها ، وما طول البقاء بطائل(@)(@@) 6 وتفاوت الأجسام ، ثم جميعها %~% متقاربات في نهى وخصائل(@)(@@) 7 حر يضيق ، عن الوليدة ، طوله ، %~% وسواه لم يقنع بتسع حلائل(@)(@@) 8 جمد النضار له فما هو سائل %~% من جود راحته لراحة سائل(@)(@@) 9 ما المرء نائل رتبة من سؤدد ، %~% حتى يصير ماله في النائل(@)(@@) 10 لو عذت من أسد النجوم بجبهة %~% أو بت في ذنب لشبوة شائل PageV01P1231(@)(@@) 11 أو كنت رأس الغول ، وهو موقر ، %~% في الشهب ، لم آمن تهجم غائل(@)(@@) 12 كان الشباب ظلام جنح فانجلى %~% والشيب يذهب 
ms265	 كالنهار الزائل(@)(@@) 13 والغر يرسل قوله بمواعد %~% ولد ، فتنتج عن يمين حائل(@)(@@) 14 وأقل أهل الأرض حظا ، في العلا ، %~% من يكتفي منها بخطبة قائل(@)(@@) 15 والحي شاهد رزء خطب هائل %~% من كون ميت تحت أنمل هائل(@)(@@) 16 قد خلت أنك محسن فيما مضى %~% والخال يكذب فيه ظن الخائل(@)(@@) 17 لا تفرحن بدولة أوتيتها ، %~% إن المدال عليه مثل الدائل(@)(@@) 18 ومتى حظيت بنعمة من منعم ، %~% فتوق واحذر صولة من صائل(@)(@@) 19 وعقائل الألباب غير أوامر %~% بأذاة أيتام ، وهتك عقائل(@)(@@) 20 وإذالة الإنسان ليس بمانع %~% منها تحرزه بدرع ذائل PageV01P1232(@)(@@) 21 وحبائل الدنيا تزيد على الحصى %~% وأقل أنفاسي أدق حبائلي(@)PageV01P1233(@)(@@) البحر : كامل تام(@)(@@) 1 حكم تدل على حكيم قادر %~% متفرد ، في عزه ، بكمال(@)(@@) 2 والمال خدن النفس غير مدافع %~% والفقر موت جاء بالإهمال(@)(@@) 3 أو ما ترى حكم النجوم مصورا %~% بيت الحياة يليه بيت المال ؟(@)(@@) 4 ومن الجهات الست ربي حائطي ، %~% لا عن يميني مرة وشمالي . . .(@)(@@) 5 أرواحنا ألفين كالأرواح في %~% خير وشر ، من صبا وشمال(@)(@@) 6 والمرء كان ، ومثل كان ، وجدته ، %~% حاليه في الإلغاء والإعمال(@)(@@) 7 ثمل الأنام من الضلالة ، وانتشوا %~% بالخمر ، فاعجب من ثمال ثمالي(@)(@@) 8 قوم تغنوا مرملين من الهدى ، %~% فتضاعف الإرمال بالأرمال(@)(@@) 9 وهم البهام ، قصيرة أعمارهم ، %~% ويؤملون أطاول الآمال(@)(@@) 10 لم تلق إلا جاهلا متعاقلا ، %~% متجملا منهم بغير جمال PageV01P1234(@)(@@) 11 مثل البهائم أبهمت عن رشدها ، %~% إلا احتمال ثقائل الأحمال(@)(@@) 12 دنياك أرزاق وتذكر بعدها %~% أخرى تنال بصالح الأعمال(@)PageV01P1235(@)(@@) البحر : كامل تام(@)(@@) 1 يا صاح ما أهوى وما أقلي ، %~% ثقلي علي ، فلا تزد ثقلي(@)(@@) 2 إن العقول تقول مولية : %~% ليس الأنام كنابت البقل(@)(@@) 3 صدئت خواطرنا فما صقلت ، %~% والمكث أحوجها إلى الصقل(@)(@@) 4 دنياك دار كل ساكنها %~% متوقع سببا من النقل(@)(@@) 5 والنسل أفضل ما فعلت بها ، %~% وإذا سعيت له فعن عقل(@)PageV01P1236(@)(@@) البحر : بسيط تام(@)(@@) 1 بقيت حتى كسا الخدين جونهما %~% ثم استحال ، ومس الجسم تخديد(@)(@@) 2 بلوت ، من هذه الدنيا وساكنها ، %~% عجائبا ، وانتهاء الثوب تقديد(@)(@@) 3 ردي كلامك 
ms266	 ، ما أمللت مستمعا ؛ %~% وهل يمل من الأنفاس ترديد ؟(@)(@@) 4 هاجت ، بكاي ، أغاني القيان بها ، %~% كأنها منذوات الثكل تعديد(@)(@@) 5 والناس ، في الأرض ، أجناس مقلدة ، %~% كالهدي قلد ، لم يذعره تهديد(@)(@@) 6 قالوا ، فلما أحالوا أظهروا لددا ؛ %~% فالقول مين ، وفي الأصوات تنديد(@)(@@) 7 ضلوا عن الرشد ، منهم جاحد جحد ، %~% أو من يحد ، وهل لله تحديد !(@)(@@) 8 لفظ يبدد ، من شرخ ومكتهل ؛ %~% والمال يجمع ، لم يدركه تبديد(@)(@@) 9 رموا ، فأشووا ، ولم يثبت قياسهم %~% شيئا سوى أن رمي الموت تسديد(@)(@@) 10 ما سيد غير رعديد علمت به ، %~% كأنما الحتف ، إن لاقاه ، رعديد PageV01P1237(@)(@@) 11 والخير يجلب شرا ، والذباب دعا %~% إلى الجنى ، انه في الطعم قنديد(@)(@@) 12 وخلت أني حرف الوقف ، سكنه %~% وقف ، وأدركه في ذاك تشديد(@)(@@) 13 وأشرف الناس ، في أعلى مراتبه ، %~% مثل الصديد ، ولكن قيل صنديد(@)(@@) 14 ما كبره وثقيل اللحن يمنعه %~% من سرعة الفهم ، ترسيل وتمديد(@)PageV01P1238(@)(@@) البحر : رمل تام(@)(@@) 1 عشت من أيسر حل %~% وتشبهت بظلي(@)(@@) 2 لست بالخل أصافيك %~% فيك ، وما أنت بخل(@)(@@) 3 ربما يعتمد المر %~% على العضو الأشل(@)(@@) 4 أيها الدنيا ! لحاك الله %~% من ربة دل(@)(@@) 5 ما تسلى خلدي عنك %~% ولا ظن التسلي(@)(@@) 6 إنما أبقيت مني %~% للأخلاء ، أقلي(@)(@@) 7 أمس أوديت ببعضي ، %~% وغدا يذهب كلي(@)(@@) 8 لك أوقاتي فخليني %~% إذا قمت أصلي(@)(@@) 9 ودعيني ، ساعة في %~% ك ، لمولاي الأجل(@)(@@) 10 والصبا ملك ، وقد %~% يبكى على الملك المولي(@)PageV01P1239(@)(@@) البحر : بسيط تام(@)(@@) 1 أما الصحاب ، فقد مروا وما عادوا ، %~% وبيننا ، بلقاء الموت ، ميعاد(@)(@@) 2 سر قديم ، وأمر غير متضح ؛ %~% فهل ، على كشفنا للحق ، إسعاد ؟(@)(@@) 3 سيران ضدان : من روح ومن جسد %~% هذا هبوط ، وهذا فيه إصعاد(@)(@@) 4 أخذ المنايا سوانا ، وهي تاركة %~% قبيلنا ، عظة منها وإيعاد(@)(@@) 5 توقعوا السيل ، أوفى عارض وله %~% في العين برق ، وفي الأسماع إرعاد(@)PageV01P1240(@)(@@) البحر : سريع(@)(@@) 1 دنياك والحمام في رتبة : %~% من خارج غم ومن داخل(@)(@@) 2 ما طهرت ، بل دنست ، وارتمت %~% بالسيد الوهاب والباخل(@)(@@) 3 لو نخل العيش لما حصلت %~% شيئا سوى الموت يد الناخل 
ms267	(@)PageV01P1241(@)(@@) البحر : خفيف تام(@)(@@) 1 كن وشيكا في حاجة ، أو مكيثا ، %~% ليس مر الأيام فينا بمهل(@)(@@) 2 حبذا العيش والزمان غرير ، %~% والفتى ما استجد حلة كهل(@)(@@) 3 وخمولي يذود عني الرزايا ، %~% نام عني الأذى ، فلم ينتبه لي(@)(@@) 4 قبل أن ينطق الزمان بتصغير %~% ر كبار ، من فرط عي وجهل(@)(@@) 5 إذ ثريا النجوم تسمى بثروى ، %~% وسهيل السماء يدعى بسهل(@)(@@) 6 ولجين لجن ، كبيرة لفظ ، %~% ولجيم ، كذاك أخلاق سهل(@)PageV01P1242(@)(@@) البحر : بسيط تام(@)(@@) 1 الملك لله ، لا ننفك في تعب ، %~% حتى تزايل أرواح وأجساد(@)(@@) 2 ولا يرى حيوتن لا يكون له %~% فوق البسيطة أعداء وحساد(@)(@@) 3 وما أؤمل عند الدهر مصلحة %~% وإنما هو إتلاف وإفساد(@)(@@) 4 ولا أسر ، إذا ما أسرتي خملوا ، %~% وهل أمنت عليهم ان هم سادوا(@)(@@) 5 والناس مثل ضراء الصيد ، إن غفلت %~% عن شأنها ، فلها بالطبع إيساد(@)(@@) 6 إذا الأصاغر لاقتها أكابرها ، %~% فتلك في الشر أشبال وآساد(@)PageV01P1243(@)(@@) البحر : خفيف تام(@)(@@) 1 سل سبيل الحياة عن سلسبيل %~% لا تخبر عن غير ورد وبيل(@)(@@) 2 والمنايا لقين ، بالجندل الف %~% ظ ، ثنايا لقين بالتقبيل(@)(@@) 3 هل ترى سيد القرابة أضحى %~% مفرد الشخص ما له من قبيل(@)(@@) 4 قوضته وطال ما أقرضته %~% ت ، فلم تندفع بجل جبيل(@)(@@) 5 لم تحد نبل دهرنا برماح ، %~% أو سيوف ، عن ساقط أو نبيل(@)(@@) 6 وبني الأشعث استباحت رزايا %~% ها ، وألقت كلا على رتبيل(@)(@@) 7 يا طبيب المصر اجتهدت ، وما %~% الجلاب جلاب راحة لتبيل(@)(@@) 8 وإذا أوقرت جبال الردى جلت %~% فلم تندفع بحبل جبيل(@)(@@) 9 واحذروا أن تواكلوه ، فما يأ %~% أم زبال من نملة في زبيل ؟(@)(@@) 10 صدقات من المليك على الحتف %~% ف ، جسوم عرفن بالتسبيل PageV01P1244(@)(@@) 11 لا تؤبل أخاك ، يوما ، إذا ما %~% فما كان موضع التأبيل(@)(@@) 12 وارتقب من مؤذن القوم فتكا %~% فالنصارى يشكون فعل الأبيل(@)(@@) 14 ربلته أسفارها وحماه %~% طول أسفاره من التربيل(@)(@@) 15 حسن القول ، يبتغي نضرة العي %~% ش بغش الإذواء ، والتذبيل(@)(@@) 16 يطلق الخمس في الحرام ، وأما %~% اللفظ منه فدائم التكبيل(@)(@@) 17 فاقدروا ، من بنات 
ms268	 ضأن ، عبورا %~% سره أن تكوت كالزندبيل(@)(@@) 18 واصنعوا من حلاوة ذات طيب ، %~% لا برطلي يد الجردبيل(@)(@@) 19 إن تحلوا شاما ، فخمر جبال ، %~% أو عراقا ، فالشرب من نهر بيل(@)(@@) 20 وهي رومية لزنجية الأعناب %~% ناب ، فيها طعم من الزنجبيل(@)(@@) 21 ذات خرس ، تردد النطق أخ %~% أخرس يشكو عي اللسان الخبيل PageV01P1245(@)(@@) 22 قد أراكم تلطفا ، وهو في الغل %~% ظة من جرهم ، وآل عبيل(@)(@@) 23 موعد بالإجرام يوعد أم الن %~% سل فيه ، بالثكل والتهبيل(@)(@@) 24 فليحده على قرى حربته %~% كفر توتا منها وكفر تبيل(@)(@@) 25 كذب لا يزال يطعم خبزا ، %~% نص عن آدم وعن قابيل(@)(@@) 26 يمتريه جذلان مهتبل الغر %~% ة ، يبدي حزنا على هابيل(@)(@@) 27 لا تعري الليث المنون ولا الشبل %~% ل ، ولا المغفرات في إشبيل(@)(@@) 28 أنا بئس الإنسان ، والناس مثلي %~% فاعتبيني إن شئت أو فاعتبي لي(@)PageV01P1246(@)(@@) البحر : بسيط تام(@)(@@) 1 الناس ، للأرض ، أتباع ، إذا بخلت %~% ضنوا ، وإن هي جادت مرة جادوا(@)(@@) 2 تماجد القوم ، والالباب مخبرة %~% أن ليس ، في هذه الأجيال ، أمجاد(@)(@@) 3 والملك لله ، والدنيا بها غير ، %~% خير وشر وإعدام وإيجاد(@)(@@) 4 والناس شتى ، ولم يجمعهم غرض : %~% شد وحل وإتهام وإنجاد(@)(@@) 5 يا ليل ضدان : قوم في الدجى سهد %~% تهجدوك ، وقوم فيك هجاد(@)(@@) 6 أنجد أخاك على خبر يهم به %~% فالمؤمنون ، لدى الخيرات ، أنجاد(@)PageV01P1247(@)(@@) البحر : خفيف تام(@)(@@) 1 الفتى قد رأى اليقين ، ولكن %~% يؤثر العيش فهو كالمختول(@)(@@) 2 خير فيما رآه لامرأة الجندي %~% من بعد زوجها المقتول(@)(@@) 3 إذ أغارت حبل القناعة تمري %~% زق من عند خيطها المفتول(@)(@@) 4 خلصت من بناتها وبنيها ، %~% فهي ، بين النساء ، مثل البتول(@)PageV01P1248(@)(@@) البحر : متقارب تام(@)(@@) 1 لقد علم الله ، رب الكمال ، %~% بقلة علمي وديني ومالي(@)(@@) 2 وأن التجمل قد ضاق بي ، %~% فكيف أنافس أهل الجمال ؟(@)(@@) 3 أريد الإناخة في منزل ، %~% وقد حديت لسواه جمالي(@)(@@) 4 لقد خاب من يبتغي نصرتي ، %~% وعاجزة عن يميني شمالي(@)(@@) 5 فمن مخبري أغريق البحار %~% ألقى الردى أم دفين الرمال ؟(@)(@@) 6 هويت انفرادي ، كيما يخف ، %~% عن من أعاشر ثقل 
ms269	 احتمالي(@)(@@) 7 فماذا أقول ، وبين الأنام %~% م خلف على جهلهم ، أو تمالي ؟(@)(@@) 8 أما لي فيما أرى راحة %~% مدى الدهر ، من هذيان الأمال ؟(@)PageV01P1249(@)(@@) البحر : مخلع البسيط(@)(@@) 1 أنء صح لي أنني سعد %~% فليتني ضمنيي صعيد(@)(@@) 2 صمت حياتي إلى مماتي ، %~% لعل يوم الحمام عيد(@)(@@) 3 وراعني للحساب ذكر ، %~% وغرني أنه بعيد(@)(@@) 4 وعن يميني ، وعن شمالي %~% يصحبني حافظ قعيد(@)(@@) 5 حمامة في غصون أيك ، %~% ناحت فأنشأت أستعيد(@)(@@) 6 وما فقهت المراد منها ، %~% كل فقيه له معيد(@)(@@) 7 إذا رجونا قضاء وعد ، %~% فكيف لا يرهب الوعيد ؟(@)PageV01P1250(@)(@@) البحر : متقارب تام(@)(@@) 1 عجبت ، وكم عجب في الزمان %~% لرأي بني دهرك الفائل(@)(@@) 2 فمقتا لما أورثوا من غنى ، %~% وما وهبوه من النائل(@)(@@) 3 فلا تحملن لهم منة %~% ولو بت في صورة العائل(@)(@@) 4 يغول الفتى أرضه بالوجيف ، %~% ولا بد من حادث غائل(@)(@@) 5 ويطلب قوتا ، ورزق المليك %~% ك يسأل بالطالب السائل(@)(@@) 6 ألم ترني ، وجميع الأنا %~% م ، في دولة الكذب الذائل ؟(@)(@@) 7 مضى قيل مصر إلى ربه %~% وخلى السياسة للخائل(@)(@@) 8 وقالوا يعود فقلنا يجوز %~% بقدرة خالقنا الآثل(@)(@@) 9 إذا هب زيد إلى طيىء ، %~% وقام كليب إلى وائل(@)(@@) 10 أخو الحرب يغدو على سابح %~% ليسبح في الزاخر السائل PageV01P1251(@)(@@) 11 سيقصر من طول تلك القناة ، %~% ويرفع من درعه الذائل(@)(@@) 12 وتصغي إلى المين أسماعنا %~% ونصبو إلى زخرف القائل(@)(@@) 13 وكيف اعتدالي وهذا الزمان %~% يروح بميزانه المائل ؟(@)(@@) 14 وإن ثبيرا له خفة %~% تبين على كفة الشائل(@)(@@) 15 تصول علينا بنات الخطوب %~% فهلا يصال على الصائل !(@)(@@) 16 وقد عز رمل على حاسب %~% كما عز بحر على كائل(@)(@@) 17 يهال التراب على من ثوى ؛ %~% فآه من النبإ الهائل(@)(@@) 18 وكم قيد الدهر من دالف ، %~% وقد كان كالسابق الجائل(@)(@@) 19 جميع الذي نحن فيه النفاق ، %~% ونلحق بالذاهب الزائل(@)(@@) 20 ولو لم يكن حولك العاذلون %~% بكيت على المنزل الحائل PageV01P1252(@)(@@) 21 ويغنيك عن طرح فأل يعود %~% باليمن طعنك في الفائل(@)(@@) 22 نسر ، إذا نثرة أرعفت ، %~% ونفرح بالأسد البائل(@)PageV01P1253(@)(@@) البحر : وافر تام 
ms270	(@)(@@) 1 خمرت من الخمار ، وذاك نجس ، %~% وأما من خمارك فهو سعد(@)(@@) 2 ونفسك ظبية رتعت بقفر %~% يراقب أخذها المغوار جعد(@)(@@) 3 وزينب ، إن أصابتها المنايا ، %~% فهند من وسائقها ، ودعد(@)(@@) 4 جرت عاداتنا بسقوط غيث %~% تدل عليه بارقة ورعد(@)(@@) 5 شرور الدهر أكثر من بنيه ، %~% فقبل ، سطت على أمم ، وبعد(@)(@@) 6 تعجل ميت بالهلك نقدا ، %~% فمر ، وعنده للبعث وعد(@)PageV01P1254(@)(@@) البحر : متقارب تام(@)(@@) 1 أتاني بإسناده مخبر %~% وقد بان لي كذب الناقل(@)(@@) 2 أذو العصمة العاقل الآدمي %~% إلا كذي العصمة العاقل(@)(@@) 3 ولا فضل فينا ولكنها %~% حظوظ من الفلك الصاقل(@)(@@) 4 فهذا كسحبان لما احتبى %~% وذلك في سملي باقل(@)PageV01P1255(@)(@@) البحر : وافر تام(@)(@@) 1 أعد لبذلك الاحسان فضلا ، %~% وكم من معشر بخلوا وسادوا(@)(@@) 2 فجد إن شئت مربحة المعالي %~% فما للجود في سوق كساد(@)(@@) 3 أبيت المال بيت من مقال ، %~% متى ينقص يلم به الفساد ؟(@)PageV01P1256(@)(@@) البحر : متقارب تام(@)(@@) 1 إذا عشت مفتكرا في الأنام %~% غدوت على المدرج السابل(@)(@@) 2 فتلك الثريا وهذا الثرى %~% شبيهان في قبضة الجابل(@)(@@) 3 حبوت بنصحك مستكبرا ، %~% وما هو للنصح بالقابل(@)(@@) 4 وسخط الظباء بما نالها ، %~% تولد منه رضى الحابل(@)(@@) 5 هو الموت ، من ينج من رامح ، %~% فلا بد من أسهم النابل(@)(@@) 6 لنا أسوة في رجال مضوا ؛ %~% وهل أنا إلا أخو الآبل(@)(@@) 7 متى لمتماني على زلة ، %~% رجعت على أمي الهابل(@)(@@) 8 وهاروت ، كيف عصى ربه %~% بتعليمه السحر فيبابل(@)(@@) 9 إذا العام جاء بأدنى اليسار %~% ر ، أملت أسناه في القابل(@)(@@) 10 فإن القليل يؤم الكثي %~% كالطل بشر بالوابل(@)PageV01P1257(@)(@@) البحر : وافر تام(@)(@@) 1 يحرق نفسه الهندي خوفا %~% ويقصر ، دون ما صنع ، الجهاد(@)(@@) 2 وما فعلته عباد النصارى ، %~% ولا شرعية صبأوا وهادوا(@)(@@) 3 يقرب جسمه للنار عمدا %~% وذلك منه دين واجتهاد(@)(@@) 4 وموت المرء نوم طال جدا %~% عليه ، وكل عيشته سهاد(@)(@@) 5 نودع بالصلاة وداع يأس ، %~% ونترك في التراب فلا نهاد(@)(@@) 6 أهال من الثرى والأرض أم %~% وأمك حجرها نعم المهاد(@)(@@) 7 إذا الروح اللطيفة زايلتني ، %~% فلا هطلت على الرمم 
ms271	 العهاد(@)PageV01P1258(@)(@@) البحر : متقارب تام(@)(@@) 1 قرنت الجياد بأجمالها %~% لتسعف نفسا بآمالها(@)(@@) 2 ولا بد من سيرها مرة ، %~% بغير التفات إلى مالها(@)(@@) 3 وأفضل ما اكتسبت أمة ، %~% وإن شقيت ، حسن أعمالها(@)(@@) 4 ولا خير في أن تمد الحياة ، %~% ونقصانها مثل إكمالها(@)(@@) 5 فويها وواها لسيل المنون %~% كم جر عيرا بأحمالها(@)(@@) 6 أمور توافي جنود الردى %~% بتفصيلها ، بعد إجمالها(@)(@@) 7 فتفقد نسلا بإرمالها ؟ %~% فلم يغنهم طول إعمالها(@)(@@) 8 فهل يرمل الدهر أم الأنام(@)PageV01P1259(@)(@@) البحر : وافر تام(@)(@@) 1 تفوه دهركم عجبا فأصغوا %~% إلى ما ظل يخبر يا شهود(@)(@@) 2 إذا افتكر الذين لهم عقول %~% رأوا نبأ ، يحق له السهود(@)(@@) 3 غدا أهل الشرائع في آختلاف %~% تقض به المضاجع والمهود(@)(@@) 4 فقد كذبت على عيسى النصارى %~% كما كذبت على موسى اليهود(@)(@@) 5 ولم تستحدث الأيام خلقا ، %~% ولا حالت ، من الزمن ، العهود(@)PageV01P1260(@)(@@) البحر : بسيط تام(@)(@@) 1 إستعدت الخمر من أفعال شاربها %~% إلى المليك فقالت : شج ثم قتل(@)(@@) 2 وجارح الدن ما كانت جراحته %~% قصاص عمد ، ولكن للمدام ختل(@)(@@) 4 يود أن دجاه قار خابية %~% وأن كل غمام بالعقار هتل(@)(@@) 5 ماذا تريدين منه قد ظفرت به %~% ألم تريه صريعا في التراب يتل(@)PageV01P1261(@)(@@) البحر : وافر تام(@)(@@) 1 إذا بلغ الوليد لديك عشرا ، %~% فلا يدخل على الحرم الوليد(@)(@@) 2 فإن خالفتني وأضعت نصحي ، %~% فأنت وإن رزقت حجى ، بليد(@)(@@) 3 ألا إن النساء حبال غي %~% بهن يضيع الشرف التليد(@)PageV01P1262(@)(@@) البحر : مجزوء الكامل(@)(@@) 1 غض الجفون ، إذا جلس %~% ت على الصعيد ، ولا تأمل(@)(@@) 2 والبيت أولى بالكريم %~% م من الطريق ، وإن تجمل(@)(@@) 3 والذكر يتركه الفتى %~% للقاطنين ، إذا تحمل(@)(@@) 4 والمرء تعجبه الحياة %~% وعيشه سم مثمل(@)(@@) 5 من ذا الذي سمح الزمان %~% ن له بإدراك المؤمل ؟(@)(@@) 6 فيه توافى المرملون %~% وقل أصحاب المرمل(@)(@@) 7 حيل تمن على الأنا %~% م ، فأدمع العقلاء همل(@)(@@) 8 كم غر ، صاحبة الجما %~% منجم بحساب جمل(@)PageV01P1263(@)(@@) البحر : -(@)(@@) 1 الله إن أعطاك يجزل ، %~% وكأن هذا الدهر يهزل(@)(@@) 2 كسرى بنى إيوانه ، %~% والعنكبوت تظل تغزل(@)(@@) 3 هل 
ms272	 يشعرن الميت إن %~% ظهر الثرى ، بالحي ، زلزل ؟(@)(@@) 4 أرجوا ، أو اعتزلوا ، فإن %~% ي عن مقامكم بمعزل(@)(@@) 5 قد طال سيري في الحيا %~% ولي ببطن الأرض منزل(@)PageV01P1264(@)(@@) البحر : وافر تام(@)(@@) 1 تعالى الله ! ما تلقى المطايا %~% من الإنسان ، والدنيا تصيد(@)(@@) 2 إذا سلمت فتص في الموامي %~% قواصد ما به يفنى القصيد(@)(@@) 3 وما ينفك ، في السنوات ، منها %~% حليب ، أو نحير ، أو فصيد(@)(@@) 4 أتجزى الخير صيد من ركاب %~% كما تجزى من الأملاك صيد(@)(@@) 5 أم الإلغاء يشملها ، فتضحي ، %~% كأن سوامها زرع حصيد(@)(@@) 6 فكيف وربها في الحكم عدل %~% ودنياها ، لخالقها ، وصيد !(@)PageV01P1265(@)(@@) البحر : كامل تام(@)(@@) 1 لا كانت الدنيا فليس يسرني %~% أني خليفتها ، ولا محمودها(@)(@@) 2 وجهلت أمري غير أني سالك %~% طرقا ، وختها عادها وثمودها(@)(@@) 3 زعموا بأن الهضب سوف يذيبه %~% قدر ويحدث للبحار جمودها(@)(@@) 4 وتشاجروا في قبة الفلك ، التي %~% ما زال يعظم ، في النفوس ، عمودها(@)(@@) 5 فيقول ناس سوف يدركها الردى %~% ويمين قوم لا يجوز همودها(@)(@@) 6 أتدال يوما فضة من فضة %~% فيصير ، مثل سبيكة ، جلمودها ؟(@)(@@) 7 إن فرقت ، شهب الثريا ، نكبة ، %~% فلجذوة المريخ حق خمودها(@)(@@) 8 وإذا سيوف الهند أدركها البلى ، %~% فمن العجائب أن تدوم غمودها(@)PageV01P1266(@)(@@) البحر : منسرح(@)(@@) 1 قد بكرت لا يعوقها سبل ، %~% كمهرة الروض من بنات سبل(@)(@@) 2 إلى طبيب على الطريق ، لكي %~% تأخذ من عنده دواء حبل(@)(@@) 3 كم قذفت عرس بائس بحصى %~% كل حصاة منها نظير جبل(@)PageV01P1267(@)(@@) البحر : كامل تام(@)(@@) 1 أنا صائم طول الحياة ، وإنما %~% فطري الحمام ، ويوم ذاك أعيد(@)(@@) 2 لونان : من صبح وليل لونا %~% شعري ، وأضعفني الزمان الأيد(@)(@@) 3 والناس كالأشعار ينطق دهرهم %~% بهم : فمطلق معشر ومقيد(@)(@@) 4 قالوا : فلان جيد لصديقه ، %~% لا يكذبوا ، ماف يالبرية جيد(@)(@@) 5 فأميرهم نال الإمارة بالخنى ، %~% وتقيهم بصلاته متصيد(@)(@@) 6 كن من تشاء مهجنا أو خالصا %~% لإإذا رزقت غنى فأنت السيد(@)(@@) 7 وآصمت ، فما كثر الكلام من امرئ %~% إلا وظن بأنه متزيد(@)PageV01P1268(@)(@@) البحر : خفيف تام(@)(@@) 1 سبح الله طالع مستنير ، %~% وهلال مثل القلامة ناحل(@)(@@) 2 وبدت 
ms273	 ، من بنات نعش ، غوان ، %~% لم يصبها من إثمد الليل كاحل(@)(@@) 3 كالسوام الأنام ، هل فاز من %~% سافر منهم إلا بطي المراحل(@)(@@) 4 يمني وفارسي وشامي %~% وغاد ، من أهل غربة ، راحل(@)(@@) 5 ساحليون ، لم أرد ساحل البح %~% ولكن نسبا لأقمر ساحل(@)(@@) 6 خف ملك على السرير ، فهل يو %~% يوجد في العالمين قرم حلاحل(@)PageV01P1269(@)(@@) البحر : كامل تام(@)(@@) 1 قد كان قبلك ذادة ومقاول %~% ذادوا فما صرف الحطوب ذياد(@)(@@) 2 أمراء ، حكام كأيام أتت ، %~% شفعا بها ، الجمعات والأعياد(@)(@@) 3 كزياد الأموي ، أو كزياد الم %~% إذ ولى ، فأين زياد(@)(@@) 4 تثنى الخناصر في الكرام عليهم ، %~% وتمد نحو سناهم الأجياد(@)(@@) 5 والمطلقات ، من النفوس ، كأنما %~% جمعت لها الأغلال والأقياد(@)(@@) 6 وحبائل الأيام ليس بمفلت %~% صقر مكائدها ، ولا فياد(@)PageV01P1270(@)(@@) البحر : -(@)(@@) 1 عجبا للقطا ، من الكدر والجو %~% ن ، غدت في عنائها المتواصل(@)(@@) 2 لقطت حبة وجاءت بها الأفرا %~% خ ثم استقت لها في الحواصل(@)(@@) 3 من بلاد بعيدة ، لسراب ال %~% هجر ، فيها ، لوامع كالمناصل(@)(@@) 4 فأغاثت بوردها مودعات %~% في هجول تقل فيها الصلاصل(@)(@@) 5 هائفات ، قد مزق الحر عنها %~% الأهب ، أو هم أن يميز المفاصل(@)(@@) 6 راعها أجدل من الطير ، أو با %~% ز ، فمود ، قبل الوصول ، وواصل(@)(@@) 7 صاليات وما لها من صلاة %~% صائمات لغير نسك تواصل(@)(@@) 8 ثم باد المصيد ، من بعد ، والصا %~% ئد ، لا شيء غير ذلك حاصل(@)(@@) 9 فاتق الله وافعل الخير فالموت %~% ت حسام يفري البرية قاصل(@)(@@) 10 لا تغير هذا البياض ، فإن تأ %~% ب فلا تجزعن إن قيل : ناصل PageV01P1271(@)(@@) 11 إن أعمارنا كآي أبينت %~% والمنايا لهن مثل الفواصل(@)PageV01P1272(@)(@@) البحر : كامل تام(@)(@@) 1 الله أكبر ! ما اشتريت بضاعة ، %~% إلا وأدرك ، سوقها ، الإكساد(@)(@@) 2 بدن بلا بدن يعيش ، وكم طوى %~% جسد سنيه وما عليه جساد(@)(@@) 3 أضحت تظن بك الديانة والغنى %~% والعلم ، فاهتاجت لك الحساد(@)(@@) 4 ولقد صفرت من الثلاث ، كإنما %~% أدم حواك ، من الخلو ، مساد(@)(@@) 5 شغل ، السعادة عنك ، أهل ممالك %~% رزقوا الذي حرم الكرام ، وسادوا(@)(@@) 6 رقدوا ، ولم ترقد ، ونالوا ما ابتغوا 
ms274	 ، %~% وعجزت عنه ، وللكيان فساد(@)(@@) 7 ومن المعاشر من يظل كأنه %~% ضمن الفؤاد ، يساد حين يساد(@)(@@) 8 خمدت خواطر منهم ، وتكاثفت %~% أرواحهم ، فكأنهم أجساد . . . .(@)(@@) 9 مهدت لهم فرش ، وبات لديهم %~% وسد ، وبت ما لديك وساد(@)(@@) 10 من يؤت حظا يبتهج ، ويكن له %~% عز ، فترهب ، ضأنه ، الآساد PageV01P1273(@)(@@) 11 ولو ادعى ظبي الفلاة ولاءه %~% لعداه ، من قناصه ، الإيساد(@)PageV01P1274(@)(@@) البحر : -(@)(@@) 1 فر من هذه البرية في الأرض %~% ض ، فما غير شرها لك حاصل(@)(@@) 2 فشعاري قاطع وكان شعارا %~% لتنوخ ، في سالف الدهر ، واصل(@)(@@) 3 واطلب الرزق بالمرور من الشجراء ، %~% راء ، لا من أسنة ومناصل(@)(@@) 4 وتشبه بالطير تغدو خماصا %~% وتعد اليسار ملء الحواصل(@)PageV01P1275(@)(@@) البحر : كامل تام(@)(@@) 1 ما سرني أني إمام زمانه ، %~% تلقى إلي من الامور مقالد(@)(@@) 2 يا حار ! إن العمر حار ، فانتبه ! %~% يا خالد اتق ليس يعرف خالد(@)(@@) 3 فعلام تجتلب الحمام بجهلها %~% مهج تطاعن في الوغى ، وتجالد ؟(@)(@@) 4 يرجو الأب الطفل الصغير ، وطالما %~% هلك الوليد وعاش فينا الوالد(@)PageV01P1276(@)(@@) البحر : مجزوء الخفيف(@)(@@) 1 رام دنياه ناسك ، %~% فادعى النسك وانتحل(@)(@@) 2 أصبح المفتري على الله %~% قد ذل واضمحل(@)(@@) 3 بينما يعمر المنا %~% زل ، قالوا : قد ارتحل(@)(@@) 4 عز رب النجوم تس %~% ري ، ولا تسأم الرحل(@)(@@) 5 أينام السماك أم %~% هو بالغمض ما اكتحل(@)(@@) 6 جهل المشتري وإن كان %~% كان في الخير ذا محل(@)(@@) 7 أي ذنب أصابه ، %~% فسما فوقه زحل ؟(@)PageV01P1277(@)(@@) البحر : كامل تام(@)(@@) 1 آليت ما مثري الزمان ، وإن طغى ، %~% مثر ، ولا مسعوده مسعود(@)(@@) 2 فتلك أشرف من مؤنثة %~% نجلت فضاق بنسلها البلد(@)(@@) 2 ما سر غاوينا الجهول ، وإنما %~% هتف الحمام به وناح العود(@)(@@) 3 كاساته الملأى ، وعزف قيانه %~% للحادثات بوارق ورعود(@)(@@) 4 هلكت سعود ، في القبائل ، جمة ؛ %~% وأقام ، في جو السماء ، سعود(@)(@@) 5 بدر يصور ثم يمحق نوره %~% ويغرب المريخ ، ثم يعود(@)(@@) 6 لا تحملن ثقلا علي فإن بي %~% وهنا ، وقدام الركاب ، صعود(@)(@@) 7 والوعد يرقب ، والنجاح لمثلنا %~% أن يستمر ، بمطله ، الموعود(@)(@@) 8 ومن العجائب ظن قوم أنه %~% يثني الفتى بالغي وهو 
ms275	 قعود(@)PageV01P1278(@)(@@) البحر : متقارب تام(@)(@@) 1 أتتك بحبل فتاة غدت %~% مسائلة عن دواء الحبل(@)(@@) 2 وقد حييت من بنات السهول %~% فجاءت بإحدى بنات الجبل(@)PageV01P1279(@)(@@) البحر : مجزوء المتقارب(@)(@@) 1 أمل حبيب أدل ، %~% وستر الضلال انسدل(@)(@@) 2 علام تناظرتم %~% فقد طال هذا الجدل(@)(@@) 3 تعليكم في الأمو %~% ر ، ما هو إلا تدل(@)(@@) 4 وكلكم ظالم %~% فهل من تقي عدل ؟(@)(@@) 5 وتهلك ذات الكرا ، %~% وتهلك ذات الخدل(@)(@@) 6 تقادم شخص مضى ، %~% فأحدث منه البدل(@)(@@) 7 وما صح إلا امرؤ %~% تصرف ثم انجدل(@)(@@) 8 غلا كاذب صادقا %~% فليت المزاج اعتدل(@)(@@) 9 إذا هدر الفحل قي %~% ل : صوت حمام هدل(@)(@@) 10 تحير مسترشد ، %~% فوفق لما استدل(@)PageV01P1280(@)(@@) البحر : سريع(@)(@@) 1 يا سابحا يصهل في غرة %~% أين وجيه الخيل والذائد ؟(@)(@@) 2 لدى له في الدهر ما يبتغي %~% ثم أتاه قدر آئد(@)(@@) 3 هل يأمن الحوت من الشهب أن %~% يأخذه ، في الكفة ، الصائد ؟(@)(@@) 4 أو حمل نزه في الجو أن %~% يغتاله بالمدية الكائد(@)(@@) 5 إن كان للمريخ عقل ، فما %~% يستر عنه أنه بائد(@)(@@) 6 يوصي الفتى بالأمر ، من بعده ، %~% كأنه ، من بينه ، عائد(@)(@@) 7 يكذبني الرائد في زعمه %~% ومهلك ، إن كذب ، الرائد(@)(@@) 9 فوائد الأيام محبوبة ، %~% وفاقد لذتها الفائد(@)(@@) 10 فزج دنياك ، فما يخلد ال %~% الناقص في العيش ولا الزائد(@)(@@) 11 فإن منهاج الردى يستوي %~% فيه مسود القوم والسائد PageV01P1281(@)(@@) 12 وإنما يلقى شجاع الوغى ، %~% كما يلاقي النافر الحائد(@)(@@) 13 تقصف بالقدرة رضوى كما %~% يقصف هذا الغصن المائد(@)(@@) 14 ولو درى الموؤود ما عندنا %~% من نبأ ، ما عتب الوائد(@)(@@) 15 قد شيد القصر لسكانه ، %~% وغير من يسكنه الشائد(@)PageV01P1282(@)(@@) البحر : طويل(@)(@@) 1 سيسأل ناس : ما قريش ومكة ؟ %~% كما قال ناس : ما جديس وما طسم ؟(@)(@@) 2 أرى الوقت يفني أنفسا بفنائه ، %~% ويمحو فما يبقى الحديث ولا الرسم(@)(@@) 3 لقد جد أهل الملعبين ، فأثلوا %~% بناء ، ولم يثبت لرافعه وسم(@)(@@) 4 وفي العالم الغاوي بخيل ممول ، %~% وسمح فقير ، شد ما اختلف القسم(@)(@@) 5 وكون الفتى في رهطه نيل عزة ، %~% على أن داء الدهر ليس 
ms276	 له حسم(@)(@@) 6 ويرزأ جسم المرء حتى إذا أوى %~% إلى العنصر التربي لم يرزإ الجسم(@)PageV01P1283(@)(@@) البحر : سريع(@)(@@) 1 إن شربوا الراح ، فما شربنا ، %~% في الراح إلا الأزرق البارد(@)(@@) 2 لا تطرد الوحش ، فما يلبث ال %~% المطرود في الدنيا ولا الطارد(@)(@@) 3 أخت بني الصارد في دهرها %~% أصابها سهم ردى ، صارد(@)(@@) 4 كان لها كرمان ، هذا أبى ال %~% السقيا وهذا أبدا وارد(@)(@@) 5 لا توحش الوحدة أصحابها ، %~% إن سهيلا وحده فارد(@)(@@) 6 وكم نرى في الأفق من كوكب %~% يعظم أن يرمى به المارد(@)(@@) 7 خبرتني أمرا فقل راشدا ، %~% من أين هذا الخبر الشارد(@)(@@) 8 عليك بالصدق فلا حظ لي %~% في كذب ، ينظمه السارد(@)(@@) 9 من يدن للشاكة أثوابه %~% يصبه منها غصن هارد(@)PageV01P1284(@)(@@) البحر : طويل(@)(@@) 1 مكان ودهر أحرزا كل مدرك %~% وما لهما لون يحس ولا حجم(@)(@@) 2 وليس لنا علم بسر إلهنا %~% فهل علمته الشمس ، أو شعر النجم ؟(@)(@@) 3 ونحن غواة يرجم الظن بعضنا ، %~% ليعرف ما نور الكواكب والرجم(@)(@@) 4 وتطردنا ساعاتنا فكأننا %~% وسائق خيل ، ما تكفكفها اللجم(@)(@@) 5 قضى الله في وقت مضى أن عامكم %~% يقل حياه ، أو يزيد به السجم(@)(@@) 6 فقولكم : رب اسقنا ، غير ممطر ، %~% ولكن بهذا دانت العرب والعجم(@)(@@) 7 على كل شيء تهجمون بجهلكم ، %~% وأعياكم يوما ، على رشد ، هجم(@)PageV01P1285(@)(@@) البحر : طويل(@)(@@) 1 كبار أناس مثل جلة سائم ، %~% يربون أطفالا كما ارتضع البهم(@)(@@) 2 توهم بعض الناس أمرا ، فأصلوا %~% يقين أمور بات يبعثها الوهم(@)(@@) 3 جهلنا ولكن للخلائق صانع ، %~% أقر به فسل من القوم ، أو شهم(@)(@@) 4 ويعلم كل أن للخير موضعا %~% وفضلا ، على إثباته أجمع الدهم(@)(@@) 5 وأين أناس كالسحائب إن يروا %~% يروقوا ، وإن يستمطروا للغنى يهموا ؟(@)(@@) 6 فإن شئت أن تحظى بمالك ، فاحبه %~% ذوي الحاج ، أو أنفقه يبسم لك الجهم(@)(@@) 7 فما هو إلا السهم لا كف عاديا %~% ولا نال صيدا ، في كنانته ، السهم(@)PageV01P1286(@)(@@) البحر : خفيف تام(@)(@@) 1 صاح ، ما تضحك البروق شماتا %~% بحمام ، ولا تبكي الرعود(@)(@@) 2 يا محلي ، عليك مني سلام ، %~% سوف أمضي 
ms277	 وينجز الموعود(@)(@@) 3 ليت شعري ، عمن يحلك بعدي ، %~% أقيام لصالح أم قعود ؟(@)(@@) 4 أيرجون أن أعود إليهم %~% لا ترجوا ، فإنني لا أعود !(@)(@@) 5 ولجسمي إلى التراب هبوط ، %~% ولروحي إلى الهواء صعود(@)(@@) 6 وعلى حالها تدوم الليالي ، %~% فنحوس لمعشر أو سعود(@)PageV01P1287(@)(@@) البحر : طويل(@)(@@) 1 خلافك بعض الناس ترجى به المنى %~% وفي الدهر أقوام خلافهم حزم(@)(@@) 2 فأفطر ، إذا صاموا ، وصم عند فطرهم %~% على خبرة ، إن الدواء هو الأزم(@)(@@) 3 ولو لم يسر وقت الفتى ، وهو موشك ، %~% لما صح في هجر الحياة له عزم(@)(@@) 4 ألا ذللوا هذي النفوس ، فإنها ، %~% ركائب سوء ، ليس يضبطها الحزم(@)(@@) 5 ولم يأت في الدنيا القديمة منصف ، %~% ولا هو آت ، بل تظالمنا جزم(@)PageV01P1288(@)(@@) البحر : طويل(@)(@@) 1 يحدثكم أن البلاد مقيمة %~% على ما عهدتم ، ذلك الهضب والوهدا(@)(@@) 2 ولم تفتأ الدنيا تغر خليلها ، %~% وتبدله من غمض أجفانه سهدا(@)(@@) 3 تريه الدجى في هيأة النور خدعة %~% وتطعمه صابا فيحسبه شهدا(@)(@@) 4 وقد حلمته فوق نعش ، وطالما %~% سرى فوق عنس ، أو على فرسا نهدى(@)(@@) 7 ولم تترك من حيلة لثغره %~% ولم يبق ، في إخلاصه ، حبها جهدا(@)PageV01P1289(@)(@@) البحر : طويل(@)(@@) 1 ألا ترحم الأشياخ لما تأودوا ، %~% يقولون : قد كنا الغرانقة المردا(@)(@@) 2 تردوا بخضر من جديد واقبلوا %~% على الخيل تردي وهي من فوقها تردى(@)(@@) 3 وجاؤوا بها سوم الجراد ، مغيرة ، %~% يقودون للموت المطهمة الجردا(@)(@@) 4 ترى الهم لا شيء سوى الأكل همه %~% له جسد ما اسطاع حرا ولا بردا(@)(@@) 5 يقل العصا مستثقل الطمر ، بعدما %~% علا فرسا ، واجتاب ماذية سردا(@)(@@) 6 ولا تترك الأيام مردى لظبية %~% من الأدم تختار الكباث أو المردا(@)(@@) 7 ولم يلف منها فارد القمر مخلصا %~% وقد بلغت أحداثها القمر الفردا(@)(@@) 8 وجدنا دريدا من هوازن لم يجد %~% صروف الليالي حين تأكله دردا(@)(@@) 9 رعت قبل نبتا جد عدنان ، واعترت %~% إيادا ، فأبلت من قبيلها بردا(@)(@@) 10 يخوف ، بالذئب ، المسن ، وقد مضى %~% له زمن ، لا يرهب الأسد الوردا PageV01P1290(@)(@@) 11 نزلنا بدار كالضيوف ، ولم نرد %~% براحا لها ، حتى أجدت لنا طردا 
ms278	(@)PageV01P1291(@)(@@) البحر : طويل(@)(@@) 1 أراك حسبت النجم ليس بواعظ %~% لبببا ، وخلت البدر لا يتكلم(@)(@@) 2 بلى ، قد أتانا أن ما كان زائل ، %~% ولكننا في عالم ليس يعلم(@)(@@) 3 وإن أخا دنياك أعمى يرى السهى ، %~% عليل معافى ظالم يتظلم(@)(@@) 4 فهل تألم ، الشمس الحوادث مثلنا ، %~% أم اتسقت كالهضب لا يتألم(@)(@@) 5 وهل فيكم من باخل يظهر الندى %~% رياء به ، أو جاهل يتحلم ؟(@)(@@) 6 وما سالم الحي القضاء ، وإنما %~% إلى الحتف يرقى ، والسلامة سلم(@)(@@) 7 فيا مطلقا للنفع ، يفصد كفه ، %~% أبالكلم يستشفي الأسير المكلم ؟(@)(@@) 8 لعمري لقد أعيا المقاييس أمرنا ، %~% فحندسنا ، عند الظهيرة ، مظلم(@)(@@) 9 فمن محرم لا يحرم العلق الظبى %~% ومن محرم أظفاره لا تقلم(@)(@@) 10 ضعفنا عن الأشياء ، إلا عن الأذى %~% وقد يسم الوجه الكهام المثلم PageV01P1292(@)(@@) 11 فإن ظليم الفقر يرضيه زفه ، %~% ويفهم عن أخدانه ، وهو أصلم(@)PageV01P1293(@)(@@) البحر : طويل(@)(@@) 1 أرى حيوان الأرض ، غير أنيسها ، %~% إذا اقتات لم يفرح بظلم ولا جدا(@)(@@) 2 أتعلم أسد الغيل ، بعد افتراسها ، %~% تحاول درا ، أو تحاول عسجدا ؟(@)(@@) 3 وما اتخذ الأبراد سرحان قفرة ، %~% ولا شب نارا أين غار وأنجدا(@)(@@) 4 وأضعف من تلقاه من آل آدم ، %~% إذا ما شتا يبغي وقودا وبرجدا(@)(@@) 5 وأنصفهم ما هابت الوحش سبه %~% ولا وقعت من خشية الله سجدا(@)PageV01P1294(@)(@@) البحر : طويل(@)(@@) 1 توهمت خيرا في الزمان وأهله ، %~% وكان خيالا ، لا يصح ، التوهم(@)(@@) 2 فما النجم نوار ولا الفجر جدول %~% ولا الشمس دينار ولا البدر درهم(@)(@@) 3 رأيتك لم تحمد من الترك معشرا ، %~% لهم عارض بالترك يهمي ويرهم(@)(@@) 4 ولا الكاسك المرجين في كل مظلم %~% رجا كاسك الحمراء ، والخيل تدهم(@)(@@) 5 وقد يأمر الله الكهام ، إذا نبا ، %~% فيفري ، وقد ينهى الحسام فيكهم(@)(@@) 6 وإنك لا باك عليك مهند ، %~% ولا مظهر حزنا جواد مطهم(@)(@@) 7 يساوي مليك الحي صعلوك قومه %~% وتسحى له الأرض الزرود فتلهم(@)(@@) 8 وما يشعر المدفون يسري حديثه %~% فينجد في أقصى البلاد ، ويتهم(@)(@@) 9 جرت عند شقراء الكميت بكفه %~% إلى فيه ، حتى صار في الرجل أدهم(@)(@@) 10 أتذكر ، يا 
ms279	 طرف ، الوغى وركومها ، %~% وقد صرت من نبل ، كأنك شيهم PageV01P1295(@)(@@) 11 إذا انتزعت فيك الأسنة ردها %~% لصونك تجفاف عن الطعن مبهم(@)(@@) 12 بشهباء يخفي القرن فيها كلامه %~% ويفهم ، إلا أنه ليس يفهم(@)(@@) 13 إذا ما تدانوا ، فالضراب صفاحهم ؛ %~% وإن يتناءوا ، فالرسائل أسهم(@)(@@) 14 لهم حيل في حربهم ما اهتدت لها %~% جديس ، ولا ساست بها الملك جرهم(@)PageV01P1296(@)(@@) البحر : طويل(@)(@@) 1 مريدي بقائي ، طالما لقي الفتى %~% عناء بطول العيش ، والله يعلم(@)(@@) 2 إذا كان بسط العمر ليس بكاسب %~% سوى شقوة ، فالموت خير وأسلم(@)(@@) 4 أفاد غوي غيه عن شيوخه ، %~% فهم درجات للضلال وسلم(@)(@@) 5 وأهلكه جهلان : باد مركب %~% قديما ، وتال ، بعده ، يتعلم(@)(@@) 6 تفكرت واستثبت أن سكوته ، %~% هدى وتقى ، فليغد لا يتكلم(@)(@@) 7 أرى النبت أولى أن يحس بحطمه ، %~% إذا زعموا أن الصخور تألم(@)(@@) 8 أشهد أن الدهر كالحلم زائل ؛ %~% وأن أديم البدر يبلى ويحلم(@)(@@) 9 وجدت يد الوهاب تطوى ، وعينه %~% تكف ، وأظفار الليوث تقلم(@)PageV01P1297(@)(@@) البحر : بسيط تام(@)(@@) 1 قد ساءها العقم ، لا ضمت ولا ولدت ! %~% وذا خير لها لو أعطيت رشدا(@)(@@) 2 ما يأخذ الموت من نفس لمنفرد %~% شيئا سواها ، إذا ما آغتال أو حشدا(@)(@@) 3 ومنشد الخير لا تصغي له أذن ، %~% قد ضل مذ كانت الدنيا فما نشدا(@)PageV01P1298(@)(@@) البحر : طويل(@)(@@) 1 سأرحل عن وشك ولست بعالم %~% على أي أمر ، لا أبا لك ، أقدم(@)(@@) 2 وهون إعدامي علي تحققي %~% بأني وإن طال التمكث ، أعدم(@)(@@) 3 فإن لم يكن إلا الحياة وبينها ، %~% فلست ، على أيامها ، أتندم(@)(@@) 4 ودنياك يهواها ، على الهرم ، الفتى ، %~% ويخدمها فيما ينوب المخدم(@)(@@) 5 أرى الشخص يطوى والممالك تحتوى ، %~% ومن صح يدوى ، والمجادل تهدم(@)(@@) 6 منعت الهوى مني ، وسمتني الهوى ، %~% وقد يبلغ الحاج الفنيق المسدم(@)(@@) 7 إذا رؤساء الناس أموا تنازعوا %~% كؤوس الأذى ، هل في الزجاجة عندم(@)(@@) 8 ولم يرضهم شرب المدامة أذهبت %~% جحى النفس ، إلا أن يمازجها الدم(@)(@@) 9 ونحن كأيم الضال أولى مراسه %~% بما كان يغوي الآخر ، المتقدم(@)(@@) 10 وحواء أعطت بنتها البؤس ، وابنها %~% لآدم ، يغذى بالشقاء ويؤدم 
ms280	(@)PageV01P1299(@)(@@) البحر : بسيط تام(@)(@@) 1 من عاش تسعين حولا فهو مغترب %~% قد زايل الأهل الا معشرا جددا(@)(@@) 2 و شاهد الناس من كهل ومقتبل %~% و دالف الخطو لا يحصي لهم عددا(@)PageV01P1300(@)(@@) البحر : طويل(@)(@@) 1 أيا ديك ! عدت من أياديك ، صيحة %~% بعثت بها ميت الكرى ، وهو نائم(@)(@@) 2 هتفت ، فقال الناس : أوس بن معير ، %~% أو ابن رباح ، بالمحلة قائم(@)(@@) 3 لعل بلالا هب من طول رقدة %~% وقد بليت في الأرض تلك الرمائم(@)(@@) 4 ونعم أذين المعشر ابن حمامة %~% إذا سجعت ، للذاكرين ، الحمائم(@)(@@) 5 وفيك ، إذا ما ضيع النكس ، غيرة %~% تصان بها المستصحبات الكرائم(@)(@@) 6 وجود بموجود النوال على التي %~% حميت ، وإن لم تستهل الغمائم(@)(@@) 7 يزان لديك الطعن في حومة الوغى ، %~% إذا زينت للعاجزين الهزائم(@)(@@) 8 فلو كنت بالدر الثمين معوضا %~% من البر ، ما لامت عليه اللوائم(@)(@@) 9 وتلقي لديك المنقضات نواصعا %~% يقال غريبات البحار التوائم(@)(@@) 10 رآها كبارا من رآها كأنها %~% تريك نعام أودعته الصرائم PageV01P1301(@)(@@) 11 وتؤثر بالقوت الحليلة شيمة %~% كريمية ، ما استعملتها الألائم(@)(@@) 12 كأنك فحل الشول حولك أينق %~% عليها برى ، من طاعة ، وخزائم(@)(@@) 13 فتلمح ، تارات ، وتغضي ، كأنها %~% ضرائر شفتها لديك الخصائم(@)(@@) 14 فحمر وسود حالكات كأنها %~% سوام بني السيد ازدهته القوائم(@)(@@) 15 عليك ثياب خاطها الله قادرا ، %~% بها رئمتك العاطفات الروائم(@)(@@) 16 وتاجك معقود كأنك هرمز %~% يباهي به أملاكه ، ويوائم(@)(@@) 17 وعينك سقط ، ما خبا عند قرة ، %~% كلمعة برق ما لها الدهر شائم(@)(@@) 18 وما افتقرت يوما إلى موقد لها %~% إذا قربت للموقدين الهشائم(@)(@@) 19 ورثت هدى التذكار من قبل جرهم ، %~% أوان ترقت ، في السماء ، النعائم(@)(@@) 20 وما زلت ، للدين القديم ، دعامة ، %~% إذا قلقت من حامليه الدعائم PageV01P1302(@)(@@) 21 ولو كنت لي ، ما أرهفت لك مدية ، %~% ولا رام إفطارا بأكلك صائم(@)(@@) 22 ولم يغل ماء كي تمزق حلة ، %~% حبتك بأسناها العصور القدائم(@)(@@) 23 ولا عمت في الخمر التي حال طعمها %~% كأنك في غمر من السيل عائم(@)(@@) 24 ولاقيت عندي الخير ، تحسب عيلا %~% ينافيك قول سيئ وشتائم(@)(@@) 25 فإن كتب 