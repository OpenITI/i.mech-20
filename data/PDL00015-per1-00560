ms558	 بهاری چو خزانی PageV1P0632(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از خانه برون رفتم من دوش به نادانی %~% تو قصه من بشنو تا چون به عجب مانی(@)(@@) 2 از کوه فرود آمد زین پیری نورانی %~% پیداش مسلمانی در عرصه بلسانی(@)(@@) 3 چون دید مرا گفت او داری سر مهمانی %~% گفتم که بلی دارم بی سستی و کسلانی(@)(@@) 4 گفتا که هلاهین رو گر بر سر پیمانی %~% دانم که مرا زین پس نومید نگردانی(@)(@@) 5 رفتم به سرایی خوش پاکیزه و سلطانی %~% نه عیب ز همسایه نه بیم ز ویرانی(@)(@@) 6 در وی نفری دیدم پیران خراباتی %~% قومی همه قلاشان چون دیو بیابانی(@)(@@) 7 معروف به بی سیمی مشهور به بی نانی %~% همچون الف کوفی از عوری و عریانی(@)(@@) 8 این باخته دراعه و آن باخته بارانی %~% این گفته که بستانی وان گفته که نستانی(@)(@@) 9 می گفت یکی رستم زان ظلمت نفسانی %~% می گفت یکی دیگر ما «اعظم برهانی»(@)(@@) 10 این گفت «انا الاول» کس نیست مرا ثانی %~% و آن گفت «انا آلاخر» تا خلق شود فانی(@)(@@) 11 ماندم متحیر من زان حال ز حیرانی %~% گفتم که چو قومند این ای خواجه روحانی(@)(@@) 12 گفت: اهل خراباتند این قوم نمی‌دانی %~% آنها که تو ایشان را قلاش همی دانی(@)(@@) 13 هان تا نکنی انکار گر بر سر پیمانی %~% کایشان هذیان گویند از مستی و نادانی(@)(@@) 14 ار این گنهی منکر در مذهب ایشانی %~% باید که تو این اسار از خلق بپوشانی(@)(@@) 15 زنهار از این معنی بر خلق سخنرانی %~% پندار که نشنیدی اندر حد نسیانی(@)(@@) 16 ای آنکه ز قلاشی بر خلق تو ترسانی %~% در زهد عبادت آر چون بوذر و سلمانی(@)(@@) 17 در خدمت این مردم تا تن به نرنجانی %~% حقا که تو بر هیچی چون زاهد او ثانی(@)(@@) 18 چون شاد نباشم من از رحمت یزدانی %~% دیدار چنین قومی دارد به من ارزانی(@)(@@) 19 تا دید سنایی را در مجلس روحانی %~% با دست 
ms559	 به دست او زین زهد به سامانی(@)(@@) 20 امروز بدانست او کان صدر مسلمانی %~% چون گفت ز بی خویشی سبحانی و سبحانی PageV1P0633(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 زیر دام عشوه تا چند ای سنایی دم زنی %~% گاه آن آمد یکی کاین دام و دم بر هم زنی(@)(@@) 2 از دم خویشی تو دایم مانده اندر دام دیو %~% گر برون آیی ملک گردی و جام جم زنی(@)(@@) 3 با تو اندر پوست باشد بی‌گمان ابلیس تو %~% تا تو اندر عشق دم در خانه آدم زنی(@)(@@) 4 چون نگفتی لا مگو الله و اثباتی مکن %~% گر قدم در کوی نفی خود نهی محکم زنی(@)(@@) 5 گویی الاالله و آنگاهی ز کوته دیدگی %~% گه رقم بر علم و گاهی تکیه بر عالم زنی(@)(@@) 6 در نهاد تو دو صد فرعون با دعوی هنوز %~% تو همی خواهی که چون موسا عصا بر یم زنی(@)(@@) 7 از مراد خود تبرا کن اگر خواهی که تو %~% در میان بی‌مرادان یک نفس بی غم زنی(@)(@@) 8 چون ولایتها گرفت اندر تنت دیو سپید %~% رستم راهی گر او را ضربت رستم زنی(@)(@@) 9 کی دهد عیسا ترا از جوی عین‌السلوی آب %~% چون تو عمدا آتش اندر چادر مریم زنی(@)(@@) 10 نشنود گوش تو هرگز صوت موسیقار عشق %~% تا تو در بزم مراد خویش زیر و بم زنی(@)(@@) 11 پای بیرون نه ز گلزار و به گلزار اندر آی %~% تا به دست نیستی با پاکبازان کم زنی(@)(@@) 12 عشق خرگه کی زند اندر هوای سر تو %~% تا تو خرگه زیر جعد زلف خم در خم زنی(@)(@@) 13 حال را با قال همره کن تو اندر راه عشق %~% ورنه چون بی‌مایگان تا کی دم مبهم زنی PageV1P0634(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بیا تا اهل معنی را درین عالم به غم بینی %~% بیا تا لطف ربانی و احسان و کرم بینی(@)(@@) 2 بیا تا سوز مشتاقان و راه بی‌دلان بینی %~% ز اوتادان و ابدالان علم 
ms560	 اندر علم بینی(@)(@@) 3 همه صحرای روحانی پر از مردان حق بینی %~% ز صوت و ذوق داوودی همه جانها خرم بینی(@)(@@) 4 ازین زندان سلطانی دل و جان را دژم یابی %~% ز شادی جان هر مومن چو بستان ارم بینی(@)(@@) 5 گهی جنات اعلا را مکان خویشتن بینی %~% گهی خود را در آن میدان بدان مردان به هم بینی(@)(@@) 6 نبینی در مسلمانی به جز رسمی و گفتاری %~% ز افعال مسلمانان درین مردان رقم بینی(@)(@@) 7 برفتند از جهان یکسر همه مردان درین کشته %~% کنون آفاق سرتاسر همه ظلم و ستم بینی(@)(@@) 8 چه بویی سوی این میدان چه گردی گرد این زندان %~% چه بندی دل درین ایوان که چندین دردو غم بینی(@)(@@) 9 جهان را سیرت و آیین چنینست ای مسلمانان %~% که مردان حقیقت را درین عالم دژم بینی(@)(@@) 10 نبینی هیچ مردی را که با وی صدق همراهست %~% اگر بینی چنان بینی که گرگی در حرم بینی(@)(@@) 11 چگونه مرد با تحقیق روی خویش بنماید %~% کزان تحقیق‌ها حالی تو لا یابی و لم بینی(@)(@@) 12 حرام اندر کدام آیین حلالست ای مسلمانان %~% حرامی را سلم خوانی ز قسام این قسم بینی(@)(@@) 13 نترسی هیچ از ایزد نپرسی هیچ از عدلش %~% ولیکن راحت و شادی تو از سود و سلم بینی(@)(@@) 14 بدین زندان خاموشان یکی از چشم دل بنگر %~% که آنجا صدهزاران کس ندیم صد ندم بینی(@)(@@) 15 نه آنجا مهتری باشد نه آنجا کهتری باشد %~% نه آنجا سروری باشد نه خیل و نه حشم بینی(@)(@@) 16 نه ملک روم وری بینی نه رطل و جام می بینی %~% نه طبل و نای و نی بینی نه بانگ زیر و بم بینی(@)(@@) 17 نه داد عادلان ماند نه ظلم ظالمان ماند %~% نه جور جابران ماند نه مخدوم و خدم بینی(@)(@@) 18 به زیر سنگ و گل بینی همه شاهان عالم را %~% کجا آن روز در گیتی ملوکان عجم بینی 