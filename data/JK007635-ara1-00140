ms121	 بلا ثمن % لا أشتكي في صفقتي غبنا % % 15(@)(@@) % غراء يحكي الصبح غرتها % % لكن صبح جبينها أسنى % % 16(@)(@@) % تربو على أترابها حفرا % وتفوق غر لداتها حسنا % % 17(@)(@@) % نشرت ذوائبها على قمر % وثنت على حقف النقا غصنا % % 18(@)(@@) % لله أي محاسن جليت % % لو كان يشفع حسنها حسني % % 19(@)(@@) % ومؤنب فيها يزخرف لي % % نصحا وليس لنصحه معنى % % 20(@)(@@) % ما ضره همي ولا وصبي % % قلبي الكئيب وجسمي المضنى % % PageV01P427 21(@)(@@) % هيهات يسلي العذل لي كلفا % ويطرق التأنيب لي أذنا % % PageV01P428 البحر : بسيط تام 1(@)(@@) % أمعلن النوح في أغصانه شجنا % خفض عليك فقد أودى بك الشجن % 2(@)(@@) % هذي غصونك لا تنفك مائسة % وذاك إلفك لم يعصف به الزمن % 3(@)(@@) % فكيف بي لا أزال الدهر منفردا % جافي المضاجع لا إلف ولا سكن % % 4(@)(@@) % ألوى بحادث عهدي حادث جلل % وشفني من زماني الهم والحزن % PageV01P429 البحر : وافر تام 1(@)(@@) % إل هي أنت ذو فضل ومن % وإحسان يزيد على التمني % % 2(@)(@@) % وعفوك شامل أهل الخطايا % % وإني ذو خطاء فاعف عني % % 3(@)(@@) % وظني فيك يا ربي جميل % وعادتك الجميل بغير ضن % 4(@)(@@) % وها أنا فيك قد أحسنت ظنا % فحقق يا إل هي حسن ظني % % PageV01P430 البحر : متقارب تام 1(@)(@@) % أيا سحب نيسان روي الكروم % % لتروي خمرتها الأكرمينا % % 2(@)(@@) % إذا القطر أمكنه أن يكون % % سلافا فلا كان درا ثمينا % PageV01P431 البحر : مخلع البسيط 1(@)(@@) % والله لو رمت في غرامي % % إلزام من عنه قد نهاني % % 2(@)(@@) % أقمت من حاجبي حبيبي % % عليه برهانا اقتراني % % PageV01P432 البحر : بسيط تام 1(@)(@@) % يقول تفاحنا الزاهي بنضرته % % وقد جنته يد الجاني من الفنن % 2(@)(@@) % وقلدته يد الحسناء عاتقها % % ما أبت عن غصن إلا إلى غصن % % PageV01P433 البحر : منسرح 1(@)(@@) % لما جنى الطرف ورد وجنته % عذب قلبي بنار هجران % % 2(@)(@@) % فقلت قد جرت يا فديتك بي % % عذبت قلبي وطرفي الجاني % % PageV01P434 البحر : كامل تام 1(@)(@@) % ذهبت فنون مسرتي فتنوعت % % في القلب من وجد فنون شجون % 2(@)(@@) % يا من بكاه لفقد فن واحد % أني امرؤ أبكي لفقد فنون % % PageV01P435 البحر : طويل 1(@)(@@) % أيا بانيا عليا القصور مؤملا 
ms122	 % أمانا من الدنيا ونيل أمان % 2(@)(@@) % أقل البنا فالدهر يوم وليلة % عجولان للأعمار ينتهبان % 3(@)(@@) % وقل للذي لا ينتهي عن بنائها % % متى يأتي أمر الله ينته البان % % PageV01P436 البحر : كامل تام 1(@)(@@) % قف بالعذيب وحي حي قطينه % % واستسق عينك في مراتع عينه % % 2(@)(@@) % واحذر هنالك من ظباء كناسه % % إن كنت لا تخشى أسود عرينه % 3(@)(@@) % وإن ادعيت خلو قلبك في الهوى % % فمن ابتلاه بوجده وحنينه % 4(@)(@@) % هيهات لا يغني الحذار إذا بدت % % تلك الدمى بين الحمى وحجونه % % 5(@)(@@) % ومحجب إن لاح تحت ردائه % % أبصرت بدر التم فوق جبينه % % 6(@)(@@) % ما هز ذابل قده إلا غدت % % شغفا تسيل عليه نفس طعينه % 7(@)(@@) % لا يخدعنك منه لين قوامه % % هذا الذي صدع القلوب بلينه % % 8(@)(@@) % قد أخجل المران حالي قده % % والبيض في الأجفان سود جفونه % % 9(@)(@@) % لولا تلون وده ما كلن لي % % طرف يحار الدمع في تلوينه % % 10(@)(@@) % عاب الكواشح مينه في وعده % % هبه يمين ألست ملك يمينه % % PageV01P437 11(@)(@@) % ما هيمت قلبي فنون هيامه % % حتى رأى في الحسن حسن فنونه % % 12(@)(@@) % وكتمت عن نفسي حديث غرامه % % حذرا عليه ولم أفه بمصونه % % 13(@)(@@) % فالقلب لا يدري بعلة وجده % % والعقل يجهل من قضى بجنونه % 14(@)(@@) % ومؤنب لي في البكاء كأنني % % أبكي إذا جد الأسى بعيونه % % 15(@)(@@) % ظن الهوى سهل المرام وما درى % % أن المنى في الحب دون منونه % % 16(@)(@@) % ماذا عليه وما شجاه ولوعه % إن بات قلبي مولعا بشجونه % 17(@)(@@) % زعم النصيحة حين أرشدني إلى % % ترك الهوى من جده ومجونه % % 18(@)(@@) % كلا وعيشك لو أراد نصيحتي % % لم يرض لي أني أعيش بدونه % PageV01P438 البحر : كامل تام 1(@)(@@) % لله مدرسة علا بنيانها % % وسما على فرق السماء مكانها % % 2(@)(@@) % قد شادها ملك الملوك بهمة % عليا فأصبح في علو شانها % % 3(@)(@@) % سلطان شاه حسين الملك الذي % % طابت به الدنيا وطاب زمانها % % 4(@)(@@) % فغدت تنافسها السماوات العلى % % إذ زاحمت أفلاكها أركانها % % 5(@)(@@) % آوى بها كل العلوم فأصبحت % % وطنا لها إذ أقفرت أوطانها % % 6(@)(@@) % فلذا أتى تاريخ عام تمامها % % مغنى هدى فحوى 
ms123	 الهدى بنيانها % % 7(@)(@@) % لا زال بانيها المليك مؤيدا % بالله ما أحيا العلوم بيانها % % 8(@)(@@) % وعلي بن نظام الداعي له % % بدوام دولته السعيد قرانها % % 9(@)(@@) % هو ناظم الأبيات يزري نظمها % % بلأليء الجيد البهي جمانها % % PageV01P439 البحر : كامل تام 1(@)(@@) % ذاك الحجاز وهذه كثبانه % فاحفظ فؤادك إن رنت غزلانه % 2(@)(@@) % واسفح دموعك إن مررت بسفحه % % شغفا به إن الدموع جمانه % % 3(@)(@@) % وسل المنازل عن هوى قضيته % % هل عائد ذاك الهوى وزمانه % 4(@)(@@) % لهفي على ذاك الزمان وأهله % % وسقاه من صوب الحيا هتانه % 5(@)(@@) % إذ كان حبل الوصل متصلا بنا % % والعيش مورقة به أغصانه % 6(@)(@@) % وإذ المعاهد مشرقات بالمنى % % والسفح مغنى لم يبن سكانه % 7(@)(@@) % يا عاذلي دعا فؤادي والجوى % % لا تعذلاه فإنه ديدانه % 8(@)(@@) % وارحمتا لمتيم قذفت به % % أيدي النوى وتباعدت أوطانه % 9(@)(@@) % هبت له من نحو نجد نسمة % فتزايدت لهبوبها أشجانه % % 10(@)(@@) % يمسي ويصبح بالفراق موجعا % تبكي عليه من الضنى أخدانه % % PageV01P440 11(@)(@@) % ما إن تذكر بالحجاز زمانه % إلا وشبت في الحشا نيرانه % % 12(@)(@@) % فسقى الحجاز ومن بذياك الحمى % % صوب المدامع هاطلا هملانه % % 13(@)(@@) % لا كف للدمع الهتون تقاطر % بعد الحجاز ولا رقت أجفانه % PageV01P441 البحر : متقارب تام 1(@)(@@) % أصابت نواظره مهجتي % % وزادت فؤادي نواه جوى % % 2(@)(@@) % فقلت وقد أكثر العاذلون % دعوني فإني قتيل النوا % % PageV01P442 البحر : كامل تام 1(@)(@@) % هجر الحبائب جانبي % % ونزلن منعرج اللوى % % 2(@)(@@) % فظللت أعسف في الهوا % % جر سائرا النوى % % 3(@)(@@) % وصلى الهوى قلبي فوا % % كرباه من حر الهواجر % % PageV01P443 البحر : كامل تام 1(@)(@@) % ما بال قلبك لا يزال مولها % % لا الحلم يردعه الغداة ولا النهى % % 2(@)(@@) % أأعاد عيد غرامه طير شدا % % فغدا يحن إلى زمان قد زها % % 3(@)(@@) % ما زاده اللاحون عذلا في الهوى % % إلا وزاد تولعا وتولها % 4(@)(@@) % وتوجعا وتحزنا وتململا % وتشوقا وتحرقا وتأوها % 5(@)(@@) % ما أنت أول من نأى عن داره % % ورمت به أيدي النوى فتدلها % % 6(@)(@@) % قد آن أن تثني غرامك سلوة % فتفيق منه طائعا أو مكرها % 7(@)(@@) % أصفا لدمعك أن يبيت مرقرقا % وحلا لقلبك أن يظل مولها 
ms124	 % % 8(@)(@@) % عبثت صروف النائبات به فلا % % جزع يأوبه ولا صبر وهى % % 9(@)(@@) % ما إن شدت ورقاء فوق أراكة % % إلا وكان له حنين مثلها % % 10(@)(@@) % ولقد نهاه الناصحون عن الهوى % % فأبى وكان هو الرشيد لو انتهى % % PageV01P444 11(@)(@@) % سفها لرأيك أن رجوت لما مضى % % رجعا وقد وزع المشيب ونهنها % % 12(@)(@@) % هيهات أيام الشباب وعهده % % إذ كنت في ظل الشباب مرفها % % 13(@)(@@) % لا تحسبن أن المعاهد بالحمى % % تلك المعاهد والمها تلك المها % % 14(@)(@@) % قد أقفرت تلك الربوع وفرقت % تلك الجموع فلا البهي ولا البها % % 15(@)(@@) % أقصر فقد خلت الديار فلا هوى % يصبى إليه ولا مليح يشتهى % % 16(@)(@@) % لم تبق إلا لوعة أو حسرة % يمسي بها الصخر الأصم مدلها % % PageV01P445 البحر : سريع 1(@)(@@) % برئت من حولي ومن قوتي % % الحول والقوة لله % 2(@)(@@) % يا نفس جدي في سبيل الهدى % % جدي وخلي اللهو للاهي % % PageV01P446 البحر : كامل تام 1(@)(@@) % تفديك لو قبل المنون فداها % % نفس عليك تقطعت بأساها % % 2(@)(@@) % يا كوكبا قد خر من أفق العلى % % في ليلة كست الصباح دجاها % % 3(@)(@@) % كانت حياتك للنواظر قرة % واليوم موتك للعيون قذاها % % 4(@)(@@) % يا ليتني غيبت قبلك في الثرى % % وسقيت كاس الموت قبل تراها % % 5(@)(@@) % أو ليت عيني قبل تبصر يومك ال % % محتوم كحلها الردى بعماها % % 6(@)(@@) % لم لا تمنى الموت دونك مهجة % قد كنت تجهد طالبا لرضاها % % 7(@)(@@) % أم كيف لا تهوى العمى لك مقلة % قد كنت قرتها وكنت سناها % % 8(@)(@@) % آه ليومك ما أمض مصابه % % وأحر نار مصيبة أوراها % % 9(@)(@@) % لا والذي أبكى واضحك والذي % % أفنى نفوسا بعدما أحياها % % 10(@)(@@) % لم يبق لي في العيش بعدك رغبة % ما لي وللدنيا وطول عناها % % PageV01P447 11(@)(@@) % هيهات ترغب في الحياة حشاشة % قد كنت أنت حياتها ومناها % % 12(@)(@@) % كانت تؤمل أن تكون لك الفدا % % فأبيت إلا أن تكون فداها % % 13(@)(@@) % وبررتها حتى كأنك رأفة % وتعطفا كنت ابنها وأباها % % 14(@)(@@) % أف لها إذ لم تشاطرك الردى % % ما كان أغلظها وما أقساها % % 15(@)(@@) % قسما برب العاكفين بمكة % والطائفين بحجرها وصفاها % % 16(@)(@@) % لولا يقيني أنني 
ms125	 بك لاحق % لقهرتها حتى تذوق رداها % % 17(@)(@@) % تالله خاب السعي وانفصمت عرى ال % % آمال مما نابها وعراها % % 18(@)(@@) % لا متعت بالعيش بعدك أنفس % كانت حياتك روضها وجناها % % 19(@)(@@) % بل لا هنا للقلب غير غليله % % أبدا ولا للعين غير بكاها % % 20(@)(@@) % يا دوحة للمجد مثمرة العلى % % ذهبت نضارتها وجف نداها % % PageV01P448 21(@)(@@) % قد كنت ساعدي الذي أسطو به % % ويدي التي يخشى الزمان سطاها % % 22(@)(@@) % تنفي الأسى عني وتحمي جانبي % % من كل كارثة يعم أذاها % % 23(@)(@@) % واليوم قد هجمت علي حوادث % ما كنت أحذرها ولا أخشاها % % 24(@)(@@) % طوبى لأيام الوصال وطيبها % % ما كان أحلاها وما أهناها % % 25(@)(@@) % أيام لي من حسن وجهك بهجة % بجمالها بين الورى أتباهى % % 26(@)(@@) % فإذا جلست بجانبي فكأنني % % قارنت من شمس النهار ضحاها % % 27(@)(@@) % وإذا رأيتك بين آل المصطفى % % عوذت منظرك الجميل بطاها % % 28(@)(@@) % كانت بقربك في الزمان مواردي % % تصفو ويعذب وردها ورواها % % 29(@)(@@) % فمنيت من حر الفراق بغلة % حكم الردى أن لا يبل صداها % % 30(@)(@@) % وبليت من أرزائه برزية % عظمت مصيبتها وطال جواها % % PageV01P449 31(@)(@@) % إني ليملكني التأسف والأسى % % فيعز من نفسي عليك عزاها % % 32(@)(@@) % فإذا ذكرت فناء دنيانا التي % % لا لفظها يبقى ولا معناها % % 33(@)(@@) % خف الأسى عني وهان علي ما % % ألقاه من أهوالها وبلاها % % 34(@)(@@) % كيف البقاء بهذه الدار التي % % من قد بناها للفناء بناها % % 35(@)(@@) % دار قضت أن لا يدوم نعيمها % % لا كان مسكنها ولا سكناها % % 36(@)(@@) % لا سرها باق ولا إعسارها % % سيان حالا فقرها وغناها % % 37(@)(@@) % مقرونة خيراتها بشرورها % % ونعيمها بعنائها وشقاها % % 38(@)(@@) % إن أضحكت أبكت وإن برت برت % وإذا شفت شفت عليل ضناها % % 39(@)(@@) % أين الملوك المالكين لأمرها % % والعامرو أمصارها وقراها % % 40(@)(@@) % أين القياصر والأكاسرة الألى % % شادوا مباني عزها وعلاها % % PageV01P450 41(@)(@@) % أين الخواقين الذين تمسكوا % % بعهودها واستمسكوا بعراها % % 42(@)(@@) % غرتهم بشرابها وسرابها % % حتى انتشوا من كأسها وطلاها % % 43(@)(@@) % بطشت بهم بطش الكمين بغرة % الله أكبر ما أقل وفاها % % 44(@)(@@) % قد ضل رشد من أطباه جمالها % % فصبا إليها وازدهاه زهاها % % 45(@)(@@) % يهوى الأنام بها البقاء 
ms126	 وإنما % % شاء الإله بقاءهم بسواها % % 46(@)(@@) % ما هذه الأيام غير مراحل % تطوى وأنفاس النفوس خطاها % % 47(@)(@@) % حتى إذا بلغت نهاية سيرها % % ألقت عصاها واستقر نواها % % 48(@)(@@) % يا قرة للعين أسخنها الردى % % وعزيمة للقلب فل شباها % % 49(@)(@@) % تبكي عليك النفس من فرط الأسى % % وتنوح وجدا من عظيم شجاها % % 50(@)(@@) % وتقول حقا حين ينكشف العمى % % عنها وتبصر رشدها وهداها % % PageV01P451 51(@)(@@) % وفقت حين رفضت ألأم منزل % ورقيت من عليا الجنان ذراها % % 52(@)(@@) % جاريتني فبلغت قبلي غاية % للحق لم يبلغ أبوك مداها % % 53(@)(@@) % ما زلت تسهر كل ليلة جمعة % لله إذ يغشى لعيون كراها % % 54(@)(@@) % حتى دعاك الله فيها راضيا % لتنال منه مثوبة ترضاها % % 55(@)(@@) % لله همتك التي فاقت على % % همم الأعاظم شيخها وفتاها % % 56(@)(@@) % سعت الرجال لنيل دنياها التي % % قد دنست فعزفت عن دنياها % % 57(@)(@@) % وسعيت للأخرى المقدسة التي % % لم يرع غير الطاهرين حماها % % 58(@)(@@) % فحويتها والعمر مقتبل الصبا % % واها لهمتك العلية واها % % 59(@)(@@) % إن كنت أحللت الجنان منعما % فأبوك حل من الهموم لظاها % % 60(@)(@@) % حزنت لموتك طيبة وبقيعها % % وبكت لفوتك مكة ومناها % % PageV01P452 61(@)(@@) % وغدا الغري عليك يغري بالأسى % % طوسا وبغدادا وسامراها % % 62(@)(@@) % أقررت أعين من بها بنزاهة % حلتك في سن الصبا بحلاها % % 63(@)(@@) % صلى عليك الله من مستودع % في روضة ضم الكمال ثراها % % 64(@)(@@) % وتواترت رحمات ربك بكرة % وعشية يسقي ثراك حياها % % 65(@)(@@) % ما حن مشتاق إلى أحبابه % % وتذكرت نفس أهيل هواها % % PageV01P453 البحر : رمل تام 1(@)(@@) % صاح إن جزت بذي الأثل فحي % % ساكني تلك الربى حيا فحي % 2(@)(@@) % وقف الركب بشرقي الحمى % % بين حزوى وثنيات اللوي % 3(@)(@@) % وإذا استسقيت فاستسق له % % بدل السحب الغوادي مقلتي % % 4(@)(@@) % يا رعى الله بسفح المنحنى % % رشأ تحميه آساد لؤي % % 5(@)(@@) % كم معنى بهواه لم يزل % % سائرا يطوي إليه البيد طي % 6(@)(@@) % إن غيي في هواه رشد % ورشادي في سلوي عنه غي % 7(@)(@@) % لا تلمني إن أمت وجدا به % % كل ميت هو في الأحباب حي % 8(@)(@@) % وبنفسي غادة مقصورة % باللوى تلوي ديون الصب لي % % 9(@)(@@) % إن تشر 
ms127	 للشمس والبدر تقل % % هذه أختي وذياك أخي % % 10(@)(@@) % إن بذلت الروح في حبي لها % % فلها المنة في البذل علي % PageV01P454 11(@)(@@) % كل صب في الهوى ما لم يكن % % سمحا بالروح لم يسمح بشي % 12(@)(@@) % وإليه ينتهي البخل ولو % % أنه في جوده حاتم طي % 13(@)(@@) % ساقني الحب كما قادني % % فهو من خلفي ومن بين يدي % % 14(@)(@@) % يا نداماي بجمع ومنى % هل لعهدي بهما عود إلي % 15(@)(@@) % حيث عيشي بالتداني رغد % والهوى طوعي ومن أهوى لدي % 16(@)(@@) % لا أغب المزن من أم القرى % % منزلا كان لأسماء ومي % 17(@)(@@) % لو دعاني الدهر يوما دعوة % نحوه أو قالت الأقدار هي % 18(@)(@@) % جئته أسعى على الرأس ولم % % أرض للسعي إليه قدمي % % 19(@)(@@) % يا حداة العيس أقصى أملي % % وقفة بين كداء وكدي % 20(@)(@@) % وقفة يروى بها من زمزم % % قلبي الظمآن لا من ثغر ري % PageV01P455 البحر : طويل 1(@)(@@) % لك الخير إن جزت اللوى والمطاليا % % فحي ربوعا منذ دهر خواليا % % 2(@)(@@) % وقف سائلا عن أهلها أين يمموا % % وإن لم تجد فيها مجيبا وداعيا % 3(@)(@@) % وعج أولا نحو المعاهد ثانيا % زمام المطايا واسأل العهد ثانيا % 4(@)(@@) % فإن تلفها من ساكنيها عواطلا % % فعهدي بها مر الليالي حواليا % % 5(@)(@@) % تحل بها غيد غوان كأنما % % نظمن على جيد الزمان لأ ليا % % 6(@)(@@) % يرنحن من هيف القدود ذوايلا % وينضين من دعج اللحاظ مواضيا % % 7(@)(@@) % ويبدين من غر الوجوه أهلة % وينشرن من سود الفروع لياليا % % 8(@)(@@) % تحكمن قسرا في القلوب فلن ترى % % فؤاد محب من هواهن خاليا % % 9(@)(@@) % قضت بهواهن الليالي وما قضت % ديون الهوى حتى سئمنا التقاضيا % % 10(@)(@@) % أطعت الصبا في حبهن مدى الصبا % % فلما انقضى استبدلت عنه التصابيا % % PageV01P456 11(@)(@@) % نعم قد حلا ذاك الزمان وقد خلا % % على مثله فليبك من كان باكيا % % 12(@)(@@) % وثم صبابات من الشوق لم تزل % % تؤجج وجدا بين جنبي واريا % % 13(@)(@@) % ولكنني أبدي التجلد في الهوى % % وأظهر سلوانا وما كنت ساليا % % 14(@)(@@) % قصارى النوى والهجر أن يتصرما % % فيمسي قصي الدار والود دانيا % % 15(@)(@@) % صبرت على حكم الزمان وذو الحجا 
ms128	 % % ينال بعون الصبر ما كان راجيا % % 16(@)(@@) % وقلت لعل الدهر يثني عنانه % % فأثني عن لوم الزمان عنانيا % % 17(@)(@@) % ولو أجدت الشكوى شكوت وإنما % % رأيت صروف الدهر لم تشك شاكيا % % 18(@)(@@) % فليت رجالا كنت أملت نفعهم % % تولوا كفافا لا علي ولا ليا % % 19(@)(@@) % ولو أنني يوم الصفاء اتقيتهم % % تقاة الأعادي ما خشيت الأعاديا % % 20(@)(@@) % ولكنهم أبدوا وفاقا وأضمروا % % نفاقا وجروا للبلاء الدواهيا % % PageV01P457 21(@)(@@) % فأغضيت عنهم لا أريد عتابهم % % ليقضي أمر الله ما كان قاضيا % % 22(@)(@@) % ولي شيمة في وجنة الدهر شامة % تنير على رغم الصباح الدياجيا % % 23(@)(@@) % تؤازرها من هاشم ومحمد % مفاخر لا تبقي من الفخر باقيا % % 24(@)(@@) % سبقت إلى غايات مجد تقطعت % % رقاب أناس دونها من ورائيا % % 25(@)(@@) % وزدت على دهري وسني لم تكن % % تزيد على العشرين إلا ثمانيا % % 26(@)(@@) % وما وثقت نفسي بخل من الورى % % أكان صديقا أم عدوا مداجيا % % 27(@)(@@) % ولا خانني صبري ولا خف حادث % بعزمي إذا ما الخطب ألقى المراسيا % % 28(@)(@@) % وليس الفتى ذو الحزم من بات مولعا % بشكوى الليالي والليالي كما هيا % % 29(@)(@@) % ولكن فتى الفتيان من راح معرضا % عن الدهر لا يخشى قريبا ونائيا % % 30(@)(@@) % وإني لأخفي الوجد صبرا على الأسى % % ويبدي ضعيف الرأي ما كان خافيا % % PageV01P458 31(@)(@@) % وأطوي الحشى طي السجل على الجوى % % فما علمت قوم من الوجد مابيا % % 32(@)(@@) % أصول بقلب لوذعي ومقول % يفل شباه المشرفي اليمانيا % % 33(@)(@@) % وأنظم من حر الكلام قوافيا % تكون لآثار المعالي قوافيا % % 34(@)(@@) % ونزهت شعري عن هجاء ومدحة % ولولا الهوى ما كنت أطري الغوانيا % % 35(@)(@@) % ولست أعد الشعر فخرا وإنني % % لأنظم منه ما يفوق الدراريا % % 36(@)(@@) % ولكنني أحمي حماي وأتقي % % عداي وأرمي قاصدا من رمانيا % % 37(@)(@@) % وإن رمت لي فخرا عددت من العلى % % مزايا عظاما لا عظاما بواليا % % 38(@)(@@) % على أنني من هاشم في صميمها % % وحسبك بيتا في ذرى المجد ساميا % % PageV01P459 البحر : خفيف تام 1(@)(@@) % بك في ملة الغرم اقتديت % % أتراني إلى سواك انتميت % 2(@)(@@) % وهواك الذي عليه انطويت % لك طرفي حمى وقلبي بيت % 3(@)(@@) % فيهما عهدك 
ms129	 القديم خبيت % % 4(@)(@@) % تحسب القلب عنك مال وملا % % وصحا بعد سكره وتخلى % % 5(@)(@@) % لا وعينيك لست ممن تسلى % % ومن السكر ما صحوت وكلا % % 6(@)(@@) % كيف أصحو ومن هواك انتشيت % % 7(@)(@@) % ما كتمت الهوى وفرط الهيام % % بك إلا وزاد حر أوامي % % 8(@)(@@) % % بسط العاذلون فيك ملامي % % 9(@)(@@) % وبساط القبول عنهم طويت % % 10(@)(@@) % زعم اللائم الذي قد تعنى % % أنني قد سلوت وهما وظنا % % PageV01P460 11(@)(@@) % وفؤادي أدرى بما قد أجنا % % كيف ينوى السلو عنك المعنى % % 12(@)(@@) % يا منى القلب وهو في الحي ميت % % 13(@)(@@) % قد أطال الفراق والبين أسري % % وقضى لي عنك البعاد بهجر % % 14(@)(@@) % وهداني للصبر من ليس يدري % % وضلال عن مثل حسنك صبري % % 15(@)(@@) % فلقلبي الهنا بأني اهتديت % % 16(@)(@@) % هام قلبي على حماك ولبي % % وغدا العقل في هواك يلبي % % 17(@)(@@) % رمت قربا فمذ خطيت بقرب % % بك يا كعبة الوفا طاف قلبي % % 18(@)(@@) % وبدا بارق الصفا فسعيت % % PageV01P461 البحر : كامل تام 1(@)(@@) % لله مهجة واله لم يثنها % % عذل العواذل من لواعج حزنها % % 2(@)(@@) % ذكرت صبابتها ومعهد فنها % % ومليحة تسبي الأنام بحسنها % % 3(@)(@@) % ومهفهفا عبث الدلال بقده % % 4(@)(@@) % لما رأته من المحاسن فردها % % أورت عليه من الصبابة وقدها % % 5(@)(@@) % حتى إذا ما جرعته صدها % % أهوى يقبلها ويلثم خدها % % 6(@)(@@) % حنقت عليه وأسرعت في رده % % 7(@)(@@) % فازداد إذ ردته عظم نكاية % فأباح ما أخفاه دون كناية % 8(@)(@@) % لما رأت لا ينتهي عن غاية % لطمت عوارضه بغير جناية % 9(@)(@@) % منه فأثر كفها في خده % % 10(@)(@@) % فبدت محاسن للجمال ببطشها % % وفشت سرائر للهوى لم يفشها % % PageV01P462 11(@)(@@) % إذ أثرت في وجنتيه بخدشها % % فاخضر آس عذاره من نقشها % % 12(@)(@@) % واحمر باطن كفها من ورده % % PageV01P463 البحر : بسيط تام 1(@)(@@) % نأى ففرق بين الطرف والوسن % % وألف البين بين القلب والحزن % % 2(@)(@@) % فيا رفيقي لا أعداكما شجني % % بالله ربكما عوجا على سكني % % 3(@)(@@) % وعاتباه لعل العتب يعطفه % % 4(@)(@@) % وأنشدا من نسيبي أو نسيبكما % % وكنيا عن غرامي في نشيدكما % % 5(@)(@@) % فإن صبا فاذكراني لأرزئتكما % % وعرضا بي وقولا في حديثكما % % 6(@)(@@) % ما بال عبدك 
ms130	 بالهجران تتلفه % % 7(@)(@@) % إرحمه من عبرات فيك واكفة % ومهجة بغليل الوجد لاهفة % 8(@)(@@) % شوقا لأيام أنس منك سالفة % فإن تبسم قولا في ملاطفة % 9(@)(@@) % ما ضر لو بوصال منك تسعفه % % 10(@)(@@) % وهو الذي بك طول الدهر مكتئب % % وقلبه بسعير الهجر يلتهب % PageV01P464 11(@)(@@) % فإن تعطف فهو القصد والأرب % وإن بدا لكما من وجهه غضب % % 12(@)(@@) % فغالطاه وقولا ليس نعرفه % % الموشحات واليمانيات أ % % PageV01P465 البحر : رمل تام 1(@)(@@) % درت تلك الدمى أي دما % % سفكتها باللحاظ النعس % 2(@)(@@) % وأسالت من جفوني عندما % % عندما سارت بتلك الأنفس % 3(@)(@@) % ألفت ما بين شملي والنوى % % وسرت والبيت للقلب أسر % 4(@)(@@) % وقضت لي بتباريح الجوى % % وأحالتني على حكم القدر % 5(@)(@@) % أنجزت قتلي جهارا في الهوى % % وغدت تسأل عني ما الخبر % % 6(@)(@@) % لو أرادت سلم لي أن أسلما % % أترعت قبل التأني أكؤسي % % 7(@)(@@) % وأزالت ما بقلبي من ظما % % وسقتني من لماها الألعس % % 8(@)(@@) % لبتها إذ لم تجد لي باللقا % % وعدتني وصلها بالحلم % % 9(@)(@@) % كيف يأتي الطيف صبا قلقا % أيزور الطيف من لم ينم % % 10(@)(@@) % ولقد بت من الشوق لقى % % وضجيعي طول ليلي ألمي % % PageV01P466 11(@)(@@) % هكذا كل معنى بالدمى % % ليت شعري والجواري الكنس % 12(@)(@@) % أم أنا المخصوص منهن بما % % قد برى نفسي وأورى نفسي % % PageV01P467 البحر : - 1(@)(@@) % جنب الغزال الأغيد % % لابس الوشاح العسجد % % 2(@)(@@) % يجر ذيل البرد % % 3(@)(@@) % فائق الحسان الخرد % وهو في المحاسن مفرد % 4(@)(@@) % منزه عن ند % % 5(@)(@@) % قاتلي إذا ما جرد % % سيف لحظه أو أود % % 6(@)(@@) % عسال ذاك القد % % 7(@)(@@) % طرفه بقتلي يشهد % % فاسألوه إن لم يجحد % % 8(@)(@@) % هل كان ذا عن عمد % % 9(@)(@@) % للهوى بقلبي عهد % مذ ضم جسمي المهد % % 10(@)(@@) % في حب داجي الأفلال % % PageV01P468 11(@)(@@) % حبه المنى والقصد % % لا سؤال حاد يحدو % % 12(@)(@@) % ولا البكا في الأطلال % % 13(@)(@@) % إن ثناه عني صد % % أو زواه عني بعد % % 14(@)(@@) % ركبت فيه الأهوال % % 15(@)(@@) % غار بي الهوى أو أنجد % إن سعدت مثلي يسعد % % 16(@)(@@) % بنيل هذا القصد % % PageV01P469 البحر : - 1(@)(@@) % هينمت تعرب أنفاس الصبا % % عن شذا آرام رامه % 2(@)(@@) % جددت 
ms131	 عهد التصابي والصبا % % للمعنى وغرامه % 3(@)(@@) % وروت عن ساكني ذاك الخبا % % خبرا روى أوامه % % 4(@)(@@) % لا عدمناها فكم أهدت نبا % % فعلت فعل المدامه % % 5(@)(@@) % أسكرتنا بشذاها % % حيث هبت من رباها % % 6(@)(@@) % وفهمنا بذكاها % % ما أسرت من نباها % % 7(@)(@@) % وسرت ترفل في ذيل الدجى % % ساحبه ذيل الجلاله % 8(@)(@@) % سلبت ألباب أرباب الحجا % % مذ روت تلك الرساله % % 9(@)(@@) % وأنالت كل صب من رجا % % وأحالت منه حاله % 10(@)(@@) % وأغاثت بشذا تلك الربى % % نفس صب مستهامه % PageV01P470 11(@)(@@) % فنما شوقي ووجدي % % للقا ساكن نجد % 12(@)(@@) % آه ليت الصبر يجدي % % ما عسى يبلغ جهدي % % 13(@)(@@) % في هوى ظبي النقامزري الدمى % % المحجب في قبابه % 14(@)(@@) % لؤلؤي الثغر معسول اللمى % % خمرتي صافي رضابه % 15(@)(@@) % ما ضياء الشمس ما بدر السما % % إن تجلى من حجابه % % 16(@)(@@) % أخجل الآرام جيدا والظبى % % والقنا قدا وقامه % % 17(@)(@@) % كم له في الحسن معنى % % مشرق في كل مغنى % % 18(@)(@@) % وبه العاني المعنى % % لم يزل ولهان مضنى % % 19(@)(@@) % ساهر الأجفان مقروح الحشا % % هائم في كل وادي % % 20(@)(@@) % شرب الحب كؤوسا فانتشى % % من هوى قمري البوادي % % PageV01P471 21(@)(@@) % وغدا من عشق ذياك الرشا % % وجده خاف وبادي % % 22(@)(@@) % كلما هبت صبا نجد صبا % % وشدا شدو الحمامه % % PageV01P472 البحر : خفيف تام 1(@)(@@) % يا أهيل الغرام عز المرام % % من سليمى وأضناني الصدود % 2(@)(@@) % للرنا في الحشى رشق السهام % وبقلبي من الفرقه وقود % 3(@)(@@) % يا سقى الله لييلات الخيام % % هل ترى ما مضى فيها يعود % 4(@)(@@) % ما سلا والنبي قلبي الغرام % ها دموعي وها وجدي شهود % % 5(@)(@@) % كيف أسلو وما نلت المنى % % من حبيبي ولا نلت اللقا % % 6(@)(@@) % آه قد طال سقمي والضنى % % من جفا ذاك الرشا ساجي المقا % % 7(@)(@@) % لا ومن بالنوى قدر لنا % % ما لصبري على هجر بقا % % 8(@)(@@) % ما يطفي غليلي والأوام % % غير رشفه لمبسمه البرود % 9(@)(@@) % بعد بعد المزار نومي غرار % % ودموعي على خدي غروب % % 10(@)(@@) % فمتى يا ترى تدنو الديار % وتوافي مسرات القلوب % % PageV01P473 11(@)(@@) % ويفك القضا هذا الأسار % % ويجلي الهنا هذي الكروب % 12(@)(@@) % وينيل المنى جاني الوشام 
ms132	 % % من وصاله ويوليني السعود % PageV01P474 البحر : - 1(@)(@@) % أسعفت ذات الرضاب السلسبيل % % مغرما قد طال نحبه % % 2(@)(@@) % وأغاثت من لقاها بالجميل % % فصفا زاده وشربه % % 3(@)(@@) % وشفت صبا بها مضنى عليل % % دمعه ما كف غربه % % 4(@)(@@) % ما على عاني هواها من سبيل % إن صبا أوهام قلبه % 5(@)(@@) % عاد عيد الوصل من بعد البعاد % وبدت أقمار سعدي % % 6(@)(@@) % وقضت ذات اللمى حق الوداد % % بعد إعراض وصد % % 7(@)(@@) % وأنالت صبها أقصى المراد % % ووفت بالوصل وعدي % % 8(@)(@@) % فسلوي عن هواها مستحيل % لا تقل قد بان كذبه % % PageV01P475 البحر : - 1(@)(@@) % أصبح فقد هينم النسيم % والصبح قد لاح كوكبه % 2(@)(@@) % وشنف الكأس يا نديم % % فالراح قد طاب مشربه % % 3(@)(@@) % واشرب على جنة النعيم % من زاهر الخد مذهبه % 4(@)(@@) % أو دع فؤادي بها يهيم % % فالكل يعمل بمذهبه % % 5(@)(@@) % عشق الغواني له مجال % % ما كل من جاء يدركه % 6(@)(@@) % كم دكدكت دونه جبال % % ورب حر تملكه % 7(@)(@@) % فاقنع من الوصل بالمحال % % واحذر على السر يهتكه % 8(@)(@@) % وارحل إذا كنت لا تقيم % % فالحب قد عز مطلبه % % 9(@)(@@) % أنا الذي في هوى الملاح % حديث عهدي مسلسل % 10(@)(@@) % الكل ألقى لي السلاح % % وأذعنوا لي وأقبلوا % % PageV01P476 11(@)(@@) % قدحي المعلى على القداح % فكيف أخفى وأجهل % % 12(@)(@@) % يشفى بمنطوقي السقيم % % إن لم تصدق فجربه % % PageV01P477 البحر : - 1(@)(@@) % ألا والنسيم سحر % متى جزت بالأثل والبان % % 2(@)(@@) % وهات ما معك من خبر % % فقد بان لي منك ما بان % % 3(@)(@@) % وسرك بعرفك ظهر % وهيج تباريح الأشجان % 4(@)(@@) % وإلا فماذا الخفر % ومن علمك سحب الأردان % % 5(@)(@@) % خبايا المحبة تلوح % وكم للهوى من أشائر % % 6(@)(@@) % وعرف المحبة يفوح % % ورياه في الكون سائر % 7(@)(@@) % وما كل عاشق يبوح % % ولكنما الحال ظاهر % 8(@)(@@) % وخلي إذا ما خطر % % تهافت عليه أغصن البان % 9(@)(@@) % متى والليالي الوصال % % تعودي بتلك الحبائب % % 10(@)(@@) % فما لي من الشوق حال % % وقلبي من الوجد ذائب % % PageV01P478 11(@)(@@) % ولا والنبي ما استحال % % ودادي ولو كنت غائب % % 12(@)(@@) % فليت الذي لي هجر % % رأى ما بقلبي من أحزان % PageV01P479 البحر : - 1(@)(@@) % ربرب الحرم % % خطر بوادي عصفري مخرم 
ms133	 % 2(@)(@@) % طاف والتزم % ومر يسحب ذيله لزمزم % % 3(@)(@@) % كم سبا وكم % % فتن بحسنه في الهوى وتيم % % 4(@)(@@) % فانثنى ولم % يسمح بنظره للشجي المتيم % % 5(@)(@@) % جؤذري الرنا % % يزري غصون البان إن تثنى % % 6(@)(@@) % حبه منى % % قلبي وجسمي في هواه مضنى % % 7(@)(@@) % قلت إذ ثنى % % عطفه ورنح قده وثنى % % 8(@)(@@) % يا أخا الحرم % % جفاك فتت مهجتي وسمم % % 9(@)(@@) % اترك الجفا % % وصل متيم من جفاك أشفى % % 10(@)(@@) % ما جرى كفى % % وكدت من فرط السقام أخفى % % PageV01P480 11(@)(@@) % فاسمح بالوفا % % عسى تهوم مقلتي وتغفى % % 12(@)(@@) % مر وابتسم % % وقال مهلا فالحظوظ تقسم % % 13(@)(@@) % من عشق صبر % وكل صابر بالمرام يظفر % % 14(@)(@@) % حسني الأغر % % أغار بدر التم حين أسفر % % 15(@)(@@) % كم خدع وغر % من ادعى عشقي ولا تصبر % % 16(@)(@@) % قلت لا جرم % الحب مغرم والمحب مغرم % 17(@)(@@) % اسعف باللقا % % ولا تدعني في هواك ملقى % % 18(@)(@@) % يا رشا النقا % % جامل محبك فالجميل أبقى % % 19(@)(@@) % والجفا شقا % % حاشا لصبك في الغرام يشقى % % 20(@)(@@) % مغرمك حكم % % عليه حسنك والهوى تحكم % % PageV01P481 21(@)(@@) % قال لا تخف % % أقبل فسعدك بالوصال أسعف % % 22(@)(@@) % واترك الأسف % والثم بديدي من لماي وارشف % % 23(@)(@@) % كلي لك تحف % ثغري وخصري والنهود والكف % % 24(@)(@@) % فاشفي الألم % مما تريده فالمراد لك تم % 25(@)(@@) % بت معتنق % خلي وبدري بالسعود مشرق % 26(@)(@@) % رحت مغتبق % ريقه ورايات السرور تخفق % 27(@)(@@) % والشذا عبق % % وبات حبي للكؤوس يدهق % % 28(@)(@@) % سر واغتنم % % قلبي ومن نال الوصال يغنم % PageV01P482 البحر : - 1(@)(@@) % وخذ القلاص سرت ليلا % % فوقها بدور % % 2(@)(@@) % أبصر السراة سنى ليلى % % في الظلام نور % % 3(@)(@@) % فانثنت تميل بها ميلا % % هزها السرور % 4(@)(@@) % سالت البطاح بها سيلا % % وهي لا تجور % 5(@)(@@) % حلت الركاب بناديها % % لم تطق مسير % 6(@)(@@) % واغتدى يغرد حاديها % % وهي لا تسير % 7(@)(@@) % أشرق الصباح بناديها % % والدجى منير % % 8(@)(@@) % وانثنت تجر بها ذيلا % % خرد وحور % % 9(@)(@@) % سر بنا نحل على الرمل % أيها الدليل % % 10(@)(@@) % واحبس المطي على الأثل % % حيثما المقيل % % PageV01P483 11(@)(@@) % حيثما الهزاز غدا يملي % % والظبا تميل % 12(@)(@@) % فاز من ينال به نيلا % % من رشا الخدور 
ms134	 % % 13(@)(@@) % هذه المنازل من نجد % % لا ترم براح % 14(@)(@@) % ههنا أنال شفا وجدي % % من هوى الملاح % 15(@)(@@) % فاترك الملام ولا تبدي % % فيه قول لاح % 16(@)(@@) % واهجر المنام به كيلا % % تحرم الحضور % 17(@)(@@) % ابرز العروس من الدن % % وادهق الكؤوس % 18(@)(@@) % واصرف الهموم بها عني % % وانف كل بوس % 19(@)(@@) % وادع بالقيان وقل غني % % يا منى النفوس % 20(@)(@@) % هذه الشموس بدت ليلا % % بيننا تدور % PageV01P484 البحر : - 1(@)(@@) % راعي الوشاح % سباني عندما لاح % % 2(@)(@@) % ثغره الأقاح % % وفيه الشهد والراح % 3(@)(@@) % مخجل الرماح % بقده حين يرتاح % % 4(@)(@@) % ما عليه جناح % % إذا ما حاز الأرواح % 5(@)(@@) % صائح البريم % % دعوني فيه ساهيم % % 6(@)(@@) % لحظه السقيم % % أغار الظبي والريم % % 7(@)(@@) % كم شفى سليم % % لمى ريقه بتسنيم % % 8(@)(@@) % فانثنى وراح % % يواصل راح الأفراح % 9(@)(@@) % يا رشا الكثيب % مطال الصب تعذيب % % 10(@)(@@) % أنت لي طبيب % ووصلك في الهوى طيب % % PageV01P485 11(@)(@@) % واصل الكئيب % فما في الوصل تأنيب % 12(@)(@@) % داوي الجراح % % بزورة منك يا صاح % % 13(@)(@@) % والهوى قسم % ودين الحب مقسم % 14(@)(@@) % لا لزمك لزم % وأقبل منك مبسم % % 15(@)(@@) % واشفى الألم % بقبلة منك واحوم % 16(@)(@@) % فاللقا مباح % % لمن بالسر ما باح % % PageV01P486 البحر : - 1(@)(@@) % يا برق العوالي % % خبرني عن وادي زرود % % 2(@)(@@) % هل تلك الليالي % % والأيام في سفحه تعود % % 3(@)(@@) % واسأل ذا الجمال % ساهي الطرف وردي الخدود % 4(@)(@@) % أما أنا فهائم % % من بعده ما ذقت المنام % 5(@)(@@) % استسقي الغمائم % من شوقي لتلك الخيام % % 6(@)(@@) % واستنشق النسائم % % إن مرت بوادي الخزام % % 7(@)(@@) % جسمي كالخلال % % يبكي لي مما بي الحسود % % 8(@)(@@) % يا حلو الشمائل % % أضناني وجدي والعويل % % 9(@)(@@) % إسمح لي بنائل % % وصلك واجعل لي سبيل % % 10(@)(@@) % ما في الصد طائل % % لا تبخل بفعل الجميل % PageV01P487 11(@)(@@) % فاسمح بالوصال % يكفيك الجفا والصدود % % PageV01P488 البحر : - 1(@)(@@) % قف بالكثيب % % وقل لمن طال عتبه % % 2(@)(@@) % عذب الشنيب % % خدن الرشا وتربه % % 3(@)(@@) % صل يا ربيب % % صبا ملكت قلبه % % 4(@)(@@) % واسمع عجيب % % مقال من زاد كربه % % 5(@)(@@) % ما أحلى الحبيب إذا تلافى صبه % % 6(@)(@@) % كم ذا الجفا % % والهجر يا مفدى % % 7(@)(@@) % أما كفى % % ما 
ms135	 هد جسمي هدا % % 8(@)(@@) % إن الوفا % % بالمستهام أجدى % % 9(@)(@@) % فاسمح بطبيب % وصلك ولا تبخل به % % 10(@)(@@) % ما أحلى الحبيب إذا تلافى صبه % % PageV01P489 11(@)(@@) % نومي غرار % من يوم ذقت صدك % % 12(@)(@@) % والدمع جار % على الخدود بعدك % % 13(@)(@@) % % لا ذقت مر فقدك % % 14(@)(@@) % ان الكئيب % % قد كاد يقضي نحبه % % 15(@)(@@) % ما أحلى الحبيب إذا تلافى صبه % % 16(@)(@@) % أنت المنى % % وأنت غاية قصدي % % 17(@)(@@) % ما المنحنى % % وما منازل نجد % 18(@)(@@) % فاشف الضنى % % وداو سقم وجدي % % 19(@)(@@) % وصلك طبيب % % دائي وأنت طبه % % 20(@)(@@) % ما أحلى الحبيب إذا تلافى صبه % % PageV01P490 البحر : - 1(@)(@@) % بدا كغصن مائس % % في أفخر الملابس % 2(@)(@@) % بدر إذا لاح لنا % % جلا دجى الحنادس % % 3(@)(@@) % يدير من رضابه % % شهدا ومن أكوابه % % 4(@)(@@) % راحا حكت بكفه % % نارا بكف قابس % % 5(@)(@@) % أفديه من مهفهف % لدن القوام أهيف % % 6(@)(@@) % كأنما مقلته % مقلة ظبي ناعس % % 7(@)(@@) % تخاله إذا بدا % % شمسا له الشمس فدا % % 8(@)(@@) % والفرع منه فاحم % كجنح ليل دامس % % 9(@)(@@) % هواه حل في الحشا % % ومن حمياه انتشى % % 10(@)(@@) % عقلي إذا نادمته % % في أشرف المجالس % PageV01P491 البحر : - 1(@)(@@) % مرنح القد من ثنى لك عطفيك % % ومن أعار القنا اعتدالك % % 2(@)(@@) % نهبت كل الورى بصارم لحظيك % % فاتني من بذا قضى لك % % 3(@)(@@) % أسعرت نار الحشى بحمرة خديك % % فاطفها من لمى زلالك % 4(@)(@@) % الله في مهجة غدت في كفيك % % شفها بالأسى مطالك % % 5(@)(@@) % لو تعلم اليوم ما بها من عينيك % % ما قضى بالجفا دلالك % % 6(@)(@@) % قلبي مدى الدهر حائر في أمريك % % من بعادك ومن وصالك % % 7(@)(@@) % لويت دين الهوى كلي صدغيك % % من فعل يا جدي فعالك % 8(@)(@@) % ورحت تسبي النهى بساحر جفنيك % % هكذا يقتضي جمالك % 9(@)(@@) % بدر الدياجي والغزالة قلبيك % % في البها والسهى نعالك % % PageV01P492 البحر : - 1(@)(@@) % مرنح القد سمهري الأعطاف % مفلج الثغر % 2(@)(@@) % نفى هجوعي ودمعي الوكاف % يجري بلا أجر % % 3(@)(@@) % الله لي يا جميل الأوصاف % % من لوعة الهجر % 4(@)(@@) % أطلت هجري وصدك قد حاف % % على قوى صبري % % 5(@)(@@) % ليتك إذ لم تجد بالإسعاف % أجملت يا عذري % % 6(@)(@@) % قل لي فديتك 
ms136	 وجد بالإنصاف % % ما كان من أمري % % 7(@)(@@) % لوعت قلبي وهذي أسياف % % لحظك به تفري % % 8(@)(@@) % وإن ترد لا عدمتك إتلاف % % نفسي بلا عذر % % 9(@)(@@) % بادر ولا تخش يا خضيب الأطراف % % من طالب وتري % % PageV01P493 البحر : - 1(@)(@@) % ما هكذا يا منى قلبي % % يجزي أخو الحسن عشاقه % 2(@)(@@) % نأيت والصب في كرب % % مبلبل القلب مشتاقه % % 3(@)(@@) % اعطف فديتك على الصب % لا ذقت في الحب ما ذاقه % PageV01P494 البحر : - 1(@)(@@) % يا كحيل الجفون % % لا تجعل العتب ضيقه % % 2(@)(@@) % الهوى له فنون % وله معان دقيقه % % 3(@)(@@) % خل عنك الظنون % % واسلك طريق الحقيقه % 4(@)(@@) % عاشقك لو يخون % ما أعطاك قلبه وثيقه % % 5(@)(@@) % سر حبك مصون % % ما سار غيرك طريقه % % 6(@)(@@) % ها عيوني عيون % % على خدودي دفيقه % % 7(@)(@@) % كم شجا كم شجون % ماذا هوى ذي حريقه % % PageV01P495 البحر : - 1(@)(@@) % يا بروق الحيا % % حيي ربوع الحبائب % 2(@)(@@) % مسبلات الحيا % % وساحبات الذوائب % 3(@)(@@) % مشرقات الضيا % % الغانيات الربائب % 4(@)(@@) % مذ نأت بي النيا % % قلبي من الشوق ذائب % 5(@)(@@) % طال بعدي فيا % % شوقي لتلك الغوائب % % PageV01P496 البحر : - 1(@)(@@) % يا غزال أمحره % % أكفف فديتك سهامك % 2(@)(@@) % لا تزدني شره % % إلى التثام لثامك % % 3(@)(@@) % فالهوى أيسره % % أضنى معنى غرامك % % 4(@)(@@) % في مقاك عنتره % وسمهرية قوامك % % 5(@)(@@) % سعد من أسكره % % ريقك وسلسل مدامك % 6(@)(@@) % صل محبك تره % حافظ وحقك ذمامك % 7(@)(@@) % شوقه اسهره % % وأنت تهنى منامك % PageV01P497 البحر : - 1(@)(@@) % من علمك يا رشا هجري % % وقال لك لا تصل صبك % % 2(@)(@@) % ترمي فؤادي ولا تدري % % بعذابي لا وأخذك ربك % % 3(@)(@@) % يرضيك أن أدمعي تجري % % وأنت مشغول في لعبك % 4(@)(@@) % مهلا فقد خانني صبري % % حسبك من الهجر حسبك % PageV01P498 البحر : - 1(@)(@@) % خشف الربى بهجة النادي % % زين المحيا كحيل العين % % 2(@)(@@) % أعاد بالوصل ميعادي % % وجاد لي فاتني بالدين % % 3(@)(@@) % ناديته يا رشا الوادي % % يكفيك هذا الحلا والزين % % 4(@)(@@) % ما ارتاح قلبي الشجي الصادي % % إلا للقياك بعد البين % % PageV01P499 البحر : - 1(@)(@@) % يا حمام الحبش % % ويا قماري الغواني % % 2(@)(@@) % يا نجوم الغبش % % ويا بدور المغاني % % 3(@)(@@) % الحلا والورش % % فيكم وكل المعاني % % PageV01P500 البحر : - 1(@)(@@) % يا عذيب 
ms137	 النيوب % % ويا حويلي المؤشر % % 2(@)(@@) % هاك ما في الجيوب % % وهات ما في المؤزر % % PageV01P501 البحر : مجزوء الرجز 1(@)(@@) % الأراجيز يقول راجي الصمد % علي ابن أحمد % 2(@)(@@) % حمدا لمن هداني % % بالنطق والبيان % 3(@)(@@) % وأشرف الصلاة % من واهب الصلات % % 4(@)(@@) % على النبي الهادي % % وآله الأمجاد % 5(@)(@@) % وبعد فالكلام % % لحسنه أقسام % 6(@)(@@) % والقول ذو فنون % % في الجد والمجون % % 7(@)(@@) % وروضة الأريض % % السجع والقريض % % 8(@)(@@) % والشعر ديوان العرب % وكم أنال من أرب % 9(@)(@@) % فانسل إذا رمت الأدب % % إليه من كل حدب % 10(@)(@@) % رواية الأشعار % تكسو الأديب العاري % % PageV01P502 11(@)(@@) % وترفع الوضيعا % % وتكرم الشفيعا % % 12(@)(@@) % وتنجح المآربا % % وتصلح المواربا % % 13(@)(@@) % وتطرب الإخوانا % % وتذهب الأحزانا % % 14(@)(@@) % وتنعش العشاقا % % وتؤنس المشتاقا % % 15(@)(@@) % وتنسخ الأحقادا % % وتثبت الودادا % % 16(@)(@@) % وتقدم الجبانا % % وتعطف الغضبانا % % 17(@)(@@) % وتنعت الحبيبا % % والرشأ الربيبا % % 18(@)(@@) % وخيره ما أطربا % % مستمعا وأعجبا % % 19(@)(@@) % % في فنها وجيزه % % 20(@)(@@) % بديعة الألفاظ % تسهل للحفاظ % % PageV01P503 21(@)(@@) % تطرب كل سامع % % بحسن لفظ جامع % % 22(@)(@@) % أبياتها قصور % % ما شانها قصور % % 23(@)(@@) % ضمنتها معاني % % في عشرة الإخوان % 24(@)(@@) % تشرح للألباب % % محاسن الأداب % 25(@)(@@) % فإن حسن العشرة % % ما حاز قوم عشره % % 26(@)(@@) % وأكثر الإخوان % في العصر والأوان % 27(@)(@@) % صحبتهم نفاق % % ما زانها وفاق % % 28(@)(@@) % يلقى الخليل خله % % إذا أتى محله % % 29(@)(@@) % بظاهر مموه % وباطن مشوه % % 30(@)(@@) % يظهر من صداقته % % ما هو فوق طاقته % % PageV01P504 31(@)(@@) % والقلب منه خالي % % كفارغ المخالي % % 32(@)(@@) % حتى إذا ما انصرفا % % أعرض عن ذاك الصفا % % 33(@)(@@) % وإن يكن ثم حسد % % أنشب إنشاب الأسد % % 34(@)(@@) % في عرضه مخالبه % % مستقصيا مثالبه % % 35(@)(@@) % مجتهدا في غيبته % % لم يرع حق غيبته % % 36(@)(@@) % فهذه صحبة من % % تراه في هذا الزمن % 37(@)(@@) % فلا تكن معتمدا % % على صديق أبدا % % 38(@)(@@) % وإن أطقت ألا % تصحب منهم خلا % 39(@)(@@) % فإنك الموفق % بل السعيد المطلق % % 40(@)(@@) % وإن قصدت الصحبه % % فخذ لها في الأهبه % % PageV01P505 41(@)(@@) % واحرص على آدابها % % تعد من أربابها % % 42(@)(@@) % واستنب عن شروطها % % توق من مسخوطها % % 43(@)(@@) % وإن أردت علمها % % وحدها ورسمها % % 44(@)(@@) % فاستمله من رجزي % % هذا البديع الموجز % 45(@)(@@) % فإنه كفيل % % بشرحه 
ms138	 حفيل % % 46(@)(@@) % فصلته فصولا % % تقرب الوصولا % % 47(@)(@@) % لمنهج الآداب % % في صحبة الأصحاب % % 48(@)(@@) % تهدي جميع الصحب % % إلى الطريق الرحب % 49(@)(@@) % سميته إذ أطربا % % بنظمه وأغربا % % 50(@)(@@) % بنغمة الأغاني % % في عشرة الإخوان % PageV01P506 51(@)(@@) % والله ربي أسأل % % وهو الكريم المفضل % % 52(@)(@@) % إلهامي الأمدادا % % ومنحي السدادا % % PageV01P507 البحر : كامل تام 1(@)(@@) % ولقد حللت من المنازل واديا % محل الجوانب إسمه البيضاء % % 2(@)(@@) % فرحلت عنه وقلت للركب ارحلوا % % عنه عليه الراية السوداء % % PageV01P508 البحر : بسيط تام 1(@)(@@) % انظر إلى الفحم فيه الجمر متقد % % كأنه بحر مسك موجه الذهب % PageV01P509 البحر : وافر تام 1(@)(@@) % أمير المؤمنين فدتك نفسي % % لنا من شأنك العجب العجاب % 2(@)(@@) % تولاك الألى سعدوا ففازوا % % وناواك الذين شقوا فخابوا % % 3(@)(@@) % ولو علم الورى ما أنت أضحوا % % لوجهك ساجدين ولم يحابوا % % 4(@)(@@) % يمن الله لو كشف المغطى % % ووجه الله لو رفع الحجاب % % 5(@)(@@) % خفيت عن العيون وأنت شمس % سمت عن أن يجللها سحاب % 6(@)(@@) % وليس على الصباح إذا تجلى % % ولم يبصره أعمى العين عاب % 7(@)(@@) % لسر ما دعاك أبا تراب % محمد النبي المستطاب % % 8(@)(@@) % فكان لكل من هو من تراب % إليك وأنت علته انتساب % % 9(@)(@@) % فلولا أنت لم تخلق سماء % ولولا أنت لم يخلق تراب % % 10(@)(@@) % وفيك وفي ولائك يوم حشر % يعاقب من يعاقب أو يثاب % PageV01P510 11(@)(@@) % بفضلك أفصحت توراة موسى % % وإنجيل ابن مريم والكتاب % % 12(@)(@@) % فيا عجبا لمن ناواك قدما % ومن قوم لدعوتهم أجابوا % % 13(@)(@@) % أزاعوا عن صراط الحق عمدا % فضلوا عنك أم خفي الصواب % 14(@)(@@) % أم ارتابوا بما لا ريب فيه % % وهل في الحق إذ صدع ارتياب % 15(@)(@@) % وهل لسواك بعد غدير خم % نصيب في الخلافة أو نصاب % % 16(@)(@@) % ألم يجعلك مولاهم فذلت % % على رغم هناك لك الرقاب % 17(@)(@@) % فلم يطمح إليها هاشمي % وإن أضحى له الحسب اللباب % 18(@)(@@) % فمن يتم بعد مرة أو عدي % % وهم سيان إن حضروا وغابوا % % 19(@)(@@) % لئن جحدوك حقك عن شقاء % فبالأشقين ما حل العقاب % % 20(@)(@@) % فكم سفهت عليك حلوم قوم % فكنت البدر تنبحه الكلاب % % PageV01P511 البحر : وافر تام 1(@)(@@) % إذا 
ms139	 ضلت قلوب عن هداها % % فلم تدر العقاب من الثواب % 2(@)(@@) % فأرشدها جزاك الله خيرا % بارشاد القلوب إلى الصواب % PageV01P512 البحر : مجزوء الكامل 1(@)(@@) % يا أيها المولى الذي % % أضحى بمجد مستطاب % 2(@)(@@) % ما كان ردي للكتاب % % وحق فضلك والكتاب % % 3(@)(@@) % إلا لعلمك إنه % % قشر وسمي باللباب % 4(@)(@@) % فاصفح بفضلك عن فتى % قد ضل في ليل الشباب % % 5(@)(@@) % والشيخ أولى من عفا % % عن ذنب غر في التصابي % % PageV01P513 البحر : سريع 1(@)(@@) % ما عاد عاشوراء إلا همت % عيني بدمع هاطل ساكب % 2(@)(@@) % وجدا على سبط الرسول % % الحسين بن علي بن أبي طالب % PageV01P514 البحر : طويل 1(@)(@@) % دعاه على سهل الغرام وصعبه % % فماذا عليكم إن أضر بقلبه % % 2(@)(@@) % أقلا عليه في الملام فإنه % % يرى الموت أصفى من كدورة خطبه % % 3(@)(@@) % وليس بمجد يا خليلي لومه % % فإن الهوى قد سيط منه بلبه % % 4(@)(@@) % ولو ذقتما ما ذاق من لاعج الهوى % % لأيقنتما أن العذاب بعذبه % % 5(@)(@@) % يبيت على جمر الغرام وينطوي % % وتصبيه ذكرى غور سلع ومن به % % 6(@)(@@) % يحن إلى أوطانه ثم ينثني % % على قلبه كي لا يذوب بكربه % % 7(@)(@@) % وإن لاح من نجد وميض توقدت % % بأحشائه نار الغرام وجنبه % 8(@)(@@) % وليس له عن منهج الحب منهج % وكيف ومهما أومض البرق يصبه % % PageV01P515 البحر : - 1(@)(@@) % أفديه من رشأ تبدى واختفى % % كالبدر عن طلوعه ومغيبه % % 2(@)(@@) % يجفو ويهجر معرضا متدللا % ويصد معتذرا بخوف رقيبه % % 3(@)(@@) % نفسي الفداء له فقد حسن الهوى % % فيه وطاب بحسنه وبطيبه % 4(@)(@@) % ما شاء فليصنع فقلبي طوعه % % ودع العذول يلج في تأنيبه % % PageV01P516 البحر : خفيف تام 1(@)(@@) % يهلك المال بالعطاء ويحيا % % ميت فضل فاعجب لمحي مميت % PageV01P517 البحر : طويل 1(@)(@@) % رويدك حادي العيس أين تريد % % أما هذه حزوى وتلك زرود % % PageV01P518 البحر : طويل 1(@)(@@) % لقد كنت أبكي قبل أن أعرف النوى % % مخافة بين والخطوب هجود % % 2(@)(@@) % فكيف وقد شط المزار وأصبحت % أيادي النوى تحدو بنا وتقود % PageV01P519 البحر : كامل تام 1(@)(@@) % هو طود علم لا يبارى رفعة % ومحيط فضل لا يزال مديدا % % 2(@)(@@) % علم إذا جارت صوائب غيره % % أبدى لنا رأيا 
ms140	 لديه سديدا % % 3(@)(@@) % أحيا رباع المكرمات بفضله % % من بعد أن كانت مهامه بيدا % % 4(@)(@@) % وإليه ألقي الفضل صعب زمامه % % ودنا له طوعا وكان بعيدا % % 5(@)(@@) % كم حجة في الخلق شاد عمادها % % كرها وأرضى العدل والتوحيدا % % PageV01P520 البحر : خفيف تام 1(@)(@@) % يا بريق الحيا ويا عذب البا % % ن لقد هجتما لقلبي وجدا % % 2(@)(@@) % زدتماني شوقا لظبي غرير % حين أشبهتماه ثغرا وقدا % % 3(@)(@@) % هكذا كل مغرم إن سرى البر % % ق وهز النسيم بانا ورندا % % 4(@)(@@) % يستجد الأشواق وجدا ويزدا % % د بتذكاره على الوقد وقدا % % 5(@)(@@) % لا أخص النسيم والبرق والبا % % ن وإن جددت لشوقي عهدا % % 6(@)(@@) % كل ما في الوجود يصبي المعنى % % بهوى ذلك الجمال المفدى % % PageV01P521 البحر : مجزوء الكامل 1(@)(@@) % من ذا الذي شرع المحب % % ة والتواصل والوداد % 2(@)(@@) % فكأنه لم يدر ما % % محن التفرق والبعاد % % PageV01P522 البحر : بسيط تام 1(@)(@@) % الحمد لله حمدا دائما أبدا % % على اجتماع به صبح الرجاء بدا % % PageV01P523 البحر : كامل تام 1(@)(@@) % أمعاد هل يفضي إليك معادي % % يوما برغم معاند ومعاد % 2(@)(@@) % فأفوز منك بكل ما أملته % % ذخرا لآخرتي ويوم معادي % % PageV01P524 البحر : بسيط تام 1(@)(@@) % ما كنت أحسب أن الشمل منتظم % حتى أتيت نظام الدين والجود % % PageV01P525 البحر : سريع 1(@)(@@) % لما رأت عيني عين الذي % % عاد لقربي بعد إبعادي % % 2(@)(@@) % قالت لقلبي لا تشك الصدى % % ما أقرب العين من الصادي % % PageV01P526 البحر : طويل 1(@)(@@) % وبثوا الجياد السابحات ليلحقوا % % وهل يدرك الكسلان شأو أخي الجد % % 2(@)(@@) % فساروا وعادوا خائبين على وجى % كما خاب من قد بات منهم على وعد % PageV01P527 البحر : كامل تام 1(@)(@@) % يا حبذا الفيل الذي شاهدته % % وشهدت منه ما نمى لي ذكره % 2(@)(@@) % فكأنه وكأن أبيض نابه % % ليل تبلج للنواظر فجره % PageV01P528 البحر : كامل تام 1(@)(@@) % لا تحسبن فرند صارمه به % % وشيا أجادته القيون وجوهرا % % 2(@)(@@) % بل ذاك غيل الماء أزعجه الذي % % كسر الندى فجرى به متكسرا % % PageV01P529 البحر : طويل 1(@)(@@) % ولله ظبي كالهلال جبينه % % رماني بسهم من جفون فواتر % % 2(@)(@@) % جرت بمآقيها الدموع كأنها % % مياه فرند في شفار بواتر % 3(@)(@@) % يشير بطرف 