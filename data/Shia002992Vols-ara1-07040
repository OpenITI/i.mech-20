ms7027	 أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 4، ك 1، ب 42، ح 9.(@)(@@) * روى عن بعض أصحابنا، عن عبد الله بن مسكان، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 2، ب 149، ح 8.(@)(@@) * وروى عن بعض أصحابه عن أبي حفص الابار، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 6، ب 118، ح 1.(@)(@@) * وروى عن رجل من أصحابنا، مرفوعا عن أبي عبد الله عليه السلام، وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 1، ك 2، ب 1، ح 5.(@)(@@) * وروى مرفوعا إلى أبي جعفر عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 10، ح 2، و ب 170، ح 7، و ج 5، ك 3، ب 157، ح 6.(@)(@@) * وروى مرفوعا عن أبي حمزة الثمالي، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 142، ح 7.(@)(@@) * وروى مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 3، ك 1، ب 38، ح 7.(@)(@@) * وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 5، ك 3، ب 157، ح 9، و 10.(@)(@@) * وروى عمن حدثه عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 3، ب 30، ح 2.(@)(@@) والتهذيب: ج 7، ح 1623.(@)(@@) * وروى عمن حدثه عن عبد الرحمن العرزمي، وروى عنه أحمد ابنه. PageV22P415(@)(@@) الكافي: ج 6، ك 6، ب 25، ح 2، و ب 47، ح 14. والتهذيب: ج 9، ح 405.(@)(@@) * وروى عمن حدثه عن عمرو بن أبي المقدام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 2، ب 159، ح 48.(@)(@@) والتهذيب: ج 7، ح 986.(@)(@@) * وروى عمن حدثه عن محمد بن عبد الرحمن بن أبي ليلى، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 128، ح 1.(@)(@@) * وروى عمن ذكره، عن أبي حفص الابار، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 6، ب 83، ح 6.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 2، ب 41، ح 1، و ج 6، ك 9، ب 4، ح 6.(@)(@@) * وروى عمن ذكره، عن أيوب بن الحر.(@)(@@) الكافي: ج 6، ك 8، ب 38، ح 6.(@)(@@) * وروى عمن ذكره، عن الحسين بن أبي العلاء، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 4، ك 1، ب 17، ح 6.(@)(@@) * وروى عمن ذكره، عن الحسين بن المختار، وروى عنه أحمد ابنه. 
ms7028	(@)(@@) الكافي: ج 5، ك 3، ب 157، ح 5.(@)(@@) (أبو عبد الله البرقي) * روى عن أبي جعفر عليه السلام، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 3، ح 98.(@)(@@) * وروى عن أبي جعفر الثاني عليه السلام.(@)(@@) الفقيه: ج 1، ح 1113.(@)(@@) * وروى عن أبي طالب، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 47، ح 19.(@)(@@) * وروى عن أبي علي بن راشد، وروى عنه الحسن بن علي بن النعمان.(@)(@@) التهذيب: ج 5، ح 1494 (الإستبصار:(@)(@@) ج 2، ح 1191).(@)(@@) * وروى عن ابن أبي عمير، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى الفضيل ابن يسار.(@)(@@) * وروى عن ابن سنان، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1106 (الإستبصار:(@)(@@) ج 3، ح 522).(@)(@@) * وروى عن أحمد بن محمد بن أبي نصر، وروى عنه أحمد بن محمد. PageV22P416(@)(@@) التهذيب: ج 8، ح 31.(@)(@@) * وروى عن أحمد بن النصر الخزاز، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى عمرو بن شمر.(@)(@@) وروى عن إسماعيل الجعفي.(@)(@@) * وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 743 (الإستبصار:(@)(@@) ج 1، ح 614).(@)(@@) * وروى عن بكر بن محمد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 5.(@)(@@) * وروى عنه محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 53، ح 12.(@)(@@) * وروى عن جعفر بن بشير، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1536 (الإستبصار:(@)(@@) ج 2، ح 1171).(@)(@@) * وروى عن حمزة بن عبد الله، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى علي بن عبد العزيز.(@)(@@) * وروى عن الربعي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 8، ح 285 (الإستبصار:(@)(@@) ج 3، ح 1098).(@)(@@) * وروى عن عثمان بن عيسى، وروى عنه أبو إسحاق النهاوندي.(@)(@@) التهذيب: ج 1، ح 1160.(@)(@@) * وروى عن علي بن مهزيار، وروى عنه الحسن بن علي بن النعمان.(@)(@@) التهذيب: ج 5، ح 1494 (الإستبصار:(@)(@@) ج 2، ح 1191).(@)(@@) * وروى عن عيسى بن عبد الله القمي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 52، ح 1.(@)(@@) * وروى عن فضالة بن أيوب، وروى عنه محمد بن عبد الجبار. 
ms7029	(@)(@@) الكافي: ج 1، ك 4، ب 59، ح 7.(@)(@@) * وروى عن غياث بن إبراهيم، وروى عنه أحمد ابنه.(@)(@@) التهذيب: ج 6، ح 709 (الإستبصار:(@)(@@) ج 3، ح 77).(@)(@@) * وروى عن محمد بن أبي عمير، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى إسماعيل ابن رياح، وإلى الحكم بن حكيم بن أبي خلاد، وإلى عبد الله بن يعفور.(@)(@@) * وروى عن محمد بن سنان، وروى PageV22P417(@)(@@) عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى عبد الله بن حماد الأنصاري، وإلى عمر بن قيس الماصر، وإلى النعمان بن سعيد.(@)(@@) * وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 7، ح 1211 (الإستبصار:(@)(@@) ج 3، ح 624).(@)(@@) * وروى عن محمد بن الفضيل، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1577.(@)(@@) * وروى عن محمد بن مصادف، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 1200 (الإستبصار:(@)(@@) ج 1، ح 1220).(@)(@@) * وروى عن النضر بن سويد، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى أيوب بن الحر.(@)(@@) * وروى عن يونس بن عبد الرحمن، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى الحسن بن زياد، وإلى الحسن الصقيل.(@)(@@) * وروى عن السراد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 32، ح 4.(@)(@@) والتهذيب: ج 6، ح 1007 (الإستبصار:(@)(@@) ج 3، ح 186).(@)(@@) * وروى عن بعض أصحابنا عن أبي جعفر عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 25، ح 5.(@)(@@) * وروى عن بعض أصحابنا مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 4، ك 1، ب 24، ح 2.(@)(@@) * وروى عن بعض أصحابه، عن بعض الصادقين عليهم السلام، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 10، ح 516 (الإستبصار:(@)(@@) ج 4، ح 955).(@)(@@) * وروى مرفوعة مضمرة، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 52.(@)(@@) * وروى عمن ذكره عن منصور بن حازم، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1399 (الإستبصار:(@)(@@) ج 2، ح 1125). PageV22P418(@)(@@) (أبو عبد الله الرازي) * روى عن أحمد بن محمد بن أبي نصر، وروى عنه محمد بن 
