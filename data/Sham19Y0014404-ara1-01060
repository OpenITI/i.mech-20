ms1041	 وألف بعدها؛ لأنه جواب لقول فرعون فيما استشارهم فيه من أمر موسى بعد قوله: {إن هذا لساحر عليم}، فأجابوه بما هو أبلغ من قوله؛ رعاية PageV05P058 (@@) لمراده؛ بخلاف التي في الأعراف؛ فإن ذلك جواب لقولهم، فتناسب اللفظان، وأما التي في يونس، فهي أيضا جواب من فرعون لهم؛ حيث قالوا: {إن هذا لسحر مبين} [الآية: 76] فرفع مقامه على المبالغة، والله أعلم.(@)(@@) قرأ أبو عمرو، والكسائي من رواية الدوري: (سحار) بالإمالة أيضا (¬1)، واختلف عن ابن ذكوان، وروي عن ورش وحمزة (¬2): الإمالة بين بين، وقرأ الباقون: بالفتح (¬3).(@)(@@) ...(@)(@@) {فجمع السحرة لميقات يوم معلوم (38)}.(@)(@)(@@)(@@)(@@) || AUTO [38](@)(@)(@@) {فجمع السحرة لميقات يوم معلوم} وهو يوم الزينة، وهو عيد كان لهم يتزينون ويجتمعون فيه كل سنة، قال ابن عباس: "وافق ذلك يوم السبت في أول يوم من السنة، وهو يوم النيروز" (¬4).(@)(@@) ...(@)(@@) {وقيل للناس هل أنتم مجتمعون (39)}.(@)(@)(@@)(@@)(@@) || AUTO [39](@)(@)(@@) {وقيل للناس هل أنتم مجتمعون} حث للناس على الاجتماع.(@)(@@) ...(@)(@)PageV05P059(@)(@)(@@) {لعلنا نتبع السحرة إن كانوا هم الغالبين (40)}.(@)(@)(@@)(@@)(@@) || AUTO [40](@)(@)(@@) {لعلنا} لكي {نتبع السحرة إن كانوا هم الغالبين} لموسى.(@)(@@) ...(@)(@@) {فلما جاء السحرة قالوا لفرعون أئن لنا لأجرا إن كنا نحن الغالبين (41)}.(@)(@)(@@)(@@)(@@) || AUTO [41](@)(@)(@@) {فلما جاء السحرة قالوا لفرعون أئن لنا لأجرا} أي: تجعل لنا جعلا.(@)(@@) {إن كنا نحن الغالبين} لموسى. قرأ نافع، وابن كثير، وأبو عمرو، وأبو جعفر، ورويس عن يعقوب: (أين) بتحقيق الهمزة الأولى وتسهيل الثانية بين بين؛ أي: بين الهمزة والياء، وفصل بين الهمزتين بألف: أبو عمرو، وأبو جعفر، وقالون، واختلف عن هشام، وقرأ الكوفيون، وابن عامر، وروح عن يعقوب: بتحقيق الهمزتين (¬1).(@)(@@) ...(@)(@@) {قال نعم وإنكم إذا لمن المقربين (42)}.(@)(@)(@@)(@@)(@@) || AUTO [42](@)(@)(@@) {قال نعم وإنكم إذا لمن المقربين} وعدهم فرعون بالإحسان إليهم بشرط غلبة موسى. قرأ الكسائي: (نعم) بكسر العين، والباقون: بنصبها (¬2).(@)(@@) ...(@)(@)PageV05P060(@)(@)(@@) {قال لهم موسى ألقوا ما أنتم ملقون (43)}.(@)(@)(@@)(@@)(@@) || AUTO [43](@)(@)(@@) {قال لهم موسى ألقوا ما أنتم ملقون} أي: بعدما قالوا له: {إما أن تلقي وإما أن نكون نحن الملقين} [الأعراف: 115].(@)(@@) ...(@)(@@) {فألقوا حبالهم وعصيهم وقالوا بعزة فرعون إنا لنحن الغالبون (44)}.(@)(@)(@@)(@@)(@@) || AUTO [44](@)(@)(@@) {فألقوا حبالهم وعصيهم وقالوا} حالفين.(@)(@@) {بعزة فرعون إنا 
ms1042	 لنحن الغالبون} والقسم بغير الله من أقسام الجاهلية، قال - صلى الله عليه وسلم -: "لا تحلفوا بآبائكم وأمهاتكم، ولا بالطواغيت، ولا تحلفوا بالله إلا وأنتم صادقون" (¬1).(@)(@@) ...(@)(@@) {فألقى موسى عصاه فإذا هي تلقف ما يأفكون (45)}.(@)(@)(@@)(@@)(@@) || AUTO [45](@)(@)(@@) {فألقى موسى عصاه فإذا هي تلقف} تتبع {ما يأفكون} ما يزورون ويخيلون أن حبالهم وعصيهم حيات. قرأ حفص عن عاصم: (تلقف) بإسكان اللام مع تخفيف القاف، وقرأ الباقون: بفتح اللام مع تشديد القاف، وقرأ البزي: بتشديد التاء وصلا؛ كأنه أراد: تتلقف، فأدغم (¬2).(@)(@)PageV05P061(@)(@)(@@) {فألقي السحرة ساجدين (46)}.(@)(@)(@@)(@@)(@@) || AUTO [46](@)(@)(@@) {فألقي السحرة ساجدين} وإنما يدل الخرور بالإلقاء ليشاكل ما قبله، ويدل على أنهم لما رأوا ما رأوا، لم يتمالكوا أنفسهم، فكأنهم أخذوا فطرحوا على وجوههم.(@)(@@) ...(@)(@@) {قالوا آمنا برب العالمين (47)}.(@)(@)(@@)(@@)(@@) || AUTO [47](@)(@)(@@) {قالوا آمنا برب العالمين}.(@)(@@) ...(@)(@@) {رب موسى وهارون (48)}.(@)(@)(@@)(@@)(@@) || AUTO [48](@)(@)(@@) {رب موسى وهارون} قال عكرمة: أصبحوا سحرة، وأمسوا شهداء (¬1)، فالمغرور من اعتمد على شيء من أعماله وأقواله وأحواله.(@)(@@) ...(@)(@@) {قال آمنتم له قبل أن آذن لكم إنه لكبيركم الذي علمكم السحر فلسوف تعلمون لأقطعن أيديكم وأرجلكم من خلاف ولأصلبنكم أجمعين (49)}.(@)(@)(@@)(@@)(@@) || AUTO [49](@)(@)(@@) {قال آمنتم له قبل أن آذن لكم إنه لكبيركم الذي علمكم السحر فلسوف تعلمون لأقطعن أيديكم وأرجلكم من خلاف ولأصلبنكم أجمعين} تقدم تفسير نظيرها، واختلاف القراء في الهمزتين في سورة طه.(@)(@)PageV05P062(@)(@)(@@) {قالوا لا ضير إنا إلى ربنا منقلبون (50)}.(@)(@)(@@)(@@)(@@) || AUTO [50](@)(@)(@@) {قالوا لا ضير} أي: لا ضرر علينا بما تصنع بنا. قرأ حمزة: (لا ضير) بالمد؛ بحيث لا يبلغ الإشباع (¬1) {إنا إلى ربنا منقلبون} فيثيبنا.(@)(@@) ...(@)(@@) {إنا نطمع أن يغفر لنا ربنا خطايانا أن كنا أول المؤمنين (51)}.(@)(@)(@@)(@@)(@@) || AUTO [51](@)(@)(@@) {إنا نطمع أن يغفر لنا ربنا خطايانا أن كنا} أي: لأن كنا.(@)(@@) {أول المؤمنين} في زماننا.(@)(@@) ...(@)(@@) {وأوحينا إلى موسى أن أسر بعبادي إنكم متبعون (52)}.(@)(@)(@@)(@@)(@@) || AUTO [52](@)(@)(@@) {وأوحينا إلى موسى أن أسر} قرأ نافع، وأبو جعفر، وابن كثير: (أن اسر) بوصل الألف ويكسرون النون من (أن) للساكنين وصلا؛ كان سرى (¬2) يسري (¬3)، ويبتدئون بكسر الهمزة، وقرأ الباقون: بقطع الهمزة مفتوحة وحمزة يسكت على الساكن قبل الهمز؛ لبيان الهمز وتحقيقه (¬4) {بعبادي} 
ms1043	 قرأ نافع، وأبو جعفر: (بعبادي) بفتح الياء، والباقون: بإسكانها (¬5).(@)(@)PageV05P063(@)(@)(@@) {إنكم متبعون} أي: يتبعكم فرعون وقومه؛ ليحولوا بينكم وبين الخروج من مصر، فسر بهم، حتى إذا اتبعكم مصبحين، كان لكم تقدم عليهم؛ بحيث لا يدركونكم قبل وصولكم البحر، بل يكونون على إثركم حين تلجون البحر، فيدخلون مدخلكم، فأطبقه عليهم، فأغرقهم.(@)(@@) ...(@)(@@) {فأرسل فرعون في المدائن حاشرين (53)}.(@)(@)(@@)(@@)(@@) || AUTO [53](@)(@)(@@) {فأرسل فرعون} حين أخبر بسراهم.(@)(@@) {في المدائن حاشرين} أي: جامعين الناس.(@)(@@) ...(@)(@@) {إن هؤلاء لشرذمة قليلون (54)}.(@)(@)(@@)(@@)(@@) || AUTO [54](@)(@)(@@) وقال: {إن هؤلاء لشرذمة} أي: طائفة.(@)(@@) {قليلون} ومنه: ثوب شراذم؛ أي: بال منقطع، وكانت الشرذمة ست مئة وسبعين ألفا، ولا يحصى عدد أصحاب فرعون.(@)(@@) ...(@)(@@) {وإنهم لنا لغائظون (55)}.(@)(@)(@@)(@@)(@@) || AUTO [55](@)(@)(@@) {وإنهم لنا لغائظون} مغضبون، والغيظ: أشد الغضب، وهو الحرارة التي يجدها الإنسان من ثوران دم قلبه.(@)(@@) ...(@)(@)PageV05P064(@)(@)(@@) {وإنا لجميع حاذرون (56)}.(@)(@)(@@)(@@)(@@) || AUTO [56](@)(@)(@@) {وإنا لجميع حاذرون} قرأ الكوفيون، وابن ذكوان عن ابن عامر: (حاذرون) بألف بعد الحاء؛ أي: تامو الأسلحة، وقرأ الباقون: بحذف الألف؛ أي: متيقظون (¬1).(@)(@@) ...(@)(@@) {فأخرجناهم من جنات وعيون (57)}.(@)(@)(@@)(@@)(@@) || AUTO [57](@)(@)(@@) {فأخرجناهم من جنات} بساتين كانت ممتدة على حافتي النيل.(@)(@@) {وعيون} من الماء. قرأ ابن كثير، وحمزة، والكسائي، وأبو بكر (¬2)، وابن ذكوان: (وعيون) بكسر العين حيث وقع، والباقون: بضمها (¬3).(@)(@@) ...(@)(@@) {وكنوز ومقام كريم (58)}.(@)(@)(@@)(@@)(@@) || AUTO [58](@)(@)(@@) {وكنوز} وهي أموالهم الظاهرة من الذهب والفضة، سميت كنوزا؛ لأنها لم يعط منها حق الله تعالى.(@)(@@) {ومقام كريم} أي: المنازل الحسنة والمجالس البهية.(@)(@@) ...(@)(@)PageV05P065(@)(@)(@@) {كذلك وأورثناها بني إسرائيل (59)}.(@)(@)(@@)(@@)(@@) || AUTO [59](@)(@)(@@) {كذلك} كما وصفنا {وأورثناها} بهلاكهم.(@)(@@) {بني إسرائيل} وذلك أن الله تعالى ردهم إلى مصر بعد غرق فرعون وقومه، وخولهم في أموالهم ومساكنهم.(@)(@@) ...(@)(@@) {فأتبعوهم مشرقين (60)}.(@)(@)(@@)(@@)(@@) || AUTO [60](@)(@)(@@) {فأتبعوهم} أي: لحقوهم القبط.(@)(@@) {مشرقين} عند شروق الشمس وإضاءتها.(@)(@@) ...(@)(@@) {فلما تراءى الجمعان قال أصحاب موسى إنا لمدركون (61)}.(@)(@)(@@)(@@)(@@) || AUTO [61](@)(@)(@@) {فلما تراءى الجمعان} أي: رأى كل الآخر. قرأ حمزة، وخلف: (تراءى) بإمالة فتحة الراء حالة الوصل، وأما إذا وقفا، أمالا الراء والهمزة جميعا، ومعهما الكسائي في الهمزة فقط، وأما ورش: على أصله فيهما بين بين؛ بخلاف عنه (¬1).(@)(@@) {قال أصحاب موسى إنا لمدركون} سيدركنا قوم فرعون، ولا طاقة لنا بهم.(@)(@@) ...(@)(@)PageV05P066(@)(@)(@@) {قال 
ms1044	 كلا إن معي ربي سيهدين (62)}.(@)(@)(@@)(@@)(@@) || AUTO [62](@)(@)(@@) {قال} موسى ثقة بوعد الله إياه: {كلا إن معي ربي سيهدين} طريق النجاة. قرأ حفص عن عاصم: (معي) بفتح الياء (¬1)، وقرأ يعقوب: (سيهديني) بإثبات الياء (¬2).(@)(@@) ...(@)(@@) {فأوحينا إلى موسى أن اضرب بعصاك البحر فانفلق فكان كل فرق كالطود العظيم (63)}.(@)(@)(@@)(@@)(@@) || AUTO [63](@)(@)(@@) {فأوحينا إلى موسى أن اضرب بعصاك البحر} ولما وصل موسى إلى البحر، جاء بموج كالجبال، فقال يوشع: يا مكلم الله! أين أمرت؟ فقال: هاهنا، فكبح فرسه بلجامه حتى طار الزبد من شدقيه، ثم أقحمه اللج، فارتسب في البحر، وأراد بقيتهم أن يفعلوا مثله فلم يقدروا (¬3) {فانفلق} ماء البحر بعد أن ضربه، فانشق اثني عشر طريقا لاثني عشر سبطا.(@)(@@) {فكان كل فرق} أي: كل جزء من البحر {كالطود} أي: الجبل.(@)(@@) {العظيم} وهو بحر القلزم، وتقدم ذكره ومحله في سورة البقرة عند تفسير قوله تعالى: {وإذ فرقنا بكم البحر} [الآية: 50]، وروي (¬4) أن PageV05P067 (@@) موسى عليه السلام قال عند ذلك: يا من كان قبل كل شيء، والمكون لكل شيء، والكائن بعد كل شيء (¬1).(@)(@@) ...(@)(@@) {وأزلفنا ثم الآخرين (64)}.(@)(@)(@@)(@@)(@@) || AUTO [64](@)(@)(@@) {وأزلفنا} قربنا {ثم} حيث انفلق البحر.(@)(@@) {الآخرين} هم القبط، جمعناهم في البحر حتى غرقوا.(@)(@@) ...(@)(@@) {وأنجينا موسى ومن معه أجمعين (65)}.(@)(@)(@@)(@@)(@@) || AUTO [65](@)(@)(@@) {وأنجينا موسى ومن معه أجمعين} من الغرق.(@)(@@) ...(@)(@@) {ثم أغرقنا الآخرين (66)}.(@)(@)(@@)(@@)(@@) || AUTO [66](@)(@)(@@) {ثم أغرقنا الآخرين} يعني: فرعون وقومه.(@)(@@) ...(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين (67)}.(@)(@)(@@)(@@)(@@) || AUTO [67](@)(@)(@@) {إن في ذلك} أي: إهلاك القبط {لآية} عبرة للمعتبرين.(@)(@@) {وما كان أكثرهم} أي: المصريين {مؤمنين} قالوا: لم يكن فيهم PageV05P068 (@@) مؤمن إلا آسية امرأة فرعون، وحزبيل المؤمن، ومريم بنت ناموسا التي دلت على عظام يوسف عليه السلام.(@)(@@) ...(@)(@@) {وإن ربك لهو العزيز الرحيم (68)}.(@)(@)(@@)(@@)(@@) || AUTO [68](@)(@)(@@) {وإن ربك لهو العزيز} في انتقامه من أعدائه.(@)(@@) {الرحيم} بالمؤمنين حين أنجاهم.(@)(@@) ...(@)(@@) {واتل عليهم نبأ إبراهيم (69)}.(@)(@)(@@)(@@)(@@) || AUTO [69](@)(@)(@@) {واتل عليهم} على مشركي العرب.(@)(@@) {نبأ إبراهيم} قرأ الكوفيون، وابن عامر، وروح عن يعقوب: (نبأ إبراهيم) بتحقيق الهمزتين، والباقون: بتحقيق الأولى، وتسهيل الثانية (¬1).(@)(@@) ...(@)(@@) {إذ قال لأبيه وقومه ما تعبدون (70)}.(@)(@)(@@)(@@)(@@) || AUTO [70](@)(@)(@@) {إذ قال لأبيه وقومه ما تعبدون} استفهام 
ms1045	 بمعنى التقرير.(@)(@@) ...(@)(@@) {قالوا نعبد أصناما فنظل لها عاكفين (71)}.(@)(@)(@@)(@@)(@@) || AUTO [71](@)(@)(@@) {قالوا نعبد أصناما} والصنم: ما كان على صورة ابن آدم من حجر أو غيره.(@)(@)PageV05P069(@)(@)(@@) {فنظل لها عاكفين} أي: نقيم على عبادتها، ويظل: عرفها: فعل الشيء نهارا، وبات: عرفها في فعله ليلا، وطفق: غاية للوجهين، ولكن قد تجيء يظل بمعنى العموم، وهذا الموضع من ذلك، والعكوف: اللزوم، ومنه: المعتكف.(@)(@@) ...(@)(@@) {قال هل يسمعونكم إذ تدعون (72)}.(@)(@)(@@)(@@)(@@) || AUTO [72](@)(@)(@@) {قال} إبراهيم.(@)(@@) {هل يسمعونكم} أي: يسمعون دعاءكم {إذ تدعون}.(@)(@@) ...(@)(@@) {أو ينفعونكم أو يضرون (73)}.(@)(@)(@@)(@@)(@@) || AUTO [73](@)(@)(@@) {أو ينفعونكم} إن عبدتموهم {أو يضرون} إن تركتم عبادتهم.(@)(@@) ...(@)(@@) {قالوا بل وجدنا آباءنا كذلك يفعلون (74)}.(@)(@)(@@)(@@)(@@) || AUTO [74](@)(@)(@@) فلما عجزوا عن الجواب {قالوا بل وجدنا آباءنا كذلك يفعلون} فقلدناهم.(@)(@@) ...(@)(@@) {قال أفرأيتم ما كنتم تعبدون (75)}.(@)(@)(@@)(@@)(@@) || AUTO [75](@)(@)(@@) {قال} إبراهيم: {أفرأيتم ما كنتم تعبدون}.(@)(@@) ***(@)(@)PageV05P070(@)(@)(@@) {أنتم وآباؤكم الأقدمون (76)}.(@)(@)(@@)(@@)(@@) || AUTO [76](@)(@)(@@) {أنتم وآباؤكم الأقدمون}.(@)(@@) {فإنهم عدو لي إلا رب العالمين (77)}.(@)(@)(@@)(@@)(@@) || AUTO [77](@)(@)(@@) {فإنهم} أي: أصنامكم {عدو لي} أي: أعداء، ووحده على معنى: أن كل معبود لكم عدو لي، وقوله: (عدو لي) دون (لكم) زيادة نصح وتأدب؛ ليكون أعطف لقلوبهم، وأسرع لها إلى إيمانهم.(@)(@@) {إلا رب العالمين} استثناء منقطع؛ كأنه قال: فإنهم عدو لي، لكن رب العالمين وليي. قرأ نافع، وأبو جعفر، وأبو عمرو: (عدو لي) بفتح الياء، والباقون: بإسكانها (¬1).(@)(@@) ...(@)(@@) {الذي خلقني فهو يهدين (78)}.(@)(@)(@@)(@@)(@@) || AUTO [78](@)(@)(@@) ثم وصف معبوده فقال: {الذي خلقني} مبتدأ، خبره:(@)(@@) {فهو يهدين} إلى إصلاح الدارين.(@)(@@) ...(@)(@@) {والذي هو يطعمني ويسقين (79)}.(@)(@)(@@)(@@)(@@) || AUTO [79](@)(@)(@@) {والذي هو يطعمني ويسقين} تعديد للنعمة في الرزق.(@)(@@) ...(@)(@)PageV05P071(@)(@)(@@) {وإذا مرضت فهو يشفين (80)}.(@)(@)(@@)(@@)(@@) || AUTO [80](@)(@)(@@) {وإذا مرضت فهو يشفين} من مرضي، وأسند إبراهيم المرض إلى نفسه، والشفاء إلى الله عز وجل، وهذا أحسن الأدب في العبارة، والكل من عند الله؛ كالخضر حين قال في العيب: {فأردت أن أعيبها} [الكهف: 79]، وفي الخير: {فأراد ربك أن يبلغا أشدهما} [الكهف: 82].(@)(@@) ...(@)(@@) {والذي يميتني ثم يحيين (81)}.(@)(@)(@@)(@@)(@@) || AUTO [81](@)(@)(@@) {والذي يميتني ثم يحيين} أدخل (ثم) هنا للتراخي؛ أي: يميتني في الدنيا، ثم يحييني في الآخرة. قرأ يعقوب: (يهديني) (يسقيني) (يشفيني) (يحييني) بإثبات الياء في الأربعة في الحالين، والباقون: بحذفها 
ms1046	 فيهما (¬1).(@)(@@) ...(@)(@@) {والذي أطمع أن يغفر لي خطيئتي يوم الدين (82)}.(@)(@)(@@)(@@)(@@) || AUTO [82](@)(@)(@@) {والذي أطمع أن يغفر لي خطيئتي يوم الدين} أي: خطاياي يوم الجزاء، وهي قوله: {إني سقيم} [الصافات: 89]، وقوله: {بل فعله كبيرهم هذا} [الأنياء: 63]، وقوله لسارة: هذه أختي، وقوله للكوكب (¬2): {هذا ربي} [الأنعام: 76]، وعلق المغفرة بيوم الدين، وإن PageV05P072 (@@) وجدت هنا؛ لأن فائدتها ثم تظهر، وأصل الطمع: نزوع النفس إلى الشيء شهوة، وهذا كله احتجاج من إبراهيم على قومه، وإخبار أنه لا يصلح للإلهية من لا يفعل هذه الأفعال.(@)(@@) ...(@)(@@) {رب هب لي حكما وألحقني بالصالحين (83)}.(@)(@)(@@)(@@)(@@) || AUTO [83](@)(@)(@@) {رب هب لي حكما} نبوة.(@)(@@) {وألحقني بالصالحين} بآبائي المرسلين.(@)(@@) ...(@)(@@) {واجعل لي لسان صدق في الآخرين (84)}.(@)(@)(@@)(@@)(@@) || AUTO [84](@)(@)(@@) {واجعل لي لسان صدق} ثناء حسنا {في الآخرين} في الأمم بعدي، فأعطاه الله ذلك، فجعل كل أهل الأديان يتولونه ويثنون عليه.(@)(@@) ...(@)(@@) {واجعلني من ورثة جنة النعيم (85)}.(@)(@)(@@)(@@)(@@) || AUTO [85](@)(@)(@@) {واجعلني} وارثا {من ورثة جنة النعيم} في الآخرة، وتقدم معنى الوراثة فيها (¬1) في أول سورة المؤمنون.(@)(@@) ...(@)(@@) {واغفر لأبي إنه كان من الضالين (86)}.(@)(@)(@@)(@@)(@@) || AUTO [86](@)(@)(@@) {واغفر لأبي إنه كان من الضالين} وقال هذا قبل أن يتبين له أنه PageV05P073 (@@) عدو لله؛ كما تقدم في سورة التوبة. قرأ نافع، وأبو جعفر، وأبو عمرو: (لأبي) بفتح الياء، والباقون: بإسكانها (¬1).(@)(@@) ...(@)(@@) {ولا تخزني يوم يبعثون (87)}.(@)(@)(@@)(@@)(@@) || AUTO [87](@)(@)(@@) {ولا تخزني يوم يبعثون} يعني: العباد.(@)(@@) ...(@)(@@) {يوم لا ينفع مال ولا بنون (88)}.(@)(@)(@@)(@@)(@@) || AUTO [88](@)(@)(@@) وتبدل منه {يوم لا ينفع مال ولا بنون} أي: لا ينفعان أحدا.(@)(@@) ...(@)(@@) {إلا من أتى الله بقلب سليم (89)}.(@)(@)(@@)(@@)(@@) || AUTO [89](@)(@)(@@) {إلا} استثناء منقطع؛ أي: لكن.(@)(@@) {من أتى الله بقلب سليم} من الشرك.(@)(@@) ...(@)(@@) {وأزلفت الجنة للمتقين (90)}.(@)(@)(@@)(@@)(@@) || AUTO [90](@)(@)(@@) {وأزلفت الجنة} قربت {للمتقين} فنظروا إليها.(@)(@@) ...(@)(@)PageV05P074(@)(@)(@@) {وبرزت الجحيم للغاوين (91)}.(@)(@)(@@)(@@)(@@) || AUTO [91](@)(@)(@@) {وبرزت الجحيم} أظهرت.(@)(@@) {للغاوين} الكافرين، فيرونها مكشوفة، ويتحسرون على أنهم المسوقون إليها.(@)(@@) ...(@)(@@) {وقيل لهم أين ما كنتم تعبدون (92)}.(@)(@)(@@)(@@)(@@) || AUTO [92](@)(@)(@@) {وقيل لهم} يوم القيامة: {أين ما كنتم تعبدون}.(@)(@@) ...(@)(@@) {من دون الله هل ينصرونكم أو ينتصرون (93)}.(@)(@)(@@)(@@)(@@) || AUTO [93](@)(@)(@@) {من دون الله} من الآلهة {هل ينصرونكم} بدفع العذاب عنكم.(@)(@@) {أو ينتصرون} بدفعه عن أنفسهم؟(@)(@@) ...(@)(@@) {فكبكبوا فيها هم والغاوون (94)}.(@)(@)(@@)(@@)(@@) || AUTO [94](@)(@)(@@) {فكبكبوا} 
ms1047	 ألقوا على رؤوسهم {فيها} في النار.(@)(@@) {هم} أي: الآلهة {والغاوون} الكفار.(@)(@@) ...(@)(@@) {وجنود إبليس أجمعون (95)}.(@)(@)(@@)(@@)(@@) || AUTO [95](@)(@)(@@) {وجنود إبليس} أتباعه {أجمعون} ومن أطاعه من الجن والإنس.(@)(@@) ***(@)(@)PageV05P075(@)(@)(@@) {قالوا وهم فيها يختصمون (96)}.(@)(@)(@@)(@@)(@@) || AUTO [96](@)(@)(@@) {قالوا} أي: الداخلون فيها.(@)(@@) {وهم فيها يختصمون} يخاصم بعض بعضا.(@)(@@) ...(@)(@@) {تالله إن كنا لفي ضلال مبين (97)}.(@)(@)(@@)(@@)(@@) || AUTO [97](@)(@)(@@) ويقول العابدون للمعبودين: {تالله إن كنا لفي ضلال مبين}.(@)(@@) ...(@)(@@) {إذ نسويكم برب العالمين (98)}.(@)(@)(@@)(@@)(@@) || AUTO [98](@)(@)(@@) {إذ نسويكم} نعدلكم في العبادة {برب العالمين} فنعبدكم.(@)(@@) ...(@)(@@) {وما أضلنا إلا المجرمون (99)}.(@)(@)(@@)(@@)(@@) || AUTO [99](@)(@)(@@) {وما أضلنا إلا المجرمون} أي: رؤساؤهم الذين اقتدوا بهم؛ كإبليس والشياطين وقابيل؛ لأنه أول من سن القتل، وعمل بالمعاصي.(@)(@@) ...(@)(@@) {فما لنا من شافعين (100)}.(@)(@)(@@)(@@)(@@) || AUTO [100](@)(@)(@@) فثم تشفع الملائكة والأنبياء والمؤمنون في أصدقائهم، فيقول المشركون تأسفا: {فما لنا من شافعين} أي: من يشفع لنا؟(@)(@@) ***(@)(@)PageV05P076(@)(@)(@@) {ولا صديق حميم (101)}.(@)(@)(@@)(@@)(@@) || AUTO [101](@)(@)(@@) {ولا صديق} هو من صدقك مودته {حميم} قريب خاص، وحامة الرجل: خاصته، قال - صلى الله عليه وسلم -: "إن الرجل ليقول في الجنة: ما فعل صديقي فلان؟ وصديقه في الجحيم، فيقول الله تعالى: أخرجوا له صديقه إلى الجنة" (¬1)، قال الحسن: استكثروا من الأصدقاء المؤمنين؛ فإن لهم شفاعة يوم القيامة (¬2).(@)(@@) ...(@)(@@) {فلو أن لنا كرة فنكون من المؤمنين (102)}.(@)(@)(@@)(@@)(@@) || AUTO [102](@)(@)(@@) فلما أيسوا من الشفاعة قالوا: {فلو أن لنا كرة} رجعة إلى الدنيا.(@)(@@) {فنكون من المؤمنين} أي: فنؤمن؛ ليشفع لنا، و (لو) هنا بمعنى ليت.(@)(@@) ...(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين (103)}.(@)(@)(@@)(@@)(@@) || AUTO [103](@)(@)(@@) {إن في ذلك} أي: فيما ذكر من قصة إبراهيم.(@)(@@) {لآية} عظة لمن يعتبر بها.(@)(@@) {وما كان أكثرهم} يعني: قومه {مؤمنين} به.(@)(@@) ...(@)(@)PageV05P077(@)(@)(@@) {وإن ربك لهو العزيز الرحيم (104)}.(@)(@)(@@)(@@)(@@) || AUTO [104](@)(@)(@@) {وإن ربك لهو العزيز} الذي لا يغلب {الرحيم} بالإمهال.(@)(@@) ...(@)(@@) {كذبت قوم نوح المرسلين (105)}.(@)(@)(@@)(@@)(@@) || AUTO [105](@)(@)(@@) {كذبت قوم نوح المرسلين} القوم مؤنثة من حيث ال (قوم): الأمة والجماعة، ولذلك تصغر على قويمة، وجمع (المرسلين)، وإن كانوا واحدا؛ لأن من كذب رسولا واحدا، فقد كذب جميع المرسلين.(@)(@@) ...(@)(@@) {إذ قال لهم أخوهم نوح ألا تتقون (106)}.(@)(@)(@@)(@@)(@@) || AUTO [106](@)(@)(@@) {إذ قال لهم أخوهم} في النسب، لا في الدين.(@)(@@) {نوح ألا تتقون} الله، 
ms1048	 فتتركوا عبادة غيره؟!(@)(@@) ...(@)(@@) {إني لكم رسول أمين (107)}.(@)(@)(@@)(@@)(@@) || AUTO [107](@)(@)(@@) {إني لكم رسول أمين} على الوحي.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (108)}.(@)(@)(@@)(@@)(@@) || AUTO [108](@)(@)(@@) {فاتقوا الله} بطاعته {وأطيعون} فيما آمركم به من الإيمان.(@)(@@) ***(@)(@)PageV05P078(@)(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين (109)}.(@)(@)(@@)(@@)(@@) || AUTO [109](@)(@)(@@) {وما أسألكم عليه} أي: على الدعاء والنصح.(@)(@@) {من أجر إن أجري} ثوابي {إلا على رب العالمين} قرأ يعقوب: (وأطيعوني) بإثبات الياء، والباقون: بحذفها (¬1)، وكذلك في الأحرف السبعة بعد، وقرأ ابن كثير، وحمزة، والكسائي، وخلف، وأبو بكر عن عاصم، ويعقوب: (أجري) بإسكان الياء، والباقون: بفتحها (¬2)، وكذلك في الأحرف الأربعة بعد.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (110)}.(@)(@)(@@)(@@)(@@) || AUTO [110](@)(@)(@@) {فاتقوا الله وأطيعون} كرره تأكيدا.(@)(@@) ...(@)(@@) {قالوا أنؤمن لك واتبعك الأرذلون (111)}.(@)(@)(@@)(@@)(@@) || AUTO [111](@)(@)(@@) {قالوا} إنكارا عليه: {أنؤمن لك واتبعك} أي: وقد اتبعك {الأرذلون} جمع الأرذل؛ يعني: السفلة، سموا بذلك؛ لاتضاع حرفهم؛ كالحجامة والحياكة، وهذا لا يضر بالديانات، فكأنهم قالوا: إنما آمنوا لحقارتهم. قرأ يعقوب: (وأتباعك) بقطع الهمزة وإسكان التاء مخففة وضم PageV05P079 (@@) العين وألف قبلها على الجمع، وقرأ الباقون: بوصل الهمزة وتشديد التاء مفتوحة وفتح العين من غير ألف (¬1).(@)(@@) ...(@)(@@) {قال وما علمي بما كانوا يعملون (112)}.(@)(@)(@@)(@@)(@@) || AUTO [112](@)(@)(@@) {قال} نوح: {وما علمي بما كانوا يعملون} المراد: انتفاء عليه بإخلاص أعمالهم، واطلاعه على سرائرهم.(@)(@@) ...(@)(@@) {إن حسابهم إلا على ربي لو تشعرون (113)}.(@)(@)(@@)(@@)(@@) || AUTO [113](@)(@)(@@) {إن حسابهم} ما جزاؤهم.(@)(@@) {إلا على ربي لو تشعرون} لما عبدتموهم.(@)(@@) ...(@)(@@) {وما أنا بطارد المؤمنين (114)}.(@)(@)(@@)(@@)(@@) || AUTO [114](@)(@)(@@) {وما أنا بطارد المؤمنين} جواب لما أوهم قولهم من استدعاء طردهم، وتوقيف إيمانهم عليه.(@)(@@) ...(@)(@@) {إن أنا إلا نذير مبين (115)}.(@)(@)(@@)(@@)(@@) || AUTO [115](@)(@)(@@) {إن أنا إلا نذير مبين} أي: وم