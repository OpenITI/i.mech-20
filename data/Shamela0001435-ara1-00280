ms261	 هذا الحديث، (@)(@@) @MATN@ «وسعد بن سعيد هو أخو يحيى بن سعيد الأنصاري وقد تكلم بعض أهل الحديث في سعد بن سعيد من قبل حفظه» . (@)(@@) حدثنا هناد قال: أخبرنا الحسين بن علي الجعفي، عن إسرائيل أبي موسى، عن الحسن البصري قال: كان إذا ذكر عنده صيام ستة أيام من شوال، فيقول: (@)(@@) @MATN@ «والله لقد رضي الله بصيام هذا الشهر عن السنة كلها» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في صوم ثلاثة أيام من كل شهر (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٠ - (@)(@@) حدثنا قتيبة قال: حدثنا أبو عوانة، عن سماك بن حرب، PageV03P124 عن أبي الربيع، عن أبي هريرة قال: (@)(@@) @MATN@ " عهد إلي النبي صلى الله عليه وسلم ثلاثة: أن لا أنام إلا على وتر، وصوم ثلاثة أيام من كل شهر، وأن أصلي الضحى " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٦١ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود، قال: أنبأنا شعبة، عن الأعمش، قال: سمعت يحيى بن سام، يحدث عن موسى بن طلحة، قال: سمعت أبا ذر يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يا أبا ذر، إذا صمت من الشهر ثلاثة أيام فصم ثلاث عشرة، وأربع عشرة، وخمس عشرة» (@)(@@) وفي الباب عن أبي قتادة، وعبد الله بن عمرو، وقرة بن إياس المزني، وعبد الله بن مسعود، وأبي عقرب، وابن عباس، وعائشة، وقتادة بن ملحان، وعثمان بن أبي العاص، وجرير.: (@)(@@) @MATN@ " حديث أبي ذر حديث حسن، وقد روي في بعض الحديث: أن من صام ثلاثة أيام من كل شهر كان كمن صام الدهر " (@)PageV03P125 (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٢ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن عاصم الأحول، عن أبي عثمان النهدي، عن أبي ذر قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " من صام من كل شهر ثلاثة أيام فذلك صيام الدهر، فأنزل الله عز وجل تصديق ذلك في كتابه: @QB@ {من جاء بالحسنة فله عشر أمثالها} @QE@ [الأنعام: ١٦٠] اليوم بعشرة أيام " : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد روى شعبة هذا الحديث، عن أبي شمر، وأبي التياح، عن أبي عثمان، عن أبي هريرة، عن النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٣ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو 
ms262	 داود قال: أخبرنا شعبة، عن يزيد الرشك، قال: سمعت معاذة قالت: قلت لعائشة: أكان رسول الله صلى الله عليه وسلم يصوم ثلاثة أيام من كل شهر؟ قالت: (@)(@@) @MATN@ «نعم» ، (@)(@@) قلت من أيه كان يصوم؟ قالت: (@)(@@) @MATN@ «كان لا يبالي من أيه صام» : (@)(@@) PageV03P126 (@)(@@) @MATN@ «هذا حديث حسن صحيح» . (@)(@@) @MATN@ «ويزيد الرشك هو يزيد الضبعي وهو يزيد بن القاسم وهو القسام، والرشك هو القسام بلغة أهل البصرة» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل الصوم (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٤ - (@)(@@) حدثنا عمران بن موسى القزاز قال: حدثنا عبد الوارث بن سعيد قال: حدثنا علي بن زيد، عن سعيد بن المسيب، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " إن ربكم يقول: كل حسنة بعشر أمثالها إلى سبع مائة ضعف، والصوم لي وأنا أجزي به، والصوم جنة من النار " (@)(@) (@)(@@) @MATN@ «ولخلوف فم الصائم أطيب عند الله من ريح المسك، وإن جهل على أحدكم جاهل وهو صائم فليقل إني صائم» (@)(@@) وفي الباب عن معاذ بن جبل، وسهل بن سعد، وكعب بن عجرة، وسلامة بن قيصر، وبشير ابن الخصاصية، (@)(@@) @MATN@ «واسم بشير زحم بن معبد، والخصاصية هي أمه» .: (@)(@@) PageV03P127 (@)(@@) @MATN@ «وحديث أبي هريرة حديث حسن غريب من هذا الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٥ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عامر العقدي، عن هشام بن سعد، عن أبي حازم، عن سهل بن سعد، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إن في الجنة لبابا يدعى الريان، يدعى له الصائمون، فمن كان من الصائمين دخله، ومن دخله لم يظمأ أبدا» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٦ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد العزيز بن محمد، عن سهيل PageV03P128 بن أبي صالح، عن أبيه، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " للصائم فرحتان: فرحة حين يفطر، وفرحة حين يلقى ربه " : (@)(@@) @MATN@ «وهذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في صوم الدهر (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٧ - (@)(@@) حدثنا قتيبة، وأحمد بن عبدة، قالا: حدثنا حماد بن زيد، عن غيلان بن جرير، عن عبد الله بن معبد، عن أبي قتادة قال: قيل يا رسول الله، كيف 
ms263	 بمن صام الدهر؟ قال: (@)(@@) @MATN@ «لا صام ولا أفطر، أو لم يصم ولم يفطر» (@)(@@) وفي الباب عن عبد الله بن عمرو، وعبد الله بن الشخير، وعمران بن حصين، وأبي موسى.: PageV03P129 (@)(@@) @MATN@ «حديث أبي قتادة حديث حسن» (@)(@@) وقد كره قوم من أهل العلم صيام الدهر، وقالوا: إنما يكون صيام الدهر إذا لم يفطر يوم الفطر، ويوم الأضحى، وأيام التشريق، فمن أفطر هذه الأيام فقد خرج من حد الكراهية، ولا يكون قد صام الدهر كله ". هكذا روي عن مالك بن أنس، وهو قول الشافعي وقال أحمد، وإسحاق نحوا من هذا، وقالا: (@)(@@) @MATN@ «لا يجب أن يفطر أياما غير هذه الخمسة الأيام التي نهى رسول الله صلى الله عليه وسلم عنها يوم الفطر، ويوم الأضحى، وأيام التشريق» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في سرد الصوم (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٨ - (@)(@@) حدثنا قتيبة قال: حدثنا حماد بن زيد، عن أيوب، عن عبد الله بن شقيق، قال: سألت عائشة عن صيام النبي صلى الله عليه وسلم؟ PageV03P130 قالت: (@)(@@) @MATN@ «كان يصوم حتى نقول قد صام، ويفطر حتى نقول قد أفطر» ، (@)(@@) قالت: (@)(@@) @MATN@ «وما صام رسول الله صلى الله عليه وسلم شهرا كاملا إلا رمضان» (@)(@@) وفي الباب عن أنس، وابن عباس.: (@)(@@) @MATN@ «حديث عائشة حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٦٩ - (@)(@@) حدثنا علي بن حجر قال: حدثنا إسماعيل بن جعفر، عن حميد، عن أنس بن مالك، أنه سئل عن صوم النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «كان يصوم من الشهر حتى نرى أنه لا يريد أن يفطر منه، ويفطر حتى نرى أنه لا يريد أن يصوم منه شيئا، وكنت لا تشاء أن تراه من الليل مصليا إلا رأيته مصليا، ولا نائما إلا رأيته نائما» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٠ - (@)(@@) حدثنا هناد قال: حدثنا وكيع، عن مسعر، وسفيان، عن PageV03P131 حبيب بن أبي ثابت، عن أبي العباس، عن عبد الله بن عمرو قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أفضل الصوم صوم أخي داود كان يصوم يوما، ويفطر يوما، ولا يفر إذا لاقى» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وأبو العباس هو الشاعر المكي واسمه: 
ms264	 السائب بن فروخ (@)(@@) @MATN@ " قال بعض أهل العلم: أفضل الصيام أن تصوم يوما وتفطر يوما، ويقال: هذا هو أشد الصيام " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الصوم يوم الفطر والنحر (@)(@) (@)(@@)(@@)(@@) ||| ٧٧١ - (@)(@@) حدثنا محمد بن عبد الملك بن أبي الشوارب قال: حدثنا يزيد بن زريع قال: حدثنا معمر، عن الزهري، عن أبي عبيد، مولى عبد الرحمن بن عوف قال: شهدت عمر بن الخطاب في يوم النحر بدأ بالصلاة PageV03P132 قبل الخطبة، ثم قال: (@)(@@) @MATN@ «سمعت رسول الله صلى الله عليه وسلم ينهى عن صوم هذين اليومين، أما يوم الفطر ففطركم من صومكم وعيد للمسلمين، وأما يوم الأضحى فكلوا من لحوم نسككم» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) وأبو عبيد مولى عبد الرحمن بن عوف: اسمه سعد ويقال له مولى عبد الرحمن بن أزهر أيضا، وعبد الرحمن بن أزهر هو ابن عم عبد الرحمن بن عوف " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٢ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد العزيز بن محمد، عن عمرو بن يحيى، عن أبيه، عن أبي سعيد الخدري قال: (@)(@@) @MATN@ " نهى رسول الله صلى الله عليه وسلم عن صيامين: يوم الأضحى، ويوم الفطر " وفي الباب عن عمر، وعلي، وعائشة، وأبي هريرة، وعقبة بن عامر، وأنس.: (@)(@@) @MATN@ «حديث أبي سعيد حديث حسن صحيح، والعمل عليه عند أهل العلم» . (@)(@@) @MATN@ «وعمرو بن يحيى هو ابن عمارة بن أبي الحسن PageV03P133 المازني المديني وهو ثقة روى له سفيان الثوري، وشعبة، ومالك بن أنس» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الصوم في أيام التشريق (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٣ - (@)(@@) حدثنا هناد قال: حدثنا وكيع، عن موسى بن علي، عن أبيه، عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يوم عرفة، ويوم النحر، وأيام التشريق، عيدنا أهل الإسلام، وهي أيام أكل وشرب» (@)(@@) وفي الباب عن علي، وسعد، وأبي هريرة، وجابر، ونبيشة، وبشر بن سحيم، وعبد الله بن حذافة، وأنس، وحمزة بن عمرو الأسلمي، وكعب بن مالك، وعائشة، وعمرو بن العاص، وعبد الله بن عمرو.: PageV03P134 (@)(@@) @MATN@ «وحديث عقبة بن عامر حديث حسن صحيح» (@)(@@) والعمل على هذا عند أهل العلم: يكرهون الصيام أيام التشريق، إلا 
ms265	 أن قوما من أصحاب النبي صلى الله عليه وسلم وغيرهم رخصوا للمتمتع إذا لم يجد هديا ولم يصم في العشر أن يصوم أيام التشريق وبه يقول مالك بن أنس، والشافعي، وأحمد، وإسحاق ".: (@)(@@) @MATN@ «وأهل العراق يقولون موسى بن علي، وأهل مصر يقولون موسى بن علي» ، (@)(@@) سمعت قتيبة يقول: سمعت الليث بن سعد يقول: قال موسى بن علي: (@)(@@) @MATN@ «لا أجعل أحدا في حل صغر اسم أبي» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب كراهية الحجامة للصائم (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٤ - (@)(@@) حدثنا محمد بن رافع النيسابوري، ومحمود بن غيلان، ويحيى بن موسى، قالوا: حدثنا عبد الرزاق، عن معمر، عن يحيى بن أبي كثير، عن إبراهيم بن عبد الله بن قارظ، عن السائب بن يزيد، عن رافع بن خديج، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «أفطر الحاجم والمحجوم» : (@)(@@) PageV03P135 وفي الباب عن علي، وسعد، وشداد بن أوس، وثوبان، وأسامة بن زيد، وعائشة، ومعقل بن سنان، ويقال: ابن يسار، وأبي هريرة، وابن عباس، وأبي موسى، وبلال.: (@)(@@) @MATN@ «وحديث رافع بن خديج حديث حسن صحيح» (@)(@@) وذكر عن أحمد بن حنبل أنه قال: (@)(@@) @MATN@ «أصح شيء في هذا الباب حديث رافع بن خديج» ، (@)(@@) وذكر عن علي بن عبد الله أنه قال: (@)(@@) @MATN@ «أصح شيء في هذا الباب حديث ثوبان، وشداد بن أوس لأن يحيى بن أبي كثير روى عن أبي قلابة الحديثين جميعا، حديث ثوبان، وحديث شداد بن أوس» (@)(@@) وقد كره قوم من أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: الحجامة للصائم حتى أن بعض أصحاب النبي صلى الله عليه وسلم احتجم بالليل، منهم: أبو موسى الأشعري، وابن عمر، وبهذا يقول ابن المبارك (@)(@@) @MATN@ ".: سمعت إسحاق بن منصور يقول: قال عبد الرحمن بن مهدي: (@)(@@) @MATN@ «من احتجم وهو صائم فعليه القضاء» . (@)(@@) قال إسحاق بن منصور: وهكذا قال أحمد، وإسحاق، (@)(@@) @MATN@ «حدثنا الزعفراني» . (@)(@@) قال: وقال الشافعي: قد روي عن النبي صلى الله عليه وسلم (@)(@@) @MATN@ «أنه احتجم وهو صائم» ، (@)(@@) وروي عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «أفطر الحاجم والمحجوم» (@)(@@) ولا أعلم واحدا من هذين الحديثين ثابتا، ولو توقى رجل 
ms266	 PageV03P136 الحجامة وهو صائم كان أحب إلي، ولو احتجم صائم لم أر ذلك أن يفطره " .: (@)(@@) @MATN@ «هكذا كان قول الشافعي ببغداد، وأما بمصر فمال إلى الرخصة ولم ير بالحجامة للصائم بأسا، واحتج بأن النبي صلى الله عليه وسلم احتجم في حجة الوداع وهو محرم صائم» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء من الرخصة في ذلك (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٥ - (@)(@@) حدثنا بشر بن هلال البصري قال: حدثنا عبد الوارث بن سعيد قال: حدثنا أيوب، عن عكرمة، عن ابن عباس قال: (@)(@@) @MATN@ «احتجم رسول الله صلى الله عليه وسلم وهو محرم صائم» : (@)(@@) PageV03P137 (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وهكذا روى وهيب نحو رواية عبد الوارث، وروى إسماعيل بن إبراهيم، عن أيوب، عن عكرمة مرسلا، ولم يذكر فيه عن ابن عباس (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٦ - (@)(@@) حدثنا أبو موسى محمد بن المثنى قال: حدثنا محمد بن عبد الله الأنصاري، عن حبيب بن الشهيد، عن ميمون بن مهران، عن ابن عباس، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم احتجم وهو صائم» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٧ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا عبد الله بن إدريس، عن يزيد بن أبي زياد، عن مقسم، عن ابن عباس، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم احتجم فيما بين مكة والمدينة وهو محرم صائم» : (@)(@@) وفي الباب عن أبي سعيد، وجابر، وأنس.: (@)(@@) @MATN@ «حديث ابن عباس حديث حسن صحيح» (@)(@@) وقد ذهب بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم إلى هذا الحديث ولم يروا بالحجامة للصائم بأسا، وهو قول سفيان الثوري، ومالك بن أنس، والشافعي " (@)PageV03P138 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الوصال للصائم (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٨ - (@)(@@) حدثنا نصر بن علي قال: حدثنا بشر بن المفضل، وخالد بن الحارث، عن سعيد، عن قتادة، عن أنس قال: قال رسول الله صلى الله عليه وسلم (@)(@@) @MATN@ «لا تواصلوا» ، (@)(@@) قالوا: فإنك تواصل يا رسول الله، قال: (@)(@@) @MATN@ «إني لست كأحدكم، إن ربي يطعمني ويسقيني» (@)(@@) وفي الباب عن علي، وأبي هريرة، وعائشة، وابن عمر، وجابر، وأبي سعيد، وبشير ابن الخصاصية.: (@)(@@) @MATN@ «حديث أنس حديث حسن صحيح» (@)(@@) والعمل على هذا عند أهل 
ms267	 العلم: كرهوا الوصال في الصيام "، وروي عن عبد الله بن الزبير: (@)(@@) @MATN@ «أنه كان يواصل الأيام ولا يفطر» (@)(@@) (@)PageV03P139 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الجنب يدركه الفجر وهو يريد الصوم (@)(@) (@)(@@)(@@)(@@) ||| ٧٧٩ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن شهاب، عن أبي بكر بن عبد الرحمن بن الحارث بن هشام قال: أخبرتني عائشة، وأم سلمة، زوجا النبي صلى الله عليه وسلم (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم كان يدركه الفجر وهو جنب من أهله، ثم يغتسل فيصوم» : (@)(@@) @MATN@ «حديث عائشة وأم سلمة حديث حسن صحيح» ، (@)(@@) @MATN@ «والعمل على هذا عند أكثر أهل العلم من أصحاب النبي صلى الله عليه وسلم، وغيرهم، وهو قول سفيان، والشافعي، وأحمد، وإسحاق» ، (@)(@@) @MATN@ " وقد قال قوم من التابعين: إذا أصبح جنبا يقضي ذلك اليوم، والقول الأول أصح " (@)PageV03P140 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في إجابة الصائم الدعوة (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٠ - (@)(@@) حدثنا أزهر بن مروان البصري قال: حدثنا محمد بن سواء قال: حدثنا سعيد بن أبي عروبة، عن أيوب، عن محمد بن سيرين، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إذا دعي أحدكم إلى طعام فليجب، فإن كان صائما، فليصل» ، (@)(@@) يعني: الدعاء (@)(@) (@)(@@)(@@)(@@) ||| ٧٨١ - (@)(@@) حدثنا نصر بن علي قال: حدثنا سفيان بن عيينة، عن أبي الزناد، عن الأعرج، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " إذا دعي أحدكم وهو صائم فليقل: إني صائم " : (@)(@@) @MATN@ «وكلا الحديثين في هذا الباب عن أبي هريرة حسن صحيح» (@)(@@) (@)PageV03P141 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية صوم المرأة إلا بإذن زوجها (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٢ - (@)(@@) حدثنا قتيبة، ونصر بن علي، قالا: حدثنا سفيان بن عيينة، عن أبي الزناد، عن الأعرج، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا تصوم المرأة وزوجها شاهد يوما من غير شهر رمضان، إلا بإذنه» (@)(@@) وفي الباب عن ابن عباس، وأبي سعيد.: (@)(@@) @MATN@ «حديث أبي هريرة حديث حسن» ، (@)(@@) وقد روي هذا الحديث عن أبي الزناد، عن موسى بن أبي عثمان، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم (@)PageV03P142 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تأخير قضاء رمضان 
ms268	 (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٣ - (@)(@@) حدثنا قتيبة قال: حدثنا أبو عوانة، عن إسماعيل السدي، عن عبد الله البهي، عن عائشة قالت: (@)(@@) @MATN@ «ما كنت أقضي ما يكون علي من رمضان إلا في شعبان، حتى توفي رسول الله صلى الله عليه وسلم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» . (@)(@@) وقد روى يحيى بن سعيد الأنصاري، عن أبي سلمة، عن عائشة نحو هذا (@)PageV03P143 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل الصائم إذا أكل عنده (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٤ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا شريك، عن حبيب بن زيد، عن ليلى، عن مولاتها، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الصائم إذا أكل عنده المفاطير صلت عليه الملائكة» : (@)(@@) وروى شعبة هذا الحديث، عن حبيب بن زيد، عن ليلى، عن جدته أم عمارة، عن النبي صلى الله عليه وسلم نحوه (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: أخبرنا شعبة، عن حبيب بن زيد، قال: سمعت مولاة لنا يقال لها: ليلى تحدث، عن جدته أم عمارة بنت كعب الأنصارية، أن النبي صلى الله عليه وسلم دخل عليها فقدمت إليه طعاما، فقال: (@)(@@) @MATN@ «كلي» ، (@)(@@) فقالت: إني صائمة، PageV03P144 فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الصائم تصلي عليه الملائكة إذا أكل عنده حتى يفرغوا» ، (@)(@@) وربما قال: (@)(@@) @MATN@ «حتى يشبعوا» .: (@)(@@) @MATN@ «هذا حديث حسن صحيح، وهو أصح من حديث شريك» . (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٦ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن حبيب بن زيد، عن مولاة لهم يقال لها: ليلى، عن أم عمارة بنت كعب، عن النبي صلى الله عليه وسلم نحوه، ولم يذكر فيه: (@)(@@) @MATN@ «حتى يفرغوا أو يشبعوا» .: (@)(@@) @MATN@ «وأم عمارة هي جدة حبيب بن زيد الأنصاري» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في قضاء الحائض الصيام دون الصلاة (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٧ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا علي بن مسهر، عن عبيدة، عن إبراهيم، عن الأسود، عن عائشة قالت: كنا نحيض على عهد رسول الله PageV03P145 صلى الله عليه وسلم، ثم نطهر، (@)(@@) @MATN@ «فيأمرنا بقضاء الصيام، ولا يأمرنا بقضاء الصلاة» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد روي عن معاذة، عن عائشة أيضا (@)(@@) @MATN@ «والعمل على 
ms269	 هذا عند أهل العلم لا نعلم بينهم اختلافا، أن الحائض تقضي الصيام ولا تقضي الصلاة» : (@)(@@) @MATN@ «وعبيدة هو ابن معتب الضبي الكوفي يكنى أبا عبد الكريم» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية مبالغة الاستنشاق للصائم (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٨ - (@)(@@) حدثنا عبد الوهاب بن عبد الحكم الوراق، وأبو عمار الحسين بن حريث قالا: حدثنا يحيى بن سليم قال: حدثني إسماعيل بن كثير، قال: سمعت عاصم بن لقيط بن صبرة، عن أبيه، قال: قلت يا رسول الله، أخبرني عن الوضوء؟ قال: (@)(@@) @MATN@ «أسبغ الوضوء، وخلل بين الأصابع، وبالغ في الاستنشاق، إلا أن تكون صائما» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) PageV03P146 وقد كره أهل العلم السعوط للصائم، ورأوا أن ذلك يفطره، وفي الحديث ما يقوي قولهم " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن نزل بقوم فلا يصوم إلا بإذنهم (@)(@) (@)(@@)(@@)(@@) ||| ٧٨٩ - (@)(@@) حدثنا بشر بن معاذ العقدي البصري قال: حدثنا أيوب بن واقد الكوفي، عن هشام بن عروة، عن أبيه، عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من نزل على قوم فلا يصومن تطوعا إلا بإذنهم» : (@)(@@) @MATN@ «هذا حديث منكر لا نعرف أحدا من الثقات روى هذا الحديث عن هشام بن عروة» ، (@)(@@) وقد روى موسى بن داود، عن أبي بكر المدني، عن هشام بن عروة، عن أبيه، عن عائشة، عن النبي صلى الله عليه وسلم نحوا من هذا.: (@)(@@) @MATN@ «وهذا حديث ضعيف أيضا، وأبو بكر ضعيف عند أهل الحديث» (@)(@@) وأبو بكر المديني الذي روى عن جابر بن عبد الله: اسمه الفضل بن مبشر وهو أوثق من هذا وأقدم " (@)PageV03P147 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاعتكاف (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٠ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن الزهري، عن سعيد بن المسيب، عن أبي هريرة، وعروة، عن عائشة، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم كان يعتكف العشر الأواخر من رمضان حتى قبضه الله» . (@)(@@) وفي الباب عن أبي بن كعب، وأبي ليلى، وأبي سعيد، وأنس، وابن عمر.: (@)(@@) @MATN@ «حديث أبي هريرة، وعائشة حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٩١ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن يحيى بن سعيد، عن عمرة، 
ms270	 عن عائشة قالت: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم إذا أراد أن يعتكف صلى الفجر، ثم دخل في معتكفه» : (@)(@@) PageV03P148 وقد روي هذا الحديث، عن يحيى بن سعيد، عن عمرة، عن النبي صلى الله عليه وسلم مرسلا. رواه مالك، وغير واحد، عن يحيى بن سعيد، عن عمرة مرسلا، ورواه الأوزاعي، وسفيان الثوري، وغير واحد، عن يحيى بن سعيد، عن عمرة، عن عائشة، (@)(@@) @MATN@ " والعمل على هذا الحديث عند بعض أهل العلم يقولون: إذا أراد الرجل أن يعتكف صلى الفجر، ثم دخل في معتكفه وهو قول أحمد، وإسحاق بن إبراهيم (@)(@@) @MATN@ «،» (@)(@@) وقال بعضهم: إذا أراد أن يعتكف فلتغب له الشمس من الليلة التي يريد أن يعتكف فيها من الغد وقد قعد في معتكفه، وهو قول سفيان الثوري، ومالك بن أنس " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ليلة القدر (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٢ - (@)(@@) حدثنا هارون بن إسحاق الهمداني قال: حدثنا عبدة بن سليمان، عن هشام بن عروة، عن أبيه، عن عائشة قالت: كان رسول الله صلى الله عليه وسلم يجاور في العشر الأواخر من رمضان، ويقول: (@)(@@) @MATN@ «تحروا ليلة القدر في العشر الأواخر من رمضان» (@)(@@) PageV03P149 وفي الباب عن عمر، وأبي، وجابر بن سمرة، وجابر بن عبد الله، وابن عمر، والفلتان بن عاصم، وأنس، وأبي سعيد، وعبد الله بن أنيس، وأبي بكرة، وابن عباس، وبلال، وعبادة بن الصامت.: حديث عائشة حديث حسن صحيح، وقولها: (@)(@@) @MATN@ «يجاور» (@)(@@) يعني: يعتكف وأكثر الروايات عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «التمسوها في العشر الأواخر في كل وتر» ، (@)(@@) @MATN@ «وروي عن النبي صلى الله عليه وسلم في ليلة القدر أنها ليلة إحدى وعشرين، وليلة ثلاث وعشرين، وخمس وعشرين، وسبع وعشرين، وتسع وعشرين، وآخر ليلة من رمضان» .: (@)(@@) قال الشافعي: (@)(@@) @MATN@ " كأن هذا عندي والله أعلم أن النبي صلى الله عليه وسلم كان يجيب على نحو ما يسأل عنه، يقال له نلتمسها في ليلة كذا؟ فيقول: (@)(@@) @MATN@ «التمسوها في ليلة كذا» . (@)(@@) قال الشافعي: (@)(@@) @MATN@ «وأقوى الروايات عندي فيها ليلة إحدى وعشرين» .: (@)(@@) وقد روي عن أبي بن كعب أنه: " كان يحلف أنها 
ms271	 ليلة سبع وعشرين، ويقول: أخبرنا رسول الله صلى الله عليه وسلم بعلامتها فعددنا وحفظنا "، وروي عن أبي قلابة أنه قال: (@)(@@) @MATN@ «ليلة القدر تنتقل في العشر الأواخر،» (@)(@@) حدثنا بذلك عبد بن حميد قال: أخبرنا عبد الرزاق، عن معمر، عن أيوب، عن أبي قلابة بهذا (@)PageV03P150 (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٣ - (@)(@@) حدثنا واصل بن عبد الأعلى الكوفي قال: حدثنا أبو بكر، عن عاصم، عن زر قال: قلت لأبي بن كعب: أنى علمت أبا المنذر أنها ليلة سبع وعشرين، قال: بلى أخبرنا رسول الله صلى الله عليه وسلم أنها (@)(@@) @MATN@ «ليلة صبيحتها تطلع الشمس ليس لها شعاع» ، (@)(@@) فعددنا، وحفظنا والله لقد علم ابن مسعود أنها في رمضان، وأنها ليلة سبع وعشرين، ولكن كره أن يخبركم فتتكلوا: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٤ - (@)(@@) حدثنا حميد بن مسعدة قال: حدثنا يزيد بن زريع قال: حدثنا عيينة بن عبد الرحمن، قال: حدثني أبي قال: ذكرت ليلة القدر عند أبي بكرة فقال: ما أنا ملتمسها لشيء سمعته من رسول الله صلى الله عليه وسلم إلا في العشر الأواخر، فإني سمعته يقول: (@)(@@) @MATN@ «التمسوها في تسع يبقين، أو في سبع يبقين، أو في خمس يبقين، أو في ثلاث أواخر ليلة» ، (@)(@@) PageV03P151 وكان أبو بكرة يصلي في العشرين من رمضان كصلاته في سائر السنة، فإذا دخل العشر اجتهد: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع قال: حدثنا سفيان، عن أبي إسحاق، عن هبيرة بن يريم، عن علي، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم كان يوقظ أهله في العشر الأواخر من رمضان» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٦ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد الواحد بن زياد، عن الحسن بن عبيد الله، عن إبراهيم، عن الأسود، عن عائشة قالت: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم يجتهد في العشر الأواخر ما لا يجتهد في غيرها» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)PageV03P152 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الصوم في الشتاء (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٧ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا سفيان، عن أبي إسحاق، عن 
ms272	 نمير بن عريب، عن عامر بن مسعود، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الغنيمة الباردة الصوم في الشتاء» : (@)(@@) @MATN@ «هذا حديث مرسل عامر بن مسعود لم يدرك النبي صلى الله عليه وسلم، وهو والد إبراهيم بن عامر القرشي الذي روى عنه شعبة، والثوري» (@)(@@) (@)(@) (@)(@@) باب ما جاء: @QB@ {وعلى الذين يطيقونه} @QE@ [البقرة: ١٨٤] (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٨ - (@)(@@) حدثنا قتيبة قال: حدثنا بكر بن مضر، عن عمرو بن الحارث، عن بكير بن عبد الله بن الأشج، عن يزيد، مولى سلمة بن الأكوع، عن سلمة بن الأكوع قال: (@)(@@) @MATN@ " لما نزلت: @QB@ {وعلى الذين يطيقونه فدية طعام مسكين} @QE@ [البقرة: ١٨٤] كان من PageV03P153 أراد منا أن يفطر ويفتدي، حتى نزلت الآية التي بعدها فنسختها " : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب، ويزيد هو ابن أبي عبيد مولى سلمة بن الأكوع» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب من أكل ثم خرج يريد سفرا (@)(@) (@)(@@)(@@)(@@) ||| ٧٩٩ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد الله بن جعفر، عن زيد بن أسلم، عن محمد بن المنكدر، عن محمد بن كعب، أنه قال: أتيت أنس بن مالك في رمضان وهو يريد سفرا، وقد رحلت له راحلته، ولبس ثياب السفر، فدعا بطعام فأكل، فقلت له: سنة؟ قال: (@)(@@) @MATN@ «سنة» (@)(@@) ثم ركب (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٠ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا سعيد بن أبي مريم قال: حدثنا محمد بن جعفر قال: حدثني زيد بن أسلم قال: حدثني محمد بن المنكدر، عن محمد بن كعب، قال: أتيت أنس بن مالك في رمضان، فذكر نحوه.: PageV03P154 (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) ومحمد بن جعفر هو ابن أبي كثير هو مديني ثقة، وهو أخو إسماعيل بن جعفر، وعبد الله بن جعفر هو ابن نجيح والد علي بن عبد الله المديني، وكان يحيى بن معين يضعفه (@)(@@) @MATN@ " وقد ذهب بعض أهل العلم إلى هذا الحديث، وقالوا: للمسافر أن يفطر في بيته قبل أن يخرج وليس له أن يقصر الصلاة حتى يخرج من جدار المدينة أو القرية، وهو قول إسحاق بن إبراهيم الحنظلي " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تحفة الصائم (@)(@) (@)(@@)(@@)(@@) ||| ٨٠١ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا أبو معاوية، عن سعد بن 
ms273	 طريف، عن عمير بن مأمون، عن الحسن بن علي قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «تحفة الصائم الدهن والمجمر» : (@)(@@) @MATN@ «هذا حديث غريب ليس إسناده بذاك لا نعرفه إلا من حديث سعد بن طريف» ، (@)(@@) @MATN@ «وسعد بن طريف يضعف، ويقال عمير بن مأموم أيضا» (@)(@@) (@)PageV03P155 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الفطر والأضحى متى يكون؟ (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٢ - (@)(@@) حدثنا يحيى بن موسى قال: حدثنا يحيى بن اليمان، عن معمر، عن محمد بن المنكدر، عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الفطر يوم يفطر الناس، والأضحى يوم يضحي الناس» : (@)(@@) سألت محمدا: قلت له: محمد بن المنكدر سمع من عائشة؟ قال: (@)(@@) @MATN@ «نعم، يقول في حديثه، سمعت عائشة» .: (@)(@@) @MATN@ «هذا حديث حسن غريب صحيح من هذا الوجه» (@)(@@) (@)PageV03P156 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاعتكاف إذا خرج منه (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٣ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا ابن أبي عدي، قال: أنبأنا حميد الطويل، عن أنس بن مالك قال: (@)(@@) @MATN@ «كان النبي صلى الله عليه وسلم يعتكف في العشر الأواخر من رمضان، فلم يعتكف عاما، فلما كان في العام المقبل اعتكف عشرين» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب من حديث أنس بن مالك» (@)(@@) واختلف أهل العلم في المعتكف إذا قطع اعتكافه قبل أن يتمه على ما نوى (@)(@@) @MATN@ «،» (@)(@@) فقال بعض أهل العلم: إذا نقض اعتكافه وجب عليه القضاء، واحتجوا بالحديث أن النبي صلى الله عليه وسلم (@)(@@) @MATN@ «خرج من اعتكافه، فاعتكف عشرا من شوال، وهو قول مالك» ، (@)(@@) @MATN@ " وقال بعضهم: إن لم يكن عليه نذر اعتكاف أو شيء أوجبه على نفسه، وكان متطوعا، فخرج، فليس عليه أن يقضي إلا أن يحب ذلك اختيارا منه، ولا يجب ذلك عليه، وهو قول الشافعي " قال الشافعي: (@)(@@) @MATN@ «فكل عمل لك أن لا تدخل فيه، فإذا دخلت فيه، فخرجت منه، فليس عليك أن تقضي إلا الحج والعمرة» (@)(@@) وفي الباب عن أبي هريرة (@)PageV03P157 (@)(@) (@)(@@)(@@)(@@) || باب المعتكف يخرج لحاجته أم لا (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٤ - (@)(@@) حدثنا أبو مصعب المدني، قراءة عن مالك بن أنس، عن ابن شهاب، عن عروة، وعمرة، عن عائشة، أنها قالت: (@)(@@) @MATN@ «كان رسول الله 
ms274	 صلى الله عليه وسلم إذا اعتكف أدنى إلي رأسه فأرجله، وكان لا يدخل البيت إلا لحاجة الإنسان» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) هكذا رواه غير واحد، عن مالك، عن ابن شهاب، عن عروة، وعمرة، عن عائشة، ورواه بعضهم، عن مالك، عن ابن شهاب، عن عروة، عن عمرة، عن عائشة، والصحيح عن عروة، وعمرة، عن عائشة. (@)PageV03P158 (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٥ - (@)(@@) حدثنا بذلك قتيبة قال: حدثنا الليث بن سعد، عن ابن شهاب، عن عروة، وعمرة، عن عائشة، (@)(@@) @MATN@ " والعمل على هذا عند أهل العلم إذا اعتكف الرجل أن لا يخرج من اعتكافه إلا لحاجة الإنسان، واجتمعوا على هذا، أنه يخرج لقضاء حاجته للغائط والبول، ثم اختلف أهل العلم في عيادة المريض، وشهود الجمعة، والجنازة للمعتكف، فرأى بعض أهل العلم من أصحاب النبي صلى الله عليه وسلم وغيرهم: أن يعود المريض، ويشيع الجنازة، ويشهد الجمعة، إذا اشترط ذلك، وهو قول سفيان الثوري، وابن المبارك (@)(@@) @MATN@ «،» (@)(@@) وقال بعضهم: ليس له أن يفعل شيئا من هذا، ورأوا للمعتكف إذا كان في مصر يجمع فيه أن لا يعتكف إلا في مسجد الجامع، لأنهم كرهوا الخروج له من معتكفه إلى الجمعة، ولم يروا له أن يترك الجمعة، فقالوا: لا يعتكف إلا في مسجد الجامع، حتى لا يحتاج أن يخرج من معتكفه لغير قضاء حاجة الإنسان، لأن خروجه لغير حاجة الإنسان قطع عندهم للاعتكاف، هو قول مالك، والشافعي " وقال أحمد: (@)(@@) @MATN@ «لا يعود المريض، ولا يتبع الجنازة على حديث عائشة» (@)(@@) وقال إسحاق: (@)(@@) @MATN@ «إن اشترط ذلك فله أن يتبع الجنازة ويعود المريض» (@)(@@) (@)PageV03P159 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في قيام شهر رمضان (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٦ - (@)(@@) حدثنا هناد قال: حدثنا محمد بن الفضيل، عن داود بن أبي هند، عن الوليد بن عبد الرحمن الجرشي، عن جبير بن نفير، عن أبي ذر قال: صمنا مع رسول الله صلى الله عليه وسلم فلم يصل بنا، حتى بقي سبع من الشهر، فقام بنا حتى ذهب ثلث الليل، ثم لم يقم بنا في السادسة، وقام بنا في الخامسة، حتى ذهب شطر الليل، فقلنا له: يا رسول 
ms275	 الله، لو نفلتنا بقية ليلتنا هذه؟ فقال: (@)(@@) @MATN@ «إنه من قام مع الإمام حتى ينصرف كتب له قيام ليلة» ، (@)(@@) ثم لم يصل بنا حتى بقي ثلاث من الشهر، وصلى بنا في الثالثة، ودعا أهله ونساءه، فقام بنا حتى تخوفنا الفلاح، قلت له: وما الفلاح، قال: (@)(@@) @MATN@ «السحور» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) PageV03P160 واختلف أهل العلم في قيام رمضان، فرأى بعضهم: أن يصلي إحدى وأربعين ركعة مع الوتر، وهو قول أهل المدينة، والعمل على هذا عندهم بالمدينة، وأكثر أهل العلم على ما روي عن عمر، وعلي، وغيرهما من أصحاب النبي صلى الله عليه وسلم عشرين ركعة، وهو قول الثوري، وابن المبارك، والشافعي (@)(@@) @MATN@ " وقال الشافعي: (@)(@@) @MATN@ «وهكذا أدركت ببلدنا بمكة يصلون عشرين ركعة» (@)(@@) وقال أحمد: (@)(@@) @MATN@ «روي في هذا ألوان ولم يقض فيه بشيء» (@)(@@) وقال إسحاق: (@)(@@) @MATN@ «بل نختار إحدى وأربعين ركعة على ما روي عن أبي بن كعب» (@)(@@) واختار ابن المبارك، وأحمد، وإسحاق: الصلاة مع الإمام في شهر رمضان " واختار الشافعي: أن يصلي الرجل وحده إذا كان قارئا " وفي الباب عن عائشة، والنعمان بن بشير، وابن عباس (@)PageV03P161 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل من فطر صائما (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٧ - (@)(@@) حدثنا هناد قال: حدثنا عبد الرحيم بن سليمان، عن عبد الملك بن أبي سليمان، عن عطاء، عن زيد بن خالد الجهني قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من فطر صائما كان له مثل أجره، غير أنه لا ينقص من أجر الصائم شيئا» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب الترغيب في قيام رمضان، وما جاء فيه من الفضل (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٨ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن الزهري، عن أبي سلمة، عن أبي هريرة قال: كان رسول الله صلى الله عليه وسلم PageV03P162 يرغب في قيام رمضان، من غير أن يأمرهم بعزيمة، ويقول: (@)(@@) @MATN@ «من قام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه» ، (@)(@@) فتوفي رسول الله صلى الله عليه وسلم والأمر على ذلك، ثم كان الأمر كذلك في خلافة أبي بكر، وصدرا من خلافة عمر على ذلك. 
ms276	 وفي الباب عن عائشة، وقد روي هذا الحديث أيضا عن الزهري، عن عروة، عن عائشة. (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV03P163 (@)(@) (@)(@@)(@@)(@@) | ٧ - أبواب الحج عن رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في حرمة مكة (@)(@) (@)(@@)(@@)(@@) ||| ٨٠٩ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث بن سعد، عن سعيد بن أبي سعيد المقبري، عن أبي شريح العدوي، أنه قال لعمرو بن سعيد وهو يبعث البعوث إلى مكة: ائذن لي أيها الأمير، أحدثك قولا قام به رسول الله صلى الله عليه وسلم الغد من يوم الفتح سمعته أذناي، ووعاه قلبي، وأبصرته عيناي، حين تكلم به أنه: حمد الله، وأثنى عليه، ثم قال: (@)(@@) @MATN@ " إن مكة حرمها الله، ولم يحرمها الناس، ولا يحل لامرئ يؤمن بالله واليوم الآخر أن يسفك فيها دما، أو يعضد بها شجرة،، فإن أحد PageV03P164 ترخص بقتال رسول الله صلى الله عليه وسلم فيها فقولوا له: إن الله أذن لرسوله صلى الله عليه وسلم ولم يأذن لك، وإنما أذن لي فيه ساعة من النهار، وقد عادت حرمتها اليوم كحرمتها بالأمس، وليبلغ الشاهد الغائب " ، فقيل لأبي شريح: ما قال لك عمرو؟ قال: أنا أعلم منك بذلك يا أبا شريح، إن الحرم لا يعيذ عاصيا، ولا فارا بدم، ولا فارا بخربة.: ويروى ولا فارا بخزية، وفي الباب عن أبي هريرة، وابن عباس.: (@)(@@) @MATN@ «حديث أبي شريح حديث حسن صحيح» (@)(@@) وأبو شريح الخزاعي: اسمه خويلد بن عمرو، وهو العدوي، وهو الكعبي " ومعنى قوله: (@)(@@) @MATN@ «ولا فارا بخربة» ، (@)(@@) يعني: الجناية، يقول: من جنى جناية، أو أصاب دما، ثم لجأ إلى الحرم فإنه يقام عليه الحد (@)PageV03P165 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ثواب الحج والعمرة (@)(@) (@)(@@)(@@)(@@) ||| ٨١٠ - (@)(@@) حدثنا قتيبة، وأبو سعيد الأشج قالا: حدثنا أبو خالد الأحمر، عن عمرو بن قيس، عن عاصم، عن شقيق، عن عبد الله بن مسعود قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «تابعوا بين الحج والعمرة، فإنهما ينفيان الفقر والذنوب كما ينفي الكير خبث الحديد، والذهب، والفضة، وليس للحجة المبرورة ثواب إلا الجنة» (@)(@@) وفي الباب عن عمر، وعامر 
ms277	 بن ربيعة، وأبي هريرة، وعبد الله بن حبشي، وأم سلمة، وجابر.: (@)(@@) @MATN@ «حديث ابن مسعود حديث حسن صحيح غريب من حديث ابن مسعود» (@)(@@) (@)PageV03P166 (@)(@) (@)(@@)(@@)(@@) ||| ٨١١ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن منصور، عن أبي حازم، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من حج فلم يرفث، ولم يفسق، غفر له ما تقدم من ذنبه» : (@)(@@) @MATN@ «حديث أبي هريرة حديث حسن صحيح» (@)(@@) وأبو حازم كوفي وهو الأشجعي،: واسمه سلمان مولى عزة الأشجعية " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في التغليظ في ترك الحج (@)(@) (@)(@@)(@@)(@@) ||| ٨١٢ - (@)(@@) حدثنا محمد بن يحيى القطعي البصري قال: حدثنا مسلم بن إبراهيم قال: حدثنا هلال بن عبد الله، مولى ربيعة بن عمرو بن مسلم الباهلي قال: حدثنا أبو إسحاق الهمداني، عن الحارث، عن علي قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " من ملك زادا وراحلة تبلغه إلى بيت الله ولم يحج فلا عليه أن يموت يهوديا، أو نصرانيا، وذلك أن الله يقول في كتابه: @QB@ {ولله على الناس حج البيت من استطاع إليه سبيلا} @QE@ [آل عمران: ٩٧] " : PageV03P167 (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من هذا الوجه، وفي إسناده مقال، وهلال بن عبد الله مجهول، والحارث يضعف في الحديث» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في إيجاب الحج بالزاد والراحلة (@)(@) (@)(@@)(@@)(@@) ||| ٨١٣ - (@)(@@) حدثنا يوسف بن عيسى قال: حدثنا وكيع قال: حدثنا إبراهيم بن يزيد، عن محمد بن عباد بن جعفر، عن ابن عمر قال: جاء رجل إلى النبي صلى الله عليه وسلم فقال: يا رسول الله، ما يوجب الحج؟ قال: (@)(@@) @MATN@ «الزاد والراحلة» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) والعمل عليه عند أهل العلم: أن الرجل إذا ملك زادا وراحلة وجب عليه الحج (@)(@@) @MATN@ «وإبراهيم هو ابن يزيد الخوزي المكي وقد تكلم فيه بعض أهل العلم من قبل حفظه» (@)(@@) (@)PageV03P168 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء كم فرض الحج (@)(@) (@)(@@)(@@)(@@) ||| ٨١٤ - (@)(@@) حدثنا أبو سعيد الأشج قال: حدثنا منصور بن وردان، عن علي بن عبد الأعلى، عن أبيه، عن أبي البختري، عن علي بن أبي طالب قال: لما نزلت: @QB@ {ولله على الناس حج 
ms278	 البيت من استطاع إليه سبيلا} @QE@ [آل عمران: ٩٧] ، قالوا: يا رسول الله، أفي كل عام؟ (@)(@@) @MATN@ «فسكت» ، (@)(@@) فقالوا: يا رسول الله، أفي كل عام؟ قال: (@)(@@) @MATN@ " لا، ولو قلت: نعم , لوجبت " ، فأنزل الله: @QB@ {يا أيها الذين آمنوا لا تسألوا عن أشياء إن تبد لكم تسؤكم} @QE@ [المائدة: ١٠١] وفي الباب عن ابن عباس، وأبي هريرة. حديث علي حديث غريب من هذا الوجه، سمعت محمدا يقول: أبو البختري لم يدرك عليا. واسم أبي البختري سعيد بن أبي عمران وهو سعيد بن فيروز (@)(@) (@)(@@)(@@)(@@) || باب ما جاء كم حج النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٨١٥ - (@)(@@) حدثنا عبد الله بن أبي زياد قال: حدثنا زيد بن حباب، PageV03P169 عن سفيان، عن جعفر بن محمد، عن أبيه، عن جابر بن عبد الله، أن النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «حج ثلاث حجج، حجتين قبل أن يهاجر، وحجة بعد ما هاجر، ومعها عمرة، فساق ثلاثة وستين بدنة» ، (@)(@@) وجاء علي من اليمن ببقيتها فيها جمل لأبي جهل في أنفه برة من فضة (@)(@@) @MATN@ «فنحرها رسول الله صلى الله عليه وسلم، وأمر رسول الله صلى الله عليه وسلم من كل بدنة ببضعة، فطبخت، وشرب من مرقها» : (@)(@@) @MATN@ «هذا حديث غريب من حديث سفيان لا نعرفه إلا من حديث زيد بن حباب» (@)(@@) ورأيت عبد الله بن عبد الرحمن روى هذا الحديث في كتبه، عن عبد الله بن أبي زياد وسألت محمدا عن هذا فلم يعرفه من حديث الثوري، عن جعفر، عن أبيه، عن جابر، عن النبي صلى الله عليه وسلم، ورأيته لم يعد هذا الحديث محفوظا "، وقال: إنما يروى عن الثوري، عن أبي إسحاق، عن مجاهد مرسلا (@) (@)(@) (@)(@@)(@@)(@@) ||| ٨١٥ - (@)(@@) حدثنا إسحاق بن منصور قال: حدثنا حبان بن هلال قال: حدثنا همام قال: حدثنا قتادة، قال: قلت لأنس بن مالك: كم حج النبي صلى الله عليه وسلم؟ قال: (@)(@@) @MATN@ " حجة واحدة، واعتمر أربع عمر: عمرة في ذي القعدة، PageV03P170 وعمرة الحديبية، وعمرة مع حجته، وعمرة الجعرانة، إذ قسم غنيمة حنين " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وحبان بن هلال هو أبو حبيب البصري هو 
ms279	 جليل ثقة، وثقه يحيى بن سعيد القطان " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء كم اعتمر النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٨١٦ - (@)(@@) حدثنا قتيبة قال: حدثنا داود بن عبد الرحمن العطار، عن عمرو بن دينار، عن عكرمة، عن ابن عباس، أن النبي صلى الله عليه وسلم (@)(@@) @MATN@ " اعتمر أربع عمر: عمرة الحديبية، وعمرة الثانية من قابل، وعمرة القضاء في ذي القعدة، وعمرة الثالثة من الجعرانة، والرابعة التي مع حجته " وفي الباب عن أنس، وعبد الله بن عمرو، وابن عمر.: (@)(@@) @MATN@ «حديث ابن عباس حديث حسن غريب» ، (@)(@@) وروى ابن عيينة هذا الحديث، عن عمرو بن دينار، عن عكرمة، أن النبي صلى الله عليه وسلم اعتمر أربع عمر، ولم يذكر فيه، عن ابن عباس، PageV03P171 حدثنا بذلك سعيد بن عبد الرحمن المخزومي قال: حدثنا سفيان بن عيينة، عن عمرو بن دينار، عن عكرمة، أن النبي صلى الله عليه وسلم فذكر نحوه (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء من أي موضع أحرم النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٨١٧ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن جعفر بن محمد، عن أبيه، عن جابر بن عبد الله قال: (@)(@@) @MATN@ «لما أراد النبي صلى الله عليه وسلم الحج أذن في الناس، فاجتمعوا إليه، فلما أتى البيداء أحرم» (@)(@@) وفي الباب عن ابن عمر، وأنس، والمسور بن مخرمة.: (@)(@@) @MATN@ «حديث جابر حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٨١٨ - (@)(@@) حدثنا قتيبة بن سعيد قال: حدثنا حاتم بن إسماعيل، عن موسى بن عقبة، عن سالم بن عبد الله بن عمر، عن ابن عمر قال: (@)(@@) @MATN@ «البيداء PageV03P172 التي يكذبون فيها على رسول الله صلى الله عليه وسلم، والله ما أهل رسول الله صلى الله عليه وسلم إلا من عند المسجد من عند الشجرة» (@)(@@) هذا حديث حسن صحيح " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء متى أحرم النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٨١٩ - (@)(@@) حدثنا قتيبة قال: حدثنا عبد السلام بن حرب، عن خصيف، عن سعيد بن جبير، عن ابن عباس، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم أهل في دبر الصلاة» : (@)(@@) @MATN@ " هذا حديث حسن غريب لا نعرف أحدا رواه غير 
ms280	 عبد السلام بن حرب، وهو الذي يستحبه أهل العلم: أن يحرم الرجل في دبر الصلاة " (@)PageV03P173 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في إفراد الحج (@)(@) (@)(@@)(@@)(@@) ||| ٨٢٠ - (@)(@@) حدثنا أبو مصعب، قراءة عن مالك بن أنس، عن عبد الرحمن بن القاسم، عن أبيه، عن عائشة، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم أفرد الحج» (@)(@@) وفي الباب عن جابر، وابن عمر.: (@)(@@) @MATN@ «حديث عائشة حديث حسن صحيح، والعمل على هذا عند بعض أهل العلم» (@)(@@) (@)(@) (@)(@@) وروي عن ابن عمر، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم» (@)(@@) أفرد الحج (@)(@@) @MATN@ «، وأفرد أبو بكر، وعمر، وعثمان» (@)(@@) حدثنا بذلك قتيبة قال: حدثنا عبد الله بن نافع الصائغ، عن عبد الله بن عمر، عن نافع، عن ابن عمر بهذا.: وقال الثوري: (@)(@@) @MATN@ «إن أفردت الحج فحسن، وإن قرنت فحسن، وإن تمتعت فحسن» ، (@)(@@) وقال الشافعي مثله، وقال: (@)(@@) @MATN@ «أحب إلينا الإفراد، ثم التمتع، ثم القران» (@)(@@) (@)PageV03P174 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الجمع بين الحج والعمرة (@)(@) (@)(@@)(@@)(@@) ||| ٨٢١ - (@)(@@) حدثنا قتيبة قال: حدثنا حماد بن زيد، عن حميد، عن أنس قال: سمعت النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «لبيك بعمرة وحجة» (@)(@@) وفي الباب عن عمر، وعمران بن حصين. حديث أنس حديث حسن صحيح، وقد ذهب بعض أهل العلم إلى هذا، واختاره من أهل الكوفة، وغيرهم (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في التمتع (@)(@) (@)(@@)(@@)(@@) ||| ٨٢٢ - (@)(@@) حدثنا أبو موسى محمد بن المثنى، قال حدثنا عبد الله بن إدريس، PageV03P175 عن ليث، عن طاووس، عن ابن عباس قال: (@)(@@) @MATN@ «تمتع رسول الله صلى الله عليه وسلم» ، (@)(@@) وأبو بكر، وعمر، وعثمان "، وأول من نهى عنها معاوية (@) (@)(@) (@)(@@)(@@)(@@) ||| ٨٢٣ - (@)(@@) حدثنا قتيبة، عن مالك بن أنس، عن ابن شهاب، عن محمد بن عبد الله بن الحارث بن نوفل، أنه سمع سعد بن أبي وقاص، والضحاك بن قيس وهما يذكران التمتع بالعمرة إلى الحج، فقال الضحاك بن قيس: لا يصنع ذلك إلا من جهل أمر الله، فقال سعد: بئس ما قلت يا ابن أخي، فقال الضحاك بن قيس: فإن عمر بن الخطاب قد نهى عن ذلك، فقال سعد: (@)(@@) @MATN@ «قد صنعها رسول الله صلى الله عليه وسلم، 