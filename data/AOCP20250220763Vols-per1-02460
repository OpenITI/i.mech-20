ms2454	 پی آن بود تا مرا %~% اندر فریبی و دلم از جای بر کنی(@)(@@) (@@) کشتی مرا به دوستی و کس نکشته بود %~% زین زارتر کسی را هرگز به دشمنی(@)(@@) ~~- تاکی بود این شوخی و تا کی بود این رنگ7 با تو رهیت را چو به دل(@)(@@) ایمنی نبود %~% زین پس به جان چگونه بود بر تو ایمنی %~% زین شوخی و زین رنگ نگردد دل تو تنگ(@)(@@) (@@) صلح است تو را با من و با من نکنی صلح %~% جنگ است تو را با من و با تو نکنم جنگ(@)(@@) (@@) سنگاست دلت مهر برو تابان گه گه %~% کز یافتن مهر گهر زاید در سنگ(@)(@@) (@@) فرسنگ به فرسنگ دوانم ز پی تو %~% وز من تو گریزانی فرسنگ به فرسنگ(@)(@@) (@@) گر من ز تو ای دوست همی ننگ ندارم %~% تو نیز مدار از من و از صحبت من ننگ(@)(@@) ~~- نوبهار آمد و بشکفت به یکبار جهان تا ز خواب خوش برداشت8 گل سوری(@)(@@) چشم %~% بر سر افکند زمین هرچه گهر داشت نهان %~% لالهآ سرخ ببندد همی از خنده دهان PageV05P2824(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V05_0089.jpg)(@)(@)(@@) (@@) رنیانها و پرندست کشیده همه باغ %~% عاشقان گاه بدین سایه دوان گاه در آن(@)(@@) (@@) اندر آن هفته که بگذشت جهان پیر نمود %~% نشنیدم که به یک هفته شود پیر جوان(@)(@@) (@@) مینگویم1 که می سرخ حلالاست و مباح %~% گر بود ورنه من این لفظ نیارم به زبان(@)(@@) (@@) گویم از هر گز خواهی خورد، امروز بخور %~% که دگر بار به این دور2 رسیدن نتوان(@)(@@) (@@) خیز تا بر گل نو کوزه گکی باده خوریم %~% پیش تا ازگل ما کوزه کند دست زمان(@)(@@) (@@) طرب کنم که به شب وقت شادی3 و طرباست %~% [مرا بدین طرب، ای سیدی دو سه سبب است(@)(@@) (@@) یکی که کودک من با من است باده به دست %~% دگر که مطرب ما را نشاط با طرب است(@)(@@) (@@) سه دیگر آنکه شب است و حسودم آگه نیست]4 %~% ز دل غلام شبم، ورچه روز به ز شب 
ms2455	 است(@)(@@) (@@) شراب هست و طرب هست و روی نیکو هست %~% بدین سه چیز جهان جای عشرت و لعب است(@)(@@) (@@) شراب ما ز دو چشمان به روی زرد چکید %~% رخان دوست همی لاله گون شد و عجب است(@)(@@) (@@) شراب کان سبب غم بود در دیده چکید %~% نشاط را سبب از آب دیده عنب است5(@)(@@) (@@) سپیدهدم ز در خیمه اندر آمد مست %~% پیاله اندر جیب و ضراحی اندر دست(@)(@@) (@@) فرو نشست و فراقش ز پیش من برخاست %~% فراق جای نیامد، کجا وصال نشست(@)(@@) (@@) چو من به شوخی بند قبای بگشادم %~% به شرم رفت و در حجره استوار ببست(@)(@@) (@@) به عذر گفت که مست آمدم جفا کردم %~% به مهر گفتم معشوق را که ناید مست(@)(@@) (@@) خمار عشق و خمار نبید بود پسر %~% خمار من نبیذ و به بوسهای بشکست(@)(@@) (@@) -از بس شمار بوسه که دوش آن نگار کرد %~% [با روزگار کار من اندر شمار کرد(@)(@@) (@@) دیدم شمار و بوسه ندیدم همی به چشم %~% بی می مرا از آنچه ندیدم خمار کرد](@)(@@) (@@) گفتم که چو تو به بوسه بخیلی همی کنی %~% از تو چگونه نتوان طمع کنار کرد(@)(@@)(@@)(@@) | گفتا بدین گزافه نخواهم نگار کرد(@)(@@) (@@) گفتا لب چگونه برم پیش از آنکه او %~% صد ره به بوسه هر دو لب من فکار کرد PageV05P2825(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V05_0090.jpg)(@)(@)(@@) (@@) چندین حدیث گفته شد و آخر آن نگار %~% تا بوسهای بداد دو چشمم چهار گرد(@)(@@) (@@) هر کرا تیرگی رسد همچو نگار %~% گو ازین هندوگی دار، نه فربه نه نزار 5450(@)(@@) (@@) جعد او سایه کن و رویک او پاک شوی %~% غم ترکی چو نگاری ... بگسار(@)(@@) (@@) هندوی بد که تو را باشد و زان تو بود %~% بهتر از ترکی کان تو نباشد صد بار(@)(@@) (@@) هندوان شوخک و شیرینک و خوش بانمکند %~% نیز بی مشغله باشند گه بوس و کنار(@)(@@) (@@) تا تو را ترکی سه بوسهآ دزدیده دهد %~% هندویی را بتوان برد و بپرداخت زکار(@)(@@) (@@) زلف هندو را بندی بود و تاب دویست 
ms2456	 %~% جعد هندو را تابی بود و پیچ هزار(@)(@@) (@@) سیر باشد پدیدار و لیکن چه شود %~% مورد هم سیر بود سیری فخرست نه عار(@)(@@) (@@) - مگر ستم زان پیش آن کام و هوا %~% گفتا مگری پند همی داد مرا(@)(@@) (@@) بنداشت همی کآب نماند فردا %~% نتوان کردن تهی به ساغر دریا(@)(@@) (@@) -یاری بودی سخت به آیین و به سنگ %~% همسایهآ تو بهانه جوی و دلتنگ(@)(@@) (@@) این خو تو ازو گرفتهای ای سرهنگ %~% انگور ز انگور همی گیرد رنگ(@)(@@) (@@) - آن کس که دلم دوست ترا در ابد است %~% صد دشمن جنگ جوی بر من بگماشت(@)(@@) (@@) نتوانم دوست را بدین عیب گذاشت %~% بینی به در از روی بر نتوان داشت(@)(@@) (@@) - ای دوست بهر سخن ز من بگریزی %~% خوی تو نبد به هر حدیثی تیزی(@)(@@) (@@) بد گشتی زانکه با بدان آمیزی %~% با دیگ بمنشین که سیه برخیزی(@)(@@) (@@) -گفتم رخ تو بهار خندان من است %~% گفت آن تو نیز باغ و بستان من است(@)(@@) (@@) گفتم لب شکرین تو آن من است %~% گفت از تو دریغ نیست گر جان من است(@)(@@) (@@) - از بهر خدا اگر تو بینی ز خدای %~% یکباره ز من باز مگیر ای بت پای(@)(@@) (@@) دیدار عزیز کردی ای بار خدای %~% سیمرغ نهای روی رهی را بنمای(@)(@@) (@@) - آنی که دلم به مهر تو خرسند است %~% اندازهآ مهر تو ندانم چند است(@)(@@) (@@) رخسار تو دلگشای و دلبند است %~% گفتار تو تار روح را پیوند است(@)(@@) (@@) -گویند که معشوق تو زشت است و سیاه %~% گر زشت و سیاه است مرا نیست گناه(@)(@@) (@@) من عاشقم و دلم برو گشته تباه %~% عاشق نبود ز عیب معشوق آگاه PageV05P2826(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V05_0091.jpg)(@)(@)(@@) - خط آوردی رواست بر روی چو ماهخوشتر گشتی از آنچه بودی صد راه(@)(@@) در آرزوی خط تو خوبان سپاه %~% بر روی همی کشند خطهای سیاه(@)(@@) وتا در طلب عمر1 همی بشتابم %~% عمرم به کران رسید و من در خوابم(@)(@@) گیرم که وصال دوست در خواهم یافت %~% این عمر گذشته را کجا 
ms2457	 دریابم(@)(@@) زلف و خد آن سروقد سیمین بر %~% از مشک مسلسل است یا سنبل تر(@)(@@) زان زلف گرفت عنبر و مشک خطر %~% وز خط بفزود روی او زینت و فر(@)(@@) (@@) بر آمد نیلگون2 ابری ز روی نیلگون دریا %~% چو رای عاشقان گردان چو طبع بیدلان شیدا(@)(@@) (@@) ببارید و ز هم بگسست و گردان گشت در گردون %~% چو پیلان پراکنده میان آبگون صحرا(@)(@@) (@@) تو گفتی گرد زنگارست بر آیینهآ چینی %~% تو گویی موی سنجابست بر پیروزهگون دیبا(@)(@@) (@@) بهسان مرغزاری سبز رنگ اندر شده گردش %~% به یک ساعت ملون کرده کفر3 گنبد خضرا(@)(@@) (@@) تو گفتی آسمان دریاست از سبزی و بر رویش %~% به پرواز اندر آورده است ناگه بچگان عنقا(@)(@@) (@@) همی رفت از بر گردون گهی تاری و گه روشن %~% وزو گه آسمان پیدا و گه خورشید ناپیدا(@)(@@) (@@) به سان چندن سوهان زده بر لوح پیروزه %~% به کردار عبیر بیخته بر صفحهآ مینا(@)(@@) (@@) چو دود آتش کآبش به روی اندر زنی ناگه %~% چو چشم بیدلی کز دیدن دلبر شود بینا(@)(@@) (@@) هوای روشن از رویش2 مغبر گشت و شد تیره %~% چو جان کافر کشته ز تیغ خسرو والا(@)(@@) (@@) یمین5 دولت و دولت بدو پیراسته گیتی %~% امین ملت و ملت بدو آراسته دنیا(@)(@@) (@@) دل ترسا همی داند کزو کیشش تبه گردد %~% لباس سوگواران زان قبل پوشد همی ترسا(@)(@@) (@@) دل خارا ز بیم تیغ او خون گشت پنداری %~% که آتش رنگ خون دارد چو بیرون آید از خارا(@)(@@) (@@) امید خلق غواص است و دست راد او دریا %~% به کام خویش برگیرد گهر غواص ازین دریا(@)(@@) (@@) چو مدحش گفت نتوانی چه گویا و چه ناگویا %~% چو رویش دید نتوانی چه بینا و چه نابینا(@)(@@) (@@) ز خشم و قوتش جایی که بنویسد6 دل بخرد %~% ز جود و همتش جایی که بندیشد7 دل دانا PageV05P2827(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V05_0092.jpg)(@)(@)(@@) (@@) نه آتش را بود گرمی، نه آهن را بود قوت %~% نه دریا را بود رادی، نه گردون را بود بالا(@)(@@) (@@) دل اعدای 
ms2458	 او سنگ است لیکن سنگ آهن کش %~% از آن پیکان او هرگز نجوید جز دل اعدا(@)(@@) ~~-تا ببردی از دل و از چشم من آرام و خواب عشق تو با چار چیزم یار(@)(@@) دارد هشت چیز %~% گه ز دل در آتش تیزم گه از چشم اندر آب %~% مر مرا هر ساعتی زین غم جگر گردد کباب(@)(@@) (@@) با رخم زر و زریر و با دلم گرم و زحیر %~% با دو چشمم آب و خون و با تنم رنج و عذاب(@)(@@) (@@) وین عجایبتر که چون این هشت بر من یار کرد %~% هشت چیز از من ببرد و هشت چیز نیک یاب(@)(@@) (@@) راحت و آرام روح و رامش و تسکین دل %~% نزهت دیدار چشم و زینت و فر شباب 546a(@)(@@) (@@) از رگ و اندر تن و اندر دل و در چشم من %~% خواب و صبر و روح و خونم را بر افتاد انقلاب(@)(@@) (@@) ای تنم از هجر تو چون برگ بید اندر خزان %~% وی دلم در عشق تو چون نوری اندر ماهتاب(@)(@@) (@@) روی تو بسترد و بربود و بیفکند و ببرد %~% چار چیز از چار چیز و هر یکی را کرد غاب(@)(@@) (@@) خرمی از نوبهار و تازگی از سرخ گل %~% جان فزایی از مسیح و رو شنایی ز آفتاب(@)(@@) (@@) - مرا بپرسید از رنج راه و شغل سفر %~% بت من آن صنم ماهروی سیمین بر(@)(@@) (@@) نخست گفت گر آخر ترا چه شد که چنین %~% شکست گونهای و بر تو کار کرد غیر(@)(@@) (@@) چو سرو سیمین بودی چو نال زرد شدی %~% مگر ز رنج بنالیدهای به راه اندر(@)(@@) (@@) مگر دل تو به جای دگر فریفته شد %~% [مگر ز عشق کسی پر خمار داری سر(@)(@@) (@@) مگر ترا ز کسی نکبتی رسید بر وی]3 %~% مگر مخاطرهای کردهای به جای خطر(@)(@@) (@@) مگر ز خوابگه شیر برگرفتی صید %~% مگر ز بازوی سیمرغ برگشادی پر(@)(@@) (@@) مگر ز مار سیه داشتی به شب بالین %~% مگر ز کژدم جراره داشتی بستر(@)(@@) (@@) مگر 
