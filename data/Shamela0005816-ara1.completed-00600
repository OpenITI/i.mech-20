ms581	 القرشي يروي عن أبي هريرة وابن عمر وعائشة وعبد الله بن عامر روى عنه ابناه خالد وإسحاق ابنا سعيد(@)(@@)(@@)(@@) $ 2887 - سعيد بن أيمن مولى كعب بن سور بصري يروي عن أنس روى عنه حماد بن زيد وأبو الأشهب(@)(@@)(@@)(@@) $ 2888 - سعيد بن سعد بن عبادة الخزرجي يروي عن أبيه روى عنه أبو أمامة بن سهل بن حنيف(@)(@@)(@@)(@@) $ 2889 - سعيد بن حاطب الجمحي أخو محمد بن حاطب قال كان النبي صلى الله عليه وسلم يجلس على المنبر يوم الجمعة ثم يؤذن المؤذن روى عنه صالح بن صالح بن حي الهمداني والد الحسن بن صالح وليس يصح له عندي صحبة فلذلك أدخلناه في كتاب التابعين وقد وهم من زعم أن له صحبة PageV04P277(@)(@@)(@@)(@@) $ 2890 - سعيد بن أبي سعيد الخدري يروي عن أبيه عداده في أهل المدينة روى عنه أهلها وعمران بن أبي أنس(@)(@@)(@@)(@@) $ 2891 - سعيد بن عبد الرحمن بن أبي عياش الزرقي يروي عن أنس بن مالك روى عنه موسى بن عقبة(@)(@@)(@@)(@@) $ 2892 - سعيد بن أسلم يروي عن مولى لهم من بنى غفار من أصحاب النبي صلى الله عليه وسلم روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 2893 - سعيد بن سفيان القاري يروي عن على روى يحيى بن أبي عمرو الشيباني عن عبد الله بن ناشر عنه(@)(@@)(@@)(@@) $ 2894 - سعيد بن جمهان الأسلمي كنيته أبو حفص يروي عن بن أبي أوفى وسفينة روى عنه حماد بن سلمة وعبد الوارث مات في الطاعون بالبصرة سنة ست وثلاثين ومائة(@)(@@)(@@)(@@) $ 2895 - سعيد بن سمعان الأنصاري مولى الزرقيين عداده في أهل المدينة يروي عن أبي هريرة روى عنه بن أبي ذئب PageV04P278(@)(@@)(@@)(@@) $ 2896 - سعيد بن عبد الله بن جريج عداده في أهل الكوفة يروي عن أبي برزة روى عنه الأعمش(@)(@@)(@@)(@@) $ 2897 - سعيد بن أنس يروي عن أنس بن مالك روى عنه عباد بن شيبة(@)(@@)(@@)(@@) $ 2898 - سعيد بن يسار أخو أبي مزرد مولى شقران مولى رسول الله صلى الله عليه وسلم وقد قيل إنه مولى الحسن بن علي وقد قيل مولى بنى النجار 
ms582	 واسم أبي مزرد عبد الرحمن بن يسار كنية سعيد بن يسار أبو الحباب يروي عن أبي هريرة روى عنه المقبري وسهيل بن أبي صالح مات بالمدينة سنة سبع عشرة ومائة(@)(@@)(@@)(@@) $ 2899 - سعيد بن عبد الله بن يسار أخو أيوب وسليط يروي عن بن عمر روى عنه خالد بن أبي عثمان عداده في أهل المدينة(@)(@@)(@@)(@@) $ 2900 - سعيد بن يزيد بن مسلمة الأزدي كنيته أبو مسلمة الطحان PageV04P279 عداده في أهل البصرة يروي عن أنس بن مالك وكان راويا لأبي نضرة روى عنه شعبة وحماد بن زيد والناس(@)(@@)(@@)(@@) $ 2901 - سعيد بن حيان أخو بنى عدى وقد قيل إنه من تيم الرباب عداده في أهل الكوفة يروي عن على روى عنه أبو حيان التيمي والحارث بن سويد(@)(@@)(@@)(@@) $ 2902 - سعيد بن عبد الله بن ضرار الأسدي الكوفي يروي عن أنس روى عنه واصل الأحدب(@)(@@)(@@)(@@) $ 2903 - سعيد بن الحكم وقد قيل سعد بن أحكم من أهل واسط يروي عن أبي أيوب الأنصاري روى يزيد بن أبي حبيب عن شيخ عنه(@)(@@)(@@)(@@) $ 2904 - سعيد بن سويد يروي عن معاوية روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 2905 - سعيد بن أبيض بن حمال السبائي الماربي عداده في أهل اليمن PageV04P280 يروي عن فروة بن مسيك وأبيه روى عنه ابنه ثابت بن سعيد(@)(@@)(@@)(@@) $ 2906 - سعيد بن سليم الضبي كنيته أبو عثمان عداده في أهل البصرة يروي عن أنس بن مالك روى عنه أبو عامر العقدى يخطىء(@)(@@)(@@)(@@) $ 2907 - سعيد الثقفي يروي عن رجل من قومه من أصحاب رسول الله صلى الله عليه وسلم روى حصين بن عبد الرحمن عن أبي الحجاج عنه(@)(@@)(@@)(@@) $ 2908 - سعيد بن حيان الأزدي اليحمدي أصله من البصرة ولى القضاء ببلخ يروي عن بن عباس روى عنه عوف بن أبي جميلة الأعرابي وعامر الأحول(@)(@@)(@@)(@@) $ 2909 - سعيد بن خالد القرشي يروي عن واثلة بن الأسقع وأنس بن مالك روى عنه بن عياش(@)(@@)(@@)(@@) $ 2910 - سعيد بن قيس بن قهد الأنصاري والد يحيى بن سعيد يروي عن أبيه وله صحبة روى عنه ابنه يحيى 
ms583	 بن سعيد PageV04P281(@)(@@)(@@)(@@) $ 2911 - سعيد بن هانئ الخولاني أبو عثمان عداده في أهل الشام يروي عن جماعة من الصحابة روى عنه أهل الشام مات سنة سبع وعشرين ومائة(@)(@@)(@@)(@@) $ 2912 - سعيد بن الحارث بن أبي المعلى الأنصاري ويقال بن المعلى ولى القضاء بالمدينة يروي عن بن عمر وجابر وأبي سعيد روى عنه عمر بن الحارث وعمارة بن غزية وفليح بن سليمان وأهل المدينة(@)(@@)(@@)(@@) $ 2913 - سعيد بن ذي حدان يروي عن على وسهيل بن حنيف روى عنه أبو إسحاق السبيعي ربما أخطأ(@)(@@)(@@)(@@) $ 2914 - سعيد بن أبي الحويرث مولى السائب يروي عن بن عباس روى عنه عمرو بن دينار وابن جريج كنيته أبو يزيد(@)(@@)(@@)(@@) $ 2915 - سعيد بن عبد الرحمن بن رقيش المدني يروي عن أنس بن مالك روى عنه يحيى بن سعيد الأنصاري وأهل المدينة PageV04P282(@)(@@)(@@)(@@) $ 2916 - سعيد بن حسان يروي عن بن الزبير وابن عمر روى عنه نافع بن عمر وإبراهيم بن نافع(@)(@@)(@@)(@@) $ 2917 - سعيد بن زرعة الجرار الحمصي يروي عن ثوبان روى عنه الحسن بن همام ومرزوق أبو عبد الله الشامي(@)(@@)(@@)(@@) $ 2918 - سعيد بن شفى يروي عن بن عباس روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2919 - سعيد بن أبي خالد أخو إسماعيل بن أبي خالد واسم أبي خالد سعد البجلي وقد قيل هرمز عداده في أهل الكوفة يروي عن أبي هريرة روى عنه إسماعيل بن أبي خالد أخوه(@)(@@)(@@)(@@) $ 2920 - سعيد بن عمرو بن حذيم قوله روى حماد بن سلمة عن على PageV04P283(@)(@@) بن الحكم عن جده عنه(@)(@@)(@@)(@@) $ 2921 - سعيد بن حرب العبدي قال سمعت بن الزبير وهو يقلع قواعد البيت فأتى على تربة صفراء عند الحطيم فقال واروها فإن هذا قبر إسماعيل روى عنه بن أخيه المنذر بن ثعلبة بن حرب العبدي من حديث المراوزة(@)(@@)(@@)(@@) $ 2922 - سعيد بن العاص الشمالي يروي عن بن مسعود روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2923 - سعيد بن أبي هند من أهل المدينة يروي عن أبي موسى روى عنه ابنه عبد الله بن سعيد(@)(@@)(@@)(@@) $ 2924 - سعيد بن خالد بن عمرو بن حزم 
ms584	 الأنصاري يروي عن بعض أزواج النبي صلى الله عليه وسلم روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 2925 - سعيد بن أبي شمر السبائي عداده في أهل مصر رأى مالك بن زاهر ينقى باطن قدميه ولمالك صحبة روى عنه بكر بن سوادة وعمرو بن الحارث(@)(@@)(@@)(@@) $ 2926 - سعيد بن أبي سعيد المقبري كنيته أبو سعد نسب إلى مقبرة PageV04P284 كان يسكن بالقرب منها واسم أبيه كيسان كان مكاتبا لأمرأة من بنى ليث عداده في أهل المدينة يروي عن أبي هريرة وعن أبيه روى عنه الناس مات سنة ثلاث وعشرين ومائة وقد قيل سنة ست وعشرين ومائة وكان قد اختلط قبل أن يموت بأربع سنين(@)(@@)(@@)(@@) $ 2927 - سعيد بن أبي سعيد مولى أبي بكر بن محمد بن عمرو بن حزم يروي عن أبي رافع مولى رسول الله صلى الله عليه وسلم روى عنه موسى بن عبيدة الربذي حديث صلاة التسبيح(@)(@@)(@@)(@@) $ 2928 - سعيد بن الصلت مولى لآل مخرمة كنيته أبو يعقوب يروي عن بن عباس روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 2929 - سعيد بن سليم بن قيس بن قهد الأنصاري يروي عن أبي هريرة وأبيه روى عنه أبو بكر بن محمد بن عمرو بن حزم الأنصاري والزهري(@)(@@)(@@)(@@) $ 2930 - سعيد بن عبيد بن السباق كنيته أبو السباق من PageV04P285 أهل المدينة يروي عن أبي هريرة والسائب بن يزيد روى عنه الزهري وفليح بن سليمان(@)(@@)(@@)(@@) $ 2931 - سعيد الضبي يروي عن على عداده في أهل الكوفة روى عنه ابنه رزام بن سعيد(@)(@@)(@@)(@@) $ 2932 - سعيد بن عبد الله الأغطش من أهل الشام يروي عن جماعة من الصحابة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 2933 - سعيد بن عبد الرحمن بن جحش الحجبي الحجازي يروى عن بن عمر وأمامة روى عنه محمد بن راشد(@)(@@)(@@)(@@) $ 2934 - سعيد بن طهمان يروي عن أنس بن مالك روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 2935 - سعيد بن فيروز الطائي مولى لهم أبو البخترى وقد قيل سعيد بن أبي عمران عداده في أهل الكوفة يروي عن بن عباس وابن عمر روى عنه الكوفيون قتل بالجماجم 
ms585	 سنة ثلاث وثمانين وقد قيل سعيد بن عبيد مولى بنى نبهان(@)(@@)(@@)(@@) $ 2936 - سعيد بن أبي كرب الهمداني من أهل الكوفة يروي عن جابر PageV04P286 روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2937 - سعيد بن عبد الرحمن أبو صالح الغفاري يروي عن عقبة بن عامر عداده في أهل مصر يروى عنه أهلها(@)(@@)(@@)(@@) $ 2938 - سعيد بن رقيش يروي عن بن عباس روى عنه محمد بن عمار بن عمارة الخطمي(@)(@@)(@@)(@@) $ 2939 - سعيد بن عمير الحارثي الأنصاري من أهل المدينة يروى عن بن عمر وأبي سعيد روى عنه جعفر بن عبد الله حدثنا إبراهيم بن خريم قال ثنا عبد بن حميد قال ثنا أبو عاصم عن عبد الحميد بن جعفر عن أبيه عن سعيد عن عمير قال جلست إلى بن عمر وأبي سعيد فقال أحدهما لصاحبه كيف سمعت النبي صلى الله عليه وسلم يذكر أين يبلغ العرق من بن آدم يوم القيامة فقال أحدهما يلجمه وقال الآخر يبلغ شحمة أذنيه فقال بن عمر هكذا ووضع أبو عاصم إصبعيه على شحمة أذنيه ثم مدها إلى فيه PageV04P287(@)(@@)(@@)(@@) $ 2940 - سعيد بن عمير بن عبيد الأنصاري يروي عن أبي برزة الأسلمي روى عنه وائل بن داود الثوري أحسبه الأول(@)(@@)(@@)(@@) $ 2941 - سعيد بن علاقة أبو فاختة مولى أم هانئ بنت أبي طالب أخت علي بن أبي طالب يروي عن على عداده في أهل الكوفة روى عنه ابناه ثوير وبرد(@)(@@)(@@)(@@) $ 2942 - سعيد بن عمير بن عقبة بن نيار يروي عن عمه أبي بردة بن نيار روى عنه سعيد بن سعيد الثعلبي(@)(@@)(@@)(@@) $ 2943 - سعيد بن قيس الهمداني يروي عن حفصة زوجة رسول الله صلى الله عليه وسلم روى عنه أبو إسحاق السبيى(@)(@@)(@@)(@@) $ 2944 - سعيد بن عبد الرحمن بن أبزى كوفي يروي عن واثلة بن الأسقع وغيره روى عنه زر بن حبيش وعبدة بن أبي لبابة(@)(@@)(@@)(@@) $ 2945 - سعيد بن كعب يروي عن جابر بن عبد الله روى عنه عبد الحميد بن رافع من حديث الثوري PageV04P288(@)(@@)(@@)(@@) $ 2946 - سعيد بن صفوان التجيبي يروي عن سعد بن مسعود 
ms586	 وله صحبة روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 2947 - سعيد بن عامر يروي عن بن عمر روى عنه ليث بن أبي سليم(@)(@@)(@@)(@@) $ 2948 - سعيد بن نمران كوفي يروي عن أبي بكر الصديق روى عنه عامر بن سعد البجلي(@)(@@)(@@)(@@) $ 2949 - سعيد بن عثمان بن عفان الأموي القرشي بعثه معاوية إلى فتح ما وراء النهر ومعه قثم بن العباس ففتحها(@)(@@)(@@)(@@) $ 2950 - سعيد بن أبي عمرة الأنصاري يروي عن سلمان روى عنه أبو الهيثم الضمري(@)(@@)(@@)(@@) $ 2951 - سعيد بن مسلم بن جماز المكي يروي عن خالد بن الوليد روى عنه بن عيينة(@)(@@)(@@)(@@) $ 2952 - سعيد بن خالد بن أبي الطويل يروي عن أنس بن مالك روى PageV04P289 عنه محمد بن شعيب بن شابور(@)(@@)(@@)(@@) $ 2953 - سعيد التمار يروي عن أنس بن مالك روى عنه مروان بن نهيك(@)(@@)(@@)(@@) $ 2954 - سعيد بن عطية بن قيس يروي عن أبيه روى عنه أبو مسهر الغساني(@)(@@)(@@)(@@) $ 2955 - سعيد بن عبيد يروي عن بن عباس روى عنه القاسم بن أبي بزة(@)(@@)(@@)(@@) $ 2956 - سعيد بن أبي راشد يروي عن يعلى بن مرة العامري روى عنه عبد الله بن عثمان بن خثيم(@)(@@)(@@)(@@) $ 2957 - سعيد بن محمد بن جبير بن مطعم بن عدى القرشي يروي عن أبي هريرة وجبير بن مطعم وهو أخو عمر وجبير عداده في أهل المدينة روى عنه بن أبي ذئب وعبيد الله بن موهب(@)(@@)(@@)(@@) $ 2958 - سعيد مولى الحسن بن على يروي عن بن عمر روى عنه الشعبي PageV04P290(@)(@@)(@@)(@@) $ 2959 - سعيد بن وهب الهمداني الخيواني يروي عن معاذ بن جبل وابن مسعود وابن عمر روى عنه أبو إسحاق السبيعي وهو الذي يقال له سعيد بن أبي خيرة الخيواني مات سنة سبع وتسعين(@)(@@)(@@)(@@) $ 2960 - سعيد بن ميمون كوفي يروي عن البراء بن عازب عداده في أهل الكوفة روى عنه شريك(@)(@@)(@@)(@@) $ 2961 - سعيد بن نافع الأنصاري يروى عن بن عمر وابن عباس عداده في أهل المدينة روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 2962 - سعيد بن ميناء المكي مولى البخترى بن أبي ذباب كنيته أبو الوليد يروي عن جابر 
ms587	 بن عبد الله وأبي هريرة روى عنه زيد بن أبي أنيسة وسليم بن حيان(@)(@@)(@@)(@@) $ 2963 - سعيد العنبري يروي عن أنس بن مالك روى عنه ابنه عبد الوارث بن سعيد الثوري PageV04P291 وابن ابنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 2964 - سعيد بن محمد بن حنطب يروي عن على روى عنه جرير بن أيوب البجلي(@)(@@)(@@)(@@) $ 2965 - سعيد بن شيبان الطائي يروي عن بن أبي أوفى روى عنه مسعر وابن عيينة(@)(@@)(@@)(@@) $ 2966 - سعيد بن مسلم بن يزيد يروي عن أنس بن مالك روى عنه بن عيينة(@)(@@)(@@)(@@) $ 2967 - سعيد بن أبي مريم يروي عن أنس بن مالك روى عنه يحيى بن إسحاق(@)(@@)(@@)(@@) $ 2968 - سعيد المدني يروي عن أبي هريرة روى عنه عبيد الله بن العيزار(@)(@@)(@@)(@@) $ 2969 - سعيد بن مردانبه يروي عن عمرو بن حريث روى عنه شريك ويزيد بن مردانبه PageV04P292(@)(@@)(@@)(@@) $ 2970 - سعيد بن المهاجر يروي عن المقدام بن معدى كرب روى شعبة عن أبي الجودى عنه(@)(@@)(@@)(@@) $ 2971 - سعيد بن أبي هند المدني يروى عن بن عباس وأبي موسى وأبي هريرة روى عنه نافع وابنه عبد الله بن سعيد وهو مولى سمرة بن جندب الفزاري مات في ولاية هشام بن عبد الملك(@)(@@)(@@)(@@) $ 2972 - سعيد بن عمرو أبو السفر وقد قيل بن يحمد الثوري ثور همدان من أهل الكوفة يروى عن بن عباس والبراء روى عنه أبو إسحاق وشعبة ومطرف مات في إمارة خالد على العراق(@)(@@)(@@)(@@) $ 2973 - سعيد بن مرجانة مولى قريش كنيته أبو عثمان وكان من أفاضل أهل المدينة يروي عن أبي هريرة روى عنه محمد بن إبراهيم مات بالمدينة سنة ست وتسعين وهو بن سبع وتسعين سنة PageV04P293 مرجانة أمه واسم أبيه عبد الله(@)(@@)(@@)(@@) $ 2974 - سعد بن هشام بن عامر الأنصاري بن عم أنس بن مالك يروي عن عائشة روى عنه الحسن وزرارة بن أبي أوفى قتل بأرض مكران غازيا(@)(@@)(@@)(@@) $ 2975 - سعد بن زيد بن ثابت الأنصاري من أهل المدينة يروي عن بن عمر روى عنه ابنه قيس بن سعد(@)(@@)(@@)(@@) $ 2976 - سعد بن حذيفة بن اليمان 
ms588	 العبسي عداده في أهل الكوفة يروي عن أبيه روى عنه منذر الثوري وزياد بن علاقة(@)(@@)(@@)(@@) $ 2977 - سعد بن سمرة بن جندب الفزاري يروي عن أبيه روى عنه إبراهيم بن ميمون مولى آل سمرة(@)(@@)(@@)(@@) $ 2978 - سعد بن أبي حميد الساعدي الأنصاري المدني يروي عن أبيه روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 2979 - سعد بن طارق بن أشيم أبو مالك الأشجعي عداده في أهل الكوفة يروي عن أبيه وله صحبة روى عنه شعبة والثوري PageV04P294(@)(@@)(@@)(@@) $ 2980 - أبو أمامة سعد بن سهل بن حنيف الأنصاري يروي عن أبيه وعمر روى عنه الزهري ويحيى بن سعد(@)(@@)(@@)(@@) $ 2981 - سعد بن كعب بن عجرة السالمي يروي عن أبيه عداده في أهل المدينة روى عنه أبو إسحاق كأنه انتقل إلى الكوفة(@)(@@)(@@)(@@) $ 2982 - سعد بن حرملة يروي عن عمر روى عنه عيسى بن عاصم(@)(@@)(@@)(@@) $ 2983 - سعد بن الأخرم يروي عن بن مسعود روى عنه بن المغيرة بن سعد بن الأخرم(@)(@@)(@@)(@@) $ 2984 - سعد بن عبيد القرشي أبو عبيد مولى عبد الرحمن بن أزهر كان من فقهاء أهل المدينة ومفتيهم يروي عن عمر وعثمان وعلى روى عنه الزهري والناس مات سنة ثمان وتسعين(@)(@@)(@@)(@@) $ 2985 - سعد بن أحكم الحميري يروي عن أبي أيوب الأنصاري روى يزيد بن أبي حبيب عن مرة بن محمد عنه وقد قيل إنه سعيد بن الحكم من أهل واسط سكن مصر(@)(@@)(@@)(@@) $ 2986 - سعد الأعرج من أصحاب يعلى بن أمية يروي عن عمر بن الخطاب PageV04P295 روى سماك بن الفضل عن شهاب بن عبد الله عنه(@)(@@)(@@)(@@) $ 2987 - سعد أبو هاشم السنجاري سكن دمشق يروى عن بن عباس وابن عمر روى عنه خصيف وعبد الكريم الجزريان(@)(@@)(@@)(@@) $ 2988 - سعد القرشي مولى الحسن بن علي عداده في أهل الكوفة يروي عن على وعثمان روى عنه ابنه الحسن بن سعد(@)(@@)(@@)(@@) $ 2989 - سعد بن عبد الله الأعرج يروي عن عمر بن الخطاب عداده في أهل اليمن روى عنه أهل اليمن(@)(@@)(@@)(@@) $ 2990 - سعد بن عبد الرحمن بن أبي أيوب الأنصاري المدني يروي عن جدته أم أبيه بنت سعد 
ms589	 بن الربيع وكانت تحت زيد بن ثابت لها صحبة روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 2991 - سعد بن مسعود القيسي يروي عن بن عباس روى عنه سليمان التيمي وصالح بن غزوان(@)(@@)(@@)(@@) $ 2992 - سعد بن سفيان القاري من كنانة يروي عن على بن أبى طالب PageV04P296 وعثمان بن عفان وجماعة من الصحابة روى عنه أهل فلسطين عداده في أهل بيت المقدس(@)(@@)(@@)(@@) $ 2993 - سعد بن مسعود القيسي التجيبي الكندي من أهل مصر سكن حمص يروي عن عبد الله بن عمرو روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 2994 - سعد بن عبد الرحمن بن هاشم بن عتبة الزهري القرشي يروي عن أنس بن مالك روى عنه شريك النخعي وجرير بن عبد الحميد(@)(@@)(@@)(@@) $ 2995 - سعد بن عبيد الله الكاهلي والد جعفر بن سعد يروي عن على روى عنه ابنه جعفر بن سعد(@)(@@)(@@)(@@) $ 2996 - سعد بن نوفل كان عامل عمر على الجار روى عنه ابنه عبد الله بن سعد بن نوفل(@)(@@)(@@)(@@) $ 2997 - سعد بن إبراهيم بن عبد الرحمن بن عوف كنيته أبو إسحاق PageV04P297 أمه أم كلثوم بنت سعد بن أبي وقاص يروي عن عبد الله بن جعفر روى عنه إبراهيم بن سعد مات بالمدينة سنة سبع وعشرين ومائة وهو بن اثنين وسبعين سنة(@)(@@)(@@)(@@) $ 2998 - سعد بن سعيد بن قيس بن قهد الأنصاري أخو يحيى وعبد ربه يروي عن أنس بن مالك عداده في أهل المدينة روى عنه بن المبارك كان يخطىء(@)(@@)(@@)(@@) $ 2999 - سعد بن معبد يروي عن على روى عنه ابنه الحسن بن سعد(@)(@@)(@@)(@@) $ 3000 - سعد مولى طلحة بن عمرو يروي عن بن عمر روى عنه عبد الله بن عبد الله الرازي(@)(@@)(@@)(@@) $ 3001 - سعد بن عبيد السلمي ختن أبي عبد الرحمن السلمي من أهل الكوفة كنيته أبو حمزة يروي عن بن عمر روى عنه طلحة بن مصرف PageV04P298 وعمرو بن مرة وعلقمة بن مرثد مات سعد بن عبيدة في ولاية عمر بن هبيرة(@)(@@)(@@)(@@) $ 3002 - سعد المكى يروي عن بن عمر روى عنه واصل مولى أبي عيينة مات بعد المائة 
ms590	(@)(@@)(@@)(@@) $ 3003 - سعد بن إبراهيم بن عبد الرحمن بن عوف الزهري يروي عن عبد الله بن جعفر روى عنه إبراهيم بن سعد أدخلناه في أتباع التابعين لأن سماعه عن عبد الله بن جعفر فيه ما فيه وإن كان السماع مبينا في خبره(@)(@@)(@@)(@@) $ 3004 - سعد بن عياض يروي عن بن مسعود روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 3005 - سعد مولى الأسود بن سفيان يروي عن عمر بن الخطاب روى عنه ابنه عبد الرحمن بن سعد(@)(@@)(@@)(@@) $ 3006 - سعد مولى بن عمر يروي عن أسيد بن حضير روى عنه هشام بن عروة(@)(@@)(@@)(@@) $ 3007 - سعد الأنصاري رأى أنس بن مالك يمسح على خفيه روى PageV04P299 عنه ابنه محمد بن سعد(@)(@@)(@@)(@@) $ 3008 - سعد أبو خالد البجلي كوفي يروي عن أبي هريرة روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 3009 - سعد مولى عمرو بن العاص يروي المراسيل روى عنه محمد بن إبراهيم التيمي(@)(@@)(@@)(@@) $ 3010 - سعد الرازي جد عبد الرحمن بن عبد الله بن سعد الدشتكي قال رأيت ببخارا على رجل عمامة خز سوداء وهو على بغلة وهو يقول كسانيها رسول الله صلى الله عليه وسلم روى عنه ولده(@)(@@)(@@)(@@) $ 3011 - سليمان بن طرخان التيمي مولى بني مرة وقد قيل إنه مولى لقيس كان ينزل في بني تيم فنسب إليهم وكان من موالي عمرو بن مرة بن عباد بن ضبيعة كنيته أبو المعتمر كان من عباد أهل البصرة وصالحيهم ثقة وإتقانا وحفظا وسنة يروي عن أنس بن مالك روى عنه الثوري وشعبة والناس مات سنة ثلاث وأربعين ومائة ثنا عمران بن موسى السختياني قال ثنا محمد بن عبد الأعلى الصنعاني قال PageV04P300 سمعت المعتمر بن سليمان يقول لولا أنك من أهلي ما اخترتك صلى أبي أربعين سنة صلاة الغداة بوضوء عشاء الآخرة ثنا محمد بن أحمد بن أبي عون قال ثنا علي بن حجر قال ثنا جرير عن رقبة قال رأيت رب العزة في المنام فقال وعزتي لأكرمن مثوى سليمان التيمي(@)(@@)(@@)(@@) $ 3012 - سليمان بن يسار مولى ميمونة بنت الحارث بن حزن أخو عطاء 
ms591	 وعبد الله وعبد الملك بني يسار حمل عن أربعتهم العلم كنية سليمان أبو أيوب وقد قيل أبو عبد الرحمن يروي عن بن عباس وأبي هريرة روى عنه الزهري والناس وهبت ميمونة ولاء يسار لابن عباس وكان سليمان من فقهاء أهل المدينة وقرائهم مات سنة تسع ومائة وكان له يوم توفي ست وسبعون سنة وقد قيل توفي سنة أربع ومائة ويقال أيضا سنة عشر ومائة وهذا أصح وكان مولده سنة أربع وثلاثين(@)(@@)(@@)(@@) $ 3013 - سليمان بن أبي سليمان أبو إسحاق الشيباني الكوفى واسم أبيه PageV04P301 خاقان يروي عن بن أبي أوفى روى عنه الثوري وشعبة والناس مات سنة إحدى وأربعين ومائة ويقال سنة اثنتين وأربعين ومائة وقد قيل سنة ثمان وثلاثين ومائة وكان مولى لبني شيبان(@)(@@)(@@)(@@) $ 3014 - سليمان بن مهران الأعمش مولى بنى كاهل كنيته أبو محمد كان أبوه من سبي دبثا وقد رأى أنس بن مالك بواسط ومكة روى عنه شبيها بخمسين حديثا ولم يسمع منه إلا أحرفا معدودة وكان مدلسا أخرجناه في هذه الطبقة لأن له لقا وحفظا وإن لم يصح له سماع المسند عن أنس ولد في السنة التي قتل فيها حسين بن علي سنة إحدى وستين وقد قيل إنه ولد قبل مقتل حسين بسنتين وكان فيه دعابة مات سنة ثمان وأربعين ومائة وقد قالوا سنة سبع وأربعين وقد PageV04P302 قيل سنة خمس وأربعين(@)(@@)(@@)(@@) $ 3015 - سليمان بن بريدة بن الحصيب الأسلمي يروى عن أبيه وعمران بن حصين روى عنه علقمة بن مرثد ولد هو وأخوه عبد الله بن بريدة في بطن واحد على عهد عمر لثلاث خلون من خلافته ومات سليمان سنة خمس ومائة بفنين قرية من قرى مرو وبها قبره وكان على قضاء مرو فيما قيل(@)(@@)(@@)(@@) $ 3016 - سليمان بن كندير يروي عن بن عمر روى عنه محمد بن مروان شيخ كوفي وليس بصاحب الكلبي(@)(@@)(@@)(@@) $ 3017 - سليمان بن عطاء يروي عن عبد الله بن الزبير روى عنه صفوان بن سليم(@)(@@)(@@)(@@) $ 3018 - سليمان بن ميناء يروي عن عبد الله بن عمرو روى 
ms592	 عنه بن أبي نجيح PageV04P303(@)(@@)(@@)(@@) $ 3019 - سليمان بن عتيق المحاربي يروي عن بن الزبير روى عنه زياد بن سعد(@)(@@)(@@)(@@) $ 3020 - سليمان المنبهي يروي عن ثوبان روى عنه حميد الشامي(@)(@@)(@@)(@@) $ 3021 - سليمان بن عريب يروي عن أبي هريرة وكان صهرا لابن عباس روى عنه الأعرج(@)(@@)(@@)(@@) $ 3022 - سليمان بن أبي هند مولى زيد بن الخطاب القرشي كنيته أبو الربيع يروي عن عمر بن الخطاب وخباب بن الأرت روى عنه محمد بن جاحدة وإسماعيل بن سميع(@)(@@)(@@)(@@) $ 3023 - سليمان بن الجعد يروي عن بن الزبير روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 3024 - سليمان بن الحرير يروي عن جابر بن عبد الله روى عنه سليمان بن عمرو(@)(@@)(@@)(@@) $ 3025 - سليمان بن يحيى يروي عن بن عمر روى عنه بن عجلان PageV04P304(@)(@@)(@@)(@@) $ 3026 - سليمان بن عتيق يروي عن جابر بن عبد الله روى عنه حميد الأعرج(@)(@@)(@@)(@@) $ 3027 - سالم بن عبد الله بن عمر بن الخطاب القرشي المدني كنيته أبو عمر كان يشبه أباه في السمت والهدى وكان يخضب بالحناء وكان أشبه ولد عمر بن الخطاب به يروي عن أبيه روى عنه الزهري والناس مات سنة ست ومائة وصلى عليه هشام بن عبد الملك في حجته التي حج ولم يحج في ولايته غيرها وأمه أم ولد(@)(@@)(@@)(@@) $ 3028 - سالم بن أبي الجعد مولى أشجع وأبو الجعد اسمه رافع مولى غطفان يروي عن بن عمر وجابر وأنس روى عنه منصور والأعمش عداده في أهل الكوفة مات سنة سبع أو ثمان وتسعين في ولاية سليمان بن عبد الملك وهم إخوة ستة سالم وعبيد وعمران PageV04P305 وزياد ومسلم وعبد الله بنو أبي الجعد(@)(@@)(@@)(@@) $ 3029 - سالم بن سالم أبو شداد العبسي الحمصي يروي عن أبي أمامة روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 3030 - سالم بن وابصة بن معبد يروي عن أبيه روى عنه أهل الجزيرة(@)(@@)(@@)(@@) $ 3031 - سالم بن شوال المكي مولى أم حبيبة بنت أبي سفيان يروي عن أم حبيبة بنت أبي سفيان روى عنه عطاء بن أبي رباح وعمرو بن دينار(@)(@@)(@@)(@@) $ 3032 - سالم بن أبي عاصم 
ms593	 الثقفى يروي عن بن مسعود روى عنه الزهري(@)(@@)(@@)(@@) $ 3033 - سالم بن خباب مولى فاطمة بنت عتبة بن ربيعة كنيته أبو عبد الرحمن يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه الناس مات سنة ست وتسعين(@)(@@)(@@)(@@) $ 3034 - سالم أبو الغيث مولى عبد الله بن مطيع بن الأسود القرشي عداده في أهل المدينة يروي عن أبي هريرة روى عنه ثور بن زيد(@)(@@)(@@)(@@) $ 3035 - سالم بن سرج أبو النعمان وقد قيل سالم بن PageV04P306 خربوذ والصحيح بن سرج يروي عن أم صبية الجهنية قالت اختلفت يدي ويد رسول الله صلى الله عليه وسلم في الوضوء من إناء واحد روى عنه أسامة بن زيد وخارجة بن الحارث المدني واسم أم صبية خولة بنت قيس وهو مولاها(@)(@@)(@@)(@@) $ 3036 - سالم أبو عبد الله البراد يروي عن بن عمر وأبي هريرة وأبي مسعود روى عنه إسماعيل بن أبي خالد وعبد الملك بن عمير(@)(@@)(@@)(@@) $ 3037 - سالم مولى دوس كنيته أبو عبد الله مولى شداد بن الهاد يروي عن سعد بن أبي وقاص وعائشة وأبي هريرة روى عنه نعيم المجمر وبكير بن الأشج(@)(@@)(@@)(@@) $ 3038 - سالم بن عبد الله مولى مالك بن أوس بن الحدثان النصرى وهو PageV04P307 الذي يقال له سالم سبلان مولى النصريين يروي عن أبي هريرة وعائشة روى عنه سعيد المقبري ونعيم المجمر وبكير بن الأشج(@)(@@)(@@)(@@) $ 3039 - سالم بن شهاب بن مدلج العنبري من أهل البصرة يروي عن بن عمر روى عنه أخوه حبيب بن شهاب العنبري(@)(@@)(@@)(@@) $ 3040 - سالم قهرمان عبد الله بن عمرو يقال مولى عبد الله بن عمرو يروي عن عبد الله بن عمرو روى عنه عمرو بن شعيب(@)(@@)(@@)(@@) $ 3041 - سالم أبو شداد يروي عن أبي أمامة روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 3042 - سالم بن سلمة أبو سبرة الهذلي يروي عن على روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 3043 - سالم بن أبي مريم الكوفي يروي عن أبي سعيد الخدري روى عنه علي بن أبي جبلة(@)(@@)(@@)(@@) $ 3044 - سالم التمار يروي عن أبي مسعود الأنصاري وعقبة بن 
ms594	 PageV04P308 عمرو روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 3045 - سالم بن ربيعة يروي عن حذيفة روى عنه حلام بن صالح(@)(@@)(@@)(@@) $ 3046 - سالم أبو غياث العتكي يروي عن أنس بن مالك روى عنه التبوذكي ربما أخطأ(@)(@@)(@@)(@@) $ 3047 - سليمان بن عياض قرشي مولى بن الزبير يروي عن بن الزبير روى عنه بكر بن سوادة وعبيد الله بن المغيرة(@)(@@)(@@)(@@) $ 3048 - سليمان بن الربيع العدوى يروي عن عمر بن الخطاب روى عنه عبد الله بن بريدة(@)(@@)(@@)(@@) $ 3049 - سليمان بن عبد الله الأنصاري أبو عمران يروي المراسيل روى عنه ثعلبة بن مسلم والمصريون(@)(@@)(@@)(@@) $ 3050 - سليمان بن قيس اليشكري يروي عن جابر وأبي سعيد الخدري روى عنه قتادة وأبو بشر ولم يره أبو بشر يقال إن سليمان مات PageV04P309 في فتنة بن الزبير قبل جابر بن عبد الله(@)(@@)(@@)(@@) $ 3051 - سليمان بن سحيم كنيته أبو أيوب مولى خزاعة يروي عن جماعة من الصحابة روى عنه أهل المدينة مات في أول ولاية أبي جعفر(@)(@@)(@@)(@@) $ 3052 - سليمان بن الجهم أبو الجهم مولى البراء بن عازب يروي عن البراء بن عازب روى عنه مطرف بن طريف عداده في أهل جرجان(@)(@@)(@@)(@@) $ 3053 - سليمان بن ميسرة يروي عن طارق بن شهاب الأحمسي وله صحبة روى عنه الأعمش(@)(@@)(@@)(@@) $ 3054 - سليمان بن حيان أبو خيثمة يروي عن أبي الدرداء وواثلة بن الأسقع روى عنه الوليد بن عبد الله الحمصي(@)(@@)(@@)(@@) $ 3055 - سليمان بن أمية الثقفي من ولد عروة بن مسعود الطائفي يروي عن عائشة روى عنه بن عيينة وخزرج بن عثمان PageV04P310(@)(@@)(@@)(@@) $ 3056 - سليمان بن قتة مولى بنى تميم من أهل البصرة وكان شاعرا يروى عن بن عباس ومعاوية وعمرو بن العاص روى عنه موسى بن أبي عائشة وعاصم الجحدري(@)(@@)(@@)(@@) $ 3057 - سليمان بن جبير يروي عن أنس بن مالك عداده في أهل البصرة روى عنه ابنه داود بن سليمان(@)(@@)(@@)(@@) $ 3058 - سليمان بن مرثد يروي عن عائشة إن سمع منها روى عنه أبو التياح يزيد بن حميد(@)(@@)(@@)(@@) $ 3059 - سليمان بن أيوب مولى عثمان بن عفان يروي عن أبي هريرة روى 
ms595	 عنه خزرج بن عثمان(@)(@@)(@@)(@@) $ 3060 - سليمان بن يزيد السعدي يروي عن بن مسعود روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 3061 - سليمان بن بأبيه مولى بنى نوفل يروي عن أم سلمة روى عنه بن جريج PageV04P311(@)(@@)(@@)(@@) $ 3062 - سليمان الضبعي يروي عن جابر بن عبد الله روى عنه ثابت البناني(@)(@@)(@@)(@@) $ 3063 - سليمان بن أبي عبد الله أدرك المهاجرين روى عنه يعلى بن حكيم(@)(@@)(@@)(@@) $ 3064 - سليمان الأزرق مولى عبد القيس من أهل البصرة يروي عن أنس بن مالك روى عنه حرمي بن عمارة(@)(@@)(@@)(@@) $ 3065 - سليمان مولى بن البرصاء يروي عن بن عمر روى عنه بن جريج(@)(@@)(@@)(@@) $ 3066 - سليمان المزني يروي عن أبي هريرة روى عنه ابنه العوام بن سليمان(@)(@@)(@@)(@@) $ 3067 - سليمان بن أبي بحر يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه مسلم بن أبي مريم(@)(@@)(@@)(@@) $ 3068 - سليمان بن ذكوان أبو قحذم يروي عن أنس بن مالك روى عنه قحذم بن سليمان ابنه(@)(@@)(@@)(@@) $ 3069 - سليمان بن أبي صالح الهاشمي مولى عقيل بن أبي طالب يروي المراسيل روى عنه سماك بن حرب PageV04P312(@)(@@)(@@)(@@) $ 3070 - سليمان بن بسر الخزاعي يروي عن خاله مالك بن عبد الله الخثعمي وله صحبة روى عنه منصور بن حيان(@)(@@)(@@)(@@) $ 3071 - سليمان بن شرحبيل الجبلاني من أهل جبلة وجبلة رباط لهم بالساحل من أهل الشام كنيته أبو القاسم يروي عن أبي أمامة الباهلي روى عنه حريز بن عثمان(@)(@@)(@@)(@@) $ 3072 - سليمان بن حبيب أبو ثابت المحاربي الدمشقي قاضي هشام بن عبد الملك ولاه عمر بن عبد العزيز القضاء بدمشق يروي عن أبي أمامة الباهلي روى عنه الأوزاعي وعثمان بن أبي العاتكة مات سنة ست وعشرين ومائة بالشام وكان على القضاء ثلاثين سنة بدمشق وقد قيل مات سليمان بن حبيب سنة خمس عشرة ومائة(@)(@@)(@@)(@@) $ 3073 - سليمان بن سنان المزني يروي عن بن عباس وأبي هريرة روى عنه يزيد بن أبي حبيب وجعفر بن ربيعة(@)(@@)(@@)(@@) $ 3074 - أبو المنهال اسمه سليمان بن داود يروي عن بن عباس روى PageV04P313 عنه أيوب السختياني وشعبة بن الحجاج(@)(@@)(@@)(@@) $ 3075 
ms596	 - سليمان بن أبي عبد الله يروي عن صهيب روى عنه يعلى بن حكيم ثنا محمد بن المنذر بن سعيد قال ثنا محمد بن سعيد بن غالب القطان قال ثنا وهب بن جرير بن حازم قال ثنا أبي قال سمعت يعلى بن حكيم يحدث عن سليمان بن أبي عبد الله قال كنا نسأل صهيبا عن حديث رسول الله صلى الله عليه وسلم فيقول لا أحدث عن رسول الله صلى الله عليه وسلم ولكن إن شئتم حدثتكم عن مغازيه وأسفاره(@)(@@)(@@)(@@) $ 3076 - سليمان بن سمرة بن جندب الفزاري يروي عن أبيه روى عنه علي بن ربيعة وحبيب بن سليمان ابنه(@)(@@)(@@)(@@) $ 3077 - سليمان بن زياد الحضرمي من أهل مصر يروي عن عبد الله بن الحارث بن جزء الزبيدي روى عنه ابنه غوث بن سليمان وعمرو بن الحارث(@)(@@)(@@)(@@) $ 3078 - سليمان بن عمرو بن الأحوص يروي عن أبيه ولأبيه صحبة روى عنه يزيد بن أبي زياد وشبيب بن غرقدة(@)(@@)(@@)(@@) $ 3079 - سليمان بن سمير يروي عن أبي أمامة روى عنه حريز بن عثمان PageV04P314 الرحبي وقد قيل سلمان(@)(@@)(@@)(@@) $ 3080 - سليمان بن نشيط أبو داود يروي عن بن الزبير روى عنه أبو عاصم النبيل وقد قيل إنه سليمان بن نسطاس(@)(@@)(@@)(@@) $ 3081 - سليمان بن زيد بن ثابت الأنصاري يروي عن أبيه عداده في أهل المدينة روى الزهري عن أبيه عنه(@)(@@)(@@)(@@) $ 3082 - سليمان بن سلمة الغساني من أهل الشام يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 3083 - سليمان بن سعيد يروي عن أبي هريرة روى عنه موسى بن أبي عائشة(@)(@@)(@@)(@@) $ 3084 - سليمان بن أبى سليمان مولى بن عباس يروي عن أبي هريرة وأبي سعيد الخدري روى عنه قتادة والعوام بن حوشب PageV04P315(@)(@@)(@@)(@@) $ 3085 - سليمان مولى بنى أمية يروي عن أبي هريرة روى عنه عبد الله بن مسلم بن هرمز(@)(@@)(@@)(@@) $ 3086 - سليمان بن عبد الرحمن أبو عمرة أدرك واثلة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 3087 - أبو الهيثم اسمه سليمان بن عمرو بن عبد العتواري 
ms597	 كان يتيما في حجر أبي سعيد الخدري يروي عن أبي سعيد الخدري روى عنه دراج أبو السمح وعبيد الله بن المغيرة بن معيقيب(@)(@@)(@@)(@@) $ 3088 - أبو حازم الأعرج اسمه سلمة بن دينار مولى الأسود بن سفيان المخزومي من أهل المدينة وقد قيل إنه مولى بني ليث بكر بن عبد مناة كان أشقر أحول أصله من فارس وكانت أمه رومية وكان قاض أهل المدينة من عبادهم وزهادهم بعث إليه سليمان بن عبد الملك بالزهري أن يأتي فقال له الزهري أجب الأمير وقال أبو حازم وما لي إليه حاجة فإن كان له حاجة فليأتني يروي عن سهل بن سعد روى عنه مالك والثوري مات سنة خمس وثلاثين ومائة وقد قيل سنة أربعين ومائة PageV04P316(@)(@@)(@@)(@@) $ 3089 - سلمة بن سبرة يروي عن سلمان الفارسي روى عنه شقيق بن سلمة(@)(@@)(@@)(@@) $ 3090 - سلمة بن المجنون أبو عثيمة وقد قيل غنيمة الشيباني من أهل الكوفة يروي عن أبي هريرة روى عنه الثوري وشريك(@)(@@)(@@)(@@) $ 3091 - سلمة الليثي يروي عن أبي هريرة روى عنه ابنه يعقوب بن سلمة ربما أخطأ(@)(@@)(@@)(@@) $ 3092 - سلمة بن صهيبة الهمداني من أهل الكوفة كنيته أبو حذيفة يروى عن بن مسعود وعائشة روى عنه خيثمة وعلي بن الأقمر ورآه أبو إسحاق السبيعي بسجستان وسأله عن صلاة السفر فقال له صل ركعتين حتى ترجع إلى أهلك(@)(@@)(@@)(@@) $ 3093 - سلمة بن فيروز مولى حنظله بن قيس الأنصاري يروي عن بن الزبير روى عنه حنظلة بن عمرو(@)(@@)(@@)(@@) $ 3094 - سلمة بن كهيل الحضرمي من أهل الكوفة يروي عن أبي جحيفة وجندب روى عنه الثوري والأعمش والناس مات يوم عاشوراء سنة إحدى وعشرين ومائة(@)(@@)(@@)(@@) $ 3095 - سلمة بن نبيط بن شريط بن أنس الأشجعي كنيته أبو فراس PageV04P317 يروي عن أبيه وله صحبة روى عنه الثوري وأبو نعيم(@)(@@)(@@)(@@) $ 3096 - سلمة بن شريح يروي عن عبادة بن الصامت روى عنه يزيد بن قوذر(@)(@@)(@@)(@@) $ 3097 - سلمة بن أبي يزيد المدني يروي عن جابر بن عبد الله روى بن المبارك عن عمر بن سلمة بن أبي يزيد عن 
ms598	 أبيه(@)(@@)(@@)(@@) $ 3098 - سلمة بن نباته الحارثي يروي عن أبي ذر روى عنه عاصم بن كليب وهو الذي يقال له سلمة بن نعامة(@)(@@)(@@)(@@) $ 3099 - سلمة بن أبي الطفيل يروي عن على روى عنه محمد بن إبراهيم التيمي وهو الذي يقول فطر سلمة بن الطفيل(@)(@@)(@@)(@@) $ 3100 - سلمة بن عثمان خال مسعر بن كدام عداده في أهل الكوفة يروى عن بن مسعود وأبي موسى روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 3101 - سلمة يروي عن بن عمر روى عنه ابنه سعيد بن سلمة لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 3102 - سلمة بن تمام أبو عبد الله الشقري يروي عن بن عمر روى عنه المنهال بن خليفة(@)(@@)(@@)(@@) $ 3103 - سلمة بن صالح اللخمي عداده في أهل مصر يروي عن علي بن أبي طالب وفضالة بن عبيد روى عنه قباث بن رزين اللخمي PageV04P318(@)(@@)(@@)(@@) $ 3104 - سفيان بن وهب الخولاني عداده في أهل مصر يروي عن عمر روى عنه مسلم بن يسار ويزيد بن أبي حبيب ومن زعم أن له صحبة فقد وهم وهو الذي يروي عن أبي أيوب الأنصاري من حديث بكر بن سوادة عن سفيان بن وهب(@)(@@)(@@)(@@) $ 3105 - سفيان بن الليل يروي عن علي بن أبي طالب روى عنه عطية بن الحارث أبو روق(@)(@@)(@@)(@@) $ 3106 - سفيان بن زياد مولى داود بن فراهيج من فوق يروي عن الزبير بن العوام روى عنه داود بن فراهيج(@)(@@)(@@)(@@) $ 3107 - سفيان بن هانئ أبو سالم الجيشاني يروي المراسيل عداده في أهل مصر روى عنه أهلها(@)(@@)(@@)(@@) $ 3108 - سفيان بن سلمة يروي عن بن عباس روى عنه قتادة(@)(@@)(@@)(@@) $ 3109 - سفيان بن أبي العوجاء السلمي يروي عن أبي شريح الخزاعي روى عنه الحارث بن فضيل(@)(@@)(@@)(@@) $ 3110 - سفيان بن فروة بن مسعود الأسلمي يروي عن سلمة بن الأكوع وبريدة روى عنه ابنه بريدة بن سفيان(@)(@@)(@@)(@@) $ 3111 - سفيان بن زياد الغساني يروي عن أنس روى عنه خالد بن حميد PageV04P319(@)(@@)(@@)(@@) $ 3112 - سفيان بن عوف القاري يروي عن عبد الله بن عمرو روى عنه جندب بن عبد الله 
ms599	(@)(@@)(@@)(@@) $ 3113 - سفيان بن دينار المكي يروي عن بن عمر روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 3114 - سفيان بن مختار يروي عن بن أبي أوفى وهو الذي يقال له سفيان بن أبي حبيبة روى عنه أبو مالك النخعي(@)(@@)(@@)(@@) $ 3115 - سفيان بن يزيد الأزدي يروي عن بن مسعود روى عنه محمد بن سيرين(@)(@@)(@@)(@@) $ 3116 - سفيان بن الحارث يروي عن محمد بن حاطب روى عنه عاصم بن كليب(@)(@@)(@@)(@@) $ 3117 - سفيان العقيلي يروي عن عمر روى عنه قتادة(@)(@@)(@@)(@@) $ 3118 - سفيان بن حبيب يروي عن أبي الدرداء روى عنه أبو شهاب(@)(@@)(@@)(@@) $ 3119 - سفيان بن عقال يروي عن بن عمر روى عنه شيخ يقال له الربيع وقد قيل غفار(@)(@@)(@@)(@@) $ 3120 - سهل بن أبي أمامة بن سهل بن حنيف الأنصاري المدني يروي عن أنس بن مالك روى عنه يزيد بن أبي حبيب وعبد الرحمن بن الشريح PageV04P320(@)(@@)(@@)(@@) $ 3121 - سهل بن أبي حثمة الأنصاري يروي عن علي بن أبي طالب روى عنه ابنه(@)(@@)(@@)(@@) $ 3122 - سهل بن معاذ بن أنس الجهني يروي عن أبيه روى عنه يزيد بن أبي حبيب وزبان بن فائد عداده في أهل مصر لا يعتبر حديثه ما كان من رواية زبان بن فائد عنه(@)(@@)(@@)(@@) $ 3123 - سهل أبو محجن يروي عن عبد الله بن عمرو روى عنه يحيى بن عطاء(@)(@@)(@@)(@@) $ 3124 - سهل أبو الأسد القراري وقرارة قبيلة من اليمن يروي عن بن مسعود روى عنه سليمان بن موسى(@)(@@)(@@)(@@) $ 3125 - سهل بن ثعلبة يروي عن عبد الله بن الحارث بن جزء عداده في أهل مصر روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 3126 - سهل بن حارثة الأنصاري المدني يروي المراسيل روى عنه سعد بن إسحاق بن كعب بن عجرة(@)(@@)(@@)(@@) $ 3127 - سويد بن غفلة بن عوسجة الجعفي المذحجي من أهل الكوفة PageV04P321 كنيته أبو أمية كان يذكر أن مصدق النبي صلى الله عليه وسلم أتاهم وليست له صحبة يروى عن بن مسعود وشهد مع على صفين روى عنه أهل الكوفة مات سنة اثنتين وثمانين وهو بن سبع وعشرين ومائة سنة وكان سويد بن 
ms600	 غفلة يقول أنا لدة رسول الله صلى الله عليه وسلم ولدت عام الفيل حدثنا الحسن بن سفيان قال حدثنا أبو بكر بن أبي شيبة ثنا حسين بن علي الجعفي عن أخيه الوليد بن علي عن أبيه قال كان سويد بن غفلة يؤمنا فيقوم بنا في شهر رمضان وهو بن عشرين ومائة سنة(@)(@@)(@@)(@@) $ 3128 - سويد بن الحارث المرادي الجهني الجملي من أهل الكوفة يروي عن أبي ذر روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 3129 - سويد بن قيس يروي عن معاوية بن حديج عداده في أهل مصر روى عنه يزيد بن أبي حبيب PageV04P322(@)(@@)(@@)(@@) $ 3130 - سويد بن مثعبة الحنظلي قوله روى أبو حيان التيمي عن أبيه عنه وكان من عباد أهل الشام وقرائهم فيمن صبر على الضراء وشكر على السراء إلى أن مات(@)(@@)(@@)(@@) $ 3131 - سويد بن منجوف السدوسي كنيته أبو المنهال والد علي بن سويد بن منجوف عداده في أهل البصرة رأى علي بن أبي طالب روى عنه المسيب بن رافع(@)(@@)(@@)(@@) $ 3132 - سويد بن جهيل الكوفي يروي عن على روى عنه سالم بن أبي الجعد وعبد الملك بن ميسرة(@)(@@)(@@)(@@) $ 3133 - سويد بن يزيد السلمي يروي عن أبي ذر روى عنه الزهري(@)(@@)(@@)(@@) $ 3134 - سويد بن حطان يروي عن عمر روى عنه سماك بن حرب وقد قيل سويد بن الخطاب(@)(@@)(@@)(@@) $ 3135 - سويد بن هبيرة يروي المراسيل روى عنه مسلم بن نذير(@)(@@)(@@)(@@) $ 3136 - سويد غلام سلمان يروي عن سلمان روى عنه الربيع بن أنس PageV04P323(@)(@@)(@@)(@@) $ 3137 - سويد بن عامر بن يزيد بن جارية الأنصاري من أهل المدينة يروي المراسيل وقد سمع الشموس بنت النعمان ولها صحبة روى عنه ابنه عاصم بن سويد ومجمع بن يحيى الأنصاري ثنا أبو يعلى قال ثنا إبراهيم بن الحجاج السامي قال ثنا بن المبارك عن مجمع بن يحيى الأنصاري عن سويد بن عامر قال قال رسول الله صلى الله عليه وسلم بلوا أرحامكم ولو بالسلام(@)(@@)(@@)(@@) $ 3138 - سويد بن حنظلة يروي عن بن مسعود روى عنه أبو سنان(@)(@@)(@@)(@@) $ 3139 - سويد بن سرحان يروي عن 