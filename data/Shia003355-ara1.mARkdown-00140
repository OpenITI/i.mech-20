ms125	 كتاب مفاخرة أهل البصرة وأهل الكوفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ضرب الدراهم والصرف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار اياس بن معاوية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أصحاب الكهف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صلاح المال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطبة واصل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب الاخوان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النحل؟ (كذا) .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المقطعات المتخيرات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن سيرين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرسالة إلى ابن أبي داود.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اخبار المختار).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدينة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المختضرين ومعناه من مات في شبابه.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب معرفة المراقب والرسوم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المراعى والجراد ويحتوي على: الكور، والطساسيح، وجباياتها.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الجوابات). (وله أيضا، كتاب المحاسن، فيه ما يحتاج إليه من الآداب.. عشرة الملوك).(@)(@@)(@@)(@@) $BIO_MAN$ اخبار أحمد بن الحارث الخراز صاحب المدائني(@)(@@) قرأت بخط ابن الكوفي قال: - أبو جعفر أحمد بن الحارث بن المبارك، مولى المنصور. بغدادي كبير الرأس، طويل اللحية كبيرها، حسن الوجه، كبير الفم، الثغ. خضب قبل موته بسنة خضابا قانيا، فسئل عن ذلك، فقال بلغني ان منكرا ونكيرا إذا حضرا ميتا فرأياه خضيبا، قال منكر لنكير تجافا وعنه.(@)(@@) ومن غير خط ابن الكوفي، وكان راوية المدائني والعتابي، ممن أسرى جده للمنصور ليجعل في البوابين وكان يقال له حسان، من سبى اليمامة. وكان احمد شاعرا، فمن شعره: - إني امرؤ لا أرى بالباب أقرعه إذا (تمنع) دوني حاجب الباب ولا ألوم امرءا في ود ذي شرف ولا أطالب ود الكاره الآبي وأكثر شعره بذم الحجاب. وتوفى أحمد بن الحارث في ذي الحجة، سنة ثمان وخمسين ومائتين. وكان منزله بباب الكوفة ودفن في مقابرها. ويقال مات سنة ست وخمسين. وله من الكتب المصنفة:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسالك والممالك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسماء الخلفاء وكناهم والصحابة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مغازي البحر في دولة بنى هاشم وذكر أبى حفص صاحب أقريطش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القبائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاشراف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما نهى النبي (صلى الله عليه وسلم) عنه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبناء السراري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الشعر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختصر كتاب البطون.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مغازي النبي (صلى 
ms126	 الله عليه وسلم) وسراياه وذكر أزواجه.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب جمهرة ولد الحارث بن كعب واخبارهم في الجاهلية).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى العباس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والنوادر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شحنة البريد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسيب.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الحلائب والرهان).(@)(@@)(@@)(@@) $BIO_MAN$ أبو خالد الغنوي(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار غنى وأنسابهم.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الأنساب).(@)PageV00P117(@)(@@)(@@)(@@) $BIO_MAN$ اخبار ابن عبده(@)(@@) (محمد بن عبده بن سليمان بن حاجب العبدي. واسم عبده) عبد الرحمن وعبده لقب. ويكنى عبده أبا عبد الرحمن. ويكنى محمد ابنه بابى بكر. أحد النسابين الثقات. وحسن المعرفة بالمآثر والاخبار وأيام العرب.(@)(@@) وكان متصلا بخدمة السلطان. وتوفى.. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسب الكبير ويحتوي على أنساب القبائل على مثال كتاب هشام الكلبي. وله من غيره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختصر أسماء القبائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الكافي في النسب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناكح آل المهلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب ولد أبى صفرة المهلب وولده.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب معد بن عدنان وقحطان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناقب قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب بنى فقعس بن طريف بن أسد بن خزيمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمهات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب الأخنس بن سريق الثقفي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب كنانة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى جعفر المنصور.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اشراف بكر وتغلب، وفرسانهم وأيامهم ومناقبهم وأحلافهم .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسماء فحول الشعر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشجعاء.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار علان الشعوبي(@)(@@) وهو علان (بن..) الشعوبي، أصله من الفرس. وكان راوية عارفا بالأنساب والمثالب والمنافرات منقطعا إلى البرامكة وينسخ في بيت الحكمة للرشيد والمأمون. وللبرامكة عمل كتاب الميدان في المثالب، الذي هتك فيه العرب وأظهر مثالبها، وكان قد عمل كتابا لم يتمه، سماه الخلبة، انقرض اثره. كذا قرأت بخط ابن شاهين الاخباري. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (الميدان في) المثالب ويحتوي على، مثالب قريش، صناعات قريش وتجاراتها مثالب يتم بن مرة بن كعب، مثالب بنى أسد بن عبد العزى. مثالب بنى مخزوم بن يقظة بن مرة بن كعب (مثالب سهم.(@)(@@) مثالب جمح). مثالب سامة بن لوى. مثالب عبد الدار بن قصي. مثالب ولد زهرة بن كلاب، 
ms127	 مثالب بنى عدى بن كعب. مثالب سعد بن لوى. مثالب الحارث بن لوى. مثالب خزيمة بن لوى. مثالب عوف بن لوى. مثالب عامر بن لوى. مثالب أسد بن خزيمة. مثالب هذيل بن مدركه. مثالب بنى امرؤ القيس بن زيد مناة بن تميم. مثالب بنى طابخة بن الياس. مثالب بنى ضبة بن أد. مثالب مزينة بن أد. مثالب عدى الرباب . مثالب عكل. مثالب بلعم بن يتم. مثالب تميم. عمرو بن تميم. أسد، اللخم. القين. مآرب. الحبط. يربوع. بنو دارم. البراجم . ربيعة الجوع. بنو سعد بن زيد مناة (بن تميم). مثالب قيس عيلان، مثالب غنى. مثالب باهلة. مثالب بنى سليم بن منصور.(@)(@@) مثالب نمير . مثالب عامر بن صعصعة. مثالب فزارة، بنو مرة بن عوف بن غطفان. عبس بن بغيض. ثقيف.(@)(@@) مثالب ربيعة، مثالب عجل بن لجيم. مثالب تغلب بن وائل. مثالب بنى يشكر بن بكر. مثالب المنمر بن قاسط. مثالب.(@)(@@) سدوس بن شيبان. مثالب عنزة بن أسد. مثالب يتم اللات (قاسط) بن ثعلبة. مثالب قيس بن ثعلبة. مثالب حنيفة بن لجيم. مثالب بنى شيبان . مثالب عبد القيس. مثالب أياد (غير مفصل مجمل). مثالب اليمن، الأوس.(@)(@@) الخزرج. قضاعة. طي. بنو الحارث بن كعب. النخع. خزاعة وغسان. كنده. الأشعرون . لخم. جذام، عنس. مراد. السكاسك. القين. نهد. زبيد. بجيلة . همدان. حضرموت. حمير.(@)PageV00P118(@)(@@) ومن كتبة المفردات، كتاب فضائل كنانة كتاب نسب النمر بن قاسط.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب تغلب بن وايل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل ربيعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنافرة.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار محمد بن حبيب(@)(@@) أبو جعفر محمد بن حبيب بن أمية بن عمر . ومن خط السكري، وقال أبو القاسم الحجازي صاحب التاريخ الملحق قال محمد بن عبد الملك وحدثني أبو القاسم عبد العزيز بن عبد الله الهاشمي قال: كان محمد بن حبيب مولى لنا يعنى لبني العباس بن محمد وكانت أمه حبيب مولاة لنا أيضا. ولم يكن حبيب أباه ولكن كانت أمه. قال محمد بن إسحاق : (وكان) من علماء بغداد بالأنساب والاخبار واللغة والشعر والقبائل. وعمل قطعة من 
ms128	 اشعار العرب، روى عن ابن الاعرابي وقطرب وأبى عبيده وأبى اليقظان وغيرهم. وكان مؤدبا. وكتبه صحيحة. وتوفى... وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال على افعل (المنمق).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السعود والعمور .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العمائر والربائل (في النسب).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموشح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المؤتلف والمختلف (في النسب).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المحبر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المقتنى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المشجر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموشا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من استجيب دعوته (بخط ابن الكوفي) كتاب (المذهب في) اخبار الشعراء وطبقاتهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نقائض جرير وعمر بن لجاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نقائض جرير والفرزدق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المفوف .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ الخلفاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من سمى ببيت قاله.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقاتل الفرسان.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب ألقاب الشعراء).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كنى الشعراء .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العقل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السماة .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمهات النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (أيام) جرير التي ذكرها في شعره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمهات أعيان بنى عبد المطلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المقتبس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمهات السبعة من قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحيل بخط ابن الكوفي.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب النبات).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأرحام التي بين رسول الله وبين أصحابه سوى العصبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب اليمن وربيعة ومضر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألقاب ويشتمل على ألقاب القبائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القبائل الكبير والأيام. جمعه للفتح بن خاقان، ورأيت النسخة بعينها عند أبي القاسم بن أبي الخطاب بن الفرات في طلحى، نيف وعشرون جزءا وكانت تنقص، تدل على انها من نحو أربعين جزءا، في كل مائتا ورقة وأكثر. ولهذه النسخة فهرست لما يحتوي عليه من القبائل والأيام بخط السندي بن علي الوراق في طلحى نحو خمسة عشر ورقة بخط نزك انا أذكر جمل ذلك دون تفصيله (انشاء الله).(@)(@@)(@@)(@@) $BIO_MAN$ خلاد بن يزيد الباهلي(@)(@@) أحد الرواة للاخبار والقبائل والاشعار. ولا مصنف له نعرفه.(@)(@@)(@@)(@@) $BIO_MAN$ عمر بن بكير(@)(@@) صاحب الحسن بن سهل. وكان اخباريا، راوية، نسابة. وله عمل الفراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب معاني القرآن. وله(@)PageV00P119 من الكتب، - كتاب يوم الغول، يوم الظهر. يوم 
ms129	 أرمام. يوم الكوفة. غزوة بنى سعد بن زيد مناة.(@)(@@) يوم منابض.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي أويس(@)(@@) أحد الرواة للغة والأنساب والمآثر. ولقى فصحاء الاعراب. وروى عن أبي سهل سعد بن سعيد، من كتاب الحصري في الغريب.(@)(@@)(@@)(@@) $BIO_MAN$ ابن النطاح(@)(@@) أبو عبد الله محمد بن صالح بن النطاح. روى عن الحسن بن ميمون، وهذا الرجل أول من ألف في الدولة واخبارها كتابا وحكى ابن النطاح عن إبراهيم بن ردان بن سنان البصري (حكايات). وكان ابن النطاح اخباريا ناسبا، رواية للسير . وله من الكتب، كتاب أفخاذ العرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البيوتات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على أبى عبيدة في كتاب الديباج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أنساب أزد عمان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل زيد بن علي (عليهما السلام).(@)(@@)(@@)(@@) $BIO_MAN$ سلمويه(@)(@@) بن صالح الليثي، من رواة الاخبار والأنساب. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدولة. روى فيه عن جماعة.(@)(@@)(@@)(@@) $BIO_MAN$ السكوني (@)(@@) واسمه (الحسن بن سعيد) (من النسابين). وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أنساب بنى عبد المطلب، كتاب كبير.(@)(@@)(@@)(@@) $BIO_MAN$ (ابن عبد الحميد الكاتب)(@)(@@) أبو الفضل محمد بن أحمد بن عبد الحميد الكاتب، من أهل السير. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار خلفاء بنى العباس، كبير.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي ثابت الزهري(@)(@@) واسمه عبد العزيز بن عمران الزهري. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاحلاف.(@)(@@)(@@)(@@) $BIO_MAN$ عيينة بن المنهال(@)(@@) ويكنى أبا المنهال. من الرواة للاخبار والأمثال والأنساب. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأبيات السائرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المباينات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال (السائرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السراب).(@)(@@)(@@)(@@) $BIO_MAN$ الروندي(@)(@@) هذا عمل كتاب اخبار الدولة وجود فيه. ورأيت منه شيئا يسيرا. وكان يجلس للروندية، فيقرئونه عليه ويأخذون عنه اخبار الدولة. وله من الكتب، كتاب الدولة، نحو ألفي ورقة.(@)PageV00P120(@)(@@)(@@)(@@) $BIO_MAN$ ابن شبيب(@)(@@) ويكنى أبا سعيد، عبد الله بن شبيب الربعي البصري. من الأخباريين. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والآثار: رواه عنه ثعلب.(@)(@@)(@@)(@@) $BIO_MAN$ الغلابي(@)(@@) وهو أبو عبد الله محمد بن زكريا بن دينار الغلابي، أحد الرواة للسير والاحداث والمغازي وغير ذلك.(@)(@@) وكان ثقة صادقا وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ 
ms130	 كتاب مقتل الحسين بن علي (عليه السلام).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وقعة صفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل أمير المؤمنين (علي عليه السلام).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التوابين وعين الوردة .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأجواد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المبخلين.(@)(@@)(@@)(@@) ||| طائفة أصبنا ذكرهم بخط ابن الكوفي فذكرناهم فيما بعد (وهم)(@)(@@)(@@)(@@) $BIO_MAN$ خراش(@)(@@) بن إسماعيل الشيباني (العجلي) ويكنى بابى وعرا . اخذ عنه محمد بن السايب الكلبي. وهو أحد النسابين.(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ربيعة وأنسابها.(@)(@@)(@@)(@@) $BIO_MAN$ ابن زبالة(@)(@@) اخباري نسابة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدينة واخبارها .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الألقاب).(@)(@@)(@@)(@@) $BIO_MAN$ عبد الله بن أبي سعيد الوراق(@)(@@) (كان اخباريا نسابة راوية للشعر. وله من الكتب، كتاب العربية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الايمان والدعاء والدواهي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدينة واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألقاب).(@)(@@)(@@)(@@) $BIO_MAN$ النصري (@)(@@) وهو الحسن بن ميمون، من بنى نصر بن قعين. وعنه روى محمد بن النطاح وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدولة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المآثر.(@)(@@)(@@)(@@) $BIO_MAN$ خالد بن خداش(@)(@@) بن عجلان ويكنى أبا الهيثم. مولى آل المهلب بن أبي صفرة. وتوفى سنة ثلاث وعشرين ومائتين. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأزارقة وحروب المهلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار آل المهلب.(@)(@@)(@@)(@@) $BIO_MAN$ ابن عابد(@)(@@) ولا يعرف من امره غير هذا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملوك واخبار الأمم.(@)(@@)(@@)(@@) $BIO_MAN$ مغيرة(@)(@@) ابن محمد المهلبي. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناكح (آل) المهلب.(@)PageV00P121(@)(@@)(@@)(@@) $BIO_MAN$ ابن عثام الكلابي (@)(@@) (واسمه بن..). وكان كوفيا في أيام ابن كناسة. وله معه اخبار. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسيب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملح.(@)(@@)(@@)(@@) $BIO_MAN$ أبو المنعم(@)(@@) واسمه... وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات الشعراء.(@)(@@)(@@)(@@) $BIO_MAN$ الخثعمي(@)(@@) واسمه محمد بن عبد الله أو عبد الله بن محمد. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء.(@)(@@)(@@)(@@) $BIO_MAN$ منجوف السدوسي(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العزل .(@)(@@) ومن ولده: غنوية السدوسي واسمه عبيد الله بن الفضل بن سفيان بن منجوف ويكنى أبا محمد، اخباري روى عن أبي عبيدة ومات بعد المائتين. وله من الكتب، 
ms131	(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المآثر والأنساب والأيام .(@)(@@)(@@)(@@) $BIO_MAN$ الوليد بن مسلم(@)(@@) من أصحاب السير والاحداث. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المغازي.(@)(@@)(@@)(@@) $BIO_MAN$ الفاكهي(@)(@@) (وهو..) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مكة واخبارها في الجاهلية والاسلام.(@)(@@)(@@)(@@) $BIO_MAN$ يزيد بن محمد المهلبي(@)(@@) الشاعر. ويمر ذكره وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المهلب واخباره واخبار ولده.(@)(@@)(@@)(@@) $BIO_MAN$ أبو إسحاق(@)(@@) إسماعيل بن عيسى العطار. من أهل بغداد، من أصحاب السير، يروى عنه الحسن علوية القطان وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المبتدأ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حفر زمزم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الردة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفتوح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألوية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفتن.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي طيفور(@)(@@) واسمه محمد بن أحمد الجرجاني، من أهل جرجان. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبواب الخلفاء. ومعناه من كان الخلفاء يأنسون به. ويستسرونه . ويستعقلونه. ويستعضدونه.(@)(@@)(@@)(@@) $BIO_MAN$ ابن تمام الدهقان(@)(@@) وهو ابن الحسين محمد بن علي بن الفضل بن تمام الدهقان. واصله من الكوفة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل الكوفة.(@)PageV00P122(@)(@@)(@@)(@@) $BIO_MAN$ أبو حسان الزيادي(@)(@@) هو أبو حسان الحسن بن عثمان الزيادي. يروى عن الهيثم بن عدي وغيره. وكان قاضيا فاضلا، أديبا ناسبا جوادا كريما. يعمل الكتب، وتعمل له. وكانت له خزانة حسنة كبيرة. وأخذ عن الناس. ومات هو والحسن ابن علي بن أبي الجعد، في وقت واحد سنة ثلاث وأربعين ومائتين وله تسع وثمانون سنة وأشهر. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مغازي عروة بن الزبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآباء والأمهات.(@)(@@)(@@)(@@) $BIO_MAN$ مصعب بن عبد الله الزبيري(@)(@@) أبو عبد الله بن مصعب بن ثابت بن عبد الله بن الزبير بن العوام. حجازي نزل بغداد، راوية، أديب، محدث ، وهو عم الزبير ابن أبي بكر. وكان شاعرا. وكان أبوه عبد الله من أشرار الناس، متحاملا على ولد علي عليه السلام. وخبره مع يحيى بن عبد الله معروف. وتوفى مصعب بن عبد الله يوم الأربعاء ليومين خليا من شوال سنة ست وثلاثين ومائتين وله ست وسبعون سنة. كذا ذكره 
ms132	 ابن أبي خيثمة. وله من الكتب (المصنفة)، كتاب النسب الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب قريش.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار الزبير ابن بكار(@)(@@) أبو عبد الله الزبير بن أبي بكر بكار بن عبد الله بن مصعب بن ثابت بن عبد الله بن الزبير بن العوام. من أهل المدينة ، اخباري النسابين ، وكان شاعرا صدوقا، راوية، نبيل القدر، وولى قضاء مكة، ودخل بغداد عدة دفعات، آخرها سنة ثلاث وخمسين ومائتين. قال محمد بن داود: وكان فتى في شعره ومروته وبطالته مع سنه وعفافه. فمن شعره: - عف الصبى متجمل الصبر يرجو عواقب دولة الدهر جعل المنى سببا لراحته فيما يسكن لوعة الصدر حتى إذا ما الفكر راجعه قطع المنى بتبين الهجر فشكى الضمير إلى جوانحه بعض الذي يلقى من الفكر وتوفى الزبير بمكة وهو قاض عليها. ودفن بها ليلة الاحد لتسع بقين من ذي القعدة سنة ست وخمسين ومائتين، وبلغ من السن أربعا وثمانين سنة. وكان سبب موته انه سقط من سطح له، فانكسرت ترقوته ووركه.(@)(@@) وصلى عليه ابنه مصعب وحضر جنازته محمد بن عيسى بن المنصور. ودفن إلى جانب قبر علي بن عيسى الهاشمي، في مقبرة الحجون. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اخبار العرب وأيامها).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب قريش واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر اخبار النسب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاحلاف .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموفقيات في الاخبار، الفه للموفق .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مزاح النبي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر المدينين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النحل. رايته بخط السكري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العقيق واخباره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار(@)PageV00P123 الأوس والخزرج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وفود النعمان على كسرى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب إغارة كثير على الشعراء. " كتاب اخبار ابن ميادة ".(@)(@@) ومن خط ابن الكوفي، اخبار حسان. اخبار الأحوص. اخبار عمر بن أبي ربيعة. اخبار أبى دهبل، اخبار جميل.(@)(@@) اخبار نصيب. اخبار كثير. اخبار أمية. اخبار العرجي. اخبار أبى السايب. اخبار حاتم. اخبار عبد الرحمن بن حسان اخبار هدبه وزيادة. اخبار توبة وليلى. اخبار ابن هرمة. اخبار المجنون. اخبار الفاري. اخبار ابن الدمينة.(@)(@@) اخبار عبيد الله بن قيس الرقيات. " اخبار أشعث 
ms133	 ".(@)(@@)~:section: تسمية من روى عنه الزبير من خط ابن الكوفي(@)(@@) روى عن عمه مصعب بن عبد الله. ومحمد بن الحسن المخزومي. ومحمد بن الضحاك بن عثمان. و مسلم بن عبد الله بن مسلم بن جندب. وإبراهيم بن المنذر ويحيى بن محمد بن عبد الله بن ثوبان. وعبد الملك بن عبد العزيز. ويعقوب بن إسحاق الربعي. وعثمان بن عبد الرحمن. وبكار بن رباح. ومسلمة بن إبراهيم بن هشام (المخزومي). وعبد العزيز بن عبد الله (الأويسي). ومحمد بن إسماعيل بن إبراهيم بن عبد الحميد. وحميد بن عبد العزيز الزهري. وعبد الجبار بن سعيد بن (سليمان) بن نوفل بن مساحق. ومؤمن بن عمر بن أفلح. وعلي بن المغيرة. وعبد الله بن نافع بن ثابت.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار الجهمي(@)(@@) أبو عبد الله أحمد بن محمد بن حميد بن سليمان بن عبد الله بن أبي جهم بن حذيفة العدوي، من بنى عدى بن كعب ويعرف بالجهمي، ينسب إلى جده أبى الجهم بن حذيفة. حجازي دخل العراق وبها تعلم. وكان أديبا، راوية، شاعرا مغنيا ويذكر النسب والمثالب وتناول جلة الناس. وله في ذلك كتب. قال محمد بن داود.(@)(@@) حدثني سوار بن أبي شراعة قال: وقع بينه وبين قوم من العمريين والعثمانيين شر، فذكر سلفهم بأقبح ذكر، فقال له بعض الهاشميين في ذلك، فذكر العباس بأمر عظيم، فأنهى خبره إلى المتوكل، فامر بضربه مائة سوط. فضربه إياها إبراهيم بن إسحاق بن إبراهيم، فلما فرغ من ضربه، قال فيه: - تبرا الكلوم وينبت الشعر ولكل مورد محنة صدر واللوم في أثواب منبطح لعبيده ما أورق الشجر وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أنساب قريش واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعصومين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المثالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الانتصار في الرد على الشعوبية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل مضر .(@)(@@)(@@)(@@) $BIO_MAN$ الأزرقي(@)(@@) واسمه محمد بن عبد الله بن أحمد بن محمد بن الوليد بن عقبة بن الأزرق. واسمه عثمان بن عمرو بن الحارث بن أبي شمر بن عمر بن عوف بن الحارث بن ربيعة بن حارثة بن الحارث بن 
ms134	 ثعلبة العلقاء بن جفنه بن عمرو بن عامر مزيقيا.(@)PageV00P124(@)(@@) هذا من خط ابن الكوفي، أحد الأخباريين وأصحاب السير. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مكة واخبارها وجبالها و أوديتها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كبير.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار عمر بن شبه(@)(@@) أبو زيد عمر بن شبه بن عبيد بن ريطة . وشبه اسمه زيد ويكنى أبا معاذ قال: عمر وانما سمى أبى شبه لان أمه كانت ترقصه وتقول، يا بابى وشبا وعاش حتى دبا شيخا كبيرا خبا وكان عمر بصريا، مولى لبني نمير، شاعرا، اخباريا، فقيها. صادق اللهجة، غير مدخول الرواية فمن شعره، وقائلة لم يبق في الناس سيد فقلت بلى عبد الرحيم بن جعفر وكان ابنه أبو طاهر أحمد بن عمر بن شبة، شاعرا ظريفا مجيدا، راوية. ومات بعد أبيه بنحو عشر سنين ومن شعر أبى طاهر، نظرت فلم أر في العسكر كشؤمي وشؤم أبى جعفر غدا الناس للعيد في زينة من النور في منظر أزهر ويغدو عليهم بلا أهبة فرارا من المنزل المقفر فيقعد للشؤم في عزلة من الناس ينظر في دفتر ومات عمر بن شبة بسرمرى، يوم الاثنين لست بقين من جمادى الآخرة سنة اثنتين وستين ومائتين وبلغ من السن تسعين سنة. وصارت كتبه إلى أبى الحسن على بي يحيى، اتباعها من أبى طاهر بن عمر بن شبة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الكوفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البصرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدينة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمراء الكوفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمراء البصرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمراء المدينة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمراء مكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السلطان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل عثمان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الكتاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء كتاب الأغاني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التاريخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار المنصور.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب محمد وإبراهيم ابني عبد الله بن حسن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اشعار الشراة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النسب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن نمير .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما استعجم الناس فيه من القرآن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاستعانة بالشعر وما جاء في اللغات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاستعظام للنحو ومن كان يلحن من النحويين.(@)(@@)~:sectiopn: تسمية من روى عنه 
ms135	 عمر(@)(@@) روى عن أبي عاصم النبيل. ومحمد بن سلام الجمحي. وهارون بن عبد الله. وإبراهيم بن المنذر.(@)(@@)(@@)(@@) $BIO_MAN$ البلاذري(@)(@@) أبو جعفر أحمد بن يحيى بن جابر البلاذري. وقيل يكنى أبا الحسن، من أهل بغداد. وكان جده جابر يكتب للخصيب صاحب مصر. وكان شاعرا راوية، وسوس اخر أيامه، فشد في البيمارستان، ومات فيه. وسبب وسوسته انه شرب تمر البلاذر على غير معرفة، فلحقه ما لحقه. وكان يهجو كثيرا وتناول وهب بن سليمان لما ضرط،(@)PageV00P125 فمزقه. فمن قوله فيه وكانت للضرطة بحضرة عبيد الله بن يحيى بن خاقان:(@)(@@) أيا ضرطة حسبت رعدة تنوق في سلها جهده تقدم وهب بها سابقا وصلى أخو صاعد بعده لقد هتك الله ستريهما كذي كل من يطعم الفهده وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البلدان الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البلدان الكبير، ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والأنساب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهد أردشير ترجمه بشعر. وكان أحد النقله من الفارسي إلى اللسان العربي.(@)(@@)(@@)(@@) $BIO_MAN$ الطلحي(@)(@@) أبو إسحاق طلحة بن عبيد الله بن محمد بن إسماعيل بن إبراهيم بن محمد بن طلحة بن عبيد الله التيمي، من أهل البصرة ، ونادم الموفق. وكان راوية اخباريا. وتوفى ليلة الاحد للنصف من ذي الحجة سنة إحدى وتسعين و مائتين. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المتيمين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جواهر الاخبار.(@)(@@)(@@)(@@) $BIO_MAN$ ابن الأزهر(@)(@@) ومن الأخباريين، (أبو) جعفر محمد بن الأزهر بن عيسى الاخباري. ومولده سنة مائتين وتوفى سنة تسع وسبعين ومائتين. وله تسع وسبعون سنة. وسمع من ابن الاعرابي وغيره. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التاريخ وهو من خيار الكتب.(@)(@@)(@@)(@@) $BIO_MAN$ محمد ابن سلام(@)(@@) أبو عبد الله محمد بن سلام الجمحي، أحد الأخباريين والرواة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفاضل في ملح الاخبار والاشعار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيوتات العرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات الشعراء الجاهليين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات الشعراء الاسلاميين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحلاب واجراء الخيل.(@)(@@)(@@)(@@) $BIO_MAN$ أبو خليفة الفضل(@)(@@) أبو خليفة الفضل بن الحباب بن محمد بن شعيب بن صخر الجمحي البصري. من بنى جمح (وكان أعمى).(@)(@@) وولى 
ms136	 قضاء البصرة، من رواة الاخبار والاشعار والأنساب (روى عن محمد بن سلام الجمحي، قرأت بخط الاحد في منزله. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب طبقات الشعراء الجاهليين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرسان).(@)(@@)(@@)(@@) ||| ومن الأخباريين(@)(@@) أبو العباس عبد الله بن إسحاق بن سلام المكاري . وكان حسن العلم بالغريب والفقه، والآثار، والشعر، صدوقا شاعرا. فمن شعره:(@)(@@) يا نقمة الله حلى في ثرا ملك لا يصلح الدين والدنيا بقيراط (@)PageV00P126 (وليس ينفذ أمرا في رعيته حتى يشاور فيها بنت بقراط) يعنى قبيحة أم المعتز. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والأنساب والسير. رأيت بعضه، ولم أره كاملا.(@)(@@)(@@)(@@) $BIO_MAN$ ابن الأشعث(@)(@@) عزيز بن الفضل بن فضالة بن مخراق بن عبد الرحمن بن عبيد الله بن مخراق. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفات الجبال والأودية وأسمائها بمكة وما وراها .(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي شيخ(@)(@@) واسمه سليمان ويكنى أبا أيوب. أخباري راوية، لقى جلة الناس وأخذ عنه أصحاب الاخبار. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار المسموعة. روايته .(@)(@@)(@@)(@@) $BIO_MAN$ وكيع القاضي(@)(@@) أبو بكر محمد بن خلف بن حيان بن صدقة المعروف بوكيع القاضي. وكان مفتنا في جميع الآداب.(@)(@@) وولى القضاء ببعض النواحي. وكان أولا يكتب لأبي (عمر) محمد بن يوسف بن يعقوب القاضي. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أخبار القضاة وتاريخهم وأحكامهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشريف. يجرى مجرى المعارف لابن قتيبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الغرر أخبار .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسافر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطريق ويعرف أيضا بالنواحي، ويحتوي على، أخبار البلدان ومسالك الطريق ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الصرف والنقد والسكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البحث.(@)(@@)(@@)(@@) $BIO_MAN$ أبو الحسن النسابة(@)(@@) واسمه محمد بن القاسم التميمي، من أهل البصرة. وأحد العلماء بالأنساب (ويحيا) إلى زماننا هذا.(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنساب والاخبار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أخبار الفرس وأنسابها.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب تاريخ سائر الأمم).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب المنافرات بين القبائل وأشراف العشائر وأقضية الحكام بينهم في ذلك).(@)(@@)(@@)(@@) $BIO_MAN$ الأشناني القاضي(@)(@@) وهو أبو الحسين عمر بن الحسن بن مالك الشيباني. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل زيد بن علي (عليهما 
ms137	 السلام).(@)(@@) (كتاب الخيل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضايل أمير المؤمنين علي بن أبي طالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل الحسن بن علي عليهما السلام).(@)(@@)(@@)(@@) $BIO_MAN$ أبو الحسين بن أبي عمر(@)(@@) محمد بن يوسف. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث (كبير). ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرج بعد الشدة.(@)(@@)(@@)(@@) $BIO_MAN$ أبو الفرج (بن) الأصبهاني(@)(@@) وهو علي بن الحسين بن (محمد بن) الهيثم القرشي، من ولد هشام بن عبد الملك. وكان شاعرا، مصنفا(@)PageV00P127 أديبا. وله رواية يسيرة. وأكثر تعويله كان في تصنيفه على الكتب المنسوبة الخطوط، وغيرها من الأصول الجياد.(@)(@@) وتوفى (سنة نيف وستين وثلثمائة). وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأغاني الكبير، نحو خمسة الف ورقة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مجرد الأغاني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اشعار الإماء والمماليك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحمادين .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الديارات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفة هارون.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب نسب بنى عبد شمس ملحق بخط المصنف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القيان ملحق).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مقاتل آل أبي طالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفضيل ذي الحجة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والنوادر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب السماع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الطفيليين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب الغرباء من أهل الفضل والأدب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مجموع الآثار والاخبار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرق والمعيار. وهي رسالة في هارون بن المنجم بين الأوغاد والأحرار).(@)(@@)(@@)(@@) $BIO_MAN$ الجلودي(@)(@@) وهو أبو أحمد عبد العزيز بن يحيى الجلودي، من أهل البصرة. أخباري. صاحب سير وروايات .(@)(@@) وتوفى بعد الثلاثين وثلثمائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أخبار خالد بن صفوان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار العجاج ورؤبة بن العجاج .(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مجموع قرائة أمير المؤمنين علي بن أبي طالب).(@)PageV00P128(@)(@@) بسم الله الرحمن الرحيم(@)(@@) (وما توفيقي الا بالله)(@)(@@)(@@)(@@) || الفن الثاني من المقالة الثالثة ويحتوي على اخبار الملوك والكتاب والخطباء والمترسلين وعمال الخراج (وأصحاب الدواوين) (وأسماء كتبهم)(@)(@@)(@@)(@@) $BIO_MAN$ اخبار (إبراهيم بن المهدى)(@)(@@) إبراهيم بن المهدى بن المنصور بن محمد بن علي بن عبد الله بن عباس بن عبد المطلب. أول نابغ نبغ من بنى العباس ثم أولاد الخلفاء (له) ترسل وشعر، وصنف كتابا . وأمه شكلة أصلها من طبرستان. وقيل إنها ابنة ملك طبرستان. 
ms138	 وكان اسود حنك السواد، عظيم الجثة عالي الخلق ولم ير في أولاد الخلفاء قبله أفصح منه ولا اشعر. وله مع ذلك صنعة في الغناء، يتقدم فيها كل أحد. وكان اسحق وإبراهيم بعده يأخذون عنه ويتحاكم المغنون إليه في صناعتهم. ومولده.. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب إبراهيم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطيب (كتاب الغناء).(@)(@@)(@@)(@@) $BIO_MAN$ المأمون(@)(@@) وهو عبد الله بن هارون بن المهدى بن المنصور بن محمد بن علي بن عبد الله بن العباس بن عبد المطلب. اعلم الفقهاء بالفقه والكلام. وكان دون محمد بن زبيدة أخيه في الفصاحة. ونحن نستغني بشهرة اخباره عن استقصاء ذكره. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جواب ملك البرغر فيما سئل عنه من أمور الاسلام والتوحيد. (رسالته في حجج مناقب الخلفاء بعد النبي صلى الله عليه وسلم. رسالته في اعلام النبوة).(@)(@@)(@@)(@@) $BIO_MAN$ ابن المعتز(@)(@@) عبد الله بن المعتز بن المتوكل بن المعتصم بن الرشيد بن المهدى. واحد دهره في الأدب والشعر. وكان يقصده فصحاء الاعراب ويأخذ عنهم. ولقى العلماء من النحويين والأخباريين، كثير السماع، (غزير) الرواية.(@)PageV00P129(@)(@@) وأمره (أيضا) أشهر من أن يستقصى. وألف كتبا كثيرة منها، كتاب الزهر والرياض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البديع.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مكاتبات الاخوان بالشعر).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجوارح والصيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السرقات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اشعار الملوك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلى الأخيار.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب طبقات الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجامع في الغناء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أرجوزته في ذم الصبوح).(@)(@@)(@@)(@@) $BIO_MAN$ أبو دلف(@)(@@) أبو دلف القاسم بن عيسى بن معقل بن إدريس العجلي. سيد قومه، أمير، أحد الأدباء الفضلاء والشعراء المجودين. وله صنعة في الغناء وأمره مشهور. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البزاة والصيد.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب السلاح).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النزه (كتاب سياسة الملوك).(@)(@@)(@@)(@@) $BIO_MAN$ الفتح بن خاقان(@)(@@) الفتح بن خاقان بن أحمد، في نهاية الذكاء والفطنة وحسن الأدب. من أولاد الملوك، اتخذه المتوكل أخا وكان يقدمه على سائر ولده وأهله. وكان له خزانة جمعها (له) علي بن يحيى المنجم: لم ير أعظم منها كثرة 
ms139	 و حسنا وكان يحضر داره فصحاء الاعراب وعلماء الكوفيين والبصريين. قال أبو هفان: ثلاثة لم أر قط ولا سمعت أحب إليهم من الكتب والعلوم، الجاحظ، والفتح بن خاقان، وإسماعيل بن إسحاق القاضي. فأما الجاحظ، فإنه لم يقع بيده كتاب قط إلا استوفى قراءته كائنا ما كان، حتى أنه كان يكترى دكاكين الوراقين ويبيت فيها للنظر.(@)(@@) والفتح بن خاقان، فإنه كان يحضر لمجالسة المتوكل فإذا أراد القيام لحاجة اخرج كتابا من كمه أو خفه وقرأه في مجلس المتوكل وإلى عوده إليه، حتى في الخلاء. واما إسماعيل بن إسحاق، فإني ما دخلت إليه إلا رايته ينظر في كتاب أو يقلب كتبا، أو ينفضها. وتوفى الفتح في الليلة التي قتل فيها المتوكل. قتلا معه بالسيوف . وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البستان. منسوب إليه، والذي ألفه (له) رجل يعرف بمحمد بن عبد ربه ويقلب برأس البغل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اختلاف الملوك).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الصيد والجارح.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الروضة والزهر).(@)(@@)(@@)(@@) ||| آل طاهر(@)(@@)(@@)(@@) $BIO_MAN$ (@)(@@) كان عبد الله بن طاهر شاعرا مترسلا بليغا وكذلك أبوه طاهر بن الحسين ولكل واحد منهما مجموع رسائل. (ورسالة طاهر بن الحسين إلى المأمون عند فتح بغداد مشهورة وهي حسنة).(@)(@@)(@@)(@@) $BIO_MAN$ منصور بن طلحة(@)(@@) ابن طاهر بن الحسين. وكان عبد الله بن طاهر يسميه حكيم آل طاهر ويعجب به الاعجاب كله. وكان يلي مرو وأمل، (وذمر) وخوارزم. وله في الفلسفة كتب مشهورة منها، كتاب المؤنس في الموسيقى. قرأه الكندي فقال: هو مؤنس كما سماه صاحبه. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الإبانة عن أفعال الفلك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الوجود.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في العدد والمعدودات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدليل والاستدلال.(@)PageV00P130(@)(@@)(@@)(@@) $BIO_MAN$ عبيد الله بن عبد الله(@)(@@) (بن) طاهر. وكان شاعرا مترسلا أميرا ولى الشرطة خلافه محمد بن عبد الله بن طاهر ببغداد.(@)(@@) وكان سيدا واليه انتهت رياسة أهله وهو آخر من مات منهم رئيسا. وله من الكتب، كتاب الإشارة في اختيار الشعر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في السياسة الملوكية.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مراسلاته لعبد الله بن المعتز.(@)(@@)(@@)(@@) $DIC_BIB$ 
ms140	 كتاب البراعة والفصاحة).(@)(@@)(@@)(@@) ||| الكتاب وأبناء جنسهم (@)(@@)(@@)(@@) |||| تسمية الكتاب المترسلين ممن لرسائله كتاب مجموع(@)(@@)(@@)(@@) $BIO_MAN$ عبد الحميد بن يحيى(@)(@@) كاتب مروان بن محمد. وكان أولا معلم صبية ينتقل في البلدان. وعنه اخذ المترسلون ولطريقته لزموا.(@)(@@) وهو الذي سهل سبيل البلاغة في الترسل ، واحد دهره. وكان من أهل الشام من مدينة... ولرسائله مجموع نحو الف ورقه.(@)(@@)(@@)(@@) $BIO_MAN$ غيلان أبو مروان(@)(@@) واسمه... وقد استقصيت خبره في مقالة المتكلمين في اخبار المرجئة ولرسائله مجموع نحو ألفي ورقة.(@)(@@)(@@)(@@) $BIO_MAN$ سالم(@)(@@) ويكنى أبا العلاء. كاتب هشام بن عبد الملك وكان ختن عبد الحميد وكان أحد الفصحاء البلغاء وقد نقل من رسائل أرسطاليس إلى الإسكندر (أو) نقل له وأصلح هو. وله رسائل مجموع نحو مائة ورقة.(@)(@@)(@@)(@@) $BIO_MAN$ عبد الوهاب بن علي(@)(@@) وكان يكتب لبلال بن أبي بردة بن أبي موسى الأشعري. أحد البلغاء والفصحاء ورسائله قليلة.(@)(@@)(@@)(@@) $BIO_MAN$ خالد بن ربيعه الإفريقي(@)(@@) مترسل بليغ (لحق الدولتين) (نشأ في الدواوين). وله رسائل مجموعة نحو مائتي ورقة.(@)(@@)(@@)(@@) $BIO_MAN$ يحيى ومحمد ابنا زياد الحارثيان (@)(@@) من ولد الحارث بن كعب. شاعران، مترسلان، بليغان. ولهما رسائل مجموعة.(@)(@@)(@@)(@@) $BIO_MAN$ عمارة بن حمزة(@)(@@) كاتب أبى جعفر المنصور ومولاه. وكان تايها، معجبا، كريما، بليغا، فصيحا أعور. وكان أبو جعفر والمهدى يقدمانه ويحتملان أخلاقه لفضله وبلاغته ووجوب حقه. وولى لهما الأعمال الكبار. وله رسائل مجموعة من جملتها رسالة الخميس التي تقرأ لبني العباس .(@)PageV00P131(@)(@@)(@@)(@@) $BIO_MAN$ جبل بن يزيد (@)(@@) كاتب عمارة بن حمزة وكان مترجما. من معدودي البلغاء والبرعاء.(@)(@@)(@@)(@@) $BIO_MAN$ محمد بن حجر(@)(@@) ابن سليمان وكان حجر من أهل حران، وكان بليغا يكاتب ولاة أرمينية والشام عن نفسه وله كتب مدونة.(@)(@@)(@@)(@@) $BIO_MAN$ كاتب العباس (@)(@@) بن محمد بن (علي بن) عبد الله. بليغ مترسل. واصله من الأنبار. وله رسائل مجموع.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار عبد الله بن المقفع(@)(@@) واسمه بالفارسية روزبه. وهو عبد الله بن المقفع ويكنى قبل اسلامه أبا عمرو، فلما أسلم اكتنى بابى محمد، والمقفع ابن المبارك وانما تقفع لان الحجاج بن يوسف ضربه بالبصرة في مال احتجنه من مال 