ms901	 PageV1P419(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 اگر هرکس نماید میش را در عید قربانی %~% منت قربان نمایم خویش را ای عید روحانی(@)(@@) 2 نه‌کی قربان‌کنم خویشت همان قربان‌کنم میشت %~% از این معنی که در پیشت کم از میشم به نادانی(@)(@@) 3 نه مپذیر از من ای جانان ‌که جانداری‌کنم بیجان %~% بهل خود را کنم قربان که برهم زین ‌گران‌جانی(@)(@@) 4 به‌گیسویت‌که از سویت به دیگرسو نتابم رخ %~% گرم صد بار چون‌گیسو به‌گرد سر بگردانی(@)(@@) 5 مرا چشمیست اشک‌افشان بر او سا زلف مشک‌افشان %~% که من اشکی بیفشانم تو هم مشکی بیفشانی(@)(@@) 6 شبی پرسیدم از دلبر چه فن در عاشقی خوشتر %~% فشاند آن زلف چون عنبر به رخ یعنی پریشانی(@)(@@) 7 به خاموشی زبانها هست رندان قلندر را %~% سراپا چون صدف شو گوش تا بعنی درافشانی(@)(@@) 8 قلم در دست‌ کاتب‌ گر نماید ناله حق دارد %~% که خلقش لال می‌دانند با آن نطق پنهانی(@)(@@) 9 اگر خواهد دلت از ذوق‌گمنامی خبر یابد %~% چو عارف داغ بر دل نه نه چون زاهد به پیشانی(@)(@@) 10 مرا پیری خراباتی شبی‌گفت از نکوذاتی %~% که‌ای‌طفل مناجاتی چه‌می‌گویی چه می‌خوانی(@)(@@) 11 همی الله می‌گویی مگرگمگشته می‌جویی %~% منم مقصد چه می‌پویی منم منزل چه می‌رانی(@)(@@) 12 تراکی‌گفت پیغمبرکه یاالله‌کن از بر %~% ترا گفت از همه بگذر که یاالله را دانی(@)(@@) 13 نگفتت‌کل شی‌ هالک الا وجهه یزدان %~% تو تازی‌خوانی آخر از چه فهم لفظ نتوانی(@)(@@) 14 تو سر تا پا همه بیمی ‌گرفتار زر و سیمی %~% ز شوق سیم تسلیمی به نزد عالم فانی(@)(@@) 15 به ذیل قدرت داور تشبث جوی چون حیدر %~% که نتوان‌ کند از خیبر در از نیروی جسمانی(@)(@@) 16 دلی آور به ‌کف صافی ‌کت آید در زمان‌ کافی %~% چو دونان چند می‌لافی به حکمتهای یونانی(@)(@@) 17 روان یک آرزو دارد زبان آن را دو پندارد %~% نه بل یک را دو انگارد به عبرانی و سریانی(@)(@@) 18 اگر لب‌تشنه‌یی رو آب پیداکن ترا زین چه 
ms902	 %~% که ترکش سو همی خواند عجم او هندیان پانی(@)(@@) 19 همین خاکست کاو را طبع هر دم رنگ رنگ آرد %~% گهی رمان لعلی سازد و گه لعل رمانی(@)(@@) 20 همن خاکست ‌کز وی قوت سازد باز از آن نطفه %~% وزان انسان وزانسان اینهمه تسویل نفسانی(@)(@@) 21 گل و بلبل ز یک خاکندکاو دلبر شد آن عاشق %~% شوند ار خاک‌باز از یکدگرشان فرق نتوانی(@)(@@) 22 همه آیینه‌رویان جمله از خاکند سرتاسر %~% هم از رندی بود کاین‌ خاک خود را خوانده ظلمانی(@)(@@) 23 بود آب حیات این نقش و صورتهای جان‌پرور %~% که در ظلمات خاکی‌ کرده پنهان صنع سبحانی(@)(@@) 24 مرا زین حقه‌بازی همت آن پیرکرد آگه %~% که چون طفلان نگردم ‌گرد سالوسات لامانی(@)(@@) 25 دریغا دیر دانستم‌که دانایی زیان دارد %~% پریشان‌خاطرم تا روز محشر زین پشیمانی(@)(@@) 26 چو سوسن پیش ازین از ذکر سرتاپا زبان بودم %~% کنون از فکر چون نرگس همه چشمم ز حیرانی(@)(@@) 27 به رشته آه چون غم راز دل بیرون ‌کشم ‌گویی %~% که بیژن رابرون آرد ز چه‌گرد سجستانی(@)(@@) 28 مرا زین ‌تن‌د‌رستی هر زمان سستی پدید آ‌ید %~% ازین ارکان ترکیبی وزین طبع هیولانی(@)(@@) 29 چو باشد میل دستارم‌ که پرگردد پرستارم %~% بهل دردی به‌دست آرم ‌که برهم زین تن‌آسانی(@)(@@) 30 چو از دستار سنگینم نگردد کار رنگینم %~% چرا بر سر گذارم‌ گنبد قابوس جرجانی(@)(@@) 31 گر این هشیاری و مستی بود مقصود ازین هستی %~% خود این هستی بدین پستی به مستی باد ارزانی(@)(@@) 32 شوم زین پس مگر چاه زنخدانی به‌دست آرم %~% که در وی چون علی‌ گویم بسی اسرار پنهانی(@)(@@) 33 کس این اسرار را گوید اگر با خواجه اعظم %~% به شکرخنده‌گوید تنگدل‌گشتست قاآنی(@)(@@) 34 بلی چون سینه تنگ آید جنون با دل به جنگ آید %~% سخنها رنگ رنگ آید ز حکمتهای لقمانی(@)(@@) 35 به حمدالله به دارالضرب جان بس نقدها دارم %~% که ضراب ازلشان سکه زد زالقاب سلطانی(@)(@@) 36 اگر نه طفل ابجدخوان چو 
ms903	 حزم او بود گردون %~% چرا خم‌گشته می‌جنبند چو طفلان دبستانی(@)(@@) 37 شفاعت‌گرکند ابلیس را روز جزا عفوش %~% گمان دارم‌که برهاندش از آن آلوده‌دامانی(@)(@@) 38 حدیث از فتنه در عهدش نمی‌گویند دانایان %~% مگر گاهی که بستایند نرگس را به فتانی(@)(@@) 39 هزاران در هزاران توپ دارد اژدها پیکر %~% که دوزخ از دهان بارند گاه آتش افشانی(@)(@@) 40 سیه‌موران خورند و سرخ‌ماران افکنند از دم %~% شهودی بین هلا علم تناسخ را نه برهانی(@)(@@) 41 تو پنداری‌که از نسل عصای موسیند آنان %~% که دفع سحر را ظاهرکنند اشکال ثعبانی(@)(@@) 42 اسان قورخانه او بود چندان‌که در دنیا %~% شد آمد وهم را مشکل شدست از تنگ میدانی(@)(@@) 43 الا شاه ملک طینت ‌که می‌بتوانی از قدرت %~% دوگیتی را بدین وسعت به یک ارزن بگنجانی(@)(@@) 44 هرآن دهقان‌که جوکارد اگر جودت بهاد آرد %~% ز هریک دانه بردارد دوصد لولوی عمانی PageV1P420(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ترک سیه‌چشم سراپا همه جانی %~% تنها نه همین جان منی جان جهانی(@)(@@) 2 با ما به ازین باش از آنرو که در آفاق %~% آن چیز که هست از همه بهتر تو همانی(@)(@@) 3 دنیا کند از فضل و شرف فخر به عقبی %~% تا حسن تو باقیست درین عالم فانی(@)(@@) 4 امروز تویی دشمن مردم به حقیقت %~% کاشوب تن و شور دل و آفت جانی(@)(@@) 5 سروی نه‌گلی نه ملکی نه قمری نه %~% آنقدر نکویی‌که ندانم به چه مانی(@)(@@) 6 مسکین‌ دلم از یاد تو بیرون نرود هیچ %~% کاش این دل سودازده از من بستانی(@)(@@) 7 گر غایبی از من چه شکایت‌کنم از تو %~% تو مردمک چشم از آنروی نهانی(@)(@@) 8 یاد آیدت آن روز که ‌گفتم به تو در باغ %~% بنشین برگل‌کاتش بلبل بنشانی(@)(@@) 9 گفتی‌که من و باغ‌کدامیم نکوتر %~% گفتم تو بهر زانکه تو ایمن ز خزانی(@)(@@) 10 گفتی چه خوشم آید ازین سرو ستاده %~% گفتم ز تو من خوشترم آید که روانی(@)(@@) 11 از بس که دل و جان 
ms904	 به سر زلف تو آویخت %~% زلفت دگر از باد نجنبد زگرانی(@)(@@) 12 تل سمنی بینم از آن موی میانت %~% باریک‌خیالی نگر و چرب‌زبانی(@)(@@) 13 جز عکس رخ خوب تو در آینه و آب %~% حسن تو ندارد به جهان ثالث و ثانی(@)(@@) 14 پرسی همی از من که گل سرخ کدام است %~% جانا توگل سرخ تصور نتوانی(@)(@@) 15 کانجا که تویی رنگ‌ گل سرخ شود زرد %~% اینست‌که هرگز تو گل سرخ ندانی(@)(@@) 16 دانی‌که چرا دارمت اینگونه همی دوست %~% زآنروی‌که چون بخت خداوند جهانی(@)(@@) 17 فرمانده ملک جم و فرمانبر خسرو %~% کز خنجر او رشک برد برق یمانی(@)(@@) 18 سالار ظفرمند عدوبند حسین خان %~% کز نعمت اوبهره برد قاصی و دانی(@)(@@) 19 آن صدر فلک‌قدر که در مطبخ جودش %~% افلاک قدورند و مه و مهر اوانی(@)(@@) 20 خدمتگر جاهش چه اکابر چه اصاغر %~% روزی‌خور خوانش چه اعالی چه ادانی(@)(@@) 21 ای طفل هنر را دل وقاد تو دایه %~% وی کاخ کرم را کف فیاض تو بانی(@)(@@) 22 گر خلد نهم خوانمت از خلق همینی %~% ور چرخ دهم دانمت از قدر همانی(@)(@@) 23 از فخر در ایوان سخا صدرنشینی %~% وز تیغ به میدان وغا فتنه نشانی(@)(@@) 24 چو جان که به ‌پیرامنش از جسم حصارست %~% محصور زمین‌استی و سالار زمانی(@)(@@) 25 هرچند به یک شبر میانست ترا جای %~% از جاه بر از حوصله‌کون و مکانی(@)(@@) 26 ‌گیتی مگر از حق ز پی فخر نشان خواست %~% کز فخر تو بر پیکر آفاق نشانی(@)(@@) 27 مختار همه خلقی و مجبور سخایی %~% منشار سر خصمی و منشور امانی(@)(@@) 28 بستان امل را به سخا ابر بهاری %~% پالیز اجل را به وغا باد خزانی(@)(@@) 29 باکجروشان بسکه بدی ظن من اینست %~% کایدون به فلک دشمن برج سرطانی(@)(@@) 30 بیند ز پی بذل‌کرم دیده حزمت %~% ناگفته ز دل صورت آمال و امانی(@)(@@) 31 از شوق مدیح تو چو حمام زنانست %~% مغز سرم از غلغله جوش معانی(@)(@@) 32 
