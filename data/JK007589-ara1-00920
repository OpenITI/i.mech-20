ms901	 التكاليف يثقل % 9(@)(@@) % ولهذا تجيبني حين أدعو % % غير معتاصة فأعلو وتسفل % 10(@)(@@) % كل حب تعمل وهوى الحس % % ناء إياي من خلاف التعمل % PageV01P3555 11(@)(@@) % ومتى طاوعت فذاك طباع % ومتى مانعت فذاك تدلل % 12(@)(@@) % وعليها تجمل فإذا ما % % عاينتني فما عليها تجمل % 13(@)(@@) % ولديها تبتل فإذا ما % % غاب في الخاق باق زال التبتل % % 14(@)(@@) % ولي العطر والملابس % كلهو التفتل % 15(@)(@@) % وإذا خس في المعاشر قدري % % فلديها يجل قدري وينبل % % 16(@)(@@) % وبها ترعوي حياتي إذا مت % ت وتشتد قوتي حين أذبل % % PageV01P3556 البحر : - 1(@)(@@) % وأخرق تضرمه نفحة % سفاها وتطفئه تفله % 2(@)(@@) % فأخلاقه تارة وعرة % وأخلاقه تارة سهله % % PageV01P3557 البحر : - 1(@)(@@) % بررتك بالهجران لما رأيتني % % على حسب ماتبدي أعقك بالوصل % 2(@)(@@) % ولست أبالي كيف كانت فروعنا % % إذا نحن كنا في الإخاء على أصل % % 3(@)(@@) % وإني وإن لم تأتني وحجبتني % % لأعتدك النصل المبر على النصل % 4(@)(@@) % نصرت بظهر الغيب غيبي وحطتني % % وقمت بعذري قاطعا فيه بالفصل % 5(@)(@@) % فلا زلت مستور المقاتل تعتلي % % وتحظى على الخصم المناضل بالخصل % % PageV01P3558 البحر : - 1(@)(@@) % دع الأجمال مرتجله % تخب بركبها عجله % 2(@)(@@) % وعاط أخاك عاتقة % بقار الدن مشتمله % % 3(@)(@@) % تراها حين تبذلها % % كجمر النار مشتعله % % 4(@)(@@) % إذا ما الدن أسبلها % % لنا من عينه الهمله % % 5(@)(@@) % حسبت سبائك العقبان % تجري منه منتزله % 6(@)(@@) % يطوف بكأسها رشأ % كغصن البانة الخضله % 7(@)(@@) % وما للغصن نضرته % % ولا حركاته الشكله % % 8(@)(@@) % وما للغصن مقلته % % ولا ألحاظه الثمله % % 9(@)(@@) % وما للغصن غرته % % ولا وجناته الخجله % % 10(@)(@@) % وما للغصن طرته % % ولا أصداغهالزجله % % PageV01P3559 11(@)(@@) % قوائمه بما حملت % ه من أردافه وحله % % 12(@)(@@) % إذا ما قابل الأبصا % % ر ظلت فيه منتضله % % 13(@)(@@) % يعذب قلب من يهوا % % ه بين قطيعة وصله % % 14(@)(@@) % وتشفع ذاك مسمعة % لنا بالسحر مكتحله % % 15(@)(@@) % قد اكتهلت صناعتها % % لرود غير مكتهله % % 16(@)(@@) % تجيد الشدو موقعة % وضاربة ومرتجله % % 17(@)(@@) % إذا غنتك ذقت العي % % ش من نغماتها الصحله % % 18(@)(@@) % مخففة ولم تبلغ % مقالة قائل نحله % 19(@)(@@) % مثقلة ولم تبلغ % مقالة قائل رهله % 20(@)(@@) % ولكن بين ذلكم % % قواما فهي معتدله % % PageV01P3560 21(@)(@@) % يود 
ms902	 الصب لو أمست % بسالفتيه منتعله % % 22(@)(@@) % محاسن كل مخلوق % لها في الحسن ممتثله % % 23(@)(@@) % كأن علي روادفها % % ستور الليل منسدله % % 24(@)(@@) % ولكن لا وفاء لها % % فنفس محبها وجله % % 25(@)(@@) % فقل لمتيم أضحت % له بالدل مختبله % % 26(@)(@@) % عليك أبا الحسين أخا % وخل الساحة الدغله % % 27(@)(@@) % فتى كملت محاسنه % فنفس خليله جذله % 28(@)(@@) % من الشعراء والعلما % % ء أهل الألسن الجدله % 29(@)(@@) % مهذبة خلائقه % بما حملت محتمله % 30(@)(@@) % فتى لا عقده واه % ولا عزماته فشله % % PageV01P3561 31(@)(@@) % نلقبه شنوفيا % برغم عداته السفله % 32(@)(@@) % شنوف من صنوف العل % م بالآذان متصلة % 33(@)(@@) % ولا يعدم أبو بكر % % يدا بثرائه مذله % % 34(@)(@@) % لعرض الجار صائنة % لعرض المال مبتذله % % 35(@)(@@) % ولا نعدم سجايا في % % ه للخيرات معتمله % % 36(@)(@@) % إذا الحرية انتقلت % فليست منه منتقله % % 37(@)(@@) % هو الجماش للعليا % % ء لا للغادة الغزله % % 38(@)(@@) % له لقب من التجمي % % ش يشبه نفسه الجذله % % 39(@)(@@) % وأخطل دهره شعرا % بغير سجية خطله % % 40(@)(@@) % وأحنف دهره حلما % بغير سريرة نغله % % PageV01P3562 41(@)(@@) % كلا هذا وذاك حيا % تبيت بروقه عمله % % 42(@)(@@) % كفى بهما إذا ظلت % ستور الليل منسدله % % 43(@)(@@) % حملت لذا وذاك يدا % قواي بحملها بعله % % 44(@)(@@) % فنفسي في مقامهما % % إلى الرحمن مبتهله % % 45(@)(@@) % بعثت قريحتي لهما % % فجاءت وهي محتفله % % PageV01P3563 البحر : - 1(@)(@@) % أبا الصقر قد أصبحت في ظل نعمة % إليها انتهى تأميل كل مؤمل % 2(@)(@@) % فدونك ظل المستديم لظلها % % وإن كنت فيه دائبا غير مؤتلي % % 3(@)(@@) % وما دعم الأقوام ظلة نعمة % بمثل محق تحتها متظلل % PageV01P3564 البحر : - 1(@)(@@) % بالجانب الشرقي شمس أشرقت % فتضاءلت شمس النهار خمولا % % 2(@)(@@) % يبدو لأبصار العيون ضياؤها % % فترى الخفي وتعرف المجهولا % % 3(@)(@@) % فإذا غدا بصر يباهر نورها % % رجعته مطروف الشعاع كليلا % % PageV01P3565 البحر : - 1(@)(@@) % أدلل على الخير تلحق شأو فاعله % % وإن قدرت فكن أدنى وسائله % % 2(@)(@@) % واعلم بأن ابتذال الوجه تخلقه % إلا ابتذالكه في نفع آمله % % 3(@)(@@) % وبذلة الوجه أحيانا تجدده % % كما تجدد سيفا كف صاقله % % PageV01P3566 البحر : - 1(@)(@@) % يامن أغار عليه من غلائله % % ومن أرق عليه من خلاخله % 2(@)(@@) % أما تغار على ودي 
ms903	 لصحبته % أما ترق لقلبي من بلابله % % 3(@)(@@) % ظبي يرى كل وجه من مخاتلنا % % وندريه فنعمى عن مخاتله % % 4(@)(@@) % نحتال فيه فينجو من حبائلنا % % ونحن ننشب تترى في حبائله % % 5(@)(@@) % فظ نميط الأذى عنه فيتعسنا % % وليس في السيف عفو عن صياقله % 6(@)(@@) % لاتعجبا أن دمعا فاض عن حرق % ماء أفاضته نار من مراجله % % 7(@)(@@) % أراق دمعي هوى ظبي أراق دمي % % يا للقتيل بكى من حب قاتله % % 8(@)(@@) % ما للمعنى ملقى من عواذله % % ما يستحق المعنى من عواذله % % 9(@)(@@) % إن الوزير غدا وصال قاطعه % % فاعمد إليه ودع قطاع واصله % 10(@)(@@) % يمم أبا الصقر إن الله فضله % وفات كل نظير في فضائله % % PageV01P3567 11(@)(@@) % من كل طول وطول في شمائله % % وكل جود وجود في أنامله % 12(@)(@@) % إذا ارتدى السيف لم يمسك بقائمه % ليستقل ولم يخطط بسافله % 13(@)(@@) % سيف ترد سيف غير ذي طبع % كأنما الرمح يمشي في حمائله % 14(@)(@@) % لاشيء أقرب حينا من مناضله % % أو من مطاعنه أو من منازله % 15(@)(@@) % من لا يرى المال إلا هم خازنه % ولايرى الزاد إلا ثقل آكله % 16(@)(@@) % مما حفظناه من أمثال حكمته % % لن يملك المال إلا كف باذله % % 17(@)(@@) % من كل كفء فقير من فضائله % وكل عاف غني من فواضله % 18(@)(@@) % خرق يشح على صغرى محامده % كيما يشح على كبرى طوائله % % 19(@)(@@) % غيران حين يحامي عن مكارمه % كالليث كادح ليثا عن حلائله % 20(@)(@@) % تلقاه عند مباراة النظير له % % كالسيل دافع سيلا عن مسايله % PageV01P3568 21(@)(@@) % منابذ لأعاديه وثروته % % كلا الفريقين يرمي في مقاتله % 22(@)(@@) % يكشف الدهر عنه في تصرفه % % عن نصل قلعي من مناصله % % 23(@)(@@) % كأنه بين أحوال تداوله % % بدر تهاداه شتى من مغازله % % 24(@)(@@) % أحيا به الله قوما بعد هلكهم % وأهلك الله قوما في غوائله % 25(@)(@@) % كالبحر أروى بني الدنيا وأغرقهم % % فهم رواء وغرقى في سواحله % 26(@)(@@) % أضحى الملوك وأضحينا نحمله % % تحميل من ليس يخشى وهي كاهله % 27(@)(@@) % عليه أثقال أمر الله يحملها % % والناس يالك من عبء وحامله % 28(@)(@@) % كأنه وحده جيش له لجب % صواهل الأرض شتى 
ms904	 من صواهله % % 29(@)(@@) % فللرعاة أحاظ من نصائحه % وللرعايا أحاظ من نوافله % 30(@)(@@) % ترى دعاوى قوم فوق حاصلهم % % وما دعاويه إلا دون حاصله % PageV01P3569 31(@)(@@) % للأريحية مشي في مفاصله % % وليس للراح مشي في مفاصله % % 32(@)(@@) % ذو الفضل في دهره لا عند ناقصه % بل عند كامله بل عند فاضله % 33(@)(@@) % ياكوكب الدهر قدما في غياهبه % % يامعلم الدهر قدما في مجاهله % % 34(@)(@@) % أصبحت في الذروة العليا من شرف % % منازل الناس شتى في أسافله % % 35(@)(@@) % فهم أنابيب رمح أنت عامله % لابل سنان طرس فوق عامله % 36(@)(@@) % يامعقلا غير مخشي غوائله % لمن أتته الدواهي من معاقله % 37(@)(@@) % أنت المخاطب لا يهدى لسائله % سوء استماع ولا يصغى لعاذله % % 38(@)(@@) % أماترى الدهر قد ألقى كلاكله % % على امرىء بينكم ملقى كلاكله % % 39(@)(@@) % يا آل همامه يا آل مرته % % يا شيبانه يا آل وائله % % 40(@)(@@) % مالي حرمت وحظ الناس كلهم % ممن ذنوبي خير من وسائله % % PageV01P3570 41(@)(@@) % أعيذ عدلك أن يلفى بحضرته % % خصمي وحقي مغلوب بباطله % % 42(@)(@@) % ماحق ميدان مجد أنت صاحبه % إجراء ناهقة قدام صاهله % % 43(@)(@@) % سائل بي الشعر إني من مصاعبه % فإن أبيت فهبني من أزامله % % 44(@)(@@) % أعيذ مزنك أن يشقى ببارقه % شيمي وتسعد أقوام بوابله % % PageV01P3571 البحر : - 1(@)(@@) % عد عنك المنازلا % % والطلول المواثلا % % 2(@)(@@) % إن للشعر في سلي % % مان عنهن شاغلا % % 3(@)(@@) % ملك لا يرى اللهى % % تستحق الوسائلا % % 4(@)(@@) % حسب راجيه عنده % أنه جاء سائلا % % 5(@)(@@) % لايرى المن قائلا % ويرى المن فاعلا % % 6(@)(@@) % سيبه عقر ماله % وهو يدعى فواضلا % % 7(@)(@@) % ويراه فرائضا % ويسمى نوافلا % % 8(@)(@@) % فتيممه واثقا % لاتيممه آملا % % 9(@)(@@) % وإذا كادت الأعا % % لي تلاقي الأسافلا % % 10(@)(@@) % وطىء الأرض وطأة % فأقر الزلازلا % % PageV01P3572 البحر : - 1(@)(@@) % أبا حسن قد قلت لو كان فعال % فحسبك قد سارت بخطبك أمثال % 2(@)(@@) % وأصبح ماقد قلته وثوابه % عناؤك والحرمان والقيل والقال % 3(@)(@@) % ظللت على شر الحجارة عاكفا % وليست لعباد الحجارة أعمال % 4(@)(@@) % ذهبت وإسماعيل في غير مذهب % وأكثر تباع المطامع ضلال % 5(@)(@@) % فمناك ظن أن تنال نواله % % ومناه ظن أن تدوم له الحال % 6(@)(@@) % وأنى 
ms905	 يرى لله إهمال مفسد % وأنى يرى للفضل في الناس أفضال % 7(@)(@@) % تمنيتما مالا يكون فأقصرا % % فقد لاح من غراء كالفجر إقبال % % 8(@)(@@) % تجلت سليمانية عبدلية % يحقق فيها للمحقين آمال % 9(@)(@@) % فلا يتعاظمك الدعي وحاله % وإن للأحلام في النوم أهوال % 10(@)(@@) % كأني به في محبس وثيابه % من العمر والنعماء والعز أسمال % % PageV01P3573 11(@)(@@) % غلائله الأمساح يأكلن جلده % وحليته أقياد سخط وأغلال % 12(@)(@@) % يغنيه بعد المسمعات إذا مشى % % حديد له منه سوار وخلخال % 13(@)(@@) % كأني به قد قيل بعد ذهابه % % ذميما وقد لفته نار وأنكال % 14(@)(@@) % تردى مضيع الماء والمال في لظى % % وغالته من أفعاله الشنع أغوال % % 15(@)(@@) % فلا ذاق عفو الله عرة دولة % % نبيه المخاري للخبائث أكال % 16(@)(@@) % وضيع المباني شامخ الأنف طامح % قصير المساعي للكبائر حمال % % 17(@)(@@) % أضاع وخان الفيء واستضعف الورى % % وأصبح يغتال الملوك ويحتال % % 18(@)(@@) % كتضييعه ماء الرجال وخونه % % وليست لأرحام المخانيث أحمال % 19(@)(@@) % ولو أن فحلا كان يحبل مرة % إذن ناله مما تجلل إحبال % % 20(@)(@@) % فأزهق مكر الله ذي الحول مكره % عقابا ومكر الله للمكر قتال % PageV01P3574 21(@)(@@) % وأصبح يبكيه نساء وصبية % تساند أيتام عليهم وأرمال % 22(@)(@@) % وماعجب أن خانت الماء رملة % ولا منكر أن ضيع الماء غربال % 23(@)(@@) % وقد كان رجى غلطة من أميرنا % % وهل يملك الدنيا مسيح ودجال % % 24(@)(@@) % وكنا نراه كاتبا أو مؤاجرا % فواثبنا منه الوليد وبلال % % 25(@)(@@) % وما كان إلا ثعلبا كان حينه % فأودى به عبل الذراعين رئبال % % 26(@)(@@) % فأصبح مطويا لمثواه أربع % تباع ومشروبا لمثواه أرطال % % 27(@)(@@) % صيام شرب يستحث كؤوسه % % أراعد بالخابور نوق وأجمال % % 28(@)(@@) % لقد خلطت فيه البذور بحقها % % إذا خلط التدبير أهوج بطال % % 29(@)(@@) % ولاتبتئس بالعسر فاليسر بعده % % وهل دون ماترجوه بالله أقفال % % 30(@)(@@) % لعلك والله المبلغ أن ترى % % وآمالك الممطولة الوعد أموال % % PageV01P3575 31(@)(@@) % بأيدي بني وهب فإن سحابهم % سحاب يعم الناس بالغيث هطال % 32(@)(@@) % أوليتك تنقاد الأماديح فيهم % وليست على الأفكار منهن أثقال % 33(@)(@@) % لكل بديل حين يخلو مكانه % وما لبني وهب من الناس أبدال % % 34(@)(@@) % هم جبل الله الذي 
ms906	 لو أزاله % وحاشاهم مازال للأرض زلزال % % 35(@)(@@) % وهم آمنات الله بين عباده % % فلو فورقوا مافارق الناس بلبال % % 36(@)(@@) % ولم يخلقوا أبطال عسف وشدة % ولكنهم بالرفق واللين أبطال % 37(@)(@@) % وليسوا بأجذال الطعان ذوي القنا % % ولكنهم للطعن بالرأي أجذال % 38(@)(@@) % وبالرأي لا بالرمح والسيف مصلتا % تواصل أوصال وتنبت أوصال % 39(@)(@@) % يسوسون أقلاما خماصا بطونها % % وهم وهي أشباه من الخمص أشكال % 40(@)(@@) % خماص بأيديهم خماص عفائف % عن الغي لم يخبث لهاقط آكال % PageV01P3576 41(@)(@@) % علي أنهم جودا بحار زواخر % وإن طولبوا بالحلم يوما فأجبال % % 42(@)(@@) % ميامين يضحى من تولوا أموره % مليا بأن يجبى له الحمد والمال % 43(@)(@@) % عليك ولي العهد بالقوم إنهم % % إذا وكلوا بالملك لم يك إخلال % 44(@)(@@) % ولم يك في تلك الظهارة سبه % ولم يكن في تلك البطانة إدغال % % 45(@)(@@) % ويهنيك أن أصبحت دنيا وجنة % فأصبحت الدنيا بدنياك تختال % % 46(@)(@@) % ولازلت جار المجد في رأس هضبة % تفوت الردى ما حلت الهضب أوعال % % 47(@)(@@) % حياتك تخليد وعيشك نعمة % وبرداك إعظام وتاجك إجلال % 48(@)(@@) % وفيك من الخيرات ما رام رائم % وما ارتاد مرتاد وما اقتال مقتال % % 49(@)(@@) % وإن رفرفت يوما عليك ملمة % فرفرف جبريل عليك وميكال % % 50(@)(@@) % وياطالب المعروف من غير وجهه % % إليهم فثم النيل لاشك والنال % PageV01P3577 51(@)(@@) % إليهم فما بدء الوفادة غمة % عليهم ولاعود الزيادة إملال % 52(@)(@@) % هنالك أعراق كرام وأوجه % وسام وأخلاق جسام وأفعال % 53(@)(@@) % أناس إذا علوا رأوا أن علهم % % عفاتهم تلك الفواضل إنهال % 54(@)(@@) % وما القوم بالجهال بل أهل سؤدد % تغابوا ولاحوهم على ذاك جهل جهال % 55(@)(@@) % كرام إذا هموا بتشييد سؤدد % نسوا عنده ما شيد العم والخال % 56(@)(@@) % كأنهم ما ورثوا ما كفاهم % وقد شاد أعمام بناهم وأخوال % 57(@)(@@) % تبارى لهم مدح ومنح كلاهما % % وإن رغم الحساد في الأرض جوال % 58(@)(@@) % وإما عراهم مادحوهم تحاشدوا % % لتصديقهم فالقول للفعل منثال % % 59(@)(@@) % إذا استنطقوا قالوا وإن سئلوا سالوا % % وإن ساوروا نالوا وإن طاولوا طالوا % % 60(@)(@@) % تصاغ بنعمى آل وهب أجنة % ويغذى بها من بعد ذلك أطفال % PageV01P3578 61(@)(@@) % ويكتهل الشبان تحت ظلالها 
ms907	 % % وتهرم أجيال عليها وأجيال % % 62(@)(@@) % وإن عبيد الله للرأس منهم % ولولا مكان الرأس لم تك أوصال % % 63(@)(@@) % تلافي عبيد الله دين محمد % فداوته كفاه وفي الدين إعضال % 64(@)(@@) % ورد بناء الملك سورا مشيدا % وقد بقيت منه رسوم وأطلال % 65(@)(@@) % أبو القاسم المقسوم في الناس عونه % إذا اقتسم الآفاق خوف وإمحال % 66(@)(@@) % فتى لم يزل يسعى لدن كان ناشئا % لتنجز آمال وتمطل آجال % % 67(@)(@@) % وتبذل كفاه عقائل ماله % % ليسكت سؤال وينطق عذال % 68(@)(@@) % إذا حالت الأفعال ألفيت فعله % وأولاه إحسان وأخراه إجمال % 69(@)(@@) % كسا المجد من أبراده بعد عربه % وحلى العلا من حليه وهي أعطال % 70(@)(@@) % وأي ابن تدبير وراعي رعية % ووالي رعاة حين تنهال أجوال % PageV01P3579 71(@)(@@) % أخو الرأي والعزم اللذين كلاهما % % شهاب سماوي وأبيض قصال % % 72(@)(@@) % له عزمات لاتفات بفرصة % وفيه أناة قبل ذاك وإمهال % 73(@)(@@) % يبادر إلا أنه غير مرهق % ويملي فلا الإمهال إذ ذاك إهمال % 74(@)(@@) % فلا في تأنيه المبادىء إغفال % ولافي تلافيه العواقب إعجال % 75(@)(@@) % مدحت به من لامعاناة مدحه % % عناء ولاتقويل راجيه إعوال % 76(@)(@@) % وقاه وقاء من يد الله محصن % لنعماه أن يغتالها الدهر مغتال % 77(@)(@@) % ومتع بابنيه وبالسؤل فيهما % % لتكرم أفعال وتحسن أقوال % 78(@)(@@) % ولاخليوا من ثروة وسماحة % لتقسم أنفال وتصلح أحوال % 79(@)(@@) % ولا عريا من نجدة وسلامة % لتنجاب أهوال وتؤمن أوجال % 80(@)(@@) % يرون العطايا في المكارم والعلا % % فرائض محكوما بها وهي أنفال % PageV01P3580 81(@)(@@) % غيوث لها ضوء الشموس وإنها % % شموس لها صوب ملث وأظلال % PageV01P3581 البحر : - 1(@)(@@) % لعمري لقد سهلت ماليس بالسهل % % فسمعا لوعظ أو فوعظا على رسل % % 2(@)(@@) % أسهلت عندي والسفاهة كاسمها % % رزيئة ود ليس من ناجم البقل % 3(@)(@@) % ولكن من الفرس الكريم الذي سمت % بواسقه غير الأشاء ولا الجعل % % 4(@)(@@) % ألا في سبيل الله ود رببته % بماء الصفاء العذب في الخلق السهل % 5(@)(@@) % فلما تطعمت الثمار وجدتها % % أمر من البلوى وأدهى من القتل % 6(@)(@@) % ألا لا أراني أيها الناس لاقيا % من الناس من يرعى لخير ولا فضل % 7(@)(@@) % ولا معظما خلا لغير ثرائه % % وإن 
ms908	 كان ذا تقوى وإن كان ذا عقل % 8(@)(@@) % وكم واعد عدلا على خلطائه % % إذا قلد الأحكام تاب من العدل % 9(@)(@@) % ينوح على الأحرار في جور غيره % % ويوسعهم جورا ويشرى على العذل % 10(@)(@@) % فلو ساس من ألحاه جهل عذرته % % ولكن من ألحاه عال عن الجهل % % PageV01P3582 11(@)(@@) % إليك أبا عبد الإله بعثتها % % على ثقة بالحلم منك وبالبذل % 12(@)(@@) % جريت مع الإدلال شأوا مغربا % فإن قلت لي مهلا مشيت على مهل % 13(@)(@@) % ولكنني لابد لي من مقالة % % أقوم بها ليست بظلم ولاهزل % 14(@)(@@) % ألست الذي أصفيته واصطفيته % % وآثرته قدما على المال والأهل % % 15(@)(@@) % ألست الذي أملته وادخرته % % فمالي وقد أمرعت أرتع في المحل % 16(@)(@@) % تجاوز حديث البخس والوكس كله % % وخذ في حديث جل عن ذلك الفصل % 17(@)(@@) % أتحدث أمرا مثل أمرك جامعا % فأخرج منه مخرج الساقط النذل % 18(@)(@@) % أكنت قذاة العين دون الألى دعوا % % أم السوءة السوآء في ذلك الحفل % 19(@)(@@) % أكان تخلي مغرسي واشتغاله % % سواء وقد صنفت في جوهر النخل % % 20(@)(@@) % ألا صاحب يبكي لمصرع صاحب % وإن كان لم يكلم برمح ولا نصل % PageV01P3583 21(@)(@@) % ألا أين عني المعظمون لحرمتي % % فقد فضلتها عندكم حرمة الوغل % 22(@)(@@) % ألا أين عني الصائنون لصفحتي % % فها هي قد أضحت أذل من النعل % 23(@)(@@) % ألا أين عني الحافظون صنيعهم % % ألا أين مني حافظو البعد والقبل % 24(@)(@@) % أأفضت بي الأيام در درها % % إلى ما ترى عيني من الهون والأزل % 25(@)(@@) % تيقظ أبا عبد الإله فإنها % % مناعس لاتعشى امرءا فائز الخصل % 26(@)(@@) % أتهجرني والحبل في خير معقد % وتحنو وتدنو عند مضطرب الحبل % % 27(@)(@@) % وما ذاك عن ذنب سوى أن خلتي % % بلا ملق فيما علمت ولاختل % 28(@)(@@) % تأمل فإنا والبهائم أسوة % سوى عدلنا في النقض طورا وفي الفتل % 29(@)(@@) % فضلنا بإيثار الجميل وفعله % % ونحن سواء والبهائم في الأكل % 30(@)(@@) % أما لتأذينا على الناس حرمة % لديكم أما للشكل حق على الشكل % PageV01P3584 31(@)(@@) % أما للتشاكي والتباكي ذمامه % ليالي ذادونا عن العل والنهل % 32(@)(@@) % ضربت لك الأمثال تنبيه واعظ % وحاشاك من قيل وحاشاك من 
ms909	 قول % 33(@)(@@) % وتجمعنا من بعد قربى كتابة % وإن قل علمي بالجريب وبالأشل % % 34(@)(@@) % ألم تر أن الغدر أردى ابن بلبل % وقد كان ذا خيل وقد كان ذا رجل % 35(@)(@@) % ومازلت تلحاه على مثل ما أرى % % فنكب هداك الله عن سنن النبل % 36(@)(@@) % ولا تعتذر إلا بما أنت أهله % فلم تؤت من فرع ولم تؤت من أصل % 37(@)(@@) % وكم عاتب أهدى إليك عتابه % % فكافأته بالجاه والنائل الجزل % 38(@)(@@) % كذاك عهدنا السؤدد الطفل فيكم % % فكيف تراه وهو في نهية الكهل % 39(@)(@@) % ولا تشتغل عني بلومك خطبتي % % فتودع صدر الود ذحلا على ذحل % 40(@)(@@) % إلى الله أشكو أن شعري مظلم % % وأني من الأيام في منهل ضحل % PageV01P3585 41(@)(@@) % ثناؤكم للبحتري وودكم % ومدحي لكم حاشا هواكم من الخبل % 42(@)(@@) % فإن قلتم للحكم بالحق فضله % % فما للدبغ النحل من عسل النحل % 43(@)(@@) % أسارت له فيكم أماديح مثلها % % يحمل ثقل الحق مستثقلي الحمل % 44(@)(@@) % أم الخلة الأخرى التي تعرفونها % % بل الخلة الأخرى وما النكث كالجدل % % 45(@)(@@) % ألم يتجهمكم بمدح كأنه % % شبا الحد أسرى في البقاع من النمل % % 46(@)(@@) % هجاكم بمنزور الهجاء ووغده % % وماحلية الحسناء بالعاج والذبل % 47(@)(@@) % فنال التي أجرى لها وهو وادع % مصون وقد أسقاكم حمأة السجل % 48(@)(@@) % فكان هجاء أن هجاكم وأنه % % أبى شغلكم أشعاره غاية الشغل % % 49(@)(@@) % فعارضته فيكم بمدح كأنه % % شباب جديد أو صقال على نصل % % 50(@)(@@) % فكافأتموني بالذي هو أهله % % من المنع والحرمان والرفض والخذل % PageV01P3586 51(@)(@@) % وكافأتموه بالذي أستحقه % من البر والإحسان والعطف والوصل % 52(@)(@@) % هطلت فأطفأت الصواعق عنكم % % فلم تفرقوا بين الصواعق والهطل % 53(@)(@@) % بلى قد فرقتم فرق عاكس خطة % وما المغزل المعكوس بالمحكم الغرل % 54(@)(@@) % إلى الله أشكو أن بحري زاخر % وأني من المعروف في منهل ضحل % % 55(@)(@@) % ولو كف وجهي قوته صنت ماءه % % ومنطقه عن موقع الجود والوبل % 56(@)(@@) % وأعفيت نفسي من أناس أراهم % يعدونني رذلا وما أنا بالرذل % 57(@)(@@) % ويرمونني دون امرىء لو نضلته % % لكان لهم حظان في ذلك النضل % 58(@)(@@) % مديح يعالي ذكرهم وحماية % لأعراضهم أمدادها عدة 
ms910	 الرمل % 59(@)(@@) % وما ذاك عند البحتري لصاحب % % ولابعضه في باب فرض ولانفل % 60(@)(@@) % ومابي قصب البحتري وثلبه % وإن صال فحل ذات يوم على فحل % % PageV01P3587 61(@)(@@) % شهدت له بالعتق في الشعر مخلصا % وما أنا فيه بالهجين ولا البغل % 62(@)(@@) % ألا ذاك مجاج السلاف علمته % % وإني لمجاج لما ليس بالنطل % % 63(@)(@@) % ولكن حظا ناله وحرمته % أرى خشله معرى ومعوى من الخشل % % 64(@)(@@) % لقد أنكرتني بعلبك وأهلها % % بل الأرض بل بغداد صاحبة التبل % 65(@)(@@) % أرى لصديقي أمن ظلمي ولا أرى % % له أمن إنصافي وإن كان في وعل % 66(@)(@@) % فلا يغترر من امرؤ بدماثة % فإني امرؤ أوى إلى جلد عبل % 67(@)(@@) % وفي السيف فصل تحت صقل يزينه % % وفي الذي فيه من الصقل والفصل % 68(@)(@@) % وماهذه مني وعيدا بجهلة % ولكنها الإخبار عن عزمة بتل % % 69(@)(@@) % أمر وأحلي منطقي في عتابكم % % وكل عتاب ذو سجاح وذو كحل % 70(@)(@@) % وفي غيرتي خفت وزفت نعامتي % % ألا فاعذروها أن تزف من الرأل % PageV01P3588 71(@)(@@) % ولاتنكروا صقلي الإخاء فإنه % % إذا طبع الصمصام حودث بالصقل % % 72(@)(@@) % ومهما أقل فيكم فإني أخوكم % % على كل حال من مرير ومن سحل % 73(@)(@@) % وما أنا للحم الخبيث بآكل % % وما أنا للحم الذكي بمستحلي % % 74(@)(@@) % إلى كم يحاز الرزق دوني وإنما % % إلى الله رزقي وحده لا إلى بعل % 75(@)(@@) % وماكنت للزوجات قدما بضرة % % فيهجرني بعل فترضى عن البعل % % PageV01P3589 البحر : - 1(@)(@@) % ياسيدا لم تزل فروع % من رأيه تحتها أصول % % 2(@)(@@) % أمثل عمرو يسوم مثلي % % خسفا وأيامه فطول % 3(@)(@@) % أمثل عمرو يهين مثلي % % عمدا ولا تنتضي النصول % 4(@)(@@) % ألا يرى منك لي امتعاضا % كالسيف فيه الردى يجول % 5(@)(@@) % ياعمرو سالت بك السيول % لأمك الويل والهبول % 6(@)(@@) % وجهك ياعمرو فيه طول % وفي وجوه الكلاب طول % 7(@)(@@) % فأين منك الحياء قل لي % % يا كلب والكلب لا يقول % % 8(@)(@@) % والكلب من شأنه التعدي % % والكلب من شأنه الغلول % 9(@)(@@) % مقابح الكلب فيك طرا % يزول عنها ولا تزول % 10(@)(@@) % وفيه أشياء صالحات % حماكها الله والرسول % PageV01P3590 11(@)(@@) % فيه هرير وفيه نبح % وحظه الذل والخمول % 12 
ms911	(@)(@@) % والكلب واف وفيك غدر % ففيك عن قدره سفول % % 13(@)(@@) % وقد يحامي عن المواشي % % وما تحامي ولاتصول % % 14(@)(@@) % وأنت من أهل بيت سوء % قصتهم قصة تطول % 15(@)(@@) % وجوههم للورى عظات % % لكن أقفاءهم طبول % % 16(@)(@@) % نستغفر الله قد فعلنا % % مايفعل المائق الجهول % % 17(@)(@@) % ما إن سألناك ماسألنا % % إلا كما تسأل الطلول % 18(@)(@@) % صمت وعيب فلا خطاب % ولاكتاب ولا رسول % 19(@)(@@) % إن كنت حقا من الندامى % % فمن ندامى الملوك غول % 20(@)(@@) % وجه طويل يسيل فوه % % أحسن منه حر يبول % % PageV01P3591 21(@)(@@) % بل فيك سرب وطول خطم % ولم يزل هكذا النغول % % 22(@)(@@) % فإن تكن آلة الندامى % % هذين فيما ترى العقول % % 23(@)(@@) % طول خطوم على وجوه % % فتوح أفواهها تهول % 24(@)(@@) % فما إذا سادة الندامى % % إلا البلاليع والفيول % 25(@)(@@) % إن رئيسا يراك يوما % لصابر للأذى حمول % 26(@)(@@) % ما ملني من أطاق صبرا % عليك بل بختي الملول % 27(@)(@@) % مستفعل فاعل فعول % مستفعل فاعل فعول % 28(@)(@@) % بيت كمعناك ليس فيه % % معنى سوى أنه فضول % PageV01P3592 البحر : - 1(@)(@@) % ياعلي العلا ابن قاسم القا % % سم في طالبي النوال نواله % 2(@)(@@) % وابن مارمة الذي يضرب المج % % د له أو بمثله أمثاله % % 3(@)(@@) % والذي أضحت المروءة والخي % % ر حليفيه والحقوق عياله % 4(@)(@@) % والذي بذله بغير ابتذال % والذي طوله بغير استطاله % 5(@)(@@) % والذي لم يرث كريم المساعي % % والعلا وابتناءها عن كلاله % 6(@)(@@) % والذي يأمن من المطال مرجي % % ه ولا يأمن المجاري مطاله % 7(@)(@@) % والذي لا يزال كل حكيم % راشد الأمر يستعين مثاله % 8(@)(@@) % ماترى في اصطناع حر شكور % % قد أراه الرجاء مالك ماله % 9(@)(@@) % ساقه نحوك الزمان وقادت % % ه أفاعيل كفك الفعاله % % 10(@)(@@) % وعلى ظهره من الدين ثقل % يرتجى أن تحطه لامحاله % % PageV01P3593 11(@)(@@) % واعتقاد الرجاء يوجب حقا % عند من هذب الإله خصاله % % 12(@)(@@) % ومعي ذاك والمودة والشك % % ر ضميرا سجمجما ومقاله % % 13(@)(@@) % وشهدي على رجائك أن لم % % أتوسل وأن تركت الإطالة % % 14(@)(@@) % وإذا المستقي دنا مستقاه % % فحقيق أن لا يطيل حباله % % 15(@)(@@) % وكفاني من الوسائل أخلا % % قك يا أيها القريب المناله % % 16(@)(@@) % فأدلني على الزمان 
ms912	 فمازل % % ت على صرفه كرم الإداله % 17(@)(@@) % وأجرني من أن يقول حسود % خاب أو أن يقول لي أولى له % % 18(@)(@@) % فلأنت الذي إذا أمه الآ % % مل عدت آماله أمواله % 19(@)(@@) % والذي يشتري الثناء فيغلي % % حين لا يسأل النجار الإقاله % % 20(@)(@@) % لك مني جم البديهة بالشك % % ر على الحادثات باقي العلاله % % PageV01P3594 21(@)(@@) % وقليل الخلاف يصلح إن شئ % % ت جليسا ويرتضي للوكاله % % 22(@)(@@) % إن تجالسه فالدماثة منه % % أو توكله تبل منه جزاله % % 23(@)(@@) % مستقل متى عبأت عليه % % عبء دهر لم تذمم استقلاله % % 24(@)(@@) % فيه أشياء لا يدعن ملولا % يتجنى عليه ذنب الملاله % % 25(@)(@@) % فاختبره في الحالتين جميعا % تجد الجد عنده والبطالة % % 26(@)(@@) % واعتقله فإنه أيها السي % % يد إن برته أطلت اعتقاله % % 27(@)(@@) % وعزيز على مدحي نفسي % % غير أني جشمته للدلالة % % 28(@)(@@) % وهو عيب يكاد يسقط فيه % % كل حر يريد إظهار آله % % 29(@)(@@) % واعتسافي العيوب حرصا على قر % % بك حق إن لم ترد إبطاله % % 30(@)(@@) % يا محب الجمال ليس جميلا % بجميل ألا يريك جماله % % PageV01P3595 31(@)(@@) % وإذا المرء لم يلوح بما في % % ه تخطاه رائد بجهاله % % PageV01P3596 البحر : - 1(@)(@@) % رواغي رواغ الخائف القلب لا السالي % % وهجري هجر النافر الجأش لا القالي % % 2(@)(@@) % ولو شئت شبهت الذي أستحقه % % بحالك هاتيك الجليلة لا حالي % % 3(@)(@@) % فرفعت من قدري وخفضت عيشتي % % وأمنت روعاتي وحققت آمالي % % 4(@)(@@) % ولو كان هذا أو أقل قليله % % لكان لزوم الباب ما عشت من بالي % % 5(@)(@@) % أردني لذاك الطول لا لي فإنه % % عظيم وزن حمدي وإن خف مثقالي % % 6(@)(@@) % وإن لم تردني فانصرافي إذا غدا % % يوافق ما تهوى يسكن بلبالي % % 7(@)(@@) % وما بي سخائي عنك لكن تتبعي % % رضاك وهل يسخو بمثلك أمثالي % % 8(@)(@@) % وهل أنا إلا كالطريد طردته % إذا طردتني عن فنائك أوجالي % % 9(@)(@@) % محاسنك أحفظها وإن كنت قد محت % % مقابح أعمالي محاسن أعمالي % % 10(@)(@@) % فأحسن ولا تخلل فأنت أهله % وهب لي صفحا عن سقاطي وإحلالي % % PageV01P3597 11(@)(@@) % وإني لأعطي الظن فيك حقوقه % إذا جلت في أحوال فكري أجوالي % % 12(@)(@@) % إخالك لو عاينتني في حفيرتي 
ms913	 % % بكيت عظامي الباليات وأوصالي % % 13(@)(@@) % وسرك أن أحيا كما كنت مرة % % ببذل الفداء الجزل والثمن الغالي % % 14(@)(@@) % فلا تجفني حيا ولا تبك رمتي % % كمنصرف عني يسائل أطلالي % % 15(@)(@@) % ولا تتمن العيش لي وهو فائت % ونبتزنيه عامدا وهو سربالي % % 16(@)(@@) % تحدثت الأملاء أنك حابسي % % على غير إجرام وأنك مغتالي % % 17(@)(@@) % وما قيل أملاء الرجال وقالهم % % بأسهل من قيلي عليك ومن قالي % % 18(@)(@@) % فأبق على أحدوثة الصنع إنها % % صنيعك تشكو لا صنيعي وأقوالي % % 19(@)(@@) % ولا تهج أفعال حسانا فعلتها % % لأني امرؤ أخطأت في بعض أفعالي % % 20(@)(@@) % فإن هجاء المرء بالفعل نفسه % هو الشيء يبقى والمقول هو البالي % % PageV01P3598 21(@)(@@) % وما قلت لولا ما تظني سوى الذي % % أراه جديرا أن يحسن أحوالي % % 22(@)(@@) % فلا تكره السوءى من القول مغريا % بها الناس صلاها لديك مع الصالي % % 23(@)(@@) % كمبغض أمر غامس فيه نفسه % % وقد كان عنه في ذرى المنظر العالي % % PageV01P3599 البحر : - 1(@)(@@) % وكم قائل قد قال فيك مرة % أتصحب ذا بخل ولست بذي بخل % 2(@)(@@) % فقلت أنا المفتاح والقفل صاحبي % % وهل يوجد المفتاح إلا مع القفل % PageV01P3600 البحر : - 1(@)(@@) % خليلي عوجا بالديار فإنما % % دعوتكما باسم الخلال لتفعلا % % 2(@)(@@) % ديار التي أرعيتها بارض الهوى % % وأمطرتها وسمي دمعي أولا % % 3(@)(@@) % جعلت لها صدري مرادا تروده % % وبوأتها من حبة القلب منزلا % % 4(@)(@@) % فما علقت من قبلها النفس معلقا % ولا اتخذت من بعدها متعللا % % PageV01P3601 البحر : - 1(@)(@@) % سألتك بالأصل الذي أنت فرعه % وأشفع بالفرع الذي أنت أصله % % 2(@)(@@) % إذا أنت ودعت الوزير فقل له % % توخ ابن رومي بما أنت أهله % % 3(@)(@@) % وإني أرى المسكين لا شك ضائعا % متى هو لم يوصل بحبلك حبله % 4(@)(@@) % أجبه إذا نادى وأنجده صارخا % ودعدعه إن زلت عن الدحض نعله % % PageV01P3602 البحر : - 1(@)(@@) % عنفت شيخي في مواثبة % تواثباها وقد يعوج معتدل % 2(@)(@@) % فقلت للأكبر الألحى هبا لكما % % الأذان وهذا المذهب الخطل % % 3(@)(@@) % فقال نحن ديوك الله عادتنا % % أنا نؤذن أحيانا ونقتتل % 4(@)(@@) % لا سيما عند خضب الشيخ لحيته % % ورأسه واختضاب الشيخ منتصل % % 5(@)(@@) % نحن الديوك بحق يوم ذلكم 
ms914	 % % إذا بدت حمرة الحناء تشتعل % 6(@)(@@) % فإن أجدنا سفاد السانحات لنا % % فثم تقوى معانينا وتكتهل % % 7(@)(@@) % فاعذر على ما ترى فينا فحلفتنا % % ديكية ليس فيها جانب دغل % 8(@)(@@) % وبين كل الديوك الأن ملحمة % ليست بمعدومة ماحنت الإبل % % 9(@)(@@) % فقلت لا بل يقول القائلون لكم % % ديوك إبليس والأقوال تنتضل % 10(@)(@@) % فيكم من الشر ما يزرى بخيركم % % فأين تذهب عنه أيها الثمل % PageV01P3603 11(@)(@@) % فقالأخطأت فالق الدين منتقلا % إن كنت مما يسوء الدين تنتقل % 12(@)(@@) % إن الأذان لخير عند مسلمنا % % قليله لكثير الشر محتمل % % 13(@)(@@) % والصالحات بحكم الله معصفة % بالصالحات وحكم الله يمتثل % 14(@)(@@) % فسمنا أفضل اسمينا فحق لنا % % إن كنت ممن بثوب الذين يشتمل % % 15(@)(@@) % فقلت أحسنت بل أحسنتما عملا % وقدوة وأساء اللائم العجل % 16(@)(@@) % وقلت للدين إذ أكدت معادنه % % ودع هريرة إن الركب مرتحل % % PageV01P3604 البحر : - 1(@)(@@) % أبا حسن صل حاجتي بوصالها % % وإلا فدع لي صفحتي بصقالها % % 2(@)(@@) % بدأت بمعروف فثن بمثله % % حميدا وأطلق حاجتي من عقالها % % 3(@)(@@) % وإلا فاعتق طامعا من مطامع % يروح ويغدو عانيا في حبالها % % 4(@)(@@) % بذلت لك التقريظ غير مماطل % لا تبلني في حاجتي بمطالها % % 5(@)(@@) % فعندي بذل الشكر عند قضائها % % وعندي بذل العذر عند اعتلالها % % 6(@)(@@) % متى تكسني من حاجتي ثوب نفعها % % فأنت الفتى المكسو ثوب جمالها % % 7(@)(@@) % جرت سنن للفاعلين ذوي العلا % % وأنت حقيق يا ابنهم بامتثالها % % 8(@)(@@) % فجد لي بوجه صونه في ابتذاله % % وكم من وجوه صونها في ابتذالها % % 9(@)(@@) % وما من علاء في يد عند ملكها % % ولكنه لاشك عند فعالها % % 10(@)(@@) % فعجل ولا تمطل بما أنت أهله % % فخيرات أفعال الفتى في عجالها % % PageV01P3605 11(@)(@@) % وما لرجال المخلفين عداتهم % % من الفعلات الزهر غير انتحالها % % PageV01P3606 البحر : - 1(@)(@@) % رأيتكم تبدون في الحرب عدة % ولا يمنع الأسلاب منكم مقاتل % 2(@)(@@) % فأنتم كمثل النخل يظهر شوكة % % ولا يمنع الجرام ما هو حامل % % PageV01P3607 البحر : - 1(@)(@@) % تنافستك من الأعياد أربعة % شتى على أربع شتى من الملل % 2(@)(@@) % الفصح والفطر والنيروز يقدمه % % عيد الفطير ازدحام الورد بالنهل % 3(@)(@@) % جاءت سراعا تباري في أزمتها 
ms915	 % % تكاد تسبق شوقا مبلغ الأمل % % 4(@)(@@) % في مدة عدة العشرين أولها % % متى شفت بك ما لاقت من العلل % 5(@)(@@) % وغير بدع أن اشتاقت إلى ملك % في كل مجد وخير سائر المثل % 6(@)(@@) % به أديلت توالي الدهر فانتصفت % % أيامه الآن من أيامه الأول % % 7(@)(@@) % أضحت به أخريات الدهر لابسة % فخرا يقوم مقام الحلي والحلل % % 8(@)(@@) % فاسلم على الدهر يا بن الأكرمين له % % لا بل لمعتصم منه وذي أمل % % PageV01P3608 البحر : - 1(@)(@@) % لا يعدم الله يديك الصولا % % على الأعادي وعلينا الطولا % % 2(@)(@@) % أصبحت في أمر صديق زولا % % جمعت فيه قوة وحولا % % 3(@)(@@) % وما تهيبت هناك هولا % % حتى رأى الويل عليه العولا % % 4(@)(@@) % من بعد ما أنضى البلاد جولا % % وعاد فحلا يستضيم الشولا % % 5(@)(@@) % أولى له أولى به وأولى % % فاسلم بديئا للعلا وأولى % % 6(@)(@@) % في ظل عيش لم يخالط غولا % % تجد فعلا وتجد قولا % % 7(@)(@@) % أنت الكريم ليس فيه لولا % % قد أصبح الخير عليه استولى % % 8(@)(@@) % يا من أمر حاله وأحولى % % PageV01P3609 البحر : - 1(@)(@@) % فتى يقطع الآمال غر مخيب % ولكنه يعطي قصار المؤمل % 2(@)(@@) % إلى أين بالآمال بعد نواله % % إلى أين وافى السفر آخر منزل % PageV01P3610 البحر : - 1(@)(@@) % يا لقوم لأحمد بن بنان % % ولما قال من عجيب المقال % % 2(@)(@@) % قال لما اشترى غلاما كفاه % كثرة الغرم واكتراء الرجال % % 3(@)(@@) % صنت مالي عن الفساد بمالي % % حان لي أن أصون مالي بمالي % % PageV01P3611 البحر : - 1(@)(@@) % يابني طاهر طهرتم وطبتم % % وزكوتم فروعكم والأصول % 2(@)(@@) % جاركم محرم وأعراضكم بس % ل ولكن مالكم مبذول % 3(@)(@@) % كاد يكدي بطون أيديكم البذ % ل ويخفي ظهورها التقبيل % PageV01P3612 البحر : - 1(@)(@@) % رأيت الأخلاء في دهرنا % % بظهر المودة إلا قليلا % % 2(@)(@@) % بطاء عن المبتغي نصرهم % % إلى أن يغادر شلوا أكيلا % % 3(@)(@@) % فإن حشدوا لأخ مرة % أدلوا عليه دلالا ثقيلا % % 4(@)(@@) % فلا تفزعن إلى نصرهم % وكن للمظالم ظهرا ذليلا % % PageV01P3613 البحر : - 1(@)(@@) % ألا نسيا نفسي حديث البلابل % بمشمولة صفراء من خمر بابل % 2(@)(@@) % فما العيش إلا في ندام سلافة % تنادمها العصران غير ثمائل % % 3(@)(@@) % نضا الدهر عن أسآرها جل لونها 
ms916	 % % فغادرها من لونها في غلائل % % 4(@)(@@) % سرابية آلية تصرع الشذا % % وترفع من شخص القذى المتضائل % % 5(@)(@@) % ثوت تصطلي شمس الظهائر برهة % إلى أن أفادت لون شمس الأصائل % % 6(@)(@@) % إذا ما تمشت في عظام ابن كبرة % مشى لين الأوصال رخو المفاصل % % 7(@)(@@) % ترد له غصن الشباب وقد ذوى % % رطيبا كغصن البانة المتمايل % % 8(@)(@@) % إذا نزلت بالهم في دار أهله % شكى الضيم شكوى أهل ضيم نازل % % 9(@)(@@) % بماء جلت عن جر صفحته القذى % % حريق لها ذيل كميش الذلاذل % % 10(@)(@@) % إذا اطردت أنفاسها في سراته % % تسلسل عاري المتن جعد السلاسل % % PageV01P3614 11(@)(@@) % قرته السواري بين أكناف روضة % تراعى بها عين النعاج المطافل % % 12(@)(@@) % به عبق كالمسك مما تسحبت % % عليه الصبا تفلى خزامى الخمائل % % 13(@)(@@) % إذا ساورته الراح في الصحن لألأت % وجوه الندامى بالبروق العوامل % % 14(@)(@@) % كأنهما شوبان ذوب سبائك % من التبر معلول بذوب وذائل % 15(@)(@@) % شربت على صحو المشيب وطال ما % % شربت على سكر الشباب المخايل % % 16(@)(@@) % وأعذر شراب المدامة شارب % لتقصير أيام المشيب الأطاول % % 17(@)(@@) % وللكأس أخرى أن تكون تعلة % لذي الشيب عن ذكر الشباب المزايل % % 18(@)(@@) % إذا ما تذكرت الشباب جعلتها % % رقوءا لأسراب الدموع الهوامل % % 19(@)(@@) % أدرت على لهو الحديث كؤوسها % % ونادمتها الخلان بين الخلائل % % 20(@)(@@) % طلبت بها سلم الهموم وربما % % طلبت بها جر الذيول الذوائل % % PageV01P3615 21(@)(@@) % وحدثت ندماني أحاديث مامضى % % من العيش أقفوها بأنه ثاكل % % 22(@)(@@) % أعاذلتي في الراح أشيهت فارعوي % % لشأنك إني لا أدين لعاذل % % 23(@)(@@) % فلو أسمحت عنها القرينة أسمحت % % لشيب كنوار الثغامة شامل % % 24(@)(@@) % وقالت دع الشبان والكأس إنها % % حمى بعد مر الأربعين الكوامل % % 25(@)(@@) % ألم يكفها أن المشيب أفاتني % % نصيبي من وصل الحسان العطائل % % 26(@)(@@) % إلى أن غدت باللوم لادر درها % % لتمنعني در الكؤوس الحوافل % % 27(@)(@@) % فتشفع لي حرمان حظ بمثله % % رماها عن اللوماء رام بشاغل % % 28(@)(@@) % أأترك عفو الكأس حران صاديا % لعلان من ريق الكواعب ثامل % % 29(@)(@@) % خلي من الأحزان في ظل جنة % قريب جناها من يد المتناول % % 30(@)(@@) % يروح ويغدو في الغواني مساعفا % بحاجات موموق 
ms917	 حظي الوسائل % % PageV01P3616 31(@)(@@) % يميد به مأد الشباب فترعوي % % إلى جانبيه كالظباء العواطل % % 32(@)(@@) % مسقى بأفواه كأن رضابها % % جنى النحل شارت أريه كف عاسل % % 33(@)(@@) % لذاك عن الصهباء أبرد علة % وأجدر أن يغنى بتلك المناهل % % 34(@)(@@) % إليك فإنا للهوينا وشأنها % % وآل زريق للأمور الجلائل % % 35(@)(@@) % ألم تعلمي أن قد كفونا شؤوننا % % فلم يطرقوا منهن أولى لآيل % 36(@)(@@) % هم أهملونا في مصاب غيوثهم % % سدى ورعونا بالقنا والقنابل % % 37(@)(@@) % فأصبح شمل الناس شمل رعية % وسربهم في العيش سرب الهوامل % % 38(@)(@@) % وهم حملونا منة بعد منة % على أننا منها خفاف الكواهل % % 39(@)(@@) % سأنثونثا آلائكم آل مصعب % % نثا الروض آلاء السحاب الهواطل % % 40(@)(@@) % وما نفحات الروض تثني على الحيا % % بأطيب من ذكراكم في المحافل % PageV01P3617 41(@)(@@) % أكفكم في الأرض أعين مائها % % وأقدامكم فيها مراس الزلازل % % 42(@)(@@) % أقول عليما لا محيطا بفضلكم % % ولاخابطا في القول عشوة جاهل % 43(@)(@@) % إذا شئت جاريت القوافي فيكم % مداها وما كثرت حقا بباطل % 44(@)(@@) % وما يتناهى القول فيكم لغاية % تناهي ذات بل تناهي قائل % 45(@)(@@) % ألا أيها المجري ليدرك شأوهم % % لهنك أيم الله أنصب عامل % 46(@)(@@) % إذا القول أعيا القائلين بلوغه % % فكيف به لا كيف ذاك لفاعل % 47(@)(@@) % فقف خاسئا عنهم حسيرا فإنما % % طلبت منيعا من حويل المحاول % 48(@)(@@) % اصم عن الفحشاء والعذل في الندى % % طويل التمادي في شقاق العواذل % 49(@)(@@) % يجود فيعطي ماله في حقوقه % % على منهج بين السبيلين عادل % 50(@)(@@) % وإن هاجه هيج من العذل أصبحت % فواضله مشفوعة بفواضل % % PageV01P3618 51(@)(@@) % كدجلة يجري ماؤها في سبيله % % فلا ينتحي عن قصده للمعادل % % 52(@)(@@) % فإن كفكفته الريح من شطر وجهه % % طما فاغتدى آذيه في السواحل % 53(@)(@@) % وقد شمرت عن ساقها غير أنها % % تركض في ذيل من النقع ذائل % 53(@)(@@) % إذا حال بدء دون عرف فبدؤهولا بدع منه بدؤه أريحية تحط الولايا عن ظهور الرواحل وحيد فريد في المكارم آنس بوحدته مستأثر بالفضائل يمر العطايا والمنايا لأهلهابأخفض باليه مجدا كهازلإذا ما جلته الحرب عارض رمحهعلى لاحق الآطال نهد ال % % إلى عوده المأمول أحظى الوسائل 
ms918	 % % 53(@)(@@) % ولا بدع منه بدؤه أريحية % تحط الولايا عن ظهور الرواحل % % 53(@)(@@) % وحيد فريد في المكارم آنس % بوحدته مستأثر بالفضائل % 53(@)(@@) % يمر العطايا والمنايا لأهلها % % بأخفض باليه مجدا كهازل % % 53(@)(@@) % تهاتفت البطالهدك فارسا % شهدنا لقد صدقت بشرى القوابل % % 53(@)(@@) % أيزخر لي بحر النوال بفضله % % وتمطلني في غير حين مطال % % 53(@)(@@) % أراهم هوينا المستخف بشأنهم % % ورب مجد في الأمور كهازل % % PageV01P3619 53(@)(@@) % فغرتهم منه الغرور فأصبحت % مقاتلهم نصب المنايا القواتل % % 53(@)(@@) % ولو أنهم ساموا مخايل جدة % غذن لنجوا منها نجاء الموائل % 53(@)(@@) % تدانت لك الأقطار ضبطا وخبرة % فأصبحت لديك الأرض كفة حابل % 53(@)(@@) % فلو شئت إشرافا عليها وقدرة % قبضت على اطرافها بالأنامل % % 53(@)(@@) % لك الفضل لا تلقاء آخر ناقص % ولكنه تلقاء آخر فاضل % % 53(@)(@@) % فلا ترتهن ذمي بمطلك إنني % % بمن لا يبالي الذم غير مبالي % % 53(@)(@@) % إذا ما جلته الحرب عارض رمحه % على لاحق الآطال نهد المآكل % 53(@)(@@) % وما نزل الإصحار غلا كقانص % اريب توارى عند بث الحبائل % 53(@)(@@) % وكم قد أهان الشعر الشعر قبلك معشر % فلاقى مهينوه هوان سبال % 53(@)(@@) % طويل أبا حسن حمدي متى ما بغيته % % رخيص وغن أعرضت عنه فغال % PageV01P3620 53(@)(@@) % أفق صاغرا من نومه لجهل إنها % % تعود على نوالها بوبال % 53(@)(@@) % ونكب سبيلا أنت فيه فقد غدت % سبيلك في أمري سبيل ضلال % % 53(@)(@@) % لعمري لقد خالفت في مسددا % له في مضيق الرأي رحب مجال % 53(@)(@@) % جواد رأى منحا لم تر ما يرى % % وما زالت مذؤوما ذميم فعال % 53(@)(@@) % فقل لي وقد خالفت واحد عصره % أرأيك عن آرائه متعال % % 53(@)(@@) % كذاك يرى من حان حين سقوطه % % ومن آذنت نعماؤه بزوال % 53(@)(@@) % علوت علوا لم تكن قط أهله % % وأنت جدير بعده بسفال % 53(@)(@@) % إذا كاتب لم يمتثل رأى صاحب % % طريقته المثلى في مثال % % 53(@)(@@) % ولا ذنب للمظلوم إن بات مرصدا % لسوء فعال منك سوء مقال % % 53(@)(@@) % إذا كان سلما فالمقاتل كالشوى % % وإن كان حربا فالشوى كالمقاتل % % PageV01P3621 53(@)(@@) % فإن طاعنوه كان أول طاعن % وإن نازلوه كان أول نازل % 53(@)(@@) % حلفت لئن 
ms919	 سفت حلمي لتقطعن % إليك قوافي الشعر كل عقال % 53(@)(@@) % يشيعه بروق الموت من صفحاته % % وفي حدة مصداق تلك المخايل % % 53(@)(@@) % ولكنه كالليث يختل صيده % % ويبرز للأقران غير مخاتل % 53(@)(@@) % ويوم عصيب ظله مثل ضحه % % بل الضح أعفى من ظلال المناصل % 53(@)(@@) % تباذل أعلاق المضنة تحته % رجال عدى يا للعدو المباذل % 53(@)(@@) % إلى أن تظل المضرحيات بينهم % % تدف بطانا دلحا بالحواصل % % 53(@)(@@) % قضى بين جمعية وكم من كريهة % قضى بين جميعها بإحدى الفواصل % % 53(@)(@@) % ألا هبلت أم المعاديه نفسه % وأين امرؤ عاداه إلا ابن هابل % % 53(@)(@@) % وما اعجلته الحرب غبرام أمره % إذا أعجل المنخوب حول الجوائل % PageV01P3622 53(@)(@@) % فلا تحسبوا تعجيله نقماته % % لأعدائه تعجيله رفد سائل % 53(@)(@@) % هو المرء ذو الوعد المعجل نجحه % % كما قد عهدتم والوعيد المماطل % 53(@)(@@) % وصول الخطى بالسيف والسيف بالخطى % % إذا الطعن حشت ناره بالسوافل % % 53(@)(@@) % دعوا الحرب تستكمل لهم أدواتها % % ولا تعجلوها أن تعض ببازل % % 53(@)(@@) % فليس ابن الله عنهم بنائم % ولا الله عما يعملون بغافل % 53(@)(@@) % وحوش رعاها حينها حول غابة % أسامة فيها ملبد بالكلاكل % % 53(@)(@@) % فضم إليه جأشه ثم راعها % % بشدة مكروه الفجاءة باسل % % 53(@)(@@) % وما زال في عرض الأناة وكيده % بكل سبيل مرصد بالغوائل % % 53(@)(@@) % ولو عدهم قرنا كفيا لبأسه % إذن ما أتاهم من وجوه المخاتل % % 53(@)(@@) % ولا فاته طول الأناة بفرصة % إذا ضاع أمر العاجز المتخاذل % PageV01P3623 54(@)(@@) % وأنت جدير بعده بسفال % إذا كاتب لم يمتثل رأي صاحب % % 55(@)(@@) % طريقته المثلى فأي مثال % % أإياي تستدعي نوائر شرة % 56(@)(@@) % مللت صفاء العيش كل ملال % متى أنت صاليت العتاة مساخطي % % 57(@)(@@) % فليس يصاليك الجحيم مصالي % % إذا كنت لم تلبس لبوس تجمل % 58(@)(@@) % بعرف فلم تلبس لبوس جمال % فهل أنت إلا لعنة لمعاين % % 59(@)(@@) % ومختبر نصب لكل نضال % أتبغي إلى الشنع التي فيك سادسا % 60(@)(@@) % وفيك من السؤات خمس خصال % % بغاء وتشوية ونوك ولكنة % 61(@)(@@) % وشؤم كملت الشؤم كل كمال % وماصلح الرأس الذي أنت حامل % 62(@)(@@) % أبا حسن إلا لقفد قذال % أضيف بني عبدون أحسن تزودا % 63 
ms920	(@)(@@) % ولاتهتم فيهم بطعن مبال % فليس الزنا في دينهم بمحرم % % PageV01P3624 64(@)(@@) % وليس القرى في حكمهم بحلال % وما حرمة يؤوونها بمصونة % 65(@)(@@) % ولا درهم يوعونه بمذال % حلفت على استخفافه بي أنه % 66(@)(@@) % منيخ بأثقال عليه ثقال % أتدعم بالعرج المشائيم دولة % 67(@)(@@) % يراها مليك الناس ذات جلال % أبى الله إسناد الهضاب وحملها % % 68(@)(@@) % بغير هضاب مثلها وجبال % إذا ارتضع الدنيا أخو اللؤم وحده % 69(@)(@@) % فذاك رضاع مؤذن بفصال % ن % % PageV01P3625 البحر : - 1(@)(@@) % لي صديق صامتي % قحطبي باحتياله % 2(@)(@@) % أكرم الجنة والإن % % س على قلة ماله % % 3(@)(@@) % لا أسميه عساه % لا يراءى بفعاله % % PageV01P3626 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % بالله أدفع ما لاتدفع الحيل % 2(@)(@@) % ألا لئيم جزاه الله صالحة % يهجوه عني فبي عن عرضه كسل % PageV01P3627 البحر : - 1(@)(@@) % إذا احتضر الشح النفوس فخالد % هناك جواد النفس بالنفس والأهل % PageV01P3628 البحر : - 1(@)(@@) % رأيت فقاح الناس للخرج وحده % % وفقحته الشتراء للخرج والداخل % 2(@)(@@) % أخالد يابن الخالدات مخازيا % رويدك تدركك القوافي على رسل % 3(@)(@@) % ستدعى حليما بعد جهل وشرة % وكم جاهل علمته الحلم بالجهل % PageV01P3629 البحر : - 1(@)(@@) % أخالد يابن الخالدات مخازيا % خلود الرواسي من هضاب مواسل % 2(@)(@@) % لقد حل حب الأير منك بمنزل % رفيع فما يسطيعه عذل عاذل % 3(@)(@@) % هوى كالجوى ألهاك عن كل لذة % وعن كل مكروه من الأمر نازل % 4(@)(@@) % فكيف وأنى ليت شعري فرغت لي % % وقد كنت في شغل بدائك شاغل % % 5(@)(@@) % أراني عظيم القدر عندك بعدها % % وإن كنت تبغيني ضروب الغوائل % 6(@)(@@) % إذا الناس قاموا في القيامة حسرا % فهمك إذ ذاك اعتراض الفياشل % % 7(@)(@@) % كأني أرى تجوال عينيك لم ترع % بروع ولم تشغل بتلك الشواغل % 8(@)(@@) % تلاحظ سوءات الرجال وقد بدت % هنالك ترميها بعيني مغازل % 9(@)(@@) % ترى كل هول في القيامة نزهة % سرورا ولهوا باجتلاء الغرامل % % 10(@)(@@) % وقد ذهلت عن طفلها كل مطفل % رؤوم وألقت حملها كل حامل % PageV01P3630 البحر : - 1(@)(@@) % إني رأيتك حالما أنشدتني % % بيتين قاداني عليك على أمل % 2(@)(@@) % أيعوذني متعوذ من دهره % فأعيذ مالي بالمعاذر والعلل % 3(@)(@@) % إني لأستحي المكارم أن أرى 