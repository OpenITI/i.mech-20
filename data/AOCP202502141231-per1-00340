ms332	 توانی می کن(@)(@@) (@@) این جور و جفا، اگر روا می داری %~% با شیفته ای چومن، تودانی، می کن!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 3328 دل، دردتو را به جان خریداری کرد %~% وین دیدهآ بیچاره، بسی زاری کرد(@)(@@) (@@) بر آتش غم بسوخت، مسکین دل من %~% لقائله %~% جزیار، مرا همه کسی یاری کرد!(@)(@@) (@@) 3329 رویم به جفا، سیاه می باید کرد؟ %~% جان ودل من، تباه می باید کرد؟(@)(@@) (@@) اندیشه نمی کنی، که آخر روزی %~% در روی منت، نگاه می باید کرد!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 3330 ای کرده به عیش در، سواری با من %~% شرمت ناید، که جام داری با من(@)(@@) (@@) دل می دهدت، که غم گساری با من %~% جان می کنم و، تومی گساری با من!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 3331 آن یار که گرناز کند، حق با اوست %~% پیوسته زمن ملالتش، عادت وخوست(@)(@@) (@@) فی الجمله، به جنگ او نشاید رفتن %~% گفتن که: مرا چرا نمی داری دوست؟(@)(@@)(@@)(@@) | سراج اسد آبادی(@)(@@) (@@) 3332 یک وعده، که هم عشوه بود، یار نداد %~% وز گلبن وصل خود، مرا خار نداد(@)(@@) (@@) برتخت دلم، به پادشاهی بنشست %~% پس، مردمک چشم مرا بار نداد!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 3333 بر چهره، زخون دل نشانها تو کنی %~% دلها تو بری و، قصد جانها تو کنی(@)(@@) ~~وآنگه گویی که: عهد ما بشکستی! 3334 تا چند زگفتن و وفا ناکردن از(@)(@@) من، زتو خواستن همه حاجتها %~% الغیره %~% آنها زتو آید، آنچنانها تو کنی!(@)(@@) %~% وزتو، زهمه یکی روا ناکردن! %~% یک دم به هوای ما هوا ناکردن PageV01P516(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0520.jpg)(@)(@)(@@)(@@)(@@) | شهری(@)(@@) (@@) 3336 گر همچوتو، بخت همنشین داشتمی %~% پیوسته زکبر، سر به کین داشتمی(@)(@@) (@@) زین سان که تویی و، تومرا می داری %~% گر من تو امی، تو را چنین داشتمی!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3330 تا عاشق تو شدم، که زیبا یاریجز هجر ندیدهام، روا می داری؟(@)(@@) (@@) خوبیت به من سپار و، توعاشق شو %~% تا چون دهمت ز وصل برخورداری!(@)(@@) (@@) 3331 بی تو دل من قرار گیرد؟ هرگز! %~% خ %~% یا از غم تو مرا گزیرد؟ هرگز!(@)(@@) ~~گفتی: سر 
ms333	 خود گیر، زمن دست بدارممکن بود این، عقل پذیرد؟ هرگز!(@)(@@) (@@) 3338 ما بی تو، به صد ناز و تنعم بودیم %~% چون ره به تویافتیم، از آن گم بودیم(@)(@@) (@@) در شهر توایم، مردمی کن با ما %~% ما نیز، به شهر خویش مردم بودیم!(@)(@@)(@@)(@@) | شیخ اوحد(@)(@@) ~~تا کی گویی مرا که: از خود به درآی 3330 بی هیچ گمان، راه یقین آسان(@)(@@) است %~% اخر %~% از خود به در آمدن، چنین آسان است؟ %~% دنیا دادن در ره دین، آسان است(@)(@@) (@@) 3340 هر روز، فزونتر است با من جنگت %~% هر دم به جفا، تیزتر است آهنگت(@)(@@) (@@) زنهار، زشیوههای گوناگونت %~% فریاد، زغمزه های رنگارنگت!(@)(@@) ~~334 شبها، زتودر سرم چه سوداست، که نیست در هجرتو، بر من چه ستمهاست، که نیست(@)(@@) ~~سوگند همی خوری که: «من زان توام، سوگند حکایت است، پیداست، که نیست!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 3341 بر من زبلای عشق تو چیست که نیست؟ %~% واندر بی هجرتو، چه دردی است که نیست(@)(@@) (@@) گفتم: زغمت چنان به دردم، که مپرس %~% آن کیست که این تگفت و، آن کیست که نیست؟(@)(@@) ~~3342 از عشق تو، بر من ستمی هست، که نیست یادرسخنت، بیش و کمی هست، که نیست؟(@)(@@) (@@) گفتی: چه غم است بر دلت؟ راست بگو %~% خود هم توبگو، هیچ غمی هست، که نیست؟(@)(@)PageV01P517(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0521.jpg)(@)(@)(@@)(@@)(@@) | شهری(@)(@@) (@@) 3344 آن بت، که به جز دلم کبابی نخورد %~% جز خون من خسته، شرابی نخورد(@)(@@) (@@) تشنه ست به خون من، ولی طرفه تر این %~% بر خون من سوخته، آبی نخورد!(@)(@@)(@@)(@@) | کمال کنعانی(@)(@@) ~~3345 از عشق رخت، گرچه اسیرم پیشتآ ار برسد، آه و نفیرم بیشت(@)(@@) (@@) تا چند، تو مرگ من به حاجت خواهی؟ %~% خود مردهآ آنم که بمیرم پیشت!(@)(@@)(@@)(@@) | عثمان مراغه ای(@)(@@) ~~3346 دردم بشنید، گفت: بر من به دو جو اشکم چو بدید، گفت: صد من به دو جو(@)(@@) (@@) جان کردم عرضه، گفت: از این صد خرمن %~% نزدیک من سوخته خرمن، به دو جو!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3347 مپسند که دل سپردهای 
ms334	 را بکشی %~% بیچاره ز راه بردهای را بکشی(@)(@@) (@@) دل مرده توست و، بی سبب می کشیش %~% مردی نبود، که مردهای را بکشی!(@)(@@)(@@)(@@) | ذ(@)(@@) (@@) 3348 ای دوست، کسی بی سببی یار کشد؟ %~% وآنگه چو منی یار وفادار کشد؟(@)(@@) (@@) خود دوست مگیر، دشمنی گیر مرا %~% کس دشمن خویش را، چنین زار کشد؟(@)(@@) ~~3349 نرگس به حیل مست کنی، تا چه شود؟ در خون دلم دست کنی، تا چه شود؟(@)(@@) (@@) قصد تو، هلاک کردن جان من است %~% محنتکدهای پست کنی، تا چه شود؟(@)(@@) (@@) 3350 جانا، علم عشق نگوسار مکن %~% با ما تو به قول دشمنان کار مکن(@)(@@) (@@) آن را که عزیز کرده باشی، روزی %~% زنهار، عزیز خویش را خوار مکن!(@)(@@) ~~3351 نیکوست رخت، جفانه نیکوست، مکناندر خور دشمن است، با دوست مکن(@)(@@) ~~زین حال، عدو چوبشنود شاد شود از بهر خدا، چوشادی اوست مکن(@)(@@) (@@) 3352 ای دل ز سر لجاج برخیز، مکن %~% این آتش ساکن شده را، تیز مکن(@)(@@) (@@) این جگر سوخته، زنهار مخواه %~% با جان به لب رسیده مستیز، مکن!(@)(@)PageV01P518(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0522.jpg)(@)(@)(@@) ~~3353 بس روز کسان که شب کنی، گرتوتویی! آزار کسان طلب کنی، گر توتویی!(@)(@@) ~~گویی: ببرم دل از تو، آری چه عجباین کار به دست چپ کنی، گر توتویی!(@)(@@)(@@)(@@) | جمال(@)(@@) (@@) 3354 آتشکده پیکرم کنی، گرتوتویی! %~% وز باد [سبکترام کنی، گر تو تویی!(@)(@@) (@@) آبم بردی بتا، از آن می ترسم %~% اخی %~% با خاک برابرم کنی، گر توتویی!(@)(@@) (@@) 3355 سیمین بر من، میل به زرمی نکند %~% در کار دلم، هیچ نظر می نکند(@)(@@) (@@) آب رخ من، می برد ازروی ستیز %~% ظهیر %~% وز آتش درد من، حذر می نکند!(@)(@@) ~~3356 هر چند که میل تو، سوی بیدادی است یک ذره غمت، به از هزاران شادی است(@)(@@) (@@) از ما گله می کنی، ولیکن ما را %~% در هر نفسی، از تو هزار آزادی است!(@)(@@)(@@)(@@) | خاقانی(@)(@@) ~~3357 مه را زفلک، به طرف بام آوردنوز ریگ روان، روغن خام آوردن(@)(@@) (@@) از روم، کلیسیا به شام آوردن %~% بتوان، 
ms335	 نتوان تو را به دام آوردن!(@)(@@)(@@)(@@) | جمال محوی(@)(@@) ~~3358 هرگه، که بتم زلف پر از خم شکنداین خسته دلم، چوزلف بر هم شکند(@)(@@) (@@) ورهیچ زحال خویش گویم، سخنی %~% آن نیزم، نیم گفته دردم شکند!(@)(@@)(@@)(@@) | جمال نقاش(@)(@@) ~~3359 افسوس، که چشم بخت من خفته بماند کارم همه، چون زلف تو آشفته بماند(@)(@@) (@@) اندر دل داشتم، حدیثی با تو %~% دل خون شد و، آن حدیث ناگفته بنماند!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 3360 در عهد تو، این قحط وفا می بینی! %~% و ین روشنی کار جفا می بینی!(@)(@@) (@@) این از همه طرفه تر، که بیداد جهان %~% خود می کنی و، جمله زما می بینی!(@)(@)PageV01P519(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0523.jpg)(@)(@)(@@)(@@)(@@) | باب سیزدهم - وصال(@)(@@) [جمال) عبدالرزاق(@)(@@) (@@) 3361 نه روی تو، بر سر عنایت کردن %~% نه روی مرا، از تو حکایت کردن(@)(@@) (@@) چندان به دروغ گفته ام، شکر تو من %~% وله %~% کم شرم آید کنون، شکایت کردن!(@)(@@) (@@) 3362 در بتکده ها، از تو شکستی بینم %~% در هر دلی، از غمت نشستی بینم(@)(@@) (@@) هر گوشه که پا درنهم، ای جان وجهان %~% برداشته از دست تو، دستی بینم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3363 از حسن، به ماه آسمان می مانی! %~% وز سرکشی ای جان، به جهان می مانی!(@)(@@) ~~در خشم شدی که گفتم: «رای دشمن من!»ای دوست، اگر نه ای بدان می مانی!(@)(@@)(@@)(@@) | وله(@)(@@) ~~3364 ای دوست، ز مرده ای چه برخواهد خاست؟ وزخون فسرده ای، چه برخواهد خاست؟(@)(@@) (@@) من مردهآ تو تو در پی کشتن من %~% از کشتن مرده ای چه برخواهد خاست؟(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3365 ای ترک، به غمزه کشوری در جنبان وز شورش حسن، لشکری در جنبان(@)(@@) (@@) گیرم که سراسر سخنم، باد هواست %~% ای سرو، به باد هم سری در جنبان!(@)(@@)(@@)(@@) | اثیر الدین(@)(@@) (@@) 3366 گه طیره بدان طرهآ شستم گیرد %~% گه سغبه بدان نرگس مستم گیرد(@)(@@) (@@) در پای اجل فتادهام، می بیند %~% هم بر سر آن نیست، که دستم گیرد!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 3367 در دل نگذشت کز دلم بگذاری %~% با رخت فتاده در گلم بگذاری(@)(@@) (@@) بسیار 
ms336	 زدم لاف تو، با دشمن و دوست %~% افسوس بود، گر خجلم بگذاری!(@)(@@)(@@)(@@) | نجیب عمر(@)(@@) (@@) 3368 رفتم بر آنکه جانم از غم خون کرد %~% تا دست بگیردم، نگویم چون کرد(@)(@@) (@@) گفت: آمدهای که دستگیریت کنم؟ %~% دستم بگرفت و، از درم بیرون کرد!(@)(@)PageV01P520(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0524.jpg)(@)(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 3369 هر لحظه، به قصد جان من بر خیزی %~% در شهر، دو صد فتنه و شورانگیزی(@)(@@) (@@) ساکن! نه مصاف کافران می شکنی! %~% آهسته! نه خون ملحدان می ریزی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3370 بس دست جفا، که بر دل من داری %~% با آنکه در او، همیشه مسکن داری(@)(@@) (@@) دشمن داری، که دوست داریم تورا %~% ای دوست، مگر تو دوست دشمن داری؟(@)(@@)(@@)(@@) | جمال خجندی(@)(@@) ~~وان سایه زمن بازگرفتن، سببش 3371 من حیلهآ آن دلبر پرفن، دانم(@)(@@) 3376 سر پنجگی و دل نگرانی، تا چند؟ %~% وله %~% وان بوالعجبی که او کند،(@)(@@) من دانم %~% والله که چوآفتاب، روشن دانم! %~% وین بوالعجبیها که تودانی، تا چند؟(@)(@@) (@@) چون عجز من و قدرت خود، می دانی %~% پیدام بکش، زخم نهانی تا چند؟(@)(@@)(@@)(@@) | وله(@)(@@) ~~3373 انصاف، که آن تنگ گهر هیچ نکرد جز کشتن من به عشوه در، هیچ نکرد(@)(@@) (@@) این است، که جان من به بازی بازی %~% از من بستد، ورنه دگر هیچ نکرد!(@)(@@)(@@)(@@) | سجاسی(@)(@@) (@@) 3374 ای دوست، که عاشق کشی و زار کشی %~% یاران گنه نکرده، بسیار کشی(@)(@@) (@@) من طاقت زخم پر ندارم، زنهار %~% مزدت باشد، گرم بیکبار کشی!(@)(@@)(@@)(@@) | عزیز علی(@)(@@) ~~3375 از عهد من، ای عهد شکن یاد آوروز درد من بی دل و تن یاد آور(@)(@@) ~~اکنون که چو ماه نوشدم، در غم تو آخر به مهی، شیبی زمن یاداور!(@)(@@)(@@)(@@) | وله(@)(@@) ~~3376 ای دوست، مرا به رغم دشمن یادآر وز درد دل سوخته خرمنزیادآر(@)(@@) ~~آخر روزی، چنانکه هر دم صد بارمن یاد تومی کنم، تواز من یاد آرل(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3377 بادی، که به نزد کس قرارت نبود %~% یا آتش و، جز سوزش کارت نبود(@)(@@) (@@) آبی، که به صلح زینهارت نبود %~% خاکی، 
ms337	 که جزآدمی شکارت نبود!(@)(@)PageV01P521(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0525.jpg)(@)(@)(@@) ~~3378 همواره، تو دل ربودهای معذوریغم هیچ نیازمودهای، معذوری(@)(@@) ~~من بی تو، هزار شب به روز آوردمتوبی تو شبی نبودهای، معذوری!(@)(@@) (@@) 3379 اشکم زغم توهر زمان خون باشد %~% وز هجر توبر دلم شبیخون باشد(@)(@@) (@@) توبا تویی ای نگار، از آن با طربی %~% توبی تو چه دانی که شبی چون باشد(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 3380 کس نیست، غم اندوخته تر زین که منم %~% با درد تو آموخته تر، زین که منم(@)(@@) (@@) گفتی که: به عشق در، نه ای پخته هنوز! %~% خامی چه کنی سوخته ترزین که منم!(@)(@@) (@@) 3381 چون یار مرا، به وصل خرم نکند %~% یک بوسه از آن لبم، مسلم نکند(@)(@@) (@@) راضی شدم از وی به جفاها، لیکن %~% ترسم به جفا نیز، وفا هم نکند!(@)(@@) (@@) 3382 ای بر دلم از باد جفاهای تو گرد %~% سیرم زتو، با هر آنکه خواهی می گرد!(@)(@@) (@@) آبی تو و، آب در سبد نتوان داشت! %~% بادی توو، باد در قفس نتوان کرد!(@)(@@)(@@)(@@) | قاضی(@)(@@) (@@) 3383 گیسو، به سر زلف تو در خواهم بست %~% تا بنشینی، چو دوش نگریزی بست!(@)(@@) (@@) بیش از مستی، هر آنچه اندر دل هست %~% می گویم، تا باز نگویی: شدمست!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 33384 آب ارچه نمی رود به جویم، با تو %~% جز در ره مردمی، نه پویم با تو(@)(@@) (@@) گفتی که: چه کردهام؟ نگویی بامن %~% آن چیست نکردهای؟ چه گویم با توا(@)(@@) (@@) 3385 ای دوست، به تیغ انتظارم کشتی %~% زن نرگس مست پر خمارم کشتی(@)(@@) (@@) تا دل به تو دادم جگرم خون کردی %~% تا جان منی، هزار بارم کشتی!(@)(@)PageV01P522(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0526.jpg)(@)(@)(@@)(@@)(@@) | سید علی(@)(@@) ~~3386 جانا، به دو لعل قند پاشم کشتی پنهان نتوان کرد، که فاشم کشتی(@)(@@) ~~تا کی گویی که: دور باش از بر من! ای دوست مکن، به دور باشم کشتی!(@)(@@)(@@)(@@) | ع(@)(@@) ~~3387 هر دم، دل خسته را برنجاند یاریا سنگدل است، یا نمی داند یار(@)(@@) ~~بر چهره نوشتهام به خون، قصهآ دلمی بیند و، هیچ بر 
ms338	 نمی خواند یار!(@)(@@)(@@)(@@) | آخر(@)(@@) ~~3388 کین توهمه با من بیدل باشددل را به غمت، واقعه مشکل باشد(@)(@@) (@@) محنت زده ای، زخدمتت کم شده گیر %~% از کم شدنش، تورا چه حاصل باشد؟(@)(@@) (@@) 3389 از محنت تو، مرا رهایی نبود %~% تا، جان مرا زمن جدایی نبود(@)(@@) (@@) مشتاب به کشتنم، که از کشتن من %~% بازار تو را، هیچ روایی نبود!(@)(@@)(@@)(@@) | شهاب کاغذی(@)(@@) (@@) 3390 لطفی بکن، ای کشیده از من دامن %~% کم بی تو نگشت جز غمت پیرامن(@)(@@) (@@) از بهرخدا، چه کردهام با تو؟ بگو %~% کت با همه کس خوش است، الا با من!(@)(@@)(@@)(@@) | حو(@)(@@) (@@) 3391 دم با لبت از شهد، نمی یارم زد %~% وین لاف، به صد جهد نمی یارم زد(@)(@@) (@@) این طرفه، که جان می دهم و، نیم نفس %~% از بیم توبد عهد، نمی یارم زد!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~3392 مردم چومنی را، زدل و جان پرسند همواره، به آشکار و پنهان پرسند(@)(@@) ~~هر لحظه تو عذری چه نهی؟ راست بگویاران قدیم را، از این سان پرسند؟(@)(@@)(@@)(@@) | خ(@)(@@) ~~3392 چون باتو بوم، در تونیارم نگریست چون بی تو بوم، ببایدم زار گریست(@)(@@) ~~چون با تو و بی توام، به غم باید زیستپس، فرق میان وصل و هجران تو چیست؟(@)(@@)(@@)(@@) | 5(@)(@@) (@@) 3394 تیمار من خستهآ پابست بدار %~% وز جان من سوخته دل، دست بدار(@)(@@) (@@) قصد من - اگر دشمنیی نیست- مکن %~% و آزرم من - اردوستیی هست- بدار PageV01P523(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0527.jpg)(@)(@)(@@) (@@) 3395 با خوی بد تو، هر که یار تو شود %~% رسوای جهان گردد و، خوار توشود(@)(@@) (@@) ترسم که سری که بر سر آمد زجهان %~% بیهوده بتا، در سر کار توشودا(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 3396 زان پس که فدای عشق تو کردم جان %~% بر من زچه خشمناکی، ای جان وجهان(@)(@@) (@@) هرگز تو مراچه دادهای؟ جز دشنام %~% یا زان تو من چه بردهام؟ جزفرمان!(@)(@@)(@@)(@@) | اسعد(@)(@@) (@@) 3397 اندر طلبت، زاشک درها سفتم %~% وز ساده دلی، راز زتو ننهفتم(@)(@@) (@@) غمخوارهآ خویش را، چنین واطلبند؟ %~% کافر نشدم، اگر دروغی گفتم!(@)(@@) (@@) 3398 خوبان، که زعاشقان شیدا 
ms339	 پرسند %~% احوال دل سوختگان را پرسند(@)(@@) (@@) غمخوارهآ خویش را، چنین واطلبند؟ %~% آوارهآ خویش را، چنین واپرسند؟(@)(@@)(@@)(@@) | خ(@)(@@) ~~3399 بردی دل و دین و عقل و هوش، ای دلبر زین بیش، به خون من مکوش ای دلبر(@)(@@) (@@) ما را زغم عشق تو، جانی ماندهست %~% آن نیز به تودهم، خموش ای دلبر!(@)(@@) (@@) 3400 ای ماه، شبی روی به ما ننمایی %~% روزی، گره غم ز دلم نگشایی(@)(@@) (@@) دیوانه کنی مرا، زنادیدن خود %~% وانگاه، چو ماه نو پدیدار آیی!(@)(@@)(@@)(@@) | ح(@)(@@) (@@) 3401 روزم، به بهانه باز می گردانی %~% شبها، به فسانه باز می گردانی(@)(@@) (@@) ممن بخت تو و، تواز سر بیخبری %~% بخت، از در خانه باز می گردانی!(@)(@@) (@@) 3402 با تو، به عتاب گرچه پر می گویم %~% پر می گویم، ولی چو در می گویم!(@)(@@) (@@) می گویم: «دوست را زدشمن بشناس %~% وزصحبت چون منی مبر!» می گویم(@)(@@) (@@) 3401 گاهی، به لطافتم به خود بنوازی %~% گاهی، به تکبرم برون اندازی(@)(@@) (@@) ای جان عزیز، چون به ما پردازی %~% عمری بینی، شده به بازی بازی!(@)(@)PageV01P524(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0528.jpg)(@)(@)(@@) (@@) 3404 روزی چند است، کز سر طنازی %~% با ما، سخن مهر نمی آغازی(@)(@@) ~~با خود سر ما نداری، ای جان وجهانیا، از دگری به ما نمی پردازی!(@)(@@)(@@)(@@) | اخر(@)(@@) ~~3405 سر گرچه بر آسمان همی سایم من یک لحظه زچشم من، توبیرون نشوی(@)(@@) %~% در چشم تو، یک ذره نمی آیم من! %~% خاک کف پای تو، نمی شایم من(@)(@@) (@@) 340 این آتش دل، مراچنان می دارد %~% کم آب جیات هم زیان می دارد(@)(@@) (@@) لطفی که نمی کنی، نه از توست بتا %~% بخت بد من، تو را بر آن می دارد!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 3407 در خواب ندید، چرخ اعلا چومنی %~% در هیچ صدف نیافت، دریا چومنی(@)(@@) (@@) وآنگه چوتویی، جور کند با چومنی %~% در غصهآ چون تویی، دریغا چومنی!(@)(@@)(@@)(@@) | بوامی(@)(@@) (@@) 3408 ازصحبت دوستان بریدن، خوش نیست %~% در حجرهآ فرقت آرمیدن، خوش نیست(@)(@@) (@@) هر چند خوشت نیاید، این می گویم %~% دل بردن و، روی در کشیدن 
ms340	 خوش نیست!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 3400 راز تو، به نزد این و آن نتوان گفت %~% آسان آسان، به ترک جان توان گفت(@)(@@) (@@) ین با که توان گفت؟ که احوال مرا %~% 5 %~% تونشنوی و، با دگران نتوان گفت!(@)(@@) (@@) 3410 نه با تومرا، خلوت جام می بود %~% نه با تومرا، عشرت نای و نی بود(@)(@@) (@@) باکی گویی: «وصل نباشد، همه روز!» %~% این خود زکجای، تا که دید و کی بود!(@)(@@) (@@) 3411 آنی، که به نوک مژه دل می گیری %~% هر روز زنو، یار چگل می گیری(@)(@@) (@@) با نیستی آگاه، که در بند توام %~% یا، چشمهآ خورشید به گل می گیری!(@)(@)PageV01P525(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0529.jpg)(@)(@)(@@) (@@) 3412 دلدار نیابی به جهانی، چومنی %~% واندر پی تو، به سر دوانی چومنی(@)(@@) ~~ای جان و جهان، زخود روا می داری؟ در گردن تو، خون جوانی چو منی!(@)(@@) (@@) 3413 چون زنگی زلفت آید اندر بازی %~% با لشکر صبر من، چو ترکان تازی(@)(@@) (@@) این از همه طرفهتر، که حال دل من %~% می دانی و، خود را عجمی می سازی!(@)(@@) (@@) 3414 آخر نفسی در غم خود ما را باش %~% در بند وصال، روز و شب چون ما باش(@)(@@) (@@) هر روز، که جویم از تویکساعته وصل %~% تا چند ازین [گونه] که گوفردا باش(@)(@@) (@@) 3415 لیلی صفتا، از غم تومجنونم %~% بعنی: زشمار عاشقان بیرونم(@)(@@) (@@) زان روی، که با من چوالف راست نه ای %~% چون واو، همیشه در میان خونم!(@)(@@) (@@) 3416 در سیرت دوست، هر چه نیکوست نبود %~% یک ذره وفاش، در رگ و پوست نبود(@)(@@) (@@) دردا که به دوست، هر که در عالم بود %~% دشمن کردیم و، دوست هم دوست نبود!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 3417 با دوست خود ای نگار، دشمن شده ای %~% با دشمن خود، دوست و فروتن شده ای(@)(@@) (@@) من نیز ز مهر تو، به صد جهد و بلا %~% فارغتر از آنم، که تو از من شدهای!(@)(@@)(@@)(@@) | نمط نهم(@)(@@)(@@)(@@) | در بزرگداشت او(@)(@@) ~~3418 روزی که زتو، سلام باشد ما راآن روز، فلک غلام باشد 