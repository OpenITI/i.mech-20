ms21	 % ورب ظلام لا يحب له فجر % 5(@)(@@) % وإن دبر الأيام من عدم النهى % % فإن على حكامهم يجب الحجر % PageV01P080 البحر : بسيط تام 1(@)(@@) % السيف منتقم والجد معتذر % وما عليك إذا لم يسعد القدر % 2(@)(@@) % وإن دجت ليلة في الدهر واحدة % % فطالما أشرقت ايامه الأخر % 3(@)(@@) % وما شكونا ظلاما من غياهبها % % حتى تطلع في أثنائه القمر % 4(@)(@@) % ولا ينال كسوف الشمس طلعتها % % وإنما هو فيما يزعم البصر % 5(@)(@@) % وهل على البطل الحامي حقيقته عار % إذا جبن الأعداء أو غدروا % % 6(@)(@@) % أما الكرام فقد أبلى وفاؤهم % على البحيرة ما لم يبله الظفر % 7(@)(@@) % ما ضرهم والعوالي في نحورهم % تعفوا الكلوم وتبقى هذه السير % 8(@)(@@) % لاذوا بسيفك حتى خال دونهم % مجرب في دفاع الخطب مختبر % 9(@)(@@) % من السيوف التي لولا مضاربها % % ما كان للدين لا عين ولا أثر % 10(@)(@@) % هندية وبنو حمدان رفقتها % % لقد تخيرت الأحساب والزبر % PageV01P081 11(@)(@@) % ومكبرين صغيرا من عقولهم % % لم يركبوا الخيل إلا بعدما كبروا % % 12(@)(@@) % أخفوا بكيدهم غدرا فما عبأت % سمر الرماح بما همت به الإبر % 13(@)(@@) % لا تعجلوا فعلى أطرافها خلف % ترجى عواقبه فيكم وتنتظر % 14(@)(@@) % أثرتم أسدا تدمى أظافره % طيان لا عصر منه ولا وزر % 15(@)(@@) % حذار أن تستزن الحلم غضبته % إن كان ينفع عند الخائن الحذر % 16(@)(@@) % جربتموه فأفنتكم صوارمه % ولو عقلتم كفاكم دونه الخبر % 17(@)(@@) % وقد علا فوق أفلاك النجوم بها % % فكيف يلحق من في باعه قصر % 18(@)(@@) % حدث ببأس بني حمدان في أمم % تأتي فقد ظهرت في هذه النذر % 19(@)(@@) % واذكر لهم سيرأ في المجد معجزة % % لولا الشريعة قلنا إنها سور % 20(@)(@@) % قوم إذا طلب الأعداء عيبهم % فما يقولون إلا أنهم بشر % PageV01P082 21(@)(@@) % السابقون إلى الدنيا بملكهم % ما أورد الناس إلا بعدما صدروا % % 22(@)(@@) % كأن أيديهم للرزق ضامنة % فاللندى قائم منهم ومنتظر % 23(@)(@@) % تسمو البلاد إذا عدت وقائعهم % % فيها وتبتسم الدنيا إذا ذكروا % % 24(@)(@@) % ماتوا وأحيا ابن ذي المجدين ذكرهم % فما يظنون إلا انهم نشروا % % 25(@)(@@) % يثنى عليهم بما تعطي أنامله % والروض يحمد في إحسانه 
ms22	 المطر % 26(@)(@@) % وسابق طلق الألحاظ في أمد % لا ينفع العين في إدراكه النظر % 27(@)(@@) % إذا تأملته في نيل غايته % رأيت كيف تصاد الأنجم الزهر % 28(@)(@@) % كأنما رأيه في كل مشكلة % عين على كل ما يخفى ويستتر % 29(@)(@@) % يا ناصر الدولة المشهور موقفه % في نصرها وضرام الحرب تستعر % 30(@)(@@) % أنتم صوارمها والبيض نابية % وشهبها وظلام الخطب معتكر % PageV01P083 31(@)(@@) % وحاملوا الراية البيضاء ما برحت % على رماحكم تعلو وتنتشر % 32(@)(@@) % كنتم بصفين أنصار الوصي وقد % دعا سواكم فما لبوا ولا نصروا % % 33(@)(@@) % فهي الخلافة ما زالت منابرها % % إلى سيوفكم في الروع تفتقر % 34(@)(@@) % هل تشكر العرب النعمى التي طرقت % أم ليس ينفع فيها كلما شكروا % % 35(@)(@@) % قوم أعدت إلى الدنيا نفوسهم % فكل عارفة من بعدها هدر % 36(@)(@@) % تلك الصنيعة إن خصت بني أدد % فليس تنكر ما في طيها مضر % 37(@)(@@) % أما ابن نصر فقد أخفت ضمائره % مودة لك ما في صفوها كدر % 38(@)(@@) % فرع أبان جناه طيب عنصره % ما يحمد العود حتى يعرف الثمر % 39(@)(@@) % سالمت منه على الأعداء مرهفة % لمثلهم كنت تقناها وتدخر % 40(@)(@@) % يقظان ما علقت بالنوم مقلته % فلا ينبه في حرب العدى عمر % PageV01P084 41(@)(@@) % يا واهبا وعوادي المزن باخلة % وصاعدا وعوالي الشهب تنحدر % 42(@)(@@) % أما القوافي فقد جاءتك سابقة % كما تضوع قبل الديمة الزهر % 43(@)(@@) % منظومة فإذا فاه الدواة بها % % ظننت أن نجوم الليل تنتثر % 44(@)(@@) % من معجزاتي التي لولا بدائعها % % في الشعر شبه قوم بعض وما سحروا % % 45(@)(@@) % تثني عليكم وتبدي عيب غيركم % فقد هجوت بها قوما وما شعروا % % 46(@)(@@) % أتاك رائد قوم ليس عندهم % على الحقيقة لا ماء ولا شجر % 47(@)(@@) % تلوح ذكرك في داجي همومهم % كما يلوح لعين الساهر السحر % 48(@)(@@) % فاستجلها درة الغواص أخرجها % % من بعد ما غمرته دونها الفكر % 49(@)(@@) % ما تشتكي غربة المثوى ورفقتها % % أفعالك الشهب أو أخلاقك الغرر % 50(@)(@@) % واسمع أبثك أخباري فإن لها % % شرحا وإن كنت أرويه وأختصر % PageV01P085 51(@)(@@) % جادت لقومي سحاب منك هاطلة % ما غيبت منة منها وقد حضروا % % 52(@)(@@) % شكرت 
ms23	 عنهم وإن أحسنت عندهم % فإنني ناظم بعض الذي نثروا % % 53(@)(@@) % وغادرتني صروف الدهر بعدهم % كالصل أطرق لا ناب ولا ظفر % 54(@)(@@) % في بلدة تحتوي الأحرار ساحتها % % فما لهم وطن فيها ولا وطر % 55(@)(@@) % أشتاقكم ويحول العجز دونكم % فأدعي بعدكم عني وأعتذر % 56(@)(@@) % وأشتكي خطرا بيني وبينكم % وآية الشوق أن يستصغر الخطر % 57(@)(@@) % فهل لرأيك أن ينتاش مطرحا % له من الفضل ذنب ليس يغتفر % 58(@)(@@) % فعندك الجود لا من ولا كدر % وعنده الحمد لا عي ولا حصر % 59(@)(@@) % وإن ضربت به في وجه نائبة % ففي يمينك منه صارم ذكر % 60(@)(@@) % محاسن هي عند السامعين بها % % دعوى ومثلك يتلوها ويعتبر % PageV01P086 61(@)(@@) % فما أخاف مطال الحظ تحرمني % % نداك إن طال في أيامك العمر % 62(@)(@@) % ولا يفوت غنى أنت الكفيل به % وإنما غفلات الدهر تبتدر % PageV01P087 البحر : طويل 1(@)(@@) % وظبي من الأتراك رنحه الصبا % % فمال ومن أعطافه تقبس الخمر % 2(@)(@@) % إذا أخذ المرآة ينظر وجهه % ظننتهما شمسين بينهما بدر % PageV01P088 البحر : بسيط تام 1(@)(@@) % من كان يحمد ليلا في تقاصره % فإن ليلي لا يرجى له سحر % 2(@)(@@) % لا تسألوني إلا عن أوائله % فآخر الليل ما عندي له خبر % PageV01P089 البحر : سريع 1(@)(@@) % لا تغبط القبر على جدة % وجسم من حل به دائر % 2(@)(@@) % يستأنس الطرف إلى قربه % % كأنما باطنه ظاهر % PageV01P090 البحر : مديد تام 1(@)(@@) % ما على العدال لو نظروا % % ثم لاموا فيك واعتذروا % % 2(@)(@@) % قمر ضل الأنام به % ما بهذا يعرف القمر % PageV01P091 البحر : طويل 1(@)(@@) % عسى ليلة الدهناء تسري بدورها % % فقد غاب واشيها ونام سميرها % % 2(@)(@@) % طلبنا الكرى منها فدلت عليكم % فهل عندكم من فضلة نستعيرها % % 3(@)(@@) % وبدد حر الشوق شمل نسيمها % % عذيري من وجدي بكم وعذيرها % % 4(@)(@@) % وجذوة نار دونذ كر مكانها % % سريرة حب لا يخاف ظهورها % % 5(@)(@@) % تناهيت في كتمانه فنسيته % فلله نفس غاب عنها ضميرها % % 6(@)(@@) % رفعتم سناها للقرى وبخلتم % فما شب إلا في القلوب سعيرها % % 7(@)(@@) % أقول لمغرور سرى في طلابها % % وما قتل البيداء إلا خبيرها % % 8(@)(@@) % حذار عيونا عندها بدوية % يطيل فتورا 
ms24	 في العظام فتورها % % 9(@)(@@) % وغيران لو هبت له الريح ظنها % % رسالة مشغوف بها يستزيرها % % 10(@)(@@) % ولما وقفنا في الديار وعندنا % % مدامع نسديها لكم وتثيرها % % PageV01P092 11(@)(@@) % شكونا إليها ما لقينا من الضنا % % فعرفنا كيف السقام دثورها % % 12(@)(@@) % وقد درست إلا إمارة ذاكر % تلوح له بعد التمادي سطورها % % 13(@)(@@) % ونؤي كسر الكف عاف تعاقبت % على طيه ريح الصبا ودبورها % % 14(@)(@@) % وأورق في سحم عوار كأنها % % به لمم قد لاح فيها قتيرها % % 15(@)(@@) % خليللي قد عم الأسى وتقاسمت % فنون البلى عشاق ليلى ودورها % % 16(@)(@@) % فلا دار إلا دمنة ورسومها % % ولا نفس إلا لوعة وزفيرها % % 17(@)(@@) % لعمر الليالي ما حمدت قديمها % % فيوحشني ذهابها ومرورها % % 18(@)(@@) % وقالوا عطاء الدهر يبلى جديده % ومن لي بدنيا لا يدوم سرورها % % 19(@)(@@) % وعاذلة غابت علي قناعتي % % كأني إذا رمت الغنى أستثيرها % % 20(@)(@@) % ولو أنني خبرتها كيف عزمتي % % على بعدها حنت من الشوق عيرها % % PageV01P093 21(@)(@@) % رويدك حتى يسحب الروض ذيله % وتنشر أعلام الفيافي وقورها % % 22(@)(@@) % فلي همة لو ابعد الله دارها % % عن الشام لم يعرف لمثلي نظيرها % % 23(@)(@@) % فإن أعرضت من دوننا هضباته % وودعنا لبنانها وسنيرها % % 24(@)(@@) % ولاحت ذرى اطواد مصر وفرجت % سجوف الدجا أهرامها وقصورها % % 25(@)(@@) % فقولي لوادي المحل أين نزيله % وللسنة الشهباء كيف فقيرها % % 26(@)(@@) % وقومي اسألي عن منة تغلبية % سرى بشرها قبل الندى وبشيرها % % 27(@)(@@) % إذا بلغت من ناصر الدولة المنى % % فما عذرها ألا توفى نذورها % % 28(@)(@@) % وأبلج من آل المثنى تألفت % لناسبه شهب العلى وبدورها % % 29(@)(@@) % تناخ عتاق العيس حول قبابه % وقد أمنت شد الرحال ظهورها % % 30(@)(@@) % من القوم سنو للملوك شريعة % من المجد كانت أغفلتها دهورها % % PageV01P094 31(@)(@@) % فإن يمنح الألقاب قوم سواهم % فأولها من عندهم وأخيرها % % 32(@)(@@) % لهم سيفها وسعدها وسعيدها % % وناصرها وفخرها ومنيرها % % 33(@)(@@) % كأنكم والأرض أبناء ليلة % فما عرفت إلا ومنكم أميرها % % 34(@)(@@) % إذا أظلمت فيها الليالي جلوتم % عليها وجوها يخجل الشمس نورها % % 35(@)(@@) % وما عدمت منكم يدا ربعية % إذا أمحلت عاذت بها تستجيرها % % 36(@)(@@) % ولا زالت الأمصار تزهى بذكركم % منابرها حتى يطول 
ms25	 قصيرها % % 37(@)(@@) % سبقتم إلى الأيام قبل صروفها % % فما ثبتت إلا عليكم أمورها % % 38(@)(@@) % وصاحبتموها وهي بعد غريرة % فصحت لكم ثم استمر مريرها % % 39(@)(@@) % وأغذيتم الدنيا بفيض نوالكم % فمن عندكم أمطارها وبحورها % % 40(@)(@@) % ولما شكت فقد الكرام إليكم % وكان عليكم بعثها ونشورها % % PageV01P095 41(@)(@@) % أعدتم على طي حميدا وحازما % % فأمرع واديها وفاض غديرها % % 42(@)(@@) % وقد طمعت في حاتم فلعله % بسعدكم يشتاقها فيزورها % % 43(@)(@@) % صنائع إن فادت إليكم صعابها % % فإن طليق العارفات أسيرها % % 44(@)(@@) % لكم ذخرتها العلاقات وأجمعت % على مطلها أعوامها وشهورها % % 45(@)(@@) % وما ذهبت عن قادر قط نعمة % يمن بها إلا إليكم مصيرها % % 46(@)(@@) % شهدت لقد جادت على الارض مزنة % أكفك أحيا كل أرض مطيرها % % 47(@)(@@) % وأنك لو ناديت ساكنة الثرى % % أجاب صداها أو أصاخت قبورها % % 48(@)(@@) % وإن امرأ يسعى إليك بكيده % كباحثة عن مدية تستثيرها % % 49(@)(@@) % يمد إلى نيل السماء بنانه % وتلك أحاديث المنى وغرورها % % 50(@)(@@) % فلو أضمرت فيك الكواكب غدرة % تحير هاديها وضل بصيرها % % PageV01P096 51(@)(@@) % ولو خالفت أفلاكها ما تريده % لأنزلها قسرا إليك مديرها % % 52(@)(@@) % ولو عدمت منك الخلافة نظرة % وهي تاجها العالي وماد سديرها % % 53(@)(@@) % ولو كتمت عنك القلوب سريرة % تربيك ما ضمت عليها صدورها % % 54(@)(@@) % وقد ظهرت آيات سيفك للعدى % % وقام بأمر الله فيهم نذيرها % % 55(@)(@@) % فإن أبت الحساد إلا عنادها % % فقد عرفت سمر العوالي نحورها % % 56(@)(@@) % وكم طالب أمرا وفيه حمامه % وسارية تسعى إلى ما يضيرها % % 57(@)(@@) % لك الخير ما جهد القوافي ببالغ % مداك وإن بذ الرياح حسيرها % % 58(@)(@@) % ولو نظمت فيك النجوم مدائحا % لقصر عن حد الثناء مسيرها % % 59(@)(@@) % ولي فيك آمال طوال وما سمت % إلى غاية إلا وأنت جديرها % % 60(@)(@@) % وما فاتني خير نداك كفيله % ولا غبت عن نعمى وقومي حضورها % % PageV01P097 البحر : خفيف تام 1(@)(@@) % طلب الأمن في الزمان عسير % وحديث المنى خداع وزور % 2(@)(@@) % تبده الحازم الخطوب فإن % قدر أبدت ما أغفل التقدير % 3(@)(@@) % وإذا قتر البخيل فللأ % يام في طي عمره تبذير % 4(@)(@@) % لا تظن الفقيد أفرده البين % ن فقد أعجل المقيم المسير 
ms26	 % 5(@)(@@) % سل بغمدان أين قاطنه سي % ف وقل للنعمان كيف السدير % 6(@)(@@) % عدل الدهر فيهم قسمة الجور % ر فلا عامر ولا معمور % 7(@)(@@) % يا سواد الهمومو صرت على الأيام % لما ضاقت عليك الصدور % 8(@)(@@) % إن في جانب المقطم مهجورا % را ومن أجله تزار القبور % 9(@)(@@) % ومقيما على المعرة تطويه % الليالي وذكره منشور % 10(@)(@@) % وضريحين بالعواصم مبذولين % والصبر عنهما محظور % PageV01P098 11(@)(@@) % وغريبا بالدير بان له العيش % وغاض الندى ومات السرور % 12(@)(@@) % صارم فلت النوائب حديه % وغصن تحت الثرى مهصور % 13(@)(@@) % عصبة كنت أدعي فيهم % % وصبري لؤم عليهم كثير % 14(@)(@@) % وحياتي غدر فهل لوقائي % % أجل عاجل وعمر قصير % 15(@)(@@) % أيها الظاعنون لا زال للغيث % رواح عليكم وبكور % 16(@)(@@) % لست أرضى بالدمع فيكم فهل % يملك ري البحور إلا البحور % 17(@)(@@) % قد رأينا دياركم وعرفنا % % أثرا من عفاتكم مهجور % 18(@)(@@) % وسألنا أطلالها فأجابت % ومن الصمت واعظ ونذير % 19(@)(@@) % أيها الظاعنون لا زال % فارقتها عند الكمال البدور % 20(@)(@@) % تفهم الغافلين كيف يحول % الدهر عن عهده وكيف يجور % PageV01P099 23(@)(@@) % يا نجوم العلى غربتم وما % % أسى ما القلوب إلا صخور % 24(@)(@@) % يا ديار الأحباب غيرك الدهر % فكانت بعد الأمور أمور % 25(@)(@@) % أين أيامنا بظلك والشمل % جميع والعيش غض نضير % 26(@)(@@) % نشوة أعقبت خمارا من الهم % ولكن قد يفرق المخمور % 27(@)(@@) % وزمان مضى فما عرف % إلا بما جناه الأخير % 28(@)(@@) % يا نجوم العلى غرتم وما % % في الليل من بعدكم نجوم تفور % 29(@)(@@) % طال عما عهدتموه ولم % يجر على رسمه الصباح المنير % 30(@)(@@) % وعفا الجود فالكريم بخيل % في الملمات والغني فقير % 31(@)(@@) % وتساوى الورى فلم يبق مشكور % ر على منة ولا معذور % 32(@)(@@) % لا يجاوركم الصعيد بسوء % للنازلين بئس المجير % PageV01P100 33(@)(@@) % وسقاكم من السحاب صناع % الكف يسدي في روضكم وينير % 34(@)(@@) % كل غناء يقطع الغيث عنها % % ولها أعين من النورحور % 35(@)(@@) % عارض مغضب على المحل % لا يخطر إلا وسيفه مشهور % 36(@)(@@) % أشرقت فيه للشقيق خدود % وأضاءت من الأقاحي ثغور % 37(@)(@@) % يثقل الماء خطوه فترجيه % النعامى كما يرجي الحسير % 38 
ms27	(@)(@@) % عم معروفه ففي كل واد % من أياديه روضة وغدير % 39(@)(@@) % وعلى العزم أن يجود عليكم % واهب بالنوال منكم جدير % 40(@)(@@) % ما أرى الشعر كافيا في مراثيكم % ولكن قد ينفث المصدور % 41(@)(@@) % وإذا ما أطلت فيه ولم يشف % غليلا فكله تقصير % PageV01P101 البحر : طويل 1(@)(@@) % خليلي من عوف ابن عذرة إنني % % بكل غرام فيكما لجدير % 2(@)(@@) % كفى حزنا أني أبيت وبيننا % % وسيع الملا والسامرون كثير % 3(@)(@@) % وأصبح مغلوبا على حكم رأيه % وقد عشت دهرا ما علي أمير % 4(@)(@@) % أسيم ركابي في بلاد غريبة % من العيس لم يسرح بهن بعير % 5(@)(@@) % فقد جهلت حتى أراد خبيرها % % بوادي القطين أن يلوح سنير % 6(@)(@@) % وكم طلبت ماء الأحص بآمد % وذلك ظلم للرجاء كبير % 7(@)(@@) % عدوها قويقا واطلبوا لحنينها % % بجانب حسمى أن تهب دبور % 8(@)(@@) % فوالله ما ريح الصبا بحبيبة % إليها ولا ماء الأحص ثمير % 9(@)(@@) % سقى الهضبة الأدماء من ركن جوشن % سحائب تسدي روضة وتنير % 10(@)(@@) % وحل عقود المزن في حجراته % نسيم بأدواء القلوب خبير % PageV01P102 11(@)(@@) % فما ذكرته النفس إلا تبادرت % مدامع لا يخفى بهن ضمير % 12(@)(@@) % نظرت وأعلام الجزيرة بيننا % % وأطواد حسمى إنني لصبور % 13(@)(@@) % بمطروفة الأجفان عائرة القذى % % تقود زمام النجم وهو حسير % 14(@)(@@) % ذرعت بها الظلماء وهي فسيحة % وباشرت فيها النوم وهو عسير % PageV01P103 البحر : رمل تام 1(@)(@@) % أترى طيفكم لما سرى % % أخذ النوم وأعطى السهرا % % 2(@)(@@) % أم ذهلنا وتمادى ليلنا % % فتوهمنا العشاء السحرا % % 3(@)(@@) % ما نلوم الليل بل نعذره % إنمأ طوله من قصرا % % 4(@)(@@) % إن لبسناه ظلاما داجيا % فيما كان صباحا مسفرا % % 5(@)(@@) % يا عيونا بالغضى راقدة % حرم الله عليكن الكرى % % 6(@)(@@) % لو عدلتن تساهمنا جوى % مثلما كنا اشتركنا نظرا % % 7(@)(@@) % سل فروع البان عن قلبي فقد % وهم البارق فيما ذكرا % % 8(@)(@@) % قال في الربع وما أحسبه % فارق الأظعان حتى انفطرا % % 9(@)(@@) % ما على الغيران من سقيا الحمى % % أحرام عنده أن يمطرا % % 10(@)(@@) % وإذا أغضبه ريكم % فسقى الله الفضا والسمرا % % PageV01P104 11(@)(@@) % حبذا فيك حديث طاهر % فطن الدمع به فانتشرا % % 12(@)(@@) % خبر الواشي 
ms28	 وفينا ريبة % توجب التهمة فيما خبرا % % 13(@)(@@) % نظر موه دمعا لم يزل % يفصح الوجد به حتى جرى % % 14(@)(@@) % يا بني العوام هل ذلكم % يمنع الموتور أن ينتصرا % % 15(@)(@@) % دون نيل الضيم نفس حرة % % والمطايا والفيافي والسرى % % 16(@)(@@) % لست من يقبع في حبوته % يتمنى في الأعادي الظفرا % % 17(@)(@@) % أمن العجز مهادا أرى % % طلب العز يثير الخطرا % % 18(@)(@@) % وهو مغلوب على صارمه % يتبع الدهر إذا ما أمرا % % 19(@)(@@) % أيها الراقد عن نهزته % ما يروع السيف حتى يشهرا % % 20(@)(@@) % إنما قومك إن رمتهم % فقعة تسكن وعثا قرقرا % % PageV01P105 21(@)(@@) % شنها فهي على علاتها % % تلبس الجو عجاجا أكدرا % % 22(@)(@@) % علها تسفر عن حادثة % يسبق الأبيض فيها الأسمرا % % 23(@)(@@) % فالهوينا مركب ما خلته % يشرك البادون فيه الحضرا % % 24(@)(@@) % ثلة هوم راعيها فما % % يعتفي سرحانها أن يعقرا % % 25(@)(@@) % قد رجوناك فشمر جاهدا % إنما يدركها من شمرا % % 26(@)(@@) % وابي المجد لقد فاز به % سالك فيه السبيل الأوعرا % % 27(@)(@@) % من بني الأحرار لولا كفه % % سبقت في الجود قيس حميرا % % 28(@)(@@) % معسر مالا ومثر كرما % إنما اترب لما أقترا % % 29(@)(@@) % منتدى قد غرس الظن به % ثم ما أورق حتى أثمرا % % 30(@)(@@) % من كرام رتقت بيضهم % فرج المجد وكانت ثغرا % % PageV01P106 31(@)(@@) % ألفوا ظل العوالي فبنوا % % برماح المجد أبيات القرى % % 32(@)(@@) % نجدة سربلت الأرض وما % وحثت فوق السماء العفرا % % 33(@)(@@) % ونأى الغيث فجادوا ديما % ودجا الخطب فلاحوا غررا % % 34(@)(@@) % ونوال من أكف أوجبت % طاعة الجود فصارت أبحرا % % 35(@)(@@) % سل به يوشك إذ أرسلها % % كقنا الخط خفافا ضمرا % % 36(@)(@@) % قادها هميا فلما وردت % حظر الطعن عليها الصدرا % % 37(@)(@@) % وقعة إن نطق الفخر بها % % فضلت قحطان فيها مضرا % % 38(@)(@@) % وعلى المرج أعادت بيضهم % % كل جون في معد أشقرا % % 39(@)(@@) % أشرعوا فيها أكفا سبطة % علمت وخز العوالي زفرا % % 40(@)(@@) % وجيادا ظنها واثبة % مطرق القين أثار الشررا % % PageV01P107 41(@)(@@) % رهط سوار بن زيد ألفوا % % كرما دثرا وماء ثرثرا % % 42(@)(@@) % واستطالت بعلي لهم % دوحة لم تك تشك القصرا % % 43(@)(@@) % فشآهم وهو من يخبرهم % يجمع الأفق السها والقمرا % % 44 
ms29	(@)(@@) % يا أبا نصر دعاء أمن ال % % من كان به منتصرا % % 45(@)(@@) % أنا عند الذب عن أحسابكم % لجب عب وقرم هدرا % % 46(@)(@@) % لي فيكم عن وداد أمنت % صفوة الإخلاص فيه الكدرا % % 47(@)(@@) % كل غراء شرود حسدت % أول الدهر عليها الأخرا % % 48(@)(@@) % يجد الركب إذا أنشدتها % % عبقة الريح تنوش الزهرا % % 49(@)(@@) % يحبس العجلان عن حاجته % ويصم السمع فيه البصرا % % 50(@)(@@) % فابسط العذر فما زلنا إلى % % بحرك الزاخر نهدي الدررا % % PageV01P108 البحر : كامل تام 1(@)(@@) % أرأيت طيف خيالها لما سرى % % ترك الدجا إلا صباحا مسفرا % % 2(@)(@@) % وافى وقد علق الرقاد بهائم % حكمت عليه همومه أن يسهرا % % 3(@)(@@) % لا تحسدوه على زيارته فما % % منح الوصال وإنما منع الكرى % % 4(@)(@@) % حظ عرفت به فلست أذمه % ولقد يطول الشيء حتى يقصرا % % 5(@)(@@) % وسجية في الغدر كنت أعيبها % % حتى عرفت بها الصديق الأكبرا % % 6(@)(@@) % يا صاحبي وما وثقت بصاحب % إلا تغير وده وتنكرا % % 7(@)(@@) % أرأيتما مثلي يرام قياده % من بعد ما نشط العقال وجرجرا % % 8(@)(@@) % ويسام أن يرضى الخمول وقد أبى % % إيماض وجه الصبح أن يتسترا % % 9(@)(@@) % ما تنقم الأعداء إلا أنني % % أندى يدا منهم وأطيب عنصرا % % 10(@)(@@) % ومن البلية في الزمان معاند % يخزيك أن يعزى إليك ويذكرا % % PageV01P109 11(@)(@@) % ما أهون الدنيا إذا نظر امرء % % فيها وآن لحازم أن ينظرا % % 12(@)(@@) % وأقل ما يجد الحريص مراده % وإذا أراح فما يفوت مقدرا % % 13(@)(@@) % من مبلغ اللؤماء إن ركائبي % % وجدت مراحا للإباء ومصدرا % % 14(@)(@@) % تركت مقاربة الدنى وفارقت % ماء بلوم الواردين مكدرا % % 15(@)(@@) % ورأت عماد الملك أكرم شيمة % من أن يكلفها المناخ الأوعرا % % 16(@)(@@) % ملك يذم من الزمان فخارة % جذلان يهزأ بالقضاء إذا جرى % % 17(@)(@@) % ومتوج يلقى العفاة بوجهه % بشرا كما لمع السحاب وأمطرا % % 18(@)(@@) % كالصارم الهندي إلا أنه % أمضى شبا منه وأكرم جوهرا % % 19(@)(@@) % والليث لولا أنه يندى يدا % ويلين أخلاقا ويحسن منظرا % % 20(@)(@@) % ملأت وقائعه الطروس فلم تدع % في الأرض إلا سائلا أو مخبرا % % PageV01P110 21(@)(@@) % ودعت مواهبه العفاة فلم تذر % في الناس إلا طالبا أو موسرا % % 22(@)(@@) % دامي 
ms30	 الأسنة والظبى فكأنما % % طبعوا له ورد الخدود الأحمرا % % 23(@)(@@) % سموه ذا الحسبين لما قابلوا % % في المجد مرداسا عليه وجعبرا % % 24(@)(@@) % ولو اهتدوا لرأوهما نالا به % شرفا على الشرف التليد ومفخرا % % 25(@)(@@) % قد قلت للأعداء غير مجامل % لهم وأعذر فيهم من أنذرا % % 26(@)(@@) % أما الثغور فإن دون مرامها % % ليثا أشم الساعدين غضنفرا % % 27(@)(@@) % ألقى ذراعيه وأطرق ملبدا % من بعد ما هجر العرين وأصحرا % % 28(@)(@@) % لا تحملوه على العقوق فتوقظوا % % طبا بأدواء العقوق مكدرا % % 29(@)(@@) % جربتموه محاربا ومسالما % % وعرفتموه مصمما ومعذرا % % 30(@)(@@) % وبلوتموه فما وجدتم عنده % إلا الصوارم والوشيج الأسمرا % % PageV01P111 31(@)(@@) % وبدت لكم في النقع بيض سيوفه % فرأيتم فيها الحمام مصورا % % 32(@)(@@) % تلك الوقائع فيكم مشهورة % والسيف ليس يروع حتى يشهرا % % 33(@)(@@) % لا تعد منك أسرة مضرية % نزلت بساحتك الجناب الأخضرا % % 34(@)(@@) % كم أدركت بنداك من أوطارها % % خطرا وكم قرعت بسيفك منبرا % % 35(@)(@@) % أسعرت جمرة عامر وهي التي % % لا تنكر الأعداء أن تتسعرا % % 36(@)(@@) % وحمت مخافتك الجزيرة هيبة % فكأنما قادت إليها عسكرا % % 37(@)(@@) % وتحير الغزي في ظلمائها % % حتى أضاء له النهار فأبصرا % % 38(@)(@@) % إياك أن ترد الفرات فإنه % ماء يعود الجون منه أشقرا % % 39(@)(@@) % فمضى وما وجد الفرار دنية % من خاف حد ظباك أن يتدبرا % % 40(@)(@@) % أو ليس محمود بن نصر دونه % فحذار إن نفع امرأ أن يحذرا % % PageV01P112 41(@)(@@) % يا جامع الحسنات دعوة عائذ % بنداك أدلج في رضاك وهجرا % % 42(@)(@@) % ما كنت أحسب أن جودك يقتضى % % حتى أقول منبها ومذكرا % % 43(@)(@@) % وأخاف فيك من الوشاة ولم تكن % ممن يخاف عليه أن يتغيرا % % 44(@)(@@) % حاشا لعدلك أن ينال مطالبي % % قوم سبقتهم إليك تخيرا % % 45(@)(@@) % فيكون سهمي في الغناء مقدما % عنهم وحظي في العطاء مؤخرا % % 46(@)(@@) % طلعت عليهم من نداك سحابة % تروي البلاد وما تبل لي الثرى % % 47(@)(@@) % وسريت قبلهم إلى إدراكها % % وبدا الصباح فما حمدت به السرى % % 48(@)(@@) % ولقد صبرت وكل صبر نعمة % إلا إذا سر العدى أن أصبرا % % 49(@)(@@) % وأصبت بشرك دون وفرك إنه % ثمن يباع به الكرام ويشترى % % 50(@)(@@) % هذا عتابك 
ms31	 غير أن وراءه % قلبا أرق عليك من أن يهجرا % % PageV01P113 51(@)(@@) % فارجع إلى الرأي الذي جربته % فوجدت ميمون النقيبة مثمرا % % 52(@)(@@) % وامنن علي فقد قدرت وإنما % % أمسكت عن نعماك حتى تقدرا % % 53(@)(@@) % واعلم بأني ما ذخرت نصيحة % عندي فمالك في الندى أن تذخرا % % 54(@)(@@) % وتهن بالعيد الذي شرفته % لما برزت مصليا ومكبرا % % 55(@)(@@) % واسلم له ولكل يوم مثله % حتى تقود عداك فيه وتنحرا % % PageV01P114 البحر : طويل 1(@)(@@) % وأهيف منآد القوى يبذل القرى % % لطارقه جهرا ويمنعه سرا % % 2(@)(@@) % له بزة النساك لولا صناعة % يعاني بها الأطماع أشعث مغبرا % % 3(@)(@@) % يهاب على أن الخمول طباعه % وفي أي أرض حل كانت له سترا % % 4(@)(@@) % إذا صحب النساك اكسبهم قرى % % وإن صحب الحجاج أكسبهم وزرا % % PageV01P115 البحر : مديد تام 1(@)(@@) % أيها النوام ويحكم % قد حملنا عنكم السهرا % % 2(@)(@@) % نحن في ظلماء داجية % ما لها صبح فينتظرا % % 3(@)(@@) % فجرها والصبر بعدهم % ما سمعنا عنهما خبرا % % PageV01P116 البحر : متقارب تام 1(@)(@@) % أرقت لبرق كمتن الحسا % % م يبدو مرارا ويخفى مرارا % % 2(@)(@@) % كأن الصباح أتى زائرا % % إلى الليل ثم تولى فرارا % % 3(@)(@@) % تقول المطايا وقد عزها % % لركب تهادوا عليه حيارى % % 4(@)(@@) % هلموا إلى الجود قد أوقدت % بنو عامر في دجا الليل نارا % % PageV01P117 البحر : خفيف تام 1(@)(@@) % ما أذاعت ريح الصبا لك سرا % إنما عرضت به وهي سكرى % % 2(@)(@@) % وعلى أنها تنم فقد أه % دت نسيما من العذيب وعطرا % % 3(@)(@@) % وأتى البارق الذي بت ترعا % % ه فنونا من الخيانة أخرى % % 4(@)(@@) % بات يطوي ذيل الدجى ويضىء ال % % بيد حتى يظنه الطيف فجرا % % 5(@)(@@) % فمتى يعرف الوفاء وما يذ % كر إلا لوما عليك وعذرا % % 6(@)(@@) % وإذا كنت ما وجدت لأشجا % % نك حرا فمت بدائك حرا % % 7(@)(@@) % يا خليلي قد سئمت أماني % وأنفقت في القناعة عمرا % % 8(@)(@@) % فاطلقا من أزمة العيس ما شا % % ءت فإنا في ربقة الهم أسرى % % 9(@)(@@) % زاد عرض الفلا عليها كما طال % % الدجى فهي والكواكب حسرى % % 10(@)(@@) % تترامى بها البلاد وما تشد % إلا رسما من الجود قفرا % % PageV01P118 11(@)(@@) % فاعذراها إن 
ms32	 أخفقت فلقد را % % مت عسيرا من المطالب وعرا % % 12(@)(@@) % نقص الدهر حظها من بنيه % فهي تبغي حظا وناسا ودهرا % % 13(@)(@@) % ولعمري لقد % كفاها نصير ال % % 14(@)(@@) % رتعت من جنابه في رياض % % ضوعتها فيه ثناء وذكرا % % 15(@)(@@) % وسرى جوده إليها على البعد كما % % تحمل النسائم عطرا % % 16(@)(@@) % وردت مشرع المكارم ملآ % % ن وحيت وجه الزمان أغرا % % 17(@)(@@) % طلعة كالصباح يلمع فيها % % بارق للسماح سموه بشرا % % 18(@)(@@) % وبنان إذا تجهمت الأنواء % % أحرى به سحائب عشرا % % 19(@)(@@) % يسبق السمهري طولا وطولا % ويفوت الهندي أثرا وأثرا % % 20(@)(@@) % شرفا يا بني فزارة قد أحيا % % نداه عليك حصنا وبدرا % % PageV01P119 21(@)(@@) % وغنى عن مواهب المزن بالغور % ر فقد صارت البحيرة بحرا % % 22(@)(@@) % حل فيك ابن ملهم وخصيب % الروض ما كان عيشه مستقرا % % 23(@)(@@) % عارض يستهل جودا وفيه % بارق ربما توقد جمرا % % 24(@)(@@) % فجرى ماؤه مواهب بيضا % وورت ناره قواضب حمرا % % 25(@)(@@) % قد عرفنا ضرامه كيف يصلى % % وعلمنا غمامه كيف يمرا % % 26(@)(@@) % فوجدنا جناه في السلم حلوا % ورأينا لظاه في الحرب مرا % % 27(@)(@@) % خطرات الزمان بؤسى ونعمى % % وفنون الأقدار نفعا وضرا % % 28(@)(@@) % علم الناس كيف يسعى إلى % % المجد ولكن باتوا نياما وأسرى % % 29(@)(@@) % وأراهم من جوده كل عذراء % على أنها مواهب تترى % % 30(@)(@@) % وإذا عد حامدا وعليا % وسليم الندى وكعبا وبكرا % % PageV01P120 31(@)(@@) % منة لم يجد بها غير كفيه % فأعجب بها عوانا وبكرا % % 32(@)(@@) % سبق الناس أولا وأخيرا % % وحوى المكرمات بدوا وحضرا % % 33(@)(@@) % طرق الشام من فراقك خطب % لا يرى بعده من العسر يسرا % % 34(@)(@@) % علم الروم أن سيفك حاميه % فقد حاولوا لبعدك أمرا % % 35(@)(@@) % وأجاب المحاربون إلى السلم % فرارا من الطعان وكفرا % % 36(@)(@@) % وإذا ما خلا العرين من الليث % أغار السرحان فيه وكرا % % 37(@)(@@) % عودتهم ظباك جامحة الفر % الفر وسنت فيهم جيادك ذعرا % % 38(@)(@@) % وتحامتكم المعاقل لما % % ملكتها لك الصوارم قسرا % % 39(@)(@@) % طلعت نحوهم من الجون % جون وجدوها باللاذقية شقرا % % 40(@)(@@) % مقربات مثل السراحين إلا % أنها تقنص الفرائس جهرا % % PageV01P121 41(@)(@@) % وخميس ألقى على طرف السا % % حل شطرا وفي 
ms33	 العواصم شطرا % % 43(@)(@@) % قاده مرهف العزيمة والرأ % % ي إذا قدم المحارب غيرا % % 44(@)(@@) % هذبت فكره التجارب حتى % % هتكت دونه من الغيب سترا % % 45(@)(@@) % رفع الله من لوائك لما % % كان عزا للمسلمين ونصرا % % 46(@)(@@) % طلت قدرا عن المديح فما أذهب % هب فيه إلا وفاء وشكرا % % 47(@)(@@) % زفرات أثرتهن من الشوق % وإن كن في المسامع شعرا % % 48(@)(@@) % وثناء كأنما أطلع الصبح % ضياء وأرج الروض نشرا % % 49(@)(@@) % يخبر الناس إن في ذكر إحسانك % دينا وفي ثنائي سحرا % % PageV01P122 البحر : طويل 1(@)(@@) % خليلي بثا ما أملت عليكما % % دموعي فإني ما أريد الهوى سرا % % 2(@)(@@) % أصابكما برح الغرام لعله % يمهد لي ما بين قلبيكما عذرا % % 3(@)(@@) % سقى الله أياما من الدهر لم تشب % بهم كأنا ما عرفنا بها الدهرا % % 4(@)(@@) % ومائلة الأعطاف من نشوة الصبا % % سقتني الهوى صرفا ورنحها سكر % 5(@)(@@) % رمت عينها عيني وراحت سليمة % فمن حاكم بين الكحيلة والعبرى % % 6(@)(@@) % فيا طرف قد حذرتك النظرة التي % % خلست فما راقبت نهيا ولا أمرا % % 7(@)(@@) % ويا قلب قد أرداك من قبل مرة % % فويحك لو طاوعته مرة أخرى % % PageV01P123 البحر : سريع 1(@)(@@) % يا لغني ما لناديكم % قد فقد الطارق والسامرا % % 2(@)(@@) % وأهمل السرح بأرجائه % لا ذائدا فيه ولا عاقرا % % 3(@)(@@) % لعل عضبا للردى بائرا % أصاب عضب الدولة الباترا % % 4(@)(@@) % ما وجد الوارث من بعده % إلا حديثا في العلا سائرا % % 5(@)(@@) % راح بنجلاء كلابية % تسفح جودا في الثرى قاطرا % % 6(@)(@@) % فما لهذا البيت من عامر % لم يبق بيتا للندى عامرا % % PageV01P124 البحر : متقارب تام 1(@)(@@) % حبتك السماء بأمطارها % % وكيف تضن على جارها % % 2(@)(@@) % ولا برحت في ثراك الرياض % تفض لطائم نوارها % % 3(@)(@@) % وقد ناب عنها جميل الثنا % % فذكرك أعبق أزهارها % % 4(@)(@@) % أطلت ليالي حتى ظننت % أنك نبت بأسحارها % % 5(@)(@@) % وغادرت دمعي رقيب الجفون % فباعدت ما بين أشفارها % % 6(@)(@@) % وبي لوعة منك ما تطمئن % فأشكو إليك بمقدارها % % 7(@)(@@) % فلهفي عليك لشعث العفا % % ة ترمي إليك بامطارها % % 8(@)(@@) % تجوب المهامة حتى تنيخ % بقاري العشيرة عفارها % % 9(@)(@@) % وساغبة عللت في الظلام % بنيها بقربك 
ms34	 من دارها % % 10(@)(@@) % فكنت إلى بذل ما أملته % أسرع من وهم أفكارها % % PageV01P125 11(@)(@@) % وبهماء تلمح فيها النجوم % مصيفة بين أقطارها % % 12(@)(@@) % تعسفتها ساريا والقطا % % جوائر عن نهج أوكارها % % 13(@)(@@) % وعان دعاك وصحب الهموم % تروح عليه بسمارها % % 14(@)(@@) % فأنفذته من يد الحادثات % وقد علقته بأظفارها % % 15(@)(@@) % ونجلاء تهزأ أرجاؤها % % بأيدي الأساة ومسمارها % % 16(@)(@@) % فضلت بها خطرات الظنو % % ن بين القلوب وأغمارها % % 17(@)(@@) % ولهفي عليك وهوج الريا % % تسحب أذيال أعصارها % % 18(@)(@@) % بغبراء تعرق كوم المطي % حتى تنوء بأوبارها % % 19(@)(@@) % جلوت غياهبها والكرام % تقري الضيوف بأعذارها % % 20(@)(@@) % وجدل سيفك شول اللقاح % % وقد كسعوها بأغبارها % % PageV01P126 21(@)(@@) % تقسمها ورباب القداح % % معطلة عند أيسارها % % 22(@)(@@) % ولهفي لأخوان صدق أطلت % عليها بقية أعمارها % % 23(@)(@@) % ملكت ضمائرها وأسترق % جودك ربقة أحرارها % % 24(@)(@@) % فإن نزحوا فيك ماء الجفون % فإنك إنسان أبصارها % % 25(@)(@@) % وإن عقروا لك حب القلوب % فقد كنت موضع أسرارها % % 26(@)(@@) % برغمي نزلت بدار تقيم % رهن ثراها وأحجارها % % 27(@)(@@) % تدار وليس بها من قرا % % إلا الغرام لزوارها % % 28(@)(@@) % وكنت بعلياء مطروقة % يضيء النجوم سنا نارها % % 29(@)(@@) % إذا عرست في ذراها الركاب % فقد آمنت شد أكوارها % % 30(@)(@@) % ولو نزلت بك فيها العصاة % حملت صحائف أوزارها % % PageV01P127 31(@)(@@) % أبا حسن هي دنيا تنال % أقدارها فوق أقدارها % % 32(@)(@@) % جرت في أبيك على عادة % تموت الكرام بأوتارها % % 33(@)(@@) % وقد صفحت عنك من بعده % فإظلامها مثل إسفارها % % 34(@)(@@) % جريت على نهجه في العلا % % فكان خبيرا بأوعارها % % 35(@)(@@) % وجاد لنا بك بعد الكرام % % فصدق كاذب أخبارها % % PageV01P128 البحر : كامل تام 1(@)(@@) % آمبيحها فضل الأزمة قصر % فمع الصباح تحية من عرعر % % 2(@)(@@) % هبت تهاداها البروق وبينها % % نشب الخداع وهزه المتذكر % 3(@)(@@) % والليل قد أخذ السرى من شبهه % وأعاره ذلل القلاص الضمر % 4(@)(@@) % يا بانتي إضم ومن دين الهوى % % بث السؤال لكل من لم يخبر % 5(@)(@@) % أعلمتما قلبي أقام مكانه % أم سار في طلب الصباح المسفر % % 6(@)(@@) % أبلغ أبا حسان أن قلاصه % تجتاب أردية العجاج الأغبر % 7(@)(@@) % مطرودة وعلى الشريف فوارس % % يترنحون مع الوشيج الأسمر % 8(@)(@@) % أخذوا مناسمها 
ms35	 الرياح عشية % ونجوا وقومك فقعة بالقرقر % 9(@)(@@) % وزعمت أن البخل حامي سرحها % % أفهل أمنت الشك أم لم تعقر % 10(@)(@@) % كن في الطراد لبان طرفك مقدما % وإذا دعيت إلى الطراد فشمر % PageV01P129 11(@)(@@) % واهجر نضارك مثل هجرك للقرى % % إن المكارم في السبيل الأوعر % 12(@)(@@) % أفما ترى ابن العامرية سبة % شنعاء مثل حديثها لم يؤثر % 13(@)(@@) % ترك الفخار لعصبة يمنية % غلبت على الحسب الذي لم يغمر % 14(@)(@@) % أفلا يحاذر أن يقول مخبر % في الحي قصر عامر عن حمير % 15(@)(@@) % سبقت كنانة فليثق من رامها % % بالعجز عن شأو الصباح الأشقر % 16(@)(@@) % قوم أضاؤا والخطوب بهيمة % كالبيض تلمع في خلال العثير % 17(@)(@@) % يتغايرون على الندى فكأنما % % يجد الغني عداوة للمعسر % 18(@)(@@) % ويسارعون إلى الوغى وسيوفهم % مغلولة وكلومهم لم تسبر % 19(@)(@@) % ألفت رماحهم الطيور كأنهم % رتقوا بها خلل العجاج الأكدر % 20(@)(@@) % لا يرقدون سوى معرس ساعة % يتفيئون بها ظلال الضمر % PageV01P130 21(@)(@@) % من كل وراد الوغى بحسامه % والحتف معترض طريق المصدر % 22(@)(@@) % حرم الأباء على الاسنة ظهره % % فالموت مفزعه إذا لم يظفر % 23(@)(@@) % لانوا وفيهم للعدو قساوة % % كالماء يغرف وهو غير مكدر % 24(@)(@@) % في منقذ شرف فإن وصلت به % عجل فليس وراءه من مفخر % 25(@)(@@) % سبق الكرام وأخر ابن مقلد % عنهم فكان السبق للمتأخر % 26(@)(@@) % شهرت مناقبهم وزاد فعاله % عن شأوها فكأنها لم تشهر % 27(@)(@@) % إن الأصول وإن زكت أغراسها % % لولا الغصون فروعها لم تثمر % 28(@)(@@) % إن جاودوه فحاتم في طيه % أو نازلوه فعامر في جعفر % 29(@)(@@) % يبدي على عيب الزمان وكلما % % صقل الحسام أفاض ماء الجوهر % 30(@)(@@) % شرفت أسرة وجهه بحيائه % شرق الصوارم بالنجيع الأحمر % PageV01P131 31(@)(@@) % وأراد إخفاء الندى فأذاعه % لا يظهر المعروف ما لم يستر % 32(@)(@@) % بيني وبينك حرمة ما غالها % % ولع الخطوب وذمة لم تخفر % 33(@)(@@) % ومودة مزجت بأيام الصبا % % ورأت تغيره فلم تتغير % 34(@)(@@) % يفديك كل جديدة نعماؤه % % وعر السبيل إلى العلاء مؤخر % 35(@)(@@) % تتعجب الأيام كيف أطاعه % قدر وفاز منيحه في الميسر % 36(@)(@@) % وعد كما خدع الجهام وبرقه % كذب وعارض مزنه لم 
ms36	 يمطر % 37(@)(@@) % عد الزمان لئامه فاستوقفت % تلك الخلال عليه عقد الخنصر % 38(@)(@@) % أهون به ما كنت يا ابن مقلد % عوني عليه وكان قومك معشري % % 39(@)(@@) % أثني عليه بما علمت وبعضه % يعيي البليغ وإن خبرت فخبر % 40(@)(@@) % وإذا أطلت وكان يقصر عاجزا % شكري فأعجب بالمطيل المكثر % PageV01P132 البحر : طويل 1(@)(@@) % رمى الدهر دوني وهو جم صروفه % وكلفني ما لا يقوم به شكري % % 2(@)(@@) % فإن شغلت نفسي بغير مديحه % فعدت إلى ما كنت فيه مع الدهر % PageV01P133 البحر : طويل 1(@)(@@) % يحاربني في كل نائبة دهري % % كأن الرزايا تدرك الفخر في قسري % % 2(@)(@@) % أضم لسعد شارد المجد والعلى % % وسعد يراني بالتشاوس والشزر % 3(@)(@@) % يحاول أن أرضى الدنية طائعا % وأغدو بلا ناب يروع ولا ظفر % 4(@)(@@) % ومن دون ذلي عصبة عامرية % يلوون أعطاف المثقفة السمر % 5(@)(@@) % إذا فوق الوسمي إبراد حاجر % واثرت شعاب الواديين من القطر % 6(@)(@@) % فلا تأمنوا أن تسمعوها مرنة % بقرع العوالي والمهندة البتر % 7(@)(@@) % يقول أبو حزن طلبنا لك الغنى % % فلم أخذت كفاك في طلب الفقر % 8(@)(@@) % فقلت رأيت المال يبلى حطامه % وتبقى أحاديث الرجال مع الدهر % 9(@)(@@) % وشيبان لباني فلما بلوته % تقاعس عني والأسنة في نحري % % 10(@)(@@) % تحمل عار الذل واطرح الردى % % وطوقها شنعاء أبقى من الذكر % PageV01P134 11(@)(@@) % وقارعني ذلان عيش على الندى % % كما قارع الغيران عن بيضة الخدر % 12(@)(@@) % أغادرتموها في الشريف خوامسا % طلائح لم تعسف بسوق ولا زجر % 13(@)(@@) % فهل فيكم أن تمنعوا نزواتها % % بميسم عار فيكم ثابت الذكر % 14(@)(@@) % أرمتم مديحي واطرحتم ثوابه % وهل تملك الحسناء إلا على مهر % 15(@)(@@) % فما لي أرضى منكم بدنية % تحض الرجال الأبعدين على نصري % % 16(@)(@@) % وفي الحي محمود بن نصر بن صالح % أخو الغارة الشعواء والكرم الدثر % 17(@)(@@) % أقلها من الحي اللئيم ونادها % % مراحك هذا آخر العهد بالضر % 18(@)(@@) % فإن هي حنت في بيوت بن صالح % % فلا عقلت إلا قيودا من العقر % 19(@)(@@) % من القوم صال الدهر إلا عليهم % وصالوا ببيض الهند حتى على الدهر % 20(@)(@@) % لهم في قراع المحل أيد كأنما % % يعدونها 
ms37	 وقفا على الحجج الغبر % PageV01P135 21(@)(@@) % إذا سئلوا خلت الندى في أكفهم % تشرب ماء في وجوههم الغر % 22(@)(@@) % وإن أخصبوا بالطعن عادوا من الندى % % سراعا إلى داعي الخصاصة والعسر % 23(@)(@@) % تميس بهم في طاعة الجود هزة % % كما طرب النشوان من نشوة الخمر % 24(@)(@@) % وما كاثرت جنح الظلام سوامهم % فروحها الرعيان إلا على النحر % 25(@)(@@) % إذا انتسبوا خلت السماء تهافتت % عليهم وبانت من كواكبها الزهر % 26(@)(@@) % هم البيض إلا أنهم واصلوا القرى % % وقدو الطلى والبيض تفري ولا تقري % % 27(@)(@@) % وجوه كايماض الصوارم أشرقت % من الحسب الوضاح والنائل الغمر % 28(@)(@@) % وخيل تبارى بالرماح كأنما % % أغارت على ما في الرماح من الضمر % 29(@)(@@) % وبيض بها ماء الفرند كأنه % دموع الغوادي جلن في حدق الزهر % 30(@)(@@) % حبيب إليهم أن تلم ملمة % وتطرفهم فيما أصابوا من الوفر % PageV01P136 31(@)(@@) % هم ظفروا بالعز عن سيف صالح % وغر المعالي عن ثمال وعن نصر % 32(@)(@@) % ونالوا بعز الدولة المجد شائدا % لما أثلوه من علاء ومن فخر % 33(@)(@@) % فتى ذلل الأيام حتى تثقفت % على الهون وانقاد الزمان على القسر % 34(@)(@@) % إذا شرد المعروف أو جمع العلى % % رأيت الفعال السهل في المطلب الوعر % 35(@)(@@) % أشد احتقارا للردى من حسامه % وأدنى إلى شر الأعادي من الذعر % 36(@)(@@) % له خلق في المحل غيث وفي الصبا % % نسيم وفي جنح الدجا غرة الفجر % 37(@)(@@) % حدوت إليه المدح حرا وطالما % % بخلت به حتى تقاعس في فكري % % 38(@)(@@) % وأكبرت قدري أن يجود به فمي % % ونزهت نفسي أن يجيش به صدري % % 39(@)(@@) % فجاد على إحجامه بشوارد % % جوائل في الآفاق مصرا إلى مصر % 40(@)(@@) % إذا غرد الحادي بها خفرت به % حنينا وأضحى وهو حاسدها يطري % % PageV01P137 البحر : طويل 1(@)(@@) % وليلة وصل غاب عنا رقيبها % % مع الدهر لا عاد إلى آخر الدهر % 2(@)(@@) % نهينا بها جنح الظلام فما بدت % أوائله حتى خلطناه بالفجر % PageV01P138 البحر : كامل تام 1(@)(@@) % أسرفت في أنس الغريب وبره % ورفعت من قدر البعيد بذكره % 2(@)(@@) % وبعثت في ريح الشمال تحية % عادت إليك بعبقة من شكره % 3(@)(@@) % لا تعجبن لحرها 
ms38	 من بعد ما % % بردت فقد مرت بلوعة صدره % 4(@)(@@) % وسألت عنه وما يذم زمانه % لو كان يعرف ليله من فجره % 5(@)(@@) % متقسم العزمات ينفق عمره % سرفا على نهي الزمان وأمره % 6(@)(@@) % غدرت به أيامه في عفة % من ماله وصيانة من شعره % 7(@)(@@) % فإذا أراد مديح مثلك أظلمت % سدف الهموم على مطالع فكره % PageV01P139 البحر : طويل 1(@)(@@) % لحا الله مغلوبا على نصل سيفه % مقيما على نهي الزمان وأمره % 2(@)(@@) % أناخ بدار الهون حتى كأنما % % يرى الرزق مقصورا على مستقره % PageV01P140 البحر : بسيط تام 1(@)(@@) % إن كان ليلي طويلا بعد بينكم % فقد نعمت بكم والليل كالسمر % 2(@)(@@) % ما أظلم الدهر ليلي في فراقكم % بليل وصلكم فالطول بالقصر % PageV01P141 البحر : كامل تام 1(@)(@@) % ومفوق ألحاظه وسهامه % وكأن ما في جفنه في خصره % 2(@)(@@) % ملك الزمان بأسره فنهاره % في وجهه وظلامه في شعره % 3(@)(@@) % وسطا على الصهباء حتى لونها % % من خده وحبابها من ثغره % PageV01P142 البحر : طويل 1(@)(@@) % فأجابه : على أي حال فيك أعجب للغدر % وما أنت إلا واحد من بني الدهر % 2(@)(@@) % سجية حظ عازب ما نكرتها % % وخطة جور قد ألفت بها صدري % % 3(@)(@@) % فكن كيف ما شاء الزمان فإنه % لديك مطاع القول ممتثل الأمر % 4(@)(@@) % وذرني فما أعددت بعدك ساعدي % % معيني ولا صدري أمينا على سري % % 5(@)(@@) % ولكن شجاني أن ودك ضاع من % يدي وقد أنفقت في كسبه عمري % % 6(@)(@@) % فلو علقت نفسي بغيرك لم تكن % تؤمله إلا ليشفع في الحشر % 7(@)(@@) % شباب تقضى في هواك وشرد % مطوحة الأبناء جائلة الذكر % 8(@)(@@) % أغار عليها أن تعان بشافع % إليك وتسعى في رضاك على قسر % 9(@)(@@) % ويكتمها الراوي حياء وعرفها % % ينم كما نم النسيم على الزهر % 10(@)(@@) % % علقت بها عطف الخيال الذي يسري % % PageV01P143 11(@)(@@) % عهدتك مطواف الهوى كل ليلة % تروح إلى وصل وتغدو على هجر % 12(@)(@@) % إذا أحكمت فيك العهود زمامها % % فذلك أدنى ما تكون إلى الغدر % 13(@)(@@) % رضاك على سخط وصفوك في قذى % % وحبك في بغض وحلمك عن غمر % 14(@)(@@) % خلائق تفويف الرياض كأنما % % سقاها سحاب من 
ms39	 أناملك العشر % 15(@)(@@) % ووجه يخال البشر فيه عن الرضى % % وما كل ضوء لاح من وضح الفجر % 16(@)(@@) % فمالك ترميني بعتب جهلته % فلم أر فيه وجه ذنبي ولا عذري % % 17(@)(@@) % وكيف أضلتني الهموم وطوحت % بلبي حتى صرت أجني ولا أدري % % 18(@)(@@) % طويت على غل ضميرك بعد ما % % توهمت أن السر عندك كالهجر % 19(@)(@@) % فما أعربت عنك الجفون بنظرة % إذا بثت الأحقاد بالنظر الشزر % 20(@)(@@) % تغل على العتب بين دلائل الصفاء % % وتجلو الحقد في رونق البشر % PageV01P144 21(@)(@@) % فما كنت إلا السيف يسعر حده % ضرام الوغى والماء في متنه يجري % % 22(@)(@@) % فأي خليل بالتجني حملته % على الخطة الشنعاء والمركب الوعر % 23(@)(@@) % وأي حسام فل رأيك حده % وقد كان يفري والقواضب لا تفري % % 24(@)(@@) % فلو لم أر البقيا أطعت حفيظتي % % عليك ولكن ليس قلبك في صدري % % 25(@)(@@) % وكنت جديرا أن أبيت وبيننا % % مهامه تسري الشهب فيها على ذعر % 26(@)(@@) % يضل بها عني خيالك قصده % ولو ركب الجوزاء أو صهوة البدر % 27(@)(@@) % وهيهات لو ناديتني ساكن الثرى % % أجبت فصيحا لا صدى جانب القبر % 28(@)(@@) % وإني وإن كانت سماؤك أمطرت % سحائب عرف ناء في حمله ظهري % % 29(@)(@@) % لأعلم أني بانتسابي إليكم % على الكرم الوضاح والمنصب الجر % 30(@)(@@) % جريت بأوفى ما تطول به يدي % % وجدت بأعلى ما يضن به شكري % % PageV01P145 31(@)(@@) % غضبت على جدواك نفسا أبية % فصار غنائي عنك أوضح من فقري % % 32(@)(@@) % وعلمتني بذل النوال توكلا % عليك كما جاد السحاب من البحر % 33(@)(@@) % فإن كان إدلائي عليك جناية فإنك % أهل للتعمد والغفر % % 34(@)(@@) % ولست بعيدا من رضاك وبيننا % % مواثق تلغى في وسائلها وزري % % 35(@)(@@) % وكم لك عندي منة ما وفى بها % % ثنائي فلا شكري رضيت ولا كفري % % 36(@)(@@) % وقبلك ما عرضت نفسي لنائل % يعد ولا رمت الرواء من القطر % 37(@)(@@) % ولا كنت إلا راضيا بقناعة % أعيش بها بين الخصاصة واليسر % 38(@)(@@) % ولكن حظي من سحابك شيمة % تكثر حسادي وترفع من قدري % % 39(@)(@@) % فداك كريم جاد من فضل ماله % فإنك ما أعطيت إلا على عسر % 40(@)(@@) % فكيف 
ms40	 عميد بالثراء قلاصه % قلاص الثريا لا تخاف من النحر % PageV01P146 41(@)(@@) % ولا زلت أحلى في الجفون من الكرى % % وحبك أحلى في القلوب من الذكر % PageV01P147 البحر : سريع 1(@)(@@) % واخجلتا للطيف لما سرى % % في خطر الليل إلى ساهر % 2(@)(@@) % زيارة ضاعت ولكنها % % جناية الشوق على الزائر % PageV01P148 البحر : كامل تام 1(@)(@@) % ألا أرقت للمع برق سار % باتت تجرده يد الأمطار % 2(@)(@@) % يبدو ويخفيه الحيا فكأنه % عزم تجاذبه من الأفكار % 3(@)(@@) % وافى على شعث أضاع كراهم % خصب اللئام وضيعة الأحرار % 4(@)(@@) % عمدوا إلى أسيافهم فكأنها % % آلت لتنجدهم على الأقدار % 5(@)(@@) % يحدو بعزهم كريم قبيلة % ذل العدو بها وعز الجار % 6(@)(@@) % يرتاح للبرق المضيء ولو رمى % % في كل جارحة بحذوة نار % 7(@)(@@) % أخيال عذبة ما هداك لعصبة % صحبوا الدجا نشوى بغير عقار % 8(@)(@@) % ما زال عضب البين يفري شملهم % حتى طرقتهم على الأكوار % 9(@)(@@) % يا دار سقيا للكثيب وصحبنا % % آرامه والليل لون عذار % 10(@)(@@) % أيام فيك إذا تشاء يد الهوى % % جادت ببدر دجا وشمس نهار % PageV01P149 11(@)(@@) % قصرت لياليهن إلا أنها % % تذر النفوس طويلة التذكار % 12(@)(@@) % هزيج ينظم فوق أجياد الربا % % سمطي عرار فائح وبهار % 13(@)(@@) % زهر كزهر الشهب إلا أنه % متبسم من دمعهن الجاري % % PageV01P150 البحر : كامل تام 1(@)(@@) % أما الزمان فموجز في وعظه % وظفرت بالإشهاب في إيجازه % 2(@)(@@) % لا تخدعن فما حقيقة أمره % عند النهى إلا كمثل مجازه % 3(@)(@@) % سبق اللئام به الكرام كأنما % % قيدت هواديه إلى إعجازه % 4(@)(@@) % كم موعد منه تعلق طامع % سفها فحال الموت دون نجازه % 5(@)(@@) % من كان مقتنعا فقد وجد الغنى % % في شامه وعراقه وحجازه % PageV01P151 البحر : رجز تام 1(@)(@@) % ما ذكر الروض وقد تنفسا % % غير حديث الركب حين عرسا % % 2(@)(@@) % ركب هوى تجاذبوا حديثه % فأترعوا من الغرام أكؤسا % % 3(@)(@@) % وأسبلوا من الجفون أدمعا % % ظننتها ماء وكانت أنفسا % % 4(@)(@@) % يا صاحبي رحلي بجرعاء الحمى % % ما يعذل الخائف إن تجسسا % % 5(@)(@@) % لقد سمعت في الرحال أنة % أظنها نشطة وجد حبسا % % 6(@)(@@) % ويا خليلي املكا طرفيكما % % لا تنظران الحي حين غلسا % % 7(@)(@@) % فإن قلبي 