ms2501	 عبد الكريم، عن مجاهد، قال: «كل لعب لهو»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وإن الدار الآخرة لهي الحيوان} (@)(@@) [العنكبوت: 64](@)(@@) PageV09P3081(@)(@@)(@@)(@@) | 17430 - (@)(@@) حدثنا أبي، ثنا الهيثم بن يمان، ثنا إسماعيل بن زكريا، حدثني محمد بن عون الخراساني، عن ابن عمر، قوله: {الدار الآخرة} [البقرة: 94] يقول: «الجنة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {لو كانوا يعلمون} (@)(@@) [البقرة: 102](@)(@@) PageV09P3081(@)(@@)(@@)(@@) | 17431 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، {وإن الدار الآخرة لهي الحيوان} [العنكبوت: 64] قال: «الحياة الدائمة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17432 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، {لهي الحيوان} [العنكبوت: 64] يقول: «باقية»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17433 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، {وإن الدار الآخرة لهي الحيوان} [العنكبوت: 64] «لا موت فيها»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17434 - (@)(@@) حدثنا محمد بن يحيى، ثنا العباس بن الوليد، ثنا يزيد بن زريع، قال(@)(@@)(@@)(@@) | [ص: 3082](@)(@@) : سمعت سعيدا، عن قتادة، {وإن الدار الآخرة لهي الحيوان لو كانوا يعلمون} [العنكبوت: 64] «حياة لا موت فيها»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فإذا ركبوا في الفلك} [العنكبوت: 65] تقدم تفسيره(@)(@@) PageV09P3082(@)(@@)(@@)(@@) | قوله تعالى: {دعوا الله مخلصين له الدين} (@)(@@) [يونس: 22](@)(@@) PageV09P3082(@)(@@)(@@)(@@) | 17435 - (@)(@@) حدثنا أبي، ثنا قبيصة بن عقبة، ثنا سفيان، عن الأعمش، عن عمرو بن مرة، عن أبي عبيدة، في قوله: {مخلصين له الدين} [العنكبوت: 65] «قوله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فلما نجاهم إلى البر إذا هم يشركون} (@)(@@) [العنكبوت: 65](@)(@@) PageV09P3082(@)(@@)(@@)(@@) | 17436 - (@)(@@) حدثنا محمد بن يحيى، ثنا العباس، ثنا يزيد، سمعت سعيدا، عن قتادة، قوله: {فلما نجاهم إلى البر إذا هم يشركون} [العنكبوت: 65] قال: «والخلق كلهم يقرون لله أنه ربهم، ثم يشركون بعد ذلك»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ليكفروا بما آتيناهم وليتمتعوا فسوف يعلمون} (@)(@@) [العنكبوت: 66](@)(@@) PageV09P3082(@)(@@)(@@)(@@) | 17437 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن فضيل، عن أبيه، عن إسماعيل بن مسلم، عن الحسن، {فسوف يعلمون} [العنكبوت: 66] قال: «وعيد»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17438 - (@)(@@) حدثنا أبي، ثنا أبو حذيفة، ثنا شبل، عن ابن أبي نجيح، عن مجاهد، قوله: {فسوف يعلمون} [العنكبوت: 66] «ما كان في الدنيا فسوف. . . وما كان في الآخرة فسوف يبدو لكم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أولم يروا أنا جعلنا 
ms2502	 حرما آمنا} (@)(@@) [العنكبوت: 67](@)(@@) PageV09P3082(@)(@@)(@@)(@@) | 17439 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو عبد الرحمن، عن جويبر، عن الضحاك، {أولم يروا أنا جعلنا حرما آمنا} [العنكبوت: 67] قال: «جعل مكة إنا جعلناها حرما آمنا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17440 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، ثنا عبد الرحمن بن زيد بن أسلم، قول الله: {أنا جعلنا حرما آمنا} [العنكبوت: 67] قال: «يعني مكة وهو قريش»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ويتخطف الناس من حولهم} (@)(@@) [العنكبوت: 67](@)(@@) PageV09P3083(@)(@@)(@@)(@@) | 17441 - (@)(@@) حدثنا أبو سعيد، ثنا أبو عبد الرحمن، عن جويبر، عن الضحاك، {ويتخطف الناس من حولهم} [العنكبوت: 67] يقول: «يقتل بعضهم بعضا، ويسبي بعضهم بعضا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17442 - (@)(@@) حدثنا محمد بن يحيى، ثنا العباس بن الوليد، ثنا يزيد بن زريع، قال: سمع سعيدا، عن قتادة، قوله: {أولم يروا أنا جعلنا حرما آمنا ويتخطف الناس من حولهم} [العنكبوت: 67] قال: «قد كان لهم في ذلك آية، أن الناس يغزون ويتخطفون وهم آمنون»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أفبالباطل يؤمنون} (@)(@@) [النحل: 72](@)(@@) PageV09P3083(@)(@@)(@@)(@@) | 17443 - (@)(@@) حدثنا محمد بن يحيى، ثنا العباس بن الوليد، ثنا يزيد بن زريع، قال: سمعت سعيدا، عن قتادة، قوله: {أفبالباطل يؤمنون} [العنكبوت: 67] «أي بالشرك»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وبنعمة الله يكفرون} (@)(@@) [العنكبوت: 67](@)(@@) PageV09P3083(@)(@@)(@@)(@@) | 17444 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: {بنعمة الله} [العنكبوت: 67] يعني «عافية الله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17445 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: {نعمة الله} [البقرة: 211] قال: «النعم آلاء الله عز وجل»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ومن أظلم ممن افترى على الله كذبا} [الأنعام: 21] إلي قوله: {للكافرين} (@)(@@) [البقرة: 24](@)(@@) PageV09P3083(@)(@@)(@@)(@@) | 17446 - (@)(@@) حدثنا أبو عبد الله الطهراني، ثنا حفص بن عمران، ثنا الحكم بن أبان، عن عكرمة، قال: قال النضر، وهو من بني عبد الدار: " إذا كان يوم القيامة شفعت لي اللات والعزى فأنزل الله: {ومن أظلم ممن افترى على الله كذبا} [الأنعام: 21] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أليس في جهنم مثوى للكافرين} (@)(@@) [العنكبوت: 68](@)(@@) PageV09P3083(@)(@@)(@@)(@@) | 17447 - (@)(@@) حدثنا أبي، ثنا أبو عتبة علي بن مسلم السكوني الحمصي، ثنا إسماعيل بن عياش، حدثني 
ms2503	 الأوزاعي، عن حسان بن عطية، قال: «إن في جهنم سبعون ألف(@)(@@)(@@)(@@) | [ص: 3084](@)(@@) قصر، في كل قصر سبعون ألف دار في كل دار سبعون ألف بيت في كل بيت سبعون ألف غار، في كل غار سبعون ألف ثعبان، في فم كل ثعبان سبعون ألف عقرب»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17448 - (@)(@@) حدثنا أبي، ثنا ابن أبي الحواري، ثنا الطيب أبو الحسن، عن الحسين بن يحيى الخشني، " ليس في جهنم دار ولا مغار ولا غل ولا قيد ولا سلسلة إلا واسم. . عليه مكتوب قال: فحدث أبا سليمان فبكى، ثم قال لي: فكيف به لو قد جمع هذا كله عليه فجعل القيد في رجله، والغل في يديه، والسلسلة في عنقه ثم أدخل وأدخل الغار "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والذين جاهدوا فينا} (@)(@@) [العنكبوت: 69](@)(@@) PageV09P3084(@)(@@)(@@)(@@) | 17449 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قول الله: {والذين جاهدوا فينا} [العنكبوت: 69] " قيل له قاتلوا فينا؟ قال: نعم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17450 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الرحمن، ثنا عبد الله بن أبي جعفر، عن أبيه، عن الربيع، في قوله: {والذين جاهدوا فينا لنهدينهم سبلنا} [العنكبوت: 69] قال: «ليس على الأرض عبد أطاع ربه ودعا إليه ونهى عنه إلا وإنه قد جاهد في الله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {لنهدينهم سبلنا} (@)(@@) [العنكبوت: 69](@)(@@) PageV09P3084(@)(@@)(@@)(@@) | 17451 - (@)(@@) حدثنا أبي، ثنا أحمد بن أبي الحواري، ثنا عباس الهمذاني، حدثنا أبو أحمد من أهل عكا، في قول الله عز وجل: {لنهدينهم سبلنا} [العنكبوت: 69] إلى قوله: {وإن الله لمع المحسنين} [العنكبوت: 69] قال: «الذين يعملون بما يعلمون يهديهم لما لا يعلمون» . قال أحمد بن أبي الحواري، فحدثت به أبا سليمان الداراني فأعجبه وقال: ليس ينبغي لمن ألهم شيئا من الخير أن يعمل به حتى يسمعه في الأثر، فإذا سمعه في الأثر عمل به، وحمد الله حين وافق ما في نفسه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17452 - (@)(@@) حدثنا أبي، ثنا يعقوب بن إسحاق البغدادي، ثنا حماد، قال: سمعته يقول: قال لي ابن عيينة. . . «اختلفوا فيه. . . وأهل الثغور» فإن الله يقول: {والذين جاهدوا فينا لنهدينهم سبلنا} 
ms2504	 [العنكبوت: 69](@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17453 - (@)(@@) حدثنا أبي، ثنا عبد الله بن عمر بن محمد بن أبان بن صالح، عن(@)(@@)(@@)(@@) | [ص: 3085](@)(@@) مجالد، عن المسلي، عن عبد الله بن عمر، عن عمر بن الخطاب، أنه قال: بينا أنا عند رسول الله صلى الله عليه وسلم أتاه رجل فقال: يا رسول الله، ما الإحسان؟ قال: «أن تعبد الله كأنك تراه فإن لم تكن تراه فإنه يراك، وتحب للناس ما تحب لنفسك» فإذا فعلت ذلك. . فأنا قال: «نعم» قال الرجل: صدقت الرجل، فقال النبي صلى الله عليه وسلم: «علي الرجل» فعدنا عليه فقال النبي صلى الله عليه وسلم: «الله أكبر جبريل أتى يعلمكم دينكم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17454 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن أبي طلحة، عن ابن عباس، قال: " الإحسان: أداء الفرائض ".(@)(@@)(@@)(@@) | 17455 - (@)(@@) حدثنا أبي، ثنا سهل بن عثمان، ثنا رجل سماه، عن بعض أصحابه عن أبا. . . . . قال: الإحسان: الصلة والصلاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 17456 - (@)(@@) حدثنا أبي، ثنا عيسى بن جعفر، ثنا أبو جعفر الرازي، عن المغيرة، عن الشعبي، قال النبي صلى الله عليه وسلم: «إنما الإحسان أن تحسن إلى من أساء إليك، ليس الإحسان أن تحسن إلى من أحسن إليك» PageV00P000 
