ms33	 وجانست و روانست(@)(@@) 17 جان را نشنیدم که بود رنگ ولی جانش %~% همرنگ یکی لاله که در لاله‌ستانست(@)(@@) 18 جان را نبود بوی خوش و بوی خوش او %~% چون بوی خوش غالیه و عنبر و بانست(@)(@@) 19 انگور سیاهست و چوماهست و عجب نیست %~% زیرا که سیاهی صفت ماه روانست(@)(@@) 20 عیبیش جز این نیست که آبستن گشته‌ست %~% او نوز یکی دخترکی تاز جوانست(@)(@@) 21 بی شوی شد آبستن چون مریم عمران %~% وین قصه بسی طرفه‌تر و خوشتر از آنست(@)(@@) 22 زیرا که گر آبستن مریم به دهان شد %~% این دختر رز را نه لبست و نه دهانست(@)(@@) 23 آبستنی دختر عمران به پسر بود %~% آبستنی دختر انگور به جانست(@)(@@) 24 آن روح خداوند همه خلق جهان بود %~% وین راح خداوند همه خلق جهانست(@)(@@) 25 گر قصد جهودان بد در کشتن عیسی %~% در کشتن این قصد همه اهل قرانست(@)(@@) 26 آن را بگرفتند و کشیدند و بکشتند %~% وین را بکشند و بکشند این به چه سانست(@)(@@) 27 آن زنده یکی را و دو را کرد به معجز %~% وین زنده‌گر جان همه خلق زمانست(@)(@@) 28 ناکشته کشته صفت روح قدس بود %~% ناکشته کشته صفت این حیوانست(@)(@@) 29 آن را نگر از کشتن آنها چه زیان بود %~% این را نگر از کشتن اینها چه زیانست(@)(@@) 30 آن را پس سختی ز همه رنج امان بود %~% وین را پس سختی ز همه رنج امانست(@)(@@) 31 آن را به سماوات مکان گشت و مر این را %~% بر دست امیران و وزیرانش مکانست(@)(@@) 32 چون دست وزیر ملک شرق که دستش %~% از باده گران نیست که از جود گرانست(@)(@@) 33 شمس الوزرا احمد عبدالصمد آنکو %~% شمس‌الوزرا نیست که شمس الثقلانست(@)(@@) 34 آن پیشرو پیشروان همه عالم %~% چون پیشرو نیزه خطی که سنانست(@)(@@) 35 مهتر ز همه خلق جهان او به دو کوچک %~% مهتر به دو کوچک به دلست و به زبانست(@)(@@) 36 درانه و دوزان 
ms34	 به سر کلک نیابی %~% درانه و دوزان به سر کلک و بنانست(@)(@@) 37 اندر کرمش هر چه گمان بود یقین شد %~% واندر نسبش هر چه یقین بود گمانست(@)(@@) 38 خردش نگرش نیست که خردک نگرشنی %~% در کار بزرگان همه ذلست و هوانست(@)(@@) 39 دینار دهد نام نکو باز ستاند %~% داند که علی حال زمانه گذرانست(@)(@@) 40 مرحاشیه شاه جهان را و حشم را %~% هم مال دهنده‌ست و هم مال ستانست(@)(@@) 41 زیرا که ولایت چو تنی هست و درآن تن %~% این حاشیه شاه رگست و شریانست(@)(@@) 42 دستور طبیبست که بشناسد رگ را %~% چون با ضربان باشد و چون بی‌ضربانست(@)(@@) 43 چون با ضربانست کند قوت او کم %~% ورکم نکند بیم خناق از هیجانست(@)(@@) 44 چون بی‌ضربان باشد نیرو دهد او را %~% ورنه دل ملکت را بیم یرقانست(@)(@@) 45 این کار وزارت که همی‌راند خواجه %~% نه کار فلان بن فلان بن فلانست(@)(@@) 46 بود آن همگان را غرض و مصلحت خویش %~% این را غرض و مصلحت شاه جهانست(@)(@@) 47 هرگز ندهد خردمنش را بر خود راه %~% کز خردمنش محتشمانرا حدثانست(@)(@@) 48 از پشه عنا و الم پیل بزرگست %~% وز مور فساد بچه شیر ژیانست(@)(@@) 49 خسرو تنه ملک بود او دله ملک %~% ملکت چو قرآن او چو معانی قرانست(@)(@@) 50 ملکت چو چراگاه و رعیت رمه باشد %~% جلاب بود خسرو و دستور شبانست(@)(@@) 51 لشکر چو سگان رمه و دشمن چون گرگ %~% وین کار سگ و گرگ و رمه با رمه بانست(@)(@@) 52 ما را رمه‌بانیست نه زو در رمه آشوب %~% نه ایمن ازو گرگ و نه سگ زو به فغانست(@)(@@) 53 هرگز نکند با ضعفا سخت کمانی %~% با آنکه بداندیش بود سخت کمانست(@)(@@) 54 تا بر بم و بر زیر نوای گل نوش است %~% تا بر گل بربار خروش ورشانست(@)(@@) 55 عمر و من او را نه قیاس و نه کران باد %~% چون فضل و منش را نه قیاس 
ms35	 و نه کرانست(@)(@@) 56 بادا به بهار اندر چندانکه بهارست %~% بادا به خزان اندر چندانکه خزانست PageV1P25(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 می بر کف من نه که طرب را سبب اینست %~% آرام من و مونس من روز و شب اینست(@)(@@) 2 تریاق بزرگست و شفای همه غمها %~% نزدیک خردمندان می را لقب اینست(@)(@@) 3 بی می نتوان کردن شادی و طرب هیچ %~% زیرا که بدین گیتی اصل طرب اینست(@)(@@) 4 معجون مفرح بود این تنگدلان را %~% مر بی سلبان را به زمستان سلب اینست(@)(@@) 5 ای آنکه نخوردستی می گر بچشی زان %~% سوگند خوری گویی: شهد و رطب اینست(@)(@@) 6 می‌گیر و عطا ورز و نکو گوی و نکو خواه %~% اینست کریمی و طریق ادب اینست PageV1P26(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 این قصر خجسته که بنا کرده‌ای امسال %~% با غرفه فردوس به فردوس قرینست(@)(@@) 2 همچون حرمش طالع سعدست و مبارک %~% همچون ارمش نقش مهنا و گزینست(@)(@@) 3 چون قدر تو عالی و چو روی تو گشاده %~% چون عهد تو نیکو و چو حلم تو رزینست(@)(@@) 4 چوبش همه از صندل و از عود قماری %~% سنگش همه از گوهر و یاقوت ثمینست(@)(@@) 5 آبش همه از کوثر و از چشمه حیوان %~% خاکش همه از عنبر و کافور عجینست PageV1P27(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 روزی بس خرمست می‌گیر از بامداد %~% داد زمانه بده کایزد داد تو داد(@)(@@) 2 خواسته داری و ساز بیغمیت هست باز %~% ایمنی و عز و ناز فرخی و دین وداد(@)(@@) 3 نیز چه خواهی دگر خوش بزی و خوش بخور %~% انده فردا مبر گیتی خوابست و باد(@)(@@) 4 رفته و فرمودنی مانده و فرسودنی %~% بود همه بودنی کلک فرو ایستاد(@)(@@) 5 می‌خور کت بادنوش بر سمن و پیلگوش %~% روز رش و رام و جوش روز خور و ماه و باد(@)(@@) 6 آمد نوروز ماه می خور و می ده پگاه %~% هر روز تا شامگاه هر شب تا بامداد(@)(@@) 7 بارد در خوشاب از 
