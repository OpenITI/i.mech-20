ms541	 الحمصي الزجاج ثقة من الرابعة عخ م 4 PageV01P582(@)(@@)(@@)(@@) $ 7437 الوليد بن عبدة بفتحات مولى عمرو بن العاص ثقة من الثانية وقيل هو عمرو بن الوليد مات سنة ثلاث ومائة د(@)(@@)(@@)(@@) $ 7438 الوليد بن عبدة كوفي مقبول من السادسة تمييز(@)(@@)(@@)(@@) $ 7439 الوليد بن عتبة الأشجعي أبو العباس الدمشقي المقرىء ثقة من العاشرة مات سنة أربعين وله أربع وستون د(@)(@@)(@@)(@@) $ 7440 الوليد بن عتبة الدمشقي آخر مستور من التاسعة تمييز(@)(@@)(@@)(@@) $ 7441 الوليد بن عطاء بن خباب بمعجمة وموحدتين مقبول من السادسة م(@)(@@)(@@)(@@) $ 7442 الوليد بن عقبة بن أبي معيط بن أبي عمرو بن أمية القرشي الأموي أخو عثمان لأمه له صحبة وعاش إلى خلافة معاوية د(@)(@@)(@@)(@@) $ 7443 الوليد بن عقبة بن المغيرة أو بن كثير الشيباني الكوفي الطحان صدوق من التاسعة د(@)(@@)(@@)(@@) $ 7444 الوليد بن عقبة بن نزار العنسي بالنون مجهول من السابعة ق(@)(@@)(@@)(@@) $ 7445 الوليد بن عمرو بن السكين البصري أبو العباس صدوق من الحادية عشرة ق(@)(@@)(@@)(@@) $ 7446 الوليد بن العيزار بن حري العبدي الكوفي ثقة من الخامسة خ م ت س(@)(@@)(@@)(@@) $ 7447 الوليد بن القاسم بن الوليد الهمداني الكوفي صدوق يخطىء من الثامنة مات سنة ثلاث وثمانين ت س ق(@)(@@)(@@)(@@) $ 7448 الوليد بن قيس بن الأخرم التجيبي بضم المثناة المصري مقبول من الخامسة مات على رأس المائة عخ د ت(@)(@@)(@@)(@@) $ 7449 الوليد بن قيس السكوني الكوفي أبو همام ثقة من السادسة س(@)(@@)(@@)(@@) $ 7450 الوليد بن كامل بن معاذ البجلي أبو عبيدة الشامي لين الحديث من السابعة د س(@)(@@)(@@)(@@) $ 7451 الوليد بن كثير بن سنان المزني أبو سعيد المدني الراذاني سكن الكوفة مقبول من الثامنة س(@)(@@)(@@)(@@) $ 7452 الوليد بن كثير المخزومي أبو محمد المدني ثم الكوفي صدوق عارف بالمغازي رمي برأي الخوارج من السادسة مات سنة إحدى وخمسين ع(@)(@@)(@@)(@@) $$$ الوليد بن أبي مالك هو بن عبد الرحمن تقدم(@)(@@)(@@)(@@) $ 7453 الوليد بن محمد الموقري بضم الميم وبقاف مفتوحة أبو بشر البلقاوي مولى بني أمية متروك من الثامنة مات سنة اثنتين وثمانين ت 
ms542	 ق(@)(@@)(@@)(@@) $ 7454 الوليد بن مزيد بفتح الميم وسكون الزاي وفتح التحتانية العذري بضم المهملة وسكون المعجمة أبو العباس البيروتي بفتح الموحدة وسكون التحتانية وضم الراء وسكون الواو ثم مثناة ثقة ثبت قال النسائي كان لا يخطىء ولا يدلس من الثامنة مات سنة ثلاث وثمانين د س PageV01P583(@)(@@)(@@)(@@) $ 7455 الوليد بن مسلم بن شهاب العنبري أبو بسر البصري ثقة من الخامسة ر م د س(@)(@@)(@@)(@@) $ 7456 الوليد بن مسلم القرشي مولاهم أبو العباس الدمشقي ثقة لكنه كثير التدليس والتسوية من الثامنة مات آخر سنة أربع أو أول سنة خمس وتسعين 4(@)(@@)(@@)(@@) $ 7457 الوليد بن المغيرة بن سليمان المصري أبو العباس ثقة من السابعة مات سنة اثنتين وسبعين عخ مد(@)(@@)(@@)(@@) $ 7458 الوليد بن المغيرة المخزومي المكي مقبول من السادسة تمييز(@)(@@)(@@)(@@) $ 7459 الوليد بن نافع مقبول من كبار العاشرة س(@)(@@)(@@)(@@) $ 7460 الوليد بن نمير بن أوس الأشعري الدمشقي مقبول من السادسة بخ(@)(@@)(@@)(@@) $ 7461 الوليد بن هشام بن معاوية بن هشام بن عقبة بن أبي معيط بالتصغير الأموي أبو يعيش المعيطي ثقة من السادسة م 4(@)(@@)(@@)(@@) $ 7462 الوليد بن هشام أو بن أبي هشام الكوفي مولى همدان مستور من السادسة د ت(@)(@@)(@@)(@@) $ 7463 الوليد بن أبي هشام زياد أخو هشام أبي المقدام المدني صدوق من السادسة م 4(@)(@@)(@@)(@@) $ 7464 الوليد بن أبي الوليد عثمان وقيل بن الوليد مولى عثمان أو بن عمر المدني أبو عثمان لين الحديث من الرابعة بخ م 4(@)(@@)(@@)(@@) $ 7465 الوليد بن يزيد بن أبي طلحة الربعي الرملي العطار وقد ينسب لجده ثقة من صغار العاشرة د(@)(@@)(@@)(@@) $ 7466 الوليد بن يزيد الهدادي بفتح الهاء وتخفيف الدال أبو هاشم البصري مستور من الثامنة مد(@)(@@)(@@)(@@) $$$ الوليد أبو المغيرة البجلي أو المغيرة أبو الوليد في الكنى(@)(@@)(@@)(@@) $$$ الوليد أبو زيد مولى بني ثعلبة في الكنى(@)(@@)(@@)(@@) $$$ الوليد أبو هشام عن فرقد صوابه الوليد بن أبي هشام وهو أخو أبي المقدام(@)(@@)(@@)(@@) $$$ وهبان هو وهب بن بقية يأتي(@)(@@)(@@)(@@) $ 7467 وهب بن الأجدع الهمداني الكوفي ثقة من الثانية د س 
ms543	(@)(@@)(@@)(@@) $ 7468 وهب بن إسماعيل بن محمد بن قيس الأسدي أبو محمد الكوفي صدوق من كبار التاسعة بخ ق(@)(@@)(@@)(@@) $ 7469 وهب بن بقية بن عثمان الواسطي أبو محمد يقال له وهبان ثقة من العاشرة مات سنة تسع وثلاثين وله خمس أو ست وتسعون سنة م د س(@)(@@)(@@)(@@) $ 7470 وهب بن بيان الواسطي أبو عبد الله نزيل مصر ثقة عابد من العاشرة مات سنة ست وأربعين د س(@)(@@)(@@)(@@) $ 7471 وهب بن جابر الخيواني بفتح الخاء المعجمة وسكون التحتانية الهمداني الكوفي وربما قلبه بعضهم مقبول من الرابعة د س PageV01P584(@)(@@)(@@)(@@) $ 7472 وهب بن جرير بن حازم بن زيد أبو عبد الله الأزدي البصري ثقة من التاسعة مات سنة ست ومائتين ع(@)(@@)(@@)(@@) $ 7473 وهب بن حذيفة ويقال حذافة الغفاري صحابي من أهل الصفة عاش إلى خلافة معاوية ت(@)(@@)(@@)(@@) $ 7474 وهب بن خالد الحميري أبو خالد الحمصي ثقة من السابعة د ت ق(@)(@@)(@@)(@@) $ 7475 وهب بن خنبش بمعجمة ونون وموحدة ومعجمة وزن جعفر الطائي صحابي نزل الكوفة ويقال اسمه هرم ووهب أصح س ق(@)(@@)(@@)(@@) $ 7476 وهب بن ربيعة الكوفي مقبول من الثالثة م ت(@)(@@)(@@)(@@) $$$ وهب بن أبي دبي هو بن عبد الله(@)(@@)(@@)(@@) $ 7477 وهب بن زمعة التميمي أبو عبد الله المروزي ثقة من قدماء العاشرة ر مق ت س(@)(@@)(@@)(@@) $$$ وهب بن سعيد بن عطية هو عبد الوهاب تقدم(@)(@@)(@@)(@@) $$$ وهب بن سفيان عن بيان صوابه هريم بن سفيان(@)(@@)(@@)(@@) $ 7478 وهب بن عبد الله بن أبي دبي بموحدة مصغر الهنائي بضم الهاء ونون ومد الكوفي وقد ينسب لجده ثقة من الخامسة وروايته عن سلمان مرسلة عس(@)(@@)(@@)(@@) $ 7479 وهب بن عبد الله السوائي بضم المهملة والمد ويقال اسم أبيه وهب أيضا أبو جحيفة مشهور بكنيته ويقال له وهب الخير صحابي معروف وصحب عليا ومات سنة أربع وسبعين ع(@)(@@)(@@)(@@) $ 7480 وهب بن عبد بن زمعة بن الأسود بن المطلب الأسدي مقبول من الثالثة وقيل هو عبد الله بن وهب بن زمعة ق(@)(@@)(@@)(@@) $ 7481 وهب بن عثمان بن بشر المخزومي المدني 
ms544	 مستور من الثامنة خت(@)(@@)(@@)(@@) $ 7482 وهب بن عقبة العامري البكائي بالموحدة والكاف الثقيلة والمد كوفي مستور من الثالثة د(@)(@@)(@@)(@@) $$$ وهب بن عمرو هو وهيب يأتي(@)(@@)(@@)(@@) $ 7483 وهب بن كيسان القرشي مولاهم أبو نعيم المدني المعلم ثقة من كبار الرابعة مات سنة سبع وعشرين ع(@)(@@)(@@)(@@) $ 7484 وهب بن مانوس بالنون وقيل بالموحدة البصري نزيل اليمن مستور من السادسة د س(@)(@@)(@@)(@@) $ 7485 وهب بن منبه بن كامل اليماني أبو عبد الله الأبناوي بفتح الهمزة وسكون الموحدة بعدها نون ثقة من الثالثة مات سنة بضع عشرة خ م د ت س فق(@)(@@)(@@)(@@) $ 7486 وهب مولى أبي أحمد مجهول من الثالثة وقيل هو أبو سفيان الآتي في الكنى د PageV01P585(@)(@@)(@@)(@@) $ 7487 وهيب بالتصغير بن خالد بن عجلان الباهلي مولاهم أبو بكر البصري ثقة ثبت لكنه تغير قليلا بأخرة من السابعة مات سنة خمس وستين وقيل بعدها ع(@)(@@)(@@)(@@) $ 7488 وهيب بن عمرو بن عثمان النمري بفتح النون والميم أبو عثمان أو أبو عمرو البصري مستور من التاسعة د فق(@)(@@)(@@)(@@) $ 7489 وهيب بن الورد بفتح الواو وسكون الراء القرشي مولاهم المكي أبو عثمان أو أبو أمية يقال اسمه عبد الوهاب ثقة عابد من كبار السابعة م د ت س(@)(@@)(@@)(@@) | ( حرف لام ألف )(@)(@@)(@@)(@@) $ 7490 لاحق بن حميد بن سعيد السدوسي البصري أبو مجلز بكسر الميم وسكون الجيم وفتح اللام بعدها زاي مشهور بكنيته ثقة من كبار الثالثة مات سنة ست وقيل تسع ومائة وقيل قبل ذلك ع PageV01P586(@)(@@)(@@)(@@) | ( حرف الياء )(@)(@@)(@@)(@@) $ 7491 ياسين بن شيبان أو بن سنان أو بن سيار العجلي الكوفي لا بأس به من السابعة ووهم من زعم أنه بن معاذ الزيات ق(@)(@@)(@@)(@@) $ 7492 ياسين بن عبد الأحد بن أبي زرارة القتباني بكسر القاف وسكون المثناة ثم موحدة المصري أبو اليمن صدوق من الحادية عشرة مات سنة تسع وستين س(@)(@@)(@@)(@@) $$$ يحمد بضم أوله وكسر الميم أبو أمية الشعباني في الكنى(@)(@@)(@@)(@@) $ 7493 يحنس بضم أوله وفتح المهملة وتشديد النون المفتوحة ثم مهملة بن عبد الله أبو موسى مولى 
ms545	 آل الزبير مدني ثقة من الثالثة م س(@)(@@)(@@)(@@) $ 7494 يحيى بن إبراهيم بن عثمان بن داود بن أبي قتيلة بقاف ومثناة مصغر السلمي أبو إبراهيم المدني صدوق ربما وهم من العاشرة كن(@)(@@)(@@)(@@) $ 7495 يحيى بن إبراهيم بن محمد بن أبي عبيدة المسعودي صدوق من الحادية عشرة س(@)(@@)(@@)(@@) $ 7496 يحيى بن آدم بن سليمان الكوفي أبو زكريا مولى بني أمية ثقة حافظ فاضل من كبار التاسعة مات سنة ثلاث ومائتين ع(@)(@@)(@@)(@@) $ 7497 يحيى بن أزهر البصري مولى قريش صدوق من السابعة مات سنة إحدى وستين د(@)(@@)(@@)(@@) $ 7498 يحيى بن إسحاق بن عبد الله بن أبي طلحة الأنصاري المدني ثقة من الخامسة وقد أرسل عن البراء بن عازب د(@)(@@)(@@)(@@) $ 7499 يحيى بن إسحاق السيلحيني بمهملة ممالة وقد تصير ألفا ساكنة وفتح اللام وكسر المهملة ثم تحتانية ساكنة ثم نون أبو زكريا أو أبو بكر نزيل بغداد صدوق من كبار العاشرة مات سنة عسر ومائتين م 4(@)(@@)(@@)(@@) $ 7500 يحيى بن إسحاق أو بن أبي إسحاق الأنصاري ثقة من الرابعة ت س(@)(@@)(@@)(@@) $ 7501 يحيى بن أبي إسحاق الحضرمي مولاهم البصري النحوي صدوق ربما أخطأ من الخامسة مات سنة ست وثلاثين ع(@)(@@)(@@)(@@) $ 7502 يحيى بن أبي إسحاق الهنائي بضم أوله ثم نون ومد ويقال يزيد بن أبي إسحاق ويقال يزيد بن أبي يحيى مجهول من الخامسة ق(@)(@@)(@@)(@@) $ 7503 يحيى بن أبي أمامة أسعد بن زرارة الأنصاري المدني صحابي صغير له حديث ق(@)(@@)(@@)(@@) $ 7504 يحيى بن إسماعيل بن جرير البجلي الكوفي لين الحديث من السادسة س(@)(@@)(@@)(@@) $ 7505 يحيى بن إسماعيل الواسطي أبو زكريا مقبول من العاشرة د(@)(@@)(@@)(@@) $ 7506 يحيى بن إسماعيل بن زكريا الخواص الكوفي مقبول من العاشرة أيضا تمييز PageV01P587(@)(@@)(@@)(@@) $ 7507 يحيى بن أكثم بن محمد بن قطن التميمي المروزي أبو محمد القاضي المشهور فقيه صدوق إلا أنه رمي بسرقة الحديث ولم يقع ذلك له وإنما كان هى الرواية بالإجازة والوجادة من العاشرة مات في آخر سنة اثنتين أو ثلاث وأربعين وله ثلاث وثمانون سنة ت 
ms546	(@)(@@)(@@)(@@) $ 7508 يحيى بن أبي أنيسة بنون ومهملة مصغر أبو زيد الجزري ضعيف من السادسة مات سنة ست وأربعين ت(@)(@@)(@@)(@@) $ 7509 يحيى بن أيوب بن بادي بموحدة وزن نادي العلاف الخولاني صدوق من الحادية عشرة مات سنة تسع وثمانين س(@)(@@)(@@)(@@) $ 7510 يحيى بن أيوب بن أبي زرعة بن عمرو بن جرير البجلي الكوفي لا بأس به من السابعة خت د ت(@)(@@)(@@)(@@) $ 7511 يحيى بن أيوب الغافقي بمعجمة ثم فاء وقاف أبو العباس المصري صدوق ربما أخطأ من السابعة مات سنة ثمان وستين ع(@)(@@)(@@)(@@) $ 7512 يحيى بن أيوب المقابري بفتح الميم والقاف ثم موحدة مكسورة البغدادي العابد ثقة من العاشرة مات سنة أربع وثلاثين وله سبع وسبعون عخ م د عس(@)(@@)(@@)(@@) $ 7513 يحيى بن بشر بن كثير الحريري بفتح المهملة الكوفي صدوق من كبار العاشرة مات سنة سبع وعشرين م(@)(@@)(@@)(@@) $ 7514 يحيى بن بشر البلخي الفلاس ثقة زاهد من العاشرة مات سنة اثنتين وثلاثين خ(@)(@@)(@@)(@@) $ 7515 يحيى بن بشير بن خلاد الأنصاري المدني مستور من التاسعة د(@)(@@)(@@)(@@) $$$ يحيى بن بكير هو بن عبد الله يأتي(@)(@@)(@@)(@@) $ 7516 يحيى بن أبي بكير واسمه نسر بفتح النون وسكون المهملة الكرماني كوفي الأصل نزل بغداد ثقة من التاسعة مات سنة ثمان أو تسع ومائتين ع(@)(@@)(@@)(@@) $ 7517 يحيى بن أبي بكير النخعي الكوفي مستور من العاشرة مات سنة ثلاثين تمييز(@)(@@) ( ت ث خال )(@)(@@)(@@)(@@) $ 7518 يحيى بن جابر بن حسان الطائي أبو عمرو الحمصي القاضي ثقة من السادسة وأرسل كثيرا مات سنة ست وعشرين بخ م 4(@)(@@)(@@)(@@) $ 7519 يحيى بن الجزار العرني بضم المهملة وفتح الراء ثم نون الكوفى قيل اسم أبيه زبان بزاي وموحدة وقيل بل لقبه هو صدوق رمي بالغلو في التشيع من الثالثة م 4(@)(@@)(@@)(@@) $ 7520 يحيى بن جعدة بن هبيرة بن أبي وهب المخزومي ثقة وقد أرسل عن بن مسعود ونحوه من الثالثة د تم س ق(@)(@@)(@@)(@@) $ 7521 يحيى بن جعفر بن أعين الأزدي البخاري ثقة من العاشرة مات سنة ثلاث وأربعين خ PageV01P588(@)(@@)(@@)(@@) $ 7522 
ms547	 يحيى بن الحارث الذماري بكسر المعجمة وتخفيف الميم أبو عمرو السامي القارىء ثقة من الخامسة مات سنة خمس وأربعين وهو بن سبعين سنة 4(@)(@@)(@@)(@@) $ 7523 يحيى بن الحارث الشيرازي مقبول من الثامنة ق(@)(@@)(@@)(@@) $ 7524 يحيى بن الحارث عن أخيه زهدم ضعيف من الثامنة ووهم من خلطه تمييز(@)(@@)(@@)(@@) $ 7525 يحيى بن حبيب بن إسماعيل الأسدي الكوفي أبو عقيل بالفتح الجمال بالجيم صدوق ربما وهم مشهور بكنيته من التاسعة بخ(@)(@@)(@@)(@@) $ 7526 يحيى بن حبيب بن عربي البصري ثقة من العاشرة مات سنة ثمان وأربعين وقيل بعدها م 4(@)(@@)(@@)(@@) $ 7527 يحيى بن أبي الحجاج الأهتمي واسم أبيه عبد الله أبو أيوب البصري لين الحديث من التاسعة ت س(@)(@@)(@@)(@@) $ 7528 يحيى بن حرب المدني مجهول من السابعة ق(@)(@@)(@@)(@@) $$$ يحيى بن حزام صوابه بن خذام يأتي(@)(@@)(@@)(@@) $ 7529 يحيى بن حسان التنيسي بكسر المثناة والنون الثقيلة وسكون التحتانية ثم مهملة أصله من البصرة ثقة من التاسعة مات سنة ثمان ومائتين وله أربع وستون خ م د ت س(@)(@@)(@@)(@@) $ 7530 يحيى بن حسان الفلسطيني البكري ثقة من الخامسة بخ س(@)(@@)(@@)(@@) $ 7531 يحيى بن الحسن بن عثمان بن عبد الرحمن بن عوف أبو إبراهيم الزهري المدني مجهول الحال من السابعة د(@)(@@)(@@)(@@) $ 7532 يحيى بن الحصين الأحمسي ثقة من الرابعة د س ق(@)(@@)(@@)(@@) $ 7533 يحيى بن حكيم بن صفوان بن أمية الجمحي المكي مقبول من الثالثة س ق(@)(@@)(@@)(@@) $ 7534 يحيى بن حكيم المقوم بتشديد الواو المكسورة أبو سعيد البصري ثقة حافظ عابد مصنف من العاشرة مات سنة ست وخمسين د س ق(@)(@@)(@@)(@@) $ 7535 يحيى بن حماد بن أبي زياد الشيباني مولاهم البصري ختن أبي عوانة ثقة عابد من صغار التاسعة مات سنة خمس عشرة خ م خد ت س ق(@)(@@)(@@)(@@) $ 7536 يحيى بن حمزة بن واقد الحضرمي أبو عبد الرحمن الدمشقي القاضي ثقة رمي بالقدر من الثامنة مات سنة ثلاث وثمانين على الصحيح وله ثمانون سنة ع(@)(@@)(@@)(@@) $ 7537 يحيى بن أبي حية بمهملة وتحتانية الكلبي أبو جناب بجيم ونون 
ms548	 خفيفتين وآخره موحدة مشهور بها ضعفوه لكثرة تدليسه من السادسة مات سنة خمسين أو قبلها د ت ق(@)(@@)(@@)(@@) $ 7538 يحيى بن خذام بكسر المعجمة بن منصور السقطي البصري مقبول من التاسعة مات سنة اثنتين وخمسين ق(@)(@@)(@@)(@@) $ 7539 يحيى بن خلف الباهلي أبو سلمة البصري الجوباري بجيم مضمومة واو ساكنة ثم موحدة صدوق من العاشرة مات سنة اثنتين وأربعين م ت ق PageV01P589(@)(@@)(@@)(@@) $ 7540 يحيى بن خلاد بن رافع بن مالك بن العجلان الأنصاري الزرقي بضم الزاي وفتح الراء بعدها قاف المدني له رؤية وذكره بن حبان في ثقات التابعين ومات في حدود السبعين ووهم من قال مات بعد المائة ذاك حفيده يحيى بن علي خ 4(@)(@@)(@@)(@@) $$$ يحيى بن أبي خليد هو يحيى بن مسلم البكاء يأتي(@)(@@)(@@)(@@) $ 7541 يحيى بن داود بن ميمون الواسطي ثقة من صغار العاشرة مات سنة أربع وأربعين ق(@)(@@)(@@)(@@) $ 7542 يحيى بن درست بضمتين وسكون المهملة بن زياد البصري ثقة من العاشرة ت س ق(@)(@@)(@@)(@@) $$$ يحيى بن دينار أبو هاشم الرماني يأتي في الكنى(@)(@@)(@@)(@@) $ 7543 يحيى بن راشد بن مسلم الليثي أبو هشام الدمشقي الطويل ثقة من الرابعة د(@)(@@)(@@)(@@) $ 7544 يحيى بن راشد آخر شامي شيخ لضمرة من الخامسة فرق بينهما البخاري وغيره تمييز(@)(@@)(@@)(@@) $ 7545 يحيى بن راشد المازني أبو سعيد البصري البراء بموحدة وراء مشددة ومد ضعيف من الثامنة ق(@)(@@)(@@)(@@) $ 7546 يحيى بن راشد البصري أبو بكر مستملي أبي عاصم صدوق من صغار التاسعة مات سنة إحدى عشرة تمييز(@)(@@)(@@)(@@) $ 7547 يحيى بن زرارة بن عبد الكريم ولقبه كريم بالتصغير بن الحارث بن عمرو الباهلي ثم السهمي مقبول من السابعة س(@)(@@)(@@)(@@) $ 7548 يحيى بن زكريا بن أبي زائدة الهمداني بسكون الميم أبو سعيد الكوفي ثقة متقن من كبار التاسعة مات سنة ثلاث أو أربع وثمانين ومائة وله ثلاث وستون سنة ع(@)(@@)(@@)(@@) $ 7549 يحيى بن زكريا بن يحيى النيسابوري الأعرج يلقب حيويه بمهملة وتحتانية ثقة حافظ فقيه من الثانية عشرة مات سنة سبع وثلاثمائة س(@)(@@)(@@)(@@) $ 7550 يحيى بن أبي 
ms549	 زكريا الغساني أبو مروان الواسطي أصله من الشام ضعيف ما له في البخاري سوى موضع واحد متابعة من التاسعة مات سنة تسعين خ(@)(@@)(@@)(@@) $ 7551 يحيى بن زياد بن أبي داود الأسدي مولاهم أبو محمد الرقي لقبه فهير صدوق عابد من الثامنة ق(@)(@@)(@@)(@@) $ 7552 يحيى بن زياد بن عبد الله الأسدي مولاهم الكوفي نزيل بغداد الفراء النحوي المشهور صدوق من التاسعة مات سنة سبع ومائتين خت(@)(@@)(@@)(@@) $ 7553 يحيى بن سام بمهملة بن موسى الضبي مقبول من الرابعة ت ق(@)(@@)(@@)(@@) $ 7554 يحيى بن سعيد بن أبان بن سعيد بن العاص الأموي أبو أيوب الكوفي نزيل بغداد لقبه الجمل صدوق يغرب من كبار التاسعة مات سنة أربع وتسعين وله ثمانون سنة ع(@)(@@)(@@)(@@) $ 7555 يحيى بن سعيد بن حيان بمهملة وتحتانية أبو حيان التيمي الكوفي ثقة عابد من السادسة مات سنة خمس وأربعين ع PageV01P590(@)(@@)(@@)(@@) $ 7556 يحيى بن سعيد بن العاص الأموي أخو عمرو الأشدق ثقة من الثالثة مات في حدود الثمانين بخ م(@)(@@)(@@)(@@) $ 7557 يحيى بن سعيد بن فروخ بفتح الفاء وتشديد الراء المضمومة وسكون الواو ثم معجمة التميمي أبو سعيد القطان البصري ثقة متقن حافظ إمام قدوة من كبار التاسعة مات سنة ثمان وتسعين وله ثمان وسبعون ع(@)(@@)(@@)(@@) $ 7558 يحيى بن سعيد العطار بمهملة وآخره راء الأنصاري الشامي ضعيف من التاسعة أيضا مات قبل الذي قبله بمدة تمييز(@)(@@)(@@)(@@) $ 7559 يحيى بن سعيد بن قيس الأنصاري المدني أبو سعيد القاضي ثقة ثبت من الخامسة مات سنة أربع وأربعين أو بعدها ع(@)(@@)(@@)(@@) $ 7560 يحيى بن أبي سفيان بن الأخنس الأخنسي بخاء معجمة ونون المدني مستور من السادسة قد أرسل عن أبي هريرة وغيره د ق(@)(@@)(@@)(@@) $ 7561 يحيى بن سلمة بن كهيل بالتصغير الحضرمي أبو جعفر الكوفي متروك وكان شيعيا من التاسعة مات سنة تسع وسبعين وقيل قبلها ت(@)(@@)(@@)(@@) $$$ يحيى بن أبي سلمة الجعفي هو بن سليمان يأتي(@)(@@)(@@)(@@) $$$ يحيى بن سليم أبو بلج في الكنى(@)(@@)(@@)(@@) $$$ يحيى بن سليم البكاء في بن مسلم(@)(@@)(@@)(@@) $ 7562 يحيى بن سليم 
ms550	 بن زيد مجهول من السادسة د(@)(@@)(@@)(@@) $ 7563 يحيى بن سليم الطائفي نزيل مكة صدوق سيء الحفظ من التاسعة مات سنة ثلاث وتسعين أو بعدها ع(@)(@@)(@@)(@@) $ 7564 يحيى بن سليمان بن يحيى بن سعيد الجعفي أبو سعيد الكوفي نزيل مصر صدوق يخطىء من العاشرة مات سنة سبع أو ثمان وثلاثين خ ت(@)(@@)(@@)(@@) $$$ يحيى بن سليمان عن بن جريج صوابه يحيى بن سليم وهو الطائفي(@)(@@)(@@)(@@) $ 7565 يحيى بن أبي سليمان المدني أبو صالح لين الحديث من السادسة بخ د ت س(@)(@@)(@@)(@@) $ 7566 يحيى بن سيرين الأنصاري مولاهم أبو عمرو البصري ثقة من الثالثة مات قبل أخيه محمد عس(@)(@@)(@@)(@@) $ 7567 يحيى بن شبل البلخي مقبول من السابعة ل(@)(@@)(@@)(@@) $ 7568 يحيى بن صالح الوحاظي بضم الواو وتخفيف المهملة ثم معجمة الحمصي صدوق من أهل الرأي من صغار التاسعة مات سنة اثنتين وعشرين وقد جاز التسعين خ م د ت ق PageV01P591(@)(@@)(@@)(@@) $ 7569 يحيى بن أبي صالح المدني مجهول من السادسة وقيل إن أباه أبو صالح السمان ت(@)(@@)(@@)(@@) $ 7570 يحيى بن صبيح بفتح أوله الخراساني المقرىء صدوق من كبار السابعة مات بمكة د(@)(@@)(@@)(@@) $$$ يحيى بن الصيفي يأتي في يحيى بن عبد الله(@)(@@)(@@)(@@) $$$ يحيى بن الضحاك هو بن عبد الله يأتي نسب لجده(@)(@@)(@@)(@@) $ 7571 يحيى بن الضريس بمعجمة ثم مهملة مصغر البجلي الرازي القاضي صدوق من التاسعة مات سنة ثلاث ومائتين م ت(@)(@@)(@@)(@@) $ 7572 يحيى بن طلحة بن عبيد الله التيمي المدني ثقة من الثالثة ت س ق(@)(@@)(@@)(@@) $ 7573 يحيى بن طلحة بن أبي كثير اليربوعي الكوفي لين الحديث من العاشرة ت(@)(@@)(@@)(@@) $$$ يحيى بن عباد بن حمزة بن الزبير صوابه عن عباد بن حمزة ومال يحيى مدخل في ذلك بخ(@)(@@)(@@)(@@) $ 7574 يحيى بن عباد بن شيبان الأنصاري أبو هبيرة الكوفي ثقة من الرابعة مات بعد العشرين بخ م 4(@)(@@)(@@)(@@) $ 7575 يحيى بن عباد بن عبد الله بن الزبير بن العوام المدني ثقة من الخامسة مات بعد المائة وله ست وثلاثون سنة ر 4(@)(@@)(@@)(@@) $ 7576 يحيى بن عباد 
ms551	 الضبعي بضم المعجمة وفتح الموحدة بعدها مهملة أبو عباد البصري نزيل بغداد صدوق من التاسعة مات سنة ثمان وتسعين خ م ت س(@)(@@)(@@)(@@) $ 7577 يحيى بن عباد السعدي مجهول من العاشرة تمييز(@)(@@)(@@)(@@) $$$ يحيى بن عباد في يحيى بن عمارة(@)(@@)(@@)(@@) $ 7578 يحيى بن عبد الله بن الأدرع مقبول من الخامسة عس(@)(@@)(@@)(@@) $ 7579 يحيى بن عبد الله بن بحير بفتح الموحدة وكسر المهملة المرادي اليمني مستور من السادسة د(@)(@@)(@@)(@@) $ 7580 يحيى بن عبد الله بن بكير المخزومي مولاهم المصري وقد ينسب إلى جده ثقة في الليث وتكلموا في سماعه من مالك من كبار العاشرة مات سنة إحدى وثلاثين وله سبع وسبعون خ م ق(@)(@@)(@@)(@@) $ 7581 يحيى بن عبد الله بن الحارث الجابر بالجيم والموحدة أبو الحارث الكوفي لين الحديث من السادسة وروايته عن المقدام مرسلة د ت ق(@)(@@)(@@)(@@) $ 7582 يحيى بن عبد الله بن زياد السلمي البلخي نزيل مرو لقبه خاقان ثقة من العاشرة خ(@)(@@)(@@)(@@) $ 7583 يحيى بن عبد الله بن خاقان عن مالك مجهول من العاشرة أيضا تمييز(@)(@@)(@@)(@@) $ 7584 يحيى بن عبد الله بن سالم بن عبد الله بن عمر المدني صدوق من كبار الثامنة مات سنة ثلاث وخمسين م د س(@)(@@)(@@)(@@) $$$ يحيى بن عبد الله بن الصيفي يأتي بعد أربعة PageV01P592(@)(@@)(@@)(@@) $ 7585 يحيى بن عبد الله بن الضحاك البابلتي بموحدتين ولام مضمومة ومثناة ثقيلة أبو سعيد الحراني بن امرأة الأوزاعي ضعيف من التاسعة مات سنة ثماني عشرة وهو بن سبعين خت س(@)(@@)(@@)(@@) $ 7586 يحيى بن عبد الله بن عبد الرحمن بن سعد أو أسعد بن زرارة الأنصاري المدني ثقة من الرابعة م د(@)(@@)(@@)(@@) $ 7587 يحيى بن عبد الله بن عبيد الله بن أبي مليكة التميمي المكي لين الحديث من السابعة مات سنة ثلاث وسبعين قد ق(@)(@@)(@@)(@@) $ 7588 يحيى بن عبد الله بن مالك بن عياض صدوق من السادسة س(@)(@@)(@@)(@@) $ 7589 يحيى بن عبد الله بن محمد بن يحيى بن صيفي المكي ثقة من السادسة ع(@)(@@)(@@)(@@) $ 7590 يحيى بن عبد الله بن 
ms552	 يزيد بن أنيس الأنصاري الأنيسي المدني صدوق من الثامنة صد(@)(@@)(@@)(@@) $$$ يحيى بن عبد الله مولى أبي بكر صوابه يحيى بن عثمان(@)(@@)(@@)(@@) $ 7591 يحيى بن عبد الحميد بن عبد الرحمن بن بشمين بفتح الموحدة وسكون المعجمة الحماني بكسر المهملة وتشديد الميم الكوفي حافظ إلا أنهم اتهموه بسرقة الحديث من صغار التاسعة مات سنة ثمان وعشرين م(@)(@@)(@@)(@@) $ 7592 يحيى بن عبد الرحمن بن حاطب بن أبي بلتعة أبو محمد أو أبو بكر المدني ثقة من الثالثة مات سنة أربع ومائة م 4(@)(@@)(@@)(@@) $ 7593 يحيى بن عبد الرحمن بن مالك بن الحارث الأرحبي الكوفي صدوق ربما أخطأ من التاسعة ت س ق(@)(@@)(@@)(@@) $ 7594 يحيى بن عبد الرحمن الكناني أو الكندي أبو شيبة المصري قلبه هشيم فقال عبد الرحمن بن يحيى وهو صدوق من السادسة ق(@)(@@)(@@)(@@) $ 7595 يحيى بن عبد الرحمن العصري بفتح المهملتين البصري مقبول من السابعة بخ(@)(@@)(@@)(@@) $ 7596 يحيى بن عبد الرحمن الثقفي مقبول من السادسة س(@)(@@)(@@)(@@) $ 7597 يحيى بن عبد العزيز أبو عبد العزيز الأردني بضم الهمزة والمهملة بينهما راء ساكنة ثم نون ثقيلة نزل اليمامة مقبول من السابعة وهو والد أبي عبد الرحمن الشافعي بخ د(@)(@@)(@@)(@@) $ 7598 يحيى بن عبد الملك بن حميد بن أبي غنية بفتح المعجمة وكسر النون وتشديد التحتانية الخزاعي الكوفي أصله من أصبهان صدوق له أفراد من كبار التاسعة مات سنة بضع وثمانين خ م مد ت س ق PageV01P593(@)(@@)(@@)(@@) $ 7599 يحيى بن عبيد الله بن عبد الله بن موهب بفتح الميم والهاء بينهما واو ساكنة التيمي المدني متروك وأفحش الحاكم فرماه بالوضع من السادسة ت ق(@)(@@)(@@)(@@) $$$ يحيى بن عبيد الله عن عبيد الله بن مسلم صوابه يحيى بن عبد الله وهو الجابر تقدم ق(@)(@@)(@@)(@@) $ 7600 يحيى بن عبيد بغير إضافة أبو عمر البهراني الكوفي صدوق من الرابعة م د س ق(@)(@@)(@@)(@@) $ 7601 يحيى بن عبيد المكي مولى بني مخزوم ثقة من السادسة د س(@)(@@)(@@)(@@) $ 7602 يحيى بن عبيد عن عطاء بن أبي رباح يحتمل أن يكون 
ms553	 الذي قبله وإلا فمجهول ت(@)(@@)(@@)(@@) $ 7603 يحيى بن عتيق الطفاوي بضم المهملة وتخفيف الفاء البصري ثقة من السادسة مات قبل أيوب وكان أصغر من أيوب ع(@)(@@)(@@)(@@) $ 7604 يحيى بن عثمان بن سعيد بن كثير بن دينار القرشي الحمصي صدوق عابد من العاشرة مات سنة خمس وخمسين د س ق(@)(@@)(@@)(@@) $ 7605 يحيى بن عثمان بن صالح السهمي مولاهم المصري صدوق رمي بالتشيع ولينه بعضهم لكونه حدث من غير أصله من الحادية عشرة مات سنة اثنتين وثمانين ق(@)(@@)(@@)(@@) $ 7606 يحيى بن عثمان التيمي مولاهم أبو سهل البصري ضعيف من الثامنة قد ق(@)(@@)(@@)(@@) $ 7607 يحيى بن عثمان الحربي أصله من سجستان فنزل بغداد صدوق تكلموا في روايته عن هقل من العاشرة مات سنة ثمان وثلاثين تمييز(@)(@@)(@@)(@@) $ 7608 يحيى بن عروة بن الزبير بن العوام الأسدي أبو عروة المدني ثقة من السادسة خ م د(@)(@@)(@@)(@@) $ 7609 يحيى بن عفيف الكندي مقبول من الثالثة ص(@)(@@)(@@)(@@) $ 7610 يحيى بن عقيل بالتصغير البصري نزيل مرو صدوق من الثالثة بخ م د س ق(@)(@@)(@@)(@@) $ 7611 يحيى بن علي بن يحيى بن خلاد بن رافع الأنصاري الزرقي المدني مقبول من السادسة مات سنة تسع وعشرين د ت س(@)(@@)(@@)(@@) $ 7612 يحيى بن عمارة بن أبي حسن الأنصاري المدني ثقة من الثالثة ع(@)(@@)(@@)(@@) $ 7613 يحيى بن عمارة ويقال بن عباد الكوفي مقبول من الرابعة ت س(@)(@@)(@@)(@@) $ 7614 يحيى بن عمرو بن مالك النكري بضم النون البصري ضعيف ويقال إن حماد بن زيد كذبه من السابعة ت(@)(@@)(@@)(@@) $ 7615 يحيى بن أبي عمر العدني مقبول من العاشرة م PageV01P594(@)(@@)(@@)(@@) $ 7616 يحيى بن أبي عمرو السيباني بفتح المهملة وسكون التحتانية بعدها موحدة أبو زرعة الحمصي ثقة من السادسة وروايته عن الصحابة مرسلة مات سنة ثمان وأربعين أو بعدها بخ د س ق(@)(@@)(@@)(@@) $ 7617 يحيى بن عمير المدني البزاز مولى بني نوفل مقبول من السابعة س(@)(@@)(@@)(@@) $ 7618 يحيى بن العلاء البجلي أبو عمرو أو أبو سلمة الرازي رمي بالوضع من الثامنة مات قرب الستين د ق 
ms554	(@)(@@)(@@)(@@) $ 7619 يحيى بن عيسى التميمي النهشلي الفاخوري بالفاء والخاء المعجمة الجرار بالجيم وراءين الكوفي نزيل الرملة صدوق يخطىء ورمي بالتشيع من التاسعة مات سنة إحدى ومائتين بخ م د ت ق(@)(@@)(@@)(@@) $ 7620 يحيى بن غيلان بن عبد الله بن أسماء الخزاعي أو الأسلمي البغدادي أبو الفضل ثقة من العاشرة مات سنة عشر بن على الصحيح م ت س(@)(@@)(@@)(@@) $ 7621 يحيى بن غيلان الراسبي بمهملة وموحدة مقبول من الحادية عشرة تمييز(@)(@@)(@@)(@@) $ 7622 يحيى بن الفضل بن يحيى بن كيسان العنزي بفتح المهملة والنون ثم زاي البصري الخرقي بكسر المعجمة وفتح الراء ثم قاف صدوق من الحادية عشرة مات سنة ست وخمسين د ق(@)(@@)(@@)(@@) $ 7623 يحيى بن الفضل السجستاني مقبول من العاشرة د(@)(@@)(@@)(@@) $ 7624 يحيى بن فياض بفتح الفاء وتشديد التحتانية ثم معجمة الزماني بكسر الزاي وتشديد الميم لين الحديث من التاسعة د(@)(@@)(@@)(@@) $ 7625 يحيى بن فلان عن محمد بن كعب مجهول له ذكر في مقدمة مسلم من السادسة مق(@)(@@)(@@)(@@) $ 7626 يحيى بن قزعة بفتح القاف والزاي القرشي المكي المؤدب مقبول من العاشرة خ(@)(@@)(@@)(@@) $ 7627 يحيى بن قيس الكندي كوفي مستور من السادسة خت(@)(@@)(@@)(@@) $ 7628 يحيى بن قيس السبائي بفتح المهملة والموحدة وهمزة بغير مد اليمني ثقة من الخامسة د ت س(@)(@@)(@@)(@@) $ 7629 يحيى بن كثير بن درهم العنبري مولاهم البصري أبو غسان ثقة من التاسعة مات سنة ست ومائتين ع(@)(@@)(@@)(@@) $ 7630 يحيى بن كثير الكاهلي الكوفي لين الحديث من الخامسة ر د(@)(@@)(@@)(@@) $ 7631 يحيى بن كثير أبو النضر صاحب البصري ضعيف من كبار التاسعة ق PageV01P595(@)(@@)(@@)(@@) $ 7632 يحيى بن أبي كثير الطائي مولاهم أبو نصر اليمامي ثقة ثبت لكنه يدلس ويرسل من الخامسة مات سنة اثنتين وثلاثين وقيل قبل ذلك ع(@)(@@)(@@)(@@) $$$ يحيى بن أبي كريمة هو بن يوسف يأتي(@)(@@)(@@)(@@) $ 7633 يحيى بن المتوكل المدني أبو عقيل بالفتح صاحب بهية بالموحدة مصغر ضعيف من الثامنة مات سنة سبع وستين مق د(@)(@@)(@@)(@@) $ 7634 يحيى بن المتوكل الباهلي البصري أبو بكر صدوق يخطىء من التاسعة 
ms555	 مات بالمصيصة تمييز(@)(@@)(@@)(@@) $$$ يحيى بن محمد بن حرب عن أبي عمر صوابه محمد بن حرب ليس فيه يحيى(@)(@@)(@@)(@@) $ 7635 يحيى بن محمد بن سابق الكوفي نزيل المصيصة لقبه عصا بن إدريس مقبول من العاشرة س(@)(@@)(@@)(@@) $ 7636 يحيى بن محمد بن السكن بن حبيب القرشي البزار البصري نزيل بغداد صدوق من الحادية عشرة مات بعد الخمسين خ د س(@)(@@)(@@)(@@) $ 7637 يحيى بن محمد بن عباد بن هانئ المدني الشجري بمعجمة وجيم مفتوحتين ضعيف وكان ضريرا يتلقن من التاسعة ت(@)(@@)(@@)(@@) $$$ يحيى بن محمد بن عبد الله بن صيفي تقدم في يحيى بن عبد الله بن محمد بن صيفى(@)(@@)(@@)(@@) $ 7638 يحيى بن محمد بن عبد الله بن مهران المدني مولى بني نوفل يقال له الجاري بجيم وراء خفيفة صدوق يخطىء من كبار العاشرة د ت س(@)(@@)(@@)(@@) $ 7639 يحيى بن محمد بن قيس المحاربي الضرير أبو محمد المدني نزيل البصرة لقبه أبو زكير بالتصغير صدوق يخطىء كثيرا من الثامنة بخ م د ت س ق(@)(@@)(@@)(@@) $ 7640 يحيى بن محمد بن معاوية اللؤلؤي المروزي نزيل بخارى مقبول من الحادية عشرة مات سنة سبع وخمسين م(@)(@@)(@@)(@@) $ 7641 يحيى بن محمد بن يحيى الذهلي النيسابوري لقبه حيكان بمهملة ثم تحتانية ثقة حافظ من الحادية عشرة مات شهيدا سنة سبع وستين ق(@)(@@)(@@)(@@) $$$ يحيى بن محمد البصري أبو زكير تقدم قريبا(@)(@@)(@@)(@@) $ 7642 يحيى بن المختار الصنعاني مستور من السادسة س(@)(@@)(@@)(@@) $ 7643 يحيى بن مخلد المقسمي البغدادي ثقة من الحادية عشرة س(@)(@@)(@@)(@@) $ 7644 يحيى بن مسلم البصري مجهول من السادسة ت PageV01P596(@)(@@)(@@)(@@) $ 7645 يحيى بن مسلم أو بن سليم مصغر وهو بن أبي خليد البصري المعروف بيحيى البكاء بتشديد الكاف الحداني بضم المهملة وتشديد الدال مولاهم ضعيف من الرابعة مات سنة ثلاثين ومائة ت ق(@)(@@)(@@)(@@) $ 7646 يحيى بن مسلم شامي مجهول من السادسة د(@)(@@)(@@)(@@) $ 7647 يحيى بن مسلم الهمداني أبو الضحاك الكوفي مقبول من السادسة تمييز(@)(@@)(@@)(@@) $ 7648 يحيى بن مسلم بصري مجهول من مشايخ بقية من السابعة تمييز(@)(@@)(@@)(@@) $ 7649 يحيى بن 
ms556	 أبي المطاع القرشي الأردني بتشديد النون بن أخت بلال صدوق من الرابعة وأشار دحيم إلى أن روايته عن العرباض مرسلة ق(@)(@@)(@@)(@@) $ 7650 يحيى بن معلى بن منصور أبو عوانة الرازي نزيل بغداد صدوق صاحب حديث من الحادية عشرة ق(@)(@@)(@@)(@@) $ 7651 يحيى بن معين بن عون الغطفاني مولاهم أبو زكريا البغدادي ثقة حافظ مشهور إمام الجرح والتعديل من العاشرة مات سنة ثلاث وثلاثين بالمدينة النبوية وله بضع وسبعون سنة ع(@)(@@)(@@)(@@) $ 7652 يحيى بن المغيرة بن إسماعيل بن أيوب المخزومي أبو سلمة المدني صدوق من الحادية عشرة مات سنة ثلاث وخمسين ت(@)(@@)(@@)(@@) $ 7653 يحيى بن المقدام بن معدي كرب مستور من الرابعة د س ق(@)(@@)(@@)(@@) $ 7654 يحيى بن المهلب البجلي أبو كدينة بنون مصغر الكوفي صدوق من السابعة خ ت س(@)(@@)(@@)(@@) $ 7655 يحيى بن موسى البلخي لقبه خت بفتح المعجمة وتشديد المثناة وقيل هو لقب أبيه أصله من الكوفة ثقة من العاشرة مات سنة أربعين خ د ت س(@)(@@)(@@)(@@) $ 7656 يحيى بن ميمون بن عطاء القرشي أبو أيوب التمار البصري نزيل بغداد متروك من الثامنة مات في حدود التسعين د(@)(@@)(@@)(@@) $ 7657 يحيى بن ميمون الحضرمي أبو عمرة المصري القاضي صدوق لكن عيب عليه شيء يتعلق بالقضاء من الخامسة مات سنة أربع عشرة ومائة د س(@)(@@)(@@)(@@) $ 7658 يحيى بن ميمون الضبي أبو المعلى العطار الكوفي مشهور بكنيته ثقة من السادسة مات سنة اثنتين وثلاثين خت س ق(@)(@@)(@@)(@@) $ 7659 يحيى بن النضر الأنصاري المدني ثقة من الرابعة بخ صد ق(@)(@@)(@@)(@@) $ 7660 يحيى بن النضر بن عبد الله الأصبهاني الدقاق مقبول من الحادية عشرة تمييز(@)(@@)(@@)(@@) $ 7661 يحيى بن هانئ بن عروة المرادي أبو داود الكوفي ثقة من الخامسة وروايته عن بن مسعود مرسلة د ت س(@)(@@)(@@)(@@) $ 7662 يحيى بن أبي الهيثم العطار الكوفي ثقة من الخامسة بخ تم PageV01P597(@)(@@)(@@)(@@) $ 7663 يحيى بن واضح الأنصاري مولاهم أبو تميلة بمثناة مصغر المروزي مشهور بكنيته ثقة من كبار التاسعة ع(@)(@@)(@@)(@@) $ 7664 يحيى بن وثاب بتشديد المثلثة الأسدي مولاهم الكوفي 
ms557	 المقرىء ثقة عابد من الرابعة مات سنة ثلاث ومائة خ م ت س ق(@)(@@)(@@)(@@) $ 7665 يحيى بن وثاب الجزري مجهول من مشايخ خارجة بن مصعب من السابعة تمييز(@)(@@)(@@)(@@) $ 7666 يحيى بن الوليد بن عبادة بن الصامت مقبول من الرابعة س(@)(@@)(@@)(@@) $ 7667 يحيى بن الوليد الطائي أبو الزعراء بفتح الزاي وسكون العين المهملة كوفي لا بأس به من السابعة د س ق(@)(@@)(@@)(@@) $ 7668 يحيى بن يحيى بن بكر بن عبد الرحمن التميمي أبو زكريا النيسابوري ثقة ثبت إمام من العاشرة مات سنة ست وعشرين على الصحيح خ م ت س(@)(@@)(@@)(@@) $ 7669 يحيى بن يحيى بن كثير الليثي مولاهم القرطبي أبو محمد صدوق فقيه قليل الحديث وله أوهام من العاشرة مات سنة أربع وثلاثين على الصحيح تمييز(@)(@@)(@@)(@@) $$$ يحيى بن يحيى الغساني هو بن أبي زكريا تقدم(@)(@@)(@@)(@@) $ 7670 يحيى بن يحيى بن قيس بن حارثة الغساني أبو عثمان الشامي ثقة من السادسة مات سنة ثلاث وثلاثين على الصحيح د(@)(@@)(@@)(@@) $ 7671 يحيى بن أبي يحيى مجهول من السابعة س(@)(@@)(@@)(@@) $ 7672 يحيى بن يزداد بفتح التحتانية وسكون الزاي العسكري أبو السقر بالمهملة وسكون القاف وقد تبدل سينه صادا مقبول من الحادية عشرة ق(@)(@@)(@@)(@@) $ 7673 يحيى بن يزيد الهنائي بضم الهاء ثم نون خفيفة ومد مقبول من الخامسة ويقال هو بن أبي إسحاق المتقدم م د(@)(@@)(@@)(@@) $ 7674 يحيى بن يزيد الجزري أبو شيبة بالمعجمة الرهاوي مقبول من السابعة د(@)(@@)(@@)(@@) $ 7675 يحيى بن يعلى بن الحارث المحاربي الكوفي ثقة من صغار التاسعة مات سنة ست عشرة خ م د س ق(@)(@@)(@@)(@@) $ 7676 يحيى بن يعلى التيمي أبو المحياة بضم الميم وفتح المهملة وتشديد التحتانية وآخره هاء الكوفي ثقة من الثامنة م ت س ق(@)(@@)(@@)(@@) $ 7677 يحيى بن يعلى الأسلمي الكوفي ضعيف شيعي من التاسعة بخ ت(@)(@@)(@@)(@@) $ 7678 يحيى بن يعمر بفتح التحتانية والميم بينهما مهملة البصري نزيل مرو وقاضيها ثقة فصيح وكان يرسل من الثالثة مات قبل المائة وقيل بعدها ع(@)(@@)(@@)(@@) $ 7679 يحيى بن يمان العجلي الكوفي 
ms558	 صدوق عابد يخطىء كثيرا وقد تغير من كبار التاسعة مات سنة تسع وثمانين بخ م 4 PageV01P598(@)(@@)(@@)(@@) $ 7680 يحيى بن يوسف الزمي بكسر الزاي والميم الثقيلة الخراساني نزيل بغداد ويقال له بن أبي كريمة ثقة من كبار العاشرة مات سنة بضع وعشرين خ ق(@)(@@)(@@)(@@) $ 7681 يحيى الأنصاري والد عبد الله مجهول من السابعة ق(@)(@@)(@@)(@@) $$$ يحيى البكاء هو بن مسلم تقدم(@)(@@)(@@)(@@) $$$ يحيى الجابر هو بن عبد الله تقدم(@)(@@)(@@)(@@) $$$ يحيى الجاري هو بن محمد تقدم(@)(@@)(@@)(@@) $$$ يحيى الكندي في بن قيس(@)(@@)(@@)(@@) $ 7682 يحيى عن عمير بن سعد مجهول من السادسة عس(@)(@@)(@@)(@@) $$$ يزداد في أزداد(@)(@@)(@@)(@@) $ 7683 يزيد بن أبان الرقاشي بتخفيف القاف ثم معجمة أبو عمرو البصري القاص بتشديد المهملة زاهد ضعيف من الخامسة مات قبل العشرين بخ ت ق(@)(@@)(@@)(@@) $ 7684 يزيد بن إبراهيم التستري بضم المثناة وسكون المهملة وفتح المثناة ثم راء نزيل البصرة أبو سعيد ثقة ثبت إلا في روايته عن قتادة ففيها لين من كبار السابعة مات سنة ثلاث وستين على الصحيح ع(@)(@@)(@@)(@@) $ 7685 يزيد بن الأسود أو بن أبي الأسود الخزاعي ويقال العامري صحابي نزل الطائف ووهم من ذكره في الكوفيين د ت س(@)(@@)(@@)(@@) $ 7686 يزيد بن الأصم واسمه عمرو بن عبيد بن معاوية البكائي بفتح الموحدة والتشديد أبو عوف كوفي نزل الرقة وهو بن أخت ميمونة أم المؤمنين يقال له رؤية ولا يثبت وهو ثقة من الثالثة مات سنة ثلاث ومائة بخ م 4(@)(@@)(@@)(@@) $ 7687 يزيد بن أمية أبو سنان الدؤلي مشهور بكنيته ثقة من الثانية ومنهم من عده في الصحابة د س ق(@)(@@)(@@)(@@) $ 7688 يزيد بن أمية القرشي شيخ لعمر بن ذر مجهول من السادسة قد(@)(@@)(@@)(@@) $ 7689 يزيد بن أمية آخر يروى عنه سعد بن الصلت مجهول أيضا من السابعة تمييز(@)(@@)(@@)(@@) $ 7690 يزيد بن أبي أمية الأعور مجهول من الرابعة د تم(@)(@@)(@@)(@@) $ 7691 يزيد بن أنيس الهذلي مقبول من الثانية عخ(@)(@@)(@@)(@@) $ 7692 يزيد بن أوس كوفي مقبول من الرابعة د س(@)(@@)(@@)(@@) $ 7693 يزيد بن أيهم بتحتانية وزن أحمر يكنى 
ms559	 أبا رواحة مقبول من الخامسة بخ PageV01P599(@)(@@)(@@)(@@) $ 7694 يزيد بن بابنوس بموحدتين بينهما ألف ثم نون مضمومة واو ساكنة ومهملة بصري مقبول من الثالثة بخ د تم س(@)(@@)(@@)(@@) $ 7695 يزيد بن البراء بن عازب الأنصاري الكوفي صدوق من الثالثة د س(@)(@@)(@@)(@@) $ 7696 يزيد بن بلال بن الحارث الفزاري ضعيف من الثالثة فق(@)(@@)(@@)(@@) $ 7697 يزيد بن بيان العقيلي بالضم أبو خالد البصري ضعيف من التاسعة ت(@)(@@)(@@)(@@) $ 7698 يزيد بن ثابت بن الضحاك الأنصاري أخو زيد بن ثابت وكان أسن منه واختلف في شهوده بدرا وقيل إنه استشهد باليمامة خت س ق(@)(@@)(@@)(@@) $ 7699 يزيد بن جارية بالجيم الأنصاري عن معاوية مقبول من الثالثة وقيل اسمه زيد وقيل هو بن مجمع بن جارية لا أخوه أما أخوه فصحابي وهذا هو الراجح صد س(@)(@@)(@@)(@@) $ 7700 يزيد بن حازم بن زيد الأزدي البصري أبو بكر أخو جرير ثقة من السادسة مات سنة ثمان وأربعين قد(@)(@@)(@@)(@@) $ 7701 يزيد بن أبي حبيب المصري أبو رجاء واسم أبيه سويد واختلف في ولائه ثقة فقيه وكان يرسل من الخامسة مات سنة ثمان وعشرين وقد قارب الثمانين ع(@)(@@)(@@)(@@) $ 7702 يزيد بن حجر الشامي مجهول من السابعة د(@)(@@)(@@)(@@) $ 7703 يزيد بن أبي حكيم العدني أبو عبد الله صدوق من التاسعة مات بعد سنة عشرين خ ت س ق(@)(@@)(@@)(@@) $ 7704 يزيد بن حميد الضبعي بضم المعجمة وفتح الموحدة أبو التياح بمثناة ثم تحتانية ثقيلة وآخره مهملة بصري مشهور بكنيته ثقة ثبت من الخامسة مات سنة ثمان وعشرين ع(@)(@@)(@@)(@@) $ 7705 يزيد بن الحوتكية التميمي الكوفي وأكثر ما يأتي غير مسمى مقبول من الثانية س(@)(@@)(@@)(@@) $ 7706 يزيد بن حيان التيمي الكوفي ثقة من الرابعة م د س(@)(@@)(@@)(@@) $ 7707 يزيد بن حيان النبطي بفتح النون والموحدة البلخي نزيل المدائن أخو مقاتل صدوق يخطىء من السابعة قد ت ق(@)(@@)(@@)(@@) $ 7708 يزيد بن خالد بن يزيد بن موهب بفتح الهاء الرملي أبو خالد ثقه عابد من العاشرة مات سنة اثنتين وثلاثين أو بعدها د س ق(@)(@@)(@@)(@@) $$$ يزيد بن 
ms560	 خصيفة هو بن عبد الله بن خصيفة يأتي(@)(@@)(@@)(@@) $ 7709 يزيد بن خمير بمعجمة مصغر الرحبي بمهملة ساكنة أبو عمر الحمصي صدوق من الخامسة بخ م 4(@)(@@)(@@)(@@) $ 7710 يزيد بن خمير اليزني بفتح التحتانية والزاي ثم نون الحمصي ثقة من الثالثة ووهم من ذكره في الصحابة مات في خلافة معاوية د PageV01P600(@)(@@)(@@)(@@) $ 7711 يزيد بن رباح بموحدة السهمي أبو فراس بكسر الفاء المصري ثقة من الثالثة ولم يصح أنه شهد فتح مصر الأول م ق(@)(@@)(@@)(@@) $ 7712 يزيد بن رومان المدني أبو روح مولى آل الزبير ثقة من الخامسة مات سنة ثلاثين وروايته عن أبي هريرة مرسلة ع(@)(@@)(@@)(@@) $ 7713 يزيد بن زريع بتقديم الزاي مصغر البصري أبو معاوية ثقة ثبت من الثامنة مات سنة اثنتين وثمانين ع(@)(@@)(@@)(@@) $ 7714 يزيد بن زياد بن أبي الجعد الأشجعي الكوفي صدوق من السابعة عخ س ق(@)(@@)(@@)(@@) $ 7715 يزيد بن زياد بن أبي زياد وقد ينسب لجده مولى بني مخزوم مدني ثقة من السادسة بخ ت كن(@)(@@)(@@)(@@) $ 7716 يزيد بن زياد أو بن أبي زياد القرشي الدمشقي متروك من السابعة ت ق(@)(@@)(@@)(@@) $ 7717 يزيد بن أبي زياد الهاشمي مولاهم الكوفي ضعيف كبر فتغير وصار يتلقن وكان شيعيا من الخامسة مات سنة ست وثلاثين خت م 4(@)(@@)(@@)(@@) $ 7718 يزيد بن سعيد بن ثمامة بن الأسود والد السائب صحابي شهد الفتح واستقضاه عمر بخ د ت(@)(@@)(@@)(@@) $ 7719 يزيد بن أبي سعيد المدني مولى المهري مقبول من السادسة م د(@)(@@)(@@)(@@) $ 7720 يزيد بن أبي سعيد النحوي أبو الحسن القرشي مولاهم المروزي ثقة عابد من السادسة قتل ظلما سنة إحدى وثلاثين بخ 4(@)(@@)(@@)(@@) $$$ يزيد بن سفيان أبو المهزم في الكنى(@)(@@)(@@)(@@) $ 7721 يزيد بن أبي سفيان بن حرب الأموي أخو معاوية صحابي مشهور أمره عمر على دمشق حتى مات بها سنة تسع عشرة بالطاعون ق(@)(@@)(@@)(@@) $ 7722 يزيد بن سلمة بن يزيد الجعفي صحابي له حديث ويقال إنه نزل الكوفة ت(@)(@@)(@@)(@@) $ 7723 يزيد بن أبي سليمان الكوفي مقبول من السادسة س(@)(@@)(@@)(@@) $ 7724 يزيد بن 