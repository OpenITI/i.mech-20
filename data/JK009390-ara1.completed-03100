ms3081	 الرايات السود من قبل المشرق فيقتلونكم قتلا لم | يقتله قوم فإذا رأيتموه فبايعوه ولو حبوا على الثلج فإنه خليفة الله المهدي ' . ( د ، | ك ، عن ثوبان رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28659 - قال النبي صلى الله عليه وسلم : ' يقطع الصلاة : الحمار والمرأة ، والكلب ' . | ( حم ، ه ، عن أبي هريرة ، وعن عبد الله بن مغفل رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28660 - قال النبي صلى الله عليه وسلم : ' يقطع الصلاة : المرأة الحائض والكلب الأسود ' . | ( د ، ه ، عن ابن عباس رضي الله عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28661 - قال النبي صلى الله عليه وسلم : ' يقطع الصلاة : المرأة والحمار والكلب ، ويقي من | ذلك مثل مؤخرة الرحل ' . ( م ، عن أبي هريرة رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28662 - قال النبي صلى الله عليه وسلم : ' يقطع صلاة الرجل إذا لم يكن بين يديه كمؤخرة | الرحل : المرأة ، والحمار ، والكلب الأسود ، قيل : ما بال الكلب الأسود من | الأحمر ؟ قال : الكلب الأسود شيطان ' . ( حم ، 4 حب ) عن أبي ذر رضي الله | عنه ، ز ) . | PageV09P313 |(@)(@@)(@@)(@@) $ 28663 - قال النبي صلى الله عليه وسلم : ' يقول ابن آدم : مالي مالي ، وهل لك يا ابن آدم من | مالك : إلا ما أكلت فأفنيت ، أو لبست فأبليت ، أو تصدقت فأمضيت ' . | ( حم ، م ، ت ، ن ، عن عبد الله بن الشخير رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28664 - قال النبي صلى الله عليه وسلم : ' يقول الرب تبارك وتعالى : من شغله القرآن وذكري | عن مسألتي ، أعطيته أفضل ما أعطي السائلين ، وفضل كلام الله على سائر الكلام | كفضل الله على خلقه ' . ( ت ، عن أبي سعيد رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28665 - قال النبي صلى الله عليه وسلم : ' يقول العبد : مالي مالي ، وإن له من ماله ثلاثا : ما | أكل فأفنى ، أو لبس فأبلى ، أو أعطى فاقتنى ، وما سوى ذلك فهو ذاهب وتاركه | للناس ' . ( حم ، م ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28666 - قال النبي صلى الله عليه وسلم : ' يقول العبد يوم القيامة : يا رب ! ألم تجرني من | الظلم ؟ فيقول : بلى ، فيقول : إني لا أجيز على نفسي إلا شاهدا مني ، فيقول : | كفى بنفسك اليوم 
ms3082	 عليك شهيدا ، وبالكرام الكاتبين شهودا ، فيختم على فيه ويقال | لأركانه : انطقي فتنطق بأعماله ، ثم يخلى بينه وبين الكلام فيقول : بعدا لكن | وسحقا ، فعنكن كنت أناضل ' . ( حم ، م ، ن ، عن أنس رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28667 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أخرجوا من النار من ذكرني يوما أو | خافني في مقام ' . ( ت ، ك ، عن أنس رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28668 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : المجاهد في سبيلي هو علي | ضامن ، إن قبضته أورثته الجنة ، وإن رجعته رجعته بأجر أو غنيمة ' . ( ت ، عن | أنس رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28669 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أنا عند ظن عبدي بي ، وأنا معه | PageV09P314 | إذا دعاني ' . ( حم ، عن أنس ، م ، ت ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28670 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أنا عند ظن عبدي بي ، وأنا معه | إذا ذكرني ، فإن ذكرني في نفسه ذكرته في نفسي ، وإن ذكرني في ملأ خير منهم ، | وإن تقرب إلي بشبر تقربت إليه ذراعا ، وإن تقرب إلي ذراعا تقربت إليه باعا ، وإن | أتاني يمشي أتيته هرولة ' . ( حم ، ق ، ت ، ه ، عن أبي هريرة رضي الله عنه ، | ز ) . |(@)(@@)(@@)(@@) $ 28671 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أنا عند ظن عبدي بي ، وأنا معه حين | يذكرني ، والله لله أفرح بتوبة عبده من أحدكم يجد ضالته بالفلاة ، ومن تقرب إلي شبرا | لتقربت إليه ذراعا ، ومن تقرب إلي ذراعا تقربت إليه باعا ، وإن أقبل إلي يمشي أقبلت | إليه أهرول ' ( م ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28672 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : ما لعبدي المؤمن عندي جزاء إذا | قبضت صفيه من أهل الدنيا ثم احتسبه إلا الجنة ' . ( حم ، خ ، عن أبي | هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28673 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : من أذهبت حبيبتيه فصبر واحتسب | لم أرض له ثوابا دون 
ms3083	 الجنة ' . ( ت ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28674 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : من عمل حسنة فله عشر أمثالها | وأزيد ، ومن عمل سيئة فجزاؤها مثلها أو أغفر ، ومن عمل قراب الأرض خطيئة ثم | لقيني لا يشرك بي شيئا جعلت له مثلها مغفرة ، ومن اقترب إلي شبرا اقتربت إليه | ذراعا ، ومن اقترب إلي ذراعا اقتربت إليه باعا ، ومن أتاني يمشي أتيته هرولة ' . | ( حم ، م ، ه ، عن أبي ذر رضي الله عنه ، ز ) . | PageV09P315 |(@)(@@)(@@)(@@) $ 28675 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا آدم ! فيقول : لبيك وسعديك | والخير في يديك ، فيقول : أخرج بعث النار ، قال : وما بعث النار ؟ قال : من كل | ألف تسعمائة وتسعة وتسعين ، فعندها يشيب الصغير ، وتضع كل ذات حمل حملها | وترى الناس سكارى وما هم بسكارى ولكن عذاب الله شديد ، قالوا : يا رسول الله ! | وأينا ذلك الواحد ؟ قال : أبشروا فإن منكم رجلا ومن يأجوج ومأجوج ألف ، والذي | نفسي بيده ، أرجو أن تكونوا ربع أهل الجنة ، أرجو أن تكونوا ثلث أهل الجنة ، | أرجو أن تكونوا نصف أهل الجنة ، ما أنتم في الناس إلا كالشعرة السوداء في جلد ثور | أبيض ، أو كشعرة بيضاء في جلد ثور أسود ، أو كالرقمة في ذراع الحمار ' . ( حم ، | ن ، عن أبي سعيد رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28676 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم إذا أخذت كريمتيك | فصبرت واحتسبت عند الصدمة الأولى لم أرض لك ثوابا دون الجنة ' . ( حم ، م ، | عن أبي أمامة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28677 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم أنى تعجزني وقد | خلقتك من مثل هذا ، حتى إذا سويتك وعدلتك مشيت بين بردين وللأرض منك | وئيد ، فجمعت ومنعت ، حتى إذا بلغت التراقي قلت : أتصدق وأنى أوان الصدقة ' . | ( حم ، ه ، ك ، عن بسر بن جحاش رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28678 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : يا عبادي كلكم ضال 
ms3084	 إلا من | هديته فسلوني الهدى أهدكم ، وكلكم فقير إلا من أغنيت فسلوني أرزقكم ، وكلكم | مذنب إلا من عافيت فمن علم منكم أني ذو قدرة على المغفرة فاستغفرني غفرت له ولا | أبالي ، ولو أن أولكم وآخركم وحيكم وميتكم ورطبكم ويابسكم اجتمعوا على أتقى | قلب عبد من عبادي ما زاد ذلك في ملكي جناح بعوضة ، ولو أن أولكم وآخركم وحيكم | PageV09P316 | وميتكم ورطبكم ويابسكم اجتمعوا على أشقى قلب عبد من عبادي ما نقص ذلك من | ملكي جناح بعوضة ، ولو أن أولكم وآخركم وحيكم وميتكم ورطبكم ويابسكم اجتمعوا | في صعيد واحد فسأل كل إنسان منكم ما بلغت أمنيته ، فأعطيت كل سائل منكم ، ما | نقص ذلك من ملكي إلا كما لو أن أحدكم مر بالبحر فغمس فيه إبرة ثم رفعها إليه ، | ذلك بأني جواد واجد ماجد أفعل ما أريد ، عطائي كلام ، وعذابي كلام ، إنما أمري | لشيء إذا أردته أن أقول له كن فيكون ' . ( ت ، ن ، ه ، عن أبي ذر رضي الله | عنه ، ز ) |(@)(@@)(@@)(@@) $ 28679 - قال النبي صلى الله عليه وسلم : ' يقولون : الكرم ، وإنما الكرم : قلب المؤمن ' . | ( خ ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28680 - قال النبي صلى الله عليه وسلم : ' يقوم أحدهم في رشحه إلى أنصاف أذنيه ' . ( خ ، | ت ، ه ، عن ابن عمر رضي الله عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28681 - قال النبي صلى الله عليه وسلم : ' يقي أحدكم وجهه حر جهنم ولو بتمرة ولو بشق | تمرة ، فإن أحدكم لاقي الله وقائل له ما أقول لأحدكم : ألم أجعل لك سمعا وبصرا ؟ | فيقول : بلى ، فيقول : ألم أجعل لك مالا وولدا ؟ فيقول : بلى ، فيقول : أين ما | قدمت لنفسك ؟ فينظر قدامه وبعده وعن يمينه وعن شماله ثم لا يجد شيئا يقي به وجهه | حر جهنم ، ليق أحدكم وجهه النار ولو بشق تمرة ، فإن لم يجد فبكلمة طيبة ، فإني لا | أخاف عليكم الفاقة فإن الله ناصركم ومعطيكم حتى تسير الظعينة فيما بين يثرب | والحيرة ، وأكثر ما يخاف على مطيتها السرق ' . ( ت ، عن عدي بن حاتم رضي الله | عنه ، ز ) |(@)(@@)(@@)(@@) |||| ( الإكمال من 
ms3085	 الجامع الكبير )(@)(@@)(@@)(@@) $ 28682 - قال النبي صلى الله عليه وسلم : ' يقاتل بقيتكم الدجال على نهر الأردن ، أنتم شرقي | النهر وهم غربيه ' . ( ابن سعد عن نهيك بن صريم السكوني رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28683 - قال النبي صلى الله عليه وسلم : ' يقال للعاق : اعمل ما شئت من الطاعة فإني لا أغفر | PageV09P317 | لك ، ويقال للبار : اعمل ما شئت فإني أغفر لك ' . ( حل ، عن عائشة رضي الله | عنها ) . |(@)(@@)(@@)(@@) $ 28684 - قال النبي صلى الله عليه وسلم : ' يقال لرجال يوم القيامة : اطرحوا أسياطكم وادخلوا | جهنم ' . ( ك ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28685 - قال النبي صلى الله عليه وسلم : ' يقال للإمام العادل في قبره : أبشر فإنك رفيق | محمد ' . ( أبو نعيم عن معاذ رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28686 - قال النبي صلى الله عليه وسلم : ' يقال للجلواز يوم القيامة : ضع سوطك وادخل | النار ' . ( الديلمي عن عبد الرحمن بن سمرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28687 - قال النبي صلى الله عليه وسلم : ' يقال لأهل الجنة : إن لكم أن تصحوا فلا تسقموا | أبدا ، وإن لكم أن تعيشوا فلا تموتوا أبدا ، وإن لكم أن تنعموا فلا تبأسوا أبدا ، وإن | لكم أن تشيبوا فلا تهرموا أبدا ' . ( الخطيب في المتفق والمفترق عن أبي سعيد وأبي | هريرة رضي الله عنهما معا ورجاله ثقات ) . |(@)(@@)(@@)(@@) $ 28688 - قال النبي صلى الله عليه وسلم : ' يقبل الجبار عز وجل فيثني رجله على الجسر | ويقول : وعزتي وجلالي ! لا يتجاوزني اليوم ظلم ، فينصف الخلق من بعضهم | ببعض ، حتى إنه ينصف الشاة الجماء من العضباء بنطحة نطحتها ' . ( طب ، عن | ثوبان رضي الله عنه وضعف ) . |(@)(@@)(@@)(@@) $ 28689 - قال النبي صلى الله عليه وسلم : ' يقبض الله العلماء ويقبض العلم معهم ، فينشأ | أحداث ينزو بعضهم على بعض نزو العير على العير ، ويكون الشح فيهم | مستضعفا ' . ( طس ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28690 - قال النبي صلى الله عليه وسلم : ' يقتص للجماء من القرناء يوم القيامة ' . ( . . . . . . | عن سلمان رضي الله عنه ) . | PageV09P318 |(@)(@@)(@@)(@@) $ 28691 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الغراب والحدأة والعقرب والكلب | العقور والفأرة ' . ( طب ، عن ابن عباس وابن عمر 
ms3086	 رضي الله عنهما معا ) . |(@)(@@)(@@)(@@) $ 28692 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الحدأة والعقرب والكلب العقور | والفأرة ، كل هؤلاء فويسقة ' . ( الخطيب عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28693 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الأفعى والعقرب والحدأة والكلب | العقور والفويسقة ' . ( حم ، ع ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28694 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الحية والعقرب والفويسقة والكلب | العقور والحدأة والسبع العادي ويرمي الغراب ولا يقتله ' . ( حم ، هق ، عن أبي | سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28695 - قال النبي صلى الله عليه وسلم : ' يقتل المارقون أحب الفئتين إلى الله وأقرب الفئتين | من الله ' . ( ع ، والخطيب عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28696 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الحية والعقرب والسبع العادي والكلب | العقور والفأرة الفويسقة ' . ( ه ، هق ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28697 - قال النبي صلى الله عليه وسلم : ' يقتل المحرم الحية والذئب ' . ( هق ، عن سعيد بن | المسيب مرسلا ) . |(@)(@@)(@@)(@@) $ 28698 - قال النبي صلى الله عليه وسلم : يقتل ابن مريم الدجال بباب لد ' . ( طب ، عن | مجمع بن جارية رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28699 - قال النبي صلى الله عليه وسلم : ' يقتل الدجال دون باب لد بسبعة عشرة ذراعا ' . | ( ابن عساكر عن مجمع بن جارية رضي الله عنه ) . | PageV09P319 |(@)(@@)(@@)(@@) $ 28700 - قال النبي صلى الله عليه وسلم : ' يقتل بهذه الحرة خيار أمتي بعد أصحابي ' . ( هق ، | في الدلائل والخطيب وابن عساكر عن أيوب بن بشر المعاوي مرسلا ) . |(@)(@@)(@@)(@@) $ 28701 - قال النبي صلى الله عليه وسلم : ' يقتل في جلل الخليل والقطران من أصحابي | ناس ' . ( البغوي وابن عساكر عن يزيد بن أبي حبيب عن رجال من الصحابة ) . |(@)(@@)(@@)(@@) $ 28702 - قال النبي صلى الله عليه وسلم : ' يقتل القاتل ويحبس الممسك ' . ( قط ، هق ، ك ، | عن إسماعيل بن أمية مرسلا ) . |(@)(@@)(@@)(@@) $ 28703 - قال النبي صلى الله عليه وسلم : ' يقرب إلى فيه فيكرهه ، فإذا أدني منه شوى وجهه | ووقعت فروة رأسه ، فإذا شربه قطع أمعاءه حتى يخرج من دبره ' . ( ت ، غريب ، | ك ، عن أبي أمامة رضي الله عنه 
ms3087	 في قوله : يسقى من ماء صديد يتجرعه قال | فذكره ) . |(@)(@@)(@@)(@@) $ 28704 - قال النبي صلى الله عليه وسلم : ' يقرب من الجهاد : طيب الكلام ، وإدامة الصيام ، | والحج كل عام ، ولا يقرب منه شيء بعد ' . ( هب ، عن رجال من الصحابة ) . |(@)(@@)(@@)(@@) $ 28705 - قال النبي صلى الله عليه وسلم : ' يقضى للنبيين يوم القيامة أول الناس ، ثم يقضى | لفقراء المؤمنين على أثرهم فيستحبون في الجنة سبعين خريفا قبل أن يفرغ من حساب | الناس ' . ( ك ، في تاريخه عن ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28706 - قال النبي صلى الله عليه وسلم : ' : ' يقطع الصلاة : الكلب ، والحمار ، والمرأة | الحائض ، واليهودي ، والنصراني ، والمجوسي ، والخنزير ، ويكفيك إذا كانوا منك | على قدر رمية بحجر لم يقطعوا صلاتك ' . ( هق ، عن ابن عباس رضي الله | عنهما ) . |(@)(@@)(@@)(@@) $ 28707 - قال النبي صلى الله عليه وسلم : ' يقعد المقتول بالجادة ، فإذا مر القاتل أخذه فيقول : | يا رب ! هذا قطع علي صومي وصلاتي فيعذب القاتل والآمر به ' . ( هب ، عن أبي | الدرداء رضي الله عنه ) . | PageV09P320 |(@)(@@)(@@)(@@) $ 28708 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : ابن آدم إن تقبل قبلي أملأ قلبك | غنى ، وأنزع الفقر من بين عينيك ، وأكف عليك ضيعتك ، فلا تصبح إلا غنيا ، ولا | تمسي إلا غنيا ، وإن أدبرت أو وليت عني نزعت الغنى من قلبك ، وجعلت الفقر بين | عينيك ، وأفشيت ضيعتك ، فلا تصبح إلا فقيرا ، ولا تمسي إلا فقيرا ' . ( أبو | الشيخ عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28709 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : من أعظم مني جودا ؟ أكلأهم | في مضاجعهم كأنهم لم يعصوني ، ومن كرمي أن أقبل توبة التائب حتى كأنه لم يزل | تائبا ، من ذا الذي قرع بابي فلم أفتح له ؟ ، من ذا الذي سألني فلم أعطه ، أبخيل أنا | فيبخلني عبدي ، فيبخلني عبدي ' . ( الديلمي عن أبي هدبة عن أنس رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28710 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : من لم تصم جوارحه عن | محارمي فلا حاجة لي في أن يدع طعامه وشرابه من أجلي ' . ( أبو نعيم عن ابن 
ms3088	 | مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28711 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : إن كنتم تحبون رحمتي فارحموا | خلقي ' . ( أبو الشيخ ، كر ، والديلمي عن أبي بكر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28712 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : ما غضبت على أحد غضبي | على عبد أتى معصية فيتعاظمها في جنب عفوي ، فلو كنت معجلا العقوبة ، أو كانت | العجلة من شأني لعجلتها للقانطين من رحمتي ، ولو لم أرحم عبادي إلا من خوفهم | من الوقوف بين يدي لشكرت ذلك لهم وجعلت ثوابهم منه الأمن لما خافوا ' . | ( الديلمي عن المنتجع رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28713 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : إن سألني عبدي أعطيته ، وإن | PageV09P321 | لم يسألني غضبت عليه ' . ( أبو الشيخ عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28714 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : الشاب المؤمن بقدري ، | الراضي بكتابي ، القانع برزقي ، التارك لشهوته من أجلي ، هو عندي كبعض | ملائكتي ' . ( الديلمي عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28715 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : قل لأمتك يقولوا : لا حول ولا | قوة إلا بالله عشرا عند الصبح ، وعشرا عند المساء ، وعشرا عند النوم يدفع عنهم | عند النوم بلوى الدنيا ، وعند المساء مكايدة الشيطان ، وعند الصبح أسوأ غضبي ' . | ( الديلمي عن ابن عباس عن أبي بكر رضي الله عنهم ) . |(@)(@@)(@@)(@@) $ 28716 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : لأقطعن أمل كل مؤمل أمل | دوني بالأياس ، ولألبسنه ثوب المذلة بين الناس ، ولأنحينه من قربي ، ولأبعدنه من | وصلي ، أيأمل عبدي غيري في الشدائد والشدائد بيدي وأنا الحي الكريم ، ويرجو | غيري وبيدي مفاتيح الأبواب ، وبابي مفتوح لمن دعاني ، من ذا الذي أملني لعظيم | نوائبه فقطعت به دونها ، أم من ذا الذي رجاني لعظيم جرمه فقطعت رجاءه مني ، | جعلت آمال عبادي متصلة بي ، وملأت سماواتي من لا يمل تسبيحي ، فيابؤسا | للقانطين من رحمتي ، ويا شقوة لمن عصاني ولم يراقبني ' . ( الديلمي عن أبي | ذر 
ms3089	 رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28717 - قال النبي صلى الله عليه وسلم : ' يقول الله : يا ابن آدم ! اذكرني حين تغضب أذكرك | حين أغضب ولا أمحقك فيمن أمحق ' . ( ابن شاهين عن ابن عباس رضي الله عنهما | وفيه عثمان بن عطاء الخراساني ضعفوه ) . |(@)(@@)(@@)(@@) $ 28718 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : الرحم شجنة ، فمن وصلها | وصلته ، ومن قطعها قطعته ' . ( كر ، عن عامر بن ربيعة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28719 - قال النبي صلى الله عليه وسلم : ' يقول الله : الكبرياء ردائي ، والعظمة إزاري ، فمن | PageV09P322 | نازعني واحدا منهما ألقيته في جهنم ' . ( ابن النجار عن ابن عباس رضي الله | عنهما ) . |(@)(@@)(@@)(@@) $ 28720 - قال النبي صلى الله عليه وسلم : ' يقول الله لعبده يوم القيامة : يا ابن آدم ! ألم أحملك | على الخيل والإبل ، وأزوجك النساء ، وأجعلك تربع وترأس ؟ فيقول : بلى أي | رب ، فيقول أين شكر ذلك ؟ ' . ( هب ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28721 - قال النبي صلى الله عليه وسلم : ' يقول الله تبارك وتعالى للعبد يوم القيامة : ألم تدعني | لمرض كذا وكذا فعافيتك ؟ ألم تدعني أن أزوجك كريمة قومها فزوجتك ؟ ألم ؟ | ألم ؟ ' . ( أبو الشيخ ، هب ، عن عبد الله بن سلام رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28722 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى يوم القيامة : أدنوا مني أحبابي ، | فيقول الملائكة : ومن أحباؤك ؟ فيقول : فقراء المسلمين ، فيدنون منه ، فيقول | الله : أما إني لم أزو الدنيا عنكم لهوان كان بكم علي ، ولكن أردت بذلك أن أضعف | لكم كرامة اليوم ، فتمنوا علي ما شئتم اليوم ، فيؤمر بهم إلى الجنة قبل الأغنياء | بأربعين خريفا ' . ( أبو الشيخ عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28723 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : قربوا أهل لا إله إلا الله محمد | رسول الله من ظل عرشي فإني أحبهم ' . ( الديلمي عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28724 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : يا ابن آدم ! إن الشيب نور من | نوري ، وإني أستحي أن أعذب نوري بناري فاستحي مني ' . ( أبو الشيخ عن | أنس 
ms3090	 رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28725 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم ! إن نازعك بصرك إلى | بعض ما حرمت عليك فقد أعنتك عليه بطبقتين فاطبقهما عليه ، وإن نازعك لسانك | إلى بعض ما حرمت عليك فقد أعنتك بطبقتين فاطبقهما عليه ، وإن نازعك فرجك فقد | أعنتك عليه بطبقتين فاطبقهما عليه ' . ( الديلمي عن أبي هريرة رضي الله عنه ) . | PageV09P323 |(@)(@@)(@@)(@@) $ 28726 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم بمشيئتي كنت أنت | الذي تشاء لنفسك ما تشاء ، وبإرادتي كنت أنت الذي تريد لنفسك ما تريد ، وبفضل | نعمتي عليك قويت على معصيتي ، وبعصمتي وتوفيقي وعوني وعافيتي أديت إلي | فرائضي ، فأنا أولى بإحسانك منك ، وأنت أولى بذنبك مني ، فالخير مني إليك بداء ، | والشر منك إلي بما جنيت جزاء ، ورضيت منك لنفسي ما رضيت لنفسك مني ' . ( أبو | نعيم عن ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28727 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : ابن آدم أمرتك فتوليت ، | ونهيتك فتماديت ، وسترت عليك فتجرأت ، وأعرضت عنك فما باليت ، يا من إذا | مرض شكى وبكى ، وإذا عوفي تمرد وعصى ، يا من إذا دعاه العبيد عدا ولبى ، وإن | دعاه الخليل أعرض ونأى ، إن سألتني أعطيتك ، وإن دعوتني أجبتك وإن مرضت | شفيتك ، وإن افتقرت رزقتك ، وإن أقبلت قبلتك ، وإن تبت غفرت لك وأنا التواب | الرحيم ' . ( الديلمي عن أبي هريرة عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28728 - قال النبي صلى الله عليه وسلم : ' يقول الله : إذا تقرب مني عبدي شبرا تقربت منهث | ذراعا ، وإذا تقرب مني ذراعا تقربت منه باعا ، وإذا أتاني ماشيا أتيته هرولة ' . ( ط ، | حم ، خ ، عن قتادة عن أنس ، خ ، عن الغنيمي عن أنس عن أبي هريرة رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28729 - قال النبي صلى الله عليه وسلم : ' يقول الله : ما من عبد قضيت عليه قضية رضيها أو | سخطها إلا كان خيرا له ' . ( ابن شاهين ، ض ، عنه ، قال ابن شاهين : هذا حديث | غريب ليس في الدنيا إسناد أحسن منه ، قال ابن حجر 
ms3091	 : وله شاهد من حديث | صهيب رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28730 - قال النبي صلى الله عليه وسلم : ' يقول الله : إني لأهم بأهل الأرض عذابا ، فإذا | PageV09P324 | نظرت إلى عمار بيوتي المتحابين في ، وإلى المستغفرين بالأسحار صرفت عنهم ' . | ( هب ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28731 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى للعلماء يوم القيامة إذا قعد على | كرسيه لقضاء عباده : إني لم أجعل علمي وحلمي فيكم إلا وأنا أريد أن أغفر لكم على | ما كان منكم ولا أبالي ' . ( طب ، وأبو نعيم عن ثعلبة بن الحكم الليثي رضي الله عنه | وحسن ) |(@)(@@)(@@)(@@) $ 28732 - قال النبي صلى الله عليه وسلم : ' يقول الله يوم القيامة : يا معشر العلماء ! إني لم | أضع علمي فيكم إلا لمعرفتي بكم ، قوموا فإني قد غفرت لكم ' . ( الطيسي في | الترغيب عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28733 - قال النبي صلى الله عليه وسلم : ' يقول الله : يا ابن آدم ! واحدة لك ، وواحدة لي ، | وواحدة فيما بيني وبينك ، فأما التي لي فتعبدني لا تشرك بي شيئا ، وأما التي لك : فما | عملت من شيء أو من عمل وفيتكه ، وأما التي فيما بيني وبينك : فمنك الدعاء وعلي | الإجابة ' . ( بز ، عن أنس رضي الله عنه وضعف ) . |(@)(@@)(@@)(@@) $ 28734 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : لست بناظر في حق عبدي حتى | ينظر عبدي في حقي ' . ( طب ، عن ابن عباس رضي الله عنه وضعف ) . |(@)(@@)(@@)(@@) $ 28735 - قال النبي صلى الله عليه وسلم : ' يقولث الله تعالى : تفضلت على عبيدي بأربع | خصال : سلطت الدابة على الحبة ، ولولا ذلك لادخرتها الملوك كما يدخرون الذهب | والفضة ، وألقيت النتن على الجسد ، ولولا ذلك ما دفن خليل خليله أبدا ، وسلطت | السلو على الحزن ولولا ذلك لانقطع النسل ، وقضيت الأجل وأطلت الأمل ، ولولا | ذلك لخربت الدنيا ولم يتهن ذو معيشة بعيشته ' . ( الخطيب عن البراء رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28736 - قال النبي صلى الله عليه وسلم : ' يقول الله : إني تفضلت على عبادي بثلاث : ألقيت | الدابة على الحبة ، ولولا ذلك لكنزها الملوك كما يكنزون الذهب والفضة ، وألقيت 
ms3092	 | PageV09P325 | النتن على الجسد ولولا ذلك لم يدفن حميم حميمه ، وأذهبت الحزن ، ولولا ذلك | لذهب النسل ' . ( الديلمي عن زيد بن أرقم رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28737 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : من تواضع لي هكذا رفعته | هكذا ' . ( حم ، ع ، والشاشي ، طص ، ض ، عن عمر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28738 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : ثلاث من النعم لا أسأل عبدي | عن شكرهن وأسأله عما سوى ذلك : بيت يسكنه ، وما يقيم به صلبه من الطعام ، وما | يواري به عورته من اللباس ' . ( هناد عن الضحاك مرسلا ) . |(@)(@@)(@@)(@@) $ 28739 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : إني لأستحي من عبدي وأمتي | يشيبان في الإسلام ، فتشيب لحية عبدي ورأس أمتي في الإسلام أعذبهما في النار | بعد ذلك ' . ( ع ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28740 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم اختر الجنة على النار ، | ولا تبطلوا أعمالكم فتقذفوا في النار منكسين خالدين فيها أبدا ' . ( الرافعي عن | علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28741 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا ابن آدم ما تنصفني ، أتحبب | إليك بالنعم ، وتتمقت إلي بالمعاصي ، خيري إليك منزل وشرك إلي صاعد ، ولا | يزال ملك كريم يأتيني عنك كل يوم وليلة بعمل قبيح ، يا ابن آدم ! لو سمعت | وصفك من غيرك وأنت لا تعلم من الموصوف لسارعت إلى مقته ' . ( الديلمي | والرافعي عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28742 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : إني لأجدني أستحي من عبدي | يرفع يديه إلي ثم أردهما قالت الملائكة : إلهنا ليس هو بأهل ، قال الله تعالى : لكني | أهل التقوى وأهل المغفرة ، أشهدكم أني قد غفرت له ' . ( الحكيم عن أنس رضي | الله عنه ) . | PageV09P326 |(@)(@@)(@@)(@@) $ 28743 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : وعزتي وجلالي لأنتقمن من | الظالم في عاجله وآجله ، ولأنتقمن ممن رأى مظلوما فقدر أن ينصره فلم ينصره ' . | ( الحاكم في الكنى والشيرازي في الألقاب 
ms3093	 ، طب ، والخرائطي في مساوئ الأخلاق | وابن عساكر عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28744 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : وعزتي وجلالي ، وارتفاعي | فوق خلقي ، لا أجمع على عبدي خوفين ولا أجمع لعبدي أمنين ، فمن خافني في | الدنيا أمنته اليوم ، ومن أمنني في الدنيا أخفته اليوم ' . ( ابن عساكر عن أنس رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 28745 - قال النبي صلى الله عليه وسلم : ' يقول الله : وعزتي لا أجمع على عبدي خوفين ولا | أجمع له أمنين ، إن أمنني في الدنيا أخفته يوم القيامة ، وإن خافني في الدنيا آمنته يوم | القيامة ' . ( ابن المبارك والحكيم عن أنس وابن عباس مرسلا ، ابن المبارك ، هب ، | حب ، عن ابن مسعود عن أبي سلمة عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28746 - قال النبي صلى الله عليه وسلم : ' يقول الله تبارك وتعالى : من شغله قراءة القرآن على | دعائي ومسألتي أعطيته أفضل ثواب الشاكرين ' . ( ابن الأنباري في الوقف وأبو عمرو | الداني في طبقات القراء عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28747 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : ' من شغله ذكري عن مسألتي | أعطيته أفضل ما أعطي السائلين ' . ( خ ، في خلق أفعال العباد ، وابن شاهين في | الترغيب في الذكر ، وأبو نعيم في المعرفة ، هب ، عن عمر ، هب عن جابر رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 28747 - قال النبي صلى الله عليه وسلم : ' يقول الله : من شغله ذكري عن مسألتي أعطيته فوق | ما أعطي السائلين ' . ( ش ، عن عمرو بن مرة مرسلا ) . |(@)(@@)(@@)(@@) $ 28749 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أنا الرحمن وهي الرحم ، جعلت | لها شجنة مني من وصلها وصلته ومن قطعها بتته ، لها يوم القيامة لسان زلق ' . | PageV09P327 | ( الحكيم عن عمرو بن شعيب عن أبيه عن جده ) . |(@)(@@)(@@)(@@) $ 28750 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : من أهان لي وليا فقد بارزني | بالمحاربة ، وإني لأسرع شيء إلى نصرة أوليائي إني لأغضب لهم كما يغضب الليث | الحرب ، وما ترددت عن شيء أنا فاعله ترددي عن قبض روح عبدي 
ms3094	 المؤمن وهو | يكره الموت وأكره مساءته ولا بد له منه ، وما تعبد لي عبدي المؤمن بمثل الزهد في | الدنيا ، ولا تقرب عبدي المؤمن بمثل أداء ما افترضت عليه ، ولا يزال عبدي يتقرب | إلي بالنوافل حتى أحبه ، فإذا أحببته كنت له سمعا وبصرا ويدا وموئلا ، إن سألني | أعطيته ، وإن دعاني أستجيب له ، وإن من عبادي المؤمنين لمن يسألني الباب من | العبادة فأكفه عنه ، ولو أعطيته إياه لداخله العجب وأفسده ذلك ، وإن من عبادي | المؤمنين لمن لا يصلح له إلا الغنى ولو أفقرته لأفسده ذلك ، وإن من عبادي المؤمنين | لمن لا يصلح له إلا الفقر ، ولو أغنيته لأفسده ذلك ، وإن من عبادي المؤمنين لمن لا | يصلحه إلا الصحة ولو أسقمته لأفسده ذلك وإن من عبادي المؤمنين لمن لا يصلح له | إلا السقم ولو أصححته لأفسده ذلك ، إني أدبر عبادي بعلمي بقلوبهم إني عليم | خبير ' . ( ابن أبي الدنيا في كتاب الأولياء والحكيم وابن مردويه ، حل ، هق ، في | الأسماء وابن عساكر عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28751 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : لا إله إلا الله حصني ، فمن دخلهث | أمن عذابي ' . ( ابن النجار عن علي ، ابن النجار عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28752 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : أنا الله لا إله إلا أنا كلمتي من | قالها أدخلته جنتي ، ومن أدخلته جنتي فقد أمن ، والقرآن كلامي ومن قرأه فقد أمن ، | والقرآن كلامي ومني خرج ' . ( الخطيب عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28753 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : من أبر أحدا من خلقي ضعيفا فلم | PageV09P328 | يكن معه ما يكافؤه عليه كافيته أنا عليه ' . ( الخطيب عن دينار عن أنس رضي الله | عنهما ) . |(@)(@@)(@@)(@@) $ 28754 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : يا أهل الجنة ! بقي لكم شيء لم | تنالوه ؟ فيقولون : وما هو يا ربنا فيقول : رضواني ' . ( الحكيم عن جابر رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28755 - قال النبي صلى الله عليه وسلم : ' يقول الله تبارك وتعالى 
ms3095	 : من عادى لي وليا فقد | ناصبني بالمحاربة ، وما ترددت عن شيء أنا فاعله كترددي عن موت المؤمن ، يكره | الموت وأنا أكره مساءته ، وربما سألني وليي المؤمن الغنى فأصرفه من الغنى إلى الفقر | ولو صرفته إلى الغنى لكان شرا له ، وربما سألني وليي المؤمن الفقر فأصرفه إلى الغنى | ولو صرفته إلى الفقر لكان شرا له ، إن الله تعالى قال : وعزتي وجلالي ، وعلوي | وبهائي ، وجمالي وارتفاع مكاني ، لا يؤثر عبد هواي على هوى نفسه إلا أثبت أجله | عند بصره ، وضمنت السماء والأرض رزقه وكنت له من وراء تجارة كل تاجر ' . | ( طب ، عن ابن عباس رضي الله عنهما وحسن ) . |(@)(@@)(@@)(@@) $ 28756 - قال النبي صلى الله عليه وسلم : ' يقول الله تبارك وتعالى يوم القيامة : يا آدم ! قم | فجهز من ذريتك تسعمائة وتسعة وتسعين إلى النار وواحدا إلى الجنة ، فبكى أصحابه | وبكى ، فقال : ارفعوا رؤوسكم ، فوالذي نفسي بيده ! ما أمتي في الأمم إلا كالشعرة | البيضاء في جلد الثور الأسود ' . ( طب ، عن أبي الدرداء رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28757 - قال النبي صلى الله عليه وسلم : ' يقول الله : لا أذهب بصفيتي عبدي فأرضى له ثوابا | دون الجنة ' . ( حل ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28758 - قال النبي صلى الله عليه وسلم : ' يقول الرب عز وجل يوم القيامة : سيعلم أهل | الجمع اليوم من أهل الكرم ، قيل : وما أهل الكرم يا رسول الله ؟ قال : أهل | PageV09P329 | مجالس الذكر في المساجد ' . ( حم ، حب ، وابن شاهين في الترغيب في الذكر ، | هب ، ع ، ض ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28759 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : قد حقت محبتي للذين يتحابون | من أجلي ، وقد حقت محبتي للذين يتزاورون من أجلي ، وقد حقت محبتي للذين | يتباذلون من أجلي وقد حقت محبتي للذين يتصادقون من أجلي ، وقد حقت محبتي | للذين يتناصرون من أجلي ، ما من مؤمن ولا مؤمنة يقدم الله له ثلاثة أولاد من صلبه لم | يبلغوا الحنث إلا أدخله الله الجنة بفضل رحمته إياهم ' . ( ابن أبي الدنيا في كتاب | الإخوان ، طب ، عن عمرو 
ms3096	 بن عبسة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28760 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : لي العظمة والكبرياء والفخر ، | والقدر سري ، فمن نازعني في واحدة منهن كببته في النار ' . ( الحكيم عن | أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28761 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : ابن آدم ! قم إلي أمش إليك ، | امش إلي أهرول إليك ، ابن آدم ! إن دنوت مني شبرا دنوت منك ذراعا ، وإن دنوت | مني ذراعا دنوت منك باعا ، ابن آدم ! إن حدثت نفسك بحسنة فلم تعملها كتبتها لك | حسنة ، وأن عملتها كتبتها لك عشرا ، وإن هممت بسيئة فحجزك عنها هيبتي كتبتها | لك حسنة ، فإن عملتها كتبتها سيئة واحدة ' . ( ك ، وابن النجار عن أبي ذر رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28762 - قال النبي صلى الله عليه وسلم : ' يقول ربكم : يا ابن آدم ! تفرغ لعبادتي أملأ قلبك | غنى ، وأملأ يديك رزقا ، يا ابن آدم ! لا تباعد مني فأملأ قلبك فقرا ، وأملأ يديك | شغلا ' . ( طب ، ك ، عن مغفل بن يسار رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28763 - قال النبي صلى الله عليه وسلم : ' يقول الله : المتحابون لجلالي في ظل عرشي يوم لا | ظل إلا ظلي ' . ( حم ، ابن أبي الدنيا في كتاب الإخوان ، طب ، حل ، عن | العرباض رضي الله عنه ) . | PageV09P330 |(@)(@@)(@@)(@@) $ 28764 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : إنما أتقبل الصلاة ممن تواضع | لعظمتي ، ولم يتكبر على خلقي ، وقطع نهاره بذكري ، ولم يبت مصرا على خطيئته ، | يطعم الجائع ويؤوي الغريب ، ويرحم الصغير ، ويوقر الكبير ، فذاك الذي يسألني | فأعطيه ، ويدعوني فأستجيب له ، ويتضرع إلي فأرحمه فمثله عندي كمثل الفردوس | في الجنان لا يتسنى ثمارها ، ولا يتغير حالها ' . ( قط ، في الأفراد عن علي رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 28765 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : استقرضت عبدي فلم يقرضني ، | وشتمني عبدي وهو لا يدري ، يقول : وادهراه وادهراه وأنا الدهر ' . ( ابن جرير ، | ك ، هق ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28766 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : في سدر مخضود يخضد الله 
ms3097	 | شوكه فيجعل مكان كل شوكة ثمرة ، إنها تنبت ثمرا يفتق الثمر منها عن اثنين وسبعين | لونا من الطعام ما منها لون يشبه الآخر ' . ( ك ، هق ، في البعث عن أبي أمامة رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 28767 - قال النبي صلى الله عليه وسلم : ' يقول الله عز وجل : إذا كان الغالب على العبد | الاشتغال بي جعلت بغيته ولذته في ذكري ، فإذا جعلت بغيته ولذته في ذكري عشقني | وعشقته ، فإذا عشقني وعشقته رفعت الحجاب فيما بيني وبينه وصيرت ذلك مغالبا عليه | لا يسهو إذا سها الناس ، أولئك كلامهم كلام الأنبياء ، أولئك الأبطال حقا ، أولئك | الذين إذا أردت بأهل الأرض عقوبة وعذابا ذكرتهم فصرفت ذلك عنهم ' . ( حل ، | عن الحسن مرسلا ) . |(@)(@@)(@@)(@@) $ 28768 - قال النبي صلى الله عليه وسلم : ' يقول الله تعالى : انظروا في ديوان عبدي ، فمن | PageV09P331 | رأيتموه سألني الجنة أعطيته ، ومن استعاذني من النار أعذته ' . ( حل ، عن | أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28769 - قال النبي صلى الله عليه وسلم : ' يقول القبر للميت حين يوضع فيه : ويحك يا ابن | آدم ، ما غرك بي ؟ ألم تعلم أني بيت الظلمة ، وبيت الفتنة ، وبيت الوحدة ، وبيت | الدود ، ما غرك بي إذ كنت تمشي فددا ، فإن كان مصلحا أجاب عنه مجيب القبر | فيقول : أرأيت إنه كان يأمر بالمعروف وينهى عن المنكر ، فيقول القبر : إني إذن أعود | إليه خضرا ، ويعود جسده عليه نورا وتصعد روحه إلى رب العالمين ' . ( الحكيم ، | ع ، طب ، حل ، عن أبي الحجاج الثمالي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28770 - قال النبي صلى الله عليه وسلم : ' يقول أهل النار : هلموا فلنصبر ، فيصبروا خمسمائة | عام ، فلما رأوا ذلك لا ينفعهم قالوا : هلموا فلنجزع ، فيبكون خمسمائة عام ، فلما | رأوا ذلك لم ينفعهم قالوا : سواء علينا أجزعنا أم صبرنا ما لنا من محيص ' . ( طب ، | عن كعب بن ملك رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28771 - قال النبي صلى الله عليه وسلم : ' يقول البلاء كل يوم : إلى أين أتوجه ؟ فيقول الله | عز وجل : إلى أحبابي وأولي طاعتي أبلو بك أخيارهم ، وأختبر صبرهم ، وأمحص بك | ذنوبهم ، وأرفع بك درجاتهم . ويقول الرخاء كل 
ms3098	 يوم : إلى أين أتوجه ؟ فيقول الله | عز وجل : إلى أعدائي وأهل معصيتي ، أزيد بذلك طغيانهم ، وأضاعف بذلك | ذنوبهم ، وأعجل بك لهم ، وأكثر بك على غفلتهم ' . ( الديلمي عن أنس رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28772 - قال النبي صلى الله عليه وسلم : ' يقوم الرجل من مجلسه لأخيه إلا بني هاشم لا | يقومون لأحد ' . ( طب ، والخطيب عن أبي أمامة رضي الله عنه ) . | PageV09P332 |(@)(@@)(@@)(@@) ||| ( الياء مع الكاف )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28773 - قال النبي صلى الله عليه وسلم : ' يكسى الكافر لوحين من نار في قبره ' . ( ابن مردويه | عن البراء رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28774 - قال النبي صلى الله عليه وسلم : ' يكون اختلاف عند موت خليفة فيخرج رجل من | أهل المدينة هاربا إلى مكة فيأتيه أهل مكة فيخرجونه وهو كاره فيبايعونه بين الركن | والمقام ويبعث إليه بعث من الشام فيخسف بهم بالبيداء بين مكة والمدينة ، فإذا رأى | الناس ذلك أتاه أبدال الشام وعصائب أهل العراق فيبايعونه ثم ينشو رجل من قريش | أخواله كلب فيبعث إليهم بعثا فيظهرون عليهم وذلك بعث كلب ، والخيبة لمن لم | يشهد غنيمة كلب ، فيقسم المال ويعمل في الناس بسنة نبيهم ويلقي الإسلام بجرانه | إلى الأرض ، فيلبث سبع سنين ثم يتوفى ويصلي عليه المسلمون ' . ( حم ، د ، | ك ، عن أم سلمة رضي الله عنها ، ز ) . |(@)(@@)(@@)(@@) $ 28775 - قال النبي صلى الله عليه وسلم : ' يكون عليكم أمراء من بعدي يؤخرون الصلاة ، فهي | لكم وهي عليهم ، فصلوا معهم ما صلوا بكم القبلة ' . ( د ، عن قبيصة بن | وقاص رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28776 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان : الخسف ، والقذف ، | والمسخ ' . ( ه ، عن سهل بن سعد رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28777 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان خليفة يقسم المال ولا يعده ' . | ( حم ، م ، عن أبي سعيد وجابر رضي الله عنهما ، ز ) . | PageV09P333 |(@)(@@)(@@)(@@) $ 28778 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان دجالون كذابون ، يأتونكم من | الأحاديث بما لم تسمعوا أنتم ولا آباؤكم فإياكم وإياهم ، لا يضلونكم ولا يفتنونكم ' . | ( حم ، م 
ms3099	 ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28779 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان عباد جهال ، وقراء فسقة ' . | ( حل ، ك ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28780 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان قوم يجبون أسنمة الإبل | ويقطعون أذناب الغنم ، فما قطع من حي فهو ميت ' . ( ه ، عن تميم | الداري رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28781 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان قوم يخضبون بالسواد | كحواصل الحمام لا يريحون رائحة الجنة ' . ( د ، ن ، عن ابن عباس رضي الله | عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28782 - قال النبي صلى الله عليه وسلم : ' يكون في آخر أمتي خليفة يحثي المال حثيا ولا يعده | عدا ' . ( حم ، م ، عن جابر رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28783 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي : خسف ، ومسخ ، وقذف ' . | ( حم ، ه ، عن ابن عمر رضي الله عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28784 - قال النبي صلى الله عليه وسلم : ' يكون في هذه الأمة أربع فتن في آخرها الفناء ' . | ( د ، عن ابن مسعود رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28785 - قال النبي صلى الله عليه وسلم : ' يكون في آخر هذه الأمة خسف ومسخ وقذف ، | قيل : يا رسول الله أنهلك وفينا الصالحون ؟ قال : نعم ، إذا ظهر الخبث ' . ( ت ، | عن عائشة رضي الله عنها ، ز ) . | PageV09P334 |(@)(@@)(@@)(@@) $ 28786 - قال النبي صلى الله عليه وسلم : ' يكون من بعدي اثنا عشر أميرا كلهم من قريش ' . | ( ت ، عن جابر بن سمرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28787 - قال النبي صلى الله عليه وسلم : ' يكتب للرجل في ركعتي الضحى ألف ألف | حسنة ' . ( ك ، في تاريخه عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28788 - قال النبي صلى الله عليه وسلم : ' يكتب للصغير الحسنات ولا يكتب عليه السيئات ، | وتكون حسناته لأبويه ، فإذا بلغ كتب عليه السيئات والحسنات ' . ( أبو الشيخ عن | أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28789 - قال النبي صلى الله عليه وسلم : ' يكتب أنين المريض ، فإن كان صابرا كان أنينه | حسنات ، وإن كان أنينه جزعا كتب 
ms3100	 هلوعا لا أجر له ' . ( أبو نعيم عن علي رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28790 - قال النبي صلى الله عليه وسلم : ' يكتب في كل إشارة يشير الرجل في صلاته عشر | حسنات بكل أصبع حسنة ' . ( ك ، في تاريخه عن عقبة بن عامر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28791 - قال النبي صلى الله عليه وسلم : ' يكفي أحدكم مد من الوضوء ' . ( حم ، عن | أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28792 - قال النبي صلى الله عليه وسلم : ' يكفي أحدكم من الدنيا خادم ومركب ' . ( عفان بن | مسلم الصفار في جزئه عن بريدة رضي الله عنه ) . | PageV09P335 |(@)(@@)(@@)(@@) $ 28793 - قال النبي صلى الله عليه وسلم : ' يكفي المؤمن الوقعة في الشهر ' . ( أبو نعيم عن | معاوية بن يحيى بن المغيرة بن الحارث بن هشام عن أبيه عن جده ) . |(@)(@@)(@@)(@@) $ 28794 - قال النبي صلى الله عليه وسلم : ' يكفيك من الدنيا : ما سد جوعتك ، ووارى | عورتك ، فإن كان لك شيء يظلك فذلك وإن كانت لك دابة تركبها فبخ ' . ( ابن | النجار عن ثوبان رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28795 - قال النبي صلى الله عليه وسلم : ' يكفي ثلاث نترات - يعني في البول - ' . | ( عبد الرزاق عن ابن جرير رضي الله عنه معضلا ) . |(@)(@@)(@@)(@@) $ 28796 - قال النبي صلى الله عليه وسلم : ' يكفي من غسل الجنابة ستة أمداد ' . ( البزار عن | أبي هريرة رضي الله عنه وضعف ) . |(@)(@@)(@@)(@@) $ 28797 - قال النبي صلى الله عليه وسلم : ' يكون قوم في آخر الزمان يخضبون بالسواد | كحواصل الحمام لا يريحون رائحة الجنة ' . ( د ، ن ، وابن سعد ، هق ، عن ابن | عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28798 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي أربع فتن وفي الرابعة الفناء ' . | ( نعيم بن حماد في الفتن عن حذيفة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28799 - قال النبي صلى الله عليه وسلم : ' يكون بين يدي الساعة فتن كقطع الليل المظلم ' . | ( ه ، ك ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28800 - قال النبي صلى الله عليه وسلم : ' يكون لأمتي مدينة يقال لها قزوين ، الساكن بها | أفضل من ساكن الحرمين ' . ( أبو بكر الصغاني في أماليه والرافعي عن أبي | هريرة رضي الله عنه ، قال الرافعي : كأنه 