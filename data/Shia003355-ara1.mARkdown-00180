ms161	 جواب المعنت.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخراج. لطيف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعليم بعض المؤامرات (رايته بخطه).(@)(@@)(@@)(@@) $BIO_MAN$ ابن بشار(@)(@@) أحمد بن محمد بن سليمان بن بشار الكاتب، أستاذ أبى عبد الله الكوفي الوزير. وكان أحد أفاضل الكتاب بلاغة وصناعة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخراج كبير، ورأيت المسود بخطه نحو الف ورقة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشراب والمنادمة (رأيته) بخطه.(@)(@@)(@@)(@@) $BIO_MAN$ عبد الله بن حماد(@)(@@) بن مروان الكاتب. لا أعرف من امره غير هذا. وله من الكتب، كتاب معاني الشيب وآدابه وفضل ألوانه وترتيب مقدماته وما قيل فيه نظما ونثرا والخضابات.(@)(@@)(@@)(@@) $BIO_MAN$ كاتب آخر(@)(@@) يعرف بيعقوب بن محمد بن علي. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخضابات وذم المشيب ومدح الشباب.(@)PageV00P150(@)(@@)(@@)(@@) $BIO_MAN$ محمد بن أحمد(@)(@@) بن علي بن جبار؟؟ الكاتب. وله من الكتب، كتاب الخراج.(@)(@@)(@@)(@@) $BIO_MAN$ ابن سريج(@)(@@) في زماننا. ويحيا إلى وقتنا هذا. واسمه إسحاق بن يحيى بن سريج النصراني ويكنى أبا الحسين. حسن المعرفة بأمور الدواوين ومناظرة العمال وصناعة الخراج. وله قدم ومعرفة بالنجوم ومولده سنة ثلثمائة في شعبان. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخراج الكبير (وجزئه جزئين وجعله ستة منازل).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (صناعة) الخراج الصغير (وجعله منازل).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمل المؤامرات بالحضرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تحويل سنى المواليد، نحو ماية ورقه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمل التاريخ، جمعها...(@)(@@)(@@)(@@) ||| طبقة أخرى(@)(@@)(@@)(@@) $BIO_MAN$ باح(@)(@@) أبو عبد الله محمد بن عبد الله بن غالب الأصبهاني. وباح لقب. وكان فصيحا مترسلا كاتبا. وانما لقب بباح لقوله من أبيات.(@)(@@)(@@)(@@) $BIO_MAN$ باح بما في الفؤاد باحا(@)(@@) وورد بغداد فنزل على العتابي الكاتب ولولده الف كتابه في الرسائل. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جامع الرسائل، وجزئه ثمانية اجزاء، وأضاف إليه بعد ذلك تاسعا وسماه الكتاب الموصول نثره بالنظم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التوشيح والترشيح، في بعض الثنوية بين الشعوبية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخطب والبلاغة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفقر .(@)(@@)(@@)(@@) $BIO_MAN$ أبو مسلم(@)(@@) محمد بن (مسلم بن) بحر الأصبهاني. وكان كاتبا، مترسلا، بليغا ومتكلما جدلا. وكان أبو الحسن على ابن عيسى يصفه ويشتاقه. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جامع 
ms162	 التأويل لمحكم التنزيل على مذهب المعتزلة في تفسير القرآن.(@)(@@) (كبير).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جامع رسائله.(@)(@@)(@@)(@@) $BIO_MAN$ ابن طباطبا العلوي(@)(@@) ويمر ذكره في الشعر والشعراء. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سنام المعالي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عيار الشعر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء اختياره.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب ديوان شعره).(@)(@@)(@@)(@@) $BIO_MAN$ الديمرتي(@)(@@) واسمه... وديمرت من ارض أصبهان. وكان بليغا مصنفا نحويا. وله من الكتب، كتاب تهذيب الطبع.(@)PageV00P151(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي العواذل(@)(@@) (وهو...) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البراعة واللسن.(@)(@@)(@@)(@@) $BIO_MAN$ أبو حصين(@)(@@) محمد بن علي الأصبهاني الديمرتي. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مثالب ثقيف وسائر العرب.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الحماسة)(@)(@@)(@@)(@@) $BIO_MAN$ عبد الرحمن(@)(@@) بن عيسى الهمذاني كاتب بكر بن عبد العزيز بن أبي دلف. وكان شاعرا كاتبا وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألفاظ.(@)(@@)(@@)(@@) $BIO_MAN$ ابن عبد كان(@)(@@) (وكان) اسمه محمد... كاتب الطولونية وكان بليغا مترسلا فصيحا. وله ديوان رسائله كبير.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي النعل(@)(@@) واسمه (أحمد بن) محمد بن يحيى بن أبي النعل؟ (و) يكنى أبا الحسين. استدعى من أصبهان وكان يليها للوزارة في أيام المقتدر. وكان بليغا مترسلا فصيحا، من أهل المروات. وكان شاعرا أيضا مجودا مطبوعا. وله ديوان رسائل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب رسائله في فتح البصر ة).(@)(@@)(@@)(@@) $BIO_MAN$ محمد بن القاسم (@)(@@) الكرخي. أحد الكتاب وممن أهل للوزارة. وكان مترسلا بليغا. وله (من الكتب)، ديوان رسائل.(@)(@@) (ديوان شعره).(@)(@@)(@@)(@@) $BIO_MAN$ الباحث عن معتاص العلم.(@)(@@) واسمه محمد بن سهل بن المرزبان الكرخي. ويكنى أبا منصور من أهل الكرخ، أحد البلغاء الفصحاء.(@)(@@) وقال لي: من رآه انه أشل اليد وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنتهى في الكمال ويحتوي على اثنى عشر كتابا وهي، كتاب مدح الأدب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفة البلاغة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدعاء والتحاميد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشوق والفراق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحنين إلى الأوطان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التهاني والتعازي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الامل والمأمول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التشبيبات والطلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحمد والذم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاعتذارات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألفاظ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نفائس الحكم.(@)(@@)(@@)(@@) $BIO_MAN$ أبو سعد عبد الرحمن(@)(@@) بن أحمد الأصبهاني. (وله كتاب رسائل).(@)(@@)(@@)(@@) $BIO_MAN$ 
ms163	 الأبهري الأصبهاني(@)(@@) لا نعرف من امره أكثر من هذا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تهذيب الفصاحة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب الكاتب.(@)(@@) (كتاب النديم).(@)PageV00P152(@)(@@)(@@)(@@) $BIO_MAN$ الجيهاني(@)(@@) أبو عبد الله أحمد بن محمد بن نصر (الجيهاني الكاتب) وزير صاحب خراسان. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسالك والممالك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب انيين مثالات كتب العهود للخلفاء والامراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الزيادات في كتاب الناسي في المقالات.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب رسائل).(@)(@@)(@@)(@@) $BIO_MAN$ أبو زيد البلخي(@)(@@) واسمه أحمد بن سهل وكان فاضلا في سائر العلوم القديمة والحديثة. يسلك في تصنيفاته وتأليفاته طريقة الفلاسفة إلا أنه باهل الأدب أشبه ومنهم أقرب فلذلك رتبته في هذا الموضع من الكتاب. حكى عن أبي زيد انه قال: كان الحسين بن علي المروروذي وهو أخو صعلوك يجرى على صلات معلومة دائمة، فلما أمليت كتابي في البحث عن كيفية التأويلات قطعها عنى. وكان لأبي على الجيهاني وزير نصر بن أحمد جوائز يدرها على، فلما أمليت كتابي القرابين والذبائح حرمينها. قال: وكان الحسين قرمطيا وكان الجيهاني ثنويا. وكان يرمى أبو زيد بالالحاد. فحكى عن البلخي انه قال: هذا الرجل مظلوم، يعنى أبا زيد وهو موحد، انا أعرف به من غيري فانا نشأنا معا وانما اتى من المنطق وقد قرأنا المنطق وما ألحدنا بحمد الله. ولأبي زيد من الكتب، كتاب شرائع الأديان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أقسام العلوم .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اختيارات السير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كمال الدين (هو الإبانة عن كمال الدين) كتاب السياسة الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سياسة الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضل صناعة الكتابة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مصالح الأبدان والأنفس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسماء الله عز وجل وصفاته.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صناعة الشعر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضيلة علم الاخبار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأسماء والكنى والألقاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسامي الأشياء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النحو والتصريف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الصورة والمصور (كتاب) رسالته في حدود الفلسفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما يصح من احكام النجوم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على عبدة الأصنام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضيلة علوم الرياضيات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب في اقتناء علوم الفلسفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القرابين والذبائح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عصمة الأنبياء عليهم 
ms164	 السلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نظم القرآن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قوارع القرآن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العتاك والنساك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمع فيه ما علق عنه في غريب القرآن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب في أن سورة الحمد تنوب عن جميع القرآن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أجوبة أبى القاسم الكعبي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر في فنون شتى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أجوبة أهل فارس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفسير صور كتاب السماء والعالم لأبي جعفر الخازن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أجوبة أبى علي بن أبي بكر بن المظفر المعروف بابن محتاج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أجوبة أبى اسحق المؤدب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المصادر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أجوبة مسائل أبى القسل السكري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشطرنج (والنرد).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضيلة مكة على سائر البقاع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جواب رسالة أبى علي بن المنير الزيادي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب منية (14) الكتاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البحث عن التأويلات (كبير).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرسالة السالفة إلى العاتب عليه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في مدح الوراقة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وصيته.(@)PageV00P153(@)(@@)(@@)(@@) $BIO_MAN$ البشي (@)(@@) وهو أبو القاسم... ولم أر من كتبه شيئا، بل خبرني أبو علي بن سوار الكاتب (رحمه الله) وهو الذي عمل خزانة الوقف بالبصرة، وكان محبا للعلوم، شديد الشغف بها، قال، في خزانتي بالبصرة من كتبه. قال محمد بن إسحاق: انا شاك في البشي هل هو بالشين أو السين. بست معروفة من ارض سجستان وبش لا نعرفها والذي أتقنته من لفظ أبى على، بالشين منقوطة فنسئل عن هذا الرجل وعن كتبه ويلحق ببابه انشاء الله قال أبو على: له من الكتب، كتاب الأشجار والنبات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وصف هواء جرجان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جوابه في قدم العالم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب في علة الورد الموجه بوجهين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صون العلم وسياسة النفس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في تبيين عضو الرئيس من بدن الانسان.(@)(@@)(@@)(@@) $BIO_MAN$ حمزة بن الحسن(@)(@@) من أهل أصبهان. وكان أديبا مصنفا. وله من الكتب (الشعوبية)، كتاب أصبهان واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التشبيهات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أنواع الدعاء (كتاب التصحيف).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الأمثال على افعل ويدخل فيه الشعرية والنثرية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال الصادرة عن ثبوت الشعر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التنبيه على 
ms165	 حروف المصحف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التماثيل في تباشير السرور.(@)(@@)(@@)(@@) $BIO_MAN$ حكمويه بن عبدوس(@)(@@) من نواحي الجبل. لا نعرف في امره أكثر من هذا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشوارد في الرسائل.(@)(@@) (كتاب الآداب).(@)(@@)(@@)(@@) $BIO_MAN$ سمكه(@)(@@) معلم ابن العميد. واسمه (محمد بن علي بن سعيد). وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار العباسيين.(@)(@@)(@@)(@@) $BIO_MAN$ (كشاجم)(@)(@@) (وهو أبو الفتح محمود بن الحسين. وأدبه وشعره مشهور. وله من الكتب، كتاب أدب النديم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرسائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ديوان شعره).(@)(@@)(@@)(@@) $BIO_MAN$ خشكنانجة (@)(@@) الكاتب من أهل بغداد. وكان أكثر مقامه بالرقة، ثم انتقل إلى الموصل، واسمه علي بن وصيف (أبو الحسن).(@)(@@) وكان (اسمه عليا) من البلغاء في معناه. وألف عدة كتب ونحلها عبدان صاحب الإسماعيلية. وكان لي صديقا و أنيسا وتوفى بالموصل. (وكان يتشيع). وله من الكتب: (كتاب الايضاح والتثقيف في آئين الخراج ورسومه) (كتاب النثر الموصول بالنظم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صناعة البلاغة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفوائد. ديوان شعره).(@)PageV00P154(@)(@@)(@@)(@@) $BIO_MAN$ (ابنه أبو الحسن)(@)(@@) (أحمد بن علي. وكان كاتبا شاعرا بليغا. وتوفى بمدينة السلام. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النثر الموصول بالنظم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صناعة البلاغة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفوائد).(@)(@@)(@@)(@@) $BIO_MAN$ ابن كثير الأهوازي(@)(@@) وهو أبو بكر أحمد بن محمد بن الفضل. وله من الكتب، كتاب ساور (كذا) الكتاب.(@)(@@)(@@)(@@) $BIO_MAN$ أبو نملة النميلي (@)(@@) ويقال النملي لا نعرف من امره أكثر من هذا. وله من الكتب، كتاب الشذور في مؤامرات الخلفاء والامراء.(@)PageV00P155(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) || الفن الثالث - من المقالة الثالثة من كتاب الفهرست في اخبار العلماء وأسماء ما صنفوه من الكتب ويحتوي على اخبار الندماء والجلساء والأدباء والمغنيين والصفادمة والصفاعنة والمضحكين وأسماء كتبهم(@)(@@)(@@)(@@) $BIO_MAN$ اخبار إسحاق بن إبراهيم الموصلي وأبيه وأهله(@)(@@) ولد إبراهيم (في) سنة خمس وعشرين ومائة وهو إبراهيم بن ميمون، وكان اسم ميمون ماهان فقلبوه إلى ميمون، وقال أبو الفضل حماد بن إسحاق: نسب لي أبى جدي إبراهيم . فقال: هو إبراهيم بن ماهان بن بهمن بن نسك. وقال يزيد المهلبي، قال لي اسحق: نحن فرس من 
ms166	 أهل أركان (و) موالينا (من) الحنظليين: وكانت لهم ضياع عندنا. وانما سمى الموصلي.... وقال الصولي: لإسحاق بن إبراهيم من الولد، حميد وحماد واحمد و حامد وإبراهيم وفضل، ولم يكن في جماعة ولد إبراهيم الموصلي من يغنى الا اسحق وطياب. وولد إبراهيم سنة خمس وعشرين ومائة ومات ببغداد سنة ثمان وثمانين ومائة، وسنه أربع وستون سنة. وولد اسحق سنة خمسين ومائة ومات سنة خمس وثلاثين ومائتين، فكانت سنه خمسا وثمانين سنة. وهو إسحاق بن إبراهيم بن (ماهان بن) بهمن بن نسك، أصله من فارس، خرج هاربا منها من جور بنى أمية في خراج كان عليه، فأتى الكوفة فنزل في بنى دارم. وكان اسحق يقول: لا اشتهى أموت حتى يخرج عنى شهر رمضان لعلى ارزق أصومه فيكون في ميزاني قال: فصام في أوله أياما، وكان إذا تم له صوم يوم، تصدق بمائة دينار، ثم اشتدت علته في اخره، فلم يطق الصوم وكان مرضه من اسهال عرض له، ورثاه إدريس بن أبي حفصة فقال:(@)(@@) سقى الله يا بن الموصلي بوابل من الغيث قبرا أنت فيه مقيم ذهبت فأوحشت الكرام ورعتهم فلا غرو أن يبكى عليك حميم(@)PageV00P157 وكان اسحق راوية للشعر والمآثر، قد لقى فصحاء الاعراب من الرجال والنساء. وكانوا إذا قدموا حضرة السلطان قصدوه ونزلوا عليه: وكان مع ذلك شاعرا، حاذقا بصناعة الغناء، مفتنا في علوم كثيرة، يرتزق من السلطان في عدة أعطية لكماله وفضله. وله من الكتب المصنفة التي تولى بنفسه تصنيفها سوى كتاب الأغاني الكبير فقد اختلف في امره ونحن نذكر حاله، كتاب أغانيه التي غنى بها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عزة الميلاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أغاني معبد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار حماد عجرد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار حنين الحيري .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ذي الرمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار المغنيين المكيين كتاب اخبار طويس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار سعيد بن مسجح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الدلال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار محمد بن عايشة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الأبخر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن صاحب الوضوء .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاختيار من الأغاني للوائق. 
ms167	(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اللحظ والإشارات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشراب. يروى فيه عن العباس بن معن وابن الجصاص، وحماد بن مسيرة (كتاب مواريث الحكماء).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جواهر الكلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرقص والزفن.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الندماء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنادمات).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النغم والايقاع (وعدد مهاله).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (اخبار) الهذليين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قيان الحجاز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرسالة إلى علي بن هشام.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب منادمة الاخوان وتسامر الخلان).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القيان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر المتحيرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخبار والنوادر . (كتاب اخبار معبد وابن سريج وأغانيهما.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الغريض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفضيل الشعر والرد على من يحرمه وينقضه.(@)(@@)(@@)(@@) $DIC_BIB$ (خبر) كتاب الأغاني الكبير(@)(@@) قرأت بخط أبى الحسن علي بن محمد بن عبيد بن الزبير الكوفي الأسدي، حدثني فضل بن محمد اليزيدي، قال: كنت عند إسحاق بن إبراهيم الموصلي، فجائه رجل فقال يا أبا محمد اعطني كتاب الأغاني، فقال: أيما كتاب الكتاب الذي صنفته أو الكتاب الذي صنف لي، يعنى بالذي صنفه، كتاب اخبار المغنيين واحدا واحدا، و الكتاب الذي صنف له، كتاب اخبار الأغاني الكبير الذي في أيدي الناس.(@)(@@)~:section: حكاية أخرى في ذلك(@)(@@) حدثني أبو الفرج الأصبهاني، قال أخبرني أبو بكر محمد بن خلف وكيع، قال: سمعت حماد بن إسحاق يقول، ما الف أبى هذا الكتاب قط، يعنى كتاب الأغاني الكبير، ولا رآه. والدليل على ذلك، ان أكثر اشعاره المنسوبة، انما جمعت لما ذكر معها من الاخبار وما غنى فيها إلى وقتنا هذا: وان أكثر نسبة المغنيين خطأ، والذي الفه أبى من دواوين غنائهم يدل على بطلان هذا الكتاب، وانما وضعه وراق كان لأبي بعد وفاته، سوى الرخصة التي هي أول الكتاب فان أبى ألفها، الا ان اخباره كلها من روايتنا. وقال لي أبو الفرج: هذا سمعته من أبى بكر وكيع حكاية فحفظته واللفظ يزيد وينقص. وأخبرني جحظة انه يعرف الوراق الذي وضعه وكان يسمى سندي بن علي . وحانوته في طاق الزبل وكان يورق لإسحاق، واتفق هو وشريك له على وضعه، وهذا الكتاب يعرف في 
ms168	 القديم بكتاب السراة وهو أحد عشر جزءا ولكل جزء أول يعرف به، فالجزء الأول من الكتاب، الرخصة وهو تأليف اسحق لا شك فيه ولا خلف.(@)PageV00P158(@)(@@)~:section: ترتيب اجزاء الكتاب ويروى إلى اليوم(@)(@@) الأول منه - علقت الهوى منها وليدا فلم يزل إلى الحول ينمى حبها ويزيد الثاني منه - ولا أحمل الحقد القديم عليهم وليس رئيس القوم من يحمل الحقدا الثالث منه ألمم بزينب إن الركب قد أفدا قل العزاء لئن كان الرحيل غدا الرابع منه قفا نبك من ذكرى حبيب ومنزل بسقط اللوى بين الدخول فحومل الخامس منه - أعاذل ان المال غاد ورائح ويبقى من المال الأحاديث والذكر السادس منه عوجي علينا ربة الهودج إنك ان لم تفعلي تحرجي السابع منه يا بيت عاتكة التي أتغزل حذر العدى وبه الفؤاد موكل الثامن منه هاج الهوى لفؤادك المهتاج فانظر بتوضح باكر الأحداج التاسع منه فإنك كالليل الذي هو مدركي وان خلت أن المنتأى عنك واسع العاشر منه إذا أذنبت.. زارها أهلها وقد الف اسحق اخبار جماعة من الشعراء فمن ذلك، كتاب اخبار حسان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ذي الرمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الأحوص.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار جميل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار كثير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار النصيب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عقيل بن علفه.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اخبار ابن هرمة).(@)(@@)(@@)(@@) $BIO_MAN$ حماد بن إسحاق(@)(@@) قال الصولي: كان حماد أديبا راوية، شارك أباه اسحق في كثير من سماعه ولحق بكبار مشايخه. سمع(@)PageV00P159 من أبى عبيدة والأصمعي. وألف كتبا في الأدب كثيرة، وأخذ أكثر علم أبيه. وقال غيره: كان حماد يلقب بالبارد، وقال يحيى بن علي: قلت لأبي لم سمى حماد، البارد. فقال: يا بنى ظلموه، كان يجلس مع أبيه اسحق وكان اسحق كالنار المتوقدة ظرفا وحدة مزاج. وتوفى حماد.. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأشرية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الحطيئة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ذي الرمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عروة بن أذينة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختار غنا إبراهيم جده.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار رؤية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (اخبار) عبيد الله بن قيس الرقيات. 
ms169	(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اخبار الندامى).(@)(@@)(@@)(@@) ||| اخبار آل المنجم على النسق(@)(@@)(@@)(@@) $BIO_MAN$ اسم أبى منصور، أبان حسيس بن وريد بن كاد بن مهابنداد حسس بن فروخ داد بن اشتاذ (زيار بن) مهر جشنش بن يزدجرد. وكان يحيى ابنه مولى المأمون وكنيته أبو على، وكان أولا متصلا بالفضل بن سهل، يعمل برأيه في احكام النجوم. فلما حدثت على الفضل الحادثة، اجتباه المأمون ورغبه في الاسلام فأسلم على يده واختصه.(@)(@@) وتوفى يحيى في خروجه إلى طرسوس ودفن بحلب في مقابر قريش، فقبره هناك مكتوب عليه، وله من الولد، محمد وعلى وسعيد والحسن. فاما محمد، فكان حسن الأدب، حسن البلاغة، فصيح اللسان. وله كتب مدونة واخبار مشهورة. فمن كتبه، كتاب اخبار الشعراء. وله معرفة بالغناء والنجوم. واتصل علي بن يحيى، بمحمد بن إسحاق بن إبراهيم المصعبي، ثم اتصل بالفتح بن خاقان وعمل له خزانة حكمة، نقل إليها من كتبه. ومما استكتبه للفتح أكثر مما اشتملت عليه خزانة حكمة قط. وتوفى اخر أيام المعتمد ودفن بسر من رأى. وله من الولد، احمد أبو عيسى، عبد الله أبو القاسم، يحيى أبو أحمد، هارون أبو عبد الله. ولهارون كتب كثيرة.(@)(@@)(@@)(@@) |||| حكاية أخرى في أمرهم(@)(@@) أبو الحسن علي بن يحيى بن أبي منصور المنجم، نادم المتوكل، من خاصة ندمائه ومتقدميهم عنده، وخص به وبمن بعده من الخلفاء إلى أيام المعتمد. وكان راوية للاشعار والاخبار، شاعرا محسنا، قد اخذ عن إسحاق وشاهده. وله صنعه مقدما عند الخلفاء، يجلس بين يدي أسرتهم ويفضون إليه بأسرارهم ويأمنونه على اخبارهم. توفى سنة خمس وسبعين (ومائتين) وله من الكتب، كتاب (الشعر و) الشعراء القدماء الاسلاميين روى فيه عن محمد بن سلام، ومحمد بن عمر الجرجاني وغيرهما.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار إسحاق بن إبراهيم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيخ.(@)(@@)(@@)(@@) $BIO_MAN$ ابنه أبو أحمد(@)(@@) يحيى بن علي بن يحيى بن أبي منصور. ولد سنة إحدى وأربعين ومائتين ومات ليلة الاثنين لثلاث عشرة ليلة خلت من شهر ربيع الأول سنة ثلثمائة، ونادم الموفق ومن بعده من الخلفاء وكان متكلما معتزلي 
ms170	 المذهب، وله في ذلك كتب كثيرة. وكان له مجلس يحضره جماعة من المتكلمين بالحضرة، فمن كتبه، كتاب الباهر، في اخبار (واشعار) شعراء مخضرمي الدولتين. ابتدأ فيه ببشار. وابن هرمة. وطريح. وابن ميادة. ومسلم. وإسحاق بن إبراهيم.(@)(@@) وأبى هفان. ويزيد بن الطثرية. وآخر ما عمل، مروان بن أبي حفصة ولم يتمه. وتممه ابنه أبو الحسن أحمد بن يحيى(@)PageV00P160 وعزم على أن يضيف إلى كتاب أبيه سائر الشعراء المحدثين، فعمل منهم أبا دلامة. ووالبة بن الحباب. ويحيى بن زياد. ومطيع بن اياس. وأبا على البصير. وكان أبو الحسن متكلما فقيها على مذهب أبي جعفر (الطبري ورأيت بخطه قطعة من كتب أبى جعفر) في الفقه. ولأبي الحسن كتب ألفها سوى ما تقدم. منها، كتاب اخبار أهله ونسبهم في الفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاجماع في الفقه على مذهب الطبري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدخل إلى مذهب الطبري ونصرة مذهبه.(@)(@@) (كتاب الأوقات).(@)(@@)(@@)(@@) $BIO_MAN$ أبو عبد الله هارون بن علي(@)(@@) ابن يحيى بن أبي منصور. وتوفى سنة ثمان وثمانين ومائتين، حدث السن. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البارع. وهو اختيار شعر (شعراء) المحدثين ولم يستقص ذكرهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الشعراء الكبير ولم يتمه.(@)(@@) والذي خرج منه، بشار. وأبو العتاهية. وأبو نواس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النساء وما جاء فيهن من الخبر ومحاسن ما قيل فيهن من الشعر والكلام الحسن.(@)(@@)(@@)(@@) $BIO_MAN$ أبو الحسن علي(@)(@@) بن هارون بن علي بن يحيى. رأيناه وسمعنا منه وكان راوية (للشعر)، شاعرا أديبا ظريفا متكلما خيرا نادم جماعة من الخلفاء. وقال لي: مولدي سنة سبع وسبعين، وكان يخضب إلى أن توفى في سنة اثنتين وخمسين وثلثمائة. وله ست وسبعون سنة، وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شهر رمضان، عمله للراضي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوروز و المهرجان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على الخليل في العروض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في الفرق بين إبراهيم بن المهدى وإسحاق الموصلي في الغناء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابتداء فيه بنسب أهله، عمله للمهلبي ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اللفظ المحيط بنقض ما لفظ به اللقيط وهو معارضة عن كتاب 
ms171	 أبى الفرج الأصبهاني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرق والمعيار بين الأوغاد والأحرار).(@)(@@)(@@)(@@) $BIO_MAN$ أبو عيسى أحمد(@)(@@) بن علي بن يحيى من أفاضلهم قبل علي بن هارون. وله من الكتب، كتاب تاريخ سنى العالم .(@)(@@)(@@)(@@) $BIO_MAN$ أبو عبد الله هارون(@)(@@) ابن علي بن هارون، في نجار أهله وآبائه. وكان شاعرا أديبا عارفا بالمعنى وله صنعة وتقدم في الكلام.(@)(@@) وولد سنة... وتوفى.. (وله كتاب مختار في الأغاني).(@)(@@)(@@)(@@) ||| آل حمدون(@)(@@) وهو حمدون بن إسماعيل بن داود الكاتب، وهو أول من نادم من أهله. وابنه أحمد بن حمدون راوية اخباري روى عن العدوي. (وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الندماء والجلساء).(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $BIO_MAN$ أبو هفان المهزمي(@)(@@) وسيمر ذكره في جملة شعراء المحدثين. وكان اخباريا، راوية، مصنفا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأربعة في اخبار الشعراء، كتاب صناعة الشعر، كبير رأيت بعضه.(@)PageV00P161(@)(@@)(@@)(@@) $BIO_MAN$ يونس الكاتب(@)(@@) المعروف بيونس المغني، وهو يونس بن سليمان ويكنى أبا سليمان، من أهل فارس، أدرك الدولة العباسية. من خط السكري، من الموالى، مولى الزبير بن العوام. وله كتب مشهورة في الأغاني والمغنيين. ويقال ان إبراهيم عنه اخذ. فمن كتبه، كتاب مجرد يونس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القيان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النغم.(@)(@@)(@@)(@@) $BIO_MAN$ ابن بأنه(@)(@@) واسمه عمرو بن بأنه وهي أمه . وهو عمرو بن محمد بن سليمان بن راشد، مولى يوسف بن عمر الثقفي.(@)(@@) وبأنه ابنة روح كاتب سلمة الوصيف. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مجرد عمرو بن بانة . وكان خصيصا بالمتوكل آنسا به، اخذ عن إسحاق وغيره وله صنعة في الغناء. وعاش إلى أيام المعتضد. وكان منزله ببغداد وفى الأوقات يمضى إلى سر مري. وتوفى سنة ثمان وسبعين ومائتين.(@)(@@)(@@)(@@) $BIO_MAN$ الصيني (@)(@@) واسمه حبيش بن موسى. صاحب كتاب الأغاني على حروف المعجم. الفه للمتوكل. وذكر في هذا الكتاب أشياء من الأغاني لم يذكرها اسحق ولا عمرو بن بانة: وذكر من اسما المغنيين والمغنيات في الجاهلية والاسلام كل طريف غريب. وله كتاب الأغاني على الحروف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مجردات المغنيين.(@)(@@)(@@)(@@) $BIO_MAN$ أبو حشيشة(@)(@@) واسمه محمد بن علي بن أمية ويكنى أبا جعفر، 
ms172	 من ولد أبى أمية الكاتب. وكان طنبوريا حاذقا في صنعته وزعم جحظة انه اخذ عنه. وتوفى... وله من الكتب، كتاب المغني الجيد، رأيته بخط عتيق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الطنبوريين.(@)(@@)(@@)(@@) $BIO_MAN$ جحظة(@)(@@) أبو الحسن أحمد بن جعفر بن موسى (بن يحيى) بن خالد بن برمك. شاعر مغني، مطبوع في الشعر، حاذق بصناعة غناء الطنبور، حسن الأدب، بارع في معناه. قد لقى العلماء والرواة واخذ عنهم. واخباره أشهر وأظهر من أن نذكرها في كتابنا لقرب عهده منا. وكان مع ما وصفناه به، غير أديب النفس وكان وسخا وفى دينه بعض العهدة بل العهدة كلها. أنشدني أبو الفتح بن النحوي، قال: أنشدني جحظة لنفسه.(@)(@@) إذا ما ظمئت إلى ريقه جعلت المدامة منه بديلا وأين المدامة من ريقه ولكن أعلل قلبا عليلا وتوفى جحظة بواسط، وقد خرج إلى أبى بكر بن واثق ، سنة ست وعشرين وثلثمائة، بعلة الذرب.(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيخ، لطيف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطنبوريين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل السكباج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الترنم .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب(@)PageV00P162 ما شاهده من أمر المعتمد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المشاهدات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما جمعه مما خزنه المنجمون فصح من الاحكام.(@)(@@) (بعد اخباره اخبار (قريص) المغني وهو يجيئ بعد هذه الورقة بسبع عشرة ورقة. كذا رتبه مولف الكتاب)(@)(@@)(@@)(@@) ||| رجعنا إلى المصنفين المشهرين(@)(@@) قال محمد بن إسحاق: إذا ذكرت من المصنفين انسانا أتبعته بذكر من يقاربه ويشبهه وان تأخرت مدته عن مدة من أدركه بعده وهذه سبيلي في جميع الكتاب. والله يعين بمنه (وفضله).(@)(@@)(@@)(@@) $BIO_MAN$ اخبار بن أبي طاهر(@)(@@) وهو أبو الفضل أحمد بن أبي طاهر، واسم أبى طاهر طيفور، من أبناء خراسان، من أولاد الدولة مولده ببغداد، قال جعفر بن حمدان صاحب كتاب الباهر: انه كان مؤدب كتاب عام . ثم تخصص وجلس في سوق الوراقين في الجانب الشرقي، (قال) ولم أر ممن شهر بمثل ما شهر به من تصنيف الكتب وقول الشعر، أكثر تصحيفا منه. ولا أبلد علما ولا ألحن. ولقد أنشدني شعرا يعرضه على في إسحاق بن أيوب، لحن 
ms173	 في بضع عشرة موضعا منه. وكان (من) أسرق الناس لنصف بيت وثلث بيت. قال: وكذا قال لي البحتري فيه، وكان مع هذا حميد الأخلاق، ظريف المعاشرة وحلوا من الكهول . ومولده سنة أربع ومائتين، وقت دخول المأمون بغداد من خراسان. وتوفى سنة ثمانين ومائتين. وله من الكتب المصنفة، كتاب المنثور والمنظوم (وجزاه) أربعة عشر جزءا والذي بيد الناس ثلاثة عشر جزءا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سرقات الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب بغداد).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجواهر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المؤلفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الهدايا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المشتق المختلف من المؤتلف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسماء الشعراء الأوائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب الشعراء ومن عرف بالكنى ومن عرف باسمه .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعرفين من الأنبياء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموشا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اعتذار وهب من حبقته. (كتاب المغرمين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المؤنس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحلى والحلل).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من أنشد شعرا فأجيب بكلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تربية هرمز بن كسرى أنوشروان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خير الملك العاني في تدبير المملكة والسياسة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك المصلح والوزير المعين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك البابلي والملك المصري الباغيين والملك الحليم (14) الرومي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العلة والعليل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب المزاج والمعاتبات).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعتذرين.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مفاخرة الورد والنرجس).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحجاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقاتل الفرسان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقاتل الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخيل كبير (15).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطرد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سرقات البحتري (16) من أبى تمام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمهره (نسب) بنى هاشم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته إلى إبراهيم بن المدبر (17).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في النهى عن الشهوات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته إلى علي بن يحيى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجامع في الشعراء واخبارهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضل(@)PageV00P163 العرب على العجم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب لسان العيون.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار المتظرفات. وقد قيل إن أبا الحسين ابنه عمل هذين الكتابين.(@)(@@)~:section: كتبه في اختيارات اشعار الشعراء(@)(@@) اختيار شعر بكر بن النطاح. اختيار شعر دعبل بن علي. اختيار شعر مسلم. اختيار شعر العتابي. اختيار شعر منصور النمري. اختيار شعر أبى العتاهية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار بشار والاختيار من شعره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار مروان والاختيار من شعره 
ms174	 واخبار آل مروان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن ميادة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن هرمة ومختار شعره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن الدمينة.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اختيار شعر عبد الله بن قيس الرقيات).(@)(@@)(@@)(@@) $BIO_MAN$ ابنه عبيد الله(@)(@@) ابن أحمد بن أبي طاهر. ويكنى أبا الحسين، سلك طريقة أبيه في التصنيف والتأليف، وروايته أقل من رواية أبيه. فاما الدراية والتأليف، فكان احمد أحذق وأمهر، فمما لأبي الحسين من الكتب، ما زاده على كتاب أبيه في اخبار بغداد، فان أباه عمل إلى آخر أيام المهتدي، وزاد أبو الحسين، اخبار المعتمد واخبار المعتضد واخبار المكتفى واخبار المقتدر ولم يتمه. وله من الكتب، كتاب السكباج وفضائلها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المتظرفات والمتظرفين.(@)(@@)(@@)(@@) |||| آل أبي النجم(@)(@@)(@@)(@@) $BIO_MAN$ اسم أبى النجم، هلال. من أهل الأنبار وكان كاتبا. وابنه صالح بن أبي النجم من أهل بغداد. وكان أبو النجم مولى لبني سليم. وأحمد بن أبي النجم وكان شاعرا ويكنى أبا الدميك . ويقال أنه أنشد أبا الشيص قوله:(@)(@@) كأنه على الفلك الدوار صوت المؤذن فقال أبو الشيص: قاتلكم الله يا معشر بنى سليم تقول الخنساء، كأنه علم في رأسه نار، وأنت تقول هذا. وأبو عون أحمد بن أبي النجم الكاتب، ابن أخيهما وكان متكلما، مترسلا شاعرا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التوحيد وأقاويل الفلاسفة (في ذلك).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النواحي في اخبار الأرض، وقد قيل إنه لأبي إسحاق إبراهيم بن أبي عون.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي عون(@)(@@) وهو أبو إسحاق إبراهيم بن أبي عون أحمد بن النجم . وكان من أصحاب أبي جعفر محمد بن علي الشلمغاني المعروف بابن أبى العزاقر واحد ثقاته، ومن كان يغلو في امره ويدعى انه إلهه. تعالى عن ذلك. ولما اخذ ابن أبي العزاقر، اخذ معه وضربت عنقه بعده، فإنه عرض عليه الشتم له والبصاق عليه، فأبى وارعد وأظهر خوفا من ذلك للحين والشقاء. وكان في أهل الأدب، مؤلفا للكتب، ناقص العقل. ونحن نشرح خبره عند ذكر(@)PageV00P164 العزاقري. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النواحي في اخبار البلدان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجوابات المسكتة.(@)(@@)(@@)(@@) $DIC_BIB$ 
ms175	 كتاب التشبيهات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيت مال السرور.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الدواوين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرسائل).(@)(@@)(@@)(@@) |||| (@)(@@)(@@)(@@) $BIO_MAN$ اخبار ابن أبي الأزهر(@)(@@) وهو أبو بكر محمد بن أحمد بن مزيد النحوي الاخباري البوسنجي، من بوسنج أصله. وتوفى عن سن عالية. قرأت بخط عبد الله بن علي بن محمد بن داود بن الجراح المعروف بابن العرمرم، انه سئل ابن أبي الأزهر عن عمره في سنة ثلاث عشرة وثلثمائة فقال: مضى من عمري ثمانون سنة وثلاثة أشهر. وعاش بعد ذلك. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الهرج والمرج في اخبار المستعين والمعتز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عقلاء المجانين.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اخبار قدماء البلغاء).(@)(@@)(@@)(@@) $BIO_MAN$ أبو أيوب المديني(@)(@@) واسمه سليمان بن أيوب بن محمد. من أهل المدينة، من الظرفاء الأدباء، عارف بالغناء واخبار المغنيين.(@)(@@) وله في ذلك عدة كتب منها، كتاب اخبار عزة الميلاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن مسجح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قيان الحجاز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قيان مكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاتفاق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات المغنيين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النغم والايقاع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المنادمين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ظرفاء المدينة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن أبي عتيق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن عايشة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار حنين الحيري .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن سريج.(@)(@@) (كتاب الغريض).(@)(@@)(@@)(@@) $BIO_MAN$ الثعلبي (@)(@@) واسمه محمد بن الحارث. وكان في جملة الفتح بن خاقان. وله من الكتب، كتاب أخلاق الملوك (الفه للفتح) (كتاب رسائله.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الروضة).(@)(@@)(@@)(@@) $BIO_MAN$ ابن الحرون(@)(@@) واسمه محمد بن أحمد بن الحسن بن الأصبغ بن الحرون. حسن التأليف والتصنيف، مليح الأدب، من أهل بغداد، من أولاد الكتاب. وله من الكتب، كتاب المطابق والمجانس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحقائق، كتاب كبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرياض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الكتاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المحاسن.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مجالسة الرؤساء).(@)(@@)(@@)(@@) $BIO_MAN$ ابن خرداذبة (يقدم على ابن عمار)(@)(@@) أبو القاسم عبد الله بن أحمد بن خرداذبه. وكان خرداذبه مجوسيا أسلم على يد البرامكة، وتولى أبو القاسم البريد والخبر بنواحي الجبل ونادم المعتمد وخص به وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب أدب السماع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمهرة 
ms176	 أنساب الفرس والنوافل).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسالك والممالك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اللهو والملاهي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشراب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الندام والجلساء.(@)PageV00P165(@)(@@)(@@)(@@) $BIO_MAN$ ابن عمار الثقفي(@)(@@) أبو العباس أحمد بن عبيد الله (بن محمد) بن عمار الثقفي الكاتب. وكان يتوكل للقاسم بن عبد الله ولولده، وصحب، أبا عبد الله محمد بن (داود بن) الجراح، ويروى عنه. وله مجالسات واخبار... وتوفى (سنة تسع عشرة وثلثمائة). وله من الكتب، كتاب المبيضة في اخبار مقاتل آل أبي طالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مثالب أبى نواس .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار سليمان بن أبي شيخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الزيادات في اخبار الوزراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار حجر بن عدي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في بنى أمية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى نواس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار ابن الرومي والاختيار من شعره.(@)(@@) (كتاب رسالته في تفضيل بنى هاشم وأوليائهم وذم بنى أمية واتباعهم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسالته في أمر ابن المحدر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى العتاهية.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب المناقضات).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عبد الله بن معاوية بن جعفر (كتاب رسالته في مثالب معاوية).(@)(@@)(@@)(@@) $BIO_MAN$ (السرخسي)(@)(@@) (أبو الفرج أحمد بن الطيب السرخسي. متأدب بليغ كثير الرواية. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السياسة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسالك والممالك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب الملوك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدلالة على اسرار الغناء).(@)(@@)(@@)(@@) $BIO_MAN$ جعفر بن حمدان الموصلي(@)(@@) أبو القاسم جعفر بن محمد بن حمدان الموصلي، الفقيه، حسن التأليف والتصنيف، يتفقه على مذهب الشافعي. وكان شاعرا أديبا، ناقدا للشعر، كثير الرواية. وله في الفقه عدة كتب، تذكرها عند ذكرنا الفقهاء.(@)(@@) فاما كتبه الأدبية فهي، كتاب الباهر في الاختيار من اشعار المحدثين (وبعض القدماء والسرقات).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء الكبير، ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السرقات، ولم يتمه، ولو تمه لاستغنى الناس عن كل كتاب في معناه .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب محاسن اشعار المحدثين. لطيف.(@)(@@)(@@)(@@) $BIO_MAN$ أبو ضياء النصيبي(@)(@@) أبو ضياء بشر بن يحيى بن علي القتبي النصيبي من (أهل) نصيبين. وكان شاعرا قليل الشعر وأديبا (غزير الأدب). وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ 
ms177	 كتاب سرقات البحتري من أبى تمام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجواهر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السرقات الكبير. ولم يتمة.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي منصور الموصلي(@)(@@) وهو يحيى بن أبي منصور. وأهله بالموصل كثير، وكتبه موجودة وكان في نهاية حسن الأدب. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأغاني، عمله على الحروف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعاريض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيخ. لطيف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العود والملاهي.(@)(@@)(@@)(@@) $BIO_MAN$ ابن المرزبان(@)(@@) أبو عبد الله محمد بن خلف بن المرزبان. يتعاطى طريقه أحمد بن طاهر، حافظ للاخبار والاشعار والملح.(@)PageV00P166(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الحاوي في علوم القرآن. كبير سبعة وعشرون جزءا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى قيس الرقيات ومختار شعره).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المتيمين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشراب. ويحتوي على عدة كتب.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب) المعصومين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المتباعدين .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الروض (والزهر).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجلساء والندماء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السودان وفضلهم على البيضان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ألقاب الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشعر والشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الهدايا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشتاء والصيف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النساء والغزل.(@)(@@) (كتاب اخبار عبد الله بن جعفر ابن أبي طالب رضي الله عنهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ذم الحجاب والعتب على المحتجب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ذم الثقلاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار العرجي).(@)(@@)(@@)(@@) $BIO_MAN$ الكسروي(@)(@@) ويعرف بعلي بن مهدي ويكنى أبا الحسين. وكان مؤدبا أديبا حافظا عارفا بكتاب العين خاصة. وكان يؤدب (ولد) هارون بن علي (بن يحيى) النديم. واتصل بعد ذلك بابى النجم بدر المعتضدي. وله من الكتب:(@)(@@) (كتاب الخصال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناقضات من زعم أنه لا ينبغي ان يقتدى القضاة في مطاعمهم بالأئمة والخلفاء. وقد عزى هذا الكتاب إلى الكسروي الكاتب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأعياد والنواريز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مراسلات الاخوان ومحابات الخلان).(@)(@@)(@@)(@@) $BIO_MAN$ ابن بسام الشاعر(@)(@@) علي بن محمد بن نصر بن منصور بن بسام. وأم على، امامة بنت حمدون النديم لأبيه وأمه. وكان شاعرا أديبا، من الظرفاء الكتاب، لا يسلم من لسانه أحد. وتوفى.. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عمر بن أبي ربيعة: ولم أر في معناه أبلغ منه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الديحين؟ وهم المعاقرون.(@)(@@)(@@)(@@) $DIC_BIB$ 
ms178	 (كتاب ديوان رسائله.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناقضات الشعراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الأحوص.)(@)(@@)(@@)(@@) $BIO_MAN$ المروزي(@)(@@) واسمه جعفر بن أحمد المروزي، ويكنى أبا العباس. أحد المؤلفين للكتب في سائر العلوم. وكتبه عزيزة جدا وهو أول من الف في المسالك والممالك كتابا ولم يتمه. وتوفى بالأهواز وحملت كتبه إلى بغداد. وبيعت في طاق الحراني سنة أربع وسبعين ومائتين. فمن كتبه:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسالك والممالك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ (آي) القرآن لتأييد كتب السلطان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البلاغة والخطابة.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الناجم).(@)(@@)(@@)(@@) $BIO_MAN$ الصولي(@)(@@) أبو بكر محمد بن يحيى بن العباس الصولي. من الأدباء الظرفاء والجماعين للكتب، (و) نادم الراضي.(@)(@@) وكان أولا يعلمه و (قد) نادم المكتفى ثم المقتدر دفعة واحدة. وأمره أظهر وأشهر وأقرب من أن نستقصيه.(@)(@@) وكان من العب أهل زمانه بالشطرنج، حسن المروة. وعاش إلى سنة (ثلاثين وثلثمائة). وتوفى مستترا بالبصرة، لأنه روى جزأ في علي عليه السلام، فطلبته الخاصة والعامة لتقتله. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأوراق في اخبار الخلفاء والشعراء. ولم يتمه، والذي خرج منه، اخبار الخلفاء بأسرها واشعار أولاد الخلفاء وآبائهم من السفاح إلى أيام ابن المعتز. اشعار من بقى من بنى العباس ممن ليس بخليفة. ولا ابن خليفة لصلبه: وأول ذلك شعر عبد الله بن علي وآخره شعر أبى احمد محمد بن أحمد بن إسماعيل بن إبراهيم بن عيسى بن المنصور. ويتلو ذلك اشعار الطالبيين ولد(@)PageV00P167 الحسن والحسين. وولد العباس بن علي. وولد عمر بن علي. وولد جعفر بن أبي طالب. ثم يلي ذلك اشعار ولد الحارث بن عبد المطلب. وبعده اخبار ابن هرمة ومختار شعره. اخبار السيد (الحميري) ومختار شعره. اخبار أحمد بن يوسف ومختار شعره. (اخبار إسحاق بن إبراهيم ومختار شعره). اخبار سديف ومختار شعره. وهذا الكتاب عول في تأليفه على كتاب المرثدي في الشعر والشعراء، بل نقله نقلا وانتحله. وقد رأيت دستور الرجل (خرج من) خزانة الصولي، فافتضح به. ومن كتبه بعد ذلك، كتاب الوزراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العبادة.(@)(@@)(@@)(@@) $DIC_BIB$ 
ms179	 كتاب أدب الكتاب على الحقيقة (كتاب تفضيل السنان. عمله لأبي الحسن علي بن الفرات).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الشبان).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواع ولم يتمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سؤال وجواب رمضان لأبي المنجم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رمضان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشامل في علم القرآن، ولم يتمه، وللعلماء في ذلك نوادر ليس هذا موضعها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناقب علي بن (محمد بن) الفرات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى تمام كتاب اخبار الجبائي أبى سعيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العباس بن أحنف ومختار شعره (رسالته في السعاة).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى عمرو بن العلا.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الغرر أمالي).(@)(@@)~:section: ومما صنعه أبو بكر من اشعار المحدثين على حروف المعجم(@)(@@) ابن الرومي. أبو تمام. البحتري. أبو نواس. العباس بن الأحنف. علي بن الجهم. ابن طباطبا. إبراهيم بن العباس (الصولي). (ابن عيينة. ابن شراعة. ابن الصولي. ابن الرومي).(@)(@@)(@@)(@@) $BIO_MAN$ الحكيمي(@)(@@) أبو عبد الله محمد بن أحمد بن إبراهيم بن قريش الحكيمي. وكان اخباريا قد سمع من جماعة. وتوفى..(@)(@@) وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلية الأدباء - يحتوي على اخبار..(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سقط الجوهر كتاب الشباب وفضله على المشيب .(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الفكاهة والدعابة).(@)(@@)(@@)(@@) $BIO_MAN$ الرحابي(@)(@@) وهو أبو على...(@)(@@)(@@)(@@) ||| طبقة أخرى من غير من مضى(@)(@@)(@@)(@@) $BIO_MAN$ أبو العباس الصيمري (@)(@@) أصله من الكوفة. وكان قاضى الصيمرة . وهو أبو العنبس محمد بن إسحاق بن أبي العنبس، من أهل الفكاهات والمراطزات. وكان مع ذلك أديبا عارفا بالنجوم، وله في ذلك كتاب رأيت أفاضل المنجمين يمدحونه. وادخله المتوكل في جملة ندمائه، وخص به. وله بحضرته خبر مع البحتري مشهور. وعاش إلى أيام المعتمد ودخل في جمله ندمائه. وله يهجو طباخ المعتمد:(@)PageV00P168 يا طيب أيامي بمعشوق ونحن في بعد من السوق إذا طلبت الخبر من فارس ينفخ لي صالح بالبوق وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تأخير المعرفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العاشق والمعشوق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على المنجمين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيليب؟ .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كور ابلاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طوال اللحى .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد المتطببين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عنقاء مغرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الراحة ومنافع الفدارة .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب 
ms180	 فضايل حلق الرأس .(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب العاشق والمعشوق) مكرر كتاب هندسة العقل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأحاديث الشاذة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضايل الزق .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على أبى ميخائيل الصيدناني في الكيمياء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مساوئ العوام واخبار السفلة الاغتام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عجائب البحر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجوابات المسكتة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحوايين والترياقات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضل السلم على الدرجة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدولتين في تفضيل الخلافتين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفاس بن الحائك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تذكية العقول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السحاقات والبغايين .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخضخضة في جلد عميره.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبى فرعون كندر؟(@)(@@) بن جحدر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفسير الرؤيا.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الثقلاء) (كتاب نوادر الحوصي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مناظرته للبحتري).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر القواد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب دعوة العامة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاخوان والأصدقاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كنى الدواب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب احكام النجوم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المدخل في صناعة التنجيم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صاحب الزمان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخلعتين. (كتاب فضل السلم على الرحة) كتاب استغاثة الجمل إلى ربه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضل السرم على الفم.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب نوادره واشعاره).(@)(@@)(@@)(@@) $BIO_MAN$ أبو حسان النملي(@)(@@) وهو أبو حسان محمد بن حسان. أحد الطياب والأدباء وكان في أيام المتوكل وله معه أحاديث. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بردان وحباحب في اخبار النساء والباه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الصغير في هذا المعنى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البغاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السحق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطاب المكاري لجارية البقال.(@)(@@)(@@)(@@) $BIO_MAN$ أبو العبر الهاشمي (@)(@@) ويكنى أبا العباس، محمد بن أحمد بن عبد الله بن عبد الصمد بن علي بن عبد الله بن العباس قال جحظة.(@)(@@) لم أر احفظ منه لكل عين، ولا أجود شعرا. ولم يكن في الدنيا صناعة إلا وهو يعملها بيده، حتى لقد رأيته يعجن ويخبز. وكان أبوه يلقب بالحامض، حافظا أديبا. في نهاية النصب واللعنة (14)، وقتل بقصر ابن هبيرة وقد خرج لاخذ أرزاقه، قتله قوم من الشيعة (15) سمعوه تناول (16) عليا عليه السلام (17) فرموا به من (فوق) سطح (خان) كان بايتا علية فمات، (وذلك) في سنة خمسين ومائتين. ومن شعره.(@)(@@) زائر نم عليه حسنه كيف يخفى 