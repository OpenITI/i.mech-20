ms361	 غيث الحجى ، وتخطاني(@)(@@) 18 ألم تر أعشى هوذة اهتاج ، يدعي %~% معونته عند المقال بشيطان(@)(@@) 19 يراد بنا المجد الرفيع بزعمنا ، %~% ونختار لبثا في وبيلة أوطان(@)(@@) 20 كأنا غروب مكرهات على العلى %~% تمد إلى أعلى الركي بأشطان PageV01P1679(@)(@@) 21 وما العيش إلا لجة ذات غمرة %~% لها مولدالإنسان والموت شطان(@)(@@) 22 فأحسن بدنياك المسيئة إذ بدت %~% عليها وشاح من نجوم وسمطان(@)(@@) 23 وكم واسع الأعطان تحرج نفسه %~% ورحب فؤاد آلف ضيق أعطان(@)(@@) 24 ومن لي بجون عند كدر بقفرة ، %~% كأنهما من آل يعقوب سبطان(@)(@@) 25 يجر بها المرطان من يمنية ، %~% على كل غبراء الأفاحيص مرطان(@)(@@) 26 تخال بها مسعى من الصل مسقطا %~% من السوط ، والعينان في الجنح سقطان(@)(@@) 27 إذا ما انجلى خيط الصباح تبينت %~% حبال رمال ، ذات عفر وخيطان(@)PageV01P1680(@)(@@) البحر : طويل(@)(@@) 1 أيأتي نبي يجعل الخمر طلقة ، %~% فتحمل ثقلا من همومي وأحزاني(@)(@@) 2 وهيهات لو حلت لما كنت شاربا %~% مخففة في الحلم كفة ميزاني(@)(@@) 3 إذا خزنوني في الثرى فمقالدي %~% مضيعة ، لا يحسن الحفظ خزاني(@)(@@) 4 كأني نبت مر يوم وليلة %~% علي ، وكانا منفضين ، فجزاني(@)(@@) 5 هما بدويان الطريق تعرضا %~% وبردي من نسج الشبيبة بزاني(@)(@@) 6 قويان عزاني عليه ، وأوقعا %~% بغيري ما بي أوقعاه ، فعزاني(@)(@@) 7 وما ضيقا أرضي ، ولكن أراهما %~% إلى الضنك ، من وجه البسيطة ، لزاني(@)(@@) 8 وما أكلا زادي ، ولكن أكلته ، %~% وقد نبهاني للسرى واستفزاني(@)(@@) 9 ولم يرضيا إلا بنفسي من القرى ، %~% ولو صنته عن طارقي لأخزاني(@)(@@) 10 وما هاج ذكري بارق نحو بارق ؛ %~% ولا هزني شوق لجارة هزان PageV01P1681(@)(@@) 11 بل الفتيان اعتاد قلبي أذاهما %~% يشيمان أسياف الردى ، ويهزان(@)(@@) 12 عزيزان بالله ، الذي ليس مثله ، %~% يذلان في مقداره ويعزان(@)(@@) 13 وكم فتكا ، والحس قد بان عنهما ، %~% بأهل وهود أو جبال وحزان(@)(@@) 14 وما تركا ترك القباب ، وغادرا %~% برمحين أو جزرين أسرة جرزان(@)(@@) 15 سلا غاب ترج والأنيعم كم ثوى ، %~% بذاك وهذا من أسود وخزان(@)PageV01P1682(@)(@@) البحر : طويل(@)(@@) 1 أريد ليان العيش في دار شقوة ، %~% وتأبى الليالي غير بخل وليان(@)(@@) 2 ويعجبني 
ms362	 شيئان : خفض وصحة ، %~% ولكن ريب الدهر غير شياني(@)(@@) 3 وما جبل الريان عندي بطائل ، %~% ولا أنا من خود الحسان بريان(@)(@@) 4 وأحياني الله القدير ملاوة %~% فهلا بخوف الله أقطع أحياني ؟(@)(@@) 5 وإن بني الديان ، أخمل عزهم %~% قيام عميد من خزيمة ديان(@)(@@) 6 وما اقتتل الحيان إلا سفاهة ، %~% ولو صح ودي للمحارب حياني(@)(@@) 7 وتهلك أعيان الرجال ، وإنما %~% مصارع أعيار كمصرع أعيان(@)(@@) 8 ولم يشو حتف أم عفر بوهدة %~% ولا أم غفر بين آس وظيان(@)(@@) 9 أريد عليات المراتب ضلة ، %~% وخرط قتاد الليل دون عليان(@)PageV01P1683(@)(@@) البحر : طويل(@)(@@) 1 تمزن من مزن السحاب معاشر %~% ومن مازن ، بيض النمال ، تمزني(@)(@@) 2 عززت ، ورب الناس أعطاك عزة ، %~% وأصبحت هينا ، كل شيء يعزني(@)(@@) 3 كنبت ضعيف لم يوازره غيره ، %~% فأي نسيم هب ، فهو يهزني(@)PageV01P1684(@)(@@) البحر : طويل(@)(@@) 1 لهان علينا أن تمر كأنها %~% هوازن طير نسوة من هوازن(@)(@@) 2 وأم طويل الرمح سمته مازنا %~% لدى العقل يحكي نملة ، أم مازن(@)(@@) 3 رضيت بما جاء القضاء مسلما ، %~% وضاع سؤالي في حواز حوازن(@)(@@) 4 وما أنا إن وليت أمرا بعادل ؛ %~% ولا في قريض الشعر بالمتوازن(@)(@@) 5 إذا أنت أوتيت الغنى فادخر به %~% نثا ، وأرحه من خواز خوازن(@)PageV01P1685(@)(@@) البحر : طويل(@)(@@) 1 ثعالة حاذر من أمير وسوقة %~% فمن لفظ صيد جاء لفظ الصيادن(@)(@@) 2 ولا تتخذ من آل حواء صاحبا ، %~% وغيرهم إن شئت فاصحب وخادن(@)(@@) 3 فإن كان في دنياك للشر معدن %~% فإنهم في ذاك أزكى المعادن(@)(@@) 4 ولا تقرب الناظور في الأرض ، خلته %~% هدانا ، فتلقى فاتكا لم يهادن(@)(@@) 5 وعاص مشيما قال : بادره غاده ، %~% فلست بحاد كيد أشمط بادن(@)(@@) 6 فرب مسن رد مثلك ، بالضحى ، %~% لقى لرواد في النساء الروادن(@)(@@) 7 وكم أيموا من ضيغم أم أشبل ، %~% وكم أثكلوا من أم شاد وشادن(@)PageV01P1686(@)(@@) البحر : طويل(@)(@@) 1 قرن بحج عمرة وقريننا %~% غراما ، فآه من قوار قوارن(@)(@@) 2 عقائل مرد فوق جرد عوابس %~% ذوات أوار بالفناء أوارن(@)(@@) 3 مرى لهم المران رسل حياتهم ، %~% فأعجب برسل من موار موارن(@)(@@) 4 إذا لم 
ms363	 يزم النفس لب ولا تقى ، %~% فرب عوار ، للأنوف عوارن(@)(@@) 5 وكم من حسام قد أميط به الأذى %~% ومارن سمر فيه رغم لمارن(@)PageV01P1687(@)(@@) البحر : طويل(@)(@@) 1 رأيتك مفقود المحاسن ، غابرا ، %~% مع الناس في دهر فقيد المحاسن(@)(@@) 2 أترجو المطايا خفض عيش ولذة %~% يريح براها من مراس المراسن ؟(@)(@@) 3 فقد سئمت خوض الرمال خفافها %~% ونضح صداها بالمياه الأواسن(@)(@@) 4 فيوم نوى قصرن فيه عن النوى ، %~% ويوم فراس دسنه بالفراسن(@)(@@) 5 فإن لا يكن وسنان حظي وحظها ، %~% فإن عليه فترة المتواسن(@)(@@) 6 إذا أنت لم تصبح من الناس مفردا ، %~% أذنت إلى لاص يعيب ولاسن(@)PageV01P1688(@)(@@) البحر : طويل(@)(@@) 1 سكنت إلى الدنيا فلما عرفتها %~% تمنيت أني لست فيها بساكن(@)(@@) 2 وما فتئت ترمي الفتى عن قسيها %~% بكل الرزايا من جميع الأماكن(@)(@@) 3 وما سمحت للزائرات بأمنها ؛ %~% ولا للمواكي في أقاصي المواكن(@)(@@) 4 ركنا إليها إذ ركونا أمورها %~% فقل في سفاه للرواكي الرواكن(@)(@@) 5 فأين الشموس اليعربيات قبلنا ، %~% بها كن فاسأل عن مآل البهاكن(@)(@@) 6 ركن المنايا أن ركون ، فبنعمة %~% من الله دامت للزواكي الزواكن(@)(@@) 7 جمعنا بقدر وافترقنا بمثله %~% نفتنا قوى لا مضربات لسالم ،(@)(@@) 8 نفتنا قوى لا مشربات لسالم %~% ب لا بل ، ولا مستدركات ب لكن(@)PageV01P1689(@)(@@) البحر : طويل(@)(@@) 1 قبيح مقال الناس : جئناه مرة ، %~% فكان قليلا خيره لم يعاون(@)(@@) 2 إذا أنت لم تعط الفقير ، فلا يبن %~% له منك وجه المعرض المتهاون(@)(@@) 3 ولا تأمنن الحادثات فإنها %~% ترد ليوث الغاب مثل الضياون(@)PageV01P1690(@)(@@) البحر : طويل(@)(@@) 1 منون رجال خبرونا عن البلى ، %~% وعادوا إلينا بعد ريب منون(@)(@@) 2 بنون كآباء ، وكم برح الردى %~% بضب على علاته ، وبنون(@)(@@) 3 دفناهم في الأرض دفن تيقن %~% ولا علم بالأرواح غير ظنون(@)(@@) 4 وروم الفتى ما قد طوى الله علمه ، %~% يعد جنونا أو شبيه جنون(@)PageV01P1691(@)(@@) البحر : طويل(@)(@@) 1 حياة وموت وانتظار قيامة ، %~% ثلاث أفادتنا ألوف معاني(@)(@@) 2 فلا تمهرا الدنيا المروءة ، إنها %~% تفارق أهليها فراق لعان(@)(@@) 3 ولا تطلباها من سنان وصارم ، %~% بيوم ضراب ، أو بيوم طعان(@)(@@) 4 وإن شئتما 
ms364	 أن تخلصا من أذاتها ، %~% فحطا بها الأثقال واتبعاني(@)(@@) 5 فما راعني منها تهجم ظالم ؛ %~% ولا خمت عن وهد لها ورعان(@)(@@) 6 ولا حل سري قط في أذن سامع %~% وشنفاه أو قرطاه يستمعان(@)(@@) 7 ولم أرقب النسرين في حومة الدجى ، %~% أظنهما في كفتي يقعان(@)(@@) 8 عجبت من الصبح المنير وضده %~% على أهل هذي الأرض يطلعان(@)(@@) 9 وقد أخرجاني بالكراهة منهما ، %~% كأنهما ، للضيق ، ما وسعاني(@)(@@) 10 وكيف أرجي الخير يصدر عنهما ، %~% وقد أكلتني فيهما الضبعان ؟ PageV01P1692(@)(@@) 11 وما بر من ساواهما في قياسه %~% ببري عقوق بل هما سبعان(@)(@@) 12 وما مات ميت مرة في سواهما %~% كخصمين في الأرواح يقترعان(@)(@@) 13 أشاحا فقالا ضلة ليس عندنا %~% محل ، وفي ضيق الثرى وضعاني(@)(@@) 14 وكيوان والمريخ عبدان سخرا ، %~% ولست أبالي إن هما فرعاني(@)(@@) 15 ولو شاء من صاغ النجوم بلطفه ، %~% لصاغهما كالمشتري ودعان(@)(@@) 17 أيعكس هذا الخلق مالك أمره ، %~% لعل الحجى والحظ يجتمعان ؟(@)PageV01P1693(@)(@@) البحر : طويل(@)(@@) 1 أرى الخلق في أمرين : ماض ومقبل ؛ %~% وظرفين ظرفي مدة ومكان(@)(@@) 2 إذا ما سألنا عن مراد إلهنا ، %~% كنى عن بيان ، في الإجابة ، كاني(@)PageV01P1694(@)(@@) البحر : -(@)(@@) 1 أرى فتيي دنياك إن حرج الفتى %~% فما إن هما في مأثم حرجان(@)(@@) 2 وكم من رحيب يلقيان ملاءة %~% عليه ، وضنك ضيق يلجان(@)(@@) 3 جديدان لما يبليا بتقادم ، %~% ولا بأكف القوم ينتسجان(@)(@@) 4 إذا حزن الأصحاب لم يحزنا لهم %~% وأنى بضد الحزن يبتهجان(@)(@@) 5 ملاحيتي ، قد زينت أنجم الدجى %~% ملاحية لم تجنها يد جاني(@)(@@) 6 تعلق أذن الدهر قرطا ، ولم يكن %~% ليخلج ، والقرطان يختلجان(@)(@@) 7 ومن داين الأيام ، فهي ملية ، %~% على غيها ، باللي والسلجان(@)(@@) 8 وسيان ملكا معشر في سناهما %~% وعلجان في الشعراء والعلجان(@)(@@) 9 رجاك لعمري أيها الريم قاطع %~% رجائي ، وبعدا للغوي رجاني(@)(@@) 10 وآثر عندي من مديحي ، تخرصا ، %~% كلام غوي لامني وهجاني PageV01P1695(@)(@@) 11 غدا الحتف لا شجوا يخاف ولا شجا %~% وقبلك أشجى أسودي وشجاني(@)(@@) 12 وما ينفع الغربيب ، والضعف واقع ، %~% إذا كان لون الرأس غير هجان(@)PageV01P1696(@)(@@) البحر : بسيط تام(@)(@@) 1 عيشي مؤد إلى الضراء 
ms365	 والوهن %~% ومهنتي لإلهي أشرف المهن(@)(@@) 2 تخل من أم دفر ، فهي مؤذية ، %~% وهون الأمر في غرائه يهن(@)(@@) 3 إنا ضيوف زمان ما قراه لنا %~% إلا المنايا ، ونحن الآن في اللهن(@)(@@) 4 فقد أنفت لنفس منه نافرة %~% كل النفار ، وشخص فيه مرتهن(@)(@@) 5 الله عالم غيب لا أحاوله %~% من ذي نجوم ، ولا أبغيه في الكهن(@)PageV01P1697(@)(@@) البحر : بسيط تام(@)(@@) 1 لولا الحوادث لم أركن إلى أحد %~% من الأنام ، ولم أخلد إلى وطن(@)(@@) 2 وكنت في كل تيه صاحبا لقطا %~% في الورد ، قطني من سعد ومن قطن(@)(@@) 3 حليف وجناء ترمي بالوجين شفا %~% منها ، وتجهل معنى الحوض والعطن(@)(@@) 4 وغيض السير عينيها فلو وردت %~% جميهما الطير ، لم تشرب بلا شطن(@)(@@) 5 وهل ألوم غبيا في غباوته %~% وبالقضاء أتته قلة الفطن ؟(@)PageV01P1698(@)(@@) البحر : بسيط تام(@)(@@) 1 إن لم تكن عائمي لج تمارسه %~% إلى الحمام ، فإنا راكبو سفن(@)(@@) 2 لولا التجمل سرنا في ترحلنا %~% كما وردنا ، بلا طيب ولا كفن(@)(@@) 3 إن اللباس وعطرا أنت بائعه %~% ليسا لمدفون موتانا بل الدفن(@)(@@) 4 جاء الوليد معرى لا خيوط له ، %~% فما الفضيلة بين الطفل واليفن(@)PageV01P1699(@)(@@) البحر : بسيط تام(@)(@@) 1 أمسي ، وأمسي في شحط ، وإن غدي %~% وإن يومي ، بلا ريب ، لأمسان(@)(@@) 2 إن الفتيين بالفتيان في لعب %~% كل أحس ، ومرا لا يحسان(@)(@@) 3 ويوديان بما قالوا وما صنعوا ، %~% حتى إساءة قوم مثل إحسان(@)(@@) 4 والله يخلف أزمانا بمشبهها %~% كما يبدل إنسانا بإنسان(@)(@@) 5 تلقي المقادير في آنافهم خطما %~% يقدنهم ، لمناياهم ، بأرسان(@)(@@) 6 أذوين آل زهير ، وارتعين بني %~% نبت ، وحسين موتا رهط حسان(@)(@@) 7 المطعمي الضيف عن يسر وعن عدم %~% والشاهدي الحرب من زجل وفرسان(@)(@@) 8 كاسوا عقولا وكاست إبلهم كرما %~% والغدر في الناس لم يعرف بكيسان(@)PageV01P1700(@)(@@) البحر : بسيط تام(@)(@@) 1 العيش ماض فأكرم والديك به %~% والأم أولى بإكرام وإحسان(@)(@@) 2 وحسبها الحمل والإرضاع تدمنه %~% أران بالفضل نالا كل إنسان(@)(@@) 3 واخش الملوك وياسرها بطاعتها ، %~% فالملك للأرض مثل الماطر الساني(@)(@@) 4 إن يظلموا ، فلهم نفع يعاش به ، %~% وكم حموك برجل 
ms366	 أو بفرسان(@)(@@) 5 وهل خلت ، قبل ، من جور ومظلمة ، %~% أرباب فارس ، أو أرباب غسان ؟(@)(@@) 6 خيل إذا سومت سامت ، وما حبست %~% إلا بلجم تعنيها وأرسان(@)PageV01P1701(@)(@@) البحر : بسيط تام(@)(@@) 1 قد آذنتنا بأمر فادح أذن ؛ %~% وإنما قيل آذان لإيذان(@)(@@) 2 شمس وبدر أنارا في ضحى ودجى %~% لآدم ، وهما لا ريب هذان(@)(@@) 3 والليل والصبح ما انجذت حبالهما ، %~% وكل حبل على عمد يجذان(@)(@@) 4 ويأكلان ، ولم يستوبلا مقرا %~% من الطعام ، ولا شهدا يلذان(@)(@@) 5 إن الجديدين ما ظنا وما علما %~% بل طائران على جد أحذان(@)(@@) 6 طرفان لله ما بذا ولا لحقا ، %~% ولم يزالا ، بمقدار ، يبذان(@)(@@) 7 هذا العظات علينا في سكونهما ، %~% كصارمين ذوي غرب يهذان(@)(@@) 8 وقالت الأرض مهلا يا بني ألا %~% سيان فوقي أجمالي وقذاني(@)(@@) 9 غذاكم الرب مني ، ثم عوضني %~% مما لقيت فبالأجسام غذاني(@)(@@) 10 وطئتموني بأقدام وأحذية %~% فقد أدلت ، فتحتي من تحذاني PageV01P1702(@)(@@) 11 كم مر في الدهر من قيظ ومن شبم %~% ولاح ، في الأرض ، من ورد وحوذان(@)(@@) 12 يا صاحبي اللذين استشفيا لضنى %~% بمن تلوذان أو ممن تعوذان(@)(@@) 13 بقراط _ عمري _ وجالينوس ما سلما %~% والحق أنهما في الطب فذان(@)PageV01P1703(@)(@@) البحر : بسيط تام(@)(@@) 1 أنافق الناس ، إني قد بليت بهم %~% وكيف لي بخلاص منهم دان ؟(@)(@@) 2 من عاش غير مداج من يعاشره %~% أساء عشرة أصحاب وأخدان(@)(@@) 3 كم صاحب يتمنى لو نعيت له ، %~% وإن تشكيت راعاني وفداني(@)(@@) 4 صحبت دهري وسوء الغدر شمته %~% فإن غدرت فإن الدهر أعداني(@)(@@) 5 وما أبالي وأرداني مبرأة %~% من العيوب ، إذا ما الحتف أرداني(@)(@@) 6 متى لحقت بتربي زل عن جدثي ، %~% مدحي وذمي من مثنى وأحدان(@)(@@) 7 هل تزدهي كعبة الحجاج ، إذ فقدت %~% حسا ، بكثرة زوار وسدان(@)(@@) 8 في الحول عيدان ما فازا بما رزقا %~% فيظهرا البشر لما قيل عيدان(@)(@@) 9 كم عبد الفتيان الخلق عن عرض %~% بذلة ، وهما لله عبدان(@)(@@) 10 أما الجديدان من ثوبي ومن جسدي %~% فيبليان ، ولا يبلى الجديدان PageV01P1704(@)(@@) 11 برد الشباب ، وبرد الناسج ابتذلا ، %~% وهل يدوم على البردين 
ms367	 بردان(@)PageV01P1705(@)(@@) البحر : بسيط تام(@)(@@) 1 الدهر لونان أعيا ثالث لهما ، %~% وكم أتاك بأشباه وألوان(@)(@@) 2 لا أشرب الراح ، أشري طيب نشوتها %~% بالعقل أفضل أنصاري وأعواني(@)(@@) 3 لو كان يعرف دنياه مصاحبها %~% أرادها لعدو دون إخوان(@)(@@) 4 وإن كفتني عذاب الله آخرتي ، %~% فما أحاول منها فوز رضوان(@)(@@) 5 والرزق يقسم ، ما فتكي بمنتقصي %~% حظا ، ولا النسك في المكروه أهواني(@)(@@) 6 سيحان للروم عذب ليس مورده %~% ملحا كزمزم ، أو عين لسلوان(@)(@@) 7 والإنس مثل نظام الشعر كم رجل %~% بالجيش يفدى ، وكم بيت بديوان(@)(@@) 8 وأقصر الوقت كون ثم ينظمه %~% حكم القديم ، ويفنيه بأكوان(@)(@@) 9 إن جاءني الخطب يجنيه بلا سبب %~% كيوان ، فالله أرجو ، رب كيوان(@)PageV01P1706(@)(@@) البحر : بسيط تام(@)(@@) 1 لا أشرك الجدي في در يعيش به ؛ %~% ولا أروع بنات الوحش والضان(@)(@@) 2 ولا أقول لجان : لم تجئ خطأ ، %~% إن كان يوما بحسن الفعل أرضاني(@)(@@) 3 لو ينطق السيف نادى : ليس لي عمل ، %~% إذا قضى مالك الأفلاك أنضاني(@)(@@) 4 متى أراد ، فصفحاي اللذان هما %~% بحرا الردى من حياض الموت حوضان(@)(@@) 5 وإن كهمت فأمر الله أكهمني ، %~% وإن مضيت فأمر الله أمضاني(@)PageV01P1707(@)(@@) البحر : بسيط تام(@)(@@) 1 خير وشر ، وليل بعده وضح ، %~% والناس ، في الدهر ، مثل الدهر قسمان(@)(@@) 2 واللب حارب تركيبا يجاهده ، %~% فالعقل والطبع ، حتى الموت ، خصمان(@)(@@) 3 هل ألحد السيف أو قلت ديانته %~% أو كان صاحب توحيد وإيمان ؟(@)(@@) 4 ورابني منه ترك الجاحدين سدى %~% لم يفجعوا برؤوس منذ أزمان(@)PageV01P1708(@)(@@) البحر : بسيط تام(@)(@@) 1 الطبع شيء قديم لا يحس به %~% وغادة المرء تدعى طبعه الثاني(@)(@@) 2 والإلف أبكى على خل يفارقه %~% وكلف القوم تعظيما لأوثان(@)PageV01P1709(@)(@@) البحر : بسيط تام(@)(@@) 1 ما رقش الخط في درج ولا صحف %~% من آل مقلة إلا مفلت فاني(@)(@@) 2 سيفان من فجري ظلماء ما شهرا %~% إلا لإفراد ذي بدن وسيفان(@)(@@) 3 ضيفان للدهر ميلاد ومخترم %~% ونحن بينهما أشباه ضيفان(@)(@@) 4 وما النسور ، وإن كانت مملكة ، %~% إلا نظير جراد ، طار ، خيفان(@)PageV01P1710(@)(@@) البحر : بسيط تام(@)(@@) 1 هل تثبتن لذي شام وذي يمن 
ms368	 %~% عدية الدهر من عز وتمكين(@)(@@) 2 خير لصاحب تاج يدعى ملكا %~% لو أنه لابس أطمار مسكين(@)(@@) 3 إن تمس في ، كما في الناس كلهم %~% أدناس حي ، فلا شيب يزكيني(@)(@@) 4 وما عنيت سوى ترب تغيرني %~% فيه أفارق تحريكي وتسكيني(@)(@@) 5 وما أعود إلى الدنيا ، وقد زعموا %~% أن الزمان بمثلي سوف يحكيني(@)(@@) 6 وكيف أشكو ، لجهل ، ما أمارسه ، %~% إلى الأنام ، وحكم الله يشكيني(@)(@@) 7 وارحمنا لشبيهي في حوادثه %~% ينكيه ما كان في الأيام ينكيني(@)(@@) 8 إن الذي بالمقال الزور يضحكني %~% ضد الذي بيقين الحق يبكيني(@)(@@) 9 وهل أسر ، ونفسي غير زاكية %~% بأن تخرص أفواه تزكيني(@)PageV01P1711(@)(@@) البحر : وافر تام(@)(@@) 1 إذا وقت السعادة زال عني %~% فكلني ، إن أردت ، ولا تكني(@)(@@) 2 نبذت نصيحتي أن رث جسمي ، %~% وكم نقع الغليل خبي شن(@)(@@) 3 وقد عدم التيقن في زمان %~% حصلنا من حجاه على التظني(@)(@@) 4 فقلنا للهزبر : أأنت ليث ؟ %~% فشك وقال علي أو كأني(@)(@@) 5 وضعت على قرا الأيام رحلي ؛ %~% فما أنا للمقام بمطمئن(@)(@@) 6 ولا قتبي على العود المزجى %~% ولا سرجي على الفرس الأدن(@)(@@) 7 ولكن ترقل الساعات تحتي %~% برئن من التمكث والتأني(@)(@@) 8 أحن وما أجن سوى غرام %~% بغير الحق من حن وجن(@)(@@) 9 نصحتك ، ناقتي ، سلبي ونفسي ، %~% ونحرك في الحنين ، فلا تحني(@)(@@) 10 أضيف القفر ضيفك ادلاج %~% فهل لك من ذؤالة في ضفن PageV01P1712(@)(@@) 11 غنى وتصعلك ، وكرى وسهد %~% فقضينا الحياة بكل فن(@)(@@) 12 زمان لا ينال بنوه خيرا %~% إذا لم يلحظوه من التمني(@)(@@) 13 عرفت صروفه فأزمت منها %~% على سن ابن تجربة مسن(@)(@@) 14 وأفقرني إلى من ليس مثلي %~% كما افتقر السنان إلى المسن(@)(@@) 15 أنا ابن الترب ما نسبي سواه %~% قللت عن التسمي والتكني(@)(@@) 16 إذا ألهمتني الغبراء ، يوما ، %~% فدق أمن التجنب والتجني(@)(@@) 17 وما أهل التحنؤ والتحلي %~% إلى أهل التحلؤ والتحني(@)(@@) 18 ويكفيك التقنع من قريب %~% عظائم ليس تبلغ بالتوني :(@)(@@) 19 ضرير الرمح في زرد منيع %~% ووقع المشرفي على المجن(@)(@@) 20 وحمل مهند يسطو بعير %~% وفور ، ليس بالأشر المرن 
ms369	 PageV01P1713(@)(@@) 21 ولا شلال عانات خماص %~% ولكن خيل جيش مرجحن(@)(@@) 22 يرى عذم الأوابد غير حل %~% ويعذم هامة البطل الرفن(@)(@@) 23 وما ينفك محتملا ذبابا ، %~% أبى التغريد في الخضر المغن(@)(@@) 24 يذب جذاره زرق الأعادي %~% ويسخى ، بالحياة ، حليف ضن(@)(@@) 25 وينفث في فم الحيات سما ، %~% ويملأ ذلة أنف المصن(@)(@@) 26 وخرق مفازة كسيت سرابا ، %~% يعري الذئب من وبر مكن(@)(@@) 27 شكت سحرا من السبرات قرا ، %~% فأوسعها الهجير من القطن(@)(@@) 28 وتعزف جنها ، والليل داج ، %~% إذا خلت الجنادب من تغني(@)(@@) 29 يخال الغر سرح بني أقيش %~% يؤنق في مراتعها بسن(@)(@@) 30 أراك إذا انفردت كفيت شرا ، %~% من الخل المعاشر والمعن PageV01P1714(@)(@@) 31 ومن يحمل حقوق الناس يوجد ، %~% لذي الأغراض كالفرس المعن(@)(@@) 32 ورضوى في المكارم ، لم تزني %~% للذات النفوس ، عبيد قن ؟(@)(@@) 33 فإن دانيتهم لم تعد ظلما ، %~% ومنا في الأمور بغير من(@)(@@) 34 نهيتك عن خلاط الناس ، فاحذر %~% أقاربك الأداني واحذرني(@)(@@) 35 وإن أنا قلت لا تحمل جزارا %~% فهز أخا السفاسق واضربني(@)(@@) 36 فنصل السيف ، وهو اللج ، يرمي %~% غريقا ، فوق سيف مرفئن(@)(@@) 37 وضاحيه يزيل غضون وجه %~% ويبسط من وداد المكبئن(@)(@@) 38 فما حملت يداه به خؤونا ، %~% ولا نبراته نبرات ون(@)(@@) 39 سنا العيش الخمول فلا يقولوا : %~% دفين الصيت كالميت المجن(@)(@@) 40 وتؤثر حالة الزميت نفسي %~% وأكره شيمة الرجل المفن PageV01P1715(@)(@@) 41 كفى حزنا رحيل القوم عني %~% وليس تخيري وطن المبن(@)(@@) 42 تبنوا خيمهم فوقوا هجيرا %~% وأعوزني مكان للتبني(@)(@@) 43 يصافح راحة باليأس قلبي ، %~% ولدن الشرخ حول من لدني(@)(@@) 44 وما أنا والبكاء لغير خطب ، %~% أعين بذاك من لم يستعني(@)(@@) 45 حسبتك لو توازن بي ثبيرا ، %~% ورضوى في المكاره لم تزني(@)(@@) 46 وما أبغي كفاءك عن جميل %~% وأما بالقبيح فلا تدني(@)(@@) 47 ولا تك جازيا بالخير شرا %~% وإن أنا خنت في سبب فخني(@)(@@) 48 جليسي ما هويت لك اقترابا %~% وصنتك عن معاشرتي ، فصني(@)(@@) 49 أرى الأقوام خيرهم سوام %~% وإن أهن ابن حادثته يهني(@)(@@) 50 إذا قتل الفتى الشريب منهم ، PageV01P1716(@)(@@) 51 رأيت بني النضير من 
ms370	 آل موسى %~% أعارهم الشقاء حطيم ثن(@)(@@) 52 سعوا وسعت أوائلهم لأمر %~% فما ربحوا سوى دأب معني(@)PageV01P1717(@)(@@) البحر : وافر تام(@)(@@) 1 إذا هاجت ، أخا أسف ، ديار ، %~% فليت طلول دارك لم تهجني(@)(@@) 2 إذا خلجت بوارق في هزيع ، %~% دعوت ، فقلت : يا موت اختلجني(@)(@@) 3 أتأسى النفس للجثمان يبلى ، %~% وهل أسي الحيا لفراق دجن(@)(@@) 4 وما ضر الحمامة كسر ضنك ، %~% من الأقفاص كان أضر سجن(@)(@@) 5 أعوذ بخالقي من أن يراني %~% كشاك النبت ، لا يجنى ويجني(@)(@@) 6 كممطور القتادة ، يتقينا %~% بآلات ، مقوسة ، وحجن(@)(@@) 7 أزجي العيش معترفا بضعف %~% أنافي القول في عرب وهجن(@)(@@) 8 فإن الطير يقنعهن ورد ، %~% على ما كان من صفو وأجن(@)PageV01P1718(@)(@@) البحر : وافر تام(@)(@@) 1 كأن الدهر بحر نحن فيه %~% على خطر كركبان السفين(@)(@@) 2 بكى جزعا لميته كفور ، %~% فجاء بمنتهى الرأي الأفين(@)(@@) 3 مصيبة دينه ، لو كان يدري ، %~% أجل من المصيبة بالدفين(@)(@@) 4 قد استخفيت ، كالجسد الموارى ، %~% ولكن الطوارق تختفيني(@)(@@) 5 عفا أثري الزمان وما أغبت %~% ضباع ، في المحلة ، تعتفيني(@)PageV01P1719(@)(@@) البحر : وافر تام(@)(@@) 1 أجارحي الذي أدمى أساني ، %~% وسالب حلتي عني كساني(@)(@@) 2 فما لي لا أقول ، ولي لسان %~% وقد نطق الزمان بلا لسان(@)(@@) 3 عسا عمر و عن الطوق المعري ، %~% فقد جانبت علي أو عساني(@)(@@) 4 وبيعت بالفلوس لكل خزي %~% وجوه كالدنانير الحسان(@)(@@) 5 ولو أني أعد بألف بحر ، %~% لمر علي موت فاحتساني(@)(@@) 6 ظلامي والنهار قد استمرا %~% علي كما تتابع فارسان(@)PageV01P1720(@)(@@) البحر : وافر تام(@)(@@) 1 طلبت مكارما ، فأجدت لفظا ، %~% كأنا خالدان على الزمان(@)(@@) 2 سينسى كل ما الأحياء فيه %~% ويختلط الشآمي باليماني(@)(@@) 3 ورمت تجملا فكسيت شينا %~% ومن لك من شرورك بالأمان ؟(@)(@@) 4 وإن حوادث الأيام نكد ، %~% يصيرن الحقائق كالأماني(@)(@@) 5 ضماني أن سينفد كل شيء ، %~% سوى من ليس يدخل في الضمان(@)(@@) 6 وما خلت السماك ولا أخاه %~% على خلقيهما لا يهرمان(@)(@@) 7 وما أدري أعلمهما كعلمي ، %~% بهذا الأمر ، أم لا يعلمان ؟(@)(@@) 8 وإن فهما خطاب الدهر مثلي ، %~% على كاساتها يتنادمان ؟(@)(@@) 9 وأروح منهما حادي ثلاث %~% يسوقهن 
ms371	 أو حادي ثماني(@)(@@) 10 ومن لي أن أكون طريد سرب %~% سما لي خدن سنبس ، أو رماني PageV01P1721(@)(@@) 11 ألم ترني كميت الناس نفسي ، %~% فأظهرني القضاء ، وما كماني ؟(@)PageV01P1722(@)(@@) البحر : كامل تام(@)(@@) 1 لو هب سكان التراب من الكرى ، %~% أعيا المحل على المقيم الساكن(@)(@@) 2 لغدوا وقد ملأ البسيطة بعضهم %~% ورأيت أكثرهم بغير أماكن(@)(@@) 3 لا تركنن إلى الحياة ، فإنها %~% غدارة بأخي الوفاء الراكن(@)PageV01P1723(@)(@@) البحر : كامل تام(@)(@@) 1 طال الزمان علي وهو معللي %~% بمثالث من زوره ومثاني(@)(@@) 2 كم حلت الأحياء جدة روضة ، %~% ورعت لها نبتا لعام ثاني(@)PageV01P1724(@)(@@) البحر : -(@)(@@) 1 أف لدنيانا أحزانها %~% خففت من كفة ميزانها(@)(@@) 2 وتلك دار غير مأمونة %~% أولع ضاريها بخزانها(@)(@@) 3 في بقعة من رقعة يسرت %~% للبيدق الفتك بفرزانها(@)(@@) 4 أين ملوك غبرت مدة %~% بين روابيها وحزانها(@)(@@) 5 تردي بشق البدر أضيافها %~% وتشتري الخيل بأوزانها(@)(@@) 6 قد ذهبت عن ذهب صامت ، %~% وخلفته عند خزانها(@)PageV01P1725(@)(@@) البحر : -(@)(@@) 1 هل قبلت من ناصح أمة %~% تغدو إلى الفصح بصلبانها(@)(@@) 2 كنائس يجمعها وصلة %~% بين غوانيها وشبانها(@)(@@) 3 ما بالها عذراء أو ثيبا %~% كوردة الجاني بإبانها(@)(@@) 4 راحت إلى القس لتقريبها %~% وبيتها أولى بقربانها(@)(@@) 5 قد جربت من فعله سيئا ، %~% والطيب جار بجربانها(@)(@@) 6 وربها تسخط ، بل زوجها %~% بائس ، في طاعة ربانها(@)(@@) 7 وزارت الدير وأثوابها %~% ضامنة فتنة رهبانها(@)PageV01P1726(@)(@@) البحر : سريع(@)(@@) 1 قرنت جيشين ، فكم من دم %~% أرقت لا هديا عن القارن(@)(@@) 2 فمارني إن شئت أو لا فما %~% يعرف إلا ذلة مارني(@)(@@) 3 وار زناد الشر في هذه الدن %~% فقلل : يا جدثي وارني(@)(@@) 4 ويا خليلي درني زائد %~% فأقصني ، في الأرض ، أو دارني(@)(@@) 5 عندك مال ، فأعن سائلا ، %~% ولا تبت كالسابق الحارن(@)(@@) 6 فالرجل للرجلة ، والكف %~% للكفة والعرنين للعارن(@)PageV01P1727(@)(@@) البحر : -(@)(@@) 1 ما هاجني البارق من بارق %~% يوما ، ولا هز لهزان(@)(@@) 2 حربة زان بفؤاد الفتى ، %~% خير له من خربة الزاني(@)(@@) 3 لا أشرب الراح ولو ضمنت %~% ذهاب لوعاتي وأحزاني(@)(@@) 4 مخففا ميزان حلمي بها %~% كأنني ما خف ميزاني(@)(@@) 5 عمر مضى ، لا 
ms372	 كان من ذاهب %~% جزيته شرا وجزاني(@)(@@) 6 أجامل الناس ، ولو أنني %~% كشفت ما في السر أخزاني(@)(@@) 7 أسيت من نقصي ، ولكن ما %~% يظهر من غيري عزاني(@)PageV01P1728(@)(@@) البحر : -(@)(@@) 1 الحمد لله الذي صاغني ، %~% أطعمني رزقي وأحياني(@)(@@) 2 شخصي هذا عرضة للردى ، %~% ولم يزل معدن عصياني(@)(@@) 3 من كل فن فيه أعجوبة ، %~% كأنه جامع سفيان(@)(@@) 4 يا آل يعقوب ! خذوا حذركم ، %~% في الدهر ، من حبر وديان(@)(@@) 5 يزعم نارا من سماء هوت %~% تأكل ذا إفك وطغيان(@)(@@) 6 لو كنت فيما قلته صادقا %~% لم تعد للشر بهميان(@)(@@) 7 تجعل نميك تبرا ، وما %~% تؤخذ من عرج وعميان(@)(@@) 8 أما توقى كذبا فاحشا %~% أضذهلني منك وأعياني(@)(@@) 9 تجعل من نميك تبرا وما %~% تخلطه حبة عقيان(@)PageV01P1729(@)(@@) البحر : -(@)(@@) 1 يا بدوي اتق المدامة إن %~% الخمر باتت كثيرة الأبن(@)(@@) 2 آليت ما سمحت أخا بخل ، %~% يوما ولا شجعت أخا جبن(@)(@@) 3 وإنما تلك خفة حدثت %~% عنها ، فجاءت بأثقل الغبن(@)(@@) 4 أفضل من أحمر السلاف ومن %~% كميتها ، ناصع من اللبن(@)PageV01P1730(@)(@@) البحر : -(@)(@@) 1 لا تجلسن حرة موفقة %~% مع ابن زوج لها ولا ختن(@)(@@) 2 فذاك خير لها ، وأسلم لل %~% إنسان ، إن الفتى مع الفتن(@)(@@) 3 ودم على غيرة الصبا أبدا ، %~% ولا تغر في الشباب ثم تني(@)(@@) 4 كأنما الحادثات ، في الآفاق ، %~% فاق بعض السحائب الهتن(@)(@@) 5 ما ختن القوم باختيارهم ، %~% إذا جلبوا من طراز أو ختن(@)PageV01P1731(@)(@@) البحر : خفيف تام(@)(@@) 1 نحن قطنية ، وصوفية أن %~% أنتم ، فقطني من التجمل قطني(@)(@@) 2 تقطعون البلاد بطنا وظهرا ؛ %~% إنما سعيكم لفرج وبطن(@)(@@) 3 حاطني خالقي ، فعشت ، ولولا %~% خوفه ، قلت : ليته لم يحطني(@)(@@) 4 جسدي خرقة تخاط إلى الأرض %~% فيا خائط العوالم خطني(@)PageV01P1732(@)(@@) البحر : خفيف تام(@)(@@) 1 عيشتي سلتي ورمسي غمدي %~% فاقربوني فيه ولا تقربوني(@)(@@) 2 زبنتنا عن درها أم دفر %~% فصفوها بالحيزبون الزبون(@)(@@) 3 ورأيت البقاء فيها وإن مد %~% د ، لوشك الحمام كالعربون(@)(@@) 4 إن في الشر ، فاعلموه ، خيارا ، %~% وحبون الرجال فوق الحبون(@)(@@) 5 ليس حال المخبول فيما يلاقي %~% مثل حال المطوي والمخبون(@)(@@) 6 
ms373	 وهم الناس ، والحياة لهم سو %~% ق ، فمن غابن ومن مغبون(@)(@@) 7 هرم البازل الذي يحمل العبء %~% فأمسى يعزه ابن اللبون(@)(@@) 8 كم قطعنا من حندس ونهار %~% وكأن الزمان في ديدبون(@)(@@) 9 فرعى الله جيرة ما تناءوا %~% عن رحيب لبانه ملبون(@)(@@) 10 أطربوني وما ابن سبرة في %~% السبرة إلا منية الأطربون(@)PageV01P1733(@)(@@) البحر : -(@)(@@) 1 جير ، إن الفتى لفي النصب %~% ظم ، بين الأهلين والجيران(@)(@@) 2 وجران الجواد كالحتف للهارب %~% قدام ثائر حران(@)(@@) 3 أنا أدراني الرشاد بأن الإ %~% الإنس مخلوقة من الأدران(@)(@@) 4 إن يكن أبرأ القضاء الضنى %~% و براني من بعد ما أبراني(@)(@@) 5 لا كرى نائم بجفني ولا أعملت %~% ر ، فتنة بكران(@)(@@) 6 قد أراني القياس أن ليوث ال %~% فيما ينوب مثل الأراني(@)(@@) 7 لاكرى نائم بجفني ، ولا أع %~% لنفس مع الردى من قران(@)(@@) 8 كم جبال من الجيوش ترادى %~% والذي أوضعت له الحجران(@)(@@) 9 مر آن من الزمان على الشخ %~% فقد خلت أن دهرا مراني(@)(@@) 10 وعراني خطب أراد العراني %~% بذل ، وكلها في عران PageV01P1734(@)(@@) 11 زعم الناس أن قوما من الأب %~% عولوا في الجو بالطيران(@)(@@) 12 ومشوا فوق صفحة الماء ، هذا الإف %~% ك ، هيهات ما جرى العصران(@)(@@) 13 ما مشى فوق لجة البحر لا السعدان ، %~% دان ، فيما مضى ، ولا العمران(@)(@@) 14 أقراني ذاك المضيف ما أك %~% والله غالب الأقران(@)(@@) 15 لم أبت غافلا فأشراني الحرص %~% إلى أن أعود كالأشران(@)PageV01P1735(@)(@@) البحر : متقارب تام(@)(@@) 1 أواني هم وألقى أواني %~% وقد مر في الشرخ والعنفوان(@)(@@) 2 وضعت بواني في ذلة ، %~% وألقيت للحادثات البواني(@)(@@) 3 ثواني ضيف فلم أقره %~% أوائل من عزمتي ، أو ثواني(@)(@@) 4 فيا هند وان عن المكرمات %~% من لا يساور بالهندواني(@)(@@) 5 زواني صبري فأضحت إلي %~% عيون ، على غفلات ، رواني(@)(@@) 6 عواني قضاء ، دوين المراد ، %~% وما بكر شأنك مثل العوان(@)(@@) 7 وهل جعل الشائمات الوميض %~% تواني ، غير اتصال التواني ؟(@)(@@) 8 فما لركابك هذي الوقوف %~% عدا حادييها ، الذي يرجوان(@)(@@) 9 حواني للورد أعناقها ، %~% وما علمت أي وقت حواني(@)(@@) 10 ولم يلق في 
ms374	 دهره أجربي %~% هواني ، فلينأ عني هواني PageV01P1736(@)(@@) 11 وعندي سر بذي الحديث %~% كنت عنه في العالمين الغواني(@)(@@) 11 إذا رملة لم تجىء بالنبات ، %~% فقد جهلت إن سقتها السواني(@)(@@) 12 جريت مع الدهر جري المطيع ، %~% بين اللياحي والأرجواني(@)(@@) 13 كأن في العيش لدن الغصون %~% من شاء قومني أو لواني(@)(@@) 14 ولا لون للماء ، فيما يقال ، %~% ولكن تلونه بالأواني(@)(@@) 15 وفي كل شر دعته الخطوب %~% شواسع منفعة أو دواني(@)(@@) 16 وأجزاء ترياقهم لا تتم ، %~% إلا بجزء من الأفعوان(@)(@@) 17 فلا تمدحاني يمين الثناء ، %~% فأحسن من ذاك أن تهجوني(@)(@@) 18 فإني من فكرتي والقضاء %~% ما بين بحرين لا يسجوان(@)(@@) 19 وإن النهار ، وإن الظلام ، %~% على كل ذي غفلة يدجوان PageV01P1737(@)(@@) 20 وكيف النجاء وللفرقدين %~% فضل ، وآليت لا ينجوان(@)(@@) 21 فلم تطلبا شيمتي ناشئين %~% وعما لطفت له تجفوان(@)(@@) 22 فإن تقفوا أثري تحمدا ؛ %~% وإن تعرفا النهج لا تقفوان(@)(@@) 23 زواني خوف المقام الذمي %~% ونادى بغفرانها تصفوان(@)(@@) 24 فلن تقذيا باغتفار الذنوب ، %~% ولكن بغفرانها تصفوان(@)(@@) 25 ولولا القذى طرتما في الهواء ، %~% وفي اللج ألفيتما تطفوان(@)(@@) 26 فكونا مع الناس كالبارقين %~% تعمان بالنور ، أو تخفوان(@)(@@) 27 فلم تخلقا ملكي قدرة ، %~% إذا ما هفا الإنس لا تهفوان(@)(@@) 28 ألم تريا عصري دهرنا %~% يؤودان بالثقل أو يأدوان ؟(@)(@@) 29 وما فتئ الفتيان الحياة %~% يروحان بالشر ، أو يغدوان PageV01P1738(@)(@@) 30 عدوان ما شعرا بالحمام %~% فكيف تظنهما يعدوان ؟(@)(@@) 31 ألا تسمع الآن صوتيهما %~% بكل امرىء فيهما يحدوان ؟(@)(@@) 32 وما كشف البحث سريهما %~% وما خلت أنهما يبدوان(@)(@@) 33 وكم سروا عالما أولا ، %~% وما سروا فمتى يسروان(@)(@@) 34 وبينهما أهلك الغابرين %~% ما يقربان وما يقروان(@)(@@) 37 إذا ما خلا شبحي منهما ، %~% فما يقفران ، ولا يخلوان(@)(@@) 38 قلينا البقاء ، ولم يبرحا %~% بنا ، في مراحله ، يقلوان(@)(@@) 39 وكم أجليا عن رجال مضوا %~% وأخبار ما كان لا يجلوان(@)(@@) 40 كما خلقا غبرا في العصور %~% لا يرخصان ولا يغلوان(@)(@@) 41 تمر وتحلو لنا الحادثات %~% وما يمقران ولا يحلوان PageV01P1739(@)(@@) 42 إذا تلوا عظة فالأنام %~% لا يأذنون لما يتلوان(@)(@@) 43 مغذان بالناس 
ms375	 لا يلغبان %~% وسيفان لله لا ينبوان(@)(@@) 44 ولو خلقا مثل خلق الجياد ، %~% رأيتهما ، في المدى ، يكبوان(@)(@@) 45 لعلكما ، إن تهب الصبا ، %~% إلى بلد نازح تصبوان(@)(@@) 46 فلا ريب أن الذي تحبيا %~% أفضل منه الذي تحبوان(@)(@@) 47 فعيشا أبيين للمخزيا %~% ت ، مثل السماكين لا تأبوان(@)(@@) 48 إذا شبت الشعريان الوقود %~% ففي الحكم أنهما تخبوان(@)(@@) 49 وكونا كريمين بين الأنيس %~% لا تنملان ولا تأثوان(@)(@@) 50 إذا الخل أعرض لم تلفيا ، %~% لسوء أحاديثه ، تنثوان(@)(@@) 51 وإن لم تهيلا إلى معدم %~% طعاما ، فيكفيه ما تحثوان PageV01P1740(@)(@@) 52 وجهل مرادكما في المقيظ %~% عهدا من الورد والأقحوان(@)(@@) 53 وما الحاديان سوى جندبين %~% ن ، في حر هاجرة ينزوان(@)(@@) 54 وما أمن البازيان القصاص ، %~% وأن يؤخذا بالذي يبزوان(@)(@@) 55 فإن تهملا كل ما تخزنان %~% فلم يأت بالخزي ما تخزوان(@)(@@) 56 %~% تروعان قوما بما تحزوان(@)(@@) 57 ونصا ، إلى الله ، مغزاكما ، %~% فذلك أفضل ما تغزوان(@)(@@) 58 ولا تعزوا الخير إلا إليه %~% فيجني الشفاء بما تعزوان(@)(@@) 59 وإن عريت كاسيات الغصو %~% ن ، فلتكس بالدفء من تكسوان(@)(@@) 60 وضنا بعمركما أن يضيع ، %~% ولا تفنيا وقته تلهوان(@)(@@) 61 بذكر إلهكما ، فأبها ، %~% لعلكما بالتقى تبهوان PageV01P1741(@)(@@) 62 فيا رب طاهي صلال يبيت ، %~% متخذا طعمه ، يطهوان(@)(@@) 63 وسيرا وساعين في المكرمات %~% لا تدلجان ولا تقطوان(@)(@@) 64 مطا بكما قدر لا يزال %~% جديداه ، في غفلة ، يمطوان(@)(@@) 65 فويح لخاطئتي مارد ، %~% تنصان في ما له تخطوان(@)PageV01P1742(@)(@@) البحر : سريع(@)(@@) 1 يا شائم البارق ! لا تشجك ال %~% أظعان ، فوضن إلى أرض ببن(@)(@@) 2 أبن إلى الأوطان في عازب ال %~% روض ، فما وجدك لما أببن ؟(@)(@@) 3 يسببن بالفعل ، فأما إذا %~% الموعود لا كان صلاء شببن(@)(@@) 4 صببن في الوادي إلى قرية %~% غناء لكن بالهوى ما صببن(@)(@@) 5 يسببن بالفعل فأما بما %~% قيل فما يعلمن يوما سببن(@)(@@) 6 يحملها العيس ، ومن حولها الشر %~% ب ، قربن ضحى ، أو خببن(@)(@@) 7 مها نقاء لا مها في نقا ، %~% رببن في ظل قنا ، أو رببن(@)(@@) 8 عقارب قاتلة من منى %~% على لساني وضميري دببن(@)(@@) 9 آه من 
ms376	 العيش وإفراطه ، %~% ورب أيد في بقاء تببن(@)(@@) 10 تذكرني راحة أهل البلى %~% أرواح ليل بخزامى هببن PageV01P1743(@)(@@) 11 لا تأمن الدهر وتحويله الملك %~% ك إلى آل إماء ضببن(@)(@@) 12 إن اللبيبات إذا ملن للدنيا %~% وألغين التقى ما لببن(@)(@@) 13 وفي مزيج الراح ، أو في صريح ال %~% رسل ، والعام جديب عببن(@)PageV01P1744(@)(@@) البحر : -(@)(@@) 1 ضمكم جنس ، وأزرى بكم %~% قنس ، وأنتم في دجى تخبطون(@)(@@) 2 حفرتم صخرا ، وأنبطتم %~% ماء ، فهلا العلم تستنبطون(@)(@@) 3 بعضكم يقتل بعضا كأن %~% جوزيتم عن غنم تعبطون(@)(@@) 4 رابطتم الثغر بأفراسكم ، %~% وقوفكم في العقل ما تربطون(@)(@@) 5 لم ترزقوا خيرا ، ولم تعدموا %~% شرا ، فما بالكم تغبطون ؟(@)(@@) 6 ظن ارتقاء بكم جاهل ، %~% وكلكم في صبب تهبطون(@)(@@) 7 ضبطتم المال ، ولكن ما %~% يجمح بالإنسان ما تضبطون(@)(@@) 8 لم تقتنوا مجدا ، وأصبحتم %~% قن فروج لكم أو بطون(@)PageV01P1745(@)(@@) البحر : -(@)(@@) 1 كم آية يؤنسها معشر %~% فلا يبالون ، ولا يتقون(@)(@@) 2 في هوة خطوا ، ومن رأيهم %~% أنهم ، في رفعة ، يرتقون(@)(@@) 3 وهم أسارى في يدي عيشهم %~% لعلهم عند الردى يعتقون(@)(@@) 4 ما أغدر الدهر وأبناءه %~% لأنهم من بحره يستقون(@)(@@) 5 كم ظلم الأقوام أمثالهم %~% ثمت بادوا ، فمتى يلتقون ؟(@)PageV01P1746(@)(@@) البحر : -(@)(@@) 1 كل واشرب الناس على خبرة %~% فهم يمرون ولا يعذبون(@)(@@) 2 ولا تصدقهم إذا حدثوا %~% فإنني أعهدهم يكذبون(@)(@@) 3 وإن أروك الود عن حاجة %~% ففي حبال لهم يجذبون(@)PageV01P1747(@)(@@) البحر : -(@)(@@) 1 قد غدت النحل إلى نورها %~% ويحك يا نحل لمن تكسبين(@)(@@) 2 يجيء مشتار بآلاته ، %~% فيلسب ألأري ولا تلسبين(@)(@@) 3 أتحسبين العمر علما به %~% لا بل تعيشين ولا تحسبين(@)(@@) 4 هل لك بالآباء من خبرة ، %~% كم والد في زمن تنسبين(@)(@@) 5 أتحسبين الدهر ذا غفلة %~% هيهات ! ما الأمر كما تحسبين !(@)PageV01P1748(@)(@@) البحر : -(@)(@@) 1 سنك خير لك من درة %~% زهراء تعشي أعين الناظرين(@)(@@) 2 عجبت للضارب في غمرة ، %~% لم يطع الناهين والآمرين(@)(@@) 3 يكسر باللؤلؤ ، من جهله ، %~% خشبا عتت في أنمل الكاسرين(@)(@@) 4 من كان من أسراه مال له %~% فلست ، للمال ، من الآسرين(@)(@@) 5 أعد أسنى الربح فعل التقى ، %~% فلا 
ms377	 أكن _ رب _ من الخاسرين(@)PageV01P1749(@)(@@) البحر : -(@)(@@) 1 مضى زماني وتقضى المدى %~% فليتني وفقت في ذا الزمين(@)(@@) 2 أرزمت الناب وعارضتها %~% فليعجب السامع للمرزمين(@)(@@) 3 أمطرنا الله بإحسانه %~% لا أنسب الغيث إلى المرزمين(@)(@@) 4 ليت دموعي بمنى سيلت %~% ليشرب الحجاج من زمزمين(@)PageV01P1750(@)(@@) البحر : -(@)(@@) 1 إن شئتما أن تنسكا ، فاسكنا ، %~% وأنفقا المال الذي تمسكان(@)(@@) 2 واعتقدا في حال تقواكما %~% أنكما بالله لا تشركان(@)(@@) 3 إن تتبعا في مذهب جاهلا ، %~% فالحق ، من خلقكما ، تتركان(@)(@@) 4 وتطلبان الأمر يعييكما %~% وتفنيان العمر لا تدركان(@)(@@) 5 لم يفد سابورا ولا تبعا %~% ما وجدا من ذهب ، يملكان(@)(@@) 6 ونير الليل وشمس الضحى %~% داما ولكنهما يهلكان(@)(@@) 7 سبحان من سخر نجم الدجى %~% والبدر في قدرته يسلكان(@)(@@) 8 هذا الفتى أوقح من صخرة ، %~% يبهت من ناظره حيث كان(@)(@@) 9 ويدعي الإخلاص في دينه ، %~% وهو عن الإلحاد في القول كان(@)(@@) 10 يزعم أن العشر ما نصفها %~% خمس ، وأن الجسم لا في مكان(@)PageV01P1751(@)(@@) البحر : سريع(@)(@@) 1 كم صرف المولود ، عن والد ، %~% خيرا ، وكم أم له لم يمن(@)(@@) 2 والربع للزوجة إن لم يكن %~% نسل ، فإن كان غدت بالثمن(@)(@@) 3 والزوج يزوي النصف أبناؤه %~% عنه ، وفي الدهر خطوب كمن(@)(@@) 4 قال أناس باطل زعمهم %~% فراقبوا الله ولا تزعمن(@)(@@) 5 فكر يزدان على غرة %~% فصيغ من تفكيره أهرمن(@)PageV01P1752(@)(@@) البحر : متقارب تام(@)(@@) 1 لقد فقد الخير من الأنام %~% والشر في كل وجه يعن(@)(@@) 2 أعن بجميل إذا ما حضرت %~% وعد بالسكوت إذا لم تعن(@)(@@) 3 وإن جاءك الموت ، فافرح به ، %~% لتخلص من عالم قد لعن(@)(@@) 4 هم ضربوا حيدرا ساجدا ، %~% وحسبك من عمر ، إذ طعن(@)PageV01P1753(@)(@@) البحر : طويل(@)(@@) 1 لعمري لخير الذخر في كل شدة %~% إلهك ترجو فضله وألاه(@)(@@) 2 وإن نلت في دنياك ، للجسم ، نعمة %~% من العيش ، فاذكر دفنه وبلاه(@)(@@) 3 فلا تشبه الوحشي خلف طفله %~% لخنساء ، ترعى ، بالمغيب ، طلاه(@)(@@) 4 إذا اختصمت في سيء الفعل وابنها %~% فلا هي من أهل الحقوق ولا هو(@)(@@) 5 متى يصرم الخل المسيء ، فلا ترع ، %~% فأفضل من 
ms378	 وصل اللئيم قلاه(@)(@@) 6 وكم غيب الإلف الشقيق أليفه ، %~% فريع له الأيام ثم سلاه(@)(@@) 7 وما كان حادي العيس في غربة النوى %~% علي ، كحادي النجم حين قلاه(@)(@@) 8 ومن يحلف الأيمان بالله ، ولا ونى %~% عن الود يحنث أو يضره ألاه(@)(@@) 9 ومن ترك العلج المعرد ، راتعا %~% بأفيح ، يقرو في الخلاء خلاه(@)(@@) 10 وقد كلأ المسكين ، في الورد ، بائس ، %~% ومن كبد القوس الكتوم كلاه PageV01P1754(@)(@@) 11 فطلق عرسا كارها وفلا الردى %~% لها تولبا لم يمتنع بفلاه(@)(@@) 12 فلا تقر هم النفس عجزا عن القرى %~% وأدلج ، إذا ما الركب مال طلاه(@)(@@) 13 طوى عنك ، سرا ، صاحب ، قبل شيبه ، %~% فلما انجلى عنه الشباب جلاه(@)(@@) 14 ولا ملك إلا للذي عز وجهه %~% ودامت على مر الزمان علاه(@)(@@) 15 وقد يدرك المجد الفتى وهو مقتر %~% كثير الرزايا مخلق سملاه(@)(@@) 16 غدا جملاه يرقلان بكوره ، %~% وهل غير عصري دهره جملاه ؟(@)(@@) 17 وما فتلاه عن سجاياه بعدما %~% أجاد كتابا محكما ، فتلاه(@)(@@) 18 فإن مات ، أو غاداه قتل ، فما هما %~% أماتاه _ في حكمي _ ولا قتلاه(@)(@@) 19 يد حملت هذا الأنام عليهما %~% لولا يمين الله ما احتملاه(@)(@@) 20 وعاءان للأشياء ، ما شذ عنهما %~% قليل ، ولا ضاقا بما شملاه PageV01P1755(@)(@@) 21 وجاء بمين مدع ، جاء زاعما %~% بأنهما عن حاجة ختلاه(@)(@@) 22 عجبت لرامي النبل يقصد آبلا ، %~% بجهل ، وقد راحت له إبلاه(@)(@@) 23 بدا عارضا خير وشر لشائم %~% وما ستويا في الخطب إذ وبلاه(@)(@@) 24 زجرتهما زجر ابن سبع سباعه %~% ولو فهما زجري لما قبلاه(@)(@@) 25 تهاوى جبال من كنانة غالب ، %~% وأبطحها لم ينتقل جبلاه(@)(@@) 26 إذا النسل أسواه الأب ، اهتاج أنه %~% يموت ، ويبقى ماله وحلاه(@)(@@) 27 فكم ولد ، للوالدين ، مضيع ، %~% يجازيهما بخلا بما نجلاه(@)(@@) 28 طوى عنهما القوت الزهيد ، نفاسة ، %~% وجراه سارا الحزن وارتحلاه(@)(@@) 29 يرى فرقدي وحشية بدليهما %~% وما فرقدا مسراهما بدلاه(@)(@@) 30 أساء ، فلم يعد لهما بشراكه ، %~% وكانا بأنوار الدجى عدلاه PageV01P1756(@)(@@) 31 يعيرهما طرفا من الغيظ شافنا %~% كأنهما ، فيما مضى ، تبلاه(@)(@@) 32 ينام ، إذا ما أدنفا ، وإذا سرى 
ms379	 %~% له الشكو باتا ، الغمض ما اكتحلاه(@)(@@) 33 إن ادعيا في وده الجهد صدقا %~% وما اتهما فيه ، فينتحلاه(@)(@@) 34 يغشهما في الأمر هان ، وطالما %~% أفاءا عليه النصح ، وانتخلاه(@)(@@) 35 يسرهما أن يهجر الريم دهره %~% وأنهما من قبله نزلاه(@)(@@) 36 ولو بمشار العين يوحى إليهما %~% لوشك اعتزال العيش ، لاعتزلاه(@)(@@) 37 يودان إكراما لو انتعل السهى %~% وإن حذيا السلاء وانتعلاه(@)(@@) 38 يذم لفرط الغي ما فعلا به %~% وأحسن وأجمل بالذي فعلاه(@)(@@) 39 يعدانه كالصارم العضب في العدى %~% بظنهما ، والذابل اعتقلاه(@)(@@) 40 ويؤثر بالسر الكنين سواهما %~% فينقله عنه وما نقلاه(@)PageV01P1757(@)(@@) البحر : بسيط تام(@)(@@) 1 أعوذ بالله من قوم إذا سمعوا %~% خيرا أسروه ، أو شرا أذاعوه(@)(@@) 2 ما حم كان ، ولم تدفعه مشفقة %~% ويفعل الأمر ، في الدنيا ، مطاعوه(@)(@@) 3 إن النجاشي نال الملك ، عن قدر ، %~% برغم ناس لبعض التجر باعوه(@)(@@) 4 وخالد بن سنان ليس ينقصه ، %~% من قدره الكون في حي أضاعوه(@)(@@) 5 ما لي رأيت دعاة الغي ناطقة ، %~% والرشد يصمت ، خوف القتل ، داعوه(@)(@@) 6 لا يفرحن بمولود ذوو شرف ، %~% فإنما بشراء الطفل ناعوه(@)(@@) 7 كذلك الدهر عنى من يصاحبه %~% ولم يعد ، بسوى الخسران ، ساعوه(@)(@@) 8 والله حق ماجت ظنونكم %~% وإن أوجب شيء أن تراعوه(@)PageV01P1758(@)(@@) البحر : بسيط تام(@)(@@) 1 قد ينصف القوم في الأشياء سيدهم %~% ولو أطاقوا له ريبا لرابوه(@)(@@) 2 لم يقدروا أن يلاقوه بسيئة %~% من الكلام فلما غاب عابوه(@)(@@) 3 تحدثوا بمخازيه مكتمة %~% وقابلوه بإجلال وهابوه(@)(@@) 4 وكم أرادوا له كيدا بيوم ردى %~% من الزمان ، ولكن ما أصابوه(@)(@@) 5 أكدى فلاموه لما قل نائله %~% ولو حبا الوفر زاروه ونابوه(@)(@@) 6 صبرا قليلا فإن الموت آخذه %~% وما يخلف لا صقر ولا بوه(@)(@@) 7 لبى الغني بنو حواء ، من طمع ، %~% ولو دعاهم فقير ما أجابوه(@)PageV01P1759(@)(@@) البحر : وافر تام(@)(@@) 1 قد اختل الأنام بغير شك ، %~% فجدوا في الزمان وألعبوه(@)(@@) 2 وظنوا أن بوه الطير صقر ، %~% بجهلهم ، وأن الصقر بوه(@)(@@) 3 وودوا العيش في زمن خؤون %~% وقد عرفوا أذاه وجربوه(@)(@@) 4 وينشأ ناشئ الفتيان منا %~% على ما 
ms380	 كان عوده أبوه(@)(@@) 5 وما دان الفتى بحجى ، ولكن %~% يعلمه التدين أقربوه(@)(@@) 6 وطفل الفارسي له ولاة ، %~% وكم سأل الفقير ، فخيبوه(@)(@@) 7 وضم الناس كلهم هواء %~% يذلل بالحوادث مصعبوه(@)(@@) 8 لعل الموت خير للبرايا %~% وإن خافوا الردى وتهيبوه(@)(@@) 9 أطاعوا ذا الخداع وصدقوه ، %~% وكم نصح النصيح فكذبوه(@)(@@) 10 وجاءتنا شرائع كل قوم %~% على آثار شيء رتبوه PageV01P1760(@)(@@) 11 وغير بعضهم أقوال بعض %~% وأبطلت النهى ما أوجبوه(@)(@@) 12 فلا تفرح إذا رجبت فيهم %~% فقد رفعوا الدني ورجبوه(@)(@@) 13 وبدل ظاهر الأسلام رهط %~% أرادوا الطعن فيه وشذبوه(@)(@@) 14 وما نطقوا به تشبيب أمر %~% كما بدأ المديح مشببوه(@)(@@) 15 ويذكر أن في الأيام يوما %~% يقوم من التراب مغيبوه(@)(@@) 16 وما يحدث ، فإنا أهل عصر ، %~% قليل ، في المعاشر ، منجبوه(@)(@@) 17 صحبنا دهرنا كرها ، وقدما %~% رأى الفضلاء ألا يصحبوه(@)(@@) 18 وغيظ به بنوه وغيظ منهم %~% فعذب ساكنيه وعذبوه(@)(@@) 19 ومن عاداته في كل جيل %~% غذاه أن يقل مهذبوه(@)(@@) 20 أساء بغيه أدبا عليهم ، %~% فهل من حيلة ، فيؤدبوه ؟ PageV01P1761(@)(@@) 21 وما يخشى الوعيد ، فيوعدوه ؛ %~% ولا يرعى العتاب فيعتبوه(@)(@@) 22 فهل ترجى الكرامة من أوان %~% فقد أكل الغزال مرببوه(@)(@@) 23 وهم من وقتهم أبغى وأطغى %~% على أي المذاهب قلبوه ؟(@)(@@) 24 أجلوا مكثرا ، وتنصفوه ؛ %~% وعابوا من أقل ، وأنبوه(@)(@@) 25 ولم يرضوا ، لما سكنوه ، شيدا ، %~% إلى أن فضضوه وأذهبوه(@)(@@) 26 فإن يأكلهم أسفا وحقدا(@)(@@) 27 وتلك الوحش ما جادوا عليها %~% بعشب ، غب ند عشبوه(@)(@@) 28 يسور الكلب مجتهدا إليها ، %~% ويحظى بالقنيص مكلبوه(@)(@@) 29 وما شأن اللبيب بغير سلم ، %~% وإن شهد الوغى متلببوه(@)(@@) 30 ألظوا بالقبيح فتابعوه %~% ولو أمروا به لتجنبوه PageV01P1762(@)(@@) 31 نهاهم عن طلاب المال زهد %~% ونادى الحرص : ويبكم اطلبوه(@)(@@) 32 فألقاها إلى أسماع غثر ، %~% إذا عرفوا الطريق تنكبوه(@)(@@) 33 سعوا بين اقتراب واغتراب %~% يموت بغصة متغربوه(@)(@@) 34 غدوا قوتا لمثلهم تساوى(@)(@@) 35 مضت أمم على شرخ الليالي ، %~% إذا عمدوا لعقد أربوه(@)(@@) 36 وكم تركوا لنا أثرا منيفا %~% يعود بآية متأوبوه(@)(@@) 37 لقد عمروا ، وأقسمت الرزايا ؛ %~% لبئس الرهط رهط خربوه(@)(@@) 38 