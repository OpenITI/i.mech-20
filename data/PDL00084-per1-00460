ms441	(@)(@@) 57 همیشه تا به ملوک اعتکاف پیشه گدایان %~% به روز معرکه بخشند جوشنی به دعائی(@)(@@) 58 پناه جان تو باد آن دعا که تا به قیامت %~% از آن گذر نتواند نمود تیر قضائی PageV1P687(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بر اشراف این عید و آن کامکاری %~% مبارک بود خاصه بر شهریاری(@)(@@) 2 کزین گوهر افسر سر بلندی %~% مهین داور کشور نامداری(@)(@@) 3 معین ملل کز ازل قسمتش زد %~% به بخت همایون در بختیاری(@)(@@) 4 قضا صولتی کاسمان سده‌اش را %~% کند بوسه کاری به صد خاکساری(@)(@@) 5 قدر قدرتی کز صفات کمینش %~% یکی نام دارد سپهر اقتداری(@)(@@) 6 به جنب نعالش که پایان ندراد %~% کجا در حسابست عالم مداری(@)(@@) 7 در اطراف صیتش چو باد است پویان %~% بر اشراف حکمش چو آبست جاری(@)(@@) 8 چو او کس نکرد از خدا بندگان هم %~% الا ای به خلق آیت رستگاری(@)(@@) 9 به آن کبریا و شکوه و جلالت %~% حلیمی و بی‌کبری و بردباری(@)(@@) 10 ازل تا ابد از خرابیست ایمن %~% بنای جلالت ز محکم حصاری(@)(@@) 11 ازین هم فزون پایه دولتت را %~% ز دارای تو عهد باد استواری(@)(@@) 12 گل گلشن شهریاری علیخان %~% که در فیض باریست ابر بهاری(@)(@@) 13 جلیل اختر برج عالی مکانی %~% جلی سکه نقد کامل عیاری(@)(@@) 14 شمارند صاحب شعوران دوران %~% زادنی صفاتش حکومت شعاری(@)(@@) 15 ضمیریست در صبح نو عهدی او را %~% فرزوان تر از آفتاب نهاری(@)(@@) 16 سپهر از برایش عروس جهان شد %~% به عقد دوام است در خواستگاری(@)(@@) 17 زند ابرش اندر عنان قره هرگه %~% که طبعش کند میل ابرش سواری(@)(@@) 18 جز این از وقارش نگویم که او را %~% هجائی و ذمیست گردون وقاری(@)(@@) 19 طویل البقا باد عزمش که عالم %~% به او تا ابد دارد امیدواری(@)(@@) 20 جهان داورا محتشم بنده تو %~% که لال است در شکر نعمت گذاری(@)(@@) 21 ازین نظم مقصودش اینست کورا %~% نه از سلک مدحت فروشان شماری(@)(@@) 22 ز دنبال هم داد صد 
ms442	 غوطه او را %~% نوال تو در لجه شرمساری(@)(@@) 23 مسازش طمع پیشه ترسم برآید %~% سر عزتش از گریبان خواری(@)(@@) 24 به جان آفرینی که در آفرینش %~% تو را داد این امتیازی که داری(@)(@@) 25 به بطحایئیی کایزدش خواند احمد %~% تو را نیز نگذاشت زان رتبه عاری(@)(@@) 26 به خیبر گشائی که از خیل خاصان %~% تو را داد در شهر خود شهریاری(@)(@@) 27 که گر بگذرانی سرم را ز گردون %~% و گر مغزم از کاسه سر برآری(@)(@@) 28 سر موئی از من نیابی تفاوت %~% در اخلاص و دلسوزی و جان سپاری(@)(@@) 29 دعائیست بر لب یقین الاجابه %~% که حاجت ندارد بالحاح و زاری(@)(@@) 30 بود تا تو را شیوه دیوان نشینی %~% بود تا مرا پیشه دیوان نگاری(@)(@@) 31 در اوصافت ای صدر دیوان نشینان %~% نی کلک من باد در شهد باری PageV1P688(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 درین ضعف آن قدر دارم ز بیماری گر انباری %~% که بر بومی که پهلو می‌نهم قبریست پنداری(@)(@@) 2 ز بیماری چنان با خاک یکسانم که از خاکم %~% اجل هم برنمی‌دارد معاذالله ازین خواری(@)(@@) 3 مرا حالیست زار ای دوستان ز انسان که دشمن هم %~% به حالم زار می‌گرید مبادا کس به این زاری(@)(@@) 4 دل من تا نشد افکار عالم را نشد باور %~% که یک دل می‌تواند بود و صد عالم دل‌افکاری(@)(@@) 5 چنان بازاری دل الفتی دارم درین کلفت %~% که عیش از صحبت من می‌نویسد خط بیزاری(@)(@@) 6 عجب حالیست حال من که در آیینه دوران %~% نمی‌بینم ز یک تن صورت غم‌خواری و یاری(@)(@@) 7 کدامین بنده‌ام من بنده صاحب ستاینده %~% کدامین صاحبست این صاحب شان جهانداری(@)(@@) 8 ولیعهد محمدخان ولی سلطان دریادل %~% که سیری نیست ابر دست او را از درم باری(@)(@@) 9 مطاع الحکم سلطانی که طبعش گر بفرماید %~% شود نار از شجر ثابت شود آب از حجر جاری(@)(@@) 10 بدیع‌الامر دارائی که گر خواهد به فعل آید %~% ز آب اندر مشارب مستی و 
ms443	 از باده هشیاری(@)(@@) 11 مشابه بزم و رزم او به بزم و رزم فغفوری %~% مماثل لطف و قهر او به لطف و قهر جباری(@)(@@) 12 جهان در قبضه تسخیر او بادا که بیش از حد %~% به آن کشورستان دارد جهان امید غم‌خواری(@)(@@) 13 بود تا حشر ارزانی به مسکینان و مظلومان %~% که هم مسکین نوازی می‌کند هم ظالم‌آزاری(@)(@@) 14 جفاگستر به فریاد است ازو اما نمی‌داند %~% که عدلست از سلاطین بر ستمکاران ستمکاری(@)(@@) 15 نمی‌ماند برای جغد جائی جز دل ظالم %~% چو یابد دهر معموری ازین شاهانه معماری(@)(@@) 16 به رقص آمد ز شادی آسمان چون دهر پاکوبان %~% به نامش در زمین زد کوس سرداری و سالاری(@)(@@) 17 چو گردد تیغ نازک پیکر او در دغا عریان %~% شود صد کوه پیکر از لباس زندگی عاری(@)(@@) 18 به حرب او بیا گو خصم تن‌پرور که می‌آید %~% به مهمان کردن شیر شکاری گاو پرواری(@)(@@) 19 عبوری بس از آن آتش عنان بر خرمن اعدا %~% که هست اجزای ذات وی تمام از عنصر ناری(@)(@@) 20 کند بوس لب تیغش بر اندام برومندان %~% به بزم و رزم کار صد هزاران ضربت کاری(@)(@@) 21 محل گیرودار او که خونش می‌رود از تن %~% کشد سیمرغ را دام عناکب در گرفتاری(@)(@@) 22 دو روزی گو لوای خصم او میسا به گردون سر %~% که دارد همچو نخل ریشه کن زود در نگونساری(@)(@@) 23 سلاطین سرورا با آن که هرگز حرفی از شکوه %~% نگشته بر زبان شکرگوی نطق من جاری(@)(@@) 24 شکایت گونه‌ای دارم کنون اما ز صد جزوش %~% یکی معروض می‌دارم گرم معذور می‌داری(@)(@@) 25 تو را آن بنده بودم من که چون بر مسند دولت %~% نشینی شاد و مملوکان خود را در شمار آری(@)(@@) 26 نپردازی به حال من نپرسی حال من از کس %~% نه از ارسال پیغامی مرا از خاک برداری(@)(@@) 27 نگوئی زنده است آن بنده رنجور مایانه %~% مرا با آن که باشد نیم‌جانی مرده 
ms444	 انگاری(@)(@@) 28 فرستم نظم و نثری هم که خواهد عذر تقصیرم %~% ز بی‌قدری تو این را خاک و آن را باد پنداری(@)(@@) 29 ندارد محتشم زین بیش تاب درد دل گفتن %~% مگر زین بیشتر باید ز بیماری سبکباری(@)(@@) 30 بود تا استراحت جو سر از بالین تن از بستر %~% درین جنبنده مهد مختلف اوضاع زنگاری(@)(@@) 31 تن بستر فروزت باد دور از بستر کلفت %~% سر افسر فرازت ایمن از بالین بیماری PageV1P689(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بده داد طرب چون شد بلند از لطف ربانی %~% به نامت خطبه دولت برایت رایت خانی(@)(@@) 2 علم برکش چو استعداد فطری بی‌طلب دادت %~% مکین حکم و تاج سروری و چتر سلطانی(@)(@@) 3 به عشرت کوش کز هر گوشه می‌بینم چو ماه نو %~% صراحی گردنان رابر زمین پیش تو پیشانی(@)(@@) 4 تو شاخ دولتی بنشین درین بستان سرا چندان %~% به عیش و خرمی کز زندگانی داد بستانی(@)(@@) 5 چو احسان را به همت قیمت ارزان کرده‌ای بادت %~% سپاه و جاه و حکم و ملک و مال و منصب ارزانی(@)(@@) 6 عروس ملک چون می‌بست پیمان وفا با تو %~% به دست عهدت اول توبه کرد از سست پیمانی(@)(@@) 7 جهان را با نی مثل تو می‌بایست از آن روزد %~% به نام نامیت دست جهان کوس جهانبانی(@)(@@) 8 چو در امکان نمیگنجی سخن‌سنجان چه گویندت %~% به سیرت عقل اول یا به صورت یوسف ثانی(@)(@@) 9 عجب نبود که گویم سایه خورشید افتاده %~% به این حجت که تو خورشیدی و در ظل یزدانی(@)(@@) 10 اگر معمار رایت دست از ضبط جهان دارد %~% نهد معموره عالم همان دم رو به ویرانی(@)(@@) 11 و گر معیار عدلت از میان تمییز بردارد %~% گدا در ملک سرداری کند سردار چوپانی(@)(@@) 12 بداندیشت به قید مرگ چون سگ در مرس ماند %~% به هر جانب که روز رزم شمشیر و فرس‌رانی(@)(@@) 13 عجب گنجیست عفوت خاصه کز خلق عظیم تو %~% به دست محرمان پیوسته می‌آید 
ms445	 به آسانی(@)(@@) 14 به غیر از من که دارم بد گناهی عذر از آن بدتر %~% ولی یک شمه می‌گویم از آن دیگر تو می‌دانی(@)(@@) 15 بود مریخ و خورشید آسمان کامکاری را %~% حسامت در سراندازی و دستت در زرافشانی(@)(@@) 16 مرا ظنی غلط دوش از قبول رشحه لطفت %~% ابا فرمود و راهم زد به یک وسواس شیطانی(@)(@@) 17 تصور کردم آن تریاق را در نشه دیگر %~% چه دانستم که خواهد بود یک سر فیض روحانی(@)(@@) 18 کشیدم دست از آن وز دست خود در آتش افتادم %~% چه آتش شعله آفت چه آفت قهر سلطانی(@)(@@) 19 پشیمانم پشیمانم که بر خود بی‌جهت بستم %~% ره لطف ز خود رائی و بی عقلی و نادانی(@)(@@) 20 مرا عقلی اگر می‌بود کی این کار می‌کردم %~% چرا عاقل کند کاری که باز آرد پشیمانی(@)(@@) 21 به تقریب این سخن مذکور شد باز آمدن کز جان %~% کنم در وادی مدح تو حسانی و سحبانی(@)(@@) 22 زهی رای قضا تدبیرت از حزم قدر قدرت %~% بلاد عدل را عامل بنای ملک را بانی(@)(@@) 23 اگر خورشید لطف ذره‌ای بر آسمان تابد %~% سها را کمترین پرتو بود خورشید نورانی(@)(@@) 24 و گر خود سایه قهرت زمانی بر زمین افتد %~% شود بی‌نور چون سنگ سیه لعل بدخشانی(@)(@@) 25 سهیل طلعتت گر عکس بر بحر و براندازد %~% خزف گردد عقیق‌تر حجر یاقوت رمانی(@)(@@) 26 درافشان چون شود بر تنگ‌دستان ابر دست تو %~% کند هر رشحه آن قلزمی هر قطره عمانی(@)(@@) 27 ید بیضا نماید رایتت در وادی نصرت %~% چه از فرعونی اعدا کند رمح تو ثعبانی(@)(@@) 28 عرق کز ابرشت بر خاک ریزد در دم جولان %~% کند در پیکر جسم جمادی روح حیوانی(@)(@@) 29 برات عمر اگر خواهد کسی رایت برای او %~% به حکم از قابض ارواح گیرد خط ترخانی(@)(@@) 30 به قدر دولتت گر طول یابد رشته دوران %~% زند دم از بقای جاودانی عالم فانی(@)(@@) 31 عجب گر بر قد 
ms446	 گیتی شود رخت بقا کوته %~% که ذیل دولتت آخر زمان را کرده دامانی(@)(@@) 32 اگر صد سال اید بر کمان کی در نشان آید %~% به قدر درک ادراک تو سهم و هم انسانی(@)(@@) 33 تو را نام از بزرگی در عبارت چون نمی‌گنجد %~% به توشیحش کنم در یک غزل درج از سخندانی(@)(@@) 34 صبوحی کرده می‌آئی بیا ای صبح نورانی %~% که برهانم شوی وز ظلمتم یکباره برهانی(@)(@@) 35 درین فکرم که چون ماند بدانجا گرد و جود من %~% اگر با این شکوه از ناز دامن بر من افشانی(@)(@@) 36 ریاض لطف را سروی سپهر قدر را بدری %~% سریر خلق را شاهی جهان حسن را جانی(@)(@@) 37 اگر صد بار چون شمعم سراندازی دیت ایربس %~% که چون پروانه یکبارم به گرد سر بگردانی(@)(@@) 38 لب لعلت نگین خاتم حسنست و بر خوبان %~% تو را ثابت به آن مهر سلیمانی سلیمانی(@)(@@) 39 دهانت شکر و لب شکرین قد نیشکر خود گو %~% چرا کامی بود تلخ از تو کاندر شکرستانی(@)(@@) 40 یقین است ای مه از نازت که مانند هلال از من %~% اگر صد سجده بینی گوشه ابرو نجنبانی(@)(@@) 41 بناشد آدمی را از قبول دل کمالی به %~% شوم انسان کامل گر سگ کوی خودم خوانی(@)(@@) 42 خرابست آن چنان حالم که رو گردانم از عالم %~% نگردانی رخ از من صورت حالم اگردانی(@)(@@) 43 الهی تا لوای مهر بر دوش فلک ماند %~% تو با چتر و لوا بر تخت دولت کامران مانی(@)(@@) 44 نمی‌داند دعائی محتشم زین به که تا حشرت %~% بود بر فرق فرقد سامخلد ظل سبحانی PageV1P690(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به شاه شه نشان تا باشد ارزانی جهانبانی %~% به آن دستور عالیشان وزارت باد ارزانی(@)(@@) 2 وزارت با چه با شاهانه اقبالی که در دوران %~% مهم آصفی را بگذراند از سلیمانی(@)(@@) 3 اگر این آصفی می‌بود این بر خیارا هم %~% سلیمان آصفی می‌کرد او را بلکه دربانی(@)(@@) 4 چراغ چشم بینش آفتاب 
ms447	 سرمدی پرتو %~% طراز آفرینش نسخه الطاف ربانی(@)(@@) 5 سمی شاه ایوان رسالت آیت رحمت %~% محمد محرم خلوت سرای خاص سبحانی(@)(@@) 6 نوشتی آصف بن برخیا را دور بعد از وی %~% به قدرشان بدی گر در مناصب اول و ثانی(@)(@@) 7 گه تسخیر عالم در بنان فایض الفتحش %~% ز صد شمشیررانی کم مدان یک خامه جنبانی(@)(@@) 8 چنان افکند عهدش طرح جمعیت که می‌ترسم %~% ز زلف مشگمویان هم برد بیرون پریشانی(@)(@@) 9 هنوز از کنه ذاتش نیست و هم آگاه و می‌گوید %~% که اکثر گشته صرف خلقت او صنع یزدانی(@)(@@) 10 ز دستش فیض زرباریست پیدا چون علامتها %~% که از باریدن باران بود در ابر بارانی(@)(@@) 11 تقاضا می‌کند دور ابد پیوند دورانش %~% که چون ذات خدا باقی بماند عالم فانی(@)(@@) 12 چو دولت را بر او بود اعتماد کل به این نسبت %~% ز القاب اعتمادالدولتش حق داشت ارزانی(@)(@@) 13 قصیر و ناقص و کوته خیالست و زبون فکرت %~% برای فهم انسانیت وی فهم انسانی(@)(@@) 14 چو زر از تنگنای آستین می‌ریزد آن یم دل %~% فلک را ظرف چندین نیست با این پهن دامانی(@)(@@) 15 به گردون داده چندین چشم از آن رو خالق انجم %~% که در نظاره‌اش یک یک به فعل آرند حیرانی(@)(@@) 16 اگر وقت غروب مهر تابد کوکب رایش %~% چو صبح از نور کسوت پوش گردد شام ظلمانی(@)(@@) 17 عتابش وقت گرمی با هوا گر یابد آمیزش %~% ز خاک آتش برویاند مطرهای زمستانی(@)(@@) 18 بوی زان پیشتر دولت قوی دستست در بیعت %~% که گردد گرد دستش آستین سست پیمانی(@)(@@) 19 ایا فرمان ده یکتا و یا دستور بی‌همتا %~% که دولت را به جمعیت سوار فرد میدانی(@)(@@) 20 وزیری چون تو می‌باید کز استیلای ذات خود %~% وزارت را کند تاج سر سلطانی و خانی(@)(@@) 21 شوی گر مایل معماری ویرانه عالم %~% ز ویرانی برون آیند ایرانی و تورانی(@)(@@) 22 اگر تبدیل تحت و فوق عالم بگذرد در دل %~% زمین‌ها 
ms448	 جمله فوقانی شوند افلاک تحتانی(@)(@@) 23 به روز دولتت نازد جهان کز انبساط آمد %~% ز ایام دگر ممتاز چون نوروز سلطانی(@)(@@) 24 حسد رخش تسلط بر ملوک نظم می‌تازد %~% تو سرور چون کمیت کلک را در نثر میرانی(@)(@@) 25 ز طبعت بر بنان و از بنان بر خامه می‌ریزد %~% گوهر چندان که حصر آن تو خود تا حشر نتوانی(@)(@@) 26 فدای نقطه‌های رشحه کلک تو می‌گردد %~% در بحری و سیم معدنی و گوهر کانی(@)(@@) 27 نمی‌خواهم تو را ای کعبه حاجات کم دشمن %~% که روز دولتت عید است و دشمن گاو قربانی(@)(@@) 28 فلک را نیست چون یارا که گردد میزبان تو %~% سگانت را به خون دشمنانت کرده مهمانی(@)(@@) 29 دلت بحریست آرامیده اما در غضب کرده %~% تلاطم‌هایش سیلی کاری دریای طوفانی(@)(@@) 30 ز رشگ دست زر ریز تو بر سر خاک می‌بیزد %~% به غربیل مطر بیزی که دارد ابر نیسانی(@)(@@) 31 تو در عالم چنان گنجیده‌ای کز معجز انشا %~% همان خود معنی صد فصل در یک سطر گنجانی(@)(@@) 32 درند از رشگ بر تن شاهدان نظم پیراهن %~% تو چون بر شاهد معنی لباس نثر پوشانی(@)(@@) 33 اشارات به نانت چرخ را دوار گرداند %~% اگر دوران ندارد دست ازین دولاب گردانی(@)(@@) 34 پی ضبط جهان منصب دهان عالم بالا %~% جهانبانی به رغبت می‌دهندت گر تو بستانی(@)(@@) 35 زمین گر ز آسمان لایق به شانت منبصی پرسد %~% به ظاهر آصفی گرید به زیر لب سیلمانی(@)(@@) 36 سلیمانیت رامعجز همین بس کز تو می‌آید %~% که در وقت سیاست خاطر موری نرنجانی(@)(@@) 37 نمی‌دانم عجب از گرمی بازار تدبیرت %~% ببرد زمهریر اعدای خود را گر بسوزانی(@)(@@) 38 تو ای باد مراد ار بگذری بر طرف خارستان %~% فرستد گل به شهر از بوته‌ها خار بیابانی(@)(@@) 39 و گر خصمت به گلزاری درآید گل شود غنچه %~% که در چشمش خلاند نوک هیاتهای پیکانی(@)(@@) 40 چو ابر خوش هوا بر باغ بگذر کز سجود تو %~% خمد 
ms449	 بهر هیات قوس و قزح سرو گلستانی(@)(@@) 41 فلک بی‌رخصتت یک کار بی‌تابانه خواهد کرد %~% اگر در قتل خصمت از تو یابد دیر فرمانی(@)(@@) 42 لباس خصم خود بینت قضا بی‌جیب می‌دوزد %~% که طوق لعنت شیطان کند آن را گریبانی(@)(@@) 43 برای مدحتت در کی و حسی آرزو دارم %~% فزون از درک سحبانی زیاد از حس حسانی(@)(@@) 44 تو را مداح جز من نیست اما می‌کند غیرت %~% زجاج سرخ را خون در دل از دل یاقوت رمانی(@)(@@) 45 به طبع پست و نظم سست و مضمون فرومایه %~% میسر نیست بر گردون زدن کوس ثناخوانی(@)(@@) 46 عرب تا عجم زد در ثنایت برهم آن گه شد %~% به سحبان العجم مشهور عالم‌گیر کاشانی(@)(@@) 47 تو در آفاق ممتازی و ممتاز است مدحت هم %~% ز دیگر مدح‌ها ای خسرو ملک سخندانی(@)(@@) 48 که از دل بر زبان نگذشته و از خامه بر نامه %~% ز دست به اذل ممدوح می‌بیند زرافشانی(@)(@@) 49 جهان‌دارا مرا هر ساله از نزد تو مرسومی %~% مقرر بود و اخذش بود هم در عین آسانی(@)(@@) 50 به من یک دفعه واصل گشت و بود امید کان مبلغ %~% مضاعف هم شود چون دولتت در دفعه ثانی(@)(@@) 51 طمع چون در شتاب افتاد پا بیرون نهاد از ره %~% به دیوارش نخست از لغزش پا خورد پیشانی(@)(@@) 52 سزای مرد طامع بس ز دوران پشت پا خوردن %~% گزیدن پشت دست یاس آنگاه از پشیمانی(@)(@@) 53 الا ای پادشاه محتشم آنها که واقع شد %~% به من چرخ خصومت پیشه کرد از کین پنهانی(@)(@@) 54 که در وضع جهان کرد اختراعی چند گوناگون %~% به آئینی که می‌بینی به عنوانی که می‌دانی(@)(@@) 55 غرض کز غبن‌های فاحش ای اصل کفایتها %~% شدند اکثر فوائد ز آفت ایام نقصانی(@)(@@) 56 ولی فاحش‌ترین غبن‌ها این بود داعی را %~% که از وصلت نشد واصل به صحبت‌های روحانی(@)(@@) 57 ولی از ذوق گوشی از اشارات عیادت پر %~% دو چشم اندر ره 
ms450	 حسن خرام و دامن‌افشانی(@)(@@) 58 زبان آماده عرض ثنا و مدح خوانیها %~% ولی از کار رفته باوجود آن خوش الحانی(@)(@@) 59 که ناگه خورد بر هم آن بساط و گرد موکبها %~% ز کاشان شد بهم آغوشی کحل صفاهانی(@)(@@) 60 به معمار قضا فرما کنون کاندر زمان تو %~% بنای خانه عیش مرا از نو شود بانی(@)(@@) 61 ثنا چون با دعا اولیست ختمش هم بر آن بهتر %~% خصوصا این ثنا کز عرض حاجاتست طولانی(@)(@@) 62 تفاوت تا بود با هم به قدر شان مناصب را %~% الا ای آفتاب آسمان مرتفع شانی(@)(@@) 63 همایون منصب پر رونق بی‌انتقال تو %~% ز سلطانی و خانی باد افزون بل ز خاقانی PageV1P691(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از آنم شکوه است از طول ایام پریشانی %~% که پایم کوته است از درگه نواب سلطانی(@)(@@) 2 به تنگ آورده‌ام خاصان دیوان معلی را %~% من دیوانه از عرض حکایت‌های طولانی(@)(@@) 3 به این امید کان افسانه‌ها چون بشنود سلطان %~% کند از چاره‌سازی در اهتزازم از خوش الحانی(@)(@@) 4 در آفاق ارچه ممتازم ولی می‌خواهم از خلقم %~% به عنوان غلامی بیش ازین ممتاز گردانی(@)(@@) 5 مرا حالا عوام‌الناس از خاصان درگاهت %~% نمی‌دانند برنهج سلف زان سان که می‌دانی(@)(@@) 6 سگ کوی توام اما به این کز درگهت دورم %~% مرا کم قدر می‌دانند و بی‌صاحب ز نادانی(@)(@@) 7 گهی اطلاق اخراجات بر من می‌کند عامل %~% برای خویش و نامش می‌کند اطلاق دیوانی(@)(@@) 8 گهی می‌خواهد از من پیشکش بهر تو دریادل %~% که دست درفشانت عار دارد از زرافشانی(@)(@@) 9 مرا آب و زمینی هست در کاشان که مال آن %~% ز بسیاری برونست از قیاس و فهم انسانی(@)(@@) 10 زمینم روی گردآلود کز خاک درت دورست %~% دو چشمم آبیار آن زمین از اشگ رمانی(@)(@@) 11 بلی آب و زمین این چنین را مال می‌باشد %~% ولی برعکس یعنی بخشش و انعام سلطانی(@)(@@) 12 تو سلطان زبان دانی و د رمدح و ثنای تو %~% هزاران بلبل 
