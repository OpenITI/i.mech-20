ms169	 دون الحقاب % يذكرني الشباب سهام حتف % PageV01P625 141(@)(@@) % يصبن مقاتلي دون الإهاب % % رمت قلبي بهن فأقصدته % % 142(@)(@@) % طلوع النبل من خلل النقاب % % فراحت وهي في بال رخي % 143(@)(@@) % ورحت بلوعة مثل الشهاب % وكل مبارز بالشيب قرنا % 144(@)(@@) % فمسبي لعمرك غير سابي % % ولو شهد الشباب إذا لراحت % 145(@)(@@) % وإن بها وعيشك ضعف ما بي % % فيا غوثا هناك بقيد ثأري % % 146(@)(@@) % إذا ما الثأر فات يد الطلاب % فكم ثأر تلاقت لي يداه % 147(@)(@@) % ولو من بين أطراف الحراب % يذكرني الشباب جنان عدن % % 148(@)(@@) % على جنبات أنهار عذاب % % تفيىء ظلها نفحات ريح % 149(@)(@@) % تهز متون أغصان رضاب % % إذا ماست ذوائبها تداعت % 150(@)(@@) % بواكي الطير فيها بانتحاب % يذكرني الشباب رياض حزن % PageV01P626 151(@)(@@) % ترنم بينها زرق الذباب % إذا شمس الأصائل عارضتها % % 152(@)(@@) % وقد كربت توارى بالحجاب % وألقت جنح مغربها شعاعا % 153(@)(@@) % مريضا مثل ألحاظ الكعاب % يذكرني الشباب سراة نهيى % 154(@)(@@) % نمير الماء مطرد الحباب % قرته مزنة بكر وأضحى % % 155(@)(@@) % ترقرقه الصبا مثل السراب % على حصباء في أرض هجان % 156(@)(@@) % كأن ترابها ذفر الملاب % له حبك إذا اطردت عليه % % 157(@)(@@) % قرأت بها سطورا في كتاب % تذكرني الشباب صبا بليل % 158(@)(@@) % رسيس المس لاغبة الركاب % أتت من بعد ما انسحبت مليا % 159(@)(@@) % على زهر الربا كل انسحاب % % وقد عبقت بها ريا الخزامى % % 160(@)(@@) % كريا المسك ضوع بانتهاب % يذكرني الشباب وميض برق % PageV01P627 161(@)(@@) % وسجع حمامة وحنين ناب % فيا أسفا ويا جزعا عليه % % 162(@)(@@) % ويا حزنا إلى يوم الحساب % % أأفجع بالشباب ولا أعزى % % 163(@)(@@) % لقد غفل المعزي عن مصابي % % تفرقنا على كره جميعا % 164(@)(@@) % ولم يك عن قلى طول اصطحاب % وكانت أيكتي ليد اجتناء % 165(@)(@@) % فعادت بعده ليد احتطاب % أيا برد الشباب لكنت عندي % % 166(@)(@@) % من الحسنات والقسم الرغاب % بليت على الزمان وكل برد % 167(@)(@@) % قبين بلى وبين يد استلاب % وعز علي أن تبلى وأبقى % % 168(@)(@@) % ولكن الحوادث لا تحابي % % لبستك برهة لبس ابتذال % 169(@)(@@) % على علمي بفضلك في الثياب % ولو ملكت صونك فاعلمنه % 170(@)(@@) % لصنتك في الحريز من العياب 
ms170	 % % ولم ألبسك إلا يوم فخر % PageV01P628 171(@)(@@) % ويوم زيارة الملك اللباب % عبيد الله قرم بني زريق % 172(@)(@@) % وحسبك باسمه فصل الخطاب % فتى صرحت خلائقه قديما % 173(@)(@@) % فليست بالسمار ولا الشهاب % ولم يخلقن من أري جميعا % 174(@)(@@) % ولكن هن من أري وصاب % وما من كان ذا خلقين شتى % % 175(@)(@@) % وكانا ماجدين بذي ائتشاب % له حلم يذب الجهل عنه % 176(@)(@@) % كذب النحل عن عسل اللصاب % وما جهل الحليم له بجهل % 177(@)(@@) % ولكن حد أظفور وناب % يلين ملاينا لملاينيه % 178(@)(@@) % ويخشن للمخاشن ذي الشغاب % وراء معاطف منه لدان % 179(@)(@@) % إباء مكاسر منه صلاب % كخوط الخيزران يريك لينا % 180(@)(@@) % ويأبى الكسر من عطفيه آب % % موإن طلب الصبا والقلب صاب % PageV01P629 181(@)(@@) % أعاذل راضني لك شيب رأسي % % ولولا ذاك أعيا اقتضابي % % 182(@)(@@) % فلومي سامعا لك أو أفيقي % % فقد حان اتئابك واتئابي % % 183(@)(@@) % وقد أغناك شيبي عن ملامي % % كما أغنى العيون عن ارتقابي % % 184(@)(@@) % غضضت من الجفون فلست أرمي % % ولا أرمى بطرف مستراب % % 185(@)(@@) % وكيف تعرضي للصيد أنى % % وقد ريشت قداحي باللغاب % 186(@)(@@) % كفى بالشيب من ناه مطاع % على كره ومن داع مجاب % % 187(@)(@@) % حططت إلى النهى رحلي وكلت % مطية باطلي بعد الهباب % 188(@)(@@) % وقلت مسلما للشيب أهلا % بهادي المخطئين إلى الصواب % 189(@)(@@) % ألست مبشري في كل يوم % بوشك ترحلي إثر الشباب % 190(@)(@@) % لقد بشرتني بلحاق ماض % أحب إلي من برد الشراب % PageV01P630 191(@)(@@) % فلست مسميا بشراك نعيا % وإن أوعدت نفسي بالذهاب % % 192(@)(@@) % لك البشرى وما بشراك عندي % % سوى ترقيع وهيك بالخضاب % 193(@)(@@) % وأنت وإن فتكت بحب نفسي % % وصاحب لذتي دون الصحاب % 194(@)(@@) % فقد أعتبتني وأمت حقدي % % بحثك خلفه عجلا ركابي % % 195(@)(@@) % إذا ألحقتني بشقيق عيشي % % فقد وفيتني فيه ثوابي % % 196(@)(@@) % وحسبي من ثوابي فيه أني % % وإياه نؤوب إلى مآب % 197(@)(@@) % لعمرك ما الحياة لكل حي % % إذا فقد الشباب سوى عذاب % 198(@)(@@) % فقل لبنات دهري فلتصبني % % إذا ولى بأسهمها الصياب % 199(@)(@@) % سقى عهد الشبيبة كل غيث % أغر مجلجل داني الرباب % 200(@)(@@) % ليالي لم أقل سقيا لعهد % ولم أرغب إلى 
ms171	 سقيا سحاب % PageV01P631 201(@)(@@) % ولم أتنفس الصعداء لهفا % على عيش تداعى بانقضاب % 202(@)(@@) % أطالع ما أمامي بابتهاج % ولا أقفو المولي باكتئاب % % 203(@)(@@) % أجد الغانيات قلين وصلي % % وتطبيني إليهن الطوابي % % 204(@)(@@) % صددن بأعين عني نواب % % ولسن عن المقاتل بالنوابي % % 205(@)(@@) % ولم يصددن من خفر ودل % ولكن من بعاد واجتناب % 206(@)(@@) % وقلن كفاك بالشيب امتهانا % وبالصرم المعجل من عقاب % % 207(@)(@@) % وما أنصفن إذ يصرمن حبلي % % بذنب ليس مني باكتساب % 208(@)(@@) % وكن إذا اعتددن الشيب ذنبا % على رجل فليس بمستتاب % 209(@)(@@) % وما لك عند من يعتد ظلما % عليك بذنب غيرك من متاب % 210(@)(@@) % يذكرني الشباب صدى طويل % إلى برد الثنايا والرضاب % PageV01P632 211(@)(@@) % وشح الغانيات عليه إلا % عن ابن شبيبة جون الغراب % 212(@)(@@) % فإن سقينني صردن شربي % % ولم يك عن هوى بل عن خلاب % 213(@)(@@) % يذكرني الشباب هوان عتبي % % وصد الغانيات لدى عتابي % % 214(@)(@@) % ولو عتب الشباب ظهير عتبي % % رجعن إلي بالعتبى جوابي % % 215(@)(@@) % وأصغى المعرضات إلى عتاب % يحط به الوعول من الهضاب % 216(@)(@@) % وأقلق مضجع الحسناء سخطي % % فأرضتني على رغم الغضاب % 217(@)(@@) % وبت وبين شخصينا عفاف % سخاب عناقها دون السخاب % 218(@)(@@) % ولو أني هناك أطيع جهلي % % لكنت حقابها دون الحقاب % 219(@)(@@) % يذكرني الشباب سهام حتف % يصبن مقاتلي دون الإهاب % % 220(@)(@@) % رمت قلبي بهن فأقصدته % % طلوع النبل من خلل النقاب % % PageV01P633 221(@)(@@) % فراحت وهي في بال رخي % ورحت بلوعة مثل الشهاب % 222(@)(@@) % وكل مبارز بالشيب قرنا % فمسبي لعمرك غير سابي % % 223(@)(@@) % ولو شهد الشباب إذا لراحت % وإن بها وعيشك ضعف ما بي % % 224(@)(@@) % فيا غوثا هناك بقيد ثأري % % إذا ما الثأر فات يد الطلاب % 225(@)(@@) % فكم ثأر تلاقت لي يداه % ولو من بين أطراف الحراب % 226(@)(@@) % يذكرني الشباب جنان عدن % % على جنبات أنهار عذاب % % 227(@)(@@) % تفيىء ظلها نفحات ريح % تهز متون أغصان رضاب % % 228(@)(@@) % إذا ماست ذوائبها تداعت % بواكي الطير فيها بانتحاب % 229(@)(@@) % يذكرني الشباب رياض حزن % ترنم بينها زرق الذباب % 230(@)(@@) % إذا شمس الأصائل عارضتها % % وقد كربت توارى بالحجاب % PageV01P634 231(@)(@@) % وألقت جنح مغربها شعاعا % مريضا 
ms172	 مثل ألحاظ الكعاب % 232(@)(@@) % يذكرني الشباب سراة نهيى % نمير الماء مطرد الحباب % 233(@)(@@) % قرته مزنة بكر وأضحى % % ترقرقه الصبا مثل السراب % 234(@)(@@) % على حصباء في أرض هجان % كأن ترابها ذفر الملاب % 235(@)(@@) % له حبك إذا اطردت عليه % % قرأت بها سطورا في كتاب % 236(@)(@@) % تذكرني الشباب صبا بليل % رسيس المس لاغبة الركاب % 237(@)(@@) % أتت من بعد ما انسحبت مليا % على زهر الربا كل انسحاب % % 238(@)(@@) % وقد عبقت بها ريا الخزامى % % كريا المسك ضوع بانتهاب % 239(@)(@@) % يذكرني الشباب وميض برق % وسجع حمامة وحنين ناب % 240(@)(@@) % فيا أسفا ويا جزعا عليه % % ويا حزنا إلى يوم الحساب % % PageV01P635 241(@)(@@) % أأفجع بالشباب ولا أعزى % % لقد غفل المعزي عن مصابي % % 242(@)(@@) % تفرقنا على كره جميعا % ولم يك عن قلى طول اصطحاب % 243(@)(@@) % وكانت أيكتي ليد اجتناء % فعادت بعده ليد احتطاب % 244(@)(@@) % أيا برد الشباب لكنت عندي % % من الحسنات والقسم الرغاب % 245(@)(@@) % بليت على الزمان وكل برد % قبين بلى وبين يد استلاب % 246(@)(@@) % وعز علي أن تبلى وأبقى % % ولكن الحوادث لا تحابي % % 247(@)(@@) % لبستك برهة لبس ابتذال % على علمي بفضلك في الثياب % 248(@)(@@) % ولو ملكت صونك فاعلمنه % لصنتك في الحريز من العياب % % 249(@)(@@) % ولم ألبسك إلا يوم فخر % ويوم زيارة الملك اللباب % 250(@)(@@) % عبيد الله قرم بني زريق % وحسبك باسمه فصل الخطاب % PageV01P636 251(@)(@@) % فتى صرحت خلائقه قديما % فليست بالسمار ولا الشهاب % 252(@)(@@) % ولم يخلقن من أري جميعا % ولكن هن من أري وصاب % 253(@)(@@) % وما من كان ذا خلقين شتى % % وكانا ماجدين بذي ائتشاب % 254(@)(@@) % له حلم يذب الجهل عنه % كذب النحل عن عسل اللصاب % 255(@)(@@) % وما جهل الحليم له بجهل % ولكن حد أظفور وناب % 256(@)(@@) % يلين ملاينا لملاينيه % ويخشن للمخاشن ذي الشغاب % 257(@)(@@) % وراء معاطف منه لدان % إباء مكاسر منه صلاب % 258(@)(@@) % كخوط الخيزران يريك لينا % ويأبى الكسر من عطفيه آبهن % % 259(@)(@@) % ينضنض منه من عاداه صلا % من الأصلال مخشي الوثاب % 260(@)(@@) % إذا ما انساب كان له سحيف % يمير الحارشين من الضباب % PageV01P637 261(@)(@@) % يميت لعابه من غير نهش 
ms173	 % وأدنى نفثه دون اللعاب % 262(@)(@@) % وذلك منه في غير ارتقاء % ظهور الموبقات ولا ارتكاب % 263(@)(@@) % إليه يشار أي رئاب صدع % إذا ما الصدع جل عن الرئاب % 264(@)(@@) % يضيء شهابه في كل ليل % فتنجاب الدجى أي انجياب % 265(@)(@@) % إذا ما الخرت لم يسلكه خلف % تغلغل فيه ولاج الثقاب % 266(@)(@@) % وليس بوالج في الخرت إلا % ممر الخلق سلك لانسراب % 267(@)(@@) % غدا جبلا جبال الأرض طرا % % تضاءل تحته مثل الظراب % 268(@)(@@) % يلاذ بمعقل منه حريز % ويرعى حوله أثرى جناب % 269(@)(@@) % ثمالا للأرامل واليتامى % % يثوب الناس منه إلى مثاب % 270(@)(@@) % بساحته قدور راسيات % تفارطها جفان كالجوابي % % PageV01P638 271(@)(@@) % له ناران نار قرى وحرب % ترى كلتيهما ذات التهاب % 272(@)(@@) % عجبت ولست أبرح من نداه % طوال الدهر في أمر عجاب % 273(@)(@@) % له عز يجير على الليالي % % ومال مستباح كالنهاب % 274(@)(@@) % وأعجب منه أن الأرض سالت % بصوب سمائه إلا شعابي % % 275(@)(@@) % فقولا للأمير وإن رآني % % بمزجر ما يهان من الكلاب % 276(@)(@@) % أما لي من دعاء مستجاب % لديك مع الدعاء المستجاب % 277(@)(@@) % أظل سحاب عرفك كل شيء % ودر على البلاد بلا عصاب % 278(@)(@@) % سواي فإنني عنه بظهير % كأني خلف منقطع التراب % 279(@)(@@) % يجود بسيبه أبدا لغيري % % ويخلبني ببرق غير خابي % % 280(@)(@@) % أما لي منه حظ غير برق % تشبهه العيون حريق غاب % PageV01P639 281(@)(@@) % أبيت أشيمه وأذود نومي % % ويرزق صوبه أقصى مصاب % 282(@)(@@) % سقيت الواردين بلا رشاء % كدجلة مدها سيل الروابي % % 283(@)(@@) % وأدليت الدلاء فلم تؤب لي % % بملء من نداك ولا قراب % 284(@)(@@) % هبا لي ما لقدحي يوري % % ألم أقدح بزند غير كاب % 285(@)(@@) % لقد أيقنت أني لم يقصر % تخيري الزناد ولا انتخابي % % 286(@)(@@) % ألم تسبق جيادي خارجات % بخراج من الضيق الهوابي % % 287(@)(@@) % فما للتاليات لديك تحظى % % بحظ سوابق الخيل العراب % % 288(@)(@@) % أتحرمني لأني مستغل % وأني لست كالرزحى السغاب % 289(@)(@@) % فما تحمي ذوات الدر درا % % إذا صادفن ملآن الوطاب % 290(@)(@@) % ولا تختص بالحلب العيامى % % إذا الحلاب قاموا بالعلاب % PageV01P640 291(@)(@@) % ولكن لا تزال تدر عفوا % لكل يد مرتها لاحتلاب % 292(@)(@@) % وما يطوي 
ms174	 العمارة كل غيث % إلى الأرض المعطلة اليباب % 293(@)(@@) % ولكن لا يزال يجود كلا % بجود أو بوبل ذي انسكاب % 294(@)(@@) % لإحياء التي كانت مواتا % وحفظ العامرات من الخراب % 295(@)(@@) % وإن أك من نداه على صعود % فإني من نداك على انصباب % 296(@)(@@) % فلا تضعن رفدك دون قدري % % فليس يفوت بسطتك انتصابي % % 297(@)(@@) % وما سيب الأمير بسيل واد % يقصر أن ينال ذرا الروابي % % 298(@)(@@) % وظني أنه لو كان سيلا % لعلمه التوقل في العقاب % % 299(@)(@@) % لقد رجيت في عملي رجاء % % فلا أصدر بلا عمل مثاب % % 300(@)(@@) % ولا يكن الذي أملت منه % كرقراق السراب على الحداب % % PageV01P641 301(@)(@@) % ولا كرماد اشتدت رياح % به عرض الصحاصح فهو هاب % % 302(@)(@@) % كأني أدري بنداك صيدا % يباعده دنوي وارتقابى % % 303(@)(@@) % لذاك إذا مررت وتلك تشفي % % من الحساد أو صاب الوصاب % 304(@)(@@) % تشير إلي بالمحروم أيد % كأيدي الناس في يوم الحصاب % 305(@)(@@) % تطاول بي انتظار الوعد جدا % وريب الدهر يؤذن بانشعاب % 306(@)(@@) % فيا لك حسرة إن أحتقبها % % إلى جدثي فيا سوء احتقابي % % 307(@)(@@) % وكان الوعد ما لم تعطنيه % % يد الإنجاز شر حباء حاب % 308(@)(@@) % أعوذ بطيب خيمك من مطال % حماني ورد بحرك ذي العباب % 309(@)(@@) % وما هذا المطال وليس عهدي % % بنفسك من قرائنك الصعاب % 310(@)(@@) % يروض النفس من صعبت عليه % % ولم تك في الندى طوع الجناب % PageV01P642 311(@)(@@) % وأنت كما علمت قرين نفس % تطيعك في السماح بلا جذاب % 312(@)(@@) % فمن أي الثنايا ليت شعري % % أتاني المطل أم أي النقاب % 313(@)(@@) % أفكر في نصاب أنت منه % % فيغلق دون عذرك كل باب % 314(@)(@@) % وكم في الناس من رجل مليم % يقوم بعذره لؤم النصاب % 315(@)(@@) % ألست المرء لا عزم كهام % ولا بخل إليه بذي انتساب % 316(@)(@@) % تجود بنانه والغيث مكد % ويمضي عزمه والسيف ناب % 317(@)(@@) % ألست المرء يجبي كل حمد % إذا ما لم يكن للحمد جاب % 318(@)(@@) % توائل من لسان الذم ركضا % وتثبت للمهندة العضاب % 319(@)(@@) % تظاهر دون عرضك كل درع % تظاهر للطعان وللضراب % 320(@)(@@) % نعد معايبا للغيث شتى % % وما في جود كفك من معاب 
ms175	 % PageV01P643 321(@)(@@) % وجدنا الغيث يهدم ما بنينا % % سوى الخيم المبدى والقباب % 322(@)(@@) % ويمنعنا الحراك أشد منع % وإلا سامنا حطم الرقاب % 323(@)(@@) % ويحتجب الضياء إذا سقانا % % وما ضوء بجودك ذو احتجاب % 324(@)(@@) % وفضل جداك بعد على جداه % مبين لا يقابل بارتياب % 325(@)(@@) % تجود يداك بالذهب المصفى % % إذا ما الغيث علل بالذهاب % 326(@)(@@) % وجودك لا يغب الناس يوما % وجود الغيث تارات اعتقاب % 327(@)(@@) % وتتفقان في خلق كريم % فتشتركانه شرك الطياب % 328(@)(@@) % تجودان الأنام بلا امتنان % بما تستمطران ولا احتساب % 329(@)(@@) % فعش في غبطة ونعيم بال % وملك لا يخاف يد اغتصاب % 330(@)(@@) % وآخر خطبة لي فيك قولي % % وليس عتاب مثلك بالغلاب % PageV01P644 331(@)(@@) % بمهما شئت دونك فامتحني % % فإنك غايتي والصبر دابي % % 332(@)(@@) % وليس لأنني سدت سبيلي % % ولا عجز اصطرافي واضطرابي % % 333(@)(@@) % ولكني وما بي مدح نفسي % % أرى عاب التكذب شر عاب % 334(@)(@@) % وإن جاوزت مدحك لم يزل بي % % تكذبي المدائح واجتلابي % % 335(@)(@@) % متى أجد المدائح ليت شعري % % تواتي في سواك بلا كذاب % 336(@)(@@) % وبعد فإنني في مشمخر % عصائب رأسه قطع الضباب % 337(@)(@@) % أحلتنيه آباء كرام % بتيجان الملوك ذوو اعتصاب % 338(@)(@@) % فكيف تنالني كف بنيل % وليس تنالني كف العقاب % 339(@)(@@) % أكف الناس غيرك تحت كفي % % وقاب الناس غيرك دون قابي % % 340(@)(@@) % تعالت هضبتي عن كل سيل % وفاتت نبعتي نضخ الذناب % PageV01P645 341(@)(@@) % فليس ينالني إلا منيل % يطل علي إطلال السحاب % 342(@)(@@) % وما كانت أصول النبع تسقى % % معاذ الله من قلص الجباب % 343(@)(@@) % فذلك عاقني عن شد رحلي % % وعن عسفي المهامة واجتيابي % % 344(@)(@@) % ولولاه لما حنت قلاصي % % إلا وطن لهن ولا سقاب % 345(@)(@@) % ولا أرعت على عطن قديم % ولا حفلت بنأي واغتراب % 346(@)(@@) % ولا ألفت مقلقلها بخيلا % بحسراها على غرثى الذئاب % 347(@)(@@) % ولا برحت تقد الليل قدا % % بأعناق كعيدان الخصاب % 348(@)(@@) % فما سرت النجوم سراي فيه % ولا انسابت أفاعيه انسيابي % % 349(@)(@@) % إذا ولراعت الصيران عنسي % % بحيث تشق عنهن السوابي % % 350(@)(@@) % وعامت في دهاس الرمل عوما % وإن عرضت عوانكها الحوابي % % PageV01P646 351(@)(@@) % ولو أني قطعت الأرض طولا % لكان إليك من 
ms176	 بعد انقلابي % % 352(@)(@@) % إذا كنت المآب ولا مآب % سواك فأين عنك بذي الإياب % 353(@)(@@) % سأصبر موقنا بوفور حظي % % وأجر الصابرين بلا حساب % 354(@)(@@) % ومهما تب من عمل وقول % فما عمل ابن مدحك للتباب % PageV01P647 البحر : - 1(@)(@@) % سليم الزمان كمنكوبه % وموفوره مثل محروبه % 2(@)(@@) % وممنوحه مثل ممنوعه % ومكسوه مثل مسلوبه % 3(@)(@@) % ومحبوبه رهن مكروهه % ومكروهه رهن محبوبه % 4(@)(@@) % ومأمونه تحت محذوره % ومرجوه تحت مرهوبه % 5(@)(@@) % وريب الزمان غدا كائن % وغالبه مثل مغلوبه % 6(@)(@@) % فلا تهربن إلى ذلة % ذليل الزمان كمنكوبه % 7(@)(@@) % أما في الزمان فتى ماجد % % ينفس كربة مكروبه % 8(@)(@@) % سأستر نفسي أجاد اللئي % % م أم ضن عني بموهوبه % 9(@)(@@) % فحظي وإن كنت مغصوبه % فستري لست بمغصوبه % 10(@)(@@) % وينبوت أرض ترى شوكه % يطيل حماية خروبه % PageV01P648 11(@)(@@) % ترفعت عن لؤم مجنيه % بنفسي وعن لؤم محطوبه % 12(@)(@@) % وآكل أطعمة الأدنيا % % ء رهن بأن يستخفوا به % 13(@)(@@) % ألم تر صاحبهم لا يزا % % ل فيهم شقيا بمصحوبه % 14(@)(@@) % إذا امتاحهم أكلة عبدو % % ه تعبيد رب لمربوبه % 15(@)(@@) % يخالون أنهم بلغو % % ه بالقوت أفضل مطلوبه % 16(@)(@@) % وأنهم حرسوا نفسه % به من غوائل مرهوبه % 17(@)(@@) % يذيل مضيفهم ضيفه % كملبوسه وكمركوبه % 18(@)(@@) % فلا يؤتغن امرء عرضه % لمأكوله ولمشروبه % 19(@)(@@) % ولا يلتمس من خسيس الرجا % % ل ما خس من فضل مكسوبه % 20(@)(@@) % كملتمس من خسيس الجذو % % ع قطر إهالة مصلوبه % PageV01P649 21(@)(@@) % ووغد وهبت له حكمه % وأملت منكود موهوبه % 22(@)(@@) % فكنت كعابد منحوته % ومسترزق رزق منصوبه % 23(@)(@@) % ولو قد ألح عليه الهجا % % ء جرجر من عض كلوبه % 24(@)(@@) % ولما غدا كل هذا الورى % % وممدوحه مثل مندوبه % 25(@)(@@) % مدحت إلها جميل الثنا % % ء مصدوقه غير مكذوبه % 26(@)(@@) % ألا يا فراسي خذها إلي % % ك من ثاقب الحد مشبوبه % 27(@)(@@) % حليم تعوذ من جهله % إذا ما حصبت بشؤبوبه % PageV01P650 البحر : - 1(@)(@@) % لي صاحب قد كنت آمل نفعه % سبقت صواعقه إلي صبيبه % 2(@)(@@) % رجيته للنائبات فساءني % % حتى جعلت النائبات حسيبه % 3(@)(@@) % ولما سألت زمانه إعناته % لكن سألت زمانه تأديبه % 4(@)(@@) % وعسى معوجه يكون ثقافه % ولعل ممرضه 
ms177	 يكون طبيبه % 5(@)(@@) % يا من بذلت له المحبة مخلصا % في كل أحوالي وكنت حبيبه % 6(@)(@@) % ورعيت ما يرعى وملت إلى الذي % % وردته همته فكنت شريبه % 7(@)(@@) % شاركته في جده ورأيته % في هزله كفوي فكنت لعيبه % 8(@)(@@) % أيام نسرح في مراد واحد % للعلم تنتجع القلوب غريبه % 9(@)(@@) % وكذاك نشرع في غدير واحد % يصف الصفاء لوارديه طيبه % 10(@)(@@) % أيسوؤني من لم أكن لأسوءه % ويريبني من لم أكن لأريبه % PageV01P651 11(@)(@@) % ما هكذا يرعى الصديق صديقه % ورفيقه وشقيقه ونسيبه % 12(@)(@@) % أأقول شعرا لا يعاب شبيهه % فتكون أول عائب تشبيبه % 13(@)(@@) % ما كل من يعطى نصيب بلاغة % ينسيه من رعي الصديق نصيبه % 14(@)(@@) % أنفست أن أمررت عند خصاصة % سبب الثراء وما وردت قليبه % 15(@)(@@) % إني أراك لدى الورود مواثبي % % وإذا بدا أمر أراك عقيبه % 16(@)(@@) % ولقد رعيت الخصب قبلي برهة % ورعيت من مرعى المعاش جديبه % 17(@)(@@) % فرأيت ذلك كله لك تافها % وسخطت حظك واحتقرت رغيبه % 18(@)(@@) % شهد الذي أبديت أنك كاشح % لكن معرفتي ترى تكذيبه % 19(@)(@@) % وإذا أراب الرأي من ذي هفوة % ضمنت إنابة رأيه تأنيبه % 20(@)(@@) % ولقد عمرت أظن أنك لو بدا % % مني معيب لم تكن لتعيبه % PageV01P652 21(@)(@@) % نبئت قوما عابني سفهاؤهم % وشهدت محفلهم وكنت خطيبه % 22(@)(@@) % عابوا وعبت بغير حق منطقا % لو طال رميك لم تكن لتصيبه % 23(@)(@@) % ونكرتم أن كان صدر قصيدة % ذكراي غصن منعم وكثيبه % 24(@)(@@) % فكأنكم لم تسمعوا بمشبه % قبلي ولم تتعودوا تصويبه % 25(@)(@@) % الآن حين طلعت كل ثنية % ووطئت أبكار الكلام وثيبه % 26(@)(@@) % يتعنت المتعنتون قصائدي % % جهل المرتب منطقي ترتيبه % 27(@)(@@) % الآن حين زأرت واستمع العدا % % زأري وأنذر كلب شر ذيبه % 28(@)(@@) % يتعرض المتعرضون عداوتي % % حتى يهر لي المهر كليبه % 29(@)(@@) % الآن حين سبقت كل مسابق % فتركت أسرع جريه تقريبه % 30(@)(@@) % يتكلف المتكلفون رياضتي % % ليطل بذاك معجب تعجيبه % PageV01P653 31(@)(@@) % وهب القضاء كما قضيت ألم يكن % في محض شعري ما يجيز ضريبه % 32(@)(@@) % هلا وقد ذوقت در قريحتي % % فذممت حازره حمدت حليبه % 33(@)(@@) % بل هبه عيبا لا يجوز ألم يكن 
ms178	 % % من حق خلك أن تحوط مغيبه % 34(@)(@@) % فتكون ثم نصيره وظهيره % وخصيم عائب شعره ومجيبه % 35(@)(@@) % بل ما رضيت له بتركك نصره % حتى نعبت مع السفيه نعيبه % 36(@)(@@) % فثلبت معنى محسن وكلامه % ثلبا جعلت كبديه تعقيبه % 37(@)(@@) % حتى كأنك قاصد تعويقه % عما ابتغاه وطالب تخييبه % 38(@)(@@) % وأما وما بيني وبينك إنه % عهد رعيت بعيده وقريبه % 39(@)(@@) % لولا كراهة أن أملك شهوتي % % قهر الصديق محبتي تلبيبه % 40(@)(@@) % أو أن أجاوز بالعتاب حدوده % فأكون عائب صاحب ومعيبه % PageV01P654 41(@)(@@) % سيرت قافية إليك غريبة % من سيرته تضمنت تغريبه % PageV01P655 البحر : - 1(@)(@@) % مجرب أنه إذا نسب % عفى على اسم فإنه لقب % 2(@)(@@) % يدعو به الساخرون صاحبه % وما لهم في دعائه أرب % 3(@)(@@) % أفطن لداعيه كيف ينسبه % في موطن ليس حقه النسب % 4(@)(@@) % هزءا وسخرا تنحل والنا % % س إذا ما تهكموا قلبوا % % PageV01P656 البحر : - 1(@)(@@) % أراب الدهر حتى ما يريب % وحتى لا عجيب له عجيب % 2(@)(@@) % فلا تعجب لخلال نبيل % فأعجب منه طفل لا يشيب % PageV01P657 البحر : - 1(@)(@@) % ما أنس لا أنس هندا آخر الحقب % على اختلاف صروف الدهر والعقب % 2(@)(@@) % ص % % يوم انتحتنا بسهميها مسالمة % 3(@)(@@) % تأتي جديداتها من أوجه اللعب % تدوي الرجال وتشفيهم بمبتسم % 4(@)(@@) % كابن الغمام وريق كابنة العنب % عيناء في وطف قنواء في ذلف % 5(@)(@@) % لفاء في هيف عجزاء في قبب % جاءت تدافع في وشي لها حسن % 6(@)(@@) % تدافع الماء في وشي من الحبب % ليست من البحتريات القصار بنى % 7(@)(@@) % والشاربات مع الرعيان بالعلب % ولم تلد كوليد اللؤم فالقة % 8(@)(@@) % عن رأس شر وليد شر ما ركب % قد قلت إذ نحلوه الشعر حاش له % 9(@)(@@) % إن البروك به أولى من الخبب % البحتري ذنوب الوجه نعرفه % 10(@)(@@) % وما رأينا ذنوب الوجه ذا أدب % أنى يقول من الأقوال أثقبها % % PageV01P658 11(@)(@@) % من راح يحمل وجها سابغ الذنب % أولى بمن عظمت في الناس لحيته % 12(@)(@@) % من نحلة الشعر أن يدعى أبا العجب % وحسبه من حباء القوم أن يهبوا % % 13(@)(@@) % له قفاه إذا ما مر بالعضب % ما كنت أحسب مكسوا 
ms179	 كلحيته % % 14(@)(@@) % يعفى من القفد أو يدعى بلا لقب % لهفي على ألف موسى في طويلته % % 15(@)(@@) % إذا ادعى أنه من سادة العرب % أو قال إني قريع الناس كلهم % % 16(@)(@@) % في الشعر وهو سقيم الشعر والنسب % الحظ أعمى ولولا ذاك لم نره % 17(@)(@@) % للبحتري بلا عقل ولا حسب % وغد يعاف مديح الناس كلهم % % 18(@)(@@) % ويطلب الشتم منهم جاهد الطلب % داء من اللؤم يستشفي الهجاء له % 19(@)(@@) % كذلك الحك يستشفيه ذو الجرب % أراك لم ترض ما أهدى له نفر % 20(@)(@@) % من شتم أم لئيم خيمها وأب % فارض الذي أنا مهديه إليه له % PageV01P659 21(@)(@@) % من مرمض القذع وارض الناس للحطب % قبحا لأشياء يأتي البحتري بها % % 22(@)(@@) % من شعره الغث بعد الكد والتعب % كأنها حين يصغي السامعون لها % % 23(@)(@@) % ممن يميز بين النبع والغرب % رقى العقارب أو هذر البناة إذا % % 24(@)(@@) % أضحوا على شعف الجدران في صخب % وقد يجيء بخلط فالنحاس له % % 25(@)(@@) % وللأوائل صافيه من الذهب % سمين ما نحلوه من هنا وهنا % % 26(@)(@@) % والغث منه صريح غير مجتلب % يسيء عفا فإن أكدت وسائله % 27(@)(@@) % أجاد لصا شديد البأس والكلب % إن الوليد لمغوار إذا نكلت % 28(@)(@@) % نفس الجبان بعيد الهم والسرب % عبد يغير على الموتى فيسلبهم % 29(@)(@@) % حر الكلام بجيش غير ذي لجب % ما إن تزال تراه لابسا حللا % 30(@)(@@) % أسلاب قوم مضوا في سالف الحقب % شعر يغير عليه باسلا بطلا % PageV01P660 31(@)(@@) % وينشد الناس إياه على رقب % يقول مستمعوه الجاهلون به % % 32(@)(@@) % أحسنت يا أشعر الحضار والغيب % حتى إذا كف عن غاراته فله % 33(@)(@@) % شعر يئن مقاسيه من الوصب % شعر كنافض حمى الخيبري له % 34(@)(@@) % برد وكرب فمن يرويه في كرب % كأنه الغرق الشتوي مصرده % 35(@)(@@) % بغير روح وما للروح والشجب % قل للعلاء أبي عيسى الذي نصلت % 36(@)(@@) % به الدواهي نصول الأل في رجب % وآمن الله ليل الخائفين به % 37(@)(@@) % بله النهار وضم الأمر ذا الشعب % أيسرق البحتري الناس شعرهم % 38(@)(@@) % جهرا وأنت نكال اللص ذي الريب % % وتارة يترز الأرواح منطقه % 39(@)(@@) % بالخلق من 
ms180	 بين مقتول ومغتصب % نكله إن أناسا قبله ركبوا % % 40(@)(@@) % بدون ما قد أتاه باسق الخشب % والحكم فيه مبين غير ملتبس % PageV01P661 41(@)(@@) % لو ريم فيه خلاف الحق لم يصب % إذا أجاد فأوجب قطع مقوله % % 42(@)(@@) % فقد دهى شعراء الناس بالحرب % وإن أساء فأوجب قتله قودا % 43(@)(@@) % بمن يميت إذا أبقى على السلب % سلط عليه عبيد الله إن له % 44(@)(@@) % سيفين ذو خطب تترى وذو شطبن ما زال قدما وآباء له سلفوا % % أسدا بها غلب معتادة الغلب % 45(@)(@@) % كم فيهم من مقيم كل ذي حدب % من الأمور على الإسلام ذي حدب % 46(@)(@@) % قوم يحلون من مجد ومن شرف % % ومن علو محل البيض واليلب % 47(@)(@@) % حلوا محلهما من كل جمجمة % دفعا ونفعا وإيفاء على الرتب % 48(@)(@@) % وما يكن من حديث صالح لهم % فصادر عن قديم غير مؤتشب % 49(@)(@@) % لهفي لهز عبيد الله حربته % لثغرة الثور ذي القرنين والغبب % 50(@)(@@) % وقد رماه بشؤبوب فأحصنه % جد وأنجاه شؤبوب من الهرب % PageV01P662 51(@)(@@) % يا أيها السائلي عما أحل به % % مكروه بأسي لقد نقرت عن سبب % 52(@)(@@) % عمى من الجهل أداه إلى عطب % وغير بدع عمى أدى إلى عطب % 53(@)(@@) % يرى الموارط ذو عين فيحذرها % % والعمي فيها إلى الأذقان والركب % 54(@)(@@) % يعيب شعري وما زلت بصيرته % % عمياء عن كل نور ساطع اللهب % 55(@)(@@) % إذا خلون بمن يهوين خلوته % بذلن في ذاك ما أثلن من نشب % 55(@)(@@) % فقلت لا زلت من غي على سنين % يلقيك فيه ومن رشد على نكب % 55(@)(@@) % زرق ينكن بسمر ذبل أبدا % وكلهن بريئات من السيب % 55(@)(@@) % لا شيء أهيب من زرق مؤللة % وهن ينكحن بالأرماح في الجنب % 55(@)(@@) % هذا السنان منيكا في استه أبدا وكم نقيذ % بهاديه ومنشعب % % 55(@)(@@) % فقالكم من منيكا قد بصرت به % محي مميت مرجى الغوث مرتقب % % PageV01P663 55(@)(@@) % أقولإذ قال نكنيكي أحاجزه % من نيكويحكلم يكرم ولم يهب % 55(@)(@@) % فم كمسفى ومفسى واسع كفم % ومنخران قد اسودا من الذبب % 55(@)(@@) % يا عاهر الزوجة المخلوف في حرها % % خلافة السوء والمخلوف بالغيب % 55(@)(@@) % فلست 