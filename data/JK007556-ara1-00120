ms101	 أننا خيرها جدى % % لطالب عرف ، أو لضيف محمل % 49(@)(@@) % مقاويل بالمعروف ، خرس عن الخنى ، % قضاة بفصل الحق في كل محفل % 50(@)(@@) % أخوهم إلى حصن منيع ، وجارهم % بعلياء عز ، ليس ب لمتذلل % PageV01P419 51(@)(@@) % وفينا إذا ما حادث الدهر أجحفت % نوائبه ، والدهر جم التنقل ، % 52(@)(@@) % لذي الغرم أعوان ، وبالحق قائل ، % وللحق تباع ، وللحرب مصطل % 53(@)(@@) % وللخير كساب ، وللمجد رافع ، % وللحمد أعوان ، وللخيل معتل % % 54(@)(@@) % نبيح حصون من نعادي ، وحصننا % % أشم منيع ، حزنه لم يسهل % 55(@)(@@) % نقود ذليلا من نعادي ، وقرمنا % % أبي القياد ، مصعب لم يذلل % % 56(@)(@@) % نفلل أنياب العدو ، ونابنا % % حديد شديد روقه لم يفلل % 57(@)(@@) % أولئك آبائي ، وعزي ، ومعقلي % % إليهم ، أثيل ، ف سألي أي معقل ! % PageV01P420 البحر : متقارب تام 1(@)(@@) % خليلي ، عوجا بنا ساعة % نحي الرسوم ونؤي الطلل % 2(@)(@@) % ونبك ، وهل يرجعن البكا % % علينا زمانا لنا قد تول % 3(@)(@@) % ليالي سعدى لنا خلة % تواصل في ودنا من نصل % 4(@)(@@) % وتجلو كمزنة غيث ، لها % % غفائر تكسو البطاح النفل % 5(@)(@@) % إذا ما مشت بين أترابها ، % كمثل الإراخ يطأن الوحل % 6(@)(@@) % كأن سوابل مصيوفة % أقام بها كل وحش همل % 7(@)(@@) % سوافر قد زانهن العبير % مع المسك ، مغتنمات الطفل % % 8(@)(@@) % ففاجأنني غير ذي غرة ، % شديد الفقارة بعد النهل % 9(@)(@@) % فحييتهن ، حيينني ، % فعز الفراق علينا وجل % PageV01P421 البحر : خفيف تام 1(@)(@@) % سائلا الربع ب لبلي ، وقولا : % هجت شوقا لنا ، الغداة ، طويلا % % 2(@)(@@) % أين حي حلوك ، إذ انت مح % % ف بهم ، آهل ، أراك جميلا ؟ % 3(@)(@@) % قال : ساروا بأجمع ، ف ستقلوا ، % وبرغمي ، لو استطعت سبيلا % % 4(@)(@@) % سئمونا وما سئمنا ببين ، % وأرادوا دماثة وسهولا % % 5(@)(@@) % ذاك مغنى من آل هند ، وهند % قمرته فؤاده المتبولا % % 6(@)(@@) % إذ تبدت لنا ، فابدت أثيثا ، % حالكا لونه ، وجيدا أسيلا % % 7(@)(@@) % وشتيتا كالأقحوان عذابا ، % لم يغادر به الزمان فلولا % % PageV01P422 البحر : كامل تام 1(@)(@@) % علق النوار فؤاده جهلا % % وصبا ، فلم تترك له عقلا % % 2(@)(@@) % وتعرضت لي في المسير ، فما % % أمسى الفؤاد يرى لها شكلا % % 3(@)(@@) % ما ظبية من وحش ذي بقر % تغذو بسقط صريمة طفلا % % 4(@)(@@) % بألذ منها 
ms102	 ، إذ تقول لنا ، % وأردت كشف قناعها : مهلا ! % 5(@)(@@) % دعنا فإنك لا مكارمة % تجزي ، ولست بواصل حبلا % % 6(@)(@@) % وعليك من تبل الفؤاد ، وإن % أمسى لقلبك ذكره شغلا % % 7(@)(@@) % فأجبتها : إن المحب مكلف ، % فذري العتاب ، وأحدثي بذلا % % PageV01P423 البحر : خفيف تام 1(@)(@@) % حي ربعا أقوى ، ورسما محيلا ، % وعراصا أمست لهند مثولا % % 2(@)(@@) % فعفا الدهر والزمان عليها ، % واجالت بها الرياح ذيولا % % 3(@)(@@) % لست أنسى منها ، عشية رحنا ، % قولها : عج علي منك قليلا % % 4(@)(@@) % أقض من لذتي ، وأعهد ، إني % % لا أرى ذا الصدود منك جميلا % % 5(@)(@@) % وأجبني ، وانت أوجد شيء ، % ولك الود خالصا مبذولا % % 6(@)(@@) % ولك الود دائما ما بقينا ، % قاطعا ، بعد ، كنت لي ، أو وصولا % % 7(@)(@@) % ما تحريت ، إذ عصيت ، ولكن % قلت ما قلت ، فاعلمن تعويلا % % 8(@)(@@) % فاقبل اليوم ما اتاك بشكر ، % لا تكونن للخليل ملولا % % PageV01P424 البحر : كامل تام 1(@)(@@) % يا أهل بابل ما نفست عليكم % من عيشكم إلا ثلاث خلال % 2(@)(@@) % ماء الفرات ، وطيب ليل بارد ، % وسماع منشدتين لابن هلال % % PageV01P425 البحر : طويل 1(@)(@@) % سقى سدرتي أجياد ، فالدومة التي % % إلى الدار ، صوب الساكب المتهلل % 2(@)(@@) % فلو كنت بالدار التي مهبط الصفا % % سلمت ، إذا ما غاب عني معللي % % 3(@)(@@) % هنالك لو أني مرضت لعادني % % كرام ومن ، لا يأت منهن يرسل % PageV01P426 البحر : خفيف تام 1(@)(@@) % حمل القلب من حميدة ثقلا حمل القلب من حميدة ثقلا % % إن في ذاك للفؤاد لشغلا % % 2(@)(@@) % إن فعلت الذي سألت ، فقولي ، % حمد ، خيرا ، أو أتبعي القول فعلا % % 3(@)(@@) % وصليني ، فأشهد الله إني % % لست أصفي سواك ما عشت وصلا % % PageV01P427 البحر : مجزوء الوافر 1(@)(@@) % خليلي ، اربعا ، وسلا % % بمغنى الحي قد مثلا % % 2(@)(@@) % بأعلى ، الواد عند البئ % ر هيج عبرة سبلا % % 3(@)(@@) % وقد تغنى به نعم ، % وكنت بوصلها جذلا % % 4(@)(@@) % ليالي لا نحب لنا % % بعيش قد مضى ، بدلا % % 5(@)(@@) % وتهوانا ونهواها % % ونعصي قول من عذلا % % 6(@)(@@) % وترسل في ملاطفة % ونعمل نحوها الرسلا % % PageV01P428 البحر : سريع 1(@)(@@) % إعتاد هذا القلب بلباله ، % إذ قربت للبين أجماله % 2(@)(@@) % خود ، إذا قامت إلى خدرها ، % قامت قطوف المشي ، مكساله % 3 
ms103	(@)(@@) % تفتر عن ذي أشر بارد ، % عذب ، إذا ما ذيق سلساله % PageV01P429 البحر : خفيف تام 1(@)(@@) % إن من أكبر الكبائر عندي % % قتل بيضاء حرة عطبول % 2(@)(@@) % قتلت باطلا ، على غير ذنب ، % إن لله درها من قتيل % 3(@)(@@) % كتب القتل والقتال علينا ، % وعلى الغانيات جر الذيول % PageV01P430 البحر : طويل 1(@)(@@) % كفيت أخي العذري ما كان نابه % وإني لاعباء النوائب حمال % 2(@)(@@) % أما استحسنت مني المكارم والعلى ، % إذا طرحت ، إني لمالي بذال ؟ % PageV01P431 البحر : طويل 1(@)(@@) % ديار لسعدى ، إذ سعاد جداية ، % من الأدم ، خمصان الحشى غير خنثل % 2(@)(@@) % هجان البياض أشربت لون صفرة ، % عقيلة جو عازب ، لم يحلل % 3(@)(@@) % إذا هي لم تستك بعود أراكة % تنخل ، فاستاكت به ، عود إسحل % PageV01P432 البحر : خفيف تام 1(@)(@@) % قلت ، إذ أقبلت وزهر تهادى ، % كنعاج الملا تعسفن رملا % % 2(@)(@@) % قد تنقبن بالحرير ، وأبدي % % ن عيونا حور المدامع ، نجلا % % PageV01P433 البحر : كامل تام 1(@)(@@) % نزلت بمكة من قبائل نوفل ، % ونزلت خلف البئر ، أبعد منزل % % 2(@)(@@) % حذرا عليها من مقالة كاشح ، % ذرب اللسان ، يقول ما لم نفعل % % PageV01P434 البحر : طويل 1(@)(@@) % تشكى الكميت الجري لما جهدته ، % وبين لو يسطيع أن يتكلما % % 2(@)(@@) % فقلت له : إن ألق للعين قرة % فهان علينا أن تكل وتسأما % % 3(@)(@@) % عدمت إذا وفري ، وفارقت مهجتي ، % لئن لم أقل قرنا ، إذا الله سلما % % 4(@)(@@) % لذلك أدني ، دون خيلي ، رباطه % وأوصي به أن لا يهان ويكرما % % 5(@)(@@) % فما راعها إلا الأغر كأنه % عقاب هوت منقضة قد رأت دما % % 6(@)(@@) % فقلت لهم : كيف الثريا ، هبلتم ، % فقالوا : ستدري ، ما نكرنا ، وتعلما % % 7(@)(@@) % هنالك فانزل ، فاسترح ، فإذا بدت % ثرياك في اترابها الحور كالدمى % % 8(@)(@@) % يردن اجتياز السر منك ، فلا تبح % % بما لم تكن عنه لدينا مجمجما % % PageV01P435 البحر : طويل 1(@)(@@) % ألا يا لقومي للهوى المتقسمش ، % وللقلب ، في ظلماء سكرته ، العمي % % 2(@)(@@) % وللحين أنى ساقني ، فاتاحني % % لأحبلها من بين مثر ومعدم % 3(@)(@@) % أقاد دمي بكر على غير ظنة ، % ولم يتأثم قاتلا غير منعم % % 4(@)(@@) % فقلت لبكر عاجبا : أتجلدتء ، % لك الخير أم لا تطمع الصيد أسهمي ؟ % 5(@)(@@) % وما ذاك 
ms104	 إلا تعلم النفس أنه % إلى مثلها يصبو فؤاد المتيم % % 6(@)(@@) % وإني لها من فرع فهر بن مالك % ذراه ، وفرع المجد للمتوسم % % 7(@)(@@) % على أنها قالت له : لست نائلاص % % لنا ظنة ، إلا لقاء بموسم % 8(@)(@@) % وقلت لبكر ، حين رحنا عشية : % عن السر لا تقصر ولا تتقدم % 9(@)(@@) % لعلي ستنبيني الجواري من لتي % % رأت عندها قلبي ، فلم تتألم % 10(@)(@@) % فليت منى لم تجمع العام بيننا ، % ولم يك لي حج ولم نتكلم % PageV01P436 11(@)(@@) % وليت لتي عاصيت فيها عواذلي % % لها قبلت عقلا ، ولم تتحمل دمي % % 12(@)(@@) % فرحنا بقصر نتقي العين والريا % % وقول العدو الكاشح المتنمم % % 13(@)(@@) % وفي العين مرجو ، وى خر يتقى ، % فيا لك أمرا ، بين بؤسي وأنعم % 14(@)(@@) % فلما كفهر الليل ، قالت لخرد ، % كواعب ، في ريط ، وعصب مسهم % % 15(@)(@@) % نواعم قب بدن صمت البرى % % ويملأن عين الناظر المتوسم % 16(@)(@@) % رواجح اكفال تباهين ، قولها % % لديهن مقبول على كل مزعم : % 17(@)(@@) % لقد خلجت عيني ، وأحسب أنها % % لقرب أبي الخطاب ، ذلك مزعمي % % 18(@)(@@) % فقلن لها : أمنية أو مزاحة % أردت بها عيب الحديث المرجم % 19(@)(@@) % فقالت لهن : اذهبن - : آمرنا معا % لأمرك مجنوب تبوع ، فقدمي % % 20(@)(@@) % أمامك من يرعى الطريق ، فأرسلت % فتاة حصانا عذبة المتبسم % PageV01P437 21(@)(@@) % وقالت لها : إمضي ، فكوني أمامنا % % لحفظ الذي نخشى ، ولا تتكلمي % % 22(@)(@@) % فقامت ولم تفعل ، ونامت فلم تطق ، % فقلن لها : قومي ، فقامت ولم لم % 23(@)(@@) % تبن ، غير أن قد اومأت ، فعمدنها ، % كشارب مكنون الشراب المختم % 24(@)(@@) % فلما التقينا باح كل بسره % وأبدى لها منى السرور تبسمي % % 25(@)(@@) % فيا لك ليلا بت فيه موسدا % إذا شئت ، بعد النوم ، أكرم معصم % 26(@)(@@) % وأسقى بعذب بارد الريق واضح % لذيذ الثنايا ، طيب المتنسم % % PageV01P438 البحر : طويل 1(@)(@@) % ألا قل لهندس : إحرجي وتأثمي ، % ولا تقتليني ، لا يحل لكم دمي % % 2(@)(@@) % وحلي حبال السحر عن قلب عاشق % حزين ، ولا تستحقبي قتل مسلم % % 3(@)(@@) % فأنت ، وبيت الله ، همي ومنيتي % % وكبر منانا من فصيح واعجم % 4(@)(@@) % فوالله ، ما أحببت حبك أيما ، % ولا ذات بعل ، يا هنيدة ، فاعلمي % % 5(@)(@@) % فصدت وقالت : كاذرب ! وتجهمت 
ms105	 ، % فنفسي فداء المعرض المتجهم % 6(@)(@@) % فقالت ، وصدت : ما تزال متيما ، % صبوبا بنجد ، ذا هوى متقسم % % 7(@)(@@) % ولما التقينا بالثنية ش ، أومضت ، % مخافة عين الكاشح المتنمم % % 8(@)(@@) % أشارت بطرفش العين خشية أهلها ، % إشارة محزون ، ولم تتكلم % % 9(@)(@@) % فأيقنت أن الطرف قد قال : مرحبا ، % وأهلا وسهلا ب لحبيب المتيم % 10(@)(@@) % فأبرزت طرفي نحوها بتحية ، % وقلت لها قول امرىء غير مفحم % % PageV01P439 11(@)(@@) % وإني لأذري ، كلما هاج ذكركم ، % دموعا أغصت لهجتي بتكلم % 12(@)(@@) % وأنقاد طوعا للذي أنت أهله % على غلظة منكم لنا ، وتجهم % % 13(@)(@@) % ألام على حبي ، كأني سننته ، % وقد سن هذا الحب من قبل جرهم % % 14(@)(@@) % وقالت : أطعت الكاشحين ، ومن يطع % مقالة واش كاذب القول يندم % 15(@)(@@) % وصرمت حبل الود من ودك الذي % % حباك بمحض الود ، قبل لتفهم % % 16(@)(@@) % فقلت : اسمعي يا هند ثم تفهمي % % مقالة محزون بحبك مغرم % 17(@)(@@) % لقد مات سري و ستقامت مودتي ، % ولم ينشرح ب لقول يا حبتي فمي % % 18(@)(@@) % فإن تقتلي في غير ذنب ، أقل لكم % مقالة مظلوم مشوق متيم % 19(@)(@@) % هنيئا لكم قتلي ، وصفو مودتي ، % فقد سيط من لحمي هواك ، ومن دمي % % PageV01P440 البحر : رمل تام 1(@)(@@) % لمن الدار كخط ب لقلم ، % لم يغير رسمها طول القدم % 2(@)(@@) % صاح إني شفني طول السقم ، % وصبا القلب إلى أم الحكم % 3(@)(@@) % وصبا القلب إلى بهنانة ، % مثل قرن الشمس يبدو في الظلم % % 4(@)(@@) % ما رأت عيني لها ، فيما ترى ، % شبها في أهل حل وحرم % 5(@)(@@) % وطري ، حسن تقويسه ، % زانها ذاك ، وعرنين أشم % 6(@)(@@) % وبثغر واضح أنيابه ، % طيب الريح ، جميل المبتسم % PageV01P441 البحر : كامل تام 1(@)(@@) % من عاشق ، كلف الفؤاد ، متيم % يهدي السلام إلى المليحة كلثم % 2(@)(@@) % ويبوح ب لسر المصون ، وب لهوى % % يدري ، ليعلمها بما لم تعلم % 3(@)(@@) % كي لا تشك على التجنب انها % % عندي بمنزلة المحب المكرم % % 4(@)(@@) % أخذت من القلب العميد بقوة ، % ومن الوصال بمتن حبل مبرم % 5(@)(@@) % وتمكنت في النفس ، حيث تمكنت % نفس المحب من الحبيب المغرم % % 6(@)(@@) % ولقد قرأت كتابها ، ففهمته ، % لو كان غير كتابها لم افهم % % 7 
ms106	(@)(@@) % عجمت عليه بكفها ، وبنانها ، % من ماء مقلتها بغير المعجم % 8(@)(@@) % ومشى الرسول بحاجة مكتومة ، % لولا ملاحة بعضها لم تكتم % 9(@)(@@) % في غفلة ممن نحاذر قوله ، % وسواد ليل ، ذي دواج ، مظلم % % 10(@)(@@) % ديني ودينك يا كليثم واحد ، % نرفض ، وقيتك ، ديننا ، أو نسلم % % PageV01P442 البحر : طويل 1(@)(@@) % رأيت بجنب الخيف هندا ، فراقني % % لما هيد ريم زينته الصرائم % 2(@)(@@) % وذو أشر عذب كأن نباته % جنى أقحوان ، نبته متناعم % 3(@)(@@) % نظرت إليها ب لمحصبه من منى % % ولي نظر ، لولا التحرج ، عارم % % 4(@)(@@) % فقلت : أشمس أم مصابيح بيعة ، % بدت لك تحت السجف أم انت حالم ؟ % 5(@)(@@) % مهفهفة ، غراء صفر وشاحها ، % وفي المرط منها أهيل متراكم % % 6(@)(@@) % بعيدة مهوى القرط ، إما لنوفل % أبوها ، وإما عبد شمس ، وهاشم % 7(@)(@@) % ومد عليها السجف يوم لقيتها ، % على عجل ، تباعها والخوادم % % 8(@)(@@) % فلم استطعها غير أن قد بدا لنا ، % عشية راحت ، كفها والمعاصم % % 9(@)(@@) % معاصم لم تضرب على البهم ب لضحى % % عصاها ، ووجه لم تلحه السمائم % 10(@)(@@) % نضير ، ترى فيه أساريع مائه ، % صبيح ، تغاديه الاكف النواعم % % PageV01P443 11(@)(@@) % إذا ما دعت أترابها ، ف كتنفنها ، % تمايلن أو مالت بهن المآكم % 12(@)(@@) % طلبن الصبا حتى إذا ما أصبنه % نزعن ، وهن المسلمات الظوالم % % 13(@)(@@) % فذكرتها داء قديما مخامرا % تقطع منه إن ذكرن الخيازم % 14(@)(@@) % وقربك لا يجدي علي ، ونأيكم % جوى داخل في القلب يا هند لازم % % 15(@)(@@) % فإن بنت كدرت المعاش صبابة ، % وإن تصقبي فالقلب حيران هائم % % 16(@)(@@) % وقد زعمت أن الذي وجدت بنا % % مقيم لنا في أسود القلب ، دائم % % PageV01P444 البحر : طويل 1(@)(@@) % أقل الملام ، يا عتيق ، فإنني % % بهند ، طوال الدهر ، حران هائم % 2(@)(@@) % فقض ملامي ، و طلب الطب ، إنني % % أسر جوى في حبها ، فهو رازم % 3(@)(@@) % فقال : عليك اليوم أسماء ، إنها % % أطب بهذا ، والمباطن عالم % % 4(@)(@@) % فقلت لأسماء اشتكاء ، وأخضلت % مسارب عيني الدموع السواجم % 5(@)(@@) % أبيني لنا ، كيف السبيل إلى التي % % نأت غربة عنا بها ما تلائم % 6(@)(@@) % فقالت ، وهزت رأسها : لو أطعتنا ، % تجنبتها أيام قلبك سالم % % 7(@)(@@) % ولكن دعت للحين عين مريضة ، % فطاوعتها 
ms107	 ، عمدا ، كأنك حالم % 8(@)(@@) % وكنت تبوعا للهوى ، مصحبا له ، % إذا أعجبتك الآنسات النواعم % 9(@)(@@) % تكلف أفراس الصبى ، تعبا له ، % ولست تبالي أن تلوم اللوائم % 10(@)(@@) % ووكلت أفراس الصبى بطلابها % % زمانا ، فقد هانت عليك الملاوم % PageV01P445 11(@)(@@) % وعلقتها ، أيام قلبك موثق % لديها ، فدعها الآن ، إذ أنت سالم % % 12(@)(@@) % فقلت لها : أنى سلمت ، وحبها % % جوى لبنات القلب ، يا أسم ، لازم % % 13(@)(@@) % وأنى سلو القلب عنها ، وقد سبا % % فؤادي منها ذو غدائر فاحم % 14(@)(@@) % وجيد غزال فائق الدر حليه ، % ورخص لطيف ، واضح اللون ، ناعم % PageV01P446 البحر : سريع 1(@)(@@) % يا من لقلب دنف مغرمش ، % هام إلى هند ، ولم يظلم % 2(@)(@@) % هام إلى رئم هضيم الحشا ، % عذب الثنايا ، طيب المبسم % % 3(@)(@@) % كالشمس بالأسعد ، إذ أشرقت ، % في يوم دجن ، بارد ، مقتم % % 4(@)(@@) % لم أحسب الشمس بليل بدت % قبلي ، لذي لحم ، ولا ذي دم % 5(@)(@@) % قالت ، وقد جد رحيل بها ، % و لعين إن تطرف بها ، تسجم % 6(@)(@@) % إن ينسنا الموت ، ويؤذن لنا ، % نلقك ، إن عمرت ب لموسم % 7(@)(@@) % إن لم تحل ، أو تك ذا ميلة ، % بطرفك الأدنى على الأقدم % 8(@)(@@) % قلت لها : بل أنت معتلة % في الوصل ، يا هند ، لكي تصرمي % % PageV01P447 البحر : طويل 1(@)(@@) % ألما بذات الخال ، فاستطلعا لنا % % على العهد ، باق ودها أم تصرما % % 2(@)(@@) % وقولا لها : إن النوى أجنبية % بنا ، وبكم ، قد خفت أن تتتمما % % 3(@)(@@) % شطون بأهواء نرى أن قربنا % % وقربكم ، إن يشهد الناس موسما % % 4(@)(@@) % وقولا لها : لا تقبلي قول كاشح ، % وقولي له ، إن زل : أنفك أرغما % % 5(@)(@@) % وقولا لها : لم يسلنا النأي عنكم ، % ولا قول واش كاذب إن تنمما % % 6(@)(@@) % وقولا لها : ما في العباد كريمة % أعز علينا منك طرا وأكرما % % 7(@)(@@) % وقولا لها : لا تسمعن لكاشح % مقالا ، وإن أسدى لديك وألحما % % 8(@)(@@) % وقولا لها : لم اجن ذنبا ، فتعتبي % % علي بحق ، بل عتبت تجرما % % 9(@)(@@) % فقالا لها ، فآرفض فيض دموعها ، % كما أسلم السلك الجمان المنظما % % 10(@)(@@) % تحدر غصن البان لانت فروعه ، % وجادت عليه ديمة ، ثم أرهما % % PageV01P448 11(@)(@@) % فلما رأت عيني عليها ، تهللت % مخافة أن 
ms108	 ينهل كرها ، تبسما % % 12(@)(@@) % وقالت لأختيها : اذهبا في حفيظة ، % فزورا أبا الخطاب سرا ، وسلما % % 13(@)(@@) % وقولا له : والله ما الماء للصدى ، % بأشهى إلينا من لقائك ، فاعلما % % 14(@)(@@) % وقولا له : ما شاع قول محرش % لدي ، ولا رام الرضا ، أم ترغما % % 15(@)(@@) % وقولا له : إن تجن ذنبا أعده % % من العرف إن رام الوشاة التكلما % % 16(@)(@@) % فقلت : اذهبا قولا لها : أنت همه ، % وكبر مناه من فصيح وأعجما % % 17(@)(@@) % إذا بنت بانت لذة العيش و لهوى % % وإن قربت دار بكم ، فكأنما % % 18(@)(@@) % يرى نعمة الدنيا حتواها لنفسه % يرى اليأس غبنا و قترابك مغنما % % 19(@)(@@) % فلم تفضلينا في هوى ، غير أننا % % نرى ودنا أبقى بقاء ، وأدوما % % PageV01P449 البحر : طويل 1(@)(@@) % وآخر عهدي بالرباب مقالها ، % لنا ليلة البطحاء ، والدمع يسجم : % 2(@)(@@) % طربت ، وطاوعت الوشاة ، وبينت % شمائل من وجد ، ففيم التجرم ؟ % 3(@)(@@) % هلم فأخبرني بذنبي ، أعترف % بعتباك ، أو أعرف إذا كيف أصرم % % 4(@)(@@) % فإن كان في ذنب إليك اجترمته ، % تعمدته عمدا ، فنفسي ألوم % % 5(@)(@@) % وإن كان شيئا قاله لك كاشح ، % كما شاء يسديه علي ، ويلحم % % 6(@)(@@) % فصدقته ، لم أستطع أن أرده ، % ولم أملك الأعداء أن يتكلموا % % 7(@)(@@) % فقلت ، وكانت حجة وافقت بها ، % من الحق عندي بعض ما كنت أعلم : % 8(@)(@@) % صدقت ، ومن يعلم فيكتم شهادة % على نفسه أو غيره ، فهو أظلم % % 9(@)(@@) % فأما الذي فيه عتبت ، فأنفه % % لأنفك في صرم الخلائق أرغم % % 10(@)(@@) % فعتباك مني أنني غير عائد ، % وأقسم بالرحمن لا نتكلم % % PageV01P450 11(@)(@@) % وقلت لها : لو يسلك الناس واديا % وتنحين نحو الشرق عما تيمموا % % 12(@)(@@) % لكلفني قلبي أتابعك ، إنني % % بذكراك أخرى الدهر ، صب متيم % 13(@)(@@) % أرى ما يلي نجدا ، إذا ما حللته ، % جميلا ، وأهوى الغور إن تتتهموا % % PageV01P451 البحر : طويل 1(@)(@@) % يلومونني في غير ذنب جنيته ، % وغيري ، في كل الذي كان ، الوم % 2(@)(@@) % أمنت اناسا أنتم تأمنونهم ، % فزادوا علينا في الحديث ، وأوهموا % % 3(@)(@@) % وقالوا لنا ما لم نقل ، ثم أكثروا % % علينا ، وباحوا بالذي كنت اكتم % % 4(@)(@@) % وقد كحلت عيني القذى لفراقكم ، % وعاد لها تهتانها فهي تسجم % 5(@)(@@) % فلا تصرميني 
ms109	 ، إن تريني أحبكم ، % أبوء بذنبي ، إنني أنا أظلم % 6(@)(@@) % منعمة ، لو دب ذر بجسمها ، % لكاد دبيب الذر في الجسم يكلم % 7(@)(@@) % أليس كثيرا أن نكون ببلدة ، % كلانا بها ثاو ، ولا نتكلم ؟ % PageV01P452 البحر : طويل 1(@)(@@) % ذهبت ولم تلمم بديباجة الحرم ، % وقد كنت منها في عناء وفي سقم % 2(@)(@@) % جننت بها ، لما سمعت بذكرها ، % وقد كنت مجنونا بجاراتها القدم % PageV01P453 البحر : طويل 1(@)(@@) % هجرت الحبيب اليوم من غير ما اجترم ، % وقطعت ، من ودي لك ، الحبل ف نصرم % 2(@)(@@) % أطعت الوشاة الكاشحين ، ومن يطع % مقالة واش ، يقرع السن من ندم % 3(@)(@@) % أتاني رسول ، كنت أحسب أنه % شفيق علينا ناصح ك لذي زعم % 4(@)(@@) % فلما تباثثنا الحديث ، وبينت % سريرته أبدى الذي كان قد كتم % 5(@)(@@) % تبين لي ان المحرش كاذب ، % ومن يطع الواشين أو زعم من زعم % % 6(@)(@@) % يصرم بظلم حبله من خليله % وشيكا ، ويجذم قوة الحبل ما جذم % % 7(@)(@@) % وقلت لها لما خشيت لجاجة : % فعندي لك العتبى على رغم من رغم % % 8(@)(@@) % ظلمت ، ولم تعتب ، وكان رسولها % % إليك ، سريعا ب لرضا لك ، إذ ظلم % 9(@)(@@) % فلم أر لوم النفس بعد الذي مضى ، % وبعد الذي آلت وآليت من قسم % 10(@)(@@) % إذا انت لم تعشق ، ولم تتبع الهوى ، % فكن صخرة ب لحجر من حجر أصم % % PageV01P454 البحر : طويل 1(@)(@@) % خليلي ، عوجا نبك شجوا على رسم % عفا بين واد للعشيرة ف لحزم % 2(@)(@@) % خليلي ، ما كانت تصاد مقاتلي ، % ولا غرتي ، حتى وقعت على نعم % 3(@)(@@) % خليلي ، حتى لف حبلي بخادع % موقى إذا يرمى ، صيود إذا يرمي % % 4(@)(@@) % خليلي ، إن باعدت لانت ، وإن ألن % تباعد ، فما ترجى لحرب ولا سلم % % 5(@)(@@) % خليلي ، إن الحب أحسب قاتلي ، % فقاض على نفسي كما قد برى عظمي % % 6(@)(@@) % خليلي ، من يكلف بآخر كالذي % % كلفت به يدمل فؤادا على سقم % 7(@)(@@) % خليلي ، بعض اللوم ، لا ترحلا به % % رفيقكما ، حتى تقولا على علم % 8(@)(@@) % خليلي ، ما حب كحب أحبه ، % ولا داء ذي حب كدائي ولا همي % % 9(@)(@@) % خليلي ، قد أعيا العزاء ، فخففا % % ولا تبديا لومي 
ms110	 ، فينبيكما جسمي % % 10(@)(@@) % خليلي ، منا لا تكونا مع العدى ، % وما اللوم ب لمسلي فؤادي من الغم % PageV01P455 11(@)(@@) % خليلي ، لو يرقى خليل من الهوى ، % رقيت بما يدني النوار من العصم % % PageV01P456 البحر : طويل 1(@)(@@) % دعاني إلى أسماء عن غير موعد % صروف منايا كان وقفا حمامها % % 2(@)(@@) % فلما لتقينا ، شف برد محقق % عن الشمس ، جلى يوم دجن غمامها % % 3(@)(@@) % وقلن لها والعين حولك جمة ، % ومثلك باد ، مستثار مقامها : % 4(@)(@@) % أيخفى لنا وللمغيري مجلس ، % فإن النوى كانت قليلا لمامها % % 5(@)(@@) % بنا وبه فاربعن ، نعهد مسلما ، % عسى أن يقضى من نفوس سقامها % % 6(@)(@@) % فقلن : عديه دلجة الركب ، إنه % سيسترنا عن عين أرض ظلامها % % PageV01P457 البحر : طويل 1(@)(@@) % بوجرة أطلال تعفت رسومها ، % وأقفر من بعد الأنيس قديمها % % 2(@)(@@) % تلوح على طول الزمان عراصها ، % كما لاح في كف الفتاة وشومها % % 3(@)(@@) % وقفت بها ، والعين شاملة القذى ، % كعين طريف ما يجف سجومها % % 4(@)(@@) % فذلك هاج الشوق من ام نوفل ، % وذكرى لنفس جمة ما تريمها % % 5(@)(@@) % فقد ادركت عندي من الود فوق ما % % تمنت بغيب ، أو تمنى حميمها % % 6(@)(@@) % وإن قاسمت في وده ، ذهبت به % جميعا ، ولم يرجع بشيء قسيمها % % PageV01P458 البحر : طويل 1(@)(@@) % أباكرة في الظاعنين رميم ، % ولم يشف متبول الفؤاد ، سقيم ؟ % 2(@)(@@) % أم اتعد الحي الرواح ، فإنني % % لكل الذي ينوي الأمير وجوم % 3(@)(@@) % فراحوا ، وراحت ، و ستمرت كأنها % % غمامة دجن تنجلي ، وتغيم % 4(@)(@@) % مبتلة ، صفراء ، مهضومة الحشا ، % غذاها سرور دائم ، ونعيم % % 5(@)(@@) % قد اعتدلت فالنصف من غصن بانة % ونصف كثيب لبدته سجوم % % 6(@)(@@) % منعمة ، أهدى لها الجيد شادن ، % وأهدت لها العين القتول بغوم % 7(@)(@@) % تراخت بها دار ، وأصبحت العدى % % لديها ، كما شاؤوا ، وقال نموم % % 8(@)(@@) % رميم لتي قالت لجارات بيتها : % ضمنت لكم أن لا يزال يهيم % % 9(@)(@@) % ضمنت لكم أن لا يزال كأنه ، % لطيف خيال من رميم غريم % 10(@)(@@) % وقالت لأتراب لها شبه الدمى ، % تنكبن شيئا ، والدموع سجوم % % PageV01P459 11(@)(@@) % وللفتية : نحازوا قليلا فإنه % لنا في أمور قد خلون ظلوم % % PageV01P460 البحر : وافر تام 1(@)(@@) % أقول لصاحبي ، ومثل ما بي ، % شكاه 
ms111	 المرء ذو الوجد الأليم % 2(@)(@@) % إلى الأخوين مثلهما إذا ما % % تأوبه مؤرقة الهموم % 3(@)(@@) % لحيني والبلاء لقيت ظهرا ، % بأعلى النقع ، أخت بني تميم % 4(@)(@@) % فلما أن بدا للعين منها % % أسيل الخد ، في خلق عميم % 5(@)(@@) % وعينا جؤذر خرق ، وثغر % كمثل الأقحوان ، وجيد ريم % 6(@)(@@) % حنا أترابها دوني عليها % % حنو العائدات على سقيم % 7(@)(@@) % عقائل لم يعشن بعيش بؤس ، % ولكن ب لغضارة والنعيم % % PageV01P461 البحر : كامل تام 1(@)(@@) % يا صاح ، قل للربع : هل يتكلم ، % فيبين عما سيل ، أو يستعجم % 2(@)(@@) % فثنى مطيته علي ، وقال لي : % اسأل ، وكيف يبين رسم أعجم ؟ % 3(@)(@@) % درجت عليه العاصفات فقد عفت % آياته ، إلا ثلاث جثم % % 4(@)(@@) % عجت القلوص به ، وعرج صحبتي % % وكففت غرب دموع عين تسجم % 5(@)(@@) % أدم الظباء به تراعي خلفة % وسخالها في رسمه تتبغم % 6(@)(@@) % وثنى صبابة قلبه بعد البلى % % ورقاء ظلت في الغصون ترنم % 7(@)(@@) % غردت على فنن ، فأسعد شجوها % % ورق يجبن ، كما ستجابب المأتم % 8(@)(@@) % هل عيشنا بمنى يعود كعهدنا ، % إذ لا نراع ، ولا يطاع اللوم % % 9(@)(@@) % أيام هند لا تطيع محرشا ، % خطل المقال ، وسرنا لا يعلم % % 10(@)(@@) % وعشية حبست ، فلم تفتح فما % بكلامها من كاشح يتنمم % PageV01P462 11(@)(@@) % نظرت إليك ، وذو شبام دونها ، % نظرا يكاد بسرها يتكلم % % 12(@)(@@) % فأبان رجع الطرف أن لا ترحلن % حتى يجن الناس ليل مظلم % % 13(@)(@@) % فلعل غب الليل يستر مجلسا ، % فيه يودع عاشق ، ويسلم % % 14(@)(@@) % فأتيت أمشي ، بعدما نام العدى ، % وأجنهم للنوم جونق أدهم % 15(@)(@@) % فإذا مهاة ، في مها ، بخميلة ، % أدم ، أطاع لهن واد ملحم % 16(@)(@@) % حيينها فتبسمت ، فكأنها % % عند التبسم مزنة تتبسم % 17(@)(@@) % وتضوعت مسكا وسر فؤادها % % فسرورها باد لمن يتوسم % % 18(@)(@@) % فغنيت جذلانا ، وقد جذلت بنا % % نبغي بذلك رغم من يترغم % % 19(@)(@@) % ثم انصرفت ، وكان آخر قولها % % أن سوف يجمعنا إليك الموسم % PageV01P463 البحر : كامل تام 1(@)(@@) % قل للمنازل بالكديد : تكلمي ، % درست ، وعهد جديدها لم يقدم % 2(@)(@@) % لعبت بجدتها الرياح وتارة % تعتادها ديم بأسحم مرهم % 3(@)(@@) % دار التي صادت فؤادك ، إذ بدت % بالخيف ، لما التف أهل الموسم 
ms112	 % % 4(@)(@@) % قالت لآنسة رداح عندها % % ك لرئم في عقد الكثيب الأيهم % 5(@)(@@) % هذا الذي منح الحسان فؤاده ، % وشركنه في مخه والأعظم ؟ % 6(@)(@@) % قالت : نعم ، فتنكبي بي ، إنه % % ذرب اللسان ، إخاله لم يسلم % % 7(@)(@@) % فبعثت جاريتي ، فقلت لها : ذهبي % % فاشكي إليها ما علمت وسلمي % % 8(@)(@@) % قولي : يقول : تحوبي في عاشق ، % كلف بكم حتى الممات متيم % 9(@)(@@) % فكي رهينته ، فإن لم تفعلي ، % ف بكي على قتل بن عمك و سلمي % % 10(@)(@@) % ويقول إنك قد علمت بأنكم % أصبحتم يا بشر أوجه ذي دم % % PageV01P464 11(@)(@@) % فتبسمت عجبا ، وقالت : حقه % أن لا يعلمنا بما لم نعلم % % 12(@)(@@) % علمي به ، والله يغفر ذنبه ، % فيما بدا لي ذو هوى متقسم % % 13(@)(@@) % طرف ينازعه إلى الأدنى الهوى ، % ويبت خلة ذي الوصال الأقدم % % 14(@)(@@) % وتغاطست عما بنا ، ولقد ترى % % أن قد تخللت الفؤاد بأسهم % % 15(@)(@@) % قالت لها : ماذا أرد على فتى ، % أقصدته بعفافة وتكرم ؟ % 16(@)(@@) % قالت أقول له بأنك مازح % كلف بكل مغور ومتهم % 17(@)(@@) % قالت لها : بل قد أردت بعاده ، % لما عرفت بأن ملكت ، فتممي % % PageV01P465 البحر : كامل تام 1(@)(@@) % باسم الإله ، تحية لمتيم ، % تهدى إلى حسن القوام مكرم % 2(@)(@@) % وصحيفة ضمنتها بأمانة ، % عند الرحيل ، إليك ، أم الهيثم % 3(@)(@@) % فيها التحية ، والسلام ، ورحمة ، % حف الدموع كتابها ب لمعجم % 4(@)(@@) % من عاشق كلف يبوء بذنبه ، % صب الفؤاد معاقب لم يظلم % 5(@)(@@) % بادي الصبابة ، قد ذهبت بعقله ، % كلف بحبك ، يا عثيم ، متيم % 6(@)(@@) % يشكو إليك بعبرة وبعولة % ويقول : أما إذ مللت ، فأنعمي % % 7(@)(@@) % لا تقتليني ، يا عثيم ، فإنني % % أخشى عليك عقاب ربك في دمي % % 8(@)(@@) % إن لم يكن لك رحمة وتعطف ، % فتحرجي من قتلنا أن تأثمي % % 9(@)(@@) % لم يخط سهمك ، إذ رميت مقاتلي ، % وتطيش عنك ، إذا رميتك ، أسهمي % % 10(@)(@@) % ووجدت حوض الحب ، حين وردته ، % مر المذاقة ، طعمه كالعلقم % % PageV01P466 11(@)(@@) % لا والذي بعث النبي محمدا % ب لنور والإسلام دين القيم % 12(@)(@@) % وبما أهل به الحجيج وكبروا ، % عند المقام وركن بيت المحرم % % 13(@)(@@) % والمسجد الأقصى المبارك حوله ، % والطور ، حلفة صادق لم يأثم % % 14 
ms113	(@)(@@) % ما خنت عهدك ، يا عيثم ، ولا هفا % % قلبي إلى وصل لغيرك فاعلمي % % 15(@)(@@) % فكي أسيرا ، يا عيثم ، فإنه % خلط الحياء بعفة وتكرم % 16(@)(@@) % ورعى الأمانة ، في المغيب ، ولم يخن % غيب الصديق ، وذاك فعل المسلم % 17(@)(@@) % أحصيت خمسة أشهر معدودة % وثلاثة ، من بعدها ، لم توهم % % 18(@)(@@) % هذي ثمانية تهل وتنقضي ، % عالجت فيها سقم صب مغرم % 19(@)(@@) % مكث الرسول لديكم ، حتى إذا % % قدم الرسول ، وليته لم يقدم % % 20(@)(@@) % لم يأتني لكم بخط واحد % يشفي غليل فؤادي المتقسم % % PageV01P467 21(@)(@@) % وحرمتني رد السلام ، وما أرى % % رد السلام على الكريم بمحرم % % 22(@)(@@) % إن كنت عاتبة علي ، فأهل ما % % أن تعتبي فيما عتبت وتكرمي % % 23(@)(@@) % أنت الأميرة ، ف سمعي لمقالتي % % وتفهمي من بعض ما لم تفهمي % % 24(@)(@@) % إني أتوب إليك توبة مذنب % يخشى العقوبة من مليك منعم % 25(@)(@@) % حتى انال رضاك ، حيث علمته ، % بطريف مالي والتليد الأقدم % % 26(@)(@@) % وأعوذ منك بك ، الغداة ، لتصفحي % % عما جنيت من الذنوب ، وترحمي % % 27(@)(@@) % إن تقبلي عذري ، فلست بعائد ، % حتى تغادر في المقابر أعظمي % % 28(@)(@@) % لو كفي اليمنى سأتك قطعتها % % ولذقت ، بعد رضاك ، عيش الأجذم % PageV01P468 البحر : خفيف تام 1(@)(@@) % ذكرتني الديار شوقا قديما % % بين خيص ، وبين أعلى يسوما % % 2(@)(@@) % بالشليل الذي أتى عن يميني ، % قد تعفت إلا ثلاثا جثوما % % 3(@)(@@) % وقليبا مسحجا أوطن العر % % صة ، فردا ، أبى بها أن يريما % % 4(@)(@@) % وعراصا تذري الرياح عليها % % ذا بروق جونا أجش هزيما % % 5(@)(@@) % ودعاء الحمام تدعو هديلا ، % بين غصنين ، هاج قلبا سقيما % % 6(@)(@@) % غردا ، فاستمعت للصوت ، فانهل % % ت دموعي حتى ظللت كظيما % % 7(@)(@@) % عجت فيه ، وقلت للركب : عوجوا ، % ودموع العينين تذرى سجوما % % 8(@)(@@) % فثنوا هزة المطي ، وقالوا : % كيف نرجو من عرصة تكليما ! ؟ % 9(@)(@@) % ومقاما قمنا به ، نتقي العي % ن ، لهونا به ، وذقنا النعيما % % 10(@)(@@) % من لدن فحمة العشاء إلى أن % لاح ورد يسوق جونا بهيما % % PageV01P469 11(@)(@@) % وقمير بدا ابن خمس وعش % % ن له قالت الفتاتان : قوما % % 12(@)(@@) % ثم قالت ، ودمعها يغسل الكح % % ل مرارا ، يخال درا نظيما % % 13(@)(@@) % لا يكونن آخر العهد هذا 
ms114	 ، % يا ابن عمي ، ولا تطيعن نموما % % 14(@)(@@) % ثم قالت لتربها : إن قلبي % % من هواه أمسى مصابا كليما % % 15(@)(@@) % رب ليل ، سمرت فيه ، قصير % % PageV01P470 البحر : خفيف تام 1(@)(@@) % يا ثريا الفؤاد ردي السلاما % % وصلينا ، ولا تبتي الزماما % % 2(@)(@@) % و ذكري ليلة المطارف والوب % وإرسالنا إليك الغلاما % % 3(@)(@@) % بحديث ، إن أنت لم تقبليه ، % لم أنازعك ، ما حييت ، الكلاما % % 4(@)(@@) % و ذكري مجلسا لدى جانب القص % ر عشيا ومقسمي أقساما % % 5(@)(@@) % في ليال منهن ليلة باتت % ناقتي والها ، تجر الزماما % % 6(@)(@@) % يغسل القطر رحلها ، لا أبالي % % أن تبل السماء عضبا حساما % % 7(@)(@@) % إن تكوني نزحت أو قدم العه % د فما زايل الوداد العظاما % % 8(@)(@@) % من يكن ناسيا فلم أنس منها % % وهي تذري لذاك دمعا سجاما % % 9(@)(@@) % يوم قالت ، ودمعها يغسل الكح % ل : أردت الغداة منا نصراما % % 10(@)(@@) % حلت عن عهدنا ، وطاوعت حسا % % دا قيما كانوا عليك رغاما % % PageV01P471 11(@)(@@) % قلت : لم تصرمي ، ولم نطع الوا % % شي ، وقد زدت ذا الفؤاد غراما % % PageV01P472 البحر : بسيط تام 1(@)(@@) % إني أتتني شكوى لا أسر بها ، % وذرو قول ، ولم نخش الذي نجما % % 2(@)(@@) % حتى تبدى ، ولم أعلم بقائله % وقد أكون بما حاولته فهما % % 3(@)(@@) % لا يرغم الله أنفا أنت حامله ، % بل أنف شانبك فيما سركم رغما % % 4(@)(@@) % إن كان غاظك شيء لست أعلمه ، % مني ، فهذي يميني بالرضا سلما % % 5(@)(@@) % ما تشتهين فإني اليوم فاعله ، % والقلب صب فما جشمته جشما % % 6(@)(@@) % لا ترجعيني إلى من ليس يرحمني ، % فداك من تبغضين الحتف والسقما % % 7(@)(@@) % إن الوشاة كثير ، إن أطعتهم ، % لا يرقبون بنا إلا ، ولا ذمما % % 8(@)(@@) % إن كنت أممت سخطا عامدا لكم ، % فلا أرحت إذا أهلا ، ولا نعما ! % 9(@)(@@) % أو كنت أحببت حبا مثل حبكم ، % فلا أقلت إذا نعلي لي القدما % % PageV01P473 البحر : خفيف تام 1(@)(@@) % عاود القلب ، يا لقومي ، سقما ، % يوم أبدت لنا قريبة صرما % % 2(@)(@@) % صرمتني ، وما اجترمت إليها ، % غير أني أرعى المودة ، جرما % % 3(@)(@@) % حرة من نساء عبد مناف ، % جمعت منطقا ، وعقلا ، وجسما % % 4(@)(@@) % عمها خالها ، وإن عد يوما 
ms115	 ، % كان خالا لها ، إذا عد عما % % 5(@)(@@) % صرمتني ، والله ، في غير ذنب ، % رب موسى ، أميرة القلب ، ظلما % % 6(@)(@@) % قلت ، لما اتاني القول زورا : % ليت شعري من صاغ ذا ، ثم نما % % 7(@)(@@) % كيف أسلو ، وكيف أصبر عنها ، % يا لقومي ، وحبها كان غرما % % 8(@)(@@) % ليت شعري ، يا بكر ، هل كان هذا ، % أم يراه الإله ب لغيب رجما % % 9(@)(@@) % قال : مهلا ، فلا تظنن هذا ، % عمرك لله ما قتلناه علما % % 10(@)(@@) % قلت : اذهب ، ولا تلبث لشيء ، % واستمع ، واعلم الذي كان نما % % PageV01P474 11(@)(@@) % فمضى نحوها بعقل وحزم % واحتيال ، ونصح حب ، فلما % % 13(@)(@@) % % وبرى لحمه ، فلم يبق لحما ؟ % 14(@)(@@) % فاستفزت لقوله ، ثم قالت : % لا وربي ، يا بكر ، ما كان مما % % 15(@)(@@) % قيل حرف ، فلا تراعن منه ، % بل نرى وصله ، وربي ، مما % % 16(@)(@@) % لعن الله من تقول هذا ، % وثنى من وشى بلعن ، وهما % % 17(@)(@@) % ليسوء الصديق ب لصرم منا % % زيد أنف العداة بالوصل رغما % % PageV01P475 البحر : خفيف تام 1(@)(@@) % يا خليلي ، عادني اليوم سقمي % % فبرى داؤه ، لحيني ، عظمي % % 2(@)(@@) % لمصر أصر و ستكبر اليو % وظن الصدود ليس بظلم % 3(@)(@@) % صد عمدا ، فباء ، إذ صد عني ، % يا خليلي بإثمه وبإثمي % % 4(@)(@@) % إن تجودي ، أو تبخلي ، فبحمد % أنت من واصل لنا ، لا تذمي % % 5(@)(@@) % أو تقولي : ما زلت في الشعر ، حتى % % بحت للناس ، غير أن لم تسم % 6(@)(@@) % فالمحل الذي حللت به والحس % % حسن ، أبدى عليك ما كنت أكمي % % 7(@)(@@) % بيتك البيت ، تسقفين عليه ، % وعلى صالح الخلائق ينمي % % 8(@)(@@) % أنت في الجوهر المهذب ، من % % م ، ذرى المجد ، بين خال وعم % PageV01P476 البحر : خفيف تام 1(@)(@@) % طال ليلي ، و عتادني اليوم سقم ، % وأصابت مقاتل القلب نعم % 2(@)(@@) % قصدت نحو مقتلي بسهام ، % نافذات ، وما تبين كلم % 3(@)(@@) % حرة الوجه والشمائل والجو % هر ، تكليما لمن نال غنم % 4(@)(@@) % وحديث ، بمثله تنزل العص % رخيم ، يشوب ذلك حلم % 5(@)(@@) % سلب القلب دلها ، ونقي % مثل جيد الغزال يعلوه نظم % % 6(@)(@@) % ونبيل عبل الروادف ، ك لقو % % ر من الرمل قد تبلد ، فعم % 7(@)(@@) % ووضيء ك لشمس بين سحاب 
ms116	 % رائح ، مقصر العشية ، فخم % 8(@)(@@) % وشتيت ، أحوى المراكز ، عذب ، % ما له في جميع ما ذيق طعم % 9(@)(@@) % طفلة كالمهاة ، ليس لمن عا % % ب ، إذا تذكر المعايب ، وصم % 10(@)(@@) % هكذا وصف ما بدا لي منها ، % ليس لي ب لذي تغيب علم % PageV01P477 11(@)(@@) % غير أني أرى الثياب ملاء % في يفاع ، يزين ذلك جسم % % 12(@)(@@) % إن تجودي ، أو تبخلي ، فبحمد ، % لست ، يا نعم ، فيهما من يذم % PageV01P478 البحر : طويل 1(@)(@@) % أقلي البعاد ، أم بكر ، فإنما % % قصارى الحروب أن تعود إلى سلم % 2(@)(@@) % فوالله ، ما للعيش ، ما لم ألاقكم ، % وما للهوى ، إذا ما تزارين ، من طعم % 3(@)(@@) % وما لي صبر عنكم ، قد علمتم ، % ولا لك عنا من عزاء ، ولا عزم % % 4(@)(@@) % فقولي ، لواشينا ، كما كنت قائلا ، % لواشيكم : رغما عصيت على رغم ! % 5(@)(@@) % كلانا أراد الصرم ، ما سطاع جاهدا ، % فأعيا قريبا م السماحة والصرم % 6(@)(@@) % ألم تعلمي ما كنت آليت فيكم ، % وأقسمت لا تخلين ذاكرة باسمي % % PageV01P479 البحر : كامل تام 1(@)(@@) % يا ليلة ، قطع الصباح نعيمها ، % عودي علي ، فقد أصبت صميمي % % 2(@)(@@) % ما إن رأيت ، ولا سمعت كليلة ، % في غير سوء عند بيت حكيم % % 3(@)(@@) % مثل لتي نكبت فؤادي نكبة % تركت حليما ، وهو غير حليم % 4(@)(@@) % يا ليل ، يا ذات البهاء لأهلها ، % إني ظلمت ، ولمت غير مليم % 5(@)(@@) % ولقد ذكرتك ، يا بهية ، بعدما % % ذهب الكرى بمجالسي ونديمي % % 6(@)(@@) % فعليك ، يا ليلى ، السلام ، تحية % عدد النجوم ، وقل من تسليمي % % PageV01P480 البحر : رمل تام 1(@)(@@) % طال ليلي لسرى طيف ألم ، % فنفى النوم ، وأجداني السقم % 2(@)(@@) % طيف رئم ، شطة ، أوطانه ، % فهي لم تدن ، وليست بأمم % 3(@)(@@) % من رسول ناصح ، يخبرنا % % عن محب مستهام قد كتم ؟ % 4(@)(@@) % حبه ، حتى تبلى جسمه ، % وبراه طول أحزان ، وهم % 5(@)(@@) % ذاك من يبخل عني ب لذي ، % لو به جاد ، شفاني من سقم % % 6(@)(@@) % كلما ساءلته خيرا ، أبى ، % وبلاء شد ظهرا ، واعتصم % % 7(@)(@@) % لج فيما بيننا قولا : بلا ، % ليت لا من قالها ، نال الصمم % % 8(@)(@@) % ولو اني كان ما أطلبه % % عندنا يطلبه ، قلت : نعم % 9(@)(@@) % وأراه كل 
ms117	 يوم يجتني % % عللا ، في غير جرم يجترم % 10(@)(@@) % ظنها بي ظن سوء فاحش ، % وبها ظني عفاف وكرم % % PageV01P481 11(@)(@@) % وإذا قال مقالا ، جئته ، % وإذا قلت ، تأبى وظلم % % 12(@)(@@) % كيف هذا يستوي في حكمه ، % أنه بر ، وأني متهم ؟ % 13(@)(@@) % قد تراضيناه عدلا بيننا ، % وجعلناه أميرا وحكم % 14(@)(@@) % فعليه الآن أن ينصفنا ، % ويجد اليوم ما كان صرم % % 15(@)(@@) % أو يرد الحكم عنه بالرضى ، % فعلينا حكمه فيما حتكم % 16(@)(@@) % وله الحكم على رغم العدى ، % لا نبالي سخط من فيه رغم % % PageV01P482 البحر : منسرح 1(@)(@@) % وقف بربع أنساكه قدمه ، % جرت به الريح ، فامحى علمه % 2(@)(@@) % وقفت ب لربع ، كي أسائله ، % لو استطاع الكلام لم أرمه % 3(@)(@@) % ربع لرخص البنان مختضب ، % طوبى لمن بات ، وهو يلتثمه % 4(@)(@@) % ما زلت أصطاده ، واختله % يوما ، وأدنو له وأكتتمه % % 5(@)(@@) % حتى تركت الحبيب وامقنا ، % ينتابنا ماشيا به قدمه % % 6(@)(@@) % يطوف بالبيت ما يفارقه ، % قد شفه حبنا فلم يرمه % 7(@)(@@) % ما كنت أرعى المخاض ، قد علموا ، % ولا أنيخ البعير أختطمه % % PageV01P483 البحر : مجزوء الرمل 1(@)(@@) % هل عرفت ، اليوم ، من شن هل عرفت ، اليوم ، من شن % باء ، بالنعف ، رسوما % % 2(@)(@@) % غيرتها كل ريح % تذر الترب مسيما % % 3(@)(@@) % حرجفا تذري عليها % % أسحما جونا هزيما % % 4(@)(@@) % ولقد ذكرني الرب % ع شؤونا لن تريما % % 5(@)(@@) % يوم أبدت بجنوب ال % % خيف ، رفافا وسيما % % 6(@)(@@) % وشتيتا باردا تح % سبه درا نظيما % % 7(@)(@@) % ثم قالت ، وهي تذري % % دمع عينها سجوما % % 8(@)(@@) % للثريا : قد أبى ه % % ذا المعنى أن يدوما % % 9(@)(@@) % أخبريه بالذي أل % % قى ، فإن كان مقيما % % 10(@)(@@) % فليعدنا موعدا لا % % نتقي فيه نموما % % PageV01P484 11(@)(@@) % وليكن ذاك إذا ما % % انتصف الليل بهيما % % 12(@)(@@) % برزت بين ثلاث % كالمها تقرو الصريما % % 13(@)(@@) % قمر ، بدر ، تبدى % % باهرا ، يعشي النجوما % % 14(@)(@@) % قلت : أهلا بكم ، من % زور زرن كريما % % 15(@)(@@) % فأذاقتني لذيذا ، % خلته راحا ختيما % % 16(@)(@@) % شابه شهد وثلج ، % نفعا قلبا كليما % % 17(@)(@@) % ثم أبدت ، إذ سلبت ال % % مرط ، مبيضا هضيما % % 18(@)(@@) % فلهونا الليل حتى % % هجم الصبح هجوما % % 19(@)(@@) % قلن : قد نادى المنادي ، % وبدا الصبح 
ms118	 ، فقوما ! % 20(@)(@@) % قمن يزجين غزالا % فاتر الطرف ، رخيما % % PageV01P485 21(@)(@@) % ولقد قضيت حاجا % % تي ، ولاقيت النعيما % % PageV01P486 البحر : خفيف تام 1(@)(@@) % أيها العاذل الذي لج في الهج % % ر ، علام الذي فعلت ، ومما ؟ % 2(@)(@@) % فيم هجري ، وفيم تجمع ظلمي % % وصدودا ، ولم عتبت وعما ؟ % 3(@)(@@) % أدلالا ، لتتزيد محبا ، % أم بعادا ، فتسعر القلب هما ؟ % 4(@)(@@) % أيما أن تكون ، كان هوى من % منك ، فزاد الإله فيه ، وتما % % 5(@)(@@) % أم عدو يمشي بزور وإفك ، % كاشح دب بالنميمة لما % % 6(@)(@@) % يلف عهدا نقضته بعد وأي ، % وأساء الذي وشى وأذما % % 7(@)(@@) % زعموا أنني لغيرك سلم ، % شل شانيك ، لا احاشي ، وصما ! % 8(@)(@@) % فاتق الله في المغيب ، فإني % % حافظ للمغيب ، ذلك معما % % 9(@)(@@) % ليس يفتات ذو المودة عندي % % ويرى الكاشحون أنفا أشما % % 10(@)(@@) % قد رضينا ، وإن قضيت بجور ، % فاقبلي قول كاشح ، أثل ، أما % % PageV01P487 البحر : هزج 1(@)(@@) % أرقت ، وآبني همي ، % لنأي الدار من نعم % 2(@)(@@) % فأقصر عاذل عني ، % ومل ممرضي سقمي % % 3(@)(@@) % أموت لهجرها حزنا ، % ويحلو عندها صرمي % % 4(@)(@@) % فبئس ثواب ذات الود % د ، تجزيه ابنة العم % 5(@)(@@) % ويوم الشري قد هاجت % دموعا وكف السجم % 6(@)(@@) % غداة جلت على عجل % شتيتا بارد الظلم % 7(@)(@@) % وقالت لفتاة ، هند % % ها ، حوراء كالرثم : % 8(@)(@@) % أهو ، يا أخت ، بالله ، ال % % ذي لم يكن عن إسمي % % 9(@)(@@) % ولم يجازنا ب لود ، % أحفى بي ، ولم يكم % % 10(@)(@@) % فقالت رجع ما قالت : % نعم يخفيه عن علم % % PageV01P488 11(@)(@@) % فجئت فقلت : صب زل % من واش ، أخي إثم % % 12(@)(@@) % وقد أذنبت ذنبا ف ص % فحي ، ب لله ، عن ظلمي % % 13(@)(@@) % فقالت : لا ، فقلت : فلم % أرقت دمي بلا جرم ؟ % 14(@)(@@) % أإن أقررت بالذنب ، % لحب قد برى جسمي % % 15(@)(@@) % زويت العرف ، والنائ % ل عمدا ، غير ذي رحم % PageV01P489 البحر : مجزوء الخفيف 1(@)(@@) % قلت بالخيف مرة ، % لجوار نواعم : % 2(@)(@@) % قلن ، ب لله ، للتي % % سمعت قول ظالم % 3(@)(@@) % إقبلي العذر من فتى ، % صادق ، غير آثم % 4(@)(@@) % لم يخنك الوداد ، لا ، % لا ورب المواسم % % 5(@)(@@) % لم تبوئين باثمه ، % تائبا غير واغم ؟ % 6(@)(@@) % إتقي الله في فتى % ماجد ، أخت 
ms119	 هاشم % % PageV01P490 البحر : كامل تام 1(@)(@@) % أخطأت ، أنت بدأت ب لصرم ، أخطأت ، أنت بدأت ب لصرم ، % و بتعت منا الهجر ب لسلم % 2(@)(@@) % وزعمت أني قد ظلمتكم ، % كلا ، وأنت بدأت بالظلم % 3(@)(@@) % وسمعت بي قول الوشاة بلا % % ذنب أتيت به ، ولا جرم % 4(@)(@@) % إلا صبابة عاشق لكم ، % أورثته سقما على سقم % 5(@)(@@) % قد كنت أحسبني جليدا عنكم % فإذا فؤادي غير ذي عزم % % 6(@)(@@) % ما كنت أحسب أن حبا قاتلي % % حتى بليت بما برى جسمي % % 7(@)(@@) % أورثتني داء أخامره ، % أسماء ، بز اللحم عن عظمي % % 8(@)(@@) % لو كنت أنت قسمت ذاك له ، % مني عليه ، لجرت في القسم % % 9(@)(@@) % لكن ربي كان قدره ، % فقضاء ربي أفضل الحكم % PageV01P491 البحر : وافر تام 1(@)(@@) % إذا الحب المبرح باد يوما ، ألا تجزي ، عثيمة ، ود صب % بذكرك لا ينام ، ولا ينيم % 2(@)(@@) % لصب ، زاده حبا ووجدا ، % بكم ، سعدى ، ملامة من يلوم % % 3(@)(@@) % كريم ، لم تغيره الليالي ، % فتذهله ، ولا عهد قديم % % 4(@)(@@) % تودع من نساء الحي طرا ، % فأمسى خالصا بكم يهيم % 5(@)(@@) % وأمسى مدنفا قد مات وجدا ، % بسعداه ، وأبلته الهموم % 6(@)(@@) % أمين ما يخون له صدقا ، % إذا ولى ، له خلق كريم % 7(@)(@@) % وإني حين يفشى سر هاذ ، % لسري حافظ ، أبدا ، كتوم % % 8(@)(@@) % كلفت بها خدلجة خريدا ، % منعمة ، لها دل رخيم % 9(@)(@@) % إذا حتفلت عثيمة ، قلت : شمس ، % وإن عطلت عثيمة قلت ريم % 10(@)(@@) % لها وجه يضيء كضوء بدر % عتيق اللون ، باشره النعيم % PageV01P492 11(@)(@@) % إذا الحب المبرح باد يوما ، % فحبك عندنا ، أبدا ، مقيم % % 12(@)(@@) % أصوم ، إذا تصوم عثيم نفسي ، % وأفطر حين تفطر لا أصوم % % 13(@)(@@) % قليل رضاك يحمد عند نفسي ، % وسخطك عندنا حدث عظيم % PageV01P493 البحر : رمل تام 1(@)(@@) % قد أصاب القلب من نعم % سقم داء ، ليس ك لسقم % % 2(@)(@@) % إن نعما اقصدت رجلا ، % آمنا بالخيف ، إذ ترمي % % 3(@)(@@) % بشتيت نبته ، رتل ، % طيب الأنياب ، والطعم % 4(@)(@@) % وبوحف مائل ، رجل ، % كعناقيد من الكرم % 5(@)(@@) % عرضت يوما لجارتها ، % وهي لا تبوح لي ب سم : % 6(@)(@@) % إسأليه ، ثمت ستمعي % % أينا أحق بالظلم ؟ % 7(@)(@@) % وافهمي عنا تجاوزنا 
ms120	 ، % واحكمي ، رضيت بالحكم % % 8(@)(@@) % وانشديه ، هل اتيت له % % سخطا مني ، على علم % 9(@)(@@) % يأتكم منه بحجته ، % فله العتبى ، ولا أحمي % % PageV01P494 البحر : كامل تام 1(@)(@@) % أوقفت من طلل على رسم ، % بلوى العقيق يلوح كالوشم % 2(@)(@@) % أقوى وأقفر ، بعد ساكنه ، % غير النعام ، يرود ، والأدم % 3(@)(@@) % فوقفت من طرب اسائله ، % و لدمع مني بين السجم % 4(@)(@@) % وذكرت نعما ، إذ وقفت به ، % وبكيت من طرب إلى نعم % % 5(@)(@@) % يا نعم ، آتيه أسائله ، % فيزيدني سقما على سقم % % 6(@)(@@) % ما بال سهمك ليس يخطئني % % ويطيش عنك ، حزيمة ، سهمي ؟ % 7(@)(@@) % ا نعم ، ما لاقيت بعدكم % لمجالس اللذات من طعم % 8(@)(@@) % اما النهار ، فأنت ما شجني ، % والليل أنت طوائف الحلم % % 9(@)(@@) % لا تظهري سري ، فإن حديثكم % % في محصن أنأى من النجم % 10(@)(@@) % إني رأيت الحب ينقصه % % طول الزمان ، وحبكم ينمي % % PageV01P495 11(@)(@@) % سأرب وصلك ، إن مننت به ، % في المخ ، يا سكنى ، وفي العظم % PageV01P496 البحر : هزج 1(@)(@@) % أبيني ، اليوم ، يا نعم % أوصل منك ، أم صرم % 2(@)(@@) % فإن يك صرم عاتبة ، % فقد نفنى وهو سلم % % 3(@)(@@) % تلومك في الهوى نعم ، % وليس لها به علم % 4(@)(@@) % صحيح لو رأى نعما % خامر جسمه سقم % % 5(@)(@@) % جلت نعم على عجل ، % ببطن منى ، وهم حرم % 6(@)(@@) % أسيلا ليس فيه لنا % % ظر عيب ولا كلم % PageV01P497 البحر : متقارب تام 1(@)(@@) % % ه ، لا يجدون لشيء ألم % 2(@)(@@) % من آل المغيرة ، لا يشه % % ن ، عند المجازر ، لحم الوضم % PageV01P498 البحر : سريع 1(@)(@@) % من عاشق صب يسر الهوى ، % قد شفه الوجد إلى كلثم % 2(@)(@@) % رأتك عيني ، فدعاني الهوى % % إليك للحين ، ولم أعلم % 3(@)(@@) % قتلتنا ، يا حبذا أنتم ، % في غير ما جرم ، ولا مأثم % % 4(@)(@@) % والله قد انزل في وحيهه % مبينا في آيه المحكم : % 5(@)(@@) % من يقتل النفس كذا ظالما ، % ولم يقدها نفسه يظلم % % 6(@)(@@) % وأنت ثأري ، فتلافي دمي ، % ثم جعليه نعمة ، تنعمي % % 7(@)(@@) % وحكمي عدلا يكن بيننا ، % أو أنت فيما بيننا فاحكمي % % 8(@)(@@) % وجالسيني مجلسا واحدا ، % من غير ما عار ولا محرم % 9(@)(@@) % وخبريني ما لذي عندكم ، % ب لله ، في قتل 