ms81	 بن حصبة بن أزنم اليربوعي.(@)(@)(@@)(@@)(@@) || AUTO 817 - هذلول(@)(@)(@@) (¬6):(@)(@@) فرس جابر بن عقيل.(@)(@)PageV01P267(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) الهاء(@)(@)(@@)(@@)(@@) ||| AUTO 818 - الهراوة(@)(@)(@@) :(@)(@@) فرس للعرب وردت بلا نسبة في القاموس المحيط (هرو) 4/ 403 فقال في تقديمها «الهراوة بالكسر فرسان» قلت وقد تقدمت أولاهما باسم هراوة الأعزاب في خيل عبد القيس بن أفصى برقم (810)(@)(@)(@@)(@@)(@@) ||| AUTO 819 - هداج(@)(@)(@@) :(@)(@@) فرس ربيعة بن صيدح في المخصص 2/ 195 في خيل ضبة.(@)(@)(@@)(@@)(@@) ||| AUTO 820 - الهرم(@)(@)(@@) :(@)(@@) فرس أبي زعنة الشاعر في القاموس المحيط (هرم) 4/ 189.(@)(@)(@@)(@@)(@@) ||| AUTO 821 - الهمام(@)(@)(@@) :(@)(@@) فرس لبني زبان بن كعب بن جلان بن غنم بن غني عند ابن الأعرابي ص 68 في خيل غني بن أعصر، والقاموس المحيط (همم) 4/ 192 ومن معانيها الأسد.(@)(@)(@@)(@@)(@@) ||| AUTO 822 - هوجل(@)(@)(@@) :(@)(@@) فرس ربيعة بن غزالة السكوني في أنساب الخيل ص 104 وله يقول في التنضبات:(@)(@@) أيها السائلي بهوجل إني ... قائل الحق فاستمع ما أقول(@)(@@) حش لبدي به المليك ومن يح ... مله يوما فإنه محمول(@)(@@) وتنضب قرية من أعمال مكة بأعلى نخلة، فيها عين جارية ونخل (معجم البلدان) 2/ 49 ومن معاني الهوجل: المفازة البعيدة، والناقة بها هوج من سرعتها.(@)(@)PageV01P268(@)(@)(@@)(@@)(@@) ||| AUTO 823 - هيدب(@)(@)(@@) :(@)(@@) فرس عبد عمرو بن راشد بن جزء بن كعب عند ابن الأعرابي ص 91 - 92 في خيل بني ذهل بن ثعلبة، وكانت امرأته حذام بنت قيس بن صفارة ابن خزاعي بن الأعور بن سدوس عذلته في إيثاره إياه، فقال:(@)(@@) لحت في هيدب أصلا ولولا ... علالة هيدب عامت حذام(@)(@@) وهو لعبد عمرو المذكور في القاموس المحيط (هدب) 1/ 139 والهيدب السحاب المتدلي.(@)(@@) ****(@)(@)PageV01P269(@)(@)(@@)(@@)(@@) | AUTO حرف الياء(@)(@)(@@)(@@)(@@) || AUTO 824 - اليحموم(@)(@)(@@) (¬1):(@)(@@) فرس الحسن بن علي بن أبي طالب رضي الله عنهما.(@)(@)(@@)(@@)(@@) || AUTO 825 - اليحموم(@)(@)(@@) (¬2):(@)(@@) للنعمان بن المنذر. قال الأعشى:(@)(@@) ويأمر لليحموم كل عشية ... بقت وتعليق فقد كاد يسنق (¬3)(@)(@)(@@)(@@)(@@) || AUTO 826 - اليحموم(@)(@)(@@) (¬4):(@)(@@) لهشام بن عبد الملك، من نسل الحرون.(@)(@)PageV01P270(@)(@)(@@)(@@)(@@) || AUTO 827 - اليحموم(@)(@)(@@) (¬1):(@)(@@) فرس حسان الطائي من بني جبة، ويسمى فارس اليحموم. قال المسيب بن علس (41/ب):(@)(@@) وفارس اليحموم يتبعهم ... كالطلق يتبع ليلة المهر(@)(@)(@@)(@@)(@@) || AUTO 828 - يعبوب(@)(@)(@@) (¬2):(@)(@@) للنعمان بن 
ms82	 المنذر. مضى الشعر فيه في باب السين (¬3).(@)(@)(@@)(@@)(@@) || AUTO 829 - اليسير(@)(@)(@@) (¬4):(@)(@@) لأبي النضر العبشمي من بني سعد. قال:(@)(@@) ألا أبلغ بني سعد رسولا ... بأني قد سبقت على اليسير(@)(@@) دلفت إليه تحت سواد ليل ... غداف لونه داج ستبر(@)(@@) فإني واليسير إذا التقينا ... لكا لمتصافيين على الأمور(@)(@)(@@)(@@)(@@) || AUTO 830 - اليعبوب(@)(@)(@@) (¬5):(@)(@@) فرس الأجلح بن قاسط الضبابي. قال أبو الهول مولى بشر بن أبي زياد ابن سلمى بن مالك بن جعفر بن كلاب:(@)(@@) وأجلح فارس اليعبوب لاقى ... سنانا من أسنتنا سنينا(@)(@@) بمعترك من الخيلين كنا ... قتلناهم به حتى روينا(@)(@)PageV01P271(@)(@)(@@)(@@)(@@) || AUTO 831 - اليعسوب(@)(@)(@@) (¬1):(@)(@@) لأبي طارق الأحمسي. قال فيه:(@)(@@) وألحق يعسوب على الخيل ربه ... ولم يقد وعثا ولم يتودع(@)(@@) فلولا حذير والذي كان بيننا ... لفاضت عيون الباكيات بأربع(@)(@)(@@)(@@)(@@) || AUTO 832 - يسار(@)(@)(@@) (¬2):(@)(@@) فرس الحصين بن يزيد، وهو ذو الغصة الحارثي. قال بداء بن سلمان الهمداني:(@)(@@) لقد علمت قبيلتكم يقينا ... بوقعتنا بمعترك الديار(@)(@@) أبدنا جمعكم يوم التقينا ... وأفلتنا الحصين على يسار(@)(@)(@@)(@@)(@@) || AUTO 833 - يافع(@)(@)(@@) (¬3):(@)(@@) فارسه والبة أخو بني سدرة بن عمرو بن عامر بن ربيعة. قال حصين بن سفيان الكلابي:(@)(@@) وتركن فارس يافع في مزحف ... يكبو لدى ترب العنان عقير(@)(@)(@@)(@@)(@@) || AUTO 834 - يسار(@)(@)(@@) (¬4):(@)(@@) فرس عمرو بن النعمان بن البراء بن عبد الله بن أسعد. قال:(@)(@@) سائل يسارا أي فارس نجدة ... إذا كان من وقع الأسنة أخزرا(@)(@)PageV01P272(@)(@)(@@)(@@)(@@) || AUTO 835 - اليعبوب(@)(@)(@@) (¬1):(@)(@@) للربيع بن زياد.(@)(@)(@@)(@@)(@@) || AUTO 836 - اليعسوب(@)(@)(@@) (¬2):(@)(@@) للزبير رحمه الله.(@)(@@) آخر كتاب الخيل، والحمد لله وحده، وصلواته على سيدنا محمد نبيه وعلى آله وصحبه الطاهرين وسلامه.(@)(@@) كتب في المدينة المنورة في 29 ذي القعدة الحرام سنة 1298 ه(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) الياء(@)(@)(@@)(@@)(@@) ||| AUTO 837 - اليعسوب(@)(@)(@@) :(@)(@@) فرس للرسول صلى الله عليه وسلم، ورد ذلك في أنساب الخيل ص 19 - 20 وحلية الفرسان ص 151 وحياة الحيوان الكبرى 2/ 166 ورشحات المداد ص 124 والقاموس المحيط (العسب) 1/ 104 وورد عند الدميري اليعثوب بالثاء وهو تصحيف.(@)(@@) ****(@)(@)PageV01P273(@)(@)(@@) 8 - 
