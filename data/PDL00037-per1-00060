ms48	 گر تو می‌خواهی که یابی این مقام %~% چند کاری بایدت کردن تمام(@)(@@) 102 اولا مهر امامان بایدت %~% بعد از آن اسرار عرفان بایدت(@)(@@) 103 بعد ازینها بایدت بیرون شدن %~% از میان خلق دنیا همچو من(@)(@@) 104 دیگر از افراط خوردن ترک کن %~% با خلایق نیز کم باید سخن(@)(@@) 105 دیگر از خفتن بشب بیزار شو %~% وآنگهی با یاداو در کارشو(@)(@@) 106 گر خوری از کسب خود باری بخور %~% زینهار از نان مردم تو ببر(@)(@@) 107 زینهار از جامه نیکو حذر %~% تا نیفتی همچو ایشان در خطر(@)(@@) 108 بعد از آن کن صحبت نیک اختیار %~% تا بیابی در و گوهر بی‌شمار(@)(@@) 109 دایم از گفتار درویشان بخوان %~% تا که حاصل گردد این راز نهان(@)(@@) 110 رو تو درویشی گزین و راه شرع %~% تا بیابی در جهان خود اصل و فرع(@)(@@) 111 سر این تحفه ز من بشنو کنون %~% زآنکه هستم راز دار کاف و نون(@)(@@) 112 پس نبی گفتا که ای فرزند من %~% درمیان جان تو پیوند من(@)(@@) 113 خیز پیش مرتضی نه تحفه را %~% تا که ظاهر سازد آن سر را بما(@)(@@) 114 پس حسین آن تحفه پیش شه نهاد %~% پیش سید آمد و برپا ستاد(@)(@@) 115 پس ز دست مرتضی آن سیب جست %~% بر زمین افتاد دونیم درست(@)(@@) 116 نیمه آن را حسن برداشت زود %~% نیمه دیگر حسین آمد ربود(@)(@@) 117 در میان هر یکی ز آن نیمه‌ها %~% خط سبزی بد نوشته بابها(@)(@@) 118 گفت پیغمبر که ای شیر خدا %~% خط عبری را بخوان در پیش ما(@)(@@) 119 پس امیرالمؤمنین آن خط بخواند %~% بر زبان سر الهی را براند(@)(@@) 120 بد نوشته این سلام و این دعا %~% بر ولی الله امام رهنما PageV01P17(@)(@@) 1 چون محمد این ندا از حق شنید %~% گفت هستی نور حق از عین دید(@)(@@) 2 ای تو را حق در کلام خویشتن %~% خوانده صد جایت بنام خویشتن(@)(@@) 3 ای ز تو ایوان شرع افروخته %~% جمله بدعتها 
ms49	 ز قهرت سوخته(@)(@@) 4 ای ز تو راه طریقت آشکار %~% وی ز تو نور حقیقت آشکار(@)(@@) 5 راه تو هر کس نرفت ایمان نبرد %~% کور بود و در ره شیطان بمرد(@)(@@) 6 ای تو از مهر حقیقت نور نور %~% پیش تو روشن شده احوال صور(@)(@@) 7 ای ز تو روشن شده روی زمین %~% رهنمای اولیای راه بین(@)(@@) 8 در حقیقت واصل اندر راه حق %~% از تو در عالم نبرده کس سبق(@)(@@) 9 هر که او با سر تو همراز شد %~% در میان عاشقان ممتاز شد(@)(@@) 10 هر که در راهت نباشد سر براه %~% هست ملعون و مقلد روسیاه(@)(@@) 11 هر که او از دین تو برگشته شد %~% در ره معنی ما سرگشته شد(@)(@@) 12 هر که او از پیرویت عار داشت %~% در گلستان شریعت خار کاشت(@)(@@) 13 این معانی را نگویم من چنین %~% گفت احمد آن نبی المرسلین(@)(@@) 14 یا نبی المرسلین عطار را %~% زنده دل کن وانما اسرار را(@)(@@) 15 تا شود او راه بین شرع تو %~% در زمین جان کند او زرع تو(@)(@@) 16 هست عطار از ضعیفی رشته‌ای %~% در میان خاک و خون آغشته‌ای(@)(@@) 17 هست عطار اندر این ره خاک راه %~% از تو می‌جوید ز بی‌دینان پناه(@)(@@) 18 هست عطار این زمان بی‌خویش و کس %~% خود تو را دارد بهر دو کون و بس(@)(@@) 19 یا أمیرالمؤمنین دستم بگیر %~% ز آنکه سلطان جهانی ای امیر(@)(@@) 20 یا أمیرالمؤمنین جانم بسوخت %~% در میان کفر و ایمانم بسوخت(@)(@@) 21 با چنین جمعی منافق چون کنم %~% غیر مهر تو ز دل بیرون کنم(@)(@@) 22 یا امیر این قوم بی‌ره گشته‌اند %~% از طریق افتاده در چه گشته‌اند(@)(@@) 23 یا علی این جمع مردود آمدند %~% بر طریق قوم نمرود آمدند(@)(@@) 24 یا امیر این قوم سرگردان شدند %~% همچو قوم لوط بس بیجان شدند(@)(@@) 25 یا امیر این قوم که می‌نگروند %~% از پی مردار چون سگ می‌روند(@)(@@) 26 یا امیر از دست 
ms50	 اینان چون کنم %~% خود قبای صبر را بیرون کنم(@)(@@) 27 دیگرم صبری نماند از جورشان %~% ظلمها پیدا شده در دورشان(@)(@@) 28 قاضی و مفتی و اهل احتساب %~% مکرها ورزند جمله بی‌حساب(@)(@@) 29 زینهار ای راهرو زیشان گریز %~% تا نیابی هول روز رستخیز(@)(@@) 30 جمله بگذارند اصل و فرع را %~% حیله پندارند ایشان شرع را(@)(@@) 31 یا علی زین خلق یارانت چو من %~% پیش تو ماندند آخر هفده تن(@)(@@) 32 دیگر از اصحاب وقوم روزگار %~% از دمشق و کوفه بد پانصد هزار(@)(@@) 33 از مقام مکه تا اقصای روم %~% وز بلاد مصر تا سرحد فوم(@)(@@) 34 پس خراسانست و ترکستان زمین %~% پس بلاد ترک تا سرحد چین(@)(@@) 35 ازولایت تا ولایت مردمان %~% بود در شرع محمد آن زمان(@)(@@) 36 جملگی باطور ایشان گشته‌اند %~% از امیرمؤمنان برگشته‌اند(@)(@@) 37 رفته‌اند ایشان زشهر دین بدر %~% میر خوددانند گر را با مگر(@)(@@) 38 بعد بهمان دین ایشان شد درست %~% با فلان کز نسل بی ایمان برست(@)(@@) 39 همچو شمر نابکار و چون یزید %~% آید از حق لعن بر وی برمزید(@)(@@) 40 پورنادان پورعاصی بیعتی است %~% پس فلان بن فلان لعنتی است(@)(@@) 41 جملگی گفتند چون بهمان بد او %~% در طریق کفر با ایمان بد او(@)(@@) 42 خط بهمان دارد اندر دست او %~% گر باو بیعت کنیم آید نکو(@)(@@) 43 چون خلیفه بود عثمان در جهان %~% خوانده ذوالنورین خلق او را عیان(@)(@@) 44 پور بوسفیان پس از وی خوب بود %~% در امیری چون از او منسوب بود(@)(@@) 45 این جماعت جملگی از ره شدند %~% سوی او رفتند پس ابله شدند(@)(@@) 46 وین زمان هم مردمان آگه شدند %~% بر طریق جد خود بی‌ره شدند(@)(@@) 47 می‌روند این جمله تا دار جزا %~% رو بایشان باش گر داری روا(@)(@@) 48 خلق عالم ره بکوری رفته‌اند %~% راه شرع احمدی بنهفته‌اند(@)(@@) 49 همچو من در شرع و در دینش بکوش %~% تا بیایی از همه مستی بهوش(@)(@@) 50 این همه تصنیف بین 
ms51	 از عالمان %~% آنچه حق بوده نکردندی عیان(@)(@@) 51 من عیان و آشکارا گفته‌ام %~% وین همه درها بمظهر سفته‌ام(@)(@@) 52 من نمی‌ترسم ز کشتن همچو تو %~% ز آنکه اسرارم علی گفتا بگو(@)(@@) 53 من از او گفتم شه عرفان من %~% همچو نوری در میان جان من(@)(@@) 54 ای بدنیا دشمنت را چند روز %~% پرورش دادی بخوردی همچو یوز(@)(@@) 55 گرچه او بر تو بسی زینت فروخت %~% عاقبت دنیا بچشمش میخ دوخت(@)(@@) 56 ای پسر از قوم خود بیزار شو %~% بازگرد از غفلت و بیدار شو(@)(@@) 57 رو تو گفت مصطفی را گوش کن %~% جام از ساقی کوثر نوش کن(@)(@@) 58 نی محمد گفت باب علم اوست %~% انما در شأن حیدر خود نکوست(@)(@@) 59 تو زغفلت گشته‌ای دنیاپرست %~% هر کرا غفلت نباشداو برست(@)(@@) 60 این کتبها غفلت آرد این بدان %~% روز غفلت دور شو مظهر بخوان(@)(@@) 61 تا تو را روشن شود اسرار دین %~% وین نماز و روزه‌ات گردد یقین(@)(@@) 62 گر تورا عمر دو صد باشد بسال %~% وندران عمرت بخوانی قیل و قال(@)(@@) 63 ور تو در روزه شوی عمری دراز %~% ور بشب دایم گذاری تو نماز(@)(@@) 64 بی ولای او نیابی هیچ نور %~% رو سیه باشی تو اندر روز صور(@)(@@) 65 پیرو شرع محمد باش چست %~% در طریق شاه مردان رو درست(@)(@@) 66 هست امیدم بشاه اولیا %~% ز آنکه هست او تاجدار انما(@)(@@) 67 همچو او آن را که شاهی باشدش %~% دردو کون آن را پناهی باشدش(@)(@@) 68 ای ز دین مصطفی بیرون شده %~% همچو حجاج لعین ملعون شده(@)(@@) 69 خیز و همچون مؤمنان دیندار شو %~% وآنگهی در کلبه عطار شو(@)(@@) 70 هست عطار اندراین ره سربلند %~% ز آنکه هست ابیات شیرینش چو قند(@)(@@) 71 نی شکر دانی چرا شیرین بود %~% ز آنکه مهر شه در او تعیین بود(@)(@@) 72 کمتر از چوبی نه‌ای در راه عشق %~% گوش کن معنی آن از شاه عشق(@)(@@) 73 تا که گردد روشنت اسرار 
ms52	 عشق %~% بعد از آن گردی تو خود انوار عشق(@)(@@) 74 این مراتب از تو خود ظاهر شده %~% وین معانی از تو خود باهر شده(@)(@@) 75 لیک باید جسم خود را سوختن %~% وآنگهی خرقه زعرفان دوختن(@)(@@) 76 رو تو درخرقه خدا را کن طلب %~% وآنگهی دم درکش و نه لب بلب(@)(@@) 77 ای تو اندر جسم صورت بین شده %~% بعد از آن هم صحبت سرگین شده(@)(@@) 78 جهد کن خود را بعرفان پاک ساز %~% تا شوی در ملک عرفان پاکباز(@)(@@) 79 رو درون را پاک ساز از کندگی %~% تا ترا روشن شود فرخندگی(@)(@@) 80 کندگی مهر پلیدان با شدت %~% پیروی نفس شیطان با شدت(@)(@@) 81 رو تو از فعل بد شیطان ببر %~% ریسمان مهر بد کیشان ببر(@)(@@) 82 هیچ میدانی که تو خود کیستی %~% آمده در دهر بهر چیستی(@)(@@) 83 ظاهر از آثار ذات حق توئی %~% واندرین عالم صفات حق توئی(@)(@@) 84 هیچ میدانی کزین عالم ترا %~% جز جفا و جور نبود خود دوا(@)(@@) 85 ترک دنیا کن چو حیدر مردوار %~% تا شوی واصل بلطف کردگار(@)(@@) 86 هر که او در آتش محنت بسوخت %~% همچو بوذر جامه‌ای از صدق دوخت PageV01P18(@)(@@) 1 راویم این نکته را از شیخ دین %~% آنکه او را بود خود علم الیقین(@)(@@) 2 شیخ دین و پیشوای اهل دید %~% بایزید آن حکمت حق را کلید(@)(@@) 3 گفت با من جعفر صادق امام %~% آنکه بد در علم دین حاذق تمام(@)(@@) 4 گشت روزی درفشان آن مقتدا %~% گفت پیشم پیر بسطامی بیا(@)(@@) 5 یک زمان از هر سخن خاموش کن %~% آنچه می‌گوید زبانم کوش کن(@)(@@) 6 در مدینه باب من از بهر گشت %~% با گروهی از صحابه می‌گذشت(@)(@@) 7 همرهش بودند آن شهزاده‌ها %~% آنکه ایشان را خدا گفته ثنا(@)(@@) 8 و آنکسان کایشان بدندی بی‌نظیر %~% جمله بودند از محبان امیر(@)(@@) 9 چون نصیر و قنبر و سلمان ما %~% بوذر و عمار یا سر ز آن ما(@)(@@) 10 مالک اشتر بایشان 
ms53	 بود و بس %~% بود مختار مسیب هم نفس(@)(@@) 11 پس محمد ابن بوبکر و حبیب %~% سعد بین عباده و ابن حسیب(@)(@@) 12 عبد رحمن بن عداس از هرب %~% بود او از جمع یاران از عقب(@)(@@) 13 این جماعت هیفده تن بوده‌اند %~% در طریق شاه ره پیموده‌اند(@)(@@) 14 با محمد کز حنف شد نام او %~% کز حنیفت بوده میدان مام او(@)(@@) 15 خود امیرمؤمنان سه چیز داشت %~% در زمین جان خود این تخم کاشت(@)(@@) 16 این مراتب را بجز حیدر که دید %~% گر نمیدانی بپرس از بایزید(@)(@@) 17 بایزید و من بعالم گفته‌ایم %~% وین در معنی حق را سفته‌ایم(@)(@@) 18 این سه چیز از حق باو وارد شده %~% این سه بر ارباب معنی جد شده(@)(@@) 19 این سه مظهر را ز شه دانیم ما %~% هم ز مظهر می برآمد این صدا(@)(@@) 20 این سه معنی را بگویم با تو من %~% چون تو هستی در معانی گام زن(@)(@@) 21 اولین آن ولایت دان بعلم %~% و آخرین آن سخاوت دان و حلم(@)(@@) 22 پس شجاعت کان بوددلخواه ما %~% در جهان ختم است او بر شاه ما(@)(@@) 23 هر یکی فرزند را داد او یکی %~% زنکه او بد والی حق بیشکی(@)(@@) 24 پس سخاوت گشت حق آن حسن %~% پس ولایت از حسین آمد علن(@)(@@) 25 خود شجاعت بر محمد داده بود %~% ز آنکه اودرملک دین شهزاده بود(@)(@@) 26 چون بدانستی که اینها حق کیست %~% با تو گویم راز پنهانی که چیست(@)(@@) 27 گر تو چون ایشان معانی دان شوی %~% بر سریر ملک دین سلطان شوی(@)(@@) 28 یا تو همچون آن جماعت گوش باش %~% یا چو عطار این زمان پر جوش باش(@)(@@) 29 تو کمر را همچو ایشان بند چست %~% دامن شه را بدستت گیر رست(@)(@@) 30 این جماعت پیرو شاهند همه %~% این جماعت رهرو راهند همه(@)(@@) 31 این جماعت جان فدای شه کنند %~% و آن جماعت خود ترا گمره کنند(@)(@@) 32 ترک ایشان گیر 
ms54	 و ترک خویشتن %~% تا شوی در دنیی و عقبا چو من(@)(@@) 33 ترک دنیا گیر و بدعتهای بد %~% تا نیفتی در مذلت تا ابد(@)(@@) 34 رو تکبر را بمان درویش شو %~% وانگهی نزد امیر خویش شو(@)(@@) 35 تا تو را راهی نماید راست راست %~% ره رو این راه بیشک مصطفاست(@)(@@) 36 مصطفی در شرع تعلیمت کند %~% مرتضی در صدق تعظیمت کند(@)(@@) 37 مصطفی اندر جهان گلشن شده %~% مرتضی از دید حق روشن شده(@)(@@) 38 مرتضی روشن شده ازنور او %~% مظهر نور ولایت پور او(@)(@@) 39 این جماعت خود محبان ویند %~% در حقیقت دوستداران ویند(@)(@@) 40 خود همی رفتند در کوی مغان %~% جای ترسایان بد آنجا بی گمان(@)(@@) 41 یک جماعت از بزرگان یهود %~% بر سر آتش نشسته همچودود(@)(@@) 42 داش گرمی بر سر آن کوی بود %~% چیده دودی آتش بسیار زود(@)(@@) 43 آتش بسیار در وی سوخته %~% بر مثال دوزخی افروخته(@)(@@) 44 آن جماعت جملگی جمع آمده %~% بهرخشت خویش چون شمع آمده(@)(@@) 45 ناگهی دیدند آنهاشاه را %~% پیش شه رفتند رفته راه را(@)(@@) 46 پیر ایشان گفت بازوج بتول %~% یک سخن گویم ز لطفت کن قبول(@)(@@) 47 بود عمری تاکه من می‌خواستم %~% پرسم این مطلب که می‌آراستم(@)(@@) 48 بر زبان نام تو عمری رانده‌ام %~% وصف تو اندر کتبها خوانده‌ام(@)(@@) 49 بود شیخ قوم حمران یهود %~% او بسی از علم حکمت خوانده بود(@)(@@) 50 گفت باشه من مسلمان می‌شوم %~% در میان این عزیزان می‌شوم(@)(@@) 51 یاامیر این جمله را احوال گو %~% تا بدانم حال ایشان را نکو(@)(@@) 52 من همی خواهم که چون ایشان شوم %~% در قدوم حضرتت انسان شوم(@)(@@) 53 گفت شاه اولیا بشنو ز من %~% جمله یک نورند اندر یک بدن(@)(@@) 54 این جماعت پی سوی حق برده‌اند %~% وز وجود خویش جمله مرده‌اند(@)(@@) 55 سر فدای راه حق ایشان کنند %~% مرهمی بر جان دل ریشان کنند(@)(@@) 56 آنچه حق گفتست ایشان آن کنند %~% پنجه اندر پنجه شیران کنند(@)(@@) 57 
