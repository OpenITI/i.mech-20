ms2399	 PageV07P270 وجبت له الجنة البتة ، ومن أدرك والديه أو أحدهما فدخل النار فأبعده الله ، ومن أعتق رقبة مسلمة كانت فكاكه من النار ، مكان كل عظم من عظام محرره بعظم من عظامه ) )(@)(@@) الباوردي عن أبي مالك العامري ( حم ) عن مالك بن عمرو القيسري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22376 ) قال النبي :(@)(@@) | 30 ( من ضمن لي ما بين لحييه ورجليه ضمنت له دخول الجنة ) )(@)(@@) الحاكم في الكنى والعسكري في الأمثال ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22377 ) قال النبي :(@)(@@) | 30 ( من ضمن لي ستا ضمنت له الجنة : لا تجبنوا عن عدوكم ، ولا تغلوا فيكم ، وأنصفوا الناس ، من أنفسكم ، وخذوا لمظلومكم من ظالمكم ، ولا تظالموا في قسمة مواليكم ، ولا تحملوا ذنوبكم على ربكم ، فإذا فعلتم ذالك دخلتم الجنة ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22378 ) قال النبي :(@)(@@) | 30 ( من ضيق طريقا فلا جهاد له ) )(@)(@@) ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22379 ) قال النبي :(@)(@@) | 30 ( من طاف بالبيت سبعا وصلى خلف المقام ركعتين ، وشرب من ماء زمزم ، غفر الله ذنوبه كلها بالغة ما بلغت ) )(@)(@@) الديلمي وابن النجار عن جابر رضي الله عنه ، ولفظ الديلمي : أخرجه الله من ذنوبه كيوم ولدته أمه .(@)(@@)(@@)(@@) $ ( 22380 ) قال النبي :(@)(@@) | 30 ( من طاف بهاذا البيت أسبوعا فأحصاه كتبت له بكل خطوة حسنة ، وكفرت عنه سيئة ، ورفعت له درجة ، وكان له كعدل عتق رقبة ) )(@)(@@) ( ط حم طب هق هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22381 ) قال النبي :(@)(@@) | 30 ( من طاف بهاذا البيت أسبوعا وصلى خلف مقام إبراهيم ركعتين فهو كعدل محرر ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV07P271(@)(@@)(@@)(@@) $ ( 22382 ) قال النبي :(@)(@@) | 30 ( من طاف حول البيت أسبوعا لا يلغو فيه كان كعدل رقبة يعتقها ) )(@)(@@) ( طب ك هب ) عن محمد بن المنكدر عن أبيه .(@)(@@)(@@)(@@) $ ( 22383 ) قال النبي :(@)(@@) | 30 ( من طاف بالبيت سبعا وأحصاه وركع ركعتين كان كعدل رقبة نفيسة من الرقاب ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22384 ) قال النبي :(@)(@@) | 30 ( من طاف بالبيت أسبوعا لا يضع قدما ولا يرفع 
ms2400	 أخرى إلا حط الله تعالى عنه بها خطيئة وكتب له بها حسنة ، ورفع له بها درجة ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22385 ) قال النبي :(@)(@@) | 30 ( من طلب الدنيا حلالا استعفافا عن المسألة ، وسعيا على أهله ، وتعطفا على جاره ، بعثه الله يوم القيامة ووجهه مثل القمر ليلة البدر ، ومن طلبها حلالا ، مكاثرا بها مفاخرا لقي الله عز وجل وهو عليه غضبان ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22386 ) قال النبي :(@)(@@) | 30 ( من طلب العلم ليباهي به العلماء ، أو يماري به السفهاء في المجالس لم يرح رائحة الجنة ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22387 ) قال النبي :(@)(@@) | 30 ( من طلب علما ليباهي به العلماء فهو في النار ) )(@)(@@) ابن النجار عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22388 ) قال النبي :(@)(@@) | 30 ( من طلب الشهادة صادقا أعطيها وإن مات على فراشه ) )(@)(@@) أبو عوانة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22389 ) قال النبي :(@)(@@) | 30 ( من طلب العلم ليماري به السفهاء ، أو يكاثر به العلماء ، أو يصرف به وجوه الناس إليه فليتبوأ مقعده من النار ) )(@)(@@) أبو نعيم في المعرفة ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22390 ) قال النبي :(@)(@@) | 30 ( من طلب علما يباهي به الناس فهو في النار ) )(@)(@@) ابن عساكر PageV07P272 عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22391 ) قال النبي :(@)(@@) | 30 ( من طلب بابا من العلم ليصلح به نفسه أو لمن بعده ، كتب الله له من الأجر مثل رمل عالج ) )(@)(@@) ابن عساكر عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22392 ) قال النبي :(@)(@@) | 30 ( من طلب علما فأدركه كتب له كفلان من الأجر ، ومن طلب علما فلم يدركه كتب له كفل من الأجر ) )(@)(@@) ( ع ) و الحاكم في الكنى ا ( طب هق ) وتمام وابن عساكر عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22393 ) قال النبي :(@)(@@) | 30 ( من طلب الدنيا بعمل الآخرة طمس وجهه ، ومحق ذكره ، وأثبت اسمه في أهل النار ) )(@)(@@) ( طب ) و أبو نعيم والجارود بن المعلى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22394 ) قال الن بي :(@)(@@) | 30 ( من طلب أخاه فليطلبه 