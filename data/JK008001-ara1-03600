ms3581	 الله عنه } ض : حدثنا شريك بن عبد الله بن عمرو بن عامر عن أنس قال : سألناه عن الوضوء عند كل صلاة ، فقال : كان النبي صلى الله عليه وسلم يتوضأ عند كل صلاة وأما نحن فكنا نجترئ أو نصلي بوضوء واحد صلاة يومنا أو قال لصلاتنا .(@)(@@) PageV09P206(@)(@@) | 1 ( { مكروه الوضوء } ) 1(@)(@@) 27012 - عن عمر قال : رأيت رسول الله صلى الله عليه وسلم يستقى ماء لوضوئه فبادرته أستقي له فقال : مه يا عمر فإني أكره أن يشركني في طهوري أحد ، وفي لفظ : لا أحب أن يعينني على وضوئي أحد .(@)(@@) % ( البزار وابن جرير وضعف ، ع قط في الأفراد ) .(@)(@@) 27013 - عن جابر بن عبد الله قال : إذا توضأت فلا تمندل .(@)(@@) % ( عب ) .(@)(@@) 27014 - عن جابر بن عبد الله قال : رأى رسول الله صلى الله عليه وسلم قوما قد توضؤوا ولم يمس أعقابهم الماء فقال : ويل للأعقاب من النار .(@)(@@) % ( ص ) .(@)(@@) 27015 - عن الحكم بن عمرو الغفاري قال : نهى رسول الله صلى الله عليه وسلم أن يتوضأ بفضل وضوء المرأة .(@)(@@) % ( أبو نعيم ) .(@)(@@) 27016 - { مسند معاوية } نهيت أن أتوضأ في النحاس .(@)(@@) % ( ش ) .(@)(@@) 27017 - نهيت أن أتوضأ في النحاس وأن آتي أهلي في غرة الهلال ، وإذا انتهيت من سنتي للصلاة أن أستاك .(@)(@@) % ( عب ) .(@)(@@) 27018 - عن ابن عباس أنه كره أن يمسح بالمنديل من الوضوء ولم يكرهه إذا اغتسل من الجنابة .(@)(@@) % ( عب ) .(@)(@@) 27019 - عن ابن عمر قال : ليدعين أناس يوم القيامة المنقوصين قيل : يا أبا عبد الرحمن وما المنقوصون ؟ قال : ينقص أحدهم صلاته في وضوئه والتفاته .(@)(@@) % ( عب ) .(@)(@@) 27020 - عن نافع أن ابن عمر كان يكره أن يتوضأ في النحاس .(@)(@@) % ( عب ، ص ) .(@)(@@) 27021 - عن عبد الله بن دينار أن ابن عمر كان لا يتوضأ في الصفر .(@)(@@) % ( عب ) .(@)(@@) 27022 - عن عبد الله بن دينار قال : كان ابن عمر يغسل قدميه في طست من نحاس وكان يكره أن يشرب في قدح من صفر .(@)(@@) % ( عب ) .(@)(@@) 27023 - عن إبراهيم قال : كانوا يقولون : كثرة الوضوء من الشيطان .(@)(@@) % ( ص ) .(@)(@@) 27024 - عن إبراهيم قال : تشديد الوضوء من الشيطان لو 
ms3582	 كان فضلا لأوثر به أصحاب محمد صلى الله عليه وسلم .(@)(@@) % ( ص ) .(@)(@@) 27025 - عن إبراهيم قال : لم يكونوا يلطمون وجوههم بالماء في الوضوء .(@)(@@) % ( ص ) .(@)(@@) 27026 - عن إبراهيم قال : لم يكونوا يلطمون وجوههم بالماء ، وكانوا أشد استبقاء للماء منكم في الوضوء ، وكانوا يرون أن ربع المد يجزيء من الوضوء وكانوا أصدق ورعا وأسخى نفسا وأصدق عند البأس .(@)(@@) % ( ص ) .(@)(@@) PageV09P207(@)(@@) 27027 - عن الزهري قال : مر رسول الله صلى الله عليه وسلم برجل يتوضأ يغرف الماء في وضوئه فقال : يا عبد الله لا تسرف فقال : يا نبي الله وفي الوضوء إسراف ؟ قال : نعم .(@)(@@) % ( ص ) .(@)(@@) | 1 ( { ذيل الوضوء } ) 1(@)(@@) 27028 - عن يحيى بن سعيد أن عمر بن الخطاب خرج إلى الصلاة فقبلته امرأته فصلى ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27029 - عن يحيى بن سعيد عن أبي بكر بن محمد بن عمرو بن حزم عن عبد الله بن عبد الله بن عمر أن عاتكة بنت زيد قبلت عمر بن الخطاب وهو صائم فلم ينهها قال وهو يريد الصلاة ثم مضى فصلى ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27030 - { مسند علي كرم الله وجهه } عن عبد خير قال : رأيت عليا دعا بالماء ليتوضأ فمسح يديه مسحا ومسح على قدميه وقال : هذا وضوء من لم يحدث ، ثم قال : لولا أني رأيت رسول الله صلى الله عليه وسلم مسح على ظهر قدميه رأيت أن بطونهما أحق ، ثم شرب فضل وضوئه وهو قائم ، ثم قال : أين الذين يزعمون أنه لا ينبغي لأحد أن يشرب قائما .(@)(@@) % ( حم ) .(@)(@@) 27031 - عن النوال بن سبرة قال : أتي علي بكوز من ماء وهو بالرحبة فأخذ كفا من ماء وتمضمض واستنشق ومسح وجهه وذراعيه ورجليه ثم شرب فضل الماء وهو قائم ، ثم قال : هذا وضوء من لم يحدث هكذا رأيت رسول الله صلى الله عليه وسلم فعل .(@)(@@) % ( ط حم خ ( أخرجه أبو داود كتاب الطهارة باب صفة وضوء النبي صلى الله عليه وسلم ( 108 ) ص ) د ت في الشمائل ، ن ، ع وابن جرير وابن خزيمة والطحاوي ق ) .(@)(@@) 27032 - { مسند بريدة بن الحصيب 
ms3583	 الأسلمي رضي الله عنه } كان النبي صلى الله عليه وسلم يتوضأ لكل صلاة فلما كان يوم الفتح صلى الصلوات كلها بوضوء واحد .(@)(@@) % ( عب ، ش ) .(@)(@@) 27033 - عن الحسن بن علي أن النبي صلى الله عليه وسلم كان إذا توضأ قصد موضع سجوده بماء حتى يسيله على موضع السجود .(@)(@@) % ( كر ) .(@)(@@) 27034 - { مسند رفاعة بن رافع } عن عباية بن رافع قال : وضأت ابن عمر فقمت عن يمينه فقال : ممن أخذت هذا ؟ فقلت : من رفاعة فقال : من هنالك .(@)(@@) % ( عب ) .(@)(@@) 27035 - عن أبي أوس قال : انتهيت مع أبي إلى ماء من مياه الأعراب فتوضأ ومسح على نعليه فقلت له في ذلك ، فقال : رأيت رسول الله صلى الله عليه وسلم فعله .(@)(@@) % ( ش ، ق ) .(@)(@@) 27036 - { مسند عبد الله بن زيد المازني } أتانا رسول الله صلى الله عليه وسلم فأخرجنا له ماء في تور من صفر فتوضأ به .(@)(@@) % ( ش ) .(@)(@@) 27037 - عن زينب بنت جحش قال : توضأ رسول الله صلى الله عليه وسلم في مخضبي ( مخضبي : المخضب : المركن وهو إناء تغسل فيه الثياب . المختار [ 138 ] ب ) هذا مخضب من صفر .(@)(@@) % ( ص ) .(@)(@@) PageV09P208(@)(@@) 27038 - عن عائشة انطلق النبي صلى الله عليه وسلم يبول فاتبعه عمر بماء فقال : ما هذا يا عمر ؟ فقال : ماء توضأ به ، فقال : ما أمرت كلما بلت أن أتوضأ ولو فعلت لكانت سنة .(@)(@@) % ( ش ) .(@)(@@) 27039 - { مسند علي } عن الحارث أن عليا دعا بالوضوء فتوضأ ثم قام فشرب فضل وضوئه ، ثم قال : هكذا رأيت رسول الله صلى الله عليه وسلم فعل حين جاءه الأعرابي يسأله .(@)(@@) % ( ابن جرير ) .(@)(@@) 27040 - عن أنس قال : أحدنا يكفيه الوضوء ما لم يحدث .(@)(@@) % ( عب ) .(@)(@@) 27041 - عن أوس بن أبي أوس قال : رأيت رسول الله صلى الله عليه وسلم توضأ ومسح على نعليه ثم قام إلى الصلاة .(@)(@@) % ( ط ، حم والعدني ، حب وأبو نعيم ، ض ) .(@)(@@) 27042 - ثنا هشيم أنا يعلى بن عطاء عن أبيه قال : أخبرني أوس ابن أبي أوس الثقفي أنه رأى النبي صلى الله عليه وسلم أتى كظامة قوم بالطائف فتوضأ ومسح على قدميه قال 
ms3584	 هشيم : كان هذا في أول الإسلام .(@)(@@) | 1 ( فصل في نواقض الوضوء ) 1(@)(@@) 27043 - عن أبي بكر قال : رأيت رسول الله صلى الله عليه وسلم أكل لحما ثم صلى ولم يتوضأ .(@)(@@) % ( ابن أبي حاتم في العلل وقال الناس يروونه موقوفا كما في الموطأ ) .(@)(@@) 27044 - عن جابر بن عبد الله أن أبا بكر أكل كتف شاة ، ثم قام إلى الصلاة ولم يتوضأ ، فقيل له : نأتيك بوضوء ؟ فقال : إني لم أحدث .(@)(@@) % ( عب ) .(@)(@@) 27045 - عن أبي المليح قال : كنا مع أبي بكر وقد خرج لصلاة المغرب وأذن المؤذن فتلقي بقصعة فيها ثريد ولحم فقال : اجلسوا فكلوا فإنما صنع الطعام ليؤكل ، فأكل ثم دعا بماء فغسل أطرافه ومضمض وصلى .(@)(@@) % ( ش ) .(@)(@@) 27046 - عن عمر بن الخطاب قال : من مس إبطه فليتوضأ .(@)(@@) % ( عب ، ص ، قط ) .(@)(@@) 27047 - عن عمر بن الخطاب قال : من نام مضجعا فليتوضأ .(@)(@@) % ( مالك ، عب ، ش والحارث ، ق ) .(@)(@@) 27048 - عن عمر قال : إن القبلة من اللمس فتوضؤا منها .(@)(@@) % ( قط ك ق ) .(@)(@@) 27049 - عن عمر إنه ليخرج من أحدنا مثل الجمانة ( الجمانة : حبة تعمل من الفضة كالدرة ، وجمعه جمان . المختار [ 84 ] ب ) ، وفي لفظ مثل الخريزة فإذا وجد أحدكم ذلك فليغسل ذكره وليتوضأ وضوءه للصلاة يعني المذي .(@)(@@) % ( مالك عب ص ) .(@)(@@) 27050 - عن ربيعة بن عبد الله الهديري أنه تعشى مع عمر بن الخطاب ثم صلى ولم يتوضأ .(@)(@@) % ( مالك ) .(@)(@@) PageV09P209(@)(@@) 27051 - عن ابن جرير قال : سمعت عبد الله بن أبي مليكة يحدث عمن لا أتهم أن عمر بن الخطاب بينا هو قائم يصلي بالناس حين بدأ بالصلاة نزلت يده على ذكره فأشار إلى الناس أن امكثوا وذهب فتوضأ ، ثم جاء فصلى فقال له أبي : فلعله وجد مذيا ؟ قال : لا أدري .(@)(@@) % ( عب ) .(@)(@@) 27052 - عن عمر أنه سئل عن المذي فقال : هو القطر وفيه الوضوء .(@)(@@) % ( أبو عبيد وأبو عروبة في مسند القاضي أبي يوسف ) .(@)(@@) 27053 - عن عمر قال : من مس فرجه فليتوضأ .(@)(@@) % ( أبو طاهر الحناني في الحنانيات ) .(@)(@@) 27054 - عن عمر قال : الوضوء مما يخرج وليس مما يدخل من الخراءة والبول 
ms3585	 والحدث .(@)(@@) % ( ص ) .(@)(@@) 27055 - عن علي قال : سألت النبي صلى الله عليه وسلم عن المذي فقال : فيه الوضوء وفي المني الغسل .(@)(@@) % ( ص ، ش ، ت ( أخرجه الترمذي كتاب الطهارة باب ما جاء في المني والمذي رقم ( 114 ) وقال : حسن صحيح . ص ) وقال : حسن صحيح ، ع والطحاوي ، ص ) .(@)(@@) 27056 - عن علي قال : كنت أجد مذيا فأمرت المقداد أن يسأل النبي صلى الله عليه وسلم عن ذلك لأن ابنته عندي فاستحييت أن أسأله لأن ابنته تحتي فسأله فقال : إن كل فحل يمذي ، فإذا كان المني ففيه الغسل ، وإذا كان المذي ففيه الوضوء .(@)(@@) % ( ش ، ص ) .(@)(@@) 27057 - عن علي قال : كنت رجلا مذاء وكان تحتي بنت رسول الله صلى الله عليه وسلم فكنت أستحيي أن أسأله فأمرت رجلا ، فقال : إذا رأيت المذي فتوضأ واغسل ذكرك ، وإذا رأيت فضخ ( فضخ : أي دفقه ، يريد المني . النهاية [ 3 / 453 ] ب ) الماء فاغتسل .(@)(@@) % ( ط ش د ن ( أخرجه النسائي كتاب الطهارة باب الغسل من المني رقم ( 194 ) ص ) وابن خزيمة حب والدورقي ص ) .(@)(@@) 27058 - عن علي قال : كنت رجلا مذاء فكنت إذا رأيت شيئا من ذلك اغتسلت فبلغ ذلك النبي صلى الله عليه وسلم فأمرني أن أتوضأ .(@)(@@) % ( ش ) .(@)(@@) 27059 - عن علي قال : كنت رجلا مذاء فكنت أستحيي أن أسأل رسول الله صلى الله عليه وسلم لمكان ابنته فأمرت المقداد بن الأسود فسأله فقال : يغسل ذكره ويتوضأ .(@)(@@) % ( ط حم خ ( أخرجه البخاري كتاب الغسل باب غسل المذي والوضوء منه . ( 1 / 76 ) ص ) م ن وابن جرير وابن خزيمة والطحاوي والدورقي ، ق ) .(@)(@@) 27060 - عن علي قال : جاء أعرابي إلى النبي صلى الله عليه وسلم فقال : يا رسول الله إنا نكون بالبادية فيخرج من أحدنا الرويحة ؟ فقال رسول الله صلى الله عليه وسلم : إن الله لا يستحيي من الحق إذا فسا أحدكم فليتوضأ ، ولا تأتوا النساء في أعجازهن وقال مرة : في أدبارهن .(@)(@@) % ( حم والعدني ورجاله ثقات ) .(@)(@@) 27061 - عن علي قال : كنت غلاما مذاء فلما رأى رسول الله صلى الله عليه وسلم الماء قد 
ms3586	 آذاني قال : إنما الغسل من الماء الدافق .(@)(@@) % ( ق ) .(@)(@@) PageV09P210(@)(@@) 27062 - عن علي قال : كنت أجد من المذي شدة فأردت أن أسأل رسول الله صلى الله عليه وسلم وكانت ابنته عندي ، فاستحييت أن أسأله فأمرت عمار بن ياسر فسأله فقال : إنما يكفي منه الوضوء .(@)(@@) % ( الحميدي والعدني ن والطحاوي ، عق ) .(@)(@@) 27063 - { أيضا } عن عروة أن علي بن أبي طالب قال للمقداد : سل رسول الله صلى الله عليه وسلم عن المذي فسأله المقداد فقال رسول الله صلى الله عليه وسلم : ليغسل ذكره وانثييه ويتوضأ وضوءه للصلاة .(@)(@@) % ( د ، ن ، ق ) .(@)(@@) 27064 - { مسند البراء بن عازب } سئل رسول الله صلى الله عليه وسلم عن الوضوء من لحوم الإبل فقال : توضؤا منها .(@)(@@) % ( ش ) .(@)(@@) 27065 - { مسند ثوبان مولى رسول الله صلى الله عليه وسلم } عن سعد بن أبي طلحة أن أبا الدرداء حدثه أن النبي صلى الله عليه وسلم قاء فأفطر فلقيت ثوبان فقال : صدق أنا صببت له الوضوء .(@)(@@) % ( أبو نعيم ) .(@)(@@) 27066 - { من مسند جابر بن سمرة } كنا نتوضأ من لحوم الغنم .(@)(@@) % ( ش ) .(@)(@@) 27067 - { أيضا } أمرنا رسول الله صلى الله عليه وسلم أن نوضأ من لحوم الإبل ولا نتوضأ من لحوم الغنم وأن نصلي في دمن ( دمن : جمع دمنة : وهي ما تدفعه الإبل والغنم بأبوالها وأبعارها : النهاية ( 2 / 134 ) ص ) الغنم ولا نصلي في أعطان الإبل .(@)(@@) % ( ش ) .(@)(@@) 27068 - عن علي بن طلق قال : أتى النبي صلى الله عليه وسلم أعرابي فقال : يا رسول الله الرجل منا يكون بأرض الفلاة فتكون منه الرويحة ويكون في الفلاة وفي الماء قلة فقال رسول الله صلى الله عليه وسلم إن الله لا يستحي من الحق إذا فسا أحدكم فليتوضأ .(@)(@@) % ( ابن جرير ) .(@)(@@) 27069 - عن النبي بن طلق أن النبي صلى الله عليه وسلم قال : إذا فسا أحدكم في الصلاة فلينصرف فليتوضأ ثم ليعد الصلاة .(@)(@@) % ( ابن جرير ) .(@)(@@) 27070 - { مسند عمرو بن أمية الضمري } أن النبي صلى الله عليه وسلم احتز من كتف شاة ثم صلى ولم يتوضأ .(@)(@@) % ( عب ، ش ) .(@)(@@) 27071 - { مسند المقداد بن الأسود 
ms3587	 } أن عليا أمره أن يسأل النبي صلى الله عليه وسلم عن الرجل إذا دنا إلى امرأته فخرج منه المذي فماذا عليه فإن عندي ابنته وأنا استحيي أن أسأله ؟ فسألت رسول الله صلى الله عليه وسلم عن ذلك فقال : إذا وجد أحدكم ذلك فلينضح فرجه وليتوضأ وضوءه للصلاة .(@)(@@) % ( عب ) .(@)(@@) 27072 - { مسند أبي أمامة } أن النبي صلى الله عليه وسلم سئل عن مس الذكر فقال : هل هو إلا جذوة ( جذوة : الجذوة : القطعة . قال مجاهد في قوله تعالى : ( أو جذوة من النار ) أي قطعة من الجمر ، قال : وهي بلغة جميع العرب المختار صفحة / 72 / ) منك ؟(@)(@@) % ( ش ) .(@)(@@) 27073 - { مسند أبي أمامة } أن رجلا سأل النبي صلى الله عليه وسلم فقال : مسست ذكري وأنا أصلي قال : لا بأس إنما هو جذبة منك .(@)(@@) % ( عب وهو ضعيف ) .(@)(@@) 27074 - { مسند أبي أمامة } قلت يا رسول الله يتوضأ للصلاة ثم يقبل أهله ويلاعبها ينقض ذلك وضوءه ؟ قال : لا .(@)(@@) % ( عد ، كر وفيه ركن بن عبد الله الشامي متروك ) .(@)(@@) PageV09P211(@)(@@) 27075 - عن سهل بن حنيف قال : كنت ألقى من المذي شدة فأكثر منه الاغتسال فسألت رسول الله صلى الله عليه وسلم فقال : إنما يجزئك من ذلك الوضوء قلت : يا رسول الله فكيف بما يصيب من ثوبي منه فقال إنما يكفيك كف من ماء تنضح من ثوبك حيث ترى أنه أصاب .(@)(@@) % ( م ، ص ، ش ) .(@)(@@) 27076 - { مسند أبي رافع } طبخت لرسول الله صلى الله عليه وسلم بطن شاة فأكل منها ، ثم صلى العشاء فلم يتوضأ .(@)(@@) % ( طب ) .(@)(@@) 27077 - عن أبي رافع رأيت النبي صلى الله عليه وسلم أكل كتفا ثم قام إلى الصلاة ولم يمس ماء .(@)(@@) % ( ش ) .(@)(@@) 27078 - { مسند أبي رافع } ذبحت للنبي صلى الله عليه وسلم عناقا ( عناقا : العناق - بالفتح - : الأنثى من ولد المعز ، والجمع أعنق وعنوق . انتهى . ص 360 المختار . ب ) فأكل ولم يتوضأ ولم يمس ماء ولم يتمضمض .(@)(@@) % ( طب ) .(@)(@@) 27079 - { أيضا } ذبحت للنبي صلى الله عليه وسلم شاة بشظاظ ( بشظاظ : الشظاظ : خشبة محددة الطرف تدخل بين عروتي الجوالقين لتجمع بينهما عند حملهما 
ms3588	 على البعير ، والجمع أشظة . انتهى . النهاية 2 / 476 ب ) وشويته فأكل ولم يتمضمض ولم يتوضأ .(@)(@@) % ( طب - عن أبي رافع ) .(@)(@@) 27080 - { مسند أبي سعيد } ض ثنا محمد بن ثابت العبدي عن أبي هارون العبدي عن أبي سعيد الخدري قال : بعث علي رجلا إلى النبي صلى الله عليه وسلم فسأله عن الرجل يمر في الطريق فيرى المرأة فيمذي أفعليه الغسل وكره علي أن يسأله لمكان فاطمة ؟ فقال رسول الله صلى الله عليه وسلم : تلك يلقاها فحول الرجال يجزئك من ذلك الوضوء .(@)(@@) % ( ض ) .(@)(@@) 27081 - عن أبي هريرة قال : من استحق النوم فعليه الوضوء .(@)(@@) % ( عب ، ص ) .(@)(@@) 27082 - عن أبي هريرة قال : لا وضوء إلا من حدث فساء أو ضراط .(@)(@@) % ( ص ) .(@)(@@) 27083 - عن مجاهد قال : بينا نحن جلوس أصحاب ابن عباس عطاء وطاوس وعكرمة إذ جاء رجل وابن عباس قائم يصلي فقال : هل من مفت ؟ فقلت : سل فقال : إني كلما بلت تبعه الماء الدافق ، فقلنا : الذي يكون منه الولد ؟ قال : نعم فقلنا عليك الغسل فولى الرجل وهو يرجع ( يرجع : رجع واسترجع أي قال : إنا لله وإنا إليه راجعون . النهاية ( 2 / 202 ) / ص / ) وعجل ابن عباس في صلاته فلما سلم قال : يا عكرمة علي بالرجل فأتاه به ، ثم أقبل علينا فقال : أرأيتم ما أفتيتم به هذا الرجل عن كتاب الله ؟ قلنا : لا قال : فمن سنة رسول الله صلى الله عليه وسلم ؟ قلنا : لا قال : فعن أصحاب رسول الله صلى الله عليه وسلم ؟ قلنا : لا قال : فعمن ؟ قلنا : عن رأينا فقال : لذلك يقول رسول الله صلى الله عليه وسلم ( هذه الفقرة وردت عند الترمذي من حديث ابن عباس كتاب العلم باب ما جاء في فضل الفقه على العبادة رقم / 2681 / وقال غريب . ض ) : فقيه واحد أشد على الشيطان من ألف عابد ، ثم أقبل على الرجل فقال : أرأيت إذا كان منك هل تجد شهوة في قلبك ؟ قال : لا قال : فهل تجد خدرا في جسدك ؟ قال : لا قال : إنما هذا بردة يجزئك منه الوضوء .(@)(@@) % ( كر وسنده حسن ) .(@)(@@) PageV09P212(@)(@@) 27084 - عن 
ms3589	 أبي العالية عن رجل من الأنصار أن رسول الله صلى الله عليه وسلم كان يصلي بأصحابه فمر رجل في بصره سوء فتردى في بئر فضحك طوائف من القوم فأمر رسول الله صلى الله عليه وسلم من ضحك يعيد الوضوء والصلاة .(@)(@@) % ( ص ) .(@)(@@) 27085 - { مسند بسرة بنت صفوان } قلت : يا رسول الله إحدانا تتوضأ للصلاة فتفرغ وضوءها ثم تدخل يدها في درعها فتمس فرجها أيجب عليها الوضوء ؟ قال : نعم إذا مست فرجها فلتعد الوضوء .(@)(@@) % ( عب ) .(@)(@@) 27086 - عن ابن عباس قال : من المني الغسل ، ومن الودي والمذي الوضوء يغسل حشفته ويتوضأ منه .(@)(@@) % ( عب ، ص ) .(@)(@@) 27087 - عن ابن عباس قال : الوضوء مما خرج وليس مما دخل ولا يتوضأ من موطئ .(@)(@@) % ( عب ، ص ، ش ) .(@)(@@) 27088 - عن ابن عمر قال : من مس ذكره فليتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27089 - عن نافع أن ابن عمر كان ينام وهو جالس فلا يتوضأ ، وإذا نام مضطجعا أعاد الوضوء .(@)(@@) % ( عب ) .(@)(@@) 27090 - حدثنا أبو معاوية عن الأعمش عن إبراهيم قال : دخل رجل سييء البصر المسجد والنبي صلى الله عليه وسلم يصلي بالناس فوقعت رجله في بئر فضحك القوم فأمرهم صلى الله عليه وسلم بإعادة الوضوء وإعادة الصلاة . مر برقم / 27084 /(@)(@@) 27091 - ثنا أبو معاوية ثنا هشام عن حفصة عن أبي العالية عن النبي صلى الله عليه وسلم مثله .(@)(@@) 27092 - عن ابن مسعود قال : القبلة من اللمس ومنها الوضوء .(@)(@@) % ( عب ، ش ) .(@)(@@) 27093 - عن ابن مسعود رضي الله عنه قال : القبلة من اللمس وفيها الوضوء واللمس ما دون الجماع .(@)(@@) % ( ش ) .(@)(@@) 27094 - عن علي قال قلت للمقداد : سل رسول الله صلى الله عليه وسلم فإني لولا أن تحتى ابنته سألته عن أحدنا إذا اقترب من امرأته فأمذى ولم يملك ذلك ولم يمسها ؟ فسأل المقداد رسول الله صلى الله عليه وسلم ، فقال رسول الله صلى الله عليه وسلم : إذا أمذى أحدكم ولم يمسها فليغسل ذكره وأنثييه ، ثم ليتوضأ وليصل .(@)(@@) % ( عب ، طب وابن النجار ) .(@)(@@) 27095 - { أيضا } عن ابن عباس عن علي قال : كنت رجلا مذاء فكنت أكثر منه الاغتسال 
ms3590	 فسألت النبي صلى الله عليه وسلم فقال : يكفيك منه الوضوء .(@)(@@) % ( ابن النجار ) .(@)(@@) 27096 - عن مصعب بن سعد قال : كنت أمسك المصحف على سعد بن أبي وقاص فاحتككت فقال سعد : لعلك مسست ذكرك ؟ قلت نعم قال : فتوضأ .(@)(@@) % ( عب ، ص وابن أبي داود في المصاحف ) .(@)(@@) PageV09P213(@)(@@) 27097 - عن علي أنه قال للمقداد : سل لي رسول الله صلى الله عليه وسلم عن الرجل يلاعب امرأته ويكلمها فيكون منه المذي فإنه لولا ابنته تحتي لسألته فسأله المقداد فقال : يغسل ذكره وانثييه ثم لينضح فرجه .(@)(@@) % ( عق والطحاوي ) .(@)(@@) 27098 - عن عابس بن أنس أحد بني سعد بن ليث قال : تذاكر علي بن أبي طالب وعمار بن ياسر والمقداد بن الأسود المذى فقال علي : إني رجل مذاء فاسألوا عن ذلك رسول الله صلى الله عليه وسلم فإني استحيى أن أسأله عن ذلك لمكان ابنته مني فسأله أحد الرجلين فقال النبي صلى الله عليه وسلم : ذاكم المذي إذا وجده أحد منكم فليغسل ذلك منه ثم ليتوضأ فيحسن وضوءه ثم لينضح فرجه .(@)(@@) % ( عق ) .(@)(@@) 27099 - { مسند أبي } عن ابن عباس أنه أتى أبيا ومعه عمر فخرج عليهما فقال : إني وجدت مذيا فغسلت ذكرى وتوضأت فقال عمر : أو يجزيء ذلك ؟ قال : نعم قال : أسمعته من رسول الله صلى الله عليه وسلم قال : نعم .(@)(@@) % ( ش ، ه ) .(@)(@@) | 1 ( { مالا ينقض الوضوء } ) 1(@)(@@) 27100 - عن ابن عباس أكل النبي صلى الله عليه وسلم كتفا ثم مسح يده بمسح كان تحته ثم قام فصلى .(@)(@@) % ( ش ) .(@)(@@) 27101 - عن ابن عباس أن رسول الله صلى الله عليه وسلم أكل من عظم أو تعرق من ضلع ثم صلى ولم يتوضأ .(@)(@@) % ( عب ، ش ، ص ) .(@)(@@) 27102 - عن ابن عباس أن رسول الله صلى الله عليه وسلم خرج وهو يريد الصلاة فمر بقدر يفور فأخذ منها عرقا أو كتفا فأكله ثم مضى إلى الصلاة ولم يتوضأ .(@)(@@) % ( ص ، ش ) .(@)(@@) 27103 - { أيضا } بينا رسول الله صلى الله عليه وسلم يأكل عرقا أتاه المؤذن فوضعه وقام إلى الصلاة ولم يمس ماء .(@)(@@) % ( عب ) .(@)(@@) 27104 - { أيضا } كان 
ms3591	 رسول الله صلى الله عليه وسلم وأصحابه في بيته فجاءه المؤذن فقام إلى الصلاة حتى إذا كان بالباب لقي بصحفة فيها خبز ولحم فرجع بأصحابه فأكل وأكلوا ثم رجع إلى الصلاة ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27105 - { أيضا } بت عند خالتي ميمونة فقام النبي صلى الله عليه وسلم يصلي من الليل فأتى الحاجة ثم جاء فغسل وجهه ويديه ثم نام ثم قام يصلي من الليل فأتى القربة ثم توضأ وضوء من لم يكثر وقد أبلغ ثم قام فصلى وتمطيت كراهية أن يراني أبقيه يعني أراقبه ثم قمت ففعلت كما فعل فقمت عن يساره فأخذ بما يلي أذني حتى أدارني فكنت عن يمينه وهو يصلي فتتامت صلاته إلى ثلاث عشرة ركعة منها ركعتا الفجر ، ثم اضطجع فنام حتى نفخ ثم جاء بلال فأذنه بالصلاة فقام فصلى ولم يتوضأ وكان في دعائه : اللهم اجعل في قلبي(@)(@@) PageV09P214 نورا وفي سمعي نورا ، وفي بصري نورا ، وعن يميني نورا ، وعن يساري نورا ، ومن فوقي نورا ، ومن تحتي نورا ، ومن بين يدي نورا ومن خلفي نورا وأعظم لي نورا ، قال كريب وست عندي في التابوت وعصبي ومخي ودمى وشعري وبشري وعظامي .(@)(@@) % ( عب ) .(@)(@@) 27106 - { أيضا } زرت خالتي ميمونة فوافقت ليلة النبي صلى الله عليه وسلم فقام من الليل يصلي ثم نام فلقد سمعت صفيره ثم جاء بلال يؤذنه بالصلاة فخرج إلى الصلاة ولم يتوضأ ولم يمس ماء .(@)(@@) % ( ش ) .(@)(@@) 27107 - عن ابن عباس قال : أكل رسول الله صلى الله عليه وسلم لحما ثم صلى ولم يتوضأ .(@)(@@) % ( كر ) .(@)(@@) 27108 - عن ابن عباس قال : وجب الوضوء على كل نائم إلا من خفق برأسه خفقة أو خفقتين وهو قائم أو قاعد .(@)(@@) % ( ص ) .(@)(@@) 27109 - عن الزهري عن رجل من الأنصار عن أبيه قال : رأيت رسول الله صلى الله عليه وسلم أكل من كتف شاة ثم قام إلى الصلاة ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27110 - عن ابن عباس قال : رأيت النبي صلى الله عليه وسلم يأكل مما مست النار ثم يصلي ولا يتوضأ .(@)(@@) % ( ص ، ش ) .(@)(@@) 27111 - عن 
ms3592	 ابن عباس أن رسول الله صلى الله عليه وسلم شرب لبنا ثم دعا بماء فتمضمض ثم قال : إن له دسما .(@)(@@) % ( ص ) خ ( أخرجه البخاري كتاب الوضوء باب هل يمضمض من اللبن ( 1 / 63 ) ص ) ، م ، د ، ت ، ن ، ه وابن جرير ) .(@)(@@) 27112 - عن ابن عباس قال : تضيفت ميمونة وهي ليلتئذ لا تصلي فجاءت بكساء ثم جاءت بكساء آخر فطرحته عند رأس الفراش ، ثم اضطجعت ومدت الكساء عليها وبسطت لي بسيطا إلى جنبها فتوسدت معها على وسادها فجاء النبي صلى الله عليه وسلم وقد صلى العشاء الآخرة فانتهى إلى الفراش فأخذ خرقة عند رأس الفراش فاتزر بها وخلع ثوبيه فعلقهما ثم دخل معها في لحافها حتى إذا كان في آخر الليل قام إلى سقاء معلق فحله ثم توضأ منه فهممت أن أقوم فأصب عليه ثم كرهت أن يرى أني كنت مستيقظا ثم جاء إلى الفراش فأخذ ثوبيه وخلع الخرقة ثم قام إلى المسجد فقام يصلي فقمت فتوضأت ثم جئت فقمت عن يساره فتناولني بيده على ورائه فأقامني عن يمينه فصلى فصليت معه ثلاث عشرة ركعة ثم جلس وجلست إلى جنبه فأصغى بخده إلى خدي حتى سمعت نفس النائم ، ثم جاء بلال فقال : الصلاة يا رسول الله فقام إلى المسجد فأخذ في الركعتين وأخذ بلال في الإقامة .(@)(@@) % ( ابن النجار ) .(@)(@@) 27113 - عن عكرمة عن ابن عباس قال : بت عند خالتي ميمونة فقلت لأنظرن إلى النبي صلى الله عليه وسلم فقام من الليل فقمت معه فبال وتوضأ وضوءا خفيفا ثم عاد ثم قام فبال وتوضأ فأحسن الوضوء ، ثم توضأت ، ثم قام يصلي من الليل فقمت خلفه فأهوى بيده(@)(@@) PageV09P215 وأخذ برأسي ، فأقامني عن يمينه إلى جنبه فصلى أربعا أربعا ثم أوتر بثلاث ، ثم نام حتى سمعته ينفخ ثم أتاه المؤذن فخرج إلى الصلاة ولم يحدث وضوءا .(@)(@@) % ( ابن جرير ) .(@)(@@) 27114 - { مسند زينب بنت أم سلمة } أتي رسول الله صلى الله عليه وسلم بكتف شاة فأكل منه فصلى ولم يمس ماء .(@)(@@) % ( ش ) .(@)(@@) 27115 - عن إسحاق بن عبد 
ms3593	 الله بن الحارث بن نوفل الهاشمي قال : حدثتني صفية قالت : دخل علي رسول الله صلى الله عليه وسلم فقربت له كتفا باردة فكنت أسحا ( اسحا : في حديث أم حكيم ( أتته بكتف تسحاها ) أي تقشرها وتكشط عنها اللحم . انتهى . النهاية . 2 / 348 ب ) له ، فأكلها ثم قام فصلى .(@)(@@) % ( ع ) .(@)(@@) 27116 - عن ضباعة بنت الزبير أنها دفعت إلى رسول الله صلى الله عليه وسلم لحما فانتهش منه ثم صلى ولم يتوضأ .(@)(@@) % ( حم والشاشي ، ع ، ق ، ابن منده ) .(@)(@@) 27117 - عن عائشة أن النبي صلى الله عليه وسلم قبل بعض نسائه ثم خرج إلى الصلاة ولم يتوضأ قال عروة : فقلت : من هي إلا أنت فضحكت .(@)(@@) % ( ش ) .(@)(@@) 27118 - عن عائشة قالت : كان رسول الله صلى الله عليه وسلم يتوضأ ثم يخرج إلى الصلاة فيقبلني ثم يمضي إلى الصلاة فما يحدث وضوءا .(@)(@@) % ( عب ) .(@)(@@) 27119 - عن ابن عباس قال : وجب الوضوء على كل نائم إلا من أخفق خفقة برأسه .(@)(@@) % ( عب ) .(@)(@@) 27120 - عن ابن عباس قال : ما أبالي قبلتها أو شممت ريحانا .(@)(@@) % ( عب ) .(@)(@@) 27121 - عن ابن عباس قال : إنما النار بركة الله وما تحل من شيء ولا تحرمه ولا وضوء مما مست النار ولا وضوء مما دخل إنما الوضوء مما خرج من الإنسان .(@)(@@) % ( عب ) .(@)(@@) 27122 - عن عروة أن رجلا سأل عائشة عن الرجل يقبل امرأته أيعيد الوضوء ؟ فقالت : قد كان رسول الله صلى الله عليه وسلم يقبل بعض نسائه ثم لا يعيد الوضوء فقلت لها : لئن كان ذلك ما كان إلا منك فسكتت .(@)(@@) % ( كر وفيه الحسن بن دينار متروك ) .(@)(@@) 27123 - عن عائشة قالت : يتوضأ أحدكم من الطعام الطيب ولا يتوضأ من الكلمة العوراء ( الكلمة العوراء : الكلمة القبيحة الزائفة عن الرشد . النهاية 3 / 319 / ص ) يقولها .(@)(@@) % ( عب ) .(@)(@@) 27124 - عن جابر بن عبد الله عن عمرة بنت حزام أنها جعلت للنبي صلى الله عليه وسلم في صورة نخل ملتف كبيسه ( كبيسة : وفي الحديث ( أن رجلا جاء بكبائس من هذه النخل ) هي جمع كباسة ، وهو العذق التام بشماريخه ورطبه . النهاية 4 
ms3594	 / 144 . ب ) ورثيئة ( ورثيئة : الرثيئة : اللبن الحليب يصب عليه اللبن الحامض فيروب من ساعته . النهاية 2 / 195 . ب ) وطيبة ثم ذبحت له شاة فأكل ثم توضأ فصلى الظهر فقدمت إليه من لحمها فأكل فصلى العصر ولم يتوضأ .(@)(@@) % ( هب ) .(@)(@@) 27125 - عن سالم أو نافع أن ابن عمر كان يتوضأ مما مست النار .(@)(@@) % ( عب ) .(@)(@@) 27126 - عن أم الحكيم بنت الزبير أنها ناولت نبي الله صلى الله عليه وسلم كتفا من لحم فأكل منه ثم صلى ولم يتوضأ .(@)(@@) % ( حم وابن منده ) .(@)(@@) PageV09P216(@)(@@) 27127 - { أيضا } أن رسول الله صلى الله عليه وسلم دخل على ضباعة بنت الزبير فنهش عندها من كتف ثم خرج إلى الصلاة ولم يتوضأ .(@)(@@) % ( ش ) .(@)(@@) 27128 - عن أم حكيم بنت الزبير أن رسول الله صلى الله عليه وسلم دخل على أختها ضباعة بنت الزبير فنهش من كتف عندها ثم صلى عندها وما توضأ من ذلك .(@)(@@) % ( حم وابن منده ) .(@)(@@) 27129 - عن أم حكيم بنت الزبير أنها كانت تصنع للنبي صلى الله عليه وسلم طعاما فيأتيها فربما أكله عندها وإنها زعمت أنه أتاها يوما فأتته بكتف فجعلت تسحاها له فأكل منها ثم صلى ولم يتوضأ .(@)(@@) % ( كر ) .(@)(@@) 27130 - عن أم سلمى قالت : نهش رسول الله صلى الله عليه وسلم عندي كتفا ثم خرج إلى الصلاة ولم يمس ماء .(@)(@@) % ( عب ، ش ) .(@)(@@) 27131 - عن أم سلمة قالت : قربت لرسول الله صلى الله عليه وسلم جنبا مشويا فأكل منه ثم قام إلى الصلاة ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27132 - عن عبد الله بن شداد بن الهاد قال : قال أبو هريرة : الوضوء مما مست النار فقال مروان : كيف يسأل أحد وفينا أزواج نبينا صلى الله عليه وسلم وأمهاتنا فأرسلني إلى أم سلمة فسألتها فقالت : أتاني رسول الله صلى الله عليه وسلم وقد توضأ فناولته عرقا أو كتفا فأكل ثم قام إلى الصلاة ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27133 - عن هند ابنة سعيد بن أبي سعيد الخدري عن عمتها قالت : جاء رسول الله صلى الله عليه وسلم عائدا لأبي سعيد الخدري فقدمنا إليه ذراع 
ms3595	 شاة فأكل منه وحضرت الصلاة فقام فصلى ولم يتوضأ .(@)(@@) % ( ابن أبي خيثمة ، كر ) .(@)(@@) 27134 - عن ابن مسعود قال : رأيت النبي صلى الله عليه وسلم يأكل اللحم ثم يقوم إلى الصلاة فلا يمس قطرة ماء .(@)(@@) % ( ص ) .(@)(@@) 27135 - عن محمد بن المنكدر قال : دخلت على بعض نساء النبي صلى الله عليه وسلم وبيني وبينها حجاب فقلت حدثيني بشيء أكل رسول الله صلى الله عليه وسلم عندك مما غيرته النار ؟ قالت : نعم دخل علي رسول الله صلى الله عليه وسلم وعندي بطن معلق فقال : لو اتخذتم لنا هذا فأكلنا فطبخنا له فأكل وقام فصلى فلم يتوضأ قال محمد : دخلت أيضا على غيرها فسألتها فقالت : ما كان النبي صلى الله عليه وسلم يبيت حتى يغلى له جنب يكون بالمدينة فيأكله ثم يقوم فيصلي ولا يتوضأ .(@)(@@) % ( ص ، ض ) .(@)(@@) 27136 - حدثنا هشيم أنبأنا مغيرة عن إبراهيم أن النبي صلى الله عليه وسلم نام وهو في المسجد حتى نفخ ثم قام فصلى ولم يتوضأ وقال : إن النبي صلى الله عليه وسلم تنام عيناه ولا ينام قلبه .(@)(@@) % ( ض ) .(@)(@@) PageV09P217(@)(@@) 27137 - حدثنا أبو عوانة عن منصور عن إبراهيم التيمي قال : حدثنا أن النبي صلى الله عليه وسلم كان ينام وهو ساجد حتى ينفخ وكان يعرف نومه بنفخته ثم يقوم فيصلي .(@)(@@) % ( ض ) .(@)(@@) 27138 - { مسند ابن مسعود } كنا لا نتوضأ من موطئ ( موطئ : أي ما يوطأ من الأذى في الطريق . أراد لا نعيد الوضوء منه لا أنهم كانوا لا يغسلونه . ه 2 / 202 النهاية . ب ) ولا نكشف سترا ولا نكف شعرا ، قال ابن جريج : قوله لا نكشف سترا يده إذا كان عليها الثوب في الصلاة .(@)(@@) % ( عب ) .(@)(@@) 27139 - نهانا رسول الله صلى الله عليه وسلم أن نكشف سترا ونكف شعرا أو نحدث وضوءا ، قال يحيى بن أبي كثير : أن نكشف سترا يقول لا نكشف الثوب عن يده إذا سجد أو يحدث وضوءا قال : إذا وطئ نتنا وكان متوضئا .(@)(@@) % ( عب ) .(@)(@@) 27140 - عن عبيد الله بن عكراش قال : حدثني أبي عكراش بن ذويب قال : بعثني 
ms3596	 بنو مرة بن عبيد بصدقات أموالهم إلى رسول الله صلى الله عليه وسلم فقدمت عليه المدينة فوجدته جالسا بين المهاجرين والأنصار ، فأتيته بإبل كأنها عروق الأرطى ( جيء بابل كأنها عروق الأرطى هو شجر من شجر الرمل عروقه حمر وقد اختلف في همزته وقيل أنها أصلية لقولهم أديم مأروط وقيل زائدة لقولهم أديم مرطئ . النهاية 1 / 32 ) فقال : من الرجل ؟ فقلت عكراش بن ذويب فقال : ارفع في النسب فقلت ابن حرقوص بن جعدة بن عمرو بن النزال بن مرة بن عبيد وهذه صدقات بني مرة بن عبيد فتبسم رسول الله صلى الله عليه وسلم ثم قال : هذه إبل قومي هذه صدقات قومي ثم أمر بها أن توسم بميسم إبل الصدقة وتضم إليها ثم أخذ بيدي فانطلق بي إلى منزل أم سلمة فقال : هل من طعام فأتينا بجفنة كبيرة الثريد والودك ( الودك : هو دسم اللحم ودهنه الذي يستخرج منه . النهاية 5 / 169 ب ) فأقبلنا نأكل منها فأكل رسول الله صلى الله عليه وسلم مما بين يديه ، وجعلت أخبط في نواحيها فقبض رسول الله صلى الله عليه وسلم بيده اليسرى على يدي اليمنى ثم قال : يا عكراش كل من موضع واحد فإنه طعام واحد ، ثم أتينا بطبق فيه ألوان من رطب أو تمر شك عبيد الله بن عكراش رطبا كان أو تمرا ، فجعلت آكل مما بين يدي ، فجالت يد رسول الله صلى الله عليه وسلم ، ثم قال : يا عكراش كل من حيث شئت فإنه غير لون ثم أتينا بماء فغسل رسول الله صلى الله عليه وسلم يديه ، ثم مسح ببلل كفيه ووجهه وذراعيه ورأسه ثم قال : يا عكراش هكذا الوضوء مما غيرت النار .(@)(@@) % ( ابن النجار ) .(@)(@@) 27141 - عن عكرمة أن رسول الله صلى الله عليه وسلم أتى على قدر فانتشل منها عظما فأكله ثم صلى ولم يتوضأ .(@)(@@) % ( ص ) .(@)(@@) 27142 - { مسند أبي } عن أنس قال كنت أنا وأبي وأبو طلحة جلوسا فأكلنا خبزا ولحما ، ثم دعوت بوضوء فقالا لي : لم تتوضأ ؟ فقلت لهذا الطعام الذي 
ms3597	 أكلنا فقالا : أتتوضأ من الطيبات لم يتوضأ منه من هو خير منك .(@)(@@) % ( حم ) .(@)(@@) 27143 - { مسند أكيمة بن عبادة } رأيت رسول الله صلى الله عليه وسلم أكل كتفا وصلى ولم يتوضأ .(@)(@@) % ( ابن السكن ، قال في الإصابة واسناده مجهول ) .(@)(@@) PageV09P218(@)(@@) 27144 - { مسند أنس } عن أبي قلابة قال : أتيت أنس بن مالك فلم أجده فقعدت انتظره فجاء وهو مغضب فقال : كنت عند هذا يعني الحجاج فأكلوا ثم قاموا فصلوا ولم يتوضؤا ، فقلت : أو ما كنتم تفعلون هذا يا أبا حمزة ؟ قال : لا ما كنا نفعله .(@)(@@) % ( ص ، ش ، وهو صحيح ) .(@)(@@) 27145 - { أيضا } كان أصحاب رسول الله صلى الله عليه وسلم يخفقون برؤوسهم ينتظرون العشاء ثم يقومون فيصلون ولا يتوضؤن .(@)(@@) % ( ص ، ش ) .(@)(@@) 27146 - { أيضا } لقد رأيت أصحاب رسول الله صلى الله عليه وسلم يوقظون للصلاة وإني لأسمع لبعضهم غطيطا يعني وهو جالس فما يتوضؤن .(@)(@@) % ( عب ) .(@)(@@) 27147 - عن أنس قال : رأيت رسول الله صلى الله عليه وسلم تعرق كتفا أو عظما ثم مسح يده ولم يتوضأ .(@)(@@) % ( كر ) .(@)(@@) 27148 - عن أنس قال أتي النبي صلى الله عليه وسلم بعضو من لحم شواء وعنده أبو بكر الصديق ، ودخل عليهم عمر بن الخطاب فأكلوا جميعا ثم مسحوا بخرقة ، ثم انتظروا حتى أتاهم المؤذن بالمغرب فقاموا جميعا فصلوا ولم يتوضأ النبي صلى الله عليه وسلم وأبو بكر وعمر .(@)(@@) % ( كر ) .(@)(@@) 27149 - عن قيس بن السكن أن عليا وابن مسعود وحذيفة بن اليمان وأبا هريرة لا يرون من مس الذكر وضوءا وقالوا : لا بأس به .(@)(@@) % ( عب ) .(@)(@@) 27150 - عن ابن عمرو الشباني أن عليا استتاب المستورد العجلي وهو يريد الصلاة قال : إني أستعين بالله عليك ، فقال : إني أستعين بالمسيح عليك فأهوى علي بيده إلى عنقه فإذا هو بصليب فقطعه ، فلما دخل في الصلاة قدم رجلا وذهب ثم أخبر الناس أنه لم يحدث ذلك لحدث أحدثه ولكن من هذه الأنجاس فأحب أن يحدث منها وضوءا .(@)(@@) % ( عب ) .(@)(@@) 27151 - عن عبد الكريم بن أبي أمية أن عليا كان لا يتوضأ مما مست النار .(@)(@@) % ( عب ) .(@)(@@) 27152 - عن حبان 
ms3598	 بن الحارث قال : أتينا عليا وهو بعسكر أبي موسى فوجدته يطعم فقال : ادن فكل ، فقلت : إني أريد الصلاة فقال : وأنا أريد الصلاة فأكل حتى إذا فرغ قال لمؤذنه ابن التياح : أقم .(@)(@@) % ( الشافعي ومسرود والدورقي ، ق ) .(@)(@@) 27153 - { مسند الصديق } عن أبي بكر قال : رأيت النبي صلى الله عليه وسلم نهش من كتف ثم صلى ولم يتوضأ .(@)(@@) % ( ع وأبو نعيم في المعرفة والخلعي في فوائده والبزار ولفظه : أكل خبزا ولحما ثم صلى ولم يتوضأ ، وفيه انقطاع وضعف ) .(@)(@@) 27154 - عن عمر قال : من نقى أنفه أو حك إبطه فليتوضأ .(@)(@@) % ( ص ، ش ) .(@)(@@) PageV09P219(@)(@@) 27155 - عن أبي سبرة أن عمر بن الخطاب أكل من لحوم الإبل ثم صلى ولم يتوضأ .(@)(@@) 27156 - عن عطاء الخراساني سمعت سعيد بن المسيب يقول : إن عثمان بن عفان أكل طعاما قد مسته النار ، ثم مضى إلى الصلاة ولم يتوضأ ، ثم قال توضأت كما توضأ رسول الله صلى الله عليه وسلم ، وأكلت كما أكل رسول الله صلى الله عليه وسلم وصليت كما صلى رسول الله صلى الله عليه وسلم .(@)(@@) % ( عب ، حم والعدني ، ص ) .(@)(@@) 27157 - عن جابر قال : أكل عمر من جفنة ثم قام فصلى ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27158 - عن طلق بن حبيب قال : رأى عمر بن الخطاب رجلا حك أنفه أو مسه فقال : قم فاغسل يدك أو تطهر .(@)(@@) % ( ص ) .(@)(@@) 27159 - عن سعيد بن المسيب عن عمر أنه قعد على باب مسجد رسول الله صلى الله عليه وسلم فأكل لحما ، ثم صلى ولم يتوضأ وقال : قعدت مقعد رسول الله صلى الله عليه وسلم وأكلت طعام رسول الله صلى الله عليه وسلم وصليت صلاة رسول الله صلى الله عليه وسلم .(@)(@@) % ( أبو بكر الديباجي في فوائده ) .(@)(@@) 27160 - { مسند علي } عن علي قال : كان رسول الله صلى الله عليه وسلم يأكل الثريد ويشرب اللبن ويصلي ولا يتوضأ .(@)(@@) % ( ع وابن جرير ، ص ) .(@)(@@) 27161 - عن جابر بن عبد الله قال : أكلت مع رسول الله صلى الله عليه وسلم ومع أبي بكر وعمر وعثمان خبزا ولحما فصلوا ولم يتوضؤا 
ms3599	 .(@)(@@) % ( ص ، ش ) .(@)(@@) 27162 - { أيضا } قرب لرسول الله صلى الله عليه وسلم خبز ولحم ، ثم دعا بوضوء فتوضأ فصلى الظهر ، ثم عاد بفضل طعام فأكل ثم قام إلى الصلاة ولم يتوضأ .(@)(@@) % ( عب ) .(@)(@@) 27163 - عن جابر أن امرأة من الأنصار صنعت شاة لرسول الله صلى الله عليه وسلم فدعته في نفر من الصحابة وقربت لهم سورا ( سورا : في حديث جابر رضي الله عنه ( أن رسول الله صلى الله عليه وسلم قال لأصحابه : قوموا فقد صنع جابر سورا ) أي طعاما يدعو إليه الناس .(@)(@@) واللفظة فارسية . النهاية 2 / 420 . ب ) ثم أتتهم بطعام فأكل رسول الله صلى الله عليه وسلم وأكلنا معه فدعا بماء فتوضأ ، ثم صلى بنا الظهر ثم أتى بفضول طعامهم فأكلنا ، ثم قام فصلى بنا العصر ولم يتوضأ .(@)(@@) % ( كر ) .(@)(@@) 27164 - { أيضا } ص حدثنا فليح بن سليمان قال : سألنا الزهري عما مست النار فأخبرنا في ذلك بأحاديث أمر فيها بالوضوء عن أبي هريرة وعن عمر بن عبد العزيز وعن خارجة بن زيد وعن سعيد بن خالد وعن عبد الملك ابن أبي بكر فقلت له : إن ههنا رجلا من قريش يقال له عبد الله بن محمد يحدث عن جابر بن عبد الله أن رسول الله صلى الله عليه وسلم خرج إلى أهل سعد بن الربيع في نفر من أصحابه منهم جابر بن عبد الله فأكلنا خبزا ولحما ثم صلى بنا رسول الله صلى الله عليه وسلم فصلينا معه وما مس أحد منا وضوءا ، وانصرفت مع أبي بكر في ولايته من المغرب ، فابتغى عشاء فقيل : ليس ههنا إلا هذه الشاة وقد(@)(@@) PageV09P220 ولدت فحلبها ، ثم طبخ لنا لباء ( لباء : هو أول ما يحلب عند الولادة النهاية ( 4 / 221 ) ب ) فأكل وأكلنا معه ثم قال : كيف قال رسول الله صلى الله عليه وسلم إذا جاء مال أعطيتك هكذا وهكذا وهكذا ؛ فلما جاءه أعطاني ثلاث حفنات ، ثم خرج إلى المسجد فصلى بالناس وما مس من ماء وما مسسته وكان عمر بن الخطاب ربما جفن لنا في ولايته 
ms3600	 فأكلنا الخبز واللحم فيخرج فيصلي ونصلي معه وما يمس أحد منا وضوءا وقال الزهري : وأنا أحدثكم أيضا إن كنتم تريدونه ، حدثني علي ابن عبد الله بن عباس أن ابن عباس أخبره أن رسول الله صلى الله عليه وسلم أكل عضوا فصلى ولم يتوضأ وحدثني جعفر بن عمرو بن أمية الضمري عن أبيه أنه رأى رسول الله صلى الله عليه وسلم أكل عضوا فصلى ولم يتوضأ فقلنا وما بعد هذا فقال إنه يكون أمر فيكون بعده الأمر .(@)(@@) % ( ص ) .(@)(@@) 27165 - عن جابر قال : بينا نحن عند رسول الله صلى الله عليه وسلم إذ جاء رسول من عند امرأة من الأنصار فقال إن فلانة تدعوك ، فقام رسول الله صلى الله عليه وسلم وقمنا معه حتى انتهينا فبسطت لنا في صورة وهو النخل الملتف فأتت بشاة مشوية وذلك قبيل الظهر ، فأكل رسول الله صلى الله عليه وسلم وأكلنا معه ، ثم قام رسول الله صلى الله عليه وسلم فتوضأ وصلى الظهر ، ثم إنها بعثت فقالت : يا رسول ألا أبعث لك ببقية أو بفضلة بقيت من الشاة ؟ قال : بلى فأتي به فأكل رسول الله صلى الله عليه وسلم وأكلنا معه ، ثم قام فصلى ولم يتوضأ .(@)(@@) % ( ص ) .(@)(@@) 27166 - { من مسند حمزة بن عمرو الأسلمي } أكل رسول الله صلى الله عليه وسلم أثوار أقط ( أثوار أقط : الأثوار جمع ثور ، وهي قطعة من الأقط وهو لبن جامد مستحجر النهاية 1 / 228 . ب ) فتوضأ منه .(@)(@@) % ( طب ) .(@)(@@) 27167 - عن أبي طلحة عن المغيرة أن النبي صلى الله عليه وسلم أكل أثوار أقط فتوضأ منه .(@)(@@) % ( طب ) .(@)(@@) 27168 - عن أبي طلحة عن المغيرة أن النبي صلى الله عليه وسلم أكل طعاما ، ثم أقيمت الصلاة وقد كان توضأ قبل ذلك فأتيته بماء ليتوضأ فانتهرني وقال : وراءك فساءني والله ذلك ، ثم صلى فشكوت ذلك إلى عمر بن الخطاب فقال : يا رسول الله إن المغيرة قد شق عليه انتهارك إياه حتى أن يكون في نفسك عليه شيء فقال : ليس في نفسي عليه إلا خيرا ولكنه أتاني 