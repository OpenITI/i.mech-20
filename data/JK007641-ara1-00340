ms321	 ثابت ليس يفنى دوم % % PageV01P1448 البحر : - 1(@)(@@) % طلع امبدر في دياجي امظلام % % فأنار امقلوب بامإسلام % % 2(@)(@@) % كامل امخلق في امخليقة إني % % في امهوى عنده أسير امغرام % % 3(@)(@@) % هذه بهجة امجمال امإلهي % % لاح في امصورة التي في امأنام % % 4(@)(@@) % نتفداه في امشهود لدينا % % بجميع امأرواح وامأجسام % % 5(@)(@@) % سيد امرسل جاء بامحق حتى % % أبصر امخلق بعد طول امتعامي % % 6(@)(@@) % أفلج امثغر أكحل امعين منه % % في امبريات نور بدر امتمام % % 7(@)(@@) % أذهب امكفر بامهداية فينا % % وبه امنور لاح بعد امظلام % % 8(@)(@@) % وعليه امصلاة في كل وقت % % من عبيد امغني له بامسلام % % 9(@)(@@) % وعلى امآل وامصحاب جميعا % % ما تغنى امهزار بامأنغام % % 10(@)(@@) % أو سرى امبرق من نواحي حماه % % أو زها امزهر وهو في امأكمام % % PageV01P1449 البحر : - 1(@)(@@) % تب إلى الله من علوم الكلام % % وتطهروا دخل إلى الإسلام % % 2(@)(@@) % سلم الدين للكلام الذي قد % % أنزل الله فهو خير كلام % % 3(@)(@@) % هو قرآننا المبين فأمن % % بالذي جاء فيه باستسلام % % 4(@)(@@) % واطلب الفهم من إلهك فيه % % فعليه البيان للإفهام % % 5(@)(@@) % واعرف السنة التي ثبتت عن % % سيد المرسلين خير الأنام % % 6(@)(@@) % وتأمل ما قال ربك فيها % % تجد الحق والصواب النامي % % 7(@)(@@) % وإذا لم تفهم فكن مؤمنا لا % % مستربيا بعقلك المستهام % % 8(@)(@@) % واجعل الصبر منك زاد إلى أن % % يفتح الله فيه بالأنعام % % 9(@)(@@) % وإذا لم يفتح فحسبك منه % % إنك المؤمن الجليل المقام % % 10(@)(@@) % واحترز من آراء أهل عقول % % تبعوا ما يقول أهل التعامي % % PageV01P1450 11(@)(@@) % إن علم الكلام محض كلام % % في بيان الأعراض والأجسام % % 12(@)(@@) % هو جرح للدين ما فيه أمر % % ظاهر للعيان غير الأسامي % % 13(@)(@@) % نظر العقل فوقه نظر الشر % % ع وفيه انخرام ذاك النظام % % 14(@)(@@) % أين نور الإيمان من نور عقل % % ناظر بالخيال في الأحكام % % 15(@)(@@) % إن أهل الإيمان في نور غيب % % وذووا العقل كلهم في ظلام % % 16(@)(@@) % تتراءى العقول شيئا بعيدا % % لاح بين الإيجاد والإعدام % % 17(@)(@@) % بدليل يستنبطون هداه % % وهو وهم إلى الردى مترامي % % 18(@)(@@) % فإذا جاءهم دليل نفاه % % ورمته الفهوم في الإيهام % % 19(@)(@@) % بخلاف الإيمان بالغيب فطعا % % فهو 
ms322	 يهدي إلى الهدى بالتمام % % 20(@)(@@) % قلد الله يا ابن قومي وقلد % % رسل الله أصدق الأقوام % % PageV01P1451 21(@)(@@) % إن تكن مؤمنا بربك أسلم % % لعلوم المهيمن العلام % % 22(@)(@@) % لا تظن الدليل يهدي إليه % % أو يرى موقظا عيون النيام % % 23(@)(@@) % هو للعقل سلم للمعاني % % تترقى به إلى الاسقام % % 24(@)(@@) % كن بإيمانك المقلد واقنع % % فيه بالله والنبي التهامي % % 25(@)(@@) % لا تفارق تقليد شرعك محضا % % خالصا عن شوائب الانبهام % % 26(@)(@@) % كيف تدري العقول معرفة الله وإدراكها على أقسام % % الله وإدراكها على أقسام % % 27(@)(@@) % عقلك الخلق عابد منك خلقا % % لك يبديه فتنة للعوام % % 28(@)(@@) % لمتى أنت هكذا في غرور % % ها هو الموت مسرع الأقدام % % 29(@)(@@) % فنحفظ من حكم عقلك فيما % % لست تدري من الأمور العظام % % 30(@)(@@) % لا تخض بالعقول في ذاك واقعد % % مؤمنا مذعنا ليل المرام % % PageV01P1452 31(@)(@@) % ربما النور نور إيمان غيب % % يكشف الخلق فيك بالإلهام % % 32(@)(@@) % فترى ما ورا العقول وتدري % % ما الذي كنت عنه أسر المنام % % 33(@)(@@) % هذه وهذه شريعة طه % % خاتم الأنبياء خير ختام % % 34(@)(@@) % صلوات من الإله عليه % % كل وقت مقرونة بسلام % % 35(@)(@@) % ما سرت نسمة ومالت غصون % % تتثنى على غناء الحمام % % PageV01P1453 البحر : - 1(@)(@@) % هذا الحبيب الذي بالقهر غيرهم % % وبالعمل بخلاف الشرع عيرهم % % 2(@)(@@) % حكم عليهم وبالأعمال خيرهم % % والكل فانون حتى فيه حبرهم % % PageV01P1454 البحر : - 1(@)(@@) % بنى الكل ثم لهم قد هدم % % وجود له صور من عدم % % 2(@)(@@) % تجلى فلا شيء غير الذي % % أحاط به علمه من قدم % % 3(@)(@@) % وذاك تقاديره الفانيات % % فمنها ملوك ومنها خدم % % 4(@)(@@) % أحاطته حسبوها لهم % % وجودا وهم أسر لحم ودم % % 5(@)(@@) % فلو عرفوا ما بهم من فنا % % لفازوا وكان ثبوت القدم % % 6(@)(@@) % ولكنهم جهلوا أنفسا % % لهم فانيات فحل الندم % % 7(@)(@@) % وبالموت يدرون أحوالهم % % ويدرون ما قد بنوه انهدم % % 8(@)(@@) % وينكشف الأمر إن الذي % % بنوه الوجود لهم وانعدم % % 9(@)(@@) % وعادوا كما ابتدئوا أولا % % مع الله لاشيء هم وانختم % % PageV01P1455 البحر : - 1(@)(@@) % أمامنا هو الإمام الأعظم % % أبو حنيفة الفتى المقدم % % 2(@)(@@) % نمشي به في حضرة ظاهرة % % نحن بها لغيرنا المعلم % % 3(@)(@@) % وشيخنا 
ms323	 الشيخ الهمام الأكبر % % في باطن الأمر الذي لا يفهم % % 4(@)(@@) % فاصبر علينا لنريك ما نرى % % وانظر إلى النور بدا يا مظلم % % 5(@)(@@) % هذا صراط الله مثل شعرة % % دقيقة وأنت غر أبلم % % 6(@)(@@) % يديرك الوسواس كيفما جرى % % عدل من الله وأنت تظلم % % 7(@)(@@) % نحن الذين عقلنا من تحتنا % % وعلمنا من الإله نعلم % % 8(@)(@@) % وأنت عقلك الذي عشت به % % فوقك مسدول عليك مغرم % % 9(@)(@@) % والعقل نور الله لكن هو في % % ظلمة طبع فيك منك يحكم % % 10(@)(@@) % بمقتضى ما قدر الله به % % عليك فاتق الإله تسلم % % PageV01P1456 11(@)(@@) % وكن بشرع الله عاملا ولا % % تعرض عن الشرع ودع ما يحرم % % 12(@)(@@) % أنا الذي أدعو إلى الشرع كما % % أدعو إلى حقيقة الشرع اعلموا % % PageV01P1457 البحر : - 1(@)(@@) % كلمات حروفها الأجسام % % والمعاني أرواحهن القيام % % 2(@)(@@) % صادرات عن الإله تعالى % % يتبدى بها الضيا والظلام % % 3(@)(@@) % وهو الله لا سواه أتانا % % بل أتاه منه إليه الكلام % % 4(@)(@@) % أين أنتم يا غافلون فأنتم % % أحرف قاذفاتها الأقلام % % 5(@)(@@) % لا معاني لها حروف هجاء % % يترجى تعليمهن الغلام % % 6(@)(@@) % فتنتكم ظواهر الكون حتى % % غاب عنكم معناه وهو المرام % % 7(@)(@@) % فاستقيموا بربكم في هداه % % ذلك الحق تعرفوا والسلام % % PageV01P1458 البحر : - 1(@)(@@) % أحرف في سكونها الإعدام % % ولها في جود إدغام % % 2(@)(@@) % في وجود الحق الذي لا سواه % % فعليه به ومنه السلام % % 3(@)(@@) % إن ادغام أحرف الكون فيه % % لسكون بها هو الأنعام % % 4(@)(@@) % فإذا ما تحركت فك عنها % % فاستقلت وفاتها الإدغام % % 5(@)(@@) % ولهذا يقول ربي له ما % % سكن الليل والنهار دوام % % 6(@)(@@) % فهي لولا السكون ما كان ادغا % % م لها فيه أو عليها قيام % % 7(@)(@@) % أحرف الكائنات عن نفس الحق % % ق اختلاف لها به وانقسام % % 8(@)(@@) % فإذا ما تركبت كلمات % % هي تتلى وجمعهن كلام % % 9(@)(@@) % قوله الحق فاستمع يا ابن ودي % % والسوى باطل هو الأوهام % % 10(@)(@@) % جل رب به البرية قاموا % % لا بعلم والعالمون استقاموا % % PageV01P1459 البحر : - 1(@)(@@) % وجودكم تتنموا إنه دائم % % لكم تحبونه كل به هائم % % 2(@)(@@) % وكل واحد مقدر في العدم حائم % % لم يدران وجوده به القائم % % PageV01P1460 البحر 
ms324	 : - 1(@)(@@) % عيسى ابن مريم روحي % % لقتل دجال جسمي % % 2(@)(@@) % فإن يمت بي قتيلا % % أكن أنا الروح باسمي % % 3(@)(@@) % والجسم من قبل ميت % % لكنه حي رسم % % 4(@)(@@) % كذلك الروح ميت % % والحي حظي وقسمي % % 5(@)(@@) % يا حق يا حي إني % % ظهرت عنك بوسمي % % 6(@)(@@) % فاحسم عن الغير قلبي % % بالعين أبلغ حسم % % 7(@)(@@) % الكنز أنت وكل % % عليك شكل طلسم % % PageV01P1461 البحر : - 1(@)(@@) % أنا الوجود كما أني أنا العدم % % على الصراط وما زلت بي القدم % % 2(@)(@@) % أكون طورا وجود إن ظهرت به % % وتارة عدما يخفى وينكتم % % 3(@)(@@) % والغيب غيب على ما كان في أزل % % ولا سواه ولا شيء سواه هم % % 4(@)(@@) % هذاه ما هو هذا ما هو استمعوا % % والعرب والعجم لا عرب ولا عجم % % 5(@)(@@) % والكل فإن كما قال الإله لنا % % والكل ليس بفان هذه نعم % % 6(@)(@@) % قل اعملوا قال ربي ثم قال لهم % % لا يقدرون على شيء وإن زعموا % % 7(@)(@@) % فحقق الأمر والخلق اللذين هما % % لله وافهم هي الأنوار والظلم % % 8(@)(@@) % واقرأ كتابك ما جاء النبي به % % إليك وهو كتاب الله يا فهم % % 9(@)(@@) % واعلم بأن لك الشرع القويم هدى % % لا زيغ فيه وإن زاغت به أمم % % 10(@)(@@) % واترك هدى العقل لا تحفل بعقلتهواسأل من الله فتحا في شريعته في نص قرآنه تبدو لك الحكم % واتبع هدى الله فهو الحاكم الحكمسقط بيت ص % % PageV01P1462 11(@)(@@) % فعلمنا كله ضدان ما اجتمعا % % على خلاف الذي في العقل منبهم % % 12(@)(@@) % ضدان ضدان أمر الله أجمعه % % حكم قديم به أهل النهى حكموا % % PageV01P1463 البحر : - 1(@)(@@) % يا حادي الركب سر بي % % نحو المقام المعظم % % 2(@)(@@) % وانشد هنالك قلبي % % بين الحطيم وزمزم % % PageV01P1464 البحر : - 1(@)(@@) % موجود معدوم لا موجود لا معدوم % % عبد كثير الخطا في حضرة القيوم % % 2(@)(@@) % عالم غدا ماله علم ولا معلوم % % لا فعل بل فعله الممدوح والمذموم % % PageV01P1465 البحر : - 1(@)(@@) % أهل المحبة في السرور الدائم % % لا يحزنون ولا بلوم اللائم % % 2(@)(@@) % هم كذاه في هذه الدنيا كما % % هم هكذا في يوم يقظة نائم % % 3(@)(@@) % لهم الملاح مظاهر الغيب الذي % % هو ظاهر 
ms325	 بجمال وجه دائم % % 4(@)(@@) % يتنعمون به هنا وهناك لا % % يخفى عليهم بالمليح القائم % % 5(@)(@@) % أرواحهم كالشمس في أفق السما % % وجسومهم شفاقة كغمائم % % 6(@)(@@) % هم أهل كشف يفرحون بربهم % % في كل صورة أهيف متلائم % % 7(@)(@@) % لهم الجمال محقق بمحاسن % % تبدو الملاح بها كزهر كمائم % % 8(@)(@@) % ولغيرهم معنى الجلال مظاهر ال % % شهوات تعشقها نفوس بهائم % % 9(@)(@@) % في هذه الدنيا بذاك تنعموا % % وكذاك في الأخرى كطير حائم % % 10(@)(@@) % نفس لهم لا روح تعلمهم بمن % % هو نافخ فيهم لنيل غنائم % % PageV01P1466 11(@)(@@) % لا يعرفون الحظ غير بطونهم % % وفروجهم شوقا بكل ملائم % % 12(@)(@@) % ولذاك قال الله فيها كل ما % % هم يشتهون يحثهم بعزائم % % 13(@)(@@) % أهل الحجاب لهم نعيم جسومهم % % وعذابهم أن قابلوا بجرائم % % 14(@)(@@) % ونعيم أهل الكشف رؤية طلعة ال % % محبوب بالوجه الجميل الدائم % % 15(@)(@@) % هو حظهم في النشأتين من الذي % % عشقوه بالقلب الطهور الصائم % % 16(@)(@@) % إذ لا نعيم سوى نعيم شهوده % % يوم اللقا بلطائف وكرائم % % 17(@)(@@) % هو ظاهر لعيونهم وقلوبهم % % بمباسم لعس ولين قوائم % % 18(@)(@@) % من كل وضاح الجبين كأنه % % بدر التمام محوط بتمائم % % 19(@)(@@) % يختال كالغصن الرطيب بقامة % % لقلوبهم فيها غناء حمائم % % 20(@)(@@) % كالبرق يلمع عن وجود حقيقة % % نفحاتها فاحت بطيب نسائم % % PageV01P1467 البحر : - 1(@)(@@) % قالوا غدا نأتي ديار الحمى % % ديار من هم أهل سلمى همو % % 2(@)(@@) % فينظر القلب إليهم بهم % % وينزل الركب بمغناهمو % % 3(@)(@@) % وكل من كان مطيعا لهم % % وكان مشغوفا بذكراهمو % % 4(@)(@@) % فإنه إن جاءهم خائفا % % أصبح مسرورا بلقياهمو % % 5(@)(@@) % قلت فلي ذنب فما حيلتي % % أخشى بأن يطردني عنهمو % % 6(@)(@@) % عندي الحيا منهم ولي خجلة % % بأي وجه أتلقاهمو % % 7(@)(@@) % قالوا أليس العفو من شأنهم % % وكم نجا عبد رجا منهمو % % 8(@)(@@) % والصفح من أخلاقهم دائما % % لاسيما ممن ترجاهمو % % PageV01P1468 البحر : - 1(@)(@@) % نظرت إلى وجه الذي الكل هالك % % سوى وجهه والوجه ماهو مبهم % % 2(@)(@@) % فظنوا بأني ناظر في وجوههم % % عيون لهم عما أشاهده عموا % % 3(@)(@@) % اأترك وجها بالمحاسن مشرقا % % وأنظر وجها حشوه القيح والدم % % 4(@)(@@) % ومن يفتري يوما علينا بظنه % % بنا السوء ذاك الظن منه المحرم 
ms326	 % % 5(@)(@@) % ويجزيه عنا ربه سوء حالة % % هنا وله يوم الحساب جهنم % % 6(@)(@@) % ولا زال مطرودا عن الله دائما % % ويمنع عما نحن فيه ويحرم % % PageV01P1469 البحر : - 1(@)(@@) % إن هذا الأحد الديموم % % وهو بسم الله لي محزوم % % 2(@)(@@) % هكذا الله وجود واحد % % خالص محض ولا مفهوم % % 3(@)(@@) % وجميع الخلق أفعال له % % وهي شيء كله معدوم % % 4(@)(@@) % واعرفوه كل شيء هالك % % جاء إلا وجهه المعلوم % % 5(@)(@@) % وهو في أفعاله أجمعها % % ظاهر حي هو القيوم % % 6(@)(@@) % فافهموا يا قوم ما قلت لكم % % فسوى قولي هو الموهوم % % 7(@)(@@) % والوجود الحق أنتم كلكم % % وهو أمر عندنا مكتوم % % 8(@)(@@) % وهو موقوف على ذوق الفنا % % فيه فافنوا وعليه دوموا % % 9(@)(@@) % وأخرجوا لله عن أفعاله % % وهي أنتم وإليه قوموا % % 10(@)(@@) % وبه فاتحدوا لا تنظروا % % لسواه فالسوى مذموم % % PageV01P1470 11(@)(@@) % لمتى الشرك الخفي يبقى إلى % % موتكم لا كان هذا الشوم % % 12(@)(@@) % إنما الشرك ضلال كله % % فاتركوه إنه مسموم % % 13(@)(@@) % جل رب معنا إذ نحن لا % % نحن وهو الراحم المرحوم % % 14(@)(@@) % أهل تقوى أهل قل مغفرة % % وهو القول لنا المرقوم % % 15(@)(@@) % والذي أول هذا جاحد % % قول حق وهو المحروم % % 16(@)(@@) % عقله سول في الغي له % % ماله شم هو المزكوم % % 17(@)(@@) % ولنا طوبى زهت والمنتهى % % ولأرباب الحجي الزقوم % % 18(@)(@@) % شجرات هن في الذكر أتت % % ضاق عنها الحلق والحلقوم % % 19(@)(@@) % فانيات كلها في أمرنا % % أين منهم عجم والروم % % 20(@)(@@) % كلهم في أسر عقل ربطوا % % يا طيورا حول ماء حوموا % % PageV01P1471 البحر : - 1(@)(@@) % لنا غرق لكنا في القدم % % ببحر الوجود وبحر العدم % % 2(@)(@@) % فيحكم هذا على بعضنا % % وهذا على بعضنا قد حكم % % 3(@)(@@) % وسبح في النور منا الفتى % % ويسبح جاهلنا في الظلم % % 4(@)(@@) % وبحر إن عندي هما يجريان % % فبحر بلحم وبحر بدم % % 5(@)(@@) % وبينهما برزخ ظاهر % % فلا يبغيان لأمر أتم % % 6(@)(@@) % وبرزخه عالم الجبروت % % خيال له الغي والعقل هم % 7(@)(@@) % فكن رجلا عارفا لا تكن % % جهولا وربك عنك انبهم % % 8(@)(@@) % وتعبد طيف الخيال الذي % % ترى في المنام أفق لا تنم % % 9(@)(@@) % فهذا الوجود وأفعاله % % هي العدم المحض 
ms327	 لا غير ثم % 10(@)(@@) % وحاصله أنه لا سوى % % وبعض خلاف لبعض وتم % % PageV01P1472 البحر : - 1(@)(@@) % كلنا بالتخصيص والتعميم % % نفخ روح من أمر رب قديم % % 2(@)(@@) % منه يبدو بنا الوجود ويخفى % % لمع برق كلمح طرف قويم % % 3(@)(@@) % مدة العمر هكذا نحن قوم % % لم نزل في الخلق الجديد العديم % % 4(@)(@@) % نحن جسم وذلك النفخ فيه % % فعل رب بنا رؤوف رحيم % % 5(@)(@@) % فإذا الجسم زال بالموت يبقى % % ذلك النفخ دون جسم رميم % % 6(@)(@@) % وله منه صورة تتجلى % % أشبهته في شكل ذاك الأديم % % 7(@)(@@) % ثم إن قامت القيامة قامت % % نشئات الجسوم بالتقويم % % 8(@)(@@) % لنعيم مؤبد ليس يفنى % % أو عذاب مسرمد في الحميم % % 9(@)(@@) % نحن قوم يا ابن الفوارس صعب % % أمرنا بين مقعد ومقيم % % 10(@)(@@) % نعشق الأوجه الحسان فنفنى % % في تجلي جمال كل وسيم % % PageV01P1473 11(@)(@@) % قذفتنا نواظر العشق لما % % إن رأونا أسرى لواحظ ريم % % 12(@)(@@) % أم رأوا قبلنا الملبى يحج % % طاف بالبيت من وراء الحطيم % % 13(@)(@@) % كلما رؤية الحبيب أردنا % % جاءنا الصعق مثل موسى الكليم % % 14(@)(@@) % فعسى أن يعيرنا منه عينا % % لنراه بها على التكريم % % 15(@)(@@) % فيكون الرائي الذي هو مرئى % % يا عظيما يرجى لكل عظيم % % PageV01P1474 البحر : - 1(@)(@@) % قد ظهر مني وجودي % % وهو في الغيب القديم % % 2(@)(@@) % وتجلى في شهودي % % فأنا العلم العليم % % 3(@)(@@) % وهو ربي وهو حسبي % % ملئ قلي فتحقق يا نديم % % 4(@)(@@) % دور % % 5(@)(@@) % قام يختال بقامه % % كقضيب الخيزران % % 6(@)(@@) % وجهه راخي لثامه % % منه لو نلت الأمان % % 7(@)(@@) % يا رفيقيضاق زيفي % % واحريقيفي هوى الوجه الوسيم % % 8(@)(@@) % دور % % 9(@)(@@) % راح يزهو في غلائل % % وهو عن ذاك منزه % % 10(@)(@@) % أهيف حلو الشمائل % % فيه قلبي يتنزه % % PageV01P1475 11(@)(@@) % وجه باهيطلق زاهي % % عنه ساهيعاذلي ذاك اللئيم % % 12(@)(@@) % دور % % 13(@)(@@) % سبح اسم الله يا من % % قد رأى حسن المليح % % 14(@)(@@) % والذي بالله آمن % % يعشق الوجه الصبيح % % 15(@)(@@) % لا تماريصنع باري % % حكم جاريفي الصراط المستقيم % % 16(@)(@@) % دور % % 17(@)(@@) % صل يا ربي وسلم % % لي على طه الرسول % % 18(@)(@@) % وهو للخير معلم % % وهو مفتاح الوصول % % 19(@)(@@) % وهو ساقيخمر باقي % % فيه راقيللغني عبد سقيم 
ms328	 % % PageV01P1476 البحر : - 1(@)(@@) % هو صبغة العدم الذي هو كلنا % % طورا وطورا نحن صبغته افهموا % % 2(@)(@@) % فإذا رأيناه لنا هو صابغ % % هو باطن ولنا الظهور المبهم % % 3(@)(@@) % وإذا صبغناه يكون ولم تكن % % فتحققوا يا قوم هذا واعلموا % % 4(@)(@@) % هو واحد وهو الوجود وغيره % % عدم كثير ليس يحصى مظلم % % PageV01P1477 البحر : - 1(@)(@@) % لله في الكون تحريك وتسكين % % قل لي فما تفعل القوم المجانين % % 2(@)(@@) % وكل أفعالنا لا شك حادثة % % فافطن فهل لسوى الرحمن تكوين % % 3(@)(@@) % لا النار تحرق إلا عند محتجب % % أعمى ولا تقطع الجرم السكاكين % % 4(@)(@@) % وإنما هي أسباب مرتبة % % عندي لفاعلها المحتار تعيين % % 5(@)(@@) % يا راقد الليل قم فجر النجاة بدا % % ما راح حين ووافى مثله جين % % 6(@)(@@) % بك احتجبت فلا تنظر إليك تفز % % واخرج عن الكل تأتيك البراهين % % 7(@)(@@) % وانحل شيئا فشيئا في الوجود وذب % % حتى توافى مقاما فيه تمكين % % 8(@)(@@) % فكلهم هو فاسمع وهو غيرهمو % % ان الزجاج له بالشمس تلوين % % 9(@)(@@) % واحرص على الأمر والنهي اللذين هما % % نتيجة الخلق يا ماء ويا طين % % 10(@)(@@) % الله سر خفي ليس يدركه % % إلا اللبيب الذي فينا له دين % % PageV01P1478 البحر : - 1(@)(@@) % ليت لو كنت إذا قلت أنا % % أملك الروح وأحوى البدنا % % 2(@)(@@) % إنما هذا حبيبي حاضر % % وأنا يا ليت شعري من أنا % % 3(@)(@@) % قام ناسوتي بمن أوجده % % حيث لاهوتي إلى الباري دنا % % 4(@)(@@) % يا أولي الألباب هل من أحد % % منصفي قد ضاعت النفس هنا % % 5(@)(@@) % هل أنا الناسوت في ثقلته % % هل أنا اللاهوت حيث اكتمنا % % 6(@)(@@) % أم أنا وهم ولما ظهر ال % % حق ولى باطلي وانطحنا % % 7(@)(@@) % ليست الأكوان الأعرضا % % مالها عمن به قامت غنى % % 8(@)(@@) % أو هي الظل فسل عن شاخص % % هو منا دائما أولى بنا % % 9(@)(@@) % وأنا اليوم لقد قمت به % % أندب الربع وأبكي الدمنا % % 10(@)(@@) % بحجاب النفس قومي حجبوا % % ويحهم كم يدعون الفطنا % % PageV01P1479 11(@)(@@) % غرهم علم رسوم قنعوا % % منه بالقشر فظنوه المنى % % 12(@)(@@) % وإذا ما جهلوا أنفسهم % % أي شيء عرفهوه ههنا % % 13(@)(@@) % يعبدون الله خوفا من لطى % % فلظى قد عبدوا لا 
ms329	 ربنا % % 14(@)(@@) % ولدار الخلد صلوا لاله % % مثل قوم يعبدون الوثنا % % 15(@)(@@) % أنا مفتون بمحبوب به % % كل من قد كان قبلي فتنا % % 16(@)(@@) % ليس في غرب ولا في مشرق % % إنه في بيت قلبي سكنا % % 17(@)(@@) % أينما وليت ألقى وجهه % % ظاهرا أفديه وجها حسنا % % 18(@)(@@) % ولكم صمت وصليت له % % بل به حتى محوت الزمنا % % 19(@)(@@) % ومقام القرب كم طفت به % % ومني فيها لقد نلت مني % % 20(@)(@@) % وإذا شئت به تحيى فمت % % والبقا إن رمته سر الفنا % % PageV01P1480 البحر : - 1(@)(@@) % إني أنا لست أنا % % فليت شعري من أنا % % 2(@)(@@) % صورة لاهوت بدت % % في شكل ناسوت دنا % % 3(@)(@@) % كلاهما مستحدث % % من عدم ومن فنا % % 4(@)(@@) % وذاك لا ذاك له % % ومن هنا ليس هنا % % 5(@)(@@) % والقصد مني لم يقع % % على سؤالي والمنى % % 6(@)(@@) % فافهم كلامي وانتفع % % به ودع عنك العنا % % 7(@)(@@) % اياك اياك بأن % % يوقعك الجهل بنا % % 8(@)(@@) % ولا تكن معتديا % % ولا تكن مفتتنا % % 9(@)(@@) % ودع كلام عصبة % % بنا أسؤوا الظننا % % 10(@)(@@) % من شر هم ما أحد % % بين البرايا أمنا % % PageV01P1481 11(@)(@@) % قد شبهوا خالقهم % % وجسموه علنا % % 12(@)(@@) % ونسبوا إليه ما % % كان بهم مكتمنا % % 13(@)(@@) % وهم على ذا درجوا % % وفيه عاشوا بالهنا % % 14(@)(@@) % وعبدوه مثل قو % % م يعبدون الوثنا % % 15(@)(@@) % قد نشأوا في بدع % % لا يعوفون السننا % % 16(@)(@@) % وهذه حالتهم % % قد جعلوها ديدنا % % 17(@)(@@) % فاحذر تكن مستمعا % % لهم بهم ممتحنا % % 18(@)(@@) % وخذ بما لاح ودع % % عنك التباسا فتنا % % 19(@)(@@) % بالله يا من هجروا % % وعظموني شجنا % % 20(@)(@@) % وقد أطالوا سهري % % وأحرموني الوسنا % % PageV01P1482 21(@)(@@) % وملء قلبي شغف % % ودمع عيني هتنا % % 22(@)(@@) % ولي إليهم ابدا % % فرط غرام وعنا % % 23(@)(@@) % رفقا بصب دنف % % بكم غدا مرتهنا % % 24(@)(@@) % إيان ولي منكمو % % ابصر وجها حسنا % % 25(@)(@@) % بشعب وادي سلم % % جآ ذر لحن لنا % % 26(@)(@@) % لما رنوا وانعطفوا % % خلت سيوفا وقنا % % 27(@)(@@) % أواه من جفوتهم % % وليس لي عنهم غنى % % 28(@)(@@) % يا ليتهم لو سمحوا % % ولي أتموا المننا % % 29(@)(@@) % عهدي بهم قد نزلوا % % بالسفح من وادي منى % % 30(@)(@@) % من كل روح جعلوا % % للأمر منهم بدنا 
ms330	 % % PageV01P1483 31(@)(@@) % وشرفوا منازلا % % حلوا بها ودمنا % % 32(@)(@@) % وكل حي جعلوا % % بالوصف فيه وطنا % % 33(@)(@@) % وشغلوا الكون بهم % % وهيجوه شجنا % % 34(@)(@@) % فهام في بهجتهم % % ولم ينل منهم مني % % 35(@)(@@) % يخفق قلبه بهم % % وكم يقاسي محنا % % 36(@)(@@) % وجوده تحريكه % % وفقده إن سكنا % % PageV01P1484 البحر : - 1(@)(@@) % بالله اي من رماني بالصد والهجران % % جسد بالوصال فإني متيم ولهان % % 2(@)(@@) % وليس عندي صبر عن اللقايا يا حبيبي % % والقلب في كل وقت يذوب بالأشجان % % 3(@)(@@) % خاطب بروق الروابي تكف عني وميضا % % فإنها خطفتني بذلك اللمعان % % 4(@)(@@) % وقل لنسمة ذاك الحمى تجود علينا % % بطيب ورد وإلا بنفحة الريحان % % 5(@)(@@) % يا من تنكر حتى عداه قد جهلوه % % وعن محبيه لم يخف كيفما قد كان % % 6(@)(@@) % ظهرت في كل شيء والشيء غيرك عندي % % وأنت أنت يقينا وكل شيئ فان % % 7(@)(@@) % إن قلت أنك إني جهلت ذاتك اذلا % % وجود مع نور حق لظلمة الأكوان % % 8(@)(@@) % وإن أقل أنت غيري فقد زعمت شريكا % % لأن ذاتك تأبى يكون معها ثان % % 9(@)(@@) % وكيف والحق حق وما سواه محال % % وأين محض كمال من خالص النقصان % % 10(@)(@@) % هذا الوجود خيال وكلنا في منام % % وليس يوجد إلا حقيقة الإنسان % % PageV01P1485 11(@)(@@) % فاكشف قناع التعامي عن وجه قلبك وانظر % % تجد حبيبك أدنى إليك منك الآن % % 12(@)(@@) % واحذر تشبه بشيء ما قد وصلت إليه % % ونزه العقل عما للعقل منه بان % % 13(@)(@@) % وخذ كؤوس التصابي واخدم لأرباب صدق % % وقف بحضرة جودي وادخل معي للحان % % 14(@)(@@) % واهجر عصابة جهل مرادهم لك سوء % % وسواسهم منه فاحذر في سائر الأزمان % % 15(@)(@@) % يزخرفون كلاما يحذرونك من أن % % تروم معرفة الله فكل ذا بهتان % % 16(@)(@@) % وهل لنفسك قل لي على إلهك فضل % % حتى تخاف عليها وتأمن الرحمن % % 17(@)(@@) % يا بارق الغور فرف فقد خطفت فؤادي % % وفي الأضالع رعد ومدمعي هتان % % 18(@)(@@) % والجسم زاد نحولا من القلى والتنائي % % والصبر قد زال عني في مدة الهجران % % 19(@)(@@) % يا سائق الظعن رفقا فإن قلبي عليل % % راكب جواد التصابي سائر مع الركبان % % 20(@)(@@) % بالله إن جئت تجدا ورامة والمصلى % % فاقرأ 
ms331	 سلامي عليهم وقل هنا ولهان % % PageV01P1486 البحر : - 1(@)(@@) % كلامنا نعرفه % % نحن ومن يعرفنا % % 2(@)(@@) % وإنما يفهمه % % في الناس من يفهمنا % % 3(@)(@@) % ولم يكن يجهله % % إلا الذي يجهلنا % % 4(@)(@@) % ومن يرده فليكن % % ملازما مجلسنا % % 5(@)(@@) % أو مجلسا لكل من % % تلمذة الصدق لنا % % 6(@)(@@) % وقلبه معتقد % % ويحسن الظن بنا % % 7(@)(@@) % ويسمع التقرير عن % % كلامنا من فمنا % % 8(@)(@@) % ولا يقلد جاهلا % بالحق فيما طعنا % % 9(@)(@@) % فالناس فيهم حسد % % وسوء ظن كمنا % % 10(@)(@@) % والجهل بالله لهم % % قد صار شيئا حسنا % % PageV01P1487 11(@)(@@) % وكل شخص يدعى % % ما ليس فيه علنا % % 12(@)(@@) % ولا حياء عندهم % % منهم ولا من ربنا % % 13(@)(@@) % وأن يكونوا جهلوا % % فروضهم والسننا % % 14(@)(@@) % فقربهم هو الردى % % وبعدهم هو المنى % % PageV01P1488 البحر : - 1(@)(@@) % نور هذا الوجود بالإيمان % % لا بشمس ولا نجوم دواني % % 2(@)(@@) % وبه الشمس والنجوم جميعا % % مشرقات من رحمة الرحمن % % 3(@)(@@) % ولهذا الكسوف لا يعتريها % % منه إلا عن غفلة وتواني % % 4(@)(@@) % أي قلب من القلوب تجلى % % فيه ربي بغير ما إيمان % % 5(@)(@@) % وعلوم الجميع علوا وسفلا % % وارادت عن وردة كالدهان % % 6(@)(@@) % فلك الماء والتراب مضيء % % بضياء الإيمان في كل آن % % 7(@)(@@) % وبه لم يزل يدور ويبدي % % صورا بابتداعه ومعاني % % 8(@)(@@) % أمن الكل من قلى وبعاد % % عندما آمنوا وهو في تداني % % 9(@)(@@) % ولهم خلعة المهيمن جاءت % % ثم فازوا من سلبها بالأمان % % 10(@)(@@) % فتراهم بها يميلون زهوا % % بين نيل المراد والحرمان % % PageV01P1489 11(@)(@@) % وعلى كل حالة هو أولى % % بالذي جاء منه للأكوان % % 12(@)(@@) % وهو إيمانه بهم فلهذا % % مؤمن جاء عنه في القرآن % % 13(@)(@@) % والمواليد معدن ونبات % % ثم حيوانها مع الإنسان % % 14(@)(@@) % وكذلك الآباء مع أمهات % % كلهم في غد من الحيوان % % 15(@)(@@) % مؤمنات جميعها بإله % % واحد ماله كما قال ثاني % % 16(@)(@@) % ولهذا تأتي غدا شاهدات % % مثل ما جاء في حديث الأذان % % 17(@)(@@) % وشروط الشهادة الآن فيها % % ثبتت بالدليل والبرهان % % 18(@)(@@) % حيث عنها الإله أخبر بالتس % % بيح والنطق والفنا في العيان % % 19(@)(@@) % فتحقق بكل ما قلت وافهم % % تلق لب الكمال والعرفان % % PageV01P1490 البحر : - 1(@)(@@) % كل تحريك تراه وسكون % % فانتقال من حياة لمنون 
ms332	 % % 2(@)(@@) % وجميع الكون إن حققته % % فلأشارات إلى كن فيكون % % 3(@)(@@) % نظرة أعطت وأخرى أخذت % % كل شيء في الورى عال ودون % % 4(@)(@@) % فهي عين وإذا شئت فقل % % أعين سالت لنا منها عيون % % 5(@)(@@) % وهي ذات حذرتنا نفسها % % صعبت فينا وإن شاءت تهون % % 6(@)(@@) % حجبت عنها بها أعيننا % % فظهور من بطون وبطون % % 7(@)(@@) % كل يوم هو في شان وذا % % عجب فاليوم من تلك الشؤون % % 8(@)(@@) % وشؤون هي في شأن بدت % % باختفاء عن سناه وكمون % % 9(@)(@@) % ثم ذاك الشان في شأن إلى % % لا إلى مما تراه العارفون % % 10(@)(@@) % فاجتهد في السير واقرع بابه % % وادخل الحضرة والبيت المصون % % PageV01P1491 11(@)(@@) % لا تظن الباب يا باب سوى % % أنت والبيت سوى أنت يكون % % 12(@)(@@) % وافهم الأمر به يا أمره % % تعرف الأمر مع الكل فنون % % PageV01P1492 البحر : - 1(@)(@@) % أجهلت قدرك أيها الإنسان % % أنت الجميع وبعضك الأكوان % % 2(@)(@@) % والنور والظلمات أنت حقيقة % % وسوى كمالك كله نقصان % % 3(@)(@@) % يكفيك أن الحق سمعك قد غدا % % ويدا ورجلا فيك وهو عيان % % 4(@)(@@) % والكون أجمعه لأجلك خادم % % يسعى وأنت المالك السلطان % % 5(@)(@@) % فإذا انتبهت لبست ثوب سعادة % % وإذا غفلت فثوبك الخسران % % 6(@)(@@) % ولطيفك الجنات أنت منعم % % فيها غدا وكثيفك النيران % % 7(@)(@@) % انزع ثيابك عنك وابق بغيرها % % تعرف مقامك أيها الإنسان % % PageV01P1493 البحر : - 1(@)(@@) % سواكم روى عنكم سوانا روى عنا % % وأعياننا منكم وأعيانكم منا % % 2(@)(@@) % عشقناكمو لما عشقنا نفوسنا % % وكل فتى منا إلى نحوكم حنا % % 3(@)(@@) % وأنتم وجود الكل والكل شخصكم % % وإن كان كل تابعا في الهوى فنا % % 4(@)(@@) % هي الروح دبت في طبيعة جسمها % % وقد أظهرت خوفا وقد أظهرت أمنا % % 5(@)(@@) % وأفنى بما أبقى هواها لها بها % % من الكل بل أبقى هواها بما أفنى % % 6(@)(@@) % وكانت هي المعنى وألفا ظنا لها % % فيا حسن ألفاظ تكون لها معنى % % 7(@)(@@) % قديمة عهد والحدوث حجابها % % غدونا لها ظهرا فصارت لنا بطنا % % 8(@)(@@) % هي الكرم والعنقود والعاصر الذي % % له انتسبت أيضا وبائعها غبنا % % 9(@)(@@) % هي ألحان والكاسات والطاس والطلا % % ودن الحميا والذي صنع الدنا % % 10(@)(@@) % هي القوم والساقي ومجلسنا 
ms333	 على % % يمين الحمى الشرقي والروضة الغنا % % PageV01P1494 11(@)(@@) % فإن شئت فاشربها من الكل أو فخذ % % من البعض كأسا طعمه العذب ما أهنى % % 12(@)(@@) % وإلا تكن في أسر وهمك واقفا % % مع العقل تستدعي السرور والحزنا % % 13(@)(@@) % يقلبك الوسواس في كل ساعة % % وأعماك حتى أصم لك الأذنا % % 14(@)(@@) % سقى الله روضات المقاصد واللقا % % من الكل حيث الكل منها رأوا حسنا % % 15(@)(@@) % ولم تعشق العشاق غير جمالها % % ولكنهم تاهوا بأسمائها الحسنى % % 16(@)(@@) % وليلى ولبنى في البرية قصدهم % % وما قصدهم ليلى ولا قصدهم لبنى % % 17(@)(@@) % ولو لم يكونوا عارفين بها ولو % % لها جحدوا ظلما ولو تبعوا الظنا % % PageV01P1495 البحر : - 1(@)(@@) % أيها القوم السكارى % % بعقار وهو دون % % 2(@)(@@) % خمر أرباب المعاني % % هو أعلى ما يكون % % 3(@)(@@) % فبطون من ظهور % % وظهور من بطون % % 4(@)(@@) % انفقوا الأجسام محقا % % في هوى عين العيون % % 5(@)(@@) % ثم بالأرواح ساروا % % في غرام وشجون % % 6(@)(@@) % ثم عنهم خلعوا ما % % عاقهم دون المنون % % 7(@)(@@) % فاعلموا يا أهل ودي % % إن من عز يهون % % 8(@)(@@) % واسمعوا من قول ربي % % فله نحن الشئون % % 9(@)(@@) % أنفقوا ما قد جمعتم % % من علوم وفنون % % 10(@)(@@) % وذوات وصفات % % وخفوق وسكون % % PageV01P1496 11(@)(@@) % فلقد قال إله الخل % % ق في الذكر المصون % % 12(@)(@@) % لن تنالوا البر حتى % % تنفقوا مما تحبون % % PageV01P1497 البحر : - 1(@)(@@) % من أسخط الناس في مرضاة خالقه % % فذلك الفائز الناجي بلا مين % % 2(@)(@@) % تأتي الأنام بلام في القيامة من % % تقى وهذا الذي يأتي بلا مين % % PageV01P1498 البحر : - 1(@)(@@) % تب إلى الله من ذنوبك يكفيك % % وإن لم تكن من العابدينا % % 2(@)(@@) % وتحقق بأن ذنبك عمن % % هو إياك قد لهاك يقينا % % PageV01P1499 البحر : - 1(@)(@@) % يا مشتغلا بكامل الإيمان % % تسبيحك لم يخرج عن الإمكان % % 2(@)(@@) % فأعبده فقد رضى منك بذا % % العارف قال قبلنا سبحاني % % PageV01P1500 البحر : - 1(@)(@@) % قد بالغ في الظهور والكتمان % % حتى حارت به أولوا العرفان % % 2(@)(@@) % والسر على التحقيق كإلاعلان % % قد أودعه في هذه الأكوان % % PageV01P1501 البحر : - 1(@)(@@) % يا طلعة من أحب في ذا الكون % % تختال علينا بثياب الصون % % 2(@)(@@) % والخال غدا يلوح في وجنته % % قد حير عقلي بسواد 
ms334	 اللون % % PageV01P1502 البحر : - 1(@)(@@) % نحن الذين أين كنا حبنا معنا % % ومالنا في الحقيقة غيره معنى % % 2(@)(@@) % يجود لا حاتما نرجو ولا معنا % % مع ناس بالمنع قائم والعطا معنا % % PageV01P1503 البحر : - 1(@)(@@) % من كان حبه معه هيهات يلقى حزن % % يامن صفاته لانواع التجلي حزن % % 2(@)(@@) % وقل لمن غيد أفكاره علينا جزن % % هذي الفعائل ترى في أي مذهب جزن % % PageV01P1504 البحر : - 1(@)(@@) % أن أقبل السعد وزال العنا % % 2(@)(@@) % وقد سكرنا بكؤوس المنى % % 3(@)(@@) % وموسم الأفراح لي أن دنا % % 4(@)(@@) % يا ربة العود خذي في الغنا % % وحركي من صوته ما وني % % 5(@)(@@) % قم يا نديمي موسم القرب جا % % 6(@)(@@) % وأبدل اليأس لنا بالرجا % % 7(@)(@@) % ولا تخف ظلم ظلام دجا % % 8(@)(@@) % فإن مسود قميص الدجى % % لونه الصبح بما لونا % % 9(@)(@@) % حسن ملاح الكون لي هيما % % 10(@)(@@) % وتوبتي وهبتها اللوما % % PageV01P1505 11(@)(@@) % فرحت مغرى في الهوى مغرما % % 12(@)(@@) % وفاز بالتوبة قوم وما % % تاب من التوبة إلا أنا % % PageV01P1506 البحر : - 1(@)(@@) % إن غبت عن عياني % % فأنت في جناني % % 2(@)(@@) % وإن حجبت فكري % % بكل ما أعاني % % 3(@)(@@) % فالنور نصب عيني % % والذكر في لساني % % PageV01P1507 البحر : - 1(@)(@@) % أنا كعبة كل المعاني % % حجت إلي بلا تواني % % 2(@)(@@) % وكذا الكمالات التي % % أبد سواي لها يعاني % % 3(@)(@@) % كم طاف بي علم وجا % % ء مقبلا حجر اللسان % % 4(@)(@@) % وأتى إلى عرفات قل % % بي واقفا يبغي بياني % % 5(@)(@@) % يا واحدا ما في العيا % % ن له ولا في الغيب ثاني % % 6(@)(@@) % أنا جفناك المكسور يا % % عيني ومنك الجبر داني % % 7(@)(@@) % ولذا يكون الحسن في % % هذا وفي حور الجنان % % 8(@)(@@) % قم للمدام أخا الغرا % % م وطف بنا في كل حان % % 9(@)(@@) % واكرع حميا القدس من % % صور البرية في قناني % % 10(@)(@@) % واشرب معي بيد المدي % % ر فحبذا أيدي الحسان % % PageV01P1508 11(@)(@@) % وأدخل كنيسة ديرها % % واعكف على بنت الدنان % % 12(@)(@@) % متجردا عن كل ما % % يلهيك عن هاتيك فاني % % 13(@)(@@) % واسكر بها مع كل شم % % اس يميل كغصن بان % % 14(@)(@@) % واسمع مثانيك التي % % تتلى على صوت المثاني % % 15(@)(@@) % ودع الجهول يظن من % % ك ظنونه في 
ms335	 كل آن % % 16(@)(@@) % وأعلم بأنك لست تهدي من تحب مدى الزمان % % 17(@)(@@) % أفتسمع الصم الذي % % ن بعيشهم هم في افتتان % % 18(@)(@@) % أم أنت تهدي العمى عن % % ذل الضلالة والهوان % % 19(@)(@@) % أتريد ترشد عصبة % % لشجاعهم قلب الجبان % % 20(@)(@@) % خذ ما صفا لك بينهم % % واترك لهم كدر الأواني % % PageV01P1509 21(@)(@@) % وانزل إليهم لا تك % % لفهم إلى أعلى المكان % % 22(@)(@@) % ولربما انقلبوا فلا % % تنكر لهم قلب العيان % % PageV01P1510 البحر : - 1(@)(@@) % إنما نحن للإله شئون % % فهو فينا في كل يوم يكون % % 2(@)(@@) % نزلت شمسه المنازل منا % % فظهور لها بنا وكمون % % 3(@)(@@) % ها هو الحق ملء قلبي وجسمي % % وعظامي وكل ما هو دون % % 4(@)(@@) % لا حلولا وإنما هو فعل % % خلفه فاعل به محصون % % 5(@)(@@) % نحن تقديره القديم وفينا % % حدثت بالوجود منه فنون % % 6(@)(@@) % كيفما شاء عنه في الكون كنا % % واحتراك لنا به وسكون % % 7(@)(@@) % فيه كنا قدما فقيل عليم % % كل شيء في علمه موزون % % 8(@)(@@) % ثم لما عنه قد صدرنا % % كان فينا والعين منه عيون % % 9(@)(@@) % فتسمى بقادر ومريد % % عندما عز فهو ليس يهون % % 10(@)(@@) % كل هذا ونحن نحن جميعا % عدم يحتويه كاف ونون % % PageV01P1511 11(@)(@@) % وهو قح هو الوجود على ما % % هوفيه والفتح غيث هتون % % 12(@)(@@) % جاءت السنة الحصان بهذا % % وأتانا كتابه المكنون % % 13(@)(@@) % فتمسك به بإرشاد هاد % % يقتفيه فإنه المأمون % % 14(@)(@@) % واترك المنكر الذي ليس يدري % % فهو عن ذوق طعمه الملعون % % 15(@)(@@) % إن لله في الوجود قلوبا % % عقلها عند من سواها جنون % % PageV01P1512 البحر : - 1(@)(@@) % لمائه كلنا أواني % % ونحن في نفسه معاني % % 2(@)(@@) % والكل عن أمره ظلال % % وذاته الشمس في البيان % % 3(@)(@@) % مراتب بالوجود صارت % % حقائق الغيب والعيان % % 4(@)(@@) % عن كل أوصافه أبانت % % عند الورى مثل ترجمان % % 5(@)(@@) % وجوده لا يزال منها % % يطلى بنيل وزعفران % % 6(@)(@@) % وبظلام وبضياء % % وبضراب وبطعان % % 7(@)(@@) % وبجماد وبنبات % % وبأناس وحيوان % % 8(@)(@@) % وبرجال وبنساء % % وأهل شيب وعنفوان % % 9(@)(@@) % وكل عقل وكل حسن % % والمتمنين والأماني % % 10(@)(@@) % وكل فهم وكل وهم % % وكل وقت وكل آن % % PageV01P1513 11(@)(@@) % وملكوت وجبروت % % وكل أنس وكل جان % % 12(@)(@@) % وكل ساق 
ms336	 وكل كاس % % وكل خمر وكل حان % % 13(@)(@@) % وبحسان وبقباح % % وبهموم وبتهاني % % 14(@)(@@) % وكل شيء صرفت عنه % % ولم يصرح به لساني % % 15(@)(@@) % توهمات الجميع فيه % % من فرط عز ورفع شان % % 16(@)(@@) % يجل عنها وعن مقالي % % يجل فيما به سباني % % 17(@)(@@) % والعلم بالجهل قد تساوى % % عجزهما عنه في قران % % 18(@)(@@) % وكل عبد بما لديه % % في محنة منه وافتتان % % 19(@)(@@) % وقد تجلى بكل شيء % % والشيء من عالم الكيان % % 20(@)(@@) % فضا منه فضاء كل % % كالنور في صبغة القناني % % PageV01P1514 21(@)(@@) % وفيه كانت فصار فيها % % بقائم والجميع فانى % % 22(@)(@@) % وهو على ما عليه قدما % % بلا انتقال ولا اختزان % % 23(@)(@@) % ولا اتصال ولا انفصال % % ولا افتراق ولا اقتران % % 24(@)(@@) % ولا التفات ولا جهات % % ولا زمان ولا مكان % % 25(@)(@@) % ولا حلول ولا اتحاد % % ولا تناء ولا تداني % % 26(@)(@@) % فإن تكن فاهما وإلا % % فدع كلامي لمن يداني % % 27(@)(@@) % ولا تعب ما جهلت منه % % بقلبك القاصر الجبان % % 28(@)(@@) % وخل ما قلته لقوم % % يطرب أسماعهم أذاني % % 29(@)(@@) % فإن داعي الكمال مني % % يسمع من شاء بامتنان % % 30(@)(@@) % وكل شيء للحق شان % % والحق باد في كل شان % % PageV01P1515 31(@)(@@) % مسك له الكل طيب عرف % % معنى له الكل كالمباني % % 32(@)(@@) % نحن التقادير منه فيه % % كالكيف والكم والمكان % % 33(@)(@@) % وهو الوجود القديم صرفا % % وماله في الوجود ثاني % % 34(@)(@@) % رآه موسى الكليم نارا % % عنه بدا الكل كالدخان % % 35(@)(@@) % ورام منه بأن يراه % % فجاءه عنه لن تراني % % 36(@)(@@) % لكونه رائيا فلو لم % % يرى رآه إليه داني % % 37(@)(@@) % لكن علا شوقه عليه % % منه عذا مالك العنان % % 38(@)(@@) % وزاد حتى أزال عنه % % تثبتا كان في الجنان % % 39(@)(@@) % ومنه قد صار في ذهول % % وفي اندهاش لما يعاني % % 40(@)(@@) % والشوق يوهى العقول جدا % % في رؤية الأوجه الحسان % % PageV01P1516 41(@)(@@) % حتى إذا دك منه طورا % وعاد بالصعق في اكتمان % % 42(@)(@@) % أفاق مستغفرا منيبا % مسبحا طالب الأمان % % 43(@)(@@) % ما قال إني رأيت أو ما % % رأيت إذ كان في عيان % % 44(@)(@@) % كان محبا له فأضحى % % محبوبه الرائق الدنان % % 45(@)(@@) % وما عليه اختفى تبدى % % له جهارا بلا 
ms337	 تواني % % 46(@)(@@) % وصار بيديه كل شيء % % قد كان أخفاه باجتنان % % 47(@)(@@) % وللمثاني آيات حق % % تظهر في نغمة المثاني % % 48(@)(@@) % يذوقها كل ذي فؤاد % % بنيل قرب الإله العاني % % 49(@)(@@) % سماؤه بالغرام شقت % % وورده صار كالدهان % % 50(@)(@@) % يموت بالفكر ثم يحيى % % بالذكر في القلب واللسان % % PageV01P1517 51(@)(@@) % ويستريب الجهول منه % % والله يلقيه في امتحان % % 52(@)(@@) % ولا تراه يعيش إلا % % في فرط ذل وفي هوان % % 53(@)(@@) % وإن يمت فالجزاء نار % % لأنه للضلال جاني % % 54(@)(@@) % وبافتراء وباعتداء % % أنكر حقا وبامتهان % % 55(@)(@@) % ولا يضيع الإله شيئا % فكيف إيذاء ذي العيان % % PageV01P1518 البحر : - 1(@)(@@) % أنا المعروف لي بالله ألوان % % فرحمن وشيطان وإنسان % % 2(@)(@@) % لقوم ذا وقوم ذا وقوم ذا % % على مقدار ما تنويه إخوان % % 3(@)(@@) % ولا وصف بدا لي قط من ذاتي % % ولا نعت ولا حال ولا شان % % 4(@)(@@) % ولكن كيفما قد كنت يا خلي % % تراني فيك إشراك وإيمان % % 5(@)(@@) % تجلى بي على أهل الصفار بيوقد شاء التجلي بي على قوم لهم خبث وتكدير وحرمان % فذكر عندهم أتلى وقرآنسقط بيت ص % % 6(@)(@@) % ومالي لا ولا للغير من صنع % % وكل الصنع للمولى كما دانوا % % 7(@)(@@) % وقولي عند قوم محض تحقيق % % وقوم عندهم ذا القول هذيان % % 8(@)(@@) % وريح المسك لا يدريه من مز كوم % % وضوء الشمس غابت عنه عميان % % 9(@)(@@) % ويا من أنكروني احذروا مني % % فأرواح لكم راحت وأديان % % 10(@)(@@) % وكفوا القول عن ذكري بتقبيح % % ورائي عصبة في الله شجعان % % PageV01P1519 11(@)(@@) % ورائي كل ذي باع إذا مدت % % فلا إنس له تبقى ولا جان % % 12(@)(@@) % وأسياف صقيلات وأرماح % % طويلات وضراب وطعان % % 13(@)(@@) % هي الأطوار لي فيها مقامات % % ولا يدري سوى من فيه عرفان % % 14(@)(@@) % ألا يا قوم كم ذا العيش في جهل % % أما فيكم لدين الحق إذعان % % 15(@)(@@) % لحاكم في فشار القوم قد شابت % % وما تابت فآثام وعصيان % % 16(@)(@@) % ولما أسكرتكم خمرة الدنيا % % عميتم من تقى يوليه رحمان % % 17(@)(@@) % فتقواكم ظنون في الورى ساءت % % وتلبيس على حق وبهتان % % 18(@)(@@) % وعند الله هنتم والورى لما % % رجال الله جهلا عندكم هانوا % % 19(@)(@@) % إذا 
ms338	 خفتم لباريكم فمن ذنب % % يريكم في ذاك الذنب شيطان % % 20(@)(@@) % وإن رمتم لشرع أن تقيموه % % على مثلي لكم قد قام ميزان % % PageV01P1520 21(@)(@@) % وأنتم في هواكم كيفما شئتم % % فعلتم بينكم زور وإدهان % % 22(@)(@@) % حقوق العبد من أدنى معاصيكم % % ومنكم في حقوق الله طغيان % % 23(@)(@@) % أبحتم عرض من لم يرض ما أنتم % % عليه من نفاق فهو خسران % % 24(@)(@@) % وزخرفتم مقالات بها انغرت % % كهول في مذماتي وشبان % % 25(@)(@@) % أجار الله من وسواسكم قلبي % % ومني وقيت عن ذاك آذان % % PageV01P1521 البحر : - 1(@)(@@) % اعبد على الكشف وأدخل ساحة الإحسان % % وأطلق جوادك بلا لجم ولا أرسان % % 2(@)(@@) % وحاصل الأمر عند العى والملسان % % الروح للحق مثل النفس للإنسان % % PageV01P1522 البحر : - 1(@)(@@) % يقول الناس دع ما فيه ظن % % به الوسواس فيك سطا علينا % % 2(@)(@@) % ونحن الأصدقاء ولم نرجح % % عليك سواك بين العالمينا % % 3(@)(@@) % لقد كذبوا بذاك وهل صديق % % تراه بصدق الشيطان فينا % % PageV01P1523 البحر : - 1(@)(@@) % إن قلت لم أقدر ولم أستطع % % أدفع عني كيد شيطاني % % 2(@)(@@) % أو قلت ذا صعب على همتي % % فأنت في كذب وبهتان % % 3(@)(@@) % إن الشياطين من النار هم % % والماء منه كل إنسان % % 4(@)(@@) % والماء يطفي النار والنار لا % % تسطو على الماء بسلطان % % 5(@)(@@) % ما لم يحل بينهما موصل % % لبرد ماء حر نيران % % 6(@)(@@) % وههنا النفس غدت حائلا % فاكسر إناء الحائل الفاني % % 7(@)(@@) % يبقى بعيدا عنك يخشاك أن % % تطغيه شيطانك الداني % % PageV01P1524 البحر : - 1(@)(@@) % طرف الذي طلب التحقيق سهران % % وعقله بشراب الله سكران % % 2(@)(@@) % وقلبه فيه أخلاق مطهرة % % حميدة وهو بالتوفيق ملآن % % 3(@)(@@) % إن رمت أخلاقه الحسنى تعددها % % فلتصغ منك لما أبديه أذان % % 4(@)(@@) % هي الوقار كذا التقصير في أمل % % ونية ورحمة أيضا وإيمان % % 5(@)(@@) % نصيحة غيرة شكر مجاهدة % % تصوف ثم إخلاص وإحسان % % 6(@)(@@) % خوف من الله مع حزن له أدب % % وذكر موت وتفويض وإيقان % % 7(@)(@@) % وغبطة في التقى رشد مرابطة % % شجاعة ثم تحقيق وإمعان % % 8(@)(@@) % وكظم غيظ وعفور والخشوع كذا % % رفق وصدق وما تبديه فتيان % % 9(@)(@@) % والحب في الله ثم البغض فيه به % % أنس وشوق إلى المولى وأشجان 
ms339	 % % 10(@)(@@) % وحسن ظن وزهد عفة وحيا % % أمانة ثم تسليم وإذعان % % PageV01P1525 11(@)(@@) % صلابة لدينا ثم الاستقامة مع % % قناعة وعلى الرحمن تكلان % % 12(@)(@@) % ورقة والتأني والتملق في % % تحصيل علم لدى شيخ له شان % % 13(@)(@@) % سلامة الصدر من حقد مراقبة % % فراسة ذكر أن الله منان % % 14(@)(@@) % والمدح والذم فيه الاستواء كذا % % تفكر حكمة تنمو وتزدان % % 15(@)(@@) % مروءة واعتقاد لا ابتداع به % % حب الخمول فلا يدريه إنسان % % 16(@)(@@) % صبر وسعى وحلم توبة ورجا % % محبة الله حتى عنه رضوان % % 17(@)(@@) % وفاء عهد وإنجاز لموعدة % % عقاب نفس عتاب فيه تبيان % % 18(@)(@@) % تواضع ثم إيثار مشارطة % % حساب نفس له في العدل ميزان % % 19(@)(@@) % كذا عبودية حرية وكذا % % إرادة والسخا ما فيه نقصان % % 20(@)(@@) % وقصد طول حياة للتقى وإلى % % خير مبادرة إذ فيه إمكان % % PageV01P1526 21(@)(@@) % فخذ حميدة أخلاق ثمانية % % أتت وسبعين عقد فيه مرجان % % PageV01P1527 البحر : - 1(@)(@@) % تعلم حفظ آفات اللسان % % لتحظى بالأمان وبالأماني % % 2(@)(@@) % وخذها إنها سعبون شيئا % % حكت في نظمها عقد الجمان % % 3(@)(@@) % فكفر والخطا مع خوف كفر % % وكذب ثم سب في هوان % % 4(@)(@@) % وفحش غيبة ونميمة مع % % مراء والجدال وطعن جاني % % 5(@)(@@) % وسخرية وتعريض ولعن % % ونوح واشتغال بالأغاني % % 6(@)(@@) % مخاصمة وإفشاء لسر % وخوض في مجال با فتتان % % 7(@)(@@) % سؤال المال والدنيا نفاق % % بقول والكلام لدى الأذان % % 8(@)(@@) % سؤالك عن أغاليط وأيضا % % عوام الناس عن صعب المعاني % % 9(@)(@@) % وتغليظ الكلام وأمر نكر % % ونهى العرف مع خطأ اللسان % % 10(@)(@@) % سؤال عن عيوب الناس أخذ % % لذي الوجهين في أمر الدهان % % PageV01P1528 11(@)(@@) % كلامك حالة القرآن يتلى % % وبعد طلوع فجر للعيان % % 12(@)(@@) % وحالة خطبة وبمسجد مع % % دخول خلا لحاجات تعاني % % 13(@)(@@) % وفي حال الصلاة وفي جماع % % وفتح القول عند كبير شان % % 14(@)(@@) % وبالألقاب نبز مع يمين % % غموس أو بغير الله داني % % 15(@)(@@) % إخافة مؤمن وفضول قول % % وإكثار اليمين بلا تواني % % 16(@)(@@) % على غير الدعاء لأهل ظلم % % بدون إصلاح كل آن % % 17(@)(@@) % سؤال إمارة ووصاية مع % % توليه على دار وخان % % 18(@)(@@) % ورد كلام متبوع وقطع % % لقول الغير شعر ذو امتهان % % 19(@)(@@) % تناجي 
ms340	 اثنين مدح مع مزاج % % ونطق بالذي هو غير عاني % % 20(@)(@@) % على النفس الدعاء ورد عذر % % أتى بالرأي تفسير القرآن % % PageV01P1529 21(@)(@@) % سؤالك عن حلال أو طهور % % بغير محله قصد امتحان % % 22(@)(@@) % وسجع والفصاحة مع سلام % % على الذمي وذي فسق مهان % % 23(@)(@@) % كذا متغوط أو بائل مع % % كلام الأجنبية في مكان % % 24(@)(@@) % وإرشاد لنحو طريق سوء % % وإذن في المعاصي للمداني % % 25(@)(@@) % وآفات العبادات اللواتي % % تعدت والتي قصرت لعاني % % 26(@)(@@) % كذا الآفات ضمن معاملات % % وآفات السكون بلا بيان % % 27(@)(@@) % وقد تمت بعون الله فاخلص % % لناظمها دعاءك بالجنان % % PageV01P1530 البحر : - 1(@)(@@) % لله حمدي دائما في الورى % % حمد مقيم النعمة القاطن % % 2(@)(@@) % على انصلاح القلب والجسم من % % سوء بليد ضل أو فاطن % % 3(@)(@@) % أمامنا الأعظم في ظاهر % % وشيخنا الأكبر في الباطن % % PageV01P1531 البحر : - 1(@)(@@) % قل لمن قال عن ذوي العرفان % % ورجال التحقيق والإيمان % % 2(@)(@@) % طاعنا في اعتقادهم أوهاما % % وخيالا جميع ذي الأكوان % % 3(@)(@@) % مثل أهل الضلال ذا منك جهل % % بنصوص الحديث والقرآن % % 4(@)(@@) % إن أهل الضلال ليسوا بشيء % % حاضر عندهم ذوي إذعان % % 5(@)(@@) % لينا لوا ثبوت ما غاب عنهم % % بل همو بالجميع في كفران % % 6(@)(@@) % أين منهم أهل التحقق بالله % % وأهل الكمال والعرفان % % 7(@)(@@) % ونجوم الهدى لكل جهول % % ورجوم لعصبة الشيطان % % 8(@)(@@) % وإذا الشمس أشرقت لا تراها % % دائم الدهر أعين العميان % % 9(@)(@@) % إنما الله عندنا هو حق % % لا سواه والكل في بطلان % % 10(@)(@@) % واستمع أينما تولوا فثم ال % % وجه والوجه ذاته يا معاني % % PageV01P1532 11(@)(@@) % لا تقل أينما تفيد مكانا % % وعليه استحال كل مكان % % 12(@)(@@) % إنما تلك باعتبارك إذ أن % % ت مع الكل في الفنا سيان % % 13(@)(@@) % ما عدا الوجه فهو لا شك حق % % والسوى فيه باطل باقتران % % 14(@)(@@) % وكذا قول ربنا كل شيء % % هالك كل من عليها فاني % % 15(@)(@@) % وحديث النبي ألا كل شيء % % ما خلا الله باطل منك داني % % 16(@)(@@) % ولهذا بربهم قام قومي % % عابديه على تقى وعيان % % 17(@)(@@) % جملة العارفين في كل وقت % % حسنات الدهور والأزمان % % 18(@)(@@) % أيها المنكر الذي ليس يدري % % ما الذي فيه 