ms61	 ببغداد(@)(@@)(@@)(@@) $ 2095 والقاضي شمي الدين أبو نصر محمد بن هبة الله بن محمد بن مميل الشيرازي الشافعي(@)(@@)(@@)(@@) $ 2096 ونجم الدين مكرم بن محمد بن حمزة بن أبي الصقر القرشي التاجر(@)(@@)(@@)(@@) $ 2097 والمحدث أبو الخير بدل بن أبي المعمر بن إسماعيل التبريزي(@)(@@)(@@)(@@) $ 2098 والمقرىء المحدث أبو الفضل جعفر بن علي بن أبي البركات الهمذاني الإسكندراني بدمشق(@)(@@)(@@)(@@) $ 2099 والمقرىء والمفتي جمال الدين أبو القاسم عبدالرحمن بن عبدالمجيد بن الصفراوي الإسكندراني(@)(@@)(@@)(@@) $ 2100 وأبو الفضل محمد بن محمد بن الحسن ابن السباك البغدادي(@)(@@)(@@)(@@) $ 2101 وزكي الدين محمد بن يوسف بن محمد البرزالي الإشبيلي(@)(@@)(@@)(@@) $ 2102 والمحدث أبو العباس أحمد بن محمد بن مفرج بن الرومية الإشبيلي الظاهري النباتي العشاب PageV01P198(@)(@@)(@@)(@@) $ 2103 والصدر علاء الدين أبو سعد ثابت بن محمد بن أحمد الخجندي ثم الأصبهاني بشيراز يروي الصحيح عن أبي الوقت حضورا(@)(@@)(@@)(@@) $ 2104 وأبو القاسم عبدالرحيم بن يوسف بن هبة الله ابن الطفيل(@)(@@)(@@)(@@) $ 2105 والمقرىء أبو محمد بن عبدالعزيز ابن دلف البغدادي الناسخ(@)(@@)(@@)(@@) $ 2106 والحافظ أبو عبدالله محمد بن سعيد بن يحيى الواسطي المقرىء(@)(@@)(@@)(@@) $ 2107 والمحدث أبو البركات المبارك بن أحمد بن المبارك بن موهوب اللخمي الإربلي ابن المستوفي(@)(@@)(@@)(@@) $ 2108 وأبو علي أحمد بن محمد بن محمود بن المعز الحراني ببغداد(@)(@@)(@@)(@@) $ 2109 جمال الملك علي بن المختار بن نصر بن طعان العامري الإسكندراني ويعرف بابن الجمل(@)(@@)(@@)(@@) $ 2110 وأبو العباس أحمد بن يعقوب بن عبد الله المارستاني(@)(@@)(@@)(@@) $ 2111 والتقي إسحاق بن طرخان بن ماضي الشاغوري(@)(@@)(@@)(@@) $ 2112 والمحدث أبو طاهر إسماعيل بن ظفر بن أحمد المنذري النابلسي PageV01P199(@)(@@)(@@)(@@) $ 2113 وأبو علي الحسن بن إبراهيم بن هبة الله بن دينار المصري الصائغ(@)(@@)(@@)(@@) $ 2114 والمحدث أبو الربيع سليمان بن إبراهيم بن هبة الله بن رحمة الإسعردي(@)(@@)(@@)(@@) $ 2115 والعلامة كمال الدين موسى بن يونس الموصلي(@)(@@)(@@)(@@) $ 2116 وعلم الله بن علي بن محمود بن أحمد بن الصابوني الصوفي بمصر(@)(@@)(@@)(@@) $ 2117 والمسند أبو الكرم محمد بن عبدالواحد بن أحمد بن أحمد المتوكلي الهاشمي بن شفنين(@)(@@)(@@)(@@) $ 2118 والحافظ تقي الدين أبو إسحاق إبراهيم بن محمد بن 
ms62	 الصريفيني العراقي الحنبلي(@)(@@)(@@)(@@) $ 2119 وأبو محمد عبدالحق بن خلف الصالحي الحنبلي(@)(@@)(@@)(@@) $ 2120 ومخلص الدين عبد الواحد بن عبدالرحمن بن أبي المكارم بن هلال الأزدي(@)(@@)(@@)(@@) $ 2121 والمسند أبو طالب عبداللطيف بن محمد بن علي بن حمزة بن القبيطي الحراني ثم البغدادي التاجر(@)(@@)(@@)(@@) $ 2122 والمسند أبو التمام علي بن أبي الفخار هبة الله بن محمد بن هبة الله العباسي البغدادي PageV01P200(@)(@@)(@@)(@@) $$ 2123 ومسندة الشام أم الفضل كريمة بنت عبدالوهاب بن علي القرشية الزبيرية بنت الحبقبق(@)(@@)(@@)(@@) $ 2124 والمحدث أبو عبدالله محمد بن محمد بن عبدالرحمن بن محارب القيسي ثم الغرناطي ثم الإسكندري(@)(@@)(@@)(@@) $ 2125 وششيخ الفتوح تاج الدين أبو محمد عبدالله بن عمر بن حموية الجويني(@)(@@)(@@)(@@) $ 2126 والحافظ أبوالقاسم القاسم بن محمد بن أحمد الأنصاري القرطبي ابن الطليسان(@)(@@)(@@)(@@) $ 2127 وكمال الدين أبو الفضل يوسف بن عبدالمعطي بن منصو ابن المخيلي الإسكندراني(@)(@@)(@@)(@@) $ 2128 والمحدث صفي الدين أحمد بن عبدالخالق بن محمد بن أبي هشام القرشي الدمشقي وله ثمانون سة(@)(@@)(@@)(@@) $ 2129 والحافظ سيف الدين أحمد بن المجد عيسى بن عبدالله المقدسي الحنبلي وله ثمان وثلاثون سنة(@)(@@)(@@)(@@) $ 2130 والحافظ أبو العباس أحمد بن محمود بن إبراهيم بن نبهان الجوهري الدمشقي(@)(@@)(@@)(@@) $ 2131 والحافظ أبو منصور عبدالله بن محمد بن أبي الوليد البغدادي كهلا PageV01P201(@)(@@)(@@)(@@) $ 2132 والمحدث تاج الدين عبدالجليل بن عبدالجبار بن عبدالواسع الأبهري بدمشق(@)(@@)(@@)(@@) $ 2133 والمحدث سراج الدين عبدالرحمن بن عمر بن شحانة الحراني كهلا بميافارقين(@)(@@)(@@)(@@) $ 2134 والحافظ أسعد الدين أبو القاسم عبدالرحمن بن مقرب بن عبدالكريم التجبيبي الكندي(@)(@@)(@@)(@@) $ 2135 والمحدث القاضي أحمد بن القاضي الفاضل عبدالرحيم بن علي البيساني بمصر(@)(@@)(@@)(@@) $ 2136 والحافظ العلامة تقي الدين أبو عمرو بن عثمان بن الصلاح الشهرزوري الشافعي(@)(@@)(@@)(@@) $ 2137 ومسند العصر أبو الحسن علي بن الحسين بن علي بن منصور الأزجي ابن المقير(@)(@@)(@@)(@@) $ 2138 والعلامة علم الدين علي بن محمد بن عبدالصمد السخاوي المقرىء(@)(@@)(@@)(@@) $ 2139 والنسابة عز الدين أبو عبدالله محمد بن أحمد بن ع