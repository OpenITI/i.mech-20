ms2461	 ع ) و أبو الشيخ والخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@) PageV07P347(@)(@@)(@@)(@@) $ ( 22856 ) قال النبي :(@)(@@) | 30 ( من كان عنده طول فلينكح وإلا فعليه بالصوم فإنه له وجاء ومحسمة للعرق ) )(@)(@@) ابن أبي عاصم وسمويه ( هب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22857 ) قال النبي :(@)(@@) | 30 ( من كان له منكم شعر فليكرمه ، قيل : يا رسول الله وما إكرامه ؟ قال : يدهنه ويمشطه كل يوم ) )(@)(@@) أبو نعيم في تاريخ أصبهان وابن عساكر عن ابن عمر وفيه إسحاق بن إسماعيل الرملي ، قال أبو نعيم : حدث بأحاديث من حفظه فأخطأ فيها ، وقال النسائي : صالح .(@)(@@)(@@)(@@) $ ( 22858 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فإذا أتاه كريم قوم فليكرمه ) )(@)(@@) الخرائطي ( ك ) وابن عساكر عن معبد بن خالد بن أنس بن مالك عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22859 ) قال النبي :(@)(@@) | 30 ( من كان خارجا من المدينة فبدا له فليركب ، فإذا جاء المدينة فليمش إلى المصلى فإنه أعظم أجرا ، وقدموا قبل خروجكم زكاة الفطر فإن على كل نفس مدين من قمح أو دقيق ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه قال : سمعت رسول الله يقول في يوم الفطر ، فذكره .(@)(@@)(@@)(@@) $ ( 22860 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليحب ص| هيب ا حب الوالدة لوالدها ) )(@)(@@) ( عد ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22861 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليحب ص| هيب ا حب الوالد لولده ) )(@)(@@) ( كر ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22862 ) قال النبي :(@)(@@) | 30 ( من كان وسيلة لأخيه المسلم إلى ذي سلطان في منفعة بر ، أو تيسير عسير ، أعين على إجازة الصراط يوم دحض الأقدام ) )(@)(@@) ( هق ) PageV07P348 و ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22863 ) قال النبي :(@)(@@) | 30 ( من كان وسيلة لأخيه المسلم إلى ذي سلطان في مبلغ بر أو تيسير عسير أعانه الله على إجازة الصراط يوم القيامة عند دحض الأقدام ) )(@)(@@) الحسن بن سفيان ( حب ) والخرائطي في مكارم الأخلاق وابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22864 ) قال النبي :(@)(@@) | 30 
ms2462	 ( من كان منكم صائما من الشهر ثلاثة أيام فليصم الثلاث البيض ) )(@)(@@) ( حم ) و ابن زنجويه عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22865 ) قال النبي :(@)(@@) | 30 ( من كان ذا لسانين في الدنيا ، جعل الله له لسانين من نار يوم القيامة ) )(@)(@@) الخرائطي في مساوىء الأخلاق وابن النجار والخطيب عن أنس ، ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22866 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليكرم ضيفه ، ومن كان يؤمن بالله واليوم الآخر فليكرم جاره ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ، ومن كانت تؤمن بالله واليوم الآخر من نسائكم فلا تدخل الحمام ) )(@)(@@) ( ع حب طب ك هق ض ) عن عبد الله بن يزيد الخطمي عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22867 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يبتاعن ذهبا بذهب إلا وزنا بوزن ، ولا تنكح ثيب من السبايا حتى تحيض ) )(@)(@@) ( حم ) و الطحاوي عن رويفع بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22868 ) قال النبي :(@)(@@) | 30 ( من كان مصليا بعد الجمعة فليصل أربعا ، فإن عجل بأحد منكم حاجة فليصل ركعتين ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P349(@)(@@)(@@)(@@) $ ( 22869 ) قال النبي :(@)(@@) | 30 ( من كان مصليا فليصل أربعا قبلها وبعدها أربعا ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22870 ) قال النبي :(@)(@@) | 30 ( من كان عليه تحرير رقبة من ولد إسماعيل فليعتق نسمة من بلعنبر ) )(@)(@@) الباوردي وسمويه ( طب ض ) عن شعيب بن عبد الله بن زينب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22871 ) قال النبي :(@)(@@) | 30 ( من كان له لسانان في الدنيا جعل الله له لسانين من نار يوم القيامة ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة ، ( ع ) عن أنس ، ابن أبي الدنيا ، ( طب ) عن ابن مسعود رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22872 ) قال النبي :(@)(@@) | 30 ( من كان منكم صائما فليتم صومه ، ومن لم يكن صائما ما بقي من يومه ، قاله يوم عاشوراء ) )(@)(@@) البغوي والباوردي وابن قانع ، ( طب ض ) عن زاهر الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22873 ) قال النبي 
ms2463	 :(@)(@@) | 30 ( من كان له بالمدينة أصل فليمسك به ، ومن لم يكن له بها أصل فليجعل له بها أصلا ، فليأتين على الناس زمان يكون الذي ليس له بها أصل كالخارج منها ، المجتاز إلى غيرها ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22874 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر ويشهد أني رسول الله فليسعه بيته وليبك على خطيئته ، ومن كان يؤمن بالله واليوم الآخر ويشهد أني رسول الله فليقل خيرا ليغنم ، أو ليسكت عن شر فيسلم ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV07P350(@)(@@)(@@)(@@) $ ( 22875 ) قال النبي :(@)(@@) | 30 ( من كانت منكن تؤمن بالله واليوم الآخر فلا ترفع رأسها حتى يرفع الرجال رؤوسهم من ضيق ثياب الرجال ) )(@)(@@) ( حم د طب هق ) و الخطيب عن أسما بنت أبي بكر رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22876 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليكرم ضيفه ، قالوا : وما إكرامة الضيف ؟ قال : ثلاثة أيام ، فما جلس بعد ذالك فهو له صدقة ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22877 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يؤذ جاره ) )(@)(@@) ( حل ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22878 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فعليه الجمعة يوم الجمعة ، إلا أن تكون امرأة أو عبدا أو صبيا ، أو مريضا ، أو مسافرا ، ومن استغنى عنها بلهو أو تجارة استغنى الله عنه ، والله غني حميد ) )(@)(@@) ( قط ) في الأفراد عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22879 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يؤذ جاره ) )(@)(@@) الخطيب عن أبي شريح الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22880 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ) )(@)(@@) الخطيب عن أنس ، ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22881 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يؤذ جاره ، ومن كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليسكت ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P351(@)(@@)(@@)(@@) $ ( 22882 ) قال 
ms2464	 النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخلن حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر فلا يشرب الخمر ، ومن كان يؤمن بالله واليوم الآخر فلا يخلون بامرأة ليس بينه وبينها محرم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22883 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليؤد زكاة ماله ، ومن كان يؤمن بالله ورسوله فليقل حقا أو ليسكت ، ومن كانت يؤمن بالله ورسوله فليكرم ضيفه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22884 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليتق الله وليكرم ضيفه ، من كان يؤمن بالله واليوم الآخر فليقل حقا أو ليسكت ) )(@)(@@) ( حم ) عن رجال من الصحابة .(@)(@@)(@@)(@@) $ ( 22885 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر فليسع إلى الجمعة ، ومن استغنى عنها بلهو أو تجارة استغنى الله عنه ، والله غني حميد ) )(@)(@@) ( طس ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22886 ) قال النبي :(@)(@@) | 30 ( من كان في طلب العلم كانت الجنة في طلبه ، ومن كان في طلب المعصية كانت النار في طلبه ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22887 ) قال النبي :(@)(@@) | 30 ( من كان في قلبه مثقال حبة خردل من كبر كبه الله في النار على وجهه ) )(@)(@@) ( قط ) في الأفراد ، ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P352(@)(@@)(@@)(@@) $ ( 22888 ) قال النبي :(@)(@@) | 30 ( من كان أصبح منكم صائما فليتم صومه ، ومن لم يصبح صائما فعلا يأكلن شيئا ، فإن هاذا يوم نصر فيه موسى على فرعون فصامته اليهود شكرا فنحن أحق بالشكر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22889 ) قال النبي :(@)(@@) | 30 ( من كان إزاره واسعا فليتشح به ، ومن كان إزاره ضيقا فليأتزر به ثم ليصل فيه ) )(@)(@@) حمزة بن يوسف السهمي في معجمه ، وابن النجار عن علي رضي الله 
ms2465	 عنه .(@)(@@)(@@)(@@) $ ( 22890 ) قال النبي :(@)(@@) | 30 ( من كان هينا لينا سهلا قريبا حرمه الله على النار ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22891 ) قال النبي :(@)(@@) | 30 ( من كان موسرا لأن ينكح فلم ينكح فليس مني ) )(@)(@@) ( طب ) عن أبي نجيح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22892 ) قال النبي :(@)(@@) | 30 ( من كان موسرا لأن ينكح ، ومن لم ينكح فليس منا ) )(@)(@@) ( هق ) عن ميمون أبي المغلس مرسلا ، ( هب ) عنه عن أبي نجيح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22893 ) قال النبي :(@)(@@) | 30 ( من كان موسر فلينكح ، ومن لم ينكح فليس منا ) )(@)(@@) البغوي عن أبي مغلس عن أبي نجيح رضي الله عنه قال : وليس بالسلمي شك في صحبته .(@)(@@)(@@)(@@) $ ( 22894 ) قال النبي :(@)(@@) | 30 ( من كان فيه واحدة من ثلاث زوجه الله من الحور العين : من كانت عنده أمانة خفية شهية فأداها من مخافة الله ، أو رجل عفى عن قاتله ، أو رجل قرأ { قل هو الله أحد } دبر كل صلاة ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@) PageV07P353(@)(@@)(@@)(@@) $ ( 22895 ) قال النبي :(@)(@@) | 30 ( من كان عنده طعام فليتصدق بصاع من بر ، أو صاع من شعير ، أو صاع من تمر ، أو صاع من دقيق ، أو صاع من زبيب ، أو صاع من سلت ) )(@)(@@) ( ك ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22896 ) قال النبي :(@)(@@) | 30 ( من كان صائما فليفطر فإنهن أيام أكل وشرب ) )(@)(@@) ( ك ) عن بديل بن ورقاء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22897 ) قال النبي :(@)(@@) | 30 ( من كان منكم ذا طول فليتزوج فإنه أغض للطرف ، وأحصن للفرج ، ومن لا ، فإن الصوم له وجاء ) )(@)(@@) ( حم ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22898 ) قال النبي :(@)(@@) | 30 ( من كان منكم ملتمسا ليلة القدر فليلتمسها في العشر الأواخر وترا ) )(@)(@@) ( حم ع ) و ابن خزيمة ( ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22899 ) قال النبي :(@)(@@) | 30 ( من كان الله تعالى خلقه لواحدة من المنزلتين يهيؤه لعملها ) )(@)(@@) ( حم ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22900 ) قال النبي :(@)(@@) | 30 ( من كان في سفر على حمولة يأوي إلى شبع فليصم 
ms2466	 حيث أدركه رمضان ) )(@)(@@) ( هق ) وضعفه عن المحبق .(@)(@@)(@@)(@@) $ ( 22901 ) قال النبي :(@)(@@) | 30 ( من كان عليه صوم رمضان فليسرده ولا يقطعه ) )(@)(@@) ( قط هق ) وضعفاه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22902 ) قال النبي :(@)(@@) | 30 ( من كان في حاجة أخيه كان الله في حاجته ، ومن PageV07P354 فرج عن مسلم كربة من كرب الدنيا فرج الله عنه كربة من كرب يوم القيامة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22903 ) قال النبي :(@)(@@) | 30 ( من كان همه هما واحدا كفاه الله همه ، ومن كان همه بكل واد لم يبال الله تعالى بأيها هلك ) )(@)(@@) هناد عن سليمان بن حبيب المحاربي مرسلا .(@)(@@)(@@)(@@) $ ( 22904 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليحسن قرى ضيفه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22905 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر ، فإذا أتاه كريم قوم فليكرمه ) )(@)(@@) الخرائطي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22906 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليكرم جليسه ) )(@)(@@) السلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22907 ) قال النبي :(@)(@@) | 30 ( من كان حسن الصورة في حسب لا يشينه متواضعا كان من خالص الله يوم القيامة ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22908 ) قال النبي :(@)(@@) | 30 ( من كان طالبا إلى الله حاجة في أمر دنياه وآخرته فليطلبها في العشاء الآخرة فإنها صلاة لم يصلها أحد من الأمم قبلكم ) )(@)(@@) الديلمي عن عيسى بن عبد الله عن أبيه عن جده عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22909 ) قال النبي :(@)(@@) | 30 ( من كان منكم مصليا بعد الجمعة أربعا ، فإذا كان له شغل فركعتين في المسجد ، وركعتين في البيت ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22910 ) قال النبي :(@)(@@) | 30 ( من كان له ثلاث بنات أو مثلهن من الأخوات ، PageV07P355 فكفلهن وعالهن وجبت له الجنة ، قال : وثنتين ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22911 ) قال النبي :(@)(@@) | 30 ( من كان له ثلاث بنات يكفلهن ويؤويهن ويزوجهن وجبت له الجنة ، قيل : واثنتين ؟ قال : واثنتين 
ms2467	 ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22912 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فعليه الجمعة إلا عبد أو امرأة أو صبي ، ومن استغنى بلهو أو تجارة استغنى الله عنه والله غني حميد ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22913 ) قال النبي :(@)(@@) | 30 ( من كان آخر كلامه : لا إلاه إلا الله لم يدخل النار ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22914 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فعليه الجمعة إلا على امرأة أو صبي أو مملوك أو مريض ) )(@)(@@) ( ش ) عن محمد بن كعب القرطبي مرسلا .(@)(@@)(@@)(@@) $ ( 22915 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يقعدن على مائدة يدار عليها الخ مر ، ومن كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بإزار ، ومن كانت تؤمن بالله واليوم الآخر فلا تدخل الحمام ) )(@)(@@) ( حم ع هق ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22916 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن منكم ملتمسا ليلة القدر فليلتمسها في العشر الأواخر فإن ضعف أو عجز فلا يغلبن عن السبع البواقي ) )(@)(@@) ابن زنجويه عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P356(@)(@@)(@@)(@@) $ ( 22917 ) قال النبي :(@)(@@) | 30 ( من كان منكم له إمام فأتم به فلا يقرأن معه ، فإن قراءته له قراءة ) )(@)(@@) ( هق ) في كتاب القراءة وضعفه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22918 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا ينظر إلى عورة أخيه ) )(@)(@@) ( ض ) عن مولى المطلب مرسلا .(@)(@@)(@@)(@@) $ ( 22919 ) قال النبي :(@)(@@) | 30 ( من كان آخر كلامه عند الموت : لا إلاه إلا الله وحده لا شريك له هدمت ما كان قبلها من الذنوب والخطايا ) )(@)(@@) ( ع كر ) عن مولى المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22920 ) قال النبي :(@)(@@) | 30 ( من كان ذا لسانين في الدنيا جعل الله له لسانين في النار ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22921 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليكرم جاره ، ومن كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليصمت ) )(@)(@@) الخرائطي في مكارم الأخلاق 
ms2468	 عن عبد الله بن سلام الخرائطي عن ابن مسعود الخرائطي عن جابر بن سمرة الخرائطي عن ابن عباس ، الخرائطي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22922 ) قال النبي :(@)(@@) | 30 ( من كان له ولد ، ذكر أو أنثى فأصيب فيه ، احتسب أو لم يحتسب ، صبر أو لم يصبر لم يكن له حجاب دون الجنة ) )(@)(@@) ابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22923 ) قال النبي :(@)(@@) | 30 ( من كان له ثلاث بنات يعولهن ويرحمهن فله بهن الجنة ) )(@)(@@) ( قط ) في الأفراد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22924 ) قال النبي :(@)(@@) | 30 ( من كان له عبد بينه وبين آخر فأعتق نصيبه فإنه يقام عليه فيعتقه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22925 ) قال النبي :(@)(@@) | 30 ( من كان له عمل يعمله فشغله عنه مرض أو سفر فإنه PageV07P357 يكتب له صالح ما كان يعمل وهو صحيح مقيم ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22926 ) قال النبي :(@)(@@) | 30 ( من كان له على رجل حق فمن أخره حان له بكل يوم صدقة ) )(@)(@@) ( حم ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22927 ) قال النبي :(@)(@@) | 30 ( من كان له جار في حائط ، ايو شريك فلا يبعه حتى يعرضه عليه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22928 ) قال النبي :(@)(@@) | 30 ( من كان له بيت وخادم فهو ملك ) )(@)(@@) الزبير بن بكار في الموفقيات وابن جرير عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 22929 ) قال النبي :(@)(@@) | 30 ( من كان له علم فليتصدق من علمه ، ومن كان له مال فليتصدق من ماله ) )(@)(@@) ابن السني عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22930 ) قال النبي :(@)(@@) | 30 ( من كان له قوت ثلاثة أيام لم يحل له أن يسأل الناس ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22931 ) قال النبي :(@)(@@) | 30 ( من كان له مال فليستكثر من العبيد ، فرب عبد قسم له من الرزق ما لم يقسم لمولاه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22932 ) قال النبي :(@)(@@) | 30 ( من كان عنده شهادة فلا يقل لا أخبر 
ms2469	 بها إلا عند الإمام ، ولاكن ليخبر بها لعله يرجع ويرعوي ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22933 ) قال النبي :(@)(@@) | 30 ( من كان على دين ودهين داود وسليمان وإبراهيم فليتزوج إن وجد إلى النكاح سبيلا ، وإلا فليجاهد في سبيل الله ، إن يستشهد PageV07P358 يزوجه الله من الحور العين إلا أن يكون يسعى على والديه أو في أمانة الناس عليه ) )(@)(@@) ابن لال عن أم حبيبة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22934 ) قال النبي :(@)(@@) | 30 ( من كانت له ابنة فأدبها وأحسن أدبها ، وعلمها فأحسن تعليمها ، وأوسع عليها من نعم الله التي أسبغ عليه ، كانت له منعة وسترا من النار ) )(@)(@@) ( طب ) و الخرائطي في مكارم الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22935 ) قال النبي :(@)(@@) | 30 ( من كانت له سريرة صالحة أو سيئة أظهر الله تعالى عليه منها رداء يعرف به ) )(@)(@@) ( حل ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22936 ) قال النبي :(@)(@@) | 30 ( من كانت له غنم فليسر بها عن المدينة ، فإن المدينة أقل أرض الله مطرا ) )(@)(@@) ( طب ) عن عبد الله بن ساعدة أخي عويم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22937 ) قال النبي :(@)(@@) | 30 ( من كانت له أختان فأحسن صحبتهما دخل بهما الجنة ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22938 ) قال النبي :(@)(@@) | 30 ( من كانت عنده نصيحة لذي سلطان فلا يكلمه بها علانية وليأخذ بيده فليخل به ، فإن قبلها قبلها ، وإلا كان قد أدى الذي له والذي عليه ) )(@)(@@) ( طب ك هق ) وتعقب عن عياض بن غنم وهشام بن حكيم رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22939 ) قال النبي :(@)(@@) | 30 ( من كانت له ثلاث بنات أو أخوات ، فصبر على لأوائهن وضرائهن وسرائهن أدخله الله الجنة بفضل رحمته إياهن ، قيل : وبنتين ؟ قال : وبنتين ، قيل : وواحدة ؟ قال : وواحدة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P359(@)(@@)(@@)(@@) $ ( 22940 ) قال النبي :(@)(@@) | 30 ( من كانت نيته الآخرة ، جمع الله له شمله ، وجعل غناه في قلبه ، وأتته الدنيا راغمة ، ومن كانت نيته الدنيا فرق الله عليه أمره ، وجعل فقره بين عينيه ، ولم يأته من 
ms2470	 الدنيا إلا ما كتب له ) )(@)(@@) ( ط ه هب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22941 ) قال النبي :(@)(@@) | 30 ( من كانت نيته طلب الدنيا شتت الله عليه أمره وجعل الفقر بين عينيه ، ولم يأته من الدنيا إلا ما كتب له ، ومن كانت نيته طلب الآخرة جمع الله شمله ، وجعل غناه في قلبه ، وأتته الدنيا وهي راغمة ) )(@)(@@) ابن أبي حاتم في الزهد عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22942 ) قال النبي :(@)(@@) | 30 ( من كانت له ابنتان أو أختان يعولهن حتى يبنهن إلا كان معي هاكذا في الجنة وجمع بين أصبعيه السبابة والوسطى ) )(@)(@@) ( طب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22943 ) قال النبي :(@)(@@) | 30 ( من كانت له إلى الله حاجة فليدع بها دبر صلاة مفروضة ) )(@)(@@) ابن عساكر عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22944 ) قال النبي :(@)(@@) | 30 ( من كانت له جمة فليكرمها ) )(@)(@@) مالك ( ن ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22945 ) قال النبي :(@)(@@) | 30 ( من كانت له امرأتان يميل مع أحدهما على الأخرى ، جاء يوم القيامة أحد شقيه ساقط ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22946 ) قال النبي :(@)(@@) | 30 ( من كانت له نخل أو أرض فلا يبعها حتى يعرضها على شريكه ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@) PageV07P360(@)(@@)(@@)(@@) $ ( 22947 ) قال النبي :(@)(@@) | 30 ( من كانت له أرض فأراد بيعها فليعرضها على جاره ) )(@)(@@) ( ه طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22948 ) قال النبي :(@)(@@) | 30 ( من كانت له ابنتان أو أختان فأحسن إليهما ما صحبتاه كنت أنا وهو في الجنة كهاتين ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22949 ) قال النبي :(@)(@@) | 30 ( من كانت له إبل لا يعطي حقها في نجدتها ورسلها ، ( قيل : يا رسول الله ما نجدتها ورسلها ؟ قال : في عسرها ويسرها ) ، فإنها تأتي يوم القيامة كأغذى ما كانت وأكثره وأسمنه وأبشره حتى يبطح لها بقاع قرقر تطؤه بأخفافها فإذا جاوزته أخراها أعيد أولاها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين الناس فيرى سبيله ، وإذا كانت له 
ms2471	 بقر لا يعطي حقها في نجدتها ورسلها فإنها تأتي يوم القيامة كأغذى ما كانت وأكثره وأسمنه وأبشره ثم يبطح لها بقاع قرقر فتطؤه كل ذات ظلف بظلفها ، وتنطحه كل ذات قرن بقرنها ، إذا جاوزت أخراها أعيدت عليه أولاها في يوم كان مقداره خمسين ألف سنة ، حتى يقضى بين الناس فيرى سبيله ، وإذا كانت له غنم لا يعطي حقها في نجدتها ورسلها فإنها تأتي يوم القيامة كأغذى ما كانت وأسمنه وأنشره حتى يبطح لها بقاع قرقر فتطؤه كل ذات ظلف بظلفها ، وتنطحه كل ذات قرن بقرنها ، ليس فيها عقصاء ولا عضباء إذا جاوزته أخراها أعيدت عليه أولاها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين الناس فيرى سبيله ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22950 ) قال النبي :(@)(@@) | 30 ( من كانت فيه ثلاث أدخله الله في رحمته ، وأراه محبته ، وكان في كنفه : من إذا أعطي شكر ، وإذا قدر غفر ، وإذا غضب فتر ) )(@)(@@) PageV07P361 ( هب ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22951 ) قال النبي :(@)(@@) | 30 ( من كانت له أمة يصيبها فلم يطأها في أربعين ليلة مرة فهو عاص لله عز وجل ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22952 ) قال النبي :(@)(@@) | 30 ( من كانت له ابنة فهو متعب ، ومن كانت له ابنتان فهو مثقل ، ومن كانت له خمس بنات فهو معي في الجنة كهاتين ، ومن كانت له ست بنات لم يحجب من أي أبواب الجنة الثمانية شاء ) )(@)(@@) أبو الشيخ عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22953 ) قال النبي :(@)(@@) | 30 ( من كانت الدنيا نهمته حرم الله تعالى عليه جواري ، فإني بعثت بخراب الدنيا ولم أبعث بعمرانها ) )(@)(@@) أبو نعيم عن أبي جحيفة عن أبي الوضاح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22954 ) قال النبي :(@)(@@) | 30 ( من كانت تجارته الطعام ، بات وفي صدره غل للمسلمين ) )(@)(@@) أبو نعيم عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22955 ) قال النبي :(@)(@@) | 30 ( من كانت له جارية فأحسن تأديبها ، وعلمها فأحسن تعليمها ثم أعتقها فتزوجها فله أجران اثنان ) )(@)(@@) ( عب ) عن أبي موسى ا 
ms2472	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22956 ) قال النبي :(@)(@@) | 30 ( من كبر واحدة كتبت له عشرون ومحيت عنه عشرون ، ومن سبح واحدة كتبت له عشرون ومحيت عنه عشرون ، ومن حمد واحدة كتبت له ثلاثون ومحيت عنه ثلاثون ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22957 ) قال النبي :(@)(@@) | 30 ( من كتب { ياس } ثم شربها دخل جوفه ألف نور ، وألف رحمة ، وألف بركة ، وألف دواء ، وخرج منه ألف داء ) )(@)(@@) الرافعي عن PageV07P362 علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22958 ) قال النبي :(@)(@@) | 30 ( من كتب عليه الخلود لم يخرج منها أبدا ) )(@)(@@) الخطيب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22959 ) قال النبي :(@)(@@) | 30 ( من كتب عني علما أو حديثا فلم يزل يكتب له الأجر ما بقي ذالك العلم والحديث ) )(@)(@@) ( ك ) في تاريخه عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22960 ) قال النبي :(@)(@@) | 30 ( من كتب { بسم الله الرحمن الرحيم } فلم يعور الهاء التي في الله كتب الله له عشر حسنات ، ومحى عنه عشر سيئات ، ورفع له عشر درجات ، ومن قرأ القرآن بإعراب فله أجر شهيد ، ومن مات غريبا مات شهيدا ) )(@)(@@) الرافعي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22961 ) قال النبي :(@)(@@) | 30 ( من كتم غالا فهو مثله ، ومن جامع المشرك وسكن معه فإنه مثله ) )(@)(@@) ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22962 ) قال النبي :(@)(@@) | 30 ( من كتم علما مما ينفع الله به الناس في أمر الدين ألجمه الله يوم القيامة بلجام من نار ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22963 ) قال النبي :(@)(@@) | 30 ( من كتم علما نافعا عنده ألجمه الله يوم القيامة بلجام من نار ) )(@)(@@) أبو نصر السجزي في الإبانة والخطيب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22964 ) قال النبي :(@)(@@) | 30 ( من كتم علما ألجمه الله يوم القيامة بلجام من نار ) )(@)(@@) ( عد ) و السجزي والخطيب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22965 ) قال النبي :(@)(@@) | 30 ( من كتم علما يعلمه ألجم يوم القيامة بلجام من نار ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22966 ) قال النبي :(@)(@@) | 30 ( من كتم علما عنده أو أخذ 
ms2473	 عليه أجرة ، لقي الله PageV07P363 تعالى يوم القيامة ملجما بلجام من نار ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22967 ) قال النبي :(@)(@@) | 30 ( من كثر كلامه كثر سقطه ، ومن كثر كلامه كثر كذبه ، ومن كثر كذبه كثرت ذنوبه ، ومن كثرت ذنوبه كانت النار أولى به ) )(@)(@@) العسكري في الأمثال عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22968 ) قال النبي :(@)(@@) | 30 ( من كثر ضحكه استخف بحقه ، ومن كثرت دعابته ذهبت جلالته ، ومن كثر مزاحه ذهب وقاره ، ومن شرب الماء على الريق ذهب نصف قوته ، ومن كثر كلامه كثر سقطه ، ومن كثر سقطه كثرت خطاياه ، ومن كثرت خطاياه كانت النار أولى به ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه وقال : غريب الإسناد والمتن .(@)(@@)(@@)(@@) $ ( 22969 ) قال النبي :(@)(@@) | 30 ( من كثر سواد قوم فهو منهم ومن رضي على قوم كان شريك من عمله ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22970 ) قال النبي :(@)(@@) | 30 ( من كذب علي فليلتمس لجنبه مضجعا من النار ) )(@)(@@) الشافعي ( هق ) في المعرفة عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22971 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا للكذب ليضل به فليتبوأ مقعده من النار ) )(@)(@@) ( طب ) عن عمرو بن حريث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22972 ) قال النبي :(@)(@@) | 30 ( من كذب علي ليضل به الناس فليتبوأ مقعده من النار ) )(@)(@@) ( بز حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22973 ) قال النبي :(@)(@@) | 30 ( من كذب علي ما لم أقل فليتبوأ بيتا في جهنم ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22974 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا فليتبوأ مقعده من جهنم ) )(@)(@@) ( حب ) عن عقبة بن عامر رضي الله عنه .(@)(@@) PageV07P364(@)(@@)(@@)(@@) $ ( 22975 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا فليتبوأ مضجعه من النار ، أو بيتا في جهنم ) )(@)(@@) ( حم ) عن قيس بن سعد وابن عمر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22976 ) قال النبي :(@)(@@) | 30 ( من كذب علي في رواية حديث فليتبوأ مقعده من النار ) )(@)(@@) ( بز ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22977 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا فليتبوأ بيتا في 
ms2474	 النار ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22978 ) قال النبي :(@)(@@) | 30 ( من كذب على بنيه أو عينيه أو على والديه فإنه لا يرح رائحة الجنة ) )(@)(@@) ابن جرير ( طب عد ) والخرائطي في مساوىء الأخلاق عن أوس الثقفي وهو ثالث حديث له ولا رابع لها ، قال ( عد ) : لا أعلم يرويه غير إسماعيل بن عياش رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22979 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا كلف يوم القيامة أن يعقد طرفي شعيرة ولن يقدر على ذالك ) )(@)(@@) ابن قانع ( ك ) وتعقب وابن عساكر عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22980 ) قال النبي :(@)(@@) | 30 ( من كذب علي معتمدا ، أو رد شيئا مما أمرت به فليتبوأ مقعده من النار ) )(@)(@@) ( طس ) و الخطيب عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22981 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا أو رد شيئا أمرت به فليتبوأ بيتا في جهنم ) )(@)(@@) ( ع ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22982 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا فليتبوأ بيتا في النار ، ومن رد حديثا بلغه عني فأنا مخاصمه يوم القيامة ، وإذا بلغكم عني حديث فلم تعرفوه PageV07P365 فقولوا : الله أعلم ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22983 ) قال النبي :(@)(@@) | 30 ( من كذب علي متعمدا فليتبوأ مقعده من بين عيني جهنم ، قالوا : يا رسول الله نحدث عنك بالحديث يزيد وينقص ، ليس ذاك أعنيكم ، إنما أعني الذي يكذب علي متحدثا يطلب به شين الإسلام ، قالوا : وهل لجهنم عين ؟ قال : نعم ، أما سمعتموه يقول : { إذا رأتهم من مكان بعيد } فهل تراهم إلا بعينين ) )(@)(@@) ( طب ) و ابن مردويه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22984 ) قال النبي :(@)(@@) | 30 ( من كسر أو عرج أو مرض أو حبس فلينحر مثلها وقد حل ) )(@)(@@) ( طب ) عن ابن عباس وأبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 22985 ) قال النبي :(@)(@@) | 30 ( من كسا وليا لله ثوبا كساه الله من خضر الجنة ، ومن أطعمه على جوع أطعمه الله من ثمار الجنة ، ومن سقاه على ظمأ سقاه الله من الرحيق المختوم يوم القيامة ) )(@)(@@) ابن عساكر عن 
ms2475	 ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22986 ) قال النبي :(@)(@@) | 30 ( من كسا مسلما ثوبا كان في حفظ الله عز وجل ما بقي عليه منه خرقة ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22987 ) قال النبي :(@)(@@) | 30 ( من كسا مسلما ثوبا لم يزل في ستر الله ما دام عليه منه خيط أو سلك ) )(@)(@@) ( ك ) وتعقب و أبو الشيخ عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22988 ) قال النبي :(@)(@@) | 30 ( من كسا مؤمنا على عري كساه الله تعالى من استبرق الجنة ) )(@)(@@) ابن أبي الدنيا في كتاب الإخوان عن أبي سعيد رضي الله عنه .(@)(@@) PageV07P366(@)(@@)(@@)(@@) $ ( 22989 ) قال النبي :(@)(@@) | 30 ( من كسب مالا من حرام فأعتق منه ووصل منه رحمه كان ذالك إصرا ) )(@)(@@) ( طب ) عن أبي الطفيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22990 ) قال النبي :(@)(@@) | 30 ( من كشف امرأة فنظر إلى عورتها فقد وجب الصداق ) )(@)(@@) ( هق ) عن محمد بن ثوبان مرسلا .(@)(@@)(@@)(@@) $ ( 22991 ) قال النبي :(@)(@@) | 30 ( من كشف عورة امرأة فقد وجب عليها صداقها ) )(@)(@@) أبو نعيم في المعرفة عن محمد بن عبد الرحمان مولى رسول الله قال ذكره ابن جعفري حضري من الصحابة وهو عندي غير متصل أراه ابن السلمان ، قلت : وقد سبق من رواية ( هق ) أنه محمد بن عبد الرحمان بن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22992 ) قال النبي :(@)(@@) | 30 ( من كظم غيظه وهو يقدر على أن ينتصر دعاه الله تعالى على رءوس الخلائق حتى يخيره في حور العين أيتهن شاء ، ومن ترك أن يلبس صالح الثياب وهو يقدر عليه تواضعا لله دعاه الله على رءوس الخلائق حتى يخيره في حلل الإيمان أيتهن شاء ) )(@)(@@) ( حم ) عن معاذ عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22993 ) قال النبي :(@)(@@) | 30 ( من كظم غيظا وهو قادر على إنفاذه خيره الله من الحور العين يوم القيامة ، ومن ترك ثوب جمالة وهو قادر عليه ألبسه برد الإيمان يوم القيامة ، ومن أنكح عبدا لله وضع الله على رأسه تاج الملك يوم القيامة ) )(@)(@@) ( طب حل ) و ابن عساكر عن سهل بن معاذ بن أنس عن أبيه .(@)(@@)(@@)(@@) $ ( 22994 ) قال 
ms2476	 النبي :(@)(@@) | 30 ( من كظم غيظا ولو شاء أن يمضيه أمضاه ملأ الله قلبه يوم القيامة رضى ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22995 ) قال النبي :(@)(@@) | 30 ( من كف غضبه كف الله عنه عذابه ، ومن اعتذر PageV07P367 إلى ربه قبل الله منه عذره ، ومن خزن لسانه ستر الله عورته ) )(@)(@@) ابن أبي الدنيا في ذم الغضب ( ع ) وابن شاهين والخرائطي في مساوىء الأخلاق ، ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22996 ) قال النبي :(@)(@@) | 30 ( من كف لسانه ستر الله عورته ، ومن ملك غضبه وقاه الله عذابه ، ومن اعتذر إلى ربه قبل الله عذره ) )(@)(@@) ابن أبي الدنيا عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22997 ) قال النبي :(@)(@@) | 30 ( من كف غضبه ، وبسط رضاه ، وبذل معروفه ، ووصل رحمه ، وأدى أمانته ، أدخله الله عز وجل يوم القيامة في نوره الأعظم ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22998 ) قال النبي :(@)(@@) | 30 ( من كف لسانه عن أعراض المسلمين أقال الله عثرته يوم القيامة ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22999 ) قال النبي :(@)(@@) | 30 ( من كفر أخاه فقد باء به أحدهما ) )(@)(@@) الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23000 ) قال النبي :(@)(@@) | 30 ( من كفل يتيما له أو لغيره وجبت له الجنة إلا أن يكون عمل عملا لا يغفر ، ومن ذهبت بكريمتيه وجبت له الجنة إلا أن يكون عمل عملا لا يغفر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23001 ) قال النبي :(@)(@@) | 30 ( من كفل يتيما له أو لغيره من الناس كنت أنا وهو في الجنة كهاتين ) )(@)(@@) ( طب ) عن أم سعد بنت عمرو الجمحية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 23002 ) قال النبي :(@)(@@) | 30 ( من كفل يتيما من بين المسلمين يلي طعامه وشرابه حتى يغنيه الله أوجب الله له الجنة البتة إلا أن يعمل عملا لا يغفر له ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P368(@)(@@)(@@)(@@) $ ( 23003 ) قال النبي :(@)(@@) | 30 ( من كنت مولاه فعلي مولاه ، اللهم وال من والاه ، وعاد من عاداه ) )(@)(@@) ( طب ) عن ابن عمر ، ( ش 
ms2477	 ) عن أبي هريرة واثني عشر رجلا من الصحابة ، ( حم طب ض ) عن أبي أيوب وجمع من الصحابة ، ( ك ) عن علي وطلحة ، ( حم طب ض ) عن علي وزيد بن أرقم وثلاثين رجلا من الصحابة ، أبو نعيم في فضائل الصحابة عن سعد ، الخطيب عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 23004 ) قال النبي :(@)(@@) | 30 ( من كنت مولاه فعلي مولاه ، اللهم وال من والاه ، وعاد من عاداه ، وأعز من نصره ، وأعن من أعانه ) )(@)(@@) ( طب ) عن عمرو بن مرة وزيد بن أرقم رضي الله عنه معا .(@)(@@)(@@)(@@) $ ( 23005 ) قال النبي :(@)(@@) | 30 ( من كن له ثلاث بنات يمولهن ويرحمهن ويكفلهن وجبت له الجنة البتة ، قيل : يا رسول الله ! وإن كن اثنتين ؟ قال : وإن كن اثنتين ) )(@)(@@) ( حم ) و ابن منيع ، ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23006 ) قال النبي :(@)(@@) | 30 ( من كن له ثلاث بنات فصبر على لأوائهن وضرائهن وسرائهن أدخله الله الجنة برحمته إياهن ، قيل : واثنتان ؟ قال : واثنتان ، قيل : وواحدة ؟ قال : وواحدة ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23007 ) قال النبي :(@)(@@) | 30 ( من كن له ثلاث بنات فعالهن وآواهن وكفاهن وجبت له الجنة ، قيل : واثنتين ؟ قال : واثنتين ، قيل : وواحدة ؟ قال : وواحدة ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23008 ) قال النبي :(@)(@@) | 30 ( من لاأمكم من خدمكم فأطعموهم مما تأكلون ، PageV07P369 وألبسوهم مما تلبسون ، ومن لا يلائمكم منهم فبيعوه ولا تعذبوا خلق الله عز وجل ) )(@)(@@) ( حم د هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23009 ) قال النبي :(@)(@@) | 30 ( من لبد رأسه للإحرام فقد وجب عليه الحلاق ) )(@)(@@) ( عد هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23010 ) قال النبي :(@)(@@) | 30 ( من لبس ثوبا فقال : الحمد لله الذي كساني هاذا ورزقنيه من غير حول مني ولا قوة ، غفر الله له ما تقدم من ذنبه ) )(@)(@@) ابن السني عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23011 ) قال النبي :(@)(@@) | 30 ( من لبس الذهب من أمتي فمات وهو يلبسه حرم الله عليه ذهب الجنة ، ومن لبس الحرير من أمتي فمات وهو يلبسه حرم الله عليه حرير 
ms2478	 الجنة ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23012 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير في الدنيا لم يلبسه في الآخرة ) )(@)(@@) ( ط حم خ م ت ن ) و أبو عوانة والطحاوي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23013 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير والديباج في الدنيا لم يلبسه في الآخرة ، ومن شرب في آنية الذهب والفضة في الدنيا لم يشرب فيهما في الآخرة ) )(@)(@@) الساسي ( ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23014 ) قال النبي :(@)(@@) | 30 ( من كذب في رؤياه كلف أن يعقد بين طرفي شعيرة ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23015 ) قال النبي :(@)(@@) | 30 ( من كذب في رؤياه أعطي شعيرة وكلف أن يعقد PageV07P370 بين طرفيها فيعذب أن يعقد بين طرفيها ولن يعقد بين طرفيها أبدا ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23016 ) قال النبي :(@)(@@) | 30 ( من لبس ثوب حرير ألبسه الله ثوبا من نار ) )(@)(@@) ( م ح خ م ن ) عن الزبير ، ( حم ) عن أبي سعيد ، ( طب ) عن ابن مسعود ، ( م ) عن أبي أمامة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 23017 ) قال النبي :(@)(@@) | 30 ( من لبس ثوب شهرة في الدنيا ألبسه الله تعالى ثوب مذلة يوم القيامة ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23018 ) قال النبي :(@)(@@) | 30 ( من لبس الصوف ، أو حلب الشاة ، أو أكل مع ما ملكت يميه فليس في قلبه إن شاء الله الكبر ) )(@)(@@) ( طب ) عن السائب بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23019 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير في الدنيا لم يلبسه في الآخرة ، وإن دخل الجنة لبسه أهل الجنة ولم يلبسه هو ) )(@)(@@) ( ط ) و الطحاوي ، ( حب ك ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23020 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير وشرب في الفضة فليس منا ، ومن خبب امرأة على زوجها ، أو عبدا على مواليه فليس منا ) )(@)(@@) ( طب حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23021 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير في الدنيا حرمه أن يلبسه في الآخرة ) )(@)(@@) ( حم طب ) عن عقبة بن عامر 
ms2479	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23022 ) قال النبي :(@)(@@) | 30 ( من لبس الحرير في الدنيا لم يكسه في الآخرة ، PageV07P371 ومن شرب الخمر في الدنيا لم يشربه في الآخرة ، ومن شرب في آنية الذهب والفضة لم يشرب بها في الآخرة ، لباس أهل الجنة ، وشراب أهل الجنة ، وآنية أهل الجنة ) )(@)(@@) ( ك كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23023 ) قال النبي :(@)(@@) | 30 ( من لبس الصوف وانتعل المخصوف ، وركب حماره ، وحلب شاته ، وأكل معه عياله فقد نحى الله عنه الكبر ، أنا عبذ ابن عبد ، أجلس جلسة العبد ، وآكل أكل العبد ، إني قد أوحي إلي أن تواضعوا ، ولا يبغي أحد على أحد ، إن يد الله مبسوطة في خلقه ، فمن رفع نفسه وضعه الله ، ومن وضع نفسه رفعه الله ، ولا يمشي امرؤ على الأرض شبرا يبتغي به سلطانا لله إلا كبه الله ) )(@)(@@) تمام وابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23024 ) قال النبي :(@)(@@) | 30 ( من لبس مشهورا من الثياب أعرض الله عنه يوم القيامة ) )(@)(@@) ( طب ) عن أبي سعيد التيمي عن الحسن والحسين رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 23025 ) قال النبي :(@)(@@) | 30 ( من لبس ثوبا يباهي به ليراه الناس لم ينظر الله إليه حتى ينزعه ) )(@)(@@) ( طب ) و تمام وابن عساكر عن أم سلمة رضي الله عنها وضعف .(@)(@@)(@@)(@@) $ ( 23026 ) قال النبي :(@)(@@) | 30 ( من لزمه مات قبل أن يصيبه جهد من بلاء ، اللهم أحسن عاقبتنا في الأمور كلها وأجرنا من خزي الدنيا وعذاب الآخرة ) )(@)(@@) ( عد ) عن بشر بن أرطاة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23027 ) قال النبي :(@)(@@) | 30 ( من لعب بالكعاب فقد عصى الله ورسوله ) )(@)(@@) ( حم ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23028 ) قال النبي :(@)(@@) | 30 ( من لعب بالميسر ثم قام يصلي ، مثله كمثل الذي يتوضأ بالقيح ودم الخنزير ، فلا يقبل الله له صلاته ؟ ) )(@)(@@) ( طب ) عن PageV07P372 أبي عبد الرحمان الخطمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23029 ) قال النبي :(@)(@@) | 30 ( من لقن لا إلاه إلا الله عند الموتة دخل الجنة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما ، ( طب ) عن عطاء ابن السائب عن أبيه عن 
ms2480	 جده .(@)(@@)(@@)(@@) $ ( 23030 ) قال النبي :(@)(@@) | 30 ( من لقي الله وهو يشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، وآمن بالبعث والحساب دخل الجنة ) )(@)(@@) ( ن ) و البغوي وابن عساكر عن أبي سلمى راعي رسول الله .(@)(@@)(@@)(@@) $ ( 23031 ) قال النبي :(@)(@@) | 30 ( من لقي الله لا يشرك به شيئا دخل الجنة ، ومن لقي الله يشرك به شيئا دخل النار ) )(@)(@@) ( هب ) و ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23032 ) قال النبي :(@)(@@) | 30 ( من لقي الله بخمس عوفي من النار وأدخل الجنة : الحمد لله ، وسبحان الله ، ولا إلاه إلا الله ، والله أكبر ، وولد محتسب ) )(@)(@@) الباوردي عن الحسحاس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23033 ) قال النبي :(@)(@@) | 30 ( من لقي الله لا يشرك به شيئا ، يصلي الخمس ، ويصوم رمضان غفر له ) )(@)(@@) ( حم ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23034 ) قال النبي :(@)(@@) | 30 ( من لقي الله وهو لا يشرك به شيئا دخل الجنة ولم تضره معه خطيئة ، كما لو لقيه وهو يشرك به دخل النار ولم تنفعه معه حسنة ) )(@)(@@) ( حم طب ) عن ابن عمرو رضي الله عنهما وصحح .(@)(@@)(@@)(@@) $ ( 23035 ) قال النبي :(@)(@@) | 30 ( من لقي الله لا يشرك به شيئا ، ولا يقتل نفسا ، لقي الله وهو خفيف الظهر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P373(@)(@@)(@@)(@@) $ ( 23036 ) قال النبي :(@)(@@) | 30 ( من لقي الله يوم القيامة بالصلوات الخمس ، وصيام رمضان ، والاغتسال من الجنابة كان عبد الله حقا ، ومن اختان منهن شيئا كان عدو الله حقا ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 23037 ) قال النبي :(@)(@@) | 30 ( من لقي الله لا يشرك به شيئا ، وأدى زكاة ماله طيبة بها نفسه محتسبا ، وسمع وأطاع فله الجنة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23038 ) قال النبي :(@)(@@) | 30 ( من لقي أخاه فليسلم عليه ، وإن حالت بينهما شجرة أو حائط أو حجر ثم لقيه فليسلم عليه ) )(@)(@@) ( طب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23039 ) قال النبي :(@)(@@) | 30 ( من لقي الله ولم يعمل بست خلال دخل الجنة : من لقي الله ولم يشرك به شيئا ، ولم يسرق ، ولم 