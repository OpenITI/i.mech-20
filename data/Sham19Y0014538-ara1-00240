ms221	 أويس(@)(@)(@@) (¬4)(@)(@@) صدوق وليس بحجة.(@)(@)(@@)(@@)(@@) || AUTO 967 - وأبو الحويرث(@)(@)(@@) (¬5)(@)(@@) ليس يحتج بحديثه.(@)(@)PageV02P368(@)(@)(@@)(@@)(@@) || AUTO 968 - والبكائى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وقد كتبت عنه المغازى.(@)(@)(@@)(@@)(@@) || AUTO 969 - وأبو الحفص العبدى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 970 - والكلبى(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 971 - وأبو مريم الكوفى(@)(@)(@@) (¬4)(@)(@@) ليس بشئ. وأبو مريم، اسمه: عبد الغفار بن القاسم، وليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 972 - وأبو مخنف(@)(@)(@@) (¬5) PageV02P369(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 973 - والوقاصى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وهو عثمان بن عبد الرحمن.(@)(@)(@@)(@@)(@@) || AUTO 974 - وابن أبى روق(@)(@)(@@) (¬2)(@)(@@) قد رأيته وليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 975 - ابن هارون بن عنترة(@)(@)(@@) (¬3)(@)(@@) كذاب، وهارون بن عنترة كنيته: أبو عمرو.(@)(@)(@@)(@@)(@@) || AUTO 976 - وأبو سفيان السعدى(@)(@)(@@) (¬4)(@)(@)PageV02P370(@)(@)(@@)(@@)(@@) || CHECK 981 - وأبو كامل محمد بن طلحة(@)(@)(@@) اسمه طريف وهو ضعيف، روى عنه شريك، وأبو معاوية ومروان الفزارى.(@)(@)(@@)(@@)(@@) || AUTO 977 - وأبو يحيي القتات(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 978 - وأبو هانى مولى الشعبى(@)(@)(@@) (¬2)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 979 - والوصافى(@)(@)(@@) (¬3)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 980 - محمد بن طلحة(@)(@)(@@) (¬4)(@)(@@) [قال] (¬5) أبو كامل: محمد بن طلحة ليس بشئ.(@)(@)(@@) 981 - وأبو كامل (¬6) محمد بن طلحة(@)(@@) ليس بشئ.(@)(@)PageV02P371(@)(@)(@@)(@@)(@@) || AUTO 982 - وأبو بردة(@)(@)(@@) (¬1)(@)(@@) الذى يحدث عنه محمد بن الصلت، أو قال: يحدث محمد بن الصلت ليس حديثه بشئ، وليس هو من ولد أبى موسى.(@)(@@) وأبو بردة الذى يروى عنه أحمد بن يونس، ضعيف.(@)(@@) وأبو بردة الذى يروى عنه القواريرى، ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 983 - وأبو يحيى التيمى(@)(@)(@@) (¬2)(@)(@@) اسمه إسماعيل بن إبراهيم، وهو كوفى، يروى عنه أبو الجارود زياد بن المنذر، وليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 984 - وأبو الجارود زياد بن المنذر(@)(@)(@@) (¬3)(@)(@@) كذاب خبيث، يروى عنه الفزارى (¬4).(@)(@)(@@)(@@)(@@) || AUTO 985 - وأبو داود النخعى(@)(@)(@@) (¬5) PageV02P372(@)(@@) اسمه: سليمان بن عمرو، كان رجل سوء كذابا.(@)(@)(@@)(@@)(@@) || AUTO 986 - وأبو الفيض سالم(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ، روى عنه ابن إدريس.(@)(@)(@@)(@@)(@@) || AUTO 987 - وأبو قيس(@)(@)(@@) (¬2)(@)(@@) الذى روى عنه أبو معاوية، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 988 - وأبو سعد البقال(@)(@)(@@) (¬3)(@)(@@) هو سعيد بن المرزبان، حبان بن على (¬4) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 989 - وأبو عقيل(@)(@)(@@) (¬5)(@)(@@) اسمه: يحيى بن المتوكل، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 990 - وأبو بكر الهذلى(@)(@)(@@) (¬6)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 991 - وأبو أمية بن يعلى(@)(@)(@@) (¬7) PageV02P373(@)(@@) ليس بشئ. 
ms222	(@)(@)(@@)(@@)(@@) || AUTO 992 - وأبو جزى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وهو نصر بن راشد.(@)(@)(@@)(@@)(@@) || AUTO 993 - مولى أبى عوانة(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 994 - وأبو سهل محمد بن عمرو الأنصارى(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 995 - وأبو هرمز(@)(@)(@@) (¬4)(@)(@@) الذى يروى عن أنس بن مالك ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 996 - المزنى(@)(@)(@@) (¬5)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 997 - وأبو عامر الخزاز(@)(@)(@@) (¬6) PageV02P374(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 998 - وأبو عبيدة الناجى(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 999 - وأبو سفيان الصواف(@)(@)(@@) (¬2)(@)(@@) كان كذابا، وكان يقال له ابن رواحة.(@)(@)(@@)(@@)(@@) || AUTO 1000 - وأبو حتروش سلمة بن هزال(@)(@)(@@) (¬3)(@)(@@) بصرى، وليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1001 - وأبو بحر البكراوى(@)(@)(@@) (¬4)(@)(@@) ضعيف الحديث.(@)(@)PageV02P375(@)(@)(@@)(@@)(@@) || AUTO 1002 - وأبو هارون العبدى(@)(@)(@@) (¬1)(@)(@@) ليس بثقة. قال ابن المدينى: قيل لابن عون ما تقول فى أبى هارون العبدى؟ ، قال:(@)(@@) تركه عندنا شعبة.(@)(@)(@@)(@@)(@@) || AUTO 1003 - أبو المتوكل الناجى(@)(@)(@@) (¬2)(@)(@)(@@)(@@)(@@) || AUTO 1004 - وأبو الصديق الناجى(@)(@)(@@) (¬3)(@)(@@) ليس حديثهما بشئ.(@)(@@) فى حديثه ضعف.(@)(@)(@@)(@@)(@@) || AUTO 1005 - وأبو قدامة(@)(@)(@@) (¬4)(@)(@@) فى حديثه ضعف.(@)(@)(@@)(@@)(@@) || AUTO 1006 - أبو سفيان(@)(@)(@@) (¬5)(@)(@@) قال: وحديث أبى سفيان عن جابر إنما هى صحيفة.(@)(@)(@@)(@@)(@@) || AUTO 1007 - وأبو هدبة(@)(@)(@@) (¬6) PageV02P376(@)(@@) وأبو هدبة قدم فاجتمع عليه الخلق، فقالوا له: أخرج رجلك.(@)(@@) قال العباس: قيل ليحيى: لم قالوا له ذلك؟ ، قال: كانوا يخافون -أن تكون- رجله رجل حمار فيكون شيطانا.(@)(@)(@@)(@@)(@@) || AUTO 1008 - وأبو السرى(@)(@)(@@) (¬1)(@)(@@) اسمه ثابت، كان ابن إدريس لا يرضاه، وكان يحيى بن سعيد لا يروى عنه.(@)(@)(@@)(@@)(@@) || AUTO 1009 - أبو سعد الصغانى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1010 - وأبو علقمة(@)(@)(@@) (¬3)(@)(@@) ليس بشئ، كان يكون فى المسجد الجامع لا يفارقه، وليس هو أبا علقمة الفروى.(@)(@)(@@)(@@)(@@) || AUTO 1011 - وأبو الجنيد الضرير(@)(@)(@@) (¬4)(@)(@@) ليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 1012 - وأبو يوسف المدينى(@)(@)(@@) (¬5)(@)(@@) شيخ كان يحدث عن هشام بن عروة، ليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 1013 - والحبطى(@)(@)(@@) (¬6) PageV02P377(@)(@@) الذى كان جار الشهبى ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1014 - أبو الأشهب الكوفى(@)(@)(@@) (¬1)(@)(@@) ضعيف الحديث، روى عنه يزيد بن هارون، ومحمد بن سالم الواسطى.(@)(@)(@@)(@@)(@@) || AUTO 1015 - وأبو فروة الجزرى(@)(@)(@@) (¬2)(@)(@@) اسمه يزيد بن سنان، وقد روى عنه الكوفيون، وليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 1016 - وأبو بكر الداهرى(@)(@)(@@) (¬3)(@)(@@) الذى يحدث عنه عمرو بن عون الواسطى ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1017 - والأفريقى عبد الرحمن بن يزيد بن 
ms223	 أنعم(@)(@)(@@) (¬4)(@)(@@) فيه ضعف. قال: وهو أحب إلى من أبى بكر بن أبى مريم الغسانى.(@)(@)(@@)(@@)(@@) || AUTO 1018 - وأبو الغطريف الجزرى(@)(@)(@@) (¬5)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1019 - وأبو همدان(@)(@)(@@) (¬6)(@)(@@) كذاب، ومنزله هيت.(@)(@)PageV02P378(@)(@)(@@)(@@)(@@) || CHECK 1020 - الواقدي(@)(@)(@@) 1020 - الواقدى (¬1)(@)(@@) قال: والواقدى ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1021 - وأبو آدم(@)(@)(@@) (¬2)(@)(@@) ليس بثقة.(@)(@)(@@)(@@)(@@) || AUTO 1022 - أبو جابر البياضى(@)(@)(@@) (¬3)(@)(@@) قال ابن إسماعيل: عن أبى الأسود، عن يحيى قال: سألت مالكا عن أبى جابر البياضى، فقال: لم يكن يرضاه وهو محمد بن عبد الرحمن.(@)(@)(@@)(@@)(@@) || AUTO 1023 - أبو عمارة(@)(@)(@@) (¬4)(@)(@@) صاحب الزعفران ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 1024 - أبو الفيض(@)(@)(@@) (¬5)(@)(@@) قال ابن المدينى: قال يحيى: سمعته يقول: حدثنا أبو الفيض، وكان ممن رمى بيت الله بالمنجنيق.(@)(@)(@@)(@@)(@@) || AUTO 1025 - أبو الزبير(@)(@)(@@) (¬6)(@)(@@) قال صدقة: سمعت ابن عيينة يقول: حدثنا أيوب قال: حدثنا أبو الزبير وهو مكى تركه شعبة أصلا.(@)(@)(@@)(@@)(@@) || AUTO 1026 - أبو طالب(@)(@)(@@) (¬7)(@)(@@) قال ابن المدينى: قال يحيى: كان أبو طالب قد تغير، وكان يرمى بالقدر، ثم قال يحيى: بلغنى أنه تغير.(@)(@)(@@)(@@)(@@) || AUTO 1027 - أبو حمزة(@)(@)(@@) (¬8)(@)(@@) قال: وقلت لحيى: قال لكم أبو حمزة فى سماعه نحوا مما قال ميمون المرائى؟(@)(@)PageV02P379(@)(@)(@@) قال: نعم وأشد من ذلك. قلت: كيف؟ قال: فيه ما سمعته، ومنه ما حفظه بعضنا(@)(@@) عن بعض، ومنه ما لم نسمع حدثنا به أصحابنا.(@)(@)(@@)(@@)(@@) || AUTO 1028 - أبو داود الأعمى(@)(@)(@@) (¬1)(@)(@@) ابن حنبل: حدثنا يزيد، أخبرنا همام قال: دخل أبو داود الأعمى على قتادة، قال:(@)(@@) فقال له بعض القوم: إن هذا يزعم أنه لقى ثمانية عشر بدريا.(@)(@@) قال: فقال: هذا كان سائلا قبل الجارف لا يعرض فى شئ من هذا، فوالله ما حدثنا الحسن عن بدرى واحد مشافهة، ولا سعيد بن المسيب إلا عن سعد بن مالك.(@)(@@) * * *(@)(@)PageV02P380(@)(@)(@@)(@@)(@@) | AUTO 18 - باب فيه ذكر من رموه، بأنه من أهل البدع وأصحاب الأهواء(@)(@)(@@)(@@)(@@) || AUTO 1029 - ابن أبى نجيح(@)(@)(@@) (¬1)(@)(@@) حدثنى أبو على، عن العباس، عن يحيى بن معين قال: كان ابن أبى نجيح ثقة، وكان يرمى بالقدر، قال الكرابيسى: هو ممن يقول بالقدر.(@)(@@) قال على بن المدينى: قال يحيى بن سعيد: كان ابن 
ms224	 أبى نجيح معتزليا، قال: وكان من رؤوس الدعاة. قال الشافعى: حدثنا ابن علية فال: قدمت مكة فغلبتنا المعتزلة على ابن أبى نجيح.(@)(@)(@@)(@@)(@@) || AUTO 1030 - سيف بن سليمان(@)(@)(@@) (¬2)(@)(@)(@@)(@@)(@@) || AUTO 1031 - وزكريا بن إسحاق(@)(@)(@@) (¬3)(@)(@@) قال يحيى: سيف بن سليمان وزكريا بن إسحاق قدريان.(@)(@)(@@)(@@)(@@) || AUTO 1032 - إبراهيم بن أبى يحيى(@)(@)(@@) (¬4)(@)(@@) قال: وكان إبراهيم بن أبى يحيى رافضيا قدريا.(@)(@)(@@)(@@)(@@) || AUTO 1033 - ابن إسحاق(@)(@)(@@) (¬5)(@)(@@) قال العباس: قال رجل ليحيى: يصح أن ابن إسحاق كان يرى القدر؟ ، قال: نعم كان يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1034 - عبد الحميد بن جعفر(@)(@)(@@) (¬6) PageV02P381(@)(@@) قال: وعبد الحميد بن جعفر ثقة، وكان يرمى بالقدر.(@)(@)(@@)(@@)(@@) || AUTO 1035 - عائذ بن حبيب(@)(@)(@@) (¬1)(@)(@@) قال: وعائذ بن حبيب قد سمعت منه، وكان يقال: إنه زيدى، وكان مسجده ومسجد عبيد الله بن موسى واحدا، وكان عبيد الله لا يحدث [حتى] (¬2) يقوم عائذ.(@)(@)(@@)(@@)(@@) || AUTO 1036 - وأبو الصباح(@)(@)(@@) (¬3)(@)(@@) مرجئ روى عنه سفيان، ومسعر، وهشيم، وهو ثقة.(@)(@)(@@)(@@)(@@) || AUTO 1037 - هشام الدستوائى(@)(@)(@@) (¬4)(@)(@@) كان ممن يرى القدر ولا يدعو إليه، وكان لا يطفئ سراجه بالليل، فقالت له امرأته: إن هذا السراج يضر بنا، فقال لها: ويحك إنك إذا طفئتيه ذكرت ظلمة القبر فلم أتقار.(@)(@)(@@)(@@)(@@) || AUTO 1038 - عمران القطان(@)(@)(@@) (¬5)(@)(@@) قال: وكان عمران القطان يرى رأى الخوارج ولم يكن داعية.(@)(@)(@@)(@@)(@@) || AUTO 1039 - عوف(@)(@)(@@) (¬6)(@)(@@) قال: وكان عوف قدريا.(@)(@)(@@)(@@)(@@) || AUTO 1040 - عباد بن منصور(@)(@)(@@) (¬7)(@)(@@) وكان عباد بن منصور قدريا.(@)(@)PageV02P382(@)(@)(@@)(@@)(@@) || AUTO 1041 - قرط بن حريث(@)(@)(@@) (¬1)(@)(@@) قد كتبت عنه، وليس به بأس، ولكنه كان قدريا أتيناه إلى منزله فقال لنا: نزهوا الله عن هذه المعاصى دعانا إلى القدر، فخرجت وكان مولى لباهلة وكان يقوم لرجل من المحدثين حديثه - يعنى يخرج منه اللحن.(@)(@)(@@)(@@)(@@) || AUTO 1042 - الفضل الرقاشى(@)(@)(@@) (¬2)(@)(@@) كان رجل سوء قدرى.(@)(@)(@@)(@@)(@@) || AUTO 1043 - والحسن بن ذكوان(@)(@)(@@) (¬3)(@)(@@) قدرى، وكان يحيى بن سعيد القطان يروى عنه، وروى عنه الخفاف وابن المبارك.(@)(@)(@@)(@@)(@@) || AUTO 1044 - ثور بن يزيد(@)(@)(@@) (¬4)(@)(@@) وكان أزهر الحرازى، وأسد بن وداعة، وجماعة يجلسون فيشتمون على بن أبى طالب رضى الله عنه، وكان ثور بن يزيد يكون فى ناحية لا يشتمه فيجرون رجله. 
ms225	(@)(@)(@@)(@@)(@@) || AUTO 1045 - يحيى بن حمزة(@)(@)(@@) (¬5)(@)(@@) كان قاضى دمشق، وكان يرمى بالقدر.(@)(@)(@@)(@@)(@@) || AUTO 1046 - العلاء [بن] الحارث(@)(@)(@@) (¬6)(@)(@@) قال العباس: وقيل ليحيى العلاء الحارث فى حديثه شئ؟(@)(@@) قال: لا، ولكنه كان يرى القدر، ومات فى ولاية أبى العباس، إلى هاهنا عن يحيى بن سعيد.(@)(@)PageV02P383(@)(@)(@@)(@@)(@@) || AUTO 1047 - سعد بن إبرهيم(@)(@)(@@) (1)(@)(@@) قال محمد بن إدريس الشافعى: سمعت مالك بن أنس يقول: قدم غيلان المدينة فتكلم هو وربيعة، وحضرهما سعد بن إبراهيم، والصلت بن زيد حليف قريش، فلما تفرقوا قبل سعد بن إبراهيم مقالة غيلان وصوبها، وقبل الصلت مقالة ربيعة.(@)(@@) قال المخرمى: قلت لأحمد بن حنبل: مالك لا تروى عن سعد؟ فقال: سعد خير من مالك، سعد لا يسئل عنه.(@)(@)(@@)(@@)(@@) || AUTO 1048 - عبد الله بن أبى لبيد الثقفى(@)(@)(@@) (2)(@)(@@) قال الحميد: قال ابن عيينة: عبد الله بن أبى لبيد الثقفى، هو عبد الله بن عباد من أهل المدينة، وكان يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1049 - ابن أبى ذئب(@)(@)(@@) (3)(@)(@@) وقال محمد بن إدريس: سمعت مالك بن أنس يقول: لو برئ ابن أبى ذئب من القدر ما كان على ظهر الأرض أحد خيرا منه.(@)(@@) قال داود الأصفهانى فى كتابه: على الكرابيسى فى إكفار المتأولين ومن قال بالقدر.(@)(@)(@@)(@@)(@@) || AUTO 1050 - شريك بن عبد الله بن أبى نمر(@)(@)(@@) (4)(@)(@)(@@)(@@)(@@) || AUTO 1051 - وهمام بن يحيى(@)(@)(@@) (5)(@)(@)(@@)(@@)(@@) || AUTO 1052 - والحسن بن واصل(@)(@)(@@) (6)(@)(@)(@@)(@@)(@@) || AUTO 1053 - وهارون الأعور(@)(@)(@@) (7)(@)(@)(@@)(@@)(@@) || AUTO 1054 - وعمر الأبح(@)(@)(@@) (8)(@)(@)(@@)(@@)(@@) || AUTO 1055 - وروح بن عطاء بن أبى ميمونة وابنه(@)(@)(@@) (9)(@)(@)PageV02P384(@)(@)(@@)(@@)(@@) || AUTO 1056 - وصالح الناجى(@)(@)(@@) (1)(@)(@)(@@)(@@)(@@) || AUTO 1057 - والأشعث بن سعيد السمان(@)(@)(@@) (2)(@)(@)(@@)(@@)(@@) || AUTO 1058 - وعنبسة بن سعيد القطان(@)(@)(@@) (3)(@)(@)(@@)(@@)(@@) || AUTO 1059 - وطلق(@)(@)(@@) (4)(@)(@)(@@)(@@)(@@) || AUTO 1060 - وعمرو بن مرة(@)(@)(@@) (5)(@)(@)(@@)(@@)(@@) || AUTO 1061 - ومسعر بن كدام(@)(@)(@@) (6)(@)(@)(@@)(@@)(@@) || AUTO 1062 - ومهدى بن هلال(@)(@)(@@) (7)(@)(@)(@@)(@@)(@@) || AUTO 1063 - وعبد الرحمن بن إسحاق(@)(@)(@@) (8)(@)(@)(@@)(@@)(@@) || AUTO 1064 - والمنهال بن السراح(@)(@)(@@) (9)(@)(@)(@@)(@@)(@@) || AUTO 1065 - وعطاء بن سيار(@)(@)(@@) (10)(@)(@)(@@)(@@)(@@) || AUTO 1066 - وإبراهيم بن نافع(@)(@)(@@) (11)(@)(@)(@@)(@@)(@@) || AUTO 1067 - وأبو هلال الراسبى(@)(@)(@@) (12)(@)(@)(@@)(@@)(@@) || AUTO 1068 - ومحمد بن سليم(@)(@)(@@) (13)(@)(@)(@@)(@@)(@@) || AUTO 1069 - وعثمان بن مقسم اليزنى(@)(@)(@@) (14)(@)(@)(@@)(@@)(@@) || AUTO 1070 - أبو الأسود الديلى(@)(@)(@@) (15)(@)(@@) وقال يعقوب بن شيبة، عن إبراهيم بن المنذر الحزامى، قال: حدثنا 
ms226	 أبو ضمرة، عن(@)(@@) عبد الله بن عثمان: أول من تكلم فى القدر، أبو الأسود الديلى.(@)(@)(@@)(@@)(@@) || AUTO 1071 - محمد بن إسحاق(@)(@)(@@) (16)(@)(@)(@@)(@@)(@@) || AUTO 1072 - وعمرو بن دينار(@)(@)(@@) (17)(@)(@@) قال العلاء: عن يحيى بن معين، عن محمد بن إسحاق، وعمرو بين دينار قدريان.(@)(@)(@@)(@@)(@@) || AUTO 1073 - محمد بن إسحاق(@)(@)(@@) (18)(@)(@@) قال الدورى: قيل ليحيى: يصح أن محمد بن إسحاق كان يرى القدر؟ ، قال: نعم.(@)(@)PageV02P385(@)(@)(@@)(@@)(@@) || AUTO 1074 - زكريا بن إسحاق(@)(@)(@@) (1)(@)(@@) قال العباس: قال يحيى: زكريا بن إسحاق كان يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1075 - وهب بن منبه(@)(@)(@@) (2)(@)(@@) قال أحمد بن حنبل: كان وهب بن منبه متهم بشئ من القدر.(@)(@)(@@)(@@)(@@) || AUTO 1076 - الحسن(@)(@)(@@) (3)(@)(@@) قال. أيوب: ما أعيانى الحسن فى شئ ما أعيانى فى القدر حتى خوفته بالسلطان.(@)(@)(@@)(@@)(@@) || AUTO 1077 - قتادة(@)(@)(@@) (4)(@)(@@) قال يعقوب بن شيبة، عن على بن أبى هاشم، عن شعبة قال: قال قتادة: الأشياء كلها بقدر ما خلا المعاصى.(@)(@)(@@)(@@)(@@) || AUTO 1078 - عبادة بن صهيب(@)(@)(@@) (5)(@)(@@) قال الدورى: قال يحيى: كان عباد بن صهيب يرى القدر لم أكتب عنه شيئا.(@)(@)(@@)(@@)(@@) || AUTO 1079 - ابن يعمر(@)(@)(@@) (6)(@)(@@) وروى خلف بن أيوب البلخى، عن محمد بن أبان، عن علقمة بن يزيد، عن عبد الله ابن بريدة أنه قال: فى حديث جرى فيه ذكر ابن يعمر: وكان ابن يعمر اعترض فى شئ من القدر.(@)(@)(@@)(@@)(@@) || AUTO 1080 - ابن أبى عروبة(@)(@)(@@) (7)(@)(@@) قال ابن عيينة: قدم علينا ابن أبى عروبة، فخطب بالقدر، فقيل له: فقال: هذا رأى(@)(@@) ورأى صاحبى، ورأى صاحب صاحبى.(@)(@)(@@)(@@)(@@) || AUTO 1081 - أبان بن يزيد العطار(@)(@)(@@) (8)(@)(@@) قال الدورى: قال يحيى: كان أبان بن يزيد العطار يرمى بشئ من القدر.(@)(@)(@@)(@@)(@@) || AUTO 1082 - عبد الواحد بن زيد(@)(@)(@@) (9)(@)(@@) قال الدورى: قال يحيى: عبد الواحد بن زيد ليس بشئ. قيل للعباس: ما أنكر عليه؟ قال: كان قدريا داعية ليس لشئ غير ذلك.(@)(@)PageV02P386(@)(@)(@@)(@@)(@@) || AUTO 1083 - الأسود بن شيبان(@)(@)(@@) (1)(@)(@@) قال المخرمى: قال يحيى بن معين: كان الأسود بن شيبان عابدا، وكان يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1084 - عمران القصير(@)(@)(@@) (2)(@)(@@) قال ابن المدينى: قال يحيى بن سعيد: كان عمران القصير يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1085 - عبد الوارث 
ms227	(@)(@)(@@) (3)(@)(@@) فال المخرمى: وسمعت القواريرى يقول: كان عبد الوراث يرى الحديث فى القدر تم يقول: ما أرويه إلا ردا له.(@)(@)(@@)(@@)(@@) || AUTO 1086 - سفيان بن حبيب(@)(@)(@@) (4)(@)(@@) قال المخرمى: سمعت القواريرى يقول: كان سفيان بن حبيب يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1087 - أبو عبيدة الناجى(@)(@)(@@) (5)(@)(@@) قال العلاء عن يحيى بن معين: كان أبو عبيدة الناجى اسمه بكر بن الأسود وكان قدريا.(@)(@)(@@)(@@)(@@) || AUTO 1088 - غندر(@)(@)(@@) (6)(@)(@@) قال المخرمى: وسمعت القواريرى يقول: كان غندر يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1089 - عامر بن رباح(@)(@)(@@) (7)(@)(@@) قال ابن المدينى: سمعت يحيى بن سعيد يقول: كان عامر بن رباح صاحب عربية وكان ثبتا فأفسدوه بالقدر.(@)(@)(@@)(@@)(@@) || AUTO 1090 - عطاء بن أبى ميمونة(@)(@)(@@) (8)(@)(@@) قال العلاء: سمعت أحمد بن حنبل يقول: مات عطاء بن أبى ميمونة سنة الطاعون وكان يتهم بالقدر.(@)(@)PageV02P387(@)(@)(@@)(@@)(@@) || AUTO 1091 - الفضل بن يحيى الرقاشى(@)(@)(@@) (1)(@)(@@) قال العباس: قال يحيى: الفضل بن يحيى الرقاشى، يروى عنه حماد بن زيد، وهو من القدرية من رؤسائهم. قال: والفضل بن يزيد الرقاشى يرى القدر، أدرك عمر.(@)(@)(@@)(@@)(@@) || AUTO 1092 - سلام بن مسكين(@)(@)(@@) (2)(@)(@@) قال العباس: قال يحيى: سلام بن مسكين يرمى بشئ من القدر.(@)(@)(@@)(@@)(@@) || AUTO 1093 - العباس بن الفضل الأنصارى(@)(@)(@@) (3)(@)(@@) قال المخرمى: قال إبراهيم الهروى: كان العباس بن الفضل الأنصارى يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1094 - مكحول(@)(@)(@@) (4)(@)(@)(@@)(@@)(@@) || AUTO 1095 - والحسن(@)(@)(@@) (5)(@)(@@) قال يعقوب بن شيبة: قال أبو مسهر: حدثنا هقل بن زياد قال: سمعت الأوزاعى يقول: لا نعلم أحدا انتسب إلى القدر غير مكحول والحسن ولم يصح ذلك عندنا.(@)(@)(@@)(@@)(@@) || AUTO 1096 - ثور بن يزيد الأرخبى(@)(@)(@@) (6)(@)(@@) قال ابن المدينى عن ابن شداد: سمعت وكيعا يقول: كان ثور بن يزيد الأرخبى يرى القدر. قال: وسألت يحيى بن معين، عن ثور فقال: كان يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1097 - قتادة(@)(@)(@@) (7)(@)(@)(@@)(@@)(@@) || AUTO 1098 - والدستوائى(@)(@)(@@) (8)(@)(@)(@@)(@@)(@@) || AUTO 1099 - وسعيد(@)(@)(@@) (9)(@)(@)(@@)(@@)(@@) || AUTO 1100 - والحسن(@)(@)(@@) (10)(@)(@)(@@)(@@)(@@) || AUTO 1101 - وثور بن يزيد(@)(@)(@@) (11)(@)(@)(@@)(@@)(@@) || AUTO 1102 - وعثمان بن عطاء(@)(@)(@@) (12) PageV02P388(@)(@@) قال مكى بن إبراهيم البلخى: كلهم قدريون.(@)(@)(@@)(@@)(@@) || AUTO 1103 - أبو داود مسلم بن عمرو النخعى(@)(@)(@@) (1)(@)(@@) قال العباس: قال يحيى: أبو داود مسلم بن عمرو النخعى، كان قدريا.(@)(@)(@@)(@@)(@@) || AUTO 1104 - سعد 
ms228	 بن عبيدة(@)(@)(@@) (2)(@)(@@) وروى ابن إسماعيل قال: كان سعد بن عبيدة يرى رأى الخوارج.(@)(@)(@@)(@@)(@@) || AUTO 1105 - صالح بن إبراهيم الباهلى الدهان(@)(@)(@@) (3)(@)(@@) وقال: قال موسى بن إسماعيل: إن صالح بن إبراهيم الباهلى الدهان، كنيته أبو نوح(@)(@@) ويقال: إنه من الأباضية. وقال غيره: كنيته أبو الأزهر.(@)(@)(@@)(@@)(@@) || AUTO 1106 - عمر بن أبى زائدة(@)(@)(@@) (4)(@)(@@) قال ابن المدينى: قال يحيى: كان عمر بن أبى زائدة يرى القدر.(@)(@)(@@)(@@)(@@) || AUTO 1107 - أبو الشعثاء(@)(@)(@@) (5)(@)(@@) قال: وقال يحيى: قال عبد ربه بن راشد: كان أبو الشعثاء يختلف إلى جارة لنا أباضية.(@)(@)(@@)(@@)(@@) || AUTO 1108 - عمرو بن عبيد(@)(@)(@@) (6)(@)(@@) قال الكرابيسى: ومن القدرية عمرو بن عبيد، قال: وقد روى عنه الثورى، وابن عيينة، وهشيم، وابن علية، والناس. قال: وقال ابن عيينة: لم تر عينى مثله، وقد رأى التابعين.(@)(@@) قال: ومنهم الحسن، وقتادة، وسعيد بن أبى عروبة، وهشام الدستوائى، وعوف، وزكريا بن إسحاق، وشبل، وإبراهيم بن نافع، والماجشونى.(@)(@)(@@)(@@)(@@) || AUTO 1109 - جابر بن زيد(@)(@)(@@) (7)(@)(@)(@@)(@@)(@@) || AUTO 1110 - وصدقة بن يسار(@)(@)(@@) (8)(@)(@)PageV02P389(@)(@)(@@)(@@)(@@) || AUTO 1111 - وعمران بن حطان(@)(@)(@@) (1)(@)(@@) قال: وكان جابر بن زيد أباضيا وكذلك صدقة بن بشار، وكذلك عمران بن حطان، قال: وروى عنه ابن سيرين.(@)(@)(@@)(@@)(@@) || AUTO 1112 - إبراهيم بن أبى يحيى(@)(@)(@@) (2)(@)(@@) قال: وكان إبراهيم بن أبى يحيى سبعيا قدرئا، وكان قبل ذلك أباضيا.(@)(@)(@@)(@@)(@@) || AUTO 1113 - ثور(@)(@)(@@) (3)(@)(@@) قال: ورأى خارجة سفيان الثورى يجئ من عند ثور، فقال له: من أين جئت؟(@)(@@) قال: سلمت على هذا القدرى، فلما مات جعل يحدث عنه، فقال لخارجة: حدثنى ذاك القدرى.(@)(@)(@@)(@@)(@@) || AUTO 1114 - ابن أبى عروبة(@)(@)(@@) (4)(@)(@)(@@)(@@)(@@) || AUTO 1115 - هشام الدستوائى(@)(@)(@@) (5)(@)(@@) قال المكى: وكان ابن أبى عروبة، قيل له هشام الدستوائى فقال: كان قدريا.(@)(@)(@@)(@@)(@@) || AUTO 1116 - قتادة(@)(@)(@@) (6)(@)(@)(@@)(@@)(@@) || AUTO 1117 - ابن أبى رواد(@)(@)(@@) (7)(@)(@)(@@)(@@)(@@) || AUTO 1118 - عمر بن أبى ذر(@)(@)(@@) (8)(@)(@@) قال ابن المدينى: قلت ليحيى بن سعيد: إن عبد الرحمن يقول: اترك كل من كان رأسا فى البدعة يدعو إليها. فقال: كيف يصنع بقتادة؟ وكيف يصنع بابن أبى رواد؟ وعمر بن أبى ذر وعد من هؤلاء، ثم قال: إن ترك هذا الضرب ترك ناسا كثيرا.(@)(@)(@@)(@@)(@@) || AUTO 
