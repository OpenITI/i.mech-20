ms61	 بها أحمر ، ذو برنس ، % مختلق الذفرى ، شديد الحزام % 15(@)(@@) % أروع ، للدعوة مستعجل ، % لم يثنه الشان ، خفيف القيام % 16(@)(@@) % دع ذكرها ، وانم إلى جسرة ، % جلذية ، ذات مراح عقام % 17(@)(@@) % دفقة المشية ، زيافة ، % تهوي خنوفا في فضول الزمام % 18(@)(@@) % تحسبها مجنونة تغتلي ، % إذ لفع الآل رؤوس الإكام % 19(@)(@@) % قومي بنو النجار ، إذ أقبلت % شهباء ترمي أهلها بالقتام % 20(@)(@@) % لا نخذل الجار ولا نسلمال % % مولى ، ولا نخصم يوم الخصام % PageV01P274 21(@)(@@) % منا الذي يحمد معروفه ، % ويفرج اللزبة يوم الزحام % PageV01P275 البحر : طويل 1(@)(@@) % هل المجد إلا السودد العود والندى ، % وجاه الملوك ، واحتمال العظائم % 2(@)(@@) % نصرنا وآوينا النبي محمدا ، % على أنف راض من معد وراغم % 3(@)(@@) % بحي حريد أصله ، وذماره % بجابية الجولان ، وسط الأعاجم % 4(@)(@@) % نصرناه لما حل وسط رحالنا ، % بأسيافنا من كل باغ وظالم % 5(@)(@@) % جعلنا بنينا دونه ، وبناتنا ، % وطبنا له نفسا بفيء المغانم % 6(@)(@@) % ونحن ضربنا الناس ، حتى تتابعوا ، % على دينه ، بالمرهفات الصوارم % 7(@)(@@) % ونحن ولدنا من قريش عظيمها ، % ولدنا نبي الخير من آل هاشم % 8(@)(@@) % لنا الملك في الإشراك ، والسبق في الهدى % % ونصر النبي ، وابتناء المكارم % 9(@)(@@) % بني دارم لا تفخروا ، إن فخركم % يعود وبالا عند ذكر المكارم % 10(@)(@@) % هبلتم ! علينا تفخرون ، وأنتم % لنا خول من بين ظئر وخادم % PageV01P276 11(@)(@@) % فإن كنتم جئتم لحقن دمائكم ، % وأموالكم أن تقسموا في المقاسم % 12(@)(@@) % فلا تجعلوا لله ندا وأسلموا ، % ولا تلبسوا زيا كزي الأعاجم % 13(@)(@@) % وإلا أبحناكم وسقنا نساءكم ، % بضم القنا ، والمقربات الصلادم % 14(@)(@@) % وأفضل ما نلتم من المجد والعلى % % رادفتنا ، عند احتضار المواسم % PageV01P277 البحر : كامل تام 1(@)(@@) % إبك ، بكت عيناك ثم تبادرت % بدم يعل غروبها ، سجام % 2(@)(@@) % ماذا بكيت على الذين تتابعوا ، % هلا ذكرت مكارم الأقوام % 3(@)(@@) % وذكرت منا ماجدا ، ذا همة ، % سمح الخلائق ، ماجد الإقدام % 4(@)(@@) % أعني النبي ، أخا التكرم والندى ، % وأبر من يولي على الأقسام % 5(@)(@@) % فلمثله ، ولمثل ما يدعو له ، % كان الممدح ، ثم ، غير كهام % PageV01P278 البحر : بسيط تام 1(@)(@@) % ما بال عينك ، يا حسان ، لم تنم ، % ما إن تغمض ، إلا مؤثم القسم 
ms62	 % 2(@)(@@) % لم أحسب الشمس تبدو بالعشاء ، فقد % لاقيت شمسا تجلي ليلة الظلم % 3(@)(@@) % فرع النساء ، وفرع القوم والدها ، % أهل الجلالة ، والإيفاء بالذمم % 4(@)(@@) % لقد حلفت ، ولم تحلف على كذب ، % يابن الفريعة ، ما كلفت من أمم % PageV01P279 البحر : طويل 1(@)(@@) % ألين ، إذا لان العشير ، فإن تكن % به جنة ، فجنتي أنا أقدم % 2(@)(@@) % قريب ، بعيد خيره ، قبل شره ، % إذا طلبوا مني الغرامة أغرم % 3(@)(@@) % إذا مات منا سيد ساد مثله ، % رحيب الذراع بالسيادة ، خضرم % 4(@)(@@) % يجيب إلى الجلى ، ويحتضر الوغى ، % أخو ثقة يزداد خيرا ويكرم % PageV01P280 البحر : طويل 1(@)(@@) % تناولني كسرى ببؤسي ، ودونه % قفاف من الصمان ، فالمتثلم % 2(@)(@@) % ففجعني ، لا وفق الله أمره ، % بأبي ، وهاب ، قليل التجهم % 3(@)(@@) % لتعف مياه الحارثين ، وقد عفت % مياههما من كل حي عرمرم % 4(@)(@@) % وأقفر من حضاره ورد أهله ، % وكان يروي في قلال ، وحنتم % 5(@)(@@) % وقلت لعين بالجوبة يا اسلمي ، % نعم ثم لم تنطق ، ولم تتكلم % 6(@)(@@) % ديار ملوك قد أراهم بغبطة ، % زمان عمود الملك لم يتهدم % 7(@)(@@) % لعمري لحرث بين قف ورملة ، % ببرث علت أنهاره كل مخرم % 8(@)(@@) % لدى كل بنيان رفيع ، ومجلس % نشاوى ، وكأس أخلصت لم تصرم % 9(@)(@@) % أحب إلى حسان ، لو يستطيعه ، % من المرقصات ، من غفار وأسلم % PageV01P281 البحر : كامل تام 1(@)(@@) % الله أكرمنا بنصر نبيه ، % بونا أقام دعائم الإسلام % 2(@)(@@) % وبنا أعز نبيه وكتابه ، % وأعزنا بالضرب والإقدام % 3(@)(@@) % في كل معترك تطير سيوفنا % % فيه الجماجم عن فراخ الهام % 4(@)(@@) % ينتابنا جبريل في أبياتنا ، % بفرائض الإسلام ، والأحكام % 5(@)(@@) % يتلو علينا النور فيها محكما ، % قسما لعمرك ليس كالأقسام % 6(@)(@@) % فنكون أول مستحل حلاله ، % ومحرم لله كل حرام % 7(@)(@@) % نحن الخيار من البرية كلها ، % ونظامها ، وزمام كل زمام % 8(@)(@@) % الخائضو غمرات كل منية ، % والضامنون حوادث الأيام % 9(@)(@@) % والمبرمون قوى الأمور بعزمهم ، % والناقضون مرائر الأقوام % 10(@)(@@) % سائل أبا كرب ، وسائل تبعا ، % عنا ، وأهل العتر والأزلام % PageV01P282 11(@)(@@) % واسأل ذوي الألباب عن سرواتهم % % يوم العهين ، فحاجر ، فرؤام % 12(@)(@@) % إنا لنمنع من أردنا منعه ، % ونجود بالمعروف للمعتام % 13(@)(@@) % وترد عافية الخميس سيوفنا ، % ونقين 
ms63	 رأس الأصيد القمقام % 14(@)(@@) % ما زال وقع سيوفنا ورماحنا % % في كل يوم تجالد وترام % 15(@)(@@) % حتى تركنا الأرض حزنها ، % منظومة من خيلنا بنظام % 16(@)(@@) % ونجا أراهط أبعطوا ، ولو أنهم % % ثبتوا ، لما رجعوا إذا بسلام % 17(@)(@@) % فلئن فخرت بهم لمثل قديمهم % فخر اللبيب به على الأقوام % PageV01P283 البحر : كامل تام 1(@)(@@) % إن ابن جفنة من بقية معشر % لم يغذهم آباؤهم باللوم % 2(@)(@@) % لم ينسني بالشام ، إذ هو ربها ، % كلا ولا منتصرا بالروم % 3(@)(@@) % يعطي الجزيل ، ولا يراه عنده % % إلا كبعض عطية المذموم % 4(@)(@@) % وأتيته يوما ، فقرب مجلسي ، % وسقى فرواني من الخرطوم % PageV01P284 البحر : طويل 1(@)(@@) % لمن منزل عاف كأن رسومه % خياعيل ريط سابري مرسم % 2(@)(@@) % خلاء المبادي ما به غير ركد % ثلاث ، كأمثال الحمائم جثم % 3(@)(@@) % وغير شجيج ماثل حالف البلى ، % وغير بقايا كالسحيق المنمنم % 4(@)(@@) % تعل رياح الصيف بالي هشيمه ، % على ماثل كالحوض ، عاف ، مثلم % 5(@)(@@) % كسته سرابيل البلى بعد عهده ، % وجون سرى بالوابل المتهزم % 6(@)(@@) % وقد كان ذا أهل كبير وغبطة ، % إذا الحبل ، حبل الوصل ، لم يتصرم % 7(@)(@@) % وإذ نحن جيران كثير بغبطة ، % وإذ مضى من عيشنا لم يصرم % 8(@)(@@) % وكل حثيث الودق منبعق العرى ، % متى تزجه الريح اللواقح يسجم % 9(@)(@@) % ضعيف العرى دان من الأرض بركه % مسف كمثل الطود أكظم أسحم % 10(@)(@@) % فإن تك ليلى قد نأتك ديارها ، % وضنت بحاجات الفؤاد المتيم % PageV01P285 11(@)(@@) % وهمت بصرم الحبل بعد وصاله ، % وأصغت لقول الكاشح المتزعم % 12(@)(@@) % فما حبلها بالرث عندي ، ولا الذي % % يغيره نأي ، وإن لم تكلم % 13(@)(@@) % وما حبها لو وكلتني بوصله ، % ولو صرم الخلان ، بالمتصرم % 14(@)(@@) % لعمر أبيك الخير ما ضاع سركم % % لدي ، فتجزيني بعادا وتصرمي % % 15(@)(@@) % ولا ضقت ذرعا بالهوى إذ ضمنته ، % ولا كظ صدري بالحديث المكتم % 16(@)(@@) % ولا كان مما كان مما تقولوا % % علي ، ونثوا ، غير ظن مرجم % 17(@)(@@) % فإن كنت لما تخبرين ، فسائلي % % ذوي العلم عنا كي تنبي فتعلمي % % 18(@)(@@) % متى تسألي عنا تنبي بأننا % % كرام وأنا أهل عز مقدم % 19(@)(@@) % وأنا عرانين صقور ، مصالت ، % نهز قناة ، متنها 
ms64	 لم يوصم % 20(@)(@@) % لعمرك ما المعتر يأتي بلادنا % % لنمنعه بالضائع المتهضم % PageV01P286 21(@)(@@) % وما السيد الجبار ، حين يريدنا % % بكيد ، على أرماحنا بمحرم % 22(@)(@@) % ولا ضيفنا عند القرى بمدفع ، % وما جارنا في النائبات بمسلم % 23(@)(@@) % نبيح حمى ذي العز حين نكيده ، % ونحمي حمان بالوشيج المقوم % 24(@)(@@) % ونحن إذا لم يبرم الناس أمرهم ، % نكون على أمر من الحق مبرم % 25(@)(@@) % ولو وزنت رضوى بحلم سراتنا % % لمال برضوى حلمنا ويلملم % 26(@)(@@) % ونحن إذا ما الحرب حل صرارها ، % وجادت على الحلاب بالموت والدم % 27(@)(@@) % ولم يرج إلا كل أروع ماجد ، % شديد القوى ، ذي عزة وتكرم % 28(@)(@@) % نكون زمام القائدين إلى الوغى ، % إذا الفشل الرعديد لم يتقدم % 29(@)(@@) % فنحن كذاك ، الدهر ، ما هبت الصبا % % نعود على جهالهم بالتحلم % 30(@)(@@) % فلو فهموا ، أو وفقوا رشد أمرهم ، % لعدنا عليهم بعد بؤسى بأنعم % PageV01P287 31(@)(@@) % إنا إذا ما الأفق أمسى كأنما % % على حافتيه ممسيا لون عندم % 32(@)(@@) % لنطعم في المشتى ، ونطعن بالقنا ، % إذا الحرب عادت كالحريق المضرم % 33(@)(@@) % وتلقى لدى أبياتنا ، حين نجتدى ، % مجالس فيها كل كهل معمم % 34(@)(@@) % رفيع عماد البيت ، يستر عرضه ، % من الذم ، ميمون النقيبة خضرم % 35(@)(@@) % جواد على العلات ، رحب فناؤه ، % متى يسأل المعروف لا يتجهم % 36(@)(@@) % ضروب بأعجاز القداح إذا شتا ، % سريع إلى داعي الهياج ، مصمم % 37(@)(@@) % أشم طويل الساعدين سميذع ، % معيد قراع الدراعين ، مكلم % PageV01P288 البحر : طويل 1(@)(@@) % أعين ، ألا أبكي سيد الناس ، واسفحي % % بدمع فإن أنزفته فاسكبي الدما % % 2(@)(@@) % وبكي عظيم المشعرين وربها ، % على الناس ، معروف له ما تكلما % % 3(@)(@@) % فلو كان مجد يخلد اليوم واحدا % من الناس ، أبقى مجده اليوم مطعما % % 4(@)(@@) % أجرت رسول الله منهم ، فأصبحوا % % عبادك ما لبى ملب ، وأحرما % % 5(@)(@@) % فلو سئلت عنه معد بأسرها ، % وقحطان ، أو باقي بقية جرهما % % 6(@)(@@) % لقالوا : هو الموفي بخفرة جاره ، % وذمته يوما ، إذا ما تذمما % % 7(@)(@@) % فما تطلع الشمس المنيرة فوقهم ، % على مثله ، منهم أعز وأكرما % % 8(@)(@@) % إباء ، إذا يأبى ، وأكرم شيمة ، % وأنوم عن جار ، إذا الليل أظلما % % PageV01P289 البحر : كامل تام 1(@)(@@) % إني ، لعمر 
ms65	 أبيك ، شر من أبي ، % ولأنت خير من أبيك وأكرم % 2(@)(@@) % وبنوك نوكى ، كلهم ذو علة ، % ولأنت شر من بنيك وألأم % PageV01P290 البحر : طويل 1(@)(@@) % أبلغ بني عمرو بأن اخاهم % شراه امرؤ ، قد كان للشر لازما % % 2(@)(@@) % شراه زهير بن الأغر وجامع ، % وكانا قديما يركبان المحارما % % 3(@)(@@) % أجرتم ، فلما أن أجرتم غدرتم % وكنتم بأكناف الرجيع لهاذما % % 4(@)(@@) % فليت خبيبا لم تخنه أمانة ، % وليت خبيبا كان بالقوم عالما % % PageV01P291 البحر : وافر تام 1(@)(@@) % وصقعب والد لأبيك قين % لئيم ، حل في شعب الأروم % 2(@)(@@) % وبطن حباشة السوداء عدد ، % وسائل كل ذي حسب كريم % 3(@)(@@) % تسمون المغيرة ، وهو ظلم ، % وينسى ديسم الإسم القديم % PageV01P292 البحر : بسيط تام 1(@)(@@) % باهى ابن صقعب ، إذ أثرى ، بكلبته ، % قل لابن صقعب : أخف الشخص واكتتم % 2(@)(@@) % قل للوليد : متى سميت باسمك ذا ، % أم كان ديسم في الأسماء كالحلم % 3(@)(@@) % وإذ حباشة أم لا تسر بها ، % لا ناكح في الذرى زوجا ، ولم تئم % 4(@)(@@) % فالحق بقينك ، قين السوء ، إن له % كيرا بباب عجوز السوء ، لم يرم % 5(@)(@@) % تلكم مصانعكم في الدهر قد عرفت ، % ضرب النصال ، وحسن الرقع للبرم % PageV01P293 البحر : وافر تام 1(@)(@@) % لقد علمت بنو النجار أني % % أذود عن العشيرة بالحسام % 2(@)(@@) % وقد أبقيت في سهم علوبا % إلى يوم التغابن والخصام % 3(@)(@@) % فلا تفخر فقد غلبت قديما % عليك مشابه من آل حام % 4(@)(@@) % فلست إلى الذوائب من قصي ، % ولا في عز زهرة إذ تسامي % % 5(@)(@@) % ولا في الفرع من ابناء عمرو ، % ولا في فرع مخزوم الكرام % 6(@)(@@) % فأقصر عن هجاء بني قصي ، % فقد جربت وقع بني حرام % PageV01P294 البحر : وافر تام 1(@)(@@) % ألا إن ادعاء بني قصي ، % على من لا يناسبهم ، حرام % 2(@)(@@) % فإنك وادعاء بني قصي % لكالمجرى وليس له لجام % 3(@)(@@) % فلا تفخر ، فإن بني قصي % هم الرأس المقدم ، والسنام % 4(@)(@@) % وأهل الصيت والسورات قدما ، % مقدمها ، إذا نسب الكرام % 5(@)(@@) % هم أعطوا منازلها قريشا ، % بمكة ، وهي ليس لها نظام % 6(@)(@@) % فلا تفخر بقوم لست منهم ، % فإن قبيلك الهجن اللئام % 7(@)(@@) % إذا عد الأطايب 
ms66	 من قريش % تقاعدكم إلى المخزاة حام % 8(@)(@@) % قسامة أمكم ، إن تنسبوها % % إلى نسب فتأنفه الكرام % PageV01P295 البحر : متقارب تام 1(@)(@@) % سألت قريشا وقد خبروا ، % وكل قريش بكم عالم % 2(@)(@@) % فقالت قريش ، ولم يكذبوا ، % وقول قريش لكم لازم % 3(@)(@@) % عبيد قيون ، إذا حصلوا ، % أبوكم لدى كيره جاثم % 4(@)(@@) % فسائل هشاما ، إذا جئته ، % وخرقة ، عيب لكم دائم % 5(@)(@@) % أطبخ الإهالة أم حقنها ، % فأنفك من ريحها وارم % 6(@)(@@) % وجمرة عار لكم ثابت ، % فقلبك من ذكرها واجم % PageV01P296 البحر : بسيط تام 1(@)(@@) % نالت قريش ذرى العلياء ، فانخنثت % بنو المغيرة عن مجد اللهاميم % 2(@)(@@) % وافتخروا بأمور ، أهلها نفر ، % أحسابهم من قصي في الغلاصيم % 3(@)(@@) % بندوة من قصي كان ورثها ، % وباللواء ، وحجاب فخاقيم % % 4(@)(@@) % من جوهر من قريش فالتمس بدلا % منهم معانيق في الهيجا ، مقاديم % 5(@)(@@) % واترك مآثر قوم في بيوتهم ، % وافخر بمكرمة في بيت مخزوم % 6(@)(@@) % أو من بني شجع إن كنت ذا نسب % حر من القوم ، منسوب ، ومعلوم % 7(@)(@@) % هلا منعتم من المخزاة أمكم ، % عند الثنية من عمرو بن يحموم % 8(@)(@@) % بنو المغيرة فحش في نديهم ، % توارثوا الجهل ، بعد الكفر واللوم % PageV01P297 البحر : وافر تام 1(@)(@@) % لعمر أبي سمية ما أبالي % % أنب التيس أم نطقت جذام % 2(@)(@@) % إذا ما شاتهم ولدت تادوا : % أجدي ، تحت شاتك ، أم غلام ؟ % PageV01P298 البحر : وافر تام 1(@)(@@) % ألم تر أن طلحة من قريش % يعد من القماقمة الكرام % 2(@)(@@) % وكان أبوه ، بالبلقاء ، دهرا % يسوق الشول في جنح الظلام % 3(@)(@@) % هو الرجل الذي جلب ابن سعد % وعثمانا من البلد الشآم % 4(@)(@@) % هو الرجل الذي حدثت عنه ، % غريب بين زمزم والمقام % PageV01P299 البحر : وافر تام 1(@)(@@) % إذا ذكرت عقيلة بالمخازي ، إذا ذكرت عقيلة بالمخازي ، % تقنع من مخازيها اللئام % 2(@)(@@) % أبو صيفي الذي قد كان منها ، % ومخرمة الدعي المستهام % 3(@)(@@) % إذا شتموا بأمهم تولوا % % سراعا ما يبين لهم كلام % PageV01P300 البحر : طويل 1(@)(@@) % أبا لهب ! أبلغ بأن محمدا % سيعلو بما أدى ، وإ كنت راغما % % 2(@)(@@) % وإن كنت قد كذبته وخذلته % وحيدا ، وطاوعت الهجين الضراغما % % 3(@)(@@) % ولو كنت حرا في 
ms67	 أرومة هاشم ، % وفي سرها منهم منعت المظالما % % 4(@)(@@) % ولكن لحيانا أبوك ورثته ، % ومأوى الخنا منهم ، فدع عنك هاشما % % 5(@)(@@) % سمت هاشم للمكرمات وللعلى ، % وغودرت في كأب من اللؤم جاثما % % PageV01P301 البحر : بسيط تام 1(@)(@@) % من سره الموت صرفا لا مزاج له ، % فليأت مأسدة في دار عثمانا % % 2(@)(@@) % مستحقبي حلق الماذي ، قد سعفت % فوق المخاطم ، بيض زان أبدانا % % 3(@)(@@) % بل ليت شعري ، وليت الطير تخبرني % % ما كان شأن علي وابن عفانا % % 4(@)(@@) % ضحوا بأشمط عنوان السجود به % يقطع الليل تسبيحا وقرآنا % % 5(@)(@@) % لتسمعن وشيكا في ديارهم ، % الله أكبر ، يا ثارات عثمانا % % 6(@)(@@) % وقد رضيت بأهل الشأم زافرة ، % وبالأمير ، وبالإخوان إخوانا % % 7(@)(@@) % إني لمنهم ، وإن غابوا ، وإن شهدوا ، % حتى الممات ، وما سميت حسانا % % 8(@)(@@) % ويها فدى لكم أمي وما ولدت ، % قد ينفع الصبر في المكروه أحيانا % % 9(@)(@@) % شدوا السيوف بثني ، في مناطقكم ، % حتى يحين بها في الموت من حانا % % 10(@)(@@) % لعلكم أن تروا يوما بمغبطة ، % خليفة الله فيكم كالذي كانا % % PageV01P302 البحر : بسيط تام 1(@)(@@) % يا للرجال لدمع هاج بالسنن ، % إني عجبت لمن يبكي على الدمن % 2(@)(@@) % إني رأيت أمين الله مضطهدا ، % عثمان رهنا لدى الأجداث والكفن % 3(@)(@@) % يا قاتل الله قوما كان شأنهم % قتل الإمام الأمن المسلم الفطن % 4(@)(@@) % ما قاتلوه على ذنب ألم به ، % إلا الذي نطقوا زورا ولم يكن % 5(@)(@@) % إذا تذكرته فاضت بأربعة % عيني بدمع ، على الخدين ، محتتن % PageV01P303 البحر : وافر تام 1(@)(@@) % ومسترق النخامة مستكين % لوقع الكأس ، مختلس البيان % 2(@)(@@) % حلفت له بها حجت قريش % وكل مشعشع م الخمر آن % 3(@)(@@) % لتصطحبن ، وإن أعرضت عنها ، % ولو أني بحيبته سقاني % % 4(@)(@@) % فطافت طوفتين ، فقال : زدني ، % ودبت في الأخادع والبنان % 5(@)(@@) % فلم أعرف أخي حتى اصطبحنا % % ثلاثا ، فانبرى خذم العنان % 6(@)(@@) % فلان الصوت ، فانبسطت يداه ، % وكان كأنه في الغل عان % 7(@)(@@) % وراح ثيابه الأولى سواها ، % بلا بيع ، أميم ، ولا مهان % PageV01P304 البحر : طويل 1(@)(@@) % وممسك بصداع الرأس من سكر ، % ناديته وهو مغلوب ، ففداني % % 2(@)(@@) % لما صحا وتراخى العيش قلت له : % إن الحياة ، وإن 
ms68	 الموت مثلان % 3(@)(@@) % فاشرب من الخمر ما آتاك مشربه ، % واعلم بأن كل عيش صالح فان % PageV01P305 البحر : بسيط تام 1(@)(@@) % إما سألت ، فإنا معشر نجب ، إما سألت ، فإنا معشر نجب ، % الأزد نسبتنا ، والماء غسان % 2(@)(@@) % شم الأنوف ، لهم مجد ومكرمة ، % كانت لهم كجبال الطود أركان % PageV01P306 البحر : خفيف تام 1(@)(@@) % إن شرخ الشباب والشعر الأس % % ود ما لم يعاص كان جنونا % % 2(@)(@@) % ما التصابي على المشيب وقد قل % % بت من ذاك أظهرا وبطونا % % 3(@)(@@) % إن يكن غث من رقاش حديث ، % فبما نأكل الحديث سمينا % % 4(@)(@@) % وانتصينا نواصي اللهو يوما ، % وبعثنا جناتنا يجتنونا % % 5(@)(@@) % فجنونا جنى شهيا ، حليا ، % وقضوا جوعهم ، وما يأكلونا % % 6(@)(@@) % وأمين حدثته سر نفسي ، % فرعاه حفظ الأمين الأمينا % % 7(@)(@@) % مخمر سره ، إذا ما التقينا ، % ثلجت نفسه بإن لا أخونا % % PageV01P307 البحر : وافر تام 1(@)(@@) % وقد كنا نقول ، إذا رأينا % % لذي جسم يعد وذي بيان % 2(@)(@@) % كأنك ، أيها المعطى بيانا % وجسما ، من بني عبد المدان % PageV01P308 البحر : خفيف تام 1(@)(@@) % لمن الدار أوحشت بمعان ، % بين أعلى اليرموك ، فالخمان % 2(@)(@@) % فالقريات من بلاس فدار % يا ، فسكاء ، فالقصور الدواني % % 3(@)(@@) % فقفا جاسم ، فأودية الص % % فر ، مغنى قبائل وهجان % 4(@)(@@) % تلك دار العزيز ، بعد أنيس ، % وحلول عظيمة الأركان % 5(@)(@@) % ثكلت أمهم ، وقد ثكلتهم ، % يوم حلوا بحارث الجولان % 6(@)(@@) % قد دنا الفصح ، فالولائد ينظم % % ن سراعا أكلة المرجان % 7(@)(@@) % يجتنين الجادي في نقب الري % % ط ، عليها مجاسد الكتان % 8(@)(@@) % لم يعللن بالمغافر والصم % % غ وا نقف حنظل الشريان % 9(@)(@@) % ذاك مغنى من آل جفنة في الده % % ر ، وحق تعاقب الأزمان % 10(@)(@@) % قد أراني هناك ، حق مكين ، % عند ذي التاج مجلسي ومكاني % % PageV01P309 البحر : متقارب تام 1(@)(@@) % ويثرب تعلم أنا بها ، % إذا التبس الامر ، ميزانها % % 2(@)(@@) % ويثرب تعلم أنا بها ، % إذا قحط القطر ، نوءانها % % 3(@)(@@) % ويثرب تعلم أنا بها ، % إذا خافت الأوس ، جيرانها % % 4(@)(@@) % ويثرب تعلم أن النبي ، % ت عند الهزاهز ذلانها % % 5(@)(@@) % متى ترنا الأوس في بيضنا ، % نهز القنا ، تخب نيرانها % % 6(@)(@@) % وتعط القياد على رغمها ، % وينزل من 
ms69	 الهام عصيانها % % PageV01P310 البحر : بسيط تام 1(@)(@@) % إن سرك الغدر صرفا لا مزاج له ، % فأت الرجيع ، وسل عن دار لحيان % 2(@)(@@) % قوم تواصوا بأكل الجار كلهم ، % فخيرهم ، رجلا ، والتيس مثلان % 3(@)(@@) % لو ينطق التيس ذو الخصيين وسطهم ، % لكان ذا شرف فيهم وذا شان % PageV01P311 البحر : وافر تام 1(@)(@@) % ألا أبلغ أبا قيس رسولا ، % إذا ألقى لها سمعا تبين % 2(@)(@@) % نسيت الجسر يوم أبي عقيل ، % وعندك من وقائعنا يقين % 3(@)(@@) % فلست لحاصن إن لم تزركم % خلال الدور مشعلة طحون % 4(@)(@@) % يدين لها العزيز إذا رآها ، % ويهرب من مخافتها القطين % 5(@)(@@) % تشيب الناهد العذراء فيها ، % ويسقط من مخافتها الجنين % 6(@)(@@) % بعينيك القواضب حين تعلى % % بها الأبطال والهام السكون % 7(@)(@@) % تجود بأنفس الأبطال سجحا ، % وأنت بنفسك الخب الضنن % 8(@)(@@) % ولا وقر بسمعك حين تدعى % % ضحى إذ لا تجيب ولا تعين % 9(@)(@@) % ألم نترك مآتم معولات ، % لهن على سراتكم رنين % 10(@)(@@) % تشينهم ، زعمت ، بغير شيء ، % ونفسك لو علمت بهم تشين % PageV01P312 11(@)(@@) % قتلتم واحدا من بألف ، % هلا لله ذا الظفر المبين % 12(@)(@@) % وذلك أن ألفكم قليل % لواحدنا ، أجل أيضا ومين % 13(@)(@@) % فلا زلتم ، كما كنتم قديما ، % ولا زلنا كما كنا نكون % 14(@)(@@) % يطيف بكم من النجار قوم ، % كأسد الغاب ، مسكنها العرين % 15(@)(@@) % كأنا ، إذ نساميكم رجالا ، % جمال حين يجتلدون جون % 16(@)(@@) % ولن ترضى بهذا فاعلموه ، % معاشر أوس ، ما سمع الحنين % 17(@)(@@) % وقد أكرمتكم وسكنت عنكم ، % سراة الأوس ، لو نفع السكون % 18(@)(@@) % حياء أن أشاتمكم ، وصونا % لعرضي ، إنه حسب سمين % 19(@)(@@) % وأكرمت النساء ، وقلت رهطي ، % وهذا حين أنطق ، أو أبين % PageV01P313 البحر : كامل تام 1(@)(@@) % يا راكبا إما عرضت فبلغن % عبد المدان ، وجل آل قيان % 2(@)(@@) % قد كنت أحسب أن أصلي أصلكم ، % حتى أمرتم عبدكم ، فهجاني % % 3(@)(@@) % فتوقعوا سبل العذاب عليكم ، % مما يمر على الروي لساني % % 4(@)(@@) % فلأذكرن بني رميمة كلهم % وبني الحصين بخزية وهوان % 5(@)(@@) % ولتعرفن قلائدي برقابكم ، % كالوشم لا تبلى على الحدثان % 6(@)(@@) % أبني الحماس ، فما أقول لثلة ، % ترعى البقاع ، خبيثة الأوطان % 7(@)(@@) % أين المال ، بني الحماس 
ms70	 ، إذا ذكت % بهجائكم ، متشنعا ، نيراني % % PageV01P314 البحر : وافر تام 1(@)(@@) % ألا أبلغ بني الديان عني % % مغلغلة ، ورهط بني قيان % 2(@)(@@) % وأبلغ كل منتخب هواء ، % رحيب الجوف ، من عبد المدان % 3(@)(@@) % ميامس غزة ، ورماح غاب ، % خفاف ، لا تقوم بها اليدان % 4(@)(@@) % تفاقدتم ! علام هجوتموني ، % ولم أظلم ، ولم أخلس بياني % % PageV01P315 البحر : متقارب تام 1(@)(@@) % إذا ما ترعرع فينا الغلام ، % فما إن يقال له من هوه % 2(@)(@@) % فقالت ثنه : فقال : إذا لم يسد قبل شد الإزار ، % فذلك فينا الذي لا هوه % 3(@)(@@) % ولي صاحب من بني الشيصبان ، % فطورا أقول ، وطورا هوه % PageV01P316 البحر : بسيط تام 1(@)(@@) % سقتم كنانة جهلا من عداوتكم ، % إلى الرسول ، فجند الله مخزيها % % 2(@)(@@) % أوردتموها حياض الموت ضاحية ، % فالنار موعدها ، والقتل لاقيها % % 3(@)(@@) % أنتم أحابيش ، جمعتم بلا نسب ، % أئمة الكفر ، غرتكم طواغيها % % 4(@)(@@) % هلا اعتبرتم بخيل الله ، إذ لقيت % أهل القليب ، ومن أردينه فيها % % 5(@)(@@) % كم من أسير فككناه بلا ثمن ، % وجز ناصية ، كنا مواليها % % PageV01P317 البحر : بسيط تام 1(@)(@@) % لو خلق اللؤم إنسانا يكلمهم ، % لكان خير هذيل حين يأتيها % % 2(@)(@@) % ترى من اللؤم رقما بين أعينهم ، % كما كوى أذرع العانات كاويها % % 3(@)(@@) % تبكي القبور ، إذا ما مات ميتهم ، % حتى يصيح بمن في الأرض داعيها % % 4(@)(@@) % مثل القنافذ تخزى أن تفاجئها ، % شد النهار ، ويلقى الليل ساريها % % PageV01P318 البحر : بسيط تام 1(@)(@@) % أبلغ هوازن أعلاها وأسفلها ، % أن لست هاجيها ، إلا بما فيها % % 2(@)(@@) % قبيلة ألأم الأحياء أكرمها ، % وأغدر الناس ، بالجيران ، وافيها % % 3(@)(@@) % وشر من يحضر الأمصار حاضرها ، % وشر بادية الأعراب باديها % % 4(@)(@@) % تبلى عظامهم إما هم دفنوا % % تحت التراب ، ولا تبلى مخازيها % % 5(@)(@@) % كأن أسنانهم ، من خبث طعمتهم ، % أظفار خاتنة كلت مواسيها % % PageV01P319 البحر : طويل 1(@)(@@) % ثوى في قريش ، بضع عشرة حجة ، % يذكر ، لو يلقى خليلا مؤاتيا % % 2(@)(@@) % ويعرض في أهل المواسم نفسه ، % فلم ير من يؤوي ، ولم ير داعيا % % 3(@)(@@) % فلما أتانا ، واطمأنت به النوى ، % فأصبح مسرورا ، بطيبة ، راضيا % % 4(@)(@@) % بذلنا له الأموال من جل مالنا ، % وأنفسنا ، عند الوغى ، والتآسيا % % 5(@)(@@) % نحارب من عادى من 
ms71	 الناس كلهم ، % جميعا ، وإن كان الحبيب المصافيا % % 6(@)(@@) % ونعلم أن الله لا رب غيره ، % وإن كتاب الله أصبح هاديا % % PageV01P320 البحر : - - 1(@)(@@) % أوصى أبونا مالك بوصاية % عمرا وعوفا ، إذ تجهز غاديا % % 2(@)(@@) % بأن اجعلوا أموالكم وسيوفكم % لأعراضكم ما سلم الله واقيا % % 3(@)(@@) % فقلنا له إذ قال ما قال : مرحبا ، % أمرت بمعروف وأوصيت كافيا % % PageV01P321 
