ms481	 وطرفها % % بالراسيات موكل الإشغال % PageV01P1487 11(@)(@@) % في الأرض تشخص للسماء كأنها % % عرفت ذراك من السماك العالي % % 12(@)(@@) % تلقى غزالتها بجيد غزالة % وهلالها من غرة بهلال % 13(@)(@@) % فسعى قبالك جده لا حاله % % عفو النفوس ولا اجتهاد المال % 14(@)(@@) % فلترغم الأيام زورة عاشق % هجر الكثير وزار غير التالي % % 15(@)(@@) % ولقد يكون من المحال بلوغها % % لولا تصرم دولة الإمحال % 16(@)(@@) % ولتيأس الآمال منى بعدها % % رؤياك كانت منتهى آمالي % % 17(@)(@@) % حول شفى حالي التي أشفت وقد % % تتقلب الأحوال بالأحوال % 18(@)(@@) % أنا من جذبت بضبعه فسقيته % % في البحر وهو مخادع بالآل % 19(@)(@@) % وخطبته فحظيت من أفكاره % % بغرائب نشزت على البذال % 20(@)(@@) % صينت زمانا في الخدور فعنست % وجمالها حي بحظ بالي % % PageV01P1488 21(@)(@@) % كم غادة منها رضت لمهرها % % منك القبول فشيد بالإفضال % 22(@)(@@) % وجميلة ذلت فحين رضيتها % % عادت تشوب جمالها بدلال % 23(@)(@@) % كرم يفيض على وصول رسائلي % % نعما فكيف يكون يوم وصالي % % 24(@)(@@) % والبحر ينضح للبعيد وكلما از % % داد الدنو ازداد فضل بلال % 25(@)(@@) % ولئن رأيتك بالصفات وبالذي % % أوليتني وبصالح الأعمال % 26(@)(@@) % فالنفس عند المعجزات بأن ترى % % أحرى وإن سكنت إلى النقال % 27(@)(@@) % لولا حظوظ في ذراك سمينة % ما جئت ملتحفا بجسم هزال % 28(@)(@@) % ولتهت في وادي الجليد فكيف بي % % ما خضت لولا أنه لمعالي % % 29(@)(@@) % وأري غني القوم أني فوقه % % مع خلتي أن صنت عنه سؤالي % % 30(@)(@@) % وأبيت مقتنعا بفضلة ما معي % % علما بشغل الحظ بالجهال % PageV01P1489 31(@)(@@) % متزملا بالصون أرقع دائبا % بالصبر من أثوابه الأسمال % 32(@)(@@) % حتى وددت لو أن حسن تصبري % % في نائبات الدهر أعدى حالي % % 33(@)(@@) % ولمثل غرتك الكريمة أن يرى % % حمل امرئ ما ليس بالحمال % 34(@)(@@) % فأقر جنب وهو غير ممهد % وأسيغ شرب وهو غير زلال % 35(@)(@@) % شكت الوزارة ذل منتحل اسمها % % لفظا وما الأسماء كالأفعال % 36(@)(@@) % لما تحلى الدست أصبح عاطلا % منه ودستك في التعطل حالي % % 37(@)(@@) % ركب الخطار مجربا لا عارفا % % يا قرب ركبته من الأوحال % 38(@)(@@) % وخلا فحدث باعتلاقك نفسه % % لما جريت وقد يسر الخالي % % 39(@)(@@) % فاعطف لها أو فاتخذ بدلا 
ms482	 بها الز % وراء حب لها من الأبدال % 40(@)(@@) % ولقد تحن إذا ذكرت عراصها % % شوق المعرة بشرت بالطالي % % PageV01P1490 41(@)(@@) % تصبو إليك وأهلها ورسولهم % % شعري وقد بلغت في الإرسال % 42(@)(@@) % ولقد تكون وإن نأيت أبا لهم % % برا بفاقتهم وأم عيال % 43(@)(@@) % وإذا سقى الغيث البلاد بمسبل % غدق وهتان الحيا هطال % 44(@)(@@) % فبدا بدارك ثم عاد فجادها % % جود الجفون غداة شد رحالي % % 45(@)(@@) % فاختص غزلانا هناك ووفرت % % منه العزالى قسطها لغزالي % % 46(@)(@@) % أفدي بنفسي من يجل مكانه % % في النفس أن أفديه بالأموال % 47(@)(@@) % قمرا أخذت على السهاد ذمامه % % إلا توقعه طروق خيالي % % 48(@)(@@) % وكفلت عنك له بأكرم أوبة % فسلا عن الإعجال بالإيجال % 49(@)(@@) % فاردد عليه كما يحب حبيبه % ضخم السلامة ناحل الأجمال % 50(@)(@@) % فالسيف يعلق بالأنامل حده % % والعين تأباه بغير صقال % PageV01P1491 51(@)(@@) % قد كان يأتيني قصيرا ناحلا % فنهضت أطلب منه حظ طوال % 52(@)(@@) % ولقد حلا فسعيت حتى حل لي % % ما كان يحلو طعمه بحلال % PageV01P1492 البحر : - 1(@)(@@) % أمن كل حظ قل قسمي أقله % وكل سبيل ضل قصدي أضله % 2(@)(@@) % وأي فتى أسكنت قلبي خالصا % % هواه بقلب غشه لي وغله % 3(@)(@@) % أقول غدا واليوم أشبه من غد % بما سرني واليوم ما ساء كله % 4(@)(@@) % وأغري بذم الدهر فيما ينوبني % % وشر من الدهر المذمم أهله % 5(@)(@@) % ظواهر مثل السيف راقك جفنه ال % % محلى وإن ضاربت خإنك نصله % 6(@)(@@) % فما قائل إلا من الماء قوله % ولا فاعل إلا من النار فعله % 7(@)(@@) % نجا سالما من قالب الحق غيبه % % وزاد له في صحبة الناس عقله % 8(@)(@@) % فرابته مما قد تبصر نفسه % % وأوحشه مما تحذر ظله % 9(@)(@@) % وكم صاحب منهم غرورا عقدته % % بنفسي وكف الغدر عني تحله % 10(@)(@@) % تكاثر عندي وفقه ثم خلفه % % إلى أن تساوى منعه لي وبذله % PageV01P1493 11(@)(@@) % إذا لم تجد إلا أخا قل نفعه % فكن واحدا يسليه أن قل شكله % 12(@)(@@) % وبت راضيا بالفقر فيهم وعزه % % إذا لم يكن إلا السؤال وذله % 13(@)(@@) % فإنك واستدعاء نصرك منهم % كطالب أعمى تائها يستدله % 14(@)(@@) % وكم طالب مدحي ليمنع 
ms483	 رفده % % فيهجي فيحي ذكره الميت بخله % 15(@)(@@) % فصاممته أن يبلغ الكي داءه % % بحيلته أو يلبس الوسم غفله % 16(@)(@@) % يقولون جار الدهر قلت وهمتم % يجور الذي قد كان يعرف عدله % 17(@)(@@) % ألا بأبي المسكين قصر حظه % على أنف فيه وبرز فضله % 18(@)(@@) % يموت إباء أن يعيش بغبطة % على غيره فيها من الناس كله % 19(@)(@@) % ويعتد شبعا مشيه طاوي الحشا % % إذا كان من كسب المذلة أكله % 20(@)(@@) % عدمتك دهرا غام فوق شراره % % فوابله فيهم خصوصا وطله % PageV01P1494 21(@)(@@) % وهجر بالأحرار إلا فتى له % % فتى من بني عبد الرحيم يظله % 22(@)(@@) % بقية مجد فيهم طاب نبته % وفرع سماح فيهم طاب أصله % 23(@)(@@) % تساموا بحق طارف نيل عزه % وفازوا بسبق تالد حيز خصله % 24(@)(@@) % فللعرب عقد الدين منهم وشده % % وللفرس عقد الرأي منهم وحله % 25(@)(@@) % فما ابن علي فيهم إن دعوته % لحادثة إلا الحسام تسله % 26(@)(@@) % قليل الرضا بالضيم لو بات وحده % % بمدرجة الأعداء عز محله % 27(@)(@@) % ثقيل على بطن الوسادة حلمه % خفيف على ظهر المطية حمله % 28(@)(@@) % كريم لو استبطاه ظام لغلة % تخيل ماء البحر ما لا يبله % 29(@)(@@) % إذا استكثر العافون فيض يمينه % جلا وجهه عن خجلة تستقله % 30(@)(@@) % أنخت به والظل عني محول % ونوء السماء قد تقلص حبله % PageV01P1495 31(@)(@@) % فكان أبي الأدنى وحالي يتيمة % ورشدي والتوفيق قد سد سبله % 32(@)(@@) % ولكن وعدا عين لما تخازرت % % على طوله زرق المطال وشهله % 33(@)(@@) % وسوف حتى مات عنه جريحه % وضاق على مأسوره فيك غله % 34(@)(@@) % وشر الأيادي يهرم الوعد والأذى % % بتأخيره ما شارف الحلم طفله % 35(@)(@@) % لعلك بالإنجاز مالك روحه % % عليه فقبل اليوم عندي مطله % 36(@)(@@) % فأن يك أمرا أشكلت طرقاته % فغيرك في أمثاله من أدله % 37(@)(@@) % وكم طمع في غير نصرك طاف بي % % فما زلت خوف المن عني أفله % 38(@)(@@) % وألقيته عن عاتقي متروحا % % ولم ألقه حتى تفاوت ثقله % 39(@)(@@) % لك الخير عتب من مدل حقوقه % % عليك تمنى أن سيقبل دله % 40(@)(@@) % يخيل من الأضحى مخايل مقبل % عليك به حشد السرور وحفله % % PageV01P1496 41(@)(@@) % يطل 
ms484	 دم الحساد حولك ما جرى % % دم في ثواب للأضاحي تطله % 42(@)(@@) % طويلا لك العمر الذي تستحبه % % إذا طول عمر المرء مما يمله % 43(@)(@@) % يمر عليك العام فالعام سالما % % فتختمه سعدا كما تستهله % PageV01P1497 البحر : - 1(@)(@@) % من ناصري والزمان لي خصم % ومنصفي والطبيعة الظلم % 2(@)(@@) % وعاذري من عزوف نفسي وال % % همة غصن ثماره الهم % 3(@)(@@) % في كل يوم سعي بلا ظفر % يقعد همي وينهض العزم % 4(@)(@@) % وحاجة في العلاء أطلبها % % عند غريم قضاؤه غرم % 5(@)(@@) % أركب منها شهب الأماني فتل % % قاني الليالي من دونها الدهم % 6(@)(@@) % ما أولع الدهر بالفسوق إذا % % قيل له في يمينك الحكم % 7(@)(@@) % كأنه يوم بر أقسم لا % % يكون فيه لفاضل قسم % 8(@)(@@) % أنظره يوما ترجع عوازبه % لكل منشورة العرى ضم % 9(@)(@@) % لا بد من نظرة محلقة % يمسح فيها بالراحة النجم % 10(@)(@@) % لأبلغن الذي الرغام به % % ينبئ أو فيه للعدا الرغم % PageV01P1498 11(@)(@@) % جبن الدجى مفرقا وجئن وللص % % بح عليه صوارم خذم % 12(@)(@@) % كأنها والفلا يموج بها % % سفائن جاش تحتها اليم % 13(@)(@@) % تحسب ركبانها تخب بهم % حمش عن الماء حلئت رثم % 14(@)(@@) % عن لها والشروع حيث ترى % % أشعث باقي قميصه رسم % 15(@)(@@) % أبو ثلاث بقاؤه أبدا % % لهن مع ضعف رزقه يتم % 16(@)(@@) % تطرحه راميا بمهجته % % في لهوات المخاوف العدم % 17(@)(@@) % بصيرة بالنفوس طاعتها % % على المنايا إذا مضت حتم % 18(@)(@@) % فاستل منها زرقاء تثبت في ال % % عظم بمتن كأنه العظم % 19(@)(@@) % لو لم يعقها الحرمان كان له % % وللأيامي في كسبها طعم % 20(@)(@@) % رمى فأشوى فانصعن جافلة % كأن مرآى شخوصها وصم % PageV01P1499 21(@)(@@) % يحفزها سائق عنيف من ال % % خوف وفحل سياطه العذم % 22(@)(@@) % تطيعه يوم خوفها وتعا % % صيه خلافا ودارها سلم % 23(@)(@@) % فهو لها قائد إذا انتشرت % % وال وتال غداة ينضم % 24(@)(@@) % تخطو بنا خطوها نجائب لا % % يحبسها بالعيافة السجم % 25(@)(@@) % تخابط التيهلا يشق لها % % ترب ولا يقتفى بها نجم % 26(@)(@@) % يامن رأى بالعقيق بارقة % تحسر منها الربى وتعتم % 27(@)(@@) % يقدح زند الجنوب جذوتها % % وسدفة الليل تحتها فحم % 28(@)(@@) % تبتسم الأرض وهي 
ms485	 كالحة % منها ثغور لها الحيا ظلم % 29(@)(@@) % يذكرني لمحها زمانا على ال % % خيف تقضى كأنه الحلم % 30(@)(@@) % هل لك بالنازلات دون منى % يا علم الشوق بعدنا علم % PageV01P1500 31(@)(@@) % كم وقفة لي على شراف وفي ال % % ترب عطار وفي الصبا سقم % 32(@)(@@) % جرت مع الرسم لي محاورة % فهمت منها ما قاله الرسم % 33(@)(@@) % كأن شعري أعدى معاهده % % فأعربت لي عراصها العجم % 34(@)(@@) % وباللوى ظبية مضى عدد ال % % حسن عليها فبدرها تم % 35(@)(@@) % رمت فما كذبت مقاتله % % سهمية لحظ عينها سهم % 36(@)(@@) % أطلب ود الأيام أظلمها % % وهل تسام الولادة العقم % 37(@)(@@) % كيف اعتذار الزمان من حرمة % في وفي نفسه له جرم % 38(@)(@@) % ليت كفاني الإخوان أنفسهم % % فلم يقوني الأذى ولم يرموا % % 39(@)(@@) % قد سمع الدهر واستجاب وأن % % صاري خرس عن دعوتي صم % 40(@)(@@) % ويدريني نبل الكلام فلا % % أصغي وفي أضلعي كلم % PageV01P1501 41(@)(@@) % ود الأعادي وقد نصبت لهم % % حلمي طودا لو أنهم عصم % 42(@)(@@) % أعرض سمعي فضاع لغوهم % رب سفاه أماته الحلم % 43(@)(@@) % يعجب للجهل كيف راخى لأق % % وام ودانى من خطوه الحزم % 44(@)(@@) % تحلو لقوم طعوم ما لهم % وليس للمال عنده طعم % 45(@)(@@) % تم وما ألقيت تمائمه % على رجال سادوا وما تموا % % 46(@)(@@) % واجتمع الطارف التليد له % % سن ثني وسؤدد هم % 47(@)(@@) % مستيقظ ظنه يقين إذا % % هوم قوم يقينهم رجم % 48(@)(@@) % حلو جناة اللسان مر الملا % % حات ضحوك عراكه جهم % 49(@)(@@) % جوهرة للصديق جندلة % على العدا لا يلينها العجم % % 50(@)(@@) % من خير قوم أبا وأكرمهم % % أما إذا عابت الأب الأم % PageV01P1502 51(@)(@@) % والمجد ما يستوي جوانبه % فيستوي الخال فيه والعم % 52(@)(@@) % تشتد ألفاظهم وتخدم أق % % لامهم السمهرية الصم % 53(@)(@@) % إذا انتحوا في عدوهم غرضا % % بالرأي أصموا من قبل أن يرموا % % 54(@)(@@) % تثنى الليالي بهم إذا جمحت % كأن أسماءهم لها لجم % 55(@)(@@) % لهم على كل دولة أثر % % كأنه في جبينها وسم % 56(@)(@@) % إن أخذوا بالذنوب مقترفا % % خصوا وأن أمطروا ندى عموا % % 57(@)(@@) % إذا أخيفوا رموا بخوفهم % وراء ما ألجموا وما زموا % % 58(@)(@@) % بيض المجاني 
ms486	 تأبى لهم سمة ال % % عار عرانين كالقنا شم % 59(@)(@@) % تطلع أزرارهم شموس ضحى % أهلة الليل فوقها التم % 60(@)(@@) % كل همام قرم إذا اختلفت % % ولادة المجد فابنه قرم % PageV01P1503 61(@)(@@) % مراقب الذكر قبل رؤيته % % مقبل قبل كفه الكم % 62(@)(@@) % أنت نصيبي من الزمان ومف % % تاح مناي الرغاب والختم % 63(@)(@@) % إن أنحلتني أيدي الخطوب ففي % % ثراك عزي ونبتى الضخم % 64(@)(@@) % عرفتني ساعة انتصابك لي % % والناس بلة عن قعدتي بكم % 65(@)(@@) % واخترتني قبل أن تسابق بي % % ولم يرضني الشكيم والحزم % 66(@)(@@) % فراسة تكتفي بلمحتها % % كالذئب يكفي اقتصاصه الشم % 67(@)(@@) % يفديك راضون من مراتبهم % % بأن يسموا فيها ولم يسموا % % 68(@)(@@) % تريح أعراضهم فلو كتموا % % ليستروا وجه لؤمهم نموا % % 69(@)(@@) % إن قمت في مغرم تباطوا وإن % % شعثت مالا في سؤدد لموا % % 70(@)(@@) % ومن بنى ما بنيت في سرف % أسرع في بيت ماله الهدم % PageV01P1504 71(@)(@@) % تبقى كعوب الرماح سالمة % ويرتقي في العوامل الحطم % 72(@)(@@) % لا خالست ربعك الخطوب ولا % % أغبني صوب ودك السجم % 73(@)(@@) % ولا تخطت إليك طارقة % لجرحها في سعادة كلم % 74(@)(@@) % وباكرت ربعك التهاني بمو % % شى من المدح رصفه رقم % 75(@)(@@) % تحمله في بيوتها كل عذ % % راء رداح أردانها فعم % 76(@)(@@) % والدها من أنسابها مضر % وجدها من آبائها جشم % 77(@)(@@) % ترضاك لو لامست سواك رجم % % ناها فحد الحواضن الرجم % 78(@)(@@) % خالصة فيك لا يخالطها % % غش ولا تحت حمدها ذم % 79(@)(@@) % يسمعها حاسدي فيصغي وفي % % أذنيه من ثقل وقعها صلم % 80(@)(@@) % تسوغ في حلقه وتشرقه % % بالغيظ فهي الشهاد والسم % PageV01P1505 81(@)(@@) % إذا تلاها الراوي رنا نحوه ال % % عمي فأصغى لصوته الصم % 82(@)(@@) % كأنها كعبة القريض فما % % يغبها الاستلام واللثم % PageV01P1506 البحر : - 1(@)(@@) % كذا تتقضى الأيام حالا على حال % وتنقرض السادات باد على تالي % % 2(@)(@@) % ويلحق أبناء النبي أباهم % على مهل من سير عمر وإعجال % 3(@)(@@) % ضحى كل يوم سالب من سراتهم % % بصيرة عمي أو هداية ضلال % 4(@)(@@) % إذا اخضر فرع منهم اغبر أصله % % فصوح حتى يتبع العاطل الحالي % % 5(@)(@@) % ويا وشك ما تمسي الديار خلية % إذا ذهب الباقي 
ms487	 ولم يعد الخالي % % 6(@)(@@) % مدارج تحت الأرض سوت جسومهم % % وإن عرجت أرواحهم أفقها العالي % % 7(@)(@@) % سوى ما يبقي الدهر من بركاتهم % % ضرائح أنوار بها يسأل السالي % % 8(@)(@@) % ولا كضريح أمس هلنا ترابه % % على جسد باقي العلا في النقا بالي % % 9(@)(@@) % على الطاهر ابن الطاهرين وإنه % % لهالة بدر منه بل غاب رئبال % 10(@)(@@) % بأية نفس ليلة السبت روحت % يد الموت لم تنقد لها قود أخلال % PageV01P1507 11(@)(@@) % تباشرت الأملاك ليلا بقربه % % وأصبح منها في قبيل وفي آل % 12(@)(@@) % سقينا به ميتا كما كان جاهه % لدى الله حيا عام جدب وإمحال % 13(@)(@@) % فلله نفس كان وقت ارتفاعها % % إلى الله والغيث المنزل في حال % 14(@)(@@) % لئن بايعتنا المزن روحا بروحه % % لقد غبنتناه مع الثمن الغالي % % 15(@)(@@) % قنوطا بني الحاجات إن نجاحها % % بلا كافل بعد الحسين ولا والي % % 16(@)(@@) % أجموا المطايا إنه عام قعدة % وفي غير الأحوال تغيير أحوال % 17(@)(@@) % قفوا فانفضوا أذوادكم حول قبره % فلا حظ في حط عداه وترحال % 18(@)(@@) % مضى من يخاف العتب وهو بنجوة % ويرعى مصونا سبة القيل والقال % 19(@)(@@) % ومن بحره طام ويروى تعللا % % ببل اللهاة من نطاف وأوشال % 20(@)(@@) % أبا أحمد عودتني أن تجيبني % % فما وجه إعراض زوى وجه إقبال % PageV01P1508 21(@)(@@) % بكيتك لليوم الشريق بنقعه % % وما رش فيه الطعن من دم أوصال % 22(@)(@@) % وللسيف لم يعدم مضاء وزينة % بنصل وجفن جهد قين ولا جالي % % 23(@)(@@) % عدمت فلم يظفر بعاتق حامل % يفرق حينا بين شنف وخلخال % 24(@)(@@) % وللرمح فات الرمح بعدك أن يرى % % شمائل عطاف مع الطعن ميال % 25(@)(@@) % وللسابق المنقول من ظهر لاحق % إلى سبعة مما تنخلها الفالي % % 26(@)(@@) % حمى ظهره العالي نزولك أن يرى % % مقاما لراج أو مفازا لجوال % 27(@)(@@) % به نفرة من سرجه ولجامه % % لفقدك مع لين لديه وإسهل % 28(@)(@@) % وعمياء من طرق الحجاج تلجلجت % بأصوات خطاب وأفواه نقال % 29(@)(@@) % توسعت مع ضيق الخصام بفلجها % % وأوضحت منها كل لبس وإشكال % 30(@)(@@) % وللأرض يحيا تربها وهو ميت % وإن لم يجدها صوب أسحم هطال % PageV01P1509 31(@)(@@) % بمالك أو يغنى بفقرك 
ms488	 ربعها % % على قفره أو ينعم الطلل البالي % % 32(@)(@@) % ولليلة الظلماء قمت سراجها % % على رجل قوال مع الله عمال % 33(@)(@@) % وبيت صلاة شدته فوقفته % % على دعوات صالحات وأعمال % 34(@)(@@) % وللطارق المعتر إن لم طارقا % % تجاوده في النفس والأهل والمال % 35(@)(@@) % لجا مستضيفا كل بيت يظنه % % فلا سامر ولا نباح ولا صالي % % 36(@)(@@) % إلى أن أراه الله نارك فاهتدى % % على ضلة أكرمت يا موقد الضال % 37(@)(@@) % على كل مأمول سلامي فإنني % % يئست وماتت يوم موتك آمالي % % 38(@)(@@) % لمن تمخض الأشعار بعدك زبدة % وتجمع بين الحاء والميم والدال % 39(@)(@@) % وفى بالجوى قلبي وقصر منطقي % % فأكثر قولي فيك أيسر أفعالي % % 40(@)(@@) % وإنك لو تسطيع منا ومنة % لداويت أوجاعي وداريت أوجالي % % PageV01P1510 41(@)(@@) % إذا لحملت الحزن عني بكاهل % ضعيف على ما اعتاد من حمل أثقالي % % 42(@)(@@) % يقولون تخفيفا لحزني معمر % نجا مائة أو كاد مطلعها العالي % % 43(@)(@@) % وذاك عزاء عنك لو يعقلونه % % أمد لدمعي بل أشد لإعوالي % % 44(@)(@@) % بقدر بقاء المرء قدر الأسى له % % وذكر نعيم دام لي بك أشقى لي % % 45(@)(@@) % وما دهى الإنسان فيمن يحبه % % بفقد كأخذ جاء من طول إمهال % 46(@)(@@) % رثاك نسيب وده وولاؤه % % محق إذا زن القصي بإبطال % 47(@)(@@) % ومولاكم فيكم على ما شرطتم % % وإن بان عنكم في عموم وأخوال % 48(@)(@@) % فيا ليت لا يعدم وفودك عادة % بشبليك من عطف عليهم وإسبال % 49(@)(@@) % فما مات من عاشا لسد مكانه % ولا حضرا وموضع منك بالخالي % % 50(@)(@@) % وما غاديا أو راوحاك زيارة % نراك بها مستبشرا ناعم البال % PageV01P1511 51(@)(@@) % ولو ما أغباك الطروق كفتهما % % خلافة جبريل عليك وميكال % % PageV01P1512 البحر : - 1(@)(@@) % ما للدسوت وللسروج تسائل % من قائم عنهن أو من نازل % 2(@)(@@) % لم سد باب الملك وهو مواكب % وخلت مجالسه وهن محافل % 3(@)(@@) % ما للجياد صوافنا وصوامتا % % نكسا وهن سوابق وصواهل % 4(@)(@@) % من قطر الشجعان عن صهواتها % % وهم بها تحت الرماح أجادل % 5(@)(@@) % ما للسماء عليلة أنوارها % % لمن السماء من الكواكب ثاكل % 6(@)(@@) % من لجلج الناعي يحدث أنه % % أودى فقيل أقائل أم قاتل % 7(@)(@@) % المجد 
ms489	 في جدث ثوى أم كوكب ال % % دنيا هوى أم ركن ضبة مائل % 8(@)(@@) % ما كنت فيه خائفا أن الردى % % من عز جانبه إليه واصل % 9(@)(@@) % أدرى الحمام بمن وأقسم ما درى % % تلتف كفات له وحبائل % 10(@)(@@) % خطب أخل الدهر فيه بعقله % والدهر في بعض المواطن جاهل % PageV01P1513 11(@)(@@) % يا غيث أرضى الأرض سقيا واحتبى % % بالروض يشكره المحل الماحل % 12(@)(@@) % ينهل منحل المزادة موقنا % % أن الثرى الظمآن منه ناهل % 13(@)(@@) % يسم الصخور كأن كل مجودة % لحظ العليق بها حصان ناعل % 14(@)(@@) % تمريه غبراء الإهاب كأنما % % قادت خزائمها النعام الجافل % 15(@)(@@) % حلفت لأفواه الربى أخلافها % % أيمان صدق أنهن حوافل % 16(@)(@@) % وليت سيوف البرق قطع عروقها % % فبكل فج شاريان سائل % 17(@)(@@) % أبلغ أبا العباس أنك فاحص % حتى تبل جوى ثراه فواغل % 18(@)(@@) % منى وأطباق الصعيد حجابه % عني فكيف تخاطب وتراسل % 19(@)(@@) % سعدت جنادل ألحفتك على البلى % % لا مثل ما شقيت عليك جنادل % 20(@)(@@) % أبكيك لي ولمرملين بنوهم ال % % أيتام بعدك والنساء أرامل % PageV01P1514 21(@)(@@) % ولمستجير والخطوب تنوشه % % مستطعم والدهر فيه آكل % 22(@)(@@) % متلوم العزمات لا هو قاطن % في داره قفرا ولا هو راحل % 23(@)(@@) % أودى به التطواف ينشد ناصرا % % فيضل أن يلقاه إلا خاذل % 24(@)(@@) % حتى إذا الإقبال منك دنا به % % أنساه عندك عام بؤس قابل % 25(@)(@@) % ولمعشر طرق العلوم ذنوبهم % % في الناس وهي لهم إليك وسائل % 26(@)(@@) % كانوا عن الطلب الذليل بمعزل % ثقة وأنت بما كفاهم كافل % 27(@)(@@) % قطع الجدا بهم وقد قطع الردى % % بك أن يظن تزاور وتواصل % 28(@)(@@) % وعصائب هي إن ركبت مواكب % تسع العيون وإن غضبت جحافل % 29(@)(@@) % تفري بأذرعها الكعوب كأنها % % تحت الرماح على الرماح عوامل % 30(@)(@@) % لو كان في ثعل بموتك ثأرها % % ما عاش من ثعل عليك مناضل % PageV01P1515 31(@)(@@) % نكروا حلومك والمنون تسوقها % % حقا وأنت مدافع متثاقل % 32(@)(@@) % قعد البعيد وقام عنك متاركا % % ما جاء يقضيك القريب الواصل % 33(@)(@@) % ولج الحمام إليك بابا ماشكا % % غير الزحام عليك فيه داخل % 34(@)(@@) % مستبشرا بالوفد لم يجبه به % % رد ولم ينهر عليه 
ms490	 سائل % 35(@)(@@) % لم يغنك الكرم العتيد ولا حمى % % عنك السماح ولا كفاك النائل % 36(@)(@@) % كنت الذي مر الزمان وحلوه % فيمن يصابر عيشه ويعاسل % 37(@)(@@) % فغدوت ما لك في عدوك حيلة % تغنى ولا لك من صديقك طائل % 38(@)(@@) % والموت أجور حاكم وكأنه % % في الناس قسما بالسوية عادل % 39(@)(@@) % لا اغتر بعدك بالحياة مجرب % عرف الحقوق فلم يرقه الباطل % 40(@)(@@) % يا ثاويا لم تقض حق مصابه % % كبد محرقة وجفن هامل % PageV01P1516 41(@)(@@) % أفديك لو أن الردى بك قابل % % من مهجتي وذوي ما أنا باذل % 42(@)(@@) % ما بال أوقاتي بفقدك هجرت % ولقد تكون لديك وهي أصائل % 43(@)(@@) % قد كنت ملتحفا بمدحك حلة % فخرا تجر لها علي ذلاذل % 44(@)(@@) % فاليوم أشكرك الصنيع مراثيا % خرس المشبب عندها والغازل % 45(@)(@@) % تصف الغليل بناتها أبياتها ال % % أيتام وهي عليك أم ثاكل % 46(@)(@@) % مما طربت له الطويل وشاغل % عنه يسد اليوم سمعك شاغل % 47(@)(@@) % هل يرضينك جهد ما أنا قائل % % إذ لا غناء بجهد ما أنا فاعل % 48(@)(@@) % يا ليث لا يبعد حماك وإن خلا % % منك العرين فإن شبلك باسل % 49(@)(@@) % لكفاك يحفظ ما بنيت من العلا % % سام إلى غاياتها متطاول % 50(@)(@@) % يقظان تعرف فيه مبتدئا كما % % قال ابن حجر من أبيه شمائل % PageV01P1517 51(@)(@@) % طب في الثرى نفسا فوفدك حوله % % زمر الثناء وربع مجدك آهل % 52(@)(@@) % لا تحسبن وسعد ابنك طالع % يحتل برجك أن سعدك آفل % 53(@)(@@) % ما أنكر الزوار بعدك وجهه % % في البدر من شمس النهار مخايل % 54(@)(@@) % أجمل له يا سعد واحمل وزره % % ما طال باع أو أطاعك كاهل % 55(@)(@@) % وأنا الذي يرضيك فيه باكيا % % ويسره بك في الذي هو قائل % 56(@)(@@) % موليكما الشكر الذي لا لفظه % خلق ولا معناه رث حائل % 57(@)(@@) % يتشاهدون له بأن ما فيه لي % % يوم المقال مناسب ومساجل % 58(@)(@@) % بان المصيب من المريب وكشفت % شبه وقام على الصباح دلائل % 59(@)(@@) % والشعر أصلف أن تغازل عذرة % % فيه فتخجل أو تساحر بابل % PageV01P1518 البحر : - 1(@)(@@) % ضنا بأن يعلم الناس الهوى لمن % % وهبت للسر فيه لذة 
ms491	 العلن % 2(@)(@@) % ما صين عن ألسن الواشين ينقضه % % حب قواعده في الصدر لم تصن % 3(@)(@@) % لله حاجة نفس مذ وهبت لها % % ثوب السلو خلعت السقم عن بدني % % 4(@)(@@) % ومن معد فتاة السن جارية % من مطلها الكهل مذ كانت على سنن % 5(@)(@@) % شرقية الدار من غربي دجلة ما % % جاورت بالحب جيراني ولا وطني % % 6(@)(@@) % طرقتها ضائعا في الليل يرشدني % % أتم من بدره من وجهها الحسن % 7(@)(@@) % فلم أجد قبلها إلا الألوف ولا % % سكنت من عهدها إلا إلى سكن % 8(@)(@@) % يا ليلة حدثت عنها الغبي ضحى % حسناء واحتشمت فيها ذوى الفطن % 9(@)(@@) % هل ترجعين بوقت لست ناسيه % ضحى جوى دلهت ورقاء عن فنن % 10(@)(@@) % وقولة طرقت سمعي وقد طفقت % يوم الوداع عيون الناس تأخذني % % PageV01P1519 11(@)(@@) % عرض بغيري ودعني في ظنونهم % إن قيل من يك يخفى الحق في الظنن % 12(@)(@@) % وجنب العتب إما جئت زائرنا % % فأنت في العين أحلى منك في الأذن % 13(@)(@@) % صبرا عسى رائد الإقبال يصدقني % % يا نفس أو واعد الآمال ينجزني % % 14(@)(@@) % أو نصرة لم يزل جود الوزير بها % % سيفا مع الحر مسلولا على الزمن % 15(@)(@@) % أما ويمنى يديه والسمح لقد % % رأيت كلتا يديه فيه لليمن % 16(@)(@@) % وشمت فانهلتا ماء غسلت به % % حالي من الفقر لا ثوبي من الدرن % 17(@)(@@) % في الدست أبلج ملء الدست من مرح % ومن وقار ومن صمت ومن لسن % 18(@)(@@) % سمعا بدعوة موتور يسر بها % % ويكتم الوجد فيها إلف مضطغن % 19(@)(@@) % العيد يضحك من نعماك عن قمر % وكان في أربع يبكى على شجن % 20(@)(@@) % فلو تكلمت الأيام أعرب عن % % فصاحة نحن فيها معرض اللحن % PageV01P1520 21(@)(@@) % فاشرب على النعمة العذراء للشرف ال % % تليد والكاعب العذراء للشدن % 22(@)(@@) % وإن تعج أو تعن فيما أتيت أصف % مع رحب صدري أمورا ضيقت عطني % % 23(@)(@@) % أهنت شعري أبغى الرزق من نفر % تسبيح أسمحهم يا مال لا تهن % 24(@)(@@) % فدارس الفهم وحشي أخاطبه % % كأنني خاطب في دارس الدمن % 25(@)(@@) % وغافل لي صوت المدح يطربه % % بلا ثواب فيرضى بي ويسخطني % % 26(@)(@@) % بذلت عرضي 
ms492	 لأعراض أسيرها % % فيهم فنبههم بذلي وأخملني % % 27(@)(@@) % قد كان من حق مثلي أن يعز وإذ % % قد بعت نفسي فوفر منعما ثمني % % 28(@)(@@) % أشل بضبعي من الحال التي لعبت % % بماء وجهي لعب الماء بالسفن % 29(@)(@@) % وكيف لا تتلافاها أما أدبي % % حق أما أردشير منك قربني % % 30(@)(@@) % لا غرو أدعوك من تحت الحضيض لها % % ضحى فأمسى وقرن الشمس في قرن % PageV01P1521 31(@)(@@) % تنمى الصنيعة في مثلي فسد بي ال % % مهم ما شئت تحمد فيه ممتحني % % PageV01P1522 البحر : - 1(@)(@@) % سواك ومن وثقت به يخون % وغيرك يوم أسأله الضنين % 2(@)(@@) % أعيذك أن تنافيني مطالا % % وقد قضيت سوى ديني ديون % 3(@)(@@) % وأقبح يا مكذب فيك ظني % % إذا صدقت سواي بك الظنون % 4(@)(@@) % وكان الحق لو أنصفت أني % % إذا أنجزت أولهم أكون % 5(@)(@@) % يعز علي أن ترضى بسخطي % % على زمني وإرضائي يهون % 6(@)(@@) % ذوى غصني بحبسك من سمائي % % وكم تبقى على العطش الغصون % 7(@)(@@) % ومن غلط إذا أبردت نفسي % % حرارة ما يعالجه الحزين % 8(@)(@@) % سأسكت ثم تحسبني سواء % وأنت وبيننا في الحال بون % 9(@)(@@) % وأستر تحت أثوابي هزالا % % إذا أبديته شمت السمين % 10(@)(@@) % ومهما يستعن غيري فإني % % عليك بحسن رأيك أستعين % PageV01P1523 البحر : - 1(@)(@@) % قالوا عساك مرجم فتبين % هيهات ليس بناظري إن غرني % % 2(@)(@@) % هي تلك دارهم وذلك ماؤهم % % فاحبس ورد وشرقت إن لم تسقني % % 3(@)(@@) % ولقد أكاد أضل لولا عنبر % في الترب من أرج الحبائب دلني % % 4(@)(@@) % فتقوا به أنفاسهن لطائما % % وظعن وهي مع الثرى لم تظعن % 5(@)(@@) % يا منزلا لعبت به أيدي الصبا % % لعب الشكوك وقد بدت بتيقني % % 6(@)(@@) % إما تناشدني العهود فإنها % % حفظت فكانت بئس ذخر المقتني % % 7(@)(@@) % سكنتك بعدهم الوحوش تشبها % % بهم وليتك آنفا لم تسكن % 8(@)(@@) % لعيونهن علامة سحرية % عندي فما بال الظباء تغشني % % 9(@)(@@) % أزمان أنفق من شبابي مسرفا % % والعيش أعمى عن صروف الأزمن % 10(@)(@@) % ندمان كل فصيحة التأنيث لو % % خطبت لتنعت حسنها لم تحسن % PageV01P1524 11(@)(@@) % تمشى قناة ثم يذكر قدها % % أن التثني للقضيب فينثني % % 12(@)(@@) % لله ما تلك الغصون لو أنها % % غر 
ms493	 الخديعة أثمرت للمجتنى % % 13(@)(@@) % نفض الصبا أو راقه وأعادني % % خوط اليراعة كيف يعجم ينحني % % 14(@)(@@) % إني لأعلم قبل فضى ختمه % % ما في كتاب بالمشيب معنون % 15(@)(@@) % مالي عن الدنيا حلمت ومكرها % % أنى التفت مطالعي من مكمن % 16(@)(@@) % أبدا رقاها تستثير تذللي % % فكأنها ملسوعة بتصوني % % 17(@)(@@) % حتى لأنساني الدجى ما لونها % % أو كاد ريب زماني المتلون % 18(@)(@@) % قالوا متاجره رهين خسارة % إن صافقت يده يدي فليغبن % 19(@)(@@) % حاشى طلابي أن أعم به وقد % % خص السماح بموضع متعين % 20(@)(@@) % يا حظ قم فاهتف بناحية الغنى % % فيالرى وارحم كد من لم يفطن % PageV01P1525 21(@)(@@) % وأعن على إدراكها فبمثلها % % فرقت بين موفق ومحين % 22(@)(@@) % لمن الخليط مشرق ومضمانه % رزق لنا في غيره لم يؤذن % 23(@)(@@) % اشتقت يا سفن الفلاة فأبلغي % % وطربت يا حادي الركاب فغنني % % 24(@)(@@) % وانهض فرحل يا غلام مذلللا % % تتوعر البيداء منه بمدمن % 25(@)(@@) % يرضى بشم العشب إما فاته % % والسير يأكل منه أكل الممعن % 26(@)(@@) % مرح الزمام يكاد يصعب ظهره % % فتصيح فاغرة الرحال بهلن % 27(@)(@@) % الرزق والإنصاف قد فقدا فلذ % بالري واستخرجهما من معدن % 28(@)(@@) % وإلى أبي العباس حافظ ملكها % % سهل الأشد ولان خبث الأخشن % 29(@)(@@) % يا موحدا عدم النظير كناية % إني متى أذكرك باسمك أجبن % 30(@)(@@) % لا ينسين ملك ضمنت بقاءه % % بالأمس غمدك منه سيف المقتني % % PageV01P1526 31(@)(@@) % كانت جحيما وهي تحسب جمرة % حتى غضبت فقال موقدها اسكني % % 32(@)(@@) % جاءوك جمع الصوت حول مرجم % % لم تخترق سمعيه زجرة أيمن % 33(@)(@@) % عد الكثير ولم يطر بحسابه % % ما بين موثوق به ومخون % 34(@)(@@) % وأطاع رأيا جاهليا لو رأى % % آيات غيرك حجة لم يوقن % 35(@)(@@) % حتى طلعت فكنت شمسا مزقت % بيد الشمال ضباب يوم مدجن % % 36(@)(@@) % نحلوك سابقة بصهوة مثلها % % طاف الأمان بمعقل المتحصن % 37(@)(@@) % بهماء إلا نقطة فكأنما % % نبلت بسهم في الجبين مقطن % 38(@)(@@) % عودتها خوض الدماء فإن تدس % يبس التراب ولم تقم بك تصفن % 39(@)(@@) % لما رأوك تفرقت أرواحهم % % فكأنما عرفتك قبل الأعين % 40(@)(@@) % ألق السلاح فقد غنيت سعادة % عن حمله واضرب بجدك واطعن 
ms494	 % PageV01P1527 41(@)(@@) % فإذا هممت بأن تفل كتيبة % لا قيتها فتسم فيها واكتن % 42(@)(@@) % وقف الجمال عليك كل فضيلة % قادت لك الأهواء قيد الأرسن % 43(@)(@@) % وعددت وحدك سيدا فمتى تزد % في اللفظ تثنية له لا ينثني % % 44(@)(@@) % لا ينكرن حسود ملكك ما رأى % % فالله أعلم ما اجتبى وبمن عني % % 45(@)(@@) % صلت عليك وقد ذكرت مدائحي % % والناس بين مذمم وملعن % 46(@)(@@) % اقرأ على بعد المسافة بيننا % % ولو استطعت القرب قلت لك ائذن % 47(@)(@@) % قولا يقر الحق منه مقره % % ويرده ما لم يكن بمبرهن % 48(@)(@@) % مما أبثك أننا في أرضنا % % لا يذكر الإحسان غير مؤبن % 49(@)(@@) % في معشر إن جاد قولة مظهر % منهم فتى لامته نية مبطن % 50(@)(@@) % خشنت جعاد أكفهم فكأنما % % في اللؤم صيغت من طباع الأزمن % PageV01P1528 51(@)(@@) % لم يبق غيرك من يقال مؤمل % أو يتبع الداعي له بمؤمن % 52(@)(@@) % كرم شملت به وعدل سحابة % سوى الأجم بنانها بالأقرن % 53(@)(@@) % أشكو ظماى وليس غيرك ساقيا % % فامدد يديك على البعاد فروني % % 54(@)(@@) % واسمع فإن عزبت فلم تسمع لها % % أختا لها في مادحيك عرفتني % % 55(@)(@@) % هي قبلة صلى القريض لها فمن % % لم يعن منه لها فليس بمؤمن % 56(@)(@@) % لولا ثناؤك ما امتننت بوصلها % % والمرء يقدح في صفاة المحسن % 57(@)(@@) % ثمن بها الأرباح فهي بضاعة % ما زلت أذخرها لعلق مثمن % 58(@)(@@) % كان الزمان لأن أشافه ضامنا % % فأعاض منه بأخرس متضمن % 59(@)(@@) % ولئن أعنت لأتلونه مصليا % % ولأطلعن عليك إن أنهضتني % % 60(@)(@@) % ما بالأديب إذا تغرب ذلة % إن الخصاصة غربة في الموطن % PageV01P1529 61(@)(@@) % قعد الغنى عنى فقم بي مرغما % % أنف الزمان وأغنني تتملني % % 62(@)(@@) % وإن اجتديت سواك بعد فجازني ال % % حرمان إن القتل حد المحصن % 63(@)(@@) % عاقت خواطري الهموم وخالفت % نوب على الفكر الغزير عصينني % % 64(@)(@@) % فلو اتبعت لغير مدحك لفظة % عنها أقرر خاطري لم يذعن % 65(@)(@@) % قبض الجلوس يدي عن أمنيتي % % إن الظبا مأسورة في الأجفن % 66(@)(@@) % وإذا قلوب قارعت أحزانها % % ظهر الفلول على غروب الألسن % 67(@)(@@) % ما فات حظي أن مثلي ممكن % لكن كثرت على الزمان 
ms495	 فملني % % 68(@)(@@) % يا من رآني قبل أحمد سائلا % % قوما يقول جوادهم لي عدني % % 69(@)(@@) % كبر الرجاء اليوم عن أقدارهم % % فطغى وأبزل بعدك الأمل الثني % % PageV01P1530 البحر : - 1(@)(@@) % لعدو حسنك ما لسمع العاذل % % مني إذا قام فيك مجادلي % % 2(@)(@@) % طال الملام عليك أعلم أنه % % حسد وما حظي الحسود بطائل % 3(@)(@@) % أرضي الهوى منك المكدر بالنوى % % حظا وأقنع بالغريم الماطل % 4(@)(@@) % وإذا شكوتك في جمال هاجر % عمدا شكرتك في خيال واصل % 5(@)(@@) % ولقد أحلك لو عرفت محله % % قلبا يضيق سوى هواك بنازل % 6(@)(@@) % أعطي بذل ما منعت بعزة % فيضيع في أثناء بخلك نائلي % % 7(@)(@@) % ما ضر يا حسناء قلبا جائرا % % لك لو تعلم من قوام عادل % 8(@)(@@) % أمسائل ماذا فعلنا بعده % % سكن بدجلة لا يجود لسائل % 9(@)(@@) % أم راجع زمن به بقى الأسى % % ومضى وكيف رجوع أمس الزائل % 10(@)(@@) % هيهات زدن سني فانتقصت قوى % % ودي ومتن مع الشباب وسائلي % % PageV01P1531 11(@)(@@) % كنت الحسام جلاي شرخ شبيبتي % % بين الحسان وماء غصني صاقلي % % 12(@)(@@) % فطرحت عن أعناقهن بأن ذوت % مني ذوائب كن قبل خمائلي % % 13(@)(@@) % عمر مضى سرفا وعصر بطالة % أخذ المشيب لحقه من باطلي % % 14(@)(@@) % ملك الحجا مني مكان خلاعتي % % وتوقرت بعد المراح شمائلي % % 15(@)(@@) % أحييت أموات المحاسن قائلا % % لو لم يرعن من الحسود بقاتل % 16(@)(@@) % قالوا عدوك فاحتقره جاهل % من لي على فضلي بحظ الجاهل % 17(@)(@@) % يا إخوة الأيام يتبعونها % % من مستقيم كاذب أو مائل % 18(@)(@@) % خلوا ابن أيوب علي وشأنكم % % من ناكث أو غادر أو حائل % 19(@)(@@) % من لا تحوله الخطوب بحادث % عني ولا عقل الزمان بشاغل % 20(@)(@@) % وإذا رجعت إلى أواخر وده % % قابلتها بوسائط وأوائل % PageV01P1532 21(@)(@@) % وإذا حملت عليه ثقلا لم أقل % % يا ليتني روحت ظهر الحامل % 22(@)(@@) % ما ضرني قاس علي فنابذي % % و محمد حان علي فقابلي % % 23(@)(@@) % لله راض بالقليل لنفسه % % متذمم لي بالكثير الفاضل % 24(@)(@@) % من ممسكي الحسب التليد ومطلقي ال % % أيدي إذا جفت بنان الباذل % 25(@)(@@) % رامين في الغرض البعيد إذا نأى % % يوم الفخار على سهام النابل % 26 
ms496	(@)(@@) % شرعوا إلى الغايات كل مهفهف % سار على خيل الأنامل جائل % 27(@)(@@) % لو لم يكن رمحا لما شحذوا له % % حدين موضع زجه والعامل % 28(@)(@@) % نفثاته السحر المبلبل لا كما % % خبرت أن السحر صنعة بابل % % 29(@)(@@) % ألحقهم في المجد واحفظهم وزد % % ولقد فعلت وزدت حد الفاعل % 30(@)(@@) % وأعر علاك العيد يزدد حسنه % % يا حلي أيام الزمان العاطل % PageV01P1533 31(@)(@@) % قابل به عاما ترنق إنه % % متضاعف لك خيره في القابل % PageV01P1534 البحر : - 1(@)(@@) % من دل ربات العيون النجل % أن القلوب غرض للمقل % 2(@)(@@) % فما رمت سوداء منها أسودا % % فغير أن يجرح إن لم يقتل % 3(@)(@@) % باع رخيصا لبه يوم اللوى % % موكل أحشاءه بالكلل % 4(@)(@@) % حكم سوى مسلط إذا جنى % % لم يعتذر وإن قضى لم يعدل % 5(@)(@@) % دمي وقد حرم إلا بدم % على اللوى لم حل ياذات الحلى % % 6(@)(@@) % سيقت لبلبالك بابلية % % مالك يا خالقة السحر ولي % % 7(@)(@@) % زعمت لا يبلي هواك جسدي % % بلى وحبيك بلى لقد بلي % % 8(@)(@@) % دارك تدري أنه لولا الهوى % % ما طل دم مقلتي في طلل % 9(@)(@@) % عجنا بها العيس سريعات الخطى % % شوقا إليها مائلات الأرجل % 10(@)(@@) % بنا غرام ما بنا أن وقفت % سيارة الإبل ورب الإبل % PageV01P1535 11(@)(@@) % أوقرت المزن العياب وسرت % % فوضعت حمولها بحومل % 12(@)(@@) % ما علم العاذل في إنباضه % % سهم الملام أن سمعي مقتلي % % 13(@)(@@) % خذ بالأشد كل ما تبغي وإن % % قصر حظ فانبسط وطول % 14(@)(@@) % من يعل عز نفسه يعل ومن % % يعل على حكم الزمان يسفل % 15(@)(@@) % توسط الشمس جنى كسوفها % % وفي التناهي نجوة لزحل % 16(@)(@@) % وكيف لا يأتي الأمور من عل % معتلق حبل الحسين بن علي % % 17(@)(@@) % أذم لي على الأماني ماجد % لو عقد الخلود لي لم يحلل % 18(@)(@@) % أبلج ما تحت اللسان واضح % بيمنه في كل خطب مشكل % 19(@)(@@) % فاعل ما قال على علاته % إذا السحاب قال ما لم يفعل % 20(@)(@@) % جذلان ما سألته وزاده % % مسرة إعطاء ما لم يسأل % PageV01P1536 21(@)(@@) % دعوته والدهر قد أنبل لي % % طريرة لا تتقى بنبل % 22(@)(@@) % وحيلي ضائعة في كيده % % والرمل قد 
ms497	 كاثرته بحيلي % % 23(@)(@@) % فبصرتني منه نفس حرة % شاب الإباء شهدها بحنظل % 24(@)(@@) % حتى نهضت نابها نابية % عني مقاعد الخمول المرمل % 25(@)(@@) % علمني النسيب حتى خلته % % أن الهوى مطية للغزل % 26(@)(@@) % وذلل المديح لي نواله % % والجود مفتاح اللسان المقفل % 27(@)(@@) % سل ببني عبد الرحيم وصفهم % % ما سار في بيت لهم أو مثل % 28(@)(@@) % داسوا لحروب من قنا أقلامهم % % بالطاعنات في الرعيل الأول % 29(@)(@@) % كما نازل الكمي وهو راكب % راكب دست منهم لم ينزل % 30(@)(@@) % وجر من كتيبة في كتبه % سرت به وشخصه لم يرحل % PageV01P1537 31(@)(@@) % فلا أخل بالعلاء موقف % لقدميك زلق بالأرجل % 32(@)(@@) % وأقبل الأضحى عليك موصلا % % إليك عهد ألف عيد مقبل % 33(@)(@@) % يوم حكاك شرفا وبهجة % وفاق من يعقل ما لم يعقل % 34(@)(@@) % فضل الأنام والزمان لكما % % في نظر العين وفي التخيل % 35(@)(@@) % كأنما الأيام في يوم به % % والناس منك كلهم في رجل % PageV01P1538 البحر : - 1(@)(@@) % أسترشد البان وهو غضبان % وأسأل البدر وهو غيران % 2(@)(@@) % خصمان لي فيك يا لغانية % غيظ بدور بها وأغصان % 3(@)(@@) % فمن رسول إليك يذكرك أل % % أيمان بل أين منك أيمان % 4(@)(@@) % أيام حجر عليك في الوجه والل % مة لي رائع وريعان % 5(@)(@@) % ذنبي في ذمة الصبا وإسا % % ءتي بحكم الشباب إحسان % 6(@)(@@) % إن خدعتني حسناء أو صادني % % بعد ظباء الصريم غزلان % 7(@)(@@) % فقلت دهري عدل القصية أو % غير ابن أيوب فيه إنسان % 8(@)(@@) % فدى أخي منه حيث لبس أخو % % صفو وخلى وليس إخوان % 9(@)(@@) % مبتسم الوجه وهو متهم % % وعاطش الود وهو ريان % 10(@)(@@) % رؤياه لون ورأيه لي إذا اس % % تشفعته في الخطوب ألوان % PageV01P1539 11(@)(@@) % دعوه لي وحده فإن قلت ثن % وه فقلبي الوفي خوان % 12(@)(@@) % الكرم العفو والحفاظ معي % % أصلان منه والمال رجحان % 13(@)(@@) % والمنبت الطيب الأرومة في % % دوح لها المكرمات أفنان % 14(@)(@@) % من راكبي كاهل الفخار فهم % % والناس رجلى الأنساب فرسان % 15(@)(@@) % كأن أعراضهم إذا خبثت % % لؤما رياح الأعراض ريحان % 16(@)(@@) % مورثون العلاء مثلك تبن % % يه وحفظ الأحساب بنيان % 17(@)(@@) % يا من صحا الدهر حين 
ms498	 أعلقني % % منه اختصاما والدهر سكران % 18(@)(@@) % اسمع لبكر كأن سامعها ال % % وقور مما يخف نشوان % 19(@)(@@) % تود فيها العيون سيدة ال % % أعضاء لو أنهن آذان % 20(@)(@@) % تأتيك كثرا أولى كتابية % في الحسن والمنجبات أقران % PageV01P1540 21(@)(@@) % على رءوس الأعياد حليتها % % وهي ملوك الأيام تيجان % 22(@)(@@) % ما فاتها النحر بالزيارة فال % % غدير وقت لها وإبان % 23(@)(@@) % فاحظ بها واكسه الجمال بها % % فكل يوم فاتته عريان % 24(@)(@@) % ينقص الدهر كل زائدة % وأنت لا يعتريك نقصان % PageV01P1541 البحر : - 1(@)(@@) % أعينوني على طلب المعالي % % فقد ضاقت بها سعة احتيالي % % 2(@)(@@) % ودلوني على رزق بعيد % وإن هو قل عن بذل السؤال % 3(@)(@@) % فلو قنن الجبال زحمن جنبي % % وقعن أخف من منن الرجال % 4(@)(@@) % وإلا فاسلبوني حظ فضلي % % إلى ما فاتني من حظ حالي % % 5(@)(@@) % ونجوني وحيدا لا علي ال % % محاسن والشقاء بها ولا لي % % 6(@)(@@) % ألا رجل يخاف العيب منكم % % ويأنف للحقوق من المحال % 7(@)(@@) % فيعدل في القضية لا يجابي % % ويحكم بالسوية لا يبالي % % 8(@)(@@) % تواصى الناس إكرام الأسامي % % وهان لديهم كرم الفعال % 9(@)(@@) % يعد أخوك أشرف منك بيتا % بأنك عاطل وأخوك حالي % % 10(@)(@@) % ولا والمجد ما شرقي بريقي % % وشربي الملح في العذب الزلال % PageV01P1542 11(@)(@@) % أدال الله من سمن ابن عم % رعى حسبي وأهملني هزالي % % 12(@)(@@) % وما هو غير أن يدي قصير % مداها عن مدى هممي الطوال % 13(@)(@@) % وإن وسع القريب أصول مجدي % % ولم يسع الغريب فضول مالي % % 14(@)(@@) % عسى الأيام يوجعها عتابي % % ويخجلها انتظاري واحتمالي % % 15(@)(@@) % وخل كان إن أخفقت مالي % % وإن أنا خفت نازلة مآلي % % 16(@)(@@) % يحوط جوانبي ويذب عني ال % % أذى ذب الجفون عن النصال % 17(@)(@@) % وإن أهديت بكرا من ثناء % % إليه تميس في حلل الجمال % 18(@)(@@) % تناهى في كرامتها قبولا % % وغالى في المهور بها الثقال % 19(@)(@@) % وباتت حين تغبطها عليه % % إذا ما غرن ربات الحجال % 20(@)(@@) % معشقة مكان ترى الغواني % % إذا عرسن يودعن الغوالي % % PageV01P1543 21(@)(@@) % فغيره الزمان وأي حال % من الأحداث سالمة بحال % 22(@)(@@) % ونكس رايتي منه نصيري % % وميل صعدتي رب اعتدال % 23 
ms499	(@)(@@) % كنور الشمس منه البدر ينمي % % ومنه النقص يسري في الهلال % % 24(@)(@@) % ولكن جفوة لم تنس عهدا % % ولم تجز الدلال إلى الملال % 25(@)(@@) % فدى الوضاح في الخطب ابن ليل % إذا استضويت في أمر دجالي % % 26(@)(@@) % ومنحطون عنه أبا ونفسا % وبيت النجم مثل النجم عالي % % 27(@)(@@) % ألست ابن الألى انتظموا ملوكا % نظام العقد من باد وتالي % % 28(@)(@@) % إذا الأب غاب ناب ابن كريم % يريك شهادة النسب الحلال % 29(@)(@@) % كأن المجد لم يحزن لماض % مع الباقي ولم يفجع بحال % 30(@)(@@) % لهم سنن من المعروف تكسو ال % % لحوم بها عظامهم البوالي % % PageV01P1544 31(@)(@@) % وآثار من الأيام بيض % كآثار البدور على الليالي % % 32(@)(@@) % وجرب منك فخر الملك عضبا % % مخوف الحد مأمون الكلال % 33(@)(@@) % رآك أعفهم بالغيب سرا % وأفرسهم على ظهر الجدال % 34(@)(@@) % وقاس بك الرجال فبنت فوتا % % وإن شوبهت في خلق الرجال % 35(@)(@@) % فجلل منكبيك لباس فخر % يدل على التناسب في الجلال % 36(@)(@@) % لجائلة اللحاظ به زليق % على سعة المطارح والمجال % 37(@)(@@) % تمازج كل لون من هواها % % بلون واقع منه ببال % 38(@)(@@) % كأنك قد نفضت عليه صبغا % % محاسن ما حويت من الكمال % 39(@)(@@) % وعممك السحابة فوق رضوى % % كذاك السحب عمات الجبال % 40(@)(@@) % وأمطاك الغزالة ظهر طرف % أتى خلقا وسبقا كالغزال % PageV01P1545 41(@)(@@) % كلا طرفيه من كرم وعتق % تأنق رابط فيه وفالي % % 42(@)(@@) % تراه مطلقا عريان يزهى % % على الغر المحجلة الحوالي % % 43(@)(@@) % وكيف وردفه ومقلداه % % مواقر من حلى التبر الثقال % 44(@)(@@) % تهن بها منائح غاديات % أواخرها تطول على الأوالي % % 45(@)(@@) % إذا نثرت لك الدنيا سعودا % % حظيت بها فنظمت اللآلي % % 46(@)(@@) % ولكن وفني منها نصيبا % بجاهك لا أسومك فضل مال % 47(@)(@@) % وجاز مفيدك الحسنى بذكرى % % ومهد عنده بالوصف حالي % % 48(@)(@@) % فإن هدية مثلي لتكفي % % مكافأة لأنعمه الجزال % 49(@)(@@) % وكاثرني مجالسه تجدني ال % % تمام لما حوته من جمال % 50(@)(@@) % وكيف ضمنت عن قلمي وقلبي % % سدادا لم تخف درك اختلال % PageV01P1546 51(@)(@@) % وقد جربتني وخبرت قدما % % فهل شيء يريبك من خصالي % % 52(@)(@@) % وغيرك قد تكفل أمر غيري % % فنال بسعيه بعض المنال % 53 
ms500	(@)(@@) % وقدم آخرون فهم بطاء % فما لك لا تغار على العجال % 54(@)(@@) % وقد أنشدت ما سمعوا وقالوا % % فيا للشعر من قيل وقال % 55(@)(@@) % جواهر لا يعالجهن غوصى % % وماء لا تخابطه سجالي % % 56(@)(@@) % إذا طرق الحبيب بلا رقيب % فما وجه التعلل بالخيال % 57(@)(@@) % يسوم سواك تجهيزي وسوقي % % فقلت وما العروس بغير جالي % % 58(@)(@@) % وعدت إليك عن ثقة وعلم % بأن السيف أدرب بالقتال % PageV01P1547 البحر : - 1(@)(@@) % ألم أتحدث والحديث شجون % بما كان منكم أنه سيكون % 2(@)(@@) % وأعلمكم أن الليالي رءوسها % % وإن صعبت شيئا فسوف تلين % 3(@)(@@) % وأزجر طير اليمن فيكم عيافة % فتجري لكم بالخير وهي يمين % 4(@)(@@) % وأعلم أن الله في نظم أمركم % % كفيل برعي المكرمات ضمين % 5(@)(@@) % بشائر صدق لم تخب ولوايح % من الرشد لم تكذب لهن عيون % 6(@)(@@) % وما الغيب طبي فيكم غير أنني % % ظننت وظن الألمعي يقين % 7(@)(@@) % وغر الأعادي والجدود سوابق % بكم أن هفا من بينهن حرون % 8(@)(@@) % وأن رفعت صيفية حلبية % تحل حلول الطيف ثم تبين % 9(@)(@@) % فما كل جو خادع العين ماطر % وإن نشأت منه سحائب جون % 10(@)(@@) % سمت أعين مغضوضة وتوسعت % أمان لهم مكذوبة وظنون % PageV01P1548 11(@)(@@) % ونمت قلوب كاتمات بسرها % % وطالع داء في الضلوع دفين % 12(@)(@@) % وحدث فيها بالفكاك ضميره % % أسير ببغضاء الكرام رهين % 13(@)(@@) % خبيث المطاوي شره دون خيره % إذا اغتبط الأحرار فهو حزين % 14(@)(@@) % نزى نزوة الأفعى القصير فعاقه % % طريق بنيران الرقاة دخين % 15(@)(@@) % ومرتصد ذو كلبتين بفيهما % % إلى نابه وهو السمام حنين % 16(@)(@@) % تمنى تماما فيكم وهو ناقص % وطاولكم بالكبر وهو مهين % 17(@)(@@) % وأطمعه فيكم وقور حلومكم % % وبشر لكم عند اللقاء ولين % 18(@)(@@) % ولم يدر أن الزند أملس لينا % % يمس وجسم النار فيه كمين % 19(@)(@@) % تطرف يبغى الصيد حول بيوتكم % % وشر مكان للقنيص عرين % 20(@)(@@) % وناطح منكم صخرة لا يزلها % % من الرأس وحف الوفرتين دهين % PageV01P1549 21(@)(@@) % تطامن فقد أقصاك عن موطن العلا % % ولو كنت فوقا أن نفسك دون % 22(@)(@@) % ولا تحسبن الخلف يصلح بيننا % % فرب يمين بالفسوق تمين % 23(@)(@@) % وقعت ذنابي في العلا وأكارعا 