ms1221	 يروي عن عكرمة روى عنه يعقوب بن القعقاع ومنصور بن النعمان(@)(@@)(@@)(@@) $ 10482 - محمد بن بسطام أبو حفص الحنظلي يروي عن الحسن عداده في أهل البصرة وهو الذي يقال له بن سعد الرابية روى عنه PageV07P369 عبد الصمد والتبوذكي(@)(@@)(@@)(@@) $ 10483 - محمد بن عبيد الله بن عياض القاري من أهل المدينة يروي عن عمه وعروة بن الزبير روى عنه عمر بن سعيد بن أبي حسين(@)(@@)(@@)(@@) $ 10484 - محمد بن عبد الله بن ميمون بن مسيكة يروي عن عمرو بن الشريد روى عنه وبر بن أبي دليلة(@)(@@)(@@)(@@) $ 10485 - محمد بن خالد أبو يحيى يروي عن سعيد بن جبير روى عنه الثوري وسعيد بن خثيم(@)(@@)(@@)(@@) $ 10486 - محمد بن عطاء بن خباب يروي عن أبيه عن جده خباب روى عنه عبد الله بن مسلم وهو أخو الوليد بن عطاء PageV07P370(@)(@@)(@@)(@@) $ 10487 - محمد بن إبراهيم بن مسلم بن مهران من أهل مكة كنيته أبو إبراهيم القرشي يروي عن جده مسلم بن مهران بن المثنى وقد قيل إن اسم المثنى مسلم بن أبي عمرو روى عنه أبو داود الطيالسي والبصريون كان يخطئ وهو الذي يقال له محمد بن أبي المثنى فمن زعم ذلك فقد نسبه إلى جده وهو الذي يروى عنه بن المبارك عن سلمة بن كهيل وعلي بن بذيمة ويصحف اسمه ويقول مسلم بن إبراهيم(@)(@@)(@@)(@@) $ 10488 - محمد بن طحلاء مولى جويرية بنت الحارث وقد قيل إنه مولى بني ليث كنيته أبو صالح يروي عن الحجازيين روى عنه الدراوردي وهو والد يعقوب ويحيى(@)(@@)(@@)(@@) $ 10489 - محمد بن عبيد بن أبي صالح المكي يروي عن عدى بن عدى PageV07P371 الكندي روى عنه ثور بن يزيد الكلاعي(@)(@@)(@@)(@@) $ 10490 - محمد بن سليمان بن سلمان المدني يروي عن الحجازيين وقد أدرك أبا أمامة بن سهل بن حنيف روى عنه حاتم بن إسماعيل والدراوردي وعيسى بن يونس(@)(@@)(@@)(@@) $ 10491 - محمد بن أبي يحيى الأسلمي واسم أبي يحيى سمعان مولى لعمرو بن عبد نهم الأسلمي يروي عن جماعة من التابعين روى عنه ابنه إبراهيم بن محمد بن أبي يحيى 
ms1222	 مات محمد بن أبي يحيى سنة أربع وأربعين ومائة(@)(@@)(@@)(@@) $ 10492 - محمد بن عطاء بن يحنس يروي عن خاله أبي العباس المدلجي عن بن الزبير روى عنه زمعة بن صالح(@)(@@)(@@)(@@) $ 10493 - محمد بن بلال القرشي يروي عن طاوس قال حب أبي بكر وعمر سنة روى عنه أبو معاوية الضرير(@)(@@)(@@)(@@) $ 10494 - محمد بن عبد الرحمن بن أسعد بن زرارة الأنصاري يروى عن PageV07P372 محمد بن عمرو بن الحسن عن جابر بن عبد الله روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 10495 - محمد بن عبد الله بن داود الأنصاري يروي عن محمد بن كعب روى عنه عمارة بن غزية وقد قيل بن داود(@)(@@)(@@)(@@) $ 10496 - محمد بن عفان القرشي كوفي يروي عن عبد الملك بن عمير روى عنه الحسن بن زياد اللؤلؤي(@)(@@)(@@)(@@) $ 10497 - محمد بن الوليد بن عامر الكندي من أهل حمص كنيته أبو الهذيل يروي عن الزهري روى عنه عبد الله بن سالم وأهل بلده مات سنة ست أو سبع وأربعين ومائة وهو بن سبعين سنة وكان من الحفاظ المتقنين والفقهاء في الدين أقام مع الزهري عشر سنين حتى احتوى على أكثر عمله وهو من الطبقة الأولى من أصحاب الزهري(@)(@@)(@@)(@@) $ 10498 - محمد بن إبراهيم بن أبي فضالة بن ثابت بن قيس بن الشماس الأنصاري من أهل المدينة يروي عن عبد الرحمن بن عثمان بن الأرقم بن أبي الأرقم روى عنه إسحاق بن سليمان الرازي PageV07P373(@)(@@)(@@)(@@) $ 10499 - محمد بن عمرو بن ثابت العتواري الليثي من أهل المدينة يروي عن أبي سعيد الخدري روي عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 10500 - محمد بن عبد الله بن عبد القاري يروي عن أبيه عن عمر روى عنه ابنه عبد الرحمن بن محمد بن عبد الله والزهري(@)(@@)(@@)(@@) $ 10501 - محمد بن السائب بن بركة يروي عن عمرو بن ميمون الأودي روى عنه سفيان بن عيينة(@)(@@)(@@)(@@) $ 10502 - محمد بن عبد الرحمن السدوسي كنيته أبو عبد الرحمن من أهل الكوفة يروي عن الكوفيين وكان كاتبا لمحارب بن دثار حيث ولى القضاء عندهم روى عنه مروان بن معاوية 
ms1223	 ووكيع(@)(@@)(@@)(@@) $ 10503 - محمد بن الوليد بن الوليد أبو المفضل العنزي كوفي يروي عن عاصم عن الشعبي عن بن عباس شرب النبي صلى الله عليه وسلم وهو قائم روى عنه محمد بن عكاشة الكرماني(@)(@@)(@@)(@@) $ 10504 - محمد بن حرب الثعلبي كوفي يروي عن أبيه عن عبد الله بن PageV07P374 المعقل روى عنه يحيى بن يعلى السلمي(@)(@@)(@@)(@@) $ 10505 - محمد بن سلمة بن كهيل يروي عن أبيه عن عدسة الطائي حدثت أن لعق الصحاف يعدل بعتق رقبة روى عنه بن عيينة(@)(@@)(@@)(@@) $ 10506 - محمد بن شيبة بن نعامة الضبي يروي عن أبي إسحاق السبيعي روى عنه خارجة بن مصعب(@)(@@)(@@)(@@) $ 10507 - محمد بن أبي بكر بن عبد الرحمن يروي عن أبي سلمة بن عبد الرحمن روى عنه سليمان التيمي(@)(@@)(@@)(@@) $ 10508 - محمد بن سليمان بن علي بن عبد الله بن عباس يروي عن أبيه عن جده روى عنه صالح الناجي(@)(@@)(@@)(@@) $ 10509 - محمد بن عبد الله شيخ يروي عن المطلب بن حنطب روى عنه زيد بن أبي أنيسة(@)(@@)(@@)(@@) $ 10510 - محمد بن قيس النخعي من أهل الكوفة يروي عن الحكم PageV07P375 والكوفيين روى عنه زيد بن أبي أنيسة وأهل بلده يخطئ ويخالف وهو محمد بن قيس بن أبي لحية وقد قيل إنه رأى الحسين بن علي مخضوبا بالوسمة(@)(@@)(@@)(@@) $ 10511 - محمد بن حصين بن سياه أخو سليمان بن حصين يروي عن جدته أم سنبلة روى عنه عمرو بن قيظى(@)(@@)(@@)(@@) $ 10512 - محمد بن صهيب يروي عن المدنيين روى عنه بن أبي مليكة وكان راويا لعبد الملك بن مروان(@)(@@)(@@)(@@) $ 10513 - محمد بن بجاد بن سعد بن أبي وقاص القرشي الزهري من أهل المدينة يروي عن عائشة بنت سعد عن أبيها روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 10514 - محمد بن عبد الله بن حصين الأسلمي يروي عن سعيد بن المسيب روى عنه عبد الرحمن بن حرملة(@)(@@)(@@)(@@) $ 10515 - محمد بن القاسم بن محمد بن شريح يروي عن الحجازيين روى عنه عبيد الله بن موهب(@)(@@)(@@)(@@) $ 10516 - محمد بن الحجاج من ولد أبي لبابة الأنصاري من أهل PageV07P376 المدينة يروي 
ms1224	 عن أبيه عن جده روى عنه عاصم بن سويد الأنصاري(@)(@@)(@@)(@@) $ 10517 - محمد بن عمرو بن حلحلة الديلي من أهل المدينة يروي عن محمد بن عمرو بن عطاء والمدنيين روى عنه مالك وابن إسحاق وكان ذا هيبة لازما لمسجد رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 10518 - محمد بن عمرو بن علقمة بن وقاص الليثي من أهل المدينة يروي عن أبي سلمة بن عبد الرحمن كنيته أبو الحسن روى عنه مالك والثوري والناس مات سنة أربع أو خمس وأربعين ومائة وكان يخطئ(@)(@@)(@@)(@@) $ 10519 - محمد بن طلحة بن يزيد بن ركانة بن عبد يزيد المطلبي القرشي يروي عن عبيد الله الخولاني وعكرمة روى عنه محمد بن إسحاق بن يسار مات في أول ولاية هشام بن عبد الملك بالمدينة(@)(@@)(@@)(@@) $ 10520 - محمد بن إبراهيم اليشكري من أهل البصرة يروي عن أم كلثوم بنت ثمامة عن عائشة روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 10521 - محمد بن خالد بن سلمة المخزومي أخو عكرمة بن خالد يروي عن أبيه والمقبري روى عنه عبد الله بن أبي الأسود وهو الذي روى عنه PageV07P377 هشيم وقال حدثنا محمد بن خالد القرشي عن المقبري(@)(@@)(@@)(@@) $ 10522 - محمد بن القاسم الأسدي شيخ يروي عن الشعبي أن عمر قال أشعر العرب النابغة وكنية النابغة أبو أمامة روى عنه معاوية بن قرة(@)(@@)(@@)(@@) $ 10523 - محمد بن الأسود مولى لسعد بن أبي وقاص يروي عن أم ولد لسعد عن سعد روى عنه سعيد بن عبد الله بن جبير بن حية(@)(@@)(@@)(@@) $ 10524 - محمد بن طارق المكي يروي عن طاوس ومجاهد روى عنه الثوري وابن عيينة(@)(@@)(@@)(@@) $ 10525 - محمد بن جعفر المخزومي الحجازي يروى عن بن الحنفية عن علي روى عبد الرحمن بن إسحاق عن أبيه عنه(@)(@@)(@@)(@@) $ 10526 - محمد بن معاذ بن أبي بن كعب يروي عن أبيه روى عنه ابنه معاذ بن محمد PageV07P378(@)(@@)(@@)(@@) $ 10527 - محمد بن مسلم بن جماز مولى بني تيم كنيته أبو عبد الله يروي عن جماعة من التابعين روى عنه أهل المدينة مات سنة تسع وسبعين ومائة وكان من 
ms1225	 أهل العلم يتفقه ويحفظ ثم ترك العلم وأقبل على العبادة إلى أن مات(@)(@@)(@@)(@@) $ 10528 - محمد بن صفوان شيخ يروي عن محمد بن زياد الألهاني روى عنه حماد بن خالد الخياط(@)(@@)(@@)(@@) $ 10529 - محمد بن ذكوان يروي عن محمد بن كعب القرظي روى عنه أبو عون الزيادي محمد بن عون(@)(@@)(@@)(@@) $ 10530 - محمد بن عمرو شيخ يروي عن وهب بن منبه روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 10531 - محمد بن سليم المكي كنيته أبو عثمان وقد قيل أبو هلال يروي عن بن أبي مليكة روى عنه وكيع بن الجراح وليس هذا بأبي هلال الراسبي محمد بن سليم ذاك بصري وهذا مكي وقد روى وكيع عنهما PageV07P379(@)(@@)(@@)(@@) $ 10532 - محمد بن عبد الله بن قيس بن مخرمة القرشي من بني عبد مناف أخو حكيم بن عبد الله يروي عن الحسن بن محمد بن علي روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10533 - محمد بن أبي أيوب أبو عاصم الثقفي من أهل الكوفة يروي عن الشعبي وقيس بن مسلم الجدلي روى عنه الكوفيون بن إدريس ووكيع وغيرهما(@)(@@)(@@)(@@) $ 10534 - محمد بن إسحاق بن يسار مولى عبد الله بن قيس بن مخرمة القرشي من أهل المدينة كنيته أبو بكر وكان جده من سبي عين التمر وهو أول سبي دخل المدينة من العراق يروي عن الزهري ونافع روى عنه الثوري وشعبة والناس مات سنة إحدى أو اثنتين وخمسين ومائة ببغداد وقد قيل سنة خمسين ومائة وله أخوان أبو بكر وعمر ابنا إسحاق وقد تكلم في بن إسحاق رجلان هشام بن عروة PageV07P380 ومالك بن أنس فأما هشام بن عروة فحدثني محمد بن زياد الزيادي قال ثنا بن أبي شيبة قال ثنا علي بن المديني قال سمعت يحيى بن سعيد القطان يقول قلت لهشام بن عروة إن بن إسحاق يحدث عن فاطمة بنت المنذر قال وهل كان يصل إليها قال أبو حاتم رضى الله عنه وهذا الذي قاله هشام بن عروة ليس مما يجرح به الإنسان في الحديث وذلك أن التابعين مثل الأسود وعلقمة من 
ms1226	 أهل العراق وأبي سلمة وعطاء ودونهما من أهل الحجاز قد سمعوا من عائشة من غير أن ينظروا إليها سمعوا صوتها وقبل الناس أخبارهم من غير أن يصل أحدهم إليها حتى ينظر إليها عيانا وكذلك بن إسحاق كان يسمع من فاطمة والستر بينهما مسبل أو بينهما حائل من حيث يسمع كلامها فهذا سماع صحيح والقادح فيه بهذا غير منصف وأما مالك فإنه كان ذلك منه مرة واحدة PageV07P381 ثم عاد له إلى ما يحب وذلك أنه لم يكن بالحجاز أحد أعلم بأنساب الناس وأيامهم من محمد بن إسحاق وكان يزعم أن مالكا من موالي ذي أصبح وكان مالك يزعم أنه من أنفسهم فوقع بينهما لهذا مفاوضة فلما صنف مالك الموطأ قال بن إسحاق ائتوني به فإني بيطاره فنقل ذلك إلى مالك فقال هذا دجال من الدجاجلة يروي عن اليهود وكان بينهم ما يكون بين الناس حتى عزم محمد بن إسحاق على الخروج إلى العراق فتصالحا حينئذ فأعطاه مالك عند الوداع خمسين دينارا نصف ثمرته تلك السنة ولم يكن يقدح فيه مالك من أجل الحديث إنما كان ينكر عليه تتبعه غزوات النبي صلى الله عليه وسلم عن أولاد اليهود الذين أسلموا وحفظوا قصة خيبر وقريظة والنضير وما أشبهها من الغزوات عن أسلافهم وكان بن إسحاق يتتبع هذا PageV07P382 عنهم ليعلم من غير أن يحتج بهم وكان مالك لا يرى الرواية إلا عن متقن صدوق فاضل يحسن ما يروي ويدري ما يحدث حدثني محمد بن عبد الرحمن قال ثنا بن قهزاد قال ثنا علي بن الحسين بن واقد قال دخلت على بن المبارك وإذا هو وحده فقلت يا أبا عبد الرحمن كنت أشتهى أن ألقاك على هذه الحالة قال هات قلت ما تقول في محمد بن إسحاق فقال أما إنا وجدناه صدوقا ثلاث مرات سمعت محمد بن إسحاق الثقفي يقول سمعت المفضل بن غسان يقول سمعت يحيى بن معين يقول كان محمد بن إسحاق ثبتا في الحديث قال أبو حاتم رضي الله عنه لم يكن 
ms1227	 أحد بالمدينة يقارب بن إسحاق في علمه ولا يوازيه في جمعه وكان شعبة وسفيان يقولان محمد بن إسحاق أمير المؤمنين في الحديث ومن أحسن الناس سياقا للأخبار وأحسنهم حفظا لمتونها وإنما أتي ما أتي لأنه كان يدلس على الضعفاء فوقع المناكير في روايته من قبل أولئك فأما PageV07P383 إذا بين السماع فيما يرويه فهو ثبت يحتج بروايته سمعت محمد بن إسحاق بن خزيمة يقول سمعت محمد بن يحيى الذهلي وسأله كرخويه عن محمد بن إسحاق فقال سمعت علي بن المديني يقول محمد بن إسحاق صدوق والدليل على صدقه أنه ما روى عن أحد من الجلة إلا وروى عن رجل عنه فهذا يدل على صدقه سمعت محمد بن أحمد المسندي يقول سمعت محمد بن نصر الفراء يقول قلت لعلي بن المديني ما تقول في محمد بن إسحاق فقال ثقة قد أدرك نافعا وروى عنه وروى عن رجل عنه وعن رجل عن رجل عنه هل يدل هذا إلا على الصدق قال أبو حاتم رضى الله عنه كان محمد بن إسحاق يكتب عمن فوقه ومثله ودونه لرغبته في العلم وحرصه عليه وربما يروي عن رجل عن رجل قد رآه ويروى عن آخر عنه في موضع آخر ويروي عن رجل عن رجل عنه فلو كان ممن يستحل الكذب لم يحتج إلى الإنزال بل كان يحدث عمن رآه ويقتصر عليه فهذا مما يدل على صدقه وشهرة عدالته في الروايات وإنما يمعن الكلام في PageV07P384 هذا الفصل عند ذكرنا إياه في كتاب الفصل بين النقلة إن قضى الله ذلك وشاء سمعت محمد بن أحمد المسندي يقول سمعت محمد بن نصر الفراء يقول سمعت يحيى بن يحيى وذكر عنده محمد بن إسحاق فوثقه(@)(@@)(@@)(@@) $ 10535 - محمد بن صالح بن قيس الأزرق المدني مولى بني الحارث بن فهر يروي عن زيد بن أسلم ومسلم بن أبي مريم روى عنه أبو ثابت محمد بن عبيد الله ويعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 10536 - محمد بن عمران بن عبد الله الأنصاري يروي عن أبيه عن 
ms1228	 بن عمر روى عنه محمد بن عمرو بن حلحلة(@)(@@)(@@)(@@) $ 10537 - محمد بن خارجة بن عبد الله بن نافع يروي عن عكرمة روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 10538 - محمد بن القاسم بن أبي الرازقي مولى لقريش يروي عن الحسن روى عنه عبد الرحمن بن مهدي(@)(@@)(@@)(@@) $ 10539 - محمد بن أيوب بن ميسرة بن حلبس الجبلاني من أهل الشام PageV07P385 كنيته أبو بكر يروي عن أبيه عن بسر بن أرطأة روى عنه الوليد بن مسلم وهشام بن عمار(@)(@@)(@@)(@@) $ 10540 - محمد بن القاسم يروي عن عبد الله بن حنظلة عن عبد الله بن سلام روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 10541 - محمد بن كعب الطفاوي يروي عن ميمون بن مهران روى عنه سعيد بن أبي عروبة(@)(@@)(@@)(@@) $ 10542 - محمد بن صالح بن إبراهيم بن عبد الرحمن بن عوف يروي عن أبيه وأبوه سمع أنسا فيما يقال روى عنه ابنه صالح بن محمد بن صالح(@)(@@)(@@)(@@) $ 10543 - محمد بن عجلان مولى فاطمة بنت عتبة بن ربيعة بن عبد شمس القرشي من أهل المدينة يروي عن أبيه وسعيد المقبري روى عنه الثوري ومالك عنده صحيفة عن سعيد المقبري بعضها عن أبيه عن أبي هريرة وبعضها عن أبي هريرة نفسه قال يحيى القطان سمعت محمد بن عجلان يقول كان سعيد المقبري يحدث عن أبيه عن أبي هريرة وعن أبي هريرة فاختلط على فجعلتها كلها عن أبي هريرة قال PageV07P386 أبو حاتم رضي الله عنه وقد سمع سعيد المقبري من أبي هريرة وسمع عن أبيه عن أبي هريرة فلما اختلط علي بن عجلان صحيفته ولم يميز بينهما اختلط فيها وجعلها كلها عن أبي هريرة وليس هذا مما يهى الإنسان به لأن الصحيفة كلها في نفسها صحيحة فما قال بن عجلان عن سعيد عن أبيه عن أبي هريرة فذاك مما حمل عنه قديما قبل اختلاط صحيفته عليه وما قال عن سعيد عن أبي هريرة فبعضها متصل صحيح وبعضها منقطع لأنه أسقط أباه منها فلا يجب الاحتجاج عند الاحتياط إلا بما يروي الثقات المتقنون عنه عن 
ms1229	 سعيد عن أبيه عن أبي هريرة وإنما كان يهي أمره ويضعف لو قال في الكل سعيد عن أبي هريرة فإنه لو قال ذلك لكان كاذبا في البعض لأن الكل لم يسمعه سعيد عن أبي هريرة فلو قال ذلك لكان الاحتجاج به ساقطا على حسب ما ذكرناه ومات محمد بن عجلان سنة ثمان وأربعين ومائة حدثنا محمد بن أحمد المسندي قال ثنا محمد بن نصر الفراء قال ثنا أحمد بن حنبل قال ثنا محمد بن PageV07P387 إدريس الشافعي عن مالك عن بن عجلان قال إذا أغفل العالم لا أدري أصيبت مقالته(@)(@@)(@@)(@@) $ 10544 - محمد بن أيوب شيخ يروي عن بن حسن بن عبد الرحمن بن عوف عن أنس بن مالك روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 10545 - محمد بن أبي كريمة يروي المراسيل روى عنه إبراهيم بن حجر(@)(@@)(@@)(@@) $ 10546 - محمد بن طلحة بن مصرف اليامي كنيته أبو عبد الله من أهل الكوفة يروي عن أبيه عن أنس بن مالك روى عنه الكوفيون كان يخطىء مات سنة سبع وستين ومائة(@)(@@)(@@)(@@) $ 10547 - محمد بن السائب التيمي من أهل الكوفة يروي عن إبراهيم النخعي روى عنه المغيرة بن مقسم كان مرجيا صدوقا في الرواية وكان النخعي يقول له ما دمت على هذا الرأي فلا تقربنا(@)(@@)(@@)(@@) $ 10548 - محمد بن مسلم بن عائذ المدني يروي عن عامر بن سعد بن أبي وقاص روى عنه سهيل بن أبي صالح قتل سنة إحدى وثلاثين ومائة PageV07P388(@)(@@)(@@)(@@) $ 10549 - محمد بن أيوب أبو عبد الملك الأزدي من أهل الشام يروي عن أبي علقمة عن أبي هريرة ويحيى بن عباد عن أبي ذر روى عنه معاوية بن صالح وعبيد الله بن زحر(@)(@@)(@@)(@@) $ 10550 - محمد بن عبد الرحمن أبو عيسى المؤذن من أهل مصر يروي عن أبي مرزوق التجيبي عن عثمان روى عنه الليث بن سعد وسعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 10551 - محمد بن مسلم ولقبه الجوسق من أهل المدينة يروي عن سعيد بن المسيب روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 10552 - محمد بن مالك بن زبيد الهمداني الخيواني كوفي 
ms1230	 يروي عن أبيه عن علي وابن مسعود روى عنه عبد الله بن عثمان الثقفي والكوفيون(@)(@@)(@@)(@@) $ 10553 - محمد بن صالح يروي عن عطية العامري روى عنه أبو إسحاق الفزاري PageV07P389(@)(@@)(@@)(@@) $ 10554 - محمد الكناني يروي المراسيل روى عنه عيسى بن عبيد(@)(@@)(@@)(@@) $ 10555 - محمد بن صالح بن دينار التمار من أهل المدينة يروي عن الزهري والقاسم بن محمد روى عنه عبد الله بن نافع الصائغ وكنيته أبو عبد الله مات سنة ثمان وخمسين ومائة وهو بن ثمانين سنة(@)(@@)(@@)(@@) $ 10556 - محمد بن عبد الرحمن بن المغيرة بن أبي ذئب كنيته أبو الحارث واسم أبي ذئب هشام بن شعبة بن عبد الله بن أبي قيس بن عبد ود أمه بريهة بنت عبد الرحمن بن أبي ذئب أخت الحارث بن عبد الرحمن بن أبي ذئب يروي عن نافع وأهل المدينة روى عنه الحجازيون وأهل العراق وكان من فقهاء أهل المدينة وعبادهم وكان من أقول أهل زمانه بالحق دعاهم الرشيد فاجتمعوا إليه وفيهم مالك بن أنس وابن أبي ذئب وسائر فقهاء المدينة فسألهم PageV07P390 عن سيرته فكلهم قال ما حضره من تحسين ما هو عليه فسأل بن أبي ذئب عن ذلك فقال إن رأى أمير المؤمنين أن يعفيني عن هذا فعل فقال سألتك إلا صدقت قال أما بعد إن سألت فإني أراك ظالما غشوما قعدت في أمر ليس هو لك وغصبته عمن هو له بحق ثم تأخذ الأموال من حيث لا يحل لك وتنفقها فيما لا يرضى الله ورسوله ولو وجدت أعوانا لخلعتك من هذا الأمر وأدخلت فيه من هو أنصح لله وللمسلمين منك فأطرق الرشيد برأسه قال مالك فضممت إلى ثيابي كي لا يصيبني من دمه فرفع الرشيد رأسه فقال أما إنك أصدق القوم ثم قال لهم قوموا وأضعف لابن أبي ذئب في العطية وكان مع هذا يرى القدر ويقول به وكان مالك يهجره من أجله وكان مولده سنة ثمانين ومات سنة تسع وخمسين ومئة وكان له يوم مات تسع وسبعون سنة PageV07P391(@)(@@)(@@)(@@) $ 10557 - محمد بن أبان الأنصاري من 
ms1231	 أهل المدينة يروي عن القاسم بن محمد وعروة بن الزبير روى عنه يحيى بن أبي كثير ومنصور بن المعتمر ومن زعم أنه سمع من عائشة فقد وهم وليس هذا بمحمد بن أبان الجعفي ذلك من أهل الكوفة ضعيف وهذا مدني ثبت(@)(@@)(@@)(@@) $ 10558 - محمد بن قيس الزيات والد يحيى بن محمد بن قيس من أهل البصرة يروي عن سعيد بن المسيب روى عنه عثمان بن عمر بن فارس والعقدي(@)(@@)(@@)(@@) $ 10559 - محمد بن أبي محمد مولى زيد بن ثابت الأنصاري يروي عن سعيد بن جبير وعكرمة روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 10560 - محمد بن أبي جميلة النصري من أهل حمص يروي عن عبد الله بن أبي قيس عن عائشة روى عنه يحيى بن صالح الوحاظي(@)(@@)(@@)(@@) $ 10561 - محمد بن شداد يروي عن عبد الرحمن بن يزيد روى عنه الحسن بن عبيد الله PageV07P392(@)(@@)(@@)(@@) $ 10562 - محمد بن قيس مولى يعقوب القبطي قاضي عمر بن عبد العزيز يروي عن الحجازيين روى عنه محمد بن إسحاق وحماد بن سلمة(@)(@@)(@@)(@@) $ 10563 - محمد بن صالح بن شريح يروي عن أبيه روى عنه محمد بن الوليد بن عامر الزبيدي(@)(@@)(@@)(@@) $ 10564 - أبو الطفيل اسمه محمد بن طلحة بن عبد الله بن عثمان بن عبيد الله بن عثمان بن عمرو بن كعب بن سعيد بن تيم بن مرة يروي عن جماعة من التابعين روى عنه الناس مات سنة ثمانين ومائة PageV07P393(@)(@@)(@@)(@@) $ 10565 - محمد بن إسماعيل بن مجمع الأنصاري أخو إبراهيم بن إسماعيل يروي عن المدنيين وابن عبد العزيز وقد أدرك أبا أمامة بن سهل بن حنيف روى عنه مجمع بن يعقوب وعاصم بن سويد(@)(@@)(@@)(@@) $ 10566 - محمد بن أبي جعفر المدني يروي عن سالم بن عبد الله روى عنه هشيم بن بشير(@)(@@)(@@)(@@) $ 10567 - محمد بن جعفر بن الزبير بن العوام القرشي يروي عن عروة بن الزبير عن عائشة وعباد بن عبد الله بن الزبير بن عمه وكان من فقهاء أهل المدينة وقرائهم روى عنه بن إسحاق وعبد الله بن أبي جعفر(@)(@@)(@@)(@@) $ 10568 - محمد بن صبيح 
ms1232	 القارئ السعدي من أهل البصرة يروي عن الحسن روى عنه البصريون ومن زعم أن هذا بن السماك فقد وهم لأن بن السماك لم يلق الحسن وهذا شيخ جالس الحسن البصري(@)(@@)(@@)(@@) $ 10569 - محمد بن إسماعيل بن سعد بن أبي وقاص يروي المراسيل روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10570 - محمد بن طهمان يروي عن يحيى بن يعمر روى عنه المغيرة بن مسلم السراج PageV07P394(@)(@@)(@@)(@@) $ 10571 - محمد بن زياد الصنعاني يروي المراسيل والمقاطيع روى عنه بن المبارك(@)(@@)(@@)(@@) $ 10572 - محمد بن مسلم أبو ثمامة البصري يروي عن أبي خلدة عن عمار بن ياسر روى عنه عبد الله بن رجاء الغداني(@)(@@)(@@)(@@) $ 10573 - محمد بن أبي السماك العطار من أهل البصرة يروي عن أم طلحة عن عائشة روى عنه محمد بن عقبة السدوسي وكان راويا لسلمة بن علقمة(@)(@@)(@@)(@@) $ 10574 - محمد بن حرب أخو سماك بن حرب يروي عن بن جرير عن أبيه عن النبي صلى الله عليه وسلم قال من شرب الخمر فاجلدوه رواه إبراهيم بن طهمان عن سماك بن حرب عن أخيه محمد بن حرب(@)(@@)(@@)(@@) $ 10575 - محمد بن جعفر الزبيري يروي عن هشام بن عروة روى عنه PageV07P395 محمد بن خالد بن عثمة يخطئ ويخالف روى هشام بن عروة عن أبيه عن عائشة قالت ما كان النبي صلى الله عليه وسلم يفسر شيئا من القرآن إلا آيا علمهن إياه جبرائيل حدثناه الطبري قال ثنا بندار قال ثنا بن عثمة قال ثنا محمد بن جعفر قال ثنا هشام بن عروة ويشبه أن يكون معنى التفسير للآية بعينها وأما سنته كلها فهي تفسير القرآن قال الله عز وجل وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم(@)(@@)(@@)(@@) $ 10576 - محمد بن سالم يروي عن محمد بن كعب القرظي روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 10577 - محمد بن خالد الوهبي من أهل حمص يروى عن بن جريج أخو أحمد بن خالد روى عنه الشاميون(@)(@@)(@@)(@@) $ 10578 - محمد بن عباد بن عبد الله بن الزبير بن العوام يروي عن أبيه عن عائشة روى عنه بن 
ms1233	 المبارك وطلق بن غنام PageV07P396(@)(@@)(@@)(@@) $ 10579 - محمد بن أبي الجعد يروي عن الشعبي روى عنه الثوري(@)(@@)(@@)(@@) $ 10580 - محمد بن عقبة اليشكري يروي عن الحسن روى عنه بن المبارك وأهل البصرة(@)(@@)(@@)(@@) $ 10581 - محمد بن بشر بن بشير بن معبد الأسلمي يروي عن أبيه روى عنه بن المبارك وطلق بن غنام(@)(@@)(@@)(@@) $ 10582 - محمد بن موسى بن الحارث يروي عن أبيه عن جابر بن عبد الله روى عنه عاصم بن سويد الأنصاري(@)(@@)(@@)(@@) $ 10583 - محمد بن سالم يروي عن ثابت البناني روى عنه محمد بن عيسى بن الطباع وأهل البصرة أحسبه الذي روى عن محمد بن كعب القرظي(@)(@@)(@@)(@@) $ 10584 - محمد بن إسحاق بن طلحة بن عبيد الله التيمى القرشي يروى عن PageV07P397 أبي بردة روى عنه عبد الله بن عثمان بن خثيم(@)(@@)(@@)(@@) $ 10585 - محمد بن سمير الرعيني كنيته أبو الصباح من أهل مصر وقد قيل محمد بن شمير وقيل أيضا محمد بن شمر يروي عن أبي على الهمداني روى عنه المصريون وأحسبه الذي يروي عن كعب الذي روى عنه عبد الرحمن بن شريح(@)(@@)(@@)(@@) $ 10586 - محمد بن أبي البلاط أبو العباس يروي عن زيد بن أبى عتاب عن بن عمر روى عنه محمد بن صالح(@)(@@)(@@)(@@) $ 10587 - محمد بن سهل بن أبي حثمة الأنصاري الأوسي يروي عن أبيه عن على روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 10588 - محمد بن عمرو بن سعيد بن العاص يروي عن أبيه عن أبي هريرة قال إذا صلى أحدكم بأرض فلاة فلينصب تلقاء وجهه شيئا فإن لم يجد فليخط في الأرض خطا موقوف رواه يزيد بن هارون PageV07P398 عن نصر بن حاجب القرشي عن إسماعيل بن أمية عنه(@)(@@)(@@)(@@) $ 10589 - محمد بن طريف يروي عن جابر بن زيد أبي الشعثاء روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 10590 - محمد بن طريف يروي عن سعيد بن المسيب روى عنه رجاء بن أبي سلمة(@)(@@)(@@)(@@) $ 10591 - محمد بن بشر التيمي يروي عن أبي سعيد عقيصا عن علي روى عنه هشيم بن بشير(@)(@@)(@@)(@@) $ 10592 - محمد بن مسلم الطائفي يروي عن عمرو بن دينار 
ms1234	 وإبراهيم بن ميسرة روى عنه يحيى بن سليم الطائفي وأهل العراق كان يخطىء وزعم عبد الرحمن بن مهدي أن كتب محمد بن مسلم صحاح(@)(@@)(@@)(@@) $ 10593 - محمد بن زياد البرجمي يروي عن ثابت البناني روى عنه البصريون(@)(@@)(@@)(@@) $ 10594 - محمد بن عروة بن رويم اللخمي من أهل الشام يروي عن أبيه روى عنه الحجاج بن فرافصة(@)(@@)(@@)(@@) $ 10595 - محمد بن عبيد الكندي أبو جابر يروي عن أبيه روى عنه PageV07P399 مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 10596 - محمد بن عبيد الله بن أبي رافع يروي عن أبيه روى عنه يحيى بن يعلى الأسلمي(@)(@@)(@@)(@@) $ 10597 - محمد بن عقبة بن أبي عتاب من أهل المدينة يروي عن أبيه عن أبي هريرة روى عنه سليمان بن بلال(@)(@@)(@@)(@@) $ 10598 - محمد بن الحكم الكاهلي يروي عن نوف البكالي روى عنه الأعمش(@)(@@)(@@)(@@) $ 10599 - محمد بن سفيان أبو سفيان الغبري من أهل البصرة يروي عن مورق العجلي روى عنه التبوذكي(@)(@@)(@@)(@@) $ 10600 - محمد بن أبي طويل يروي عن مجاهد روى عنه عثمان بن الأسود(@)(@@)(@@)(@@) $ 10601 - محمد بن تميم أبو عمارة يروي عن الحسن روى عنه حماد بن زيد PageV07P400(@)(@@)(@@)(@@) $ 10602 - محمد بن شبيب الزهراني من أهل البصرة يروي عن الحسن والشعبي وعبد الملك بن عمير روى عنه شعبة ومهدي بن ميمون وحماد بن زيد(@)(@@)(@@)(@@) $ 10603 - محمد بن أبي محمد يروي عن أبيه عن أبي هريرة عن النبي صلى الله عليه وسلم حجوا قبل أن لا تحجوا روى عبد الرزاق عن عبد الله بن بحير بن ريسان الصنعاني عنه وهذا خبر باطل وأبو محمد لا يدري من هو(@)(@@)(@@)(@@) $ 10604 - محمد بن حصين يروي عن أبي علقمة مولى بن عباس وكان أبو علقمة قاضيا بإفريقية روى عنه قدامة بن موسى(@)(@@)(@@)(@@) $ 10605 - محمد بن عبد الله بن أبي يعقوب الضبي من أهل البصرة يروي عن أبي نعم والحسن بن سعد روى عنه شعبة ومهدي بن ميمون PageV07P401(@)(@@)(@@)(@@) $ 10606 - محمد بن عمرو بن عتبة بن أبي لهب يروي عن الحجازيين وأبيه روى عنه معروف بن خربوذ وأبو الحجاف(@)(@@)(@@)(@@) $ 10607 - محمد 
ms1235	 بن جعفر بن أبي كثير الأنصاري مولى بني زريق من أهل المدينة أخو إسماعيل بن جعفر يروي عن حميد الطويل والعلاء بن عبد الرحمن روى عنه بن أبي مريم وقتيبة(@)(@@)(@@)(@@) $ 10608 - محمد بن الحجاج بن أبي قبيلة الخولاني يروي عن عبد الرحمن بن أبي هلال المصري عن أبي هريرة روى عنه عبد الله بن عبد الرحمن بن يزيد بن جابر(@)(@@)(@@)(@@) $ 10609 - محمد بن جابر بن جلاس الكلبي يروي عن أبيه عن عمر روى عنه عمرو بن قيس الملائي(@)(@@)(@@)(@@) $ 10610 - محمد بن عبد الله بن أفلح الطائفي الثقفي يروي عن بشر بن عاصم روى عنه الثوري وابن المبارك(@)(@@)(@@)(@@) $ 10611 - محمد بن خثيم أبو يزيد المحاربي يروي عن محمد بن كعب PageV07P402 القرظي روى عنه ابنه يزيد بن محمد بن خثيم(@)(@@)(@@)(@@) $ 10612 - محمد بن عمران بن عبد الرحمن بن طلحة بن أبي طلحة يروي عن جماعة من التابعين روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 10613 - محمد بن الزبير مولى المعيطيين كنيته أبو بشر إمام مسجد حران وكان معلما لبني هاشم بالرصافة يروي عن الزهري روى عنه أهل بلده أبو جعفر النفيلي وغيره مات في ولاية المهدي(@)(@@)(@@)(@@) $ 10614 - محمد بن عبد الله بن عباد يروي عن عباد بن عبد الله بن الزبير روى فليح عن صالح بن عجلان عنه(@)(@@)(@@)(@@) $ 10615 - محمد بن سيف الأزدي أبو رجاء الذي يروي عن الحسن من أهل البصرة روى عنه شعبة والبصريون PageV07P403(@)(@@)(@@)(@@) $ 10616 - محمد بن جحادة الأودي من أهل الكوفة يروي عن الحسن وقتادة روى عنه أهل الكوفة والبصرة وكان عابدا ناسكا ومن زعم أنه سمع من أنس فقد وهم تلك روايات يتفرد بها يحيى بن عقبة بن أبي العيزار وهو واه وسعيد بن زيد أخو حماد بن زيد(@)(@@)(@@)(@@) $ 10617 - محمد بن محمد بن الأسود من بني زهرة وأمه من ولد سعد يروي عن خاله عامر بن سعد بن أبى وقاص روى عنه بن عون(@)(@@)(@@)(@@) $ 10618 - محمد بن سوقة الغنوي كان ينزل غنى وهو مولى جرير بن عبد الله البجلي من 
ms1236	 أهل الكوفة يروي عن نافع وعبد الله بن دينار وابن المنكدر وقد قيل إنه رأى أنسا وأبا الطفيل روى عنه الثوري وابن عيينة وأهل العراق كنيته أبو بكر ويقال أبو عبد الله وكان من القراء ومن أهل العبادة والفضل والدين والسخاء أنفق على أهل العلم عشرين ومائة ألف درهم وقد زامل رفيقا له إلى مكة فكانا إذا أصبحا أخذا في البكاء فيراهما الجمال فيقول ما شأنكما أجاءكما من أهلكما خبر PageV07P404(@)(@@)(@@)(@@) $ 10619 - محمد بن عمران بن بشير يروي عن الزهري روى عنه وهب بن عثمان(@)(@@)(@@)(@@) $ 10620 - محمد بن عبد الرحمن بن يزيد يروي عن أبيه عن عبد الله روى عنه الحسن بن عمرو الفقيمي(@)(@@)(@@)(@@) $ 10621 - محمد بن المنذر بن الزبير بن العوام يروي المراسيل والمقاطيع روى عنه فليح بن محمد وهو أخو عبد الله بن المنذر(@)(@@)(@@)(@@) $ 10622 - محمد بن فروخ أبو سهل صاحب الساج من أهل البصرة يروي عن محمد بن زياد روى عنه عبد الوهاب بن عطاء وهو الذي يروي عنه بشر بن المفضل ويقول حدثنا محمد بن أبي سهل(@)(@@)(@@)(@@) $ 10623 - محمد بن عرفطة الطائي من أهل البصرة يروي عن سلم العلوي عن أنس روى عنه جهير بن يزيد(@)(@@)(@@)(@@) $ 10624 - محمد بن الحر يروى عن بن سيرين عداده في أهل البصرة PageV07P405 روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 10625 - محمد الزهري الكوفي قوله روى عنه بن عون إن لم يكن محمد بن محمد بن الأسود فلا أدري من هو(@)(@@)(@@)(@@) $ 10626 - محمد بن عبد الله الكناني يروي عن عطاء وعمرو بن دينار روى يعقوب بن محمد الزهري عن إسحاق بن جعفر عنه(@)(@@)(@@)(@@) $ 10627 - محمد بن عيسى الزرقي الأنصاري يروي عن أبيه عن خولة بنت قيس روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 10628 - محمد بن حذيفة بن دأب من أهل المدينة يروي عن عبد الله بن أبي قتادة وعبيد الله بن خويلد الغفاري روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 10629 - محمد بن عبد الله بن أبي سارة القريشي من أهل مكة يروي عن سالم 
ms1237	 بن عبد الله وزيد بن أسلم روى عنه بن المبارك PageV07P406(@)(@@)(@@)(@@) $ 10630 - محمد بن هلال قال سمعت سعيد بن المسيب يقول إذا قال الرجل على نذر مشى إلى الكعبة فقد وجب عليه وإذا قال علي المشي إلى الكعبة ولم ير نذرا فلا شيء عليه روى عنه زياد بن يونس الإسكندراني(@)(@@)(@@)(@@) $ 10631 - محمد بن خالد بن الحويرث القرشي من أهل مكة يروي عن أبيه عن عبد الله بن عمرو روى عنه عبد الواحد وروح بن عبادة(@)(@@)(@@)(@@) $ 10632 - محمد بن عبد الله بن المهاجر الشعيثي يروي عن زفر بن وثيمة روى عنه وكيع وعمر بن علي المقدمي(@)(@@)(@@)(@@) $ 10633 - محمد بن ميسرة بن أبي حفصة من أهل البصرة كنيته أبو سلمة يروي عن الزهري وعلي بن زيد روى عنه الثوري وابن المبارك وإبراهيم بن طهمان يخطئ(@)(@@)(@@)(@@) $ 10634 - محمد بن الحارث بن سفيان المخزومي من أهل مكة يروى عن PageV07P407 على الأزدي روى عنه بن جريج وابن عيينة(@)(@@)(@@)(@@) $ 10635 - محمد بن عبد الله بن حسين بن جعفر يروي عن بعض أهله المراسيل روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 10636 - محمد بن خالد بن رافع بن مكيث الجهني يروي عن عمه الحارث بن رافع روى عنه عثمان بن زفر(@)(@@)(@@)(@@) $ 10637 - محمد بن عبيد الله بن أبي يزيد المكي يروي عن أبيه عن بن عباس روى عنه بن جريج(@)(@@)(@@)(@@) $ 10638 - محمد بن أبي سهل يروي عن مكحول روى عنه أبو بكر بن عياش(@)(@@)(@@)(@@) $ 10639 - محمد بن الحارث بن زهدم يروي عن مالك بن أبي عامر روى عنه جويرية بن أسماء(@)(@@)(@@)(@@) $ 10640 - محمد بن ثابت بن شرحبيل يروي عن عبد الله بن سويد الخطمي عن أبي أيوب روى عنه يعقوب بن إبراهيم بن محمد بن طلحة بن PageV07P408 عبيد الله القرشي(@)(@@)(@@)(@@) $ 10641 - محمد بن مروان الهذلي يروي عن أبي حازم روى عنه أبو أحمد الزبيري وأبو نعيم(@)(@@)(@@)(@@) $ 10642 - محمد بن راشد أبو نضلة البصري يروي عن عطاء روى عنه يونس بن محمد المؤدب(@)(@@)(@@)(@@) $ 10643 - محمد بن أبي شعيب يروي عن وهب 
ms1238	 بن منبه قال من قرأ في ليلة الجمعة سورة البقرة وآل عمران كان له نور ما بين عجيبا وعريبا رواه أبو نعيم الفضل بن دكين عن إبراهيم الصنعاني عن محمد بن أبي شعيب قال محمد بن أبي شعيب عجيبا أسفل الأرض وعريبا أسفل العرش(@)(@@)(@@)(@@) $ 10644 - محمد بن عقبة أخو موسى بن عقبة مولى الزبير بن العوام يروي عن كريب روى عنه مالك بن أنس وابن عيينة PageV07P409(@)(@@)(@@)(@@) $ 10645 - محمد بن خالد الأنصاري يروي عن حنظلة بن قيس روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10646 - محمد بن عثمان بن عبد الله بن موهب يروي عن موسى بن طلحة سمع مع أبيه منه حديث أبي أيوب روى عنه شعبة بن الحجاج وعن أبيه معا هذا الحديث درها درها يعني الناقة(@)(@@)(@@)(@@) $ 10647 - محمد بن سعدان بن عبد الله بن جابر القرشي من بني عامر بن لؤي من أهل المدينة يروي عن أبيه عن أنس روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 10648 - محمد بن علوان شيخ يروي المراسيل والمقاطيع روى عنه فرات بن سلمان وفرات ضعيف(@)(@@)(@@)(@@) $ 10649 - محمد بن الخطاب بن جبير بن حية الثقفي من أهل البصرة يروي عن أبيه وأنس بن سيرين روى عنه موسى بن إسماعيل وأهل البصرة(@)(@@)(@@)(@@) $ 10650 - محمد بن عبد الرحمن بن أبي مسلم الأسدي يروى عن جده PageV07P410 أبي مسلم عن عمر روى عنه الحسن بن ثوبان(@)(@@)(@@)(@@) $ 10651 - محمد بن خوط يروي عن نافع وأبي حازم روى عنه خالد بن مخلد القطواني وعباس بن أبي شملة(@)(@@)(@@)(@@) $ 10652 - محمد بن عبد الله بن يحنس يروي عن القاسم بن محمد روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 10653 - محمد بن عمران الأنصاري يروى عن أبيه عن بن عمر روى عنه محمد بن عمرو بن حلحلة(@)(@@)(@@)(@@) $ 10654 - محمد بن عون مولى أم حكيم يروي عن أبيه روى عنه عبد العزيز بن عبد الله بن أبي سلمة الماجشون(@)(@@)(@@)(@@) $ 10655 - محمد بن عبيدة الربذي يروي عن أخيه عبد الله بن عبيدة عن عقبة بن عامر روى 
ms1239	 عنه أخوه موسى بن عبيدة الربذي(@)(@@)(@@)(@@) $ 10656 - محمد بن الحسن المزني من أهل واسط يروي عن إسماعيل بن أبي خالد كتب عنه أحمد بن حنبل والعراقيون وكان أحمد حسن الرأي فيه وليس هذا بمحمد بن الحسن بن أبي يزيد ذاك ضعيف PageV07P411(@)(@@)(@@)(@@) $ 10657 - محمد بن سلام الخزاعي يروي عن أبيه عن أبي هريرة روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 10658 - محمد بن عياش بن عمرو العامري من أهل الكوفة يروي عن أبي إسحاق والأعمش روى عنه عبيد الله بن عبد المجيد الحنفي(@)(@@)(@@)(@@) $ 10659 - محمد بن ميمون بن كعب بن الخزرج الأنصاري من بلحارث بن الخزرج من أهل المدينة يروي عن أبيه عن جده روى عنه محمد بن عبد الله الأنصاري(@)(@@)(@@)(@@) $ 10660 - محمد بن راشد السلمي من أهل الكوفة أخو إسماعيل بن راشد كنية راشد أبو إسماعيل يروي عن سعيد بن جبير روى عنه الثوري مات سنة ثنتين وأربعين ومائة(@)(@@)(@@)(@@) $ 10661 - محمد بن معن بن نضلة الغفاري من أهل المدينة يروي عن أبيه روى عنه بن ابنه محمد بن معن بن محمد بن معن PageV07P412(@)(@@)(@@)(@@) $ 10662 - محمد بن عبد الرحمن بن عبد الله يروي عن طريف البراد عن أبي هريرة روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10663 - محمد بن مهاجر شيخ يروي عن أبي جعفر محمد بن علي روى عنه المطلب بن زياد وليس هذا بمحمد بن المهاجر الشامي(@)(@@)(@@)(@@) $ 10664 - محمد بن أبي الدرداء يروي عن الشعبي عداده في أهل الكوفة روى عنه الفريابي(@)(@@)(@@)(@@) $ 10665 - محمد بن عبد الرحمن بن عبد الله بن حصين التميمي يروي عن عوف بن الحارث عن أم سلمة روى عنه محمد بن إسحاق وكان صواما قواما من المتعبدين(@)(@@)(@@)(@@) $ 10666 - محمد بن هانئ شيخ يروي عن الزهري روى عنه أبو ثوبان(@)(@@)(@@)(@@) $ 10667 - محمد بن مهاجر الدمشقي مولى أسماء بنت يزيد الأشعرية أخو عمرو بن مهاجر يروي عن أبيه وكيسان مولى معاوية روى عنه عبد الله بن يوسف وأهل الشام مات سنة سبع وثلاثين PageV07P413 ومائة وهو بن أربع وسبعين سنة وكان متقنا 
ms1240	 وأخوه عمرو واه وقد ذكرناه في كتاب الضعفاء(@)(@@)(@@)(@@) $ 10668 - محمد بن زرارة بن عبد الله بن خزيمة بن ثابت الأنصاري يروي عن عمارة بن خزيمة عن أبيه روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 10669 - محمد بن أبي عميرة يروي عن أبيه عن عمر وعلي روى عنه بن جريج(@)(@@)(@@)(@@) $ 10670 - محمد بن عبد الرحمن بن مهران المدني يروي عن سعيد المقبري روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 10671 - محمد بن خلف شيخ يروي عن الحسن روى حكام بن سلم الرازي عن عيسى بن يزيد عنه(@)(@@)(@@)(@@) $ 10672 - محمد بن أبي عمرة الأزدي يروي عن سعيد بن جبير روى عنه معان بن رفاعة PageV07P414(@)(@@)(@@)(@@) $ 10673 - محمد بن سالم الباهلي يروي عن حبان السلمي عن بن عمر روى عنه التبوذكي(@)(@@)(@@)(@@) $ 10674 - محمد بن الديلمي يروي عن رجل عن معاذ روى عنه بن سيرين(@)(@@)(@@)(@@) $ 10675 - محمد بن عبد الله السعدي يروي المراسيل روى عنه محمد بن الحسن الأسدي(@)(@@)(@@)(@@) $ 10676 - محمد بن المهاجر القرشي يروي عن نافع روى عنه عبد الرحمن بن مغراء الدوسي(@)(@@)(@@)(@@) $ 10677 - محمد بن الربيع بن كعب البكري يروي عن الزبرقان بن عبد الله بن مازن عن أبي هريرة روى عنه إبراهيم بن المنذر الحزامي(@)(@@)(@@)(@@) $ 10678 - محمد بن عبد الجبار الأنصاري يروي عن محمد بن كعب عن أبي هريرة روى عنه شعبة بن الحجاج PageV07P415(@)(@@)(@@)(@@) $ 10679 - محمد بن مرة يروي عن عبد الرحمن بن الأسود عن أبيه روى عنه بن جريج(@)(@@)(@@)(@@) $ 10680 - محمد بن سعد الأنصاري يروي عن حبيب بن سالم وأبي ظبية روى عنه هشيم وشريك والكوفيون(@)(@@)(@@)(@@) $ 10681 - محمد بن عبد الرحمن أبو عبد الرحمن العدني يروي عن محمد بن علي وعكرمة روى عنه روح بن عبادة(@)(@@)(@@)(@@) $ 10682 - محمد بن زياد الأنصاري المدني يروي عن سعيد بن المسيب روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 10683 - محمد بن ميمون الكندي يروي عن يحيى اليماني عن أبي طلحة الأنصاري روى عنه شجاع بن الوليد السكوني(@)(@@)(@@)(@@) $ 10684 - محمد بن سليمان بن والبة يروي عن سعيد بن جبير روى عنه 