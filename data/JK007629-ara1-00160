ms141	 تروا لكليم الله كيف بدا % % له الخطاب من الأشجار في القبس % % PageV01P542 البحر : - 1(@)(@@) % كوكب قال بتنزيه نفسه % فرماه العجب في سجن رمسه % 2(@)(@@) % طلعت حكمة مولاه ليلا % لمحياه فأودت بنفسه % 3(@)(@@) % فشكا الكوكب وجدا وشوقا % لسناها عند أبناء جنسه % % 4(@)(@@) % قيل ما حكمة هذا محب % جاءكم يرغب وصلا بخمسه % 5(@)(@@) % قبضتها وأتت في حلاها % % نحو باريها وحطت بقدسه % 6(@)(@@) % ودعته فأتاها مجيبا % يا محبا يشتهيها لنفسه % % 7(@)(@@) % اشكر الله على كل حال % % ابتني ليلك هذا بعرسه % % PageV01P543 البحر : طويل 1(@)(@@) % أقول وروح القدس ينفث في النفس % بأن وجود الحق في العدد الخمس % 2(@)(@@) % أيا كعبة الأشهاد يا حرم الأنس % ويا زمزم الآمال زم على النفس % 3(@)(@@) % سرى البيت نحو البيت يبغي وصاله % % وطهر بالتحقيق من دنس اللبس % 4(@)(@@) % فيا حسرتي يوما ببطن محسر % % وقد دلني الوادي على سقر الرجس % 5(@)(@@) % تجرعت بالجرعاء كأس ندامة % على مشهد قد كان مني بالأمس % % 6(@)(@@) % وما خفت بالخيف ارتحالي وإنما % % أخاف على ذي النفس من ظلمة الرمس % 7(@)(@@) % لمزدلف الحجاج أعلمت ناقتي % % لأنعم بالزلفى وألحق بالجنس % 8(@)(@@) % جمعت بجمع بين عيني وشاهدي % % بوترين لم أشهد به رتبة النفس % 9(@)(@@) % خلعت الأماني بعدما كنت في منى % % وطوفتها فانظره بالطرد والعكس % 10(@)(@@) % ففي الجمرات الغر في رونق الضحى % % حصبت عدو الجهل فارتد في نكس % PageV01P544 11(@)(@@) % ركنت إلى الركن اليماني لأن في اس % تلام اليماني اليمن في جنة القدس % % 12(@)(@@) % صفيت على حكم الصفا عن حقيقتي % % فما أنا من عرب فصاح ولا فرس % 13(@)(@@) % أقمت أناجي بالمقام مهيمنا % تعالى عن التحديد بالفصل والجنس % 14(@)(@@) % فشاهدته في بيعة الحجر الذي % % تسود من نكث العهود لذي اللمس % 15(@)(@@) % وبالحجر حجرت الوجود وكونه % علي فلا يغدو الزمان ولا يمسي % % 16(@)(@@) % وفي رمضان قال لي تعرف الذي % % تشاهده بين المهابة والأنس % % 17(@)(@@) % فلما قضيت الحج أعلنت منشدا % بسيري بين الجهر للذات والهمس % 18(@)(@@) % سفينة إحساسي ركبت فلم تزل % % تسيرها أرواح أفكاره الخرس % % 19(@)(@@) % فلما عدت بحر الوجود وعاينت % بسيف النهى من جل 
ms142	 عن رتبة الإنس % 20(@)(@@) % دعاني به عبدي فلبيت طائعا % تأمل فهذا القطف فوق جنى الغرس % % PageV01P545 21(@)(@@) % فعاينت موجودا بلا عين مبصر % وسرح عيني فانطلقت من الحبس % % 22(@)(@@) % فكنت كموسى حين قال لربه % % أريد أرى ذاتا تعالت عن الحس % 23(@)(@@) % فدك الجبال الراسيات جلاله % % وأصعق موسى فاختفى العرش في الكرسي % % 24(@)(@@) % وكنت كخفاش أراد تمتعا % بشمس الضحى فانهد من لمحة الشمس % 25(@)(@@) % فلا ذاته أبقى ولا أدرك المنى % % وغودر في الأموات جسما بلا نفس % % 26(@)(@@) % ولكنني أدعي على القرب والنوى % % بلا كيف بالبعل الكريم وبالعرس % PageV01P546 البحر : هزج 1(@)(@@) % فمن حسي إلى عقلي % % ومن عقلي إلى حسي % % 2(@)(@@) % بعلمين غريبين % بلا شك ولا لبس % 3(@)(@@) % ومن حدسي إلى علمي % % ومن علمي إلى حدسي % % 4(@)(@@) % فنور العلم ممدود % % ونور الحدس ما يمسي % % 5(@)(@@) % ومن نفسي إلى روحي % % ومن روحي إلى نفسي % % 6(@)(@@) % بتحليل وتركيب % كمثل الميت في الرمس % 7(@)(@@) % ومن قدسي إلى رجسي % % ومن رجسي إلى قدسي % % 8(@)(@@) % فقدسي كان في وقتي % % ورجسي كان في أمسي % % 9(@)(@@) % ومن إنسي إلى جني % % ومن جني إلى إنسي % % 10(@)(@@) % فجني يبتغي غمي % % وإنسي يبتغي أنسي % % PageV01P547 11(@)(@@) % ومن حبي إلى سعتي % % ومن سعتي إلى حبي % % 12(@)(@@) % لنكر قام في نفسي % % على عقلي وبالعكس % % 13(@)(@@) % ومن أيسي إلى ليسي % % ومن ليسي إلى أيسي % % 14(@)(@@) % بسعدي فيه تأليف % كما في شنه يحسي % % 15(@)(@@) % ومن حلسي إلى صدري % % ومن صدري إلى حلسي % % 16(@)(@@) % فلولا باقل ما لا % % ح نور الفضل في قس % 17(@)(@@) % ومن شمسي إلى بدري % % ومن بدري إلى شمسي % % 18(@)(@@) % لإظهار الخفايا في % % بطون نواشئ دبس % 19(@)(@@) % ومن فرس إلى عرب % ومن عرب إلى فرس % 20(@)(@@) % لشرح قوام أسرار % ورمز حقائق نكس % PageV01P548 21(@)(@@) % ومن أسي إلى فرعي % % ومن فرعي إلى أسي % % 22(@)(@@) % لعيش دس في موت % بحس أو بلا حس % 23(@)(@@) % فلا تهتم يا نفسي % % لقول الحاسد النكس % % 24(@)(@@) % وقول الجاهل المغرور % ر يا ريحانة النفس % % 25(@)(@@) % فكم من جاهل قد قا % % ل في أرواحنا الخرس % 26(@)(@@) % لدى 
ms143	 تنزيل تنزيلي % % بروح النفث والحس % 27(@)(@@) % كاس فيه شيطان % يخبطه من المس % 28(@)(@@) % فإن الناس ما زالوا % % من التحقيق في لبس % 29(@)(@@) % فسر الله موجود % مبين الجهر والهمس % PageV01P549 البحر : طويل 1(@)(@@) % خصصت بعلم لم يخص بمثله % % سواي من الرحمن ذي العرش والكرسي % % 2(@)(@@) % وأشهدت من علم الغيوب عجائبا % تصان عن التذكار في عالم الحس % 3(@)(@@) % فيا عجبا إني أروح وأغتدي % % غريبا وحيدا في الوجود بلا جنس % 4(@)(@@) % لقد أنكر الأقوام قولي وشنعوا % % علي بعلم لا ألوم به نفسي % % 5(@)(@@) % فلا هم مع الأحياء في نور ما أرى % % ولا هم مع الأموات في ظلمة الرمس % 6(@)(@@) % فسبحان من أحيى الفؤاد بنوره % وأفقدهم نور الهداية بالطمس % 7(@)(@@) % علوم لنا في عالم الكون قد سرت % من المغرب الأقصى إلى مطلع الشمس % 8(@)(@@) % تحلى بها من كان عقلا مجردا % عن الفكر والتخمين والوهم والحدس % 9(@)(@@) % وأصبحت في بيضاء مثلي نقية % إماما وإن الناس منها لفي لبس % PageV01P550 البحر : مجتث 1(@)(@@) % نكحت نفسي بنفسي % % وكنت بعلي وعرسي % % PageV01P551 البحر : كامل تام 1(@)(@@) % لبس التقى للنفس خير لباس % % يزهو به المسعود بين الناس % 2(@)(@@) % إن الشريف هو التقي المرتضى % % لا الهامشي ولا بنو العباس % 3(@)(@@) % إلا إذا اتقوا الإله فإنهم % % أهل المكارم والندى والباس % 4(@)(@@) % إني لبست بحمص أندلس وبال % % حرم الشريف ومكة وبفاس % % 5(@)(@@) % من سادة مثل الشموس أئمة % الله أكرمهم بخير لباس % 6(@)(@@) % بهدى هداتهم اهتديت لأنهم % % في الليلة الظلماء كالنبراس % PageV01P552 البحر : بسيط تام 1(@)(@@) % شؤون ربي من تغيير أنفاسي % % كالجود منه لما عندي من إفلاس % 2(@)(@@) % فراعه لي مني بالزمان مما % % في الكون إلا وجود الجن والناس % 3(@)(@@) % لما ينافي وجود النشىء من ثقل % فلو يخف لكنا التاج في الراس % % 4(@)(@@) % لكننا منه كالنعلين في قدم % من التقلب أو كالشامخ الراسي % % 5(@)(@@) % في نشأة العجل برهان لذي نظر % في السامري وما في الأمر من بأس % PageV01P553 البحر : مجزوء الخفيف 1(@)(@@) % كم رأينا برامة % من طلول دوارس % 2(@)(@@) % ما رأينا من غادة % في الجواري الأوانس % % 3(@)(@@) % مثل 
ms144	 لبنى إذا اقبلت % % نحونا من غدامس % % 4(@)(@@) % خلتها حين أقبلت % قطعة من حنادس % 5(@)(@@) % صورة ما أرى لها % % صورة في الكنائس % % 6(@)(@@) % إنما حرك الهوى % % اهتزاز النواقس % % 7(@)(@@) % قلت من أنت إنني % % خالطتني وساوسي % % 8(@)(@@) % قالت : اعلم بأنني % % من حسان الفرادس % 9(@)(@@) % لست إنسا لكنني % % مظهر للنوامس % 10(@)(@@) % وأنيسي الذي أرا % % ه أنيسي مجالسي % % PageV01P554 11(@)(@@) % ظاهر افويق تحته % % في صدور المجالس % 12(@)(@@) % أنا من كل زينة % رقمت في الملابس % 13(@)(@@) % ما يرى حسن زينتي % % منكم غير لابس % 14(@)(@@) % أنا من حبها كما % % قيل في حرب داحس % 15(@)(@@) % قلت مني على فتى % % طامع فيك آيس % 16(@)(@@) % قالت أعلم بأنه % % في الهوى غير سائس % 17(@)(@@) % ودليلي إظهاره % % ما به من وساوس % PageV01P555 البحر : بسيط تام 1(@)(@@) % الحمد لله رب العالمين على % % ما كان منه من الأحوال في الناس % 2(@)(@@) % مما يسرهم مما يسؤوهم % % وكل ذلك محمول على الراس % % 3(@)(@@) % له الثناء له التمجيد أجمعه % % من قبل والدنا المنعوت بالناسي % % 4(@)(@@) % عبدته وطلبت العون منه كما % % قد قال شرعا على تحرير أنفاسي % % 5(@)(@@) % وأن يهيئ لي من أمرنا رشدا % وأن يلين مني قلبي القاسي % % 6(@)(@@) % حتى أكون على النهج القويم به % خلقا كريما بإسعاد وإيناس % 7(@)(@@) % الله نور تعالى أن يماثله % نور وقد لاح لي في نار نبراس % 8(@)(@@) % لو قال خلق به من دون خالقه % % لكفروه وما في القول من باس % 9(@)(@@) % لأنه مثل لو قلته قبل هل % لداء هذا الذي قد قال من آسي % % 10(@)(@@) % وما جهلت سوى أوقاتها ولذا % % نهيت عنها ووسواسي وخناسي % % PageV01P556 11(@)(@@) % فلو تجارت لها سبقا خيول نهى % % فازت بها في سباق الكشف أفراسي % % PageV01P557 البحر : طويل 1(@)(@@) % نمش بأعراف الجياد أكفنا % % لأن لها جودا على نشأة النفس % 2(@)(@@) % لما جاء في الأنباء عن خير مرسل % بأصدق قيل جاء من حضرة القدس % 3(@)(@@) % وضعفه النقاد من أجل واحد % رواه عن الأثبات عن عالم الإنس % % 4(@)(@@) % وكم صح من أمثاله فهو واحد % من النوع إن شئتم وإلا من الجنس % 5(@)(@@) % وما 
ms145	 فيه إن أنصفت في القول مثبت % له عندنا ويل تحقق من لبس % % 6(@)(@@) % وكيف يكون اللبس والأمر ظاهر % يلوح لذي عينين من حضرة الأنس % % 7(@)(@@) % لقد كان خير الناس يفعل مثل ما % % بأعرافها والبيع بالثمن البخس % 8(@)(@@) % لقد صغت معناه بأدنى عبارة % وألطفها للعقل بالفكر والحس % PageV01P558 البحر : مجزوء الرمل 1(@)(@@) % ما أنا اليوم لنفسي % % قد مضى عقلي وحسي % % 2(@)(@@) % فأنا روم لأني % % شاهد أصلي وأسي % % 3(@)(@@) % فليقم من شاء منكم % أو يرح رواح أمس % 4(@)(@@) % ومتى رأيت شخصا % وهو من شكلي وجنسي % % 5(@)(@@) % نفرت منه طباعي % % ومضى عني أنسي % % 6(@)(@@) % أبغض الخلق إلينا % % من تسمى لي بإنسي % % 7(@)(@@) % فاعذروني يا عدايا % % أنا في أضيق حبس % 8(@)(@@) % لست من خلق جديد % حادث صاحب لبس % PageV01P559 البحر : طويل 1(@)(@@) % سأحرف عن قوم عن الحق أعرضوا % % بنا فهم الأفراد يدعون بالخرس % 2(@)(@@) % سوروا بتكوين وعزا بجلوة % ليستوحش الأقوام في حالة الأنس % 3(@)(@@) % سموا بل علوا إلا قليلا لأنهم % تعالوا عن التنزيه في حضرة القدس % 4(@)(@@) % سلام على قوم تباهوا بربهم % % على كل موجود من الجن والإنس % 5(@)(@@) % سروا وظلام الليل يستر سيرهم % إلى أن علوا فوق الإشارة بالكرسي % % 6(@)(@@) % سرت همة مني على خير مركب % من الطبع من عقل نزيه ومن حس % 7(@)(@@) % سرى نحوه سري ليدري حديثه % على هيكل قد بيع بالثمن البخس % 8(@)(@@) % سباها وأسلاها وجود منزه % عن الحد بالفضل المقوم والجنس % 9(@)(@@) % سناه مزيل ظلمة العرش والعمى % % وما كان من أين يقال ومن جنس % 10(@)(@@) % سلت بوجود القيد عن نيل مطلق % عن الحبس بالتقييد باليوم والأمس % PageV01P560 البحر : مجتث 1(@)(@@) % علمت ربي لما % % علمت علمي بنفسي % % 2(@)(@@) % إذ كان عين وجودي % % وروحي عقلا وحسي % % 3(@)(@@) % قد بعت نفسي منه % % لما اشتراها ببخس % % 4(@)(@@) % ولم أبع منه نفسي % % إلا لجهلي بأسي % % 5(@)(@@) % فلو علمت به ما % % ذكرت بيعا لأنسي % % 6(@)(@@) % فإن أكن عنه غيرا % فالحق جنة أنسي % % 7(@)(@@) % ما لي وإياه شبه % إلا كيومي بأمس % 8(@)(@@) % الفرق فيه عسير % لأنه أصل لبسي % % 9 
ms146	(@)(@@) % فما بدا كون عيني % % إلا ببعل وعرس % % 10(@)(@@) % من الطبيعة بنا % % ما بين عقل ونفس % PageV01P561 11(@)(@@) % فيها بعقد نكاح % % أعلى بحضرة قدس % % 12(@)(@@) % فنحن أهل المعالي % % ونحن أهل التأسي % % 13(@)(@@) % لكن بأسماء ربي % % ما بين عرش وكرسي % % 14(@)(@@) % لو قلت ما قلت يأتي % % إلي فيه بعكس % % 15(@)(@@) % وإن أعجل تراه % % بصورة الحال ينسي % % 16(@)(@@) % تعجيله فيه ذكرى % % تأخيره الأمر ينسي % % 17(@)(@@) % سر الشريعة خاف % ما بين عرب وفرس % 18(@)(@@) % وليس يظهر إلا % % إلى شهيد بحس % 19(@)(@@) % فلا تمت حتف أنف % فلست فيها بنكس % 20(@)(@@) % نطق الشهادة حال % ما بين جهر وهمس % PageV01P562 21(@)(@@) % لله قوم تراهم % % بحال ذل ونكس % 22(@)(@@) % وهم لديه كرام % لا يشترون بفلس % 23(@)(@@) % عجبت مني وممن % قد بنت عنه بجنسي % % 24(@)(@@) % إطلاق سري دليل % أني بأضيق حبس % 25(@)(@@) % وإنني في مقالي % % لست بصاحب حدس % 26(@)(@@) % بل ذاك نور مبين % كنور بدر وشمس % 27(@)(@@) % أفصحت فيه لساني % % لأنني بين خرس % % PageV01P563 البحر : بسيط تام 1(@)(@@) % تبارك الله ما في اليأس من باس % والناس ليس لهم فضل على الناس % 2(@)(@@) % من حيث ما هو ناس إنه ولد % لآدم وهو المنعوت بالناسي % % 3(@)(@@) % معرف بالذي في الطبع من صفة % % وأين نور الهدى من نور نبراس % % 4(@)(@@) % لقد أتاني كلام كله حكم % مني بصورة إلهام ووسواس % 5(@)(@@) % فقال لي وهو صدق في مقالته % إشرب بكاسي وإني الماء في الكاس % 6(@)(@@) % كما جعلت لموسى النار حاجبة % حتى أ : لمه من ذات مقباس % 7(@)(@@) % ليعلم العبد أني كل من وقعت % عين عليه من أنواع وأجناس % 8(@)(@@) % فليس في الكون غيري والخلائق لي % % فلي الغنى ولهم فقر بإفلاس % % 9(@)(@@) % إني ظهرت بأديان مفصلة % على لسان فقيه بي وشماس % 10(@)(@@) % وقمت في كل حال توصفون به % % وصرت أظهر في العاري وفي الكاسي % % PageV01P564 11(@)(@@) % وما تجليت إلا لي فأدركني % % عيني وأسمعت سمعي كل وسواس % 12(@)(@@) % وما تحليت إلا بي لاظهر لي % % فقمت لي أدبا حبا على الراس % 13(@)(@@) % لما ابتغاني الذي يدري معاملتي % % حجبته معلما بالشامخ الراسي 
ms147	 % % 14(@)(@@) % ولم يكن غير عيني الشامخ الراسي % % فلم تقع وحشة إلا بإيناس % 15(@)(@@) % تنازعت في أضداد فقلت لها % % إن الحياة لفي طاعون عمواس % % 16(@)(@@) % أحياهم الله في موت مشاهدة % % ما في الحياة التي في الموت من باس % % PageV01P565 البحر : خفيف تام 1(@)(@@) % يعرج العبد لاكتساب علوم % ولتبليغها يرى في انتكاس % 2(@)(@@) % ثم عين النزول أيضا عروج % لشهود ما فيه من التباس % % 3(@)(@@) % ثم نبغي بزهدنا ما زهدنا % % عين زهدي في ذاك عين التماسي % % 4(@)(@@) % هو لي بالنهار عين معاشي % % وهو في الليل بالظلام لباسي % % 5(@)(@@) % جعل النوم لي سباتا لأمر % يجعل الحق بالشهود نواسي % % 6(@)(@@) % فأراه في النوم حقا يقينا % رؤية في دارك الإحساس % 7(@)(@@) % مثل ما يشرب النديم شربنا % % بارك الله سيدي في نعاسي % % 8(@)(@@) % مذ بناني الإله قصرا مشيدا % ذا سقوف علية وأساس % 9(@)(@@) % علمت نفسي أن سكناه ذاتي % % ولريم الفلاة عين الكناس % PageV01P566 البحر : سريع 1(@)(@@) % في سورة الأعراف مذكورة % ثلاث آيات تسمى الحرس % 2(@)(@@) % لما اعتنى الرحمن بالمصطفى % % في كربه جادت له بالنفس % 3(@)(@@) % إذا تلوناها لخوف بنا % % بحكم إيمان تكن كالعس % % 4(@)(@@) % ما مثلها من آية آمنت % نفوسنا إلا التي في عبس % 5(@)(@@) % قد جاءت الصاخة فاسمع لها % % فإنها عين غنى المبتئس % % 6(@)(@@) % قد أظهرت أحكامها عندنا % % في دارنا الدنيا فلم تبتئس % % 7(@)(@@) % وليس كل الناس يدري بها % % إلا السليم العين غير الرئس % PageV01P567 البحر : وافر تام 1(@)(@@) % فأنوار تلوح على ولي % ظهور الوشي في الثوب الموشى % % PageV01P568 البحر : طويل 1(@)(@@) % شهدت الذي قد مهد الأرض لي فرشا % شهود إمام حاكم حكم العرشا % % 2(@)(@@) % شغفت به حبا فأسهر مقلتي % % ومن اجل وجدي رحمة سكن الفرشا % % 3(@)(@@) % شهودي له بالباء ليس بغيرها % % لأجل الذي قد سن أن نغرم الأرشا % % 4(@)(@@) % شيوخ من الأقوام فيه لقيتهم % % فكانوا لنا سقفا وكنت لهم فرشا % % 5(@)(@@) % شداد أولو أعزم رعاة أيمة % % تجلى لهم فينا وفي الحية الرقشا % % 6(@)(@@) % شعارهم التوحيد يبغون قربه % به وهو الشرك الذي أثبت الأعشى % % 7(@)(@@) % شبيه بهم من كان طول 
ms148	 حياته % وفي البرزخ المعلوم في الليل إذ يغشى % % 8(@)(@@) % شمرت عليهم بعد تعظيم قدرهم % % ولم آمن الهجران منه ولم أخشا % % 9(@)(@@) % شربت الذي من شربه اللذة التي % % لشاربه نصا أتانا به يغشى % % 10(@)(@@) % شممت به ريحا من المسك عاطرا % يخبرني في هذا المقام الذي يغشى % % PageV01P569 البحر : طويل 1(@)(@@) % إذا قلت يا الله لبى من الحشى % % فأصغيت نحو الصوت والعين في غشا % % 2(@)(@@) % وقال شهودي إن تأملت شاهدي % % إذا طلع الليل الإلهي في العشا % % 3(@)(@@) % لأني وتر لم تشفعه ذاتكم % لأنك من أهل العزاء مع العشا % % 4(@)(@@) % وإن شئت قلت العين مني عينه % % وإن مدمنه نحو أعياننا الرشا % % 5(@)(@@) % وجاء بنعت فيه عيني وعينه % % لذا يقبل القرض الذي حرم الرشى % % 6(@)(@@) % ومن كان هذا حاله فهو شاهد % % عليه بأن العقل في الفكر في غشا % % 7(@)(@@) % فما ثم إلا الكشف ما ثم غيره % % له ترفع الأستار في الحال إن يشا % % 8(@)(@@) % وما ثم ستر غير أني فرضته % % ومن يقبل النقصان قد يقبل المشا % % 9(@)(@@) % هو القمر الوضاح فيها كمثل ما % % هو الشمس والروض المنمنم والرشا % % PageV01P570 البحر : طويل 1(@)(@@) % سرائر سر لا تصان ولا تفشى % % وأبكارها لا تستباح ولا تغشى % % 2(@)(@@) % فمطعمها للحس شهد لذائق % % وملمسها للعقل كالحية الرقشا % % 3(@)(@@) % تولد للأفكار في كل ساعة % من اليوم والليل البهيم إذا يغشى % % 4(@)(@@) % إناثا وذكرانا لمعنى بصورة % بها قيدته مثل ما قيد الأعشى % % 5(@)(@@) % فقال بأن الضوء ممتزج وما % % نوى بالذي قد قال سوءا ولا غشا % % 6(@)(@@) % وقال الذي لم يعرف الحكم إنه % % نوى بالذي قد قاله للورى غشا % % 7(@)(@@) % فلو يدري أن النور يستر ليله % % وأن وجود السلخ صيره نشا % % 8(@)(@@) % لقال بأن الأمر نور وظلمته % % وذلك حق ما به بان أن يغشى % % 9(@)(@@) % فمن سبر الأمر الذي قد سبرته % % يكون إماما لا يخاف ولا يخشى % % PageV01P571 البحر : بسيط تام 1(@)(@@) % والليل ليل الهوى والطبع إذ يغشى % % ثم النهار نهار العقل والافشا % % 2(@)(@@) % إذا ذكرت ثيابا كنت لابسها % % للدين ذكرني ذكرى بها الهرشا % % 3 
ms149	(@)(@@) % ولست أعمى فإني ذو سنا وحجى % % ولست أبصر لكني أنا الأعشى % % 4(@)(@@) % فالطبع يأنف أن يفضى عليه به % والشرع يحكم أني أغرم الأرشا % % 5(@)(@@) % فالحكم مني علي لا على أحد % % فلست أرجو سواي لا ولا أخشى % % 6(@)(@@) % فإن تجس ترى لينا وداخله % % سم قتول كأني الحية الرقشا % % 7(@)(@@) % هذا خصصت به وحدي وأعن به % نوع الأناسي حال البدء والإنشا % % 8(@)(@@) % قامت على صورة الأسماء نشأتنا % % فكل ما نحن فيه ربنا أنشا % % 9(@)(@@) % وما أسرته في تبليغنا رسل % لأن مرسلهم هو الذي أفشى % % 10(@)(@@) % ولو أسر لكان الحال يشهد لي % % بأنه هكذا سبحانه قد شا % % PageV01P572 البحر : سريع 1(@)(@@) % الحق للرحمن في العرش % وفي السموات وفي الفرش % 2(@)(@@) % وفي نزول الغيث في وابل % حمدته أيضا وفي الرش % % 3(@)(@@) % حمدا كثيرا طيبا خالصا % يسلم في البحث من الهرش % 4(@)(@@) % وكل حمد ليس فيه أنا % % يقبله الله بلا أرش % 5(@)(@@) % يمتاز ختم الحق عن ختمنا % % بما نرى فيه من النقش % % 6(@)(@@) % لو سلمت أغنامنا لم يكن % يقضي سليمان من النفش % 7(@)(@@) % فبطشه الأقوى على عزه % % ينزل في الشدة عن بطشي % % 8(@)(@@) % لمزجه برحمته لم تضق % فهي لدى بطشي كالخدش % 9(@)(@@) % ألفيته في وزن أعماله % % يربى على الأوزان بالنش % % 10(@)(@@) % أخلصت ودي لحبيب الهوى % % فليس في ودي من غش % % PageV01P573 11(@)(@@) % وليس ذا عشك فلتدرجي % % وأين عش السر من عشي % % 12(@)(@@) % نبشت عنه عند أسمائه % حتى رأيت الأمر في النبش % 13(@)(@@) % خادعني عند التجلي كما % % خادع إبراهيم بالكبش % 14(@)(@@) % أظهره في صورة ابن له % فكاد يختل من الدهش % 15(@)(@@) % وهكذا الأمر إذا لم يكن % كالنص في الأمر الذي يفشي % % 16(@)(@@) % إني وإياه كليل أتى % % نهاره للولد إذ يغشي % % 17(@)(@@) % بالله يا نفسي كذا فافعلي % % إذا أتى يبغي السوى غشي % % 18(@)(@@) % حتى يرى فعلكمو فعله % % كمثل موسى في عصا الهش % 19(@)(@@) % أجمل أمرا بعد تفصيله % % ليحصل المطلوب بالفتش % 20(@)(@@) % أخبرنا حكمة إمساكه % كما روى قائمة العرش % % PageV01P574 21(@)(@@) % إن عصاه لم يزل حكمها % % لكي يرى الأعين من يعشي 
ms150	 % % 22(@)(@@) % هيهات هيهات لما تبتغي % % وأين فرغانة من الش % 23(@)(@@) % لقيت شخصا عند وداي القرى % % فقلت ذا محمد اللوشي % % 24(@)(@@) % ولم يكن فقلت مكرا بنا % % فلم أثق من بعد بالنوش % % 25(@)(@@) % إن جاءكم نص بضد الذي % % ذكرته مع الهدى يمشي % % 26(@)(@@) % تمسكوا منه بأهدابه % وألقوا الذي ذكرت في الحش % % 27(@)(@@) % أنا ابن سام لا ابن حام فلي % % فضل على الأغربة الحبش % 28(@)(@@) % في صاحب الفيل لكم عبرة % وهادمي الكعبة بالنكش % % 29(@)(@@) % لله سر لو بدا ما اهتدى % % به رجال الأعين العمش % 30(@)(@@) % والله ما أخفيته عنهم % % إلا لما فيه من الفحش % % PageV01P575 31(@)(@@) % لله قوم لهم فطنة % تراهم كالحمر الوحشي % % 32(@)(@@) % لهم نفور ولهم وقفة % تردهم عن بطشة الطيش % 33(@)(@@) % العرش فرش للذي يستوي % % عليه وهو السقف للفرش % 34(@)(@@) % فما أرى شيئا بلا نسبة % فنزهوا الرحمن ذا العرش % % PageV01P576 البحر : مخلع البسيط 1(@)(@@) % ممن تخلصت أو إلى من % % تخلص يا طالب الخلاص % 2(@)(@@) % إن كنت بالعلم في مزيد % أنا من العلم في انتقاص % % 3(@)(@@) % إن لنا حكمة تعدت % بذاتها منزل القصاص % 4(@)(@@) % إن كانت الحال ما ذكرنا % % كيف لنا منه بالخلاص % 5(@)(@@) % فإنني طالب أمورا % أخرها حاكم المناص % 6(@)(@@) % وقد علمنا كذا أمورا % قدمها حاكم المناص % PageV01P577 البحر : بسيط تام 1(@)(@@) % الله أكرم أن يحظى بنعمته % % الطائعون ويشقى المجرم العاصي % % 2(@)(@@) % وإن شقى فكالآم يصيب بها % % المؤمنين فمن دان ومن قاصي % % 3(@)(@@) % وكلهم عالم بالله مستند % إليه مفلسهم ورب أو قاص % PageV01P578 البحر : رمل تام 1(@)(@@) % صادني من كان فكري صاده % % ما له والله عنه من محيص % 2(@)(@@) % صابرا في كل سوء وأذى % % في كيان من عموم وخصوص % 3(@)(@@) % صرة أودعت قلبي علمها % % في كتاب وسمته بالفصوص % % 4(@)(@@) % صبرت قهرا وعجزا وأبت % غيرة منها عليه أن تنوص % 5(@)(@@) % صيرته واحدا في دهره % % ثم رامت عنه عزا أن تبوص % % 6(@)(@@) % صادفت والله في غيرتها % % عين ما جاء به لفظ النصوص % % 7(@)(@@) % صدقتها فلها النور الذي % % ما له في كونها ذاك الوبيص % % 8(@)(@@) % صلبت في الدين 
ms151	 فانقاد لها % % كل معنى هو في البحث عويص % 9(@)(@@) % صلى القلب اشتعالا بعد ما % % كان ذا عزم عليه وحريص % 10(@)(@@) % صامت النفس وصلت فلها % % لمعان من سناها وبصيص % % PageV01P579 البحر : طويل 1(@)(@@) % علا كل سلطان على كل سوقة % % إذا سكن الأطوال وأسكن العرضا % % 2(@)(@@) % وما ذاك إلا ههنا بتكلف % وينعدم التكليف إن فارق الأرضا % % 3(@)(@@) % إلى جنة المأوى بنشأة حسه % % وما عندها ظل وإن لها عرضا % % PageV01P580 البحر : مجزوء الخفيف 1(@)(@@) % ضاق صدري لما أتى % % لوجودي به القضا % % 2(@)(@@) % ضقت ذرعا بموجدي % % بعدما كنت في فضا % % 3(@)(@@) % ضرري لم يكن سوى % % عفوه حين غمضا % % 4(@)(@@) % ضرني ما به أتى % % من حديث وأمرضا % % 5(@)(@@) % ضرر قوله عفا % % رحمة بي عما مضى % % 6(@)(@@) % ضمني ضمة فما % % قلت هذا إلا مضى % % 7(@)(@@) % ضد ذا لو رأيته % كنت في الحال معرضا % % 8(@)(@@) % ضارب الباب جاهل % % يطلب العفو والرضى % % 9(@)(@@) % ضرب النحل مخبرا % عنه فينا بما قضى % % 10(@)(@@) % ضرب العلم خيمته % % ساعة ثم قوضا % % PageV01P581 البحر : بسيط تام 1(@)(@@) % تجري الأمور إلى آجالها ركضا % لذاك يفضل فيها بعضها بعضا % % 2(@)(@@) % هذي عموم يعم الكون أجمعه % ولا يخص به نفلا ولا فرضا % % 3(@)(@@) % لا يعرف الذوق في ضيق وفي سعة % % إلا الذي يقرض الله به قرضا % % 4(@)(@@) % لذاك يسكن في طول الجنان به % منه ومن نفسه قد يسكن العرضا % % 5(@)(@@) % لا يبلغ المجد في دنيا وآخرة % % من صير الماء نارا والهوا أرضا % % PageV01P582 البحر : منسرح 1(@)(@@) % وإنما الله بالفراق قضى % % ليمضي ما شاءه بنا فمضى % % PageV01P583 البحر : بسيط تام 1(@)(@@) % لما تألفت الأشياء في عدم تبارك الله لا أبغي به عوضا % ولست أبرم ما قد حل أو نقضا % % 2(@)(@@) % إني عجبت لمن بالجهل أعرفه % % والعجز غاية من في ذاته نهضا % % 3(@)(@@) % قد حجر الشرع فكري أن يصرفه % في ذاته فأبى العقل الذي فرضا % % 4(@)(@@) % ما إن رأيت له مثلا يعارضه % وهو المريد وما أدري له غرضا % % 5(@)(@@) % لما تألفت الأشياء في عدم % % قام الوجود به لعارض عرضا % % 6(@)(@@) % وهو الوجود كما 
ms152	 قامت بأنفسها % % لذاك ما أبتغي بربنا عوضا % % 7(@)(@@) % فما ترى جوهرا في الكون منفردا % على اختلاف ولا جسما ولا عرضا % % 8(@)(@@) % إلا وذاك الذي عاينت صورته % % فمن به مرض قد زدته مرضا % % 9(@)(@@) % كذا أتت في كتاب الله آيته % % فلم تقل غير ما قد قاله ومضى % % 10(@)(@@) % فليس يظهره في عين مبصره % % إلا الغمام إذا برق به ومضا % % PageV01P584 11(@)(@@) % بذا أتى نصه إن كنت ذا نظر % والكشف أعطى الذي قد قلته وقضى % % 12(@)(@@) % طه ويس لا تعربهما فهما % % من الذي أبهم النبراس حين أضا % % 13(@)(@@) % يا عابد الفكر لا تسلك طريقتنا % % هذي بحور بلا سيف لها وأضى % % 14(@)(@@) % إن القرآن لنور يستضاء به % % وزاد رجسا قليب زاده مضضا % % PageV01P585 البحر : بسيط تام 1(@)(@@) % الشكر لله لا أبغي به عوضا % % بل شكرنا امتثال للذي فرضا % % 2(@)(@@) % خلى لي الأمر في الأكوان أجمعها % % وغادر القلب مشغوفا به ومضى % % 3(@)(@@) % فما رأيت بريقا في جوانبها % % إلا وكان هو البرق الذي ومضا % % 4(@)(@@) % وآض عني الذي قد كان يحجبني % % لما رأى النور في آفاقهن أضا % % 5(@)(@@) % لما سلكت سبيل الواصلين إلى % % بحر العماء رأيت الزاخرات أضا % % 6(@)(@@) % فقلت هل ثم بحر لا يكون له % سيف فقالوا نعم هذا الذي اعترضا % % 7(@)(@@) % ما بيننا وهو من وجه يخيط بنا % % وما له غاية ولا عليه فضا % % 8(@)(@@) % ونحن فيه كغرقى يسبحون به % ولا يقاسون هما لا ولا مضضا % % 9(@)(@@) % بحر الثبوت الذي أبدى جزائره % فيه ومنه بما قد شاءه وقضى % % 10(@)(@@) % والناس سفر ولكن من جزائره % إلى جزائره في شقوة ورضى % % PageV01P586 11(@)(@@) % الإسم يوجدنا والذات تعدمنا % % فما ترى صحة إلا ترى مرضا % % 12(@)(@@) % إساتنا لم تكن إلا إساءتنا % % وهي الغذاء لمن قد صح أو مرضا % % 13(@)(@@) % بها بدا عفوه عنا ورحمته % % ومن يقوم به إحسانه نهضا % % 14(@)(@@) % إلى الوجود الذي ما عنده عدم % وهو الذي حصل المأمول والغرضا % % 15(@)(@@) % شخصا سويا وقد سماه لي بشرا % % من المباشرة الزلفى التي انتهضا % % 16(@)(@@) % بها فأبصره في عين صورته % % مثلا 
ms153	 فأنشأه حتى يرى عوضا % % 17(@)(@@) % فلم يكن غيره إلا بجنته % % فزال عن نفسه المثل الذي افترضا % % PageV01P587 البحر : بسيط تام 1(@)(@@) % ثوب التقى والهدى أليست فاطمة % وما أرى للباس الخير من عوض % 2(@)(@@) % ألبستها خرقة علياء جامعة % تزيل عن قلبها ما فيه من مرض % 3(@)(@@) % جمعت والله في البأس ما لبست % مني من الخير بين الذات والعرض % % 4(@)(@@) % قد كان لي غرض في أن تكون لنا % % بنتا وربي فيها قد قضى غرضي % % 5(@)(@@) % فلتشكر الله لا أرجو سواه لها % % على الذي قدر الرحمن حين رضي % % PageV01P588 البحر : سريع 1(@)(@@) % الصدق سيف الله في الأرض % % يقطع بالطول وبالعرض % 2(@)(@@) % يعم بالقطع لهذا يرى % % يحكم في الرفع وفي الخفض % % 3(@)(@@) % والعالم الأقرب في عزه % والعالم الأبعد في الأرض % 4(@)(@@) % يقيم دين الله في خلقه % % نيابة في النفل والفرض % % 5(@)(@@) % ولا يرى في ملكه جائرا % إلا الذي ينصب بالغرض % % PageV01P589 البحر : مجتث 1(@)(@@) % من لي بمن أرتضيه % في كل ما أمضيه % 2(@)(@@) % مما أراه سدادا % والحب لا يقتضيه % 3(@)(@@) % فشأنه الأمر فينا % % وحبنا يمضيه % 4(@)(@@) % سبحانه وتعالى % % في كل ما يقضيه % 5(@)(@@) % فكل ما جاء منه % هو الذي أرتضيه % % PageV01P590 البحر : مديد تام 1(@)(@@) % ارتباط السقم بالعرض % كارتباط الجسم بالعرض % 2(@)(@@) % فإذا نيلت فعافية % وانتفى ما كان من مرض % 3(@)(@@) % فانظروا فيما ذكرت لكم % % تسلموا من علة الغرض % % 4(@)(@@) % فوجوب الزهد فيه لذي % % نظر وجوب مفترض % 5(@)(@@) % والذي تخفى مقاصده % % إنه يصبر على مضض % % 6(@)(@@) % ويعزي نفسه في الذي % % فاته بقوله لو قضي % % 7(@)(@@) % وتمج النفس في حكمته % % فتراه دائم الحرض % % 8(@)(@@) % تارة يموت من شرق % تارة يموت من حرض % 9(@)(@@) % وإذا ما مات من غصص % % ربما يظن فيه رضى % % 10(@)(@@) % والذي تفوته حكمي % % ما لها والله من عوض % PageV01P591 11(@)(@@) % هي كالمصباح نيرة % % مده زيت يكاد يضي % % 12(@)(@@) % ما لهه ميل إلى جهة % لوجود الاعتدال مضى % % PageV01P592 البحر : بسيط تام 1(@)(@@) % النقص في العبد ذاتي وإن له % وقتا كمالا ولكن فيه بالغرض % 2(@)(@@) % العبد لابد منه فهو يطلبه 
ms154	 % % وإنه صاحب الآفات والمرض % 3(@)(@@) % اعراضه بوجود النقص شاهدة % % وما نرى أحدا ينفك عن عرض % 4(@)(@@) % وقد ينال الذي يهوى ويحرمه % وقتا فيبصره يصبر على مضض % 5(@)(@@) % فقل لعقلك قد أفهمت صورته % % فقم على قدم التحقيق وانتهض % 6(@)(@@) % إلى المقام الذي ما عنده عرض % أيضا ويعصمه من علة الحرض % % 7(@)(@@) % فإن تيسر مطلوبي ظفرت به % وإن تعذر تعلم أن ذاك قضي % % 8(@)(@@) % فالعبد عبد متى أعطاه سر به % % ما كان يسأله وإن أبى فرضي % % 9(@)(@@) % ولا يغرنك أحوال فحالتها % % كالبرق يظلم جوا كان منه يضي % % 10(@)(@@) % قد يعلم العبد من حال القبول إذا % % رآه وجود الفعل منه رضي % % PageV01P593 11(@)(@@) % السقم للعبد حكم لا يزايله % فلا يزال مع الأنفاس ذا مرض % PageV01P594 البحر : طويل 1(@)(@@) % إلهي وفقني إلى كل ما يرضي % % ورض فؤادي بالذي أنت لي تقضي % % 2(@)(@@) % فإن كان سراء حمدتك منعما % % وإن كان ضراء نظرت إلى المقضي % % 3(@)(@@) % فأنظر فيه بالذي قد ذكرته % % فإن كان لا يرضي عدلت إلى المرضي % % 4(@)(@@) % وإن كان كلي مستقيما سررت بي % % وإن كان بعضي هم بكيت على بعضي % % 5(@)(@@) % إلهي أرجو من عنايتكم بنا % % إذا زلت عن ندب أسير إلى فرض % 6(@)(@@) % وإن كنت في رفع بربي محققا % فلا تحجبني عن عبودية الخفض % % 7(@)(@@) % وإن أنت من أهل القراض جعلتني % % إلهي فوفقني إلى أحسن القرض % 8(@)(@@) % فنصف لكم مثل الصلاة معين % ونصف لنا من غير نكث ولا نقض % 9(@)(@@) % أفوض أحوالي إليك مسلما % لأكتب فيمن أمره للرضى يفضي % % 10(@)(@@) % وأسأل ربي أن يمن بعصمتي % % هنا ثم في يوم القيامة والعرض % % PageV01P595 11(@)(@@) % ويجعلني ممن سما واعتلى به % % إليه إذا كان الخروج من الأرض % 12(@)(@@) % ويوصل لي بشراه بالخير منعما % إذا حل تركيبي وأسرع في نقضي % % 13(@)(@@) % وأفرض لي قاضي السماء معيشتي % % عليه وهل تبقى فضول مع الغرض % % 14(@)(@@) % ومهما دعاني نحوه جئت مسرعا % % على الناقة الكوماء بالعدو والركض % PageV01P596 البحر : كامل تام 1(@)(@@) % طابت مطاعم من يحقر قدره % % فمضى على حكم الوجود وما سطا % % 2(@)(@@) % طنب 
ms155	 ففي التطنيب إن حققته % % متوسما بسماته كشف الغطا % % 3(@)(@@) % طبتم فطاب بك النعيم بحضرة % فاحذر من التحريف كن متوسطا % % 4(@)(@@) % طوبى له من مالك متملك % جواب آفاق وعد لا مقسطا % % 5(@)(@@) % طاعاته مردودة في وجهه % % لما أطاع وما رأى عين العطا % % 6(@)(@@) % طاف اللبيب ببيته متدينا % متواضعا متهذبا متثبطا % % 7(@)(@@) % طربت به أيامه لما رأت % أن الخليفة في الحكومة أقسطا % % 8(@)(@@) % طفئت مصابيح الهدى بهوائه % وعلى مطا طرق العماء قد امتطى % % 9(@)(@@) % طاشت عقول ذوي النهى من سيره % لما أتاه محرضا ومنشطا % % 10(@)(@@) % طهر ثيابك فالطهور شريعة % جاءت بها الأرسال في ضفف الخطا % % PageV01P597 البحر : مجزوء الوافر 1(@)(@@) % نهاني الحق في الغطط % عن المطاط والسقط % 2(@)(@@) % وإني لا أجالس من % يكون بمثل ذا النمط % 3(@)(@@) % وأفهمني بأن أحظى % % به في العالم الوسط % PageV01P598 البحر : طويل 1(@)(@@) % إذا علم الله الكريم سريرتي إذا علم الله الكريم سريرتي % % فلست أبالي من سواه إذا سخط % 2(@)(@@) % وقد صح عندي منزلي من مهيمني % % فلست أبالي من دنا اليوم أو شحط % % 3(@)(@@) % فيا عجبا من عارف قال إنه % % تولع حبا بالإله ولم يمط % 4(@)(@@) % سوى ربه عنه وساءت طنونه % % بنا فمتى تدركه فيستدرك الغلط % % 5(@)(@@) % إذا كان من أبدى التحفي بجانبي % % يغيره قول الوشاة فقد سقط % 6(@)(@@) % ولكن ربي قد أتى فأتيته % % وقلت لسري حسبك المنتهى فقط % % 7(@)(@@) % ولا تلتفت من ظن سوءا بنا ولا % % تعرج عليه واعف عن سيء فرط % PageV01P599 البحر : كامل تام 1(@)(@@) % قلمي ولوحي في الوجود يمده % قلم الإله ولوحه المحفوظ % 2(@)(@@) % ويدي يمين اللهف ملكوته % ما شيئت أجري والرسوم حظوظ % % PageV01P600 البحر : مجزوء الوافر 1(@)(@@) % ظلام الليل معتبر % % لعبد عنده يقظه % 2(@)(@@) % ظنوني في منازلها % % علوم الخلق والحفظه % 3(@)(@@) % ظلوم ليس يجهلها % % إمام قبله حفظه % 4(@)(@@) % ظبا لما حللت به % رأيت الحجب في اليقظه % 5(@)(@@) % ظباء كلها شمس % إذا علمت بمن حفظه % % 6(@)(@@) % ظللت به فأرقني % % فلما كنت هو لفظه % % 7(@)(@@) % ظننت الأمر يشهدني % % ويشهدني فما حفظه % 8(@)(@@) % ظنون ما حصلت بها % % إلى المغرور 
ms156	 كي يعظه % 9(@)(@@) % على ما قال من وعظه % % نؤوم قلبه يقظه % % PageV01P601 البحر : طويل 1(@)(@@) % ولما أتاني الحق ليلا مكلما % كفاحا وأبداه لعيني التواضع % 2(@)(@@) % وأرضعني ثدي الوجود تحققا % فما أنا مفطوم ولا أنا راضع % 3(@)(@@) % ولم أقتل القبطي لكن زجرته % % بعلمي فلم تعسر علي المواضع % % 4(@)(@@) % وما ذبح الأبناء من أجل سطوتي % % ولا جاء شرير ببطشي رافع % % 5(@)(@@) % فكنت كموسى غير أني رحمة % % لقومي فلم تحرم علي المراضع % 6(@)(@@) % لغزت أمورا إن تحققت أمرها % % بدا لك علم عند ربك نافع % PageV01P602 البحر : رجز تام 1(@)(@@) % أنا العقاب لي المقام الأرفع % والحسن والنور البهي الأسطع % 2(@)(@@) % أمضي الأمور على مراتب حكمها % % في العدوة الدنيا وعزي أمنع % 3(@)(@@) % أنا فيضة السامي ونور وجوده % % وأنا الذي أدعو الوجود فيخضع % 4(@)(@@) % وأنا الذي ما زلت قبضة موجدي % % فالجود جودي والخلائق توضع % 5(@)(@@) % نحوي لتطلب ما لها من شربها % % منا فأعطي من أشاء وأمنع % 6(@)(@@) % أدنو فيبهرني جمال وجوده % % أنأى فيدعوني البهاء الأروع % 7(@)(@@) % فإذا دنوت فحكمة مقبولة % لكن لها قلب العلى يتصدع % 8(@)(@@) % وإذا بعدت فإمرة مقومة % % والنور من أرجائها يتشعشع % 9(@)(@@) % فأنا الأمير إذا بعدت فشقوتي % % في إمرتي وسعادتي إذ أنزع % 10(@)(@@) % فأمر أوقاتي وأسعدها إذا % % عاينت أعيان الأهلة تطلع % % PageV01P603 البحر : بسيط تام 1(@)(@@) % نار الإله على الأسرار تطلع % وما لها أثر في القلب ينطبع % % 2(@)(@@) % إذا يحس بأصوات اللهيب بها % % يأتي إليه رجيم السمع يستمع % 3(@)(@@) % والقلب حافظه فيه وليس له % % إلا العنا فلهذا ليس يتضع % 4(@)(@@) % فالآل يرفعه طورا ويخفضه % لأنه بدل منه فيتسع % % PageV01P604 البحر : طويل 1(@)(@@) % علمت بما في الغيب من كل كائن % % ومالا فما قلنا وما أدرك السمع % 2(@)(@@) % على أنني ما كنت إلا موحدا % بتوحيد فرق ما يخالطه جمع % 3(@)(@@) % علا الحق في الإدراك عن كل حادث % وهل يدرك التنزيه ما قيد الطبع % 4(@)(@@) % علاه بها عقلا وليس بذاته % وليس لمخلوق على حمله وسع % % 5(@)(@@) % عبيد وفي التحقيق رب كصورة % وليس له ضر وليس له نفع % 6(@)(@@) % عظيم على 
ms157	 من أو جليل من أجل من % تعالى فلا فطر لديه ولا صدع % % 7(@)(@@) % عزيز ذليل بائس وهو ذو غنى % % ولكن عمن إذ هو السيب والمنع % % 8(@)(@@) % عبدناه بالفقر الذي قام عندنا % % ولو قام ضد الفقر لم ندر ما الصنع % 9(@)(@@) % علينا من التقوى رقيت مسلط % نقي وقي فهو لي الوتر والشفع % % 10(@)(@@) % علوت عن التنزيه معنى وما علا % % عن الحكم والتشبيه فليدع من يدعو % % PageV01P605 البحر : بسيط تام 1(@)(@@) % ضاق النطاق وضاق الشبر والباع % عن التجلي وأبصار وأسماع % % 2(@)(@@) % فما يرى نفسه إلا به فله % في كل ذات تراكيب وأطباع % % PageV01P606 البحر : طويل 1(@)(@@) % ألا إنني العبد المليك السميدع % ول منزل من رحمة الله أوسع % 2(@)(@@) % ومن رحمة الله العظيم وجوده % % وهذا غريب في العلوم فاجمعوا % % 3(@)(@@) % له كل برهان عسى تدركونه % وليس له في عالم الفكر موضع % 4(@)(@@) % لقد وسع الحق المبين بصورة % % إلى مجدها تعنو الوجوه وتخضع % 5(@)(@@) % أنا الأزليث العين والمحدث الذي % % له في قلوب الكون حظ وموقع % % 6(@)(@@) % أنا فيضه السامي أنا عرش ذاته % % أنا العالم العلوي بل أنا أرفع % % 7(@)(@@) % أنا العربي الحاتمي أخو الندى % % إلى حضرتي تغدو المطي وترجع % 8(@)(@@) % ثقالا وقد كانت بهم في وروده % % خفافا فتعدو للنوال وتوضع % % 9(@)(@@) % لنا في زمان الخصب ملهى وملعب % وفي وقت جدب الأرض مرعى ومرتع % 10(@)(@@) % أنا عدله الساري أنا سر كونه % % أنا فضله الماضي الذي ليس يرجع % PageV01P607 11(@)(@@) % أنا المسجد الأقصى أنا الحرم الذي % % إلى بيته تعدو النياق وتسرع % 12(@)(@@) % إلى مهبط الأسماء تقنع أروسا % ونحو استواء الأرض تسمو وترفع % % PageV01P608 البحر : طويل 1(@)(@@) % دعا قومه نوح ليغفر ربهم % لهم فأجابوه لما كان قد دعا % % 2(@)(@@) % أجابوا بأحوال فغطوا ثيابهم % لسر بستر والسميع الذي وعى % % 3(@)(@@) % ولو أنهم نادوا ليكشف عنهم % غطاء العمى ما ارتد شخص ولا سعى % % 4(@)(@@) % وهذي إشارات لأمة أحمد % وليست لنوح والحديث هما معا % % 5(@)(@@) % رعى الله شخصا لم يزل ذا مهابة % كريما إماما حرمة الحق قد رعى % % 6(@)(@@) % لو أن له الخلق ينزل 
ms158	 وحيه % % على جبل راس به لتصدعا % % 7(@)(@@) % وأثبت منه قلب شخص علمته % % ولما أتاه وحيه ما تزعزعا % % 8(@)(@@) % وإن كان من قوم إذا ليلهم دجا % % تراهم لديه ساجدين وركعا % 9(@)(@@) % وتبصرهم عند المناجاة حسرا % حيارى سكارى خاضعين وخشعا % % PageV01P609 البحر : رمل تام 1(@)(@@) % بلغوا عني أم الأربعه % أنني فيما تريد إمعه % 2(@)(@@) % نظرت عيني إليها نظرة % ملأت قلبي نورا وسعه % 3(@)(@@) % فإذا شتت أمري قدر % جاء منها ما إليها جمعه % 4(@)(@@) % لم أسميها لأني خفت أن % يطلق الجار عليها الأربعه % 5(@)(@@) % علموا أهل ودادي أنه % فاز قلبي بالذي قد وسعه % 6(@)(@@) % باتباع المصطفى حصله % وحبيب الله من قد تبعه % 7(@)(@@) % أصبحت فيهم بهم حاكمة % وهم بين يديها وزعه % 8(@)(@@) % فبهم يحكم فيهم ولهم % % وعليهم حكم من قد شرعه % 9(@)(@@) % قال لي الحق وقد سرحني % % من قيود الطبع لما منعه % % 10(@)(@@) % مع من أنت عبيدي في الهوى % % قلت ربي أنا والله معه % PageV01P610 البحر : طويل 1(@)(@@) % إذا ما دعا داع تلبي من الحشى % % هويته فهو المجيب لمن دعا % % 2(@)(@@) % فما أنا إلا عينه ليس غيره % ولست بذي مزج ولا أنا بالوعا % % 3(@)(@@) % فمن قال إن القول بالحد واحد % % فذلك قول ليس يدريه من وعى % % 4(@)(@@) % من العلم إلا رسمه لا وجوده % % وإن مصيب الحق من قال أجمعا % % 5(@)(@@) % إذا عاينت عين لعين كلامه % % على ألسن الأرسال بالحس مصرعا % % 6(@)(@@) % فلا بد من صوت يعين حرفه % % ولا بد من حرف فقد ثبتا معا % % 7(@)(@@) % فيا منكر التركيب في كل ناطق % % وفي نطقه لو كنت بالحق مولعا % % 8(@)(@@) % رأيت وجود الحق عين كوائن % % أمنت لها من غير أن تتصادعا % % 9(@)(@@) % إذا كان نظمي عين نثري فمن هما % % فقل لهما يا صاح للحق وارجعا % % 10(@)(@@) % رعى الله عبدا منصفا ذا حقيقة % كما أنه بالحق للحق قد رعى % % PageV01P611 البحر : بسيط تام 1(@)(@@) % تعظيم ربك في تعظيم ما شرعا % % فاصدع فإن سعيد القوم من صدعا % % 2(@)(@@) % لكن بأمر الذي جاءتك شرعته % % تسعى على قدم فاشكره حين سعى % % 3 
ms159	(@)(@@) % فكن مع الله في ترتيب حكمته % إن الذي مع ربي لا يكون معا % % 4(@)(@@) % إفهم كلامي فإن الفهم أسعدكم % ولا تحد عنه إن العلم قد جمعا % % 5(@)(@@) % هو الدليل عليه لا تذره سدى % % فالهلك في ترك ما الرحمن قد شرعا % % 6(@)(@@) % العلم نصفان : نصف ليس يبلغه % فكر لذلك حكم الفكر قد منعا % % 7(@)(@@) % ونصفه فصحيح الفكر يبلغه % وليس منزله مثل الذي سمعا % % 8(@)(@@) % والكل حق وما أنصفت فيه وما % % لذاك رد فمن يدريه قد جمعا % % 9(@)(@@) % له الكمال فما شخص يقاومه % صنع الإله فشكر الله بي صنعا % % 10(@)(@@) % والله لو علمت نفسي بمن علمت % % لضاق عنها وجود الخلق ما اتسعا % % PageV01P612 11(@)(@@) % القلب يعرف ربي من تقلبه % % مثل الشؤون له إن سار أو رجعا % % 12(@)(@@) % والنفس تجهله من أجل شهوتها % % وعينها لفراق الحق ما دمعا % % 13(@)(@@) % لما تعزز عنه بات يطلبه % ولو تدانى له إليه ما ارتجعا % % 14(@)(@@) % وقد جرى مثل يدري وصورته % أحب شيء إلى الإنسان ما منعا % % PageV01P613 البحر : بسيط تام 1(@)(@@) % العلم بالله والعرفان لي ولقد % جمعت بينهما شرعا وما جمعا % % 2(@)(@@) % فالعلم يجمع ما العرفان يفرده % % في الحد يجتمعان إن نظرت معا % % 3(@)(@@) % ولا يقال بأن الحق يعرفنا % % وهو العليم بنا وهكذا شرعا % % 4(@)(@@) % لا تعلمونهم الله يعلمهم % هذي النيابة مهما كنت مستمعا % % 5(@)(@@) % ولم يقل فيه إن الله يعرفهم % فقل به إن تكن للحق متبعا % % 6(@)(@@) % إن الأديب الذي يمشي على قدر % % يوافق الحق إن أعطى وإن منعا % % 7(@)(@@) % قد اقتفى أثرا ما عنده خبر % بمن تفرد في التعبير فاخترعا % % 8(@)(@@) % الله كرمه إذ كان فضله % على سواه فلم يسنن ولا ابتدعا % % 9(@)(@@) % وإن تضاعف فيه الأجر فاستمعوا % % ما يستوي مقتد فيه بمن شرعا % % 10(@)(@@) % لولا الشريعة كان الشخص في عمه % % إذا أراد اقترابا بالذي صنعا % % PageV01P614 11(@)(@@) % فبين الحق ما الألباب تجهله % % فمقبل قابل لكل ما سمعا % % 12(@)(@@) % ومعرض عنه في خسر وفي حيد % % عن الصواب الذي عنه قد امتنعا % % PageV01P615 البحر : كامل تام 1(@)(@@) % الوحي علم الكون 
ms160	 إلا أنه % يخفى على العلماء بالأنواع % 2(@)(@@) % ولذاك ينكره الذي ما عنده % % علم بما فيه من الأفظاع % % 3(@)(@@) % فإذا يسطره اللبيب بكشفه % % أو فكره ليلذ بالأسماع % 4(@)(@@) % يدري به من ذاقه طعما ولم % % يكفر به إلا لضيق الباع % % PageV01P616 البحر : مجزوء المديد 1(@)(@@) % قل لأم الأربع % % أنت في الخير معي % % 2(@)(@@) % لولا عيني لم يكن % % لك عين فاسمعي % % 3(@)(@@) % إنما نحن لها % % في الوجود فدعي % % 4(@)(@@) % ولها الحكم بنا % % في الجهات الأربع % % 5(@)(@@) % فإذا علمت ذا % % فلكوني فارجعي % % 6(@)(@@) % رجعة مرضية % لرياضي وارتعي % % 7(@)(@@) % أنا فيما قلته % % من حديث مدعي % % 8(@)(@@) % ودليلي واضح % مثل لمع اليرمع % 9(@)(@@) % في سراب فترى % % ماء مزان فاكرعي % % 10(@)(@@) % فإذا ما جئته % % لم تجد شيئا معي % % PageV01P617 11(@)(@@) % كل ما جئت به % عن خطيب مصقع % 12(@)(@@) % وحديثي إنما % % هو مني ومعي % % PageV01P618 البحر : رمل تام 1(@)(@@) % فقيل له في ذلك ما قيل فأجاب فقال : فإذا كنت معي أنت معي % % وإذا ما لم تكن لست معي % % 2(@)(@@) % فلتع الأمر الذي جئت به % يا حبيب القلب حقا فلتع % % 3(@)(@@) % أنا إلا واحد العصر به % % ما أنا فيه شخيص مدعي % % 4(@)(@@) % فخذ الأمر الذي تعرفه % % من وجودي ثم إن شئت دع % 5(@)(@@) % ما أ ، ا غير ولا أعرفه % للذي قلت له أنت معي % % 6(@)(@@) % قلت للنفس وقد قيل لها % % مثل ما قيل من العب وارتع % 7(@)(@@) % ما سمعتم ما جرى من خبر % % منهم بالله يا نفس اسمعي % % 8(@)(@@) % واحذر المنكر الذي تعرفه % % إذ تحليت به لا تخدع % 9(@)(@@) % لست أبكي لفراق أبدا % لشهودي حالة من موضعي % % 10(@)(@@) % فحبيبي نصب عيني أبدا % فسواء غاب أو كان معي % % PageV01P619 11(@)(@@) % جل أمري أن عيني معه % % أينما كان فطب واستمع % PageV01P620 البحر : بسيط تام 1(@)(@@) % لبيك لبيك من واع ومن داع % لبرء ما بي من أمراض وأوجاع % 2(@)(@@) % دعوتني بلسان الحق تطلبني % % إني لما قد دعوت السامع الواعي % % 3(@)(@@) % دعوتني وضمنتم ما أسر به % % إذا أجبت فما خيبت أطماعي % % 4(@)(@@) % لا تفرحن بشيء لست تعرفه % % إن 