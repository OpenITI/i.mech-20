ms18	 خود در راه کرمان کرده ضیف(@)(@@) 74 تو چه دانی تا سلیمان تخت و ملک %~% داد بر باد و بشد تا اوج فلک(@)(@@) 75 تو چه دانی تا که موسی دربحار %~% کرد فرعون طبیعی غرقه زار(@)(@@) 76 تو چه دانی تا که جرجیس نبی %~% جان خود در راه او کرده فدی(@)(@@) 77 تو چه دانی تا که عیسی در تنست %~% برتر از روحست و نور روشنست(@)(@@) 78 تو چه دانی تا محمد در وجود %~% اولین و آخرین او بود و بود(@)(@@) 79 این تمامت در که پیدا آمدست %~% مظهر اعیان و اشیا آمدست(@)(@@) 80 دین خود را در ره باطل منه %~% این سخنها را ره باطل منه(@)(@@) 81 کاین رموز من ز جایی دیگرست %~% سیر جانم از ورای دیگرست(@)(@@) 82 آنچه من زین راه تنها یافتم %~% بود پنهان منش پیدا یافتم(@)(@@) 83 هرکه در راه محمد ره نیافت %~% تا ابد گردی ازین درگه نیافت(@)(@@) 84 راه پیغمبر همه اسرار بود %~% پای تا سر غرقه انوار بود(@)(@@) 85 آنچه اسرار نهانی بد نگفت %~% راز حق درجان پاک خود نهفت(@)(@@) 86 سر اسرارش کجا داند کسی %~% او نگفت اسرار خود با هر خسی(@)(@@) 87 یک شبی در خواب دیدم روی او %~% عاشق و بی خود دویدم سوی او(@)(@@) 88 خاک پای او شدم در پای او %~% کز دو عالم برتر آمد جای او(@)(@@) 89 خاک پایش قبله روح آمدست %~% انبیا را قبله گاه جان بدست(@)(@@) 90 آنکه در معنی بعالم عالمست %~% ز آفرینش آفرینش عالمست(@)(@@) 91 دست من بگرفت آن شاه جهان %~% در دهان من فکند آب دهان(@)(@@) 92 گفت ای عطار پر اسرار من %~% لایقی در دیدن انوار من(@)(@@) 93 آنچه حق بر جان و جسمت داده است %~% گنج پنهان بر دلت بنهاده است(@)(@@) 94 ماعیان کردیم این گنج ترا %~% دست مزدی دادم این رنج ترا(@)(@@) 95 هر گهر کز بحر جان افشانده %~% رمزهای سر جانان رانده(@)(@@) 96 هیچ شاعر زین 
ms19	 معانی در نیافت %~% سر اسرار نهانی در نیافت(@)(@@) 97 بر دل تو جمله آسان کردهایم %~% گرچه پیدا بود پنهان کردهایم(@)(@@) 98 در ازل این خرقهات پوشیدهایم %~% پس شراب صرف کل نوشیدهایم(@)(@@) 99 هرچه میخواهی طلب کن تا ترا %~% روی بنمائیم بی ارض و سما(@)(@@) 100 این بگفت و روی خود پنهان نمود %~% بعد از آن روی دلم با جان نمود(@)(@@) 101 این همه من از محمد یافتم %~% زانکه سوی قرب او بشتافتم PageV01P05(@)(@@) 1 ای نموده جسم و جان از کاینات %~% هست در تاریکیت آب حیات(@)(@@) 2 ای همه اسرار جانان کرده فاش %~% بیش ازین در صورت حسی مباش(@)(@@) 3 آنچه بخشیدم ترا آن قسم کن %~% هم نموداری بکن فاش این سخن(@)(@@) 4 آنچه هرگز آدمی نشنیده است %~% نه کسی دانسته و نه دیده است(@)(@@) 5 در رموز سر سبحانی بخوان %~% سر این تفسیر ربانی بدان(@)(@@) 6 یک زمان بر منبر وحدت برآی %~% زنگ شرک از صورت حس بر زدای(@)(@@) 7 حافظان عشق را آور بجوش %~% جمله ذرات آور در خروش(@)(@@) 8 از زبور عشق سر آغاز کن %~% پر و بال مرغ معنی باز کن(@)(@@) 9 همچو داود آیت عشاق خوان %~% سر آن با مذهب عشاق ران(@)(@@) 10 از بحار عشق جوهر بار کن %~% این زمان دل را بهمت یار کن(@)(@@) 11 بر سر عشاق جوهرها ببار %~% چون درآمد شاخ معنیت ببار(@)(@@) 12 هر زمان وصفی دگر آغاز کن %~% هر نفس سازی دگر برساز کن(@)(@@) 13 این همه ذرات پیدا و نهان %~% از وجود خویشتن گردان عیان(@)(@@) 14 این همه اشجار معنی بربرست %~% جایشان بر خاک و باد و آذرست(@)(@@) 15 قسمتی ده روح روحانی عشق %~% تا بگوید راز پنهانی عشق(@)(@@) 16 پرزنان سیمرغ وار از کوه قاف %~% کوه بر منقار معنی بر شکاف(@)(@@) 17 از پس قاف وجودت رخ نمای %~% این معما را بمعنی برگشای(@)(@@) 18 تو ازین صورت نه بینی جز که هیچ %~% عاقبت افتی میان پیچ پیچ(@)(@@) 19 
