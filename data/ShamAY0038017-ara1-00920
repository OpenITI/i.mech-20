ms901	 الأسدي(@)(@@) يروي عن العراقيين، روى عنه إسماعيل بن سالم.(@)(@@)(@@)(@@) ||| AUTO جهضم بن عبد الرحمن التيمي(@)(@@) يروي عن عكرمة، روى عنه المعافى بن عمران، وأحسبه جهضما أبا معاذ الذي روى عنه عباد بن العوام.(@)PageV01P002(@)(@@) [ج 3: ص 265](@)(@@)(@@)(@@) ||| AUTO الجارود(@)(@@) شيخ من أهل مرو، قال: سمعت عكرمة يقرأ {الر كتاب أحكمت آياته ثم فصلت}. قال: وسمعته، يقول {وبرزت الجحيم لمن يرى}. روى عنه أبو تميلة يحيى بن واضح.(@)(@@)(@@)(@@) ||| AUTO جروة بن جميل(@)(@@) شيخ يروي عن أبيه، عن عمر، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الجراح بن الضحاك(@)(@@) يروي عن كريب الكندي، عن علي بن الحسين، روى عنه إسحاق بن سليمان الرازي.(@)(@@)(@@)(@@) ||| AUTO جحش بن زياد الضبي(@)(@@) من أهل الكوفة، يروي عن الأحنف بن قيس، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO جعونة(@)(@@) شيخ يروي الحكايات عن عمر بن عبد العزيز، روى عنه عمرو بن ميمون، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO جدار العذري(@)(@@) قوله، روى عنه حسان بن عطية.(@)(@@)(@@)(@@) ||| AUTO جحشة بن علاء(@)(@@) يروي عن زفر بن الحارث، عن معاوية، روى ابن المبارك عن رجل عنه.(@)(@@)(@@)(@@) ||| AUTO جبرائيل بن أحمر، أبو بكر الجملي(@)(@@) يروي عن عبد الله بن بريدة، روى عنه شريك بن عبد الله النخعي.(@)(@@)(@@)(@@) ||| AUTO الجلاح أبو كثير(@)(@@) مولى عمر بن عبد العزيز، يروي عن حنش الصنعاني، عن فضالة بن عبيد، أن النبي صلى الله عليه وسلم قال: لا تبيعوا الذهب بالذهب إلا وزنا بوزن. روى عنه عبيد الله بن أبي جعفر، وعمرو بن الحارث.(@)PageV01P002(@)(@@) [ج 3: ص 266](@)(@@)(@@)(@@) ||| AUTO جهير بن يزيد العبدي، من عبد القيس(@)(@@) بصري، كنيته أبو حفص الزاهد، يروي عن ابن سيرين، روى عنه النضر بن ظاهر القيسي.(@)(@@)(@@)(@@) ||| AUTO جخدب بن جرعب التيمي(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO جهور بن سفيان بن الحارث الأزدي، أبو الحارث(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه أهل بلده.(@)(@@)(@@)(@@) || AUTO باب الحاء(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين من هذه الطبقة مما ابتدأ اسمه على الحاء(@)(@@)(@@)(@@) ||| AUTO الحسن 
ms902	 بن الحسن بن الحسن بن علي بن أبي طالب(@)(@@) رضي الله عنهم، يروي عن أبيه، روى عنه أهل بلده، أمه فاطمة بنت الحسين بن علي، مات في الحبس بالهاشمية مع أخيه عبد الله بن الحسن.(@)(@@)(@@)(@@) ||| AUTO الحسن بن علي بن الحسن بن علي بن أبي طالب(@)(@@) رضوان الله عليهم، الهاشمي، من أهل المدينة، يروي عن أبيه، روى عنه محمد بن أبي سارة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن زيد بن الحسن بن علي بن أبي طالب(@)(@@) يروي عن أبيه، وعكرمة، روى عنه مالك بن أنس، ومحمد بن إسحاق، وأهل المدينة، كنيته أبو محمد، أمه أم ولد، مات بالحاجر، وهو بريد مكة من العراق في السنة التي رجع فيها المهدى سنة ثمان وستين مائة.(@)PageV01P002(@)(@@) [ج 3: ص 267](@)(@@)(@@)(@@) ||| AUTO الحسن بن الفضل بن الحسن بن عمرو بن أمية الضمري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الله بن مالك بن الحويرث(@)(@@) يروي عن أبيه، عن جده، روى عنه عمران بن أبان الواسطي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبيد الله النخعي(@)(@@) من أهل الكوفة، كنيته أبو عروة، يروي عن الشعبي، وإبراهيم، روى عنه الثوري، وابن عيينة، مات سنة تسع وثلاثين ومائة، وقد قيل سنة اثنتين وأربعين.(@)(@@)(@@)(@@) ||| AUTO الحسن بن الحر الكوفي(@)(@@) خال حسين بن علي الجعفي، يروي عن الشعبي، ونافع، روى عنه ابن عجلان، وزهير بن معاوية، وقد قيل: إنه سمع أبا الطفيل، وما أراه بصحيح، مات في أول ولاية أبي العباس.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أبي الحسناء، أبو سهل القواس العنزي(@)(@@) من أهل البصرة، يروي عن الحسن، وأبي العالية، روى عنه أبو قتيبة مسلم بن قتيبة، وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الله القصاب(@)(@@) يروي(@)(@@) (295) -[3: 267] عن نافع عن ابن عمر، قال: " وقت لنا رسول الله صلى الله عليه وسلم في المسح على الخفين يوما وليلة وللمسافر ثلاثة أيام ". رواه مليح بن وكيع بن الجراح، عن أبيه، عنه(@)(@@)(@@)(@@) ||| AUTO الحسن بن حصين بن أبي الحر بن الخشخاش العنبري(@)(@@) والد عبيد الله بن 
ms903	 الحسن الفقيه، من أهل البصرة، يروي عن سعيد بن جبير، وعلي بن حسين، روى عنه معاذ بن معاذ العنبري.(@)PageV01P002(@)(@@) [ج 3: ص 268](@)(@@)(@@)(@@) ||| AUTO الحسن بن ثابت الثعلبي، كنيته أبو على الأحول(@)(@@) يروي عن إسماعيل بن أبي خالد، والأعمش، عداده في أهل الكوفة، روى عنه يحيى بن آدم، وهو الحسن أبو على الذي يروي عن أبيه، عن جدته، عن علي الذي روى عنه الثوري، وسويد بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO الحسن بن حكيم بن الحارث(@)(@@) نسيب ابن سيرين، يروي عن أبيه، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أبي الجعد، أبو محمد اليربوعي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO الحسن بن ثوبان الهاشمي(@)(@@) يروي عن موسى بن وردان، روى عنه الليث بن سعد، ويحيى بن أيوب.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عمران، أبو عبد الله العسقلاني(@)(@@) يروي عن مكحول، وعطية بن قيس، وابن عبد الرحمن بن أبزى، روى عنه شعبة، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO الحسن بن حكيم الثقفي، كنيته أبو حكيم(@)(@@) وأمه مولاة أبي برزة الأسلمي، يروي عن أبيه، عن أبي برزة، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO الحسن بن ذكوان المعلم(@)(@@) يروي عن عطاء، وسليمان الأحول، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO الحسن بن حميد(@)(@@) يروي عن أبي سعيد الأسدي، صاحب الفساطيط، عن سمرة بن جندب، روى عنه وهب بن إسماعيل الأسدي.(@)PageV01P002(@)(@@) [ج 3: ص 269](@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الرحمن(@)(@@) شيخ يروي عن كثير بن مرة، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن الحسين الجحدري(@)(@@) من أهل الكوفة، يروي عن الأعمش، روى عنه يحيى بن المنذر الحجري، والد أحمد بن يحيى بن المنذر.(@)(@@)(@@)(@@) ||| AUTO الحسن بن سالم بن أبي الجعد الأشجعي(@)(@@) مولى غطفان، من أهل الكوفة، يروي عن نعيم بن أبي هند، روى عنه عيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الرحمن الكاتب(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه عبد الواحد بن زياد، وعيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عميرة(@)(@@) يروي عن مسلم بن يسار، روى عنه حكام بن سلم 
ms904	 الرازي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عمرو الفقيمي(@)(@@) من أهل الكوفة، أخو فضيل بن عمرو، يروي عن إبراهيم النخعي، روى عنه سفيان الثوري، وأهل الكوفة، مات سنة اثنتين وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن صالح بن حي الهمداني الثوري(@)(@@) من أهل الكوفة، كنيته أبو عبد الله، يروي عن الشعبي، وسماك بن حرب، روى عنه أهل الكوفة، كان مولده سنة مائة، ومات سنة سبع وستين ومائة، وهو مختف من القوم، وكان فقيها ورعا من المتقشفة الخشن، وممن تجرد للعبادة، ورفض الرئاسة على تشيع فيه.(@)(@@)(@@)(@@) ||| AUTO الحسن بن علي الهزاني(@)(@@) من أهل البصرة، يروي عن الصهباء بنت كريم، عن عائشة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO الحسن بن الفرات بن أبي عبد الرحمن القزاز التميمي(@)(@@) من أهل الكوفة، يروي عن ابن أبي مليكة، وأبيه، روى عنه وكيع بن الجراح.(@)PageV01P002(@)(@@) [ج 3: ص 270](@)(@@)(@@)(@@) ||| AUTO الحسن بن أبي فاطمة(@)(@@) يروي عن الزهري، روى عنه معن بن عيسى القزاز.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عطاء المدني(@)(@@) يروي عن الحسن، وأبيه، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO الحسن بن ميسرة(@)(@@) يروي عن نافع، روى عنه الفضل بن موسى السيناني.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عقبة، أبو كيران(@)(@@) كوفي، يروي عن الشعبي، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الحسن القردوسي(@)(@@) يروي عن الحسن، روى عنه عكرة بن عمار، لا أدري من هو، ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO الحسن بن كثير(@)(@@) شيخ يروي عن عكرمة بن خالد، روى عنه عبد الوهاب بن الورد.(@)(@@)(@@)(@@) ||| AUTO الحسن بن محمد الأنصاري(@)(@@) يروي عن رجل، عن صهيب، روى عنه عبد الحميد بن جعفر.(@)(@@)(@@)(@@) ||| AUTO أبو المليح الرقي، اسمه: الحسن بن عمرو بن عبد الله بن يحيى الفزاري، كنيته أبو عبد الله(@)(@@) مولى فزارة، ولقبه أبو المليح، مولى لعمر بن هبيرة، يروي عن الزهري، وميمون بن مهران، روى عنه ابن المبارك، وأهل بلده، مات سنة إحدى وثمانين بعد عبيد الله بن عمرو بسنة، وكان له يوم مات تسعة وتسعين سنة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن كثير الأحمسي البجلي(@)(@@) من أهل الكوفة، يروي 
ms905	 عن أبيه، عن علي، روى عنه ابن المبارك.(@)PageV01P002(@)(@@) [ج 3: ص 271](@)(@@)(@@)(@@) ||| AUTO الحسن بن وهب(@)(@@) شيخ يروي عن عطاء، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO الحسن بن حاتم الألهاني حمصي(@)(@@) يروي عن عمير بن خالد الوهبي، عن أنس بن مالك، روى عنه أحمد بن إبراهيم اليحصبي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن مسلم بن يناق المكي(@)(@@) يروي عن مجاهد، وطاوس، روى عنه ابن أبي نجيح، وابن جريج، يقال: إنه مات قبل طاوس، وقد سمع شعبة من مسلم بن يناق، ولم يسمع من ابنه الحسن، لأن الحسن مات قبل أبيه.(@)(@@)(@@)(@@) ||| AUTO الحسن بن محمد المروزي(@)(@@) يروي عن عبد الله بن بريدة، روى عنه نعيم بن حماد المروزي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن همام(@)(@@) شيخ من أهل الشام، يروي عن سعيد بن زرعة، روى عنه محمد بن الوليد الزبيدي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن رستم(@)(@@) من أهل أيلة، يروي عن جماعة من التابعين، روى عنه أهل الشام والحجاز.(@)(@@)(@@)(@@) ||| AUTO الحسن بن مسلم الهذلي(@)(@@) يروي عن مكحول، روى عنه شعبة، إن لم يكن ابن عمران فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO الحسن بن شقيق بن محمد بن دينار بن مشعب العبدي(@)(@@) من أنفسهم، من أهل مرو، وقال: رأيت عبد الله بن بريدة يبول في الماء الجاري. روى عنه ابنه علي بن الحسن بن شقيق، صاحب ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عياش(@)(@@) أخو أبي بكر بن عياش، يروي عن جعفر بن PageV01P002 [ج 3: ص 272] محمد، روى عنه يحيى بن آدم، والكوفيون.(@)(@@)(@@)(@@) ||| AUTO الحسن بن الأعمش القاضي(@)(@@) يروي عن يحيى بن سعيد الأنصاري، روى عنه سعيد بن جناح الزاهد النجاري.(@)(@@)(@@)(@@) ||| AUTO الحسن بن وقاص الأنصاري(@)(@@) يروي عن أبيه، ومولاته، عن عائشة، روى عنه أبو معشر البراء.(@)(@@)(@@)(@@) ||| AUTO أبو يونس القوي، اسمه: الحسن بن يزيد الضمري(@)(@@) يروي عن سعيد بن جبير، وأبي سلمة، ومجاهد، روى عنه الثوري، وإنما سمي أبو يونس القوي لقوته على العبادة، وذلك أنه قدم مكة، فطاف في يوم واحد سبعين أسبوعا، فسمي القوي، وكان من عباد أهل الكوفة وقرائهم.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أبي 
ms906	 يزيد الهمداني(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه وكيع، ومالك بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عطية العوفي(@)(@@) يروي عن أبيه، روى عنه ابنه الحسين بن الحسن، وأحاديث الحسن بن عطية ليست بنقية.(@)(@@)(@@)(@@) ||| AUTO الحسن بن يزيد الأصم القرشي، أبو على(@)(@@) يروي عن السدي، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO الحسن العبدي(@)(@@) شيخ يروي عن زيد بن وهب، روى عنه ليث بن أبي سليم.(@)PageV01P002(@)(@@) [ج 3: ص 273](@)(@@)(@@)(@@) ||| AUTO الحسن، أبو عبد الله(@)(@@) شيخ يروي المراسيل، روى عنه أيوب بن النجار، لا أدري من هو، ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO الحارث بن نوفل بن عروة بن المغيرة بن شعبة(@)(@@) من أشراف أهل الكوفة، روى عن الشعبي، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يزيد العكلي(@)(@@) من أهل الكوفة، يروي عن الشعبي، والنخعي، روى عنه المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يزيد الحضرمي(@)(@@) من أهل مصر، يروي عن علي بن رباح اللخمي، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي المدني(@)(@@) يروي عن أبيه، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبد الملك(@)(@@) شيخ يروي عن نافع بن جبير بن مطعم، عن أبي هريرة، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عمير، أبو الجودي(@)(@@) من أهل الشام، يروي عن أهل بلده، روى عنه شعبة، وأبو عوانة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبيد الله الأنصاري(@)(@@) من أهل الشام، يروي عن أم الدرداء، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO الحارث بن النعمان الفراسي(@)(@@) يروي المراسيل، روى عنه نوح بن قيس الطاحي.(@)PageV01P002(@)(@@) [ج 3: ص 274](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الحارث بن عبد الرحمن بن المغيرة بن أبي ذباب الدوسي(@)(@@) من أهل المدينة، يروي عن أبي سلمة، وعطاء بن ميناء، كان ينزل الأعوص بالمدينة، روى عنه صفوان بن عيسى، ومحمد بن إسحاق، وأهل المدينة، مات سنة ست وأربعين ومائة.(@)(@@) الحارث بن عبد الرحمن(@)(@@) خال بن أبي ذئب، من أهل المدينة، يروي عن محمد بن جبير بن مطعم، روى عنه ابن أبي 
ms907	 ذئب، مات سنة تسع وعشرين ومائة، كنيته أبو عبد الرحمن، وأمه أم ولد، ولم يرو عنه إلا ابن أبي ذئب، وهو من قريش.(@)(@@)(@@)(@@) ||| AUTO الحارث بن الحكم الضمري(@)(@@) يروي عن أبي عمرو بن حماس، عداده في أهل المدينة، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO الحارث بن رحيل(@)(@@) يروي عن أبيه، روى عنه عبد الملك بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يعقوب المصري(@)(@@) والد عمرو بن الحارث، يروي عن جماعة من التابعين، روى عنه ابنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عمرو(@)(@@) ابن أخي المغيرة بن شعبة، يروي عن أصحاب معاذ، روى عنه أبو عون الثقفي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن حصيرة(@)(@@) من أهل الكوفة، يروي عن زيد بن وهب وعكرمة، روى عنه أهل بلده، وعبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO الحارث بن شبيل(@)(@@) من أهل الكوفة، يروي عن أبي عمرو الشيباني، عن زيد بن أرقم، روى عنه إسماعيل بن أبي خالد.(@)PageV01P002(@)(@@) [ج 3: ص 275](@)(@@)(@@)(@@) ||| AUTO الحارث بن أنعم(@)(@@) يروي عن شرحبيل بن أيمن، روى عنه زهير بن معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث الأزدي(@)(@@) شيخ يروي عن ابن الحنفية، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO الحارث بن بدل النصري(@)(@@) يروي عن عمرو بن سفيان، عن رجل شهد النبي صلى الله عليه وسلم روى عنه محمد بن عبد الله الشعيثي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن ثقف(@)(@@) يروي عن الحسن، روى عنه يحيى بن يمان العجلي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن الجارود(@)(@@) يروي عن إبراهيم النخعي، روى عنه أبو عوانة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبيد مكي(@)(@@) يروي عن محمد بن عبد الملك بن أبي محذورة، عن أبيه عبد الملك، روى عنه مسدد.(@)(@@)(@@)(@@) ||| AUTO الحارث بن سليمان الكندي(@)(@@) يروي عن كردوس بن عباس التغلبي، روى عنه وكيع، وطلق بن غنام، والكوفيون.(@)(@@)(@@)(@@) ||| AUTO الحارث بن شبل(@)(@@) يروي عن أم النعمان، عن عائشة، روى عنه شاذ بن الفياض، اسمه هلال، ولقبه شاذ.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عتبة الحمصي(@)(@@) يروي عن عبد الرحمن بن سلم، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عنبسة، وقيل: عتبة(@)(@@) يروي عن عمر بن عبد 
ms908	 العزيز، روى عنه صدقة بن عبيد الله.(@)PageV01P002(@)(@@) [ج 3: ص 276](@)(@@)(@@)(@@) ||| AUTO الحارث بن عبد الرحمن(@)(@@) يروي عن أبي الجلاس، عن علي، روى عنه هارون بن صالح.(@)(@@)(@@)(@@) ||| AUTO الحارث بن غسان المزني(@)(@@) يروي عن أبي عمران الجوني، روى عنه عبد الله بن عبد الوهاب الحجبي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن فضيل الأنصاري الخطمي(@)(@@) من أهل المدينة، كنيته أبو عبد الله، يروي عن سفيان بن أبي العوجاء، روى عنه محمد بن إسحاق، وابنه عبد الله بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الحارث بن قيس(@)(@@) يروي عن أزهر الحرازي، روى ثور بن يزيد، عن أبي عون، عنه.(@)(@@)(@@)(@@) ||| AUTO الحارث بن مسلم بن الحارث التميمي(@)(@@) يروي عن أبيه، روى عنه عبد الرحمن بن حسان.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي منصور(@)(@@) يروي عن مجاهد، روى عنه موسى الصغير.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يزيد السكوني(@)(@@) من أهل حمص، يروي عن عمرو بن قيس، روى عنه الوليد بن مسلم، والوليد بن قحذم بن سليمان.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبيدة المصري، كنيته أبو وهب الساوي(@)(@@) يروي عن هشام بن عروة، وأهل بلده، روى عنه عمرو بن عثمان الحمصي، وأهل مصر، مات في ذي القعدة سنة ست وثمانين ومائة، وهو الذي يقال له: الحارث بن عميرة الكلاعي، عداده في أهل الشام، سكن مصر.(@)PageV01P002(@)(@@) [ج 3: ص 277](@)(@@)(@@)(@@) ||| AUTO الحارث بن مقسم(@)(@@) يروي المراسيل، روى عنه الحكم بن أبان.(@)(@@)(@@)(@@) ||| AUTO الحارث بن منقذ(@)(@@) من أهل البصرة، يروي عن الحسن، وابن سيرين، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO أبو العنبس(@)(@@) الذي روى عنه مسعر بن كدام، عن أبي العدبس، واسم أبي العنبس: الحارث، واسم أبي العدبس: منيع، ومدار ما روياه عن أبي غالب، وهو لا شيء.(@)(@@)(@@)(@@) ||| AUTO حبيب بن هند بن أسماء بن هند بن حارثة الأسلمي(@)(@@) يروي عن أبيه، وعروة بن الزبير، روى عنه عبد الله بن أبي بكر، وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي عمرة القصاب، كنيته أبو عبد الله(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، روى عنه الثوري، مات سنة اثنتين وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO حبيب بن النعمان 
ms909	(@)(@@) يروي عن عمرو بن راشد، روى عنه عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO حبيب بن قيس(@)(@@) روى عن ابن أبي محذورة، عن أبيه، روى عنه سليمان التيمي.(@)(@@)(@@)(@@) ||| AUTO حبيب الأعور(@)(@@) يروي عن عروة بن الزبير، روى عنه الزهري، إن لم يكن بن هند بن أسماء فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي حبيب الجرمي(@)(@@) صاحب الأنماط، من أهل البصرة، يروي عن الحسن، وابن سيرين، وهو جد عبد الرحمن بن محمد بن حبيب بن أبي حبيب الذي روى عنه قتيبة بن سعيد حديث قتل الجعد بن درهم، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 278](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حبيب بن أبي جبيرة(@)(@@) عن يعلى بن سيابة، روى عنه عاصم بن أبي النجود.(@)(@@)(@@)(@@) ||| AUTO حبيب بن جري النهدي(@)(@@) من أهل الكوفة، يروي عن أبي جعفر محمد بن علي، روى عنه أهل العراق، وأحسبه بن جري بن كليب.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي جزيرة(@)(@@) يروي عن جدته، روى عنه مسلم بن إبراهيم، والتبوذكي، ومن زعم أنه حبيب بن أبي جرير فقد وهم.(@)(@@)(@@)(@@) ||| AUTO حبيب، أبو الأشعث(@)(@@) شيخ يروي عن ابن سيرين، روى عنه همام بن يحيى.(@)(@@)(@@)(@@) ||| AUTO حبيب بن حجر(@)(@@) شيخ يروي عن ثابت البناني، روى عنه روح بن عبادة.(@)(@@) حبيب(@)(@@) مولى حبة بنت المطلب، يروي عن جده، روى عنه عمار بن أبي عمار.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سليم الرقي(@)(@@) يروي عن شريح، روى عنه الشيباني، والأعمش.(@)(@@)(@@)(@@) ||| AUTO حبيب بن شهاب العنبري(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه يحيى القطان.(@)(@@) حبيب(@)(@@) مولى عروة بن الزبير، يروي عن عروة، روى عنه أهل المدينة، مات في ولاية مروان بن محمد، يخطئ.(@)(@@)(@@)(@@) ||| AUTO حبيب بن عيسى، أبو محمد العجمي(@)(@@) أصله من فارس، سكن البصرة، يروي عن الحسن، قال: الأواه الذي قلبه معلق عند الله. روى عنه أهل البصرة، وكان عابدا فاضلا ورعا تقيا من المجابين الدعوة في الأوقات، أخباره في التقشف والعبادة مشهورة، يعنى عن الإغراق في ذكرها.(@)(@@) (296) -[3: 278] حدثني عمر بن محمد الهمداني، ثنا زكريا بن يحيى الوقار، 
ms910	 قال: ثنا الخصيب بن ناصح الحارثي، عن صالح المري، عن حبيب أبي محمد الفارسي، عن الفرزدق، PageV01P002 [ج 3: ص 279] قال: " لقيت أبا هريرة بالشام، فقال لي: أنت الفرزدق الشاعر؟ قلت: نعم، قال: أما إنه إن طال بك عمر ستلقى أقواما يقولون لا توبة لك، فلا يقطعن رجاءك من الله. "(@)(@@)(@@)(@@) ||| AUTO حبيب، أبو الحسن(@)(@@) يروي عن أبي البختري، روى عنه عمرو بن حسين.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سيارة(@)(@@) شيخ يروي المراسيل، روى عنه سليمان الأعمش.(@)(@@)(@@)(@@) ||| AUTO حبيب بن خالد الأسدي(@)(@@) يروي عن أبي إسحاق السبيعي، روى عنه محمد بن مقاتل المروزي.(@)(@@)(@@)(@@) ||| AUTO حبيب بن زيد الأنصاري(@)(@@) يروي عن عباد بن تميم، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO حبيب بن الزبير(@)(@@) مولى لبني هلال، يروي عن عبد الله بن أبي الهذيل، وعكرمة، روى عنه شعبة، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سليم العبسي(@)(@@) من أهل الكوفة، يروي عن بلال بن يحيى، روى عنه عبد الله بن موسى، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سليم الباهلي، أبو محمد(@)(@@) من أهل البصرة، يروي عن بكر بن عبد الله المزني، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سندر(@)(@@) يروي عن عبد الله بن ضمعج، روى عنه خالد بن يزيد.(@)(@@)(@@)(@@) ||| AUTO حبيب بن الشهيد(@)(@@) مولى الأزد، كنيته أبو شهيد، ويقال: أبو PageV01P002 [ج 3: ص 280] مرزوق، وقد قيل: أبو محمد، يروي عن الحسن، وابن سيرين، روى عنه أهل العراق، مات سنة خمس وأربعين ومائة في آخرها بعد الهزيمة، وصلى عليه سوار، وذلك في أوسط أيام التشريق.(@)(@@)(@@)(@@) ||| AUTO حبيب بن صالح الطائي(@)(@@) يروي عن يزيد بن شريح، كنيته أبو موسى، عداده في أهل الشام، روى عنه حريز بن عثمان.(@)(@@)(@@)(@@) ||| AUTO حبيب بن عمر الأنصاري المدني(@)(@@) روى عن أبيه، روى عنه بقية بن الوليد.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي قريبة، أبو محمد المعلم(@)(@@) يروي عن عطاء، وابن سيرين، روى عنه يزيد بن زريع، والحمادان، مات سنة ثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO حبيب القناد(@)(@@) شيخ من أهل البصرة، يروي عن أهل بلده، روى عنه أيوب السختياني.(@)(@@)(@@)(@@) ||| AUTO 
ms911	 حبيب بن عمرو(@)(@@) يروي عن أبي جعفر، روى عنه قتادة، وقد قيل: عمرو بن حبيب.(@)(@@)(@@)(@@) ||| AUTO حبيب، أبو عمر(@)(@@) يروي عن امرأة، عن عائشة، روى عنه عثمان بن عمر بن فارس.(@)(@@)(@@)(@@) ||| AUTO حبيب بن عائذ الكوفي(@)(@@) والد عائذ بن حبيب، يروي عن أهل العراق، روى عنه أهل بلده.(@)PageV01P002(@)(@@) [ج 3: ص 281](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حبيب بن عيسى(@)(@@) يروي عن مكحول، عداده في أهل مصر، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي العالية(@)(@@) يروي المراسيل، روى عنه يحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي مرزوق(@)(@@) مولى بني أسد، يروي عن نافع، روى عنه جعفر بن برقان، مات سنة ثمان وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO حبيب بن مهاجر(@)(@@) يروي عن عطاء، روى عنه منصور بن زاذان.(@)(@@)(@@)(@@) ||| AUTO حبيب بن نجيح(@)(@@) يروي عن عبد الرحمن بن غنم، روى عنه الجراح بن المنهال.(@)(@@)(@@)(@@) ||| AUTO حبيب بن هارون(@)(@@) يروي عن زيد بن أسلم، روى عنه سليمان التيمي.(@)(@@) حبيب(@)(@@) شيخ يروي عن مورق العجلي، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO الحكم بن سنان بن سلمة بن المحبق الهذلي(@)(@@) عداده في أهل البصرة، يروي المقاطيع، روى عنه أبو عاصم، عن ابنه حفص بن الحكم عنه.(@)(@@)(@@)(@@) ||| AUTO الحكم بن أبي إسحاق(@)(@@) يروي عن ابن المسيب، والحسن، وأبي سلمة، روى عنه أبو هلال الراسبي.(@)(@@)(@@)(@@) ||| AUTO الحكم بن المطلب بن عبد الله بن حنطب المخزومي القرشي(@)(@@) من PageV01P002 [ج 3: ص 282] أهل المدينة، يروي عن أبيه، روى عنه أخوه عبد العزيز بن المطلب.(@)(@@)(@@)(@@) ||| AUTO الحكم بن الصلت المؤذن(@)(@@) من أهل المدينة، يروي عن أبيه، عن أبي هريرة، روى عنه عبد الملك بن المغيرة، والقعنبي.(@)(@@)(@@)(@@) ||| AUTO الحكم بن جحل الأزدي(@)(@@) من أهل البصرة، يروي عن عطاء، روى عنه ديلم بن غزوان، وأبو عاصم العباداني.(@)(@@)(@@)(@@) ||| AUTO الحكم بن مسلم بن الحكم السالمي(@)(@@) يروي عن الأعرج، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO الحكم بن أبان المدني(@)(@@) سكن اليمن، كنيته أبو عيسى، يروي عن طاوس، وعكرمة، روى عنه ابن جريج، ويزيد بن أبي حكيم، مات سنة أربع وخمسين 
ms912	 ومائة، وهو ابن أربع وثمانين سنة، وربما أخطأ، وإنما وقع المناكير في روايته من رواية ابنه إبراهيم بن الحكم عنه، وإبراهيم ضعيف.(@)(@@)(@@)(@@) ||| AUTO الحكم بن أبي الصلت المخزومي، كنيته أبو محمد(@)(@@) من أهل المدينة، يروي عن أبيه، قال: رأيت عثمان بن عفان يخطب على المنبر، مخضوب الرأس بالحمرة. روى عنه يونس بن محمد المؤدب.(@)(@@)(@@)(@@) ||| AUTO الحكم بن عبد الله البصري(@)(@@) يروي عن الحسن، روى عنه الثوري، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO الحكم بن الأعرج(@)(@@) يروي عن الأشعث بن ترملة، عن أبي بكرة، روى عنه يونس بن عبيد.(@)PageV01P002(@)(@@) [ج 3: ص 283](@)(@@)(@@)(@@) ||| AUTO الحكم بن فروخ، أبو بكار الغزال(@)(@@) بصري، يروي عن عكرمة، روى عنه حماد بن زيد، ويحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO الحكم بن مسلمة السعدي(@)(@@) يروي عن عمر بن نصر، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO الحكم بن عبد الرحمن بن أبي نعم البجلي(@)(@@) يروي عن أبيه، روى عنه أبو نعيم الفضل بن دكين، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الحكم بن مصعب القرشي(@)(@@) يروي عن محمد بن علي بن عبد الله بن عباس، روى عنه الوليد بن مسلم، يخطئ.(@)(@@)(@@)(@@) ||| AUTO الحكم بن هشام الثقفي(@)(@@) من أهل الكوفة، يروي عن عبد الملك بن عمير، وقتادة، روى عنه يحيى بن اليمان.(@)(@@)(@@)(@@) ||| AUTO الحكم بن الخزرج(@)(@@) يروي عن جدته، عن أبي موسى، روى عنه حجاج بن المنهال، وموسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO الحكم الثقفي(@)(@@) يروي عن عمرو بن خالد، عن أنس، روى عنه عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO الحكم، أبو سعيد(@)(@@) يروي عن رجل من أهل الشام، روى عنه هشام الدستوائي.(@)PageV01P002(@)(@@) [ج 3: ص 284](@)(@@)(@@)(@@) ||| AUTO الحكم بن أبي خالد المكي(@)(@@) مولى فزارة، يروي عن عمر بن أبي ليلى، عن الحسن بن علي، روى عنه عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO الحكم بن دينار القرشي(@)(@@) يروي عن عمرو بن دينار، عن ابن الزبير، روى عنه الفضل بن موسى الشيباني.(@)(@@)(@@)(@@) ||| AUTO حميد بن نافع(@)(@@) من أهل المدينة، يروي عن زيد بن أسلم، روى عنه يحيى بن سعيد الأنصاري، وأيوب بن موسى، وليس هذا 
ms913	 بحميد صفيرا، ذاك تابعي يروي عن ابن عمر، وقد ذكرناه في كتاب التابعين.(@)(@@)(@@)(@@) ||| AUTO حميد بن زياد، أبو صخر الخراط(@)(@@) من أهل المدينة، مولى بني هاشم، يروي عن نافع، ومحمد بن كعب، روى عنه حيوة بن شريح، وهو الذي يروي عنه حاتم بن إسماعيل، ويقول: حميد بن صخر. وإنما هو حميد بن زياد أبو صخر لا حميد بن صخر.(@)(@@)(@@)(@@) ||| AUTO حميد الأوزاعي(@)(@@) شيخ يروي المراسيل، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO حميد الفزاري(@)(@@) شيخ يروي المراسيل، روى عنه عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO حميد بن يعقوب بن يسار المدني(@)(@@) يروي عن سعيد بن المسيب، روى عنه ابن إسحاق، وأتاه ابن عيينة وهو مريض.(@)(@@)(@@)(@@) ||| AUTO حميد بن قيس الأعرج(@)(@@) من أهل مكة، مولى بني أسد بن PageV01P002 [ج 3: ص 285] عبد العزى القرشي، كنيته أبو صفوان، يروي عن عطاء، ومجاهد، والزهري، روى عنه الثوري، ومالك، والناس، وهو أخو عمر بن قيس سدل، مات بمكة سنة ثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO حميد بن عبيد الأنصاري(@)(@@) يروي عن أبيه، عن عمر، روى عنه ابنه عبد الرحمن بن حميد.(@)(@@)(@@)(@@) ||| AUTO حميد بن أبي حكيم الأعرج(@)(@@) من أهل مرو، يروي عن يحيى بن يعمر، روى عنه ابن المبارك، وأبو تميلة.(@)(@@)(@@)(@@) ||| AUTO حميد بن الأسود، أبو الأسود(@)(@@) يروي عن هشام بن عروة، وهو جد أبي بكر بن أبي الأسود، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO حميد بن علي الرقاشي(@)(@@) يروي عن عمران بن حيان الأنصاري، عن أبيه، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO حميد بن مسلم القرشي(@)(@@) من أهل دمشق، كنيته أبو عبد الله، يروي عن مكحول، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO حميد بن طرخان(@)(@@) يروي عن عبد الله بن شقيق، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO حميد بن مهران الخياط(@)(@@) وهو حميد بن أبي حميد الكندي المالكي، كنيته أبو عبد الله، يروي عن ابن سيرين، وقتادة، روى عنه أبو داود الطيالسي، ومسلم بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO حميد بن أبي حميد الخياط(@)(@@) بصري، يروي عن الحسن، روى عنه مرزوق بن ميمون الناجي. 
ms914	(@)PageV01P002(@)(@@) [ج 3: ص 286](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حميد بن بكر(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه يزيد بن خصيفة، يعتبر بحديثه إذا لم يكن في إسناده إنسان ضعيف.(@)(@@)(@@)(@@) ||| AUTO حميد بن زياد اليمامي(@)(@@) يروي عن عبد العزيز بن اليمان، أخي حذيفة، عن حذيفة: لتركبن سنن من قبلكم حذو النعل بالنعل. رواه موسى بن إسماعيل، عن أبي عبد الله، صاحب الصدقة، عن حميد.(@)(@@)(@@)(@@) ||| AUTO حميد، أبو سفيان(@)(@@) يروي عن مسلم بن أبي بكرة، عن أبي بكرة، روى عنه أبو بحر البكراوي.(@)(@@)(@@)(@@) ||| AUTO حميد، أبو عبد الله العبدي(@)(@@) يروي عن خالد الربعي، عن أبي هريرة: أوصاني خليلي بثلاث. روى عنه محمد بن بكر البرساني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حميد بن عبد الله الأصم(@)(@@) من أهل الكوفة، يروي عن الوليد بن عتبة، عن علي، روى عنه محمد بن بشر العبدي.(@)(@@) حميد بن عبد الله(@)(@@) يروي عن عبد الرحمن بن أبي عوف الجرشي، روى عنه الزبيدي، وصفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO حميد، أبو المليح الفارسي(@)(@@) سكن المدينة، يروي عن أبي صالح، عن أبي هريرة، روى عنه وكيع بن الجراح، وأبو عاصم النبيل.(@)(@@) حميد(@)(@@) مولى بني عجل، يروي عن إبراهيم النخعي، روى عنه عمارة بن القعقاع.(@)(@@)(@@)(@@) ||| AUTO حميد الكندي(@)(@@) شيخ يروي عن عبادة بن نسي، روى عنه أبو بكر بن عياش.(@)PageV01P002(@)(@@) [ج 3: ص 287](@)(@@)(@@)(@@) ||| AUTO حميد بن سويد، أبو سويد(@)(@@) من أهل مصر، يروي عن عبد الرحمن بن حجيرة، روى عنه عمرو بن الحارث المصري، ومن قال: أبو سوية فقد وهم.(@)(@@)(@@)(@@) ||| AUTO حميد بن أبي غنية الأصبهاني(@)(@@) سكن الكوفة، والد عبد الملك بن حميد بن أبي غنية، يروي المراسيل، روى عنه سفيان بن عيينة.(@)(@@)(@@)(@@) ||| AUTO حميد بن جابر الراسبي(@)(@@) من أهل البصرة، يروي عن كبشة بنت طهمان، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO حميد بن حبان بن أبي زيد الجعفري(@)(@@) من أهل الحجاز، يروي عن سالم بن عبد الله، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO حميد بن أبي الصعبة(@)(@@) يروي عن عبد الله بن زرير الغافقي، عن علي، روى عنه عمارة بن غزية، 
ms915	 وأهل مصر.(@)(@@)(@@)(@@) ||| AUTO حميد بن عبد الرحمن بن حميد الرؤاسي(@)(@@) من أهل الكوفة، كنيته أبو عوف، يروي عن إسماعيل بن أبي خالد، روى عنه قتيبة بن سعيد، ومحمد بن سلام البيكندي، وأهل بلده، مات في آخر سنة تسع وثمانين ومائة، وقد قيل: سنة ثنتين وتسعين ومائة، سمعت عمر بن حفص البزاز، يقول: سمعت محمد بن زياد الزيادي، يقول: سمعت سفيان بن عيينة، يقول: قدم حميد الرؤاسي من سفر فرأى أمه تصلى فلما رآها قائمة تصلى قام فلما فطنت طولت الصلاة لتؤجر.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر بن سعد بن أبي وقاص الزهري القرشي(@)(@@) من أهل العراق، يروي عن أبيه، روى عنه أهل العراق، قتله المختار بن أبي عبيد مع أبيه عمر بن سعد.(@)PageV01P002(@)(@@) [ج 3: ص 288](@)(@@)(@@)(@@) ||| AUTO حفص بن سليمان البصري المنقري(@)(@@) يروي عن الحسن، روى عنه حماد بن زيد، مات سنة ثلاثين ومائة قبل الطاعون بقليل، وليس هذا بحفص بن سليمان البزاز أبو عمر القاري، ذاك ضعيف، وهذا ثبت.(@)(@@)(@@)(@@) ||| AUTO حفص بن الفرافصة(@)(@@) يروي عن عروة بن الزبير، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO حفص بن عبد الله بن صيفي(@)(@@) يروي عن عبد الرحمن بن المطلب بن أبي وداعة، عن أبيه، وهو أخو يحيى بن عبد الله بن صيفي، روى عنه أهل الحجاز السائب بن عمر المخزومي، وغيره.(@)(@@)(@@)(@@) ||| AUTO حفص بن أبي الصعبة(@)(@@) يروي عن سعيد بن جبير، روى عنه عبيدة بن حسان.(@)(@@)(@@)(@@) ||| AUTO حفص بن جابر(@)(@@) يروي عن القاسم بن محمد، روى عنه عكرمة بن عمارة.(@)(@@)(@@)(@@) ||| AUTO حفص بن عامر(@)(@@) يروي عن سعيد بن المسيب، روى عنه واصل.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر بن ذكوان(@)(@@) كان نازلا في الأنصار بالمدينة، يروي عن سالم بن عبد الله، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO حفص بن حميد(@)(@@) يروي عن عكرمة، روى عنه يعقوب القمي.(@)(@@)(@@)(@@) ||| AUTO حفص بن عثمان بن محمد بن عرادة(@)(@@) يروي عن عكرمة، روى عنه أبو عقيل.(@)(@@)(@@)(@@) ||| AUTO حفص بن خالد بن جابر(@)(@@) يروي عن أبيه، روى 
ms916	 عنه سكين بن عبد العزيز.(@)PageV01P002(@)(@@) [ج 3: ص 289](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حفص بن خرزاذ(@)(@@) يروي عن الحر بن الصباح، روى عنه إبراهيم بن طهمان.(@)(@@)(@@)(@@) ||| AUTO حفص بن قيس(@)(@@) يروي عن نافع، عن ابن عمر. روى عنه شبابة بن سوار، قال: حدثنا مكحول، ببيروت(@)(@@) (297) -[3: 289] قال: ثنا الحسن بن أبي أمية الأنماطي، قال: ثنا شبابة بن سوار، قال: ثنا حفص بن قيس، عن نافع، عن ابن عمر، قال: قال رسول الله صلى الله عليه وسلم: لا يحل لامرئ مسلم أن يبيت ليلتين وعنده شيء يوصي فيه إلا ووصيته مكتوبة عند رأسه.(@)(@@)(@@)(@@) ||| AUTO حفص بن سليمان الأزدي(@)(@@) يروي المراسيل، روى عنه خليد بن حسان.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر(@)(@@) يروي عن رجل من آل زيد بن الخطاب، عن حفصة، روى عنه أرطأة بن المنذر.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر بن عبد الرحمن بن عوف(@)(@@) مدني، يروي عن عمر بن عبد الرحمن بن عوف، روى عنه يوسف بن الحكم.(@)(@@) حفص(@)(@@) شيخ يروي عن أبي رافع، عن أبي بكر، روى عنه موسى بن أبي عائشة.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر بن كيسان الصنعاني، وهو الذي يقال له: حفص بن عمر بن أبي يزيد(@)(@@) يروي عن أبي الزبير، روى عنه ابن أخيه عبد الله بن إبراهيم بن عمر بن كيسان.(@)(@@)(@@)(@@) ||| AUTO حفص بن غيلان الهمداني، أبو معيد الشامي(@)(@@) من أهل دمشق، يروي عن مكحول، ونافع، روى عنه الوضين بن عطاء، وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO حفص بن عمر الأنصاري الحلبي(@)(@@) من أهل الشام، يروي عن خالد بن معدان، روى عنه ابنه، أبو سعيد بن حفص.(@)PageV01P002(@)(@@) [ج 3: ص 290](@)(@@)(@@)(@@) ||| AUTO حفص بن المعتمر، ويقال: ابن أبي المعتمر(@)(@@) يروي عن التابعين، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO حفص بن أبي منصور، أبو الخطاب(@)(@@) يروي عن الشعبي، روى عنه عيسى بن يونس، ووكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO حفص بن أبي حفص السراج(@)(@@) يروي عن شهر بن حوشب، روى عنه العقدي، وأبو الوليد، وهو الذي يقال له: حفص التميمي.(@)(@@)(@@)(@@) ||| AUTO حفص بن الوليد الحضرمي(@)(@@) من أهل مصر، يروي عن 
ms917	 الزهري، روى عنه الليث بن سعد، ويزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO حفص بن سعيد القرشي(@)(@@) شيخ يروي عن جدته، روى عنه أبو نعيم الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO حفص بن ميمون(@)(@@) يروي عن الشعبي، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO حفص بن خشخاش(@)(@@) رجل من بني ربيعة، يروي عن عطاء، روى عنه محمد بن حمران البصري.(@)(@@)(@@)(@@) ||| AUTO حفص بن أبي زينب(@)(@@) يروي عن أبي جعفر محمد بن علي، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO حفص بن صبيح(@)(@@) يروي عن أبي سعيد، روى عنه محمد بن الفضيل بن غزوان.(@)PageV01P002(@)(@@) [ج 3: ص 291](@)(@@)(@@)(@@) ||| AUTO حفص بن أبي الصهباء(@)(@@) شيخ يروي عن أبي غالب، عن أبي أمامة، روى عنه المعلى بن أسد.(@)(@@)(@@)(@@) ||| AUTO حفص بن خالد الأحمسي(@)(@@) من أهل الكوفة، كنيته أبو محمد، يروي عن إسماعيل بن أبي خالد، روى عنه محمد بن سلام البيكندي، مات سنة إحدى وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO حفص الطائفي(@)(@@) قوله، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO حفص بن ميسرة، أبو عمر الصنعاني(@)(@@) من صنعاء الشام، يروي عن زيد بن أسلم، روى عنه سويد بن سعيد الأنباري، ومخلد بن مالك.(@)(@@)(@@)(@@) ||| AUTO حفص بن غياث بن طلق بن معاوية، أبو عمر النخعي(@)(@@) قاضي الكوفة، يروي عن إسماعيل بن أبي خالد، والأعمش، روى عنه ابنه عمر بن حفص، وأهل العراق، مات سنة خمس أو ست وتسعين ومائة في عشر ذي الحجة.(@)(@@)(@@)(@@) ||| AUTO حجاج بن أبي عيينة المهلبي(@)(@@) أخو محمد بن أبي عيينة، من أهل البصرة، يروي عن جابر بن زيد، وهند بنت المهلب، روى عنه حماد بن زيد، وسعيد بن عامر.(@)(@@)(@@)(@@) ||| AUTO حجاج بن مهاجر(@)(@@) يروي عن شيخ له، عن أبي أيوب الأنصاري، روى عنه أبو بشر جعفر بن أبي وحشية.(@)(@@)(@@)(@@) ||| AUTO حجاج بن عثمان السكسكي(@)(@@) من أهل الشام، يروي المراسيل، روى عنه صفوان بن عمرو السكسكي.(@)PageV01P002(@)(@@) [ج 3: ص 292](@)(@@)(@@)(@@) ||| AUTO حجاج بن الحجاج الباهلي الأحول(@)(@@) من أهل البصرة، يروي عن قتادة، روى عنه إبراهيم بن طهمان، ويزيد بن زريع، ومحمد بن جحادة.(@)(@@)(@@)(@@) ||| AUTO 
ms918	 حجاج بن زيد السامي القرشي البصري(@)(@@) يروي عن أبي المتوكل الناجي، روى عنه عرعرة بن البرند.(@)(@@)(@@)(@@) ||| AUTO حجاج بن أبي زياد الأسود(@)(@@) من أهل البصرة، كان ينزل القسامل بها، يروي عن أبي نضرة، وجابر بن زيد، روى عنه عيسى بن يونس، وجرير بن حازم، وهو الذي يحدث عنه حماد بن سلمة، ويقول: حدثنا حجاج الأسود.(@)(@@)(@@)(@@) ||| AUTO حجاج بن أبي عثمان الصواف، كنيته أبو الصلت(@)(@@) مولى التوأمة بنت أمية بن خلف، واسم أبي عثمان: ميسرة، وقد قيل: إن اسم أبي عثمان: سالم، يروي عن أبي الزبير، ويحيى بن أبي كثير، عن مجاهد، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO حجاج بن أبي زينب السلمي(@)(@@) يروي عن أبي سفيان، عن جابر، يروي عنه يزيد بن هارون، كنيته أبو يوسف، من أهل واسط.(@)(@@)(@@)(@@) ||| AUTO حجاج بن أبي يونس(@)(@@) يروي عن طاوس، روى عنه هشام بن حسان.(@)PageV01P002(@)(@@) [ج 3: ص 293](@)(@@)(@@)(@@) ||| AUTO حجاج بن فروخ التميمي(@)(@@) من أهل واسط، يروي عن العوام بن حوشب، عن ابن أبي أوفى، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO حجاج بن شداد الصنعاني(@)(@@) من صنعاء الشام، يروي عن سعيد أبي صالح الغفاري، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO حجاج بن عتاب العبدي، أبو خليفة(@)(@@) من أهل البصرة، يروي عن عبد الله بن معبد الزماني، روى عنه أبو هلال الراسبي، وقيل: إن هذا والد عمر بن أبي خليفة.(@)(@@)(@@)(@@) ||| AUTO حجاج الوراق(@)(@@) شيخ يروي المراسيل، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO حجاج بن فرافصة(@)(@@) كوفي، يروي عن جماعة من التابعين، روى عنه الثوري، وقال: بت عند الحجاج بن فرافصة ثلاث عشرة ليلة، فما رأيته أكل ولا شرب ولا نام. يخطئ، ويهم.(@)(@@)(@@)(@@) ||| AUTO حجاج بن حسان التيمي(@)(@@) من تيم الله بن ثعلبة بن ربيعة، وهو الذي يقال له: العائشي، والعيشي، من أهل البصرة، يروي عن عكرمة، وعبد الله بن بريدة، روى عنه يحيى بن سعيد القطان، ويزيد بن هارون، وأهل البصرة.(@)(@@) (298) -[3: 293] حدثنا ابن قتيبة، ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا حجاج بن 
ms919	 حسان التيمي، قال: سئل أبو مجلز عن طول الصلاة بالليل والنهار، فقال: أما الليل فطول القيام، وأما النهار فكثرة الركوع والسجود.(@)(@@)(@@)(@@) ||| AUTO حجاج بن صفوان المدني(@)(@@) يروي عن أسيد بن أبي أسيد، روى عنه أهل بلده.(@)PageV01P002(@)(@@) [ج 3: ص 294](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حجاج بن أبي مخلد(@)(@@) قوله، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO حجاج بن تميم(@)(@@) يروي عن ميمون بن مهران: أن عمر كبر على أبي بكر أربعا. روى عنه أبو معاوية الضرير.(@)(@@)(@@)(@@) ||| AUTO حجاج بن دينار الواسطي الأشجعي(@)(@@) يروي عن أبي غالب، روى عنه شعبة، وإسماعيل بن زكريا، وهو الذي يقال له: حجاج البطيخي.(@)(@@)(@@)(@@) ||| AUTO حجاج بن عاصم المحاربي(@)(@@) من أهل الكوفة، يروي عن العراقيين، وكان قاضيا بالكوفة، روى عنه أهل الكوفة.(@)(@@) حجاج(@)(@@) شيخ يروي عن الشعبي، روى عنه إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO حجاج بن محمد بن سليمان بن فرادس الخولاني، كنيته أبو مسلم(@)(@@) من أهل الشام، يروي عن عمر بن بلال، قال: سمعت عبد الله بن بسر، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: كيف أنت إذا جارت عليكم الولاة. روى عنه يعقوب بن سفيان الفارسي. آخر الأول من كتاب تبع التابعين وأول الثاني منه.(@)(@@)(@@)(@@) ||| AUTO حسين بن علي بن الحسين بن علي بن أبي طالب(@)(@@) رضي الله عنهم، من أهل المدينة، أخو عمر، ومحمد، يروي عن وهب بن كيسان، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO حسين بن بشير بن سلمان(@)(@@) مولى صفية بنت عبد الرحمن، من أهل المدينة، PageV01P002 [ج 3: ص 295] يروي عن أبيه، عن جابر، روى عنه خارجة بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO حسين بن ذكوان المعلم العوذي(@)(@@) من أهل البصرة، يروي عن عبد الله بن بريدة، روى عنه شعبة، وابن المبارك، وهو الذي يقول بعض الرواة: حسين بن ذكوان، وبعضهم: حسين المكتب.(@)(@@)(@@)(@@) ||| AUTO حسين بن حسين الواسطي، أبو سفيان السلمي، وقد قيل: حسين بن حسن(@)(@@) يروي عن الحسن، روى عنه شعبة، وهاشم بن البريد، ومن زعم أنه سمع أنس بن مالك فقد وهم.(@)(@@)(@@)(@@) ||| AUTO حسين بن عثمان بن بشر 
ms920	 المحتفز(@)(@@) من أهل مرو، يروي عن سالم بن عبد الله أنه قال في الم، والمر، وحم، ون: كلها اسم من أسماء الله، وهي مقطعة. روى عنه عيسى بن عبيد الكندي، وهو أخو حسن بن عثمان.(@)(@@)(@@)(@@) ||| AUTO حسين بن عمران الجهني(@)(@@) يروي عن الشيباني، والزهري، روى عنه شعبة، وروح، وعطاء بن أبي ميمونة.(@)(@@)(@@)(@@) ||| AUTO حسين بن الحسن الكندي(@)(@@) قاضي الكوفة، يروي عن عبد الله بن بريدة، روى عنه شريك بن عبد الله النخعي.(@)(@@)(@@)(@@) ||| AUTO حسين بن حازم(@)(@@) يروي عن أهل المدينة، وعمر بن عبد العزيز، روى عنه صالح بن عمر.(@)(@@)(@@)(@@) ||| AUTO حسين بن أبي عائشة(@)(@@) يروي عن أبي خالد الوالبي، روى عنه عمران بن أبي زائدة.(@)PageV01P002(@)(@@) [ج 3: ص 296](@)(@@)(@@)(@@) ||| AUTO حسين بن رستم الأيلي(@)(@@) يروي عن الزهري، روى عنه سعيد بن أبي أيوب، وابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO حسين بن عبد الله العنزي(@)(@@) يروي عن الشعبي، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO حسين بن صالح(@)(@@) شيخ من أهل المدينة، يروي عن جناح مولى ليلى، روى عنه ابنه صالح بن حسين.(@)(@@)(@@)(@@) ||| AUTO حسين، أبو عبد الله(@)(@@) جليس كعب الأحبار، يروي عن كعب الأحبار، روى عنه عتبة بن أبي حكيم الشامي.(@)(@@)(@@)(@@) ||| AUTO حسين بن المنذر، أبو المنذر(@)(@@) من أهل البصرة، يروي عن يزيد الرقاشي، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO حسين بن رباح(@)(@@) يروي عن عكرمة، روى عنه جرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO حسين بن سليمان الرقاشي(@)(@@) مولى الطلحيين، يروي عن عبد الملك بن عمير، عن أنس نسخة دلسها عبد الملك بن عمير، روى عنه هشام بن يونس اللؤلؤي.(@)(@@)(@@)(@@) ||| AUTO حسين بن سعد الجهني البطين(@)(@@) من أهل البصرة، يروي عن ابن أبي مليكة، وعطاء، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO حسين بن عطاء بن يسار(@)(@@) من أهل المدينة، يروي عن زيد بن أسلم، روى عنه عبد الحميد بن جعفر، يخطئ، ويدلس.(@)(@@)(@@)(@@) ||| AUTO حسين بن واقد(@)(@@) مولى عبد الله بن عامر بن كريز القرشي،(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 3: ص 297] كنيته أبو على، يروي عن عبد الله بن بريدة، 