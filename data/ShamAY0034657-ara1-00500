ms496	 القرطبي \ 1/ 175 \ (40)(@)(@@) إبراهيم بن محمود بن حمزة، أبو إسحاق النيسابوري القطان \ 1/ 175 \ (41)(@)(@@) إبراهيم بن مسعود بن سعيد، أبو إسحاق التجيبي الإلبيري \ 1/ 176 \ (42)(@)(@@) إبراهيم بن المضاء بن طارق، أبو إسحاق الأسدي القيرواني \ 1/ 177 \ (43)(@)(@@) إبراهيم بن منصور بن إبراهيم، أبو إسحاق الإفريقي القفصي \ 1/ 177 \ (44)(@)(@@) إبراهيم بن نصر، أبو إسحاق الجهني ابن أبرول \ 1/ 178 \ (45)(@)(@@) إبراهيم بن النعمان، أبو إسحاق القرشي الفهري الأندلسي \ 1/ 179 \ (46)(@)(@@) إبراهيم بن هارون بن سهل السرقسطي \ 1/ 180 \ (47)(@)(@@) إبراهيم بن هارون بن محمد بن إلياس الليثي \ 1/ 180 \ (48)(@)(@@) إبراهيم بن يحيى بن برون الطليطلي \ 1/ 181 \ (49)(@)(@@) إبراهيم بن يزيد بن قلزم بن إبراهيم، أبو إسحاق \ 1/ 181 \ (50)(@)(@@) إبراهيم بن يزيد المكني \ 1/ 182 \ (51)(@)(@@) إبراهيم الأندلسي الخياط\ 1/ 183 \ (52)(@)(@@) الأبزاري - أبو القاسم بن مسرور\. . . \. . .(@)(@@) الأبهري الصغير - محمد بن عبد الله، أبو جعفر الأبهري \. . . \. . .(@)(@@) الإبياني - عبد الله بن أحمد بن إبراهيم \. . . \. . .(@)PageV03P1452(@)(@@) الأبيض - يحيى بن عبد الرحمن، أبو زكريا السرقسطي \. . . \. . .(@)(@@) الأجدابي - الحسين بن أبي العباس \. . . \. . .(@)(@@) أحمد بن إبراهيم بن حماد بن إسحاق بن إسماعيل، أبو عثمان الأزدي الجهضمي \ 1/ 183 \ (53)(@)(@@) أحمد بن إبراهيم بن أبي سفيان، أبو عمر الغافقي القرطبي \ 1/ 184 \ (54)(@)(@@) أحمد بن إبراهيم بن عبد الرحمن، أبو عمر الكلاعي القرطبي ابن الضحى \ 1/ 184 \ (55)(@)(@@) أحمد بن إبراهيم بن عجنس بن أسباط، أبو الفضل الزبادي الوشقي \ 1/ 185 \ (56)(@)(@@) أحمد بن إبراهيم، أبو جعفر الأربسي ابن السرداني \ 1/ 185 \ (57)(@)(@@) أحمد بن أحمد بن زياد، أبو جعفر الفارسي \ 1/ 186 \ (58)(@)(@@) أحمد بن أدهم بن محمد بن عمر، أبو بكر الجياني \ 1/ 187 \ (59)(@)(@@) أحمد بن إسحاق بن إبراهيم البصري الصفار\ 1/ 188 \ (60)(@)(@@) أحمد بن أيوب بن أبي الربيع، أبو العباس الإلبيري \ 1/ 188 \ (61)(@)(@@) أحمد بن بشر بن محمد بن إسماعيل، أبو عمر التجيبي القرطبي ابن الأغبس \ 1/ 190 \ (62)(@)(@@) أحمد بن بقي بن مخلد، أبو عبد الله القرطبي \ 1/ 191 \ (63)(@)(@@) أحمد بن أبي بكر القاسم بن ا