ms561	 أتوه في صورة الأضياف ليخبثوا بهم وكانوا ملائكة {فطمسنا أعينهم} أعميناها وجعلناها بلا شق كباقي الوجه بأن صفقها جبريل بجناحه {فذوقوا} فقلنا لهم ذوقوا {عذابي ونذر} إنذاري وتخويفي أي ثمرته وفائدته(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P707(@)(@@) {ولقد صبحهم بكرة} وقت الصبح من يوم غير معين {عذاب مستقر} دائم متصل بعذاب الآخرة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P707(@)(@@) {فذوقوا عذابي ونذر}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P707(@)(@@) {ولقد يسرنا القرآن للذكر فهل من مدكر}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P707(@)(@@) {ولقد جاء آل فرعون} قومه معه {النذر} الإنذار على لسان موسى وهارون فلم يؤمنوا بل(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P707(@)(@@) {كذبوا بآياتنا كلها} التسع التي أوتيها موسى {فأخذناهم} بالعذاب {أخذ عزيز} قوي {مقتدر} قادر لا يعجزه شيء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P707(@)(@@) {أكفاركم} يا قريش {خير من أولئكم} المذكورين من قوم نوح إلى فرعون فلم يعذروا {أم لكم} يا كفار قريش {براءة} من العذاب {في الزبر} الكتب والاستفهام في الموضعين بمعنى النفي أي ليس الأمر كذلك(@)(@@) PageV01P707(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {أم يقولون} أي كفار قريش {نحن جميع} جمع {منتصر} على محمد ولما قال أبو جهل يوم بدر إنا جمع منتصر نزل(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {سيهزم الجمع ويولون الدبر} فهزموا ببدر ونصر رسول الله صلى الله عليه وسلم عليهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {بل الساعة موعدهم} بالعذاب {والساعة} أي عذابها {أدهى} أعظم بلية {وأمر} أشد مرارة من عذاب الدنيا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {إن المجرمين في ضلال} هلاك بالقتل في الدنيا {وسعر} نار مسعرة بالتشديد أي مهيجة في الآخرة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {يوم يسحبون في النار على وجوههم} في الآخرة ويقال لهم {ذوقوا مس سقر} إصابة جهنم لكم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P708(@)(@@) {إنا كل شيء} منصوب بفعل يفسره {خلقناه بقدر} بتقدير حال من كل أي مقدرا وقرئ كل بالرفع مبتدأ خبره خلقناه(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {وما أمرنا} لشيء نريد وجوده {إلا} مرة {واحدة كلمح بالبصر} في السرعة وهي قول كن فيوجد إنما أمره إذا أراد شيئا أن يقول له كن فيكون(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {ولقد أهلكنا أشياعكم} أشباهكم في الكفر من الأمم الماضية {فهل من مدكر} استفهام بمعنى الأمر أي اذكروا واتعظوا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {وكل شيء فعلوه} أي العباد مكتوب {في الزبر} كتب الحفظة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {وكل صغير وكبير} من الذنب 
ms562	 أو العمل {مستطر} مكتوب في اللوح المحفوظ(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {إن المتقين في جنات} بساتين {ونهر} أريد به الجنس وقرئ بضم النون والهاء جمعا كأسد وأسد والمعنى أنهم يشربون من أنهارها الماء واللبن والعسل والخمر(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P708(@)(@@) {في مقعد صدق} مجلس حق لا لغو فيه ولا تأثيم أريد به الجنس وقرئ مقاعد المعنى أنهم في مجالس من الجنات سالمة من اللغو والتأثيم بخلاف مجالس الدنيا فقل أن تسلم من ذلك وأعرب هذا خبرا ثانيا وبدلا وهو صادق ببدل البعض وغيره {عند مليك} مثال مبالغة أي عزيز الملك واسعه {مقتدر} قادر لا يعجزه شيء وهو الله تعالى وعند إشارة إلى الرتبة والقربة من فضله تعالى = 55 سورة(@)(@@)(@@)(@@) | الرحمن(@)(@@) PageV01P708(@)(@@)(@@)(@@) | الرحمن(@)(@@) } الله تعالى(@)(@@) PageV01P708(@)(@@) {علم} من شاء {القرآن}(@)(@@) PageV01P708(@)(@@) {خلق الإنسان} أي الجنس(@)(@@) PageV01P708(@)(@@) {علمه البيان} النطق(@)(@@) PageV01P709(@)(@@) {الشمس والقمر بحسبان} يجريان(@)(@@) PageV01P709(@)(@@) {والنجم} ما لا ساق له من النبات {والشجر} ما له ساق {يسجدان} يخضعان لما يراد منهما(@)(@@) PageV01P709(@)(@@) {والسماء رفعها ووضع الميزان} أثبت العدل(@)(@@) PageV01P709(@)(@@) {ألا تطغوا} أي لأجل أن لا تجوروا {في الميزان} ما يوزن به(@)(@@) PageV01P709(@)(@@) {وأقيموا الوزن بالقسط} بالعدل {ولا تخسروا الميزان} تنقصوا الموزون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {والأرض وضعها} أثبتها {للأنام} للخلق الإنس والجن وغيرهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {فيها فاكهة والنخل} المعهود {ذات الأكمام} أوعية طلعها(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {والحب} كالحنطة والشعير {ذو العصف} التين {والريحان} الورق المشموم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {فبأي آلاء} نعم {ربكما} أيها الإنس والجن {تكذبان} ذكرت إحدى وثلاثين مرة والاستفهام فيها للتقرير لما روى الحاكم عن جابر قال قرأ علينا رسول الله صلى الله عليه وسلم سورة الرحمن حتى ختمها ثم قال مالي أراكم سكوتا للجن كانوا أحسن منكم ردا ما قرأت عليهم هذه الآية من مرة {فبأي آلاء ربكما تكذبان} إلا قالوا ولا بشيء من نعمك ربنا نكذب فلك الحمد(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {خلق الإنسان} آدم {من صلصال} طين يابس يسمع له صلصلة أي صوت إذا نقر {كالفخار} وهو ما طبخ من الطين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {وخلق الجان} أبا الجن وهو إبليس {من مارج من نار} هو لهبها الخالص من الدخان(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {فبأي آلاء ربكما تكذبان} 
ms563	(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {رب المشرقين} مشرق الشتاء ومشرق الصيف {ورب المغربين} كذلك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P709(@)(@@) {مرج} أرسل {البحرين} العذب والملح {يلتقيان} في رأي العين(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P709(@)(@@) {بينهما برزخ} حاجز من قدرته تعالى {لا يبغيان} لا يبغي واحد منهما على الآخر فيختلط به(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P709(@)(@@) {فبأي آلاء ربكما تكذبان(@)(@@) PageV01P709(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {يخرج} بالبناء للمفعول والفاعل {منهما} من مجموعهما الصادق بأحدهما وهو الملح {اللؤلؤ والمرجان} خرز أحمر أو صغار اللؤلؤ(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {وله الجوار} السفن {المنشآت} المحدثات {في البحر كالأعلام} كالجبال عظما وارتفاعا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {كل من عليها} أي الأرض من الحيوان {فان} هالك وعبر بمن تغليبا للعقلاء(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {ويبقى وجه ربك} ذاته {ذو الجلال} العظمة {والإكرام} للمؤمنين بأنعمه عليهم(@)(@@)(@@)(@@) | 28 - (@)(@@) {فبأي ألاء ربكما تكذبان}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P710(@)(@@) {يسأله من في السماوات والأرض} بنطق أو حال ما يحتاجون إليه من القوة على العبادة والرزق والمغفرة وغير ذلك {كل يوم} وقت {هو في شأن} أمر يظهره على وفق ما قدره في الأزل من إحياء وإماتة وإعزاز وإذلال وإغناء وإعدام وإجابة داع وإعطاء سائل وغير ذلك(@)(@@)(@@)(@@) | 30 - (@)(@@) {فبأي ألاء ربكما تكذبان}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV00P000(@)(@@) {سنفرغ لكم} سنقصد لحسابكم {أيها الثقلان} الإنس والجن(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P710(@)(@@) {يا معشر الجن والإنس إن استطعتم أن تنفذوا} تخرجوا {من أقطار} نواحي {السماوات والأرض فانفذوا} أمر تعجيز {لا تنفذون إلا بسلطان}(@)(@@) بقوة ولا قوة لكم على ذلك(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P710(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P710(@)(@@) {يرسل عليكما شواظ من نار} هو لهبها الخالص من الدخان أو معه {ونحاس} أي دخان لا لهب فيه {فلا تنتصران} تمتنعان من ذلك بل يسوقكم إلى المحشر(@)(@@) PageV01P710(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P711(@)(@@) {فإذا انشقت السماء} انفرجت أبوابا لنزول الملائكة {فكانت وردة}(@)(@@) أي مثلها محمرة {كالدهان} كالأديم الأحمر على خلاف العهد بها وجواب إذا فما أعظم الهول(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P711(@)(@@) {فيومئذ لا يسأل عن ذنبه إنس ولا جان} عن ذنبه ويسألون في وقت آخر {فوربك لنسألنهم أجمعين} والجان هنا وفيما سيأتي بمعنى الجني 
ms564	 والإنس فيهما بمعنى الإنسي(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {يعرف المجرمون بسيماهم} سواد الوجوه وزرقة العيون {فيؤخذ بالنواصي والأقدام}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان} تضم ناصية كل منهم إلى قدميه من خلف أو قدام ويلقى في النار ويقال لهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {هذه جهنم التي يكذب بها المجرمون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {يطوفون} يسعون {بينها وبين حميم} ماء حار {آن} شديد الحرارة يسقونه إذا استغاثوا من حر النار وهو منقوص كقاض(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {ولمن خاف} أي لكل منهم أو لمجموعهم {مقام ربه} قيامه بين يديه للحساب فترك معصيته {جنتان}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {ذواتا} تثنية ذوات على الأصل ولامها ياء {أفنان} أغصان جمع فنن كطلل(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P711(@)(@@) {فيهما عينان تجريان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P711(@)(@@) {فيهما من كل فاكهة} في الدنيا أو كل ما يتفكه به {زوجان} نوعان رطب ويابس والمر منهما في الدنيا كالحنظل حلو(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P711(@)(@@) {فبأي آلاء ربكما تكذبان(@)(@@) PageV01P711(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {متكئين} حال عامله محذوف أي يتنعمون {على فرش بطائنها من إستبرق} ما غلظ من الديباج وخشن والظهائر من السندس {وجنى الجنتين} ثمرهما {دان} قريب يناله القائم والقاعد والمضطجع(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {فيهن} في الجنتين وما اشتملتا عليه من العلالي والقصور {قاصرات الطرف} العين على أزواجهن المتكئين من الإنس والجن {لم يطمثهن} يفتضهن وهن من الحور أو من نساء الدنيا المنشآت {إنس قبلهم ولا جان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {كأنهن الياقوت} صفاء {والمرجان} اللؤلؤ بياضا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {هل} ما {جزاء الإحسان} بالطاعة {إلا الإحسان} بالنعيم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {ومن دونهما} الجنتين المذكورتين {جنتان} أيضا لمن خاف مقام ربه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {مدهامتان} سوداوان من شدة خضرتهما(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فيهما عينان نضاختان} فوارتان بالماء(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فيهما فاكهة ونخل ورمان} هما منها وقيل من غيرها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان} 
ms565	(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P712(@)(@@) {فيهن} أي الجنتين وما فيهما {خيرات} أخلاقا {حسان} وجوها(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P712(@)(@@) {فبأي آلاء ربكما تكذبان(@)(@@) PageV01P712(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {حور} شديدات سواد العيون وبياضها {مقصورات} مستورات {في الخيام} من در مجوف مضافة إلى القصور شبيهة بالخدور(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {لم يطمثهن إنس قبلهم} قبل أزواجهن {ولا جان}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {متكئين} أي أزواجهم وإعرابه كما تقدم {على رفرف خضر} جمع رفرفة أي بسط أو وسائد {وعبقري حسان} جمع عبقرية أي طنافس(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {فبأي آلاء ربكما تكذبان}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P713(@)(@@) {تبارك اسم ربك ذي الجلال والإكرام} تقدم ولفظ اسم زائد = 56 سورة(@)(@@)(@@)(@@) | الواقعة(@)(@@) PageV01P713(@)(@@) {إذا وقعت(@)(@@)(@@)(@@) | الواقعة} (@)(@@) قامت القيامة(@)(@@) PageV01P713(@)(@@) {ليس لوقعتها كاذبة} نفس تكذب بأن تنفيها كما نفتها في الدنيا(@)(@@) PageV01P713(@)(@@) {خافضة رافعة} أي هي مظهرة لخفض أقوام بدخولهم النار ولرفع آخرين بدخولهم الجنة(@)(@@) PageV01P713(@)(@@) {إذا رجت الأرض رجا} حركت حركة شديدة(@)(@@) PageV01P713(@)(@@) {وبست الجبال بسا} فتتت(@)(@@) PageV01P713(@)(@@) {فكانت هباء} غبارا {منبثا} منتشرا وإذا الثانية بدل من الأولى(@)(@@) PageV01P713(@)(@@) {وكنتم} في القيامة {أزواجا} أصنافا {ثلاثة}(@)(@@) PageV01P713(@)(@@) {فأصحاب الميمنة} وهم الذين يؤتون كتبهم بأيمانهم مبتدأ خبره {ما أصحاب الميمنة} تعظيم لشأنهم بدخولهم الجنة(@)(@@) PageV01P713(@)(@@) {وأصحاب المشأمة} أي الشمال بأن يؤتى كل منهم كتابه بشماله {ما أصحاب المشأمة} تحقير لشأنهم بدخولهم النار(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {والسابقون} إلى الخير وهم الأنبياء مبتدأ {السابقون} تأكيد لتعظيم شأنهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {أولئك المقربون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {في جنات النعيم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {ثلة من الأولين} مبتدأ أي جماعة من الأمم الماضية(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {وقليل من الآخرين} من أمة محمد صلى الله عليه وسلم وهم السابقون من الأمم الماضية وهذه الأمة والخبر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {على سرر موضونة} منسوجة بقضبان الذهب والجواهر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {متكئين عليها متقابلين} حالان من الضمير في الخبر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {يطوف عليهم} للخدمة {ولدان مخلدون} على شكل الأولاد لا يهرمون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {بأكواب} أقداح لا عرا لها {وأباريق} لها عرا وخراطيم {وكأس} إناء شرب الخمر {من معين} أي خمر جارية من منبع لا ينقطع أبدا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P714(@)(@@) {لا يصدعون عنها ولا ينزفون} بفتح الزاي وكسرها من نزف الشارب وأنزف أي لا يحصل لهم منها صداع 
ms566	 ولا ذهاب عقل بخلاف خمر الدنيا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {وفاكهة مما يتخيرون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {ولحم طير مما يشتهون و} لهم للاستمتاع(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {حور} نساء شديدات سواد العيون وبياضها {عين} ضخام العيون كسرت عينه بدل ضمها لمجانسة الياء ومفرده عيناء كحمراء وفي قراءة بجر حور عين(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {كأمثال اللؤلؤ المكنون} المصون(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {جزاء} مفعول له أو مصدر والعامل المقدر أي جعلنا لهم ما ذكر للجزاء أو جزيناهم {بما كانوا يعملون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {لا يسمعون فيها} في الجنة {لغوا} فاحشا من الكلام {ولا تأثيما} ما يؤثم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {إلا} لكن {قيلا} قولا {سلاما سلاما} بدل من قيلا فإنهم يسمعونه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {وأصحاب اليمين ما أصحاب اليمين}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {في سدر} شجر النبق {مخضود} لا شوك فيه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P714(@)(@@) {وطلح} شجر الموز {منضود} بالحمل من أسفله إلى أعلاه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P714(@)(@@) {وظل ممدود} دائم(@)(@@) PageV01P714(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {وماء مسكوب} جار دائما(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {وفاكهة كثيرة}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {لا مقطوعة} في زمن {ولا ممنوعة} بثمن(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {وفرش مرفوعة} على السرر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {إنا أنشأناهن إنشاء} أي الحور العين من غير ولادة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {فجعلناهن أبكارا} عذارى كلما أتاهن أزواجهن وجدوهن عذارى ولا وجع(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {عربا} بضم الراء وسكونها جمع عروب وهي المتحببة إلى زوجها عشقا له {أترابا} جمع ترب أي مستويات في السن(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {لأصحاب اليمين} صلة أنشأناهن أو جعلناهن وهم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P715(@)(@@) {ثلة من الأولين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {وثلة من الآخرين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {وأصحاب الشمال ما أصحاب الشمال}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {في سموم} ريح حارة من النار تنفذ في المسام {وحميم} ماء شديد الحرارة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {وظل من يحموم} دخان شديد السواد(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {لا بارد} كغيره من الظلال {ولا كريم} حسن المنظر(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {إنهم كانوا قبل ذلك} في الدنيا {مترفين} منعمين لا يتعبون في الطاعة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {وكانوا يصرون على الحنث} الذنب {العظيم} أي الشرك(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أئنا لمبعوثون} في الهمزتين في الموضعين التحقيق وتسهيل الثانية وإدخال ألف بينهما على الوجهين(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {أو آباؤنا الأولون} بفتح الواو للعطف والهمزة للاستفهام وهو في ذلك وفيما قبله للاستبعاد وفي قراءة بسكون الواو عطفا 
ms567	 بأو والمعطوف عليه محل إن واسمها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P715(@)(@@) {قل إن الأولين والآخرين}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P715(@)(@@) {لمجموعون إلى ميقات} لوقت {يوم معلوم} أي يوم القيامة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P715(@)(@@) {ثم إنكم أيها الضالون المكذبون}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P715(@)(@@) {لآكلون من شجرة من زقوم} بيان للشجر(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P715(@)(@@) {فمالئون منها} من الشجر {البطون(@)(@@) PageV01P715(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {فشاربون عليه} أي الزقوم المأكول {من الحميم}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {فشاربون شرب} بفتح الشين وضمها مصدر {الهيم} الإبل العطاش جمع هيمان للذكر وهيمى للأنثى كعطشان وعطشى(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {هذا نزلهم} ما أعد لهم {يوم الدين} يوم القيامة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {نحن خلقناكم} أوجدناكم من عدم {فلولا} هلا {تصدقون} بالبعث إذ القادر على الإنشاء قادر على الإعادة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {أفرأيتم ما تمنون} تريقون من المني في أرحام النساء(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P716(@)(@@) {أأنتم} بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه في المواضع الأخرى {تخلقونه} أي المني بشرا {أم نحن الخالقون}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {نحن قدرنا} بالتشديد والتخفيف {بينكم الموت وما نحن بمسبوقين} بعاجزين(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {على} عن {أن نبدل} نجعل {أمثالكم} مكانكم {وننشئكم} نخلقكم {في ما لا تعلمون} من الصور كالقردة والخنازير(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {ولقد علمتم النشأة الأولى} وفي قراءة بسكون الشين {فلولا تذكرون} فيه إدغام التاء الثانية في الأصل في الذال(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {أفرأيتم ما تحرثون} تثيرون في الأرض وتلقون البذر فيها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {أأنتم تزرعونه} تنبتونه {أم نحن الزارعون}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {لو نشاء لجعلناه حطاما} نباتا يابسا لا حب فيه {فظلتم} أصله ظللتم بكسر اللام حذفت تخفيفا أي أقمتم نهارا {تفكهون} حذفت منه إحدى التاءين في الأصل تعجبون من ذلك وتقولون(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {إنا لمغرمون} نفقة زرعنا(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {بل نحن محرومون} ممنوعون رزقنا(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {أفرأيتم الماء الذي تشربون}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P716(@)(@@) {أأنتم أنزلتموه من المزن} السحاب جمع مزنة {أم نحن المنزلون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P716(@)(@@) {لو نشاء جعلناه أجاجا} ملحا لا يمكن شربه {فلولا} هلا {تشكرون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P716(@)(@@) {أفرأيتم النار التي تورون} تخرجون من الشجر الأخضر(@)(@@) PageV01P716(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {أأنتم أنشأتم شجرتها} كالمرخ والعفار والكلخ {أم نحن المنشئون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {نحن جعلناها تذكرة} لنار جهنم {ومتاعا} بلغة {للمقوين} للمسافرين من أقوى القوم أي صاروا بالقوا بالقصر والمد أي 
ms568	 القفر وهو مفازة لا نبات فيها ولا ماء(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {فسبح} نزه {باسم} زائدة {ربك العظيم} الله(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {فلا أقسم} لا زائدة {بمواقع النجوم} بمساقطها لغروبها(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {وإنه} أي القسم بها {لقسم لو تعلمون عظيم} لو كنتم من ذوي العلم لعلمتم عظم هذا القسم(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {إنه} أي المتلو عليكم {لقرآن كريم}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {في كتاب} مكتوب {مكنون} مصون وهو المصحف(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P717(@)(@@) {لا يمسه} خبر بمعنى النهي {إلا المطهرون} الذين طهروا أنفسهم من الأحداث(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {تنزيل} منزل {من رب العالمين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {أفبهذا الحديث} القرآن {أنتم مدهنون} متهاونون مكذبون(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {وتجعلون رزقكم} من المطر أي شكره {أنكم تكذبون} بسقيا الله حيث قلتم مطرنا بنوء كذا(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {فلولا} فهلا إذا بلغت الروح وقت النزع {الحلقوم} هو مجرى الطعام(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {وأنتم} يا حاضري الميت {حينئذ تنظرون} إليه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {ونحن أقرب إليه منكم} بالعلم {ولكن لا تبصرون} من البصيرة أي لا تعلمون ذلك(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {فلولا} فهلا {إن كنتم غير مدينين} مجزيين بأن تبعثوا أي غير مبعوثين بزعمكم(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P717(@)(@@) {ترجعونها} تردون الروح إلى الجسد بعد بلوغ الحلقوم {إن كنتم صادقين} فيما زعمتم فلولا الثانية تأكيد للأولى وإذا ظرف لترجعون المتعلق به الشرطان والمعنى هلا ترجعونها إن نفيتم البعث صادقين في نفيه أي لينتفي عن محلها الموت كالبعث(@)(@@) PageV01P717(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P718(@)(@@) {فأما إن كان} الميت {من المقربين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P718(@)(@@) {فروح} أي فله استراحة {وريحان} رزق حسن {وجنة نعيم} وهل الجواب لأما أو لإن أو لهما أقوال(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {وأما إن كان من أصحاب اليمين}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {فسلام لك} أي له السلامة من العذاب {من أصحاب اليمين} من جهة أنه منهم(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {وأما إن كان من المكذبين الضالين}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {فنزل من حميم}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {وتصلية جحيم}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {إن هذا لهو حق اليقين} من إضافة الموصوف إلى صفته(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P718(@)(@@) {فسبح باسم ربك العظيم} تقدم = 57 سورة(@)(@@)(@@)(@@) | الحديد(@)(@@) PageV01P718(@)(@@) {سبح لله ما في السماوات والأرض} أي نزهه كل شيء فاللام مزيدة وجيء بما دون من تغليبا للأكثر {وهو العزيز} في ملكه {الحكيم} في صنعه(@)(@@) PageV01P718(@)(@@) {له ملك السماوات والأرض يحيي} 
ms569	 بالإنشاء {ويميت} بعده {وهو على كل شيء قدير}(@)(@@) PageV01P718(@)(@@) {هو الأول} قبل كل شيء بلا بداية {والآخر} بعد كل شيء بلا نهاية {والظاهر} بالأدلة عليه {والباطن} عن إدراك الحواس {وهو بكل شيء عليم(@)(@@) PageV01P718(@)(@@) {هو الذي خلق السماوات والأرض في ستة أيام} من أيام الدنيا أولها الأحد وآخرها الجمعة {ثم استوى على العرش} الكرسي استواء يليق به {يعلم ما يلج} يدخل {في الأرض} كالمطر والأموات {وما يخرج منها} كالنبات والمعادن {وما ينزل من السماء} كالرحمة والعذاب {وما يعرج} يصعد {فيها} كالأعمال الصالحة والسيئة {وهو معكم} بعلمه {أين ما كنتم والله بما تعملون بصير}(@)(@@) PageV01P719(@)(@@) {له ملك السماوات والأرض وإلى الله ترجع الأمور} الموجودات جميعها(@)(@@) PageV01P719(@)(@@) {يولج الليل} يدخله {في النهار} فيزيد وينقص الليل {ويولج النهار في الليل} فيزيد وينقص النهار {وهو عليم بذات الصدور} بما فيها من الأسرار والمعتقدات(@)(@@) PageV01P719(@)(@@) {آمنوا} داوموا على الإيمان {بالله ورسوله وأنفقوا} في سبيل الله {مما جعلكم مستخلفين فيه} من مال من تقدمكم وسيخلفكم فيه من بعدكم نزل في غزوة العسرة وهي غزوة تبوك {فالذين آمنوا منكم وأنفقوا} إشارة إلى عثمان رضي الله عنه {لهم أجر كبير}(@)(@@) PageV01P719(@)(@@) {وما لكم لا تؤمنون} خطاب للكفار أي لا مانع لكم من الإيمان {بالله والرسول يدعوكم لتؤمنوا بربكم وقد أخذ} بضم الهمزة وكسر الخاء وبفتحها ونصب ما بعده {ميثاقكم} عليه أي أخذه الله في عالم الذر حين أشهدهم على أنفسهم {ألست بربكم قالوا بلى} {إن كنتم مؤمنين} أي مريدين الإيمان به فبادروا إليه(@)(@@) PageV01P719(@)(@@) {هو الذي ينزل على عبده آيات بينات} آيات القرآن {ليخرجكم من الظلمات} الكفر {إلى النور} الإيمان {وإن الله بكم} في إخراجكم من الكفر إلى الإيمان {لرؤوف رحيم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P720(@)(@@) {وما لكم} بعد إيمانكم {ألا} فيه إدغام نون أن في لام لا {تنفقوا في سبيل الله ولله ميراث السماوات والأرض} بما فيهما فتصل إليه أموالكم من غير أجر الإنفاق بخلاف ما لو أنفقتم فتؤجرون {لا يستوي منكم من أنفق من قبل الفتح} لمكة {وقاتل أولئك أعظم درجة من الذين أنفقوا من بعد وقاتلوا 
ms570	 وكلا} من الفريقين وفي قراءة بالرفع مبتدأ {وعد الله الحسنى} الجنة {والله بما تعملون خبير} فيجازيكم به(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P720(@)(@@) {من ذا الذي يقرض الله} بإنفاق ماله في سبيل الله {قرضا حسنا} بأن ينفقه لله {فيضاعفه} وفي قراءة فيضعفه بالتشديد {له} من عشر إلى أكثر من سبعمائة كما ذكر في البقرة {وله} مع المضاعفة {أجر كريم} مقترن به رضا وإقبال(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P720(@)(@@) اذكر {يوم ترى المؤمنين والمؤمنات يسعى نورهم بين أيديهم} أمامهم {و} يكون {بأيمانهم} ويقال لهم {بشراكم اليوم جنات} أي ادخلوها {تجري من تحتها الأنهار خالدين فيها ذلك هو الفوز العظيم(@)(@@) PageV01P720(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P721(@)(@@) {يوم يقول المنافقون والمنافقات للذين آمنوا انظرونا} أبصرونا وفي قراءة بفتح الهمزة وكسر الظاء أمهلونا {نقتبس} نأخذ القبس والإضاءة {من نوركم قيل} لهم استهزاء بهم {ارجعوا وراءكم فالتمسوا نورا} فرجعوا {فضرب بينهم} وبين المؤمنين {بسور} قيل هو سور الأعراف {له باب باطنه فيه الرحمة} من جهة المؤمنين {وظاهره} من جهة المنافقين {من قبله العذاب}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P721(@)(@@) {ينادونهم ألم نكن معكم} على الطاعة {قالوا بلى ولكنكم فتنتم أنفسكم} بالنفاق {وتربصتم} بالمؤمنين الدوائر {وارتبتم} شككتم في دين الإسلام {وغرتكم الأماني} الأطماع {حتى جاء أمر الله} الموت {وغركم بالله الغرور} الشيطان(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P721(@)(@@) {فاليوم لا يؤخذ} بالياء والتاء {منكم فدية ولا من الذين كفروا مأواكم النار هي مولاكم} أولى بكم {وبئس المصير} هي(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P721(@)(@@) {ألم يأن} يحن {للذين آمنوا} نزلت في شأن الصحابة لما أكثروا المزاح {أن تخشع قلوبهم لذكر الله وما نزل} بالتشديد والتخفيف {من الحق} القرآن {ولا يكونوا} معطوف على تخشع {كالذين أوتوا الكتاب من قبل} هم اليهود والنصارى {فطال عليهم الأمد} الزمن بينهم وبين أنبيائهم {فقست قلوبهم} لم تلن لذكر الله {وكثير منهم فاسقون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P721(@)(@@) {اعلموا} خطاب للمؤمنين المذكورين {أن الله يحيي الأرض بعد موتها} بالنبات فكذلك يفعل بقلوبكم يردها إلى الخشوع {قد بينا لكم الآيات} الدالة على قدرتنا بهذا وغيره {لعلكم تعقلون(@)(@@) PageV01P721(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P722(@)(@@) {إن المصدقين} من التصدق أدغمت التاء في الصاد أي الذين تصدقوا {والمصدقات} اللاتي تصدقن وفي قراءة بتخفيف الصاد 
ms571	 فيهما من التصديق والإيمان {وأقرضوا الله قرضا حسنا} راجع إلى الذكور والإناث بالتغليب وعطف الفعل على الاسم في صلة أل لأنه فيها حل محل الفعل وذكر القرض بوصفه بعد التصدق تقييد له {يضاعف} وفي قراءة يضعف بالتشديد أي قرضهم {لهم ولهم أجر كريم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P722(@)(@@) {والذين آمنوا بالله ورسله أولئك هم الصديقون} المبالغون في التصديق {والشهداء عند ربهم} على المكذبين من الأمم {لهم أجرهم ونورهم والذين كفروا وكذبوا بآياتنا} الدالة على وحدانيتنا {أولئك أصحاب الجحيم} النار(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P722(@)(@@) {اعلموا أنما الحياة الدنيا لعب ولهو وزينة} تزيين {وتفاخر بينكم وتكاثر في الأموال والأولاد} أي الاشتغال فيها وأما الطاعات وما يعين عليها فمن أمور الآخرة {كمثل} أي هي في إعجابها لكم واضمحلالها كمثل {غيث} مطر {أعجب الكفار} الزراع {نباته} الناشئ عنه {ثم يهيج} ييبس {فتراه مصفرا ثم يكون حطاما} فتاتا يضمحل بالرياح {وفي الآخرة عذاب شديد} لمن آثر عليها الدنيا {ومغفرة من الله ورضوان} لمن لم يؤثر عليها الدنيا {وما الحياة الدنيا} ما التمتع فيها {إلا متاع الغرور}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P722(@)(@@) {سابقوا إلى مغفرة من ربكم وجنة عرضها كعرض السماء والأرض} لو وصلت إحداهما بالأخرى والعرض السعة {أعدت للذين آمنوا بالله ورسله ذلك فضل الله يؤتيه من يشاء والله ذو الفضل العظيم}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P722(@)(@@) {ما أصاب من مصيبة في الأرض} بالجدب {ولا في أنفسكم} كالمرض وفقد الولد {إلا في كتاب} يعني اللوح المحفوظ {من قبل أن نبرأها} نخلقها ويقال في النعمة كذلك {إن ذلك على الله يسير(@)(@@) PageV01P722(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P723(@)(@@) {لكيلا} كي ناصبة للفعل بمعنى أن أي أخبر تعالى بذلك لئلا {تأسوا} تحزنوا {على ما فاتكم ولا تفرحوا} فرح بطر بل فرح شكر على النعمة {بما آتاكم} بالمد أعطاكم وبالقصر جاءكم منه {والله لا يحب كل مختال} متكبر بما أوتي {فخور} به على الناس(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P723(@)(@@) {الذين يبخلون} بما يجب عليهم {ويأمرون الناس بالبخل} به لهم وعيد شديد {ومن يتول} عما يجب عليه {فإن الله هو} ضمير فصل وفي قراءة بسقوطه {الغني} عن غيره {الحميد} لأوليائه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P723(@)(@@) {لقد أرسلنا رسلنا} 
ms572	 الملائكة إلى الأنبياء {بالبينات} بالحجج القواطع {وأنزلنا معهم الكتاب} بمعنى الكتب {والميزان} العدل {ليقوم الناس بالقسط وأنزلنا الحديد} أخرجناه من المعادن {فيه بأس شديد} يقاتل به {ومنافع للناس وليعلم الله} علم مشاهدة معطوف على ليقوم الناس {من ينصره} بأن ينصر دينه بآلات الحرب من الحديد وغيره {ورسله بالغيب} حال من هاء ينصره أي غائبا عنهم في الدنيا قال بن عباس ينصرونه ولا يبصرونه {إن الله قوي عزيز} لا حاجة له إلى النصرة لكنها تنفع من يأتي بها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P723(@)(@@) {ولقد أرسلنا نوحا وإبراهيم وجعلنا في ذريتهما النبوة والكتاب} يعني الكتب الأربعة التوراة والإنجيل والزبور والفرقان فإنها في ذرية إبراهيم {فمنهم مهتد وكثير منهم فاسقون(@)(@@) PageV01P723(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P724(@)(@@) {ثم قفينا على آثارهم برسلنا وقفينا بعيسى بن مريم وآتيناه الإنجيل وجعلنا في قلوب الذين اتبعوه رأفة ورحمة ورهبانية} هي رفض النساء واتخاذ الصوامع {ابتدعوها} من قبل أنفسهم {ما كتبناها عليهم} ما أمرناهم بها {إلا} لكن فعلوها {ابتغاء رضوان} مرضاة {الله فما رعوها حق رعايتها} إذ تركها كثير منهم وكفروا بدين عيسى ودخلوا في دين ملكهم وبقي على دين عيسى كثير منهم فآمنوا بنبينا {فآتينا الذين آمنوا} به {منهم أجرهم وكثير منهم فاسقون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P724(@)(@@) {يا أيها الذين آمنوا} بعيسى {اتقوا الله وآمنوا برسوله} محمد صلى الله عليه وسلم وعيسى {يؤتكم كفلين} نصيبين {من رحمته} لإيمانكم بالنبيين {ويجعل لكم نورا تمشون به} على الصراط {ويغفر لكم والله غفور رحيم}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P724(@)(@@) {لئلا يعلم} أي أعلمكم بذلك ليعلم {أهل الكتاب} التوراة الذين لم يؤمنوا بمحمد صلى الله عليه وسلم {أن} مخففة من الثقيلة واسمها ضمير الشأن والمعنى أنهم {لا يقدرون على شيء من فضل الله} خلاف ما في زعمهم أنهم أحباء الله وأهل رضوانه {وأن الفضل بيد الله يؤتيه} يعطيه {من يشاء} فآتى المؤمنين منهم أجرهم مرتين كما تقدم {والله ذو الفضل العظيم} = 58 سورة(@)(@@)(@@)(@@) | المجادلة(@)(@@) PageV01P724(@)(@@) {قد سمع الله قول التي تجادلك} تراجعك أيها النبي {في زوجها} المظاهر منها وكان قال لها أنت علي كظهر أمي وقد سألت النبي 
ms573	 صلى الله عليه وسلم عن ذلك فأجابها بأنها حرمت عليه على ما هو المعهود عندهم من أن الظهار موجبه فرقة مؤبدة وهي خولة بنت ثعلبة وهو أوس بن الصامت {وتشتكي إلى الله} وحدتها وفاقتها وصبية صغارا إن ضمتهم إليه ضاعوا أو إليها جاعوا {والله يسمع تحاوركما} تراجعكما {إن الله سميع بصير} عالم(@)(@@) PageV01P724(@)(@@) {الذين يظهرون} أصله يتظهرون أدغمت التاء في الظاء وفي قراءة بألف بين الظاء والهاء الخفيفة وفي أخرى كيقاتلون والموضع الثاني كذلك {منكم من نسائهم ما هن أمهاتهم إن أمهاتهم إلا اللائي} بهمزة وياء وبلا ياء {ولدنهم وإنهم} بالظهار {ليقولون منكرا من القول وزورا} كذبا {وإن الله لعفو غفور} للمظاهر بالكفارة(@)(@@) PageV01P725(@)(@@) {والذين يظهرون من نسائهم ثم يعودون لما قالوا} أي فيه بأن يخالفوه بإمساك المظاهر منها الذي هو خلاف مقصود الظهار من وصف المرأة بالتحريم {فتحرير رقبة} أي إعتاقها عليه {من قبل أن يتماسا} بالوطء {ذلكم توعظون به والله بما تعملون خبير}(@)(@@) PageV01P725(@)(@@) {فمن لم يجد} رقبة {فصيام شهرين متتابعين من قبل أن يتماسا فمن لم يستطع} أي الصيام {فإطعام ستين مسكينا} عليه أي من قبل أن يتماسا حملا للمطلق على المقيد لكل مسكين مد من غالب قوت البلد {ذلك} أي التخفيف في الكفارة {لتؤمنوا بالله ورسوله وتلك} أي الأحكام المذكورة {حدود الله وللكافرين} بها {عذاب أليم} مؤلم(@)(@@) PageV01P725(@)(@@) {إن الذين يحادون} يخالفون {الله ورسوله كبتوا} أذلوا {كما كبت الذين من قبلهم} في مخالفتهم رسلهم {وقد أنزلنا آيات بينات} دالة على صدق الرسول {وللكافرين} بالآيات {عذاب مهين} ذو إهانة(@)(@@) PageV01P725(@)(@@) {يوم يبعثهم الله جميعا فينبئهم بما عملوا أحصاه الله ونسوه والله على كل شيء شهيد}(@)(@@) PageV01P726(@)(@@) {ألم تر} تعلم {أن الله يعلم ما في السماوات وما في الأرض ما يكون من نجوى ثلاثة إلا هو رابعهم} بعلمه {ولا خمسة إلا هو سادسهم ولا أدنى من ذلك ولا أكثر إلا هو معهم أين ما كانوا ثم ينبئهم بما عملوا يوم القيامة إن الله بكل شيء عليم}(@)(@@) PageV01P726(@)(@@) {ألم تر} تنظر {إلى الذين نهوا عن النجوى 
ms574	 ثم يعودون لما نهوا عنه ويتناجون بالإثم والعدوان ومعصية الرسول} هم اليهود نهاهم النبي صلى الله عليه وسلم عما كانوا يفعلون من تناجيهم أي تحدثهم سرا ناظرين إلى المؤمنين ليوقعوا في قلوبهم الريبة {وإذا جاءوك حيوك} أيها النبي {بما لم يحيك به الله} وهو قولهم السام عليك أي الموت {ويقولون في أنفسهم لولا} هلا {يعذبنا الله بما نقول} من التحية وأنه ليس بنبي إن كان نبيا {حسبهم جهنم يصلونها فبئس المصير} هي(@)(@@) PageV01P726(@)(@@) {يا أيها الذين آمنوا إذا تناجيتم فلا تتناجوا بالإثم والعدوان ومعصية الرسول وتناجوا بالبر والتقوى واتقوا الله الذي إليه تحشرون(@)(@@) PageV01P726(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P727(@)(@@) {إنما النجوى} بالإثم ونحوه {من الشيطان} بغروره {ليحزن الذين آمنوا وليس} هو {بضارهم شيئا إلا بإذن الله} أي إرادته {وعلى الله فليتوكل المؤمنون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P727(@)(@@) {يا أيها الذين آمنوا إذا قيل لكم تفسحوا} توسعوا {في المجلس} مجلس النبي صلى الله عليه وسلم والذكر حتى يجلس من جاءكم وفي قراءة المجالس {فافسحوا يفسح الله لكم} في الجنة {وإذا قيل انشزوا} قوموا إلى الصلاة وغيرها من الخيرات {فانشزوا} وفي قراءة بضم الشين فيهما {يرفع الله الذين آمنوا منكم} بالطاعة في ذلك {و} يرفع {الذين أوتوا العلم درجات} في الجنة {والله بما تعملون خبير}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P727(@)(@@) {يا أيها الذين آمنوا إذا ناجيتم الرسول} أردتم مناجاته {فقدموا بين يدي نجواكم} قبلها {صدقة ذلك خير لكم وأطهر} لذنوبكم {فإن لم تجدوا} ما تتصدقون به {فإن الله غفور} لمناجاتكم {رحيم} بكم يعني فلا عليكم في المناجاة من غير صدقة ثم نسخ ذلك بقوله(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P727(@)(@@) {أأشفقتم} بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه أي خفتم من {أن تقدموا بين يدي نجواكم صدقات} لفقر {فإذ لم تفعلوا} الصدقة {وتاب الله عليكم} رجع بكم عنها {فأقيموا الصلاة وآتوا الزكاة وأطيعوا الله ورسوله} أي داوموا على ذلك {والله خبير بما تعملون(@)(@@) PageV01P727(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) {ألم تر} تنظر {إلى الذين تولوا} هم المنافقون {قوما} هم اليهود {غضب الله عليهم ما هم} أي المنافقون {منكم} من المؤمنين {ولا 
ms575	 منهم} من اليهود بل هم مذبذبون {ويحلفون على الكذب} أي قولهم إنهم مؤمنون {وهم يعلمون} أنهم كاذبون فيه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) {أعد الله لهم عذابا شديدا إنهم ساء ما كانوا يعملون} من المعاصي(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) {اتخذوا أيمانهم جنة} سترا على أنفسهم وأموالهم {فصدوا} بها المؤمنين {عن سبيل الله} أي الجهاد فيهم بقتلهم وأخذ أموالهم {فلهم عذاب مهين} ذو إهانة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) {لن تغني عنهم أموالهم ولا أولادهم من الله} من عذابه {شيئا} من الإغناء {أولئك أصحاب النار هم فيها خالدون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) اذكر {يوم يبعثهم الله جميعا فيحلفون له} أنهم مؤمنون {كما يحلفون لكم ويحسبون أنهم على شيء} من نفع حلفهم في الآخرة كالدنيا {ألا إنهم هم الكاذبون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P728(@)(@@) {استحوذ} استولى {عليهم الشيطان} بطاعتهم له {فأنساهم ذكر الله أولئك حزب الشيطان} أتباعه {ألا إن حزب الشيطان هم الخاسرون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P728(@)(@@) {إن الذين يحادون} يخالفون {الله ورسوله أولئك في الأذلين} المغلوبين(@)(@@) PageV01P728(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P729(@)(@@) {كتب الله} في اللوح المحفوظ أو قضى {لأغلبن أنا ورسلي} بالحجة أو السيف {إن الله قوي عزيز}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P729(@)(@@) {لا تجد قوما يؤمنون بالله واليوم الآخر يوادون} يصادقون {من حاد الله ورسوله ولو كانوا} أي المحادون {آباءهم} أي المؤمنين {أو أبناءهم أو إخوانهم أو عشيرتهم} بل يقصدونهم بالسوء ويقاتلونهم على الإيمان كما وقع لجماعة من الصحابة رضي الله عنهم {أولئك} الذين لا يوادونهم {كتب} أثبت {في قلوبهم الإيمان وأيدهم بروح} بنور {منه} تعالى {ويدخلهم جنات تجري من تحتها الأنهار خالدين فيها رضي الله عنهم} بطاعته {ورضوا عنه} بثوابه {أولئك حزب الله} يتبعون أمره ويجتنبون نهيه {ألا إن حزب الله هم المفلحون} الفائزون = 59 سورة(@)(@@)(@@)(@@) | الحشر(@)(@@) PageV01P729(@)(@@) {سبح لله ما في السماوات وما في الأرض} أي نزهه فاللام مزيدة وفي الإتيان بما تغليب للأكثر {وهو العزيز الحكيم} في ملكه وصنعه(@)(@@) PageV01P729(@)(@@) {هو الذي أخرج الذين كفروا من أهل الكتاب} هم بنو النضير من اليهود {من ديارهم} مساكنهم بالمدينة {لأول الحشر} هو حشرهم إلى الشام وآخره أن أجلاهم عمر في خلافته إلى خيبر {ما ظننتم} أيها المؤمنون {أن يخرجوا وظنوا 
ms576	 أنهم مانعتهم} خبر أن {حصونهم} فاعله تم به الخبر {من الله} من عذابه {فأتاهم الله} أمره وعذابه {من حيث لم يحتسبوا} لم يخطر ببالهم من جهة المؤمنين {وقذف} ألقى {في قلوبهم الرعب} بسكون العين وضمها الخوف بقتل سيدهم كعب بن الأشرف {يخربون} بالتشديد والتخفيف من أخرب {بيوتهم} لينقلوا ما استحسنوه منها من خشب وغيره {بأيديهم وأيدي المؤمنين فاعتبروا يا أولي الأبصار}(@)(@@) PageV01P730(@)(@@) {ولولا أن كتب الله} قضى {عليهم الجلاء} الخروج من الوطن {لعذبهم في الدنيا} بالقتل والسبي كما فعل بقريظة من اليهود {ولهم في الآخرة عذاب النار}(@)(@@) PageV01P730(@)(@@) {ذلك بأنهم شاقوا} خالفوا {الله ورسوله ومن يشاق الله فإن الله شديد العقاب} له(@)(@@) PageV01P730(@)(@@) {ما قطعتم} يا مسلمون {من لينة} نخلة {أو تركتموها قائمة على أصولها فبإذن الله} أي خيركم في ذلك {وليخزي} بالإذن في القطع {الفاسقين} اليهود في اعتراضهم أن قطع الشجر المثمر فساد(@)(@@) PageV01P730(@)(@@) {وما أفاء} رد {الله على رسوله منهم فما أوجفتم} أسرعتم يا مسلمون {عليه من} زائدة {خيل ولا ركاب} إبل أي لم تقاسوا فيه مشقة {ولكن الله يسلط رسله على من يشاء والله على كل شيء قدير} فلا حق لكم فيه ويختص به النبي صلى الله عليه وسلم ومن ذكر معه في الآية الثانية من الأصناف الأربعة على ما كان يقسمه من أن لكل منهم خمس الخمس وله صلى الله عليه وسلم الباقي يفعل فيه ما يشاء فأعطى منه المهاجرين وثلاثة من الأنصار لفقرهم(@)(@@) PageV01P730(@)(@@) {ما أفاء الله على رسوله من أهل القرى} كالصفراء ووادي القرى وينبع {فلله} يأمر فيه بما يشاء {وللرسول ولذي} صاحب {القربى} قرابة النبي من بني هاشم وبني المطلب {واليتامى} أطفال المسلمين الذين هلكت آباؤهم وهم فقراء {والمساكين} ذوي الحاجة من المسلمين {وبن السبيل} المنقطع في سفره من المسلمين أي يستحقه النبي صلى الله عليه وسلم والأصناف الأربعة على ما كان يقسمه من أن لكل من الأربعة خمس الخمس وله الباقي {كي لا} كي بمعنى اللام وأن مقدرة بعدها {يكون} الفيء علة لقسمه كذلك {دولة} متداولا {بين 
ms577	 الأغنياء منكم وما آتاكم} أعطاكم {الرسول} من الفيء وغيره {فخذوه وما نهاكم عنه فانتهوا واتقوا الله إن الله شديد العقاب}(@)(@@) PageV01P731(@)(@@) {للفقراء} متعلق بمحذوف أي اعجبوا {المهاجرين الذين أخرجوا من ديارهم وأموالهم يبتغون فضلا من الله ورضوانا وينصرون الله ورسوله أولئك هم الصادقون} في إيمانهم(@)(@@) PageV01P731(@)(@@) {والذين تبوؤوا الدار} أي المدينة {والإيمان} أي ألفوه وهم الأنصار {من قبلهم يحبون من هاجر إليهم ولا يجدون في صدورهم حاجة} حسدا {مما أوتوا} أي آتى النبي صلى الله عليه وسلم المهاجرين من أموال بني النضير المختصة بهم {ويؤثرون على أنفسهم ولو كان بهم خصاصة} حاجة إلى ما يؤثرون به {ومن يوق شح نفسه} حرصها على المال {فأولئك هم المفلحون(@)(@@) PageV01P731(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) {والذين جاؤوا من بعدهم} من بعد المهاجرين والأنصار إلى يوم القيامة {يقولون ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا} حقدا {للذين آمنوا ربنا إنك رؤوف رحيم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) {ألم تر} تنظر {إلى الذين نافقوا يقولون لإخوانهم الذين كفروا من أهل الكتاب} وهم بنو النضير وإخوانهم في الكفر {لئن} لام قسم في الأربعة {أخرجتم} من المدينة {لنخرجن معكم ولا نطيع فيكم} في خذلانكم {أحدا أبدا وإن قوتلتم} حذفت منه اللام الموطئة {لننصرنكم والله يشهد إنهم لكاذبون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) {لئن أخرجوا لا يخرجون معهم ولئن قوتلوا لا ينصرونهم ولئن نصروهم} أي جاؤوا لنصرهم {ليولن الأدبار} واستغني بجواب القسم المقدر عن جواب الشرط في المواضع الخمسة {ثم لا ينصرون} أي اليهود(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) {لأنتم أشد رهبة} خوفا {في صدورهم} أي المنافقين {من الله} لتأخير عذابه {ذلك بأنهم قوم لا يفقهون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) {لا يقاتلونكم} أي اليهود {جميعا} مجتمعين {إلا في قرى محصنة أو من وراء جدار} سور وفي قراءة جدر {بأسهم} حربهم {بينهم شديد تحسبهم جميعا} مجتمعين {وقلوبهم شتى} متفرقة خلاف الحسبان {ذلك بأنهم قوم لا يعقلون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P732(@)(@@) في ترك الإيمان {كمثل الذين من قبلهم قريبا} بزمن قريب وهم أهل بدر من المشركين {ذاقوا وبال أمرهم} عقوبته في الدنيا من القتل وغيره {ولهم عذاب أليم} مؤلم في 
ms578	 الآخرة(@)(@@) PageV01P732(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P733(@)(@@) مثلهم أيضا في سماعهم من المنافقين وتخلفهم عنهم {كمثل الشيطان إذ قال للإنسان اكفر فلما كفر قال إني بريء منك إني أخاف الله رب العالمين} كذبا منه ورياء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P733(@)(@@) {فكان عاقبتهما} أي الغاوي والمغوي وقرئ بالرفع اسم كان {أنهما في النار خالدين فيها وذلك جزاء الظالمين} أي الكافرين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P733(@)(@@) {يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد} ليوم القيامة {واتقوا الله إن الله خبير بما تعملون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P733(@)(@@) {ولا تكونوا كالذين نسوا الله} تركوا طاعته {فأنساهم أنفسهم} أن يقدموا لها خيرا {أولئك هم الفاسقون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P733(@)(@@) {لا يستوي أصحاب النار وأصحاب الجنة أصحاب الجنة هم الفائزون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P733(@)(@@) {لو أنزلنا هذا القرآن على جبل} وجعل فيه تمييز كالإنسان {لرأيته خاشعا متصدعا} متشققا {من خشية الله وتلك الأمثال} المذكورة {نضربها للناس لعلهم يتفكرون} فيؤمنون(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P733(@)(@@) {هو الله الذي لا إله إلا هو عالم الغيب والشهادة} السر والعلانية {هو الرحمن الرحيم(@)(@@) PageV01P733(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P734(@)(@@) {هو الله الذي لا إله إلا هو الملك القدوس} الطاهر عما لا يليق به {السلام} ذو السلامة من النقائص {المؤمن} المصدق رسله بخلق المعجزة لهم {المهيمن} من هيمن يهيمن إذا كان رقيبا على الشيء أي الشهيد على عباده بأعمالهم {العزيز} القوي {الجبار} جبر خلقه على ما أراد {المتكبر} عما لا يليق به {سبحان الله} نزه نفسه {عما يشركون} به(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P734(@)(@@) {هو الله الخالق البارئ} المنشئ من العدم {المصور له الأسماء الحسنى} التسعة والتسعون الوارد بها الحديث والحسنى مؤنث الأحسن {يسبح له ما في السماوات والأرض وهو العزيز الحكيم} تقدم أولها = 60 سورة(@)(@@)(@@)(@@) | الممتحنة(@)(@@) PageV01P734(@)(@@) {يا أيها الذين آمنوا لا تتخذوا عدوي وعدوكم} أي كفار مكة {أولياء تلقون} توصلون {إليهم} قصد النبي صلى الله عليه وسلم غزوهم الذي أسره إليكم وورى بحنين {بالمودة} بينكم وبينهم كتب حاطب بن أبي بلتعة إليهم كتابا بذلك لما له عندهم من الأولاد والأهل المشركين فاسترده النبي صلى الله عليه وسلم ممن أرسله معه بإعلام الله تعالى له بذلك وقبل عذر حاطب فيه {وقد كفروا 
ms579	 بما جاءكم من الحق} أي دين الإسلام والقرآن {يخرجون الرسول وإياكم} من مكة بتضييقهم عليكم {أن تؤمنوا} أي لأجل أن آمنتم {بالله ربكم إن كنتم خرجتم جهادا} للجهاد {في سبيلي وابتغاء مرضاتي} وجواب الشرط دل عليه ما قبله أي فلا تتخذوهم أولياء {تسرون إليهم بالمودة وأنا أعلم بما أخفيتم وما أعلنتم ومن يفعله منكم} أي إسرار خبر النبي إليهم {فقد ضل سواء السبيل} أخطأ طريق الهدى والسواء في الأصل الوسط(@)(@@) PageV01P735(@)(@@) {إن يثقفوكم} يظفروا بكم {يكونوا لكم أعداء ويبسطوا إليكم أيديهم} بالقتل والضرب {وألسنتهم بالسوء} بالسب والشتم {وودوا} تمنوا {لو تكفرون}(@)(@@) PageV01P735(@)(@@) {لن تنفعكم أرحامكم} قراباتكم {ولا أولادكم} المشركون الذين لأجلهم أسررتم الخبر من العذاب في الآخرة {يوم القيامة يفصل} بالبناء للمفعول والفاعل {بينكم} وبينهم فتكونون في الجنة وهم في جملة الكفار في النار {والله بما تعملون بصير}(@)(@@) PageV01P735(@)(@@) {قد كانت لكم إسوة} بكسر الهمزة وضمها في الموضعين قدوة {حسنة في إبراهيم} أي به قولا وفعلا {والذين معه} من المؤمنين {إذ قالوا لقومهم إنا برآء} جمع بريء كظريف {منكم ومما تعبدون من دون الله كفرنا بكم} أنكرناكم {وبدا بيننا وبينكم العداوة والبغضاء أبدا} بتحقيق الهمزتين وإبدال الثانية واوا {حتى تؤمنوا بالله وحده إلا قول إبراهيم لأبيه لأستغفرن لك} مستثنى من أسوة فليس لكم التأسي به في ذلك بأن تستغفروا للكفار وقوله {وما أملك لك من الله} أي من عذابه وثوابه {من شيء} كنى به عن أنه لا يملك له غير الاستغفار فهو مبني عليه مستثنى من حيث المراد منه وإن كان من حيث ظاهره مما يتأسى فيه {قل فمن يملك لكم من الله شيئا} واستغفاره لكم قبل أن يتبين له أنه عدو لله كما ذكره في براءة {ربنا عليك توكلنا وإليك أنبنا وإليك المصير} من مقول الخليل ومن معه أي قالوا(@)(@@) PageV01P735(@)(@@) {ربنا لا تجعلنا فتنة للذين كفروا} أي لا تظهرهم علينا فيظنوا أنهم على الحق فيفتنوا أي تذهب عقولهم بنا {واغفر لنا ربنا إنك أنت العزيز الحكيم} في ملكك وصنعك(@)(@@) PageV01P736(@)(@@) {لقد كان لكم} 
ms580	 يا أمة محمد جواب قسم مقدر {فيهم أسوة حسنة لمن كان} بدل اشتمال من كم بإعادة الجار {يرجوا الله واليوم الآخر} أي يخافهما أو يظن الثواب والعقاب {ومن يتول} بأن يوالي الكفار {فإن الله هو الغني} عن خلقه {الحميد} لأهل طاعته(@)(@@) PageV01P736(@)(@@) {عسى الله أن يجعل بينكم وبين الذين عاديتم منهم} من كفار مكة طاعة لله تعالى {مودة} بأن يهديهم للإيمان فيصيروا لكم أولياء {والله قدير} على ذلك وقد فعله بعد فتح مكة {والله غفور} لهم ما سلف {رحيم} بهم(@)(@@) PageV01P736(@)(@@) {لا ينهاكم الله عن الذين لم يقاتلوكم} من الكفار {في الدين ولم يخرجوكم من دياركم أن تبروهم} بدل اشتمال من الذين {وتقسطوا} تقضوا {إليهم} بالقسط أي بالعدل وهذا قبل الأمر بجهادهم {إن الله يحب المقسطين} العادلين(@)(@@) PageV01P736(@)(@@) {إنما ينهاكم الله عن الذين قاتلوكم في الدين وأخرجوكم من دياركم وظاهروا} عاونوا {على إخراجكم أن تولوهم} بدل اشتمال من الذين أي تتخذوهم أولياء {ومن يتولهم فأولئك هم الظالمون(@)(@@) PageV01P736(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P737(@)(@@) {يا أيها الذين آمنوا إذا جاءكم المؤمنات} بألسنتهن {مهاجرات} من الكفار بعد الصلح معهم في الحديبية على أن من جاء منهم إلى المؤمنين يرد {فامتحنوهن} بالحلف على أنهن ما خرجن إلا رغبة في الإسلام لا بغضا لأزواجهن الكفار ولا عشقا لرجال من المسلمين كذا كان النبي صلى الله عليه وسلم يحلفهن {والله أعلم بإيمانهم فإن علمتموهن} ظننتموهن بالحلف {مؤمنات فلا ترجعوهن} تردوهن {إلى الكفار لا هن حل لهم ولا هم يحلون لهن وآتوهم} أي أعطوا الكفار أزواجهن {ما أنفقوا} عليهن من المهور {ولا جناح عليكم أن تنكحوهن} بشرطه {إذا آتيتموهن أجورهن} مهورهن {ولا تمسكوا} بالتشديد والتخفيف {بعصم الكوافر} زوجاتكم لقطع إسلامكم لها بشرطه أو اللاحقات بالمشركين مرتدات لقطع ارتدادهن نكاحكم بشرطه {واسألوا} اطلبوا {ما أنفقتم} عليهن من المهور في صورة الارتداد ممن تزوجهن من الكفار {وليسألوا ما أنفقوا} على المهاجرات كما تقدم أنهم يؤتونه {ذلكم حكم الله يحكم بينكم} به {والله عليم حكيم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P737(@)(@@) {وإن فاتكم شيء من أزواجكم} أي واحدة فأكثر منهن أو شيء 