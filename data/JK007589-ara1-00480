ms461	 لهو أراه بعدكم % 66(@)(@@) % عندي سوى سخرة من السخر % لست إلى نغمة بذي أذن % 67(@)(@@) % ولا إلى صورة بذي صور % كنت وكانت قرينة لك عي % % 68(@)(@@) % نين لهوى فشين بالعور % وكنت يمناهما ففات بك الد % 69(@)(@@) % دهر وهل يصطفي سوى الخير % يا مشربا كان لي بلا كدر % 70(@)(@@) % يا سمرا كان لي بلا سهر % ما كنت أدري أطعم عافيتي % % PageV01P1738 71(@)(@@) % أعذب أم طعم ذلك السمر % يا نعمة الله في بريته % % 72(@)(@@) % أصبحت إحدى فواقر الفقر % يا غضة السن يا صغيرتها % % 73(@)(@@) % أمسيت إحدى المصائب الكبر % أنى اختصرت الطريق يا سكني % % 74(@)(@@) % إلى لقاء الأكفان والحفر % ألم تكوني غريرة فن قا % 75(@)(@@) % لا يهتدي مثلها لمحتصر % أنى تجشمت في الحداثة ما % % 76(@)(@@) % جشمت من كره ذلك السفر % أنى ولم تلحقي ذوي حنك الس % 77(@)(@@) % سن ولا امزت من ذوي الغرر % أحميك من مورد قصدت له % % 78(@)(@@) % لا ينتهي ورده إلى صدر % يا شمس زهر الشموس يا قمر ال % % 79(@)(@@) % أقمار حسنا يا زهرة الزهر % أبعد ما كنت باب مبتهج % 80(@)(@@) % للنفس أصبحت باب معتبر % أصبحت كالترب غير راجحة % PageV01P1739 81(@)(@@) % به وقد ترجحين بالبدر % أصابنا الدهر فيك أكمل ما % % 82(@)(@@) % كنت فما رزؤنا بمجتبر % % لم تقتحمك العيون من صغر % 83(@)(@@) % ولا قلتك النفوس من كبر % فكيف نسلاك والأسى أبدا % 84(@)(@@) % في كبر والسلو في صغر % كل ذنوب الزمان مغتفر % 85(@)(@@) % وذنبه فيك غير مغتفر % تبتل العود عند فقدكم % 86(@)(@@) % وازدجر اللهو أي مزدجر % وغاب عنا السرور بعدكم % 87(@)(@@) % واحتضر الهم حين محتضر % وغاض ماء النعيم يتبعكم % % 88(@)(@@) % وانهمر الدمع كل منهمر % فإن سمعنا لمزهر وترا % 89(@)(@@) % حن فهاتيك عولة الوتر % أما ولؤم البلى وقسوته % % 90(@)(@@) % لقد محا منك أحسن الصور % يا بشرا صاغه المصور من % % PageV01P1740 91(@)(@@) % نور على سنة من الفطر % % بل من شعاع العقول حين ترى ال % % 92(@)(@@) % غيب بعين الذكاء والعبر % لا تحسبوني غنيت بعدكم % 93(@)(@@) % عنكم بشمس الضحى ولا القمر % لا تحسبوني أنست بعدكم % 94(@)(@@) % إلى هديل الحمام في 
ms462	 الشجر % لا تحسبوني استرحت بعدكم % 95(@)(@@) % إلى نسيم الشمال بالسحر % لا تحسبوا العين بعدكم سرحت % % 96(@)(@@) % في مسرح من مسارح النظر % يأبى لها ذاك أن ناظرها % % 97(@)(@@) % في شغل بالسهاد والعبر % وكيف بالنوم للمباشر أطرا % % 98(@)(@@) % ف حمات الحيات والإبر % سقيا ورعيا لعيشة معكم % % 99(@)(@@) % أصبحت من عهدها بمفتقر % أمتعني دهرها بغبطته % % 100(@)(@@) % على الذي كان فيه من قصر % كانت لياليه كلها سحرا % PageV01P1741 101(@)(@@) % وكان أيامهن كالبكر % لهو أطفنا ببكر لذته % % 102(@)(@@) % وما فضضنا خواتم العذر % وإن ننل من جناه نهمتنا % % 103(@)(@@) % وإن حظينا بمونق الزهر % كم قد نعمنا بضم متشح % 104(@)(@@) % وما اعتدينا بهتك مؤتزر % كم قد شربت الرضاب في قبل % % 105(@)(@@) % كانت ولكن شربت بالغمر % جدوى فم فيه لؤلؤ وجنى % % 106(@)(@@) % نحل بماء السحاب في النقر % غناؤه يشتكي حرارته % % 107(@)(@@) % وريقه يشتكي من الخصر % كنتم لنا فتنة من الفتن ال % % 108(@)(@@) % غر بلا شهرة من الشهر % وكل لهو بمثل وصلكم % 109(@)(@@) % ذو غرر إذ سواه ذو عرر % أخذتكم طائعا أخا جذل % 110(@)(@@) % ولم أدع طائعا ولم أذر % كأنني ما طلعت مقبلة % PageV01P1742 111(@)(@@) % علي يوما بأملح الطرر % في كفك العود وهو يؤذن بال % % 112(@)(@@) % إحسان إيذان صادق الخبر % إذ مشيكم مذكري غناءكم % 113(@)(@@) % مشي الهوينا سواكن البقر % وإذ فسادي بكم يذكرني % % 114(@)(@@) % لنفسدن الطواف في عمر % كأن عيني أبصرتك ضحى % % 115(@)(@@) % في مجلسي والوشاة في سقر % كأنها مارأتك كالملك ال % % 116(@)(@@) % أصيد في التاج يوم مبتهر % وبين عينين منكم علم % 117(@)(@@) % لم يسد شبه له ولم ينر % يا أحسن العالمين حاسرة % 118(@)(@@) % وأكمل الناس عند معتجر % كأنها ما رأتك صادحة % 119(@)(@@) % والصدح الورق عكف الزمر % يسمعن أو يستفدن منك شجا % % 120(@)(@@) % والتمر يمتار من قرى هجر % كأن داوود كان يومئذ % PageV01P1743 121(@)(@@) % يتلو زبورا ملين الزبر % كأنني ما اقترحت ما اقترحت % 122(@)(@@) % نفسي فساعفتني بلا زور % كأنني ما استعدت مقترحي % % 123(@)(@@) % يوما فكررته بلا ضجر % وصنت خدا كساه خالقه ال % % 124(@)(@@) % حسن فصعرته عن الصعر % ولو تكبرت كنت معذرة % 125 
ms463	(@)(@@) % والمسك ما لا يعاب بالذفر % كأنني ما نعمت منك بمر % % 126(@)(@@) % تاح نعيم ولا بمبتكر % رضيت من منظر بطيف كرى % % 127(@)(@@) % يعرو ومن مسمع بمدكر % رضى كسخط ولو قدرت لغي % % 128(@)(@@) % يرت ونكرت منكر الغير % % لو أن قرني سوى المقادر في % % 129(@)(@@) % أمرك أحضرت عز منتصر % لكنها القرن لا يقاومه % 130(@)(@@) % قرن عزيز لعزة النفر % لو كان فعل الورى لقد ذئرت % PageV01P1744 131(@)(@@) % له المساعير أيما ذأر % لكنه وتر مالك ملك % 132(@)(@@) % يعلو على الطالبين بالثؤر % يا لهف نفسي على مهاجرتي % % 133(@)(@@) % إياك لهفا يطير كالشرر % ليس لذنب دعا إلى غضب % 134(@)(@@) % لكن لنعمى دعت إلى بطر % هجر متى شئت قلت كان من ال % % 135(@)(@@) % خسران أو قلت ربح متجر % كانت تجد الهوى مغنية % 136(@)(@@) % كأنها نشرة من النشر % ووصلك الإلف بعد هجرته % 137(@)(@@) % يجنيك معسول حدة الظفر % لولا التعزي بذاك آونة % 138(@)(@@) % لانفطر القلب كل منفطر % ما انتهك الدهر قبلكم لذوي الله % % 139(@)(@@) % و حريما في البدو والحضر % أبكيك بالدمع والدماء بل التس % % 140(@)(@@) % هاد بل بالمشيب في الشعر % بل بنحول العظام محتقرا % PageV01P1745 141(@)(@@) % ذاك وإن كان غير محتقر % % بل بإجتناب الشفاه بل بتوخي الن % % 142(@)(@@) % فس مايتقى من الضرر % لأستميحن كل ذاك لمبكا % % 143(@)(@@) % ئيك بعد استماحة الدرر % بل ليت شعري وقد حييت وقد % % 144(@)(@@) % قدمت للنفس وجه معتذر % كيف وأني ولم أقمت وقد % % 145(@)(@@) % بنت أكان الفؤاد من حجر % إلا أكن مت فانقرضت فكم % 146(@)(@@) % من موتة للفؤاد في الذكر % % وليس في خطرة مغيرة % 147(@)(@@) % لكنها سرمد مع الفكر % رثيت منك صبى تكنف % % 148(@)(@@) % عفاف سر وحسن مجتهر % وما يفي بالثلاث مرثية % 149(@)(@@) % إلا صلاة المليك في السور % وإن جرى الدمع غير معتنف % 150(@)(@@) % وسمح الشعر غير معتسر % وكنت عفو الصبى فشيعه % PageV01P1746 151(@)(@@) % عفو من الشجو غير معتصر % دمع وشعر مساعد أتيا % % 152(@)(@@) % طوعا وما طائع كمقتسر % أشكو إلى الله لا إلى أحد % 153(@)(@@) % أن مت والنفس حية الوطر % من لي بالصبر بعد مدخر % 154(@)(@@) % أفنى من الصبر 
ms464	 كل مدخر % بل قبح الصبر إنه غدر % 155(@)(@@) % بصاحب الصدق أيما غدر % لا أسأل الله حسن مصطبر % % 156(@)(@@) % فإنه عنك لؤم مصطبر % وحزن نفسي عليك من كرم % 157(@)(@@) % وهو على من سواك من خور % وقد يعزي الفؤاد أنك في % % 158(@)(@@) % جنة عدن غدا وفي نهر % سيشفع الحور فيك أنك منهن % 159(@)(@@) % ن بذاك الدلال والحور % يا لهف نفسي عليك كم حذرت % 160(@)(@@) % لو وقيت ماتخاف بالحذر % كم وحي رؤيا فزعت فيك له % % PageV01P1747 161(@)(@@) % وطيرة من نواطق الطير % بينت لي الحزم في البدار إلى % % 162(@)(@@) % كل مخوف عليه مبتدر % أصبحت من صبحه بمنبلج % 163(@)(@@) % والناس من فجره بمنفجر % ولو تخليت من شجاي بكم % % 164(@)(@@) % بادرت باللهو كرة القدر % ن % % PageV01P1748 البحر : - 1(@)(@@) % ود المبرد أن الله بدله % من كل جارحة في جسمه دبرا % % 2(@)(@@) % فأعطه يا إله الناس منيته % ولا تبق له سمعا ولا بصرا % % 3(@)(@@) % لكي يقضي أوطارا مذممة % من كل عرد ترى في رأسه عجرا % % 4(@)(@@) % بل لو يكون له ضعفا جوارحه % من الفقاح لما قضى بها وطرا % % 5(@)(@@) % هيهات ثم غليل لا شفاء له % أو يجعل الكل منه فقحة وحرا % % PageV01P1749 البحر : - 1(@)(@@) % ومستصرخي بعد الخليفة صنوه % % أبو أحمد المحمود في البدو والحضرص فمن مبلغ عني موفق هاشم % 2(@)(@@) % قريع بني العباس ذا المجد والفخر % وصاحب عهد المسلمين الذي غدا % % 3(@)(@@) % يخاف ويرجى للعظيم من الأمر % يمينا لئن أنتم خذلتم وليكم % % 4(@)(@@) % لتستفسدن الأولياء يد الدهر % إذا كان خذلان النصير جزاءه % 5(@)(@@) % فماذا يرجي باذل النصر في النصر % أتثمر إسلام النصير وليه % 6(@)(@@) % وقايته إياه بالصدر والنحر % أبى ذاك أن الريع يشبه بذره % 7(@)(@@) % وذلك أن الريع من جوهر البذر % وعذر ولي المرء بالمرء فاتح % 8(@)(@@) % لشيعته الوافين بابا إلى الغدر % هززتك فاغضب غضبة جعفرية % 9(@)(@@) % تكون على الأعداء راغية البكر % ولا تله عن إصراخ داعيك بالتي % % 10(@)(@@) % يسير بها الركبان في البر والبحر % ن % % PageV01P1750 البحر : - 1(@)(@@) % عظم الله يمن فطرك فطرا % % ياابن أعلى الملوك مجدا وذكرا % % 2(@)(@@) % وأهل الشهور 
ms465	 بالسعد ماعش % % ت وأبقاك آخر الدهر عصرا % % 3(@)(@@) % في سرور يريك شهرك يوما % وحبور يريك عامك شهرا % % 4(@)(@@) % قلت لما بدا الهلال ضئيلا % قد كسته سرى ثلاثين ضمرا % % 5(@)(@@) % عجبا للهلال كيف استهلو % % ه هلالا هلا استهلوه بدرا % % 6(@)(@@) % كان لما بدا وأنت أمير % مستحقا أن يبهر الشمس فخرا % % 7(@)(@@) % كيف لم يسبق المواقيت بدرا % كيف لم يقهر المقادير قهرا % % 8(@)(@@) % غير أن الأمور تجري على ما % % قدر الله وهو أحسن قدرا % % 9(@)(@@) % أحمد الله إذ أراني عيدا % لاأرى فيه فوق أمرك أمرا % % 10(@)(@@) % طاب فيه نسيم ريحك حتى % % لحسبنا عجاج خيلك عطرا % % PageV01P1751 11(@)(@@) % وتجليت ملء عين وصدر % وقديما ملأت عينا وصدرا % % 12(@)(@@) % نذر الناس في القديم نذورا % إن رأوا عيدك المأمل شكرا % % 13(@)(@@) % وتركت النذور عمدا لأني % % لا أرى كفء نعمة فيك نذرا % % 14(@)(@@) % فالبس العيد وانضه سالم النف % % س وإن لم تسلم ثراء ووفرا % % 15(@)(@@) % طلت مجدا وطلت فخرا بني آ % % دم طرا فطل كذلك عمرا % % PageV01P1752 البحر : - 1(@)(@@) % ياباني الدرج الذي أولى به % % لو كان يعقل هدمها من داره % 2(@)(@@) % لا تبنين بنية قوادة % تزني بنات أبي البنات بجاره % 3(@)(@@) % لم يبنها إلا امرؤ متعصب % للكشخ يعجبه ارتفاع شناره % 4(@)(@@) % ياباني الدرج الوثيق بناؤها % % بالصخر ينقله على أشفاره % 5(@)(@@) % شكرا لما هتكن من حرماته % لا بل لما كثرن من أصهاره % 6(@)(@@) % كم غافل في سوقه قنعته % في عونه خزيا وفي أبكاره % 7(@)(@@) % لو غار هدمها بفيه وأنفه % طلبا لها حتى الممات بثاره % 8(@)(@@) % لكنه رجل يبرج عرسه % وبناته ليزدن في أنصاره % PageV01P1753 البحر : - 1(@)(@@) % إن تطل لحية عليك وتعرض % % فالمخالي معروفة للحمير % 2(@)(@@) % علق الله في عذاريك مخلا % % ة ولكنها بغير شعير % 3(@)(@@) % لو غدا حكمها إلي لطارت % % في مهب الرياح كل مطير % 4(@)(@@) % ألقها عنك ياطويلة أولا % فاحتسبها شرارة في السعير % 5(@)(@@) % أرع فيها الموسى فإنك منها % % شهد الله في أثام كبير % 6(@)(@@) % أيما كوسج يراها فيلقى % % ربه بعدها صحيح الضمير % 7(@)(@@) % هو أحرى بأن يشك ويغرى % % باتهام 
ms466	 الحكيم في التقدير % % 8(@)(@@) % ما تلقاك كوسج قط إلا % جور الله أيما تجوير % 9(@)(@@) % لحية أهملت فسالت وفاضت % فإليها تشير كف المشير % 10(@)(@@) % مارأتها عين امرىء مارآها % % قط إلا أهل بالتكبير % PageV01P1754 11(@)(@@) % روعة تستخفه لم يرعها % % من رأى وجه منكر ونكير % 12(@)(@@) % فاتق الله ذا الجلال وغير % منكرا فيك ممكن التغيير % 13(@)(@@) % أو فقصر منها فحسبك منها % % نصف شبر علامة التذكير % 14(@)(@@) % لو رأى مثلها النبي لأجرى % % في لحى الناس سنة التقصير % 15(@)(@@) % واستحب الإحفاء فيهن والحل % ق مكان الإعفاء والتوفير % PageV01P1755 البحر : - 1(@)(@@) % ياضارب المثل المزخرف مطريا % للحقد لم تقدح بزند واري % % 2(@)(@@) % أصبحت خصم الحق تهدم مابنى % % والحق محتج وأنت تماري % % 3(@)(@@) % أطريت غثك لاسمينك ضلة % واخترت من خلقيك غير خيار % 4(@)(@@) % شبهت نفسك والألى يولونها % % آلاءهم بالأرض والعمار % 5(@)(@@) % ورأيت حفظك ما أتوا من صالح % أو سيء كرما وعتق نجار % 6(@)(@@) % وزعمت فيك طبيعة أرضية % ياسابق التقرير بالإقرار % 7(@)(@@) % ولقد صدقت وماكذبت فإنه % لايدفع المعروف بالإنكار % 8(@)(@@) % لكن هاتيك الطبيعة في الفتى % % مما تلط عليه بالأستار % 9(@)(@@) % ولصمته عن ذكرها أولى به % % من عدها في الفخر عند فخار % 10(@)(@@) % فينا وفيك طبيعة أرضية % تهوي بنا أبدا لشر قرار % PageV01P1756 11(@)(@@) % هبطت بآدم قبلنا وبزوجه % من جنة الفردوس أفضل دار % 12(@)(@@) % فتعوضا الدنيا الدنية كاسمها % % من تلكم الجنات والأنهار % 13(@)(@@) % بئست لعمر الله تلك طبيعة % حرمت أبانا قرب أكرم جار % 14(@)(@@) % واستأسرت ضعفي بنيه بعده % فهم لها أسرى بغير إسار % 15(@)(@@) % لكنها مأسورة مقسورة % مقهورة السلطان في الأحرار % 16(@)(@@) % فجسومهم من أجلها تهوي بهم % % ونفوسهم تسمو سمو النار % 17(@)(@@) % لولا منازعة الجسوم نفوسهم % % نفذوا بسورتها من الأقطار % 18(@)(@@) % أو قصروا فتناولوا بأكفهم % % قمر السماء وكل نجم ساري % % 19(@)(@@) % عرفوا لروح الله فيهم فضل ما % % قد أثرت من صالح الآثار % 20(@)(@@) % فتنزهوا وتعظموا وتكرموا % % عن لؤم طبع الطين والأحجار % % PageV01P1757 21(@)(@@) % نزعوا إلى النجد الذي منه أتت % % أرواحهم وسموا عن الأغوار % % 22(@)(@@) % هذا عبيد الله منهم واحد % % لكنه هو واحد المضمار % % 23 
ms467	(@)(@@) % ملك له همم تنيف على العلا % % ويد تطول مواقع الأقدار % % 24(@)(@@) % وإذا عطا للمجد نال بكفه % % ما لا ينال الناس بالأبصار % % 25(@)(@@) % ولقد رأيت معاشرا جمحت بهم % % تلك الطبيعة نحو كل تبار % % 26(@)(@@) % تهوي نفوسهم هوي جسومهم % % سفلا لكل دناءة وصغار % % 27(@)(@@) % تبعوا الهوى فهوى بهم وكذا الهوى % % منه الهوي بأهله فحذار % % 28(@)(@@) % لاترض بالمثل الذي مثلته % مثلا ففيه مقالة للزاري % % 29(@)(@@) % وانظر بعين العقل لاعين الهوى % % فالحق للعين الجلية عاري % % 30(@)(@@) % الأرض في أفعالها مضطرة % والحي فيه تصرف المختار % % PageV01P1758 31(@)(@@) % فمتى جريت على طباعك مثلها % % فكأن طرفك بعد من فخار % % 32(@)(@@) % أخرجت من باب المشيئة مثل ما % % خرجت فأنت على الطبيعة جاري % % 33(@)(@@) % أنى تكون كذا وأنت مخير % متصرف في النقض والإمرار % % 34(@)(@@) % أين اصطراف الحي في أنحائه % % وحويله فيما سوى المقدار % % 35(@)(@@) % أين اختيار مخير حسناته % % إن كنت لست تقول بالإجبار % % 36(@)(@@) % شهد اتفاق الناس طرا في الهوى % % و تفاوت الأبرار والفجار % % 37(@)(@@) % أن الجميع على طباع واحد % % وبما يرون تفاضل الأطوار % 38(@)(@@) % فمتى رأيت حميدهم وذميمهم % % فبفضل إيثار على إيثار % % 39(@)(@@) % قاد الهوى الفجار فانقادوا له % % وأبت عليه مقادة الأبرار % % 40(@)(@@) % لولا صروف الإختيار لأعنقوا % % لهوى كما استقت جمال قطار % % PageV01P1759 41(@)(@@) % ورأيتهم مثل النجوم فإنها % % متتابعات كلها لمدار % % 42(@)(@@) % متيممات سمت وجه واحد % % ولها مطالع جمة ومجاري % % 43(@)(@@) % فانس الحقود فإنها منسية % إلا لدى اللؤماء والأشرار % % 44(@)(@@) % واعص الطباع إذا أطباك لحفظها % % واختر عليهتكن من الأخيار % % 45(@)(@@) % مازال طبع الأرض يقهر لؤمه % من فيه روح الواحد القهار % % 46(@)(@@) % لا تنس روح الله فيك وأنها % % جعلت لتصلح منك كل عوار % % 47(@)(@@) % إن الحقود إذا تذكرها الفتى % % تحيا حياة الجمر بالمسعار % % 48(@)(@@) % ولعلها إن لا تضر عدوه % وهو المسلف عاجل الإضرار % % 49(@)(@@) % تصلى جوانح صدره من حقده % % بلهيب جمر ثاقب وأوار % % 50(@)(@@) % فلصدره من ذاك شر بطانة % % ولقلبه من ذاك شر سعار % % PageV01P1760 51(@)(@@) % ذاك الذي نقد المكيدة نفسه % % نقدا وكاد عدوه بضمار % % 52(@)(@@) % ما نال منه مناله من نفسه 
ms468	 % % وتر الألى وتروه بالأوتار % % 53(@)(@@) % ردت يداه كيده في نحره % وكذا تكون مكايد الأغمار % % 54(@)(@@) % وكفى الحقود مهانة وغضاضة % أن لست تلقاه عدو جهار % % 55(@)(@@) % لكنه يمشي الضراء بحقده % % ليلا ويلبد تحت كل نهار % 56(@)(@@) % يلقى أعاديه بصفحة ذلة % سلم اللسان محارب الإضمار % % 57(@)(@@) % لكن أهل الطول من متجاوز % ومعاقب جهرا بغير تواري % % 58(@)(@@) % طرحوا الضغائن إذ رأوا لنفوسهم % % خطرا ينيف بها على الأخطار % % 59(@)(@@) % فانظر بعين الرأي لا بعين الهوى % % فالحق للعين الجلية عاري % % 60(@)(@@) % النفس خيرك إنها علوية % % والجسم شرك ليس فيه تماري % % PageV01P1761 61(@)(@@) % فانقد لخيرك لا لشرك واتبع % أولاهما بالقادر الغفار % % 62(@)(@@) % كن مثل نفسك في السمو إلى العلى % % لا مثل طينة جسمك الغدار % % 63(@)(@@) % فالنفس تسمو نحو علو مليكها % % والجسم نحو السفل هاو هاري % % 64(@)(@@) % فأعن أحقهما بعونك واقتسر % % طبع السفال بطبعك السوار % 65(@)(@@) % إياك واستضعاف حق إنه % % في كل حين حاضر الأنصار % 66(@)(@@) % والحق والشبه التي بإزائه % % كالشمس جاورها هلال سرار % PageV01P1762 البحر : - 1(@)(@@) % تنافسني في مؤخر البكر سادرا % وأنت على القيدوم من ذروة البكر % 2(@)(@@) % ألا ليت شعري لم مطلت مثوبتي % % ولم تؤت من بخل ولم تؤت من عسر % % 3(@)(@@) % إخالك إذ جودت فيك مدائحي % % منعت ثوابي حاسدا لي على شعري % % 4(@)(@@) % أتحسدني تجويد ريط نسجته % لتلبسه يا للعجيب من الأمر % 5(@)(@@) % تذكر هداك الله أني مادح % % وأنك ممدوح فلا تعد بي قدري % % 6(@)(@@) % ينافس في الشعر النظير نظيره % % وجل ملوك الناس عن ذلك النجر % % 7(@)(@@) % وما يتجارى الشاعران لغاية % وراء اعتفاء الفضل من سيد غمر % % 8(@)(@@) % وأنت الذي تعفو العفاة فضوله % % ويجري إلى معروفه الشعر من يجري % % 9(@)(@@) % فما لك يا هذا نفست خسيستي % % وأنت مع الشمس المنيرة والبدر % % 10(@)(@@) % عليك بإغناء الفقير وجبره % % وفك الأسير المستكين من الأسر % % PageV01P1763 11(@)(@@) % عليك بفتق الحادثات ورتقها % % وتضريم نار الحرب بالبيض والسمر % % 12(@)(@@) % عليك بأفعال الملوك وخلني % % وتقريظ ما تأتي من العرف والنكر % % 13(@)(@@) % فحسب المساعي كلها بك ساعيا % وحسبك وصفي ما تريش وما تبري % % 14(@)(@@) % أقول 
ms469	 وتعطي نائلا بعد نائل % فتغرف من بحر وأقلع من صخر % % 15(@)(@@) % إذا الشاعر الرومي أطرى أميره % % فناهيك من مطرى وناهيك من مطري % % 16(@)(@@) % وما لمديحي فيثناك زيادة % سوى أني نظام لؤلؤك النثر % % PageV01P1764 البحر : - 1(@)(@@) % أيا من ليس يرضيه مديح % وعفو الشتم عنه له كثير % 2(@)(@@) % أجدك لاترى في الشعر كفؤا % لمجدك أين جار بك المسير % 3(@)(@@) % كأنك قد حللت من المعالي % % بحيث الشمس والقمر المنير % 4(@)(@@) % فإن الله أعلى منك جدا % ويرضيه من الحمد اليسير % PageV01P1765 البحر : - 1(@)(@@) % يا غيورا أن يهتك المستور % وشفيقا أن يهلك المضرور % 2(@)(@@) % أنا في حالة رجائي فيها % % من سوى الله أو سواك غرور % % 3(@)(@@) % ومعي سالف الموالاة والمد % % ح وشكر مستأنف موفور % % 4(@)(@@) % يا لها حرمة أبحت حماها % % وعلى مثلها يغار الغيور % % 5(@)(@@) % فأغثني أغاثك الله إني % % في يد الدهر مطلق مأسور % % 6(@)(@@) % لاتدعني فأنت آثر بالحم % % د قديما وفضلك المأثور % % 7(@)(@@) % يا أخا العدل والذي فضله المب % % سوط فينا وبشره المنشور % % 8(@)(@@) % هل ترى أن مانعا من محق % حقه بعد قدرة معذور % % 9(@)(@@) % حق عند الرجاء فيك المرجى % % أن يحق المرجو لا المحذور % % 10(@)(@@) % لك جود ورأفة وحفاظ % وإليك الميسور لا المعسور % % PageV01P1766 11(@)(@@) % لست تعتل بالزمان ولا المق % % دور أنت الزمان والمقدور % % PageV01P1767 البحر : - 1(@)(@@) % راجع من بعد سلوة ذكرهص وواصل الظبي بعدما هجره % ظبي دعا قلب هائم كلف % 2(@)(@@) % مؤتمر قلبه بما أمره % % يؤنسه حسنه ويوحشه % 3(@)(@@) % قبح أفاعيله إذا ذكره % % مازال يدعوه من محاسنه % 4(@)(@@) % داع إذا سوء فعله زجره % % لا الوصل يصفو له وإن عزم ال % % 5(@)(@@) % هجران غال النزاع مصطبره % % يدنو فيقصى فإن نأى أنفا % 6(@)(@@) % بات يباري بكاؤه سهره % % ألقاه في حيرة محيرة % 7(@)(@@) % فما يرى ورده ولا صدره % ظبي وما الظبي بالشبيه به % % 8(@)(@@) % في الحسن إلا استراقه حوره % % وحسن أجياده وغنته % 9(@)(@@) % ونفرة فيه من رقى الفجره % % محاسن كلهن مسترق % 10(@)(@@) % منه وكل رآه فاغتفره % % سخاه عن رزء ذاك أن له % % PageV01P1768 11(@)(@@) % حسنا إذا قاسه به غمره % % وكل 
ms470	 رزء فأنه جلل % 12(@)(@@) % إذا المبقى لأهله كثره % % ياليت من عفوه لعاشقه % 13(@)(@@) % بل ذاك شيء عليه قد حظره % يصفح عن لصه جريمته % % 14(@)(@@) % وهو لنعماه أكفر الكفره % % ولست أنفك من معاتبة % 15(@)(@@) % بغير ذنب موازن وبره % % يا عجبا من معذبي عجبا % 16(@)(@@) % عجبي به ضعفه فقد هدره % % سوغ مانيل من حلاه ولو % % 17(@)(@@) % يسأله الصب قبلة نهره % % كما أجاع الوشاح حين ترد % 18(@)(@@) % داه وقد كظ مئزرا وزره % % بالله يا إخوتي سألتكم % % 19(@)(@@) % أليس مولاي أجور الجورة % % أضحى وسيف العداء في يده % 20(@)(@@) % علي دون الأنام قد شهره % % إن عض خلخاله مخلخله % PageV01P1769 21(@)(@@) % أو شف عقد الإزار مؤتزره % % أقبل ظلما علي يشتمني % % 22(@)(@@) % كأنني كل واتر وتره % % وقد رأى شيبةفأنكرها % % 23(@)(@@) % وتلك من فعله لو اعتبره % % شيبني من هواه ما نهك ال % % 24(@)(@@) % جسم فماذا ترونه نكره % % ألم ترعه محاسن نحلت % 25(@)(@@) % وراعه أن تنكرت شعره % % أبصر بيضاء في القذال فلا % % 26(@)(@@) % نفر كنفر رأيته نفره % % أعجب بمن يقتل الرجال وإن % % 27(@)(@@) % لاح له شخص شيبة ذعره % % لا يظلمني ولا سنى ولا % % 28(@)(@@) % يظلم خلاخيله ولا أزره % % فرب شيب بعاشق وبلى % 29(@)(@@) % قد برأ الله منهما كبره % ما شيبت رأسه السنون ولا % % 30(@)(@@) % أبلته بل حر وجده صهره % % ورب ضيق بملبس وهو الس % PageV01P1770 31(@)(@@) % سابغ لكن قرنه قهره % % قد أوسع الحجل والإزار له % 32(@)(@@) % فزاد ما ضمنا على الحزره % % ومن تعديه أنه أبدا % 33(@)(@@) % يعتد نفعا لعبده ضرره % % يعتد ما يعمد الشقي به % 34(@)(@@) % نيلا ولم يعد نفعه بصره % % فإن رأى في المنام هفوته % 35(@)(@@) % غض من الطرف عنه أو شزره % % يعتد إبداءه محاسنه % 36(@)(@@) % نيلا لحران هيجت حسره % % إذا نهت عن هواه غلظته % 37(@)(@@) % دعا إليه برقة البشره % % ولحظ عينين لو أدارهما % % 38(@)(@@) % لفارس في سلاحه أسره % % نضوى سقام يقود ضعفهما % % 39(@)(@@) % له شداد القلوب مقتسره % % من خنث جفنيهما وغنجهما % % 40(@)(@@) % تعلم السحر ماهر السحره % % ومضحك واضح به شنب % PageV01P1771 41(@)(@@) % يعرف من شام برقة مطره % % يضمن للعين طيب 
ms471	 ريقته % 42(@)(@@) % ثغر يباري نقاؤه أشره % % ينعت لألاؤه عذوبته % 43(@)(@@) % وليس يخفى نسيمه خصره % % لو ضاحك المزن عنه ضاحكه % 44(@)(@@) % عن برقه مسبلا له درره % % وصحن خد حريقه ضرم % % 45(@)(@@) % يقذف في القلب دائما شرره % % لا ماء إلا رضاب صاحبه % 46(@)(@@) % يطفىء عن قلب ناظر سعره % % أعاره الورد حسن صبغته % % 47(@)(@@) % بل صبغة الورد منه معتصره % % وفاحم وارد يقبل مم % % 48(@)(@@) % شاه إذا اختال مسبلا عذره % أقبل كالليل من مفارقه % 49(@)(@@) % منحدرا لا تذم منحدره % % حتى تناهى إلى مواطئه % 50(@)(@@) % يلثم من كل موطىء عفره % % كأنه عاشق دنا شغفا % PageV01P1772 51(@)(@@) % حتى قضى من حبيبه وطره % % تغشى غواشي قرونه قدما % 52(@)(@@) % بيضاء للناظرين مقتدره % % مثل الثريا إذا بدت سحرا % 53(@)(@@) % بعد غمام حاسر حسره % % وجيد إبريق فضة دأب الص % 54(@)(@@) % صواغ حتى اصطفى له نقره % % يتخذ الحلى كالنميمة لاالز % 55(@)(@@) % زينة من حسنه الذي جهره % % وحسن قد أجاد قادره % 56(@)(@@) % قدرا فما مده ولا قصره % % عدل حتى كأنه غصن % 57(@)(@@) % من خير ما أنجبت به شجره % يحمل ثديين خف ثقلهما % % 58(@)(@@) % جدا فلا آده ولا اهتصره % % محاسن الناس من محاسنه % % 59(@)(@@) % منسوخة في الحسان مختصره % % كأنما الله حين صوره % 60(@)(@@) % خيره دون خلقه صوره % % أغيد لم يرتع الخلاء ولا % % PageV01P1773 61(@)(@@) % خالط غزلانه ولا بقره % % يكفيه رعي الخلاء أن له % % 62(@)(@@) % من كل قلب ممنع ثمره % % كم من شفيق علي ظلمه % 63(@)(@@) % ولو رأى حسن وجهه عذره % % وناصر لي عليه لو هتفت % 64(@)(@@) % به دواعيه مرة نصره % % دع ذكره إن ذكره شعف % 65(@)(@@) % وامنح من المدح سالما غرره % % الواحد الماجد الذي عدم ال % % 66(@)(@@) % مثل فلم يلق ماجدا عشره % % الوارث المجد كل أصيد لا % % 67(@)(@@) % يدفع تيجانه ولا سرره % % القائل الفاعل الموارع لا % % 68(@)(@@) % يشكو العلى بخله ولا حصره % % ذا المستقى الطيب القريب وذا ال % % 69(@)(@@) % غور الذي لا تناله المكره % % المانح السائل الرغائب وال % % 70(@)(@@) % غائل مسبار كل من سبره % % ذا المرة الشزر والمتانة وال % % PageV01P1774 71(@)(@@) % عقدة تحت السجية اليسره % % ذا 
ms472	 اللين سائل به الملاين والش % 72(@)(@@) % شدة سائل به من اعتسره % % الآخذ الخطة الرضية والت % 73(@)(@@) % تارك ما الحظ فيه أن يذره % % ذا الكرم العذب والمناكرة المر % 74(@)(@@) % رة إن هاج هائج وغره % ما ذاق شهدا أجل ولا صبرا % 75(@)(@@) % من لم يذق شهده ولا صبره % % الأسد المستعد منذ درى % % 76(@)(@@) % أن الزبى للأسود محتفره % % العارض المستهل منذ رأى % % 77(@)(@@) % أن العلى في الكرام مبتدره % % الراجح العف في كتابته % % 78(@)(@@) % إذ في سواه نقيصة وشره % % يرى مكان البعيد من دغل ال % % 79(@)(@@) % مدغل والمستسر في الحجره % % أحاط علما بكل خافية % 80(@)(@@) % كأنما الأرض في يديه كره % % مه . لا تعدن من ينابذه % PageV01P1775 81(@)(@@) % له عداة وعدهم جزره % % كلا ولا طالبي فواضله % 82(@)(@@) % له عفاة وعدهم نفره % % ورائم رامه فقلت له % % 83(@)(@@) % حاولت من لا تنال مفتخره % % طاولت من لا أراك منتصفا % 84(@)(@@) % باعك من شبره إذا شبره % % أصور نحو العلى ترى أبدا % 85(@)(@@) % إلى نواحي وجوهها صوره % % أزور عن وجه كل فاحشة % 86(@)(@@) % لا يعدم الفحش كله زوره % % لو أعرض البحر دون مكرمة % 87(@)(@@) % وليس للبحر معبر ضبره % % مظفر بالتي يحاولها % % 88(@)(@@) % لا يعدم الله سالما ظفره % % فيه وقار يكف سورته % % 89(@)(@@) % وفيه حد يعز منتصره % % شاوره في الرأي إن أثرت ولا % % 90(@)(@@) % يرمك بالرأي إنه فطره % % ذاك الذي قال فيه مادحه % PageV01P1776 91(@)(@@) % مهما انتحى من رمية فقره % % سر بهدى كوكب هداك به % % 92(@)(@@) % ولا تعرض لكوكب كدره % % قد آمن الله من يخاف من ال % % 93(@)(@@) % فقر إذا جود سالم خفره % % يا رب شاك إليه خلته % 94(@)(@@) % راح بجدواه يشتكي بطره % % يسبق معروفه العدات وإن % % 95(@)(@@) % قدم وعدا حسبته نذره % % لا يعرض القوم عن ثناه ولا % % 96(@)(@@) % يمل سمار ذكره سمره % % من مبلغ صفوة الأمير أبي ال % % 97(@)(@@) % عباس عن كل حامد أثره % % أن قد تولى الزمام صاحبه % 98(@)(@@) % بحكمة أحكمت له مرره % % فقاد مستصعب الأمور به % 99(@)(@@) % لا خائفا ضعفه ولا قصره % % وليت لا مائلا إلى دنس % 100(@)(@@) % عمدا ولا 
ms473	 عاثرا مع العثرة % % هو القوي الأمين فارم به % PageV01P1777 101(@)(@@) % ما شئت من معضل يكن حجره % % لا يشتكي الناس عنفه وكذا % % 102(@)(@@) % لا تشتكي ضعفه ولا خوره % % أجريته والكفاة في طلق % % 103(@)(@@) % فجاء لم تغش وجهه قتره % % تلوح فوق الجبين غرته % 104(@)(@@) % كأنها المشتري أو الزهرة % % وجاء أصحابه وكلهم % 105(@)(@@) % قد كظه جهده وقد بهره % % لم يلحقوا شأوه ولو فعلوا % % 106(@)(@@) % أمكن أن يسبق امرؤ قدره % % ولم يزل يسبق الرجال ولا % % 107(@)(@@) % يشق ذو جهدهم له غبره % % حتى أقروا وقال قائلهم % 108(@)(@@) % محرم الحول سابق صفره % واتخذوا الصدق زينة لهم % 109(@)(@@) % كرها على رغمهم وهم صغره % % وكان زينا لكل من نفر الس % 110(@)(@@) % ؤدد إقراره لمن نفره % % ومن أبي الصدق بعدما قمر ال % % PageV01P1778 111(@)(@@) % فضل فمن كل جانب قمره % % أسخط حساده وأرغمهم % 112(@)(@@) % أن سار في الناس فارتضوا سيره % % يا حاسدي سالم أبي حسن % % 113(@)(@@) % مجدا كساه قعاله حبره % % إن يرتد الحمد سالم رجلا % 114(@)(@@) % فإنه قبل حلمه ائتزره % % مازال يكساه قبل بغيته % 115(@)(@@) % إياه بل قبل خلقه بدره % % مدخرا في أب له فأب % 116(@)(@@) % كانت له الصالحات مدخره % % ثم سعى بعد ذاك مكتسبا % 117(@)(@@) % للمجد حتى ارتداه واعتجره % % يا رب عرف أتاه ما طلب ال % % 118(@)(@@) % حمد بإتيانه ولا خسره % % نوى بإسدائه رضا ملك % % 119(@)(@@) % نفله الحمد بعدما أجره % % وتاجر البر لا يزال له % % 120(@)(@@) % ربحان في كل متجر تجره % % أجر وحمد وإنما قصد ال % % PageV01P1779 121(@)(@@) % أجر ولكن كلاهما اعتوره % % كصاحب البذر لا يريد به % % 122(@)(@@) % شيئا سوى ريعه إذا بذره % % وهو إذا لقي السلامة لا % % 123(@)(@@) % يعدم لا ريعه ولا خضره % % كم سرني حين ساءني زمن % 124(@)(@@) % كم برني حين عقني البررة % % يا سالم الخير يا أبا حسن % 125(@)(@@) % يا من وجدنا كوجهه خبره % % يا حسن الوجه والشمائل إن % % 126(@)(@@) % ردد فيه مردد نظره % % يا حسن الهدي والخلائق إن % % 127(@)(@@) % كرر فيه مكرر فكره % % ماذا على من يراك في بلد % 128(@)(@@) % أن لا يرى شمسه ولا قمره % % وما على 
ms474	 من يراك في زمن % 129(@)(@@) % أن لا يرى نوره ولا زهره % % أنت السراج المنير والكلأ ال % % 130(@)(@@) % ممرع حفت رياضه غدره % % لكل قوم يعد مجدهم % PageV01P1780 131(@)(@@) % آصال مجد سهمتهم بكره % % لاتحمدني فما جرى قلمي % % 132(@)(@@) % إلا بأشياء منك مختبره % % ما زدت فيما وصفت منك على % % 133(@)(@@) % ما حصلته صحائف البرره % % لم أبتدع في ثنائك الحسن ال % % 134(@)(@@) % منشر بل كنت بعض من نشره % % لكنني أنظم الثناء إذا % % 135(@)(@@) % مثني ثناء على امرىء نثره % % وما لمثن على أخي كرم % 136(@)(@@) % حمد ولكنه لمن فطره % % كم فيك من مدحة تظل على % % 137(@)(@@) % ألسنة المنشدين معتوره % % واسعد ببيت بنيته أفد % 138(@)(@@) % أسس بنيانه على الخيره % % أيد بالساج والحديد ولم % % 139(@)(@@) % يوهن بآجرة ولا مدره % % بناء حزم أبى لصاحبه % % 140(@)(@@) % في كل أمر ركوبه غرره % % لايعرف الوهي والسقوط ولا % % PageV01P1781 141(@)(@@) % يخذل ألواح ساجه دسره % % وخسير بيت بنيت مشتبه % 142(@)(@@) % وفق ترى مثل سقفه جدره % أسمر ما شاب لونه برص ال % % 143(@)(@@) % جص ولا مس جلده وضره % % هندسه رأيك المبرز في ال % % 144(@)(@@) % فضل وأعطته حقه النجره % % وعل من بعد ذاك بالذهب ال % % 145(@)(@@) % أحمر فاختال لابسا شهره % % أهدى لك الدهر فيه حبرته % % 146(@)(@@) % ولا أرى ناظرا به عبره % % تعمره بالنعيم والنعم الس % 147(@)(@@) % سبغ ملبوسة ومنتظره % % قرير عين قرين مغبطة % 148(@)(@@) % تفتض من كل منعم عذره % % يسمعك الشدو في جوانبه % 149(@)(@@) % مناغيات البموم والزيره % % في كل يوم تراه بكرته % 150(@)(@@) % وكل ليل تخاله سحره % % كلاهما لا يزال قاطعه % PageV01P1782 151(@)(@@) % يدعو بسقياه كل ما ادكره % % زلال بر يظل يسكنه % % 152(@)(@@) % بحر بحور يهل من عبره % % بل بيت بر تظل كعبته % 153(@)(@@) % محجوجة للنوال معتمره % % تغشاك فيه عفاة نائلك ال % % 154(@)(@@) % غمر فيمتار منفض ميره % % لا الجار يستبطىء الجوار ولا % % 155(@)(@@) % يلعن من جاء نازعا سفره % % كعادة لم تزل لكل أب % % 156(@)(@@) % ينميك تغشى عفاته حجره % % لا يشتري المال بالثناء ولا % % 157(@)(@@) % تظل تفدي صراره بدره % % يجوز معروفه الغنى ومنى الن % % 158(@)(@@) % نفس ويلقاك ملقيا عذره 
ms475	 % أهدى لك المدح فيه خادمك الس % 159(@)(@@) % سابق من أهل بيعة السمره % أول كتابك افتتحت به % % 160(@)(@@) % أمرك ثم ارتضيت مختبره % % أهدى بنيات نفسه ولو اس % % PageV01P1783 161(@)(@@) % طاع لأهدى مكانها عمره % لا أوحش المجد يا بني عمر % % 162(@)(@@) % منكم فأنتم أجل من عمره % وعشتم في لبوس عافية % 163(@)(@@) % يقاتل الدهر عنكم غيره % دونكها حلة محبرة % 164(@)(@@) % تطرف من كل حاسد بصره % % زينة فخر إذا تلبسها % % 165(@)(@@) % سيد قوم لفاخر فخره % % جنة حرز إذا تدرعها % % 166(@)(@@) % لقائل الهجر نهنهت ظفره % % قصيرة البيت وهي سابغة % 167(@)(@@) % على هوى السامعين مقتدره نم راجع من بعد سلوة ذكره % وواصل الظبي بعدما هجره % 168(@)(@@) % ظبي دعا قلب هائم كلف % مؤتمر قلبه بما أمره % % 169(@)(@@) % يؤنسه حسنه ويوحشه % قبح أفاعيله إذا ذكره % % 170(@)(@@) % مازال يدعوه من محاسنه % داع إذا سوء فعله زجره % % PageV01P1784 171(@)(@@) % لا الوصل يصفو له وإن عزم ال % % هجران غال النزاع مصطبره % % 172(@)(@@) % يدنو فيقصى فإن نأى أنفا % بات يباري بكاؤه سهره % % 173(@)(@@) % ألقاه في حيرة محيرة % فما يرى ورده ولا صدره % 174(@)(@@) % ظبي وما الظبي بالشبيه به % % في الحسن إلا استراقه حوره % % 175(@)(@@) % وحسن أجياده وغنته % ونفرة فيه من رقى الفجره % % 176(@)(@@) % محاسن كلهن مسترق % منه وكل رآه فاغتفره % % 177(@)(@@) % سخاه عن رزء ذاك أن له % % حسنا إذا قاسه به غمره % % 178(@)(@@) % وكل رزء فأنه جلل % إذا المبقى لأهله كثره % % 179(@)(@@) % ياليت من عفوه لعاشقه % بل ذاك شيء عليه قد حظره % 180(@)(@@) % يصفح عن لصه جريمته % % وهو لنعماه أكفر الكفره % % PageV01P1785 181(@)(@@) % ولست أنفك من معاتبة % بغير ذنب موازن وبره % % 182(@)(@@) % يا عجبا من معذبي عجبا % عجبي به ضعفه فقد هدره % % 183(@)(@@) % سوغ مانيل من حلاه ولو % % يسأله الصب قبلة نهره % % 184(@)(@@) % كما أجاع الوشاح حين ترد % داه وقد كظ مئزرا وزره % % 185(@)(@@) % بالله يا إخوتي سألتكم % % أليس مولاي أجور الجورة % % 186(@)(@@) % أضحى وسيف العداء في يده % علي دون الأنام قد شهره % % 187(@)(@@) % إن عض خلخاله مخلخله % أو شف عقد الإزار مؤتزره % % 188(@)(@@) % أقبل 
ms476	 ظلما علي يشتمني % % كأنني كل واتر وتره % % 189(@)(@@) % وقد رأى شيبةفأنكرها % % وتلك من فعله لو اعتبره % % 190(@)(@@) % شيبني من هواه ما نهك ال % % جسم فماذا ترونه نكره % % PageV01P1786 191(@)(@@) % ألم ترعه محاسن نحلت % وراعه أن تنكرت شعره % % 192(@)(@@) % أبصر بيضاء في القذال فلا % % نفر كنفر رأيته نفره % % 193(@)(@@) % أعجب بمن يقتل الرجال وإن % % لاح له شخص شيبة ذعره % % 194(@)(@@) % لا يظلمني ولا سنى ولا % % يظلم خلاخيله ولا أزره % % 195(@)(@@) % فرب شيب بعاشق وبلى % قد برأ الله منهما كبره % 196(@)(@@) % ما شيبت رأسه السنون ولا % % أبلته بل حر وجده صهره % % 197(@)(@@) % ورب ضيق بملبس وهو الس % سابغ لكن قرنه قهره % % 198(@)(@@) % قد أوسع الحجل والإزار له % فزاد ما ضمنا على الحزره % % 199(@)(@@) % ومن تعديه أنه أبدا % يعتد نفعا لعبده ضرره % % 200(@)(@@) % يعتد ما يعمد الشقي به % نيلا ولم يعد نفعه بصره % % PageV01P1787 201(@)(@@) % فإن رأى في المنام هفوته % غض من الطرف عنه أو شزره % % 202(@)(@@) % يعتد إبداءه محاسنه % نيلا لحران هيجت حسره % % 203(@)(@@) % إذا نهت عن هواه غلظته % دعا إليه برقة البشره % % 204(@)(@@) % ولحظ عينين لو أدارهما % % لفارس في سلاحه أسره % % 205(@)(@@) % نضوى سقام يقود ضعفهما % % له شداد القلوب مقتسره % % 206(@)(@@) % من خنث جفنيهما وغنجهما % % تعلم السحر ماهر السحره % % 207(@)(@@) % ومضحك واضح به شنب % يعرف من شام برقة مطره % % 208(@)(@@) % يضمن للعين طيب ريقته % ثغر يباري نقاؤه أشره % % 209(@)(@@) % ينعت لألاؤه عذوبته % وليس يخفى نسيمه خصره % % 210(@)(@@) % لو ضاحك المزن عنه ضاحكه % عن برقه مسبلا له درره % % PageV01P1788 211(@)(@@) % وصحن خد حريقه ضرم % % يقذف في القلب دائما شرره % % 212(@)(@@) % لا ماء إلا رضاب صاحبه % يطفىء عن قلب ناظر سعره % % 213(@)(@@) % أعاره الورد حسن صبغته % % بل صبغة الورد منه معتصره % % 214(@)(@@) % وفاحم وارد يقبل مم % % شاه إذا اختال مسبلا عذره % 215(@)(@@) % أقبل كالليل من مفارقه % منحدرا لا تذم منحدره % % 216(@)(@@) % حتى تناهى إلى مواطئه % يلثم من كل موطىء عفره % % 217(@)(@@) % كأنه عاشق دنا شغفا % حتى قضى من حبيبه وطره % % 218(@)(@@) % تغشى غواشي قرونه قدما % بيضاء 
ms477	 للناظرين مقتدره % % 219(@)(@@) % مثل الثريا إذا بدت سحرا % بعد غمام حاسر حسره % % 220(@)(@@) % وجيد إبريق فضة دأب الص % صواغ حتى اصطفى له نقره % % PageV01P1789 221(@)(@@) % يتخذ الحلى كالنميمة لاالز % زينة من حسنه الذي جهره % % 222(@)(@@) % وحسن قد أجاد قادره % قدرا فما مده ولا قصره % % 223(@)(@@) % عدل حتى كأنه غصن % من خير ما أنجبت به شجره % 224(@)(@@) % يحمل ثديين خف ثقلهما % % جدا فلا آده ولا اهتصره % % 225(@)(@@) % محاسن الناس من محاسنه % % منسوخة في الحسان مختصره % % 226(@)(@@) % كأنما الله حين صوره % خيره دون خلقه صوره % % 227(@)(@@) % أغيد لم يرتع الخلاء ولا % % خالط غزلانه ولا بقره % % 228(@)(@@) % يكفيه رعي الخلاء أن له % % من كل قلب ممنع ثمره % % 229(@)(@@) % كم من شفيق علي ظلمه % ولو رأى حسن وجهه عذره % % 230(@)(@@) % وناصر لي عليه لو هتفت % به دواعيه مرة نصره % % PageV01P1790 231(@)(@@) % دع ذكره إن ذكره شعف % وامنح من المدح سالما غرره % % 232(@)(@@) % الواحد الماجد الذي عدم ال % % مثل فلم يلق ماجدا عشره % % 233(@)(@@) % الوارث المجد كل أصيد لا % % يدفع تيجانه ولا سرره % % 234(@)(@@) % القائل الفاعل الموارع لا % % يشكو العلى بخله ولا حصره % % 235(@)(@@) % ذا المستقى الطيب القريب وذا ال % % غور الذي لا تناله المكره % % 236(@)(@@) % المانح السائل الرغائب وال % % غائل مسبار كل من سبره % % 237(@)(@@) % ذا المرة الشزر والمتانة وال % % عقدة تحت السجية اليسره % % 238(@)(@@) % ذا اللين سائل به الملاين والش % شدة سائل به من اعتسره % % 239(@)(@@) % الآخذ الخطة الرضية والت % تارك ما الحظ فيه أن يذره % % 240(@)(@@) % ذا الكرم العذب والمناكرة المر % رة إن هاج هائج وغره % PageV01P1791 241(@)(@@) % ما ذاق شهدا أجل ولا صبرا % من لم يذق شهده ولا صبره % % 242(@)(@@) % الأسد المستعد منذ درى % % أن الزبى للأسود محتفره % % 243(@)(@@) % العارض المستهل منذ رأى % % أن العلى في الكرام مبتدره % % 244(@)(@@) % الراجح العف في كتابته % % إذ في سواه نقيصة وشره % % 245(@)(@@) % يرى مكان البعيد من دغل ال % % مدغل والمستسر في الحجره % % 246(@)(@@) % أحاط علما بكل خافية % كأنما الأرض في يديه كره % % 247(@)(@@) % مه . لا تعدن من 
ms478	 ينابذه % له عداة وعدهم جزره % % 248(@)(@@) % كلا ولا طالبي فواضله % له عفاة وعدهم نفره % % 249(@)(@@) % ورائم رامه فقلت له % % حاولت من لا تنال مفتخره % % 250(@)(@@) % طاولت من لا أراك منتصفا % باعك من شبره إذا شبره % % PageV01P1792 251(@)(@@) % أصور نحو العلى ترى أبدا % إلى نواحي وجوهها صوره % % 252(@)(@@) % أزور عن وجه كل فاحشة % لا يعدم الفحش كله زوره % % 253(@)(@@) % لو أعرض البحر دون مكرمة % وليس للبحر معبر ضبره % % 254(@)(@@) % مظفر بالتي يحاولها % % لا يعدم الله سالما ظفره % % 255(@)(@@) % فيه وقار يكف سورته % % وفيه حد يعز منتصره % % 256(@)(@@) % شاوره في الرأي إن أثرت ولا % % يرمك بالرأي إنه فطره % % 257(@)(@@) % ذاك الذي قال فيه مادحه % مهما انتحى من رمية فقره % % 258(@)(@@) % سر بهدى كوكب هداك به % % ولا تعرض لكوكب كدره % % 259(@)(@@) % قد آمن الله من يخاف من ال % % فقر إذا جود سالم خفره % % 260(@)(@@) % يا رب شاك إليه خلته % راح بجدواه يشتكي بطره % % PageV01P1793 261(@)(@@) % يسبق معروفه العدات وإن % % قدم وعدا حسبته نذره % % 262(@)(@@) % لا يعرض القوم عن ثناه ولا % % يمل سمار ذكره سمره % % 263(@)(@@) % من مبلغ صفوة الأمير أبي ال % % عباس عن كل حامد أثره % % 264(@)(@@) % أن قد تولى الزمام صاحبه % بحكمة أحكمت له مرره % % 265(@)(@@) % فقاد مستصعب الأمور به % لا خائفا ضعفه ولا قصره % % 266(@)(@@) % وليت لا مائلا إلى دنس % عمدا ولا عاثرا مع العثرة % % 267(@)(@@) % هو القوي الأمين فارم به % ما شئت من معضل يكن حجره % % 268(@)(@@) % لا يشتكي الناس عنفه وكذا % % لا تشتكي ضعفه ولا خوره % % 269(@)(@@) % أجريته والكفاة في طلق % % فجاء لم تغش وجهه قتره % % 270(@)(@@) % تلوح فوق الجبين غرته % كأنها المشتري أو الزهرة % % PageV01P1794 271(@)(@@) % وجاء أصحابه وكلهم % قد كظه جهده وقد بهره % % 272(@)(@@) % لم يلحقوا شأوه ولو فعلوا % % أمكن أن يسبق امرؤ قدره % % 273(@)(@@) % ولم يزل يسبق الرجال ولا % % يشق ذو جهدهم له غبره % % 274(@)(@@) % حتى أقروا وقال قائلهم % محرم الحول سابق صفره % 275(@)(@@) % واتخذوا الصدق زينة لهم % كرها على رغمهم وهم صغره % % 276(@)(@@) % وكان زينا لكل من نفر 
ms479	 الس % ؤدد إقراره لمن نفره % % 277(@)(@@) % ومن أبا الصدق بعدما قمر ال % % فضل فمن كل جانب قمره % % 278(@)(@@) % أسخط حساده وأرغمهم % أن سار في الناس فارتضوا سيره % % 279(@)(@@) % يا حاسدي سالم أبي حسن % % مجدا كساه قعاله حبره % % 280(@)(@@) % إن يرتد الحمد سالم رجلا % فإنه قبل حلمه ائتزره % % PageV01P1795 281(@)(@@) % مازال يكساه قبل بغيته % إياه بل قبل خلقه بدره % % 282(@)(@@) % مدخرا في أب له فأب % كانت له الصالحات مدخره % % 283(@)(@@) % ثم سعى بعد ذاك مكتسبا % للمجد حتى ارتداه واعتجره % % 284(@)(@@) % يا رب عرف أتاه ما طلب ال % % حمد بإتيانه ولا خسره % % 285(@)(@@) % نوى بإسدائه رضا ملك % % نفله الحمد بعدما أجره % % 286(@)(@@) % وتاجر البر لا يزال له % % ربحان في كل متجر تجره % % 287(@)(@@) % أجر وحمد وإنما قصد ال % % أجر ولكن كلاهما اعتوره % % 288(@)(@@) % كصاحب البذر لا يريد به % % شيئا سوى ريعه إذا بذره % % 289(@)(@@) % وهو إذا لقي السلامة لا % % يعدم لا ريعه ولا خضره % % 290(@)(@@) % كم سرني حين ساءني زمن % كم برني حين عقني البررة % % PageV01P1796 291(@)(@@) % يا سالم الخير يا أبا حسن % يا من وجدنا كوجهه خبره % % 292(@)(@@) % يا حسن الوجه والشمائل إن % % ردد فيه مردد نظره % % 293(@)(@@) % يا حسن الهدي والخلائق إن % % كرر فيه مكرر فكره % % 294(@)(@@) % ماذا على من يراك في بلد % أن لا يرى شمسه ولا قمره % % 295(@)(@@) % وما على من يراك في زمن % أن لا يرى نوره ولا زهره % % 296(@)(@@) % أنت السراج المنير والكلأ ال % % ممرع حفت رياضه غدره % % 297(@)(@@) % لكل قوم يعد مجدهم % آصال مجد سهمتهم بكره % % 298(@)(@@) % لاتحمدني فما جرى قلمي % % إلا بأشياء منك مختبره % % 299(@)(@@) % ما زدت فيما وصفت منك على % % ما حصلته صحائف البرره % % 300(@)(@@) % لم أبتدع في ثنائك الحسن ال % % منشر بل كنت بعض من نشره % % PageV01P1797 301(@)(@@) % لكنني أنظم الثناء إذا % % مثني ثناء على امرىء نثره % % 302(@)(@@) % وما لمثن على أخي كرم % حمد ولكنه لمن فطره % % 303(@)(@@) % كم فيك من مدحة تظل على % % ألسنة المنشدين معتوره % % 304(@)(@@) % واسعد ببيت بنيته أفد % أسس بنيانه على 
ms480	 الخيره % % 305(@)(@@) % أيد بالساج والحديد ولم % % يوهن بآجرة ولا مدره % % 306(@)(@@) % بناء حزم أبى لصاحبه % % في كل أمر ركوبه غرره % % 307(@)(@@) % لايعرف الوهي والسقوط ولا % % يخذل ألواح ساجه دسره % % 308(@)(@@) % وخسير بيت بنيت مشتبه % وفق ترى مثل سقفه جدره % 309(@)(@@) % أسمر ما شاب لونه برص ال % % جص ولا مس جلده وضره % % 310(@)(@@) % هندسه رأيك المبرز في ال % % فضل وأعطته حقه النجره % % PageV01P1798 311(@)(@@) % وعل من بعد ذاك بالذهب ال % % أحمر فاختال لابسا شهره % % 312(@)(@@) % أهدى لك الدهر فيه حبرته % % ولا أرى ناظرا به عبره % % 313(@)(@@) % تعمره بالنعيم والنعم الس % سبغ ملبوسة ومنتظره % % 314(@)(@@) % قرير عين قرين مغبطة % تفتض من كل منعم عذره % % 315(@)(@@) % يسمعك الشدو في جوانبه % مناغيات البموم والزيره % % 316(@)(@@) % في كل يوم تراه بكرته % وكل ليل تخاله سحره % % 317(@)(@@) % كلاهما لا يزال قاطعه % يدعو بسقياه كل ما ادكره % % 318(@)(@@) % زلال بر يظل يسكنه % % بحر بحور يهل من عبره % % 319(@)(@@) % بل بيت بر تظل كعبته % محجوجة للنوال معتمره % % 320(@)(@@) % تغشاك فيه عفاة نائلك ال % % غمر فيمتار منفض ميره % % PageV01P1799 321(@)(@@) % لا الجار يستبطىء الجوار ولا % % يلعن من جاء نازعا سفره % % 322(@)(@@) % كعادة لم تزل لكل أب % % ينميك تغشى عفاته حجره % % 323(@)(@@) % لا يشتري المال بالثناء ولا % % تظل تفدي صراره بدره % % 324(@)(@@) % يجوز معروفه الغنى ومنى الن % % نفس ويلقاك ملقيا عذره % 325(@)(@@) % أهدى لك المدح فيه خادمك الس % سابق من أهل بيعة السمره % 326(@)(@@) % أول كتابك افتتحت به % % أمرك ثم ارتضيت مختبره % % 327(@)(@@) % أهدى بنيات نفسه ولو اس % % طاع لأهدى مكانها عمره % 328(@)(@@) % لا أوحش المجد يا بني عمر % % منكم فأنتم أجل من عمره % 329(@)(@@) % وعشتم في لبوس عافية % يقاتل الدهر عنكم غيره % 330(@)(@@) % دونكها حلة محبرة % تطرف من كل حاسد بصره % % PageV01P1800 331(@)(@@) % زينة فخر إذا تلبسها % % سيد قوم لفاخر فخره % % 332(@)(@@) % جنة حرز إذا تدرعها % % لقائل الهجر نهنهت ظفره % % 333(@)(@@) % قصيرة البيت وهي سابغة % على هوى السامعين مقتدرهه % % 334(@)(@@) % كيومك الأريحي قصره % % ربك في عمرك الذي وفره % % 335(@)(@@) % طالت فألوى بطولها 