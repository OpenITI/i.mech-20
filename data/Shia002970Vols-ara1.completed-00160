ms141	 مالك وجعفر بن محمد بن مالك.(@)(@@)(@@)(@@) $ 1314 - أبو عبد الله الوجناء، يأتي في آخر الكتاب، وجعله " طس " أبا محمد، أقول: مر في المقدمة الثانية أيضا أنه أبو محمد، كذا في المنتهى. أقول: يأتي في باب PageV01P218(@)(@@) الفوائد أنه من أهل نصيبين وممن وقف على معجزته عليه السلام.(@)(@@)(@@)(@@) $ 1315 - أبو عبد الله بن هارون وكيل " صه " أي: وكيل الناحية، ويأتي في التالية ما ينبغي أن يلاحظ.(@)(@@)(@@)(@@) $ 1316 - أبو علي الأشعري أحمد بن إدريس ومحمد بن عيسى بن عبيد ويأتي لغيرهما، ويعرف بالمرتبة والثاني في التالية، وفي " تعق " الأكثر اطلاقه على الأول.(@)(@@)(@@)(@@) $ 1317 - أبو عمرو الفائدي بالفاء والمثناة من تحت بعد الألف والمهملة أحمد بن علي القزويني.(@)(@@)(@@)(@@) $ 1318 - أبو الفضل السمرقندي جعفر بن معروف، يروي عنه العياشي، وليس هو ابن معروف المتقدم إليه الإشارة في السابقة.(@)(@@)(@@)(@@) $ 1319 - أبو القاسم الأشعري القمي سعد بن عبد الله.(@)(@@)(@@)(@@) $ 1320 - أبو القاسم البلخي نصر بن الصباح، ويأتي لأبي القاسم البلخي الذي كان من مشايخ المعتزلة وشيخ ابن قبة محمد، وأكثر من النقل عنه، بل هو أعرف بالكنية دون الأول فإنه بالعكس وان كنى به أيضا.(@)(@@)(@@)(@@) $ 1321 - أبو القاسم الكوفي يقال لحميد بن زياد.(@)(@@)(@@)(@@) $ 1322 - أبو القاسم النحوي علي بن محمد بن رباح، واحتمال اتحاده مع ابن محمد بن علي بن عمر بن رباح، قد مضى في الترجمتين فتأمل.(@)(@@)(@@)(@@) $ 1323 - أبو القاسم النقار عبد الله بن طاهر مجمع عنه المنتهى، وقد مضى توصيفه بالثقاب والنقاد، وما هنا انما هو من " د " وغلط الثقاب واستصوبه فتأمل.(@)(@@)(@@)(@@) $ 1324 - أبو المثنى محمد بن الحسن بن علي " تعق ".(@)(@@)(@@)(@@) $ 1325 - أبو محمد القماص " غين " وهو الحسن بن علوية في المنتهى.(@)(@@)(@@)(@@) $ 1326 - أبو محمد الكشي، وهو جعفر بن معروف الآتي في التالية يروي " كش " عنه.(@)(@@)(@@)(@@) $ 1327 - أبو محمد الوجناء، مر في أبي عبد الله، ويأتي في آخر الكتاب أنه من سفراء الصاحب عليه السلام وأبوابه المعروفين الذين لا تختلف الامامية فيهم " تعق " PageV01P219(@)(@@) وفي المنتهى ذكرناه في المقدمة الأولى بعنوان الحسن بن الوجناء. أقول: يعني 
ms142	 في الثانية.(@)(@@)(@@)(@@) $ 1328 - أبو محمد بن هارون " غين " ومضيي في المقدمة الأولى في المنتهى.(@)(@@) أقول: وهذا سهو من قلمه كما وقع في نظائره، فإنهم في الثانية لا الأولى فلاحظ.(@)(@@)(@@)(@@) $ 1329 - أبو محمد الوراق طاهر بن عيسى مجمع في المنتهى، قلت: يروي عنه " كش ".(@)(@@)(@@)(@@) $ 1330 - أبو نصر بن يحيى الفقيه هو أحمد، ثقة خير فاضل كان يفتي العامة بفتياهم والحشوية بفتياهم والشيعة بفتياهم " صه " إلا وهو احمد وزاد من أهل سمرقند بعد الفقيه، وقد مر في السابقة.(@)(@@)(@@)(@@) $ 1331 - أبو نضر محمد بن مسعود الثقة الجليل " غين " في المنتهى. أقول: وهو المرمز في أكثر الرجال ب‍ " معد " أستاذ الكشي. * * * PageV01P220(@)(@@)(@@)(@@) || الطبقة الرابعة والعشرون(@)(@@)(@@)(@@) $ 1332 - إبراهيم بن أبي حفص أبو إسحاق الكاتب، شيخ من أصحاب " ري " عليه السلام ثقة وجيه " ست " " جش " " صه ".(@)(@@)(@@)(@@) $ 1333 - إبراهيم بن إسحاق أبو إسحاق الأحمري النهاوندي، ضعيف " جش " " صه " " ست " " لم " كان ضعيفا في حديثه متهما في دينه وفي مذهبه ارتباع وأمره مخلط، لا أعتمد على شئ مما يرويه " صه " له كتب قريبة من السداد، عنه جماعة منهم الصفار.(@)(@@)(@@)(@@) $ 1334 - إبراهيم الأعجمي من أهل نهاوند، روى عنه البرقي أحمد " لم " " ست " كأنه ابن إسحاق الأحمري المتقدم، كما احتمله الميرزا ولكنه غير معلوم.(@)(@@)(@@)(@@) $ 1335 - إبراهيم بن الحكم بن ظهير الفزاري أبو إسحاق ابن صاحب التفسير عن السدي له كتب، عنه يحيى بن زكريا بن شيبان " جش " " ست " وكأنه في السابقة أيضا، إذ يروي عنه " عقد " والله أعلم.(@)(@@)(@@)(@@) $ 1336 - إبراهيم بن حضيب الأنباري " ري ".(@)(@@)(@@)(@@) $ 1337 - إبراهيم بن عبدة النيسابوري " دي " " ري " وفي " كش " حكاية عن بعض الثقات توقيعات يتضمن توكيله في بعض حقوقه عن مواليه والدعاء، وفي " صه " ذكر مضمون أحدها يدل على ثقته وجلالته.(@)(@@)(@@)(@@) $ 1338 - إبراهيم بن علي " ري " ذكره الميرزا كذا ثم قال في نسخة.(@)(@@)(@@)(@@) $ 1339 - إبراهيم بن علي الكوفي، راو مصنف زاهد عالم فطن بسمرقند، وكان نصر بن أحمد صاحب خراسان يكرمه ومن بعده من الملوك، لم يرو عنهم عليهم السلام " صه " " جخ " وكأنه في السابقة.(@)(@@)(@@)(@@) $ 1340 - إبراهيم 
ms143	 بن محمد الثقفي، وهو ابن محمد بن سعيد بن هلال الآتي، كما في تصريح الميرزا رحمه الله تعالى.(@)(@@)(@@)(@@) $ 1341 - إبراهيم بن محمد بن سعيد بن هلال أبو إسحاق الثقفي رضي الله PageV01P221(@)(@@) عنه، كوفي وانتقل إلى أصفهان، كان ثقة زيديا أولا ثم انتقل إلى القول بالإمامة وهو الثقة، ويقال: ان أحمد وغيره وفدوا إليه إلى آخره وسألوه الانتقال إلى قم فأبى.(@)(@@)(@@)(@@) $ 1342 - إبراهيم بن محمد بن فارس النيسابوري " دي " " ري " لا بأس به، كما في " صه " و " طس " " كش " عن " معد " ثقة في نفسه، ويظهر من الميرزا توثيقه.(@)(@@)(@@)(@@) $ 1343 - إبراهيم بن يزيد وأخوه أحمد بن يزيد " ري " ويأتي في أخيه مثله.(@)(@@) كان مكفوفا. ضعيف، يقال: إن في مذهبه ارتفاعا " جش " وزاد " صه " فلا أعمل بروايته.(@)(@@)(@@)(@@) $ 1344 - أحمد بن إبراهيم أبو حامد المراغي " ري " وفيه رواية تدل على مدحه عليه السلام إياه، فأبو حامد هذا مقبول الرواية غير ثابت الوثاقة.(@)(@@)(@@)(@@) $ 1345 - أحمد بن إبراهيم بن إسماعيل بن داود بن حمدون الكاتب القديم، شيخ أهل الفقه ووجههم، وكان خصيصا بأبي محمد " ري " و " دي " عليهما السلام لم ينص أحد بتوثيقه، إلا أن الخصاصية بهما عليهما السلام تفيده مع زيادة.(@)(@@)(@@)(@@) $ 1346 - أحمد بن أبي بشر السراج، كوفي مولى يكنى أبا جعفر، ثقة في الحديث واقف المذهب، روى عن موسى بن جعفر " جش " " صه " وفي " كش " ذموم كثيرة. وذكره في الحاوي في الموثقين، والصواب قبول روايته، عنه ابن سماعة.(@)(@@)(@@)(@@) $ 1347 - أحمد بن أبي زاهر، واسم أبي زاهر موسى أبو جعفر الأشعري القمي مولى، كان وجها بقم، وحديثه ليس بذلك النقي، وكان محمد بن يحيى العطار أخص أصحابه " صه " " ست " " جش " وهو أيضا كما لا يخفى في السابقة.(@)(@@)(@@)(@@) $ 1348 - أحمد بن أبي عبد الله البرقي، هو أحمد بن محمد بن خالد، ويأتي في ذلك العنوان إن شاء الله.(@)(@@)(@@)(@@) $ 1349 - أحمد بن أبي عوف يكنى أبا عوف، من أهل بخارا لا بأس به " صه " " لم " والظاهر أنه في هذه الطبقة.(@)(@@)(@@)(@@) $ 1350 - أحمد بن بشير البرقي وأحمد بن 
ms144	 الحسين بن سعيد، روى عنهما محمد بن أحمد بن يحيى " د " وكذا عن نسخة من " لم " وهو الصواب. وقيل: روى عنهما أحمد PageV01P222(@)(@@) بن محمد بن يحيى، وكلاهما ضعيفان بنص " ق ".(@)(@@)(@@)(@@) $ 1351 - أحمد بن بكر بن جناح أبو الحسين أو أبو الحسن، روى عنه حميد كتاب عبد الله بن بكير رواية ابن فضال، كما في التلخيص.(@)(@@)(@@)(@@) $ 1352 - أحمد بن الحسن الأسفرايني (1) أبو العباس المفسر الضرير، له كتاب المصابيح في ذكر ما نزل من القرآن في أهل البيت عليهم السلام، وهو كتاب حسن كثير الفوائد على ما في " جش " وقال " د ": انه أحمد بن اصفهبد، وقد تأمل فيه الميرزا.(@)(@@)(@@)(@@) $ 1353 - أحمد بن الحسن بن علي بن محمد بن فضال أبو عبد الله، وقيل: أبو الحسين ثقة غير أنه فطحي روى عنه أخوه علي بن الحسن وغيره من الكوفيين، مات سنة ستين ومائتين.(@)(@@)(@@)(@@) $ 1354 - أحمد بن الحسن القزاز، وفي " د " ابن الحسين مصغرا البصري ثقة له كتاب الصفة في مذهب الواقفة، مات سنة إحدى وستين ومائتين.(@)(@@)(@@)(@@) $ 1355 - أحمد بن الحسين بن سعيد، روى عنه محمد بن أحمد بن يحيى، كما تقدم مع ابن بشير. وقيل: روى عنه أحمد بن محمد بن يحيى، والصواب الأول كما لا يخفى.(@)(@@)(@@)(@@) $ 1356 - أحمد بن الحسين بن سعيد بن حماد بن سعيد بن مهران مولى " ين " عليه السلام أبو جعفر الأهوازي الملقب دندان، عنه الصفار، ويروي عن جميع شيوخ أبيه، إلا أنه يرمى بالغلو مات بقم.(@)(@@)(@@)(@@) $ 1357 - أحمد بن الحسين بن عبد الملك أبو جعفر الأودي، كوفي ثقة مرجوع إليه " ست " " صه " " جش " إلا أن فيهما الأزدي، روى عنه ابن الزبير، روى عن الحسن بن محبوب.(@)(@@) PageV01P223(@)(@@)(@@)(@@) $ 1358 - أحمد بن الحسين بن مفلس الضبي النخاس، روى عنه حميد كتاب زكريا بن محمد المؤمن وغير ذلك من الأصول " لم ".(@)(@@)(@@)(@@) $ 1359 - أحمد بن الحسين الميثمي وكان واقفيا، قاله ابن بابويه في العيون، وربما يعنون ابن الحسن مكبرا، ويحتمل التعدد، ومن جهة الاتحاد في الوصف والمذهب تركناه.(@)(@@)(@@)(@@) $ 1360 - أحمد بن داود بن 
ms145	 سعيد الفزاري أبو يحيى الجرجاني، كان من أجلة أصحاب الحديث من العامة، ورزقه الله هذا الأمر، وله تصنيفات كثيرة في فنون الاحتجاجات على المخالفين.(@)(@@)(@@)(@@) $ 1361 - أحمد بن زيد الخزاعي، روى عنه حميد، غير معلوم الحال كما ذكره الميرزا، إلا أنه يحتمل كونه ابن محمد بن زيد الخزاعي الآتي، وهو معلوم الوصف.(@)(@@)(@@)(@@) $ 1362 - أحمد بن عبد الله بن مروان الأنباري " ري ".(@)(@@)(@@)(@@) $ 1363 - أحمد بن عبدوس الخلنجي أبو عبد الله " جش " " ست " عنه الحسن بن متويه الذي لم يذكر في كتب الرجال، له كتاب " ست " " جش " الظاهر أنه في هذه الطبقة، ويحتمل كونه في التالية.(@)(@@)(@@)(@@) $ 1364 - أحمد بن عبيد الله بن يحيى بن خاقان، له مجلس يصف فيه أبا محمد " ري " عليه السلام عنه عبد الله بن جعفر الحميري " ست " " لم " وعن المفيد في ارشاده أنه كان على الخراج بقم وكان شديد النصب والانحراف عن أهل البيت عليهم السلام.(@)(@@)(@@)(@@) $ 1365 - أحمد بن علوية الأصفهاني المعروف بابن الأسود الكاتب، روى عن إبراهيم بن محمد الثقفي كتبه كلها، روى عنه الحسين بن محمد بن عامر، وله دعاء الاعتقاد تصنيفه " لم ".(@)(@@)(@@)(@@) $ 1366 - أحمد بن علي أبو العباس. وقيل: أبو علي الرازي الخضيب الأيادي، لم يكن بذلك الثقة في الحديث ويتهم بالغلو، وله كتاب الشفا والجلا في الغيبة " جش " " ست " " صه " إلا أن " غض " عن أبيه أنه في مذهبه ارتفاع. PageV01P224(@)(@@)(@@)(@@) $ 1367 - أحمد بن علي الحميري الصيدي، روى عنه حميد بن زياد " لم ".(@)(@@)(@@)(@@) $ 1368 - أحمد بن علي الكوفي المعروف بشقران المقيم بكش، كان أشقر دوارا " لم ".(@)(@@)(@@)(@@) $ 1369 - أحمد بن علي بن كلثوم، من أهل سرخس متهم بالغلو " لم " " صه " كان من القوم، وكان مأمونا على الحديث " كش " عنه " صه " ثم قال: والوجه عندي رد روايته.(@)(@@)(@@)(@@) $ 1370 - أحمد بن محمد الحضيني ينزل الأهواز " ري ".(@)(@@)(@@)(@@) $ 1371 - أحمد بن محمد بن حنبل، من الأربعة عند أهل السنة، توفي في سنة الأربعين بعد المائتين ودفن في مقبرة باب الحرب في بغداد، وقبره في هذه الأزمنة غير معلوم، والظاهر أنه قد غرق 
ms146	 في ماء دجلة.(@)(@@)(@@)(@@) $ 1372 - أحمد بن محمد بن خالد بن عبد الرحمن بن محمد بن علي البرقي، وكان جده محبوسا في حبس يوسف وأتى العراق بعد قتل زيد بن علي ثم قتله، وكان خالد صغيرا فهرب مع أبيه إلى برقية قم، وعندي قبول روايته.(@)(@@)(@@)(@@) $ 1373 - أحمد بن محمد بن زيد الخزاعي يكنى أبا جعفر، روى عنه حميد أصولا كثيرة، ومات سنة اثنتين وستين ومائتين، وصلى عليه الحسن بن محمد بن سماعة الصيرفي.(@)(@@)(@@)(@@) $ 1374 - أحمد بن محمد بن ربيع الأقرع الكندي، له كتاب نوادر، عنه علي بن الحسن، قال أبو الحسين محمد بن هارون قال أبي، قال ابن همام: حدثنا عبد الله بن العلاء أنه كان عالما بالرجال.(@)(@@)(@@)(@@) $ 1375 - أحمد بن محمد الدينوري يكنى أبا الحسن يلقب بأستونة " لم ".(@)(@@)(@@)(@@) $ 1376 - أحمد بن محمد بن سلمة الرصافي البغدادي روى عنه حميد بن زياد أصولا كثيرة منها كتاب زياد بن مروان القندي " لم " وفي " جش " مسلمة مع الميم كما يأتي.(@)(@@)(@@)(@@) $ 1377 - أحمد بن محمد بن سيار الكاتب أبو عبد الله، كان من كتاب آل PageV01P225(@)(@@) طاهر في زمن " ري " عليه السلام ويعرف بالسيار باعتبار الجد، ضعيف فاسد المذهب مجفو الرواية كثير المراسيل.(@)(@@)(@@)(@@) $ 1378 - أحمد بن محمد بن علي بن عمر بن رباح القلا السواق، وكان ثقة في الحديث، وهم ثلاث اخوة، والظاهر أنه في هذه الطبقة أو السابقة، لان جدهم عمر يروي عن " ق " و " ظم " ووقف وولده واقفية.(@)(@@)(@@)(@@) $ 1379 - أحمد بن محمد بن عيسى بن عبد الله بن سعد بن مالك الأحوص الأشعري أبو جعفر، شيخ القميين ووجههم، هو الرئيس الذي يلقي السلطان وليس فيه قدح، لقى " ضا " و " ج " و " دي " لكن لم يرو عنهم إلا قليلا.(@)(@@)(@@)(@@) $ 1380 - أحمد بن محمد بن عيسى القسري أبو الحسن، كان أديبا فاضلا بالتوقيع الذي خرج في سنة إحدى ومائتين في الصلاة على النبي وآله وقيل: النسري بالنون.(@)(@@)(@@)(@@) $ 1381 - أحمد بن محمد بن مسلمة الرصافي البغدادي، وقد تقدم أنه ابن محمد بن سلمة بدون الميم، عنه 
ms147	 حميد.(@)(@@)(@@)(@@) $ 1382 - أحمد بن محمد بن يحيى الخثعمي، لم أقف عليه في كتب الرجال، إلا أنه يروي عنه الكليني بواسطة العدة، وهي غير الثلاثة المعروفة، وقد روى عن هشام وأبوه محمد، من أصحاب " ق " عليه السلام.(@)(@@)(@@)(@@) $ 1383 - أحمد بن معروف له كتاب " ست " " جش " قمي " جش " عنه محمد بن يحيى " ست " محمد بن يحيى عن محمد بن علي بن محبوب عنه " جش " والظاهر أنه هو الصواب.(@)(@@)(@@)(@@) $ 1384 - أحمد بن ميثم بن أبي نعيم بضم النون الفضل أبو الحسين، كان من ثقات أصحابنا الكوفيين وفقهائهم " ست " " جش " روى عنه حميد " لم ".(@)(@@)(@@)(@@) $ 1385 - أحمد بن وهب بن حفص الأسدي الجرير، له كتاب نوادر " جش " عنه حميد بن زياد " جش " " لم ".(@)(@@)(@@)(@@) $ 1386 - أحمد بن هلال العبرتائي بغدادي، كان غاليا متهما في دينه، قد ورد PageV01P226(@)(@@) فيه ذموم عن سيدنا " ري " ومات سنة سبع وستين ومائتين، وتوقف " غض " في حديثه إلا فيما يرويه عن الحسن ومحمد.(@)(@@)(@@)(@@) $ 1387 - أحمد بن يزيد أخو يزيد " ري ".(@)(@@)(@@)(@@) $ 1388 - أحمد بن يوسف بن يعقوب الجعفي، روى عن محمد بن إسماعيل الزعفراني، وفيه اشعار بوثاقته، كما مر في الفوائد وفي جميل بن دراج ما يشير إلى كونه ذا كتاب وأصل بل ومن المشايخ، ووالده يوسف يذكر في ترجمته " تعق ".(@)(@@)(@@)(@@) $ 1389 - أسد بن عفر بالمهملة المضمومة، من شيوخ أصحاب الحديث الثقات " صه " " د " وكذا " جش " في ابنه كما تقدم، وفي الحاوي أن النسخ متفقة على ما في " جش " وفي الوجيزة أسد بن عفر ثقة.(@)(@@)(@@)(@@) $ 1390 - إسحاق بن إسماعيل النيسابوري، من أصحاب " ري " ثقة " جخ " " صه " وهو من ثقات ترد عليهم التوقيعات من قبل المنصوبين للسفارة من الأصل.(@)(@@)(@@)(@@) $ 1391 - إسحاق بن يعقوب، قد ورد فيه توقيع بخط مولانا صاحب الأمر عجل الله فرجه يدل على جلالته ومنزلته عنده عليه السلام.(@)(@@)(@@)(@@) $ 1392 - إسماعيل بن الحكم الرافعي، من ولد أبي رافع مولى رسول الله صلى الله عليه وآله له كتاب " جش " وفي " ست " له كتاب رواه إسماعيل بن محمد عنه، وفي بعض النسخ رضي الله 
ms148	 عنهما، إلا أن في " مشكا " ابن الحكم الرافعي عنه محمد بن إسماعيل. وأحدهما غلط قطعا.(@)(@@)(@@)(@@) $ 1393 - إسماعيل بن سمكة بن عبد الله والد أحمد المذكور في السابقة، وفي " تعق " مضى في ترجمته أنه من أصحاب أحمد بن أبي عبد الله البرقي وممن تأدب عليه.(@)(@@)(@@)(@@) $ 1394 - إسماعيل بن شعيب العريشي هو بالفتح قرية بالشام، ثقة سالم فيما يرويه قليل الحديث، روى عنه عبد الله بن جعفر، له كتاب في الطب.(@)(@@)(@@)(@@) $ 1395 - إسماعيل بن علي بن إسحاق بن أبي سهل بن نوبخت أبو سهل، كان شيخ المتكلمين من أصحابنا ووجههم ومتقدم النوبختيين.(@)(@@)(@@)(@@) $ 1396 - إسماعيل بن عبد الله البجلي الكوفي، وهو ابن سمكة " تعق ". PageV01P227(@)(@@) أقول: وقد مضى ابن سمكة عنه قبيل ذلك.(@)(@@)(@@)(@@) $ 1397 - إسماعيل بن علي العمي أبو علي البصري " لم " وفي " جش " بعد الترجمة أحد أصحابنا البصريين، ثقة له كتب، وفي " صه " إلى ثقة، وبدل أصحابنا شيوخنا، عنه عبد العزيز بن يحيى كما في " مشكا " و " ست ".(@)(@@)(@@)(@@) $ 1398 - إسماعيل بن محمد بن إسحاق بن جعفر بن محمد بن علي بن الحسين عليهم السلام ثقة، روى عن جده إسحاق وعن عم أبيه علي بن جعفر عليه السلام " جش " " صه " ولعله في التالية أيضا.(@)(@@)(@@)(@@) $ 1399 - إسماعيل بن موسى بن جعفر، الظاهر أنه الفزاري، صدوق شيعي سكن مصر وولد بها له كتب كما في " جش " و " ست " والظاهر أنه في هذه الطبقة بملاحظة ما وجدناه من تاريخ الوفاة.(@)(@@)(@@)(@@) $ 1400 - بكر بن محمد بن حبيب أبو عثمان المازني، مازن بني شيبان، كان سيد أهل العلم بالنحو والغريب واللغة بالبصرة، كان من الامامية، وهو من غلمان إسماعيل بن ميثم، مات سنة ثمان وأربعين ومائتين.(@)(@@)(@@)(@@) $ 1401 - بيان الجزري أبو أحمد كوفي مولى، قال محمد بن عبد الحميد: كان خيرا فاضلا " صه " " جش " إلا أن فيه بنان بالنونين وأبو محمد.(@)(@@)(@@)(@@) $ 1402 - جابر بن يزيد الفارسي يكنى أبا القاسم " ري ".(@)(@@)(@@)(@@) $ 1403 - جعفر بن إبراهيم بن نوح " ري ".(@)(@@)(@@)(@@) $ 1404 - جعفر بن أحمد بن أيوب السمرقندي أبو سعيد، روى عنه " معد " و 
ms149	 " كش " ثقة صحيح الحديث والمذهب متكلم، له كتب لكن قيل هو ابن محمد بن أيوب السمرقندي.(@)(@@)(@@)(@@) $ 1405 - جعفر بن إسماعيل المقري، كوفي روى عنه حميد بن زياد وابن رباح قال: إنه كان غاليا كذابا، وفي " جش " المنقري، وفي " د " اختلف نسخه، والأصح ما في " جش " لتصريح " ضح ".(@)(@@)(@@)(@@) $ 1406 - جعفر بن أيوب هو ابن أحمد " تعق " ويحتمل التعدد إذ لا دليل على PageV01P228(@)(@@) الاتحاد إلا بعناية خارجية.(@)(@@)(@@)(@@) $ 1407 - جعفر بن سهيل الصيقل، وكيل أبي الحسن وأبي محمد وصاحب الدار " صه " " ري " وكونه وكيلا لاولي الأمر الاطهار عليهم السلام يدل على الوثاقة والجلالة كما لا يخفى.(@)(@@)(@@)(@@) $ 1408 - جعفر بن عبد الرحمن الكاهلي، له كتاب نوادر، يروي عنه حميد بن زياد عن الرجال " جش " " ست " معنى، ثم في " لم " جعفر بن عبد الرحمن يروي عنه حميد، والظاهر أنه والأول واحد.(@)(@@)(@@)(@@) $ 1409 - جعفر بن عبد الله رأس المذري بن جعفر الثاني ابن عبد الله بن جعفر بن محمد بن علي بن أبي طالب أبو عبد الله، كان وجها في الأصحاب وأوثق الناس في حديثه، يقال له:: المحمدي، فتأمل.(@)(@@)(@@)(@@) $ 1410 - جعفر بن عبيد الله، روى عن الحسن بن محبوب، روى عنه ابن عقدة " لم " فحديثه بهذا الاعتبار عال السند.(@)(@@)(@@)(@@) $ 1411 - جعفر بن علي بن أحمد القمي، المعروف بابن الرازي " لم " " جخ " أبو محمد ثقة مصنف " د " عنه الميرزا ثم قال: لا غير.(@)(@@)(@@)(@@) $ 1412 - جعفر بن علي البجلي، روى عنه حميد " لم ".(@)(@@)(@@)(@@) $ 1413 - جعفر بن علي بن حازم، يروي عنه حميد بن زياد " لم ".(@)(@@)(@@)(@@) $ 1414 - جعفر بن علي بن حسان " لم " " جش " " ست " البجلي له نوادر وروايات، روى عنه حميد بن زياد " ست " سمع عنه في بجيلة ولعله البجلي السابق.(@)(@@)(@@)(@@) $ 1415 - جعفر بن عمرو المعروف بالعمري، روى " كش " عن محمد بن إبراهيم بن مهزيار أن أباه لما حضره الموت دفع إليه مالا وأعطاه غلامه لمن يسلم إليه، فدخل إليه شيخ، فقال: أنا العمري فأعطاه.(@)(@@)(@@)(@@) $ 1416 - جعفر بن مازن الكاهلي الطحان أبو عبد الله، مات بسبع خلون من 
ms150	 ربيع الأول سنة أربع وستين ومائتين، عنه حميد " جش ".(@)(@@)(@@)(@@) $ 1417 - جعفر بن محمد بن أيوب يعرف بابن التاجر، من أهل سمرقند، PageV01P229(@)(@@) متكلم له كتب " لم " تقدم ابن أحمد السمرقندي، وفيه تأمل.(@)(@@)(@@)(@@) $ 1418 - جعفر بن محمد بن جندب يكنى أبا محمد، من أهل قزوين " لم ".(@)(@@)(@@)(@@) $ 1419 - جعفر بن محمد الدوريستي أبو عبد الله ثقة " لم " عن نسخة صحيحة ونقله " د " أيضا، الظاهر أنه في هذه الطبقة.(@)(@@)(@@)(@@) $ 1420 - جعفر بن محمد بن سماعة، ثقة في الحديث واقفي " صه " " جش " أبو عبد الله أخو أبي محمد الحسن وإبراهيم أبي محمد، وجعفر أكبر اخوته " جش ".(@)(@@)(@@)(@@) $ 1421 - جعفر بن محمد السنجاري، يروي عنه حميد " لم " وفي " جش " لم يسمع منه حميد إلا حديثا واحدا، أخبرنا بذلك ابن نوح عن الحسين بن علي عن حميد.(@)(@@)(@@)(@@) $ 1422 - جعفر بن محمد الكوفي، روى عنه محمد بن أحمد بن يحيى " لم " ولعله في السابقة أيضا.(@)(@@)(@@)(@@) $ 1423 - جعفر بن معروف أبو الفضل السمرقندي، يروي عنه " معد " كثيرا، كان في مذهبه ارتفاع وحديثه نعرفه تارة وننكره أخرى قاله " غض " وتوقف فيه " مه " في " صه ".(@)(@@)(@@)(@@) $ 1424 - جعفر بن معروف يكنى أبا محمد، من أهل كش وكيل وكان مكاتبا " لم " والظاهر أنه غير السمرقندي المشار إليه في " غض " وهو أيضا في السابقة.(@)(@@)(@@)(@@) $ 1425 - جعفر بن ميمون، روى " كش " أنه من أصحاب أبي الخطاب ومن أهل النار، والظاهر أنه كان خطابيا بملاحظة التأييدات الخارجية، كما لا يخفى على المتأمل.(@)(@@)(@@)(@@) $ 1426 - جعفر الوراق، له نوادر، عنه حميد " ست " ابن الوراق روى عنه حميد " لم ".(@)(@@)(@@)(@@) $ 1427 - جعفر الهذلي، له نوادر، عنه حميد " ست ".(@)(@@)(@@)(@@) $ 1428 - جعفر بن هذيل، عنه حميد " لم " " جش " له نوادر " جش ".(@)(@@)(@@)(@@) $ 1429 - جنيد الذي من أصحاب " ري " في فارس بن حاتم ما يشعر بحسن PageV01P230(@)(@@) حاله في الجملة " تعق " ففي " كش " باسناده عن عيسى بن عبيد أن العسكري عليه السلام أمر بقتل فارس، وضمن لمن قتله الجنة فقتله جنيد (1)، وفيه غيره بل وفي غيره، فالاعتماد على روايته موجه.(@)(@@)(@@)(@@) $ 1430 - حاجز بن يزيد، من وكلاء 
ms151	 الناحية. قال " طس " في ربيع الشيعة (2) والمفيد رحمه: الله علي بن محمد عن الحسن بن عبد الحميد قال: شككت في أمر حاجز، فجمعت شيئا ثم صرت إلى العسكر، فخرج: ليس فينا شكوة في من يقوم مقامنا بأمرنا، رد ما معك إلى حاجز.(@)(@@)(@@)(@@) $ 1431 - الحارث بن عبد الله التغلبي، كوفي ضعيف " صه " " جش " وزاد له كتاب، التلعكبري عن عقد عن محمد بن سالم بن عبد الرحمن الأزدي عنه، وفي " مشكا " وصفه بالضعف.(@)(@@)(@@)(@@) $ 1432 - الحسن بن أبان قمي، وفي " صه " ان الحسين بن سعيد تحول إلى قم فنزل على الحسن، و " ز " (3) في تعليقته عليها أنه غير مذكور في كتب الرجال، مع أن هذا يدل على أنه جليل مشهور ذكره الميرزا، وهو متين.(@)(@@)(@@)(@@) $ 1433 - الحسن بن إبراهيم بن عبد الله بن الحسن بن الحسن بن علي بن محمد بن هارون بن عمران الهمذاني وكيل " صه " " جش " في محمد بن علي بن إبراهيم الهمذاني بالذال المعجمة كما يأتي.(@)(@@)(@@)(@@) $ 1434 - الحسن بن أبي عبد الله محمد بن خالد بن عمر الطيالسي أبو العباس التميمي أبو محمد ثقة " صه " وهو أخو أحمد وعبد الله البرقيين، وأبو العباس كنية عبد الله لا الحسن كما توهمه " د " والله أعلم.(@)(@@)(@@)(@@) $ 1435 - الحسن بن أحمد بن ريذويه القمي، ثقة من أصحابنا القميين، له كتاب المزار " صه " " جش " وريذويه بالراء المهملة المكسورة والياء المثناة من تحت(@)(@@) PageV01P231(@)(@@) الساكنة والذال المفتوحة المعجمة والواو الساكنة بعدها ياء مضمومة.(@)(@@)(@@)(@@) $ 1436 - الحسن بن أحمد المالكي " ري " غير معلوم الحال مردود المقال، كما في طريقة أرباب الرجال.(@)(@@)(@@)(@@) $ 1437 - الحسن بن الحسين، له روايات عنه إبراهيم بن سليمان " ست ".(@)(@@)(@@)(@@) $ 1438 - الحسن بن سماعة بن مهران واقفي، وليس بالحسن بن محمد بن سماعة كما يأتي، كذا في المنتهى، وفي الوجيزة توهم الاتحاد، وفي " تعق " ولعله وهم عنه حميد. وفي الاتحاد والتغاير للاتحاد الراوي والطبقة والمذهب محل توقف.(@)(@@)(@@)(@@) $ 1439 - الحسن بن عبد ربه " لم " " كش " كان وكيلا " د " وفي غيره الحسين كما يأتي.(@)(@@)(@@)(@@) $ 1440 - الحسن بن عرفة، في ترجمة 
ms152	 سعد بن عبد الله عن " جش " أنه كان من وجوه الطائفة " تعق " أقول: يظهر من تلك الترجمة كونه من وجوه العلماء العامة، قال " جش ": سمع سعد من حديث العامة شيئا كثيرا وسافر في طلب الحديث، لقى من وجوههم الحسن بن عرفة (1). ولعله أراد من الطائفة ذلك بإرادة العهد فلا نزاع.(@)(@@)(@@)(@@) $ 1441 - الحسن بن علي بن أحمد يكنى أبا محمد، روى عن ابن همام، روى عنه ابن نوح " لم " وذكره في السابقتين أولى، كما لا يخفى على المتدرب، فإنه جد الأمي للسيدين (2) على الظاهر، فتدبر.(@)(@@)(@@)(@@) $ 1442 - الحسن بن علي بن أحمد الصائغ " لم ".(@)(@@)(@@)(@@) $ 1443 - الحسن بن علي الحناط الرازي، فاضل لم أقف على غيره، والفضل غير الوثاقة.(@)(@@)(@@)(@@) $ 1444 - الحسن بن علي بن النعمان الأعلم، أبوه ثقة ثبت، له كتاب نوادر صحيح الحديث كثير الفوائد، عنه الصفار وأحمد بن أبي عبد الله وهو في الآتية كما لا يخفى.(@)(@@) PageV01P232(@)(@@)(@@)(@@) $ 1445 - الحسن بن عنبسة الصوفي، كوفي ثقة " صه " وفي " ست " بعد الصوفي له نوادر، وفي " لم " العوفي سهو من الناسخ، وفي " جش " الحسين في موضعين في " جش " نسخة، ولعل أحدهما الحسن بل هو الظاهر، واحتمال الاتحاد ضعيف، فإنه ثقة والمصغر غير موثق، وفي " مشكا " ابن عنبسة الثقة، عنه حميد بن زياد.(@)(@@)(@@)(@@) $ 1446 - الحسن بن محمد بن حمزة الحسيني الطبري أبو محمد " لم " " د " قال الميرزا: ان توسط محمد غير موافق لما في كتب النسب، واستظهر أن توسطه سهو.(@)(@@)(@@)(@@) $ 1447 - الحسن بن محمد بن سماعة أبو علي أو أبو محمد الكندي الصيرفي، من شيوخ الواقفة كثير الحديث فقيه ثقة، وكان يعاند في الوقف ويتعصب، إلا أنه جيد التصانيف، مات سنة ثلاث وستين ومائتين.(@)(@@)(@@)(@@) $ 1448 - الحسن بن محمد بن النوفلي ضعيف " صه " " جش " له كتاب حسن كثير الفوائد، عنه الحسن بن محمد بن جمهور، وهو في السابقة بل في الآتية أيضا، ويأتي فيها بعنوان ابن محمد بن الفضل بن يعقوب بن سعيد.(@)(@@)(@@)(@@) $ 1449 - الحسن بن موسى الخشاب، من وجوه الأصحاب مشهور كثير العلم والحديث، عنه الصفار 
ms153	 وعمران بن موسى الأشعري " صه " " جخ " في " ري " و " لم ".(@)(@@)(@@)(@@) $ 1450 - الحسن بن نضر أبو عون الأبرشي " ري " فيأتي له في الكنى عن " كش " ذم عظيم فلا تغفل، إلا أن الطريق ضعيف، وهذا غير الآتي على الأظهر الأشهر، نعم قد حكم المولى عناية الله بأنه هو.(@)(@@)(@@)(@@) $ 1451 - الحسن بن النضر، قال " كش ": أنه من أجلة اخواننا " صه " وهو ممن رأى القائم عليه السلام بل في الوجيزة والبلغة ادعيا الوكالة له عليه السلام ولكنها غير معلومة، وفي " في " ما يظهر منه جلالته وحسن خاتمته، فالرجل جليل وان لم يكن وكيلا.(@)(@@)(@@)(@@) $ 1452 - الحسن بن الوجناء، قال الشيخ أبو علي: الظاهر أنه أبو محمد بن الوجناء المذكور في المقدمة الأولى، ويظهر من كتاب الغيبة للشيخ وكتاب الخرائج PageV01P233(@)(@@) والجرائح جلالته جدا (1) انتهى. المذكور انما هو في الثانية لا الأولى، وسنشير إليه في الفائدة الثانية من الباب التاسع.(@)(@@)(@@)(@@) $ 1453 - الحسن بن هارون بن عمران الهمداني وكيل في " صه " إلا أنه ابن محمد بن هارون في نسخة جعلها أصح، وعلله في " تعق " بأن المتعارف السقط لا الزيادة، أو كون هذا نسبة إلى الجد. وقيل: أبو بدل ابن، واستصوبه البعض، وتصحيح النسخ بالاعتبارات موهون، بل لابد من الاخذ من المآخذ.(@)(@@)(@@)(@@) $ 1454 - الحسن بن هذيل، روى عنه حميد " لم ".(@)(@@)(@@)(@@) $ 1455 - الحسن بن يحيى الطحان، روى عنه حميد " لم ".(@)(@@)(@@)(@@) $ 1456 - الحسن بن يوسف " لم ".(@)(@@)(@@)(@@) $ 1457 - الحسين بن اشكيب المروزي المقيم بسمرقند وكش، من أصحاب " ري " عليه السلام عالم متكلم مصنف له كتب فاضل جليل ثقة فقيه مناظر، صاحب تصانيف، لطيف الكلام جيد النظر، عنه " معد ".(@)(@@)(@@)(@@) $ 1458 - الحسين بن الحسن بن أبان، روى عن ابن سعيد كتبه كلها، روى عنه ابن الوليد، وصرح " د " بتوثيقه في ترجمة ابن أورمة، وكثيرا ما يسمى " مه " الحديث صحيحا وهو فيه.(@)(@@)(@@)(@@) $ 1459 - الحسين بن الحسن الحسني الأسود، فاضل يكنى أبا عبد الله رازي " لم ".(@)(@@)(@@)(@@) $ 1460 - الحسين بن الحسن العلوي، روى الشيخ الطوسي بسند يأتي في ترجمة عبد الله بن العباس أنه قال: دخلت على 
ms154	 " ري " عليه السلام بسر من رأى فهنيته بسيدنا صاحب الأمر عليه السلام لما ولد.(@)(@@)(@@)(@@) $ 1461 - الحسين بن عبد الصمد بن محمد بن عبيد الله الأشعري، شيخ ثقة من أصحابنا القميين، روى أبوه عن حنان بن سدير عن " ق " عليه السلام له كتاب(@)(@@) PageV01P234(@)(@@) نوادر، وفي " صه " ك " د " مكبرا.(@)(@@)(@@)(@@) $ 1462 - الحسين بن عبد الله أو عبيد الله بن جعفر، له مكاتبة " صه " والظاهر أنه في هذه الطبقة لبعض من التأييدات، والا لم نقف على تاريخ مولد أو وفاة والراوي عنه والمروي عنه، والله أعلم.(@)(@@)(@@)(@@) $ 1463 - الحسين بن عبيد الله أبو عبد الله بن عبيد الله بن سهل، يرمى بالغلو والطعن، له كتب صحيحة الحديث، عنه محمد بن يحيى العطار وأحمد بن الفائدي، وفي كونه ابن عبيد الله القمي خلاف، والظاهر التغاير كما في نقد والوجيزة.(@)(@@)(@@)(@@) $ 1464 - الحسين بن عنبسة الصوفي، وفي " جش ": وجدت بخط ابن نوح فيما وصل إلي من كتبه حدثنا الحسين بن علي البزوفري، قال: حدثنا حميد، قال: سمعت من الحسين بن عنبسة الصوفي كتابه نوادر وفي " مشكا " ابن عنبسة عنه حميد، ولعل لذلك توهم الاتحاد، وهذا أخوه على الظاهر، فتأمل.(@)(@@)(@@)(@@) $ 1465 - الحسين بن القاسم بن محمد بن أيوب بن شمون أو ميمون الكاتب، وكان أبوه القاسم من جلة أصحابنا و " غض " ضعفه و " مه " وثقه، وكان أبوه من و. " هص " ائيش وري ملوة عيشلا هوج ط (@)(@@)(@@)(@@) $ 1466 - الحسين بن مالك القمي ثقة " ري " مضى مكبرا ووعد المصنف بالإشارة إليه ونسبه " تعق " أقول: ويأتي في الآتية مكبرا عنه، وفي " مشكا " ابن مالك الثقة القمي، عنه عبد الله بن جعفر الحميري ولكنه بعنوانه مكبرا.(@)(@@)(@@)(@@) $ 1467 - الحسين بن النضر أبو عون الأبرش " ري " ويأتي في التالية أيضا.(@)(@@)(@@)(@@) $ 1468 - حفص بن عمرو المعروف بالعمري وكيل " ري " عليه السلام ويدعى بالجمال وله قصة في ذلك، وأما محمد بن حفص فهو ابن العمري وكيل الناحية وكان الامر يدور عليه " كش ".(@)(@@)(@@)(@@) $ 1469 - حمدان بن أحمد الكوفي هو النهدي " تعق ".(@)(@@)(@@)(@@) $ 1470 - حمدان بن سليمان بن عميرة 
ms155	 المعروف بالتاجر أبو سعيد، ثقة من وجوه أصحابنا عنه علي بن محمد بن سعد القزويني " جش " ومحمد بن يحيى العطار PageV01P235(@)(@@) " جش " " لم ".(@)(@@)(@@)(@@) $ 1471 - حمدان القلانسي هو حمدان النهدي كما يأتي على ما في " كش " والعجب من الشيخ أبا علي أنه نقل عن " تعق " في ابن أحمد الكوفي وكذا هنا عن " كش " وفي الولي أنه الهندي، وهو سهو قطعا فإنه النهدي، ويحتمل قويا غلط النسخة.(@)(@@)(@@)(@@) $ 1472 - حمدان النقاش الظاهر أنه القلانسي " تعق ".(@)(@@)(@@)(@@) $ 1473 - حمدان النهدي هو محمد بن أحمد بن خاقان النهدي، ويأتي في عنوانه، فعلى فرض اتحاد العناوين الأربعة يكون الكل ثقة على الأظهر.(@)(@@)(@@)(@@) $ 1474 - حمدوية بن نصير بن شاهي بالشين المعجمة، سمع يعقوب بن يزيد، روى عنه " معد " يكنى أبا الحسن، عديم النظير في زمانه، كثير العلم والرواية، ثقة حسن المذهب " صه " " لم ".(@)(@@)(@@)(@@) $ 1475 - حمزة بن محمد " ري " مجهول الوصف غير منعوت بالتوثيق ولا بغيره فيرد حديثه فقاهة.(@)(@@)(@@)(@@) $ 1476 - خلف بن حماد يكنى أبا صالح من أهل كش " لم ".(@)(@@)(@@)(@@) $ 1477 - خليفة بن الصباح بن خليفة، روى عن أبيه عن ابان الناووسي عن أبي بصير، وسمع الحسن بن علي بن نعيم بن سهيل بن ابان " لم " معنى.(@)(@@)(@@)(@@) $ 1478 - داود بن أبي زيد النيسابوري، ثقة صادق اللهجة من أهل الدين، واسم أبي زيد زنكان، له كتب ذكره ابن النديم وكش، كان من أصحاب " ري " عليه السلام " ست " وذكره في " جخ " في أصحاب " ري ".(@)(@@)(@@)(@@) $ 1479 - داود بن عامر الأشعري قمي " ري ".(@)(@@)(@@)(@@) $ 1480 - الدهقان " كش " ملعون " د " الظاهر أنه عروة بن يحيى الدهقان، كما ذكره الميرزا " رحمه الله " ويأتي في عروة بثلاثة عناوين كلها واحدة.(@)(@@)(@@)(@@) $ 1481 - ذبيان بن حكيم الأودي بالدال المهملة بعد الواو الساكنة عم أبي جعفر أحمد بن يحيى بن حكيم، وفي " ضح " ذبيان بضم المعجمة واسكان الموحدة وفتح المثناة من تحت والنون أخيرا، والظاهر في هذه الطبقة. PageV01P236(@)(@@)(@@)(@@) $ 1482 - الزبير بن بكار في تاريخ ابن خلكان من أعيان العلماء بمكة، وصنف الكتب النافعة منها كتاب أنساب قريش، وعليه اعتماد الناس في 
ms156	 معرفة نسبهم، وهو قاض فيها، توفى سنة ست وخمسين ومائتين، عمر أربع وثمانون سنة.(@)(@@)(@@)(@@) $ 1483 - زيتون يكنى أبا محمد " قي " " لم " انما ذكرناه في هذه الطبقة على الحدس والتخمين.(@)(@@)(@@)(@@) $ 1484 - سلام بن عبد الله الهاشمي، له كتاب صغير رواه أبو سمينة " جش " ولا يبعد كونه في الآتية أيضا، بل هو الأقرب كما لا يخفى.(@)(@@)(@@)(@@) $ 1485 - سلمة بن أبي الخطاب، قال في المنتهى بعده على ما في أكثر نسخ " ضح " وبعض نسخ " ست " وفي " ب " كلمة أبي في الحاشية وعليها ظاهر يأتي بعنوان ابن الخطاب، ولم ينبه عليه الميرزا (1) انتهى. أقول: لم أجده في غيره، والله أعلم.(@)(@@)(@@)(@@) $ 1486 - سلمة بن الخطاب البراوستاني، له كتب عنه الصفار وسعد وغيرهما، ضعفه " مه " في " صه " وكذا " جش " ووصفه بها مع الأزد ورقاني، والأول قرية من قرى قم، والثاني قرية من سواد الري يكنى أبا الفضل أو أبا محمد.(@)(@@)(@@)(@@) $ 1487 - سليمان بن الحسن بن الجهم بن بكير بن أعين، جد أبي غالب الزراري، في رسالته في ذكر آل أعين ما يظهر منه جلالته وكونه مرجعا للشيعة، وأنه أول من نسب إلى زرارة نسبه إليه " دي " عليه السلام إلى أن قال: كاتب الصاحب عليه السلام جدي محمد بن سليمان بعد موت أبيه إلى أن وقعت الغيبة.(@)(@@)(@@)(@@) $ 1488 - سهل بن بحر الفارسي، كان مقيما بكش " لم " وفي " تعق " يروي عنه " كش " بالواسطة على وجة ظاهره اعتماده عليه واستناده إليه.(@)(@@) أقول: إن مجرد ذلك لا يوجب الاتكال، فيرد حديثه فقاهة.(@)(@@)(@@)(@@) $ 1489 - سهل بن الحسن الصفار، أخو محمد، روى عن يوسف بن الحارث الكمنداني عن عبد الرحمن العرزمي كتابه روى عنه أخوه محمد بن الحسن " لم " وفي(@)(@@) PageV01P237(@)(@@) " تعق " وفي رواية القميين سيما ابن الوليل كتابه ايماء إلى نباهته والاعتماد عليه بل ووثاقته فتأمل.(@)(@@)(@@)(@@) $ 1490 - سهل بن زاذوية بالزاء ثم الذال المعجمة بعد الألف أبو محمد القمي، ثقة جيد الحديث نقي الرواية معتمد عليه، ذكر ذلك ابن نوح " صه " " جش " الا الترجمة وزاد عنه محمد بن سهل ابنه، وفي " مشكا 
ms157	 " عنه ابنه محمد.(@)(@@)(@@)(@@) $ 1491 - سهل بن زياد الآدمي أبو سعيد الرازي، اختلف قول علمائنا فيه، أخرجه أحمد بن محمد بن عيسى من قم وشهد عليه بالغلو والكذب، يروي عن " ج " و " دي " و " ري " عليه السلام وهو في الآتية، مات سنة خمس وخمسين ومائتين.(@)(@@)(@@)(@@) $ 1492 - سهل بن الهرمزان بالهاء المضمومة والراء الساكنة والزاي بعد الميم والنون بعد الألف، قمي ثقة قليل الحديث " صه " " جش " الا الترجمة، له كتاب عنه الحسن بن علي الزيتوني " ست " والثاني، وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 1493 - سهل بن اليسع بن عبد الله بن سعد الأشعري، قمي ثقة ثقة قليل الحديث، روى عن " ظم " و " ضا " عليهما السلام " صه " وزاد " جش " أحمد بن محمد بن عيسى عن محمد بن سهل عن أبيه بكتابه.(@)(@@)(@@)(@@) $ 1494 - سهل بن يعقوب الملقب بأبي نواس. قيل: وانما لقب بذلك لأنه كان يظهر الطيبة والتخالع ليظهر التشيع على الطيبة فيأمن على نواس، وكان مولانا " دي " عليه السلام يقول له أن: أبو نواس الحق وذاك أبو نواس الغي والباطل، وكان خادما له عليه السلام وهما يدلان على حسنه.(@)(@@)(@@)(@@) $ 1495 - سهيل بن زياد الواسطي، لقي " ري " عليه السلام شيخنا المتكلم الا أنه لم يكن بكل الثبت في الحديث " جش ". " صه " معنى عند محمد بن هارون هو ابن بنت مؤمن الطاق و " غض " ضعفه، فهو متروك الرواية اجتهادا.(@)(@@)(@@)(@@) $ 1496 - سيابة بن ناجية المدني له كتاب " ظم " و " جش " عن سعد بن عبد الله، ويحتمل كونه في التالية.(@)(@@)(@@)(@@) $ 1497 - صالح بن أبي حماد بن سلمة الرازي أبو الخير، له كتب عنه سعد PageV01P238(@)(@@) بن عبد الله وأحمد بن أبي عبد الله، واسم أبي حماد زادبة و " فش " يرتضيه ويمدحه و " غض " ضعيف و " جش " توقف، وادخاله في الممدوحين أولى.(@)(@@)(@@)(@@) $ 1498 - صالح بن أبي صالح، في خاتمة الكتاب عند ذكره محمد بن جعفر الآتي ما يشير إلى كونه وكيلا، ويروي عنه محمد بن أحمد بن يحيى ولم يستثن روايته ولعله صالح بن محمد الجليل " تعق " أقول: لا مناسبة بينه 
ms158	 وبين ابن أبي صالح الآتي.(@)(@@)(@@)(@@) $ 1499 - صالح بن سلمة الرازي يكنى أبا الخير " دي " وهو ابن أبي حماد وقد مر، وفي " مشكا " ابن سلمة المعروف بابن أبي حماد، عنه أحمد بن أبي عبد الله وسعد بن عبد الله.(@)(@@)(@@)(@@) $ 1500 - صالح بن عبد الله الجلاب " ري " وهو في الآتية أيضا.(@)(@@)(@@)(@@) $ 1501 - الصلت بن الحر الجعفي، له كتاب عنه يحيى بن زكريا بن شيبان " ست " وأبو يحيى يروي عن صفوان ونظرائه، فيكون الصلت الذي يروي عنه يحيى في هذه الطبقة والتالية.(@)(@@)(@@)(@@) $ 1502 - عباد أبو سعيد العصفري، كوفي كان أبو عبد الله الحسين بن عبد الله رحمه الله يقول: سمعت أصحابنا أن عبادا هذا هو عباد بن يعقوب وانما دلسه أبو سمينة " جش " له كتاب عنه أبو سمينة " ست ".(@)(@@)(@@)(@@) $ 1503 - عباد بن يعقوب الرواجيني، عامي المذهب " جش " " صه " له كتاب أخبار المهدي وكتاب معرفة الصحابة، عنه علي بن العباس المقانعي، تقدم عنه قول بأن هذا وأبو سعيد العصفري واحد، وفي " ست " شيعي وثقة أبو حاتم، مات سنة إحدى وسبعين ومائتين.(@)(@@)(@@)(@@) $ 1504 - عباس بن عامر بن دراج أبو الفضل الثقفي القصباني، شيخ صدوق ثقة كثير الحديث، اتفق على جلالته الرجاليون عنه " صه " " جش " وأيوب بن نوح " لم " زاد في " مشكا " عنه الحسن بن علي بن عبد الله بن المغيرة الكوفي وموسى بن القاسم.(@)(@@)(@@)(@@) $ 1505 - عباس بن علي بن أبي سارة، كوفي ثقة " صه " وزاد " جش " عنه أحمد PageV01P239(@)(@@) بن جعفر، وفي " مشكا " ابن علي بن أبي سارة، عنه أحمد بن جعفر.(@)(@@) أقول: إن ابن جعفر هو ابن جعفر بن سفيان البزوفري الذي يروي عنه التلعكبري، فيكون هذا في السابقة أيضا.(@)(@@)(@@)(@@) $ 1506 - عبدان بن محمد الجويمي أبو معاذ، له نسخة يرويها عن " ري " عليه السلام عنه أبو أحمد محمد بن أحمد بن ركوية البرذعي " جش ".(@)(@@)(@@)(@@) $ 1507 - عبد الرحمن بن أحمد بن نهيك الملقب بدحان على الأشهر، ودحمان على ما في " ضح " ضعيف مرتفع القول، كما في " صه " و " جش " وفي " تعق " يأتي في أخيه الجليل عبد 
ms159	 الله ما يشعر بحسن وجلالة فيه.(@)(@@) أقول: وفيه أن آل نهيك بيت من أصحابنا بالكوفة، عنه حميد كما في " مشكا ".(@)(@@)(@@)(@@) $ 1508 - عبد الرحمن بن محمد " دي " والظاهر أنه عبد الرحمن بن محمد بن عيسى أخو أحمد بن محمد بن عيسى، ولعله من رجال " ري " وهو في الآتية.(@)(@@)(@@)(@@) $ 1509 - عبد الله بن أبحر " ق " وهو ابن سعيد بن حيان بن أبحر، فان كتابه معروف بكتاب عبد الله بن أبحر، ويأتي بعنوانه.(@)(@@)(@@)(@@) $ 1510 - عبد الله بن أبي الحسن العلوي، روى عن أبيه عن " ضا " عليه السلام روى عنه الصفواني " لم ".(@)(@@)(@@)(@@) $ 1511 - عبد الله بن أبي عبد الله محمد بن خالد بن عمر الطيالسي أبو العباس التميمي، رجل من أصحابنا ثقة سليم الجنبة وكذا أخوه أبو محمد الحسن، له نوادر يختلف، عنه محمد بن جعفر ومعد وعلي بن محمد بن الزبير " جش " ويأتي في ابن محمد.(@)(@@)(@@)(@@) $ 1512 - عبد الله بن أحمد بن حرب بن مهزم بن خالد الفزر بالزاي بعد الفاء والراء أخيرا أبو هفان، مشهور في أصحابنا، وله شعر في المذهب " صه " " جش " وفي الأخير أيضا، وبنو مهمزم بيت كبير في البصرة في عبد القيس فالرجل شيعي " ح ".(@)(@@)(@@)(@@) $ 1513 - عبد الله بن أحمد بن عامر بن سليمان بن صالح بن وهب بن عامر، PageV01P240(@)(@@) روى عن أبيه عن " ضا " عليه السلام نسخة قرأتها على أحمد بن محمد بن موسى " جش " له كتب " ست " " جش " عنه أحمد بن محمد الجندي.(@)(@@)(@@)(@@) $ 1514 - عبد الله بن أحمد النهيكي أبو العباس النخعي، الشيخ الصدوق ثقة، وآل نهيك بالكوفة بيت من أصحابنا، منهم عبد الله بن محمد وعبد الرحمن السمريان وغيرهما، وقد قرأ مصغرا، عنه حميد وأحمد بن أبي عبد الله " ست ".(@)(@@)(@@)(@@) $ 1515 - عبد الله بن إدريس، له كتاب رويناه بالاسناد عن حميد بن زياد عن إبراهيم بن سليمان أبي إسحاق البزاز، عنه " ست " وفي " مشكا " ابن إدريس عنه إبراهيم بن سليمان أبو إسحاق.(@)(@@)(@@)(@@) $ 1516 - عبد الله بن بحر، كوفي روى عن أبي بصير، والرجال ضعيف مرتفع القول 
ms160	 " صه " " د ".(@)(@@)(@@)(@@) $ 1517 - عبد الله بن بشر السرخسي، نفاه إسماعيل بن أحمد صاحب خراسان عن البلد " صه " " لم ".(@)(@@)(@@)(@@) $ 1518 - عبد الله بن جعفر بن عبد الله بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليه السلام الملقب برأس المذري، ويأتي في التالية.(@)(@@)(@@)(@@) $ 1519 - عبد الله بن الحسين بن سعد القطربلي أبو محمد الكاتب، كان من خواص سيدنا " ري " عليه السلام وقد يقال القطربلي وكان من وجوه أهل الأدب، له كتاب التاريخ " جش " ويظهر من كونه من خواص " ري " عليه السلام جلالته بل وثاقته.(@)(@@)(@@)(@@) $ 1520 - عبد الله بن سعيد بن حيان بن أبحر الكناني أبو عمر الطيب، شيخ من أصحابنا ثقة، وأخوه عبد الملك عمر إلى سنة أربعين ومائتين، له كتاب الديات، رواه عن آبائه وعرضه على الرضا عليه السلام وهو في التالية أيضا كما لا يخفى.(@)(@@)(@@)(@@) $ 1521 - عبد الله بن عامر بن عمران بن أبي عمر الأشعري أبو محمد، شيخ من وجوه أصحابنا ثقة " صه " " جش " له كتاب عنه ابن أخيه الحسين بن محمد بن عامر " جش " وفي " مشكا " ابن عمران الثقة الحسين بن محمد بن عامر عن عمه. PageV01P241(@)(@@)(@@)(@@) $ 1522 - عبد الله بن العلاء المزاري أبو محمد، ثقة من وجوه أصحابنا، عنه ابن همام، وقد يقال: ابن أبي العلاء، والمزار بلد بين واسط والبصرة، وعن " شه " الموجود في " جش " عبد الله بن أبي العلاء.(@)(@@)(@@)(@@) $ 1523 - عبد الله بن علي بن الحسين بن زيد بن علي بن الحسين عليهما السلام روى عن الرضا عليه السلام وفي " ست " له كتاب، وفي " مشكا " ابن علي بن الحسين بن زيد " عقد " عن رجاله عنه وابنه محمد وهو عن الرضا عليه السلام.(@)(@@)(@@)(@@) $ 1524 - عبد الله بن علي بن عمران القرشي أبو الحسن المخزومي الذي يعرف بالميمون، فاسد المذهب والرواية، كما في " صه " عن " جش " في ترجمة عمران بن عبد الله القمي.(@)(@@)(@@)(@@) $ 1525 - عبد الله بن عمرو بن الأشعث، له كتاب عنه هارون بن مسلم " ست " وهو في التالية أيضا بملاحظة 