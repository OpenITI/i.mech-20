ms41	 رقاب تيم % على مضض فقد ضرع الخدود % 60(@)(@@) % % وقالا سوف تبهرك الصعود % 61(@)(@@) % أتيم تجعلون إلى تميم ، % بعيد فضل بينهما بعيد % PageV01P156 62(@)(@@) % كساك اللؤم لؤم أبيك تيم % سرابيلا ، بنائقهن سود % 63(@)(@@) % قدرن عليهم وخلقن منهم % فما يبلين ما بقى الجلود % 64(@)(@@) % ومقرفة اللهازم من عقال ، % مؤرثها جبير أو لبيد % 65(@)(@@) % يرى الأعداء دوني من تميم % هزبرا لا تقاربه الأسود % % 66(@)(@@) % لعمر أبيك ما سنحت لتيم % أيامن يزدجرن ولا سعود % 67(@)(@@) % وضعت مواسما بأنوف تيم ، % و قد جدعت أنف من أريد % 68(@)(@@) % نقارعهم وتسأل بنت تيم : % أرخف زبد أيسر أم نهيد % 69(@)(@@) % فذاك ولا ترمز قين ليلى % % على كير يثقب فيه عود % % 70(@)(@@) % كساك الحنطبي كساء صوف % ومرعزى فأنت به تغيد % 71(@)(@@) % و شداد كساك كساء لؤم % فأما المخزيات فلا تبيد % PageV01P157 72(@)(@@) % إذا ما قرب الشهداء يوما % فما للتيم يومئذ شهيد % 73(@)(@@) % غشوا ناري فقلت : هوان تيم % % تصلوها فقد حمي الوقود % 74(@)(@@) % وفدنا حين أغلق دون تيم % شبا الأبواب وانقطع الوفود % 75(@)(@@) % و قدنا كل أجرد أعوجي % تعارضه عذافرة ورود % 76(@)(@@) % كما يختب معتدل مطاه % إلى وشل بذي الردهات سيد % % PageV01P158 البحر : كامل تام 1(@)(@@) % أهوى أراك برامتين وقودا % % أم بالجنينة من مدافع أودا % % 2(@)(@@) % بان الشباب فودعاه حميدا ؛ % هل ما ترى خلقا يعود جديدا % % 3(@)(@@) % يا صاحبي ! دعا الملامة واقصدا % % طال الهوى وأطلتما التفنيدا % % 4(@)(@@) % إن التذكر ، فاعذلاني ، أو دعا ، % بلغ العزاء وأدرك المجلودا % % 5(@)(@@) % لا يستطيع أخو الصبابة أن يرى % % حجرا أصم ، ولا يكون حديدا % % 6(@)(@@) % أخلبتنا ، وصددت ، أم محلم ، % أفتجمعين خلابة وصدودا % % 7(@)(@@) % إني وجدك ، لو أردت زيادة % في الحب عندي ما وجدت مزيدا % % 8(@)(@@) % يا مي ويحك أنجزي الموعودا % % وارعى بذاك أمانة وعهودا % % 9(@)(@@) % قالت نحاذر ذا شذاة باسل % غيران يزعم في السلام حدودا % 10(@)(@@) % رمت الرماة فام تصبك سهامهم % حلقا يدال شكه مسرودا % % PageV01P159 11(@)(@@) % إنا لنذكر ما يقال ضحى غد ، % خلل الحجال سوالفا وخدودا % % 12(@)(@@) % و رجا العواذل أن يطعن ولم أزل % من حبكم كلف الفؤاد عميدا 
ms42	 % % 13(@)(@@) % أصرمت إذ طمع الوشاة بصرمنا % % صبا لعمرك يا أميم ودودا % % 14(@)(@@) % و نرى كلامك لو ينال بغرة % ودنو دارك ، لو علمت خلودا % % 15(@)(@@) % إن كان دهرك ما يقول حسودنا % % فلقد عصيت عواذلا وحسودا % % 16(@)(@@) % نام الخلى وما رقدت لحبكم % % ليل التمام تقلبا وسهودا % % 17(@)(@@) % وإذا رجوت بأن يقربك الهوى % كان القريب لما رجوت بعيدا % 18(@)(@@) % ما ضر أهلك أن يقول أميركم % قولا لزائرك الملم سديدا % % 19(@)(@@) % حلأت ذا سقم يرى لشفائه % وردا ويمنع أن يروم ورودا % 20(@)(@@) % أبنو قفيرة يبتغون سقاطنا % % حشرت وجوه بني قفيرة سودا % % PageV01P160 21(@)(@@) % أخزى اله بي قفيرة إنهم % لا يتقون ، من الحرام ، كؤودا % % 22(@)(@@) % إني ابن حنظلة الحسان وجوههم % و الأعظمين مساعيا وجدودا % % 23(@)(@@) % والأكرمين مركبا ، إذ ركبوا ، % و الأطيبين من التراب صعيدا % % 24(@)(@@) % و لهم مجالس لا مجالس مثلها % % حسبا يؤثل طارفا وتليدا % % 25(@)(@@) % إنا إذا قرع العدو صفاتنا ، % لاقوا لنا حجرا أصم صلودا % % 26(@)(@@) % ما مثل نبعتنا أعز مركبا ، % وأقل قادحة ، وأصلب عودا % % 27(@)(@@) % إنا لنذعر ، يا قفير ، عدونا % % بالخيل لاحقة الأياطيل قودا % % 28(@)(@@) % كس السنابك شزبا أقرابها % % مما أطال غزاتها التقويدا % % 29(@)(@@) % أجرى قلائدها وخدد لحمها % % ألا يذقن مع الشكائم عودا % % 30(@)(@@) % و طوى الطراد مع القياد بطونها % % طي التجار بحضرموت برودا % % PageV01P161 31(@)(@@) % جردا معاودة الغوار سوابحا ، % تدنى إذا قذف الشتاء جليدا % % 32(@)(@@) % تسقى الصريح فما تذوق كرامة % حد الشتاء لدى القباب مديدا % % 33(@)(@@) % نحن الملوك إذا أتوا في أهلهم % و إذا لقيت بنا رأيت أسودا % % 34(@)(@@) % اللابسين لكل يوم حفيظة % حلقا يداخل شكه مرودا % % 35(@)(@@) % سائل ذوي يمن وسائلهم بنا % % في الأزد إذ ندبوا لنا مسعودا % % 36(@)(@@) % فأتاهم سبعون ألف مدجج % متلبسين يلامقا وحديدا % % 37(@)(@@) % قوم ترى صدأ الحديد عليهم % و القبطري من اليلامق سودا % % 38(@)(@@) % أمسى الفرزدق ، يا نوار ، كأنه % قرد يحث على الزناء قرودا % % 39(@)(@@) % ما كان يشهد في المجامع مشهدا % فيه صلاة ذوي التقى مشهودا % % 40(@)(@@) % ولقد تركتك يا فرزدق خاسئا % لما كبوت لدى الرهان لهيدا % % PageV01P162 41(@)(@@) % ونكر 
ms43	 محمية ، وتمنع سرحنا % % جرد ترى لمغارها أخدودا % % 42(@)(@@) % نبني على سنن العدو بيوتنا % % لا نستجير ، ولا نحل حريدا % % 43(@)(@@) % منا فوارس منعج وفوارس % شدوا وثاق الحوفزان بأودا % % 44(@)(@@) % فلرب جبار قصرنا ، عنوة ، % ملك بجر سلاسلا وقيودا % % 45(@)(@@) % و منازل الهرماس تحت لوائه % فحشاه معتدل القناة سديدا % % 46(@)(@@) % و لقد جنبنا الخيل وهي شوازب % متسربلين مضاعفا مسرودا % % 47(@)(@@) % ورد القطا زمرا تبادر منعجا ، % أو من خوارج حايرا مورودا % 48(@)(@@) % و لقد حركن بلآآل كعب عركة % بلوى جراد فلم يدعن عميدا % % 49(@)(@@) % إلا قتيلا قد سلبنا بزه ، % تقع النسور عليه أو مصفودا % % 50(@)(@@) % و أبرن من بكر قبائل جمة % ومن الأراقم قد أبرن جدودا % % PageV01P163 51(@)(@@) % وبني أبي بكر وطئن وجعفرا ، % وبني الوحيد فما تركن وحيدا % % 52(@)(@@) % و لقد جريت فجئت أول سابق % عند المواطن مبديا ومعيدا % % 53(@)(@@) % و جهدت جهدك يا فرزدق كله % فنزعت لا ظفرا ولا محمودا % % 54(@)(@@) % إنا وإن رغمت أنوف مجاشع % خير فوارس منهم ووفودا % % 55(@)(@@) % نسري إذا سرت النجوم وشبهت % بقرا ببرقة عالج مطرودا % % 56(@)(@@) % قبح الإله مجاشعا ، وقراهم ، % والموجفات إذا وردن زرودا % % PageV01P164 البحر : طويل 1(@)(@@) % لعال فراق الحي للبين عامدي % % عشية قارات الرحيل الفوارد % 2(@)(@@) % لعمر الغواني ما جزين صبابتي % % بهن ولا تحبير نسج القصائد % 3(@)(@@) % و كم من صديق واصل قد قطعنه % وفتن من مستحكم الدين عابد % 4(@)(@@) % فان التي يوم الحمامة قد صبا % % لها قلب تواب إلى الله ساجد % 5(@)(@@) % رأيت الغواني مولعات لذي الهوى % بحسن المنى و البخل عند المواعد % 6(@)(@@) % لقد طال ما صدن القلوب بأعين % إلى قصب زين البرى والمعاضد % 7(@)(@@) % أتعذر أن أبديت ، بعد تجلد ، % شوا كل من حب طريف وتالد % 8(@)(@@) % ونطلب ودا منك لو نستفيده % لكان إلينا من أحب الفوائد % 9(@)(@@) % فلا تجمعي ذكر الذنوب لتبخلى % % علينا وهجران المدل المباعد % 10(@)(@@) % إذا أنت زرت الغانيات على العصا % % تمنين أن تسقى دماء الأساود % PageV01P165 11(@)(@@) % أعف عن الجار القريب مزاره % وأطلب أشطان الهموم الأباعد % 12(@)(@@) % لقد كان داء بالعراق فما لقوا 
ms44	 % % طبيبا شفى أدواءهم مثل خالد % 13(@)(@@) % شفاهم برفق خالط الحلم والتقى % % و سيرة مهدي إلى الحق قاصد % 14(@)(@@) % فإن أمير المؤمنين حباكم % بمستبصر في الدين زين المساجد % 15(@)(@@) % وإنا لنرجو أن ترافق رفقة % يكونون للفردوس أول وارد % 16(@)(@@) % فان ابن عبد الله قد عرفت له % مواطن لا تخزيه عند المشاهد % 17(@)(@@) % فأبلى أمير المؤمنين أمانة ؛ % و أبلاه صدقا في الأمور الشدائد % 18(@)(@@) % إذا ما أراد الناس منه ظلامة % أبى الضيم فاستعصى على كل قائد % 19(@)(@@) % وكيف يروم الناس شيئا منعته % هوى بين أنياب الليوث الحوارد % 20(@)(@@) % إذا جمع الأعداء أمر مكيدة % لغدر كفاك الله كيد المكايد % PageV01P166 21(@)(@@) % تعد سرابيل الحديد مع القنا ، % و شعث النواصي كالضراء الطوارد % 22(@)(@@) % فروع وأصل من بجيلة في الذرى ، % تتفس من جياشة ذات عاند % 23(@)(@@) % و إن فتن الشطان أهل ضلالة % لقوا منك حربا حميها غير بارد % 24(@)(@@) % إذا كان أمن كان قلبك مؤمنا ؛ % وإن كان خوف كنت أحكم ذائد % 25(@)(@@) % و ما زلت تسمو للمكارم والعلا % % و تعمر عزا مستنير الموارد % 26(@)(@@) % إذا عد أيام المكارم فافتخر % بآبائك الشم ، الطوال السواعد % 27(@)(@@) % فكم لك من بان طويل بناؤه % وفي آل صعب من خطيب ووافد % 28(@)(@@) % يسرك أيام المحصب ذكرهم % وعند مقام الهدي ذات القلائد % 29(@)(@@) % تمكنت في حي معد من الذرى % % وفي يمن أعلى كريم الموالد % 30(@)(@@) % فروع وأصل من بحلية في الذذرى % % إلى ابن نزار كان عما ، ووالد % PageV01P167 31(@)(@@) % حميت ثغور المسلمين فلم تضع % وما زلت رأسا قائدا وابن قائد % 32(@)(@@) % فإنك قد أعطيت نصرا على العدى % % فأصبحت نورا ضوءه غير خامد % 33(@)(@@) % بنيت بناء ما بنى الناس مثله % يكاد يساوى سوره بالفراقد % 34(@)(@@) % و أعطيت ما أعي القرون التي مضت % فنحمد مفضالا ولي المحامد % 35(@)(@@) % فان الذي أنفقت حزم وقوة % فأبشر بأضعاف من الربح زائد % 36(@)(@@) % لقد كان في أنهار دجلة نعمة % وحظوة جد للخليفة صاعد % 37(@)(@@) % عطاء الذي أعطى الخليفة ملكه % و يكفيه تزفار النفوس الحواسد % 38(@)(@@) % جرت لك أنهار بيمن 
ms45	 وأسعد % إلى جنة في صحصحان الأجالد % 39(@)(@@) % ينتبن أعنابا ونخلا مباركا % وأنقاء بر في جرون الحصائد % 40(@)(@@) % إذا ما بعثنا رائدا يبتغي الندى % % أتانا بحمد الله أحمد رائد % PageV01P168 41(@)(@@) % فهل لك في عان وليس بشاكر % فتطلقه من طول عض الحدائد % 42(@)(@@) % يعود و كان الخبث منه سجية % وإن قال : إني معتب غير عائد % 43(@)(@@) % ندمت ، وما تغني الندامة بعدما % % تطوحت من صك البزاة الصوائد % 44(@)(@@) % وكيف نجاة للفرزدق بعدما % % ضغا وهو في أشداق أغلب حارد % 46(@)(@@) % ألم تر كفي خالد قد أفادتا % % على الناس ردفا من كثير الروافد % % 47(@)(@@) % بني مالك إن الفرزدق لم يزل % كسوبا لعار المخزيات الخوالد % 48(@)(@@) % فلا تقبلوا ضرب الفرزدق إنه % هو الزيف ينفي ضربه كل ناقد % 49(@)(@@) % و إنا وجدنا إذ وفدنا عليكم % صدور القنا والخيل أنجح وافد % 50(@)(@@) % ألم تر يربوعا إذا ما ذكرتهم % وأيامهم شدوا متون القصائد % 51(@)(@@) % فمن لك ، إن عددت ، مثل فوارسي % % حووا حكما والحضرمي بن خالد % PageV01P169 52(@)(@@) % أسال له النهر المبارك فارتمى % % بمثل الروابي المزبدات الحواشد % 53(@)(@@) % فزد خالدا مثل الذي في يمينه ، % تجده عن الإسلام أكرم ذائد % 54(@)(@@) % كأني ولا ظلما أخاف لخالد % من الخوف أسقى من سمام الأساود % 55(@)(@@) % وإني لأرجو خالدا أن يفكني ، % و يطلق عني مقفلات الحدائد % 56(@)(@@) % تكشفت الظلماء عن نور وجهه % لضوء شهاب ضوءه غير خامد % 57(@)(@@) % ألا تذكرون الرحم أو تقرضونني % % لكم خلقا من واسع الخلق ماجد % 58(@)(@@) % لكم مثل كفي خالد حين يشتري % % بكل طريف كل حمد وتالد % 59(@)(@@) % فإن يك قيدي رد همي فربما % % تناولت أطراف الهموم الأباعد % 60(@)(@@) % من الحاملات الحمد لما تكشفت % ذلاذلها واستورأت للمناشد % 61(@)(@@) % فهل لابن بلاء غير كل عشية % و كل صباح زائد غير عائد % PageV01P170 62(@)(@@) % يقول لي الحداد هل أنت قائم % و ما أنا إلا مثل آخر قاعد % 63(@)(@@) % كأني حروري ضله فوق كعبة % ثلاثون قينا من صريم وكايد % 64(@)(@@) % و ما إن بدين ظاهر وا فوق ساقه % و قد علموا أن ليس ديني بنافد 
ms46	 % 65(@)(@@) % و يروى على الشعر ما أناقلته % كمعترض للريح بين الطرائد % PageV01P171 البحر : كامل تام 1(@)(@@) % أمسى فؤادك ذا شجون مقصدا ، % لو أن قلبك يستطيع تجلدا % % 2(@)(@@) % هاج الفؤاد بذي كريب دمنة ، % أو بالأفاقة منزل من مهددا % % 3(@)(@@) % أفما يزال يهيج منك صبابة % نؤي يحالف خالدات ركدا % % 4(@)(@@) % خبرت أهلك أصعدوا من ذي الصفا % % سقيا لذلك من فريق أصعدا % % 5(@)(@@) % و عرفت بينهم فهاج صبابة % صوت الحمام ، إذا الهديل تغردا % % 6(@)(@@) % علقتها عرضا ويلفى سرها % % منمى الأنوق بيضها أو أبعدا % % 7(@)(@@) % تشجى خلاخلها خدال فعمة % و ترى السوار تزينه والمعضدا % % 8(@)(@@) % منع الزيارة والحديث إليكم % غير أن حرب دونكم فاستأسدا % % 9(@)(@@) % باعدن أن وصالهن خلابة ، % و لقد جمعن مع البعاد تحقدا % % 10(@)(@@) % أنكرن عهدك بعدما عرفنه % وفقدن ذا القصب الغداف الأسودا % % PageV01P172 11(@)(@@) % وإذا الشيوخ تعرضوا لمودة ، % قلن التراب لكل شيخ أدردا % % 12(@)(@@) % تلقى الفتاة من الشيوخ بلية ، % إن البلية كل شيخ أفندا % % 13(@)(@@) % و تقول عاذلة رخي بالها % % ما بال نومك لا يزال مسهدا % % 14(@)(@@) % لو تعلمين هما داخلا % % هما طوارقه منعن المرقدا % % 15(@)(@@) % و كأن ركبك والمهاري تفتلي % % هاجوا من الأدمى النعام الأبدا % % 16(@)(@@) % و العيس تنتعل الظلال كأنها % % نبعت أخادعها الكحيل المعقدا % % 17(@)(@@) % يعلون في صدر وورد باكر % أم الطريق إذا الطريق تبددا % % 18(@)(@@) % تنفي حصى القذفات عن عادية % وترى مناحيه تشق القرددا % % 19(@)(@@) % ويلوح في قبل النجاد إذا انتحى % نهجا يضر بكل رعن أقودا % % 20(@)(@@) % يا ابن الخليفة ، يا معاوي ، إنني % % أرجو فضولك فاتخذ عندي يدا % % PageV01P173 21(@)(@@) % إنا لنأمل منك سيبا عاجلا % يا ابن الخليفة ثم نرجوكم غدا % % 22(@)(@@) % آباؤك المتخيرون ، أولو النهى ، % يا ابن الخضارم يترعون المرفدا % % 23(@)(@@) % وجدوا معاوية ، المبارك عزمه ، % صلب القناة عن المحارم مذودا % % 24(@)(@@) % لما توجه بالجنود ، وأدربوا ، % لاقى الأيامن يتبعن الأسعدا % % 25(@)(@@) % يلقى العدو على الثغور جياده ، % أبدأن ثم ثنين فيها عودا % % 26(@)(@@) % لا زال ملككم ، وأنتم أهله ، % والنصر ما خلد الجبال مخلدا % % 27(@)(@@) % إن امرأ كبت العدو ، ويبتني % % فينا المحامد حقه 
ms47	 أن يحمدا % % 28(@)(@@) % أخزى الذي سمك السماء عدوكم % وورى بغيظكم الصدور الحسدا % % 29(@)(@@) % وإذا جررت إلى العدو كتائبا ، % رعبت مخافتك القلوب الصددا % % 30(@)(@@) % أما العدو فقد أبحت ديارهم % و تركت أمنع كل حصن مبلدا % % PageV01P174 31(@)(@@) % فتح الإله على يديك برغمهم % وملأت أرضهم حريقا موقدا % % 32(@)(@@) % و لقد أبحت من العقاب منازلا % نرجو بذلك أن تنال الفرقدا % % 33(@)(@@) % و لقد جمعت حماية وتكرما % من غار يعلمه ومن قد أنجدا % % 34(@)(@@) % لما رأتك على العقاب ملوكهم % ألقوا سلاحهم وخروا سجدا % % 35(@)(@@) % عادات خيلك أن يبتن عوابسا % بالدارعين ، ولا تراها رودا % % 36(@)(@@) % ما إن نزلت بمشركين بربهم % إلا تركت عظيمهم مستعبدا % % 37(@)(@@) % كان ابن سيسن طاغيا فرددته % رخو الأخادع في الكبول مقيدا % % 38(@)(@@) % أبلى معاوية البلاء ، ولم يزل % ميمون منقبة تراه مسددا % % PageV01P175 البحر : طويل 1(@)(@@) % غدا باجتماع الحي نقضي لبانة % و أقسم لا تقضى لبانتنا غدا % % 2(@)(@@) % إذا صدع البين الجميع وحاولت % بقو شماليل النوى أن تبددا % % 3(@)(@@) % و أصبحت الأجزاع ممن يحلها % % قفارا ، فما شاء الحمام تغردا % % 4(@)(@@) % أجالت عليهن الروامس بعدنا % % دقاق الحصى من كل سهل وأجلدا % % 5(@)(@@) % لقد قادني من حب ماوية الهوى % % و ما كان يلقاني الجنيبة أقودا % % 6(@)(@@) % وأحسد زوار الأوانس كلهم ، % و قد كنت فيهن الغيور المحسدا % % 7(@)(@@) % أعد لبيوت الأمور إذا سرت % جمالية حرفا ، وميساء مفردا % % 8(@)(@@) % لها مجزم يطوى على صعدائها ، % كطى الدهاقين البناء المشيدا % % 9(@)(@@) % وقد أخلفت عهد السقاب بجاذب % طوته حبال الرحل حتى تجددا % % 10(@)(@@) % و زافت كما زاف القريع مخاطرا % ولف القرى والحالبان فألبدا % % PageV01P176 11(@)(@@) % وتصبح يوم الخمس وهي شملة % مروحا تقالى الصحصحان العمردا % % 12(@)(@@) % أقول له يا عبد قيس صبابة % بأي ترى مستوقد النار أوقدا % % 13(@)(@@) % فقال أرى نارا يشب وقودها % % بحيث استفاض الجزع شيحا وغرقدا % % 14(@)(@@) % أحب ثرى نجد وبالغور حاجة ، % فغار الهوى يا عبد قيس وأنجدا % % 15(@)(@@) % وإني لمن قوم تكون خيولهم % بثغر ، وتلقاهم مقانب قودا % % 16(@)(@@) % يحشون نيران الحروب بعارض % علته نجوم البيض حتى توقدا % % 17(@)(@@) % وكنا إذا 
ms48	 سرنا لحي بأرضهم % تركناهم قتلى ، وفلا مشردا % % 18(@)(@@) % ومكتبلا في القد ليس بنازع % له من مراس القد رجلا ولا يدا % % 19(@)(@@) % و إني لتبتز الرئيس فوارسي % % إذا كل عجعاج منض الخور عردا % % 20(@)(@@) % رددنا بخبراء العناب نساءكم % و قد قلن عتق اليوم أو رقنا غدا % % PageV01P177 21(@)(@@) % فأصبحن يزجرن الأيامن أسعدا % % وقد كن لا يزجرن بالأمس أسعدا % % 22(@)(@@) % فما عبت من نار أضاء وقودها % % فراسا وبسطام بن قيس مقيدا % % 23(@)(@@) % و أوقدت بالسيدان نارا ذليلة % و عرفت من سوءات جعثن مشهدا % % 24(@)(@@) % أضاء وقود النار منها بصيرة ، % و عبرة أعمى همه قد ترددا % % 25(@)(@@) % كأن يدعون جعثن وركت % على فالج من بخت كرمان أحردا % % 28(@)(@@) % و أورثني الفرعان سعد ومالك % سناء وعزا في الحياة مخلدا % % 29(@)(@@) % متى أدع بين ابني مغداة تلقني % % إلى لوذ عز طامح الرأس أصيدا % % 30(@)(@@) % أحل إذا شئت الاياد وحزنه % وإن شئت أجزاع العقيق فجلعدا % % 31(@)(@@) % فلو كان رأي في عدى بن جندب % رأوا ظلمنا لابني سميرة أنكدا % % 32(@)(@@) % أيشهد مثغور علينا وقد رأى % % سميرة منا في ثناياه مشهدا % % PageV01P178 33(@)(@@) % متى ألق مثغورا على سوء ثغره % أضع فوق ما أبقى من الثغر مبردا % % 34(@)(@@) % منعناكم حتى ابتنيتم بيوتكم % وأصدرا راعيكم بفلح وأوردا % % 35(@)(@@) % بشعث على شعث مغاوير بالضحى ، % إذا ثوب الداعي لروع ونددا % % 36(@)(@@) % كراديس أو رادا بكل مناجد % تعود ضرب البيض فيما تعودا % % 37(@)(@@) % إذا كف عنه من يدي حطمية % وأبدى ذراعي شيظم قد تخددا % % 38(@)(@@) % على سابح نهد يشبه بالضحى % % إذا عاد الركض سيدا عمردا % % 39(@)(@@) % أرى الطير بالحجاج تجرى أيامنا % % لكم يا أمير المؤمنين وأسعدا % % 40(@)(@@) % رجعت لبيت الله عهد نبيه % وأصلحت ما كان الخبيبان أفسدا % % 41(@)(@@) % فما مخدر ورد بخفان زأره % إلى القرن زجر الزاجرين توردا % % 42(@)(@@) % بأمضى من الحجاج في الحرب مقدما % إذا بعضهم هاب الخياض فعردا % % PageV01P179 43(@)(@@) % تصدى صناديد العراق لوجهه % وتضحي له غر الدهاقين سجدا % % 44(@)(@@) % و للقين والخنزير مني بديهة % و إن عاودوني كنت للعود أحمدا % % PageV01P180 البحر : وافر تام 
ms49	 1(@)(@@) % سمت لي نظرة ، فرأيت برقا % تهاميا ، فراجعني ادكاري % % 2(@)(@@) % يقول الناظرون إلى سناه % نرى بلقا شمسن على مهار % 3(@)(@@) % لقد كذبت عداتك أم بشر % و قد طالت أناتي وانتظاري % % 4(@)(@@) % عجلت إلى ملامتنا وتسرى % % مطايانا ، وليلك غير ساري % % 5(@)(@@) % فهان عليك ما لقيت ركابي % % وسيري في الملمعة القفار % 6(@)(@@) % و أيام أتين على المطايا % % كأن سمومهن أجيج نار % % 7(@)(@@) % كن على مغابنهن هجرا % كحيل الليت أو نبعان قار % 8(@)(@@) % لقد أمسى البعيث بدار ذل % وما أمسى الفرزدق بالخيار % 9(@)(@@) % جلاجل كرج وسبال قرد % % و زند من قفيرة غير وارى % % 10(@)(@@) % عرفنا من قفيرة حاجبيها ، % و جذا في أناملها القصار % % PageV01P181 11(@)(@@) % تدافعنا فقال بنو تميم % كأن القرد طوح من طمار % % 12(@)(@@) % أطامعة قيون بني عقال % بعقبي حين فاتهم حضاري % % 13(@)(@@) % وقد علمت بنو وقبان أني % % ضبور الوعث معتزم الخبار % 14(@)(@@) % بيربوع فخرت وآل سعد % فلا مجدي شمسه رهج الغبار % 15(@)(@@) % عتيبة والأحيمر وابن سعد % و عتاب وفارس ذي الخمار % % 16(@)(@@) % ويوم بني جذيمة إذ لحقنا % % ضحى بين الشعيبة والعقار % 17(@)(@@) % وجوه مجاشع طليت بلؤم % يبين في المقلد والعذار % 18(@)(@@) % وحالف جلد كل مجاشعي % قميص اللؤم ليس بمستعار % 20(@)(@@) % أغركم الفرزدق من أبيكم % و ذكر مزادتين على حمار % 21(@)(@@) % وجدنا بيت ضبة في معد % كبيت الضب ليس له سواري % % PageV01P182 22(@)(@@) % وجدناهم قناذع ملزقات % بلا نبع نبتن ، ولا نضار % PageV01P183 البحر : كامل تام 1(@)(@@) % سقيا لنهي حمامة وحفير ، % بسجال مرتجز الرباب مطير % 2(@)(@@) % سقيا لتلك منازلا هيجنني % % وكأن باقيهن وحي زبور % 3(@)(@@) % كم قد رأيت وليس شيء باقيا % من زائر طرف الهوى ومزور % 5(@)(@@) % لا تفخرن ، وفي أديم مجاشع % حلم فليس سيوره بسيور % 6(@)(@@) % أبني شعرة لم نجد لمجاشع % حلما يوازن ريشة العصفور % 7(@)(@@) % إنا لنعلم ما غدا لمجاشع % وفد ، وما ملكوا وثاق أسير % 8(@)(@@) % ماذا رجوت من العلالة بعدما % % نقضت حبالك واستمر مريري % % 9(@)(@@) % إن الفرزدق حين يدخل مسجدا % رجس فليس طهوره بطهور % 10(@)(@@) % إن الفرزدق لا يبالي محرما % % 12(@)(@@) % رهط الفرزدق 
ms50	 من نصارى تغلب % أو يدعى كذبا دعاوة زور % PageV01P184 13(@)(@@) % حجوا الصليب وقربوا قربانكم % وخذوا نصيبكم من الخنزير % 14(@)(@@) % إني سأخبر عن بلاء مجاشع % من كان بالخبات غير خبير % 15(@)(@@) % أخزى بني وقبان عقر فتاتهم % و اعتر جارهم بحبل غرور % 17(@)(@@) % قال الزبير وأسلمته مجاشع % لا خير في دنس الثياب غدور % 18(@)(@@) % يا شب قد ذكرت قريش غدركم % بين المحصب من منى ، وثبير % 19(@)(@@) % وغدا الفرزدق حين فارق منقرا % في غير عافية وغير سرور % 21(@)(@@) % خزى الفرزدق بعد وقعة سبعة % كالحصن من ولد الأشد ذكور % 24(@)(@@) % أمت هنيدة خزية لمجاشع % إذ أولمت لهم بشر جزور % 25(@)(@@) % ركبت ربابكم بعيرا دارسا ، % في السوق أفضح راكب وبعير % 26(@)(@@) % ودعت غمامة بالوقيط مجاشعا % فوجدت يا وقبان غير غيور % PageV01P185 27(@)(@@) % كذب الفرزدق لن يجاري عامرا % يوم الرهان بمقرف مبهور % 28(@)(@@) % فانه الفرزدق أن يعيب فوارسا % حملوا أباه على أزب نفور % 29(@)(@@) % و لقد جهلت بشتم قيس بعد ما % % ذهبوا بريش جناحك المكسور % 30(@)(@@) % قيس وجد أبيك في أكياره % قواد كل كتيبة جمهور % 31(@)(@@) % لن تدركوا غطفان لو أجريتم % يا ابن القيون ولا بني منصور % 32(@)(@@) % فخروا عليك بكل سام معلم % فافخر بصاحب كلبتين وكير % 33(@)(@@) % كم أنجبوا بخليفة وخليفة % و أمير صائفتين وابن أمير % 34(@)(@@) % ولد الحواصن في قريش منهم ، % يا رب مكرمة ولدن وخير % 35(@)(@@) % فضلوا بيوم مكارم معلومة % يوم أغر محجل مشهور % 36(@)(@@) % قيس تبيت على الثغور جيادهم % و تبيت عند صواحب الماخور % PageV01P186 37(@)(@@) % هل تذكرون بلاءكم يوم الصفا % % أو تذكرون فوارس المأمور % 38(@)(@@) % أود ختنوس غداة جز قرونها % % ودعت بدعوة ذلة وثبور % 40(@)(@@) % خان القيون وقدموا يوم الصفا % % وردا ، فغور أسوأ التغوير % 41(@)(@@) % و سما لقيط يوم ذاك لعامر % فاستنزلوه بلهذم مطرور % PageV01P187 البحر : كامل تام 1(@)(@@) % أتزور أم محمد ، أم تهجر % أم عاد قلبك بعض ما تتذكر % 2(@)(@@) % إن الفوادر لو سمعن كلامها ، % ظلت وعول عمايتين تحدر % % 3(@)(@@) % لا تنس حلمك ، إن مالك معهم % قدر ولست بسابق ما يقدر % 4(@)(@@) % سرت الهموم 
ms51	 مع النجوم فكلفت % حاجا يكلفه السمام الضمر % 5(@)(@@) % هن الغياث إذا تهولت السرى % % وإذا توقد في النجاد الحزور % 6(@)(@@) % أجهضن معجلة لستة أشهر % مثل الفراخ جلودهن تمور % 7(@)(@@) % قال البعيث أنا ابن بيبة دعوة % كذب البعيث ، وأنفه يتقشر % 8(@)(@@) % أنت البعيث تبين فيه عبودة ، % و أبوك عبد بني زرارة بغثر % PageV01P188 البحر : بسيط تام 1(@)(@@) % قد غير الحي بعد الحي إقفار % كأنه مصحف يتلوه أخبار % 2(@)(@@) % ما كنت جربت من صدق ولا صلة % للغانيات ، ولا عنهن إقصار % 3(@)(@@) % أسقي المنازل بين الدام والأدمى ، % عين تحلب بالسعدين مدرار % % 4(@)(@@) % كأنما برقها والودق منضرج % بلق تكشف بين البلق أمهار % 6(@)(@@) % يا شب ! إن الحبارى لن يناظرها % % مستحلم أسفع الخدين مبكار % % 8(@)(@@) % يا شب لن يستطيع الحرب إذ حميت % عظم خريع ، وفيه المخة الرار % 9(@)(@@) % يا شب ما زال في قيس لآنفكم % رغم ورغم وأوتار وأوتار % 10(@)(@@) % يا شب ويحك لا تكفر فوارسنا % % يوم ابن كبشة عاتي الملك جبار % 11(@)(@@) % لولا حماية يربوع نساءكم % % كانت لغيركم منهن أطهار % 12(@)(@@) % حامى المسيب والخيلان في رهج % أزمان شبة لا يحمي ، ونعار % PageV01P189 13(@)(@@) % إذ لا عقال يحامى عن ذماركم % و لا زرارة لا يحمى وزرار % % 14(@)(@@) % إن الحواري لو نادى فوارسنا ، % لاستشهدوا أو نجا و القوم أحرار % 15(@)(@@) % إن الفرزدق من يعلق زيارته % يوبق برجس ، وللسوآت زوار % 16(@)(@@) % إن الفرزدق يا مقداد زائركم % % يا ويل قد على من تغلق الدار % % 17(@)(@@) % أين المحامون من أولاد مسلمة % أم أين أين بنو بدر وسيار % 18(@)(@@) % ما زال في الدار حام عن ذماركم % عند النساء عذوم النفس مغيار % % PageV01P190 البحر : طويل 1(@)(@@) % ألم خيال هاج وقرا على وقر ، % فقلت : ما حييتم زائر السفر % 2(@)(@@) % بأن ضمير القلب قد شفه الهوى % و خالط هما قد تضمنه صدري % % 3(@)(@@) % و نحن لدى أعضاد خوص مناخة % أصاب عظاما من أخشتها المبرى % % 4(@)(@@) % رفعت ذميلا ناقتني فكأنما % % رفعت على موج عدولية تجري % % 5(@)(@@) % وإما غريري ، فيا لك من نجر % مخرجة راحت إلى أفرخ زعر % 6 
ms52	(@)(@@) % نجاران : إما شدقمي نجارها ، % % 7(@)(@@) % كما اختار رام من هذيل قياسه % براهن من نبع وعطف ما يبرى % % 8(@)(@@) % إذا عمن عوما في الأزمة شبهت % تقلب حيات على ساحل غمر % 9(@)(@@) % تنظرت منظورا ليزجر قومه % فقد عذرتني في انتظارهم عذري % % 10(@)(@@) % و قد شقيت تيم بامر غويها % % و قال لتيم قد أمرتكم أمري % % PageV01P191 11(@)(@@) % أتغتر تيم بالرجيمة وابنها ، % كما اغتر كعب بالملمعة القفر % 12(@)(@@) % فقلت لهم : يا تيم ! مهلا فطالما % % أصختم وزدتم للهوان على الصبر % 13(@)(@@) % إذا سمعت مني حويزة زارة % تحوز داء في حواياهم الأدر % 15(@)(@@) % لقد عجبت قيس وبكر بن وائل % و قالت تميم فيم تيم من الفخر % 16(@)(@@) % فلو غير تيم يفخرون عذرتهم % % أتعيم ، ابن تيم اللؤم ، يا سوأة الدهر % 17(@)(@@) % أتفخر تيم بالضلال ولم يكن % لهم حسب ذاك ولا عدد مثر % 18(@)(@@) % فما فخرت تيم بيوم عظيمة ، % و لا قبضوا إلا بخالفة صفر % 19(@)(@@) % بني التيم ما للؤم معدى وراءكم % ولا عنكم يا تيم للؤم من قصر % 20(@)(@@) % كسا اللؤم تيما خضرة في وجوهها % % فيا خزي تيم من سرابيلها الخضر % 21(@)(@@) % ولو تستعف التيم أو تحسن القرى % و لكن تيما لا تعف ولا تقرى % % PageV01P192 22(@)(@@) % فمن يك يستغني ويغبط بالغنى % % فما لابن تيم من فعال ولا وفر % 23(@)(@@) % و لو يدفن التيمي ثم دعوته % إلى فضل زاد جاء يسعى من القبر % 24(@)(@@) % ولو شئت غم التيم عمر و ومالك % و طم عليهم قمقمان من البحر % % 25(@)(@@) % ولم تدر تيم ما الأعنة والقنا ، % ولم تدر تيم ما الوراد من الشقر % 27(@)(@@) % تفضل تيم في البراد ولا يرى % % فوارس تيم معلين على الثغر % 28(@)(@@) % و لا يحتبي التيمي قدام بيته % ولا يستر التيمي إلا القدر % 29(@)(@@) % و ألفيت تيما لم أجد حسبا لهم % و عددت سعدا والقبائل من عمرو % % 30(@)(@@) % و قد عمرت تيم زمانا وما يرى % % لنسوة تيم من حفاف ولا خدر % 31(@)(@@) % أتهجون يربوعا وقد رد سيبكم % فوارسهم والبيض يلون بالخمر % 32(@)(@@) % خدمن بني غيظ بن مرة 
ms53	 بعدما % % خدمن النشاوى شروب بني بدر % PageV01P193 33(@)(@@) % لقد أعتقتكم يا بن تيم رماحنا % % و ذبيان تقضيك الغريم من البكر % 34(@)(@@) % إذا استبأوا خمرا نقلتم زقاقهم % إليهم ولا يسقون تيما من الخمر % 35(@)(@@) % وفنا عليكم بالعناجيج والقنا % % و أعناق تيم في خماسية سمر % 36(@)(@@) % ومنت على تيم تميم بنعمة ، % وما عند تيم من وفاء ولا شكر % 40(@)(@@) % و آية لؤم التيم أن لو عددتم % أصابع تيمى نقض من العشر % 41(@)(@@) % فما أوقدوا نارا ولا دل ساريا % على حي تيم من صهيل ولا هدر % 42(@)(@@) % بنو التيم لم يرضوا قديم أبيهم % فنادوا بتيم من يبادل أو يشري % % 43(@)(@@) % وأكرم من تيم أبا قد رميته % بباينة العظمين غائرة السبر % 44(@)(@@) % ونبئت تيما قد هجوني ليذكروا % % فهذا الذي لا يشتهون من الذكر % 45(@)(@@) % لقوا وابلا فيه الصواعق ترتمي % % أواذيه ترمي الجناحين بالصخر % PageV01P194 البحر : بسيط تام 1(@)(@@) % إن النددى من بني ذبيان قد علموا ، % والمجد في آل منظور بن سيار % 2(@)(@@) % الماطرين بأيديهم ندى ديما % بكل غيث من الوسمي مبكار % 3(@)(@@) % تزور جارتهم وهنا جفانهم ، % و ما فتى لهم وهنا بزوار % 4(@)(@@) % ترضى قريش بهم صهرا لأنفسهم % وهم رضى لبني أخت وأصهار % PageV01P195 البحر : كامل تام 1(@)(@@) % راح الرفاق ولم يرح مرار % وأقام بعد الظاعنين وساروا % % 2(@)(@@) % لاتبعدن وكل حي هالك % ولكل مصرع هالك مقدار % 3(@)(@@) % كان الخيار سوى أبيه وعمه ، % ولكل قوم سادة وخيار % 4(@)(@@) % لايسلمون لدى الحوادث جارهم % و هم لمن خشى الحوادث جار % 5(@)(@@) % و أقول من جزع وقد فتنا به % و دموع عيني في الرداء غزار % % 6(@)(@@) % للدافنين أخا المكارم والندى % % لله ما ضمنت بك الأحجار % % 7(@)(@@) % لما غدوا بأغر أروع ماجد % كالبدر تستسقى به الأمطار % 8(@)(@@) % كادت تقطع عند ذلك حسرة % نفسي وقد بعد الغداة مزار % 9(@)(@@) % صلى الإله عليك من ذي حفرة % خلت الديار له فهن قفار % 10(@)(@@) % وسقاك من نوء الثريا عارض % تنهل منه ديمة مدرار % PageV01P196 البحر : كامل تام 1(@)(@@) % أرق العيون فنومهن غرار % إذ لا يساعف من هواك 
ms54	 مزار % 2(@)(@@) % هل تبصر النقوين دون مخفق % أم هل بدت لك بالجنينة نار % 3(@)(@@) % طرقت جعادة واليمامة دونها % % ركبا ، ترجم دونها الأخبار % % 4(@)(@@) % لو زرتنا لرأيت حول رحالنا % % مثل الحني أملها الأسفار % 5(@)(@@) % نزع النجائب سموة من شدقم ، % والأرحبي ، وجدها النطار % % 6(@)(@@) % والعيس يهجمها الهجير كأنما % % يغشى المغابن والذفاري قار % % 7(@)(@@) % أني تحن إلى الموقر بعد ما % % فني العرائك ، والقصائد رار % % 8(@)(@@) % و العيس تسحجها الرحال اليكم % حتى تعرق نفيها الأكوار % 9(@)(@@) % أمست زيارتنا عليم بعيدة % فسقى بلادك ديمة مدرار % % 10(@)(@@) % تروي الأجارع والأعازل كلها ، % و النعف حيث تقابل الأحجار % % PageV01P197 11(@)(@@) % هل حلت الوداء بعد محلنا % % أو أبكر البكرات أو تعشار % 12(@)(@@) % أو شبرمان يهيج منك صبابة ، % لما تبدل ساكن وديار % 13(@)(@@) % و عرفت منصب الخيام على بلى % % و عرفت حيث تربط الأمهار % 14(@)(@@) % علقتها إنسية وحشية % عصماء لو خضع الحديث نوار % % 15(@)(@@) % فترى مشارب حولها حرم الحمى % % و الشرب يمنع والقلوب حرار % % 16(@)(@@) % قد رابني ولمثل ذاك يربيني % % للغانيات تجهم ونفار % 17(@)(@@) % ولقد رأيتك والقناة قويمة ، % إذ لم يشب لك مسحل وعذار % 18(@)(@@) % والدهر بدل شيبة وتحنيا ؛ % والدهر ذو غير ، له أطوار % 19(@)(@@) % ذهب الصبا ونسين إذ أيامنا % % بالجهلتين وبالرغام قصار % 20(@)(@@) % مطل اليدون فلا يزال مطالب % يرجو القضاء وما وعدن ضمار % PageV01P198 21(@)(@@) % يا كعب قد ملأ القبور مهابة % ملك تقطع دونه الأبصار % 22(@)(@@) % هل مثل حاجتنا اليكم حاجة % أو مثل جاري بالموقر جار % 23(@)(@@) % حلما ومكرمة وسيبا واسعا ، % وروافد حلبت إليك غزار % 24(@)(@@) % بدر علا فأنار ، ليس بآفل ، % نور البرية ما له استسرار % 25(@)(@@) % لما ملكت عصا الخلافة بينت ، % للطالبين ، شمائل ونجار % 26(@)(@@) % ساس الخلافة حين قام بحقها ، % و حمى الذمار فما يضاع ذمار % 27(@)(@@) % ويزيد قد علمت قريش أنه % غمر البحور إلى العلى ، سوار % 28(@)(@@) % و عروق نبعتكم لها طيب الثرى % % والفرع لاجعد ولا خوار % 29(@)(@@) % إن الخليفة لليتامى عصمة ، % وأبو العيال يشفه الإقتار % 30(@)(@@) % صلى القبائل من قريش كلهم ، % بالموسمين عليك والأنصار % PageV01P199 31(@)(@@) % ترضى قضاعة ما 
ms55	 قضيت وسلمت ، % لرضى بحكمك حمير ونزار % 32(@)(@@) % قيس يرونك ما حييت لهم حيا % ولآل خندف ملكك استبشار % 33(@)(@@) % و لقد جريت فما أمامك سابق % و على الجوالب كبوة وغبار % % 34(@)(@@) % آل المهلب فرطوا في دينهم % % وطغوا كما فعلت ثمود فباروا % % 35(@)(@@) % إن الخلافة يا ابن دحمة دونها % % لجج تضيق بها الصدور غمار % 37(@)(@@) % هل تذكرون إذا الحساس طعامك % وإذ الصغاوة أرضكم وصحار % 38(@)(@@) % رقصت نساء بني المهلب عنوة % رقص الرئال وما لهن خمار % 39(@)(@@) % لما أتوك مصفدين أذلة ، % شفى النفوس وأدرك الأوتار % PageV01P200 البحر : وافر تام 1(@)(@@) % أهاج الشوق معرفة الديار ، % برهبي الصلب أو بلوى مطار % 2(@)(@@) % و قد كان المنازل مؤنسات % فهن اليوم كالبلد القفار % 3(@)(@@) % وقد لام العواذل في سليمى % % و قل إلى عواذلي اعتذاري % % 4(@)(@@) % وقد حاذرت أهلك ان يبينوا % % فما باليت ، بالأدمى ، حذاري % % 5(@)(@@) % قسيم من فؤادك حيث حلت % بيبرين الأحبة ، أو وبار % 6(@)(@@) % و ما زال الفؤاد اليك صبا % على ضغن لقومك وازورار % 7(@)(@@) % بعيدا ما نظرت بذي طلوح ، % لتبصر بالجنينة ضوء نار % 8(@)(@@) % وما عاب الجلاء ظهور عرق % إذا اجتليت ولا قلق السوار % 9(@)(@@) % و ما شربت بذي سبخ أجاجا % ولا وطئت على رمض الجفار % 10(@)(@@) % و تعجب من شحوبي أم نوح % و ما قاست رواحي وابتكاري % % PageV01P201 11(@)(@@) % وشبهت القلاص وحادييها % % قداحا صكها يسرا قمار % 12(@)(@@) % وكم كلفن دونك من سهوب % ومن ليل يواصل بالنهار % 13(@)(@@) % و مجهول عسفن بنا اليكم % قصير الظل مشتبه الصحاري % % 14(@)(@@) % يخب الآل إذ نشرت صواه % على حزانه خبب المهاري % % 15(@)(@@) % إذا خلجوا الأزمة في براها ، % و ألصقن الموارك بالذفاري % % 16(@)(@@) % وللعباس مكرمة وبيت % على العلياء مرتفع السواري % % 17(@)(@@) % و إن العيس قد رفعت اليكم % بعيد الأهل ، معتمد المزار % 18(@)(@@) % و إنك خير موضع رحل ضيف % و أوفى العالمين بعقد جار % 19(@)(@@) % فيا بن المطعمين إذا شتونا % % ويا ابن الذائدين عن الذمار % 20(@)(@@) % وتمطر من نداك يداك فضلا % إلى كرم الشمائل والنجار % PageV01P202 21(@)(@@) % وتوقد نار مكرمة وأخرى ، % إذا ما عد 
ms56	 مكرمة الفخار % 22(@)(@@) % % إذا ما المحل أخمد كل نار % 23(@)(@@) % و يؤم العقر ألحمت السرايا % % لميمون النقيبة وهو شاردي % % 24(@)(@@) % ثأرت المسمعين وقلت بوؤوا % % بقتل أخي فزارة والخيار % 25(@)(@@) % كأن الخيل بعد قياد حول % قياس النبع شحجهن باري % % 26(@)(@@) % إذا ازداد العمون عمى عرفتم % هدى الإسلام واضحة المنار % PageV01P203 البحر : طويل 1(@)(@@) % خليلي من زفرة قد رددتها % % ومن ظلمة وارت علي ضحى حجرا % % 2(@)(@@) % إذا ما دعا قوم علي أخاهم ، % دعوت فلم أسمع حكيما ولا عمرا % % PageV01P204 البحر : طويل 1(@)(@@) % ألم خيال هاج من حاجة وقرا ، % عليك السلام ما زيارتك السفرا % % 2(@)(@@) % بيهماء غور الماء يمسي دليلها % % من الهول يشكو في مسامعه وقرا % % 3(@)(@@) % ترى الخمس فيها مسلحبا قطاره % % إذا القوم جاروا مثل أن يقتلوا صبرا % % 4(@)(@@) % تشج بها أجواز كل تنوفة % كأن المطايا يتقين بنا جمرا % % 5(@)(@@) % طواها السرى طي الجفون وأدرجت % من الضمر حتى ما تقر لها ضفرا % % 6(@)(@@) % إذا فوزت عن ذي جراول أنجدت % من الغور واعرورت حزابيها الغبرا % % 7(@)(@@) % وما سير شهر كلفته ركابنا ، % و لكنه شهر وصلن به شهرا % % 8(@)(@@) % نوة احل يخبطن السريح اليكم % من الرمل حتى خاض ركبانها البحرا % % 9(@)(@@) % إذا نحن هجنا بالقلاة كأنما % % نهيج غداة الخمس خاضبة زعرا % % 10(@)(@@) % طلبن ابن ليلى من رجاء فضوله % و لولا ابن لبلى ما وردن بنا مصرا % % PageV01P205 11(@)(@@) % حمدتم وبشرنا بفضل نداكم % وكان كشيء قد أحطنا به خبرا % % 12(@)(@@) % إذا ما أناخ الراغبون ببابكم % مع لوفد لم ترجع عيابهم صفرا % % 13(@)(@@) % و قالوا لنا عبد العزيز عليكم % هنالك تلقى الحزم والنائل الغمرا % % 14(@)(@@) % سمت بك خير الوالدات فقابلت % لليلة بدر كان ميقاتها قدرا % % 15(@)(@@) % فجاءت بنور يستضاء بوجهه % له حسب عال ومن ينكر الفجرا % % 16(@)(@@) % ومنسوبة بيضاء من صلب قومها ، % جعلت الرماح الخاطرات لها مهرا % % 17(@)(@@) % إذا الدهم من وقع الأسنة عندها % % حسبن ورادا أو حميلية شقرا % % 18(@)(@@) % وساقت إليكم حاجة لم نجد لها % % وراءكن معدى ولا عنكم قصرا % 19(@)(@@) % أغثني وأصحابي بضامنة القرى ، % كأن بأحقيها مقيرة 
ms57	 وفرأ % % 20(@)(@@) % إذا هي سافت نور كل حديقة % لها أرج أضحت مشافرها صفرا % % PageV01P206 21(@)(@@) % لك الفرع من حيي قريش فلم تضع % إذا عدت المسعاة نجما ولا بدرا % % 22(@)(@@) % تفرعت بيت الأصبغين فلم تجد % بناء يفوق الأصبغين ولا عمرا % % 23(@)(@@) % تخيرهم مروان من بيت رفعة % و كان لهم كفؤا وكان لهم صهرا % % 24(@)(@@) % فإن تميما ، فاعلمن ، أخوكم ، % ومن خير من أبليت عافية شكرا % % 25(@)(@@) % إذا شئتم هجتم تميما فهجتم % ليوث الوغى يهصرن أعداءكم هصرا % % 26(@)(@@) % نقود الجياد المقربات على الوجى % % لأعدائكم حتى أبرناهم قسرا % % PageV01P207 البحر : بسيط تام 1(@)(@@) % من شاء بايعته مالي وخلعته % ما تكمل الخلج في ديوانهم سطرا % % 2(@)(@@) % بقية الخلج أعمى مات قائده ، % قد أذهب الله منه السمع والبصرا % % 3(@)(@@) % لولا ابن ضمرة قد فرقت مجلسكم % % كما يفرق كي الميسم الوبرا % % 4(@)(@@) % لا ينقلون إلى الجبان ميتهم % حتى يؤاجر يعقوب لهم نفرا % % PageV01P208 البحر : وافر تام 1(@)(@@) % نعوا عبد العزيز فقلت هذا % % جليل الرزء والحدث الكبير % 2(@)(@@) % فبتنا لا نقر بطعم نوم ، % ولا ليل نكابده قصير % 3(@)(@@) % فهد الأرض مصرعه فمادت % رواسيها ونضبت البحور % 4(@)(@@) % و أظلمت البلاد عليه حزنا % و قلت أفارق القمر المنير % 5(@)(@@) % وكل بني الوليد أسر حزنا % و كل القوم محتسب صبور % 6(@)(@@) % و كيف الصبر إذ نظروا اليه % % يرد على سقائفه الحفير % % 7(@)(@@) % تزور بناته جدثا مقيما ، % بنفسي ذلك الجدث المور % 8(@)(@@) % بكى أهل العراق وأهل نجد % على عبد العزيز ومن يغور % % 9(@)(@@) % وأهل الشام قد وجدوا عليه % وأحزنهم ، وزلزلت القصور % PageV01P209 البحر : كامل تام 1(@)(@@) % ما بال نومك بالفراش غرار % % لو أن قلبك يستطيع لطارا % % 2(@)(@@) % وإذا وقفت على المنازل باللوى % % هاجت عليك رسومها استعبارا % % 3(@)(@@) % حي المنازل ، والمنازل أصبحت ، % بعد الأنيس ، من الأنيس قفارا % % 4(@)(@@) % و الغانيات رجعن كل مودة % إذ كان قلبك عندهن معارا % % 5(@)(@@) % أصبحن بعد خلابة وتذلل ، % يقطعن دون حديثك الأبصارا % % 6(@)(@@) % أفما تريد لحقدهن تحقدا ، % أم ما تريد عن الهوى اقصارا % % 7(@)(@@) % ولقد يرينك ، والقناة قويمة ، % والدهر يصرف للفتى أطوارا 
ms58	 % % 8(@)(@@) % أزمان أهلك في الجميع تربعوا % % ذا البيض ثم تصيفوا دوارا % % 9(@)(@@) % طرقت جعادة بالرصافة أرحلا % من رامتين ؛ لشط ذاك مزارا % % 10(@)(@@) % و إذا نزلت من البلاد بمنزل % وقي النحوس وأسقي الأمطارا % % PageV01P210 11(@)(@@) % طال النهار ببربروس وقد نرى % % أيامنا بقشاوتين قصارا % % 12(@)(@@) % ما كنت تنزل يا فرزدق منزلا % إلا تركت به ، لقومك ، عارا % % 13(@)(@@) % و إذا لقيت بني خضاف فقل لهم % يوم الزبير كسا الوجوه غبارا % % 14(@)(@@) % لؤم المواطن ياقيون مجاشع % في الناس أنجد خزيهن وغارا % % 16(@)(@@) % غروا بحلبهم الزبير فلم يجد % عند الجوار بحبلك استمرارا % % 17(@)(@@) % ما كان جرب في الحروب عدوكم % نابا تعض به ولا أظفارا % % 18(@)(@@) % فاسأل جحاجح من قريش إنهم % تلقى لحكمهم هدى ومنارا % % 19(@)(@@) % و إذا الحجيج إلى المشاعر أو جفوا % % فاسأل كنانة واسأل الأنصارا % % 20(@)(@@) % واسأل ذوي يمن إذا لاقيتهم % واسأل قضاعة كلها ونزارا % % 21(@)(@@) % من كان أثبت بالغثور منازلا % ومن الأعز ، إذا أجار ، جوارا % % PageV01P211 22(@)(@@) % نحن الحماة غداة جوف طويلع % والضاربون بطخفة الجبارا % % 23(@)(@@) % هل تعرفون على ثنية أقرن % عبسا غداة أضعتم الأدبارا % % 25(@)(@@) % ودعت غمامة بالوقيط فنازعت % حبل المذلة عثجلا وضرارا % % 26(@)(@@) % يا ليت نسوتكم دعون فوارسي % % وثديهن تزاحم الأكوارا % % 27(@)(@@) % إني لأفخر بالفوارس فافتخر % بالأخبثين ، شمائلا ونجارا % % 28(@)(@@) % وإذا تبودرت المكارم والعلى ، % رجعت أكف مجاشع أصفارا % % 29(@)(@@) % عدوا خضاف إذا الفحول تنجبت % والجيثلوط ، ونخبة خوارا % % 30(@)(@@) % وإذا فخرت بأمهات مجاشع ، % فافخر بقبقب واذكر النخوارا % % 31(@)(@@) % عيدانكم عشر ولم يك عودكم % نبعا ولا سبط الفروع نضارا % % 32(@)(@@) % قد شان فخر مجاشع أن لم تكن % عند الحقائق تدرك الأوتارا % % PageV01P212 33(@)(@@) % و لقد نزلت فكنت أخبث نازل % و ظعنت لا جزلا ولا مختارا % % 34(@)(@@) % إن الفرزدق يا مجاشع لم يجد % بالأجرعين لمنكر إنكارا % % 35(@)(@@) % ماذا يربيك إذ تعوذ بتغلب % مني ودمعك بارد إدرارا % % 36(@)(@@) % خربان صيف نفشت أعرافها % % عاين أسفع ملحما مبكارا % % 37(@)(@@) % تبقي المذلة يا فرزدق والقذى % % و المخزيات بعينك العوارا % % 38(@)(@@) % فجع الأجارب بالزبير ومنقر % لم يختلوك وجاهروك جهارا % % 39(@)(@@) % و عرفت 
ms59	 منزلة الذليل فلم تجد % إلا التلهف ، ثمت الإقرارا % % 40(@)(@@) % قد عجلوا لك يا فرزدق خزية % فطلبت ليلة بيتوك ضمارا % % 41(@)(@@) % و تقول جعن للفرزدق لا أرى % % دارا كداركم الخبيثة دارا % % 42(@)(@@) % % والمخ في قصب القوائم رارا % % PageV01P213 48(@)(@@) % و تقول طيبة إذ رأتك مقنعا % أنت الخبيث عمامة وإزارا % % 49(@)(@@) % لو كان أهلك قبل ذاك تبينوا % % و سألت عن جهل الخبيث نوارا % % 50(@)(@@) % حوض الحمار أبو الفرزدق فاعرفوا % % منه قفا ومقلدا وعذارا % % 52(@)(@@) % لم يلق أخبث يا فرزدق منكم % ليلا وأخبث بالنهار نهارا % % 54(@)(@@) % قصرت يداك عن السماء ولم تجد % كفاك للشجر الخبيث قرارا % % 55(@)(@@) % كيف الفخار وما وفيت بذمة % يوم الزبير ولا حميت ذمارا % % 56(@)(@@) % أنسيت ويل أبيك أيام الصفا % % قتلى أصيب بقتلهم وأسارى % % 57(@)(@@) % و الخيل إذ حملت عليكم جعفر % كنتم لهن برحرحان دوارا % % 58(@)(@@) % قلتم ببرقة رحرحان لمعبد : % لا تدعنا وتربص المقدارا % % 59(@)(@@) % ترك الكبول جواليا في معبد ، % و المخ في تصب القوائم رارا % % PageV01P214 60(@)(@@) % والناس قد علموا مواطن منكم % تخزي الوجوه وتمنع الإسفارا % % 61(@)(@@) % وفد الوفود إلى الملوك فأنجحوا % % فذروا الوفادة وانفخوا الأكيار % PageV01P215 البحر : بسيط تام 1(@)(@@) % يا أهل جزرة لا حلم فينفعكم % أو تنتهون فينجي الخائف الحذر % 2(@)(@@) % يا أهل جزرة إني قد نصبت لكم % بالمنجنيق ولما يرسل الحجر % PageV01P216 البحر : وافر تام 1(@)(@@) % كأني ، بالمديبر بين زكا % % وبين قرى أبي صفرى ، أسير % 2(@)(@@) % كفى حزنا فراقهم وأني % غريب لا أزار ولا أزور % 3(@)(@@) % أجدي فاشربي بحياض قوم ، % عليهم من فعالهم حبير % % 4(@)(@@) % عداك الفقر ما عدت المنايا % % رفاعي القناة ، له نقير % 5(@)(@@) % وإن بني رفاعة من تميم ، % هم اللجأ المؤمل والنصير % 6(@)(@@) % هم الأخيار منسكة وهديا % وفي الهيجا كأنهم الصقور % 7(@)(@@) % مرائيب الثأي حشد المقاري % % وفاة حين لا يوفي خفير % 8(@)(@@) % إذا غار الندا لخواء نجم % فسيب بني رفاعة لا يغور % 9(@)(@@) % بهم حدب الكرام على الموالي % % و فيهم عن مساءتهم فقور % 10(@)(@@) % عن النكراء كلهم غبي ، % وبالمعروف كلهم بصير % PageV01P217 11(@)(@@) % خلائق بعضهم فيها كبعض % و يؤم 
ms60	 صغيرهم فيها الكبير % % 12(@)(@@) % وخوص قد قرنت بهن خوصا % تجافى الغيث عنها والخضور % % 13(@)(@@) % كأن جمامها لما استجمت % غايا مجرب فيهن قير % % 14(@)(@@) % فخضخضت النطاف ليعملات % نواشط حين يستغطي البرير % 15(@)(@@) % فسافت ثم أدركها نجاء % على البصرات يقصد أو يجور % % 16(@)(@@) % كأن زهاءهن ، موليات ، % بذي الحومانتين ، قطا يطير % 17(@)(@@) % قلائص عذبت ليلى عليها % % و عذب ليلها نسع وكور % 18(@)(@@) % برى قمعاتها سيري اليهم % وتهجيري إذا صخد الهجير % 19(@)(@@) % فكم واعسن من حبل إليهم ، % و من قور مواجههن قور % % 20(@)(@@) % و من حنش تعرض للنايا % % كأن مجره فيها جرير % % PageV01P218 21(@)(@@) % وقف كالسحابة حين أوفى ، % بعيد الغول ، أسفله وعور % 22(@)(@@) % وقوم ضامزين على نداهم ، % إذا سئلوا كما ضمز الحمير % % 23(@)(@@) % نأنى ودهم فنأيت إني % % بذلك حين لا أدنى جدير % PageV01P219 البحر : طويل 1(@)(@@) % ألا ليت شعري ما البحيرة فاعل % بها الدهر أو ما يفعلن أميرها % % 2(@)(@@) % فناجيت نفسي في الملاء وخاليا % بصرمك فاستعصى على ضميرها % % PageV01P220 البحر : طويل 1(@)(@@) % أتنفي قروما من معد لغيرهم ؟ % كذبت ولم تصدق معد مصيرها % % 2(@)(@@) % قضاعة لم يبغوا أبا عن أبيهم % معد ، وقدت من معد سيورها % % 3(@)(@@) % قضاعة ركن من معد ، وأمهم % لحمير ، والأنساب ينمى خبيرها % % 4(@)(@@) % فلا خير في ترك النبوة والهدى ، % و لا خير في دعوى يكذب زورها % % 5(@)(@@) % و آب إلى الأقيان ألأم وافد % إذا خل عن ظهر النجيبة كورها % % PageV01P221 البحر : بسيط تام 1(@)(@@) % يا عقب لا عقب لي في البيت أسمعه % من للأرامل والأضياف والجار % 2(@)(@@) % أم من لباب إذا ما اشتد حاجبه % أم من لخصم بعيد السأو خطار % 3(@)(@@) % أم من يقوم بفاروق إذا اختلفت % غياطل الشك من ورد و إذدار % % 4(@)(@@) % أم للقناة ، إذا ما عي قائلها ، % أم للأعنة ، يا عقب بن عمار ؟ % 5(@)(@@) % يا عقب لا عقب لي في اليوم أسمعه % إلا ثوية رمس بين أحجار % 6(@)(@@) % كان الخليل الذي تبقى مودته % عندي وموضع حاجاتي وأسراري % % PageV01P222 البحر : طويل 1(@)(@@) % ألا إنما شن حمار وأعنز ، % و أبيات سوء ما لهن ستور % 2(@)(@@) % أتمنع 