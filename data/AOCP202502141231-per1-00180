ms168	 تو را چه گوید عنبر؟(@)(@@) (@@) حز بر رویت، که لالهآ سیراب است %~% اوله %~% بر لاله که دیدهست، که روید عنبر؟(@)(@@) (@@) 167 رویت، که به حسن کار و باری دارد %~% صد خسته چومن، به هر کناری دارد(@)(@@) (@@) با مهر و مهش کدورتی نیست، ولیک %~% پیداست، که از مشک غباری دارد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 167 دلدار من، آنکه زوست در دلها خار %~% در کوی غمش، رفت مرا در پا خار(@)(@@) ~~آخر، ز رسیدن خط آگاه شوی 1671 آن را، که چومن بر رخ خوبت نظری است(@)(@@) گفت: ازخط و عارضم چه خوشتر؟ گفتم: %~% وله %~% کاین درد دل سوختگان را،(@)(@@) خبری است! %~% بسیار تفاوت است، از گل تاخار! %~% هر لحظه، به کوی نامرادی گذری است(@)(@@) (@@) 1278 گویند که: بر دمید از گل خارش %~% لغیره %~% جرمی است که می نهند بر گلنارش(@)(@@) (@@) پیوسته خیال او چودر چشم من است %~% عایشه %~% عکس مژهآ من است، بر رخسارش(@)(@@) ~~167 هر بار، که وجه بوسه بر لب فرمود این بار، خطی نبشت بر عارض خوب(@)(@@) %~% آن همچو حواله بر در بسته نمود %~% وجهی است، که روشن تر از آن نتوان بود(@)(@@)(@@)(@@) | دختر خطیب گنجه(@)(@@) ~~تشبیه خطش به مشک می کردم، عقل 168 در عالم جان، خطبه به نام خط اوست(@)(@@) %~% لغیره %~% صبح دل عشاق، زشام خط اوست %~% گفتا: غلطی، مشک غلام خط اوست!(@)(@@) (@@) 168 جانان مرا، ترک خطا می خوانی %~% بنگر، ز کجا تا به کجا می خوانی(@)(@@) (@@) گفتی: خط او، مشک خطا را ماند %~% خط خوش او، چرا خطا می خوانی؟(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 168 زلفت چومن ...... بی فرمان تر %~% در تاب فتاد و، گشت سرگردان تر(@)(@@) (@@) خط تو، مرا به بندگی منی خواند %~% هرگز دیدی، خطی ازین خوشخوان ترا PageV01P317(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0321.jpg)(@)(@)(@@)(@@)(@@) | سعل(@)(@@) ~~1283 دل را، زتو دلدار نمی گیرد دل وز سبزه و گلزار، نمی گیرد دل(@)(@@) (@@) در خط مشوو، مرا به خط عشوه مده %~% کان خط [توا بر کار نمی گیرد دل(@)(@@)(@@)(@@) | بهستی(@)(@@) (@@) 1684 روی تو، که مه 
ms169	 را زخود افزون ننهد %~% سر بر خط کس، به هیچ افسون ننهد(@)(@@) (@@) آورد خطی به گرد خود، تا خوبی %~% از وی همه ساله، پای بیرون ننهد(@)(@@)(@@)(@@) | لغیرها(@)(@@) (@@) 1685 گویند: دل از غم بگشایی، شاید %~% ور محنت هجرم ننمایی، شاید(@)(@@) (@@) با من، که چوزلف تو پریشان کارم %~% گر چون خط خویش خوش برآیی، شاید(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 1686 زان رخ، که بری زدلبری می گردد %~% گردش خط خوب عنبری می گردد(@)(@@) (@@) گو یند: پری به گرد خط گردد، لیک %~% خط خوش تو، گرد پری می گردد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1687 وهمی است که بر چهرهآ یار است، نه خط %~% سطری است که وصف آن نگاراست، نه خط(@)(@@) (@@) اربر گل عارضش، زسنبل اثری است %~% آن سایهآ زلف مشکبار است، نه خط(@)(@@)(@@)(@@) | لغیره.(@)(@@) ~~1688 خطت، چو بنفشه از گل آورد پدید آورد خطی، که بر سر ماه کشید(@)(@@) (@@) پیوسته زشب صبح دمیدی، اکنون %~% آشوب دل مرا شب از صبح دمید(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 1689 در بندگیش آنکه مه اقرار کند %~% چشمش دل من ببرد و، انکار کند(@)(@@) (@@) زین پیش، به خون عاشقان داشت خطی %~% اکنون به سجل کرد، که بر کار کند(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1690 بر بست غم تو بر دلم، راه نفس %~% عشق تو گشاد، جمله درهای هوس(@)(@@) (@@) تا کی گویی که: در غمم مدعیی %~% من مدعیم، شاهد من خط توبس!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1691 خطت، چو به گرد لب سمر می گردد %~% چاکر، چو قلم زغم به سر می گردد(@)(@@) ~~خطت، به مثل مورچهای را ماندلیکن، چو مگس گرد شکر می گردد PageV01P318(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0322.jpg)(@)(@)(@@) (@@) 169 با روی تو، کجل سپر بر آب افکندهست %~% لغیره %~% زان روی، گلابیش به تاب افکندهست(@)(@@) (@@) از رشک خطت، چو ذره بی آرامم %~% تا، سایه چرا بر آفتاب افکندهست؟(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) ~~169 تا سایهآ خط بر آفتاب افکندیبس دل، که بر آتش چو کباب افکندی(@)(@@) ~~خطت سپر است و، عارضت آب حیاتیکباره، سپر بر سر آب افکندی(@)(@@) (@@) طرلاله سمن کاشته، بر گل سوسن 1169 زنهار، 
ms170	 دو چشم پر خمارش نگرید %~%(@)(@@) الغیره %~% دهقان بینید و، کشتزارش نگرید! %~% فریاد، دو زلف مشکبارش نگرید(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 169 ترکی، که به دلبری است ره برخط او %~% بیدا و نهان و شور و شر در خط او(@)(@@) (@@) عمدا، خطی از غالیه برماه کشید %~% تا خلق جهان نهند سر برخط او(@)(@@)(@@)(@@) | کمال مراغی(@)(@@) (@@) 1696 بر شکر تو، مورچگان می گذرند %~% مگذار، که شکرت به غارت ببرند(@)(@@) (@@) در چشمهآ حیوان لبت می نگرند %~% هش دار، که آب زندگانی نخورند!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 169 بنشست به ناز، یار با من نفسی %~% بگرفته زحسن خویش، در دل هوسی(@)(@@) (@@) ی گفت و، به خط ولب اشارت می کرد %~% به زین به شکر بنفشه پرورده کسی!(@)(@@)(@@)(@@) | وله(@)(@@) ~~169 زلفت، که به کشتنم مرادی داردهر عقده ز عقدش اعتقادی دارد(@)(@@) ~~وان خطهآ خطت، که وطنگاه دل است انصاف بده، که خوش سوادی دارد!(@)(@@)(@@)(@@) | فخرگنجهای(@)(@@) ~~169 تا ماه رخت، روشنی حسن بکاستتاریکی غم نگر که اندر دل ماست(@)(@@) (@@) اشک دو هزار کس، در آورد به چشم %~% آن دود، که از آتش رخسار تو خاست(@)(@@)(@@)(@@) | محفوظ جرفادقانی(@)(@@) ~~17000 بر طرف گلت، سنبل تر می روید وزیاسمن تو، سبزه بر می روید(@)(@@) (@@) پار، از لسب تو شگر تر می بارید %~% امسال، بنفشه از شکر می روید PageV01P319(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0323.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1701 وقت است، که از لب تو شکر بدمد %~% گرد شکر تو، سبزهآ تر بدمد(@)(@@) (@@) دانی زتودیده از چه می ریزد آب؟ %~% تا سبزهآ خط تو، نکوتر بدمد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1702 بالاله وگل، به هم برآمد خط تو %~% یارب، که چه بیدادگر آمد خط تو(@)(@@) (@@) باعارض تو، همچوتوبا دشمن من %~% زنهار، چگونه خوش برآمد خط تو(@)(@@)(@@)(@@) | پسر حافظ(@)(@@) (@@) 1703 ای سبزهآ بستان تمنی خط تو %~% یک آیت و صد هزار معنی، خط تو(@)(@@) (@@) سبحان الله! چه خوش برون می آید %~% از لاله وگل، بنفشه، یعنی: خط تو(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 1704 ای خط مرا دریده یکسر خط تو %~% بوشیده شهر خطه(؟) انور خط تو(@)(@@) (@@) چون خضر 
ms171	 در و زآتش غم دید نجات %~% لغیره %~% تا آب حیات یافت، اندر خط تو(@)(@@) (@@) 1705 رو یش نگر، ار راحت جان ملی خواهی %~% وصلش طلب، ارملک جهان می خواهی(@)(@@) (@@) اشک من وخط او ببین، دور مشو %~% گر سبزه و، گرآب روان می خواهی(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1706 خط تو، که خوب و دلکشم می آید %~% چون سبزه، میان آتشم می آید(@)(@@) (@@) برخط تو، هر کسی چومن دارد سر %~% یا من خرم و، سبزه خوشم می آید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1707 منمای رخ، ار کام منت می باید %~% امروز، که دود از آتشت می زاید!(@)(@@) (@@) کانکس، که به آتشت دمی گرم نشد %~% از دود تو گر کور نگردد، شاید!(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) ~~1708 بر میم لبت، خط توچون افتادهستموری است، که بر شکر کنون افتادهست(@)(@@) (@@) نه، کان خط فستقی بر آن پستهآ لعل %~% مغزی است، که از پسته برون افتادهست(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 1709 آن یار، که بر دلم زغم بار نهاد %~% واندر لب خود، قند به خروار نهاد(@)(@@) (@@) تا کس گلی از باغ جمالش نچند %~% از برگ بنفشه، گرد او خار نهاد PageV01P320(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0324.jpg)(@)(@)(@@)(@@)(@@) | شمس اقطع(@)(@@) ~~1710 در گرد مهت، عنبر تر می بایستوین سوخته دل، سوخته تر می بایست(@)(@@) (@@) زنجیر دو زلف تو، نه بس بود مرا %~% غل دگر از غالیه، در می بایست(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 171 تا سبزه به نظارهآ گلزار آمد %~% خورشید، به دام شب گرفتار آمد(@)(@@) (@@) در مملکت جمال جان پروراو %~% صاحب طرفی دل، پدیدار آمد(@)(@@)(@@)(@@) | قاضی ابوالمجد(@)(@@) (@@) 171 ای تا جوران نهاده سر بر خط تو %~% وز کار ببرده آب عنبر، خط تو(@)(@@) (@@) زان چشمه، که قطره قطره اسکندر جست %~% دریا دریا یافتم، اندر خط تو(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 171 ای برده سبق زمشک اذفر خط تو %~% وز کار ببرده آب عنبر خط تو(@)(@@) (@@) آنکه قلم کشیدهای در خط من %~% چون زلف تو، سر نهادهام بر خط توا(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) کی دانستم، که عارضت می آرد 1171 پنداشتم، از غمم نجاتی باشد %~% چون(@)(@@) بر شکر، 
ms172	 از سبزه نباتی باشد %~% خطی، که به خون من براتی باشد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 171 ای قاعدهآ زلف تو شهر آرایی %~% وی پیشهآ چشم شوخ تو، رعنایی(@)(@@) (@@) لالای خط تو را مبارک بادا %~% بر تختهآ کافور تو، عنبر سایی!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~171 جانا، زغمت لاله به داغ افتاده ست وز دست تو، گل باغ به باغ افتادهست(@)(@@) (@@) مشک به خطا زادهآ پر آهورا %~% سودای خط تو، در دماغ افتادهست(@)(@@)(@@)(@@) | عز بوالبقا(@)(@@) ~~1717 خطت، که زگل مشک برون می آردبرخسته دلم، برات خون می آرد(@)(@@) (@@) چشم توعمل می کند، ای ترک خطا %~% خط تو برات بین که چون می آرد(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2417 ای آکنه رت هره جمالی دارد خورشید تو، از مشک هلالی دارد PageV01P321(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0325.jpg)(@)(@)(@@) (@@) 1319 هر حاجت دل، که از خدا خواسته ام %~% لغیره %~% در تعبیهآ دعا، تو را خواسته ام(@)(@@) (@@) در خط نشوم ز خط سبز تو، از آنک %~% سر سبزی لعلت، به دعا خواسته ام(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1720 ای خطهآ کون گشته مولای خطت %~% وی سجده گه جهانیان، جای خطت(@)(@@) (@@) منشور رخ تو می نوشتند، به حسن %~% امروز تمام شد، به طغرای خطت(@)(@@) (@@) 1721 هر لحظه، دل از سینه به سر برجوشد %~% الغیره %~% صد قطرهآ خونم، زجگر بر جوشد(@)(@@) (@@) در حسرت آنم، که به گرد لب تو %~% لغیره %~% ناگه، پر طوطی زشکر برجوشد(@)(@@) (@@) 1722 خطت، که به جز برات غم ننو یسد %~% منشور وفا، جز به عدم ننو یسد(@)(@@) (@@) منشی قدر چودید، انصاف بداد %~% یعنی که چنان، کس به قلم ننو یسد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1723 ای عکس رخ تو گشته پیرایهآ مهر %~% وی حسن جهانفروز تو، مایهآ مهر(@)(@@) (@@) پروین عقیق درج تو، یارش مه %~% شمشاد سمن پرور تو، دایهآ مهر(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1724 با میم، چونون نسخ ملحق کردی %~% بدر حسن منی کردی و، بر حق کردی(@)(@@) (@@) در خوبی، اگر چه سحر مطلق کردی %~% آخر، خط نسخ را محقق کردی(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1725 زاغی، زحد روم برون آمد تنگ %~% بر شاخ سمن نشست و، 
ms173	 بر گل زد چنگ(@)(@@) (@@) برخاست میان رومی و زنگی جنگ %~% بیم است، حصار روم بستاند زنگ!(@)(@@)(@@)(@@) | صالح بیلقانی(@)(@@) (@@) 1726 خطی، که فلک بر رخ دلخواه نوشت %~% بر گل، رقم بنفشه بیگاه نوشت(@)(@@) (@@) خورشید، خطی به بندگی می دادش %~% کاغذ مگرش نبود، بر ماه نوشت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1727 تا چند، صفت زعشق و تیمار کنم %~% وصف رخ خوب وخط دلدار کنم(@)(@@) (@@) چون خامه، به عاقبت ببینی که زبان %~% اندر سر سودای خط یار کنم PageV01P322(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0326.jpg)(@)(@)(@@)(@@)(@@) | خلیل شروانی(@)(@@) (@@) 1728 خطت، که دلم راحت جانش خواند %~% وز لطف، طراز گلستانش خواند(@)(@@) (@@) خطی است مسلسل و، زروی معنی %~% خوشتر، خرد از آب روانش خواند(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1725 رویت، که ز صد گونه لطافت دارد %~% شاید، که دل مرا در آفت دارد(@)(@@) (@@) سلطان لبت، لباس عباسی را %~% اوله %~% پوشید، مگر سر خلافت دارد!(@)(@@) (@@) 17330 فریاد، زخط دلستانی که تو راست %~% زان ملک عظیم کامرانی، که تو راست(@)(@@) (@@) گرد رخ تو آب حیات است عجب %~% اوله %~% بر آب، خطی بدین روانی که تو راست(@)(@@) ~~1731 گفتم: چه سبب، ماه تو در میغ گریخت؟ بر گرد رخت، غالیه بر عاج که بیخت؟(@)(@@) (@@) گفتا که: چو مشاطه بیاراست مرا %~% از هوش برفت و، سرمه برآینه ریخت!(@)(@@) (@@) 173 گفتم که: رخ تو را تباهی باشد %~% وله %~% زان طرفه [خطت]، گرچه الهی باشد(@)(@@) (@@) گفتا : لاله ست روی من، عیبی نیست %~% پیرامن لاله، ار سیاهی باشد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1733 با روی تو گفتم که بهشت آیین بود: %~% کافور تو جانا، چه سبب مشکین بود؟(@)(@@) (@@) گفتا: هر کس نه سر نبشتی دارد؟ %~% از عهالم غیب، سرنوشتم این بود!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 17734 ای شمع، نگر به سوز من ننشینی %~% پیش رخ دلفروز من، ننشینی(@)(@@) (@@) وز عارض یار، خیره در خط نشوی %~% اوله %~% تا ناگاهی، به روز من ننشینی!(@)(@@) (@@) 1735 هر چند، که زد بسی ز خود رایی مشک %~% با خط خوشت لاف، به رعنایی مشک(@)(@@) (@@) چون دید خط خوب تو، آن ترک خطا %~% از رشک خط 
ms174	 توماند، سودایی مشک PageV01P323(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0327.jpg)(@)(@)(@@)(@@)(@@) | نمط هشتم(@)(@@) در وصف نیکورویی(@)(@@)(@@)(@@) | عماد غزنوی(@)(@@) (@@) 1736 ای فتنهآ دل به روی زیبا که تویی %~% جان سر به سجود برده، آنجا که تویی(@)(@@) (@@) در روی تو، چون صنع خدامی بینم %~% می گویم: صانعا، خدایا که تویی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1737 کس، روی تو بی نقاب نتواند دید %~% با روی تو، آفتاب نتواند دید(@)(@@) (@@) گر وهم در اندیشه بخسبد، سالی %~% مانند رخت، به خواب نتواند دید!(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 1738 ای کار تو صبرم به کران آوردن %~% اندیشهآ تو، دلم به جان آوردن(@)(@@) (@@) چتوان کردن، چونیست جزتو کس را %~% رویی، که برو عشق توان آوردن(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) ~~1739 آن ماه، که آفتاب تام است زحسن اندر ره عقل و هوش، دام است زحسن(@)(@@) (@@) دیدم، رخ او و عکس خورشید در آب %~% معلوم نمی شد، که کدام است زحسن(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1740 ای صد چو گلت بنده به شهر آرایی %~% می نایب لعل تو، به روح افزایی(@)(@@) (@@) آیینهآ آفتاب، پیش رخ تو %~% ننماید رخ، تاتو در او ننمایی!(@)(@@)(@@)(@@) | سیف تفلیسی(@)(@@) ~~1741 مادر که تو را بزاد، ای حور نژادابلیس بخندید و، بشد خرم وشاد(@)(@@) (@@) یعنی که: بدین روی، توانم بر داد %~% دین همه امت محمد بر باد!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~1742 رنگ، از رخ تولالهآ نعمان گیرد طوطی لبت، طعمه همه جان گیرد(@)(@@) (@@) ماه شب چارده، زشرم رخ تو %~% انگشت حسد، در بن دندان گیرد PageV01P324(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0328.jpg)(@)(@)(@@)(@@)(@@) | شهاب کاغذی(@)(@@) (@@) 1743 ای خط خوش تو باد عنبر برده %~% پیش لبت، آب زندگانی مرده(@)(@@) (@@) با روی تو، خورشید گل پژمرده %~% با عارض توصبح، دم افسرده(@)(@@) (@@) 1744 زلفین تو، از عنبرناب است همه %~% الغیره %~% وان عنبر ناب، پیچ وتاب است همه(@)(@@) (@@) رخسار تو، آتشی است افروخته خوش %~% وان آتش افروخته، آب است همه(@)(@@)(@@)(@@) | شمس شجاسی(@)(@@) ~~1745 آن کیست، که گفت قوت جان نیست رخش وآرایش عرصهآ جهان، نیست رخش؟(@)(@@) (@@) گر عقل منی شیفته، خورشیدش خواند %~% اوله %~% المنة لله، که نهان نیست رخش!(@)(@@) (@@) 174 
ms175	 هر حسن، که روی دلفروز انگیزد %~% صد عشق توام، روز به روز انگیزد(@)(@@) (@@) دل سوخت مرا عارض او، لیک زمن %~% باو رکه کند، که آب سوز انگیزد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1747 آن یار، که ما در بی او می گردیم %~% همچون دلش، از خوی به خومی گردیم(@)(@@) (@@) تا حسن، نکونهاد نام رخ او %~% ما، در طلب رخ نکو می گردیم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) ای منکر عشق وعاشقی، گر مردی 1748 چون قوس قزح، کمان ابروش نگر %~%(@)(@@) یک ره، نظری ز دور در روش نگر! %~% در کشتن دل، نرگس جادوش نگر(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 1749 رویت، بر ماه آسمان می تابد %~% مه نیز، بر آسمان از آن می تابد(@)(@@) (@@) نوری است جمال روی تو، خورشید اوست %~% کز مشرق بینایی جان میتابد(@)(@@)(@@)(@@) | وله(@)(@@) ~~175 نقاش، که شبه صورتت می انگیخت در صنعت، اگرچه آب آزرمی ریخت(@)(@@) (@@) روی چومهت بدید، بشکست قلم %~% چون ماه، اگر چه سالها رنگ آمیخت!(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 175 از لعل لبت، سخن چوپیوسته شود %~% شیرین دهنت، چو شگر و پسته شود(@)(@@) (@@) روی کوقل است و، آنگه از غایت لطف %~% گر برگ گلی بر اوزنی، خسته شود!(@)(@)PageV01P325(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0329.jpg)(@)(@)(@@)(@@)(@@) | عماد فارسی(@)(@@) (@@) 1752 از بوی تو، باد عنبری می گردد %~% باروت، پری زدلبری می گردد(@)(@@) (@@) فردوسی باغ ازرقی شکل سپهر %~% از پرتو رویت، انوری می گردد(@)(@@)(@@)(@@) | ظهیر فاریابی(@)(@@) (@@) 1753 دی، چشم تورای سحر مطلق می زد %~% مکر تو، ره گنبد ازرق می زد(@)(@@) (@@) تا داشتی آفتاب، در سایهآ زلف %~% جان، بر صفت ذره معلق میزد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1754 دوش، آن بت من می مروق میزد %~% بر عکس رخش، عرق معلق میزد(@)(@@) (@@) من می گفتم: شمس غلام رخ توست %~% در چرخ، فلک نعرهآ صدق میزد!(@)(@@)(@@)(@@) | باج خلاطی(@)(@@) (@@) 1755 مه پیش نهاده، کاین رخ فرخم است خون من مستمند، بر بیدادی %~%(@)(@@) الغیره %~% مالیده به روی تر، که رنگ رخم است %~% شکر به لب آورده، که این پاسخم است(@)(@@) ~~1756 ابروی تو، بر خم کمان می خندد فی الجمله، هر 
ms176	 آنچه در جهان خوبتر(@)(@@) است %~% رخسار تو، امروز بر آن می خندد %~% مژگان تو، بر نوک سنان می خندد(@)(@@)(@@)(@@) | عماد گنجه ای(@)(@@) (@@) 1757 چشمت، همه بر خیل ملک می خندد %~% شیرین لب تو، بس به نمک می خندد(@)(@@) ~~ابروی تو، قوس می زند بر عقربروی تو، چوماه بر فلک میخندد(@)(@@) شمس گنجه ای(@)(@@) (@@) 1758 از روی تو، سرو بوستان هست خجل %~% وززلف تومشک - تابه جان هست- خجل(@)(@@) (@@) خورشید، که عرصهآ زمین روشن ازوست %~% اله %~% از روی توتا به آسمان، هست خجل(@)(@@) ~~1759 ها! قدتو، گر سرو روان می طلبهی(@)(@@) (@@) رخسارهآ مه را، همه شب می بینی %~% ل %~% در آینه بین، گربه از آن می طلبی(@)(@@) ~~1760 گل، دفر ومدی نخواند زغمت(@)(@@) ~~زان شب، که بدید روی خوبت را مه PageV01P326(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0330.jpg)(@)(@)(@@)(@@)(@@) | کمال مراغی(@)(@@) ~~176 از روی توام، لطیفه ای در جان است در چشم من آمدهست رویت، روزی(@)(@@) %~% سیرابی لاله زار رویت، زان است! %~% پیداش کنم، کز نظرت پنهان است(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1760 زلفش، زشب هجر درازی ببرد مه گفت به مهر: با رخش قایم ریز %~%(@)(@@) کاین دست تو، پای او به بازی ببرد! %~% قدش، ز خدنگ سرفرازی ببرد(@)(@@)(@@)(@@) | جمال خویی(@)(@@) (@@) 16 با من ز در کینه در آیی،ها عقل! %~% رنجم همه بر رنج فزایی، ها عقل!(@)(@@) (@@) آنگه گویی: بیا، ببین در رخ من؟ %~% مه را تو به دیوانه نمایی؟ ها عقل!(@)(@@)(@@)(@@) | پسر قاضی در بند(@)(@@) (@@) 176 دل، قد تو را سرو روان می گوید مه، دعوی بندگی روی تو کند %~%(@)(@@) آرام دل و راحت جان می گوید %~% با آنکه سخن ز آسمان می گوید(@)(@@)(@@)(@@) | دختر سجستانیه(@)(@@) ~~من، دی رخ زیبای تورا مه خواندم 176 برخاسته بسته ای قبا تا به کجا(@)(@@) %~% امروز، بدیدم از کجا تا به کجا! %~% ای همچوسهیل برسما، تا به کجا(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) ~~176 شوریم ز باد صبح در سینه فتاد گویی که چوصبح آینه در عالم داشت(@)(@@) %~% دل، با سر اندیشهآ دیرینه فتاد %~% عکس رخ تو، دوش 
ms177	 در آیینه فتاد(@)(@@)(@@)(@@) | جمال حاجی(@)(@@) ~~با روی خوشش، بباخت مه نرد جمال 176 عذرا، که دل خستهآ من فاش ببرد(@)(@@) %~% ده خصل به ماه داد و، عذراش ببرد %~% در چنگ غمش کشید و، رسواش ببرد(@)(@@)(@@)(@@) | مقرب باکویی(@)(@@) ~~1768 در یک نفس، آن جان و جهان بتوان دید عیش خوش و عمر جاودان بتوان دید(@)(@@) (@@) در آینهآ رخش- که روشن بادا %~% گر دم نزنی، صورت جان بتوان دید(@)(@@)(@@)(@@) | جمال شروائی(@)(@@) (@@) 1765 تا، دست در آن دو زلف کوتاه زدیم %~% بر طرف فدک ز کبر خرگاه زدیم(@)(@@) (@@) چون روی چو خورشید منیرت دیدیم %~% حالی، دو هزار طعنه در ماه زدیم PageV01P327(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0331.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1770 ای روی توام چو گل به گلشن لایق %~% خوبی زتو، همچون سخن از من لایق(@)(@@) (@@) در گرد جهان گشت بسی، نیکویی %~% جز روی تورا، ندید مسکن لایق(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1771 ای جان یگانه درتن نیکویی %~% وی سرو روان، در چمن نیکویی(@)(@@) (@@) بالای فلک، دوش میان مه و مهر %~% از روی تو می شد، سخن نیکویی(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1772 شب، روی سیه ز خجلت روی توماند %~% و اندر آهو، مشک هم از روی توماند(@)(@@) (@@) در روی تو دید در ازل، نیکویی %~% از نیکوی روی تو، در روی توماند(@)(@@)(@@)(@@) | وله(@)(@@) ~~لعلش، زبیان نطق نمی زد، لیکن 1773 دی، دلبر من رموز از حق می گفت(@)(@@) %~% رویش، به زبان حال اناالحق می گفت %~% بگذار رموز، سحر مطلق می گفت(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) (@@) 1774 ای پیش لبت لعل یمن در باقی %~% وی با زلفت، مشک ختن در باقی(@)(@@) (@@) می گفت فلک دوش، زخورشید سخن %~% چون دید رخت، کرد سخن در باقی(@)(@@)(@@)(@@) | قاضی ابوالمجد(@)(@@) ~~1775 آب آمد، تا بدزدداز روی تو رنگ در کار خنک شد، چوبیش کردم جنگ(@)(@@) (@@) آبش ببر، ارچه می نهد رخ بر خاک %~% بارش مده، ارچه می زند سر بر سنگ!(@)(@@)(@@)(@@) | شرف بیلقانی(@)(@@) (@@) 1776 خورشید کزوست چشم عالم روشن %~% از بهر نظارهآ تو، ای شمع ختن(@)(@@) (@@) آمد به لب بام، چو دیوار تو 
ms178	 دید %~% مدهوش شده، در اوفتاد از روزن(@)(@@) (@@) 1777 خورشید، کزو نور دهد ماه به شب %~% اله %~% با آنکه ز سلطنت گرفتهست نسب(@)(@@) (@@) در روی تو، صد ره زمن آشفته تر است %~% گر از درو بام تو در افتد، چه عجب!(@)(@@) (@@) 1778 با غمزهآ ترک و زلف هندو که توراست %~% وله %~% باخوی بد وشیوهآ نیکو که توراست!(@)(@@) (@@) رویی داری سخت و به غایت نیکو %~% فی الجمله چه گویمت؟ زهی رو که توراست!(@)(@)PageV01P328(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0332.jpg)(@)(@)(@@) (@@) 1770 ای روی تو از لطافت آیینهآ روح ردیده نهم، ولی زخار مژهام %~%(@)(@@) وله %~% ترسم که شود، پای خیالت مجروح! %~% خواهم که قدمهای خیالت به صبوح(@)(@@) (@@) از تری و سرخی و سپیدی رویت 178 زان آتش خوش، کز رخت انگیختهاند %~%(@)(@@) وله %~% وله %~% گویی می و شیر در هم آمیخته اند! %~% آب همه نقش مانوی ریخته اند(@)(@@) (@@) گیرم، گل را ولاله را چشمی نیست 178 ای مهر، بیا سنبل گلبوش نگر %~%(@)(@@) آخر نه تو چشمی همه، در روش نگر! %~% و ین قامت طاق و، طاق ابروش نگر(@)(@@)(@@)(@@) | وله(@)(@@) ~~از لاله و گل، زمهر و مه هیچ مگوی 1782 آن تیر مژه، کمان ابروش نگر(@)(@@) %~% وان عنبر [و آن]سنبل گلبوش نگر %~% یک ره به خدا بر تو، که در روش نگر(@)(@@)(@@)(@@) | نمط نهم(@)(@@)(@@)(@@) | در تشبیهات قد وبالا(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 1782 هر چند، که پیش توغمی نتوان گفت %~% ترک غم چون توصنمی، نتوان گفت(@)(@@) (@@) این طرفه، که راستی زقد توبرند %~% وز بیم تو، یک راست همی نتوان گفت!(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) 1789 خورشید، همی سجده برد خد تورا %~% در نتوان یافت، حسن بی حد تو را(@)(@@) (@@) بخرام، چنانکه سرو آزاد چو من %~% ناگه، خط بندگی دهد قد تورا(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 1785 سر و قد تو، چو سر به گردون افراشت %~% نام قد خویش، سرو بر آب نگاشت(@)(@@) (@@) از لطف، الف قد تودارد همه چیز %~% منسوخ شد آن رسم، کالف هیچ نداشت PageV01P329(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0333.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1786 سروت خوانم نه، کفر مطلق باشد %~% با قد 
ms179	 تو، سرو را چه رونق باشد(@)(@@) (@@) می خواهد سرو، تا چوقد توشود %~% آری چه عجب، دراز احمق باشد!(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 1787 هر چند، که قد بی بدل دارد سرو %~% پیش قد یارم، چه محل دارد سرو؟(@)(@@) (@@) گوید که: قدم از قد یارت چه کم است؟ %~% وه، وه! چه دماغی به خلل دارد سرو!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1788 ای قد توبر گذشته از پایهآ سرو %~% یکباره به باد داده، پیرایهآ سرو(@)(@@) (@@) بر دیدهآ من نشین، که از روی خرد %~% بر چشمهآ آب، خوش بود سایهآ سرو!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) ~~1789 در باغ شدی، گل زتو در خون افتاد در پیش قدت، سرو چرا سجده(@)(@@) نکرد؟ 1790 گل جامه درید از رخ تو، شادش کن %~% وله %~% وز پردهآ عافیت،(@)(@@) به بیرون افتاد %~% این سهوقیام، سرو را چون افتاد؟ %~% وز قد تو سرو گوژ شد، یادش کن(@)(@@) (@@) تا گل چه بود؟ هان به خدا بخش او را %~% وز سرو چه خیزد؟ برو آزادش کن!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1791 زلف خوش تو، دام ز عنبر گیرد %~% دلها، همه در میان چنبر گیرد(@)(@@) (@@) پیش قد و قامت خرامان تو، سرو %~% خاکش بر سر، چه باد در سر گیرد!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1792 گل گفت، چه گفت؟ گفت: من روی توم وز گوشه بنفشه گفت: من موی توام(@)(@@) (@@) سرواز پی عذر، راست برخاست که: من %~% با اینهمه آزادی، هندوی توام!(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 1793 بر برگ گلت، نسیم گل کار کند %~% زنهار ببوسهآ خود افگار کند(@)(@@) ~~ریحان، چوبه خادمی خطت برخاستخود، سرو به بندگیت اقرار کند(@)(@@)(@@)(@@) | ب(@)(@@) (@@) 1794 یارم، که ز سرو نیست کم بالایش %~% بالای مرا کرد به خم، بالایش(@)(@@) (@@) گویند که: سرو هست همبالایش %~% بگذر زحدیث سرو، هم بالایش!(@)(@)PageV01P330(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0334.jpg)(@)(@)(@@) (@@) 1795 یارم، چو شکست زلف رعنا می داد %~% اوله %~% تاب سر زلف شب یلندا می داد(@)(@@) (@@) می گفت که : سرو هست همبالایم %~% بنگر تو، که سرو را چه بالا می داد!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 179 روی تو، عرق بر گل تر می فکند %~% لعل 
ms180	 تو، شکست بر شکر می فکند(@)(@@) (@@) وان باد، که قامت تو در سر دارد %~% بر قامت سرو، لرزه بر می فکند!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1797 با قد تو، هیچ سرو همبر نبود %~% با روی تو، در خور گل احمر نبود(@)(@@) (@@) می خواست برم، که بر خورد از برتو %~% لیکن چه کند؟ که سرو را بر نبود!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 179 با سرو قدی، که ماه ازو رشک برد %~% هر ماه، به طنز در مه نونگرد(@)(@@) ~~گفتم ز تو [من] بری خورم، گفت: خموش!من سروم و، از سرو کسی بر نخورد!(@)(@@) (@@) 179 ای مه خجل از عارض زیبای خوشت %~% الغیره %~% جان، برخی آن زلف دلارای خوشت(@)(@@) (@@) جز سرو نبود از غمت آزاد و، شدهست %~% او نیز چو من، بندهآ بالای خوشت(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~سرو ار چه زند لاف شگرفی، لیکن 1800 گل کیست؟ که در رونق خد تورسد(@)(@@) %~% چون بید بلرزد، که به قد تو رسد! %~% ایا ماه، که در حسن به حد تورسد؟(@)(@@)(@@)(@@) | جمال خجندی(@)(@@) ~~دایم کند ازقد تو سرو، آزادی 1801 آن روی چو ماه، اگر توپیداش کنی(@)(@@) %~% زنهار، بمخرام که رسواش کنی %~% بس کس، که چو من واله وشیداش کنی(@)(@@)(@@)(@@) | شمس هروی(@)(@@) (@@) 1802 قدت، که چومن هزار دلدادهآ اوست %~% تا، سرو سهی غلام آزادهآ اوست(@)(@@) (@@) در زیر فلک، نیافت کس همبالا %~% جز سایه و، او نیزهم افتادهآ اوست!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 1803 گل، گرچه ز حسن می نهد خار دلم %~% سرو، ارچه کشد ز لطف تیمار دلم(@)(@@) (@@) جز روی تو، در وجه دلم می نشود %~% جزقد تو، راست نیست بر کار دلم PageV01P331(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0335.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1804 آن سرو، که نیست درجهان همتایش %~% از قامت اوست، باغ را آرایش(@)(@@) (@@) در راستی، ارچه کس ندارد پایش %~% هم زیر آمد زقد تو، بالایش(@)(@@)(@@)(@@) | سید قزوینی(@)(@@) (@@) 1805 با ماه بر آویز، که حدش داری %~% هر حرف که او کند، توردش داری(@)(@@) (@@) از سرو بخواه باج، ورنه به ستم %~% از بیخ برآورش، که قدش داری(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1806 گل را، 