ms236	 چه توان گفت کرمهای تورا!(@)(@@) (@@) 2356 ای رسم تو در ناکس و کس پیوستن شرمت ناید، به قصد جان چومنی %~%(@)(@@) به خاستن و، با دگری پیوستن! %~% عهدی داری، به عهدها بشکستن(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2351 دی می رفتم، مست و کش و خرم و شاد گفتم که: چه حالت است؟ گفتا:(@)(@@) فریاد %~% کان توبهآ ما، بقای سوگند توباد! %~% آن ماه دو هفته، پیش من باز افتاد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2358 ای شادی آن عهد، که بودت غم من %~% بودی شب وروز، مونس وهمدم من(@)(@@) (@@) در خاطر من نبود، ناگاه چنین %~% تو کم زمنی گیری و، گیری کم من!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2351 با دشمن من گر چه نشستی، سره ای %~% عهد من اگر چند شکستی، سزهای(@)(@@) (@@) فی الجمله درین میانه زحمت ما[را]ست %~% ورنه توبه هر صفت که هستی، سرهای(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~دی آنهمه عهد رفت و، دوش آنهمه شرط 2360 ناگاه، چنین کناره جویی که(@)(@@) چه بود؟ %~% الغیره %~% امروز چه عذر آری و، گویی که چه بود؟ %~% یکباره نموده تندخویی، که چه بود؟(@)(@@) (@@) 2361 درعشق، بگو شیوهآ مستوری چیست؟ %~% درنامدنت، حجت معذوری چیست؟(@)(@@) (@@) نزدیک شدی به ما و دور افتادی %~% آن نزدیکی چه بود و، این دوری چیست؟(@)(@)PageV01P397(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0401.jpg)(@)(@)(@@) بابیازدهم - افعال معشوق(@)(@@)(@@)(@@) | نجیب گنجه ای(@)(@@) (@@) 2362 ای گشته دلم در غم توخوار و حزین %~% گفتی غم تو می خورم، آری کم ازین(@)(@@) (@@) لیکن به وفا بر تو اگر بتوانی %~% بر هیچ کسی، هیچ کسی را مگزین!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2363 با آنکه دل از غم تو، پر خون بینم %~% هر دم ز تو، محنتی دگرگون بینم(@)(@@) (@@) گفتی که: بیا با دگرانم بنگر! %~% این کوری را به چشم خود، چون بینم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2364 آوخ که چنان بتی، چنین می گشدم %~% من زنده به مهر و، او به کین می کشدم(@)(@@) (@@) آنم نکشد، که گشت با من دشمن %~% با دشمن من دوست شد، این می کشدم!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2365 مپسند بتا، با تو نشست دگری %~% مخمور تو چاکر و، تومست دگری! 
ms237	(@)(@@) (@@) از دیده به رشکم، که تورا می بیند %~% چون بینمت ای دوست، به دست دگری!(@)(@@)(@@)(@@) | اسید اشرف(@)(@@) (@@) 2366 ای کرده دل خویش قرار دگری %~% خرم شده از تو، روزگار دگری(@)(@@) (@@) من در غم تو، کنار پر خون دارم %~% تو شاد نشسته، در کنار دگری(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2367 گیرم که زجان خسته، شرمت نایدیا زین دل در توبسته، شرمت ناید(@)(@@) (@@) برخاستم اندر غم تو، از سر دل %~% تو با دگری نشسته، شرمت ناید!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2368 عهدم، به سر زلف پریشان شکنی اومید دلم، به غمزه در جان شکنی(@)(@@) ~~پیمان مشکن، که نیست ای جان وجهانبر هیچ کسی خجسته، پیمان شکنی(@)(@@)(@@)(@@) | عایشه(@)(@@) ~~2369 دوشم همه شب، ای به غمت جانم شاد بدگویانت- که روزشان نیک مباد!(@)(@@) (@@) از عهد بدت، حکایتی می کردند %~% وانگه چه؟ دلم نیز گواهی می داد!(@)(@@)(@@)(@@) | الها(@)(@@) (@@) 237 امروز، به چشم من چنان می آید %~% کز لعل لبت، بوی کسان می آید(@)(@@) ~~انا، بم زمردمافمی اید PageV01P398(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0402.jpg)(@)(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~2371 دل بر تونهادم و، نبایست نهاد زیرا که تو، داد عشق نتوانی داد!(@)(@@) (@@) من در غم تو، توبا کسی دیگر شاد %~% بد مهر کسی، خدات به زین بکناد!(@)(@@)(@@)(@@) | شهاب(@)(@@) (@@) 2372 تا کی زتو، ای سنگدل عهد شکن %~% رخساره، به آب دیده تر دارم من(@)(@@) (@@) آخر به چه فتوتت حلال است، بگو %~% خون من و، دست یار تو در گردن؟(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2372 شرمت ناید ز رو یت، ای عهد شکن %~% کز وصل تو برخورد دگر یار، نه من(@)(@@) (@@) ر رغم من ومراد خود، میداری %~% خون من و، دست دیگری در گردن!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2374 آن عهد شکن، عهد دگر باره شکست %~% با دشمن دوست شد، بیکجا بنشست(@)(@@) (@@) جایی بشکست و، جای دیگر در بست %~% در پار شکسته بسته، دل نتوان بست!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 2375 بر من ستمت یکی وده نیست، صد است %~% و ین غصه نه از توست مرا، هم زخود است(@)(@@) (@@) وانگه چه بدادهای به بد خواه، مرا %~% الغیره %~% این نیک نه بد 
ms238	 بکردنت نیک بدست(@)(@@) (@@) 37) حاشا که زطعن دشمنان می رنجم %~% وز بوالعجبی این وآن می رنجم(@)(@@) (@@) با سوز دگر کسی، از آن می سوزم %~% با رنج دگر کسی، از آن می رنجم(@)(@@) (@@) 2377 ای چنگ طرب نواخته با دگری %~% انوری %~% وی نرد وصال باخته با دگری(@)(@@) (@@) در مذهب دوستان روا نیست، چنین %~% من سوخته و، تو ساخته با دگری!(@)(@@)(@@)(@@) | خوافی(@)(@@) (@@) 2378 از آرزوی رخ جهان آرایت %~% شد روز رهی، چو زلف عنبر سایت(@)(@@) (@@) دست دگران تو می دهی بوسه و، من %~% در آرزوی آنکه ببوسم پایت(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2375 روزی، دل سختت به وفا نرم نبود %~% بازار وصال ما، شبی گرم نبود(@)(@@) (@@) با یار دگر، خنده زنان بنشینی %~% وز دیدهآ گریان منت، شرم نبود!(@)(@)PageV01P399(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0403.jpg)(@)(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) 23880 گفتم بکشم زلف خم اندر خم او %~% خرم شوم، از دو عارض خرم او(@)(@@) (@@) خود با دم من ساخته نامد، دم او %~% او با دگری بساخت، من با غم او!(@)(@@)(@@)(@@) | عزیز(@)(@@) (@@) 2381 جانا، دل من به درد و هجران مشکن %~% اومید من دلشده، در جان مشکن(@)(@@) (@@) تا جان دارم، عهد درستم با توست %~% %~% توبا من دلشکسته، پیمان مشکن!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2382 هستم زغم عشق تو، دیوانه هنوز %~% بر آتش سودای تو، پروانه هنوز(@)(@@) (@@) من سیر شدم زجان شیرین، بی تو %~% تو از دگری سیر شدی، یا نه هنوز!(@)(@@)(@@)(@@) | فخر غوری(@)(@@) (@@) 2383 تو پنداری، تو را بحل خواهم کرد %~% یا با تو، حدیث خوش زدل خواهم کرد(@)(@@) (@@) خوشتر روزی، میان اصحاب وفا %~% از عهد شکستنت، خجل خواهم کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2384 در دل ز فراق، خستگیها دارم %~% در کار زچرخ، بستگیها دارم(@)(@@) (@@) با اینهمه غم، تونیز پیمان وفا %~% مشکن، که جز این شکستگیها دارم!(@)(@@)(@@)(@@) | جمال(@)(@@) ~~2385 دی، در طلبت گرچه به سر خاسته ام امروز، به شیوهای دگر خاسته ام(@)(@@) (@@) با هر که به پیدا و نهان بنشستی %~% بنشین، که من از سر تو برخاسته ام!(@)(@@)(@@)(@@) | لؤلؤی(@)(@@) (@@) 2386 آنگه، که به من بود دل دلبر شاد 
ms239	 %~% بر خاک نشستی، ز طرب دادی داد!(@)(@@) (@@) اکنون، که به یار دیگرش میل فتاد %~% بر خاک زمینش، بوسه می نتوان داد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2387 آن یار، اگر چه خوار بگذاشت مرا %~% واندر کف انتظار، بگذاشت مرا(@)(@@) (@@) آن روز مبادا، که من از دشمن و دوست %~% یاری خواهم که: یار بگذاشت مرا!(@)(@@) (@@) 2388 پنداشتم، آنکه دوست پنداشت مرا %~% دییسی %~% می نتواند، ز دل کم انگاشت مرا(@)(@@) (@@) او نیز، به دیگری گروداشت مرا %~% چون به زمنی بدید، بگذاشت مرا!(@)(@)PageV01P400(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0404.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2389 چون عاشق مبتلای خویشم دیدی بر من، بدلی به دوستی بگزیدی(@)(@@) (@@) از بهر تو، من ز دیگران ببریدم %~% خلیل %~% وزمن، توز بهر دیگران ببریدی!(@)(@@) (@@) 2390 با دشمن خود دوست شدی از رگ و پوست %~% با دوست شدی دشمن، این خود نه نکوست(@)(@@) (@@) چون نشناسی دوست زدشمن، لاشک %~% با دوست شوی دشمن و، با دشمن دوست!(@)(@@) نمط بیست وششم(@)(@@) در عاشق شدن او(@)(@@) (@@) 239 ای دوست، مرا به کام دشمن کردی %~% ظهیر %~% دشمن نکند، آنچه توبا من کردی(@)(@@) (@@) تو، سوخته خرمن دگر کس بودی %~% چون خو یشتنم، سوخته خرمن کردی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 239 نومید مرا در کف غم بگذاری %~% و آنگاه، از او امید داری یاری(@)(@@) (@@) ای خستهآ او، چنانکه من کشتهآ تو %~% با من آن کن، کزو طمع می داری!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2393 آن بت، که دلم زعشق او زار شدهست %~% او، جای دگر به دل گرفتار شدهست!(@)(@@) (@@) این درد مرا، علاج که تواند کرد؟ %~% کانکس که طبیب بود، بیمار شدهست!(@)(@@)(@@)(@@) | شرف(@)(@@) (@@) 2394 حال تو ومعشوقهآ تو، می شنوم %~% و آوازهآ عشق تو و او، می شنوم(@)(@@) ~~در عشق کسی، آن دل همچون سنگت چون عود همی سوزد و، بو می شنوم!(@)(@@)(@@)(@@) | حلیل(@)(@@) (@@) 2395 جانا، به هوای چون خودی تنگدلی %~% دلدادهآ دیگری، و ده رنگ دلی(@)(@@) ~~از کار تو و دل تو، عاجز شدهام توعاشق و، آنگاه بدین سنگدلی(@)(@@)(@@)(@@) | وله(@)(@@) ~~2396 عاشق شده ای، کنون دلت گرم شود در کشتن عاشقان، به 
ms240	 آزرم شود(@)(@@) (@@) جایی دگرت، کرد گرفتارخدا %~% تا بر دل مردم، دل تو نرم شود!(@)(@)PageV01P401(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0405.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2397 در بند سمنبری شدی، یارب شکر %~% واندر غم دلبری شدی، یارب شکر(@)(@@) (@@) تا چند، دهی خرمن دلها برباد؟ %~% دلدادهآ دیگری شدی، یارب شکر!(@)(@@) نمط بیست وهفتم(@)(@@) در عیبها که از ایشان گیرند(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 2398 گر خصم برید، زلف چون شستش را %~% تر کرد به اشک، نرگس مستش را(@)(@@) (@@) اومید چنان است که بس زود، نه دیر %~% چشم تر من، خشک کند دستش را!(@)(@@)(@@)(@@) | درزلف بریده(@)(@@) (@@) 2399 چون قصد سر زلف دوتا می کردی %~% از بیخ بریدنش، خطا می کردی(@)(@@) (@@) او را به ادب سرزنشی کردن بس %~% یکبارگی ازدهاش چرا می کردی؟(@)(@@)(@@)(@@) | دهان فراخ(@)(@@) (@@) 2400 تا گشت عتاب و جنگ با ماش فراخ %~% شد تنگ شکر، زان لب در پاش فراخ(@)(@@) (@@) گفتند: فراخ است دهان خوش او %~% آن روزی، جان ماست، گوباش فراخ!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2401 دلدار مرا، اگر فراخ است دهان %~% گل را، نه هم از خنده دهان است چنان؟(@)(@@) (@@) چون دستگه نشاط ما، آن دهن است %~% گر دستگهی فراخ باشد، چه زیان!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2402 گر در دهن تو، از بزرگی سخنی است %~% آسوده ز گفت و گوی هر طعنه زنی است(@)(@@) (@@) گر هست به چشم ما، دهان تو بزرگ %~% زان است که آن دهان، نه کوچک دهنی است!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2403 از عشق دهانت، دل مسکین تنگ است %~% گفتند فراخ است، دلم زین تنگ است(@)(@@) ~~هر چند، که درجهان فراخ است دهان باری، دهن فراخ شیرین تنگ است(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~2400 لعل لب او، که درج گوهر باشد در وی چوزبان نهی، نه در خور باشد(@)(@@) (@@) گر خرد نیامد لب او، نیسست عجب %~% یاقوت بزرگ، قیممتی تر باشد!(@)(@)PageV01P402(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0406.jpg)(@)(@)(@@)(@@)(@@) | در احولی(@)(@@) (@@) 2405 هر لحظه، به دیگر نظرم می نگری %~% من راست تر و، تو کژترم می نگری(@)(@@) (@@) گفتی تو دو رویی، این غلط از من نیست %~% لیکن تو، به چشم دیگرم مینگری(@)(@@)(@@)(@@) | ایضا 