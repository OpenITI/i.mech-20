ms81	 % % والمستهين مع الندى بملامه % 6(@)(@@) % فمن أين أرهب أن يراني راجلا % أحد وما أرجو سوى أيامه % 7(@)(@@) % أحمل هداك الله رجلي يا بن من % جادت يداه بنهده وغلامه % 8(@)(@@) % قسم الحياء على الأنام جميعهم % فذهبت أنت فقدته بزمامه % 9(@)(@@) % وتقسم الناس السخاء مجزأ % وذهبت أنت برأسه وسنامه % 10(@)(@@) % وتركت للناس الإهاب ومابقى % % من فرثه وعروقه وعظامه % PageV01P260 البحر : كامل تام 1(@)(@@) % أفنيت فيك معاني الشكوى % % وصفات ما ألقى من البلوى % % 2(@)(@@) % قلبت آفاقض الكلام فما % % أبصرتني أغفلت عن معنى % % 3(@)(@@) % وأعد ما لا أشتكي غبنا ، % فأعود فيه مرة أخرى % % 4(@)(@@) % فلو أن ما أشكو إلى بشر % لأراحني من ذلة الشكوى % % 5(@)(@@) % لكنما أشكو إلى حجر % تنبو المعاول عنه أو أقسى % % 6(@)(@@) % ظبي بمبكاه ومضحكه % فينا تنير وتظلم الدنيا % % PageV01P261 البحر : وافر تام 1(@)(@@) % سقى عهد الحمى سبل العهاد % وروض حاضر منه وباد % 2(@)(@@) % نزحت به ركي العين لما % % رأيت الدمع من خير العتاد % 3(@)(@@) % فيا حسن الرسوم وما تمشى % % إليها الدهر في صور البعاد % 4(@)(@@) % وإذ طير الحوادث في رباها % % سواكن ، وهي غناء المراد % 5(@)(@@) % مذاكي حلبة وشروب دجن % وسامر فتية وقدور صاد % 6(@)(@@) % وأعين ربرب كحلت بسحر % وأجساد تضمخ بالجساد % 7(@)(@@) % بزهر والحذاق وآل برد % ورت في كل صالحة زنادي % % 8(@)(@@) % وإن يك من بني أدد جناحي % % فإن أثيث ريشي من إياد % 9(@)(@@) % غدوت بهم أمد ذوي ظلا % وأكثر من ورائي ماء واد % 10(@)(@@) % هم عظمى الأثافي من نزار % وأهل الهضب منها والنجاد % PageV01P262 11(@)(@@) % معرس كل معضلة وخطب % ومنبت كل مكرمة وآد % 12(@)(@@) % إذا حدث القبائل ساجلوهم % فإنهم بنو الدهر التلاد % 13(@)(@@) % تفرج عنهم الغمرات بيض % جلاد تحت قسطلة الجلاد % 14(@)(@@) % وحشو حوادث الأيام منهم % معاقل مطرد وبنو طراد % % 15(@)(@@) % لهم جهل السباع إذا المنايا % % تمشت في القنا وحلوم عاد % 16(@)(@@) % لقد أنست مساوىء كل دهر % محاسن أحمد بن أبي دواد % 17(@)(@@) % متى تحلل به تحلل جنابا % رضيعا للسواري والغوادي % % 18(@)(@@) % ترشح نعمة الأيام فيه % وتقسم فيه أرزاق العباد % % 19(@)(@@) % وما 
ms82	 اشتبهت طريق المجد إلا % % هداك لقبلة المعروف هاد % % 20(@)(@@) % وما سافرت في الآفاق إلا % ومن جدواك راحلتي وزادي % % PageV01P263 21(@)(@@) % مقيم الظن عندك والأماني % % وإن قلقت ركابي في البلاد % 22(@)(@@) % معاد البعث معروف ولكن % ندى كفيك في الدنيا معادي % % 23(@)(@@) % أتاني عائر الأنباء تسري % % عقاربه بداهية نآد % % 24(@)(@@) % % يجر به على شوك القتاد % 25(@)(@@) % كأن الشمس جللها كسوف % أو استترت برجل من جراد % % 26(@)(@@) % بأني نلت من مضر وخبت % إليك شكيتي خبب الجواد % % 27(@)(@@) % وما ربع القطيعة لي بربع % ولانادي الأذى مني بناد % % 28(@)(@@) % وأين يجور عن قصد لساني % % وقلبي رائح برضاك غاد ! % 29(@)(@@) % ومما كانت الحكماء قالت % لسان المرء من خدم الفؤاد % % 30(@)(@@) % فقدما كنت معسول الأماني % % ومأدوم القوافي بالسداد % % PageV01P264 31(@)(@@) % لقد جازيت بالإحسان سوءا % إذا وصبغت عرفك بالسواد % % 32(@)(@@) % وسرت أسوق عير اللؤم حتى % % أنخت الكفر في دار الجهاد % % 33(@)(@@) % فكيف وعتب يوم منك فذ % أشد علي من حرب الفساد ! % 34(@)(@@) % وليست رغوتي من فوق مذق % ولا جمري كمين في الرماد % 35(@)(@@) % وكان الشكر للكرماء خصلا % وميدانا كميدان الجياد % % 36(@)(@@) % عليه عقدت عقدي ولاحت % مواسمه على شيمي وعادي % % 37(@)(@@) % وغيري يأكل المعروف سحتا % وتشجب عنده بيض الأيادي % % 38(@)(@@) % تثبت إن قولا كان زورا % أتى النعمام قبلك عن زياد % % 39(@)(@@) % وأرث بين حي بني جلاح % سنا حرب وحي بني مصاد % 40(@)(@@) % وغادر في صروف الدهر قتلى % % بني بدر على ذات الإصاد % % PageV01P265 41(@)(@@) % فما قدحاك للباري وليست % متون صفاك من نهر المرادي % % 42(@)(@@) % ولو كشفتني لبلوت خرقا % يصافي الأكرمين ولا يصادي % % 43(@)(@@) % % إلى بعض الموارد وهو صادي % % 44(@)(@@) % إليك بعثت ابكار المعاني % % يليها سائق عجل وحادي % % 45(@)(@@) % جوائر عن ذنابى القوم حيرى % % هوادي للجماجم والهوادي % % 47(@)(@@) % يذللها بذكرك قرن فكر ، % إذا حرنت ، فتسلس في القياد % 48(@)(@@) % لها في الهاجس القدح المعلى % % وفي نظم القوافي والعماد % 49(@)(@@) % منزهة عن السرق المورى % % مكرمة عن المعنى المعاد % % 50(@)(@@) % تنصل ربها من غير جرم % إليك سوى النصيحة والوداد % % 51(@)(@@) % ومن يأذن إلى الواشين تسلق % % PageV01P266 البحر 
ms83	 : بسيط تام 1(@)(@@) % أبا سعيد تلاقت عندك النعم % فانت طود لنا منج ومعتصم % 2(@)(@@) % لا زال جودك يخشى البخل صولته % % وزال عودك تسقي روضه الديم % 3(@)(@@) % أشرفت منك على بحر الغنى ويدي % % يجول في مستواها الفقر والعدم % 4(@)(@@) % فسوف يثبت ركن المدح فيك أخ % لولا رجاؤك لم يثبت له قدم % 5(@)(@@) % أحرمت دونك خوف النائبات فما % % شككت إذ قمت دوني أنك الحرم % PageV01P267 البحر : وافر تام 1(@)(@@) % أيسلبني ثراء المال ربي % % وأطلب ذاك من كف جماد ؟ % 2(@)(@@) % زعمت إذا بأن الجود أمسى % % له رب سوى ابن أبي داود ! % PageV01P268 البحر : كامل تام 1(@)(@@) % نثرت فريد مدامع لم ينظم % والدمع يحمل بعض ثقل المغرم % 2(@)(@@) % وصلت دموعا بالنجيع فخدها % % في مثل حاشية الرداء المعلم % 3(@)(@@) % ولهت فأظلم كل شيء دونها % % وأنار منها كل شيء مظلم % 4(@)(@@) % وكأن عبرتها عشية ودعت % مهراقة من ماء وجهي أو دمي % % 5(@)(@@) % ضعفت جوارح من أذاقته النوى % % طعم الفراق فذم طعم العلقم % 6(@)(@@) % هي ميتة إلا سلامة أهلها % % من خلتين : من الثرى والماتم % 7(@)(@@) % إن شئت أن يسود ظنك كله % % فأجله في هذا السواد الأعظم % 8(@)(@@) % ليس الصديق بمن يعيرك ظاهرا % متبسما عن باطن متجهم % 9(@)(@@) % فليبلغ الفتيان عني مالكا % % إني متى يتثلموا أتهدم % 10(@)(@@) % ولتعلم الأيام أني فتها % % بأبي الحسين محمد بن الهيثم % PageV01P269 11(@)(@@) % بأغر ليس بتوأم ويمينه % % تغدو وتطرق بالنوال التوأم % 12(@)(@@) % قد قلت للمغتر منه بصفحه % وأخو الكرى لو لم ينم لم يحلم % 13(@)(@@) % لا يلحمنكه تحلمه فقد % يودي بك الوادي وليس بمفعم % 14(@)(@@) % حدت الوفود إلى الجزيرة عيسها % % من منجد بمحله أو متهم % 15(@)(@@) % فكأنما لولا المناسك أشركت % ساحاتها أو أوثرت بالموسم % 16(@)(@@) % وكأنه من مدحهم في روضة % وكأنهم من سيبه في مقسم % 17(@)(@@) % كلف برب المجد يزعم أنه % % لم يبتدأ عرف إذا لم يتمم % 18(@)(@@) % نظمت له خرز المديح مكارم % ينفثن في عقد اللسان المفحم % 19(@)(@@) % في قله كثر السماك وإن غدا % % هطلا وعفو يديه جهد المرزم % 20(@)(@@) % خدم العلى فخدمنه وهي التي 
ms84	 % % لاتخدم الأقوام مالم تخدم % PageV01P270 21(@)(@@) % وإذا انتمى في قلة من سؤدد % قالت له الأخرى بلغت تقدم % 22(@)(@@) % ما ضر أروع يرتقي في همة % علياء ألا يرتقي في سلم % 23(@)(@@) % يأبى لعرضك أن يغادر عرضة % ماحوله من مالك المستلحم % 24(@)(@@) % إن التلاد على نفاسة قدره % % لا يرغم الأزمات ما لم يرغم % 25(@)(@@) % لا يستطال على الخطوب ولا ترى % % أكرومة نصفا إذا لم يظلم % 26(@)(@@) % وصنيعة لك ثيب أهديتها % % وهي الكعاب لعائذ بك مصرم % 27(@)(@@) % حلت محل البكر من معطى وقد % زقت من المعطى زفاف الأيم % 28(@)(@@) % ليزدك وجدا بالسماحة ما ترى % % من كيمياء المجد تغن وتغنم % 29(@)(@@) % إن الثناء يسير عرضا في الورى % % ومحله في الطول فوق الأنجم % 30(@)(@@) % وإذا المواهب أظلمت ألبستها % % بشرا كبارقة الحسام المخذم % PageV01P271 31(@)(@@) % أعطيت ما لم تعطه ولو انقضى % % حسن اللقاء حرمت مالم تحرم % 32(@)(@@) % لقددت من شيم كأن سيورها % % يقددن من شيم السحاب المرزم % 33(@)(@@) % لو قلت حصل بعضها أو كلها % % في حاتم لدعيت دافع مغرم % 34(@)(@@) % شهرت فما تنفك توقع باسمها % % من قبل معناها بعدم المعدم % 35(@)(@@) % إن القصائد يممتك شواردا % فتحرمت بنداك قبل تحرمي % % 36(@)(@@) % ما عرست حتى أتاك بفارس % ريعانها والغزو قبل المغنم % 37(@)(@@) % فجعلت قيمها الضمير ومكنت % % منه فصارت قيما للقيم % 38(@)(@@) % خذها فما زالت على استقلالها % % مشغولة بمثقف ومقوم % 39(@)(@@) % تذر الفتي من الرجاء وراءها % % وترود في كنف الرجاء القشعم % 40(@)(@@) % زهراء أحلى في الفؤاد من المنى % % وألذ من ريق الأحبة في الفم % PageV01P272 البحر : طويل 1(@)(@@) % ذكرتك حتى كدت أنساك للذي % % توقد من نيران ذكرك في قلبي % % 2(@)(@@) % بكيتك لما مثل النأي بالهوى % % كأن لم يمثل بي صدودك في القرب % 3(@)(@@) % وهل كان لي في القرب عندك راحة % ووصلك سهم البين في الشرق والغرب % 4(@)(@@) % بلى كان لي في الصبر عنك معول % ومندوحة لولا فضولي في الحب % % PageV01P273 البحر : كامل تام 1(@)(@@) % أرأيت أي سوالف وخدود % عنت لنا بين اللوى فزرود ! % 2(@)(@@) % أتراب غافلة الليالي ألفت % عقد الهوى في يارق وعقود 
ms85	 % 3(@)(@@) % بيضاء يصرعها الصبا عبث الصبا % % أصلا بخوط البانة الأملود % 4(@)(@@) % وحشية ترمي القلوب إذا اغتدت % وسنى ، فما تصطاد غير الصيد % 5(@)(@@) % لا حزم عند مجرب فيها ولا % % جبار قوم عندها بعنيد % 6(@)(@@) % مالي بربع منهم معهود % إلا الأسى وعزيمة المجلود % 7(@)(@@) % إن كان مسعود سقى أطلالهم % سبل الشؤون ، فلست من مسعود % 8(@)(@@) % ظعنوا فكان بكاي حولا بعدهم % ثم ارعويت وذاك حكم لبيد % 9(@)(@@) % أجدر بجمرة لوعة إطفاؤها % % بالدمع أن تزداد طول وقود % 10(@)(@@) % لا أفقر الطرب القلاص ولا أرى % % مع زير نسوان أشد قتودي % % PageV01P274 11(@)(@@) % شوق ضرحت قذاته عن مشربي % % وهوى أطرت لحاءه عن عودي % % 12(@)(@@) % عامي وعام العيس بين وديقة % مسجورة وتنوفة صيخود % 13(@)(@@) % حتى أغادر كل يوم بالفلا % % للطير عيدا من بات العيد % 14(@)(@@) % هيهات منها روضة محمودة % حتى تناخ بأحمد المحمود % 15(@)(@@) % بمعرس العرب الذي وجدت به % أمن المروع ونجدة المنجود % 16(@)(@@) % حلت عرا أثقالها وهمومها % % أبناء إسماعيل فيه وهود % 17(@)(@@) % أمل أناخ بهم وفودا فاغتدوا % % من عنده وهم مناخ وفود % 18(@)(@@) % بدأ الندى وأعاده فيهم وكم % من مبدىء للعرف غير معيد ! % 19(@)(@@) % يا أحمد بن أبي داود حطتني % % بحياطتي ولددتني بلدودي % % 20(@)(@@) % ومنحتني ودا حميت ذماره % % وذمامه من هجرة وصدود % PageV01P275 21(@)(@@) % ولكم عدو قال لي متمثلا % كم من ودود ليس بالمودود ! % 22(@)(@@) % أضحت إياد في معد كلها % % وهم إياد بنائها الممدود % 23(@)(@@) % تنميك في قلل المكارم والعلى % % زهر لزهر أبوة وجدود % 24(@)(@@) % إن كنتم عادي ذاك النبع إن % نسبوا وفلقة ذلك الجلمود % 25(@)(@@) % وشركتموهم ، دوننا ، فلأنتم % شركاؤنا من دونهم في الجود % 26(@)(@@) % كعب وحاتم اللذان تقسما % % خطط العلى من طارف وتليد % 27(@)(@@) % هذا الذي خلف السحاب ومات ذا % % في المجد ميتة خضرم صنديد % 28(@)(@@) % إلا يكن فيها الشهيد فقومه % لايسمحون به بألف شهيد % 29(@)(@@) % ما قاسيا في المجد إلا دون ما % % قاسيته في العدل والتوحيد % 30(@)(@@) % فاسمع مقالة زائر لم تشتبه % آراؤه عند اشتباه البيد % PageV01P276 31(@)(@@) % يستام بعض القول منك بفعله % % كملا وعفو رضاك بالمجهود 
ms86	 % 32(@)(@@) % أسرى طريدا للحياء من التي % % زعموا ، وليس لرهب ة بطريد % 33(@)(@@) % كنت الربيع أمامه ووراءه % قمر القبائل خالد بن يزيد % 34(@)(@@) % فالغيث من زهر سحابة رأفة % والركن من شيبان طود حديد % 35(@)(@@) % وغدا تبين ما براءة ساحتي % % لو قد نفضت تهائمي ونجودي % % 36(@)(@@) % هذا الوليد رأى التثبت بعدما % % قالوا يزيد بن المهلب مود % 37(@)(@@) % فتزعزع الزور المؤسس عنده % وبناء هذا الإفك غير مشيد % 38(@)(@@) % وتمكن ابن أبي سعيد من حجا % % ملك بشكر بني الملوك سعيد % 39(@)(@@) % ما خالد لي دون أيوب ولا % عبد العزيز ولست دون وليد % 40(@)(@@) % نفسي فداؤك أي باب ملمة % % لم يرم فيه إليك بالإقليد ! % PageV01P277 41(@)(@@) % لمقارف البهتان غير مقارف % % ومن البعيد الرهط غير بعيد % 42(@)(@@) % لما أظلتني غمامك أصبحت % تلك الشهود علي وهي شهودي % % 43(@)(@@) % من بعد أن ظنوا بأن سيكون لي % % يوم ببغيهم كيوم عبيد % 44(@)(@@) % أمنية ما صادفوا شيطانها % % فيها بعفريت ولا بمريد % 45(@)(@@) % نزعوا بسهم قطيعة يهفو به % ريش العقوق ، فكان غير سديد % 46(@)(@@) % وإذا أراد الله نشر فضيلة % طويت أتاح لها لسان حسود % 47(@)(@@) % لولا اشتعال النار ، فيما جاورت % ما كان يعرف طيب عرف العود % 48(@)(@@) % لولا التخوف للعواقب لم تزل % للحاسد النعمى على المحسود % 49(@)(@@) % خذها مثقفة القوافي ربها % % لسوابغ النعماء غير كنود % 50(@)(@@) % حذاء تملأ كل أذن حكمة % بلاغة وتدر كل وريد % PageV01P278 51(@)(@@) % كالطعنة النجلاء من يد ثائر % بأخيه أو كالضربة الأخدود % 52(@)(@@) % كالدر والمرجان ألف نظمه % بالشذر في عنق الفتاة الرود % 53(@)(@@) % كشقيقة البرد المنمنم وشيه % في أرض مهرة أو بلاد تزيد % 54(@)(@@) % يعطي بها البشرى الكريم ويحتبي % % بردائها في المحفل المشهود % 55(@)(@@) % بشرى الغني أبي البنات تتابعت % بشراؤه بالفارس المولود % % 56(@)(@@) % كرقى الأوساد والأراقم طالما % % نزعت حمات سخائم وحقود % % PageV01P279 البحر : طويل 1(@)(@@) % أمالك إن الحزن أحلام حالم % % ومهما يدم فالوجد ليس بدائم % 2(@)(@@) % أمالك إفراط الصبابة تارك % جنا واعوجاجا في قناة المكارم % 3(@)(@@) % تأمل رويدا هل تعدن سالما % إلى آدم أم هل تعد ابن سالم % 4(@)(@@) % متى 
ms87	 ترع هذا الموت عينا بصيرة % تجد عادلا منه شبيها بظالم % 5(@)(@@) % وإن تك مفجوعا بأبيض لم يكن % يشد على جداوه عقد التمائم % 6(@)(@@) % بفارس دعمي وهضبة وائل % وكوكب عتاب وجمرة هاشم % 7(@)(@@) % شجا الريح فازدادت حنينا لفقده % وأحدث شجوا في بكاء الحمائم % 8(@)(@@) % فمن قبله ما قد أصيب نبينا % % أبو القاسم النور المبين بقاسم % 9(@)(@@) % وقال علي في التعازي لأشعث % وخاف عليه بعض تلك المآثم % 11(@)(@@) % وللطرفات يوم صفين لم يمت % خفاتا ولا حزنا عدي بن حاتم % PageV01P280 12(@)(@@) % خلقنا رجالا للتصبر والأسى % % وتلك الغواني للبكا والمآتم % 13(@)(@@) % وأي فتى في الناس أحرض من فتى % % غدا في حفارات الدموع السواجم % 14(@)(@@) % وهل من حكيم ضيع الصبر بعدما % % رأى الحكماء الصبر ضربة لازم ! % 15(@)(@@) % ولم يحمدوا من عالم غير عامل % خلافا ولا من عامل غير عالم % 16(@)(@@) % رأوا طرقات العجز عوجا قطيعة % وأقطع عجز عندهم عجز حازم % 17(@)(@@) % فلا برحت تسطو ربيعة منكم % بأرقم عطاف وراء الأراقم % 18(@)(@@) % فأنت وصنواك النصيران إخوة % خلقتم سعوطا للأنوف الرواغم % 19(@)(@@) % ثلاثة أركان وما أنهد سؤدد % إذا ثبتت فيه ثلاث دعائم % PageV01P281 البحر : طويل 1(@)(@@) % ومنفرد بالحسن خلو من الهوى % بصير بأبواب التجرم والعتب % 2(@)(@@) % و لوع بسوء الظن لا يعرف الوفا % % يبيت على سلم ويغدو على حرب % PageV01P282 البحر : طويل 1(@)(@@) % أأحمد إن الحاسدين حشود % وإن مصاب المزن حيث تريد % 2(@)(@@) % فلا تبعدن مني قريبا فطالما % % طلبت فلم تبعد وأنت بعيد % 3(@)(@@) % أصخ تستمع حر القوافي فإنها % % كواكب إلا أنهن سعود % 4(@)(@@) % ولاتمكن الإخلاق منها فإنما % % يلذ لباس البرد وهو جديد % PageV01P283 البحر : كامل تام 1(@)(@@) % يا ربع لو ربعوا على ابن هموم % مستسلم لجوى الفراق سقيم % 2(@)(@@) % قد كنت معهودا بأحسن ساكن % منا وأحسن دمنة ورسوم % 3(@)(@@) % أيام للأيام فيك غضارة % والدهر في وفيك غير مليم % 4(@)(@@) % وظباء أنسك لم تبدل منهم % بظباء وحشك ظاعنا بمقيم % 5(@)(@@) % من كل ريم لو تبدى قطعت % % ألحاظ مقلته فؤاد الريم % 6(@)(@@) % أما الهوى فهو العذاب فإن جرت % فيه النوى فأليم 
ms88	 كل أليم % 7(@)(@@) % أمر التجلد بالتلدد حرقة % أمرت جمود دموعه بسجوم % 8(@)(@@) % ولا والطلول الدارسات ألية % من معرق في العاشقين صميم % 9(@)(@@) % ما حاولت عيني تأخر ساعة % فالدمع مذ صار الفراق غريمي % % 10(@)(@@) % لم يبرح البين المشت جوانحي % % حتى تروت من هوى مسموم % PageV01P284 11(@)(@@) % وإلى جناب أبي الحسين تشنعت % % بزمامها كالمصعب المخطوم % 12(@)(@@) % جاءتك في معج خوائف في البرى % % وعوارف بالمعلم المأموم % 13(@)(@@) % من كل ناجية كأن أديمها % % حيصت ظهارته بجلد أطوم % 14(@)(@@) % تنئي ملاطيها إذا ما استكرهت % سعدانة كإدارة الفرزوم % 15(@)(@@) % طلبتك من نسل الجديل وشدقم % كوم عقائل من عقائل كوم % 16(@)(@@) % ينسن أصوات الحداة ونبرها % % طربا لأصوات الصدى والبوم % 17(@)(@@) % فأصبن بحر نداك غير مصرد % وردا وأم نداك غير عقيم % 18(@)(@@) % لما وردن حياض سيبك طلحا % خيمن ثم شربن شرب الهيم % 19(@)(@@) % إن الخليفة والخليفة قبله % % وجداك ترب نصيحة وعزيم % 20(@)(@@) % وجداك محمودا فلما يألوا % % لك في مفاوضة ولا تقديم % PageV01P285 21(@)(@@) % ما زلت من هذا وذلك لابسا % حللا من البتجيل والتعظيم % 22(@)(@@) % نفسي فداؤك والجبال وأهلها % % في طرمساء من الحروب بهيم % 23(@)(@@) % بالداذويه وخيزج وذواتها % % عهد لسيفك لم يكن بذميم % 24(@)(@@) % بالمصعبيين الذين كأنهم % آساد أغيال وجن صريم % 25(@)(@@) % مثل الب دور تضيء إلا أنها % % قد قلنست من بيضها بنجوم % 26(@)(@@) % ولى بها المخذول يعذل نفسه % متمطرا في جيشه المهزوم % 27(@)(@@) % راموا اللتيا والتي فاعتاقهم % % سيف الإمام ودعوة المظلوم % 28(@)(@@) % ناشدتهم بالله يوم لقيتهم % والخيل تحت عجاجة كالنيم % 29(@)(@@) % ومنحتهم عظتيك من متوعر % متسهل قاسي الفؤاد رحيم % 30(@)(@@) % حتى إذا جمحوا هتكت بيوتهم % بالله ثم الثامن المعصوم % PageV01P286 31(@)(@@) % فتجردت بيض الس يوف لهامهم % وتجرد التوحيد للتخريم % 32(@)(@@) % غاديتهم بالمشرقين بوقعة % صدعت صواعقها جبال الروم % 33(@)(@@) % أخرجتهم بل أخرجتهم فتنة % سلبتهم من نضرة ونعيم % 34(@)(@@) % نقلوا من الماء النمير وعيشة % رغد إلى الغسلين والزقوم % 35(@)(@@) % والحرب تعلم حين تجهل غارة % تغلي على حطب القنا المحطوم % 36(@)(@@) % أن المنايا طوع بأسك والوغى % % ممزوج كأسك من ردى وكلوم % 37(@)(@@) % والحرب تركب 
ms89	 رأسها في مشهد % عدل السفيه به بألف حليم % 38(@)(@@) % في ساعة لو أن لقمانا بها % % وهو الحكيم لصار غير حكيم % 39(@)(@@) % جثمت طيور الموت في أوكارها % % فتركن طير العقل غير جثوم % 40(@)(@@) % والسيف يحلف أنك السيف الذي % % ما اهتز إلا اجتث عرش عظيم % PageV01P287 41(@)(@@) % مشت الخطوب القهقرى لما رأت % خببي إليك مؤكدا برسيم % 42(@)(@@) % فزعت إلى التوديع غير لوابث % لما فزعت إليك بالتسليم % 43(@)(@@) % والدهر ألام من شرقت بلومه % % إلا إذا أشرقته بكريم % 44(@)(@@) % أهببت لي ريح الرجاء فأقدمت % هممي بها حتى استبحن همومي % % 45(@)(@@) % أيقظت للكرم الكرام بناطق % لنداك أظهر كنز كل قديم % 46(@)(@@) % ولقد نكون ولا كريم نناله % حتى تخوض إليه ألف لئيم % 47(@)(@@) % فسننت بالمعروف من أثر الندى % % سننا شفت من دهرنا المذموم % 48(@)(@@) % وسم الورى بخصاصة فوسمته % % بسماحة لاحت على الخرطوم % 49(@)(@@) % جليت فيه بمقلة لم يقذها % % بخل ولم تسفح على معدوم % 50(@)(@@) % يقع أنبساط الرزق في لحظاتها % % نسقا إذا وقعت على محروم % PageV01P288 51(@)(@@) % ويد يظل المال يسقط كيده % % فيها سقوط الهاء في الترخيم % 52(@)(@@) % لا يأمل المال النجاة إذا عدا % % صرف الزمان مجاءة بعديم % 53(@)(@@) % قل للخطوب إليك عني ، إنني % % PageV01P289 البحر : كامل تام 1(@)(@@) % هي فرقة من صاحب لك ماجد % فغدا إذابة كل دمع جامد % 2(@)(@@) % فافزع إلى ذخر الشؤون وغربه % % فالدمع يذهب بعض جهد الجاهد % 3(@)(@@) % وإذا فقدت أخا ولم تفقد له % دمعا ولاصبرا فلست بفاقد % % 4(@)(@@) % أعلي يا بن الجهم إنك دفت لي % % سما وخمرا في الزلال البارد % 5(@)(@@) % لاتبعدن أبدا ولا تبعد فما % % أخلاقك الخضر الربا بأباعد % 6(@)(@@) % إن يكد مطرف الإخاء فإننا % % نغدو ونسري في إخاء تالد % 7(@)(@@) % أو يختلف ماء الوصال فماؤنا % % عذب تحدر من غمام واحد % 8(@)(@@) % أو يفترق نسب يؤلف بيننا % % أدب أقمناه مقام الوالد % 9(@)(@@) % لو كنت طرفا كنت غير مدافع % للأشقر الجعدي أو للذائذ % 10(@)(@@) % أو قدمتك السن خلت بأنه % من لفظك اشتقت بلاغة خالد % PageV01P290 11(@)(@@) % أو كنت يوما بالنجوم مصدقا % لزعمت أنك أنت بكر عطارد 
ms90	 % 12(@)(@@) % صعب فإن سومحت كنت مسامحا % سلسا جريرك في يمين القائد % 13(@)(@@) % ألبست فوق بياض مجدك نعمة % بيضاء حلت في سواد الحاسد % 14(@)(@@) % ومودة ، لا زهدت في راغب ، % يوما ، ولا هي رغبت في زاهد % 15(@)(@@) % غناء ليس بمنكر أن يغتدي % % في روضها الراعي أمام الرائد % % 16(@)(@@) % ما أدعي لك جانبا من سؤدد % إلا وأنت عليه أعدل شاهد % % PageV01P291 البحر : كامل تام 1(@)(@@) % لولا أبو يعقوب في إبرامه % سبب العلى لا نحل ثني ذمامه % 2(@)(@@) % ليث إذا الحاجات لذن بحقوه % % في كره منها وفي إقدامه % % 3(@)(@@) % أنظر إلى الآمال كيف رتوعها % % في فكره وقعوده وقيامه % 4(@)(@@) % كيف الشكاية للزمان وصرفه % وندى الأمير وأنت في أيامه % % 5(@)(@@) % هذا سحاب أنت سقت غمامه % وعليك بعد الله فيض غمامه % % 6(@)(@@) % إن ابتداء العرف مجد باسق % والمجد كل المجد في استتمامه % % 7(@)(@@) % هذا الهلال يروق أبصار الورى % % حسنا وليس كحسنه لتمامه % % PageV01P292 البحر : خفيف تام 1(@)(@@) % غير مستأنس بشيء إذا غبت % سوى ذكرك الذي لا يغيب % 2(@)(@@) % أنت دون الجلاس أنيس أن % % ت بعيدا فالحزن فيك قريب % PageV01P293 البحر : كامل تام 1(@)(@@) % طلل الجميع ، لقد عفوت حميدا % % وكفى على رزئي بذاك شهيدا % % 2(@)(@@) % دمن كأن البين أصبح طالبا % دمنا لدى آرامها وحقودا % % 3(@)(@@) % قربت نازحة القلوب من الجوى % % وتركت شأو الدمع فيك بعيدا % % 4(@)(@@) % خضلا ، إذا العبرات لم تبرح لها % % وطنا سرى قلق المحل طريدا % % 5(@)(@@) % أمواقف الفتيان تطوي لم تزر % من كل لهفان زدت في أود ال % % 6(@)(@@) % أذكرتنا الملك المضلل في الهوى % % والأعشيين وطرفة ولبيدا % % 7(@)(@@) % حلوا بها عقد النسيب ونمنموا % % من وشيها حللا لها وقصيدا % % 8(@)(@@) % راحت غواني الحي عنك غوانيا % يلبسن نأيا تارة وصدودا % % 9(@)(@@) % من كل سابغة الشباب إذا بدت % تركت عميد القريتين عميدا % % 10(@)(@@) % أولعن بالمرد الغطارف بدنا % غيدا ألفنهم لدانا غيدا % % PageV01P294 11(@)(@@) % أحلى الرجال من النساء مواقعا % من كان أشبههم بهن خدودا % % 12(@)(@@) % فاطلب هدوءا بالتقلقل واستثر % بالعيس من تحت السهاد هجودا % % 13(@)(@@) % من كل معطية على علل السرى % % وخدا يبيت 
ms91	 النوم منه شريدا % % 14(@)(@@) % تخدي بمنصلت يظل إذا ونى % % ضرباؤه حلسا لها وقتودا % % 15(@)(@@) % جعل الدجى جملا وودع راضيا % بالهون يتخذ القعود قعودا % % 16(@)(@@) % طبلت ربيع ربيعة الممهي لها % % فوردن ظل ربيعة الممدودا % % 17(@)(@@) % بكريها علويها صعبيها ال % % حصني شيبانها الصنديدا % % 18(@)(@@) % ذهليها مريها مطريها % % يمنى يديها خالد بن يزيدا % 19(@)(@@) % نسب كأن عليه من شمس الضحى % % نورا ومن فلق الصباح عمودا % % 20(@)(@@) % عريان لا يكبو دليل من عمى % % فيه ولا يبغي عليه شهودا % % PageV01P295 21(@)(@@) % شرف على أولى الزمان وإنما % % خلق المناسب أن يكون جديدا % % 22(@)(@@) % لو لم تكن من نبعة نجدية % علوية لظننت عودك عودا % % 23(@)(@@) % مطر أبوك أبو أهلة وائل % % ملأ البسيطة عدة وعديدا % % 24(@)(@@) % كل امرئ لاجئ إلى سنده % ولد الحتوف أساودا وأسودا % % 25(@)(@@) % ربدا ومأسدة على أكتادها % % لبد تخال فليلهن لبودا % % 26(@)(@@) % ورثوا الأبوة والحظوظ فأصبحوا % % جمعوا جدودا في العلى وجدودا % % 27(@)(@@) % وقر النفوس إذا كواكب قعضب % أردين عفريت الوغى المريدا % % 28(@)(@@) % زهرا إذا طلعت عل حجب الكلى % % نحست وإن غابت تكون سعودا % % 29(@)(@@) % ما إن ترى إلا رئيسا مقصدا % تحت العجاج وعاملا مقصودا % % 30(@)(@@) % فزعوا إلى الحلق المضاعف وارتدوا % % فيها حديدا في الشؤون حديدا % % PageV01P296 31(@)(@@) % % مشيا يهد الراسيات وئيدا % % 32(@)(@@) % يغشون أسفحهم مذانب طعنة % سيح وأشنع ضربة أخدودا % % 33(@)(@@) % ما إن ترى الأحساب بيضا وضحا % إلا بحيث ترى المنايا سودا % % 34(@)(@@) % لبس الشجاعة إنها كانت له % قدما نشوغا في الصبا ولدودا % % 35(@)(@@) % بأسا قبيليا وبأس تكرم % % 36(@)(@@) % وإذا رأيت أبا يزيد في ندى % % 37(@)(@@) % يقري مرجيه مشاشة ماله % % وشبا الأسنة ثغرة ووريدا % % 38(@)(@@) % أيقنت أن من السماح شجاعة % تدمي ، وان من الشجاعة جودا % % 39(@)(@@) % وإذا سرحت الطرف حول قبابه % لم تلق إلا نعمة وحسودا % % 40(@)(@@) % ومكارما عتق النجار ، تليدة % إن كان هضب عمايتين تليدا % % PageV01P297 41(@)(@@) % ومتى حللت به أنالك جهده % % ووجدت بعد الجهد فيه مزيدا % % 42(@)(@@) % متوقد منه الزمان وربما % % كان الزمان بآخرين بليدا % % 43(@)(@@) % أبقى يزيد ومزيد وأبوهما % % وأبوه ركنك في الفخار شديدا % % 44 
ms92	(@)(@@) % سلفوا يرون الذكر عقبا صالحا % ومضوا يعدون الثناء خلودا % % 45(@)(@@) % إن القوافي والمساعي لم تزل % مثل النظام ، إذا أصاب فريدا % % 46(@)(@@) % هي جوهر نثر ، فإن ألفته % بالشعر صار قلائدا وعقودا % % 47(@)(@@) % في كل معترك وكل مقامة % يأخذن منه ذمة وعهودا % % 48(@)(@@) % فإذا القصائد لم تكن خفراءها % % لم ترض منها مشهدا مشهودا % % 49(@)(@@) % من أجل ذلك كانت العرب الألى % % يدعون هذا سؤددا محدودا % % 50(@)(@@) % وتند عندهم العلى إلا على % جعلت لها مرر القصيد قيودا % % PageV01P298 البحر : منسرح 1(@)(@@) % بني حميد الله فضلكم % أبقى لكم اصرما فأسعدكم % 2(@)(@@) % أبقى لكم والدا يبركم % أنجدكم في الوغى وأمجدكم % 3(@)(@@) % فاتخذوه لذاك سيدكم % فعرفه في الأنام سودكم % 4(@)(@@) % لو كان في يوم بابك لكم % لم تفقدوا في اللقاء سيدكم % 5(@)(@@) % الله أعطاكم برأفته % أصرم منا منه ليبلوكم % 6(@)(@@) % ألا اشكروا الله ذا الجلال فقد % بالصنع في أصرم تغدكم % 7(@)(@@) % مازال في قومكم لكم ملك % يراب زلاتكم ويكلأكم % PageV01P299 البحر : كامل تام 1(@)(@@) % أطفأت نارهواك من قلبي % % وحللتني من عرو ؟ الحب % % 2(@)(@@) % ابرأت قرحة لوعة ثبتت % % بين الشغاف كقرحة الجنب % 3(@)(@@) % ما الذنب يا كنز الذنوب معا % لك في الهوى لكنه ذنبي % % 4(@)(@@) % فاسلم ولا تسلم فلاعجب % من لم يقل من هجره حسبي ؟ % 5(@)(@@) % % لم تنج لؤلؤة من الثقب ! % PageV01P300 البحر : منسرح 1(@)(@@) % مالكثيب الحمى إلى عقده % مابال جرعائه إلى جرده ! % 2(@)(@@) % ماخطبه ما دهاه ما غاله % ما ناله في الحسان من خرده % % 3(@)(@@) % السالبات امرءا عزيمته % بالسحر والنافثات في عقده % 4(@)(@@) % لبسن ظلين ظل أمن من الده % % ر وظلا من لهوه ودده % 5(@)(@@) % فهن يخبرن عن بلهنية ال % % عيش ويسألن منه عن جحده % 6(@)(@@) % ورب ألمى منهن أشنب قد % رشفت مالا يذوب من برده % 7(@)(@@) % قلتا من الريق ناقع الذوب % إلا أن برد الأكباد في جمده % 8(@)(@@) % كالخوط في القد والغزالة في البه % جة وابن الغزال في غيده % 9(@)(@@) % وما حكاه ولا نعيم له % في جيده بل حكاه في جيده % 10(@)(@@) % فالربع قد عزني على جلدي % % مامح من 
ms93	 سهله ومن جلده % PageV01P301 11(@)(@@) % لم يبق شر الفراق منه سوى % % شريه من نؤيه ومن وتده % 12(@)(@@) % سأخرق لخرق بابن خرقاء كال % % هيق إذا ما استحم في نجده % 13(@)(@@) % مقابل في الجديل صلب القرا % % لوحك من عجبه إلى كتده % 14(@)(@@) % تامكه نهده مداخله % ملمومه محزئله أجده % 15(@)(@@) % إلى المفدى أبي يزيد الذي % % يضل غمر الملوك في ثمده % 16(@)(@@) % ظل عفاة ، يحب زائره % حب الكبير الصغير من ولده % % 17(@)(@@) % إذا أناخوا ببابه أخذوا % % حكميهم من لسانه ويده % 18(@)(@@) % % أموال حتى أقمت من أوده % 19(@)(@@) % مستمطر حل من بني مطر % % ووسمهم لائح على تلده % 20(@)(@@) % فهم يميسون البخترية في % % بروده والأنام في برده % PageV01P302 21(@)(@@) % لايندبون القتيل أو يأتي الحو % ل لهم كاملا على قوده % 22(@)(@@) % إناء مجد ملآن بورك في % % صريحه للعلى وفي زبده % 23(@)(@@) % وهضب عز تجري السماحة في % % حدوره والإباء في صعده % 24(@)(@@) % يزيد والمزيدان في الحرب ال % % زائدتان الطودان من مصده % 25(@)(@@) % نعم لواء الخميس أبت به يو % و خميس عالي الضحى أفده % 26(@)(@@) % خلت عقابا بيضاء في حجرات ال % % ملك طارت منه وفي سدده % 27(@)(@@) % فشاغب الجو وهو مسكنه % وقاتل الريح وهي من مدده % 28(@)(@@) % ومر تهفو ذؤابتاه على % % أسمر متنا يوم الوغى جسده % 29(@)(@@) % مارنه لدنه مثقفه % عراصه في الأكف مطرده % 30(@)(@@) % تخفق أفياؤه على ملك % يرى طراد الأبطال من طرده % PageV01P303 31(@)(@@) % نال بعاري القنا ولابسه % % مجدا تبيت الجوزاء عن أمده % 32(@)(@@) % يعلم أن ليس للعلى لقم % قصد لمن لم يطأ على قصده % 33(@)(@@) % يا فرحة الثغر بالخليفة من % يزيده المرتضى ومن أسده % 34(@)(@@) % تضرم ناراه في قري ووغى % من حد أسيافه ومن زنده % 35(@)(@@) % ممتلئ الصدر والجوانح من % رحمة مملوئهن من حسده % 36(@)(@@) % يأخذ من راحة لشغل ويس % تبقي ليبس الزمان من لغده % 37(@)(@@) % فهو لو اسطاع عند أسعده % لحز عضوا من يومه لغده % 38(@)(@@) % إذ منهم من يعد ساعته الط % لق عتادا له على أبده % 39(@)(@@) % ألوى كثير الأسى على سؤدد ال % % عيش قليل الأسى على 
ms94	 رغده % 40(@)(@@) % قريحة العقل من معاقله % والصبر في النائبات من عدده % PageV01P304 41(@)(@@) % يا مضغنا خالدا لك الثكل إن % خلد حقدا عليك في خلده % 42(@)(@@) % إليك عن سيل عارض خضل الش % ؤبوب يأتي الحمام من نضده % % 43(@)(@@) % مسفه ثره مسحسحه % وابله مستهله برده % 44(@)(@@) % وهل يساميك في العلى ملك % صدرك أولى بالرحب من بلده % 45(@)(@@) % أخلاقك الغر دون رهطك أثر % % رى منه في رهطه وفي عدده % 46(@)(@@) % ومشهد صير الكماة به % خطبانه سلما إلى شهده % 47(@)(@@) % كأنما مبرم القضاء به % من رسله والمنون من رصده % 48(@)(@@) % أرث من خالد بمنصلت ال % % إقدام يوم الهياج منجرده % 49(@)(@@) % كالبدر حسنا وقد يعاوده % عبوس ليث العرين في عبده % 50(@)(@@) % كالسيف يعطيك ملء عينيك من % فرنده تارة ومن ربده % PageV01P305 51(@)(@@) % تالله أنسى دفاعه الزور من % عوراء ذي نيرب ومن فنده % 52(@)(@@) % ولا تناسى أحياء ذي يمن % ماكان من نصره ومن حشده % 53(@)(@@) % جلة أنماره وهمدانه والش % م من أزده ومن أدده % 54(@)(@@) % آثرني إذ جعلته سندا % كل امرىء لاجىء إلى سنده % 55(@)(@@) % في غلة أوقدت على كبد ال % % سائل نارا تعيي على كبده % 56(@)(@@) % إيثار شزر القوى يرى جسد ال % % معروف أولى بالطب من جسده % 57(@)(@@) % وجئته زائرا ، فجاوز بي ال % % أخلاق من ماله إلى جدده % 58(@)(@@) % فرحت من عنده ولي رفد % ينالها المعتفون من رفده % 59(@)(@@) % وهل يرى العسر عذرة رجل % خالد المزيدي من عدده % PageV01P306 البحر : كامل تام 1(@)(@@) % لامته لام عشيرها وحميمها % % منها خلائق قد ابن ذميمها % % 2(@)(@@) % لم تدر كم من ليلة قد خاضها % % ليلاء وهي تنامها وتنيمها % % 3(@)(@@) % نكرت فتى أذرى بنضرة وجهه % وبمائه تكد الخطوب ولومها % % 4(@)(@@) % لا تنكري همي فإني زائدي % % حزما حضار النائبات وشومها % % 5(@)(@@) % فلقبل أظهر صقل سيف أثره % % فبدا وهذبت القلوب همومها % % 6(@)(@@) % والحادثات وإن أصابك بوسها % % فهو الذي أنباك كيف نعيمها % % 7(@)(@@) % أو ما رأيت منازل ابنة مالك % رسمت له كيف الزفير رسومها % % 8(@)(@@) % أناؤها وطلولها ونجادها % % ووهادها وحديثها وقديمها % % 9(@)(@@) % تغدو الرياح سوافيا وعوافيا 
ms95	 % فتضيم مغناها وليس يضيمها % % 10(@)(@@) % وكأنما ألقى عصاه بها النوى % % من شقة قذف فليس يريمها % % PageV01P307 11(@)(@@) % إني كشفتك أزمة بأعزة % غر إذا عمر الأمور بهيمها % % 12(@)(@@) % بثلاثة كثلاثة الراح استوى % % لك لونها ومذاقها وشميمها % % 13(@)(@@) % وثلاثة الشجر الجني تكافأت % أفنانها وثمارها وأرومها % % 14(@)(@@) % وثلاثة الدلو أستجيد لماتح % أعوادها ورشاؤها وأديمها % % 15(@)(@@) % وثلاثة القدر اللواتي أشكلت % % أأخيرها ذو العبء أم قيدومها % % 16(@)(@@) % وإذا علوق الحاج يوما سكنت % بهم فقد رئمتك حين ترومها % % 17(@)(@@) % عبد الحميد لها وللفضل الربا % % فيها ومثل السيف إبراهيمها % % 18(@)(@@) % جازوا خلائق قد تيقنت العلى % % كل التيقن أنهن نجومها % % 19(@)(@@) % لو أن باقلا المفهه ينبري % % في مدحها سهلت عليه خزومها % % 20(@)(@@) % ولو ان سحبان المفوة ينتحي % % في ذمها لم يدر كيف يذيمها % % PageV01P308 21(@)(@@) % إنا أتيناكم نصون مآربا % يستصغر الحدث العظيم عظيمها % % 22(@)(@@) % بالعيس قاسمنا الفلا أشلاءها % % والبيد لا يعطى السواء قسيمها % % 23(@)(@@) % فلنا أمين فصوصها وشخوصها % % ولها وري سديفها ولحومها % % 24(@)(@@) % أخذت محالتها السهوب وبدءها % % فالبعد يعذرها ونحن نلومها % % 25(@)(@@) % صفح عن النبآت ليس يؤودها % % جرس الدجى مكاؤها ونئيمها % % 26(@)(@@) % ليلية قد وقرت هاماتها % % من قبل أصداء الفلاة وبومها % % 27(@)(@@) % مهرية بلغ الكراية ركبها % % منها وغاب مريحها ومسيمها % % 28(@)(@@) % فعنيقها يعضيدها ووسيجها % % سعدانها وذميلها تنومها % % 29(@)(@@) % ملك الكلال رقابها وأنوفها % % فنعوبها دين - لها وسعومها % % 30(@)(@@) % فكأن مهملها مخيس غيرها % % وكأنما مخلوعها مخطومها % % PageV01P309 البحر : بسيط تام 1(@)(@@) % مربب الحزن في القلوب % وناصر العزم في الذنوب % 2(@)(@@) % ما شئت من منظر عجيب % فيه ومن منطق أريب % 3(@)(@@) % لما رأى رقبة الأعادي % % على معنى به كئيب % 4(@)(@@) % جرد لي من هواه ودا % صار رقيبا على الرقيب % PageV01P310 البحر : طويل 1(@)(@@) % يقول أناس في حبيناء عاينوا % % عمارة رحلي من طريف وتالد % 2(@)(@@) % أصادفت كنزا أم صبحت بغارة % ذوي غرة حاميهم غير شاهد % 3(@)(@@) % فقلت لهم لا ذا ولا ذاك ديدني % % ولكنني أقبلت من عند خالد % 4(@)(@@) % جذبت نداه غدو السبت جذبة % فخر صريعا بين أيدي القصائد % 5(@)(@@) % فأبت بنعمى منه بيضاء لدنة % كثيرة 
ms96	 قرح في قلوب الحواسد % 6(@)(@@) % هي الناهد الريا إذا نعمة امرىء % % سواه غدت ممسوحة غير ناهد % 7(@)(@@) % فرعت عقاب الأرض والشعر مادحا % له فارتقى بي في عقاب المحامد % 8(@)(@@) % فألبسني من أمهات تلاده % وألبسته من أمهات قلائدي % % PageV01P311 البحر : وافر تام 1(@)(@@) % سقت رفها وظاهرة وغبا % أبا بشر أهاضيب الغمام % 2(@)(@@) % لبست به الصبابة غير أني % % سررت به لزمزم والمقام % 3(@)(@@) % غداة غدت به أجد حلال % تشذر تحت غطريف حرام % 4(@)(@@) % ثوت لفراقه الآداب شعثا % وجفت بعده غدر الكلام % 5(@)(@@) % أخو ثقة نأى فبقيت لما % % نأى غرضا لإخوان السلام % 6(@)(@@) % ذوي الهمم الهوامد والأكف ال % % جوامد والمروات النيام % 7(@)(@@) % يظل عليك أصفحهم حقودا % لرؤيا إن رآها في المنام % 8(@)(@@) % ومن شر المياه إذا استميحت % أواجنها على طول المقام % PageV01P312 البحر : بسيط تام 1(@)(@@) % لأشكرنك إن لم أوت من أجلي % % شكرا يوافيك عني آخر الأبد % 2(@)(@@) % وإن توردت من بحر البحور ندى % ولم أنل منه إلا غرفة بيدي % PageV01P313 البحر : بسيط تام 1(@)(@@) % إلياس كن في ضمان الله والذمم % ذا مهجة عن ملمات النوى حرم % 2(@)(@@) % سلامة لك لاتهتاج نضرتها % % ودعدعا ولعا في النعل والقدم % 3(@)(@@) % الله عافاك منها علة عرضا % لم تنح أظفارها إلا على الكرم % 4(@)(@@) % تكشفت هبوات الثغر مذ كشفت % آلاء ربك ما استشعرت من سقم % 5(@)(@@) % فإن يكن وصب عاينت سورته % فالورد حلف لليث الغابة الأضم % 6(@)(@@) % إن الرياح إذا ما أعصفت قصفت % عيدان نجد ولم يعبأن بالرتم % 7(@)(@@) % بنات نعش ونعش لا كسوف لها % % والشمس والبدر منه الدهر في الرقم % 8(@)(@@) % والحادثات عدو الأكرميين فما % % تعتام إلا امرأ يشفى من القرم % 9(@)(@@) % فليهنك الأجر والنعمى التي عظمت % حتى جلت صدأ الصمصامة الخذم % 10(@)(@@) % قد ينعم الله بالبلوى وإن عظمت % ويبتلي الله بعض القوم بالنعم ! % PageV01P314 البحر : طويل 1(@)(@@) % ألا يا خليلي اللذين كلاهما % % يلبيك عند النائبات نجيب % 2(@)(@@) % أعيناعلى ظبي جعلت نصيبه % ومالي فيه ما حييت نصيب % PageV01P315 البحر : كامل تام 1(@)(@@) % أرويت طمآن الصعيد الهامد % وملأت من جزعيك عين الرائد 
ms97	 % 2(@)(@@) % ولقد أتيتك صاديا فكرعت في % % شيم ألذ من الزلال البارد % 3(@)(@@) % مهدت لاسمك منزلا ومحلة % في الشعر بين نوادر وشواهد % 4(@)(@@) % فهو المراح لكل معنى عازب % وهو العقال لكل بيت شارد % 5(@)(@@) % كم نعمة زينتني بسموطها % % كالعقد في عنق الكعاب الناهد % 6(@)(@@) % غادرتها كالسور عولي سمكه % مضروبة بيني وبين الحاسد % 7(@)(@@) % فاشدد يديك على يدي وتلافني % % من مطلب كدر الموارد راكد % 8(@)(@@) % أصبحت في طرقاته ووجوهه % أعمى وكنت نبيل القائد % 9(@)(@@) % تلك القليب مباحة أرجاؤها % % والحوض منتظر ورود الوارد % 10(@)(@@) % والدلو بالغة الرشاء مليئة % بالري إن وصلت بباع واحد % PageV01P316 البحر : كامل تام 1(@)(@@) % ليت الظباء أبا العميثل خبرت % % خبرا يروي صاديات الهام % 2(@)(@@) % إن الأمير إذا الحوادث أظلمت % % نور الزمان وحلية الإسلام % 3(@)(@@) % والله ما يدري بأية حالة % يبأى مجاوره على الأيام % 4(@)(@@) % أبما يجامعه لديه من الغنى % % أم ما يفارقه من الإعدام % 5(@)(@@) % وأرى الصحيفة قد علتها فترة % فترت لها الأرواح في الأجسام % 6(@)(@@) % إن الجياد إذا علتها صنعة % راقت ذوي الألباب والإفهام % 7(@)(@@) % لتزيد الأبصار فيها فسحة % وتأملا بعناية القوام % 8(@)(@@) % لولا الأمير وأن حاكم رأيه % في الشعر أصبح أعدل الحكام % 9(@)(@@) % لثكلت آمالي لديه بأسرها % % أو كان إنشادي خفير كلامي % % 10(@)(@@) % ولخفت في تفريقه ما بيننا % % ما قيل في عمرو وفي الصمصام % PageV01P317 البحر : طويل 1(@)(@@) % تلقاه طيفي في الكرى فتجنبا % % وقبلت يوما ظله فتغضبا % % 2(@)(@@) % وخبرأني قدمررت ببابه % % لأخلس منه نظرة فتحجبا % % 3(@)(@@) % و لو مرت الريح الصبا عند أذنه % بذكري لسب الريح أو لتعتبا ! % 4(@)(@@) % ولم تجر مني خطرة بضميره % فتظهر إلا كنت فيها مسببا % % 5(@)(@@) % و ما زاده عندي قبيح فعاله % و لا الصد والاعراض إلا تحببا % % PageV01P318 البحر : بسيط تام 1(@)(@@) % يا بعد غاية العين إن بعدوا % % هي الصبابة طول الدهر والسهد % 2(@)(@@) % قالوا : الرحيل غدا لاشك ، قلت لهم % اليوم أيقنت أن اسم الحمام غد % 3(@)(@@) % كم من دم يعجز الجيش اللهام إذا % % بانوا ستحكم فيه العرمس الاجد % 4(@)(@@) % ما لامرىء خاض في بحر 
ms98	 الهوى عمر % إلا وللبين منه السهل والجلد % 5(@)(@@) % كأنما البين من إلحاحه أبدا % على النفوس أخ للموت أو ولد % 6(@)(@@) % تداو من شوقك الأقصى بما فعلت % خيل ابن يوسف والأبطال تطرد % 7(@)(@@) % ذاك السرور الذي آلت بشاشته % ألا يجاورها في مهجة كمد % 8(@)(@@) % لقيتهم والمنايا غير دافعة % لما أمرت به والملتقى كبد % 9(@)(@@) % في موقف وقف الموت الزعاف به % فالموت يوجد والأرواح تفتقد % 10(@)(@@) % في حيث لا مرتع البيض الرقاق إذا % % أصلتن جدب ولا ورد القنا ثمد % PageV01P319 11(@)(@@) % مستصحبا نية قد طال ما ضمنت % لك الخطوب فأوفت بالذي تعد % 12(@)(@@) % ورحب صدر لو أن الأرض واسعة % كوسعه لم يضق عن أهلها بلد % 13(@)(@@) % صدعت جريتهم في عصبة قلل % قد صرح الماء عنها وانجلى الزبد % 14(@)(@@) % من كل أروع ترتاع المنون له % إذا تجرد لا نكس ولا جحد % 15(@)(@@) % يكاد حين يلاقي القرن من حنق % قبل السنان على حوبائه يرد % 16(@)(@@) % قلوا ، ولكنهم طابوا ، فأنجدهم % جيش من الصبر لا يحصى له عدد % 17(@)(@@) % إذا رأوا للمنايا عارضا لبسوا % % من اليقين دروعا مالها زرد % 18(@)(@@) % نأوا عن المصرخ الأدنى ، فليس لهم % إلا السيوف على أعدائهم مدد % 19(@)(@@) % ولى معاوية عنهم وقد حكمت % % فيه القنا ، فأبى المقدار والأمد % 20(@)(@@) % نجاك في الروع ما نجى سميك في % % صفين والخيل بالفرسان تنجرد % PageV01P320 21(@)(@@) % إن تنفلت وأنوف الموت راغمة % فاذهب فأنت طليق الركض يا لبد % 22(@)(@@) % لاخلق أربط جأشا منك يوم ترى % % أبا سعيد ولم يبطش بك الزؤد % 23(@)(@@) % أما وقد عشت يوما بعد رؤيته % % فافخر فإنك أنت الفارس النجد % 24(@)(@@) % لو عاين الأسد الضرغام رؤيته % ما ليم أن ظن رعبا أنه الأسد % 25(@)(@@) % شتان بينهما في كل نازلة % نهج القضاء مبين فيهما جدد % 26(@)(@@) % هذا على كتفيه كل نازلة % تخشى ، وذاك على أكتافه اللبد % 27(@)(@@) % أعيا علي وما أعيا بمشكلة % بسندبايا ويوم الروع محتشد % 28(@)(@@) % من كان أنكأ حدا في كتائبهم % أأنت أم سيفك الماضي أم الأحد ؟ % 29(@)(@@) % لا يوم أكثر منه منظرا حسنا % والمشرفية 
ms99	 في هاماتهم تخد % 30(@)(@@) % أنهبت أرواحه الأرماح إذ شرعت % فما ترد لريب الدهر عنه يد % PageV01P321 31(@)(@@) % كأنها وهي في الأوداج والغة % وفي الكلى تجد الغيظ الذي نجد % 32(@)(@@) % من كل أزرق نظار بلا نظر % إلى المقاتل ما في متنه أود % 33(@)(@@) % كأنه كان ترب الحب مذ زمن % فليس يعجزه قلب ولا كبد % 34(@)(@@) % تركت منهم سبيل النار سابلة % في كل يوم إليها عصبة تفد % 35(@)(@@) % كأن بابك بالبذين بعدهم % نؤي أقام خلاف الحي أو وتد % 36(@)(@@) % بكل منعرج من فارس بطلس % % 37(@)(@@) % لما غدا مظلم الأحشاء من أشر % أسكنت جانحتيه كوكبا يقد % 38(@)(@@) % وهارب ودخيل الروع يجلبه % إلى المنون كما يستجلب النقد % 39(@)(@@) % كأنما نفسه من طول حيرتها % % منها على نفسه يوم الوغى رصد % 40(@)(@@) % تالله ندري : أألإسلام يشكرها % % من وقعة أم العباس أم أدد % PageV01P322 41(@)(@@) % يوم به أخذ الإسلام زينته % بأسرها واكتسى فخرا به الأبد % 42(@)(@@) % يوم يجي إذا قام الحساب ولم % يذممه بدر ولم يفضح به أحد % 43(@)(@@) % وأهل موقان إذ ماقوا فلا وزر % أنجاهم منك في الهيجا ولا سند % 44(@)(@@) % لم تبق مشركة إلا وقد علمت % إن لم تتب أنه للسيف ما تلد % 45(@)(@@) % والببر حين اطلخم الأمر صبحهم % قطر من الحرب لما جاءهم خمدوا % % 46(@)(@@) % كادت تحل طلاهم من جماجمهم % لو لم يحلوا ببذل الحكم ما عقدوا % % 47(@)(@@) % لكن ندبت لهم رأي ابن محصنة % يخاله السيف سيفا حين يجتهد % 48(@)(@@) % في كل يوم فتوح منك واردة % تكاد تفهمها من حسنها البرد % 49(@)(@@) % وقائع عذبت أنباؤها وحلت % حتى لقد صار مهجورا لها الشهد % 50(@)(@@) % إن ابن يوسف نجى الثغر من سنة % أعوام يوسف عيش عندها رغد % PageV01P323 51(@)(@@) % آثار أموالك الأدثار قد خلقت % وخلفت نعما آثارها جدد % 52(@)(@@) % فافخر فما من سماء للندى رفعت % إلا وأفعالك الحسنى لها عمد % 53(@)(@@) % واعذر حسودك فيما قد خصصت به % % إن العلى حسن في مثلها الحسد % PageV01P324 البحر : بسيط تام 1(@)(@@) % حبست فاحتبست من أجلك الديم % ولم يزل نابيا عن صحبك العدم % 2 
ms100	(@)(@@) % يا بن المسيب قولا غير ماكذب % لولاك لم يدرض ما المعروف والكرم % 3(@)(@@) % جللتني نعما جلت وأجر بأن % يجل شكري إذ جلت لي النعم % 4(@)(@@) % يا من إذا قعدت بالقوم همتهم % عن اكتساب العلى قامت به الهمم % 5(@)(@@) % رأيت عودك من نبع أرومته % ما في جوانبه لين ولا وصم % 6(@)(@@) % أنت السليل فسل السيف منتصرا % لذمة الشعر إذ ضاعت له الذمم % 7(@)(@@) % علوت من مجد قيس في الورى علما % أعيا الورى وعلا مجدا بك العلم % PageV01P325 البحر : بسيط تام 1(@)(@@) % لئن جحدتك ما لاقيت فيك لقد % % صحت شهود تباريحي وتعذيبي % % 2(@)(@@) % بزفرة بعد أخرى طالما شهدت % بأنها انتزعت من صدر مكروب % 3(@)(@@) % لكن عدوت على جسمي فبنت به % يامن رأى الظبي عداء على الديب % PageV01P326 البحر : طويل 1(@)(@@) % سرت تستجير الدمع خوف نوى غد % وعاد قتادا عندها كل مرقد % 2(@)(@@) % وأنقذها من غمرة الموت ، أنه % صدود فراق لا صدود تعمد % 3(@)(@@) % فأجرى لها الإشفاق دمعا موردا % من الدم فوق خد مورد % 4(@)(@@) % هي البدر يغنيها تودد وجهها % % إلى كل من لاقت وإن لم تودد % 5(@)(@@) % ولكنني لم أحو وفرا مجمعا % ففزت به إلا بشمل مبدد % 6(@)(@@) % ولم تعطني الأيام نوما مسكنا % ألذ به إلا بنوم مشرد % 7(@)(@@) % وطول مقام المرء في الحي مخلق % لديباجتيه فاغترب تتجدد % 8(@)(@@) % فإني رأيت الشمس زيدت محبة % إلى الناس أن ليست عليهم بسرمد % 9(@)(@@) % حلفت برب البيض تدمى متونها % % ورب القنا المناد والمتقصد % 10(@)(@@) % لقد كف سيف الصامتي محمد % تباريح ثأر الصامتي محمد % PageV01P327 11(@)(@@) % رمى الله منه بابكا وولاته % بقاصمة الأصلاب في كل مشهد % 12(@)(@@) % بأسمح من غر الغمام سماحة % وأشجع من صرف الزمان وأنجد % 13(@)(@@) % إذا ما دعوناه بأجلح أيمن % دعاه ، ولم يظلم بأصلع أنكد % 14(@)(@@) % فتى يوم بذ الخرمية لم يكن % بهياب نكس ولا بمعرد % 15(@)(@@) % قفا سندبايا والرماح مشيحة % % تهدى إلى الروح الخفي فتهتدي % % 16(@)(@@) % عدا الليل فيها عن معاوية الردى % % وما شك ريب الدهر في أنه ردي % 17(@)(@@) % لعمري لقد حررت يوم لقيته 