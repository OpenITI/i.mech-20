ms121	(@)(@@) % باتت جحيم القلب تلفح قلبه % فتفيض ، من قلب يغيض ، دموعه % % PageV01P426 11(@)(@@) % عقد الجفون ببارق نقب الدجى % % وخفا ، كما اطرد الشجاع ، لميعه % 12(@)(@@) % وكأنه بالغيث بات محدثا % للطرف بالخضراء وهو سميعه % % 13(@)(@@) % خدع الظلام وكان من لمعانه % % مسباره وحسامه ونجيعه % % 14(@)(@@) % ومجلجل درت بأنفاس الصبا % % وهنأ لقضباء النبات ضروعه % % 15(@)(@@) % خضعت له عنق لها وتحملت % من ثقله فوق الذي تسطيعه % 16(@)(@@) % وجرت به أثر السماء من الثرى % % ميتا فعاشت بالربيع ربوعه % % 17(@)(@@) % % نفضت له لمما فطار هجوعه % % PageV01P427 البحر : كامل تام 1(@)(@@) % أصبحت عندك أرتجي وأخاف % ما هكذا يتألف الألاف % 2(@)(@@) % يا كيف بات علي قلبك جامدا % يقسو فليس يلينه استعطاف % 3(@)(@@) % وجمان ثغرك رف من لمعانه % وعقيق خدك رائق شفاف % 4(@)(@@) % لم تنصفيني في معاملة الهوى % % وأعز شيء في الدمى الإنصاف % % PageV01P428 البحر : بسيط تام 1(@)(@@) % يا باقة في يميني للردى بذلت % أذاب قلبي عليك الحزن والأسف % 2(@)(@@) % ألم تكوني لتاج الحسن جوهرة % لما غرقت ، فهلا صانك الصدف % PageV01P429 البحر : طويل 1(@)(@@) % دعوا عبراتي تنبري من شؤونها % % فلن تصرفوا توكافهن عن الوكف % 2(@)(@@) % ويحمل دمع العين عن قلبي الأسى % % ولكنه يبدي هواي الذي أخفي % % PageV01P430 البحر : طويل 1(@)(@@) % صفا لي من ورد الشبيبة ما صفا % % وجاد زماني بالأماني فانصفا % % 2(@)(@@) % وشنفت أذني بالهوى حسن منطق % بنجواه غازلت الغزال المشنفا % % 3(@)(@@) % ليالي كانت بالسرور منيرة % وكان قناعي حالكا لا مفوفا % % 4(@)(@@) % وشربي من نسل الغمام سلالة % تعود من العنقود في الدن قرقفا % % 5(@)(@@) % معتقة حمراء ينساغ صرفها % % إذا الماء فيها بالمزاج تصرفا % % 6(@)(@@) % كماء عقيق في الزجاج منظم % عليه من الإزباد درا مجوفا % % 7(@)(@@) % توقد في كف المنادم نورها % % ولكنه بالشرب في فمه انطفا % % 8(@)(@@) % تطوف بها ممشوقة القد زرفنت % من المسك في الكافور صدغا معطفا % % 9(@)(@@) % إذا أعرضت في الدل ذل أخو الهوى % % وصاغ لها لفظ الخضوع الملطفا % % 10(@)(@@) % هنالك خفت بي إلى اللهو صبوة % وثقلت الكاسات كفي بما كفى % % PageV01P431 11(@)(@@) % كأني لم أقنص نوارا من المها % % ولم أجن عذب الرشف من مرة الجفا 
ms122	 % % 12(@)(@@) % ذكرت الحمى والساكنيه ودونه % % خضم عليه تنبري الريح حرجفا % % 13(@)(@@) % ولما أقلوا يوم بينهم على % % هلال السرى للشمس خدرا مسجفا % % 14(@)(@@) % وألقت حلاها من يديها وعطلت % % من الحلي فيد جيد رئم تشوفا % % 15(@)(@@) % سقى الأقحوان الطل . . . . عفة % % وعضت من الحزن البنان المطرفا % % 16(@)(@@) % ولما جرى الدر الرطيب بخدها % % وسال إلى الدر النظيم توقفا % % 17(@)(@@) % وأين تراه ذاهبا عن جنى فم % كأن رضاب الكأس من ترشفا % % 18(@)(@@) % أما وشباب بالمشيب أعتبرته % فأشرقت عيني بالدموع تأسفا % % 19(@)(@@) % لقد سرت في سهب المديح هداية % ومثلي فيه لا يسير تعسفا % % 20(@)(@@) % ولو كنت من در الدراري نظمته % % لكان علي منه أعلى وأشرفا % % PageV01P432 21(@)(@@) % همام من الأملاك هز لواءه % % وأوضح حوليه الجياد وأوجفا % % 22(@)(@@) % شجى ذكره للروم كالموت إن جرى % % أخاف ، وإن أوفى على النفس أتلفا % % 23(@)(@@) % ذبوب عن الإسلام مد لجيشه % جناجا عليه بالأسنة رفرفا % % 24(@)(@@) % يرد عن الضرب الحديد مثلما % ويثني عن الطعن الوشيج مقصفا % % 25(@)(@@) % إذا ظللته الطير كانت أجورها % % جسوما ثنى عن طعنها الزرق رعفا % % 26(@)(@@) % نسور وعقبان إذا هي أقبلت % محلقة سدت من الجو نفنفا % % 27(@)(@@) % وتحسبها في نقعه رقم برقع % يجول على وجه من الشمس مسدفا % % 28(@)(@@) % حمى ما حمى من بيضة الدين سيفه % وأشفق في ذات الإله وعنفا % % 29(@)(@@) % ومن عدم أغنى ، ومن حيرة هدى % % ومن ظمإ أروى ، ومن مرض شفى % % 30(@)(@@) % كريم السجايا لوذعي زمانه % % تهذب من أخلاقه وتظرفا % % PageV01P433 31(@)(@@) % إذا عن رأي كالسها في ضيائه % % ولم يكف أذكى رأيه الشمس فاكتفى % % 32(@)(@@) % سما في العلا قدرا فأدرك ما سما % % إليه ، وأصمى سهمه ما تهدفا % % 33(@)(@@) % سكوب حيا الكفين لا ناضب الندى % % ولا مخلف وعدا إذا الغيث أخلفا % % 34(@)(@@) % تريه خفيات الأمور بصيرة % كأن حجاب الغيب عنها تكشفا % % 35(@)(@@) % بذكر ابن يحيى عطر الدهر مدحنا % % وخلد فيه ذكرنا وتشرفا % % 36(@)(@@) % جواد بنان البذل منه غمائم % تصوب على أيدي بني الدهر وكفا % % 37(@)(@@) % عليم بسر الحرب من قبل جهرها % % وقرع الصفا بين الفريقين بالصفا % % 38(@)(@@) % يقارع منهم 
ms123	 حاسرا كل معلم % أفاض عليه الفارسي المضعفا % % 39(@)(@@) % عصاه لتأديب العصاة إذا بغوا % % غرار حسام يقرع الهام مرهفا % % 40(@)(@@) % على أنه راسي الأناة مخدع % إذا زاغ حلم عن ذوي الحزم أو هفا % % PageV01P434 41(@)(@@) % بنو الحرب أنتم أرضعتكم ثديها % % فمفترق الأقدام فيكم تألفا % % 42(@)(@@) % لكم قلب بالذابلات وبالظبا % % أخاديد في . . . . . . . . . . . . % 43(@)(@@) % إذا ما بدا طعن الكماة وضربهم % % كنقط وشكل منه أعجمت أحرفا % % 44(@)(@@) % فدع عنك ما حظته . . . . . . . . % . . . . . . . . . . . . . . . . . . . . . . . . % 45(@)(@@) % لك الخيل تسري الليل من كل سلهب % ترى بطنه من شدة الركض مخطفا % % 46(@)(@@) % إذا وطئت شم الجبال نسفنها % % بنصرك للتوقيع في الجيش حرفا % % 47(@)(@@) % إذا وطئت شم الجبال نسفتها % % وغادرنها قاعا لعينيك صفصفا % % 48(@)(@@) % فيه ملك العصر الذي ظل عدله % % على الدين والدنيا صفا منه ما صفا % % 49(@)(@@) % نداك بطبع للعفاة ارتجلته % وغيرك روى في نداه تكلفا % % 50(@)(@@) % وكم من فقير بائس قد وصلته % % فأضحى غنيا يسحب الذيل مترفا % % PageV01P435 51(@)(@@) % لمدحك أضحت كل فكرة شاعر % مصنفة منه غريبا مصنفا % % 52(@)(@@) % وإن كنت عن حفل العلى غائبا فلي % % ثناء كعرف المسك بالفضل عرفا % % PageV01P436 البحر : بسيط تام 1(@)(@@) % وقد تشق بنا الأهوال جارية % تجري بريح متى تسكن لها تقف % 2(@)(@@) % لها شراع ترى الملاح يلحظه % ككاهن يقسم الألحاظ في كتف % PageV01P437 البحر : طويل 1(@)(@@) % أحن إلى العشرين عاما وبيننا % % ثلاثون يمشي المرء فيها إلى خلف % 2(@)(@@) % ولو صح مشي نحوه لا بتدرته % % فجئت الصبا أحبو على العين والأنف % PageV01P438 البحر : خفيف تام 1(@)(@@) % لي قلب من جلمد الصخر أقسى % % وهو من رقة النسيم أرق % 2(@)(@@) % كهصور في كفه الظفر عضب % وغرير في صدره النهد حق % 3(@)(@@) % عزمتي كوكب وطرفي ريح % وأضاتي غيم ، وسيفي برق % % 4(@)(@@) % ضربتي في مفارق الذمر جيب % بين كفي عند غيط يشق % 5(@)(@@) % حشوها من فلول عضبي شظايا % % كنيوب عنهن قلص شدق % PageV01P439 البحر : متقارب تام 1(@)(@@) % وممشوقة القد معشوقة % تعذب أنفس عشاقها % % 2(@)(@@) % بعين إذا سحرت بالفتور % % بدا للمها بعض أحداقها % % 3(@)(@@) % وقد يميت حياة الغصون % % فتذوي نضارة أوراقها % % 4(@)(@@) % وشدو يقوم لفرط 
ms124	 السرور % % بنفس الحزين على ساقها % % 5(@)(@@) % تهيم به الهيم عن شربها % % زلالا لإحياء أرماقها % % 6(@)(@@) % وتخلع إن سمعته الحمام % عليها قلائد أطواقها % % 7(@)(@@) % فمن لشج سهل أخلاقه % يعذبه وعر أخلاقها % % 8(@)(@@) % ترى صدها عاقلا روحه % % فيا وصلها جد بإطلاقها % % PageV01P440 البحر : متقارب تام 1(@)(@@) % ولما تنازعن معنى الحديث % % بمختلف اللفظ أو متفق % 2(@)(@@) % لوين الحواجب نزع القسي % وأرسلن عنهن نيل الحدق % 3(@)(@@) % فلم يصب القلب من قبلها % % سهام منصلة بالحدق % 4(@)(@@) % فكان علينا الهوى لا لنا % % وعن الفراق ومنه الفرق % % 5(@)(@@) % فيا لو رأيت ارتعاد الجسوم % لقلت الرياح تهز الورق % % 6(@)(@@) % وأبصرت حمر دموع الجفون % لقلت تعلق منها العلق % PageV01P441 البحر : بسيط تام 1(@)(@@) % أحرقت فضلة مسواك لها حسدا % % له على لثم در في اللمى يقق % 2(@)(@@) % وما علمت بجهل أن ريقتها % % تعطي السلامة ري المندل العبق % % 3(@)(@@) % لا عدت أحرق عودا من سواك فم % يزيد إحراقه في شدة الحرق % PageV01P442 البحر : بسيط تام 1(@)(@@) % وسابح لاعب في بحره مرحا % تشير كفاه تعويذا من الغرق % % 2(@)(@@) % يدعو ولم يك مضطرا : خذوا بيدي % % وعنده الفرق بين الأمن والفرق % % 3(@)(@@) % فإن بكيت فإني قد ذكرت به % % من جرعت منه كأس الموت بالشرق % % 4(@)(@@) % ردت على البحر من كفي جوهرة % ثم انقلبت بقلب دائم الحرق % PageV01P443 البحر : منسرح 1(@)(@@) % أجلو عروسا بخدها خجل % كالورد لونا ونشرها عبق % 2(@)(@@) % كأنما كوكب يصافحني % % مجوف الجسم روحه شفق % 3(@)(@@) % حمراء مشمولة لها عمر % في طرف منه دهرها غرق % 4(@)(@@) % أسالها حمرة العقيق فلي % % من لؤلؤ ، بعد شربها عرق % % 5(@)(@@) % راح أضافت إلى دمي دمها : % طبائع في المزاج تتفق % % 6(@)(@@) % وللثريا يد مختمة % منها بنانا خضابها الغسق % 7(@)(@@) % كأنها والصباح يقطفها % % عنقود نور له الدجى ورق % % 8(@)(@@) % وفحمة الليل كلما اعترضت % ألهب فيها اتقاده الفلق % % 9(@)(@@) % عجبت من محرق ومحترق % لا فحمة منهما ولا حرق % % PageV01P444 البحر : كامل تام 1(@)(@@) % يا تاركا راحا تسلي همه % هلا اتقيت السم بالدرياق % 2(@)(@@) % وتناولت يمناك نارا لم تخف % في لمسها لذعا من الإحراق % % 3(@)(@@) % حمراء 
ms125	 تشرب بالأنوف سلافها % % لطفا وبالأسماع والأحداق % 4(@)(@@) % بزجاجة صور الفوارس نقشها % % فترى لها حربا بكف الساقي % % 5(@)(@@) % وكأنما سفكت صوارمها % % لبست به غرقا إلى الأعناق % % 6(@)(@@) % وكأن للكاسات حمر غلائل % أزرارها درر على الأطواق % PageV01P445 البحر : متقارب تام 1(@)(@@) % وأكلف منسره ذو شغا % % كعطفة رأس السنان الذليق % % 2(@)(@@) % له مقلة كحلت بالنجيع % % تصرف إيماض لحظ صدوق % % 3(@)(@@) % كأن بجؤجؤه مهرقا % موشى بأحرف خط دقيق % 4(@)(@@) % يصيد بك خطاطيفها % % مركبة في وظيف وثيق % % 5(@)(@@) % يباكر بالصيد سرب القطا % % وبينهما كل فج عميق % 6(@)(@@) % ويصبح سرب الحمام الحمام % % ويجنح مثل الجناح الخفوق % % 7(@)(@@) % كأن عقابا على أفقه % % ترود الوغى يوم ريح خريق % % 8(@)(@@) % ولما انجلى الليل واستوضحت % % له غرة الصبح في رأس نيق % % 9(@)(@@) % فبات ولا خوف في نفسه % % بهمته حاز بيض الأنوق % 10(@)(@@) % وقلب ، والفتك في نفسه ، % حماليق مثل ائتلاق البروق % % PageV01P446 11(@)(@@) % وقد نفض الطل عن منكبيه % % بمثل انتفاض الطمر العتيق % % 12(@)(@@) % ترى ريشه فوق أرجائه % % طراقا كمثل حباب الرحيق % % 13(@)(@@) % رأى ما رأى وبريق الشعاع % % يكحل أجفانه بالشروق % % 14(@)(@@) % وأيقن بالسوء من صيده % % فدل على سبج بالعقيق % % 15(@)(@@) % وحلق وانقض من جوه % % كما صوبت حجر المنجنيق % % 16(@)(@@) % فتحسبه عند إقعاصها % % يشق حيازيمها عن شقيق % % PageV01P447 البحر : كامل تام 1(@)(@@) % ومنسم الآذي يعنق شطه % من نكبة هوجاء حل وثاقها % % 2(@)(@@) % وكأنما رأت الحقاق فعجعجت % % فيها القروم وأزبدت أشداقها % % PageV01P448 البحر : كامل تام 1(@)(@@) % ومجرر في الأرض ذيل عسيبه % حمل الزبرجد منه جسم عقيق % % 2(@)(@@) % يجري ولمع البرق في آثاره % % من كثرة الكبوات غير مفيق % % 3(@)(@@) % ويكاد يخرج سرعة من ظله % لو كان يرغب في فراق رفيق % % PageV01P449 البحر : طويل 1(@)(@@) % وطائرة بذ الخيول بسبقها % % وقد لبست للعين من فرس خلقا % % 2(@)(@@) % إذا شئت ألقت بي على الغرب رجلها % % ونالت يد منها بوثبتها الشرقا % % 3(@)(@@) % لحوق كأني جاعل من عدائها % % لرسغ الفرا عقلا وجيد المها ربقا % % 4(@)(@@) % كريح ترى من نقعها سحبا لها % % ومن رشحها قطرا ومن لحظها برقا % % PageV01P450 البحر : كامل تام 1(@)(@@) % جاءتك أولاد الوجيه 
ms126	 ولاحق % فأرتك في الخلق ابتداع الخالق % 2(@)(@@) % نينان أمواه ، وفتخ سباسب % وظباء آجام ، وعصم شواهق % 3(@)(@@) % بمؤللات تستدير كأنها % % أقلام مبتدع الكتابة ماشق % 4(@)(@@) % قد وقعت لك بالسعود وما جرت % بسواد نقس في بياض مهارق % % 5(@)(@@) % غر محجلة تكامل خلقها % % بمجانس من حسنها ومطابق % % 6(@)(@@) % وكأنما حيث علاك وجوهها % % فأسأل فيها الصبح بيض طرائق % % 7(@)(@@) % كرت ذخائر عربها في عتقها % % وشأت بفضله عدوها المتلاحق % 8(@)(@@) % وإذا الجلال تجردت عن جردها % % لبست غلالة كل لون رائق % 9(@)(@@) % من كل طرف يستطير كطرفه % جريا فوثبته غلاب السابق % % 10(@)(@@) % ورد تميع فيه عندم حمرة % كالورد أهدي في الربيع لناشق % PageV01P451 11(@)(@@) % وكأنه وكأن غرة وجهه % % شفق تألق فيه مطلع شارق % 12(@)(@@) % وكأن صبحا خص فاه بقبلة % فابيض موضعها لعين الرامق % % 13(@)(@@) % متصيد برياضة وطلاقة % في تيه معشوق وطاعة عاشق % % 14(@)(@@) % وإذا تغنى بالصهيل مطربا % أنسى أغاني معبد ومخارق % 15(@)(@@) % ومزعفر لون القميص بشقرة % كالريح تعصف في التهاب البارق % % 16(@)(@@) % وتراه يدبر كالظليم بردفه % % عجبا ، ويقبل كانتصاب الباشق % 17(@)(@@) % وإذا طرقت به انتهي بك غاية % % أبدا تشق على الخيال الطارق % % 18(@)(@@) % كاد الكميت ينوب عن لعس اللمى % % ويسوغ كالخمر الكميت لذائق % % 19(@)(@@) % ويمد فوق البحر عند عبوره % % جسرا بهاد للسماء معانق % 20(@)(@@) % خيل كأن الركض من خيلائها % % في قلب كل معاند ومنافق % PageV01P452 21(@)(@@) % وكأنما اقتسمت عيون أجادل % وشدوق غربان ، وسوق نقانق % 22(@)(@@) % قدها تخب بكل ذمر أبله % بخداع أبطال الوقائع حاذق % 23(@)(@@) % وإذا أثرن بنقعهن سحائبا % صبت على الأعداء صوب صواعق % 24(@)(@@) % أصبحت في السادات ناصر دولة % تصف العلى عدل مناطق % % 25(@)(@@) % بطلا يطول بذكره في سلمه % % كصياله بحسامه في المأزق % % 26(@)(@@) % مترحلا نحو المعالي ساكنا % بالجيش في ظل اللواء الخافق % % 27(@)(@@) % شدت عزائمه مهالكه كما % % شدت فزازين بعقد بيادق % PageV01P453 البحر : خفيف تام 1(@)(@@) % رب ليل هصرت فيه بغصن % لابس نضرة النعيم وريق % 2(@)(@@) % فيه رمانة تطاعن صدري % % فهي أمضى من السنان الذليق % 3(@)(@@) % أسأل الورد منه عن أقحوان % مجتنى الشهد منه في طل ريق 
ms127	 % 4(@)(@@) % فشققت الشقيق من شفتيه % % عن حباب محدث عن رحيق % 5(@)(@@) % واكتست زرقة السماء سحابا % مسمعا رعده هدير الفنيق % 6(@)(@@) % وحمى من وشاتنا كل وبل % بأفاعي السيول كل طريق % % 7(@)(@@) % وكأن الظلام يحرق قارا % % منه في الخافقين نفط البروق % 8(@)(@@) % رق صبري وصبرها بنسيم % واصف صبحه بمعنى رقيق % % 9(@)(@@) % وشواد شدت فلولا اشتهاري % % نحت من شدوها بكل شهيق % % 10(@)(@@) % أضحك الله من بكى بجمان % رحمة للذي بكى بعقيق % PageV01P454 البحر : وافر تام 1(@)(@@) % خطاب عن لقائكم يعوق % ومثلي لا يناط به العقوق % 2(@)(@@) % أأقدر أن يقدر لي زمان % له خلق بألفتنا خليق % 3(@)(@@) % فيقبض بعدنا ليل عدو % ويبسط قربنا يوم صديق % % 4(@)(@@) % لقد حنت إلى مثواك نفسي % % كمرزمة إلى وطن تتوق % 5(@)(@@) % تحمل بالنوى عني التأسي % % وحملني الأسى ما لا أطيق % 6(@)(@@) % وحمر دمعي المبيص حزن % يذوب بحره قلبي المشوق % 7(@)(@@) % كأن العين تسقط منه عينا % فلؤلؤه ، إذا ذرفت ، عقيق % % 8(@)(@@) % وهبني قد قدحت زناد عزم % تضرم في الأناة له حريق % 9(@)(@@) % أليس الله ينفذ منه حكما % % فيعقلني به ، وأنا الطليق ؟ % 10(@)(@@) % فرغت من الشباب فلست أرنو % % إلى لهو ، فيشغلني الرحيق % PageV01P455 11(@)(@@) % ولا أنا في صقلية غلاما % فتلزمني لكل هوى حقوق % % 12(@)(@@) % ليالي تعمل الأفراح كأسي % % فما لي غير ريق الكأس ريق % 13(@)(@@) % تجنبت الغواية عن رشاد % كما يتجنب الكذب الصدوق % % 14(@)(@@) % وإن كانت صبابات التصابي % % تلوح لها على كلمي بروق % 15(@)(@@) % كتبت إليك في ستين عاما % فساحا في خطاي بهن ضيق % % 16(@)(@@) % ومن يرحل إلى السبعين عاما % فمعترك المنون له طريق % % 17(@)(@@) % أبا الحسن انتشق من سلاما % كأن نسيمه مسك فتيق % 18(@)(@@) % وقل لدي عليل عند كرب % تناول راحة فيها يفيق % % 19(@)(@@) % أرى القدر المتاح إذا رآني % % جريت جرى فكان هو السبوق % % 20(@)(@@) % فلا تيأس فللرحمن لطف % يحل بيسره العقد الوثيق % % PageV01P456 البحر : بسيط تام 1(@)(@@) % يا ليل هل لصباحي فيك إشراق % فقد نفى النوم عن عيني إيراق % 2(@)(@@) % عساكر البق نحوي فيك زاحفة % % كأنما بث وسط البيت سماق % % 3(@)(@@) % من 
ms128	 كل طاعنة الخرطوم سارية % كأن لسعتها بالنار إحراق % % PageV01P457 البحر : سريع 1(@)(@@) % وطائر في الجو من مغرب % % في قطعه الليل إلى مشرق % % 2(@)(@@) % كأنما تنبع من سحبه % % شعلة نفط للدجى محرق % % 3(@)(@@) % لو كان يبقى نوره في الدجى % % كان كحط التبر في الميلق % % PageV01P458 البحر : بسيط تام 1(@)(@@) % ما للوشاة عليها أذكت الحدقا % % أما علا النور من إسرائها الغسقا % % 2(@)(@@) % أما تضوع من أردانها أرج % كأنما مسك دارين به فتقا % % 3(@)(@@) % أما تألق من سمطي تبسمها % % برق إذا ما رآه ناظر برقا % % 4(@)(@@) % هيفاء يقلق في الخصر الوشاح لها % % كأن قلبي منه علم القلقا % % 5(@)(@@) % كأنما مال خوط في ملاءتها % % بالشمس واهتز منها في كثيب نقا % % 6(@)(@@) % باتت على عقب الشكوى تملقني % % وكل دمية حسن تحسن الملقا % % 7(@)(@@) % واستوثقت من نقاب فوق وجنتها % % وإنما أشفقت أن ألثم الشفقا % % 8(@)(@@) % يا هذه تدعين الوجد عارية % من الضنى فدعي الشكوى لمن عشقا % % 9(@)(@@) % وأجملي قتل نفس لا يتاركها % % برح الغرام وإلا رمقي الرمقا % % 10(@)(@@) % ما أحسن العطف من تأنيس نافرة % كأنما رضت منها شادنا خرقا % % PageV01P459 11(@)(@@) % فبت أحمي بأنفاسي حصى درر % ببردها في التراقي تعرف الفلقا % % 12(@)(@@) % وأجتني مستطيبا ما حواه فم % من ماء ظلم برود يطفىء الحرقا % % 13(@)(@@) % وللوشاة عيون غير واقعة % على ضجيعين من في الكرى اعتنقا % % 14(@)(@@) % من زار في سنة الأجفان في خفر % لم يخش غيران مرهوب الشذا حنقا % % 15(@)(@@) % قنعت بالطيف لما صد صاحبه % والطيب إن غاب أبقى عندك العبقا % % 16(@)(@@) % لولا هلال أعير الطرف زورقه % % في خوضه لجة الظلماء ما طرقا % % 17(@)(@@) % من أين لي في الهوى نوم فيطرقني % % خيال من نومها يغري بي الأرقا % % 18(@)(@@) % وإنما الفكر في الأجفان مثلها % % فما كذبت على جفني ولا صدقا % % 19(@)(@@) % ألله أعطى لقوم في تعشقهم % % سعادة ، ولقوم آخرين شقا % % 20(@)(@@) % والله أحيا بيحيى كل مكرمة % للمعتفين ، وأجرى نائلا غدقا % % PageV01P460 21(@)(@@) % ملك تناول أسباب العلا بيد % قد أودع الله فيها رزق من خلقا % % 22(@)(@@) % سميذع تبسط الآمال همته % ويقبض الحلم منه 
ms129	 الغيظ والحنقا % % 23(@)(@@) % أعلى الملوك منارا في ذرى شرف % لا يرتقي كوكب في الجو حيث رقا % % 24(@)(@@) % وأثبت الأسد في جوف العدى قدما % إذا جناح لواء فوقه خفقا % % 25(@)(@@) % إن ضن بالجود مقبوض اليدين سخا % % وإن عتا ظالم في ملكه رفقا % % 26(@)(@@) % كم من عدوين في دين قد اختلفا % % حتى إذا أخذا في فضله اتفقا % % 27(@)(@@) % وكم نديمين لولا لذة لهما % % في ذكر سيرته الحسناء لافترقا % % 28(@)(@@) % كأنما الناس من أطواق أنعمه % % حمائم تتغنى مدحه حزقا % % 29(@)(@@) % كأنما يعتري أمواله وله % فما لهما غير أصوات العفاة رقى % % 30(@)(@@) % تجاود الكف منه الكف مغنية % فقلما تبقيان العين والورقا % % PageV01P461 31(@)(@@) % من أوهن الله كيد الناكثين به % % إذا قذفت بحق باطلا زهقا % % 32(@)(@@) % من لا يصول الهدى حتى يطول به : % لا يضرب السيف ، لولا الضارب ، العنقا % % 33(@)(@@) % تكبو السوابق عن أدنى مداه فلو % % يسابق الريح في أفق العلا سبقا % % 34(@)(@@) % ذمر إذا علقت بالحرب عزمته % روى القواضب فيه والقنا علقا % % 35(@)(@@) % كأنما العضب في يمناه صاعقة % إذا علا رأس جبار به صعقا % % 36(@)(@@) % يكاد لولا تلظي الروع ذابله % في كفه من نداه يكتسي ورقا % % 37(@)(@@) % كأنما يودع اليمنى له قلما % يخط خط المنايا كلما مشقا % % 38(@)(@@) % وما رأى ناظر من قبله أسدا % قد أكمل الله فيه الخلق والخلقا % % 39(@)(@@) % ويوم حرب ترى الأبطال موردة % فيها حياض المنايا شزبا عتقا % % 40(@)(@@) % تروق ذا الجهل زينا ثم تذعره % خوفا إذا شام من أنيابها روقا % % PageV01P462 41(@)(@@) % ترى السوابغ عن أذمار مأزقها % % تواقع الأرض من وقع الظبا فرقا % % 42(@)(@@) % إذا انتحتك مدماة لها حلق % خلت اليعاقيب فيها فتحت حدقا % % 43(@)(@@) % شك القلوب بصدق الطعن لهذمه % وغادر الهام فيها سيفه فلقا % % 44(@)(@@) % إليك يا ابن تميم أعملت قلص % تحت الرحائل تبري الوخد والعنقا % % 45(@)(@@) % كأن مثواك لليت العتيق أخ % واليعملات إليه تملأ الطرقا % % 46(@)(@@) % وكيف تعقل أيدي العيس عن ملك % بكف نعماه معقول الندى انطلقا % % 47(@)(@@) % تقبل السحب منه للسماح يدا % % لو ألقي البحر في معروفها غرقا % % PageV01P463 البحر 
ms130	 : وافر تام 1(@)(@@) % بقيت مع الحياة ومات شعري % % بشيبي فالقذال به ينقى % % 2(@)(@@) % فشعري لا يكفن في خضاب % ولا ينفك للأنظار ملقى % % 3(@)(@@) % وتركك من شجاك الموت منه % % بلا كفن لحزن فيك أبقى % % 4(@)(@@) % فلا تخضب مشيبك للغواني % % فتغنى عنه ناعمة وتشقى % % 5(@)(@@) % فشاهد زور خضبك ليس يعطى % % بباطله من الغادات حقا % % 6(@)(@@) % فلا تهو الفتاة وأنت شيخ % فأبعد وصلها من صيد عنقا % % PageV01P464 البحر : طويل 1(@)(@@) % أخذت برأي في الصبا أنا تاركه % فم ترني في مسلك أنت سالكه % 2(@)(@@) % وإن لم أعاقرك المدام فإنني % % حقنت دم الزق الذي أنت سافكه % % 3(@)(@@) % وإن رزايا العمر منهن مركبي % % ثقال ، بأعطان المنايا مباركه % % 4(@)(@@) % دفعت ولم أملك دفاع ملمة % إلى زمن في كل حين أعاركه % 5(@)(@@) % وجيش خطوب زاحم كل ساعة % فما أنفس الأحياء إلا هوالكه % % 6(@)(@@) % كأن البروق الخاطفات بروقه % وزهر النجوم اللائحات نيازكه % % 7(@)(@@) % فإن تنج نفسي من كلوم سلاحه % % فإن برأسي ما أثارت سنابكه % % 8(@)(@@) % مضى كل عصر وهو حرب لأهله % وهل تصرع الآساد إلا معاركه % % 9(@)(@@) % برغمي ، وما في الحب بالرغم لذة ، % أحب مشيبي والغواني فواركه % % 10(@)(@@) % مغير حسني عن جميل روائه % وموهن جسمي بالليالي وناهكه % PageV01P465 11(@)(@@) % رأتني سليمى والقذال كأنما % % تنفس فيه الصبح فابيض حالكه % % 12(@)(@@) % كما نظرت سلمى إلى رأس دعبل % وقد عجبت والشيب يبكيه ضاحكه % % 13(@)(@@) % فتاة أرى طرفي لطرفي حاسدا % % يغايره في حسنها ويماحكه % % 14(@)(@@) % على وصلها ستر فمن لي بهتكه % % إذا ما مضى عني من العمر هاتكه % % 15(@)(@@) % شباب له القدح المعلى من الهوى % % وما شئت من رق الدمى فهو مالكه % % 16(@)(@@) % كأني لم يؤنس من السرب وحشي % مشنف أذن فاتر اللحظ فاتكه % % 17(@)(@@) % غزال تراني ناصبا من تغزلي % % له شركا في كل حال يشاركه % % 18(@)(@@) % وصاد إلى ري الكؤوس غمرته % بعارضها والغيث درت حواشكه % % 19(@)(@@) % وقلت : اغتبق من دنها صرف قهوة % إلى قدح الندمان تفضي سوالكه % % 20(@)(@@) % ويمنعها من أن تطير لطافة % حباب عليها دائرات شبائكه % % PageV01P466 21(@)(@@) % على زهر روض ناضر تحسب الربى 
ms131	 % % ملوكا على الأجسام منهم درانكه % % 22(@)(@@) % وبات لجين الماء بالقر جامدا % % لنا ونضار البرق ذابت سبائكه % % 23(@)(@@) % أذلك خير أم تعسف سبسب % يعقل أخفاف النجائب عاتكه % % 24(@)(@@) % وإن جن ليل أقبلت نحو سفره % مجلجة أغواله وصعالكه % % 25(@)(@@) % مهالكه بالفأل تسمى مفاوزا % وما الفوز إلا أن تخاض مهالكه % % 26(@)(@@) % بمعط غداة السير ظهر حنية % بنيت عليها الكور فانهد تامكه % % 27(@)(@@) % ألائمتي إن الجمل جندل % صليب وإني بالتجلد لائكه % % 28(@)(@@) % أرى طرفا لي من لسانك جارحا % فما بال جدوى لا تداركه % % 29(@)(@@) % تريدين مني جمع مالي ومنعه % وهل لي بعد الموت ما أنا مالكه % % 30(@)(@@) % إذا أدركت خلا من الدهر فاقة % فما بال جدوى راحتي لا تداركه % % PageV01P467 البحر : متقارب تام 1(@)(@@) % ومالئة من سناها العيون % أأبصرت شمس الضحى هي كذاك % 2(@)(@@) % تسوك حصى برد في عقيق % % فيا لهما ظلما بالسواك % % 3(@)(@@) % وما قهوة ميعت مسكة % % فبينهما للأريج اشتراك % % 4(@)(@@) % بأطيب منها جنى ريقة % إذا نحر الليل رمح السماك % 5(@)(@@) % وما ذقت فاها ولكنني % % نقلت شهادة عود الأراك % % PageV01P468 البحر : رمل تام 1(@)(@@) % هات كأس الراح أو خذها إليك % ينزل اللهو بها بين يديك % % 2(@)(@@) % ريقة العيش بها ، فاخلع على % % شفتيها كل حين شفتيك % % 3(@)(@@) % وأطع فيها نديميك بما % % حكما واعص عليها عاذليك % % 4(@)(@@) % وإذا سقيت منها شفقا % طلعت حمرته في وجنيتك % 5(@)(@@) % وتناول نشوة من روضة % طلعت كالشمس بالنجم عليك % 6(@)(@@) % تتغنى بنسيب قلته % فهواها راجع منك إليك % % 7(@)(@@) % فاوضت في الوصل عيني عينها % % فازدهت عجبا وقالت : ما لديك ؟ % 8(@)(@@) % أعليل أنت ، ماذا تشتهي ؟ % قلت : قطفي بيدي رمانتيك % % 9(@)(@@) % فانثنت كبرا وقالت : ويلتا % % أوهذا كله تطلب ويك ؟ % 10(@)(@@) % أنا شمس وبعيد فلكي % % وضيائي نافر من راحيتك % PageV01P469 11(@)(@@) % لو بدا أمرك لي من قبل ذا % % ما رأت ناظرتي ناظرتيك % % PageV01P470 البحر : خفيف تام 1(@)(@@) % قل لمن ضاهت الغزالة نورا % % وهي من طيبها غزالة مسك % 2(@)(@@) % أنت في العين واللسان وفي القل % % ب فأين استقر قدري منك % % 3(@)(@@) % إن نقضت الوفاء بالغدر ظلما % فبهذا أشار طرفك 
ms132	 عنك % 4(@)(@@) % لك قلبي صفا فلا غش فيه % % وهو للهجر منك في نار سبك % 5(@)(@@) % أضحك الشامتين صدك عني % % بدموعي ، فأدمع القلب تبكي % % PageV01P471 البحر : كامل أحذ 1(@)(@@) % الهجر يضحك والهوى يبكي % % والوصل بينهما على هلك % % 2(@)(@@) % يا جنتي ما كنت أحسب أن % أصلى جحيم قطيعة منك % 3(@)(@@) % لله عين منك مخبرة % عني بكل سريرة عنك % 4(@)(@@) % عجبي للفظ منك ذي نسك % هذا ولحظك حاضر الفتك % % 5(@)(@@) % وسلبت قلبي من حشاي فهل % لك في القلوب صناعة الدك % 6(@)(@@) % أغزالة الفلك التي عقبت % مسكا فقلت : غزالة المسك % % 7(@)(@@) % إن دام هجرك لي بلا سبب % فلأنت قاتلتي بلا شك % PageV01P472 البحر : سريع 1(@)(@@) % أذابل النرجس في مقلتيك % أن ناضر الورد على وجنتيك % % 2(@)(@@) % لا تنكري أنك حورية % فنفحة الجنة نمت عليك % % 3(@)(@@) % وعقربا صدغيك من عنبر % سمهما ويلاه من عقربيك % 4(@)(@@) % وردفك المرتج في غصنه % مياس آهتز برمانتيك % % 5(@)(@@) % ويح وشاحيك فمتا أصبحا % % صفرين إلا حسدا دملجيك % % 6(@)(@@) % أفي نطاقيك تثنيت أم % دفعت خصريك إلى خاتميك % % 7(@)(@@) % بالله من صير من ناظريك % % سهميك أم رمحيك أم صارميك % % 8(@)(@@) % فحيثما كنت خشيت الردى % % منك ، أكل القتل في ناظريك ؟ % 9(@)(@@) % لو شئت حييت نشاوى الهوى % % من لون خديك بتفاحتيك % % 10(@)(@@) % وإن تغنيت لنا لم نزل % نخلع أفواها على أخمصيك % % PageV01P473 11(@)(@@) % لا صبر لي عنك وإن كان لي % % على جناياتك ، صبر عليك % % PageV01P474 البحر : رمل تام 1(@)(@@) % ما الذي أعددت للموت فقد % قدر الموت بلا شك عليك % 2(@)(@@) % أذنوبا كاثرت عد الحصى % % بئس ما استكثرت من كسب يديك % 3(@)(@@) % بئس ما يسمع من تعظيمها % % ملكا القبر به من ملكيك % % 4(@)(@@) % أي خطب فادح في رقدة % يوقظ الحشر إليها مقلتيك % % 5(@)(@@) % وصراط لست بالناجي إذا % % وطئته زلة من قدميك % 6(@)(@@) % فلك الويل من النار إذا % % مقلة الرحمن لم تنظر إليك % PageV01P475 البحر : طويل 1(@)(@@) % لك الملك والسيف الذي مهد الملكا % % وصال به الإسلام فاهتضم الشركا % % 2(@)(@@) % تقيك آباء ملوكا كأنما % % يفتق للأسماع فخرهم مسكا % % 3(@)(@@) % وكل عريق في الشجاعة مقدم 
ms133	 % له الضربة الفرغاء والطعنة السلكى % % 4(@)(@@) % إذا ما رمى أرض العدى بعرمرم % عليه سماء النقع غادرها دكا % % 5(@)(@@) % ومن عرض الجبن المنوط بغمرهم % صفا جوهر منهم بنار الوغى سبكا % % 6(@)(@@) % بنيت بهدم المال كعبة ماجد % إلى حجها نزجي القلائص والفلكا % % 7(@)(@@) % فيا ابن تميم ذا الفخار الذي له % % منار ترى فوق السماك له سمكا % % 8(@)(@@) % تحدثنا عنه العلى وبمثل ما % % تحدثنا عنه ، تحدثنا عنكا % % 9(@)(@@) % تناولت إصلاح الزمان فقل لنا % % أعدل يسوس الملك أم ملك منكا % % 10(@)(@@) % فجددت ما أبلى ، وأثبت ما نفى % % وأدنيت من أقصى ، وأضحكت من أبكى % % PageV01P476 البحر : بسيط تام 1(@)(@@) % إن الليالي والأيام يدركها % % شيب ويعقبها من بعده هلك % 2(@)(@@) % فشيب ليلك من إصباحه يقق % وشيب يومك من إمسائه حلك % 3(@)(@@) % والعيش والموت بين الخلق في شغل % حتى يسكن من تحريكه الفلك % % 4(@)(@@) % ويبعث الله من جوف الثرى أمما % كانت عظامهم تبلى وتنتهك % % 5(@)(@@) % في موقف ما لخلق عنه من حول % ولا يحقر فيه سوقة ملك % PageV01P477 البحر : مجزوء الرجز 1(@)(@@) % بيتك فيه مصرعك % وفي الضريح مضجعك % 2(@)(@@) % عرتك دنياك التي % % لها شراب يخدعك % 3(@)(@@) % همت بجب فارك % وقلما تمتعك % 4(@)(@@) % يضرك الحرص بها % % والزهد فيها ينفعك % 5(@)(@@) % لا تأمنن منية % إن عصاها تقرعك % 6(@)(@@) % مغربك القبر الذي % % يكون منه مطلعك % 7(@)(@@) % إن فرقتك تربة % فالله سوف يجمعك % 8(@)(@@) % وللحساب موقف % أهواله تروعك % % 9(@)(@@) % كم جر ما أشفقت من % لمسك منه إصبعك % 10(@)(@@) % فكيف بالنار التي % % من كل وجه تلذعك % PageV01P478 11(@)(@@) % يراك ذو العرش إذا % % ناديته ويسمعك % % 12(@)(@@) % فثق به ولا يكن % لغيره تضرعك % % PageV01P479 البحر : وافر تام 1(@)(@@) % أليس بنو الزمان بنو أبيكا % % فجرد عن حقائقك الشكوكا % % 2(@)(@@) % ولا تسأل من المملوك شيئا % فترجع خائبا وسل المليكا % % 3(@)(@@) % فلست تنال رزقا لم تنله % ولو أبصرته مما يليكا % % 4(@)(@@) % فكم خير به نضيجا % وكنت حرمت رؤيته فريكا % % PageV01P480 البحر : خفيف تام 1(@)(@@) % لي صديق محض النصيحة كالمر % % آة إذ لا تريك منها اختلالا % % 2(@)(@@) % فتريك اليمين منك يمينا % بالمحاذاة والشمال 
ms134	 شمالا % % PageV01P481 البحر : طويل 1(@)(@@) % وساحبة ليلا من الشعر الجثل % لها مثل في الحسن جل عن المثل % 2(@)(@@) % تمج فتيت المسك منه أساود % معقربة أذنابهن على النعل % % 3(@)(@@) % تدير الهوى من مقلة بابلية % % لها نجل يغني الجفون عن الكحل % % 4(@)(@@) % وتمكث بين اللحظ واللفظ فتنة % تحل عقالا لتصابي عن العقل % % 5(@)(@@) % وما روضة يهدي النسيم أريجها % % محا عن ثراها القطر سيئة المحل % % 6(@)(@@) % بأطيب من فيها محادثة إذا % % حلا النوم عند الفجر في الأعين النجل % % PageV01P482 البحر : بسيط تام 1(@)(@@) % عول على العزم إن العزم منقطع % عنه الخمول ، وموصول به الأمل % 2(@)(@@) % لو لم تسل سيوف الهند ما ضربت % يوم القراع بها الأجياد والقلل % PageV01P483 البحر : طويل 1(@)(@@) % وغيداء لا ترضى بلثمي خدها % % إذا لم ألاطف عزها بتذلل % 2(@)(@@) % لها حمرة الياقوت في خد مخجل % وقسوته منها بقلب مدلل % 3(@)(@@) % كأني أرى هاروت منها مصورا % % على صورتي في كل طرف مكحل % % PageV01P484 البحر : طويل 1(@)(@@) % وذات دلال لا يزال مسلطا % لها خلق وعر على خلقي السهل % 2(@)(@@) % لها بقضيب البان نهض يزينها % % معين . ونهض خاذل بنقا الرمل % % 3(@)(@@) % إذا ما تمادت في الصدود ولم تمل % إلى الوصل إشفاقا تماديت في الوصل % % 4(@)(@@) % وقلت لعل الهجر يعقب عطفة % فيا رب خصب جاء في عقب المحل % % 5(@)(@@) % أمن حرمت نومي ومن سفكت دمي % % ومن صرمت حبلي ومن حللت قتلي % % 6(@)(@@) % بمقلتك النجلاء عمدا قتلتني % % ولا قود في القتل بالأعين النجل % % PageV01P485 البحر : بسيط تام 1(@)(@@) % متى ينال لديكم ما يؤمله % متيم ذو تباريح تبلبله % 2(@)(@@) % ما ظن من قبل تعذيب الهوى أسد % أن التدلل من رئم يذلله % 3(@)(@@) % ولا درى أن سهم الخيف يقصده % حتى رأى ساحر الألحاظ يرسله % 4(@)(@@) % مضنى رماه بكرب كل ذي فرح % كأنما ناقل عنه ينقله % % 5(@)(@@) % فالطب يسقمه ، والماء يعطشه % والقرب يبعده ، والصون يبذله % PageV01P486 البحر : خفيف تام 1(@)(@@) % ذات لفظ تجني بسمعك منه % % زهرا في الرياض نداه طل % 2(@)(@@) % لا يمل الحديث منها معادا % كانتشاق الهواء ليس يمل % 3(@)(@@) % ينطوي جفنها على 
ms135	 سيف لحظ % تغمد المرهفات حين يسل % 4(@)(@@) % كل عتب سمعت منها ومني % % فهو منها دل ومني ذل % PageV01P487 البحر : طويل 1(@)(@@) % أجمل على بخل الغواني وإجمال % تفاءلت باسم لا يصح به الفال % 2(@)(@@) % وحليت نفسي بالأباطيل في الهوى % % ونفس تحلى بالأباطيل معطال % 3(@)(@@) % وكنت كصاد خال ريا بقفرة % وقد غيض فيها الماء واطرد الآل % 4(@)(@@) % أيشكو بحر الشوق منك الصدى فم % وماء المآقي فوق خدك هطال % % 5(@)(@@) % وتغرس منك العين في القلب فتنة % ووجد جناها بالضمير وبلبال % 6(@)(@@) % ولا بد من أمنية تخدع الهوى % % لتدرك منها بالتعلل آمال % % 7(@)(@@) % فمثل لعينيك الكرى فعسى الكرى % % يزورك فيه من حبيبك تمثال % % 8(@)(@@) % وسل أرج الريح القبول لعله % لمعرضة عطف عليك وإقبال % % 9(@)(@@) % وإن لم تفز فوز المحبين بالهوى % % فقد نلت من برح الصبابة ما نالوا % % 10(@)(@@) % وليل حكى للناظرين ظلامه % ظليما له من روعة الصبح إجفال % % PageV01P488 11(@)(@@) % كأن له ثوبا على الأفق جيبه % % وقد سحبت منه على الأرض أذيال % % 12(@)(@@) % عجبت لطود من دجاه تهيله % % لطائف أنفاس الصباح فينهال % % 13(@)(@@) % وقد نشرت في جانبيه لي النوى % % قفارا طواها بي طمر وشملال % % 14(@)(@@) % ودون مصونات المها بذل أنفس % % تريك ولوع البيض فيهن أبطال % % 15(@)(@@) % وفي مضمر الظلماء كالىء ظبية % بثعلبة يسقى بها الموت رئبال % % 16(@)(@@) % فصيح بأسماء الكماة مبارزا % % لتعمل فيها بالمهند أفعال % % 17(@)(@@) % فيا بعد قرب لم يبت فيه نافعا % بسيرك بالبزل الرواسم إيغال % % 18(@)(@@) % سقام جفون ما لها من إبلال % % لدى الغيد غرثانان : قلب وخلخال % % 19(@)(@@) % فتاة تداوي كل حين بصحتي % % سقام جفون ما لها منه إبلال % 20(@)(@@) % منعمة سكرى بصهباء ريقة % لها في اللمى طعم ، وفي الخد جريال % % PageV01P489 21(@)(@@) % نظرت إليها نظرة عرفت بها % % إشارة لحظ ، بالصبابة ، عذال % 22(@)(@@) % فقالوا : لأدمى خدها وحي طرفه % فقلت : لعمري فتح الورد إخجال % 23(@)(@@) % فلجوا وقالو : جنة كذبت بها % % ظنون ظنناها ، ويا صدق ما قالوا % % 24(@)(@@) % أبنت كريم الحي هل من كرامة % ترفع مخفوضا به عندك الحال % 25(@)(@@) % نهضت إلى هجر الوصال نشيطة % وأنت أناة 
ms136	 في النواعم مكسال % % 26(@)(@@) % أرى العين من عينيك جانسن خلقه % % فمن أجلها حوليك ترتع آجال % % 27(@)(@@) % فما لك عنا تنفرين نفارها % % أفي الخلق منا عند شكلك إشكال % % 28(@)(@@) % متى نتلقى منك إنجاز موعد % وفعلك ذو بخل وقولك مفضال % 29(@)(@@) % وفيك على الرواض إدلال صعبة % ينال بها عز امرىء القيس إذلال % % 30(@)(@@) % ويقسم للتقبيل فوك مصدقا % بأن التي تحوي القسيمة متفال % PageV01P490 31(@)(@@) % ولو سل روحي من عروقي لرده % إلي رضاب من ثناياك سلسال % % 32(@)(@@) % أرى الوقف أضحى منك في الزند ثابتا % ولكن وشاح منك في الخصر جوال % % 33(@)(@@) % وأنت مكذب الماء يحيي وربما % % غدا شرق من شربه وهو قتال % % 34(@)(@@) % أيؤمن منك الحتف والكيد في الهوى % % وطرفك مغتال وعطفك مختال % % 35(@)(@@) % حبيس عليك العجب إذ ما لبسته % % من الحسن نعلا عند غيرك سربال % % 36(@)(@@) % ولابسة ظلي دجاها وأيكها % % وللسجع منها في القلائد إعمال % % 37(@)(@@) % تكفل في الوادي لها بنعيمها % % رياض كوشي العبقري وأوشال % 38(@)(@@) % شدت فانثنى رقصا بكل سميعة % من الطير مهتز من القضب ميال % 39(@)(@@) % فهل علماء في الشوادي مصيخة % إليهن خرس بالترنم جهال % % 40(@)(@@) % فورقاء لم تأرق بحزن جفونها % % وبلبلة لم يدر منها الأسى بال % PageV01P491 41(@)(@@) % وأذكرتني عصر الشباب الذي مضى % % لبردي فيه بالتنعم إسبال % 42(@)(@@) % ونضرة عيش كان عمي جامدا % به حيث تبري في الزجاجة سيال % % 43(@)(@@) % ودار غدونا عن حماها ولم نرح % ونحن إليها بالعزائم قفال % % 44(@)(@@) % بها كنت طفلا في ترعرع شرتي % % ألاعب أيام الصبا وهي أطفال % % 45(@)(@@) % كستني الخطوب السود بيض ذوائب % % ففي خلتي منها لدى البيض إخلال % % 46(@)(@@) % أبعد أنيسات الهوى أقطع الفلا % % ويسنح لي من وحشها الجأب والرال % 47(@)(@@) % ومن بعد ورد في مقيلي وسوسن % أقيل ومشمومي بها الطلح والضال % % 48(@)(@@) % أحالف كور الحرف من كل مهمه % توارد فيه الماء أطلس عسال % % 49(@)(@@) % له في حجاج العين نارية ، لها % % إذا طفئت نارية الشمس ، إشعال % % 50(@)(@@) % ويهديه هاد من دلالة معطس % إلى ما عليه من ظلام الفلا خال % % PageV01P492 51(@)(@@) % إذا جاء في جنح الدجى 
ms137	 نحو غيله % % تصدى له في القوس أسمر مغتال % 52(@)(@@) % تطير مع الفولاذ والعود نحوه % % من الموت في الريش الخفائف أثقال % % 53(@)(@@) % ولي عزمة لا يطبع القين مثلها % % ولو أنه في الغمد للهام فصال % % 54(@)(@@) % وحزم يبيت العجز عنه بمعزل % ورأي به اللبس يرفع إشكال % % 55(@)(@@) % أصير أخفاف النجيب مفاتحا % لهم عليه للتنائف أقفال % % 56(@)(@@) % واركب إذ لا أرض إلا غطامط % مطية ماء سبحها فيه إرقال % % 57(@)(@@) % حمامة أيك ما لها فوق غصنها % % غناء له عند المعري إعوال % % 58(@)(@@) % وأقسم ما هومت إلا وزارني % % على بعده الوادي الذي عنده الآل % % 59(@)(@@) % بأرض نبات العز فيها فوارس % تصول المنايا في الحروب إذا صالوا % % 60(@)(@@) % تظللهم ، والروع يشوي أواره ، % ذوابل فيها للأسنة ذبال % % PageV01P493 61(@)(@@) % إذا أطفأ الدجن الكواكب أسرجوا % % وجوها بها تهدى المسالك ضلال % 62(@)(@@) % فمن كل قرم في الندي هديره % إذا ما احتبى قيل من المجد أو قال % % 63(@)(@@) % شجاع يصيد القرن حتى كأنه % إذا ما كساه الرمح أحقب ذيال % 64(@)(@@) % وموسومة بالبيض والسمر هلهلت % عليهن من نسج العجاجات أجلال % 65(@)(@@) % فقرحها يوم الوغى ومهارها % % فوارسها منهم ليوث وأشبال % 66(@)(@@) % ألا حبذا تلك الديار أواهلا % ويا حبذا منها رسوم وأطلال % 67(@)(@@) % ويا حبذا منها تنسم نفحة % تؤديه أسحار إلينا وآصال % 68(@)(@@) % ويا حبذا الأحياء منهم وحبذا % % مفاصل منهم في القبور وأوصال % % 69(@)(@@) % ويا حبذا ما بينهم طول نومة % تنبهني منها إلى الحشر أهوال % PageV01P494 البحر : منسرح 1(@)(@@) % ما صد عني بوجهه ولها % إلا لأزداد في الهوى ولها % % 2(@)(@@) % رئم إذا ماتعززت أسد % عاجلها دله فذللها % % 3(@)(@@) % راش بسحر سهام مقلتيه % % وبالحمام المريج نصلها % % 4(@)(@@) % كأنما جنة بوجنته % % وبالعذار يكون جدولها % % 5(@)(@@) % كأنما قد هدب مقلته % صونا لها ظله فظللها % % 6(@)(@@) % كأنما انساب من ذوائبه % % سود أفاع علي أرسلها % % 7(@)(@@) % أو دب بالحسن فوق عارضه % نمل أصاب المداد أرجلها % % PageV01P495 البحر : طويل 1(@)(@@) % وليل كأني أجتلي من نجومه % حريق ذبال أو بريق نصال % % 2(@)(@@) % أشيم الثريا فيه طالعة كما % % ثنيت نظاما فيه سبع لآل % % PageV01P496 البحر 
ms138	 : طويل 1(@)(@@) % وناطقة بالراء سجعا مرددا % كحسن خرير من تكسر جدول % 2(@)(@@) % مغردة في القضب تحسب جيدها % % مقلد طوق بالجمان المفصل % % 3(@)(@@) % إذا ما امحى كحل الدجى من جفونها % % دعتك إلى كأس الغزال المكحل % % 4(@)(@@) % ملأت لها كف الصبوح زجاجة % مذهبة بالراح فضة أنمل % % 5(@)(@@) % كأن بياض الصبح حجة مؤمن % علت من سواد الليل حجة مبطل % % 6(@)(@@) % كأن شعاع الشمس في الأفق إذا جلت % به صدأ الإظلام مدوس صيقل % 7(@)(@@) % أدم لذة ما متعتك بساعة % وما دمت عن عرق بغير ترحل % 8(@)(@@) % فما عيشة الانسان صفو جميعها % % ولا آخر من عمره ند أول % PageV01P497 البحر : متقارب تام 1(@)(@@) % وباكية بعيون الجراح % إذا ضحكت عن ثغور الأسل % 2(@)(@@) % لبست الغمام لها نثرة % وجردت بارقها المشتعل % % 3(@)(@@) % قددت بها الدرع فوق الكمي % كما شق متن غدير غلل % % 4(@)(@@) % بأدهم يسقط من ذمره % على عمر كل شجاع أجل % % 5(@)(@@) % يطير به حافر ، رثه % شأى البرق في خطفة عن عجل % % 6(@)(@@) % فمبيض عضبي بمسوده % % وأحمره بنجيع القلل % 7(@)(@@) % ولو غمست فيه زرق العيون % % لعوض من زرق بالكحل % % 8(@)(@@) % ولي عزمة لم تبع في السرى % % نشاط السهاد بنوم الكسل % 9(@)(@@) % إذا ما قذفت ظلاما بها % % تفرت جوانبه عن شعل % 10(@)(@@) % ويفتك بالمال للمعتفين % عطاء يميني فتك البطل % PageV01P498 11(@)(@@) % وأسبق صوب الحيا بالندى % % بكفي جواد ، وخدي خجل % 12(@)(@@) % إذا شمل القول حسن البديع % % فأين المروي من المرتجل ؟ % PageV01P499 البحر : كامل أحذ 1(@)(@@) % ويلي على مملوكة ملكت % رقي بحسن مقالها ، ويلي % % 2(@)(@@) % غيداء تسحب كلما انعطفت % من فرعها ذيلا على الذيل % 3(@)(@@) % وكأنها شمس على غصن % مترنح التقويم والميل % % 4(@)(@@) % قالت ، وقد عانقتها سحرا ، % لم زرتنا في آخر الليل ؟ % 5(@)(@@) % فأجبتها ، وغمرتها قبلا : % هذا أوان إغارة الخيل % 6(@)(@@) % حتى إذا بزغت شبيهتها % % كالتاج فوق مفارق القيل % 7(@)(@@) % نزعت كنزع الروح من جسدي % % عني قلادة ساعد غيل % % 8(@)(@@) % فنهضت أشرق بالدموع كما % % شرق الفضاء بكثرة السيل % PageV01P500 البحر : مجزوء الرمل 1(@)(@@) % ملني من لا أمله % وأذاب القلب دله % 2(@)(@@) % رشأ ينفر 
ms139	 خوفا % كلما ماشاه ظله % % 3(@)(@@) % يا عليل الطرف ، جسمي % % نظرة منك تعله % % 4(@)(@@) % نيط في خصرك ردف % عجبي كيف تقله % 5(@)(@@) % يا غزالا حرم الل % % ه دمي ، وهو يحله % % 6(@)(@@) % إنما الحسن محل % لك أو أنت محله % 7(@)(@@) % بعضه في أوجه النا % % س وفي وجهك كله % % PageV01P501 البحر : طويل 1(@)(@@) % ننام من الأيام في غرض النبل % ونغذى بمر الصاب منها فنستحلي % % 2(@)(@@) % وقد فرغت للقوم في غفلاتهم % % حتوف بهم تمسي وتصبح في شغل % % 3(@)(@@) % أرى العالم العلوي يفنى جميعه % إذا خلت الدنيا من العالم السفلي % % 4(@)(@@) % ويبقى على ما كان من قبل خلقه % إله هدى أهل الضلالة بالرسل % % 5(@)(@@) % ويبعث من تحت التراب وفوقه % % نشورا ، إليه الفضل ، يا لك من فضل % % 6(@)(@@) % أرى الموت في عيني تخيل شخصه % ولي عمر في مثله يتقي مثلي % % 7(@)(@@) % وكادت يد منه تشد على يدي % % ورجل له بالقرب تمشي على رجلي % % 8(@)(@@) % وفي مد أنفاسي لدي وجزرها % % بقاء لنفس غير متصل الحبل % % 9(@)(@@) % ثمانون عاما عشتها ووجدتها % % تهدم ما تبني وتخفض من تعلي % % 10(@)(@@) % وإني لحي القول في الأمل الذي % % إذا رمته ألفيته ميت الفعل % % PageV01P502 11(@)(@@) % إذا الله لم يمنحك خيرا ، منعته % على ما تعانيه من الحذق والنبل % % 12(@)(@@) % فيا سائلي عن أهل ذا العصر دعهم % فبالفرع منهم يستدل على الأصل % 13(@)(@@) % إذا خلل في الحال منك وجدته % فإياك والتعويل منهم على خل % 14(@)(@@) % تأملت في عقلي وضعفي فقل إذا % % سئلت : رأيت الشيخ في عمر الطفل % % 15(@)(@@) % وهم لهه حمل على الهم ثقله % فيا ليته منه على كاهل الكهل % 16(@)(@@) % رجعت إلى ذكر الحمام فإنه % % له زمن ملآن بالغدر والختل % % 17(@)(@@) % وكم لقوة من قلة النيق حطها % % إلى حيث تفنيها الذبابة بالأكل % 18(@)(@@) % وقسورة أفضى إلى نزع روحه % % وشق إليها بين أنيابه العصل % % 19(@)(@@) % فما للردى من منهل لا نسيغه % ووارده يغنى عن العل بالنهل % % 20(@)(@@) % فيا غرسة للأجر كنت نقلتها % % إلى كنفي صوني وألحفتها ظلي % % PageV01P503 21(@)(@@) % وأنكحتها من بعد صدق حمدته % كريما فلم تذمم 
ms140	 معاشرة البعل % % 22(@)(@@) % أتاني نعي عنك أذكى جوى الأسى % % علي : اشتعال النار في الحطب الجزل % % 23(@)(@@) % وجاءك عني نعي حي فلم يجز % لك الكحل فيه ما لبست من الكحل % % 24(@)(@@) % على أن أسماع البلاد تسامعت % به وهو يجري بين ألسنة السبل % 25(@)(@@) % فنحت على حي أمات شبابه % زمان مشيب لا يجدد ما يبلي % % 26(@)(@@) % فمت بما شاء الإله ولم أمت % ليكتب عمري من حياتي الذي يملي % % 27(@)(@@) % وفارقت روحا كان منك انتزاعه % أدق دبيبا في الجسوم من النمل % 28(@)(@@) % أراني غريبا قد بكيت غريبة % كلانا مشوق للمواطن والأهل % % 29(@)(@@) % بكتني وظنت أنني مت قبلها % % فعشت وماتت - وهي محزونة - قبلي % % 30(@)(@@) % أقامت على موتي ، الذي قيل ، مأتما % وأبكت عيون الناس بالطل والوبل % PageV01P504 31(@)(@@) % وكل على مقدار حسرته بكى % % علي ولاقى ما اقتضاه من الشكل % % 32(@)(@@) % أساكنة القبر الذي ضم قطره % على البر منها والديانة والفضل % 33(@)(@@) % أصابك حزن من مصابي قاتل % فهل أجل لا قاك قد كان من أجلي ؟ % 34(@)(@@) % وخلفت في حجر الكآبة للبكا % % بنات لأم في مفارقة الشمل % 35(@)(@@) % يرين كأفراخ الحمامة صادها % % أبو ملحم في وكره كأبي الشبل % % 36(@)(@@) % بكتك قوافي الشعر من غزر أدمع % بكاء الحمام الورق في قضب الأثل % % 37(@)(@@) % وكل مهاة حول قبرك بالفلا % % لما بين عينيها وعينيك من شكل % % 38(@)(@@) % فروى ضريحا من كفاح عن الثرى % % له وابل بالخصب ما خط بالمحل % 39(@)(@@) % أيا رب إن الخلق لا أرتجيهم % فكل ضعيف لا يمر ولا يحلي % % 40(@)(@@) % بحلمك تعفو عن تعاظم زلتي % % وفضلك عن نقصي ، وحلمك عن جهلي % % PageV01P505 البحر : طويل 1(@)(@@) % بجمل حدا الغيران بزل جمائله % % وأرقص قامات القنا في قنايله % 2(@)(@@) % فلا عصفت ريح الفراق التي جرت % % بها في خضم الجيش سفن رواحله % % 3(@)(@@) % ودون مهاة الخدر إقدام خادر % مبيد الشذا أظفاره من معاقله % % 4(@)(@@) % حماليقه حمر كأن جفونها % % حشين بكحل من نجيع عوامله % 5(@)(@@) % يقلب أجفانا ورادا كأنما % % توارد يوم الطعن مشرع عامله % % 6(@)(@@) % وقالوا : قفوا كي تسمعوا عيسهم % % بعاجل ما يردي النفوس 