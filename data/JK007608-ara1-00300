ms281	 دون ثنية % % تجبز إلى بحبوحة المجد اطلعا % % 39(@)(@@) % تراه الثفال العود في حجراته % % وفي الروع الغلام السرعرعا % % 40(@)(@@) % فيا بانيا للعز ثلم ما بنى % % وباراعيا للمجد اهمل ما رعى % % PageV01P988 41(@)(@@) % فقدتك فقد الناظرين تخرما % % جميعا عن العينين ، واختلجا معا % % 42(@)(@@) % تهافت ثوب المجد بعدك عن بلى % % كانك لم ترقع من الأرض مرقعا % % 43(@)(@@) % لئن بز هذا الحي منك عماده % % فغير عجيب أن يعز ، ويمنعا % % 44(@)(@@) % فقد تسمع الأذنان أوعب صلمها % % ويدرك انف فغمة الطيب اجدعا % % 45(@)(@@) % وان يمض نصل من عقيل نجد له % % مناصل في ايدي الصيافل قطعا % % 46(@)(@@) % فما غيض ذاك الماء حتى علا الربى % % ولا اجتث ذاك الأصل حتى تفرعا % % 47(@)(@@) % وإن يختلسنا ذلك العضب حادث % فمن بعد ما ابقى الغماد المرصعا % % 48(@)(@@) % مجاور قوم أنزلوا دار غربة % إذا ظعنوا لا يظعنون المشيعا % % 49(@)(@@) % ولا يستجدون اللباس من البلى % % ولا يعمرون المنزل المتضعضعا % % 50(@)(@@) % بطيئون عن داعي اللقاء تخالهم % % إذا ما دعوا يوما مرمين ، هجعا % % PageV01P989 51(@)(@@) % حفائر ألقى الجود أفلاذ كبده % بهن وخط المجد فيهن مضجعا % % 52(@)(@@) % وحط بهن الرحل تدمى صفاحه % % كما افرد الحي الاجب الموقعا % % 53(@)(@@) % أجدك لا تلقى لذا المجد جامعا % ولا للمعالي الغر بعدك مجمعا % % 54(@)(@@) % وكان طريق الجود عندك مأمنا % فأذأب بالقوم اللئام وأسبعا % % 55(@)(@@) % أسيت على آل المسيب أنهم % بدور المعالي غاربات وطلعا % % 56(@)(@@) % تفروا تفري السجل دق اديمه % % ولما يدع فيه الخوارز مرقعا % % 57(@)(@@) % مضوا بعدما أبقوا إلى المجد منهجا % ركوبا باعلى غارب الأرض مهبعا % % 58(@)(@@) % اذا وضعوا فيه اجازوا إلى العلى % % وان سار فيه الناس ارذى واظلعا % % 59(@)(@@) % ولم يتركوا في نصل شنعاء مضربا % % ولم يدعوا في قوس علياء منزعا % % 60(@)(@@) % تغالتهم ايدي المنون علائقا % % من العز قد زايلن عادا وتبعا % % PageV01P990 61(@)(@@) % أخلاي ما أبقوا لعيني قرة % ولا زودوا إلا الحنين المرجعا % % 62(@)(@@) % وكانوا على الأيام ملهى ومطربا % فقد اصبحوا للقلب مبكى ومجزعا % % 63(@)(@@) % كأن عقارا بعدهم بابلية % تخال بها في الرأس نكباء زعزعا % % 64(@)(@@) % لها رقصات في الذوائب والشوى 
ms282	 % % ترد جبان القوم ندبا مشيعا % % 65(@)(@@) % شربت بها شرب الظمية صادفت % قرار عبابي من الماء مترعا % % 66(@)(@@) % سقاكم وما سقى السحائب غمرة % % من الجود أمرى من نداكم وأمرعا % % 67(@)(@@) % نشاص الثريا كلما هب بردته % % تذبذب يزجي عارضا مترفعا % % 68(@)(@@) % حدته من الغورين هوجاء كلما % % ونى عجرفت فيه فخب وأوضعا % % 69(@)(@@) % تلف به لف الحداة جمائلا % يزاد عن البيداء طردا مدفعا % % 70(@)(@@) % كأن بقعقاع الرعود عشية % % عشارا يراغين الجلال الجلنفعا % % PageV01P991 71(@)(@@) % كأن اليماني حاك في أخرياته % فأعرض أبراد الرباب وأوسعا % % 72(@)(@@) % إلى أن تفرى من جلابيبه الصبا % % كأن على الجرباء ريطا مقطعا % % 73(@)(@@) % فشق على ذاك التراب مزاده % % وخوى على تلك القبور وجعجعا % % 74(@)(@@) % فبعدا لطيب العيش بعد فراقكم % % فلا أسمع الداعي إليه ولا دعا % % 75(@)(@@) % ولا اسقا للدهر ان صد مؤيسا % % ولا مرحبا بالدهر إن عاد مطمعا % % 76(@)(@@) % وان عثر الاحياء من بعد موتكم % % فلا دعدعا للعاثرين ولا لعا % % PageV01P992 البحر : طويل 1(@)(@@) % عظيم الأسى في هذه غير مقنع % ولوم الردى فيما جنى غير منجع % % 2(@)(@@) % ولا عين إلا الدمع تجري غروبه % فلاق به المقدور إن شئت أو دع % 3(@)(@@) % فليس القنا فيما أصاب بشرع % وليس الظبا فيما الم بقطع % % 4(@)(@@) % ولا مانع مما رمى الله سهمه % % دفاع المحامي وادراع المدرع % 5(@)(@@) % وإن المنايا إن طرفن بفادح % فسيان لقيا حاسر أو مقنع % 6(@)(@@) % إذا انتصر المحزون كان انتصاره % % بدمع يزيد الوجد أو عض إصبع % 7(@)(@@) % وان غبين القوم من طاعن الردى % % إذا جاء في جيش الرزايا بأدمع % 8(@)(@@) % اترضى عن الدنيا وما زال بركها % % على مقصد منا وشلو مبضع % % 9(@)(@@) % اذا سمحت يوما بسجواء سجسج % % تلتها على عمد بنكباء زعزع % 10(@)(@@) % على كل حال من مصيف ومربع % جليد على طول المدى لم يروع % % PageV01P993 11(@)(@@) % وكم جف دمع فيك قد كان غربه % % بطيئا اذا ما ريم لم يتسرع % % 12(@)(@@) % توقع أمر زاد هما وقوعه % وإن وقوع الأمر دون التوقع % 13(@)(@@) % أيا جدثا وارى من العز هضبة % تمد إلى العليا ببوع واذرع % % 14 
ms283	(@)(@@) % سقاك ولولا ما تجن من التقى % % لقلت شآبيب القعار المشعشع % % 15(@)(@@) % وقل لقبر انت سر ضميره % % بكاء الغوادي كل يوم بأربع % 16(@)(@@) % وقفت عليه عاطفا فضل عبرة % % تفيض على فضل الحنين المرجع % 17(@)(@@) % أقول له ، والعين فيها زجاجة % من الدمع قدوارى بها الجول مدمعي % % 18(@)(@@) % وما هي إلا ساعة ، وهو لاحق % بعاد إلى يوم المعاد وتبع : % 19(@)(@@) % هل أنت مجيبي إن دعوت بأنة % وهل أنت غاد بعد طول مدى معي % % 20(@)(@@) % وهيهات حالت بيننا مستطيلة % % ضموم على الأجرام من كل مطلع % PageV01P994 21(@)(@@) % لنا كل يوم فرحة من مبشر % % بمقتبل أو رنة من مفجع % % 22(@)(@@) % وطاري رجاء في ملم مسلم % % وعارض يأس من خليط مودع % % 23(@)(@@) % وما بعد ما بيني وبينك سامعا % % وأنت بمرأى من مقامي ومسمع % 24(@)(@@) % لحا الله هذا الدهر ماذا جرت به % نوائبه من مؤلم الوقع مظلع % % 25(@)(@@) % لقد جب منا ذروة أي ذروة % فأبنا بأضلاع الأجب الموقع % % 26(@)(@@) % أليس عبيد الله خلى مكانه % % فلا عطس الاسلام الا باجدع % % 27(@)(@@) % تعز امير المؤمنين صريمة % % من العزم عن ماضي الصرائم أروع % 28(@)(@@) % لمينك لم يذخرك نصحا اذا حنا % % رجال على الغش القديم باضلع % % 29(@)(@@) % هو السابق الهادي إلى عقد بيعة % % رأى الناس فيها بين حسرى وظلع % % 30(@)(@@) % غرست به غرسا برى الدهر عوده % وكان متى تغرس على الرغم ينزع % % PageV01P995 31(@)(@@) % بقيت امين الله عودا لمفزع % % ومرعى لإخفاق ووردا لمطمع % 32(@)(@@) % اذا صفحت عنك الليالي واغريت % % بحفظك فيناهان كل مضيع % % 33(@)(@@) % فلا فجعت بالعز دارك ساعة % ولا غض من باب الرواق المرفع % % 34(@)(@@) % ولا برحت تلك الرباع مجودة % % على كل حال من مصيف ومريع % % 35(@)(@@) % لقد هاج هذا الرزء ريعان زفرة % تلقيتها عن قلب موجع % 36(@)(@@) % ولا سبب إلا المودة إنه % تقطع مني ، والقوى لم تقطع % 37(@)(@@) % وليس مقال حركته حفيظة % وعهد كقول القائل المتصنع % % PageV01P996 البحر : منسرح 1(@)(@@) % آب الرديني والحسام معا % وام يوب حامل الحسام معه % % 2(@)(@@) % ان الخفيف الحاذين جدله % % معير بالقعود والرتعه % 3(@)(@@) % غدا عليه من كان 
ms284	 خيفته % % برقا على الهون لازما ظلعه % 4(@)(@@) % لو أنصف الحي من ربيعته % % ما صاف محتله ولا ربعه % 5(@)(@@) % وانتزع الثار من مظنته % % معاجلا بالدم الذي انتزعه % % 6(@)(@@) % بالسمر تهتز في أسنتها % % والخيل تعدو العنيق والربعه % 7(@)(@@) % في جحفل قعقعت حوافزه % % قعاقع الرعد حاديا بأقزعه % % 8(@)(@@) % تملؤه عين رآه وتر % من الرعب اذن من سمعه % % 9(@)(@@) % كان سنانا يزين صعدتهم % % شل بذاك السنان من نزعه % % 10(@)(@@) % ومارنا لم يزل له ظبة % يجدع اعناق حي من جدعه % % PageV01P997 11(@)(@@) % يطلعه فوق كل مرقبة % % قلب جري وعزمة طلعه % % 12(@)(@@) % إذا جرى والحسود في صعد % مع للمعتفين أم ورعه ؟ % 13(@)(@@) % خلى غبار المدى له ومضى % % يطلب قوت العيون منقطعه % % 14(@)(@@) % ابكى نداه العريض أم بشره % % اللامع للمعفين أم ورعه % % 15(@)(@@) % ايها عقيل واي منقصة % % إيها عقيل الملوك وأي منقصة % 16(@)(@@) % صار طراد الملوك عادتكم % % بعد طراد البعوض والقمعه % 17(@)(@@) % ألام أني رثيت زافرة % كانوا نجوم الفخار أو لمعه % % 18(@)(@@) % إن لا تكن ذي الأصول تجمعنا % % يوما فان القلوب مجتمعه % % 19(@)(@@) % كم رحم بالعقوق نقطعها % % ورحم الود غير منقطعه % % 20(@)(@@) % لا تيأسوا من ثقوب زندهم % كانني بالزمان قد قرعه % % PageV01P998 21(@)(@@) % لا بد من ان يثوب حالهم % % لكل ضيق من الامور سعه % % PageV01P999 البحر : كامل تام 1(@)(@@) % يا يوسف ابن أبي سعيد دعوة % % اوحى اليك بها ضمير موجع % % 2(@)(@@) % إن الفجائع بالرجال كثيرة % ولقل من يرعى ومن يتفجع % 3(@)(@@) % لما رأيت الناس بعدك نكبوا % % سننن الحفاظ فغادر ومضيع % % 4(@)(@@) % قرطست في غرض الوفاء بقولة % % لأكون بعدك حافظا ما ضيعوا % % 5(@)(@@) % من كان اسرع عند امرك نهضة % % قد بات ، وهو إلى سلوك أسرع % 6(@)(@@) % كم من أخ لك لم يدم لك عهده % % قد كان منك بحيث تثنى الإصبع % 7(@)(@@) % لم ينسنا كافي الكفاة مصابه % حتى رمانا فيك خطب مظلع % 8(@)(@@) % قرف على قرح تقارب عهده % إن القروف على القروح لأوجع % 9(@)(@@) % وتلاحق الفضلاء اعضم شاهد % % ان الحمام بغير علق مولع % % 10(@)(@@) % واها له لو كان اسر يفتدى % % برغيبة أو 
ms285	 كان خرق يرقع % PageV01P1000 11(@)(@@) % في كل يوم للنعوش مشيع % منا يرف وراجع يسترجع % % 12(@)(@@) % كيف الغرور وللفناء ثنية % % ويد المنون تشير ثم المطلع % % 13(@)(@@) % ولرب أصغر عاقد عرنينه % أمسى له في الأرض خد أضرع % 14(@)(@@) % ما كنت ابخل ان اطيل لو انه % % يجدي المطيل إذا أطال وينفع % 15(@)(@@) % لكنه سيان من تجرى له % % عند الفجائع دمعة أو أدمع % PageV01P1001 البحر : بسيط تام 1(@)(@@) % قف موقف الشك لا يأس ولا طمع % وغالط العيش لا صبر ولا جزع % % 2(@)(@@) % وخادع القلب لا يود الغليل به % إن كان قلب على الماضين ينخدع % 3(@)(@@) % وكاذب النفس يمتد الرجاء لها % % إن الرجاء بصدق النفس ينقطع % 4(@)(@@) % سائل بصحبي أنى وجهة سلكوا % % عنا واي الثنايا بعدنا طلعوا % % 5(@)(@@) % حدا باظعانهم حتى استمر بها % % حادي المقادير لا يلوى بهم ظلع % % 6(@)(@@) % غابوا فغاب عن الدنيا وساكنها % % مرأ انيق عن الدنيا ومستمع % % 7(@)(@@) % بني أبي قد نكى فيكم بشكته % ونال ما شاء هذا الأزلم الجذع % 8(@)(@@) % كنتم نجوما لذي الدهماء زاهرة % % تضيء منها الليالي السود والدرع % % 9(@)(@@) % ان تخب انواركم من بعدما صدعت % % ثوب الدجا فلضوء الشمس منقطع % % 10(@)(@@) % في غرة المجد مذ غيبتم كلف % على الزمان وفي خد العلى ضرع % % PageV01P1002 11(@)(@@) % وبالمواضي حران في الوغى وباعناق % % ناق الضوامر مذ أرحلتم خضع % 12(@)(@@) % مصاعب ذعذعت ايدي المنور بها % % فطاع معتصم وانقاذ ممتنع % % 13(@)(@@) % لم يعدموا يوم حرب تحت قسطلها % % طير الرخام على لباتهم تقع % % 14(@)(@@) % لم ينزعوا البيض مذ لاثوا عمائمهم % إلا وقد غاض منها الشيب والنزع % 15(@)(@@) % نسابق الموت تطويحا بأنفسنا % % حتى كأنا على الآجال نقترع % 16(@)(@@) % ابكيهم ويد الايام دائبة % % تدوف لي فضلة الكأس التي جرعوا % % 17(@)(@@) % لا امتري انني مجر إلى امد % % جروا إليه قبيل اليوم أو نزعوا % % 18(@)(@@) % وأنني وارد العد الذي وردوا % % بالكره أو قارع الباب الذي قرعوا % % 19(@)(@@) % سدت فواغر افواه القبور بهم % % وليس للارض لا ري ولا شبع % % 20(@)(@@) % اعتادهم لا ارجى ان يعود لهم % % إلي ماض ، ولا لي فيهم طمع % PageV01P1003 21 
ms286	(@)(@@) % فما توهج احشاي على نفر % % كانوا عوادي للايام فارتجعوا % % 22(@)(@@) % نليح ان ترتعي الاقدار انفسنا % % وكلنا للمنايا السود مزدرع % 23(@)(@@) % نلهوا وما نحن الا للردى اكل % % 24(@)(@@) % كانوا حوامي جبال العز فانقرضوا % % وصدعوا قلل العليا مذ انصدعوا % % 25(@)(@@) % فوارس قوضوا عن سابقاتهم % % فاستنزلوا بطعان الدهر واقتلعوا % % 26(@)(@@) % قوم فكاهتهم ضرب الطلى ولهم % % تحت العجاج بأطراف القنا ولع % 27(@)(@@) % إما تؤود من الأيام نائبة % قاموا بها واطاقوا الحمل واضطلعوا % % 28(@)(@@) % لا تستلينهم الضراء نازلة % % 29(@)(@@) % كم خمصة كان فيها العز آونة % % وشيعة كان فيها العار والضرع % % 30(@)(@@) % من كل أغلب نظار على شوس % له لواء على العلياء متبع % % PageV01P1004 31(@)(@@) % يخفى به التاج من لألأ غرته % % على جبين بضوء المجد يلتمع % % 32(@)(@@) % ذو عزمة تلهم الدنيا وساكنها % % وهمة تسع الدنيا وما تسع % % 33(@)(@@) % يلقى الظبى حاسرا تبدو مقاتله % % ويرهب الذم يوما ، وهو مدرع % 34(@)(@@) % إن المصائب تنسي المرء مقبلة % قصد الطريق لما يسلي وما يزع % % 35(@)(@@) % حتى إذا انكشفت عنه غياطلها % % تبين المرؤ ما يأتي وما يدع % % 36(@)(@@) % أرسى النسيم بواديكم ولا برحت % حوامل المزن في اجداثكم تضع % % 37(@)(@@) % ولا يزال جنين النبت ترضعه % على قبوركم العراضة الهمع % % 38(@)(@@) % هل تعلمون على نأي الديار بكم % % أن الضمير إليكم شيق ولع ؟ % 39(@)(@@) % لكم على الدهر من اكبادنا شعل % % من الغليل ، ومن آماقنا دفع % 40(@)(@@) % لواعج افصحت عنها الدموع وقد % % كادت تجمجمها الأحشاء والضلع % PageV01P1005 41(@)(@@) % أنزفت دمعي حتى ما تركت له % غربا يفيض على رزء ، إذا يقع % 42(@)(@@) % ثم اضطررت إلى صبري فعدت به % % وأعرب الصبر لما أعجم الجزع % PageV01P1006 البحر : بسيط تام 1(@)(@@) % صبرت عنك فلم ألفظك من شبع % لكن ارى الصبر اولى بي من الجزع % % 2(@)(@@) % وان لي عادة في كل نازلة % % أن لا تذل لها عنقي من الضرع % 3(@)(@@) % لذاك شجعت قلبي وهو ذو كمد % % وملت بالدمع عني وهو ذو دوع % % 4(@)(@@) % ماض على وقعات الدهر إن طرقت % غدا بحمل اذاها جد مضطلع % % 5(@)(@@) % وحاسر يتلقى كل نائبة % % تدمى فيصرفيها صبر مدرع 
ms287	 % % 6(@)(@@) % لولا اندفاع دموع العين غالبة % % لم يعقب الصبر دمعا غير مندفع % 7(@)(@@) % في اليأس منك سلو عنك يضمره % وقبل يومك يقوى الحزن بالطمع % % 8(@)(@@) % ما كان ذيلك مسدولا على دنس % ولا نطاقك معقودا على طمع % % 9(@)(@@) % ما شئت من لين اخلاق ومكرمة % % ومن عفاف ومن فضل ومن ورع % 10(@)(@@) % لله نفرة وجد لست أملكها % % إذا تذكرت إخوان الصفاء معي % % PageV01P1007 11(@)(@@) % يواصل الحزن قلبي كلما فجعت % يدي بحبل من الأقران منقطع % 12(@)(@@) % ألقى الغمام حواياه على جدث % نزلت منه بملقى غير متسع % % 13(@)(@@) % في حيث لا طمع يوما لذي طمع % في ان يعود ولا رجعى لمرتجع % % 14(@)(@@) % لا عين تنظران ارسى بعقوتها % % زور ولا اذن عند النداء تعي % % 15(@)(@@) % وهون الوجدان الموت مشترك % % فينا وانا لذا الماضي من التبع % % 16(@)(@@) % هي الثنايا إلى الآجال نطلعها % % فمن حثيث ومن راق على ظلع % % 17(@)(@@) % كالشاء يعذل منا غير مكترث % % عيا ، ويوعظ منا غير مستمع % 18(@)(@@) % الآن يعلم أن العيش مختلس % واننا نقطع الايام بالخدع % % 19(@)(@@) % هيهات لا قارج يبقى ولا جذع % % على نوائب كر الأزلم الجذع % 20(@)(@@) % إن المنايا لشتى بين طارقة % هونا ، ونافرة عن هول مطلع % PageV01P1008 21(@)(@@) % اما فناء عن الدنيا على مهل % % أو اعتباطا يغادي غدوة السبع % 22(@)(@@) % ما لليالي يرنقن المجاجة من % شربي وبوبين مصطافي ومرتبعي % % 23(@)(@@) % عدت عوادي الردى بيني وبينكم % وانزلتك النوى عني بمنقطع % % 24(@)(@@) % وشتتت شملك الأيام ظالمة % فشمل دمعي ولبي غير مجتمع % 25(@)(@@) % أخي لا رغبت عيني ولا أذني % % من بعد يومك في مرأى ومستمع % 26(@)(@@) % ولا أراك بقلب غير مصطبر % إذا أهاب به السلوان لم يطع % PageV01P1009 البحر : طويل 1(@)(@@) % ذكرتك لما طبق الافق عارض % % وأعرض برق كالضرام لموع % 2(@)(@@) % وانت مقيم حيث لا البرق يجتلى % % بعين ، ولا روح النسيم يضوع % 3(@)(@@) % غريب عن الأوطان لا لك هبة % إليها ، ولا بعد المضي رجوع % 4(@)(@@) % خلا منك ربع قد تبدلت بعده % ربوع بلى ما مثلهن ربوع % % 5(@)(@@) % وعاود قلبي الذكر إذ نحن جيرة % زمانا وإذ شمل 
ms288	 الجميع جميع % 6(@)(@@) % واذ عيشنا الرقراق يسبغ خفضه % % علينا واذ طير النعيم وقوع % % 7(@)(@@) % إلى أن مشى بيني وبينكم الردى % % وقطع أقران الصفاء قطوع % 8(@)(@@) % وفي كل يوم صاحب استجده % % نيوب ردى في السمام نقيع % % 9(@)(@@) % سلام على تلك القبور ، وجادها % % باروى واسنى ما يجود ربيع % % 10(@)(@@) % فلا تغبطونا إذ أقمنا ، وأنتم % على ظعن ، إن اللقاء سريع % PageV01P1010 البحر : مخلع البسيط 1(@)(@@) % أأترك الغر من لداتي % % خوالي البيض والدروع % 2(@)(@@) % تحدو الليالي بهم رفاقا % ماضيهم معوز الرجوع % % 3(@)(@@) % تفرقوا لا عن اختيار % % وانتقلوا لا إلى ربوع % % 4(@)(@@) % رجعت في اثرهم برغمي % % بعد نزاع إلى نزوع % 5(@)(@@) % ابقى الجوى جرحة بقلبي % % ما عشت مكتومة النجيع % % 6(@)(@@) % كم غبن الموت عن كريم % وقارع الخطب عن قريع % 7(@)(@@) % بانوا فلم انتزح عليهم % % دمعي ولم استذب ضلوع % % 8(@)(@@) % واسفح الدمع للاعادي % % اني اذا فارغ الدموع % % PageV01P1011 البحر : - 1(@)(@@) % يا صاحب القلب الصحيح أما اشتفى % % ألم الجوى من قلبي المصدوع ؟ % 2(@)(@@) % أأسأت بالمشتاق حين ملكته % وجزيت فرط نزاعه بنزوع % 3(@)(@@) % هيهات لا تتكلفن لي الهوى % % فضح التطبع شيمة المطبوع % % 4(@)(@@) % كم قد نصبت لك الحبائل طمائعا % فنجوت بعد تعرض لوقوع % % 5(@)(@@) % وتركتني ظمآن أشرب غلتي % % اسفا على ذاك اللمى الممنوع % % 6(@)(@@) % قلبي وطرفي منك : هذا في حمى % % قيظ وهذا في رياض ربيع % % 7(@)(@@) % كم ليلة جرعته في طولها % % غصص الملام ومؤلم التقريع % % 8(@)(@@) % ابكي ويبسم والدجى ما بيننا % % حتى أضاء بثغره ودموعي % % 9(@)(@@) % تفلي أنامله التراب تعللا % وأناملي في سني المقروع % 10(@)(@@) % قمر اذا استخجلتهبعتابه % % لبس الغروب ، ولم يعد لطلوع % PageV01P1012 11(@)(@@) % لو حيث يستمع السرار وقفتما % % لعجبتما من عزه وخضوعي % % 12(@)(@@) % ابغي هواه بشافع من غيره % % شر الهوى ما نلته بشفيع % 13(@)(@@) % ما كان الا قبلة التسليم اردفها % % الفراق بضمة التوديع % % 14(@)(@@) % كمدي قديم في هواك وانما % % تاريخ وصلك كان مذ أسبوع % 15(@)(@@) % أهون عليك إذا امتلأت من الكرى % % اني ابيت بليلة الملسوع % % 16(@)(@@) % قد كنت اجزيك الصدود بمثله % % لو أن قلبك كان بين ضلوعي % % PageV01P1013 البحر : طويل 
ms289	 1(@)(@@) % أقول وما حنت بذي الأثل ناقتي : % قوي لا ينل منك الحنين الموجع % % 2(@)(@@) % تحنين الا ان بي لابك الهوى % % ولي لا لك الخليط المودع % % 3(@)(@@) % وباتت تشكى تحت رحلى ضمانة % % كلانا ، إذا ، يا ناق نضو مفجع % 4(@)(@@) % احست بنار في ضلوع فاصبحت % % يخب بها حر العرام ويوضع % 5(@)(@@) % اروح بفتيان خماص من الجوى % % لهم أنة في كل دار وأدمع % 6(@)(@@) % إذا غرد الركب الخفي تأوهوا % % لما وجدوا بعد النوى وتوجعوا % % 7(@)(@@) % على ابرق الحنان كان حنينا % % وبالجزع مبكى ان مررنا ومجزع % % 8(@)(@@) % تزافر صحبي يوم ذي الائل ذفرة % % تذوب قلوب من لظاها وأدمع % 9(@)(@@) % منازل لم تسلم عليهن مقلة % ولا جف بعد البين فيهن مدمع % % 10(@)(@@) % فدمع على بالي الديار مفرق % وقلب على أهل الديار موزع % PageV01P1014 11(@)(@@) % ارى اليأس حتى تعزم النفس سلوة % % ويرجع بي داعي الغرام ، فأطمع % 12(@)(@@) % ذكرت الحمى ذكر الطريد محله % يذاد مذاد العاطشات ويرجع % % 13(@)(@@) % واين الحمى لا الدار بالدار بعدهم % % ولا مربع بعد الحنين مربع % % 14(@)(@@) % سلام على الأطلال لا عن جناية % وان كن يأسا حين لم يبق مطمع % % 15(@)(@@) % نشدتكم هل زال من بعد أهله % % زرود ، ورامته طلول وأربع % 16(@)(@@) % وهل أنبت الوادي العقيقي بعدهم % % وبدل بالجيران شعب ولعلع % % 17(@)(@@) % فيا قلب ان يفن العزاء فطالما % % عهدتك بعد الظاعنين تصدع % 18(@)(@@) % وقد كان من قلبي إلى الصبر جانب % % فقلبي بعد اليوم للصبر اجمع % % 19(@)(@@) % نعم عادني عيد الغرام ونبهت % % علي الجوى دار بميثاء بلقع % 20(@)(@@) % وطارت بقلبي نفحة غضوية % ينفسها حال من الروض ممرع % % PageV01P1015 21(@)(@@) % أصد حياء للرفاق ، وإنما % % زمامي منقاد مع الشوق طيع % 22(@)(@@) % نظرت الكثيب الأيمن اليوم نظرة % ترد إلي الطرف يدمى ويدمع % 23(@)(@@) % ورب غزال داجن في كناسه % % على رقبة الواشين يعطي ويمنع % 24(@)(@@) % وأحسن في الود التقاضي إذا لوى % % ويبذل منزور النوال ، فأقنع % 25(@)(@@) % وايقظت للبرق اليماني صاحبا % % بذات النقا يخفى مرارا ويلمع % % 26(@)(@@) % تعرض نجديا ، وأذكى وميضه % عقيق الحمى منه معان وأجرع % 27(@)(@@) % أأنت معيني للغليل بنظرة % فنبكي 
ms290	 على تلك الليالي ونجزع % 28(@)(@@) % معاذ الهوى لو كنت مثلي في الهوى % % اذا لدعاك الشوق من حيث تسمع % % 29(@)(@@) % هناك الكرى ، إني من الوجد ساهر % وبرء الحشى ، إني من البين موجع % 30(@)(@@) % فلا لب لي الا تماسك ساعة % % ولا نوم لي إلا النعاس المروع % PageV01P1016 31(@)(@@) % تصامم عني لائثا فضل برده % % ولا يحفل الشوق النؤم المقنع % % 32(@)(@@) % طوتك الليالي من رفيق كانه % % من العجز يربوع الملا المتقصع % % 33(@)(@@) % ينام على هد الصفاة بلادة % ألا موطن يدنو بشمل ويجمع % 35(@)(@@) % الا سلوة تنهي الدموع فتنتهي % % الا مورد يروى الغليل فينقع % % 36(@)(@@) % فصبرا على قرع الزمان وغمزه % % وهل ينكر الحمل الذلول الموقع % % 37(@)(@@) % وهبت له ظهري على عقر غاربي % % فكل زمام قادني منه اتبع % % 38(@)(@@) % وكم ظهر صعب عاد بالذل يمتطى % % وعرنين آب بات بالضيم يقرع % % 39(@)(@@) % وقل لليالي حاملي ، أو تحاملي % % فلم يبق في قوس المقادير منزع % % PageV01P1017 البحر : طويل 1(@)(@@) % ألا يا غزال الرمل من بطن وجرة % إللواجد الظمآن منك شروع % 2(@)(@@) % خلا لك في الاحشاء مرعى تروده % % وصابك من ماء الدموع ربيع % 3(@)(@@) % ألا هل إلى ظل الأثيل تخلص % وهل لثنيات الغوير طلوع % % 4(@)(@@) % وهل بليت خيم على ايمن الحمى % % وزالت لنا بالابرقين ربوع % % 5(@)(@@) % وهل لليالينا الطوال تصرم % % وهل لليالينا القصار رجوع % % 6(@)(@@) % ولم أنس يوم الجزع حسنا خلسته % % بعيني ، على أن الزيال سريع % 7(@)(@@) % ولما توافقنا ذهلت ولم يحن % % لطير قلوب العاشقين وقوع % % 8(@)(@@) % على حين أعدت حيرتي قلب صاحبي % % فرحنا وسوط العامري مضيع % 9(@)(@@) % حديث يضل القلب عند استماعه % % فليس عجيبا أن يضل قطيع % 10(@)(@@) % عشية لي من رقبة الحي زاجر % % عن الدمع الأ ان تشذ دموع % % PageV01P1018 11(@)(@@) % وقد أمرت عيناك عيني بالبكا % % فقل لي اي الامرين اطيع % % PageV01P1019 البحر : طويل 1(@)(@@) % تشاهقن لما أن رأين بمفرقي % % بياضا كأن الشيب عندي من البدع % 2(@)(@@) % وقلن عهدنا فوق عاتق ذا الفتى % % رداء من الحوك الرقيق فما صنع % % 3(@)(@@) % ولم أر عضبا عيب منه صقاله % وكان حبيبا للقلوب على الطبع % % 4 
ms291	(@)(@@) % وقالوال غلام زين الشيب رأسه % % فبعدا لرأس زانه الشيب والنزع % 5(@)(@@) % تسلى الغواني عنه من بعد صبوة % وما أبعد النبت الهشيم من النجع % 6(@)(@@) % وكن يخرقن السجوف اذا بدا % % فصرن يرقعن الخروق اذا طلع % % PageV01P1020 البحر : خفيف تام 1(@)(@@) % عارضا بي ركب الحجاز من سكن أسائله % % متى عهده بسكان سلع % % 2(@)(@@) % واستملا حديث من سكن الخفيف % % ولا تكتباه الا بدمعي % % 3(@)(@@) % فاتني ان ارى الديار بطرفي % % فلعلي أرى الديار بسمعي % % 4(@)(@@) % يا غزالا بين النقا والمصلي % % ليس تبقى على نبالك درعي % % 5(@)(@@) % كلما سل من فؤادي سهم % عاد سهم لكم مضيض الوقع % 6(@)(@@) % وتحرجت يوم حراما % % من عطائي ، فمن أباحك منعي % % 7(@)(@@) % من معيد أيام سلع على ما % % ما كان منها واين ايام سلع % % 8(@)(@@) % طالب بالعراق ينشد هيهات % % ت ، زمانا أضله بالجزع % PageV01P1021 البحر : طويل 1(@)(@@) % وقفت بربع العامرية وقفة % % فعز اشتياقي ، والطلول خواضع % 2(@)(@@) % وكم ليلة بتنا على غير ريبة % علينا عيون للنهى ومسامع % 3(@)(@@) % نفض حديثا عن ختام مودة % معاقلها أحشاؤنا والأضالع % 4(@)(@@) % يكاد غراب الليل عند حديثنا % % يطير ارتياحا وهو في واقع % % 5(@)(@@) % خلونا فكانت عفة لا تعفف % % وقد رفعت في الحي عنا الموانع % 6(@)(@@) % سلوا مضجعي عني وعنها فاننا % % رضينا بما يخبرن عنا المضاجع % % PageV01P1022 البحر : طويل 1(@)(@@) % لقلبي بغوري البلاد لبابة % % وان كنت مسدودا علي المطالع % % 2(@)(@@) % لعلي أعطى ، والأماني ضلة % وإن الليالي معطيات موانع % 3(@)(@@) % مبيتي في أثواب ظمياء ، ليلة % بوادي الغضا والعاذلون هواجع % 4(@)(@@) % وما نطفة مشمولة بمنجمة % % وعاها صفا من آمن الطود فارع % % 5(@)(@@) % من البيض لولا بردها قلت : دمعة % مرنقة ما اسلمتها المدامع % % 6(@)(@@) % يا عذب مما نولتنيه موهنا % وقد شيم بالغور النجوم الطوالع % 7(@)(@@) % ارى بعد ورد الماء في القلب غلة % % اليك على اني من الماء ناقع % % 8(@)(@@) % واني لا قوى ما اكون طماعة % % اذا كذبت فيك المنى والمطامع % % PageV01P1023 البحر : طويل 1(@)(@@) % تجمجم بالأشعار كل قبيلة % وفي القول محفوظ عليها وضائع % % 2(@)(@@) % وكل فتى بالشعر تجلو همومه % ويكتب ما تملي عليه المطامع 
ms292	 % 3(@)(@@) % وشعري تختص القلوب بحفظه % % وتخظى به دون العيون المسامع % 4(@)(@@) % واولى به من كان مثلك حازما % يذبب عن اطرافه ويقارع % % 5(@)(@@) % ستظفر من نظمي بكل قصيدة % كما حلت الليل النجوم الطوالع % 6(@)(@@) % تضيء قوافيها وراء بيوتها % % طراقا ، كما يتلو النصول القبائع % 7(@)(@@) % اذا هزها السمار طار لها الكرى % % وهزت جنوب النائمين المضاجع % 8(@)(@@) % وغيرك يعمى عن معان مضيئة % كما تقبض اللحظا لبروق اللوامع % % 9(@)(@@) % وما كل ممدوح يلذ بمدحه % ألا بعض أطواق الرقاب جوامع % PageV01P1024 البحر : طويل 1(@)(@@) % وعاري الشوى والمنكبين من الطوى % % اتيح له باليل عادي الا شاجع % % 2(@)(@@) % أغيبر مقطوع من الليل ثوبه % انيس باطراف البلاد البلانع % % 3(@)(@@) % قليل نعاس العين إلا غيابة % تمر بعيني جاثم القلب جائع % 4(@)(@@) % اذا جن ليل طارد النوم طرفه % % ونص هدى االحاظه بالمطامع % % 5(@)(@@) % يراوح بين الناظرين إذا التقت % على النوم أطباق العيون الهواجع % 6(@)(@@) % له خطفة حذاء من كل ثلة % كنشطة أقنى ينفض الطل واقع % 7(@)(@@) % الم وقد كاد الظلام تقضيا % % يشرد فراط النجوم بالطوالع % 8(@)(@@) % طوى نفسه وانساب في شملة الدجى % % وكل امرء ينقاد طوع المطامع % % 9(@)(@@) % إذا فات شيء سمعه دل أنفه % وان فات عينيه رأى بالمسامع % % 10(@)(@@) % تظالع حتى حك بالأرض زوره % وراغ ، وقد روعته ، غير ظالع % PageV01P1025 11(@)(@@) % يخادعه مستهزئا بلحاظه % تداركها مستنجدا بالأكارع % 12(@)(@@) % جري يسوم النفس كل عظيمة % وبمضى اذا لم يمض من لم يدافع % % 13(@)(@@) % اذا حافظ الراعي على الضان غره % % 14(@)(@@) % % خداع ابن ظلماء كثير الرقائع % % 15(@)(@@) % ولما عوى والرمل بيني وبينه % % تيقن صحبي انه غير راجع % % 16(@)(@@) % تأوب ، والظلماء تضرب وجهه % إلينا ، بأذيال الرياح الزعازع % 17(@)(@@) % له الويل من مستطعم عاد طعمه % % لقوم عجال بالقسي النوازع % % PageV01P1026 البحر : طويل 1(@)(@@) % ولا قرن الا دامع الطعن نحره % % وما غسلته بالدموع مدامعه % % 2(@)(@@) % ويوم كان السمهري عيونه % % إلى الموت ، والنقع المثار براقعه % 3(@)(@@) % يخرق منه كل جلباب مهجة % % على انه في منظر العين راقعه % % PageV01P1027 البحر : طويل 1(@)(@@) % وليل كجلجاب الشباب رقعته % % بصبح كجلباب المشيب طلائعه % 2 
ms293	(@)(@@) % كان سماء اليوم ماء اثاره % % من الليل سيل فالنجوم فواقعه % % PageV01P1028 البحر : كامل تام 1(@)(@@) % ومروع لي بالسلام كانما % % تسليمه فيما يمض وداع % 2(@)(@@) % تغفى بمنظره العيون كانما % % وتقيئ عند غنائه الاسماع % % 3(@)(@@) % ابذاك نستشفى ومن نغماته % % تتولد الالام والاوجاع % % 4(@)(@@) % أم كيف يطربنا غناء مشوه % أبدا نهال بوجهه ونراع % 5(@)(@@) % نزوي الوجوه تفاديا من صوته % % حتى كان سماعه إسماع % % 6(@)(@@) % وكأن ضرب بنانه ضرب الطلى % % وكانما ايقاعه ايقاع % % 7(@)(@@) % اشهى الينا من غنائك مسمعا % % زجل الضراغم بينهن قراع % PageV01P1029 البحر : طويل 1(@)(@@) % اروم انتصافي من رجال اباعد % % ونفسي أعدى لي من الناس أجمعا % % 2(@)(@@) % اذا لم تكن نفس لفتى من صديقه % % فلا يحدثن في خلة الغير مطمعا % % PageV01P1030 البحر : طويل 1(@)(@@) % سيسكتني يأسي وفي الصدر حاجة % % كما أنطقتني والرجال المطامع % 2(@)(@@) % بضائع قول عند غيري ربحها % % وعندي خسراناتها والوضائع % 3(@)(@@) % غرائب لو هدت على الطود ذي الصفا % % اصاخ اليها يذبل والقعاقع % % 4(@)(@@) % تضاع كما ضاعت خلاة بقفرة % زفتها النعامى والرياح الزعازع % 5(@)(@@) % كان لساني نسعة حضرمية % % طواها ، ولم تبلغ لها السوم ، بائع % 6(@)(@@) % لقد كان لي عن باحة الذل مذهب % ومضطرب عن جانب الضيم واسع % % 7(@)(@@) % وما مد ما بيني وبين مذاهبي % % حجاز ولا سدت علي المطالع % % 8(@)(@@) % اكن ثناي وابن فعلاء معرض % % لئن انت لم تسمع فعرضك سامع % % 9(@)(@@) % ولو ما جزيت القرض بالعرض لم يضع % % فان الندى عند الكرام ودائع % % 10(@)(@@) % سيدرى من المغبون منا ومنكم % اذا افترقت عما تقول المجامع % % PageV01P1031 11(@)(@@) % وهل تدعي حفظ المكارم عصبة % % لئام ، ومثلي بينها اليوم ضائع % 12(@)(@@) % نعم لستم الأيدي الطوال فعاونوا % % على قدركم ، قد تستعان الأصابع % 13(@)(@@) % ارى بارقا لم يروني وهو حاضر % % فكيف أرجي ربه ، وهو شاسع % 13(@)(@@) % إذا لم يكن وصلي إليكم ذريعة % فيا ليت شعري ما تكون الذرائع % 14(@)(@@) % واخلف شيمي كل برق اشيمه % % فلا النؤ مرجو ولا الغيث واقع % % 15(@)(@@) % سأذهب عنكم غير باك عليكم % وما لي عذر أن تفيض المدامع % 16(@)(@@) % وأهجركم هجر المفيق من الهوى % % خلا القلب 
ms294	 منه واطمأن المضاجع % 17(@)(@@) % وأعتد فجا أنتم من حلاله % ثنية خوف ، ما لها اليوم طالع % 18(@)(@@) % وما موقفي والركب يرجو على الصدى % % موارد قد نشت بهن الوقائع % 19(@)(@@) % افارقكم لا النفس ولهى عليكم % % ولا اللب مخلوس ولا القلب جازع % PageV01P1032 20(@)(@@) % ولا عاظفا جيدي اليكم بلفتة % % من الشوق ما سار النجوم الطوالع % % 21(@)(@@) % ولا ذاكرا ما كان بيني وبينكم % % مراجعة ان المحب المراجع % % 22(@)(@@) % نبذتكم نبذ المخفف ثقله % واني لحبل منة الغدر قاطع % % PageV01P1033 البحر : بسيط تام 1(@)(@@) % ما اخطاتك سهام الدهر رامية % % فما أبالي من الدنيا بمن تقع % 2(@)(@@) % الناس خولك غربان على جيف % بله عن المجد إن طاروا وإن وقعوا % % 3(@)(@@) % فما لنا فيهم ان اقبلوا طمع % % ولا عليهم اذا ما ادبروا جزع % % PageV01P1034 البحر : طويل 1(@)(@@) % يقولون ماش الدهر من حيث مامشى % % فكيف بماش يستقيم واظلع % % 2(@)(@@) % وما واثق بالدهر الا كراقد % % على فضل ثوب الظل والظل يسرع % 3(@)(@@) % وقالوا : تعلل ! إنما العيش نومة % يقضى ويمضى طارق الهم اجمع % % 4(@)(@@) % ولو كان نوما ساكنا لحمدته % % ولكنه نوم مروع مفزع % PageV01P1035 البحر : كامل تام 1(@)(@@) % ولرب يوم هاج من طربي % % ولقد يضيق بغيره ذرعي % % 2(@)(@@) % من منظر حسن ومن نغم % % ندعوه قيد العين والسمع % 3(@)(@@) % لما أظل الليل مجلسنا % % طعن الدجى بأسنة الشمع % PageV01P1036 البحر : كامل تام 1(@)(@@) % خلطوا الصوارم بالقنا ، وتعمموا % % بالبيض ، واجتابوا العجاج دروعا % % 2(@)(@@) % قوم إذا هتف الصريخ بنصرهم % فجروا عليه من الظبة ينبوعا % % PageV01P1037 البحر : كامل تام 1(@)(@@) % شرس تيقظه تيقظ خائف % وفعال نجدته فعال شجاع % % 2(@)(@@) % ومدربين على اللقاء كانهم % % لم يخلقوا إلا ليوم قراع % PageV01P1038 البحر : طويل 1(@)(@@) % تضيق صدور العتب ، والعذر أوسع % ويجمح طرف الهجر والود أطوع % 2(@)(@@) % لك الله من قلب ملاه وفاؤه % % فليس لعذر في نواحيه مرتع % % 3(@)(@@) % ولي خاطر ما ان سلكت مضاءه % % على الهم إلا كاد في الدهر يقطع % 4(@)(@@) % اليك فما تظمى إلى الغدر همتي % % إذا ما سقاني من ودادك مشرع % 5(@)(@@) % ولكنني في معشر حلي ودهم % اذا ما اجتلته النائبات التصنع % % 6 
ms295	(@)(@@) % اذا ركضت اقوالهم في مسامعي % % على العذر جاءت خاطري وهي ظلع % % 7(@)(@@) % لحا الله هذا الدهر سيفا على المنى % % اوصل ارابي بها ويقطع % % 8(@)(@@) % اذا شمت منه بارق العزم ردني % % كليل لحاظ الناس والخطب يهمع % 9(@)(@@) % صحبت الرجال الخابطين إلى العلى % % فثبطني لؤم الزمان وأسرع % 10(@)(@@) % امالي من حظ المكارم ان ارى % % سريعا إلى داعي العلى حين يسمع % PageV01P1039 11(@)(@@) % ترد سهامي الحادثات طوائشا % وفي قوس عزمي لو تبوع منزع % 12(@)(@@) % أصرف فهمي ، والمقاول سرع % واملك حلمي والعوامل شرع % % PageV01P1040 البحر : طويل 1(@)(@@) % ومهتزة العرنين رقراقة السنا % % تناسب مستن البروق اللوامع % 2(@)(@@) % افاض على اعطافها القين حلة % % تفضفضن في مثل النجوم الطوالع % % 3(@)(@@) % فجاءت بجسم يملأ العين بهجة % % اذا ما اجتلاها حاسر مثل دارع % % 4(@)(@@) % يحيا بها من لم تحي يمينه % % بغير العوالي والسيوف الققواطع % % 5(@)(@@) % أحد من العذل المطل على الهوى % % وارهف من غرب النوى في المقاطع % % PageV01P1041 البحر : متقارب تام 1(@)(@@) % مقيم من الهم لا يقلع % % وماض من العيش لا يرجع % % 2(@)(@@) % ويوم اشم باقباله % % ويوم بإدباره أجدع % 3(@)(@@) % لأخفق من علقت بالمنى % % يداه واثرى الذي يقنع % % 4(@)(@@) % وما الذل الا خداع اللئيم % % والحر بالذل لا يخدع % 5(@)(@@) % رأينا الرجاء على نأيه % رشاء ، وكل يد تنزع % 6(@)(@@) % بليت وغيري لا يبتلى % % بامرين ما فيهما مطمع % % 7(@)(@@) % بدهر الوم ولا يرعوي % % ومولى اقول ولا يسمع % % 8(@)(@@) % وإني ، إذا ما استطال الزمان % انجدني صاحب اروع % % 9(@)(@@) % ونفس على صبرها مرة % % وقلب على رأيه مجمع % 10(@)(@@) % أخوض به كل دوية % يزل بها الخف أو يظلع % % PageV01P1042 11(@)(@@) % بكل مقلدة بالنسوع % وكان على غيره يدمع % 12(@)(@@) % يصيح الحصى تحت أخفافها % % فنونا ، ويصطخب اليرمع % 13(@)(@@) % واني لاوعب في جلدها % % وللركب هملجة زعزع % 14(@)(@@) % أقيم وخد الضحى أبيض % واسري ورجه الدجى اسفع % % 15(@)(@@) % وامضى اذا بلد المستغير % % وهاب الثنية من يطلع % % 16(@)(@@) % واشلي على المقربات السياط % % إذا ضمها البلد البلقع % 17(@)(@@) % وأوردها الخمس في لجمها % % تبرض ما الفت تكرع % % 18(@)(@@) % تعجب منها وحوش الفلاة % ة تسري واسرابها رتع 
ms296	 % % 19(@)(@@) % ارى النوم ينبو به ناظري % % وكل العيون له مربع % % 20(@)(@@) % ومن ضاقت الأرض عن همه % حر أن يضيق به مضجع % PageV01P1043 21(@)(@@) % لئن كان احزن بي منزل % % فمن قبل امرع لي مرتع % % 22(@)(@@) % على انني عند عض الزمان % % صفاة يضن بها المقطع % 23(@)(@@) % لقد عاف امواله من يجود % % وقد طلق النفس من يشجع % 24(@)(@@) % وابيض يوم الوغى حاسر % % تردى بقائمه الدرع % % 25(@)(@@) % تحف مضاربه ماءه % كما حف واديه الأجرع % 26(@)(@@) % % كما هزت القلم الإصبع % 27(@)(@@) % وزغف تحدر عن بيضة % % كأن الأغم بها أنزع % 28(@)(@@) % يذلل لي سطوات الزمان % % سيفي ومثلي لا يخضع % % 29(@)(@@) % تطاولت للبرق لما سرى % % وعنقي إلى مثله أتلع % 30(@)(@@) % فما لي لا استعيد الجوى % % وقد لاح لي بارق يلمع % PageV01P1044 31(@)(@@) % وأبذل قلبا بأمثاله % تضن الجوانح والأضلع % 32(@)(@@) % ألا إن قلب الفتى مضغة % تضر ولكنها تتفع % % 33(@)(@@) % وابلج اعددته للخطوب % % طودا إلى ظله ارجع % % 34(@)(@@) % كريم الوفاء امين الاخاء % % باق على العهد لا يقلع % % 35(@)(@@) % سريع إلى دعوتي في الأمور % انى إلى صوته اسرع % % 36(@)(@@) % جلوت به الدمع عن ناظري % % وكان على غيره بدمع % % 37(@)(@@) % وكفكفت عمن سواه يدي % % وكنت أرى الماء لا يشبع % 38(@)(@@) % دعوتك يا ناصري في الهوى % % وكان إلى ودك المفزع % % 39(@)(@@) % أتاني أنك طوحت بال % % زيارة عن عارض يقطع % 40(@)(@@) % لقد نال شكواك من مهجتي % % كما نال من عرقك المبضع % % PageV01P1045 41(@)(@@) % دم جاش شؤبوبه عن يد % يقلبها البطل الأروع % 42(@)(@@) % مفيض ولكنه غايض % % وخرق ولكنه يرقع % 43(@)(@@) % ولو أن لي فسحة في الزمان % جاءك بي القدر الأسرع % 44(@)(@@) % وان غبت عنك فان الفؤاد % % عندك ما فاته موضع % 45(@)(@@) % يعوج عليك فلا ينثني % % ويشرب منك فلا ينقع % 46(@)(@@) % واني لتعطفني المطعمات % % عليك كما عطف الاخدع % % 47(@)(@@) % ولولاك لم أعترف بالغرام % ولا قيل إن الفتى موجع % 48(@)(@@) % وما فضل شوقي لولا البكاءخ % % ء والشوق عنوانه الادمع % % PageV01P1046 البحر : طويل 1(@)(@@) % لئن قرب الله النوى بعد هذه % % وكان لروحات المطي بلاغ % 2(@)(@@) % شغلت بكن النفس عن كل حاجة 
ms297	 % وهيهات من شغل بكن فراغ % % 3(@)(@@) % وليس لبرد الماء لم تشربي به % % إلى القلب مني ، يا أميم ، مساغ % PageV01P1047 البحر : بسيط تام 1(@)(@@) % بالجد لا بالمساعي يبلغ الشرف % % تمشي الجدود بأقوام ، وإن وقفوا % % 2(@)(@@) % أعيا من الدهر خلق لا دوام له % البذل والمنع والإنجاز والخلف % 3(@)(@@) % واط بجفونه أعقاب خلته % % يوما ودود ويوما ملة طرف % % 4(@)(@@) % راحت تعجب من شيب ألم به % % وعاذر شيبه التهمام والأسف % % 5(@)(@@) % ولا تزال هموم النفس طارقة % رسل البياض إلى الفودين تختلف % 6(@)(@@) % إن الثلاثين والسبع التوين به % عن الصبا ، فهو مزور ومنعطف % 7(@)(@@) % فما له صبوة يبكى بها طلل % ولا له طربة يعلى بها شرف % 8(@)(@@) % أين الذين رموا قلبي بسهمهم % ولم يداووا لي القرف الذي قرفوا % % 9(@)(@@) % يشكو فراقهم القلب الذي جرحوا % % مني ، وتبكيهم العين التي طرفوا % % 10(@)(@@) % كم جاءني الخوف مما كنت آمنه % % وكم أمنت التي قلبي بها يجف % PageV01P1048 11(@)(@@) % قد يأمن المرء سهما فيه موقعه % وقد يخاف الذي ينأى وينحرف % % 12(@)(@@) % لما رأيت مرامي الظن خاطئة % % ودون ما ارتجى منكم نوى قذف % % 13(@)(@@) % صرفت نفسي عنكم ، وهي غانية % والنفس تصرف أحيانا فتنصرف % % 14(@)(@@) % ما هز فرعكم يأس ولا طمع % % ولا مرى دركم لين ، ولا عنف % 15(@)(@@) % ولا لكم في ثنايا الجود مطلع % % ولا لكم في ظهور المجد مرتدف % % 16(@)(@@) % يأبى لي العز والغراء من شيمي % % إمساك حبل غرور ما له طرف % 17(@)(@@) % هبها ضبابة ليل أنت خابطها % % إن الظلام ، وإن عناك ، منكشف % 18(@)(@@) % تنظر الصبح أن الصبح منتظر % % والفجر يعرب عما أعجم السدف % % 19(@)(@@) % كأنني يوم استعطى نوالكم % % دان من الصخرة الصماء يغترف % 20(@)(@@) % ويوم أدعوكم للخطب احذره % % داع يبلغ من قد ضمه الجدف % % PageV01P1049 21(@)(@@) % ما كنتم من سيوفي ، إذ هزرتكم % هز النوابي إذا أمضيتها تقف % % 22(@)(@@) % يا راعي الذود لا أصبحت في نفر % تروى البكار وتظما الجلة الشرف % 23(@)(@@) % ما أعجب القسمة العوجاء يقسمها % % الدار واحدة والورد مختلف % % 24(@)(@@) % لئن حرمت من العلياء ما رزقوا % % لقد جهلت من الفحشاء ما عرفوا 
ms298	 % % 25(@)(@@) % لأرحلن المطايا ثم أبركها % % حيث اطمأن الندى واستوطن الشرف % % 26(@)(@@) % كأنما في رجال الركب خاطرة % % تعانق الدو ، والنأجية العصف % 27(@)(@@) % بدار أغلب ما في وعده خلف % للراغبين ، ولا في حكمه جنف % 28(@)(@@) % حيث الحقوق قيام في مقاطعها % % وكل من حاكم الأيام منتصف % 29(@)(@@) % راض الأمور أولى شبيبته % % فالرأي محتنك والعمر موتنف % % 30(@)(@@) % يحي المكارم أبناء له وردوا % % كما بنى المجد آباء له سلفوا % % PageV01P1050 30(@)(@@) % يا ابن الأولى نزلوا العلياء خالية % منازل الدر يرمى دونه الصدف % 31(@)(@@) % المقدمين ، فلا ميل ، ولا عزل % والحاملون فلا جوز ولا ضعف % % 32(@)(@@) % لي فيهم خلف من كل مفتقد % وربما جاز قدر الذاهب الخلف % 33(@)(@@) % في كل يوم عدو أنت قائده % قود الجنيب ، لما عسفت معتسف % 34(@)(@@) % في السلم دافقة ، شؤبوبها خضل % والروع بارقة ذو رعدها قصف % % 35(@)(@@) % فمن شعاب ندى أمواهه دفع % % ومن طعان قنا آباره خسف % 36(@)(@@) % تغدو كأنك ، والهامات طائرة % جان من الحنظل العامي ينتقف % 37(@)(@@) % كأن سيفك ضيف الشيب ليس له % % عن الرؤوس ، إذا ما جاء ، منصرف % 38(@)(@@) % فاستأنفوا العز مخضرا زمانكم % كأنما الدهر فيكم روضة أنف % % 39(@)(@@) % وابقوا بقاء الدراري في مطالعها % % إلا البدور ، فإن البدر ينكسف % PageV01P1051 البحر : بسيط تام 1(@)(@@) % تسعى البكار معناة ، وقد ملكت % أولى الجمام عليها الجلة الشرف % % 2(@)(@@) % إذا رأينا قوام الدين راكبها % % فليس في ظهرها للقوم مرتدف % 3(@)(@@) % فقل لمعتسف يرجو لحاقهم : % لبث فقد بلغوا العليا وما اعتسفوا % % 4(@)(@@) % لو أن عين أبيك اليوم ناظرة % تعجب الأصل مما أثمر الطرف % 5(@)(@@) % ونى عن السعي ، فاسترعى مساعيه % مدربا بطريق المجد لا يقف % % 6(@)(@@) % قد يسبق الخيل تاليها وإن كثرت % % منها الفوارط يوم الجري والسلف % % PageV01P1052 البحر : خفيف تام 1(@)(@@) % قل لأقنى يرمي إلى المجد طرفا % % ضرم يعجل الطرائد خطفا % % 2(@)(@@) % طار يستشرف المواقع حتى % % وجد العز موقعا فأسفا % % 5(@)(@@) % ومجاري الزمان خطبا فخطبا % % سابقا خطوه صرفا فصرفا % % 10(@)(@@) % لاث أبطاله عمائم بيضا % لبسوا تحتها قتيرا وزغفا % % 11(@)(@@) % طود يمنى ب % ها لذل وخفا % % 12(@)(@@) % قد كفيت السعي 
ms299	 الطويل ، وتأبى % % أن يرى المجد منك حلسا وقفا % % 13(@)(@@) % بين جد بذ الجدود فأوفى % % وأب ضمن العلاء ، فوفى % % 14(@)(@@) % قام فيه يلف خطبا بخطب % لا نؤوما ، ولا سؤوما ألفا % % 17(@)(@@) % عقدوا بينكم وبين المعالي % % قبل يعلو الرجال عقدا وحلفا % % 18(@)(@@) % ركبوا صعبة العلى أول النا % % س ، فمن جاء بعدهم جاء ردفا % % PageV01P1053 19(@)(@@) % بيت جود تكفي النوائب فيه % % وجفان القرى به ليس تكفا % % 20(@)(@@) % عنده النار أوقدت باليلنجو % % جي تذكى عرفا ، وتجزل عرفا % % 21(@)(@@) % قد بلاك الأعداء حلوا ومرا % % وبلوا شيمتيك لينا وعنفا % % 22(@)(@@) % فراؤك الحسام قدا وقطا % % إذا ما ضفا عليك ورفا % % 24(@)(@@) % حسبوها تصنعا فرأوها % % كل يوم تزداد ضعفا وضعفا % % 26(@)(@@) % كهلال السحاب ما غاب حتى % % رق عن وجهه الغمام فشفا % % 28(@)(@@) % خلق ثابت إذا غير الدهر % % رجالا أخلاقهم تتكفا % % 29(@)(@@) % إن تناسوا تذكر الجود طبعا % % أو تولوا ثنى إلى المجد عطفا % % 30(@)(@@) % في رواق من القنا لا ترى في % % ه لقد جاذب الزمام الأكفا % % 31(@)(@@) % رسبوا في غمارها ، ولو أن ال % % بعد ما غض ناظريه وأغفى % % PageV01P1054 34(@)(@@) % إن من ضوئها لذي التاج تاجا % ولرب الأطواق طوقا وشنفا % % 35(@)(@@) % فابق للخطب مقذيا منه عينا % % كل يوم ، ومرغما منه أنفا % % 39(@)(@@) % صل بفخر الملك الأغر حساما % % تجمع الماضيين عضبا وكفا % % 40(@)(@@) % داعم الملك يوم مال ولاقى % % موجانا من الخطوب ورجفا % % PageV01P1055 البحر : كامل تام 1(@)(@@) % ردوا الغليل لقلبي المشغوف % % وخذوا الكرى عن ناظري المطروف % 2(@)(@@) % ودعوا الهوى يقوى علي مضاعفا % أني على الأشجان غير ضعيف % % 3(@)(@@) % ولقد رتقت على العذول مسامعي % % وصممت عن عذل وعن تعنيف % 4(@)(@@) % أرضى البطالة أن تكون قلائدي % % أبدا ولوم اللائمين شنوفي % % 5(@)(@@) % هل دارنا بالرمل غير نزيعة % % أم حينا بالجزع غير مخلوف % % 6(@)(@@) % فلقد عهدت بها كنافرة المها % % من كل ممشوق القوام قضيف % % 7(@)(@@) % سرب ، إذا استوقفت في ظبياته % عيني رحت على جوى موقوف % 8(@)(@@) % يرعين أثمار القلوب تواركا % مرعى ربيع بلالوى وخريف % % 9(@)(@@) % كم بين أثناء الضلوع لهن من % % قرف بأظفار النوى مقروف % 10(@)(@@) % لا 
ms300	 تأخذيني بالمشيب فإنه % % تفويف ذي الأيام لا تفويفي % % PageV01P1056 11(@)(@@) % لو أستطيع نضوت عني برده % % ورميت شمس نهاره بكسوف % % 12(@)(@@) % كان الشباب دجنة فتمزقت % % عن ضوء لا حسن ، ولا مألوف % 13(@)(@@) % ولئن تعجل بالنصول ، فخلفه % روحات سوف للمنون عنيف % 14(@)(@@) % وإذا نظرت إلى الزمان رأيته % % تعب الشريف وراحة المشروف % % 15(@)(@@) % أوفيت معتليا عليكم واضعا % ومجال كل موضع مضعوف % % 16(@)(@@) % أعلي يستل الدني لسانه % % سيذوق موبى مربعي ومصيفي % % 17(@)(@@) % فيمن تعيرني بفيك رغامها % % أبتالدي في المجد أم بطريفي % % 18(@)(@@) % ابمعشري وهم الأولى عاداتهم % % في الروع ضرب طلا وخرق صفوف % % 19(@)(@@) % من كل وضاح الجبين مغامر % % عند العظائم ، باسمه مهتوف % 20(@)(@@) % وإذا قرعت ، فهم صدور ذوابلي % % ومن العدو معاقلي وكهوفي % % PageV01P1057 21(@)(@@) % فاذهب بنفسك حاسما اطماعها % % عن صل واد أو هزبر غريف % 22(@)(@@) % فلقد جررت على الزمان عوائدي % % إني أدق زحوفه بزحوفي % % 23(@)(@@) % هذا ، وقومك بين قاذف معشر % كذبا ، وبين ملعن مقذوف % 24(@)(@@) % لا المجد في أبياتهم بمعرق % % يوما ولا لهم الندى بحليف % % 25(@)(@@) % قبلي سقاك أبي كؤوس مذلة % ولتشربن بيدي كؤوس حتوف % % 26(@)(@@) % ذاك الثقاف يقيم كل مميل % وأنا الجراز أقد كل صليف % 27(@)(@@) % فحذار إن شب الفنيق لحاظه % وتقاربت أنيابه لصريف % % 28(@)(@@) % خل الطريق لمجمر أخفافه % % ماض على سنن الطريق منيف % 29(@)(@@) % ولضيغم يطأ الرجال ، غلبة % بقنا من الأنياب أو بسيوف % % 30(@)(@@) % واشدد حشاك فلست تطمح خاليا % إلا بدا لك موقفي ووقوفي % % PageV01P1058 31(@)(@@) % وإذا رميت من الحذار بمقلة % % في الجو راعك في السماء حفيفي % % 32(@)(@@) % أهوى إلى فرص يسوءك غبها % % متسرعا كالأجدل الغطريف % 33(@)(@@) % كيدا يري أن لا دعي أمية % قدمي على قمر السماء الموفي % % 34(@)(@@) % ووليتكم فحززت في عيدانكم % % حتى أقام مميلها تثقيفي % % 35(@)(@@) % وفطمتكم بالزجر عن عاداتكم % % ورددت منكركم إلى المعروف % 36(@)(@@) % عف السريرة لم تلط لريبة % يوما علي مغالقي وسجوفي % % 37(@)(@@) % فلئن صرفت فلست عن شرف العلى % % ومقاعد العظماء بالمصروف % % 38(@)(@@) % ولئن بقيت لكم ، فإني واحد % أبدا أقوم منكم بألوف % % PageV01P1059 البحر : وافر تام 1(@)(@@) % ردي مر الورود ولا تعافي 