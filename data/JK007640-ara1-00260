ms241	 هذه الأحشاء هما % % 8(@)(@@) % وليل ما برحت أدير فيه % % معتقة تلذ لدي طعما % % 9(@)(@@) % أزوجها بابن المزن بكرا % وأمزج صرفها برضاب ألمى % % 10(@)(@@) % وأغتنم المسرة بالندامى % % وكانت لذة الندماء غنما % % PageV01P753 11(@)(@@) % رعى الله الشباب وإن تولى % % وذكر عهده يوما فيوما % % 12(@)(@@) % صحا سكران من خمر التصابي % % وبدل بعد ذاك الجهل حلما % % 13(@)(@@) % وصاخ إلى العذول وكان صبا % يى لوم العذول أشد لوما % % 14(@)(@@) % فمن لاح يعنفه لدمع % يكفكفه مخافة أن ينما % % 15(@)(@@) % أرتني من حوادثها الليالي % % أعاجيبا لها العبرات تدمى % % 16(@)(@@) % ومن لي أن تسالمني الرزايا % % فما زالت لي الأرزاء خصما % % 17(@)(@@) % أؤمل نفس حر لم تعدني % % أمانيها إلى أجل مسمى % % 18(@)(@@) % ضلالا ما أعلل فيه نفسي % % وقولي ربما وعسى ولما % % 19(@)(@@) % فما لي والخمول وكل يوم % % تفوق لي خطوب الدهر سهما % % 20(@)(@@) % أراني إن عزمت على مهم % ثنت عني يد الأقدار عزما % % PageV01P754 21(@)(@@) % وإني سوف أركبها لآمر % أحاول شأوه إما وإما % % 22(@)(@@) % وإن لياليا أعرقن عظمي % % أضاعتني وما ضيعت عزما % % 23(@)(@@) % فتبا للزمان لقد تعدى % % حدودا ما تعداهن قدما % % 24(@)(@@) % أيسمو الجاهلون بغير علم % ويروى من هزوت به وأظما % % 25(@)(@@) % تحول يا زمان إلى الأعالي % % وخذ بكمالها فالنقص تما % % 26(@)(@@) % لقد جهل الزمان بعلم مثلي % % وإن الجهل بين بنيه عمأ % % 27(@)(@@) % وكيف أسود في زمن جهول % ولو اني كإبراهيم علما % % 28(@)(@@) % قريب من رسول الله يدعى % % بأزكى العالمين أبا وأمأ % % 29(@)(@@) % نمته الأنجبون وكل قرم % % إلى خير الورى يعزى وينمى % % 30(@)(@@) % تخلق من سنا نور مبين % % فكان الجوهر النبوي جسما % % PageV01P755 31(@)(@@) % بني الشرف الذي يعلو ويسمو % % فما أعلى مبانيه وأسمى % % 32(@)(@@) % وشيده وإن رغمت أنوف % ولم يبرح لأنف الخصم رغما % % 33(@)(@@) % بناء قصرت عنه السواري % % وما استطاعت له الحساد هدما % % 34(@)(@@) % تأمل في عظيم من قريش % % تجد أسد الشرى والبدر تما % % 35(@)(@@) % عليه من رسول الله نور % به يمحو الظلام المدلهما % % 36(@)(@@) % إذا الأمر المهم دهى ، كفانا % % بدعوته لنا ما قد أهما % % 37(@)(@@) % شفاء للصدور وكم مريض % % يكون له 
ms242	 شتيار الشهد سما % % 38(@)(@@) % بروحي منك أروع هاشميا % حديد القلب واري الزند شهما % % 39(@)(@@) % لك الكلم التي جمعت فأوعت % % تروح الملحدون بهن كلمى % % 40(@)(@@) % وكم من حجة نطقت فظلت % لها فصحاء غير الحق عجما % % PageV01P756 41(@)(@@) % وجئت بما يحير الفكر فيه % % بيانا منك إلهاما وفهما % % 42(@)(@@) % وقد أحييت هذا الدين علما % بحيث الدين قارب أن يرما % % 43(@)(@@) % وقومت الشريعة فيه حكما % ولم تر غير حكم الله حكما % % 44(@)(@@) % وكم أغضبت يا ملاي قوما % بما فيهم وكم أرضيت قوما % % 45(@)(@@) % أتكتم فضلك الحساد جهلا % وما اسطاع الدجى للنور كتما % % 46(@)(@@) % مناقبك النجوم وليس بدعا % إذا ما أنكرتها عين أعمى % % 47(@)(@@) % وجدتك سيدي للمدح أهلا % فخذ مدحي إذن نثرا ونظما % % 48(@)(@@) % وحسبي منك جائزتي دعاء % به من سائر الأسواء أحمى % % 49(@)(@@) % أنال به الثواب بغير شك % % وأمحو بالثناء عليك إثما % % 50(@)(@@) % وليس يفي بفضلك كنه مدحي % % وكان المدح إلا فيك ظلما % % PageV01P757 البحر : رمل تام 1(@)(@@) % كاد أن يقضي سقاما ونحولا % % إذ عصى في طاعة الحب العذولا % % 2(@)(@@) % دنف لولا هواكم ما شكا % % كبدا حرى ولا جسما نحيلا % % 3(@)(@@) % علم العاذل ما لاقى بكم % % يوم أزمعتم وإن كان جهولا % % 4(@)(@@) % من صبابات أذابته أسى % وغرام أهرق الدمع همولا % % 5(@)(@@) % وصبابات الهوى قد سولت % لدموعي في جفاكم أن تسيلا % % 6(@)(@@) % لا أرى الصبر جميلا عنكم % % ومحال أن أرى الصبر جميلا % % 7(@)(@@) % قد ذكرناكم على شحط النوى % % فانشنينا عند ذاك الذكر ميلا % % 8(@)(@@) % يا لها ذكرى أهاجت لوعة % % أخذت مني الحشا أخذا وبيلا % % 9(@)(@@) % هبت الإرواح من أحيائكم % % فانتشقناها شمالا وقبولا % % 10(@)(@@) % فكأنا بالصبا حينئذ % قد شربناها من الراح شمولا % % PageV01P758 11(@)(@@) % يا رفيقي وهل من مسعد % لعليل يشتكي طرفا عليلا % % 12(@)(@@) % بل كميه من الدمع وما % % بل من أحشائه الدمع غليلا % % 13(@)(@@) % لامني العاذل جهلا بالهوى % % وغدا الناصر في الحب خذولا % % 14(@)(@@) % أنا لولا شغفي فيكم لما % % وجد اللاحي إلى العذل سبيلا % % 15(@)(@@) % ما على اللائم من مستغرم % % يعشق السالف والخد الأسيلا % % 16(@)(@@) % راح يلقي - لقي 
ms243	 السوء - على % % مسمعي في عذله قولا ثقيلا % % 17(@)(@@) % ليتني قبل الهوى لم أتخذ % ساحر الطرف من السرب خليلا % % 18(@)(@@) % لست أدري إذ رنت ألحاظهم % % ألحاظا أرهفوها أم نصولا % % 19(@)(@@) % ظعن الحي وأضحى حبهم % % يسأل الأرسم عنهم والطلولا % % 20(@)(@@) % ليت شعري أين سارت عيسهم % % تقطع البيداء وخدا وذميلا % % PageV01P759 21(@)(@@) % ويعاني ما يعاني بعدهم % % زفرة الأشواق والحزن الطويلا % % 22(@)(@@) % ساهر المقلة في الوجد فما % % يطعم الغمض به إلا قليلا % % 23(@)(@@) % أمروا بالصبر عنهم ولكم % % لذت بالصبر فما أغنى فتيلا % % 24(@)(@@) % صاحبي أنت خبير بالهوى % % أترى مثل الهوى داء قتولا % % 25(@)(@@) % عارض منن عبرة أهرقتها % % روضت روض جوى كان محيلا % % 26(@)(@@) % إن أردتم راحة الروح بكم % % فابعثوا الريح إلى روحي سبيلا % % 27(@)(@@) % وأعدها مرة ثانية % يا نسيما هيج الوجد بليلا % % 28(@)(@@) % علم الله بأني شاعر % % لم أقل زورا ولم أمدح بخيلا % % 29(@)(@@) % قد كفاني الله في ألطافه % % بأبي عيسى نوالا ومنيلا % % 30(@)(@@) % بالزكي الطاهر الشهم الذي % % طاب في الناس فروعا وأصولا % % PageV01P760 31(@)(@@) % من ينيل النيل من إحسانه % % والعطاء الجم والمال الجزيلا % % 32(@)(@@) % وإذا ما لفحت هاجرة % كان من رمضائها ظلا ظليلا % % 33(@)(@@) % واضح الفخر ومن هذا الذي % % يبتغي يوما على الشمس دليلا % % 34(@)(@@) % من فتى فيه وفي آبائه % % كل ما قد قيل في الأنجاب قيلا % % 35(@)(@@) % أنجب العالم أما وأبا % وأعز الناس في الناس قبيلا % % 36(@)(@@) % إنما آل جميل غرة % ألهموا المعروف والفعل الجميلا % % 37(@)(@@) % ورثوها عن أبيهم شيما % تبلغ العلياء والمجد الأثيلا % % 38(@)(@@) % قد أحلتهم نفوس شرفت % بمكان الأنجم الزهر حلولا % % 39(@)(@@) % قل لمن يزعم أن يشبههم % لم تنل بالزعم شيئا مسحيلا % % 40(@)(@@) % وبروحي من يهين المال في % % جوده الوافي ومن يحمي النزيلا % % PageV01P761 41(@)(@@) % وإذا ما هزه مستنجد % بعلاه هزه عضبا صقيلا % 42(@)(@@) % طاول الشم الرواسي في العلى % % وجدير في علاه أن يطولا % % 43(@)(@@) % وإذا ما سئل الفضل اغتدى % % مبلغا من كل ما يسأل سولا % % 44(@)(@@) % لم أزل حتى أوارى في الثرى % % مقصرا فيهم ثنائي ومطيلا % % 45(@)(@@) % أورنوها كابرا عن كابر % % مكرمات 
ms244	 لم تزل جيلا فجيلا % % 46(@)(@@) % نجموا بعد أبيهم أنجما % لا أراهم بعد إشراق أفولا % % 47(@)(@@) % خلف عن سالف أخلفهم % % للندى بحرا وللوفد مقيلا % % 48(@)(@@) % كل فرد يلبس الدهر به % % غررا تشرق فيه وحجولا % % 49(@)(@@) % مظهر من صنعه منقبة % % حير الأفكار فيها والعقولا % % 50(@)(@@) % أبدعوا في مكرمات منهم % % فعلت آياتها فيهم فصولا % % PageV01P762 51(@)(@@) % سلهم الفضل فهم أهل له % % وسواهم يحسب الفضل فضولا % % 52(@)(@@) % وارتقب أنواءهم ممطرة % لا ندى نزرا ولا وعدا مطولا % % 53(@)(@@) % ضمنت آمالنا إحسانهم % % وتضمن ولا ريب الحصولا % % 54(@)(@@) % يا بني عبد الغني العز لي % % في معاليكم وما كنت ذليلا % % 55(@)(@@) % كلما ألبست شعري مدحكم % % سحب الشعر من الفخر ذيولا % % PageV01P763 البحر : هزج 1(@)(@@) % بحيث انعطف البان % قويم القد فتان % 2(@)(@@) % وللقامات أغصان % % وفي الأرداف كثبان % % 3(@)(@@) % رويدا أيها الساقي % % فإني بك سكران % % 4(@)(@@) % وهذا قدك النشوا % % ن من عينيك نشوان % % 5(@)(@@) % في من روضك الزاهي % % بروض الحسن بستان % % 6(@)(@@) % فمن وجنتك الورد % ومن قامتك البان % % 7(@)(@@) % ومن عارضك المخضر % لي روح وريحان % % 8(@)(@@) % وفي فيك لنا خمر % وأنت الخمر والحان % % 9(@)(@@) % وإني لجنى ريقتك % % العذبة ظمآن % % 10(@)(@@) % جنود منك في الحب % % على قتلي أعوان % % PageV01P764 11(@)(@@) % فمن جفنيك صمصام % % ومن قداك مران % % 12(@)(@@) % نعم في طرفك الموقظ % % وجدي وهو وسنان % % 13(@)(@@) % وما أنت كمن يسلى % % وما لي عنك سلوان % % 14(@)(@@) % وجنات دخلناها % % فقلنا أين رضوان % % 15(@)(@@) % وفيها من فنون الحسن % % في الدوحة أفنان % % 16(@)(@@) % وفيها اختلفت للزهر % % للزهر أشكال وألوان % % 17(@)(@@) % فللنرجس أحداق % كما للآس آذان % % 18(@)(@@) % وهذا الأقحوان الغض % تبدو منه أسنان % % 19(@)(@@) % وقد حض على شرب % % المدام الصرف ندمان % % 20(@)(@@) % وطافت بكؤوس الراح % % والراحات غلمان % % PageV01P765 21(@)(@@) % وطاسات من الفضة % % فيها ذاب عقيان % % 22(@)(@@) % فما وسوس للهم % بصدر الشرب شيطان % % 23(@)(@@) % وقال شرب على حبي % % فإن الحب سلطان % % 24(@)(@@) % وهذا القدح الفارغ % % أضحى وهو ملآن % % 25(@)(@@) % رعى الله لنا في الحي % أحبابا وإن خانوا % % 26(@)(@@) % ذكرناهم على النأي % % وإن شطوا وإن بانوا % % 27(@)(@@) % وفي الذكرى تباريح % وأشجان وأحزان % % 28 
ms245	(@)(@@) % كأنا في رياض الحزن % % لا كنا ولا كانوا % % 29(@)(@@) % سقى عهدهم الماضي % % ملث القطر هتان % % 30(@)(@@) % فما تغمض من بعدهم % % للصب أجفان % % PageV01P766 31(@)(@@) % وأظمى كبدي الحرى % % برود الثغر ريان % % 32(@)(@@) % بذلنا أنفسا تغلو % % لها في الحب أثمان % % 33(@)(@@) % ألا لا سلم المال % % وفي الأنجاب سلمان % % 34(@)(@@) % قرين الشرف الباذخ % % والأشراف أقران % % 35(@)(@@) % على طلعته الغراء % % للإقبال عنوان % % 36(@)(@@) % هم القوم إذا عدوا % % بهم تفخر عدنان % % 37(@)(@@) % أباة الضيم أشراف % % لغير الله ما دانوا % % 38(@)(@@) % وها هم في سبيل الله % % ما جاروا وما مانوا % % 39(@)(@@) % هم الصم إذا يقسون % % والماء إذا لانوا % % 40(@)(@@) % وإما حلقوا في جو % علياء فعقبان % % PageV01P767 41(@)(@@) % شيوخ لم تزل تسمو % % إلى المجد وفتيان % % 42(@)(@@) % أذلوا عزة المال % % فما ذلوا وما هانوا % % 43(@)(@@) % وصانوا المجد في البذل % % فما أحسن ما صانوا % % 44(@)(@@) % فهم للدين أطواد % وهم للدين أركان % 45(@)(@@) % رجال كوشفت بالحق % لا يحجبها الران % % 46(@)(@@) % فيا عين العلى أنت % لعين العز إنسان % % 47(@)(@@) % وفي آثارك الغر % من السادات أعيان % % 48(@)(@@) % إذا ما وزن القوم % ففي وزنك رجحان % % 49(@)(@@) % وفي مدحك للأقلام % % تغريد وألحان % % 50(@)(@@) % وفي شكري لنعمائك % % إعلام وإعلان % % PageV01P768 51(@)(@@) % أراد الله في شأنك % % إن يرفع لي شان % % 52(@)(@@) % ومما زاد في حسنك % % عند الناس إحسان % % 53(@)(@@) % فمدح لم يكن فيك % % فتزوير وبهتان % % 54(@)(@@) % وربح لم يكن منك % % فذاك الربح خسران % % 55(@)(@@) % وعن فضلك والصبح % % وما يخفيه كتمان % % 56(@)(@@) % وسارت بثنائي لك % % في الأقطار ركبان % % 57(@)(@@) % فلا زلت بعلياء % لها ينحط كيوان % % PageV01P769 البحر : رمل تام 1(@)(@@) % قام يجلوها ويرد الليل معلم % خمرة ما جتمعت مع لهم % 2(@)(@@) % فهي تبر في لجين ذائب % % أو كنار في فؤاد الماء تضرم % % 3(@)(@@) % نظم المزج عليها حببا % رصع الياقوت بالدر المنظم % % 4(@)(@@) % عجبا للشرب أنى قطبت % % أوجها من شرب راح تتبسم % % 5(@)(@@) % وإذا أبهم أمر في العلى % % مثلها قد يحمد الدهر المذمم % % 6(@)(@@) % من رآى يا قوم منكم قبلها % % قبل هذا أن نورا يتجسم % % 7(@)(@@) % فهي سر الضيا % % في ضمير الليل 
ms246	 من أن يتكتم % % 8(@)(@@) % قدمت في عصرها حتى لقد % % أوشكت تخبرنا عما تقدم % % 9(@)(@@) % ما ألذ الراح يسقاها آمرؤ % من أيادي منية القلب المتيم % % 10(@)(@@) % كقضيب البان أنى ينثني % % ذو قوام يشبه الرمح المقوم % % PageV01P770 11(@)(@@) % أشرق البدر علينا وجهه % % فعرفنا منه أن البدر قد تم % % 12(@)(@@) % بابلي اللحظ حلوي اللمى % % غير أني في هواه أتألم % % 13(@)(@@) % مالك ما رق للصب ومن % % عادة المالك أن يرثو ويرحم % % 14(@)(@@) % ظالمي في الحب عدل ف عجبوا % % يا لقومي من ظلوم يتظلم % % 15(@)(@@) % عاطنيها يا نديمي قهوة % تخضب الأقداح بالصبغ المعندم % % 16(@)(@@) % وانتهبها فرصة ممكنة % % قبل أن تمضي سدى أو تتندم % % 17(@)(@@) % في رياض قرن البشر بها % % فغدت تقرن دينارا بدرهم % % 18(@)(@@) % و عص من لامك فيها طائعا % لذة النفس فأنس النفس ألزم % % 19(@)(@@) % أترى مستعظم الوزر بها % % ليس يدري أن عفو الله أعظم % % 20(@)(@@) % أنعم العيشة ما قضيتها % % مع مليح جاد بالوصل وأنعم % % PageV01P771 21(@)(@@) % فتعاطاها إلى أن ينجلي % % من أسارير الدجى ما كان أظلم % % 22(@)(@@) % فترى للصبح في إثر الدجى % % صارما من شفق يلطخ بالدم % % 23(@)(@@) % أو فكانا كجوادي حلبة % راح يتلو أشقر آثار أدهم % % 24(@)(@@) % رفع الفجر لنا رايته % % وتولى الليل بالجيش العرمرم % % 25(@)(@@) % يا لها من ليلة في جنحها % % حلل اللهو بها كل محرم % % 26(@)(@@) % رقص البان لها من طرب % وتثنى لحمام يترنم % % 27(@)(@@) % نطق العود بأسرار الهوى % % فسكتنا والأغاني تتكلم % % 28(@)(@@) % فحسبناها لما قد أطربت % % أفصحت في مدح عبد القادر القرم % % 29(@)(@@) % لم تزل منا إلى حضرته % % مدح تجبي ومال يتقسم % % 30(@)(@@) % حكم العافين في أمواله % % وهي فيما تشتهيه تتحكم % % PageV01P772 31(@)(@@) % هكذا كان وما زال كذا % % إنها شنشنة من عهد أخزم % % 32(@)(@@) % لو نظرنا رقة في طبعه % % لحسبناه نسيمأ يتنسم % % 33(@)(@@) % فهو مثل الروض وافاه الحيا % % رائق المنظر زاه عطر الشم % % 34(@)(@@) % لم ترق عيني سوى طلعته % % أنا فيها لم أزل أنجو من الغم % % 35(@)(@@) % بيضت وجه المنى أقلامه % % إن يكن وجه المنى أسود أسحم % % 36(@)(@@) % وسطت في الخصم حتى 
ms247	 أنها % % فتكت فتك القنا في مهجة الخصم % % 37(@)(@@) % ملهم يعلم ما يأتي من الأ % % مر إن شاء وبعض الناس ملهم % % 38(@)(@@) % ذاك واري الزند مغوار النهى % % إن رمى أصمى وإن جادل أقحم % % 39(@)(@@) % % كشفت آراؤه عن كل مبهم % % 40(@)(@@) % طار في الأفق لك الصيت الذي % % كلما أنجد في الأقطار أتهم % % PageV01P773 41(@)(@@) % أنت والغيث جوادا حلبة % % مثلما أنت مع العلياء تؤأم % % 42(@)(@@) % كم وردنا منك عذبا سائغا % كالحيا المنهل بل أمرى وأسجم % % 43(@)(@@) % وبلغنا من أياديك المنى % % فيمينا إن يمناك لكاليم % % 44(@)(@@) % بأبي أنت وأمي ماجدا % وملاذا في معاليه لمن أم % % 45(@)(@@) % إن ذكرنا فضل أرباب الندى % % كنت رأس الكل والرأس مقدم % % 46(@)(@@) % أنت والله لأندى من حيا % مستهل القطر بالجود وأكرم % % 47(@)(@@) % أرغم الله أعاديك بما % % يجدع الأنف به جدعا ويرغم % % 48(@)(@@) % وفداك القوم أما كفهم % % فجماد ونداهم فمحرم % % 49(@)(@@) % وكفاك الله أسواء امرئ % ضاحك يكشر عن أنياب أرقم % % 50(@)(@@) % وإليك اليوم مني مدحا % أيها المولى وحوشيت من الذم % % PageV01P774 51(@)(@@) % فلسان الحال مني مفصح % إن يكن مني لسان القال أبكم % % 52(@)(@@) % أنا في مدحك ما بين الورى % % أفصح الناس وإن لم أتكلم % % 53(@)(@@) % خدم العبد علاكم شعره % % أنت في أمثاله ما زلت تخدم % % 54(@)(@@) % شاكرا مولاي إحسانك بي % % إن إحسانك يا مولاي قد عم % % 55(@)(@@) % إن تفضلت على الداعي لكم % % بقبول فتفضل وتكرم % % 56(@)(@@) % أسأل الله لعلياك البقا % % فابق في العز مدى الأيام واسلم % % PageV01P775 البحر : وافر تام 1(@)(@@) % ملكت فؤاد صبك في جمالك % فلا تضن محبك في دلالك % % 2(@)(@@) % كئيب من جفونك في سقام % % فعالجه وإلا فهو هالك % % 3(@)(@@) % يروم وصالك الدنف المعنى % % ولو أن المنية في وصالك % % 4(@)(@@) % تحرم وصل من يهواك ظلما % وتبخل فيه حتى في خيالك % % 5(@)(@@) % وما ينسى لك المشتاق ذكرا % أيخطر ذكرها يومأ ببالك % % 6(@)(@@) % لقد ضاقت مذاهبه عليه % % وسدت دون وجهته المسالك % % 7(@)(@@) % مللت وما مللت عن التجافي % % فلم لا ملت يوما عن ملالك % % 8(@)(@@) % فيا ظبي الصريم وأنت ريم % لكم قنصت أسود في 
ms248	 حبالك % % 9(@)(@@) % وإنك إن حكيت الصبح فرقا % حكى حظي الشقي سواد خالك % % 10(@)(@@) % أقول لعاذل بهواك يلحو % % أصم الله سمعي عن مقالك % % PageV01P776 11(@)(@@) % وبين الوجد والسوان بعد % % كما بين اتصالك وانفصالك % % 12(@)(@@) % تحل دما من العاني حراما % فهلا كان وصلك من حلالك % % 13(@)(@@) % وهبنا من زكاة الحسن وصلا % أما تجب الزكاة على جمالك % % 14(@)(@@) % وإنا في هواك كما ترانا % % عطاشى لا تؤملنا ببالك % % 15(@)(@@) % يؤملنا المنى فيك المنايا % % ويوقعنا غرامك في المهالك % % 16(@)(@@) % وما طمع النفوس سوى تلاق % وقد أطعمت نفسي في نوالك % % 17(@)(@@) % منعت ورود ذاك الثغر عني % % فواظمأ الفؤاد إلى زلالك % % 18(@)(@@) % أربع المالكة بعد ليلى % % ضلالا إن صبوت لغير ضالك % % 19(@)(@@) % سقيت الري من ديم الغوادي % % تجر ذيولهن على رمالك % % 20(@)(@@) % أقاسي من ظبائك ما أقاسي % % وأعظم ماأكابد من غزالك % % PageV01P777 21(@)(@@) % ويا قلبا يذوب عليك وجدا % أرى هذا الغرام على وبالك % % 22(@)(@@) % يحملك الهوى حملا ثقيلا % وما حتملت قلوب كاحتمالك % % 23(@)(@@) % ألا ف نشد بذات الضال قلبي % % فعهدي أنه أضحى هنالك % % 24(@)(@@) % ولا تسلك بنا سبل اللواحي % % فإني في سبيلك غير سالك % % 25(@)(@@) % لقد أرشدت بل أضللت فيه % % فلم أعرف رشادك من ضلالك % % 26(@)(@@) % شجيت وأنت من وجدي خلي % وها حالي ثكلتك غير حالك % % 27(@)(@@) % فلا تحتل على صبري بشيء % من العجز اتكلت على احتيالك % % 28(@)(@@) % ولا تعذل أخا دنف عليه % % متى يصغي لقيلك أو لقالك % % 29(@)(@@) % يزين صباح ذاك الفرق منه % % باسود من سواد الليل حالك % % 30(@)(@@) % وما لك بالغرام وأنت عدل % % تجور على المحب مع عتدالك % % PageV01P778 31(@)(@@) % أيملك بالهوى رقي وإني % % شهاب الدين لي بالفضل مالك % % 32(@)(@@) % أمحمود الفضائل والسجايا % % حمدت من الأنام على فعالك % % 33(@)(@@) % لقد أوتيت غاية كل فضل % % بخوضك في العلوم وباشتغالك % % 34(@)(@@) % إذا افتخرت بنو آل بآل % ففخر الدين أنت وفخر آلك % % 35(@)(@@) % وأعجب ما نشاهد في أحاجي % % بديهتك العجيبة و رتجالك % % 36(@)(@@) % وكم أخرست منطقيا بلفظ % % فأفصح عن علاك لسان حالك % % 37(@)(@@) % وفي مرآك للأبصار وحي % ينبئنا فديتك عن جلالك 
ms249	 % % 38(@)(@@) % وتصقع بالبلاغة والمعالي % % أشد على عدوك من نبالك % % 39(@)(@@) % فيا فرع النبوة طبت أصلا % ثمار الفضل تجنى من كمالك % % 40(@)(@@) % ظفرنا من نداك بما نرجي % % على أن ما ظفرنا في مثالك % % PageV01P779 41(@)(@@) % وحسبك أنت أشرف من عليها % % تشرفت البسيطة في نعالك % % 42(@)(@@) % وكم لله من سيف صقيل % بجوهره العناية في صقالك % % 43(@)(@@) % لنا من اسمك المحمود فأل % يخبر سائليك بسعد فالك % % 44(@)(@@) % وما أنا قائل بنداك وبل % لأن الوبل نوع من بلالك % % 45(@)(@@) % إذا الأيام يوما اظمأتنا % % وردنا من يمينك أو شمالك % % 46(@)(@@) % وإن بارزت بالبرهان قوما % تحامى من يرومك في نزالك % % 47(@)(@@) % وكل منهم وله مجال % فما جالت جميعا فقي مجالك % % 48(@)(@@) % تجيب إذا سئلت بكل فن % وتعجزهم جوابا عن سؤالك % % 49(@)(@@) % وإنك أكثر العلماء علما % ولست أقلهم إلا بمالك % % 50(@)(@@) % نعم هم في معاليهم رجال % % ولكن لم يكونوا من رجالك % % PageV01P780 51(@)(@@) % كمالك لا يرام إليه نقص % وأين البدر تما من كمالك % % 52(@)(@@) % وما تحكي البدور التم إلا % بوجهك و رتفاعك و نتقالك % % 53(@)(@@) % سجاياك الجميلة خبرتنا % % بأن الحسن معنى من خصالك % % 54(@)(@@) % خلال كلها كرم وجود % تجمعت المكارم في خلالك % % 55(@)(@@) % وما في الناس من تلقاه إلا % ويسأل من علومك أو نوالك % % 56(@)(@@) % وتولي في جميلك كل شخص % كأن الخلق صارت من عيالك % % 57(@)(@@) % لقد أمنتني خوف الليالي % % وإني إن بقيت ففي خلالك % % 58(@)(@@) % تعالى قدرك العالي محلا % وعندي أن قدرك فوق ذلك % % 59(@)(@@) % وصفتك بالفضائل والمعالي % % ولم تك سيدي إلا كذلك % % PageV01P781 البحر : كامل تام 1(@)(@@) % هلا نظرت إلى الكئيب الواله % وسألته مستكشفا عن حاله % 2(@)(@@) % أودى بمهجته هواك ولم يدع % منه الضنى إلا رسوم خياله % % 3(@)(@@) % الله في كبد تذوب ومدمع % % أهرقت صوب مصونه ومذاله % % 4(@)(@@) % وحشاشة تورى عليك وناظر % % ممن دعا لوبالها ووباله % % 5(@)(@@) % أتظنه يسلو هواك على النوى % % تالله ما خطر السلو بباله % % 6(@)(@@) % عذرا إليك فلو بدا لك ما به % % ما كنت إلا أنت من عذاله % % 7(@)(@@) % ويلي من الحي المراق له دمي 
ms250	 % % في غاب ضيغمه كناس غزاله % % 8(@)(@@) % هذا يصول بطرفه وبقده % % صولات ذاك برمحه ونصاله % % 9(@)(@@) % من كل معتقل قناة قوامه % % والطعن كل الطعن من عساله % % 10(@)(@@) % رام يسدد سهمه ويريشه % % أحشاي من أغراض وقع نباله % % PageV01P782 11(@)(@@) % مرت ممكسه الصبا فتنفست % % عن ورد وجنته ومسكة خاله % % 12(@)(@@) % ولكم جرى بيني وبين رضابه % % ما كان عند السكر من جرياله % % 13(@)(@@) % لا تعذلن على الهوى أهل الهوى % % ودع المشوق كما علمت بحاله % % 14(@)(@@) % أما رحيل تصبري وتجلدي % % فغداة جد الركب في ترحاله % % 15(@)(@@) % إن تنشدا قلبي وعهدكما به % % صاع العزيز فإنه برحاله % % 16(@)(@@) % يا أيها الحادي أما بك رأفة % % بالركب منحط القوى لكلاله % % 17(@)(@@) % عجت المطي لمنزل مستوبل % حتى وقفت به على أطلاله % % 18(@)(@@) % ولقد سألت فما أجابك ربعه % % فعلام تكثر بعدها بسؤاله % % 19(@)(@@) % سحب النسيم على ثراك إذا سرى % % أرجا يفوح المسك من أذياله % % 20(@)(@@) % يا دارنا وسقاك من صوب الحيا % % ما إن يصوب الري صب سجاله % % PageV01P783 21(@)(@@) % سقيا لعهدك بالغميم وإن مضى % % وتصرمت أوقاته بظلاله % % 22(@)(@@) % قد كنت أعلم أن عيشك لم يدم % % وبصرت قبل دوامه بزواله % % 23(@)(@@) % قست الأمور بمثلها فعرفتها % % ولقد يقاس الشيء في أمثاله % % 24(@)(@@) % وتقلبي في النائبات أباحني % % نظرا إلى غاياته ومآله % % 25(@)(@@) % أنى تفوز بما تحاول همتي % % والدهر ملتفت إلى أنذاله % % 26(@)(@@) % وأرى المهذب في الزمان معذبا % في الناس في أقواله وفعاله % % 27(@)(@@) % لا كان هذا الدهر من متمرد % ماذا يلاقي الحر من أهواله % % 28(@)(@@) % سعد الشقي بعيشه في جهله % % وأخو الكمال معذب بكماله % % 29(@)(@@) % وأنا الذي قهر الزمان بصبره % % جلدا على الأرزاء من أنكاله % % 30(@)(@@) % ما زلت ندب الأكرمين وإن يكن % % قل الكريم الندب في أجياله % % PageV01P784 31(@)(@@) % لله در أبي جميل إنه % % 32(@)(@@) % % قصرت يد الآمال دون مناله % % 33(@)(@@) % لا تعدلن به الأنام بأسرها % % شتان بين تلوله وجباله % % 34(@)(@@) % فلك تدور به شموس مناقب % يشرقن بين جماله وجلاله % % 35(@)(@@) % فسل النجوم الزهر وهي طوالع % % هل كن غير خلاله وخصاله % % 36(@)(@@) % متوقل جبل الأبوة لم يزل 
ms251	 % % في القلة القعساء وطء نعاله % % 37(@)(@@) % فمضت عزائمه على آماله % % وقضت مكارمه على أمواله % % 38(@)(@@) % طود توقره الحلوم وباذخ % % لا يطمع الحدثان في زلزاله % % 39(@)(@@) % حسب المكارم أنه من أهلها % % من بعد أصحاب النبي وآله % % 40(@)(@@) % أصبحت أعذر من يتيه بمدحه % % عذر المليح بتيهه ودلاله % % PageV01P785 41(@)(@@) % فكأنما اغتبق القريض بذكره % % كأس الشمول ترقرقت بشماله % % 42(@)(@@) % يرتاح للجدوى فيطرب أن يرى % % وهاب غر المال قبل سؤاله % % 43(@)(@@) % وإذا نتقدت بني الزمان وجدته % % رجل الزمان وواحدا برجاله % % 44(@)(@@) % هو شرعة الظامي إذا الظما % % أظما ولم أفقد نمير زلاله % % 45(@)(@@) % وأنا الغريق من الجميل بزاخر % % يكفي القلي النزر من أوشاله % % 46(@)(@@) % في كل ليل حالك من حادث % % إني لمرتقب طلوع هلاله % % 47(@)(@@) % لا غرو أن أكفى به عن غيره % % هل كنت إلا من أقل عياله % % 48(@)(@@) % فكأنه للناس أجمعها أب % يحنو لرأفته على أطفاله % % 49(@)(@@) % ولقد أقول لمن أراد نضاله % % ما أنت يوم الروع من أبطاله % % 50(@)(@@) % في كل معترك لمشتجر القنا % % ضاقت فسيحات الخطا بمجاله % % PageV01P786 51(@)(@@) % كالعارض المنهل يوم نواله % % والصارم المنسل يوم نزاله % % 52(@)(@@) % بأبي الفؤول الفاعل القرم الذي % % تجنى ثمار الصدق من أقواله % % 53(@)(@@) % إني نعمت بجاهه وبماله % % تعس البخيل بجاهه وبماله % % 54(@)(@@) % شملتني الألطاف منه بساعة % % قبلت ظهر يمينه وشماله % % 55(@)(@@) % لا زال يقبل بالعطاء علي من % % أفضاله أبدا ومن إقباله % % 56(@)(@@) % متتابع النعماء جل مآربي % % فيه ومعظم ثروتي من ماله % % 57(@)(@@) % ومحملي بالفضل شكرا سرني % % أني أكون اليوم من حماله % % 58(@)(@@) % عقل القريض لسانه ذووه وإنما % % عرف الفتى من كان من أشكاله % % 59(@)(@@) % نسجت يداه من الثناء ملابسا % لا تنسج الدنيا على منواله % % PageV01P787 البحر : طويل 1(@)(@@) % لفقدان عبد الواحد الدمع قد جرى % % وأجرى نجيعا للمدامع أحمرا % % 2(@)(@@) % تذكرته من بعد حول فأذرفت % عليه جفوني حسرة وتذكرا % % 3(@)(@@) % فكفكفت من عيني بوادر عبرة % % وما خلتها لولاه أن تتحدرا % % 4(@)(@@) % أقام علي العيد في النحر مأتما % % وأظهر ما قد كان في القلب مضمرا % % 5(@)(@@) % لئن غيبوه في التراب وأظلمت % معالم 
ms252	 كانت تفضح الصبح مسفرا % % 6(@)(@@) % فما أغمدوا في الترب إلا مهندا % % ولا حملوا في النعش إلا غضنفرا % % 7(@)(@@) % أصبنا وأيم الله كل مصيبة % % بأروع أبكى الأجنبين ولا مرا % % 8(@)(@@) % فيا لك من رزء أصاب وحادث % % ألم وخطب في الجلاميد أثرا % % 9(@)(@@) % تفقدت منه وابل القطر ممطرا % وفارقت منه طلعة البدر نيرا % % 10(@)(@@) % وما كان أبهى منه في الناس منظرا % ولا كان أزكى منه في الناس مخبرا % % PageV01P788 11(@)(@@) % أفي كل يوم للمنايا رزية % % تكاد لها الأكباد أن تتفطرا % % 12(@)(@@) % تهيج أحزانا وتبعث زفرة % وترسل في فقد الأحبة منذرا % % 13(@)(@@) % تكدر أخوان الصفا في نبعاثها % % وأي صفاء لامرىء ما تكدرا % % 14(@)(@@) % أجل مصاب الدهر فقدك ماجدا % ودفنك أجداث الأكارم في الثرى % % 15(@)(@@) % وقولك مات الأكرمون فلم نجد % زعيما إذا ما أورد الأمر أصدر % % 16(@)(@@) % وما حيلة الإنسان فيما ينوبه % % إذا كان أمر الله فيه مقدرا % % 17(@)(@@) % وهبك تقيت الرزء حيث أريته % % فكيف بمن يأتيك من حيث لا ترى % % 18(@)(@@) % ونحن مع المقدور نجري إلى مدى % % وليس لنا في الأمر أن نتخيرا % % 19(@)(@@) % إذا لم تمتع بالبقاء حياتنا % % فلا خير في هذي الحياة التي نرى % % 20(@)(@@) % على ذاهب منا برغم أنوفنا % % نعالج حزنا أو نموت فتعذر % % PageV01P789 21(@)(@@) % وما أنا بالناسي صنعائه التي % % تذكرنيه كل آن تذكرا % % 22(@)(@@) % فأثني عليه الخير حيا وميتا % وأشكره ما دمت حيا مذكرا % % 23(@)(@@) % وإني متى صوعت طيب ثنائه % % فتقت به مسكا وأشممت عنبرا % % 24(@)(@@) % تبارك من أنشاك يا ابن مبارك % % جميلا من المعروف لن يتنكرا % % 25(@)(@@) % وما زلت حتى ختارك الله طاهرا % فكنت كماء المزن عذبا مطهرا % % 26(@)(@@) % إلى رحمة الرحمن والفوز بالرضا % % سبقت وما أسبقت فينا التصبرا % % 27(@)(@@) % وما كان بالصبر الجميل تمسكي % % ألا إن ذاك الصبر منفصم العرى % % 28(@)(@@) % كفى المرء في الأيام موعظة بها % % وتبصرة فيها لمن قد تبصرا % % 29(@)(@@) % ولا بد أن تلقى المنون نفوسنا % % ولو أننا عشنا زمانا وأعصرا % % 30(@)(@@) % وإن الليالي لم تزل بمرورها % % تسل علينا بالأهلة خنجرا % % PageV01P790 31(@)(@@) % أتطمعنا آمالنا ببقائنا 
ms253	 % % بكل حديث ما هنالك مفترى % % 32(@)(@@) % وإن المنايا لا أبا لك لم تدع % من الناس سربا ما أربع وأذعرا % % 33(@)(@@) % أغارت على الأقيال من آل حمير % وجاءت على كسرى الملوك وقصيرا % % 34(@)(@@) % فما منعت عنها حصون منيعة % ولا كشفت من فادح الخطب ما عرا % % 35(@)(@@) % لئن غاب عن أبصارنا بوفاته % % فما زالك في الأفكار منا مصورا % % 36(@)(@@) % فقدناك فقدان الزلال على الظما % % فلا منهل إلا ومورده جرى % % 37(@)(@@) % ألا في سبيل الله ما كنت صانعا % من البر والمعروف في سائر الورى % % 38(@)(@@) % وكنت لوجه الله تشبع جائعا % وتطعم مسكينا وتكسو لمن عرى % % 39(@)(@@) % وإني لأستسقي لك الله وابلا % متى استمطر الصادي عزاليه أمطرا % % 40(@)(@@) % يصوب على قبر يضمك لحده % % ويسطع مسكا من أريجك أذفرا % % PageV01P791 41(@)(@@) % سقاك الحيا المنهل كل عشية % % ورواك من قطر الغمام مبكرا % % 42(@)(@@) % فقد كنت للظمآن أعذب منهل % % وقد كنت غيثا بالمكارم ممطرا % % 43(@)(@@) % وقد كان فيك الشعر ينفق سوقه % % لديك ويبتاع الثناء ويشترى % % 44(@)(@@) % وقد ساءني أن أصبح الفضل كاسدا % وأصبح مغنى الجود بعدك مقفرا % % 45(@)(@@) % وقد خمدت نار القرى دون طارق % % فلا جود لجدوى ولا نار للقرى % % 46(@)(@@) % وغودر ساري الحمد في كل مهمه % % من الأرض مصروف العنان عن السرى % % 47(@)(@@) % فلا أخصبت أرض الخصيب ولا زهى % % بها الربع مأنوسا ولا الروض مزهرا % % 48(@)(@@) % لقد كان صبحي من جبينك واضحا % وقد كان ليلي من محياك مقمرا % % 49(@)(@@) % فيا ليت شعري والحوادث جمة % % ويا ليتني أدري ومن ذا الذي درى % % 50(@)(@@) % محاسن ذاك العصر كيف تبدلت % ورونق ذاك الحسن كيف تغيرا % % PageV01P792 51(@)(@@) % وكانت لك الأيدي طوالا إلى العلى % % تناول مجدا في المعالي ومفخرا % % 52(@)(@@) % فكم راغب فيها وكم طامع بها % % أمد لها الباع الطويل فقصرا % % 53(@)(@@) % ومن مكرمات تملك الحر رقة % تطوق من أيديك يدا ومنحرا % 54(@)(@@) % ومن حسنات تخلق الدهر جدة % كتبت بها في جبهته المجد أسطرا % % 55(@)(@@) % وكم معسر بدلت بالعسر يسره % % وما زلت للفعل الجميل ميسرا % % 56(@)(@@) % ولو كانت الأنصار تنجي من الردى 
ms254	 % % نصرناك إذا وافاك نصرا مؤزرا % % 57(@)(@@) % فكم مقلة أذرت عليك دموعها % % ومهجة صاد أوشكت أن تسعرا % % 58(@)(@@) % وكم كبد حرى يحرقها الأسى % % تكاد على ذاكراك أن تتفطرا % % 59(@)(@@) % وليلة تذكيني بذكرك زفرة % % حرام على عيني بها سنة الكرى % % 60(@)(@@) % عليك سلام الله ما حج محرم % وهلل في تلك البقاع وكبرا % % PageV01P793 البحر : رمل تام 1(@)(@@) % من لصب في هواكم مستهام % دنف نهب ولوع وغرام % 2(@)(@@) % فعلى خدي ما تسقي الحيا % % وعلى جسمي ثوب من سقام % % 3(@)(@@) % فسقاكم غدقا من أدمعي % % مستهل القطر منهل الغمام % % 4(@)(@@) % عبرات لم أزل أهرقها % % أو بيل الدمع شيئا من أوامي % % 5(@)(@@) % زفرة رددتها ف ضطرمت % في حشا الصب أشد الاضطرام % % 6(@)(@@) % هل علمتم بعدما قوضتم % أن لي من بعدكم نوح الحمام % % 7(@)(@@) % فارقت عيناي منكم أوجها % أسفرت عن طلعة البدر التمام % % 8(@)(@@) % في عذاب الوجد ما أبقيتم % من فؤادي في غرام وهيام % % 9(@)(@@) % مهجة ذاهبة فيكم وما % % ذهبت يوم نواكم بسلام % % 10(@)(@@) % عرضت واعترض الوجد لها % % ورماها من رماة السرب رام % PageV01P794 11(@)(@@) % قل لمن سدد نحوي سهمه % % من أحل الصيد في الشهر الحرام % 12(@)(@@) % طالما مر بنا ذكركم % فتثنى كل ممشوق القوام % % 13(@)(@@) % وبما أتحف منأخباركم % % ربما ستغنيت عن كل مدام % % 14(@)(@@) % أو كانت عنكم ريح الصبا % % نسمت بين خزامى وثمام % % 15(@)(@@) % أين ذاك العهد في ذاك الحمى % % والوجوه الغر في تلك الخيام % % 16(@)(@@) % إن أيامي في وادي الغضا % % لم تكن غير خيال في منام % % 17(@)(@@) % من معير لي منها زمنا % يرجع الشيخ إلى سن الغلام % % 18(@)(@@) % وأحباء كأن لم يأخذوا % % من أبيات المعالي بخطام % % 19(@)(@@) % فرقت شملهم صرف النوى % % ورمتهم بعواديها المرامي % % 20(@)(@@) % ولقد طالت عليهم حسرتي % % ف قصرا إن تنصفاني من ملام % % PageV01P795 21(@)(@@) % لست أنسى العيش صفوا والهوى % % رائقا والكأس نارا في ضرام % % 22(@)(@@) % بين ندمان كأن قد أصبحوا % % من خطوب الدهر طرا في ذمام % % 23(@)(@@) % ينثر اللؤلؤ من ألفاظهم % % فترى من نثرهم حسن النظام % % 24(@)(@@) % تفعل الراح بهم ما فعلت % % هذه الدنيا بأبناء 
ms255	 الكرام % % 25(@)(@@) % إنما كانت علاقات هوى % % أصبحت بعد تصال ب نصرام % % 26(@)(@@) % و نقضى العهد وأيام الصبا % % أدفلت من بعد إجفال النعام % % 27(@)(@@) % أسفا للشعر لا حظ له % % في زمان الجهل والقوم اللئام % % 28(@)(@@) % فلقوم حلية يزهو بها % % ولأقوام سمام كالسهام % % 29(@)(@@) % والقوافي إن تصادف أهلها % % نسجمت في مدحهم أي نسجام % % 30(@)(@@) % وقوافي التي أنزلتها % % من علي القدر في أعلى مقام % % PageV01P796 31(@)(@@) % أبلج من هاشم لأوضح من % % وضح الصبح بدا بادي اللثام % % 32(@)(@@) % إن يجد كان سحابا ممطرا % أو سطا كان عزيزا ذا انتقام % % 33(@)(@@) % يعلم الوارد من تياره % % أي بحر ذا من الأبحار طامي % % 34(@)(@@) % يا لقوم أرهبوا أو أرغبوا % % من كرام بحسام أو حطام % % 35(@)(@@) % فهم الأشراف أشرف الورى % % وهم السادات سادات الأنام % % 36(@)(@@) % هم ملاذ الخلق في الدنيا وهم % % شفعاء الخلق في يوم القيام % % 37(@)(@@) % نشأوا في طاعة الله فمن % % قائم بالقسط أو حبر همام % % 37(@)(@@) % رضعوا در أفاويق العلى % % وغذوا بالفضل من بعد انفطام % % 38(@)(@@) % وإذا ما أرهفوا بيض الظبا % % أغمدوها في الوغى في كل هام % % 39(@)(@@) % بأكف من أياديهم هوامي % % وسيوف من أعاديهم دوامي % % PageV01P797 40(@)(@@) % ظلت أروي خبرا عن بأسهم % % عن سنان الرمح عن حد الحسام % % 41(@)(@@) % وإذا كانت سماوات العلى % % فهم منها سواريها السوامي % % 42(@)(@@) % يا ربيع الفضل فضلا وندى % وحياة الجود في الموت الزؤام % % 43(@)(@@) % أنت للرائد روض أنف % وزلال المنهل العذب لظامي % % 44(@)(@@) % فإذا رمت بلالا لصدى % ما تعداك إلى الماء مرامي % % 45(@)(@@) % يا شبيه الشمس في رأد الضحى % % ونظير البدر في جنح الظلام % % 46(@)(@@) % لم يزدني الشكر إلا نعمة % % قرنت منك علينا بالدوام % % 47(@)(@@) % نبهت لي أعين الحظ التي % % لم تكن يومئذ غير نيام % % 48(@)(@@) % بسطت أيديك لي واقتطفت % بيد الإحسان أزهار الكلام % % 49(@)(@@) % قد تجهمنا سحابا لم تكن % % منك والخيبة ، ترجى بالجهام % % PageV01P798 50(@)(@@) % فثناء بالذي نعرفه % % و متداح ب فتتاح و ختتام % % 51(@)(@@) % عادك العيد ولا زلت به % % بعدما قد فزت في أجر الصيام % % 52(@)(@@) % فابق واسلم للعلى ما بقيت 
ms256	 % % سيدي أنت ودم في كل عام % % PageV01P799 البحر : طويل 1(@)(@@) % أتذكر دون الجزع بالخيف أربعا % % ولعت بها والصب لا زال مولعا % % 2(@)(@@) % تعاورها صرف الزمان فأصبحت % % معالمها بعد الأوانس بلقعا % % 3(@)(@@) % تخال قلوب العاشقين بأرضها % % طيورا على نهل من الماء وقعا % % 4(@)(@@) % معالم تستقي السحاب رسومها % % فتسقى حيا وبلين قطرا وأدمعا % % 5(@)(@@) % منازلنا من دار سلع ولعلع % % سقى الله صوب المزن سلعا ولعلعا % % 6(@)(@@) % لئن كنت قد أصبحت مبكى ومجزعا % فقد كنت باللذات مرأى ومسمعا % % 7(@)(@@) % تذكرت أيامي بمنعرج اللوى % % وقولي هات الكأس يا سعد مترعا % % 8(@)(@@) % تدور الغواني بيننا بمدامة % % تخيلتها في الكأس نورا مشعشعا % % 9(@)(@@) % لقد أقلعت أيامنا بعد رامة % % كما أجفل الغيث الملث وأقلعا % % 10(@)(@@) % وما أخلفت إلا فؤادا ولوعة % % هما أسقما هذا الفؤاد وأوجعا % % PageV01P800 11(@)(@@) % وذا عبرة نوصولة وحشاشة % تكاد من الأشواق أن تتقطعا % % 12(@)(@@) % رعى الله من لم يرع عهدا لمغرم % % رعيت له الود القديم كما رعى % % 13(@)(@@) % تناءى فشيعت اصطبارا ومهجة % % ولولا النوى تنأى به ما تشيعا % % 14(@)(@@) % ولم تر من صب فؤادا مودعا % إلى أن ترى يوما حبيبا مودعا % % 15(@)(@@) % خليلي إن لم تسعداني فهاتيا % % ملامكما لي في الصبابة أو دعا % % 16(@)(@@) % بعثتم إلى جسمي الضنى يوم بنتم % % وزدتم إلى قلبي حنينا مرجعا % % 17(@)(@@) % وفتشت قلبي في هواكم فلم أجد % % لغير هواكم في الحشاشة موضعا % % 18(@)(@@) % رأيت به سر النبوة مودعا % % ولكنني لم أبق في القوس منزعا % % 19(@)(@@) % متى تنظر العينان من بعد فقدها % % بذات الغضا ذاك الغزال المقنعا % % 20(@)(@@) % فيا ليت شعري في الأبيرق بارق % فأغدو به العيش صفوا ممتعا % % PageV01P801 21(@)(@@) % ويا ليت من أهواه في الحب حافظ % % من العهد ما قد كان بالأمس ضيعا % % 22(@)(@@) % إلى كم أعاني دمع جفن مقرح % وقلبا بأعباء الهموم مروعا % % 23(@)(@@) % وأصبر في اللأواء حتى كأنني % % وجدت صطباري في الحوادث أنفعا % % 24(@)(@@) % رميت بأرزاء من الدهر تسوؤني % % مخافة يا لمياء أن يتوجعا % % 25(@)(@@) % ومن مضض الأيام مدحي عصابة % % بذلت يدا فيهم وما نلت إصبعا % % 26(@)(@@) % كأني إذا 
ms257	 أدعوهم لملمة % % أخاطب موتى راقدين وهجعا % % 27(@)(@@) % وهل تسمع الصم الدعاء وترتجى % % موارد لا تفنى من الآل لمعا % % 28(@)(@@) % وحسبي شهاب الدين وهو أبو الثنا % % ملاذا إذا ناب الزمان ومرجعا % % 29(@)(@@) % متى ما دعا الداعي معاليه للندى % % أجابض إلى الحسنى بدارا وأسرعا % % 30(@)(@@) % وابلج وضاح الجبين تخاله % % تبلج صبح أو بصبح تبرقعا % % PageV01P802 31(@)(@@) % ولما بدا نور النبي بوجهه % % رأيت به سر النبوة نودعا % % 32(@)(@@) % له الكلمات الجامعات تخالها % % نجوما بآفاق البلاغة طلعا % % 33(@)(@@) % وإن كتبت أقلامه فحمائم % % ثبت إلى السمع الكلام المسجعا % % 34(@)(@@) % وكتب لدين االله أضحت مطالعا % كما كانت الأفلاك للشمس مطلعا % % 35(@)(@@) % إذا ضلت الأفهام عن فهم مشكل % % هدى وعليه في الحقيقة أطلعا % % 36(@)(@@) % وإن قال قولا فهو لا شك فاعل % % قؤول من الأمجاد إن قال أبدعا % % 37(@)(@@) % كلام ترى الأقلام في الطرس سجدا % له وترى أهل الفصاحة ركعا % % 38(@)(@@) % يحير ألباب الرجال كأنما % % أتانا بإعجاز من القول مصقعا % % 39(@)(@@) % سعى طالبا بالعلم أبعد مطلب % % وفي الله مسعاه ولله ما سعى % % 40(@)(@@) % دعا فأتى ولو أن غيره % % دعاه إليه مرة لتمنعا % % PageV01P803 41(@)(@@) % وأدرع لم يتفذ به سهم قادح % % كأن عليه سابغات وأدرعا % % 42(@)(@@) % إذا باحث الخصم الألد أعاده % % بعرنين مخذول من الذل أجدعا % % 43(@)(@@) % وذي همم تفري الخطوب كأنما % % يجردها بيضا على الخطب قطعا % % 44(@)(@@) % حريص على أن يقتنيها محامدا % أحاديثها تبقى حسانا لمن وعى % % 45(@)(@@) % سبقت جميع الطالبين إلى التي % % غدت دونها الآمال حسرى وظلعا % % 46(@)(@@) % لقد ملأ الأقطار فضلك كلها % % ونادى إليه المادحين فأسمعا % % 47(@)(@@) % ومهما دعى ذو النقد أنك واحد % فما أنت إلا في الأنام كما ادعى % % 48(@)(@@) % وإن مدت الأبواع في طلب العلى % % مددت إلى العلياء بوعا وأذرعا % % 49(@)(@@) % فإنك في هذا الطريق الذي به % % سلكت طريقا أعجز الناس مسبعا % % 50(@)(@@) % أرى مدحك العالي علي فريضة % وغيرك لم أمدحه إلا تطوعا % % PageV01P804 51(@)(@@) % علي لك الفضل الذي هو شاملي % % وإنك قد حزت الفضائل أجمعا % % 52(@)(@@) % وما ظفرت كف الليالي من الورى % % بأرغب مني في نداك 
ms258	 وأطمعا % % 53(@)(@@) % وإني إذا ضاق الخناق لحادث % % ترفعت إلا عن نداك ترفعا % % 54(@)(@@) % ولم أر أندى منك في الناس راحة % وأمرى نوالا من يديك وأمرعا % % PageV01P805 البحر : طويل 1(@)(@@) % وفظ غليظ القلب أيقنت أنه % % على النفس ما شيء أشد من الغض % 2(@)(@@) % تعرفني في حاله الناس كلها % % وإني لأدرى الناس في لؤمه المحض % % 3(@)(@@) % وقالوا لقد دس الخبيث بلفظه % % غداة عرضت الشعر من عرض العرض % % 4(@)(@@) % دسائس لا تدري اليهود بعشرها % % دعته طباع السوء للنهش والعض % % 5(@)(@@) % يهون لدغ العقربان بلدغه % % ولا شك بعض الشر أهون من بعض % % 6(@)(@@) % إذا ما رأته العين أيقنت أنه % % تخلق من حقد وصور من بغض % % 7(@)(@@) % وقالوا قضى في مدحك الحمد والغنى % % فقلت لبئس الحكم يقضي ولم تقضي % % 8(@)(@@) % أمن كل بيت يبتغي المال راجيا % ويحسب أن الجود بالطول والعرض % % 9(@)(@@) % وينسبه للبخل وهو أبو الثنا % % وأكرم من يمشي يمينا على الأرض % % 10(@)(@@) % وهب أنني أرجو فيوضات ماله % % أعار على من يطلب البحر للفيض % % PageV01P806 11(@)(@@) % أمثل شهاب الدين لا يرتجى لها % % وما نقبضت منه اليدان على القبض % % 12(@)(@@) % وما كان مدحي لا وربي لنيله % % ولكن رأيت الشكر من جملة الفرض % % 13(@)(@@) % لقد كدت من بغضي له ولاسمه % % أزيغ عن الدين الحنيفي للرفض % % 14(@)(@@) % يعيب ابن رمضان المديح لأهله % % يحط قذاة العين في وسط الروض % % 15(@)(@@) % إذا كان نظم الشعر مني فضيلة % % فتبا لفضل يورث النقص في عرضي % % PageV01P807 البحر : رمل تام 1(@)(@@) % أحمد الله بك الحال التي % % أسعد التوفيق فيها ليس يبخس % % 2(@)(@@) % مات من قد كنت أرجو موته % % فهو ميت هالك لا يتنفس % % 3(@)(@@) % وأحق الناس في ميراثه % % أخرس يطمع في ميراث أخرس % % PageV01P808 البحر : طويل 1(@)(@@) % بخلت وما طرفي عليك بخيل % ورب نوال لا يراه منيل % 2(@)(@@) % وحرمت أن يروى بريقك ظامىء % % فليس إلى ماء العذيب سبيل % % 3(@)(@@) % وأظلم من يجني على الصب في الهوى % % ملي لوى دين الغرام مطول % % 4(@)(@@) % ويا كثر ما نولت بالوعد نائلا % وإن كثير الغانيات قليل % % 5(@)(@@) % أعيدي إلى عيني 
ms259	 يا مي نظرة % % يبل بها من عاشقيك غليل % % 6(@)(@@) % وجودي بطيف منك قد حال بينه % % وبيني حزون للنوى وسهول % % 7(@)(@@) % فعندي إلى ذاك الخيال الذي سرى % % هوى يستميل الشوق حيث يميل % % 8(@)(@@) % وليل كحظي في هواك سهرته % % فطال وليل العاشقين طويل % % 9(@)(@@) % يؤرقني فيه تألق بارق % كما استل ماضي الشفرتين صقيل % % 10(@)(@@) % بداج كثير الشهب تحسب أنها % % تقطع زنجي الظلام نصول % % PageV01P809 11(@)(@@) % يذكرني تبسامك البرق موهنا % فللدمع منه سائل ومسيل % % 12(@)(@@) % أراني علامات الورود وميضه % % ومالي إليه يا أميم وصول % % 13(@)(@@) % وما ينفع الظامي صداه بنظرة % % إلى الماء ما منه لديه حصول % % 14(@)(@@) % خليلي هل يودى دم قد أطله % % بمقلته أحوى أغن كحيل % % 15(@)(@@) % رماني بعينيه غزال له الحشى % % على النأي لا ظل الأراك مقيل % % 16(@)(@@) % عشية أودى بي الهوى وأرابني % % من الركب إذ حث المطي رحيل % % 17(@)(@@) % برغمي فارقت الذين أحبهم % % فلي أنة من بعدهم وعويل % % 18(@)(@@) % وما تركوا إلا بقية عبرة % % يرقرقها وجدي بهم فتسيل % % 19(@)(@@) % تذيل دموعا في الديار أريقها % % نجوم لها في الغاربين أفول % 20(@)(@@) % غداة وقفنا والنياق كأنها % % مرزأة مما تحن ثكول % % PageV01P810 21(@)(@@) % فأنكرت أطلالا لمي غرفتها % % وإني على علمي بها لجهول % % 22(@)(@@) % نسيم الصبا ذكرتني نشوة الصبا % % فهل أنت من ليلى الغداة رسول % % 23(@)(@@) % تنسمت معتلا فلم أدر أينا % % بظل نسيمات الغوير عليل % % 24(@)(@@) % متى أترك النوق الهجان كأنها % % لها كلما ضل الدليل دليل % % 25(@)(@@) % واتخذ البيد القفار أخلة % ولكن روضي بالعراق محيل % % 26(@)(@@) % ولو كنت ممن يشرب الماء بالقذى % % رويت وفي ري الذليل غليل % % 27(@)(@@) % عن الناس في عبد الغني لي الغنى % % وكل صنيع ابن الجميل جميل % % 28(@)(@@) % كريم فأما العيش في مثل ظله % % فرغد وأما ظله فظليل % % 29(@)(@@) % قريب إلى الحسنى فلم ير مثله % % سريع إلى الفعل الجميل عجول % % 30(@)(@@) % من الصيد سباق المقال بفعله % % وقل قؤول في الأنام فعول % % PageV01P811 31(@)(@@) % سأنزل آمالي بساحة باسل % وما ضيم يوما في حماه نزيل % % 32(@)(@@) % به افتخرت بغداد وانسحبت لها % % من الفخر في قطر العراق 
ms260	 ذيول % % 33(@)(@@) % علاقته بالمجد مذ كان يافعا % علاقة صب ما ثناه عذول % % 34(@)(@@) % غذته به أم المعالي لبانها % % وطابت فروع قد زكت وأصول % % 35(@)(@@) % فما اقتحم الأهوال إلا خطيرة % تجل ، وما يلقى الجليل جليل % % 36(@)(@@) % ولا راعه روع فلانت قناته % % فلا مس هاتيك القناة ذيول % % 37(@)(@@) % أرى كل ضراء شكوناه ضرها % % يزايلها في بأسه فتزول % % 38(@)(@@) % على ما به من شدة البأس لم يزل % % يذوب علينا رقة ويسيل % % 39(@)(@@) % ترق لنا تلك الشمائل مثلما % % ترق شمال أو تروق شمول % % 40(@)(@@) % يحن إلى يوم يثير غباره % % صليل كما تهوى العلى وصهيل % % PageV01P812 41(@)(@@) % يدير رحاها حيث دارت مثارة % % شروب لأبطال الرجال أكول % % 42(@)(@@) % إذا صعبت دهياء في الأمر قادها % % بأمر مطاع الأمر وهي ذلول % % 43(@)(@@) % يقينا صروف النائبات كانه % % لنا جبل والعالمين تلول % % 44(@)(@@) % ولولاه لم يخمد من الشر ناره % % ولا سال للباغي النوال سيول % % 45(@)(@@) % لك الله أما أنت فالخير كله % % وأنت به لي ضامن وكفيل % % 46(@)(@@) % أنلت بما نولت كل مؤمل % فعلمت صوب المزن كيف ينيل % % 47(@)(@@) % وإنا على يأس الندى ورجائه % % لنا منك رجاف العشي هطول % % 48(@)(@@) % وما فيك ما تعطي ملالا ولا قلى % وغيرك إن سيم العطاء ملول % % 49(@)(@@) % ولم تتحول عن خلائقك التي % % جبلت عليها والزمان يحيل % % 50(@)(@@) % فيا ليت شعري والخطوب ملمة % وما بك عني في الخطوب غفول % % PageV01P813 51(@)(@@) % إلام أحث الجد والجد عاثر % % وأرهف حد العزم وهو كليل % % 52(@)(@@) % وأطلب في زعمي من الدهر حاجة % زماني بها حاشا علاك بخيل % % 53(@)(@@) % وكيف يريني الدهر ما استحقه % % وفضلي لدى هذا الزمان فضول % % 54(@)(@@) % إذا نهضت بي همة قعدت بها % % على مضض فيما أراه خمول % % 55(@)(@@) % وعندي قواف لا يدنس عرضها % % لئيم ولا يشقى بهن نبيل % % 56(@)(@@) % ظوامئ يطلبن الرواء بمهمه % تطوف على أكفائها وتجول % % 57(@)(@@) % تجنبت لاقوم اللئام فلم تبل % % أعان معين أم أراب خذول % % 58(@)(@@) % متى اعترضهم بالأماني ضلة % ثناها وجيف عنهم وذميل % % 59(@)(@@) % فما أولع الأيام في جهلائها % % وفي الناس أشباه لها وشكول % % 60 