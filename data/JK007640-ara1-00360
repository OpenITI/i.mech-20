ms341	(@)(@@) % إذا لم تكن أنت أهلا لها % % من الأنجبين فمن ذا لها % % 48(@)(@@) % فقد نلت ما لم ينله سواك % % فضائل نشكر أفضالها % % 49(@)(@@) % كلامك يشفي صدور الرجال % % ويرضي الملوك وعمالها % % 50(@)(@@) % وحيث أخلت بها خلة % سددت برأيك إخلالها % % PageV01P1076 51(@)(@@) % وكم يد لك في الصالحات % % سبقت من البر أمثالها % % 52(@)(@@) % وإن أغلقت بابها المكرمات % % فإنك تفتح أقفالها % % PageV01P1077 البحر : طويل 1(@)(@@) % إذا كان خصمي حاكمي كيف أصنع % لمن أشتكي حالي لمن أتوجع % 2(@)(@@) % غرامي غريمي وهو لا شك قاتلي % % وكم ذل من يهوى غراما ويخضع % % 3(@)(@@) % أباح دمي بين الورى من أحبه % % فقلت وقلبي بالهوى يتقطع % % 4(@)(@@) % دموعي شهود أن قلبي يحبه % % وحق الهوى عن حبه لست أرجع % % 5(@)(@@) % وراموا سلوي في هواه عواذلي % % وحق هواه لست أصغي وأسمع % % 6(@)(@@) % أنا المغروم المقيم على الهوى % % وفي حبه نموا الوشاة وشنعوا % % 7(@)(@@) % وقالوا الفتى في الحب لا شك هالك % % فقلت دعوه كيفما شاء يصنع % % 8(@)(@@) % ولو علموا ما بين من الوجد والأسى % % لرقوا لحالي في الهوى وتوجعوا % % 9(@)(@@) % سقاني سحيرا من حميا شرابه % % فطبت وكأسي بالمدامة مترع % % 10(@)(@@) % ومن نشوتي باحت من الوجد عبرتي % % بما في فؤادي والحشا متولع % % PageV01P1078 11(@)(@@) % وأصبحت كالمجنون في حي عامر % بليلي ومن وجدي أهيم وأولع % % 12(@)(@@) % فلو زاروني بالنوم طيف خياله % % لكنت بطيف منه أرضى وأقنع % % PageV01P1079 البحر : طويل 1(@)(@@) % متى ترني يا سعد والشوق مزعجي % % بما هيج التذكار من لاعج الوجد % 2(@)(@@) % أحث إلى نجد مطايا كأنها % % لها قلب مفؤود الفؤاد إلى نجد % % 3(@)(@@) % سوابح يطوين الفدافد بالخطا % % ومسرجة جرد لواعب بالأيدي % % 4(@)(@@) % تمل من الدار التي قد ثوت به % % ولكنها ليست تمل من الوخد % % 5(@)(@@) % إذا ستنشفت أرواح نجد أهاجها % % جوى هاج من مستنشق الشيح والرند % % 6(@)(@@) % لعلي أرى يا عين أحبابنا الألى % % وإن أعقبت تلك التواصل بالصد % % 7(@)(@@) % فمن مبلغ الأحباب عني تحية % تنبئهم أني على ذلك العهد % % 8(@)(@@) % إذا ذكرتهم نفس صب مشوقة % % رمتها صروف البين بالنأي والبعد % % 9(@)(@@) % توقدت النار التي في جوانحي % % إلى ساكني 
ms342	 وادي الغضا أيما وقد % % 10(@)(@@) % فيا ليت في الحب صبر أحبتي % % وعند أحبائي من الشوق ما عندي % % PageV01P1080 11(@)(@@) % ذكرتكم والدمع ينثر نظمه % % لعمركم نظم الجمان من العقد % % 12(@)(@@) % وإني لأستجدي من العين ماءها % % على قربنا منكم وإن كان لا يجدي % % 13(@)(@@) % وأكتم عن صحبي غرامي وربما % % لأظهره بالدمع بين بني ودي % % 14(@)(@@) % ومن أين تخفى لوعة قد كتمتها % % محاذرة الواشي وبالرغم ما أبدي % % 15(@)(@@) % وقد قرأ الواشون سطري صبابة % % بما كتبت تلك الدموع على خدي % % 16(@)(@@) % فخذ من عيوني ما يدل على الجوى % % ومن حر أنفاسي دليلا على الوجد % % PageV01P1081 البحر : خفيف تام 1(@)(@@) % هكذا كان فعلها الحمقاء % ربما تحلق اللحى الكيمياء % 2(@)(@@) % أفكان الإكسير والشعر والبعر % وهذي المقالة الشنعاء % % 3(@)(@@) % كان عهدي به ولا لحية ال % % تيس وفي حلقها يقل الجزاء % % 4(@)(@@) % ليت شعري أريق ماء عليها % % قبل هذا أم ليس ثمة ماء % % 5(@)(@@) % لم يعان الزرنيخ وهو لعمري % % فيه للداء في الذقون دواء % % 6(@)(@@) % ذهب الشعر والشعور وأمسى % % يتخفى ومشيه ستحياء % % 7(@)(@@) % وادعى أنه أصيب بداء % صدق القول إنما الحلق داء % % 8(@)(@@) % أي داء إذ ذاك أعظم منه % % والمجانين عنده حكماء % % 9(@)(@@) % وترجى للحلق أمرا محالا % ولقد خاب ظنه ولارجاء % % 10(@)(@@) % ما سمعنا اللحى بها حجر ال % % وفي الدبر توضع الأجزاء % % PageV01P1082 11(@)(@@) % زاعما أنهم أشاروا إليها % % ولهذا جرى عليها القضاء % % 12(@)(@@) % أخذ العلم عن حقير فقير % % هو والسارح البهيم سواء % % 13(@)(@@) % طلب السعد بالشقاء وهيهات % % مع الجهل تسعد الشقياء % % 14(@)(@@) % ذهبت لحية المريد ضياعا % وعليها بعد الضياع العفاء % % 15(@)(@@) % ليته صانها ولو بضراط % ولقد يعقب الضراط الفساء % % 16(@)(@@) % لم يدع شعرة وقد قيل أرخ % حلقت شعر لحيتي الكيمياء % % PageV01P1083 البحر : كامل تام 1(@)(@@) % مالي أفارق كل يوم صاحبا % صدعت به ريب المنون صفاتا % % 2(@)(@@) % وأرى أحبائي تفرق جمعهم % % وتشتتوا بيد الردى أشتاتا % % 3(@)(@@) % وخلت ديار الأكرمين وأصبحت % فيها عظام الأنجبين رفاتا % % 4(@)(@@) % ودعى التقى ناع يخفض نعيه % % منا الرؤوس ويرفع الأصواتا % % 5(@)(@@) % ولقد أصم مسامعي بعدك والتقى % % و نبت حبل 
ms343	 الآملين بتاتا % % 6(@)(@@) % يا أطيب القوم الذين ألفتهم % % في الناجبين خلائقا وذواتا % 7(@)(@@) % لو كنت أدرك بالأسى ما فاتني % % قد كنت أدرك بالأسى ما فاتا % % 8(@)(@@) % ولقد سئمت من الحياة وملني % % طول الثواء فلا أريد حياتا % % 9(@)(@@) % من بعد ما زال الأمين وأنه % % كان الجبال الراسيات ثباتا % % 10(@)(@@) % وفقدت منه فرائدا وفوائدا % ومكارما ومغانما وهباتا % PageV01P1084 11(@)(@@) % ونظرت في الأحياء نظرة عارف % من بعده فوجدتها أمواتا % % PageV01P1085 البحر : بسيط تام 1(@)(@@) % ما مات من بعد عبد الواحد الجود % وفي بنيه النجيب الشهم محمود % 2(@)(@@) % ولا فقدنا من الدنيا مكارمه % % وفي ذراريه ذاك الفضل موجود % % 3(@)(@@) % والفرع كالأصل إن تزك مغارسه % % زكا وأثمر في أوراقه العود % % 4(@)(@@) % لا ينزع الله هذا السر من رجل % % فيه السعادة والمسعود مسعود % % 5(@)(@@) % قد بارك الله في آل المبارك مذ % % كانوا فمولودهم للخير مولود % % 6(@)(@@) % مطهرون فلا رجس بدنسهم % % وأنت ظل إليه اليوم ممدود % % 7(@)(@@) % تأوي إليهم بنو الحاجات راغبة % % والمنهل العذب بين الناس مورود % % 8(@)(@@) % وما أرى غيرهم فيمن يناظرهم % % من يسأل الخير أو تطوى له البيد % % 9(@)(@@) % نزلت فيهم على رحب أسر به % % ولي بهم أمل بالبر موعود % % 10(@)(@@) % إن طوقوني بطوق من مكارمهم % % فإنهم وثنائي الطوق والجيد % % PageV01P1086 11(@)(@@) % تزان غر القوافي كلما ذكروا % % بما تزان وتزهو الخرد الغيد % % 12(@)(@@) % يا من إذا عدت الأنجاب حينئذ % % فأول الناس في الأنجاب معدود % % 13(@)(@@) % يا ابن الذي كنت أرجوه وأمدحه % % وشاهد لي أياديه ومشهود % % 14(@)(@@) % ولا يرد مقالي في مدائحه % % وفي الأقاويل مقبول ومردود % % 16(@)(@@) % % فكل فعلك يا محمود محمود % 18(@)(@@) % أغظت كل حسود أنت تعرفه % % وكل ذي نعمة لا شك محسود % % 19(@)(@@) % الله أبقاك عمن قد مضى خلفا % ولي بمدحك تغريد وترديد % % 20(@)(@@) % وعشت بالأنس طول الدهر في رغد % % ولا يسؤوك طول الدهر تنكيد % % PageV01P1087 البحر : رجز تام 1(@)(@@) % في كل يوم للمنون صولة % فينا وخطب بالفراق فادح % 2(@)(@@) % وزفرة موصولة بزفرة % ومدمع على الخدود سافح % % 3(@)(@@) % وحسرة على الذين أصبحت % % تعلوهم من الصفا صفائح % % 4(@)(@@) % وأراهم 
ms344	 الترب وكانوا أنجما % كما تضيء بالدجى مصابح % % 5(@)(@@) % وكل يوم وجه خطب كالح % % وللخطوب أوجه كوالح % % 6(@)(@@) % ندفع بالرغم إلى رزية % % محاسن الدنيا بها مقابح % % 7(@)(@@) % نمزج بالدهر وذا صرف الردى % % لا هازل فينا ولا ممازح % % 8(@)(@@) % ونحن عنه أبدا في غفلة % % نلهو كما يلهو البهيم السارح % % 9(@)(@@) % نوضح في اللهو لنا معذرة % % وما لنا في اللهو عذر واضح % % 10(@)(@@) % وفي المنايا للفتى روادع % % زواجر عن غية نواصح % % PageV01P1088 11(@)(@@) % لا يغفل الإنسان عن مزلقة % % لو كان للإنسان عقل راجح % % 12(@)(@@) % يغتاله دون المنى حمامه % % وطرفه إلى الحمام طامح % % 13(@)(@@) % أيجهل الأمر على علم به % % والجهل بالعاقل عيب فاضح % % 14(@)(@@) % يا رفعة بقيت لي في رفعة % من دونها نحط السماك الرامح % % 15(@)(@@) % إني أعزيك بخال قد خلا % % وما خلا منه اللسان المادح % % 16(@)(@@) % وكل من يرجو البقاء بعده % % فذاك غاد بعده ورائح % % 17(@)(@@) % لا بد أن تبكي عليه أعين % وأن تنوح بعده النوايح % % 18(@)(@@) % سقاه من وبل الغمام صيب % تروى به الآكام والأباطح % % 19(@)(@@) % عزيتك اليوم به مؤرخا % % PageV01P1089 البحر : سريع 1(@)(@@) % أبا جميل قر عينا بمن % بلغك الله به ما تريد % 2(@)(@@) % وزادك الله سرورا به % % زيادة ما برحت في مزيد % % 3(@)(@@) % بالولد الماجد من ماجد % % لا يلد الماجد ألا مجيد % % 4(@)(@@) % يا حبذا الوالد من والد % وحبذا طلعة هذا الوليد % % 5(@)(@@) % لاحت مزاياك على وجهه % % كالبدر في طالع برج سعد % % 6(@)(@@) % ألم تكن رب الجميل الذي % % ما ترك الأحرار إلا عبيد % % 7(@)(@@) % وأنت في الناس لمن يقتفي % % قافية المجد وبيت القصيد % % 8(@)(@@) % وكل من آوى إلى فضله % % آوى إلى ظل وركن شديد % % 9(@)(@@) % فليهنك المولود كل الهنا % % بخالد الذكر الذي لا يبيد % % 10(@)(@@) % كليلة الأعياد ميلاده % % وأنت منه كل يوم بعيد % % PageV01P1090 11(@)(@@) % لما بدا للعين أرخته % % أشرقت الدنيا بعبد الحميد % % PageV01P1091 البحر : سريع 1(@)(@@) % باكر تداماك بكأس العقار % فقد مضى الليل وجاء النهار % % 2(@)(@@) % وداوني فيها وسارع بها % % فإن في الخمر دوائر الخمار % % 3(@)(@@) % أما ترى الورقاء قد غردت % في ورق 
ms345	 الدوح وغنى الهزار % % 4(@)(@@) % و بتسمت للطل أزهاره % % وأدمع الطل عليها نثار % % 5(@)(@@) % وقد دعت للهو أبناءها % % أوقات أيام السرور القصار % % 6(@)(@@) % فهاتها صرفا وممزوجة % % بين احمرار برزت واصفرار % % 7(@)(@@) % واملأ لنا أكبر أقداحها % % فالله يعفو عن ذنوب كبار % % 8(@)(@@) % خذها بإعلان ولا تستتر % فما يطيب العيش بالاستتار % % 9(@)(@@) % وعد عمن لام من جهله % % وعدها عارا وليست بعار % % 10(@)(@@) % ما عرف اللذة من عافها % % وقابل العاذل بالاعتذار % % PageV01P1092 11(@)(@@) % وخله واللوم في معزل % % لا تصغ فيها لنهيق الحمار % % 12(@)(@@) % إذ يدعي النسك ولا يهتدي % % به وينعى بخراب الديار % % 13(@)(@@) % إن المرائين إذا استكشفوا % % وجدتهم شر الأنام الشرار % % 14(@)(@@) % لو لم يجد شاربها لذة % وفي المسرات عليها المدار % % 15(@)(@@) % ماوعد الله بها المتقي % % في جنة الخلد ودار القرار % % 16(@)(@@) % يا مولعا بالمرد إني امرؤ % % ما لي عن وجه الحبيب اصطبار % % 17(@)(@@) % إياك والإعراض عن غادة % % في وجهها للحسن نور ونار % % 18(@)(@@) % كم ليلة زار حبيب به % % يشكو إلى المشتاق بعد المزار % % 19(@)(@@) % جمعت فيها بين ما أشتهي % % من غنج أحوى وذات احورار % % 20(@)(@@) % أقسم بالعود وأوتاره % % ونغمة الناي وضرب الإطار % % PageV01P1093 21(@)(@@) % ما لذة سوى ساعة % في مجلس يخلع فيه العذار % % 22(@)(@@) % يقضي به الماجن أوطاره % % وكان مبناه على الاختصار % % 23(@)(@@) % إن الخلاعات لفي فتية % % لم يلبسوا في الأنس ثوب الوقار % % 24(@)(@@) % تغنيهم الراح إذا أملقوا % % كأنها في الكأس ذوب النضار % % 25(@)(@@) % يا طالما قد زرت خمارها % % وقلت أنت اليوم ممن يزار % % 26(@)(@@) % فقام يجلوها كغصن النقا % % يحمل في راحته الجلنار % % 27(@)(@@) % حتى إذا استكفيت من شربها % % لو شئت أدركت من الدهر ثار % % 28(@)(@@) % غفوت عن ذنب زمان مضى % % ما أحسن العفو مع الاقتدار % % 29(@)(@@) % هذا هو العيش ومن لي به % % قبل نقضاء العمر المستعار % % 30(@)(@@) % لا خير في العيش إذا لك يكن % % في ظل عبد الله عالي المنار % PageV01P1094 31(@)(@@) % ما جئته إلا وأبصرتني % % أسحب من نعماه ذيل الفخار % 32(@)(@@) % قيدني في بره ماجد % كأنما أطلقني من أسار % % 33(@)(@@) % موفق يسعى إليه الغنى 
ms346	 % % من غير ما سعي وخوض الغمار % % 34(@)(@@) % لا يقتني المال ولم يدخر % شيئا ولا مال إلى الادخار % % 35(@)(@@) % إني لأغنى الناس عن غيره % % ولي إليه بالسرور فتقار % % 36(@)(@@) % المنجز الوعد بلا منة % ولم أكن من وعده بانتظار % % 37(@)(@@) % ما فارق الأنس له طلعة % % بل سار في خدمته حيث سار % % 38(@)(@@) % كم طائل قصر عن شأوه % % ولاحق ما شق منه الغبار % % 39(@)(@@) % ومستميح نال ما يبتغي % % منه وحاز العز والافتخار % % 40(@)(@@) % يروق كالصمصام إفرنده % % أبيض مثل السيف ماضي الغرار % % PageV01P1095 41(@)(@@) % أما جميل الصنع منه فمن % % شعاره أكرم به من شعار % % 42(@)(@@) % يركب في الجد جواد المنى % % إذ يأمن الراكب فيه العثار % % 43(@)(@@) % حديقة الأفراح في ربعه % % للمجتني منها شهي الثمار % % 44(@)(@@) % فلم أبل ما دمت خلا له % % ما كان من أمري ولا كيف صار % % 45(@)(@@) % وكل ما ستطيبته كائن % % من طيب الذات كريم النجار % % 46(@)(@@) % من كابر ينمة إلى كابر % ومن خيار قد نمته الخيار % % 47(@)(@@) % هم الزهيريون زهر الربا % % والأنجم الزهر التي تستنار % % 48(@)(@@) % فهم أجل الناس قدرا وهم % % أعز من تعرف في الناس جار % % 49(@)(@@) % فلا يمس السوء جارا لهم % % ما ذل من لاذ بهم و ستجار % % 50(@)(@@) % يوفون بالعهد ويرعونه % % في زمن لم يرع فيه الذمار % % PageV01P1096 51(@)(@@) % ألا ترى كل مرىء منهم % % لنائل يرجى ونقع مثار % % 52(@)(@@) % يلتمس المعروف من برهم % % ويستفاض الجود فيض البحار % % 53(@)(@@) % من كل معروف بمعروفه % % في كل قطر من نداه قطار % % 54(@)(@@) % إذا دعته للوغى همة % كان هو المقدام والمستشار % % 55(@)(@@) % تغدو رياضي فيه مخضرة % أشبه شيء ب خضرار العذار % % 56(@)(@@) % أصلح شاني بأبي صالح % % وأغتدي فيه نقي الأزار % % 57(@)(@@) % باهى بي الأزهار في روضها % % فرحت أزهو مثل ورد البهار % % 58(@)(@@) % لا زلت في نور صباح الهنا % % يا كوكبا لاح وبدرا أنار % % PageV01P1097 البحر : خفيف تام 1(@)(@@) % إن هذا قبر لعمرك فيه % % صالح في حياته والممات % 2(@)(@@) % صالح الاسم صالح الفعل يفنى % % وله الباقيات في الصالحات % % 3(@)(@@) % من خلالل كريمة وصفات % شهدت أنه كريم 
ms347	 الذات % % 4(@)(@@) % أدركته الوفاة إذ هو حي % فتوفي وذاك بعد الوفاة % % 5(@)(@@) % حل في جنة النعيم فأرخ % % صالح قد حللت في الجنات % % PageV01P1098 البحر : رمل تام 1(@)(@@) % ما لها مفرية بيدا فبيدا % % تقطع الأرض هبوطا وصعودا % % 2(@)(@@) % كلما لاح لها برق الحمى % % نثرت من لؤلؤ الدمع عقودا % % 3(@)(@@) % لست بالمنكر منها عبرة % % إنها كانت على الحب شهودا % % 4(@)(@@) % فإلى أين سراها ولمن % % تطس البيداء أو تحشو الصعيدا % % 5(@)(@@) % أوقد الشوق بها نيرانه % % فتلظت بلظى الوجد وقودا % % 6(@)(@@) % تخمد النار وما لي لا أرى % % للجوى من مهجة الصب خمودا % % 7(@)(@@) % يا أخلائي وأعلاق الهوى % % جاوزت من شغف القلب حدودا % % 8(@)(@@) % أخلقت بالصبر عنكم لوعة % % تبعث الشوق بها غضا جديدا % % 9(@)(@@) % ووهى يوم نأيتم جلدي % % بعد ما كنت على الدهر جليدا % % 10(@)(@@) % خنتم عهد الهدى ما بيننا % % ورعينا لكم فيها عهودا % % PageV01P1099 11(@)(@@) % من معيد لي في وادي الغضا % % زمنا مر ومن لي أن يعودا % % 12(@)(@@) % في زرود وقفة أذكرها % % فسقى الله حيا المزن زرودا % % 13(@)(@@) % ومن السرب مهاة لحظها % % يصرع اللب ويصطاد الأسودا % % 14(@)(@@) % وبروحي شادن من ريقه % % لا أعاف الخمر والماء البرودا % % 15(@)(@@) % سلب الغصن رطيبا قده % % والظباء العفر ألحاظا وجيدا % % 16(@)(@@) % لامني اللائم عن جهل به % % والهوى يأنف إلا أن يزيدا % % 17(@)(@@) % أيها العاذل يبغي رشدي % % خلني والغي إن كنت رشيدا % % 18(@)(@@) % إن من كانت حياتي عنده % % طالما جرعني الحتف صدودا % % 19(@)(@@) % وحرام أن أرى سلوانه % % ولو أني مت في الحب شهيدا % % 20(@)(@@) % غلبتني منه أجناد الهوى % % إن لمحب على الصب جنودا % % PageV01P1100 21(@)(@@) % من يريني البان والورد معا % في تثنيه خدودا وقدودا % % 22(@)(@@) % يممي أيتها النوق بنا % % سيد السادات والركن الشديدا % % 23(@)(@@) % فلئن سرت بنا حينئذ % لعلي كان مسراك حميدا % % 24(@)(@@) % لا ترى وجها عبوسا عنده % % حين تلقاه ولا صدرا حقودا % % 25(@)(@@) % منعم سابغة نعمته % ومفيد من نداه المستفيدا % % 26(@)(@@) % كلما قربت من حضرته % % فربت لي أملا كان بعيدا % % 27(@)(@@) % حيث طالعنا فأبصرنا به % % طالعا من ذلك الوجه سعيدا % % 28(@)(@@) % أسرع 
ms348	 العالم وعدا منجزا % وإذا أوعد أبطاهم وعيدا % % 29(@)(@@) % آل بيت سطعت أنوارهم % % لم تدع للغي شيطانا مريدا % % 30(@)(@@) % وإذا أعربت عن أبنائهم % % فاذكر الآباء منهم والجدودا % % PageV01P1101 31(@)(@@) % تأخذ الآراء عنه رشدها % % فيريها الرشد والرأي السديدا % % 32(@)(@@) % لين الجانب فيه شدة % قد أذابت من أعاديه الحديدا % % 33(@)(@@) % قيدت عادية الخطب فما % % تضع الأغلال عنها والقيودا % % 34(@)(@@) % ببنيه حفظ الله بهم % % مهجة المجد طريفا وتليدا % % 35(@)(@@) % رافع راية أعلام الهدى % % عاقد للدين بالعز بنودا % % 36(@)(@@) % في بيوت أذن الله لها % % أن نراه في مبانيها عمودا % % 37(@)(@@) % من سيوف الله إذ ما جردت % قطعت من عنق الشرك الوريدا % % 38(@)(@@) % سيد بر رؤوف محسن % ترك الأحرار بالبر عبيدا % % 39(@)(@@) % فترى الأشراف في حضرته % % قوما بين يديه وقعودا % % 40(@)(@@) % أمطرت من يده قطر الندى % % في رياض الفضل ينبتن الورودا % % PageV01P1102 41(@)(@@) % فترى الأقلام في أمداحه % % ركعا تملي ثناه وسجودا % % 42(@)(@@) % يا ابن قطب الغوث والغيث الذي % % لم يزل يهل إحسانا وجودا % % 43(@)(@@) % أنتم البحر وما زلت بكم % % مستمدا منكم البحر المديدا % % 44(@)(@@) % إن وردنا منهلا من نيلكم % % ما صدرنا عنكم إلا ورودا % % 45(@)(@@) % ما سواكم مقصد الراجي ولا % % في سوى شكرانكم نملي القصيدا % % 46(@)(@@) % يا مريد الخير والخير به % % 47(@)(@@) % ليس بالبدع ولا غرو إذا % % همت في مدحك نظما ونشيدا % 48(@)(@@) % جدت لي بالجود حتى خلتني % % بندى وابلك الروض المجودا % % 49(@)(@@) % وقليل فيك لو أنظمها % % في مزاياك لها درا نضيدا % % 50(@)(@@) % فاهنا بالنيشان من سلطاننا % % مبدئا للفخر فيه ومعيدا % % PageV01P1103 51(@)(@@) % ذلك اليوم الذي وافى به % % كان للأشراف في بغداد عيدا % % 52(@)(@@) % ملك أرسله مفتخرا % وبه أرسل مولاي البريدا % % 53(@)(@@) % لم تزل ترقى إليها رتبا % نكبت الشانىء فيها والحسودا % % PageV01P1104 البحر : رمل تام 1(@)(@@) % قد نحرنا الزق يوم العيد نحرا % % وأذبنا بلجين الكأس تبرا % % 2(@)(@@) % وتخيلنا الحميا لهبا % وحسبنا أنها بالماء تورى % % 3(@)(@@) % قال لي الساقي وقد طاف بها % % هي خمر وتراها أنت جمرا % % 4(@)(@@) % يا نديما قد سقاني كأسه % % إسقنيها في الهوى أخرى وأخرى % % 5(@)(@@) % إن أحلى 
ms349	 العيش ما مر على % % روضة غناء والكاسات تترى % % 6(@)(@@) % ويد المزن وأزهار الربا % % نشرت من بعد ذاك الطي نثرا % % 7(@)(@@) % فأدرها قرقفا إن مزجت % % كللت ياقوتها بالمزج درا % % 8(@)(@@) % لا تخف من وزرها في شربها % % أو تخشى مع عفو الله وزرا % % 9(@)(@@) % راحة الأرواح بالراح التي % % لم تدع للهم في الأحشاء ذكرا % % 10(@)(@@) % وبأهلي ذلك الظبي وإن % أوسع المغرم إعراضا وهجرا % % PageV01P1105 11(@)(@@) % غرني في حبه ذو هيف % % كلما لام به العاذل أغرى % % 12(@)(@@) % صال باللحظ على عشاقه % % ولكم من كرة في الحب كرا % % 13(@)(@@) % قد قضى في الحب أن أقضي به % % وقضايا حبه صغرى وكبرى % % 14(@)(@@) % ما عليه في الهوى صير لي % % كبدا حرى وقلبا ما استقرا % % 15(@)(@@) % يا زمانا حذرت أخطاره % % نحن لم نأخذ من الأيام حذرا % % 16(@)(@@) % أنت من دون النقيب القرم لا % % تملك اليوم لنا نفعا وضرا % % 17(@)(@@) % سيد أما نداه فالحيا % % دوه جودا وأدنى منه وفرا % % 18(@)(@@) % هكذا من كان تجري كفه % % نايلا وفرا وإحسانا وبرا % % 19(@)(@@) % وإذا ما المعول العافي أتى % % بابه العالي غتنى فيه وأثرى % % 20(@)(@@) % باليد البيضاء كم أمطرنا % % من غوادي جودها بيضا وصفرا % % PageV01P1106 21(@)(@@) % وردوا البحر أناس قبلنا % % لا وردنا غير تلك اليد بحرا % % 22(@)(@@) % نتحرى كل آن جودها % % وهو بالفضل وبالمعروف أحرى % % 23(@)(@@) % وإذا مدت إلى أعدائها % % جزرتهم بالمواضي البيض جزرا % % 24(@)(@@) % هو رب الكرم المحض الذي % % لا يرى الإقلال يوم الجود عذرا % % 25(@)(@@) % وإذا أولاك من إحسانه % % ساعة في عمره أغناك دهرا % % 26(@)(@@) % فيمينا كلما شاهدته % % قلت فيه إن بعد العسر يسرا % % 27(@)(@@) % سيد سهل بأوقات الندى % % وبأيام الوغى لا زال وعرا % % 28(@)(@@) % يصنع المعروف مع كل امرىء % وهو لا يبغي على المعروف أجرا % % 29(@)(@@) % لم يخب في الناس يوما آمل % جاعل آل رسول الله ذخرا % % 30(@)(@@) % نثرالمال على وفاده % % فشكرنا فضله نظما ونشرا % % PageV01P1107 31(@)(@@) % سيدي والفضل لولاك عفا % % فجزاك الله عن عافيك خيرا % % 32(@)(@@) % بأبي أنت وأمي ماجد % قادري هو أعلى الناس قدرا % % 33(@)(@@) % ملكت رقي منه أنعم % بعد 
ms350	 ما كنت وأيم الله حرا % 34(@)(@@) % أي نعمائك يقضي حقها % % أيها السيد هذا العبد شكرا % % 35(@)(@@) % إنما الفخر الذي طلت به % % شرح الله به للمجد صدرا % % 36(@)(@@) % ولقد جاوزت حدا في العلى % % رجعت من دونه الأبصار حسرى % % 37(@)(@@) % فاهنا بالعيد ودم مبتهجا % ناحر الحاسد بالنعمة نحرا % % PageV01P1108 البحر : كامل تام 1(@)(@@) % ومليحة أخذت فؤادي كله % % وجرت بحكم غرامها الأقدار % 2(@)(@@) % فتانة باللحظ ساحرة به % % ومن اللواحظ فاتن سحار % % 3(@)(@@) % خفرت غداة البين ذمة وامق % % سلب القرار فما لديه قرار % % 4(@)(@@) % ودعتها يوم الرحيل وفي الحشا % % نار وفي وجناتها أنوار % % 5(@)(@@) % والركب ملتمس نوى بغريرة % % ترمى لها الأنجاد والأغوار % % 6(@)(@@) % بمدامع باحت بأسرار الهوى % % للعاذلين وللهوى أسرار % % 7(@)(@@) % لا ينكرن المستهام دموعه % % مما يجن فإنها إقرار % % 8(@)(@@) % وخلت لها في الرقمتين منازل % % كانت تلوح لنا بها أقمار % % 9(@)(@@) % يا دارها جادتك ساجمة الحيا % % وجرت عليك سيولها الأمطار % % 10(@)(@@) % أأميم ما لي كل آن مر بي % % وهواك تستهوي لي الأفكار % % PageV01P1109 11(@)(@@) % أمسي وأصبح والجوى ذاك الجوى % % والليل ليل والنهار نهار % 12(@)(@@) % لا أستفيق من الخمار وكيف لي % % بالصحو منه وثغرك الخمار % % 13(@)(@@) % أتنفس الصعداء يبعث عبرتي % % لهف عليك كما تشب النار % % 14(@)(@@) % إن كان غاض الصبر بعد فواقها % % مني فهاتيك الدموع غزار % % 15(@)(@@) % إني لأطرب في إعادة ذكرها % % ما أطربت نغماتها الأوتار % % 16(@)(@@) % ما لي على جند الهوى من ناصر % عز الغرام وذلت الأنصار % % 17(@)(@@) % ليست تقال لديه عثرة مغرم % % حتى كان ذنوبه استغفار % % PageV01P1110 البحر : طويل 1(@)(@@) % سقاني مرير الكأس حلو المباسم % وغادرني محلول عقد العزائم % % 2(@)(@@) % وحاربني بالصد والصد قاتلي % % فيا ليته لا كان إلا مسالمي % % 3(@)(@@) % ومنذ أطعت الحب فيه صبابة % % عصيت عذولي في هواه ولائمي % % 4(@)(@@) % وقد علم الواشون إذ ذاك أنني % % بلاني وأبلاني الغرام بجاسم % % 5(@)(@@) % نعمت به أيام وصلت تصرمت % ونحن لدى خفض من العيش ناعم % % 6(@)(@@) % يدير علي الكأس يمزج صرفها % % نديمي على كأس الطلا ومنادمي % % 7(@)(@@) % ألذ من الماء النمير لشارب % وألطف خلقا من هبوب النسائم 
ms351	 % % 8(@)(@@) % لقد مر ما أحلاه عيش بقربه % % فهل كان ذاك العيش أحلام نائم % % 9(@)(@@) % ذكرت قضيب البان وهو قوامه % % فنحت عليه عليه فوق نوح الحمائم % % 10(@)(@@) % وما كنت لولا طاعة الحب في الهوى % % ألائم في العشاق غير ملائم % % PageV01P1111 البحر : متقارب تام 1(@)(@@) % تذكر بالخفيف عهدا قديما % % وشاهد في الربع تلك الرسوما % % 2(@)(@@) % فظل يكفكف دمعا كريما % وبات يعالج وجدا لئيما % % 3(@)(@@) % سقى الله دار اللوى بالحيا % % فرامة فالمنحنى فالغميما % % 4(@)(@@) % وحيى منازلنا بالعقيق % % وألقى عليهن غيثا عميما % % 5(@)(@@) % وقفنا عليها ضحى والهوى % % يذيب القلوب ويفني الجسوما % % 6(@)(@@) % وكم وقفة لي بتلك الديار % % أداري بهن الأسى والهموما % % 7(@)(@@) % تنم علي دموع العيون % % ولم أر كالدمع شيئا نموما % % 8(@)(@@) % تقضى علي لنا زمن بالحمى % % ولن قضى الله أن لا يدوما % % 9(@)(@@) % وجارت علينا صروف الزمان % % وكان الزمان ظلوما غشوما % % 10(@)(@@) % وكانوا بجمع وكان الكئيب % % فحلوا الغوير وحل الحطيما % % PageV01P1112 11(@)(@@) % ومرت نسائم عيش المحب % % وعادت عليه برغم سموما % % 12(@)(@@) % ليالي مرت مرور الخيال % % وكانت نعيما فصارت جحيما % % 13(@)(@@) % ولا نشقتني الصبا بعدهم % % أريجا ذكيا ومسكا شميما % % 14(@)(@@) % ومما شجاني ورق الغوير % % تردد في الدوح صوتا وخيما % % 15(@)(@@) % على أنني إن بدا بارق % % نثرت من الدمع درا نظيما % % 16(@)(@@) % تفضحني عبرتي في الهوى % % ولم تر صبا لسر كتوما % % 17(@)(@@) % وإن غريمي غزال اللوى % % فجوزيت بالخير ذاك الغريما % % 18(@)(@@) % رماني بعينيه ظبي الصريم % % فأمسى فؤاد المعنى صريما % 19(@)(@@) % رماني ولم يخش إثما فرحت % قتيلا وراح بقتلي أثيما % % 20(@)(@@) % وأنت مهاة قطيع المها % % أبيت لأجلك أرعى النجوما % % PageV01P1113 21(@)(@@) % وكنت ألوم بك العاشقين % % فأصبحت يا مي فيك الملوما % % 22(@)(@@) % وأثقلني حمل هذا الغرام % % وحملني الوجد عبثا عظيما % % 23(@)(@@) % وها أنا أشكو فؤادا عليلا % وجسما كطرف أميم سقيما % % 24(@)(@@) % ولله قلب بها المستهام % % وما منع القلب أن لا يهيما % % 25(@)(@@) % ومن بعد تلك الثنايا العذاب % % إلى كم أعاني العذاب الأليما % % 26(@)(@@) % وأسلمني للمنون المنى % % كأني أبيت الدياجي سليما % % 27(@)(@@) % ولولا رجائي بمفتي العراق % % لأصبح حالي قبيحا ذميما % % 28 
ms352	(@)(@@) % قطعت العلائق عن غيره % % كما قطع المشرفي الأديما % % 29(@)(@@) % كريم أؤمل منه الجميل % % وقد خاب من لا يرجى الكريما % % 30(@)(@@) % ويولي بنائله الطالبين % % فيغني الفقير ويثري العديما % % PageV01P1114 31(@)(@@) % ويهدي المضل ويعطي المقل % ويرفع في البأس خطيبا جسيما % % 32(@)(@@) % أحاديثه مثل زهر الرياض % % فهل كان إذ ذاك روضا جميعا % % 33(@)(@@) % لطيف رقيق حواشي الطباع % % فلو جسمت لاستحالت نسيما % % 34(@)(@@) % فسبحان من جعل الفضل في % % علاك إلى أن علوت النجوما % % 35(@)(@@) % فأوضحت بالحق للعالمين % % صراطا إلى ربها مستقيما % % 36(@)(@@) % وأصبح معوج أمر الأنام % % بأحكام حكمك عدلا قويما % % 37(@)(@@) % وتغضب لله لا للحظوظ % % وما زلت في غير ذاك الحليما % % 38(@)(@@) % وأحييت رمة علم النبي % وقبلك كانت عظما رميما % % 39(@)(@@) % كشفت بعلمك إشكالها % % فحيرت فيما كشفت الفهوما % % 40(@)(@@) % وصيرت رشدك صبحا منيرا % يشق من الغي ليلا بهيما % % PageV01P1115 41(@)(@@) % لقد نلت ما أعجز الأولين % % وأصبحت في كل علم عليما % % 42(@)(@@) % فطورا هماما وطورا إماما % وطورا عليما وطورا حكيما % % 43(@)(@@) % وأنت أجل الورى رتبة % وأعظم قدرا وأشرف خيما % % 44(@)(@@) % وقد نتجت بك أم العلى % % ومن بعد ذلك أضحت عقيما % % 45(@)(@@) % فيا من به أقلع النائبات % % كما تقلع المرسلات الغيوما % % 46(@)(@@) % ترحم على عبدك المستهام % % فإني عهدتك برا رحيما % % 47(@)(@@) % ولإني لأجلب فيك السرور % % وإني لأكشف فيك الغموما % % 48(@)(@@) % فلا تشمتن بي الحاسدين % % فتطمع في العدو المشوما % % 49(@)(@@) % ولا تتركني لقى للهموم % % فتتركني في الزوايا هشيما % % 50(@)(@@) % وألسنة الخصم مثل الصوارم % % تسقى الدماء وتفري اللحوما % % PageV01P1116 51(@)(@@) % فنل سيدي أنس عيد جديد % % وحز في صيامك أجرا عظيما % % PageV01P1117 البحر : وافر تام 1(@)(@@) % بقيت أبا الثناء مدى الليالي % % على الداعي لكم خضل اليدين % % 2(@)(@@) % يحول نداك ما بين الرزايا % % إذا هطلت يداك به وبيني % % 3(@)(@@) % تواعدني بك الآمال وعدا % رأيت نجازه من غير مين % % 4(@)(@@) % تجود على محبك كل عام % % بلبس عباءة وتقر عيني % % PageV01P1118 البحر : طويل 1(@)(@@) % لأسماء دار حيث منقطع الرمل % % سقاها برجاف العشية منهل % 2(@)(@@) % وجرت عليها الذيل وطفاء أبرقت % وراحت ومن جلجالها زجل الفحل % % 3(@)(@@) % وإني لأستسقي 
ms353	 لها وابل الحيا % % وإن كان دمعي ما ينوب عن الوبل % % 4(@)(@@) % عهدت الهوى فيها وكانت كانما % % مواقيتها الأولى مواسم للوصل % % 5(@)(@@) % حلفت بأحشاء يحرقها % % وكل قريح الجفن بالدمع مبتل % 6(@)(@@) % وما رميت من مهجة صادها الهوى % % بمحكولة العينين من غير ما كحل % % 7(@)(@@) % لقد فتكت بي أعين بابلية % فويحك يا قلبي من الأعين النجل % % 8(@)(@@) % وقد فعل الشوق المبرح في الحشا % % كما تفعل النيران بالحطب الجزل % % 9(@)(@@) % وإن فاض دمعي لا أزال أريقه % % فمن كبد تصلى ومن لوعة تصلي % % 10(@)(@@) % وجور زمان لو أرى فيه منصفا % لحاكمته فيه إلى حكم عدل % % PageV01P1119 11(@)(@@) % أمثلي يطوف الأرض شرقا ومغربا % على أرب يرضى من الكثر بالقل % 12(@)(@@) % وتقذفني الأسفار في كل وجهة % % فمن مهمه وعر إلى مهمه سهل % 13(@)(@@) % وتحرمني الأيام ما أستحقه % % فلا كانت الأيام إذ ذاك في حل % 14(@)(@@) % وأرجع أختار الإقامة خاملا % حليف الجهول الوغد والحاسد النذل % % 15(@)(@@) % وقد عكفت قوم على كل جاهل % كما عكفت أقوام موسى على العجل % % 16(@)(@@) % يطاولني من لست أرضاه موطئا % وأكرم نعلي أن أقيس به نعلي % % 17(@)(@@) % وفاخرني من يحسب الجهل فخره % % وناظري من لم يكن شكله شكلي % % 18(@)(@@) % فتبا لدهر تستذل قرومه % % وتستكبر الأنذال فيه وتستعلي % % 19(@)(@@) % أقاموا مقامي من جهلت بزعمهم % % فما قام في عقد هناك ولا حل % 20(@)(@@) % ولو طلبوا مثلي نفس حر أبية % شديد عليها في الدنا موقف الذل % PageV01P1120 21(@)(@@) % أواعدها والدهر يأبى بساعة % تبل غليلي حين تنزعني غلي % % 22(@)(@@) % ويعذلني من ليس يدري ولو درى % % لما عج في لومي ولا لج في عذلي % % 23(@)(@@) % على أنني ما بين شر عصابة % حريصين لا كانوا على الخلق الرذل % % 24(@)(@@) % لقد أنكروا أشياء أفضلهم بها % % وما عرفوا في الدهر شيئا سوى البخل % % 25(@)(@@) % وما أشفقوا من وخز دهياء طخية % كما أشفقوا يوم النوال من البذل % % 26(@)(@@) % مدحت شهاب الدين بالعلم والحجى % % ومدح شهاب الدينفرض على مثلي % % 27(@)(@@) % وما يممت بي ناقة غير بابه % % ولا وقرت إلا بإحسانه رحلي % % 28(@)(@@) % هو الشرف الأعلى 
ms354	 هو العلم والتقى % % تورثه عن جده سيد الرسل % % 29(@)(@@) % متى حاولته اليعملات حثثتها % % إلى السيد المحمود بالقول والفعل % % 30(@)(@@) % إلى دوحة من هاشم نبوية % نعم إن هذا الفرع من ذلك الأصل % % PageV01P1121 31(@)(@@) % وإلا تحط علما بأعلم من بها % % فسل من شجاع القوم عن جوهر النصل % % 32(@)(@@) % وإني إذ أصغي لمعنى حديثه % % ثملت وتردادي بأمداحه نقلي % % 33(@)(@@) % كلامك لا ما راع من كل باهر % ولفظك لا ما شتير من كورة النحل % % 34(@)(@@) % وكتبك أمثال الشموس طوالع % % فلا الليل يغشاها إذ الشك كالليل % % 35(@)(@@) % هديت بها من كان منها بحيرة % % وأوضحت في تبيانها غامض السبل % % 36(@)(@@) % وأمليت ما حارت عقول الورى به % % وأصبحت الأقلام تكتب ما تملي % % 37(@)(@@) % وما تنكر الدنيا بأنك عالم % وإن كان هذا الدهر أميل للجهل % % 38(@)(@@) % وإن عدت الأشياخ بالعلم والحجى % % فإنك شيخ الكل مولاي في الكل % 39(@)(@@) % وأنت إمام المسلمين بأسرهم % % عليك اعتماد القول بالنقل والعقل % % 40(@)(@@) % فلا أخذ إلا عنك في الدين كله % % ألا إن حق الأخذ من قولك الفصل % % PageV01P1122 41(@)(@@) % وإن قال قوم قد عزلت فإنما % % عزلت ولم تعزل عن العلم والفضل % % 42(@)(@@) % يحط سواك العزل عن شرف العلى % % ومثلك لا ينحط ما عاش بالعزل % % 43(@)(@@) % وهل للمعالي لا أبا لأبيهم % % سواك وإن يأب المعاند من بعل % % 44(@)(@@) % وهبها لدى أسر لدى غير كفوها % % فلو خليت جاءتك تمشي على رجل % % 45(@)(@@) % تحن إلى محياك وهي مشوقة % % إليك حنين المستهام إلى الوصل % % 46(@)(@@) % وكم منصب قد قال يوما لأهله % % إليك إذا عني فما أنت من أهلي % % 47(@)(@@) % أغظت بك الحساد في كل مدحة % % أشد على ا لأعداء من موقع النبل % % 48(@)(@@) % وقلت ولم أرجع إلى غير مثله % % ويا كثر ما أخرت أشياء من قولي % % 49(@)(@@) % يغيظ كلامي فيك كل مناضل % يرى من كلامي فيك نضنضة الصل % 50(@)(@@) % وفيك أقول الحق حتى لو نني % % أذوق الردى فيه مريرا وأستحلي % % PageV01P1123 البحر : سريع 1(@)(@@) % بشراك في نجل نجيب بدا % % والبشر لما حل لا شك حل % 2(@)(@@) % مناقب الآباء تحيى 
ms355	 به % % والسادة الغر الكرام الأول % 3(@)(@@) % نور يريد الله إظهراه % % وشمس فضل في العلى لم تزل % 4(@)(@@) % قد ولد الزاكي فأرخته % % الخير في مولده قد حصل % PageV01P1124 البحر : طويل 1(@)(@@) % خليلي في قلبي من الوجد جذوة % تأجج من شوق شديد إليكما % % 2(@)(@@) % يعاني فؤادي ما يعاني من الجوى % % وما هو إلا منكما وعليكما % % 3(@)(@@) % وقد كاد هذا القلب يضرب ناره % % ويوشك قلب الصب أن يتضرما % % 4(@)(@@) % ولي أعين غرقى ولكن بمائها % % تساقط منها الدمع فذا وتوأما % % 5(@)(@@) % وأعذر أجفاني على فيض أدمعي % % ولو أنها فاضت لفقدكما دما % % 6(@)(@@) % وأدعو لها بالغمض وهو بمعزل % % لعل خيالا يطرق العين منكما % % 7(@)(@@) % تناءيتما عن وامق فيكما شج % فأنجدتما يا صاحبي وأتهما % % 8(@)(@@) % فهل تريا بينا رمينا بسهمه % % درى أي قلب قد رماه وما رمى % % 9(@)(@@) % وها أنا حتى تنقضي مدة النوى % % أعلل قلبي في عسى ولربما % % 10(@)(@@) % لذكركما أصغي إذا ما ذكرتما % % وأذكر عهدا منكما قد تقدما % % PageV01P1125 11(@)(@@) % وعيشا قضيناه نعيما بقربكم % % ولله عيش ما ألذ وأنعما % % 12(@)(@@) % وما جتاز بي ركب يجد بسيره % % من الروم إلا أسأل الركب عنكما % % 13(@)(@@) % وإن نشرت صحف الغرام لديكما % % ففي طيها مني السلام عليكم % % PageV01P1126 البحر : متقارب تام 1(@)(@@) % عرفت صبابة هذي النياق % فما لك تسأل عن دائها ؟ % 2(@)(@@) % كأنك لم تدر أن الهوى % % دواها وجالب ضرائها % % 3(@)(@@) % أعيذك مما بها يا هذيم % % غرام أقام بأحشائها % % 4(@)(@@) % نأت عن منازلها في الغميم % % سقتها السماء بأنوائها % % 5(@)(@@) % وأجرت مدامعها حسرة % على النازلين بجرعائها % % 6(@)(@@) % ألا صبح الغيث تلك الديار % % وحيى منازل أحيائها % % 7(@)(@@) % فما هي إلا منى العاشقين % % تلوح الديار بأرجائها % % 8(@)(@@) % فخل المطي على ما بها % % ووافق تخالف أهوائها % % 9(@)(@@) % لئن وقفت بك في الرقمتين % % وقفت على بعض أدوائها % % 10(@)(@@) % فما عرفت أوجه المغرمين % % لعمرك إلا بسيمائها % % PageV01P1127 11(@)(@@) % وإنك إن تعذل الوامقين % % فإنك أكبر أعدائها % % PageV01P1128 البحر : متقارب تام 1(@)(@@) % كفاني المهمات عبد الغني % % وذلك من بعض أفضاله % % 2(@)(@@) % فإن نلت مالا فمن جاهه % وإن نلت جاها فمن ماله 
ms356	 % PageV01P1129 البحر : وافر تام 1(@)(@@) % حباك الله منه بالشفاء % % ومتعك المهيمن بالبقاء % % 2(@)(@@) % فيا بحر النوال ولا أماري % % ويا بدر الكمال ولا أرائي % % 3(@)(@@) % حياتك في الوجود أبا جميل % % حياة للمروءة والسخاء % % 4(@)(@@) % وفي وجدانك الأيام تزهو % % كما تزهو الرياض من البهاء % % 5(@)(@@) % لتشرق في أسرتك النواحي % % ولا يبقى الظلام مع الضياء % % 6(@)(@@) % وأدعو الله مبتهلا إليه % % دعاء في الصباح وبالمساء % % 7(@)(@@) % دعاء يشمل الدنيا جميعا % ويبعث بالمسرة والهناء % % 8(@)(@@) % بأن يبقيك للإسلام ظلا % تقيه كل ممتنع الوقاء % % 9(@)(@@) % فلا عتلت لعلتك المعالي % % ولا فقدتك أبناء الرجاء % % 10(@)(@@) % دواء للعلى من كل داء % فلا حتاج الدواء إلى الدواء % % PageV01P1130 البحر : وافر تام 1(@)(@@) % أراني والخطوب إذا ألمت % رحبت إلى جميل أبي جميل % 2(@)(@@) % كأن الله وكله برزقي % % وحولني على نعم الوكيل % PageV01P1131 البحر : كامل تام 1(@)(@@) % كم قد ألين لمن قسا بصدوده % حتى ظننت فؤاده جلمودا % % 2(@)(@@) % ولكم أسلت من العيون مدامعا % وأهجت من حر الغرام وقودا % % 3(@)(@@) % كبد تذوب وحسرة لا تقضي % % ودموع طرف بألف التسهيدا % % 4(@)(@@) % أنكرت معرفتي على عهد النوى % % ومنحتني بعد الوصال صدودا % % 5(@)(@@) % أخلقت صبري بعد بعدك بالنوى % % وكسوتني ثوب السقام جديدا % % 6(@)(@@) % لولا العيون النجل ما عرف النوى % % من كان صبا في هواك عميدا % % 7(@)(@@) % ولقد أرى نار الزفير ولا أرى % % يوما لنيران الفؤاد خمودا % % 8(@)(@@) % فالموقرات بريها وقطارها % % والحاملات بوارقا ورعودا % % 9(@)(@@) % تهمي الندى وتريك كل عشية % سحبت على زهر الرياض برودا % % 10(@)(@@) % ما زلت أحمد للمسير عواقبا % حتى حللت مقامك المحمودا % % PageV01P1132 11(@)(@@) % طالعت في وجه السعيد محمد % % فرأيت طالع مجتديه سعيدا % % 12(@)(@@) % قابلت أحداث النحوس بسعده % % فأعاد هاتيك النحوس سعودا % % 13(@)(@@) % وزجرت طير السعد يهتف ب سمه % % ورأيت منه الطالع المسعودا % % 14(@)(@@) % أقررت عين المجد فيك مدائحا % وأغظت فيك معاندا وحسودا % % 15(@)(@@) % وإذا نظرت إلى سناه ومجده % % لنظرت من فلق الصباح عمودا % % 16(@)(@@) % ما زال يولينا الجميل بفضله % % كرما يسر الآملين وجودا % % 17(@)(@@) % وإذا ستمحت به النوال وجدته % % غيثا يسح ومنهلا مورودا % % 18(@)(@@) % ولقد مدحت 
ms357	 الماجدين فلا أرى % % إلا مديحا مقنعا ومفيدا % % 19(@)(@@) % لا فارقت عيناي طلعتك التي % % مدت علينا ظلك الممدودا % % 20(@)(@@) % سادات أبناء الزمان بأسرهم % % ورثوا المكارم طارفا وتليدا % % PageV01P1133 21(@)(@@) % تفني مكارمه الحطام ويقتني % % ذكرا يخلد في الثناء خلودا % % 22(@)(@@) % فلقد رقيت بها لأرفع رتبة % % فبلغت أسباب السماء صعودا % % 23(@)(@@) % ويريك إن ضلت عقول أولي النهى % % رأيا يريك به الصواب سديدا % % 24(@)(@@) % أخذوا بناصية المفاخر والعلى % % وتسنموها قوما وقعودا % % 25(@)(@@) % وتخالهم عند العطاء غمائما % وتظنهم يوم اللقاء أسودا % % 26(@)(@@) % إني لأشكر من جميلك ما به % % أكبت من بعد الحسود حسودا % % 27(@)(@@) % هذا الذكاء ولا مزيد على الذي % % أبصرت منك لمن أراد مزيدا % % 28(@)(@@) % أبت المحاسن والمكارم في الندى % % إلا بقاء بعدهم وخلودا % % 29(@)(@@) % أخذوا المذاهب في الجميل فلم نجد % % إلا مقلدهم به تقليدا % % 30(@)(@@) % قلدتني نعما أنوء بحملها % % فنظمت فيك قلائدا وعقودا % % PageV01P1134 31(@)(@@) % لا زلت لي عيدا أشاهد عوده % % حتى ألاقي يومي الموعودا % % PageV01P1135 البحر : طويل 1(@)(@@) % وإني لشيعي لآل محمد % % وإن رغمت آناف قومي وعذلي % % 2(@)(@@) % وأشهد أن الله لا رب غيره % % وأن ولي بين الملا علي % % PageV01P1136 البحر : طويل 1(@)(@@) % عفت أرسم من دار مي وأطلال % وحالت بنا إذ خف قاطنها الحال % 2(@)(@@) % فكم أسأل الدار البوالي رسومها % % وهل نافعي من أرسم الدار تسآل ؟ % 3(@)(@@) % وقفت بها أقضي لها الدين بالأسى % % وما ينقضي وجد عليها وبلبال % % 4(@)(@@) % وفي النفس من تلك المنازل لوعة % % تهيجها مني غدو وآصال % % 5(@)(@@) % وكم هيجت بي زفرة % لنيرانها في مضمر القلب إشعال % % 6(@)(@@) % وعهدي بذات الضال عذر على الهوى % % ألا للهوى العذري ما جمع الضال % % 7(@)(@@) % بروحي من كانت حياتي بقربه % % ويقتلني بالهجر والهجر قتال % % 8(@)(@@) % ألاحظ منه البدر في غسق الدجى % % يميس به قد من البان ميال % % 9(@)(@@) % أحبتنا قد حال بيني وبينكم % % خطوب لأحداث الزمان وأهوال % % 10(@)(@@) % لئن غبتم عن ناظري وحجبتم % % فما غاب منكم عن فؤادي تمثال % % PageV01P1137 11(@)(@@) % وما سرني أني مقيم ببلدة % % وهمي عليكم في المهامه جوال % % 12(@)(@@) % ألام عليكم في الهوى وهوانه % % وللصب 
ms358	 لوام وللحب عذال % % 13(@)(@@) % سقى الله هاتيك الديار وأهلها % % وجرت عليها للغمائم أذيال % % 14(@)(@@) % وعهدا مضى فيه الشباب وطيبه % % وقد غاله من طارق الشيب مغتال % % 15(@)(@@) % سأركبها في المهمه القفر مركبا % سفائن بر لج أبحرها الآل % % 16(@)(@@) % ولست مقيما ما أقمت بمنزل % وعيشي أنكاد تسوء وأنكال % % 17(@)(@@) % وتصحبني في كل فج عزيمتي % % وأبيض هندي وأسمر عسال % % 18(@)(@@) % وما ملكت مني المطامع مقودا % لصاحبها في موقف الضيم إذلال % % 19(@)(@@) % وما ساءني فقر ولا سرني غنى % بحيث ستوى عندي ثراء وإقلال % % 20(@)(@@) % ولم أدن من أشياء مما تشينني % % ولو قطعت مني لذلك أوصال % % PageV01P1138 21(@)(@@) % وما كان بي والحمد لله خلة % لها بالشريف الباذخ المجد إخلال % % 22(@)(@@) % ولست أبالي والأبوة مذهبي % % إذا أعرضت عني مع العلم جهال % % 23(@)(@@) % هم سابقوني بالفخار فقصروا % % وهو طالبوني بألإناء فما طالوا % % 24(@)(@@) % ولي بعلي القدر عن غيره غنى % إذا عد قول للكرام وأفعال % % 25(@)(@@) % من القوم أبناء النبوة والعلى % % يشام لهم في كل بارقة خال % % 26(@)(@@) % سل المجد عنهم مجملا ومفصلا % ويغني عن التفصيل إذ ذاك إجمال % % 27(@)(@@) % إذا وصفوا بالعلم والحلم والتقى % % فبالعلم أعلام وبالحلم أجبال % % 28(@)(@@) % قواض على أموالهم بنوالهم % % وما نيل هذا الفضل إلا بما نالوا % % 29(@)(@@) % عزائمهم شرقا وغربا وبأسهم % قيود بأعناق الرجال وأغلال % % 30(@)(@@) % إليك أبا سلمان تسعى ركابنا % % وفيها إلى مغناك حل وترحال % % PageV01P1139 31(@)(@@) % وتصدر عنك الواردون ظماؤها % % عليها من الإنعام والشكر أثقال % % 32(@)(@@) % إذا نحن أثنينا عليك فإنما % % لكل نسيج من ثنائك منوال % % 33(@)(@@) % يصح رجائي في علاك مريضه % % ومن اسمك العالي لقد صدق الفال % % 34(@)(@@) % تبشر بالنعماء منك بشاشة % وعطف على من يرتجيك وإقبال % % 35(@)(@@) % تغيث بغوث من دعاك لكربه % % وللغيث من جدوى يمينك إخجال % % 36(@)(@@) % وما زال بي من جود فضلك نعمة % تسر بها نفسي وينعم لي بال % % 37(@)(@@) % إذا ما ستقى العافون من يدك النوى % % سقاها الأيادي عارض منك هطال % % 38(@)(@@) % وفيك أبا سلمان بالناس رأفة % ينال بها قصد وتدرك آمال % % 39(@)(@@) % يخبر عنك الفضل أنك أهله 
ms359	 % ويشهد فيك البأس أنك رئبال % % 40(@)(@@) % تبلج صبح الحق بالصدق ظاهرا % فلا حتال بعد اليوم بالزور محتال % % PageV01P1140 41(@)(@@) % أما وجميل من صنيعك سالف % علي به من وفضل وإفضال % % 42(@)(@@) % وآباؤك الغر الميامين إنهم % % غيوث إذا جادوا ليوث إذا صالوا % % 43(@)(@@) % لقد كذب الحساد فيما تقولوا % % علي وأيم الله ما قلت ما قالوا % % 44(@)(@@) % أعيذك أن تصغي إلى قول كاذب % ويثنيك عني ذلك القيل والقال % % 45(@)(@@) % ألم أقض عمري في ثنائك كله % % ولي فيك من غر المدائح أقوال % % 46(@)(@@) % خدمتك في مدحي ثلاثين حجة % وصوبك منهل وجودك سيال % % 47(@)(@@) % أباهي بك السادات شرفا ومغربا % وأرفل في برد النعيم وأختال % % 48(@)(@@) % أنال بك الآمال وهي بعيدة % % وأفتح أبوابا عليهن أقفال % % 49(@)(@@) % ولإني لأرعى الناس بالشكر ذمة % وما في خلوصي بالمودة إشكال % % 50(@)(@@) % وأنت الذي ترجى من الناس كلها % % وتضرب في نعماك للناس أمثال % % PageV01P1141 51(@)(@@) % إذا ما القوافي أقبلت بثنائها % % عليك فمأمول بها الجاه والمال % % 52(@)(@@) % وقافية تتلى ويحلو نشيدها % % وكم تتحلى في ثنائك معطال % % PageV01P1142 البحر : رمل تام 1(@)(@@) % سر بحفظ الله و رجع سالما % راغما بالعز أنف الحاسدين % 2(@)(@@) % راكبا في مركب أرخته % % إركبوا فيه بخير آمنين % PageV01P1143 البحر : طويل 1(@)(@@) % لله والدة المليك وما بنت % من جامع رحب الفناء منمنم % 2(@)(@@) % للراكعين الساجدين لقد زها % % سمة التقى للناظرين المترسم % % 3(@)(@@) % ترجو من الله الكريم مثوبة % أجر المثيب على الجيل المنعم % % 4(@)(@@) % إذ غيرته وقدرته بحكمة % وكذا يراد من البناء المحكم % % 5(@)(@@) % أخذت بتوسعة له وأعانها % % نظر الرديف وخدمة المستخدم % % 6(@)(@@) % فيه الإمام أبو حنيفة من له % % زهر المناقب مثل زهر الأنجم % % 7(@)(@@) % أخذت علوم أصولها وفروعها % % عنه الأئمة في الزمان الأقدم % % 8(@)(@@) % قد عمرته وشيدته وجدت % تاريخ مسجد للإمام الأعظم % PageV01P1144 البحر : متقارب تام 1(@)(@@) % أرد الدموع بأردانه % وكفكف عبرة أجفانه ؟ % 2(@)(@@) % صيانة سر الهوى يا هذيم % % فباح البكاء بكتمانه % % 3(@)(@@) % ولو أنكر الصب أمر الغرام % % لجاء الغرام ببرهانه % % 4(@)(@@) % وإرسال عبرته في الديار % % تعبر عن فرط أشجانه % % 5(@)(@@) % يحن إلى أثلاث الغوير 
ms360	 % % حنين الغريب لأوطانه % % 6(@)(@@) % وهام بسلع هيام المشوق % % وما هام إلا لسكانه % % 7(@)(@@) % وقد قال سعد بذاك الحمى % % شجته ملاعب غزلانه % % 8(@)(@@) % وذل لسلطان حكم الهوى % % وما ذل إلا لسلطانه % % 9(@)(@@) % وعرفني البرق شأن الغرام % % وما أعرف المرء في شانه % % 10(@)(@@) % وأوقد في القلب نيرانه % فماذا تقول بنيرانه ؟ % PageV01P1145 11(@)(@@) % رأى صاحبي آية للفؤاد % % تدل على ضد سلوانه % % 12(@)(@@) % وكاد يصدق لولا الضنى % % بزور السلو وبهتانه % % 13(@)(@@) % فآمن في مرسلات الدموع % % ولست أشك بإيمانه % % PageV01P1146 البحر : وافر تام 1(@)(@@) % وعدل ما قضى في الحب يوما % على عشاقه إلا بظلم % 2(@)(@@) % فهمت بأنه قمر منير % ولكن قد تحير فيه فهمي % % PageV01P1147 البحر : طويل 1(@)(@@) % رعى الله أيام السرور بحاجر % وعهد صبابتي به وغرامي % % 2(@)(@@) % بحيث الهوى عذب المجاني بقربه % % ولا عهد لي من عادل بملام % % 3(@)(@@) % وقد جمعتنا للذائذ ساعة % أحلت لنا بالسكر كل حرام % % 4(@)(@@) % وما العيش إلا كأس راح روية % % تدار ولكن في أكف غلام % % 5(@)(@@) % إذا رمت منه الوصل كان مرامه % % من الوصل أقصى بغيتي ومرامي % % 6(@)(@@) % وإن رابه مني أوام أبله % % وكم بل يوما غلتي ولأوامي % % 7(@)(@@) % شربت حميا كأسه ورضابه % وكلتاهما يا صاح كأس مدام % % 8(@)(@@) % ولذ بسمعي فيه نظم شدا به % على نغم الساعين شدو حمام % % PageV01P1148 البحر : وافر تام 1(@)(@@) % أرى القاضي يشارك كل حي % وليس الميت ينجو من يديه % % 2(@)(@@) % وأقسم أنه لو مات أير % تورث منه إحدى خصيتيه % % PageV01P1149 البحر : رمل تام 1(@)(@@) % راق للأبصار حسنا وجمالا % % بدر تم لاح ف ستوفى الكمالا % % 2(@)(@@) % قرت العين به من أبلج % فرأت أعينه السحر حلالا % % 3(@)(@@) % كلما زاد وميضا برقه % % زادني من لوعة الوجد شتعالا % % 4(@)(@@) % ظامىء الأحشاء في الحب إلى % % مانعي من ثغره العذب الزلالا % % 5(@)(@@) % لا أبالي في صبابات الهوى % % أقصر العاذل لومي أم أطالا % % 6(@)(@@) % كم طعين بقوام أهيف % هو لم يشهد طعانا ونزالا % % 7(@)(@@) % إن للصب لعمري كبدا % زاد في القلب من الوجد ذبالا % % 8(@)(@@) % صان في أحشائه الحب وقد % % أهرقت أجفانه الدمع المذالا % % 9 