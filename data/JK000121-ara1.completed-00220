ms206	 ترجمة موسى بن مسلم بن رومان(@)(@@)(@@)(@@) $ 2862 صالح بن زياد بن عبد الله أبو شعيب المقرىء السوسي نزيل الرقة ثقة من العاشرة مات سنة إحدى وستين س(@)(@@)(@@)(@@) $ 2863 صالح بن سعيد بفتح السين ويقال بضمها وهو أرجح المؤذن الحجازي أبو طالب أو أبو غالب مقبول من السادسة س(@)(@@)(@@)(@@) $ 2864 صالح بن سهيل النخعي أبو أحمد الكوفي مولى بن أبي زائدة مقبول من كبار الحادية عشرة د(@)(@@)(@@)(@@) $ 2865 صالح بن صالح بن حي ويقال بين بن صالح وحي مسلم ويقال حيان وحي لقب حيان وقد ينسب إلى جد أبيه فيقال صالح بن حي وصالح بن حيان قال أحمد ثقة ثقة من السادسة مات سنة ثلاث وخمسين ووثقه العجلي وضعف صالح بن حيان القرشي الذي تقدم ذكره هذا تحريره ع(@)(@@)(@@)(@@) $ 2866 صالح بن أبي صالح السمان أبو عبد الرحمن واسم أبيه ذكوان ثقة من الخامسة م ت(@)(@@)(@@)(@@) $ 2867 صالح بن أبي صالح الكوفي مولى عمرو بن حريث واسم أبيه مهران ضعيف من الرابعة مد ت(@)(@@)(@@)(@@) $ 2868 صالح بن أبي صالح الأسدي صاحب الشعبي مقبول من السابعة س(@)(@@)(@@)(@@) $ 2869 صالح بن صالح الأسدي مقبول من السابعة أيضا وهم من خلطه بالذي قبله تمييز(@)(@@)(@@)(@@) $$$ صالح بن أبي صالح مولى التوأمة هو بن نبهان يأتي(@)(@@)(@@)(@@) $ 2870 صالح بن صهيب بن سنان الرومي مجهول الحال من الرابعة ق(@)(@@)(@@)(@@) $$$ صالح بن عامر عن شيخ من بني تميم صوابه صالح أبو عامر وهو الخزاز بينه سعيد بن منصور في سننه ووهم المزي فقال صوابه صالح عن عامر أي بن حي عن الشعبي وليس كما قال د(@)(@@)(@@)(@@) $ 2871 صالح بن عبد الله بن ذكوان الباهلي أبو عبد الله الترمذي نزيل بغداد ثقة من العاشرة مات سنة إحدى وثلاثين أو بعدها ت(@)(@@)(@@)(@@) $ 2872 صالح بن عبد الله بن صالح العامري مولاهم المدني مجهول من التاسعة ق PageV01P272(@)(@@)(@@)(@@) $ 2873 صالح بن عبد الله بن أبي فروة أبو عروة الأموي مولاهم المدني وثقه بن معين من السادسة ق(@)(@@)(@@)(@@) $ 2874 صالح بن عبد الكبير 
ms207	 بن شعيب بن الحبحاب البصري المعولي بكسر الميم وسكون المهملة مجهول من العاشرة ت(@)(@@)(@@)(@@) $ 2875 صالح بن عبد الكبير المسمعي البصري مقبول من العاشرة أيضا تمييز(@)(@@)(@@)(@@) $ 2876 صالح بن عبيد عن قبيصة بن وقاص قيل إنه غير الذي روى عنه عمرو بن الحارث المصري وقيل هو هو مقبول من السادسة د(@)(@@)(@@)(@@) $ 2877 صالح بن عبيد اليماني أبو مصعب مقبول من الثامنة ي(@)(@@)(@@)(@@) $ 2878 صالح بن عجلان حجازي مقبول من السابعة د ق(@)(@@)(@@)(@@) $ 2879 صالح بن عدي بن أبي عمارة النميري أبو الهيثم البصري الذارع صدوق من العاشرة س(@)(@@)(@@)(@@) $ 2880 صالح بن أبي عريب بفتح المهملة وكسر الراء وآخره موحدة واسمه قليب بالقاف والموحدة مصغرا مقبول من السادسة د س ق(@)(@@)(@@)(@@) $ 2881 صالح بن عمر الواسطي نزيل حلوان ثقة من الثامنة مات سنة ست أو سبع أو خمس وثمانين بخ م(@)(@@)(@@)(@@) $ 2882 صالح بن قدامة بن إبراهيم بن محمد بن حاطب القرشي الجمحي المدني مقبول من الثامنة س(@)(@@)(@@)(@@) $ 2883 صالح بن كثير المدني مقبول من السابعة مد(@)(@@)(@@)(@@) $ 2884 صالح بن كيسان المدني أبو محمد أو أبو الحارث مؤدب ولد عمر بن عبد العزيز ثقة ثبت فقيه من الرابعة مات بعد سنة ثلاثين أو بعد الأربعين ع(@)(@@)(@@)(@@) $ 2885 صالح بن محمد بن زائدة المدني أبو واقد الليثي الصغير ضعيف من الخامسة مات بعد الأربعين 4(@)(@@)(@@)(@@) $ 2886 صالح بن محمد بن يحيى بن سعيد القطان مقبول من الحادية عشرة كد ق(@)(@@)(@@)(@@) $ 2887 صالح بن أبي مريم الضبعي مولاهم أبو الخليل البصري وثقه بن معين والنسائي وأغرب بن عبد البر فقال لا يحتج به من السادسة ع(@)(@@)(@@)(@@) $$$ صالح بن مسلم بن رومان وقد ينسب إلى جده يأتي إيضاحه في ترجمة موسى بن مسلم بن رومان د PageV01P273(@)(@@)(@@)(@@) $ 2888 صالح بن مسمار السلمي أبو الفضل ويقال أبو العباس المروزي الكشميهني صدوق من صغار العاشرة مات قبل الخمسين م ت(@)(@@)(@@)(@@) $ 2889 صالح بن مسمار بصري سكن الجزيرة مقبول قديم من السابعة تمييز(@)(@@)(@@)(@@) $ 2890 صالح بن مهران الشيباني 
ms208	 مولاهم أبو سفيان الأصبهاني كان يقال له الحكيم ثقة زاهد من الحادية عشرة س(@)(@@)(@@)(@@) $$$ صالح بن مهران هو بن أبي صالح تقدم(@)(@@)(@@)(@@) $ 2891 صالح بن موسى بن إسحاق بن طلحة التيمي الكوفي متروك من الثامنة ت ق(@)(@@)(@@)(@@) $ 2892 صالح بن نبهان المدني مولى التوأمة بفتح المثناة وسكون الواو بعدها همزة مفتوحة صدوق اختلط قال بن عدي لا بأس برواية القدماء عنه كابن أبي ذئب وابن جريج من الرابعة مات سنة خمس أو ست وعشرين وقد أخطأ من زعم أن البخاري أخرج له د ت ق(@)(@@)(@@)(@@) $ 2893 صالح بن الهيثم الواسطي أبو شعيب الصيرفي الطحان صدوق من صغار العاشرة ق(@)(@@)(@@)(@@) $ 2894 صالح بن يحيى بن المقدام بن معدي كرب الكندي الشامي لين من السادسة د س ق(@)(@@)(@@)(@@) $$$ صالح الأسدي هو بن أبي صالح تقدم(@)(@@)(@@)(@@) $ 2895 صالح بياع الأكسية مقبول من السابعة بخ(@)(@@)(@@)(@@) $$$ صالح أبو الخليل هو بن أبي مريم(@)(@@)(@@)(@@) $$$ صالح مولى التوأمة هو بن نبهان تقدما(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 2896 الصباح بن عبد الله العبدي ثقة من السادسة عخ(@)(@@)(@@)(@@) $ 2897 الصباح بن محارب التيمي الكوفي نزيل الري صدوق ربما خالف من الثامنة ق(@)(@@)(@@)(@@) $ 2898 الصباح بن محمد بن أبي حازم البجلي الأحمسي الكوفي ضعيف أفرط فيه بن حبان من السابعة ت(@)(@@)(@@)(@@) $ 2899 صبيح بن محرز المقرئي بفتح الميم وسكون القاف وفتح الراء بعدها همزة ثم ياء النسب الحمصي مقبول من السابعة واختلف هل هو مفتوح أوله أو مصغر د(@)(@@)(@@)(@@) $ 2900 صبيح مصغر مولى أم سلمة ويقال مولى زيد بن أسلم مقبول من السادسة ت ق(@)(@@)(@@)(@@) $$$ صبيح بفتح أوله هو أو المليح يأتي في الكنى(@)(@@)(@@)(@@) $ 2901 صبي بالتصغير بن معبد التغلبي بالمثناة والمعجمة وكسر اللام ثقة مخضرم نزل الكوفة من الثانية د س ق(@)(@@)(@@)(@@) $ 2902 صخر بن إسحاق مولى بني غفار حجازي لين من السادسة د(@)(@@)(@@)(@@) $ 2903 صخر بن بدر العجلي البصري مقبول من السادسة د(@)(@@)(@@)(@@) $ 2904 صخر بن جويرية أبو نافع مولى بني تميم أو بني هلال قال أحمد ثقة ثقة وقال القطان ذهب 
ms209	 كتابه ثم وجده فتكلم فيه لذلك من السابعة خ م د ت س PageV01P274(@)(@@)(@@)(@@) $ 2905 صخر بن حرب بن أمية بن عبد شمس بن عبد مناف الأموي أبو سفيان صحابي شهير أسلم عام الفتح ومات سنة اثنتين وثلاثين وقيل بعدها خ م د ت س(@)(@@)(@@)(@@) $ 2906 صخر بن عبد الله بن بريدة بن الحصيب بمهملتين مصغرا الأسلمي المروزي مقبول من السادسة د(@)(@@)(@@)(@@) $ 2907 صخر بن عبد الله بن حرملة المدلجي حجازي مقبول غلط بن الجوزي فنقل عن بن عدي أنه اتهمه وإنما المتهم صخر بن عبد الله الحاجبي ت(@)(@@)(@@)(@@) $ 2908 صخر بن العيلة بفتح المهملة وسكون المثناة التحتانية بن عبد الله بن ربيعة الأحمسي صحابي قليل الحديث يقال إن العيلة اسم أمه د(@)(@@)(@@)(@@) $ 2909 صخر بن وداعة بفتح الواو الغامدي بالمعجمة حجازي سكن الطائف صحابي مقل قال الأزدي ما روى عنه إلا عمارة بن حديد 4(@)(@@)(@@)(@@) $ 2910 صدقة بن بشير بفتح الموحدة ثم بمعجمة المدني مولى آل عمر أبو محمد مقبول من الثامنة ق(@)(@@)(@@)(@@) $ 2911 صدقة بن خالد الأموي مولاهم أبو العباس الدمشقي ثقة من الثامنة مات سنة إحدى وسبعين وقيل ثمانين أو بعدها خ د س ق(@)(@@)(@@)(@@) $ 2912 صدقة بن سعيد الحنفي الكوفي مقبول من السادسة قد س ق(@)(@@)(@@)(@@) $ 2913 صدقة بن عبد الله السمين أبو معاوية أو أبو محمد الدمشقي ضعيف من السابعة مات سنة ست وستين ت س ق(@)(@@)(@@)(@@) $ 2914 صدقة بن عمرو الغساني مجهول من الثامنة فق(@)(@@)(@@)(@@) $ 2915 صدقة بن عمرو المكي مجهول من السادسة تمييز(@)(@@)(@@)(@@) $ 2916 صدقة بن أبي عمران الكوفي قاضي الأهواز صدوق من السابعة خت م ق(@)(@@)(@@)(@@) $ 2917 صدقة بن عيسى الحنفي ضعيف من السادسة لم يخرجوا له وهم عبد الغني في ذكره(@)(@@)(@@)(@@) $ 2918 صدقة بن الفضل أبو الفضل المروزي ثقة من العاشرة مات سنة ثلاث أو ست وعشرين خ(@)(@@)(@@)(@@) $ 2919 صدقة بن المثنى بن رياح بكسر الراء ثم التحتانية الحنفي ثقة من السادسة د س ق(@)(@@)(@@)(@@) $ 2920 صدقة بن المثنى الكعبي مجهول من 
ms210	 السابعة تمييز(@)(@@)(@@)(@@) $ 2921 صدقة بن موسى الدقيقي أبو المغيرة أو أبو محمد السلمي البصري صدوق له أوهام من السابعة بخ د ت PageV01P275(@)(@@)(@@)(@@) $ 2922 صدقة بن يسار الجزري نزيل مكة ثقة من الرابعة مات في أول خلافة بنى العباس وكان ذلك سنة اثنتين وثلاثين م د س ق(@)(@@)(@@)(@@) $ 2923 صدي بالتصغير بن عجلان أبو أمامة الباهلي صحابي مشهور سكن الشام ومات بها سنة ست وثمانين ع(@)(@@)(@@)(@@) $ 2924 صرد بضم أوله وفتح ثانيه بن أبي المنازل بالزاي واللام بصري مقبول من السابعة د(@)(@@)(@@)(@@) $ 2925 الصعب بفتح أوله وسكون المهملة بن جثامة بفتح الجيم وتشديد المثلثة الليثي صحابي مات في خلافة الصديق على ما قيل والأصح أنه عاش إلى خلافة عثمان ع(@)(@@)(@@)(@@) $ 2926 الصعب بن حكيم بن شريك الكوفي مقبول من السابعة بخ(@)(@@)(@@)(@@) $ 2927 صعصعة بن صوحان بضم المهملة وبالحاء المهملة العبدي نزيل الكوفة تابعي كبير مخضرم فصيح ثقة مات في خلافة معاوية أغفل المزي رقم د وروايته في باب الشعر من كتاب الأدب د س(@)(@@)(@@)(@@) $ 2928 صعصعة بن مالك ثقة من الرابعة د(@)(@@)(@@)(@@) $ 2929 صعصعة بن معاوية بن حصين التميمي السعدي عم الأحنف له صحبة وقيل إنه مخضرم مات في ولاية الحجاج على العراق بخ س ق(@)(@@)(@@)(@@) $ 2930 صعصعة بن ناجية بن عقال التميمي المجاشعي عم الفرزدق صحابي له أحاديث س(@)(@@)(@@)(@@) $ 2931 الصعق بن حزن بفتح المهملة وسكون الزاي بن قيس البكري البصري أبو عبد الله صدوق يهم وكان زاهدا من السابعة بخ م مد س(@)(@@)(@@)(@@) $ 2932 صفوان بن أمية بن خلف بن وهب بن قدامة بن جمح القرشي الجمحي المكي صحابي من المؤلفة مات أيام قتل عثمان وقيل سنة إحدى أو اثنتين وأربعين في أوائل خلافة معاوية خت م 4(@)(@@)(@@)(@@) $ 2933 صفوان بن سليم المدني أبو عبد الله الزهرى مولاهم ثقة مفت عابد رمي بالقدر من الرابعه مات سنة اثنتين وثلاثين وله اثنتان وسبعون سنة ع(@)(@@)(@@)(@@) $ 2934 صفوان بن صالح بن صفوان الثقفي مولاهم أبو عبد الملك الدمشقي ثقة وكان يدلس 
ms211	 تدليس التسوية قاله أبو زرعة الدمشقي من العاشرة مات سنة ثمان أو سبع أو تسع وثلاثين وله سبعون سنة د ت س فق PageV01P276(@)(@@)(@@)(@@) $ 2935 صفوان بن أبي الصهباء التيمي الكوفي مقبول من السابعة اختلف فيه قول بن حبان عخ(@)(@@)(@@)(@@) $ 2936 صفوان بن عبد الله بن صفوان بن أمية القرشي ثقة من الثالثة بخ م س ق(@)(@@)(@@)(@@) $$$ صفوان بن عبد الله بن يعلى بن أمية التميمي صوابه صفوان بن يعلى وسيأتي س ق(@)(@@)(@@)(@@) $ 2937 صفوان بن عسال بمهملتين المرادي صحابي معروف نزل الكوفة ت س ق(@)(@@)(@@)(@@) $ 2938 صفوان بن عمرو بن هرم السكسكي أبو عمرو الحمصي ثقة من الخامسة مات سنة خمس وخمسين أو بعدها بخ م 4(@)(@@)(@@)(@@) $ 2939 صفوان بن عمرو الحمصي الصغير صدوق من الحادية عشرة س(@)(@@)(@@)(@@) $ 2940 صفوان بن عيسى الزهري أبو محمد البصري القسام ثقة من التاسعة مات سنة مائتين وقيل قبلها بقليل أو بعدها خت م 4(@)(@@)(@@)(@@) $ 2941 صفوان بن محرز بن زياد المازني أو الباهلي ثقة عابد من الرابعة مات سنة أربع وسبعين خ م ت س ق(@)(@@)(@@)(@@) $ 2942 صفوان بن موهب حجازي مقبول من السادسة س(@)(@@)(@@)(@@) $ 2943 صفوان بن هبيرة العيشي بالتحتانية والمعجمة أبو عبد الرحمن البصري لين الحديث من التاسعة ق(@)(@@)(@@)(@@) $ 2944 صفوان بن أبي يزيد ويقال بن سليم المدني مقبول من الرابعة بخ س(@)(@@)(@@)(@@) $ 2945 صفوان بن يعلى بن أمية التميمي المكي ثقة من الثالثة ع(@)(@@)(@@)(@@) $ 2946 الصقعب بقاف بوزن جعفر بن زهير بن عبد الله بن زهير الأزدي الكوفي ثقة من السادسة بخ(@)(@@)(@@)(@@) $ 2947 الصلت بفتح أوله وآخره مثناة بن دينار الأزدي الهنائي البصري أبو شعيب المجنون مشهور بكنيته متروك ناصبي من السادسة ت ق(@)(@@)(@@)(@@) $ 2948 الصلت بن عبد الله بن نوفل بن الحارث بن عبد المطلب بن عم عبد الله بن الحارث الملقب 2 ببه مقبول من السادسة د ت(@)(@@)(@@)(@@) $ 2949 الصلت بن محمد بن عبد الرحمن البصري أبو همام الخاركي بخاء معجمة صدوق من كبار العاشرة مات سنة بضع 
ms212	 عشرة خ م(@)(@@)(@@)(@@) $ 2950 الصلت بن مسعود بن طريف الجحدري أبو بكر أو أبو محمد البصري القاضي ثقة ربما وهم من العاشرة مات سنة أربعين أو قبلها بسنة م(@)(@@)(@@)(@@) $ 2951 الصلت السدوسي مولاهم تابعي لين الحديث أرسل حديثا من الرابعة مد PageV01P277(@)(@@)(@@)(@@) $ 2952 صلة بكسر أوله وفتح اللام الخفيفة بن زفر بضم الزاي وفتح الفاء العبسي بالموحدة أبو العلاء أو أبو بكر الكوفي تابعي كبير من الثانية ثقة جليل مات في حدود السبعين ع(@)(@@)(@@)(@@) $ 2953 الصنابح بضم أوله ثم نون وموحدة ومهملة بن الأعسر الأحمسي صحابي سكن الكوفة ومن قال فيه الصنابحي فقد وهم ق(@)(@@)(@@)(@@) $ 2954 صهيب بن سنان أبو يحيى الرومي أصله من النمر يقال كان اسمه عبد الملك وصهيب لقب صحابي شهير مات بالمدينة سنة ثمان وثلاثين في خلافة علي وقيل قبل ذلك ع(@)(@@)(@@)(@@) $ 2955 صهيب مولى العباس ويقال له صهبان بضم أوله صدوق من الثالثة بخ(@)(@@)(@@)(@@) $ 2956 صهيب أبو الصهباء البكري البصري أو المدني مقبول من الرابعة م د س(@)(@@)(@@)(@@) $ 2957 صهيب الحذاء أبو موسى المكي مولى بن عامر مقبول من الرابعة س(@)(@@)(@@)(@@) $ 2958 صهيب مولى العتواريين بمهملة ومثناة ساكنة تفرد نعيم المجمر بالرواية عنه ووهم من قال غير ذلك مقبول من الرابعة س(@)(@@)(@@)(@@) $ 2959 صيفي بن ربعي بكسر الراء الأنصاري أبو هشام الكوفي صدوق يهم من التاسعة ت(@)(@@)(@@)(@@) $ 2960 صيفي بن زياد الأنصاري مولاهم أبو زياد أو أبو سعيد المدني ثقة من الرابعة م د ت س(@)(@@)(@@)(@@) $ 2961 صيفي بن صهيب بن سنان مقبول من الثالثة ق PageV01P278(@)(@@)(@@)(@@) | ( حرف الضاد المعجمة )(@)(@@)(@@)(@@) $ 2962 ضبارة بضم أوله ثم موحدة مخففا بن عبد الله بن مالك بن أبي السليل بفتح المهملة الحضرمي أبو شريح الحمصي مجهول من السادسة بخ د س ق(@)(@@)(@@)(@@) $ 2963 ضبة بن محصن العنزي بفتح المهملة والنون بصري صدوق من الثالثة م د ت(@)(@@)(@@)(@@) $ 2964 ضبيعة بالتصغير بن حصين الثعلبي ويقال ثعلبة بن ضبيعة مقبول من الثالثة د(@)(@@)(@@)(@@) $ 2965 الضحاك بن أيمن الكلبي مجهول من السادسة ق(@)(@@)(@@)(@@) $ 2966 
ms213	 الضحاك بن حمرة بضم المهملة وبالراء الأملوكي بضم الهمزة الواسطي ضعيف من السادسة ت(@)(@@)(@@)(@@) $ 2967 الضحاك بن سفيان بن عوف بن كعب بن أبي بكر بن كلاب الكلابي أبو سعيد صحابي معروف كان من عمال النبي صلى الله عليه وسلم على الصدقات 4(@)(@@)(@@)(@@) $ 2968 الضحاك بن شراحيل ويقال شرحبيل المشرقي بكسر أوله ثم معجمة ثم فتحة وقاف الهمداني صدوق من الرابعة خ م ص(@)(@@)(@@)(@@) $ 2969 الضحاك بن شرحبيل الغافقي بالمعجمة أبو عبد الله المصري صدوق يهم من الرابعة د ت ق(@)(@@)(@@)(@@) $ 2970 الضحاك بن عبد الرحمن بن أبي حوشب النصري بالنون الدمشقي ثقة من السادسة س(@)(@@)(@@)(@@) $ 2971 الضحاك بن عبد الرحمن بن عرزب بفتح المهملة وسكون الراء وفتح الزاي ثم موحدة وقد تبدل ميما أبو عبد الرحمن أو أبو زرعة الطبراني ثقة من الثالثة مات سنة خمس ومائة قد ت ق(@)(@@)(@@)(@@) $ 2972 الضحاك بن عثمان بن عبد الله بن خالد بن حزام الأسدي الحزامي بكسر أوله وبالزاي أبو عثمان المدني صدوق يهم من السابعة م 4(@)(@@)(@@)(@@) $ 2973 الضحاك بن عثمان بن الضحاك بن عثمان الحزامي حفيد الذي قبله كان علامة أخباريا صدوقا من كبار العاشرة مات على رأس المائتين تمييز(@)(@@)(@@)(@@) $ 2974 الضحاك بن عثمان العزربي غير مشهور من العاشرة تمييز(@)(@@)(@@)(@@) $ 2975 الضحاك بن فيروز الديلمي الفلسطيني مقبول من الثالثة د ت ق(@)(@@)(@@)(@@) $ 2976 الضحاك بن قيس بن خالد بن وهب الفهري أبو أنيس الأمير المشهور صحابي صغير قتل في وقعة مرج راهط سنة أربع وستين س PageV01P279(@)(@@)(@@)(@@) $ 2977 الضحاك بن مخلد بن الضحاك بن مسلم الشيباني أبو عاصم النبيل البصري ثقة ثبت من التاسعة مات سنة اثنتي عشرة أو بعدها ع(@)(@@)(@@)(@@) $ 2978 الضحاك بن مزاحم الهلالي أبو القاسم أو أبو محمد الخراساني صدوق كثير الإرسال من الخامسة مات بعد المائة 4(@)(@@)(@@)(@@) $ 2979 الضحاك بن المنذر بن جرير بن عبد الله البجلي مقبول من الرابعة س ق(@)(@@)(@@)(@@) $ 2980 الضحاك بن نبراس بفتح النون والموحدة وآخره مهملة الأزدي الجهضمي أبو الحسن البصري لين 
ms214	 الحديث من السابعة بخ(@)(@@)(@@)(@@) $ 2981 الضحاك المعافري بفتح الميم والمهملة وكسر الفاء الدمشقي البزاز مقبول من السادسة ق(@)(@@)(@@)(@@) $ 2982 ضرار بكسر أوله مخففا بن صرد بضم المهملة وفتح الراء التيمي أبو نعيم الطحان الكوفي صدوق له أوهام وخطأ ورمي بالتشيع وكان عارفا بالفرائض من العاشرة مات سنة تسع وعشرين عخ(@)(@@)(@@)(@@) $ 2983 ضرار بن مرة الكوفي أبو سنان الشيباني الأكبر ثقة ثبت من السادسة مات سنة اثنتين وثلاثين بخ م مد ت س(@)(@@)(@@)(@@) $ 2984 ضريب بالتصغير آخره موحدة بن نقير بنون وقاف مصغرا أبو السليل بفتح المهملة وكسر اللام القيسي الجريري بضم الجيم مصغرا ثقة من السادسة م 4(@)(@@)(@@)(@@) $ 2985 ضمام بكسر أوله مخففا بن إسماعيل بن مالك المرادي أبو إسماعيل المصري صدوق ربما أخطأ من الثامنة مات سنة خمس وثمانين وله ثمان وثمانون سنة بخ(@)(@@)(@@)(@@) $ 2986 ضمرة بن حبيب بن صهيب الزبيدي بضم الزاي أبو عتبة الحمصي ثقة من الرابعة مات سنة ثلاثين 4(@)(@@)(@@)(@@) $ 2987 ضمرة بن حبيب المقدسي مجهول من العاشرة تمييز(@)(@@)(@@)(@@) $ 2988 ضمرة بن ربيعة الفلسطيني أبو عبد الله أصله دمشقي صدوق يهم قليلا من التاسعة مات سنة اثنتين ومائتين بخ 4(@)(@@)(@@)(@@) $ 2989 ضمرة بن سعيد بن أبي حنة بمهملة ثم نون وقيل موحدة الأنصاري المدني ثقة من الرابعة م 4(@)(@@)(@@)(@@) $ 2990 ضمرة بن عبد الله بن أنيس الجهني حليف الأنصار مقبول من الثالثة د س(@)(@@)(@@)(@@) $ 2991 ضمضم بن جوس بفتح الجيم ثم مهملة ويقال بن الحارث بن جوس اليمامي ثقة من الثالثة 4(@)(@@)(@@)(@@) $ 2992 ضمضم بن زرعة بن ثوب بضم المثلثة وفتح الواو ثم موحدة الحضرمي الحمصي صدوق يهم من السادسة د فق(@)(@@)(@@)(@@) $ 2993 ضمضم بن عمرو الحنفي أبو الأسود البصري مقبول من السابعة بخ(@)(@@)(@@)(@@) $ 2994 ضمضم أبو المثنى الأملوكي الحمصي وثقه العجلي من الرابعة د ق(@)(@@)(@@)(@@) $ 2995 ضميرة الأسلمي والد سعد صحابي شهد وقعة حنين د ق PageV01P280(@)(@@)(@@)(@@) | ( حرف الطاء المهملة )(@)(@@)(@@)(@@) $ 2996 طارق بن أشيم بالمعجمة وزن أحمر بن مسعود الأشجعي والد أبي مالك صحابي له أحاديث 
ms215	 قال مسلم لم يرو عنه غير ابنه بخ م ت س ق(@)(@@)(@@)(@@) $ 2997 طارق بن أبي الحسناء يقال اسم أبيه عبد الرحمن مجهول من السادسة قد(@)(@@)(@@)(@@) $ 2998 طارق بن زياد كوفي مجهول من الثالثة ص(@)(@@)(@@)(@@) $ 2999 طارق بن سويد أو سويد بن طارق صحابي له حديث في الأشربة حضرمي ويقال جعفي د ق(@)(@@)(@@)(@@) $ 3000 طارق بن شهاب بن عبد شمس البجلي الأحمسي أبو عبد الله الكوفي قال أبو داود رأى النبي صلى الله عليه وسلم ولم يسمع منه مات سنة اثنتين أو ثلاث وثمانين ع(@)(@@)(@@)(@@) $ 3001 طارق بن عبد الله المحاربي الكوفي صحابي له حديثان أو ثلاثة عخ 4(@)(@@)(@@)(@@) $ 3002 طارق بن عبد الرحمن بن القاسم القرشي حجازي ثقة من الرابعة مات سنة تسع وعشرين د(@)(@@)(@@)(@@) $ 3003 طارق بن عبد الرحمن البجلي الأحمسي الكوفي صدوق له أوهام من الخامسة ع(@)(@@)(@@)(@@) $ 3004 طارق بن عمرو المكي الأموي مولاهم أمير المدينة لعبد الملك وثقه أبو زرعة في الحديث والمشهور أنه كان من أمراء الجور من الثالثة مات في حدود الثمانين م(@)(@@)(@@)(@@) $ 3005 طارق بن محاسن بمهملتين وقيل بمعجمتين وضم أوله حجازي مقبول من الثالثة د س(@)(@@)(@@)(@@) $ 3006 طارق بن المرقع حجازي مقبول من الثالثة ويقال إنه الذي خاصمه كردم إلى النبي صلى الله عليه وسلم س(@)(@@)(@@)(@@) $ 3007 طالب بن حبيب بن عمرو بن سهل الأنصاري المدني ويقال له بن الضجيع صدوق يهم من السابعة د(@)(@@)(@@)(@@) $ 3008 طالب بن حجير بمهملة وجيم مصغرا العبدي البصري صدوق من السابعة بخ ت(@)(@@)(@@)(@@) $ 3009 طاوس بن كيسان اليماني أبو عبد الرحمن الحميري مولاهم الفارسي يقال اسمه ذكوان وطاوس لقب ثقة فقيه فاضل من الثالثة مات سنة ست ومائة وقيل بعد ذلك ع(@)(@@)(@@)(@@) $ 3010 طخفة بكسر أوله وسكون الخاء المعجمة ثم فاء ويقال بالهاء ويقال بالغين المعجمة وقيل غير ذلك بن قيس الغفاري ويقال قيس بن طخفة صحابي له حديث في النوم على البطن مات بعد الستين د س(@)(@@)(@@)(@@) $ 3011 طرفة براء وفاء مفتوحتين بن عرفجة بن 
ms216	 أسعد التميمي مجهول من الرابعة د PageV01P281(@)(@@)(@@)(@@) $ 3012 طرفة الحضرمي صاحب بن أبي أوفى مقبول من الخامسة لم يقع مسمى في رواية أبي داود د(@)(@@)(@@)(@@) $$$ طريف بن سلمان أبو عاتكة في الكنى(@)(@@)(@@)(@@) $ 3013 طريف بن شهاب أو بن سعد السعدي البصري الأشل بالمعجمة ويقال له الأعسم بمهملتين ضعيف من السادسة ت ق(@)(@@)(@@)(@@) $ 3014 طريف بن مجالد الهجيمي أبو تميمة بفتح أوله البصري ثقة من الثالثة مشهور بكنيته مات سنة سبع وتسعين أو قبلها أو بعدها خ 4(@)(@@)(@@)(@@) $ 3015 طعمة بن عمرو الجعفري الكوفي صدوق عابد من السابعة د ت(@)(@@)(@@)(@@) $ 3016 طعمة بن غيلان الجعفي الكوفي مقبول من السادسة عس(@)(@@)(@@)(@@) $$$ طغفة في طخفة(@)(@@)(@@)(@@) $ 3017 الطفيل بن أبي بن كعب الأنصاري الخزرجي كان يقال له أبو بطن لعظم بطنه ثقة يقال ولد في عهد النبي صلى الله عليه وسلم من الثانية بخ ت ق(@)(@@)(@@)(@@) $ 3018 الطفيل بن سخبرة ويقال بن عبد الله بن الحارث بن سخبرة بفتح المهملة وسكون المعجمة ثم موحدة أخو عائشة لأمها صحابي له حديث ق(@)(@@)(@@)(@@) $ 3019 طلحة بن خراش بمعجمتين بن عبد الرحمن الأنصاري المدني صدوق من الرابعة ت س ق(@)(@@)(@@)(@@) $ 3020 طلحة بن زيد القرشي أبو مسكين أو أبو محمد الرقي أصله دمشقي متروك قال أحمد وعلي وأبو داود كان يضع من الثامنة ق(@)(@@)(@@)(@@) $ 3021 طلحة بن أبي سعيد الإسكندراني أبو عبد الملك القرشي أصله مدني ثقة مقل من السابعة مات سنة سبع وخمسين خ س(@)(@@)(@@)(@@) $ 3022 طلحة بن عبد الله بن خلف بن أسعد بن عامر الخزاعي المعروف بطلحة الطلحات أبو المطرف البصري أحد الأجواد أمير سجستان من الثالثة لم يثبت أن أبا داود روى له د(@)(@@)(@@)(@@) $ 3023 طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق التيمي المدني مقبول من الثالثة قد س ق(@)(@@)(@@)(@@) $ 3024 طلحة بن عبد الله بن عثمان بن عبيد الله بن معمر التيمي المدني ثقة من الثالثة خ د س(@)(@@)(@@)(@@) $ 3025 طلحة بن عبد الله بن عوف الزهري المدني القاضي 
ms217	 بن أخي عبد الرحمن يلقب طلحة الندى ثقة مكثر فقيه من الثالثة مات سنة سبع وتسعين وهو بن اثنتين وسبعين خ 4(@)(@@)(@@)(@@) $ 3026 طلحة بن عبد الملك الأيلي بفتح الهمزة بعدها ياء ساكنة ثقة من السادسة خ 4(@)(@@)(@@)(@@) $ 3027 طلحة بن عبيد الله بن عثمان بن عمرو بن كعب بن سعد بن تيم بن مرة التيمي أبو محمد المدني أحد العشرة مشهور استشهد يوم الجمل سنة ست وثلاثين وهو بن ثلاث وستين ع PageV01P282(@)(@@)(@@)(@@) $ 3028 طلحة بن عبيد الله بن كريز بفتح أوله الخزاعي أبو المطرف ثقة من الثالثة م د(@)(@@)(@@)(@@) $ 3029 طلحة بن عبيد الله العقيلي مجهول من الرابعة تمييز(@)(@@)(@@)(@@) $ 3030 طلحة بن عمرو بن عثمان الحضرمي المكي متروك من السابعة مات سنة اثنتين وخمسين ق(@)(@@)(@@)(@@) $ 3031 طلحة بن العلاء الأحمسي أبو العلاء الكوفي مقبول من الثالثة فق(@)(@@)(@@)(@@) $ 3032 طلحة بن أبي قنان بفتح القاف والنون العبدري مولاهم أبو قنان الدمشقي مجهول أرسل حديثا من الثالثة مد(@)(@@)(@@)(@@) $ 3033 طلحة بن مالك الخزاعي أو السلمي صحابي نزل البصرة له حديث ت(@)(@@)(@@)(@@) $ 3034 طلحة بن مصرف بن عمرو بن كعب اليامي بالتحتانية الكوفي ثقة قارىء فاضل من الخامسة مات سنة اثنتي عشرة أو بعدها ع(@)(@@)(@@)(@@) $ 3035 طلحة بن نافع الواسطي أبو سفيان الإسكاف نزل مكة صدوق من الرابعة ع(@)(@@)(@@)(@@) $ 3036 طلحة بن يحيى بن طلحة بن عبيد الله التيمي المدني نزيل الكوفة صدوق يخطىء من السادسة مات سنة ثمان وأربعين م 4(@)(@@)(@@)(@@) $ 3037 طلحة بن يحيى بن النعمان بن أبي عياش الزرقي الأنصاري المدني نزيل بغداد صدوق يهم من السابعة خ م د س ق(@)(@@)(@@)(@@) $ 3038 طلحة بن يزيد الأيلي بفتح الهمزة وسكون الياء أبو حمزة مولى الأنصار نزل الكوفة وثقه النسائي من الثالثة خ 4(@)(@@)(@@)(@@) $ 3039 طلحة عن أبيه عن جده في مسح الرأس قيل هو بن مصرف وإلا فمجهول من السادسة د(@)(@@)(@@)(@@) $ 3040 طلق بسكون اللام بن حبيب العنزي بفتح المهملة والنون بصري صدوق عابد رمي بالإرجاء من الثالثة مات 
ms218	 بعد التسعين بخ م 4(@)(@@)(@@)(@@) $ 3041 طلق بن السمح بفتح المهملة وسكون الميم بعدها مهملة أبو السمح المصري الإسكندراني مقبول من كبار العاشرة مات سنة إحدى عشرة س(@)(@@)(@@)(@@) $ 3042 طلق بن علي بن المنذر الحنفي السحيمي بمهملتين مصغرا أبو علي اليمامي صحابي له وفادة 4(@)(@@)(@@)(@@) $ 3043 طلق بن غنام بمعجمة ونون بن طلق بن معاوية النخعي أبو محمد الكوفي ثقة من كبار العاشرة مات في رجب سنة إحدى عشرة خ 4(@)(@@)(@@)(@@) $ 3044 طلق بن معاوية النخعي أبو عتاب الكوفي جد الذي قبله تابعي كبير مخضرم مقبول بخ م س(@)(@@)(@@)(@@) $ 3045 طلق بن معاوية بن يزيد عن الثوري مجهول من السابعة تمييز PageV01P283(@)(@@)(@@)(@@) $ 3046 طليق بالتصغير بن عمران بن حصين ويقال بن محمد بن عمران مقبول من السادسة ق(@)(@@)(@@)(@@) $ 3047 طليق بن قيس الحنفي الكوفي ثقة من الثالثة بخ 4(@)(@@)(@@)(@@) $ 3048 طليق بن محمد بن السكن بن مروان الواسطي أبو سهل البزاز ثقة من كبار الحادية عشرة س(@)(@@)(@@)(@@) $$$ طهفة في طخفة(@)(@@)(@@)(@@) $ 3049 طود بفتح أوله وسكون الواو بن عبد الملك القيسي البصري مقبول من السابعة س(@)(@@)(@@)(@@) $ 3050 طيسلة بفتح أوله وسكون التحتانية وفتح المهملة وتخفيف اللام بن علي البهدلي بموحدة اليمامي مقبول من الثالثة قال البرديجي هو بن مياس وهو لقب علي بخ ل(@)(@@)(@@)(@@) $$$ طيسلة بن مياس بتشديد التحتانية وآخره مهملة هو الذي قبله فرقهما المزي فوهم وقد بينت ذلك في الأصل(@)(@@)(@@)(@@) | ( حرف الظاء المعجمة )(@)(@@)(@@)(@@) $$$ ظالم أبو الأسود الدؤلي في الكنى(@)(@@)(@@)(@@) $$$ ظليم بفتح أوله أبو النجيب بنون وجيم يأتي في الكنى(@)(@@)(@@)(@@) $ 3051 ظهير بالتصغير بن رافع بن عدي الأنصاري الأوسي من كبار الصحابة شهد بدرا وهو عم رافع بن خديج خ م س ق PageV01P284(@)(@@)(@@)(@@) | ( حرف العين )(@)(@@)(@@)(@@) $ 3052 عابس بموحدة مكسورة ثم مهملة بن ربيعة النخعي الكوفي ثقة مخضرم من الثانية ع(@)(@@)(@@)(@@) $ 3053 عابس بن ربيعة الغطيفي بمعجمة مصغر صحابي شهد فتح مصر وهم من خلطه بالذي قبله تمييز(@)(@@)(@@)(@@) $ 3054 عاصم بن بهدلة وهو بن أبي النجود بنون وجيم الأسدي مولاهم الكوفي أبو 
ms219	 بكر المقرىء صدوق له أوهام حجة في القراءة وحديثه في الصحيحين مقرون من السادسة مات سنة ثمان وعشرين ع(@)(@@)(@@)(@@) $ 3055 عاصم بن حكيم أبو محمد بن أخت عبد الله بن شوذب صدوق من السابعة بخ د(@)(@@)(@@)(@@) $ 3056 عاصم بن حميد السكوني الحمصي صدوق مخضرم من الثانية د تم س ق(@)(@@)(@@)(@@) $ 3057 عاصم بن حميد الكوفي الحناط بمهملة ونون صدوق من السابعة تمييز(@)(@@)(@@)(@@) $ 3058 عاصم بن رجاء بن حيوة الكندي الفلسطيني صدوق يهم من الثامنة د ت ق(@)(@@)(@@)(@@) $ 3059 عاصم بن سفيان بن عبد الله الثقفي صدوق من الثالثة 4(@)(@@)(@@)(@@) $ 3060 عاصم بن سليمان الأحول أبو عبد الرحمن البصري ثقة من الرابعة لم يتكلم فيه إلا القطان فكأنه بسبب دخوله في الولاية مات بعد سنة أربعين ع(@)(@@)(@@)(@@) $ 3061 عاصم بن سويد بن عامر الأنصاري القبائي بضم القاف إمام مسجد قباء مقبول من السابعة س(@)(@@)(@@)(@@) $ 3062 عاصم بن شميخ بمعجمتين مصغرا أبو الفرجل بفتح الفاء والراء وتشديد الجيم اليمامي وثقه العجلي من الرابعة د(@)(@@)(@@)(@@) $$$ عاصم بن شنتم في ترجمة شقيق(@)(@@)(@@)(@@) $ 3063 عاصم بن ضمرة السلولي الكوفي صدوق من الثالثة مات سنة أربع وسبعين 4(@)(@@)(@@)(@@) $ 3064 عاصم بن عبد العزيز بن عاصم الأشجعي المدني صدوق يهم من الثامنة ت ق(@)(@@)(@@)(@@) $ 3065 عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب العدوي المدني ضعيف من الرابعة مات في أول دولة بني العباس سنة اثنتين وثلاثين عخ 4(@)(@@)(@@)(@@) $ 3066 عاصم بن عدي بن الجد بن العجلان الأنصاري صحابي شهد أحدا مات في خلافة معاوية وقد جاز المائة وفي الصحيح حكاية بن عباس عنه قصة الملاعنة 4 PageV01P285(@)(@@)(@@)(@@) $ 3067 عاصم بن علي بن عاصم بن صهيب الواسطي أبو الحسن التيمي مولاهم صدوق ربما وهم من التاسعة مات سنة إحدى وعسرين خ ت ق(@)(@@)(@@)(@@) $ 3068 عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب العمري أبو عمر المدني ضعيف من السابعة وهو أخو عبيد الله العمري ت ق(@)(@@)(@@)(@@) $ 3069 عاصم بن عمر بن الخطاب جد 
ms220	 الذي قبله ولد في حياة النبي صلى الله عليه وسلم مات سنة سبعين وقيل بعدها خ م د ت س(@)(@@)(@@)(@@) $ 3070 عاصم بن عمر بن عثمان مجهول من السابعة وقيل هو الذي بعده ق(@)(@@)(@@)(@@) $ 3071 عاصم بن عمر بن قتادة بن النعمان الأوسي الأنصاري أبو عمر المدني ثقة عالم بالمغازي من الرابعة مات بعد العشرين ومائة ع(@)(@@)(@@)(@@) $ 3072 عاصم بن عمر أو بن عمرو حجازي ثقة من الثالثة ت س(@)(@@)(@@)(@@) $ 3073 عاصم بن عمرو أو بن عوف البجلي الكوفي قدم الشام صدوق رمي بالتشيع من الثالثة ق(@)(@@)(@@)(@@) $ 3074 عاصم بن عمير وهو بن أبي عمرة العنزي بمهملة ونون مفتوحتين مقبول من الرابعة د ق(@)(@@)(@@)(@@) $ 3075 عاصم بن كليب بن شهاب بن المجنون الجرمي الكوفي صدوق رمي بالإرجاء من الخامسة مات سنة بضع وثلاثين خت م 4(@)(@@)(@@)(@@) $ 3076 عاصم بن لقيط بن صبرة بفتح المهملة وكسر الموحدة العقيلي بالتصغير ثقة من الثالثة بخ 4(@)(@@)(@@)(@@) $ 3077 عاصم بن لقيط بن عامر بن المنتفق بضم الميم وسكون النون وفتح المثناة وكسر الفاء العقيلي قيل هو الذي قبله ثقة من الثالثة أيضا د(@)(@@)(@@)(@@) $ 3078 عاصم بن محمد بن زيد بن عبد الله بن عمر بن الخطاب العمري المدني ثقة من السابعة ع(@)(@@)(@@)(@@) $ 3079 عاصم بن المنذر بن الزبير بن العوام الأسدي المدني صدوق من الرابعة د ق(@)(@@)(@@)(@@) $$$ عاصم بن منصور الأسدي في حصين(@)(@@)(@@)(@@) $$$ عاصم بن أبي النجود هو بن بهدلة تقدم(@)(@@)(@@)(@@) $ 3080 عاصم بن النضر بن المنتشر الأحول التيمي أبو عمر البصري وقيل هو عاصم بن محمد بن النضر صدوق من العاشرة م د س(@)(@@)(@@)(@@) $ 3081 عاصم بن هلال البارقي أبو النضر البصري إمام مسجد أيوب فيه لين من السابعة س(@)(@@)(@@)(@@) $ 3082 عاصم بن يوسف اليربوعي أبو عمرو الخياط الكوفي ثقة من كبار العاشرة مات سنة عشرين خ ت س(@)(@@)(@@)(@@) $ 3083 عاصم العدوي الكوفي عن كعب بن عجرة وثقه النسائي من الثالثة ت س PageV01P286(@)(@@)(@@)(@@) $ 3084 عافية بفاء وتحتانية بن يزيد بن قيس القاضي الأودي 