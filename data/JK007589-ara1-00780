ms761	 يهرب من خيل تخال بها % % عقبان مبردة يطلبن إلجافا % % PageV01P2982 462(@)(@@) % دوخن شيبان أما في رؤوسهم % تدوي الطبيب إذا أغشاه مجرافا % % 463(@)(@@) % وقلن ذوقوا جناكم إن جانيكم % ما زال للحنظل الخطبان نقافا % % 464(@)(@@) % كم جاهل كان بالطائي جربه % % صلا إذا طلب الأعداء زحافا % % 465(@)(@@) % يحرم الغسل إيلاء ويطلقه % % برا فيوخفه بالثأر إيخافا % % 466(@)(@@) % ووقعة منه في الأعراب قد جعلت % أوطانهم إسوة الأحقاف أحقافا % % 467(@)(@@) % تحالفوا مذ تحداهم فخلتهم % % على الهزائم لا الإقدام أحلافا % % 468(@)(@@) % ظلوا قتيلا ومصفودا وذا هرب % تقضي بإدراكه الطير التي اعتافا % % 469(@)(@@) % أسير قتل وإن أضحى طليق يد % قد أزهقت نفسه الآجال إزهافا % % 470(@)(@@) % ومن سرت نقم الطائي تطلبه % % ألفى الذي وعدته الفوت مخلافا % % 471(@)(@@) % يا هاربا منه إن الليل غاشية % لا بد منها وإن أوشكت إحصافا % % PageV01P2983 472(@)(@@) % كيف النجاء لناج من أخي طلب % مثل الظلام إذا ما عم أغدافا % % 473(@)(@@) % كأنما كل نفس حين يطلبها % % قد أعلقت سببا منه وخطافا % % 474(@)(@@) % فاطلب رضاه وأيقن أن سخطته % % لا حرز منها إذا طوفانها طافا % % 475(@)(@@) % تلق ابن حرين لا تلقاه مجترما % فظا على مستميح العفو حلافا % % 476(@)(@@) % بل سيدا قرنت بالحلم حفظته % % فلم تفز قط إلا كان ميقافا % % 477(@)(@@) % يهم بالطول همام به عجلا % وإن أراد عقابا كف كفافا % % 478(@)(@@) % يسوس نفسا على الأغياظ صابرة % ه ما زال يؤلفها الكروه إيلافا % % 479(@)(@@) % مغفل حين يستعفى وتحسبه % % عند انتقاد وجوه الناس صرافا % % 480(@)(@@) % تلقاه للعيب ستارا وإن دمست % ظلماء لاقيته للغيب كشافا % 481(@)(@@) % إذا ارتأى تبعت آثاره سددا % لا كالذي يتبع الآثار مقتافا % % PageV01P2984 482(@)(@@) % ما إن يزال له رأي يصيب به % % لو أنه حيوان كان عرافا % % 483(@)(@@) % تخاله باتقاء الذنب متقيا % في يوم هيجاء مرداة وقذافا % % 484(@)(@@) % يخشى الملام ويغشى الحرب مرتديا % فيها رداء من الكتاب هفهافا % % 485(@)(@@) % لم يلفه الغمز خوارا وتعطفه % % بالرفق منك فتلقى منه عطافا % % 486(@)(@@) % يلين للريح إن هزته لينة % ولا يلين إذا هزته معصافا % % 487(@)(@@) % لا يترك الحق مغبونا لسائمه % % خسفا ولا يتعدى الحق حيافا 
ms762	 % % 488(@)(@@) % كم قد أعد لقوم حسن مقدرة % وكم يعدون أكفافا وأجدافا % % 489(@)(@@) % قراهم الصفح إذ حلوا بعقوته % % وأتبع الصفح إكراما وإلطافا % 490(@)(@@) % لم يعد أن أرعف الأقلام يرفدهم % % ولو عتوا رعف الخرصان إرعافا % % 491(@)(@@) % جاءوا يخافون نارا لا خمود لها % % فأزلفت لهم الجنات إزلافا % % PageV01P2985 492(@)(@@) % لكن تطارد كي يغتر مارقة % أخرى إذا ما دهاها كر عطافا % % 493(@)(@@) % ورائد قال ألفينا خلائقه % % كالشهد طعما ومثل المسك مستافا % % 494(@)(@@) % خلائق علمتنا كيف نمدحه % % ورققتنا وكنا قبل أجلافا % % 495(@)(@@) % كم قد بدأنا وعاودنا فأوسعنا % % بذلا ولم نستطع للبحر إنزافا % % 496(@)(@@) % بحر من العرف لا تلقى الظماء به % % محلئين ولا الوراد عيافا % % 497(@)(@@) % تمت معانيه منه في امرىء نصف % زوال أطال على الأحوال توقافا % % 498(@)(@@) % قد سن شفرتيه البأس بغيته % % وشاف من صحفتيه الجود ما شافا % % 499(@)(@@) % كذا الأهلة تستوفي محاسنها % % إذا نضت ما شهور الحول أنصافا % % 500(@)(@@) % ممن يرى كل ما يفنى بمنزلة % سيان ما التذ منها والذي عافا % % 501(@)(@@) % لا بالمروع إذا أهوالها عظمت % ولا المروق إذا زيافها زافا % % PageV01P2986 502(@)(@@) % تبلو به محنة الدنيا وفتنتها % % طودا كهمك إرساء وإشرافا % % 503(@)(@@) % لا يستخف لدى ريح تهب له % % ولا عليه ولا تلقاه رجافا % % 504(@)(@@) % يجن قلبا وقورا في جوانحه % % مستنفرا عند ذكر الله وجافا % % 505(@)(@@) % لا عيب فيه سوى عتق يرد به % % عتق الجواد إذا جاراه إقرافا % % 506(@)(@@) % كم رام ذو الجد والأجداد غايته % فقام ذو الجد والأجداد زحافا % % 507(@)(@@) % يا ذا العلاء الذي أرسى قواعده % % على الحضيض وجاز النجم أعرافا % % 508(@)(@@) % أما وقدرك إن الله عظمه % % لقد غدا فوق ما خولت أضعافا % % 509(@)(@@) % وما رمتك يد بالحظ خاطئة % كلا لعمري وما أعطتك إسرافا % % 510(@)(@@) % وما أرى الناس أمرا أنت صاحبه % ظهرا تبدل بالإسراج إيكافا % % 511(@)(@@) % فاسلم على الدهر في نعماء سابغة % حتى يمسيك العصران إدلافا % % PageV01P2987 512(@)(@@) % من كان أصبح ظلاما لسوقته % % من الملوك فقد أصبحت منصافا % % 513(@)(@@) % لا تترك الدهر مغرورا بغرته % % ولا ترى للصحيح الجلد قرافا % % 514(@)(@@) % ما كابد الأسر عان في 
ms763	 يدي زمن % % إلا رجا بك فاء واصلت كافا % % 515(@)(@@) % ولا وأى عنك حسن الظن موعده % إلا غدت وهي حاء واصلت قافا % % 516(@)(@@) % وعائب لك بالإسراف قلت له % % لا زلت عن حسن الأفعال صدافا % % 517(@)(@@) % أصبحت في رفضك الإسراف محتقبا % أجر امرىء آف منه النجل ما آفا % % 518(@)(@@) % عوضت من وزر مجد أجر منقصة % بلوى من الله فاترك ذكر من عافى % % 519(@)(@@) % ماذا تعيب لحاك الله من ملك % لم يرض قط من المعروف سفسافا % % 520(@)(@@) % أنال حتى أعف الملحفين معا % بنائل سد أفواها وأجوافا % % 521(@)(@@) % إن كان أثبت بالإسراف سيئة % فقد محاها بأن لم يبق إلحافا % % PageV01P2988 522(@)(@@) % أهلا بمعصية باءت بمعصية % وعمت الناس إغناء وإعفافا % 523(@)(@@) % وهائب لك لم يسألك قلت له % % دع عنك عجزك لا يعقبك تلهافا % % 524(@)(@@) % سل الأمير ولا تحرمك هيبته % % فقد غدا لجبال المال نسافا % % 525(@)(@@) % سله وإن عز واستعلت مراتبه % % وكان حدا على الأعداء جلافا % % 526(@)(@@) % لا يؤيسنك غدق من جرامته % % وإن سما واستحد الشوك والتافا % % 527(@)(@@) % فليس تمنع مما فيه منعته % إلا إذا خرق الخراف خرافا % % 528(@)(@@) % إليك رادفت عزمي فوق ناجية % كالريح تعصف بالركبان إعصافا % % 529(@)(@@) % أرسى عليك قتود الرحل أن خلقت % % أخف ما دب فوق الأرض إخفافا % % 530(@)(@@) % تقلب الليل عينا غير نائمة % ومنسما بحصى المعزاء خذافا % % 531(@)(@@) % سفينة من سفين البر محكمة % تجري إذا ما اتخذت السوط مجدافا % % PageV01P2989 532(@)(@@) % جاءت بعساف أهوال على ثقة % أن سوف تلقاك للأموال عسافا % % 533(@)(@@) % أهدى إليك هديا من كرائمه % % يحفها حشد الآمال زفافا % % 534(@)(@@) % حسناء معجبة للناس مطربة % لا تستعين على الإطراب عزافا % % 535(@)(@@) % من سيدات القوافي ما يزال لها % % راو تظل به السادات حفافا % % 536(@)(@@) % ملي من الحمد والتحميد حاملة % ألطاف حر يرجي منك ألطافا % % 537(@)(@@) % أهدى غرائب يرجو أن تحوز له % % غربا يرويه من جدواك غرافا % % 538(@)(@@) % أذال فيها لك النفس التي لقيت % % من العفاف وطول الظلف إقشافا % % 539(@)(@@) % فحاكها والذي يبغي كفايته % % وإن شتا غيره في الريف أوصافا % % 540(@)(@@) % حوك امريء لم يكن 
ms764	 من قبل مكتسبا % بالشعر سألة للناس ملحافا % % 541(@)(@@) % كخصف آدم من أوراق جنته % % ولم يكن قبل ذاك الخصف خصافا % % PageV01P2990 542(@)(@@) % كساك من زينة الدنيا لتكسوه % % من سترها فاكسه ياخير من كافا % % 543(@)(@@) % وافعل به غير مأمور بعارفة % فعلا يزف نعام الشكر إزفافا % % 544(@)(@@) % أطرفه بالجود في دهر غدا عطلا % من كل عرف فلم يعدمك إطرافا % % 545(@)(@@) % من كان أغضبه قولي وآسفه % فزاده الله إغضابا وإيسافا % 546(@)(@@) % وليحذر الشاعر العريض بادرتي % % فربما صادق العريض حذافا % % 547(@)(@@) % لا يجهلن حليم إنني رجل % من كان أخطل جهل كنت جحافا % % PageV01P2991 البحر : - 1(@)(@@) % رحم الله صالح بن وصيف % فلقد كان جد شهم ظريف % % 2(@)(@@) % كان لا يصطفي المخنث خدنا % بل يراه مثل الكنيف المجيف % % 3(@)(@@) % معشر قربهم من الناس عر % لصحيح وقذرة لنظيف % % 4(@)(@@) % فادحروا عنكم المخانيث دخرا % وليوكل بذاك كل شريف % % PageV01P2992 البحر : - 1(@)(@@) % أبى لأخي الدنيا التبتل أنها % % لها زيفة في كل حين تزيفها % % 2(@)(@@) % إذا ما جلاها في الرياض ربيعها % % يروق عيون الناظرين رفيفها % % 3(@)(@@) % وأخرى إذا ما أينعت ثمراتها % % ورقت حواشيها وطاب خريفها % % 4(@)(@@) % تراءى لنا في زخرفين كليهما % % إذا استوجف الأهواء خف وجيفها % % PageV01P2993 البحر : - 1(@)(@@) % الدين والعلم والنعماء والشرف % تأبى لجارك أن يمنى له التلف % 2(@)(@@) % مؤيدات من الأركان أربعة % يأوي إليهن محروم ومضطعف % 3(@)(@@) % أبا علي وأنت المرء ليس لنا % % جار سواه إذا خفنا ولا كنف % 4(@)(@@) % أشكو إليك ظلامات يتابعها % % من ليس يحسن منه الظلم والجنف % 5(@)(@@) % مؤملي والذي أشجي الخطوب به % % أضحى وأمسى وأدنى ظلمه سرف % 6(@)(@@) % أظلني سوء رأي منه متصل % وليس لي من بلاء سيء سلف % 7(@)(@@) % إلا مدائح ما تنفك سائرة % لركبها كل يوم نية قذف % 8(@)(@@) % وخدمة سبقت أيام دولته % % ما مثلها زلفة إن عدت الزلف % % 9(@)(@@) % يممته إذ وجوه الناس كلهم % فيها إلى الجانب المعمور منصرف % 10(@)(@@) % مازلت ممتطيا تلقاءه قدمي % % لا يطبيني عنه السعي والحرف % PageV01P2994 11(@)(@@) % أهدي له الأنس في أيام وحشته % % وعندي الصبر والتأميل والظلف % 12(@)(@@) % لا أجتديه ولا أمتاح نائله 
ms765	 % % ولا أزول ولي في الأرض مصطرف % 13(@)(@@) % حتى إذا فتح الله الفتوح له % % أصبحت لولا استتاري كدت أختطف % 14(@)(@@) % ظلما توحدني منه بلا سبب % % وليس لي منه أن حاكمت منتصف % 15(@)(@@) % تظاهرت غمم سود وليس لها % % إلا بوجهك بعد الله منكشف % 16(@)(@@) % ولم تزل يا ابن بدر بدر مضحية % يبدو فينجاب للساري به السدف % 17(@)(@@) % فداو حالي بما فيه مصحتها % % فإن حالي حال داؤها الدنف % 18(@)(@@) % كلم رئيسي كلاما في تعطفه % % إن الكرام إذا ما استعطفوا عطفوا % % 19(@)(@@) % وليس دهري إلا أن يتاركني % % بحيث لا جفوة منه ولا لطف % 20(@)(@@) % لا رغبة عن مطيف بالمطيف به % % لكن نفسي شموس حين تعتنف % PageV01P2995 21(@)(@@) % وإنني لبصير العين ثاقبها % % أن لا نظير له في الناس يؤتنف % 22(@)(@@) % لكنه عم تجويدا وتوفية % وخصني منه سوء الكيل والحشف % 23(@)(@@) % وإنني للضنين القبضتين به % % وللضنين بقدري حين أعتسف % 24(@)(@@) % وإن تركي حظا من صحابته % % لحاجة قرنت في النفس والأسف % 25(@)(@@) % ممن لحاني بظهر الغيب قلت له % % لا تشغلنك عن أعمالك الكلف % 26(@)(@@) % مولاي لا عوض منه ولا خلف % والقدر لا عوض منه ولا خلف % 27(@)(@@) % ها إنها خطبة قام الخطيب بها % % بكر ولكنها في حزمها نصف % 28(@)(@@) % وقد قصدتك كالصادي أليح له % % في مهمه ماء مزن صانه رصف % 29(@)(@@) % فليس لي يا ابن بدر عنك منصرف % ولا بودي وشكري عنك منحرف % 30(@)(@@) % وكيف لي بخلاف فيك أركبه % وليس في فضلك المشهور مختلف % PageV01P2996 31(@)(@@) % فاحشد لغائر قدر إن حشدت له % % نما وزاد وإلا فهو منتسف % 32(@)(@@) % يامن إذا ماأناخ المستضام به % % أضحى يقاتل عنه العز والأنف % 33(@)(@@) % يامن إذا اهتضم القدر استقاد له % % فلم يبت وهو مطلول ولا طلف % 34(@)(@@) % ما عفر شابة في أعلى معاقله % % ولا عقاب شرورى ضمها لجف % 35(@)(@@) % يوما بأمنع مني يوم تمنعني % % كلا ولا قسور في أذنه غضف % 36(@)(@@) % دوني الدروع إذا ماكنت لي وزرا % والبيض والبيض والخطي والحجف % % 37(@)(@@) % فإنني لعزيز يوم تنصرني % % وفيك عند اعتداء الدهر منتصف % 38(@)(@@) % يا أبعد 
ms766	 الناس غورا حين نسبره % % وأقرب الناس غورا حين يغترف % 39(@)(@@) % أصبحت بحر غناء غير منتزف % لاقاه بحر ثناء ليس ينتزف % 40(@)(@@) % فالفظ بدر نثير ما له صدف % ألفظ بدر نظيم ما له صدف % PageV01P2997 41(@)(@@) % كن لي كما كنت للراجين كلهم % لازال قصرك بالراجين يكتنف % 42(@)(@@) % قل للكرام بني وهب معاقلنا % % قولا يقربه طوعا ويعترف % 43(@)(@@) % العادلين موازينا إذا حكموا % % والراجحين إذا ما شالت الكفف % 44(@)(@@) % يا آل وهب أدام الله دولتكم % % لقد رعيتم فلا خوف ولا عجف % 45(@)(@@) % حتى غدوتم لآمال الورى قبلا % لها عليها طوال الدهر معتكف % 46(@)(@@) % فما لعبدكم المسكين بينكم % كأنه لمرامي دهره هدف % 47(@)(@@) % وأنتم النخلة الطولى التي بسقت % قدما وبورك منها الأصل والطرف % 48(@)(@@) % ولم تزل لي آمال مسلفة % وفيكم الآن للخراف مخترف % 49(@)(@@) % فإن زوى عني الجمار طلعته % % فلا يصبني بحدي شوكه السعف % 50(@)(@@) % أمري وأمركم باز على علم % مرمق بعيون الناس مشترف % PageV01P2998 51(@)(@@) % فالله الله في أحدوثة حسنت % لا تهدموها بظلم إنها الشرف % PageV01P2999 البحر : - 1(@)(@@) % زلقت في سلاحها % % بالبطبطين شنطف % 2(@)(@@) % ثم قفت بضرطة % لم يعقها توقف % 3(@)(@@) % ضرطة تسكت الرعو % % د وفيها تقصف % 4(@)(@@) % ثم قامت مدلة % تتشاجى فتعنف % 5(@)(@@) % قيل قومي إلى الصرا % % ة فهذا تكلف % 6(@)(@@) % ما مع الحالة التي % % أنت فيها تظرف % 7(@)(@@) % ما التشاجي بطيب % منك والسلح ينطف % 8(@)(@@) % فمضت تقصد الصرا % % ة وفيها تكسف % 9(@)(@@) % ولأذيالها على % % قدميها تلفف % 10(@)(@@) % وتداعت لها الأكف % ف وفيها تعجرف % PageV01P3000 11(@)(@@) % أخذ الصفع رأسها % % وهي تعدو وتقطف % 12(@)(@@) % فانقضى ذلك التشا % % جي وزال التصلف % % 13(@)(@@) % قردة تدعي الغنا % % ء وفيها تخلف % 14(@)(@@) % قحبة تركب الأ % % ر وفيها تعسف % 15(@)(@@) % ليس في أنفس الكرا % % م إليها تشوف % 16(@)(@@) % ذات طيز بظوره % أبد الدهر تنقف % 17(@)(@@) % يبلغ الفيل والبعي % % ر وفيه تلهف % % 18(@)(@@) % كعصا صاحب العصا % % جل ذاك التلقف % % 19(@)(@@) % تطعم الأير تينة % قد علاها التحشف % 20(@)(@@) % طالبتني بأن أني % % ك وعندي تعفف % PageV01P3001 21(@)(@@) % قلت هيهات أو يحل % % ل لأير التكفف % % 22(@)(@@) % حرم 
ms767	 النيك أو يطي % % ب مبال وينظف % 23(@)(@@) % ومن الفائت الذي % % ما عليه تأسف % 24(@)(@@) % نيك سوداء كالدجى % % حين يدجو ويكثف % 25(@)(@@) % حليها الشيب لا أكا % % ليل تحلو وتطرف % 26(@)(@@) % فعلى الوجه كرفس % % وعلى الرأس كرسف % 27(@)(@@) % منظر لا يروق عي % % نا وإن كان يطرف % 28(@)(@@) % كان للحسن يوسف % وهي للقبح يوسف % 29(@)(@@) % يضع الشتم قبحها % % وهي بالشتم تشرف % 30(@)(@@) % تجحد الله ربها % % وعلى الأير تعكف % PageV01P3002 31(@)(@@) % مسح شيراز عينها % % شغلها والتنغف % 32(@)(@@) % وغدة لم يزل لها % % بالمخازي تشرف % 33(@)(@@) % لو غدت وهي كعبة % ما استحل التطوف % 34(@)(@@) % همها الدهر مدمج % لحفافيه أحرف % 35(@)(@@) % هرمت فهي في قيو % % د من الكبر ترسف % 36(@)(@@) % يا أبا القاسم الذي % % في ذراه التضيف % 37(@)(@@) % والذي لم يزل له % % في المعالي تصرف % 38(@)(@@) % والذي لم يزل يجل % ل ومعناه يلطف % 39(@)(@@) % قد شتونا فكم نصي % ف طال التصيف % 40(@)(@@) % فاكفنا برد قردة % % تتشاجى فتسخف % % PageV01P3003 البحر : - 1(@)(@@) % بنفسي أمير أنصف الناس كلهم % % سواي فإني لست في ذاك أنصف % 2(@)(@@) % أتى المطل والتسويف دون ثوابه % % وعهدي به قبل المديح يسلف % 3(@)(@@) % أؤمل في النيروز ربعي جوده % % وخرفيه في المهرجان فأخلف % 4(@)(@@) % وما خلت أني أستريث سماءه % % ويربع غيري من جناها ويخرف % PageV01P3004 البحر : - 1(@)(@@) % إذا تطاولت فاذكر % % أن الرياح ستعصف % 2(@)(@@) % وأن كل طويل % هبت له متقصف % 3(@)(@@) % فالدهر إن جرت يوما % يديل منك وينصف % % PageV01P3005 البحر : - 1(@)(@@) % أيها الماجد الذي بهر المد % داح مجدا وجاوز الأوصافا % % 2(@)(@@) % لا عدمت الفلاح ياجامع البر % ر مسيرا ومنتوى وانصرافا % % 3(@)(@@) % طفت بالبيت ثم أبت من الحج % ج فأصبحت للعفاة مطافا % % 4(@)(@@) % زرت بغداد زورة الغيث أغفى % % بالقرى وهو زائر فأضافا % % 5(@)(@@) % وكفت بالندى يداك على النا % % س وما زلت عارضا وكافا % % 6(@)(@@) % فتعدوا على الزمان بعدوا % % ك وكانوا لا يأملون انتصافا % % 7(@)(@@) % قلت لما رأيت ملتمسي % % عرفك عرفا إليك بل أعرافا % % 8(@)(@@) % نصر الله سيدا أصبح الناس % % س على صلب ماله أحلافا % % 9(@)(@@) % ولعمري لقد نصرت بأن % % عوضت حمدا وجنة ألفافا 
ms768	 % % 10(@)(@@) % ولئن أتلفت يميناك عرضا % لبعرض وقيته الإتلافا % % PageV01P3006 11(@)(@@) % ودعاني يا ابن الملوك إلى فض % لك فضل بذلته إسرافا % % 12(@)(@@) % فأعذني من أن أرى بين ظني % % ويقيني في ما رجوت اختلافا % % 13(@)(@@) % أو أرى المجد قاعدا لي عن % % كفك وعدا مثمرا إخلافا % % 14(@)(@@) % وأنلني يا من رأيت سؤالي % % ه سواء في نيله والعفافا % % 15(@)(@@) % لا يكن حسرة نداك على النف % % س فأقنى الغنى وأرضى الكفافا % % 16(@)(@@) % وكفاني بها وعيدا لواع % % صان حوض المعروف عن أن يعافا % % 17(@)(@@) % يعتدي سيدا مرجى مخوفا % فإذا أسخط المرجين خافا % % 18(@)(@@) % ليست الإمرة التي تتولى % % بالهوينا فلا تسسها جزافا % % 19(@)(@@) % إنما إمرة الجواد على الأح % % رار فاعدل وأعمل الإنصافا % % 20(@)(@@) % لا تدع معشرا سمانا يكظو % % ن سمانا وآخرين عجافا % % PageV01P3007 21(@)(@@) % أعقب المجدبين من أهل خصب % % قد رعوا روضك المريع ائتنافا % % 22(@)(@@) % وأدل معطشيك من أهل ري % شربوا العرف من يديك سلافا % % 23(@)(@@) % أو تطول على الجميع فقد أو % % تيت عند اكتنافهم أكنافا % % 24(@)(@@) % أنت نعم المضيف والناس أضيا % % فك فاعمم ببرك الأضيافا % % 25(@)(@@) % فحرام عليك تبدية الأذ % ناب حتى تقدم الأعرافا % % 26(@)(@@) % ومن الجور والعنود عن الحق % ق وبعض الأحكام تجري اعتسافا % % 27(@)(@@) % شاعر سلف الثناء وأكدى % % وابن صمت يسلف الأسلافا % % 28(@)(@@) % لا يخيبن ناظم لك سمطا % بات يفري عن دره الأصدافا % % 29(@)(@@) % صن مديحي ومطلبي عن أناس % لم أزل عن لقائهم صدافا % % 30(@)(@@) % جعلوا قبلة الرجاء وصدوا % بجدواهم فبدلوا أهدافا % % PageV01P3008 31(@)(@@) % معشر ينكرون معرفة العر % ف ويأبى هناك إلا اعترافا % % 32(@)(@@) % فليعظك امرؤ غدا في يديه % % حسب مبتلى ومال معافى % % 33(@)(@@) % صاف دون الأموال عرضك واعلم % % أنه دون بذلها لن يصافى % % 34(@)(@@) % لا وعيدا أقول ذاك ولكن % % قلت حاء من المقال وقافا % % 35(@)(@@) % أن أهل القريض طورا يرقو % % ن وطورا تراهم أجلافا % % 36(@)(@@) % وإذا أسخطوا رأوا ذم سابو % % ر ولو كان ينزع الأكتافا % % 37(@)(@@) % هم إذا شئت نحل شهد % وإن شئت أفاع رقش تمج الزعافا % % 38(@)(@@) % لا يكونن ما سمعناه من جو % % دك في 
ms769	 كل محفل أرجافا % % PageV01P3009 البحر : - 1(@)(@@) % شهدت بعض المخاني % % ث والطريف طريف % 2(@)(@@) % فقام من جنب عمرو % وللشقي حفيف % 3(@)(@@) % فقلت أنى ولم قم % ت خائفا يا سخيف % 4(@)(@@) % فقال لا تلحيني % % فأنف عمرو مخيف % 5(@)(@@) % فقلت صحف مخيفا % فأنف عمرو مجيف % 6(@)(@@) % بل أنف عمر و وفوه % بالوعة وكنيف % % 7(@)(@@) % فقال رأي قوي % رآه شيخ ضعيف % 8(@)(@@) % إن كان عمرو رأى مث % % له فعمرو حنيف % PageV01P3010 البحر : - 1(@)(@@) % إن اليزيديين قوم أحرزوا % % إرث الخلافة ليس فيه خلاف % 2(@)(@@) % قوم عناقفهم لحى ولحاهم % ريح ولكن العقول ضعاف % PageV01P3011 البحر : - 1(@)(@@) % يا شريفا لقرنه إشراف % وطريفا له بنات طراف % 2(@)(@@) % ناطح الأيل المقرن والكب % % ش مع الكركدن ليس تخاف % PageV01P3012 البحر : - 1(@)(@@) % ولوطي قدام وخلف عذلته % % فقال أخو العوجاء قولا مثقفا % % 2(@)(@@) % أنا السيف ذو الحدين تمت صرامتي % % ولست كمثل السيف ذي الحد والقفا % % PageV01P3013 البحر : - 1(@)(@@) % لها جبهة فيها سطوح نصيف % وصدغ لها غال بنصف رغيف % 2(@)(@@) % كأن بقايا المسك في صحن خدها % % بقايا سماد في جدار كنيف % % PageV01P3014 البحر : - 1(@)(@@) % يا درة البحر ضمها الصدف % ويا هلالا من دونه السدف % 2(@)(@@) % قلبي عن العالمين منصرف % وليس لي عن هواك منصرف % 3(@)(@@) % حتام لا نلتقي على دعة % وطيب عيش منا فنأتلف % PageV01P3015 البحر : - 1(@)(@@) % الزب زب للنسا % % ء يمقنه ويخفنه % 2(@)(@@) % أصبحن يستحلينه % % جدا ويستنظفنه % % 3(@)(@@) % أعظمنه فدعونه % % ريا وإن صحفنه % % 4(@)(@@) % لو يستطعن أكلنه % من شهوة ورشفنه % PageV01P3016 البحر : - 1(@)(@@) % رأيتك بينا أنت خل وصاحب % إذا أنت قد وليتنا ثانيا عطفا % % 2(@)(@@) % فإنك إذ أحنى حنوك معقب % بعادا لمن باذلته الود والعطفا % % 3(@)(@@) % لكالقوس أحنى ما تكون إذا حنت % على السهم أنأى ماتكون له قذفا % % PageV01P3017 البحر : - 1(@)(@@) % هبا خليلي قد قضيتما وطرا % من الكرى فاستعيضا لذة أنفا % % 2(@)(@@) % لا تبلغا الدهر أقصى إربة لكما % % فاستبدلا لكما من آخر طرفا % % PageV01P3018 البحر : - 1(@)(@@) % إذا فقت الضئيل بحسن جسم % فلا يسبقك بالشيم الشريفه % 2(@)(@@) % فيصبح أفضل الرجلين جسما % وتصبح أعظم الرجلين جيفه % % PageV01P3019 البحر : - 1(@)(@@) % قد قلت إذ مدحوا الحياة فأكثروا 
ms770	 % % للموت ألف فضيلة لا تعرف % 2(@)(@@) % فيه أمان لقائه بلقائه % % وفراق كل معاشر لا ينصف % % PageV01P3020 البحر : - 1(@)(@@) % وليس نسيم المسك ريح حنوطه % ولكنه ذاك الثناء المخلف % 2(@)(@@) % وليس صرير النعش ماتسمعونه % % ولكنه أصلاب قوم تقصف % PageV01P3021 البحر : - 1(@)(@@) % تسدي الفتى الأقدار من حيث لا يرى % % ويخطئه مظنونها ومخوفها % % PageV01P3022 البحر : - 1(@)(@@) % ثلاثة أشياء بها الهم يكشف % % تميل إليها النفس مني وتصرف % 2(@)(@@) % شراب وبستان وقطر سحابة % إذا قطرت أنواؤها ليس تخلف % 3(@)(@@) % ورابعة راح براحة شادن % بوجنته التفاح بالشم يقطف % 4(@)(@@) % وخامسة وصل الحبيب فإنه % % لذيذ وأما غيرها فتكلف % PageV01P3023 البحر : - 1(@)(@@) % سقى الله قصرا بالرصافة شاقني % % باعلاه قصري الدلال رصافي % % 2(@)(@@) % أشار بقضبان من الدر قمعت % يواقيت حمرا تستبيح عفافي % % PageV01P3024 البحر : - 1(@)(@@) % كلانا واجد في النا % % س ممن حله خلفا % % PageV01P3025 البحر : - 1(@)(@@) % حبذا حشمة الصديق إذا ما % % حجزت بينه وبين العقوق % 2(@)(@@) % حين لا حبذا انبساط يؤدي % % ه إلى بخس واجبات الحقوق % 3(@)(@@) % وكلت حاجتي إليك فأضحت % % وهي مني بموضع العيوق % 4(@)(@@) % وجعلت الصديق أولى بأن يل % % غى ويرضى بخلبات البروق % 5(@)(@@) % أحمد الله ما وردت من الإخ % % وان غير المكدر المطروق % % 6(@)(@@) % وإلى الله أشتكي أن ودي % % ليس ممن وددت بالمرزوق % % 7(@)(@@) % مقتي غير وامق تقرع القل % % ب فطوبى لوامق موموق % % 8(@)(@@) % كم ترى لي ذخيرة عند خل % سقطت من جرابه المخروق % % 9(@)(@@) % أيها المعشر الهداة إلى الرش % % د أبينوا لنا بيان الصدوق % % 10(@)(@@) % أين منجاتنا إذا ما لقينا % % من مسيغ الشجا شجا في الحلوق % % PageV01P3026 البحر : - 1(@)(@@) % قل للذين مدحتهم فكأنما % % مسخوا كلابا غير ذات خلاق % 2(@)(@@) % ردوا علي صحائفا سودتها % % فيكم بلا حق ولا استحقاق % 3(@)(@@) % ما كان مثلي مادحا أمثالكم % % لولا اتهامي ضامن الأرزاق % 4(@)(@@) % أسخطت خلاق البرية فيكم % فبلغتم مني رضى الخلاق % % 5(@)(@@) % أغرقت في نزعي لكم ولربما % % حرم الرماة الصيد بالإغراق % % PageV01P3027 البحر : - 1(@)(@@) % لا تشم للمزن برقا % % إن نأى المزن فسحقا % % 2(@)(@@) % وانتجع أفق بني حم % % اد الأندين أفقا % % 3(@)(@@) % شائما فيهم بروقا % من كريم صيغ طلقا 
ms771	 % % 4(@)(@@) % لبقا بالمجد طبا % خرقا بالمال خرقا % % 5(@)(@@) % يشتري الحمد فيغلى % % وهو الأربح صفقا % % 6(@)(@@) % شم بروق الحسن الأح % % سن أخلاقا وخلقا % % 7(@)(@@) % سيد من آل حما % % د مرعى ومسقى % % 8(@)(@@) % عم ألطافا وبرا % إذ جفا الدهر وعقا % % 9(@)(@@) % أصلح الله وأعلى % % آل حماد وأبقى % % 10(@)(@@) % وحباهم بنماء % يمحق الحساد محقا % % PageV01P3028 11(@)(@@) % فقأ الله عيونا % نحوهم خضرا وزرقا % % 12(@)(@@) % من أناس أصبحوا % % في دينهم سودا وبلقا % % 13(@)(@@) % خافقي الأحشاء طارت % تلكم الأحشاء خفقا % % 14(@)(@@) % حسدوا أذكى وأزكى % % أنفسا منهم وأتقى % % 15(@)(@@) % ولشتان لعمري % % بين من يهوي ويرقى % % 16(@)(@@) % ليس من يذهب علوا % مثل من يذهب عمقا % % 17(@)(@@) % آل حماد أناس % كرموا فرعا وعرقا % % 18(@)(@@) % جعلوا الأعراض بسلا % وعروض المال طلقا % % 19(@)(@@) % فإذا الغايات مدت % برزوا في المجد سبقا % % 20(@)(@@) % يابن بيت الحكم والحك % % مة والنعمة حقا % % PageV01P3029 21(@)(@@) % يابن من أصبح بين ال % % حق والباطل فرقا % % 22(@)(@@) % شهد الله يمينا % تنتق الأجيال نتقا % % 23(@)(@@) % أن إسماعيل يهدي % % هدي إسماعيل صدقا % % 24(@)(@@) % رب حكم منه قد أض % % حى لحكم الله وفقا % % 25(@)(@@) % ألجم الظلم فأدمى % % حنكا منه وشدقا % % 26(@)(@@) % يا عليا يتكنى % % بعلي عش موقى % 27(@)(@@) % كم فعال لك أضحى % % لعبيد القوت عتقا % % 28(@)(@@) % ثم لم تتركه حتى % % صار للأحرار رقا % % 29(@)(@@) % ليس عن عمد ليشقوا % % بك من دائك يشقى % % 30(@)(@@) % بل لك المن الذي أص % % بح للأعناق ربقا % % PageV01P3030 31(@)(@@) % كم نظير لك في الثر % % وة أكدى حين أبقى % % 32(@)(@@) % رحت كي تجبر عظما % وغدا ينهش عرقا % % 33(@)(@@) % والفتى الأوسع صدرا % يفضل الأوسع خلقا % % 34(@)(@@) % يابن إسماعيل فوزا % سدت من أفصح نطقا % % 35(@)(@@) % حسبنا بشرك برقا % وندى كفيك ودقا % % 36(@)(@@) % بخبخ أي سحاب % بخبخ ودقا وبرقا % % 37(@)(@@) % آل حماد غدوتم % أخصل الرامين وشقا % % 38(@)(@@) % هنأ الله ولي ال % عهد منكم ما تلقى % % 39(@)(@@) % فلقد لقي نصحا % منكم لم يك مذقا % % 40(@)(@@) % أنتم أصلحتم الشر % % ق وقد كان ملقى % PageV01P3031 41(@)(@@) % كادت الأرض تشقى % % من دماء وتسقى % % 42(@)(@@) % فسعيتم لصلاح ال % % أمر سعيا سد 
ms772	 بثقا % % 43(@)(@@) % ورفأتم فيه للمل % كة والدولة خرقا % % 44(@)(@@) % ورقيتم حية السل % % طان والحيات ترقى % % 45(@)(@@) % فرتقتم منه فتقا % وفتقتم منه رتقا % % 46(@)(@@) % وكشفتم ظلمات % لم تدع للناس شرقا % % 47(@)(@@) % لا عدمتم عند أمر % معضل رتقا وفتقا % 48(@)(@@) % تلك مسعاة أناس % جمعوا حزما ورفقا % % 49(@)(@@) % قرمطت في المجد أيد % ومشقتم فيه مشقا % % 50(@)(@@) % لست أختار على شق % ق أراكم فيه شقا % % PageV01P3032 51(@)(@@) % ما أرى مدحي لمجد % غير ذاك المجد لفقا % % 52(@)(@@) % أنتم الحكام والأع % لام والأعلون مرقى % % 53(@)(@@) % وبكم يستفتح الرز % ق من استفتح رزقا % % 54(@)(@@) % لو خلا الأبرار منكم % % أصبح المشرب رنقا % % 55(@)(@@) % أو خلا الفجار منكم % % ملأوا الآفاق فسقا % % 56(@)(@@) % فبقيتم لصلاح % بكم لا شك يبقى % % 57(@)(@@) % تفلقون الهام والأف % % هام بالأحكام فلقا % % 58(@)(@@) % توسعون الناس تنفي % % سا وأهل الظلم خنقا % % 59(@)(@@) % ما يسيء الرأي فيكم % رجل يحمل طرقا % % 60(@)(@@) % لا تعدوا حذق مطري % % كم وإن برز حذقا % % PageV01P3033 61(@)(@@) % إنما صادف درا % في بحور فتنقى % % 62(@)(@@) % منكم حلاكم الما % % دح ما جل ودقا % % 63(@)(@@) % وجد المجرى دميثا % فجرى لا يتوقى % % 64(@)(@@) % لو تعداكم لأعيا % % ما تأنى أو لشقا % % PageV01P3034 البحر : - 1(@)(@@) % لئن أصبحت محروما % نوالك غير مرزوقه % 2(@)(@@) % على أني صريح الود % دقدما غير ممذوقه % % 3(@)(@@) % لكم من وامق في النا % % س لا يحظى بموموقه % % 4(@)(@@) % ولست بأول العشا % % ق لم يسعد بمعشوقه % % PageV01P3035 البحر : - 1(@)(@@) % أرى الضيم ذلا على أنني % % أرى النصر من صاحب المن رقا % % 2(@)(@@) % فلا تسأل النصر إلا امرأ % تراه بنصرك يقضيك حقا % % 3(@)(@@) % لساء اتقاؤك إما اتقي % ت أن تستضام بأن تسترقا % % 4(@)(@@) % فكم للمظالم حمالة % وعش عيش حر ملقى موقى % % PageV01P3036 البحر : - 1(@)(@@) % وإني لذو حلف حاضر % إذا ما اضطررت وفي الحال ضيق % 2(@)(@@) % وهل من جناح على مرهق % يدافع بالله مالا يطيق % PageV01P3037 البحر : - 1(@)(@@) % صبرا أبا الصقر فكم طائر % خر صريعا بعد تحليق % 2(@)(@@) % زوجت نعمى لم تكن كفأها % فصانها الله بتطليق % 3(@)(@@) % وكل نعمى غير مشكورة % رهن زوال بعد تمحيق % % 4(@)(@@) % لا قدست 
ms773	 نعمى تسربلتها % % كم حجة فيها لزنديق % 5(@)(@@) % صبرا لهاج ذاد عنك الكرى % % وشاب دنياك بترنيق % % 6(@)(@@) % أرقه مدحك لا مجديا % فاقتص تأريقا بتأريق % % PageV01P3038 البحر : - 1(@)(@@) % يا ذا الذي ضن بمعروفه % % عني وقد قاسيت فيه الأرق % 2(@)(@@) % أقلني العثرة إني امرؤ % ما زلت في الصحو كثير الزلق % 3(@)(@@) % رضيت مما كنت أملته % بأجر وراقي وغرم الورق % 4(@)(@@) % فاجعلهما حظي وعجلهما % % وارض من المطل بما قد سبق % % 5(@)(@@) % إن جديد المطل مستقبح % وأقبح المطلين مطل خلق % % 6(@)(@@) % ولست أهجوك بشيء سوى % % إنشاد شعري فيك وسط الحلق % % 7(@)(@@) % وأن إذا استخبر مستخبر % ما ثوب المادح قلت القلق % % PageV01P3039 البحر : - 1(@)(@@) % ما للبضائع بين الناس كلهم % % غير الفياشل قد بارت بها السوق % 2(@)(@@) % والله لو أن قسطنطينة افتتحت % برمح أشجع من خبت به النوق % 3(@)(@@) % ما نال منها ولا من فضل نجدته % % ما نال من ثفر قسطنطينة الحوق % % 4(@)(@@) % تكدي الرماح ويكدى الذائدون بها % % لكن أير أبي العباس مرزوق % 5(@)(@@) % تراه يغدو فيغدو موكب زجل % % تردي الهماليج فيه والتعانيق % % 6(@)(@@) % إذ لا يرى لأبي العباس حينئذ % حق السلام لقد أزرى به الموق % % 7(@)(@@) % يزور كبرا وما أضعاف قيمته % % من الخساسة عند الله ثفروق % % 8(@)(@@) % هذا وليس عليه من غباوته % % بين السفين وبين الخيل تفريق % % 9(@)(@@) % أرى دم العلج يغلي في ترائبه % % على الحميم ولكن ليس مهريق % % PageV01P3040 البحر : - 1(@)(@@) % رجت منك نفسي سبقك الغيث بالندى % % فحم قضاء الله للغيث بالسبق % 2(@)(@@) % فكن ثانيا للغيث إذ كان بادئا % ولا تسبق الشأوين يا واحد الخلق % 3(@)(@@) % ولا تمتعض أن نسبق الغيث مرة % فما بين ذي سبق وتاليه من فرق % 4(@)(@@) % وأنت فتبقى الدهر والغيث ينقضي % % وتنهل بالجدوى وينهل بالودق % 5(@)(@@) % أبشر بلا جدوى وأنت مخيلة % مملأة بالماء صادقة البرق % 6(@)(@@) % وعش لملوك الناس ما ذر شارق % % لترتق في فتق وتفتق في رتق % % 7(@)(@@) % وتسمو إلى العلياء حتى تنالها % % وتستنبيء الغيب الخفي من العمق % % 8(@)(@@) % وتلقى وجوه الأولياء وحسبهم % % بوجهك ذاك الطلق في يومك الطلق % % PageV01P3041 البحر : - 1(@)(@@) % أبعد لقاي 
ms774	 دونك كل قفر % يعز الشخص فيه أن يلاقى % % 2(@)(@@) % وإعمالي إليك به المطايا % % وقد ضرب الظلام له رواقا % % 3(@)(@@) % ورفضي النوم إلا أن تراني % % أعانق واسط الكور اعتناقا % % 4(@)(@@) % تسوق بنا الحداة فليس ندري % % أشوقا كان ذلك أم سياقا % % 5(@)(@@) % أصادف ضرة المعروف شكري % % لديك ولا أذوق لها فواقا % % 6(@)(@@) % ففي أست أم الذي استرعاك خيلا % وأنت تقل أن ترعى عناقا % % 7(@)(@@) % وخولك الصهيل وكان منه % % كثيرا أن يسمعك النهاقا % % 8(@)(@@) % غدا يعلو الجياد وكان يعلو % % إذا ما استفره السبت الرقاقا % % 9(@)(@@) % أعنتها الشسوع فإن عراها % % حفاء الكد أنعلها طراقا % % 10(@)(@@) % فزوج بعد فقر منه نعمى % % أراني الله صبحتها الطلاقا % % PageV01P3042 البحر : - 1(@)(@@) % يا نجدة الروم في بطارقها % % وحكمة الروم في مهارقها % % 2(@)(@@) % هل فيكما نصرة مؤزرة % لزاهق النفس أو كزاهقها % % 3(@)(@@) % غيب عن عينه مغافصة % أفضل ما اعتده لفاتقها % % 4(@)(@@) % يا حر صدري على الخطوب وما % % تطويه بالغيب من بوائقها % % 5(@)(@@) % أخرجت من جنتي مفاجأة % آمن ما كنت في حدائقها % % 6(@)(@@) % بينا استماعي هديل هادلها % % إذ راع قلبي نعيق ناعقها % % 7(@)(@@) % فارقني قاسم لطيته % % يا لهف نفسي على مفارقها % % 8(@)(@@) % بان عن العين وهو في فكري % % أدنى إلى النفس من معانقها % % 9(@)(@@) % وكم أناس مباينين غدوا % % ألصق بالنفس من ملاصقها % % 10(@)(@@) % يا لهف نفسي على موفقها % % يا لهف نفسي على موافقها % % PageV01P3043 11(@)(@@) % كان حياة صفت بعافية % هيهات منها ملال ذائقها % % 12(@)(@@) % هل يخلف البدر وجه سيدنا % % كلا ولا الشمس في مشارقها % % 13(@)(@@) % أو يخلف البدر نور ضحكته % % إذا انجلى الليل عن بوارقها % % 14(@)(@@) % أو يخلف الغيث راحتيه لنا % % كلا وأخلاقه وخالقها % % 15(@)(@@) % أو يخلف البحر ما تجيش به % % أفكاره تلك من دقائقها % % 16(@)(@@) % فتى إذا ما الشواكل التبست % شق الأباطيل عن حقائقها % % 17(@)(@@) % ذو شيمة لم تزل مواعدها % % في الصدق تجري على موائقها % % 18(@)(@@) % والله لولا تطيري سفحت % عيني دم القلب من حمالقها % % 19(@)(@@) % لكن على غيره البكاء ولا % % زالت أمانيه طوع سائقها % % 20(@)(@@) % يرمي به العمر في خوالفه % % وحلبة 
ms775	 المجد في سوابقها % % PageV01P3044 21(@)(@@) % ويا نداماي لاعدمتكم % يا صفوة النفس من أصادقها % % 22(@)(@@) % طلقت من بعدكم مناعم أص % % بحت أرجي رجاعي طالقها % % 23(@)(@@) % كأسي مذ غبتم معطلة % لم تجر عندي على طرائقها % % 24(@)(@@) % غابقها ذاهل وصابحها % % عن شأنها ذاهل كغابقها % % 25(@)(@@) % والعود والناي صامتان معا % أو مسعدا عبرة ودافقها % % 26(@)(@@) % ظعنتم والربيع منصرم % والأرض تبكي على شقائقها % % 27(@)(@@) % فكان في ظعنكم لها شغل % على كل ما مح من روانقها % % 28(@)(@@) % ليس لبغداذ غيركم شجن % ولا سوى ذكركم بشائقها % % 29(@)(@@) % صبرا جميلا فإنها بكر ال % % عيش ولا بد من ودائقها % % 30(@)(@@) % لكن آصالها مؤملة % آمننا الله من عوائقها % % PageV01P3045 31(@)(@@) % كأننا بالقيان تسمعنا % % مثل المها العين في أبارقها % % 32(@)(@@) % من كل رود إذا تضمنت ال % % ألحان أربت على مخارقها % % 33(@)(@@) % أمانة الله إنها زنة ال % % غبراء مبسوطها وخالقها % % 34(@)(@@) % ألا قرأتم على مؤملنا % % سلام صادي الأحشاء خافقها % % 35(@)(@@) % وقلتم غير كاذبين له % % عن آمل النفس فيه واثقها % % 36(@)(@@) % ناشر ذكر إذا التقت عصب % حالت به المسك في مناشقها % % 37(@)(@@) % ألية يا أبا الحسين بآ % % لائك إني لغير ماحقها % % 38(@)(@@) % إن يكن الظلم منك يرهقها % % فظلم مولاك غير راهقها % % 39(@)(@@) % كم نعمة منك لا يقر بها % % ينطق عنها ذرور شارقها % % 40(@)(@@) % يا سارق الغر من صنائعه % % مولاك ماعاش غير سارقها % % PageV01P3046 41(@)(@@) % وفائق الحال حشوه شيم % يعلمه الله غير فائقها % % 42(@)(@@) % أضحى يروم العلا فقلت له % % دع رائقات العلا لرائقها % % 43(@)(@@) % يا من يحب العلا منافقة % هيهات أعيت على منافقها % % 44(@)(@@) % فلا تحاول خداع كيسة % % تضن بالصفو عن مماذقها % % 45(@)(@@) % ولا تخل أنها مصادقة % أخرى الليالي سوى مصادقها % % 46(@)(@@) % لن يجمع المال والعلا مقة % بل وامق المال غير وامقها % % 47(@)(@@) % فكل إلى قاسم ولا يتها % % وخل معشوقة لعاشقها % % 48(@)(@@) % ذاك الذي لم تزل شمائله % أحلى من الهيف في مناطقها % % 49(@)(@@) % خذها كدر الفتاة منتظما % % أوعتر المسك في مخانقها % % 50(@)(@@) % وإنني ملحق بها فقرا % سوابق الشعر من لواحقها % % PageV01P3047 51(@)(@@) % لا يخطىء السالكون قصدهم % % ميلا إلى 
ms776	 فتنة وناعقها % % 52(@)(@@) % وليعدل الجائرون عن قحم % بمن أتاها محيق حائقها % % 53(@)(@@) % خلافة الله في ملوك بني ال % % عباس من خير رزق رازقها % % 54(@)(@@) % قبيلة لست عادما رشدا % في كهلها لا ولا مراهقها % % 55(@)(@@) % فالحلم والعلم في أشائبها % % والجود والبأس في غرانقها % % 56(@)(@@) % يكفيك أن أصبحت خلافتهم % وابن سليمان حبل عاتقها % % 57(@)(@@) % وأن إفضاله ونائله % % لطالبي الفضل من مرافقها % % 58(@)(@@) % يا لك من نحلة معسلة % وحية منه في سرادقها % % 59(@)(@@) % به استقامت أمور مملكة % عوجاء واستوسقت لواسقها % % 60(@)(@@) % كأن تصريفه الخطوب لها % % نتق جبال عنت لناتقها % % PageV01P3048 61(@)(@@) % جلت هناك الخطوب وارتفعت % % شاهاتها الصيد عن بياذقها % % 62(@)(@@) % تعد منه لحربها قلما % يفرج للرمح في مضايقها % % 63(@)(@@) % ويهتدي عامه السيوف به % % من هام قوم إلى مفارقها % % 64(@)(@@) % أحصن من سور كل عالية الس % سور حفاظا ومن خنادقها % % 65(@)(@@) % كم نوبة يذعر الزمان لها % % يعده أهله لطارقها % % 66(@)(@@) % ورشدة كان من مفاتحها % % وغية كان من مغالقها % % 67(@)(@@) % يلقى دهاء الرجال حيلته % أملا بالضعف من أحامقها % % 68(@)(@@) % يترك بالحول حول حولها % % وهو سواء وموق مائقها % % 69(@)(@@) % يرمي بدهياء من فلائقه % % في وجه دهياء من فلائقها % % 70(@)(@@) % كم زاحم الدهر فوق مدحضة % زلج فما زل عن زحالقها % % PageV01P3049 71(@)(@@) % كم أنشأ المزن من ندى وردى % لمعتفي دولة وفاسقها % % 72(@)(@@) % فأمطر البر من مغاوثها % % وفاجر القوم من صواعقها % % 73(@)(@@) % يا آل وهب سمت بكم رتب % يقصر السؤل عن سوامقها % % 74(@)(@@) % يا عترة لم تزل ممدحة % ينكب الطعن عن خلائقها % % 75(@)(@@) % فاتت فما ذمنا بلاحقها % % كلا ولا مدحنا بسابقها % % 76(@)(@@) % يكرم مخبوركم على محن % % من الليالي ومن صوافقها % % 77(@)(@@) % كأنكم أنصل مهندة % يبدي لنا الصقل عن سفاسقها % % 78(@)(@@) % أضحى نثا الملك والملوك بكم % أذكى من المسك في مفارقها % % 79(@)(@@) % وفات صنديدكم بسابقة % طالبها الدهر غير لاحقها % % 80(@)(@@) % وازت عراها ملوك ملتنا % % فكنتم ثم من وثائقها % % PageV01P3050 81(@)(@@) % فعولت منكم هناك على % % فاتق أحوالها وراتقها % % 82(@)(@@) % واستحفظته قوام دولتها % % وما يلي ذاك من علائقها % % 83(@)(@@) % وكفلته برفد يابسها % % ووكلته بكيد 
ms777	 مارقها % % 84(@)(@@) % فحطت الفقر عن عواتقنا % % وحطت الهم عن عواتقها % % 85(@)(@@) % وبين الجري من صواهلها % % خلاف ما كان من نواهقها % % 86(@)(@@) % فلا تخافوا أمنتم أبدا % ما أينع الطلع في بواسقها % % 87(@)(@@) % جعلتم عرفكم معاقلكم % % من الليالي ومن طوارقها % % 88(@)(@@) % وجاعل العرف من معاقله % % أنجى من العصم في شواهقها % % 89(@)(@@) % نعماؤكم في الأنام قد طرفت % عين من الله عين رامقها % % 90(@)(@@) % وعصبة يحذقون مدحكم % من مجدكم جاء حذق حاذقها % % PageV01P3051 91(@)(@@) % لو مدحت غيركم فحولهم % % لقصر اللوم عن شقاشقها % % 92(@)(@@) % كم مدحة لوعدتكم خرست % % كنتم سبيلا لنطق ناطقها % % 93(@)(@@) % ومدحة لوعدتكم كذبت % كنتم سبيلا لصدق صادقها % % 94(@)(@@) % وكيف لا تبرز العقول لكم % % وصائف الشعر في قراطقها % % 95(@)(@@) % وفي سواكم كساد كاسدها % % وفي ذراكم نفاق نافقها % % 96(@)(@@) % لكنني قائل لبارقة % منكم لغير صبيب وادقها % % 97(@)(@@) % عدلك يا مزنة هجرت كرى % % عيني قدما لشيم بارقها % % 98(@)(@@) % أأتقي الدهر ذا الهنات بكم % % وأعظمي طعمة لعارقها % % 99(@)(@@) % تالله ما عزتي لهاضمها % % فيكم ولا هيبتي لخارقها % % PageV01P3052 البحر : - 1(@)(@@) % متهلل زجل تحن رواعد % في حجرتيه وتستطير بروق % 2(@)(@@) % سدت أوائله سبيل أواخر % لم يدر سائقهن كيف يسوق % 3(@)(@@) % فسجا وأسعد حالبيه بدرة % منه سواعد ثرة وعروق % % 4(@)(@@) % وتنفست فيه الصبا فتبجست % منه الكلى فأديمه معقوق % % 5(@)(@@) % حتى إذا قضيت لقيعان الملا % عنه حقوق بعدهن حقوق % % 6(@)(@@) % طفقت رواياه تجر مزادها % % فوق الربا ومزادها مشقوق % % 7(@)(@@) % وتضاحك الروض الكئيب لصوبه % % حتى تفتق نوره المرتوق % % 8(@)(@@) % وتنسمت نفحاته فكأنه % % مسك تضوع فأره مفتوق % 9(@)(@@) % وتغرد المكاء فيه كأنه % % طرب تعلل بالغناء مشوق % % PageV01P3053 البحر : - 1(@)(@@) % تناسيت أمري واطرحت حقوقي % % وعاديت بري واصطفيت عقوقي % % 2(@)(@@) % ما ذاك إلا أنني سهم نصرة % فنحو العدا نصلي ونحوك فوقي % % 3(@)(@@) % أتغفل ريي بعدما قد غرستي % % قديما وساخت في ثراك عروقي % % 4(@)(@@) % ولاحت بروق منك أخلف رعدها % % على أنني ما أخلفتك بروقي % % PageV01P3054 البحر : - 1(@)(@@) % رأيت أبا إسحاق والفحل فوقه % % وللأير في الأحشاء منه خفيق % 2(@)(@@) % فأومى بأن نكني فقلت له انتظر % % فراغ أخينا والمكان مضيق % 3 
ms778	(@)(@@) % فقال مجيبا وهو في سكراته % % له نخرات بينهن شهيق % % 4(@)(@@) % لعمرك ما ضاقت بلاد بأهلها % % ولكن أخلاق الرجال تضيق % % PageV01P3055 البحر : - 1(@)(@@) % ترى أصفرها الفاق % % ع في أبيضها المونق % 2(@)(@@) % كعين الناظر الضاح % % ك في محجره المشرق % PageV01P3056 البحر : - 1(@)(@@) % إلى الزهاد في الدنيا % % جنان الخلد تشتاق % 2(@)(@@) % عبيد من خطاياهم % % إلى الرحمن أباق % 3(@)(@@) % حدتهم نحوه الرغب % % ة والرهبة فانساقوا % % 4(@)(@@) % وزافت لهم الدنيا % % وعاقتهم فما انعاقوا % % 5(@)(@@) % عليهم حين تلقاهم % سكينات وإطراق % % 6(@)(@@) % بقاياهم من الخدم % % ة أشباح وأرماق % % 7(@)(@@) % توهمهم وقد مالت % لسكر النوم أعناق % % 8(@)(@@) % وقد قاموا ولا يهج % % ع من ذاق الذي ذاقوا % % 9(@)(@@) % يضجون إلى الله % % ودمع العين مهراق % % 10(@)(@@) % مليك الناس أعتقنا % % فإعتاقك إعتاق % % PageV01P3057 11(@)(@@) % مليك الناس خلصنا % % إذا ما كشفت ساق % % 12(@)(@@) % مليك الملك هل مما % % تطوقناه إطلاق % 13(@)(@@) % ففي أعناقنا طرا % من الآثام أطواق % 14(@)(@@) % رجوناك ولا يخل % ف من رجاك مصداق % 15(@)(@@) % وخفناك وقد تعفو % % وقلب المرء خفاق % % PageV01P3058 البحر : - 1(@)(@@) % يا من غدا بين تأميل وإشفاق % % مني ومن حسب نفسي أنه باقي % % 2(@)(@@) % أما دبسية الكبرى بحضرتكم % % تحدو الكؤوس بماخوري إسحاق % 3(@)(@@) % فلا أراد بلى إن كادكم قدر % بجلنار وقاني زهدكم واقي % % 4(@)(@@) % الحمد لله لا أدعى لصيدكم % إلا إذا كان صيدا مثل إخفاق % % 5(@)(@@) % لا زلت مدعى لمبلو أساعده % % على الكريهة لا مهلى لمشتاق % % 6(@)(@@) % هل من سبيل إلى تجديد ودكم % وهل يجدد شيء بعد إخلاق % % 7(@)(@@) % لا نكر قد تصبح العيدان مورقة % كما تبدل عريا بعد إيراق % % 8(@)(@@) % يا وجه ذي كرم حالت بشاشته % لن تحسن الشمس إلا ذات إشراق % % 9(@)(@@) % أشكو إلى الله ظلما لا انكشاف له % % ما زلت أرزق منه شر أرزاق % 10(@)(@@) % غامت علي بلا ظل ولا ورق % سماء مولى مظل مشمس ساقي % % PageV01P3059 البحر : - 1(@)(@@) % ألم تر أن المال يهلك أهله % إذا جم آتيه وسد طريقه % 2(@)(@@) % ومن جاور الماء العزيز مجمه % وسد سبيل الماء فهو غريقه % % PageV01P3060 البحر : - 1(@)(@@) % من ظن أن الإستزادة في الهوى % % تؤول بمعشوق 
ms779	 إلى هجر عاشق % 2(@)(@@) % طلبت لديكم بالعتاب زيادة % وعطفا فأعتبتم بإحدى البوائق % % 3(@)(@@) % فكنت كمستسق سماء مخيلة % حيا فأصابته بإحدى الصواعق % PageV01P3061 البحر : - 1(@)(@@) % نحمد الله حين من وأبقى % % بعدما كاد كوكب الأرض يرقى % % 2(@)(@@) % كاد يهوي من السماء إلى الأر % % ض شهاب أضاء غربا وشرقا % % 3(@)(@@) % أيها الدهر إنه واحد النا % % س فرفقا بواحد الناس رفقا % % 4(@)(@@) % وتنمر للشانئين أبا إس % % حاق بعدا للشانئيه وسحقا % % 5(@)(@@) % قلت للمظهر الشماتة أظهر % % ت بإظهارك الشماتة فسقا % % 6(@)(@@) % لو تكون المحق كنت محبا % لامرىء لم يزل يعز المحقا % % 7(@)(@@) % قد أقال الإله بالرغم من ان % % فك من لم يزل يقيل وأبقى % % 8(@)(@@) % ووقى نفسه وهذب بالشك % % ر تقواه فعاد أتقى وأنقى % % 9(@)(@@) % ووقاه محق البصيرة لكن % % محق الذنب والخطيئة محقا % % 10(@)(@@) % إن يقل بعد عثرة فحقيق % لم يزل مثله ملقى موقى % % PageV01P3062 11(@)(@@) % غير نكر أن يأسر الله عبدا % بعد عتق وأن يجدد عتقا % % 12(@)(@@) % ليرى العبد فضل رب كريم % ويرى الرب منه صبرا وصدقا % % 13(@)(@@) % أيها الحاكم الذي طاب فرعا % في نصاب الهدى وأصلا وعرقا % % 14(@)(@@) % شكر الله منك أنك ما أع % ززت بطلا ولا تهضمت حقا % % 15(@)(@@) % رب خطب صدعت فيه بحكم الل % % ه لولم تكن لأصبح رتقا % % 16(@)(@@) % وفساد أصلحته بتأني % % ك ولو لم تكن لأصبح فتقا % % 17(@)(@@) % فابق في غبطة وصحة جسم % فحقيق بأن تصح وتبقى % % 18(@)(@@) % ووقتك الردى نفوس رجال % أنت أخشى لله منهم وأتقى % % 19(@)(@@) % وما لقينا لك من مادح % إلا ملقى منطق صادق % 19(@)(@@) % سنترك ما ساء العد من فعالنا % % إذا تركت شمس النهار شروقها % % PageV01P3063 19(@)(@@) % ننزعنا إلى آبائنا في إبائهم % % وهل تشبه العيدان إلا عروقها % % 19(@)(@@) % أناة إذا باغس ابى أن يودنا % % عليها أقمنا للعداوة سوقها % % 19(@)(@@) % نلقى عقوقا من رجال مبرة % فإن لج لقينا عقوقا عقوقها % % 19(@)(@@) % ولسنا نهر الموت حتى نذوقه % % ومن ذا يهر الكأس حتى يذوقها % % 19(@)(@@) % ننادم أقواما لغير هوادة % صبوح المنايا تارة وغبرقها % % 19(@)(@@) % كي تبين الهدى وتجعل بين السريعقد كان 
ms780	 من رأب الصدوع التيذكرت قتل الأحوال الفاسق مع انحطاط السعر ثم الذيتلاهما من مهلك المارق وانفتق الجو بريح غدتروحا بمن الفاتق الراتق وانقلب المضطاف في شهرنامرتبعا من جودك الدافق ومن ندى كفيك جاد الشر % % حق والباطل المموه فرقا % % 19(@)(@@) % طويللعمرك ما اعطى الرجال حقوقهم % % كإعطائهم بيض السيوف حقوقها % % 19(@)(@@) % قد كان من رأب الصدوع التي % % ذكرت قتل الأحوال الفاسق % 19(@)(@@) % حق أتاح الله لي قوله % وقد يتاح الصدق للناطق % % 19(@)(@@) % وكل ما كنت تفاءلته % % فوافق الحق بلا عائق % % PageV01P3064 19(@)(@@) % ومن ندى كفيك جاد الشرى % % شؤبوب الحق بلا عائق % % 19(@)(@@) % وانقلب المضطاف في شهرنا % % مرتبعا من جودك الدافق % % 19(@)(@@) % وانفتق الجو بريح غدت % % روحا بمن الفاتق الراتق % % 19(@)(@@) % مع انحطاط السعر ثم الذي % % تلاهما من مهلك المارق % % 19(@)(@@) % وكنا إذا لم تعطينا الحق عصبة % طعنا كلاها أو ضربنا فروقها % % 20(@)(@@) % كل الخلال التي فيكم محاسنكم % % تشابهت منكم الأخلاق والخلق % 21(@)(@@) % كأنكم شجر الأترج طاب معا % % حملا ونورا وطاب العود والورق % PageV01P3065 البحر : - 1(@)(@@) % صدور فوقهن حقاق عاج % وحلي زانه حسن اتساق % 2(@)(@@) % يقول الناظرون إذا رأوه % أهذا الحلي من هذي الحقاق % 3(@)(@@) % وما تلك الحقاق سوى ثدي % قدرن من الحقاق على وفاق % % 4(@)(@@) % نواهد لا يعد لهن عيب % سوى منع المحب من العناق % % PageV01P3066 البحر : - 1(@)(@@) % صحائف لي فيها ذنوب كثيرة % لديك وكفاراتها ان تخرقا % % 2(@)(@@) % فبالمال إن المال رب تجله % تطول بها مردودة كي تمزقا % % PageV01P3067 البحر : - 1(@)(@@) % تبارك الله خالق الكرم ال % % بارع من حمأة ومن علق % 2(@)(@@) % ماذا رعيناه في جناب فتى % % كالبدر يجلو غواشي الغسق % 3(@)(@@) % أزمانه كلها بنائله % % مثل زمان الربيع ذي الأنق % 4(@)(@@) % أشهر في الناس بالجميل من ال % % أبلق بين الجياد بالبلق % % 5(@)(@@) % فتى يرى المجد ما أخل به الت % مجيد كالحق غير ذي الطبق % % 6(@)(@@) % فيشتري عالي الثناء ولو أ % % ملق من ماله سوى العلق % % 7(@)(@@) % تلقاه كالمربع المريع إذا % % شئت وطورا كالمورد الرفق % % 8(@)(@@) % فراتع فيه غير ذي غصص % وكارع فيه غير ذي شرق % % 9 