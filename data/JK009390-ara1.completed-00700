ms684	 جعفر الخطمي مرسلا .(@)(@@)(@@)(@@) $ ( 6378 ) قال النبي :(@)(@@) | 30 ( إنما أنا بشر مثلكم ، وإن الظن يخطىء ويصيب ، ولاكن ما قلت لكم قال الله ، فلن أكذب على الله ) )(@)(@@) ( حم ه ) عن طل حة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6379 ) قال النبي :(@)(@@) | 30 ( إنما أنا بشر وإنكم تختصمون إلي ، فلعل بعضكم أن يكون ألحن بحجته من بعض فأحسب أنه صدق فأقضي له على نحو مما أسمع ، فمن قضيت له بحق مسلم فإنما هي قطعة من النار فليأخذها أو ليتركها ) )(@)(@@) ( مالك حم ق 4 ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6380 ) قال النبي :(@)(@@) | 30 ( إنما أنا بشر ، وإني اشترطت على ربي عز وجل أي عبد من المسلمين شتمته أو سببته أن يكون ذالك له زكاة وأجرا ) )(@)(@@) ( حم م ) عن جابر PageV02P421 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6381 ) قال النبي :(@)(@@) | 30 ( إنما أنا خازن وإنما يعطي الله ، فمن أعطيته عطاء عن طيب نفس مني فيبارك له فيه ، ومن أعطيته عطاء عن شره نفس وشدة مسألة فهو كالآكل يأكل ولا يشبع ) )(@)(@@) ( حم م ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6382 ) قال النبي :(@)(@@) | 30 ( إنما أنا رحمة مهداة ) )(@)(@@) ( ابن سعد والحكيم ) عن أبي صالح مرسلا ( ك ) عنه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6383 ) قال النبي :(@)(@@) | 30 ( إنما أنا عبد آكل كما يأكل العبد ، وأشرب كما يشرب العبد ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6384 ) قال النبي :(@)(@@) | 30 ( إنما أنا لكم بمنزلة الوالد أعلمكم ، فإذا أتى أحدكم الغائط فلا يستقبل القبلة ، ولا يستدبرها ، ولا يستطب بيمينه ) )(@)(@@) ( حم د ن ه حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6385 ) قال النبي :(@)(@@) | 30 ( إنما أنا مبلغ والله يهدي ، وإنما أنا قاسم والله يعطي ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6386 ) قال النبي :(@)(@@) | 30 ( إنما أهلك الذين من قبلكم أنهم كانوا إذا سرق فيهم الشريف تركوه ، وإذا سرق فيهم الضعيف أقاموا عليه الحد ) )(@)(@@) ( حم ق 4 ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6387 ) قال النبي :(@)(@@) | 30 ( إنما بعثت رحمة ولم أبعث عذابا ) )(@)(@@) ( تخ ) عن أبي هريرة رضي الله 
ms685	 عنه .(@)(@@)(@@)(@@) $ ( 6388 ) قال النبي :(@)(@@) | 30 ( إنما بعثت فاتحا وخاتما وأعطيت جوامع الكلم PageV02P422 وفواتحه ، واختصر لي الحديث اختصارا ، فلا يهلكنكم المتهوكون ) )(@)(@@) ( هب ) عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ ( 6389 ) قال النبي :(@)(@@) | 30 ( إنما بعثت لاتمم صالح الأخلاق ) )(@)(@@) ( ابن سعد خد ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6390 ) قال النبي :(@)(@@) | 30 ( إنما بعثتم ميسرين ولم تبعثوا معسرين ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6391 ) قال النبي :(@)(@@) | 30 ( إنما بعثني الله مبلغا ولم يبعثني متعنتا ) )(@)(@@) ( ت حسن صحيح غريب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6392 ) قال النبي :(@)(@@) | 30 ( إنما تفرقكم في الشعاب والأودية من الشيطان ) )(@)(@@) ( حم د ك ) عن أبي ثعلبة الخشني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6393 ) قال النبي :(@)(@@) | 30 ( إنما جزاء السلف : الحمد والوفاء ) )(@)(@@) ( حم ن ه ) عن عبد الله بن أبي ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6394 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإستئذان من أجل البصر ) )(@)(@@) ( حم ق ت ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6395 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام جنة ، فإذا صلى قاعدا فصلوا قعودا ، وإذا قال سمع الله لمن حمده ، فقولوا : اللهم ربنا لك الحمد ، فإذا وافق قول أهل الأرض قول أهل السماء غفر له ما تقدم من ذنبه ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6396 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا صلى قائما فصلوا PageV02P423 قياما ، وإن صلى جالسا فصلوا جلوسا ، ولا تقوموا وهو جالس كما يفعل أهل فارس بعظمائها ) )(@)(@@) ( حم م ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6397 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا كبر فكبروا وإذا ركع فاركعوا ، وإذا رفع فارفعوا ، وإذا قال سمع الله لمن حمده فقولوا : اللهم ربنا ولك الحمد ، وإذا سجد فاسجدوا ، وإذا صلى جالسا فصلوا جلوسا أجمعين ) )(@)(@@) ( ملك حم خ د ) عن أنس ( حم ق د ه ) عن عائشة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6398 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، 