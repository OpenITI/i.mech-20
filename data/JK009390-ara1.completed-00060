ms41	 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 335 ) قال النبي :(@)(@@) | 30 ( أتيت بمقاليد الدنيا على فرس أبلق جاءني به جبريل عليه السلام ، عليه قطيفة من سندس ) )(@)(@@) ( حم حب ) والضياء عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 336 ) قال النبي :(@)(@@) | 30 ( أتيت ليلة أسري بي على قوم بطونهم كالبيوت فيها الحيات ترى من خارج بطونهم ، فقلت : من هاؤلاء يا جبريل قال : هاؤلاء أكلة الربا ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 337 ) قال النبي :(@)(@@) | 30 ( أتيت ليلة أسري بي على قوم تقرض شفاههم PageV01P071 بمقاريض من نار كلما قرضت وفت ، فقلت : يا جبريل من هاؤلاء ؟ قال : خطباء أمتك الذين يقولون ما لا يفعلون ويقرؤون كتاب الله ولا يعملون به ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 338 ) قال النبي :(@)(@@) | 30 ( أتيت ليلة أسري بي فانطلق بي إلى زمزم فشرح عن صدري ثم غسل بماء زمزم ثم أنزلت ) )(@)(@@) ( حم ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 339 ) قال النبي :(@)(@@) | 30 ( إتاكم أهل اليمن مثل السحاب خيار من في الأرض قال رجل من الأنصار يا رسول الله إلا نحن فسكت ، ثم أعادها فسكت ، ثم أعادها فقال كلمة خفيفة إلا أنتم ) )(@)(@@) ( حم وابن منيع ) ( طب ض ) عن محمد بن جبير بن مطعم عن أبيه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 340 ) قال النبي :(@)(@@) | 30 ( أتاكم شهر رمضان شهر خير وبركة ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 341 ) قال النبي :(@)(@@) | 30 ( أتاكم شهر رمضان شهر بركة فيه خير يغشيكم الله فينزل الرحمة ويحط فيه الخطايا ويستجيب فيه الدعاء ينظر الله إلى تنافسكم ويباهي بكم ملائكته ، فأروا الله من أنفسكم خيرا فإن الشقي من حرم فيه رحمة الله عز وجل ) )(@)(@@) ( طب وابن النجار ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 342 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فخيرني بين أن يدخل نصف أمتي الجنة وبين الشفاعة فاخترت الشفاعة وهي لمن شهد أن لا إلاه إلا الله وأني رسول الله ) )(@)(@@) البغوي عن السليل الأشجعي رضي الله عنه قال وما له غيره وابن 
ms42	 قانع عن أبي السليل PageV01P072 وقال من قال السليل أخطأ .(@)(@@)(@@)(@@) $ ( 343 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد الإسلام عشرة أسهم وخاب من لا سهم له ، أولها شهادة أن لا إلاه إلا الله ، والثاني الصلاة وهي الطهر ، والثالث الزكاة وهي الفطرة ، والرابع الصوم وهو الجنة ، والخامس الحج وهو الشريعة ، والسادس الجهاد وهو الغزو ، والسابع الأمر بالمعروف وهو الوفاء ، والثامن النهي عن المنكر وهو الحجة ، والتاسع الجماعة وهي الألفة ، والعاشر الطاعة وهي العصمة ) )(@)(@@) أبو نعيم محمد بن أحمد العجلي في فوائده والرافعي في تاريخ قزوين من طريق إسحاق الديري عن عبد الرزاق عن معمر عن قتادة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 344 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال أقرإ القرآن على سبعة أحرف ) )(@)(@@) ابن الضريس عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 345 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فنكت في ظهري فذهب إلى شجرة فيها مثل وكري الطائر فقعد في إحداهما وقعدت في الأخرى فنشأت بنا حتى ملأت الأفق فلو بسطت يدي إلى السماء لنلتها ، ثم دلي بسبب فهبط النور فوقع جبريل قبلي مغشيا عليه كأنه حلس فعرفت فضل خشيته على خشيتي فاوحي إلي أنبيا عبدا أو نبيا ملكا وإلى الجنة ما أنت ، فأومأ جبريل إلي وهو مضطجع بل كان نبيا عبدا ) )(@)(@@) ابن المبارك عن محمد بن عمير بن عطارد بن حاجب مرسلا .(@)(@@)(@@)(@@) $ ( 346 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : اقرإ القرآن على حرف ) )(@)(@@) ابن منيع ( ص ) عن سليمان بن صرد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 347 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : رغم أنف رجل أدرك رمضان فلم يغفر له قل آمين فقلت آمين ، ورغم أنف رجل ذكرت عنده فلم يصل عليك قل آمين فقلت آمين ، ورغم أنف رجل أدرك أبويه أحدهما أو كليهما عنده الكبر فلم يدخلاه PageV01P073 الجنة قل : آمين ، فقلت : آمين ) )(@)(@@) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 348 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : من ذكرت عنده فلم يصل عليك دخل النار فأبعده الله وأسحقه قل آمين فقلت آمين ، قال : ومن 
ms43	 أدرك والديه أو أحدهما فلم يبرهما دخل النار فأبعده وأسحقه قل : آمين فقلت : آمين ، ومن أدرك رمضان فلم يغفر له دخل النار فأبعده الله وأسحقه قل : آمين فقلت : آمين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 349 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال بشر خديجة ببيت من قصب لا صخب فيه ولا نصب ) )(@)(@@) الباوردي وابن قانع ( هب ) عن جابر بن عبد الله بن رئاب ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 350 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل وهو يبتسم فقلت مم تضحك ؟ قال : من رحم معلقة بالعرش تدعو على من قطعها قلت كم بينهما ؟ قال : خمسة آباء ) )(@)(@@) أبو نعيم وأبو موسى عن حبيب بن الضحاك الجمحي رضي الله عنهما وضعف .(@)(@@)(@@)(@@) $ ( 351 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال إن ربي وربك يقول لك تدري كيف رفعت ذكرك قلت الله أعلم ، قال لا أذكر إلا ذكرت معي ) )(@)(@@) ( ع حب ) و الرهاوي في الأربعين وابن عساكر ( ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 352 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال إن الله يأمرك أن تزوج عثمان أم كلثوم على مثل صداق رقية وعلى مثل صحبتها ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 353 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال لي ارفع صوتك بالإهلال فإنه من شعار الحج ) )(@)(@@) ابن سعد ( طب ) عن خلاد بن السائب عن زيد بن خالد الجهني رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 354 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فعلمني الصلاة فقرأ بسم الله الرحمان PageV01P074 الرحيم فجهر بها ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 355 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال اقرىء عمر السلام وأعلمه أن غضبه عز ورضاه عدل ) )(@)(@@) الحكيم وأبو نعيم في فضائل الصحابة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 356 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال إن الله يأمرك أن تأمر أصحابك أن يرفعوا أصواتهم بالتلبية ) )(@)(@@) ( حم ) عن السائب بن خلاد ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 357 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل ببشارة من ربي قال 
ms44	 إن الله عز وجل بعثني إليك أبشرك أنه ليس أحد من أمتك يصلي عليك صلاة إلا صلى الله وملائكته عليه بها عشرا ) )(@)(@@) البغوي ( طب ) عن أنس عن أبي طلحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 358 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال إن الله قال من صلى عليك صليت عليه أنا وملائكتي عشرا ، ومن سلم عليك سلمت عليه أنا وملائكتي عشرا ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 359 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل آنفا فقال : بشر أمتك أنه من صلى عليك صلاة كتب له بها عشر حسنات وكفر عنه بها عشر سيئات ، ورفع له بها عشر درجات ورد الله عليه مثل قوله وعرضت عليك يوم القيامة ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 360 ) قال النبي :(@)(@@) | 30 ( أتاني الملك فقال : يا محمد أما يرضيك أن ربك عز وجل يقول : إنه لا يصلي عليك أحد من أمتك صلاة إلا صليت عليه عشرا ، ولا يسلم عليك أحد من أمتك تسليمة إلا سلمت عليه عشرا ؟ قلت : بلى أي رب ) )(@)(@@) ( حم ) و الدارمي وابن عاصم ( حب ك هب ص ) عن أبي طلحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 361 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد إن ربك يقول أما PageV01P075 يرضيك أنه لا يصلي عليك أحد من أمتك إلا صليت عليه عشرا ، ولا يسلم عليك أحد من أمتك إلا سلمت عليه عشرا ) )(@)(@@) ( ن ) عن عبد الله بن أبي طلحة عن أبيه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 362 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : الشهر تسعة وعشرون يوما ) )(@)(@@) ( ن ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 363 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل آنفا فقال : إنا لله وإنا إليه راجعون قلت : أجل إنا لله وإنا إليه راجعون ، فمم ذاك يا جبريل ؟ فقال : إن أمتك مفتتنة بعدك بقليل من الدهر غير كثير ، قلت : فتنة كفر أو فتنة ضلالة ؟ قال : كل ذالك سيكون ، قلت : ومن أين ذاك وأنا تارك فيهم كتاب الله ؟ قال : بكتاب الله يضلون ، وأول ذالك من قبل قرائهم وأمرائهم ، يمنع الأمراء الناس حقوقهم فلا 
ms45	 يعطونها فيقتتلون ، ويتبع القراء أهواء الأمراء فيمدون في الغي ثم لا يقصرون ، قلت : يا جبريل فبم سلم من سلم منهم ؟ قال : بالكف والصبر ، إن أعطوا الذي لهم أخذوه ، وإن منعوه تركوه ) )(@)(@@) الحكيم عن عمر رضي الله عنه وهو ضعيف .(@)(@@)(@@)(@@) $ ( 364 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل آنفا فقال : يا محمد من صلى عليك مرة كتب الله له بها عشر حسنات ومحى عنه عشر سيئات ورفع له بها عشر درجات ) )(@)(@@) ابن النجار ( ض ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 365 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فذكر أن في نعلي قذرا فخلعتهما ، فصلوا في نعالكم ) )(@)(@@) ( طب ) عن عبد الله بن الشخير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 366 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد إن الله تعالى بعثني فطفت شرق الأرض وغربها وسهلها وجبلها فلم أجد حيا خيرا من العرب ، ثم أمرني فطفت في العرب فلم أجد حيا خيرا من مضر ، ثم أمرني فطفت في مضر فلم أجد حيا خيرا من كنانة ، ثم أمرني فطفت في كنانة فلم أجد حيا خيرا من قريش ، ثم PageV01P076 أمرني فطفت في قريش فلم أجد حيا خيرا من بني هاشم ، ثم أمرني أختار في أنفسهم فلم أجد نفسا خيرا من نفسك ) )(@)(@@) الحكيم عن جعفر بن محمد عن أبيه معضلا .(@)(@@)(@@)(@@) $ ( 367 ) قال النبي :(@)(@@) | 30 ( أتاني آت من ربي فأخبرني أنه لم يصل علي أحد من أمتي إلا ردها الله عليه عشرة أمثالها ) )(@)(@@) ( هب ) عن أبي طلحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 368 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فما زال يوصيني بالجار حتى ظننت أنه يورثه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 369 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد لولاك ما خلقت الجنة ، ولولاك ما خلقت النار ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 370 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد جئتك بكلمات لم آت بهن أحدا قبلك ، قل : يا من أظهر الجميل وستر القبيح ، ولم يؤاخذ بالجريرة ، ولم يهتك الستر ، يا عظيم العفو 
ms46	 والصفح ، ويا صاحب كل نجوى ، ويا منتهى كل شكوى ، ويا مبدىء النعم قبل استحقاقها ، يا رباه ويا سيداه ويا أمنيتاه ، ويا غاية رغبتاه ، أسألك أن لا تشوه خلقي بالنار ) )(@)(@@) الديلمي عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 371 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : إن في أمتك ثلاثة أعمال لم تعمل بها الأمم قبلها النباشون والمتسمنون والنساء بالنساء ) )(@)(@@) الديلمي عن عبيد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 372 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقلت : من يهاجر معي ؟ قال أبو بكر ، وهو يلي أمر أمتك من بعدك وهو أفضل أمتك ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 373 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل حين زاغت الشمس فقال : قم فصل فصلى الظهر ، ثم جاء حين كان ظل كل شيء مثله فقال : قم فصل فصلى العصر ، ثم جاء حين غابت الشمس ودخل الليل فقال قم فصل فصلى المغرب ، ثم جاء حين PageV01P077 غاب الشفق فقال قم فصل فصلى العشاء ، ثم جاء حين أضاء الفجر فقال قم فصل فصلى الفجر ، ثم جاء الغد حين كان ظل كل شيء مثله فقال قم فصل فصلى الظهر ، ثم جاء حين كان ظل كل شيء مثليه فقال قم فصل فصلى العصر ، ثم جاء حين غابت الشمس ودخل الليل فقال قم فصل فصلى المغرب ، ثم جاء حين ذهب ثلث الليل فقال قم فصل فصلى العشاء ، ثم جاء حين أسفر فقال قم فصل فصلى الفجر ، ثم قال له : هاذه صلاة النبيين قبلك فالزم ) )(@)(@@) ( عب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 374 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال لي : يا محمد إن الله يأمرك أن تستشير أبا بكر ) )(@)(@@) تمام عن أبي عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 375 ) قال النبي :(@)(@@) | 30 ( أتاني جبريل وفي يده كالمرآة البيضاء فيها كالنكتة السوداء ، فقلت : يا جبريل ما هاذه ؟ قال : هاذه الجمعة ، قلت : وما الجمعة ؟ قال : لكم فيها خير ، قلت : وما لنا فيها ؟ قال : تكون عيدا لك ولقومك من بعدك ، وتكون اليهود والنصارى تبعا لك ، قلت : وما لنا فيها ؟ قال : لكم فيها ساعة 
ms47	 لا يوافقها عبد مسلم يسأل الله فيها شيئا من الدنيا والآخرة هو له قسم إلا أعطاه إياه أو ليس له بقسم إلا ذخر له عنده ما هو أفضل منه ، أو يتعوذ من شر هو عليه مكتوب إلا صرف عنه من البلاء ما هو أعظم منه ، قلت : وما هاذه النكتة فيها ؟ قال : هي الساعة ، وهي تقوم يوم الجمعة ، وهو عندنا سيد الأيام ونحن ندعوه يوم القيامة يوم المزيد ، قلت : مم ذالك ؟ قال : لأن ربك تبارك وتعالى اتخذ في الجنة واديا من مسك أبيض فإذا كان يوم الجمعة هبط من عليين على كرسيه تبارك وتعالى ثم حف الكرسي بمنابر من ذهب مكللة بالجوهر ، ثم يجيء النبيون حتى يجلسوا عليها وينزل أهل الغرف حتى يجلسوا على ذالك الكثيب ، ثم يتجلى لهم تبارك وتعالى ، ثم يقول : سلوني أعطكم ، فيسألونه الرضى فيقول رضاي أحلكم داري وأنالكم كرامتي ، فسلوني أعطكم فيسألونه الرضى فيشهدهم أنه قد رضي عنهم ، فيفتح لهم PageV01P078 ما لم تر عين ولم تسمع أذن ولم يخطر على قلب بشر ، وذالكم مقدار انصرافكم من يوم الجمعة ، ثم يرتفع ويرتفع معه النبيون والصديقون والشهداء ويرجع أهل الغرف إلى غرفهم وهي درة بيضاء ليس فيها فصم ولا وهم ، أو درة حمراء أو زبرجدة خضراء فيها غرفها وأبوابها مطرورة وفيها أنهارها وثمارها متدلية فليسوا إلى شيء أحوج منهم إلى يوم القيامة ليزدادوا إلى ربهم نظرا وليزدادوا منه كرامة ) )(@)(@@) ( ش ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 376 ) قال النبي :(@)(@@) | 30 ( أتاني ملك جرمه يساوي الكعبة فقال اختر أن تكون نبيا ملكا أو نبيا عبدا ، فأومأ إلي جبريل أن تواضع لله فقلت : بل أحب أن أكون عبدا نبيا ، فشكر ربي عز وجل ذالك فقال أنت أول من تنشق عنه الأرض ، وأول شافع ) )(@)(@@) ( كر ) عن عائشة وابن عباس ( حم ع ) عن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 377 ) قال النبي :(@)(@@) | 30 ( أتاني البارحة رجلان فاكتنفاني فانطلقا بي حتى أتيا على رجل في يده كلاب يدخله في في رجل فيشق شدقيه حتى يبلغ لحييه 
ms48	 فيعود فيأخذ فيه فقلت من هاذا ؟ قال : هم الذين يسعون بالنميمة ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن أبي العالية مرسلا .(@)(@@)(@@)(@@) $ ( 378 ) قال النبي :(@)(@@) | 30 ( أتأكل التمر وبك رمد ) )(@)(@@) ( ك ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 379 ) قال النبي :(@)(@@) | 30 ( أتؤمن بشجرة المسك وتجدها في كتابكم فإن البول والجنابة عرق يسيل من ذوائبهم إلى أقدامهم كالمسك يعني أهل الجنة ) )(@)(@@) ( طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 380 ) قال النبي :(@)(@@) | 30 ( اتبعوا ولا تبتدعوا فقد كفيتم ) )(@)(@@) ( طب ) و الدارمي في العلم من مسنده عن ابن مسعود رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 381 ) قال النبي :(@)(@@) | 30 ( أتتكم الفتن كقطع الليل المظلم يصبح الرجل مؤمنا PageV01P079 ويمسى كافرا ، ويمسى مؤمنا ويصبح كافرا ، يبيع أحدكم دينه بعرض من الدنيا قليل قيل فكيف نصنع يا رسول الله ؟ قال : تكسر يدك ، قال : فإن انجبرت ؟ قال : تكسر الأخرى ، قال : حتى متى ؟ قال : حتى تأتيك يد خاطئة أو منية قاضية ) )(@)(@@) ( طس ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 382 ) قال النبي :(@)(@@) | 30 ( أتتهمونني وأنا أمين أهل السماء وأهل الأرض ، أما إني لو استقبلت من أمري ما استدبرت ، ما كان الهدي إلا من مكة ) )(@)(@@) ( طب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 383 ) قال النبي :(@)(@@) | 30 ( أتحب لو أن عندك ابنك كأحسن الصبيان وأكيسه ؟ أتحب لو أن عندك ابنك كأجرإ الصبيان جرأة ؟ أتحب لو أن عندك ابنك كهلا كأفضل الكهول وأسراه ؟ أو يقال لك ادخل الجنة بثواب ما قد أخذنا منك ؟ ) )(@)(@@) ( حم ) و البغوي وابن قانع وابن مندة وابن السكن وابن عساكر عن حوشب أن رجلا توفي ابنه فوجد عليه أبوه فقال له النبي فذكره . قال ابن منده هاذا حديث غريب ، وقال ابن السكن : تفرد به ابن لهيعة رضي الله عنه وهو ضعيف . وقال البغوي : لم يرو حوشي غير هاذا الحديث .(@)(@@)(@@)(@@) $ ( 384 ) قال النبي :(@)(@@) | 30 ( أتحبان أن يسوركما الله يوم القيامة بسوارين من نار ؟ فأديا زكاته ) )(@)(@@) ( حم ) ( ت ) وضعفه عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 385 ) قال النبي :(@)(@@) | 30 ( أتخوف على أمتي الشرك 
ms49	 والشهوة الخفية ، قيل : يا رسول الله أتشرك أمتك من بعدك ؟ قال : نعم ، أما إنهم لا يعبدون شمسا ولا قمرا ولا حجرا ولا وثنا ولاكن يراؤون الناس بأعمالهم ، والشهوة الخفية أن يصبح أحدهم صائما فتعرض له شهوة من شهواته فيترك صومه ) )(@)(@@) ( حم طب ك حل هب ) عن PageV01P080 شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 386 ) قال النبي :(@)(@@) | 30 ( أتدرون أي يوم هاذا ؟ وأي شهر هاذا ؟ وأي بلد هاذا ؟ قالوا : هاذا بلد حرام وشهر حرام ويوم حرام ، قال : ألا وإن أموالكم ودماءكم عليكم حرام كحرمة يومكم هاذا في شهركم هاذا ، في بلدكم هاذا ، ألا وإني فرطكم على الحوض أنظركم وأكاثر بكم الأمم فلا تسودوا وجهي ، ألا وقد رأيتموني وسمعتم مني وستسألون عني ، فمن كذب علي فليبتوأ مقعده من النار ، ألا وإني مستنقذ أناسا ومستنقذ مني أناس فأقول يا رب أصحابي فيقول : إنك لا تدري ما أحدثوا بعدك ) )(@)(@@) ( حم ) عن رجل من الصحابة ( د ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 387 ) قال النبي :(@)(@@) | 30 ( أتدرون ما خيرني به ربي الليلة ؟ فإنه خيرني بين أن يدخل نصف أمتي الجنة وبين الشفاعة فاخترت الشفاعة هي لكل مسلم ) )(@)(@@) ( ه ك ) عن عوف بن مالك الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 388 ) قال النبي :(@)(@@) | 30 ( أتدرون أي أهل الإيمان أفضل إيمانا ؟ قالوا : الملائكة قال : هم كذالك ويحق لهم وما يمنعهم وقد أنزلهم الله المنزلة التي أنزلهم ، بل غيرهم ، قالوا : فالأنبياء قال : هم كذالك وحق لهم ، بل غيرهم ، قالوا : فمن هم ؟ قال : أقوام يأتون من بعدي فيؤمنون بي ولم يروني ، ويجدون الورق المعلق فيعملون بما فيه فهاؤلاء أفضل أهل الإيمان إيمانا ) )(@)(@@) ( ك ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 389 ) قال النبي :(@)(@@) | 30 ( أتدرون من الرقوب فيكم ؟ ) )(@)(@@) أبو عوانة وقال غريب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 390 ) قال النبي :(@)(@@) | 30 ( أتدرون أي يوم هاذا ؟ يوم يقول الله عز وجل لآدام : يا آدم قم فابعث بعث النار فيقول يا رب وما بعث النار ؟ قال : من كل ألف تسعمائة PageV01P081 وتسعة وتسعون إلى النار وواحد في 
ms50	 الجنة ، فكبر ذالك على المسلمين فقال : سددوا وقاربوا وأبشروا ، فوالذي نفسي بيده ما أنتم في الناس إلا كالشامة في جنب البعير ، أو كالرقمة في ذراع الدابة ، وإن معكم لخليقتين ما كانتا مع شيء قط إلا كثرتاه يأجوج ومأجوج ، ومن هلك من كفرة الإنس والجن ) )(@)(@@) عبد بن حميد ( ك ) عن أنس رضي الله عنه قال لما نزلت { يا أيها الناس اتقوا ربكم إن زلزلة الساعة شيء عظيم } قال فذكره . ( حم ت ) حسن صحيح ( طب ك ) عن عمران بن حصين ( ك ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 391 ) قال النبي :(@)(@@) | 30 ( أتدرون ما هاذه الريح ؟ هاذه ريح الذين يغتابون الناس ) )(@)(@@) ( حم خ ) في الأدب و ابن أبي الدنيا في ذم الغيبة ( ض ) عن جابر رضي الله عنه قال : كنا مع رسول الله فارتفعت ريح جيفة منتنة قال فذكره .(@)(@@)(@@)(@@) $ ( 392 ) قال النبي :(@)(@@) | 30 ( أتدرون ما هاذا ؟ تذهبون الخير فالخير حتى لا يبقى منكم إلا مثل هاذه ) )(@)(@@) ( خ ) في تاريخه ( حب ك طب ض ) عن رويفع بن ثابت رضي الله عنه قال : قرب لرسول الله تمر ورطب فأكلوا منه حتى لم يبق منه شيء إلا نواة قال فذكره .(@)(@@)(@@)(@@) $ ( 393 ) قال النبي :(@)(@@) | 30 ( أتدرون من شهداء أمتي ؟ قالوا : قتل المسلم شهادة ، قال : إن شهداء أمتي إذن لقليل ، قتل المسلم شهادة ، والبطن شهادة ، والغرق شهادة ، والمرأة يقتلها ولدها جمعا شهادة ) )(@)(@@) ابن سعد عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 394 ) قال النبي :(@)(@@) | 30 ( أتدرون ما هاذا ؟ فإن هاذا الإنسان ، وذاك الأجل ، وذالك الأمل يتعاطاه ابن آدم ويختلجه الأجل دون ذالك ) )(@)(@@) ابن المبارك عن أبي المتوكل الناجي رضي الله عنه قال : أخذ رسول الله ثلاثة أعواد فغرز عودا بين يديه والآخر إلى جنبه ، فأما الثالث فأبعده فقال فذكره .(@)(@@)(@@)(@@) $ ( 395 ) قال النبي :(@)(@@) | 30 ( أتدرون ما أكثر ما يدخل الناس الجنة ؟ تقوى الله وحسن الخلق ، أتدرون ما أكثر ما يدخل الناس النار ؟ الأجوفان الفم والفرج ) )(@)(@@) أبو الشيخ في الثواب والخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه 
ms51	 .(@)(@@)(@@)(@@) $ ( 396 ) قال النبي :(@)(@@) | 30 ( أتدرون لم أقارب الخطا ؟ لا يزال العبد في صلاة ما دام في طلب الصلاة ) )(@)(@@) ( طب ) عن أنس عن زيد بن ثابت رضي الله عنهما قال : كنت أمشي مع رسول الله ونحن نريد الصلاة فكان يقارب الخطا فذكره .(@)(@@)(@@)(@@) $ ( 397 ) قال النبي :(@)(@@) | 30 ( أتدرون ما يقول ربكم ؟ فإن ربكم عز وجل يقول : من صلى الصلاة لوقتها وحافظ عليها ولم يضيعها استخفافا بحقها فله علي عهد أن أدخله الجنة ، ومن لم يصلها لوقتها ولم يحافظ عليها وضيعها استخفافا بحقها فلا عهد له ، إن شئت عذبته وإن شئت غفرت له ) )(@)(@@) ( حم ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 398 ) قال النبي :(@)(@@) | 30 ( أتدرون ما حق الجار ؟ إن استعان بك أعنته ، وإن استقرضك أقرضته ، وإذا افتقر عدت عليه ، وإن مرض عدته ، وإن مات اتبعت جنازته ، وإن أصابه خير هنأته ، وإن أصابته مصيبة عزيته ، ولا تستطل عليه بالبناء فتحجب عنه الريح إلا باذنه ، وإذا اشتريت فاكهة فأهد له فإن لم تفعل ، فأدخلها سرا ولا يخرج بها ولدك ليغيظ بها ولده ، ولا تؤذه بقتار قدرك إلا أن تغرف له منها ، أتدرون ما حق الجار على الجار ؟ والذي نفسي بيده لا يبلغ حق الجار إلا من رحمه الله ، الجيران ثلاثة : فمنهم من له ثلاثة حقوق ومنهم من له حقان ، ومنهم من له حق واحد ، فأما الذي له ثلاثة حقوق فالجار المسلم القريب له حق الإسلام وحق الجوار وحق القرابة ، وأما الذي له حقان فالجار المسلم له حق الإسلام وحق الجوار ، وأما الذي له حق واحد فالجار الكافر له حق الجوار ، قالوا : يا رسول الله أنطعمهم من لحوم النسك ؟ قال : لا يطعم المشركون من نسك المسلمين ) )(@)(@@) ( عد ) PageV01P083 و الخرائطي في مكارم الأخلاق عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 399 ) قال النبي :(@)(@@) | 30 ( أتدرون ما يوم الجمعة ؟ هو اليوم الذي جمع فيه أبوكم ، إني أخبركم عن يوم الجمعة ، ما من مسلم يتطهر ثم يمشي إلى المسجد ثم ينصت حتى يقضي الإمام صلاته إلا كانت 
ms52	 له كفارة ما بينه وبين الجمعة التي قبلها ما اجتنب المقتلة ) )(@)(@@) ( هب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 400 ) قال النبي :(@)(@@) | 30 ( أتدرون ما هاذه ؟ هاذه الغاية هاذه زوايا الأرض يسوقها إلى أهل لا يعبدونه ) )(@)(@@) أبو الشيخ في العظمة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 401 ) قال النبي :(@)(@@) | 30 ( أتدرون ما قال ؟ قالوا : سلم علينا ، قال : لا ، إنما قال السام عليكم ، أي تسامون دينكم فإذا سلم عليكم رجل من أهل الكتاب فقولوا : وعليك ) )(@)(@@) ( حب ) عن أنس رضي الله عنه أن يهوديا سلم فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 402 ) قال النبي :(@)(@@) | 30 ( أتدري لم مشيت بك هاذه المشية ؟ لتكثر عدد الخطا في طلب الصلاة ) )(@)(@@) ( ط طب هب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 403 ) قال النبي :(@)(@@) | 30 ( أتدري لم بعثت إليك ؟ لا تصيبن شيئا بغير إذني فإنه غلول ومن يغلل يأت بما غل يوم القيامة لهاذا دعوتك فامض لعملك ) )(@)(@@) ( ت ) حسن غريب ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 404 ) قال النبي :(@)(@@) | 30 ( أتدري ما يوم الجمعة ؟ لكني أدري ما يوم الجمعة ، لا يتطهر الرجل فيحسن طهوره ثم يأتي يوم الجمعة فينصت حتى يقضي الإمام صلاته إلا كانت كفارة له ما بينه وبين الجمعة المقبلة ما اجتنبت المقتلة ) )(@)(@@) ( حم ن ض ) عن سل مان رضي الله عنه .(@)(@@) PageV01P084(@)(@@)(@@)(@@) $ ( 405 ) قال النبي :(@)(@@) | 30 ( أتدري ما تمام النعمة ؟ تمام النعمة دخول الجنة والنجاة من النار ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 406 ) قال النبي :(@)(@@) | 30 ( أتدري ما يوم الجمعة ؟ فيه جمع أبوك آدم ، ما من رجل يتطهر يوم الجمعة كما أمر ثم يخرج من بيته حتى يأتي الجمعة فيقعد فينصت حتى يقضي صلاته إلا كان كفارة لما قبله من الجمعة ) )(@)(@@) ( ك ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 407 ) قال النبي :(@)(@@) | 30 ( أترضون أن تكونوا ربع أهل الجنة ؟ أترضون أن تكونوا ثلث أهل الجنة ؟ والذي نفسي بيده إني لأرجو أن تكونوا شطر أهل الجنة وسأخبركم عن ذالك إنه لا يدخل الجنة إلا نفس مسلمة ، وإن قلة المسلمين 
ms53	 في الكفار يوم القيامة كالشعرة السوداء في الثور الأبيض ، أو كالشعرة البيضاء في الثور الأسود ) )(@)(@@) ابن جرير عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 408 ) قال النبي :(@)(@@) | 30 ( اتركوا الترك ما تركوكم ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 409 ) قال النبي :(@)(@@) | 30 ( أترون هاذه طارحة ولدها في النار ؟ الله عز وجل أرحم بعباده من هاذه بولدها ) )(@)(@@) ( خ م ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 410 ) قال النبي :(@)(@@) | 30 ( أترون هاذه السخلة هانت على أهلها حين ألقوها ؟ فوالذي نفس محمد بيده للدنيا أهون على الله من هاذه السخلة على أهلها ) )(@)(@@) ابن المبارك ( حم ت ) حسن ( ه طب ) عن المستورد بن شداد . ( حم طب ض ) عن عبد الله بن ربيعة السلمي ( طب ) عن ابن عمر ، ( طب ) عن أبي موسى ا ( هناد ) عن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 411 ) قال النبي :(@)(@@) | 30 ( أترون أني إذا تعلقت بحلق أبواب الجنة أوثر على بني PageV01P085 عبد المطلب أحدا ؟ ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 412 ) قال النبي :(@)(@@) | 30 ( أترون هاذه الشاة هينة على صاحبها ؟ فوالذي نفسي بيده للدنيا أهون على الله عز وجل من هاذه على صاحبها ، ولو كانت الدنيا تزن عند الله جناح بعوضة ما سقى كافرا منها قطرة ماء أبدا ) )(@)(@@) ( ه ) ( قط ) في الأفراد ( طب ك ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 413 ) قال النبي :(@)(@@) | 30 ( أتعجبون من غيرة سعد ؟ والله لأنا أغير منه ، والله أغير مني ، ومن أجل غيرة الله حرم الفواحش ما ظهر منها وما بطن ، ولا أحد أحب إليه ، العذر من الله ، من أجل ذالك بعث المرسلين مبشرين ومنذرين ، ولا أحد أحب إليه ، المدحة من الله ، ومن أجل ذالك وعد الجنة ) )(@)(@@) ( حم خ م ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 414 ) قال النبي :(@)(@@) | 30 ( أتعجبون من لين هاذه ؟ والذي نفسي بيده لمناديل سعد بن معاذ في الجنة خير منها وألين ) )(@)(@@) ( م ت ه ) عن البراء ( م ت ن ) عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 415 ) قال النبي :(@)(@@) | 30 ( أتقرؤون في صلاتكم خلف 
ms54	 الإمام والإمام يقرأ ؟ فلا تفعلوا وليقرأ أحدكم بفاتحة الكتاب في نفسه ) )(@)(@@) ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 416 ) قال النبي :(@)(@@) | 30 ( أتقعد قعدة المغضوب عليهم ؟ ) )(@)(@@) ( د ك هق ) عن عمرو بن الشريد عن أبيه .(@)(@@)(@@)(@@) $ ( 417 ) قال النبي :(@)(@@) | 30 ( أتقعد قعدة المغضوب عليهم ) )(@)(@@) ( حم حب ك ) عن الشريد بن سويد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 418 ) قال النبي :(@)(@@) | 30 ( اتق الله حيثما كنت وأتبع السيئة الحسنة تمحها ، PageV01P086 وخالق الناس بخلق حسن ) )(@)(@@) ( حم ت ) حسن والدارمي ( ك هب ض ) عن أبي ذر ( ت طب ) عن معاذ بن جبل رضي الله عنه ، وقال : الصحيح حديث أبي ذر ( كر ) عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 419 ) قال النبي :(@)(@@) | 30 ( اتق الله وإذا كنت في مجلس فقمت عنه فسمعتهم يقولون ما يعجبك فأته وإذا سمعتهم يقولون ما تكره فلا تأته ) )(@)(@@) ( ط حم ) و عبد بن حميد والبغوي والباوردي وابن قانع ( طب حل هب ض ) عن ضرغامة بن عليبة بن حرملة العنبري عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 420 ) قال النبي :(@)(@@) | 30 ( اتق الله ولا تحقرن من المعروف شيئا ولو أن تلقى أخاك ووجهك منبسط إليه ، ولو أن تفرغ من دلوك في إناء المستقي ، ولا تسبن أحدا ، وإن امرؤ شتمك بما يعلم فيك فلا تشتمه بما تعلم فيه فإنه يكون لك أجره وعليه وزره ، وائتزر إلى نصف الساق فإن أبيت فالى الكعبين ، وإياك وإسبال الإزار فإن إسبال الإزار من المخيلة ، وإن الله تعالى لا يحب المخيلة ) )(@)(@@) ( ط حم د ن ) و البغوي والباوردي ( طب حب حل هب ض ) عن أبي جرى جابر بن سليم ويقال سليم بن جابر الجهمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 421 ) قال النبي :(@)(@@) | 30 ( اتق الله وأقم الصلاة ، وآت الزكاة ، وحج البيت ، واعتمر ، وبر والديك ، وصل رحمك ، واقر الضيف ، وأمر بالمعروف وانه عن المنكر ، وزل مع الحق حيثما زال ) )(@)(@@) ( طب ) عن مخول السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 422 ) قال النبي :(@)(@@) | 30 ( اتق الله واعدل بينهم كما لك عليهم من الحق أن يبروك ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنهما 
ms55	 .(@)(@@)(@@)(@@) $ ( 423 ) قال النبي :(@)(@@) | 30 ( اتقوا الله في النساء ) )(@)(@@) ( ن ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 424 ) قال النبي :(@)(@@) | 30 ( اتقوا الله في هاذه البهائم ، كلوها سمانا واركبوها صحاحا ) )(@)(@@) ( طب ) عن سهل بن الحنظلية رضي الله عنه .(@)(@@) PageV01P087(@)(@@)(@@)(@@) $ ( 425 ) قال النبي :(@)(@@) | 30 ( اتقوا الله وارحموا ترحموا ، ولا تباغضوا ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 426 ) قال النبي :(@)(@@) | 30 ( اتقوا الله وانظروا ما تفعلون فيها فإنها مسؤولة عنكم وعن أعمالكم فتخبر عنكم واذكروا أن ساكنها من لا يأكل الدم ، ولا يأكل الربا ، ولا يمشي بالنميمة ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن عمرو رضي الله عنهما أن رسول الله مر بقوم قعود بفناء الكعبة قال فذكره .(@)(@@)(@@)(@@) $ ( 427 ) قال النبي :(@)(@@) | 30 ( اتقوا المظالم ما استطعتم فإن الرجل يجيء يوم القيامة بحسناته يرى أنها ستنجيه فما يزال عند ذالك يقول إن لفلان قبلك مظلمة فيقال امحوا من حسناته فما يبقى له حسنة ، ومثل ذالك كمثل سفر نزلوا بفلاة من الأرض ليس معهم حطب فتفرق القوم فاحتطبوا للنار وأنضجوا ما أرادوا ، فكذالك الذنوب ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 428 ) قال النبي :(@)(@@) | 30 ( اتقوا شهر رمضان فإنه شهر الله جعل لكم أحد عشر شهرا تشبعون فيها وتروون وشهر رمضان شهر الله فاحفظوا فيه أنفسكم ) )(@)(@@) الديلمي من طريق مكحول عن أبي أمامة وواثلة وعبد الله بن بسر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 429 ) قال النبي :(@)(@@) | 30 ( اتقوا دعوات سعد ) )(@)(@@) ( ش ) عن قيس بن أبي حازم مرسلا .(@)(@@)(@@)(@@) $ ( 430 ) قال النبي :(@)(@@) | 30 ( اتقوا اللاعنين الذي يتخلى في طريق الناس وأفنيتهم ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 431 ) قال النبي :(@)(@@) | 30 ( اتقوا النار ولو بشق تمرة فإنها تقيم العوج ، وتسد الخلل ، وتدفع ميتة السوء ، وتقع من الجائع موقعها من الشبعان ) )(@)(@@) ( ع قط ) في العلل وضعفه و الديلمي عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 432 ) قال النبي :(@)(@@) | 30 ( اتقوا أبواب السلطان وحواشيها فإن أقرب الناس منها PageV01P088 أبعدهم من الله ، ومن آثر سلطانا على الله جعل الله الفتنة في قلبه ظاهرة 
ms56	 وباطنة وأذهب عنه الورع وتركه حيران ) )(@)(@@) الحسن بن أبي سفيان والديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 433 ) قال النبي :(@)(@@) | 30 ( اتقوا أذى المجاهدين في سبيل الله ، فإن الله يغضب لهم كما يغضب للرسل ، ويستجيب لهم كما يستجيب لهم ) )(@)(@@) ( قط ) في الأفراد و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 434 ) قال النبي :(@)(@@) | 30 ( اتقوا غضب عمر فإن الله يغضب إذا غضب ) )(@)(@@) ( ك ) في تاريخه و أبو نعيم في فضائل الصحابة ( خط ) والديلمي وابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 435 ) قال النبي :(@)(@@) | 30 ( اتقوا هاذه الكعبتين الموسومتين اللذين يزجران زجرا فإنهما من ميسر العجم ) )(@)(@@) ابن أبي الدنيا في ذم الملاهي ( هق ) عن ابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 436 ) قال النبي :(@)(@@) | 30 ( اتقوا دعوة المظلوم ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 437 ) قال النبي :(@)(@@) | 30 ( اتقوا دعوة المعسر ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 438 ) قال النبي :(@)(@@) | 30 ( اتقوا فورة العشاء ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 439 ) قال النبي :(@)(@@) | 30 ( أتقرؤون خلفي فلا تفعلوا إلا بام القرآن ) )(@)(@@) ( حم ) و عبد بن حميد ( ع هق ض ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 440 ) قال النبي :(@)(@@) | 30 ( أتقرؤون في صلاتكم والإمام يقرأ فلا تفعلوا ذاكم ، ليقرأ أحدكم بفاتحة الكتاب في نفسه ) )(@)(@@) ( طس هق ) عن أنس رضي الله عنه .(@)(@@) PageV01P089(@)(@@)(@@)(@@) $ ( 441 ) قال النبي :(@)(@@) | 30 ( أتقرؤون خلفي وأنا أقرأ فلا تفعلوا ذااكم ، ليقرأ أحدكم بفاتحة الكتاب في نفسه سرا ) )(@)(@@) ( عب ) عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ ( 442 ) قال النبي :(@)(@@) | 30 ( أتقولون إني من آخر موتاكم لأنا من أولكم موتا ثم تأتونني أفنادا يتبع بعضكم بعضا ) )(@)(@@) ( حل ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 443 ) قال النبي :(@)(@@) | 30 ( أتمشي أمام من هو خير منك ، إن أبا بكر خير من طلعت عليه الشمس وغربت ) )(@)(@@) ( كر ) عن أبي الدرداء قال : رأى النبي رجلا يمشي أمام أبي بكر رضي الله عنه قال فذكره .(@)(@@)(@@)(@@) $ ( 444 ) قال النبي :(@)(@@) | 30 ( أتمشي أمام من هو خير منك ؟ ألم تعلم أن الشمس لم تشرق على أحد 
ms57	 أو تغب خير من أبي بكر إلا النبيين والمرسلين ) )(@)(@@) أبو نعيم في فضائل الصحابة عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 445 ) قال النبي :(@)(@@) | 30 ( أتمشي أمام أبي بكر ؟ ما طلعت الشمس ولا غربت بعد النبيين والمرسلين على أفضل من أبي بكر ) )(@)(@@) أبو نعيم عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 446 ) قال النبي :(@)(@@) | 30 ( أتيت بكفة ميزان فوضعت فيها وجيء بامتي فوضعت في الكفة الأخرى فرجحت بأمتي ثم رفعت فجيء بأبي بكر فوضع في كفة الميزان فرجح بأمتي ثم رفع أبو بكر وجيء بعمر بن الخطاب فوضع في كفة الميزان فرجح بأمتي ثم رفع الميزان إلى السماء وأنا أنظر ) )(@)(@@) أبو نعيم في فضائل الصحابة عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 447 ) قال النبي :(@)(@@) | 30 ( أتيت في المنام بعس مملوء لبنا فشربت منه حتى امتلأت فرأيته يجري في عروقي ففضلت فضلة فأخذها عمر بن الخطاب فشربها أولوا هاذا ، قالوا : هاذا العلم قال : أصبتم ) )(@)(@@) ( خط كر ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV01P090(@)(@@)(@@)(@@) $ ( 448 ) قال النبي :(@)(@@) | 30 ( أتيت فيما يرى النائم بمفاتيح الدنيا ثم ذهب بنبيكم إلى خير مذهب وتركتم في الدنيا تأكلون الخبيص ، أحمره وأصفره وأبيضه الأصل واحد العسل والسمن والدقيق ، ولاكنكم اتبعتم الشهوات ) )(@)(@@) ابن سعد عن سالم بن أبي الجعد مرسلا .(@)(@@)(@@)(@@) $ ( 449 ) قال النبي :(@)(@@) | 30 ( أتيت بجارية في سرقة من حرير من بعد وفاة خديجة فإذا هي أنت ، فقلت : إن يكن هاذا من عند الله يمضه ، ثم أتيت بجارية في سرقة من حرير فكشفتها فإذا هي أنت ، فقلت : إن يكن هاذا من عند الله يمضه ) )(@)(@@) ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 450 ) قال النبي :(@)(@@) | 30 ( أتيت بك في خرقة من حرير في المنام ثلاث ليال ، فقيل هاذه امرأتك ، فكشفت الثوب فإذا أنت فأقول إن يكن هاذا من عند الله يمضه ) )(@)(@@) ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 451 ) قال النبي :(@)(@@) | 30 ( أتيت على سماء الدنيا ليلة أسري بي فإذا فيها رجال تقطع ألسنتهم وشفاههم بمقاريض من نار ، قلت : يا جبريل من هاؤلاء ؟ قال 
ms58	 : خطباء أمتك ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع الثاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 452 ) قال النبي :(@)(@@) | 30 ( أثبت أحد فإنما عليك نبي وصديق وشهيدان ) )(@)(@@) ( خ د ت ) عن أنس ( ت ) عن عثمان ( حم ( 4 ) حب ) عن سهل بن سعد رضي الله عنهما ( ز ) .(@)(@@) PageV01P091(@)(@@)(@@)(@@) $ ( 453 ) قال النبي :(@)(@@) | 30 ( أثبت حراء فإنما عليك نبي أو صديق أو شهيد ) )(@)(@@) ( حم د ت ه ) عن سعيد بن زيد ( حم ) عن أنس وعن بريدة ( طب ) عن ابن عباس رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 454 ) قال النبي :(@)(@@) | 30 ( أثبتكم على الصراط أشدكم حبا لأهل بيتي ولأصحابي ) )(@)(@@) ( عد فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 455 ) قال النبي :(@)(@@) | 30 ( أثردوا ولو بالماء ) )(@)(@@) ( طس هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 456 ) قال النبي :(@)(@@) | 30 ( أثقل الصلاة على المنافقين صلاة العشاء وصلاة الفجر ولو يعلمون ما فيهما لأتوهما ولو حبوا ، ولقد هممت أن آمر بالصلاة فتقام ثم آمر رجلا فيصلي بالناس ثم أنطلق معي برجال معهم حزم من حطب إلى قوم لا يشهدون الصلاة فاحرق عليهم بيوتهم بالنار ) )(@)(@@) ( حم ق د ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 457 ) قال النبي :(@)(@@) | 30 ( أثقل شيء في الميزان الخلق الحسن ) )(@)(@@) ( حب ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 458 ) قال النبي :(@)(@@) | 30 ( أثقل شيء في ميزان المؤمن خلق حسن ، إن الله يبغض الفاحش المتفحش البذيء ) )(@)(@@) ( هق ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 459 ) قال النبي :(@)(@@) | 30 ( اثنان خير من واحد ، وثلاثة خير من اثنين ، وأربعة خير من ثلاثة فعليكم بالجماعة فإن الله لن يجمع أمتي إلا على هدى ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 460 ) قال النبي :(@)(@@) | 30 ( اثنان فما فوقهما جماعة ) )(@)(@@) ( ه عد ) عن أبي موسى PageV01P092 ( حم طب عد ) عن أبي أمامة ( قط ) عن ابن عمرو ، ابن سعد والبغوي والباوردي عن الحكم بن عمير رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 461 ) قال النبي :(@)(@@) | 30 ( اثنان لا تجاوز صلاتهما رؤوسهما عبد أبق من مواليه حتى يرجع ، وامرأة عصت زوجها حتى ترجع 
ms59	 ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 462 ) قال النبي :(@)(@@) | 30 ( اثنان لا ينظر الله إليهما يوم القيامة : قاطع الرحم ، وجار السوء ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 463 ) قال النبي :(@)(@@) | 30 ( اثنان يعجلهما الله في الدنيا : البغي ، وعقوق الوالدين ) )(@)(@@) ( تخ طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 464 ) قال النبي :(@)(@@) | 30 ( اثنتان في الناس هما بهم كفر الطعن في الأنساب ، والنياحة على الميت ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 465 ) قال النبي :(@)(@@) | 30 ( اثنان يكرههما ابن آدم : يكره الموت والموت خير له من الفتنة ، ويكره قلة المال وقلة المال أقل للحساب ) )(@)(@@) ( ص حم ) عن محمود بن لبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 466 ) قال النبي :(@)(@@) | 30 ( اثنتان تدخلان الجنة : من حفظ ما بين لحييه ورجليه دخل الجنة ) )(@)(@@) ( الخرائطي ) في مكارم الأخلاق عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 467 ) قال النبي :(@)(@@) | 30 ( أثيبوا أخاكم أدعوا له بالبركة فإن الرجل إذا أكل طعامه وشرب شرابه ثم دعي له بالبركة فذاك ثوابه منهم ) )(@)(@@) ( د هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 468 ) قال النبي :(@)(@@) | 30 ( اثبتوا فإنكم أوتادها ، وما من عبد يخطو خطوة إلى PageV01P093 الصلاة إلا كتب له بها أجر ) )(@)(@@) ( ط ض ) عن عبد الرحمن بن جابر بن عبد الله عن أبيه رضي الله عنهم قال : أردنا بني سلمة أن نتحول من منازلنا فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 469 ) قال النبي :(@)(@@) | 30 ( إثنان خير من واحد ، وثلاثة خير من اثنين ، وأربعة خير من ثلاثة فعليكم بالجماعة فإن يد الله على الجماعة ، ولم يجمع الله عز وجل أمتي إلا على هدى واعلموا أن كل شاطن هوى في النار ) )(@)(@@) ( كر ) عن البختري بن عبيد عن أبيه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع الجيم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 470 ) قال النبي :(@)(@@) | 30 ( أجب أخاك فإنك منه على اثنتين إما خير فأحق ما شهدته ، وإما غيره فتنهاه عنه وتأمره بالخير ) )(@)(@@) ( طب ) عن يعلى بن مرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 471 ) قال النبي 
ms60	 :(@)(@@) | 30 ( يا عائشة كنت لك كأبي زرع لام زرع إلا أن أبا زرع طلق وأنا لا أطلق ) : ( اجتمع إحدى عشرة امرأة في الجاهلية فتعاقدن أن يتصادقن بينهن ولا يكتمن من أخبار أزواجهن شيئا ، فقالت الأولى : زوجي لحم جمل غث على رأس جبل وعر ، لا سهل فيرتقى ، ولا سمين فينتقى ؛ قالت الثانية : زوجي لا أبث خبره ، إني أخاف أن لا أذره ، إن أذكره أذكر عجره وبجره ؛ قالت الثالثة : زوجي العشنق ، إن أنطق أطلق وإن أسكت أعلق ؛ قالت الرابعة : زوجي إن أكل لف ، وإن شرب اشتف ، وإن اضطجع التف ، ولا يولج الكف ليعلم البث ؛ قالت الخامسة : زوجي عياياء طباقاء ، كل داء له داء شجك أو فلك ، أو جمع كلا لك ؛ قالت السادسة : زوجي كليل تهامة ، لا حر ولا قر ، ولا مخافة ولا سآمة ؛ قالت PageV01P094 السابعة : زوجي إن دخل فهد ، وإن خرج أسد ، ولا يسأل عما عهد ؛ قالت الثامنة : زوجي المس مس أرنب ، والريح ريح زرنب ، وأنا أغلبه والناس يغلب ؛ قالت التاسعة : زوجي رفيع العماد طويل النجاد ، عظيم الرماد ، قريب البيت من الناد ؛ قالت العاشرة : زوجي مالك وما مالك ؟ مالك خير من ذالك ، له إبل قليلات المسارح ، كثيرات المبارك ، إذا سمعن صوت المزاهر أيقن أنهن هوالك ؛ قالت الحادية عشرة : زوجي أبو زرع وما أبو زرع ؟ أناس من حلي أذني ، وملأ من شحم عضدي ، وبجحني فبجحت إلي نفسي وجدني في أهل غنيمة بشق ، فجعلني في أهل صهيل وأطيط ودائس ومنق ، فعنده أقول فلا أقبح ، وأرقد فأتصبح ، وأشرب فأتقمح ، أم أبي زرع وما أم أبي زرع ، عكومها رداح وبيتها فساح ، ابن أبي زرع وما ابن أبي زرع ، مضجعه كمسل شطبة ، وتشبعه ذراع الجفرة ، بنت أبي زرع وما بنت أبي زرع ، طوع أبيها وطوع أمها ، وملء كسائها وعطف ردائها ، وزين أهلها وغيظ جارتها ، جارية أبي زرع وما جارية أي زرع ، ولا تنث حديثنا تنثيثا ، ولا تنقث ميرتنا تنقيثا ، ولا تملأ بيتنا تعثيثا ، خرج أبو زرع والأوطاب تمخض ، فمر بامرأة معها ابنان لها كالفهدين ، يلعبان من تحت 