ms101	 بالعذيبو ثهمد % PageV01P315 11(@)(@@) % و طمعت منها بالحديثو قلتهل % منشربة يا أهلهذا المورد % 12(@)(@@) % ما الماءمنطلبيو لكنربما % % مدتبهفتنالمنيدهايدي % % 13(@)(@@) % فأتتبهمنحينهاو كأنها % % شمس تمدبكوكب متوقد % % 14(@)(@@) % فسرقتمنحسنالمليحةلمحة % قطعتعرى كبديبغيرمهند % 15(@)(@@) % إنتفترحنيزينبابنةمالك % أدبا و معرفةأعيدو أبتدي % % 16(@)(@@) % فالشعرليو الحسنخالصةلها % % و يدالصنيعلأحمد بنمحمد % 17(@)(@@) % قمرالكمالثمالكلمؤمل % كنزالمرجى كهفكلمشرد % 18(@)(@@) % علم تخيرهالمهيمنللورى % % سيفا على الأعداءليسبمغمد % 19(@)(@@) % رفعتلهالآثارفيفلكالعلى % % رتبا بناهافي عراصالفرقد % 20(@)(@@) % شرف أنافإلى منافخزيمة % و سمى بفاطمو الوصى و أحمد % PageV01P316 21(@)(@@) % و هوابنسرا لصالحينو قطبهم % و جمالجملتهم وروضهم الندى % % 22(@)(@@) % الأهدلالشيخالمباركجده % و أبوهساميالفرعساميالمحتد % 23(@)(@@) % و المجدو الكرمالعريضرداؤه % و شعارهو دثارهفيالمشهد % 24(@)(@@) % بذل إذاطارتشرارةبأسه % طمستمحلالزائغالمتمرد % 25(@)(@@) % و فنى يزورالوفدساحةجوده % لورودبحر بالمكارممزيد % 26(@)(@@) % للهدرأبيالفضائل إنه % يورى بزند منهليسبمصلد % 27(@)(@@) % لميهدمالدنيابحطمحطامها % % إلا ليزرعما سيحصدفي غد % 28(@)(@@) % يامدع فيالفخرنيلمناله % أعلمتأنكمدع أممعتدي % % 29(@)(@@) % رفعتبنو الحسنيندونكمنثنا % % سبعالمثانيو الحديثالمسند % 30(@)(@@) % كرم يلوحعلى شمائلهمكما % % لاحتمصابيحالدجى للمهتدي % % PageV01P317 31(@)(@@) % و محامدعلتالمحامدفاغتدت % سيرا بهاأهلالمكارمتقتدي % % 32(@)(@@) % إنتدعأحمد يبتدرك ملبيا % منليسيعرفلابغيرتشهد % 33(@)(@@) % جمعتبمنصبهالفضائلمثل ما % % جمعتمفرقةالحروفبأبجد % 34(@)(@@) % هوبهجةالدنياو عصمةأهلها % % و غياثهامنكلخطب أنكد % 35(@)(@@) % مولايجئتكو الدياربعيدة % و طمعتفيكو أنتغايةمقصدي % % 36(@)(@@) % و رجوتمنكلبانة أمحو بها % % فحوى كتاببالذنوبمسود % 37(@)(@@) % فأمدنيبيد تطولبهايدي % % و صنيعة يرويبهاقلبيالصدى % 38(@)(@@) % و اعطفبزاد بعدذاكمبلغ % و بكسوتينلمنشيء و لمنشد % 39(@)(@@) % لأعودمنكبخيرما أملته % مترديامنجودكالمتردد % 40(@)(@@) % و بقيتفيكنفالإله وستره % متفيئا ظلالنعيمالسرمدي % % PageV01P318 41(@)(@@) % في حيث لا الراجييخيب ولا الأذى % % يخشى ولاباب النوال بموصد % PageV01P319 البحر : - 1(@)(@@) % رفاقي الظاعنينمتى الورود % و ذياك العذيب وذا زرود % 2(@)(@@) % فعوجوا بي على آثار ليلى % % فما يدري الغريب متى يعود % 3(@)(@@) % و زوروا شعبها فعلى فؤادي % % و قلبي من نسيمه برود % 4(@)(@@) % رفاقي الظاعنين ترفقوا بي % % فقلبي في هوى ليلى عميد % 5(@)(@@) % أعيدوا لي الحديث بذكر ليلى مررت على بقية ربع ليلى فساعد لوعتي دمع يجود % % أعيدوه فديتكمأعيدواسقط بيت ص % % 6(@)(@@) % و حييت الطلول فلم تجبني % % و كيف تجيبني سفع ركود % 7(@)(@@) % نأت وتباعدت ليلى وعزت % على وما تباعدت العهود % 8(@)(@@) % رعى الله الزمان زمان ليلى % % و لا رعى التفرق والصدود % 9(@)(@@) % فما أحلى هواها في قؤادي % % و إن بخلت على بما أريد % 10(@)(@@) % جرى قلم السعادة باسم ليلى 
ms102	 % % فطاب بذكرها عيشي الرغيد % PageV01P320 11(@)(@@) % فكيف يلومني في حب ليلى % % خلي القلب أدمعه جمود % 12(@)(@@) % وإن فتى رمته جفون ليلى % % ومات على الفراش هو الشهيد % 13(@)(@@) % و إن فتى يمر بأرض ليلى % % ويلثم حيث موطئها سعيد % 14(@)(@@) % نعم يبلى الزمان وحب ليلى % % جديد ليس يبليه الجديد % 15(@)(@@) % وقفت عشيةببلاد ليلى % % و بت وأدمعي در نضيد % 16(@)(@@) % و نهنهت الغرام فهيجتني % % سواجع في الأراك لها نشيد % 17(@)(@@) % لحى الله الزمان فقد بلاني % % بصبر ناقص وجوىيزيد % 18(@)(@@) % يفيد صنيعة ويقيت أخرى % % و يمنح نعمة ولها حسود % 19(@)(@@) % و ماقدر الزمانو في قفار % غمام فيضه كرم وجود % 20(@)(@@) % فلم بقبر سيدنا النهارى % % فتبيض المطالب وهي سود % PageV01P321 21(@)(@@) % جناب جلالة وربيع بر % ربت في ريف رأفته الوفود % 22(@)(@@) % فيا طرب النفوس إلى صعيد % يكفر ذنبها ذاك الصعيد % 23(@)(@@) % صعيد تظهر البركات منه % و تطلع في جوانبه السعود % 24(@)(@@) % فمن دار السلام له نسيم % و من نور الجلال له عمود % 25(@)(@@) % به الكرم الذي يغني ويقني % % و لا عرض لديه ولا نقود % 26(@)(@@) % لدى ملك يقل الملك عنه % و تحتقر العساكر والجنود % 27(@)(@@) % سما فاستخدم الأشياء فيما % % يشاء ولا إماء ولا عبيد % 28(@)(@@) % فتى غرس المحامد واجتناها % % فضائل ليس يحصرها عديد % 29(@)(@@) % محمد يا فتى عمر بن موسى % % أضام وأنت لي ركن شديد % 30(@)(@@) % يواعدني العدو بغير جرم % أتعجز أنيحل به الوعيد % PageV01P322 31(@)(@@) % أما ترثي لأطفال صغار % أبوهم من محلتهم طريد % 32(@)(@@) % يمر العيد بالصبيان لهوا % و ليس لهم مع الصبيان عيد % 33(@)(@@) % فأين مكارم الأخلاق يا من % ببهجة وجهه ابتهج الوجود % 34(@)(@@) % فثم بواعث بعثت غرامي % % و أهوال يشيب لها الوليد % 35(@)(@@) % و ما جسمي على الحدثان صخر % و لا قلبي على السلوى حديد % 36(@)(@@) % فكن يد نصرتي وجناب عزي % % إذا ما جار جبار عنيد % 37(@)(@@) % و قلللمعتدين على بعدا % % لمدين مثل ما بعدت ثمود % 38(@)(@@) % فلا عدد ولا مدد يقيهم % و لا مصر ولا قصر مشيد % 39(@)(@@) % و أنت المستعان لكل خطب % وما 
ms103	 يبدي الزمان وما يعيد % 40(@)(@@) % و سيفك في النوائب غير ناب % وسهمك ماء مورده الوريد % PageV01P323 41(@)(@@) % إذا عبد الرحيم دعاك يوما % على بعد فقدحضر البعيد % 42(@)(@@) % حماك اليوم لي ولمن يليني % % و يشملنا غدا منك الخلود % 43(@)(@@) % بقيت لملة الإسلام نورا % تضيء بك التهائم والنجود % 44(@)(@@) % و حيا أرضا اشتملتكغيث % يسبح في جوانبه الرعود % 45(@)(@@) % و صلى ذو الجلال على نبي % % به منشي المدائح مستفيد % PageV01P324 البحر : - 1(@)(@@) % أهاب سحيرا بالفراق مهيب % فلباه وجدا في الحشا ولهيب % 2(@)(@@) % و حقق ظني بالرحيل مودع % مدامعه في وجنتيه تصوب % 3(@)(@@) % فما كذبتني رمزة معنوية % أشار بها ري البنان خضيب % 4(@)(@@) % يردبطرفيه السلام وحوله % رقيب ومن حول الرقيب رقيب % 5(@)(@@) % حمته عن التوديع زرق أسنة % تكادتذيب الصخر وهو صليب % 6(@)(@@) % فمن أين يصفو العيش بعد أحبة % ركائبهم بين الشعاب شعوب % 7(@)(@@) % و هل سلوة بعد الفراق لهائم % شج قلبه قبل الفراق كئيب % 8(@)(@@) % و بين الخيام البيض من أيمن الحمى % % قلوب دعتها للرحيل قلوب % 9(@)(@@) % إذا لم أذب بعد الفريق صبابة % فمن أي شيء بعد ذاك أذوب % 10(@)(@@) % يشوقني روح النسيم فلوعتي % % لها كلما هب النسيم هبوب % PageV01P325 11(@)(@@) % أظل على أطلالهم وربوعهم % أحن كأني في الحنين رقوب % 12(@)(@@) % وأندب سفح البان أيام صبوتي % % إليه وبرد اللهو فيه تشيب % 13(@)(@@) % دعتني أضاليل المنى غيرة مرة % % فما كدت بعد الظاعنين أجيب % 14(@)(@@) % و أطمعني حكمالهوى أن يعيد لي % % طلوعشموس لم يشبه غروب % 15(@)(@@) % فما عاضني بالأبلق الفرد عائض % و لا شاقني بعد الكثيبكثيب % 16(@)(@@) % و هيهات ما كل المنازل رامة % و لاكلبيضاء الجبينعروب % 17(@)(@@) % و كم من سمى ليس مثلسميه % % و إنكانيدعى باسمهفيجيب % 18(@)(@@) % فيا ذاكرا عنذي الأركأعدلنا % % حديثكعنأهلالأركيطيب % 19(@)(@@) % سمعتكتحكي عنخييماتعالج % عسى لكعهد بالخيامقريب % 20(@)(@@) % صف الأثل والمرعى الخصيب لحاجر % هل الأثل والمرعى الخصيب خصيب % % PageV01P326 21(@)(@@) % و ما فعل الرمل العقيقي هل ذرت % عليه شمال أمصبا وجنوب % 22(@)(@@) % و هل سمرتبعدي لغوب على اللوى % % فأين اللوى منى وأين لغوب % 23(@)(@@) % أماو مريضاتالجفونألية % لمنلميكدعنحبهنيثوب % 24(@)(@@) % ليدر 
ms104	 شهاب الدين أحمد أنني % % لداعيهفيكلالأمورمجيب % 25(@)(@@) % هوالطيبابنالطيبينو عمدتي % % عليهو ظنيفيهليسيخيب % 26(@)(@@) % لقدنابعني كلأمر أخافه % فلمأخشأمرا للزمانينوب % 27(@)(@@) % كفاني صروفالدهرمنبعدما سطت % على مخاليب لها ونيوب % 28(@)(@@) % ذاد الخطوبالسودعنيبجوده % فماساورتنيللخطوبخطوب % 29(@)(@@) % فللهبر أريحي مهذب % عنالرجسأواه أغرمنيب % 30(@)(@@) % حفي و في مشفق متعطف % عزبز منيعالجانبينمهيب % PageV01P327 31(@)(@@) % كريم منالغرالكرامو سيد % منالنجباءالصالحيننجيب % 32(@)(@@) % يطوليدا بالجودللرفدإنما % % هوالبحرجود والكرامقليب % 33(@)(@@) % لنامنهخلق أريحي و منظر % بهى و صدر بالنوالرحيب % 34(@)(@@) % أمولايجانيمنكبعدافتراقه % كلام يكادالطفلمنهيشيب % 35(@)(@@) % أطلتملاميفيأمور كثيرة % فلم أدرمن أيالذنوبأتوب % 36(@)(@@) % و أمرضنيمنكالعتابو ليسلي % % سواكإذاعزالطبيب طبيب % 37(@)(@@) % إذا عزني ضيفانصبريغدرتني % % أليسلنابعدالحضورمغيب % 38(@)(@@) % أراكعلى بعدالطريقتلومني % % إذاقيلليتلكالطريققريب % 39(@)(@@) % فقدكنتفيذابانأعثرمرة % و أسفطأخرى كلذاكلغوب % 40(@)(@@) % إلى أندهتنيفي جوانبأرضه % مصائبتذوي الغصن وهورطيب % PageV01P328 41(@)(@@) % فحينئذ أنسمتلا عجتموطئا % عواني ذئب أوعداني ذيب % 42(@)(@@) % و طلقتذابانالثلاثو لمأعد % إليهو ماليفيه وهو شغوب % 43(@)(@@) % و كيفقفولينحوبيت نويرة % و قد ساءنييوم هناكعصيب % 44(@)(@@) % ذكرتكلامالغشمري وصنوه % و ما فعلاه والغريب غريب % 45(@)(@@) % سمعتهما حينابنعمكلميقم % يقولانذياكالملام مريب % 46(@)(@@) % و سلعليهابنالفواجرخنجرا % صقيلا يرى للنملفيهدبيب % 47(@)(@@) % فذ بيتعنأعراضنابصوارم % منالشعرما فلتلهنغروب % 48(@)(@@) % و لولاك بللولاأبوكعليكما % % تزاحهموم أوتزال كروب % 49(@)(@@) % فخذبيدييا آلشمس عمارة % و لوأنذنبييذ بلوعسيب % 50(@)(@@) % و كن عصمتيمنجوردهر معاند % بهالحر عبد و الصدوقكذوب % PageV01P329 51(@)(@@) % فماأنتإلاسيد و ابنسيد % و بركما غيم على سكوب % 52(@)(@@) % أبوكحبيبيقدساللهروحه % و أنتابنهو ابنالحبيبحبيب % 53(@)(@@) % تداركتنيباللطفو الدهرعابس % وأخصبتربعيوالزمانجديب % 54(@)(@@) % و كملكعنديمنيد لووزنتها % % لماوزناهامنوح و شعيب % 55(@)(@@) % سأطلبمنكالصفححتى يكونلي % % لديك منالصفحالجميل نصيب % 56(@)(@@) % إذاكنتأهلالعفوعنكلمذنب % و لم تعف عنيإنذالعجيب % 57(@)(@@) % فهاكمنالدرالنضيدغريبة % تروقأعاريضا لهنضروب % 58(@)(@@) % مناللاءلميسبقإليهنشاعر % سواى و لمينطقبهنأديب % 59(@)(@@) % عليكسلام سرمدي مبارك % روائحهمسك يفوحو طيب % PageV01P330 البحر : - 1(@)(@@) % رد بالمطى مواردالغزلان % و انشدفؤادا بينأهلالبان % 2(@)(@@) % واعكف على الدمن التي بمحجر % و دعالحنين لأبرق الحنان % 3(@)(@@) % واندب زمان اللهو في عرصاتها % % و مواقف الفتيات والفتيان % 4(@)(@@) % أيام ليلى العامرية جارتي % % و خباؤها المضروب قيد عنان % 5(@)(@@) % و الربع محبوس الجناب عن النوى % % و الناس ناسي والزمان زماني % % 6(@)(@@) % ياليت شعري والرمان مفرق % أيعود لي زمني بشعب زمان % 7(@)(@@) % وأبيت في سمرات رامة سامرا % و أطل تحت ظلالها المتداني % % 8(@)(@@) % هيهات ذاك زمان أنس عز أن 
ms105	 % أنساه أو ألقاه أو يلقاني % % 9(@)(@@) % قالوا تعز عن الهوى فأجبتهم % ما أبعد الذكرى من النسيان % 10(@)(@@) % أم كيف نسلو في الغوير وربعنا % % شام وربع المنجدين يماني % % PageV01P331 11(@)(@@) % و حياتهم وسماتهم مالذ لي % % زمن الصبا إلا وهم جيراني % % 12(@)(@@) % طرق النسيم الحاجريلحاجري % % سحرا فعانق ناعم الأغصان % 13(@)(@@) % و سقى الحيا روض الربافتبسمت % % عن أبيض يقق وأحمر قاني % % 14(@)(@@) % و تطارحتورق الحمائم بالحمى % % طرق السجوع بطيب الألحان % 15(@)(@@) % و بكيت أوطاني وربع هواي في % % زمن الصبا حييت من أوطان % 16(@)(@@) % و بغيت غيثا مستعيرا جوده % من جود عبد الله ذي الإحسان % 17(@)(@@) % أعني الوليابن الولي المنتقى % % صافي السريرة صفوة الرحمن % 18(@)(@@) % سيف الصلاح يد السماح فتى أبي % % بكر حمى الغرباء والضيفان % 19(@)(@@) % بحر يموج غنى لملتمس الغنى % % و حيا يصوب كصيب العقبان % 20(@)(@@) % الحامل الأثقال والحامي حمى ال % % إسلام والداعي إلى الإيمان % PageV01P332 21(@)(@@) % و الصائمالوقدات والمتهجد ال % % ماحي دجى الظلمات بالقرآن % 22(@)(@@) % أضحى عفيف الدين فرد جلالة % يعلو ويسمو أن يقاس بثاني % % 23(@)(@@) % لما سمعت به سمعت بواحد % و رأيته فإذا هو الثقلان % 24(@)(@@) % فوجدت كل الصيد في جوف الفرا % % ولقيت كل الناس في إنسان % 25(@)(@@) % و الشمس تخجل من بهاء جبينه % و البحر يغرق بين خمس بنان % 26(@)(@@) % نعمت بساحته الوفود فما دروا % % أديار ترغمأمرياضجنان % 27(@)(@@) % و نووا عكوفا حوله كعكوفهم % في الحج بين البيت والأركان % 28(@)(@@) % يا سائلي عنه اعتمدهفإنه % سر الوجود وبهجة الأزمان % 29(@)(@@) % ينميه بين خؤولة وعمومة % جدان في التفضيل مستويان % 30(@)(@@) % بدران مبتدران في أفق العلى % % جبلان مرتفعان ممتنعان % PageV01P333 31(@)(@@) % و ضبا نعيم وابن عبد اللهفي % % أسراره نور الهدى الرباني % % 32(@)(@@) % فحوى فخارهما وطال هداهما % % شرفا فنعم النجم والقمران % 33(@)(@@) % لله منفاقالكراممكانه % فعلا على النظراء والأقزان % 34(@)(@@) % بجلالة الآباء والأجداد وال % % أعمام والأخوال والإخوان % 35(@)(@@) % بركاتها في المسلمين عميمة % كالغيث يشمل سائر البلدان % 36(@)(@@) % و له كرامات يؤلف بعضها % % باللطف بين الماء والنيران % 37(@)(@@) % و لقد يشير إلى السماء بطرفه % فيجاب قبل تصافح الأجفان % 38(@)(@@) % و 
ms106	 يرى بنور الله منه فراسة % مالا تراه بنورها العينان % 39(@)(@@) % و هو الذي تقوى الإله شعاره % و دثاره في السر والإعلان % 40(@)(@@) % حزم يصول على الخطوب ببأسه % و يرود روض الخير كل أوان % PageV01P334 41(@)(@@) % و أغر يستسقى الغمامبوجهه % وبه يعم الخير كلمكان % 42(@)(@@) % و بحبه تحيا النفوس لكونه % فيها مكان الروح في الأبدان % 43(@)(@@) % تهدي مدائحنا إليه فتكتسي % % منه معاني الشعر حسن معاني % % 44(@)(@@) % و يلذللشعراء طيب ثنائه % فكأنهم يتلون سبع مثاني % % 45(@)(@@) % مازلت أشكره نداه وكلما % % طالت يداه علي طال لساني % % 46(@)(@@) % مولاي جئتك والخطوب عوابس % و الدهر يصرف نابه لهوان % 47(@)(@@) % زمن يعاندني ودين أدنى % % كصفا المشرق أد من ثهلان % 48(@)(@@) % و علاج فقر لا يفارق منزلي % % مالي بسطوتهعلي يدان % 49(@)(@@) % فتولني وأقل بجودكعثرتي % % و أقل نوب نوائب الحدثان % 50(@)(@@) % وانظر إلى بعين لطفك نظرة % أحيي بها أملي وأصلح شاني % % PageV01P335 51(@)(@@) % و أمدني بندك وامسج بالغنى فقري % % و أرغم أنف من يشناني % % 52(@)(@@) % فعساك إن أكرمتنيأحييتني % % و أمت رب فلانة و فلان % 53(@)(@@) % و بقيت جاهي في الزمان ووجهتي % % و يدي وسبقي في العدا وسناني % % 54(@)(@@) % و اسلم ودمجبلا نلوذ بظله % و غياث قاص في الأنام وداني % % 55(@)(@@) % في حيث مثوى الضيف مختلف القرى % % كرما وجار الجنب غير مهان % PageV01P336 البحر : - 1(@)(@@) % سقاك خيام الغور صوب الحيا عهدا % % يجدد عنا في معاهدك العهدا % % 2(@)(@@) % و لا برحت فيك الرياح مريضة % تناغى الغصون الخضر والقضب الملدا % % 3(@)(@@) % و تنثر در الطل في ظل روضة % ترش يد الأنداء في وردها الوردا % % 4(@)(@@) % كأن صبا نجد سقتها مدامة % عبيرية تهدي لمن لم يجد وجدا % % 5(@)(@@) % فماسخزاماها وبات حمامها % % يغنى وظل الرند يعتبق الرندا % % 6(@)(@@) % رعى الله إذ كنا برامة جيرة % و محكم أصل الوصل قد نسخ الصدا % % 7(@)(@@) % و أبكار بكر يسترقن عقولنا % % بسحر عيون إن رنت قتلت عمدا % % 8(@)(@@) % أحيباب قلبي كيف أكتم حبكم % وأجحده والدمع لا يعرف الجحدا % % 9(@)(@@) % صلوا واهجروا فالقلب راض بفعلكم % فلم أر لي عنكم ولا منكم 
ms107	 بدا % % 10(@)(@@) % و أحلى الهوى إن مت في أسر حبكم % فكم من أسير للصبابة لا يفدى % % PageV01P337 11(@)(@@) % و ما ضقتذرعا دون إدراك مطلب % و في الرد من لم يخش سائله الردا % % 12(@)(@@) % أعاد علينااللهمنبركاته % % و مدلنا الرحمنفيعمرهمدا % % 13(@)(@@) % إلى صارم الدين انتهى أملي فلم % أجد قبله قبلا ولا بعده بعدا % % 14(@)(@@) % متى تأنهتنزل بواحد أمة % هدى وندى جاء الزمان به فردا % % 15(@)(@@) % سجاياه للراجي ربيع مبارك % و سبع سمان للزمان إذا اشتدا % % 16(@)(@@) % و ساحته على مأوى الغريب وماله % على رغم أنف البخلينهبه الوفدا % % 17(@)(@@) % فتى ينسب الشيخ المبارك جده % كما ينسب الأشراف خير الورى جدا % 18(@)(@@) % سقى الله من قبرى عواجة مشهدا % كريما تخذناهلحاجتناقصدا % % 19(@)(@@) % أفي روضةالقبرينروضة أحمد % فتحدى لها عيس إلى طيبة تحدى % % 20(@)(@@) % أم التزم الزوار حجا وعمرة % إليها فزموا العيس تطوى الفلا وجدا % % PageV01P338 21(@)(@@) % حوى قبرها حجرا وبيتا ومذبحا % و ركنا يمانيا وآخر مسودا % % 22(@)(@@) % فكم قبلوا تربا وكم مسحوا ثرى % % و كم وضعوا إصرا وكم فتحوا عقدا % % 23(@)(@@) % و كم ئملوا وجدا وكم ولهوا هوى % % و كم سفكوا دما وكم عفروا خدا % 24(@)(@@) % و باتوا وظلوا في رياض أنيقة % يقلعليها الندلوفرشتندا % % 25(@)(@@) % تحفهمالأملاك منكلجانب % و تغشاهم الأنوارعنطالع سعدا % % 26(@)(@@) % لدى حكمي لم تكنمعجزاته % و آياتهتحصى برملالفلاعدا % % 27(@)(@@) % إذاقال يا مولايلباهسلتنل % لطائف من لو شاء أسرى بهعبدا % % 28(@)(@@) % و لوسير الأجبال سارت وإن دعا % % ذرى صخرة لبت لهالصخرة الصلدا % % 29(@)(@@) % و لو سار فوق البحر أو طار في الهوى % % لأمكنه والحق ما جاوز الحدا % % 30(@)(@@) % سرائر نورانية حكيمة % بها الله زان الأرض والعرض والخلدا % % PageV01P339 31(@)(@@) % هنيئا لك التنظيم يا ابن محمد % محامد في الدارين تستغرق الحمدا % % 32(@)(@@) % رعيت رياضالمجد طفلا وناشئا % و كهلا ومن ذا يدعي معك المجدا % % 33(@)(@@) % تلوذ بك الآمال وهي غريبة % فتؤنسها جودا وتوسعها رفدا % 34(@)(@@) % و ينزلمنك الضيف أخصب ساحة % فتجلوا لهم ودا وتصفوا لهم وردا % 35(@)(@@) % عفاف وإنصاف و حسنشمائل % تفوق شمول الراح ممزوجة شهدا % 36(@)(@@) % أيا سيدي شهر كريم و 
ms108	 غربة % و دين أقاسيهو لستبهجلدا % % 37(@)(@@) % و غيبةأطفال و بعدمنازل % و إخوان صدق ذبت من أجلهمفقدا % % 38(@)(@@) % فقض لباناتي وأنجح مطالبي % % و ما استطعت من بر فلا تألني جهدا % % 39(@)(@@) % بقيت لدين الله عزاو للعدا % % حساما وللراجين عارفة تسدا % % 40(@)(@@) % و لازلت للأبدال خالف سالف % و نور منار نستضيء بك الرشدا % % PageV01P340 البحر : - 1(@)(@@) % دم المحب على الأطلال مطلول % و سيف سحر عيون العين مسلول % 2(@)(@@) % هن الحواجب من تحت الحجاب لها % % منا أسير ومجروح ومقتول % 3(@)(@@) % وللنوى و الهوى العذري في كبدي % % و قف صريح وتحبيس و تسبيل % 4(@)(@@) % ما حدذث الركب عن سلمى بذي سلم % إلا استمعت وماء العين مهمول % 5(@)(@@) % و لا تغنت بذات الأسل ساجعة % إلا وهيجتني سجع ومأمول % 6(@)(@@) % فكيف يسلو فؤادي بالغوير ولي % % بالمنجدين أماني وتضليل % 7(@)(@@) % و في الستائر بنت العيس نفحتها % % مسك ومبسمها بالشهد معسول % 8(@)(@@) % مسك يفوح وأنوار تلوح على % % فضي خد بماء الحسن مطلول % 9(@)(@@) % هي الشفاء لدائي لو ظفرت بها % % و ليس منا دوا للداء مبذول % 10(@)(@@) % من منصفي من قضيب في كثيب نقا % أعلاه بدر عليه الليل مسدول % PageV01P341 11(@)(@@) % فما برحن تباريحي على كبدي % % بفارغ القلب قلبي فيه مشغول % 12(@)(@@) % يالائميفي هوى قوم أحبهم % و الناس في الحب معذور ومعذول % 13(@)(@@) % إن كان شوقك معلوما على صفة % فإن شوقي معلوم ومجهول % 14(@)(@@) % عليك نفسك إن العمر عارية % و مرتقى روضة الآمال مهزول % 15(@)(@@) % و إن جفاك صديق أو نبا زمن % فحسبك الليلو البزل المراسيل % 16(@)(@@) % و اقصد زبيد سقاها الله من بلد % فربعها بولي الله مأهول % 17(@)(@@) % زر أحمد بن أبي بكر فهمته % في الدين من دونها غفر وإكليل % 18(@)(@@) % واسجد لربك شكرا عند رؤيته % و الثم بنان يد في باعها طول % % 19(@)(@@) % وانزل من الدين والدنيا بنورهما % % فالعسر يسر به والعقد محلول % 20(@)(@@) % واستنجد ابن أبي بكر تجده فتى % % يقضيفيمضي وأمر الله مفعول % PageV01P342 21(@)(@@) % سر السرارة لب اللب من مضر % أغرأنجابهغر بهاليل % 22(@)(@@) % يرتاح للجود إن حف الوفود 
ms109	 به % كأنه بشمولالراح مشمول % 23(@)(@@) % رب العلوماللدنيات ما رسمت % خطاو لا ضمها درس وتحصيل % 24(@)(@@) % له طلائعربانية مزجت % بالنورو العلم معقول ومنقول % 25(@)(@@) % فما صريح ومبني ومطرد % و ما دليل وتعليل وتأصيل % 26(@)(@@) % بحر الحقيقة في ضمن الشريعة عن % بحر معانيه تجميل وتفصيل % 27(@)(@@) % و كم له حجج علمية وبه % يحل رمز وألغاز وتشكيل % 28(@)(@@) % يا من إذا لذت به حاطني وثنى % % ناب النوائب عني وهو مفلول % 29(@)(@@) % و من له عند خلق الله مرتبة % و عند خالقه فضل وتبجيل % 30(@)(@@) % أنت الذي أنت فرد لا نظير له % كالشمس ليس لها بالشهب تمثيل % PageV01P343 31(@)(@@) % يداك بحر كرامات وبحر غنى % % فما الفرات وما سيحون والنيل % 32(@)(@@) % جاوزت غاية أهل الفضل منفردا % بالفضل فاتسعت فيك الاقاويل % 33(@)(@@) % أومسيت في حلل التوحيد مفتخرا % بمن له الفخر بالتعظيم موصول % 34(@)(@@) % سكران من كأس راح روح نسمته % سر العناية والأذهال مذهول % 35(@)(@@) % هل عطفة منك يا مولاي تبلغني % % منك المراد ففيك البر مأمول % 36(@)(@@) % عدني بخير فأهل الخير أنت ولم % يحط بإنجاز وعد منك تطويل % 37(@)(@@) % و قد علمت بأن الدهرذو غير % وللوفاء على الإطلاق تفضيل % 38(@)(@@) % فاشفع لصاحب محوال ورفقته % إن كان يرجى لحال القوم تحويل % 39(@)(@@) % وارحم مساكين في السجن استمر بهم % دهر مضى وغريم الدين ممطول % 40(@)(@@) % كم فيه من شيخ شبه الخلال إذا % % رأيتهم قلت ما هذي التماثيل % PageV01P344 41(@)(@@) % لهم حريم و أرحام و حاشية % و أمهات و آباء مثاكيل % 42(@)(@@) % فاعطف عليهم وراجعما استطعت بهم % فجاه وجهك في الدارين مقبول % 43(@)(@@) % و الأمر أسرع نجحا إن هممت بهم % من لمحة الطرف لولا منك تسهيل % 44(@)(@@) % الخير أنفعه للناس أعجله % لا خير في كل خير فيه تأجيل % 45(@)(@@) % لا زلت للجود يا بدر الوجود أخا % مجد عليه من التقوى سرابيل % 46(@)(@@) % ودمت في النعمة الخضراء ما سجعت % ورق وما تليت حم~ تنزيل % PageV01P345 البحر : - 1(@)(@@) % يا جيرةالحي هذا الأثل والبان % فكيف حالالأحيباب الأولى بانوا % % 2(@)(@@) % و هل مررتم بنعمان الأراك على % % نعم 
ms110	 فأحلى الهوى نعم ونعمان % 3(@)(@@) % عهدي بهم وديار الحي آنسه % بالمنجدين وهم في الحي جيران % 4(@)(@@) % و العيش أخضر والدنيا مساعدة % و قاتل الحب والمقتول إخوان % 5(@)(@@) % و الشيح متشيح بالطل مبتهج % و الورد مبتسم و الزهر ألوان % 6(@)(@@) % و المسك تذريه أرواح النسيم وفي % % خمائل الشعب تغريد وألحان % 7(@)(@@) % و في الخدور بدور في ملاحظها % % سحر وفي حسنها ماء ونيران % 8(@)(@@) % و بنت عشر سقاها الحسنخمر صبا % % فالقلب منها بغير السكر سكران % 9(@)(@@) % نعس مكحلة لعس معسلة % فيهنحسن وما فيهن إحسان % 10(@)(@@) % تريك في الرمل حقف الرمل فوقهما % % ليل وشمس ورمان ومران % PageV01P346 11(@)(@@) % أتلك لؤلؤة غر محاسنها % % أم فضة شانها ورس وعقيان % 12(@)(@@) % أم تلك حورية نورية خلقت % من درة حليها در ومرجان % 13(@)(@@) % فاقت ببهجتها كل الحسان كما % % فاق الكرام عفيف الدين عثمان % 14(@)(@@) % فرد الجلالة خرق لا نظير له % أموالهلصنوف المجد أثمان % 15(@)(@@) % غيث يفيض بمرفض الندى أبدا % كل إلى صوب ذاك الغيث ظمآن % 16(@)(@@) % بحر من الجود ملآن يموج غنى % % فالناس تغرف منه وهو ملآن % 17(@)(@@) % رحب المنازل ما غبت منازله % وفد ووفد وضيفان وضيفان % 18(@)(@@) % أبوه سيد عدنان فبورك من % فرع منيف نماه الأصل عدنان % 19(@)(@@) % و جده الأهدل المشهور سيرته % مبارك كله يمن وإيمان % 20(@)(@@) % لا يغلق الباب عن راجي النوال ولا % % يقابل الوفد إلا وهو جذلان % PageV01P347 21(@)(@@) % إن ابن أحمد شمس في جلالته % و ليس كالشمس بهرام وكيوان % 22(@)(@@) % ر تعناآمالنا في ريف رأفته % فنحن نبت رجاه وهو هنان % 23(@)(@@) % له بفاطمة الزهرا وحيدرة % و أحمد شرف يسمو وبنيان % 24(@)(@@) % قوم حموا عن حواشيهم وطال بهم % فوق الكواكب عمار وسلمان % 25(@)(@@) % فإن طغى الدهر أو نابت نوائبه % فالأهدليون حصن أينما كانوا % % 26(@)(@@) % حالي بهم مستقر بعد نفرته % عني وربعي لخيل الخير ميدان % 27(@)(@@) % يا سيدي ياعفيف لدين جئتك في % % حوائج أغفلت والدهر يقظان % 28(@)(@@) % فرش جناحي ببذل المكرمات وصل % حبلي فإني إلى نعماك غرثان % 29(@)(@@) % إن لم تقم بي وتمدد بالنوال يدي % % فالحظ 
ms111	 منتقص والربح خسران % 30(@)(@@) % فاسمح بعارفة بيضاء تنعشني % % فما يساميك بالإحسان إنسان % PageV01P348 31(@)(@@) % و اكس الأديب من البز النفيس ولا % ترددلبيد القوافي وهو عريان % 32(@)(@@) % بقيت للدين والدنيا وأهلهما % % نورا على كل نور منه عنوان % 33(@)(@@) % ماحن رعد و ما غنت مطوقة % و ما تعانق أغصان وأغصان % PageV01P349 البحر : - 1(@)(@@) % قف بذات الأراك واندب طلولا % % أقفرت عن نوار دهرا طويلا % % 2(@)(@@) % و رسوما بالأبلق الفرد أضحت % لمها الرمل مسمرا ومقيلا % 3(@)(@@) % واسقها من عريض دمع غزير % دائم السكب لا يغب مسيلا % 4(@)(@@) % فلعل الدموع تطفيء نارا % من فؤاد صبا وتشفي غليلا % 5(@)(@@) % إن بين الأراك فالبان فالري % % ان للظاعنين رسما محيلا % % 6(@)(@@) % أنكرت ربعه الرياح جنوبا % و شمالا شامية وقبولا % 7(@)(@@) % و أحالت منه المعالم فالآ % % ثار فالربع فالكثيب المهيلا % % 8(@)(@@) % يا خليلي عساك تعذر ذو الوج % % د كما يعذر الخليل الخليلا % 9(@)(@@) % لا تسلني عن الغوير وأهليه % و سلهم هل خلفوني قتيلا % 10(@)(@@) % فالفريق الذين حلوابنجد % ما يزالون في الفؤاد حلولا % % PageV01P350 11(@)(@@) % ما على الناس من بقية روح % أسكنته الهموم جسما نحيلا % 12(@)(@@) % و فؤاد يرضى بهجر المحبي % % ن ويستعذبالعذاب الوبيلا % % 13(@)(@@) % إن دعج العيون من غير عيب % آلفته الضنا قليلا قليلا % 14(@)(@@) % أيها الراكب المجد ارتحل من % شجر واقطع الفيافي ذميلا % % 15(@)(@@) % واطو أرض الجنوب غورا ونجدا % فرسخا فرسخا وميلا فميلا % 16(@)(@@) % لا تمل بالمطي عن ذروة العز % بعزالمنيعتنعممقيلا % % 17(@)(@@) % في رياض شرفن بالأشرف الفر % % د الذي جاز الأرض عرضا وطولا % 18(@)(@@) % تبعي أتى به اللهللإسلا % % م والمسلمين ظلا ظليلا % 19(@)(@@) % واسأل الحي عن محب صحبنا % % هقديما وكان برا وصولا % 20(@)(@@) % حي عبد الرحمن أعني وجيه الدين % سيف الهدى الجراز الصقيلا % % PageV01P351 21(@)(@@) % أكرمالخلق من بني أكرم الخا % % ق فروعا منيفة وأصولا % % 22(@)(@@) % الإمامالذييدلعلى % % الحقبآثاره ويهديالسبيلا % % 23(@)(@@) % و الجواد الجواد والأمجد % الأمجد والسيد النبيل النبيلا % 24(@)(@@) % الفتى الماهرالمهذب فردا % في بني الدهر إن طلبت مثيلا % 25(@)(@@) % فاقتبس من هداهعلما و حلما % واستنله تلقى فراتا ونيلا % % 26(@)(@@) % و تيممه سائلا تغن 
ms112	 جودا % دونه الزاخر العريض الطويلا % 27(@)(@@) % أيها القادمون من أرض نجد % و هل وجدتم بهم قلبي نزيلا % 28(@)(@@) % إن قوما أحبهم هجروني % % بعد وصل فصار قلبي عليلا % % 29(@)(@@) % يا حبيبي لو ساعدتني الليالي % % بالتلاقي لجئت سعيا عجولا % 30(@)(@@) % غرضي أن أجدد العهد لكن % لم أجد من عثار دهري مقيلا % PageV01P352 31(@)(@@) % إن تكن حلت عن ودادي فقلبي % % لا يرى عن ودادكم أن يحولا % 32(@)(@@) % أو تناسيتنيفلست بناس % أو مللت الهوى فلست ملولا % 33(@)(@@) % طالماهبت الجنوب فأه % % ديت إليكم معها السلام الجزيلا % 34(@)(@@) % شفني الشوق نحوكمواستحالت % أنعم ما رضيتأنتستحيلا % 35(@)(@@) % كيف يا سيدي بلغتقريبا % من بلاديوما استطعت وصولا % 36(@)(@@) % لا تعنف علي بالهجر فالله % تعالى يقول صبرا جميلا % 37(@)(@@) % لي حولان أرتجي بثأشوا % % قي إليكمفما وجدترسولا % % 38(@)(@@) % واختصرت العتاب وهو كثير % خشية إن سرحته أن يطولا % 39(@)(@@) % و تلطفت في السؤال رجائي % % أن ترى للجواب فيه دليلا % 40(@)(@@) % فبحق الذيهداك وأعطا % % كهدى شافيا وقولا ثقيلا % PageV01P353 41(@)(@@) % أذكر الشارفيبالخير مهما % % قمت تدعو البر الرحيم الوكيلا % 42(@)(@@) % و عليكم مني السلام إلى أن % ينفد الدهر بكرة وأصيلا % PageV01P354 البحر : - 1(@)(@@) % خيال سعاد أسعف بالمزار % فزار من الغوير بلا أزورار % 2(@)(@@) % سرى تهديه نسمة ريح نجد % جعلت فداه من سار وساري % % 3(@)(@@) % سرى من أبرق العلمين وهنا % خفي الشخص مأمون الأثار % 4(@)(@@) % ألم بمضجعي فظفرت منه % بما ظفر الفرزدق من نوار % 5(@)(@@) % تنم به رياح المسك عرفا % و شمس الحسن من خلف الخمار % 6(@)(@@) % بنفسي من علقت به غراما % % فبعت القلب منه بلا خيار % 7(@)(@@) % أذوب صبابة وأحن وجدا % إليه بفيض أجفان غزار % 8(@)(@@) % عسى علم عن العلمين أو عن % وسيمات المحاسن من نزار % 9(@)(@@) % فبين البان والأثلات ربع % لظبي الأنس لا ظبي الصحارى % % 10(@)(@@) % تسفهني العواذل فيه جهلا % وما عذري سوى خلع العذار % PageV01P355 11(@)(@@) % أخي سر منهجي واصبر كصبري % % لشرب الملح أو رعي المزار % 12(@)(@@) % فإني قد مشيت بكل فج % وقاسيت الملمات الطواري % % 13(@)(@@) % و ذقت مرارة التجريب حتى % % تبينت النحاسمن النضار % 14(@)(@@) % فخل معاشرات 
ms113	 الناستسلم % و عاملهمبحلم واصطبار % 15(@)(@@) % و إن ضاق الخناق عليك فانزل % بسيدنا ابن سيدنا النهاري % % 16(@)(@@) % كريم تعلق الآمال منه % بعز الجار محمود الجوار % 17(@)(@@) % إمام قائم بالحق ساع % بنصح الخلق بحر الإعتبار % 18(@)(@@) % عماد المتقين ومنتقاهم % وقطب الدين مرتفع الفخار % 19(@)(@@) % هو العلم المليء بكل علم % هو البحر المحيط على البحار % 20(@)(@@) % هو النجم المضيء لكلسار % هو القمر المنزه عن سرار % PageV01P356 21(@)(@@) % ملاذ مؤمل وغياث راج % و غاية مطلب وغنى افتقار % 22(@)(@@) % و سيف في يمين اللهيقفو % % بهمته طريقة ذي الفقار % 23(@)(@@) % ربت في ريف رأفته البرايا % % و طير الجو بل وحش القفار % 24(@)(@@) % نما من دوحة فيها تسامت % فروع الدين ثابتة النجار % 25(@)(@@) % وجيه الوجه ذو كرم عريض % وذو صفح تراه على اقتدار % 26(@)(@@) % و شمس علاه ليس لها أفول % وزند نداه في الأزمان وارى % % 27(@)(@@) % يلوذ بجاهه من خاف ظلما % فيلقاهقريب الإنتصار % 28(@)(@@) % غمام المكرمات لكل راج % و ثهلان السكينة والوقار % 29(@)(@@) % وأسرع من يجاب له دعاء % إذا رمق السماء بلا افتخار % 30(@)(@@) % يرى بطلائع الأنوار مال % تراه العين سرا كالجهار % PageV01P357 31(@)(@@) % و كل الكون دون حياط قاف % بمرأى منه متضح المنار % 32(@)(@@) % لقد شرف الوجود بنور أحيا % % موات الدين مشتهر العشار % 33(@)(@@) % قصير الوعد وافى العهد حاوى % % مقاليد الهدى عف الإزار % 34(@)(@@) % لدني العلوميجيب عنه % لسان حقيقةالحبر الحواري % % 35(@)(@@) % أجبني يا فتى عمر بن موسى % % أقلني يا محمد من عثاري % % 36(@)(@@) % فكم لك من يد ورهين جود % و مولى نعمة وعتيق نار % 37(@)(@@) % سمى أبيك جارك فيكما لي % % ظنون حماية وجوار جار % 38(@)(@@) % فقوما بي وقولا أنت منا % % إذا النيران طائرة الشرار % 39(@)(@@) % فكم أنقذتمابهداكمامن % شفا جرف من النيران هار % 40(@)(@@) % و إن مكرت بي الأعداء ظلما % فكونا نصرتيوخذا بثاري % % PageV01P358 41(@)(@@) % و إن خفت الذنوب فبشراني % % بعقبى الدار في دار القرار % 42(@)(@@) % و ها هي من لسان مهاجري % أجاذبها على بعد الديار % 43(@)(@@) % ليلقى راحة الدارين فيها % % و يعطى الأمن في أهل ودار % 44(@)(@@) % و جاد 
ms114	 ثراكما في كل حين % غزيرات الغوادي والسواري % % 45(@)(@@) % و باتت كل وارفة وظلت % على الحرم المعظمفي قعاري % % PageV01P359 البحر : - 1(@)(@@) % ألف التذكر مبدئا ومعيدا % أملا لبعد الظاعنين بعيدا % 2(@)(@@) % دنف يبيت يحن في آثارهم % ويظل يندب دمنة وصعيدا % 3(@)(@@) % ذكر الفريق المنجدين فبات من % ذكر الفريق المنجدين عميدا % % 4(@)(@@) % رحلوا عشية فارقوهبعقله % و قضوا عليه بأن يموت شهيدا % % 5(@)(@@) % يسقى الغرام بعبرة مسفوحة % جعلت محاجر خده أخدودا % % 6(@)(@@) % لو حملت هوج المطي غرامة % ما جاوزت وادي الأراك وجودا % % 7(@)(@@) % يا صائد الظبيات باعك قاصر % كم رام غيرك أن يصيد فصيدا % % 8(@)(@@) % تمسي سمير النجم وحدك ساهرا % والركب دونك في الرحال هجودا % % 9(@)(@@) % و تظل تنشدهم فؤادا لم يكن % مع غير غزلان الحمى منشودا % % 10(@)(@@) % فتعال نسمعك السجوع برامة % سحرا ونذكرك النقا وزرودا % % PageV01P360 11(@)(@@) % و اسنح نقص عليك من أنبائها % % ما كان منها قائما وحصيدا % % 12(@)(@@) % يا ليت شعري هل لعيش بالحمى % % زمن تألف شمله فيعودا % % 13(@)(@@) % وطن عهدت به حبيبا زائرا % و هوى يطيب ومعهدا معهودا % % 14(@)(@@) % و زمان أنس بالوصال وجيرة % كانوا فبانوا منزلا و صدودا % % 15(@)(@@) % نزلوازبيد فليت كل غمامة % تسقى منازل نازلين زبيدا % % 16(@)(@@) % أرض غدا روض المروءة ناضرا % فيها وطلع المكرمات نضيدا % % 17(@)(@@) % و بلاد اشتملت جوانبهاعلى % % أمل العناة صوادرا وورودا % % 18(@)(@@) % قمر الفتوة عصمة العرب الذي % % لولاه لم يكنالجداموجودا % % 19(@)(@@) % إن ابن إسماعيل أحمدلم يزل % في سلك أرباب الوفامعدودا % % 20(@)(@@) % زرهتجده العالمين وداره ال % % دنياو سائر من لقيت وفودا % % PageV01P361 21(@)(@@) % متفيئين ظلال كل كرامة % في ريف رأفة من سمافيسودا % % 22(@)(@@) % أعلى الورى شرفا و أطولهم يدا % % و أمدهم ظلا و أصلب عودا % % 23(@)(@@) % ما زال في شرف الولاية جوهرا % يسموبه شرف الوجودوجودا % % 24(@)(@@) % يا ظاميء الآمال في طلب الغنى % % قف حيث تلقى الطالع المسعودا % % 25(@)(@@) % وانزلعلى الكرم العريضفربما % % أغنتك دجلة عن ثماد ثمودا % % 26(@)(@@) % بموطإ الأكناف تمطر كفه % للسائلين ملابسا و نقودا % % 27(@)(@@) % خلق أرقمن النسيم ونفحة % تغنى العديم وتنجد المجهودا % % 28(@)(@@) % و سريرة مرضية و 
ms115	 عزيمة % علوية سمت السماء صعودا % % 29(@)(@@) % الله أكبر ذاالذي من أمه % لنداه ولي الفقرعنه شريدا % % 30(@)(@@) % ذا البحرعلما ذا النجوم طلائعا % ذا الصخر حلما ذا الغمامة جودا % % PageV01P362 31(@)(@@) % ذا العالم السني ذا العلم الذي % % بالعلمو الحلماستقام رشيدا % % 32(@)(@@) % قسطاس قسط حقيقة و شريعة % قبس الرضا قبس الهدى توحيدا % % 33(@)(@@) % كنز المعارف منبع الحكم الذي % % آراؤه شهب يقدن وقودا % % 34(@)(@@) % حبر المناظرة المحيط فراسة % بالعلم علما منهلا تقليدا % % 35(@)(@@) % في سيره سير وفي تبريزه % إبريزمكرمة يلوح فريدا % % 36(@)(@@) % عشق المعاني الغر وهو مراهق % فاقتض أبكار الفنون وليدا % % 37(@)(@@) % مولاي جئتك والخطوب وجوهها % % سود و لولا الفقر لم تك سودا % % 38(@)(@@) % وافيت من أرض المذاب ولم أزل % في الأرض نحو زبيد أطوى البيدا % % 39(@)(@@) % أنا من علمت رهين فضل فائض % و حليف ود يبتغى تجديدا % % 40(@)(@@) % أنهى إليك صروف دهر خانني % % وموددا بالصدق عاد حسودا % % PageV01P363 41(@)(@@) % و خصاصة تفنى النفوس لها وإن % تكن النفوس حجارة وحديدا % % 42(@)(@@) % فانظر إلي بعين عطفكربما % % ألفى بك الحظ الشقي سعيدا % % 43(@)(@@) % فلأنت بعد أبي أب أحببتني % % في الله حب الوالد المولودا % % 44(@)(@@) % و قرنتني بعلا علاكو رشتني % % من فيض فضلك طارفا وتليدا % % 45(@)(@@) % فاسلم ودم في أرفع الدرجات يا % % ركنا لمن يأوى إليه شديدا % % PageV01P364 البحر : - 1(@)(@@) % أعد الوداع فما أراك تراني % % و أطل بكاك لبين أهل البان % 2(@)(@@) % فغدا يفارقك الفريق فتنثني % % متحسرا لتفرق الخلان % 3(@)(@@) % و أراك تنكر حب زينب بعدما % % شهدت عليك مدامع الأجفان % 4(@)(@@) % و لم اختدعت فبعت قلبك يوم ذي % % سلم بلا ثمن فهل لك ثاني % % 5(@)(@@) % لولا النسيم الحاجري وروحه % ما بت تندب روضة الريحان % 6(@)(@@) % و بأبرق الحنان منزل زينب % أفلا تحن لأبرق الحنان % 7(@)(@@) % نزلوا على الريان من سفح اللوا % % فإذا بنا ظمأ إلى الريان % 8(@)(@@) % و ها لهم من جيرة ما طاب لي % % زمن الصباإلا وهم جيراني % % 9(@)(@@) % و أنا الفداء لهاجر متعتب % نسخ الوصال بمحكم الهجران % 10(@)(@@) % أكرمته فأهانني وحفظته % فأضاعني وأطعته فعاصني % % PageV01P365 11(@)(@@) % ليت الذي كتب 
ms116	 الفراق يعيد لي % % زمني وجيراني بشعب زماني % % 12(@)(@@) % و يهب روح الأنس من قبل الحمى % % و أرى خييمات الحمى وتراني % % 13(@)(@@) % و إلى الجناب الأهدلي رمت بنا % % نجب خلطن السهلبالأحزان % 14(@)(@@) % و نزلن من كنفي سهام بساحة ال % % قمر المنير سنا سما الإيمان % 15(@)(@@) % سيف الهداية أحمدبنمحمد % علمالعنايةقارئالقرآن % 16(@)(@@) % هو في المراوعة الخصيبةآية % بشرية شهدتبه الثقلان % 17(@)(@@) % و دلائل الخيرات فيه فإنه % كالشمسلا تخفى بكلمكان % 18(@)(@@) % لا تقصدن سواهفهوخليفة الرحم % % ن وابن خلائف الرحمن % 19(@)(@@) % وانزل عليه فما نزلت بسوحه % إلا نزلت على أبي الضيفان % % 20(@)(@@) % أبا محمد أنت غايةمطلبي % % في النائباتو صارمي وسناني % % PageV01P366 21(@)(@@) % و بنورو جهك رفعتي وكرامتي % % و أمانخوفي بعد خوف أمان % 22(@)(@@) % صورت من حسب ومن نسب ومن % أدب و منيمن و من إيمان % 23(@)(@@) % خلقت من شرف ومن كرم ومن % ملك ومن قمر ومن إنسان % 24(@)(@@) % مزجت طباعك بالسماحة والوفا % % فحوتجميعالحسن والإحسان % 25(@)(@@) % شرف أنافإلى مناف وانتهى % % كرما فما داناه بعدمدان % 26(@)(@@) % مندوحة نبوية علوية % في أصلها الزهراء والحسنان % 27(@)(@@) % و الأهدليون الكرام فروعها % % و ثمار ذاك المنصب الصنوان % 28(@)(@@) % لولا على الأهدليالسامي الذرى % % ما افتر نور جواهر الأكوان % 29(@)(@@) % منأينيدركمدحههيهاتلا % % و اللهما قاص إليهو دانى % % 30(@)(@@) % و هوالمصفى من ذؤابةهاشم % فردالزمانو فرد كلزمان % PageV01P367 31(@)(@@) % و أبوهحيدرة و أحمدجده % و أخوهعبدالقادرالجيلاني % % 32(@)(@@) % أضحى مرارا في سهام بتربة % مزجتبسرالبيتذي الأركان % 33(@)(@@) % شهدت مشاهدهاو أشرقنورها % % و علتمراتبهاعلى كيوان % 34(@)(@@) % فيهالإمامابنالأئمةإنه % في الناس مثلالزهرفي البستان % 35(@)(@@) % سلف أبو خلف غدتآئارهم % في الجودمثلشرائعالاعيان % 36(@)(@@) % ملأ بنوملإ بحورنوافل % و بدور أندية و حلومجان % 37(@)(@@) % ماذاتعامليا شهابالدينمن % بالرغمباع الربح بالخسران % 38(@)(@@) % فقر وإفلاس ودهر خائن % و همومعائلة و ضيقمكان % 39(@)(@@) % و عظيمدين لا يقومبحمله % رضوى و لا الصخراتمنثهلان % 40(@)(@@) % و حواسد وصوامت قد قطعوا % % نسبي وباعوني بسوق هوان % % PageV01P368 41(@)(@@) % هل منك لي يا ابن الأهيدل عطفة % تغنى بها فقري وتصلحشاني % % 42(@)(@@) % و تقيلني من عثرتي وتريحني % % بالجود من همي ومن أحزاني % % 43(@)(@@) % فو حق من تعنو الوجوه لوجهه % ذي العزة الباقي 
ms117	 وكل فاني % % 44(@)(@@) % مالي إلى أحد سواك علاقة % ترجى ولا سبب يقودعناني % % 45(@)(@@) % و سمعتمنأمالعيالتوعدا % و تهددا ما كان في حسباني % % 46(@)(@@) % رجب و شعبان قطعتمداهما % % صبرا وعزالصبرفي رمضان % 47(@)(@@) % فبحقحقك برني وأمدني % % بعورف و عواطف و حنان % 48(@)(@@) % فلقدقصدتكمادحا لكلائدا % بكمستجيرا منعنادزماني % % 49(@)(@@) % فقنيبجاهك من همومالفقر في % % الدنيا وفي الآخرى من النيران % % 50(@)(@@) % و بقيت يا قمر الكمال مكرما % و منعما بالروح والريحان % PageV01P369 51(@)(@@) % ماهب نجدى النسيمو ماشدت % و رقاء ساجعة على الأغصان % 52(@)(@@) % و تقوليا سبوحيا قدوسيا % % رباهيا غوثاه يا منان % PageV01P370 البحر : - 1(@)(@@) % ماطروجد الهوى العذري لو هانا % % عن قلب صب أطاع اللهو ولهانا % % 2(@)(@@) % ما تأتلي نسمات الغور تنشقه % مسكا فيمسى إلى الحنان حنانا % % 3(@)(@@) % يسقي خمائل نجد من مدامعه % إن لم يجدها عريض المزن هتانا % % 4(@)(@@) % باللهباللهيا ذاك النسيم أعد % علما عن العلم العربي أحيانا % 5(@)(@@) % هلباكرته الغوادي وهي مثقلة % بالري تسقى الأراك الغض والبانا % % 6(@)(@@) % و هل بنجد وسفح البان من إضم % % ما يذهب القلب عن نعم ونعمانا % % 7(@)(@@) % كم غلطة من نوار بالحمى بدرت % لنا وعين الهوى العذرى ترعانا % % 8(@)(@@) % زاغت بنا فرصة بالليل ممكنة % فأيقظتنا وبات الليل وسنانا % % 9(@)(@@) % و افت وبت وإياها تعللني % % منراح لهو الهوى سكرى وسكرانا % % 10(@)(@@) % لما تشعشعأفق المشرقين على % % رغمى وكاديبين الفجر أو بانا % % PageV01P371 11(@)(@@) % و فا رقتني وفارقتالسلوفهل % بعدالتفرقنلقاها وتلقانا % % 12(@)(@@) % لاشئ أصعب من هجر تقدمه % و صل فليتالهوى العذرى ما كانا % % 13(@)(@@) % يا ظامئالقصددع ورد الثما ورد % بحر الشهاب بن فخر الدين معدانا % % 14(@)(@@) % زر أحمد بن أبي بكر وأيفتى % % إذا دعوناهللمعروفلبانا % % 15(@)(@@) % زر بحر علم غدا كلالعلومبه % و طود حلم يحاكى طودثهلانا % % 16(@)(@@) % تلقاهإنفاض جودا حاتما كرما % حمى وإن قالأما بعد سحبانا % % 17(@)(@@) % ذاكالمعدلحمل المشكلات حوى % % علم المذاهب تبريزا وإتقانا % 18(@)(@@) % العالم العامل الفرد الذي امتلأت % من صيتهالأرضأجبالا وأحزانا % 19(@)(@@) % كنز المعارف عدلالدين لا برحت % آثارهللهدى نورا وبرهانا % % 20(@)(@@) % أمينمكنون أسرار الملوك إذا % % ما أودعالسرأفشى السر كتمانا % % PageV01P372 21(@)(@@) % مهذبالعرض فردالجود إن وكفت % كفاه أنساك سيحانا 
ms118	 وجيحانا % % 22(@)(@@) % لا تطلبن به في عصره بدلا % أتبدل الشمس بهراما و كيوانا % % 23(@)(@@) % ياأيها الوالدالبر الشفيق أجب % عن كل من زاده التذكير نسيانا % % 24(@)(@@) % تاجرت بالشعر أبغي الربحفانعك % % ست حالي على فعادالربح خسرانا % % 25(@)(@@) % و خاننيمن أصيحابيو غيرهم % من لم يكن قبل صفر الكف خوانا % % 26(@)(@@) % قالوا أتشكو من الإخوان قلت وما % % أفادكون بني يعقوب إخوانا % % 27(@)(@@) % ألقوا أخاهم على قرب الرحامة في % % غيابة الجب باكي العين حيرانا % % 28(@)(@@) % و بعد باعوه عبدا آبقا ورموا % % به على غير جرم ذئب كنعانا % % 29(@)(@@) % و كم رجال كثيبر كنتآملهم % و لم يزل لابس الآمال عريانا % % 30(@)(@@) % لا يورقالعود من رعد بلا مطر % إذا يروى سراب القاع ظمآنا % % PageV01P373 31(@)(@@) % و أنت مالي ومأمولي ومعتمدي % % مازال حوضك لي بالجود ملآنا % % 32(@)(@@) % حاشا جلالك بل حاشا نوالكأن % أكون في بحرك الفياض عطشانا % % 33(@)(@@) % دع المقادير تطويني واتنشرني % % حتى تبلغني معروفك الآنا % % 34(@)(@@) % فما نزلت على مولى سواك ولا % أرجو وراءك بعد الله إنسانا % % 35(@)(@@) % يامنصب الحسن والإحسان خذ بيدي % % فداك من لم يكن حسنا واحسانا % % 36(@)(@@) % وجد علي ببذل المكرمات وصل % حبلى فلست ببذل الجود منانا % % 37(@)(@@) % وانظر إلى بعين منك مشفقة % وانعش بعزمك لي أهلا وجيرانا % % 38(@)(@@) % ودممنيع الحمى من كل نائبة % في رتبة ملئت يمنا وإيمانا % % PageV01P374 البحر : - 1(@)(@@) % إلى صارم الدين الفتى بن محمد % رمت بي مقادير جرتو خطوب % 2(@)(@@) % و حطت بي الآمال في خير منزل % لدى خير من يأوى إليه أديب % 3(@)(@@) % فوافيت أعلى الناس نفسا ومنصبا % و أخصب ربعا والزمان جديب % 4(@)(@@) % فتى سر توحيد الإله وسيفه % به العيش يحلو والزمان يطيب % 5(@)(@@) % هو الكوثر الفياض في آل فارح % أغر ينادي للندى فيجيب % 6(@)(@@) % غمام يعم الخلق ظلا ونائلا % لكل من الراجين فيه نصيب % 7(@)(@@) % عليك سلام الله جئتكزائرا % و شاني وقيت الشانئين عجيب % 8(@)(@@) % أؤمل منك البر والبر واسع % و أرجو نداك الجم وهو قريب % 9(@)(@@) % فقم بي وعاملني بما أنت أهله % فإن رجائي فيك ليس يخيب % 10 
ms119	(@)(@@) % و صن ماء وجهي عن زمان معاند % وصل حبل أنسي والغريب غريب % PageV01P375 11(@)(@@) % و دمت منار الدين ما لاح بارق % و ما اهتتز غصن في الأراك رطيب % 12(@)(@@) % و لا زلت مأمولي وغوثي ونصرتي % % على نائبات الدهر حين تنوب % PageV01P376 البحر : - 1(@)(@@) % لأعين العين فعل البيضوالأسل % لولا امتزاج الثغور اللعس بالعسل % 2(@)(@@) % ترمي حواجبها قلب المشوق بها % % فتسلب اللب بالتدعيج والكحل % 3(@)(@@) % نزلن بالحب حبات القلوب فما % % رحلن إلا بوجد غير مرتحل % 4(@)(@@) % رفقا بذي شجن ذاق الهوى فرمت % به الصبابة بين العذر والعذل % 5(@)(@@) % يبكي بنار بأكناف الحمى وقدت % و لمع برق بذات البان مشتعل % 6(@)(@@) % و يندب الطلل المهجور من أضم % فدمعه طلل في ذلك الطلل % 7(@)(@@) % و كلما اشتغلت بالسجع ساجعة % في الغور أغرته بالتسجيع والغزل % 8(@)(@@) % ما ضر أيام نجد أن تعود لنا % % بجمع شمل على اللذات مشتمل % 9(@)(@@) % أيام أنسى برضوانية رضعت % در الصبا في رياض الدل والكسل % 10(@)(@@) % شمس مقلدة شهب النجوم فما % % شهب النجوم وشمس بلا طفل % PageV01P377 11(@)(@@) % بيضاء حورية نورية جمعت % محاسن الحسن بين الحلي والحلل % 12(@)(@@) % سحارة الطرف إن لاحت ملامحها % % يوما لذي العقل أمسى مطلق العقل % 13(@)(@@) % تهتز عطفا كخوط البان مال به % مر النسيم وخلى الغصن ذا ميل % 14(@)(@@) % كم لامني في هواها اللائمون وقد % رضيتها حكما عدلا علي ولي % % 15(@)(@@) % و إن نأت دارها عني شددت عرا % ظني بيمنى ولي الله خير ولي % % 16(@)(@@) % محمد بن علي خير من نزلت % به الوفود لنيل الجود بعد علي % % 17(@)(@@) % الصالح البدل ابن الصالح البدل % ابن الصالح البدل ابن الصالح البدل % 18(@)(@@) % اليغنمي الذي تاه الوجود به % على أواخر أهل الخير والأول % 19(@)(@@) % سر السرارة لب اللب منتخب % يرتاح للجود شبه الشارب الثمل % 20(@)(@@) % ماتنكر الكوثر الفياض إن وكفت % كفاه في المحل ضل العارض الهطل % PageV01P378 21(@)(@@) % أفعاله سير في المجد أيسرها % % محيي المحامد بين السهل والجبل % 22(@)(@@) % بحر يمدعلى العافي عوارفه % بالأنعمالخضرلا بالعل والنهل % 23(@)(@@) % بنى بحطم حطام المال مرتبة % من دونها 
ms120	 زحل كالأرض من زحل % 24(@)(@@) % يا رائد البر عجنحو المذاب ففي % % ذاك الجناب ولي بالنوالملي % % 25(@)(@@) % و زر قبور أولاك الصالحين فهم % لله في الأرض أبدال من الرسل % 26(@)(@@) % و في زيارتهم نجح المطالب من % محو الذنوب وستر الحوب والزلل % 27(@)(@@) % إنم اليغانم سر الله في برع % شهب الهدى والندى والعلم والعمل % 28(@)(@@) % غمائم الجود أقمار الوجود لهم % خصائص الذكر ما الذكر الحكيم تلى % % 29(@)(@@) % و إنهم وسط في أمة وسط % بالخير خاطبها التنزيل في الأزل % 30(@)(@@) % جنابهم هو حبل الله المنيف سمت % في العز قلته العليا على القلل % PageV01P379 31(@)(@@) % يا سيدي يا جمال الدين يا عضدي % % يا ناصري في حدوث الحادث الجلل % 32(@)(@@) % يا واحدا هو كل الناس لاعجب % أن يجعل الله كل الناس في رجل % 33(@)(@@) % يكفيك في سبق أهل السبقأنهم % جادوا وجدتفكنت الفرد في المثل % 34(@)(@@) % و الناسفي السعي كاسم الماء مشترك % و إنما الفرق بين اللج والوشل % 35(@)(@@) % أضحت يمينك للراجين روض غنى % حلو الجنى كرما يا واهب الجمل % 36(@)(@@) % تمد للخير باعا ما به قصر % يفيض فضلا على حاف ومنتعل % 37(@)(@@) % مولاي صل سببي وامدد يدي عجلا % بحق من خلق الإنسان من عجل % 38(@)(@@) % و انظر إلي بعين منك مشفقة % لتستفيد مزيد الشكر من قلبي % % 39(@)(@@) % من كان يأمل مصرا والخصيب ندا % % فذا خصيبيوذا مصري وذا أملي % % 40(@)(@@) % بقيت للدين والدنياو أهلهما % % ركن الكرامة في الإصباحوالأصل % PageV01P380 41(@)(@@) % ما استقبلت وجهك الزوار واستبقت % غبار نعلك يا مولاي بالقبل % PageV01P381 البحر : - 1(@)(@@) % محدثي عن فريق فارقوا العلما % % و أودعوني في توديعهم ألما % % 2(@)(@@) % وزودوا القلب هما لا انقطاع له % و بدلوا جثتي بالصحة السقما % % 3(@)(@@) % هلا وقد عسفت هوج المطي بهم % سمعتهم يذكرون العهد والزمما % % 4(@)(@@) % باتوا وفي القلب منهم نية عرضت % باتت تقسمه بالبين فانقسما % % 5(@)(@@) % ماضر سكان نجد قبل ما رحلوا % % أن لا يكون زمان الوصل مغتنما % % 6(@)(@@) % كنا وكانوا وكان الشمل مجتمعا % و الوصل متصلا والصرم منصرما % % 7(@)(@@) % فصرت من بين أهل البان ذا شجن 