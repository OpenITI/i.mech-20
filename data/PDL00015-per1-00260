ms244	 مسعود تو %~% مقتدای فتوی صاحبقرانی آمدست(@)(@@) 26 آنکه پیر صفه هفتم سبکدل شد ز رشک %~% از وقار تو بر او چندان گرانی آمدست(@)(@@) 27 کارداران سرای هشتمین را بر فلک %~% رای عالیقدر تو در میزبانی آمدست(@)(@@) 28 از ضمیرت دیده‌ام آن کنگر طاقی که هم %~% آفرینش را مکان بی‌مکانی آمدست(@)(@@) 29 از در دولت سبک بر بام هفتم رو که چرخ %~% با چنین نه پایه بهر نردبانی آمدست(@)(@@) 30 خسروا طبعم به اقبال جمالت زنده گشت %~% آبرا آری حیات اندر روانی آمدست(@)(@@) 31 تا به حرف مدح تو خوانم ثنای دیگران %~% موجب این بیتهای امتحانی آمدست(@)(@@) 32 اینک از اقبال تو پردخته شد آن خدمتی %~% کاندکش الفاظ و بسیارش معانی آمدست(@)(@@) 33 در او در آب قدرت آشناور آنچنانک %~% راست گویی گوهر تیغ یمانی آمدست(@)(@@) 34 بر سر خوان عمادی من گشادم این فقع %~% گر چه شیرین نیست باری ناردانی آمدست(@)(@@) 35 شاخ بادا از نهال عمر تو زیرا که خود %~% بیخش از بستان سرای جاودانی آمدست PageV1P0463(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آن طبع را که علم و سخاوت شعار نیست %~% از عالمیش فخر و ز زفتیش عار نیست(@)(@@) 2 جز چشم زخم امت و تعویذ بخل نیست %~% جز رد چرخ و آب کش روزگار نیست(@)(@@) 3 آن دست و آن زبان که درو نیست نفع خلق %~% جز چون زبان سوسن و دست چنار نیست(@)(@@) 4 باشد چو ابر بی‌مطر و بحر بی‌گهر %~% آن را که با جمال نکو خوی یار نیست(@)(@@) 5 در پیش جوهری چو سفالست آن صدف %~% کاندر میان او گهری شاهوار نیست(@)(@@) 6 منت خدای را که مر این هر دو وصف را %~% جر در مزاج پیشرو دین قرار نیست(@)(@@) 7 قاضی‌القضاة غزنین عبدالودود آنک %~% مر علم وجود را جز ازو پیشکار نیست(@)(@@) 8 چرخست علم او که مر او را فساد نیست %~% بحرست جود او که مر او را کنار نیست(@)(@@) 9 در بر و بحر نیست 
ms245	 یکی صنعت از سخا %~% کاندر بنان و طبعش از آن صدهزار نیست(@)(@@) 10 با سیرتش در آتش و آب و هوا و خاک %~% قدر بلند و صفوت و لطف و وقار نیست(@)(@@) 11 ای قدر تو رسیده بدان پرده کز علو %~% زان پرده ز استر اثر صنع بار نیست(@)(@@) 12 آن چیست کز یقین تو آنرا مزاج نیست %~% و آن کیست کز یمین تو آنرا یسار نیست(@)(@@) 13 دین از تو و زبانت چرا می‌شود قوی %~% گر تو علی نه‌ای و زبان ذوالفقار نیست(@)(@@) 14 در هفت بخش عالم یک مبتدع نماند %~% کز ذوالفقار حجت تو دلفگار نیست(@)(@@) 15 جز در چمن ولی تو چون گل پیاده کیست %~% جز بر اجل حسود تو چون جان سوار نیست(@)(@@) 16 نزدیک علم و رای تو مه نورمند نیست %~% در پیش حلم و سنگ تو که بردبار نیست(@)(@@) 17 آن کیست کو ندارد با تو چو تیر دل %~% کو از سنان سنت تو سوگوار نیست(@)(@@) 18 یک تن نماند در چمن جود تو که او %~% چون فاخته ز منت تو طوقدار نیست(@)(@@) 19 ای شمس طبع کز تو جهان را گزیر نیست %~% ای ابر دست کز تو زمین را غبار نیست(@)(@@) 20 امیدوار باز سوی صدرت آمدم %~% از ابر و شمس کیست که امیدوار نیست(@)(@@) 21 جز شاعران کوته‌بین را درین دیار %~% بر بارگاه جود کریمیت بار نیست(@)(@@) 22 آری ز نوش آتش و از لطف آب پاک %~% رفعت بجز نصیب دخان و بخار نیست(@)(@@) 23 لیکن زمانه ای تو و بر من ز بخت بد %~% هر چه از زمانه آید حقا که عار نیست(@)(@@) 24 والله که از لباس جز از روی عاریت %~% بر فرق من عمامه و بر پا آزار نیست(@)(@@) 25 کارم بساز از کرم امروز ای کریم %~% هر چند کارساز بجز کردگار نیست(@)(@@) 26 گر چه دهی وگر ندهی صله در دو حال %~% جز گوهر ثنای من اینجا نثار 
ms246	 نیست(@)(@@) 27 باشد کریمی ار بدهی ورنه رای تست %~% مر بنده را به هیچ صفت اختیار نیست(@)(@@) 28 دانی که از زمانه جز احسان و نام نیک %~% حقا که هر چه هست بجز مستعار نیست(@)(@@) 29 نام نکو بمان چو کریمان ز دستگاه %~% چون شد یقین که عمر دول پایدار نیست(@)(@@) 30 تا دوزخ و بهشت کم از هفت و هشت نیست %~% تا حس و طبع بیش ز پنج و چهار نیست(@)(@@) 31 چندانت قدر باد که آن را کرانه نیست %~% چندانت عمر باد که آن را شمار نیست PageV1P0464(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عقل را تدبیر باید عشق را تدبیر نیست %~% عاشقان را عقل تر دامن گریبان‌گیر نیست(@)(@@) 2 عشق بر تدبیر خندد زان که در صحرای عقل %~% هر چه تدبیرست جز بازیچه تقدیر نیست(@)(@@) 3 عشق عیارست و بر تزویر تقدیرش چکار %~% عقل با حفظ‌ست کو را کار جز تدبیر نیست(@)(@@) 4 علم خورد و خواب در بازار عقلست و حواس %~% در جهان عاشقی هم خواب و هم تعبیر نیست(@)(@@) 5 تیر چرخ از عقل دزدان دان جان را لاجرم %~% هیچ زندانی کمان چرخ را چون تیر نیست(@)(@@) 6 کار عقلست ای سنایی شیر دادن طفل را %~% خون خورد چون شیر عشق اینجا حدیث شیر نیست(@)(@@) 7 میوه خوردن عید طفلانست و اندر عید عشق %~% بند و زنجیرست اینجا رسم گوز انجیر نیست(@)(@@) 8 هر زمان بر دیده تیری چشم دار ار عاشقی %~% زان که غمزه یار یک دم بی‌گشاد تیر نیست(@)(@@) 9 مرد عشق ار صد هزاران دل دهد یک دم به دوست %~% حال اندر دستش از تقصیر جز تشویر نیست(@)(@@) 10 مانده اندر پرده‌های تر و ناخوش چون پیاز %~% هر که او گرم مجرد در رهش چون سیر نیست(@)(@@) 11 در گذر چون گرم تازان از رخ و زلفین دوست %~% گر چه بی این هر دو جانها را شب و شبگیر نیست(@)(@@) 12 تا نمانی بسته زنجیر زلف 
ms247	 یار از آنک %~% اندرین ره شرط این شوریدگان زنجیر نیست(@)(@@) 13 عاشقی با خواجگی خصمست زان در کوی عشق %~% هر کجا چشم افگنی تیرست یکسر میر نیست(@)(@@) 14 عین و شین و قاف را آنجا که درس عاشقیست %~% جز که عین و شین و قاف آنجا دگر تفسیر نیست(@)(@@) 15 پیر داند قبض و بسط عاشقان لیکن چه سود %~% تربت ما موضع بیلست جای پیر نیست(@)(@@) 16 عشق چون خصم جهان تیرگی و خیرگیست %~% اینهمه عشق سنایی عشق را بر خیر نیست(@)(@@) 17 عشق را این حل و عقد از چیست ما ناذات او %~% جز ز صنع شاه عالم‌دار عالم‌گیر نیست(@)(@@) 18 شاه ما بهرامشاه آن شاه کز بهر شرف %~% چرخ را در بندگی درگاه او تقصیر نیست PageV1P0465(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 کفر و ایمان دو طریقیست که آن پنهان نیست %~% فرق این هر دو بنزدیک خرد آسان نیست(@)(@@) 2 کفر نزدیک خرد نیست چو ایمان که بوصف %~% اهرمن را صفت برتری یزدان نیست(@)(@@) 3 گهر ایمان جسته‌ست ز ارکان سپهر %~% در دوکونش به مثل جز دل پاکان کان نیست(@)(@@) 4 که صفت کردن ایمان به گهر سخت خطاست %~% زان که ز ارکان صفا قوت او یکسان نیست(@)(@@) 5 تو اگر ز ارکان دانی صفت نور و ضیا %~% نزد من این دو صفت جز اثر ایمان نیست(@)(@@) 6 نور اصلی چو فروغی دهد از دست فروع %~% فرع را اصل چو پیدا شد هیچ امکان نیست(@)(@@) 7 کار نه بطن حدث دارد و دارد حق محض %~% رسم و اطلال و دمن چون طلل ایوان نیست(@)(@@) 8 رایگان این خبر ای دوست به هر کس ندهند %~% مشک گر چند کسادست چنین ارزان نیست(@)(@@) 9 ای پسر پای درین بهر مزن زان که ترا %~% معبر و پایگه قلزم بی‌پایان نیست(@)(@@) 10 کاین طریقست که در وی چو شوی توشه ترا %~% جز فنا بودن اگر بوذری و سلمان نیست(@)(@@) 11 این عروسیست که از حسن 
ms248	 رخش با تن تو %~% گر حسینی همه جز خنجر و جز پیکان نیست(@)(@@) 12 درد این باد هوا در تن هرکس که شود %~% هست دردی که بجز سوختنش درمان نیست(@)(@@) 13 جسم و جانرا به عرضگاه نهادم که مرا %~% مایه عرض درین جز غرض جانان نیست(@)(@@) 14 گر حجاب رهت از جسم و ز جان خواهد بود %~% رو که جانان ترا میل به جسم و جان نیست(@)(@@) 15 جسم و جان بابت این لعبت سیمین تن نیست %~% تحفه بی‌خطر اندر خور این سلطان نیست(@)(@@) 16 فرد شو زین همه تا مرد عرضگاه شوی %~% کاندرین کوی بجز رهگذر مردان نیست(@)(@@) 17 چند گوئی که مرا حجت و برهان باید %~% هر چه حق باشد بی حجت و بی برهان نیست(@)(@@) 18 کشته حق شو تا زنده بمانی ور نه %~% با چنین بندگیت جای تو جز میدان نیست(@)(@@) 19 از چه بایدت به دعوی زدن این چندین دست %~% که به دست تو ز صد معنی یک دستان نیست(@)(@@) 20 نام خود را چه نهی بیهده موسی کلیم %~% که گلیم تو بجز بافته هامان نیست(@)(@@) 21 تا در آتش چو روی همچو براهیم خلیل %~% چون ترا آیت یزدان رقم عنوان نیست(@)(@@) 22 غلطی جان پدر این شکر از عسگر نیست %~% غلطی جان پدر این گهر از عمان نیست(@)(@@) 23 ای بسا یوسف رویان که درین مصر بدند %~% که چو یعقوب پدرشان مگر از کنعان نیست(@)(@@) 24 ای بسا یونس نامان که درین آب شدند %~% که جگرشان همه جز سوخته و عطشان نیست(@)(@@) 25 مرد باید که چو بوالقاسم باشد به عمل %~% ورنه عالم تهی از کرده بوسفیان نیست(@)(@@) 26 گویی از اسم نکو مرد نکو فعل شود %~% نی چو بد باشد تن اسم ورا تاوان نیست(@)(@@) 27 من وفانام بسی دانم کش جز به جفا %~% طبع تا زنده و جان مایل و دل شادان نیست(@)(@@) 28 آهست آری سندان به همه جای ولیک %~% خویشتن 
ms249	 گاه ترازو ببرد سوهان نیست(@)(@@) 29 نام آتش نه ز گرمیست که آتش خوانند %~% آب از آن نیست به نام آب کجا سوزان نیست(@)(@@) 30 هفت و چارند اگر رسم بود وقت شمار %~% وقت افعال چرا فعلش هم چندان نیست(@)(@@) 31 یا بیا پاک بزی ورنه برو خاکی باش %~% که دو معنی همی اندر سخنی آسان نیست(@)(@@) 32 راه این سرو جوان دور و درازست ای پیر %~% می این خواجه سزای لب سرمستان نیست(@)(@@) 33 جان فشان در سر این کوی که از عیاران %~% شب نباشد که در آن موسم جان افشان نیست(@)(@@) 34 لذت نفس بدل ساز تو با لذت عشق %~% به گسل از طبع و هواگر غرضت هجران نیست(@)(@@) 35 راز این پرده نیابی اگر از نفس هوا %~% در کف نیستی تو علم طغیان نیست(@)(@@) 36 تا همه هو نشوی هوی تو الا نشود %~% چون شوی هو تو ترا آن هوس نقصان نیست(@)(@@) 37 تکیه بر شرع محمد کن و بر قرآن کن %~% زان کجا عروه وثقای تو جز قرآن نیست(@)(@@) 38 گفت این شعر سنایی که چو کیوانی گفت %~% روشنی عالم جز از فلک گردان نیست PageV1P0466(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای بنده ره شوق ملک بی خطری نیست %~% از جان قدمی ساز که به زین سفری نیست(@)(@@) 2 تیریست بلا در روش عشق که هرگز %~% جز دیده درویش مر او را سپری نیست(@)(@@) 3 از خود غذایی ساز پس آنگاه بره پوی %~% زیرا که ترا به ز تویی عشوه خری نیست(@)(@@) 4 خود را ز میان خود بردار ازیراک %~% کس بر تو درین ره ز تویی تو بتری نیست(@)(@@) 5 تن را چه قبولی نهی آنجا که ز عزت %~% صد جان مقدس را آنجا خطری نیست(@)(@@) 6 کشتند درین راه بسی عاشق بی‌تیغ %~% کز خون یکی عاشق حالی اثری نیست(@)(@@) 7 در بحر غمان غوطه خور از روی حقیقت %~% کاندر صدف عشق به از غم گهری نیست(@)(@@) 8 
