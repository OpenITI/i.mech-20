ms81	 السبابة والوسطى والبنصر ونحن مشرفون على الناس ) )(@)(@@) الحكيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 685 ) قال النبي :(@)(@@) | 30 ( أحشر يوم القيامة بين أبي بكر وعمر حتى أقف بين الحرمين فيأتيني أهل المدينة وأهل مكة ) )(@)(@@) ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 686 ) قال النبي :(@)(@@) | 30 ( احضروا الجمعة وادنوا من الإمام فإن الرجل تكون له المنزلة في الجنة فيتأخر عن الجمعة فيؤخر عنها ) )(@)(@@) ( لب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 687 ) قال النبي :(@)(@@) | 30 ( احلبها ودع داعي اللبن ) )(@)(@@) ( ك ) عن ضرار بن الأزور رضي الله عنه .(@)(@@) PageV01P121(@)(@@)(@@)(@@) $ ( 688 ) قال النبي :(@)(@@) | 30 ( احلق وأطعم فرقا بين ستة مساكين ، أو صم ثلاثة أيام ، أو انسك نسيكة ) )(@)(@@) ( خ م ت ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع الخاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 689 ) قال النبي :(@)(@@) | 30 ( أخاف على أمتي ثلاثا : زلة عالم ، وجدال منافق بالقرآن ، والتكذيب بالقدر ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 690 ) قال النبي :(@)(@@) | 30 ( أخاف على أمتي من بعدي ثلاثا : حيف الأئمة ، وإيمانا بالنجوم ، وتكذيبا بالقدر ) )(@)(@@) ( ابن عساكر ) عن أبي محجن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 691 ) قال النبي :(@)(@@) | 30 ( أخاف على أمتي من بعدي ثلاثا : ضلالة الأهواء ، واتباع الشهوات في البطون والفروج ، والغفلة بعد المعرفة ) )(@)(@@) ( الحكيم والبغوي وابن منده وابن قانع وابن شاهين وأبو نعيم الخمسة في كتب الصحابة ) عن أفلح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 692 ) قال النبي :(@)(@@) | 30 ( أخاف على أمتي من بعدي خصلتين : تكذيبا بالقدر وتصديقا بالنجوم ) )(@)(@@)(@@)(@@) $ ( 4 عد خط ) في كتاب النجوم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 693 ) قال النبي :(@)(@@) | 30 ( أخاف عليكم ستا : إمارة السفهاء ، وسفك الدم ، وبيع الحكم ، وقطيعة الرحم ، ونشوا ( نشأ ) يتخذون القرآن مزامير ، وكثرة الشرط ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 694 ) قال النبي :(@)(@@) | 30 ( اخبر تقله ) )(@)(@@) ( ع طب عد حل ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 695 ) قال النبي :(@)(@@) | 30 ( أخبرك بعمل إن أخذت به أدركت من كان قبلك وفت PageV01P122 من يكون بعدك إلا أحدا أخذ بمثل ذالك : تسبح خلف كل 
ms82	 صلاة ثلاثا وثلاثين ، وتكبر ثلاثا وثلاثين ، وتحمد أربعا وثلاثين ) )(@)(@@) ( حم ) و ابن خزيمة والضياء عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 696 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أن ابني الحسين يقتل بعدي بأرض الطف ، وجاءني بهاذه التربة وأخبرني أن فيها مضجعه ) )(@)(@@) ( ابن سعد طب ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 697 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أن الله عز وجل لبعثه إلى أمنا حواء حين دميت فنادت ربها جاء مني دم لا أعرفه فناداها لأدمينك وذريتك ، ولأجعلنه لك كفارة وطهورا ) )(@)(@@) ( قط ) في الأفراد عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 698 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أن حسينا يقتل بشاطىء الفرات ) )(@)(@@) ( ابن سعد ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 699 ) قال النبي :(@)(@@) | 30 ( أخبروني بشجرة شبه الرجل المسلم لا يتحات ورقها ولا ولا ولا تؤتي أكلها كل حين هي النخلة ) )(@)(@@) ( خ ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 699 ) قال النبي :(@)(@@) | 30 ( اختتن إبراهيم وهو ابن ثمانين سنة بالقدوم ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 700 ) قال النبي :(@)(@@) | 30 ( اختتن إبراهيم وهو ابن عشرين ومائة سنة ثم عاش بعد ذالك ثمانين سنة ) )(@)(@@) ( ابن عساكر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 701 ) قال النبي :(@)(@@) | 30 ( اختر منهن أربعا وفارق سائرهن ) )(@)(@@) ( د ) عن الحارث بن زيد الأسدي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 702 ) قال النبي :(@)(@@) | 30 ( اختصم عندي الجن المسلمون والجن المشركون وسألوني أن أسكنهم فأسكنت المسلمين الجلس وأسكنت المشركين الغور ) )(@)(@@) أبو الشيخ في العظمة ( طب ) عن بلال بن الحارث المزني رضي الله عنه ( ز ) .(@)(@@) PageV01P123(@)(@@)(@@)(@@) $ ( 703 ) قال النبي :(@)(@@) | 30 ( احتضبوا بالحناء فإنه طيب الريح يسكن الروع ) )(@)(@@) ( ع ) و الحاكم في الكنى عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 704 ) قال النبي :(@)(@@) | 30 ( اختضبوا بالحناء فإنه يزيد في شبابكم وجمالكم ونكاحكم ) )(@)(@@) ( البزار وأبو نعيم في الطب عن أنس أبو نعيم في المعرفة ) عن درهم والد معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 705 ) قال النبي :(@)(@@) | 30 ( اختضبوا وافرقوا وخالفوا اليهود ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 706 ) قال 
ms83	 النبي :(@)(@@) | 30 ( اختلاف أمتي رحمة ) )(@)(@@) نصر ( المقدسي في الحجة والبيهقي في الرسالة الأشعرية ) بغير سند وأورده الحليمي والقاضي حسين وإمام الحرمين وغيرهم ، ولعله خرج في بعض كتب الحفاظ التي لم تصل إلينا .(@)(@@)(@@)(@@) $ ( 707 ) قال النبي :(@)(@@) | 30 ( أخذ الأمير الهدية سحت ، وقبول القاضي الرشوة كفر ) )(@)(@@) ( حم ) في الزهد عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 708 ) قال النبي :(@)(@@) | 30 ( أخذ الراية زيد فاصيب ، ثم أخذها جعفر فأصيب ، ثم أخذها عبد الله بن رواحة فأصيب ، ثم أخذها خالد عن غير إمرة ففتح الله عليه ، وما يسرني أنهم عندنا ، أو قال يسرهم أنهم عندنا ) )(@)(@@) ( حم خ ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 709 ) قال النبي :(@)(@@) | 30 ( أخذ الله عز وجل مني الميثاق كما أخذ من النبيين ميثاقهم ، وبشر بي عيسى بن مريم ورأت أمي في منامها أنه خرج من بين رجليها سراج أضاءت له قصور الشام ) )(@)(@@) ( طب ) و أبو نعيم في الدلائل وابن مردويه رضي الله عنه ( ز ) .(@)(@@) PageV01P124(@)(@@)(@@)(@@) $ ( 710 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أن الحجم أنفع ما تداوى به الناس ) )(@)(@@) ( ك ) عن أبي هريرة عن أبي مريم الغساني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 711 ) قال النبي :(@)(@@) | 30 ( أخذنا فألك من فيك ) )(@)(@@) ( د ) عن أبي هريرة ( ابن السني وأبو نعيم معا ) في الطب عن كثير بن عبد الله عن أبيه عن جده ( فر ) عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 712 ) قال النبي :(@)(@@) | 30 ( أخر الكلام في القدر لشرار أمتي في آخر الزمان ) )(@)(@@) ( طس ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 713 ) قال النبي :(@)(@@) | 30 ( أخر عني يا ع| مر إني خيرت فاخترت ، قد قيل لي استغفر لهم أو لا تستغفر لهم ، إن تستغفر لهم سبعين مرة فلن يغفر الله لهم ، لو أعلم أني لو زدت على السبعين غفر له لزدت ) )(@)(@@) ( ت ن ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 714 ) قال النبي :(@)(@@) | 30 ( أخروا الأحمال فإن الأيدي مغلقة والأرجل موثقة ) )(@)(@@) ( د ) في مراسيله عن الزهري ووصله البزار ( 4 طس ) عن سعيد بن المسيب عن أبي هريرة رضي 
ms84	 الله عنه نحوه .(@)(@@)(@@)(@@) $ ( 715 ) قال النبي :(@)(@@) | 30 ( اخرج فأذن في الناس من الله لا من رسوله لعن الله قاطع السدر ) )(@)(@@) ( هق ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 716 ) قال النبي :(@)(@@) | 30 ( أخرج فناد في المدينة أن لا صلاة إلا بقرآن ولو بفاتحة الكتاب فما زاد ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 717 ) قال النبي :(@)(@@) | 30 ( أخرج فناد في الناس من شهد أن لا إلاه إلا الله وجبت له الجنة ) )(@)(@@)(@@)(@@) $ ( 4 ) عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 718 ) قال النبي :(@)(@@) | 30 ( أخرجوا المخنثين من بيوتكم ) )(@)(@@) ( حم خ ) عن ابن عباس ( خ ده ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 719 ) قال النبي :(@)(@@) | 30 ( أخرجوا المشركين من جزيرة العرب وأجيزوا الوفد بنحو ما كنت أجيزهم ) )(@)(@@) ( خ د ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 720 ) قال النبي :(@)(@@) | 30 ( أخرجوا اليهود والنصارى من جزيرة العرب ) )(@)(@@) ( م ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 721 ) قال النبي :(@)(@@) | 30 ( أخرجوا زكاة الفطر صاعا من طعام ) )(@)(@@) ( خط طب ) عن أوس بن الحدثان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 722 ) قال النبي :(@)(@@) | 30 ( أخرجوا صدقاتكم فإن الله عز وجل قد أراحكم من الجبهة والكسعة والنخة ) )(@)(@@) ( أبو عبيد في الغريب ) ( هق ) عن سارية الخلجي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 723 ) قال النبي :(@)(@@) | 30 ( أخرجوا منديل الغمر من بيوتكم فإنه مبيت الخبيث ومجلسه ) )(@)(@@) ( فر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 724 ) قال النبي :(@)(@@) | 30 ( أخرجوا يهود الحجاز وأهل نجران من جزيرة العرب واعلموا أن شر الناس الذين اتخذوا قبور أنبيائهم مساجد ) )(@)(@@) ( حم ( 4 ) حل ) و الضياء عن أبي عبيدة بن الجراح رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 725 ) قال النبي :(@)(@@) | 30 ( أخرجي إليه فإنه لا يحسن الاستئذان فقولي له فليقل السلام عليكم أأدخل ) )(@)(@@) ( حم ) عن رجل من بني عامر ( ز ) .(@)(@@)(@@)(@@) $ ( 726 ) قال النبي :(@)(@@) | 30 ( أخرجي فجدي نخلك لعلك أن تصدقي منه أو تفعلي خيرا ) )(@)(@@) ( د ن ه ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 727 ) قال النبي :(@)(@@) | 30 ( أخسر الناس صفقة رجل أخلق يديه 
ms85	 في آماله ولم PageV01P126 تساعده الأيام على أمنيته فخرج من الدنيا بغير زاد وقدم على الله تعالى بغير حجة ) )(@)(@@) ( ابن النجار في تاريخه ) عن عامر بن ربيعة رضي الله عنه وهو مما بيض له الديلمي .(@)(@@)(@@)(@@) $ ( 728 ) قال النبي :(@)(@@) | 30 ( أخشى ما خشيت على أمتي : كبر البطن ومداومة النوم والكسل وضعف اليقين ) )(@)(@@) ( قط ) في الأفراد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 729 ) قال النبي :(@)(@@) | 30 ( اخضبوا لحاكم فإن الملائكة تستبشر بخضاب المؤمن ) )(@)(@@) ( عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 730 ) قال النبي :(@)(@@) | 30 ( اخفضي ولا تنهكي فإنه أنضر للوجه وأحظى عند الزوج ) )(@)(@@) ( طب ك ) عن الضحاك بن قيس .(@)(@@)(@@)(@@) $ ( 731 ) قال النبي :(@)(@@) | 30 ( أخلص دينك يكفك القليل من العمل ) )(@)(@@) ( ابن أبي الدنيا ) في الإخلاص ( ك ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 732 ) قال النبي :(@)(@@) | 30 ( أخلصوا أعمالكم لله فإن الله لا يقبل إلا ما خلص له ) )(@)(@@) ( قط ) عن الضحاك بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 733 ) قال النبي :(@)(@@) | 30 ( أخلصوا عبادة الله تعالى وأقيموا خمسكم ، وأدوا زكاة أموالكم طيبة بها أنفسكم ، وصوموا شهركم ، وحجوا بيتكم تدخلوا جنة ربكم ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 734 ) قال النبي :(@)(@@) | 30 ( إخلعوا نعالكم عند الطعام فإنها سنة جميلة ) )(@)(@@) ( ك ) عن أبي عبس بن جبر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 735 ) قال النبي :(@)(@@) | 30 ( أخلفوني في أهل بيتي ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 736 ) قال النبي :(@)(@@) | 30 ( أخنع الأسماء عند الله يوم القيامة رجل تسمى ملك PageV01P127 الأملاك لا مالك إلا الله ) )(@)(@@) ( ق د ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 737 ) قال النبي :(@)(@@) | 30 ( إخوانكم خولكم جعلهم الله فتنة تحت أيديكم ، فمن كان أخوه تحت يده فليطعمه من طعامه ، وليلبسه من لباسه ، ولا يكلفه ما يغلبه فإن كلفه ما يغلبه فليعنه ) )(@)(@@) ( حم ق د ت ه ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 738 ) قال النبي :(@)(@@) | 30 ( إخواني لمثل هاذا اليوم فأعدوا ) )(@)(@@) ( خط ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 739 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي الهوى وطول 
ms86	 الأمل ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 740 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي كل منافق عليم اللسان ) )(@)(@@) ( عد ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 741 ) قال النبي :(@)(@@) | 30 ( أخوك البكري ولا تأمنه ) )(@)(@@) ( طس ) عن عمر بن الخطاب رضي الله عنه ( د ) عن عمرو بن الغفواء رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 742 ) قال النبي :(@)(@@) | 30 ( أخاف على أمتي الاستسقاء بالأنواء وحيف السلطان ، وتكذيبا بالقدر ) )(@)(@@) ابن جرير عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 743 ) قال النبي :(@)(@@) | 30 ( أخبرك بما هو أيسر عليك من هاذا وأفضل ، سبحان الله عدد ما خلق في السماء ، وسبحان الله عدد ما خلق في الأرض ، وسبحان الله عدد ما خلق بين ذالك ، وسبحان الله عدد ما هو الخالق والله أكبر مثل ذالك ، والحمد لله مثل ذالك ، ولا حول ولا قوة إلا بالله مثل ذالك ) )(@)(@@) ( د ) عن عائشة بنت سعد بن أبي وقاص رضي الله عنه عن أبيها أنه دخل مع رسول الله على امرأة بين يديها نوى أو حصى تسبح به ، قال : فذكره .(@)(@@) PageV01P128(@)(@@)(@@)(@@) $ ( 744 ) قال النبي :(@)(@@) | 30 ( أخبرك أنه من استنجى بعظم أو رجيع فهو بريء من محمد وبما أنزل على محمد ) )(@)(@@) الديلمي عن رويفع بن ثابت .(@)(@@)(@@)(@@) $ ( 745 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أنه لا ميراث لهما يعني العمة والخالة ) )(@)(@@) عبدان في الصحابة ( ك ) عن الحارث بن عبد ويقال ابن عبد مناف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 746 ) قال النبي :(@)(@@) | 30 ( أخبرني جبريل أن ابني الحسين يقتل بأرض العراق ، فقلت لجبريل : أرني تربة الأرض التي يقتل بها ، فجاء بها ، فهاذه تربتها ) )(@)(@@) ابن سعد عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 747 ) قال النبي :(@)(@@) | 30 ( أخبرهم أنه لا يجوز بيعان في بيع ، ولا بيع ما لا يملك ، ولا سلف وبيع ، ولا شرطان في بيع ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 748 ) قال النبي :(@)(@@) | 30 ( أخبرها أنها عاملة من عمال الله ولها نصف أجر المجاهد ) )(@)(@@) الخرائطي في مكارم الأخلاق من طريق زافر بن سليمان عن عبد الله الوضاحي أن 
ms87	 رجلا قال : يا رسول الله إن لي امرأة إذا دخلت عليها قالت : مرحبا بسيدي وسيد أهل بيتي ، وإذا رأتني حزينا قالت : ما يحزنك الدنيا وقد كفيت أمر الآخرة ، قال النبي فذكره .(@)(@@)(@@)(@@) $ ( 749 ) قال النبي :(@)(@@) | 30 ( اختتن إبراهيم خليل الرحمان بعد أن مرت عليه ثمانون سنة واختتن بالفأس ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 750 ) قال النبي :(@)(@@) | 30 ( اخبره تقله ، وثق بالناس رويدا ) )(@)(@@) ( ع طب عد حل ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 751 ) قال النبي :(@)(@@) | 30 ( إختنوا أولادكم يوم السابع فإنه أطهر وأسرع نباتا للحم ، وأروح للقلب ) )(@)(@@) أبو حفص عمر بن عبد الله بن زادان في فوائده ، والديلمي عن علي رضي الله عنه .(@)(@@) PageV01P129(@)(@@)(@@)(@@) $ ( 752 ) قال النبي :(@)(@@) | 30 ( اختضبوا بالحناء فإنه طيب الريح يسكن الروع ) )(@)(@@) ( ع ) و الحاكم في الكنى عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 753 ) قال النبي :(@)(@@) | 30 ( أخذ الراية زيد بن حارثة فقاتل بها حتى قتل شهيدا ، ثم أخذها جعفر فقاتل بها حتى قتل شهيدا ، ثم أخذها عبد الله بن رواحة فقاتل بها حتى قتل شهيدا ، لقد رفعوا لي في الجنة فيما يرى النائم على سرر من ذهب فرأيت في سرير عبد الله بن رواحة ازورارا عن سرير صاحبيه فقلت : بم هاذا ؟ فقيل لي : مضيا وتردد عبد الله بن رواحة بعض التردد ومضى ) )(@)(@@) ( طب ) عن رجل من الصحابة من بني مرة بن عوف .(@)(@@)(@@)(@@) $ ( 754 ) قال النبي :(@)(@@) | 30 ( أخذ جبريل بيدي فأراني باب الجنة الذي يدخل منه أمتي ، فقال أبو بكر رضي الله عنه وددت أني كنت معك حتى أراه ، قال : أما إنك أول من يدخل الجنة من أمتي ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 755 ) قال النبي :(@)(@@) | 30 ( أخذك الكفار فغطوك في الماء فقلت كذا وكذا فإن عادوا فقل ذالك لهم ) )(@)(@@) ابن سعد عن ابن عون عن محمد أن النبي لقي عمارا رضي الله عنه فقال له فذكره .(@)(@@)(@@)(@@) $ ( 756 ) قال النبي :(@)(@@) | 30 ( أخر أهلك فإنه يوشك أن تخرج منه نار تضيء أعناق الإبل ببصرى يعني من حبس 
ms88	 سيل ) )(@)(@@) ( ك ) وتعقب عن أبي البداح بن عاصم رضي الله عنه عن أبيه .(@)(@@)(@@)(@@) $ ( 757 ) قال النبي :(@)(@@) | 30 ( أخروه عني هاذا شراب المترفين ) )(@)(@@) ابن سعد عن يزيد عبد الله بن قسيط أن النبي أتي بسويق من سويق اللوز فقال فذكره .(@)(@@)(@@)(@@) $ ( 758 ) قال النبي :(@)(@@) | 30 ( أخره هاذا شراب المترفين ) )(@)(@@) ابن سعد عن أبي صخر رضي الله عنه قال : أتي رسول الله بسويق لوز فقال فذكره .(@)(@@)(@@)(@@) $ ( 759 ) قال النبي :(@)(@@) | 30 ( اخرج فناد في الناس من قال لا إلاه إلا الله فله الجنة PageV01P130 وإن زنى وإن سرق على رغم أنف أ| بي الدرداء ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 760 ) قال النبي :(@)(@@) | 30 ( اخرج يا علي فقل عن الله لا عن رسول الله : لعن الله من يقطع السدر ) )(@)(@@) ( هق ) عن أبي جعفر مرسلا .(@)(@@)(@@)(@@) $ ( 761 ) قال النبي :(@)(@@) | 30 ( أخرجته عن غمرة جهنم إلى ضحضاح منها ) )(@)(@@) ( ع عد ) و تمام عن جابر رضي الله عنه قال : سئل النبي عن أبي طالب قال فذكره .(@)(@@)(@@)(@@) $ ( 762 ) قال النبي :(@)(@@) | 30 ( أخرج أهلك منها يعني من حبس سيل فإنه يوشك أن تخرج منه نار تضيء أعناق الإبل ببصرى ) )(@)(@@) ( طب ) عن عاصم بن عدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 763 ) قال النبي :(@)(@@) | 30 ( أخرج الزكاة من مالك فإنها طهور يطهرك الله وتصلي وتعرف حق السائل والجار والمسكين وابن السبيل ولا تبذر تبذيرا ) )(@)(@@) ابن صصرى في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 764 ) قال النبي :(@)(@@) | 30 ( أخرجوا إلي اثنى عشر منكم يكونوا كفلاء على قومهم كما كفلت الحواريون لعيسى بن مريم ، ولا يجدن أحد منكم في نفسه أن يؤخذ غيره فإنما يختار لي جبريل ) )(@)(@@) ابن إسحاق وابن سعد عن عبد الله بن أبي بكر بن محمد عن عمرو بن حزم رضي الله عنه قال : قال رسول الله للنفر الذين لقوه بالعقبة فذكره .(@)(@@)(@@)(@@) $ ( 765 ) قال النبي :(@)(@@) | 30 ( أخرجوا يهود من جزيرة العرب ) )(@)(@@) ( ط ) و الدارمي والحاكم في الكنى عن أبي عبيدة ( طب ) عن أم سلمة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 766 ) قال النبي :(@)(@@) | 30 ( أخرجوا يهود 
ms89	 نجران من الحجاز ) )(@)(@@) أبو نعيم في المعرفة عن أبي عبيدة رضي الله عنه .(@)(@@) PageV01P131(@)(@@)(@@)(@@) $ ( 767 ) قال النبي :(@)(@@) | 30 ( أخرجوه من سره أن ينظر إلى رجل من أهل النار فلينظر إلى هاذا ) )(@)(@@) سمويه عن أنس رضي الله عنه أن أعرابيا قال : يا رسول الله ما صدعت قط ولا وجعت قال فذكره .(@)(@@)(@@)(@@) $ ( 768 ) قال النبي :(@)(@@) | 30 ( اخرجوا منها وهي ذميمة ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 769 ) قال النبي :(@)(@@) | 30 ( أخرها عنا فقد استجيب لك ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه قال : بينما رسول الله يسير إذ لعن رجل ناقته قال فذكره .(@)(@@)(@@)(@@) $ ( 770 ) قال النبي :(@)(@@) | 30 ( اخسأ فلن تعدو قدرك ) )(@)(@@) قاله لابن صياد ( حم خ م د ) عن ابن عمر ( خ ) عن ابن عباس ( طب ض ) عن السيد الحسين ( حم ) والروياني ( ض ) عن أبي ذر ( م ) عن ابن مسعود ( حم ) عن أبي سعيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 771 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي : الأئمة المضلون ) )(@)(@@) ( حم حل ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 772 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي ثلاث : الإستسقاء بالأنواء ، وحيف السلطان ، والتكذيب بالقدر ) )(@)(@@) ( ابن أبي عاصم ) في المسند عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 773 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي ثلاث : ضلالة الأهواء ، واتباع الشهوات في البطن والفرج ، والعجب ) )(@)(@@) الحكيم عن أفلح رضي الله عنه مولى رسول الله .(@)(@@)(@@)(@@) $ ( 774 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي : تصديق بالنجوم وتكذيب بالقدر ، ولا يؤمن عبد حتى يؤمن بالقدر خيره وشره ، حلوه ومره ) )(@)(@@) ( ك ) عن أنس وأخذ بلحيته وقال : آمنت بالقدر خيره وشره ، حلوه ومره ابن النجار عن أنس رضي PageV01P132 الله عنه .(@)(@@)(@@)(@@) $ ( 775 ) قال النبي :(@)(@@) | 30 ( أخوف ما أخاف على أمتي : شح مطاع ، وهوى متبع ، وإعجاب كل ذي رأي برأيه ) )(@)(@@) أبو نصر السجزي في الإبانة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 776 ) قال النبي :(@)(@@) | 30 ( أخوك استسقى قبلك يشرب ثم تشرب ما هو بأحبهما إلي وإنهما عندي لبمكان واحد ، وإني 
ms90	 وإياك وهما وهاذا الراقد يوم القيامة لفي مكان واحد ) )(@)(@@) ( طب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 777 ) قال النبي :(@)(@@) | 30 ( أخوك في الإسلام لا تكلفه من العمل إلا ما أطاق ، وأطعمه من طعامك ، وألبسه من لباسك ، فإن كرهته فبعه ) )(@)(@@) يعني العبد ( طس ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 778 ) قال النبي :(@)(@@) | 30 ( أخوك صنع طعاما ودعاك أفطر واقض يوما مكانه ) )(@)(@@) ( ط ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 779 ) قال النبي :(@)(@@) | 30 ( إدبار النجوم الركعتان قبل الفجر ، وأدبار السجود الركعتان بعد المغرب ) )(@)(@@) ( ت ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 780 ) قال النبي :(@)(@@) | 30 ( أدبني ربي فأحسن تأديبي ) )(@)(@@) ( ابن السمعاني في أدب الإملاء ) عن ابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 781 ) قال النبي :(@)(@@) | 30 ( أدبني ربي ونشأت في بني سعد ) )(@)(@@) ( ابن عساكر ) عن عبد الرحمن بن محمد بن عبد الرحمان الزهري عن أبيه عن جده ( ز ) .(@)(@@) PageV01P133(@)(@@)(@@)(@@) $ ( 782 ) قال النبي :(@)(@@) | 30 ( أدبوا أولادكم على ثلاث خصال : حب نبيكم ، وحب أهل بيته ، وقراءة القرآن ، فإن حملة القرآن في ظل الله يوم القيامة يوم لا ظل إلا ظله مع أنبيائه وأصفيائه ) )(@)(@@) أبو نصر عبد الكريم الشيرازي في فوائده ( فر ) وابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 783 ) قال النبي :(@)(@@) | 30 ( أد الأمانة إلى من ائتمنك ولا تخن من خانك ) )(@)(@@) ( تخ د ت ك ) عن أبي هريرة ( قط ) والضياء عن أنس ( طب ) عن أبي أمامة ( د ) عن رجل من الصحابة ( قط ) عن أبي بن كعب رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 784 ) قال النبي :(@)(@@) | 30 ( أد الزكاة المفروضة فإنها طهرة تطهرك ، وأت صلة الرحم ، واعرف حق السائل والجار والمسكين ) )(@)(@@) ( حم ك ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 785 ) قال النبي :(@)(@@) | 30 ( أد ما افترض الله عليك تكن من أعبد الناس ، واجتنب ما حرم الله عليك تكن أورع الناس ، وارض بما قسم الله لك تكن من أغنى الناس ) )(@)(@@) ( عد ) عن ابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 786 ) قال النبي :(@)(@@) | 30 ( أدوا العزائم واقبلوا الرخص ، ودعوا الناس 
ms91	 فقد كفيتموهم ) )(@)(@@) ( خط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 787 ) قال النبي :(@)(@@) | 30 ( أدوا حق المجالس ، اذكروا الله كثيرا ، وأرشدوا السبيل ، وغضوا الأبصار ) )(@)(@@) ( طب ) عن سهل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 788 ) قال النبي :(@)(@@) | 30 ( أدوا صاعا من بر أو قمح بين اثنين ، أو صاعا من تمر ، أو صاعا من شعير على كل حر وعبد صغير وكبير ) )(@)(@@) ( حم قط ) و الضياء عن عبد الله بن ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 789 ) قال النبي :(@)(@@) | 30 ( أدوا صاعا من طعام في الفطر ) )(@)(@@) ( حل هق ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P134(@)(@@)(@@)(@@) $ ( 790 ) قال النبي :(@)(@@) | 30 ( أدخل الله الجنة رجلا كان سهلا مشتريا وبائعا ، وقاضيا ومقتضيا ) )(@)(@@) ( حم ن ه هب ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 791 ) قال النبي :(@)(@@) | 30 ( أدخلت الجنة فوجدت أكثر أهلها ذرية المؤمنين والفقراء ، ووجدت أقل أهلها النساء والأغنياء ) )(@)(@@) ( هناد ) عن حيان بن أبي جبلة مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 792 ) قال النبي :(@)(@@) | 30 ( أدخل رجل قبره فأتاه ملكان فقالا له : إنا ضاربوك ضربة ، فضرباه ضربة امتلأ قبره منها نارا فتركاه حتى أفاق وذهب عنه الرعب ، فقال لهما : علام ضربتماني ؟ فقالا : إنك صليت صلاة وأنت على غير طهور ، ومررت برجل مظلوم فلم تنصره ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 793 ) قال النبي :(@)(@@) | 30 ( ادرؤوا الحدود بالشبهات ، وأقيلوا الكرام عثراتهم إلا في حد من حدود الله تعالى ) )(@)(@@) ( عد ) في جزء له من حديث أهل مصر والجزيرة عن ابن عباس ، رضي الله عنهما . وروى صدره أبو مسلم الكجي وابن السمعاني في الذيل عن عمر بن عبد العزيز مرسلا ، ومسدد في مسنده عن ابن مسعود رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 794 ) قال النبي :(@)(@@) | 30 ( ادرؤوا الحدود عن المسلمين ما استطعتم فإن وجدتم للمسلم مخرجا فخلوا سبيله ، فإن الإمام لأن يخطىء في العفو خير من أن يخطىء في العقوبة ) )(@)(@@) ( ش ت ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 795 ) قال النبي :(@)(@@) | 30 ( ادرؤوا الحدود ولا ينبغي للإمام تعطيل الحدود ) )(@)(@@) ( قط هق ) عن علي رضي الله 
ms92	 عنه .(@)(@@)(@@)(@@) $ ( 796 ) قال النبي :(@)(@@) | 30 ( ادع إلى ربك الذي إن مسك ضر فدعوته كشف PageV01P135 عنك ، والذي إن أضللت بأرض قفر فدعوته رد عليك ، والذي إن أصابتك سنة فدعوته أنبت لك ) )(@)(@@) ( حم د هق ) عن أبي جري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 797 ) قال النبي :(@)(@@) | 30 ( أدعو الله وأنتم موقنون بإلاجابة واعلموا أن الله لا يستجيب دعاء من قلب غافل لاه ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 798 ) قال النبي :(@)(@@) | 30 ( ادعوا الناس وبشروا ولا تنفروا ، ويسروا ولا تعسروا ) )(@)(@@) ( م ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 799 ) قال النبي :(@)(@@) | 30 ( ادعي أبا بكر أباك وأخاك حتى أكتب كتابا فإني أخاف أن يتمنى متمن ويقول قائل أنا أولى ويأبى الله والمؤمنون إلا أبا بكر ) )(@)(@@) ( حم م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 800 ) قال النبي :(@)(@@) | 30 ( إدفعوا الحدود عن عباد الله ما وجدتم لها مدفعا ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 801 ) قال النبي :(@)(@@) | 30 ( ادفعوها إلى خالتها فإن الخالة أم ) )(@)(@@) ( ك ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 802 ) قال النبي :(@)(@@) | 30 ( إدفنوا القتلى في مصارعهم ) )(@)(@@)(@@)(@@) $ ( 4 ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 803 ) قال النبي :(@)(@@) | 30 ( ادفنوا دماءكم وأشعاركم وأظفاركم لا تلعب بها السحرة ) )(@)(@@) ( فر ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 804 ) قال النبي :(@)(@@) | 30 ( إدفنوا موتاكم وسط قوم صالحين فإن الميت يتأذى بجار السوء كما يتأذى الحي بجار السوء ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 805 ) قال النبي :(@)(@@) | 30 ( أدمان في إناء لا آكله ولا أحرمه ) )(@)(@@) ( طس ك ) عن أنس رضي الله عنه .(@)(@@) PageV01P136(@)(@@)(@@)(@@) $ ( 806 ) قال النبي :(@)(@@) | 30 ( أدن العظم من فيك فإنه أهنا وأمرأ ) )(@)(@@) ( د ) عن صفوان بن أمية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 807 ) قال النبي :(@)(@@) | 30 ( أدن اليتيم منك وألطفه وامسح برأسه وأطعمه من طعامك فإن ذالك يلين قلبك ويدرك حاجتك ) )(@)(@@) ( الخرائطي في مكارم الأخلاق وابن عساكر ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 808 ) قال النبي :(@)(@@) | 30 ( ادن يا بني فسم الله وكل بيمينك وكل 
ms93	 مما يليك ) )(@)(@@) ( د ت حب ) عن عمرو بن أبي سلمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 809 ) قال النبي :(@)(@@) | 30 ( أدنى أهل الجنة منزلة الذي له ثمانون ألف خادم واثنتان وسبعون زوجة ، وتنصب له قبة من لؤلؤ وزبرجد وياقوت كما بين الجابية وصنعاء ) )(@)(@@) ( حم ت حب ) و الضياء عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 810 ) قال النبي :(@)(@@) | 30 ( أدنى أهل النار عذابا ينتعل بنعلين من نار يغلي دماغه من حرارة نعليه ) )(@)(@@) ( م ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 811 ) قال النبي :(@)(@@) | 30 ( أدنى جبذات الموت بمنزلة مائة ضربة بالسيف ) )(@)(@@) ( ابن أبي الدنيا في ذكر الموت ) عن الضحاك بن حمرة مرسلا .(@)(@@)(@@)(@@) $ ( 812 ) قال النبي :(@)(@@) | 30 ( أدنى ما تقطع فيه يد السارق ثمن المجن ) )(@)(@@) ( الطحاوي طب ) عن أيمن الحبشي .(@)(@@)(@@)(@@) $ ( 813 ) قال النبي :(@)(@@) | 30 ( أديموا الحج والعمرة فإنهما ينفيان الفقر والذنوب كما ينفي الكير خبث الحديد ) )(@)(@@) ( ه قط ) في الأفراد ( طس ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 814 ) قال النبي :(@)(@@) | 30 ( ادخروا لبيوتكم نصيبا من القرآن فإن البيت إذا قرىء PageV01P137 فيه آنس على أهله وكثر خيره وكان سكانه مؤمني الجن ، وإذا لم يقرأ فيه أوحش على أهله وقل خيره وكان سكانه كفرة الجن ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 815 ) قال النبي :(@)(@@) | 30 ( ادخروا الثلث وتصدقوا بما بقي يعني الأضحية ) )(@)(@@) ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 816 ) قال النبي :(@)(@@) | 30 ( أدخل الله فاجرا في دينه ، أحمق في معيشته ، بسماحته الجنة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 817 ) قال النبي :(@)(@@) | 30 ( أدخل نفسك في هموم الدنيا واخرج منها بالصبر ، وليردك عن الناس ما تعلم من نفسك ) )(@)(@@) ابن أبي الدنيا ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 818 ) قال النبي :(@)(@@) | 30 ( أدركهما فارتجعهما وبعهما جميعا ولا تفرق بينهما يعني أخوين ) )(@)(@@) ( حم ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 819 ) قال النبي :(@)(@@) | 30 ( ادرؤوا الحدود بالشبهات ) )(@)(@@) أبو مسلم الكجي عن عمر بن عبد العزيز مرسلا .(@)(@@)(@@)(@@) $ ( 820 ) قال النبي :(@)(@@) | 30 ( ادعوا إخوانكم بأسمائهم ولا تدعوهم بالألقاب ) )(@)(@@) ( عد ) عن 
ms94	 عبد الله بن جراد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 821 ) قال النبي :(@)(@@) | 30 ( ادفعوا عن وضوئكم باليقين وعن صلاتكم بالشك ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 822 ) قال النبي :(@)(@@) | 30 ( إدفنوهم في دمائهم يعني يوم أحد ) )(@)(@@) ( خ ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 823 ) قال النبي :(@)(@@) | 30 ( إدفنوهم بدمائهم وثيابهم ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P138(@)(@@)(@@)(@@) $ ( 824 ) قال النبي :(@)(@@) | 30 ( إدفنه لا يبحث عنه كلب ) )(@)(@@) ابن سعد عن هارون بن دياب أن رسول الله احتجم ثم قال لرجل فذكره .(@)(@@)(@@)(@@) $ ( 825 ) قال النبي :(@)(@@) | 30 ( إدفنوه في البقيع فإن له مرضعا يتم رضاعه في الجنة يعني إبراهيم ) )(@)(@@) ( كر ) عن أنس بن سعد والروياني ( كر ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 826 ) قال النبي :(@)(@@) | 30 ( ادهنوا بالبان فإنه أحظى لكم عند نسائكم ، وادهنوا بالبنفسج فإنه بارد في الصيف حار في الشتاء ) )(@)(@@) ( عد ) و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 827 ) قال النبي :(@)(@@) | 30 ( ادهنها وأكرمها ) )(@)(@@) البغوي عن جابر قال : كان لأبي قتادة رضي الله عنه جمة فسأل النبي عنها فقال فذكره .(@)(@@)(@@)(@@) $ ( 828 ) قال النبي :(@)(@@) | 30 ( أدن منك اليتيم وامسح برأسه وأجلسه على خوانك يلن قلبك وتقدر على حاجتك ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي عمران الجوني مرسلا .(@)(@@)(@@)(@@) $ ( 829 ) قال النبي :(@)(@@) | 30 ( أدوا إلى كل ذي حق حقه ، والولد للفراش وللعاهر الحجر ، ومن تولى غير مواليه أو ادعى إلى غير أبيه فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل منه صرف ولا عدل ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 830 ) قال النبي :(@)(@@) | 30 ( أدوا صاعا من تمر أو صاعا من قمح بين اثنين أو صاعا من شعير عن كل واحد صغير وكبير ) )(@)(@@) ( طب ) عن عبد الله بن ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 831 ) قال النبي :(@)(@@) | 30 ( أدوا صاعا من قمح عن كل إنسان ذكر أو أنثى أو صغير أو كبير أو غني أو فقير حر أو مملوك ، فأما الغني فيزكيه الله وأما الفقير فيرد عليه أكثر مما أعطى ) )(@)(@@) ( هق ) عن ثعلبة بن عبد الله أو عبد الله 
ms95	 بن ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 832 ) قاال النبي :(@)(@@) | 30 ( إذا آتاك الله مالا فلير أثر نعمة الله عليك وكرامته ) )(@)(@@) ( ك ) عن والد أبي الأحوص رضي الله عنه .(@)PageV01P139(@)(@@)(@@)(@@) ||| ( الهمزة مع الذال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 833 ) قال النبي :(@)(@@) | 30 ( إذا آتاك الله مالا فلير عليك فإن الله يحب أن يراى أثره علاى عبده حسنا ولا يحب البؤس ولا التباؤس ) )(@)(@@) ( تخ طب ) و الضياء عن زهير بن أبي علقمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 834 ) قال النبي :(@)(@@) | 30 ( إذا آتاك الله تعالى مالا لم تسأله ولم تشره إليه نفسك فاقبله فإنما هو رزق ساقه الله إليك ) )(@)(@@) ( هق ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 835 ) قال النبي :(@)(@@) | 30 ( إذا آخى الرجل الرجل فليسأله عن اسمه واسم أبيه وممن هو فانه أوصل للمودة ) )(@)(@@) ( ابن سعد تخ ت ) عن يزيد بن نعامة الضبي .(@)(@@)(@@)(@@) $ ( 836 ) قال النبي :(@)(@@) | 30 ( إذا آخيت رجلا فسله عن اسمه واسم أبيه فإن كان غائبا حفظته ، وإن كان مريضا عدته ، وإن مات شهدته ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 837 ) قال النبي :(@)(@@) | 30 ( إذا آمنك الرجل على دمه فلا تقتله ) )(@)(@@) ( حم ه ) عن سل يمان بن صرد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 838 ) قال النبي :(@)(@@) | 30 ( إذا ابتاع أحدكم الخادم فليكن أول شيء يطعمه الحلوى فإنه أطيب لنفسه ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 839 ) قال النبي :(@)(@@) | 30 ( إذا ابتعت طعاما فلا تبعه حتى تستوفيه ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 840 ) قال النبي :(@)(@@) | 30 ( إذا ابتغيتم المعروف فاطلبوه عند حسان الوجوه ) )(@)(@@) ( عد PageV01P140 هب ) عن عبد الله بن جراد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 841 ) قال النبي :(@)(@@) | 30 ( إذا ابتلي أحدكم بالقضاء بين المسلمين فلا يقض وهو غبضان ، وليسو بينهم في النظر والمجلس والإشارة ) )(@)(@@) ( ع ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 842 ) قال النبي :(@)(@@) | 30 ( إذا ابتلى الله العبد المسلم ببلاء في جسده قال الله عز وجل أكتب له صالح عمله ، فإن شفاه غسله وطهره ، وإن قبضه غفر له ورحمه ) )(@)(@@) ( حم ) عن 
ms96	 أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 843 ) قال النبي :(@)(@@) | 30 ( إذا أبردتم إلي بريدا فابعثوه حسن الوجه حسن الاسم ) )(@)(@@) ( البزار ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 844 ) قال النبي :(@)(@@) | 30 ( إذا أبغض المسلمون علماءهم وأظهروا عمارة أسواقهم ، وتألبوا على جمع الدراهم ، رماهم الله بأربع خصال : بالقحط من الزمان ، والجور من السلطان ، والخيانة من ولاة الحكام ، والصولة من العدو ) )(@)(@@) ( ك ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 845 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد إلى الشرك فقد حل دمه ) )(@)(@@) ( د وابن خزيمة ) عن جرير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 846 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد لم تقبل له صلاة ) )(@)(@@) ( م ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 847 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم البراز فليكرم قبلة الله فلا يستقبلها ولا يستدبرها ثم ليستطب بثلاثة أحجار أو ثلاثة أعواد أو ثلاث حثيات من تراب ، ثم ليقل : الحمد لله الذي أخرج عني ما يؤذيني ، وأمسك علي ما ينفعني ) )(@)(@@) ( عد قط والبيهقي في المعرفة ) عن طاوس مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 848 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم الصلاة والإمام على حال فليصنع كما يصنع الإمام ) )(@)(@@) ( ت ) عن علي ومعاذ رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 849 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم الغائط فلا يستقبل القبلة ولا يولها ظهره ، ولاكن شرقوا أو غربوا ) )(@)(@@) ( حم ق 4 ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 850 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله ثم أراد أن يعود فليتوضأ ) )(@)(@@) ( حم م 4 ) عن أبي سعيد رضي الله عنه زاد ( حب ك هق ) فإنه أنشط للعود .(@)(@@)(@@)(@@) $ ( 851 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله فليستتر فإنه إذا لم يستتر استحيت الملائكة وخرجت وحضر الشيطان فإذا كان بينهما ولد كان للشيطان فيه شريك ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 852 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله فليستتر ولا يتجردان تجرد العيرين ) )(@)(@@) ( ش طب هق ) عن ابن مسعود ( ه ) عن عتبة بن عبد ( ن ) عن عبد الله بن سرجس ( طب ) عن أبي أمامة رضي الله عنهم 
ms97	 .(@)(@@)(@@)(@@) $ ( 853 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله وأراد أن يعود فليغسل فرجه ) )(@)(@@) ( ت هق ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 854 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم باب حجرته فليسلم فإنه يرد قرينه الذي معه من الشيطان ، فإذا دخلتم حجركم فسلموا يخرج ساكنها من الشيطان ، وإذا رحلتم فسموا على أول حلس تضعونه على دوابكم لا يشرككم في مركبها فإن لم تفعلوا شرككم ، وإذا أكلتم فسموا حتى لا يشرككم فإن لم تفعلوا شرككم في طعامكم ، ولا تبينوا القمامة معكم في حجركم فإنها مقعده ، ولا تبينوا المنديل في PageV01P142 بيوتكم فإنه مضجعه ، ولا تفترشوا الولايا التي تلي ظهور الدواب ، ولا تسكنوا بيوتا غير مغلقة ، ولا تبيتوا على سطوح غير محوطة ، فإذا سمعتم نباح الكلب أو نهيق الحمار فاستعيذوا بالله فإنه لا ينهق حمار ولا ينبح كلب حتى يراه ) )(@)(@@) ( عبد بن حميد ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 855 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم خادمه بطعامه قد كفاه علاجه ودخانه فليجلسه معه فإن لم يجلسه معه فليناوله أكلة أو أكلتين ) )(@)(@@) ( ق د ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 856 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم على ماشية فإن كان فيها صاحبها فليستأذن فإن أذن له فليحتلب وليشرب ، وإن لم يكن فيها فليصوت ثلاثا ، فإن أجابه أحد فليستأذنه ، فإن لم يجبه أحد فليحتلب وليشرب ولا يحمل ) )(@)(@@) ( د ت هق ) و الضياء عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 857 ) قال النبي :(@)(@@) | 30 ( إذا أتى الرجل الرجل فهما زانيان ، وإذا أتت المرأة المرأة فهما زانيتان ) )(@)(@@) ( هق ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 858 ) قال النبي :(@)(@@) | 30 ( إذا أتى الرجل القوم فقالوا له مرحبا فمرحبا به يوم القيامة يوم يلقى ربه ، وإذا أتى الرجل القوم فقالوا له قحطا فقحطا له يوم القيامة ) )(@)(@@) ( طب ك ) عن الضحاك بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 859 ) قال النبي :(@)(@@) | 30 ( إذا أتى على الجارية تسع سنين فهي امرأة ) )(@)(@@) ( خط فر ) و ابن عساكر عن ابن عمر رضي 
ms98	 الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 860 ) قال النبي :(@)(@@) | 30 ( إذا أتى على العبد أربعون سنة يجب عليه أن يخاف الله ويحذره ) )(@)(@@) ( فر ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 861 ) قال النبي :(@)(@@) | 30 ( إذا أتى علي يوم لا أزداد فيه علما يقربني إلى الله تعالى فلا بورك لي في طلوع شمس ذالك اليوم ) )(@)(@@) ( طس عد حل ) عن عائشة رضي الله عنها .(@)(@@) PageV01P143(@)(@@)(@@)(@@) $ ( 862 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم الزائر فأكرموه ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 863 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم السائل فضعوا في يده ولو ظلفا محرقا ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 864 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم المصدق فليصدر عنكم وهو راض ) ( حم م ت ن ه ) عن ج$ رير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 865 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم كريم قوم فأكرموه ) )(@)(@@) ( ه ) عن ابن عمر البزار وابن خزيمة ( طب عد هب ) عن جرير ( البزار ) عن أبي هريرة ( عد ) عن معاذ وأبي قتادة ( ك ) عن جابر ( طب ) عن ابن عباس وعن عبد الله بن حمزة ( ابن عساكر ) عن أنس رضي الله عنهم وعن عدي بن حاتم ( الدولابي ) في الكنى وابن عساكر عن أبي راشد عبد الرحمان بن عبد بلفظ شريف قومه .(@)(@@)(@@)(@@) $ ( 866 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم من ترضون خلقه ودينه فزوجوه إن لا تفعلوا تكن فتنة في الأرض وفساد عريض ) )(@)(@@) ( ت ه ك ) عن أبي هريرة ( عد ) عن ابن عمر ( ت هق ) عن أنبي حاتم المزني رضي الله عنهم وما له غيره .(@)(@@)(@@)(@@) $ ( 867 ) قال النبي :(@)(@@) | 30 ( إذا اتخذ الفيء دولا والأمانة مغنما ، والزكاة مغرما ، وتعلم لغير الدين ، وأطاع الرجل امرأته ، وعق أمه ، وأدنى صديقه ، وأقصى أباه ، وظهرت الأصوات في المساجد ، وساد القبيلة فاسقهم ، وكان زعيم القوم أرذلهم ، وأكرم الرجل مخافة شره ، وظهرت القينات والمعازف ، وشربت الخمور ، ولعن آخر هاذه الأمة أولها ، فليرتقبوا عند ذالك ريحا حمراء وزلزلة وخسفا ومسخا وقذفا وآيات تتابع كنظام لآل قطع سلكه فتتابع ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV01P144(@)(@@)(@@)(@@) $ ( 868 ) قال النبي 
ms99	 :(@)(@@) | 30 ( إذا اتسع الثوب فتعطف به على منكبيك ثم صل ، وإن ضاق عن ذالك فشد به حقوك ، ثم صل بغير رداء ) )(@)(@@) ( ح ) و الطحاوي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 869 ) قال النبي :(@)(@@) | 30 ( إذا أتيت الصلاة فأتها بوقار وسكينة ، فصل ما أدركت واقض ما فاتك ) )(@)(@@) ( طس ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 870 ) قال النبي :(@)(@@) | 30 ( إذا أتيت على راعي إبل فناد يا راعي الإبل ثلاثا فإذا أجابك وإلا فاحلب واشرب من غير أن تفسد ، وإذا أتيت على حائط فناد يا صاحب الحائط ثلاثا فإن أجابك وإلا فكل من غير أن تفسد ) )(@)(@@) ( حم ه حب ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 871 ) قال النبي :(@)(@@) | 30 ( إذا أتيت فاعمل عملا كيسا ) )(@)(@@) ( خط ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 872 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم الصلاة فعليكم بالسكينة ولا تأتوها وأنتم تسعون فما أدركتم فصلوا وما فاتكم فأتموا ) )(@)(@@) ( حم ق ) عن أبي قتادة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 873 ) قال النبي :(@)(@@) | 30 ( إذا أتيت مضجعك فتوضأ وضوءك للصلاة ثم اضطجع على شقك الأيمن ثم قل : اللهم أسلمت وجهي إليك ، وفوضت أمري إليك ، وألجأت ظهري إليك رغبة ورهبة إليك ، لا ملجأ ولا منجا منك إلا إليك ، آمنت بكتابك الذي أنزلت ، وبنبيك الذي أرسلت ، فإن مت من ليلتك ، فأنت على الفطرة ، واجعلهن آخر ما تتكلم به ) )(@)(@@) ( حم ق 3 ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 874 ) قال النبي :(@)(@@) | 30 ( إذا أتيت وكيلي فخذ منه خمسة عشر وسقا ، فإن ابتغى PageV01P145 منك آية فضع يدك على ترقوته ) )(@)(@@) ( د ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 875 ) قال النبي :(@)(@@) | 30 ( إذا أثقلت مرضاكم فلا تملوهم قول لا إلاه إلا الله ولكن لقنوهم فإنه لم يختم به لمنافق ) )(@)(@@) ( قط ) و أبو القاسم القشيري في أماليه عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 876 ) قال النبي :(@)(@@) | 30 ( إذا أثنى عليك جيرانك أنك محسن فأنت محسن ، وإذا أثنى عليك جيرانك أنك مسيء فأنت مسيء ) )(@)(@@) ( ابن عساكر ) عن ابن مسعود رضي 
ms100	 الله عنه .(@)(@@)(@@)(@@) $ ( 877 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع الداعيان فأجب أقربهما بابا فإن أقربهما بابا أقربهما جوارا ، وإن سبق أحدهما فأجب الذي سبق ) )(@)(@@) ( حم د ) عن رجل له صحبة .(@)(@@)(@@)(@@) $ ( 878 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع العالم والعابد على الصراط قيل للعابد ادخل الجنة وتنعم بعبادتك ، وقيل للعالم قف هنا فاشفع لمن أحببت فإنك لا تشفع لأحد إلا شفعت ، فقام مقام الأنبياء ) )(@)(@@) ( أبو الشيخ في الثواب فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 879 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع القوم في سفر فليجمعوا نفقاتهم عند أحدهم ، فإنه أطيب لنفوسهم وأحسن لأخلاقهم ) )(@)(@@) ( الحكيم ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 880 ) قال النبي :(@)(@@) | 30 ( أذا أجمرتم الميت فاجمروه ثلاثا ) )(@)(@@) ( حم هق ) و الضياء عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 881 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم أخاه فليعلمه أنه يحبه ) )(@)(@@) ( حم PageV01P146 خد د ت حب ك ) عن المقداد بن معدي كرب ( حب ) عن أنس ( خد ) عن رجل من الصحابة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 882 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم أخاه في الله فليعلمه فإنه أبقى في الألفة ، وأثبت في المودة ) )(@)(@@) ( ابن أبي الدنيا في كتاب الإخوان ) عن مجاهد مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 883 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم أن يحدث ربه فليقرإ القرآن ) )(@)(@@) ( خط فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 884 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم صاحبه فليأته في منزله فليخبره أنه يحبه لله ) )(@)(@@) ( حم والضياء ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 885 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم عبدا فليخبره فإنه يجد مثل الذي يجد له ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 886 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا ابتلاه ليسمع تضرعه ) )(@)(@@) ( هب فر ) عن أبي هريرة ( هب ) عن ابن مسعود رضي الله عنهما وكردوس موقوفا عليهما .(@)(@@)(@@)(@@) $ ( 887 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا أغلق عليه أمور الدنيا ، وفتح له أمور الآخرة ) )(@)(@@) ( فر ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 888 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا ألصق 