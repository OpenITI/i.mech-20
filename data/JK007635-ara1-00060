ms41	 شمس الضحى % % لو كان مطلعها من الأزرار % 10(@)(@@) % فالطرف من إشراقه متردد % ما بين بدر دجى وشمس نهار % % PageV01P145 11(@)(@@) % ولرب ليل بت فيه معللا % من ريق مبسمه بكأس عقار % % 12(@)(@@) % ألهو به واللهو داعيه الصبا % % ومن الغرام تهتكي ووقاري % % 13(@)(@@) % أيام لم تلو الديون على اللوى % % سعدى ولا نأت النوى بنوار % % 14(@)(@@) % يا حبذا زمن الوصال وحبذا % % عهد الحبيب وداره من داري % % 15(@)(@@) % زمن أطعت به الصبابة والصبا % % وقضيت فيه من الهوى أوطاري % % 16(@)(@@) % أرضيت أحبابي وغظت لوائمي % % وطرحت عذري واطرحت عذاري % % 17(@)(@@) % إذ لا ربيع الوصل فيه محرم % كلا وليس خطى المنى بقصار % % 18(@)(@@) % لم أوفه حقا أحال به على % % قلبي الكئيب ومدمعي المدرار % 19(@)(@@) % قسما بمكة والحطيم وزمزم % والبيت ذي الأركان والأستار % % 20(@)(@@) % ما عن لي ذكر الحجاز وأهله % % إلا عدمت تجلدي وقراري % % PageV01P146 البحر : طويل 1(@)(@@) % سلام شهي المجتنى طيب النشر % على تلكم الأخلاق والأوجه الغر % 2(@)(@@) % سلام محب غادرته يد النوى % % يقلب في أجمير قلبا على جمر % % 3(@)(@@) % إذا عن ذكراكم له فاض جفنه % % بأدمعه فيض الغمامة بالقطر % % PageV01P147 البحر : بسيط تام 1(@)(@@) % وافتك والزهر في روض الدجى زهر % والفجر نهر على الظلماء منفجر % % 2(@)(@@) % فأقبلت هي والصبح المنير معا % حتى تحير في ضوءيهما النظر % % 3(@)(@@) % وأسفرت عن سنى وجه أبان لنا % % بدر التمام ولكن ليله الشعر % % 4(@)(@@) % غراء لولا اتضاح الفرق لاح لنا % % ما شك ذو بصير في أنها القمر % 5(@)(@@) % إن تجل غرتها فالصبح متضح % أو ترخ طرتها فالليل معتكر % 6(@)(@@) % هندية فعلت منها اللحاظ بنا % % ما ليس تفعله الهندية البتر % 7(@)(@@) % حوراء ما برحت من سحر مقلتها % % تسبي العقول بطرف زانه حور % % 8(@)(@@) % تدير من ثغرها راحا معتقة % كأنما ثغرها للراح معتصر % 9(@)(@@) % هيفاء مائسة الأعطاف ما خطرت % % الا وكان لنا من عشقها خطر % 10(@)(@@) % لم تخش ثأرا بما أردت لواحظها % % دم المحبين في شرع الهوى هدر % % PageV01P148 11(@)(@@) % كانت ليالي الهوى من مصلها غررا % حتى تناءت فأمسى دونها غرر % % 12(@)(@@) % يا ربة الحسن مهلا قد 
ms42	 أسأت بنا % % مالي على كل هذا البين مصطبر % % 13(@)(@@) % أما لقربك من وعد أسر به % % حتام لا وطن يدنو ولا وطر % 14(@)(@@) % نأيت هجرا فلا وصل ولاسبب % وبنت دارا فلا عين ولا أثر % % 15(@)(@@) % إن تعتبي لا تحيليني على قدر % ما كل هذا الجفا يجري به القدر % 16(@)(@@) % فاقضي الذي شئت من صد ومن بعد % ذنب الحبيب على الحالين مغتفر % 17(@)(@@) % كم عاذل ضل يلحوني فقلت له % % حظي هواها وحظ العاذل الحجر % 18(@)(@@) % فقال عشقك هذا كله عبث % فقلت عذلك هذا كله هذر % 19(@)(@@) % يا لائمي غير سمعي للملام فلي % % حب توازر فيه السمع والبصر % % 20(@)(@@) % إن كان لي من هواها لا بليت به % % وزر فلي من علي في العلى وزر % % PageV01P149 21(@)(@@) % الماجد الندس السامي برتبته % % أبو الحسين السري الصارم الذكر % % 22(@)(@@) % الموسوي الذي واست مكارمه % % عفاته وهمى من كفه المطر % 23(@)(@@) % مهذب نال من أسنى العلى رتبا % قد رامها قبله قوم فما قدروا % % 24(@)(@@) % فضم شمل المعالي يافعا وحوى % % من المحامد ما لم يحوه بشر % 25(@)(@@) % إن ساد آباؤه قدما فبينهما % % فرق كما افترق الأشجار والثمر % % 26(@)(@@) % يولي الجزيل ولا يمنن بكثرته % % ويوسع الضيف قلوا وإن كثروا % % 27(@)(@@) % إسمع مدائحه وانظر إليه تجد % % وصفا تطابق فيه الخبر والخبر % % 28(@)(@@) % ما رام حصر معاليه أخو لسن % إلا اعترى نطقه من دونها حصر % 29(@)(@@) % وما عسى يبلغ المطرى مديح فتى % مطول المدح في علياه مختصر % 30(@)(@@) % ما مهديا لي نظما خلته دررا % يشنف السمع لا بل دونها الدرر % % PageV01P150 31(@)(@@) % قلدتني مننا لا أستطيع لها % % شكرا ولو ساعدتني البدو الحضر % % 32(@)(@@) % فخذ إليك عروسا بت أنظمها % % ليلا فيحسد ليلي عندها السحر % % 33(@)(@@) % تثني عليك كما أثنى لشكر يد % على الحيا من رياض نشرها العطر % % 34(@)(@@) % ولا برحت مدى الأيام في دعة % يمدك المسعدان السعد والعمر % PageV01P151 البحر : بسيط تام 1(@)(@@) % ألية بانعطاف القامة النضرة % % ونظرة لاختطاف العقل منتظره % % 2(@)(@@) % وغرة كضياء الصبح مشرقة % وطرة كظلام الليل معتكره % % 3(@)(@@) % ما مال قلبي المعنى بعد 
ms43	 فرقتها % % عنها لمعرفة كلا ولا نكره % % 4(@)(@@) % ظنت سلوي فراحت وهي عاتبة % ولو درت لأتتني وهي معتذره % % 5(@)(@@) % إن تعتبن فلها العتبى وإن نقمت % % مني على غي ذنب فهي مقتدرة % % 6(@)(@@) % أما وعهد الهوى ما ساءها خلقي % % ولا تنمرت من أخلاقها النمره % % 7(@)(@@) % لكن كتمت عن الواشين بي وبها % % محبة هي في الأحشاء مستتره % % 8(@)(@@) % فأرجفوا أنني سال وما علموا % % بأن نار الهوى في القلب مستعره % % 9(@)(@@) % هيهات أين من السلوان مكتئب % قد مله ليله من طول ما سهره % % 10(@)(@@) % أنفاسه بزفير الشوق صاعدة % لكن أدمعه بالوجد منحدرة % % PageV01P152 11(@)(@@) % آه لأيام وصل بالحمى سلفت % % إذ كنت من طيبها في جنة خضره % % 12(@)(@@) % أيام لا صفو عيشي بالنوى كدر % ولا نجوم سماء الوصل منكدره % % 13(@)(@@) % حيث الصبابة باللذات آمرة % والنفس طوعا لما تهواه مؤتمره % % 14(@)(@@) % ما عن لي ذكرها في كل آونة % إلا ولي كبد بالوجد منفطره % % 15(@)(@@) % ولا تذكرت ذاك الشمل مجتمعا % إلا استهلت دموعي وهي منتثره % % 16(@)(@@) % وما على دون هذا الخطب مصطبر % لكن نفسي على الحالات مصطبره % % 17(@)(@@) % بالله يا صاحبي قل للصبا سحرا % إذا أتت وهي من أنفاسها عطره % % 18(@)(@@) % هل عهد سعدى كما قد كان أم خفرت % % عهد الأحبة تلك الغادة الخفره % % 19(@)(@@) % وهل تراها بطيب الوصل جابرة % منا قلوبا بطول الهجر منكسره % % 20(@)(@@) % أما كفى البين - لا دارت دوائره - % نوى الحباب وتلك الخطة الخطره % % PageV01P153 21(@)(@@) % حتى قضى بنوى الأحباب كلهم % فلم أزل بعدهم في عيشة كدره % % 22(@)(@@) % إخوان صدق كأن الله أطلعهم % كواكبا في سماء المجد مزدهره % % 23(@)(@@) % منهم حسين أدام الله بهجته % % وصانه ربه عن كل ما حذره % % 24(@)(@@) % الهاشمي الذي جلت مكارمه % % عن كل حصر فراحت غير منحصره % % 25(@)(@@) % والحاتمي الذي أضحت عوارفه % % لمغتفى نيله كالسحب منهمره % % 26(@)(@@) % جنابه كعبة للفضل ما برحت % لها الوفود من الآفاق معتمره % % 27(@)(@@) % وكفه كم كفت باليسر إذ وكفت % % بمستهل الندى ذا عسرة عسره % % 28(@)(@@) % قرت به أعين الراجين حين رأت % % من راحتيه عيون الجود منفجره % % 29 
ms44	(@)(@@) % هو الهمام الذي أعلته همته % مراتبا لذرا الأفلاك محتقره % % 30(@)(@@) % وهو النسيب الذي يروي مناقبه % عن نسبة بصميم المجد مشتهره % % PageV01P154 31(@)(@@) % لو شاهدت فخره الزاكي عشيرته % % أضحت على جملة الأسلاف مفتخره % % 32(@)(@@) % له خلائق لو مر النسيم بها % % أغنته عن نفحات الروضة النضرة % % 33(@)(@@) % إذا تأملت الأبصار رتبته % % أو البصائر عادت وهي منبهره % % 34(@)(@@) % ما أطنبت فكرتي في نعت شيمته % % 35(@)(@@) % يا سيدا لم تزل طول المدى مقتي % % عليه دون جميع الخلق مقتصره % % 36(@)(@@) % وافت قصيدتك الغراء حاسرة % للعتب وجها وبالإحسان معتجره % % 37(@)(@@) % فقلت أهلا بها شكرا لمنشئها % % بكرا أتت لجميل العتب مبتكره % % 38(@)(@@) % أوردتها حين جاءت تشتكي ظمأ % % مني مناهل ود عذبة خصره % % 39(@)(@@) % فلم أر العذر إلا الاعتراف بما % % عدته ذنبا فكن لا زلت مغتفره % % 40(@)(@@) % أما الوداد لا والله ما برحت % % راياته في صميم القلب منتشره % % PageV01P155 41(@)(@@) % حاشا لمثلي في دعوى محبته % % أن يبخس الود من يهواه أو يتره % % 42(@)(@@) % فكن على ثقة مني فلست ترى % % إلا عهود وداد غير منبتره % % 43(@)(@@) % وخذ إليك عروسا حليها درر % لها نحور الغواني الغيد مفتقره % % 44(@)(@@) % مذ التزمت بها كسر الروي غدت % % بالانكسار على الحساد منتصره % % 45(@)(@@) % واسلم ودم راقيا في عزة رتبا % من دونها أنفس الأعداء منقهره % % PageV01P156 البحر : مجزوء الكامل 1(@)(@@) % أدر المدامة بالكبير % % فالوقت ضاق عن الصغير % 2(@)(@@) % واستجلها في كأسها . . . . % كالشمس في البدر المنير % 3(@)(@@) % نزلت من الفلك المدار % تلوح في كف المدير % % 4(@)(@@) % لولا شباك حبابها % % كادت تطير من السرور % % 5(@)(@@) % بكر تتيح لك المسرة % % في المساء وفي البكور % 6(@)(@@) % صدرت بأنس ورودها % % خيل الهموم من الصدور % 7(@)(@@) % تعشي العيون إذا انجلت % % بالضوء من نار ونور % 8(@)(@@) % ذهبية لهبية % عصرت بأحقاب العصور % % 9(@)(@@) % وافت بسورة نشوة % ذهبت بألباب الحضور % 10(@)(@@) % يسقيكها ساق أغر % يميس كالظبي الغرير % PageV01P157 11(@)(@@) % ويريك من إشراقه % % قمرا على غصن نضير % % 12(@)(@@) % يرتاح من مرح الصبا % % ويتيه من فرط الغرور % % 13(@)(@@) % نشوان يمزج أنسه % % عند التكلم بالنفور % % 14(@)(@@) % يرنو إليك بمقلة % وسنى الجفون 
ms45	 من الفتور % 15(@)(@@) % لو قيل من سلب النهى % % لم تعده كف المشير % 16(@)(@@) % تثني الرياح غصونها % % ثني المعاطف والخصور % 17(@)(@@) % % والزهر مفتر الثغور % % 18(@)(@@) % قد غردت فيها المثاني % % قبل تغريد الطيور % % 19(@)(@@) % ولرب ليل بته % % بين النحور إلى السحور % % 20(@)(@@) % من غانيات كالرباب % % قاصرات الطرف حور % PageV01P158 21(@)(@@) % طلعت به كأس المدامة % % مطلع الشعرى العبور % % 22(@)(@@) % والبدر في كبد السماء % % كسابح وسط الغدير % 23(@)(@@) % وسنى المجرة في الدجى % % كالنهر ما بين الزهور % 24(@)(@@) % والليل شمر للسرى % % والصبح آذن بالسفور % % 27(@)(@@) % من كل أروع ماجد % عف الشبيبة والضمير % 29(@)(@@) % فالراح في لهواته % % كالشمس تغرب في ثبير % 30(@)(@@) % كانت ليالي عهدهم % % غرر الليالي والشهور % % 31(@)(@@) % خلان صدق إن عرا % % خطب بمكروه الأمور % % 32(@)(@@) % ذهبوا فأخلفت الليالي % % عنهم خلان زور % % 33(@)(@@) % لم يبق لي خل يتم % بأنس صحبته سروري % % PageV01P159 34(@)(@@) % إلا حسين عين أعيان % العلى صدر الصدور % % 35(@)(@@) % السيد الشهم الهمام % الفرد مفقود النظير % % 36(@)(@@) % فخر المفاخر والمآثر % % والأعاصير والدهور % % 37(@)(@@) % نافت مآثره العلى % % شرفا على الفلك الأثيري % % 38(@)(@@) % وزها به دست الوزارة % % منذ لقب بالوزير % % 39(@)(@@) % وعنا لمفخره المؤثل % كل مختال فخور % % 40(@)(@@) % لو جسمت أخلاقه % % أغنتك عن نور البدور % % 41(@)(@@) % في كفه كف العدى % % وبفكه فك الأسير % 42(@)(@@) % كم صاغ من منن له % % أضحت قلائد للنحور % % 43(@)(@@) % وأبان من عزم أباد % % عزائم الليث الهصور % PageV01P160 44(@)(@@) % أغناه عن مدح الورى % % ما حاز من مجد شهير % 45(@)(@@) % طالت بيوت جدوده % % وهم ذوو النسب القصير % 46(@)(@@) % قوم بنوا شرف العلى % % بين الخورنق والسدير % % 47(@)(@@) % وردوا الفرات فأخجلوه % % ببحر جودهم الغزير % 48(@)(@@) % قل للمكاثر مجدهم % % أين القليل من الكثير % % 49(@)(@@) % سلم لجيران الوصي % وسر سبيل المستجير % 50(@)(@@) % فهم هداة أولي الضلال % % وهم ضياء المستنير % 51(@)(@@) % يا سيدا كلماته % % شرف المهارق والسطور % % 52(@)(@@) % لله درك من خطيب % شاعر ندب خطير % 53(@)(@@) % أهديت لي درر الكلام % % فخلتها درر النحور % % PageV01P161 54(@)(@@) % أبيات سعر كالقصور % % وليس فيها من قصور % 55(@)(@@) % ما حاز رقة لفظها % % شعر الفرزدق أو جرير % 56(@)(@@) % بل 
ms46	 لا مقامات البديع % % ولا مقامات الحريري % % 57(@)(@@) % وافت كما وافى النسيم % بطيب أنفاس العبير % % 58(@)(@@) % وشفت فؤادا لم يزل % من حر شوقك في سعير % % 59(@)(@@) % فوردت من سلسالها % % أحلى من العذب النمير % % 60(@)(@@) % وإليكها منظومة % وافتك من فكر حسير % 61(@)(@@) % نظمتها نظم العقود % وصغتها صوغ الشذور % 63(@)(@@) % واسلم ودم في نعمة % غراء في دار السرور % 64(@)(@@) % ما لاح طيف في الكرى % % أو ناح طير في الوكور % PageV01P162 البحر : كامل تام 1(@)(@@) % شق الدجى عن نحره الفجر % وبدت عليه غلائل خضر % 2(@)(@@) % وافتر يبسم عن تبلجه % ضوء الصباح كأنه ثغر % % 3(@)(@@) % والشمس قد نهضت لمشرقها % % فانهض بشمسك أيها البدر % % 4(@)(@@) % واشفع بها شمس الصباح وإن % أضحت وبدء شروقها العصر % % 5(@)(@@) % واستضحك الدهر العبوس بها % % فبمثلها يستضحك الدهر % % 6(@)(@@) % واستجلها بكرا معتقة % تصبو إليها العاتق البكر % 7(@)(@@) % حمراء تسطع في زجاجتها % % فكأنها لو لم تذب جمر % 8(@)(@@) % وكأنما إبريقها سحرا % إذ قهقهت لحمامه وكر % 9(@)(@@) % جليت على خطابها فحكت % % عذراء ما عن وصلها عذر % 10(@)(@@) % يسعى بها ساق لواحظه % % سكرى وصفو رضابه خمر % % PageV01P163 11(@)(@@) % حلو الهوى عذب مقبله % % لكن مذاق مطاله مر % % 12(@)(@@) % أو غادة رؤد غدائرها % % ليل وضوء جبينها فجر % % 13(@)(@@) % هيفاء لولا عقد منطقها % % لم يستقل بردفها الخصر % 14(@)(@@) % خرعوبة جم محاسنها % % لكنما إحسانها نزر % % 15(@)(@@) % في روضة وشى الربيع لها % % حللا فطرز وشيها القطر % % 16(@)(@@) % والبرق شق بمرجها طربا % جيب الحيا فتبسم الزهر % % 17(@)(@@) % وشدت بها الورقاء مطربة % فتمايست أغصانها الخضر % 18(@)(@@) % واها لمجلسنا وقد جمعت % % فيه المنى وتهتك الستر % 19(@)(@@) % إبريقنا ذهب وخمرته % % ياقوتة وحبابها در % 20(@)(@@) % وليومنا وسقاة أكؤسنا % % صبح أغر وأوجه غر % % PageV01P164 21(@)(@@) % دعت المدام إلى الصبوح به % % من ليس يثقل سمعه وقر % 22(@)(@@) % إن لم يطب سكر لشاربها % % فمتى يطيب لشارب سكر % 23(@)(@@) % فاشرب ولا تقل الزمان قضى % % أن لا يفوز بلذة حر % % 24(@)(@@) % شمل الزمان ندى أبي حسن % فصفا وزال بيسره العسر % % 25(@)(@@) % وسرت تهلل من أنامله % لبني الرجاء سحائب عشر % % 26(@)(@@) % سحب ولكن ودق 
ms47	 صيبها % % تبر ولمع وميضها بشر % 27(@)(@@) % فالخلق من يمنى يديه لهم % % يمن ومن يسراهما يسر % % 28(@)(@@) % وحكت عوارفه معارفه % % فتدفقا فكلاهما بحر % % 29(@)(@@) % بحر ولكن لج نائله % % ما رد سائل فيضه نهر % % 30(@)(@@) % برت باخلاص سريرته % % فهو التقي المخلص البر % % PageV01P165 31(@)(@@) % أسمع به وانظر إليه تجد % خبرا يحقق صدقه الخبر % % 32(@)(@@) % ذو همة كادت لعزمتها % % صم الصخور يذيبها الذعر % % 33(@)(@@) % لو رام يصطاد النجوم بها % % لم يأو وكر سمائه النسر % % 34(@)(@@) % من دوحة سقيت أرومتها % % ماء العلى ونما بها الفخر % % 35(@)(@@) % فتهدلت أغصانها كرما % زكت الفروع وأنجب العتر % 36(@)(@@) % يا أيها البدء الذي شكرت % % جدوى يديه البدو والحضر % 37(@)(@@) % شعري بمدحك لا أضن به % % فلمثل مدحك ينظم الشعر % % 38(@)(@@) % وإليهكا عقدا مفصلة % % لم يحل قط بمثلها نحر % % 39(@)(@@) % وافت مهنئة بمرتبة % بك قد سما لمقامها قدر % 40(@)(@@) % واسلم مدى الأيام مرتقيا % رتبا يضيق لعدها الحصر % % PageV01P166 البحر : بسيط تام 1(@)(@@) % أليلة الحشر لا بل يوم عاشور % % ونفخة الصور لا بل نفث مصدور % % 2(@)(@@) % يوم به اهتز عرش الله من حزن % على دم لرسول الله مهدور % 3(@)(@@) % يوم به كسفت شمس العلى أسفا % وأصبح الدين فيه كاسف النور % % 4(@)(@@) % يوم به ذهبت أبناء فاطمة % للبين ما بين مقتول ومأسور % % 5(@)(@@) % فأي دمع عليه غير منهمل % وأي قلب عليه غير مفطور % % 6(@)(@@) % ولوعة لا تزال الدهر مسعرة % بين الجوانح نارا ذات تسعير % 7(@)(@@) % لرزء أبلج في صماء ساحته كذا % % من نبعة المجد والغر المشاهير % % 8(@)(@@) % مولى قضى الله تنويها بإمرته % % فراح يقضي عليه كل مأمور % 9(@)(@@) % لله ملقى على البوغاء مطرحا % كاس من الحمد عار غير مستور % % 10(@)(@@) % قضى على ظمأ ما بل غلته % % إلا بكل أبل الحد مأثور % % PageV01P167 11(@)(@@) % يا وقعة الطف خلدت القلوب أسى % كأنما كل يوم يوم عاشور % 12(@)(@@) % يا وقعة الطف أبكيت الجفون دما % ورعت كل فؤاد غير مذعور % % 13(@)(@@) % يا وقعة الطف كم أضرمت نار جوى % في كل قلب من الأحزان مسجور % % 14(@)(@@) % يا وقعة الطف كم أخفيت 
ms48	 من قمر % وكم غمرت أبيا غير مغمور % 15(@)(@@) % يا وقعة الطف هل تدرين أي فتى % أوقعته رهن تعقير وتعفير % % 16(@)(@@) % يا وقعة الطف هل تدرين أي دم % أرقته بين خلف القوم والزور % % 17(@)(@@) % لا كان يومك في الأيام إن له % % في كل قلب لجرحا غير مسبور % % 18(@)(@@) % كم من فتى فيك صبح المجد غرته % % أضحى يحكم فيه كل مغرور % % 19(@)(@@) % وكم رؤوس وأجسام هنالك قد % % أصبحن ما بين مرفوع ومجرور % 20(@)(@@) % لهفي عليهم وقد شالت نعامتهم % % وأوطنوا ربع قفر غير معمور % % PageV01P168 21(@)(@@) % فقل لمن رام صبرا عن رزيتهم % % إليك عني فما صبري بمقدور % 22(@)(@@) % أيذخر الحزن عن أبناء فاطمة % يوما وهل منهم أولى بمذخور % 23(@)(@@) % مهما نسيت فلا أنسى الحسين لقى % تحنو عليه ربى الآكام والقور % % 24(@)(@@) % معفرا في موامي البيد منجدلا % يزوره الوحش من سيد ويعفور % 25(@)(@@) % تبكي عليه السماوات العلى حزنا % والأرض تكسوه ثوبا غير مزرور % 26(@)(@@) % يا حسرة لغريب الدار مضطهد % يلقى العدى بعديد منه مكثور % 27(@)(@@) % يحمي الوطيس متى وافاه منتصرا % عليهم بخميس غير منصور % % 28(@)(@@) % حتى إذا لم يكن من دونه وزر % شفى الضغائن منه كل موزور % % 29(@)(@@) % فأين عين رسول الله ترمقه % % لقى على جانب للبين مهجور % % 30(@)(@@) % وأين عين علي منه تلحظه % % مقهور كل شقي الجد مقهور % PageV01P169 31(@)(@@) % وأين فاطمة الزهراء تنظره % % وأهله بين مذبوح ومنحور % % 32(@)(@@) % يا غيرة الله والأملاك قاطبة % لفادح من خطوب الدهر منكور % % 33(@)(@@) % تسبى بنات رسول الله حاسرة % كأنهن سبايا قوم سابور % % 34(@)(@@) % من كل طاهرة الأذيال ظاهرة % ترمي العدى بعيون نحوها صور % % 35(@)(@@) % من الفواطم في الأغلال خاشعة % يحدى بهن على الأقتاب والكور % % 36(@)(@@) % ينعين يا جد نال القوم وترهم % % منا وأوقع فينا كل محذور % % 37(@)(@@) % يا جد صال الأعادي في بنيك وقد % % ثوى الحسين ثلاثا غير مقبور % % 38(@)(@@) % وأودع الرأس منه رأس عالية % % وأوطيء الجسم منه كل محضير % % 39(@)(@@) % هذا الحسين قتيلا رهن مصرعه % % يبكي له كل تهليل وتكبير % % 40(@)(@@) % هذا الحسين ثوى بالطف منفردا % تسفي 
ms49	 عليه سوافي الترب والمور % % PageV01P170 41(@)(@@) % هذي بناتك للأشهاد بارزة % يشهرن بين الأعادي أي تشهير % % 42(@)(@@) % آه لرزئكم في الدهر من خبر % باق على صفحات الدهر مسطور % % 43(@)(@@) % تبت يد ابن زياد من غوي هوى % ومارق في غمار الكفر مغمور % 44(@)(@@) % أرضى يزيد بسخط الله مجترئا % وبر منه زنيما غير مبرور % % 45(@)(@@) % فهل ترى حيم أم الغي كان رأى % % دم الحسين عليه غير محظور % % 46(@)(@@) % أتيت يا ابن زياد كل فادحة % بوئت منها بسعي غير مشكور % 47(@)(@@) % بني أمية هبوا لا أبالكم % فطالب الوتر منكم غير موتور % % 48(@)(@@) % نسيتم أم تناسيتم جنايتكم % % فتلك والله ذنب غير مغفور % 49(@)(@@) % خاصمتم الله في أبناء خيرته % % هل يخصم الله الا كل مدحور % 50(@)(@@) % ورعتم بالردى قلب ابن فاطمة % % وما رعيتم ذماما جد مخفور % % PageV01P171 51(@)(@@) % أبكيتم جفن خير المرسلين دما % ورحتم بين مغبوط ومسرور % % 52(@)(@@) % اليكم يا بني الزهراء مرثية % أصاح سمعا إليها كل موقور % 53(@)(@@) % تجدد الحزن بالبيت العتيق بكم % % ويحطم الوجد منها جانب الطور % % 54(@)(@@) % عليكم صلوات الله ما هطلت % % سحب وشق وميض قلب ديجور % % PageV01P172 البحر : - 1(@)(@@) % زهر الدراري أم نظام الجوهر % % وشذا السلافة أم شميم العبهر % 2(@)(@@) % أم زهر روض قد تبسم ضاحكا % إذ جاده صوب الغمام الممطر % % 3(@)(@@) % وشذور تبر أم جمان قلائد % تزهو وتزهر في مقلد جؤذر % % 4(@)(@@) % أم هذه ألفاظ مولى ماجد % ورث البلاغة أكبرا عن أكبر % 5(@)(@@) % يزري بنظم الدر باهر نظمه % % ويفوق مسكره مذاب السكر % % 6(@)(@@) % فلشعره الشعري العبور تضاءلت % % كرها وودت أنه لم يشعر % % 7(@)(@@) % والنثرة العليا هوت من نثره % % خجلا وقالت ليته لم ينثر % % 8(@)(@@) % قد أعجز البلغاء معجز أحمد % فأقر كلهم بعجز مقصر % % 9(@)(@@) % يا مهديا لي من سني نظامه % % ونثاره درا بهي المنظر % 10(@)(@@) % شكرا لفضلك شكر ممنون فقد % % حليت جيدي من عقود الجوهر % PageV01P173 البحر : طويل 1(@)(@@) % أما وابتسام الروض عن شنب الزهر % % وإسفار وجه الأفق عن غرة الفجر % % 2(@)(@@) % ونشر الخزامى في طي نسمة % سرت من ربى سلع وطيبة والحجر % % 3(@)(@@) % وبرق 
ms50	 سرى ليلا بأكناف حاجر % فجدد لي شوقا إلى بارق الثغر % 4(@)(@@) % وسجع حمام الأيك في عذباتها % % تميس بها الأغصان في حلل خضر % 5(@)(@@) % لقد هاج وجدي ذكر آرام رامة % وأورى بقلبي ناره لاعج الذكر % 6(@)(@@) % فبت بقلب كلما ناح طائر % تطاير من أنفاسه شرر الجمر % % 7(@)(@@) % وعبرة عين لا تجف جفونها % % إذا هتفت أيكية أقبلت تجري % % 8(@)(@@) % أراعي دجى لا يستحيل ظلامها % % وأنجم ليل لا تسير ولا تسري % % 9(@)(@@) % وأصبو إلى عصر تقضى بحاجر % فيا حاجرا سقيا لعصرك من عصر % 10(@)(@@) % إذ العيش غض والأبيبة نضرة % أميس بها كالغصن في الورق النضر % PageV01P174 11(@)(@@) % ليالي لا أرضى من الوصل بالمنى % % ولا أتحسى أكؤس الهم بالصبر % PageV01P175 البحر : وافر تام 1(@)(@@) % أشارت من لها في الحسن شاره % % فأفهمت الضمير من الإشارة % % 2(@)(@@) % وبشر طيفها بالوصل ليلا % ووافاني يقول لك البشارة % % 3(@)(@@) % مهفهفة القوام إذا تثنت % ثنت قدا تفرد بالنضارة % % 4(@)(@@) % لها خد تسعر جل ناري % % به لما أراني جلناره % % 5(@)(@@) % توق أخا الغرام رضاب فيها % % فكم شقت حلاوتها مراره % % 6(@)(@@) % وكم غرت بماضي مقلتيها % % معنى حكمت فيه غراره % % 7(@)(@@) % وشبهت الحسام به مضاء % فغار فشن في العشاق غاره % % 8(@)(@@) % جرى ماء النعيم بوجنتيها % % فزاحمه الجحيم فشب ناره % % 9(@)(@@) % تريك إذا بدت وهنا محيا % يحاكي ليله ضوءا نهاره % % 10(@)(@@) % ولولا أنه قمر تجلى % % لما دار الخمار عليه داره % % PageV01P176 11(@)(@@) % وتبدي حالتي وصل وصد % فتحيي تارة وتميت تاره % % 12(@)(@@) % سكرت بحبها من قبل سكري % % وما عاقرت من دن عقاره % % 13(@)(@@) % وقالوا حبها نار تلظى % % لقد قاسوا وما قاسوا أواره % % 14(@)(@@) % فأين النار منه ومن لظاه % وليس النار منه سوى شراره % % 15(@)(@@) % وكم عاصيت فيها من نصوح % أقال الله من نصحي عثاره % % 16(@)(@@) % رأى هجري ولم يعلم لجهل % بأن الهجر عقباه الزياره % % 17(@)(@@) % وقاسمت العذول على هواها % % فكان الربح لي وله الخساره % % PageV01P177 البحر : خفيف تام 1(@)(@@) % اسقياني على اقتراح العذارى % % واعذراني فقد خلعت العذارا % % 2(@)(@@) % شمس اح من كف خود رداح % شخصت فيهما العيون حيارى % % 3 
ms51	(@)(@@) % أشرقت في الكؤوس نارا وقدما % لا وعينيك لست ممن يباري % % 4(@)(@@) % واجلواها والدهر طلق المحيا % % والقماري تنادم الأقمارا % % 5(@)(@@) % في عذارى كأنهن رياض % ورياض كأنهن عذارى % % 6(@)(@@) % لا تلوما فما التصابي بعار % قبل يسترجع الصبا ما أعارا % % 7(@)(@@) % ودعاني مجاهدا في غرامي % % إن داعي الهوى دعاني جهارا % % 8(@)(@@) % أمعير الظبى شبا وغرارا % % لحظه والظبا رنا واحورارا % % 9(@)(@@) % ما لقلبي يزيد فيك غراما % كلما زدت عن هواه نفارا % % 10(@)(@@) % أي قلب ما هام فيك ولكن % % زاد قلبي بحبك استهتارا % % PageV01P178 11(@)(@@) % خاطرت في هواك مهجة صب % هويت منك ذابلا خطارا % % 12(@)(@@) % من يباريك يا منى النفس حسنا % % 13(@)(@@) % رب ليل قصرته بلقاه % % وليالي الهنا تكون قصارا % % 14(@)(@@) % رضته بالمدام حتى إذا ما % % تركته لا يستبد اختيارا % % 15(@)(@@) % نلت ما شئت من هواه ولولا % % عفة الحب لارتكبت العارا % % 16(@)(@@) % يا خليلي عج بالنقا لنقضي % % للهوى في ربوعه أوطارا % % 17(@)(@@) % إن بين النقا وبين المصلى % % ظبيات لها الأسود غيارى % % 18(@)(@@) % نتمارى إن لحن هل هن غيد % أم ظباء في حسنها لا يمارى % % 19(@)(@@) % هي لولم تكن ظبا وبدورا % ما صدعن الدجى وجبن القفارا % % 20(@)(@@) % لحن للركب والعقول حيارى % % فاختطفن العقول والأبصارا % % PageV01P179 21(@)(@@) % وأرقن الدماء طعنا وقتلا % وأمن الجزا قصاصا وثارا % % 22(@)(@@) % يا لقومي أيذهب اليوم في الحب % دمي باطلا وجرحي جبارا % % PageV01P180 البحر : متقارب تام 1(@)(@@) % تجلي صباحا وميطي الخمارا % % فما تطلع الشمس إلا نهارا % % 2(@)(@@) % وحاشا محياك أنى أقيس % % به البدر والبدر يخفى سرارا % % 3(@)(@@) % مريت الجفون وهجت الشجون % فحسبك ألفت ماء ونارا % % 4(@)(@@) % أفي الحق أصفيك محض الوداد % وأنت تصدين عني ازورارا % % 5(@)(@@) % تبيتين وسنى وجفني القريح % لا يطعم النوم إلا غرارا % % 6(@)(@@) % أما والمحلين والمحرمين % ومن طاف بالبيت سبعا وزارا % % 7(@)(@@) % لأنت التي بات قلبي لها % % مشوقا وعقلي بها مستطارا % % 8(@)(@@) % ولو أن ما بي بيذبل ذاب % % وبالبدر غاب وبالبحر غارا % % 9(@)(@@) % ولولاك ما همت وجدا ولا % % خلعت لحب العذارى العذارا % % 10(@)(@@) % ولم أنس أيامنا في منى % وموقفنا حيث نرمي الجمارا % % PageV01P181 11 
ms52	(@)(@@) % عشية قالت لأترابها % % أهذا الذي جن فينا وحارا % % 12(@)(@@) % نعم أنا ذاك فما تأمرين % % أقتلا يراح به أم إسارا % % PageV01P182 البحر : طويل 1(@)(@@) % أحباي لي في كل يوم وليلة % بذكراكم نار من الشوق تسعر % 2(@)(@@) % إذا ما رأيت الصبح والبدر طالع % ذكرتكم والشيء بالشيء يذكر % % 3(@)(@@) % فيا حسرتا كم لي على البعد والنوى % % حنين ووجد دائم وتحسر % 4(@)(@@) % يلومونني أن همت وجدا بحبكم % % كأن هيامي في المحبة منكر % % 5(@)(@@) % ولو كابدوا وجد الصبابة أيقنوا % % بأني على فرط الكآبة أعذر % 6(@)(@@) % ألام على مالا أطيق وإنما % % يلام الفتى فيما يطيق ويقدر % % 7(@)(@@) % إذا قلت للقلب اصطبر لفراقهم % % فإن جميل الصبر بالحر أجدر % 8(@)(@@) % يقول استعر قلبا سواي وقل له % % ليصبر فإني عنهم لست أصبر % PageV01P183 البحر : مجزوء الوافر 1(@)(@@) % بدا والليل معتكر % كأن نجومه درر % % 2(@)(@@) % رشا رقت محاسنه % % فكاد يذيبه النظر % 3(@)(@@) % كثيب فوقه غصن % وغصن فوقه قمر % % 4(@)(@@) % سمرت به إلى سحر % وليلي كله سحر % % 5(@)(@@) % إذا ما ماس يخطر في % % حلاه فعشقه خطر % % 6(@)(@@) % ليالي وصله غرر % ولكن دونها غرر % 7(@)(@@) % ختمت بحبه وطري % % فمالي غيره وطر % % PageV01P184 البحر : طويل 1(@)(@@) % سلا دارها أن أنبأ الطلل القفر % أجاد فرواها سوى أدمعي قطر % 2(@)(@@) % وهل أوقد السارون نارا بأرضها % % فكان لها الا لظى كبدي جمر % 3(@)(@@) % وما شغفي بالدار أبكي رسومها % % وأندبها لولا الصبابة والذكر % % 4(@)(@@) % ذكرت بها أيام جمل وعهدها % % جميل وفنيان الصبا مونق نضر % 5(@)(@@) % إذ العيش صفو والحبائب جيرة % وروض الهوى غض حدائقه خضر % % 6(@)(@@) % أميس ارتياحا في بلهنية الصبا % % تعانقني شمس ويلثمني بدر % 7(@)(@@) % وغيداء من عليا لؤي بن غالب % حمتها المواضي والمثقفة السمر % % 8(@)(@@) % وأقسم لو لم تحمها البيض والقنا % % لأغنى غناها الخنزوانة والكبر % % 9(@)(@@) % هي الظبية الأدماء لولا قوامها % % وشمس الضحى لولا المباسم والثغر % 10(@)(@@) % تطاول زهر الأفق أزهار نعتها % % ويستنزل الشعرى لأوصافها الشعر % PageV01P185 11(@)(@@) % أطعت هواها ما استطعت ولم يكن % % لغير الهوى نهي علي ولا أمر % 12(@)(@@) % لقد ضل مشغوف الفؤاد بغادة % معد ابن عدنان 
ms53	 ابن أد لها نجر % % 13(@)(@@) % إذا نثرت يوما كنانة ناظر % لعاشقها ثارت كنانة والنضر % % 14(@)(@@) % يغارون أن يهوى فتاهم فتاتهم % % وهل في هوى خل لخلته نكر % 15(@)(@@) % وما ضرهم لو لف شملي بشملها % % وقد لفت الأعراق ما بيننا فهر % % 16(@)(@@) % إلى الله من حبي فتاة منيعة % وفائي لها ما بين أقوامها غدر % 17(@)(@@) % تطل دماء العاشقين لعلمها % % بأن دماء العاشقين لها هدر % 18(@)(@@) % كأن لها وترا على كل عاشق % وقد أقسمت أن لا ينام لها وتر % 19(@)(@@) % أعاذل مهلا غير سمعي للائم % فقد ظهر المكنون واتضح العذر % % 20(@)(@@) % لعمري لقد حاولت نصحي وإنما % % بسمعي عما أنت مسمعه وقر % % PageV01P186 21(@)(@@) % وقبلك لام اللائمون فلم يكن % % لهم عند أهل العشق حمد ولا أجر % 22(@)(@@) % ومن قبل ما لج المحبون في الهوى % % وما جهلوا أن الهوى مركب وعر % % 23(@)(@@) % وأمسوا يرومون الوصال فأصبحوا % % وأيديهم مما يرومونه صفر % % 24(@)(@@) % وما نكر العشاق هجرا ولا قلى % فما طاب وصل قط لو لم يكن هجر % 25(@)(@@) % وإني على ما بي من الوجد والأسى % % لذو مرة لا يستفزني الدهر % 26(@)(@@) % أرى الصبر مثل الشهد طعما إذا عرت % % ملماته والصبر مثل اسمه صبر % % 27(@)(@@) % وإني من القوم الألى شيدوا العلى % % إذا نقموا ضروا وإن نعموا بروا % % 28(@)(@@) % وإن وعدوا أوفوا وإن أوعدوا عفوا % % وإن غضبوا ساؤا وإن حلموا سروا % % 29(@)(@@) % هم سادة الدنيا وساسة أهلها % % وهم غرر العليا وانجمها الزهر % 30(@)(@@) % بنو هاشم رهط النبي محمد % به لهم دون الورى وجب الفخر % PageV01P187 31(@)(@@) % هم أصله الزاكي ومحتده الذي % % زكا فزكا فرع له وذكا نشر % 32(@)(@@) % وهل ينبت الخطي إلا وشيجه % % ويطلع إلا في حدائقه الزهر % % 33(@)(@@) % ألا أيها الساعي ليدرك شأوهم % % رويدك لا تجهد فقد قضي الأمر % 34(@)(@@) % وإن كنت في شك مريب فسل بهم % % خبيرا فعنهم صدق الخبر الخبر % 35(@)(@@) % وقد ينكر الصبح المنير أخو عمى % وإلا فما بالصبح عن ناظر ستر % 36(@)(@@) % إذا عد منهم أحمد وابن عمه % % وعماه وابناه وبضعته الطهر % % 37(@)(@@) % وعترته الغر الهداة 
ms54	 ومن لهم % % مناقب لا تفنى وإن فني الدهر % % 38(@)(@@) % فقد أحرزوا دون الأنام مفاخرا % تضيق لأدناها البسيطة والبحر % 39(@)(@@) % أولئك آبائي فجئني بمثلهم % % إذا جمع الأقيال أندية زهر % 40(@)(@@) % عليهم صلاة الله ما ذر شارق % وما لاح في الآفاق من نورهم فجر % % PageV01P188 البحر : بسيط تام 1(@)(@@) % أما ترى الصبح قد لاحت بشائره % وصبحتك من الساقي أشائره % % 2(@)(@@) % والليل قد جنحت للغرب أنجمه % % كما تساقط من روض أزاهره % 3(@)(@@) % والطير قام خطيبا في حدائقه % % فهز عطفيه واهتزت منابره % % 4(@)(@@) % والورد عطر أذيال الصبا سحرا % لما تأرج في الأكمام عاطره % % 5(@)(@@) % فانهض إلى شمس راح من يدي قمر % يديرها وهو ساجي الطرف ساحره % % 6(@)(@@) % تغنيك عن فلق الإصباح غرته % % وعن دجى الليلة الليلا غدائره % % 7(@)(@@) % كأنه حين ينثني غصن قامته % % شدت على نقوى رمل مآزره % % 8(@)(@@) % لو باهت الشمس منه الوجه لانبهرت % % من نوره وهو باهي الحسن باهره % 9(@)(@@) % يجلو الكؤوس فلا يدرى أخمرته % % تسبي عقول الندامى أم محاجره % % 10(@)(@@) % من كأسه وثناياه لنا حبب % تطفو على رائقي خمر جواهره % PageV01P189 11(@)(@@) % لا تنظرن لجنون العاشقين به % % وانظر لما قد جنت فيهم نواظره % % 12(@)(@@) % ما هم عاشقه عذر ولا عذل % سيان عاذله فيه وعاذره % 13(@)(@@) % ما سحر هاروت إلا فعل ناظره % % ولا سيوف الردى إلا بواتره % 14(@)(@@) % كم شن من فتن للصب فاتنة % وشب حرجوى في القلب فاتره % 15(@)(@@) % وكم حلا مورد منه لعاشقه % % لكنه ربما سقت مرائره % % 16(@)(@@) % سل مقلتي إن تسل عن ليل طرته % % فليس يجهل طيب الليل سامره % % 17(@)(@@) % مهفهف ما ثنى عطفا على كفل % إلا ثنى السوء عن عطفيه ناظره % % 18(@)(@@) % من زاره في ظلام الليل مستترا % ما شك في أن بدر التم زائره % 19(@)(@@) % لا تأمنن انكسارا من لواحظه % % فكم قتيل لها ما ثار ثائره % 20(@)(@@) % وإن أراك اعتدالا رمح قامته % % فطالما جار في العشاق جائره % PageV01P190 21(@)(@@) % كم مغرم منه قد أضحى على خطر % لما ترنح يحكي الغصن خاطره % 22(@)(@@) % لم أنس ليلة أنس بت مغتبقا % من ثغره 
ms55	 صرف راح جل عاصره % % 23(@)(@@) % ورحت مصطحبا أخرى مشعشعة % لو ذاقها الدهر ما دارت دوائره % % 24(@)(@@) % يديرها ببنان كاد معصمها % % يسيل من ترف لولا أساوره % 25(@)(@@) % باكرتها لهني العيش مبتكرا % وفقا لما قيل أهنى العيش باكره % % PageV01P191 البحر : كامل تام 1(@)(@@) % وحياتكم يا ساكني أم القرى % % ما كان حبكم حديثا يفترى % % 2(@)(@@) % أهوى دياركم التي من حلها % % حل الجنان بها وعل الكوثرا % % 3(@)(@@) % واها لهن منازلا ومراتعا % ترعى الظباء بهن آساد الشرى % % 4(@)(@@) % إن هزت الآرام سمر قدودها % % هزت ضراغمها الوشيج الأسمرا % % 5(@)(@@) % أنظر بعينك هل ترى فيها سوى % % رشأ يصيد بمقلتيه قسورا % % 6(@)(@@) % أوليث عادية تنمر غائرا % يحمي بأنياب الأسنة جؤذرا % % 7(@)(@@) % الله أكبركم يرعن ومن رأى % % تلك الجآذر والقساور كبرا % % 8(@)(@@) % وبمهجتي رشأ أغن إذا جفا % % جفت العيون لصده طيب الكرى % % 9(@)(@@) % يوفي على الشمس المنيرة في الضحى % % حسنا إذا حسر اللثام وأسفرا % % 10(@)(@@) % لم يسل قلبي عشق أحمر خده % % حتى أسال لي العذار الأخضرا % % PageV01P192 11(@)(@@) % قال العذول وقد أطال ملامتي % % فيه ألا تصغي فقلت ألا ترى % % 12(@)(@@) % هذا الذي جعل القلوب لحسنه % % رقا وما ابتاع القلوب ولا اشترى % % 13(@)(@@) % لا والذي فتن العقول بحسنه % % ما ارتاب قلبي في هواه ولا امترى % % 14(@)(@@) % فارقته كرها وواصلت النوى % % قسرا وأضحى الصبر منفصم ل % % 15(@)(@@) % م أدر أي الغصتين أسيغها % % إن عن لي ذكر الفراق أو اعترى % % 16(@)(@@) % أفراق إلفي أم فراق مواطني % % وكلاهما لهب بقلبي قد ورى % % 17(@)(@@) % لله أيامي بمكة والصبا % % تهدي إلى فودي مسكا أذفرا % % 18(@)(@@) % أشري بكل الدهر منها ساعة % لو أنها مما تباع وتشترى % % PageV01P193 البحر : كامل تام 1(@)(@@) % من قاس جدوى راحتيك إذا همت % % بالغيث أخطأ في القياس وما درى % % 2(@)(@@) % إذ أنت تعطي ضاحكا مستبشرا % والغيث يعطي باكيا مستعبرا % PageV01P194 البحر : بسيط تام 1(@)(@@) % من مستهل دموعي يوم فرقته % % أمطرت سحبا غزارا فهي تنهمر % % 2(@)(@@) % ومن لهيب ضلوعي في محبته % % أوقدت في الحي نارا فهي تستعر % 3(@)(@@) % وكم كتمت ولوعي خوف شهرته % % فزاد فيه اشتهارا والهوى 
ms56	 عبر % PageV01P195 البحر : سريع 1(@)(@@) % لاموا على كثر البكا ناظري % % ولم يروا منظره الناضرا % % 2(@)(@@) % ولو رآه عاذلي لا رأى % % أصبح لا أصبح لي عاذرا % % PageV01P196 البحر : بسيط تام 1(@)(@@) % وغادة من بنات الهند قد برزت % % في زيها بين أسجاف وأستار % % 2(@)(@@) % فقلت لما سرت في اللاذ مائسة % يا حبذا السير بل يا حبذا الساري % % PageV01P197 البحر : وافر تام 1(@)(@@) % نزلنا من برار بكل واد % وليس بأرض من قرار % % 2(@)(@@) % وقد كانت منازلنا قصورا % ونحن اليوم ننزل في براري % % PageV01P198 البحر : وافر تام 1(@)(@@) % سقى صوب الحيا أرض الحجاز % % وجاد مراتع الغيد الجوازي % % 2(@)(@@) % وحيا بالمقام مقام حي % كرام في عشيرتهم عزاز % 3(@)(@@) % هم حامو الحقيقة يوم يدعو % % حماة الحي حي على البراز % 4(@)(@@) % حموا بالسمر بيضهم وشاموا % % عليها كل ذي شطب جراز % % 5(@)(@@) % فخافوا الخزي من عار وحاشا % % حماهم أن تلم به المخازي % % 6(@)(@@) % وغاروا أن يلم بهن صب % فعاعقوا الجائزين عن الجوازي % % 7(@)(@@) % ولو وكلوا الحفاظ إلى الغواني % % لأغنين الغيور عن احتراز % 8(@)(@@) % فكم فيهن من بيضاء رؤد % ضياء جبينها بالصبح هازي % % 9(@)(@@) % غزت كل القلوب هوى وأردت % % بسيف اللحظ منها كل غاز % % 10(@)(@@) % لها خفر حماها قبل تسمى % % ويعزوها إلى الآباء عاز % PageV01P199 11(@)(@@) % تجازي في الهوى بالود صدا % وحسب أخي الهوى أن لا تجازي % % 12(@)(@@) % سمت بدر الدجنة في انبلاج % وأملود الحديقة في اهتزاز % 13(@)(@@) % فيا لله عصر هوى تقضى % % بأفنان الحقيقة والمجاز % 14(@)(@@) % ليالي مشربي في الحب صفو % وثوب اللهو منقوش الطراز % % 15(@)(@@) % أهم فلا يفوت الأنس همي % % ولا يخلو من الفرص انتهازي % % 16(@)(@@) % وأهوي في الظلام على الغواني % % كما يهوي على الكدري باز % 17(@)(@@) % أقول لصاحبي والركب سار % وقد غنى الحداة على النشاز % 18(@)(@@) % ولاح من الحجاز لنا بريق % تلألأ يستطير على حراز % 19(@)(@@) % سقى الله الحجاز وساكنيه % % وحيا معهد الخود الكناز % 20(@)(@@) % إلى أهل الحجاز يحن قلبي % % فوا شوقي إلى أهل الحجاز % PageV01P200 البحر : سريع 1(@)(@@) % يا صاح هذا المشهد الأقدس % % قرت به الأعين والأنفس % 2(@)(@@) % والنجف الأشرف بانت 
ms57	 لنا % % أعلامه والمعهد الأنفس % % 3(@)(@@) % والقبة البيضاء قد أشرقت % % ينجاب عن لألائها الحندس % % 4(@)(@@) % حضرة قدس لم ينل فضلها % % لا المسجد الأقصى ولا المقدس % % 5(@)(@@) % جلت بمن حل بها رتبة % يقصر عنها الفلك الأطلس % 6(@)(@@) % تود لو كانت حصى أرضها % % شب الدجى والكنس الخنس % % 7(@)(@@) % وتحسد الأقدام منا على % % السعي إلى أعتابها الأرؤس % % 8(@)(@@) % فقف بها والثم ثرى تربها % % فهي المقام الأطهر الأقدس % 9(@)(@@) % وقل صلاة وسلام على % % من طاب منه الأصل والمغرس % % 10(@)(@@) % خليفة الله العظيم الذي % % من ضوئه نور الهدى يقبس % % PageV01P201 11(@)(@@) % نفس النبي المصطفى أحمد % وصنوه والسيد الأرأس % 12(@)(@@) % العلم العيلم بحر الندى % % وبره والعالم النقرس % % 13(@)(@@) % فليلنا من نوره مقمر % ويومنا من ضوئه مشمس % 14(@)(@@) % أقسم بالله وآياته % % ألية تنجي ولا تغمس % 15(@)(@@) % أن علي بن أبي طالب % منار دين الحق لا يطمس % % 16(@)(@@) % ومن حباه الله أنباء ما % % في كتبه فهو لها فهرس % 17(@)(@@) % أحاط بالعلم الذي لم يحط % % بمثله بليا ولا هرمس % 18(@)(@@) % هذا أمير المؤمنين الذي % % شرائع الله به تحرس % % 19(@)(@@) % وحجة الله التي نورها % % كالصبح لا يخفى ولا يبلس % 20(@)(@@) % تالله لا يجحدها جاحد % إلا امرؤ في غيه مركس % PageV01P202 21(@)(@@) % المعلن الحق بلا خشية % حيث خطيب القوم لا ينبس % 22(@)(@@) % والمقحم الخيل وطيس الوغى % % إذا اتقاها البطل الأحوس % % 23(@)(@@) % جلبابه يوم الفخار التقى % % لا الطيلسان الخز والبرنس % % 24(@)(@@) % يرفل من تقواه في حلة % يحسدها الديباج والسندس % 25(@)(@@) % يا خيرة الله الذي خيره % % يشكره الناطق والأخرس % 26(@)(@@) % عبدك قد أمك مستوحشا % من ذنبه للعفو يستأنس % % 27(@)(@@) % يطوي إليك البحر والبر لا % % يوحشه شيء ولا يؤنس % % 28(@)(@@) % طورا على فلك به سابح % وتارة تسري به عرمس % 29(@)(@@) % في كل هيماء يرى شوكها % % كأنه الريحان والنرجس % 30(@)(@@) % حتى أتى بابك مستبشرا % ومن أتى بابك لا ييأس % PageV01P203 31(@)(@@) % أدعوك يا مولى الورى موقنا % أن دعائي عنك لا يحبس % % 32(@)(@@) % فنجني من خطب دهر غدا % % للجسم مني أبدا ينهس % % 33(@)(@@) % هذا ولولا أملي فيك لم % % يقر بي 
ms58	 مثوى ولا مجلس % % 34(@)(@@) % صلى عليك الله من سيد % مولاه في الدارين لا يوكس % % 35(@)(@@) % ما غردت ورقاء في روضة % وما زهت أغصانها الميس % % PageV01P204 البحر : كامل تام 1(@)(@@) % يا طود مجد في المكارم راس % سامي العماد موطد الآساس % % 2(@)(@@) % لا غرو إن سقط الجواد لعثرة % عثرت لها قدم الندى والباس % % 3(@)(@@) % فلقد حملت عليه أثقال العلى % % فغدا ذلولا بعد طول شماس % % 4(@)(@@) % حتى إذا ألقيت فضل عنانه % % سبقا إلى الغايات قبل الناس % % 5(@)(@@) % لم يستطع حملا لما أوقرته % % فهوى كما يهوي العظيم الراسي % % 6(@)(@@) % هيهات أن يسطيع يحمل راكضا % جبل العلى فرس من الأفراس % 7(@)(@@) % فليذهب النغل الحسود لما به % % وليحظ مما رامه بالياس % % 8(@)(@@) % واسلم على مر الليالي راتعا % في طيب عيش طيب الأنفاس % % PageV01P205 البحر : كامل تام 1(@)(@@) % ما ست فأزرت بالغصون الميس % % وأتتك تخطر في غلالة سندس % % 2(@)(@@) % وتبرجت جنح الظلام كأنها % % شمس تجلت في دياجي الحندس % % 3(@)(@@) % تختال بين لداتها فتخالها % % بدرا بدا بين الجواري الكنس % % 4(@)(@@) % أرجت يرياها الصبا وتضوعت % % أنفاسها والصبح لم يتنفس % % 5(@)(@@) % ووفت بموعدها وبات وشاتها % % للوجد بين عم وآخر أخرس % 6(@)(@@) % والبرق يخفق قلبه من غيرة % والنجم يرمقنا بمقلة أشوس % % 7(@)(@@) % يا طيب ليلتنا بمنعرج اللوى % % ومبيتنا فوق الكثيب الأوعس % % 8(@)(@@) % إذ بات شملي في ضمان وصالها % % والقرب يبدل وحشتي بتأنس % 9(@)(@@) % والليل يكتم سرنا ونجومه % % ترنو الينا عن لحاظ نعس % 10(@)(@@) % وسنى المجرة في السماء كأنه % % نهر تدفق في حديقة نرجس % PageV01P206 11(@)(@@) % باتت تدير علي من ألحاظها % % كأسا وأخرى من لماها الالعس % % 12(@)(@@) % حتى إذا رق النسيم وأخفقت % % من أفق مجلسنا نجوم الأكؤس % % 13(@)(@@) % قالت وقد واليت هصر قوامها % % ضاق الخناق من العناق فنفس % 14(@)(@@) % ثم انثنت حذر الفراق مروعة % في هيئة المستوحش المستأنس % 15(@)(@@) % تتنفس الصعداء من وجد وقد % % غص الظلام بصحبه المتنفس % % 16(@)(@@) % واستعجلت شد النطاق وودعت % % توديع مختلس بحيرة مبلس % % 17(@)(@@) % لله غانية عنت لضيائها % % شمس الضحى إذا أشرقت في الأطلس % % 18(@)(@@) % سلبت نفوس أولي الغرام صبابة % بجمالها 
ms59	 الباهي السني الأنفس % 19(@)(@@) % وسألتها نفسي فقالت حيرة % أي النفوس فقلت أغلى الأنفس % % 20(@)(@@) % لم أنسها يوما فأذكر أنسها % % لا كان من ينسى الأحبة أو نسي % % PageV01P207 21(@)(@@) % هذا الحسين ابن الحسين أخو العلى % % علقت يدي منه بود أقعس % % 22(@)(@@) % لم ينسه بعد الديار مودتي % % يوما وعهدي عنده لم يبخس % % 23(@)(@@) % وسواه يظهر وده بلسانه % % وخميره كصحيفة المتلمس % % 24(@)(@@) % هذا الوفي الهاشمي المجتبى % % غوث الجليس له وبدر المجلس % % 25(@)(@@) % طابت أرومة مجده فزكت به % % والغرس يعرب عن زكاء المغرس % % 26(@)(@@) % ايه أخا المجد المؤثل والعلى % % لله درك من أديب أكيس % % 27(@)(@@) % وافت قصيدتك التي فعلت بنا % % فعل المدامة بالنهى والأرؤس % % 28(@)(@@) % ألبستها وشي الكلام فأقبلت % % مختالة تزهو بأبهى ملبس % 29(@)(@@) % ما ضر سامعها وقد جليت له % % أن لا يجيل كؤوسها أو يحتسي % % 30(@)(@@) % جددت لي عهد الصبا بنسيبها % % وربوع عهدي بالصبا لم تدرس % PageV01P208 31(@)(@@) % وإليكها غراء تستلب الحجا % % وتروض كل جموح طبع أشرس % % 32(@)(@@) % نضدت عقد نظامها وبعثتها % % دررا تفوق على الدراري الخنس % 33(@)(@@) % وكسوتها من وصف ودك حلة % هزت لها عطف المحلى المكتسي % % 34(@)(@@) % تجلى عليك ونجم سعدك مشرق % في قمة الفلك الرفيع الأطلس % % PageV01P209 البحر : خفيف تام 1(@)(@@) % طاف بدر الدجى بشمس الكؤوس % في نجوم من الندامى جلوس % 2(@)(@@) % فكأن المدام في الكأس إذ تجلى % % سراج يضيء في فانوس % % 3(@)(@@) % قهوة عسجدية من كناها % % بنت رأس مقرها في الرؤوس % % 4(@)(@@) % هي لهو لنا إذا حلت الكأس % % س ولاة في دنها للمجوس % % 5(@)(@@) % لقبت بالعجوز وهي عروس % فاعجب اليوم للعجوز العروس % % 6(@)(@@) % قام يسعى بها كميتا كعين الديك % % ساق في حلة الطاووس % % 7(@)(@@) % ذو دلال يبدي نفيس جمال % فيفدى بغاليات النفوس % 8(@)(@@) % راضه السكر فاقتني الرشأ % % الوحشي أنسا من خلقه المأنوس % % 9(@)(@@) % بين حور من الحسان بدور % وحوال من الغواني شموس % % 10(@)(@@) % ورياض لها الأقاح ثغور % يتبسمن في الزمان العبوس % % PageV01P210 11(@)(@@) % يا ليالي الهنا إلينا فانا % % في ضمان المدام من كل بوس % 12(@)(@@) % قد حسونا من السلاف رضابا % ورشفنا الثغور رشف 
ms60	 الكؤوس % 13(@)(@@) % وجمحنا عن الهموم شماسا % مذ غدونا على الكميت الشموس % % 14(@)(@@) % يا نداماى للمدامة هبوا % % قبل قرع القسيس للناقوس % 15(@)(@@) % بادروا الصبح بالصبوح وثوب الل % الليل ملقى كالمنهج الملبوس % % 16(@)(@@) % وسماء الدجى تشير إلينا % % بعيون من الكواكب شوس % % PageV01P211 البحر : وافر تام 1(@)(@@) % سقى صوب الغمام عريش كرم % جنينا من جناه العذب أنسا % % 2(@)(@@) % وأمسى عاصر العنقود منه % % يكسر أنجما ويصوغ شمسا % % PageV01P212 البحر : كامل تام 1(@)(@@) % قم هاتها في جنح ليل دامس % راحا حكت في الراح شعلة قابس % % 2(@)(@@) % واطرد بها سرح الكرى عن ناظري % % رشأ يغازلنا بطرف ناعس % % 3(@)(@@) % وأجل كؤوسك بالمسرة واجلها % % من كف أغيد كالقضيب المائس % % 4(@)(@@) % عذراء تضحك في وجو سقاتها % % وتروض كل جموح طبع شامس % % 5(@)(@@) % زفت إلى ماء السماء فأصبحت % تهزو بكل مهاة خدر عانس % 6(@)(@@) % ماذا على من قابلته ببشرها % % ألا يقابلها بوجه عابس % 7(@)(@@) % تنفي الكروب عن القلوب ولم تزل % تهدي الرجاء إلى فؤاد اليائس % 8(@)(@@) % رقت فلولا الكأس لم تبصر لها % % جسما ولم تلمس براحة لامس % % 9(@)(@@) % فكأنها عند المزاج لطافة % وهم يخيله توهم هاجس % 10(@)(@@) % طابت مغارسها فبورك في يدي % جان جنى تلك الكروم وغارس % PageV01P213 11(@)(@@) % قف إن وقفت بحانها حينا ودع % عنك الوقوف بكل ربع دارس % PageV01P214 البحر : كامل تام 1(@)(@@) % قل للمليحة في القباء الأطلس % % أفسدت عقل أخي التقى المتقدس % % 2(@)(@@) % أو ما كفاك لباس حسنك والبها % % حتى برزت لنا بأبهى ملبس % 3(@)(@@) % أخجلت ولدان الجنان وحورها % % وخطرت من أثوابها في سندس % 4(@)(@@) % إن كان لا يرضيك إلا فتنتي % % فرضاك فرض يا حياة الأنفس % 5(@)(@@) % هذا محبك ناصبا أحشاءه % % غرضا لأسهم مقلتيك فقرطسي % % PageV01P215 البحر : طويل 1(@)(@@) % لمن ساريات بين وهن وتغليس % تزف زفيف الطير في صور العيس % % 2(@)(@@) % إذا أنشقتها طيب نجد ورنده % % صبا نفست من كربها بعض تنفيس % % 3(@)(@@) % وإن نفحتها نسمة حاجرية % أبت من غرام أن تميل لتعريس % 4(@)(@@) % يطربها جرس الحداة فتنثني % % تقلب قلبا بين وجد وتأنيس % % 5(@)(@@) % سرت تتهادى بالحدوج كأنها % % بروج نجوم أو وكور 