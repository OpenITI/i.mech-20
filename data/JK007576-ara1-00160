ms141	 وآجله % % 7(@)(@@) % وقفنا نرامي بالهوى مقتل الهوى % % ونقرأ في الألحاظ وحي رسائله % % 8(@)(@@) % ونرقب سربا في الخدور ، عقولنا % % مبددة للبين بين عقائله % % 9(@)(@@) % أنيس الهوى للموت حوليه وحشة % فأسد الشرى مخذولة عن خواذله % % 10(@)(@@) % ويوم صلينا فيه نار صبابة % فلا لفحت إلا وجوه أصائله % % PageV01P506 11(@)(@@) % عشية أبكى البين من رحمة لنا % % بكاء قتيل الشوق في إثر قاتله % % 12(@)(@@) % وفي صدف الأحداج مكنون لؤلؤ % تكف بأطراف الظبا كف باذله % % 13(@)(@@) % طمى بالمنايا الحمر لج سرابه % فكم غائص لهفان من دون ساحله % % 14(@)(@@) % فمن لقتيل بالقتول وقد غدت % وسائله مصرومة من وسائله % % 15(@)(@@) % ووقفة رود بضة الجسم غضة % لتوديع صب شاحب الجسم ناحله % % 16(@)(@@) % شج كان من قبل التفرق يشتكي % % نميمة واشيه وتأنيب عاذله % % 17(@)(@@) % وفي برقع الحسناء مقلة جؤذر % بها رد كيد السحر في نحر بابله % % 18(@)(@@) % ولو شام هاروت وماروت طرفه % لما أصبحا إلا قنيصي حبائله % % 19(@)(@@) % جنى غير مستبق ثمار قلوبنا % % فعنابهن الرطب ملء أنامله % % 20(@)(@@) % وأغلب ظني أن ما في وشاحه % كساه نحولا حب ما في خلاخله % % PageV01P507 21(@)(@@) % طوى ما طوى ذاك النجاء من الهوى % % فيا من لقلب من نجي بلابله % % 22(@)(@@) % فجاد عليهم كل باك ربابه % % ضحوك المغاني عن أقاحي خمائله % % 23(@)(@@) % إذا انهل فيه الودق عاينت منهما % % عطاء ابن عباد وراحة سائله % % 24(@)(@@) % همام يموج البر كالبحر حوله % % إذا رفع الرايات فوق جحافله % % 25(@)(@@) % وقلب فيها الموت في لحظه العدى % % عيون ذبال في لدان ذوابله % % 26(@)(@@) % تحملق أبصار الورى عن ذكره % لكيما ترى بدر العلى في منازله % % 27(@)(@@) % إذا جار دهر كان منه ملاذنا % % بحقوي أبي قيم الملك عادله % % 28(@)(@@) % يصون الهدى منه إذا خاف ضيمه % بحاميه من كيد الضلال وكافله % % 29(@)(@@) % أخو عزمات للهجوع مهاجر % إذا هجعت عين العلى عن مواصله % % 30(@)(@@) % رقيق الحواشي أقعس العز ماجد % كأن شمولا رقرقت في شمائله % % PageV01P508 31(@)(@@) % شديد عراك البأس يعقر قرنه % إذا استطعم السرحان ما في جمائله % % 32(@)(@@) % وفي غيضة الخطي ليث كأنما % % عليه من الماذي لين غلائله 
ms142	 % % 33(@)(@@) % تورد في الأجياد صفحة سيفه % % وتنهش في الأكباد حية عامله % % 34(@)(@@) % مقيم بأرض الروع حيث سماؤها % % تمور عليه من مثار قساطله % % 35(@)(@@) % كأن مقام الحرب أشهى ربوعه % % إليه ، وبيض الهند أدنى قبائله % % 36(@)(@@) % ومخضل أوراق الصفائح ضرجت % بكل دم أندى نبات غوائله % % 37(@)(@@) % لهام عليه للعجاج غلائل % لها طراز من بارقات مناصله % % 38(@)(@@) % وتحسبه بحرا تلف عواصفا % أواخره ، أرواحه ، بأوائله % % 39(@)(@@) % يظلله سرب من الطير ملحم % يروح بأرواح العدى في حواصله % % 40(@)(@@) % إذا ما رمى قطرا به عزمه اغتدت % أعاليه بالتدمير تحت أسافله % % PageV01P509 41(@)(@@) % إليك زجرنا الفلك في كل زاخر % معالمنا مفقودة في مجاهله % % 42(@)(@@) % مدافعة الأهوال مدفوعة إلى % % جنائبه تجري بها أو شمائله % % 43(@)(@@) % إلى ملك في سيفه وبنانه % جهنم شانيه ، وجنة آمله % 44(@)(@@) % ومعجز آيات الندى ذي سماحة % مجانس نظم المكرمات مقابله % % 45(@)(@@) % كريم إذا هبت رياح ارتياحه % % جرت سفن الآمال في بحر سائله % % 46(@)(@@) % رفعنا عقيرات القوافي بمدحه % فأطربن أسماع العلى في محافله % % 47(@)(@@) % سلوني عنه ، واسمعوا الصدق ، إنني % % أحدث عن هماته وفواضله % % 48(@)(@@) % ولا تسألوني عن فرائض طوله % % إذا غمر الدنيا ببعض نوافله % % 49(@)(@@) % فأندي بني ماء السماء محمد % وهل طل معروف السماء كوابله % % PageV01P510 البحر : كامل أحذ 1(@)(@@) % ورد الخدود ونرجس المقل % عدلا بسامعتي عن العذل % 2(@)(@@) % وموارد الرشفات مرويتي % % حيث المياه مثيرة غللي % % 3(@)(@@) % خذلتك باللحظات خاذلة % في الإجل ترسل أسهم الأجل % % 4(@)(@@) % من مقلة نقلتك قهوتها % % بالسكر من خبل إلى خبل % % 5(@)(@@) % ولقلما يصحوامرؤ حكمت % فيه كؤوس الأعين النجل % % 6(@)(@@) % إني امرؤ ما زلت أنظم في % % جيد الغزال قلائد الغزل % 7(@)(@@) % وجنية ضنت على نظري % % بجني ورد الوجنة الخضل % 8(@)(@@) % صبغت غلالة خدها بدمي % % إن لم يكن فبعندم الخجل % % 9(@)(@@) % تعلو بعود أراكة بردا % غسلت حصاه مدامع السبل % % 10(@)(@@) % وتكف عن فلق دجى غسق % بمضرجات من دم البطل % PageV01P511 11(@)(@@) % وكأنما خاضت ذوائبها % % من جفنها في صبغة الكحل % % 12(@)(@@) % يا هذه استبقي على رجل % أفحمته بالفاحم الرجل % 13(@)(@@) % لا تسأليه عن الهوى وسلي % % عنه 
ms143	 إشارة دمعه الهطل % 14(@)(@@) % عطفت وقالت : رب ذي أمل % ظفرت يداه بطائل الأمل % 15(@)(@@) % قبلي ديون ما اعترفت بها % % إلا لأمنح مجتنى قبلي % % 16(@)(@@) % واها لأيام سقيت بها % % كأس النعيم براحة الجذل % 17(@)(@@) % لم يبق لي من طيبهن سوى % % ما أبقت الأحلام في المقل % 18(@)(@@) % ثم اعتبرت ، هداية ، زمني % % فإذا تصرفه علي ولي % % 19(@)(@@) % يا لائمي نقل ملامك عن % ندب وصيره إلى وكل % % 20(@)(@@) % أعلى الزماع تلوم مغتربا % يقري الرحال غوارب الإبل % % PageV01P512 21(@)(@@) % إني أقيم صدورها لسرى % يهدي كلاكلها إلى الكلل % % 22(@)(@@) % وأروح عن وطني إذا دميت % بعدي مدامع دمية الكلل % % 23(@)(@@) % والسيف لا يفري ضريبته % حتى تجرده من الخلل % 24(@)(@@) % سأثيرها من كل طاعنة % صدر الفلاة بأذرع فتل % % 25(@)(@@) % فإذا بلغن محمدا أمنت % غلس البكور وروحة الأصل % 26(@)(@@) % وإلى ابن عباد تعبدها % % رملا قطعن مداة بالرمل % 27(@)(@@) % ترعى الرسيم إلى الوجيف بنا % % بدلا من الحودان والنفل % 28(@)(@@) % صور العيون إلى سنا ملك % حي السماحة ميت البخل % % 29(@)(@@) % ملك تقابل منه أبهة % تغضي العيون بها إلى القبل % 30(@)(@@) % فتزر لأمته على أسد % وتلات حبوته على جبل % PageV01P513 31(@)(@@) % لو لم يزر مغناه ذو عدم % ألقى نداه له على السبل % % 32(@)(@@) % أو زاره في الحشر آثره % % كرما عليه بصالح العمل % % 33(@)(@@) % أحسبت أن يمينه فرغت ؟ % هي للندى والبأس في شغل % 34(@)(@@) % أسد على الفرسان يفرسها % % عند انقراض الأمن بالوجل % 35(@)(@@) % وكتيبة شهباء رانية % تحت العجاج بأعين الأسل % % 36(@)(@@) % جاءت بها الآساد تزأر في % % غيل الصوارم والقنا الذبل % % 37(@)(@@) % والطعن يلحق من سوابغهم % % حدق الجراد بأعين الحجل % % 38(@)(@@) % وكأن سمر الخط في شرق % بالعل من دمهم وبالنهل % % 39(@)(@@) % وكأنما يلحسن في غدر % مهج الكماة بألسن الشعل % % 40(@)(@@) % خطبت سيوفك من سراتهم % % لعلاك فوق منابر القلل % % PageV01P514 41(@)(@@) % يا ماتحا برشاء صعدته % بين الأسنة مهجة البطل % 42(@)(@@) % رمح يروق الطرف معتقلا % في كف غيرك غير معتقل % 43(@)(@@) % أي الملوك لك الفداء ، وقد % % صيرت جلتها من الخول % % 44(@)(@@) % دامت لك الدنيا ودمت لها % % وأقام سيفك كل 
ms144	 ذي ميل % % PageV01P515 البحر : طويل 1(@)(@@) % أغمر الهوى كم ذا تقطعني عذلا % % قتلت الهوى علما ، أتقتلني جهلا % % 2(@)(@@) % أظنك لم تفتح عليك نواظر % إذا هي أعطت صبوة أخذت عقلا % % 3(@)(@@) % ولا عرضت من بيضهن سوافر % عليك الخدود الحمر والأعين النجلا % % 4(@)(@@) % لم يصب منك القلب مشي جآذر % ينزع فيه التيه أقدامها نقلا % % 5(@)(@@) % ولم تر سحرا كالعيون تخالنا % % بزعمك أحياء ونحن بها قتلى % % 6(@)(@@) % ومن أعجب الأشياء أن سيوفها % % تعود رماحا ، حيث تلحظ ، أو نبلا % % 7(@)(@@) % خرجت على حد القياس مع الهوى % % فقل من أمر الكأس من بعد ما أحلى % % 8(@)(@@) % ولما كتبت الحب في القلب وارتقى % % إلى الطرف ماء الشوق أنكر ما أملى % % 9(@)(@@) % وبي كل غيداء القوام كأنما % % يطاول منها قدها شعرا جثلا % 10(@)(@@) % لها بله بالحب تحسب جده % إذا هز أعطافي بنشوته هزلا % % PageV01P516 11(@)(@@) % إذا غرست في مسمع الصب موعدا % % جنى بيد التسويف من غرسها مطلا % % 12(@)(@@) % وإن هي زارت خلتها مستعيرة % لها من خطيب الحفل جلسته العجلى % % 13(@)(@@) % أرى البيض مثل البيض تقطع وصل من % % يقطع في كفيه من غيره وصلا % % 14(@)(@@) % فلا تأمنن منهن إن كنت حازما % ولا من هواها المرء خبلا ولا ختلا % % 15(@)(@@) % وساق ، على ساق ، يصرف بيننا % % بكأس نظمنا للسرور بها شملا % % 16(@)(@@) % كلؤلؤة بيضاء في الكف أقبلت % بياقونة حمراء مظهرة حملا % % 17(@)(@@) % كأن وثوب السكر فيها مساور % يدبب منه في مفاصلها نملا % % 18(@)(@@) % تركنا لها من جورها ما يسيئنا % % فمن مزجها بالماء قارنت العدلا % % 19(@)(@@) % وعذراء كانت وردة قبل مزجها % % ومن بعده عنت لمبصرها شعلا % % 20(@)(@@) % إذا واجهت كاساتها الليل خلتها % % تهتك من ظلمائه حجبا كحلا % % PageV01P517 21(@)(@@) % وتحسبها تجلو علينا عرائسا % وشاربها يفتض منهن ما يجلى % % 22(@)(@@) % وجدنا ( نعم ) في الناس يهجر قولها % % كأن على الأفواه من لفظها ثقلا % % 23(@)(@@) % ولما احتواها كل حي تعلقت % % بلفظ ابن عباد فكان لها أهلا % % 24(@)(@@) % جواد بما فوق الغنى لك والمنى % % فهمتك العليا لهمته سفلى % % 25(@)(@@) % ترى الناس يستصحون من جود كفه % % إذا الوبل منه 
ms145	 أنهل واتبع الوبلا % % 26(@)(@@) % هزبر الوغى بالسيف والرمح مقدم % له الضربة الفرغاء والطعنة النجلا % % 27(@)(@@) % تنوء به غرا حفيظة عزمه % وترجح أسباب الأناة به كهلا % % 28(@)(@@) % وحرب أذيقت في بنيها ببأسه % % مرارة كأس الثكل لا عدمت ثكلا % % 29(@)(@@) % وكانت عيون الماء زرقا فأصبحت % بما مازجته من دمائهم شهلا % % 30(@)(@@) % وما ولدت سود المنايا وحمرها % % على الكره حتى كان صارمك الفحلا % % PageV01P518 31(@)(@@) % أقائدها قب الأياطل لم تلدع % له عند أعداء إغارتها ذحلا % % 32(@)(@@) % حميت حمى الاسلام إذ ذدت دونه % % هزبرا ورشحت الرشيد له شبلا % % 33(@)(@@) % لئن قلت فيه صح تأليف سؤدد % فبارع نقل من شمائلك استملى % % 34(@)(@@) % ألا حبذا العيد الذي عكفت به % % على كفك الأمواه تمطرها قبلا % % 35(@)(@@) % ويا حبذا دار يد الله مسحت % عليها بتجديد البقاء فما تبلى % % 36(@)(@@) % مقدسة لو أن موسى كليمه % مشى قدما في أرضها خلع النعلا % % 37(@)(@@) % وما هي إلا حطة الملك الذي % % يحط لديه كل ذي أمل رحلا % % 38(@)(@@) % إذا فتحت أبوابها خلت أنها % % تقول بترحيب لداخلها : أهلا % % 39(@)(@@) % وقد نقلت صناعها من صفائه % % إليها أفانينا فأحسنت النقلا % % 40(@)(@@) % فمن صدره رحبا ومن وجهه سنا % ومن صيته فرعا ، ومن حمله أصلا % % PageV01P519 41(@)(@@) % وأعلت بها في رتبة الملك ناديا % % وقل له فوق السماكين أن يعلى % % 42(@)(@@) % نسيت به إيوان كسرى لأنه % % أراني له مولى من الفضل لا مثلا % % 43(@)(@@) % كأن سليمان بن داود لم تبح % مخافته للجن في شيده مهلا % % 44(@)(@@) % كأن عيون السحر نافذة له % % على كل بان غاية منه أو فضلا % % 45(@)(@@) % فجاء مكان القول نبعث وصفه % رقيقا ، وأذن الدهر تسمعه جذلى % % 46(@)(@@) % تجوز له الأمواه بركة جدول % تخال الصبا منه مشطبة نصلا % % 47(@)(@@) % إذا اتخذتها الشمس مرآة وجهها % % أحالت عليها من مداوسها صقلا % % 48(@)(@@) % ترى الشمس فيه ليقة تستمدها % % أكف أقامت من تصاويرها شكلا % % 49(@)(@@) % لها حركات أودعت في سكونها % % فما تبعت في نقلهن يد رجلا % % 50(@)(@@) % * * * وقد توج البهو البهي بقية % فقل في عروس في جلابيبها تجلى % % PageV01P520 51(@)(@@) % تجمعت الأضداد فيها 
ms146	 مصانعا % ولم أر خلقا قبلها جمع الشملا * * * % 52(@)(@@) % * * * وأغرب ما أبصرت بعد مليكها % % بها مترع يعدي الشجاعة والبذلا * * * % 53(@)(@@) % تنادم في غناء غنت حمامها % % فوارس أغصان ترجحها حملا % % 54(@)(@@) % إذا شربت ود المؤيد صيرت % خلائقه راحا ورؤيته نقلا % % 55(@)(@@) % كأن مها الأحداج حلت سماءها % % وإن لم تكن إلا حنياته بزلا % % 56(@)(@@) % كأن سهما أرسلت عن قسيها % % فما عدمت عين الحسود بها سملا % % 57(@)(@@) % وما شئت ممات لو عنيت بوصفه % سلكت إليه كل قافية سبيلا % % 58(@)(@@) % فتحسب ما في الأرض من حيوانها % % رقى شرفا فيه إلى الفلك الأعلى % % 59(@)(@@) % ولما عشينا من توقد نورها % % تخذنا سناه من نواظرنا كحلا % % 60(@)(@@) % فيا دار أغضى الدهر عنك وأكثرت % أسودك نسلا فيه يختتل النسلا % % PageV01P521 البحر : طويل 1(@)(@@) % ونوبية في الخلق منها خلائق % متى ما ترق العين فيها تسهل % 2(@)(@@) % إذا ما اسمها ألقاه في السمع ذاكر % رأى الطرف منه ما عناه بمقول % % 3(@)(@@) % لها فخذا قرم وأظلاف قرهب % وناظرتا رئم ، وهامة ايل % 4(@)(@@) % مبطنة الأخلاق كبرا وعزة % فمهما تجد بالمشي في المشي تبخل % % 5(@)(@@) % وكم حولها من سائس حافظ لها % % يكرمها عن خطة المتبذل % 6(@)(@@) % ترى ظلف رجل يلتقي إن تنقلت % بظلف يد منها عزيز التنقل % % 7(@)(@@) % كأن الخطوط البيض والصفر أشبهت % على جسمها ترصيع عاج بصندل % 8(@)(@@) % ودائمة الإقعاء في اصل خلقها % % إذا قابلت أدبارها عين مقبل % 9(@)(@@) % تلفت أحيانا بعين كحيلة % وجيد على طول اللواء مظلل % 10(@)(@@) % وعرف دقيق الشعر تحسب نبته % إذا الريح هزته ذوائب سنبل % % PageV01P522 11(@)(@@) % تنفس كبرا من يراع مثقب % فتعطي جنوبا منه عن أخذ شمأل % 12(@)(@@) % وتنفض رأسا في الزمام كأنما % % تريك له في الجو نفضة أجدل % 13(@)(@@) % إذا طلع النطح استجادت نطاحه % % برأس له هاد على السحب معتل % 14(@)(@@) % وقرنين أوفت منهما كل عقدة % % كرمانتي باب الخباء المقفل % 15(@)(@@) % إذا قمعا بالتبر زادت تعززا % على كل خود ذات تاج مكلل % % 16(@)(@@) % وتحسبها من نفسها إن تبخترت % تزف إلى بعل عروسا وتنجلي % % 17(@)(@@) % وكم منشد قول امرىء القيس 
ms147	 حولها % ' أفاطم مهلا بعض هذا التدلل ' % PageV01P523 البحر : كامل تام 1(@)(@@) % ومعطشات في سعور قيونها % % تسقى نجيع جماجم وكواهل % 2(@)(@@) % ومن البروق على الرؤوس لوقعها % % وعد يصوب من الدماء بوابل % 3(@)(@@) % وكأن أجنحة الفراش تقطعت % منثورة منهن فوق جداول % 4(@)(@@) % من كل أبيض راكض في غمده % لج المنية معطب بالساحل % 5(@)(@@) % يفري الضرائب في حبائك سردها % % بمضارب شهدت وقائع وائل % 6(@)(@@) % وكأنما قفر يطول بمتنه % في رمله للنمل أثر أنامل % % PageV01P524 البحر : طويل 1(@)(@@) % وذي رونق ترتاع منه كأنما % % عروس المنايا فيه للعين تجتلى % % 2(@)(@@) % صموت عن النطق المبين لسانه % فإن قرع البيض اليماني ولولا % % 3(@)(@@) % جرى والتظى سلا فقلت تعجبا : % متى فجرت كف من النار جدولا % % 4(@)(@@) % لهام العدى منه سجود على الثرى % % إذا ما اغتدى منه ركوع على الطلا % % PageV01P525 البحر : متقارب تام 1(@)(@@) % وأبيض تحسب فيه الفرند % يثير هباء على جدول % % 2(@)(@@) % إذا دعي الموت بالهز منه % % أجاب بصلصلة الجلجل % 3(@)(@@) % وما سل للضرب إلا أسال % على خده أدمع المقتل % % 4(@)(@@) % ترى فيه عينك غول الحمام % يهم بأكل يد الصيقل % 5(@)(@@) % وماء به شرقات الردى % % تميع في قبس مشعل % % 6(@)(@@) % تقلدني إذ تقلدته % % ألا إنني منصل المنصل % PageV01P526 البحر : كامل تام 1(@)(@@) % ملك جديد مثل طبع المنصل % نمش الفرند عليه صنع الصيقل % 2(@)(@@) % ورياسة علوية ترنو إلى % % زهر الكواكب إذ تراءت من عل % 3(@)(@@) % وسعادة لو أنها جعلت على % % هرم لعاد إلى الشباب الأول % 4(@)(@@) % هات الحديث عن الزمان وحسنه % وخذ الحديث من المحدث عن علي % % 5(@)(@@) % من ألحف الدنيا جناحي عدله % وأجار من صرف الخطوب المعضل % 6(@)(@@) % من مهد الملك العظيم وناهضا % للمكرمات بكل عبء مثقل % % 7(@)(@@) % ملك تفل عداته عزماته % بصوارم قدرية لم تفلل % % 8(@)(@@) % بر إذا عمل خلا من نصحه % ورجا التقي قبوله لم يعمل % 9(@)(@@) % شربت قلوب الناس منه محبة % كرع الصوادي في عذوبة منهل % % 10(@)(@@) % وقضى له بالنجح مبدأ أمرد % ويدلك الماضي على المستقبل % % PageV01P527 11(@)(@@) % وسما يحلق في العلى بعداته % % مثل البغاث خشين وقع الأجدل % % 12 
ms148	(@)(@@) % إياك أن يختال منهم جاهل % فحسامه للجيد منه يختلي % % 13(@)(@@) % إن الشريعة منه تشرع عاملا % من كل باغ عاملا في المقتل % % 14(@)(@@) % ورث الممالك من أبيه فحازها % % وتراث مجد في الصميم مؤثل % % 15(@)(@@) % حسم المظالم عادلا فكأنه % من سيرة العمرين جدد ما بلي % % 16(@)(@@) % كم قال من حي لميت : قم ترى % % ما نحن فيه من التنعم مذ ولي % % 17(@)(@@) % إن ابن يحيى في المفاخر ، ذكره % متضوع منه فم المتمثل % % 18(@)(@@) % ملك إذا خفقت عليه بنوده % فالخافقان له جناحا جحفل % 19(@)(@@) % يقتاد كل عرمرم متموج % كالبحر تركله نؤوج الشمأل % % 20(@)(@@) % وتريك في أفق العجاج رماحه % شرر الأسنة في رماد القسطل % % PageV01P528 21(@)(@@) % في كل سابغة كأن قتيرها % % حدق الجنادب في سراب المجهل % % 22(@)(@@) % ماذية يشكو لكثرة لحمها % % ضرا بلا نفع لسان المنصل % 23(@)(@@) % كغمامة يجلو عليك بريقها % % في السرد لمع البارق المتهلل % 24(@)(@@) % يفتر عن ثغر الرئاسة ، والردى % % جهم يلذ بعض ناب أعصل % % 25(@)(@@) % إن كر في ضرب الكماة بمرهف % قد الحديد على الكمي بجدول % 26(@)(@@) % وتخال يوم الطعن مهجة قرنه % تجري السليط على السنان المشعل % 27(@)(@@) % لا تسألن عن بأسه واقرأه في % % صفة الحديد من الكتاب المنزل % 28(@)(@@) % صلت الجبين ، على أسرة وجهه % % نور يشير إلى الظلام فينجلي % % 29(@)(@@) % ثبتت رصانة حلمه فكأنما % % أرساه خالقه بهضة يذبل % 30(@)(@@) % ما زلت في رتب العلا متنقلا % وكذا انتقال البدر في الفلك العلي % % PageV01P529 31(@)(@@) % وموفق الأعمال تحسب رأيه % صبحا يقد أديم ليل أليل % 32(@)(@@) % وتكاد تردي ، في الغمود ، سيوفه % % وتبيد أسهمه ، وإن لم ترسل % 33(@)(@@) % دم للمعالي أيها الملك الذي % % أسدى الأماني من يميني مفضل % % 34(@)(@@) % نعم تنور في الأكف كما سقى % % عين الرياض حيا السحاب المسبل % % 35(@)(@@) % وفدت عليك سعود عام مقبل % فتلقه بسعود عز مقبل % 36(@)(@@) % أهدى التحية واستعار لنطقه % من كل ممتدح فصاحة مقول % 37(@)(@@) % وسعى بأرضك واضعا فمه على % % ترب بأفواه الملوك مقبل % 38(@)(@@) % وكأنه بك للأنام مهنىء % ومبشر لك في علو المنزل % % 39(@)(@@) % بمراتب تبنى وبأس يتقى % % وسعادة تنمي 
ms149	 ، وكعب يعتلي % % PageV01P530 البحر : كامل تام 1(@)(@@) % نهت الكواشح عنه والعذالا % % فكأنما ملأت يديه وصالا % % 2(@)(@@) % أتظنها رحمته من ألم الجوى % % بمخلل يسترحم الخلخالا % % 3(@)(@@) % ظمآن يستقي أجاج دموعه % من عارض البرد الشنيب زلالا % % 4(@)(@@) % حتى إذ لذع الغرام فؤاده % شرب الغليل وأشرب البلبالا % % 5(@)(@@) % مضنى أزارته خيالا عائدا % % فكأنما زار الخيال خيالا % % 6(@)(@@) % لا يستجيب لسائل فكأنه % طلل ، وهل طلل يجيب سؤالا ؟ % 7(@)(@@) % كم سامع بالعين من آلامه % قيلا بأفواه الدموع وقالا % % 8(@)(@@) % إني طرفت بأعين في طرفها % % سحر يحل من العقول عقالا % % 9(@)(@@) % وفحصت عن سبب عصيت به النهى % % فوجدته ذلا يطيع دلالا % % 10(@)(@@) % وأنا الذي صيرت علق صبابتي % % بصبابتي للغانيات مذالا % % PageV01P531 11(@)(@@) % فتصيدتني ظبية إنسية % وأنا الذي أتصيد الرئبالا % % 12(@)(@@) % تجري الأراك على الأقاح وظلمها % % ريق ، أذقت الشهد والجريالا ؟ % 13(@)(@@) % وتريك ليلا في الذوائب يجتلي % % نورا عليك ظلامه وصقالا % % 14(@)(@@) % وإذا تداولت الولائد مشطه % عرض السرى بالمشط فيه وطالا % % 15(@)(@@) % وتنفست بالند فيه فخيمت % نار مواصلة به الإشعال % % 16(@)(@@) % يا هذه لقد انفردت بصورة % للحسن صور خلقها تمثالا % % 17(@)(@@) % أما الجفون فقد خلقن مقاتلا % مني ، فكيف خلقن منك نبالا ؟ % 18(@)(@@) % هل تطلعين علي بدرا عن رضى % فأراك عن غضب طلعت هلالا % % 19(@)(@@) % ألفيت برقك في المخيلة خلبا % ويمين عهدك في الوفاء شمالا % % 20(@)(@@) % ما هذه الفتكات في مهجاتنا % % هل كان عندك قتلهن حلالا ؟ % PageV01P532 21(@)(@@) % لم لا ترق لنا بقلبك قسوة % % اخلقت إلا غادة مكسالا ؟ % 22(@)(@@) % وظباك تصرع دائبا أهل الهوى % % وظبا علي تصرع الأبطالا % % 23(@)(@@) % ملك لنصر الله سل مجاهدا % % عضبا توقد بالمتون وسالا % % 24(@)(@@) % وإذا شدا في الهام خلت صليله % عملا وهز غراره استهلالا % % 25(@)(@@) % وكأنه من كل درع قدها % % يغري بأحداق الجراد نمالا % % 26(@)(@@) % ملك إذا نظم المكارم مثلت % يده بها التتميم والإيغالا % % 27(@)(@@) % فدع الهبات إذا ذكرت هباته : % تنسي البحور ذكرها الأوشالا % % 28(@)(@@) % ماض على هول الوقائع مقدم % كالسيف صمم ، والغضنفر صالا % % 29(@)(@@) % يرمي بثالثة الأثافي قرنه % فالأرض منها تشتكي الزلزالا % % 30(@)(@@) % فبأي شيء تتقي 
ms150	 من بأسه % % ما لو رمى جبلا به لانهالا % % PageV01P533 31(@)(@@) % يصلى حرور الموت من مدت له % % يمناه من ورق الحديد ظلالا % % 32(@)(@@) % هد الضلال فلم تقم عمد له % % وأقام من عمد الهدى ما مالا % % 33(@)(@@) % من سادة أهلاقهم وحلومهم % تتعرضان بسائطا وجبالا % % 34(@)(@@) % أقيال حمير لا يرد زمانهم % لهم ، بما أمروا به ، أقوالا % % 35(@)(@@) % وإذا الكريهة بالحتوف تسعرت % وغدت نواجذها قنا ونصالا % % 36(@)(@@) % واستحضر الليل النهار بظلمة % طلعت بها زهر النجوم إلالا % % 37(@)(@@) % نبذوا الدروع وقاربت أعمارهم % % نيل اللهاذم ، والظبا الآجالا % % 38(@)(@@) % حتى كأنهم بهجر حياتهم % % يجدون منها بالحمام وصالا % % 39(@)(@@) % فهم هم أسد الأسود براثنا % وأرق أبناء الملوك نعالا % % 40(@)(@@) % يا من تضمن فضله إفضاله % والفضل ما يتضمن الإفضالا % % PageV01P534 41(@)(@@) % عيدت بالإسلام مهتبلا له % في زينة خلعت عليه جمالا % % 42(@)(@@) % ولبست فيه على شعارك بالتقى % % من ربك الإعظام والإجلالا % % 43(@)(@@) % قدمت عد بنيك فيه لمن يرى % % ليث الكفاح يرشح الأشبالا % % 44(@)(@@) % في جحفل ملأ الهواء خوافقا % والسمع ركزا ، والفضاء رعالا % % 45(@)(@@) % وكأن أطراف الذوابل فوقه % % تذكي لإطفاء النفوس ذبالا % % 46(@)(@@) % بالخيل جردا ، والسيوف قواضبا % والبزل قودا ، والرماح طوالا % % 47(@)(@@) % وبعارض الموت الذي في طبه % % وبل يصب على عداك وبالا % % 48(@)(@@) % تركت ثعابين القفار شعابها % % وأسودها الآجام والأغيالا % % 49(@)(@@) % وأتت معولة على جيف العدى % % وحسبن سلمك بالعجاج قتالا % % 50(@)(@@) % خفقت بنود ظللت عذباتها % % بهما تبيد سيوفها الضلالا % % PageV01P535 51(@)(@@) % من كل جسم يحتسي من ريحه % % روحا يقيم بخلقه أشكالا % % 52(@)(@@) % وكأن أجيادا حباك جياده % % فكسوتهن من الجلال جلالا % % 53(@)(@@) % من كل ورد رائق كسميه % فتخال من شفق له سربالا % % 54(@)(@@) % أو أشقر كالصبح يعقل رادعا % هيق الفلاة وجأبها الذيالا % % 55(@)(@@) % أو أشعل كالسيد عرض سابحا % فحسبته بالأيطلين غزالا % % 56(@)(@@) % أو مشبه لعس الشفاه فكلما % % رشفته بالنظر العيون أحالا % % 57(@)(@@) % أو لابس ثوبا عليه مريشا % وصلت قوائمه به أذيالا % % 58(@)(@@) % أو أدهم كالليل ، أما لونه % % فلكم تمنى الحسن منه خيالا % % 59(@)(@@) % يطأ الصفا بالجزع منه زبرجد % فيثيره في جوه قسطالا % % 60(@)(@@) % والبزل تجنح 
ms151	 بالقباب كأنها % % سفن مدافعة صبا وشمالا % % PageV01P536 61(@)(@@) % وكأنما حملت ربى قد نورت % وسقين من صوب الربيع سجالا % % 62(@)(@@) % وكأنما زفت لهن عرائسا % لتحل مغنى عزك المحلالا % % 63(@)(@@) % بكرت تعالى للهلال وما انثنت % حتى رأيت ها الهلال تعالى % % 64(@)(@@) % صليت ثم نحرت في سنن الهدى % % بدنا كنحرك في الوغى الأقتالا % % 65(@)(@@) % وتبعت سنة أحمد وأريتنا % % من فعله في الفعل منك مثالا % % 66(@)(@@) % ثم انصرفت إلى قصورك تبتني % % مجدا وتهدم بالمكارم مالا % % 67(@)(@@) % وتؤكد الأسماء في ما تشتهي % % من همة ، وتصرف الأفعالا % % PageV01P537 البحر : بسيط تام 1(@)(@@) % ملاعب البيض بين البيض والأسل % تلاعبت بك حور الأعين النجل % 2(@)(@@) % فخذ من الرمح في حرب المها عوضا % فالطعن بالسمر غير الطعن بالمقل % 3(@)(@@) % كم للعلاقة من هيجا رأيت بها % % ضراغم الغيل قتلى من مها الكلل % % 4(@)(@@) % وكم غزالة إنس أنحلت جسدي % % بالهجر حتى حكى ما رق من غزل % % 5(@)(@@) % ممشوقة ملت عن حلمي إلى سفهي % % منها بقد مقيم الحسن في الميل % % 6(@)(@@) % تصد بالنفس عن سلوانها بهوى % % عين تكحل فيها السحر بالكحل % % 7(@)(@@) % خداعة الصب بالآمال مرسلة % إلي بالعض في التفاح والقبل % 8(@)(@@) % وناطق الوجد مني لا يكلمه % % منها إذا ما التقينا ساكت الملل % % 9(@)(@@) % يا هذه ، وندائي دمية طمع % في نطقها ، من فقيد اللب مختبل % 10(@)(@@) % أرى سهام لحاظ منك ترشقني % % أفي جفونك رام من بني ثعل ؟ % PageV01P538 11(@)(@@) % بل ضعف طرفك في سفك الدماء له % % أضعاف ما للظبا والنبل والأسل % 12(@)(@@) % إني امرؤ في ودادي ذو محافظة % فما يرى ف وفائي الخل من خلل % 13(@)(@@) % وعارض مد عرض الجو وانسبلت % في وجنة الأرض منه أدمع السبل % 14(@)(@@) % ثر الشآبيب ، أصوات الرعود به % % كأنهن هدير الجلة البزل % 15(@)(@@) % كأنما الأرض تجلو من حدائقها % % عرائسا في ضروب الحلي والحلل % % 16(@)(@@) % أحيا الإله بها الترب الموات كما % % أحيا سفاقس يحيى بالهمام علي % % 17(@)(@@) % كفؤ كفى الله في الدهر الغشيم به % % خطبا يخاطب منه ألسن العضل % 18(@)(@@) % أقر فيها أناسا في مواطنهم % % لما تنادوا لتوديع ومرتحل % 19(@)(@@) % وأثبت 
ms152	 الله أمنا في قلوبهم % % بعد التقلب في الأحشاء من وجل % % 20(@)(@@) % بيمن أكبر لا عاب يناط به % % يمناه منشأ صوب العارض الهطل % PageV01P539 21(@)(@@) % قوم تسوس رعاياه رعايته % بالرفق والعدل لا بالجور والعذل % 22(@)(@@) % من يتبع القول من إحسانه عملا % والقول يورق والإثمار للعمل % 23(@)(@@) % له رجاجة حلم عند قدرته % أرسى إذا طاشت الأحلام من ف % % 24(@)(@@) % في دولة في مقر العز ثابتة % تملي العلى من سجاياه على الدول % % 25(@)(@@) % أغر كالبدر يعلو سرجه أسد % أظفاره حمر أطراف القنا الذبل % 26(@)(@@) % بادي التبسم والهيجاء كالحة % لا يتقي العض من أنيابها العصل % % 27(@)(@@) % ترى السلاهب من حوليه ساحبة % ذيل العجاج على الأجساد والقلل % % 28(@)(@@) % من كل ذي ميعة كالبحر تحسب من % أزباده سردت ماذية البطل % 29(@)(@@) % تنضو به ملة الإسلام مرهفة % بضربهن الطلى تعلو على الملل % 30(@)(@@) % قديمة طبعتهن القيون على % % ماضي العزائم من آبائه الأول % PageV01P540 31(@)(@@) % من كل أبيض في يمناه ، سلته % كالبرق ، يخطف عمر القرن بالأجل % % 32(@)(@@) % جداول ترد الهيجا فهل وردت % ماء الطلى عن تباريج من الغلل % 33(@)(@@) % ندب تداوي من الأقوام شيمته ، % بالبأس والجود ، داء الجبن والبخل % % 34(@)(@@) % مستهدف الربع بالقصاد تقصده % في البحر بالفلك أو في البر بالإبل % 35(@)(@@) % منزه النفس سمح ما له أمل % إلا مكارم يحويها بنو الأمل % % 36(@)(@@) % أطاعني زمني لما اعتصمت به % % حتى حسبت زماني عاد من خولي % % 37(@)(@@) % وما تيقنت أني قبل رؤيته % ألقى كرام البرايا منه في رجل % % 38(@)(@@) % يا صاحب الحلم والسيف الذي خمدت % نار المنية فيه عن ذوي الزلل % % 39(@)(@@) % لو أن عزمك حد في الكهام لما % % قد الضرائب إلا وهو في الخلل % % 40(@)(@@) % كأن ذكرك والدنيا به عبقت % في البأس والجود مخلوع عن المثل % % PageV01P541 41(@)(@@) % فاسلم لمدحك واقن العز ما سجعت % سواجع الطير بالأسحار والأصل % PageV01P542 البحر : خفيف تام 1(@)(@@) % حركات إلى السكون تؤول % % كل حال مع الليالي تحول % 2(@)(@@) % لا يصح البقاء في دار دنيا % % ومتى صح في النهى المستحيل ؟ % 3(@)(@@) % والبرايا أغراض نبل المنايا % % وهي أسد ، لها 
ms153	 من الدهر غيل % 4(@)(@@) % كيف لا تسلب النفوس وتردي % % ولها في الحياة مرعى وبيل % 5(@)(@@) % مات من قبل ذا أبوك بداء % أنت من أجله الصحيح العليل % % 6(@)(@@) % وإذا اجتث أصل فرع تبقى % % فيه ماء من الحياة قليل % 7(@)(@@) % ما لنا نتبع الأماني هلا % عقلتنا عن الأماني العقول % % 8(@)(@@) % كم جريح تعلق الروح منه % % بالتمني والجسم منه قتيل % 9(@)(@@) % وبطيء الآمال يسعى بحرص % خطف العيش منه حتف عجول % 10(@)(@@) % عمي الخلق عن تعادي خيول % ما لها في الهواء نقع مهيل % PageV01P543 11(@)(@@) % تنقل الناس من حياة إلى مو % % ت ، على ذاك مر جيل فجيل % 12(@)(@@) % وبدهم تمر منها وشهب % أمن الليل والنهار خيول ؟ % 13(@)(@@) % سهلوا من نفوسهم كل صعب % فالردى لا يقبل من يستقيل % 14(@)(@@) % واستدلوا على النفاد بعاد : % يذهب الشك باليقين الدليل % 15(@)(@@) % أي رزء حكاه مقول ناع % صم هذا الزمان عما يقول % 16(@)(@@) % فلقد فتت القلوب وكادت % راسيات الجبال منه تزول % 17(@)(@@) % لم يمت أحمد أخو البأس حتى % % مات ما بيننا العزاء الجميل % % 18(@)(@@) % يوم قامت بفقده نائحات % في لبوس من حزنهن يهول % 19(@)(@@) % غمست في السواد بيض وجوه % فكأن الطلوع فيه أفول % 20(@)(@@) % وعلى مجلس التنعم بؤس % فبديل السماع فيه العويل % % PageV01P544 21(@)(@@) % وتولت عند التناهي افتراقا % ومضى ربه الوفي الوصول % % 22(@)(@@) % أسمع الرعد فيه صرخة حزن % ملء ليل الحزين فيه أليل % % 23(@)(@@) % ودموع السماء في كل أرض % فوق خد الثرى عليه تجول % 24(@)(@@) % وحشا الجو حشوه نار برق % إن في ضلوعه لغليل % 25(@)(@@) % أترى الغيث بات يبكي أخاه % % فبكاء العلى عليه طويل % 26(@)(@@) % قائد الخيل بالكماة سراعا % والضحى من قتامهن أصيل % % 27(@)(@@) % أي فضل نبكيه منك بدمع % ساكب ، فيه كل نفس تسيل % 28(@)(@@) % أعفافا أم نجدة كنت فيها % % قسور الغيل والكريهة غول % % 29(@)(@@) % أم شبابا كأنما كان روضا % ناضرا فاغتدى عليه الذبول % % 30(@)(@@) % واكتسى في ثرى تغيب فيه % % صدأ ذلك الجبين الصقيل % PageV01P545 31(@)(@@) % كنت كالسيد للعدى ، والمنايا % % مقبلات كأنهن سيول % % 32(@)(@@) % ولصوب السهام حوليك وبل % لاخضرار الحياة منه ذبول 
ms154	 % % 33(@)(@@) % طار صرف الردى إليك برشق % خف ، والخطب في شباه ثقيل % 34(@)(@@) % سهم غرب أصاب ضيغم حرب % خاض في العيش منه نصل قتول % 35(@)(@@) % هابك الموت إذ رآك مسحا % بطلا ، لا يصول حيت تصول % % 36(@)(@@) % لو بدا صورة إليك لأضحى % % في ثرى القبر وهو منك بديل % % 37(@)(@@) % فرمى عن دجنة النقع نحرا % % منك ، والجو بالظلام كحيل % % 38(@)(@@) % وإذا خاف من شجاع جبان % غاله منه جاهدا ما يغول % 39(@)(@@) % كنت سهم البلاء يرفع سهم % فيه للنفس بالحمام رسول % % 40(@)(@@) % كم جواد بكاك غير صبور % فنياح عليك منه الصهيل % % PageV01P546 41(@)(@@) % وحسام أطال في الجفن نوما % لم ينبهه بالقراع الصليل % % 42(@)(@@) % أيها القائد الأبي عزاء % فثواء المقيم منا رحيل % 43(@)(@@) % وجليل مصاب أحمد لكن % يصبر النفس للجليل الجليل % PageV01P547 البحر : بسيط تام 1(@)(@@) % حرر لمعناك لفظا كي تزان به % % وقل من الشعر سحرا أو فلا تقل % 2(@)(@@) % فالكحل لا يفتن الأبصار منظره % حتى يصير حشو الأعين النجل % % PageV01P548 البحر : خفيف تام 1(@)(@@) % ومديد الخطى كأنك منه % % تضع اللبد فوق تيار سيل % 2(@)(@@) % قيد وحش ، ملاذ خائر وهن % وقرى معقل ، وحارس ليل % 3(@)(@@) % أسبق الريح فوقه فإذا ما % % فتها أمسكت بفضلة ذيلي % % PageV01P549 البحر : متقارب تام 1(@)(@@) % أرى الموت مرتعه في الفحول % % وأعننت للأخطئات الأمل ؟ % 2(@)(@@) % وربتما سال بعض النفوس % % وبعض لها بالمنى مشتغل % % PageV01P550 البحر : طويل 1(@)(@@) % أيا رب عفوا عن ظلوم لنفسه % رجاك وإن كان العفاف به أولى % % 2(@)(@@) % مقيم على فعل المعاصي مخالف % توالى عليه الغي . . . . فاستولى % % 3(@)(@@) % سألتك يا مولى الموالي ضراعة % وقد يضرع العبد الذليل إلى المولى % % 4(@)(@@) % لتصلح لي قلبا ، وتغفر زلة % وتقبل لي توبا ، وتسمع لي فعلا % % 5(@)(@@) % ولا عجب فيما تمنيت ، إنني % % طويل الأماني عند من يحسن الطولا % % PageV01P551 البحر : رمل تام 1(@)(@@) % أي روح لي في الريح القبول % % وسراها من رسومي وطلولي % % 2(@)(@@) % وظباء أمنت من قانص % لم ينلها الصيد في ظل المقيل % 3(@)(@@) % نشرت عندي أسرار هوى % % كنت أطويهن عن كل خليل % 4(@)(@@) % وأشارت بالرضى ، رب رضى % عنك يبدو 
ms155	 في شهادات الرسول % 5(@)(@@) % عجبي كيف اهتدت مهدية % خصر الري إلى حرج الغليل % % 6(@)(@@) % ما درت مضجع نومي إنما % % دلها ليلي عليه بأليلي % % 7(@)(@@) % لست أبغي لسقامي آسيا % فبلولي منه بالريح البليل % % 8(@)(@@) % طرفه أشعث كالسيف سرى % % حده بين مضاء ونحول % % 9(@)(@@) % عبرت بحرا إليه واتقت % حوله بحرا من الدمع الهمول % % 10(@)(@@) % يا قبولا قد جلا صيقله % صدأ عن صفحة الماء الصقيل % PageV01P552 11(@)(@@) % عاودي منك هبوبا فيه لي % % وجد البرء عليل بعليل % 12(@)(@@) % كرياح عللتني بمنى % كدن يثبتن جواز المستحيل % % 13(@)(@@) % أصبا هبت بريحان الصبا % % أو شمال أسكرتني بالشمول % % 14(@)(@@) % حيث غنتني شوادي روضة % مطربات بخفيف وثقيل % % 15(@)(@@) % في أعاريض قصار خفيت % دقة في الوزن عن فهم الخليل % % 16(@)(@@) % ولحون حار فيها معبد % وله علم بموسيقى الهديل % % 17(@)(@@) % والدجى يرنو إلى إصباحه % بعيون من نجوم الجو حول % 18(@)(@@) % خاف من سيل نهار غرقا % فتولى عنه مبلول الذيول % % 19(@)(@@) % زرع الشيب بفودي الأسى % % فنما منه كثير من قليل % 20(@)(@@) % فحسبت البيض منه أنجما % عن بياض لاذ مني بالأفول % % PageV01P553 21(@)(@@) % كل من ينظر من عطف الصبا % % نظر المعجب بالخلق الجميل % 22(@)(@@) % فجوازي باضطرار عندها % % كجواز الفتح في الحرف الدخيل % 23(@)(@@) % كيف لي منها إذا ما غضبت % برحتني محنة السخط القتول % % 24(@)(@@) % غادة يأخذ منها بابل % طرف السحر عن الطرف الكحيل % % 25(@)(@@) % فإذا قابل منها لحظها % % فللت منه حديدا بكليل % PageV01P554 البحر : كامل أحذ 1(@)(@@) % أظلوم منك تعلمت ظلمي % % حربا وكانت قبل ذا سلمى % % 2(@)(@@) % كانت بهجري غير عالمة % فهديتها منه إلى علم % 3(@)(@@) % هذا وفاق عن مخالفة % كالزير تصلحه على البم % 4(@)(@@) % خود تلقن تربها حججا % كالبنت مصغية إلى الأم % 5(@)(@@) % والغادتان تفيض بينهما % % خدع الهوى وقطيعة الحلم % 6(@)(@@) % إن النواعم في العتاب لها % % غرض إليه جميعها ترمي % % 7(@)(@@) % لو قد وقفت على ضنى جسدي % % لوقفت باكية على رسم % 8(@)(@@) % ورأيت أضدادا أذوب بها : % حرقا تشب ، وأدمعا تهمي % % 9(@)(@@) % وبنفسي الخود التي برئت % في قتلها نفسي من الاثم % % 10(@)(@@) % لمياء تبسم عن مؤشرة 
ms156	 % تجلو الظلام ببارق الظلم % PageV01P555 11(@)(@@) % وتخوض من سفه الصبا ملحا % فتحل منك معاقد الحلم % % 12(@)(@@) % مرت تميس فقلت : هل سكرت % من ريقها بسلافة الكرم % % 13(@)(@@) % كمنعم الأطراف ، بلله % شرق النسيم بريقه الوسمي % % PageV01P556 البحر : طويل 1(@)(@@) % وليل رسبنا في عباب ظلامه % إلى أن طفا للصبح في أفقه نجم % 2(@)(@@) % كأن الثريا فيه سبع جواهر % فواصلها جزع به فصل النظم % % 3(@)(@@) % وتحسبها من عسكر الشهب سربة % عمائمهم بيض ، وخيلهم دهم % 4(@)(@@) % كأن السها مصنى أتاه بنعشه % بنوه وظنوا أن موتته حتم % 5(@)(@@) % كأن انصداع الفجر نار يرى لها % % وراء حجاب حالك نفس يسمو % % 6(@)(@@) % وتحسبه طفلا من الروم طرقت % به من بنات الزنج قائمة أم % 7(@)(@@) % أأعلم في أحشائها أن عمره % لدى وضعه يوم ، فشيبه الوهم ؟ % 8(@)(@@) % وذرت لنا شمس النهار مذيبة % على الأرض روحا في السماء له جسم % % PageV01P557 البحر : سريع 1(@)(@@) % أرسلت طرفي يقتفي طرفها % % وعدا به أبرىء أسقامي % % 2(@)(@@) % فعاد عنه للحشا جارحا % كرجعة السهم إلى الرامي % % 3(@)(@@) % فقاتلي طرفي لا طرفها % % والجفن من جرح الحشا دام % PageV01P558 البحر : طويل 1(@)(@@) % وطيبة الأنفاس تحسب وصلها % % ومن واصلته جنة المتنعم % 2(@)(@@) % تفتح ورد الخد في غصن قدها % % ونور فيه أقحوان التبسم % 3(@)(@@) % كأن استماع اللفظ منها تعلل % بلذة راح واقتراح ترنم % % 4(@)(@@) % تحدثني بالسر في ثني ساعدي % % فيسمع نجوى السر من فمها فمي % % 5(@)(@@) % إذا ما الثريا رحل الليل شمله % % لها في يد الإصباح باقة أنجم % 6(@)(@@) % وجدت ثناياها العذاب كأنما % % تعل بمسك في رحيق مختم % % PageV01P559 البحر : طويل 1(@)(@@) % بحكم زمان يا له كيف يحكم % يحرم أوطانا علينا فتحرم % 2(@)(@@) % لقد أركبتني غربة البين غربة % إلى اليوم عن رسم الحمى بي ترسم % 3(@)(@@) % إذا كل عني من سنا الصبح أشهب % تناول حملي من دجى الليل أدهم % % 4(@)(@@) % وتحسبه يرتاض في غرس حمله % % ويسرج فيه للركوب ويلجم % % 5(@)(@@) % لكل زمان واعظ ، وعظه كما % % يخط كلاما بالإشارة أبكم % % 6(@)(@@) % وحاد رمى بالعيس كل مضلة % كأن عليه مجهل الفيح معلم % % 7(@)(@@) % وقد نحرت في كل 
ms157	 شرق ومغرب % % عليها نحور البيد في العزم أسهم % 8(@)(@@) % وأوجف حوليها الكماة ضوامرا % % فلا سنب ك إلا يساويه منسم % % 9(@)(@@) % فمن راكب يأتي به الخصب بازل % ومن فارس يصلى به الحرب شيظم % % 10(@)(@@) % فإن تسر في ليل وجيش فإنها % % سفائن بر بين بحرين عوم % % PageV01P560 11(@)(@@) % وصيد يصيدون الفوارس بالقنا % % إذا نكل الأبطال في الروع أقدموا % % 12(@)(@@) % ويستطعمون السمر والبيض إنها % % نيوب وأظفار بها الأسد تطعم % 13(@)(@@) % دعتهم بروق بالأكف مشيرة % إليهم ، وعين عرفها يتنسم % % 14(@)(@@) % عصا شملهم شقت فشرق منجد % إلى طية منهم ، وغرب متهم % % 15(@)(@@) % وما قد قد السير بالطول سيرهم % % ولكنما المنقد قلبي المتيم % % 16(@)(@@) % طوى البعد عنا ، فانطوينا على الجوى % % نواعم تشقي بالنعيم ، وتنعم % % 17(@)(@@) % دعونا نساير حاديا قاد نحوها % % مسامعنا منه الحداء المنغم % % 18(@)(@@) % فما هذه الأحداج إلا قلوبنا % % حبائبنا فيها سرائر تكتم % 19(@)(@@) % بنفسي من حور المها غادة لها % % فم عن شديد الخوف بالصمت ملجم % % 20(@)(@@) % ينم عليها طيب ريا كلامها % % فيدري غيور أنصها تتكلم % % PageV01P561 21(@)(@@) % أرجع بالشوق الحنين وإنما % % يهيج حنيني عودها حين يرزم % 22(@)(@@) % قد سفرت في توضح فتوضحت % مسالكه للسفر ، والليل مظلم % 23(@)(@@) % ومرت على سقط اللوى فتساقطت % دموع عليها ، درها لا ينظم % % 24(@)(@@) % وقد ضرجت ثوبي لدى عين ضارج % علي جفون ، ماؤها بالأسى دم % 25(@)(@@) % معاهد مازال امرؤ القيس بينها % % يعبر عن عهد الهوى ويترجم % 26(@)(@@) % توهمتها حلما بها فذكرتها % % وقد يذكر الإنسان ما يتوهم % 27(@)(@@) % وإني لآوي من زمان لبسته % إلى ذكر تأسو فؤادى وتكلم % % 28(@)(@@) % ليالي تسبي اللب منه سبيئة % تناولها من كافر القلب مسلم % % 29(@)(@@) % سلافة كرم ليس يسخو بمثلها % % لغير فتى تحظى لديه وتكرم % % 30(@)(@@) % يطاف بها في حمرة الورد جوهرا % له عرض وهو السرور المحرم % PageV01P562 31(@)(@@) % يسيغ فمي في شدة السكر صرفها % % وما فرحة في السمع إلا الترنم % 32(@)(@@) % فلله عمر مر بي فكأنني % % به في جنان الخلد قد كنت أحلم % 33(@)(@@) % ليالي روض العيش غض وماؤه % نمير ، ومنقوض الشبيبة مبرم % % PageV01P563 البحر : سريع 1(@)(@@) % يا دار 
ms158	 سلمى لو رددت السلام % ما هم فيك الحزن بالمستهام % 2(@)(@@) % همود رسم منك تحت البلى % % محرك مني سكون الغرام % 3(@)(@@) % لمت عليك الدهر في صرفه % وقلت للأحداث صمي صمام % 4(@)(@@) % وقام في الخبر لمستخبر % سكوت مغناك مقام الكلام % % 5(@)(@@) % يا بارق الجو تبسم بها % % وابك عليها بدموع الغمام % 6(@)(@@) % وحلها بالنور من روضة % تفض عن فأرة مسك ختام % 7(@)(@@) % حتى أرى عنها ظباء الفلا % % مرحلات بظباء الخيام % % 8(@)(@@) % من كل هيفاء غلامية % ملتبس بالغصن منها القوام % % 9(@)(@@) % تدير عيني رشإ فيهما % % من فترة الطرف شبيه السقام % % 10(@)(@@) % تروح والعنبر والعود في % % ليل من الفرع صقيل الظلام % % PageV01P564 11(@)(@@) % تمنع أخت الشمس منها فما % فيه أخو الدر وأخت المدام % % 12(@)(@@) % لو أن لي حكما بربع الحمى % % أعطيته من كل خطب ذمام % % 13(@)(@@) % حتى أرى بالوصل حبل الهوى % % لا يتقى بالبين منه انصرام % % PageV01P565 البحر : طويل 1(@)(@@) % رعى ورق البيض الذي زهره دم % بهم ورقا عن زهره الروض يبسم % 2(@)(@@) % جبابرة في الروع تعدو جيادهم % % بهم فوق ما سح الوشيج المقوم % 3(@)(@@) % تنوء بهم في ذبل الخط أنجم % سحائبها نقع ، وأمطارها دم % % 4(@)(@@) % ترحل من آجامها الأسد خيفة % إذا نزلوا للرعي فيها وخيموا % % 5(@)(@@) % ترى كل جو من قناهم ونقعهم % يكوكب إن ساروا بهم ويعتم % 6(@)(@@) % فصاح غداة الروع عز سكوتهم % % وألسنة الأغماد عنهم تترجم % 7(@)(@@) % كأن بأيديهم إذا ضربوا الطلى % % عزائمهم ، لو أنها تتجسم % 8(@)(@@) % إذا ما استوى فعل المنايا وفعلهم % بأرواح أبطال الوغى فهم هم % 9(@)(@@) % أعاريب ألقى في نتيجات حيهم % لهم أعوج ما يوجفون وشدقم % % 10(@)(@@) % صحبتهم في موحش الأرض مقفر % به الذئب يعوي والغزالة تبغم % % PageV01P566 11(@)(@@) % سقى الله عينا عذبة الدمع أن بكت % حظارا بها للجسم قلب متيم % % 12(@)(@@) % بلاد تلاقيني الدراري كلما % % طلعن عليها وهي عنهن نوم % % 13(@)(@@) % بأرض يميت الهم عنك سرورها % % ويمحو ذنوب البؤس فيها التنعم % 14(@)(@@) % وكم لي بها من خل صدق مساعد % مهين العطايا ، وهو للعرض مكرم % % 15(@)(@@) % يفيض على أيدي العفاة سماحة % على أنه 
ms159	 من نجدة يتضرم % 16(@)(@@) % إذا فرت الأبطال كر ، وسيفه % % يحل بيمناه دم العلج ، محرم % % 17(@)(@@) % يموج به بحره كأن حبابه % عليه دلاص سردها منه يحكم % % 18(@)(@@) % ونحن بنو الثغر الذين ثغورهم % إذا عبست حرب لهم تتبسم % 19(@)(@@) % ومن حلب الأوداج يغذى فطينا % % بحجر من الهيجاء ساعة يفطم % 20(@)(@@) % لنا عجز الجيش اللهام وصدره % بحيث صدور السمر فينا تحطم % PageV01P567 21(@)(@@) % يضاعف إن عد الفوارس عدنا % % كأن الشجاع الفرد فينا عرمرم % % 22(@)(@@) % نؤخر للإقدام في كل ساقة : % تأخر ما يلقى الحتوف تقدم % % 23(@)(@@) % فإن كان للحرب العوان معول % علينا فما كل الكواكب ترجم % % 24(@)(@@) % وتنسج يوم الروع من نسج جردنا % % علينا ملاء بالقشاعم ترقم % % 25(@)(@@) % فمن كل مقدام على أعوجية % بكراتها طير الملاحم تلحم % % 26(@)(@@) % وطائرة بالذمر ملء عنانها % % لها الفضل في شأو البروق مسلم % % 27(@)(@@) % رمينا عداة الله في عقر دارهم % % بعادية في غمرة الموت تقحم % 28(@)(@@) % تعوم بها من بين العلوج مظلة % كما حلقت فتخ على الجو حوم % % 29(@)(@@) % فمن حامل من غير فحل ينيخها % % إذا وضعت في ساحل الروم صيلم % 30(@)(@@) % ومنسوبة للحرب منشأة لها % % طوائر بالآساد في الماء عوم % % PageV01P568 31(@)(@@) % كأن قسيا في مواخرها التي % % يفرق منها في المقادم أسهم % 32(@)(@@) % وترسل نفطا يركب الماء محرقا % كمهل به تشوى الوجوه جهنم % % 33(@)(@@) % مدائن تغزو للعلوج مدائنا % فتفتح قسرا بالسيوف وتغنم % 34(@)(@@) % ومتخذي قمص الحديد ملابسا % إذا نكل الأبطال في الحرب أقدموا % % 35(@)(@@) % كأنهم خاضوا سرابا بقيعة % ترى للدبا فيها عيونا عليهم % 36(@)(@@) % صبرنا لهم صبر الكرام ولم يسغ % لنا الشهد إلا بعدما ساغ علقم % % 37(@)(@@) % فغادر أفواها بهم هبر ضربنا % % نواجذها من مرهفات تثلم % % 38(@)(@@) % وإن بأيدينا الحديد لناطق % إذا ما غدا في غيرها ، وهو أبكم % % 39(@)(@@) % وأجنحة الرايات فينا خوافق % كأن دم الأبطال فيهن عدم % 40(@)(@@) % أمن أبرق بالدرار أومض بارق % كطائش كف بالبنان يسلم % % PageV01P569 41(@)(@@) % مرى من عيون ساهرات مدامعا % وكحلها بالنور والليل مظلم % % 42(@)(@@) % فيا عجبا من زورة زار طيفها % % جفونا من التهويم فيها توهم 
ms160	 % % 43(@)(@@) % ألم بساقي عبرة حد قفرة % % بمنسم حرف كلما بل يلطم % % 44(@)(@@) % وأهدى أريجا من شذاها ودونها % % لمقتحم الأهوال سهب وخضرم % % 45(@)(@@) % وللصبح نور في الظلام كما اكتسى % % حميما بطول الركض في الصدر أدهم % % 46(@)(@@) % أحن إلى أرضي التي في ترابها % % مفاصل من أهلي بلين وأعظم % 47(@)(@@) % كما حن في قيد الدجى بمضلة % إلى وطن عود من الشوق يرزم % % 48(@)(@@) % وقد صفرت كفاي من ريق الصبا % % ومني ملآن بذكر الصبا فم % % PageV01P570 البحر : طويل 1(@)(@@) % بني الثغر لستم في الوغى من بني أمي % % إذ لم أصل بالعرب منكم على العجم % 2(@)(@@) % دعوا النوم إني خائف أن تدوسكم % دواه ، وأنتم في الأماني مع الحلم % 3(@)(@@) % وكأس بأم الموت يسعى مديرها % % إلى أهل كأس حثها بابنة الكرم % % 4(@)(@@) % فردوا وجوه الخيل نحو كريهة % مصرحة في الروم بالثكل واليتم % 5(@)(@@) % تهيل من النقع المحلق بالضحى % % على الشمس ما هالته ليلا على النجم % 6(@)(@@) % وصولوا ببيض في العجاج كأنها % % بروق بضرب الهام محمرة السجم % % 7(@)(@@) % ولا عدمت في سلها من غمودها % % ظهورا فقد تخفى الجداول بالرجم % % 8(@)(@@) % وقرع الحسام الرأس من كل كافر % أحب إلى سمعي من النقر في البم % 9(@)(@@) % ولله منكم كل ماض كعضبه % يسيل إلى الهيجاء متقد العزم % 10(@)(@@) % يحدث بالإقدام نفسا كأنما % % يطير إلى الحرب اشتياقا عن السلم % % PageV01P571 12(@)(@@) % ويسطو بمحجوب الظبات إذا بدا % % جلا ما جلا الإصباح من ظلمة الظلم % % 13(@)(@@) % له دخلة في الجسم تخرج نفسه % قبيل خروج الحد منه عن الجسم % % 15(@)(@@) % ثبوت إذا ما أقبل الموت فاغرا % يردد في الأسماع جرجرة القرم % 16(@)(@@) % له عين ضرغام هصور ، فقلبه % بتصريف فعل الجهل منه على علسم % % 17(@)(@@) % ولله أرض إن عدمتم هواءها % % فأهواؤكم في الأرض منثورة النظم % 18(@)(@@) % وعزكم يفضي إلى الذل والنوى % % من البين ترمي الشمل منكم بما ترمي % % 19(@)(@@) % فإن بلاد الناس ليست بلادكم % ولا جارها والخلم كالجار والخلم % 20(@)(@@) % أعن أرضكم يغنيكم أرض غيركم % % وكم خالة جداء لم تغن عن أم % 21(@)(@@) % أخلي الذي ودي بود 