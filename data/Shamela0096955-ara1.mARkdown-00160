ms141	 وحديثه منكر.(@)(@@)(@@)(@@) $ 3519 - مالك بن مالك: شيخ لأبي إسحاق السبيعي: مجهول.(@)(@@)(@@)(@@) $ 3520 - مالك بن أبي المؤمل: شيخ لعبيد الله بن زحر: مجهول.(@)(@@)(@@)(@@) $ 3521 - مالك بن نمير الخزاعي: عن أبيه، تابعي: مجهول. -د، س، ق-(@)(@@)(@@)(@@) $ 3522 - مالك بن يحيى، أبو غسان النكري: عن أبيه، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3523 - مالك بن يسار: عن ابن الزبير، وعنه زيد بن هاشم: مجهولان.(@)(@@)(@@)(@@) || مأمون(@)PageV01P335(@)(@@)(@@)(@@) $ 3524 - مأمون بن أحمد السلمي: عن هشام بن عروة، كذاب.(@)(@@)(@@)(@@) $ 3525 - مأمون بن العائذي: عن علي، قال الأزدي: زائغ لا يحتج به.(@)(@@)(@@)(@@) || مبارك(@)PageV01P335(@)(@@)(@@)(@@) $ 3526 - مبارك بن حسان: عن عطاء، قال الأزدي: رمي بالكذب. -ت-(@)(@@)(@@)(@@) $ 3527 - مبارك بن أبي حمزة: عن عبد الله بن فروخ: مجهولان.(@)(@@)(@@)(@@) $ 3528 - مبارك بن سحيم: له نسخة، قال أبو زرعة: ما أعرف له حديثا صحيحا. -ق-(@)(@@)(@@)(@@) $ 3529 - مبارك بن سعد: عن يحيى بن أبي كثير اليمامي: مجهول. -س-(@)(@@)(@@)(@@) $ 3530 - مبارك بن فضالة: ضعفه أحمد، والنسائي، وكان يدلس. -د، ت، ق-(@)(@@)(@@)(@@) $ 3531 - مبارك بن مجاهد المروزي: عن عبد الله بن عمر، ضعفه قتيبة.(@)(@@)(@@)(@@) $ 3532 - مبارك بن همام: تابعي: مجهول.(@)(@@)(@@)(@@) || مبشر(@)PageV01P335(@)(@@)(@@)(@@) $ 3533 - مبشر بن عبيد: عن الزهري، قال أحمد: كان يضع الحديث. -ق-(@)(@@)(@@)(@@) $ 3534 - مبشر بن فضيل: شيخ لسيف التميمي، لا يعرف.(@)(@@)(@@)(@@) $ 3535 - مبشر السعيدي: عن الزهري، كأنه الأول.(@)(@@)(@@)(@@) || متوكل(@)PageV01P336(@)(@@)(@@)(@@) $ 3536 - متوكل بن عدي: عن الحسن، ومتوكل بن الفضل مجهولان.(@)(@@)(@@)(@@) || المثنى(@)PageV01P336(@)(@@)(@@)(@@) $ 3537 - المثنى بن بكر. والمثنى بن دينار القطان: مجهولان.(@)(@@)(@@)(@@) $ 3538 - المثنى بن الصباح: ضعفه ابن معين، وقال النسائي: متروك. -د، ت، ق-(@)(@@)(@@)(@@) $ 3539 - المثنى بن عمرو: عن أبي سنان: مجهول، خط عليه ابن حبان.(@)(@@)(@@)(@@) $ 3540 - المثنى بن يزيد الثقفي: مجهول.(@)(@@)(@@)(@@) || مجاشع(@)PageV01P336(@)(@@)(@@)(@@) $ 3541 - مجاشع بن عمرو: عن عبيد الله بن عمر، قال ابن حبان: يضع الحديث.(@)(@@)(@@)(@@) $ 3542 - مجاشع بن يوسف: عن يزيد بن ربيعة، عن واثلة، ضعيف.(@)(@@)(@@)(@@) || مجاعة(@)PageV01P336(@)(@@)(@@)(@@) $ 3543 - مجاعة بن ثابت: عن ابن لهيعة، ليس بثقة.(@)(@@)(@@)(@@) $ 3544 - مجاعة بن الزبير: عن أبان، ضعفه الدارقطني.(@)(@@)(@@)(@@) || مجالد(@)PageV01P337(@)(@@)(@@)(@@) $ 3545 - مجالد بن أبي راشد: عن ابن مسعود، قال أحمد: ليس بشيء.(@)(@@)(@@)(@@) $ 3546 - مجالد بن سعيد: قال أحمد: ليس بشيء، 
ms142	 وقال غير واحد: ضعيف. -عه، م، تبعا-(@)(@@)(@@)(@@) || محاضر(@)PageV01P337(@)(@@)(@@)(@@) $ 3547 - محاضر بن المورع: مستقيم الحديث، قال أحمد: مغفل جدا. -م، د، س-(@)(@@)(@@)(@@) || محبر(@)PageV01P337(@)(@@)(@@)(@@) $ 3548 - محبر بن قحذم: روى عنه ابنه داود، وهما متروكان.(@)(@@)(@@)(@@) || محبوب(@)PageV01P337(@)(@@)(@@)(@@) $ 3549 - محبوب بن الجهم: عن عبيد الله بن عمر، لينه غير واحد.(@)(@@)(@@)(@@) $ 3550 - محبوب بن الحسن القرشي: قواه ابن معين، ولينه أبو حاتم. -خ، ت-(@)(@@)(@@)(@@) $ 3551 - محبوب بن محرز: عن أبي مالك النخعي، ضعفه الدارقطني. -ت-(@)(@@)(@@)(@@) || محتسب(@)PageV01P337(@)(@@)(@@)(@@) $ 3552 - محتسب بن عبد الرحمن، أبو عائذ البصري: عن ثابت، وعنه أبو عبيدة الحداد، وعرعرة بن البرند، له مناكير.(@)(@@)(@@)(@@) || محجن(@)PageV01P338(@)(@@)(@@)(@@) $ 3553 - محجن: عن عثمان رضي الله عنه، لا يصح ذلك.(@)(@@)(@@)(@@) || محدوج(@)PageV01P338(@)(@@)(@@)(@@) $ 3554 - محدوج الذهلي: عن جسرة، قال البخاري: فيه نظر. -ق-(@)(@@)(@@)(@@) || محرر(@)PageV01P338(@)(@@)(@@)(@@) $ 3555 - محرر بن هارون التيمي المدني: عن الأعرج، ضعفوه. -ت-(@)(@@)(@@)(@@) || محفوظ(@)PageV01P338(@)(@@)(@@)(@@) $ 3556 - محفوظ بن بحر الأنطاكي: قال أبو عروبة: كان يكذب.(@)(@@)(@@)(@@) $ 3557 - محفوظ بن أبي توبة: عن عبد الرزاق، ضعف أمره.(@)(@@)(@@)(@@) || محل(@)PageV01P338(@)(@@)(@@)(@@) $ 3558 - محل بن محرز الضبي: قال ابن حبان: يستحق الترك لكثرة خطأه. -بخ-(@)(@@)(@@)(@@) || محمد(@)PageV01P338(@)(@@)(@@)(@@) $ 3559 - محمد بن أحمد بن أنس: عن أبي عامر العقدي، ضعيف.(@)(@@)(@@)(@@) $ 3560 - محمد بن أحمد بن حسين الجريجي: قال ابن عدي: روى عمن لم يره كبندار.(@)(@@)(@@)(@@) $ 3561 - محمد بن أحمد بن عثمان، أبو طاهر المديني: قال ابن عدي: يغلط ويثبت عليه.(@)(@@)(@@)(@@) $ 3562 - محمد بن أحمد بن سهيل الباهلي: أدركه ابن عدي، وكان يضع الحديث.(@)(@@)(@@)(@@) $ 3563 - محمد بن أحمد بن يزيد البلخي: عن عبد الأعلى بن حماد، قال ابن عدي: يسرق الحديث.(@)(@@)(@@)(@@) $ 3564 - محمد بن أحمد بن مهدي، أبو عمارة: قال الدارقطني: ضعيف جدا.(@)(@@)(@@)(@@) $ 3565 - محمد بن أحمد بن عيسى، أبو الطيب: كتب عنه ابن عدي، ورماه بالوضع.(@)(@@)(@@)(@@) $ 3566 - محمد بن أحمد بن حماد، أبو بشر الدولابي: قال الدارقطني: تكلموا فيه.(@)(@@)(@@)(@@) $ 3567 - محمد بن أحمد بن حمدان، أبو الطيب الرسعني: عن إسحاق بن شاهين، كذاب.(@)(@@)(@@)(@@) $ 3568 - محمد بن أحمد، أبو الفرج الشنبوذي المقري: تكلموا فيه.(@)(@@)(@@)(@@) $ 3569 - محمد بن أحمد بن عروة: عن أبي العباس الأصم، ليس بثقة.(@)(@@)(@@)(@@) $ 3570 - محمد بن 
ms143	 أحمد بن محمد، أبو بكر المفيد: نزل جرجرايا، ضعفوه.(@)(@@)(@@)(@@) $ 3571 - محمد بن أحمد بن يزيد السلمي: كتب عنه ابن عدي، وقال: يسرق الحديث.(@)(@@)(@@)(@@) $ 3572 - محمد بن أحمد الخالدي: عن ابن خزيمة، اتهمه الحاكم.(@)(@@)(@@)(@@) $ 3573 - محمد بن أحمد بن علي، أبو منصور بن شكرويه: ضعفه مؤتمن الساجي.(@)(@@)(@@)(@@) $ 3574 - محمد بن أحمد بن علي، أبو مسلم الكاتب: الصحيح أنه ضعيف.(@)(@@)(@@)(@@) $ 3575 - محمد بن إبراهيم بن زياد الطيالسي: قال الدارقطني: متروك.(@)(@@)(@@)(@@) $ 3576 - محمد بن إبراهيم بن العلاء الشامي: شيخ ابن ماجه، قال الدارقطني: كذاب. -ق-(@)(@@)(@@)(@@) $ 3577 - محمد بن إبراهيم الصنعاني: عن أحمد بن ميسرة، ضعفه الأزدي.(@)(@@)(@@)(@@) $ 3578 - محمد بن إبراهيم التيمي: ثقة، قال أحمد: في حديثه شيء، روى المناكير. -ع-(@)(@@)(@@)(@@) $ 3579 - محمد بن إبراهيم القرشي: عن أبي صالح، لا يعرفان، وعنه هشام بن عمار.(@)(@@)(@@)(@@) $ 3580 - محمد بن إبراهيم الباهلي: بصري: مجهول، في عصر قتادة. -ت، ق-(@)(@@)(@@)(@@) $ 3581 - محمد بن إبراهيم، أبو أمية الطرسوسي: ثقة، قال الحاكم: كثير الوهم.(@)(@@)(@@)(@@) $ 3582 - محمد بن إبراهيم بن العلاء بن زبريق: تكلم فيه ابن عدي.(@)(@@)(@@)(@@) $ 3583 - محمد بن أبان الكوفي: عن زيد بن أسلم، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 3584 - محمد بن أبان الجعفي: ضعفه أبو داود، وهو الأول.(@)(@@)(@@)(@@) $ 3585 - محمد بن أبان: عن عائشة، قال البخاري: لا يعرف له سماع منهما.(@)(@@)(@@)(@@) $ 3586 - محمد بن أبان: عن عروة، وعنه يحيى بن أبي كثير: مجهول له في النذر.(@)(@@)(@@)(@@) $ 3587 - محمد بن أبان: عن هشام بن عبيد الله، كذبه أبو زرعة، ولنا محمد بن أبان عشرة ثقات سوى هؤلاء.(@)(@@)(@@)(@@) $ 3588 - محمد بن الأزهر الجوزجاني: نهى أحمد عن الكتابة عنه.(@)(@@)(@@)(@@) $ 3589 - محمد بن إسحاق بن يسار: ثقة إن شاء الله، صدوق، احتج به خلف من الأئمة، ولا سيما في المغازي، قال شعبة: صدوق، وقال أحمد: حسن الحديث، وقال ابن المديني: حديثه عندي صحيح، لم أجد له إلا حديثين منكرين، وقال ابن معين: ثقة، وليس بحجة، وقال النسائي: ليس بالقوي، وقال محمد بن عبد الله بن نمير: رمي بالقدر، وكان أبعد الناس منه، وقال أبو داود: قدري 
ms144	 معتزلي، وقال الدارقطني: لا يحتج به. قلت: وكذبه مالك، ويحيى القطان، ووهيب بن خالد. -عه، م تبعا-(@)(@@)(@@)(@@) $ 3590 - محمد بن إسحاق بن حرب اللؤلؤي: عن مالك، قال صالح جزرة: كذاب.(@)(@@)(@@)(@@) $ 3591 - محمد بن إسحاق السجزي: عن عبد الرزاق، قال ابن عدي: يسرق الحديث.(@)(@@)(@@)(@@) $ 3592 - محمد بن إسحاق المدني: عن سعيد بن زياد: مجهول.(@)(@@)(@@)(@@) $ 3593 - محمد بن إسحاق الأسدي العكاشي: قال الدارقطني: يضع الحديث.(@)(@@)(@@)(@@) $ 3594 - محمد بن إسحاق الضبي: عن روح بن عبادة، تركه ابن أبي حاتم.(@)(@@)(@@)(@@) $ 3595 - محمد بن أسعد الثعلبي: عن زهير بن معاوية، قال أبو زرعة الرازي: منكر الحديث.(@)(@@)(@@)(@@) $ 3596 - محمد بن أسلم: أرسل عن النبي - صلى الله عليه وآله وسلم -: مجهول.(@)(@@)(@@)(@@) $ 3597 - محمد بن إسماعيل بن رجاء: عن سالم بن أبي حفصة، شيعي، ينفرد. -ق-(@)(@@)(@@)(@@) $ 3598 - محمد بن إسماعيل الجعفري: قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) $ 3599 - محمد بن إسماعيل الوساوسي: عن زيد بن الحباب، ضعيف.(@)(@@)(@@)(@@) $ 3600 - محمد بن إسماعيل الضبي: مجهول، قال البخاري: منكر الحديث.(@)(@@)(@@)(@@) $ 3601 - محمد بن إسماعيل المرادي: عن أبيه: مجهول.(@)(@@)(@@)(@@) $ 3602 - محمد بن طريح الثقفي: في زمن التابعين، له حديث منكر.(@)(@@)(@@)(@@) $ 3603 - محمد بن إسماعيل بن عياش: قال أبو داود: لم يكن بذاك. -ق-(@)(@@)(@@)(@@) $ 3604 - محمد بن إسماعيل بن مهاجر: مجهول، قيل: إن أبا داود، سمع منه.(@)(@@)(@@)(@@) $ 3605 - محمد بن إسماعيل، أبو عبد الله البخاري:(@)(@@) قدم بغداد بعد الخمسمائة، وكتب عن جماعة: قال ابن الجوزي: كذاب، قلت: أما محمد بن إسماعيل الإمام مؤلف الصحيح فثقة بعد [ص: 343](@)(@@) ذا فما سلم من الكلام لأجل مسألة اللفظ، تركه لأجلها أبو زرعة وأبو حاتم، وهجره الذهلي.(@)(@@)(@@)(@@) $ 3606 - محمد بن أشرس السلمي النيسابوري: متروك.(@)(@@)(@@)(@@) $ 3607 - محمد بن الأشعث الكوفي: شيخ لابن عدي، خط عليه واتهمه. -د-(@)(@@)(@@)(@@) $ 3608 - محمد بن أنس الرازي: عن الأعمش، تفرد بمناكير.(@)(@@)(@@)(@@) $ 3609 - محمد بن أيوب اليمامي: عن أبي هريرة: مجهول.(@)(@@)(@@)(@@) $ 3610 - محمد بن أيوب المصري: قال أبو حاتم: لا يحتج به.(@)(@@)(@@)(@@) $ 3611 - محمد بن أيوب بن هشام الرازي: عن الحميدي، قال أبو حاتم: كذاب.(@)(@@)(@@)(@@) $ 3612 - محمد بن أيوب 
ms145	 بن سويد الرملي: ضعفه الدارقطني، وغيره.(@)(@@)(@@)(@@) $ 3613 - محمد بن أيوب: عن مالك، قال ابن حبان: كان يضع الحديث.(@)(@@)(@@)(@@) $ 3614 - محمد بن بحر: شيخ لأبي يعلى، يروي المناكير عن الضعفاء.(@)(@@)(@@)(@@) $ 3615 - محمد بن بركة الحلبي ابن ذاعر الحافظ: كان بعد الثلاثمائة، قال الدارقطني: ضعيف.(@)(@@)(@@)(@@) $ 3616 - محمد بن بشير بن مروان الكندي: عن ابن المبارك، ضعيف.(@)(@@)(@@)(@@) $ 3617 - محمد بن بيان الثقفي: عن ابن عرفة، متهم بالوضع.(@)(@@)(@@)(@@) $ 3618 - محمد بن بلال القرشي: عن طاوس: مجهول.(@)(@@)(@@)(@@) $ 3619 - محمد بن بلال: شيخ للبخاري، ثقة، لكنه يغلط. -د، ق-(@)(@@)(@@)(@@) $ 3620 - محمد بن تميم السعدي الفاريابي: قال ابن حبان: كان يضع الحديث، أكثر محمد بن كرام عنه وعن الجويباري.(@)(@@)(@@)(@@) $ 3621 - محمد بن تميم النهشلي: شيخ مجهول.(@)(@@)(@@)(@@) $ 3622 - محمد بن ثابت العبدي: عن عطاء، ونافع، ضعفه ابن معين. -د، ق-(@)(@@)(@@)(@@) $ 3623 - محمد بن ثابت البناني: ضعفه جماعة، وقال الحاكم: لا بأس به. -ت-(@)(@@)(@@)(@@) $ 3624 - محمد بن ثابت بن ثوبان: قال أبو حاتم: لا يساوي شيئا.(@)(@@)(@@)(@@) $ 3625 - محمد بن ثابت العصري: قال أبو حاتم: ليس بالقوي.(@)(@@)(@@)(@@) $ 3626 - محمد بن جابر الشحيمي: حسن الحديث، ضعفه بعضهم. -د، ق-(@)(@@)(@@)(@@) $ 3627 - محمد بن جابر بن سيار اليمامي. هو السجيمي: ضعيف.(@)(@@)(@@)(@@) $ 3628 - محمد بن جامع البصري العطار: شيخ لأبي يعلى، تكلم فيه ابن عدي.(@)(@@)(@@)(@@) $ 3629 - محمد بن جبير الثقفي: عن أنس بن سيرين: مجهول.(@)(@@)(@@)(@@) $ 3630 - محمد بن جحادة: ثقة، قال أبو عوانة، كان يغلو في التشيع. -ع-(@)(@@)(@@)(@@) $ 3631 - محمد بن جعفر بن عبد الله بن جعفر: مجهول الحال.(@)(@@)(@@)(@@) $ 3632 - محمد بن جعفر المدائني: قال أحمد: لا أحدث عنه أبدا.(@)(@@)(@@)(@@) $ 3633 - محمد بن جعفر بن محمد الصادق: صدوق، وفيه لين.(@)(@@)(@@)(@@) $ 3634 - محمد بن جعفر بن بديل، أبو الفضل الخزاعي المقرئ: ضعفوه.(@)(@@)(@@)(@@) $ 3635 - محمد بن جميل المروزي. ومحمد بن أبي جميلة: عن نافع، ومحمد بن جراح الطوسي، مجاهيل.(@)(@@)(@@)(@@) $ 3636 - محمد بن حاتم السمين: ثقة، لينه بعضهم. -م، د-(@)(@@)(@@)(@@) $ 3637 - محمد بن الحارث الحارثي: عن ابن البيلماني، 