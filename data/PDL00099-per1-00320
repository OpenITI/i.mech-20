ms317	 چهاکردی %~% سخن درازکشد تا به دامن محشر(@)(@@) 47 وگر ز فتنه مازندران سخن رانم %~% ز شاهنامه بشویند نام رستم زر(@)(@@) 48 به ملک‌کرمان راندی و با زبان سنان %~% خیانتی ‌که عدو‌ کرد دادیش‌ کیفر(@)(@@) 49 اگر ز خطه شیراز و یزد شرح دهم %~% چنان درازکه شیرازه بگسلد دفتر(@)(@@) 50 هنوز اول اردیبهشت طالع تست %~% شکوفه ‌کرده درختان و نانموده ثمر(@)(@@) 51 هنوز خاقان فارغ نشسته بر دیهیم %~% هنوز فغفور آسوده خفته در منظر(@)(@@) 52 هنوز چیپال از هند می‌ستاند باج %~% هنوز هرقل‌ در روم می‌نهد افسر(@)(@@) 53 به یک دو ماه اگر باج خواهی از خاقان %~% به یک دو سال اگر تاج گیری از قیصر(@)(@@) 54 زنی سرادق خرگه ‌فراز نه ‌گردون %~% نهی لوای شهنشه به دوش‌ هفت اختر(@)(@@) 55 کشی جنیبت سلطان به‌ مرز قسطنطین %~% بری‌ کتیبت دارا به ملک کالنجر(@)(@@) 56 بساط خاک طرازی برای مهر ضیا %~% بسیط‌کیهان‌گیری به تیغ خصم شکر(@)(@@) 57 به هرکنار کنی روی شوکتت ز قضا %~% به هر دیار نهی پای نصرتت باثر(@)(@@) 58 سپاه شاه به بخت تو است مستوثق %~% بقاع ملک به عدل تو است مستظهر(@)(@@) 59 به‌کاخ قدر توگیتی چو آستانه‌کاخ %~% به باغ جاه توگردون چو شاخ سیسنبر(@)(@@) 60 جهان چه باشد کز امر تو بتابد روی %~% فلک که باشد کز حکم تو بپیچد سر(@)(@@) 61 خبرز مردم پیشینه بود در فر و هوش %~% عیان نمود وجود تو آنچه بود خب‌ر(@)(@@) 62 سرای جاه تو هرجا نهند حلقه چرخ %~% ز بسکه خرد نماید چنان‌که حلقه به در(@)(@@) 63 به فر بخت تو بادا قوام‌کار جهان %~% بود قوام عرض تا همیشه از جوهر PageV1P188(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 خرم بهار من‌که ز عیداست تازه‌تر %~% در اول بهار چو عید آمد از سفر(@)(@@) 2 از راه نارسیده شوم راست از زمین %~% کارم همی به‌بر قدم آن سروکاشمر(@)(@@) 3 خندان به نازگفت‌که آزاده سرو را %~% نشنیده‌ام هنوزکسی آورد به‌بر(@)(@@) 4 باری به ‌برگرفتم و بوسیدمش چنانک 
ms318	 %~% دارد هنوزکام و لبم طعم نیشکر(@)(@@) 5 بنشاندمش به پیش و مئی دادمش‌کزو %~% همرنگ لاله شد رخ آن ماه‌کاشغر(@)(@@) 6 می‌درجگر چو رفت‌شودخون‌و زان‌می‌اش %~% عارض به رنگ خون شد نارفته در جبر(@)(@@) 7 گفتم‌کنون‌که روی تو از می چو‌ گل شکفت %~% قدری شکرفشان ز لب خویش ای پسر(@)(@@) 8 زیرا که هست چشم تو بیمار و لازمست %~% بهر علاج مردم بیمار گلشکر(@)(@@) 9 گفت ای حکیم حکمت مفروش و می بنوش %~% ناید هنر به‌کار کن فکر سیم و زر(@)(@@) 10 حال بگو که سال کهن بر تو چون‌‌ گذشت %~% ‌فتم نکوگذشت ز الطاف دادگر(@)(@@) 11 از حال سال تازه‌که آید خبر مپرست %~% خود بنگری عیان و عیان بهتر از خبر(@)(@@) 12 گر دست من تهی بود از سیم و زر چه باک %~% دارم دلی چو دریا لبریز ازگهر(@)(@@) 13 گنج رضا وکنج قناعت مرا بس است %~% حاصل ‌ز هر چه‌ هست به‌‌ گیتی ز خشک و تر(@)(@@) 14 در تن چو رو‌ح دارم‌گور عور باش‌ تن %~% در سر چو مغز دارم‌ گو عور باش‌ سر(@)(@@) 15 پشمی‌کلاه را چکند ماه مشک‌بوی %~% مشکین لباس را چکند یار سیمبر(@)(@@) 16 من همچو قطب ساکن و شعرم چو آسمان %~% دایم به‌گردش‌ است ز خاور به باختر(@)(@@) 17 چون آفتاب همت پروین‌گرای من %~% بگرفته شرق و غرب جهان زیر بال و پر(@)(@@) 18 صد سال هست نانم بر سفره قضا %~% آماده است و آبم در کوزه قدر(@)(@@) 19 دی رفت و روزی آمد و امروز هم‌ گذشت %~% فردا چو شد هم آید روزیش بر اثر(@)(@@) 20 فردا هنوز نامده و نانموده جرم %~% روزیش از چه برد رزاق جانور(@)(@@) 21 دی چون ‌گذشت و خواندی فرداش روز پیش %~% پس هرچه ‌هست فردا چون دیست در‌گذر(@)(@@) 22 عز و جلال من همه در مهر مصطفی است %~% وین شعر ترکه هستش روح‌القدس پدر(@)(@@) 23 هر شعر ترکه‌گویم در مدح مصطفی %~% روحم ز عرش گویدکاحسنت ای پسر(@)(@@) 24 
ms319	 زان پس فرشتگان را ز ایزد رسد خطاب %~% کاین مرغ را به شاخه طوبی سزد مقر(@)(@@) 25 وانگه فرشتگان را با حیرتی عظیم %~% گویند نرم نرمک پنهان به یکدگر(@)(@@) 26 بخ‌بخ بر این جلال ‌که چشم ستاره ‌کور %~% هی‌هی ازین مقال‌ که ‌گوش زمانه ‌کر(@)(@@) 27 چون ماهم این مقالت شیرین ز من شنید %~% زانگونه مات ‌گشت‌ که در روشنی بصر(@)(@@) 28 آنگه به‌ رقص ‌و وجد و طرب آمد آنچنانک %~% از جنبش نسیم درختان بارور(@)(@@) 29 گفتا پس‌ از ولای خدا و رسول و آل %~% از مردمان عزیزترت‌ کیست در نظر(@)(@@) 30 گفتم توگرچه هستی چون جان برم عزیز %~% مهر عزیز خان بود از تو عزیزتر(@)(@@) 31 عنوان آفرینش و قانون داد و دین %~% دیباچه جلالت و فهر ست فال و فر(@)(@@) 32 میری که نام او را بر دانه‌ گر دمند %~% ناکشته ریشه آرد و نارسته برگ و بر(@)(@@) 33 ای‌ کز هراس تیغ تو هنگام‌ گیر و دار %~% خصم ترا شود مژه در چشم نیشتر(@)(@@) 34 مغز و دل است‌ گویی اندام تو تمام %~% کز پای تا به سر همه هوشستی و هنر(@)(@@) 35 شاهنشه و اتابک اعظم‌ که هر دو را %~% آ‌رد سجود روز‌ و شب از چرخ ماه و خور(@)(@@) 36 آن شمس نوربخش است این ماه نورگیر %~% تو بسته پیش‌هر دو به‌طاعت‌همی‌کمر(@)(@@) 37 وان ‌شمس و آن‌ قمر را زان ‌رو نظر به تست %~% کاندر سعادتی تو چو برجیس مشتهر(@)(@@) 38 از هر نظر فزون به سعادت شمرده‌اند %~% تثلیث مشتری را با شمس و با قم‌ر(@)(@@) 39 بر درگه ملک ‌که سلیمان عالمست %~% خدام تو ز مور و ملخ هست بیشتر(@)(@@) 40 زان گونه منkیند خرگوش مادهحی %~% کزهیبت تو بیند درحمله شیر نر(@)(@@) 41 سروی‌ که روز جود تو کارند بر زمین %~% آن سروگونه‌گونه چو ط‌ربی دهد ثمر(@)(@@) 42 یزدان گذاشت نام ترا از ازل عزیز %~% نامی که او گذارد اینسان کند اثر(@)(@@) 43 
ms320	 قاآنیا عنان سمند سخن بکش %~% اندیشه‌ کن ز کید حسودان بد سیر(@)(@@) 44 تو مشک می‌فشانی و دارد عدو زکام %~% وز بوی مشک گیرد مزکوم دردسر(@)(@@) 45 کید عدو اگرنه سبب شد چرا چنین %~% نزد عزیز مهتر خود خوارم این قدر(@)(@@) 46 گر ناله‌ای نمود نهان ابر کلک من %~% از رعد چاره نیست چو ریزد همی مطر(@)(@@) 47 تا صلح و جنگ هر دو بود در میان خلق %~% تا شر و خیر هر دو بود قسمت بشر(@)(@@) 48 جنگت نصیب دشمن و صلحت نصیب دوست %~% تا زین خلیل خیر برد زان حسود شر(@)(@@) 49 ایزد کنار در دو جهانت عزیز و باز %~% بر هرچه دوست دارد بخشد ترا ظفر PageV1P189(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 در شب عید آن سمن عذار سمن‌بر %~% با دو غلام سیه درآمدم از در(@)(@@) 2 هر دو غلامش به نام عنبر و ریحان %~% یعنی زلف سیاه و خط معنبر(@)(@@) 3 هر دو رخش یک حدیقه لاله حمرا %~% هر دو لبش یک قنینه باده احمر(@)(@@) 4 ترک ختا شوخ چین نگار سمرقند %~% ماه ختن شاه روم شاهد کشمر(@)(@@) 5 جستم و بوییدمش دو دسته سنبل %~% رفتم و بوسیدمش دو بسته شکر(@)(@@) 6 گفت مگر روزه باشدت به شب عید %~% کت نبود راح روحبخش به ساغر(@)(@@) 7 خیز و زمانی سر از دریچه برون ‌کن %~% تاکندت بوی‌گل مشام معطر(@)(@@) 8 ابر جواهر نثار بین‌ که ز فیضش %~% گشته جواهر نثار توده اغبر(@)(@@) 9 طرف دمن بین ز لاله معدن یاقوت %~% صحن چمن بین ز ژاله مخزن‌ گوهر(@)(@@) 10 ابر به صحراگسسته رشته لؤلؤ %~% باد به بستان‌ کشیده پشته عنبر(@)(@@) 11 رشته باران چو تار الفت یاران %~% بسته و پیوسته‌تر ز ابروی دلبر(@)(@@) 12 فکر بط باده‌کن‌که بابت ساده %~% می‌نشود عیش بی‌شراب میسر(@)(@@) 13 سرخ مئی آنچنان ‌که در شب تاریک %~% شعله‌کشد هر زمان به‌گونه آذر(@)(@@) 14 وجه می ار نیست‌کهنه خرقه پاری %~% رهن می ناب را برون‌ کن از بر 