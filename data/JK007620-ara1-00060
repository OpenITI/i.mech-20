ms41	 يوم سفح حاجر % يغره داعي الهوى فاختلسا % % 8(@)(@@) % وما على قومك يا ذات اللمى % % إن نحن حيينا محلا درسا % % 9(@)(@@) % وما على زواركم لو لثموا % % عنا فروع شيحكم والمغرسا % % 10(@)(@@) % فرب ليل في هضاب عاقل % رق نسيما حين طاب ملبسا % % PageV01P152 11(@)(@@) % يظنني الغيران قد شهدته % وإنما ظننته تفرسا % % PageV01P153 البحر : كامل تام 1(@)(@@) % استغفر الله القديم وعذبه % من شر عاف في الحطام منافس % 2(@)(@@) % واصنع جميلا لا يضيع صنيعه % واسمح بقوتك للضعيف البائس % 3(@)(@@) % واقنع ففي عيش القناعة نعمة % لا تتقي كف الزمان الخالس % 4(@)(@@) % لا تركنن إلى المراء فإنه % سبب لكل تنافر وتشاوس % 5(@)(@@) % ضلت بنو غطفان لما قتلت % % ساداتها غضبا للطمة داحس % 6(@)(@@) % والحارث البكري قام إلى الوغى % % من بعد ما أمضى عزيمة جالس % 7(@)(@@) % ألف البخيل مكاسه في ماله % والعمر أنفق منه غير مماكس % 8(@)(@@) % وثوى فأرمس ثم صار تراثه % قسما يفيض به دموع الرامس % 9(@)(@@) % عاذت بنو حواء من إبليس في ال % % دنيا وكم فيهم فنون أبالس % 10(@)(@@) % درسوا العلوم ليملكوا بجدالهم % فيها صدور مراتب ومجالس % PageV01P154 11(@)(@@) % وتزهدوا حتى أصابوا فرصة % في أخذ مال مساجد وكنائس % 12(@)(@@) % إيوان كسرى صار مرتع ثلة % ودياره باتت مناخ عرائس % 13(@)(@@) % والحيرة البيضاء بدل أنسها % % قدر أطاعته مدائن فارس % 14(@)(@@) % يا عقل ما لك في اللطائف منهج % فلإن عثرت فلا لعا للناعس % 15(@)(@@) % أما النجوم فقد تضمن شأنها % % جهل اللبيب وبعد نيل اللامس % 16(@)(@@) % عمري لقد ذهب الذين تفكروا % % فيها وما ظفروا بغير وساوس % 17(@)(@@) % ما قول بطليموس فيها حجة % عندي ولا المروي عن رسطالس % 18(@)(@@) % حار الأنام فلا دلالة ناظر % تشفي العقول ولا إمارة قابس % 19(@)(@@) % لا تحفلن بما حوته صحائف % لهم وإن وجدت بخط دارس % 20(@)(@@) % فالمين ركب في طبائع أربع % % والصدق عد من القبيل الخامس % PageV01P155 21(@)(@@) % عجبا لهمام ينازع خصمه % في آل يربوع وأسرة حابس % 22(@)(@@) % هيهات ما شرف الأصول بنافع % حتى يكون ذوائب لمغارس % 23(@)(@@) % لا تفعلن وان فعلت فبالتقى % % ناضل وفي بذل المكارم نافس % PageV01P156 البحر : بسيط 
ms42	 تام 1(@)(@@) % ألم أقل لك لا تخلس محاسنه % فإن طرفك موتور من الخلس % 2(@)(@@) % ظبي رميت له عيني خائلة % وما علمت بأن الليث في الكنس % 3(@)(@@) % علاقة بت عنها غير معتذر % وهفوة كنت منها غير محترس % 4(@)(@@) % جريت فيها على حكم الصبا ولعا % فإن ضللت فإني بعد في الغلس % PageV01P157 البحر : طويل 1(@)(@@) % عدتني عواد عنك يا ابن محمد % تأوبني من لذعها نازح النكس % 2(@)(@@) % ولم ألق في يومي سرورا يجبرني % % من الهم إلا بث ما كان في أمس % 3(@)(@@) % فإن عاق دهر عنك مثر من الذي % % تباع له الأوطان بالثمن البخس % 4(@)(@@) % وخادع بالقوم الذين دنوهم % ببعدك عن عيني بغيض إلى نفسي % % 5(@)(@@) % فلم أقتن الإبدال منك وإنما % % فزعت إلى الملح الأجاج من الخمس % PageV01P158 البحر : طويل 1(@)(@@) % أبا حسن لو قلت في ذكر وحشتي % % لبعدك شعرا كان يعرب عن أنسي % % 2(@)(@@) % أبى ذاك إني مذ رحلت بخاطر % كليل وقلب بالجوى عازب الحس % 3(@)(@@) % أطالت علي الليل سود همومه % كأني خلفت السرور مع الشمس % 4(@)(@@) % فهل أنت ممن يدعي ما ادعيته % وقد صرت بعد البين أفصح من قس % 5(@)(@@) % وجاء كلام منك دل صقاله % وصدق معانيه على جذل النفس % 6(@)(@@) % فأين غرام يعقل الفكر بعضه % ووجد يعيد المسهبين من الخرس % 7(@)(@@) % وهيهات لو كانت جفونك أطلقت % مدامعهها ألفيت ذهنك في حبس % 8(@)(@@) % وأجبلت حتى صرت مثلي فإنني % % ببعدك قد لاقيت ضربا من المس % 9(@)(@@) % فلم تجتمع لي أحرف في صحيفة % كأن الدجا نفسي وشمس الضحى طرسي % % PageV01P159 البحر : كامل تام 1(@)(@@) % يا ناق إن أثرى العذيب وروضا % % فلنا ديون بالأسنة تقتضى % % 2(@)(@@) % قد ماطل القدر الجموح بوعده % فيها وآن لمغمد أن ينتضى % % 3(@)(@@) % بيني وبين الذل عز قناعة % نبذ الجمام اباؤها وتبرضا % % 4(@)(@@) % وسنان مطرد الكعوب مثقف % كالصل صرح بالوعيد ونضنضا % % 5(@)(@@) % حب الغنى عقل اللئام وفاته % طيان أترب بالثناء وأنفضا % % 6(@)(@@) % غصب السراح على بقية زادها % % وقرى فأمحض للضيوف وأنحضا % % 7(@)(@@) % عرض ثراءك للخطوب وشله % شل الطريدة قبل أن يتعرضا % % 8 
ms43	(@)(@@) % وأنبذ غناك فما رزيت بذاهب % لم يبد عندك نفعه حتى مضى % % 9(@)(@@) % إن راعني وضح المشيب فإنه % برق تألق بالخطوب وأومضا % % 10(@)(@@) % ولقد أضاء وأظلمت أيامه % حتى عرفت به السواد الأبيضا % % PageV01P160 11(@)(@@) % وبجانب العلمين شاك سره % إني رعيت له النجوم وغمضا % % 12(@)(@@) % ومرنح فطن النسيم بوجده % فروى له خبر العذيب معرضا % % 13(@)(@@) % نم واحمد الليل القصير فليله % بادي الهموم فلا انقضين ولا انقضى % % 14(@)(@@) % وسل الصباح وقد أقام بحاجر % إن كان أضمر أن يمر على الفضا % % 15(@)(@@) % ذم الزمان فما وجدت صروفه % إلا ذلولا في القياد وريضا % % 16(@)(@@) % صفحت نوائبه عن ابن مقلد % كرما فكيف ألومه فيما مضى % % 17(@)(@@) % ولقد ألم به فأظهر فضله % والنار لا تشتب حتى تحتضى % % 18(@)(@@) % راض الزمان فأصبحت أخلاقه % وأعاد صبغ شبابه لما نضا % % 19(@)(@@) % من معشر بذلوا النفوس سماحة % وحموا بيوت المجد أن تتقوضا % % 20(@)(@@) % عادت بهم ظلم الخطوب مضيئة % والجدب موشي البرود مروضا % % PageV01P161 21(@)(@@) % لولا مخالطة الصوارم والقنا % % منع السماح أكفهم أن تقبضا % % 22(@)(@@) % قوم إذا استنجدتهم لملمة % ملأت عليك جيادهم رحب الفضا % % 23(@)(@@) % السمر تشرع والدروع تصونها % % سحب السهام كأنها رسل القضا % % 24(@)(@@) % والنقع يسفر بالظبا فكأنه % غضب تبسم بينه لمع الرضا % % 25(@)(@@) % أسيافهم في راهط معروفة % منعت دعائم عزهم أن يدحضا % % 26(@)(@@) % وتقلد العمري من إيمانهم % عارا يطول عليه حتى يرحضا % % 27(@)(@@) % يا من إذا ما ذاد عن أحسابهم % يوم النضال أصاب لما أنبضا % % 28(@)(@@) % خفض عليك فكم ظفرت بغاية % وكبا وراءك جاهد ما خفضا % % 29(@)(@@) % بيني وبينك ذمة مرعية % حاشا مرائر عهدها أن تنقضا % % 30(@)(@@) % عين الحوادث دونها مطروفة % نظر المحب سلا وعاود مبغضا % % PageV01P162 31(@)(@@) % فأصخ إلي وللحديث شجونه % حتى أبثك ما أمض وأرمضا % % 32(@)(@@) % ما أخرتني عن جنابك همة % وجدت من الأهواء عنك معوضا % % 33(@)(@@) % لكنه قدر أناخ ركائبي % % قسرا وقيد همتي أن تنهضا % % 34(@)(@@) % وعلمت أنك كالنسيم مخلد % أبدا وليس يصح حتى يقبضا % % 35(@)(@@) % فاغفر لخل لو أبيع هواكم % بحياته هجر الحياة وأعرضا % % 36(@)(@@) % وفداك صب بالثراء محرم 
ms44	 % بسط البنان عليه حتى يقبضا % % 37(@)(@@) % نبذ الإباء فإن تنكر حادث % ألقى مقالده إليه وفوضا % % 38(@)(@@) % واسمع شوارد لا تمل غريبها % % حتى تمل من البقاء وتغرضا % % 39(@)(@@) % قد كان يسهل خاطري فكأنه % سئمت ركائبه الرياض فأحمضا % % 40(@)(@@) % فكر أقود به الجموح كأنما % % طبع الرضي له وعلم المرتضى % % PageV01P163 البحر : كامل تام 1(@)(@@) % يا من رميت بعتبه حاشاك من % عتب يعز علي أو إعراض % 2(@)(@@) % لي أسوة فيما فعلت ولست من % تخفى عليه إشارة الأغراض % 3(@)(@@) % لولا هواك وجدتني وخلائقي % % شمس وسيفي بالقطيعة ماضي % % 4(@)(@@) % فاعطف علي ولا تكن متسرعا % % فيما أحاذره وخصمي راضي % % 5(@)(@@) % ومن العجائب أن تكون قضية % يرضى الخصوم بها ويأبى القاضي % % PageV01P164 البحر : طويل 1(@)(@@) % وما زلت أغضي عنك بالليل كلما % % بدوت ولولا خوف قومك لم أغض % 2(@)(@@) % وأرقب زورا من خيالك طارقا % % وهيهات من شرط الهوى عدم الغمض % 3(@)(@@) % هجرتك خوفا من بعاد يثيره % دنوي وبعض الشر أهون من بعض % 4(@)(@@) % فيا حاكم الأيام إن كنت قاضيا % % بوصل فبادر قبل نقضي ولا تقض % PageV01P165 البحر : كامل تام 1(@)(@@) % قبحا ليومك فالنوائب بعده % وأقول لو أن النوائب تسمع % 2(@)(@@) % وأخادع الأيام وهي ملية % بنتاج كل ملمة لا تخدع % 3(@)(@@) % لا تغبطن على البقاء مرزأ % % إن المودع إلفه لمودع % 4(@)(@@) % ماطل بطرفك يا زمان فإنه % لم يبق عندي للصبابة موضع % 5(@)(@@) % أو فارمني بسهام خطبك جاهدا % إن كان في قوس الحوادث منزع % 6(@)(@@) % لا سالمتني النائبات فإنني % % ثلج الفؤاد إذا تقود فأتبع % 7(@)(@@) % وعدمت أوطاني فآنس أرضها % % وحش وأضيقها علي الأوسع % 8(@)(@@) % أوضحت لي سبل الهموم كأنما % % صبري تخب به الركاب وتوضع % 9(@)(@@) % وأضقت ذرعي بالعزاء وطالما % % أمسى رحيبا إذ تضيق الأذرع % 10(@)(@@) % وحجبت عن عيني الضياء كأنما % % الآفاق غرب ليس فيه مطلع % PageV01P166 11(@)(@@) % فلتفخر الأيام أن ملمة % منها أهال بوقعها وأروع % 12(@)(@@) % قبحا ليومك فالنوائب بعده % جلل وكل رزية لا تفجع % 13(@)(@@) % أشكو فراقك ثم أعلم عنده % أن السبيل إلى لقائك مهيع % 14(@)(@@) % ورجوت قربك والديار بعيدة % فاليوم أخفق في 
ms45	 اللقاء المطمع % 15(@)(@@) % لو كان ينفعني السلو نبذته % أسفا عليك فكيف إذ لا ينفع % 16(@)(@@) % هيهات يجمع شمل صبر نافر % % قلب بأيدي الحادثات موزع % 17(@)(@@) % أحنو الضلوع على بواعث غلة % ضمن أذكارك أنها لا تنقع % 18(@)(@@) % وألوم طول الليل أرقب فجره % أو ما ابيضاض الصبح بعدك أسفع % 19(@)(@@) % قرعت إليك ثنية مطروقة % قضت المنية أنها لا تمنع % 20(@)(@@) % ما كان أوعر نهجها لو أنه % خرق بأطراف الأسنة يرقع % PageV01P167 21(@)(@@) % لا تبعدن مصارع مطلولة % ما حطمت فيها الرماح الشرع % 22(@)(@@) % ومسندون تعاقروا كأس الردى % % ودعا بسهمهم الحمام فأسرعوا % % 23(@)(@@) % برك الزمان عليهم بجرانه % وهفت بهم ريح الخطوب الزعزع % 24(@)(@@) % خرس إذا ناديت إلا أنهم % وعظوا بما يزع الليب فأسمعوا % % 25(@)(@@) % وفوارس عهدوا السيوف ذوائدا % عن سربهم لو صادفت ما تقطع % 26(@)(@@) % نبذوا الأنام فما أضاء بنقعهم % عضب يشام ولا سنان يلمع % 27(@)(@@) % البيض تزهر والدروع مفاضة % والخيل تمرح والقنا يتزعزع % 28(@)(@@) % والدهر يفتك بالنفوس حمامه % فلمن يعد كريمه أو يجمع % 29(@)(@@) % عجبا لمن يبقي ذخائر ماله % ويظل يحفظهن وهو مضيع % 30(@)(@@) % ولغافل وله بكل ثنية % ملقى له بطن الصفائح مضجع % PageV01P168 31(@)(@@) % أتراه يحسب أنهم ما أسأروا % % من كأسهم أضعاف ما يتجرع % 32(@)(@@) % لو كان يمنعك القراع ملأتها % % جردا يغص بها الفضاء البلقع % 33(@)(@@) % وأثرت في حلق الدروع عصابة % كالدهر تخفض ما يشاء ويرفع % 34(@)(@@) % لكنها الأقدار ليس أمامها % % ما يستجن به ولا يستدفع % 35(@)(@@) % يا قبر فيك الصالحات دفينة % أفما تضيق بهن أو تتصدع % 36(@)(@@) % لو كنت تبلغ ما أقول أطلت ما % % أشكو إليك من الهموم وأضرع % 37(@)(@@) % حياك فجري النسيم كأنه % أبدا بطيب ثنائها يتضوع % 38(@)(@@) % وسقتك أجفاني فأنت بمعزل % عن أن يتاح لك السحاب الهمع % 39(@)(@@) % إن لم يكن عقر عليك فإنها % % كبد محرقة وقلب موجع % PageV01P169 البحر : طويل 1(@)(@@) % وهبت له ريح الصبا فأريته لمن دمن بين الغوير وأربع % توهمها جفن من الدمع مترع % 2(@)(@@) % محاها صبوح الغين بعد غبوقه % وهبت بها ريح الصبا وهي زعزع % 3(@)(@@) % يقول صحابي 
ms46	 هل نسيم حديقة % تنفس أم ذكر الهوى يتضوع % 4(@)(@@) % فأقسمت ما أدري أركب تناشدوا % % على الدار أم لحن الحمائم تسجع % 5(@)(@@) % ونار على الجرعاء يدعو بها الدجا % % إلى الطرف أم بيض القواضب تلمع % 6(@)(@@) % وقلت لسعد والنعامى تنوشه % وقد أثمل الركب الحنين المرجع % 7(@)(@@) % تصامم عن الأنضاء أو فالتمس لها % % فؤادا يعاطيها الغرام ويجزع % 8(@)(@@) % ودع عنك إيماض البروق فإنها % % صوارم في سر الجوائح تقطع % 9(@)(@@) % فلما أبى إلا نزاعا فؤاده % شجاني جواه فالعزول المفجع % 10(@)(@@) % وهبت له ريح الصبا فأريته % فؤاد الحزين كيف يمضي ويرجع % PageV01P170 11(@)(@@) % خليلي إن لم تعرفا زفرة النوى % % ولم تسعداني فانظرا كيف أصنع % 12(@)(@@) % تجاهلت حتى أنكرتني خفاجة % وقالت بما ضل الأعز المشيع % 13(@)(@@) % وأصبحت أرجو أن تعود أنايتي % % وليس لمن تطوي المنية مرجع % 14(@)(@@) % توقد أسى ما ذلك العهد عائد % عليك ولا في قرب غيداء مطمع % 15(@)(@@) % بني عامر يلقون بي جمرة العدى % % وأنصركم واليوم بالنقع أشفع % 16(@)(@@) % ويسهرني من شف جسمي فراقه % فأنظر طرفا في العشيرة يهجع % 17(@)(@@) % تحاموا ورود الصبر أو فاتبعوا فتى % % يقوم بما قام الكريم السميدع % PageV01P171 البحر : بسيط تام 1(@)(@@) % إني وإن كنت أبغي الحلم آونة % أو أمتطيه لما آتي وما أدع % 2(@)(@@) % فما أحمل صبري فوق طاقته % ولا أكلف قلبي فوق ما يسع % 3(@)(@@) % إذا صديق نبت عني جوانبه % وغره الحلم حتى غاله الطمع % 4(@)(@@) % نزعت عنه وفي قلبي نوازعه % خير من الضيم أن ينتابك الجزع % 5(@)(@@) % فاذهب طليقا ففي الغبراء مطرح % وإن ذهبت ففي الإخوان متسع % PageV01P172 البحر : طويل 1(@)(@@) % أتاني وعرض الرمل بيني وبينه % حديث لأسرار الدموع مذيع % 2(@)(@@) % تصاممت عن راويه حتى أربته % وإني على ما غالني لسميع % 3(@)(@@) % وقال ربيع مات فيه مسلم % فقلت له بل مات فيه ربيع % 4(@)(@@) % أبا طاهر ما كان ألأم ليلة % أرقت بها والساهرون هجوع % 5(@)(@@) % فلهفي على الآمال فيك فإنها % % نوائب لم يقدر لهن شروع % 6(@)(@@) % وعز على ساري الدجا أن يجوبه % ومالك من دون النجوم طلوع % 7(@)(@@) % ألوم عليك 
ms47	 الوجد وهو مبرح % وأعتب فيك الدمع وهو نجيع % 8(@)(@@) % وأعلم أني ما منحتك طائلا % وهل هي إلا زفرة ودموع % PageV01P173 البحر : متقارب تام 1(@)(@@) % دعوها تناضل بالأذرع % فأين العواصم من لعلع % % 2(@)(@@) % وقودوا أزمتها بالحنين % فلولا الصبابة لم تتبع % % 3(@)(@@) % ويا سعد هل لك في وقفة % على الدار تجهل فيها معي % % 4(@)(@@) % فمالي قلب يبث الغرام % على رسم دمنتها البلقع % % 5(@)(@@) % ولكنه كان لما مضى % % مع الظعن وصى إلى أدمعي % % 6(@)(@@) % فهن إذا ما عدمن الخليط % رعين الأمانة في الأربع % 7(@)(@@) % عذيري من عاذل في هواك % يعز على سومه مسمعي % % 8(@)(@@) % كتمت الغرام ولكن أتيت % بحكم الصبابة من مدمعي % % 9(@)(@@) % وأودعت سرك سفح الغوير % فضل الوفاء على المودع % % 10(@)(@@) % وصارت صباه تبث الحديث % وتسند عن بانه الأجرع % PageV01P174 11(@)(@@) % وتقسم أني أهواكم % وليس اليمين على المدعي % % 12(@)(@@) % وبرق أضاء فلولا السها % % د دل الخيال على مضجعي % % 13(@)(@@) % سرى وهو في الأعين الساهرا % % أحلى من النوم في الهجع % 14(@)(@@) % فطارحنا بحديث العذيب % ولكن جزعنا ولم يجزع % % 15(@)(@@) % خليلي هل ضل حادي الصبا % % أم الأفقان بلا مطلع % 16(@)(@@) % هموم تعين علينا الظلام % فلو صدع الليل لم تصدع % 17(@)(@@) % ودهر تفاخر أيامه % فروع الكواكب باليرمع % 18(@)(@@) % يحاول ضيمي ومن دونه % طوال الذوابل والأذرع % 19(@)(@@) % ويحسبني طالبا جوده % متى خدعت منة مطمعي % % 20(@)(@@) % أبيت فإن أسلمتني المنى % % إليك فماطل بها أو دع % PageV01P175 21(@)(@@) % وقل لبينك قل السماح % % وحزنا على الخلق الأشنع % 22(@)(@@) % وبخلا فلله در الطوى % % إذا كان عندهم مرتعي % % 23(@)(@@) % بلى لبني منقذ منهل % من الجود لولاه لم أشرع % 24(@)(@@) % هم جنبوني بعد الإباء % إلى خصب واديهم الممرع % 25(@)(@@) % نقعت بهم غلتي بعد ما % % غرفت عن السحب الهمع % 26(@)(@@) % وأبلج منهم بغوا شأوه % وقد فات شاردة الأربع % % 27(@)(@@) % فما أدركوه ولا ماطلوا % % مطال البطيء عن السرع % 28(@)(@@) % ولكن جرى سابقا في الرهان % وضلوا على الأثر المهيع % % 29(@)(@@) % ترنحه هزة للسماح % عزته إلى الأسل الزعزع % 30(@)(@@) % وينسبه البأس في البيض وهو % % بين الصوارم والشرع % PageV01P176 31(@)(@@) % تطول 
ms48	 به الأرض حتى يظن % أخت المجرة في الموضع % % 32(@)(@@) % فجاء كما أمل المجد فيه % مليا بغاربة الأتلع % % 33(@)(@@) % غذاه أبوه بحب النوال % فلم يسل عنه ولم ينزع % % 34(@)(@@) % وعرق فيه ندى خاله % إذا لؤمت درة المرضع % 35(@)(@@) % أبا حسن لي في مدحكم % شوارد لولاك لم تجمع % 36(@)(@@) % نهيت عدوك عن غيه % بوخز العتاب فلم يسمع % 37(@)(@@) % وقلت له من يروم النجوم % بباع كباعك فليربع % 38(@)(@@) % ألست ترى شيم الأكرمين % تهزأ من أنفك الأجدع % 39(@)(@@) % حذار بني منقذ أن يغيض % بحرك في بحرها المترع % 40(@)(@@) % فإنهم فرعوا غاية % بغير الصوارم لم تفرع % % PageV01P177 41(@)(@@) % وأنت كما حكم اللؤم فيك % تلوب على ذلك المشرع % % 42(@)(@@) % وقد غمروك ببذل النوال % فطر بمواعيدهم أوقع % % 43(@)(@@) % من الواخزات التي لا % % إلى لؤم أصلك لم تقطع % 44(@)(@@) % وآخر نازعني فيكم % ولو ترك الصل لم يلسع % 45(@)(@@) % فراح بغراء وضاحة % تبلج في عرضه الأسفع % 46(@)(@@) % من الواخزات التي لا تصد % سابغة الأذرع % 47(@)(@@) % نوافر تعجز طلابها % % متى أبغ شاردها تسرع % % 48(@)(@@) % إذا ما دعوت جموح الكلا % % م جاء بممتنع طيع % % 49(@)(@@) % بغر إذا ما غشين الظلا % % م كسفن سنا شهبه المطلع % % 50(@)(@@) % لكم أريها ولأعدائكم % موارد من سمها المنقع % PageV01P178 البحر : طويل 1(@)(@@) % أينفعني فضل الحنين المرجع % وهيهات ما وجدي عليك بمنجع % % 2(@)(@@) % وكيف يفوز الغيث فيك بمنة % إذا كنت لا أرضى سحائب أدمعي % % 3(@)(@@) % أرى زفرات الحزن بعدك سلوة % % يدل على وجدان قلب وأضلع % 4(@)(@@) % وليس بكاء العين إلا خيانة % ولا اللؤم إلا أنها بقيت معي % % 5(@)(@@) % وكل أسى لا تذهب النفس عنده % فما هو إلا من قبيل التصنع % % 6(@)(@@) % ووالله ما وفيت ودك حقه % وهل هي إلا لوعتي وتفجعي % % 7(@)(@@) % وأين وفائي لا مدى الدمع بالغ % رضاي ولا جهد الصبابة مقنعي % % 8(@)(@@) % رضيت بحكم الدهر فيك ضرورة % وكيف إبائي دونه وتمنعي % % 9(@)(@@) % وطاوعته حتى جعلتك عنده % وديعة مغرى بالخيانة مولع % 10(@)(@@) % أمثل في عيني خيالك حاضرا % وأنت بعيد عن مقامي وموضعي % % PageV01P179 11(@)(@@) % فلو أنني حدثت نفسي بسلوة 
ms49	 % لكنت بمرأى من حديثي ومسمعي % % 12(@)(@@) % لحى الله دهرا نازعتك صروفه % صبابة قلب بالفراق مروع % 13(@)(@@) % وشلت يد هالت على وجهك الثرى % % لقد كسفت نور الصباح الملمع % % 14(@)(@@) % تصاممت عن ناعيك حتى أريبه % % ودافعت فيك الخطب من كل مدمع % % 15(@)(@@) % فلما أبى إلا يقينا حديثه % فزعت إلى جفن من الدمع مترع % % 16(@)(@@) % يزيد أوامي ورده وهو طافح % وقد كان من يشرب من العد ينقع % % 17(@)(@@) % فقدتك فقد الماء بعد ظمائة % من الغل في قفر من البيد بلقع % 18(@)(@@) % وكان رجائي فيك ذخرا جعلته % ملاذي في دفع الهموم ومفزعي % % 19(@)(@@) % فيا ماء عيني كيف خلفت نورها % % مجالا لغرب الدمعة المتسرع % 20(@)(@@) % وما كنت أخشى من يديك خيانة % تضرم نارا في مقيلي ومضجعي % % PageV01P180 21(@)(@@) % أصاعد قد بلغت لو بلغ الثرى % % نداء حزين أو شكاية موجع % % 22(@)(@@) % ذكرت لك العهد القديم وقد مضت % عليه ليال ما تهم بمرجع % % 23(@)(@@) % وخالسني فيك الزمان بقية % من الصبر في أعشار قلب موزع % % 24(@)(@@) % فأي حسام حالت الأرض دونه % وكان متى يضرب به الخطب يقطع % % 25(@)(@@) % ومقتسم النعمى أناخت عفاته % على المحل في روض من الجود ممرع % 26(@)(@@) % له نشوة عند السؤال كأنما % % تنازعه كأس السلاف المشعشع % 27(@)(@@) % إذا أعمل الأقلام نالت غروبها % % مطارح أطراف القنا المتزعزع % % 28(@)(@@) % وما الطعنة النجلاء في كل معرك % سوى الخطبة الغراء في كل مجمع % 29(@)(@@) % أقر له بالفضل كل منازع % ويأسره في الفكر كل ممنع % 30(@)(@@) % وأثنى عليه الحاسدون ضرورة % بأحسن ما يغلو الصديق ويدعي % % PageV01P181 31(@)(@@) % لعمري لقد منيت نفسي بقربه % سفاها ومن يطلب من الدهر يمنع % 32(@)(@@) % فجال الردى دون اللقاء ولم تدع % صروف الردى من حيلة في التجمع % 33(@)(@@) % سقاك وقد أغنى عن الغيث مزنة % من الدمع تهمي في مصيف ومربع % 34(@)(@@) % سحاب ترجيه الصبا وكأنما % % يمد بطود من عماية أتلع % 35(@)(@@) % يفوف أبراد الرياض وبرقه % يشق جلابيب الظلام الموشع % 36(@)(@@) % كأن حنين الرعد في حجراته % حدآء مهيب بالركاب مزعزع % 37(@)(@@) % له زجل يروي النسيم وراءه % أحاديث نشر الروضة 
ms50	 المتضوع % 38(@)(@@) % وقد جل قدر الماء إن كان حافظا % مودة ثاو في التراب مضيع % 39(@)(@@) % وما أنا إلا لاحق بك فانتظر % لقائي ومن يسلك سبيلك يتبع % 40(@)(@@) % عوائد من ذكراك عندي حبيبة % ومالي منها غير مبكى ومجزع % PageV01P182 41(@)(@@) % وأي جفون ما أفاضت دموعها % % عليك وقلب فيك لم يتصدع % PageV01P183 البحر : سريع 1(@)(@@) % سلوا أعادي إذا كنتم % لم تقبلوا أقوال أشياعي % % 2(@)(@@) % هل رفعت في كرم راية % قصر عن إدراكها باعي % % PageV01P184 البحر : بسيط تام 1(@)(@@) % يا راكب العرمس الوجناء معترضا % % دون العذيب على ميث وأجراع % 2(@)(@@) % بلغ خفاجة عني إن مررت بها % % ونادها لا أجابت دعوة الداعي % % 3(@)(@@) % يا خيب الله من يرجو نوالكم % كم تمنعوني آمالي وأطماعي % % 4(@)(@@) % وتلبسون الهوينا وابن عمكم % في ساحة الذل مقذوفا بجعجاع % 5(@)(@@) % ظننتم المجد أذوادا مهملة % وثلة صاح في أرجائها الراعي % % 6(@)(@@) % فروع الله جاري إن جزيتكم % إلا بمنصلت كالنجم قطاع % 7(@)(@@) % أنا ابن من لم يدع ذخرا لوارثه % إلا الجياد وسمرا ذات زعزاع % 8(@)(@@) % داني القرى لا يذم الذئب صحبته % ولا يقر على هم وأذماع % 9(@)(@@) % ذنبي إلى القوم أني ما حملت لهم % قلبا ذليلا وكفا غير مضياع % 10(@)(@@) % وأنكروا بي أسقاما مؤرقة % ولوعة تتوارى بين أضلاعي % % PageV01P185 11(@)(@@) % وما عليهم إذا ما قلت من طرب % يا ديمة الغيث حيي سرحة القاع % 12(@)(@@) % نعم أحب سليمى فاهجروا عذلي % % فالقلب قلبي والأوجاع أوجاعي % % 13(@)(@@) % وإن دعاني الهوى لبيت دعوته % والحب أكرم ما لبيت من داعي % % PageV01P186 البحر : طويل 1(@)(@@) % لعل دنو الحي بعد شسوعه % يعلل قلبا هائما بجميعه % 2(@)(@@) % أأحبابنا بين الأحص وجوشن % دعاء معنى بالفراق صريعة % 3(@)(@@) % مقيم على الحب الذي تعرفونه % وإن جهدت أفعالكم في نزوعه % 4(@)(@@) % يحب سنا البرق الذي لاح منكم % وما هو إلا جمرة في ضلوعه % 5(@)(@@) % ومنتصر بالدمع في رسم منزل % تذكر أيام الصبا في ربوعه % 6(@)(@@) % فلو أعشبت أطلالها من بكائه % لما رضيت أجفانه عن دموعه % 7(@)(@@) % إذا كان خوف الضيم أبعد داره % فلا تطمعوا في قربه ورجوعه % 8(@)(@@) % فما 
ms51	 هي إلا نخوة عامرية % تعلقها من حربه وربيعه % 9(@)(@@) % ورب هنات منكم صار ذكرها % % يمن على أجفانه بهجوعه % 10(@)(@@) % لحى الله من يرضى الدنية واصلا % لهاجرة أو حافظا لمضيعه % PageV01P187 11(@)(@@) % يقيم على أوطانه في ملمة % من الدهر يلقى عزها بخضوعه % 12(@)(@@) % وأين ذميل الأرحبية في الدجا % % واخذ السرى من بينها وهزيعه % 13(@)(@@) % ونصرة محمود بن نصر فلم تكن % بعازبة عن عبده ورضيعه % 14(@)(@@) % نزلت على رحب الفناء مريعة % ولذت بعادي البناء رفيعه % 15(@)(@@) % % صفحنا له عما مضى من صنيعه % 16(@)(@@) % أخي الغارة الشعواء في كل جانب % % من الأرض يروي باغيا من نجيعه % 17(@)(@@) % وذي الحرب ما ألقى تمائم مهده % عن الجيد حتى اجتاب زغف دروعه % 18(@)(@@) % فإن تنجز الأيام ممطول وعده % فقد بان ضوء الصبح قبل طلوعه % 19(@)(@@) % ومن عادة الله الحميدة عنده % منية عاصيه بسيف مطيعه % 20(@)(@@) % أقول لمغرور يخادع سلمه % حذار وثوب الليث بعد قبوعه % PageV01P188 21(@)(@@) % فإن التي أبصرت في يوم مالك % مكانك منها فرقة من جموعه % 22(@)(@@) % تضم كلاب كل يوم أمورها % % إلى ناشر المعروف فيها مذعه % 23(@)(@@) % إذا نابها خطب من الدهر عولت % على رأيه أو سيفه أو قطيعه % 24(@)(@@) % كفيل برد الأمر بعد ذهابه % عليها ودفع الخطب قبل وقوعه % 25(@)(@@) % لعمري لقد قاد ابن خان غليله % إلآ منهل يلقى الردى في شروعه % 26(@)(@@) % تعرض للسمر الطوال بنحره % وفيها شفاء من صداه وجوعه % 27(@)(@@) % ومن يكن العشار رائد سرعه % فلا تتعجب من وخيم رتوعه % 28(@)(@@) % وما يترك الأصل الذميم دناءة % من اللؤم إلا ردها في فروعه % 29(@)(@@) % جزى الله خيرا عصبة أنزلت به % على حكم مصقول الغرار صنيعه % 30(@)(@@) % أجابت ضريح المرتضى في غرية % وسرت ضريح المصطفى في بقيعه % PageV01P189 31(@)(@@) % % هو السيف إلا نبوة من هلوعه % 32(@)(@@) % أبا سابق لله فيك سريرة % % قضت بقريب النصر منه سريعه % 33(@)(@@) % إذا أظلمت سود الخطوب جلوتها % % برأي يعير الصبح ضوء صديعه % 34(@)(@@) % % بقلب جميل الظن فيك وسيعه % 35(@)(@@) % ومن كان يبغي شافعا في لبانه % فوجهك يغني سائلا عن شفيعه 
ms52	 % PageV01P190 البحر : بسيط تام 1(@)(@@) % أستغفر الله لا فخر ولا شرف % ولا وفاء ولا دين ولا أنف % 2(@)(@@) % كأنمأ نحن في ظلماء داجية % فليس ترفع عن أبصارنا السجف % 3(@)(@@) % تزيد بالبحث جهلا إن طلبت هدى % % وهل تضيء لعين المدلج السدف % 4(@)(@@) % وفي الفلاسفة الماضين معتبر % فطالما قصدوا فيها وما عسفوا % % 5(@)(@@) % وقد أتوك بمين من حديثهم % يكاد يضحك منه الحبر والصحف % 6(@)(@@) % ظن بعيد وأقوال ملفقة % تخفى على الغمر أحيانا وتنكشف % 7(@)(@@) % الأمر أكبر من فكر يحيط به % والعمر أقصر أن يلقى له طرف % 8(@)(@@) % فاعظم بدائك إن حاولت واضحة % ومت به فعلى هذا مضى السلف % 9(@)(@@) % جاءت أحاديث عن قوم أظنهم % % عاشوا طويلا وقالوا بعد ما خرفوا % % 10(@)(@@) % سخيفة ويزيد المخبرون بها % % فقد تجمع سوء الكيل الحشف % % PageV01P191 11(@)(@@) % يا حاكم المصر لا تحفل بذمهم % فإن كل قضاء عندهم جنف % 12(@)(@@) % ولا يغرك من دعواهم قسم % فالقوم أكذب ما كانوا إذا حلفوا % % 13(@)(@@) % يدين قوم بأن الشهب خالدة % وعند قوم لها وقت وتنصرف % 14(@)(@@) % وما رضيت بعقلي في جدالهم % ولا توهمت إلا غير ما وصفوا % % 15(@)(@@) % يا أم ذفر جزاك الله صالحة % وإن أضاف إليك القوم ما اقترفوا % % 16(@)(@@) % قالوا يغر بهم جهلا وعندهم % من المواعظ فيك الموت والخرف % 17(@)(@@) % وما تركت قبيحا تعرفين به % لو كان يأنف منك الهائم الدنف % 18(@)(@@) % ورب قوم أضاعوني وقد فهموا % % قدري فما أنكروا فضلي ولا عرفوا % % PageV01P192 البحر : كامل تام 1(@)(@@) % لولا سني الدولة بن محمد % ما كان للمعروف ذكر يعرف % 2(@)(@@) % كيف السبيل إلى مديحك بعدما % % وصفوا علاك بأنها لا توصف % 3(@)(@@) % أما دمشق فإنها بك روضة % ما تحتوي وسحابة ما تخلف % 4(@)(@@) % بلد أقمت به وذكرك سائر % في كل ناحية يخب ويوجف % 5(@)(@@) % لا يسأل العافون فيه لأنهم % لما رأوا شرف الكفاة به كفوا % % PageV01P193 البحر : كامل تام 1(@)(@@) % أملالة ضيعت ودي بعد ما % % وجبت عليك حقوقه الأسلاف % 2(@)(@@) % أم شئت تعلم أن جودك لم يدع % شيئا وأن طباعك الإتلاف % PageV01P194 البحر : طويل 1(@)(@@) % سلا 
ms53	 ظبية الوعساء هل فقدت خشفا % % فإنا لمحنا في مراتعها طرفا % % 2(@)(@@) % وقولا لخوط البان فليمسك الصبا % % علينا فإنا قد عرفنا بها عرفا % % 3(@)(@@) % سرت من هضبا الشام وهي مريضة % فما ظهرت إلا وقد كاد أن يخفى % % 4(@)(@@) % عليلة أنفاس يداوى بها الجوى % % وضعفا ولكنا نرجي بها ضعفا % % 5(@)(@@) % وهاتفة في البان تملي غرامها % % علينا وتتلو من صبابتها صحفا % % 6(@)(@@) % عجبت لها تشكو الفراق جهالة % وقد جاوبت من كل ناحية إلفا % % 7(@)(@@) % ويشجي قلوب العاشقين غناؤها % % وما فهموا مما تغنت به حرفا % % 8(@)(@@) % ولو صدقت فيما تقول من الأسى % % لما لبست طوقا ولا خضبت كفا % % 9(@)(@@) % أجارتنا أذكرت من كان ناسيا % وأضرمت نارا للصبابة ما تطفى % % 10(@)(@@) % وفي جانب الماء الذي تردينه % مواعيد ما ينكرن ليا ولا خلفا % % PageV01P195 11(@)(@@) % ومهزوزة للبان فيها شمائل % جعلن له في كل قافية وصفا % % 12(@)(@@) % لبسنا عليها بالثنية ليلة % من السود لم يطو الصباح لها سجفا % % 13(@)(@@) % لعمري لئن طالت علينا فإننا % % بحكم الثريا قد قطعنا لها كفا % % 14(@)(@@) % رمينا بها في الغرب وهي ذميمة % ولم تبق للجوزاء عقدا ولا شنفا % % 15(@)(@@) % كأن الدجى لما تولت نجومه % مدبر حرب قد هزمنا له صفا % % 16(@)(@@) % كأن عليه للمجرة روضة % مفتحة الأنوار أو نثرة زعفا % % 17(@)(@@) % كأنا وقد ألقي إلينا هلاله % سلبناه تاجا أو فصمنا له وقفا % % 18(@)(@@) % كأن السها إنسان عين غريقة % من الدمع تبدو كلما ذرفت ذرفا % % 19(@)(@@) % كأن سهيلا فارس عاين الوغى % % ففر ولم يشهد طرادا ولا زحفا % % 20(@)(@@) % كأن سنا المريخ شعلة قابس % تخطفها عجلان يقذفها قذفا % % PageV01P196 21(@)(@@) % كأن أفول النسر طرف تعلقت % به سنة ما هب منها ولا أغفى % % 22(@)(@@) % كأن نصير الملك سل حسامه % على الليل فانصاعت كواكبه كسفا % % 23(@)(@@) % رعى الله غيما طبق الأرض جوده % فلم يخل سهلا من نداه ولا نعفا % % 24(@)(@@) % وحيا على رغم الليالي خلائقا % لو انتحلتها ما ذممنا لها صرفا % % 25(@)(@@) % وأبلج أحيا دارس العدل بعدما % % ثوى وشقى المعروف من بعدما أشفى % % 26(@)(@@) % له نشوة في الجود 
ms54	 حتى كأنما % % يدير له العافي معتقة صرفا % % 27(@)(@@) % خفي مرام الكيد تفري شباته % وما مال عن نهج الوقار ولا خفا % % 28(@)(@@) % تفرد عن أهل الزمان بمذهب % يزيد به مستور لؤمهم كشفا % % 29(@)(@@) % إذا أفقروا أغنى وإن هدموا بنى % % وإن بخلوا أعطى وإن غدروا أوفى % % 30(@)(@@) % جرى سابقا في حلبة الجود وحده % وقال العدى كان السحاب له ردفا % % PageV01P197 31(@)(@@) % جمعت على المعروف شمل فزارة % وثقفت بالإحسان خيلهم الخنفا % % 32(@)(@@) % وقدت إليهم جلة يمنية % فقد حمدوا تلك المودة والحلفا % % 33(@)(@@) % ولو كنت في يوم الهباءة شاهدا % لطال على نفس الجذيمي أن يشفى % % 34(@)(@@) % وقد أسندت كلب إليك أمورها % % فما فقدت نصرا ولا عدمت عرفا % % 35(@)(@@) % وكم لك فيهم من يد ملهمية % إذا انتجعت أرخت سحائبها الوطفا % % 36(@)(@@) % أصاب سنان درها وهو حافل % وخلف للهرماس من بعده خلفا % % 37(@)(@@) % مواهب في قيس وقحطان لم تدع % لها حافرا يطوي البلاد ولا خفا % % 38(@)(@@) % أقامت على الأوطان تشرب ماءها % % نميرا وترعى روضها خضلا وحفا % % 39(@)(@@) % وقد بدرت في بحتر لك غضبة % منحتهم فيها القساوة والعنفا % % 40(@)(@@) % فدانوا لأطراف الأسنة عنوة % وكانوا لقاحا مارضوا خطة خسفا % % PageV01P198 41(@)(@@) % إذا نظروا خصب السواد ودونه % سيوفك حاروا لا أماما ولا خلفا % % 42(@)(@@) % وما حلب الورهاء إلا خريدة % عطفت عليها ثم طلقتها ألفا % % 43(@)(@@) % فإن ظهرت فيها عيوب كثيرة % فما عدمت وجدا عليك ولا لهفا % % 44(@)(@@) % وإن كفرت آيات جودك ضلة % فما طلبت إلا الصواعق والخسفا % % 45(@)(@@) % وقد عرست فيها الخطوب مقيمة % فلا عدمت من بعدك الجور والعسفا % % 46(@)(@@) % لك الخير قد وفيت جودك فرضه % ومن بذل المجهود في شكره وفي % % 47(@)(@@) % ولي فيك من غر القوافي فضائل % تقبل أفواه الرواة لها رشفا % % 48(@)(@@) % ينم بها طيب النسيم إذا هفا % % وينشرها نور الرياض إذا رفا % % 49(@)(@@) % وما أدعي در الكلام لأنه % صفاتك إلا أنني أحسن الرصفا % % PageV01P199 البحر : كامل تام 1(@)(@@) % ومرتح الأعطاف في أجفانه % سقم يزيد به سقام المدنف % 2(@)(@@) % عنفتني في حبه ولربما % % أبصرته فأتيت غير معنف % 3(@)(@@) % وأمرتني 
ms55	 بجحوده وبذكره % عنونت ذكر صحيفتي في الموقف % 4(@)(@@) % وحياته ما حاز مثل كماله % أحد ولا تجلب علي بيوسف % PageV01P200 البحر : طويل 1(@)(@@) % أبا حسن ما هفوتي بغريبة % إليك ولا غفرانها بطريف % 2(@)(@@) % فإن تقبل العذر الضعيف تطولا % فإن رجائي فيك غير ضعيف % PageV01P201 البحر : كامل تام 1(@)(@@) % في كل يوم نشطة ووثاق % فمتى يكون لدائها إفراق % 2(@)(@@) % إن كان أعطاها جذاب نسوعها % % سفها فقد لغبت بها الأعناق % 3(@)(@@) % تشكو صداها والدموع مناهل % ووجى المناسم والخدود طراق % 4(@)(@@) % فاستبق فضلتها إذا دب الونا % % فيها فما كل السرى أعناق % 5(@)(@@) % ودع النسيم بعيد من أخباره % فله حواش للحديث دقاق % 6(@)(@@) % ما ثم من علق العذيب بغائب % إلا وقد شهدت به الآماق % 7(@)(@@) % وعلى العضا إن كنت من جيرانه % نار تقاسم حرها العشاق % 8(@)(@@) % ومحلؤن عن المناهل بعد ما % % شرقت بحمة مائها الطراق % 9(@)(@@) % ومشتت العزمات ينفق عمره % حيران لا ظفر ولا إخفاق % 10(@)(@@) % أمل يلوح اليأس في أثنائه % وغنى يشف وراءه الإملاق % PageV01P202 11(@)(@@) % يمري غفافة ثروة لو أنها % % نوم لما شعرت به الأحداق % 12(@)(@@) % وتروقه خدع المنى فكأنها % % حق وكاذب وعدها ميثاق % 13(@)(@@) % أثرى اللئام وجده بنسيئة % عذراء ما فطنت بها الأرزاق % 14(@)(@@) % لولا نصير الملك طال ثواؤه % فيها وليس لأسره إطلاق % 15(@)(@@) % القائد الزل الصعاب كأنها % % مما يجوب به الفلاة حقاق % 16(@)(@@) % ومؤلف الأهواء بعد شتاتها % % طوعا فما بين القلوب شقاق % 17(@)(@@) % يسطو وقد برقت أسرة وجهه % بشرا فيمزج أمنه الإشفاق % 18(@)(@@) % كالسيف يسعر حده نار الوغى % % والماء في صفحاته رقراق % 19(@)(@@) % ما هزه طرب العقار وإنما % % أعطته نشوة كأسها الأخلاق % 20(@)(@@) % هي في الهوى وعد الوصال وفي الكرى % % طيف الخيال وفي الوداع عناق % PageV01P203 21(@)(@@) % ينمى إلى حسب تقدم ملهم % فيه وعز على النجوم لحاق % 22(@)(@@) % بيت له الشرف القديم وغيره % كالشيب جدة مثله إخلاق % 23(@)(@@) % البرك دثر والقباب فسيحة % والجود غمر والجفان عماق % 24(@)(@@) % أحيا الندى جذلان ثم بحلمه % بشر يهاب كأنه إطراق % 25(@)(@@) % وحمى العواصم بعد ما عاث العدى % % فيها وحاول 
ms56	 سرحها المراق % 26(@)(@@) % ما ضرها جدب وأنت ربيعها % % الحالي وكفك غيثها الغيداق % 27(@)(@@) % ظن ابن باديس بعادك جنة % فأبت نواحل كالقسي دقاق % 28(@)(@@) % ألهاه عن نظر العواقب سامر % غرد وكأس بالعقار دهاق % 29(@)(@@) % وأقام يسجع بالظنون سفاهة % ومن الظنون خديعة ونفاق % 30(@)(@@) % حتى إذا طالعت ثغرة كيده % وهفا عليه لواؤك الخفاق % PageV01P204 31(@)(@@) % ونزت جيادك للطراد كأنها % % سرب المها ورماحك الأوراق % 32(@)(@@) % ولى يذم له قوائم سابح % جمحت به الخيلاء وهي إباق % 33(@)(@@) % ورمى بصيرة في مخالب ضيغم % طيان تفتح باسمه الأغلاق % 34(@)(@@) % ما دب للصهباء في أعطافه % فرح ولا عبثت به الأعلاق % 35(@)(@@) % دامي الأسنة ما تقر جياده % حتى تضيء بعدله الآفاق % 36(@)(@@) % بالقيروان لها عمامة عثير % وطفاء وابلها الدم المهراق % 37(@)(@@) % وعلى خليج الروم برق صفائح % تفري ذيول النقع وهي صفاق % 38(@)(@@) % فتنازع الكفار فضلة كأسها % % من بعد ما ثملت به الفساق % 39(@)(@@) % عادت سهامهم الحداد كليلة % حتى كأن نصالها أفواق % 40(@)(@@) % صحبتهم باللاذقية فالتقى % % بحران ماء راكد وعتاق % PageV01P205 41(@)(@@) % فات الظلام بها فعفت ورودها % % تبعا وأنت بمثلها سباق % 42(@)(@@) % حتى إذا سفر الضحى وتمارت % أبصار ايكما له الإشراق % 43(@)(@@) % غادرتها دمنا على أطلالها % % يبكي الخليط وتذكر الأشواق % 44(@)(@@) % وشرعت دين قراك في عرصاتها % % فالنار تضرم والدماء تراق % 45(@)(@@) % فأطاع جامحها وكانت زبرة % % عوجاء ثقف ميلها الإحراق % 46(@)(@@) % شرفا بني كعب فما عذب الجنى % % إلا بما سبقت به الأغراق % 47(@)(@@) % شادت سيوف أبي علي فيكم % مجدا له فوق السماء طباق % 48(@)(@@) % وسعى المهذب سعيه فتوافقا % % إن كان بين الفرقدين وفاق % 49(@)(@@) % يا جامع الحسنات إن غرائبي % % تهدى وليس سوى الوداد صداق % 50(@)(@@) % لو أنصفت زفت إلى خطابها % % والبدر تاج والنجوم نطاق % PageV01P206 51(@)(@@) % لم تعترضها بالحجاب نقيصة % ما كل ما ستر البدور محاق % PageV01P207 البحر : وافر تام 1(@)(@@) % وقالوا قد تغيرت الليالي % % وضيعت المنازل والحقوق % 2(@)(@@) % وأقسم ما استجد الدهر خلقا % وما عدوانه إلا عتيق % 3(@)(@@) % أليس يرد عن فدك علي % ويملل أكثر الدنيا عتيق % PageV01P208 البحر : طويل 1(@)(@@) % بقيت وقد شطت 
ms57	 بكم غربة النوى % % وما كنت أخشى أنني بعدكم أبقى % % 2(@)(@@) % وعلمتموني كيف أصبر عنكم % وأطلب من رق الغرام بكم عتقا % % 3(@)(@@) % فما قلت يوما للبكاء عليكم % رويدا ولا للشوق نحوكم رفقا % % 4(@)(@@) % فما الحب إلا أن أعد قبيحكم % إلي جميلا والقلى منكم عشقا % % PageV01P209 البحر : طويل 1(@)(@@) % كتبت فهجنت الذين تقدموا % % وأعلمتنا أن التأخر في السبق % 2(@)(@@) % وأغضيت عن نظم القريض سماحة % به فظننا أن ذلك عن حق % 3(@)(@@) % فإن عدت تهدي منه كل عجيبة % إلينا فكم من معجز لك في السبق % 4(@)(@@) % ومن لي بأن ألقى بعيني كلما % % شكوت وما يرتاب مثلك في صدقي % % 5(@)(@@) % ووالله لو شاطرتك العمر ما وفت % حياتي بأدنى منة لك في عنقي % % PageV01P210 البحر : بسيط تام 1(@)(@@) % إذا سكنتم فقلبي دائم القلق % وإن رقدتم فطرفي دائم الأرق % 2(@)(@@) % سرقت بالنوم وصلا من خيالكم % فصار نومي مقطوعا على السرق % PageV01P211 البحر : كامل تام 1(@)(@@) % أنفقت بعد أبي العلاء مدامعا % حبست ذخيرتها على الإنفاق % 2(@)(@@) % وبكيته وجفونها موجودة % % مثل الحمام تنوح بالأطواق % 3(@)(@@) % لا تدعي حسن الوفاء بعهده % من بعد ما فنيت وطرفي باقي % % 4(@)(@@) % ولقد حذرت عليه لو دفع الردى % % حذري ورد منية إشفاقي % % 5(@)(@@) % وظننت في فيض الدموع من الجوى % % فرجا فصار بمائها إحراقي % % 6(@)(@@) % لهفي عليك وكيف ينفع ذاهبا % % لهف الحزين ولوعة المشتاق % PageV01P212 البحر : خفيف تام 1(@)(@@) % يا نسيم الصبا تحمل ومازل % % زلت معنى في خدمة العشاق % 2(@)(@@) % حاجة خف حملها ولها من % ثقيل يبقى على الأعناق % 3(@)(@@) % وتعرض بمنزل في كفر طا % % ب كثير الزوار والطراق % 4(@)(@@) % كيف يستطلق المنى من يد الده % % ر وتبغي نشائد الأرزاق % 5(@)(@@) % فاقر مني له السلام فقد قي % قيل بلاغ السلام بعض التلاقي % % 6(@)(@@) % ثم قل يا بني كنانة ما أس % ما حلتم عن الميثاق % 9(@)(@@) % أو بحكم المودعين إذا % % له أن يسير نحو العراق % 10(@)(@@) % كلف يخجل القلوب بدعوا % % ه وشوق عاد عن الأشواق % 11(@)(@@) % واحتراق في العقل قد كاد أن % يمزج عندي أخلاقهم بالنفاق % 12(@)(@@) % ثم يا 
ms58	 صاحب الجناية منهم % قد لقينا في البعد ما لم تلاق % PageV01P213 13(@)(@@) % كيف ترضى بمقلة تألف النو % % م ودمع يصان في الآماق % 14(@)(@@) % وزمان الصبا يمر وقد أن % % أنفق أيامه زمان الفراق % 15(@)(@@) % والليالي تمضي سراعا وما يق % % يقبل منها إحالة في البواقي % % 16(@)(@@) % فاجر في حلبة الخلاعة ما دم % ت بحكم الشباب شرط السباق % 17(@)(@@) % واعتمد مذهب الشريف فقد قا % % ل النصابي رياضة الأخلاق % PageV01P214 البحر : مجزوء الرمل 1(@)(@@) % يا حبيبا وده للن % اس تمثال النفاق % 2(@)(@@) % أنت بدر التم لكن % لك عهد في المحاق % 3(@)(@@) % قد بلوناك على حا % % ل التنائي والتلاقي % % PageV01P215 البحر : خفيف تام 1(@)(@@) % كيف أشكو منك الجفاء وما % % للمجد فرع إلا على أعوادك % 2(@)(@@) % أو أناجيك بالقطيعة والعلياء % % ياء ممن تعد في حسادك % 3(@)(@@) % غير أني أذم دهرا رماني % % فيك حتى أخللت في إبعادك % 4(@)(@@) % وتصاممت عن نداي بلا وق % % ر فيا ليت أنني لم أنادك % 5(@)(@@) % أحمد الله إن أمرا من الحاج % يسيرا أضاء ما في فؤادك % 6(@)(@@) % لم يكلني إليك في حادث لا % % يتخطى إلا على إسعادك % PageV01P216 البحر : خفيف تام 1(@)(@@) % لست أخشى تغيرا في اعتقادك % بعد علمي بموضعي من فؤادك % 2(@)(@@) % أحجب الواردين عنه ولا آ % % ذن إلا لصافي ودادك % 3(@)(@@) % وأرى كلما تجن فلا أت % رك شيئا يخاف من أحقادك % 4(@)(@@) % ويعد العتاب منك وإن أسرف % رف غمر الثقاف من إرشادك % 5(@)(@@) % فالتمس من يروعه ظاهر القو % ل ويخفى عليه سر مرادك % 6(@)(@@) % لا مطلا على ضميرك قد ذل % في هواك صعب قيادك % 7(@)(@@) % يأمن الحاسدين فيك إذا % % فكر في صفو وده وسدادك % 8(@)(@@) % منة من فنون برك ما تو % % جب إلا المزيد من إحمادك % PageV01P217 البحر : كامل تام 1(@)(@@) % منعوا خيالك أن يلم بنا % % وعلى وصالك يحسن البخل % 2(@)(@@) % ما عندهم إن الرقاد إذا % % ما بنت عن عيني يرتحل % 3(@)(@@) % ردوا علي النوم ويحكم % ودعوا الخيال يصد أو يصل % PageV01P218 البحر : طويل 1(@)(@@) % فإن كفروا نعماك فيهم فإنها % % ديون تقاضتها الرماح الذوابل % 2(@)(@@) % وإن 
ms59	 قابلوها بالجحود سفاهة % فقد عرفتها سمرهم والمناصل % 3(@)(@@) % أتوك فحانت ساهريها مضارب % حياء وعاصت مشرعيها عوامل % PageV01P219 البحر : كامل تام 1(@)(@@) % يا حادي الأظعان أين تميل % هي وجرة وسؤالها تعليل % 2(@)(@@) % ما هذه في الربع أول وقفة % وقفت فينشد قاتلا مقتول % 3(@)(@@) % عجنا بناحل رسمه فتحيرت % فيه دموع ما لهن مسيل % 4(@)(@@) % وتحملت ليد السحاب طلوله % منا ونحن سحائب وطلول % 5(@)(@@) % وعلى العذيب ولا أغشك بانة % ما ظلها لولا السقام ظليل % 6(@)(@@) % ومرنح في الكور تحسبه الصبا % % غصنا يميد بمرها ويميل % 7(@)(@@) % حملت إليه تحية ونسيمها % % أبدا على دين الغرام رسول % 8(@)(@@) % ما كنت تخبر قبلها عن حاجر % إلا وطيبك شاهد مقبول % 9(@)(@@) % وتبث ما كتم الأقاح ولو درى % % ما كان منك لثغره تقبيل % 10(@)(@@) % وفوارس ألفوا القنا فكأنه % قبل الطعان ببوعهم موصول % PageV01P220 11(@)(@@) % ذعروا الظلام فما يمر عليهم % إلا وعقد نجومه محلول % 12(@)(@@) % طمحت بهم آمالهم ولواؤهم % قدر بما وعد الكرام مطول % 13(@)(@@) % ومطوح ركب الخداع مطية % ما ظهرها يوم اللقاء ذلول % 14(@)(@@) % كيف اهتديت لعامر ورعالها % % سدف وستر مجالها مسدول % 15(@)(@@) % جمحت بك الخيلاء حتى هجتها % % شنعاء ثار صريعها مطلول % 16(@)(@@) % وبدت مخائلها لديك مضيئة % لو كان عندك للصباح دليل % 17(@)(@@) % وظننت عوفا بالطعان بجيلة % ظن لعمرك بالحمام جميل % 18(@)(@@) % أو ما بسنجار لقومك مصرع % شهدت به في المرهفات فلول % 19(@)(@@) % طلبوا النجاء فكان في أعمارهم % قصر وفي سمر الذوابل طول % 20(@)(@@) % فذر العراق طريدة مبذولة % سبق الأسنة سرحها المشلول % PageV01P221 21(@)(@@) % وامنع حليفك بالعراق وقل له % هيهات ذاد عن الفرات النيل % 22(@)(@@) % وحذار من كلأ الجزيرة إنه % مرعى بأطراف الرماح وبيل % 23(@)(@@) % صحت فليس سوى الجفون مريضة % فيها ولا غير النسيم عليل % 24(@)(@@) % وثنى زعيم الدين فضل جماحها % % فالليل فجر والرياح قبول % 25(@)(@@) % إن كان حل بها وفارق داره % فالليث يفرق بأسه لا الفيل % 26(@)(@@) % نشوان يخطر للندى في هزة % علموا بها أن السماح شمول % 27(@)(@@) % يغتال بادرة الخطوب بريثة % وينال أقصى الحزم وهو عجول % 28(@)(@@) % عطر الثناء تضوعت 
ms60	 أوصافه % طيبا فكل فم به معلول % 29(@)(@@) % ما كان يعلم قبل فيض نواله % أن الغمام إذا استهل بخيل % 30(@)(@@) % فرقت عزائمه فشاب لها الدجا % % خوفا وأثر في الهلال نحول % PageV01P222 31(@)(@@) % لو أن للأيام نار ذكائه % ما كان فيها بكرة وأصيل % 32(@)(@@) % شرف بنو عبد الرحيم عماده % ولربما تضع الفروع أصول % 33(@)(@@) % أبقى به عبق الثناء لرهطه % والحمد حظ للكرام جزيل % 34(@)(@@) % قوم إذا نضب الكلام وأظلمت % للناطقين خواطر وعقول % 35(@)(@@) % شاموا مضارب ألسن عربية % تفري وماضي المرهفات كليل % 36(@)(@@) % إن فاتهم برد يلاث ومنبر % فلهم سرير الملك والإكليل % 37(@)(@@) % نسب هدى زهر النجوم مناره % وسواه فقع قراره مجهول % 38(@)(@@) % يا جامع الآمال وهي بدائد % ومروض الأيام وهي محول % 39(@)(@@) % أعني كمالك أن تعد فضيلة % كالصبح لا رثم ولا تحجيل % 40(@)(@@) % لولاك ما ارتجت الأكف فلم يكن % في الدهر لا أمل ولا مأمول % PageV01P223 41(@)(@@) % ما ضر ناشرة ورأيك فيهم % أن لا يفارق غمده مصقول % 42(@)(@@) % قل للأمير أبي الأغر ودونه % للطالبين سباسب وهجول % 43(@)(@@) % عادات جدك في العدا منصورة % أبدا وسيفك ضامن وكفيل % 44(@)(@@) % أسلفت جوثة منة مشهورة % % فوفت بحمدك والوفاء قليل % 45(@)(@@) % وثوى ابن عمك بالعراق وقومه % كالذود حن وفحله معقول % 46(@)(@@) % ما صدهم عنك الجفاء وإنما % % مالوا مع الأيام حيث تميل % 47(@)(@@) % وغريبة دارت وما نبغي بها % % إلا الوداد فهل إليه سبيل % 48(@)(@@) % إن شفعت آمالها في نيله % فلتسمع الفصحاء كيف أقول % PageV01P224 البحر : وافر تام 1(@)(@@) % أفي نجد تحاورك القبول % أظن الريح تفهم ما تقول % 2(@)(@@) % تغنت في رحال الركب حتى % % تشابهت الذوائب والذبول % 3(@)(@@) % صحبنا في دياركم صباها % % تناوبها التنفس والنحول % 4(@)(@@) % وأمطرنا سحاب الدمع حتى % % حسبنا أنه مهج تسيل % 5(@)(@@) % وعجنا ذاهلين فما علمنا % % أنحن السائلون أم الطلول % 6(@)(@@) % وأعدينا بذكركم الخزامى % % فمال مع النسيم كما يميل % 7(@)(@@) % وفي الأظعان لينة الثني % عصي الردف مانعة بذول % 8(@)(@@) % سألناها تحيينا فضنت % وذلك لو تجود به جزيل % 9(@)(@@) % سقت أرض السوية والغوادي % % تهاداها الأباطح والسهول % 10(@)(@@) % يمانية تصفقها النعامى 