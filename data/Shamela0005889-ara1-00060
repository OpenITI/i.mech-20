ms41	 - (@)(@@) والحافظ أبو بكر محمد بن احمد بن عبد الباقي بن الخاضبة البغدادي(@)(@@)(@@)(@@) | 1560 - (@)(@@) والإمام أبو المظفر منصور بن محمد بن عبد الجبار السمعاني المروزي الحنفي ثم الشافعي(@)(@@)(@@)(@@) | 1561 - (@)(@@) والرئيس أبو الفتح عبدوس بن محمد بن عبدوس الهمذاني(@)(@@)(@@)(@@) | 1562 - (@)(@@) وشيخ دمشق الفقيه أبو الفتح نصر بن إبراهيم المقدسي الزاهد(@)(@@)(@@)(@@) | 1563 - (@)(@@) وأبو العباس احمد بن عبد الغفار بن أشته الأصبهاني الكاتب(@)(@@)(@@)(@@) | 1564 - (@)(@@) والحافظ أبو محمد الحسن بن أحمد السمرقندي صاحب المستغفري(@)(@@)(@@)(@@) | 1565 - (@)(@@) والمحدث أبو الفرج سهل بن بشر الإسفرائيني نزيل دمشق(@)(@@)(@@)(@@) | 1566 - (@)(@@) والنقيب الكامل أبو الفوارس طراد بن محمد بن علي الزينبي ببغداد(@)(@@)(@@)(@@) | 1567 - (@)(@@) والحافظ الزاهد أبو سعد محمد بن الحسين الحرمي نزيل هراة سمع بمصر من ابن حمصة والبندار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1568 - (@)(@@) وأبو الحسين مكي بن منصور بن علان الكرجي(@)(@@)(@@)(@@) | 1569 - (@)(@@) وأبو الحسن هبة الله بن عبد الرزاق الأنصاري صاحب الحفار(@)(@@)(@@)(@@) | 1570 - (@)(@@) وأبوالحسين احمد بن عبد القادر بن محمد بن يوسف البغدادي(@)(@@)(@@)(@@) | 1571 - (@)(@@) ومسند بلخ الدهقان أبو القاسم احمد بن محمد بن محمد الخليلي عاش مائة سنة وروى مسند الهيثم(@)(@@)(@@)(@@) | 1572 - (@)(@@) ومسند مصر القاضي أبو الحسن علي بن الحسن بن الحسين الخلعي الشافعي(@)(@@)(@@)(@@) | 1573 - (@)(@@) والحافظ أبو القاسم مكي بن عبد السلام الرميلي من جملة الشهداء بيت المقدس(@)(@@)(@@)(@@) | 1574 - (@)(@@) ومسند البصرة أبو طاهر جعفر بن محمد بن الفضل القرشي العباداني خاتمة أصحاب أبي عمر الهاشمي(@)(@@)(@@)(@@) | 1575 - (@)(@@) ومسند بغداد أبو عبد الله الحسين بن احمد بن محمد بن طلحة النعالي(@)(@@)(@@)(@@) | 1576 - (@)(@@) ومسند نيسابور علي بن احمد بن الأخرم المؤذن أبو الحسن الزاهد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1577 - (@)(@@) وأبو الخطاب مسند العصر نصر بن احمد بن البطر القارىءببغداد(@)(@@)(@@)(@@) | 1578 - (@)(@@) وميند خراسان بل مسند الدنيا أبو محمد بن عبد الواحد بن عبد الرحمن الزبيري الوركي عن مائة وثلاثين سنة قاله السمعاني(@)(@@)(@@)(@@) | 1579 - (@)(@@) والمسند أبو عبد الله محمد بن احمد بن محمد الكامخي النيسابوري(@)(@@)(@@)(@@) | 1580 - (@)(@@) ومقرىء العراق أبو طاهر أحمد بن علي بن عبيد الله بن عمر بن سوار(@)(@@)(@@)(@@) | 1581 - (@)(@@) ومقرىء الأندلس أبو داود بن الحاج الأموي الداني(@)(@@)(@@)(@@) | 1582 - (@)(@@) وأبو بكر احمد 
ms42	 بن الحسين الطريثيثي الصوفي(@)(@@)(@@)(@@) | 1583 - (@)(@@) والمسند أبو عبد الله الحسين بن علي بن احمد البسري البندار خاتمة أصحاب عبد الله بن يحيى البكري(@)(@@)(@@)(@@) | 1584 - (@)(@@) وأبو مسلم عبد الرحمن بن عمر السمناني ثم البغدادي المتكلم سبط القاضي أبي جعفر السمناني(@)(@@)(@@)(@@) | 1585 - (@)(@@) وأبو مكتوم عيسى ابن الحافظ أبي ذر عبد بن أحمد الهروي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1586 - (@)(@@) وأبو الخطاب علي بن عبد الرحمن بن الجراح الشافعي الكاتب المقرىء(@)(@@)(@@)(@@) | 1587 - (@)(@@) ومسند أصبهان أبو مطيع محمد بن عبد الواحد بن عبد العزيز المديني(@)(@@)(@@)(@@) | 1588 - (@)(@@) ومسند الأندلس الفقيه أبو عبد الله محمد بن الفرج مولى ابن الطلاع القرطبي(@)(@@)(@@)(@@) | 1589 - (@)(@@) والحافظ أبو علي أحمد بن محمد بن أحمد البرداني البغدادي سمع ابن غيلان وطبقته(@)(@@)(@@)(@@) | 1590 - (@)(@@) وأبو بكر أحمد بن محمد ابن الحافظ أبي احمد بن موسى ابن مردويه الأصبهاني ثقة صاحب حديث(@)(@@)(@@)(@@) | 1591 - (@)(@@) وأبو المعالي ثابت بن بندار الدينوري ثم البغدادي البقال(@)(@@)(@@)(@@) | 1592 - (@)(@@) وشيخ الحرم أبو عبد الله الحسين بن علي الطبري راوي صحيح مسلم(@)(@@)(@@)(@@) | 1593 - (@)(@@) والحافظ المحقق أبو علي الحسين بن محمد الغساني الجياني سمع من حكم بن محمد الجذامي(@)(@@)(@@)(@@) | 1594 - (@)(@@) والمسند أبو علي نصر الله بن احمد بن عثمان الخشنامي النيسابوري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1595 - (@)(@@) والزاهد القدوة أبو منصور محمد بن أحمد بن علي البغدادي المقرىء الخياط(@)(@@)(@@)(@@) | 1596 - (@)(@@) ومسند الكوفة أبو البقاء المعمر بن محمد بن علي الحبال الخراز(@)(@@)(@@)(@@) | 1597 - (@)(@@) ومسند أصبهان أبو الفتح أحمد بن محمد بن احمد بن سعيد الحداد المقرىء(@)(@@)(@@)(@@) | 1598 - (@)(@@) ومسند زنجان الفقيه أبو بكر احمد بن محمد بن احمد بن محمد ابن زنجويه في عشر المائة(@)(@@)(@@)(@@) | 1599 - (@)(@@) والإمام أبو محمد جعفر بن احمد بن الحسين بن السراج ببغداد(@)(@@)(@@)(@@) | 1600 - (@)(@@) والمسند أبو غالب محمد بن الحسن بن أحمد الباقلاني(@)(@@)(@@)(@@) | 1601 - (@)(@@) والإمام المحدث أبو الحسين المبارك بن عبد الجبار البغدادي الصيرفي ابن الطيوري(@)(@@)(@@)(@@) | 1602 - (@)(@@) ومسند أصبهان أبو الفتح أحمد بن عبد الله بن احمد السوذرجاني(@)(@@)(@@)(@@) | 1603 - (@)(@@) وأخوه أبو مسعود محمد(@)(@@)(@@)(@@) | 1604 - (@)(@@) والشيخ أبو محمد عبد الرحمن الدوني(@)(@@)(@@)(@@) | 1605 - (@)(@@) والإمام أبو المحاسن عبد الواحد بن محمد الروياني الشافعي 
ms43	 صاحب البحر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1606 - (@)(@@) والمسند أبو القاسم علي بن الحسن الربعي(@)(@@)(@@)(@@) | 1607 - (@)(@@) ومحمد بن عبد الكريم بن حشيشش(@)(@@)(@@)(@@) | 1608 - (@)(@@) وأبو سعد محمد بن احمد المطرز الأصبهاني(@)(@@)(@@)(@@) | 1609 - (@)(@@) ومسند بغداد علي بن محمد بن علي العلاف الحاجب(@)(@@) PageV00P000(@)(@@) (19)(@)(@@)(@@)(@@) | طبقة تابعة لمن مضى وإلى حدود الثلاثين وخمسمائة(@)(@@)(@@)(@@) | 1610 - (@)(@@) شيخ الشافعية ببغداد إلكيا أبو الحسن علي بن محمد الهراسي(@)(@@)(@@)(@@) | 1611 - (@)(@@) وشيخ الشافعية بخراسان أبو حامد محمد بن محمد الطوسي الغزالي صاحب التصانيف(@)(@@)(@@)(@@) | 1612 - (@)(@@) وأبو القاسم إسماعيل بن الحسن السنجبستي صاحب أبي بكر الحيري(@)(@@)(@@)(@@) | 1613 - (@)(@@) وأبو بكر أحمد بن علي بن بدران الحلواني المقرىء(@)(@@)(@@)(@@) | 1614 - (@)(@@) والحافظ شجاع بن فارس الذهلي(@)(@@)(@@)(@@) | 1615 - (@)(@@) وشيخ الشافعية أبوبكر محمد بن أحمد الشاشي(@)(@@)(@@)(@@) | 1616 - (@)(@@) والحافظ أبو الفضل محمد بن طاهر المقدسي بهمذان(@)(@@)(@@)(@@) | 1617 - (@)(@@) والحافظ المؤتمن بن احمد بن علي الساجي(@)(@@)(@@)(@@) | 1618 - (@)(@@) والشريف النسيب أبو القاسم علي بن إبراهيم الحسيني الدمشقي(@)(@@)(@@)(@@) | 1619 - (@)(@@) وصاحب المجالس إسماعيل بن محمد بن مسلمة المحتسب(@)(@@)(@@)(@@) | 1620 - (@)(@@) والمحدث شيرويه بن شهردار الديلمي الهمذاني مصنف الفردوس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1621 - (@)(@@) والحافظ خميس بن علي الحوزي الواسطي(@)(@@)(@@)(@@) | 1622 - (@)(@@) ومسند خراسان عبد الغافر بن محمد بن علي بن شيرويه النيسابوري التاجر(@)(@@)(@@)(@@) | 1623 - (@)(@@) ومسند العراق أبو القاسم على بن احمد بن محمد بن بيان الرزاز(@)(@@)(@@)(@@) | 1624 - (@)(@@) وأبو علي محمد بن سعيد بن نبهان الكاتب(@)(@@)(@@)(@@) | 1625 - (@)(@@) وأبو طاهر محمد بن الحسين الحنائي الدمشقي(@)(@@)(@@)(@@) | 1626 - (@)(@@) والمحدث أبو الغنائم محمد بن علي بن ميمون النرسي الكوفي ولقبه أبي(@)(@@)(@@)(@@) | 1627 - (@)(@@) والحافظ أبو بكر محمد بن مسعود بن السمعاني المروزي كهلا(@)(@@)(@@)(@@) | 1628 - (@)(@@) ومسند أصبهان غانم بن محمد البرجي(@)(@@)(@@)(@@) | 1629 - (@)(@@) والحافظ أبو زكريا يحيى بن عبد الوهاب بن محمد بن مندة العبدي(@)(@@)(@@)(@@) | 1630 - (@)(@@) ونور الهدي أبو طالب الحسين بن محمد بن علي الزينبي(@)(@@)(@@)(@@) | 1631 - (@)(@@) وشيخ الحنابلة أبو الوفاء علي بن محمد بن عقيل(@)(@@)(@@)(@@) | 1632 - (@)(@@) والمسند محمد بن عبد الباقي الدوري(@)(@@)(@@)(@@) | 1633 - (@)(@@) والحافظ أبو علي بن محمد بن سكرة الصدفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1634 - (@)(@@) والمسند أبو الحسن علي بن الحسن ابن الموازيني الدمشقي(@)(@@)(@@)(@@) | 1635 - (@)(@@) وأخوه أبو الفضل محمد(@)(@@)(@@)(@@) | 1636 - (@)(@@) ومحمود بن اسماعيل الصيرفي الأصبهاني الأشقر 
ms44	(@)(@@)(@@)(@@) | 1637 - (@)(@@) والمقرىء أبو علي الحسن بن احمد بن الحسن الأصبهاني الحداد صاحب أبي نعيم(@)(@@)(@@)(@@) | 1638 - (@)(@@) وأبوعلي محمد بن محمد المهدي(@)(@@)(@@)(@@) | 1639 - (@)(@@) ومحيي السنة أبو محمد الحسين بن مسعود البغوي(@)(@@)(@@)(@@) | 1640 - (@)(@@) والمحدث أبو محمد عبد السيد بن احمد بن عمر بن السمرقندي(@)(@@)(@@)(@@) | 1641 - (@)(@@) ومقرىء الوقت أبو القاسم عبد الرحمن بن ابي بكر بن أبي سعيد الصقلي ابن الفحام بالإسكندرية(@)(@@)(@@)(@@) | 1642 - (@)(@@) والمسندأبو طالب عبد القادر بن محمد اليوسفي(@)(@@)(@@)(@@) | 1643 - (@)(@@) وابن عمه أبو طاهر عبد الرحمن بن احمد راوي سنن الدارقطني(@)(@@)(@@)(@@) | 1644 - (@)(@@) والعلامة أبو محمد القاسم بن علي الحرامي البصري الحريري(@)(@@)(@@)(@@) | 1645 - (@)(@@) والحافظ أبو عبد الله محمد بن عبد الواحد الأصبهاني الدقاق(@)(@@)(@@)(@@) | 1646 - (@)(@@) وأبو سعد أحمد بن عبد الجبار بن الطيوري الصيرفي المقرىء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1647 - (@)(@@) والحافظ أبو نعيم عبيد الله بن الحسن بن أحمد بن الحسن الحداد سمع أبا عمر وابن مندة(@)(@@)(@@)(@@) | 1648 - (@)(@@) وأبو الغنائم محمد بن محمد بن احمد بن المهتدي بالله الخطيب(@)(@@)(@@)(@@) | 1649 - (@)(@@) ومسند مصر أبو صادق مرشد بن يحيى بن القاسم المدني(@)(@@)(@@)(@@) | 1650 - (@)(@@) وخاتمة أصحاب أبي نعيم الحافظ أبو طاهر عبد الواحد بن محمد ابن احمد الذهبي الدشتج(@)(@@)(@@)(@@) | 1651 - (@)(@@) والمسند أبو البركات هبة الله بن محمد بن علي بن البخاري البغدادي المعدل(@)(@@)(@@)(@@) | 1652 - (@)(@@) والحافظ أبو العلاء صاعد بن سيار بن محمد الإسحاقي الدهان الهروي كهلا(@)(@@)(@@)(@@) | 1653 - (@)(@@) ومسند الأندلس أبو محمد عبد الرحمن بن محمد بن عتاب القرطبي له إجازة مكي(@)(@@)(@@)(@@) | 1654 - (@)(@@) والإمام العلامة أبو عبد الله محمد بن بركات بن هلال الصعيدي المصري صاحب كريمة(@)(@@)(@@)(@@) | 1655 - (@)(@@) والإمام أبو بكر محمد بن الوليد بن محمد الفهري الطرطوشي المالكي(@)(@@)(@@)(@@) | 1656 - (@)(@@) وأبو الحسن علي بن عبد الواحد بن أحمد الدينوري ثم البغدادي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1657 - (@)(@@) ومقرىء العراق أبو العز محمد بن الحسين بن بندار القلانسي بواسط(@)(@@)(@@)(@@) | 1658 - (@)(@@) ومسند مرو أبو منصور محمد بن علي بن محمود الكراعي المروزي(@)(@@)(@@)(@@) | 1659 - (@)(@@) وأبو الفضل جعفر بن عبد الواحد بن محمد الثقفي الرئيس(@)(@@)(@@)(@@) | 1660 - (@)(@@) وأبو الحسن عبيد الله بن محمد الإمام أبي بكر البيهقي سمع الكتب من جده(@)(@@)(@@)(@@) | 1661 - (@)(@@) وأبو 
ms45	 الفتح إسماعيل بن الفضل بن الإخشيد الأصبهاني السراج(@)(@@)(@@)(@@) | 1662 - (@)(@@) والبارع أبو عبد الله الحسين بن محمد بن عبد الوهاب البغدادي المقرىء الدباس(@)(@@)(@@)(@@) | 1663 - (@)(@@) ومسندة أصبهان أم إبراهيم فاطمة بنت عبد الله بن احمد بن عقيل الجوزدانية عن بضع وتسعين سنة(@)(@@)(@@)(@@) | 1664 - (@)(@@) وأبو الأعز قراتكين بن الأسعد الأزجي سمع الجوهري(@)(@@)(@@)(@@) | 1665 - (@)(@@) والحافظ أبو عامر بن محمد سعدون بن مرجا العبدري المتوفى ببغداد(@)(@@)(@@)(@@) | 1666 - (@)(@@) ومحدث دمشق أبو محمد هبة الله بن احمد بن محمد بن الأكفاني الأنصاري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1667 - (@)(@@) ومسند الإسكندرية أبو عبد الله محمد بن احمد بن ابراهيم ابن الحطاب الرازي المعدل(@)(@@)(@@)(@@) | 1668 - (@)(@@) وأبو غالب محمد بن محمد بن الحسن بن علي الماوردي البصري(@)(@@)(@@)(@@) | 1669 - (@)(@@) ومسند العصر أبو القاسم هبة الله بن محمد بن عبد الواحد ابن الحصين الشيباني الكاتب ببغداد(@)(@@)(@@)(@@) | 1670 - (@)(@@) وأبو العز احمد بن عبيد الله بن كادش السلمي العكبري سمع القاضي أبا الطيب(@)(@@)(@@)(@@) | 1671 - (@)(@@) ومسند دمشق أبو محمد عبد الكريم بن حمزة بن الخضر السلمي الحداد(@)(@@)(@@)(@@) | 1672 - (@)(@@) والإمام أبو الحسين بن محمد القاضي أبو يعلى محمد بن الفراء الحنبلي(@)(@@)(@@)(@@) | 1673 - (@)(@@) ومسند بغداد أبو غالب احمد بن الحسن بن احمد بن البناء(@)(@@)(@@)(@@) | 1674 - (@)(@@) والحافظ أبو نصر الحسن بن محمد بن ابراهيم بن اليونارتي الأصبهاني(@)(@@)(@@)(@@) | 1675 - (@)(@@) والعلامة المحدث أبو الحسن علي بن عبيد الله بن نصر الزاغوني الحنبلي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1676 - (@)(@@) والمقرىء أبو بكر محمد بن الحسين بن علي الحمامي المزرقي(@)(@@)(@@)(@@) | 1677 - (@)(@@) والعلامة أبو علي الحسن بن علي الفارقي بواسط عن خمس وتسعين سنة(@)(@@)(@@)(@@) | 1678 - (@)(@@) وأبو القاسم هبة الله بن عبد الله بن احمد الشروطي الواسطي(@)(@@)(@@)(@@) | 1679 - (@)(@@) والحافظ أبو الحسن بن عبد الغفار بن إسماعيل بن أبي الحسين عبد الغافر بن محمد بن عبد الغافر الفارسي ثم النيسابوري(@)(@@)(@@)(@@) | 1680 - (@)(@@) والمسند أبو الحسن علي بن أحمد بن منصور بن قيس الغساني الدمشقي المالكي النحوي(@)(@@)(@@)(@@) | 1681 - (@)(@@) ومسند أصبهان أبو بكر محمد بن علي بن أبي ذرالصالحاني(@)(@@)(@@)(@@) | 1682 - (@)(@@) ومسند نيسابور الفقيه أبو عبد الله محمد بن الفضل بن احمد الصاعدي الفراوي(@)(@@) PageV00P000(@)(@@) (20)(@)(@@)(@@)(@@) | طبقة من الثلاثين إلى ما 
ms46	 بعد الخمسين وخمسمائة(@)(@@)(@@)(@@) | 1683 - (@)(@@) أبو محمد هبة الله بن سهل السيدي النيسابوري(@)(@@)(@@)(@@) | 1684 - (@)(@@) وأبو محمد اسماعيل بن عبد الرحمن بن أبي بكر النيسابوري القارىء سمع الصحيح من عبد الغافر الفارسي قاله ابن نقطة(@)(@@)(@@)(@@) | 1685 - (@)(@@) وأبو القاسم تميم بن أبي سعيد بن أبي العباس الجرجاني بهراة(@)(@@)(@@)(@@) | 1686 - (@)(@@) والمسندأبو محمد طاهر بن سهل بن بشر الاسفرائيني ثم الدمشقي الصائغ(@)(@@)(@@)(@@) | 1687 - (@)(@@) والحافظ أبو جعفر محمد بن أبي علي الحسن بن محمد الهمذاني(@)(@@)(@@)(@@) | 1688 - (@)(@@) والمسند أبو القاسم هبة الله بن احمد بن عمر بن الحريري ببغداد(@)(@@)(@@)(@@) | 1689 - (@)(@@) وأبو عبد الله يحيى بن الحسن بن احمد بن البناء(@)(@@)(@@)(@@) | 1690 - (@)(@@) والحافظ أبو نصر احمد بن عمر بن محمد الغازي الأصبهاني رحل إلى أبي الحسين بن النقور(@)(@@)(@@)(@@) | 1691 - (@)(@@) والفقيه أبو سعد إسماعيل بن أبي صالح أحمد بن عبد الملك والمؤذن النيسابوري(@)(@@)(@@)(@@) | 1692 - (@)(@@) ومسند أصبهان أبو عبد الله الحسين بن عبد الملك النحوي الخلال(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1693 - (@)(@@) وأبو نصيره أبو الفرج سعيد بن أبي الرجاء محمد بن بكر الأصبهاني الصيرفي السمسار(@)(@@)(@@)(@@) | 1694 - (@)(@@) وأبو المظفر عبد المنعم بن الشيخ أبي القاسم عبد الكريم بن هوازن القشيري(@)(@@)(@@)(@@) | 1695 - (@)(@@) والمعمرة فاطمة بنت علي بن المظفر بن زعبل النيسابورية المقرئة(@)(@@)(@@)(@@) | 1696 - (@)(@@) وأبو القاسم زاهر بن طاهر بن محمد النيسابوري الشحامي المستملي(@)(@@)(@@)(@@) | 1697 - (@)(@@) وكما الإسلام مفتي دمشق أبو الحسن علي بن المسلم بن الفتح السلمي(@)(@@)(@@)(@@) | 1698 - (@)(@@) وقاضي دمشق أبو الفضل يحيى بن علي القرشي(@)(@@)(@@)(@@) | 1699 - (@)(@@) والحافظ أبو القاسم إسماعيل بن محمد بن الفضل التيمي الأصبهاني(@)(@@)(@@)(@@) | 1700 - (@)(@@) والحافظ أبو الحسن رزين بن معاوية العبدري بمكة(@)(@@)(@@)(@@) | 1701 - (@)(@@) والمسند أبو منصور عبد الرحمن بن محمد الشيباني ابن زريق(@)(@@)(@@)(@@) | 1702 - (@)(@@) ومسند العصر أبوبكر محمد بن عبد الباقي بن محمد الأنصاري قاضي المارستان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1703 - (@)(@@) والقدوة العارف يوسف بن أيوب الهمذاني بمرو(@)(@@)(@@)(@@) | 1704 - (@)(@@) والمسند أبو سعد احمد بن محمد الزوزني(@)(@@)(@@)(@@) | 1705 - (@)(@@) والمحدث أبو القاسم إسماعيل بن أحمد ابن السمرقندي الكتبي(@)(@@)(@@)(@@) | 1706 - (@)(@@) والحافظ عبد الوهاب بن المبارك بن أحمد الأنماطي(@)(@@)(@@)(@@) | 1707 - (@)(@@) وأبو محمد عبد الجبار بن محمد بن احمد الخواري البيهقي الفقيه 
ms47	(@)(@@)(@@)(@@) | 1708 - (@)(@@) والإمام المحدث أبو عبد الله محمد بن علي بن عمر التميمي المازري المالكي(@)(@@)(@@)(@@) | 1709 - (@)(@@) وأبو الكرم نصر الله بن محمد بن محمد بن الجلخت الأزدي الواسطي(@)(@@)(@@)(@@) | 1710 - (@)(@@) وإمام جامع دمشق أبو محمد هبة الله بن احمد بن طاووس المقرىء(@)(@@)(@@)(@@) | 1711 - (@)(@@) وأبو محمد يحيى بن علي بن محمد بن الكاتب(@)(@@)(@@)(@@) | 1712 - (@)(@@) وأبو الفتح مفلح بن احمد بن محمد الرومي ثم البغدادي(@)(@@)(@@)(@@) | 1713 - (@)(@@) وأبو الوفاء غانم بن احمد بن الحسن الجلودي الأصبهاني(@)(@@)(@@)(@@) | 1714 - (@)(@@) وأبو القاسم غانم بن خالد بن عبد الواحد الأصبهاني التاجر صاحب عبد الرزاق ابن شمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1715 - (@)(@@) والعلامة أبو القاسم محمود بن عمر الزمخشري الخوارزمي المعتزلي(@)(@@)(@@)(@@) | 1716 - (@)(@@) وأبو البدر إبراهيم بن محمد بن منصور الكرخي(@)(@@)(@@)(@@) | 1717 - (@)(@@) ومدرس النظامية أبو منصور سعيد بن محمد بن عمر الرزاز(@)(@@)(@@)(@@) | 1718 - (@)(@@) ومسند الأندلس أبو الحسن شريح بن محمد بن شريح الرعيني الأشبلي الخطيب(@)(@@)(@@)(@@) | 1719 - (@)(@@) وأبو الحسن علي بن هبة الله بن عبد السلام الكاتب(@)(@@)(@@)(@@) | 1720 - (@)(@@) والإمام أبو البركات عمر بن إبراهيم بن محمد بن الحسيني الزيدي الكوفي الشيعي القدري(@)(@@)(@@)(@@) | 1721 - (@)(@@) والواعظة أم البهاء فاطمة بنت محمد بن أبي سعد أحمد بن الحسن البغدادية ثم الأصبهانية(@)(@@)(@@)(@@) | 1722 - (@)(@@) وأبو المعالي محمد بن إسماعيل بن محمد الفارسي ثم النيسابوري راوي السنن الكبير(@)(@@)(@@)(@@) | 1723 - (@)(@@) وأبو منصور محمد بن عبد الملك بن الحسن بن خيرون المقرىء الدباس(@)(@@)(@@)(@@) | 1724 - (@)(@@) والحافظ أبو سعد أحمد بن محمد بن أبي سعيد احمد بن الحسن البغدادي ثم الأصبهاني ومن محفوظه صحيح مسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1725 - (@)(@@) وأبو بكر عبد الرحمن بن عبد الله بن عبد الرحمن البحيري(@)(@@)(@@)(@@) | 1726 - (@)(@@) وأبو منصور موهوب بن أحمد بن محمد الخضر الجواليقي صاحب اللغة(@)(@@)(@@)(@@) | 1727 - (@)(@@) وأبو الحسن سعد الخير بن محمد بن سهل الأنصاري البلنسي المحدث التاجر(@)(@@)(@@)(@@) | 1728 - (@)(@@) ومقرىء العراق أبو محمد عبد الله بن علي بن أحمد النحوي سبط الخياط(@)(@@)(@@)(@@) | 1729 - (@)(@@) وأبو بكر وجيه بن طاهر بن محمد النيسابوري الشحامي العدل(@)(@@)(@@)(@@) | 1730 - (@)(@@) والحافظ أبو جعفر احمد بن عبد الرحمن بن محمد البطروجي الأندلسي(@)(@@)(@@)(@@) | 1731 - (@)(@@) وأبو بكر احمد بن علي بن 
ms48	 عبد الواحد بن الأشقر الدلال ببغداد(@)(@@)(@@)(@@) | 1732 - (@)(@@) والعلامة أبو محمد عبد الحق بن غالب بن عبد الرحمن بن عطية المحاربي الغرناطي صاحب التفسير(@)(@@)(@@)(@@) | 1733 - (@)(@@) والمسند أبو القاسم علي ابن العلامة أبي نصر عبد السيد بن الصباغ آخر من روى السبعة لابن مجاهد عن الصريفيني(@)(@@)(@@)(@@) | 1734 - (@)(@@) والمحدث أبو حفص عمر بن ظفر بن احمد المغازلي ببغداد عن ثمانين سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1735 - (@)(@@) ومحمد بن احمد بن الحسن الطرائفي راوي صفة المنافق عن ابن المسلمة(@)(@@)(@@)(@@) | 1736 - (@)(@@) والقاضي أبو عبد الله محمد بن علي الطيب الجلابي الواسطي(@)(@@)(@@)(@@) | 1737 - (@)(@@) والفقيه أبو الفتح نصر الله بن محمد بن عبد القوي المصيصي بدمشق(@)(@@)(@@)(@@) | 1738 - (@)(@@) ومسند نيسابور التاجر أبو تمام بن أيي العز محمد بن المختار الهاشمي صاحب أبي جعفر ابن المسلمة(@)(@@)(@@)(@@) | 1739 - (@)(@@) والفقيه أبو إسحاق ابراهيم بن محمد بن نبهان الغنوي الرقي(@)(@@)(@@)(@@) | 1740 - (@)(@@) والحافظ أبو علي الحسن بن مسعود بن الوزير الدمشقي بمرو(@)(@@)(@@)(@@) | 1741 - (@)(@@) والقاضي أبو بكر محمد بن عبد الله بن محمد بن العربي الأندلسي الإشبيلي الحافظ(@)(@@)(@@)(@@) | 1742 - (@)(@@) وأبو الدر ياقوت الرومي حدث بدمشق عن ابن هزارمرد(@)(@@)(@@)(@@) | 1743 - (@)(@@) وأبو الصدر أبو المحاسن أسعد بن علي بن موفق الزيادي الهروي العابد عنده البخاري وعبد والدارمي عن الداودي(@)(@@)(@@)(@@) | 1744 - (@)(@@) والحافظ أبو الحسن علي بن سليمان المرادي القرطبي الشافعي بحلب كهلا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1745 - (@)(@@) والقاضي أبو الفضل عياض بن موسى بن عياض اليحصبي السبتي(@)(@@)(@@)(@@) | 1746 - (@)(@@) والحافظ أبو عبد الله الحسين بن إبراهيم الجوزقاني الهمذاني مصنف كتاب الأباطيل نحو الدولابي(@)(@@)(@@)(@@) | 1747 - (@)(@@) والحافظ أبو النصر عبد الرحمن بن عبد الجبار بن عثمان الفامي الهروي(@)(@@)(@@)(@@) | 1748 - (@)(@@) وخطيب نيسابور أبو الأسعد هبة الله بن عبد الواحد بن أبي القاسم القشيري(@)(@@)(@@)(@@) | 1749 - (@)(@@) والحافظ أبو الوليد يوسف بن عبد العزيز ابن فيرة اللخمي الأندلسي ابن الدباغ تلميذ ابن سكرة(@)(@@)(@@)(@@) | 1750 - (@)(@@) ومقرىء الأندلس أبو عبد الله محمد بن الحسن بن محمد بن سعيد الداني ابن غلام الفرس(@)(@@)(@@)(@@) | 1751 - (@)(@@) ومسند الوقت القاضي أبو الفضل محمد بن عمر بن يوسف الأرموي الشافعي ببغداد(@)(@@)(@@)(@@) | 1752 - (@)(@@) ومسند نيسابور أبو نصر محمد بن منصور 
ms49	 بن عبد الرحيم الأشناني الحرضي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1753 - (@)(@@) وزاهد الوقت أبوالعباس أحمد بن أبي غالب بن احمد الوراق ابن الطلاية(@)(@@)(@@)(@@) | 1754 - (@)(@@) والحافظ المفيد أبو الفرج عبد الخالق بن احمد اليوسفي ببغداد لقي أبا نصر الزينبي(@)(@@)(@@)(@@) | 1755 - (@)(@@) وأبو الفتح عبد الملك بن عبد الله بن أبي سهل الكروخي الهروي(@)(@@)(@@)(@@) | 1756 - (@)(@@) والحافظ أبو طاهر محمد بن أبي بكر محمد بن عبد الله السنجي الخطيب(@)(@@)(@@)(@@) | 1757 - (@)(@@) وشيخ الصوفيه أبو الفتح محمد بن عبد الرحمن بن محمد الكشميهني آخر من سمع صحيح البخاري من محمد بن أبي عمران(@)(@@)(@@)(@@) | 1758 - (@)(@@) وفقيه خراسان محيي الدين محمد بن يحيى بن أبي منصور النيسابوري تلميذ الغزالي(@)(@@)(@@)(@@) | 1759 - (@)(@@) وأبو القاسم نصر بن احمد بن مقاتل الدمشقي(@)(@@)(@@)(@@) | 1760 - (@)(@@) وأبو القاسم هبة الله بن الحسين بن أبي شريك البغدادي الحاسب(@)(@@)(@@)(@@) | 1761 - (@)(@@) وأبو الحسين بن أبي عبد الله المقدسي الزاهد رحمه الله بحلب(@)(@@)(@@)(@@) | 1762 - (@)(@@) والواعظ أبو محمد العباس بن محمد بن أبي منصور الطوسي العصاري عباسة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1763 - (@)(@@) وأبو البركات عبد الله بن محمد بن الفضل الصاعدي الفراوي(@)(@@)(@@)(@@) | 1764 - (@)(@@) وأبو منصور عبد الخالق بن زاهر بن طاهر الشحامي(@)(@@)(@@)(@@) | 1765 - (@)(@@) وأبو العشائر محمد بن الخليل بن فارس القيسي بدمشق(@)(@@)(@@)(@@) | 1766 - (@)(@@) والحافظ أبوالمعمر المبارك بن احمد بن عبد العزيز الأنصاري الأزجي(@)(@@)(@@)(@@) | 1767 - (@)(@@) ومسند همذان الشخص العزيز أبو المحاسن نصر بن المظفر البرمكي الهمذاني من ذرية محمد بن يحيى بن خالد بن برمك(@)(@@)(@@)(@@) | 1768 - (@)(@@) والمسند أبو القاسم سعيد بن أحمد بن الحسن بن البنا(@)(@@)(@@)(@@) | 1769 - (@)(@@) وأبو سعد سعيد بن الحسين الريوندي الجوهري النيسابوري لقي الفضل بن المحب(@)(@@)(@@)(@@) | 1770 - (@)(@@) وخطيب مشكان أبو الحسن علي بن محمد الروذراوري راوي تاريخ البخاري(@)(@@)(@@)(@@) | 1771 - (@)(@@) والحافظ اللغوي أبو الفضل محمد بن ناصر البغدادي(@)(@@)(@@)(@@) | 1772 - (@)(@@) ومقرىء الوقت أبو الكرم المبارك بن الحسن الشهرزوري البغدادي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1773 - (@)(@@) ومسند أصبهان أبو القاسم إسماعيل بن علي بن الحسين الحمامي عن مائة سنة(@)(@@)(@@)(@@) | 1774 - (@)(@@) ومسند دمشق أبو القاسم الحسين بن الحسن البن الأسدي(@)(@@)(@@)(@@) | 1775 - (@)(@@) والمحدث أبو الحسن علي بن احمد بن محموية اليزدي الشافعي ببغداد(@)(@@)(@@)(@@) | 1776 - (@)(@@) والمسند أبو عبد 
ms50	 الله محمد بن عبيد الله بن سلامة الكرخي الرطبي(@)(@@)(@@)(@@) | 1777 - (@)(@@) والشيخ أبو البيان نبا بن محمد بن محفوظ الشافعي الزاهد(@)(@@)(@@)(@@) | 1778 - (@)(@@) ومسند بخارى أبو عمرو عثمان بن علي بن محمد البيكندي(@)(@@)(@@)(@@) | 1779 - (@)(@@) ومسند بغداد أبو بكر محمد بن عبد الله بن نصر الزاغوني(@)(@@)(@@)(@@) | 1780 - (@)(@@) وأبو القاسم نصر بن علي العكبري الواعظ(@)(@@)(@@)(@@) | 1781 - (@)(@@) ومسند الوقت أبو الوقت عبد الأول بن عيسى بن شعيب السجزي الصدفي(@)(@@) PageV00P000(@)(@@) (21)(@)(@@)(@@)(@@) | طبقة فيها من نيف وخمسين وخمسمائة وإلى وفاة الحافظ السلفي(@)(@@)(@@)(@@) | 1782 - (@)(@@) أبو مسعود عبد الجليل بن محمد بن عبد الواحد الأصبهاني الحافظ ويعرف بكوتاه(@)(@@)(@@)(@@) | 1783 - (@)(@@) وأبو الحسن علي بن عساكر الدمشقي الخشاب(@)(@@)(@@)(@@) | 1784 - (@)(@@) والعلامة أبو حفص عمر بن احمد بن منصور النيسابوري الصفار(@)(@@)(@@)(@@) | 1785 - (@)(@@) والمسند أبو القاسم أحمد بن المبارك بن عبد الباقي بن قفرجل القطان(@)(@@)(@@)(@@) | 1786 - (@)(@@) والنقيب أبو جعفر احمد بن محمد بن عبد العزيز العباسي المكي(@)(@@)(@@)(@@) | 1787 - (@)(@@) والرئيس أبو يعلى حمزة بن أسد بن القلانسي التميمي الكاتب صاحب التاريخ(@)(@@)(@@)(@@) | 1788 - (@)(@@) وأبو يعلى حمزة بن علي بن هبة الله التغلبي ابن الحبوبي(@)(@@)(@@)(@@) | 1789 - (@)(@@) والمحدث أبو الفتوح محمد بن محمد بن علي الطائي الهمذاني صاحب الأربعين(@)(@@)(@@)(@@) | 1790 - (@)(@@) والخطيب أبو المظفر محمد بن احمد بن علي بن التريكي العباسي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1791 - (@)(@@) والواعظ الزاهد أبو عبد الله محمد بن يحيى بن علي اليمني الزبيدي ببغداد(@)(@@)(@@)(@@) | 1792 - (@)(@@) وأبو الفتح عبد الوهاب بن محمد بن الصابوني المالكي الخفاف المقرىء المحدث وله أربعون حديثا فيها عن النعالي وطبقته(@)(@@)(@@)(@@) | 1793 - (@)(@@) وأبو محمد محمد بن عبد الكريم بن المادح(@)(@@)(@@)(@@) | 1794 - (@)(@@) ومحدث الكوفة أبو العباس أحمد بن يحيى بن ناقة المسلي(@)(@@)(@@)(@@) | 1795 - (@)(@@) وراوي موطأ ابن بكير أبو يعلي حمزة بن احمد بن فارس بن كروس السلمي بدمشق(@)(@@)(@@)(@@) | 1796 - (@)(@@) والقدوة الشيخ عدي بن مسافر الهكاري(@)(@@)(@@)(@@) | 1797 - (@)(@@) وابو المظفر هبة الله بن احمد بن الشبلي الصفار خاتمة أصحاب الزينبي(@)(@@)(@@)(@@) | 1798 - (@)(@@) وأبو سعد عبد الوهاب بن الحسن الكرماني خاتمة أصحاب أبي بكر ابن خلف(@)(@@)(@@)(@@) | 1799 - (@)(@@) والمعمر أبو الخير محمد بن احمد بن محمد بن عمر الأصبهاني الباغبان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1800 
ms51	 - (@)(@@) والإمام القدوة أبو العباس احمد بن عبد الله بن هشام بن الحطيئة اللخمي المقرىء(@)(@@)(@@)(@@) | 1801 - (@)(@@) وأبو الندى حسان بن إبراهيم الدمشقي الزيات(@)(@@)(@@)(@@) | 1802 - (@)(@@) وأبو المظفر سعيد بن سهل الفلكي الوزير(@)(@@)(@@)(@@) | 1803 - (@)(@@) وأبو عبد الله محمد بن عبد الله بن العباس الحراني ببغداد(@)(@@)(@@)(@@) | 1804 - (@)(@@) والشريف أبو طالب محمد بن محمد بن أبي زيد العلوي البصري النقيب آخرمن بقي من أصحاب أبي علي التستري(@)(@@)(@@)(@@) | 1805 - (@)(@@) والوزير العالم عون الدين أبو المظفر يحيى بن محمد بن هبيرة الشيباني(@)(@@)(@@)(@@) | 1806 - (@)(@@) والزاهد الشيخ رسلان بن يعقوب الجعبري النشار(@)(@@)(@@)(@@) | 1807 - (@)(@@) وراوي الموطأ الفقيه أبو عبد الله محمد بن عبد الحق بن احمد الخزرجي القرطبي(@)(@@)(@@)(@@) | 1808 - (@)(@@) وشيخ أصبهان الإمام أبو عبد الله الحسن بن العباس الرستمي(@)(@@)(@@)(@@) | 1809 - (@)(@@) ومسند مصر أبو محمد عبد الله بن رفاعة بن غدير السعدي الفرضي صاحب الخلعي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1810 - (@)(@@) والقطب الشيخ الإمام عبد القادر بن أبي صالح عبد الله بن جنكي دوست الجيلي الحنبلي(@)(@@)(@@)(@@) | 1811 - (@)(@@) ومسند خراسان أبو محمد عبد الجليل بن أبي سعيد منصور بن إسماعيل الهروي(@)(@@)(@@)(@@) | 1812 - (@)(@@) والحافظ الكبير أبو سعد عبد الكريم بن محمد بن منصور السمعاني المروزي عن ست وخمسين سنة(@)(@@)(@@)(@@) | 1813 - (@)(@@) والإمام أبو شجاع عمر بن محمد أبو عبد الله البسطامي ثم البلخي(@)(@@)(@@)(@@) | 1814 - (@)(@@) والمسند أبو المعالي محمد بن محمد بن محمد بن اللحاس الحريمي(@)(@@)(@@)(@@) | 1815 - (@)(@@) والمسند أبو الفضل المبارك بن المبارك بن صدقة السمسار(@)(@@)(@@)(@@) | 1816 - (@)(@@) ومسند الدنيا أبو الفرج مسعود بن الحسن بن الرئيس القاسم بن الفضل الثقفي الأصبهاني(@)(@@)(@@)(@@) | 1817 - (@)(@@) ومسند بعداد أبو القاسم هبة الله بن الحسن بن هلال الدقاق(@)(@@)(@@)(@@) | 1818 - (@)(@@) وأبو المعالي احمد بن عبد الغني بن حنيفة الباجسرائي(@)(@@)(@@)(@@) | 1819 - (@)(@@) وأبو المناقب حيدرة بن أبي البركات عمر بن إبراهيم العلوي الزيدي الكوفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1820 - (@)(@@) وأبو محمد عبد الله بن علي بن عبد الله الطامذي الأصبهاني(@)(@@)(@@)(@@) | 1821 - (@)(@@) والقدوة أبو النجيب عبد القاهر بن عبد الله بن محمد بن عموية السهروردي(@)(@@)(@@)(@@) | 1822 - (@)(@@) والمسند أبو الحسن علي بن عبد الرحمن بن تاج القراء الطوسي ببغداد(@)(@@)(@@)(@@) | 1823 - (@)(@@) وأبو الحسن محمد بن 
ms52	 إسحاق بن محمد بن هلال بن الصابىء(@)(@@)(@@)(@@) | 1824 - (@)(@@) وشيخ القراء أبو الفتوح ناصر بن الحسن الحسيني الخطيب بمصر(@)(@@)(@@)(@@) | 1825 - (@)(@@) وحافظ الدين أبو الحسين هبة الله بن الحسين بن عساكر أخو الحافظ أبي القاسم(@)(@@)(@@)(@@) | 1826 - (@)(@@) والمحدث عبد الحق بن أسد الدمشقي الحنفي(@)(@@)(@@)(@@) | 1827 - (@)(@@) والفقيه أبو مروان عبد الرحمن بن محمد قزمان القرطبي صاحب ابن الطلاع(@)(@@)(@@)(@@) | 1828 - (@)(@@) ومقرىء العصر أبو الحسن علي بن محمد بن علي بن هذيل البلنسي(@)(@@)(@@)(@@) | 1829 - (@)(@@) ومسند بغداد أبو الفتح محمد بن عبد الباقي بن احمد بن سليمان ابن البطي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1830 - (@)(@@) والحافظ أبو احمد معمر بن عبد الواحد ابن الفاخر القرشي الأصبهاني(@)(@@)(@@)(@@) | 1831 - (@)(@@) وأبو بكر عبد الله بن محمد بن أبي الحسين احمد بن محمد ابن النقور البغدادي(@)(@@)(@@)(@@) | 1832 - (@)(@@) وأبو المكارم عبد الواحد بن محمد بن المسلم بن هلال الآزدي الدمشقي(@)(@@)(@@)(@@) | 1833 - (@)(@@) والمسند أبو القاسم محمود بن عبد الكريم الأصبهاني فورجه(@)(@@)(@@)(@@) | 1834 - (@)(@@) والمسند أبو زرعة طاهر بن محمد بن طاهر المقدسي ثم الهمذاني(@)(@@)(@@)(@@) | 1835 - (@)(@@) والحافظ أبو مسعود عبد الرحمن بن علي بن احمد الأصبهاني الحافي(@)(@@)(@@)(@@) | 1836 - (@)(@@) وأبو القاسم يحيى بن ثابت بن بندار البقال الوكيل(@)(@@)(@@)(@@) | 1837 - (@)(@@) وأبو علي احمد بن محمد بن احمد الرحبي العطار البواب(@)(@@)(@@)(@@) | 1838 - (@)(@@) والعلامة أبو محمد عبد الله بن احمد بن احمد بن احمد بن الخشاب النحوي(@)(@@)(@@)(@@) | 1839 - (@)(@@) وأبو محمد عبد الله بن منصور بن هبة الله بن الموصلي البغدادي(@)(@@)(@@)(@@) | 1840 - (@)(@@) والإمام أبو الحسن علي بن عبد الله بن خلف بن النعمة الأنصاري الأندلسي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1841 - (@)(@@) ومسند أصبهان أبو المطهر القاسم بن الفضل بن عبد الأحد الأصبهاني الصيدلاني سمع رزق الله التميمي(@)(@@)(@@)(@@) | 1842 - (@)(@@) وأبو المكارم المبارك بن محمد بن معمر البادرايي(@)(@@)(@@)(@@) | 1843 - (@)(@@) ومقرىء الموصل أبو بكر يحيى بن سعدون الأزدي القرطبي(@)(@@)(@@)(@@) | 1844 - (@)(@@) ومسند القراء ببغداد أبو الفضل احمد بن محمد بن شنيف الدارقزي عن ست وتسعين سنة(@)(@@)(@@)(@@) | 1845 - (@)(@@) ومسند وقته أبو جعفر محمد بن الحسن بن الحسين الصيدلاني بأصبهان سمع من رزق الله وله إجازة بيبي(@)(@@)(@@)(@@) | 1846 - (@)(@@) والنقيب أبو عبد الله أحمد بن علي بن 
ms53	 المعمر العلوي(@)(@@)(@@)(@@) | 1847 - (@)(@@) والحافظ الكبير أبو العلاء الحسن بن احمد بن الحسن الهمذاني العطار(@)(@@)(@@)(@@) | 1848 - (@)(@@) والحافظ أبو إسحاق إبراهيم بن يوسف بن قرقول الوهراني الجمري وجمرة من قرى بجاية(@)(@@)(@@)(@@) | 1849 - (@)(@@) وأبو محمد عبد الله بن احمد بن هبة الله بن النرسي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1850 - (@)(@@) ومسند المغرب أبو الحسن علي بن أحمد بن جبير الكناني القرطبي بفاس(@)(@@)(@@)(@@) | 1851 - (@)(@@) وفخر النساء خديجة بنت أحمد بن الحسن النهروانية(@)(@@)(@@)(@@) | 1852 - (@)(@@) والمسند أبو عبد الله محمد بن عبد الله بن محمد بن خليل القيسي الأندلسي خاتمة من روى صحيح مسلم عن أبي علي الغساني راويه عن ابن الطلاع(@)(@@)(@@)(@@) | 1853 - (@)(@@) ومسند أصبهان أبو القاسم رجاء بن حامد المعداني عبد سليمان الحافظ(@)(@@)(@@)(@@) | 1854 - (@)(@@) ورزق الله وأبو محمد عبد الرحمن بن احمد بن محمد بن عبد القاهر الطوسي الخطيب(@)(@@)(@@)(@@) | 1855 - (@)(@@) وأبو الفضل محمد بن سماق بن يوسف الهمذاني سمع من السلار الكرخي وعبدوس بن عبد الله(@)(@@)(@@)(@@) | 1856 - (@)(@@) وحافظ زمانه أبو القاسم علي بن الحسن بن هبة الله الدمشقي ابن عساكر(@)(@@)(@@)(@@) | 1857 - (@)(@@) ومسند الحرم أبو الحسن علي بن حميد بن عمار الاطرابلسي ثم المكي راوي الصحيح عن أبي ذر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1858 - (@)(@@) ومجد الدين أبو منصور محمد بن أسعد العطاري حفدة تلميذ البغوي(@)(@@)(@@)(@@) | 1859 - (@)(@@) وأبو حنيفة محمد بن عبيد الله بن علي الأصبهان الخطيبي(@)(@@)(@@)(@@) | 1860 - (@)(@@) وأبو محمد صالح بن المبارك بن الرخلة القزاز(@)(@@)(@@)(@@) | 1861 - (@)(@@) والمحدث أو محمد عبد الله بن عبد الرحمن الديباجي الاسكندراني(@)(@@)(@@)(@@) | 1862 - (@)(@@) ومقرىء العراق أبو الحسن علي بن عساكر بن المرحب البطائحي الضرير(@)(@@)(@@)(@@) | 1863 - (@)(@@) ومقرىء أصبهان ومسندها أبو بكر محمد بن احمد بن أبي الفرج بن ماشاذه البكري خاتمة أصحاب سليمان الحافظ(@)(@@)(@@)(@@) | 1864 - (@)(@@) وقاضي القضاة بدمشق جمال الدين أبو الفضل محمد بن عبد الله بن القاسم بن المظفر الشهرزوري عن ثمانين سنة(@)(@@)(@@)(@@) | 1865 - (@)(@@) والفقيه أبو عبد الله مسلم بن ثابت بن زيدان النحاس الوكيل(@)(@@)(@@)(@@) | 1866 - (@)(@@) ومسند خراسان شرف الدين أبو الفتح نصر بن سيار بن صاعد بن سيار الكتاني الهروي الحنفي خاتمة أصحاب أبي عامرالأزدي(@)(@@)(@@)(@@) | 1867 - (@)(@@) والزاهد محمد بن علي 
ms54	 المعمري وعاش سيعا وتسعين سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1868 - (@)(@@) وأبو شاكر يحيى بن يوسف السقلاطوني(@)(@@)(@@)(@@) | 1869 - (@)(@@) والكاتبة فخر النساء شهده بنت احمد بن الفرج الإبري(@)(@@)(@@)(@@) | 1870 - (@)(@@) ومسند أصبهان أبو رشيد عبد الله بن عمربن عبد الله الأصبهاني سمع الرئيس الثقفي(@)(@@)(@@)(@@) | 1871 - (@)(@@) وأبو الحسين عبد الحق بن عبد الخالق بن احمد بن عبد القادر اليوسفي(@)(@@)(@@)(@@) | 1872 - (@)(@@) والمعمرة تجني بنت عبد الله أم عتب بنت ابي المكارم بن وهبان خاتمة من سمع من طراد والنعالي(@)(@@)(@@)(@@) | 1873 - (@)(@@) والمحدث الزاهد أبو الحسن علي بن احمد بن محمد العلوي الزيدي ببغداد كهلا(@)(@@)(@@)(@@) | 1874 - (@)(@@) والمحدث القاضي أبو المحاسن عمر بن علي بن الخضر القرشي الدمشقي ببغداد(@)(@@)(@@)(@@) | 1875 - (@)(@@) والحافظ المقرىء الأستاذ أبو بكر محمد بن خير اللمتوني الإشبيلي في عشر الثمانين(@)(@@)(@@)(@@) | 1876 - (@)(@@) والحافظ أبو بكر محمد بن غالب الباقداري الضرير والد عجيبة كهلا(@)(@@)(@@)(@@) | 1877 - (@)(@@) وأبو المعالي عبد الله بن عبد الرحمن بن صابر الدمشقي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1878 - (@)(@@) وأبو الفهم عبد الرحمن بن عبد العزيز بن أبي العجائز الأزدي الدمشقي(@)(@@)(@@)(@@) | 1879 - (@)(@@) والحافظ الإمام شيخ الإسلام أبو طاهر احمد بن محمد السلفي الأصبهاني نزيل الإسكندرية عن مائة سنة وسنتين(@)(@@) PageV00P000(@)(@@) (22)(@)(@@)(@@)(@@) | طبقة تالية لما قبلها وإلى رأس الستمائة(@)(@@)(@@)(@@) | 1880 - (@)(@@) أبو المفاخر سعيد بن الحسين الهاشمي المأموني النيسابوري بمصر(@)(@@)(@@)(@@) | 1881 - (@)(@@) والعلامة أبو الحسن علي بن عبد الرحيم بن الحسين السلمي ابن العصار اللغوي(@)(@@)(@@)(@@) | 1882 - (@)(@@) وأبو العز محمد بن محمد بن مواهب الخراساني تغير بأخرة سمع المبارك ابن الطيوري وابن حشيش(@)(@@)(@@)(@@) | 1883 - (@)(@@) وشيخ العربية كمال الدين أبو البركات عبد الرحمن بن محمد ابن عبد الله الأنباري(@)(@@)(@@)(@@) | 1884 - (@)(@@) والقدوة الشيخ احمد بن علي بن يحيى الرفاعي بالبطائح(@)(@@)(@@)(@@) | 1885 - (@)(@@) وأبو طالب الخضر بن هبة الله بن احمد بن طاووس الدمشقي(@)(@@)(@@)(@@) | 1886 - (@)(@@) والحافظ الكبير أبن والقاسم مخلف بن عبد الملك بن مسعود ابن موسى بن بشكوال الأنصاري القرطبي(@)(@@)(@@)(@@) | 1887 - (@)(@@) وخطيب الموصل أبو الفضل عبد الله بن احمد بن عبد القاهر الطوسي مسند زمانه(@)(@@)(@@)(@@) | 1888 - (@)(@@) وأبو محمد عبد الله بن احمد بن محمد بن حمنيس بن السراج البغدادي سمع من ابن شويش 
ms55	 وابن حشيش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1889 - (@)(@@) والعلامة قطب الدين مسعود بن محمد بن مسعود النيسابوري الشافعي بدمشق(@)(@@)(@@)(@@) | 1890 - (@)(@@) ومسند أصبهان أبو الفتح عبد الله بن احمد بن أبي الفتح الخرقي سمع أبا مطيع وأبا الفتح السوذرجاني(@)(@@)(@@)(@@) | 1891 - (@)(@@) ومسند واسط أبو طالب محمد بن علي بن احمد الكتاني المحتسب(@)(@@)(@@)(@@) | 1892 - (@)(@@) والمحدث أبو عبد الله محمد بن حمزة بن محمد بن أبي الصقر الشروطي(@)(@@)(@@)(@@) | 1893 - (@)(@@) والمسند أبو الوفاء محمود بن أبي القاسم بن حكما الأصبهاني تفرد بإجازة طراد والنعالي(@)(@@)(@@)(@@) | 1894 - (@)(@@) والمسند أبو رشيد إسماعيل بن غانم بن خالد الأصبهاني سمع أبا الفتح السوذرجاني(@)(@@)(@@)(@@) | 1895 - (@)(@@) والمسند أبو سعيد عبد الجبار بن محمد بن علي بن أبي ذر الصالحاني من بقايا أصحاب الرئيس الثقفي(@)(@@)(@@)(@@) | 1896 - (@)(@@) وأبو المحاسن عبد الرزاق بن إسماعيل بن محمد بن القومساني صاحب الدوني وابن عمه المطهري عبد الكريم بن محمد بن عثمان القومساني الهمذاني(@)(@@)(@@)(@@) | 1897 - (@)(@@) وأبو الطاهر إسماعيل بن عوف الزهري الإسكندراني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1898 - (@)(@@) وزاهد حران الشيخ حياة بن قيس(@)(@@)(@@)(@@) | 1899 - (@)(@@) وحافظ المغرب أبو محمد عبد الحق بن أبي عبد الرحمن الأزدي(@)(@@)(@@)(@@) | 1900 - (@)(@@) والحافظ البارع أبوالقاسم عبد الرحمن بن عبد الله بن احمد السهيلي الخثعمي المآلقي الضرير ويكنى أبا زيد وأبا الحسن(@)(@@)(@@)(@@) | 1901 - (@)(@@) وعبد الرزاق بن الدمشقي النجار(@)(@@)(@@)(@@) | 1902 - (@)(@@) ومسند بغداد أبو الفتح عبيد الله بن عبد الله بن نجا ابن شاتيل الدباس(@)(@@)(@@)(@@) | 1903 - (@)(@@) وأبو المجد الفضل بن الحسين البانياسي بدمشق(@)(@@)(@@)(@@) | 1904 - (@)(@@) والمسند أبو السعادات نصرالله بن عبد الرحمن بن محمد الشيباني القزاز(@)(@@)(@@)(@@) | 1905 - (@)(@@) والمحدث أبو سعد محمد بن عبد الواحد الأصبهاني الصائغ(@)(@@)(@@)(@@) | 1906 - (@)(@@) والحافظ العلامة أبو موسى محمد بن عيسى المديني(@)(@@)(@@)(@@) | 1907 - (@)(@@) والعلامة أبو محمد عبد الله بن بري المصري النحوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1908 - (@)(@@) وراوي مسلم أبوعبد الله محمد بن علي بن صدقة الحراني(@)(@@)(@@)(@@) | 1909 - (@)(@@) والحافظ المحقق أبو بكر محمد بن موسى بن عثمان الحازمي(@)(@@)(@@)(@@) | 1910 - (@)(@@) والمسند يحيى بن محمود بن سعد الثقفي الأصبهاني(@)(@@)(@@)(@@) | 1911 - (@)(@@) وأبو الحسين احمد بن حمزة بن الموازيني الدمشقي(@)(@@)(@@)(@@) | 1912 - (@)(@@) ومسند أصبهان أبو العباس احمد بن احمد بن محمد بن ينال 
ms56	 الصوفي الترك سمع أبا مطيع(@)(@@)(@@)(@@) | 1913 - (@)(@@) والعلامة أبو سعد عبد الله بن محمد بن أبي عصرون التميمي(@)(@@)(@@)(@@) | 1914 - (@)(@@) والحافظ يوسف بن احمد الشيرازي مؤلف الأربعين البلدانية(@)(@@)(@@)(@@) | 1915 - (@)(@@) والحافظ أبو المواهب الحسن بن هبة الله بن محفوظ بن صصري التغلبي كهلا(@)(@@)(@@)(@@) | 1916 - (@)(@@) وأبو عبد الله محمد بن سعيد بن أحمد بن رزقون الأنصاري الإشبيلي عن أربع وثمانين سنة(@)(@@)(@@)(@@) | 1917 - (@)(@@) والحافظ أبو بكر محمد بن عبد الله بن الجد الفهري الإشبيلي عن سبعين سنة(@)(@@)(@@)(@@) | 1918 - (@)(@@) وعبد الرحمن بن علي اللخمي الخرقي الدمشقي الشافعي(@)(@@)(@@)(@@) | 1919 - (@)(@@) وعبد المنعم بن عبد الله بن محمد بن الفضل الصاعدي الفراوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1920 - (@)(@@) وإسماعيل بن علي الجنزوي الشروطي بدمشق(@)(@@)(@@)(@@) | 1921 - (@)(@@) وأبو الحرم رجب بن مذكور الأكاف(@)(@@)(@@)(@@) | 1922 - (@)(@@) وأبو منصور عبد الله بن محمد بن علي بن هبة الله بن عبد السلام الكاتب(@)(@@)(@@)(@@) | 1923 - (@)(@@) والواعظ أبو الخير احمد بن إسماعيل القزويني(@)(@@)(@@)(@@) | 1924 - (@)(@@) شيخ القراء أبو القاسم بن فيرة بن احمد بن خلف الرعيني الشاطبي الضرير بمصر(@)(@@)(@@)(@@) | 1925 - (@)(@@) وذاكر بن كامل الخفاف ببغداد(@)(@@)(@@)(@@) | 1926 - (@)(@@) ومحدث سبتة أبو محمد عبد الله بن محمد بن عبيد الله الحجري(@)(@@)(@@)(@@) | 1927 - (@)(@@) والمحدث احمد بن طارق بن سنان الكركي(@)(@@)(@@)(@@) | 1928 - (@)(@@) والمسند ناصر بن محمد بن أبي الفتح الويرج(@)(@@)(@@)(@@) | 1929 - (@)(@@) وأبو القاسم يحيى بن أسعد بن بوش مسند بغداد(@)(@@)(@@)(@@) | 1930 - (@)(@@) وشيخ القراء أبو بكر عبد الله بن منصور الباقلاني الواسطي(@)(@@)(@@)(@@) | 1931 - (@)(@@) وأبو الفضائل عبد الرحيم بن محمد بن عبد الواحد الأصبهاني الكاغدي الخطيب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1932 - (@)(@@) وأبو جعفر محمد بن إسماعيل بن محمد الطرسوسي(@)(@@)(@@)(@@) | 1933 - (@)(@@) وأبو الحسن مسعود بن أبي منصور الجمال الخياط(@)(@@)(@@)(@@) | 1934 - (@)(@@) ومنصور بن أبي الحسن الطبري أبو الفضل(@)(@@)(@@)(@@) | 1935 - (@)(@@) وأبو سعيد خليل بن بدر بن ثابت الراراني الأصبهاني(@)(@@)(@@)(@@) | 1936 - (@)(@@) والعدل أبو المكارم احمد بن محمد بن محمد اللبان(@)(@@)(@@)(@@) | 1937 - (@)(@@) وإسماعيل بن صالح بن ياسين المصري(@)(@@)(@@)(@@) | 1938 - (@)(@@) وأبو القاسم هبة الله بن علي بن مسعود الأنصاري البوصيري الكاتب(@)(@@)(@@)(@@) | 1939 - (@)(@@) والقاضي الفاضل عبد الرحيم بن علي البيساني كاتب السر(@)(@@)(@@)(@@) | 1940 - (@)(@@) ومسند العالم عبد المنعم بن عبد الوهاب بن 
ms57	 صدقة بن كليب البغدادي عن ست وتسعين سنة(@)(@@)(@@)(@@) | 1941 - (@)(@@) والعلامة أبو الفرج عبد الرحمن بن علي بن محمد بن علي البكري ابن الجوزي الحافظ(@)(@@)(@@)(@@) | 1942 - (@)(@@) وعمر بن علي بن عمر البنا الواعظ(@)(@@)(@@)(@@) | 1943 - (@)(@@) وعمر بن علي بن بقاء النموذج(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1944 - (@)(@@) وعلي بن المبارك بن أبي العز محمد بن جابر العدل(@)(@@)(@@)(@@) | 1945 - (@)(@@) وأحمد بن محمد بن احمد بن البخيل الدارقزي(@)(@@)(@@)(@@) | 1946 - (@)(@@) والمبارك بن المبارك بن هبة الله بن المعطوش(@)(@@)(@@)(@@) | 1947 - (@)(@@) وإسماعيل بن فضائل الحربي(@)(@@)(@@)(@@) | 1948 - (@)(@@) وأبو محمد الحسن بن محمد بن العلي العجمي(@)(@@)(@@)(@@) | 1949 - (@)(@@) وأبو القاسم دلف بن احمد بن محمد بن قوفا(@)(@@)(@@)(@@) | 1950 - (@)(@@) وأبو محمد عبد الله بن عبد الرحمن بن أيوب(@)(@@)(@@)(@@) | 1951 - (@)(@@) وعبد الله بن نصر بن مزروع بن الملاحي(@)(@@)(@@)(@@) | 1952 - (@)(@@) عبد الخالق بن هبة الله بن الحسن البندار(@)(@@)(@@)(@@) | 1953 - (@)(@@) وأبو الفرج عبد الرحمن بن أبي ياسر محمد بن هبة الله بن ملاح الشط(@)(@@)(@@)(@@) | 1954 - (@)(@@) وأبو عمرو عثمان بن حسين بن حكيم(@)(@@)(@@)(@@) | 1955 - (@)(@@) وأبو حفص عمر بن علي بن عبد السيد الصفار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1956 - (@)(@@) وابو القاسم عمر بن محمد بن الحسان القطان جريرة(@)(@@)(@@)(@@) | 1957 - (@)(@@) وأبو نصر غياث بن الحسن بن سعيد بن احمد بن الإمام أبي علي ابن البناء الحنبلي(@)(@@)(@@)(@@) | 1958 - (@)(@@) وهؤلاء العشرون سمعوا من ابن الحصين وأخذ عنهم الحافظ ابن خليل(@)(@@)(@@)(@@) | 1959 - (@)(@@) وعبد الله بن أبي المجد الإسكاف راوي المسند(@)(@@)(@@)(@@) | 1960 - (@)(@@) وخطيب دمشق ضياء الدين بن عبد الملك بن زيد بن ياسين الدولعي(@)(@@)(@@)(@@) | 1961 - (@)(@@) ومسند الثغر أبو محمد عبد الرحمن بن موقى(@)(@@)(@@)(@@) | 1962 - (@)(@@) والواعظ أبو الحسن علي بن ابراهيم بن نجا الواعظ(@)(@@)(@@)(@@) | 1963 - (@)(@@) وزوجته فاطمة بنت سعد الخير(@)(@@)(@@)(@@) | 1964 - (@)(@@) والمبارك بن المبارك بن المعطوش(@)(@@)(@@)(@@) | 1965 - (@)(@@) والإمام أبو سعد عبد الله بن عمر بن احمد بن الصقار النيسابوري(@)(@@)(@@)(@@) | 1966 - (@)(@@) والمحدث بهاء الدين بن القاسم بن علي بن الحسن بن عساكر الدمشقي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1967 - (@)(@@) والمسند أبو عبد الله محمد بن أبي زيد بن حمد الكراني الأصبهاني(@)(@@)(@@)(@@) | 1968 - (@)(@@) وأبو نعيم احمد بن أبي الفضل محمد بن احمد الكراني صاحب أبي طاهر الدشتج(@)(@@)(@@)(@@) | 1969 
ms58	 - (@)(@@) وأبو الفتح أسعد بن محمود بن خلف العجلي مفتي الشافعية بأصبهان وله خمس وثمانون سنة(@)(@@)(@@)(@@) | 1970 - (@)(@@) ومسند الشام أبو طاهر بركات بن إبراهيم بن طاهر الخشوعي الدمشقي(@)(@@)(@@)(@@) | 1971 - (@)(@@) والمحدث أبو جعفر احمد بن علي بن عتيق القرطبي بدمشق(@)(@@) PageV00P000(@)(@@) (23)(@)(@@)(@@)(@@) | طبقة من الستمائة إلى قريب الخمس وعشرين وستمائة(@)(@@)(@@)(@@) | 1972 - (@)(@@) أبو جعفر محمد بن احمد بن نصر الصيدلاني سلفة(@)(@@)(@@)(@@) | 1973 - (@)(@@) ومحمد بن معمر بن عبد الواحد الفاخر(@)(@@)(@@)(@@) | 1974 - (@)(@@) وحنبل بن عبد الله بن الفرج بن سعادة أبو علي المكبر(@)(@@)(@@)(@@) | 1975 - (@)(@@) وأبو المفضل محمد بن الحسين بن الخطيب الدمشقي(@)(@@)(@@)(@@) | 1976 - (@)(@@) والحافظ الكبير تقي الدين أبو محمد عبد الغني بن عبد الواحد بن علي بن سرور المقدسي بمصر(@)(@@)(@@)(@@) | 1977 - (@)(@@) وأبو عبد الله محمد بن حمد الأرتاحي المصري(@)(@@)(@@)(@@) | 1978 - (@)(@@) وأبو علي ضياء بن احمد بن الخريف(@)(@@)(@@)(@@) | 1979 - (@)(@@) وحمزة بن علي بن فارس أبو يعلى بن القبيطي(@)(@@)(@@)(@@) | 1980 - (@)(@@) وأخوه محمد بن علي(@)(@@)(@@)(@@) | 1981 - (@)(@@) وأبو نصر عبد الرزاق بن الشيخ عبد القادر بن أبي صالح الحنبلي(@)(@@)(@@)(@@) | 1982 - (@)(@@) والقاضي أبو الفتح محمد بن احمد بختيار المندائي الواسطي(@)(@@)(@@)(@@) | 1983 - (@)(@@) وشيخ القراء أبو الجود غياث بن فارس اللخمي المقرىء الضرير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1984 - (@)(@@) وعفيفة بنت أحمد بن عبد الله أم هانىء الفارقانية ولها ست وسبعون سنة(@)(@@)(@@)(@@) | 1985 - (@)(@@) وشيخ القراءات أبو احمد عبد الوهاب بن علي بن علي بن سكينة(@)(@@)(@@)(@@) | 1986 - (@)(@@) والمسند الرحلة أبو حفص عمر بن محمد بن طبرزد الدارقزي(@)(@@)(@@)(@@) | 1987 - (@)(@@) وأبوالمجد زاهر بن احمد بن احمد بن أبي غانم الثقفي(@)(@@)(@@)(@@) | 1988 - (@)(@@) والشيخ فخر الدين محمد بن عمر الرازي صاحب التصانيف العقلية(@)(@@)(@@)(@@) | 1989 - (@)(@@) والقدوة الإمام أبو عمر محمد بن احمد بن محمد بن قدامة المقدسي(@)(@@)(@@)(@@) | 1990 - (@)(@@) والحافظ مجد الدين أبو السعادات المبارك بن محمد بن محمد ابن الأثير الجزري(@)(@@)(@@)(@@) | 1991 - (@)(@@) ومسند نيسابور أبو الفتح منصور بن عبد المنعم بن عبد الله ابن الفراوي(@)(@@)(@@)(@@) | 1992 - (@)(@@) والحافظ أبو نزار ربيعة بن الحسن اليمني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1993 - (@)(@@) وعين الشمس بنت احمد بن ابي الفرج الثقفية آخر اصحاب أبي ذر الصالحاني(@)(@@)(@@)(@@) | 1994 - (@)(@@) والمسند عبد الجليل بن مندويه الأصبهاني(@)(@@)(@@)(@@) | 1995 
ms59	 - (@)(@@) والحافظ أبو محمد عبد العزيز بن محمود بن المبارك بن الأخضر(@)(@@)(@@)(@@) | 1996 - (@)(@@) وعبد العزيز بن معالي بن غنيمة بن منينا الناصري(@)(@@)(@@)(@@) | 1997 - (@)(@@) والحافظ عبد القادر بن عبد الله الرهاوي الحنبلي(@)(@@)(@@)(@@) | 1998 - (@)(@@) والحافظ أبو الحسن علي بن المفضل المقدسي المالكي(@)(@@)(@@)(@@) | 1999 - (@)(@@) وسليمان بن محمد الموصلي(@)(@@)(@@)(@@) | 2000 - (@)(@@) وأبو عبد الله محمد بن عبد الله بن موهوب بن البناء الصوفي(@)(@@)(@@)(@@) | 2001 - (@)(@@) والعلامة أبو اليمن زيد بن الحسن بن زيد الكندي مسند الشام(@)(@@)(@@)(@@) | 2002 - (@)(@@) والقاضي أبو القاسم عبد الصمد بن محمد بن ابي الفضل ابن الحرستاني الشافعي(@)(@@)(@@)(@@) | 2003 - (@)(@@) والحافظ عز الدين محمد بن الحافظ أبي محمد عبد الغني المقدسي(@)(@@)(@@)(@@) | 2004 - (@)(@@) وأبو الفتوح محمد بن محمد بن محمد بن عمروك البكري الصوفي النيسابوري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2005 - (@)(@@) والمسندة أم المؤيد زينب بنت عبد الرحمن بن الحسن الشعرية بنيسابور(@)(@@)(@@)(@@) | 2006 - (@)(@@) وأبو الحسن المؤيد بن محمد بن علي الطوسي راوي صحيح مسلم(@)(@@)(@@)(@@) | 2007 - (@)(@@) ومسند هراة أبو روح عبد المعز بن محمد بن أبي الفضل الهروي البراد الصوفي عن ست وتسعين سنة(@)(@@)(@@)(@@) | 2008 - (@)(@@) وأبو البركات داود بن احمد بن محمد بن ملاعب البغدادي الوكيل(@)(@@)(@@)(@@) | 2009 - (@)(@@) وأبو منصور سعيد بن محمد بن سعيد الرزاز(@)(@@)(@@)(@@) | 2010 - (@)(@@) والشمس احمد بن عبد الله بن عبد الصمد السلمي العطار(@)(@@)(@@)(@@) | 2011 - (@)(@@) وشيخ العربية أبو البقاء عبد الله بن الحسين العكبري الضرير(@)(@@)(@@)(@@) | 2012 - (@)(@@) والافتخار عبد المطلب بن الفضل بن عبد المطلب الهاشمي الحلبي الحنفي(@)(@@)(@@)(@@) | 2013 - (@)(@@) وأبو العباس احمد بن محمد بن سيدهم الأنصاري بدمشق(@)(@@)(@@)(@@) | 2014 - (@)(@@) وأبو يعلى حمزة بن السيد الصفار(@)(@@)(@@)(@@) | 2015 - (@)(@@) وأخوه المعمر أبو المحاسن بن أبي لقمة بالمزة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2016 - (@)(@@) وأبو بكر القاسم بن عبد الله بن عمر بن احمد النيسابوري الصفار(@)(@@)(@@)(@@) | 2017 - (@)(@@) وأبو المظفر عبد الرحيم بن الحافظ أبي سعد عبد الكريم بن محمد ابن السمعاني المروزي الشافعي(@)(@@)(@@)(@@) | 2018 - (@)(@@) وهبة الله بن الخضر بن هبة الله بن احمد بن طاووس الدمشقي(@)(@@)(@@)(@@) | 2019 - (@)(@@) وأبو نصر موسى بن الشيخ عبد القادر الجيلي بدمشق(@)(@@)(@@)(@@) | 2020 - (@)(@@) وثابت بن مشرف بن أبي سعيد الخباز(@)(@@)(@@)(@@) | 2021 - (@)(@@) والحافظ أبو الفتوح نصر بن أبي 
ms60	 الفرج بن علي الحصري(@)(@@)(@@)(@@) | 2022 - (@)(@@) والشهاب محمد بن خلف بن راجح المقدسي(@)(@@)(@@)(@@) | 2023 - (@)(@@) والإمام موفق الدين عبد الله بن احمد بن محمد بن قدامة صاحب التصانيف(@)(@@)(@@)(@@) | 2024 - (@)(@@) ومسمار بن عمر بن محمد بن العويس النيار أبو بكر المقرىء(@)(@@)(@@)(@@) | 2025 - (@)(@@) وشيخ الشافعية فخر الدين أبو منصور عبد الرحمن بن محمد بن الحسن بن عساكر(@)(@@)(@@)(@@) | 2026 - (@)(@@) وإخوته تاج الأمناء أبو الفضل وزين الأمناء أبو البركات الحسن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2027 - (@)(@@) وأبو نصر عبد الرحيم(@)(@@)(@@)(@@) | 2028 - (@)(@@) والشيخ أبو جعفر محمد بن هبة الله بن المكرم(@)(@@)(@@)(@@) | 2029 - (@)(@@) وأبو البركات عبد القوي بن عبد العزيز بن الحباب السعدي المصري(@)(@@)(@@)(@@) | 2030 - (@)(@@) وأبو العباس احمد بن أبي الفتح يوسف بن صرما الدقاق(@)(@@)(@@)(@@) | 2031 - (@)(@@) ورحلة الوقت أبو الفرج الفتح بن عبد الله بن محمد بن عبد السلام الكاتب(@)(@@)(@@)(@@) | 2032 - (@)(@@) والإمام الخطيب فخر الدين محمد بن أبي القاسم بن تميمية الحراني(@)(@@)(@@)(@@) | 2033 - (@)(@@) وعبد المحسن بن الخطيب عبد الله بن احمد بن محمد الطوسي(@)(@@)(@@)(@@) | 2034 - (@)(@@) ومجد الدين محمد بن الحسين القزويني راوي معالم التنزيل(@)(@@)(@@)(@@) | 2035 - (@)(@@) والمعمر داود بن معمر بن عبد الواحد بن الفاخر الأصبهاني(@)(@@)(@@)(@@) | 2036 - (@)(@@) والحافظ أبو الطاهر إسماعيل بن عبد الله بن الأنماطي المصري بدمشق كهلا(@)(@@)(@@)(@@) | 2037 - (@)(@@) والمحدث أبو طالب عبد الرحمن بن محمد بن عبد السميع الهاشمي الواسطي عن ثلاث وثمانين سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2038 - (@)(@@) وعبد البر بن الحافظ أبي العلاء الحسن بن احمد العطار(@)(@@)(@@)(@@) | 2039 - (@)(@@) وقاضي الجماعة أبو القاسم احمد بن يزيد القرطبي ابن بقي(@)(@@)(@@)(@@) | 2040 - (@)(@@) والأستاذ أبو محمد عبد الرحمن بن عبد الله بن علوان الأسدي الحلبي المحدث(@)(@@)(@@)(@@) | 2041 - (@)(@@) والمسند علي بن النفيس بن بوريدان الحاجب(@)(@@)(@@)(@@) | 2042 - (@)(@@) ومحدث الموصل أبو إسحاق بن المظفر بن البرني الواعظ الحنبلي(@)(@@)(@@)(@@) | 2043 - (@)(@@) وأبو الحسن علي بن أبي الكرم نصر بن المبارك المكي ابن البناء(@)(@@) PageV00P000(@)(@@) (24)(@)(@@)(@@)(@@) | طبقة من هنا وإلى رأس الخمسين وستمائة رحمهم الله(@)(@@)(@@)(@@) | 2044 - (@)(@@) أبو محمد بن علي بن الحسين بن الحسن الأسدي نفيس الدين ابن البن(@)(@@)(@@)(@@) | 2045 - (@)(@@) وأبو القاسم الحسن بن هبة الله بن صصري التغلبي(@)(@@)(@@)(@@) | 2046 - (@)(@@) وزين الأمناء المذكور(@)(@@)(@@)(@@) | 2047 - (@)(@@) والإمام شمس 