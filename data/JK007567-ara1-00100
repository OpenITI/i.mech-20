ms81	(@)(@@) % ابثكم إني على النأي حافظ % % ذمام الهوى لو تحفظون ذماميا % % 14(@)(@@) % أناشدكم والحر أوفى بعهده % % ولن يعدم الإحسان والخير جازيا % % 15(@)(@@) % هل الود إلا ما تحاماه كاشح % % وأخفق في مسعاه من جاء واشيا % % 16(@)(@@) % تأوبني والليل يذكي عيونه % % ويسحب من ذيل الدجنة ضافيا % % 17(@)(@@) % وقد مثلت زهر النجوم بأفقه % % حبابا على نهر المجرة طافيا % % 18(@)(@@) % خيال على بعد المزار ألم بي % % فأذكرني من لم أكن عنه ساليا % % 19(@)(@@) % عجبت له كيف اهتدى نحو مضجعي % % ولم يبق مني السقم والشوق باقيا % % 20(@)(@@) % رفعت له نار الصبابة فاهتدى % % وخاض لها عرض الدجنة ساريا % % PageV01P284 21(@)(@@) % ومما أجد الوجد سرب على النقا % % سوانح يصقلن الطلى والتراقيا % % 22(@)(@@) % نزعن عن الألحاظ كل مسدد % % فغادرن أفلاذ القلوب دواميا % % 23(@)(@@) % ولما تراءى السرب قلت لصاحبي % % وأيقنت أن الحب ما عشت دائيا % % 24(@)(@@) % حذارك من سقم الجفون فإنه % % سيعدي بما يعيي الطبيب المداويا % % 25(@)(@@) % وإن أمير المسلمين محمدا % % ليعدي نداه الساريات الهواميا % % 26(@)(@@) % تضيء النجوم الزاهرات خلاله % % وينفث في روع الزمان المعاليا % % 27(@)(@@) % معال إذا ما النجم صوب طالبا % % مبالغها في العز حلق وانيا % % 28(@)(@@) % يسابق علوي الرياح إلى الندى % % ويفضح جدوى راحتيه الغواديا % % 29(@)(@@) % ويغضي عن العوراء إغضاء قادر % % ويرجح في الحلم الجبال الرواسيا % % 30(@)(@@) % همام يروع الأسد في حومة الوغى % % كما راعت الأسد الظباء الجوازيا % % PageV01P285 31(@)(@@) % مناقب تسمو للفخار كأنما % % تجاري إلى المجد النجوم الجواريا % % 32(@)(@@) % إذا استبق الاملاك يوما لغاية % % أبيت وذاك المجد إلا التناهيا % % 33(@)(@@) % بهرت فأخفيت الملوك وذكرها % % ولا عجب فالشمس تخفي الدراريا % % 34(@)(@@) % جلوت ظلام الظلم من كل معتد % % ولا غرو ان تجلو البدور الدياجيا % % 35(@)(@@) % هديت سبيل الله من ضل رشده % % فلا زلت مهديا إليه وهاديا % % 36(@)(@@) % افدت وجي الملك مما أفدته % % وطوقت اشراف الملوك الأياديا % % 37(@)(@@) % وقد عرفت منها مرين سوابقا % % تقر لها بالفضل أخرى اللياليا % % 38(@)(@@) % وكان أبو زيان جيدا معطلا % % فزينته حتى أغتدى بك حاليا % % 39(@)(@@) % لك الخير لم تقصد بما قد أفدته % % جزاء ولكن همة هي ماهيا 
ms82	 % % 40(@)(@@) % فما تكبر الاملاك غيرك آمرا % % ولا ترهب الاشراف غيرك ناهيا % % PageV01P286 41(@)(@@) % ولا تشتكي الأيام من داء فتنة % % فقد عرفت منك الطبيب المداويا % % 42(@)(@@) % وأندلسا أوليت ما أنت أهله % % وأوردتها وردا من الأمن صافيا % % 43(@)(@@) % تلافيت هذا الثغر وهو على شفا % % وأصبحت من داء الحوادث شافيا % % 44(@)(@@) % ومن بعد ما ساءت ظنون بأهلها % % وحاموا على ورد الأماني صواديا % % 45(@)(@@) % فما يأملون العيش إلا تعللا % % ولا يعرفون الأمن إلا أمانيا % % 46(@)(@@) % عطفت على الأيام عطفة راحم % % وألبستها ثوب امتنانك ضافيا % % 47(@)(@@) % فآنس من تلقائك الملك رشده % % ونال بك الإسلام ما كان راجيا % % 48(@)(@@) % وقفت على الإسلام نفسا كريمة % % تصد عدوا عن حماه وعاديا % % 49(@)(@@) % فرأي كما انشق الصباح وعزمة % % كما صقل القين الحسام اليمانيا % % 50(@)(@@) % وكانت رماح الخط خمصا ذوابلا % % فأنهلت منها في الدماء صواديا % % PageV01P287 51(@)(@@) % وأوردت صفح السيف ابيض ناصعا % % فأصدرته في الروع أحمر قانيا % % 52(@)(@@) % لك العزم تستجلي الخطوب بهدية % % ويلفي إذا تنبو الصوارم ماضيا % % 53(@)(@@) % إذا أنت لم تفخر بما أنت أهله % % فما الصبح وضاح المشارق عاليا % % 54(@)(@@) % ويهنيك دون العيد عيد شرعته % % تبث به في الخافقين التهانيا % % 55(@)(@@) % أقمت به من فطرة الدين سنة % % وجددت من رسم الهداية عافيا % % 56(@)(@@) % صنيع تولى الله تشييد فخره % % وكان لما أوليت فيه مجازيا % % 57(@)(@@) % تود النجوم الزهر لو مثلت به % % وقضت من الزلفى إليك الأمانيا % % 58(@)(@@) % وما زال وجه اليوم بالشمس مشرقا % % سرورا به والليل بالشهب حاليا % % 59(@)(@@) % على مثله فليعقد الفخر تاجه % % ويسمو به فوق النجوم مراقيا % % 60(@)(@@) % به تغمر الأنواء كل مفوه % % ويحدو به من كان بالقفر ساريا % % PageV01P288 61(@)(@@) % ويوسف فيه بالجمال مقنع % % كأن له من كل قلب مناجيا % % 62(@)(@@) % واقبل ما شاب الحياء مهابة % % يقلب وجه البدر أزهر باهيا % % 63(@)(@@) % واقدم لا هيابة الحفل واجما % % ولا قاصرا فيه الخطى متوانيا % % 64(@)(@@) % شمائل فيه من أبيه وجده % % ترى العز فيها مستكنا وباديا % % 65(@)(@@) % فيا علقا اشجى القلوب لواننا % % فديناك بالأعلاق ما كنت غاليا % % 66(@)(@@) % جريت فأجريت الدموع تعطفا 
ms83	 % % وأطلعت فيها للسرور نواشيا % % 67(@)(@@) % وكم من ولي دون بابك مخلص % % يفديه بالنفس النفيسة واقيا % % 68(@)(@@) % وصيد من الحيين ابناء قيلة % % تكف العوادي أو تبيد الأعاديا % % 69(@)(@@) % بهاليل غر إن أعدوا لغارة % % أعادوا صباح الحي أظلم داجيا % % 70(@)(@@) % فوالله لولا ان توخيت سنة % % رضيت بها أن كان ربك راضيا % % PageV01P289 71(@)(@@) % لكان بها للأعوجيات جولة % % تشيب من الغلب الشباب النواصيا % % 72(@)(@@) % وتترك أوصال الوشيج مقصدا وبيض الظبي حمر المتون دواميا % . . . % 73(@)(@@) % ولما قضى من سنة الله ما قضى % % وقد حسدت منه النجوم المساعيا % % 74(@)(@@) % أفضنا نهني منك أكرم منعم % % أبى لعميم الجود إلا تواليا % % 75(@)(@@) % فيهني صفاح الهند والبأس والندى % % وسمر العوالي والعتاق المذاكيا % % 76(@)(@@) % ويهني البنود الخافقات فإنها % % سيعقدها في ذمة النصر غازيا % % 77(@)(@@) % كأني به يشقي الصوارم والظبي % % ويحطم في اللأم الصلاب العواليا % % 78(@)(@@) % كأني به قد توج الملك يافعا % % وجمع أشتات المكارم ناشيا % % 79(@)(@@) % وقضى حقوق الفخر في ميعة الصبا % % وأحسن من دين الكمال التقاضيا % % 80(@)(@@) % وما هو إلا السعد إن رمت مطلعا % % وسددت سهما كان ربك راميا % % PageV01P290 81(@)(@@) % فلا زلت يا فخر الخلافة كافلا % % ولا زلت يا خير الأئمة كافيا % % 82(@)(@@) % ودمت قرير العين منه بغبطة % % وكان له رب البرية واقيا % % 83(@)(@@) % نظمت له حر الكلام تمائما % % جعلت مكان الدر فيها القوافيا % % 84(@)(@@) % لآل بها تبأى الملوك نفاسة % % وجلت لعمري أن تكون لآليا % % 85(@)(@@) % أرى المال يرميه الجديدان بالبلى % % وما إن أرى إلا المحامد باقيا % % PageV01P291 البحر : - 1(@)(@@) % سل الأفق بالزهر الكواكب حاليا % % فإني قد أودعته شرح حاليا % % 2(@)(@@) % وحملت معتل النسيم أمانة % % قطعت بها عمر الزمان أمانيا % % 3(@)(@@) % فيا من رأى الأرواح وهي ضعيفة % % أحملها ما يستخف الرواسيا % % 4(@)(@@) % وساوس كم جدت وجد بي الهوى % % فعدبه القلب المقلب هازيا % % 5(@)(@@) % ومن يطع الألحاظ في شرعة الهوى % % فلا بد أن يعصي نصيحا ولا حيا % % 6(@)(@@) % عدلت بقلبي عن ولا ية حكمه % % غداة ارتضى من جائر اللحظ واليا % % 7(@)(@@) % وما الحب إلا نظرة تبعث الهوى % % وتعقب ما يعيي الطبيب 
ms84	 المداويا % % 8(@)(@@) % فيا عجبا للعين تمشي طليقة % % ويصبح من جرائها القلب عانيا % % 9(@)(@@) % الا في سبيل الله نفس نفيسة % % يرخص منها الحب ما كان غاليا % % 10(@)(@@) % ويا رب عهد للشباب قضيته % % وأحسنت من دين الوصال التقاضيا % % PageV01P292 11(@)(@@) % خلوت بمن أهواه من غير رقبة % % ولكن عفافي لم أكن عنه خاليا % % 12(@)(@@) % يوم بمستن الظباء شهدته % % أجد وصالا باليا فيه باليا % % 13(@)(@@) % وجرد من غمد الغمامة صارما % % من البرق مصقول الصفيح يمانيا % % 14(@)(@@) % تبسم فاستبكى جفوني غمرة % % ملأت بدر الدمع فيها ردائيا % % 15(@)(@@) % وأذكرني ثغرا ظمئت لورده % % ولا والهوى العذري ما كنت ناسيا % % 16(@)(@@) % وراح خفوق القلب مثلي كأنما % % ببرق الحمى من لوعة الحب ما بيا % % 17(@)(@@) % وليلة بات البدر فيها مضاجعي % % وباتت عيون الشهب نحوي روانيا % % 18(@)(@@) % كرعت بها بين العذيب وبارق % % بمورد ثغربات بالدر حاليا % % 19(@)(@@) % رشفت به شهد الرضاب سلافة % % وقبلت في ماء النعيم الاقاحيا % % 20(@)(@@) % فيا برد ذاك الثغر رويت غلتي % % ويا حر أنفاسي أذيت فؤاديا % % PageV01P293 21(@)(@@) % وروضة حسن للشباب نضيرة % % هصرت بغصن البان فيها المجانيا % % 22(@)(@@) % وبت أسقي وردة الخد أدمعي % % فأصبح فيها نرجس اللحظ ذاويا % % 23(@)(@@) % ومالت بقلبي مائلات قدودها % % فما للقدود المائلات وماليا % % 24(@)(@@) % جزى الله ذاك العهد عودا فطالما % % أعاد على ربعي الظباء الجوازيا % % 25(@)(@@) % وقل لليال في الشباب نعمتها % % وقضيتها أنسا سقيت لياليا % % 26(@)(@@) % ويا واديا رفت علي ظلاله % % ونحن ندير الوصل قدست واديا % % 27(@)(@@) % رمتني عيون السرب فيه وإنما % % رمين بقلبي في الغرام المراميا % % 28(@)(@@) % فلولا اعتصامي بالأمير محمد % % لما كنت من فتك اللواحظ ناجيا % % 29(@)(@@) % فقل للذي يبني على الحسن شعره % % عليه مع الإحسان لا زلت بانيا % % 30(@)(@@) % فكم من شكاة في الهوى قد رفأتها % % ورفعتها بالمدح إذ جاء تاليا % % PageV01P294 31(@)(@@) % وكم ليلة في مدحه قد سهرتها % % اباهي بدر النظم فيه الدراريا % % 32(@)(@@) % ولاح عمود الصبح مثل انتسابه % % رفعت عليه للمديح المبانيا % % 33(@)(@@) % إمام افاد المكرمات زمانه % % وشاد له فوق النجوم المعاليا % % 34(@)(@@) % وجاوز قدر البدر نورا ورفعة % % ولم يرض إلا 
ms85	 بالكمال مواليا % % 35(@)(@@) % هو الشمس بثت في البسيطة نفعها % % وأنوارها أهدت قريبا وقاصيا % % 36(@)(@@) % هو البحر بالإحسان يزخر موجه % % ولكنه عذب لمن جاء عافيا % % 37(@)(@@) % هو الغيث مهما يمسك الغيث سحبه % % يرو بسحب الجود من كان صاديا % % 38(@)(@@) % شمائل لو أن الرياض بحسنها % % لما صار فيها زهرها الغض ذاويا % % 39(@)(@@) % فيا ابن الملوك الصيد من آل خزرج % % وذا نسب كالصبح عز مساميا % % 40(@)(@@) % ألست الذي ترجو العفاة نواله % % فتخجل جدواه السحاب الغواديا % % PageV01P295 41(@)(@@) % ألست الذي تخشى البغاة صياله % % فتوجل علياه الصعاب العواديا % % 42(@)(@@) % وهديك مهما ضلت الشهب قصدها % % تولته في جنح الدجنة هاديا % % 43(@)(@@) % وعزمك أمضى من حسامك في الوغى وإن كان مصقول الغرارين ماضيا % . . . % 44(@)(@@) % فكم قادح في الدين يكفر ربه % % قدحت له زند الحفيظة واريا % % 45(@)(@@) % وما راعه إلا حسام وعزمة % % يضيئان في ليل الخطوب الدواجيا % % 46(@)(@@) % فلولاك يا شمس الخلافة لم يبن % % سبيل جهاد كان من قبل خافيا % % 47(@)(@@) % ولولاك لم ترفع سماء عجاجة % % تلوح بها بيض النصول دراريا ولولاك لم تنهل غصون من القنا وكانت إلى ورد الدماء صواديا % % 48(@)(@@) % فأثمر فيها النصل نصرا مؤزرا % % وأجنى قطاف الفتح غضا ودانيا % % 49(@)(@@) % ومهما غدا سفاح سيفك عاريا يغادر وجه الأرض بالدم كاسيا % . . . % 50(@)(@@) % قضى الله من فوق السموات أنه على من أبى الإسلام في الأرض قاضيا % . . . % PageV01P296 51(@)(@@) % فكم معقل للكفر صبحت أهله % % بجيش أعاد الصبح أظلم داجيا % % 52(@)(@@) % رقيت إليه والسيوف مشيحة % % وقد بلغت فيه النفوس التراقيا % % 53(@)(@@) % ففتحت مرقاه الممنع عنوة % % وبات به التوحيد يعلو مناديا % % 54(@)(@@) % وناقوسه بالقسر أمسى معطلا % % ومنبره بالذكر اصبح حاليا % % 55(@)(@@) % عجائب لم تخطر ببال وإنما % % ظفرنا بها عن همة هي ماهيا % % 56(@)(@@) % فمنك استفاد الدهر كل عجيبة % % يباهي بها الاملاك أخرى لياليا % % 57(@)(@@) % وعنك يروي الناس كل غريبة % % تخط على صفح الزمان الأماليا % % 58(@)(@@) % ولله مبناك الجميل فإنه % % يفوق على حكم السعود المبانيا % % 59(@)(@@) % فكم فيه للابصار من متنزه % % تجد به نفس الحليم الامانيا % % 60(@)(@@) % وتهوى النجوم الزهر لو ثبتت 
ms86	 به % % ولم تلك في أفق السماء جواريا % % PageV01P297 61(@)(@@) % ولو مثلت في سابقيه لسابقت إلى % % خدمة ترضيك منها الجواريا % % 62(@)(@@) % به البهو قد حاز البهاء وقد غدا % % به القصر آفاق السماء مباهيا % % 63(@)(@@) % وكم حلة جللته بحليها % % من الوشي تنسي السابري اليمانيا % % 64(@)(@@) % وكم من قسي في ذراه ترفعت % % على عمد بالنور باتت حواليا % % 65(@)(@@) % فتحسبها الأفلاك دارت قسيها % % تظل عمود الصبح إذ بات باديا % % 66(@)(@@) % سواري قد جاءت بكل غريبة % % فطارت بها الامثال تجري سواريا % % 67(@)(@@) % به المرمر المجلو قد شف نوره % % فيجلو من الظلماء ما كان داجيا % % 68(@)(@@) % إذا ما اضاءت بالشعاع تخالها % % على عظم الاجرام منها لآليا % % 69(@)(@@) % به البحر دفاع العباب تخاله % % إذا ما انبرى وفد النسيم مباريا % % 70(@)(@@) % إذا ما جلت أيدي الصبا متن صفحة % % أرتنا دروعا أكسبتنا الاياديا % % PageV01P298 71(@)(@@) % وراقصة في البحر طوع عنانها % % تراجع الحان القيان الأغانيا % % 72(@)(@@) % إذا ما علت في الجو ثم تحدرت % % تحلي بمرفض الجمان النواحيا % % 73(@)(@@) % بذوب لجين سال بين جواهر % % غدا مثلها في الحسن ابيض صافيا % % 74(@)(@@) % تشابه جار للعيون بجامد % % فلم ادر ايا منهما كان جاريا % % 75(@)(@@) % فإن شئت تشبيها له عن حقيقة % % تصيب بها المرمى وبوركت راميا % % 76(@)(@@) % فقل أرقصت منها البحيرة متنها % % كما يرقص المولود من كان لاهيا % % 77(@)(@@) % أرتنا طباع الجود وهي وليدة % % لم ترض في الإحسان الا تغاليا % % 78(@)(@@) % سقت ثغر زهر الروض عذب برودها % % وقامت لكي تهدي إلى الدهر ساقيا % % 79(@)(@@) % كأن قد رأت نهر المجرة ناضبا % % فرامت بأن تجري إليه السواقيا % % 80(@)(@@) % وقامت بنات الدوح فيه مواثلا % % فرادى ويتلو بعضهن مثانيا % % PageV01P299 81(@)(@@) % رواضع في حجر الغرام ترعرعت % % وشبت فشبت حبها في فؤاديا % % 82(@)(@@) % بها كل ملتف الغدائر مسبل % % تجيل به أيدي النسيم مداريا % % 83(@)(@@) % وأشرف جيد الغصن فيها معطلا % % فقلدت النوار منه التراقيا % % 84(@)(@@) % إذا ما تحلت در زهر غروسه % % يبيت لها النمام بالطيب واشيا % % 85(@)(@@) % مصارفة النقدين فيها بمثلها % % أجاز بها قاضي الجمال التقاضيا % % 86(@)(@@) % فإن ملأت كف النسيم بمثلها % % دراهم 
ms87	 نور ظل عنها مكافيا % % 87(@)(@@) % فيملأ حجر الروض حول غصونها % % دنانير شمس تترك الروض حاليا % % 88(@)(@@) % تغرد في أفنانها الطير كلما % % تجس به ايدي القيان الملاهيا % % 89(@)(@@) % تراجعها سجعا فتحسب أنها % % بأصواتها تملي عليها الأغانيا % % 90(@)(@@) % فلم ندر روضا منه أنعم نضرة % % وأعطر ارجاء وأحلى مجانيا % % PageV01P300 91(@)(@@) % ولم نر قصرا منه أعلى مظاهرا % % وأرفع آفاقا وأفسح ناديا % % 92(@)(@@) % معاني من نفس الكمال انتقيتها % % وزينت منها بالجمال المغانيا % % 93(@)(@@) % وفاتحت مبناه بعيد شرعته % % تبث به في الخافقين التهانيا % % 94(@)(@@) % ولما دعوت الناس نحو صنيعه % % أجابوا لهم من جانب الغور داعيا % % 95(@)(@@) % وأموه من أقصى البلاد تقربا % % وما زال منك السعد يدني الاقاصيا % % 96(@)(@@) % واذكرت يوم العرض جودا ومنعة % % بموقف عرض كنت فيه المجازيا % % 97(@)(@@) % جزيت به كلا على حال سعيه % % فما غرست يمناه أصبح جانيا % % 98(@)(@@) % وأطلعت من جزل الوقود هوادجا % % تذكر يوم النفر من كان ساهيا % % 99(@)(@@) % وحين غدا يذكى ببابك للقرى % % فلا غرو أن أجريت فيه المذاكيا % % 100(@)(@@) % وطامحة في الجو غير مطالة % % يرد مداها الطرف أحسر عانيا % % PageV01P301 101(@)(@@) % تمد لها الجوزاء كف مصافح % % ويدنو لها بدر السماء مناجيا % % 102(@)(@@) % ولا عجب أن فاتت الشهب بالعلا % % وأن جاوزت منها المدى المتناهيا % % 103(@)(@@) % فبين يدي مثواك قامت لخدمة % % ومن خدم الأعلى استفاد المعاليا % % 104(@)(@@) % وشاهد ذا أني ببابك واقف % % وقد حسدت زهر النجوم مكانيا % % 105(@)(@@) % وقد ارضعت ثدي الغمائم قبلها % % بحجر رياض كن فيه نواشيا % % 106(@)(@@) % فلما أبينت عن قرارة اصلها % % أرادت إلى مرقى الغمام تعاليا % % 107(@)(@@) % وعدت لقاء السحب عيدا وموسما % % لذاك اغتدت بالزمر تلهي الغواديا % % 108(@)(@@) % فأضحكت البرق الطروب خلالها % % وباتت لأكواس الدراري معاطيا % % 109(@)(@@) % رأت نفسها طالت فظنت بأنها تفوت على رغم اللحاق المراميا % . . . % 110(@)(@@) % فخفت إليها الذابلات كأنها % % طيور إلى وكر أطلن تهاويا % % PageV01P302 111(@)(@@) % حكت شبها للنحل والنحل حوله % % عصي إلى مثواه تهوي عواليا % % 112(@)(@@) % فمن مثبت منها الرمية مدرك % % ومن طائر في الجو حلق وانيا % % 113(@)(@@) % وحصن منيع في ذراها قد ارتقى % % فأبعد في الجو 
ms88	 الفضاء المراقيا % % 114(@)(@@) % كأن بروق الجو غارت وقد أرت % % بروج قصور شدتهن سواميا % % 115(@)(@@) % فأنشأت برجا صاعدا متنزلا % % يكون رسولا بينهن مداريا % % 116(@)(@@) % تطور حالات أتى في ضروبها % % بأنواع حلي تستفز الغوانيا % % 117(@)(@@) % فحجل برجليها وشاح بخصرها % % وتاج إذا ما حل منها الأعاليا % % 118(@)(@@) % وما هو إلا طير سعد بذروة % % غدا زاجرا من اشهب الصبح بازيا % % 119(@)(@@) % أمولاي يا فخر الملوك ومن به % % سيبلغ دين الله ما كان راجيا % % 120(@)(@@) % بنوك على حكم السعادة خمسة % % وذا عدد للعين ما زال واقيا % % PageV01P303 121(@)(@@) % تبيت لهم كف الثريا معيذة % % ويصبح معتل النواسم راقيا % % 122(@)(@@) % أسام عليها للسعادة ميسم % % ترى العز فيها مستكنا وباديا % % 123(@)(@@) % جعلت أبا الحجاج فاتح طرسهم % % وقد عرفت منك الفتوح التواليا % % 124(@)(@@) % وحسبك سعد ثم نصر يليهم % % محمد الأرضى فما زلت راضيا % % 125(@)(@@) % أقمت به من فطرة الدين سنة % % وجددت في رسم الهداية عافيا % % 126(@)(@@) % وجاءوا به ملء العيون وسامة % % يقبل وجه الأرض أزهر باهيا % % 127(@)(@@) % فيا عاذرا ما كان أجرأ مثله % % فمثلك لا يدمي الأسود الضواريا % % 128(@)(@@) % وجاءتك من مصر التحايا كرائما % % فما فتقت ايدي التجار الغواليا % % 129(@)(@@) % ووافتك من أرض الحجاز تميمة % % تتمم صنع الله لا زال باديا % % 130(@)(@@) % وناداك بالتحويل سلطان طيبة % % فيا طيب ما اهدى إليك مناديا % % PageV01P304 131(@)(@@) % وقام وقد وافى ضريح محمد % % لسلطانك الأعلى هنالك داعيا % % 132(@)(@@) % سريرتك الرحمى جزاك بسعيها % % إله يوفي بالجزاء المساعيا % % 133(@)(@@) % فوالله لولا سنة نبوية % % عهدناه مهديا إليها وهاديا % % 134(@)(@@) % وعذر من الاعذار قرر حكمه % % من الشرع اخبار رفعن عواليا % % 135(@)(@@) % لراعت بها للحرب أهوال موقف % % تشيب بمبيض النصول العواليا % % 136(@)(@@) % لك الحمد فيه من صنيع تعده % % فثالثه في الفخر عزز ثانيا % % 137(@)(@@) % تشد له الجوزاء عقد نطاقها % % لتخدم فيه كي تنال المعاليا % % 138(@)(@@) % وهنيت بالأمداح فيه وقد غدا % % وجودك فيه بالاجادة وافيا % % 139(@)(@@) % ودونك من بحر البيان جواهرا % % كرمن فما يشرين إلا غواليا % % 140(@)(@@) % وطاردت فيها وصف كل غريبة % % فأعجزت من يأتي ومن كان ماضيا % % PageV01P305 141(@)(@@) % فيا وارث 
ms89	 الانصار لاعن كلالة % % تراث جلال يستخف الرواسيا % % 142(@)(@@) % بأمداحه جاء الكتاب مفصلا % % يرتله في الذكر من كان تاليا % % 143(@)(@@) % لقد عرف الإسلام مما أفدته % % مكارم أنصارية واياديا % % 144(@)(@@) % عليك سلام الله فاسلم مخلدا % % تجدد أعيادا وتبلي أعاديا % % PageV01P306 البحر : - 1(@)(@@) % أرقت لبرق مثل جفني ساهرا % % ينظم من قطر الغمام جواهرا % % 2(@)(@@) % فيبسم ثغر الروض عنه ازاهرا % % وصبح حكى وجه الخليفة باهرا % % 3(@)(@@) % تجسم من نور الهدى وتجسدا % . . . % 4(@)(@@) % شفاني معتل النسيم إذا انبرى % % وأسند عن دمعي الحديث الذي جرى % % 5(@)(@@) % وقد فتق الأرجاء مسكا وعنبرا % % كأن الغني بالله في الروض قد سرى % % 6(@)(@@) % فهبت به الأرواح عاطرة الردا % . . . % 7(@)(@@) % عذيري من قلب إلى الحسن قد صبا % % تهيجه الذكرى ويصبو إلى الصبا % % 8(@)(@@) % ويجري جياد اللهو في ملعب الصبا % % ولولا ابن نصر ما أفاق واعتبا % % 9(@)(@@) % رأى وجهه صبح الهداية فاهتدى % . . . % 10(@)(@@) % إليك أمير المسلمين شكاية % % جنى الحسن فيها للقلوب جناية % % PageV01P307 11(@)(@@) % وأعظم فيها بالعيون نكاية % % وأطلع في ليل من الشعر آية % % 12(@)(@@) % محيا جميلا بالصباح قد ارتدى % . . . % 13(@)(@@) % بهديك تهدى النيرات وتهتدي % % وأنوارها جدوى يمينك تجتدي % % 14(@)(@@) % وعدلك للاملاك أوضح مرشد % % بآثاره في مشكل الامر تقتدي % % 15(@)(@@) % فما بال سلطان الجمال قد اعتدى % . . . % 16(@)(@@) % تحكم منا في نفوس ضعيفة % % وسل سيوفا من جفون نحيفة % % 17(@)(@@) % الم يدر أنا في ظلال خليفة % % ودولة أمن لا تراع منيفة % % 18(@)(@@) % بها قد رسا دين الهوى وتمهدا % . . . % 19(@)(@@) % خذوا بدم المشتاق لحظا اراقه % % وبرقا بأعلام الثنية شاقه % % 20(@)(@@) % وإن كلفوه فوق ما قد أطاقه % % يبث حديثا ما ألذ مساقه % % PageV01P308 21(@)(@@) % خليفتنا المولى الإمام محمدا % . . . % 22(@)(@@) % تقلد حكم العدل دينا ومذهبا % % وجور الليالي قد ازاح وأذهبا % % 23(@)(@@) % فيا عجبا للشوق أذكى وألهبا % % وسل صباحا صارم البرق مذهبا % % 24(@)(@@) % وقد بات في جفن الغمامة مغمدا % . . . % 25(@)(@@) % يذكرني ثغرا لاسماء اشنبا % % إذا ابتسمت تجلو من الليل غيهبا % % 26(@)(@@) % كعزم أمير المسلمين إذا اجتبى وأجرى به طرفا من الصبح أشهبا % . . . % 27(@)(@@) % واصدر في ذات الإله وأوردا % . . . % 28(@)(@@) % فسبحان من 
ms90	 أجرى الرياح بنصره % % وعطر أنفاس الرياض بشكره % % 29(@)(@@) % فبرد الصبا يطوي على طيب نشره % % ومهما تجلى وجهه وسط قصره % % 30(@)(@@) % ترى هالة بدر السماء بها بدا % . . . % PageV01P309 31(@)(@@) % إمام أفاد المعلوات زمانه % % فما لحقت زهر النجوم مكانه % % 32(@)(@@) % ومد على شرق وغرب أمانه % % ولا عيب فيه غير أن بنانه % % 33(@)(@@) % تغرق مستجديه في ابحر الندى % . . . % 34(@)(@@) % هو البحر مد العارض المتهللا % % هو البدر لكن لا يزال مكملا % % 35(@)(@@) % هو الدهر لا يخشى الخطوب ولاولا % % هو العلم الخفاق في هضبة العلا % % 36(@)(@@) % هو الصارم المشهور في نصرة الهدى % . . . % 37(@)(@@) % أما والذي أعطى الوجود وجوده % % وأوسع من فوق البسيطة جوده % % 38(@)(@@) % لقد أصحب النصر العزيز بنوده % % ومد بأملاك السماء جنوده % % 39(@)(@@) % وأنجز للإسلام بالنصر موعدا % . . . % 40(@)(@@) % أمولاي قد انجحت رأيا وراية % % ولم تبق في سبق المكارم غاية % % PageV01P310 41(@)(@@) % فتهدي سجايا كابن رشد نهاية % % وإن كان هذا السعد منك بداية % % 42(@)(@@) % سيبقى على مر الزمان مخلدا % . . . % 43(@)(@@) % سعودك تغني عن قراع الكتائب % % وجودك يزري بالغمام السواكب % % 44(@)(@@) % وإن زاحمتها شهبها بالمناكب % % ووجهك بدر المنتدى والمواكب % % 45(@)(@@) % وقد فسحت في الفخر ابناؤك المدى % . . . % 46(@)(@@) % بنوك كأمثال الأنامل عدة % % أعدت لما يخشى من الدهر عدة % % 47(@)(@@) % وزيد بهم برد الخلافة جدة % % أطال لهم في ظل ملكك مدة % % 48(@)(@@) % إله يطيل العمر منك مؤبدا % . . . % 49(@)(@@) % بدور بأوصاف الكمال استقلت % % غمام بفياض النوال استهلت % % 50(@)(@@) % سيوف على الأعداء بالنصر سلت % % نجوم بآفاق العلاء تجلت % % PageV01P311 51(@)(@@) % ولاحت كما شاءت سعودك أسعدا % . . . % 52(@)(@@) % وإن أبا الحجاج سيفك منتضى % % وبدر بآفاق الجمال تعرضا % % 53(@)(@@) % بنورك يا شمس الخلافة قد أضا % % وراقت على أعطافه حلل الرضى % % 54(@)(@@) % فحل محلا من علاك ممهدا % . . . % 55(@)(@@) % مليك له تعنو الملوك جلالة % % يجرر أذيال الفخار مطالة % % 56(@)(@@) % وتفرق اسد الغاب منه بسالة وترضاه انصار الرسول سلالة % . . . % 57(@)(@@) % فأبناؤه طابوا فروعا ومحتدا % . . . % 58(@)(@@) % أزاهر في روض الخلافة اينعت % % زواهر في افق العلاء تطلعت % % 59(@)(@@) % جواهر اغيت في الجمال وأبدعت % % وعن قيمة الاعلاق قدرا ترفعت % % 60(@)(@@) % يسر بها 
ms91	 الإسلام غيبا ومشهدا % . . . % PageV01P312 61(@)(@@) % بعهد ولي العهد كرم عهده % % وأنجز في تخليد ملكك وعده % % 62(@)(@@) % تنظم منهم تحت شملك عقده % % وأورثهم فخرا أبوه وجده % % 63(@)(@@) % فأعلى عليا حين أحمد أحمدا % . . . % 64(@)(@@) % ونجلك نصر يقتفي نجل رسمه % % أمير يزين العقل راجح حلمه % % 65(@)(@@) % أتاك بنجل يستضاء بنجمه % % لحب رسول الله سماه باسمه % % 66(@)(@@) % وباسمك في هذي الموافقة اقتدى % . . . % 67(@)(@@) % أقمت بإعذار الإمارة سنة % % وطوقت من حلي بفخرك منة % % 68(@)(@@) % وأسكنتها في ظل برك جنة % % وألحفتها برد امتنانك جنة % % 69(@)(@@) % وعمرت منها بالتلاوة مسجدا % . . . % 70(@)(@@) % فلله عينا من رآهم تطلعوا % % غصونا بروض الجود فيك ترعرعوا % % PageV01P313 71(@)(@@) % وفي دوحة العلياء منك تفرعوا % % ملوك بجلباب الحياء تقنعوا % % 72(@)(@@) % أضاء بهم من افق قصرك منتدى % . . . % 73(@)(@@) % وقد أشعروا الصبر الجميل نفوسهم % % وأضفوا به فوق الحلى لبوسهم % % 74(@)(@@) % وقد زينوا بالبشر فيه شموسهم % % وعاطوا كؤوس الأنس فيه جليسهم % % 75(@)(@@) % وأبدوا على هول المقام تجلدا % . . . % 76(@)(@@) % شمائل فيهم من أبيهم وجدهم % % تفضل آي الفخر فيها بحمدهم % % 77(@)(@@) % وتنسبها الأنصار قدما لسعدهم % % تضيء بها نورا مصابيح سعدهم % % 78(@)(@@) % ولم لا ومن صحب الرسول توقدا % . . . % 79(@)(@@) % فوالله لولا سنة قد أقمتها % % وسيرة هدي للنبي علمتها % % 80(@)(@@) % وأحكام عدل للجنود رسمتها % % لجالت بها الأبطال تقصد سمتها % % PageV01P314 81(@)(@@) % وتترك أوصال الوشيج مقصدا % . . . % 82(@)(@@) % ويا عاذرا أبدى لنا الشرع عذره % % طرقت حمى قد عظم الله قدره % % 83(@)(@@) % وأجريت طيبا يحسد الطيب نشره % % لقد جئت ما تستعظم الصيد أمره % % 84(@)(@@) % وتفديه إن يقبل خليفتها فدا % . . . % 85(@)(@@) % رعى الله منها دعوة مستجابة % % أفادت نفوس المخلصين إنابة % % 86(@)(@@) % ولم تلف من دون القبول حجابة % % وعاذرها لم يبد عذرا مهابة % % 87(@)(@@) % فأوجب عن نقص كمالا تزيدا % . . . % 88(@)(@@) % فنقص كمال المال وفر نصابه % % وما السيف إلا بعد مشق ذبابه % % 89(@)(@@) % وما الزهر إلا بعد شق إهابه % % بقطع يراع الخط حسن كتابه % % 90(@)(@@) % وبالقص يزداد الذبال توقدا % . . . % PageV01P315 91(@)(@@) % ولما قضوا من سنة الشرع واجبا % % ولم نلق من دون الخلافة حاجبا % % 92(@)(@@) % افضنا نهني منك جذلان واهبا % % أفاض علينا 
ms92	 أنعما ومواهبا % % 93(@)(@@) % تعود بذل الجود فيما تعودا % . . . % 94(@)(@@) % هنيئا هنيئا قد بلغت مؤملا % % وأطلعت نورا يبهر المتأملا % % 95(@)(@@) % وأحرزت أجر المنعمين مكملا % % تبارك من أعطى جزيلا وأجملا % % 96(@)(@@) % وبلغ فيك الدين والملك مقصدا % . . . % 97(@)(@@) % ألا في سبيل العز والفخر موسم % % يظل به ثغر المسرة يبسم % % 98(@)(@@) % وعرف الرضى من جوه يتنسم % % وأرزاق أرباب السعادة تقسم % % 99(@)(@@) % ففي وصفه ذهن الذكي تبلدا % . . . % 100(@)(@@) % وجللت في هذا الصنيع مصانعا % % تمنى بدور التم منها مطالعا % % PageV01P316 101(@)(@@) % وأبديت فيها للجمال بدائعا % % وأجريت للإحسان فيها مشارعا % % 102(@)(@@) % يود بها نهر المجرة موردا % . . . % 103(@)(@@) % وأجريت فيها الخيل وهي سوابق % % وإن طلبت في الروع فهي لواحق % % 104(@)(@@) % نجوم وآفاق الطراد مشارق % % يفوت التماح الطرف منها بوارق % % 105(@)(@@) % إذا ما تجاري الشهب تستبق المدى % . . . % 106(@)(@@) % وتطلع في ليل القتام كواكبا % % وقد وردت نهر النهار مشاربا % % 107(@)(@@) % تقود إلى الأعداء منها كواكبا % % فترسم من فوق التراب محاربا % % 108(@)(@@) % تحور رؤوس الروم فيهن سجدا % . . . % 109(@)(@@) % سوابح بالنصر العزيز سوانح % % وهن لأبواب الفتوح فواتح % % 110(@)(@@) % تقود إليك النصر والله مانح % % فما زلت باب الخير والله فاتح % % PageV01P317 111(@)(@@) % وما تم شيء قد عدا بعدما بدا % . . . % 112(@)(@@) % رياح لها مثنى البروق أعنة % % ظباء فإن جن الظلام فجنة % % 113(@)(@@) % تقيها من البدر المتمم جنة % % وتشرع من زهر النجوم أسنة % % 114(@)(@@) % فتقذف شهب الرجم في أثغر العدا % . . . % 115(@)(@@) % فأشهب من نسل الوجيه إذا انتمى % % جرى فشأى شهب الكواكب في السما % % 116(@)(@@) % وخلف منها في المقلد أنجما % % تردى جمالا بالصباح وربما % % 117(@)(@@) % يقول له الإصباح نفسي لك الفدا % . . . % 118(@)(@@) % وأحمر قد أذكى به البأس جمرة % % وقد سلب الياقوت والورد حمرة % % 119(@)(@@) % أدار به ساق من الحرب خمرة % % وأبدى حبابا فوقها الحسن غرة % % 120(@)(@@) % يزيد بها خدا أسيلا موردا % . . . % PageV01P318 121(@)(@@) % وأشقر مهما شعشع الركض برقه % % أعار جواد البرق في الأفق سبقه % % 122(@)(@@) % بدا شفقا قد جلل الحسن أفقه % % الم تر أن الله أبدع خلقه % % 123(@)(@@) % فسال على أعطافه الحسن عسجدا % . . . % 124(@)(@@) % وأصفر قد ود الأصيل جماله 
ms93	 % % وقد قد من برد العشي جلاله % % 125(@)(@@) % إذا اسرجوا جنح الظلام ذباله % % فغرته شمس تضيء مجاله % % 126(@)(@@) % وفي ذيله ذيل الظلام قد ارتدى % . . . % 127(@)(@@) % وأدهم في مسح الدجى متجرد % % يجيش بها بحر من الليل مزبد % % 128(@)(@@) % وغرته نجم به تتوقد % % له البدر سرج والنجوم مقلد % % 129(@)(@@) % وفي فلق الصبح المبين تقيدا % . . . % 130(@)(@@) % وأبيض كالقرطاس لاح صباحه % % على الحسن مغداه وفيه مراحه % % PageV01P319 131(@)(@@) % وللظبيات الآنسات مراحه % % تراه كنشوان أمالته راحه % % 132(@)(@@) % وتحسبه وسط الجمال معربدا % . . . % 133(@)(@@) % وذاهبة في الجو ملء عنانها % % وقد لفعتها السحب برد عنانها % % 134(@)(@@) % يفوت ارتداء الطرف لمح عيانها % % وختمت الجوزاء سبط بنانها % % 135(@)(@@) % وصاغت لها حلي النجوم مقيدا % . . . % 136(@)(@@) % أراها عمود الصبح علو المصاعد % % وأوهمها قرب المدى المتباعد % % 137(@)(@@) % ففاتته سبقا في مجال الرواعد % % وأتحفت الكف الخضيب بساعد % % 138(@)(@@) % فطوقت الزهر النجوم بها يدا % . . . % 139(@)(@@) % وقد قذفتها للعصي حواصب % % قد انتشرت في الجو منها ذوائب % % 140(@)(@@) % تزاور منها في الفضاء حبائب % % فبينهما من قبل ذاك مناسب % % PageV01P320 141(@)(@@) % لأنهما في الروض قبل تولدا % . . . % 142(@)(@@) % بنات لأم قد حبين لروحها % % دعاها الهوى من بعد كتم لبوحها % % 143(@)(@@) % فأقلامها تهوي لخط بلوحها % % فبالأمس كانت بعض أغصان دوحها % % 144(@)(@@) % فعادت إليها اليوم من بعد عودا % . . . % 145(@)(@@) % ويا رب حصن في ذراها قد اعتلى % % أنارت بروج الأفق في مظهر العلا % % 146(@)(@@) % بروج قصور شدتها متطولا % % فأنشأت برجا صاعدا متنزلا % % 147(@)(@@) % يكون رسولا بينها مترددا % . . . % 148(@)(@@) % وهل هي إلا هالة حول بدرها % % يصوغ لها حليا يليق بنحرها % % 149(@)(@@) % تطور أنواعا تشيد بفخرها % % فحجل برجليها وشاح بخصرها % % 150(@)(@@) % وتاج بأعلى راسها قد تنضدا % . . . % PageV01P321 151(@)(@@) % أراد استراق السمع وهو ممنع % % فقام بأذيال الدجى يتلفع % % 152(@)(@@) % واصغى لأخبار السما يتسمع % % فأتبعه منها ذوابل شرع % % 153(@)(@@) % لتقذفه بالرعب مثنى وموحدا % . . . % 154(@)(@@) % وما هو إلا قائم مد كفه % % ليسأل من رب السموات لطفه % % 155(@)(@@) % لمولى تولاه وأحكم رصفه % % وكلف أرباب البلاغة وصفه % % 156(@)(@@) % وأكرم منه القانت المتهجدا % . . . % 157(@)(@@) % ملاقي ركب من وفود النواسم % % مقبل ثغر للبروق البواسم % % 158 
ms94	(@)(@@) % مختم كف بالنجوم العواثم % % مبلغ قصد من حضور المواسم % % 159(@)(@@) % تجدده مهما صنيع تجددا % . . . % 160(@)(@@) % ومضطرب في الجو أثبت قامة % % تقدم يمشي في الهواء كرامة % % PageV01P322 161(@)(@@) % تطلع في عصن الرشاء كمامة % % وتحسبه تحت الغمام غمامة % % 162(@)(@@) % يسيل على أعطافها عرق الندى % . . . % 163(@)(@@) % هوى واستوى في حالة وتقلبا % % كخاطف برق قد تألق خلبا % % 164(@)(@@) % وتحسبه قد دار في الأفق كوكبا % % ومهما مشى واستوقف العقل معجبا % % 165(@)(@@) % تقلب فيه العين لحظا مرددا % . . . % 166(@)(@@) % لقد رام يرقى للسماء بسلم % % فيمشى على خط به متوهم % % 167(@)(@@) % أجل في الذي يبديه فكر توسم % % ترى طائرا قد حل صورة آدمي % % 168(@)(@@) % وجنا بمهواة الفضاء تمردا % . . . % 169(@)(@@) % ومنتسب للخال سموه ملجما % % له حكمات حكمها فاه ألجما % % 170(@)(@@) % تخالف جنسا والداه إذا انتمى % % كما جنسه أيضا تخالف عنهما % % PageV01P323 171(@)(@@) % عجبت له إذا لم لم يلد وتولدا % . . . % 172(@)(@@) % ثلاثتها في الذكر جاءت مبينة % % من اللاء سماها لنا الله زينة % % 173(@)(@@) % وأنزل فيها آية مستبينة % % وأودع فيها للجهول سكينة % % 174(@)(@@) % وآلاءه فيها على الخلق بددا % . . . % 175(@)(@@) % كسوه من الوشي اليماني هودجا % % يمد على ما فوقه الظل سجسجا % % 176(@)(@@) % وكم صورة تجلى به تبهر الحجى % % وجزل وقود ناره تصدع الدجى % % 177(@)(@@) % وقلب حسود غاظ مذكيه موقدا % . . . % 178(@)(@@) % وما هي إلا مظهر لجهاده % % أرتنابها الأفراح فضل اجتهاده % % 179(@)(@@) % ملاعبها هزت قدود صعاده % % وأذكرت الأبطال يوم طراده % % 180(@)(@@) % فما ارتبت فيه اليوم صدقته غدا % . . . % PageV01P324 181(@)(@@) % الا جدد الرحمن صنعا حضرته % % ودوح الأماني في ذراه هصرته % % 182(@)(@@) % بقصر طويل الوصف فيه أختصرته % % يقيد طرف الطرف مهما نظرته % % 183(@)(@@) % ومن وجد الاحسان قيدا تقيدا % . . . % 184(@)(@@) % دعوت له الأشراف من كل بلدة % % فجاءوا بآمال لهم مستجدة % % 185(@)(@@) % وخصوا بألطاف لديه معدة % % أياد بفياض الندى مستمدة % % 186(@)(@@) % فكلهم من فضله قد تزودا % . . . % 187(@)(@@) % وجاءتك من آل النبي عصابة % % لها في مرامي المكرمات إصابة أحبتك حبا ليس فيه استرابة ولبت دواعي الفوز منها إجابة % % 188(@)(@@) % وناداهم التخصيص فابتدروا الندا % . . . % 189(@)(@@) % أجازوا إليك البحر والبحر يزخر % % لبحر سماح مده 
ms95	 ليس يجزر % % 190(@)(@@) % فرواهم من عذب جودك كوثر % % وواليت من نعماك ما ليس يحصر % % PageV01P325 191(@)(@@) % وعظمتهم ترجو النبي محمدا % . . . % 192(@)(@@) % عليه صلاة الله ثم سلامه % % به طاب من هذا النظام اختتامه % % 193(@)(@@) % وجاء بحمد الله حلوا كلامه % % يعز على أهل البيان مرامه % % 194(@)(@@) % وتمسي له زهر الكواكب حسدا % . . . % 195(@)(@@) % ابث به حادي الركاب مشرقا % % حديث جهاد للنفوس مشوقا % % 196(@)(@@) % رميت به من بالعراق مفوقا % % وأرسلت منه بالبديع مطوقا % % 197(@)(@@) % حماما على دوح الثناء مغردا % . . . % 198(@)(@@) % ركضت به خيل البيان إلى مدى % % فأحرزت فضل السبق في حلبة الهدى % % 199(@)(@@) % ونظمت من نظم الدراري مقلدا % % وطوقت جيد الفخر عقدا منضدا % % 200(@)(@@) % وقمت به بين السماطين منشدا % . . . % PageV01P326 201(@)(@@) % نسقت من الاحسان فيه فرائدا % % وأرسلت في روض المحاسن رائدا % % 202(@)(@@) % وقلدت عطف الملك منه قلائدا % % تعودت فيه للقبول عوائدا % % 203(@)(@@) % فلا زلت للفعل الجميل معودا % . . . % 204(@)(@@) % ولا زلت للصنع الجميل مجددا % % ولا زلت للفخر العظيم مخلدا % % 205(@)(@@) % وعمرت عمرا لا يزال مجددا % % وعمرت بالأبناء أوحدا أوحدا % % 206(@)(@@) % وقرت بهم عيناك ما سائق حدا % . . . % PageV01P327 البحر : - 1(@)(@@) % قد نظم الشمل أتم انتظام % % واغتنم الأحباب قرب الحبيب % % 2(@)(@@) % واستضحك الروض ثغور الكمام % % عن مبسم الزهر البرود الشنيب % % 3(@)(@@) % وعمم النور رؤوس الربى % % وجلل النور صدور البطاح % % 4(@)(@@) % وصافح القضب نسيم الصبا % % فالزهر يرنو عن عيون وقاح % % 5(@)(@@) % وعاود النهر زمان الصبا % % فقلد الزهر مكان الوشاح % % 6(@)(@@) % وأطلع القصر برود التمام % % في طالع الفتح القريب الغريب % % 7(@)(@@) % خدودها قامت مقام الغمام % % فلا اشتكى من بعدها بالمغيب % % 8(@)(@@) % اصبحت يا رية مجلس النفوس % % جمالك العين بها يبهر % % 9(@)(@@) % والبشر يسري في جميع الشموس % % وراية الأنس بها تشهر % % 10(@)(@@) % والدوح للشكر تحط الرؤوس % % وأنجم الزهر بها تزهر % % PageV01P328 11(@)(@@) % وراجع النهر غناء الحمام % % وقد شدت تسجع سجع الخطيب % % 12(@)(@@) % بمنبر الغصن الرشيق القوام % % لما انثنى يهفو بقد رطيب % % 13(@)(@@) % يا حبذا مبناك فخر القصور % % بروجه طالت بروج السما % % 14(@)(@@) % ما مثله في سالفات العصور % % ولا الذي شاد ابن ماء السما % % 15 
ms96	(@)(@@) % كم فيه من مرأى بهيج ونور % % في مرتقى الجو به قد سما % % 16(@)(@@) % خليفة الله ونعم الإمام % % أتحفك الدهر بصنع عجيب % % 17(@)(@@) % يهنيك شمل قد غدا في التئام % % ممهدا في ظل عيش خصيب % % 18(@)(@@) % نواسم الوادي بمسك تفوح % % ونفحة الند به تعبق % % 19(@)(@@) % وبهجة السكان فيه تلوح % % وجوه من نورهم يشرق % % 20(@)(@@) % وروضه بالسر منه يبوح % % بلابل عن وجده تنطق % % PageV01P329 21(@)(@@) % لو أن من يفهم عنها الكلام % % فهي تهنيك هناء الأديب % % 22(@)(@@) % ونهره قد سل منه الحسام % % يلحظه النرجس لحظ المريب % % 23(@)(@@) % فأجمل الأيام عصر الشباب % % وأجمل الأجمل يوم اللقا % % 24(@)(@@) % يا درة القصر وشمس القباب % % وهازم الأحزاب في الملتقى % % 25(@)(@@) % بشرك الرب بحسن المآب % % متعك الله بطول البقا % % 26(@)(@@) % ولا يزال القصر قصر السلام % % يختال في برد الشباب القشيب % % 27(@)(@@) % يتلو عليك الدهر في كل عام نصر من الله وفتح قريب % . . . % PageV01P330 البحر : - 1(@)(@@) % قد نظم الشمل أتم انتظام % % ولاحت الاقمار بعد المغيب % % 2(@)(@@) % واضحك الروض ثغور الكمام % % عن مبسم الزهر البرود الشنيب % % 3(@)(@@) % وعاود الغصن زمان الصبا % % وأشرب الأنس جميع النفوس % % 4(@)(@@) % وعمم النور رؤوس الربى % % وجلل النور وجوه الشموس % % 5(@)(@@) % واطرب الغصن نسيم الصبا % % فالدوح للشكر تحط الرؤوس % % 6(@)(@@) % واستقبل البدر ليالي التمام % % وصافح الصبح بكف خضيب % % 7(@)(@@) % وراجع الأطيار سجع الحمام % % بكل ذي لحن بديع غريب % % 8(@)(@@) % نواسم الوادي بمسك تفوح % % ونفحة الند به تعبق % % 9(@)(@@) % وبهجة السكان فيه تلوح % % وجوه من نوره يشرق % % 10(@)(@@) % وعرفه بالطيب منه يفوح % % كأنه من عنبر يفتق % % PageV01P331 11(@)(@@) % والنهر قد سل كمثل الحسام % % حبابه تطفو وطورا تغيب % % 12(@)(@@) % وثغرها قد راق منه ابتسام % % يهنئ الحب بقرب الحبيب % % 13(@)(@@) % كواكب أبراجهن الخدود % % يلوح عنها كل بدر لياح % % 14(@)(@@) % جواهر اصدافهن القصور نظمها السعد كنظم الوشاح % . . . % 15(@)(@@) % يا حبذا والله ركب السرور يبشر المولى بنيل اقتراح % . . . % 16(@)(@@) % ابتهج الكون بموسى الإمام % % واختال في برد الشباب القشيب % % 17(@)(@@) % وعاده يخدم مثل الغلام % % شبابه قد عاد بعد المشيب % % 18(@)(@@) % أكرم به والله وفد الكريم % % مولاتنا 
ms97	 الحرة ب في مقدمة % % 19(@)(@@) % مرضاتها تحظي بدار النعيم % % وتوجب التوفيق من منعمه % % 20(@)(@@) % بشر بالنصر وفتح جسيم % % وخيره أجمع في مقدمه % % PageV01P332 21(@)(@@) % لقاؤها المبرور مسك الختام % % بشرك الله بصنع عجيب % % 22(@)(@@) % وقصرك الميمون قصر السلام خط بحفظ من سميع مجيب % . . . % 23(@)(@@) % مولاي يهنيك وحق الهنا قد نظم الشمل كنظم السعود % . . . % 24(@)(@@) % قد فزت بالفخر ونيل المنى % % وأنجز السعد جميع الوعود % % 25(@)(@@) % وقرت العين وزال العنا % % وكلما مر صنيع يعود % % 26(@)(@@) % فلا يزل ملكك حلف الدوام % % يحوز في التخليد أوفى نصيب % % 27(@)(@@) % يتلو عليك الدهر بعد السلام % % نصر من الله وفتح قريب % % PageV01P333 البحر : - 1(@)(@@) % لله ما أجمل روض الشباب % % من قبل أن يفتح زهر المشيب % % 2(@)(@@) % في عهده أدرت كأس الرضاب % % حبابها الدر بثغر الحبيب % % 3(@)(@@) % من كل من يخجل بدر التمام % % إذا تبدى وجهه للعيون % % 4(@)(@@) % ويفضح الغصن بلين القوام % % وأين منه لين قد الغصون % % 5(@)(@@) % ولحظة يمضي مضاء الحسام % % ويذهل العقل بسحر الجفون % % 6(@)(@@) % ابصرت منه إذ يحط النقاب % % شمسا ولكن مالها من مغيب % % 7(@)(@@) % إذا تجلت بعد طول ارتقاب % % صرفت عنها اللحظ خوف الرقيب % % 8(@)(@@) % من عاذري منه فؤادا صبا % % للامع البرق وخفق الرياح % % 9(@)(@@) % يطير إن هب نسيم الصبا % % تعيره الريح خفوق الجناح % % 10(@)(@@) % ما أولع الصب بعهد الصبا % % وهل على من قد صبا من جناح % % PageV01P334 11(@)(@@) % فقلبه من شوقه في التهاب % % قد احرق الأكباد منه الوجيب % % 12(@)(@@) % والجفن منه سحبه في انسكاب % % قد روض الخد بدمع سكيب % % 13(@)(@@) % غرناطة ربع الهوى والمنى % % وقربها السؤال ونيل الوطر % % 14(@)(@@) % وطيبها بالوصل لو أمكنا % % لم أقطع الليل بطول السهر % % 15(@)(@@) % عما قريب حق فيها الهنا % % بيمن ذي العودة بعد السفر % % 16(@)(@@) % ويحمد الناس نجاح الإياب % % بكل صنع مستجد غريب % % 17(@)(@@) % ويكتب الفال على كل باب % % نصر من الله وفتح قريب % % 18(@)(@@) % ما لذة الأملاك إلا القنص % % لأنه الفال بصيد العدى % % 19(@)(@@) % كم شارد جرع فيه الغصص % % وأورد المحروب ورد الردى % % 20(@)(@@) % وكم بذا الفحص لنا من حصص % % قد 
ms98	 جمع البأس بها والندى % % PageV01P335 البحر : - 1(@)(@@) % مولاي مولاي وأنت الذي % % جددت للأملاك عهد الجلال % % 2(@)(@@) % والشمس والبدر من العوذ % % لما رأت منك بديع الجمال % % 3(@)(@@) % والروض في نعمته يغتذي % % بطيب ما قد حزته من خلال % % 4(@)(@@) % بشراك بشراك بحسن المآب % % تستضحك الروض بثغر شنيب % % 5(@)(@@) % ودمت محروس العلا والجناب % % بعصمة الله السميع المجيب % % PageV01P336 البحر : - 1(@)(@@) % لو ترجع الأيام بعد الذهاب % % لم تقدح الأيام ذكرى حبيب % % 2(@)(@@) % وكل من نام بليل الشباب % % يوقظه الدهر بصبح المشيب % % 3(@)(@@) % يا راكب العجز ألا نهضة % % قد ضيق الدهر عليك المحال % % 4(@)(@@) % لا تحسبن أن الصبا روضة % % تنام فيها تحت فيء الظلال % % 5(@)(@@) % فالعيش نوم والردى يقظة % % والمرء ما بينهما كالخيال % % 6(@)(@@) % والعمر قد مر كمر السحاب % % والملتقى بالله عما قريب % % 7(@)(@@) % وأنت مخدوع بلمع السراب % % تحسبه ماء ولا تستريب % % 8(@)(@@) % والله ما الكون بما قد حوى % % إلا ظلال توهم الغافلا % % 9(@)(@@) % وعادة الظل إذا ما استوى % % تبصره منتقلا زائلا % % 10(@)(@@) % إنا إلى الله عبيد الهوى % % لم نعرف الحق ولا الباطلا % % PageV01P337 11(@)(@@) % فكل من يرجو سوى الله خاب وإنما الفوز لعبد منيب % . . . % 12(@)(@@) % يستقبل الرجعى بصدق المتاب % % ويرقب الله الشهيد القريب % % 13(@)(@@) % يا حسرتا مر الصبا وانقضى % % وأقبل الشيب يقص الأثر % % 14(@)(@@) % وأخجلتا والرجل قد قوضا % % وما بقي في الخبر غير الخبر % % 15(@)(@@) % وليتني لو كنت فيما مضى % % أدخر الزاد لطول السفر % % 16(@)(@@) % قد حان من ركب التصابي إياب % % ورائد الرشد أطال المغيب % % 17(@)(@@) % يا أكمه القلب بغين الحجاب % % كم ذا أناديك فلا تستجيب % % 18(@)(@@) % هل يحمل الزاد لدار الكريم % % والمصطفى الهادي شفيع مطاع % % 19(@)(@@) % فجاهه ذخر الفقير العديم % % وحبه زادي ونعم المتاع % % 20(@)(@@) % والله سماه الرؤوف الرحيم % % فجاره المكفول ما إن يضاع % % PageV01P338 21(@)(@@) % عسى شفيع الاس يوم الحساب % % وملجأ الخلق لرفع الكروب % % 22(@)(@@) % يلحقني منه قبول مجاب % % يشفع لي في موبقات الذنوب % % 23(@)(@@) % يا مصطفى والخلق رهن العدم % % والكون لم يفتق كمام الوجود % % 24(@)(@@) % مزية أعطيتها في القدم % % بها على كل نبي تسود % % 25 
ms99	(@)(@@) % مولدك المرقوم لما نجم % % أنجز للأمة وعد السعود % % 26(@)(@@) % ناديت لو يسمح لي بالجواب % % شهر ربيع يا ربيع القلوب % % 27(@)(@@) % أطلعت للهدي بغير احتجاب % % شمسا ولكن ما لها من غروب % % PageV01P339 البحر : - 1(@)(@@) % في كؤوس الثغر من ذاك اللعس % % راحة الأرواح % % 2(@)(@@) % وتغشى الروض مسكي النفس % % عاطر الارواح % % 3(@)(@@) % وكسا الأرواح وشيا مذهبا % % يبهر الشمسا % % 4(@)(@@) % عسجد قد حل من فوق الربى % % يبهج النفسا % % 5(@)(@@) % فاتخذ للهو فيه مركبا % % تلحق الأنسا % % 6(@)(@@) % منبر الغصن عليه قد جلس % % ساجع الادواح % % 7(@)(@@) % حلل السندس خضرا قد لبس % % عطفه المرتاح % % 8(@)(@@) % قم ترى هذا الأصيل شاحبا % % حسنه قد راق % % 9(@)(@@) % ولأذيال الغصون ساحبا % % في حلى الأوراق % % 10(@)(@@) % ونديم قال لي مخاطبا % % قول ذي إشفاق % % PageV01P340 11(@)(@@) % عادة الشمس بغرب تختلس % % هات شمس الراح % % 12(@)(@@) % إن أرانا الجو وجها قد عبس % % أوقد المصباح % % 13(@)(@@) % ووجوه الشرب تغني عن شموس % % كلما تجلى % % 14(@)(@@) % بلحاظ اسكرتنا عن كؤوس % % خمرها أحلى % % 15(@)(@@) % مظهرات من خفايا في النفوس % % سورا تتلى % % 16(@)(@@) % ما زمان الأنس إلا مختلس % % فاغتنم يا صاح % % 17(@)(@@) % وعيون الشهب تذكى عن حرس % % تخصم النصاح % % 18(@)(@@) % ما ترى ثغر الوميض باسما % % يظهر البشرا % % 19(@)(@@) % وثناء الروض هب ناسما % % عاطرا نشرا % % 20(@)(@@) % بث من أزهاره دراهما % % قائلا بشرى % % PageV01P341 21(@)(@@) % ركب المولى مع الظهر الفرس % % وشفي وارتاح % % 22(@)(@@) % بجنود الله دأبا يحترس % % إن غدا أو راح % % 23(@)(@@) % وجب الشكر علينا والهنا % % بعضنا بعضا % % 24(@)(@@) % فزمان السعد وضاح السنا % % وجهه الأرضي % % 25(@)(@@) % اثمرت فيه العوالي بالمنى % % ثمرا غضا % % 26(@)(@@) % يجتني الإسلام منها ما اغترس % % سيفه السفاح % % 27(@)(@@) % في ضمير النقع منها قد هجس % % شهب تلتاح % % 28(@)(@@) % يا إماما بالحسام المنتضى % % نصر الحقا % % 29(@)(@@) % ثغرك الوضاح مهما اومضا % % أخجل البرقا % % 30(@)(@@) % وديون السعد منه تقتضى % % توسع الحقا % % PageV01P342 31(@)(@@) % لك وجه من صباح مقتبس % % بشره وضاح % % 32(@)(@@) % وجميل الصفح منه ملتمس % % منعم صفاح % % 33(@)(@@) % هاكها تمزج لطفا بالنسيم % % كلما هبا % % 34(@)(@@) % قد أتت بالبر والصنع الجسيم % % تشكر الربا % % 35(@)(@@) % أخجلت من قال في 
ms100	 الصبح الوسيم % % مغرما صبا % % 36(@)(@@) % غرد الطير فنبه من نعس % % يا مدير الراح % % 37(@)(@@) % وتعرى الفجر عن ثوب الغلس % % وانجلى الإصباح % % PageV01P343 البحر : - 1(@)(@@) % وجه هذا اليوم باسم % % وشذا الأزهار ناسم % % 2(@)(@@) % هاتها صاح كؤوسا % % جالبات للسرور % % 3(@)(@@) % وارتقب منها شموسا % % طالعات في حبور % % 4(@)(@@) % ما ترى الروض عروسا % % في حلى نور ونور % % 5(@)(@@) % وأتت رسل النواسم % % تجتلي هذي النواسم % % 6(@)(@@) % قد أهلت بالبشائر % % أضحكت ثغر الأزاهر % % 7(@)(@@) % سنحت في يمن طائر % % ونظمن كالجواهر % % 8(@)(@@) % فانشروها في العشائر % % إن هذا الصنع باهر % % 9(@)(@@) % وأشيعوا في العوالم % % الغني بالله سالم % % 10(@)(@@) % أي نور يتوقد % % أي بدر يتلالا % % PageV01P344 11(@)(@@) % أي فخر يتخلد % % أي غيث يتوالى % % 12(@)(@@) % إنما المولى محمد % % رحمة الله تعالى % % 13(@)(@@) % كفه بحر المقاسم % % وبها حج المباسم % % 14(@)(@@) % خير أملاك الزمان % % من بني سعد ونصر % % 15(@)(@@) % ما ترى أن الشواني % % في صعيد البر تجري % % 16(@)(@@) % قد أطارتها التهاني % % دون بحري وبحر % % 17(@)(@@) % مذ رأت بحر النعائم % % كلها جار وعائم % % 18(@)(@@) % فهنيئا بالشفاء % % يا أمير المسلمينا % % 19(@)(@@) % ولنا حق الهناء % % وجميع العالمينا % % 20(@)(@@) % إن جهرنا بالدعاء % % ينطق الدهر أمينا % % PageV01P345 21(@)(@@) % دمت محروس المكارم % % بظبي البيض الصوارم % % PageV01P346 البحر : - 1(@)(@@) % نواسم البستان % % تنثر سلك الزهر % % 2(@)(@@) % والطل في الأغصان % % ينظمه بالجوهر % % 3(@)(@@) % وراية الإصباح % % أضاء منها المشرق % % 4(@)(@@) % تنشرها الأرواح % % فلا تزال تخفق % % 5(@)(@@) % والزهر زهر فاح % % لها عيون ترمق % % 6(@)(@@) % فأيقظ الندمان % % يبصرن ما لم يبصر % % 7(@)(@@) % جواهر الشهبان % % قد عرضت للمشتري % % 8(@)(@@) % قدحت لي زندا % % يا ايهذا البارق % % 9(@)(@@) % أذكرتني عهدا % % إذ الشباب رائق % % 10(@)(@@) % فالشوق لا يهدا % % ولا الفؤاد الخافق % % PageV01P347 11(@)(@@) % وكيف بالسلوان % % والقلب رهن الفكر % % 12(@)(@@) % وسحب الهجران % % تحجب وجه القمر % % 13(@)(@@) % لولا شموس الكاس % % نديرها بين البدور % % 14(@)(@@) % وعرج الإيناس % % منا على ربع الصدور % % 15(@)(@@) % لكن لها وسواس % % يغري بربات الخدور % % 16(@)(@@) % كم والد هيمان % % بصبح وجه مسفر % % 17(@)(@@) % ضياؤه قد بان % % من تحت ليل مقمر % % 18(@)(@@) % يا مطلع الأنوار % % كم فيك من مرأى جميل % % 19(@)(@@) % ونزهة الأبصار % % ما 