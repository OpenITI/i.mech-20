ms601	 المغيرة بن شعبة روى عنه سالم بن أبي الجعد وعبد الملك بن ميسرة وأياد بن لقيط(@)(@@)(@@)(@@) $ 3140 - سويد والد المعرور بن سويد يروي عن عمر ورآه الأعمش وهو بن عشرين ومائة سنة أسود الرأس واللحية PageV04P324(@)(@@)(@@)(@@) $ 3141 - سويد بن عبيد العجلي صاحب القصب يروي عن أبي موسى الأشعري يروي عن رجل عن أبي موسى روى عنه عبد الصمد وأبو نعيم(@)(@@)(@@)(@@) $ 3142 - سويد أبو الأسود مولى عمرو بن حريث المخزومي القرشي الكوفي يروي عن عمرو بن حريث روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 3143 - سويد بن جبلة الفزاري السلمي يروي عن العرباض بن سارية وعمرو بن عنبسة روى عنه لقمان بن عامر الوصابى وأبو المصبح المقرإى(@)(@@)(@@)(@@) $ 3144 - سويد بن عفرى المعافري من أهل مصر يروي عن أبي ذر روى عنه سعد بن شراح المعافري(@)(@@)(@@)(@@) $ 3145 - السائب بن أبي لبابة بن عبد المنذر من أهل المدينة يروي عن عمر بن الخطاب كنيته أبو عبد الرحمن مات في ولاية يزيد بن عبد الملك وقد قيل إنه ولد في عهد النبي صلى الله عليه وسلم PageV04P325(@)(@@)(@@)(@@) $ 3146 - السائب بن مالك الكناني يروي عن عمر وفضالة بن عبيد روى عنه الزهري ويزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 3147 - السائب بن مالك الأشعري يروي عن عبد الله بن عمرو روى عنه أبو إسحاق الهمداني(@)(@@)(@@)(@@) $ 3148 - السائب بن عبد الله مولى أم سلمة زوجة النبي صلى الله عليه وسلم يروي عن أم سلمة روى عنه دراج أبو السمح من حديث عمرو بن الحارث(@)(@@)(@@)(@@) $ 3149 - السائب بن حبيش يروي عن عمر روى عنه سليمان بن يسار(@)(@@)(@@)(@@) $ 3150 - السائب مولى العاربين يروي عن زيد بن خالد الجهني روى بن جريج عن أبي سعد الأعمى عنه(@)(@@)(@@)(@@) $ 3151 - السائب بن فروخ أبو العباس الشاعر من أهل مكة يروي عن عبد الله بن عمرو وابن عمر روى عنه عطاء بن أبي رباح وعمرو بن دينار وحبيب بن أبي ثابت PageV04P326(@)(@@)(@@)(@@) $ 3152 - السائب بن يزيد الثقفي من أهل الكوفة كنيته أبو عطاء وقد قيل أبو يحيى يروي عن علي 
ms602	 وعبد الله بن عمرو روى عنه ابنه عطاء بن السائب(@)(@@)(@@)(@@) $ 3153 - السائب بن خباب يروى عن بن عمر ولد سنة خمس وعشرين ومات سنة تسع وتسعين روى عنه الناس كنيته أبو عبد الرحمن وليس هذا الذي يقال له صاحب المقصورة ذلك مولى فاطمة بنت عتبة بن ربيعة بن عبد شمس فيما قيل ولا يصح ذلك عندي له صحبة(@)(@@)(@@)(@@) $ 3154 - السائب أبو عمرو يروي عن بن عباس روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 3155 - السائب بن أبي هندية الثقفي يروي عن بن عمر روى عنه ابنه محمد بن السائب PageV04P327(@)(@@)(@@)(@@) $ 3156 - السائب بن مهجان الشامي من أهل إيلياء أدرك عمر بن الخطاب وجماعة من أصحاب النبي صلى الله عليه وسلم روى عنه سفيان بن أبي العمياء(@)(@@)(@@)(@@) $ 3157 - السائب يروي عن عائشة روى عنه حمزة بن سفينة(@)(@@)(@@)(@@) $ 3158 - السائب الشيباني يروي عن عبد الله بن عمرو روى عنه ابنه عبد الله بن السائب(@)(@@)(@@)(@@) $ 3159 - السائب يروي عن أبي محذورة روى عنه ابنه عثمان بن السائب(@)(@@)(@@)(@@) $ 3160 - أبو الشعثاء اسمه سليم بن الأسود المحاربي من أهل الكوفة يروي عن بن مسعود وابن عمر وحذيفة روى عنه ابنه أشعث بن أبي الشعثاء مات بعد الجماجم(@)(@@)(@@)(@@) $ 3161 - سليم بن عامر الخبائري الكلاعي من أهل الشام كنيته أبو يحيى يروي عن أبي أمامة روى عنه يزيد بن خمير ومعاوية بن صالح مات سنة ثلاثين ومائة PageV04P328(@)(@@)(@@)(@@) $ 3162 - سليم بن عتر من أهل مصر يروي عن أبي الدرداء روى عنه علي بن رباح اللخمي ومشرح بن هاعان(@)(@@)(@@)(@@) $ 3163 - سليم أبو ميمونة الفارسي والد هلال بن أبي ميمونة يروي عن أبي هريرة روى عنه أبو النضر مولى عمر بن عبيد الله وابنه هلال بن أبي ميمونة(@)(@@)(@@)(@@) $ 3164 - سليم بن بلج يروي عن علي روى عنه ابنه أبو بلج يحيى بن سليم(@)(@@)(@@)(@@) $ 3165 - سليم القاص أبو إبراهيم قال مطرنا يوم قتل الحسين دما روى عنه حماد بن سلمة وابن علبة يخطىء(@)(@@)(@@)(@@) $ 3166 - سليم أبو عمران الأنصاري مولى أم الدرداء عداده في أهل 
ms603	 الشام يروي عن ذي الأصابع وله صحبة وكان راويا لأم الدرداء روى عنه ثعلبة بن مسلم وأهل الشام(@)(@@)(@@)(@@) $ 3167 - سليم أبو عروة مولى لقريش يروي عن بن عباس روى عنه أشعث بن سوار PageV04P329(@)(@@)(@@)(@@) $ 3168 - سليم مولى سعد يروي عن بن عمر روى عنه بن جريج(@)(@@)(@@)(@@) $ 3169 - سليم أبو عامر خادم عمار بن ياسر روى عنه ثابت بن عجلان(@)(@@)(@@)(@@) $ 3170 - سليم أبو منصور يروي عن أبي سعيد الخدري روى عنه زياد بن أبي زياد مولى بن عياش وقد قيل إنه سليم أبو ميمون(@)(@@)(@@)(@@) $ 3171 - سليم بن سرح يروي عن بن عمر روى عنه أبو مالك الأشجعي(@)(@@)(@@)(@@) $ 3172 - سليم بن يزيد الكندي يروي عن حذيفة روى عنه العيزار بن جرول(@)(@@)(@@)(@@) $ 3173 - سليم العامري يروي عن حذيفة روى عنه الأعمش(@)(@@)(@@)(@@) $ 3174 - سليم مولى بنى المطلب يروي عن أبي هريرة روى عنه عبد الله بن العلاء بن زبر(@)(@@)(@@)(@@) $ 3175 - سليم بن عبد السلولي الكوفي يروي عن حذيفة روى عنه أبو إسحاق السبيعي وكان قد شهد غزوة طبرستان(@)(@@)(@@)(@@) $ 3176 - أبو يونس اسمه سليم بن جبير الدوسي من أهل المدينة يروي عن أبي هريرة وكان مولاه قد روى عنه عمرو بن الحارث PageV04P330 وحرملة بن عمران وابن لهيعة(@)(@@)(@@)(@@) $ 3177 - سليم بن عبد الله بن جنادة الفهري يروي عن أبي هريرة روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 3178 - سليم بن هرمز يروي عن عبد الله بن عمرو روى عنه بن أخيه عبد الله بن مسلم بن هرمز(@)(@@)(@@)(@@) $ 3179 - سليم أبو عامر الشامي يروي عن أبي بكر الصديق وقد شهد فتح دمشق والقادسية روى عنه ثابت بن عجلان(@)(@@)(@@)(@@) $ 3180 - سليم بن مسحل يروي عن بن عمر روى عنه سعد بن طارق أبو مالك(@)(@@)(@@)(@@) $ 3181 - سليم بن حنظلة السعدي من أهل الكوفة يروي عن بن مسعود روى عنه إسحاق السبيعي(@)(@@)(@@)(@@) $ 3182 - سليم العامري مولى لبني أمية يروي عن عمر روى عنه عبد الله بن مسلم PageV04P331(@)(@@)(@@)(@@) $ 3183 - سليم بن حنظلة البكري من أهل الكوفة يروي عن عمر وأبي بن كعب روى 
ms604	 عنه عياش العامري وهارون بن عنترة وهارون كذاب(@)(@@)(@@)(@@) $ 3184 - سلام بن شرحبيل أبو شرحبيل يروي عن سواء وحبة ابني خالد ولهما صحبة روى عنه الأعمش(@)(@@)(@@)(@@) $ 3185 - سلام بن نبيط الكاهلي يروي عن على روى عنه جعفر بن سعد وهو الذي يقال له سلام بن سليط(@)(@@)(@@)(@@) $ 3186 - سلام بن عمرو يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه أبو بشر جعفر بن أبي وحشية(@)(@@)(@@)(@@) $ 3187 - سلمان بن ربيعة التميمي الباهلي أول قاض استقضى بالكوفة فمكث أربعين يوما لا يأتيه خصم وكان قد استقضاه عمر بن الخطاب حينئذ وهو الذي يقال له سلمان الخيل كان يلي الخيول في خلافة عمر بن الخطاب بالكوفة وكان رجلا صالحا يحج كل سنة روى عنه أبو وائل PageV04P332(@)(@@) وقتل سلمان بن ربيعة الباهلي ببلنجر من ناحية أرمينية غازيا كان على مقدمة سعيد بن العاص في سنة خمس وعشرين في خلافة عثمان(@)(@@)(@@)(@@) $ 3188 - أبو عبد الله الأغر اسمه سلمان مولى جهينة كان قاضيا بالمدينة يروي عن أبي هريرة وأبي سعيد روى عنه الزهري وابنه عبيد الله بن سلمان(@)(@@)(@@)(@@) $ 3189 - سلمان أبو عبد الله مولى بن الزبير يروي عن شيخ يقال له أدهم(@)(@@)(@@)(@@) $ 3190 - أبو حازم الأعرج اسمه سلمان الأشجعي مولى عزة الأشجعية عداده في أهل الكوفة يروي عن أبي هريرة روى عنه الأعمش ومنصور توفى في خلافة عمر بن عبد العزيز(@)(@@)(@@)(@@) $ 3191 - سلمان أبو شداد مولى المدنيين يروي عن أم سلمة روى عنه عبيد أبو الوسيم(@)(@@)(@@)(@@) $ 3192 - سلمان شيخ يروي عن عثمان بن عفان روى عنه ابنه عبد الرحمن بن سلمان(@)(@@)(@@)(@@) $ 3193 - سلمان بن شمير يروي عن أبي أمامة وأبي هريرة روى عنه حريز بن عثمان PageV04P333(@)(@@)(@@)(@@) $ 3194 - سلمان شيخ يروي عن عقبة بن عامر روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 3195 - سلمان الأنصاري مولى أبي سعيد الخدري يروي عن أبي سعيد الخدري روى عنه إسماعيل بن رافع(@)(@@)(@@)(@@) $ 3196 - سلمان بن زوجي يروي عن أبي هريرة روت عنه القلوص بنت عليبة(@)(@@)(@@)(@@) $ 3197 - سلمان أبو يونس يروي 
ms605	 عن أنس بن مالك روى عنه قرة بن خالد(@)(@@)(@@)(@@) $ 3198 - سلم بن بشير بن جحل بصرى يروي عن أبي هريرة روى عنه أبو عوانة إن كان سمع منه(@)(@@)(@@)(@@) $ 3199 - سلم بن عبد الرحمن يروي عن سوادة بن الربيع الجرمي وله صحبة روى عنه مرجى بن رجاء(@)(@@)(@@)(@@) $ 3200 - سلم بن يزيد يروي عن أنس بن مالك روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 3201 - سلم بن رشد يروي عن بن عمر روى عنه جرير بن عبد الحميد(@)(@@)(@@)(@@) $ 3202 - سلم بن زياد يروي عن ميمونة روى عنه عباد بن أبي موسى(@)(@@)(@@)(@@) $ 3203 - سيار بن معرور التميمي من أهل الكوفة يروي عن عمر PageV04P334 روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 3204 - سيار بن روح من أهل الشام يروي عن أصحاب رسول الله صلى الله عليه وسلم روى عنه مسلم بن زياد(@)(@@)(@@)(@@) $ 3205 - أبو المنهال اسمه سيار بن سلامة الرياحي من أهل البصرة يروي عن أبي برزة روى عنه أهل البصرة مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 3206 - سيار الشامي مولى خالد بن يزيد بن معاوية القرشي يروي عن أبي أمامة وأبي الدرداء روى عنه سليمان التيمى ثنا بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا أبي قال ثنا سيار الشامي عن أبي الدرداء أنه قرأ ولمن خاف مقام ربه جنتان قال رجل وإن زنى وإن سرق فقال أبو الدرداء إذا خاف مقام ربه لم يزن ولم يسرق(@)(@@)(@@)(@@) $ 3207 - سيار بن عبد الرحمن الصدفي من أهل مصر يروي المراسيل روى عنه سعيد بن أبى أيوب PageV04P335(@)(@@)(@@)(@@) $ 3208 - سنان بن أبي سنان الدئلي وهم حلفاء بنى دئل واسم أبي سنان يزيد بن أمية يروي عن أبي واقد الليثي وجابر وأبي هريرة روى عنه الزهري مات سنة خمس ومائة وهو بن اثنتين وثمانين سنة وكان مولده سنة ثلاث وعشرين(@)(@@)(@@)(@@) $ 3209 - سنان بن عمرو الأنصاري من بنى عمرو بن عوف ويقال سنان بن عبد الله يروي عن أنس بن مالك روى عنه حيوة بن شريح ونافع 
ms606	 بن يزيد المصريان(@)(@@)(@@)(@@) $ 3210 - سنان بن سعد الكندي يروي عن أنس بن مالك حدث عنه المصريون وهم مختلفون فيه يقولون سعد بن سنان وسعيد بن سنان وسنان بن سعيد وأرجو أن يكون الصحيح سنان بن سعد وقد اعتبرت حديثه فرأيت ما روى عن سنان بن سعد يشبه أحاديث الثقات وما روى عن سعد بن سنان وسعيد بن سنان فيه المناكير كأنهما اثنان فالله أعلم PageV04P336(@)(@@)(@@)(@@) $ 3211 - سنان بن ربيعة أبو ربيعة البصري يروي عن أنس بن مالك وهو الذي يقال له صاحب السابري روى عنه حماد بن زيد وعبد الوارث(@)(@@)(@@)(@@) $ 3212 - سنان بن أبي منصور الليثي شامي مولى واثلة بن الأسقع يروي عن واثلة بن الأسقع روى عنه أهل الشام(@)(@@)(@@)(@@) $ 3213 - سنان بن حبيب أبو حبيب السلمي يروي عن بن عمر روى عنه الثوري وإسرائيل وغيرهما(@)(@@)(@@)(@@) $ 3214 - سنان بن جرير العنسى يروي عن بن عمر روى عنه عبد الملك الذماري إن كان سمع منه(@)(@@)(@@)(@@) $ 3215 - سوار بن شبيب السعدي الأعرج من بنى سعد يروى عن بن عمر وابن مسعود روى عنه عوف الأعرابي وعكرمة بن عمار(@)(@@)(@@)(@@) $ 3216 - سوار بن الجعد يروي عن أبي الدرداء روى عنه أبو حريز(@)(@@)(@@)(@@) $ 3217 - سوار الجرمي بصرى يروي عن مالك بن الحويرث روى عنه PageV04P337 ابناه قتادة بن سوار وأنيس بن سوار الجرميان وأبو قلابة(@)(@@)(@@)(@@) $ 3218 - سوار بن حنظلة العجلاني يروي عن سمرة بن جندب روى عنه أبو هلال الراسبي(@)(@@)(@@)(@@) $ 3219 - سوار بن رزيق يروي عن الحسن بن علي روى عنه مسافر الجصاص(@)(@@)(@@)(@@) $ 3220 - سوار الكوفي يروي عن بن عباس روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 3221 - سوار أبو إدريس المرهي يروي المراسيل روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 3222 - سيف أبو الهذيل يروي عن بن عمر روى عنه مهاجر بن عبد الله العتكي(@)(@@)(@@)(@@) $ 3223 - سيف بن سبيعة قال رأيت بن عمر اشترى من رجل شيئا فقال حط لي دانقا رواه الفضل بن موسى عن سلمة بن ضب عنه هكذا قاله الشيباني وقال علي بن الحسن بن شقيق 
ms607	 عن سلمة بن ضب عن يوسف بن سبيعة عن بن عمر PageV04P338(@)(@@)(@@)(@@) $ 3224 - سيف أبو الحسن يروي عن أبي سعيد الخدري روى عنه العلاء بن خالد(@)(@@)(@@)(@@) $ 3225 - سيف المازني يروي عن عمر بن الخطاب روى عنه حميد بن مهران(@)(@@)(@@)(@@) $ 3226 - سيف شيخ يروي عن عوف بن مالك روى عنه خالد بن معدان(@)(@@)(@@)(@@) $ 3227 - سيف بن وهب أبو وهب التيمي بصرى يروي عن أبي الطفيل روى عنه ابنه علية وربعي بن عبد الله بن الجارود(@)(@@)(@@)(@@) $ 3228 - سماك بن حرب البكري من أهل الكوفة كنيته أبو المغيرة يخطىء كثيرا يروي عن جابر بن سمرة والنعمان بن بشير روى عنه الثوري وشعبة كان حماد بن سلمة يقول سمعت سماك بن حرب يقول أدركت ثمانين من أصحاب النبي صلى الله عليه وسلم ومات في آخر ولاية هشام بن عبد الملك حين ولى يوسف بن عمر على العراق وهو سماك بن حرب بن أوس بن خالد بن نزار بن معاوية بن عامر بن ذهل PageV04P339(@)(@@)(@@)(@@) $ 3229 - سماك بن الوليد الحنفي اليمامي كنيته أبو زميل يروي عن بن عباس روى عنه شعبة ومسعر وعكرمة بن عمار(@)(@@)(@@)(@@) $ 3230 - سماك بن سلمة الضبي من أهل الكوفة يروي عن بن عباس روى عنه المغيرة بن مقسم وأبو نهيك(@)(@@)(@@)(@@) $ 3231 - سمرة بن جعونة يروي عن على وابن عمر روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 3232 - سمرة بن سهم يروي عن أبي هاشم بن عتبة من أصحاب النبي صلى الله عليه وسلم روى عنه أبو وائل شقيق بن سلمة(@)(@@)(@@)(@@) $ 3233 - سمرة بن سيسن يروي عن بن عمر روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 3234 - سوادة شيخ من أهل مرو قال كنت مع بن عباس بمكة على الصفا ومعه عصا وهو يقرع بالعصا موضعا ويقول إن الدابة تسمع قرع عصاي هذه يعني دابة الأرض رواه إسحاق بن إبراهيم الحنظلي قال ثنا عمرو بن هرمز قال حدثني سوادة قال كنت مع بن عباس بمكة(@)(@@)(@@)(@@) $ 3235 - سوادة بن حنظلة القشيري من أهل البصرة يروي عن سمرة بن جندب 
ms608	 وقد سمع من علي بن أبي طالب روى عنه شعبة بن الحجاج PageV04P340(@)(@@)(@@)(@@) $ 3236 - أبو حاجب اسمه سوادة بن عاصم العنزي من أهل البصرة ربما أخطأ يروي عن الحكم بن عمرو الغفاري روى عنه سليمان التيمي وعاصم الأحول(@)(@@)(@@)(@@) $ 3237 - السرى بن كعب الأزدي يروي عن الحسين بن علي روى عنه الثوري(@)(@@)(@@)(@@) $ 3238 - سبرة بن المسيب بن نجبة الفزاري من أهل الكوفة يروي عن بن عباس روى عنه ابنه حنظلة بن سبرة(@)(@@)(@@)(@@) $ 3239 - سبرة شيخ يروي عن أنس روى عنه السدى لا أدرى من هو(@)(@@)(@@)(@@) $ 3240 - سبرة بن نخف يروي عن بن عباس روى عنه سماك بن حرب وقد قيل بن يحيى(@)(@@)(@@)(@@) $ 3241 - سميع أبو سالم السلولي من أهل الكوفة يروي عن الحسن بن علي روى عنه غالب أبو الهذيل PageV04P341(@)(@@)(@@)(@@) $ 3242 - سميع الزيات أبو صالح مولى بن عباس الهاشمي يروي عن بن عباس روى عنه الأعمش(@)(@@)(@@)(@@) $ 3243 - سميع مولى عمرو بن حريث يروي عن وابصة بن معبد روى عنه الحجاج بن أرطأة(@)(@@)(@@)(@@) $ 3244 - سميع شيخ يروي عن أبي أمامة روى عنه عمرو بن دينار المكي لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 3245 - سليط بن عبد الله بن يسار المكي يروي عن بن عمر روى عنه خالد بن أبي عمران وبشر بن صحار وهو أخو أيوب بن عبد الله بن يسار(@)(@@)(@@)(@@) $ 3246 - سليط بن سليط حجازي يروي عن عثمان بن عفان روى عنه محمد بن سيرين(@)(@@)(@@)(@@) $ 3247 - سليط بن عطية الحنفي يروي عن على وعمار بن ياسر روى عنه كليب بن منفعة(@)(@@)(@@)(@@) $ 3248 - سليط بن سعد السالمي يروي عن بن عمر روى عنه سعد بن PageV04P342(@)(@@) إسحاق بن كعب بن عجرة(@)(@@)(@@)(@@) $ 3249 - سحيم مولى بني زهرة القرشي يروي عن أبي هريرة روى عنه الزهري(@)(@@)(@@)(@@) $ 3250 - سحيم بن نوفل الأشجعي يروى عن بن مسعود عداده في أهل الكوفة روى عنه هلال بن يساف(@)(@@)(@@)(@@) $ 3251 - سحيم مولى أبي هريرة يروي عن أبي أيوب روى عكرمة بن عمار عن محمد بن أيوب عنه(@)(@@)(@@)(@@) $ 3252 - سحيم 
ms609	 يروي عن رويفع بن ثابت البلوي روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 3253 - سلامة بن سهم التيمي يروي عن على روى عنه عمر بن سويد(@)(@@)(@@)(@@) $ 3254 - سلامة العجلي شيخ يروي عن سلمان روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 3255 - سلامة الكندي شيخ يروي عن علي بن أبي طالب روى عنه نوح بن قيس الطاحي(@)(@@)(@@)(@@) $ 3256 - سهيل بن أبي جندل يروي عن بلال روى عنه مكحول(@)(@@)(@@)(@@) $ 3257 - سهيل بن هرمز يروي عن أبي هريرة قال عهد إلي رسول الله PageV04P343 صلى الله عليه وسلم ثلاثا أن لا أنام إلا على وتر وصيام ثلاثة أيام من كل شهر وركعتي الضحى روى عنه بن أخيه عبد الله بن هرمز(@)(@@)(@@)(@@) $ 3258 - سهيل بن عاصم الفقيمي أبو السوية من أهل البصرة وقد قيل قيس بن عاصم يروي عن بن عمر روى عنه عبد الملك بن بن أبي السوية(@)(@@)(@@)(@@) $ 3259 - سعدان بن عبد الله بن جابر مولى بنى عامر بن لؤي من أهل المدينة يروي عن أنس بن مالك روى عنه ابنه محمد بن سعدان(@)(@@)(@@)(@@) $ 3260 - سهم بن منجاب يروي عن العلاء بن الحضرمي في دعواته المستجابة روى عنه عبد الملك بن أخت سهم بن منجاب(@)(@@)(@@)(@@) $ 3261 - سهم بن حصين الأسدي الكوفي يروي عن أبي سعيد الخدري روى عنه عبد الله بن شريك PageV04P344(@)(@@)(@@)(@@) $ 3262 - سريع مولى عمرو بن حريث المخزومي يروي عن على وعمرو بن حريث عداده في أهل الكوفة روى عنه قطرى الخشاب وفطر بن خليفة(@)(@@)(@@)(@@) $ 3263 - سلمى بن عتاب يروي عن أبي هريرة روى عنه توبة العنبري(@)(@@)(@@)(@@) $ 3264 - سعر التميمي يروي عن على روى عنه علي بن زيد بن جدعان(@)(@@)(@@)(@@) $ 3265 - سعر بن مالك العبسي يروي عن عمر بن الخطاب روى عنه حلام بن صالح(@)(@@)(@@)(@@) $ 3266 - سمعان بن مشنج العمرى يروي عن سمرة بن جندب روى عنه الشعبي وقد قيل فيه العنزي(@)(@@)(@@)(@@) $ 3267 - سمعان المدني أبو يحيى مولى أسلم يروي عن أبي سعيد الخدري وأبي هريرة روى عنه ابناه محمد وأنيس ابني أبي يحيى وموسى بن أبي 
ms610	 عثمان PageV04P345(@)(@@)(@@)(@@) $ 3268 - سمير بن نهار يروي عن أبي هريرة روى عنه محمد بن واسع(@)(@@)(@@)(@@) $ 3269 - سمير بن معاذ يروي عن عائشة روى عنه المغيرة بن النعمان(@)(@@)(@@)(@@) $ 3270 - سفر مولى سعد بن أبي وقاص يروي عن علي أن رجلا من الأنصار دخل على النبي صلى الله عليه وسلم وعليه خاتم من حديد فقال رسول الله صلى الله عليه وسلم ما لي أرى عليك حلية أهل النار قال فاتخذه من شبه فلما أتى عرض على رسول الله صلى الله عليه وسلم قال ما لي أجد منك ريح الأصنام قال فاتخذه من ذهب فقال ما لك وعليك حلية أهل الجنة فقال كيف أصنع يا رسول الله قال اتخذه من فضة ولا تتمه مثقالا روى عنه عبد الله بن مسلم أبو طيبة المروزي(@)(@@)(@@)(@@) $ 3271 - سميط بن عمير بن جبلة السدوسي من أهل البصرة كنيته أبو عبد الله يروي عن أنس بن مالك وعمران بن حصين روى عنه عاصم الأحول ويقال سميط بن سمير(@)(@@)(@@)(@@) $ 3272 - سراج بن مجاعة بن مرارة الحنفي من أهل اليمامة يروي عن أبيه وله صحبة روى عنه ابنه هلال بن سراج PageV04P346(@)(@@)(@@)(@@) $ 3273 - سبيع السلولي يروى عن حذيفة وابن الزبير روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 3274 - سبيع بن خالد اليشكري من أهل البصرة يروي عن حذيفة روى عنه نصر بن عاصم وصخر بن بدر وعلى بن زيد ومن قال سبيعة بن خالد فقد وهم(@)(@@)(@@)(@@) $ 3275 - سواد الخزاعي يروي عن حفصة روى عنه المسيب بن رافع وسعيد بن خالد(@)(@@)(@@)(@@) $ 3276 - سواد بن رزين يروي عن الحسن بن علي روى عنه مسافر الجصاص(@)(@@)(@@)(@@) $ 3277 - سليك بن مسحل الفزاري يروي عن عمر وسعد بن أبي وقاص وحذيفة روى عنه بلال بن يحيى وحلام بن صالح(@)(@@)(@@)(@@) $ 3278 - سارية بن عبد الله يروي عن بن مسعود روى عنه سالم بن أبي الجعد(@)(@@)(@@)(@@) $ 3279 - سارية الخلجي يروي عن أنس بن مالك روى عنه PageV04P347 أبو حرزة يعقوب بن مجاهد(@)(@@)(@@)(@@) $ 3280 - السميط بن عمير يروي عن عمر بن الخطاب بأنه 
ms611	 جعل الجد أبا روى عنه عمران بن حدير ثنا عمر بن محمد الهمداني قال ثنا محمد بن أشكاب قال ثنا يزيد بن هارون قال ثنا حماد بن سلمة عن عمران بن حدير عن السميط بن عمير إن عمر بن الخطاب جعل الجد أبا(@)(@@)(@@)(@@) $ 3281 - سعيد مولى خليفة يروي عن أبي هريرة روى عنه عطاء بن أبي رباح إن كان حفظه محمد بن عبد الله بن عبيد بن عمير الليثي(@)(@@)(@@)(@@) $ 3282 - سفينة مولى أم سلمة يروي عن أم سلمة روى عنه قتاد بن دعامة(@)(@@)(@@)(@@) $ 3283 - سباع بن ثابت يروي عن أم كرز ولها صحبة روى عنه PageV04P348 أبو يزيد والد عبيد الله بن أبي يزيد(@)(@@)(@@)(@@) $ 3284 - السفر بن نسير من أهل الشام يروي عن جماعة من الصحابة روى عنه أهلها مات سنة ثلاث وستين ومائة(@)(@@)(@@)(@@) $ 3285 - سدوس بن حبيب صاحب السابري من أهل البصرة يخطىء كثيرا يروي عن أنس بن مالك روى عنه الحكم بن سنان(@)(@@)(@@)(@@) $ 3286 - سيرين أبو عمرة مولى أنس يروي عن عمر روى عنه ابناه محمد وأنس ابنا سيرين(@)(@@)(@@)(@@) $ 3287 - سقير الضبي يروي عن عمر روى عنه عمرو بن عبد الرحمن(@)(@@)(@@)(@@) $ 3288 - سقير مولى العباس بن الوليد بن عبد الملك يروي عن رجل من أصحاب النبي صلى الله عليه وسلم ثنا عبد الصمد بن سعيد بحمص قال ثنا محمد بن عوف قال ثنا أبي عوف بن محمد قال ثنا سقير مولى العباس بن الوليد قال سمعت الهدار صاحب رسول الله صلى الله عليه وسلم ورأى PageV04P349 العباس أكل خبز السميذ فقال توفي رسول الله صلى الله عليه وسلم ولم يشبع من خبز بر حتى لحق الله جل وتعالى(@)(@@)(@@)(@@) $ 3289 - سقير البصري يروي عن بن عمر روى عنه ابنه بكار بن سقير النميري(@)(@@)(@@)(@@) $ 3290 - سوقة البزاز من أهل الكوفة يروي عن عمرو بن حريث روى عنه ابنه محمد بن سوقة(@)(@@)(@@)(@@) $ 3291 - سعوة بن حيدان المهري من أهل مصر يروي عن عبد الله بن عمرو روى عنه ابنه عبد الرحمن بن سعوة 
ms612	(@)(@@)(@@)(@@) $ 3292 - السجف يروي عن معاذ بن جبل روى عنه حاتم بن أبي صغيرة(@)(@@)(@@)(@@) $ 3293 - ساعدة بن حرام بن محيصة يروي المراسيل روى عنه بشير بن يسار(@)(@@)(@@)(@@) $ 3294 - سيابة السلمي يروي المراسيل روى عنه عمرو بن سعيد(@)(@@)(@@)(@@) $ 3295 - سندر بن أبي سندر أبو الأسود يروي المراسيل روى عنه الزهري(@)(@@)(@@)(@@) $ 3296 - سحامة بن عبد الرحمن بن الأصم يروي عن أنس بن مالك PageV04P350 روى عنه محمد بن ربيعة والعقدي(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 3297 - سعدى المرية امرأة طلحة بن عبيد الله تروي عن عمر بن الخطاب وطلحة بن عبيد الله روى عنها ابنها يحيى بن طلحة بن عبيد الله(@)(@@)(@@)(@@) $$ 3298 - سائبة مولاة الفاكهة بن المغيرة تروي عن عائشة روى عنها نافع مولى بن عمر(@)(@@)(@@)(@@) $$ 3299 - سلمى بنت كعب أخت ناجية بن كعب تروي عن عائشة ثنا الحميدي قال ثنا قتيبة بن سعيد قال ثنا أبو عوانة عن زهير بن أبي ثابت عن سلمى بنت كعب أخت ناجية قالت خرجنا حاجين فوجدت خاتما من ذهب فجعلته في يدي فسألت عائشة فقالت عرفيه فإن عرف فرديه وابن لم يعرف فاستمتعي به(@)(@@)(@@)(@@) $$ 3300 - سلمى امرأة أبي رافع تروي عن أبي رافع روى عنها القعقاع بن حكيم PageV04P351(@)(@@)(@@)(@@) $$ 3301 - سكينة بنت الحسين بن علي بن أبي طالب ماتت بالمدينة سنة سبع عشرة ومائة تروي عن أهل بيتها روى عنها أهل الكوفة(@)(@@)(@@)(@@) $$ 3302 - سلمى عمة يعلى قالت سمعت عبد الله بن عمرو يقول ركعة بالليل فضل من عشر ركعات بالنهار روى عنها يعلى بن عطاء(@)(@@)(@@)(@@) $$ 3303 - سرية بنت زيد بن أرقم قالت سمعت عليا يقول والذي فلق الحبة وبرأ النسمة ما قتلت عثمان ولا مالأت على قتله روى عنها حصين بن عبد الرحمن الحارثي(@)(@@)(@@)(@@) || (باب الشين)(@)(@@) قال أبو حاتم وممن روى عن أصحاب رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الشين(@)(@@)(@@)(@@) $ 3304 - شريح بن الحارث القاضي الكندي حليف لهم من بنى رائش كنيته أبو أمية وقد قيل أبو عبد الرحمن كان قائفا وكان شاعرا وكان قاضيا يروي عن عمر 
ms613	 بن الخطاب روى عنه الشعبي مات سنة سبع وثمانين وهو بن مائة سنة وعشر سنين وقد قيل إنه مات سنة ثمان وسبعين وهو بن مائة وعشرين سنة وكان قد بقى على القضاء خمسا PageV04P352(@)(@@) وسبعين سنة ما تعطل فيها إلا ثلاث سنين في فتنة بن الزبير(@)(@@)(@@)(@@) $ 3305 - شريح بن هانئ بن يزيد بن كعب الحارثي من أهل اليمن عداده في أهل الكوفة يروي عن على وعائشة روى عنه ابنه المقدام بن شريح قتل بسجستان سنة ثمان وسبعين وكان في جيش بن أبي بكرة(@)(@@)(@@)(@@) $ 3306 - شريح بن عبيد الحضرمي الشامي المقرىء كنيته أبو الصلت يروي عن فضالة بن عبيد ومعاوية بن أبي سفيان روى عنه صفوان بن عمرو السكسكي وأهل الشام(@)(@@)(@@)(@@) $ 3307 - شريح بن أرطاة يروي عن عائشة روى عنه الحكم بن عتيبة(@)(@@)(@@)(@@) $ 3308 - شريح أبو أمية يروي عن على وليس بالقاضي روى عنه أبو مكين(@)(@@)(@@)(@@) $ 3309 - شريح بن النعمان الصائدي من أهل الكوفة يروي عن على روى عنه بن اشوع PageV04P353(@)(@@)(@@)(@@) $ 3310 - شريح الهمداني يروي عن سعد بن أبي وقاص روى عنه أبو عون الثقفي محمد بن عبيد الله(@)(@@)(@@)(@@) $ 3311 - شريح بن سعيد يروي عن النواس بن سمعان روى عنه خالد بن معدان(@)(@@)(@@)(@@) $ 3312 - شقيق بن سلمة أبو وائل الأسدي أدرك النبي صلى الله عليه وسلم وليست له صحبة وكانت أمه نصرانية سكن الكوفة وكان من عبادها وكان له خص يكون فيه هو وفرسه فإذا غزا نقضه وإذا رجع أعاده وكان عاصم بن أبي النجود يقول مررت يوما مع أبي وائل في السوق فسمع الناس يقولون دانق وقيراط فقال لي يا عاصم أيهما أكثر قلت الدانق قال ما أدري يروي عن عمر وعبد الله روى عنه منصور والأعمش مات بعد الجماجم وكان مولده سنة إحدى من الهجرة(@)(@@)(@@)(@@) $ 3313 - شقيق بن ثور السدوسي أبو الفضل من أهل البصرة يروى عن PageV04P354 عثمان روى عنه السميط مات سنة أربع وستين بعد موت يزيد بن معاوية(@)(@@)(@@)(@@) $ 3314 - شقيق بن أبي عبد الله مولى آل الحضرمي من 
ms614	 أهل الكوفة يروي عن أنس روى عنه وكيع وأبو نعيم(@)(@@)(@@)(@@) $ 3315 - شقيق بن العيزار الكوفى يروي عن بن عمر روى عنه الزبير بن عدى(@)(@@)(@@)(@@) $ 3316 - شقيق بن عقبة العبدي يروي عن البراء روى عنه الأسود بن قيس(@)(@@)(@@)(@@) $ 3317 - شعيب بن الحبحاب الأسدي الأزدي المعولي من أهل البصرة كنيته أبو صالح يروي عن أنس بن مالك روى عنه شعبة وأهل البصرة مات سنة ثلاثين أو إحدى وثلاثين ومائة بداء يقال له الحميرا(@)(@@)(@@)(@@) $ 3318 - شعيب بن يسار مولى بن عباس يروي عن عمر بن الخطاب روى عنه مساور الوراق(@)(@@)(@@)(@@) $ 3319 - شعيب بن رزيق الثقفي الطائفي يروي عن الحكم بن حزن PageV04P355 الكلفي وللحكم صحبة روى عنه شهاب بن خراش الحوشبي(@)(@@)(@@)(@@) $ 3320 - شعيب شيخ يروي عن بن مسعود روى عنه أبو قبيل(@)(@@)(@@)(@@) $ 3321 - شعيب بن أبي سعيد أبو يونس يروي عن أبي هريرة روى عنه حيوة بن شريح ويقال كنيته أبو بشر(@)(@@)(@@)(@@) $ 3322 - شعيب بن عمرو الأموي من بنى أمية بن زيد الأنصاري يروي عن أبي هريرة روى عنه الدراوردي(@)(@@)(@@)(@@) $ 3323 - شعيب بن زرعة يروي عن عقبة بن عامر روى عنه بكر بن عمرو(@)(@@)(@@)(@@) $ 3324 - شعيب بن عمرو بن صهيب بن سنان يروي عن جده صهيب روى عنه يوسف بن محمد(@)(@@)(@@)(@@) $ 3325 - شعيب بن كيسان السمان يروي عن أنس بن مالك روى عنه عمر بن عبيد الطنافسي(@)(@@)(@@)(@@) $ 3326 - شعيب بن خالد الخثعمي يروي عن بن عمر روى عنه عثمان بن أبي سليمان PageV04P356(@)(@@)(@@)(@@) $ 3327 - شعيب بن محمد بن عبد الله بن عمرو ويقال أن شعيب بن محمد سمع جده وليس ذلك عندي بصحيح روى عنه ابنه عمرو بن شعيب(@)(@@)(@@)(@@) $ 3328 - شعيب بن العلاء يروي عن أبي هريرة روى عنه عصام بن طليق(@)(@@)(@@)(@@) $ 3329 - شعيب بياع الأنماط يروي عن على روى عنه بن أبي غنية(@)(@@)(@@)(@@) $ 3330 - شداد بن عبد الله القرشي الدمشقي الأموي مولى معاوية بن أبي سفيان كنيته أبو عمار يروي عن أبي أمامة وواثلة بن الأسقع روى عنه الأوزاعي وعكرمة بن عمار(@)(@@)(@@)(@@) $ 3331 - شداد 
ms615	 بن معقل الأسدي يروي عن بن مسعود عداده في أهل الكوفة روى عنه عبد العزيز بن رفيع والمسيب بن رافع(@)(@@)(@@)(@@) $ 3332 - شداد بن عبد الرحمن أبو روبة القشيري يروي عن أبي سعيد الخدري روى عنه أبو حنيفة وقد قيل شداد بن عمران PageV04P357(@)(@@)(@@)(@@) $ 3333 - شداد أبو قادم البصري الجريري ولد في اليوم الذي توفى فيه رسول الله صلى الله عليه وسلم روى عبد الصمد بن عبد الوارث عن عبد السلام عنه لا أدرى من عبد السلام(@)(@@)(@@)(@@) $ 3334 - شداد بن عمارة يروي عن حذيفة روى عنه عبيد بن الطفيل(@)(@@)(@@)(@@) $ 3335 - شداد بن الأزمع الوادعي من أهل الكوفة أخو الحارث بن الأزمع يروي عن بن مسعود روى عنه علي بن الأقمر مات في ولاية بشر بن مروان على العراق(@)(@@)(@@)(@@) $ 3336 - شداد بن عمران التغلبي أبو روبة يروي عن حذيفة روى عنه يزيد بن عبد الله الشيباني وجامع بن مطر وليس هذا بأبي روبة الذي روى عنه أبو حنيفة(@)(@@)(@@)(@@) $ 3337 - شداد مولى عياض بن عامر يروي عن أبي هريرة ووابصة بن معبد روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 3338 - شداد بن الأفلح المقرإى من أهل الشام يروي عن عمرو البكالي روى عنه أهل الشام PageV04P358(@)(@@)(@@)(@@) $ 3339 - شداد أبو بديل شهد صفين روى عنه ابنه بديل بن شداد(@)(@@)(@@)(@@) $ 3340 - شبيب بن نعيم أبو روح الحمصي يروي عن أبي هريرة روى عنه حريز بن عثمان وهو الذي يقال له شبيب بن أبي روح واسم أبي روح نعيم(@)(@@)(@@)(@@) $ 3341 - شبيب بن غرقدة السلمي البارقي الكوفي يروي عن عروة البارقي روى عنه الثوري وشعبة(@)(@@)(@@)(@@) $ 3342 - شبيب بن أبي رياح الباهلي يروي عن أبي أمامة روى عنه عبد الملك بن عمير وعمر بن ذر حدثنا أبو يعلى قال ثنا عبد الله بن عمر بن أبان قال ثنا عبد الرحيم بن سليمان عن عمر بن ذر قال سمعت شبيبا الباهلي قال سمعت أبا أمامة يحدث عن رسول الله صلى الله عليه وسلم أنه قال ما من امرء مسلم تحضره صلاة مكتوبة فتوضأ 
ms616	 عندها فأحسن الوضوء ثم صلى فأحسن الصلاة إلا غفر له ما كان بينها وبين الصلاة التي كانت قبلها من ذنوب(@)(@@)(@@)(@@) $ 3343 - شبيب بن بشر البجلي يروي عن أنس بن مالك يخطىء كثيرا روى عنه أبو عاصم النبيل وإسرائيل PageV04P359(@)(@@)(@@)(@@) $ 3344 - شريك بن عبد الله بن أبي نمر القرشي من أهل المدينة ربما أخطأ وأبو نمر جده شهد بدرا يروي عن أنس روى عنه المقبري ومالك وسليمان بن بلال والناس مات بعد الأربعين ومائة كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3345 - شريك بن حنبل من أهل الكوفة يروي عن على روى عنه أبو إسحاق وعمرو بن تميم ومن قال إنه شريك بن شرحبيل فقد وهم(@)(@@)(@@)(@@) $ 3346 - شريك بن نميلة كوفي يروى عن بن عمر وعلى روى عنه أهل الكوفة وقد قيل بن نملة(@)(@@)(@@)(@@) $ 3347 - شريك بن شهاب الحارثي يروي عن أبي برزة روى عنه الأزرق بن قيس(@)(@@)(@@)(@@) $ 3348 - شريك بن شريك يروي عن عبد الله بن عمرو روى عنه قتادة PageV04P360(@)(@@)(@@)(@@) $ 3349 - شريك بن خباشة النميري يروي عن عمر بن الخطاب روى عنه إبراهيم بن أبي عبلة حدثنا بن قتيبة ثنا إبراهيم بن محمد بن يوسف المقدسي قال ثنا زهير بن عباد قال ثنا رديح بن عطية عن إبراهيم بن أبي عبلة عن شريك بن خباشة النميري أنه ذهب يستسقي من جب سليمان الذي في بيت المقدس فانقطع دلوه فنزل الجب ليخرجه فبينما هو يطلبه في نواحي الجب إذ هو بشجرة فتناول ورقة من الشجرة فأخرجها معه فإذا هي ليس من شجر الدنيا فأتى بها عمر بن الخطاب فقال أشهد أن هذا هو الحق سمعت رسول الله صلى الله عليه وسلم يقول يدخل من هذه الأمة رجل الجنة قبل موته فجعل الورقة بين دفتي المصحف(@)(@@)(@@)(@@) $ 3350 - شريك بن خليفة الدوسي التميمي كان يروي عن عبد الله بن عمرو كان من الأزارقة روى عنه قتادة(@)(@@)(@@)(@@) $ 3351 - شريك بن نهيك الخولاني يروي عن أبي الدرداء روى عنه صفوان بن عمرو(@)(@@)(@@)(@@) $ 3352 - شريك بن أرطأة الكلابي العامري من 
ms617	 أهل الكوفة كنيته PageV04P361 أبو عبد الله يروي عن على وحذيفة روى عنه ابنه عبد الله بن شريك(@)(@@)(@@)(@@) $ 3353 - شعبة بن التوءم التميمي يروي عن بن مسعود وقيس بن عاصم وروى المغيرة بن مقسم عن أبيه عنه(@)(@@)(@@)(@@) $ 3354 - شعبة بن عمرو شيخ يروي عن أنس بن مالك في حديثه مناكير كثيرة روى عنه الخليل بن مرة البلية في أخباره من الخليل بن مرة قد ذكرنا الخليل في كتاب الضعفاء بأسبابه وما يجب الوقوف على أنبائه(@)(@@)(@@)(@@) $ 3355 - شهاب بن شريك يروي عن أبي برزة روى عنه الأزرق بن قيس(@)(@@)(@@)(@@) $ 3356 - شهاب بن عباد العصري يروي عن بن عباس وابن عمر روى عنه يحيى بن شهاب(@)(@@)(@@)(@@) $ 3357 - شهاب البارقي يروي عن على روى عنه بن عيينة والجراح بن مليح(@)(@@)(@@)(@@) $ 3358 - شهاب بن عبد الله الخولاني من أهل اليمن يروي عن عمر PageV04P362(@)(@@) روى عنه سماك بن الفضل وليث بن أبي سليم(@)(@@)(@@)(@@) $ 3359 - شهاب بن مدلج العنبري التميمي بصرى يروى عن بن عباس وأبي موسى روى عنه ابنه حبيب بن شهاب(@)(@@)(@@)(@@) $ 3360 - شهاب شيخ يروي عن أبي هريرة روت عنه القلوص بنت عليبة لا أدرى من هو(@)(@@)(@@)(@@) $ 3361 - شرحبيل بن مسلم بن حامد الخولاني من أهل اليمن عداده في أهل الشام اختتن في ولاية عبد الملك يروي عن أبي أمامة وعبد الله بن بسر وقد أدرك خمسة من أصحاب رسول الله صلى الله عليه وسلم روى عنه بن عياش وأهل الشام(@)(@@)(@@)(@@) $ 3362 - شرحبيل بن معشر العنسي من أهل الشام يروي عن معاذ بن جبل روى عنه صفوان بن عمرو وابنه عمرو بن شرحبيل(@)(@@)(@@)(@@) $ 3363 - شرحبيل بن سعد بن أبي وقاص يروي عن أبيه عداده في PageV04P363 أهل المدينة روى عنه أهلها(@)(@@)(@@)(@@) $ 3364 - شرحبيل بن سعد بن عبادة الخزرجي يروي عن أبيه روى عنه ابنه عمرو بن شرحبيل(@)(@@)(@@)(@@) $ 3365 - شرحبيل أبو سعد يروي عن بن عباس روى عنه فطر بن خليفة وهو الذي يروي عنه يزيد بن عبد الله بن الهاد(@)(@@)(@@)(@@) $ 3366 - شرحبيل بن السمط الكندي يروي 
ms618	 عن سلمان وعبادة بن الصامت روى عنه بلال العبسي ومكحول وهو شرحبيل بن السمط بن الأسود بن جبلة بن عدي بن ربيعة بن معاوية من كندة(@)(@@)(@@)(@@) $ 3367 - شرحبيل بن شفعة العنسي الشامي الرحبي كنيته أبو يزيد يروي عن عمرو بن العاص وعتبة بن عبد السلمي روى عنه حريز بن عثمان(@)(@@)(@@)(@@) $ 3368 - شرحبيل بن عوف الأحمسي يروي عن علي وعبد الله روى عنه أهل الكوفة PageV04P364(@)(@@)(@@)(@@) $ 3369 - شرحبيل بن أيمن يروي عن أبي الدرداء روى عنه أهل الشام(@)(@@)(@@)(@@) $ 3370 - شرحبيل بن سعد الخطمي الأنصاري مولى لهم المدني كنيته أبو سعد يروي عن زيد بن ثابت وجابر وأبي سعيد روى عنه يحيى بن سعيد الأنصاري ومالك بن أبي ذئب مات سنة ثلاث وعشرين ومائة(@)(@@)(@@)(@@) $ 3371 - شرحبيل بن القعقاع قال سمعت عمرو بن معدى كرب يقول علمنا رسول الله صلى الله عليه وسلم أن نقول لبيك اللهم لبيك لبيك لا شريك لك لبيك إن الحمد والنعمة لك والملك لا شريك لك رواه عمرو بن شمر أبو شمر عن أبي طلق عن شرحبيل بن القعقاع لست أعرف أبا طلق هذا من هو وعمرو بن شمر كان رافضيا يكذب والخبر ما أراه بمحفوظ عنه(@)(@@)(@@)(@@) $ 3372 - شرحبيل رجل من الموالي يروي عن عمر روى عنه طلحة بن صالح(@)(@@)(@@)(@@) $ 3373 - أبو الأشعث الصنعاني اسمه شراحيل بن شرحبيل PageV04P365 بن كليب بن آدة من صنعاء الشام يروي عن ثوبان وعبادة بن الصامت روى عنه أبو قلابة ومن قال شراحيل بن آدة فقد نسبه إلى جده وكان من الأبناء سكن صنعاء الشام وكتب عنه الناس بدمشق مات في ولاية معاوية(@)(@@)(@@)(@@) $ 3374 - شراحيل بن بلال الخولاني يروي عن بن عمر روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 3375 - شراحيل بن معن يروي عن فضالة بن عبيد روى عنه شرحبيل بن مسلم(@)(@@)(@@)(@@) $ 3376 - شراحيل شيخ يروي عن أبي هريرة وأبي برزة روى عنه هشام بن سعيد بن زيد بن أبي زيد الأنصاري(@)(@@)(@@)(@@) $ 3377 - شيبان بن حريث يروي عن عبد الله بن عمرو روى عنه 
ms619	 أبو إسحاق السبيعي PageV04P367(@)(@@)(@@)(@@) $ 3378 - شيبان بن قحذم يروي عن على روى عنه ميمون بن مهران وقد قيل شيبان بن محزم(@)(@@)(@@)(@@) $ 3379 - شيبان اليشكري شيخ يروي عن أنس بن مالك روى عنه عطية بن بهرام(@)(@@)(@@)(@@) $ 3380 - شيبان شيخ يروي عن عدى بن حاتم روى عنه محمد بن إسحاق بن يسار إن كان سمع منه(@)(@@)(@@)(@@) $ 3381 - شمر بن يقظان أبو عبلة الشامي يروي عن عوف بن مالك روى عنه ابنه إبراهيم بن أبي عبلة PageV04P367(@)(@@)(@@)(@@) $ 3382 - شمر بن جعونة يروي عن بن عمر روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 3383 - شريق الهوزني قال دخلت على عائشة فسألتها بم كان رسول الله صلى الله عليه وسلم يفتتح إذا هب من الليل فقالت كان إذا هب من الليل كبر عشرا وحمد الله عشرا وقال سبحان الله وبحمده عشرا وقال سبحان القدوس عشرا واستغفر عشرا وهلل الله عشرا وقال اللهم إني أعوذ بك من ضيق الدنيا وضيق يوم القيامة عشرا رواه بقية بن الوليد عن عمر بن جعثم عن الأزهر بن عبد الله الحرازي عن شريق الهوزني(@)(@@)(@@)(@@) $ 3384 - شيبة بن نصاح القارىء من أهل المدينة يروي عن أبيه أبوه مولى أم سلمة روى عنه أهل المدينة مات في ولاية مروان بن محمد وقد قيل إنه سمع من أم سلمة وهو صغير(@)(@@)(@@)(@@) $ 3385 - شجاع أبو طيبة يروي عن بن عمر روى عنه السرى بن يحيى(@)(@@)(@@)(@@) $ 3386 - شبيل بن عوف بن أبي حية الأحمسي كنيته أبو الطفيل أدرك الجاهلية وشهد القادسية مع سعد عداده في أهل الكوفة روى عنه إسماعيل بن أبي خالد PageV04P368(@)(@@)(@@)(@@) $ 3387 - شبيل بن عزرة الضبعي ختن قتادة ربما أخطأ يروي عن أنس بن مالك روى عنه شعبة والبصريون(@)(@@)(@@)(@@) $ 3388 - شوذب المدني مولى زيد بن ثابت يروي عن زيد بن ثابت روى عنه قدامة بن موسى(@)(@@)(@@)(@@) $ 3389 - شوذب أبو معاذ ويقال أبو عثمان يروي عن البراء بن عازب روى عنه الثوري(@)(@@)(@@)(@@) $ 3390 - الشريد الصدفي الثقفي يروي عن أبي هريرة روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 3391 - شماس 
ms620	 بن لبيد يروي عن بن مسعود روى عنه سعيد بن مسروق(@)(@@)(@@)(@@) $ 3392 - شماس مولى بن عباس يروي عن بن عمر روى عنه ابنه عثمان بن شماس(@)(@@)(@@)(@@) $ 3393 - شييم بن زنيم أبو مريم البكري يروي عن عمر بن الخطاب روى عنه سماك بن حرب وقد قيل بن ذييم(@)(@@)(@@)(@@) $ 3394 - شييم بن بيتان البلوى عداده في أهل مصر يروي عن رويفع بن ثابت البلوي روى عنه عياش بن عباس القتباني PageV04P369(@)(@@)(@@)(@@) $ 3395 - شمير بن عبد المدان يروي عن أبيض بن جمال المازني روى عنه سمى بن قيس في أقطاع النبي صلى الله عليه وسلم الملح(@)(@@)(@@)(@@) $ 3396 - شمير القيسي يروي عن بن عباس روى عنه شيخ يقال له عكير(@)(@@)(@@)(@@) $ 3397 - شتير بن شكل بن حميد العبسي من أهل الكوفة يروي عن على وابن مسعود روى عنه الشعبي وأهل الكوفة مات في ولاية بن الزبير(@)(@@)(@@)(@@) $ 3398 - شتير بن نهار يروي عن بن هريرة في حسن الظن روى عنه محمد بن واسع(@)(@@)(@@)(@@) $ 3399 - شويس بن جياش العدوى من أهل البصرة يروي عن عتبة بن غزوان كنيته أبو الرقاد روى عنه أبو نعامة وأبو مرحوم PageV04P370(@)(@@)(@@)(@@) $ 3400 - شفى بن مانح الأصبحي ويقال ماتع يروي عن عبد الله بن عمرو وأبي هريرة كنيته أبو سهل عداده في أهل مصر روى عنه أهلها(@)(@@)(@@)(@@) $ 3401 - شبث بن ربعي من بنى يربوع بن حنظلة التميمي يروي عن على وحذيفة روى عنه محمد بن كعب القرظي يخطىء(@)(@@)(@@)(@@) $ 3402 - شبل بن خليد المزني يروي عن عبد الله بن مالك الأوسي روى عنه عبيد الله بن عبد الله والزهري(@)(@@)(@@)(@@) $ 3403 - شفعة السمعي يروي عن عبد الله بن عمرو روى عنه شرحبيل بن مسلم(@)(@@)(@@)(@@) $ 3404 - شبر بن علقمة العبدي من أهل الكوفة يروي عن بن مسعود روى عنه الأسود بن قيس حدثنا محمد بن أحمد بن أبي عون ثنا علي بن حجر ثنا سفيان عن الأسود بن قيس عن شبر بن علقمة قال بارزت رجلا يوم القادسية فقتلته فبلغ سلبه اثني عشر ألفا فنفلنيه سعد(@)(@@)(@@)(@@) $ 3405 