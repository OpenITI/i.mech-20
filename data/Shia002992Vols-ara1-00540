ms525	 8، ب 66، ح 3.(@)(@@) وروى عنه علي بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 154، ح 3.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 4، ك 1، ب 7، ح 12، و ج 5، ك 2، ب 14، ح 2، وب 159، ح 30.(@)(@@) وروى عنه علي بن محمد بن بندار وغيره. PageV02P275(@)(@@) الكافي: ج 6، ك 6، ب 53، ح 7.(@)(@@) * وروى عن محمد بن عيسى وغيره، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 120، ح 4.(@)(@@) * وروى عن محمد بن عيسى أو غيره، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 114، ح 5، و ب 115، ح 1.(@)(@@) * وروى عن محمد بن عيسى اليقطيني.(@)(@@) التهذيب: ج 9، ح 399، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 21، ح 7.(@)(@@) وروى عن محمد بن موسى بن فرات وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 48، ح 10.(@)(@@) وروى عن منصور بن العباس، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 80، ح 4، وك 8، ب 64، ح 5.(@)(@@) * وروى عن موسى بن القاسم، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 149، ح 2، و ج 6، ك 8، ب 9، ح 6، وب 41، ح 3، و 12، و ب 55، ح 3.(@)(@@) وروى عنه علي بن محمد.(@)(@@) الكافي: ج 4، ك 1، ب 26، ح 5.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 53، ح 11.(@)(@@) * وروى عن نوح بن شعيب، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 106، ح 20، و ج 6، ك 6، ب 74، ح 2، وب 87، ح 2، و ك 8، ب 52، ح 7، وب 64، ح 4.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 48، ح 8.(@)(@@) وروى عنه علي بن محمد بن بندار، وغيره.(@)(@@) الكافي: ج 1، ك 6، ب 84، ح 8.(@)(@@) وروى عن نوح بن شعيب النيسابوري، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 115، ح 2.(@)(@@) * وروى عن يحيى بن إبراهيم بن أبي البلاد وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 66، ح 10، و ج 6، ك 8، ب 16، ح 4.(@)(@@) وروى عنه علي بن محمد بن عبد الله.(@)(@@) الكافي: ج 4، ك 1، ب 41، ح 5.(@)(@@) * وروى عن يعقوب بن يزيد. PageV02P276(@)(@@) التهذيب: ج 6، ح 357.(@)(@@) وروى عنه عدة من أصحابنا. 
ms526	(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 6، وك 4، ب 26، ح 4، و ج 5، ك 1، ب 28، ح 11، و ج 6، ك 6، ب 80، ح 3، وب 97، ح 20، وب 102، ح 9، وب 126، ح 3، وك 7، ب 5، ح 3، وب 7، ح 6، وك 8، ب 48، ح 14، وب 52، ح 6، و ج 7، ك 1، ب 36، ح 5. والتهذيب: ج 9، ح 75.(@)(@@) وروى عنه علي بن محمد بن عبد الله.(@)(@@) الكافي: ج 4، ك 1، ب 16، ح 3.(@)(@@) * وروى عن يعقوب بن يزيد وغيره، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 13، ح 1.(@)(@@) * وروى عن الجاموراني وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 2، ب 42، ح 3، وك 3، ب 10، ح 5، وب 152، ح 2، و ج 6، ك 4، ب 15، ح 2.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 4، ك 2، ب 65، ح 5.(@)(@@) * وروى عن العرزمي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 3، ك 3، ب 3، ح 5.(@)(@@) * وروى عن العوسي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 19، ح 2.(@)(@@) * وروي عن النوفلي.(@)(@@) التهذيب: ج 6، ح 240.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 42، ح 8.(@)(@@) والتهذيب: ج 4، ح 322.(@)(@@) * وروى مضمرة، وروى عنه علي ابن محمد.(@)(@@) الكافي: ج 7، ك 4، ب 18، ح 4.(@)(@@) * وروى مرفوعة إلى أمير المؤمنين عليه السلام.(@)(@@) التهذيب: ج 6، ح 546.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 34، ح 11، و ج 7، ك 2، ب 36، ح 6، وك 6، ب 9 ح 5.(@)(@@) * وروى مرفوعة إلى أبي عبد الله عليه السلام.(@)(@@) التهذيب: ج 6، ح 904.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 18، ح 2.(@)(@@) وروى عنه علي بن إبراهيم.(@)(@@) الكافي: ج 3، ك 4، ب 75، ح 10، و ج 6، ك 8، ب 45، ح 10.(@)(@@) * وروى عن بعض أصحابنا عن أبي PageV02P277(@)(@@) جعفر عليه السلام وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 5، ك 2، ب 124، ح 5.(@)(@@) * وروى عن بعض أصحابنا عن جابر الجعفي. وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 18، ح 6.(@)(@@) * وروى عن بعض أصحابنا عن علي ابن أسباط.(@)(@@) التهذيب: ج 2، ح 472.(@)(@@) * وروى عن بعض أصحابنا عن مبارك غلام العقرقوفي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 19، ح 3.(@)(@@) * وروى عن بعض أصحابنا عن الأصم، وروى 
ms527	 عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 112، ح 8.(@)(@@) * وروى عن بعض أصحابنا مرفوعا إلى النبي صلى الله عليه وآله، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 252، ح 6، و ج 5، ك 3، ب 16، ح 4. والتهذيب: ج 7، ح 1606.(@)(@@) * وروى عن بعض أصحابنا مرفوعا مضمرة، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 47، ح 3.(@)(@@) * وروى عن بعض أصحابه عن ابن أخت الأوزاعي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 62، ح 2.(@)(@@) * وروى عن بعض أصحابه عن حنان بن سدير، وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 6، ك 6، ب 114، ح 7.(@)(@@) * وروى عن بعض أصحابه عن زرارة، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 58، ح 6.(@)(@@) * وروى عن بعض أصحابه عن صالح بن عقبة، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 94، ح 3.(@)(@@) * وروى عن بعض أصحابه عن صفوان الجمال، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 4، ح 3.(@)(@@) * وروى عن بعض أصحابه عن عثمان بن عيسى.(@)(@@) التهذيب: ج 6، ح 311.(@)(@@) * وروى عن بعض أصحابه عن علي ابن أسباط، وروى عنه عدة من PageV02P278(@)(@@) أصحابنا الكافي: ج 6، ك 8، ب 31، ح 5، وب 35، ح 9.(@)(@@) * وروى عن بعض أصحابه عن محمد بن المثنى الحضرمي، وروى عنه عدة من أصحابنا الكافي: ج 2، ك 1، ب 106، ح 10.(@)(@@) * وروى عن بعض أصحابه مرفوعا إلى رسول الله صلى الله عليه وآله.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 6، ح 1.(@)(@@) * وروى عن بعض أصحابه مرفوعا إلى أمير المؤمنين عليه السلام.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 114، ح 8.(@)(@@) * وروى عن بعض أصحابه مرفوعا إلى أبي جعفر عليه السلام.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 68، ح 8.(@)(@@) * وروى عن بعض أصحابه مرفوعا إلى أبي عبد الله عليه السلام.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 120، ح 12، و ب 121، ح 13.(@)(@@) * وروى عن بعض أصحابه عن إبراهيم بن عقبة، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 46، ح 4.(@)(@@) * وروى عن بعض العراقيين عن 
ms528	 إبراهيم بن عقبة.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 34، ح 6.(@)(@@) * وروى عن بعض العراقيين عن محمد بن المثنى، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 14.(@)(@@) * وروى عن بعض العراقيين عن محمد بن المثنى الحضرمي، وروى عنه عدة من أصحابنا، الكافي: ج 2، ك 1، ب 35، ح 2.(@)(@@) * وروى عن بعض من رواه، عن أبي عبد الله عليه السلام. وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 132، ح 11.(@)(@@) * وروى عن بعض من رواه، عن أبي الحسن عليه السلام، وروى عنه علي بن الحسين.(@)(@@) التهذيب: ج 3، ح 247.(@)(@@) * وروى عن بعض من ذكره عن محمد بن سنان، وروى عنه عدة من PageV02P279(@)(@@) أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 19، ح 4.(@)(@@) * وروى عن رجل عن جميل، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 55، ح 1.(@)(@@) * وروى عن عدة من أصحابنا عن الحسن بن علي بن يوسف، وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 1، ب 35، ح 7، والتهذيب: ج 8، ح 391.(@)(@@) * وروى عدة من أصحابنا عن علي ابن أسباط وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 48، ح 18.(@)(@@) وروى عنه علي بن بندار.(@)(@@) الكافي: ج 6، ك 7، ب 23، ح 9.(@)(@@) * وروى عن عدة من أصحابه عن علي بن أسباط.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 59، ح 13، و ج 6، ك 6، ب 82، ح 9، وب 103، ح 7، ك 8، ب 31، ح 5، وك 9، ب 2، ح 19.(@)(@@) * وروى عن عدة من أصحابه عن يونس بن يعقوب، وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 32، ح 4.(@)(@@) * وروى عن غير واحد عن أبي جميلة، وروى عنه غير واحد من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 1، ح 11.(@)(@@) * وروى عن غير واحد عن زياد القندي.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 68، ح 21.(@)(@@) * وروى عن غير واحد من أصحابه عن علي بن أسباط.(@)(@@) التهذيب: ج 7، ح 40، وروى عنه أحمد ابن عبد الله.(@)(@@) الكافي: ج 5، ك 2، ب 59، ح 3.(@)(@@) * وروى هو وغيره مضمرة.(@)(@@) التهذيب: ج 10، ح 832.(@)(@@) * وروى هو 
ms529	 أو غيره مرسلة عن النبي صلى الله عليه وآله.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 174، ح 2.(@)(@@) أحمد بن أبي عبد الله البرقي * روى عن أبيه محمد بن خالد.(@)(@@) وروي عنه أحمد حفيده. PageV02P280(@)(@@) المشيخة: في طريقه إلى محمد بن مسلم الثقفي.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) المشيخة: في طريقه إلى عبد الله بن أبي يعفور: والى علي بن عبد العزيز والى عمرو بن قيس الماصر. التهذيب: ج 6، ح 709، (والاستبصار: ج 3، ح 77).(@)(@@) وروى عنه سعد بن عبد الله وعبد الله ابن جعفر الحميري.(@)(@@) المشيخة: في طريقه إلى حكم بن حكيم ابن أخي خلاد.(@)(@@) وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى الحسن الصيقل وإلى الحسن بن زياد، وإلى سعيد النقاش وإلى الفضيل بن يسار، وإلى عمرو بن شمر وإلى عبد الله بن حماد الأنصاري، وإلى النعمان بن سعيد.(@)(@@) وروى عنه علي ماجيلويه.(@)(@@) المشيخة: في طريقه إلى إسماعيل بن رباح.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) المشيخة: في طريقه إلى أيوب بن الحر.(@)(@@) * وروى عن أبي هاشم الجعفري، وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى أبي هاشم الجعفري.(@)(@@) وروى عن ابن سنان، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب ج 7، ح 1161.(@)(@@) * وروى عن ابن فضال، وروى عنه علي بن محمد بن بندار وغيره.(@)(@@) الكافي: ج 5، ك 3، ب 9، ح 6.(@)(@@) * وروى عن أحمد بن علي، وروى عنه محمد بن الحسن الصفار.(@)(@@) المشيخة: في طريقه إلى سليمان بن عمرو.(@)(@@) * وروى عن أحمد بن محمد بن أبي نصر البزنطي. وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى إسحاق بن يزيد.(@)(@@) وروى عن الحسن بن أبي قتادة.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 1، ح 10.(@)(@@) * وروى عن الحسن بن علي بن فضال. وروى عنه الحسن بن متيل الدقاق وغيره.(@)(@@) التهذيب: ج 6، ح 86.(@)(@@) * وروى عن الحسن بن محبوب. PageV02P281(@)(@@) وروى عنه علي بن الحسين والسعد آبادي.(@)(@@) المشيخة: في طريقه إلى سيف التمار.(@)(@@) * وروى 
ms530	 عن سليمان بن جعفر الجعفري، وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى سليمان بن جعفر الجعفري.(@)(@@) * وروى عن سليمان بن حفص المروزي، وروى عنه سعد بن عبد الله.(@)(@@) المشيخة: في طريقه إلى سليمان بن حفص المروزي.(@)(@@) * وروى عن شريف بن سابق التفليسي وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى فضل بن أبي قرة السمندي، وإلى فضل بن أبي قرة السمندي الكوفي.(@)(@@) * وروى عن العباس بن معروف، وروى عنه سعد بن عبد الله.(@)(@@) المشيخة في طريقه إلى العباس بن معروف.(@)(@@) * وروى عن عبد العظيم بن عبد الله الحسيني، وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى عبد العظيم بن عبد الله الحسني.(@)(@@) * وروى عن القاسم بن يحيى.(@)(@@) التهذيب: ج 1، ح 1144.(@)(@@) * وروى عن محمد بن عبد الله بن مهران، وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلي محمد بن عبد الله ابن مهران.(@)(@@) * وروى عن محمد بن علي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 7، ب 1، ذيل ح 1.(@)(@@) * وروى مرسلا.(@)(@@) الفقيه: ج 1، ح 325.(@)(@@) وروى مرسلا عن علي عليه السلام الفقيه: ج 3، ح 51.(@)(@@) * وروى عن غير واحد عن زياد القندي. وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 6، ح 2. والتهذيب:(@)(@@) ج 7، ح 1616.(@)(@@) أحمد بن إدريس * روى عن ابن أبي الصهبان. وروى PageV02P282(@)(@@) عنه البزوفري.(@)(@@) التهذيب: ج 8، ح 902.(@)(@@) * وروى عن إبراهيم بن هاشم، * وروى عنه ابنه الحسين.(@)(@@) المشيخة: في طريقه إلى إسماعيل بن أبي فديك.(@)(@@) * وروى عن أحمد بن أبي عبد الله، وروى عنه علي بن الحسين.(@)(@@) المشيخة: في طريقه إلى ما كان فيه عن محمد ابن الفيض.(@)(@@) وروى عنه علي بن الحسين ومحمد بن الحسن.(@)(@@) المشيخة: في طريقة إلى جعفر بن القاسم.(@)(@@) * وروى عن أحمد بن إسحاق.(@)(@@) الكافي: ج 1، ك 3، ب 9، ح 4، و ج 3، ك 1، ب 46، ح 10.(@)(@@) * وروى عن أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 6، ح 2، و ج 3، ك 4، ب 18، ح 4 و 19، وب 22، ح 4، و ب 
ms531	 24، ح 6، وب 25، ح 9، وب 84، ح 29، وب 87، ح 4.(@)(@@) وروى عنه أبو عبد الله البزوفري.(@)(@@) التهذيب: ج 6، ح 642 (الاستبصار:(@)(@@) ج 3، ح 50، و ج 4، ح 511، وفيه البزوفري). والتهذيب: ح 8، ح 864 (الاستبصار: ج 4، ح 40).(@)(@@) وروى عنه علي بن الحسين، ومحمد بن الحسن.(@)(@@) مشيخة التهذيب: في طريقه إلى علي بن مهزيار.(@)(@@) وروي عنه محمد.(@)(@@) التهذيب: ج 1، ح 192، و 210، و 230 (الاستبصار: ج 1، ح 220). والتهذيب:(@)(@@) ج 1، ح 231، (الاستبصار: ج 1، ح 221). والتهذيب: ج 1، ح 216.(@)(@@) وروي عنه محمد بن الحسن.(@)(@@) التهذيب: ج 1، ح 575 و 576 و 577.(@)(@@) وروي عنه محمد بن الحسن، وعلي بن الحسين.(@)(@@) مشيخة التهذيب: في طريقه إلى علي بن مهزيار، وروي عنه البزوفري.(@)(@@) التهذيب: ج 7، ح 1180، (الاستبصار:(@)(@@) ج 3، ح 583، وفيه أبو عبد الله البزوفري)، والتهذيب: ج 7، ح 1429 (الاستبصار: ج 3، ح 790). والتهذيب:(@)(@@) ج 7، ح 1430، (الاستبصار: ج 3، ح 791). والتهذيب: ج 8، ح 734 و 900، و 903، و 904 و 999 (الاستبصار:(@)(@@) ج 4، ح 124)، والتهذيب: ج 8، ح 1000، و PageV02P283(@)(@@) ج 9، ح 871 (الاستبصار: ج 4، ح 511، و ج 3، ح 50، وفي الثاني أبو عبد الله البزوفري)، والتهذيب: ج 9، ح 872.(@)(@@) * وروى هو وغيره عن أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 4، ب 13، ح 3، وب 27، ح 6.(@)(@@) * وروى عن أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 3، ب 9، ح 3.(@)(@@) * وروى عنه أبو عبد الله البزوفري.(@)(@@) التهذيب: ج 7، ح 1183 (الاستبصار:(@)(@@) ج 3، ح 586).(@)(@@) وروى عنه الحسن بن حمزة العلوي، ومحمد بن الحسين البزوفري.(@)(@@) مشيخة التهذيب: في طريقه إلى أحمد بن محمد بن عيسى:(@)(@@) وروى عنه علي بن الحسين ومحمد بن الحسن.(@)(@@) المشيخة: في طريقه إلى حريز ابن عبد الله.(@)(@@) وروى عنه محمد.(@)(@@) التهذيب: ج 1، ح 200، (الاستبصار:(@)(@@) ج 1، ح 200).(@)(@@) وروى عنه محمد بن الحسن، وعلي بن الحسين.(@)(@@) المشيخة: في طريقه إلى حريز بن عبد الله.(@)(@@) وروى عنه محمد بن الحسين البزوفري، والحسن بن حمزة العلوي.(@)(@@) مشيخة التهذيب: في طريقه إلى أحمد بن محمد بن عيسى.(@)(@@) * وروى عن الحسن بن علي الدقاق، وروى عنه ابنه الحسن.(@)(@@) التهذيب: ج 6، ح 194، وفيه أحمد بن إدريس مقيدا بالقمي.(@)(@@) وروى عن 
ms532	 الحسن بن علي الكوفي.(@)(@@) الكافي: ج 1، ك 4، ب 42، ح 1، وفيه أحمد ابن إدريس مقيدا بالقمي، والكافي:(@)(@@) ج 1، ك 4، ب 80، ح 20، وب 98، ح 3، وب 110، ح 3، و ج 4، ك 2، ب 83، ح 1.(@)(@@) * وروى عن الحسين بن عبد الله.(@)(@@) الكافي: ج 1، ك 3، ب 15، ح 2، و 3، و ك 4، ب 111، ح 3.(@)(@@) * وروى عن الحسين بن عبد الله.(@)(@@) الكافي: ج 1، ك 4، ب 13، ح 6.(@)(@@) والتهذيب: ج 6، ح 89.(@)(@@) * وروى عن سلمة بن الخطاب.(@)(@@) وروى عنه ابنه الحسين PageV02P284(@)(@@) التهذيب: ج 6، ح 160.(@)(@@) * وروى عن صندل، وروى عنه محمد.(@)(@@) التهذيب: ج 6، ح 123.(@)(@@) * وروى عن عبد الله بن محمد، وروى عنه البزوفري.(@)(@@) التهذيب: ج 8، ح 899.(@)(@@) * وروى عن علي بن الحسن، وروى عنه ابنه الحسن.(@)(@@) التهذيب: ج 6، ح 168.(@)(@@) * وروى عن علي بن الحسين النيسابوري، وروى عنه محمد بن السندي.(@)(@@) التهذيب: ج 6، ح 155 و 175.(@)(@@) وروي عن عمران بن موسى.(@)(@@) الكافي: ج 1، ك 4، ب 37، ح 2، و ب 102، ح 2.(@)(@@) * وروى عن عيسى بن محمد بن أبي أيوب.(@)(@@) الكافي: ج 4، ك 3، ب 7، ح 3.(@)(@@) * وروى عن محمد بن أبي الصهبان.(@)(@@) وروى عنه ابنه الحسين.(@)(@@) المشيخة: في طريقه إلى بشار بن يسار، وإلى عطاء بن السائب.(@)(@@) * وروى عن محمد بن أحمد.(@)(@@) الكافي: ج 1، ك 4، ب 80، ح 21، و ب 82، ح 6، وب 108، ح 5، و ج 3، ك 1، ب 2، ح 6، وب 5، ح 4، وب 6، ح 5 و 7، وب 7، ح 6، وب 12، ح 4، و ب 19، ح 7، وب 23، ح 17، وب 38، ح 5، وك 4، ب 8، ح 8، وب 21، ح 12، و 16، و 18، وب 24، ح 9، وب 32، ح 11، و 12، و 20، وب 59، ح 10، و ب 60، ح 25، وب 61، ح 3، و 13، و ب 64، ح 13، وب 91، ح 4، وك 5، ب 30، ح 3، و ج 4، ك 2، ب 6، ح 11، و ب 60، ح 3، وك 3، ب 99، ح 5.(@)(@@) والتهذيب: ج 1، ح 1294 (الاستبصار:(@)(@@) ج 1، ح 129، وفيه أبو محمد الحسن بن حمزة العلوي، عن أحمد بن إدريس، عن محمد بن أحمد بن يحيى).(@)(@@) وروى عنه ابنه الحسين.(@)(@@) المشيخة: في طريقه إلى زكريا بن مالك الجعفي.(@)(@@) وروى عنه علي بن الحسين بن بابويه.(@)(@@) المشيخة: في طريقه إلى عمرو بن جميع.(@)(@@) وروى عنه محمد بن يعقوب.(@)(@@) التهذيب: 
ms533	 ج 1، ح 76 و 160 (الاستبصار: ج 1، ح 170، وفيه محمد بن أحمد بن يحيى)، والتهذيب: ج 1، ح 183 PageV02P285(@)(@@) (الاستبصار: ج 1، ح 170، وفيه محمد بن أحمد بن يحيى)، والتهذيب: ج 1، ح 216 (الاستبصار: ج 1، ح 170، وفيه أحمد بن محمد بن يحيى)، والتهذيب: ج 4، ح 151 و 174.(@)(@@) * وروى هو وغيره عن محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 4، ح 9، وب 57، ح 7 و 9، وك 5، ب 3، ح 3، وب 33، ح 6، و 10، وب 47، ح 4، و ج 4، ك 1 ، ب 19، ح 2، وك 2، ب 37، ح 6.(@)(@@) * وروى عن محمد بن أحمد بن عبد الله بن أحمد الرازي، وروى عنه ابنه الحسين.(@)(@@) المشيخة: في طريقه إلى داود الرقي.(@)(@@) * وروى عن محمد بن أحمد بن يحيى، وروى عنه أبو القاسم جعفر بن محمد.(@)(@@) التهذيب: ج 1، ح 782.(@)(@@) وروى عنه أحمد بن جعفر، ومحمد.(@)(@@) التهذيب: ج 1، ح 221.(@)(@@) وروى عنه الحسن بن حمزة العلوي، ومحمد بن الحسين البزوفري مشيخة التهذيب: في طريقه إلى محمد بن أحمد بن يحيى الأشعري.(@)(@@) وروى عنه الحسين ابنه.(@)(@@) المشيخة: في طريقه إلى عمر بن حنظلة، والى عبد الله بن القاسم والى عبد الله ابن الحكم.(@)(@@) وروى عنه محمد.(@)(@@) التهذيب: ج 1، ح 20، و 32، و 82 ، (الاستبصار: ج 1، ح 133)، والتهذيب:(@)(@@) ج 1، ح 96، و 97، و 152، و 188، 271 و 339 (الاستبصار: ج 1، ح 374)، والتهذيب: ج 1، ح 369، و 543 و 669 و 950.(@)(@@) وروى عنه محمد وأحمد بن جعفر التهذيب: ج 1، ح 221.(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) التهذيب: ج 1، ح 85 و 88 و 151 و 386 و 550 و 551 و 552 و 665 و 690 و 700 و 701 و 762 و 763 و 802 و 803 و 807 و 816، 887 و 901 و 923 و 925 و 960 و 998.(@)(@@) وروى عنه محمد بن الحسن بن الوليد.(@)(@@) التهذيب: ج 1، ح 3، و 65.(@)(@@) وروى عنه محمد بن الحسن بن الوليد، ومحمد بن الحسين بن سفيان مشيخة التهذيب: في طريقه إلى محمد بن أحمد بن يحيى الأشعري، وروى عنه محمد بن الحسين بن سفيان، ومحمد 
ms534	 بن PageV02P286(@)(@@) الحسن بن الوليد، ومشيخة التهذيب: في طريقه إلى محمد بن أحمد بن يحيى الأشعري.(@)(@@) وروى عنه محمد بن الحسين البزوفري، والحسن بن حمزة العلوي.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد ابن أحمد بن يحيى الأشعري.(@)(@@) وروى عنه محمد بن يعقوب.(@)(@@) التهذيب: ج 1، ح 639 (الاستبصار:(@)(@@) ج 1، ح 37)، التهذيب: ج 1، ح 642 (الاستبصار: ج 1، ح 64، وفيه محمد بن أحمد فقط)، التهذيب: ج 1، ح 660 (الاستبصار: ج 1، ح 64، وفيه محمد بن أحمد فقط)، والتهذيب: ج 3، ح 185، و ج 4، ح 702 و 951.(@)(@@) * وروى عن محمد بن أحمد بن يحيى ابن عمران، وروى عنه علي بن الحسين، ومحمد بن الحسن.(@)(@@) المشيخة: في طريقه إلى محمد بن أحمد بن يحيى بن عمران الأشعري.(@)(@@) * وروى عن محمد بن بندار، وروى عنه علي بن حاتم.(@)(@@) التهذيب: ج 3، ح 212.(@)(@@) * وروى عن محمد بن حسان.(@)(@@) الكافي: ج 1، ك 1، ب 1، ح 6، وك 2، ب 2، ح 6، وك 4، ب 108، ح 31، و ب 122، ح 1، و 10، و ج 4، ك 2، ب 1، ح 9، وروى عنه الحسين ابنه وعلي بن الحسين، ومحمد بن الحسن.(@)(@@) المشيخة: في طريقه إلى محمد بن حسان.(@)(@@) وروى عنه علي بن الحسين، ومحمد بن الحسن.(@)(@@) المشيخة: في طريقه إلى عبد الله بن الحكم، والى علي بن غراب.(@)(@@) وروى عنه علي بن الحسين، ومحمد ابن الحسن والحسين ابنه.(@)(@@) المشيخة: في طريقه إلى محمد بن حسان.(@)(@@) وروى عنه محمد بن الحسن، وعلي بن الحسين.(@)(@@) المشيخة: في طريقه إلى عبد الله بن الحكم وعلي بن غراب.(@)(@@) وروى عنه محمد بن الحسن، وعلي بن الحسين، والحسين ابنه.(@)(@@) المشيخة: في طريقه إلى محمد بن حسان.(@)(@@) وروى عنه محمد بن يعقوب.(@)(@@) التهذيب: ج 4، ح 538.(@)(@@) * وروى عن محمد بن حسان الرازي، وروى عنه محمد بن الحسن بن الوليد. PageV02P287(@)(@@) التهذيب: ج 10، ح 1148.(@)(@@) * وروى عن محمد بن الحسين بن أبي الخطاب، وروى عنه علي بن الحسين.(@)(@@) المشيخة: في طريقه إلى الحسين بن المختار.(@)(@@) وروى عن محمد بن الحسين بن أبي الخطاب الزيات، وروى عنه علي بن الحسين، ومحمد بن الحسين.(@)(@@) المشيخة: في 
ms535	 طريقه إلى محمد بن الحسين ابن أبي الخطاب.(@)(@@) * وروى عن محمد بن حمدان الكوفي، وروى عنه جعفر بن قولويه.(@)(@@) التهذيب: ج 4، ح 249 * وروى عن محمد بن سالم.(@)(@@) الكافي: ج 3، ك 1، ب 4، ح 5.(@)(@@) وروى عنه علي بن الحسن.(@)(@@) التهذيب ج 3، ح 434 (الاستبصار:(@)(@@) ج 1، ح 1819 * وفيه علي بن الحسين)، وهو الصحيح ظاهرا.(@)(@@) وروى عنه علي بن الحسين. التهذيب:(@)(@@) ج 1، ح 1427، (الاستبصار: ج 1، ح 713)، والتهذيب، ج 3، ح 984 (الاستبصار ج 1، ح 1841)، والتهذيب: ج 3، ح 995 (الاستبصار:(@)(@@) ج 1، ح 1812).(@)(@@) * وروى عن محمد بن عبد الجبار.(@)(@@) الكافي: ج 1، ك 1، ب 1، ح 3، وك 2، ب 21، ح 5، وك 3، ب 7، ح 1، وب 9، ح 2 و 7، وب 11، ح 1، وب 14، ح 3، وب 16، ح 5، وب 20، ح 2، وك 4، ب 11، ح 5، وب 13، ح 3، وب 33، ح 4، وب 59، ح 6، وب 64، ح 12، و ب 69، ح 1، وب 71، ح 9، و 12، و ب 72، ح 5، وب 87، ح 3، وب 90، ح 1، و ج 3، ك 1، ب 4، ح 7، وب 11، ح 3، وب 15، ح 6، وب 23، ح 1، و ك 4، ب 1، ح 9، وب 10، ح 2، وب 59، ح 9، وب 60، ح 8، و 10، وب 78، ح 5، وب 84، ح 21، وك 5، ب 11، ح 8، وب 12، ح 1، وب 16، ح 7، و ب 21، ح 4، وب 23، ح 2، و 7، وب 26، ح 1، وب 34، ح 2، وب 43، ح 8، و ج 4، ك 1، ب 1، ح 2، وب 24، ح 3، و ب 42، ح 1، وك 2، ب 2، ح 2، وب 18، ح 4.(@)(@@) والتهذيب: ج 2، ح 942، و ج 4، ح 68.(@)(@@) وروى عنه علي بن الحسين، ومحمد بن الحسن.(@)(@@) المشيخة: في طريقه إلى محمد بن PageV02P288(@)(@@) عبد الجبار، وروى عنه محمد بن يعقوب.(@)(@@) والتهذيب: ج 1، ح 17 و 78 و 694 (الاستبصار: ج 1، ح 92)، والتهذيب:(@)(@@) ج 2، ح 683، و 812 (الاستبصار ج 1، ح 146)، والتهذيب: ج 4، ح 66 (الاستبصار: ج 2، ح 84)، والتهذيب:(@)(@@) ج 4، ح 154 و 279 و 512 و 547.(@)(@@) * وروى عن محمد بن عبد الجبار الشيباني.(@)(@@) الكافي: ج 1، ك 4، ب 114، ح 3.(@)(@@) * وروى عن محمد بن علي بن محبوب، وروى عنه علي بن الحسين والحسين ابنه.(@)(@@) المشيخة: في طريقه إلى محمد بن علي بن محبوب.(@)(@@) * وروى عن محمد بن يحيى، وروى عنه علي بن الحسين ومحمد بن 
ms536	 الحسن.(@)(@@) المشيخة: في طريقه إلى يعقوب بن يزيد.(@)(@@) (أحمد بن إسحاق) * وروى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الفقيه: ج 4، ح 480، وروى الكليني عن شيخ من أصحابنا عنه. والكافي: ج 1، ك 4، ب 76، ذيل ح 1.(@)(@@) * وروى عن أبي الحسن الثالث عليه السلام، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 3، ب 9، ح 4.(@)(@@) * روى عن أبي محمد عليه السلام.(@)(@@) التهذيب: ج 10، ح 831.(@)(@@) وروى عنه عبد الله بن عامر.(@)(@@) الكافي: ج 7، ك 4، ب 18، ح 3.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 124، ح 27.(@)(@@) * وروى عن أبي هاشم الجعفري، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 76، ح 2.(@)(@@) * وروى عن بكر بن محمد، وروى عنه أحمد بن علي.(@)(@@) التهذيب: ج 3، ح 254 و 255.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 77، ح 10، هذا بناء على ما في هذه الطبعة وفي بعض نسخ أخرى، ولكن الموجود في الطبعة القديمة ونسختي المرآة والوافي: الحسين ابن محمد عن أحمد بن إسحاق عن بكر ابن محمد بلا واسطة أحمد بن محمد، وهو الصحيح. PageV02P289(@)(@@) وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 115، ح 1، و ب 170، ح 5، وك 2، ب 49، ح 1، و ج 6، ك 3، ب 16، ح 4، وك 6، ب 53، ح 3، وك 7، ب 28، ح 8.(@)(@@) * وروى عن بكر بن محمد الأزدي، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 64، ح 6، وك 3، ب 12، ح 19، و ج 3، ك 4، ح 7، و ج 6، ك 3، ب 18، ح 3. التهذيب: ج 8، ح 917 (الاستبصار: ج 4، ح 73).(@)(@@) وروى عنه الحسين بن محمد، ومحمد ابن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 111، ح 29.(@)(@@) * وروى عن سعدان، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 109، ح 2، وك 2، ب 52، ح 10، و ج 3، ك 3، ب 79، ح 3، و ج 4، ك 2، ب 5، ح 6، وب 15، ح 2، و ج 5، ك 1، ب 22، ح 10، وب 25، ح 6، و ج 6، ك 8، ب 43، ح 37، وب 48، ح 6. التهذيب: ج 4، ح 577.(@)(@@) وروى عنه الحسين بن محمد ومحمد بن يحيى.(@)(@@) الكافي: ج 6، ك 7، ب 9، ح 5، وروى عنه على 
ms537	 بن سليمان. التهذيب: ج 3، ح 260.(@)(@@) وروى عنه علي بن سليمان الزراري.(@)(@@) التهذيب: ج 3، ح 246.(@)(@@) وروى عنه محمد بن يحيى، وأحمد بن إدريس.(@)(@@) الكافي: ج 3، ك 1، ب 46، ح 10.(@)(@@) وروى عنه محمد بن يحيى، والحسين ابن محمد.(@)(@@) الكافي: ج 6، ك 7، ب 9، ح 5.(@)(@@) * وروى عن سعدان بن مسلم، وروى عنه أبو علي الأشعري، الكافي: ج 5، ك 3، ب 167، ح 2، وب 190، ح 1.(@)(@@) وروى عنه أبو علي الأشعري، والحسين بن محمد، الكافي: ج 7، ك 2، ب 6، ح 1.(@)(@@) وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 1، ك 2، ب 2، ح 9، و ج 2، ك 1، ب 82، ح 13، وك 2، ب 13، ح 7، وب 19، ح 9، وب 48، ح 37، وك 4، ب 16، ح 6، و ج 3، ك 3، ب 44، ح 2، و ب 70، ح 8 و ج 4، ك 2، ب 70، ح 6، و ج 5، ك 3، ب 95، ح 7، وب 160، ح 4، و ج 6، ك 6، ب 97، ح 15، وك 8، PageV02P290(@)(@@) ب 68، ح 5. والتهذيب، ج 1، ح 1515، و ج 7، ح 1119 (الاستبصار: ج 3، ح 538).(@)(@@) وروى عنه الحسين بن محمد وأبو علي الأشعري.(@)(@@) الكافي: ج 7، ك 2، ب 6، ح 1.(@)(@@) وروى عنه الحسين بن محمد الأشعري. ومحمد بن يحيى.(@)(@@) الكافي: ج 1، ك 3، ب 23، ح 4.(@)(@@) وروى عنه علي بن سليمان.(@)(@@) التهذيب: ج 3، ح 233.(@)(@@) وروى عنه علي بن سليمان الزراري.(@)(@@) التهذيب: ج 3، ح 216.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 3، ك 4، ب 100، ح 9.(@)(@@) وروى عنه محمد بن يحيى، والحسين ابن محمد الأشعري.(@)(@@) الكافي: ج 1، ك 3، ب 23، ح 4.(@)(@@) * وروى عن سعدان عبد الرحمن.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 13، ح 6.(@)(@@) * وروى عن ياسر الخادم، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 2، ح 1249، (الاستبصار:(@)(@@) ج 1، ح 1243).(@)(@@) (أحمد بن الحسن) * وروى عن صاحب الدار عليه السلام على ما ذكر الكليني (قده)، وروى عنه أبو علي (أحمد) بن غياث.(@)(@@) الكافي: ج 1، ك 4، ب 125، ح 22.(@)(@@) * وروى عن أبي العباس وروى عنه إبراهيم بن إسحاق الأحمر.(@)(@@) الكافي: ج 6، ك 1، ب 22، ح 1.(@)(@@) * وروى عن أبيه الحسن، وروى عنه الحسين بن بندار الصرمي.(@)(@@) التهذيب ج 1، ح 1133.(@)(@@) وروى عنه علي بن الحسن.(@)(@@) الكافي: ج 7، ك 1، ب 34، ح 2.(@)(@@) والتهذيب: ج 1، ح 434، و 
