ms583	 خورد زمین خون حلال جانوران %~% ما بخوریم خون رز تا نرسد به جانوری(@)(@@) 48 هر که کبوتری کشد هم به ثواب در رسد %~% خیز و ببر گلوی دل کو کندت کبوتری(@)(@@) 49 سنگ فشان کنند خلق از پی دین به جمره در %~% ما همه جان فشان کنیم از پی خم به می خوری(@)(@@) 50 ور به طواف کعبه‌اند از سر پای سر زنان %~% ما و تو و طواق دیر از سر دل نه سرسری(@)(@@) 51 ور همه سنگ کعبه را بوسه زنند حاجیان %~% ما همه بوسه گه کنیم آن سر زلف سعتری(@)(@@) 52 کوی مغان و ما و تو هر سر سنگ کعبه‌ای %~% پای تو کرده زمزمی دست تو کرده ساغری(@)(@@) 53 طاعت ماست با گنه کز پی نام درخورد %~% روی سپید جامه را داغ سیاه گازری(@)(@@) 54 کعبه به زاهدان رسد دیر به ما سبو کشان %~% بخشش اصل دان همه ما و تو از میان بری(@)(@@) 55 زهد شما و فسق ما چون همه حکم داور است %~% داورتان خدای بس اینهمه چیست داوری(@)(@@) 56 گر حج و عمره کرده‌اند از در کعبه رهروان %~% ما حج و عمره می‌کنیم از در خسرو سری(@)(@@) 57 خاطر خاقانی از آن کعبه شناس شد که او %~% در حرم خدایگان کرده به جان مجاوری PageV1P0626(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ماه به ماه می‌کند شاه فلک کدیوری %~% عالم ناقه برده را توشه دهد توانگری(@)(@@) 2 مائده سازد از بره بر صفت توانگران %~% برزگری کند به گاو از قبل کدیوری(@)(@@) 3 موسی و سامری شود گاو و بره بپرورد %~% آب خضر برآورد ز آینه سکندری(@)(@@) 4 بنگه تیر ازو شود روضه صفت به تازگی %~% خرگه ماه ازو شود خلدوش از منوری(@)(@@) 5 چون به دهان شیر در خشم پلنگی آورد %~% روی زمین شود ز تف پشت پلنگ بربری(@)(@@) 6 تیزتر از کبوتری برج به برج می‌پرد %~% بیضه زر همی نهد در به در از سبک پری(@)(@@) 7 هر 
