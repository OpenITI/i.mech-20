ms321	 واليا حتى يعممه ، ويرخي لها من جانب الأيمن حذاء الأذن .(@)(@@) 1110 - قال أبو بشر : وروى يعقوب بن إبراهيم بن سعد ، عن أبيه ، عن PageV02P619 الوليد بن كثير ، قال : أخبرني إسماعيل بن عبيد الله أبو سفيان ، أن ابن شهاب حدثه ، أن أبا سلمة بن عبد الرحمن حدثه ، أن نفرا هاجروا إلى رسول الله [ صلى الله عليه وسلم ] فمكثوا ما شاء الله أن يمكثوا ، ثم ارتكسوا فرجعوا إلى قومهم ، فقال بعض القوم لهم : نافقتم ، وقال بعضهم : ما نافقوا ، فنزلت هذه الآية : @QB@ فما لكم في المنافقين فئتين والله أركسهم بما كسبوا @QE@ .(@)(@@) حدثنا العباس بن محمد ، قال : حدثنا يحيى بن معين قال : أبو سفيان المعمري ثقة ، وهو محمد بن حميد .(@)(@@) قال : وأبو سفيان طريف بن شهاب بصري ، وفي موضع آخر : طريف بن شهاب السعدي وأبو سفيان ، روى عنه : شريك .(@)(@@) قال : وطلحة بن نافع أبو سفيان صاحب الأعمش ، وفي موضع آخر : أبو سفيان الذي روى عنه الأعمش طلحة بن نافع .(@)(@@) قال : وسمعت يحيى يقول : شهدت زكريا بن عدي سأل وكيعا ، فقال : يا أبا سفيان هذه الأحاديث ، يعني مثل : حديث الكرسي ، موضع القدمين ، ونحوها فقال وكيع : أدركنا ( 1 / 199 ) إسماعيل بن أبي خالد ، وسفيان ، ومسعرا يحدثون بهذه الأحاديث ، ولا يفسرون بشيء .(@)(@@) سمعت عبد الله بن أحمد بن حنبل ، قال : سمعت أبي يقول : أبو سفيان طلحة بن يحيى ، سمع منه : شعبة . PageV02P620(@)(@@) وأبو سفيان طلحة بن نافع : ليس [ به بأس ] .(@)(@@) 111 - حدثنا يزيد بن محمد بن عبد الصمد ، قال : حدثنا أبو أيوب سليمان بن عبد الرحمن ، قال : حدثنا سهيل بن ميسرة أبو سفيان الرملي لقيته بدمشق ، قال : سمعت عطاء الخراساني ، يقول : أهدى إلي أهل بيت رأس شاة ، فقالوا : إن جيراننا هؤلاء أحوج إليه منا ، فبعثوا به إليهم ، فلم يزالوا يتهادونه حتى رجع إلى الأولى .(@)(@@) 1112 - حدثنا أبو بكر مصعب بن عبد الله بن مصعب ، قال : حدثنا يزيد بن هارون ، قال : حدثنا الحجاج بن أبي زينب ، قال : سمعت طلحة بن نافع أبا سفيان ، يقول : سمعت جابر بن عبد الله يقول 
ms322	 : كنت في ظل داري ، فمر علي رسول الله [ صلى الله عليه وسلم ] ، فلما رأيته وثبت إليه ، فجعلت أمشي خلفه ، فقال : ادن ، فدنوت ، فأخذ بيدي حتى أتى بعض حجر نسائه أم سلمة أو زينب بنت جحش ، فدخل ثم أذن لي فدخلت ، وعليها الحجاب ، فقال : هل عندكم غداء ، فقالوا : نعم ، فأتى بثلاثة أقرصة ، فوضعت على تفى ، فقال : [ ما ] عندكم من أدم ، قالوا : لا ، والله إلا خل ، قال : هاتوه ، فأتى به ، فأخذ قرصا ، فوضعه بين يدي وقرصا بين يديه ، وكسر القرص الثالث ، فوضع نصفا بين يدي ، ونصفا بين يديه .(@)(@@) 1113 - حدثنا محمد بن عبد الملك الدقيقي ، قال : حدثنا أبو الجهم PageV02P621 الأزرق ابن علي ، قال : حدثنا حسان بن إبراهيم ، قال : حدثنا عبد المنعم بن نعيم أبو سعيد ، قال : حدثنا الجريري ، عن أبي عثمان النهدي ، عن أسامة بن زيد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : أشكر الناس الله أشكرهم للناس .(@)(@@) حدثنا أبو عون محمد بن عمرو بن عون ، قال : حدثني جدي سكن بن سفيان أبو حسين الزمزاني واسطي ، قال : حدثنا عبد الله بن سفيان بن عبيد الله بن رفاعة الفزاري أبو سفيان .(@)(@@) 1114 - حدثنا عمرو بن علي ، قال : حدثني جدي أبو سفيان صالح بن مهران ، وكان ثقة ، قال : حدثنا النعمان بن عبد السلام ، عن سفيان ، عن عاصم بن كليب ، عن أبيه ، عن أبي هريرة ، قال : كان رسول الله [ صلى الله عليه وسلم ] يصلي حتى [ تتورم ] قدماه .(@)(@@) 1115 - حدثنا محمد بن المثنى ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، قال : سمعت أبا سفيان حسين بن حسين ، قال : قال رجل لأنس بن مالك : إني تسحرت ، ثم بدا لي أن أفطر ، قال : إن شئت فأفطر ، [ ثم ] قال : كان أبو طلحة يجيء يقول : هل عندكم من طعام ؟ فإن قالوا : لا ، قال : إني صائم .(@)(@@) 1116 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا زيد بن حباب ، عن أبي سفيان حرب بن سريج ، قال : سألت الحسن ، عن امرأة توفي عنها PageV02P622 زوجها ، فمرضت ، فوصف لها دواء خارج من المصر 
ms323	 ، قال : فلتخرج ، ولا تخرج إلا مع ذي محرم وإياها والطيب والمعصفرات .(@)(@@) 1117 - أخبرني المطلب بن شعيب ، عن عبد الله بن صالح ، قال : أخبرني معاوية بن صالح ، عن جبير بن أبي سفيان ، عن محمد بن زياد ، وكان مريضا أنه قال : إن رجلا في ليالي صفين رأى أن هاتفا يهتف به في وسط القبور ، يقول :(@)(@@) % ألا أيها الركبان إن قبورنا %~% مثال وقد كنا نراها مثالكم %(@)(@@) % وكنا قرانا في الحياة كشكلكم %~% [ فها ] نحن في مقصورة لأننا لكم %(@)(@@) % فمن يأتنا لا يرجع فتلك ديارنا %~% [ سكنتم بها وقتا ] وهذي مصيركم % % PageV02P623(@)(@@) ( ( 1 / 201 ) من كنيته أبو السوار ، وما شاكله )(@)(@@)(@@)(@@) $ * أبو السوار عبد الله بن قدامة العنبري بصري .(@)(@@)(@@)(@@) $ * وأبو السوار حسان بن حريث .(@)(@@)(@@)(@@) $ * وأبو السوداء النهدي عمرو بن عمران .(@)(@@)(@@)(@@) $ * وأبو سوادة [ مسلم ] بن مخراق .(@)(@@)(@@)(@@) $ * وأبو سوية سمع سبيعة ، قالت : دخلت على عائشة .(@)(@@)(@@)(@@) $ * وأبو سوية سهل الفقيمي .(@)(@@)(@@)(@@) $ * وأبو سويرة جبلة بن سحيم .(@)(@@)(@@)(@@) $ * [ وأبو السوداء عمرو بن عامر ] .(@)(@@) سمعت العباس ، قال : [ حدثنا ] يحيى قال : حدثنا عقبة المجدر ، قال : حدثنا قرة بن خالد ، قال : كان أبو السوار عريف قومه ، وكان من أهل الفضل . (@)(@@) 1118 - حدثنا محمد بن بشار ، قال : حدثنا معاذ بن معاذ ، قال : حدثنا شعبة ، عن توبة العنبري ، قال : سمعت أبا السوار القاضي عبد الله بن قدامة بن عنزة يحدث ، عن أبي برزة ، قال : أغلظ رجل على أبي ، فقلت : ألا PageV02P624 أقتله ، فقال : ليس إلا لمن شتم النبي عليه السلام .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين يقول : أبو السوداء النهدي عمرو بن عمران ، وفي موضع آخر : أبو السوداء النهدي كوفي ، روى عن أبي مجلز .(@)(@@) وجبلة بن سحيم ، كنيته أبو سويرة .(@)(@@) حدثنا العباس ، قال : حدثنا يحيى ، قال : حدثنا ابن أبي غنية ، عن حفص بن عمر ، عن أبي الزبير الدرمكي ، قال : قال حوشب [ بن عقيل ] لجبلة بن سحيم : يا أبا سويرة .(@)(@@) [ قال ] : وحدثني عبد الله بن أحمد ، قال : سمعت أبي يقول : أبو السوداء عمرو بن عامر ، روى عنه : الثوري .(@)(@@) 1119 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا معاوية 
ms324	 بن هشام القصار ، قال : حدثنا علي بن صالح بن حي ، عن أبي السوداء النهدي ، قال : شهدت أبا جعفر كبر أربعا على بنت جعفر . انتهى ، والله تعالى أعلم . PageV02P625(@)(@@)(@@)(@@) ||| ( المفاريد في حرف السين )(@)(@@)(@@)(@@) $ * [ أبو سحابة الصدفي ] .(@)(@@)(@@)(@@) $ * وأبو السمحاء سهيل بن حسان .(@)(@@)(@@)(@@) $ * وأبو السمح دراج ، ويقال أيضا إن اسمه : عبد الرحمن .(@)(@@)(@@)(@@) $ * وأبو سحيم مبارك بن عبد الله ، يروي عنه : بندار .(@)(@@)(@@)(@@) $ * وأبو سماعة عميرة بن عبد المومن .(@)(@@)(@@)(@@) $ * وأبو السمين حيان بن جحدر .(@)(@@)(@@)(@@) $ * وأبو السمير حكيم بن حزام .(@)(@@)(@@)(@@) $ * وأبو السميط سعيد مولى المهري .(@)(@@)(@@)(@@) $ * وأبو سهيل نافع بن مالك بن أبي عامر .(@)(@@)(@@)(@@) $ * وأبو سهلة السائب بن خلاد .(@)(@@)(@@)(@@) $ * وأبو السفر كوفي ، اسمه : سعيد بن أحمد ، ويقال : سعيد بن يحمد ، يروي عنه : عبيد الله ، وأبو نعيم .(@)(@@)(@@)(@@) $ * [ وأبو سيار أيوب بن سيار .(@)(@@)(@@)(@@) $ * وأبو سيدان عبيد بن طفيل ] .(@)(@@)(@@)(@@) $ * وأبو سيار العلاء بن محمد بن سيار ، يروي عنه : يزيد بن سنان أبو خالد . PageV02P626(@)(@@)(@@)(@@) $ * وأبو سفانة النخعي ، عن عائشة .(@)(@@)(@@)(@@) $ * وأبو سيف مولى عبد الرحمن بن سمرة .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : أبو السمحاء سهل بن حسان .(@)(@@) حدثنا العباس ، قال : قلت : ليحيى : دراج من هو ؟ قال : مصري ، وهو أبو السمح .(@)(@@) حدثنا العباس ، قال : سمعت يحيى يقول : أبو السفر اسمه سعيد بن أحمد ، يروي عنه : شعبة وروى شعبة أيضا ، عن ابنه عبد الله بن أبي السفر ، ولم يسمع الثوري من أبي السفر ، وروى عن أبي السفر ، الأعمش ، وأبو إسحاق .(@)(@@) قال : وسمعت يحيى يقول : أبو سفانة النخعي ، يروي عن : عائشة في الفرك ، ( 1 / 202 ) يروي عنه : برد بن أبي زياد أخو يزيد بن أبي زياد .(@)(@@) حدثني عبد الله بن أحمد بن حنبل ، قال : سمعت أبي قال : أخفظ عن وكيع اسم أبي السفر ، سعيد بن أحمد الثوري ، ثور همدان .(@)(@@) 1120 - حدثنا أحمد بن عبد الجبار العطاردي ، قال : حدثنا يونس بن بكير ، عن يونس بن عمرو ، عن أبي السفر سعيد بن أحمد الثوري ، قال : بعث أبو طالب إلى رسول الله [ صلى الله عليه وسلم ] ، فقال : أطعمني من عنب جنتك ، PageV02P627 وأبو بكر الصديق 
ms325	 جالس عند رسول الله [ صلى الله عليه وسلم ] ، فقال : أبو بكر : حرمها الله على الكافرين ، فقال أبو طالب : فلأبي قحافة آكل الذبان تدخرها .(@)(@@) 1121 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو السفر الهمداني ، شهد مشاهد علي ، هلك في إمارة الوليد بن عبد الملك .(@)(@@) 1122 - أخبرني القاضي البرقي ، عن موسى بن إسماعيل ، عن حماد ابن سلمة ، عن ثابت البناني ، أن أبا سيف مولى عبد الرحمن بن سمرة كان يومئ إيماء زمن الحجاج ، وهو قاعد ، فأخذت ذلك عنه .(@)(@@) 1123 - أخبرني محمد بن إبراهيم ، عن أبيه ، عن محمد بن عمر ، قال : أبو سهل نافع بن مالك لقي سعيد بن المسيب ، وبعض أصحاب النبي [ صلى الله عليه وسلم ] ، وكان يؤخذ عنه القراءة بالمدينة ، وعن أبي جعفر ، هلك في إمارة أبي العباس .(@)(@@) 1124 - حدثنا محمد بن عبد الله بن يزيد ، قال : حدثنا مروان بن معاوية ، قال : حدثنا محمد بن أبي قيس الأزدي ، قال : حدثنا عبادة بن نسي ، عن أبي سحابة الصدفي حين حدثنا ونحن برودس هذا الحديث ، قال : حدثنا عقبة بن عامر الجهني ، قال : قال رسول الله [ صلى الله عليه وسلم ] : لا تحل الدرجات العلى لمن تكهن ، ولا لمن استقسم ، ولا لمن رده طائر عن سفره ، ثم قال رسول الله [ صلى الله عليه وسلم ] : لا تقولوا لا تحل الجنة ثلاثا ، ولكن [ قولوا ] : لا تحل الدرجات العلى .(@)(@@) 1125 - حدثنا يزيد بن سنان أبو خالد ، قال : حدثنا العلاء بن محمد بن سيار ، وكان ثقة ، قال : حدثنا محمد بن عمرو ، عن أبي سلمة ، قال : قلت PageV02P628 لعائشة : يا أم المؤمنين ! إذا خلا رسول الله [ صلى الله عليه وسلم ] ما يصنع ؟ قالت : ما يعمل أحدكم يخيط الشيء ، ويخرز الشيء . (@)(@@) 1126 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن مسلم بن وارة ، قال : حدثنا عميرة بن عبد المؤمن أبو سماعة الرهاوي الأزدي ، قال : حدثنا عصام بن بشير ، عن أبيه ، قال : وفدني أصحابنا بنو الحارث إلى رسول الله [ صلى الله عليه وسلم ] أخبره بإسلامهم ، فقال 
ms326	 لي : ما اسمك ؟ قلت له : أسمي أكبر ، فقال رسول الله [ صلى الله عليه وسلم ] : بل اسمك بشير ، ورسول الله [ صلى الله عليه وسلم ] سماني بشيرا .(@)(@@) وذكر عصام أنه سمع أباه يقول هذا .(@)(@@) 1127 - أخبرني أحمد بن شعيب ، قال : أخبرنا خالد بن روح ، عن يزيد وهو ابن موهب ، قال : حدثنا عبد الله بن وهب ، عن حرملة بن عمران ، أن أبا السميط سعيد بن أبي سعيد مولى المهري حدثه ، عن أبيه ، عن عبد الله بن عمرو بن العاص ، أن معاذ بن جبل أراد سفرا ، فقال : يا نبي الله ! أوصني ، فقال : اعبد الله لا تشرك به شيئا ، قال : يا نبي الله ! زدني ، قال : إذا أسأت فأحسن ، قال : يا نبي الله ! زدني ، قال : استقم ، وليحسن خلقك . (@)(@@) 1128 - [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : حدثنا إسماعيل ، قال : حدثنا أبو سهيل نافع بن مالك بن أبي عامر ، عن أبيه ، عن أبي هريرة ، أن رسول الله [ صلى الله عليه وسلم ] قال : آية PageV02P629 المنافق ثلاث : إذا حدث كذب ، وإذا وعد أخلف ، وإذا ائتمن خان .(@)(@@) تم النصف الأول من الكتاب بحمد الله تعالى وعونه وحسن توفيقه * ويتلوه النصف الثاني إن شاء الله تعالى وصلى الله على سيدنا محمد وآله وصحبه وسلم . PageV02P630(@)(@@) ( كتاب الكنى والأسماء )(@)(@@) ( بسم الله الرحمن الرحيم )(@)(@@) وصلى الله على سيدنا محمد وآله وصحبه وسلم .(@)(@@) أخبرنا الإمام الحافظ أبو محمد المبارك بن علي بن الحسين الطباخ البغدادي في كتابه إلي من مكة شرفها الله تعالى ، وأجازني في جميع ما يرويه ، قال : أنبأ الإمام الحافظ العالم أبو القاسم إسماعيل بن أبي بكر أحمد بن عمر الدمشقي وأنا أسمع ، قراءة الشيخ الإمام الحافظ أبي الفضل محمد بن ناصر بن محمد بن علي البغدادي ، قال : أنبأ الأخ أبو طاهر محمد بن أحمد بن محمد بن أبي الصفر الأنباري ، قراءة عليه وأنا أسمع ، فأقر به ، قال : أنبأ الأخ أبو القاسم هبة الله بن إبراهيم بن عمر الصواف قراءة عليه ، قال : أنبأ أبو بكر أحمد بن محمد بن 
ms327	 إسماعيل بن الفرج ، قال : حدثنا أبو بشر محمد بن أحمد حماد الدولابي ، قال : PageV02P631(@)(@@)(@@)(@@) || ( باب حرف الشين )(@)(@@)(@@)(@@) ||| ( من كنيته أبو شيبة )(@)(@@)(@@)(@@) $ * أبو شيبة آدم الزبرقان .(@)(@@)(@@)(@@) $ * وأبو شيبة إبراهيم بن عثمان ، حدث عن خاله : الحكم بن عتيبة ، وأبي إسحاق .(@)(@@)(@@)(@@) $ * وأبو شيبة عبد الرحمن بن إسحاق كوفي ، يروي عنه : عبد الواحد بن زياد ، وأبو معاوية ، ضعيف .(@)(@@)(@@)(@@) $ * وأبو شيبة عبد الرحمن بن يحيى مصري ، يروي عنه : ابن أبي مريم .(@)(@@)(@@)(@@) $ * وأبو شيبة العلاء بن خالد .(@)(@@)(@@)(@@) $ * وأبو شيبة الفرج بن يزيد ، يروي عنه : يحيى بن صالح الوحاظي .(@)(@@)(@@)(@@) $ * وأبو شيبة رجاء بن كيسان ، يروي عنه : أبو داود الطيالسي .(@)(@@)(@@)(@@) $ * وأبو شيبة سعيد بن عبد الرحمن الزبيدي .(@)(@@)(@@)(@@) $ * وأبو شيبة شعيب بن زريق .(@)(@@)(@@)(@@) $ * وأبو شيبة يحيى بن عبد الرحمن ، يحدث عنه : الوليد بن مسلم .(@)(@@)(@@)(@@) $ * وأبو شيبة يوسف بن إبراهيم .(@)(@@)(@@)(@@) $ * وأبو شيبة يزيد بن معاوية ، حدث عنه : عبد الملك بن عمير .(@)(@@)(@@)(@@) $ * وأبو شيبة والد النعمان الجندي .(@)(@@) 1129 - حدثنا أبو يحيى محمد بن عبد الله بن يزيد المقرئ ، قال : حدثنا PageV02P632 أبي ، قال : حدثنا سعيد بن أبي أيوب ، قال : أخبرني آدم بن الزبرقان أبو شيبة الكوفي ، قال : سمعت الشعبي يقول : غزوت مع ناس من أصحاب رسول الله [ صلى الله عليه وسلم ] فكنا إذا انتهينا إلى أهل قرية فإن كانوا أهل كتاب أكلنا من طعامهم ، وشربنا من حلال ( 2 / 3 ) شرابهم ، وإن كانوا من غير أهل كتاب انتفعنا بآنيتهم وغسلناها .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو شيبة سعيد الزبيدي ، وقد روى سفيان بن سعيد الثوري ، عن سعيد بن عبد الرحمن ، وهو أبو شيبة هذا ، وقد سمع حكام ، والقاسم بن مالك ، وعبد الواحد بن زياد كلهم من أبي شيبة هذا ، وهو سعيد بن عبد الرحمن ، وقد سمع منه أبو جعفر الرازي ، وهو ثقة .(@)(@@) قال : وسمعت يحيى يقول : أبو شيبة الذي يروي عنه : محمد بن فضيل ، مكي . PageV02P633(@)(@@) حدثنا العباس بن محمد ، قال : حدثنا يحيى ، قال : حدثنا نوح بن دراج ، قال : أخبرني إبراهيم بن عثمان بن خواستي ، وهو أبو شيبة [ الكبير ] ، جد 
ms328	 بني أبي شيبة ، واسم أبيهم : محمد ، وكان أبوهم قاضيا ببعض فارس ، ومات بها ، وهو أبو بني أبي شيبة ، وبنو أبي شيبة يقولون أبو سعدة جدنا ، وأبو سعدة هو صاحب حديث سعد .(@)(@@) وفي موضع آخر : أبو شيبة جد بني أبي شيبة .(@)(@@) قال : يزيد بن هارون : ما قضى على الناس رجل في زمانه أعدل في القضاء منه ، وكان يزيد بن هارون على كتابته أيام كان قاضيا .(@)(@@) 1130 - حدثني أبو عبد الله محمد بن أحمد بن عبيدة بن شيبة الأنصاري الخوارزمي بمكة ، قال : حدثنا سعيد بن منصور ، قال : حدثنا أبو شيبة يزيد بن معاوية ، قال : حدثنا عبد الله بن عمير ، عن زرين حبيش ، عن ابن مسعود ، قال : سألت رسول الله [ صلى الله عليه وسلم ] أي الأعمال أفضل ؟ ، قال : الصلوات لوقتهن .(@)(@@) 1131 - حدثنا شعيب بن أيوب الصريفيني ، والحسن بن علي بن عفان ، قالا : حدثنا أبو أسامة ، عن عبد الواحد بن زياد ، قال : حدثنا أبو شيبة سعيد بن عبد الرحمن الزبيدي ، قال : حدثنا مجاهد ، قال : جاء نفر من أهل العراق إلى ابن عباس ، فقالوا : إنا أنفجنا ضبعا فتراددنا بيننا فاصطدناها ، فمنا الحلال ومنا الحرام ، فقال ابن عباس : إن كان ضبعا ذكرا فكبش سمين ، PageV02P634 وإن كانت ضبعة فنعجة سمينة ، قال : فقالوا : يا ابن عباس ! على كل رجل منا ، قال : لا ، ولكن تخارجون بينكم .(@)(@@) 1132 - حدثنا محمد بن عبد الملك الدقيقي ، قال : حدثنا عبيد الله بن معاذ ، قال : حدثنا أبي ، قال : كتبت إلى شعبة أسأله عن أبي شيبة قاضي واسط ، فكتب إلي لا تكتب عنه شيئا ، ومزق كتابي هذا .(@)(@@) حدثني عبد الله بن أحمد ، قال : سمعت أبي ، قال : أبو شيبة عبد الرحمن بن إسحاق الكوفي ، وهو واسطي ، يروي عنه : ابن أدريس ، وابن فضيل ، وأبو معاوية ، وهو يحدث عن : النعمان بن سعد ، ليس هو بذاك في الحديث .(@)(@@) 1133 - حدثنا عمرو بن علي ، قال : حدثنا أبو داود ، قال : حدثنا رجاء بن كيسان أبو شيبة ، قال : سألت الحسن ، عن رجل قتل مسلما أله توبة ؟ قال : نعم ، وسألت ابن سيرين فرجا 
ms329	 ورجاه ، وكان ألين قولا من الحسن .(@)(@@) 1134 - حدثنا عمار بن راشد ، قال : حدثنا يحيى بن صالح ، قال : حدثنا الفرح بن يزيد أبو شيبة الكلاعي ، قال : أخبرني يزيد بن أبي مالك ، أن الشعبي قال : سمعت ابن عمر يقول : من مات ليس عليه إمام جامع ، فقد مات ميتة جاهلية ، ومن خرج من الجماعة فقد خلع ربقة الإسلام من عنقه .(@)(@@) حدثني محمد بن خلف العسقلاني ، قال : حدثنا آدم بن أبي إياس ، قال : حدثنا أبو شيبة شعيب بن زريق ، عن عطاء الخراساني . PageV02P635(@)(@@) 1135 - وحدثنا هلال بن العلاء ، قال : حدثنا حسين بن عياش ، قال : حدثنا زهير ، قال : حدثنا سعيد أبو شيبة ، عن بكر بن عبد الله المزني ، قال : قال رسول الله [ صلى الله عليه وسلم ] : ساقي القوم آخرهم شربا .(@)(@@) 1136 - أخبرني أحمد بن شعيب ، قال : حدثنا أبو الوليد ، قال : حدثنا الوليد ، قال : حدثنا أبو شيبة يحيى بن عبد الرحمن ، عن حبان بن أبي جبلة ، عن عمرو بن العاص : ما عدل بي رسول الله ( 2 / 4 ) [ صلى الله عليه وسلم ] وبخالد بن الوليد أحدا من أصحابه في أمر حزبه منذ أسلمنا .(@)(@@) 1137 - حدثنا أبو زكريا يحيى بن عثمان بن صالح ، قال : أنبأ عمرو بن خالد الحراني ، قال : حدثنا أبو شيبة إبراهيم بن عثمان قاضي واسط ، عن أبي إسحاق ، عن أبي بكر بن أبي موسى ، عن أبي موسى قال : قال رسول الله [ صلى الله عليه وسلم ] : يستأمر النساء في أنفسهن فإذا سكتن فذلك لهن إقرار . PageV02P636(@)(@@)(@@)(@@) ||| ( ومن كنيته أبو شريح )(@)(@@)(@@)(@@) $ * أبو شريح عبد الرحمن بن شريح الإسكندراني .(@)(@@)(@@)(@@) $ * وأبو شريح عبد الرحمن بن ميسرة الحضرمي ، يروي عنه : محمد بن عمرو المحرمي ، كذا وقع ههنا ، وذكره البخاري في تاريخه الكبير ، المحرري كان من المحررين .(@)(@@)(@@)(@@) $ * وأبو شريح ضبارة بن مالك ، يروي عنه : بقية بن الوليد .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] يقول : أبو شريح ، هو عبد الرحمن بن شريح .(@)(@@) وسمعت عبد الله بن أحمد يقول : قال أبي : أبو شريح عبد الرحمن بن شريح ، ليس به بأس . PageV02P637(@)(@@)(@@)(@@) ||| ( من كنيته 
ms330	 أبو شعبة )(@)(@@)(@@)(@@) $ * أبو شعبة ميمون ، يحدث عنه : يعلى بن عبيد .(@)(@@)(@@)(@@) $ * وأبو شعبة واصل بن عبد الرحمن .(@)(@@)(@@)(@@) $ * وأبو شعبة عبيد العدوي بصري .(@)(@@)(@@)(@@) $ * وأبو شعبة يونس بن عثمان ، يحدث عنه : يحيى بن صالح الوحاظي .(@)(@@)(@@)(@@) $ * وأبو شعبة نوح الراسبي .(@)(@@)(@@)(@@) $ * وأبو شعبة مفضل بن نوح ، يروي عنه : زيد بن حباب .(@)(@@)(@@)(@@) $ * وأبو شعبة مفضل بن يونس ، يروي عنه : عمرو بن علي .(@)(@@)(@@)(@@) $ * وأبو شعبة الشعباني .(@)(@@) 1138 - حدثنا أبي ، قال : حدثنا يعلى بن عبيد ، قال : حدثنا ميمون أبو شعبة ، قال : رأيت زيد بن علي يصلي ، فيضع يديه على جدار القبلة يعتمد عليه .(@)(@@) 1139 - حدثنا عمرو بن علي ، قال : حدثنا مفضل بن يونس أبو شعبة صاحب الكرابيس ، وكان ثقة ، قال : جاء غالب القطان ، قال : سألت الحسن ، قلت : إنا نبيع القطن فيأتينا نساء أهل الذمة ، فنرى شعورهن ، قال : ليس به بأس . PageV02P638(@)(@@) 1140 - [ قال ] : حدثنا موهب بن يزيد ، قال : حدثنا صدقة بن المعتمر أبو شعبة الشعباني ، قال : أخبرني الضحاك ، عن بلال بن سعد ، أنه كان يقول فيما يعظنا به : عباد الرحمن إنكم اليوم تتكلمون ، والله عز وجل ساكت ، ويوشك الله عز وجل أن يتكلم وتسكتون ، ثم يثور من أعمالكم دخان تسود منه الوجوه : @QB@ واتقوا يوما ترجعون فيه إلى الله ثم توفى كل نفس ما كسبت وهم لا يظلمون @QE@ .(@)(@@) 1141 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن سليمان الرهاوي ، قال : حدثنا زيد بن الحباب ، قال : حدثني مفضل بن نوح أبو شعبة الراسبي ، قال : أخبرني يزيد بن عمرو الراسبي ، عن الحسن ، قال : العلم في الصغر كالنقش في الحجر . PageV02P639(@)(@@)(@@)(@@) ||| ( من كنيته أبو شعيب )(@)(@@)(@@)(@@) $ * أبو شعيب صاحب الطيالسة ، روى عنه : شعبة .(@)(@@)(@@)(@@) $ * وأبو شعيب ربيعة ، عن واثلة .(@)(@@)(@@)(@@) $ * وأبو شعيب [ المجنون ] الصلت بن دينار ضعيف .(@)(@@)(@@)(@@) $ * وأبو شعيب موسى بن عبد العزيز القنباري .(@)(@@)(@@)(@@) $ * وأبو شعيب يوسف بن شعيب الخولاني .(@)(@@)(@@)(@@) $ * وأبو شعيب صالح بن حكيم التمار .(@)(@@)(@@)(@@) $ * [ وأبو شعيب حماد بن شعيب الحماني ( 2 / 5 ) ] .(@)(@@) سمعت العباس [ بن محمد ] ، يقول : سمعت يحيى بن معين ، يقول : الصلت بن دينار يكنى أبا شعيب ، وليس بشيء .(@)(@@) وحماد بن شعيب ، يقال له 
ms331	 : أبو شعيب الحماني ، وليس بشيء .(@)(@@) سمعت عبد الله بن أحمد بن حنبل ، قال : سمعت أبي يقول : أبو شعيب سمع طاوسا ، يروي عنه : شعبة . PageV02P640(@)(@@) 1142 - [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبأ أبو بكر بن علي ، قال : حدثنا يحيى بن معين ، قال : حدثنا غندر ، قال : حدثنا شعبة ، عن أبي شعيب صاحب الطيالسة ، عن طاوس ، قال : سئل ابن عمر عن الركعتين قبل المغرب ؟ فقال : ما رأيت أحدا على عهد رسول الله [ صلى الله عليه وسلم ] صلاهما .(@)(@@) 1143 - حدثنا يزيد بن سنان ، قال : حدثنا حجاج [ بن يزيد ] بن نصير ، قال : حدثنا أبو شعيب الصلت بن دينار ، عن أبي العلاء يزيد بن عبد الله ، عن عمران بن حصين ، قال : صليت خلف علي بن أبي طالب ، فكان يتم التكبير ، فلما انصرف قلنا : يا أمير المؤمنين ! ما صليت هذه الصلاة بعد رسول الله [ صلى الله عليه وسلم ] مع إمام غيرك .(@)(@@) 1144 - حدثنا محمد بن عوف الطائي ، قال : حدثنا موسى بن أيوب النصيبي ، قال : حدثنا أبو شعيب يوسف بن شعيب الخولاني يسكن اللاذقية قال : حدثنا الأوزاعي ، عن حسان بن عطية ، عن جابر بن عبد الله ، عن أبي بكر الصديق ، أنه أكل مع رسول الله [ صلى الله عليه وسلم ] لحما فصلى ولم يتوضأ .(@)(@@) [ قال ] : وحدثني عبد الله بن أحمد بن حنبل ، قال : سألت يحيى بن معين ، عن موسى بن عبد العزيز ، فقال : أبو شعيب القنباري ما أرى به بأسا . PageV02P641(@)(@@)(@@)(@@) ||| ( من كنيته أبو الشعثاء )(@)(@@)(@@)(@@) $ * أبو الشعثاء جابر بن زيد البصري .(@)(@@)(@@)(@@) $ * وأبو الشعثاء سليم بن الأسود المحاربي كوفي .(@)(@@)(@@)(@@) $ * وأبو الشعثاء [ مولى ] عمر بن عبيد الله بن معمر .(@)(@@)(@@)(@@) $ * وأبو الشعثاء بشير بن نهيك .(@)(@@)(@@)(@@) $ * وأبو الشعثاء الكندي يزيد بن المهاجر .(@)(@@)(@@)(@@) $ * وأبو الشعثاء علي بن الحسن الكوفي ، يروي عنه : حفص بن غياث .(@)(@@) حدثنا محمد بن منصور الجواز ، قال : حدثنا يحيى بن أبي الحجاج البصري ،(@)(@@) قال : حدثنا عبد الله بن مشكم ، عن القاسم بن أبي بزة ، عن جابر بن زيد أبي الشعثاء .(@)(@@) 1145 - حدثنا أبي ، قال : حدثنا يعلى بن عبيد ، قال : حدثنا عثمان بن 
ms332	 حكيم ، عن جابر بن زيد أبي الشعثاء ، قال : إذا أتيت الجمعة فقف على باب المسجد ، فقل : اللهم اجعلني اليوم أوجه من توجه إليك ، وأقرب من تقرب إليك ، وأنجح من دعاك وطلب إليك ، ثم ادخل فسل تعط .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين قال : أبو الشعثاء جابر بن زيد ، قد روى عنه : قتادة ، وهو ثقة . PageV02P642(@)(@@) أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو الشعثاء سليم بن أسود بن حنظلة المحاربي ، من أصحاب عبد الله وحذيفة ، شهد مع علي كل شيء ، هلك في ولاية عبد الملك أو الوليد .(@)(@@) حدثنا العباس ، قال : سمعت يحيى يقول : حميد الطويل ، عن أبي الشعثاء مولى عمر بن عبيد الله بن معمر واسمه : فيروز .(@)(@@) وبشير بن نهيك كنيته أبو الشعثاء .(@)(@@) وأبو الشعثاء سليم بن أسود هو المحاربي ابن حنظلة ، من أصحاب عبد الله وحذيفة ، شهد مع علي كل شيء ، حتى هلك في ولاية عبد الملك ، وهو أشعث بن أبي الشعثاء .(@)(@@) 1146 - أخبرني أحمد بن شعيب ، قال : أنبأ واصل بن عبد الأعلى ، قال : حدثنا أبو أسامة ، عن المثنى بن سعيد ، قال : حدثني أبو الشعثاء عمر مولى بني معمر ، قال : سمعت ابن عباس يقول : أستغفر الله وأتوب إليه PageV02P643 من قولي في الصرف ، إنما كان من رأيي ( 2 / 6 ) وهذا أبو سعيد يحدث ، عن رسول الله [ صلى الله عليه وسلم ] وأناس من أصحابه ، فنهرني .(@)(@@)(@@)(@@) ||| ( من كنيته أبو شهاب ، [ وأبو أشهب ] )(@)(@@)(@@)(@@) $ * أبو شهاب عبد ربه بن نافع .(@)(@@)(@@)(@@) $ * وأبو شهاب عيسى بن المغيرة الحزامي .(@)(@@)(@@)(@@) $ * وأبو شهاب موسى بن نافع الهذلي .(@)(@@)(@@)(@@) $ * وأبو شهاب محمد بن إبراهيم .(@)(@@)(@@)(@@) $ * وأبو شهاب مسروح بن شهاب .(@)(@@)(@@)(@@) $ * وأبو أشهب جعفر بن حيان بصري .(@)(@@)(@@)(@@) $ * وأبو أشهب جعفر بن الحارث كوفي ، ضعيف .(@)(@@) سمعت العباس بن محمد ، يقول : [ سمعت يحيى بن معين ، يقول ] : حدثنا وكيع ، عن أبي شهاب ، عن جبلة بن دعلج ، عن سعيد بن جبير ، في رجل طلق بالفارسية ، قال : يلزمه الطلاق .(@)(@@) 1147 - حدثنا إبراهيم بن الجنيد ، قال : حدثنا [ خلف ] بن هشام القارئ 
ms333	 ، قال : حدثنا أبو شهاب عبد ربه بن نافع ، عن الأعمش ، عن إبراهيم ، PageV02P644 أن عمر كان إذا بلغه عن عامله أنه لا يعود المريض ولا يدخل عليه الضعيف نزعه .(@)(@@) 1148 - حدثنا محمد بن بشار ، قال : حدثنا عبد الرحمن ، قال : حدثنا عبد ربه أبو شهاب ، عن خالد ، عن أبي قلابة ، قال : إذا قال الرجل لمملوكه ، أخدمني سنة وأعتقك ، فاشترى المملوك خدمته فهو حر .(@)(@@) 1149 - أخبرني أحمد بن شعيب ، قال : أنبأ خالد بن روح الدمشقي ، قال : حدثنا يزيد [ بن وهب الرملي ] ، قال : أنبأ أبو شهاب مسروح بن شهاب الحدثي ، عن سفيان الثوري ، عن أبي الزبير ، عن جابر ، قال : دخلت على النبي [ صلى الله عليه وسلم ] والحسن والحسين على ظهره ، وهو يقول : نعم الجمل جملكما ، ونعم العدلان أنتما .(@)(@@) قال أبو عبد الرحمن : هذا حديث منكر ، يشبه أن يكون باطلا . PageV02P645(@)(@@) أخبرني إبراهيم بن الجنيد ، قال : أخبرني بشر بن محمد بن أبان قال : حدثني أبو الأشهب جعفر بن حيان العطاردي .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، يقول : اسم أبي الأشهب البصري : جعفر بن حيان .(@)(@@) قال يحيى : وقد روى يزيد بن هارون ، عن أبي الأشهب الكوفي ، وهو جعفر بن الحارث ، ويروي عنه : محمد بن يزيد ، وهو ضعيف الحديث ، وليس بشيء ، ليس بثقة . PageV02P646(@)(@@)(@@)(@@) ||| ( من كنيته أبو شيخ [ وغيره ] )(@)(@@)(@@)(@@) $ * أبو شيخ حيوان بن خالد الهنائي .(@)(@@)(@@)(@@) $ * وأبو شيخ الفقيمى حارثة بن هرم بصري .(@)(@@)(@@)(@@) $ * وأبو شيخ عبد الله بن مروان الحراني ، يروي عنه : محمد بن سلمة .(@)(@@)(@@)(@@) $ * وأبو شيبان الهذلي أشرس .(@)(@@) 1150 - حدثنا عبد الله بن أحمد بن أبي ميسرة ، قال : حدثنا النعمان ابن عمر أبو المفضل ، قال : حدثنا أشرس أبو شيبان الهذلي ، قال : حدثني أبو ظلال ، عن أنس بن مالك ، قال : قال رسول الله [ صلى الله عليه وسلم ] : [ يقول الله تبارك وتعالى ] : ثواب عبدي إذا أخذت كريمته النظر إلى وجهي ، وحلول داري .(@)(@@)(@@)(@@) $ * وأبو شفقل راوية الفرزدق .(@)(@@)(@@)(@@) $ * وأبو شقيق عبد الله السلولي ، روى عنه : موسى بن أبي عائشة .(@)(@@)(@@)(@@) $ * وأبو شقيق ، روى عنه : محمد بن بشر العبدي .(@)(@@) 1151 - حدثنا زكريا 
ms334	 بن خلاد ، قال : حدثنا الأصمعي ، قال : حدثنا أبو مودود ، قال : حدثنا أبو شفقل راوية الفرزدق ، قال : طلق الفرزدق امرأته النوار ، فقال للحسن يا أبا سعيد ! طلقت امرأتي ثلاثا ، قال : شهدنا عليك فبدا له ، قال : فأعادها ، فشهد ( 2 / 7 ) عليه الحسن ففرق بينهما . PageV02P647(@)(@@)(@@)(@@) ||| ( من كنيته أبو شريك ، [ وأبو شراعة ] )(@)(@@)(@@)(@@) $ * أبو شريك معقل بن مالك ، يروي عنه : محمد بن المثنى أبو موسى .(@)(@@)(@@)(@@) $ * وأبو شريك يحيى بن يزيد بن ضماد المصري .(@)(@@)(@@)(@@) $ * وأبو شراعة الصباح بن عبد الله البجلي .(@)(@@) 1152 - أخبرني أحمد بن شعيب ، قال : أخبرني عمران بن يزيد ، قال : حدثنا مروان الفزاري ، قال : حدثنا الصباح أبو شراعة ، قال : سألت أنس بن مالك عن المحرم هل يذبح ؟ قال : نعم .(@)(@@) 1153 - أخبرني أبو عبد الرحمن ، قال : أنبأ محمد بن المثنى ، قال : حدثنا معقل بن مالك أبو شريك ، قال : حدثنا عقبة بن عبد الله الأصم ، عن عبد الله بن بريدة ، عن أبيه ، قال : قال رسول الله [ صلى الله عليه وسلم ] : [ إن ] أحسن ما غيرتم به الشيب الحناء .(@)(@@) 1154 - أخبرني أحمد بن شعيب ، قال : أنبأ أبو شريك يحيى بن يزيد بن ضماد ، عن ضمام ، عن موسى بن وردان ، عن أبي هريرة ، أن النبي [ صلى الله عليه وسلم ] قال : تهادوا تحابوا . PageV02P648(@)(@@)(@@)(@@) ||| ( من كنيته أبو شرحبيل )(@)(@@)(@@)(@@) $ * أبو شرحبيل سلام [ بن شرحبيل ] ، عن حبة وسواء ابني خالد .(@)(@@)(@@)(@@) $ * وأبو شرحبيل مالك بن ذي حمامة ، يروي عنه : صفوان بن عمرو .(@)(@@)(@@)(@@) $ * وأبو شرحبيل جعفر بن ربيعة .(@)(@@)(@@)(@@) $ * [ وأبو شرحبيل ذو الكلاع ] .(@)(@@) سمعت العباس [ بن محمد ] ، قال : سمعت يحيى بن معين ، يقول : ذو الكلاع يكنى أبا شرحبيل .(@)(@@) 1155 - سمعت يحيى بن عثمان ، قال : حدثنا يحيى بن عبد الله بن بكير ، قال : أخبرني عبد الرحمن بن سعيد بن أبي أيوب ، عن نافع بن يزيد ، قال : دخلت أنا وجعفر بن ربيعة على عبيد الله بن الحبحاب والي مصر ، فقال عبيد الله لجعفر : يا أبا شرحبيل . PageV02P649(@)(@@)(@@)(@@) ||| ( من كنيته أبو شبل )(@)(@@)(@@)(@@) $ * أبو شبل علقمة بن قيس .(@)(@@)(@@)(@@) $ * وأبو شبل مهنا بن عبد الحميد .(@)(@@) [ حدثنا أبو بشر محمد بن أحمد الدولابي 
ms335	 ] ، قال : سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : كنية علقمة بن قيس أبو شبل .(@)(@@) حدثني أبو شيبة إبراهيم بن أبي بكر بن أبي شيبة ، قال : حدثنا عمر بن حفص بن غياث قال : حدثنا أبي ، قال : حدثنا الأعمش ، عن إبراهيم ، عن علقمة ، قال : كناني عبد الله بأبي شبل .(@)(@@) 1156 - حدثني الحسن بن علي بن عفان ، قال : حدثنا الحسن بن عطية ، قال : حدثنا يحيى بن سلمة بن كهيل ، عن أبيه ، عن ابن أخي علقمة ، قال : صلى بنا علقمة خمس ركعات ، فقال له القوم : يا أبا شبل إنك قد صليت خمس ركعات ، فقال : ما فعلت ؟ قالوا : بلى ، قال : فجعلوا يرددون عليه ويرد عليهم ، فقلت [ له ] : بلى يا عم ! قد صليت خمس ركعات ، فقال لي : وأنت يا أعور ؟ قلت : وأنا ، قال : فاستقبل القبلة فسجد سجدتي السهو ، ثم حدثنا عن عبد الله بن مسعود ، قال : صلى بنا رسول الله [ صلى الله عليه وسلم ] خمس ركعات ، فقال القوم بعد ما فرغ وتكلم : يا رسول الله ! أزيد في الصلاة ؟ قال : لا ، فما ذاك ، قالوا : صليت خمسا ، قال : فاستقبل القبلة فسجد سجدتين .(@)(@@) 1157 - وذكر أبو عبد الله محمد بن أحمد بن عبد الحميد الباهلي ، قال : PageV02P650 أخبرني مهنا أبو شبل صاحب السابري ، قال : حدثنا حماد بن سلمة ، عن علي بن زيد ، عن أبي نضرة ، أن فتى سأل عمران بن حصين ، عن ( 2 / 8 ) صلاة رسول الله [ صلى الله عليه وسلم ] في السفر ، فقال : ما سافر رسول الله [ صلى الله عليه وسلم ] سفرا إلا صلى ركعتين حتى يرجع ، ثم غزوت مع أبي بكر وحججت واعتمرت ، فصلى ركعتين ركعتين ، ومع عمر فصلى ركعتين ركعتين ، ومع عثمان صدرا من إمارته فصلى ركعتين ركعتين ، ثم إنه صلى بعد ذلك بمنى أربعا .(@)(@@) 1158 - [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبأ هارون بن عبد الله ، قال : حدثنا أبو شبل المهنا بن عبد الحميد ، قال : حدثنا حماد بن سلمة ، عن قتادة ، عن مطرف ، عن عمران بن حصين ، قال : قال رسول الله [ صلى الله 
ms336	 عليه وسلم ] : لا تزال طائفة على الحق ظاهرين على من ناوأهم حتى يقاتل آخرهم المسيح الدجال . PageV02P651(@)(@@)(@@)(@@) ||| ( المفاريد في حرف الشين )(@)(@@)(@@)(@@) $ * أبو شبرمة عبد الله بن شبرمة القاضي .(@)(@@)(@@)(@@) $ * وأبو شجرة كثير بن مرة الحضرمي .(@)(@@)(@@)(@@) $ * وأبو شجاع سعيد بن يزيد ، روى عنه : الليث .(@)(@@)(@@)(@@) $ * وأبو شور عمرو بن شور ، رأى الشعبي .(@)(@@)(@@)(@@) $ * وأبو شراعة الصباح بن عبد الله البجلي .(@)(@@)(@@)(@@) $ * وأبو شيبان الأسود بن شيبان .(@)(@@)(@@)(@@) $ * وأبو شداد .(@)(@@)(@@)(@@) $ * وأبو شمر الضبعي .(@)(@@)(@@)(@@) $ * وأبو شجرة عيسى بن صدقة .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، يقول : حدثنا عثمان بن عمر ، عن يونس بن يزيد ، عن أبي شداد ، عن مجاهد ، عن عائشة ، أن النبي [ صلى الله عليه وسلم ] قال : واعروساه .(@)(@@) قلت : ليحيى : أبو شداد هذا أيلي ، قال : لا أدري .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : كنية سعيد بن يزيد الذي يروي عنه الليث بن سعد أبو شجاع . PageV02P652(@)(@@) وكثير بن مرة أبو شجرة .(@)(@@) وحدثني عبد الله بن أحمد بن حنبل ، قال : سمعت أبي يقول : أبو شمر الضبعي ، يروي عنه شعبة ، لم يرو عنه الثوري .(@)(@@) وحدثني عبد الله بن أحمد بن حنبل ، قال : قال أبي : عبد الله بن شبرمة أبو شبرمة .(@)(@@) 1159 - حدثنا محمد بن المثنى ، قال : حدثنا يحيى بن محمد بن قيس ، قال : سمعت أبا شبرمة عبد الله بن شبرمة ، قال : قال الحسن : تقرأ القرآن ما نهاك ، فإذا لم ينهك فلست تقرؤه ، رب حامل فقه غير فقيه ، ومن لم ينفعه علمه ضره جهله .(@)(@@) 1160 - حدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم ، قال : حدثنا يزيد بن عوانة ، قال : أخبرني أبو شداد أو شيخ من مجاشع أحسن إليه الثناء ، قال : سمعت الحسن وذكر عنده الذين يلبسون الصوف ، قال : ما لم يعاندوا وأكنوا الكبر في قلوبهم ، وأظهروا التواضع في لباسهم ، والله لأحدهم أشد عجبا بكسائه من صاحب المطرف بمطرفه .(@)(@@) 1161 - أخبرني أحمد بن شعيب ، قال : حدثنا هشام بن عبد الملك ، PageV02P653 قال : حدثنا يحيى بن سعيد ، قال : حدثنا أبو شجرة عيسى بن صدقة ، قال : سمعت أنس 
ms337	 بن مالك يقول : أتى رسول الله [ صلى الله عليه وسلم ] بجنازة ليصلي عليها ، فقالوا : عليه دين ، فقال : ليقم أحدكم فليضمن دينه ، فإن صلاتي تنفعه .(@)(@@) 1162 - أخبرني أحمد بن شعيب ، قال : أخبرنا محمد بن عبد الوهاب ، قال : حدثنا علي بن غنام ، عن أبيه ، عن أبي شور عمرو بن شور ، قال : رأيت الشعبي وأتته مسألة فرمى بها إلى ابن أشوع ، فرماها ابن أشوع إلى غيره حتى رجعت إلى الشعبي . PageV02P654(@)(@@)(@@)(@@) || ( حرف الصاد )(@)(@@) ( ( 2 / 9 ) من كنيته أبو صالح )(@)(@@)(@@)(@@) $ * أبو صالح مولى عثمان بن عفان اسمه : الحارث .(@)(@@)(@@)(@@) $ * وأبو صالح عبيد مولى السفاح .(@)(@@)(@@)(@@) $ * وأبو صالح عبد الرحمن بن قيس أخو طليق بن قيس .(@)(@@)(@@)(@@) $ * وأبو صالح ميسرة ، عن سويد بن غفلة .(@)(@@)(@@)(@@) $ * وأبو صالح السمان ذكوان .(@)(@@)(@@)(@@) $ * وأبو صالح ميزان بصري .(@)(@@)(@@)(@@) $ * وأبو صالح ماهان الحنفي ، صلبه الحجاج .(@)(@@)(@@)(@@) $ * وأبو صالح غالب بن سليمان ، يروي عنه : سليمان بن حرب .(@)(@@)(@@)(@@) $ * وأبو صالح عبد الغفار بن داود الحراني .(@)(@@)(@@)(@@) $ * وأبو صالح الحكم بن موسى ، يروي عن : يحيى بن حمزة .(@)(@@)(@@)(@@) $ * وأبو صالح الحكم بن مبارك البلخي .(@)(@@)(@@)(@@) $ * وأبو صالح حماد ، يروي عن : محمد بن سيرين .(@)(@@)(@@)(@@) $ * وأبو صالح جعفر بن صبيح .(@)(@@)(@@)(@@) $ * وأبو صالح ميناء ، روى عنه : كامل بن العلاء .(@)(@@)(@@)(@@) $ * وأبو صالح المسيب بن دارم .(@)(@@)(@@)(@@) $ * وأبو صالح المغيرة بن حبيب .(@)(@@)(@@)(@@) $ * وأبو صالح محبوب بن موسى . PageV02P655(@)(@@)(@@)(@@) $ * وأبو صالح محمد بن يحيى بن سعيد القطان .(@)(@@)(@@)(@@) $ * وأبو صالح محمد بن عبد الوهاب .(@)(@@)(@@)(@@) $ * وأبو صالح باذان ، وقيل : أيضا باذام مولى أم هانئ .(@)(@@)(@@)(@@) $ * وأبو صالح النعمان بن أبي شمر ، روى عنه : محمد بن مهاجر .(@)(@@)(@@)(@@) $ * وأبو صالح سميع .(@)(@@)(@@)(@@) $ * وأبو صالح سمويه صاحب فتوح خراسان .(@)(@@)(@@)(@@) $ * وأبو صالح سعيد بن عبد الرحمن الغفاري .(@)(@@)(@@)(@@) $ * وأبو صالح شعيب بن الحبحاب .(@)(@@)(@@)(@@) $ * وأبو صالح عبد الحميد بن صالح ، يروي عن : أبي بكر بن عياش .(@)(@@) أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : ماهان الحنفي سمع من عمر شيئا يسيرا ، وشهد مع علي مشاهده ، هلك في ولاية عبد الملك .(@)(@@) وأبو صالح باذام كان مولى أم هانئ ، سمع من : علي ، وابن عباس ، وهو أبو صالح صاحب 
ms338	 التفسير ، وكان علويا ، هلك في إمارة الوليد بن عبد الملك .(@)(@@) وأبو صالح ذكوان مولى جويرية امرأة من قيس ، وهو أبو سهيل بن أبي صالح .(@)(@@) وأبو صالح مولى ضباعة ابنة الزبير بن عبد المطلب ، كان يحدث عن مولاته : ضباعة بنت الزبير . PageV02P656(@)(@@) حدثني عبد الله بن أحمد بن حنبل ، قال : سألت أبي فقلت : منصور ، عن أبي صالح من أبو صالح هذا ؟ قال : باذام صاحب الكلبي ، وهو مولى أم هانئ ، ولم يحدث منصور عن أبي صالح ذكوان شيئا علمته .(@)(@@) 1163 - حدثنا أبو عبد الرحمن عبد الله بن هاشم الطوسي ، قال : حدثنا يحيى بن سعيد ، عن إسماعيل بن أبي خالد ، قال : أخبرني أبو صالح مولى أم هانئ ، قال : خلق الله من كل زوجين اثنين ، والله وتر واحد ، قال : فذكرت ذلك لعامر فقال : كان مسروق يقول ذلك .(@)(@@) قال أبو عبد الرحمن : قال يحيى بن سعيد أبو صالح هذا هو : باذام ، لم يذكر إسماعيل اسمه .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين يقول : أبو صالح الذي يروي عنه محمد بن السائب الكلبي ، وسماك : باذام مولى أم هانئ ، قال : وقد سمع مالك بن مغول من أبي صالح باذام .(@)(@@) وأبو صالح مولى ضباعة ، روى عنه : كامل الكوفي .(@)(@@) * وأبو صالح الذي روى عنه : كامل بن العلاء ، يقال له : مولى ضباعة .(@)(@@) قال : وأبو صالح الحنفي ماهان .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : حدثنا يحيى بن معين ، قال : أبو صالح الذي روى عنه يحيى بن أبي كثير قيلوية . PageV02P657(@)(@@) وأبو صالح الذي يروي عن ابن عباس : سميع .(@)(@@) وأبو صالح الذي روى عنه : سليمان التيمي ، وخالد الحذاء ، [ وهو ] بصري ، واسمه : ميزان .(@)(@@) وأبو صالح الذي يروي عنه : بسر بن سعيد : ، عبيد مولى السفاح ( 2 / 10 ) .(@)(@@) وأبو صالح الذي يروي عنه أهل مصر : سعيد بن عبد الرحمن الغفاري .(@)(@@) وأبو صالح الذي يروي عنه أهل فلسطين اسمه : ذريح .(@)(@@) وأبو صالح المسيب بن دارم ، قال يحيى : هذا مشهور أنه : المسيب بن دارم .(@)(@@) وابو صالح مولى عمر بن الخطاب الذي يروي عنه في قصة التجارة في البحر 
ms339	 .(@)(@@) وأبو صالح الأشعري الذي يروي عنه أبو غسان المديني ، عن أبي الحصين ، عن أبي صالح الأشعري ، هو : مولى عثمان .(@)(@@) وأبو صالح ميسرة ، عن سويد بن غفلة ، يروي عنه : هلال بن خباب . PageV02P658(@)(@@) وأبو صالح أيضا الذي دخل على أم كلثوم ، وهي تمتشط .(@)(@@) وأبو صالح الأشعري ، روى عنه : حسان بن عطية ، وقد روى الليث بن سعد ، عن زهرة بن معبد ، عن أبي صالح مولى عثمان .(@)(@@) وقال يحيى : ميسرة صاحب علي يكنى أبا صالح .(@)(@@) وأبو صالح أيضا مولى عمر بن الخطاب ، يروي عنه : العوام .(@)(@@) قال : وسمعت العباس [ بن محمد ] ، قال : سمعت يحيى بن معين يقول : سمع إسماعيل بن سالم ، من أبي صالح ذكوان ، وسمع أيضا من أبي صالح باذام .(@)(@@)(@@)(@@) $ * وأبو صالح عبد الرحمن بن قيس .(@)(@@)(@@)(@@) $ * وأبو صالح الحراني ، وهو عبد الغفار بن داود .(@)(@@) قال : حدثنا الليث بن سعد ، قال : أخبرني أبو الأسود وغيره ، أن عليا والزبير أسلما ، وهما ابنا اثنتي عشرة سنة .(@)(@@) 1164 - حدثنا محمد بن بشار ، قال : حدثنا يحيى بن سعيد ، قال : حدثنا علي بن المبارك ، قال : حدثنا يحيى بن أبي كثير ، عن قيلوية أبي صالح ، قال : كان لي على علج عشرون درهما ، فأهدى لنا هدية قومتها اثنتي عشر درهما فسألت ابن عباس فقال : قاضه وخذ ما بقي . PageV02P659(@)(@@) 1165 - حدثنا إسحاق بن إبراهيم أبو يعقوب الكوفي بالرملة ، قال : حدثنا عبد الغفار بن داود أبو صالح الحراني ، قال : حدثنا زهير بن معاوية ، قال : حدثني [ أبو الحسين ] محمد بن خالد بن خلي ، قال : حدثنا جعفر ابن صبيح أبو صالح ، قال : حدثنا أبو يحيى محمد بن زياد ، عن أبيه ، عن أبي عنبسة الخولاني ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إذا أراد الله بعبد خيرا طهره قيل : وما طهره ؟ قال : يفتح له عملا صالحا ، ثم يتوفاه عليه .(@)(@@) 1166 - وحدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم ، قال : حدثنا همام ، قال : حدثنا مطر ، قال : أخبرني محمد بن سيرين ، قال : أخبرني أبو [ صالح ] ذكوان عن ثلاثة من أصحاب رسول الله [ صلى الله عليه وسلم ] أنهم 
ms340	 نهوا عن الصرف ، رجلان منهم يرفعانه إلى النبي [ صلى الله عليه وسلم ] .(@)(@@) 1167 - حدثنا أبو جعفر أحمد بن هاشم المعروف بابن أبي العباس ، قال : أنبأ ضمرة بن ربيعة ، عن رجاء بن أبي سلمة ، عن المغيرة بن حبيب أبي صالح ، قال : سألت سالم بن عبد الله ، عن الجيش ينزل على حصن ، فيقاتلونهم قتالا شديدا فيقتلون في المسلمين ، ويجرحون ، فإذا خافوا الغلبة سألوا الأمان فيأبى أمير الجيش أن يقبل ذلك منهم ، فكيف وجه القتال معه ؟ قال : ليس ذلك إليك إنما ذلك إلى إمامك . PageV02P660(@)(@@) 1168 - حدثنا أحمد بن إبراهيم بن فيل البالسي ، قال : حدثنا أبو توبة ، قال : حدثنا محمد بن مهاجر ، عن أبي صالح النعمان بن أبي شمر ، قال : سمعت معاوية على هذا المنبر يقول : أعدوا للبلاء صبرا فوالله إن بقي من الدنيا إلا بلاء وفتنة .(@)(@@) 1169 - حدثنا محمد بن داود الطرسوسي ، قال : حدثنا أبو صالح محبوب بن موسى ، قال : حدثنا شعيب بن حرب ، عن مالك بن مغول ، قال : جاء رجل إلى الشعبي ، فقال : ما أكاد أروي من ماء الفرات ، قال : ولم ؟ قال : لحال بول الملاحين ، فقال : ما أراك تموت إلا مصلوبا ، قال : فذكروا أنه ارتد عن الإسلام ، فصلب .(@)(@@) 1170 - أخبرني أحمد بن شعيب ، عن هناد بن السري ، عن هشيم ، عن هلال بن خباب ، عن ميسرة أبي صالح ، عن ( 2 / 11 ) سويد بن غفلة ، قال : أتانا مصدق النبي [ صلى الله عليه وسلم ] فأتيته ، فجلست إليه ، فسمعته يقول : إن في عهدي أن لا تأخذن راضع لبن ، و [ لا ] تجمع بين مفترق ولا تفرق بين مجتمع ، فأتاه رجل بناقة يوما ، فقال : خذها فأبى . PageV02P661(@)(@@)(@@)(@@) ||| ( من كنيته أبو الصلت )(@)(@@)(@@)(@@) $ * أبو الصلت شهاب بن خراش .(@)(@@)(@@)(@@) $ * وأبو الصلت سليم الحضرمي .(@)(@@)(@@)(@@) $ * وأبو الصلت شريح بن عبيد .(@)(@@)(@@)(@@) $ * وأبو الصلت زائدة بن قدامة .(@)(@@)(@@)(@@) $ * وأبو الصلت الحجاج بن أبي عثمان الصواف .(@)(@@)(@@)(@@) $ * وأبو الصلت عبد السلام بن صالح الهروي .(@)(@@)(@@)(@@) $ * وأبو الصامت .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] يقول : حجاج بن أبي عثمان ، هو ابن سالم وكنية الحجاج بن أبي عثمان أبو 