ms21	 من السودان % PageV01P071 11(@)(@@) % ومريضة قفر يحاذر شرها % % من هولها قمن من الحدثان % 12(@)(@@) % غبراء خاضعة الصوى جاوزتها % % ليلا بكاتمة السرى مذعان % 13(@)(@@) % حرف تمد زمامها بعذافر % كالجذع شذب ليفه الريان % 14(@)(@@) % غضبى لمنسمها صياح بالحصى % % وقع القدوم بغضرة الأفنان % 15(@)(@@) % تستشرف الأشباح وهي مشيحة % ببصيرة وحشية الإنسان % 16(@)(@@) % خوصاء صافية تجود بمائها % % وسط النهار كنطفة الحران % 17(@)(@@) % تنفي الظهيرة والغبار بحاجب % كالكهف صينت دونه بصيان % 18(@)(@@) % زهراء مقلتها تردد فوقها % % عند المعرس مدلج القردان % 19(@)(@@) % أعيت مذارعها عليه كأنما % % تنمي أكارعه على صفوان % 20(@)(@@) % فتعجرفت وتعرضت لقلائص % خوص العيون خواضع الأذقان % PageV01P072 21(@)(@@) % شبهتها لهق السراة ملمعا % منه القوائم طاوي المصران % 22(@)(@@) % فغدا بمعتدلين لم يسلبهما % % لا فيهما عوج ولا نقدان % 23(@)(@@) % وكلاهما تحت الضباب كأنما % % دهن المثقف ليطه بدهان % 24(@)(@@) % وغدا بسامعتي وأى أعطاهما % % حذرا وسمعا خالق الآذان % PageV01P073 البحر : وافر تام 1(@)(@@) % لقد ولى أليته جؤى % معاشر غير مطلول أخوها % % 2(@)(@@) % فإن تهلك جؤي فكل نفس % سيجلبها كذلك جالبوها % % 3(@)(@@) % وان تهلك جؤي فإن حربا % كظنك كان بعدك موقدوها % % 4(@)(@@) % وما ساءت ظنونك يوم تولي % % بأرماح وفى لك مشرعوها % % 5(@)(@@) % كأنك كنت تعلم يوم بزت % ثيابك ما سيلقى سالبوها % % 6(@)(@@) % لنذرك والنذور لها وفاء % إذا بلغ الخزاية بالغوها % % 7(@)(@@) % صبحنا الخزرجية مرهفات % أباد ذوي أرومتها ذووها % % 8(@)(@@) % فما عتر الظباء بحي كعب % ولا الخمسون قصر طالبوها % % 9(@)(@@) % ولا قلنا لهم نفس بنفس % أقيدونا بها إن لم تدوها % % 10(@)(@@) % ولكنا دفعناها ظماء % فرواها بذكرك منهلوها % % PageV01P074 11(@)(@@) % ولو بلغ القتيل فعال حي % لسرك من سيوفك منتضوها % % PageV01P075 البحر : طويل 1(@)(@@) % وأشعث رخو المنكبين بعثته % وللنوم منه في العظام دبيب % PageV01P076 البحر : طويل 1(@)(@@) % لأي زمان يخبأ المء نفعه % غدا فغدا والدهر غاد ورائح % 2(@)(@@) % إذا المرء لم ينفعك حيا فنفعه % قليل إذا رصت عليه الصفائح % PageV01P077 البحر : طويل 1(@)(@@) % تعلم رسول الله أنك مدركي % % وأن وعيدا منك كالأخذ باليد % PageV01P078 البحر : مجزوء الكامل 1(@)(@@) % مسح النبي جبينه % فله بياض بالخدود % 2(@)(@@) % وبوجهه ديباجة % كرم النبوة والجدود 
ms22	 % PageV01P079 البحر : بسيط تام 1(@)(@@) % لاتفش سرك إلا عند ذي ثقة % أولا ، فافضل ما أستودعت أسرارا % % 2(@)(@@) % صدرا رحيبا وقلبا واسعا صمتا % لم تخش منه لما استودعت إظهارا % % PageV01P080 البحر : بسيط تام 1(@)(@@) % هل حبل رملة قبل البين مبتور % أم انت بالحلم بعد الجهل معذور % 2(@)(@@) % ما يجمع الشوق إن دار بنا شحطت % % ومثلها في تداني الدار مهجور % 3(@)(@@) % نشفى بها وهي داء لو تصاقبنا % % كما اشتفى بعياد الخمر مخمور % 4(@)(@@) % ما روضة من رياض الحزن باكرها % % بالنبت مختلف الألوان ممطور % 5(@)(@@) % يوما بأطيب منها نشر رائحة % بعد المنام إذا حب المعاطير % 6(@)(@@) % ما أنس لا أنسها والدمع منسرب % كأنه لؤلؤ في الخد محدور % 7(@)(@@) % لما رأيتهم زمت جمالهم % صدقت ما زعموا والبين محذور % 8(@)(@@) % يحدو بهن أخو قاذورة حذر % كأنه بجميع الناس موتور % 9(@)(@@) % كأن أظعانهم تحدى مقفية % نخل نعينين ملتف مواقير % 10(@)(@@) % غلب الرقاب سقاها جدول سرب % أو مشعب من أتي البحر مفجور % PageV01P081 11(@)(@@) % هل تبلغني علي الخير ذعلبة % حرف تزلل عن أصلابها الكور % 12(@)(@@) % من خلفها قلص تجري أزمتها % % قد مسهن مع الإدلاج تهجير % 13(@)(@@) % يخبطن بالقوم أنضاء السريح وقد % % لاذت من الشمس بالظل اليعافير % 14(@)(@@) % حتى إذا انتصب الحرباء وانتقلت % وحان إذ هجروا بالدو تغوير % 15(@)(@@) % قالوا تنحوا فمسوا الأرض فاحتولوا % % ظلا بمنخرق تهفو به المور % 16(@)(@@) % ظلوا كأن عليهم طائرا علقا % يهفو اذا انسفرت عنه الأعاصير % 17(@)(@@) % لوجهة الريح منه جانب سلب % وجانب بأكف القوم مضبور % 18(@)(@@) % حتى إذا أبردوا قاموا إلى قلص % كأنهن قسي الشوحط الزور % 19(@)(@@) % عواسل كرعيل الربد أفزعها % % بالسي من قانص شل وتنفير % 20(@)(@@) % حتى سقى الليل سقي الجن فانغمست % في جوزه إذ دجا الآكام والقور % PageV01P082 21(@)(@@) % غطى النشاز مع الآكام فاشتبها % % كلاهما في سواد الليل مغمور % 22(@)(@@) % إن عليا لميمون نقيبه % بالصالحات من الأفعال مشهور % 23(@)(@@) % صهر النبي وخير الناس مفتخرا % فكل من رامه بالفخر مفخور % 24(@)(@@) % صلى الطهور مع الأمي أولهم % قبل المعاد ورب الناس مكفور % 25(@)(@@) % مقاوم لطغاة الشرك يضربهم 
ms23	 % % حتى استقاموا ودين الله منصور % 26(@)(@@) % بالعدل قمت أمينا حين خالفه % % أهل الهوى وذوو الأهواء والزور % 27(@)(@@) % ياخير من حملت نعلا له قدم % بعد النبي لديه البغي مهجور % 28(@)(@@) % أعطال ربك فضلا لا زوال له % % من أين أنى له الأيام تغيير % PageV01P083 البحر : طويل 1(@)(@@) % وليلة مشتاق كأن نجومها % % تفرقن عنها في طيالسة خضر % PageV01P084 البحر : طويل 1(@)(@@) % كأن امرأ لم يلق عيشا بنعمة % إذا نزلت بالمرء قاصمة الظهر % PageV01P085 البحر : طويل 1(@)(@@) % صموت وقوال فللحلم صمته % وبالعلم يجلو الشك منطقه الفصل % 2(@)(@@) % فتى لم يدع رشدا ولم يأت منكرا % ولم يدر من فضل السماحة ما البخل % 3(@)(@@) % به أنجبت للبدر شمس منيرة % مباركة ينمي بها الفرع والأصل % 4(@)(@@) % إذا كان نجل الفحل بين نجيبة % وبين هجان منجب كرم النجل % PageV01P086 البحر : طويل 1(@)(@@) % وليس لمن يركب الهول بغية % وليس لرحل حطه الله حامل % 2(@)(@@) % إذا أنت لم تقصر عن الجهل والخنا % % أصبت حليما أو أصابك جاهل % PageV01P087 البحر : طويل 1(@)(@@) % أترجو اعتذاري يابن أروى ورجعتني % % عن الحق قدما غال حلمك غول % 2(@)(@@) % وإن دعائي كل يوم وليلة % عليك بما أسديته لطويل % 3(@)(@@) % وإن اغترابي في البلاد وجفوتي % % وشتمي في ذات الإله قليل % PageV01P088 البحر : بسيط تام 1(@)(@@) % طاف الرماة بصيد راعهم فإذا % % بعض الرماة بنبل الصيد مقتول % PageV01P089 البحر : طويل 1(@)(@@) % له عنق تلوي بما وصلت به % % ودفان يشتفان كل ظعان % PageV01P090 البحر : وافر تام 1(@)(@@) % لعمرك ماخشيت على أبي % مصارع بين قو فالسلي % 2(@)(@@) % ولكني خشيت على أبي % جريرة رمحه في كل حي % 3(@)(@@) % من الفتيان محلول ممر % وأمار بإرشاد وغي % 4(@)(@@) % ألا لهف الأرامل واليتامى % % ولهف الباكيات على أبي % PageV01P091 
