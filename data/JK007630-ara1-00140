ms121	 ومسارحا % % 25(@)(@@) % و بحر من الآل الغرور محرم % ركبت له من سير لاحق سابحا % % 26(@)(@@) % إلى حاجة في طرقها الجد كله % % فأدركتها جذلان أحسب مازحا % % 27(@)(@@) % و مضطغن أن قدمتني زوائد % من الفضل أخفته وقد كان واضحا % % 28(@)(@@) % يعيرني الحدثان وهو أعز لي % % كفى جذعا أن فاتك الشوط قارحا % % 29(@)(@@) % و هل ضائري شيئا إذا جئت آخرا % % تأخر ميلادي وقد جئت فاصحا % % 30(@)(@@) % و هر فلم يطرد فعض سفاهة ؛ % و عقرك لي أني حقرتك نابحا % % PageV01P352 31(@)(@@) % و زنت بحلمي جهله لا أجيبه % % فلله منا من تمكن راجحا % % 32(@)(@@) % و عجماء من وحش القوافي خدعتها % % و لم تعط قبلي جلدها قط ماسحا % % 33(@)(@@) % خطبت إليها عذرها فتحللت % و كانت حراما لا تلامس ناكحا % % 34(@)(@@) % و عادتها في المدح ألا أذيلها % % و لكن قوما يكرمون المدائحا % % 35(@)(@@) % تمنى بني عبد الرحيم ومجدهم % % رجال أمان لم يقعن نجائحا % % 36(@)(@@) % و ريموا فما حط الثريا لباعه % % فتى ظنها كفا فمد مصافحا % % 37(@)(@@) % كرام مضوا بالجود إلا صبابة % أعاروا نداها الهاطلات السوافحا % % 38(@)(@@) % لهم من تليد العز ما يدعونه % % إذا خفت في دعوى الحسيب القوادحا % % 39(@)(@@) % إذا نشروا الأغصان من شجراتهم % % على ناسب عدوا الملوك الجحاجحا % % 40(@)(@@) % تواصوا فطابوا في الحياة وأكرموا % % نفوسا وطابوا ميتين ضرائحا % % PageV01P353 41(@)(@@) % و أخفى الحسين خطفهم بشعاعه % كما أخفت الشمس النجوم اللوائحا % % 42(@)(@@) % فتى لا يريد المجد إلا لنفسه % % و لا المال إلا قسمة ومنائحا % % 43(@)(@@) % ينازع أزمات السنين بأنمل % جوابر للأحوال تسمى جوارحا % % 44(@)(@@) % أنامل من يسر إذا ما أدارها % % على مغلقات الرزق كن مفاتحا % % 45(@)(@@) % أقام على وجه الطريق بوجهه % % مجير النهار عاقر الليل ذابحا % % 46(@)(@@) % بحيث السماح لا يخيب سائلا % % وحد الصفاح لا يخيبن صائحا % % 47(@)(@@) % إذا عجزت يوما مواعظ صفحه % % عن الأمر ولاه القنا والصفائحا % % 48(@)(@@) % و يأبى فيأتي مشرع الدم واردا % % حريصا ويأتي مشرع الماء قامحا % % 49(@)(@@) % يصيب بأطراف العوالي محاربا % % عداه وأطراف الكلام مصالحا % % 50(@)(@@) % إذا هز رمحا طاعنا خيل كاتبا % % سدادا وطرسا كاتبا 
ms122	 خيل رامحا % % PageV01P354 51(@)(@@) % أقول لأيامي وهن عواثر % % بحظي لعا قد أدرك الذنب صافحا % % 52(@)(@@) % إذا الصاحب استبقيته لي ورهطه % فمرى بقوم طائرات طوائحا % % 53(@)(@@) % أذموا على الآمال لي وتعاقدوا % % على وقع خلاتي أكفا نواصحا % % 54(@)(@@) % غبرت زمانا أمنع الناس مقودي % % حرونا إلى غير المطامع طامحا % % 55(@)(@@) % أعز فلا ألقى ابن مال مؤملا % % لمال ولا يلقاني الدهر مادحا % % 56(@)(@@) % مع الناس جرا خاطري غير أنهم % % بأخلاقهم يستعبدون القرائحا % % 57(@)(@@) % و ما كنت في طرد الخطوب بيمنهم % % بأول داج يستضيء المصابحا % % 58(@)(@@) % بك اعتدلت حوشية من تصعبي % % و راخيت من أنسي فأصبح سازحا % % 59(@)(@@) % صحبتك لم يمسح عذاري سواده % % و ها أنا قد غطى سوادي المسائحا % % 60(@)(@@) % و سديت عندي نعمة ليس ناهضا % % ثنائي بها ما لم أجدك مسامحا % % PageV01P355 61(@)(@@) % فكن سامعا في كل نادي مسرة % سوارد في الدنيا ولسن بوارحا % % 62(@)(@@) % حوامل أعباء الثناء خفائفا % % صعدن الهضاب أو هبطن الأباطحا % % 63(@)(@@) % يرى المفصح المفتون عجبابشعره % لها ناقصا ما سره منه رازحا % % 64(@)(@@) % إذا قمت أتلوها اقشعر كأنني % % تلوت مزاميرا بها ومسابحا % % 65(@)(@@) % تزورك لا زالت تزور بشائرا % % يسوق التهاني وفدها والمفارحا % % 66(@)(@@) % يضم الزمان شمل عزك نظمها % % و يطرح من عادي علاك المطارحا % % PageV01P356 البحر : - 1(@)(@@) % أيا ليل جو من بشيرك بالصبح % و هل من مقيل بعد في ظلل الطلح % 2(@)(@@) % و ماؤكم استشفيت زمزم بعده % % فما بردت لوحي ولا رفدت جرحي % % 3(@)(@@) % سرقت على سؤر البخيلة نهلة % بها لم أكن أدري أتسكر أم تصحي % % 4(@)(@@) % قضت ساعة بالجو أن ليس عائدا % % بها الدهر في يوم بخيل ولا سمح % 5(@)(@@) % فما لك منها غير لفتة ذاكر % إذا قلت بلت أوقدت لوعة البرح % 6(@)(@@) % أيا صاح والماشي بخير موفق % ترنم بليلي إن مررت على السفح % 7(@)(@@) % و قامر بعيني في الخليط مخاطرا % % عست نظرة منها يفوز بها قدحي % % 8(@)(@@) % و سل ظبية الوادي أأنت أم التي % % حكتك على قلبي بلحظتها تنحى % % 9(@)(@@) % رمت فجنت واستصفحت هي عامد % ألا أين جرم العامدين من الصفح 
ms123	 % 10(@)(@@) % و ليل لبسناه بقربك ناعم % بطائن ما بين القلائد والوشح % PageV01P357 11(@)(@@) % و يضحى ويمسي ضوء وجهك بيننا % % سراجا البدر يمسي ولا يضحى % % 12(@)(@@) % و لما استوى قسم الملاحة فيكما % % تكلمت حتى بان فضلك بالملح % 13(@)(@@) % تذم اطراحي ود قوم ومدحهم % % و ما مسها حمل الهوان ولا طرحي % % 14(@)(@@) % تعاوت على سرح القريض تقصه % ذئاب لها من عجزها نقد السرح % 15(@)(@@) % تجانف عن حلو الكلام وصفوه % % إذا ولعت جهلا وتكرع في الملح % 16(@)(@@) % إذا كان للتقبيل والشم أصبحت % % تماضغه ما بين أنيابها القلح % 17(@)(@@) % ترى كل علج يحسب المجد جفنة % تراوح أو قعبا يخمر للصبح % 18(@)(@@) % إذا رشحت من بهره وانتفاخه % % أياطله ظن الفصاحة في الرشح % 19(@)(@@) % إذا معجزات الشعر عارضن فهمه % % حلبن بكيئا لا تدر على المسح % 20(@)(@@) % لكل غريب نادر في فؤاده % % و أحقاده فعل النكاية في القرح % PageV01P358 21(@)(@@) % إذا الغيظ أو جهل الفضيلة عاقه % % عن المدح في شيء تجمل بالقدح % 22(@)(@@) % و كم دون حر القول من جنح ليلة % إذا أظلمت لم يور فيها سوى قدحي % % 23(@)(@@) % و قافية باتت تحارب ربها % % فنازلتها شيئا فألقت يد الصلح % 24(@)(@@) % وصلت إليها والأنابيب حولها % % تكسر لما كنت عالية الرمح % 25(@)(@@) % إذا شئت أن تبلو أمرأ أين فضله % من النقص فاسمع منه إطراي أو جرحي % % 26(@)(@@) % و كم ملك لو قد سمحت أريته % % بوجه قريضي طلعة النصر والفتح % 27(@)(@@) % إذا ما ترامت عاليات المنى به % % بعيدا تمنى موضع النجم أو مدحي % % 28(@)(@@) % و خل أتى من جانب اللين عاطفا % % فياسره عودي ولان له كشحي % % 29(@)(@@) % وفرت له قسما كفاه وزاده % % فمال به الإسفاف في طلب الربح % 30(@)(@@) % و ساوم غيري المدح يرخص عرضه % فلم يغني بخلي عليه ولا شحي % % PageV01P359 31(@)(@@) % فأصبحت كالبيضاء ضرت فغاظها % % بسوداء والعجزاء غارت من الرسح % 32(@)(@@) % و لكن ماسرجيس من لا ترده % % عن الجد حنات الطباع إلى المزح % 33(@)(@@) % و لا تقتضي ممطولة الحق عنده % % و لا يكسب الإنصاف بالكد والكدح % 34(@)(@@) % إذا نال بيضات الأنوق 
ms124	 ميسرا % % له وكرها لم تسبه بيضة الأدحى % % 35(@)(@@) % كريم الوفاء أملس العرض طاهر % إذا دنس الأعراض عولج بالرضح % 36(@)(@@) % تضيق صدور بالخطوب وصدره % إلى فرجات من خلائقه فسح % 37(@)(@@) % يشير بصغرى قولتيه فيكتفي % % بهاو ذباب السيف يقطع بالنفح % 38(@)(@@) % غزير إذا استملى البلاغة فكره % سقى بقليب لا يغور بالنزح % 39(@)(@@) % تدبر من بيت الوزارة باحة % له السبق فيها والجذاع من القرح % 40(@)(@@) % إذا زلقت يوما بأقدام معشر % فمالت مشي فيها قويما على الصرح % PageV01P360 41(@)(@@) % أخذتم بأحقاد قديم وقودها % % عليكم ونار الضغن تحرق باللفح % 42(@)(@@) % و غاظت علاكم حاسديكم فنفرت % فتوق كبود لا تعالج بالنصح % 43(@)(@@) % وجوه اليكم ضاحكات وتحتها % % دخائل نيات معبسة كلح % 44(@)(@@) % وددتك لم أذخر هواك نصيحة % أروح بها ملء الفؤاد كما أضحى % % 45(@)(@@) % حببتك من سلمى وأغدو بشفرة % على عنق من أبغضت من منطقي أنحى % % 46(@)(@@) % و كم من فتاة قد منحتك رقها % % على العز لم أمنن عليك بها منحى % % 47(@)(@@) % لها بين يوم المهرجان مواقف % لديك وبين الصوم عندك والفصح % 48(@)(@@) % أدلت بحسن فهي تبرز سافرا % % إذا اختمرت أخرى حياء من القبح % 49(@)(@@) % إذا المنشد الراوي بها قام خلته % يناوب ترجيع الحمامة بالسجح % 50(@)(@@) % و إن أبطأت عاما عليك سماؤها % % فعندك سلف من مرازمها الدلح % PageV01P361 51(@)(@@) % و لا ذنب لي إن أعقمتني عوائق % من الدهر يوما أن يقصر بي لقحي % % PageV01P362 البحر : - 1(@)(@@) % من عذيري يوم شرقي الحمى % % من هوى جد بقلب مزحا % % 2(@)(@@) % نظرة عادت فعادت حسرة % قتل الرامي بها من جرحا % % 3(@)(@@) % قلن يستطردن بي عين النقا % % رجل جن وقد كان صحا % % 4(@)(@@) % لا تعد إن عدت حيا بعدها % % طارحا عينيك فينا مطرحا % % 5(@)(@@) % قد تذوقت الهوى من قبلها % % و أرى معذبه قد أملحا % % 6(@)(@@) % سل طريق العيس من وادي الغضا % % كيف أغسقت لنا رأد الضحى % % 7(@)(@@) % ألشيء غير ما جيراننا % % نفضوا نجدا وحلوا الأبطحا % % 8(@)(@@) % يا نسيم الصبح من كاظمة % شد ما هجت الجوى والبرحا % % 9(@)(@@) % الصبا إن كان لا بد الصبا % % إنها كانت 
ms125	 لقلبي أروحا % % 10(@)(@@) % يا نداماي بسلع هل أرى % % ذلك المغبق والمصطحبا % % PageV01P363 11(@)(@@) % اذكرونا ذكرنا عهدكم % رب ذكرى قربت من نزحا % % 12(@)(@@) % و اذكروا صبا إذا غنى بكم % % شرب الدمع وعاف القدحا % % 13(@)(@@) % رجع العاذل عني آيسا % % من فؤادي فيكم أن يفلحا % % 14(@)(@@) % لو درى لا حملت ناجية % رحله فيمن لحاني ما لحا % % 15(@)(@@) % قد شربت الصبر عنكم مكرها % % و تبعت السقم فيكم مسمحا % % 16(@)(@@) % و عرفت الهم من بعدكم % فكأني ما عرفت الفرحا % % 17(@)(@@) % ما لساري اللهو في ليل الصبا % % ضل في فجر برأسي وضحا % % 18(@)(@@) % ما سمعنا بالسرى من قبله % % بابن ليل ساءه أن يصبحا % % 19(@)(@@) % طارق زار وما أنذرنا % % مرغيا بكرا ولا مستنبحا % % 20(@)(@@) % صوحت ريحانة العيش به % % فمن الراعي نباتا صوحا % % PageV01P364 21(@)(@@) % أنكرت تبديل أحوالي ومن % % صحب الدنيا على ما اقترحا % % 22(@)(@@) % شد ما مني غرورا نفسه % % تاجر الآداب في أن يربحا % % 23(@)(@@) % أبدا تبصر حظا ناقصا % % حيثما تبصر فضلا رجحا % % 24(@)(@@) % و المنى والظن باب أبدا % % تغلق الأيدي إذا ما فتحا % % 25(@)(@@) % قد خبرت الناس خبري شيمي % % بخلاء وتسموا سمحا % % 26(@)(@@) % و تولجت على أخلاقهم % % داخلا بين عصاها واللحا % % 27(@)(@@) % و بعثت الماء من صم الصفا % % قبل أن أبعث ظنا منجحا % % 28(@)(@@) % يشتهون المال أن يبقي لهم % % فلماذا يشتهون المدحا % % 29(@)(@@) % يفصح اللحان بالجود وهم % فرط بخل يعجمون الفصحا % % 30(@)(@@) % جرت الحسنى غلاما ماجدا % % لم يطع في الجود إلا النصحا % % PageV01P365 31(@)(@@) % طولوا في حلبة المجد له % % فمضى يتبع رأسا جمحا % % 32(@)(@@) % منجبا من آل إسماعيل لم % % يرو في الأخلاق إلا الملحا % % 33(@)(@@) % كيفما طارت عيافات الندى % % حوله طرن يمينا سنحا % % 34(@)(@@) % لا يبالي أي زند أصلدت % من أتى راحته مقتدحا % % 35(@)(@@) % كلما ضاقت يد الغيث بما % % ملكت جاودها منفسحا % % 36(@)(@@) % لربيب النعمة اجتاب الدجى % % خابط ينفضي قلاصا طلحا % % 37(@)(@@) % حمل الهم وقد أثقله % % جلدة العظم أمونا سرحا % % 38(@)(@@) % توسع البيداء ظهرا خاشعا % % في يد السير ورأسا مرحا % % 39(@)(@@) % لا تبالي ما قضت حاجتها % % ما دمي من 
ms126	 خفها أو قرحا % % 40(@)(@@) % حملت أوعية الشكر له % % و انثنت تحمل منه المنحا % % PageV01P366 41(@)(@@) % أحرز الفضل طريفا تالدا % % و المعالي خاتما مفتتحا % % 42(@)(@@) % و جرى يقص من آياته % % أثر المجد طريقا وضحا % % 43(@)(@@) % نسب كيف ترامت نحوه % % أعين الفخر أصابت مسرحا % % 44(@)(@@) % أملس الصفحة لم تعلق به % % غمزة من قادح ما قدحا % % 45(@)(@@) % عود البدر وقد قابله % % غرة بات بها مستصبحا % % 46(@)(@@) % و رآه البحر أوفى جمة % منه بالنائل لما طفحا % % 47(@)(@@) % و تسامت أعين الشعر إلى % % أن يكون السامع الممتدحا % % 48(@)(@@) % لم تجد أبكاره أو عونه % عنك في خطابها منتدحا % % 49(@)(@@) % غير حرات أراها مهملا % % حقها عندكم مطرحا % % 50(@)(@@) % كم ترى أن يصبر الشعر على % % أن تهينوا مثلها أو يصفحا % % PageV01P367 51(@)(@@) % أنتم استنزلتم عنها يدي % % يعد ما عز بها أن أسمحا % % 52(@)(@@) % و رغبتم في علا أنسابها % % و كرام من ذويها صلحا % % 53(@)(@@) % و أرى مطلكم في مهرها % % دام والمهر على من نكحا % % 54(@)(@@) % وثق الشعر بكم واتصلت % غفلة تخجله فافتضحا % % 55(@)(@@) % فاعذروه إن أتى مقتضيا % % فلقد أنظركم ما صلحا % % 56(@)(@@) % و مضى حول على حول ولم % % ينتج الوعد الذي قد ألقحا % % 57(@)(@@) % اذكروه مثل ما يذكركم % % محسنا واستقبحوا ما استقبحا % % 58(@)(@@) % و اعلموا أن قليب الشكر إن % % هو لم يمدد برفد نزحا % % 59(@)(@@) % و اصبحوا أيامكم واستخدموا % % في المعالي هجنها والصرحا % % 60(@)(@@) % بين نيروز وعيد أمسيا % % رائدي إقبالكم أو اصحبا % % PageV01P368 61(@)(@@) % تكمه الأحداث عنكم إن أرى % % طرفها غيركم أو المحا % % PageV01P369 البحر : - 1(@)(@@) % من الغادي تحط به وتعلو % % نجائب من أزمتها الرياح % 2(@)(@@) % جوافل تحسب الظلمان منها % % أضاء لوجه قانصها الصباح % 3(@)(@@) % فمرت كل شائلة زفوف % لها من غيرها اليد والجناح % 4(@)(@@) % ململمة لها ظهر مصون % و بطن تحت راكبها متاح % 5(@)(@@) % ترى سوط الشمال يشل منها % % طرائد لا يكف لها جماح % 6(@)(@@) % تراوح رجل سائقها يديه % % و لا التعريس منه ولا البراح % 7(@)(@@) % تعب الماء بين قذ وصاف % إذا ما عافت الإبل القماح % 8(@)(@@) % لعلك ترتمي بك أو 
ms127	 سيقضي % % إلى المجد الغدو أو الرواح % 9(@)(@@) % فصل وخلوت من ولهي ووجدي % % و قل ولك السلامة والفلاح % 10(@)(@@) % لمقتدحين في كبدي وساروا % % لواعج ما لقاطنها براح % % PageV01P370 11(@)(@@) % أظنا أنكم بنتم وأبقي % % لبعض الظن إثم أو جناح % 12(@)(@@) % و يحسب بدر عجل أن ليلي % % له من بعد غيبته صباح . % 13(@)(@@) % و أني بعده بمنى ولحظ % ينازعني إلى جذل طماح . % 14(@)(@@) % إذن ففركت بعل المجد منه % % و بنت من العلاء ولا نكاح % 15(@)(@@) % بمن ولمن أريد القلب عنكم % % ليذهل وهو عندكم يراح % 16(@)(@@) % و من بدل وهل عوض وظهري % % بكم يعرى وعزي يستباح % 17(@)(@@) % حملت فراقكم أو قيل جلد % و خلف حشاي أسمة طلاح % 18(@)(@@) % و كيف تغيض لي نزوات دمعي % % و تحت الدمع أجفان قراح . % 19(@)(@@) % فهل فيكم على العدواء آس % فإن البين في كبدي جراح % 20(@)(@@) % ألا عطفا على عيش فساد % يكون له بقربكم صلاح % PageV01P371 21(@)(@@) % و حر قيدته لكم طليقا % % من الناس المكارم والسماح % 22(@)(@@) % و قادته لكم خلا صريحا % % حبائل مدها المجد الصراح % 23(@)(@@) % و أخلاق سقته فأسكرته % و بعض خلائقي الكرماء راح % 24(@)(@@) % نكصت وقد أحال على قرن % له سيفان شوق وارتياح % 25(@)(@@) % كأن دمي الحرام على يديه % % بعيد البين ما لكم المباح % 26(@)(@@) % فمن يك في النوى بطلا فإني % أنا المقتول والبين السلاح % 27(@)(@@) % فجعت بقربكم والعهد طفل % و ساعة وصلنا بكر رداح % 28(@)(@@) % و ما شبعت برؤيتكم لحاظ % سواغب لي ولا برد التياح % 29(@)(@@) % و حتى بعد أملس لم تعلق % له بذيول طيب الوصل راح % 30(@)(@@) % فراق سابق اللقيا وعطف % من الأيام زاحمه اطراح % PageV01P372 31(@)(@@) % و نهزة نهلة لم تحل حتى % % تأجن ماؤها الشيم القراح % 32(@)(@@) % كأن الدهر قامرني عليها % % معالجة فخانتني القداح % 33(@)(@@) % لئن قصرت مساعيها وضاقت % % ففي الأشواق طول وانفساح % 34(@)(@@) % فإن كسرت عصا جلدي عصاها % % فآمالي برجعتها صحاح % 35(@)(@@) % و قد يلد السرور على عقام % و يحيا بعد ما مات المراح % 36(@)(@@) % لعلك يا بن أكرمهم يمينا % % و أقدمهم إذا كره الكفاح 
ms128	 % 37(@)(@@) % و أوسعهم قرى وأعم قدرا % % إذا ما الكلب أعجزه النباح % 38(@)(@@) % بقربك أن ستخبر أو سيقضي % % لهذا الخرق رقع وانتصاح % 39(@)(@@) % فترجع لي ليال صالحات % بكم فاتت وأيام ملاح % 40(@)(@@) % و ينبت تحت ظلكم لحالي % % جناح حصه القدر المتاح % PageV01P373 41(@)(@@) % علقتكم هوى ومنى فما لي % % على الأيام غيركم اقتراح % 42(@)(@@) % و بعت بكم بني دهري ودهري % % فعدت وملء حضني الرياح % 43(@)(@@) % أقول وقد تعرم جرح حالي % % و سد على مطالعي السراح % 44(@)(@@) % و كاشفني وكان مجاملا لي % % عبوس الوجه من زمني وقاح % 45(@)(@@) % و قد منعت غضارتها وجفت % على أخلاقها الأيدي الشحاح % 46(@)(@@) % غدا يا نفس فانتظري أناسا % % هم فرج لصدرك وانشراح % 47(@)(@@) % ستطلع من بني عيسى عليك ال % % أكف البيض والغرر الصباح % 48(@)(@@) % ثقي بغنى ثراك غدا براح % يطل بها جدوبك أو يراح % 49(@)(@@) % و لا تتسغبي أسفا ويأسا % % فعند مغالق الأمر انفتاح % 50(@)(@@) % سينهض سقطتي منهم غلام % عزائمه الأزمة والصفاح % PageV01P374 51(@)(@@) % كريم جاره حرم منيع % على الأيام أو حي لقاح % 52(@)(@@) % كأن الفضل في ناديه صونا % فتاة الحي تمنعها الرماح % 53(@)(@@) % هو ابتدأ الندى لم أحتسبه % % و أوري لي ولم يكن اقتداح % 54(@)(@@) % و درت راحتاه ولم تعصب % و كم من مزنة لا تستماح % 55(@)(@@) % و ظني أن سيشفعها بأخرى % % يسابق سعيه فيها النجاح % 56(@)(@@) % تقوم بها على ميد قناتي % % و تلحم من خصاصتي الجراح % 57(@)(@@) % و تنتج من كرائم رأيه لي % % بجانب جاهه فيها لقاح % 58(@)(@@) % و عندي في الجزاء مسومات % لها بالشكر مغدى أو مراح % 59(@)(@@) % حلى الأعراض تضحك في تريب % لها عقد وفي صدر وشاح % 60(@)(@@) % لها الغرضان من معنى دقيق % تقوم بنصره كلم فصاح % PageV01P375 61(@)(@@) % أبوها فارس وكأن قومي % % بها عدنان أو داري البطاح % 62(@)(@@) % و أفضل ما جزيت أخا بود % و إحسان ثناء وامتداح % PageV01P376 البحر : - 1(@)(@@) % قل للزمان صلحا % % قد عاد ليلي صبحا % % 2(@)(@@) % جاد فزار قمر % كان لوى وشحا % % 3(@)(@@) % يلبس جنحا من دجى ال % % ليل وينضو جنحا % % 4(@)(@@) % فرد ريحا 
ms129	 ناششقا % % كاظمة والسفحا % % 5(@)(@@) % كان فأر تاجر % أنحى عليها ذبحا % % 6(@)(@@) % يبعث منها برده % % مع النسيم نفحا % % 7(@)(@@) % غلس شوقا وأصا % % ب فرصة فأضحى % % 8(@)(@@) % طال به الليل نعي % % ما والنهار سبحا % % 9(@)(@@) % يا لسقام آمل % برا به وصحا % % 10(@)(@@) % و رشفة كانت على % % نار حشاي نضحا % % PageV01P377 11(@)(@@) % رش الغليل بردها % % و بل ذاك البرحا % % 12(@)(@@) % كانت سبار كبدي % % و كان شوقي جرحا % % 13(@)(@@) % سل ظبية الوادي تل % % س بانه والطلحا % % 14(@)(@@) % لها بنعمان طلا % تلوي عليه الكشحا % % 15(@)(@@) % أأنت أم ظمياء زر % % ت لاغبين طلحا % % 16(@)(@@) % توسدوا مناسما % % و ركبات قرحا % % 17(@)(@@) % أم جئتنا بسحرها % % تلفتا ولمحا % % 18(@)(@@) % قاربتها ملاحة % % و فضحتك ملحا % % 19(@)(@@) % يا ابنة أم البدر يا % % أخت نجوم البطحا % % 20(@)(@@) % إساءة ومللا % % أزد أسى وصفحا % % PageV01P378 21(@)(@@) % لحا عليك حاسد % و حيث رد لحا % % 22(@)(@@) % حبك خرق لا أرى % % له الملام نصحا % % 23(@)(@@) % فالعذل غش لي ولو % % مات العذول نصحا % % 24(@)(@@) % أنكرت ابتسام أي % % امي وكن كلحا % % 25(@)(@@) % و أبصرت جدى غدا % % فكاهة ومزحا % % 26(@)(@@) % و ما أحست أن رب % % مع الهم قد أمحا % % 27(@)(@@) % و أعذب الشرب الذي % % كان الأجاج الملحا % % 28(@)(@@) % أضحت خطا البين ال % % ي باللقاء تمحى % % 29(@)(@@) % و عاد بالمهذب ال % % دهر البخيل سمحا % % 30(@)(@@) % أهلا وقد مات الحيا % % حتى أمات السرحا % % PageV01P379 31(@)(@@) % و كشرت دردا سنو % % ن أربع وقلحا % % 32(@)(@@) % و عاد ضرع الناب من % % تحت العصاب قرحا % % 33(@)(@@) % بغرة تزيد في % % ليل الجدوب قدحا % % 34(@)(@@) % و بيد يعدى ندا % % ها اللحزين الرسخا % % 35(@)(@@) % إن قطرت فوابلا % % أو هطلت فسحا % % 36(@)(@@) % ميمونة ما مسحت % بساط أرض مسحا % % 37(@)(@@) % إلا كست غدائرا % % هام رباها الجلحا % % 38(@)(@@) % لا تعجبوا إن أصفرت % و مول الأشحا % % 39(@)(@@) % هل يسمن العود يش % % ظى أبدا ويلحى % % 40(@)(@@) % لو أنها بحر لأف % % نتها الحقوق نزحا % % PageV01P380 41(@)(@@) % و مرحبا بهن أخ % % لاقا رطابا سمحا % % 42(@)(@@) % إذا السجايا فترت % عدن نشاوي مرحا % % 43(@)(@@) % أبلج زكاه الندى % % فما يخاف جرحا % % 44(@)(@@) % جهدت 
ms130	 يا عائبه % فهل وجدت قدحا % % 45(@)(@@) % تنح عن مكانه % % من العلا . تنحا % % 46(@)(@@) % يا بن علي فتم ال % % أشواط جدعا قرحا % % 47(@)(@@) % علوتم الناس ترا % % با والنجوم سطحا % % 48(@)(@@) % لم تدعوا ربابة % للمجد تحوي قدحا % % 49(@)(@@) % إلا لكم فورتها % % منحا بها وسنحا % % 50(@)(@@) % طينة بيت أرضه % % فوق السماء تدحى % % PageV01P381 51(@)(@@) % و دوحة أفرط في % % ها من أطال السرحا % % 52(@)(@@) % بثمركم حاملة % و لم تهجن لقحا % % 53(@)(@@) % جملة مجد كنتم % تفصيلها والشرحا % % 54(@)(@@) % كل غلام كافر % تحت اللثام الصحبا % % 55(@)(@@) % يفرع من شطاطه % قبل الركوب الرمحا % % 56(@)(@@) % يرمي بعينيه طمو % % حا في العلا وطرحا % % 57(@)(@@) % كما تفعى أرقم % بالرمل يذكي اللمحا % % 58(@)(@@) % إذا أحس نبأة % كش لها وفحا % % 59(@)(@@) % علقتم تحت شنو % % ف الدهر بلجا قرحا % % 60(@)(@@) % و بعت من بعت بكم % % فعب بحري ربحا % % PageV01P382 61(@)(@@) % زوجت آمالي بكم % % فولدت لي النجحا % % 62(@)(@@) % لولا هنات كالشرا % % ر يلتمعن لفحا % % 63(@)(@@) % و غفلة تحرق في % % وجه الجمال القبحا % % 64(@)(@@) % و حاجة تحفزني % % يضرب عنها صفحا % % 65(@)(@@) % و كم غضبت ثم عد % % ت أستميح الصلحا % % 66(@)(@@) % و شفعت نفسي لكم % % فحال عتبي مدحا % % 67(@)(@@) % يا بدر هذي الشمس مه % % داة إليك نكحا % % 68(@)(@@) % ففز بها وقل لها % % نصرا بكم وفتحا % % 69(@)(@@) % ملكت بلقيس بها % % و ما نقلت الصرحا % % 70(@)(@@) % أقررتها عينا وأع % % ين الأعادي قرحي % % PageV01P383 71(@)(@@) % و اجتل نجما مشرقا % % منها وصبحا صبحا % % 72(@)(@@) % و اذخر ثنائي لبني % % ك كيمياء صحا % % 73(@)(@@) % أنظم منه لهم % قلائدا ووشحا % % 74(@)(@@) % يخطر فيها الحض % % ري بدويا قحا % % 75(@)(@@) % يتلون منه ما تلو % % ن خطباء فصحا % % 76(@)(@@) % ما ألرقض الأيك الحما % % م طربا وسجحا % % 77(@)(@@) % و ما جرى الصوم وجا % % ء الفطر يحدو الأضحى % % PageV01P384 البحر : - 1(@)(@@) % سل في الغضا وصبا الأصائل تنفح % هل ريح طيبة في الذي يستروح % 2(@)(@@) % و هل النوى وقضاؤها متمرد % تركت برامة بانة تترنح % 3(@)(@@) % أم شق ليل الغور عن أقماره % بعدي يد تمطو وطرف يطمح % 4(@)(@@) % أهل القباب و من بهم لمصفد 
ms131	 % بالبعد أتلع بالعراق وأبطحزا % % 5(@)(@@) % جعلوا اللوى وعد اللقاء فقربوا % % و رمت تهامة دونهم فتنزحو % % 6(@)(@@) % و وراءهم عين الغوير وهامة % رعناء من أجإ ورحب صحصح % 7(@)(@@) % و سيال طي في رؤوس صعادها % % و الخيل تزبن في الحديد وترمح % 8(@)(@@) % فمن المطالب والغريم ببابل % و الدين يحجبه الأراك و توضح % % 9(@)(@@) % يا موردي ماء النخيل هناكم % أن تعذبوا وشروب دجلة تملح % 10(@)(@@) % هل في القضية عندكم من نهلة % تروي بها هذي القلوب اللوح % PageV01P385 11(@)(@@) % ترد الغرائب آنسات بينكم % % و أسيركم يجد الفرات فيقمح % 12(@)(@@) % لا سكرة البلوى ببابل بعدكم % % تصحو ولا ليل البلابل يصبح % 13(@)(@@) % كم سهم رام عندكم أهدفته % % قلبي ولكن تقتلون ويجرح % 14(@)(@@) % و تملحت لي ظبية غورية % سنحت وظبيتكم بنجد أملح % 15(@)(@@) % إما عدت عنكم بسيطة عامر % فطراة شيبة بالمناسم يرضح % 16(@)(@@) % و الحرتان وزند ناجر فيهما % % إما يشب لظى وإما يقدح % 17(@)(@@) % فلكم على الزوراء من متعلق % بشكيمتي شعفا ورأسي يجمع % 18(@)(@@) % و كريمة الأبوين أطرق بيتها % % و الليل بابن سمائه متوضح % 19(@)(@@) % و على من ثوبي هواي وعفتي % % شوق يبل وخلوة لا تقبح % 20(@)(@@) % و محجب الأبواب في ربعانه % % أضحت مغالقه لشعري تفتح % PageV01P386 21(@)(@@) % تتراحم الآمال حول بساطه % % عظما ولي منه المكان الأفيح % % 22(@)(@@) % رفض الكلام الوغد يعلم أنه % % يهجي سوى فقري بما هو يمدح % 23(@)(@@) % و مشى يجر قلائدي متخايلا % % فيها يقلد درها ويوشح % 24(@)(@@) % و على السدير و حيرة النعمان لي % % من خاطب لو أن ودي ينكح % 25(@)(@@) % و فتى ذؤابة هاشم آباؤه % % دينا وبيناه منى و الأبطح % 26(@)(@@) % رضع النبوة وارتبي في حجرها % % جذعا على طول الإمامة يقرح % 27(@)(@@) % و رمى بطرفيه السماء فلم يفت % % طرفيه من ذلك المجرة مطرح % 28(@)(@@) % عمرو العلا أدته عن عمرو العلا % % أم متممة وفحل ملقح % 29(@)(@@) % شرف إلى الزهراء مسرى عرقه % و على الوصي فروعه تترشح % 30(@)(@@) % تتهابط الأملاك بين بيوته % % و تطير وهي بهديه تستنجح % PageV01P387 31(@)(@@) % يا راكب الوجناء ينقل رحله % عنق لها ذلل وذيل 
ms132	 ملوح % 32(@)(@@) % تمضي عزوفا لا تغر ببوها % % يلقى السقائط بالفلاة ويطرح % 33(@)(@@) % و اذا أراها الخمس ماء عشية % % عدته قانعة لآخر يصبح % 34(@)(@@) % بلغ كأنك مفصحا غيلان وان % % تفض الطريق كأن عنسك صيدح % 35(@)(@@) % الكوفة البيضاء أن بجوها % % قمرا تغاظ به البدور وتفضح % 36(@)(@@) % عرج وقل لأبي علي مالئا % % أذنيه حيتك الغوادي الروح % 37(@)(@@) % و سقتك كفك فهي أغزر ديمة % ما فلصت عنك السحاب الدلح % 38(@)(@@) % و ازداد مجدك بسطةز إنارة % و علو جدك والجدود تطوح % 39(@)(@@) % فت الصفات فلجلج المثني بما % % تولي وأعجم في علاك المفصح % 40(@)(@@) % فالبدر تم وأنت أكمل صورة % و البحر عم وأنت منه أسمح % PageV01P388 41(@)(@@) % و الخادر الحامي حمى أشباله % لك عن وليجة غابه يتزحزح % 42(@)(@@) % تركت سيادتها العشيرة رغبة % لك في اقتبالك وهي بزل قرح % 43(@)(@@) % و رأت زئيرك دونها فتأخرت % % و ثعالب الأعداء فيها تضبج % 44(@)(@@) % جمعت ألفة عزها وعزيبها % % بقنا العدا طردا يشل ويسرح % 45(@)(@@) % و شفت سيوفك من بني أعمامها % % داء تضيق به الصدور وتبرح % 46(@)(@@) % دين شكوت إلى الحسام مطاله % فقضاه والسيف المشاور أنصح % 47(@)(@@) % دمن على القربي تزيد عداوة % فخروقها ما بينكم لا تنصح % 48(@)(@@) % حسدوا تقدم فضلكم فحقودهم % % لا تنطفي وفسادهم لا يصلح % 49(@)(@@) % زحموك أمس فعاركوا ملمومة % صماء يوقص ركنها من ينطح % 50(@)(@@) % فسقيتهم كأسا مجاجتها الردى % % شربوا على كره لها ما يجدح % PageV01P389 51(@)(@@) % يا جامع الحسنات وهي بدائد % و مرب روض الفضل وهو مصوح % 52(@)(@@) % كف تخف مع الرياح سماحة % و مهابة تزن الجبال وترجح % 53(@)(@@) % قد جاءت الغرر الغرائب طلعا % % كالشهب تثقب في الدجى وتلوح % 54(@)(@@) % ثمر بغرسك قد حلت مجناته % و نتائج من بحر فكرك تلقح % 55(@)(@@) % فنطقن والأشعار خرس عندنا % % و نجون سبقا والقوافي طلح % 56(@)(@@) % فكأن روض الحزن تنشره الصبا % % ما ظلت من قرطاسها أتصفح % 57(@)(@@) % فسوادها من ناظري ما يمحي % % و سدادها من خاطري ما يبرح % 58(@)(@@) % ألفتها من جوهر في النفس لا % % يفنى ومعدن فكرة لا ينزح % 59(@)(@@) % نظمت لي 
ms133	 الحسن المبرز والهدى % % فكأنني بنشيدهن أسبح % 60(@)(@@) % و أما وذرعك في العلاء فإنه % % قسم لباع الصدق فيه مسرح % PageV01P390 61(@)(@@) % ما خلت صدق القول شخصا ماثلا % % يهدى وأن الرفد سحر يمنح % 62(@)(@@) % جاريتها متحذرا من سبقها % % و البرق يكبو عن مداي ويكبح % 63(@)(@@) % و متى أقوم مكافئا بجزائها % % و نداك مفترع بها مستفتح % 64(@)(@@) % كرم تطلع من شريف خلائق % أصفى من المزن العذاب واسجح % 65(@)(@@) % لم أرمه بسهام تقدير ولم % % أطرح له الآمال فيما أطرح % 66(@)(@@) % فلترضينك إن قبلت معوضة % مما أصون بحائل تتنفح % 67(@)(@@) % سيارة في الخافقين فذكرها % % ذكر الغمائم باكر متروح % 68(@)(@@) % تجزي الرجال بصدقهم فصديقها % % في غبطة وعدوها لا يفرح % 69(@)(@@) % مجنوبة لك لا تزال جباهها % % أبدا على السبق المبرح تمسح % 70(@)(@@) % فامدد لها رسن الرجاء فإنها % % بالود تشكم والكرامة تشبح % PageV01P391 71(@)(@@) % مهما تعرض للرجال بدينها % % فمديحها لك بالغلو يصرح % PageV01P392 البحر : - 1(@)(@@) % أتكتم يوم بانة أم تبوح % و أجدر لو تبوح فتستريح . % 2(@)(@@) % حملت البين جلدا والمطايا % % بوازلها بما حملت طلوح % 3(@)(@@) % و قمت وموقف التوديع قلب % يطير به الجوى وحشا تطيح % 4(@)(@@) % تلاوذ حيث لا كبد تلظى % % بمعتبة ولا جفن قريح % 5(@)(@@) % فهل لك غير هذا القلب تحيا % % به أو غير هذي الروح روح % 6(@)(@@) % لعمر أبي النوى لو كان موتا % % جنت لك فهو موت لا يريح % 7(@)(@@) % يفارق عاشق ويموت حي % و خيرهما الذي ضمن الضريح % 8(@)(@@) % و قال العاذلون البعد مسل % فما لجواك ضاعفه النزوح . % 9(@)(@@) % و في الأظعان طالعة أشيا % أبو لونين مناع منوح % 10(@)(@@) % سلافة ريقه بسل حرام % و وردة خده مما يبيح % PageV01P393 11(@)(@@) % إذا كتمته خالفة وخدر % وشى بمكانه المسك النضيح % 12(@)(@@) % أسارقه مسارقة ودون ال % % خلاط به الأسنة والصفيح % 13(@)(@@) % و لم أر صادق العينين قبلي % % أضل فدله شم وريح % 14(@)(@@) % أيا عجبا يهتك في سلاحي % % و قد حطم القنا طرف طموح % 15(@)(@@) % و يقنصني على إضم وقدما % % قنصت أسودها رشأ سنيح % 16(@)(@@) % رمى كبدي وراح وفي يديه % % نضوح دمي فقيل 
ms134	 هو الجريح % 17(@)(@@) % و أرسل لي مع العواد طيفا % % يرى كرما وصاحبه شحيح % 18(@)(@@) % إذا كرب الرمي يبل شيئا % % ألم فدميت تلك القروح % 19(@)(@@) % فقال كم القنوط وأنت تحيا % % و كم تأتي الغني وتستميح % 20(@)(@@) % شكوت و من أرى رجل صحيح . % فقلت له وهل يشكو الصحيح % PageV01P394 21(@)(@@) % فما لك يا خيال خلاك ذم % أتاحك لي على النأي المتيح . % 22(@)(@@) % فكيف وبيننا خيطا زرود % قربت عليك والبلد الفسيح . % 23(@)(@@) % أعزم من زعيم الملك تسري % % به أم من ندى يده تميح % 24(@)(@@) % حملت إذا على ملك كريم % % إلى رحلي يعود بك المسيح % 25(@)(@@) % و جئت بنائل لا البحر منه % % بمنتصف ولا الغيث السفوح % 26(@)(@@) % حمى الله ابن منجبة حماني % % و قد شلت على الراعي السروح % % 27(@)(@@) % و سد بجوده خلات حالي % % و قد ضعفت على الخرق النصوح % 28(@)(@@) % تكفل من بني الدنيا بحاجي % % نتوج في عقائمها لقوح % 29(@)(@@) % تفرغ لي وقد شغل المواسي % % و خالصني وقد غش الصريح % 30(@)(@@) % و قام بنصر سؤدده فسارت % مطالعه وأنجمهم جنوح % PageV01P395 31(@)(@@) % حلت مدحي لقوم لم يهشوا % % و غناه فأطربه المديح % 32(@)(@@) % كأن الشعر لم يفصح لحي % سواه وكلهم لحن فصيح % 33(@)(@@) % جواد في تقلب حالتيه % % فلا سعة تبين ولا رزوح % 34(@)(@@) % إذا قامت له في الجود سوق % فكل متاجر فيها ربيح % 35(@)(@@) % تمرن في السيادة منه ماض % على غلوائه لا يستريح % 36(@)(@@) % جرى متدفقا في حلبتيها % % كما يتدفق الطرف السبوح % 37(@)(@@) % و جمع ملك آل بويه منه % % على ما شتت الكافي النصيح % 38(@)(@@) % يقلب منه أنبوبا ضعيفا % % تدين له الصفائح والسريح % 39(@)(@@) % و كان الفارس القلمي يبلى % % بحيث يعرد البطل المشيح % 40(@)(@@) % ورى بضيائه والليل داج % خفوق النور منبلج وضوح % PageV01P396 41(@)(@@) % أضل الناس في طرق المعالي % % سبيلا بين عينيه يلوح % 42(@)(@@) % و ضم الحبل محلولي مريرا % أخو طعمين منتقم صفوح % 43(@)(@@) % فيوم الأمن وراد شروب % و يوم الغبن عياف قموح % 44(@)(@@) % أبا حسن عدوك من ترامى % % به الرجوان والقدر الجموح % 45(@)(@@) % إلى متمرد المهوى عميق 
ms135	 % فتطرحه مهالكه الطروح % 46(@)(@@) % تفرس في الغزالة وهو أعشى % % ليقدح في محاسنها القدوح % 47(@)(@@) % يناطح صخرة بأجم خاو % أيا سرعان ما حطم النطيح % 48(@)(@@) % بحقك ما أبحتك من فؤادي % % مضايق لم ينلها مستميح % 49(@)(@@) % أصارك وهي خافية إليها % % ودادك لي ونائلك السجيح % 50(@)(@@) % فإن أخرست ريب الدهر عني % بعونك والنوائب بي تصيح % PageV01P397 51(@)(@@) % و لم تبعلك بي مترادفات % من الحاجات تغدو أو تروح % 52(@)(@@) % و غيرك حام آمالي عطاشا % % عليه وما يبل لهن لوح % 53(@)(@@) % تزاور جانبا عن وجه فضلي % % فضاع عليه كوكبي الصبيح % 54(@)(@@) % جفاني لا يعد علي ذنبا % % بأعذار وليس لها وضوح % 55(@)(@@) % أعاتبه لأنقله ويعيا % % بنقل يلملم اليوم المريح % 56(@)(@@) % و كم أغضيت إبقاء على ما % % أتى وسترت لو خفي القبيح % 57(@)(@@) % فلا تعدمك أنت مكررات % على الآفاق تقطن أو تسيح % 58(@)(@@) % لها أرج بنشرك كل يوم % على الأعراض ضوعته تفوح % 59(@)(@@) % تصاعد في الجبال بلا مراق % و يقذف في البحار بها السبوح % 60(@)(@@) % تمر عليك أيام التهاني % % و منهن المبارك والنجيح % PageV01P398 61(@)(@@) % بجيد المهرجان وكان عطلا % % قلائد من حلاها أو وشوح % 62(@)(@@) % بشائر أن عمرك في المعالي % % يعد مضاعفا ما عد نوح % PageV01P399 البحر : - 1(@)(@@) % لمن صاغيات في الحبل طلائح % تسيل على نعمان منها الأباطح % 2(@)(@@) % تخابط أيديها الطيرق كأنها % % موائر في بحر الفلاة سوابح % 3(@)(@@) % دجا ليلها وهي السهام تقامصا % % فلم ينصرم إلا وهن طرائح % 4(@)(@@) % كأن الوجى سر تخاف انتشاره % % فمنها مرم بالتشاكي وبائح % 5(@)(@@) % حملن شموسا في الحدوج غواربا % % و ليل السرى منهن أبلج واضح % 6(@)(@@) % ينوء بها أن القدود خفائف % و يظلعها أن المتون رواجح % 7(@)(@@) % و فيهن منصور السهام مسلط % لعينيه أن تدوى القلوب الصحائح % 8(@)(@@) % يطير جبارا ما أراقت لحاظه % % إذا وفيت حكم القصاص الجرائح % 9(@)(@@) % رماني ونسك الحج بيني وبينه % % و لم يدر أن الصيد في الحج قادح % 10(@)(@@) % طرحت بجمع نظرة ساء كسبها % % و تبعث شرا للعيون المطارح % PageV01P400 11(@)(@@) % فإن سترت تلك الثلاث على منى % هواي فيوم النفر لا 
ms136	 شك فاضح % 12(@)(@@) % بكيت ولام العاذلات فلم تغض % على رقية العذل الدموع السوافح % 13(@)(@@) % و لم أر مثل العين تشفى بدائها % % و لا كالعذول يجتوى وهو ناصح % 14(@)(@@) % أمنك ابنة الأعراب طيف تبرعت % به هبة التغوير والليل جانح % 15(@)(@@) % طوى الرمل حتى ضاق بيني وبينه ال % % عناق وما بيني وبينك فاسح % 16(@)(@@) % فبات على ما ترهبين ركوبه % % هجوما وفيما تمنعين يسامح % 17(@)(@@) % رعى الله قلبا ما أبر بمن جفا % % و أثبت عهدا والعهود طوائح % 18(@)(@@) % و أوسع ذرعا بالوفاء وصونه % إذا ضاق ما تطوى عليه الجوانح % 19(@)(@@) % عذيري من دهري كأني أريده % % على الود سلما وهو قرن مكافح % 20(@)(@@) % و صحبة خوانين بائعهم وإن % % تكثر منهم بالتوحد رابح % PageV01P401 21(@)(@@) % أخوهم أخو الذئب الخبيث يدله % % على الدم ما تملي عليه الروائح % 22(@)(@@) % و أيد سباط وهي بالمنع جعدة % تلاطمني منها اللواتي أصافح % 23(@)(@@) % يضيء على أبصارهم ضوء كوكبي % % و موضعه من مطلع الفضل لائح % 24(@)(@@) % قعدت مع الحرمان بين ظهورهم % % و طائر حظي لو تعيفت سانح % 25(@)(@@) % لقد كان لي عن بابل وجدوبها % % مذاهب يتلوها الغنى ومنادح % 26(@)(@@) % تركت عباب البحر والبحر معرض % و أملت ما تسقى الركايا النوازح % 27(@)(@@) % و لو نهضت بي وثبة الجد زاحمت % على الماء هذى الآبيات القوامح % 28(@)(@@) % إذا لسقاها ناصر الدين ما استقت % كبود حرار أو شفاه ملاوح % 29(@)(@@) % و قد كانت الزوراء دار إقامة % و منعمة فيها المنى والمفارح % 30(@)(@@) % زمان العلا محفوظة في عراصها % % ثقال وميزان الفضائل راجح % PageV01P402 31(@)(@@) % فقد حولت تلك المحاسن وانتهت % إلى غيرها في الأرض تلك المنائح % 32(@)(@@) % و أضحت عمان للمكارم رحلة % تراح عليها المتعبات الروازح % 33(@)(@@) % بها الملك طلق والمغاني غنية ال % % ربا ومساعي الطالبين مناجح % 34(@)(@@) % يضوع ثراها بالندى فتخالها % % رياضا وكانت قبل وهي ضرائح % 35(@)(@@) % يدبرها سبط اليدين بنانه % % لمقفل أرزاق العباد مفاتح % 36(@)(@@) % صفا جوها بعد الكدور بعدله % % و طابت حساياها الخباث الموالح % 37(@)(@@) % فما غيرها فوق البسيطة للعلا % % مقر على أن البلاد فسائح % 38 
ms137	(@)(@@) % و لا ملك إلا وفضلة ربها % % عليه إذا عد الملوك الجحاجح % 39(@)(@@) % بهمة محي الأمة اجتمعت لها ال % % بدائد وانقادت إليها الجوامح % 40(@)(@@) % بأروع وسم الملك فوق جبينه % % إذا ارتابت الأبصار أبلج واضح % PageV01P403 41(@)(@@) % إذا نسب الأملاك لم يخش خجلة ال % % دعاوى ولم تدخل عليه القوادح % 42(@)(@@) % من النفر الغر الذين ببأسهم % % و نعمائهم تلقى الخطوب الفوادح % 43(@)(@@) % إذا ما دجت عشواء أمر فأمرهم % % و نهيهم شهب لها ومصابح % 44(@)(@@) % لهم قصبات السبق في كل دولة % % هم السر منها والعتاق الصرائح % 45(@)(@@) % ينالون أقصى ما ابتغوه بأذرع % % مخاصرها صم القنا والصفائح % 46(@)(@@) % أصول علا منصورة بفروعها % % إذا غاب ممس منهم هب صابح % 47(@)(@@) % و رب يمين الدولة المجد بعدهم % % كما ربت الروض الغيوث السوافح % 48(@)(@@) % جرى جريهم ثم استتم بسبقه % % و كم وقفت دون الجذاع القوارح % 49(@)(@@) % همام مع الإصرار مصطلم لمن % % عصى ومع الإقرار بالذنب صافح % 50(@)(@@) % تسنم أعواد السرير محجب % لواحظه شرقا وغربا طوارح % PageV01P404 51(@)(@@) % تراصد جرى الأرض رجعات طرفه % % كما ركب المرباة أزرق لامح % 52(@)(@@) % ألا أيها الغادي ليحمل حاجتي % % لعلك إن بلغت بالنجح رائح % 53(@)(@@) % أعد في مقر العز عني تحية % يذكي النسيم طيبها المتفاوح % 54(@)(@@) % و قل عبدك المشتاق لا عهده عفا % % و لا وجده إن نقل الوجد نازح % 55(@)(@@) % و من لم يخيب قط عالي ظنونه % % لديك ولم تخدج مناه اللواقح % % 56(@)(@@) % و أغنيته عمن سواك فلم يبل % جفا مانع أو بر بالرفد مانح % 57(@)(@@) % قليب قريب لي ببغداد ماؤها % % و منبعها شحط النوى متنازح % 58(@)(@@) % لها كل عام من سماحك ناهز % و من عهدك الوافي رشاء وماتح % 59(@)(@@) % إذا ما استدر الشكر سلسال صوبها % % و جاءك عني تمتريها المدائح % 60(@)(@@) % أتتني وبطن البحر ظهر مطيها % % فروت غليلي والسفين النواضح % PageV01P405 61(@)(@@) % و ما زادها التنقيص إلا غزارة % و إلا صفاء طول ما أنا نازح % 62(@)(@@) % تبل ثرى أرضي وجسمي وادع % و تثمر لابني وهو ساع مكادح % 63(@)(@@) % كلانا سقى من عفوها وزلاها % % و إن 
ms138	 حبستني عقلتي وهو بارح % 64(@)(@@) % فلله مولى منك ما لي عنده % % و متجر من يدلي بجاهي رابح % 65(@)(@@) % و ها هو قد كرت اليك رجاءه % سوائر حاج طيرهن سوانح % 66(@)(@@) % فأمرك زاد الله أمرك بسطة % بما عودت تلك السجايا السحائح % 67(@)(@@) % أعن جهده واعرف له خوض زاخر % يهز الضلوع موجه المتناطح % 68(@)(@@) % و لم أستزد نعماك إلا ضرورة % و قد تستزاد المزن وهي دوالح % 69(@)(@@) % بما ثقلت ظهري الخطوب وضاعفت % تكاليف عيشي وانتحتني الجوائح % 70(@)(@@) % و ما بث من زغب حوالي كالقطا % % تنزى الشرار أعجلتها المقادح % PageV01P406 71(@)(@@) % أمسح منهم كل عطف أسفت إذ % % أتاني وقد بيضن مني المسائح % 72(@)(@@) % نجوت على عصر الشبيبة منهم % و أرهقني المقدار إذ أنا قارح % 73(@)(@@) % فدتك ملوك ذكر مجدك بينهم % % مثالب في أعراضهم وجرائح % 74(@)(@@) % إذا لعنوا صلت عليك محافل % صفاتك قرآن لها ومسابح % 75(@)(@@) % حموا مالهم أن تنتحى بنقيصة % % عقائله والساريات السرائح % 76(@)(@@) % و مالك في الآفاق شتى موزع % كرائمه والباقيات الصوالح % 77(@)(@@) % سهرت ونام الناس عما رأيته % % كأنك للعلياء وحدك طامح % 78(@)(@@) % و جاريت سيب البحر ثم فضلته % % و هل يستوي البحران عذب ومالح % 79(@)(@@) % أعرني سمعا لم تزل مطربا له % % إذا ما تغنته القوافي الفصائح % 80(@)(@@) % و أصغ لها عذراء لولاك لم تجب % % خطيبا ولم يظفر بها الدهر ناكح % PageV01P407 81(@)(@@) % من الباهرات لم تحدث بمثلها ال % % نفوس ولم توصل إليها القرائح % 82(@)(@@) % ظهرت بها وحدي على حين فترة % من الشعر برهاني بها اليوم لائح % 83(@)(@@) % و من شرف الأشعار أنك سامع % و من شرف الإحسان أني مادح % 84(@)(@@) % و من لي لو أني مثلت مشافها % % أفاوضها أسماعكم وأطارح % 85(@)(@@) % و أن ينهض الجد العثور بهجرة % تعالج أشواقي بها والتبارح % 86(@)(@@) % و يا ليتما ريح الشمال تهب لي % % فتطلعني منها عليك البوارح % 87(@)(@@) % و كيف مطاري والخطوب تحصني % % و أخدي شوطي والليالي كوابح % 88(@)(@@) % و قد كان جبن القلب يقعد عنكم % فقد ساعدته بالنكول الجوارح % 89(@)(@@) % و أقسمت الستون ما لخروقها % % إذا 
ms139	 اتسعت في جلدة المرء ناصح % 90(@)(@@) % و إني على أنسي بأهلي وموطني % % لأعلم أن العيش عندك صالح % PageV01P408 البحر : - 1(@)(@@) % أرى طرفها أن الخضابين واحد % و لكنه ما بهرج الشيب ناقد % 2(@)(@@) % ضلالة حب غادرتني مزورا % % عذاري وإني لو أفقت لراشد % 3(@)(@@) % يقولون عمر الشيب أطول بالفتى % % و ما سرني أني مع الشيب خالد % 4(@)(@@) % أماض فغدار زمان أباحني % % حريم الهوى أم حافظ لي فعائد % 5(@)(@@) % و دارين من عالي الصراة سقتها ال % % بوارق ربعي الهوى والرواعد % 6(@)(@@) % ألفتهما والعيش أبيض ضاحك % بربعهما والظل أخضر بارد % 7(@)(@@) % و ندمان صبحي صاحب متسمح % معي وضجيع الليل إلف مساعد % 8(@)(@@) % و أخرس مما سنت الفرس ناطق % يهب رياحا روحه وهو راكد % 9(@)(@@) % على صدره بالطول سبع ضعائف % تدبرها بالعرض سبع شدائد % 10(@)(@@) % و خمس سكون تحت خمس حوارك % تمد ثلاثا يمتطيهن واحد % PageV01P409 11(@)(@@) % يشرد من حلم الفتى وهو حازم % فيرجع عنه فاسقا وهو عابد % 12(@)(@@) % و قوراء ماء الكرم أحمر ذائب % عليها وماء التبر أصفر جامد % 13(@)(@@) % تمثل بهرام الكواكب قائما % % بها حيث بهرام الأكاسر قاعد % 14(@)(@@) % أميران يخفي قائم السيف قابض % عليه ويبدي درة التاج عاقد % 15(@)(@@) % تبين وحبات المزاج نوازل % و تخفي وحبات الحباب صواعد % 16(@)(@@) % مصالح عيش والفتى من خلالها % % إذا لاحظ الأعقاب فهي مفاسد % 17(@)(@@) % و دنيا لسان الذم فيها محكم % و لكنها عند الحسين محامد % 18(@)(@@) % اليكم بني الحاجات إني رائد % ليحبس جار أو ليبرك واخد % 19(@)(@@) % أب بكم بر وأنتم معقة % أخ لكم دنيا وأنتم أباعد % 20(@)(@@) % حبيب إليه ما غنمتم كأنه % % إذا جاد مرفود بما هو رافد % PageV01P410 21(@)(@@) % أناة ومن تحت القطوب تبسم % أوانا وفي عقب الأناة مكايد % 22(@)(@@) % محاسن لا ينفك ينشر حامد % لها بعض ما بطوي على الغل حاسد % 23(@)(@@) % و لما جلاك الملك في ثوب جسمه % % تراءت على قدر العروس المجاسد % 24(@)(@@) % أثبت بها عذراء ما افتض مثلها % % سوى ربها ما كل عذراء ناهد % 25(@)(@@) % بهائية تعزي لأشرف نسبة % لتيأس منها كل نفس 
ms140	 تراود % 26(@)(@@) % لها أرج للعز باق وإنها % % على عز من تهدى إليه لشاهد % 27(@)(@@) % على منكب الفخر استقرت ولم تكن % % تلاقيك لو لم تدر أنك ماجد % 28(@)(@@) % أبان بها ما عنده لك إنما % % تحلى لإكرام السيوف المغامد % 29(@)(@@) % فزاد بهاء الدولة الله بسطة % على أي علق منك أضحى يزايد % 30(@)(@@) % لئن كان سيفا مرهف الحد إنه % % ليعلم علم الحق أنك ساعد % PageV01P411 31(@)(@@) % أتاني ليلا قر عينا مبشري % % فأيقظن وهنا وإني لراقد % 32(@)(@@) % قمت فكف يشكر الدهر كاتب % ثناك وخد يشكر الله ساجد % 33(@)(@@) % و ناديت فانثالت معان كأن ما % % تنظمه منها القوافي فرائد % 34(@)(@@) % و تنقدن لي ما سرن ظهر مدائحي % % إليك وهن عن سواك حوائد % 35(@)(@@) % و ما كن مع طول القيام صواديا % % ليسرحن إلا حيث تصفو الموارد % 36(@)(@@) % و لست كمن يعطي الأسامي نواله % إذا جاد تقليدا وتلغى القصائد % 37(@)(@@) % و ما الشعر إلا ما أقامت بيوته % % و سارت فأضحى قاطنا وهو شارد % 38(@)(@@) % و ما هو إلا في رقاب إذا فشا % % به الحفظ أغلال وأخرى قلائد % PageV01P412 البحر : - 1(@)(@@) % أقامت على قلبي كفيلا من العهد % يذكرني بالقرب في دولة البعد % 2(@)(@@) % فقولا لواشيها وإن كان صادقا % % وفائي لها أحظى ولو غدرت عندي % % 3(@)(@@) % خليلي ما للريح هبت مريضة % هل اجتدت البخال أم حملت وجدي % % 4(@)(@@) % ضمنت من الداءين ما لا تقله % على طرحها الشم الهضاب من الصلد % 5(@)(@@) % حنين ولكن من لشملي بجامع % % و مد يد لكن من الرجل المجدي % % 6(@)(@@) % فلا حب بل لاحظ نالك حظه % % قد اشترك الأحباب والحظ في الصد % 7(@)(@@) % و سمى زماني طول صبري تجلدا % % عدمتك ما أبقيت بعدي للجلد % 8(@)(@@) % كما ذم من قبلي ذممتك عالما % % بأنك موقوف على الذم من بعدي % % 9(@)(@@) % و لكن تجاوز لي بصرفك ماجدا % % إليه إذا جارت صروفك أستعدي % % 10(@)(@@) % إذا الصاحب استنجدته فوجدته % فرعني فيمن غيره شئت بالفقد % PageV01P413 11(@)(@@) % و إن مر في الأحباب عيش بغيره % % فحسبي بعلم الله في ذاك والحمد % 12(@)(@@) % و ما أعرف 