ms101	 مقتضى الأسماء وهي جميعها % % هي الوجه وجه الله في النص وارد % % 9(@)(@@) % وللوجه كان الروح مرآته التي % % تلوح بها آثاره والمقاصد فتظهر في الروح العوالم كلها عكوس مرادات الإله شوارد % % 10(@)(@@) % وترتيبها في العلم يظهر هكذا % % لدينا فمولود وأم ووالد % % PageV01P495 11(@)(@@) % ومن حسن في المرآة صورة وجهه % % فللوجه والمرآة ذا الحس نافد % % 12(@)(@@) % وبالصورة المرآة عنه تسترت % % فظن الذي قد ظن والعقل راقد % % 13(@)(@@) % ومن أجل هذا قال أهل طرينا % % خيال وظل ما عن الحق وافد % % 14(@)(@@) % ولم يعرف المسكين ما قال عارف % % وقد ظن سوءا وهو للحق جاحد % % 15(@)(@@) % فلو وفق الرحمن ذلك للهدى % % رأى نقصه في نفسه فيجاهد % % 16(@)(@@) % ويصبح مشغولا ويمسي بنفسه % % وقلب له في كل ما عاق زاهد % % 17(@)(@@) % ولكنه الممقوت من حكم ربه % % عليه ولا يدري وما هو راشد % % PageV01P496 البحر : - 1(@)(@@) % ما بين سلع وروض بالحمى نادي % % لي قلب ضائع عليه قف ههنا نادي % % 2(@)(@@) % يا سائق الظعن كم مجلس وكم نادي % % فيه افتضحنا على من كفه نادي % % PageV01P497 البحر : - 1(@)(@@) % بادي حبيبي بشكوى حالتي بادي % % يا كاتم السر لي سر الهوى بادي % % 2(@)(@@) % والقلب خاتم لقرآن الوفا بادي % % حاضر بتلك المدينة والجسد بادي % % PageV01P498 البحر : - 1(@)(@@) % لي من هوادي المطايا مذ هوت هادي % % يمتد نحو الحمى حيث الدجى هادي % % 2(@)(@@) % وسر قلبي وحق الحب يا هادي % % لو تطلب الروح مني قلت لك هادي % % PageV01P499 البحر : - 1(@)(@@) % خالق الكل واحد % % وهو للكل قاصد % % 2(@)(@@) % وتأمله فهو في % % أنت والكل شاهد % % 3(@)(@@) % فإذا قلت إنني % % أنا والكل واحد % % 4(@)(@@) % قلت حقا إذا انتفى % % عنك ما أنت جاحد % % 5(@)(@@) % حيث لا نفس تدعى % % ما ترى أو تعاند % % 6(@)(@@) % حيث لم يخف عنك ما % % أنت فيه معاهد % % 7(@)(@@) % من فناء محقق % % في وجود يشاهد % % 8(@)(@@) % حيث لا غيره ولا شيء يلقله واجد % . . . % 9(@)(@@) % فاعتبر ما أقوله % % دون ما قال حاسد % % 10(@)(@@) % وتحقق به وكن % % عين كن يا ساعد % % PageV01P500 11(@)(@@) % تلق كن عينه بلا % % أحرف هم زوائد % % 12(@)(@@) % إنما الحرف عندنا % % طرف 
ms102	 عنه حائد % % 13(@)(@@) % وهو حد لمطلق % % عنه فيه الفوائد % % PageV01P501 البحر : - 1(@)(@@) % عرجا بي على النقا فجياد % % وامشيا بي كمشية المتهادي % % 2(@)(@@) % يا خليلي وانشدا قلب صب % % ضاع منه خلال تلك البوادي % % 3(@)(@@) % لي بسلع فرامة فالمصلى % % جيرة بل بناظري وفؤادي % % 4(@)(@@) % هم بقلبي حلوا مكان السويدا % % ومن العين في مكان السواد % % 5(@)(@@) % ظهرت نشأتي بهم وهي منهم % % في شخوص الأرواح والأجساد % % 6(@)(@@) % أنا إلا كلامهم بحروف % % عاليات ظلالها في الوهاد % % 7(@)(@@) % كلموا نفسهم بنا فتكلمنا % % بهم في الثلاث والآحاد % % 8(@)(@@) % وهم الظاهرون هم لا سواهم % % وسواهم تصويرهم للمراد % % 9(@)(@@) % واسمهم ما به الجميع تسمى % % عندهم في النزول للأعداد % % 10(@)(@@) % حيث كانوا على المراتب منا % % في ظهور وخفية بازدياد % % PageV01P502 11(@)(@@) % قل لهم يا أنا يجودوا علينا % % باللقا إننا لبالمرصاد % % 12(@)(@@) % سعدت مقلة بهم قد رأتهم % % فرأت ما رأت على المعتاد % % 13(@)(@@) % يا عريب الحمى قفوا الضعيف % % جره ركبكم بنغمة حادي % % 14(@)(@@) % كلما أظلمت عليه الدياجي % % لمع البرق فاهتدى للهادي % % 15(@)(@@) % والهوى سائق له ودليل % % في الفيافي على لقاء سعاد % % PageV01P503 البحر : - 1(@)(@@) % أنا كالحرف قائم بالمداد % % بالوجود الحق الكريم الجواد % % 2(@)(@@) % يا مداد الجميع نحن حروف % % بك نبدو وأنت بالمرصاد % % 3(@)(@@) % ولهذا كلا نمد لنا قلت % % فأنت الممد بالإيجاد % % 4(@)(@@) % ما تغيرت أنت حيث ظهرنا % % عنك كم في مثنى وفي آحاد % % 5(@)(@@) % عدم نحن كلنا ووجود % % أنت حق باق بغير نفاد % % 6(@)(@@) % مطلق أنت مثل ما كنت قدما % % خارج عن مراتب الأعداد % % 7(@)(@@) % وقيود جميعنا نحن لكن % % قد نسبنا إليك بالإستناد % % 8(@)(@@) % حيث أنت الذي تقدر منا % % كل ما ما شئت من ربا ووهاد % % 9(@)(@@) % فظهور لنا ظهورك حقا % % وبطون لنا بطونك بادي % % 10(@)(@@) % جهلت أمة تقول وجدنا % % إذ لها أنت لم تكن لك هادي % % PageV01P504 11(@)(@@) % يا وجود الجميع قولي مبنيني % % على القول بالوجود المفاد % % 12(@)(@@) % وهو قول توهمته عقول % % عقلت أمرها خلاف المراد % % 13(@)(@@) % ليت شعري من يستفيد وجودا % % والذي يستفيد لا شيء عادي % % 14(@)(@@) % وإذا قلت ربنا يوجد المعدوم % % قلنا 
ms103	 ذا القول محض عناد % % 15(@)(@@) % نحن أيضا نقول مثلك هذا % % قول حق بغير ما ترداد % % 16(@)(@@) % لا على الوصف بالوجود لمعدو م % % ولا قبله وجودا إرادي % % 17(@)(@@) % حيث قلب الحقائق الكل قالوا % % مستحيل عند العقول الجياد % % 18(@)(@@) % إنما قولنا بذلك قول الله % % في محكم الكتاب الجواد % % 19(@)(@@) % فتأمل الله نور السموات % % وجودا بياضه في المعتاد % % 20(@)(@@) % لقبول البياض في كل لون % % ضد أمر السواد بالانفراد % % PageV01P505 21(@)(@@) % فتنحوا يا غافلون فغير الله % % لا يرشدنكم للرشاد % % 22(@)(@@) % كل لون على البياض يغطي % % بانتقاص من السوى وازدياد % % 23(@)(@@) % وبياض السواد يعجز عنه % % كل شخص سوى إله العباد % % 24(@)(@@) % وهو شيب في لمة الشعر يبدو % % عبرة فافهموا كلام المنادي % % 25(@)(@@) % وبياضي على السواد تبدى % % فمحاه بشدة الامتداد % % 26(@)(@@) % فأنا النور عنده وظلام % % عندكم يا جماعة الحساد % % 27(@)(@@) % والذي عنده يراني نورا % % والذي عندكم يرى فيعادي % % 28(@)(@@) % وعليه الظلم يغلب حتى % % يقدح النار قلبه بالزناد % % 29(@)(@@) % إنما النار جهد فاقد نور % % فاستعدوا بواحد للمعاد % % PageV01P506 البحر : - 1(@)(@@) % وجودي وجود الكائنات وإنما % % وجود جميع الكائنات وجودي % % 2(@)(@@) % ولكنهم غيري وإني غيرهم % % فحقق كلامي واعتبر بشهودي % % 3(@)(@@) % وجود قديم واحد عنه فائض % % سواه من الأشياء فيضة جود % % 4(@)(@@) % ولم ينقسم حاشاه بل هو مطلق % % أراد بأن يبدو لنا بقيود % % 5(@)(@@) % فلاح بما في نفسه هو لم يزل % % يصور من بيض هناك وسود % % 6(@)(@@) % وليس الأنواع التصاوير كلها % % وجود سواه في شقا وسعود % % 7(@)(@@) % فقد أوجد الأشياء وهو وجودها % % به وجدت محدودة بحدود % % 8(@)(@@) % وهذا اعتبار العقل وهو الذي غدت % % تناط بها الأحكام دون نفود % % 9(@)(@@) % ومن يتحقق بالوجود فإنه % % يراه وجودا في أجل صمود % % 10(@)(@@) % وليس يرى الأشياء موجودة بها % % ولكن يراها في انتفا وجحود % % PageV01P507 11(@)(@@) % هو النور عنها قد أبان وعنه قد % % أبانت وكل ذو وفا بعهود % % 12(@)(@@) % وكل على ما كان فيه ولم يزل % % قديما وهذا قول أشرف قود % % 13(@)(@@) % مقالة آباء لنا في طريقنا % % كرام رضعنا ثديهم وجدود % % PageV01P508 البحر : - 1(@)(@@) % الفرق سكر لأن العقل يستجدي 
ms104	 % % فيه سوى ربه من كثرة الفقد % % 2(@)(@@) % مع علمه أنما الجدوى بأجمعها % % لربه الحق من قبل ومن بعد % % 3(@)(@@) % والعقل يقسم في الفرق الوجود إلى % % قسمين قطعا وجود الرب والعبد % % 4(@)(@@) % كذلك الجمع سكر حيث لا أحد % % فيه سوى الأحد الحق الذي يجدي % % 5(@)(@@) % والكل فانون في هذا الوجود به % % مثل السراب تراه العين من بعد % % 6(@)(@@) % وصاحب الفرق ظن الصحو حالته % % وحالة الجمع سكرا رائد الحد % % 7(@)(@@) % ولم يزل قلبه في غفلة أبدا % % عن الشهود شهود الحق بالعمد % % 8(@)(@@) % وصاحب الجمع أيضا ظن حالته % % صحوا وحالة فرق سكر ذي وجد % % 9(@)(@@) % وقلبه لم يزل عن خلق خالقه % % في غفلة ويساوي الغي بالرشد % % 10(@)(@@) % وحاصل الأمر أن الأمر أكمله % % ما بين جمع وفرق جامع الضد % % PageV01P509 11(@)(@@) % مع أهل فرق له فرق كحالتهم % % ومع أولي الجمع ذو جمع بلا رد % % 12(@)(@@) % وهو المسمى بجمع الجمع إرث هدى % % عن النبي وعن قطب وعن فرد % % PageV01P510 البحر : - 1(@)(@@) % إن النصارى واليهود كلاهما % % لا عقل فيهم والعقول شواهد % % 2(@)(@@) % جعل النصارى الرب جل ثلاثة % % ثم ادعوا أن الثلاثة واحد % % 3(@)(@@) % والعقل يأبى والتناقض واضح % % بين الورى وإن استراب الجاحد % % 4(@)(@@) % وكذا اليهود وإن تكاثر عدهم % % فيما مضى لم يبد منهم راشد % % 5(@)(@@) % في أربعين من السنين تحيروا % % في مهمة ما قدره متزايد % % 6(@)(@@) % لم يقدروا أن يخرجوا منه وهم % % عدد كثير عن ألوف زائد % % 7(@)(@@) % داروا وقد رجعوا لموضع بدئهم % % وتناسلوا في تيههم وتوالدوا وكذا الإله إذا أضل جماعة خاب الرجا منهم وضل القاصد % % 8(@)(@@) % حكم يحار بها اللبيب وإنها % % لاحق فيها أن تقال قصائد % % 9(@)(@@) % وملاك ذلك كله فقد الحجا % % ممن أضل له الإله الماجد % % 10(@)(@@) % ومن اهتدى والله أكمل عقله % % بعناية سبقت يرى فيشاهد % % PageV01P511 11(@)(@@) % والعقل نور الله في ملكوته % % وبه لنا التكليف وهو الشاهد % % PageV01P512 البحر : - 1(@)(@@) % بحمد الله خلاق الوجود % % توالى كل إنعام وجود % % 2(@)(@@) % وبالشكر الذي من كل شي % % تمتع كل شي بالشهود % % 3(@)(@@) % ولكن للظهور تنوعات % % بها خرج البطون عن 
ms105	 القيود % % 4(@)(@@) % فسبحان المهيمن جل ربي % % وعز عن المعاني والحدود % % 5(@)(@@) % وما زالت صلاة الله مني % % تفوح مع السلام بعرف عود % % 6(@)(@@) % على المختار من بين البرايا % % سليل الأكرمين من الجدود % % 7(@)(@@) % محمد الذي بالحق ساعي % % إلى الغارات خفاق البنود % % 8(@)(@@) % كذا مع آله والصحب طرا % % على أمد الزمان بلا نفود % % 9(@)(@@) % وبعد فإن تقوى الله زاد % % لأهل السير في طرق السعود % % 10(@)(@@) % وتلك مراتب لم يخل عنها % % أولو الإسلام من كل الجنود % % PageV01P513 11(@)(@@) % فتقوى العام من شرك وكفر % % وأعمال من الطغيان سود % % 12(@)(@@) % وتقوى الخاص من كل المعاصي جميعا مع محافظة الحدود % . . . % 13(@)(@@) % فمن لم يتق شركا وكفرا % % فعن تقوى المعاصي في صدود % % 14(@)(@@) % وترك الذنب ليس بطاعة من % % ذوي الشرك المهيئ للخلود % % 15(@)(@@) % لأن الشرك لم يغفره ربي % % له نار غدا ذات الوقود % % 16(@)(@@) % وكل عبادة فالشرط فيها % % هو الإسلام حفظا للعهود % % 17(@)(@@) % ومن لم يتق هذا هذا % % حميعا ما تنبه من رقود % % 18(@)(@@) % فكيف عن السوى تقواه ترجو % % ولم تخرج سيوف من غمود % % 19(@)(@@) % وأول رتبة تقوى عوام البرية % % في القيام وفي القعود % % 20(@)(@@) % وذاك أهم للإسلام فيما % % نراه من النصيحة للوفود % % PageV01P514 21(@)(@@) % لأن النفس كاذبة ويخفى % % عليها الشرك في طي الجلود % % 22(@)(@@) % وتجحده إذا عرفته حتى % % تزيد الوصل في خلف الوعود % % 23(@)(@@) % وقال الله في القرآن إلا % % وهم أي مشركون من الجحود % % 24(@)(@@) % وجاء الشرك أخفى من دبيب % % لنمل في الحديث عن النقود % % 25(@)(@@) % وللشرك إنقسام منه قسم % % جلي في النصارى واليهود % % 26(@)(@@) % وقسم في ذوي الإيمان خاف % % عن الساهي من العبد الكنود % % 27(@)(@@) % وذلك في العوام لترك تقوى % % ذكرناها لهم في ذي العقود % % 28(@)(@@) % فمن يعمل بتقواهم ويمشي % % عليها في الركوع وفي السجود % % 29(@)(@@) % كفته عن الطريق بلا التفات % % إلى تقوى الخواص ولا صعود % % 30(@)(@@) % فإن الاشتغال بترك ذنب % % كفعل الذنب حجب عن ورود % % PageV01P515 31(@)(@@) % ولا نعني الهجوم على المعاصي % % وترك الخوف مثل أولي الجحود % % 32(@)(@@) % ولكن كل مرتبة يؤدى % % لها حق على رغم الحسود 
ms106	 % % 33(@)(@@) % فحقك في عمومك ذا وذا في % % خصوصك عند أرباب السعود % % 34(@)(@@) % وكن يا أيها الإنسان فيما % % عملت من البطون إلى اللحود % % 35(@)(@@) % وهذا النصح مني للبرايا % % به يستيقظون من الهجود % % 36(@)(@@) % وغير الله في الدنيا غرور % % وليس يدوم ظل مع عمود % % 37(@)(@@) % وقد خص الإله رجال صدق % % بما قد خص من كرم وجود % % 38(@)(@@) % لهم قدم الرسوخ على المعالي % % تراهم في المرابض كالأسود % % 39(@)(@@) % وكل قد أجاز لمن سواه % % على الترتيب في أخذ العهود % % 40(@)(@@) % إلى هذا المجاز حباه ربي % % بأنواع الفتوح بلا سدود % % PageV01P516 41(@)(@@) % وقواه على فهم المعاني % % وأرشده إلى طرق الشهود % % 42(@)(@@) % ومن عبد الغني نظام عقد % % بسلك الدر من أبهى العقود % % 43(@)(@@) % على جيد الإجازة قد أضاءت % % به نار الهدى بعد الخمود % % 44(@)(@@) % يروم به من المولى قبولا % % لديه في الصدور وفي الورود % % PageV01P517 البحر : - 1(@)(@@) % منبع الأنوار % % مجمع الأسرار ساكن في الدار دار قلب الفاقد الواجد % % 2(@)(@@) % جنة في نار % % بهجة الأبصار من رآها حار نبهت عين الفتى الراقد % % 3(@)(@@) % يا لقومي طار % % من يد الأفكار بلبل الأسحار وعلى كل السوى حاقد % % 4(@)(@@) % هذه الآثار % % كلها أطوار للذي يختار قرب هذا الصادق الناقد % % PageV01P518 البحر : - 1(@)(@@) % أيمن الوادي % % مشرب الصادي إن حدا الحادي هاج وجد المغرم الفاني % % 2(@)(@@) % فادخل النادي % % واشهد البادي دك أطوادي مؤذن أن السوى فاني % % 3(@)(@@) % كل أعيادي % % شعب أجيادي أيها الغادي قف به عني بأشجان % % 4(@)(@@) % صل يا هادي % % للنبي الهادي في الدجى الهادي عهده عبد الغني عاقد % % PageV01P519 البحر : - 1(@)(@@) % يا سائق الأظعان % % بين البوادي سر بي مع الركبان واحفظ فؤادي % % 2(@)(@@) % ما النور مثل النار % % للمستدل والحسن بالإحسان فامدد أيادي % % 3(@)(@@) % سر بي مع الركبان % % واحفظ فؤادي % % PageV01P520 البحر : - 1(@)(@@) % هذه سلمى % % للصب داني فاترك له الأسما وامح الأواني % % 2(@)(@@) % فالذات لي مرمى % % عين العيان واستعمل الكتمان بين العباد % % 3(@)(@@) % سر بي مع الركبان % % واحفظ فؤادي % % 4(@)(@@) % وجه الوجود الحق % % ما زال خافي ما منه شي مشتق كن منه صافي % % 5(@)(@@) % فإن من 
ms107	 قد رق % % يدري المنافي والجاهل الحيران للغي غادي % % 6(@)(@@) % سر بي مع الركبان % % واحفظ فؤادي % % PageV01P521 البحر : - 1(@)(@@) % ما الكون في التحقيق % % آت وماضي إلا ظهور سيق نحو التقاضي % % 2(@)(@@) % من ذلك التشريق % % بالاعتراض إذ كل شيء فان والله هادي % % 3(@)(@@) % سر بي مع الركبان % % واحفظ فؤادي % % PageV01P522 البحر : - 1(@)(@@) % صل مع التسليم % % مولى الموالي للزائد التكريم شمس المعالي % % 2(@)(@@) % مع عصبة التقديم % % صحب وآل عبد الغني ولهان فيه ينادي % % 3(@)(@@) % سر بي مع الركبان % % واحفظ فؤادي % % PageV01P523 البحر : - 1(@)(@@) % في الدال بالإهمال إعمال بدا % % خبر له عين الحقيقة مبتدا % % 2(@)(@@) % وعليه من كل الجهات علائم % % دلت على التقوى وأنواع الهدى % % 3(@)(@@) % صدق الذي هو كاذب في طوره % % طبق الإرادة في الشعار وفي الردا % % 4(@)(@@) % إن الذوات توهمات العقل في % % أوصاف باريها كإرجاع الصدى % % 5(@)(@@) % والحرف ينشأ بانحراف الطبع عن % % سنن استقامته فتشهده العدا % % 6(@)(@@) % طوى الطريق على انتشار جهاته % % فانظر لمطلقه تراه مقيدا % % 7(@)(@@) % يا ظاهرا في كل ما هو ظاهر % % يا باطنا نفسي لأنفسك الفدا % % 8(@)(@@) % والسر في يوم القيامة قولهم % % نفسي وقولك أمتي متقصدا % % 9(@)(@@) % هذا هو النور المبين لعارف % % ولغارف من بحر شرعك جددا % % PageV01P524 البحر : - 1(@)(@@) % هذا وهذا ثم هذا بعده % % هذا وهذا لم يزل معدودا % % 2(@)(@@) % وهو الحساب ولا حساب سوى السوى % % بالوهم صار له الجميع عمودا % % 3(@)(@@) % فانظر إلى العدد الذي هو واحد % % وهو الكثير مراتبا وقيودا واعبر به في الهاء منحرفا إلى سر الأسامي واعتبره حدودا % % 4(@)(@@) % هذا به طورا يكون حضوره % % فتراه قطبا قائما مقصودا % % 5(@)(@@) % كالشمس في الأفلاك تتنزل رتبة % % فيقال جاءت طالعا مسعودا % % 6(@)(@@) % إني كشفت وما كشفت لأنني % % بالأذن كنت له أقيم رقودا % % PageV01P525 البحر : - 1(@)(@@) % أنا كلي منك إنعام وجود % % صور تبدو وتخفى ووجود % % 2(@)(@@) % هذه جملة أمر واحد % % لا سواه عند غيب وشهود % % 3(@)(@@) % تارة يبدو ويخفى تارة % % وهو إطلاق لدينا وقيود % % 4(@)(@@) % أيها الساري إليه وبه % % يقطع البيدا على ظهر قعود % % 5(@)(@@) % فرغ القلب له من غيره % % واجتليه بركوع وسجود 
ms108	 % % 6(@)(@@) % وتأمله به واسكن به % % في حمى عزته بين الوفود % % 7(@)(@@) % عطفت سلمى على حلتها % % وهي منها سدلت فوق النهود % % 8(@)(@@) % ليتها ترفع عنا طرفها % % لنرى الخال الذي فوق الخدود % % 9(@)(@@) % وهو خال أسود وهو أنا % % في سنا طلعتها يشجى الأسود % % 10(@)(@@) % كم به أصمت وكم أردت فتى % % بوجوه عنده بيض وسود % % PageV01P526 11(@)(@@) % وهو وجه واحد صبغته % % حكمها النافذ من غير نفود % % 12(@)(@@) % لا تدع يا شوق مني أثرا % % للتي سرت بها سير الجدود % % 13(@)(@@) % شكرها شكري وحمدي حمدها % % وبها منها قيامي والقعود % % 14(@)(@@) % ثمد الماء سقتنا وروت % % وهدتنا لم تقل أما ثمود % % 15(@)(@@) % وبأرض الحجر لم تحجر على % % أمرها فينا فكنا قوم هود % % 16(@)(@@) % دأبنا حفظ المواثيق التي % % هي منا أخذتها والعهود % % 17(@)(@@) % وهي فينا عن حدود خرجت % % نحن فيها ما خرجنا عن حدود % % 18(@)(@@) % قيدتنا بهدى أحكامها % % وهي عنا انطلقت ليست تعود % % 19(@)(@@) % ما لنا عنها غناء أبدا % % هل يقوم الظل من غير عمود % % PageV01P527 البحر : - 1(@)(@@) % قل هو الله أحد % % ليس في الكون أحد % % 2(@)(@@) % إنما الكون له % % حج فيمن جحد % % 3(@)(@@) % ينجلي الحق به % % وهو للمطلق حد % % 4(@)(@@) % قدرته قدرة % % ليس عنها ملتحد % % 5(@)(@@) % لا تقل حل ولا % % تقل الحق اتحد % % 6(@)(@@) % قل سواه باطل % % وهو الحق الأحد % % PageV01P528 البحر : - 1(@)(@@) % طوران لي طور أنا % % والطور الآخر سيدي % % 2(@)(@@) % وهما معا لي تارة % % جمع يكون لمفرد % % 3(@)(@@) % جمع قديم عهده % % في مفرد متحد % % 4(@)(@@) % والغير إما نفسه % % أو نفس مولى الأعبد % % 5(@)(@@) % شيء خصصت به ولا % % تلقاه إلا في يدي % % 6(@)(@@) % قد قال هذا قبلنا % % قول الإمام المرشد % % 7(@)(@@) % لي سكرتان وسكر % % هي للمريد المقتدي % % 8(@)(@@) % فاسمع هديت ولا تكن % % فيما تقول بمعتدي % % 9(@)(@@) % صدق الطريق نجاة من % % هو في المقام الأحمدي % % 10(@)(@@) % هيهات ليس المنتهي % % في الله مثل المبتدي % % PageV01P529 11(@)(@@) % وإن استحال الانتها % % في الجامع المتوحد % % 12(@)(@@) % واصمت ولا تنطق فما الهادي % % إليه المهتدي % % 13(@)(@@) % واحذر خيالك أن يوسوس % % بالمقال لك الردي % % 14(@)(@@) % فيريك أنك صرت مثل 
ms109	 % % إمامك المتجرد % % 15(@)(@@) % بالفهم في أقواله % % وبظنك المتردد % % 16(@)(@@) % هذي علوم الذوق كالمحسوس % % بالحس الندي % % 17(@)(@@) % لا بالتفهم والتوهم % % من إليها يهتدي % % 18(@)(@@) % بل بالصفاء وبالوفا % % وبالطهارة القلب الصدي % % 19(@)(@@) % ما النفس إلا كدرة % % في صفو روحك نغتدي % % 20(@)(@@) % فامسح بأمر الله كد رة % % روحك المتجسد % % PageV01P530 البحر : - 1(@)(@@) % لا تظن الله معنا % % ههنا في ذا الوجود % % 2(@)(@@) % هو معنا بالتجلي % % بتقادير القيود % % 3(@)(@@) % وتقادير القيود الكل % % فان هالك % % 4(@)(@@) % عدم لكن له يظهر % % بالله وجود % % 5(@)(@@) % إنما الكون جميعا % % حادث إذ لم يكن % % 6(@)(@@) % ثم قد كان وربي % % كان من غير جحود ليس شيء معه من قبل أن يخلق لا % % 7(@)(@@) % داخل أو خارج أو % % ذو اتصال أو نفود % % 8(@)(@@) % لا زمان لا مكان % % لا فلان كان في % % 9(@)(@@) % أزل الآزال فافهم % % وانتبه من ذا الرقود % % 10(@)(@@) % وتأمل في كلامي % % وانتظر إن لم تكن % % PageV01P531 11(@)(@@) % فاهما فالله ربي % % سوف بالفهم يجود % % 12(@)(@@) % أنت مخلوق وما تفهم % % مخلوقا فكن عارفا نفسك خلقا كلها دون جمود % % 13(@)(@@) % لا تجل بالفكر في ربك % % لن تقدر أن % % 14(@)(@@) % تعرف المطلق بالداخل % % في قيد الحدود % % 15(@)(@@) % رفع الله السموات % % الطباق السبع في % % 16(@)(@@) % نظر العين كما قد % % قال من غير عمود % % 17(@)(@@) % وهو لا يظهر إلا % % بعد أن يفنى الورى % % 18(@)(@@) % كلهم يظهر بالإيمان % % منه في الشهود % % 19(@)(@@) % فيراه القلب غيبا % % مطلقا عن كل ما % % 20(@)(@@) % كان من قبل يراه % % وهو مولانا الودود % % PageV01P532 21(@)(@@) % واجعل الحس يراه % % فهو محسوس ولا % % 22(@)(@@) % شيء معه من جميع الخلق % % من بيض وسود وجود الشيء شاء بشي شيئا فكان الشيء عن ذاك الوجود % % 23(@)(@@) % فسموا الشيء موجودا وقالوا % % وجود ذاك ثان في الشهود % % 24(@)(@@) % وقد قسموا الوجود إلى قديم % % يجل وحادث هو للنفود % % 25(@)(@@) % وكيف يصير من عدم وجود % % ويدركه الفنا مثل القيود % % 26(@)(@@) % ألا يا قوم كم هذا العمى من % % ولادتكم إلى يوم اللحود % % 27(@)(@@) % تنبهت العوام الغر لما % % رأوا قولي وأنتم في رقود % % 28(@)(@@) % هو الله الذي 
ms110	 لا شيء معه % % وهل ظل يكون مع العمود % % PageV01P533 البحر : - 1(@)(@@) % مقام بني الصديق ذروة فرقد % . . . % 2(@)(@@) % ومتحد هم في الناس أشرف محتد % . . . % 3(@)(@@) % فيا من بأثواب الصداقة مرتدي % . . . % 4(@)(@@) % ألا قل لمن عادى بني سبط أحمد % % وأبناء صديق النبي محمد % % 5(@)(@@) % بهم شرف الأنساب جوهره انجلى % . . . % 6(@)(@@) % ألم تسمع القاري فضائلهم تلا % . . . % 7(@)(@@) % تريد لديهم خفض مرتبة العلا % . . . % 8(@)(@@) % ترقب سهام الله وانتظر البلا % % فانهمو أهل المقام المؤيد % % 9(@)(@@) % ألا تلكم السادات يا قوم تلكم % . . . % 10(@)(@@) % وفضلهم البادي فلا تنتقصهم % . . . % PageV01P534 11(@)(@@) % هم الصفوة المستخلصون همو هم % . . . % 12(@)(@@) % نصحتك فاحذرهم ولا تعترضهم % % وما لك والفرسان في كل مشهد % % 13(@)(@@) % دعاهم على من ضرهم كم به قتل % . . . % 14(@)(@@) % فتى معهم بالافترا صار يقتتل % . . . % 15(@)(@@) % أرى حبل ود منك حل وما فتل % . . . % 16(@)(@@) % وما لك والسادات أقطاب حضرة الكمال % % وأصحاب الجلال الممجد % % 17(@)(@@) % بهم مصرهم تسمو افتخارا وشامهم % . . . % 18(@)(@@) % ويعلو كلام المفترين كلامهم % . . . % 19(@)(@@) % هم الصادقون المستقيم إمامهم % . . . % 20(@)(@@) % ومن فوق فوق الفرقدين مقامهم % % بلى لهمو في الغيب أشرف مقعد % % PageV01P535 21(@)(@@) % إذا قدرهم بالزعم أرخص مرخص % . . . % 22(@)(@@) % فما ذاك إلا رافضي مخصص % . . . % 23(@)(@@) % وكيف وطول المدح فيهم ملخص % . . . % 24(@)(@@) % عباد لهم سر من الله مخلص % % وقلب بنور الحق أعظم مهتدي % % 25(@)(@@) % معاندهم ربي على وجهه يتل % . . . % 26(@)(@@) % وباغضهم في صرعه للجبين تل % . . . % 27(@)(@@) % ومن يفتري يوما عليهم هو العتل % . . . % 28(@)(@@) % أئمة محراب الشهود وسادة الوجود % % ومن طابوا بأعذب مورد % % 29(@)(@@) % لك الرفع في أوج العلا يا محبهم % % وتسعد في الدارين إن نلت قربهم % % 30(@)(@@) % كن الملتحي فيهم وكن أنت حزبهم % . . . % PageV01P536 31(@)(@@) % هم القوم لا يشقى بهم من أحبهم % % وصار بهم في الناس أكرم مقتدي % % 32(@)(@@) % سلاطين مجد والكمالات جندهم % . . . % 33(@)(@@) % وقربهم الرضوان والسخط بعدهم % . . . % 34(@)(@@) % بهم يحتمي من عنده دام عهدهم % . . . % 35(@)(@@) % وحقهمو لا يختشى الضيم عبدهم % % وهذا بإرث الهاشمي محمد % % 36(@)(@@) % ينال الأماني من يلوذ ببابهم % . . . % 37(@)(@@) % ويدرك عزا من مشى في ركابهم % . . . % 38(@)(@@) % ويا فوزحاوي قطرة من شرابهم % . . . % 39(@)(@@) % فخذ عنهمو 
ms111	 واخدم رحاب جنابهم % % فهم بتجلي الحق أشرف مقصد % % PageV01P537 البحر : - 1(@)(@@) % نقط الكون نحت باء الوجود % % حرف معنى انحرافه المشهود % % 2(@)(@@) % ألف الانحراف فيها ولكن % % هي في الغيب حضرة المعبود % % 3(@)(@@) % ولها مخرج من الجوف فينا % % غائب ليس مدركا بشهود % % 4(@)(@@) % لا تقل وحدة الوجود إذا لم % % تفن عن كل كائن موجود % % 5(@)(@@) % ثم تفنى ذوقا بتحقيق حق % % عنك حتى عن الفنا المقصود % % 6(@)(@@) % ويصير الوجود عنك خفيا % % لست تدري منه سوى فرط جود % % 7(@)(@@) % ثم تبقى به له لمع برق % % ظاهر عن بطونه المعهود % % 8(@)(@@) % كظلال عن أمره أو خيال % % خيلته أسماء رب ودود % % 9(@)(@@) % وإذا لم تكن كذلك فاحذر % % من تلابيس عقلك المعقود % % 10(@)(@@) % واجتنب وحدة الوجود ودعها % % لرجال قاموا بحفظ العهود % % PageV01P538 11(@)(@@) % ركع في غيوبهم بالفنا عن % % كل شيء سوى الوجود سجود % % 12(@)(@@) % ما لهم عندهم ولا لسواهم % % من وجود ظل بدا لعمود % % 13(@)(@@) % هم تقاديره وهم بالتقادير % % قيام بشرعه والحدود % % PageV01P539 البحر : - 1(@)(@@) % من لعبد بجسمه السقم بادي % % بين أيدي حواسد وأعادي % % 2(@)(@@) % وعيون قد أحدقت بازورار % % وخزتني مثل السيوف الحداد % % 3(@)(@@) % وقلوب كأنما البغض فيها % % جمر نار تبدو من الأجساد % % 4(@)(@@) % صاعدات أنفاسها كدخان % % منه يعلو الوجوه صبغ السواد % % 5(@)(@@) % كل هذا لأنهم ينظروني % % في ارتقاء إلى العلا وازدياد % % 6(@)(@@) % وصفاء وصحة وسرور % % وكمال يرونه ورشاد % % 7(@)(@@) % ويرون الإله يحفظني في % % كل حال يكون بين العباد % % 8(@)(@@) % إن ربي حسبي عليهم جميعا % % وهو نعم الوكيل وهو اعتمادي % % PageV01P540 البحر : - 1(@)(@@) % إن رمت بالمثل التقريب مقتصدا % % فخذ مقالة من للحق قد وجدا % % 2(@)(@@) % هذا مثال ولم أقصد حقيقته % % لديك فافهم مرادي واترك النكدا % % 3(@)(@@) % إذا تعارجت تحكي أعرجا فلقد % % فعلت فعلا وذاك الفعل منك بدا % % 4(@)(@@) % وإنه عرض بل صورة ظهرت % % وأنت قيومها تبقى لديك مدى % % 5(@)(@@) % وما لها من وجود غير فاعلها % % والفاعل الحق لا تعدل به أحدا % % 6(@)(@@) % قامت به الخلق طرا حيث هم عرض % % وهم حجاب عليه داما أبدا % % 7(@)(@@) % وكلهم فعله والوهم يجعلهم % % أغياره وهو 
ms112	 فعال كما وردا % % 8(@)(@@) % لذاك عن كل ما الفعال يفعله % % فليس يسأل بل هم يسألون غدا % % 9(@)(@@) % وما الإله بجسم لا ولا عرض % % فافهم كلامي ذا وامدد إليه يدا % % 10(@)(@@) % إن العوالم أعراض بأجمعها % % كأنها في كلام الحق رجع صدى % % PageV01P541 11(@)(@@) % والكل فان وللحق الظهور بهم % % ظهور ملتبس تلقاه متحدا % % 12(@)(@@) % وهم يقولون بالأجسام قائمة % % أعراضه يوهمونا مذهبا فسدا وعند تعريفهم للجسم قد ذكروا مجموع أعراض أمر عندهم قصدا % % 13(@)(@@) % قالوا هو الجسم أعني ما تركب من % % جواهر فردة قولا لأهل هدى % % 14(@)(@@) % والجوهر الفرد فيه الاختلاف وقد % % نفاه قوم وقوم أثبتوه سدى % % 15(@)(@@) % وقال قوم بأن الجسم ذلك ذو % % طول وعرض وعمق قول أهل ردا % % 16(@)(@@) % وكل ذلك غير الحق قد وصلوا % % إليه بالعقل لا بالشرع مستندا % % 17(@)(@@) % مقالة عند أقوام فلاسفة % % قد تابعوهم بها رأيا ومعتقدا % % 18(@)(@@) % وإنما قولنا هذا ومشبهه % % دين النبي ابن عبد الله للسعدا % % 19(@)(@@) % ومن تأمل في الأقوال أجمعها % % رأى الذي قد رأينا فاطلب المددا % % PageV01P542 البحر : - 1(@)(@@) % هو الله ربي هو المبتدا % % وما رفعه بسوى الابتدا % % 2(@)(@@) % تحقق كلامي وخل السوى % % فإن السوى هو أردى الردى % % 3(@)(@@) % وكل العوالم أخباره % % به رفعت عند أهل الهدى % % 4(@)(@@) % وفيها ضمير له راجع % % به ربطها كان بالمبتدا % % 5(@)(@@) % فقول الذي قال في شطحه % % أنا الله ميزه ما اعتدى % % 6(@)(@@) % فإن أنا مبتدا عنده % % له الخبر الله لما بدا % % 7(@)(@@) % وما خبر المبتدا عينه % % نعم غيره هكذا أشهدا % % 8(@)(@@) % ولكنه شاطح مخطئ % % وقد جعل الخبر المبتدا % % 9(@)(@@) % وقدم في قوله نفسه % % على الله حيث له أسندا % % 10(@)(@@) % فأخبر بالله عن نفسه % % ولو عكسه كان لاسترشدا % % PageV01P543 11(@)(@@) % ولكن هنا سر علم له % % تمد له العارفون اليدا % % PageV01P544 البحر : - 1(@)(@@) % قلب المحقق واجد بل فاقد % % والكون أجمعه لديه قصائد % % 2(@)(@@) % لا شك عند العارفين جميعهم % % أن الوجود الحق حق واحد % % 3(@)(@@) % وسواه معدوم وموجود به % % عقد عليه من النقول شواهد % % 4(@)(@@) % والكل فان مستحيل ما عدا % % من قد تجلى فيه وهو 
ms113	 الماجد % % 5(@)(@@) % فإذا امرؤ في الله كان لقلبه % % عقد صحيح أو خيال فاسد % % 6(@)(@@) % ذاك الوجود به تجلى ظاهرا % % للعارفين يرونه فيشاهد % % 7(@)(@@) % ويقول قائلهم لقد عقد الورى % % عقدا وما اعتقدوه إني عاقد % % 8(@)(@@) % يعني على حسب الذي أنا عارف % % لا مقتضى ما يقتفيه الجاحد % % 9(@)(@@) % والكفر كفر في الحقيقة مثل ما % % هو في الشريعة عند من هو قاصد % % 10(@)(@@) % أعني به عند الذي هو ناظر % % في عقده الموجود فيه الواجد % % PageV01P545 11(@)(@@) % لا عند من هو للوجود محقق % % منا وإن ضجت عليه حواسد % % PageV01P546 البحر : - 1(@)(@@) % سق مطاياك بالحدا يا حادي % % فهو سوق القلوب والأكباد % % 2(@)(@@) % وبقرع العصا تساق جسوم % % موضع الكره واختلاف الأيادي % % 3(@)(@@) % هي نوق يقودها الشوق حثا % % لحبيب لها على البعد بادي % % 4(@)(@@) % واحذر السوق بالعصا فهو ما لا % % نفع فيه يضر بالأجساد % % 5(@)(@@) % صور تظهر الغيوب علينا % % فهي فينا دلائل الإرشاد % % 6(@)(@@) % ظلمات وراءها نور وجه % % كهلال أضاء والليل هادي % % 7(@)(@@) % هذه هذه المليح فاخلع % % عنك ثوب الضلال والإفساد % % 8(@)(@@) % واترك الغير لا تقل ثم غير % % إنما الغير عين ذاك المراد % % 9(@)(@@) % لابس حلة السواد التباسا % % لك فاكشف عن ثوبك المستفاد % % 10(@)(@@) % وتجرد له به أنت در % % ضمن أصداف صورة في المعاد % % PageV01P547 11(@)(@@) % أنا عبد الغني لمعة برق % % بعدها لمعة على المعتاد % % 12(@)(@@) % هكذا دائما لأني روح % % نفخ أمر من الإله الجواد % % PageV01P548 البحر : - 1(@)(@@) % إنما الدين كله تقليد % % وهو أمر تقلدته العبيد % % 2(@)(@@) % وهو معنى التكليف محض اعتقاد % % حاد عنه الشقي وفاز السعيد % % 3(@)(@@) % ثم إيمان من يقلد حق % % منه تبدو الأعمال والتوحيد % % 4(@)(@@) % قادة الشرع كالبهيمة ينقاد % % بإيمانه فيدنو البعيد % % 5(@)(@@) % واتباع دين الهدى لا ابتداع % % بعقول أفكارهن صديد % % 6(@)(@@) % طاعة الله والرسول وأهل الأمر % % منكم إشارة لا تبيد % % 7(@)(@@) % هكذا قال ربنا فاستقيموا % % يا أولي العلم ما هنا ترديد % % 8(@)(@@) % ديننا اليسر كله وهو سهل % % ليس فيه التحريج والتشديد % % 9(@)(@@) % فاتقوا الله مخلصين له الدين % % يعلمكم الهدى ويفيد % % 10(@)(@@) % وتصيرون عارفين به لا بعقول % % جميعها 
ms114	 تنكيد % % PageV01P549 11(@)(@@) % واتركوا العقل للذين به ضلوا % % وعما قد حاولوه يحيد % % 12(@)(@@) % وخذوا الفتح إنما هو بالنو ر % % من الله يقتفيه المريد % % 13(@)(@@) % كلما آمن المكلف بالغيب % % ترقى وجاءه الإقليد % % 14(@)(@@) % ثم علم الكلام رد على من % % حاولوا أن يكون دين جديد % % 15(@)(@@) % فاستفزت أئمة الحق للحق % % وقاموا مرادهم تأييد % % 16(@)(@@) % وأبانوا دلائلا بعقول % % قصدهم رد ما يقول العنيد % % 17(@)(@@) % لا اعتقاد له ولكن كلام % % كسلاح يسطو به الصنديد دونوه لما رأوا الدين شتى كل حزب للإفتراق يريد % % 18(@)(@@) % وذوو الاعتزال قاموا جهارا % % فيهم الخلف مبدىء ومعيد % % 19(@)(@@) % وهدى الله ظاهر ليس يخفى % % عند من آمنوا به يا رشيد % % 20(@)(@@) % آمنوا تأمنوا وللغيب عنكم % % أسلموا تسلموا يكون المزيد % % PageV01P550 21(@)(@@) % إنما الدين سنة تبعتها % % عصبة التابعين قول سديد % % 22(@)(@@) % نقلوها عمن مضى من صحاب % % تبعوا المصطفى أب ووليد % % 23(@)(@@) % سلف صالحون صلوا وصاموا % % باتباع جميعه تقليد % % 24(@)(@@) % وعلى ملة المفضل طه % % عيشهم كان ههنا وأبيدوا % % 25(@)(@@) % قط ما استشكلوا ولا سألوا عن % % معضل فيه للهدى تعقيد % % 26(@)(@@) % لا يميلون للعقول ولا ما % % أنتجته العقول فيما تجيد % % 27(@)(@@) % ولهم قال ربنا الحق فاعلم % % إنه لا إله إلا الفريد % % 28(@)(@@) % لم يقل فاستدل أو فتعلق % % بدليل لأنه تحديد % % 29(@)(@@) % هو للرد لا لأجل اعتقاد % % وعلى من يرد إذ لا رديد % % 30(@)(@@) % إن هذا لهو الصواب وأما % % غير هذا فإنه تبديد % % PageV01P551 31(@)(@@) % صدق الله من له الله يهدي % % فهو المهتدي وجل المجيد % % PageV01P552 البحر : - 1(@)(@@) % سلام عظيم من عظيم تفردا % % من الله رب العالمين الذي هدى % % 2(@)(@@) % إلى الشيخ ذاك المرعشي حبيبنا % % ومن نال فضلا حين سمي محمدا % % 3(@)(@@) % إليه تحياتي على البعد لم تزل % % تصافح محرابا لديه ومسجدا % % 4(@)(@@) % وتسبح في بحر من العلم سبحة % % له لا غدير حيث كان مؤيدا % % 5(@)(@@) % وقد جمع الإنسان في ضمن خلقه % % جميع تناويع الوجود الذي بدا % % 6(@)(@@) % إلى أبد الآباد من غير غاية % % وإن كان في خلق جديد لقد غدا % % 7(@)(@@) % وما الموت إلا نقلة وفناؤه % % ملابس 
ms115	 قرب لم يزل متجددا % % 8(@)(@@) % له في ذرى العلم القديم حقيقة % % أتى خبرا عنها هنا وهي مبتدا % % 9(@)(@@) % وأنزله قد قال ربي بعلمه % % ورداه في كل الملابس فارتدى % % 10(@)(@@) % محبا له إذ كان كنزا قد اختفى % % فأذكره منه وأدنى وأبعدا % % PageV01P553 11(@)(@@) % وما هو إلا أمره سر خلقه % % يبين ويخفى مطلقا ومقيدا % % 12(@)(@@) % ونحن التقادير التي هو عالم % % بها وهو عنا في الغيوب توحدا % % 13(@)(@@) % فلم ندر منه غير ما نحن فيه من % % معان ومحسوس وما خلقنا سدى % % 14(@)(@@) % هو الله لا عقل له مدرك ولا % % يحيط به علما سواه مؤبدا % % 15(@)(@@) % ولكننا بالغيب نؤمن لا بما % % لدينا من المعنى الذي طاب موردا % % 16(@)(@@) % تبارك رحمانا على عرشه استوى % % كما هو يدري والذي قد درى اعتدى % % 17(@)(@@) % ونحن له الأفعال يفعلنا متى % % أراد فندري فعله اليوم لا غدا % % 18(@)(@@) % ونسلم إخلاصا إليه نفوسنا % % مطيعين إما للنجاة أو الردى % % 19(@)(@@) % ولا حكم فينا للعقول ولا لما % % تحدده كل العقول تحددا % % 20(@)(@@) % وإيماننا بالمرسلين جميعهم % % وبالأنبيا طرا أولي الفضل والندا % % PageV01P554 21(@)(@@) % وبالخاتم الماحي الذي ثبتت له % % مراتب فضل أرغمت سائر العدا % % 22(@)(@@) % محمد الداعي إلى الحق والذي % % أتانا بأنوار الشريعة مرشدا % % 23(@)(@@) % له ولهم صلى الإله مسلما % % مع الآل والأصحاب ما طائر شدا % % 24(@)(@@) % وبعد فمن عبد الغني رسالة % % إليك أتت تتلو سلاما مرددا % % 25(@)(@@) % وتكشف عن سر الغدير لأهله % % وعن سبح أهل الله فيه توددا % % 26(@)(@@) % وعن كونه بحرا بلا ساحل له % % ومن وجد الزاد الكثير تزودا % % 27(@)(@@) % فثق بودادي يا ابن ودي فإنني % % أحب الإمام المستقيم الموحدا % % 28(@)(@@) % ألا إنها الأكوان أجمعها بدت % % بخير وشر طبق ما العلم حددا % % 29(@)(@@) % وذاك قديم كله وهو حادث % % لدينا وعلم الله لن يترددا فإن سلم الإنسان يسلم ولم يجد على القدر المحتوم منه تنكدا % % 30(@)(@@) % وإن يعترض كان اعتراضا على الذي % % له الخلق والأمر اللذان تأكدا % % PageV01P555 31(@)(@@) % وكن حاكيا للأمر والنهي مخلصا % % لربك وارفع عن تحكمك اليدا % % 32(@)(@@) % ولا تتعرض للتقادير إنها % % مراد الذي 
ms116	 أشقى قديما وأسعدا % % 33(@)(@@) % على مقتضى أسمائه وصفاته % % يضل ويهدي من يشاء على المدى % % 34(@)(@@) % وما الأمر بالمعروف إلا حكاية % % عن الله لا عن نفس من سمع الندا % % 35(@)(@@) % كذلك إنكار المناكر كلها % % حكاية عبد عن شريعة أحمدا وليس عليه الامتثال وإنما على كل عبد فيه أن يتعبدا % % 36(@)(@@) % غديرك يا هذا كمثل غديرنا % % به حشرات ليس تحصى تعددا % % 37(@)(@@) % نرى جوهرا فيه وطورا نرى حصا % % وطورا نرى ماء وروثا وجلمدا % % 38(@)(@@) % ولكنها الأقدار أمر محتم % % نعيم جنان أو جحيم توقدا % % 39(@)(@@) % هم الناس إما صالحا عند ربه % % تقدر قدما أو تقدر مفسدا % % 40(@)(@@) % فكن آمرا بالخير لا تقصد أمرا % % وفي النهي عن شر فدع عنك مقصدا % % PageV01P556 41(@)(@@) % كما فعل القرآن والسنة التي % % آتت في عموم الناس نرويه مسندا % % 42(@)(@@) % وحرر عليك الأمر والنهي تاركا % % لغيرك يستوفي وعيدا وموعدا % % 43(@)(@@) % وكن رجلا يبغي خويصة نفسه % % عسى أن توافي في الجنان مخلدا % % 44(@)(@@) % ولا تشتغل بالناس عمن يراك إن % % غفلت بأمر عنه لم تر منجدا % % 45(@)(@@) % وكن ذاكرا بالفعل ربك دائما % % تراقبه في فعله لك سرمدا % % 46(@)(@@) % ومني صلاة الله ثم سلامه % % على المصطفى المختار من جاء بالهدى % % 47(@)(@@) % وآل وصحب ما بدا الفجر مشرقا % % وما طائر فوق الأراكه غردا % % PageV01P557 البحر : - 1(@)(@@) % بسط الله لي بساط الوجود % % وعليه قعدت وقت الشهود % % 2(@)(@@) % والسوى قاعد على الأرض جهلا % % منه بي منكرا علي وجودي % % 3(@)(@@) % هذه حالة عن العقل جلت % % لم ينلها غير الطليق الشرود % % 4(@)(@@) % إنني مثلكم ونحن وأنتم % % خلق مولى كثير فضل وجود % % 5(@)(@@) % غير أني خرجت عنكم إليه % % فوجدت الهدى إلى المعبود % % 6(@)(@@) % وارتبطتم أنتم بما قد عرفتم % % من سواكم بحبله الممدود % % 7(@)(@@) % يا أخلاي ما أردتم أردنا % % وإلى وردكم جميعا ورودي % % 8(@)(@@) % غير أني علمته وجهلتم % % فأصلحوا حالكم تروا مقصودي % % 9(@)(@@) % واتركوا أنفسا لكم حجبتكم % % عن سواه وعنه بالمحدود % % 10(@)(@@) % رمتموه مقيدا وشهدتم % % أنه جل عن جميع القيود % % PageV01P558 11(@)(@@) % كل قيد فإنه عرض لا % % هو باق بل كالبروق الرعود 
ms117	 % % 12(@)(@@) % صدق الله ما لمن ضل هاد % % غيره فأسلموا لرب ودود هل تظنون بالركوع إليه تترقون أو بذل السجود % % 13(@)(@@) % هو حق ما قد ظننتم ولكن % % إن يكن ذاك لا بكم يا جنودي % % 14(@)(@@) % تابعوني فيما أقول فإني % % حبلكم منه موصل للوفود % % PageV01P559 البحر : - 1(@)(@@) % كل شيء هو خيط أسود % % طوله في العلم منه يمدد % % 2(@)(@@) % بان عندي هو خيط أبيض % % هو أمر الله فجر يقد % % 3(@)(@@) % قدرا ما زال مقدورا كما % % قال في القرآن رب أحد % % 4(@)(@@) % فتركت الأكل والشرب له % % فصيامي أبدا لا يفقد % % 5(@)(@@) % إنما يطعمني الله كما % % هو يسقيني ومنه المدد % % 6(@)(@@) % ويبات الآن كلي عنده % % حيث لا عند لكلي يوجد % % 7(@)(@@) % فاعرف القول وحققه تفز % % بالذي عنه أشار الصمد % % PageV01P560 البحر : - 1(@)(@@) % حدثوا عني حديث الغرام % % يا كرام % % 2(@)(@@) % واشرحوا وجدي % . . . % 3(@)(@@) % إنني مضنى كثير الهيام % % لا أنام % % 4(@)(@@) % ساهر وحدي % . . . % 5(@)(@@) % ملت سكرا نحو ساقي المدام % % حين قام % % 6(@)(@@) % عاقد البند % . . . % 7(@)(@@) % وجهه عنه يشف اللثام % % بالتثام % 8(@)(@@) % ليته يجدي % . . . % PageV01P561 البحر : - 1(@)(@@) % هذه أفعال غيب الغيوب % % لا أتوب % % 2(@)(@@) % عن هوى حبي % . . . % 3(@)(@@) % فانظروه بعيون القلوب % % ليذوب % 4(@)(@@) % جامد اللب % . . . % 5(@)(@@) % واشهدوه مشرقا في الغروب % % مع وجوب % % 6(@)(@@) % لذة القرب % . . . % 7(@)(@@) % إن هذا الجمال نور الظلام % % فيه هام % % 8(@)(@@) % زائد الفقد % . . . % PageV01P562 البحر : - 1(@)(@@) % والصلاة والسلام فاح % % في الصباح % % 2(@)(@@) % بالشذا العطري % . . . % 3(@)(@@) % للنبي الذي أفاد الصلاح % % باتضاح % 4(@)(@@) % سره الفطري % . . . % 5(@)(@@) % عبد هذا الغني به في نجاح % % لامتداح % 6(@)(@@) % فضله يطري % . . . % 7(@)(@@) % وعلى الآل والصحاب العظام % % باحترام % 8(@)(@@) % سادة المجد % . . . % PageV01P563 البحر : - 1(@)(@@) % أنا البرق والرب المناجي هو الرعد % % وهذا هو الخلق الجديد الذي يبدو % % 2(@)(@@) % به الكل في لبس كما قال ربنا % % وإبليس بالوسواس منه له الطرد % % 3(@)(@@) % لهذا متى ذو اللبس يخلو بربه % % يسيء له الآداب يغلبه الفقد % % 4(@)(@@) % ويحلم عنه ربه وهو قادر % % على البطش فيه لكن الأمر ممتد % % 5(@)(@@) % ويفرحني أني مع الغير هكذا % % متى ما خلا بي ليس لي عنده حمد % % 6 
ms118	(@)(@@) % فيظهر إنكارا لنا واستهانة % % بنا لا يبالي حيث لا زيد لا هند % % 7(@)(@@) % إلى أن يرى غيرا ولو خادما لنا % % فتلقاه بالآداب منه لنا القصد % % 8(@)(@@) % ويغلبنا الحلم الذي في طباعنا % % فنوسعه حلما ويرفعه المجد % % 9(@)(@@) % وهذا بحمد الله منا تخلق % % بأخلاق مولى جل يعبده العبد % % 10(@)(@@) % وقد جاء هذا في الحديث تخلقوا % % بأخلاق ربي ذلك القرب لا البعد % % PageV01P564 البحر : - 1(@)(@@) % طيب الحبائب إذا هب الهوى ندي % % ونحن لو يطلبوا أرواحنا ندي % % 2(@)(@@) % يا مقلتي أمطري أو بالدما ندي % % لا تلتقي ندهم هم يلتقوا ندي % % PageV01P565 البحر : - 1(@)(@@) % طيب الحبائب نفح يا حسنه من ند % % والصبر مني عليهم في البراري ند % % 2(@)(@@) % نديت بالروح فيمن باللقا ما ند % % كأنه قد رأى لي في هواه ند % % PageV01P566 البحر : - 1(@)(@@) % اسلك طريق السلامه واغتنم عيدو % % ولا تقل رب هذا قال ما ريدو % % 2(@)(@@) % إياك تدخل بين العبد مع سيدو % % كم من صغير انتشا باس الكبير إيدو % % 3(@)(@@) % اسلك طريق السلامة واغتنم عيدو % % ولا تقل رب هذا قال ما ريدو % % PageV01P567 البحر : - 1(@)(@@) % هبت سحرا فينا % % أنفاس ربا نجد % % 2(@)(@@) % فالمهجة قد ذابت % % بالشوق وبالوجد % % 3(@)(@@) % يا طلعة من أهوى % % في أشرف أوقاتي % % 4(@)(@@) % والوجه له نور % % قد أشرق في ذاتي % % 5(@)(@@) % حتى ظهر المخفي % % للعز وللمجد % % PageV01P568 البحر : - 1(@)(@@) % هذا العلم المفرد % % قد كان وما كنا % % 2(@)(@@) % والمجلس يحوينا % % خذ كأسك والدنا % % 3(@)(@@) % لاشيء هنا يبقى % % من والد أو جد % % PageV01P569 البحر : - 1(@)(@@) % عندي خبر يروى % % عني وعن الساقي % % 2(@)(@@) % الصدق له نالت % % أهل الشرف الباقي % % 3(@)(@@) % غير المولى عدم % % لا شيء هنا يجدي % % PageV01P570 البحر : - 1(@)(@@) % صلي بسلام الله % % أمد الدنيا ربي % % 2(@)(@@) % للفرد نبي الله % % والآل مع الصحب % % 3(@)(@@) % ما أنشد عبد غني % % مدحا لذوي الود % % PageV01P571 البحر : - 1(@)(@@) % وراء هذا الوجود عندي % % وجود حق قديم عهد % % 2(@)(@@) % مقدس الذات عن كلامي % % بكل ما عنه كنت أبدي % % 3(@)(@@) % وعن إشاراتي اللواتي % % بها تحريت كل قصد % % 4(@)(@@) % فلا تظنوا بأن هذا الوجود % % ذاك الوجود عندي % % 5(@)(@@) % لأن هذا 
ms119	 الوجود شيء % % له حدوث من بعد فقد % % 6(@)(@@) % وذاك غيب وغيب غيب % % وذا عيان لكل عبد % % 7(@)(@@) % والعقل عن ذاك في ضلال وليس يدري طريق رشد % . . . % 8(@)(@@) % إلا بإيمانه بغيب % % وكل ما الشرع جاء يهدي % % 9(@)(@@) % وما أتانا به كتاب % % وسنة للكمال يجدي % % 10(@)(@@) % وترك عقل وحفظ نقل % % لفرط سعي له وجد % % PageV01P572 11(@)(@@) % فكن بهذا على يقين % % وحدك إني بذاك وحدي % % 12(@)(@@) % ولا تبالي بكل داع % % إلى سواه أتى برد % % 13(@)(@@) % فإنه الحق سوف يبدو % % لديك إن صرت ضمن لحد % % PageV01P573 البحر : - 1(@)(@@) % هو كل شيء في الوجود واحد % % هو كل موجود هناك وواجد % % 2(@)(@@) % هو علم الأسماء آدم كلها % % هو كل مولود يكون ووالد % % 3(@)(@@) % ما قصدنا الشيء الذي هو هالك % % بل قصدنا وجه الوجود القاصد % % 4(@)(@@) % وهو الوجود الحق في غيب الورى % % متنزه عن درك كل مشاهد % % 5(@)(@@) % هو لم يلد أبدا ولم يولد ولا % % كفء له أحد مقالة لاحد % % 6(@)(@@) % لا شيء يشبهه ولا هو مشبه % % شيا تعالى عن دراية وارد % % 7(@)(@@) % والكل صورهن من عدم له % % وقيامهن به بأمر واحد % % 8(@)(@@) % هو أمره القدر المقدر دائما % % في عين معترف بذاك وجاحد % % 9(@)(@@) % متنزه هو عن مقادير الورى % % بوجوده الحق المبين الشاهد % % 10(@)(@@) % قمنا به بوجود أمر سائل % % كاللمح من بصر إقامة عابد % % PageV01P574 11(@)(@@) % والجاهلون بأمره أيضا لهم % % هذا ولكن بالوجود الجامد % % 12(@)(@@) % الله أكبر لا سواه وإنما % % يعطي ويمنع ليس بالمتباعد % % PageV01P575 البحر : - 1(@)(@@) % عدم أحاط به الوجود % % هو صبغة الله الودود % % 2(@)(@@) % صبغ العوالم كلها % % بوجوده فهي الشهود % % 3(@)(@@) % وهو المحب لها أما % % بالنفس منه لها يجود % % 4(@)(@@) % هي لم تكن شيا وقد % % صارت به شيا يسود % % 5(@)(@@) % وبدت به بيضا وقد % % كانت به من قبل سود % % 6(@)(@@) % نفس الوجود محيطة % % بالكائنات بلا نفود % % 7(@)(@@) % هو مطلق لكن له % % من كل معدوم قيود % % 8(@)(@@) % وله ركوع الكائنات % % جميعها وله السجود % % 9(@)(@@) % وبه الشقاء لها على % % حكم القضا وبه السعود % % 10(@)(@@) % الله أكبر هذه % % هي أحرف ولها مدود 
ms120	 % % PageV01P576 11(@)(@@) % كلماته قد خطها % % في لوحه قلم الوجود % % 12(@)(@@) % يمحو ويثبت دائما % % بالعلم من كرم وجود % % 13(@)(@@) % وهي الحدود له فثق % % بالحافظين على الحدود % % PageV01P577 البحر : - 1(@)(@@) % أنا الخلق الجديد % % أنا العبد المريد % % 2(@)(@@) % وليس علي لبس % % به وهو الشهيد % % 3(@)(@@) % وغيب الغيب عنا % % هو المبدي المعيد % % 4(@)(@@) % لنا في كل وقت % % وجود منه جيد فنحن به قيام ونحن به قعود % % 5(@)(@@) % ونحن به ركوع % % ونحن به سجود % % 6(@)(@@) % ونحن لنا انتباه % % به ولنا رقود % % 7(@)(@@) % ونحن لنا احتراك % % به ولنا ركود % % 8(@)(@@) % وذاك الرب حقا % % ونحن له العبيد % % 9(@)(@@) % ونحن له الرعايا % % ونحن له الجنود % % 10(@)(@@) % هو الملك الذي لا % % سواه لنا يقود % % PageV01P578 11(@)(@@) % ونحن عليه منه % % على الأبد الوفود % % 12(@)(@@) % فيطعمنا ويسقي % % ويفعل ما يريد % % 13(@)(@@) % ونشكره على ما % % لنا أبدا يفيد ومنه لنا علوم وإكرام وجود % % 14(@)(@@) % وقال لنا اشكروني % % وبالشكر المزيد % % PageV01P579 البحر : - 1(@)(@@) % شكرت إلهي باللسان تعبدا % % وبالقلب والأركان ممني تقصدا % % 2(@)(@@) % فأشهدني شكري له نعمة بدت % % ونعمة إشهادي تلتها لأشهدا % % 3(@)(@@) % فأعجزني عن شكر نعماه دائما % % فصيرت شكري عنه عجزي على المدى وشاهدت عجزي منه أكبر نعمة وذا القول إنعاما أراه تجددا % % 4(@)(@@) % فقلت إلهي لست أحصي لك الثنا % % فكن أنت عني شاكرا لك سرمدا % % PageV01P580 البحر : - 1(@)(@@) % إني أنا بك يا ودود % % عدم أحاط به الوجود % % 2(@)(@@) % حق أحاط بباطل % % وله الركوع به السجود % % 3(@)(@@) % وكذا العوالم كلها % % مثلي ومثلك يا كنود % % 4(@)(@@) % ما ثم غير إحاطة % % بالكل من رب ودود % % 5(@)(@@) % والظل أنت وعلمه % % في نور طلعته العمود % % 6(@)(@@) % يا ذا المحيط بنا كما % % هو بالجميع له النفود % % 7(@)(@@) % صور به ظهرت لها % % صور بأنواع الحدود % % 8(@)(@@) % قدم كمثل دوائر % % أوساطها عدم يرود % % 9(@)(@@) % والله قال بكل شي ء % % قل محيط محض جود % % 10(@)(@@) % بل ذاك قرآن مجيد % % وهو في لوح الورود % % PageV01P581 11(@)(@@) % يا من تحير فيه لم % % يعرفه ما هذا الصدود % % 12(@)(@@) % كم ذا التواني هذه % % أكفان مثلك واللحود % % 13(@)(@@) % فاطلب إلهك وحده % % منه 