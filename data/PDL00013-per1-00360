ms341	 و ناله بربط به لحن و نغمه چنگ(@)(@@) 19 خدایگانا تا شاه آسمان دایم %~% گهی سوی بره آید گهی سوی خرچنگ(@)(@@) 20 همیشه باد برایت فراخته رایت %~% همیشه باد به رویت فروخته اورنگ PageV1P202(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چو گوگرد زد محنتم آذرنگ %~% که در خاکم افکند چو بادرنگ(@)(@@) 2 همی هر زمان اژدهای سپهر %~% ز دورم بدم درکشد چون نهنگ(@)(@@) 3 برآورد بازم بر آن کوهسار %~% که بگرفت چنگم ز خرچنگ چنگ(@)(@@) 4 همی گوید ای طالع سرنگون %~% چرایی همه ساله با من به جنگ(@)(@@) 5 خداوند تو بادپایست و من %~% ازو مانده زینگونه ام پای لنگ(@)(@@) 6 ازین اختران او شتابنده تر %~% تنم را چرا داد چندین درنگ(@)(@@) 7 شد از ظلمت خانه ام چشم کور %~% شد از پستی پوششم پشت تنگ(@)(@@) 8 درین سمج هرگز نگنجیدمی %~% به صد چاره و جهد و نیرنگ و رنگ(@)(@@) 9 گرم تن نگشتی ازینسان نزار %~% ورم دل نبودی ازینگونه تنگ(@)(@@) 10 چه کردم من ای چرخ کز بهر من %~% کشی اسب کین را همی تنگ تنگ(@)(@@) 11 نه همخانه آهوان بوده ام %~% که همخوابه ام کرده ای با پلنگ(@)(@@) 12 همی تا کیم کرد باید نگاه %~% به پشت و بدخش غیلواژ و رنگ(@)(@@) 13 ز عمرم چه لذت شناسی که هست %~% طعامم کبست و شرابم شرنگ(@)(@@) 14 دو گونه نوا باشدم روز و شب %~% ز آواز زاغ و ز بانگ کلنگ(@)(@@) 15 چه مایه طرب خیزد آن را ز دل %~% که او را ازینسان بود نای و چنگ(@)(@@) 16 بترسم همی کز نم دیدگان %~% زند روی آیینه طبع زنگ(@)(@@) 17 چرا ناسپاسی کنم زین حصار %~% چو در من بیفزود فرهنگ و هنگ(@)(@@) 18 همی شاه بندم کند هست فخر %~% همی روزگارم زند نیست ننگ(@)(@@) 19 هنرهای طبعی پدیدار شد %~% تنم را ازین انده و آذرنگ(@)(@@) 20 ز زخم و تراشیدن آید پدید %~% بلی گوهر تیغ و نقش خدنگ(@)(@@) 21 نشد سنگ من موم 
ms342	 ازین حادثه %~% نه آب من از گرد شد تیره رنگ(@)(@@) 22 ازیرا که بر من بلا و عنا %~% چو آبست و چون گرد بر موم و سنگ(@)(@@) 23 یقین دان تو مسعود کاین شعر تو %~% یکی سنگ شد در ترازوی سنگ PageV1P203(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تاکیم از چرخ رسد آذرنگ %~% تا کیم از گونه چون باد رنگ(@)(@@) 2 خاکم کز خلق مرا نیست قدر %~% آبم کز بخت مرا نیست رنگ(@)(@@) 3 شب همه شب زار بگریم چو شمع %~% روز همه روز بنالم چو چنگ(@)(@@) 4 عیشی در انده تیره چو گل %~% طبعی از دانش روشن چو رنگ(@)(@@) 5 در دل و در دیده من سال و ماه %~% آذر برزین بود و رود گنگ(@)(@@) 6 پشتم بشکست ز آسیب چرخ %~% زانکه بکبر اندر بینم پلنگ(@)(@@) 7 طبع و دلم پرگهر دانش است %~% زانهمه سختی که کشیدم چو سنگ(@)(@@) 8 باشد پیوسته سپهر ای شگفت %~% با بد و با نیک به صلح و به جنگ(@)(@@) 9 تیغ جهان گیران زنگار خورد %~% آئینه غران صافی زرنگ(@)(@@) 10 هین منشین بیهده مسعودسعد %~% برکش بر اسب قضا تنگ تنگ(@)(@@) 11 خرد مکن طبع نه چرخیست خرد %~% تنک مکن دل نه جهانیست تنگ(@)(@@) 12 نه نه از عمر نداری امید %~% نه نه در دهر نداری درنگ(@)(@@) 13 از پی یک نور مبین صد ظلام %~% وز پی یک نوش مخور صد شرنگ(@)(@@) 14 تات نپرسند همی باش گنگ %~% تات نخوانند همی باش لنگ(@)(@@) 15 سود چه از کوشش تو چون همی %~% روزی بی کوششت آید به چنگ(@)(@@) 16 روزی بی روزی هرگز نماند %~% در دریا ماهی و در کوه رنگ(@)(@@) 17 ای که مرا دشمن داری همی %~% هست مرا فخر و تو را هست ننگ(@)(@@) 18 مردم روزی نزید به حسود %~% دریا هرگز نبود بی نهنگ(@)(@@) 19 والله اگر باشی همسنگ من %~% گرت بسنجد به ترازوی سنگ PageV1P204(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دو سعادت به یکی وقت فراز آمد تنگ 
ms343	 %~% یکی از گردش سال و یکی از شورش جنگ(@)(@@) 2 ما از این هر دو به شکر و به ثنا قصد کنیم %~% زانکه انده شد و شادی سوی ما کرد آهنگ(@)(@@) 3 ماه نوروز دگر بار به ما روی نمود %~% قلعه اگره درآورد ملک زاده به چنگ(@)(@@) 4 کشوری بود نه قلعه همه پر مرد دلیر %~% بر هوا بر شده و ساخته از آهن و سنگ(@)(@@) 5 پی او رفته در آنجا که قرار ماهی %~% سر او بر شده آنجا که بنات و خرچنگ(@)(@@) 6 گرد او بیشه و کوه گشن و سبز چنانک %~% گذر باد و ره مار درو ناخوش و تنگ(@)(@@) 7 این چنین قلعه محمود جهاندار گرفت %~% به دلیری و شجاعت نه به مکر و نیرنگ(@)(@@) 8 پشته ها کرد ز بس کشته در و پنجه جای %~% جوی خون کرد به هر پشته روان صد فرسنگ(@)(@@) 9 برده زنجیر به زنجیر از آن قلعه قطار %~% همچنانست که بر روی هوا صف کلنگ(@)(@@) 10 ای امیری که برون آرد بیم و فزعت %~% طعمه از پنجه شیر و خوره از کام نهنگ(@)(@@) 11 باد را هیچ نباشد گه خشم تو شتاب %~% کوه را هیچ نباشد گه حلم تو درنگ(@)(@@) 12 ای تو را فر فریدون و نهاد جمشید %~% وی تو را سیرت کیخسرو و رای هوشنگ(@)(@@) 13 ای به صدر اندر بایسته تر از نوشروان %~% وی به حرب اندر شایسته تر از پور پشنگ(@)(@@) 14 چرخ گردنده با پایه او رنگ تو پست %~% باد پوینده بر مرکب رهوار تو لنگ(@)(@@) 15 زیر پای ولی و در دو کف ناصح تو %~% خاک چون عنبر سارا شود و بید خدنگ(@)(@@) 16 بر تن حاسد و بد خواه تو و کام عدو %~% خز چون خار مغیلان شود و شهد شرنگ(@)(@@) 17 زود باشد که ازین فتح خبر کرده شود %~% به خراسان و عراق و حبش و بربر و زنگ(@)(@@) 18 این گلی 
ms344	 بود ز بستان فتوحت خوشبو %~% شاخکی بود ز ریحان مرادت خوش رنگ(@)(@@) 19 زین سپس نامه فتح تو سوی حضرت شاه %~% دم دم آید همی از معبر چین و لب گنگ(@)(@@) 20 میل بعضی ملکا سوی نشاطست و طرب %~% اندرین فصل و سوی خوردن بگماز چو زنگ(@)(@@) 21 زانکه بستان شده از حسن بسان مشکوی %~% زانکه صحرا شده از نقش بسان ارتنگ(@)(@@) 22 مرغزار و کهسار از سپر غم و خیری %~% راست چون سینه طاوس شد و پشت پلنگ(@)(@@) 23 اختیار تو درین وقت سوی عزم سفر %~% از پی قوت دین و قبل حمیت و ننگ(@)(@@) 24 حرب کفار گزیده بدل مجلس بزم %~% بانگ تکبیر شنوده بدل نغمه چنگ(@)(@@) 25 تا همی تازد بر مفرش دشت آهوی غرم %~% تا همی یازد بر دامن که بچه رنگ(@)(@@) 26 تو بمان دایم وز فر تو آراسته باد %~% تاج و تخت شهی و افسر ملک و اورنگ PageV1P205(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 همیشه دشمن مالست شاه دشمن مال %~% یکیست او را در بزم و رزم دشمن و مال(@)(@@) 2 علا دولت سلطان تاجور مسعود %~% که تافت از فلک ملکش آفتاب کمال(@)(@@) 3 پناه دولت و دینست و دین و دولت ازو %~% گرفته عز و بزرگی و دیده عز و جلال(@)(@@) 4 نهاده بر فلک مفخرت به قدر قدم %~% نشانده در چمن مملکت به عدل نهال(@)(@@) 5 همای رامش در بزم او برآرد پر %~% هژبر فتنه به رزمش بیفکند چنگال(@)(@@) 6 نهاده روی به هندوستان ز دارالملک %~% به فرخ اختر و پیروز روز و میمون فال(@)(@@) 7 کشید لشکر جرار تا به مرکز غزو %~% ره فراخ فرو بست بر جنوب و شمال(@)(@@) 8 ز تیغ دستان بر کوهها گرفته طریق %~% ز باد پایان در دشت ها نمانده مجال(@)(@@) 9 جبال جنگی در موکبش روان که به زخم %~% به روز معرکه از بیخ بر کنند جبال(@)(@@) 10 به پی شکسته همی ماهی زمین را پشت %~% به یشک 
ms345	 خسته همه شیر آسمان را یال(@)(@@) 11 کدام شاهست اندر همه جهان یکسر %~% که از نهیبش گیرد قرار و یابد حال(@)(@@) 12 خدایگانا یک نکته باز خواهم راند %~% که هست درگه عالی تو محط رحال(@)(@@) 13 خزاین تو گشاده ست بر همه شعرا %~% جواهر تو بدیشان رسیده از هر حال(@)(@@) 14 منم که تشنه همی مانم و دگر طبقه %~% رسیده اند ز انعام تو به آب زلال(@)(@@) 15 یمین دولت سلطان ماضی از غزنین %~% به مدح گویان بر وقف داشتی اموال(@)(@@) 16 غضایری که اگر زنده باشدی امروز %~% به شعر من کندی فخر در همه احوال(@)(@@) 17 به هر قصیده که از شهر ری فرستادی %~% هزار دینار او بستدی ز زر حلال(@)(@@) 18 بگویدی که به من تا به حشر فخر کند %~% «هر آن که بر سر یک بیت من نویسد قال »(@)(@@) 19 همی چه گوید بنگر در آن قصیده شکر %~% که می نماید از آن زر بیکرانه ملال(@)(@@) 20 «بس ای ملک که نه لؤلؤ فروختم به سلم » %~% بس ای ملک که نه گوهر فروختم به جوال »(@)(@@) 21 خدای داند کاندر پناه شاه جهان %~% غضایری را می نشمرم به شعر همال(@)(@@) 22 من آن کسم که گه نظم هیچ گوینده %~% به لفظ و معنی چون من ندارد استقلال(@)(@@) 23 گهی به نثر فشانم و لفظ در ثمین %~% گهی به نظم نمایم ز طبع سحر حلال(@)(@@) 24 چو یافتم شرف مجلس شهنشاهی %~% گذشت از اوج سر همتم ز کبر و دلال(@)(@@) 25 به گوشم آمد فرخنده دعوت دولت %~% به چشمم آمد تابنده صورت اقبال(@)(@@) 26 ولیک بخت به رغبت نمی دهد یاری %~% جهان شوخ همی دارد آخرم دنبال(@)(@@) 27 که روز جشن مرا جود شاه یاد نکرد %~% اگر ز بخت بنالم که گویدم که منال(@)(@@) 28 که گاه مدحت بودم ز جمله شعرا %~% به وقت خدمت بودم ز زمره عمال(@)(@@) 29 نه پایگاه من از حشمتی فزود شرف %~% نه دستگاه 
ms346	 من از خلعتی گرفت جمال(@)(@@) 30 چه گویم آخر با مردمان لوهاور %~% چو باز گردم و از حال من کنند سؤال(@)(@@) 31 ز ابر و مهر چو باران و روشنی طلبم %~% نه التماس کجست و نه آرزوی محال(@)(@@) 32 شها ملوک همه ناز شاعران بکشند %~% تو آفتاب ملوکی بتاب تا صد سال(@)(@@) 33 جهان پناهی و برگ و نوای خلق جهان %~% سخای تست پس از فضل ایزد متعال(@)(@@) 34 همیشه تا ندهد جرم ماه تابش خور %~% همیشه تا نشود قد سرو قامت نال(@)(@@) 35 چو مهر بر فلک مفخرت به فخر بگرد %~% چو سرو بر چمن مملکت به ناز ببال PageV1P206(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ولایت مه شعبان به روزه شد تحویل %~% بدل شد این مه با آز و اینت نیک بدیل(@)(@@) 2 به امر باری شیطان شدست بسته به بند %~% زبان خلق گشاده شدست بر تهلیل(@)(@@) 3 چو نار در دل کفار و نور در مسجد %~% چو نور در دل ابرار و نار در قندیل(@)(@@) 4 کنون برآید بانگ مذکران به نشاط %~% کنون بخیزد آواز مقربان ز رسیل(@)(@@) 5 خجسته بادا بر شهریار سیف دول %~% مه مبارک ماه صیام بر تفضیل(@)(@@) 6 خدایگانی کز خسروان ببرد سبق %~% برای و روی منور به خلق و خلق جمیل(@)(@@) 7 پناه شاهی محمود شاه کو دارد %~% ز پادشاهی تخت وز خسروی اکلیل(@)(@@) 8 حسام او را اندر سر عدوست مقام %~% سنان او را اندر دل حسود مقیل(@)(@@) 9 شکسته گردن گردنکشان به گرز گران %~% زدوده آینه ملک را به تیغ صقیل(@)(@@) 10 چو از غلاف برآورد نیلگون صمصام %~% زند مخالف او جامه خود اندر نیل(@)(@@) 11 خجسته درگه او سوی هر جلال سبب %~% خجسته خدمت او سوی هر کمال دلیل(@)(@@) 12 عزیز خلق بود آنکه او کندش عزیز %~% ذلیل دهر شود هر که او کندش ذلیل(@)(@@) 13 کنون که قصد سفر کرد رای عالی او %~% ز شر و فتنه تهی شه همه طریق و 
