ms286	 خطر که اگر داد اکل و شرب دهی %~% به خلوتی که تو دانی از آن شود دانا(@)(@@) 56 ز بس که خوف بری از سیاست قروقش %~% ز بس کزو بودت بیم در خلا و ملا(@)(@@) 57 به آب لب نکنی تر زتاب اگر سوزی %~% بنان بنان ننهی گر شوی ز ضعف دوتا(@)(@@) 58 ولی ز فعلی اگر آفریدگار ملوک %~% دهد به منع تو فرمان به وعده‌های عطا(@)(@@) 59 تو را ز دست نیامد که در شب دیجور %~% به حیله جنبش موئی ازو کنی اخفا(@)(@@) 60 ز شیشه‌های هوس از شراب کم حذری %~% ز بس که پر بودت کاسه سر شیدا(@)(@@) 61 چنان قروق شکن او شوی که پای نهد %~% به سبزه پدر خویش طفل ناپروا(@)(@@) 62 چنین شعاری و اسلام شرم دار ای نفس %~% اگر رسی به جزا وای بر تو روز جزا(@)(@@) 63 دگر به بزم شه اندر سلوک خویش نگر %~% ببین که طاعت او می‌کنی چگونه ادا(@)(@@) 64 که موی بر بدنت از ادب نمی‌جنبد %~% مگر بر رعشه ز خوف وی وز فرط حیا(@)(@@) 65 به صد هزار تعشق به جای می‌آری %~% هزار حکم اگر بر تو می‌کند اجرا(@)(@@) 66 چو برگ بید زبانت ز بیم می‌لرزد %~% به عرض حاجتی از خود چو میشوی گویا(@)(@@) 67 به آن شهی که شهان آفریدگان ویند %~% چو در نماز سخن می‌کنی صباح و مسا(@)(@@) 68 ببین که صد یک آن بیم هست در دل تو %~% به آن ادب نفسی می‌شوی نفس پیما(@)(@@) 69 به خویش هست گمانت که هرگز آن خدمت %~% ملول ناشده آورده‌ای تمام به جا(@)(@@) 70 اگر بساط ریائی نبوده گسترده %~% ز سرعتت متمیز شدست دست از پا(@)(@@) 71 از بن شعار تو صد ره صنم پرستی به %~% که با ملک به خلوصی و با خدا به ریا(@)(@@) 72 روایت است که عبدالله مبارک داشت %~% هوای سرو قدی از بتان مه سیما(@)(@@) 73 شبی که بود چنان برف از 
ms287	 آسمان باران %~% که بر عباد پس از توبه رحمت مولا(@)(@@) 74 شبی که استره آبدار سرما بود %~% به دست باد ز رخسار مرد موی ربا(@)(@@) 75 به پای منظر وی آنقدر به پای استاد %~% که شد بلند ز هر سو ندای حی علی(@)(@@) 76 گمان به بانگ عشا برده بود تا در دید %~% رسانده بود به عیوق شاه صبح لوا(@)(@@) 77 ز جان غریو برآورد و بانگ زد بر نفس %~% که ای ز بوالهوسی ننگ کافر و ترسا(@)(@@) 78 گر از شبی دو نفس می‌کنی به طاعت صرف %~% نمی‌شوی نفس نفس را سکون فرما(@)(@@) 79 هلاک سوره کوچکتری که زود ترک %~% ز امر حق بگریزی چو مجرم از ایذا(@)(@@) 80 ور آیدت به زبان سوره قریب به طول %~% به آن رسد که کنی از ملال جبه قبا(@)(@@) 81 ز شام تا سحر امشب برای بی‌خبری %~% ستاده‌ای نه ز سر باخبر نه از سرما(@)(@@) 82 عجب‌تر آن که شبی رفته و تو یک ساعت %~% خیال کرده‌ای از شغل عشق وسوسه‌زا(@)(@@) 83 به گفت این وره قبله حقیقی جست %~% نشان حسن ازل را به چشم سر جویا(@)(@@) 84 بسی نرفت که دیدند خفته در چمنش %~% مگس نموده بر او از جوانب استیلا(@)(@@) 85 گرفته ماری از اخلاص نرگسی به دهن %~% ز بس ملاحظه او را مگس پران ز قفا(@)(@@) 86 تو هم اگر به خود افتی ز کوی بوالهوسی %~% شوی رهی و کنی دامن مجاز رها(@)(@@) 87 تو هم به شهد حقیقت اگر لب آلائی %~% کند هوای مگس رانی تو بال هما(@)(@@) 88 در آخر سخن ای نطق بهره‌ای برسان %~% به آن بهار هوس زان نصیحت عظما(@)(@@) 89 الا یگانه جگرگوشه کز تو دارد و بس %~% فروغ نسل محقر چراغ دوده ما(@)(@@) 90 ایا نتیجه آمال کز برادر من %~% تو مانده‌ای به من اندر امل سرای بقا(@)(@@) 91 به نفس اگرچه خطائی که در نصایح تند %~% ز روی قصد تو بودی مخاطبش 
ms288	 همه جا(@)(@@) 92 بیا که ختم نصیحت کنم به حرف دگر %~% به شرط آن که به سمع رضا کنی اصغا(@)(@@) 93 قدم نهاده‌ای اندر رهی که وادی امن %~% دروست منحصر اندر منازل اولا(@)(@@) 94 به قطع پانزدهم منزلی در آن وادی %~% که بر تو نیست گرفتی ز کج روی قطعا(@)(@@) 95 ز چار منزل دیگر چو بگذری و کنی %~% به باج خانه تکلیف خیمه‌ها برپا(@)(@@) 96 وزان تجارت کم مدت سبک مایه %~% اثر ز سود و زیان عمل شود پیدا(@)(@@) 97 پی حساب تو خواهند طرح کرد به حکم %~% محرران فصول عمل مفصل‌ها(@)(@@) 98 که گر خوری لب نانی بر آن شود مرقوم %~% و گر کشی دم آبی در آن بود مجرا(@)(@@) 99 غرض همین که چو فارغ شوی ز شغل و عمل %~% تو را به فاضل و باقی دهند اجر و جزا(@)(@@) 100 پس از تو گر عملی سر زند که به نشود %~% به فاضلت قلم کاتبان لسان فرسا(@)(@@) 101 نه به بود که ز باقی به قیدهای الیم %~% تن الم زده فرسایدت هلال آسا(@)(@@) 102 جزای بد عملی نیست تازیانه و چوب %~% که سوز آن بود امروز به شود فردا(@)(@@) 103 جزای بد عملی تابه ایست تابیده %~% تن تو ماهی آن تابه خالدا ابدا(@)(@@) 104 نه آنقدر ز مکافات می‌دهم بیمت %~% که بندی از رخ رحمت به یاس چشم رجا(@)(@@) 105 نه آنقدر دلت از عفو می‌کنم ایمن %~% که کم زند در طوف دل تو خوف خدا(@)(@@) 106 به صد ثواب ازو گر چه ایمنی غلط است %~% به صد هزار خطا ناامیدیست خطا(@)(@@) 107 کسی که سجده او نارواست در کیشش %~% هزار باره ازو حاجتش شده است روا(@)(@@) 108 تو کز سعادت اسلام بهره‌ای داری %~% عجب که تشنه روی از کنار بحر عطا(@)(@@) 109 گناه بنده نادم ز فعل نامرضی %~% اگر بزرگ‌تر از عالم است و مافیها(@)(@@) 110 فتد به معرض عفو غفور چون شوید %~% به آب توجه 
ms289	 رخ معصیت کمای رضا(@)(@@) 111 ولی بدان که گناه و خطای توبه پذیر %~% ز غیر حق خدا خارج است و مستثنا(@)(@@) 112 چو یافت موعظه اتمام سعی کن که تمام %~% بیاد داری و آری تمام عمر به جا(@)(@@) 113 کشی هزار زیان گر یکی ازین سخنان %~% رود زیاد تو تا وقت رفتن از دنیا(@)(@@) 114 به قصد تزکیه نفست از نصیحت و پند %~% چو گشت خاتمه یاب این قصیده عزا(@)(@@) 115 به عهد کردم از آن ذکر دایمش تاریخ %~% که دایم این بودت ذکر در خلا و ملا(@)(@@) 116 دگر تو دانی و رایت که رایت فکرت %~% بلند شد به مناجات حی بی‌همتا(@)(@@) 117 بزرگوار خدایا که ذات بی‌چونت %~% که بسته عالمیان را زبان ز چون و چرا(@)(@@) 118 به کنز مخفیت آن شاهد نهفته جمال %~% که تا ابد نکند جلوه بر دل عرفا(@)(@@) 119 به اسم اعظمت آن گنج بی‌نشان که اگر %~% فتد به دست نهد غیر پا بکوی فنا(@)(@@) 120 به آن گروه که از انقیاد فرمانت %~% به جنس خاک نکردند از سجود ابا(@)(@@) 121 به انبیای اولوالعزم خاصه پاد شهی %~% که راند رخش عزیمت بر اوج او ادنا(@)(@@) 122 به اولیای ذوالحزم خاصه کراری %~% که بر تو نقد بقا می‌فشاند روز دغا(@)(@@) 123 بلابه لب لبیک گوی کعبه روان %~% به کعبه و عرفات و به مشعر و به منا(@)(@@) 124 به مجرمان پشیمان که از حیا سوزند %~% اگر کنند سر از بهر معذرت بالا(@)(@@) 125 به تائبان موفق که در رسند به عفو %~% ز گفت شان چو ظلمنا رسد به انفسنا(@)(@@) 126 به بیگناهی زندانیان شحنه عشق %~% به بی‌نشانی سرگشتگان دشت بلا(@)(@@) 127 به پاکدامنی عاشقان عصمت دوست %~% که جیب خاطرشان کم کشیده دست هوا(@)(@@) 128 به گریه‌های زمان غریو خیز وداع %~% که سنگ را اثر آن درآورد به بکا(@)(@@) 129 به آب چشم یتیمان چهره گرد آلود %~% که تاب دیدنشان ناورد دل خارا(@)(@@) 130 به بی‌زبانی 
ms290	 طفلان مضطرب در مهد %~% که دردشان نپذیرد ز نطق بسته دوا(@)(@@) 131 به مادران جگرگوشه در نظر مرده %~% که از فلک گذرانند بانگ واولدا(@)(@@) 132 به آن کثیر عیالان بینوا که مدام %~% خیال بیع مصلی کنند و رهن ردا(@)(@@) 133 بسوز قافله مبتلا به غارت جان %~% که آهشان نگذارد گیاه در صحرا(@)(@@) 134 به درد پرد گیانی که دست حادثه‌شان %~% کشد ز هودج عصمت برون به ظلم و جفا(@)(@@) 135 به طول طاعت ترسندگان ز صبح نشور %~% که روی خواب نبینند در شب یلدا(@)(@@) 136 به غازیان مجاهد که در تکاور شوق %~% کنند جان خود از بهر نصرت تو فدا(@)(@@) 137 بهر چه نزد تو دارد نشان خیر و بهی %~% بهر که پیش تو از اهل عزتست و بها(@)(@@) 138 که چون لوای شفاعت نهی به دوش نبی %~% دوانی اهل گنه را به ظل آل عبا(@)(@@) 139 چنان کنی که شود محتشم طفیل همه %~% یکی ز سایه نشینان آن خجسته لوا(@)(@@) 140 که جرم کافر صد ساله می‌توان بخشید %~% به یک شفاعت او یا رسول اشفعنا PageV1P616(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ماه چارده ز جمال تو در حجاب %~% حیران آفتاب رخت چشم آفتاب(@)(@@) 2 شیدائی خرامش قد تو سرو باغ %~% سودائی سلاسل موی تو مشگناب(@)(@@) 3 خورشید در مقدمه شب کند طلوع %~% بعد از غروب اگر ز جمال افکنی نقاب(@)(@@) 4 ماه نو از نهایت تعظیم گشته است %~% بر آسمان نگون که ببوسد تو را رکاب(@)(@@) 5 رضوان اگر شود به سکان تو مختلط %~% از اختلاط حور بهشتی کشد عذاب(@)(@@) 6 از بهر گردن سگ زرین قلاده‌ات %~% حور آورد ز گیسوی خود عنبرین طناب(@)(@@) 7 از ترک چشمت آرزوی کاینات را %~% در هر نگه هزار سوالی است بی‌جواب(@)(@@) 8 بیدار از انفعال نگردند تا ابد %~% حور وپری جمال تو بیند اگر به خواب(@)(@@) 9 در بزم از فرشته عجب نبود ار خورد %~% از دست ساقیان ملک پیکرت شراب(@)(@@) 10 در رزم 
ms291	 از هزار چه رستم عجب بود %~% کارند در مقابل یک حمله تو تاب(@)(@@) 11 تیغت اگر رسد به زمین سازدش دو نیم %~% دارد نشان ضربت شمشیر بوتراب(@)(@@) 12 از جوف هر حباب جهانی شود پدید %~% چون نقش پادشاهیت دوران زند بر آب(@)(@@) 13 یزدان که شاه حمزه غازیت نام کرد %~% از زور حمزه در ازلت ساخت بهرهاب(@)(@@) 14 صد بحر را اگر به یکی شعله سر دهند %~% با حفظ کامل تو نیفتد ز التهاب(@)(@@) 15 خود را ز چرخ در ظلمات افکند ز هم %~% بر آفتاب اگر نظر اندازی از عتاب(@)(@@) 16 ترسیده چشم ظلم چنان از عتاب تو %~% که آرامگاه صعوه شود دیده عقاب(@)(@@) 17 خواهی که پای بندی اگر جبرئیل را %~% دست فرشتگان شود از حکم رشته تاب(@)(@@) 18 اجزاش التزام معبت کنند اگر %~% سیماب را ز تفرقه فرمائی اجتناب(@)(@@) 19 چون قوت تو دست ضعیفان کند قوی %~% سیمرغ را فرو کشد از آسمان به آب(@)(@@) 20 گر عنکبوت را به مثل تقویت کنی %~% در لعب کوه را کند آویزه لعاب(@)(@@) 21 بر آستانت آن که کند بی‌ریا سجود %~% تعظیم ذوالمنن کندش آسمان حباب(@)(@@) 22 در خجلت است از دل بخشنده‌ات محیط %~% در شرمساری از کف پاشنده‌ات سحاب(@)(@@) 23 در دست خازنان تو ماند زر و گهر %~% غربال را اگر به توان ساخت ظرف آب(@)(@@) 24 ای شاه و شاه زاده دوران من حزین %~% کز شمع نطقم انجمن افروز شیخ و شاب(@)(@@) 25 با آن که خسروان اقالیم نظم را %~% هم صاحب‌الرسم و هم مالک‌الرقاب(@)(@@) 26 با آن که در مزارع نظم از کلام من %~% هر دانه گشته است ز صد خرمن از سحاب(@)(@@) 27 با آن که در ممالک هند و بلاد روم %~% نظم من است خال رخ لؤلؤ خوشاب(@)(@@) 28 این جا که نسبتش به فغانست این و آن %~% بی وجه و ناروا و بعید است و ناصواب(@)(@@) 29 یک مصرعم به جایزه هرگز نمی‌رسد %~% زان 
ms292	 رو که خرمنم به جوی نیست در حساب(@)(@@) 30 دیوان ثانی غزل من که حال هست %~% زیب کتابخانه نواب کامیاب(@)(@@) 31 آرند اگر به مجلس عالی و یک غزل %~% خوانند حاضران سخن سنج از آن کتاب(@)(@@) 32 ظاهر شود که لاف گزافی نبوده است %~% این حرف شاعرانه که شد گفته بی‌حجاب(@)(@@) 33 حال از برای شاهد آن دعوی این عزل %~% شد ضم به این قصیده زبر وجه انتخاب(@)(@@) 34 ای زیر مشق سر خط حسن تو آفتاب %~% در مشق مد کشیدن زلف تو مشگناب(@)(@@) 35 بس نقش خامه زیر و زبر گشت تا از آن %~% نقشی چنین ز دقت صانع شد انتخاب(@)(@@) 36 عکست که جای کرده در آب ای محیط حسن %~% می‌بیندت مگر که چنین دارد اضطراب(@)(@@) 37 در عالمی که رتبه حسن از یگانگی است %~% نه آینه است عکس‌پذیر از رخت نه آب(@)(@@) 38 هیهات ما و عزم وصال محال تو %~% کان کار و هم فعل خیالست و شغل و خواب(@)(@@) 39 از من نهفته مانده به بزم از حجاب حسن %~% روئی که آن نهفته نمی‌گردد از نقاب(@)(@@) 40 بیتی شنو ز محتشم ای بت که بهتر است %~% یک بیت عاشقانه ز بیتی پر از کتاب(@)(@@) 41 تا در خراب کردن عالم کنند سعی %~% شور و فتور و فتنه و آشوب و انقلاب(@)(@@) 42 ملکت نگردد از مدد حفظ ایزدی %~% از صدهزار حادثه این چنین خراب PageV1P617(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا نقش ناتوانی من چرخ زد بر آب %~% شد چون حباب خانه جمعیتم خراب(@)(@@) 2 از کاو کاو تیشه پیکر خراش درد %~% بنیاد من رساند سپهر نگون به آب(@)(@@) 3 جسمم ز تاب درد سراسیمه کشتی است %~% لنگر گسل ز جنبش دریای اضطراب(@)(@@) 4 ز انسان که گرگ در غنم افتد غنیم‌وار %~% در لشکر حواس من افکنده انقلاب(@)(@@) 5 دهرم به حال مرگ نشانداست در حیات %~% دورم شراب شیب چشانده است در شباب(@)(@@) 6 پیوند تن نمی‌گسلد جان که 
ms293	 تا رهم %~% با آن که چرخ می‌دهدش صد هزار تاب(@)(@@) 7 مرغیست بخت سوخته من که آمده %~% هم پیشه سمندر وهم کسوت عراب(@)(@@) 8 افسرده‌ام چنان که اگر آه سرد من %~% بر دوزخ افکند گذراند ازدش زتاب(@)(@@) 9 اما خوشم که اخگر خس پوش دل ز غیب %~% می‌آید از خجسته نسیمی به التهاب(@)(@@) 10 بوی بهشت می‌شنوم از ریاض لطف %~% گوئی خلاص می‌شوم از دوزخ عذاب(@)(@@) 11 از درگهی که هست سگش آهوی حرم %~% در گردنم به یک کشش افکنده صد طناب(@)(@@) 12 لیکن چو نیست پای تردد چه سان شوم %~% بهر شرف ز سجده آن سده بهره یاب(@)(@@) 13 یک ذره‌ام توان چو نمانداست چون کنم %~% خورشیدوار ناصیه سائی بر آن جناب(@)(@@) 14 برخیز ای صبا که ازین پس نمی‌شود %~% شوق سبک عنان متحمل گران زکاب(@)(@@) 15 از من دعا و از تو شدن حاملش چنان %~% کارام را وداع کند عزمت از شتاب(@)(@@) 16 از من ثنا و از تو رساندن دوان دوان %~% جائی که قطره بحر شود ذره آفتاب(@)(@@) 17 یعنی جناب عالی بلقیس روزگار %~% یعنی حریم حرمت نواب مستطاب(@)(@@) 18 شهزاده زمان و زمین شمسه جهان %~% زهرای زهره حاجبه مریم احتجاب(@)(@@) 19 شاه‌پری و انس پری خان که گر بدی %~% بلقیس پادشاهی ازو کردی اکتساب(@)(@@) 20 خیرالنسا عهد که دوران جز او نداد %~% عز مشارکت احدی را به این خطاب(@)(@@) 21 معصومه زمان که نبات زمانه‌اند %~% از احتسا عصمت او عصمت احتساب(@)(@@) 22 هودج کشان شخص عفافش نمی‌کشند %~% بر دیده ملک ز ورع دامن ثیاب(@)(@@) 23 گردیده دایم‌الحرکت از عبادتش %~% دست فرشتگان ز رقم کردن ثواب(@)(@@) 24 می‌سنجدش به زهد و طهارت خرد مدام %~% با طاهرات حجره زهرا و بوتراب(@)(@@) 25 از بهر پادشاهی نسوان قضا نکرد %~% فردی ز کاینات به این خوبی انتخاب(@)(@@) 26 مهر فلک کنیزک خورشید نام اوست %~% کاندر پس سه پرده نشست است از حجاب(@)(@@) 27 وز شرم کس نکرده نگه در رخش 
