ms121	 تجتنى % % لديك ولا زالت عرائس تجتلا % % PageV01P355 البحر : كامل تام 1(@)(@@) % أما الحسان فما لهن عهود % ولهن عنك وما ظلمن محيد % 2(@)(@@) % فاربع فما للبيض فيك لبانة % لسواك خوط البانة الأملود % 3(@)(@@) % وابغ النباهة والثراء بعزمة % لم يثنها لوم ولا تفنيد % 4(@)(@@) % قد أعوز الماء الطهور وما بقي % % غير التيمم لو يطيب صعيد % 5(@)(@@) % ونبا بي الوطن القيدم وإنني % % في البعد عمن حله لسعيد % 6(@)(@@) % وتنوفة عقمت فما تلد الكرى % % لكنها للنائبات ولود % 7(@)(@@) % فيها يطيش السهم وهو مسدد % ويضل رأي المرء وهو سديد % 8(@)(@@) % أفنيتها بقلائص عاداتها % % أن تنقص الفلوات وهي تزيد % 9(@)(@@) % وصى بها حيدان مهرة سالفا % ونمى الجديل أصولها والعيد % 10(@)(@@) % فمررن يخبطن الدياجي والفلا % وأظنهن علمن أين أريد % PageV01P356 11(@)(@@) % تأتم ملكا بالعواصم بحره % عذب المياه وظله ممدود % 12(@)(@@) % أنفت من المتكلفي بذل اللهى % % فلها صدوف عنهم وصدود % 13(@)(@@) % ووراءها من لا أذم مهانة % وأمهامها محمود المحمود % 14(@)(@@) % ملك لما تبني يداه شائد % ولما بناه أولوه مشيد % 15(@)(@@) % ما زال يبتدع العلاء مناقضا % من رأيه في حوره التقليد % 16(@)(@@) % ويفوت أهل الأرض بالشيم التي % % يمتار منها سيد ومسود % 17(@)(@@) % وغرايب من نطقه ما مثلها % % في الفضل مكتسب ولا مولود % 18(@)(@@) % يعطي ولو سيم الحياة أو الصبى % % ويفي ولو بالغدر نيل خلود % 19(@)(@@) % وإذا انتمى يوم الوغى ثم أكتنى % % فالنصر فيه مبديء ومعيد % 20(@)(@@) % ومتى تخوف ذي البلاد ودونها % % ملك تدين له الملوك الصيد % PageV01P357 21(@)(@@) % وليت نمير نصره وربيعة % وله من العزم الوحي جنودث % % 22(@)(@@) % ولقد حباه أخوة ومحبة % وله نهود في المغار عليهم % 23(@)(@@) % ودعاه ذا الحسبين علما أنه % يزهى به التعظيم والتمجيد % 24(@)(@@) % ياابن الذين إذا تضوع نشرهم % كسد العبير به وهان العود % 25(@)(@@) % أسر لها فوق السماء أسرة % ولطفلها الحابي هناك مهود % 26(@)(@@) % قوم أقاموا سوق كل فضيلة % كسدت وقاموا والأنام قعود % 27(@)(@@) % و غنوا ولا في البأس يدخل ذكرهم % والبأس أوفى كسبهم والجود % 28(@)(@@) % كل إذا ما الحرب شبت عامر % وإذا أتى الأضياف فهو لبيد 
ms122	 % 29(@)(@@) % تتوقع الأذواد منه عاقرا % ما زال يحمي سرحها ويذود % 30(@)(@@) % من كل محدثة الفصيل ومقرم % قد صد عنه الجيش وهو عتود % PageV01P358 31(@)(@@) % تصبيه مرهفة الظبى مخضوبة % بدم الأعادي لا الظباء الغيد % 32(@)(@@) % وله نههود في المغار عليهم % تنسي غصونا حملهن نهود % 33(@)(@@) % فلوات لا ناي يروق وعود % % 34(@)(@@) % طالوا الأنام وطلتهم بخلائق % خلقت على ما تشتهي وتريد % 35(@)(@@) % ولقد حويت من المعالي طارفا % تغنى به عن أن يعد تليد % 36(@)(@@) % كرم تمد إليه أعناق المنى % % وسطى لهيبتها الجبال تميد % 37(@)(@@) % ونأيت عن أهل الزمان بهمة % قد جازت النسرين وهي صعود % 38(@)(@@) % لا كالرجال تباينوا لكن كما % % يتباين الموجود والمفقود % 39(@)(@@) % فلذا الثناء عليك ضد ثنائهم % ذا منشد أبدا وذا منشود % 40(@)(@@) % ما زال يسقم وعدهم ووعيدهم % ويصح عندك موعد ووعيد % PageV01P359 41(@)(@@) % عاشوا وما يخضل في حجراتهم % ترب ولا يخضر فيهم عود % 42(@)(@@) % فأرحتهم باليأس من ذا المرتقى % % فلهم نكوص دونه وندود % 43(@)(@@) % وإذا سمت آمال حاسد نعمة % بسط الرجاء فعبدك المحسود % 44(@)(@@) % والعيش غض ما سلمث لأمة % إصلاحها إلا عليك بعيد % 45(@)(@@) % أوطنت فيها الأمن بعد مزوحه % ونفيت عنها الخوف فهو طريد % 46(@)(@@) % فلو استطاعت أن تكلم أرضهم % أثنت عليك تهائم ونجود % 47(@)(@@) % ظلت عشيرتك التي عاشرتها % % فلها مروق دائم ومرود % 48(@)(@@) % فجعلت محض الخوف ملء صدورهم % فعنا عنيد وأستقام عنود % 49(@)(@@) % ما إن يحل الرعب صدرا واغرا % فتقيم فيه سخائم وحقود % 50(@)(@@) % لو كنت يا تاج الملوك مؤآزرا % لسمي جدك ما عصته ثمود % PageV01P360 51(@)(@@) % أو كنت ناصر هاشم فيما مضى % % ما ضل مرتاد وخاب مريد % 52(@)(@@) % تزداد مجدا ليس يعرف كلما % % قالت عداتك ما عساه يزيد % 53(@)(@@) % فشم السيوف فطالما جردتها % % حتى لقلنا ما لهن غمود % 54(@)(@@) % هندية كم مزقت في مأزق % ما كان أحكم سرده داود % 55(@)(@@) % أثنى عليك مؤالف ومخالف % طوعا بأنك في الزمان فريد % 56(@)(@@) % فعجبت كيف أقر أنك واحد % في الناس من ما دينه التوحيد % 57(@)(@@) % وقصرت وعدك فليدم مقصوره % لمؤمليك وعمرك الممدود % 58 
ms123	(@)(@@) % تغني العفاة وتصطفي مهج العدى % % قامت بذاك أدلة وشهود % 59(@)(@@) % وبمنهج الأطماع تختلف الورى % % هذا يفيد غني وذاك يبيد % 60(@)(@@) % يا كعبة الجود التي طفنا بها % % فلنا ركوع حولها وسجود % PageV01P361 61(@)(@@) % بجنابك ابيضت ليالي التي % % أيامها من قبل قربك سود % 62(@)(@@) % وخرجت من حجر الزمان لعلمه % أني بإفضائي إليك رشيد % 63(@)(@@) % منن غلبت بها القريض فما له % بذراك تصويب ولا تصعيد % 64(@)(@@) % وأعدن لي شرخ الشباب ولم أخل % من قبلها أن الشباب يعود % 65(@)(@@) % ولهن في سوق الثناء بضائع % تزجى وفي سوق العفاة قيود % 66(@)(@@) % أذهلتني عن أن أقوم بحقها % % يا واسمي بالعجز حين يجود % 67(@)(@@) % وإذا أعترفت به وقصر خاطري % % عيا فذاك الإعتراف جحود % 68(@)(@@) % لا تلزمني فوق جهدي معنتا % بصفات مجد مالها تحديد % 69(@)(@@) % ومع اعتذاري فاستمع لغريبة % عوناي فيها الفكر والتسهيد % 70(@)(@@) % لو أن فحلي طيء حضرا لها % % PageV01P362 71(@)(@@) % مبذولة في القوم وهي مصونة % معقولة في الحي وهي شرود % 72(@)(@@) % خفت على الأفواه حتى لانبرت % تحدو بها معنا المطايا القود % 73(@)(@@) % وتكررت فينا فمما كررت % قد صار يحفظها الدجى والبيد % 74(@)(@@) % فاضل بها الأشعار تعرف فضلها % % ما كل من مدح المجيد مجيد % 75(@)(@@) % أوصيك بي خيرا فإني في الألى % % أصبحت مالك رقهم معدود % 76(@)(@@) % ووصيتك فجد بعفوك زلة % ما فوق ما أوليتنيه مزيد % 77(@)(@@) % أينالني شيء أحاذره ولي % % من حسن رأيك عدة وعديد % 78(@)(@@) % لا زلت تبلي كل عام قادم % في العز ما خلف اللبيس جديد % 79(@)(@@) % وأرى النجوم تخالفت أحكامها % % إلا عليك فإنهن سعود % PageV01P363 البحر : كامل تام 1(@)(@@) % يا للرجال لنظرة سفكت دما % % ولحادث لم ألقه مستلئما % % 2(@)(@@) % وأرى السهام تؤم من يرمى بها % % فعلام سهم اللحظ يصمي من رما % % 3(@)(@@) % يا آمري بتجلد لم أعطه % ما نم دمعي بالجوى حتى نما % % 4(@)(@@) % ولقد وقفت بدار زينب موهنا % والوجد يأبى أن أقول فأفهما % % 5(@)(@@) % مستخبرا عنها فلم أر معلما % منها بأخبار الأحبة معلما % % 6(@)(@@) % أبكي ويمنعني تناسي ما مضى % % ما يمنع الأطلال أن تتكلما % % 7(@)(@@) % فعذلت 
ms124	 قلبي إذ أطاع غرامه % وعصى التسلي بعدها واللوما % % 8(@)(@@) % واللوم مثل الريح يذهب ضلة % ويزيد نيران المحب تضرما % % 9(@)(@@) % وخطيطة ضن الغمام بريها % % خلفتها خلفي وسرت ميمما % % 10(@)(@@) % أرضا إذا ما الترب أجدب أخضبت % بندى إذا ما الغيث أنجم أثجما % % PageV01P364 11(@)(@@) % يلقى بها الرواد روضا مزهرا % ويصادف الوراد حوضا مفعما % % 12(@)(@@) % وترى بها أم المدامة عاقرا % أبدا وأم الحمد حبلى متئما % % 13(@)(@@) % أضحت بإحسان المظفر كعبة % للطالبين وللمكارم موسما % % 14(@)(@@) % ملك إذا سئل الرغائب واللهى % % أعطى وإن لاقى الكتائب أقدما % % 15(@)(@@) % يربي على القدر المتاح إذا سطا % % ويجاود الجود السحاح إذا هما % % 16(@)(@@) % أوفى من الشمس المنيرة بهجة % وأشف منزلة وأبعد مرتما % % 17(@)(@@) % منع الليالي أن تبيت موانعا % ما رام أو مستبذلات ما حما % % 18(@)(@@) % يأبى الغواني والغناء وينتشي % % طربا إذا كان الصليل ترنما % % 19(@)(@@) % همم علون على السماك وإنما % % بالجود والإقدام يسمو من سما % % 20(@)(@@) % ومناقب أعيا الأعادي كتمها % % والشمس أظهر أن تسر وتكتما % % PageV01P365 21(@)(@@) % ومواهب راجي جداها لم يخب % منه وراضع درها لن يفطما % % 22(@)(@@) % غدت الجيوش غزيرة بأميرها % % والدهر محمودا وكان مذمما % % 23(@)(@@) % والأمن جما والرجاء مصدقا % والحق أبلج والهدى مستعصما % % 24(@)(@@) % لله درك في طغاة قبائل % أنصفت منها الدين حين تظلما % % 25(@)(@@) % فلكم جنيت أذى حسمت به أذى % ولكم سفكت دما حقنت به دما % % 26(@)(@@) % لما أزرتهم الظبى مصقولة % والخيل قبا والوشيج مقوما % % 27(@)(@@) % ظنوك من لاقوا فحين قرعتهم % صاروا وقد كانوا حديدا حنتما % % 28(@)(@@) % قهروا الورى زمنا فمذ حاربتهم % طم الأتي عليهم لما طما % % 29(@)(@@) % وهم حماة الروع إلا أنهم % فروا لعمرك حين فروا الأرقما % % 30(@)(@@) % ثم انثنيت إلى سرايا طيء % تقتاد أرعن كالخضم عرمرما % % PageV01P366 31(@)(@@) % متنائي الأقطار زاد قتامه % فغدا به وجه النهار ملثما % % 32(@)(@@) % تبدو بوارقه فتحسب ضوءها % % برقا تألق في سحاب أظلما % % 33(@)(@@) % وتخال نقع الأعوجية دونه % سترا بلمع القعضبية معلما % % 34(@)(@@) % حتى إذا أنشيتهم بسلافة % والحين يعجب منهم متبسما % % 35(@)(@@) % ظنوا الطلائع كل من يأتيهم % فتثبتوا للداء حتى استحكما % % 36(@)(@@) % لما 
ms125	 أتيت فكنت ريحا عاصفا % تلوي بما لاقت وكانوا خشرما % % 37(@)(@@) % لم تلق إلا عاريا سبقت به % روعاء أو مستلئما مستسلما % % 38(@)(@@) % والعز حيث ترى الدماء مراقة % تروي الثرى والسمهري محطما % % 39(@)(@@) % والوهد أدون أن ينال متالعا % والذئب أهون أن يروع الضيغما % % 40(@)(@@) % ملكوا فجاروا في القضايا واعتدوا % % وعدلت فيهم إذ غدوت محكما % % PageV01P367 41(@)(@@) % فمنحتهم جبلي أبيهم إرثهم % عنه وساءا منزلا ومخيما % % 42(@)(@@) % فهم ببيد يصطلون بما جنوا % % فيها إذا حمي الهجير جهنما % % 43(@)(@@) % من سائر الطرداء أبعد مشربا % وأرث أطمارا وأخبث مطعما % % 44(@)(@@) % وحرمتهم طيب الكرى حتى لقد % ظنوا الرقاد على الجفون محرما % % 45(@)(@@) % عمري لقد وجدوا اصطناعك سالفا % أريا وقد وجدوا اجتياحك علقما % % 46(@)(@@) % فرأوك عند السلم بحر مواهب % يغني وفي الهيجاء عضبا مخذما % % 47(@)(@@) % ورجعت تنظر في البلاد برأي ذي % % عزم يرد المشرفي مثلما % % 48(@)(@@) % حصنت شاسعها برأي لو حمى % % بدر السماء عن النواظر لاحتما % % 49(@)(@@) % وعمرت غامرها بجد لم يزل % يأبى لما تبنيه أن يتهدما % % 50(@)(@@) % أنى يشاركك الورى في رتبة % أدلجت تطلبها وباتوا نوما % % PageV01P368 51(@)(@@) % حملت نفسك غير مكترث به % أمرا يؤود يرمرما ويلملما % % 52(@)(@@) % فبغت مطالعك الملوك فقصرت % ورأى وقائعك الزمان فأحجما % % 53(@)(@@) % مهلا فما أبقى نزالك خائفا % خطبا ولا أبقى نوالك معدما % % 54(@)(@@) % لا تكذبن فما أمامك غاية % فانظر مليا هل ترى متقدما % % 55(@)(@@) % ناهيك من كرم يفوق به الحيا % % سبقا ومن بأس يفوت الأنجما % % 56(@)(@@) % وعزائم حشت القلوب أسنة % مثل الخناجر والخناجر أسهما % % 57(@)(@@) % فقضت لذكرك أن يسير مفوزا % وقضت لذكرك أن يجل ويعظما % % 58(@)(@@) % يهني الخلافة أن عدتها شجى % % حلق العدو وسيفها لن يكهما % % 59(@)(@@) % وليهنك العيد السعيد مضاعفا % لك أجر من صلى وصام وأحرما % % 60(@)(@@) % إني لأشعر من رأيت وإنني % % أصبحت عن إدراك وصفك مفحما % % PageV01P369 61(@)(@@) % ولقد أرحت الخيل نحوك ضمرا % والعيس يحملن القريض المحكما % % 62(@)(@@) % يحملن منه مفصلا ومنظما % % ومحبرا وموشحا ومسهما % % 63(@)(@@) % مدح كزهر الروض إلا أنه % يبقى إذا زهر الرياض تصرما % % 64(@)(@@) % إني كتمت الشعر في طي المنى 
ms126	 % % فعل امرئ لم يرض ما دون السما % % 65(@)(@@) % لا أسأل الرحمن حظا فوق ما % % أعطى فقد أولى الجميل وأنعما % % 66(@)(@@) % حسبي امتداحك رتبة ونباهة % وذراك معتصما وقربك مغنما % % PageV01P370 البحر : كامل تام 1(@)(@@) % طاول بهمتك الزمان وحيدا % % فأرى مداك على الأنام بعيدا % % 2(@)(@@) % ولقد بلغت ببعض سعيك رتبة % أعيت على من لم يدع مجهودا % % 3(@)(@@) % فلييأس الشرف الذي أوتيته % من لا يقوم مقامك المحمودا % % 4(@)(@@) % فالعز يأبى أن ينيل يسيره % من لا يكون على الجلاد جليدا % % 5(@)(@@) % ومحمل الأيام ما لم تحتمل % يفني الحياة مخيبا مكدودا % % 6(@)(@@) % أنى ينال محلة الجوزاء من % لا يستطيع من الصعيد صعودا % % 7(@)(@@) % قد شاع مجدك فهو أشهر في الورى % % من أن تروم له عداك جحودا % % 8(@)(@@) % فلو ابتغيت بما أقول شهادة % لوجدت أهل الخافقين شهودا % % 9(@)(@@) % غاضت ينابيع الكرام بعارض % أوفى على جود الغمائم جودا % % 10(@)(@@) % تزجي عواصفه سحائب للمنى % % بيضا وسحبا للمنايا سودا % % PageV01P371 11(@)(@@) % مثعنجر كف المظفر أفقه % لم يبق ذا عدم ولا مزؤودا % % 12(@)(@@) % فاعتاض أهل الشام من خوف الردى % % أمنا ومن عدم اليسار وجودا % % 13(@)(@@) % بأغر ما أم المناقب تابعا % فيها ولا أخذ العلى تقليدا % % 14(@)(@@) % لكن يؤسس ما بنى عن همة % أبدا تعاف المنهل المورودا % % 15(@)(@@) % ما زال يسبق جوده ميعاده % كرما ويسبق سيفه التهديدا % % 16(@)(@@) % حتى أبان عن اعتزام لم يزل % للمال والباغي العنيد مبيدا % % 17(@)(@@) % وعتا الزمان فكف من غلوائه % فعنا وصار لما يريد مريدا % % 18(@)(@@) % ياسيف من عصيانه وولاؤه % جعلا شقيا في الورى وسعيدا % % 19(@)(@@) % خل العدو فقد غدا أنجادهم % لم يضمروا لمهند تجريدا % % 20(@)(@@) % ملأت وقائعك القلوب مخافة % ضاقت بها عن أن تجن حقودا % % PageV01P372 21(@)(@@) % ورفعت نارا كلما أوقدتها % % زادت بها نار العدو خمودا % % 22(@)(@@) % هي نار إبراهيم للباغي الندى % لكن على الباغي تشب وقودا % % 23(@)(@@) % ولوا ولو أوغلت تطلب إثرهم % لم يحم ملك الروم منك طريدا % % 24(@)(@@) % ولو اتبعت موليا فيما مضى % % لتبعتهم سيرا يبيد البيدا % % 25(@)(@@) % بالمقربات مقربات نحوهم % لا تعرف الإيضاع والتخويدا % % 26(@)(@@) % مقورة 
ms127	 تردي بكل مفازة % تردي السوابق والمطايا القودا % % 27(@)(@@) % نزعت كسى من نيها وتسربلت % من نقعها فوق الجلود جلودا % % 28(@)(@@) % في فيلق لو لم تقده إلى العدى % % لكفاك بأسك عدة وعديدا % % 29(@)(@@) % حملت ضراغمه الحديد مذلقا % وتدرعت حزما به مسرودا % % 30(@)(@@) % فليلبثوا حيث استقرت دارهم % وأردت ما دام الحديد حديدا % % PageV01P373 31(@)(@@) % وليحذروا الهمم التي منعتهم % من أن يقيموا بالشام عمودا % % 32(@)(@@) % نقضت حبالهم حبائل لم تزل % قدما تصيد بها الملوك الصيدا % % 33(@)(@@) % ولطالما صبحتهم في غارة % ألفوا بها أم اللهيم ولودا % % 34(@)(@@) % لم تبق في بكر لرب هنيدة % بكرا ولا لبني عتود عتودا % % 35(@)(@@) % ظنوا بها نقع الجياد ووقعها % % عند المغار سحائبا ورعودا % % 36(@)(@@) % ومتى مددت قنا فما أوردتها % % من كل باغ ثغرة ووريدا % % 37(@)(@@) % ومتى سللت ظبى فما كانت لها % % هاماتهم عند اللقاء غمودا % % 38(@)(@@) % أم أي يوم وغى شهدت فلم يكن % يوما أغر محجلا مشهودا % % 39(@)(@@) % فرأوك أصدق منهم عند الندى % % أريا جنوا جنوه هبيدا % % 40(@)(@@) % % وعدا وأنكى في العدو وعيدا % % PageV01P374 41(@)(@@) % وأرى جناب مبينة عن رشدها % % إذ لم ترم عن ذا الجناب محيدا % % 42(@)(@@) % نالت بقربك عزة ونباهة % وحمت بسيفك طارفا وتليدا % % 43(@)(@@) % قلدتها مننا شفعن صنائعا % يجعلن أحرار الرجال عبيدا % % 44(@)(@@) % ومددت باع أبي سماوة منجزا % لأبيه في استصلاحه الموعودا % % 45(@)(@@) % ونأى بمن كفر الضيعة فعله % فغدا لخوفك في البلاد شريدا % % 46(@)(@@) % ولطالما خصت نحوس كواكب % قوما وكن لآخرين سعودا % % 47(@)(@@) % أضحى يرود المحل مغرور مضى % % عن ذا المحل محلأ مطرودا % % 48(@)(@@) % وورى زناد من اعتلت آراؤه % حتى تقيل ظلك الممدودا % % 49(@)(@@) % كم آمنت سطوات عزمك خائفا % وجلا وراعت أروعا صنديدا % % 50(@)(@@) % وتخرمت ملكا وردت ذاهبا % لولاك لم يك مثله مردودا % % PageV01P375 51(@)(@@) % فاسلم على مر الزمان لأمة % تلقى بقربك كل يوم عيدا % % 52(@)(@@) % ولدولة قد صرت منتجبا لها % % زادت وعزت منعة وجنودا % % 53(@)(@@) % واسعد بمولود سما لمحلة % أمسى لها بدر السماء حسودا % % 54(@)(@@) % إذ خصه خير الأنام بنعمة % لم يحبها كهلا ولا مولودا % % 55(@)(@@) % وأناله اسما من 
ms128	 صفاتك مؤذنا % منه بأمر لا يزال حميدا % % 56(@)(@@) % سعد الذي يرجو إمام العصر أن % سيكون في حالاته مسعودا % % 57(@)(@@) % نعم يهنيك الإله جديدها % % فلقد لبست بها الفخار جديدا % % 58(@)(@@) % ويريك محمودا مبلغ غاية % في الملك أعجز نيلها محمودا % % 59(@)(@@) % تروى مناقبه ويروي حوضه % عند المعاطش من أراد ورودا % % 60(@)(@@) % وترى بحضرته لي ابنا شاعرا % مثلي مجيدا في الثناء مجيدا % % PageV01P376 61(@)(@@) % يا مصطفى الملك الذي كان الندى % % هما فعاود في ذاره وليدا % % 62(@)(@@) % أنهجتني من نهج فضلك مسلكا % تثني مسافته البليغ بليدا % % 63(@)(@@) % فلئن حصرت فإن عذري واضح % أن لست أبلغ للسما تحديدا % % 64(@)(@@) % ولئن نطقت فإن أيسر ما أرى % % من مأثراتك ينطق الجلمودا % % 65(@)(@@) % ألفيتهن جواهرا منثورة % وعلى القوافي أن يصرن عقودا % % 66(@)(@@) % فلك الفريد وقد وجدت نظامه % ولي الثناء وقد وجدت فريدا % % 67(@)(@@) % حمد الورى لي ذا الثناء ومذهبي % % فيه فكنت الحامد المحمودا % % 68(@)(@@) % جوزيت عن شكري بشكر مثله % فععدت ما تسدي إلي مزيدا % % PageV01P377 البحر : متقارب تام 1(@)(@@) % تفردت بالمجد دون الأمم % وحزت من العزم ما لم يرم % 2(@)(@@) % فما لحديث أتى في العلا % % حديث ولا لقديم قدم % 3(@)(@@) % وفي كل يوم ثناء يسير % ومجد يخص وجود يعم % 4(@)(@@) % سلكت إلى نيل ما رمته % سبيلا لغيرك لم يستقم % 5(@)(@@) % وقد أعجز الناس هذا الصعود % وما بلغت منتهاها الهمم % 6(@)(@@) % ولو لم يكن لك إلا الفعال % لأغناك عن فخر خال وعم % 7(@)(@@) % على أن معشرك الضاربو % % ن هبرا حيال النعم % 8(@)(@@) % هم القوم يبلغ مولودهم % مدى الحلم قبل بلوغ الحلم % 9(@)(@@) % إذا خوشنوا فبحار الردى % % وإن حوسنوا فبحار الكرم % 10(@)(@@) % ولو لم يكن لهم مفخر % سواك لقال الورى حسبهم % PageV01P378 11(@)(@@) % وفي روض أيامك المونقات % تنزه طرف المنى فلتدم % 12(@)(@@) % فقد ضحك الدهر عجبا بها % % وما كان من قبلها يبتسم % 13(@)(@@) % أنرت ليالي أهل الشآم % وكان نهارهم مدلهم % 14(@)(@@) % وبيضت بالعدل سود الوجوه % وسودت بالأمن بيض اللمم % 15(@)(@@) % أبى حل سيفك عقد العدى % % لعقد الخلافة أن ينفصم % 16(@)(@@) % فلله جدك ماذا 
ms129	 بنى % % وإقبال جدك ماذا هدم % 17(@)(@@) % ولله سيف علي فكم % أشم المذلة أنفا أشم % 18(@)(@@) % لو كلت طيا بطي القفار % ولو لم ترم ملكهم لم يرم % 19(@)(@@) % وفرقتهم فرقا في البلاد % فهل كان عزمك سيل العرم % 20(@)(@@) % فإن شركوا الروم في شركهم % فما رزقوا الحظ من ملكهم % PageV01P379 21(@)(@@) % عليهم من اللعن أضعاف ما % % عليهم وليس لهم ما لهم % 22(@)(@@) % فلا يأمنوا نصرة المشركين % فعندهم فوق ما عندهم % 23(@)(@@) % وكل بعيد عليها أمم % بمنهزم من يدي منهزم % 24(@)(@@) % ومن مسلم خان إسلامه % ويظهر للشرك رعي الذمم % 25(@)(@@) % لقد عدموا الرأي فاستنصروا % % طرائد من ذل في نصرهم % 26(@)(@@) % فهب آل يونان لم يخبروا % % فأبناء قحطان من غرهم % 27(@)(@@) % وما يقبح الجهل من جاهل % كما يقبح الجهل ممن علم % 28(@)(@@) % وقد أطمع القوم إهمالهم % فعاثوا وأغراهم حينهم % 29(@)(@@) % فرد أرضهم في جيوش الإمام % لتنسي ما فعل المعتصم % 30(@)(@@) % ووفر بقسطون قسط النزول % بصحرآئها فالمسيؤون هم % PageV01P380 31(@)(@@) % فقد طالما نزلوا بالرقيم % فصبحت أحياءهم بالرقم % 32(@)(@@) % ويمم بها من ورآء الدروب % ليلحق بالمستذم المذم % 33(@)(@@) % فسمر الرماح تشكى الظما % % وبيض الصفاح تشكى القرم % 34(@)(@@) % فتلك مشاربها في الصدور % وهذي مطاعمها في القمم % 35(@)(@@) % وقالوا بغى القطبان اللقآء % وأوعد بالحرب فيما زعم % 36(@)(@@) % فقلت سيصرعه بغيه % كذاك بغى صالح فاخترم % 37(@)(@@) % وعيد تبين فيمن أتاه % كتبيين ريح الصبا في إضم % 38(@)(@@) % وما للخصي وما للقاء % وكيف تلاقي الرجال الحرم % 39(@)(@@) % وأنت قتلت أعز الفحول % فماذا يظن أذل الخدم % 40(@)(@@) % ولا واعتزامك لا روعت % بتلك البهائم هذي البهم % PageV01P381 41(@)(@@) % أأنصار ملة خير الورى % % أترضون للحق أن يهتضم % 42(@)(@@) % ألا فاقتضوا دين دين الهدى % % لينجز ربكم وعدكم % 43(@)(@@) % فهذي الطريق إلى جنة ال % خلود فمن حاد عنها ندم % 44(@)(@@) % وقد آن للحق أن يسترد % كما آن للداء أن ينحسم % 45(@)(@@) % فأبلوا أمام إمام الهدى % % بلاء يؤمل من مثلكم % 46(@)(@@) % لتأتوا إلهكم في المعاد % بأعمالكم دون أنسابكم % 47(@)(@@) % وجودوا بأنفسكم إنما % % يصان الوشيج لكي ينحطم % 48(@)(@@) % وكيف يخاف الردى 
ms130	 معشر % إذا عطب المرء منهم سلم % 49(@)(@@) % فلا بد من قودها شزبا % طوال أعنتها والحزم % 50(@)(@@) % % تجاذب أسد اللقاء اللجم % PageV01P382 51(@)(@@) % فكل طريد بها مدرك % % 52(@)(@@) % كأني بها من وراء الخليج % أمام المظفر تهوي زيم % 53(@)(@@) % وقد قابل البحر سيف الإمام % ببحر ردى موجه مرتطم % 54(@)(@@) % وقد غص بالجيش ذاك الفضا % % فضاق على الخائف المنهزم % 55(@)(@@) % فما وهدة ما بها صعدة % ولا علم ما عليه علم % 56(@)(@@) % سيعطيك ملكهم ملكه % وعن ذلة ذاك لا عن كرم % 57(@)(@@) % جرى لك في اللوح ألا عزيز % يعز عليك وجف القلم % 58(@)(@@) % وقد حكمتك شفار السيوف % على كل ذي عزة فاحتكم % 59(@)(@@) % أبيت فنارك لايصطلى % % لظاها وجارك لا يهتضم % 60(@)(@@) % وقمت بفرض جهاد العدو % فأغنى قيامك من لم يقم % PageV01P383 61(@)(@@) % فلا تحسب الروم أن قد رقدت % فمذ نبهتك العلى لم تنم % 62(@)(@@) % عزائم تمضي مضاء الظبى % % وتربي على كل نجم نجم % 63(@)(@@) % فمنها فوادح تجلي العدى % % ومنها مصابح تجلو الظلم % 64(@)(@@) % فأي ولي بها ما اهتدى % % وأي عدو بها ما رجم % 65(@)(@@) % أنخت لديك مطايا المنى % % وهل يتعدى زهير هرم % 66(@)(@@) % فأمنتني بالعلو الغلو % وأعدمتني بالنوال العدم % 67(@)(@@) % ولو كان ذا العيد ذا ناظر % لأعشته أنوار هذي الشيم % 68(@)(@@) % فدمت تودعه ما مضى % % وتلقاه مستقبلا ما قدم % 69(@)(@@) % فلسنا نراع لظلم الخطوب % وعدلك عاد على من ظلم % 70(@)(@@) % إذا ما ألم بنا ما يهول % فأنت المليء بدفع الملم % PageV01P384 71(@)(@@) % فأمننا الله فيك المخوف % وألهمنا شكر هذي النعم % PageV01P385 البحر : طويل 1(@)(@@) % لك السعي ما ينفك يخدمه السعد % وذا العز ما أمطاكه الجد والجد % 2(@)(@@) % بهمتك الطولى بلغت إلى المنى % % وذو الهمة القصرى يروح كما يغدو % % 3(@)(@@) % لقد أظهرت مذ غبت عنها كآبة % دمشق كأن لم يخل من صارم غمد % 4(@)(@@) % مضيت كما تمضي الصوارم في الطلى % % وعدت كما عادت إلى الأجم الأسد % 5(@)(@@) % وشحط النوى أبدى سرائر أهلها % % وقد يعرف الشيء الخفي بما يبدو % % 6(@)(@@) % لئن منعوا بالهم في بعدك الكرى % % لقد منع الأيام قربك 
ms131	 أن تعدو % % 7(@)(@@) % وما إن رأوا شمسا لها الشام مطلع % سواك ولا غيثا تخب به الجرد % 8(@)(@@) % سحاب حياه الجود والبشر برقه % ووقع العتاق المقربات له رعد % 9(@)(@@) % أحاطوا بها رجلى لأن غبارها % % تداوى به من دائها الأعين الرمد % 10(@)(@@) % ولست موفى بعض ما تستحقه % إذا لم ينب عن كل رجل مشت خد % PageV01P386 11(@)(@@) % حضرت فوجه الدهر أبلج ناضر % وإن غبت حينا فهو أكلف مربد % 12(@)(@@) % فلا تتحدوه بذم فإن تكن % إساءته سهوا فإحسانه عمد % 13(@)(@@) % وإن ألذ القرب ما قبله نوى % وأحلى الوصال ما تقدمه صد % 14(@)(@@) % ظعنت فلم تظعن رعايتك التي % % حمتهم فما ريعوا وأوجدت فلم يكدوا % % 15(@)(@@) % فلو لم تكن رؤياك شيئا محببا % إلى كل عين لاستوى القرب والبعد % 16(@)(@@) % وهل حلب إلا السهى منذ أصبحت % لأروع أيام الزمان له جند % 17(@)(@@) % لذي البيض لم تجف الطلى شفراتها % % وجرد المذاكي ما يجف لها لبد % 18(@)(@@) % إذا قصدت أرض العدو فسيرها % % لعمرك تقريب وتقريبها شد % 19(@)(@@) % ولما دعت منك العواصم غوثها % % أجبت بلادا قد تمادى بها الجهد % 20(@)(@@) % فأسهرت أجفانا تطاول نومها % % لترقد أخرى ما لها بالكرى عهد % PageV01P387 21(@)(@@) % نهضت وقد مادت حذارا بأهلها % % وعاودت عنها وهي من أمنها مهد % 22(@)(@@) % فلا طرف ذي فتك إلى الفتك يعتلي % % و لا يد ذي جور إلى الجور تمتد % 23(@)(@@) % ولما طغى نصر أتحت له الردى % % فلم يحمه الجمع الصريح ولا الحشد % 24(@)(@@) % أبت أن يحيد الحق عن مستقره % خصوم من الملد التي أشرعت لد % 25(@)(@@) % فخلوا لأطراف القنا عن ممالك % بها أخذوها عنوة وبها ردوا % % 26(@)(@@) % أباحك ملك العرب ماضي سلاحها % % سيصفيك ملك الهند ما طبع الهند % 27(@)(@@) % فكم خضت أهوالا نتيجتها على % ولاقيت أوصابا جنى صابها شهد % 28(@)(@@) % تفرد بملك الأرض واسلم لأهلها % % فإنك فيهم والألى قبلهم فرد % 29(@)(@@) % ولا تخل قلبا في الورى من مخافة % فلولا حياة الخوف لم يمت الحقد % 30(@)(@@) % فلو لم يكن بأس المهلب كاسبا % له العز ما أعطته طاعتها الأزد % PageV01P388 31(@)(@@) % تكفل هذا العزم 
ms132	 أنك ظافر % بما لم تحدثك الظنون به بعد % 32(@)(@@) % أماني قد أخلت لها طرق الظبى % % ولا صدر يحمى عليه ولا ورد % 33(@)(@@) % لسائر ما يأتي به الدهر غاية % وما لمعاليك انتهاء ولا حد % 34(@)(@@) % إذا سلب الأعداء شيئا رددته % وإن سلبتهم ذي السيوف فلا رد % 35(@)(@@) % قواطع مذ أذكت بمذكين نارها % % فبين ضلوع الروم نار لها وقد % 36(@)(@@) % ومنذ دنت دار المبير مبيرهم % فأمنهم جزر وخوفهم مد % 37(@)(@@) % يقول لهم في كل يوم مليكهم % كذا فاحمدوا رأيي لما أكد العقد % 38(@)(@@) % لعمري لقد غروا بإبعاد عصبة % نحت غيها من بعدما وضح الرشد % 39(@)(@@) % وليست لهذا الملك أولى طريدة % غدا حظها ممن بغت نصرها الطرد % 40(@)(@@) % فلا تحسبوا ماء الفرات كعهدهم % فقد حال دون الورد ذا الأسد الورد % PageV01P389 41(@)(@@) % لقد ضاق ذو القرنين ذرعا بسده % فقال أعينوني فقد نفد الجهد % 42(@)(@@) % وأنت الذي لم يستعن غير عزمه % وكم دون ما قد بت تلكلؤه سد % 43(@)(@@) % بإقدامك الإسلام بالعز مرتد % وجاحد ما أوليته عنه مرتد % 44(@)(@@) % وقيت برغم الحاسدين فما زكا % % لقائلهم قول ولا كان ما ودوا % % 45(@)(@@) % فلاكهم السيف الذي الحق ضارب % به من طغى بغيا ولا خور العضد % 46(@)(@@) % فهم بين ميت ظل يلفظه الثرى % % وحي له من بيته أبدا لحد % 47(@)(@@) % وإن رجالا فيك شكت قلوبهم % أولئك قوم عن سبيل الهدى صدوا % % 48(@)(@@) % ولست عن النصح الصريح مدافعا % إذا وضح الإحسان لم يمكن الجحد % 49(@)(@@) % كفيت بذا السيف الأئمة ما عرا % % فمن كل شيء ما عداك لهم بد % 50(@)(@@) % فلا غرو أن شدوا عليك أكفهم % بذلك وصى ابنا أب وأبا جد % PageV01P390 51(@)(@@) % ومذ شاع في مصر وصولك سالما % ففيها لمن يحتلها عيشة رغد % 52(@)(@@) % وقد لبست أبهى الكسى وتعطرت % بما حملت من طيب أخبارك البرد % 53(@)(@@) % بك انذعرت ربد الحوادث رهبة % كما أنذعرت من خيفة القانص الربد % 54(@)(@@) % وحيث ثوى هذا الهمام فقصره % بأرجائه من كل مملكة وفد % 55(@)(@@) % تروم لديه الجود إن أخلف الحيا % % وتجديد عهد السلم إن 
ms133	 أخلق العهد % 56(@)(@@) % وعدت الهدى عزا بإبعادك العدى % % فلما زكا فيها الوعيد زكا الوعد % 57(@)(@@) % وجمعت باإحسان شتى قبائل % فناب عن القربى التوازر والود % 58(@)(@@) % ولو لم تزل بالمنع غل صدورهم % وبالبذل لم يركن إلى ضده الضد % 59(@)(@@) % صنائع قد عمت نزارا ويعربا % فكلهم أسراك والنعم القد % 60(@)(@@) % سأثني بنعماك التي ملأت يدي % % وإن فات حد العد نائلك العد % PageV01P391 61(@)(@@) % رميت بسهم العي إن ظلت كاتما % مواهب لي منها الطوارف والتلد % 62(@)(@@) % سقتني بكاسات المنى كل نخبة % فها أنا بالأشعار من طرب أشدو % % 63(@)(@@) % عزيز القوافي لي ذليل وصعبها % % ذلول وحر القول ما رمته عبد % 64(@)(@@) % أمير الجيوش اسمع لها فبمثلها % % تزيد العلى طولا ويفتخر المجد % 65(@)(@@) % وما أنشدت إلا انبرى كل عالم % يقول لهذا الجيد يصلح ذا العقد % 66(@)(@@) % تجل إذا ما جلة القوم أنصتوا % % وتلغى إذا أنضى لي النقد والنقد % 67(@)(@@) % أذا العرف ما شرواه منهمر الحيا % % وذا العرف نا الند الذكي له ند % 68(@)(@@) % شهرت بإرغام الخطوب وكبتها % % فما لك إلا حفظ ما ضيعت وكد % 69(@)(@@) % ومنه الندى يعتاد في كل لحظة % وغيرك بالأدنى من الجود يعتد % 70(@)(@@) % فضائل يطوى الدهر من قبل طيها % % وتنعد أنفاس الورى قبل تنعد % PageV01P392 71(@)(@@) % كبا كل من يبغي مداك فلا كبا % % لذا الملك في أمر تحاوله زند % 72(@)(@@) % لتحتاز آفاق الدنى دون أهلها % % كما لك فيها دونهم وحدك الحمد % PageV01P393 البحر : كامل تام 1(@)(@@) % أما وسيفك في النفوس محكم % فالعز أجمعه إليك مسلم % 2(@)(@@) % من لا يطيعك والمقادير التي % % ترضي وتجدي بعض ما يستخدم % 3(@)(@@) % فلكل قلب من سطاك مروع % وبكل وجه من جميلك ميسم % 4(@)(@@) % عودت فصل الأمر أشكل ناطقا % أو ساكتا فالسيف عنك مترجم % 5(@)(@@) % وخصصت بالإبداع في فعلاتك ال % % حسنى ليظهر عجز من يتهمم % 6(@)(@@) % ومتى يجيء بمثلها من نفسه % من ظل يبصرها فلا يتعلم % 7(@)(@@) % لو لم يعز بنو أبيك ويكرموا % % طالوا الورى شرفا بأنك منهم % 8(@)(@@) % أبشر بسبقك من تقدم موقنا % أن الفضائل لا العصور تقدم % 9 
ms134	(@)(@@) % كنا نظنك تابعا آثارهم % فأبنت بالإعجاز أنك ملهم % 10(@)(@@) % ولقد سمعت كما سمعنا عنهم % وعلمت بالإحسان ما لم يعلموا % % PageV01P394 11(@)(@@) % أفهل ظفرت بمن جرى في ذا المدى % % مذ قام بالإحسان فيهم قيم % 12(@)(@@) % قلب الهدى بك لن يراع وقهره % لن يستطاع وعقده لا يفصم % 13(@)(@@) % لله بذلك حين لا مستمنح % يرجى ومنعك حين لا مستعصم % 14(@)(@@) % لن يكشف الحق الجلي لثامه % إلا ووجهك بالعجاج ملثم % 15(@)(@@) % وإذا عزمت على اجتياح قبيلة % كثر اليتيم بحيها والأيم % 16(@)(@@) % يخشى عواديك الهزبر بغيله % ويخافها تحت التراب الأرقم % 17(@)(@@) % وتصيب شاكلة الرمي مفوقا % وتطيش عنك إذا رميت الأسهم % 18(@)(@@) % إن المظفر من أبت فتكاته % أن تخرج الأيام عما يرسم % 19(@)(@@) % في كل يوم ناطق بلسانهم % من خوفهم فلذاك ما يستعجم % 20(@)(@@) % وإذا امتطى سيف الخلافة عزمه % فلدولة تبنى وأخرى تهدم % PageV01P395 21(@)(@@) % وإذا نظرت إلى عواقب رأيه % أيقنت أن ظنونه تتنجم % 22(@)(@@) % فاسأله عما لم يكن بكناية % فالغيب من أفكاره يستعلم % 23(@)(@@) % ولذاك حقق ظنه فيما أتى % % وظنون أهل الخافقين توهم % 24(@)(@@) % رقاك عزمك مخطرا لا يرتقى % % فعلمت من ذا المجد ما لا يعلم % 25(@)(@@) % وإذا علا باغي الغنيمة همة % وأطاعه المقدار جل المغنم % 26(@)(@@) % شرف المعالي فزت بالشرف الذي % % قد بات يحسده السهى والمرزم % 27(@)(@@) % وقتلت من لو غيرك المجتاحه % لأبت نزار أن يطل له دم % 28(@)(@@) % وجنيت أثمار العوالي واجتنى % % ومن الجنا أري ومنه علقم % 29(@)(@@) % وإذا الوغى عبست وطال عبوسها % % عند النزال فعن فتوحك تبسم % 30(@)(@@) % ظفر جميع الطيب أضحى كاسدا % مذ أصبحت أخباره تتنسم % PageV01P396 31(@)(@@) % ولقد تحققت العواصم أنها % % بسواك يا سيف الهدى ما تعصم % 32(@)(@@) % غرض النوائب لم تزل فمنعتها % % قسرا كما منع العرين الضيغم % 33(@)(@@) % ما زرتها إلا ليأمن خائف % ويغاث ملهوف ويثري معدم % 34(@)(@@) % فلتعتصم بك ذي الثغور وأهلها % % مما تخاف فطود عزك أيهم % 35(@)(@@) % ولقد عممت المذنبين صنائعا % حتى لظنوا أنهم لن يحرموا % % 36(@)(@@) % فدع الألى مرقوا فإن بعادهم % عن ذا الجناب لهم عقاب مؤلم % 37(@)(@@) % أولاد 
ms135	 مرداس لسيفك طعمة % في كل أرض أنجدوا أو أتهموا % % 38(@)(@@) % ولو أنهم عقلوا لديك ظنونهم % لرأوا بك الرشد الذي عنه عموا % % 39(@)(@@) % ومن السفاهة أن تضل حلومهم % من بعد ما وضح الطريق الأقوم % 40(@)(@@) % قد عاينوا عين الردى لما رأوا % % في تل خالد القنا يتحطم % PageV01P397 41(@)(@@) % لما أبان خليفة عن رشده % فعل امرئ تزكو لديه الأنعم % 42(@)(@@) % في فتية جعلوا رضاك سلاحهم % فلذاك أحجم من لقوه وأقدموا % % 43(@)(@@) % نصر القليل على الكثير فما انجلت % عنهم وفي أرماح حزبك لهذم % 44(@)(@@) % غارت هنالك في النواظر والطلى % % عند الطعان كما تغور الأنجم % 45(@)(@@) % فإذا بعثت إلى العدو طليعة % أغنت غناء الجيش وهو عرمرم % 46(@)(@@) % بظبى إذا خرس الكماة بموقف % فلها كلام في الجماجم يفهم % 47(@)(@@) % وبها نحت جسر الحديد عصائب % كانت على باب الحديد تخيم % 48(@)(@@) % والروم بين مؤرق سلب الكرى % % أو نائم بهجوم جيشك يحلم % 49(@)(@@) % يتجلدون ضرورة مع علمهم % لما دنوت بأي داهية رموا % % 50(@)(@@) % متمسكين بهدنة ما تنقضي % % إلا وأنت على الخليج مخيم % PageV01P398 51(@)(@@) % ومتى ركزت بدار مسلمة القنا % % زرق الأسنة سلموا أو أسلموا % % 52(@)(@@) % فليستكن ملك تفل جميعه % بعصابة مما فللت وتهزم % 53(@)(@@) % هيهات تجحدك الملوك سفاهة % ما قد تعالمه السواد الأعظم % 54(@)(@@) % ردء الخلافة من مضائك عاصم % ورداؤها بجميل صنعك معلم % 55(@)(@@) % مجد تخرمت العمالق دونه % وتمزقت عاد وبادت جرهم % 56(@)(@@) % في كل يوم بلدة تحتاز من % أرض العدو وقلعة تتسلم % 57(@)(@@) % وكذا إلى أن تملك الدنيا بما % % جمعت ويسعدك البقاء الأدوم % 58(@)(@@) % فاندب لمملكة العراق ضراغما % علمتهم فرس العدى فتعلموا % % 59(@)(@@) % من كل من لسراه ظهر مطية % ولطعنه ثغر العداة مطهم % 60(@)(@@) % جناب ما ولد الوجيه ولاحق % ركاب ما ولد الجديل وشدقم % PageV01P399 61(@)(@@) % كيما ترى عضدية تركية % قد طالما استولت عليها الديلم % 62(@)(@@) % قد آن أن تروى بقربك أنفس % ظمئت وأن تحيا بعدلك أعظم % 63(@)(@@) % لن يدفع الإصباح عن إشراقه % من بعد مطلعه الهزيع المظلم % 64(@)(@@) % رم أي مملكة أردت فإنما % % حلب إلى كل الممالك سلم 
ms136	 % 65(@)(@@) % وبصدرك القلب الذي لما يرع % وبكفك العضب الذي لا يكهم % 66(@)(@@) % وارجع رجوع الليث وهو مظفر % والسيف يقطر من غراريه الدم % 67(@)(@@) % متجلبب النصر لذي عودته % إذ كان خلفك حيثما تتيمم % 68(@)(@@) % فدمشق مثل الغاب غاب هزبره % والجفن فارقه الحسام المخذم % 69(@)(@@) % وبأهلها عطش إليك وكلهم % كالنبت نكبه السحاب المرزم % 70(@)(@@) % وسيقدم العز الأشم عليهم % والعارض السحاح ساعة تقدم % PageV01P400 71(@)(@@) % شعبان شعب يومهم فليرقبوا % % إن المحرم للسهاد محرم % 72(@)(@@) % عام حلولك فيهم بحلوله % عام يبجل عندهم ويعظم % 73(@)(@@) % يا غامر المتظلمين بعدله % حتام مالك في اللهى يتظلم % 74(@)(@@) % أنت الذي لو لم تطع حكم الندى % % ما كان مخلوق عليه يحكم % 75(@)(@@) % يغنى الذي تحبوه أول مرة % وسواك ينقص نيله فيتمم % 76(@)(@@) % فالجود إلا من يدك مصرد % والظن إلا في نداك مرجم % 77(@)(@@) % قل للعفاة مضى عن البحر القذى % % فردوا مشارعه ولا تتلوموا % % 78(@)(@@) % إن المكارم أفرقت من دائها % % مذ أفرق الملك الأجل الأعظم % 79(@)(@@) % فلتبرد الآن القلوب فإنها % % كانت بنيران الأسى تتضرم % 80(@)(@@) % لا عادك الألم الملم فلم يزل % قلب العلاء لأجلهش يتألم % PageV01P401 81(@)(@@) % والعيد يقصر عن سلامتك التي % % هي في النفوس أجل منه وأعظم % 82(@)(@@) % فاسعد بها وبه ودمت مسلما % ما طاف بالبيت المحرم محرم % 83(@)(@@) % فلكثرة الدعوات في أرجائه % قد كاد يفهمها الحطيم وزمزم % 84(@)(@@) % كل الورى داع وجل دعائهم % ألا يزيل الله ظلك عنهم % 85(@)(@@) % أغنى نوالك بعضهم عن بعضهم % كي لا يرى في الأرض غيرك منعم % 86(@)(@@) % فلذاك ألسنهم لسان واحد % يثني بما خولت والدنيا فم % 87(@)(@@) % زاد الثناء بمأثراتك بهجة % ولربما زان السوار المعصم % 88(@)(@@) % وأطاعني فيك الكلام وهل درت % هذي العقود لأي شيء تنظم % 89(@)(@@) % ولقد تعمدت الإطالة عالما % أن استماع ثناك مالا يسأم % PageV01P402 البحر : وافر تام 1(@)(@@) % ليهنك ما أنالتك الجدود % وأن الدهر يفعل ما تريد % 2(@)(@@) % مرام شط مرمى العزم فيه % فدون مداه بيد لا تبيد % 3(@)(@@) % وأمر قمت فيه بلا ظهير % وأهل الأرض من فشل قعود % 4(@)(@@) % ومثلك لا يضل 
ms137	 الحزم عنه % فهل أنباك بالصدر الورود % 5(@)(@@) % أبيت فلم تنم نوم ابن هند % على حنق فنبهه وليد % 6(@)(@@) % وأعفيت المسامع من حديث % يعن فتقشعر له الجلود % 7(@)(@@) % نبا ضاقت بنسوان خدور % له ونبت بأطفال مهود % 8(@)(@@) % فكذب ظن من عاداك صدق % تساوى فيه وعدك والوعيد % 9(@)(@@) % وعيد غادر المراق صرعى % % وعيد ما أتى مأتاه عيد % 10(@)(@@) % فلولا كونه مع يوم بدر % لقلنا إنه اليوم الوحيد % PageV01P403 11(@)(@@) % مقام آزرت أسدا نمير % لديه وظافرت كلبا عتود % 12(@)(@@) % وأي حمى أباحوا يوم باحوا % % بما كتمته في السلم العمود % 13(@)(@@) % لقد طاح الرجاء بطغلبك % وكم أمل إلى أجل يقود % 14(@)(@@) % كأشدق عبد شمس إذ تبغى % % تراثا لم يخلفه سعيد % 15(@)(@@) % وجاور أهل تلك الأرض منه % مريد لاجتياحهم مريد % 16(@)(@@) % عجبت لمدعي الآفاق ملكا % وغايته ببغداد الركود % 17(@)(@@) % يصول على رعاياها اعتداء % ويحجم كلما صل الحديد % 18(@)(@@) % ومن مستخلف بالهون راض % يذاد عن الحياض ولا يذود % 19(@)(@@) % له حرم هنالك لم يحرم % به إلا السلامة والهجود % 20(@)(@@) % تلاه خوفه بأشد منه % ولولا الجدب ما أكل الهبيد % PageV01P404 21(@)(@@) % ودبره ابن مسلمة سفاها % % برأي ما اشار به رشيد % 22(@)(@@) % وضاعف ضعفه فرط التوقي % وأيد أيدك البطش الشديد % 23(@)(@@) % وما لبطش لشديد مفيد عز % إذا لم يمضه لرأي لسديد % 24(@)(@@) % وأعجب منهما سيف بمصر % تقام به بسنجار الحدود % 25(@)(@@) % على من وارت الديران منهم % جسوم ليس يقبلها الصعيد % 26(@)(@@) % أزيلوا عن مواقفهم بضرب % تزول به الضغائن والحقود % 27(@)(@@) % فكم غلل شفاها حر ضرب % وقد أعيا بها الماء البرود % 28(@)(@@) % لقد لاقوا بنصرتهم قريشا % كما لاقت بأشقاها ثمود % 29(@)(@@) % عليه أن مبدئه معيد % ولم تغن المواثق والعهود % 30(@)(@@) % ولا العز الطريف حماه مما % % أردت به ولا العز التليد % PageV01P405 31(@)(@@) % فولى يحمد الجرد المذاكي % % وليس لسيفه أثر حميد % 32(@)(@@) % وغر الغر أن الدين واه % هناك وأن ناصره بعيد % 33(@)(@@) % ففاتهم بعزمك ما أرادوا % % وآل بهم إلى ما لم يريدوا % % 34(@)(@@) % ولم تزل الأماني وهي بيض % تكذبها المنايا وهي سود % 35 
ms138	(@)(@@) % فمن جيش يعد العود فتحا % ومن جيش يمر فلا يعود % 36(@)(@@) % وما إقدام قطرمش معاد % ولا عمر له عمر جديد % 37(@)(@@) % جناحا جارح غرثان هيضا % % فأصبح لا يطير ولا يصيد % 38(@)(@@) % وطود أذى وهت بسطاك منه % قواعد جمة ووهت ريود % 39(@)(@@) % سطى سمع الملوك بها فظلت % أسرتهم بها خوفا تميد % 40(@)(@@) % وشاع حديثها ف رتاع منها % % عميد واستقام بها عنيد % PageV01P406 41(@)(@@) % رميتهم بكل سليل غاب % يعيش بفرسه ضبع وسيد % 42(@)(@@) % يروق فؤاده نأي وعود % يغذ السير لا ناي وعود % 43(@)(@@) % ويعجبه النهود إلى الأعادي % % مشيحا لا القدود ولا النهود % 45(@)(@@) % ولو أن النعام بك أستجارت % لخافت من عواديها الأسود % 46(@)(@@) % فكيف ومستجيرك أحوذي % تحداه الحتوف فلا يحيد % 47(@)(@@) % تفرد وهو مجتنب مخوف % كما يتجنب الحي الحريد % 48(@)(@@) % وفاض عليه بالإحسان حتى % % تخلصه من العدم الوجود % 49(@)(@@) % كريم من عطاياه المعالي % % عظيم من تحاياه السجود % 50(@)(@@) % مؤمله يفيد غنى وعزا % وشانيه بغصته يفيد % 51(@)(@@) % غمام فيه من بشر بروق % ولم يصحبه من من رعود % PageV01P407 52(@)(@@) % ملث ما يبالي حيث يهمي % % أتيح له شكور أم كنود % 53(@)(@@) % وأعطى ما وهبت بلا اكتراث % عليه أن مبدئه نعيد % 54(@)(@@) % وكل ندى إلى جدواك يعزى % % كما تعزى إلى الغيث المدود % 55(@)(@@) % عممت القوم من عجم وعرب % مواهب ما خلا منهن جيد % 56(@)(@@) % لهى كادت عدوهم وكادت % تضيق بها التهائم والنجود % 57(@)(@@) % تخالفت الرفاق بها إليهم % كما اختلفت على التجر النقود % 58(@)(@@) % ورب مغانم أدت إليها % % مغارم حمل أدناها يؤد % 59(@)(@@) % وأرسلت العتاق الجرد قبا % يعارض ممتطى منها مقود % 60(@)(@@) % ومن أدد وعدنان عليها % % جنود لا تلاقيها جنود % 61(@)(@@) % من الأسر التي ألوت بكسرى % % وذاك ومن سلاحهم الجريد % PageV01P408 62(@)(@@) % مرت خلف التلاف بكل مرت % تنوب عن السروج به القتود % 63(@)(@@) % ونكبت الجبال بهم جبال % ضوامر لا تجف لها لبود % 64(@)(@@) % إذا قدحت فما يدجر ظلام % وإن ضبحت فما ينجو طريد % 65(@)(@@) % أبت وطء الثرى تيها فصارت % مواطئها النواظر والخدود % 66(@)(@@) % وحل الموصل المنصور يثني % % بسطوته ونخوته 
ms139	 الوفود % 67(@)(@@) % وقد شهدت منابرها بحق % ملائكة السماء به شهود % 68(@)(@@) % وسوف تضاف بغداد إليها % % كما أنضافت إلى عدن زبيد % 69(@)(@@) % فقد ضعفت زنود عن قسي % رمت عنها العدى وكبت زنود % 70(@)(@@) % وللنار التي شبت فخيفت % خمود سوف يتبعه همود % 71(@)(@@) % لك الفتح المبين بكل وجه % قصدت وللعدى الحتف المبيد % PageV01P409 72(@)(@@) % لقد سدت الملوك بمأثرات % بها الوزراء أيسر من تسود % 73(@)(@@) % سددت من الهدى مالم يسدوا % % وشدت من العلى ما لم يشيدوا % % 74(@)(@@) % بناؤك كله أجر وشكر % وما يبنون آجر وشيد % 75(@)(@@) % جميل تسترق به الأماني % % وعدل يستحق به الخلود % 76(@)(@@) % حللت من الخلافة في مكان % به عدم المباشر والحسود % 77(@)(@@) % ولم يحلم بشرواك التمني % % ولا جاد الزمان ولا يجود % 78(@)(@@) % بقيت ومشبهاك تقى وحلم % وظلكم على الدنيا مديد % 79(@)(@@) % ولا زالت بأفق الملك منكم % نجوم لاتعداها السعود % 80(@)(@@) % ولا برحت كذا الأعياد تأتي % % وجدك قاهر فيها سعيد % 81(@)(@@) % وما أبقى فعالك لي مقالا % ولكن ارتياحك يستعيد % PageV01P410 82(@)(@@) % مدائح طالما أبدعت فيها % % وأين وقوعها مما أريد % 83(@)(@@) % إذا تليت على الحساد قالوا % % كذا فلينظم الدر الفريد % 84(@)(@@) % ولا إحسان إلا في مجيد % علا همما ومادحه مجيد % 85(@)(@@) % ولن نخشى على فخر شرودا % إذا عقلته قافية شرود % 86(@)(@@) % فسير بي حديث المجد إني % % لما أثلت من شرف مشيد % 87(@)(@@) % فدم علما له ما اخضل ترب % توالى سقيه واخضر عود % PageV01P411 البحر : طويل 1(@)(@@) % أرى الشرف الأعلى إليك مسلما % % فلا مجد إلا ما إلى مجدك انتما % % 2(@)(@@) % وما نال هذا الفضل ماض من الورى % % وإن ناله آت فمنك تعلما % % 3(@)(@@) % وهذا مجال قد ركبت طريقه % بكل الورى عنها وإن أبصروا عما % % 4(@)(@@) % ومن أدرك العلياء والعجز خلقه % وقال كفاني الحظ أن أتهمما % % 5(@)(@@) % فما نلتها إلا عن الحوب معرضا % وفي الجدب فياضا وفي الحرب مقدما % % 6(@)(@@) % عفاف وإنصاف أنالا جلالة % وجود وإقدام أفادا تقدما % % 7(@)(@@) % إذا ما ملوك الأرض تيها تعظموا % % كفاك عظيم القدر أن تتعظما % % 8(@)(@@) % لقد قصروا أن يبرموا ما نقضته 
ms140	 % كتقصيرهم عن نقض ماظلت مبرما % % 9(@)(@@) % لهذا العلى ملك بغير مشارك % لأكرم من أعطى وأشرف من سما % % 10(@)(@@) % لأبدعهم فضلا وأقطعهم ظبى % وأبرعهم فعلا وأمنعهم حما % % PageV01P412 11(@)(@@) % وأوسعهم صدرا وأسرعهم ندى % وأمرعهم أرضا وأرفعهم سما % % 12(@)(@@) % ومن قدمته نفسه وإباؤه % وهمته على الأنام تقدما % % 13(@)(@@) % كفى الدولة المستنصرية عضدها % % نوائب لو قارعن رضوى تهدما % % 14(@)(@@) % وقد قلدته الأمر في الدين والدنا % % وكان أمينا بالمغيب عليهما % % 15(@)(@@) % فلا يرهب الناس الخطوب وريبها % % فمنذ رأى إقدامك الدهر أحجما % % 16(@)(@@) % ولا يطلبوا إلا بقاءك عصمة % فهم في أمان ما بقيت مسلما % % 17(@)(@@) % تريد العدى إطفاء نارك خيبوا % % ظنونا وما تزداد إلا تضرما % % 18(@)(@@) % وعجزهم عن أن تراع بحدهم % كعجز الصبا عن أن تهز يلملما % % 19(@)(@@) % ولم تدن عين الشمس من كف لامس % فتقذى ولا لان الحديد فيعجما % % 20(@)(@@) % وما زال حسم الظلم واللم للهدى % % هواك الذي يضنيك لا الظلم واللما % % PageV01P413 21(@)(@@) % ولما تعدى الروم جهلا بعثتها % % كتائب يحملن الوشيج المقوما % % 22(@)(@@) % قنا جدل الفرسان قبل انحطامه % ونابت سيوف الهند لما تحطما % % 23(@)(@@) % وإنك من يمضي الكهام بكفه % فكيف إذا جردت أبيض مخذما % % 24(@)(@@) % وتردي برمح لم يركب سنانه % فكيف إذا أشرعته متلهذما % % 25(@)(@@) % وتحكم بالإيعاد في مهج العدى % % فكيف إذا جهزت جيشا عرمرما % % 26(@)(@@) % فغرقهم بحر الردى وهو ساكن % فماذا يظنون الشقيون إن طما % % 27(@)(@@) % ولو لم يذد عنهم طغان وجيشه % لكان على شاطي الخليج مخيما % % 28(@)(@@) % وقد علموا من راش بالعز سهمه % ومن طاش إذ دارت رحى الحرب منهما % % 29(@)(@@) % أظنهم لم يفهموا ما أمرتهم % به فجعلت السيف عنك مترجما % % 30(@)(@@) % حسام همام ظل بالحق ناطقا % فما صل في الهامات إلا وأفهما % % PageV01P414 31(@)(@@) % وعندهم صبر على الضيم والأذى % % يرجون أن يضحى إلى السلم سلما % % 32(@)(@@) % وقد طالما استنفذت بالأمن خائفا % وبالجود معداما وبالعفو مجرما % % 33(@)(@@) % وإن كنت تسطو عزة وحفيظة % فإنك تعفو رحمة وتكرما % % 34(@)(@@) % فدعهم إلى وقت فلو لم يمتهم % يقين الردى الآتي لماتوا توهما % % 35(@)(@@) % وقد أصبحوا في غمة ما 