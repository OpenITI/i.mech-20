ms1161	 يروي عن أبي قلابة روى عنه جرير بن عبد الحميد(@)(@@)(@@)(@@) $ 9771 - عمرو بن عمر بن عبد الأحموسي من أهل الشام ثبت إذا كان فوقه ودونه ثقة يروي عن جماعة من التابعين روى عنه أهل الشام(@)(@@)(@@)(@@) $ 9772 - عمرو بن خالد بن عرفطة يروي عن أبيه روى عنه كلاب بن عمرو ابنه(@)(@@)(@@)(@@) $ 9773 - عمرو بن يزيد أبو بردة يروي عن عطاء روى عنه عبيد الله بن موسى(@)(@@)(@@)(@@) $ 9774 - عمرو بن أبي سفيان الجمحي القرشي من أهل مكة أخو حنظلة بن أبي سفيان يروي عن أهل الحجاز روى عنه الثوري وابن المبارك(@)(@@)(@@)(@@) $ 9775 - عمرو بن قيس الملائي من أهل الكوفة كنيته أبو عبد الله يروي عن المنهال بن عمرو وعكرمة روى عنه أبو خالد الأحمر PageV07P221 والكوفيون سمعت بن خزيمة يقول سمعت عمر بن حفص الشيباني يقول سمعت عبد الرحمن بن مهدي يقول نظر الثوري إلى حماد بن سلمة فقال يا أبا سلمة أشبهك بشيخ صالح قال ومن هو قال عمرو بن قيس الملائي قال أبو حاتم كان عمرو بن قيس الملائي من ثقات أهل الكوفة ومتقنيهم وعباد أهل بلده وقرائهم وليس هذا بعمرو بن قيس بن يسير بن عمرو ذاك شيخ آخر كوفي صدوق أكثر روايته عن أبيه(@)(@@)(@@)(@@) $ 9776 - عمرو بن سعيد يروي عن أبي زرعة بن عمرو بن جريج والشعبي روى عنه يونس بن عبيد(@)(@@)(@@)(@@) $ 9777 - عمرو بن مساور وقد قيل مسور يروي عن الشعبي روى عنه روح بن القاسم(@)(@@)(@@)(@@) $ 9778 - عمرو بن سعيد يروي عن سعيد بن جبير روى عنه داود بن أبي هند أحسبه الذي روى عنه يونس بن عبيد PageV07P222(@)(@@)(@@)(@@) $ 9779 - عمرو بن سعيد بن العاص بن سعيد بن العاص الأموي القرشي أخو عنبسة بن سعيد كنيته أبو أمية يروي عن أبيه عن عمر ومن زعم أن عبد الملك بن مروان قتله بيده فقد وهم الذي قتله عبد الملك بيده هو عمرو بن سعيد الأشدق(@)(@@)(@@)(@@) $ 9780 - عمرو بن عبد الله بن وهب أبو معاوية النخعي من أهل الكوفة يروي عن 
ms1162	 أبي عمرو الشيباني روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9781 - عمرو بن شور أبو شور الطائي يروي عن الشعبي روى عنه عثام بن علي(@)(@@)(@@)(@@) $ 9782 - عمرو بن البراء الجعفي يروي عن طلحة بن مصرف روى عنه المعلى بن هلال PageV07P223(@)(@@)(@@)(@@) $ 9783 - عمرو بن شراحيل العيشي أبو المغيرة الشامي يروي عن الشاميين وبلال بن سعد روى عنه صدقة بن خالد ومحمد بن شعيب بن شابور(@)(@@)(@@)(@@) $ 9784 - عمرو بن ميمون بن مهران الجزري مولى الأزد كنيته أبو عبد الله يروي عن أبيه وقد قيل كنيته أبو عبد الرحمن روى عنه الثوري وشريك مات سنة خمس وأربعين ومائة بحصن مسلمة وقد قيل سنة سبع وأربعين ومائة بالكوفة(@)(@@)(@@)(@@) $ 9785 - عمرو بن أيوب بن أبي زرعة بن عمرو بن جرير البجلي أخو يحيى بن أيوب وجرير بن أيوب يروى عن جده أبي زرعة بن عمرو قال كان أبو هريرة يقبض على لحيته ثم يأخذ ما تحت القبضة من لحيته PageV07P224 روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 9786 - عمرو بن عمران أبو السوداء النهدي يروي عن عبد الرحمن بن سابط روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 9787 - عمرو بن شرحبيل بن سعيد بن سعد بن عبادة الأنصاري الخزرجي يروي عن أبيه روى عنه عبد الله بن محمد بن عقيل بن أبي طالب(@)(@@)(@@)(@@) $ 9788 - عمرو بن عبد الرحمن الضبي يروي عن عمته ليلى بنت عفراء روى عنه عبيد الله بن هوذة(@)(@@)(@@)(@@) $ 9789 - عمرو بن عبد الله بن الأسوار اليماني يروي عن عكرمة روى عنه هشام بن يوسف ومعمر بن راشد(@)(@@)(@@)(@@) $ 9790 - عمرو بن عبد الله بن كعب السلمي الأنصاري يروي عن نافع بن جبير عداده في أهل المدينة روى عنه يزيد بن خصيفة PageV07P225(@)(@@)(@@)(@@) $ 9791 - أبو نعامة العدوى اسمه عمرو بن عيسى بن سويد بصري يروي عن أبي نضرة والبصريين روى عنه مكي بن إبراهيم والناس(@)(@@)(@@)(@@) $ 9792 - عمرو بن عبد الرحمن بن أمية الثقفي يروي عن أبيه عن يعلى بن أمية روى عنه الزهري(@)(@@)(@@)(@@) $ 9793 - عمرو بن عبد الملك بن حريث بن أخي عمرو بن 
ms1163	 حريث المخزومي القرشي يروي عن الكوفيين روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 9794 - عمرو بن أبي عبيد من أهل المدينة يروي عن الحجازيين روى عنه يحيى بن سعيد الأنصاري وابن أبي ذئب(@)(@@)(@@)(@@) $ 9795 - عمرو بن عثمان بن عبد الله بن موهب التيمي مولى آل طلحة يروي عن موسى بن طلحة روى عنه زائدة بن قدامة ومروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 9796 - أبو الزعراء اسمه عمرو بن عمرو بن مالك الجشمي وقد قيل عمرو بن عامر بن أخي أبي الأحوص من أهل الكوفة يروي عن أبي الأحوص وعكرمة روى عنه سفيان الثوري PageV07P226(@)(@@)(@@)(@@) $ 9797 - عمرو بن سعد يروي عن نافع عن بن عمر أن رسول الله صلى الله عليه وسلم أمر بالمسح في الدار يوما وليلة وفي السفر بثلاثة أيام ولياليهن حدثناه الحسن بن سفيان قال ثنا يحيى بن موسى خت قال ثنا عمر بن يونس اليمامي قال ثنا أيوب بن النجار عن سليمان بن أبي سليمان عن عمرو بن سعد(@)(@@)(@@)(@@) $ 9798 - عمرو بن عتبة بن فرقد السلمي من أهل الكوفة يروي عن الشعبي روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9799 - عمرو بن عتبة بن أبي لهب الهاشمي يروي عن الحجازيين روى عنه ابنه محمد بن عمرو PageV07P227(@)(@@)(@@)(@@) $ 9800 - عمرو بن اللجلاج السكسكي يروي عن عبد الرحمن بن فضالة عداده في أهل الشام روى عنه جرير بن عثمان(@)(@@)(@@)(@@) $ 9801 - عمرو بن مالك بن يخامر السكسكي من أهل الشام يروي عن أبيه روى عنه الشاميون(@)(@@)(@@)(@@) $ 9802 - عمرو بن مالك النكري كنيته أبو مالك من أهل البصرة يروي عن أبي الجوزاء روى عنه حماد بن زيد وجعفر بن سليمان وابنه يحيى بن عمرو ويعتبر حديثه من غير رواية ابنه عنه مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 9803 - عمرو الفقيمي من أهل الكوفة يروي عن سعيد بن جبير روى عنه ابناه الفضيل والحسن الكوفيان(@)(@@)(@@)(@@) $ 9804 - عمرو بن الحارث بن يعقوب مولى الأنصار كنيته أبو أمية عداده في أهل مصر وكان مؤدبا لصالح بن علي بالمدينة فأخرجه منها إلى مصر وأقام 
ms1164	 بها إلى أن مات يروي عن الزهري ويحيى بن سعيد الأنصاري روى عنه الليث بن سعد وعبد الله بن وهب مات PageV07P228 سنة ثمان أو تسع وأربعين ومائة وكان من الحفاظ المتقنين وأهل الورع في الدين(@)(@@)(@@)(@@) $ 9805 - عمرو بن أبي نعيمة المعافري من أهل مصر يروي عن أبي عثمان مسلم بن يسار روى عنه بكر بن عمرو(@)(@@)(@@)(@@) $ 9806 - عمرو بن خليفة أخو هوذة بن خليفة يروي عن محمد بن عمرو وسليمان التيمي روى عنه أبو قلابة الرقاشي وكان أسن من هوذة ومات قبله كنيته أبو عثمان ربما كان في بعض روايته بعض المناكير(@)(@@)(@@)(@@) $ 9807 - عمرو بن عبيد الله يروي عن سعيد بن عمرو عن أبي سعيد الخدري أن النبي صلى الله عليه وسلم قال لا يبغض الأنصار إلا منافق روى عنه سليمان بن هلال(@)(@@)(@@)(@@) $ 9808 - عمرو بن مسلم صاحب المقصورة مقصورة المدينة يروى عن PageV07P229 أبي حازم عن أنس بن مالك وسهل بن سعد روى عنه أبو معاوية الضرير(@)(@@)(@@)(@@) $ 9809 - عمرو بن الوليد يروي عن سالم بن عبد الله روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 9810 - عمرو بن يوسف مولى عثمان من أهل المدينة يروي عن سعيد بن المسيب روى عنه عمر بن حمزة(@)(@@)(@@)(@@) $ 9811 - عمرو بن نضر أبو النضر من أهل البصرة يروي عن إسماعيل بن أبي خالد والبصريين روى عنه أبو عاصم النبيل وأهل البصرة(@)(@@)(@@)(@@) $ 9812 - عمرو بن عامر البجلي والد أسد بن عمرو من أهل الكوفة يروي عن الكوفيين وعمر بن عبد العزيز روى عنه أهل بلده(@)(@@)(@@)(@@) $ 9813 - عمرو بن مجمع أبو المنذر السكوني من أهل الكوفة يروي عن هشام بن عروة وابن أبي خالد روى عنه أحمد بن حنبل رحمه الله وأهل العراق كان يخطىء(@)(@@)(@@)(@@) $ 9814 - عيسى بن عبد الرحمن البجلي يروي عن أبي عمرو الشيباني والشعبي روى عنه أبو غسان وأبو نعيم عداده في أهل الكوفة(@)(@@)(@@)(@@) $ 9815 - عيسى بن عبد الرحمن بن أبي ليلى الأنصاري من بني عمرو بن عوف من أهل الكوفة يروي عن أبيه روى عنه أخوه محمد 
ms1165	 بن PageV07P230 عبد الرحمن بن أبي ليلى يعتبر حديثه من غير رواية محمد بن عبد الرحمن عنه(@)(@@)(@@)(@@) $ 9816 - عيسى بن عاصم الأسدي من أهل الكوفة يروي عن زر بن حبيش روى عنه سلمة بن كهيل وقد لقيه جرير بن حازم بأرمينية وروى عنه(@)(@@)(@@)(@@) $ 9817 - عيسى بن عبد الله بن مالك من أهل المدينة يروي عن محمد بن عمرو بن عطاء روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 9818 - عيسى بن سيلان من أهل المدينة يروي عن كعب روى سعيد بن أيوب عن عبد الله بن الوليد عنه(@)(@@)(@@)(@@) $ 9819 - عيسى بن حفص بن عاصم بن عمر بن الخطاب أخو عمر بن حفص يروي عن جماعة من التابعين روى عنه وكيع بن الجراح مات سنة سبع وخمسين ومائة وأمه ميمونة بنت داود بن كليب بن إساف(@)(@@)(@@)(@@) $ 9820 - عيسى بن عتبة يروي عن خاله عبد الله بن بأبيه عن بن عمر روى عنه عمر بن سعيد PageV07P231(@)(@@)(@@)(@@) $ 9821 - عيسى بن المغيرة أبو شهاب التميمي من أهل الكوفة يروي عن الشعبي روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 9822 - عيسى بن حطان يروي عن مسلم بن سلام عن علي بن طلق روى عنه عاصم الأحول(@)(@@)(@@)(@@) $ 9823 - عيسى بن عبد الله الأنصاري يروي عن أبي طوالة روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 9824 - عيسى بن معاوية من أهل الحجاز يروي عن معبد بن كعب الأنصاري روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 9825 - عيسى بن المسيب من أهل الكوفة يروي عن نافع روى عنه أبو إسماعيل المؤدب(@)(@@)(@@)(@@) $ 9826 - عيسى بن موسى شيخ يروي عن أبي حازم روى عنه الوليد PageV07P232 بن مسلم كنيته أبو محمد وهو الذي يروي عن الشاميين(@)(@@)(@@)(@@) $ 9827 - عيسى بن علي يروي عن رافع بن بشير روى عنه عبد الحميد بن جعفر الأنصاري(@)(@@)(@@)(@@) $ 9828 - عيسى الأنصاري يروي عن أبي سلمة بن عبد الرحمن روى عنه زيد بن أبي أنيسة لست أدرى من هو ولاابن من هو(@)(@@)(@@)(@@) $ 9829 - عيسى بن عثمان قال رأيت فاطمة بنت علي بن أبي طالب روى عنه عبد الكريم الجزري 
ms1166	 وأهل الجزيرة(@)(@@)(@@)(@@) $ 9830 - عيسى بن الفضل بن معقل بن سنان الأشجعي يروي عن عبد الله بن نيار الأسلمي روى عنه أبان بن صالح(@)(@@)(@@)(@@) $ 9831 - عيسى بن معمر يروي عن عبد الله بن عمرو بن الفغواء روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 9832 - عيسى بن أزهر يروي عن الزهري روى عنه كثير بن هشام ربما أغرب على قلة روايته(@)(@@)(@@)(@@) $ 9833 - عيسى بن عمر القارىء الهمداني أبو عمر الأعمى من أهل PageV07P233 الكوفة يروي عن الشعبي والكوفيين روى عنه بن المبارك وجرير ووكيع(@)(@@)(@@)(@@) $ 9834 - عيسى بن لهيعة أخو عبد الله بن لهيعة يروي عن عكرمة عن بن عباس لما نزلت آية المواريث حرم رسول الله صلى الله عليه وسلم الحبس رواه يحيى بن حسان عن بن لهيعة عن أخيه عيسى بن لهيعة(@)(@@)(@@)(@@) $ 9835 - أبو طيبة اسمه عيسى بن سليمان بن دينار الدارمي من أهل جرجان يروى عن الكوفيين الشيباني والأعمش ودونهما روى عنه ابنه أحمد بن أبي طيبة مات سنة ثلاث وخمسين ومائة يخطىء(@)(@@)(@@)(@@) $ 9836 - عيسى بن موسى بن محمد بن إياس بن البكير يروي عن المدنيين وصفوان بن سليم روى عنه الليث بن سعد ويحيى بن أيوب(@)(@@)(@@)(@@) $ 9837 - عيسى بن موسى يروي عن محمد بن عباد بن جعفر روى عنه السائب بن عمر(@)(@@)(@@)(@@) $ 9838 - عيسى بن عبد الله شيخ يروي عن الزهري عن عبيد الله بن كعب بن مالك PageV07P234 عن أبيه أن النبي صلى الله عليه وسلم عاد البراء بن معرور روى عنه محمد بن شعيب بن شابور(@)(@@)(@@)(@@) $ 9839 - عيسى بن عون بن حفص بن الفرافصة الحنفي يروي عن يحيى بن سعيد الأنصاري روى عنه العراقيون(@)(@@)(@@)(@@) $ 9840 - عيسى بن دينار أبو علي المؤذن مولى عمرو بن الحارث بن المصطلق الخزاعي من أهل الكوفة يروي عن أبيه روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9841 - عيسى بن عبيد المروزي يروي عن عكرمة روى عنه أهل مرو(@)(@@)(@@)(@@) $ 9842 - عيسى بن كنانة يروي عن محمد بن عمار المؤذن عن أبي هريرة روى عنه يحيى بن عمير(@)(@@)(@@)(@@) $ 9843 - أبو سنان 
ms1167	 الشامي اسمه عيسى بن سنان القسملي كان ينزل PageV07P235 القساملة بالبصرة فنسب إليها يروي عن عثمان بن أبي سودة ويعلى بن شداد روى عنه حماد بن سلمة وعيسى بن يونس(@)(@@)(@@)(@@) $ 9844 - عيسى بن أبي عزة كوفي يروي عن الشعبي روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9845 - عيسى بن سوادة يروي عن عمرو بن دينار المقاطيع روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 9846 - عيسى بن يزيد يروي عن أبي زرعة عن أبي هريرة روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9847 - عيسى بن يزيد بن داب الليثي من أهل المدينة يروي عن عبد الرحمن بن أبي زيد عن أبي هريرة روى عنه يعقوب بن إبراهيم بن سعد(@)(@@)(@@)(@@) $ 9848 - عيسى بن زيد قال سئل عكرمة عن الوضوء بالنبيذ فقال لا بأس به روى عنه أبو تميلة يحيى بن واضح(@)(@@)(@@)(@@) $ 9849 - عيسى بن سنان يروي عن عثمان بن أبي سودة عن أبي هريرة روى عنه عيسى بن يونس(@)(@@)(@@)(@@) $ 9850 - عيسى بن مسعود بن الحكم الزرقي الأنصاري يروى عن عمرو PageV07P236 بن سليم الزرقي روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 9851 - عيسى بن عبيد أبو همام يروي عن الحسن روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 9852 - عيسى بن الضحاك أخو الجراح بن الضحاك كوفي يروي عن الأعمش روى عنه علي بن أبي بكر الأسفذني وهى قرية بالري(@)(@@)(@@)(@@) $ 9853 - عيسى بن عبيد الكندي المروزي كنيته أبو المنيب يروي عن عكرمة وابن بريدة روى عنه يحيى بن واضح والمراوزة وهو الذي يروي عن الربيع بن أنس(@)(@@)(@@)(@@) $ 9854 - عيسى بن المنهال العبدي من أهل البصرة يروي عن البصريين وغالب القطان روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 9855 - عيسى بن يزيد شيخ يروي عن طاوس روى عنه الزبيدي(@)(@@)(@@)(@@) $ 9856 - عيسى بن يزيد أبو معاذ المروزي يروي عن أبي إسحاق السبيعي PageV07P237 روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9857 - عيسى بن يونس بن أبي إسحاق السبيعي الهمداني كنيته أبو عمرو من أهل الكوفة يروي عن إسماعيل بن أبي خالد والأعمش روى عنه العراقيون والغرباء مات بالحدث سنة سبع وثمانين ومائة وقد قيل سنة تسع 
ms1168	 وثمانين ومائة ويقال أيضا أول سنة إحدى وتسعين ومائة وكان متقنا وهو أخو إسرائيل بن يونس وكان عيسى يسكن الجزيرة وقبره بالحدث(@)(@@)(@@)(@@) $ 9858 - عمران بن حدير السدوسي كنيته أبو عبيدة من أهل البصرة يروي عن أبي مجلز وعكرمة روى عنه شعبة بن الحجاج ووكيع بن الجراح مات سنة سبع وأربعين ومائة وقد قيل سنة تسع(@)(@@)(@@)(@@) $ 9859 - عمران بن مسلم الجعفي الأعمى من أهل الكوفة يروي عن سويد بن غفلة وزاذان روى عنه الثوري وشعبة وشريك(@)(@@)(@@)(@@) $ 9860 - عمران بن أوس بن ضمعج من أهل الكوفة يروي عن أبي مسعود وعائشة روى عنه مروان بن معاوية الفزاري PageV07P238(@)(@@)(@@)(@@) $ 9861 - عمران بن ظبيان كنيته أبو حفص مولى أسلم من أهل المدينة يروي عن جماعة من التابعين روى عنه أهل المدينة وهو خال إبراهيم بن محمد بن أبي يحيى مات سنة سبع وخمسين ومائة(@)(@@)(@@)(@@) $ 9862 - عمران بن بشير بن محرز يروي عن أبيه روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 9863 - عمران بن بشر أبو بشر السعدي يروى عن بن المسيب قوله روى عنه الحجازيون(@)(@@)(@@)(@@) $ 9864 - عمران بن عثمان بن الأرقم بن أبي الأرقم القرشي يروي عن أبيه روى عنه ابنه يحيى بن عمران(@)(@@)(@@)(@@) $ 9865 - عمران بن عكرمة الخزاعي يروي عن ذؤيب بن عباد الخزاعي روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 9866 - عمران أبو بشر الحلبي سكن البصرة يروي عن الحسن المراسيل روى عنه وكيع بن الجراح PageV07P239(@)(@@)(@@)(@@) $ 9867 - عمران بن موسى بن عمرو بن سعيد بن العاص أخو أيوب بن موسى يروي عن سعيد المقبري وعمر بن عبد العزيز روى عنه بن جريج(@)(@@)(@@)(@@) $ 9868 - عمران بن يزيد يروي المقاطيع روى عنه ثابت بن عبيد(@)(@@)(@@)(@@) $ 9869 - عمران بن أنس أبو أنس المكى يروى عن بن أبي مليكة وعطاء روى عنه يحيى بن واضح أبو تميلة ومعاوية بن هشام ومن قال عمران بن أبي أنس فقد وهم يخطىء(@)(@@)(@@)(@@) $ 9870 - عمران بن وهب الطائي يروي عن أبي رجاء العطاردي روى عنه محمد بن عبيد الطنافسي(@)(@@)(@@)(@@) $ 9871 - عمران بن عيينة بن 
ms1169	 أبي عمران الهلالي أخو سفيان بن عيينة كنيته أبو الحسن يروي عن إسماعيل بن أبي خالد روى عنه زيد بن الحريش الأهوازي والناس(@)(@@)(@@)(@@) $ 9872 - عمران بن عمرو يروي عن أبيه عن جابر في مس الذكر روى عنه ضمام بن إسماعيل(@)(@@)(@@)(@@) $ 9873 - عمران بن أبي يحيى التيمي يروي عن عبد الله بن كعب بن PageV00P000 مالك روى عنه محمد بن إبراهيم التيمي وسعيد المقبري(@)(@@)(@@)(@@) $ 9874 - عمران الخياط مولى الجعفي من أهل الكوفة يروي عن زيد بن وهب وإبراهيم النخعي روى عنه عبد الله بن عون(@)(@@)(@@)(@@) $ 9875 - عمران بن أبي يحيى يروي عن الحجازيين روى عنه محمد بن عبيد وعيسى بن يونس(@)(@@)(@@)(@@) $ 9876 - عمران بن حيان الأنصاري يروي عن أبيه روى عنه حميد بن علي(@)(@@)(@@)(@@) $ 9877 - عمران بن يحيى المعافري من أهل مصر يروي عن سعيد بن المسيب روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 9878 - عمران بن سليمان المرادي القبي من أهل الكوفة يروي عن الشعبي روى عنه عيسى بن يونس وحفص بن غياث حدثنا إبراهيم بن نصر العنبري بسمرقند قال ثنا علي بن خشرم قال ثنا عيسى بن يونس عن عمران القبي عن الشعبي عن جابر بن سمرة قال PageV07P241 سمعت النبي صلى الله عليه وسلم يقول في حجة الوداع لا يزال أمر هذه الأمة عاليا على من ناواها حتى يملك اثنا عشر خليفة(@)(@@)(@@)(@@) $ 9879 - عمران بن مسلم القصير المنقري من أهل البصرة كنيته أبو بكر يروي عن أبي رجاء العطاردي وعطاء روى عنه شعبة والبصريون وهو الذي روى عنه يحيى بن سليم إلا أن في رواية يحيى بن سليم عنه بعض المناكير وكذلك في رواية سويد بن عبد العزيز عنه(@)(@@)(@@)(@@) $ 9880 - عمران بن مسلم الفزاري وقد قيل بن أبي مسلم كان يسكن جهينة بالكوفة يروي عن الشعبي ومجاهد روى عنه محمد بن ربيعة وأبو نعيم(@)(@@)(@@)(@@) $ 9881 - عمران بن عبد الرحمن بن الحارث الهذلي يروي عن مجاهد روى عنه ابنه محمد بن عمران هو من أهل مكة(@)(@@)(@@)(@@) $ 9882 - عمران بن النعمان يروي عن 
ms1170	 الربيع بن سبرة روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9883 - عمران بن نافع يروي عن حفص بن عبيد الله عن أنس روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 9884 - عمران بن موسى بن طلحة بن عبيد الله القرشي الذي يقال له PageV07P242 عمران بن أبي الصعبة يروي عن أبيه عداده في أهل الكوفة روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 9885 - عمران بن أبي كثير يروي عن سعيد بن المسيب وقبيصة بن ذؤيب روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 9886 - عمران بن أبي جميل يروي عن أبي فراس عن عبد الله بن عمرو روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 9887 - عمران بن عبد الله بن طلحة الخزاعي يروي عن سعيد بن المسيب عداده في أهل البصرة روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 9888 - عمران بن عون يروي عن الزهري روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 9889 - عمران القطان وهو عمران بن داود كنيته أبو العوام من أهل البصرة يروي عن الحسن وقتادة وابن سيرين روى عنه أبو داود الطيالسي وأهل البصرة(@)(@@)(@@)(@@) $ 9890 - عمران البارقي يروي عن الحسن وعطية روى عنه الأعمش PageV07P243(@)(@@)(@@)(@@) $ 9891 - عمران بن عبيد المكي يروي عن أمه ليلى مولاة أسماء عن أسماء روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 9892 - عمران بن قدامة يروي عن البصريين روى عنه زيد العمى وأهل البصرة(@)(@@)(@@)(@@) $ 9893 - عمران بن زائدة بن نشيط من أهل الكوفة يروي عن أبيه روى عنه بن المبارك وعيسى بن يونس(@)(@@)(@@)(@@) $ 9894 - عمران بن زيد المدني يروي عن أبيه عن عائشة روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 9895 - عقبة بن أبي ثبيت الراسبي من أهل البصرة وهو الذي يقال له عقبة بن سريج وقد قيل عقبة بن شريح يروي عن أبي الجوزاء روى عنه شعبة وأبو هلال الراسبي(@)(@@)(@@)(@@) $ 9896 - عقبة بن عبد الرحمن بن أبي معمر من أهل المدينة يروي عن محمد بن عبد الرحمن بن ثوبان روى عنه بن أبي ذئب PageV07P244(@)(@@)(@@)(@@) $ 9897 - عقبة بن واصل بن عبد الله بن الشخير بن أخي مطرف يروي عن عمه مطرف بن عبد 
ms1171	 الله روى عنه الأسود بن شيبان(@)(@@)(@@)(@@) $ 9898 - عقبة بن أبي زينب قوله روى عنه رجاء بن أبي سلمة(@)(@@)(@@)(@@) $ 9899 - عقبة بن أبي صالح من أهل الكوفة يروي عن جماعة من التابعين روى عنه أهلها(@)(@@)(@@)(@@) $ 9900 - عقبة بن أبي جسرة يروي عن الحسن وابن سيرين روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 9901 - عقبة بن علقمة المعافري يروي عن أبي عقال عن أنس بن مالك روى عنه أحمد بن البحري الرملي(@)(@@)(@@)(@@) $ 9902 - أبو الجلاس اسمه عقبة بن سيار السلمي من أهل الشام سكن البصرة يروي عن عثمان بن جحاش روى عنه عبد الوارث بن سعيد(@)(@@)(@@)(@@) $ 9903 - عقبة الأسدي يروي عن أبي العلاء بن الشخير روى عنه PageV07P245 سفيان الثوري(@)(@@)(@@)(@@) $ 9904 - عقبة بن عبد الله الرفاعي يروى عن بن سيرين وسالم روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9905 - عقبة بن صهيب بن أبي الصهباء الباهلي من أهل البصرة يروي عن سالم والحجازيين والحسن وابن سيرين روى عنه زيد بن الحباب وأبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 9906 - عقبة بن أبي يزيد القرشي من أهل المدينة يروي عن زيد بن أسلم روى عنه العراقيون(@)(@@)(@@)(@@) $ 9907 - عقبة بن موسى من أصدقاء داود الطائي ممن له الفضائل المذكورة في تعبده روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9908 - عقبة بن عطية الرفاعي يروي عن قتادة روى عنه زيد بن الحباب PageV07P246(@)(@@)(@@)(@@) $ 9909 - عقبة بن أبي الصهباء بصري يروي عن سالم بن عبد الله بن عمر روى عنه جويرية بن أشرس والبصريون سمعت أبا يعلى يقول سألت يحيى بن معين عن عقبة بن أبي الصهباء فقال ثقة(@)(@@)(@@)(@@) $ 9910 - عقبة بن إسحاق السلمي من أهل الكوفة يروي عن إسماعيل بن أبي خالد روى عنه أبو إدريس وإسحاق بن منصور(@)(@@)(@@)(@@) $ 9911 - عقبة بن مسلم التجيبي مصري يروي عن أبي عبد الرحمن الحبلي روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 9912 - عقبة بن أبي العيزار الكوفي يروي عن الشعبي والنخعي روى عنه عبد الواحد بن زياد يعتبر حديثه من غير رواية ابنه يحيى عنه لأن يحيى بن عقبة ضعيف الحديث(@)(@@)(@@)(@@) $ 9913 - عقبة بن 
ms1172	 خالد الشني يروي عن أم شبيب عن أم سلمة روى عنه مسلم بن إبراهيم حدثنا أبو خليفة قال ثنا مسلم بن إبراهيم قال ثنا عقبة بن خالد قال ثنا الحسن قال PageV07P247 بينما نحن عند عمران بن حصين إذ قال له رجل يا أبا نجيد حدثنا بالقرآن قال أليس تقرء القرآن أقيموا الصلاة وآتوا الزكاة أكنتم تعرفون مواقيتها وركوعها وسجودها وحدودها أكنت تدري كم الزكاة في الورق والذهب والإبل والغنم وأصناف المال شهدت ووعيت فرض رسول الله صلى الله عليه وسلم الزكاة كذا وكذا فقال الرجل أحييتني أحياك الله أبا نجيد قال فما مات ذلك الرجل حتى صار من فقهاء المسلمين(@)(@@)(@@)(@@) $ 9914 - عقبة بن خالد بن عقبة بن خالد السكوني كنيته أبو مسعود من أهل الكوفة يروي عن يحيى بن سعيد الأنصاري وهشام بن عروة وعبيد الله بن عمر روى عنه أحمد بن حنبل والكوفيون(@)(@@)(@@)(@@) $ 9915 - عامر بن جشيب أبو خالد الشامي يروي عن خالد بن معدان روى عنه لقمان بن عامر الوصابى وأهل الشام PageV07P248(@)(@@)(@@)(@@) $ 9916 - عامر بن شقيق بن جمرة الأسدي من أهل الكوفة يروي عن أبي وائل روى عنه الثوري ومسعر وابن عيينة(@)(@@)(@@)(@@) $ 9917 - عامر بن يحيى المصري يروي عن أبي عبد الرحمن الحبلي روى عنه الليث بن سعد وخالد بن يزيد(@)(@@)(@@)(@@) $ 9918 - عامر بن عبد الله بن نسطاس من أهل المدينة يروي عن الحجازيين روى عنه عبد الله بن يزيد بن هرمز(@)(@@)(@@)(@@) $ 9919 - عامر بن عبد الله يروي عن شهر بن حوشب روى عنه قرة بن خالد السدوسي(@)(@@)(@@)(@@) $ 9920 - عامر بن عبدة يروي عن أبي المليح بن أسامة عداده في أهل البصرة روى عنه أبو أسامة وليس هذا بعامر بن عبدة البجلي PageV07P249 صاحب بن مسعود ذاك تابعي قد ذكرناه في كتاب التابعين(@)(@@)(@@)(@@) $ 9921 - عامر بن حصين بن قيس اليربوعي الحنظلي أخو زياد بن حصين يروي عن أبيه عداده في أهل البصرة روى عنه عوف الأعرابي(@)(@@)(@@)(@@) $ 9922 - عامر بن عقبة العقيلي يروي عن أبيه عن أبي هريرة روى عنه 
ms1173	 يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 9923 - عامر بن مصعب يروي عن طاوس روى عنه بن جريج(@)(@@)(@@)(@@) $ 9924 - عامر بن عبد الله العقيلي يروي عن أبيه عن أبي هريرة روى عنه يحيى بن أبي كثير وأبو عبد الله بن شقيق العقيلي(@)(@@)(@@)(@@) $ 9925 - عامر بن رزيق مولى بني عامر يروي المقاطيع عداده في أهل البصرة روى عنه القاسم بن الفضل الحداني(@)(@@)(@@)(@@) $ 9926 - عامر بن هني يروي عن محمد بن علي بن الحنفية روى علي بن عبد الأعلى عن أبيه عنه PageV07P250(@)(@@)(@@)(@@) $ 9927 - عامر بن السبط الجذامي وقد قيل عامر بن السمط والصحيح السمط كنيته أبو كنانة من أهل الكوفة يروي عن أبي الغريف عبد الله بن خليفة الهمداني وكان حافظا روى عنه علي بن مسهر وهو الذي روى عاصم بن محمد بن زيد بن عبد الله بن عمر عن عامر بن السمط عن معاوية بن إسحاق بن طلحة عن عطاء بن يسار عن بن مسعود حديث الخلفاء(@)(@@)(@@)(@@) $ 9928 - عطاء بن السائب بن زيد الثقفي كنيته أبو زيد من أهل الكوفة وقد قيل إنه عطاء بن السائب بن مالك يروي عن أبيه والكوفيين وقد قيل إنه سمع من أنس ولم يصح ذلك عندي مات سنة ست وثلاثين ومائة وكان قد اختلط بآخره ولم يفحش خطاءه حتى يستحق أن يعدل به عن مسلك العدول بعد PageV07P251 تقدم صحة ثباته في الروايات روى عنه الثوري وشعبة وأهل العراق(@)(@@)(@@)(@@) $ 9929 - عطاء بن مسعود الكعبي عداده في أهل المدينة يروي عن أبيه روى عنه موسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 9930 - عطاء بن يعقوب الكيخاراني من أهل اليمن مولى بن سباع وكيخاران موضع باليمن نسب إليه يروي عن أم الدرداء روى عنه الزهري والقاسم بن أبي بزة ومن زعم أنه سمع معاذ بن جبل فقد وهم(@)(@@)(@@)(@@) $ 9931 - عطاء بن قرة السلولي يروي عن عبد الله بن ضمرة السلولي روى عنه عبد الرحمن بن يزيد بن جابر وعبد الرحمن بن ثابت بن ثوبان الشاميان(@)(@@)(@@)(@@) $ 9932 - عطاء الأنصاري من أهل الشام يروي عن أبي 
ms1174	 أسيد بن ثابت روى عنه عبد الله بن عيسى PageV07P252(@)(@@)(@@)(@@) $ 9933 - عطاء بن مسلم يروي عن وهب بن منبه روى عنه أهل اليمن حدثنا أبو خليفة قال ثنا علي بن المديني قال ثنا محمد بن عمرو بن مقسم الصنعاني قال حدثنا عطاء بن مسلم عن وهب بن منبه قال كان شعيب رجلا صالحا ولم يكن نبيا(@)(@@)(@@)(@@) $ 9934 - عطاء بن مسروق الفزاري مولى القاسم بن محمد يروي المراسيل والمقاطيع روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 9935 - عطاء بن أبي مروان الأسلمي من أهل المدينة كنيته أبو مصعب يروي عن أبيه والمدنيين روى عنه موسى بن عقبة وغيلان بن جامع والثوري مات في ولاية أبي العباس السفاح واسم أبي مروان عبد الرحمن بن مغيث(@)(@@)(@@)(@@) $ 9936 - عطاء بن خباب يروي عن أبيه وعطاء بن أبي رباح روى عنه ابنه محمد بن عطاء PageV07P253(@)(@@)(@@)(@@) $ 9937 - عطاء بن دينار الهذلي يروي عن سعيد بن جبير روى عنه عمرو بن الحارث وسعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 9938 - عطاء بن جندب يروى عن بن سيرين روى عنه أبان بن خالد(@)(@@)(@@)(@@) $ 9939 - عطاء بن أبي راشد يروي عن عبد الله بن الحارث روى عنه محمد بن عمرو بن علقمة(@)(@@)(@@)(@@) $ 9940 - عطاء بن عبد الله السليمي الزاهد من أهل البصرة يروي عن عبد الله بن غالب الحداني ومالك بن دينار روى عنه نوح بن قيس الطاحي وأهل البصرة كان فيمن بايع بن الأشعث وقاتل معه حتى قتل لست احفظ له سماعا ولا رواية عن أحد من الصحابة فلذلك أدخلناه في هذه الطبقة وكان من العباد بقى في متعبده أربعين سنة لا يفطر نهارا ولا ينام ليلا مع دوام البكاء والأنين وكثرة التوجع والحنين إلى أن مات(@)(@@)(@@)(@@) $ 9941 - عطاء بن مضاء الصغير يروي عن الحسن روى عنه مروان بن معاوية الفزاري PageV07P254(@)(@@)(@@)(@@) $ 9942 - عطاء بن خالد يروي عن عامر بن عبد الله بن الزبير روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 9943 - عطاء الخشك بصري يروي عن بن سيرين روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 9944 - عطاء بن محمد 
ms1175	 يروي عن عطاء بن أبي رباح روى عنه أبو حمزة السكري(@)(@@)(@@)(@@) $ 9945 - عطاء بن عروة يروي عن الحسن روى عنه يحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 9946 - عطاء بن عبد الله الأزرق كنيته أبو همام يروي عن الحسن روى عنه جعفر بن سليمان الضبعي ومحمد بن مروان العقيلي الحكايات في الرقائق(@)(@@)(@@)(@@) $ 9947 - عطاء شيخ يروي عن حكيم بن يزيد عن أبيه ويقال إن لأبيه صحبة روى عنه البصريون(@)(@@)(@@)(@@) $ 9948 - عطاء بن مسلم الخفاف من أهل حلب يروي عن الأعمش وأهل الكوفة روى عنه أهل الشام والعراق مات في شهر رمضان سنة تسعين ومائة PageV07P255(@)(@@)(@@)(@@) $ 9949 - عاصم بن المنذر بن الزبير بن العوام القرشي يروي عن عروة بن الزبير وعبيد الله بن عبد الله بن عمر روى عنه هشام بن عروة وحماد بن سلمة وهو أخو فاطمة بنت المنذر(@)(@@)(@@)(@@) $ 9950 - عاصم بن محمد بن زيد بن عبد الله بن عمر بن الخطاب أخو واقد وعمر وزيد وأبي بكر يروي عن أبيه روى عنه الحجازيون وأهل العراق وهو الذي روى شبابة عن عاصم بن محمد عن محمد بن سوقة(@)(@@)(@@)(@@) $ 9951 - عاصم بن كليب بن شهاب الجرمي من أهل الكوفة يروي عن أبيه عن وائل بن حجر روى عنه الثوري وشعبة مات سنة سبع وثلاثين ومائة(@)(@@)(@@)(@@) $ 9952 - عاصم بن أبي النجود الأسدي وهو عاصم بن بهدلة كان اسم أبي النجود بهدلة كنيته أبو بكر من أهل الكوفة يروي عن أبي وائل وزر بن حبيش روى عنه أبو بكر بن عياش وأهل العراق مات سنة ثمان وعشرين ومائة وكان من القراء PageV07P256(@)(@@)(@@)(@@) $ 9953 - عاصم بن عمر الفهري يروي عن امرأة عن عائشة روى عنه أبو وهب الجيشاني عداده في أهل مصر(@)(@@)(@@)(@@) $ 9954 - عاصم بن راشد يروي عن الحسن روى عنه سهل بن حصين(@)(@@)(@@)(@@) $ 9955 - عاصم بن هبيرة يروي عن الكوفيين والمغيرة بن مقسم روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9956 - عاصم بن عمرو بن أبي أحمد بن جحش القرشي يروي عن الحجازيين روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 9957 - عاصم بن 
ms1176	 عمر بن عثمان يروي عن عروة عن عائشة روى عنه عمرو بن عثمان بن هانئ(@)(@@)(@@)(@@) $ 9958 - عاصم مولى قريبة بنت محمد بن أبي بكر الصديق كنيته أبو بكر سكن واسط وهو والد علي بن عاصم يروي عن المدنيين روى عنه شعبة وهشيم PageV07P257(@)(@@)(@@)(@@) $ 9959 - عاصم بن مخلد يروي عن أبي الأشعث الصنعاني عن شداد بن أوس روى عنه قزعة بن سويد(@)(@@)(@@)(@@) $ 9960 - عاصم العنزي يروي عن نافع بن جبير بن مطعم عن أبيه قال كان النبي صلى الله عليه وسلم إذا دخل في الصلاة قال الله أكبر كبيرا ثلاثا والحمد لله كثيرا وسبحان الله بكرة وأصيلا اللهم إني أعوذ بك من الشيطان الرجيم من نفخه ونفثه وهمزه كذا قال شعبة عن عمرو بن مرة عن عاصم العنزي وقال مسعر عن عمرو بن مرة عن رجل من عنزة وقال بن إدريس عن حصين عن عمرو بن مرة عن عباد بن عاصم عن نافع بن جبير وقال عباد بن العوام عن حصين عن عمرو بن مرة عن عمار بن عاصم عن نافع بن جبير وهو عند بن عياش عن عبد العزيز بن عبيد الله بن حمزة بن صهيب عن عبد الرحمن بن نافع بن جبير بن مطعم عن أبيه بطوله ونفخه الكبر وهمزه الموتة ونفثه الشعر PageV07P258(@)(@@)(@@)(@@) $ 9961 - عاصم بن رجاء بن حيوة الكندي من أهل الشام يروي عن أبيه والشاميين روى عنه عبد الله بن داود الخريبي وأهل بلده(@)(@@)(@@)(@@) $ 9962 - عاصم أبو مالك العطاردي يروي عن الحسن روى عنه زيد بن الحباب وعبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 9963 - عاصم بن عبد الله يروي عن صفوان بن محرز روى عنه داود بن أبي هند(@)(@@)(@@)(@@) $ 9964 - عاصم بن عمر بن حفص أخو عبيد الله بن عمر يروي عن عبد الله بن دينار روى عنه عبد الله بن نافع يخطىء ويخالف(@)(@@)(@@)(@@) $ 9965 - عاصم بن سويد بن عامر بن يزيد بن جارية الأنصاري من أهل المدينة يروي عن يحيى بن سعيد الأنصاري روى عنه محمد بن الصباح 
ms1177	 الجرجرائي وعلي بن الحجر السعدي PageV07P259(@)(@@)(@@)(@@) $ 9966 - عاصم بن شبرمة الكوفي يروي عن الحسن قوله روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9967 - عمارة بن القعقاع بن شبرمة الضبي بن أخي عبد الله بن شبرمة من أهل الكوفة يروي عن أبي زرعة بن عمرو بن جرير روى عنه الثوري وأهل العراق(@)(@@)(@@)(@@) $ 9968 - عمارة بن عبد الله بن صياد المديني يروي عن عطاء بن يسار والمدنيين روى عنه مالك بن أنس كنيته أبو أيوب من بني النجار مات في ولاية مروان بن محمد(@)(@@)(@@)(@@) $ 9969 - عمارة بن عبد الله بن طعمة يروي عن سعيد بن المسيب روى عنه محمد بن إسحاق ويزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 9970 - عمارة بن غزية بن الحارث بن عمرو بن غزية بن عمرو بن ثعلبة بن خنساء بن مبذول المازني من أهل المدينة يروي عن الزهري والربيع PageV07P260 بن سبرة وأم عمارة بن غزية أم إسماعيل بنت أبي حبة بن غزية بن عمرو روى عنه سليمان بن بلال والدراوردي وأهل الشام ومصر مات سنة أربعين ومائة(@)(@@)(@@)(@@) $ 9971 - عمارة بن حفص بن عمر بن سعد بن عائذ القرظي مولى بني مخزوم من أهل المدينة أخو عمر بن حفص يروي عن أبيه روى عنه عبد الرحمن بن سعد(@)(@@)(@@)(@@) $ 9972 - عمارة بن مهاجر يروي عن أبي بكر بن محمد بن عمرو بن حزم روى عنه الدراوردي(@)(@@)(@@)(@@) $ 9973 - عمارة بن مضرس البجلي كوفي يروي عن عكرمة روى عنه ابنه الحسن بن عمارة(@)(@@)(@@)(@@) $ 9974 - عمارة بن طريف وقد قيل بن مطرف يروي عن يزيد بن أبي مريم روى عنه يحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 9975 - عمارة بن أبي حفصة كنيته أبو روح واسم أبى حفصة ثابت PageV07P261 مولى عتيك يروي عن عكرمة عداده في أهل البصرة روى عنه شعبة وأهل العراق مات سنة اثنتين وثلاثين ومائة(@)(@@)(@@)(@@) $ 9976 - عمارة بن عزاب اليحصبي يروي عن عمته عن عائشة روى عنه عبد الرحمن بن زياد بن أنعم يعتبر حديثه من غير رواية الإفريقي عنه(@)(@@)(@@)(@@) $ 9977 - عمارة بن جارية يروي عن عمرو بن يثربي 
ms1178	 روى عنه عبد الرحمن بن أبي سعيد(@)(@@)(@@)(@@) $ 9978 - عمارة بن حيان يروي عن عكرمة روى عنه الحسين بن واقد(@)(@@)(@@)(@@) $ 9979 - عمارة بن ثوبان يروي عن عطاء روى عنه جعفر بن يحيى بن ثوبان(@)(@@)(@@)(@@) $ 9980 - عمارة بن عبد الرحمن أبو عبد الرحمن الإسكندراني يروي عن عكرمة روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9981 - عمارة بن مهران المعولي العابد كنيته أبو سعيد من أهل البصرة يروي عن الحسن وأبي نضرة روى عنه المعتمر بن سليمان PageV07P262(@)(@@)(@@)(@@) $ 9982 - عمارة بن زاذان الصيدلاني مولى تيم الله بن ثعلبة من أهل البصرة كنيته أبو سلمة يروي عن مكحول روى عنه موسى بن إسماعيل وأهل البصرة(@)(@@)(@@)(@@) $ 9983 - عمارة بن أبي شعيب القسملي البصري عن مالك بن دينار سمع منه مسلم ومحمد بن المثنى(@)(@@)(@@)(@@) $ 9984 - العلاء بن المسيب بن رافع الثعلبي من أهل الكوفة يروي عن أبيه وعطاء روى عنه الثوري وجرير بن حازم حدثنا محمد بن عمر بن الهمداني قال ثنا محمد بن أشكيب قال ثنا سعيد بن عمرو الأشعثي قال ثنا أبو زبيد عن العلاء بن المسيب عن سهيل بن أبي صالح عن أبيه عن أبي هريرة عن النبي صلى الله عليه وسلم قال إن الله إذا أحب عبدا الحديث PageV07P263(@)(@@)(@@)(@@) $ 9985 - العلاء بن عبد الكريم اليامي كنيته أبو عون من أهل الكوفة يروي عن مجاهد روى عنه الثوري ووكيع بن الجراح وكان من العباد الخشن(@)(@@)(@@)(@@) $ 9986 - العلاء بن زياد بن مطر بن شريح العدوي من أهل البصرة يروي عن الحسن الحكايات روى عنه هشام بن حسان وأهل البصرة وكان من عباد أهل البصرة وقرائهم كان قد دبر غلاما له على أن يأتيه كل يوم برغيفين إلى أن يموت فكان ذلك قوته إلى أن مات(@)(@@)(@@)(@@) $ 9987 - العلاء بن خالد الأسدي الكوفي يروي عن أبي وائل روى عنه الثوري ومروان بن معاوية والكوفيون(@)(@@)(@@)(@@) $ 9988 - العلاء بن الحارث أبو وهب الحضرمي الدمشقي يروي عن مكحول روى عنه أهل الشام مات سنة ست وثلاثين ومائة يعتبر PageV07P264 حديثه من رواية الثقات عنه(@)(@@)(@@)(@@) $ 9989 
ms1179	 - العلاء بن عتبة اليحصبي من أهل الشام يروي عن خالد بن معدان روى عنه الأوزاعي ومعاوية بن صالح(@)(@@)(@@)(@@) $ 9990 - العلاء بن عبد الله بن بدر الغنوي يروي عن أبي الشعثاء جابر بن زيد روى عنه أبو سنان والكوفيون(@)(@@)(@@)(@@) $ 9991 - العلاء بن أبي العباس الشاعر من أهل مكة واسم أبي العباس السائب بن فروخ مولى بني الديل يروي عن أبي جعفر محمد بن علي روى عنه الثوري وابن جريج وقد روى عن أبي الطفيل إن كان سمع منه(@)(@@)(@@)(@@) $ 9992 - العلاء بن عبد الله بن رافع يروي المراسيل روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 9993 - العلاء بن زهير الأزدي يروي عن عبد الرحمن بن الأسود عن أبيه روى عنه أبو نعيم الفضل بن دكين PageV07P265(@)(@@)(@@)(@@) $ 9994 - العلاء بن القاسم يروي المقاطيع عن بن أبي حسين وغيره روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 9995 - العلاء بن رئاب يروي عن الحسن روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 9996 - العلاء بن هلال الباهلي يروي المقاطيع عن صلة بن زفر روى عنه السرى بن يحيى وحماد بن سلمة(@)(@@)(@@)(@@) $ 9997 - العلاء بن بدر العنزي يروي عن إبراهيم النخعي ان الأيام تزيد على ثلاثمائة وأربعة وخمسين يوما في كل أربع سنين يوما تربو به الأهلة وتعظم روى عنه الشيباني حدثنا عمر بن محمد قال ثنا الحسن بن علي العجلي قال ثنا أبو أسامة PageV07P266 قال ثنا مفضل بن مهلهل عن الشيباني عن العلاء بن بدر في قصة طويلة(@)(@@)(@@)(@@) $ 9998 - العلاء بن هارون يروي عن الشعبي روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 9999 - العلاء بن قيس الكاهلي من أهل الكوفة يروي عن الشعبي روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 10000 - العلاء بن عبد الله بن رافع يروي عن ميمون بن مهران روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 10001 - العلاء بن خالد القرشي يروي عن عطاء بن أبي رباح قال رأيت أبا هريرة هو يطوف بهذا البيت وهو ينادي لا صدقة إلا عن فضل العيال حدثناه الثقفي قال ثنا قتيبة بن سعيد قال ثنا العلاء بن 
ms1180	 خالد القرشي عن عطاء بن أبي رباح أحسبه الذي روى عن أبى وائل PageV07P267(@)(@@)(@@)(@@) $ 10002 - العلاء بن صالح يروي عن عدى بن ثابت روى عنه عبد الله بن نمير(@)(@@)(@@)(@@) $ 10003 - العلاء بن عقبة يروي المراسيل روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 10004 - العلاء بن بشير المزني من أهل البصرة يروي عن أبي الصديق الناجي روى عنه معلى بن زياد(@)(@@)(@@)(@@) $ 10005 - العلاء بن عمار بن حصين بن حلمة والد أبي عمرو بن العلاء يروي عن أبيه روى عنه ابنه معاذ بن العلاء وكان من أفرس أهل زمانه عداده في أهل البصرة(@)(@@)(@@)(@@) $ 10006 - العلاء بن خالد بن وردان أبو شيبة الحنفي يروى عن عطاء PageV07P268 روى عنه الفضل بن موسى الشيباني(@)(@@)(@@)(@@) $ 10007 - العلاء بن خالد مولى آل صالح يروي عن يزيد الرقاشي روى عنه أبو كامل الجحدري عداده في أهل البصرة(@)(@@)(@@)(@@) $ 10008 - عتبة بن مسلم مولى بني تيم من أهل المدينة يروي عن أبي سلمة بن عبد الرحمن ونافع بن جبير بن مطعم روى عنه محمد بن إسحاق وأهل المدينة(@)(@@)(@@)(@@) $ 10009 - أبو العميس اسمه عتبة بن عبد الله بن عتبة بن مسعود الهذلي المسعودي أخو عبد الرحمن بن عبد الله المسعودي يروي عن إياس بن سلمة بن الأكوع روى عنه وكيع وأهل الكوفة(@)(@@)(@@)(@@) $ 10010 - عتبة بن إبراهيم بن أبي خداش من أهل الكوفة يروي المراسيل روى عنه سفيان بن عيينة(@)(@@)(@@)(@@) $ 10011 - عتبة بن عمرو المكتب من أهل الكوفة يروي عن الشعبي وعكرمة روى عنه أبو صيفى والكوفيون وليس هذا بعبيد بن عمرو المكتب(@)(@@)(@@)(@@) $ 10012 - عتبة بن محمد بن الحارث بن نوفل القرشي من أهل PageV07P269 مكة يروي عن كريب روى عنه بن جريج(@)(@@)(@@)(@@) $ 10013 - عتبة بن عبيد الصدفي من أهل مصر يروي المراسيل والمقاطيع روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 10014 - عتبة بن جبيرة بن محمود بن أبي جبيرة الأشهلي يروي عن التابعين روى عنه أهل المدينة مات سنة أربع وخمسين ومائة(@)(@@)(@@)(@@) $ 10015 - عتبة بن أبي عتبة يروي عن نافع بن جبير بن مطعم روى عنه 