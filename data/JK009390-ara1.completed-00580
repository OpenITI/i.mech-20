ms561	 أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5248 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا غضب على أمة لم ينزل بها عذاب خسف ولا مسخ غلت أسعارها ، ويحبس عنها أمطارها ، ويلي عليها أشرارها ) )(@)(@@) ( ابن عساكر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5249 ) قال النبي :(@)(@@) | 30 ( إن الله إذا قضى على عبد قضاء لم يكن لقضائه مرد ) )(@)(@@) ( ابن قانع ) عن شرحبيل بن السمط رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5250 ) قال النبي :(@)(@@) | 30 ( إن الله إذا كان يوم القيامة ينزل إلى العباد ليقضي بينهم ، وكل أمة جاثية ، فأول من يدعو به رجل جمع القرآن ، ورجل قتل في سبيل الله ، ورجل كثير المال ، فيقول الله للقارىء : ألم أعلمك ما أنزلت على رسولي ؟ قال : بلى يا رب ، قال : فماذا عملت فيما علمت ؟ قال : كنت أقوم به آناء الليل وآناء النهار ، فيقول الله له : كذبت ، وتقول الملائكة : كذبت ، ويقول الله له : بل أردت أن يقال فلان قارىء ، فقد قيل ذالك ، ويؤتى بصاحب المال فيقول الله له : ألم أوسع عليك حتى لم أدعك تحتاج إلى أحد ؟ قال : بلى يا رب ، قال : فماذا عملت فيما آتيتك ؟ قال : كنت أصل الرحم وأتصدق ، فيقول الله له : كذبت ، وتقول الملائكة : كذبت ، ويقول الله : بل أردت أن يقال : فلان جواد ، فقد قيل ذالك ، ويؤتى بالذي قتل في سبيل الله فيقول الله : فيماذا قتلت ؟ فيقول : أمرت PageV02P258 بالجهاد في سبيلك فقاتلت حتى قتلت فيقول الله لك : كذبت ، وتقول له الملائكة : كذبت ، ويقول الله : بل أردت أن يقال : فلان جريء فقد قيل ذالك ، يا أبا هريرة أولائك الثلاثة أول خلق الله تسعر بهم النار يوم القيامة ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5251 ) قال النبي :(@)(@@) | 30 ( إن الله أذن لي أن أحدث عن ديك قد مرقت رجلاه الأرض وعنقه منثنية تحت العرش وهو يقول : سبحانك ما أعظمك ، فيرد عليه لا يعلم ذالك من حلف بي كاذبا ) )(@)(@@) ( أبو الشيخ في العظمة طس ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5252 ) قال النبي :(@)(@@) | 30 ( إن الله أرسلني مبلغا 
ms562	 ولم يرسلني متعنتا ) )(@)(@@) ( م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5253 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى استخلص هاذا الدين لنفسه ، ولا يصلح لدينكم إلا السخاء وحسن الخلق ، فزينوا دينكم بهما ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5254 ) قال النبي :(@)(@@) | 30 ( إن الله استقبل بي الشام وولى ظهري اليمن وقال لي : يا محمد ، إني جعلت لك ما تجاهك غنيمة ورزقا ، وما خلف ظهرك مددا ، ولا يزال الإسلام يزيد ، وينقص الشرك وأهله ، حتى تسير المرأتان لا تخشيان إلا جورا والذي نفسي بيده ، لا تذهب الأيام والليالي حتى يبلغ هاذا الدبن مبلغ هاذا النجم ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5255 ) قال النبي :(@)(@@) | 30 ( إن الله أشد حمية للمؤمن من الدنيا من المريض أهله من الطعام ، والله أشد تعاهدا للمؤمن بالبلاء من الوالد لولده بالخير ) )(@)(@@) ( طب حل ) و الضياء عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5256 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اصطفى كنانة من ولد إسماعيل ، PageV02P259 واصطفى قريشا من كنانة ، واصطفى من قريي بني هاشم ، واصطفاني من بني هاشم ) )(@)(@@) ( م ت ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5257 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اصطفى من الكلام أربعا : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، فمن قال : سبحان الله كتبت له عشرون حسنة ، وحطت عنه عشرون سيئة ، ومن قال : الله أكبر مثل ذالك ، ومن قال : لا إلاه إلا الله مثل ذالك ، ومن قال : الحمد لله رب العالمين من قبل نفسه كتبت له ثلاثون حسنة وحط عنه ثلاثون خطيئة ) )(@)(@@) ( حم ك ) و الضياء عن أبي سعيد وأبي هريرة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 5258 ) قال النبي :(@)(@@) | 30 ( إن الله اصطفى من ولد إبراهيم إسماعيل ، واصطفى من ولد إسماعيل بني كنانة ، واصطفى من بني كنانة قريشا ، واصطفى من قريش بني هاشم واصطفاني من بني هاشم ) )(@)(@@) ( ت ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5259 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اصطفى موسى بالكلام ، وإبراهيم بالخلة ) )(@)(@@) ( ك ) عن ابن عباس رضي 
ms563	 الله عنهما .(@)(@@)(@@)(@@) $ ( 5260 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اطلع على أهل بدر فقال : اعملوا ما شئتم فقد غفرت لكم ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5261 ) قال النبي :(@)(@@) | 30 ( إن الله أعطى كل ذي حق حقه ، فلا وصية لوارث ، والولد للفراش ، وللعاهر الحجر ) )(@)(@@) ( ت ) عن عمرو بن خارجة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5262 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاكم ثلث أموالكم عند وفاتكم زيادة في أعمالكم ) )(@)(@@) ( طب ) عن خالد بن عبيد الله السلمي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5263 ) قال النبي :(@)(@@) | 30 ( إن الله أعطى موسى الكلام وأعطاني الرؤية وفضلني PageV02P260 بالمقام المحمود والحوض المورود ) )(@)(@@) ( ابن عساكر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5264 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أعطاني السبع مكان التوراة ، وأعطاني الراءات إلى الطواسين مكان الإنجيل ، وأعطاني ما بين الطواسين إلى الحواميم مكان الزبور ، وفضلني بالحواميم والمفصل ما قرأهن نبي قبلي ) )(@)(@@) ( محمد بن نصر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5265 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاني الليلة الكنزين ، كنز فارس والروم ، وأمدني بالملوك ملوك حمير الأحمرين ، ولا ملك إلا الله ، يأتون فيأخذون من مال الله ويقاتلون في سبيل الله ) )(@)(@@) ( حم د و البغوي ) عن رجل من خثعم ( ز ) .(@)(@@)(@@)(@@) $ ( 5266 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاني ثلاث خصال لم يعطها أحد قبلي : الصلاة في الصفوف ، والتحية من تحية أهل الجنة ، وآمين ، إلا أنه أعطى موسى أن يدعو ويؤمن هاارون ) )(@)(@@) ( عد هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5267 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاني خصالا ثلاثا : صلاة الصفوف ، والتحية ، والتأمين ) )(@)(@@) ( ابن خزيمة ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5268 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاني فارس ونساءهم وأبناءهم وسلاحهم وأموالهم ، وأعطاني الروم ونساءهم وأبناءهم وسلاحهم وأموالهم وأمدني بحمير ) )(@)(@@) ( ابن منده وأبو نعيم في المعرفة وابن عساكر ) عن عبد الله بن سعد الأنصاري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5269 ) قال النبي :(@)(@@) | 30 ( إن الله أعطاني فيما من به علي ، أني أعطيتك فاتحة الكتاب وهي من كنوز عرشي ، ثم قسمتها بيني وبينك 
ms564	 نصفين ) )(@)(@@) ( ابن الضريس هب ) عن أنس رضي الله عنه .(@)(@@) PageV02P261(@)(@@)(@@)(@@) $ ( 5270 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى افترض صوم رمضان ، وسننت لكم قيامه ، فمن صامه وقامه إيمانا واحتسابا ويقينا كان كفارة لما مضى ) )(@)(@@) ( ن هب ) عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5271 ) قال النبي :(@)(@@) | 30 ( إن الله افترض على العباد خمس صلوات في كل يوم وليلة ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5272 ) قال النبي :(@)(@@) | 30 ( إن الله أمدني يوم بدر وحنين بملائكة يعتمون بهاذه العمة ، إن العمامة حاجزة بين الكفر والإيمان ) )(@)(@@) ( الطيالسي هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5273 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أمرني أن أزوج فاطمة من علي ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنهم .(@)(@@)(@@)(@@) $ 5274 قال النبي :(@)(@@) | 30 ( إن الله أمرني أن أسمي المدينة طيبة ) )(@)(@@) ( طب ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5275 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أمرني أن أعلمكم مما علمني وأن أؤدبكم : إذا قمتم على أبواب حجركم فإذكروا اسم الله يرجع الخبيث عن منازلكم ، وإذا وضع بين يدي أحدكم طعام فليسم الله حتى لا يشارككم الخبيث في أرزاقكم ، ومن اغتسل بالليل فليحاذر عن عورته ، فإن لم يفعل فأصابه لمم فلا يلومن إلا نفسه ، ومن بال في مغتسله فأصابه الوسواس فلا يلومن إلا نفسه ، وإذا رفعتم المائدة فاكنسوا ما تحتها ، فإن الشياطين يلتقطون ما تحتها فلا تجعلوا لهم نصيبا في طعامكم ) )(@)(@@) ( الحكيم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5276 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أمرني بحب أربعة وأخبرني أنه PageV02P262 يحبهم : علي منهم ، وأبو ذر ، والمقداد ، وسلمان ) )(@)(@@) ( ت ه ك ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5277 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أمرني بمداراة الناس كما أمرني باقامة الفرائض ) )(@)(@@) ( فر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5278 ) قال النبي :(@)(@@) | 30 ( إن الله أمر يحيى بن زكريا بخمس كلمات أن يعمل بهن ، وأن يأمر بني إسرائيل أن يعملوا بهن ، فكأنه أبطأ بهن ، فأوحى الله إلى عيسى إما أن يبلغهن أو تبلغهن 
ms565	 ، فأتاه عيسى فقال له : إنك أمرت بخمس كلمات أن تعمل بهن وتأمر بني إسرائيل أن يعملوا بهن ، فاما أن تبلغهن وإما أن أبلغهن فقال له : يا روح الله ، إني أخشى إن سبقتني أن أعذب أو يخسف بي ، فجمع يحيى بني إسرائيل في بيت المقدس حتى امتلأ المسجد ، فقعد على الشرفات فحمد الله وأثنى عليه ثم قال : إن الله أمرني بخمس كلمات أن أعمل بهن وآمركم أن تعملوا بهن ، وأولهن : أن تعبدوا الله ولا تشركوا به شيئا ، فإن مثل من أشرك بالله كمثل رجل اشترى عبدا من خالص ماله بذهب أو ورق ، ثم أسكنه دارا فقال : اعمل وارفع إلي ، فجعل العبد يعمل ويرفع إلى غير سيده ، فأيكم يرضى أن يكون عبده كذالك ، وإن الله خلقكم ورزقكم فاعبدوه ولا تشركوا به شيئا ، وأمركم بالصلاة ، وإذا قمتم إلى الصلاة فلا تلتفتوا ، فإن الله عز وجل يقبل بوجهه على عبده ما لم يلتفت ، وأمركم بالصيام ، ومثل ذالك كمثل رجل معه صرة مسك في عصابة ، كلهم يجد ريح المسك ، وإن خلوف فم الصائم أطيب عند الله من ريح المسك ، وأمركم بالصدقة ، ومثل ذالك كمثل رجل أسره العدو فشدوا يديه إلى عنقه وقدموه ليضربوا عنقه ، فقال لهم : هل لكم أن أفتدي نفسي منكم ، فجعل يفتدي نفسه منهم بالقليل والكثير حتى فك نفسه ، وأمركم بذكر الله كثيرا ، ومثل ذالك كمثل PageV02P263 رجل طلبه العدو سراعا في أثره ، فأتى حصنا حصينا فأحرز نفسه فيه ، وإن العبد أحصن ما يكون من الشيطان إذا كان في ذكر الله تعالى وأنا آمركم بخمس أمرني الله بهن : الجماعة ، والسمع والطاعة ، والهجرة والجهاد في سبيل الله ، فإنه من فارق الجماعة قيد سبر فقد خلع ربقة الإسلام من عنقه إلا أن يراجع ، ومن دعا بدعوة الجاهلية فهو من جثاء جهنم ، وإن صام وصلى وزعم أنه مسلم ، فادعوا بدعوة الله التي سماكم بها المسلمين المؤمنين عباد الله ) )(@)(@@) ( حم تخ ت ن حب ك ) عن الحارث بن الحارث الأشعري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5279 ) قال النبي :(@)(@@) | 30 
ms566	 ( إن الله أنزل أربع بركات من السماء إلى الأرض ، فأنزل الحديد ، والنار ، والماء ، والملح ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5280 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أنزل الداء والدواء وجعل لكل داء دواء فتداووا ولا تداووا بحرام ) )(@)(@@) ( د ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5281 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أنزل بركات ثلاثا الشاة ، والنخلة ، والنار ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5282 ) قال النبي :(@)(@@) | 30 ( إن الله أوحى إلى نبي من بني إسرائيل أن أخبر قومك أن ليس عبد يصوم يوما ابتغاء وجهي إلا أصححت جسمه وأعظمت أجره ) )(@)(@@) ( هب ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5283 ) قال النبي :(@)(@@) | 30 ( إن الله أوحى إلي أن أزوج كريمتي من عثمان ) )(@)(@@) ( عد و الخطيب وابن عساكر وابن النجار عن ابن عباس رضي الله عنهما ) وابن عساكر عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5284 ) قال النبي :(@)(@@) | 30 ( إن الله أوحى إلي أن تواضعوا حتى لا يفخر أحددعلى أحد ، ولا يبغي أحد على أحد ) )(@)(@@) ( م د ه ) عن عياض بن حمار رضي الله عنه .(@)(@@) PageV02P264(@)(@@)(@@)(@@) $ ( 5285 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أوحى إلي أن تواضعوا ولا يبغي بعضكم على بعض ) )(@)(@@) ( خد ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5286 ) قال النبي :(@)(@@) | 30 ( إن الله أوحى إلي أنه من سلك مسلكا في طلب العلم سهلت له طريق الجنة ، ومن سلبت كريمتيه أثبته عليهما الجنة ، وفضل في علم خير من فضل في عبادة ، وملاك الدين الورع ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5287 ) قال النبي :(@)(@@) | 30 ( إن الله أوحى إلي أي هاذه الثلاث نزلت فهي دار هجرتك : المدينة أو البحرين أو قنسرين ) )(@)(@@) ( ت ك ) عن جرير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5288 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أيدني بأربعة وزراء ، اثنين من أهل السماء : جبريل وميكائيل ، واثنين من أهل الأرض : أبي بكر وعمر ) )(@)(@@) ( طب حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5289 ) قال النبي :(@)(@@) | 30 ( إن الله أيدني بأشد العرب ألسنا 
