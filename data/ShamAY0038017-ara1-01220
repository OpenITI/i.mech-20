ms1201	 روى عنه خالد بن مخلد القطواني وعباس بن أبي شملة.(@)PageV01P002(@)(@@) [ج 4: ص 254](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن يحنس(@)(@@) يروي عن القاسم بن محمد، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمران الأنصاري(@)(@@) يروي عن أبيه عن ابن عمر، روى عنه محمد بن عمرو بن حلحلة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عون(@)(@@) مولى أم حكيم، يروي عن أبيه، روى عنه عبد العزيز بن عبد الله بن أبي سلمة الماجشون.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيدة الربذي(@)(@@) يروي عن أخيه عبد الله بن عبيدة عن عقبة بن عامر، روى عنه أخوه موسى بن عبيدة الربذي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن المزني(@)(@@) من أهل واسط، يروي عن إسماعيل بن أبي خالد، كتب عنه أحمد بن حنبل والعراقيون، وكان أحمد حسن الرأي فيه، وليس هذا بمحمد بن الحسن بن أبي يزيد ذاك ضعيف.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلام الخزاعي(@)(@@) يروي عن أبيه عن أبي هريرة، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO محمد بن عياش بن عمرو العامري(@)(@@) من أهل الكوفة، يروي عن أبي إسحاق والأعمش، روى عنه عبيد الله بن عبد المجيد الحنفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون بن كعب بن الخزرج الأنصاري(@)(@@) من بلحارث بن الخزرج من أهل المدينة، يروي عن أبيه عن جده، روى عنه محمد بن عبد الله الأنصاري.(@)(@@)(@@)(@@) ||| AUTO محمد بن راشد السلمي(@)(@@) من أهل الكوفة أخو إسماعيل بن راشد، كنية راشد أبو إسماعيل، يروي عن سعيد بن جبير، روى عنه الثوري، مات سنة ثنتين وأربعين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 255](@)(@@)(@@)(@@) ||| AUTO محمد بن معن ابن نضلة الغفاري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه ابن ابنه محمد بن معن ابن محمد بن معن.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن عبد الله(@)(@@) يروي عن طريف البراد عن أبي هريرة، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهاجر(@)(@@) شيخ، يروي عن أبي جعفر محمد بن علي، روى عنه المطلب بن زياد وليس هذا بمحمد بن المهاجر الشامي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي الدرداء(@)(@@) يروي 
ms1202	 عن الشعبي عداده في أهل الكوفة، روى عنه الفريابي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن عبد الله بن حصين التميمي(@)(@@) يروي عن عوف بن الحارث عن أم سلمة، روى عنه محمد بن إسحاق، وكان صواما قواما من المتعبدين.(@)(@@)(@@)(@@) ||| AUTO محمد بن هانئ(@)(@@) شيخ، يروي عن الزهري، روى عنه أبو ثوبان.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهاجر الدمشقي(@)(@@) مولى أسماء بنت يزيد الأشعرية أخو عمرو بن مهاجر، يروي عن أبيه، وكيسان مولى معاوية، روى عنه عبد الله بن يوسف وأهل الشام، مات سنة سبع وثلاثين ومائة وهو ابن أربع وسبعين سنة، وكان متقنا وأخوه عمرو، واه وقد ذكرناه في كتاب الضعفاء.(@)(@@)(@@)(@@) ||| AUTO محمد بن زرارة بن عبد الله بن خزيمة بن ثابت الأنصاري(@)(@@) يروي عن عمارة بن خزيمة عن أبيه، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عميرة(@)(@@) يروي عن أبيه عن عمر وعلي، روى عنه ابن جريج.(@)PageV01P002(@)(@@) [ج 4: ص 256](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن مهران المدني(@)(@@) يروي عن سعيد المقبري، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO محمد بن خلف(@)(@@) شيخ، يروي عن الحسن روى حكام بن سلم الرازي عن عيسى بن يزيد عنه.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عمرة الأزدي(@)(@@) يروي عن سعيد بن جبير، روى عنه معان بن رفاعة.(@)(@@)(@@)(@@) ||| AUTO محمد بن سالم الباهلي(@)(@@) يروي عن حبان السلمي عن ابن عمر، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الديلمي(@)(@@) يروي عن رجل عن معاذ، روى عنه ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله السعدي(@)(@@) يروي المراسيل، روى عنه محمد بن الحسن الأسدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن المهاجر القرشي(@)(@@) يروي عن نافع، روى عنه عبد الرحمن بن مغراء الدوسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الربيع بن كعب البكري(@)(@@) يروي عن الزبرقان بن عبد الله بن مازن عن أبي هريرة، روى عنه إبراهيم بن المنذر الحزامي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الجبار الأنصاري(@)(@@) يروي عن محمد بن كعب عن أبي هريرة، روى عنه شعبة بن الحجاج.(@)PageV01P002(@)(@@) [ج 4: ص 257](@)(@@)(@@)(@@) ||| AUTO محمد بن مرة(@)(@@) يروي عن عبد 
ms1203	 الرحمن بن الأسود عن أبيه، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعد الأنصاري(@)(@@) يروي عن حبيب بن سالم وأبي ظبية، روى عنه هشيم وشريك والكوفيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن أبو عبد الرحمن العدني(@)(@@) يروي عن محمد بن علي وعكرمة، روى عنه روح بن عبادة.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد الأنصاري المدني(@)(@@) يروي عن سعيد بن المسيب، روى عنه أبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون الكندي(@)(@@) يروي عن يحيى اليماني عن أبي طلحة الأنصاري، روى عنه شجاع بن الوليد السكوني.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن والبة(@)(@@) يروي عن سعيد بن جبير، روى عنه زفر بن عبد الرحمن بن أردك.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيينة بن أبي عمران الهلالي(@)(@@) أخو سفيان بن عيينة، يروي عن أبي حازم وكان من العباد عن أبيه، روى عنه نافع بن سليمان.(@)(@@)(@@)(@@) ||| AUTO محمد بن ذكوان السمان(@)(@@) مولى جويرية بنت الأحمس الغطفاني، PageV01P002 [ج 4: ص 258] أخو سهيل بن أبي صالح، يروي عن أبيه، روى عنه نافع بن سليمان وهشيم، يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن عمرو بن عثمان بن عفان أبو عبد الله القرشي المدني(@)(@@) أخو أمية بن عبد الله، يروي عن أمه فاطمة بنت الحسين، روى عنه ابن إسحاق والدراوردي، قتله أبو جعفر المنصور سنة خمس وأربعين ومائة وبعث برأسه إلى خراسان، وفي حديثه عن أبي الزناد بعض المناكير، وكان يقال له: محمد الديباج بجماله.(@)(@@)(@@)(@@) ||| AUTO محمد بن راشد بن أبي سكينة(@)(@@) يروي عن أبيه عداده في أهل مصر، روى عنه حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي سفيان بن العلاء بن جارية(@)(@@) يروي عن يوسف بن الحكم أبي الحجاج بن يوسف عن سعد بن أبي وقاص، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الرقى(@)(@@) يروي عن ميمون بن مهران، روى عنه كثير بن مروان أبو محمد الفلسطيني.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عيينة بن المهلب العتكي المهلبي(@)(@@) من أهل البصرة أخو الحجاج بن أبي عيينة، يروي عن معاوية بن قرة، روى عنه وهب بن جرير 
ms1204	 وموسى بن إسماعيل التبوذكي، وكان شاعرا هجاء، يروي الحكايات، ليس من أهل العلم الذي يرجع إلى روايته ويحكم بما يرويه، ولكني ذكرته ليعلم أن له روايات يرويها.(@)(@@)(@@)(@@) ||| AUTO محمد بن السائب بن بركة(@)(@@) من أهل مكة، يروي عن عمرو بن ميمون عن أبي ذر، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عاصم(@)(@@) شيخ، يروي المراسيل، روى عنه ربيعة بن أبي عبد الرحمن.(@)PageV01P002(@)(@@) [ج 4: ص 259](@)(@@)(@@)(@@) ||| AUTO محمد بن ذكوان الأسدي(@)(@@) يروي عن عبد الرحمن بن عبد الله بن مسعود، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن أبي مريم(@)(@@) مولى لخزاعة وقد قيل: مولى ثقيف، يروي عن سعيد بن المسيب، وأبي سلمة بن عبد الرحمن، روى عنه مالك بن أنس، وحاتم بن إسماعيل، ويحيى بن سعيد القطان، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO محمد بن شريك المكي(@)(@@) يروي عن ابن أبي مليكة، روى عنه أبو نعيم الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميناء(@)(@@) يروي عن عبد العزيز بن مروان، وأهل المدينة، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن نضلة الدؤلي(@)(@@) من أهل المدينة، يروي عن ابن المسيب، والقاسم، وسالم، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO محمد بن دينار الطاحي(@)(@@) من أهل البصرة، يروي عن هشام بن عروة، روى عنه أحمد بن عبدة الضبي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن رويفع(@)(@@) مولى لآل الزبير، يروي عن كريب، روى عنه محمد بن إسحاق.(@)PageV01P002(@)(@@) [ج 4: ص 260](@)(@@)(@@)(@@) ||| AUTO محمد بن زهير(@)(@@) يروي المراسيل والمقاطيع، روى عنه وهيب بن الورد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عياش بن عمرو العامري(@)(@@) يروي عن الأعمش، روى عنه عبيد الله بن عبد المجيد الحنفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن مساحق(@)(@@) يروي عن عامر بن عبد الله بن الزبير، روى عنه فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن القارة(@)(@@) يروي عن أبي على الهمداني، روى عنه محمد بن مخلد الرعيني.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد بن علاقة(@)(@@) يروي عن أبيه، ومنصور بن المعتمر، روى عنه المفضل بن 
ms1205	 يونس.(@)(@@)(@@)(@@) ||| AUTO أبو حمزة السكري اسمه محمد بن ميمون(@)(@@) من أهل مرو، يروي عن أبي إسحاق، وعبد الملك بن عمير والشيباني، روى عنه علي بن الحسن بن شقيق، وأهل بلده، مات سنة سبع أو ثمان وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن معدان(@)(@@) يروي عن الحسن عداده في أهل البصرة، روى عنه التبوذكي والبصريون.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن المسيب(@)(@@) يروي عن أبيه، روى عنه عبيد الله بن عمر العمري، وابنه عمران بن محمد.(@)PageV01P002(@)(@@) [ج 4: ص 261](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن كثير بن الصلت الكندي(@)(@@) من أهل المدينة، يروي عن نافع والزهري، روى عنه عبد العزيز بن أبي سلمة وخالد بن مخلد القطواني.(@)(@@)(@@)(@@) ||| AUTO أبو عمرو(@)(@@) الذي يروي عن أبيه، عن أبي هريرة " أفطر الحاجم والمحجوم "، اسمه محمد بن ميسرة بن عبد الرحمن القرشي القاضي من أهل الكوفة والد أسباط بن محمد، روى عنه سليمان التيمي وسفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO محمد بن راشد(@)(@@) يروي عن ابن سيرين وكان مولى لباهلة، روى عنه سليمان الجرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن ثابت العتواري(@)(@@) يروي عن أبيه، عن ابن عمر، روى عنه فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي رزين(@)(@@) يروي عن أبيه، روى عنه سليمان بن حرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن قيس المكي(@)(@@) يروي عن عمرو بن قيس السكري، روى عنه هشام بن حسان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله المرادي الجملي(@)(@@) من أهل الكوفة، يروي عن عمرو بن مرة، روى عنه شريك، وأبو بكر النهشلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن شريك أبو عثمان المكي(@)(@@) يروي عن ابن أبي مليكة وعمرو بن دينار، روى عنه أبو نعيم الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى(@)(@@) مولى بني هاشم، يروي عن سعيد بن المسيب، روى عنه مروان بن محمد الطاطري.(@)PageV01P002(@)(@@) [ج 4: ص 262](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن طلحة الحجبي(@)(@@) من بني عبد الدار، يروي عن جدته صفية بنت شيبة عن عائشة، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى بن عبد الله بن يسار(@)(@@) يروي عن أبي عبد 
ms1206	 الله القراظ عداده في أهل المدينة، روى عنه أبو ضمرة أنس بن عياض.(@)(@@)(@@)(@@) ||| AUTO محمد بن رفاعة بن ثعلبة بن أبي مالك القرظي(@)(@@) من أهل المدينة، يروي عن أبيه، ومحمد بن كعب القرظي، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن الأوقص المخزومي القرشي(@)(@@) يروي عن علي بن زيد بن جدعان، روى عنه معن ابن عيسى.(@)(@@)(@@)(@@) ||| AUTO محمد بن نجيد بن عمران بن حصين الخزاعي(@)(@@) يروي عن أبيه، روى عنه ابن يعقوب بن محمد.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن عبد الملك بن مروان(@)(@@) يروي المقاطيع عن أهل المدينة، روى عنه إسماعيل بن رافع المدني.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى أبو مالك العتري(@)(@@) من أهل الكوفة، يروي عن الهزهاز بن ميزن، روى عنه بشر بن الحكم.(@)(@@)(@@)(@@) ||| AUTO محمد بن شيبة بن نعامة الضبي(@)(@@) يروي عن أبي إسحاق، والكوفيين، روى عنه أبو معاوية، وجرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى اليمامي(@)(@@) يروي عن حفص الأنصاري عن أنس، روى عنه عمر بن يونس اليمامي.(@)PageV01P002(@)(@@) [ج 4: ص 263](@)(@@)(@@)(@@) ||| AUTO محمد بن هشام بن عروة بن الزبير بن العوام(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه ابن أبي عدى، مستقيم الحديث جدا.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن صفوان بن أمية الجمحي القرشي(@)(@@) من أهل الحجاز، يروي عن هشام بن عروة، روى عنه أحمد بن حنبل وإبراهيم بن حمزة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن يزيد بن غنج(@)(@@) من أهل المدينة، يروي عن نافع بنسخة مستقيمة، روى عنه الليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن رباح(@)(@@) يروي عن أبيه عن أبي هريرة، روى عنه موسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن زيد العبدي قاضي مرو(@)(@@) يروي عن سعيد بن المسيب، وسعيد بن جبير، روى عنه داود بن الفرات وعلي بن الحكم والبصريون وهو الذي، يروي عنه عبد الرحمن بن إسحاق المدني.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن فروة(@)(@@) يروي عن الزهري، روى عنه محمد بن فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن 
ms1207	 عبد الرحمن بن عنبسة بن سعيد بن العاص الأموي القرشي(@)(@@) يروي المقاطيع، روى عنه الليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO محمد بن حدير بن أبي زكريا التميمي(@)(@@) يروي عن شيخ له عن أنس، روى عنه مروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO محمد بن سهم(@)(@@) يروي عن سعيد بن المسيب، روى عنه يحيى بن راشد ورشدين بن سعد.(@)PageV01P002(@)(@@) [ج 4: ص 264](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله التميمي(@)(@@) يروي عن علي بن زيد بن جدعان، روى عنه شبابة بن سوار.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله العمى(@)(@@) من أهل البصرة، يروي عن ثابت البناني، روى عنه أبو النضر هاشم بن القاسم، وسأل عنه ابن علية، فقال: هو من جلساء أيوب.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي موسى بن أبي عياش(@)(@@) يروي عن عطاء بن يسار، روى عنه أبو أويس.(@)(@@)(@@)(@@) ||| AUTO محمد بن حمزة بن يوسف بن عبد الله بن سلام(@)(@@) من أهل المدينة، يروي عن أبيه، عن جده يوسف وله صحبة، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO محمد بن زيد أبو عبد الله المكي(@)(@@) يروي عن عبد الله بن عثمان بن خثيم، وقد سمع عبد الله أبا الطفيل، روى عنه ابن أبي فديك، وأهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن أبان القرشي كنيته أبو عبد الله(@)(@@) عم سعيد بن يحيى الأموي، وهو أخو عبيد وعنبسة ويحيى بن سعيد بن أبان، أصله من الكوفة، سكن بغداد، يروي عن عبد الملك بن عمير والكوفيين، روى عنه ابن أخيه سعيد بن يحيى الأموي، مات سنة ثلاث وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن مطرف أبو غسان الليثي(@)(@@) أصله من المدينة، سكن عسقلان، يروي عن زيد بن أسلم وأبي حازم، روى عنه ابن المبارك وابن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO محمد بن مزاحم أبو مجاهد(@)(@@) من أهل مرو، يروي عن أبي الزبير محمد بن PageV01P002 [ج 4: ص 265] زياد القرشي، روى عنه علي بن الحسن بن شقيق، وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي موسى(@)(@@) يروي عن عبد الله بن عبد الرحمن عن علي، روى عنه شريك بن عبد الله النخعي. 
ms1208	(@)(@@)(@@)(@@) ||| AUTO محمد بن السائب بن أبي هندية الثقفي(@)(@@) يروي عن أبيه عن عمر، روى عنه سعيد بن السائب.(@)(@@)(@@)(@@) ||| AUTO محمد بن مروان العقيلي(@)(@@) يروي عن همام بن عروة، روى عنه جميل بن الحسن العتكي، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن عروة بن الزبير بن العوام(@)(@@) يروي عن عبد الله بن عبد الرحمن الأنصاري، روى عنه عبد الرزاق.(@)(@@)(@@)(@@) ||| AUTO محمد بن قيس الأسدي(@)(@@) من أهل الكوفة، كنيته أبو قدامة، وقد قيل: أبو نصر، روى عن علي بن ربيعة والشعبي، روى عنه الثوري، ووكيع وكان من المتقنين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز بن عمارة(@)(@@) يروي المراسيل، روى عنه محمد بن مسلم الطائفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن هلال(@)(@@) يروي عن سالم بن عبد الله عن أبيه، عن النبي صلى الله عليه وسلم: " المسلم أخو المسلم لا يظلمه عند حقه ولا يخذله عند المصيبة تنزل به ". روى عنه زياد بن يونس الإسكندراني وهو الذي، يروي عن سعد بن إسحاق بن كعب بن عجرة عن أبيه عن جده، عن النبي صلى الله عليه وسلم قال: " من أدرك رمضان فلم يغفر له. " نحو حديث أبي سلمة بن وردان، عن أنس، وأبي سلمة، عن أبي هريرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن مزاحم(@)(@@) أخو الضحاك بن مزاحم، يروي عن الحسن بن محمد بن PageV01P002 [ج 4: ص 266] علي بن أبي طالب، روى عنه أبو مالك الأشجعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن النعمان(@)(@@) شيخ، يروي عن طلحة بن مصرف، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن رويفع(@)(@@) مولى آل الزبير بن العوام من أهل المدينة، وأمه مولاة رافع بن خديج، يروي عن كريب، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد الطائفي(@)(@@) يروي عن طاوس وعطاء، وعبد العزيز بن عبد الملك بن أبي محذورة، روى عنه الثوري والمعتمر بن سليمان، وهو الذي، يروي عنه يحيى بن سليم، ويقول: حدثني أبو سعيد المؤذن.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن يزيد النخعي أبو جعفر الكوفي(@)(@@) يروي عن أبيه، روى عنه سلمة بن كهيل ومنصور 
ms1209	 بن المعتمر.(@)(@@)(@@)(@@) ||| AUTO محمد المحرم(@)(@@) شيخ، يروي عن عطاء والحسن، روى عنه شبابة بن سوار.(@)(@@)(@@)(@@) ||| AUTO محمد بن يسار الخراساني(@)(@@) يروي عن قتادة، أصله في البصرة، سكن مرو، وكنيته أبو اليعوق ثم يكنى بأبي عبد الله، روى عنه عبد الله بن المبارك، وهم أخوة ثلاثة محمد بن يسار، وسلمة بن يسار، وعبد الله بن يسار مراوزة، ثقات كلهم.(@)(@@)(@@)(@@) ||| AUTO محمد بن نوح(@)(@@) يروي عن الحسن، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعقوب الزمعي القرشي(@)(@@) يروي عن عبد الله بن رافع، روى عنه أخوه موسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز الراسبي(@)(@@) يروي عن عبيد الله بن أبي بكر بن(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 4: ص 267] أنس عن أنس، روى عنه أبو أحمد الزبيري ومحمد بن عبيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن نشيط الفارسي كنيته أبو النعمان(@)(@@) وقد قيل: ابن نشيط، يروي عن الحسن، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان أبو ضمرة النصري(@)(@@) من أهل الشام، يروي عن عبد الله بن أبي قيس عن عائشة، وراشد بن سعد عن أبي أمامة، وهو الذي يقال له: محمد بن أبي جميلة، روى عنه الليث بن سعد، ويحيى بن صالح الوحاظي، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن خشيش بن حماد أبو عمر(@)(@@) مولى بني قيس بن ثعلبة، يروي عن عكرمة بن عمار، روى عنه البصريون وعكرمة سمع الهرماس بن زياد له صحبة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف(@)(@@) مولى عثمان بن عفان، يروي عن أبيه، روى عنه بكير بن الأشج، وابن جريج.(@)(@@) محمد(@)(@@) مولى بني تميم، يروي عن أبي طلحة الكوفي عن ابن عباس، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن رداد بن عبد الله بن شريح بن مالك القرشي(@)(@@) من أهل المدينة، يروي عن يحيى بن سعيد الأنصاري، روى عنه إسماعيل بن أبي أويس كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن نافع بن عجير بن عبد يزيد بن هاشم(@)(@@) يروي عن أبيه عن علي، روى عنه يزيد بن عبد الله بن الهاد. 
ms1210	(@)(@@)(@@)(@@) ||| AUTO محمد بن عامر الأنصاري(@)(@@) يروي عن عطاء، روى عنه محمد بن يزيد.(@)PageV01P002(@)(@@) [ج 4: ص 268](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي سفيان الجمحي القرشي(@)(@@) أخو حنظلة بن أبي سفيان، يروي عن الحجازيين، روى عنه أبو عمر مولى بني أمية.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي المليح(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه البصريون واسم أبي المليح عامر بن أسامة بن عمير الهذلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي المقدام(@)(@@) يروي عن الزهري، روى عنه الأوزاعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي الجعفي(@)(@@) أخو حسين بن علي الجعفي، يروي عن محمد بن أبي إسماعيل عن أنس، روى عنه أخوه حسين بن علي الجعفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعدان بن حيان(@)(@@) يروي عن يزيد بن أبي عبيد عن سلمة بن الأكوع، روى عنه محمد بن عمر بن علي بن أبي بكر الكتاني من حديث أبي حاتم الرازي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن العكي(@)(@@) قوله، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي السلمي(@)(@@) من أهل الكوفة، يروي عن عبد الله بن محمد بن عقيل، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO محمد بن أيوب بن ميسرة بن حلبس الجبلاني(@)(@@) يروي عن أبيه عن بشر بن أرطأة، روى عنه الهيثم بن خارجة وهشام بن عمار.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي مريم الطائفي(@)(@@) يروي عن الزهري، روى عنه الفضل بن موسى السيناني.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي النوار(@)(@@) من أهل البصرة، يروي عن عبد الرحمن بن أبي PageV01P002 [ج 4: ص 269] بكرة، روى عنه شعبة، وعون بن كهمس.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد الثقفي(@)(@@) مولى المغيرة بن شعبة، يروي عن كعب بن علقمة، روى عنه أبو بكر بن عياش، وكان قدم عليهم الكوفة فكتبوا عنه.(@)(@@)(@@)(@@) ||| AUTO محمد بن نصير أبو نصير(@)(@@) يروي عن حبيب بن أبي ثابت، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي النوار(@)(@@) يروي عن بريد بن أبي مريم، روى عنه النضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO محمد بن السائب بن بشر(@)(@@) يروي عن عمرو بن عبد الله الحضرمي، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO محمد 
ms1211	 بن يوسف بن عبد الله بن يزيد(@)(@@) بن أخت نمر وكانت أمه بنت السائب بن يزيد، يروي عن المدنيين، وقد أدرك السائب بن يزيد، روى عنه مالك بن أنس وداود بن قيس.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة بن الأخنس(@)(@@) يروي عن سعيد بن المسيب، روى عنه الحجاج بن أرطأة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف الدمشقي(@)(@@) يروي عن قبيصة بن ذؤيب عن عبد الرحمن بن عوف، روى عنه أبو مرحوم.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن محذورة(@)(@@) يروي عن أبيه عن جده، روى عنه الثوري.(@)PageV01P002(@)(@@) [ج 4: ص 270](@)(@@)(@@)(@@) ||| AUTO محمد بن نشر الهمداني(@)(@@) يروي عن ابن الحنفية، روى عنه ليث بن أبي سليم.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان أبو ضمرة الشامي(@)(@@) يروي عن راشد بن سعد، عن أبي أمامة، قال: " رأيت النبي صلى الله عليه وسلم في حجة الوداع على بغلة شهباء يقوده خالد بن الوليد ". روى عنه عثمان بن سعيد بن كثير بن دينار.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح التمار(@)(@@) من أهل المدينة، يروي عن الزهري، روى عنه عبد الله بن نافع الصائغ.(@)(@@)(@@)(@@) ||| AUTO محمد بن السائب النكري(@)(@@) يروي عن سعيد بن عمرو بن سعيد بن العاص المراسيل، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO محمد بن معمر الغفاري(@)(@@) يروي عن عمارة بن الصياد عن جابر، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن مروان القرشي(@)(@@) يروي عمن سمع معاوية عن معاوية، روى عنه حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهران(@)(@@) يروي عن أبيه المراسيل، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي سدرة(@)(@@) يروي عن المدنيين وعمر بن عبد العزيز، روى عنه عطاء بن مسلم الحلبي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد بن عفيف(@)(@@) يروي عن أم الدرداء، روى عنه زيد بن واقد الدمشقي.(@)PageV01P002(@)(@@) [ج 4: ص 271](@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون الأسدي(@)(@@) كوفي، يروي عن يحيى بن سعيد الأنصاري الأعمال بالنية، روى عنه منصور بن أبي نويرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن مغيث(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه الأجلح.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد(@)(@@) شيخ، 
ms1212	 يروي عن أبيه عن علي، روى عنه مجاعة بن الزبير العتكي لست أعرف أباه.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمارة بن خزيمة بن ثابت الأنصاري(@)(@@) يروي عن أبيه، عن خزيمة، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمار بن محمد بن عمار بن سعد القرظ(@)(@@) يروي عن جده محمد بن عمار عن أبي هريرة، روى عنه سعيد بن عبد الجبار.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمار بن حفص بن عمر بن سعد القرظ أبو عبد الله(@)(@@) يروي عن شريك بن أبي نمر، روى عنه الحجبي وعلي بن حجر، وكان ممن يخطئ ويتفرد.(@)(@@)(@@)(@@) ||| AUTO محمد بن محرز الضبي(@)(@@) يروي عن عبد الله بن أبي راشد عن أبي بردة، روى عنه محمد بن عيسى بن الطباع.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن أبي حفص العطار الأنصاري(@)(@@) يروي عن السدى، روى عنه عفيف بن سالم وأبو نعيم، كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن المنذر بن الزبير بن العوام أبو زيد(@)(@@) من أهل المدينة، يروي عن هشام بن عروة، روى عنه إبراهيم بن المنذر الحزامي ربما أخطأ.(@)PageV01P002(@)(@@) [ج 4: ص 272](@)(@@)(@@)(@@) ||| AUTO محمد بن وهب(@)(@@) يروي عن عاصم بن عمر، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن عبد الرحمن بن سعيد بن يربوع المخزومي القرشي(@)(@@) من أهل المدينة، يروي عن جده وسالم بن عبد الله، روى عنه حاتم بن إسماعيل، والدراوردي، وهو الذي، قال: سألت القاسم بن محمد عن المستحاضة، فقال: " تدع الصلاة قدر قرءها التي كانت تحيض ".(@)(@@)(@@)(@@) ||| AUTO محمد بن عمارة(@)(@@) وقد قيل: عبادة، يروي عن المدنيين، وقد أدرك محمود بن الربيع، روى عنه السكن بن أبي كريمة.(@)(@@)(@@)(@@) ||| AUTO محمد بن مقسم المدني(@)(@@) يروي عن زيد بن أسلم، روى عنه كثير بن هشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر الديلي(@)(@@) يروي عن نعيم المجمر، روى عنه أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO محمد بن هلال بن أبي هلال المدني المذحجي(@)(@@) حليف بني جمح بن عمرو، يروي عن أبيه عن أبي هريرة، روى عنه إسماعيل بن أبي أويس.(@)(@@)(@@)(@@) ||| AUTO محمد 
ms1213	 بن عبد الواحد بن قيس أبو بكر الأفطس(@)(@@) يروي عن أبيه، عن أبي أمامة، روى عنه عمرو بن بكر السكسكي يعتبر حديثه من غير رواية عمرو عنه فإن عمرا يكذب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان الواسطي(@)(@@) يروي عن ثابت البناني، روى عنه أبو عوانة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن حبان بن منقذ المازني الأنصاري(@)(@@) من أهل المدينة، كنيته أبو عبد الله، يروي عن عمه واسع بن حبان، روى عنه الزهري، ومالك بن أنس، وأهل المدينة. مات سنة إحدى وعشرين ومائة، وهو ابن أربع وسبعين سنة، وأمه أم العلاء بنت عباد بن سلكان ابن سلامة.(@)PageV01P002(@)(@@) [ج 4: ص 273](@)(@@)(@@)(@@) ||| AUTO محمد بن النعمان(@)(@@) يروي عن طلحة بن مصرف، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن مسمول(@)(@@) يروي عن القاسم بن مخول عن أبيه وله صحبة، روى عنه محمد بن عباد المكي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد المكي(@)(@@) يروي عن مجاهد، روى عنه نافع بن يزيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر(@)(@@) شيخ، يروي عن الحسن، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر بن أبي كثير المدني(@)(@@) أخو إسماعيل بن جعفر، يروي عن أبي حازم، روى عنه الناس.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن عبيد أبو سهل الأنصاري(@)(@@) يروي عن أبيه، وابن سيرين والقاسم، روى عنه ابن المبارك، ومعن ابن عيسى يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن وارد(@)(@@) وقد قيل: وردان، يروي عن مكحول، روى عنه معان بن رفاعة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن أبي عبيدة الأسدي(@)(@@) يروي عن الحارث العكلي، روى عنه مروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن عثمان العبسي(@)(@@) والد أبي بكر وعثمان والقاسم بن أبي شيبة، يروي عن الأعمش والكوفيين، روى عنه أهل بلده، مات سنة ثنتين وثمانين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 274](@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن أبي عيسى بن أبي عدى(@)(@@) مولى بني سليم، كنيته أبو عمرو كان أبوه يكنى أبا عدى، وكان محمد ينزل القساملة بالبصرة، يروي عن حميد الطويل، روى عنه أهل العراق، مات سنة أربع وتسعين ومائة 
ms1214	 يوم الإثنين لعشر بقين من ربيع الآخر.(@)(@@)(@@)(@@) ||| AUTO محمد بن وهب أبو يوسف اليمنى(@)(@@) من الأبناء، يروي عن وهب بن منبه، روى عنه أحمد بن حنبل، مات قريبا من سنة ثمانين، وكان قد رأى همام بن منبه ولم يسمع منه، قال أبو حاتم رضى الله تعالى عنه: وكان ممن ولد باليمن من أبناء الفرس يسمونهم الأبناء.(@)(@@)(@@)(@@) ||| AUTO محمد بن فليح بن سليمان أبو عبد الله الأسلمي(@)(@@) من أهل المدينة، يروي عن الزهري، روى عنه إبراهيم بن المنذر الحزامي، مات في ذي القعدة سنة سبع وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن بشر بن الفرافصة أبو عبد الله الكوفي العبدي(@)(@@) من عبد القيس، يروي عن إسماعيل بن أبي خالد، روى عنه ابن أبي شيبة، مات سنة ثلاث ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد الطنافسي أبو عبد الله الكوفي الأيادي الأحدب(@)(@@) يروي عن الأعمش، وابن أبي خالد، مات في ذي القعدة سنة ثلاث ومائتين، وقد قيل: سنة خمس ومائتين في ذي القعدة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الزبرقان أبو همام الأهوازي(@)(@@) يروي عن هشام بن PageV01P002 [ج 4: ص 275] عروة، روى عنه علي بن المديني والناس، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن حمير أبو عبد الله السليحي(@)(@@) وسليح من قضاعة من أهل حمص، يروي عن إبراهيم بن أبي عبلة، روى عنه عمرو بن عثمان، وأهل الشام، مات في صفر سنة مائتين.(@)(@@)(@@)(@@) ||| AUTO أبو معاوية الضرير اسمه محمد بن خازم السعدي التميمي(@)(@@) مولى لهم من أهل الكوفة، يروي عن الشيباني وابن أبي خالد، روى عنه أحمد ويحيى، وأهل العراق، وكان مولده سنة ثلاث عشرة ومائة، ومات في آخر صفر سنة خمس وتسعين ومائة، وكان حافظا متقنا ولكنه كان مرجئا.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الكلاعي(@)(@@) من أهل واسط، كنيته أبو سعيد سمع الأعمش، مات سنة ثمان وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن الطفاوي(@)(@@) من أهل البصرة، كنيته أبو عبد الرحمن، وكان مولى بني ضبة، يروي عن يحيى بن سعيد الأنصاري والأعمش، روى عنه أحمد بن حنبل، وأهل العراق، مات سنة خمس 
ms1215	 وتسعين ومائة، وكان يغلو في التشيع.(@)(@@)(@@)(@@) ||| AUTO محمد بن بكر البرساني أبو عبد الله(@)(@@) من أهل البصرة، PageV01P002 [ج 4: ص 276] يروي عن جماعة من التابعين، روى عنه الناس، مات في ذي الحجة سنة ثلاث ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الوهاب القناد(@)(@@) أخو فضيل بن عبد الوهاب كنيته أبو يحيى، وكان أصله من أصبهان وولاءه لآل ثعلبة بن قيس سكن الكوفة، يروي عن إسماعيل بن أبي خالد والشيباني، روى عنه هارون بن إسحاق الهمداني وأهل العراق، مات سنة ثنتي عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن ربيعة الكلابي(@)(@@) يروي عن الأعمش، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن كناسة الأسدي(@)(@@) من أهل الكوفة كنيته أبو يحيى، يروي عن إسماعيل بن أبي خالد، روى عنه ابن أبي شيبة والكوفيون، مات سنة تسع ومائتين، وهو ابن أخت إبراهيم بن أدهم الزاهد فيما يقال.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد الطحان(@)(@@) كوفي، يروي عن الأعمش، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن المثنى بن عبد الله بن أنس بن مالك القاضي(@)(@@) من أهل البصرة كنيته أبو عبد الله، ولى القضاء بالبصرة بعد معاذ بن معاذ، يروي عن سليمان التيمي وحميد الطويل، روى عنه أبو الربيع الزهراني، مات بالعراق سنة خمس عشرة ومائتين في رجب.(@)PageV01P002(@)(@@) [ج 4: ص 277](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO مسلم بن سبرة بن المسيب بن نجبة الفزاري(@)(@@) يروي عن عمته بنت المسيب، وكانت تحت حذيفة، روى عنه زر الهمداني.(@)(@@)(@@)(@@) ||| AUTO مسلم بن نطاس(@)(@@) يروي عن عبيدة السلماني وأبي البختري، روى عنه يحيى بن ميسرة.(@)(@@)(@@)(@@) ||| AUTO مسلم بن عقيل: ابن حنظلة المحاربي(@)(@@) يروي عن أبيه، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO مسلم بن عطية الفقيمي(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه بدر بن الخليل.(@)(@@)(@@)(@@) ||| AUTO مسلم بن أبي سهل النبال(@)(@@) يروي عن حسن بن أسامة بن زيد عن أبيه، عن النبي صلى الله عليه وسلم: " اللهم إني أحبهما فأحبهما " عداده في أهل المدينة، روى عنه عبد الله بن أبي بكر، وهو أخو موسى بن 
ms1216	 أبي سهل النبال.(@)(@@) مسلم(@)(@@) مولى أبي الرجال من أهل المدينة، يروي عن سعيد بن المسيب، روى عنه عبد العزيز بن أبي حازم.(@)(@@)(@@)(@@) ||| AUTO مسلم بن الحارث الجملي(@)(@@) يروي المراسيل، روى عنه عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO مسلم بن حيان الهمداني(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO مسلم بن سليم(@)(@@) يروي عن أزهر بن عبد الله والشاميين، روى عنه الوليد بن سليمان بن أبي السائب.(@)PageV01P002(@)(@@) [ج 4: ص 278](@)(@@)(@@)(@@) ||| AUTO مسلم بن زائدة السلولي(@)(@@) يروي عن عبد الرحمن بن خالد بن الوليد، روى عنه أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO مسلم بن شداد(@)(@@) يروي عن عبيد بن عمير، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO مسلم أبو صادق الأزدي(@)(@@) من أهل الكوفة، يروي عن ربيعة بن ناجد، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO مسلم بن شعبة(@)(@@) ويقال: ثفنة، يروي عن عمرو بن أبي سفيان، روى عنه العراقيون، وأهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO مسلم بن أبي عمران البطين(@)(@@) وقد قيل: مسلم بن عمران كنيته أبو عبد الله من أهل الكوفة، يروي عن سعيد بن جبير، وأبي العبيدين، روى عنه ابن عون وسلمة بن كهيل والأعمش.(@)(@@)(@@)(@@) ||| AUTO مسلم بن طهمان أبو سلمة(@)(@@) يروي عن قتادة، قال: سمعته يقول في هذه الآية كلا لا وزر إلى ربك يومئذ المستقر يقول لا حرز، روى عنه أبو تميلة يحيى بن واضح.(@)(@@)(@@)(@@) ||| AUTO مسلم بن الوليد(@)(@@) يروي عن أبيه، عن أبي هريرة، روى عنه ابن الهاد والدراوردي.(@)(@@)(@@)(@@) ||| AUTO مسلم بن عطاء أبو عتاب(@)(@@) يروي عن الحسن، روى عنه حماد بن سلمة.(@)PageV01P002(@)(@@) [ج 4: ص 279](@)(@@)(@@)(@@) ||| AUTO مسلم بن عبد الله بن عون(@)(@@) يروي عن إبراهيم التيمي، روى عنه ابن عون.(@)(@@)(@@)(@@) ||| AUTO مسلم بن عطاء(@)(@@) يروي عن طاوس، روى عنه إبراهيم بن نافع وليس هذا بالأول الذي ذكرناه.(@)(@@)(@@)(@@) ||| AUTO مسلم بن أبي عطية(@)(@@) يروي عن جمرة السدوسية عن عائشة، روى عنه يحيى بن أبي يحيى.(@)(@@)(@@)(@@) ||| AUTO مسلم بن مخراق القرى(@)(@@) مولى بني قرة حي من عبد القيس، يروي المراسيل، روى عنه ابن عون.(@)(@@)(@@)(@@) ||| AUTO مسلم 
ms1217	 بن قرط(@)(@@) يروي عن عروة بن الزبير عداده في أهل الحجاز، روى عنه أبو حازم.(@)(@@)(@@)(@@) ||| AUTO مسلم بن مسلم بن معبد(@)(@@) يروي عن عبيد بن السباق، روى عنه حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO مسلم بن يسار(@)(@@) مولى الأنصار، وقد قيل: مولى آل عثمان، أحسبه الذي يقال له: الطنبذي، فإن كان ذاك، فقد ذكرناه في التابعين، يروي عن سعيد بن المسيب، روى عنه يحيى بن سعيد الأنصاري والإفريقي.(@)(@@)(@@)(@@) ||| AUTO مسلم بن أبي مريم(@)(@@) مولى لبني سليم من أهل المدينة، يروي عن والمدنيين، روى عنه مالك والثوري وابن عيينة، مات في ولاية أبي جعفر، علي بن عبد الرحمن المعاوي.(@)(@@) (430) -[4: 279] حدثنا عمر بن محمد الهمداني، ثنا زيد بن أخزم، ثنا أبو عامر العقدي، ثنا كثير بن زيد، عن مسلم بن أبي مريم، عن نافع، عن ابن عمر: " أنه كان يضع يده اليمنى على ركبته اليمنى ويده اليسرى على ركبته اليسرى ويشير بإصبعه ولا يحركها، ويقول: إنها مذبة الشيطان، ويقول: كان رسول الله صلى الله عليه وسلم يفعله "(@)PageV01P002(@)(@@) [ج 4: ص 280](@)(@@)(@@)(@@) ||| AUTO مسلم بن سكرة(@)(@@) يروي المقاطيع، روى عنه سفيان بن عيينة.(@)(@@)(@@)(@@) ||| AUTO مسلم بن خالد الزنجي أبو عبد الله المكي(@)(@@) يروي عن عمرو بن دينار، روى عنه ابن المبارك والشافعي، وكان أبيض مشربا بحمرة فلذلك قيل زنجي، مات سنة تسع وسبعين ومائة، وقد قيل: سنة ثمانين ومائة، من فقهاء أهل الحجاز، ومنه تعلم الشافعي الفقه، وإياه كان يجالس قبل أن يلقى مالك بن أنس، وكان مسلم يخطئ أحيانا.(@)(@@)(@@)(@@) ||| AUTO موسى بن عمرو بن سعيد بن العاص القرشي الأموي(@)(@@) من أهل مكة، يروي عن الحجازيين، روى عنه ابنه أيوب بن موسى.(@)(@@)(@@)(@@) ||| AUTO موسى الجهني هو موسى بن عبد الله(@)(@@) وقد قيل: موسى بن عبد الرحمن من أهل الكوفة، يروي عن زيد بن وهب ومصعب بن سعد، روى عنه أهل العراق، مات سنة أربع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO موسى بن عبد الله بن إسحاق بن طلحة بن عبيد الله التيمي(@)(@@) يروي عن سعيد بن جبير، روى عنه 
ms1218	 أبو أسامة، ووكيع.(@)(@@)(@@)(@@) ||| AUTO موسى بن عمرو بن عبد الله بن أبي حرام النجاري الأنصاري(@)(@@) أحد بني دينار، PageV01P002 [ج 4: ص 281] يروي عن حمزة بن أبي أسيد عن أبيه، روى عنه أبو أويس.(@)(@@)(@@)(@@) ||| AUTO موسى بن إبراهيم بن كثير بن بشير بن الفاكهة الأنصاري(@)(@@) من أهل المدينة، يروي عن طلحة بن خراش عن جابر، روى عنه إبراهيم بن المنذر كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO موسى بن أيوب الغافقي(@)(@@) من أهل مصر، يروي عن عمه إياس بن عامر.(@)(@@)(@@)(@@) ||| AUTO موسى بن بليدان(@)(@@) يروي عن القاسم بن محمد، روى عنه عبد الحميد بن واصل.(@)(@@)(@@)(@@) ||| AUTO موسى بن مناح(@)(@@) يروي عن القاسم بن محمد، روى عنه عبد الواحد بن أبي عون.(@)(@@)(@@)(@@) ||| AUTO موسى بن رستم(@)(@@) من أهل الكوفة، يروي عن الحكم بن عتيبة، روى عنه وكيع والكوفيون.(@)(@@)(@@)(@@) ||| AUTO موسى بن عمران بن مناح(@)(@@) يروي عن أبان بن عثمان عن عثمان، روى عنه إسماعيل بن أمية، كان الأول نسبه ههنا بن عمران بن مناح وفي الذي قبله نسبه إلى جده والله أعلم بمعنى خط بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي إسحاق الأنصاري(@)(@@) يروي عن أبي طوالة، روى عنه عمرو بن الحارث.(@)PageV01P002(@)(@@) [ج 4: ص 282](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO موسى بن أبي بكر بن عبد الله بن الحارث بن الطفيل(@)(@@) يروي عن القاسم بن محمد، روى عنه سهل بن حماد.(@)(@@)(@@)(@@) ||| AUTO موسى بن ثروان العجلي(@)(@@) يروي عن طلحة بن عبيد الله بن كريز، روى عنه ابن أبي وهب ووكيع، وهو الذي يروي عنه النضر بن شميل، ويقول حدثنا موسى بن سروان وهو المعلم.(@)(@@)(@@)(@@) ||| AUTO موسى بن جميل(@)(@@) يروي عن أبي روح، روى عنه هشام الدستوائي.(@)(@@) موسى بن أبي بكر(@)(@@) يروي عن القاسم بن محمد، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي حملة الغافقي(@)(@@) من أهل مصر، يروي عن عمران بن عوف الغافقي عن ابن عمر، روى عنه ابن وهب.(@)(@@)(@@)(@@) ||| AUTO موسى بن جبير المدني(@)(@@) مولى بني سلمة، يروي عن عروة بن الزبير ونافع، وأبي أمامة بن سهل، روى 
ms1219	 عنه بكر بن مضر ويحيى بن أيوب، وزهير بن محمد العنبري، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO موسى بن السائب كنيته أبو سعدة(@)(@@) كان يسكن واسط، يروي عن قتادة، روى عنه هشيم، وأبو عوانة.(@)(@@)(@@)(@@) ||| AUTO موسى بن داود أبو حاتم(@)(@@) صاحب اللؤلؤ، يروي عن طاوس والحسن، روى عنه ابن المبارك، وحبان بن هلال.(@)(@@)(@@)(@@) ||| AUTO موسى بن زياد بن عمرو بن حذيم السعدي(@)(@@) يروي المراسيل، روى عنه المغيرة بن مقسم.(@)PageV01P002(@)(@@) [ج 4: ص 283](@)(@@)(@@)(@@) ||| AUTO موسى بن عبد الرحمن بن صفوان بن قدامة المري(@)(@@) يروي عن أبيه عن جده، أنه أتى النبي صلى الله عليه وسلم فبايعه، فسمعه يقول: " المرء مع من أحب ". روى عنه ميمون بن موسى.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي سهل النبال(@)(@@) يروي عن زبيد بن الصلت، عن عثمان، أنه قال: " أيها الناس إياكم والميسر ". روى عنه الجعيد بن عبد الرحمن، وعبد الأعلى بن عبد الله، وهو الذي يروي عن الحسن بن أسامة بن زيد، عن أبيه.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي مروان أبو العريان المروزي(@)(@@) قال: سمعت عكرمة، يقول: " البراذين السهب التي لا تردف من مراكب آل فرعون ". روى عنه الفضل بن موسى السيناني.(@)(@@)(@@)(@@) ||| AUTO موسى بن سالم أبو جهضم(@)(@@) مولى العباس بن عبد المطلب، يروي عن عبيد الله بن عبد الله، روى عنه الثوري وحماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO موسى بن شداد(@)(@@) يروي عن عمرو بن ثابت، روى عنه المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO موسى بن شيبة الحضرمي(@)(@@) يروي عن الأوزاعي، روى عنه عبد الله بن وهب المصري.(@)(@@)(@@)(@@) ||| AUTO موسى بن سليمان أبو عمر(@)(@@) يروي عن القاسم بن مخيمرة والشاميين، روى عنه الأوزاعي ومعاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO موسى بن سعد(@)(@@) يروي عن ربيعة بن أبي عبد الرحمن، روى عنه العطاف بن خالد.(@)(@@)(@@)(@@) ||| AUTO موسى بن عبد الله بن الشريد(@)(@@) يروي عن سعيد بن أبي هند، روى عنه يزيد بن الهاد.(@)PageV01P002(@)(@@) [ج 4: ص 284](@)(@@)(@@)(@@) ||| AUTO موسى بن رباح اللحمي(@)(@@) كان يسكن مصر، يروي عن أبيه، روى عنه الليث بن سعد وابن المبارك، كنيته أبو عبد الرحمن وكان 
ms1220	 مولده سنة تسع وثمانين بالمغرب، ومات بالإسكندرية سنة ثلاث وستين ومائة، وهو الذي يقال له: موسى بن علي بن رباح.(@)(@@) (431) -[4: 284] حدثني محمد بن عبد الله بن الجنيد البشتي، ثنا قتيبة بن سعيد، ثنا الليث بن سعد، عن موسى بن علي، قال: سمعت أبي، يقول: " من قال لي على فليس في حل " قال أبو حاتم رضى الله تعالى عنه: كان أهل الشام يجعلون كل على عندهم عليا لبغضهم عليا عليه السلام، ومن أجله ما قيل لعلي بن رباح، علي بن رباح، ولمسلمة بن علي الخشني مسلمة بن علي.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي عثمان(@)(@@) يروي عن أبي يحيى عن أبي هريرة، روى عنه الثوري وشعبة، وهو من سادات أهل الكوفة وعبادهم.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي عتيق(@)(@@) يروي عن عبد الله بن أبي قتادة، روى عنه إبراهيم بن طهمان.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي عيسى أبو هارون المدني(@)(@@) يروي عن أبي جعفر ونافع، روى عنه ابن عيينة، وهو أخو عيسى بن أبي عيسى الخياط، وموسى أقدم من عيسى.(@)(@@)(@@)(@@) ||| AUTO موسى بن عبد الرحمن(@)(@@) يروي المقاطيع، روى عنه يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي معبد(@)(@@) مولى الزهري، يروي عن سعيد بن المسيب وسالم والقاسم، روى عنه الدراوردي.(@)(@@)(@@)(@@) ||| AUTO موسى بن عبد الملك بن عمير القبطي(@)(@@) كان له فرس، يقال له: القبطي فنسب إليه، من أهل الكوفة، يروي عن أبيه عن جابر بن سمرة عن نافع بن عتبة: " غزون جزيرة العرب فيفتحها الله عليكم ". روى عنه محمد بن أبي الوزير وعاصم بن علي.(@)PageV01P002(@)(@@) [ج 4: ص 285](@)(@@)(@@)(@@) ||| AUTO موسى الصغير(@)(@@) وهو: موسى بن قيس، وقد قيل: موسى بن دينار، ويقال: موسى بن مسلم الحضرمي من أهل الكوفة، يروي عن مجاهد وعطية، روى عنه أبو معاوية، ووكيع.(@)(@@)(@@)(@@) ||| AUTO موسى بن أبي تميم(@)(@@) من أهل المدينة، يروي عن أبي الحباب سعيد بن يسار، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: " الدينار بالدينار لا فضل بينهما والدرهم بالدرهم لا فضل بينهما ". روى عنه مالك، وسليمان بن بلال. 