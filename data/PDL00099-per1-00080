ms61	 روزگار ازین خوشم که روزگار من تویی(@)(@@) 7 مرا نگار نیک‌پی شراب ملک ری دهد %~% شرابهای ملک ری مرا کفاف کی دهد(@)(@@) 8 بلی کفاف کی دهد شرابها که وی دهد %~% مگر دو چشم مست وی کفایتم ز می دهد(@)(@@) 9 نگر کران راغ‌ها چه سبزها چه کشتها %~% ز لاله‌ها به باغ‌ها فراز خاک و خشت‌ها(@)(@@) 10 عیان نگر چراغ‌ها شکفته بین بهشت‌ها %~% نموده تر دماغ‌ها چه خوب‌ها چه زشتها(@)(@@) 11 دمن شد ای پسر یمن شقیق‌ها عقیق‌ها %~% نشسته مست در دمن شفیق‌ها رفیق‌ها(@)(@@) 12 چمیده جانب چمن رفیق‌ها شفیق‌ها %~% گسارده به رطل و من عتیق‌ها رحیق‌ها(@)(@@) 13 ملاذ و ملجا مهان خدیو زاده مهین %~% عطیه بخش راستان خدایگان راستین(@)(@@) 14 سپهرش اندر آستان محیطش اندر آستین %~% به‌ صد قرون ز صد قران فلک نیاردش قرین(@)(@@) 15 سلیل خسرو عجم فرشته فر علیقلی %~% چراغ دودمان جم به بخردی و عاقلی(@)(@@) 16 همال ابر درکرم مثال ببر در ریلی %~% هلاک جان گستهم ز پهلوی و پر دلی(@)(@@) 17 به ‌روز کین که‌ جایگه به ‌پشت رخش می‌کند %~% چو سنگریزه کوه را زگرز پخش می کند(@)(@@) 18 به خنجری که خندها به آذرخش می کند %~% سر و تن حسود را هزار بخش می کند(@)(@@) 19 اگر فتد ز قهر او به نه فلک شراره‌ای %~% به یک سپهر ننگری نسوخته ستاره‌ای(@)(@@) 20 ز روی خشم اگرکند به لشکری نظاره‌ای %~% گمان مبرکه جان برد پیاده‌ای سواره‌ای(@)(@@) 21 اگر به گاه کودکی خرد نبود مهد او %~% به‌‌ کسب دانش این‌ قدر ز چیست جد و جهد او(@)(@@) 22 به خاک اگر دمی دمد عقیق پر ز شهد او %~% تمام نیشکر شود نبات‌ها به عهد او(@)(@@) 23 اگر چه بهره‌ای مرا ز مال روزگار نی %~% چو والیان مملکت شکوه و اقتدار نی(@)(@@) 24 حمال نی خیول نی بغال نی حمار نی %~% جلال نی جیوش نی پیاده نی سوار نی(@)(@@) 25 همیشه تا بود مکان به بحر 
ms62	 آبخوست را %~% هماره تا در آسمان نحوستست بست را(@)(@@) 26 تقابل است تا به هم شکسته و درست را %~% چنانکه تند و کند را چنانکه سخت و سست را(@)(@@) 27 همیشه تا که نقطه‌ای بود میان دایره %~% که هرخطی که برکشی از آن به سوی چنبره(@)(@@) 28 مرآن خطوط مختلف برابرند یکسره %~% حسود باد صید او چو صید باز قبره PageV1P082(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوشم ندا رسید ز درگاه‌کبریا %~% کای بنده‌کبر بهتر ازین عجز با ریا(@)(@@) 2 خوانی مرا خبیر و خلاف تو آشکار %~% دانی مرا بصیر و نفاق تو برملا(@)(@@) 3 گر دانیم بصیر چرا می‌کنی‌گنه %~% ور خوانیم خبیر چرا می‌کنی خطا(@)(@@) 4 ماگر عطاکنیم چه خدمت‌کنی به خلق %~% خلق ارکرم‌کنند چه منت بری ز ما(@)(@@) 5 ماییم خالق تو چو حاصل شود تعب %~% خلقند خواجه تو چو واصل شود عطا(@)(@@) 6 اجرای من خوری وکنی خدمت امیر %~% روزی من بری وکشی منت‌کیا(@)(@@) 7 گه چون عسس مدارت از خون بی‌کسان %~% گه چون مگس قرارت بر خوان اغنیا(@)(@@) 8 گاهی چوکرم پیله‌کشی طیلسان به سر %~% گاهی ز روی حیله‌کنی پیرهن قبا(@)(@@) 9 یعنی به جذبه‌ایم نه شوریده از جنون %~% یعنی به خلسه‌ایم نه پیچیده در ردا(@)(@@) 10 تاکی شود به رهگذر جرم ره سپر %~% تاکی‌کنی به معذرت جبر اکتفا(@)(@@) 11 گویی‌که جبر باشد و باکت نه ازگنه %~% دانی‌که جرم داری و شرمت نه از خدا(@)(@@) 12 آخر صلاح را نبود فخر بر فجور %~% آخر نکاح را نبود فرق از زنا(@)(@@) 13 مقتول را ز قاتل باطل بود قصاص %~% مظلوم را ز ظالم لازم بود جفا(@)(@@) 14 کس‌گفت رنگها همه در خامه قدر %~% کس‌گفت ننگها همه در نامه قضا(@)(@@) 15 درگردش است لعبت و لعاب درکمین %~% در جنبش است خامه و نقاش در قفا(@)(@@) 16 میغست در تصاعد و قلاب آفتاب %~% کاهست در تحرک و جذاب‌کهربا(@)(@@) 17 دیو از برای آنکه به خویشت شود دلیل %~% نفس از برای آنکه زکیشت‌کند جدا 
ms63	(@)(@@) 18 آن از طریق شرع‌کند با تو دوستی %~% وین در لباس زهد شود با تو آشنا(@)(@@) 19 آن نرم نرم شبهه باطل‌کند بیان %~% وین خند خند نکته ناحق‌کند ادا(@)(@@) 20 آن طعنه‌گوکه یاوری دین ذوالمنن %~% وین خنده زن‌که پیروی شرع مصطفا(@)(@@) 21 گر جز قبول ملت اجدادکو دلیل %~% ور جز وثوق عادت اسلاف‌کوگوا(@)(@@) 22 این‌گویدت همی به تجاهل‌که حق‌کدام‌ %~% وین راندت همی به تعرص‌که رب‌کجا(@)(@@) 23 این دزدکاروان و تو مسکین‌کاروان %~% آن رند و اوستا و تو نادان روستا(@)(@@) 24 آن آردت ز مسلک توحید منصرف %~% وین آردت به مهلک تزویر رهنما(@)(@@) 25 تو در میانه هایم و حیران و تن‌زده %~% آکنده از سفاهت و آموده از عما(@)(@@) 26 بر دیده خلوص تو حاجب شود هوس %~% بر آتش نفاق تو دامن زند هوا(@)(@@) 27 سازد ترا به شرک خفی دیو ممتحن %~% آرد ترا به‌کفر جلی‌نفس مبتلا(@)(@@) 28 نفس تراکسالت اصلی شود معین %~% طبع ترا جهالت فطری شود غطا(@)(@@) 29 گویی‌گه صلوه‌که شرعست ناپسند %~% رانی‌گه زکوه‌که دین است ناروا(@)(@@) 30 تا رفته رفته دغدغه دل شود قوی %~% تا لمحه لمحه تقویت دل‌کند قوا(@)(@@) 31 گویی به‌خودکه‌رب ز چه‌رفتست‌درحجاب %~% رانی‌به دل‌که حق ز چه ماندست در خفا(@)(@@) 32 گر زانکه هست‌ حکمت پنهان شدن‌کدام %~% ور زانکه نیست پیرو فرمان شدن چرا(@)(@@) 33 تا چند مکر و دغدغه‌ای دیو زشت‌خو %~% تا چندکفر و سفسطه‌ای مست ژاژخا(@)(@@) 34 بر بود من دلیل بس این چرخ‌گردگرد %~% بر ذات من‌گواه بس این دیر دیرپا(@)(@@) 35 کوبنده‌یی بباید تا دف‌کند خروش %~% گوینده‌یی بباید تاکه‌کند صدا(@)(@@) 36 سریست زیر پرده‌که می‌پوید آسمان %~% آبیست زیر پره‌که می‌گردد آسیا(@)(@@) 37 بی‌نوبهارگل نشود بوستان فروز %~% بی‌کردگارکه نشود آسمان گرا(@)(@@) 38 شاه ار ترا به تخت منقش دهد جواز %~% میر ار ترا به‌کاخ مقرنس زند صلا(@)(@@) 39 مدحت‌کنی نخست به نقاش آن سریر %~% تحسین‌کنی درست به معمار آن بنا(@)(@@) 40 گویی به‌کلک صنعت نقاش‌آفرین %~% رانی به دست قدرت معمار مرحبا(@)(@@) 41 آخر 
ms64	 چگونه‌کوه بدان شوکت و شکوه %~% آخر چگونه چرخ بدین رفعت و علا(@)(@@) 42 بی‌قادری به وادی هستی نهد قدم %~% بی‌صانعی به عرصه امکان زند لوا(@)(@@) 43 آخر چگونه عرش بدین پایه و شرف %~% آخر چگونه مهر بدین مایه و بها(@)(@@) 44 بی‌آمری بسیط جهان را شود محیط %~% بی‌خالقی فضای‌زمین را دهد ضیا(@)(@@) 45 اسباب فرش من چه‌کم ازکاخ پادشه %~% آیات عرش من چه‌کم از عرش پادشا(@)(@@) 46 با این‌گنه امید تفضل بودگنه %~% با این خطا خیال ترحم بود خطا(@)(@@) 47 الا به یمن طاعت برهان حق علی %~% الا به عون مدحت سلطان دین رضا(@)(@@) 48 اصل‌کرم ولی نعم قاید امم %~% کهف وری امام هدی آیت تقا(@)(@@) 49 سطح حیات‌ خط بقا نقطه وجود %~% قطب نجات‌قوس صفا مرکز وفا(@)(@@) 50 نفس بسیط‌ عقل مجرد روان صرف %~% مصباح فیض راح روان روح اتقیا(@)(@@) 51 مصداق لوح‌ معنی نون مظهر قلم %~% نور ازل چراغ ابد مشعل بقا(@)(@@) 52 منهاج عدل تاج شریعت رواج دین %~% مفتاح صنع درج سخن‌گوهر سخا(@)(@@) 53 فیض نخست‌ صادراول ظهورحق %~% مرآت وحی رایت دین آیت هدا(@)(@@) 54 معنی با بسمله‌ مسند نشین‌کن %~% مصداق نفس‌کامله عزلت‌گزین لا(@)(@@) 55 گر حکم او به جنبش غبرا دهد مثال %~% ور رای او به رامش‌گردون دهد رضا(@)(@@) 56 راند قضا پیاپی کاجراست ای قدر %~% گوید قدر دمادم‌کامضاست ای قضا(@)(@@) 57 پاینده دولتیست‌بدو جستن انتساب %~% فرخنده نعمتیست بدوکردن اقتدا(@)(@@) 58 بیمی‌که با حمایت او بهترین ملک %~% سلطان به یک تعرض اوکمترین‌گدا(@)(@@) 59 عکسی ز لوح حکمت او هرچه در زمین %~% نقشی زکلک قدرت او هرچه در سما(@)(@@) 60 گر پرسد از خدای‌که یارب‌کراست حق %~% الحق فیک منک الیک آیدش ندا(@)(@@) 61 ارواح‌‌انبیا همه بر خاک او مقیم %~% اشباح اولیا همه در راه‌او فدا(@)(@@) 62 با نسبت وجود شریف تو ممکنات %~% ای ممکنات را به وجود تو التجا(@)(@@) 63 خورشید وسایه روز و چراغ آفتاب وشمع %~% دریاو قطره‌ درو خزف برد و بوریا(@)(@@) 64 اصل‌وطفیل‌ شخص 
ms65	 وشبه‌ قصدوامتحان %~% بود و نبود ذات و صفت عین و اقتضا(@)(@@) 65 فیاض وفیض‌ علت و معلول‌ نور و ظل %~% نقاش و نقش‌‌کاتب و خط‌ بانی و بنا(@)(@@) 66 معنی ولفظ‌ مصدر ومشتق مفاد و حرف %~% عین و اثر عیان و خبر صدق و افترا(@)(@@) 67 بالله من قلاک بصیرا فقد هلک %~% تالله من اتاک خبیرا فقد نجا(@)(@@) 68 ذات تو سرفراز به تمجید ذوالمنن %~% نفس تو بی‌نیاز ز تقدیس اصفیا(@)(@@) 69 ازگوهر تو عالم ایجاد را شرف %~% از هستی تو دوحه ابداع را نما(@)(@@) 70 در پیشگاه امر تو بی‌گفت و بی‌شنود %~% درکارگاه نهی تو بی‌چون و بی‌چرا(@)(@@) 71 اضداد بی مسالمه با یکدگر قرین %~% ابعاد بی‌منازعه از یکدگر جدا(@)(@@) 72 اخلاف راشدین توگنجینه شرف %~% اسلاف ماجدین تو آیینه صفا(@)(@@) 73 یکسر به‌کارگاه هدایت‌گشاده دست %~% یکسر به بارگاه امامت نهاده پا(@)(@@) 74 در پرده ولایت عظمی نهفته رو %~% بر مسند خلاقت‌کبری‌گزیده جا(@)(@@) 75 نفس تو بوستانی معطور و دلنشین %~% ذات توگلستانی مطبوع و جان‌فزا(@)(@@) 76 نورسته لاله‌ایست از آن بوستان ادب %~% نشکفته غنچه‌ایست از آن‌گلستان حیا(@)(@@) 77 غمگین‌شودبه‌هرچه‌توغمگین‌شوی‌رسول %~% شادان شود به هرچه تو شادان شوی خدا(@)(@@) 78 خورشیدگر نه‌کور شد از شرم رای تو %~% دارد چرا ز خط شعاعی به‌کف عصا(@)(@@) 79 شرعی‌که بر ولای تو حایل شود دغل %~% وحیی‌که بی‌رضای تو نازل شود دغا(@)(@@) 80 هر نیش‌کز خلیل تو نوشیست دلنشین %~% هر نوش‌کز عدوی تو نیشیست جانگزا(@)(@@) 81 مهر ترا ثواب مخلد بود ثمر %~% قهر ترا عذاب مؤبد بود جزا(@)(@@) 82 آنجاکه‌ قدرتست اثر نیست از جهت %~% آنجاکه صدر تست خبر نیست از فضا(@)(@@) 83 با شوکت تو چرخ اسیریست منحنی %~% با همت تو مهر فقیریست بینوا(@)(@@) 84 خرم بهشت اگر تو برو نگذری جحیم %~% رخشان سهیل اگر تو برو ننگری سها(@)(@@) 85 از فر هستی تو بود عقل را فروغ %~% از نورگوهر تو بود نفس را بها(@)(@@) 86 درکارگاه امر تویی میر پیش بین %~% در بارگاه ملک 
ms66	 تویی شاه پیشوا(@)(@@) 87 بی‌رخصت تو لاله نمی‌روید از زمین %~% بی‌خواهش تو ژاله نمی‌بارد از هوا(@)(@@) 88 گویا شود جماد اگرگوییش بگو %~% پویا شود نبات اگرگوییش بیا(@)(@@) 89 مردود پیشگاه تو مردودکاینات %~% مقبول بارگاه تو مقبول ماسوا(@)(@@) 90 مستوثق ولای تو نندیشد از اجل %~% مستظهر و داد تو نگریزد از فنا(@)(@@) 91 در مکتب‌کمال تو خردی بود خرد %~% از دفتر نوال تو جزوی بود بقا(@)(@@) 92 جسم ترا به مسند ناسوت مستقر %~% روح ترا ز بالش لاهوت متکا(@)(@@) 93 گنجی‌که بد سگال تو بخشدکم از خزف %~% رنجی‌که نیکخواه تو خواهد به از شفا(@)(@@) 94 حب توگر عدوست به جان می‌خرم عدو %~% مهر توگر بلاست به دل می‌برم بلا(@)(@@) 95 خاری‌که از خلیل تو می‌خوانمش رطب %~% دردی‌که از حبیب تو می‌دانمش دوا(@)(@@) 96 دل با توگر دو روست ز دل می‌برم امید %~% جان با توگر عدوست ز جان می‌کنم ابا(@)(@@) 97 خوفی‌که از دیار تو باشد به از امان %~% فقری‌که در جوار تو باشد به از غنا(@)(@@) 98 بیمم نه با وداد تو از آتش حجیم %~% باکم نه با ولای تو از شورش جزا(@)(@@) 99 در روز حشر جوشن جان سازم آن وداد %~% در وقت نشر نشرت تن سازم آن ولا(@)(@@) 100 قاآنیا اگرچه دعا و ثنای شاه %~% این دیو را اذی بود آن روح را غذا(@)(@@) 101 زان بر فراز عرش سرافیل را سرور %~% زین بر فرود فرش عزازیل را عزا(@)(@@) 102 لیکن ترا مجال بیان نیست در درود %~% لیکن ترا قبول سخن نیست در ثنا(@)(@@) 103 دشت دعا وسیع و سمند تو ناتوان %~% بام ثنا رفیع وکمند تو نارسا(@)(@@) 104 زین بیش بر طبق چه نهی جنس ناپسند %~% زین بیش بر محک چه زنی نقد ناروا(@)(@@) 105 این عرصه‌ایست صعب بدو بر منه قدم %~% وین لجه‌ایست ژرف بدو بر مکن شنا(@)(@@) 106 گیرم‌که درکلام تو تأثیرکیمیاست %~% دانا به‌کان زر نکند عرض‌کیمیا(@)(@@) 107 گیرم‌که عنبرین سخنت نافه ختاست %~% کس نافه 
ms67	 ارمغان نبرد جانب ختا(@)(@@) 108 ختلان و خنگ چاچ وکمان‌ روم و پرنیان %~% توران و تیر مصر و شکر هند و توتیا(@)(@@) 109 کرمان و زیره بصره و خرما بدخش و لعل %~% عمان و در حدیقه وگل جنت وگیا(@)(@@) 110 گر رایت از مدیح شناسایی است و بس %~% خود را شناس تا نکنی مدح ناسزا(@)(@@) 111 ور مقصد از دعا طلبت نیل مدعاست %~% خود را دعاکن از پی تحصیل مدعا(@)(@@) 112 شه را هر آنچه باید و شاید مقرر است %~% بی‌سنت ستایش و بی‌منت دعا(@)(@@) 113 آن را که افتخار دعا و ثنا بدوست %~% ناید ثنا ستوده و نبود دعا روا(@)(@@) 114 یا‌رب به پادشاه رسل ماه هاشمی %~% یارب به رهنمای سبل شاه لافتی(@)(@@) 115 یار‌ب به زهد سلمان آن پیر پارسی %~% یارب به صدق بوذر آن میر پارسا(@)(@@) 116 یارب به اشک دیده‌گریان فاطمه %~% یارب بسوز سینه بریان مجتبی(@)(@@) 117 یارب به اشک چشم اسیران ماریه‌ %~% یارب به خون خلق شهیدان‌کربلا(@)(@@) 118 یارب به آفتاب امامت علی‌که هست %~% مفتاح آفرینش‌ و مصباح اهتدا(@)(@@) 119 یارب به نور بینش‌ باقرکه پرتویست %~% از علم او ظهورکرامات اولیا(@)(@@) 120 یارب به فر مذهب جعفرکه جلوه‌ایست %~% از صدق او شهود مقامات اوصیا(@)(@@) 121 یارب به جاه موسی‌کاظم‌که بوقبیس %~% با علم او به پویه سبق برده از صبا(@)(@@) 122 یارب به پادشاه خراسان‌کش آسمان %~% هر دم‌کند سجودکه روحی لک الفدا(@)(@@) 123 یارب به جود عام محمدکه‌کرده‌اند %~% تعویذ جان ز حرز جواد وی انبیا(@)(@@) 124 یا‌رب به مهر برج نقاوت نقی‌که یافت %~% هجده هزار عالم ازو نزهت و نوا(@)(@@) 125 یارب به نور دعوت حسن حسن‌که هست %~% هستی او حقیقت جام جهان‌نما(@)(@@) 126 یارب به نور حجت قائم‌که تا قیام %~% قائم به اوست قائمه عرش‌کبریا(@)(@@) 127 فضلی‌که از شداید برزخ شوم خلاصت %~% رحمی‌که از مهالک دوزخ شوم رها(@)(@@) 128 برهانم از و‌ساوس این نفس دون‌پرست %~% دریابم ازکشاکش این طبع خود ستا(@)(@@) 129 چندم به‌کارگاه طلب 
ms68	 نفس‌ در تعب %~% چندم به بارگاه فنا روح در عنا(@)(@@) 130 مگذار بیژنم را در قعر تیره چه %~% مپسند‌‌ بهمنم را درکام اژدها(@)(@@) 131 ادعوک راجیا و انادیک فاستجب %~% یا من یجیب دعوه داع اذا دعا(@)(@@) 132 فاستغفری لذنبک با نفس و اهتدی %~% بالله ان ربک یهدی لمن یشا PageV1P083(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به‌گردون تیره ابری بامدادان برشد از دریا %~% جواهر خیز وگوهرریز وگوهربیز وگوهرزا(@)(@@) 2 چو چشم اهرمن خیره چو روی زنگیان تیره %~% شده‌گفتی همه چیره به مغزش علت سودا(@)(@@) 3 شبه‌گون چون شب غاسق‌گرفته چون دل عاشق %~% به اشک دیده وامق به رنگ طره عذرا(@)(@@) 4 تنش با قیر آلوده دلش از شیر آموده %~% برون پر سرمه سوده درون پر لؤلؤ لالا(@)(@@) 5 به دل‌گلشن به تن زندان‌گهی‌گریان‌گهی خندان %~% چو در بزم طرب رندان ز شور نشوه صهبا(@)(@@) 6 چو دودی بر هوا رفته چو دیوی مست و آشفته %~% زده بس در ناسفته ز مستی خیره بر خارا(@)(@@) 7 و یا در تیره چه بیژن نهفته چهره روشن %~% و یا روشن‌گهر بهمن شده درکام اژدرها(@)(@@) 8 لب غنچه رخ لاله برون آورده تبخاله %~% ز بس باران از آن ژاله به طرف‌گلشن و صحرا(@)(@@) 9 ز فیض او دمیده‌گل شمیده طره سنبل %~% کشیده از طرب بلبل به شاخ سرخ‌گل آوا(@)(@@) 10 عذارگل خراشیده خط ریحان تراشیده %~% ز بس الماس پاشیده به باغ از ژاله بیضا(@)(@@) 11 ازو اطراف خارستان شده یکسر بهارستان %~% وزو رشک نگارستان زمین از لاله حمرا(@)(@@) 12 فکنده بر سمن سایه دمن را داده سرمایه %~% چمن زو غرق پیرایه چو رنگین شاهدی رعنا(@)(@@) 13 ز بیمش مرغ جان پرد ز سهمش زهره‌ها درد %~% چو او چون اژدها غرد و یا چون ددکشد آوا(@)(@@) 14 خروشد هردم ازگردون‌که پوشد برتن هامون %~% ز سنبل‌کسوت اکسون ز لاله خلعت دیبا(@)(@@) 15 فشاند بر چمن ژاله دماند از دمن لاله %~% چنان از دل‌کشد ناله‌که سعد از فرقت اسما(@)(@@) 16 کنون از 
ms69	 فیض او بستان نماید ازگل و ریحان %~% به رنگ چهره غلمان به بوی طره حورا(@)(@@) 17 چمن از سرو و سیسنبر همال خلخ وکشمر %~% دمن از لاله و عبهر طراز و تبت و یغما(@)(@@) 18 ز بس‌گلهای‌گوناگون چمن چون صحف انگلیون %~% توگویی فرش سقلاطون صباگسترده در مرعی(@)(@@) 19 ز بس خوبان فرخ رخ‌گلستان غیرت خلخ %~% همه‌چون نوش در پاسخ همه‌چون سیم‌در سیما(@)(@@) 20 ز بس لاله ز بس نسرین دمن رنگین چمن مشکین‌ %~% ز بوی آن ز رنگ این هوا دلکش زمین زیبا(@)(@@) 21 گل از باد وزان لرزان وزان مشک ختن ارزان %~% بلی نبود شگفت ارزان‌کساد عنبر سارا(@)(@@) 22 ز فر لاله و سوسن ز نور نور و نسترون %~% دمن چون وادی ایمن چمن چون سینه سینا(@)(@@) 23 چه درهامون چه دربستان‌صف‌اندرصف‌گل‌وریحان %~% ز یک سو لاله نعمان ز یک سو نرگس شهلا(@)(@@) 24 توگویی اهل یک‌کشور برهنه پا برهنه سر %~% چمان در خشکسال اندر به هامون بهر استسقا(@)(@@) 25 چمن از فر فروردین چنان نازان به دشت چین %~% که طوس از فر شاه دین برین نه‌گنبد خضرا(@)(@@) 26 هژبر بیشه امکان نهنگ لجه ایمان %~% ولی ایزد منان علی عالی اعلا(@)(@@) 27 امام ثامن ضامن حریمش چون حرم آمن %~% زمین از حزم او ساکن سپهر از عزم او پویا(@)(@@) 28 نهال باغ علیین بهار مرغزار دین %~% نسیم روضه یاسین شمیم دوحه طاها(@)(@@) 29 سحاب عدل را ژاله ریاض شرع را لاله %~% خرد بر چهر او واله روان از مهر او شیدا(@)(@@) 30 رخش مهری فروزنده لبش یاقوتی ارزنده %~% ازآن جان خرد زنده ازین نطق سخن‌گویا(@)(@@) 31 ز جودش قطره‌یی قلزم ز رایش پرتوی انجم %~% جنابش قبله مردم رواقش‌کعبه دلها(@)(@@) 32 بهشت از خلق او بویی محیط از جود او جویی %~% به جنب حشمتش گویی گرایان گنبد مینا(@)(@@) 33 ستاره‌گوی میدانش هلال عید چوگانش %~% ز نعل سم یکرانش غباری توده غبرا(@)(@@) 34 قمر رنگی ز رخسارش شکر طعمی زگفتارش %~% بشر را 
ms70	 مهر دیدارش نهان چون روح در اعضا(@)(@@) 35 زمین آثاری از حزمش فلک معشاری از عزمش %~% اجل در پهنه رزمش ندارد دم زدن یارا(@)(@@) 36 خرد طفل دبستانش قمر شمع شبستانش %~% به مهر چهر رخشانش ملک حیران‌تر از حربا(@)(@@) 37 نظام عالم اکبر قوام شرع پیغمبر %~% فروغ دیده حیدر سرور سینه زهرا(@)(@@) 38 ابد از هستیش آنی فلک در مجلسش خوانی %~% به خوان همتش فانی فروزان بیضه بیضا(@)(@@) 39 وجودش باقضا توأم ز جودش ماسوا خرم %~% حدوثش با قدم همدم حیاتش با ابد همتا(@)(@@) 40 قضا تیریست در شستش فنا تیغیست در دستش %~% چو ماهی بسته شستش همه دنیا و مافیها(@)(@@) 41 زمین‌گوییست در مشتش فلک مهری در انگشتش %~% دوتا چون آسمان پشتش به پیش ایزد یکتا(@)(@@) 42 به‌سائل بحر وکان بخشد خطاگفتم جهان بخشد %~% گرفتم‌کاو نهان بخشد ز بسیاری شود پیدا(@)(@@) 43 ملک مست جمال او فلک محوکمال او %~% ز دریای نوال او حبابی لجه خضرا(@)(@@) 44 زمان را عدل او زیور جهان را ذات او مفخر %~% زمان را او زمان‌پرور جهان را او جهان پیرا(@)(@@) 45 ز قدرش عرش مقداری ز صنعش خاک آثاری %~% به باغ شوکتش خاری ریاض جنت‌المأوی(@)(@@) 46 امل را جود او مربع اجل را قهر او مصنع %~% فلک را قدر او مرجع ملک را صدر او ملجا(@)(@@) 47 رضای او رضای حق قضای او قضای حق %~% دلش از ماسوای حق‌گزیده عزلت عنقا(@)(@@) 48 کواکب خشت ایوانش فلک اجری خورخوانش %~% به زیر خط فرمانش چه جابلقا چه جابلسا(@)(@@) 49 رخش پیرایه هستی دلش سرمایه هستی %~% وجودش دایه هستی چه در مقطع چه در مبدا(@)(@@) 50 ملک را روی دل سویش فلک را قبه ابرویش %~% به‌گردکعبه کویش طواف مسجدالاقصی(@)(@@) 51 جهان را او بود آمر چه در باطن چه در ظاهر %~% به امر او شود صادر ز دیوان قضا طغرا(@)(@@) 52 کند از یک شکرخنده هزاران مرده را زنده %~% چنان‌کز چهر رخشنده جهان پیر را برنا 
ms71	(@)(@@) 53 ردای قدس پوشیده به حزم نفس‌کوشیده %~% به بزم انس نوشیده می وحدت ز جام لا(@)(@@) 54 می از مینای لاخورده سبق از ماسوا برده %~% وزان پس سر برآورده ز جیب جامه الا(@)(@@) 55 زدو‌ده زنگ امکانی شده در نور حق فانی %~% چو مه در مهر نورانی چو آب دجله در دریا(@)(@@) 56 زدف در دشت لاخرگه‌که لامعبود الا الله %~% زکاخ نفی جسته ره به خلوتگاه استثنا(@)(@@) 57 شده از بس به یاد حق به بحر نفی مستغرق %~% چنان با حق شده ملحق‌که استثنا به مستثنا(@)(@@) 58 روان راز پرورده سراید راز در پرده %~% بلی‌گیرد خرد خرده به نااهل ار بری‌کالا(@)(@@) 59 رموز علم ادریسی بود ذوقی نه تدریسی %~% چه داند ذوق ابلیسی رموز علم الاسما(@)(@@) 60 زهی یزدان ثناخوانت دوگیتی خوان احسانت %~% خهی فتراک فرمانت جهان را عروه‌الوثقی(@)(@@) 61 ستاره میخ خرگاهت زحل هندوی درگاهت %~% ز بیم خشم جانکاهت فلک را رنج استرخا(@)(@@) 62 به سر از لطف حق تاجت طریق شرع منهاجت %~% بساط قرب معراجت فسبحان الذی اسری(@)(@@) 63 مهین نوباوه آدم بهین پیرایه عالم %~% چو خیرالمرسلین محرم به خلوتگاه او ادنی(@)(@@) 64 تویی غالب تویی ماهر تویی باطن تویی ظاهر %~% تویی ناهی تویی آمر تویی داور تویی دارا(@)(@@) 65 مسالک را تویی رهبر ممالک را تویی زیور %~% محامد را تویی مظهر معارف را تویی منشا(@)(@@) 66 تو در معموره امکان خداوندی پس از یزدان %~% چودر رگ‌خون چودر تن‌جان روان حکم‌تو در اشیا(@)(@@) 67 تویی بر نفع و ضر قادر تویی بر خیر و شر قاهر %~% تویی بر دیو و دد آمر تویی بر نیک و بد دانا(@)(@@) 68 تو جسم شرع را جانی تو در عقل راکانی %~% توگنج‌کان یزدانی تو دانی سر ما اوحی(@)(@@) 69 تو دانایی حقایق را تو بینایی دقایق را %~% تو رویانی شقایق را ز ناف صخره صما(@)(@@) 70 ترا از ماه تا ماهی ز حق پروانه شاهی %~% گر افزایی وگرکاهی نباشد ازکست پروا 
ms72	(@)(@@) 71 زمان را از تو افزایش زمین را از تو آسایش %~% روان را از تو آرامش خرد را از تو استغنا(@)(@@) 72 به‌کلک قدرت داور تو بودی آفرین‌گستر %~% نزاده چارگان مادر نبوده هفتگان آبا(@)(@@) 73 ز درعت حلقه‌یی‌گردون ز تیغت شعله‌یی‌کانون %~% ز قهرت لطمه‌یی جیحون ز ملکت خطوه‌یی بیدا(@)(@@) 74 اگر لطف تو ای داور نگردد خلق را رهبر %~% ز آه خلق در محشر قیامتها شود بر پا(@)(@@) 75 زهی ای نخل باغ دین‌کت اندر دیده حق‌بین %~% نماید خوشه پروین‌کم از یک خوشه خرما(@)(@@) 76 در اوصاف تو قاآنی دهد داد سخندانی %~% کند امروز دهقانی‌که تا حاصل برد فردا(@)(@@) 77 سخن تخمست و او دهقان ثنا مزرع امل باران %~% فشاند دانه در میزان‌که چیند خوشه در جوزا(@)(@@) 78 تعالی‌الله‌گرش خوانی معاذالله‌گرش رانی %~% به هر حالت‌که می‌دانی تویی مهتر تویی مولا(@)(@@) 79 گرش خوانی زهی با ذل ورش رانی خهی عادل %~% گرش خوانی شود خوشدل ورش رانی شود رسوا(@)(@@) 80 گرش خوانی عفاک‌الله ورش رانی حماک‌الله %~% بهر صورت جزاک‌الله‌کما تبغی‌کما ترضی(@)(@@) 81 گرش خوانی ثناگوید ورش رانی دعاگوید %~% نترسد برملاگوید ستم زیباکرم زیبا(@)(@@) 82 الا تا در مه نیسان دمد ازگل‌گل و ریحان %~% بروید سنبل از بستان برآید لاله از خارا(@)(@@) 83 چو لاله زایرت خرم چوگل با خرمی توأم %~% چو ریحان سبز و مشکی دم چو سنبل بوستان پیرا PageV1P084(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوش‌که این‌گردگردگنبد مینا %~% آبله‌گون شد چو چهر من ز ثریا(@)(@@) 2 تند و غضبناک و سخت و سرکش و توس %~% از در مجلس درآمد آن بت رعنا(@)(@@) 3 ماه ختن شاه روم شاهدکشمر %~% فتنه چین شور خلخ آفت یغما(@)(@@) 4 تاجکی از مشک‌ترگذاشته بر سر %~% غیرت تاج قباد و افسر دارا(@)(@@) 5 خم‌خم و چین‌چین شکن‌شکن سر زلفش %~% کرده ز هر سو پدید شکل چلیپا(@)(@@) 6 روی سپیدش برادر مه گردون %~% موی سیاهش پسر عم شب یلدا(@)(@@) 7 چشم مگو یک قبیله زنگی جنگی %~% تیر وکمان برگرفته از 
