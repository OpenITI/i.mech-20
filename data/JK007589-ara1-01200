ms1181	 بان عليها الدهر فاكهة % وما الفواكه مما يحمل البان % 40(@)(@@) % ونرجس بات ساري الطل يضربه % وأقحوان منير النور ريان % % 41(@)(@@) % ألفن من كل شيء طيب حسن % فهن فاكهة شتى وريحان % % 42(@)(@@) % ثمار صدق إذا عاينت ظاهرها % % لكنها حين تبلو الطعم خطبان % % 43(@)(@@) % بل حلوة مرة طورا يقال لها % % شهد وطورا يقول الناس ذيفان % % 44(@)(@@) % يا ليت شعري وليت غير مجدية % إلا استراحة قلب وهو أسوان % % 45(@)(@@) % لأي أمر مراد بالفتى جمعت % % تلك الفنون فضمتهن أفنان % % PageV01P4488 46(@)(@@) % تجاورت في غصون لسن من شجر % لكن غصون لها وصل وهجران % % 47(@)(@@) % تلك الغصون اللواتي في أكمتها % % نعم وبؤس وأفراح وأحزان % % 48(@)(@@) % يبلو بها الله قوما كي يبين له % ذو الطاعة البر ممن فيه عصيان % % 49(@)(@@) % وما ابتلاهم لإعنات ولا عبث % % ولا لجهل بما يطويه إبطان % 50(@)(@@) % لكن ليثبت في الأعناق حجته % ويحسن العفو والرحمن رحمن % % 51(@)(@@) % ومن عجائب ما يمنى الرجال به % % مستضعفات له منهن أقران % % 52(@)(@@) % مناضلات بنبل لا تقوم له % % كتائب الترك يزجيهن خاقان % % 53(@)(@@) % مستظهرات برأي لا يقوم له % % قصير عمرو ولا عمرو ووردان % % 54(@)(@@) % من كل قاتلة قتلى وآسرة % أسرى وليس لها في الأرض إثخان % 55(@)(@@) % يولين ما فيه إغرام وآونة % يولين ما فيه للمشعوف سلوان % % PageV01P4489 56(@)(@@) % ولا يدمن على عهد لمعتقد % % أنى وهن كما شبهن بستان % % 57(@)(@@) % يميل طورا بحمل ثم يعدمه % % ويكتسى ثم يلفى وهو عريان % % 58(@)(@@) % حالا فحالا كذا النسوان قاطبة % نواكث دينهن الدهر أديان % % 59(@)(@@) % يغدرن والغدر مقبوح يزينه % % للغاويات وللغافين شيطان % % 60(@)(@@) % تغدو الفتاة لها حل فإن غدرت % راحت ينافس فيها الحل خلان % % 61(@)(@@) % ما للحسان مسيئات بنا ولنا % % إلى المسيئات طول الدهر تحنان % % 62(@)(@@) % يصبحن والغدر بالخلصان في قرن % % حتى كأن ليس غير الغدر خلصان % % 63(@)(@@) % فإن تبعن بعهد قلن معذرة % % إنا نسينا وفي النسوان نسيان % % 64(@)(@@) % يكفي مطالبنا للذكر ناهية % أن اسمنا الغالب المشهور نسوان % % 65(@)(@@) % لا نلزم الذكر إنا لم نسم به % % ولا منحناه بل للذكر ذكران % % PageV01P4490 66(@)(@@) % فضل الرجال علينا 
ms1182	 أن شيمتهم % جود وبأس وأحلام وأذهان % % 67(@)(@@) % وأن فيهم وفاء لا نقوم به % % ولن يكون مع النقصان رجحان % % 68(@)(@@) % لا ندعي الفضل بل فينا لطائفة % منهم أبو الصقر تسليم وإذعان % % 69(@)(@@) % هو الذي توج الله الرجال به % % تيجان فخر وللتفضيل تيجان % % 70(@)(@@) % ألقى على كل رأس من رؤوسهم % تاجا مضاحكه در ومرجان % 71(@)(@@) % وقد سئلن أفيه ما يعاب له % % فقلن هيهات تلك العين عقيان % % 72(@)(@@) % لا عيب فيه لدينا غير منعته % % منا وأنى تصيد الصقر غزلان % % 73(@)(@@) % أضحى أبو الصقر صقرا لا تقنصه % وحشية من بنات الإنس مفتان % % 74(@)(@@) % هو الذي بت أسباب الهوى آنفا % % من أن تصيب أسود الغابة الضان % % 75(@)(@@) % رأى الشهاوى وطوق الرق وزمهم % وليس يعدم طوق الرق شهوان % % PageV01P4491 76(@)(@@) % ففكه فك حر عن مقلده % % صلت الجبين أشم الأنف عليان % % 77(@)(@@) % ولم يكن رجل الدنيا ليأسره % رخص البنان ضعيف الأسر وهنان % % 78(@)(@@) % صدقن ما شئن لكنا تقنصنا % % منهن عين تلاقينا وأدمان % % 79(@)(@@) % أنكى وأذكى حريقا في جوانحنا % % خلق من الماء والألوان نيران % % 80(@)(@@) % إذا ترقرقن والإشراق مضطرم % فيهن لم يملك الأسرار كتمان % % 81(@)(@@) % ماء ونار فقد غادرن كل فتى % لابسن وهو غزير الدمع حران % % 82(@)(@@) % تخصل منهن عين فهي باكية % ويستحر فؤاد وهو هيمان % % 83(@)(@@) % يارب حسانة منهن قد فعلت % سوءا وقد يفعل الأسواء حسان % % 84(@)(@@) % تشكي المحب وتلقى الدهر شاكية % كالقوس تضمي الرمايا وهي مرنان % % 85(@)(@@) % واصلت منها فتاة في خلائقها % % غدر وفي خلقها روض وغدران % % PageV01P4492 86(@)(@@) % هيفاء تكسى فتبدو وهي مرهفة % % خود تعرى فتبدو وهي مبدان % 87(@)(@@) % ترتج أردافها والمتن مندمج % % والكشح مضطمر والبطن طيان % % 88(@)(@@) % ألوف عطر تذكى وهي ذاكية % إذا أساءت جوار العطر أبدان % 89(@)(@@) % ثمامة المسك تلقى وهي نائية % % فنأيها بنميم المسك لقيان % % 90(@)(@@) % يغيم كل نهار من مجامرها % % ويشمس الليل منها فهو ضحيان % % 91(@)(@@) % كأنها وعثان الند يشملها % % شمس عليها ضبابات وأدجان % % 92(@)(@@) % شمس أظلت بليل لا نجوم له % إلا نجوم لها في النحر أثمان % % 93(@)(@@) % تنفل الطيب فضلا حين تفرضه 
ms1183	 % % فقرا إليه قتول الدل مدران % % 94(@)(@@) % وتلبس الحلي مجعولا لها عوذا % لا زينة بل بها عن ذاك غنيان % % 95(@)(@@) % لله يوم أرانيها وقد لبست % فيه شبابا عليها منه ريعان % % PageV01P4493 96(@)(@@) % وقد تردت على سربال بهجتها % % فرعا غذته الغوادي فهو فينان % % 97(@)(@@) % جاءت تثنى وقد راح المراح بها % % سكرى تغنى لها حسن وإحسان % 98(@)(@@) % كأنها غصن لدن بمروحة % فيه حمائم هاجتهن أشجان % 99(@)(@@) % إذا تمايل في ريح تلاعبه % ظلت طرابا لها سجع وإرنان % 100(@)(@@) % يا عاذلي أفيقا إنها أبدا % % عندي جديد وإن الخلق خلقان % % 101(@)(@@) % لا تلحياني وإياها على ضرعي % % وزهوها فكلا الأمرين ديدان % 102(@)(@@) % إني ملكت فلي بالرهق مسكنة % وملكت فلها بالملك طغيان % % 103(@)(@@) % ما كان أصفى نعيم العيش إذ غنيت % % نعم تجاورنا والدار نعمان % % 104(@)(@@) % إذ لا المنازل أطلال نسائلها % % ولا القواطن آجال وصيران % % 105(@)(@@) % ظلنا نقول وأشباه الحسان بها % % سقيا لعهدك والأشباه أعيان % % PageV01P4494 106(@)(@@) % بانوا فبان جميل الصبر بعدهم % فللدموع من العينين عينان % % 107(@)(@@) % لهم على العيس إمعان تشط بهم % % وللدموع على خدي إمعان % % 108(@)(@@) % لي مذ نأوا وجنة ريا بمشربها % % من عبرتي وفم ما عشت ظمان % % 109(@)(@@) % كأنما كل شيء بعد ظعنهم % فيما يرى قلبي المتبول أظعان % 110(@)(@@) % أصبحت ملك من أوطأته ملل % وخانك الود من مغناه ودان % % 111(@)(@@) % فاجمع همومك في هم تؤيده % بالعزم إن هموم الفسل شذان % 112(@)(@@) % واقصد بودك خلا ليس من ضلع % % عوجاء فيها بوشك الزيغ إيذان % % 113(@)(@@) % حان انتجاعك خرقا لا يكون له % % في البدل والمنع أحيان وأحيان % 114(@)(@@) % وآن قصدك ممتاحا وممتدحا % من كل آن لجدوى كفه آن % % 115(@)(@@) % إن الرحيل إلى من أنت آمله % أمر لمزمعه بالنجح إيقان % % PageV01P4495 116(@)(@@) % فادع القوافي ونص اليعملات له % % تجبك كل شرود وهي مذعان % % 117(@)(@@) % إن لم أزر ملكا أشجى الخطوب به % % فلم يلدني أبو الأملاك يونان % % 118(@)(@@) % بل إن تعدت فلم أحسن سياستها % % فلم يلدني أبو السواس ساسان % % 119(@)(@@) % أضحى أبو الصقر فردا لا نظير له % % بعد النبي ومن والت خراسان % % 120(@)(@@) % هو الذي 
ms1184	 حكمت قدما بسؤدده % عدنان ثم أجازت ذاك قحطان % 121(@)(@@) % قالوا أبو الصقر من شيبان قلت لهم % كلا لعمري ولكن منه شيبان % % 122(@)(@@) % وكم أب قد علا بابن ذرا شرف % % كما علا برسول الله عدنان % % 123(@)(@@) % تسمو الرجال بآباء وآونة % تسمو الرجال بأبناء وتزدان % % 124(@)(@@) % ولم أقصر بشيبان التي بلغت % بها المبالغ أعراق وأغصان % % 125(@)(@@) % لله شيبان قوما لا يشيبهم % روع إذا الروع شابت منه ولدان % % PageV01P4496 126(@)(@@) % لا يرهبون إذا الأبطال أرهبهم % % يوم عصيب وهم في السلم رهبان % % 127(@)(@@) % قوم سماحتهم غيث ونجدتهم % غوث وآراؤهم في الخطب شهبان % 128(@)(@@) % إذا رأيتهم أيقنت أنهم % للدين والملك أعلام وأركان % % 129(@)(@@) % لا ينطق الإفك والبهتان قائلهم % % بل قول عائبهم إفك وبهتان % % 130(@)(@@) % ولا يرى الظلم والعدوان فاعلهم % إلا إذا رابه ظلم وعدوان % % 131(@)(@@) % حلوا الفضاء ولم يبنوا فليس لهم % إلا القنا وإطار الأفق حيطان % % 132(@)(@@) % ولا حصون إذا ما آنسوا فزعا % إلا نصال معراة وخرصان % % 133(@)(@@) % وهل لذي العز غير العز مدخل % أم هل لذي المجد غير المجد بنيان % % 134(@)(@@) % بداهم أن رأؤا سيف بن ذي يزن % لم يغن عنه صروف الدهر غمدان % % 135(@)(@@) % تلقاهم ورماح الخط حولهم % كالأسد ألبسها الآجام خفان % % PageV01P4497 136(@)(@@) % لا كالبيوت بيوت حين تدخلها % % إذ لا كسكانها في الأرض سكان % % 137(@)(@@) % سود السرابيل من طول ادراعهم % بيض المجاسد والأعراض غران % % 138(@)(@@) % يكفي من الرجل والفرسان واحدهم % بأسا فواحدهم رجل وفرسان % % 139(@)(@@) % للحلم والرأي فيهم حين تخبرهم % شيخان صدق وللهيجاء فتيان % % 140(@)(@@) % وللسماح كهول لا كفاء لهم % يغشاهم الدهر سؤال وضيفان % 141(@)(@@) % لا ينفسون بمنفوس التلاد ولا % % يفدى لديهم شحوم الكوم ألبان % % 142(@)(@@) % قوم يحبون مبطان الضيوف وما % % فيهم على حبهم إياه مبطان % % 143(@)(@@) % بل كلهم لابس حلما ومنتزع أجنت لك الوجد أغصان وكثبان % فيهن نوعان تفاح ورمان % 144(@)(@@) % وفوق ذينك أعناب مهدلة % سود لهن من الظلماء ألوان % % 145(@)(@@) % وتحت هاتيك أعناب تلوح به % % أطرافهن قلوب القوم قنوان % PageV01P4498 146(@)(@@) % غصون بان عليها الدهر فاكهة % وما الفواكه مما يحمل البان % 147(@)(@@) % ونرجس 
ms1185	 بات ساري الطل يضربه % وأقحوان منير النور ريان % % 148(@)(@@) % ألفن من كل شيء طيب حسن % فهن فاكهة شتى وريحان % % 149(@)(@@) % ثمار صدق إذا عاينت ظاهرها % % لكنها حين تبلو الطعم خطبان % % 150(@)(@@) % بل حلوة مرة طورا يقال لها % % شهد وطورا يقول الناس ذيفان % % 151(@)(@@) % يا ليت شعري وليت غير مجدية % إلا استراحة قلب وهو أسوان % % 152(@)(@@) % لأي أمر مراد بالفتى جمعت % % تلك الفنون فضمتهن أفنان % % 153(@)(@@) % تجاورت في غصون لسن من شجر % لكن غصون لها وصل وهجران % % 154(@)(@@) % تلك الغصون اللواتي في أكمتها % % نعم وبؤس وأفراح وأحزان % % 155(@)(@@) % يبلو بها الله قوما كي يبين له % ذو الطاعة البر ممن فيه عصيان % % PageV01P4499 156(@)(@@) % وما ابتلاهم لإعنات ولا عبث % % ولا لجهل بما يطويه إبطان % 157(@)(@@) % لكن ليثبت في الأعناق حجته % ويحسن العفو والرحمن رحمن % % 158(@)(@@) % ومن عجائب ما يمنى الرجال به % % مستضعفات له منهن أقران % % 159(@)(@@) % مناضلات بنبل لا تقوم له % % كتائب الترك يزجيهن خاقان % % 160(@)(@@) % مستظهرات برأي لا يقوم به % % قصير عمرو ولا عمرو ووردان % % 161(@)(@@) % من كل قاتلة قتلى وآسرة % أسرى وليس لها في الأرض إثخان % 162(@)(@@) % يولين ما فيه إغرام وآونة % يولين ما فيه للمشعوف سلوان % % 163(@)(@@) % ولا يدمن على عهد لمعتقد % % أنى وهن كما شبهن بستان % % 164(@)(@@) % يميل طورا بحمل ثم يعدمه % % ويكتسى ثم يلفى وهو عريان % % 165(@)(@@) % حالا فحالا كذا النسوان قاطبة % نواكث دينهن الدهر أديان % % PageV01P4500 166(@)(@@) % يغدرن والغدر مقبوح يزينه % % للغاويات وللغافين شيطان % % 167(@)(@@) % تغدو الفتاة لها حل فإن غدرت % راحت ينافس فيها الحل خلان % % 168(@)(@@) % ما للحسان مسيئات بنا ولنا % % إلى المسيئات طول الدهر تحنان % % 169(@)(@@) % يصبحن والغدر بالخلصان في قرن % % حتى كأن ليس غير الغدر خلصان % % 170(@)(@@) % فإن تبعن بعهد قلن معذرة % % إنا نسينا وفي النسوان نسيان % % 171(@)(@@) % يكفي مطالبنا للذكر ناهية % أن اسمنا الغالب المشهور نسوان % % 172(@)(@@) % لا نلزم الذكر إنا لم نسم به % % ولا منحناه بل للذكر ذكران % % 173(@)(@@) % فضل الرجال علينا أن شيمتهم % جود وبأس وأحلام وأذهان % % 174(@)(@@) % وأن فيهم وفاء لا 
ms1186	 نقوم به % % ولن يكون مع النقصان رجحان % % 175(@)(@@) % لا ندعي الفضل بل فينا لطائفة % منهم أبو الصقر تسليم وإذعان % % PageV01P4501 176(@)(@@) % هو الذي توج الله الرجال به % % تيجان فخر وللتفضيل تيجان % % 177(@)(@@) % ألقى على كل رأس من رؤوسهم % تاجا مضاحكه در ومرجان % 178(@)(@@) % وقد سئلن أفيه ما يعاب له % % فقلن هيهات تلك العين عقيان % % 179(@)(@@) % لا عيب فيه لدينا غير منعته % % منا وأنى تصيد الصقر غزلان % % 180(@)(@@) % أضحى أبو الصقر صقرا لا تقنصه % وحشية من بنات الإنس مفتان % % 181(@)(@@) % هو الذي بت أسباب الهوى آنفا % % من أن تصيب أسود الغابة الضان % % 182(@)(@@) % رأى الشهاوى وطوق الرق وزمهم % وليس يعدم طوق الرق شهوان % % 183(@)(@@) % ففكه فك حر عن مقلده % % صلت الجبين أشم الأنف عليان % % 184(@)(@@) % ولم يكن رجل الدنيا ليأسره % رخص البنان ضعيف الأسر وهنان % % 185(@)(@@) % صدقن ما شئن لكنا تقنصنا % % منهن عين تلاقينا وأدمان % % PageV01P4502 186(@)(@@) % أنكى وأذكى حريقا في جوانحنا % % خلق من الماء والألوان نيران % % 187(@)(@@) % إذا ترقرقن والإشراق مضطرم % فيهن لم يملك الأسرار كتمان % % 188(@)(@@) % ماء ونار فقد غادرن كل فتى % لابسن وهو غزير الدمع حران % % 189(@)(@@) % تخصل منهن عين فهي باكية % ويستحر فؤاد وهو هيمان % % 190(@)(@@) % يارب حسانة منهن قد فعلت % سوءا وقد يفعل الأسواء حسان % % 191(@)(@@) % تشكي المحب وتلقى الدهر شاكية % كالقوس تضمي الرمايا وهي مرنان % % 192(@)(@@) % واصلت منها فتاة في خلائقها % % غدر وفي خلقها روض وغدران % % 193(@)(@@) % هيفاء تكسى فتبدو وهي مرهفة % % خود تعرى فتبدو وهي مبدان % 194(@)(@@) % ترتج أردافها والمتن مندمج % % والكشح مضطمر والبطن طيان % % 195(@)(@@) % ألوف عطر تذكى وهي ذاكية % إذا أساءت جوار العطر أبدان % PageV01P4503 196(@)(@@) % ثمامة المسك تلقى وهي نائية % % فنأيها بنميم المسك لقيان % % 197(@)(@@) % يغيم كل نهار من مجامرها % % ويشمس الليل منها فهو ضحيان % % 198(@)(@@) % كأنها وعثان الند يشملها % % شمس عليها ضبابات وأدجان % % 199(@)(@@) % شمس أظلت بليل لا نجوم له % إلا نجوم لها في النحر أثمان % % 200(@)(@@) % تنفل الطيب فضلا حين تفرضه % % فقرا إليه قتول الدل مدران % % 201(@)(@@) % وتلبس الحلي مجعولا لها عوذا 
ms1187	 % لا زينة بل بها عن ذاك غنيان % % 202(@)(@@) % لله يوم أرانيها وقد لبست % فيه شبابا عليها منه ريعان % % 203(@)(@@) % وقد تردت على سربال بهجتها % % فرعا غذته الغوادي فهو فينان % % 204(@)(@@) % جاءت تثنى وقد راح المراح بها % % سكرى تغنى لها حسن وإحسان % 205(@)(@@) % كأنها غصن لدن بمروحة % فيه حمائم هاجتهن أشجان % PageV01P4504 206(@)(@@) % إذا تمايل في ريح تلاعبه % ظلت طرابا لها سجع وإرنان % 207(@)(@@) % يا عاذلي أفيقا إنها أبدا % % عندي جديد وإن الخلق خلقان % % 208(@)(@@) % لا تلحياني وإياها على ضرعي % % وزهوها فكلا الأمرين ديدان % 209(@)(@@) % إني ملكت فلي بالرهق مسكنة % وملكت فلها بالملك طغيان % % 210(@)(@@) % ما كان أصفى نعيم العيش إذ غنيت % % نعم تجاورنا والدار نعمان % % 211(@)(@@) % إذ لا المنازل أطلال نسائلها % % ولا القواطن آجال وصيران % % 212(@)(@@) % ظلنا نقول وأشباه الحسان بها % % سقيا لعهدك والأشباه أعيان % % 213(@)(@@) % بانوا فبان جميل الصبر بعدهم % فللدموع من العينين عينان % % 214(@)(@@) % لهم على العيس إمعان تشط بهم % % وللدموع على خدي إمعان % % 215(@)(@@) % لي مذ نأوا وجنة ريا بمشربها % % من عبرتي وفم ما عشت ظمان % % PageV01P4505 216(@)(@@) % كأنما كل شيء بعد ظعنهم % فيما يرى قلبي المتبول أظعان % 217(@)(@@) % أصبحت ملك من أوطأته ملل % وخانك الود من مغناه ودان % % 218(@)(@@) % فاجمع همومك في هم تؤيده % بالعزم إن هموم الفسل شذان % 219(@)(@@) % واقصد بودك خلا ليس من ضلع % % عوجاء فيها بوشك الزيغ إيذان % % 220(@)(@@) % حان انتجاعك خرقا لا يكون له % % في البدل والمنع أحيان وأحيان % 221(@)(@@) % وآن قصدك ممتاحا وممتدحا % من كل آن لجدوى كفه آن % % 222(@)(@@) % إن الرحيل إلى من أنت آمله % أمر لمزمعه بالنجح إيقان % % 223(@)(@@) % فادع القوافي ونص اليعملات له % % تجبك كل شرود وهي مذعان % % 224(@)(@@) % إن لم أزر ملكا أشجى الخطوب به % % فلم يلدني أبو الأملاك يونان % % 225(@)(@@) % بل إن تعدت فلم أحسن سياستها % % فلم يلدني أبو السواس ساسان % % PageV01P4506 226(@)(@@) % أضحى أبو الصقر فردا لا نظير له % % بعد النبي ومن والت خراسان % % 227(@)(@@) % هو الذي حكمت قدما بسؤدده % عدنان ثم أجازت ذاك قحطان % 228(@)(@@) % قالوا أبو 
ms1188	 الصقر من شيبان قلت لهم % كلا لعمري ولكن منه شيبان % % 229(@)(@@) % وكم أب قد علا بابن ذرا شرف % % كما علا برسول الله عدنان % % 230(@)(@@) % تسمو الرجال بآباء وآونة % تسمو الرجال بأبناء وتزدان % % 231(@)(@@) % ولم أقصر بشيبان التي بلغت % بها المبالغ أعراق وأغصان % % 232(@)(@@) % لله شيبان قوما لا يشيبهم % روع إذا الروع شابت منه ولدان % % 233(@)(@@) % لا يرهبون إذا الأبطال أرهبهم % % يوم عصيب وهم في السلم رهبان % % 234(@)(@@) % قوم سماحتهم غيث ونجدتهم % غوث وآراؤهم في الخطب شهبان % 235(@)(@@) % إذا رأيتهم أيقنت أنهم % للدين والملك أعلام وأركان % % PageV01P4507 236(@)(@@) % لا ينطق الإفك والبهتان قائلهم % % بل قول عائبهم إفك وبهتان % % 237(@)(@@) % ولا يرى الظلم والعدوان فاعلهم % إلا إذا رابه ظلم وعدوان % % 238(@)(@@) % حلوا الفضاء ولم يبنوا فليس لهم % إلا القنا وإطار الأفق حيطان % % 239(@)(@@) % ولا حصون إذا ما آنسوا فزعا % إلا نصال معراة وخرصان % % 240(@)(@@) % وهل لذي العز غير العز مدخل % أم هل لذي المجد غير المجد بنيان % % 241(@)(@@) % بداهم أن رأؤا سيف بن ذي يزن % لم يغن عنه صروف الدهر غمدان % % 242(@)(@@) % تلقاهم ورماح الخط حولهم % كالأسد ألبسها الآجام خفان % % 243(@)(@@) % لا كالبيوت بيوت حين تدخلها % % إذ لا كسكانها في الأرض سكان % % 244(@)(@@) % سود السرابيل من طول ادراعهم % بيض المجاسد والأعراض غران % % 245(@)(@@) % يكفي من الرجل والفرسان واحدهم % بأسا فواحدهم رجل وفرسان % % PageV01P4508 246(@)(@@) % للحلم والرأي فيهم حين تخبرهم % شيخان صدق وللهيجاء فتيان % % 247(@)(@@) % وللسماح كهول لا كفاء لهم % يغشاهم الدهر سؤال وضيفان % 248(@)(@@) % لا ينفسون بمنفوس التلاد ولا % % يفدى لديهم شحوم الكوم ألبان % % 249(@)(@@) % قوم يحبون مبطان الضيوف وما % % فيهم على حبهم إياه مبطان % % 250(@)(@@) % بل كلهم لابس حلما ومنتزع % رأيا ومطعام أضياف ومطعان % 251(@)(@@) % وأريحي إذا جادت أنامله % في المحل لم يستبن للغيث فقدان % % 252(@)(@@) % يشتو ولا ريحه للنازلين به % صر ولا قطره للقوم شفان % % 253(@)(@@) % وكيف يبخل من نيطت به شيم % تقضي بأن ليس غير البذل قنيان % % 254(@)(@@) % وإن حاصل ما جادت يدا رجل % % ما حملت ألسن منه وآذان % % 255(@)(@@) % جود 
ms1189	 البحار وأحلام الجبل لهم % % وهم لدى الروع آساد وجنان % % PageV01P4509 256(@)(@@) % وليس يعدم فيهم من يشاورهم % من يقتدى رأيه والنجم حيران % % 257(@)(@@) % قوم أياديهم مثنى بصفحهم % عن ذكرها وأيادي الناس أحدان % % 258(@)(@@) % طالوا ونيلت مجانيهم بلا تعب % فهم أشاء وهم إن شئت عيدان % % 259(@)(@@) % لم يمس قط ولم يصبح محلهم % إلا التقى فيه إيتاء وإتيان % % 260(@)(@@) % إيتاء عاف وإتيان ابن مكرمة % % منه نوال ومن عافيه غشيان % % 261(@)(@@) % يا رب قاطع بلدان أناخ بهم % علما بأن صدور القوم بلدان % % 262(@)(@@) % وسائل عنهم ماذا يقدمهم % فقلت فضل به من غيرهم بانوا % % 263(@)(@@) % صانوا النفوس عن الفحشاء وابتذلوا % % منهن في سبل العلياء ما صانوا % % 264(@)(@@) % لا توحش الأرض من شيبان إنهم % قوم يكونون حيث المجد مذ كانوا % % 265(@)(@@) % المنعمين وما منوا على أحد % يوما بنعمى ولو منوا لما مانوا % % PageV01P4510 266(@)(@@) % قوم يعزون ما كانت مغالبة % حتى إذا قدرت أيديهم هانوا % % 267(@)(@@) % كم عرضوا للمنايا الحمر أنفسهم % فحان قوم توقوها وما حانوا % % 268(@)(@@) % وقاهم الجد ثم الجد بل حرسوا % % بأنهم ما أتوا غدرا وما خانوا % % 269(@)(@@) % كساهم العز أن عروا مناصلهم % % فما لها غير هام الصيد أجفان % % 270(@)(@@) % وألهج الحمد بالإيطان بينهم % أن ليس بينهم للمال إيطال % % 271(@)(@@) % أقنوا عداهم وأقنوا من يؤملهم % % ففي الصدور لهم شكر وأضغان % % 272(@)(@@) % لكن أبو الصقر بدء عند ذكرهم % وسادة الناس أبداء وثنيان % % 273(@)(@@) % فرد جميع يراه كل ذي بصره أجنت لك الوجد أغصان وكثبان % فيهن نوعان تفاح ورمان % 274(@)(@@) % وفوق ذينك أعناب مهدلة % سود لهن من الظلماء ألوان % % 275(@)(@@) % وتحت هاتيك أعناب تلوح به % % أطرافهن قلوب القوم قنوان % PageV01P4511 276(@)(@@) % غصون بان عليها الدهر فاكهة % وما الفواكه مما يحمل البان % 277(@)(@@) % ونرجس بات ساري الطل يضربه % وأقحوان منير النور ريان % % 278(@)(@@) % ألفن من كل شيء طيب حسن % فهن فاكهة شتى وريحان % % 279(@)(@@) % ثمار صدق إذا عاينت ظاهرها % % لكنها حين تبلو الطعم خطبان % % 280(@)(@@) % بل حلوة مرة طورا يقال لها % % شهد وطورا يقول الناس ذيفان % % 281(@)(@@) % يا ليت شعري وليت 
ms1190	 غير مجدية % إلا استراحة قلب وهو أسوان % % 282(@)(@@) % لأي أمر مراد بالفتى جمعت % % تلك الفنون فضمتهن أفنان % % 283(@)(@@) % تجاورت في غصون لسن من شجر % لكن غصون لها وصل وهجران % % 284(@)(@@) % تلك الغصون اللواتي في أكمتها % % نعم وبؤس وأفراح وأحزان % % 285(@)(@@) % يبلو بها الله قوما كي يبين له % ذو الطاعة البر ممن فيه عصيان % % PageV01P4512 286(@)(@@) % وما ابتلاهم لإعنات ولا عبث % % ولا لجهل بما يطويه إبطان % 287(@)(@@) % لكن ليثبت في الأعناق حجته % ويحسن العفو والرحمن رحمن % % 288(@)(@@) % ومن عجائب ما يمنى الرجال به % % مستضعفات له منهن أقران % % 289(@)(@@) % مناضلات بنبل لا تقوم له % % كتائب الترك يزجيهن خاقان % % 290(@)(@@) % مستظهرات برأي لا يقوم به % % قصير عمرو ولا عمرو ووردان % % 291(@)(@@) % من كل قاتلة قتلى وآسرة % أسرى وليس لها في الأرض إثخان % 292(@)(@@) % يولين ما فيه إغرام وآونة % يولين ما فيه للمشعوف سلوان % % 293(@)(@@) % ولا يدمن على عهد لمعتقد % % أنى وهن كما شبهن بستان % % 294(@)(@@) % يميل طورا بحمل ثم يعدمه % % ويكتسى ثم يلفى وهو عريان % % 295(@)(@@) % حالا فحالا كذا النسوان قاطبة % نواكث دينهن الدهر أديان % % PageV01P4513 296(@)(@@) % يغدرن والغدر مقبوح يزينه % % للغاويات وللغافين شيطان % % 297(@)(@@) % تغدو الفتاة لها حل فإن غدرت % راحت ينافس فيها الحل خلان % % 298(@)(@@) % ما للحسان مسيئات بنا ولنا % % إلى المسيئات طول الدهر تحنان % % 299(@)(@@) % يصبحن والغدر بالخلصان في قرن % % حتى كأن ليس غير الغدر خلصان % % 300(@)(@@) % فإن تبعن بعهد قلن معذرة % % إنا نسينا وفي النسوان نسيان % % 301(@)(@@) % يكفي مطالبنا للذكر ناهية % أن اسمنا الغالب المشهور نسوان % % 302(@)(@@) % لا نلزم الذكر إنا لم نسم به % % ولا منحناه بل للذكر ذكران % % 303(@)(@@) % فضل الرجال علينا أن شيمتهم % جود وبأس وأحلام وأذهان % % 304(@)(@@) % وأن فيهم وفاء لا نقوم به % % ولن يكون مع النقصان رجحان % % 305(@)(@@) % لا ندعي الفضل بل فينا لطائفة % منهم أبو الصقر تسليم وإذعان % % PageV01P4514 306(@)(@@) % هو الذي توج الله الرجال به % % تيجان فخر وللتفضيل تيجان % % 307(@)(@@) % ألقى على كل رأس من رؤوسهم % تاجا مضاحكه در ومرجان % 308(@)(@@) % وقد سئلن أفيه ما يعاب 
ms1191	 له % % فقلن هيهات تلك العين عقيان % % 309(@)(@@) % لا عيب فيه لدينا غير منعته % % منا وأنى تصيد الصقر غزلان % % 310(@)(@@) % أضحى أبو الصقر صقرا لا تقنصه % وحشية من بنات الإنس مفتان % % 311(@)(@@) % هو الذي بت أسباب الهوى آنفا % % من أن تصيب أسود الغابة الضان % % 312(@)(@@) % رأى الشهاوى وطوق الرق وزمهم % وليس يعدم طوق الرق شهوان % % 313(@)(@@) % ففكه فك حر عن مقلده % % صلت الجبين أشم الأنف عليان % % 314(@)(@@) % ولم يكن رجل الدنيا ليأسره % رخص البنان ضعيف الأسر وهنان % % 315(@)(@@) % صدقن ما شئن لكنا تقنصنا % % منهن عين تلاقينا وأدمان % % PageV01P4515 316(@)(@@) % أنكى وأذكى حريقا في جوانحنا % % خلق من الماء والألوان نيران % % 317(@)(@@) % إذا ترقرقن والإشراق مضطرم % فيهن لم يملك الأسرار كتمان % % 318(@)(@@) % ماء ونار فقد غادرن كل فتى % لابسن وهو غزير الدمع حران % % 319(@)(@@) % تخصل منهن عين فهي باكية % ويستحر فؤاد وهو هيمان % % 320(@)(@@) % يارب حسانة منهن قد فعلت % سوءا وقد يفعل الأسواء حسان % % 321(@)(@@) % تشكي المحب وتلقى الدهر شاكية % كالقوس تضمي الرمايا وهي مرنان % % 322(@)(@@) % واصلت منها فتاة في خلائقها % % غدر وفي خلقها روض وغدران % % 323(@)(@@) % هيفاء تكسى فتبدو وهي مرهفة % % خود تعرى فتبدو وهي مبدان % 324(@)(@@) % ترتج أردافها والمتن مندمج % % والكشح مضطمر والبطن طيان % % 325(@)(@@) % ألوف عطر تذكى وهي ذاكية % إذا أساءت جوار العطر أبدان % PageV01P4516 326(@)(@@) % ثمامة المسك تلقى وهي نائية % % فنأيها بنميم المسك لقيان % % 327(@)(@@) % يغيم كل نهار من مجامرها % % ويشمس الليل منها فهو ضحيان % % 328(@)(@@) % كأنها وعثان الند يشملها % % شمس عليها ضبابات وأدجان % % 329(@)(@@) % شمس أظلت بليل لا نجوم له % إلا نجوم لها في النحر أثمان % % 330(@)(@@) % تنفل الطيب فضلا حين تفرضه % % فقرا إليه قتول الدل مدران % % 331(@)(@@) % وتلبس الحلي مجعولا لها عوذا % لا زينة بل بها عن ذاك غنيان % % 332(@)(@@) % لله يوم أرانيها وقد لبست % فيه شبابا عليها منه ريعان % % 333(@)(@@) % وقد تردت على سربال بهجتها % % فرعا غذته الغوادي فهو فينان % % 334(@)(@@) % جاءت تثنى وقد راح المراح بها % % سكرى تغنى لها حسن وإحسان % 335(@)(@@) % كأنها غصن لدن بمروحة % فيه 
ms1192	 حمائم هاجتهن أشجان % PageV01P4517 336(@)(@@) % إذا تمايل في ريح تلاعبه % ظلت طرابا لها سجع وإرنان % 337(@)(@@) % يا عاذلي أفيقا إنها أبدا % % عندي جديد وإن الخلق خلقان % % 338(@)(@@) % لا تلحياني وإياها على ضرعي % % وزهوها فكلا الأمرين ديدان % 339(@)(@@) % إني ملكت فلي بالرهق مسكنة % وملكت فلها بالملك طغيان % % 340(@)(@@) % ما كان أصفى نعيم العيش إذ غنيت % % نعم تجاورنا والدار نعمان % % 341(@)(@@) % إذ لا المنازل أطلال نسائلها % % ولا القواطن آجال وصيران % % 342(@)(@@) % ظلنا نقول وأشباه الحسان بها % % سقيا لعهدك والأشباه أعيان % % 343(@)(@@) % بانوا فبان جميل الصبر بعدهم % فللدموع من العينين عينان % % 344(@)(@@) % لهم على العيس إمعان تشط بهم % % وللدموع على خدي إمعان % % 345(@)(@@) % لي مذ نأوا وجنة ريا بمشربها % % من عبرتي وفم ما عشت ظمان % % PageV01P4518 346(@)(@@) % كأنما كل شيء بعد ظعنهم % فيما يرى قلبي المتبول أظعان % 347(@)(@@) % أصبحت ملك من أوطأته ملل % وخانك الود من مغناه ودان % % 348(@)(@@) % فاجمع همومك في هم تؤيده % بالعزم إن هموم الفسل شذان % 349(@)(@@) % واقصد بودك خلا ليس من ضلع % % عوجاء فيها بوشك الزيغ إيذان % % 350(@)(@@) % حان انتجاعك خرقا لا يكون له % % في البدل والمنع أحيان وأحيان % 351(@)(@@) % وآن قصدك ممتاحا وممتدحا % من كل آن لجدوى كفه آن % % 352(@)(@@) % إن الرحيل إلى من أنت آمله % أمر لمزمعه بالنجح إيقان % % 353(@)(@@) % فادع القوافي ونص اليعملات له % % تجبك كل شرود وهي مذعان % % 354(@)(@@) % إن لم أزر ملكا أشجى الخطوب به % % فلم يلدني أبو الأملاك يونان % % 355(@)(@@) % بل إن تعدت فلم أحسن سياستها % % فلم يلدني أبو السواس ساسان % % PageV01P4519 356(@)(@@) % أضحى أبو الصقر فردا لا نظير له % % بعد النبي ومن والت خراسان % % 357(@)(@@) % هو الذي حكمت قدما بسؤدده % عدنان ثم أجازت ذاك قحطان % 358(@)(@@) % قالوا أبو الصقر من شيبان قلت لهم % كلا لعمري ولكن منه شيبان % % 359(@)(@@) % وكم أب قد علا بابن ذرا شرف % % كما علا برسول الله عدنان % % 360(@)(@@) % تسمو الرجال بآباء وآونة % تسمو الرجال بأبناء وتزدان % % 361(@)(@@) % ولم أقصر بشيبان التي بلغت % بها المبالغ أعراق وأغصان % % 362(@)(@@) % لله شيبان قوما لا 
ms1193	 يشيبهم % روع إذا الروع شابت منه ولدان % % 363(@)(@@) % لا يرهبون إذا الأبطال أرهبهم % % يوم عصيب وهم في السلم رهبان % % 364(@)(@@) % قوم سماحتهم غيث ونجدتهم % غوث وآراؤهم في الخطب شهبان % 365(@)(@@) % إذا رأيتهم أيقنت أنهم % للدين والملك أعلام وأركان % % PageV01P4520 366(@)(@@) % لا ينطق الإفك والبهتان قائلهم % % بل قول عائبهم إفك وبهتان % % 367(@)(@@) % ولا يرى الظلم والعدوان فاعلهم % إلا إذا رابه ظلم وعدوان % % 368(@)(@@) % حلوا الفضاء ولم يبنوا فليس لهم % إلا القنا وإطار الأفق حيطان % % 369(@)(@@) % ولا حصون إذا ما آنسوا فزعا % إلا نصال معراة وخرصان % % 370(@)(@@) % وهل لذي العز غير العز مدخل % أم هل لذي المجد غير المجد بنيان % % 371(@)(@@) % بداهم أن رأؤا سيف بن ذي يزن % لم يغن عنه صروف الدهر غمدان % % 372(@)(@@) % تلقاهم ورماح الخط حولهم % كالأسد ألبسها الآجام خفان % % 373(@)(@@) % لا كالبيوت بيوت حين تدخلها % % إذ لا كسكانها في الأرض سكان % % 374(@)(@@) % سود السرابيل من طول ادراعهم % بيض المجاسد والأعراض غران % % 375(@)(@@) % يكفي من الرجل والفرسان واحدهم % بأسا فواحدهم رجل وفرسان % % PageV01P4521 376(@)(@@) % للحلم والرأي فيهم حين تخبرهم % شيخان صدق وللهيجاء فتيان % % 377(@)(@@) % وللسماح كهول لا كفاء لهم % يغشاهم الدهر سؤال وضيفان % 378(@)(@@) % لا ينفسون بمنفوس التلاد ولا % % يفدى لديهم شحوم الكوم ألبان % % 379(@)(@@) % قوم يحبون مبطان الضيوف وما % % فيهم على حبهم إياه مبطان % % 380(@)(@@) % بل كلهم لابس حلما ومنتزع % رأيا ومطعام أضياف ومطعان % 381(@)(@@) % وأريحي إذا جادت أنامله % في المحل لم يستبن للغيث فقدان % % 382(@)(@@) % يشتو ولا ريحه للنازلين به % صر ولا قطره للقوم شفان % % 383(@)(@@) % وكيف يبخل من نيطت به شيم % تقضي بأن ليس غير البذل قنيان % % 384(@)(@@) % وإن حاصل ما جادت يدا رجل % % ما حملت ألسن منه وآذان % % 385(@)(@@) % جود البحار وأحلام الجبل لهم % % وهم لدى الروع آساد وجنان % % PageV01P4522 386(@)(@@) % وليس يعدم فيهم من يشاورهم % من يقتدى رأيه والنجم حيران % % 387(@)(@@) % قوم أياديهم مثنى بصفحهم % عن ذكرها وأيادي الناس أحدان % % 388(@)(@@) % طالوا ونيلت مجانيهم بلا تعب % فهم أشاء وهم إن شئت عيدان % % 389(@)(@@) % لم يمس قط ولم 
ms1194	 يصبح محلهم % إلا التقى فيه إيتاء وإتيان % % 390(@)(@@) % إيتاء عاف وإتيان ابن مكرمة % % منه نوال ومن عافيه غشيان % % 391(@)(@@) % يا رب قاطع بلدان أناخ بهم % علما بأن صدور القوم بلدان % % 392(@)(@@) % وسائل عنهم ماذا يقدمهم % فقلت فضل به من غيرهم بانوا % % 393(@)(@@) % صانوا النفوس عن الفحشاء وابتذلوا % % منهن في سبل العلياء ما صانوا % % 394(@)(@@) % لا توحش الأرض من شيبان إنهم % قوم يكونون حيث المجد مذ كانوا % % 395(@)(@@) % المنعمين وما منوا على أحد % يوما بنعمى ولو منوا لما مانوا % % PageV01P4523 396(@)(@@) % قوم يعزون ما كانت مغالبة % حتى إذا قدرت أيديهم هانوا % % 397(@)(@@) % كم عرضوا للمنايا الحمر أنفسهم % فحان قوم توقوها وما حانوا % % 398(@)(@@) % وقاهم الجد ثم الجد بل حرسوا % % بأنهم ما أتوا غدرا وما خانوا % % 399(@)(@@) % كساهم العز أن عروا مناصلهم % % فما لها غير هام الصيد أجفان % % 400(@)(@@) % وألهج الحمد بالإيطان بينهم % أن ليس بينهم للمال إيطال % % 401(@)(@@) % أقنوا عداهم وأقنوا من يؤملهم % % ففي الصدور لهم شكر وأضغان % % 402(@)(@@) % لكن أبو الصقر بدء عند ذكرهم % وسادة الناس أبداء وثنيان % % 403(@)(@@) % فرد جميع يراه كل ذي بصر % % كأنه الناس طرا وهو إنسان % % 404(@)(@@) % أغر أبلج ما زالت لمادحه % % دعوى عليها لفضل فيه برهان % % 405(@)(@@) % له محيا جميل تستدل به % % على جميل وللبطنان ظهران % PageV01P4524 406(@)(@@) % وقل من ضمنت خيرا طويته % إلا وفي وجهه للخير عنوان % % 407(@)(@@) % يلقاك وهو مع الإحسان معتذر % وقد يسيىء مسيء وهو منان % % 408(@)(@@) % زمانه بنداه ممرع خصب % % كأنه من شهور الحول نيسان % % 409(@)(@@) % أضحى وما شاب يدعوه الأنام أبا % بحقه وهم شيب وشبان % % 410(@)(@@) % تقدم الناس طرا في مذاهبه % وإن تقدم تلك السن أسنان % % 411(@)(@@) % وذي وسائل يزجيهن قلت له % % انبذ رشاءك إن الماء طوفان % % 412(@)(@@) % ياذا الوسائل إن المستقى رفق % ليست له غير أيدي الناس أشطان % % 413(@)(@@) % يممت يما أساح الله لجته % في أرضه فخراب الأرض عمران % 414(@)(@@) % ما من جديب ولا صديان نعلمه % % وكيف يلفى مع الطوفان صديان % % 415(@)(@@) % لاقى رجالا ذوي مجد قد اغتبقوا % % آساره ولقوه وهو 
ms1195	 صبحان % % PageV01P4525 416(@)(@@) % يضحي وليس على أخلاقه طبع % ولا على الغر من آرائه ران % % 417(@)(@@) % اعفى البرية عن جرم وأجملها % % صفحا وإن سيم وترا فهو ثعبان % % 418(@)(@@) % ما إن يزال إزاء الوتر يوتره % % نقض ومنه إزاء الذنب غفران % % 419(@)(@@) % يستحسن العفو إلا عن منابذة % في العفو عنها لركن العز إيهان % % 420(@)(@@) % وهاب ما يأمن العقبان واهبه % طلاب ما للتغاضي عنه عقبان % % 421(@)(@@) % إذا بدا وجه ذنب فهو ذو سنة % وإن بدا وجه خطب فهو يقظان % 422(@)(@@) % يقظان من روع وسنان من ورع % % يا حبذا سيد يقظان وسنان % % 423(@)(@@) % مفكر قبل صبح الرأي متئد % % مشمر بعد صبح الرأي شيحان % % 424(@)(@@) % تلقاه لا هو من سراء خادعة % غر ولا هو من ضراء قرحان % % 425(@)(@@) % يجل عن أن تحل الدهر حبوته % يوما إذا طاش مفراح ومحزان % % PageV01P4526 426(@)(@@) % ما خف قط لتصريف يصرفه % وهل يخف لنفخ الريح ثهلان % % 427(@)(@@) % يا من يبيت على مجرى مكائده % نكب لك الويل عنها فهي حسبان % 428(@)(@@) % ذو حكمة وبيان جل قدرهما % % ففيه لقمان مجموع وسحبان % % 429(@)(@@) % وما لسحبان جزء من سماحته % ولا للقمان لو جاراه لقمان % % 430(@)(@@) % ساواهما في الحجى واحتاز دونهما % % فضل الندى فله في الفضل سهمان % % 431(@)(@@) % معان عرف وعرفان وقل فتى % في عصره عنده عرف وعرفان % % 432(@)(@@) % مساءل القلب مسؤول اليدين معا % كلا وعاءيه للممتاح ملان % % 433(@)(@@) % صاحي الطباع إذا ساءلت هاجسه % وإن سألت يديه فهو نشوان % % 434(@)(@@) % يصحيه ذهن ويأبى صحوه كرم % مستحكم فهو صاح وهو سكران % 435(@)(@@) % لا يعدم الدهر صحوا يستبين به % % حقا عليه من الإلباس أكنان % % PageV01P4527 436(@)(@@) % وينطق المنطق المفتون سامعه % والمنطق الحسن المسوع فتان % % 437(@)(@@) % وليس ينفك من شكر يظل له % % من راحتيه على العافين تهتان % % 438(@)(@@) % شكر ولكنه من شيمة كرمت % لا من كؤوس تعاطاهن ندمان % % 439(@)(@@) % يجود حتى يقول المفرطون له % % قد كاد أن يخلف الطوفان طوفان % % 440(@)(@@) % تعتاده هزة للجود بينة % فيه إذا اعتاده للعرف لهفان % % 441(@)(@@) % ريح تهب له من أريحيته % % يهتز للبذل عنها وهو جذلان % % 442 
ms1196	(@)(@@) % يهتز حتى تراه هزه طرب % هاجته كأس رنوناة وألحان % 443(@)(@@) % كم ضن بالفرض أقوام وعندهم % وفر وأعطى العطايا وهو يدان % % 444(@)(@@) % ثنى إليه طلى الأحرار أن له % عهدا وفيا وأن الدهر خوان % % 445(@)(@@) % وساق كل عفيف نحو نائله % % مقاله أنا والعافون إخوان % % PageV01P4528 446(@)(@@) % أضحى غريبا ولم يحلل بقاصية % من البلاد ولا مجته أوطان % % 447(@)(@@) % بل غربته خلال لم يدعن له % شبها وللناس أشباه وأخدان % % 448(@)(@@) % يفديه من فيه عن مقدار فديته % % عند المفاداة تقصير ونقصان % % 449(@)(@@) % قوم كأنهم موتى إذا مدحوا % % وماكسوا من حبير الشعر أكفان % % 450(@)(@@) % ثوابهم أن يمنوا مستثيبهم % وهل يثيب على الأعمال أوثان % % 451(@)(@@) % لله مختاره ما كان أعلمه % بكل ما فيه للرحمن رضوان % % 452(@)(@@) % ما اختار إلا امرءا أضحت فضائله % % يثنى عليه بها راض وغضبان % % 453(@)(@@) % رأى أبا الصقر صقرا في شهامته % فاختار من فيه للمختار قنعان % % 454(@)(@@) % من لا يزال لديه من مذاهبه % بين الرشاد وبين الغي فرقان % % 455(@)(@@) % طرف من الخيل يمتد الجراء به % % في غير كبو إذا ما امتد ميدان % % PageV01P4529 456(@)(@@) % وللموفق تبصير يبصره % بالخط والناس طر ا عنه عميان % % 457(@)(@@) % أهدى إليه وزيرا ذا مناصحة % لم يختلف منه إسرار وإعلان % % 458(@)(@@) % أضحى به بين توقير وعافية % من المآثم لا يلحاه ديان % 459(@)(@@) % وكم أمير رأيناه تكنفه % في الدين والمال آتياع وخسران % % 460(@)(@@) % يجبي له الإثم والأموال عامله % فالإثم يحصل والأموال تختان % % 461(@)(@@) % حاشى الموفق إن الله صائنه % % عن ذاك والله للأخيار صوان % % 462(@)(@@) % تلكم أمور ولي العهد ينظمها % % نظم القلادة إحكام وإتقان % 463(@)(@@) % في كف كاف أمين غير متهم % % غنى بذلك مشاء وركبان % % 464(@)(@@) % فالمجتبى مجتبى في كل ناحية % كانت مناهب والديوان ديوان % % 465(@)(@@) % يامن إذا الناس ظنوا أن نائله % قد سال سائله فالناس كهان % % PageV01P4530 466(@)(@@) % إني رأيت سؤال الباخلين زنا % وفي سؤالك للأحرار إحصان % % 467(@)(@@) % إذا تيممك العافي فكوكبه % سعد ومرعاه في واديك سعدان % % 468(@)(@@) % إليك جاءت بوحش الشعر تحملها % % حوش المطي الذي يعتام حيدان % % 469(@)(@@) % جاءت بكل شرود كل ناحية 
ms1197	 % كعاصف الريح يحدوها سليمان % % 470(@)(@@) % ألحاظ برق إذا لاحت مهجرة % واستوقدت من أوار الشمس حران % % 471(@)(@@) % همت بأن تظلم الظلمان سرعتها % % وكاد يظلمها من قال ظلمان % % 472(@)(@@) % تطوي الفلا وكأن الآل أردية % وتارة وكأن الليل سيجان % 473(@)(@@) % كأنها في ضحاضيح الضحى سفن % وفي الغمار من الظلماء حيتان % % 474(@)(@@) % ترجوك يا من غدا للناس وهو أب % ولم تشب وهم شيب وشبان % % 475(@)(@@) % بل أيها السيد الممنوح ثروته % % ملكا صحيحا إذا المثرون خزان % % PageV01P4531 476(@)(@@) % تبيان ذلك أن أطلقت تبذلها % % بدءا وعودا وللأشياء تبيان % % 477(@)(@@) % وما غللت بغل البخل عن كرم % % وقد يغل بغل البخل أيمان % % 478(@)(@@) % أحيى بك الله هذا الخلق كلهم % % فأنت روح وهذا الخلق جثمان % % 479(@)(@@) % وقد ظننت وحول الله يعصمني % % من ذاك أن نصيبي منك حرمان % % 480(@)(@@) % أساء بي منك محسان وما شجيت % نفس بمثل مسيء وهو محسان % % 481(@)(@@) % ضاقت بلواي أعطاني بما رحبت % ولن تضيق بغوثي منك أعطان % 482(@)(@@) % يشكوك شعري ويستعديك يا حكمي % % ويا خصيمي ويا من شأنه الشان % % 483(@)(@@) % وما لمثلك يستعدي مؤمله % أنى وعدلك بين الناس ميزان % % 484(@)(@@) % أنت الذي عدلت في الأرض سيرته % حتى توارد يعفور وسرحان % % 485(@)(@@) % وأنصف الناس منه أنه رجل % يخيفه الله إسلام وإيمآن % % PageV01P4532 486(@)(@@) % وأسعد الناس سلطان له ورع % عليه منه لأهل الحق سلطان % % 487(@)(@@) % ما بال شعري لم توزن مثوبته % % وقد مضت منه أوزان وأوزان % 488(@)(@@) % أمثل شعري يلوى حقه وله % % عليك من خيمك المحمود أعوان % % 489(@)(@@) % أم وعد مثلك لا يجبى لآمله % وقد تهادته أزمان وأزمان % % 490(@)(@@) % مالي لديك كأني قد زرعت حصى % في عام جدب وظهر الأرض صفوان % % 491(@)(@@) % أما لزرعي إبان فأنظره % حتى يريع كما للزرع إبان % % 492(@)(@@) % أعائذ بك يستسقي بمعطشة % وفي يمينك سيحان وجيحان % % 493(@)(@@) % في راحتيك من اليمين لجهما % % وفي بنانك أنهار وخلجان % % 494(@)(@@) % وقد يسوف بالإسقاء ذو ظمأ % % ولن يسوف بالإسقاء غصان % % 495(@)(@@) % وبي صدى وبحلقي غصة برج % % فاعجل بغوثك إن الريث خذلان % % PageV01P4533 496(@)(@@) % وليس مثلك بالمخذول أمله % % إذا أطاع جميل الفعل 
ms1198	 إمكان % % 497(@)(@@) % إن لا يكن وجد حر ملء همته % % فقد يمد وعاء وهو نصفان % % 498(@)(@@) % ما حمد من جاد إن كظته ثروته % % ما الحمد إلا لمعط وهو خمصان % % 499(@)(@@) % نول فإنك مجزي وإن معي % % شكرا إذا شئت لم يخلطه كفران % % 500(@)(@@) % وإن أبيت فحسبي منك عارفة % أن امتداحك عند الله قربان % % 501(@)(@@) % والحر يسغب دهرا وهو ذو سعة % % والعف يطوي زمانا وهو سغبان % 502(@)(@@) % وللبلاء انفراج بعد أمنة % ورعية الدهر إعجاف وإسمان % % 503(@)(@@) % وللإله سجال من فواضله % كل امرىء ناهل منها وعلان % % 504(@)(@@) % إن لا يعني على دهري أخو ثقة % من العباد فإن الله معوان % % 505(@)(@@) % أو يبطل الحق بين الناس كلهم % فليس للحق عند الله بطلان % % PageV01P4534 506(@)(@@) % خذها أبا الصقر بكرا ذات أوشية % كالروض ناصى عرارا فيه حوذان % % 507(@)(@@) % واسلم لراجيك مسعودا وإن تربت % ممن يعاديك آناف وأذقان % % PageV01P4535 البحر : - 1(@)(@@) % أطلع الله وجه شهرك هذا % % يابن يحيى كوجهك الميمون % 2(@)(@@) % ثم جلاه عن عواقب صدق % غيبها مثل غيبك المأمون % % 3(@)(@@) % فلعمري لما أظلك إلا % % مخبت الجهر مخلص المكنون % % 4(@)(@@) % كالذي لم تزل عليه قديما % من صيام ومن تجافي جفون % % 5(@)(@@) % ما تعديت فيه ما في سواه % من سجايا معروفة لك عون % % 6(@)(@@) % صمت فيه وقمت بعد صيام % وقيام من قبله غير دون % % 7(@)(@@) % لم يصم فوك دون عينيك فيه % كصيام الأفواه دون العيون % % 8(@)(@@) % بل تغاضيت فيه عن حرم الل % ه فلم ترمها بطرف شفون % % 9(@)(@@) % وكعمت اللسان عن كل هجر % وحميت الضمير رجم الظنون % % 10(@)(@@) % والحكيم العليم بالله معصو % % م وليس المعصوم كالمفتون % % PageV01P4536 11(@)(@@) % ما شكا منك حاش لله ما تش % % كوه من ذي تمرد ومجون % % 12(@)(@@) % لا ولا كثرة التأفف منه % % مثل ما يفعل الرغاب البطون % % 13(@)(@@) % فانضه سالما عليه موقى % % بنحور العدا سهام المنون % % 14(@)(@@) % خفف الله ثقله عنك ثقلا % مع أجر عليه لاممنون % % PageV01P4537 البحر : - 1(@)(@@) % ألا يا ند هند لك في قمد % % غليظ تفرحين به متين % % 2(@)(@@) % يشك به حشاك غلام نيك % % من الفتيان منقطع 
ms1199	 القرين % % 3(@)(@@) % تذكر بالقمد العرد حتى % % تأنت بغتة قبل اليقين % % 4(@)(@@) % فمن يره يبول يخله أنثى % % بدا من فرجها ثلثا جنين % % PageV01P4538 البحر : - 1(@)(@@) % يا باني الحصن أرساه وشيده % % حرزا لشلو من الآفات مشحون % 2(@)(@@) % انظر إلى الدهر هل فاتته بغيته % % في مطمح النسر أو في مسبح النون % % 3(@)(@@) % ومن تحصن منخوبا على وجل % فإنما حصنه سجن لمسجون % 4(@)(@@) % أشكو إلى الله جهلا قد أضر بنا % % بل ليس جهلا ولكن علم مفتون % % PageV01P4539 البحر : - 1(@)(@@) % إني لأغضي عن الزلات أثبتها % % ذكرا إذا كان بعض القول نسيانا % % 2(@)(@@) % أمض ما كنت من أقذاء معتبة % أغض ما كنت للإخوان أجفانا % % 3(@)(@@) % أغضي الجفون عن السوءى مراقبة % لما يكون من الحسنى وما كانا % % 4(@)(@@) % أجزي الأخلاء صفحا عن إساءتهم % % إذا أساءوا وبالإحسان إحسانا % % 5(@)(@@) % أذكر النفس مثنى من محاسنهم % % إذا ذكرت ذنوب القوم أحدانا % % 6(@)(@@) % وليس ذاك لآبائي ومجدهم % % لكن لأني اتخذت العدل ميزانا % % PageV01P4540 البحر : - 1(@)(@@) % يا شاعرا أمسى يحوك مديحه % في شر جيل شر أهل زمان % 2(@)(@@) % ما تستحق ثواب من كابرته % % ورميته بالإفك والعدوان % % 3(@)(@@) % قوم تذكرهم فضائل غيرهم % % فيرون مافيهم من النقصان % % 4(@)(@@) % فإذا مدحتهم فتحت عليهم % بابا من الحسرات والأحزان % % 5(@)(@@) % ظلم امرؤ أهدى المديح إليهم % % ثم استتاب مثوبة الإحسان % % 6(@)(@@) % أيمينهم أسفا ويطلب رفدهم % لقد اغتدى في الظلم والعدوان % % PageV01P4541 البحر : - 1(@)(@@) % أيا بن رجاء وابنه الخير لا يزل % رجاء نحيف يغتدي بك بادنا % % 2(@)(@@) % منحتك من ودي مقيما مكانه % يباري ثناء لم يزل فيك ظاعنا % % 3(@)(@@) % أعدك في الزهر التي هي سبعة % بدئيا ويأبى الحق عديك ثامنا % % 4(@)(@@) % وإن كان فيها المشتري وهو سعدها % % وشمس الضحى والبدر غرا أيامنا % % 5(@)(@@) % ولا بد من صدقيك والصدق واجب % لكل صديق يستصح البطائنا % % 6(@)(@@) % بشعرك عيب فاحش غير أنه % إذا عد زين لم يزل لك زائنا % % 7(@)(@@) % أبوة آباء إذا قيس مجدهم % بشعرك عفى منه تلك المحاسنا % % 8(@)(@@) % وإن كان شعرا للضمير ملائما % حلالا ولطفا للنظير مبائنا % % 9(@)(@@) % أدقت معانيه وفخم لفظه % % فغادر 
ms1200	 أشتات القلوب قرائنا % % 10(@)(@@) % غدا غير ملحون غدو ملحن % % وراح بأسرار البلاغة لاحنا % % PageV01P4542 11(@)(@@) % فألهى امرأ تسكينه متحركا % وأبكى أمرأ تحريكه منه ساكنا % % 12(@)(@@) % فملئته لا باذلا حر وجهه % وملئتما فضلا من الله صائنا % % PageV01P4543 البحر : - 1(@)(@@) % ذهب الذين تهزهم مداحهم % هز الكماة عوالي المران % % 2(@)(@@) % كانوا إذا امتدحوا رأوا ما فيهم % فالأريحية منهم بمكان % % 3(@)(@@) % والمدح يقرع قلب من هو أهله % % قرع المواعظ قلب ذي إيمان % % 4(@)(@@) % فدع اللئام فما ثواب مديحهم % إلا ثواب عبادة الأوثان % % 5(@)(@@) % كم قائل لي منهم ومدحته % % بمدائح مثل الرياض حسان % % 6(@)(@@) % أحسنت ويحك ليس في وإنما % % أستحسن الحسنات في ميزاني % % PageV01P4544 البحر : - 1(@)(@@) % أرى المفند ينهاني ويأمرني % % بقوله أستحي إن الشيب قد حانا % % 2(@)(@@) % الآن حين أجد الشيب يطلبني % % أبادر الشيب باللذات عجلانا % % PageV01P4545 البحر : - 1(@)(@@) % إن قال لا قالها للآمريه بها % % ردا لآمره الغاوي وعصيانا % % 2(@)(@@) % ولم يقلها لمن يعفو فواضله % كاللافظين بها منعا وحرمانا % % 3(@)(@@) % متى يطاول شريفا يعله شرفا % وإن يوازنه يسفل عنه رجحانا % % 4(@)(@@) % إذا اشترى الحمد أفناء الملوك رأى % % بين التجارة والأفضال فرقانا % % PageV01P4546 البحر : - 1(@)(@@) % يا من عكفنا عليه لائذين به % فما عكفنا على بد ولا وثن % % 2(@)(@@) % ومن سألناه قدما كل منفسة % فما سألنا بقايا الآي والدمن % % 3(@)(@@) % إن لاتكن واسع الأملاك فاشيها % % فما عهدناك إلا واسع العطن % % 4(@)(@@) % ولا شقينا بوعد منك يتبعه % مطل ولا كنت إلا صافي المنن % 5(@)(@@) % أعاذك الله من حال تماطلني % % لضيقها بكساء تافه الثمن % 6(@)(@@) % ومن بصيرة رأي غير مبصرة % إن اطراحك حمدي أغبن الغبن % % 7(@)(@@) % انظر إلى الدنيا وزينتها % % ترى الكارم فيها زينة الزين % 8(@)(@@) % فالبس وألبس فإن الثوب تلبسه % زين على النفس لا ثقل على البدن % % 9(@)(@@) % وفي ادراعك ثوبا منظر حسن % % ولم يحسنك مثل المسمع الحسن % % 10(@)(@@) % إن تكسني يكسك المعروف من كثب % % ثوبا جميلا تراه أعين الفطن % % PageV01P4547 11(@)(@@) % فاكس ابن شكرك ما يبلي على ثقة % أن سوف يكسوك ما يقي على الزمن % % PageV01P4548 البحر : - 1(@)(@@) % حارب أجفانه الرقاد فما % % يسكن من 