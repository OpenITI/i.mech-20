ms76	 النبي :(@)(@@) | 30 ( أحفهما جميعا أو أنعلهما جميعا وإذا لبست فابدأ باليمنى وإذا خلعت فابدأ باليسرى ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 640 ) قال النبي :(@)(@@) | 30 ( أحق ما صليتم على أطفالكم ) )(@)(@@) ( الطحاوي هق ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 641 ) قال النبي :(@)(@@) | 30 ( أحل الذهب والحرير لإناث أمتي وحرم على ذكورها ) )(@)(@@) ( حم ن ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 642 ) قال النبي :(@)(@@) | 30 ( أحلت لنا ميتتان ودمان ، فأما الميتتان فالحوت والجراد ، وأما الدمان فالكبد والطحال ) )(@)(@@) ( ه ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 643 ) قال النبي :(@)(@@) | 30 ( إحلفوا بالله وبروا واصدقوا فإن الله يحب أن يحلف به ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 644 ) قال النبي :(@)(@@) | 30 ( احلقوه كله أو اتركوه كله ) )(@)(@@) ( د ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 645 ) قال النبي :(@)(@@) | 30 ( احملوا النساء على أهوائهن ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 646 ) قال النبي :(@)(@@) | 30 ( أحيانا يأتيني يعني الوحي في مثل صلصلة PageV01P115 الجرس ، وهو أشده علي فيفصم عني وقد وعيت ما قال ، وأحيانا يتمثل لي الملك رجلا فيكلمني فأعي ما يقول ) )(@)(@@) ( مالك حم ق ت ن ) عن عائشة رضي الله عنها ، زاد ( طب ) في آخره ، وهو أهونه علي ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 647 ) قال النبي :(@)(@@) | 30 ( أحب العمل إلى الله سبحة الحديث وأبغض الأعمال إلى الله التجديف ، قيل : يا رسول الله وما سبحة الحديث ؟ قال : يكون القوم يتحدثون والرجل يسبح ، قيل : وما التجديف ؟ قال : القوم يكونون بخير فيسألهم الجار والصاحب فيقولون نحن بشر يشكون ) )(@)(@@) ( طب ) عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 648 ) قال النبي :(@)(@@) | 30 ( أحب العمل إلى الله ما داوم عليه صاحبه وإن قل ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 649 ) قال النبي :(@)(@@) | 30 ( أحب الأديان إلى الله الحنيفية السمحة ، فإذا رأيت أمتي لا يقولون للظالم أنت ظالم فقد تودع منهم ) )(@)(@@) ( ك ) و ابن المرسي في الغرائب ( كر ) وأبو موسى المديني في معرفة الصحابة عن جعفر بن الأزهر بن قريط عن 
ms77	 جده أبي أمه سليمان بن كثير بن أمية بن أسعد عن أبيه كثير عن أبيه أمية عن أبيه أسعد بن عبد الله بن مالك الخزاعي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 650 ) قال النبي :(@)(@@) | 30 ( أحب الكلام إلى الله سبحان الله لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، ولا حول ولا قوة إلا بالله ، سبحان الله وبحمده ) )(@)(@@) ( خ ) في الأدب عن أبي ذر رضي الله عنه .(@)(@@) PageV01P116(@)(@@)(@@)(@@) $ ( 651 ) قال النبي :(@)(@@) | 30 ( أحب الكلام إلى الله أربع : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، لا يضرك بأيهن بدأت ، لا تسمين غلامك يسارا ولا رباحا ولا نجيحا ولا أفلح فإنك تقول أثم هو فلا يكون فيقول لا ) )(@)(@@) ( حم م حب طب ) و ابن شاهين في الترغيب في الذكر عن سمرة بن جنذب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 652 ) قال النبي :(@)(@@) | 30 ( أحب الناس إلى الله وأقربهم منه مجلسا يوم القيامة إمام عادل ، وأبغض الناس إلى الله يوم القيامة وأشدهم عذابا إمام جائر ) )(@)(@@) ( هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 653 ) قال النبي :(@)(@@) | 30 ( أحب الناس إلى الله تعالى أنفعهم للناس ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 654 ) قال النبي :(@)(@@) | 30 ( أحبكم إلى الله أحاسنكم أخلاقا ، الموطئون أكنافا الذين يألفون ويؤلفون ، وإن أبغضكم إلى الله المشاؤون بالنميمة الملتمسون لهم العثرات المفرقون بين الإخوان ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 655 ) قال النبي :(@)(@@) | 30 ( أحبكم إلي وأقربكم مني مجلسا يوم القيامة أحاسنكم أخلاقا ، وأبغضكم إلي وأبعدكم مني مجلسا يوم القيامة مساوئكم أخلاقا ، الثرثارون المتشدقون المتفيهقون ) )(@)(@@) ( هب ) عن أبي ثعلبة الحشني ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 656 ) قال النبي :(@)(@@) | 30 ( أحبوا المساكين وادنوا منهم ، إن تحبوهم يحببكم الله ، وإن تدنوهم يدنكم الله ، وإن تكسوهم يكسكم الله ، وإن تطعموهم يطعمكم الله ، جودوا يجد الله عليكم ) )(@)(@@) الديلمي عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 657 ) قال النبي :(@)(@@) | 30 ( احتاطوا لأهل الأموال في المواطأة والمعاملة والنوائب وما وجب في التمر من الحق ) )(@)(@@) ( عد هق ) عن جابر 
ms78	 رضي الله عنه .(@)(@@) PageV01P117(@)(@@)(@@)(@@) $ ( 658 ) قال النبي :(@)(@@) | 30 ( احتجبي من النار ولو بشق تمرة ) )(@)(@@) ( طب ) عن عبد الله بن مخمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 659 ) قال النبي :(@)(@@) | 30 ( أحد على ترعة من ترع الجنة ، وعير على ركن من أركان النار ) )(@)(@@) ( عب ) عن أبي ليلى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 660 ) قال النبي :(@)(@@) | 30 ( إحدى عينيه يعني الدجال كأنها زجاجة خضراء وتعوذوا بالله من عذاب القبر ) )(@)(@@) ( ط ) ( حم ) و ابن منيع والروياني ( حب ض ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 661 ) قال النبي :(@)(@@) | 30 ( أحدث لما حدث وضوءا ) )(@)(@@) ( طب ) ( قط ) عن سل مان رضي الله عنه قال : سال من أنفي دم فسألت النبي قال فذكره .(@)(@@)(@@)(@@) $ ( 662 ) قال النبي :(@)(@@) | 30 ( أحدثكم حديثا : ثلاثا أقسم عليهن ، ما نقص مال عبد من صدقة ، ولا ظلم عبد بمظلمة فصبر عليها إلا زاده الله عز وجل بها عزا ، ولا فتح عبد باب مسألة إلا فتح له باب فقر ) )(@)(@@) ( طب ) عن أبي كبشة الأنماري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 663 ) قال النبي :(@)(@@) | 30 ( إحذروا دعوة المسلم وفراسته فإنه ينظر بنور الله وينظر بتوفيق الله ) )(@)(@@) ( حل ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 664 ) قال النبي :(@)(@@) | 30 ( أحذركم الدجالين الثلاثة ، قيل : يا رسول الله قد أخبرتنا عن الدجال الأعور وعن أكذب الكذابين ، فمن الثالث ؟ قال : رجل يخرج في قوم أولهم مثبور وآخرهم مثبور عليهم اللعنة دائبة في فتنة يقال لها الجارفة وهو الدجال الأكلس يأكل عباد الله بآل محمد وهو اليأس من سنته ) )(@)(@@) ابن خزيمة ( ك ) وتعقب ( طب ) عن العداء بن خالد .(@)(@@)(@@)(@@) $ ( 665 ) قال النبي :(@)(@@) | 30 ( أحذركم المسيح وأنذركموه وكل نبي قد حذر قومه وهو فيكم أيتها الأمة وسأحكي لكم من نعته ما لم يحك الأنبياء قبلي لقومهم ، يكون قبل PageV01P118 خروجه سنون خمس جدب حتى يهلك كل ذي حافر ، قيل : فيم يعيش المؤمنون ؟ قال : بما تعيش به الملائكة ، ثم يخرج وهو أعور وليس الله بأعور بين عينيه ( كافر ) يقرؤه كل مؤمن كاتب وغير كاتب ، أكثر من يتبعه اليهود والنساء والأعراب ، يرون السماء تمطر وهي لا 
ms79	 تمطر ، والأرض تنبت وهي لا تنبت ، ويقول للأعراب ما تبغون مني ؟ ألم أرسل السماء عليكم مدرارا ؟ وأحيي لكم أنعامكم شاخصة ذراها ، خارجة خواصرها ، دارة ألبانها ، ويبعث معه الشياطين على صورة من قد مات من الآباء والإخوان والمعارف ، فيأتي أحدهم إلى أبيه أو أخيه أو ذي رحمه فيقول : ألست فلانا ألست تعرفني ؟ هو ربك فاتبعه يعمر أربعين سنة ، السنة كالشهر ، والشهر كالجمعة ، والجمعة كاليوم ، واليوم كالساعة ، والساعة كاحتراق السعفة في النار ، يرد كل منهل إلا المسجدين ، أبشروا فإن يخرج وأنا بين أظهركم فالله كافيكم ورسوله ، وإن يخرج بعدي فالله خليفتي على كل مسلم ) )(@)(@@) ( طب ) عن أسماء بنت زيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 666 ) قال النبي :(@)(@@) | 30 ( أحذركم فتنة تقبل من المشرق ثم فتنة تقبل من المغرب ) )(@)(@@) نعيم بن حماد في الفتن عن ابن عباس رضي الله عنهما وهو ضعيف .(@)(@@)(@@)(@@) $ ( 667 ) قال النبي :(@)(@@) | 30 ( أحسن الهدي هدي محمد ، وشر الأمور محدثاتها ، وكل بدعة ضلالة ، من مات وترك مالا فالأهله ومن ترك دينا أو ضياعا فالي وعلي ) )(@)(@@) ابن سعد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 668 ) قال النبي :(@)(@@) | 30 ( أحسنا إليه فإني رأيته يصلي ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 669 ) قال النبي :(@)(@@) | 30 ( أحسنت الأنصار تسموا باسمي ولا تكنوا بكنيتي ، فإنما بعثت قاسما أقسم بينكم ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 670 ) قال النبي :(@)(@@) | 30 ( أحسنوا صلاتكم فإني أراكم خلفي كما أراكم قدامي ) )(@)(@@) PageV01P119 ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 671 ) قال النبي :(@)(@@) | 30 ( أحسنوا إلى الماعز وامسحوا عنها الرغام فإنها من دواب الجنة ، ما من نبي إلا قد رعى ، قالوا : وأنت ؟ قال : وأنا قد رعيت الغنم ) )(@)(@@) ( بز خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 672 ) قال النبي :(@)(@@) | 30 ( أحسنوا يا أيها الناس برب العالمين الظن فإن الرب عند ظن عبده به ) )(@)(@@) ابن أبي الدنيا وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 673 ) قال النبي :(@)(@@) | 30 ( أحسنوا إلى أصحابي ثم الذين يلونهم ثم الذين يلونهم ) )(@)(@@) المخلص وابن ناصر في أماليه وصححه عن عمر 
ms80	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 674 ) قال النبي :(@)(@@) | 30 ( أحسنوا كفن موتاكم فإنهم يتباهون ويتزاورون بها في قبورهم ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 675 ) قال النبي :(@)(@@) | 30 ( أحسنوا الكفن ولا تؤذوا موتاكم بعويل ولا بتزكية ولا بتأخير وصية ولا بقطيعة ، وعجلوا قضاء دينه ، واعدلوا عن جيران السوء ، وإذا حفرتم فأعمقوا وأوسعوا ) )(@)(@@) الديلمي عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 676 ) قال النبي :(@)(@@) | 30 ( أحسني جوار نعم الله فإنها قلما نفرت عن أهل بيت فكادت ترجع إليهم ) )(@)(@@) ( هب ) وضعفه ( خط ) في رواة مالك وابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 677 ) قال النبي :(@)(@@) | 30 ( احضروا الذكر وادنوا من الإمام فإن الرجل لا يزال يتباعد حتى يؤخر في الجنة وإن دخلها ) )(@)(@@) ( حم د ك هق ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 678 ) قال الن بي :(@)(@@) | 30 ( احفظ وعاءها ووكاءها وعددها فإن جاء أحد يخبرك فادفعها وإلا فاستمتع بها ) )(@)(@@) ( حب ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 679 ) قال النبي :(@)(@@) | 30 ( إحفظوني في أصحابي فمن حفظني في أصحابي PageV01P120 رافقني وورد على حوضي ، ومن لم يخفظني فيهم لم يرد علي حوضي ولم يرني إلا من بعيد ) )(@)(@@) ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 680 ) قال النبي :(@)(@@) | 30 ( إحفظوا من محسن الأنصار وتجاوزوا عن مسيئهم ) )(@)(@@) ( طب ) عن أبي سعد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 681 ) قال النبي :(@)(@@) | 30 ( إحفظوا اليتامى في أموالهم لا تأكلها الزكاة ) )(@)(@@) ( الشافعي ) ( طب ) عن عمرو بن شعيب ، عن أبيه ، عن جده .(@)(@@)(@@)(@@) $ ( 682 ) قال النبي :(@)(@@) | 30 ( إحفظوني في عمي العباس ، فإن عم الرجل صنو أبيه ) )(@)(@@) ( كر ) عن عبد الله بن أبي بكر بلاغا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 683 ) قال النبي :(@)(@@) | 30 ( أحلت لي مكة ساعة من نهار ولا تحل لأحد من بعدي ، وهي حرام بحرمة الله إلى يوم القيامة لا يعضد شجرها ، ولا يختلى خلاها ، ولا ينفر صيدها ، ولا تلتقط لقطتها إلا لمنشد ، قالوا : إلا الإذخر ، قال : إلا الإذخر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 684 ) قال النبي :(@)(@@) | 30 ( أحشر أنا وأبو بكر وعمر يوم القيامة هاكذا ، وأخرج 