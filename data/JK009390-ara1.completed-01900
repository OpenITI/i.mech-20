ms1898	 شهد بدرا والحديبة ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17508 ) قال النبي :(@)(@@) | 30 ( لن يزال العبد في فسحة من دينه ما لم يشرب PageV06P110 الخمر ، فإذا شربها خرق الله عنه ستره ، وكان الشيطان وليه وسمعه وبصره ورجله ، يسوقه إلى كل شر ، ويصرفه عن كل خير ) )(@)(@@) ( طب ) عن قتادة بن عياش رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17509 ) قال النبي :(@)(@@) | 30 ( لن يشبع المؤمن من خير يسمعه حتى يكون منتهاه الجنة ) )(@)(@@) ( ت حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17510 ) قال النبي :(@)(@@) | 30 ( لن يعجز الله هاذه الأمة من نصف يوم ) )(@)(@@) ( د ك ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17511 ) قال النبي :(@)(@@) | 30 ( لن يغلب عسر يسرين : فإن مع العسر يسرا ، إن مع العسر يسرا ) )(@)(@@) ( ك ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 17512 ) قال النبي :(@)(@@) | 30 ( لن يفلح قوم ولوا أمرهم امرأة ) )(@)(@@) ( حم خ ت ن ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17513 ) قال النبي :(@)(@@) | 30 ( لن يلج الدرجات العلى من تكهن ، أو استقسم ، أو رجع من سفر تطيرا ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17514 ) قال النبي :(@)(@@) | 30 ( لن يلج النار أحد شهد بدرا أو بيعة الرضوان ) )(@)(@@) البغوي وابن قانع عن سعد ، مولى حاطب بن أبي بلتعة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17515 ) قال النبي :(@)(@@) | 30 ( لن يلج النار أحد صلى قبل طلوع الشمس وقبل غروبها ) )(@)(@@) ( حم م د ن ) عن عمارة بن رويبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17516 ) قال النبي :(@)(@@) | 30 ( لن ينجي أحدا منكم عمله ولا أنا إلا أن يتغمدني الله برحمته ، ولاكن سددوا وقاربوا ، واغدوا وروحوا ، وشيء من الدلجة ، والقصد PageV06P111 القصد تبلغوا ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17517 ) قال النبي :(@)(@@) | 30 ( لن ينفع حذر من قدر ، ولاكن الدعاء ينفع مما نزل ومما لم ينزل ، فعليكم بالدعاء عباد الله ) )(@)(@@) ( حم ع طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17518 ) قال النبي :(@)(@@) | 30 ( لن يوافي عبد يوم القيامة يقول : لا إلاه إلا الله يبتغي بها وجه الله إلا حرم الله عليه النار ) )(@)(@@) ( حم خ ) عن 
