ms291	 سحر که در عالم در چشم تو مضمر(@)(@@) 5 زودست ‌کز آن اشک شود عاشق رسوا %~% زودست‌کز آن فتنه برآشوبدکشور(@)(@@) 6 ای ترک یکی منع دو چشمان بکن از سحر %~% ارنه رسد آسیبت از میر مظفر(@)(@@) 7 سالار نبی رسم و نبی اسم که شخصش %~% از فضل مجسم بود از جود مخمر(@)(@@) 8 تیغش به چه ماند به یکی سوزان آتش %~% عزمش به چه ماند به یکی پران صرصر(@)(@@) 9 زان ‌یک زند آندم همه گر چوب و اگر سنگ %~% این یک همی از سنگ برون آرد آذر(@)(@@) 10 خنگش به چه ماند به یکی باد سبک‌سیر %~% گرزش به چه ماند به یکی کوه گرانسر(@)(@@) 11 رمحش به چه ماند به یکی نخل‌که ندهد %~% در وقعه به جز از سر دشمنش همی بر(@)(@@) 12 درکشتی اگر آیت حزمش بنگارند %~% حاجت نبود درگه طوفانش به لنگر(@)(@@) 13 دولت شده بر چهر دلارایش شیدا %~% صولت شده بر شخص توانایش چاکر(@)(@@) 14 آنجا که بود کاخ جلال وی و گردون %~% آن سطح محدب بود این سطح مقعر(@)(@@) 15 بخشنده کف رادش چندان که تو گویی %~% در حوزه او گشته ضمین رزق مقدر(@)(@@) 16 ابنای زمان را در او کعبه حاجت %~% از بس که همی سیم بر افشاند و گوهر(@)(@@) 17 مسکین نرودش از در جز با دل خرم %~% زایر نشودش از بر جز با کف پر زر(@)(@@) 18 بالاست همی بختش و افلاک بود دون %~% روشن بودش رای و خورشید مکدر(@)(@@) 19 خواهم چو همی مدحت خلقش بنگارم %~% ننگاشته چون باغ ارم گردد دفتر(@)(@@) 20 آزاده امیرا سوی این نظم نظر کن %~% کاید ز قبول تو یکی تافته اختر(@)(@@) 21 خلاق سخن ‌گر نبود مردم به یکدم %~% چندین گهر از طبع برون نادر ایدر(@)(@@) 22 تا آنکه چو خورشید به برج حمل آید %~% شام سیه و روز سپیدست برابر(@)(@@) 23 اعدای ترا تیره چو شب باد همی روز %~% احباب تو را شب همه 
ms292	 چون روز منور PageV1P179(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بحمدالله که باز از یاری گیهان خدا داور %~% درخت بخت شد خرم نهال فتح بارآور(@)(@@) 2 بحمدالله که بگشود از هوای فتح باز از نو %~% همای عافیت بر فرق فرقدسای شه شهپر(@)(@@) 3 بحمدالله که از نیروی بخت بی‌زوال شه %~% عدوی ملک و ملت را شکست افتاد در لشکر(@)(@@) 4 بحمدالله که از فر همایون فال شاهنشه %~% شد از خاورزمین طالع همایون نجم فال و فر(@)(@@) 5 شهنشاه جهان فتحعلی شه خسروی کآمد %~% وجودش خلق و خالق را یکی مظهر یکی مظهر(@)(@@) 6 جهاندار و کنارنگی که ذات بی‌زوال او %~% قوام نه عرض یعنی که نه افلاک را جوهر(@)(@@) 7 جهانداری‌ که شد پهلوی ملک و پیکر اعدا %~% ز تیغ لاغرش فربه ز خت فربهش لاغر(@)(@@) 8 ز تیغش‌یادی و ولوال اندر ساحت سقسین %~% زگرزش ذکری و زلزال اندر مرز لوهاور(@)(@@) 9 شود از اهتزاز باد گرزش نه فلک فانی %~% بدان آیین‌که بر دریا حباب از جنبش‌ب صرصر(@)(@@) 10 نهنگی‌غوطه‌زن‌در نیل‌چون‌پوشدبه‌تن‌جوشن %~% دماوندی به زیر ابر چون بر سر نهد مغفر(@)(@@) 11 به یال خصم پیچان خم خامش بر بدان آیین %~% که پیرامون ناپاک اژدها ماری زند چنبر(@)(@@) 12 اگر بر کوه خارا برق تیغش را گذار افتد %~% شود کوه از تف خارا گدازش تل خاکستر(@)(@@) 13 نیوشاگوش او را چاشی بخشای یک رامش %~% فغان بربط و سورغین نوای شندف و مزهر(@)(@@) 14 دلارارای او را تهنیت آرای یک خواهش %~% صهیل ارغن و ارغون فرار ادهم و اشقر(@)(@@) 15 نهنگ تیغ او را جسم دیوان طعمه دندان %~% عقاب تیر او را لاش شیران مسته ژاغر(@)(@@) 16 کهین چوبک زن بامش‌ اگر مریخ اگرکیوان %~% کمین دست افکن جاهش اگر سلجوق اگر نجر(@)(@@) 17 زگفتش حرفی و قعر بحار و لولو لالا %~% ز خلقش ذکری و ناف غزال و نافه اذفر(@)(@@) 18 به فرمان اندرش فرمانروا رادان فرمانده %~% بجز فرمانده‌کش هرچه فرمان‌گوی فرمانبر(@)(@@) 19 چم‌ر بر روشن‌تنش‌جوشن‌عیان‌خو‌رشد 
ms293	 از روزن %~% و یا از پشت پرویزن فروزان‌گنبد اخضر(@)(@@) 20 نوال ‌دست ‌جودش زانچه ‌درخورد قیاس ‌افزون %~% عطای طبع رادش زانچه در وهم و گمان برتر(@)(@@) 21 اگر دربان درگاهش فشاند گردی از دامن %~% پس از قرنی ‌کند ماوا برین فیروزه گون منظر(@)(@@) 22 به دارالضرب گیتی بی‌قرین ضراب بخت او %~% هماون سکه ی صاحبقرانی زد به سیم و زر(@)(@@) 23 کمان و تیر و تیغ و کوس او در پره هیجا %~% یکی ابر و یکی باران یکی برق و یکی تندر(@)(@@) 24 هر آن کو بنگرد آشوب‌زا میدان رزمش را %~% به چشمش‌ بازی طفلان نماید شورش محشر(@)(@@) 25 عروس مملکت زان پیش‌ کاندر عقد شاه آید %~% به‌هیات ‌بود بس هایل به ‌صورت ‌بود بس منکر(@)(@@) 26 کنون نشکفت اگر از زیور عدل ملک زیبا %~% چه باک ار زشت‌رویی طرفه ‌زیباگردد از زیو‌ر(@)(@@) 27 نیایش لاجرم درده بر آن معبود بی‌همتا %~% که بی‌یاریست با یارا و هر بی‌یار را یاور(@)(@@) 28 به پای انداز آ‌ن‌کز فر این‌ دارانسب خسرو %~% به دست ‌آویز آن کز بخت این گیتی خداداور(@)(@@) 29 شد از تیغ‌ شجاع ‌السلطنه دشت قرابوقا %~% ز خون قنقرات زشت‌سیرت بحر پهناور(@)(@@) 30 به اژدرکوه رسد از خون اژدرکوهه عفریتان %~% ز آب چشمه تیغش هزاران لاله احمر(@)(@@) 31 زکلک رمح آذرگون ملک بر رقعه هامون %~% رقم‌کرد از مداد خون به قتل دشمنان محضر(@)(@@) 32 در آن میدان پر غوغا که بانگ‌ کوس تندرسا %~% درید از هیبت آوا دل گردان کنداور(@)(@@) 33 هوا از گرد شد ظلمات ‌و نصرت ‌چشمه‌ حیوان %~% بلند اقبال رهبر خضر گشت و شاه اسکندر(@)(@@) 34 بسان ‌گرزه مار جانگزا در دست مارافسا %~% سنان مار شکل اندر کف شیران اژدر در(@)(@@) 35 ز موج فوج و فوج موج خون شد عرصه هامون %~% چو دریابی‌که پیدا نبودش از هیچ سو معبر(@)(@@) 36 بدن‌شد باده‌نوش‌و دشت‌کین‌بزم‌و اجل ساقی %~% شرابش‌خون و جان‌دادن‌خمار و تیغ‌شه ساغر(@)(@@) 37 زمین از لطمه موج 
ms294	 حوادث مرتعش اعضا %~% بسان زورقی کاندر محیطش بگسلد لنگر(@)(@@) 38 اجل‌شد گاز و تن‌آهن‌حوادث‌دم‌زمین کوره %~% تبرزین پتک و سرسندان و مرد استاد آهنگر(@)(@@) 39 ز پیل اوژن هژبران پره پیکار شد ارژن %~% ز شیرافکن پلنگان پهنه مضمار شد بربر(@)(@@) 40 چنان در عرصه میدان طپان دل در برگردان %~% کز استیلای درد و بیم جان بیمار در بستر(@)(@@) 41 نیوشاگوش را زی من‌گرایان دار ای دانا %~% که رانم داستان فتح دارا را ز پا تا سر(@)(@@) 42 سحرگاهی‌که از اقلیم خاور خیمه زد بیرون %~% به عزم ترکتاز جیش انجم خسرو خاور(@)(@@) 43 بشیری برکشید آواز کز اورکنج‌ ای خسرو %~% قضا آورده بهر غازیانت گنج بادآور(@)(@@) 44 به یغمای دیار خاوران نک نامزد کرده %~% کهین پورشه خوارزم انبوهی فزون از مر(@)(@@) 45 ز مرو و اندخود و خانقاه و قندز و خیوق‌ %~% ز خرمند و سرخس و بلتخان و بلخ وکالنجر(@)(@@) 46 چنان بشکف اعوان ملک را زین بشارت دل %~% که انصار ‌بیمبر را ز فتح قلعه خیبر(@)(@@) 47 تو ای‌ضرغام‌پیل‌افکن‌چو بیرون راندی از مکمن %~% روان‌ شد فتحت‌ از ایمن‌ دوان‌ شد بختت‌ از ایسر(@)(@@) 48 کشیدی‌زیر ران‌کوهی‌که‌هی‌هی‌رهسپر توسن %~% گرفتی‌اژدری برکف‌که‌وه‌وه‌جانستان خنجر(@)(@@) 49 یکی در سرکشی قایم‌مقام طره جانان %~% یکی در خون خوری نایب مناب غمزه دلبر(@)(@@) 50 بر آن خونخواره عفریتان بدان‌سان حمله آوردی %~% که بر خیل‌ گراز ماده آرد حمله شیر نر(@)(@@) 51 پرندت‌چون‌برون‌شد از قراب‌قیرگون گفتی %~% ز قیرآلود غاری رخ نمود آتش‌فشان اژدر(@)(@@) 52 *‌اس‌افکندی‌چندین‌هزاراسب‌افکن افکندی %~% ترکان هزار اسب‌ا از فراز اسب‌که پیکر(@)(@@) 53 چنان ‌کردی جر خون از بن هر موی تن جاری %~% که‌ گفتی‌ زد به‌ هفت اندامشان هر موی تن نشتر(@)(@@) 54 هلال‌آسا حسامت ترک را بر تارک ترکان %~% چنان شق زد که جرم ماه را انگشت پیغمبر(@)(@@) 55 ز تاب‌تف‌تیغت‌سوخت‌کشت‌عمرشان چونان %~% که افتد در میان خرمن خاشاک خشک آذر(@)(@@) 56 چنان‌گرزگران را سر زدی بر ترک بدخواهان %~% که بیرون شد ز بطن‌گاو ماهی آهن مغفر 
ms295	(@)(@@) 57 به‌خصم‌از شش جهت‌راه هزیمت بسته شد آری %~% چسان بیرون‌ شود آن مهره‌یی کافتاد در ششدر(@)(@@) 58 ز‌هی بخت تو در عالم به الهام ظفر ملهم %~% فنا در خنجرت ‌مدغم اجل در صارمت مضمر(@)(@@) 59 عروس عافیت را عقد دایم بسته اقبالت %~% به عالم انقطاعی نیست این زن را ازین شوهر(@)(@@) 60 ولیکن تا نیفتد بر جمالش چشم بیگانه %~% حجاب رخ‌کندگاهی ز عصمت‌گوشه معجر(@)(@@) 61 گریزد در تو دوران از جفای آسمان چونان %~% که طفل خردسال از جور اقران جانب مادر(@)(@@) 62 شود مست از می خون مخالف شاهد تیغت %~% بدان آیین‌که رند باده‌خوار از باده احمر(@)(@@) 63 ثبات خصم در میدان رزمت بیش از آن نبود %~% که مرغ پخته بر خوان و سپند خام در مجمر(@)(@@) 64 اجل مشتاق‌تر زان بر می خون بداندیشت %~% که رندان قدح‌ پیما به رنگین باده خلر(@)(@@) 65 گر از کانون قهرت اخگری اندر جهان افتد %~% سوزد شعله او مرغ و ماهی را به بحر و بر(@)(@@) 66 مگر از گرد راه توسنت پر گرد شد گردون %~% که هر شب چشم‌ گردآلود را برهم زند اختر(@)(@@) 67 اگر رشحی فشانی زآب‌لطف خویش بر نیران %~% شود جاری ز هر سویش هزاران چشمه کوثر(@)(@@) 68 به ‌کوه و دشت اگر بارد نمی از فیض احساث %~% شود خارش همه سوری شود سنگش‌همه گوهر(@)(@@) 69 ز چینی‌ جوشنت ‌صد چین‌ حسرت ‌بر رخ‌ خاقان %~% ز رومی مغفرت صد زنگ انده بر دل قیصر(@)(@@) 70 ثنای شاه را نبود کران قاآنیا تاکی %~% فزایی رنج ‌کتاب و مداد و خامه دفتر(@)(@@) 71 بجوشد تا میاه از انشراح خاک در اردی %~% بخوشد تا گیاه از ارتجاح باد در آذر(@)(@@) 72 به‌کام بدسگالش شهد شیرین زهر تن‌فرسا %~% به جام نیکخواهش زهر قاتل شهد جان‌پرور PageV1P180(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بستم به عزم پارس چو از ملک ری ‌کمر %~% زین برزدم به‌ کوهه ی یکران رهسپر(@)(@@) 2 اسبی به گاه پویه سبکروتر از خیال %~% اسبی 
