ms1861	 حظرت رحمة الله واسعة ، إن الله خلق مائة رحمة ، فأنزل رحمة يتعاطف بها الخلائق : جنها ، وإنسها ، وبهائمها ، وعنده تسعة وتسعون ، أتقولون هو أضل أم بعيره ؟ يعني الذي قال : اللهم ارحمني ومحمدا ، ولا تشرك في رحمتنا أحدا ) )(@)(@@) ( حم د ) و الباوردي ( طب ك ) عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17195 ) قال النبي :(@)(@@) | 30 ( لقد اشترطت على ربي شرطا لا خلف له فقلت : اللهم إنما أنا بشر ، أغضب كما يغضبون ، وأجد كما يجدون ، فأي المسلمين ضربت ، أو سببت ، أو لعنت ، أو آذيت ، فاجعلها له مغفرة ورحمة وقربة تقربه بها يوم القيامة ) )(@)(@@) ( حم كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17196 ) قال النبي :(@)(@@) | 30 ( لقد أهلكتم أو قطعتم ظهر الرجل ) )(@)(@@) ( حم م ) عن أبي موسى ا رضي الله عنه قال : سمع النبي رجلا يثني على رجل ويطريه في المدحة قال : فذكره .(@)(@@)(@@)(@@) $ ( 17197 ) قال النبي :(@)(@@) | 30 ( لقد أمرت بالسواك حتى خشيت أن يدردني ) )(@)(@@) السرقسطي في الدلائل وأبو نعيم عن نافع بن جبير بن مطعم عن أبيه وضعف .(@)(@@)(@@)(@@) $ ( 17198 ) قال النبي :(@)(@@) | 30 ( لقد أمرت بالسواك حتى خشيت على فمي ) )(@)(@@) أبو نعيم PageV06P061 عن سعيد وعامر بن واثلة رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 17199 ) قال النبي :(@)(@@) | 30 ( لقد لزمت السواك حتى تخوفت أن يدردني ) )(@)(@@) ( طس هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17200 ) قال النبي :(@)(@@) | 30 ( لقد أمرت بالسواك حتى ظننت أنه سينزل علي قرآن ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17201 ) قال النبي :(@)(@@) | 30 ( لقد أمرت بالسواك حتى لقد خشيت أن يكتب علي ) )(@)(@@) ( طب ) عن واثلة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17202 ) قال النبي :(@)(@@) | 30 ( لقد فتحت لها أبواب السماء فما نهنهها شيء دون العرش ، يعني قوله : الحمد لله حمدا كثيرا طيبا مباركا فيه ) )(@)(@@) ( ه طب ) عن وائل بن حجر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17203 ) قال النبي :(@)(@@) | 30 ( لقد سألت الله باسمه الأعظم الذي إذا سئل به أعطى ، وإذا دعي به أجاب ) )(@)(@@) ( ش ه ك حب ) عن بريدة رضي الله عنه قال : سمع النبي يقول : اللهم إني أسألك بأنك أنت الله لا 
ms1862	 إلاه إلا أنت الأحد الصمد الذي لم تلد ولم تولد ، ولم يكن له كفوا أحد قال : فذكره .(@)(@@)(@@)(@@) $ ( 17204 ) قال النبي :(@)(@@) | 30 ( لقد فضلت خديجة على نساء أمتي كما فضلت مريم على نساء العالمين ) )(@)(@@) ( طب ) عن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17205 ) قال النبي :(@)(@@) | 30 ( لقد أتى علي وعلى صاحبي بضع عشرة وما لي وله طعام إلا البرير ، يعني تمر الأراك ، فقدمنا على إخواننا هاؤلاء من الأنصار وعظم طعامهم التمر فواسونا فيه ، فوالله لو أجد لكم الخبز واللحم لأشبعتكم منه ، ولاكن عسى أن تدركوا زمانا حتى يغدى على أحدكم الجفنة ويراح عليه بأخرى ، ويلبسون PageV06P062 فيه مثل أستار الكعبة ، قالوا : يا رسول الله أنحن اليوم خير أم ذاك اليوم ؟ قال : بل أنتم اليوم خير ، أنتم اليوم إخوان متحابون ، وأنتم يومئذ يضرب بعضكم رقاب بعض متباغضون ) )(@)(@@) ( حل هق ك ن ) عن طل حة بن عمرو النصري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17206 ) قال النبي :(@)(@@) | 30 ( لقد رأيتني في المنام كأني أطوف بالبيت ، فرأيت عيسى رجلا بين الرجلين ، كأن رأسه تنطف ماء ، فالتفت فإذا رجل أحمر جعد الرأس ، أعور عين اليمنى كأن عينه عنبة قميئة ، فقيل : هاذا الدجال ، أقرب الناس شبها بابن قطن الخزاعي من بني المصطلق ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17207 ) قال النبي :(@)(@@) | 30 ( لقد رأيت هاذا يعني مصعب بن عمير عند أبويه بمكة يكرمانه وينعمانه ، وما فتى من فتيان قريش مثله ، ثم خرج منن ذالك ابتغاء مرضات الله ونصرة رسوله ، أما إنه لا يأتي عليكم إلا كذا وكذا حتى تفتح عليكم فارس والروم ، فيغدو أحدكم في حلة ويروح في حلة ، ويغدى عليكم بقصعة ويراح عليكم بأخرى ، قالوا : يا رسول الله نحن اليوم خير أو ذالك اليوم ، قال : بل أنتم اليوم خير ، أما لو تعلمون من الدنيا ما أعلم لا استراحت أنفسكم منها ) )(@)(@@) ( ك ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17208 ) قال النبي :(@)(@@) | 30 ( لقد تكلمت بأربع كلمات أعدتهن ثلاث مرات هن أفضل مما قلت : سبحان الله عدد خلقه ، وسبحان الله رضى نفسه ، وسبحان 
ms1863	 الله زنة عرشه ، وسبحان الله مداد كلماته ، والحمد لله مثل ذالك ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17209 ) قال النبي :(@)(@@) | 30 ( لقد زوجتكه وإنه لأول أصحابي سلما ، وأكثرهم علما ، وأعظمهم حلما ) )(@)(@@) ( طب ) عن أبي إسحاق أن عليا لما تزوج فاطمة رضي الله عنها قال لها النبي فذكره .(@)(@@)(@@)(@@) $ ( 17210 ) قال النبي :(@)(@@) | 30 ( لقد قلت كلمة لو مزجت بماء البحر لمزجته ) )(@)(@@) PageV06P063 ( د ت ) عن عائشة قالت : قلت للنبي حسبك من صفية كذا وكذا تعني قصيرة قال فذكره .(@)(@@)(@@)(@@) $ ( 17211 ) قال النبي :(@)(@@) | 30 ( لقد نزل سبعون ألف ملك شهدوا جنازة سعد ما وطئوا الأرض قبل اليوم ) )(@)(@@) ابن سعد عن سعد بن إبراهيم مرسلا .(@)(@@)(@@)(@@) $ ( 17212 ) قال النبي :(@)(@@) | 30 ( لقد أوتي أخوكم من مزامير آل داود ) )(@)(@@) ( ش ) و ابن سعد ( طب ) عن عبد الرحمان بن كعب بن مالك مرسلا .(@)(@@)(@@)(@@) $ ( 17213 ) قال النبي :(@)(@@) | 30 ( لقد أوتي الأشعري مزمارا من مزامير آل داود ) )(@)(@@) ( ش ) و الدارمي وابن نصر والروياني ( حب ك حل ) عن بريدة ( ش ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17214 ) قال النبي :(@)(@@) | 30 ( لقد مر بالصخرة من الروحاء سبعون نبيا حفاة عليهم العباءة يؤمون بيت الله العتيق منهم موسى عليهم السلام ) )(@)(@@) ( ع عق طب حل كر ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17215 ) قال النبي :(@)(@@) | 30 ( لقد صلى في هاذا المسجد سبعون نبيا قبلي ، ولقد قدمها موسى عليه السلام عليه عباءتان قطوانيتان على ناقة ورقاء في سبعين ألفا من بني إسرائيل ) )(@)(@@) ( كر ) عن كثير بن عبد الله بن عمرو بن عوف عن أبيه عن جده قال : غزونا مع رسول الله حتى إذا كنا بالروحاء قال فذكره .(@)(@@)(@@)(@@) $ ( 17216 ) قال النبي :(@)(@@) | 30 ( لقد مر به يعني بوادي عسفان هود وصالح ونوح على بكرات حمر خطمها الليف ، أزرهم العباء ، وأرديتهم النمار يلبون ، يحجون البيت العتيق ) )(@)(@@) ( حم كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17217 ) قال النبي :(@)(@@) | 30 ( لقد رأيته يعني ورقة بن نوفل على نهر في بطنان الجنة ، عليه حلة من سندس ، ورأيت خديجة على نهر من 
ms1864	 أنهار الجنة في بيت من PageV06P064 قصب ، لا صخب فيه ولا نصب ) )(@)(@@) ( ع ) و تمام ( عد كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17218 ) قال النبي :(@)(@@) | 30 ( لقد استجن بجنة حصينة من النار من سلف له ثلاثة أولاد في الإسلام ) )(@)(@@) ( ع طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17219 ) قال النبي :(@)(@@) | 30 ( لقد خلفتم بالمدينة رجالا ما قطعتم واديا ، ولا سلكتم طريقا إلا شركوكم في الأجر ، حبسهم المرض ) )(@)(@@) ( حم حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17220 ) قال النبي :(@)(@@) | 30 ( لقد تضايق على هاذا العبد الصالح قبره حتى فرجه الله عز وجل عنه برحمته يعني سعد بن معاذ ) )(@)(@@) ( حم ) و سمويه ( طب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17221 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر صارخا يصرخ بالصلاة ، ثم أتخلف على رجال يتخلفون عن الصلاة فأحرق عليهم بيوتهم ) )(@)(@@) ( ط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17222 ) قال النبي :(@)(@@) | 30 ( لقد شيع هاذه السورة من الملائكة ما سد الأفق يعني سورة الأنعام ) )(@)(@@) ( ك ) وتعقب ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17223 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر بلالا فيقيم الصلاة ، تم أنصرف إلى قوم يسمعون النداء فلا يجيبوا فأحرق عليهم بيوتهم ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17224 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آتي هاؤلاء الذين يتخلقون عن الصلاة فأحرق عليهم بيوتهم ) )(@)(@@) ( ك ) عن ابن أم مكتوم رضي الله عنه .(@)(@@) PageV06P065(@)(@@)(@@)(@@) $ ( 17225 ) قال النبي :(@)(@@) | 30 ( لقد عذت بعظيم ، الحقي بأهلك ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها أن ابنة الجون لما أدخلت على النبي ودنا منها قالت : أعوذ بالله منك قال فذكره .(@)(@@)(@@)(@@) $ ( 17226 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن لا أتهب هبة إلا من أنصاري أو قرشي أو ثقفي ) )(@)(@@) ( حم طب بز ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17227 ) قال النبي :(@)(@@) | 30 ( لقد ابتدرها اثنا عشر ملكا فما نهنهها شيء دون العرش ) )(@)(@@) ( ن ) عن وائل بن حجر قال : سمع النبي يقول في الصلاة : الحمد لله حمدا كثيرا طيبا مباركا فيه قال 
ms1865	 فذكره .(@)(@@)(@@)(@@) $ ( 17228 ) قال النبي :(@)(@@) | 30 ( لقد رأيت بضعة وثلاثين ملكا يبتدرونها أيهم يكتبها أول ) )(@)(@@) ( حم خ ن ) عن رفاعة بن رافع قال : كنا نصلي يوما وراء رسول الله فلما رفع رأسه من الركعة قال رجل وراءه : ربنا لك الحمد حمدا كثيرا طيبا مباركا فيه ، فلما انصرف قال : من المتكلم آنفا ؟ قال رجل : أنا ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 17229 ) قال النبي :(@)(@@) | 30 ( لقد احتظرت بحظارة شديدة من النار ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه أن امرأة قالت : يا رسول الله قدمت ثلاثة من الولد قال : فذكره ، البغوي والباوردي وابن قانع وأبو مسعود الرازي في مسنده ( طب ض ) عن زهير بن علقمة رضي الله عنه إلا أن فيه : قالت مات لي ابنان .(@)(@@)(@@)(@@) $ ( 17230 ) قال النبي :(@)(@@) | 30 ( لقد تركتكم على البيضاء ليلها كنهارها ، لا يزيغ عنها بعدي إلا هالك ، ومن يعش منكم فسيرى اختلافا كثيرا ، فعليكم بما عرفتم من سنتي وسنة الخلفاء المهديين الراشدين ، وعليكم بالطاعة وإن عبدا حبشيا ، PageV06P066 عضوا عليها النواجذ ، فإنما المؤمن كالجمل الأنف حيثما قيد انقاد ) )(@)(@@) ( حم طب ) عن العرباض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17231 ) قال النبي :(@)(@@) | 30 ( لقد أتاني شيطان فنازعني ثم نازعني فأخذت بحلقه ، فوالذي بعثني بالحق ما أرسلته على وجدت برد لسانه على يدي ، ولولا دعوة سليمان أصبح طريحا في المسجد ) )(@)(@@) ابن أبي الدنيا في مكائد الشيطان عن الشعبي مرسلا .(@)(@@)(@@)(@@) $ ( 17232 ) قال النبي :(@)(@@) | 30 ( لقد أوجزت في المسألة ولقد أعرضت : تعبد الله لا تشرك به شيئا ، وتصلي الخمس ، وتصوم رمضان ، وما كرهت أن يأتيه الناس إليك فاكرهه لهم ) )(@)(@@) عن معن بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17233 ) قال النبي :(@)(@@) | 30 ( لقد شرفك الله وكرمك وعظمك ، والمؤمن أعظم حرمة منك يعني الكعبة ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17234 ) قال النبي :(@)(@@) | 30 ( لقد حسن إسلام صاحبكم ، لقد دخلت عليه ، وإن عنده لزوجتين له من الحور العين ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17235 ) قال النبي :(@)(@@) | 30 ( لقد أعذر الله إلى صاحب الستين سنة والسبعين ) )(@)(@@) ابن جرير عن أبي هريرة رضي 
ms1866	 الله عنه .(@)(@@)(@@)(@@) $ ( 17236 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر فتياني أن يجمعوا حزما من حطب ثم أنطلق فأحرق عليهم بيوتهم لا يشهدون الجمعة ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17237 ) قال النبي :(@)(@@) | 30 ( لقد كان دعاء أخي يونس عجبا : أوله تهليل ، وأوسطه تسبيح ، وآخره إقرار بالذنب : لا إلاه إلا أنت سبحانك إني كنت من الظالمين ، ما دعا بها مهموم ، ولا مغموم ، ولا مكروب ، ولا مديون في يوم ثلاث PageV06P067 مرات إلا استجيب له ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17238 ) قال النبي :(@)(@@) | 30 ( لقد نزل سبعون ألفا من الملائكة يشهدون سعد بن معاذ ، ما وطئوا الأرض قبل اليوم ) )(@)(@@) الديلمي عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17239 ) قال النبي :(@)(@@) | 30 ( لقد مر بي الليلة جعفر يقتفي نفرا من الملائكة ، له جناحان متخضبة قوادمهما بالدم يريدون بيشة بلدا باليمن ) )(@)(@@) ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17240 ) قال النبي :(@)(@@) | 30 ( لقد قبض الله داود من بين أصحابه فما فتنوا ولا بدلوا ، ولقد مكث أصحاب المسيح من بعده على سنته وهديه مائتي سنة ) )(@)(@@) ( ع طب كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17241 ) قال النبي :(@)(@@) | 30 ( لقد بت وإن الملائكة لتعاتبني في حس الخيل ومسحها ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17242 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن أبعث رجالا من أصحابي إلى ملوك الأرض يدعونهم إلى الإسلام كما بعث عيسى بن مريم الحواريين ، قالو ا : ألا تبعث أبا بكر وعمر فهما أبلغ ؟ قال : لا غنى لي عنهما ، إنما منزلتهما من الدين كمنزلة السمع والبصر من الجسد ) )(@)(@@) ( طب ) و الحاكم في الكنى ا عن ابن عمرو ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17243 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن أبعث قوما في الناس معلمين يعلمونهم السنة كما بعث عيسى بن مريم الحواريين في بني إسرائيل ، قيل : وأين أنت عن أبي بكر وعمر ؟ قال : إنه لا غنى لي عنهما ، إنهما من الدين كالرأس من الجسد ) )(@)(@@) ( كر ) عن حذيفة رضي 
ms1867	 الله عنه .(@)(@@) PageV06P068(@)(@@)(@@)(@@) $ ( 17244 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن أبعث الى الآفاق رجالا يعلمون الناس السنن والفرائض كما بعث عيسى الحواريين ، قيل له : فأين أنت من أبي بكر وعمر ؟ قال : إنه لا غنى لي عنهما ، إنهما من الدين كالسمع والبصر ) )(@)(@@) ( ك ) وتعقب عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17245 ) قال النبي :(@)(@@) | 30 ( لقد أعطيت الليلة خمسا ما أعطيهن أحد قبلي ، أما أولهن فأرسلت إلى الناس كلهم عامة وكان من قبلي إنما يرسل إلى قومه ، ونصرت بالرعب على العدو ولو كان بيني وبينه مسيرة شهر لملىء مني رعبا ، وأحلت لي الغنائم ، وكان من قبلي يعظمونها كانوا يحرقونها ، وجعلت لي الأرض مسجدا وطهورا أينما أدركتني الصلاة تمسحت وصليت ، وكان من قبلي يعظمون ذالك ، إنما كانوا يصلون في كنائسهم وبيعهم ، والخامسة : هي ما هي ، قيل لي : سل ، فإن كل نبي قد سأل ، فأخرت مسألتي إلى يوم القيامة فهي لكم ولمن شهد أن لا إلاه إلا الله ) )(@)(@@) ( حم ) و الحكيم عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 17246 ) قال النبي :(@)(@@) | 30 ( لقد اهتز العرش لوفاة سعد بن معاذ ) )(@)(@@) ( ش حم ) و ابن سعد ( حب ) والهيثم بن كليب وسمويه في فوائده ( طب ك ض ) عن محمد بن عمرو بن علقمة بن وقاص عن أبيه عن جده عن عائشة رضي الله عنها قالت : سمعت هاذا من أسيد بن حضير وهو يسير بيني وبين النبي ، قال ابن حجر في أطراف المختار : هو بمسند عائشة أشبه لأن هاذا يكون أخذا له عن النبي كالسماع ( ش ) وابن سعد ( طب ) عن أبي سعيد الخدري ( ش ) عن جابر ( ش ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17247 ) قال النبي :(@)(@@) | 30 ( لقد ضغط ضغطة أو همز همزة لو كان أحد ناجيا PageV06P069 منها بعمل لنجا سعد ) )(@)(@@) ابن سعد عن جعفر بن برقان بلاغا .(@)(@@)(@@)(@@) $ ( 17248 ) قال النبي :(@)(@@) | 30 ( لقد كفر الله عنك كذبك بتصديقك بلا إلاه إلا الله ) )(@)(@@) ( ع ) عن أنس رضي الله عنه أن رسول الله قال لرجل : أفعلت كذا وهو يعلم إنه فعله 
ms1868	 ؟ قال : لا والله والذي لا إلاه إلا هو ما فعلت قال فذكره .(@)(@@)(@@)(@@) $ ( 17249 ) قال النبي :(@)(@@) | 30 ( لقد ملىء عمار إيمانا إلى مشاشه ) )(@)(@@) ( كر ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 17250 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله فإنها خفيفة على اللسان ، ثقيلة في الميزان ، ولو جعلت لا إلاه إلا الله في كفة ، وجعلت السماوات والأرض في كفة لرجحت بهن لا إلاه إلا الله ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17251 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله فإنها تهدم الخطايا كما يهدم السيل البنيان ، قالوا : فكيف هي للأحياء ؟ قال : أهدم وأهدم ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17252 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله ولا تملوهم فإنهم في سكرات الموت ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17253 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم شهادة أن لا إلاه إلا الله ، فمن قالها عند موته وجبت له الجنة ، قالوا : يا رسول الله فمن قالها في صحته ؟ قال : تلك أوجب وأوجب ، والذي نفسي بيده ، لو جيء بالسماوات والأرضين ومن فيهن ، وما بينهن ، وما تحتهن ، فوضعت في كفة الميزان ، ووضعت شهادة أن لا إلاه إلا الله في الكفة الأخرى لرجحت بهن ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17254 ) قال النبي :(@)(@@) | 30 ( لقي آدم موسى فقال موسى : أنت آدم الذي PageV06P070 خلقك الله بيده ، وأسكنك جنته ، وأسجد لك ملائكته ثم فعلت ما فعلت ، فأخرجت ذريتك من الجنة ؟ قال آدم : أنت موسى الذي اصطفاك الله برسالاته ، وكلمك وقربك نجيا ، قال : نعم ، قال : فأنا أقدم أم الذكر ؟ قال : بل الذكر فحج آدم موسى ، فحج آدم موسى ، فحج آدم موسى ) )(@)(@@) ( طب ) عن جندب وأبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17255 ) قال النبي :(@)(@@) | 30 ( لقيت جبريل عند أحجار المرار ، فقلت : يا جبريل إني أرسلت إلى أمة أمية ، الرجل والمراة والغلام والجارية والشيخ القاسي الذي لم يقرأ كتابا قط ، فقال : إن القرآن أنزل على سبعة أحرف ) )(@)(@@) ( حم ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17256 ) قال 
ms1869	 النبي :(@)(@@) | 30 ( لقيت الملك فأخبرني : أنه من مات يشهد إن لا إلاه إلا الله كان له الجنة ، فما زلت أقول : وإن حتى قلت : وإن زنا ، وإن سرق ، قال : وإن زنا وإن سرق ) )(@)(@@) ( كر ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( اللام مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 17257 ) قال النبي :(@)(@@) | 30 ( لك الجنة علي يا طلحة غدا ) )(@)(@@) أبو نعيم في فضائل الصحابة عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17258 ) قال النبي :(@)(@@) | 30 ( لك بها سبعمائة ناقة مخطومة في الجنة ) )(@)(@@) ( حل ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17259 ) قال النبي :(@)(@@) | 30 ( لك بها يوم القيامة سبعمائة ناقة كلها مخطومة ) )(@)(@@) ( حم م ن ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV06P071(@)(@@)(@@)(@@) $ ( 17260 ) قال النبي :(@)(@@) | 30 ( لك في كل ذات كبد حرى أجر ) )(@)(@@) ( طب ) عن مخول السلمي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17261 ) قال النبي :(@)(@@) | 30 ( لك ما نويت يا يزيد ولك ما أخذت يا معن ) )(@)(@@) ( حم خ ) عن معن بن يزيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17262 ) قال النبي :(@)(@@) | 30 ( لكم أنتم أهل السفينة هجرتان ) )(@)(@@) ( ق ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17263 ) قال النبي :(@)(@@) | 30 ( لكم أن لا تحشروا ولا تعشروا ، ولا خير في دين ليس فيه ركوع ) )(@)(@@) ( حم د ) عن عثمان بن أبي العاص رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17264 ) قال النبي :(@)(@@) | 30 ( لكم كل عظم ذكر اسم الله عليه يقع في أيديكم أوفر ما يكون لحما ، وكل بعرة علف لدوابكم ، فلا تستنجوا بهما فإنهما طعام إخوانكم ) )(@)(@@) ( م ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17265 ) قال النبي :(@)(@@) | 30 ( لاكن أحسن الجهاد وأجمله حج مبرور ) )(@)(@@) ( خ ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17266 ) قال النبي :(@)(@@) | 30 ( لكل ابن آدم حظه من الزنا ، فزنا العين النظر ، وزنا اللسان المنطق ، والأذنان زناهما الاستماع ، واليدان يزنيان فزناهما البطش ، والرجلان يزنيان فزناهما المشي ، والفم يزني وزناه القبل ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17267 ) قال النبي :(@)(@@) | 30 ( لكل أمة أمين ، وأمين أمتي أبو عبيدة 
