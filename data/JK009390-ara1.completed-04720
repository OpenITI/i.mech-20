ms4701	 ، ش ، ص ، هق ) . )(@)(@@)(@@)(@@) $ ( 3594 ) عن قبيصة بن ذؤيب : ' أن طاعونا وقع بالشام فكان أهل البيت يموتون جميعا ، فكتب عمر رضي عنه أن يورثوا الأعلى من الأسفل ، وإذا لم يكونوا كذلك ورث هذ ا من ذا ، وهذا من ذا ' ( ش ، هق ) .(@)(@@)(@@)(@@) $ 3595 عن زيد بن ثابت رضي الله عنهما قال :(@)(@@) | 30 ( أمرني عمر بن الخطاب رضي الله عنه ليالي طاعون عمواس ، وكانت القبيلة تموت بأسرها فيرثهم قوم آخرون ، قال : فأمرني أن أورث الأحياء من الأموات ، ولا أورث الأموات بعضهم من بعض ) ( هق ) . )(@)(@@)(@@)(@@) $ 3596 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه لم يورث أحدا من الأعاجم إلا أحدا ولد في العرب ) ( مالك ، هق ) . )(@)(@@)(@@)(@@) $ ( 3597 ) عن سليمان بن يسار أن محمد بن الأشعث أخبره أن عمة له يهودية أو نصرانية توفيت وأنه أتى عمر بن الخطاب رضي الله عنه فقال له : من يرثها ؟ فقال عمر : يرثها أهل ملتها ' ( مالك ، هق ) . PageV14P317(@)(@@)(@@)(@@) $ 3598 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر رضي الله عنه كان يورث الإخوة من الأم من الدية ) ( مسدد ، عق ) . )(@)(@@)(@@)(@@) $ 3599 عن الزهري :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه قال : إذا لم يبق إلا الثلث بين الإخوة من الأب والأم وبين الإخوة من الأم فهم شركاء للذكر مثل حظ الأنثيين ) ( عب ) . )(@)(@@)(@@)(@@) $ 3600 عن إبراهيم قال :(@)(@@) | 30 ( كان عمر وعبد الله وزيد رضي الله عنهم يقولون في امرأة تركت زوجها وأمها وإخوتها لامها وإخوتها لامها وأبيها ، للزوج النصف ، وللأم السدس ، وأشركوا بين الإخوة من الأب والأم والأخوة من الأم في الثلث وقالوا : لم يزدهم أبوهم إلا قربا ) ( عب ، ص ، هق ) . )(@)(@@)(@@)(@@) $ 3601 عن الحارث عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان لا يورث الإخوة للأب والأم من هاذه الفريضة شيئا ) ( عب ) . )(@)(@@)(@@)(@@) $ 3602 عن أبي مجلز قال :(@)(@@) | 30 ( كان علي لا يشركهم ، وكان عثمان يشركهم ) ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 3603 عن طاووس(@)(@@) | 30 أنه قال في امرأة توفيت وتركت زوجها وأمها وإخوتها من أمها وإخوتها من أمها وأبيها : لامها السدس 
ms4702	 : ولزوجها الشطر ، والثلث بين الإخوة من الأم والأخت من الأب والأم ، وإن عمر بن الخطاب رضي الله عنه كان يقول : ( ألقوا أباها في الريح ، أما الأخت للأب والأم فإنها لا ترث به وإن ورثت مع الإخوة من أجل أنها ابنة أمهم ) ( عب ) . )(@)(@@)(@@)(@@) $ 3604 عن الشعبي :(@)(@@) | 30 ( أن عمر وعليا رضي الله عنهما قضيا في القوم يموتون جميعا لا يدرى أيهم مات قبل : أن بعضهم يرث بعضا ) ( عب ) . )(@)(@@)(@@)(@@) $ 3605 عن الشعبي :(@)(@@) | 30 ( أن عمر رضي الله عنه ورث بعضهم من بعض من تلاد أموالهم ، ولا يورثهم مما يرث بعضهم من بعض شيئا ) ( عب ) . )(@)(@@)(@@)(@@) $ 3606 عن ابن أبي ليلاى :(@)(@@) | 30 ( أن عمر وعليا رضي الله عنهما قالا في قوم غرقوا PageV14P318 جميعا لا يدرى أيهم مات قبل كأنهم كانوا إخوة ثلاثة ماتوا جميعا لكل رجل منهم ألف درهم وأمهم حية : يرث هاذا أمه وأخوه ، ويرث هاذا أمه وأخوه ، فيكون للأم من كل رجل منهم سدس ما ترك ، وللإخوة ما بقي كلهم كذالك ، ثم تعود الأم فترد سوى السدس الذي ورث أول مرة من كل رجل مما ورث من أخيه الثلث ) ( عب ) . )(@)(@@)(@@)(@@) $ 3607 عن إبراهيم قال :(@)(@@) | 30 ( قال عمر بن الخطاب رضي الله عنه : كل نسب توصل عليه في الإسلام فهو وارث مورث ) ( عب ) . )(@)(@@)(@@)(@@) $ 3608 عن عمرو بن شعيب قال :(@)(@@) | 30 ( قضى عمر بن الخطاب رضي الله عنه أنه من كان حليفا أو عديدا في قوم قد عقلوا عنه ونصروه فميراثه لهم إذا لم يكن له وارث يعلم ) ( عب ) . )(@)(@@)(@@)(@@) $ 3609 عن أبي بكر بن محمد بن عمرو بن حزم :(@)(@@) | 30 ( أن عمرو بن سليم الغساني أوصى وهو ابن اثني عشر أو ثنتي عشرة ببئر له قومت ثلاثين ألفا ، فأجاز عمر بن الخطاب رضي الله عنه وصيته ) ( عب ) . )(@)(@@)(@@)(@@) $ 3610 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( من أسلم علاى ميراث قبل أن يقسم ورث منه ) ( عب ) . )(@)(@@)(@@)(@@) $ 3611 عن محمد بن سرين في الجدات الأربع :(@)(@@) | 30 ( أن عمر رضي الله عنه أطعمهن السدس ) ( ق ) . )(@)(@@)(@@)(@@) $ 3612 عن 
ms4703	 أبي الزناد ، عن إبراهيم بن يحيى بن زيد بن ثابت عن جدته أم سعد بنت سعد بن الربيع امرأة ابن ثابت أنها أخبرته فقالت :(@)(@@) | 30 ( رجع إلي زيد بن ثابت يوما فقال : إن كانت لك حاجة أن نكلمه في ميراثك من أبيك ، فإن أمير المؤمنين عمر بن الخطاب رضي الله عنه قد ورث الحمل اليوم ، وكانت أم سعد حملا مقتل أبيها سعد بن الربيع ، فقالت أم سعد : ما كنت لأطلب من إخوتي شيئا ) ( هق ) . )(@)(@@)(@@)(@@) $ 3613 عن أبي وائل قال :(@)(@@) | 30 ( كتب إلينا عمر رضي الله عنه إذا كان أحدهما أخا لام فهو أحق بالميراث ) ( ابن جرير ) . )(@)(@@) PageV14P319(@)(@@)(@@)(@@) $ 3614 عن إبراهيم عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا كانت العصبة من نحو واحد وأحدهم أقرب بأم فالمال له ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 3615 عن ابن سيرين :(@)(@@) | 30 ( أن رجلا من بني حنظلة يقال له حسكة هلك ابن له وترك أباه حسكة وأم أبيه ، فرفع ذالك إلاى أبي موسى الأشعري ، فكتب في ذالك إلاى عمر بن الخطاب رضي الله عنه فكتب إليه عمر : أن ورث أم حسكة من ابن حسكة مع ابنها حسكة ) ( ص ) . )(@)(@@)(@@)(@@) $ 3616 عن إبراهيم :(@)(@@) | 30 ( أن رجلا عرف أختا له سبيت في الجاهلية ، فوجدها ومعها ابن لها لا يدرى من أبوه فاشتراهما ثم أعتقهما ، وأصاب الغلام موئلا ثم مات ، فأتوا ابن مسعود فذكروا له ذالك فقال : إئت أمير المؤمنين عمر رضي الله عنه فسله عن ذالك ثم ارجع فأخبرني بما يقول لك فأتى عمر فذكر ذالك له فقال : ما أراك عصبة ولا بذي فريضة ، فرجع إلاى ابن مسعود فأخبره ، فانطلق ابن مسعود حتى دخل علاى عمر فقال : كيف أفتيت بهذا الرجل ؟ قال : لم أره عصبة ولا بذي فريضة ، فقال عبد الله : هاذا لم تورثه من قبل الرحم ولا ورثته من قبل الولاء ، قال : ما ترى ؟ قال : أراه ذا رحم وولي النعمة وأرى أن تورثه ، قال : فورثه ) ( ص ) . )(@)(@@)(@@)(@@) $ 3617 عن إبراهيم قال :(@)(@@) | 30 ( ورث عمر رضي الله عنه الخال المال كله وكان 
ms4704	 خالا وكان مولى ) ( ص ) . )(@)(@@)(@@)(@@) $ ( 3618 ) عن عمرو بن شعيب عن أبيه عن جده : ' أن رئاب بن حذيفة تزوج امرأة فولدت له ثلاثة غلمة فماتت أمهم فورثوا رباعها وولاء مواليها ، وكان عمرو بن العاص رضي الله عنه عصبة بينهما فأخرجهم إلى الشام فماتوا ، فقدم عمرو بن العاص ومات مولى لها وترك مالا فخاصمه إخوتها إلى عمر بن الخطاب رضي الله عنه فقال عمر رضي الله عنه : قال رسول الله & : ما أرحز الولد أو الوالد فهو لعصبته من كان ، قال : فكتب له كتابا فيه شهادة عبد الرحمن بن عوف وزيد بن ثابت ورجل آخر ، فلما استخلف عبد الملك اختصموا إلى هشام بن إسماعيل فرفعهم إلى PageV14P320 عبد الملك فقال : هذا من القضاء الذي ما كنت أراه ، فقضى لنا بكتاب عمر بن الخطاب رضي الله عنه فنحن فيه إلى الساعة ' ( حم ، د ، ن ، هق وهو صحيح ) .(@)(@@)(@@)(@@) $ 3619 عن إبراهيم :(@)(@@) | 30 ( أن امرأة تركت بني عمها أحدهم أخوها لامها ، قال : قضى فيها عمر وعلي لأءخيها من أمها السدس وهو شريكهم في المال ، وقضى فيها عبد الله أن المال له دون بني عمه ) ( ش ) . )(@)(@@)(@@)(@@) $ 3620 عن إبراهيم قال :(@)(@@) | 30 ( كان عمر وعبد الله يورثان العمة والخالة إذا لم يكن غيرهما ) ( ص ، ش ) . )(@)(@@)(@@)(@@) $ 3621 عن عبد الله بن عبيد :(@)(@@) | 30 ( أن عمر رضي الله عنه ورث خالا ومولى من مولاه ) ( ش ) . )(@)(@@)(@@)(@@) $ 3622 عن عمر رضي الله عنه :(@)(@@) | 30 ( أنه ورث قوما غرقوا بعضهم من بعض ) ( ش ) . )(@)(@@)(@@)(@@) $ 3623 عن سعيد بن المسيب عن عمر رضي الله عنه قال :(@)(@@) | 30 ( سألت النبي كيف قسم الجد ؟ قال : ما سؤالك عن ذالك يا عمر ؟ إني أظنك تموت قبل أن تعلم ذالك . قال سعيد بن المسيب : فمات عمر قبل أن يعلم ذالك ) ( عب ، هق وأبو الشيخ في الفرائض ) . )(@)(@@)(@@)(@@) $ 3624 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إني قضيت في الجد قضيات مختلفات لم آل فيها عن الحق ) ( عب ) . )(@)(@@)(@@)(@@) $ 3625 عن عبيدة السلماني قال :(@)(@@) | 30 ( لقد حفظت من عمر بن الخطاب رضي الله 
ms4705	 عنه في الجد مائة قضية مختلفة كلها ينقض بعضها بعضا ) ( ش ، هق ، وابن سعد ، عب ) . )(@)(@@)(@@)(@@) $ 3626 عن ابن سيرين أن عمر رضي الله عنه قال :(@)(@@) | 30 ( أشهدكم أني لم أقض في الجد قضاء ) ( عب ) . )(@)(@@)(@@)(@@) $ 3627 عن نافع قال :(@)(@@) | 30 ( قال ابن عمر رضي الله عنهما : أجرؤكم علاى PageV14P321 جراثيم جهنم أجرؤكم علاى الجد ) ( عب ) . )(@)(@@)(@@)(@@) $ 3628 عن سعيد بن المسيب وعبيد الله بن عبد الله بن عتبة وقبيصة بن ذؤيب :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه قضى أن الجد يقاسم الأخوة للأب والام والاخوة للأب ما كانت المقاسمة خيرا له من ثلث المال ، فإن كثر الاخوة أعطي الجد الثلث وكان للإخوة ما بقي للذكر مثل حظ الانثيين ، وقضى أن بني الأب والام أولاى بذالك من بني الأب ذكورهم وإناثهم ، غير أن بني الأب يقاسمون الجد كبني الأب والام فيردون عليهم ، ولا يكون لبني الأب مع بني الأب والام شي إلا أن يكون بنو الأب يردون علاى بنات الأب والام مع بني الأب والام ، فإن بقي شيء بعد فرائض بنات الأب والام فهو للاخوة للأب للذكر مثل حظ الانثيين ) ( هق ) . )(@)(@@)(@@)(@@) $ ( 3629 ) عن عبد الرحمن بن أبي الزناد قال : ' أخذ أبو الزناد هذه الرسالة من خارجة بن زيد بن ثابت ومن كبراء آل زيد بن ثابت : بسم الله الرحمن الرحيم لعبد الله معاوية أمير المؤمنين من زيد بن ثابت ، فذكر الرسالة بطولها وفيها : إني رأيت من نحو قسم أمير المؤمنين يعني عمر رضي الله عنه ؟ بين الجد والأخوة من الأب إاذ كان أخا واحدا ذكرا مع الجد قسم ما ورثا بينهما شطرين ، فإن كان مع الجد أخت واحده قسم لها الثلث ، فإن كانتا أختين مع الجد قسم لهما الشطر وللجد الشطر ، فإن كان مع الجد من الثلث ، فإنه أخوان فإنه يقسم للجد الثلث ، فإن كانوا أكثر من ذلك فإني لم أره حسبت ينقص الجد من الثلث شيء ثم ما خلص للإخوة من ميراث أخيهم بعد الجد ، فإن بني الأب والأم هم أولى 
ms4706	 بعضهم من بعض بما فرض الله لهم دون بني العلة فلذلك حسبت نحوا من الذي كان عمر أمير المؤمنين يقسم بين الجد والإخوة من الأب ، ولم يكن يورث الإخوة من الأم الذين ليسوا من الأب مع الجد شيئا ، قال : ثم حسبت أمير المؤمنين عثمان بن عفان رضي الله عنه كان يقسم بين الجد والإخوة نحو الذي كتبت به إليك في هذه الصحيفة ' ( هق ) .(@)(@@)(@@)(@@) $ 3630 عن يحيى بن سعيد :(@)(@@) | 30 ( أنه بلغه أن معاوية بن أبي سفيان كتب إلاى زيد بن ثابت يسأله عن الجد ، فكتب إليه زيد بن ثابت : إنك كتبت إلي تسألني عن PageV14P322 الجد والله أعلم وذالك ما لم يكن يقضي فيه إلا الأمراء يعني الخلفاء وقد حضرت قبلك عمر وعثمان رضي الله عنهما يعطيانه النصف مع الأخ الواحد ، والثلث مع الاثنين ، فإن كثر الإخوة لم ينقصوه من الثلث شيئا ) ( مالك ، عب ، هق ) . )(@)(@@)(@@)(@@) $ ( 3631 ) عن سليمان بن يسار أنه قال : ' فرض عمر بن الخطاب وعثمان بن عفان وزيد بن ثابت ، رضي الله عنهم للجد الثلث مع الإخوة ' ( مالك ، هق ) .(@)(@@)(@@)(@@) $ 3632 عن عبيدة السلماني قال :(@)(@@) | 30 ( كان علي رضي الله عنه يعطي الجد مع الإخوة الثلث ، وكان عمر رضي الله عنه يعطيه السدس ، فكتب عمر إلاى عبد الله رضي الله عنهما : إنا نخاف أن نكون قد أجحفنا بالجد فأعطه الثلث فلما قدم علي رضي الله عنه هاهنا أعطاه السدس . قال عبيدة : فرأيهما في الجماعة أحب إلي من رأي أحدهما في الفرقة ) ( هق ) . )(@)(@@)(@@)(@@) $ 3633 عن الشعبي :(@)(@@) | 30 ( أن أول جد ورث في الإسلام عمر بن الخطاب رضي الله عنه ، مات ابن فلان ابن عمر فأراد عمر أن يأخذ المال دون إخوته ، فقال له علي وزيد رضي الله عنهما : ليس لك ذالك ، فقال عمر : لولا أن رأيكما اجتمع لم أر أن يكون ابني ولا أكون أباه ) ( هق وقال : هاذا مرسل الشعبي لم يدرك أيام عمر غير أنه مرسيل جيد ) . )(@)(@@)(@@)(@@) $ 3634 عن إبراهيم قال :(@)(@@) | 30 ( قال عمر رضي الله عنه في أم وأخت 
ms4707	 وجد : للأخت النصف وللأم ثلث ما بقي وللجد ما بقي ) ( عب ، ش ، هق ) . )(@)(@@)(@@)(@@) $ 3635 عن إبراهيم قال :(@)(@@) | 30 ( كان عمر وعبد الله بن مسعود رضي الله عنهما لا يفضلان أما علاى جد ) ( سفيان ، عب ، ش ، ص ، هق ) . )(@)(@@)(@@)(@@) $ 3636 عن طارق بن شهاب قال :(@)(@@) | 30 ( أخذ عمر بن الخطاب رضي الله عنه كتفا وجمع أصحاب رسول الله ليكتب الجد وهم يرون أنه يجعله أبا ، فخرجت عليهم حية فتفرقوا فقال : لو أن الله أراد أن يمضيه لأمضاه ) ( هق ، ص ) . )(@)(@@)(@@)(@@) $ 3637 عن الثوري عن عاصم عن الشعبي قال :(@)(@@) | 30 ( عمر رضي الله عنه أول PageV14P323 جد ورث في الإسلام ) ( عب ) . )(@)(@@)(@@)(@@) $ 3638 عن مروان :(@)(@@) | 30 ( أن عمر رضي الله عنه حين طعن قال : إني كنت قضيت في الجد قضاء فإن شئتم أن تأخذوا به فافعلوا ، فقال له عثمان رضي الله عنه : إن نتبع رأيك رشد ، وإن نتبع رأي الشيخ قبلك فنعم ذو الرأي كان ) ( عب ، هق ) . )(@)(@@)(@@)(@@) $ 3639 عن قتادة قال :(@)(@@) | 30 ( دعا عمر بن الخطاب علي بن أبي طالب وزيد بن ثابت وعبد الله بن عباس رضي الله عنهم فسألهم عن الجد فقال له علي : له الثلث علاى كل حال ، وقال زيد : له الثلث مع الإخوة ، وله السدس من جميع الفريضة ، ويقاسم ما كانت المقاسمة خيرا له ، وقال ابن عباس : هو أب ليس للإخوة معه ميراث ، وقد قال الله تعالاى : { ملة أبيكم إبراهيم } وبيننا وبينه آباء ، فأخذ عمر بقول زيد ) ( عب ) . )(@)(@@)(@@)(@@) $ 3640 حدثنا معمر عن الزهري قال :(@)(@@) | 30 ( إنما هاذه فرائض عمر بن الخطاب ولاكن زيدا رضي الله عنهما أثارها بعد وفشت عنه ) ( عب ) . )(@)(@@)(@@)(@@) $ 3641 عن معمر عن الزهري قال :(@)(@@) | 30 ( كان عمر بن الخطاب رضي الله عنه يشرك بين الجد والأخ إذا لم يكن غيرهما ، ويجعل له الثلث مع الأخوين ، وما كانت المقاسمة خيرا له قاسم ، ولا ينقص عن السدس في جميع المال ، قال : ثم أثارها زيد بعده وفشت عنه ) ( عب ) . )(@)(@@)(@@)(@@) $ 3642 عن ابن شهاب قال :(@)(@@) | 30 ( أول من ورث الجدتين عمر بن الخطاب 
ms4708	 رضي الله عنه فجمع بينهما ) ( عب ) . )(@)(@@)(@@)(@@) $ 3643 عن زيد بن ثابت :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه استأذن عليه يوما فأذن له ورأسه في يد جارية له ترجله ، فنزع رأسه ، فقال له عمر : دعها ترجلك قال : يا أمير المؤمنين لو أرسلت إلي جئتك فقال عمر رضي اللله عنه : PageV14P324 إنما الحاجة لي ، إني جئتك لتنظر في أمر الجد ، فقال زيد : لا والله ما يقول فيه ، فقال عمر رضي الله عنه : ليس هو بوحي حتى نزيد فيه أو ننقص ، إنما هو شيء نراه ، فإن رأيته وافقني تبعته وإلا لم يكن عليك فيه شيء ، فأبى زيد فخرج عمر رضي الله عنه مغضبا ، قال : قد جئتك وأنا أظنك ستفرغ من حاجتي ثم أتاه مرة أخرى في الساعة التي أتاه المرة الأولاى فلم يزل به حتى قال : فسأكتب لك فيه كتابا ، فكتب في قطعة قتب وضرب له مثلا :(@)(@@) $ 30 إنما مثله مثل شجرة نبتت علاى ساق واحد ، فخرج فيها غصن ، ثم خرج في الغصن غصن آخر ، فالساق يسقي الغصن ، فإن قطع الغصن الأول رجع الماء إلاى الغصن يعني الثاني ، وإن قطع الثاني رجع الماء إلاى الأول ، فأتي به فخطب الناس عمر ثم قرأ قطعة القتب عليهم ، ثم قال : إن زيد بن ثابت قد قال في الجد قولا وقد أمضيته ، قال : وكان أول جد كان ، فأراد أن يأخذ المال كله مال ابن ابنه دون إخوته فقسمه بعد ذالك عمر بن الخطاب ) ( هق ) . ) $(@)(@@)(@@)(@@) $ 3644 عن الحسن أن عمر بن الخطاب رضي الله عنه نشد الناس فقال :(@)(@@) | 30 ( من كان منكم عنده علم من رسول الله في الجد فليقم فقام معقل بن يسار المزني فقال : قضى رسول الله في جد كان فينا ، قال : كم أعطاه ؟ قال : دعطاه السدس ، قال : مع من ؟ قال : لا أدري ، قال : لا دريت ) ( ص ) . )(@)(@@)(@@)(@@) $ 3645 حدثنا أبو معشر عن عيسى بن عيسى الحناط قال :(@)(@@) | 30 ( سأل عمر بن الخطاب رضي الله عنه الناس : أيكم سمع رسول الله قال في الجد شيئا ؟ فقال 
ms4709	 رجل : أنا ، فقال : ما أعطاه ؟ قال : أعطاه سدس ماله ، قال : ماذا معه من الورثة ؟ قال : لا أدري ، قال : لا دريت ، وقال آخر : لي علم يا أمير المؤمنين ، ماذا أعطى الجد ؟ أعطاه ثلث ماله ، قال : ماذا معه من الورثة ؟ قال : لا أدري ، قال : لا دريت ، وقال آخر : لي علم ماذا أعطاه ، أعطاه نصف ماله ، قال : ماذا معه من الورثة ؟ قال : لا أدري ، قال : لا دريت ، وقال آخر : لي علم ماذا أعطاه ، أعطاه المال كله ، قال : من معه من الورثة ؟ قال : لا أدري ، قال : لا دريت . فلما وضع زيد بن ثابت الفرائض أعطاه سدس ماله مع الولد الذكر ، وأعطاه ثلث ماله مع PageV14P325 الإخوة ، وأعطاه نصف ماله مع الأخ ، وأعطاه المال كله إذا لم يكن له وارث ) ( ص ) . )(@)(@@)(@@)(@@) $ 3646 عن سعيد عن أبيه :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كتب إلاى أبي موسى الأشعري : أن اجعل الجد أبا فإن أبا بكر جعل الجد أبا ) ( ض ) . )(@)(@@)(@@)(@@) $ 3647 عن سعيد بن جبير قال :(@)(@@) | 30 ( مات ابن ابن لعمر بن الخطاب رضي الله عنه وترك جده عمر وإخوته ، فأرسل عمر إلاى زيد بن ثابت فجعل زيد يحسب ، فقال له عمر : شعث ما كنت مشعثا فلعمري إني لأعلم أني لأحق به منهم ) ( ص ) . )(@)(@@)(@@)(@@) $ 3648 عن عبيد بن نضلة قال :(@)(@@) | 30 ( كان عمر وعبد الله يقاسمان بالجد مع الإخوة ما بينه وبين أن يكون السدس خيرا له من مقاسمتهم ، ثم إن عمر كتب إلاى عبد الله : ما أرانا إلا قد أجحفنا بالجد ، فإذا جاءك كتابي هاذا فقاسم به مع الإخوة ما بينه وبين أن يكون الثلث خيرا له من مقاسمتهم ، فأخذ به عبد الله ) ( ص ، ش ، لق ) . )(@)(@@)(@@)(@@) $ 3649 عن عبد الرحمان بن غنم قال :(@)(@@) | 30 ( إن أول جد ورث في الإسلام عمر بن الخطاب رضي الله عنه ، فأراد أن يجتاز المال ، فقلت له : يا أمير المؤمنين إنهم شجرة دونك يعني بني بنيه ) ( ش ) . )(@)(@@)(@@)(@@) $ 3650 عن مسروق قال :(@)(@@) | 30 ( كان ابن مسعود رضي الله عنه لا يزيد 
ms4710	 الجد علاى السدس مع الإخوة ، فقلت له : شهدت عمر بن الخطاب رضي الله عنه أعطاه الثلث مع الإخوة فأعطاه الثلث ) ( ش ) . )(@)(@@)(@@)(@@) $ 3651 عن عمر بن الخطاب رضي الله عنه قال :(@)(@@) | 30 ( عجبا للعمة تورث ولا ترث ) ( مالك ، ش ، هق ) . )(@)(@@)(@@)(@@) $ 3652 عن أبان بن عثمان :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كان لا يورث الحميل ) ( ش ) . )(@)(@@)(@@)(@@) $ 3653 عن ابن عباس رضي الله عنهما :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله PageV14P326 عنه كان لا يورث الحميل ) ق ، وضعفه ) . )(@)(@@)(@@)(@@) $ 3654 عن سعد بن إبراهيم :(@)(@@) | 30 ( أن أبا موسى رضي الله عنه كتب إلاى عمر رضي الله عنه أن الرجل يموت قبلنا وليس له رحم ولا ولي ، فكتب إليه عمر : إن ترك ذا رحم فالرحم ، وإلا فالولاء ، وإلا فبيت المال ، يرثونه ويعقلون عنه ) ( ش ) . )(@)(@@)(@@)(@@) $ 3655 عن إبراهيم قال :(@)(@@) | 30 ( قال عمر رضي الله عنه : أهل الشرك لا نرثهم ولا يرثونا ) ( سفيان الثوري في الفرائض والدارمي ) . )(@)(@@)(@@)(@@) $ 3656 عن أنس بن سيرين قال :(@)(@@) | 30 ( قال عمر رضي الله عنه : لا يتوارث أهل ملتين شتى ولا يحجب من لا يرث ) ( عب والدارمي ، ص ، هق ) . )(@)(@@)(@@)(@@) $ 3657 عن الشعبي قال :(@)(@@) | 30 قال عمر رضي الله عنه : ( لا يرث القاتل من المقتول شيئا إن قتله عمدا أو قتله خطأ ) ( ش ، عب ، والدارمي ، عق ، هق ) . )(@)(@@)(@@)(@@) $ 3658 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لا نرث أهل الملل ولا يرثونا ) ( مالك ، عب ، ص ، هق ) . )(@)(@@)(@@)(@@) $ 3659 عن ابن قلابة قال :(@)(@@) | 30 ( قتل رجل أخاه في زمان عمر بن الخطاب رضي الله عنه فلم يورث ، فقال : يا أمير المؤمنين إنما قتلته خطأ ، قال : لو قتلته عمدا أقدناك به ) ( عب ) . )(@)(@@)(@@)(@@) $ 3660 عن عمرو بن شعيب :(@)(@@) | 30 ( أن رجلا من بني مدلج يقال له قتادة حذف ابنه بالسيف فأصاب ساقه فنزف منها فمات ، فقدم سراقة بن مالك بن جعشم علاى عمر بن الخطاب رضي الله عنه فذكر ذالك له ، فقال له عمر : أعدد لي علاى ماء قديد مائة وعشرين بعيرا حتى أقدم عليك فلما 
ms4711	 قدم عليه عمر أخذ من تلك الإبل ثلاثين حقة جذعة وأربعين خلفة ، ثم قال : أين أخو المقتول قال : ها أنا ذا ، قال : خذها فإن رسول الله قال : ليس للقاتل شيء ) ( مالك والشافعي ، هق ) . )(@)(@@)(@@)(@@) $ 3661 عن الشعبي :(@)(@@) | 30 ( أن الأشعث بن قيس وفد إلاى عمر بن الخطاب رضي PageV14P327 الله عنه في ميراث عمة له يهودية ، فلما قدم عليه قال له عمر : أجئتني في ميراث المقرات بنت الحارث ؟ قال : أولست أولاى الناس بها ؟ قال : أهل ملتها من دينها ، لا يتوارث أهل ملتين ) ( ص ) . )(@)(@@)(@@)(@@) $ 3662 عن عمرو بن شعيب عن أبيه عن عبد الله بن عمرو بن العاص قال :(@)(@@) | 30 ( غضب رجل من بني مدلج علاى ابن له فحذفه بسيفه فأصاب رجله فنزف الغلام فمات ، فانطلق في رهط من قومه إلاى عمر رضي الله عنه ، فقال : يا عدو نفسه أنت الذي قتلت ابنك لولا أني سمعت رسول الله يقول : لا يقاد للإبن من أبيه لقتلتك ، هلم ديته فأتاه بعشرين أو ثلاثين ومائة بعير ، فخير منها مائة : ثلاثين حقة ، وثلاثين جذعة ، وأربعين ما بين ثنية إلاى بازل ، عامها كلها خلفة ، فدفعها إلاى ورثته وفي لفظ إلاى إخوته وترك أباه ) ( هق ) . )(@)(@@)(@@)(@@) $ 3663 عن عمرو بن مرة عن عمر رضي الله عنه قال :(@)(@@) | 30 ( ثلاث لأن يكون رسول الله بينهن لنا أحب إلي من الدنيا وما فيها : الخلافة ، والكلالة ، والربا ، قال عمرو : قلت لمرة : ومن يشك في الكلالة هو ما دون الوالد والولد ، قال : إنهم كانوا يشكون في الوالد ) ( عب ، ط ، ش ، والعدني ، ه ، والشاشي وأبو الشيخ في الفرائض ، ، هق ، ض ) . )(@)(@@)(@@)(@@) $ 3664 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر رضي الله عنه سأل رسول الله كيف يورث الكلالة ؟ قال : أوليس قد بين الله ذالك ؟ ثم قرأ : { وإن كان رجل يورث كلالة أو امرأة } إلاى آخر الآية ، فكان عمر لم يفهم فأنزل الله : { يستفتونك قل الله يفتيكم في الكلالة } إلاى آخر الآية ، فكان عمر لم يفهم فقال لحفصة : إذا رأيت من رسول الله طيب نفس فاسأليه عنها 
ms4712	 فقال : أبوك ذكر لك هاذا ؟ ما أرى أباك يعلمها أبدا فكان يقول : ما أراني أعلمها أبدا ، وقد قال رسول الله ما قال ) ( ابن راهويه وابن مردويه ، وهو صحيح ) . )(@)(@@) PageV14P328(@)(@@)(@@)(@@) $ 3665 عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( كنت آخر الناس عهدا بعمر رضي الله عنه فسمعته يقول : القول ما قلت ، قلت : وما قلت ؟ قال : قلت : الكلالة من لا ولد له ) ( عب ، ص ، ش ، وابن جرير وابن المنذر وابن أبي حاتم ، ك ، هق ) . )(@)(@@)(@@)(@@) $ 3666 عن السميط قال :(@)(@@) | 30 ( كان عمر رضي الله عنه يقول : الكلالة ما خلا الولد والوالد ) ( ش ، هق ) ولفظه : أتى علي زمن وما أدري ما الكلالة ، وإذا الكلالة من لا أب له ولا ولد ) . )(@)(@@)(@@)(@@) $ 3667 عن الشعبي قال :(@)(@@) | 30 ( سئل أبو بكر رضي الله عنه عن الكلالة فقال : إني أقول فيها برأيي ، فإن كان صوابا فمن الله وحده لا شريك له ، وإن كان خطأ فمني ومن الشيطان والله منه بريء ، أراه ما خلا الوالد والولد ، فلما استخلف عمر رضي الله عنه قال : الكلالة ما عدا الولد وفي لفظ : من لا ولد له فلما طعن عمر رضي الله عنه قال : إني لأستحيي الله أن أخالف أبا بكر ، أرى أن الكلالة ما عدا الوالد والولد ) ( ص ، عب ، ش والدارمي وابن جرير وابن المنذر ، هق ) . )(@)(@@)(@@)(@@) $ 3668 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لأن أكون أعلم الكلالة أحب إلي من أن يكون لي مثل قصور الشام ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 3669 عن مسروق قال :(@)(@@) | 30 ( سألت عمر بن الخطاب رضي الله عنه عن ذي قرابة لي ورث كلالة ؟ فقال : الكلالة الكلالة وأخذ بلحيته ، ثم قال : والله لأن أعلمها أحب إلي من أن يكون لي ما علاى الأرض من شيء ، سألت عنها رسول الله فقال : ألم تسمع الآية التي أنزلت في الصيف ؟ فأعادها ثلاث مرات ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 3670 عن ابن سيرين :(@)(@@) | 30 ( أن عمر رضي الله عنه كان إذا قرأ : { يبين الله لكم أن تضلوا } قال : اللهم من بينت له الكلالة فلم يبين لي 
ms4713	 ) ( عب ) . )(@)(@@) PageV14P329(@)(@@)(@@)(@@) $ 3671 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر رضي الله عنه كتب أمر الجد والكلالة في كتف ثم طفق يستخير ربه فقال : اللهم إن علمت فيه خيرا فأمضه فلما طعن دعا بالكتف فمحاها ثم قال : إني كنت كتبت كتابا في الجد والكلالة وكنت أستخير الله فيه وإني رأيت أن أردكم علاى ما كنتم عليه ، فلم يدروا ما كان في الكتف ) ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 3672 عن عبد الله بن شداد بن الهاد :(@)(@@) | 30 ( أن سالما مولاى أبي حذيفة قتل يوم اليمامة ، فباع عمر رضي الله عنه ميراثه فبلغ مائتي درهم ، فأعطاه أمه ، فقال : كليها ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ 3673 عن عمرو بن شعيب :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كتب إلاى عمرو بن العاص : إنك كتبت تسألني عن قوم دخلوا في الإسلام فماتوا ، قال : يرفع مال أولائك إلاى بيت مال المسلمين ، وكتبت تسألني عن الرجل يسلم فيعاد القوم ويعاقلهم وليس له فيهم قرابة ولا لهم عليه نعمة ، قال : فاجعل ميراثه لمن عاقل وعاد ) ( ص ) . )(@)(@@)(@@)(@@) $ 3674 عن إبراهيم قال :(@)(@@) | 30 ( كان عمر وعلي وزيد بن ثابت رضي الله عنهم يقولون : الولاء للكبر ، فلا يرث النساء من الولاء إلا ما أعتقن أو كاتبن ) ( عب ، ش والدارمي ، ق ) . )(@)(@@)(@@)(@@) $ 3675 عن عبد الله بن عتبة بن مسعود قال :(@)(@@) | 30 ( كتب إلي عمر رضي الله عنه أن الولاء للكبر ) ( الدارمي ) . )(@)(@@)(@@)(@@) $ 3676 عن الحكم بن عتبة قال :(@)(@@) | 30 ( اختصم علي والزبير إلاى عمر رضي الله عنه في موالي صفية ، فقال علي : عمتي وأنا أعقل عنها وأرثها ، وقال الزبير : أمي وأنا أرثها ، فقال عمر لعلي : أما علمت أن رسول الله جعل الولاء تبعا للميراث فقضى به للزبير ) ( ابن راهويه ) . )(@)(@@) PageV14P330(@)(@@)(@@)(@@) $ 3677 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إن كان لرجل موالي وله ابنان فمات الأب كان الولاء لابنيه ، فإن مات أحد ابنيه وله ولد ذكور ثم مات بعض الموالي فإن ابن الابن علاى حصة أبيه من الولاء ، ولم يكن الولاء كله لعمه ) ( عب ) . )(@)(@@)(@@)(@@) $ 3678 عن عطاء بن أبي 
ms4714	 رباح :(@)(@@) | 30 ( أن طارقا بن المرقع أعتق أهل بيت سوائب فأتي بميراثهم ، فقال عمر رضي الله عنه : أعطوه ورثة طار ، فأبوا أن يأخذوه ، فقال عمر : فاجعلوه في مثلهم من الناس ) ( الشافعي ، ق ) . )(@)(@@)(@@)(@@) $ 3679 عن عطاء بن أبي رباح :(@)(@@) | 30 ( أن طارق بن المرقع أعتق رجلا سائبة ، فمات السائبة وترك مالا ، فعرض ماله علاى طارق فأبى أن يأخذه ، فكتب عامل مكة إلاى عمر بن الخطاب رضي الله عنه ، فكتب عمر أن اجمع المال واعرضه علاى طارق فإن قبله فادفعه إليه ، وإن لم يقبله فاشتر رقابا فأعتقهم ، قال : فعرض علاى طارق فلم يقبله ، فاشترى به خمسة عشر أو ستة عشر مملوكا فأعتقهم ) ( هق ) . )(@)(@@)(@@)(@@) $ 3680 عن عبد الله بن وديعة بن خدام قال :(@)(@@) | 30 ( كان سالم مولاى أبي حذيفة مولى لامرأة منا يقال لها : سلمى بنت يعار أعتقته سائبة في الجاهلية ، فلما أصيب باليمامة أتي عمر بن الخطاب رضي الله عنه بميراثه فدعا وديعة بن خدام فقال : هاذا ميراث مولاكم ، وأنتم أحق به ، فقال : يا أمير المؤمنين قد أغنانا الله عنه ، قد أعتقته صاحبتنا سائبة فلا نريد أن نرزأ من امرأة شيئا ، فجعله عمر في بيت المال ) ( خ في تاريخه ، ق ) . )(@)(@@)(@@)(@@) $ 3681 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا كانت المرأة تحت المملوك فولدت منه ولدا فإنه يعتق بعتق أمه وولاؤه لموالي أمه ، فإذا أعتق الأب جر الولاء موالي أبيه ) ( عب والدارمي ، ق وصححه ) . )(@)(@@)(@@)(@@) $ 3682 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إن الولاء كالرحم وفي لفظ : كالنسب لا يباع ولا يوهب ) ( ش ، ق ) . )(@)(@@)(@@)(@@) $ 3683 عن قبيصة بن ذؤيب قال :(@)(@@) | 30 ( كان الرجل إذا أعتق سائبة لم يرثه ، وإذا PageV14P331 جنى جناية كان علاى من أعتقه ، فدخلوا علاى عمر بن الخطاب رضي الله عنه فقالوا : يا أمير المؤمنين أنصفنا ، إما أن يكون عليكم العقل ولكم الميراث ، وإما أن يكون لنا الميراث وعلينا العقل فقضى عمر لهم بالميراث ) ( هق ) . )(@)(@@)(@@)(@@) $ 3684 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر رضي الله عنه أعتق أمهات الأولاد وقال 
ms4715	 : أعتقهن رسول الله ) ( خط ، وفيه عبد الرحمان الإفريقي ضعيف ) . )(@)(@@)(@@)(@@) $ 3685 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( الأمة يعتقها ولدها وإن كان سقطا ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ 3686 عن سليمان بن يسار قال :(@)(@@) | 30 ( قلت لابن المسيب أعمر رضي الله عنه أعتق أمهات الأولاد ؟ قال : لا ، ولاكن أعتقهن رسول الله ) ( عب ، ق ، وضعفه ) . )(@)(@@)(@@)(@@) $ 3687 عن سعيد بن المسيب :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه أمر بأمهات الأولاد يقومن في أموال أبنائهن بقيمة عدل ثم يعتقن ، فمكث بذالك صدرا من خلافته ، ثم توفي رجل من قريش كان له ابن أم من ولد ، فكان عمر يعجب بذالك الغلام ، فمر ذالك الغلام علاى عمر رضي الله عنه في المسجد بعد وفاة أبيه بلال ، فقال له عمر : ما فعلت يا ابن أخي في أمك ؟ قال : قد فعلت يا أمير المؤمنين خيرا ، خيرني إخوتي في أن يسترقوا أمي أو يخرجوني من ميراثي من أبي ، فكان ميراثي من أبي أهون علي من أن تسترق أمي ، فقال عمر : أولست إنما أمرت في ذالك بقيمة عدل ، ما أرى رأيا وآمر بشيء إلا قلتم فيه ، ثم قام فجلس علاى المنبر فاجتمع إليه الناس حتى إذا رضي جماعتهم قال : يا أيها الناس إني قد كنت أمرت في أمهات الأولاد بأمر قد علمتموه ثم قد حدث لي رأي غير ذالك ، فأيما امرىء كانت عنده أم ولد يملكها بيمينه ما عاش ، فإذا مات فهي حرة لا سبيل عليها ) ( يعقوب بن سفيان ، ق ، كر ) . )(@)(@@)(@@)(@@) $ 3688 عن زيد بن وهب قال :(@)(@@) | 30 ( باع عمر رضي الله عنه أمهات الأولاد ثم رجع ) ( ق ) . )(@)(@@) PageV14P332(@)(@@)(@@)(@@) $ 3689 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( أيما وليدة ولدت لسيدها فهي له متعة ما عاش ، فإذا مات فهي حرة من بعده ، ومن وطىء وليدة فضيعها فالولد له والضيعة عليه ) ( ق ) . )(@)(@@)(@@)(@@) $ 3690 عن ابن عمر :(@)(@@) | 30 ( أن عمر رضي الله عنهما قضى في أم الولد أن لا تباع ولا توهب ولا تورث ، يستمتع بها صاحبها ما عاش ، فإذا مات فهي 
ms4716	 حرة ) ( عب ، ومسدد ، ق ) . )(@)(@@)(@@)(@@) $ 3691 عن أبي إسحاق الهمداني :(@)(@@) | 30 ( أن أبا بكر كان يبيع أمهات الأولاد في إمارته ، وعمر رضي الله عنه في نصف إمارته ، ثم إن عمر قال : كيف تباع وولدها حر ؟ فحرم بيعها ، حتى إذا كان عثمان شكوا وركنوا في ذالك ) ( عب ) . )(@)(@@)(@@)(@@) $ 3692 عن أبي العجفاء :(@)(@@) | 30 ( أن عمر رضي الله عنه قال : الأمة إذا أسلمت وعفت وحصنت فإن ولدها يعتقها ، وإن فجرت وكفرت أو قال : زنت رقت ) ( عب ) . )(@)(@@)(@@)(@@) $ 3693 عن محمد بن عبد الله الثقفي :(@)(@@) | 30 ( أن أباه عبد الله بن فارط اشترى جارية بأربعة آلاف ثم أسقطت لرجل سقطا فسمع بذالك عمر بن الخطاب رضي الله عنه ، فأرسل إليه قال : وكان أبي عبد الله بن فارط صديقا لعمر بن الخطاب فلامه لوما شديدا وقال : والله إن كنت لأنزهك عن هاذا أو عن مثل هاذا وأقبل علاى الرجل ضربا بالدرة وقال : الآن حين اختلط لحومكم ولحومهن ، ودماؤكم ودماؤهن ، تبيعونهن وتأكلون أثمانهن ، قاتل الله اليهود حرمت عليهم الشحوم فباعوها ، وأكلوا أثمانها ، ارددها فردها ) ( عب ) . )(@)(@@)(@@)(@@) $ 3694 عن عبيدة السلماني قال :(@)(@@) | 30 ( سمعت عليا رضي الله عنه يقول : اجتمع رأيي ورأي عمر رضي الله عنهما في أمهات الأولاد أن لا يبعن ثم رأيت بعد أن يبعن ، قال عبيدة قلت له : فرأيك ورأي عمر في الجماعة أحب إلي من رأيك وحدك في الفرقة أو قال في الفتنة فضحك علي ) ( عب وابن عبد البر في العلم ، هق ) . )(@)(@@) PageV14P333(@)(@@)(@@)(@@) $ 3695 عن خالد بن سلمة المخزومي قال :(@)(@@) | 30 ( جاء رجل إلاى عمر رضي الله عنه بعرفة فقال : إني أعتقت شقصا من غلامي هاذا ، قال : أعتق كله ليس معه شريك ) ( سفيان الثوري في الجامع ، ق ) . )(@)(@@)(@@)(@@) $ 3696 عن عبد الرحمان بن يزيد قال :(@)(@@) | 30 ( كان بيني وبين الأسود وأمنا غلام قد شهد القادسية وأبلاى فيها فأرادوا عتقه ، وكنت صغيرا ، فذكر الأسود ذالك لعمر رضي الله عنه فقال : أعتقوا أنتم ويكون عبد الرحمان علاى نصيبه حتى يرغب في مثل ما رغبتم فيه أو يأخذ نصيبه ) ( ق ) . )(@)(@@)(@@)(@@) $ 3697 
ms4717	 عن ابن شبرمة(@)(@@) | 30 : ( أن عمر بن الخطاب رضي الله عنه قال لرجل له نصيب في عبد : لا تفسد علاى أصحابك فتضمن ) ( عب ) . )(@)(@@)(@@)(@@) $ 3698 عن النخعي :(@)(@@) | 30 ( أن رجلا أعتق شركا له في عبد وله شركاء يتامى ، فقال عمر بن الخطاب رضي الله عنه : انتظرهم حتى يبلغوا ، فإن أحبوا أن يعتقوا أعتقوا ، وإن أحبوا أن يضمن لهم ضمن ) ( عب ) . )(@)(@@)(@@)(@@) $ 3699 عن محمد بن سيرين قال :(@)(@@) | 30 ( كان عبد بين رجلين ، فأعتق أحدهما نصيبه ، فكتب شريكه إلاى عمر رضي الله عنه فكتب أن يقوم علاى القيمة ) ( مسدد ، ق ) . )(@)(@@)(@@)(@@) $ 3700 عن ابن عمر قال :(@)(@@) | 30 ( ذكر عند عمر رضي الله عنه الثلث في الوصية ، فقال : الثلث وسط ، لا بخس ولا شطط ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ 3701 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( يحدث الرجل في وصيته ما شاء ، وملاك الوصية آخرها ) ( عب ، والدارمي ) . )(@)(@@)(@@)(@@) $ 3702 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا كانت وصية أو عتاقة فحاصوا ) ( ص ، ق ) . )(@)(@@)(@@)(@@) $ 3703 عن عمرو بن سليم الزرقي قال :(@)(@@) | 30 ( قيل لعمر بن الخطاب رضي الله عنه : إن هاهنا غلاما يفعا لم يحتلم من غسان ، ووراثه بالشام وهو ذو مال ، وليس له PageV14P334 هاهنا إلا ابنة عم له ، فقال عمر بن الخطاب رضي الله عنه : فليوص لها ، فأوصى لها ) ( مالك ، ش ) . )(@)(@@)(@@)(@@) $ 3704 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا التقى الزحفان والمرأة يضربها المخاض ، لا يجوز لهما في مالهما إلا الثلث ) ( عب ، ش ، ص ) . )(@)(@@)(@@)(@@) $ 3705 عن الحسن :(@)(@@) | 30 ( أن عمر رضي الله عنه أوصى لامهات أولاده بأربعة آلاف أربعة آلاف ) ( ص ) . )(@)(@@)(@@)(@@) $ 3706 عن العلاء بن زياد قال :(@)(@@) | 30 ( جاء شيخ إلاى عمر رضي الله عنه فقال : يا أمير المؤمنين أنا شيخ كبير وإن مالي كثير ، ويرثني أعراب موالي كلالة ، فأوصي بمالي كله ؟ قال : لا ، فلم يزل حتى بلغ العشر ) ( ص ) . )(@)(@@)(@@)(@@) $ 3707 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( طلق غيلان بن سلمة الثقفي نساءه وقسم ماله بين بنيه في خلافة عمر رضي الله عنه 
ms4718	 ، فبلغ ذالك عمر ، فقال له : أطلقت نساءك وقسمت مالك بين بنيك ؟ قال : نعم ، قال : والله إني لأرى الشيطان فيما يسترق من السمع ، سمع بموتك فألقاه في نفسك ، فلعلك أن لا تمكث إلا قليلا ، وأيم الله لئن لم تراجع نساءك وترجع في مالك لأورثهن منك إذا مت ثم لآمرن بقبرك فليرجمن كما يرجم قبر أبي رغال فراجع نساءه وراجع ماله ، فما مكث إلا سبعا حتى مات ) ( عب ) . )(@)(@@)(@@)(@@) $ 3708 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( السائبة والصدقة ليومها يعني : يوم القيامة ) ( سفيان الثوري في الفرائض عب ، ش ، وأبو عبيدة في الغريب هق ) . )(@)(@@)(@@)(@@) $ 3709 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( المكاتب عبد ما بقي عليه درهم ) ( ش ، والطحاوي ، ق ) . )(@)(@@)(@@)(@@) $ 3710 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا أدى المكاتب النصف لم يسترق ) ( سفيان الثوري في الفرائض ، ق ) . )(@)(@@)(@@)(@@) $ 3711 عن عبد العزيز بن رفيع عن أبي بكر رضي الله عنه :(@)(@@) | 30 ( أن رجلا كاتب PageV14P335 غلاما له فنجمها نجوما فأتى بمكاتبته كلها فأبى أن يأخذها إلا نجوما فأتى المكاتب عمر رضي الله عنه ، فأرسل عمر إلاى مولاه ، فجاء فعرضت عليه ، فأبى أن يأخذها ، فقال عمر : فإني أطرحها في بيت المال ، وقال للمولاى : خذها نجوما ، وقال للمكاتب : اذهب حيث شئت ) ( ق ) . )(@)(@@)(@@)(@@) $ 3712 عن القاسم بن محمد :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كان يكره قطاعة المكاتب الذي يكون عليه الذهب والورق ثم يقاطعه علاى ثلاثة أو أربعة أو ما كان ويقول : اجعلوا ذالك في العرض علاى ما شئتم ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ 3713 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا أدى المكاتب الشطر فلا رق عليه ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ 3714 عن جابر عن عامر الشعبي عن زيد بن ثابت في المكاتب يموت وقد بقي عليه من مكاتبته قال :(@)(@@) | 30 ( هو عبد ما بقي عليه درهم ، وقال عبد الله : إذا أدى الثلث أو النصف فهو غريم ، وقال علي رضي الله عنه : يعتق بحساب ما أدى ويرثه ولده بحساب ذالك ، قال جابر : بلغني 
ms4719	 أن عمر بن الخطاب رضي الله عنه جمع عليا وعبد الله وزيدا رضي الله عنهم في المكاتب ، فقال زيد : نقيس لهم ، فقال : أرأيتم إن أصاب حدا وكيف يدخل علاى أمهات المؤمنين فجعل يقيس لهم بنحو هاذا ففضله عمر عليهما في المكاتب ) ( كر ) . )(@)(@@)(@@)(@@) $ 3715 عن قتادة :(@)(@@) | 30 ( أن عمر بن الخطاب وزيد بن ثابت رضي الله عنهم ، إذا مات المكاتب وله مال فهو لمواليه وليس لولده شيء ) ( ش ، ق ) . )(@)(@@)(@@)(@@) $ 3716 عن حكيم بن حزام قال :(@)(@@) | 30 ( كتب عمر بن الخطاب رضي الله عنه إلاى عمير بن سعد : أما بعد فانه من قبلك من المسلمين أن يكاتبوا أرقاءهم علاى مسألة الناس ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ 3717 عن عكرمة :(@)(@@) | 30 ( أن عمر رضي الله عنه كاتب عبدا له يكنى بأبي أمية ، فجاء بنجمه حين حل ، قال : اذهب به فاستعن به في مكاتبتك ، فقال : يا PageV14P336 أمير المؤمنين لو تركته حتى يكون آخر نجم ، قال : إني أخاف أن لا أدرك ذالك ثم قرأ : { وآتوهم من مال الله الذي آتاكم } ، قال عكرمة : كان أول نجم أدي في الإسلام ) ( عب ، وابن سعد وابن أبي حاتم ، ق ) . )(@)(@@)(@@)(@@) $ 3718 عن أنس بن سيرين عن أبيه قال :(@)(@@) | 30 ( كاتبني أنس بن مالك علاى عشرين ألف درهم ، فكنت فيمن فتح تستر فاشتريت رثة فربحت فيها ، فأتيت أنس بن مالك بكتابته فأبى أن يقبلها مني إلا نجوما ، فأتيت عمر بن الخطاب رضي الله عنه فذكرت ذالك له فقال : أنت هو وقد رآني ومعي أثواب فدعا لي بالبركة ؟ قلت : نعم ، فقال : أراد أنس الميراث ، وكتب إلاى أنس أن اقبلها فقبلها ) ( ابن سعد ، ق ) . )(@)(@@)(@@)(@@) $ 3719 عن أبي سعد المقبري قال :(@)(@@) | 30 ( كاتبتني مولاتي علاى أربعين ألف درهم فأديت إليها عامة ذالك ، ثم حملت ما بقي إليها فقلت : هاذا مالك فاقبضيه ، قالت : لا ، حتى آخذه منك شهرا بشهر وسنة بسنة ، فذكرت ذالك لعمر بن الخطاب رضي الله عنه ، فقال : ادفعه إلاى بيت المال ، ثم بعث إليها فقال : هاذا مالك في بيت المال وقد عتق أبو سعيد 
ms4720	 ، فإن شئت فخذي شهرا بشهر وسنة بسنة ، فأرسلت فأخذته ) ( ابن سعد ، ق وحسنه ) . )(@)(@@)(@@)(@@) $ 3720 عن قتادة قال :(@)(@@) | 30 ( سأل سيرين أبو محمد أنس بن مالك الكتابة ، فأبى أنس ، فرفع عليه عمر رضي الله عنه الدرة وتلا : { فكاتبوهم } فكاتبه أنس ) ( عب وابن سعد وعبد بن حميد وابن جرير ، ورواه ق موصولا عن قتادة عن أنس ) . )(@)(@@)(@@)(@@) $ 3721 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( في الأمة تعتق وزوجها مملوك ، إذا جامعها بعد أن تعلم أن لها الخيار فلا خيار لها ) ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 3722 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا أعتقت الأمة فلها الخيار ما لم يطأها زوجها ) ( عب ) . )(@)(@@)(@@)(@@) $ 3723 عن عمر رضي الله عنه قال(@)(@@) | 30 : ( لأن أحمل علاى نعلين في سبيل الله PageV14P337 أحب إلي من أن أعتق ولد الزنا ) ( عب ) . )(@)(@@)(@@)(@@) $ 3724 عن سليمان بن يسار :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كان يوصي بأولاد الزنا خيرا وكان يقول : أعتقوهم وأحسنوا إليهم ) ( عب ) . )(@)(@@)(@@)(@@) $ 3725 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( من كان عليه محررة من ولد إسماعيل فلا يعتقن من حمير أحدا ) ( عب ) . )(@)(@@)(@@)(@@) $ 3726 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( من ملك ذا رحم محرم عتق ) ( عب ، د ، ق ) . )(@)(@@)(@@)(@@) $ 3727 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لا يسترق ذو رحم ) ( ق ) . )(@)(@@)(@@)(@@) $ 3728 عن إبراهيم :(@)(@@) | 30 ( أن غلاما لآل الأسود شهد القادسية فإبلاى ، فأراد الأسود أن يعتقه ، فذكر ذالك لعمر بن الخطاب رضي الله عنه فقال : دعه حتى يشب عبد الرحمان مخافة الضمان ) ( البغوي في الجعديات ، كر ) . )(@)(@@)(@@)(@@) $ 3729 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( إذا أعتق العبد وله مال فالمال للعبد إلا أن يشترط ماله لمولاه الذي أعتقه ) ( ابن جرير ، هق ) . )(@)(@@)(@@)(@@) $ 3730 عن محمد بن زيد قال :(@)(@@) | 30 ( قضى عمر رضي الله عنه في أمة غزا مولاها وأمر رجلا ببيعها ، ثم بدا لمولاها فأعتقها ، وأشهد علاى ذالك ، وقد بيعت الجارية فحسبوا ، فإذا أعتقها قبل بيعها ، فقضى عمر أن يقضى بعتقها ويرد ثمنها ، ويؤخذ صداقها لما 