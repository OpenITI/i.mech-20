ms381	 را بستاید چه بود: پاک سخن %~% وانکه او را نستاید چه بود: یافه درای(@)(@@) 26 هر ستایش که جز او راست نکوهش به از آن %~% فرخی تا بتوانی جز از او را مستای(@)(@@) 27 تا چو بیجاده نباشد به نکو رنگی سنگ %~% تا چو یاقوت نباشد به بها کاهربای(@)(@@) 28 شادمان با دو تن آسان و به کام دل خویش %~% دشمنان را ز نهیبش دل وجان اندروای PageV1P242(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای دوست به صدگونه بگردی به زمانی %~% گه خوش سخنی گیری و گه تلخ زبانی(@)(@@) 2 چون ناز کنی ناز ترا نیست قیاسی %~% چون خشم کنی خشم ترا نیست کرانی(@)(@@) 3 مانند میان تو و همچون دهن تو %~% من تن کنم از موی و دل از غالیه دانی(@)(@@) 4 گویم ز دل خویش دهانت کنم ای ماه %~% گویی نتوان کردز یک نقطه دهانی(@)(@@) 5 گویم ز تن خویش میان سازمت ای دوست %~% گویی نتوان ساخت ز یک موی میانی(@)(@@) 6 جانیست مراجان پدر جز دل و جزتن %~% وین نیز بر من نکند صبر زمانی(@)(@@) 7 گر گویی بفرست نگویم نفرستم %~% با دوست بخیلی نتوان کرد به جانی(@)(@@) 8 جانی بدهم تا به زیانی ز تو برهم %~% من سود کنم گر ز تو برهم به زیانی(@)(@@) 9 جان بدهم و دل ندهم کاندر دل من هست %~% مدح ملکی مال دهی شکر ستانی(@)(@@) 10 شهزاده محمد ملک عالم عادل %~% کز شاکر او نیست تهی هیچ مکانی(@)(@@) 11 تا او به امارت بنشست از پی گنجش %~% هر روز به کوه از زر بفزاید کانی(@)(@@) 12 گیتی چو یکی کالبدست او چو روانست %~% چاره نبود کالبدی را ز روانی(@)(@@) 13 کافیتر ازو دهر نپرورده امیری %~% وافیتر ازو ملک ندیده ست جوانی(@)(@@) 14 او را ز پی فال پدر تخت فرستاد %~% تختی همه پر صورت و پر صنعت مانی(@)(@@) 15 با تخت فرستاد یکی پیل چو کوهی %~% پیلی که بر او شیفته گشته ست جهانی 
ms382	(@)(@@) 16 مر دولت را برتر ازین نیست دلیلی %~% مر شاهی را برتر ازین نیست نشانی(@)(@@) 17 آنچیز کزین پیش گمان بود یقین گشت %~% دانی نتوان داد یقینی به گمانی(@)(@@) 18 آن چیز کزین پیش خبر بود عیان گشت %~% دانی که نگیرد خبری جای عیانی(@)(@@) 19 آب و شرف و عز جهان روز بهان راست %~% نا روز بهان جمله نیرزند به نانی(@)(@@) 20 از بخشش او خالی کم یابم دستی %~% وزنعمت او خالی کم یابم خوانی(@)(@@) 21 بابخشش او بحر چه چیزست: سرابی %~% باهمت او چرخ چه چیزست: کیانی(@)(@@) 22 او را ز جفا دهر امان داد و نداده ست %~% مر هیچ شهی را ز جفا دهر امانی(@)(@@) 23 با او به وفا ملک ضمان کرد و نکرده ست %~% با هیچ ملک ملک بدینگونه ضمانی(@)(@@) 24 ای بار خدایی که کجا رای تو باشد %~% خورشید درخشنده نماید چو دخانی(@)(@@) 25 زیر سخن خوب تو صد نکته نهانست %~% زان هر نکتی راست دگرگونه بیانی(@)(@@) 26 فضل تو همی جوید هر فضل ستایی %~% مدح تو همی خواند هر مدحت خوانی(@)(@@) 27 هر چند نهان همه خلق ایزد داند %~% از خاطر تو نیست نهان هیچ نهانی(@)(@@) 28 پیکان تو مانند ستاره ست که نونو %~% هر روز کند بر دل خصم تو قرانی(@)(@@) 29 اندر دل هر شیر ز قربان تو تیریست %~% وندر برهر گرد ز رمح تو سنانی(@)(@@) 30 چون تیر و کمان خواستی اندر صف دشمن %~% انگشت کسی برد نیاردبه کمانی(@)(@@) 31 چون تیغ به کف گیری هر جای بجویی %~% ا ز کشته و از خسته نگونی و ستانی(@)(@@) 32 تا گیتی راست به هر فصلی طبعی %~% تا ایزد راست به هر روزی شانی(@)(@@) 33 شاه ملکان باش و خداوند جهان باش %~% بگشای جهان را ز کرانی به کرانی(@)(@@) 34 در خدمت تو هر چه به ترکستان ماهی %~% زیر علمت هر چه در آفاق میانی(@)(@@) 35 دایم دل تو شاد به دیدار نگاری 
ms383	 %~% شیرین سخنی نوش لبی لاله رخانی(@)(@@) 36 چشم من و آن روز که بینم لب دجله %~% از رنگ علمهای تو چون لاله ستانی PageV1P243(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به من باز گردای چوجان و جوانی %~% که تلخست بی تو مرا زندگانی(@)(@@) 2 من اندر فراق تو ناچیز کردم %~% جمال و جوانی دریغا جوانی(@)(@@) 3 دریغاتو کز پیش رویم جدایی %~% دریغا تو کز پیش چشمم نهانی(@)(@@) 4 سفر کردی و راه غربت گرفتی %~% به راه اندر ای بت همی دیر مانی(@)(@@) 5 چه گویی به تو راه جستن توانم %~% چه گویم به من باز گشتن توانی(@)(@@) 6 دل من ز مهر تو گشتن نخواهد %~% دلی دیده ای تو بدین مهربانی(@)(@@) 7 گرفتم که من دل ز تو بر گرفتم %~% دل من کندبی تو همداستانی(@)(@@) 8 من ازرشک قد تو دیدن نیارم %~% سهی سرو آزاده بوستانی(@)(@@) 9 ز بس کز فراق تو هر شب بگریم %~% بگرید همی با من انسی و جانی(@)(@@) 10 ترا گویم ای عاشق هجر دیده %~% که از دیده هرشب همی خون چکانی(@)(@@) 11 چه مویی چه گریی چه نالی چه زاری %~% که از ناله کردن چو نالی نوانی(@)(@@) 12 چرابر دل خسته از بهر راحت %~% ثناهای قطب المعالی نخوانی(@)(@@) 13 ابو احمد آن اصل حمد و محامد %~% محمد کش از خسروان نیست ثانی(@)(@@) 14 همه نهمت و کام او خوب کاری %~% هم رسم و آیین او خسروانی(@)(@@) 15 جهان راهمه فتنه خویش کرده %~% به نیک و خصالی و شیرین زبانی(@)(@@) 16 به آزادگی از همه شهریاران %~% پدیدست همچون یقین از گمانی(@)(@@) 17 زهی برخرد یافته کامگاری %~% زهی برهنر یافته کامرانی(@)(@@) 18 اگر چند از نامورتر تباری %~% وگر چند کز بهترین خاندانی(@)(@@) 19 بزرگی همی جز به دانش نجویی %~% ملکزادگان کنون را نمانی(@)(@@) 20 ز فضل و هنر چیست کان تونداری %~% ز علم و ادب چیست کان توندانی(@)(@@) 21 به علم و ادب پادشاه زمینی %~% به اصل و گهر پادشاه زمانی 
