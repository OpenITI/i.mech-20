ms5661	 ، فأغرنا عليهم وكانوا كثيرا ، فلجأنا إلاى جهينة وشعبها ، فقالوا : لم تقاتلون في الشهر الحرام ؟ فقلنا : إنما نقاتل من أخرجنا من البلد الحرام في الشهر الحرام ، فقال بعضنا لبعض : ما ترون ؟ قالوا : نأتي رسول الله فنخبره ، وقال قوم : لا بل نقيم هاهنا ، وقلت أنا في أناس معي : لا بل نأتي عير قريش هاذه فنصيبها ، فانطلقنا إلاى العير وانطلق أصحابنا إلاى النبي فأحبروه الخبر ، فقام غضبان محمرا لونه ووجهه فقال : ذهبتم من عندي جميعا وجئتم متفرقين ، إنما أهلك من كان قبلكم الفرقة ، ولأبعثن عليكم رجلا ليس بخيركم ، أصبركم علاى الجوع والعطش ، فبعث علينا عبد الله بن جحش الأسدي ، فكان PageV16P492 أول أمير في الإسلام ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8838 عند سعد رضي الله عنه أنبأنا محمد بن عمر وغيره قالوا :(@)(@@) | 30 ( قال علي رضي الله عنه حين قتل عمار : إن امرأ من المسلمين لم يعظم عليه قتل ابن ياسر ، وتدخل عليه المصيبة الموجبة لغير رشيد ، رحم الله عمارا يوم أسلم ، ورحم الله عمارا يوم قتل ، ورحم الله عمارا يوم يبعث حيا لقد رأيت عمارا وما يذكر من أصحاب رسول الله أربعة إلا كان رابعا ، ولا خمسة إلا خامسا ، وما كان أحد من قدماء أصحاب رسول الله يشك أن عمارا رضي الله عنه قد وجبت له الجنة في غير موطن ولا اثنين ، فهنيئا لعمار بالجنة ، ولقد قيل : إن عمارا مع الحق ، والحق معه يدور ، عمار مع الحق أينما دار ، وقاتل عمار في النار ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8839 عن محمد بن سعد بن أبي وقاص عن أبيه رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( الحق مع عمار ما لم يغلب عليه ولهة الكبر ( 1 ) . ( سيف ، كر ) . )(@)(@@)(@@)(@@) $ 8840 عن سعد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله أقبل ذات يوم من العالية ، حتى إذا مر بمسجد بني معاوية ، دخل فركع فيه ركعتين وصلينا معه ودعا ربه طويلا ثم انصرف إلينا ، فقال : ( سألت ربي أن لا يهلك أمتي بالغرق فأعطانيها ، وسألته أن لا يهلك أمتي بالسنة فأعطانيها ، وسألته أن لا يجعل 
ms5662	 بأسهم بينهم فمنعنيها ) . ( ش ، حم ، م ، وابن خزيمة ، حب ) . )(@)(@@)(@@)(@@) $ 8841 عن شريح بن عبيد ، عن سعد بن أبي وقاص رضي الله عنه عن النبي أنه قال :(@)(@@) | 30 ( إني لأرجو أن لا تعجز أمتي عند ربها عز وجل أن يؤخرهم نصف يوم ) ، قيل لسعد : وكم نصف يوم ؟ قال : خمسمائة سنة . ( حم ، د ، PageV16P493 ونعيم بن حمار ، ك ، ق في البعث ، ص . قال ق : إسناده شامي ، تفردوا بهذا الحديث ) . )(@)(@@)(@@)(@@) $ 8842 عن سعد رضي الله عنه :(@)(@@) | 30 ( أن رجلا قتل ، فقيل للنبي فقال : ( أبعده الله ، إنه كان يبغض قريشا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8843 عن سعد بن أبي وقاص رضي الله عنه :(@)(@@) | 30 ( أنه وجد إنسانا يعضد ويخبط عضاها بالعقيق ، فأخذ فأسه ونطعه وما سواى ذالك فانطلق العبد إلاى ساداته فأخبرهم الخبر ، فانطلقوا إلاى سعد فقالوا : الغلام غلامنا ، فاردد إليه ما أخذت منه ، فقال : سمعت رسول الله يقول : ( من وجدتموه يعضد أو يخبط عضاه المدينة بريدا في بريد فلكم سلبه فلم أكن أرد شيئا أعطانيه رسول الله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8844 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : أحرم بين لابتي المدينة كما حرم إبراهيم مكة ، لا يقطع عضاهها ، والمدينة خير لهم لو كانوا يعلمون ، ولا يريدهم أحد بسوء إلا أذابه الله ذوب الرصاص في النار ، أو ذوب الملح في الماء ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8845 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله بالمعرس فقال : لقد أوتيت فقيل لهي : إنك لبالوادي المبارك يعني العقيق ) . ( خ في تاريخه ) . )(@)(@@)(@@)(@@) $ 8846 عن سعد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله نام بالعقيق ، قال : فاستيقظت وإنه ليقال لي : إنك لبالوادي المبارك ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 8847 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( كنت أمشي مع رسول الله فوجد مقرومة فيها تمرتان ، فأخذ تمرة وأعطاني تمرة ) . ( بقي ) . )(@)(@@) PageV16P494(@)(@@)(@@)(@@) $ 8848 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : لو أن أحدا نجا من عذاب القبر لنجا سعد ، ثم قال بأصابعه الثلاث ، فجمعها كأنه يقلبها ، ثم قال : لقد صيقت ثم 
ms5663	 عوفي ) . ( ق في كتاب عذاب القبر ) . )(@)(@@)(@@)(@@) $ 8849 عن أبي سعيد رضي الله عنه(@)(@@) | 30 عن النبي أنه قال : ( لقد اهتز العرش لموت سعد ) . جابر رضي الله عنه ش ) . )(@)(@@)(@@)(@@) $ ( 8850 ) عن عائشة ابنة سعد عن سعد رضي الله عنه قال : ' كان رسول الله & يشرب قائما ' . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 8851 عن ابن عباس رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله كان في مجلس ، فقال رجل : يا سعد وقال آخر : يا سعد وقا آخر : يا سعد فقال رسول الله : ( ما جمع ثلاثة سعود في حديث إلا سعد أهله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8852 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( لقد رد رسول الله علاى عثمان بن مظعون التبتل ، ولو أحله له لاختصينا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8853 عن سعد بن أبي وقاص رضي الله عنه قال :(@)(@@) | 30 ( سألني أبو بكر وعمر رضي الله عنهما عن قول رسول الله فهي الوصية فخبرتها ، فحملا الناس عليه في الوصية ) . ( أبو الشيخ في الفرائض ، ض ) . )(@)(@@)(@@)(@@) $ 8854 عن سعد رضي الله عنه :(@)(@@) | 30 ( أنه جاء إلاى النبي فقال : من أنا يا رسول الله ؟ قال : ( أنت سعد بن مالك بن أهيب بن عبد مناف بن زهرة ، فمن قال غير ذالك فعليه لعنة الله ) . ( طب ، والبغوي ، والباوردي والشيرازي في الألقاب ، وأبو نعيم في المعرفة والديلمي ، كر ورجاله ثقات ) . )(@)(@@)(@@)(@@) $ 8855 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( اتبعت النبي وما في وجهي PageV16P495 شعرة ) . ( أبو نعيم كر ) . )(@)(@@)(@@)(@@) $ 8856 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( أنا أول من رماى بسهم في سبيل الله ، ولقد رأيتني وفي لفظ : ولقد كنا نغزوا مع رسول الله سابع سبعة مالنا طعام إلا الجلة وورق السمو حتى لقد قرحت أشداقنا ) . ( حم ، ع ، وابن جرير وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8857 عن سعيد بن المسيب قال :(@)(@@) | 30 ( سمعت سعدا رضي الله عنه يقول : ما أسلم أحد في اليوم الذي أسلمت فيه ، ولقد مكثت سبعة أيام وإني لثلث الإسلام ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 8858 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( جمع لي رسول الله أبويه يوم أحد قال 
ms5664	 : ( فداك أبي وأمي ) . ( ش ، حم ، خ ، ع ، والشاسي وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8859 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( قال لي رسول الله : ( اللهم سدد رميته وأجب دعوته ) . ( ابن مندة ، ك ، وأبو نعيم ض ) . )(@)(@@)(@@)(@@) $ 8860 عن ابن سيرين قال :(@)(@@) | 30 ( قيل لسعد بن أبي وقاص ألا تقاتل فإنك من أهل الشوراى وأنت أحق بهاذا الأمر من غيرك ؟ فقال : لا أقاتل حتى تأتوني بسيف له عينان ، ولسان وشفتان ، يعرف المؤمن من الكافر ، فقد هاجرت وأنا أعرف الجهاد ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8861 عن الزهري :(@)(@@) | 30 ( أن سعد بن أبي وقاص رضي الله عنه لما حضره الموت دعا بخلق جيد له من صوف فقال : كفنوني فيها فإني كنت لقيت فيها المشركين يوم بدر وهي علي ، وإنما كنت أخبأها لهاذا اليوم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8862 عن عامر بن سعد عن أبيه رضي الله عنه قال :(@)(@@) | 30 ( جاءني رسول الله PageV16P496 يعودني عام حجة الوداع وبي وجع قد اشتد بي ، فقلت : يا رسول الله قد بلغ مني الوجع ما تراى وأنا ذو مال ولا يرثني إلا ابنة لي ، أفأتصدق بثلثي مالي ؟ قال : ( لا ) ، قلت : فالشطر ؟ قال : ( لا ) ، قلت : فالثلث ؟ قال : ( الثلث ، والثلث كثير ، إنك إن تدع ورثتك أغنياء خير من أن تدعهم عالة يتكففون الناس ، وإنك لن تنفق نفقة تبتغي بها وجه الله إلا أجرت فيها ، حتى ما تجعل في في امرأتك ) ، قلت : يا رسول الله أخلف بعد أصحابي ؟ فقال : ( إنك لن تخلف فتعمل عملا صالحا إلا ازددت به درجة ورفعة ، ولعلك أن تخلف حتى ينتفع بك أقوام ويضر بك آخرون ) ، اللهم امض لأصحابي هجرتهم ولا تردهم علاى أعقابهم ، لاكن البائس سعد بن خولة بداى له رسول الله أن مات بمكة ) . ( مالك ، ط ، عب ، ض ، ش ، حم ، ح ، م ، د ، ت ، ن ، ه ، وابن خزيمة ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8863 عن أبي عبد الرحمان السلمي قال :(@)(@@) | 30 ( قال لي سعد بن أبي وقاص رضي الله عنه : إن رسول الله دخل عليه في مرضه يعوده ، فقال له : ( أوص ) ، قال له : قد أوصيت بمالي 
ms5665	 كله في سبيل الله وفي الرقاب والمساكين ، قال : ( فما تركت لولدك ) ؟ قال : هم أغنياء بخير ، قال : ( أوص بعشر مالك ) ، فلم يزل يناقصني وأناقصه حتى قال : ( أوص بالثلث والثلث كثير ) ، فجرت السنة فأخذتها الناس إلاى اليوم ، قال عبد الرحمان : فنحن ننقص من الثلث لقول رسول الله : ( الثلث ، والثلث كثير ) . ( ص ) ( وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8864 عن سعد رضي الله عنه قال : سئل النبي عن الرطب بالتمر ، فقال لمن حوله :(@)(@@) | 30 ( أينقص الرطب إذا جف ) ؟ قلنا : نعم ، فنهاى عنه . ( مالك ش ، د ، ت ، وقال : حسن صحيح ن ، ه ) . )(@)(@@)(@@)(@@) $ 8865 عن عمر بن سعد عن سعد رضي الله عنه : $ 30 ( أن النبي جاءه يعوده وهو يكره أن يموت بالأرض التي هاجر منها ، قال : يا رسول الله أوصي بما لي PageV16P497 كله ؟ قال : ( لا ) ، قال : فالشطر : قال : ( لا ) ، قال : فالثلث ، قال : ( والثلث كثير ، إنك إن تدع ورثتك أغنياء بخير ، خير لك من أن تدعهم عالة يتكففون الناس ما في أيديهم ، مهما أنفقت من نفقة فإنها صدقة ، حتى اللقمة ترفعها إلاى في امرأتك ) . ( عب ) .(@)(@@)(@@)(@@) $ 8866 عن سعد رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن كراء الأرض البيضاء ؟ فقال : لا بأس به ، ولك قرض الأرض ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8867 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( لقد أسلمت وما فرض الله الصلوات ) . ( ابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ 8868 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( رأيت في المنام قبل أن أسلم بثلاث كأني في ظلمة لا أبصر شيئا ، إذ أضاء لي قمر فاتبعته ، فكأني أنظر إلاى من سبقني إلاى ذالك القمر ، فأنظر إلاى زيد بن حارثة ، وإلاى علي بن أبي طالب ، وإلاى أبي بكر رضي الله عنهم ، وكأني أسألهم : متى انتهيتم إلاى هاهنا ؟ قالوا : الساعة ، وبلغني أن رسول الله يدعو إلاى الإسلام مستخفيا ، فلقيته في شعب أجياد وقد صلى العصر ، فقلت : إلاى ما تدعو ؟ قال : تشهد أن لا إلاه إلا الله وأني رسول الله ، قلت : أشهد أن لا إلاه إلا الله وأنك محمد رسول الله ، فما تقدمني أحد إلا هم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8869 عن 
ms5666	 سعد رضي الله عنه قال :(@)(@@) | 30 ( إني لأول رجل رماى بسهم في المشركين ، وما جمع رسول الله أبويه لأحد قبلي ، ولقد سمعته يقول : ( إرم يا سعد فداك أبي وأمي ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 8870 عن مصعب بن سعد رضي الله عنه قال :(@)(@@) | 30 ( كان رأس أبي في حجري وهو يقضي ، فدمعت عيناي ، فنظر إلي فقال : ما يبكيك أي بني ؟ فقلت : لمكانك وما أراى بك ، قال : فلا تبك علي ، فإن الله لا يعذبني أبدا وأنا من أهل الجنة ، إن PageV16P498 الله يدين المؤمنين بحسناتهم ما عملوا لله ، وأما الكفار فيخفف عنهم بحسناتهم ، فإذا نفذت ليطلب كل عامل ثواب عمله ممن عمل له ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8871 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( رأيت رجلين يوم بدر يقاتلان عن النبي ، أحدهما عن يمينه ، والآخر عن يساره ، وإني لأراه ينظر إلاى ذا مرة ، وإلاى ذا مرة سرورا بما ظفره الله عز وجل ) . ( الواقدي كر ) . )(@)(@@)(@@)(@@) $ 8872 عن عائشة بنت سعد رضي الله عنها عن أبيها :(@)(@@) | 30 ( أن رسول الله جلس في المسجد ثلاث ليال فقال : ( اللهم أدخل من هاذا الباب عبدا تحبه ويحبك ) ، فدخل سعد منه ثلاث ليال ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8873 عن سعد رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( اللهم استجب لسعد إذا دعاك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8874 عن الشعبي قال :(@)(@@) | 30 ( قيل لسعد بن أبي وقاص رضي الله عنه متاى أصبت الدعوة ؟ قال : يوم بدر ، كنت أرمي بين يدي النبي فأضع السهم في كبد القوس ثم أقول : اللهم زلزل أقدامهم ، وارعب قلوبهم ، وافعل بهم وافعل ، فيقول النبي : ( اللهم استجب لسعد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8875 عن الحسن :(@)(@@) | 30 ( أن رجلا قال لسعد رضي الله عنه : أخبرني عن عثمان رضي الله عنه ، قال : كنا إذ نحن جميع مع رسول الله ، كان أحسننا وضوءا ، وأطولنا صلاة ، وأعظمنا نفقة في سبيل الله ، فسأله عن شيء من أمر الناس ، فقال : سمعت رسول الله يقول : ( إن استطعت أن تكون أنت المقتول ولا تقتل أحدا من أهل الصلاة فافعل ثلاثا . ( كر ، وسنده حسن ) . )(@)(@@)(@@)(@@) $ 8876 عن سعد رضي الله 
ms5667	 عنه :(@)(@@) | 30 ( أنه كان جالسا وعنده نفر إذ ذكروا عليا رضي الله عنه فنالوا منه ، فقال : مهلا عن أصحاب رسول الله ، فإنا أذنبنا مع PageV16P499 رسول الله ذنبا ، فأنزل الله : { لولا كتاب من الله سبق } الآية ، فكنا نراى أنها رحمة من الله سبقت لنا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8877 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يسلم في الصلاة تسليمتين ، تسليمة عن يمينه : السلام عليكم ورحمة الله ، وتسليمة عن يساره : السلام عليكم ورحمة الله ، حتى يراى بياض خده من هاهنا ومن هاهنا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8878 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( كنا مع النبي في نقيع الخيل ، فأقبل العباس رضي الله عنه فقال رسول الله : ( هاذا العباس بن عبد المطلب : أجود قريش كفا ، وأوصلها لها ) وفي لفظ : للرحم ) . ( حم ، ع ، والشاشي ، حب ، كر ، ض ) . )(@)(@@)(@@)(@@) $ 8879 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( هاذا العباس عم رسول الله : أجود الناس كفا ، وأحناه عليهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8880 عن عامر بن سعد بن أبي وقاص رضي الله عنه قال :(@)(@@) | 30 ( سمعت سعدا وناسا من أصحاب رسول الله يقولون : كان رجلان أخوان علاى عهد رسول الله ، وكان أحدهما أفضل من الآخر ، فتوفي الذي هو أفضلهما ، ثم عمر الآخر بعده أربعين ليلة ثم توفي ، فذكر لرسول الله فضيلة الأول علاى الآخر ، فقال : أو لم يكن يصلي ؟ قالوا : بلاى يا رسول الله ، وكان لا بأس به ، فقال رسول الله : ( ما يدريكم ما بلغت به صلاته ، ثم قال علاى أثر ذالك : إنما مثل الصلوات الخمس كمثل نهر بباب رجل ، غمر عذب ، يستحم فيه كل يوم خمس مرات ، فما ترون ذالك ينفي من درنه ، إنكم لا تدرون ما بلغت به الصلاة ) . ( ابن زنجويه ) . )(@)(@@)(@@)(@@) $ 8881 عن الواقدي ، حدثني أبو بكر بن إسماعيل بن محمد عن أبيه عن PageV16P500 عامر بن سعد عن أبيه رضي الله عنه قال :(@)(@@) | 30 ( رميت يوم بدر سهيل بن عمرو فقطعت علياه ، فاتبعت أثر الدم حتى وجدته قد أخذه مالك بن الدخشم ، وهو آخذ بناصيته ، فقلت 
ms5668	 : أسيري رميته ، فقال مالك : أسيري أخذته ، فأتينا رسول الله فأخذه مسهما جميعا ، فأفلت بالروحاء من مالك بن الدخشم فصاح في الناس ، فخرج في طلبه ، فقال النبي : من وجده فليقتله ، فوجده النبي نفسه فلم يقتله ، قال الواقدي : لما أسر سهيل بن عمرو قال عمر رضي الله عنه : يا رسول الله إنزع ثنيته يدلع لسانه فلا يقوم عليك خطيبا أبدا ، فقال رسول الله : لا أمثل فيمثل الله بي وإن كنت نبيا ، ولعله يقوم مقاما لا يكرهه ، فقام سهيل بن عمرو حين بلغه وفاة النبي بخطبة أبي بكر رضي الله عنه كأنه كان يسمعها ، فقال عمر حين بلغه كلام سهيل بن عمرو : لما كان بشنوكة كان مع مالك بن الدخشم فقال : خل سبيلي للغائط ، فقام به ، فقال سهيل : إني أحتشم فاستأخر عني ، فاستأخر عنه ، ومضاى سهيل علاى وجهه ، فلما أبطأ سهيل علاى مالك أقبل فصاح في الناس ، فخرجوا في طلبه ، وخرج النبي في طلبه ، فقال من وجده فليقتله ، فوجده ، رسول الله نفسه بين سمرات ، فأمر به فربطت يداه إلاى عنقه ، ثم قرنه إلاى راحلته ، فلم يركب خطوة حتى قدم المدينة ، فلقي أسامة بن زيد ، فحدثني إسحاق بن حازم عن عبيد الله ، بن مقسم عن جابر بن عبد الله قال : لقي رسول الله أسامة بن زيد ، ورسول الله علاى راحلته القصواى ، فأجلسه رسول الله بين يديه ، وسهيل مجنوب يداه إلاى عنقه ، فلما نظر أسامة إلاى سهيل قال : يا رسول الله أبو يزيد ، قال : ( نعم هاذا الذي كان يطعم الخبز بمكة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8882 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( سئل رسول الله عن المسح علاى الخفين ؟ فقال : ( لا بأس به ) . ( ابن خزيمة ) . ( كر ) . )(@)(@@) PageV16P501(@)(@@)(@@)(@@) $ 8883 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( سمعت النبي نهاى عن صلاتين : صلاة بعد اعصر حتى تغرب الشمس ، وصلاة بعد الفجر حتى تطلع الشمس ) . ( بقي بن مخلد في مسنده ) . )(@)(@@)(@@)(@@) $ 8884 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( قلت للنبي : أيكره للرجل أن يموت بالأرض التي هاجر منها ؟ قال : ( نعم ) . ( بقي 
ms5669	 ) . )(@)(@@)(@@)(@@) $ 8885 عن إسماعيل بن محمد بن سعد بن أبي وقاص عن أبيه قال :(@)(@@) | 30 ( مرض سعد بن أبي وقاص رضي الله عنه وهو مع النبي في حجة الوداع ، فعاده رسول الله فقال : يا رسول الله إني لا أراى إلا أماني ، فقال رسول الله : ( إني لأرجو أن يبقيك الله حتى يضر بك قوم ، وينتفع بك آخرون ) ، ثم قال للحارث بن كليدة الثقفي وهو معه ، تماسح سعدا مما به ، فقال : والله يا رسول الله إني لأرجو أن يكون شفاؤه فيما معه في رحله ، هل معكم من هاذه الثمرة العجوة شيء ؟ قالوا : نعم ، فصنع له الهرتة ، خلط له فيها التمر بالحلبة اليمانية ثم أوسعها سمنا ، ثم أعطاها إياه ، فكأنما نشط من عقال ) . ( بقي وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8886 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( حلفت باللات والعزى ، فقال أصحابي : ما نراك إلا قد قلت هجرا ، فأتيت النبي فقلت : إن العهد كان قريبا ، فحلفت باللات والعزى ، فقال : قل : ( لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو علاى كل شيء قدير ثلاث مرات وانفث عن شمالك ثلاثا وتعوذ بالله من الشيطان الرجيم ، ولا تعد ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8887 عن عبد الله بن الحارث بن نوفل قال :(@)(@@) | 30 ( شهدت سعدا يقول لابنه : ما كنت أظن مسلما يدع الغسل يوم الجمعة ) . ( ابن جرير ) . )(@)(@@) PageV16P502(@)(@@)(@@)(@@) $ 8888 عن عامر بن سعد قال :(@)(@@) | 30 ( قال سعد رضي الله عنه : الحد والحدا ، وانصبوا علاى اللبن نصبا كما فعل برسول الله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8889 عن عامر بن سعد :(@)(@@) | 30 ( أن سعدا رضي الله عنه كان إذا خرج إلاى ضيعته مر بقبور الشهداء فيقول لأصحابه : ألا تسلموا علاى الشهداء فيردوا عليكم ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8890 عن الحارث بن مالك قال :(@)(@@) | 30 ( خرجت إلاى مكة فلقيت سعد بن مالك رضي الله عنه فقلت له : هل سمعت لعلي منقبة ؟ قال : قد شهدت له أربعا ، لأن يكون لي إحداهن أحب إلي من الدنيا أعمر فيها ما عمر نوح : أن رسول الله بعث أبا بكر ببراءة 
ms5670	 إلاى مشركي قريش ، فسار بها يوما وليلة ثم قال لعلي : إلحق أبا بكر فخذها منه فبلغها ورد علي أبا بكر ، فرجع أبو بكر فقال : يا رسول الله هل نزل في شيء ؟ قال : ( لا إلا خيرا ، إلا أنه ليس يبلغ عني إلا أنا أو رجل مني ، أو قال من أهل بيتي ) ، قال : وكنا مع رسول الله في المسجد فنودي فينا ليلا يخرج من في المسجد إلا آل رسول الله وآل علي فخرجنا بحر فلاعنا ، فلما أصبحنا أتاى العباس رسول الله فقال : أخرجت أعمامك وأصحابك وأسكنت هاذا الغلام ، قال : ( ما أنا أمرت بإخراجكم ، ولا إسكان هاذا الغلام ، إن الله هو الآمر به ) ، قال : والثالثة : أن رسول الله بعث عمر وسعدا إلاى خيبر ، فخرج سعد ورجع عمر رضي الله عنه فقال رسول الله : ( لأعطين الراية رجلا يحب الله ورسوله ، ويحبه الله ورسوله في ثناء كثير أخشاى أن أخطيء في بعضه ) ، والرابعة يوم غدير خم قام رسول الله ثم قال : ( أيها الناس ألست أولاى بالمؤمنين من أنفسهم ثلاث مرات ) ؟ قالوا : بلاى ، قال : ( ادن يا علي ) ، فرفع يده ورفع رسول الله يديه حتى نظرت إلاى بياض آباطهما ، فقال رسول الله : ( من كنت مولاه فعلي مولاه ) ثلاث مرات قال : الخامسة من مناقبه : أن رسول الله غدا علاى ناقته PageV16P503 الحمراء ، وخلف عليا ، فنفست بذالك قريش عليه وقالوا : إن رسول الله استثقله وكره صحبته ، فبلغ ذالك عليا ، فجاء حتى أخذ بغرز الناقة ، قال : يا رسول الله لأتبعنك ، أو قال : إني لتابعك زعمت قريش أنك إنما خلفتني أنك استثقلتني وكرهت صحبتي وبكاى علي رضي الله عنه فناداى رسول الله في الناس فاجتمعوا عليه ، فقال : ( أيها الناس ما منكم أحد إلا وله خامه ، أما يرضاى ابن أبي طالب أنك مني بمنزلة هاارون من موساى إلا أنه لا نبي بعدي ) ، فقال علي : رضيت عن الله وعن رسوله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8891 عن سعد رضي الله عنه قال :(@)(@@) | 30 ( لو نلت الأذان ما باليت أن لا أجاهد ) . ( ص ) . )(@)(@@)(@@)(@@) $ 8892 عن أبي عثمان قال 
ms5671	 :(@)(@@) | 30 ( خرجنا مع سعد بن مالك رضي الله عنه مغدين للحج ، وكان يجمع الظهر والعصر والمغرب والعشاء حتى قدمنا مكة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8893 عن مصعب بن سعد عن أبيه رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( ما من نفس إلا قد كتب مدخلها ومخرجها ، وما هي لاقية ) ، فقال رجل من الأنصار : ففيم العمل يا رسول الله ؟ فقال : ( اعملوا ، فكل عامل ميسر بما خلق له ، من كان من أهل الجنة يسر لعمل أهل الجنة ، ومن كان من أهل النار يسر لعمل أهل النار ) ، فقال الأنصاري : الآن حق العمل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8894 عن إسماعيل بن محمد بن سعد عن أبيه عن جده قال :(@)(@@) | 30 ( قال لي رسول الله : ( يا سعد ) قلت : لبيك يا رسول الله قال : ( قم فصح في الناس : إن هاذه أيام أكل وشرب لا يصام فيها ، أيام التشريق ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8895 عن قيس بن أبي حازم قال :(@)(@@) | 30 ( رجل لسعد رضي الله عنه : إنه مس ذكره وهو في الصلاة ، قال : إنما هو بضعة منك ) . ( ص ) . )(@)(@@) PageV16P504(@)(@@)(@@)(@@) |||| ( مسند سعيد بن زيد رضي الله عنه )(@)(@@)(@@)(@@) $ 8896 عن أبي عثمان قال :(@)(@@) | 30 ( سافرت مع سعيد بن زيد بن عمرو بن نفيل وأسامة بن زيد بن حارثة رضي الله عنها فكانا يجمعان بين الاولاى والعصر ، والمغرب والعشاء الآخرة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8897 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( قنت رسول الله فقال : ( اللهم العن رعلا وذكوان وعصية عصت الله ورسوله ، والعن أبا الأعور السلمي ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8898 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : ( إن كذبا علي ليس ككذب علاى أحد ، من كذب علي متعمدا فليتبوأ مقعده من النار ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8899 عن عروة قال :(@)(@@) | 30 ( قدم سعيد بن زيد بن عمرو بن نفيل رضي الله عنه من الشام بعد ما رجع رسول الله من بدر فكلم رسول الله فضرب له بسهمه قال : وأجري بذالك يا رسول الله ؟ قال : ( وأجرك ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 8900 عن عروة 
ms5672	 قال :(@)(@@) | 30 ( قدم سعيد بن زيد بن عمرو بن نفيل من الشام بعدما رجع رسول الله من بدر فكلم رسول الله فضرب له بسهمه ، قال : وأجري يا رسول الله ؟ قال : ( وأجرك ) . ( ابن عائذ ، كر ، الزهري مثله ، كر ، عن موساى بن PageV17P005 عقبة مثله كر ، وعن ابن إسحاق مثله ) . )(@)(@@)(@@)(@@) $ 8901 عن الزهري قال :(@)(@@) | 30 ( قدم سعيد بن زيد من الشام بعد مقدم النبي من بدر ، فكلم النبي في سهمه ، قال : لك سهمك ، قال : وأجري يا رسول الله ؟ قال : ( وأجرك ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8902 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( كنا عند النبي فذكر فتنة فعظم أمرها ، قال : فقلنا ، أو قالوا : يا رسول الله لئن أدركنا هاذا لنهلكن ؟ قال : ( كلا إن بحسبكم القتل ) . قال سعيد : فرأيت إخواني قتلوا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8903 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( احتضن رسول الله حسنا ثم قال : ( اللهم إني قد أحببته فأحبه ) . ( طب ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8904 عن ابن عباس رضي الله عنها قال :(@)(@@) | 30 ( كان رسول الله علاى حراء فتزلزل الجبل ، فقال رسول الله : أثبت حراء فما عليك إلا نبي أو صديق أو شهيد وعليه : رسول الله وأبو بكر وعمر وعثمان وعلي وطلحة والزبير وعبد الرحمان بن عوف ، وسعد بن أبي وقاص ، وسعيد بن زيد بن عمرو بن نفيل ) . ( ع والبغوي وابن شاهين في الأفراد ، طب ، كر ) . )(@)(@@)(@@)(@@) $ 8905 عن رباح بن الحارث قال :(@)(@@) | 30 ( كنا في المسجد الأكبر بالكوفة ، والمغيرة بن شعبة جالس علاى السرير ، فقال سعيد بن زيد رضي الله عنه : سمعت رسول الله يقول : ( أبو بكر في الجنة ، وعمر في الجنة ، وعثمان في الجنة ، وعلي في الجنة ، وطلحة في الجنة ، والزبير في الجنة ، وعبد الرحمان بن عوف في الجنة ، وسعد في الجنة ) ، وتاسع المؤمنين لو شئت أن أسميه لسميته ، فقال الناس : نشدناك الله من تاسع المؤمنين ؟ فقال : أما إذ نشدتموني ، فأنا تاسع المؤمنين ، ورسول الله العاشر ، ثم قال : لموقف أحدهم مع رسول الله يغبر فيه وجهه PageV17P006 أفضل من عمر أحدكم ولو 
ms5673	 عمر عمر نوح ) . ( حم ، وأبو نعيم في المعرفة ، كر ) . )(@)(@@)(@@)(@@) $ 8906 عن سعيد بن زيد بن عمرو بن نفيل رضي الله عنه قال :(@)(@@) | 30 ( أشهد علاى التسعة أنهم في الجنة ، ولو شهدت علاى العاشر لم آثم ، قيل له : وكيف ذاك ؟ قال : كنا مع رسول الله بحراء ، فتحرك فضربه برجله وفي لفظ : بكفه ثم قال : ( اثبت حراء فإنه ليس عليك إلا نبي أو صديق أو شهيد ، قيل : ومن هم ؟ قال : رسول الله ، وأبو بكر ، وعمر ، وعثمان وعلي ، وطلحة ، والزبير ، وسعد ، وعبد الرحمان بن عوف ) قيل : فمن العاشر ؟ قال : أنا ) . ( ت وقال : حسن صحيح ، وأبو نعيم وابن النجار ) . )(@)(@@)(@@)(@@) $ 8907 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( أشهد أني سمعت أبا بكر الصديق يقول لرسول الله : ليتني رأيت رجلا من أهل الجنة قال : ( فأنا من أهل الجنة ) ، قال : ليس عنك أسأل قد عرفت أنك من أهل الجنة ، قال : ( فأنا من أهل الجنة ، وأنت من أهل الجنة ، وعمر من أهل الجنة ، وعثمان من أهل الجنة ، وعلي من أهل الجنة ، وطلحة من أهل الجنة ، والزبير من أهل الجنة ، وعبد الرحمان بن عوف من أهل الجنة ، وسعد من أهل الجنة ، ولو شئت أن أسمي العاشر لسميته ) قيل : عزمت عليك لسميته قال : أنا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8908 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله علاى حراء فذكر عشرة في الجنة : أبو بكر ، وعمر ، وعثمان وعلي ، وطلحة ، والزبير ، وعبد الرحمان بن عوف ، وسعد بن مالك ، وسعيد بن زيد ، وعبد الله بن مسعود ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8909 عن نفيل بن هشام بن سعيد بن زيد بن عمرو بن نفيل عن أبيه عن جده : $ 30 ( أن زيد بن عمرو بن نفيل وورقة بن نوفل خرجا يلتمسان الدين حتى انتهيا PageV17P007 إلاى راهب بالموصل ، فقال لزيد بن عمرو : من أين أقبلت يا صاحب البعير ؟ قال : من بنية إبراهيم ، قال : وما تلتمس ؟ قال : ألتمس الدين ، قال : ارجع فإنه يوشك أن يظهر الذي تطلب في أرضك ، فأما ورقة فتنصر ، وأما أنا 
ms5674	 فعرضت علي النصرانية فلم توافقني ، فرجع وهو يقول :(@)(@@) لبيك حقا حقاتعبدا %~%(@)(@@) ورقا(@)(@@) البر أبغي لا الحال %~%(@)(@@) وهل مهاجر كما قال(@)(@@) عذت بما عاذبه إبراهيم(@)(@@) قال : وجاء ابنه إلاى النبي فقال : يا رسول الله إن أبي كان كما رأيت وكما بلغك فاستغفر له ، قال : ( نعم ) ، قال : ( فإنه يبعث يوم القيامة أمة وحده ، قال : وأتاى زيد بن عمرو بن نفيل علاى رسول الله ومعه زيد بن حارثة وهما يأكلان من سفرة لهما ، فدعواه لطعامهما ، فقال زيد بن حارثة للنبي : يا ابن أخي إنا لا نأكل مما ذبح علاى النصب ) . ( ط ، وأبو نعيم ، كر ) . ) $(@)(@@)(@@)(@@) $ 8910 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( سألت أنا وعمر بن الخطاب رضي الله عنهما رسول الله عن زيد بن عمرو بن نفيل فقال : ( يأتي يوم القيامة أمة وحده ) . ( ع وأبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 8911 عن سعيد بن زيد رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( استغفروا للنجاشي ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8912 عن سعيد بن زيد رضي الله عنه :(@)(@@) | 30 ( أن النبي قال لعلي رضي الله عنه : ( أنت مني بمنزلة هاارون من موساى إلا أنه لا نبي بعدي ) . ( أبو نعيم ) . )(@)(@@) PageV17P008(@)(@@)(@@)(@@) |||| ( 7 مسند طلحة بن عبيد الله رضي الله عنه(@)(@@)(@@)(@@) $ ( 8913 ) عن أبي وائل قال : ' حدثت أن أبا بكر لقي طلحة بن عبيد الله رضي الله عنهما فقال : مالي أراك واجما ؟ قال : كلمة سمعتها من رسول الله & يقول : ' إنها موجبة فلم أسأل عنها ' ، فقال أبو بكر : أنا أعلمها هي : لا إله إلا الله ' . ( ابن راهوية ع وابن منيع ، قط في الإفراد ، وأبو نعيم في المعرفة ، ورجاله ثقات ) .(@)(@@)(@@)(@@) $ 8914 عن يحيى بن طلحة بن عبيد الله قال :(@)(@@) | 30 ( رأى عمر طلحة بن عبيد الله رضي الله عنه حزينا ، فقال : مالك ؟ فقال : إني سمعت رسول الله يقول : ( إني لأعلم كلمة وفي لفظ : كلمات لا يقولهن عبد عند الموت إلا نفس عنه وفي لفظ : إلا نفس الله عنه كربه ، وأشرق لها لونه ، ورأى ما يسره ) ، فما منعني أن أسأل عنها إلا 
ms5675	 القدرة عليها ، حتاى مات ، فقال عمر : إني لأعلم ما هي ؟ قال : هل تعلم كلمة هي أفضل من كلمة دعا إليها رسول الله عمه عند الموت ، قال طلحة : هي والله هي ، قال عمر : لا إلاه إلا الله ) . ( حم ، ع ، والجوهري في أماليه ) . )(@)(@@)(@@)(@@) $ 8915 عن أبي رجاء العطاردي قال :(@)(@@) | 30 ( صلى بنا طلحة رضي الله عنه فخفف ، فقلنا ما هاذا ؟ قال : بادرت الوسواس ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8916 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( قلنا : يا رسول الله قد علمنا كيف السلام عليك ، فكيف الصلاة عليك ؟ قال : قولوا : ( اللهم صل علاى محمد وعلاى آل محمد ، وبارك علاى محمد وعلاى آل محمد ، كما صليت وباركت علاى إبراهيم وعلاى آل إبراهيم إنك حميد مجيد ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8917 عن ابن أبي الدنيا في كتاب محاسبة النفس ، حدثني عبد الرحمان بن PageV17P009 صالح ، حدثنا المحاربي عن ليث ، عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( انطلق رجل ذات يوم ، فنزع ثيابه ، وتمرغ في الرمضاء ، ويقول لنفسه : ذوقي نار جهنم ، أجيفة بالليحل وبطالة بالنهار ؟ قال : فبينا هو كذالك إذ أبصر النبي في ظل شجرة ، فأتاه فقال : غلبتني نفسي ، فقال له النبي : ( أما لقد فتحت لك أبواب السماء ، ولقد باهاى الله بك الملائكة ، ثم قال لأصحابه : تزودوا من أخيكم ) ، فجعل الرجل يقول : يا فلان ادع لي ، فقال له النبي : ( عمهم ) ، فقال : اللهم اجعل التقواى زادهم ، واجمع علاى الهداى أمرهم ، فجعل النبي يقول : ( اللهم سدده ) ، فقال : واجعل الجنة مآبهم ) . )(@)(@@)(@@)(@@) $ 8918 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لا تشاور بخيلا في صلة ، ولا جبانا في حرب ، ولا شابا في جارية ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8919 عن ابن عمر رضي الله عنها :(@)(@@) | 30 ( أن عمر رأى علاى طلحة بن عبيد الله رضي الله عنه ثوبا مصبوغا بالمشق وهو محرم ، فقال له : ما هاذا الثوب المصبوغ يا طلحة فقال : يا أمير المؤمنين ليس به بأس ، إنما هو مدر ، فقال عمر رضي الله عنه : إنكم أيها الرهط أئمة يقتدي بكم الناس ، فلو أن رجلا جاهلا رأى هاذا الثوب لقال 
ms5676	 : إن طلحة بن عبيد الله قد كان يلبس الثياب المصبغة في الاحرام ، فلا تلبسوا أيها الرهط شيئا من هاذه الثياب المصبغة في الاحرام ) . ( مالك وابن المبارك ومسدد ، ق ) . )(@)(@@)(@@)(@@) $ 8920 عن عبد الرحمن بن عثمان التيمي قال :(@)(@@) | 30 ( كنا مع طلحة بن عبيد الله ونحن محرمون ، فأهدي لنا لحم صيد وهو راقد ، فمنا من أكل ، ومنا من تورع ولم يأكل ، فاستيقظ طلحة رضي الله عنه فوافق من أكله وقال : أكلناه مع رسول PageV17P010 الله ) . ( ابن جرير وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 8921 عن محمد بن المكندر قال :(@)(@@) | 30 ( حدثنا شيخ لنا عن طلحة بن عبيد الله رضي الله عنه قال : سألنا النبي عن لحم صيد صاده ؟ حلال أيأكله المحرم ؟ قال : ( لا بأس به ) أو قال : ( نعم ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8922 عن طلحة بن عبيد الله بن كريز رضي الله عنه قال :(@)(@@) | 30 ( كتب عمر بن الخطاب رضي الله عنه إلاى أمراء الأجناد : إذا تداعت القبائل فاضربوهم بالسيف حتى يصيروا إلاى دعوة الاسلام ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8923 عن طلحة رضي الله عنه :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه لم يقنت في الفجر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8924 عن عروة قال :(@)(@@) | 30 ( قدم طلحة بن عبيد الله رضي الله عنه من الشام بعد ما رجع رسول الله من بدر ، فكلم رسول الله في سهمه ، فقال : نعم لك سهمك ، فضرب له بسهمه ، قال : وأجري يا رسول الله ؟ قال : وأجرك ) . ( ابن عائذ ، كر ، وعن ابن شهاب مثله كر ، وعن موساى بن عقبة مثله كر ، وعن ابن إسحاق مثله كر ) . )(@)(@@)(@@)(@@) $ 8925 عن الشعبي قال :(@)(@@) | 30 ( أصيب يوم أحد أنف رسول الله ورباعيته ، وزعم أن طلحة وقاى رسول الله بيده فضرب فشلت أصبعه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8926 عن قيس بن أبي حازم قال :(@)(@@) | 30 ( رأيت يد طلحة بن عبيد الله شلاء وقاى بها النبي يوم أحد ) . ( ش ، حم وابن منده ، كر وأبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 8927 عن موساى بن طلحة قال :(@)(@@) | 30 ( لقد رأيت بطلحة رضي الله عنه أربعة وعشرين جرحا جرحها مع رسول الله ) . ( ش ) . )(@)(@@) PageV17P011(@)(@@)(@@)(@@) $ 8928 عن 
ms5677	 طلحة رضي الله عنه :(@)(@@) | 30 ( أنه لما وقاى رسول الله بيده يوم أحد فقطعت قال : حس ، فقال النبي : لو قلت : ( بسم الله ، لرأيت بناءك الذي بناى الله لك في الجنة وأنت في الدنيا ) . ( قط في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ 8929 عن الزهري قال :(@)(@@) | 30 ( لما كان يوم أحد وانهزم المسلمون عن رسول الله حتى بقي فهي اثنى عشر رجلا من المهاجرين والأنصار ، منهم طلحة بن عبيد الله ، فذهب رجل من المشركين يضرب وجه رسول الله بالسيف ، فوقاه طلحة رضي الله عنه بيده ، فلما أصاب طلحة السيف قال : حس ، فقال رسول الله : من يا طلحة ألا قلت : ( بسم الله ؟ لو قلت بسم الله وذكرت الله ، لرفعتك الملائكة والناس ينظرون إليك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8930 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم أحد وأصابني السهم فقلت : حس ، فقال النبي : ( لو قلت : بسم الله لطارت بك الملائكة والناس ينظرون إليك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8931 عن ابن شهاب قال :(@)(@@) | 30 ( كان رسول الله مقدمه المدينة مهاجرا قد آخاى بين المهاجرين والأنصار ، يتوارثون دون ذوي الأرحام ، حتى نزلت آية الفرائض : { وأولو الأرحام بعضهم أولاى ببعض في كتاب الله } ، فآخاى بين طلحة بن عبيد الله ، وبين أبي أيوب خالد بن زيد رضي الله عنهما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8932 عن ثور بن مجزاة قال :(@)(@@) | 30 ( مررت بطلحة بن عبيد الله رضي الله عنه يوم الجمل وهو صريع في آخر رمق فوقفت عليه ، فرفع رأسه فقال : إني لأراى وجه رجل كأنه القمر ، فممن أنت ؟ فقلت : من أصحاب أمير المؤمنين علي رضي الله عنه ، فقال : ابسط يدك أبايعك له فبسطت يدي فبايعني وفاضت نفسه ، فأتيت عليا PageV17P012 فأخبرته بقول طلحة ، فقال : الله أكبر الله أكبر صدق رسول الله ، أباى الله أن يدخل طلحة الجنة إلا وبيعتي في عنقه ) . ( ك ، قال ابن حجر في الأطراف : سنده ضعيف جدا ) . )(@)(@@)(@@)(@@) $ 8933 عن محمد بن عبيد الله الأنصاري عن أبيه قال :(@)(@@) | 30 ( جاء رجل يوم الجمل فقال : ائذنوا لقاتل طلحة فسمعت عليا رضي الله عنه يقول : بشره بالنار ) . ( كر 
ms5678	 ) . )(@)(@@)(@@)(@@) $ 8934 عن رفاعة بن إياس الضبي عن أبيه عن جده قال :(@)(@@) | 30 ( كنت مع علي رضي الله عنه في الجمل ، فبعث إلاى طلحة رضي الله عنه أن القني فلقيه ، فقال : أنشدك الله أسمعت رسول الله يقول : ( من كنت مولاه فعلي مولاه ، اللهم وال من والاه ، وعاد من عاداه ) ؟ قال : نعم ، قال : فلم تقاتلني ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8935 عن سيف بن عمر ، عن بدر بن الخليل ، عن علي بن ربيعة الوالبي قال :(@)(@@) | 30 ( حدثت عليا رضي الله عنه بأمر طلحة وأخبرته أن سيفه كان يقال له : الجزاز ، فأخبر خبر محبق وضربته إياه بالجزاز ، ونبوة الجزاز عنه ، فقال : وقع بنا الخبر بضربة طليحة ونبوة الجزاز عنه ، فقال النبي : ( إنها مأمورة ولقد شجى وإن كان الحراب قد نبا عنه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8936 عن إبراهيم قال :(@)(@@) | 30 ( جاء بشر بن جرموز إلاى علي بن أبي طالب رضي الله عنه فجفاه ، فقال : هاكذا يفعل بأهل البلاء ، فقال علي : بفيك الحجر إني لأرجو أن أكون أنا وطلحة والزبير رضي الله عنهم ممن قال الله فيهم : { ونزعنا ما في صدورهم من غل إخوانا علاى سرر متقابلين } ) . ( اللالكائي ) . )(@)(@@)(@@)(@@) $ 8937 عن أم راشد قالت :(@)(@@) | 30 ( سمعت طلحة والزبير رضي الله عنهما يقول PageV17P013 أحدهما لصاحبه : بايعته أيدينا ولم تبايعه قلوبنا ، فقلت لعلي رضي الله عنه ، فقال علي : من نكث فإنما ينكث علاى نفسه ومن أوفاى بما عاهد عليه الله فسيؤتيه أجرا عظيما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8938 عن صعصعة بن معاوية الليثي قال :(@)(@@) | 30 ( أرسل عثمان رضي الله عنه وهو محصور إلاى علي وطلحة والزبير وأقوام من الصحابة فقال : احضروا غدا وتكونوا حيث تسمعون مآ أقول لهاذه الخارجة ، ففعلوا ، وأشرف عليهم فقال : أنشدق الله من سمع النبي يقول : ( من يشتري هاذا المربد ويزيده في مسجدنا وله الجنة وأجره في الدنيا ما بقي درجات له ) ، فاشتريته بعشرين ألفا وزدته في المسجد ؟ قالوا : اللهم نعم ، وقال الخوارج : صدقوا ولاكنك غيرت ، ثم قال : أنشد الله من سمع رسول الله يقول : ( من يجهز جيش العسرة وله الجنة ) ، فجهزتهم حتى ما 
ms5679	 فقدوا عقالا ولا خطاما ؟ قالوا : نعم ، فقال الخوارج : صدقوا ولاكنك غيرت ، ثم قال : أنشد الله من سمع رسول الله يقول : ( من يشتري رومة وله الجنة ) فاشتريتها ، فقال : اجعلها للمساكين ولك أجرها والجنة ؟ قالوا : اللهم نعم ، قال الخوارج : صدقوا ولاكنك غيرت ، وعدد أشياء وقال : الله أكبر ، ويلكم خصمتم والله كيف يكون من يكون هاذا له مغيرا ؟ ، يا أيها النفر من أهل الشوراى إعلموا أنهم سيقولون لكم غدا كما قالوا ل اليوم . فلما خرجوا بعد علاى علي ، جعل علي رضي الله عنه ينشد الناس عن مثل ذالك ويشهد له به فيقولون : صدقوا ولاكنك غيرت ، فقال : ما اليوم قتلت ، ولاكني قتلت يوم قتل ابن بيضاء ) . ( سيف ، كر ) . )(@)(@@)(@@)(@@) $ 8939 عن الهزيل قال :(@)(@@) | 30 ( دخل طلحة علاى عثمان رضي الله عنهما فقال له عثمان : أنشدك بالله يا طلحة هل تعلم أن رسول الله كان علاى حراء ، فقال : ( اقرر حراء فإن عليك نبيا ، أو صديقا ، أو شهيدا ) وكان عليه رسول الله وأبو بكر وعمر وأنا وعلي وأنت والزبير وعبد الرحمان بن عوف وسعد بن مالك وسعيد بن PageV17P014 زيد ؟ ثم قال : أنشدك بالله يا طلحة هل تعلم أن رسول الله قال : ( النبي في الجنة ، وأبو بكر في الجنة ، وعمر في الجنة ، وعثمان في الجنة ، وعلي في الجنة ، وطلحة في الجنة ، والزبير في الجنة ، وعبد الرحمان بن عوف في الجنة ، وسعد بن مالك في الجنة ، وسعيد بن زيد في الجنة ) ؟ قال : اللهم نعم ، قال : نشدتك بالله لتعلم أن سائلا سأل النبي فأعطاه أربعين درهما ، ثم سأل أبا بكر فأعطاه أربعين درهما ، ثم سأل عمر فأعطاه أربعين درهما ، ثم سأل عليا فلم يكن عنده شيء فأعطيته أربعين عن علي وأربعين عني ، فجاء بها إلاى النبي فقال : يا رسول الله ادع الله لي بالبركة ، فقال : ( وكيف لا يبارك لك ، وإنما أعطاك نبي أو صديق أو شهيد ) ؟ قال : اللهم نعم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8940 عن ابن عباس رضي الله عنه قال : $ 30 ( ذكرت طلحة لعمر رضي الله عنه فقال : ذاك رجل فيه بأوق 
ms5680	 منذ أصيبت يده مع رسول الله ) . ( ط ) .(@)(@@)(@@)(@@) $ 8941 عن طلحة بن عبيد الله رضي الله عنه قال :(@)(@@) | 30 ( خطب عمر بن الخطاب أم أبان بنت عتبة بن ربيعة بن عبد شمس فأبته فقيل لها : ولم ؟ قالت : إن دخل دخل ببأس ، وإن خرج خرج ببأس ، قد داخله أمرق أذهله عن أمر دنياه ، كأنه ينظر إلاى ربه بعينه ، ثم خطبها الزبير بن العوام فأبته ، فقيل لها : ولم ؟ قالت : ليس لزوجته منه إلا شارة في قراملها ، ثم خطبها علي رضي الله عنه فأبت ، فقيل لها : ولم ؟ قالت : ليس لزوجته منه إلا قضاء حاجته ، ويقول : كنت وكنت ، وكان وكان ، ثم خطبها طلحة رضي الله عنه فقالت : زوجي حقا ، فقيل : وكيف ذالك ؟ قالت : إني عارفة بخلائقه ، إن دخل دخل ضحاكا ، وإن خرج خرج بساما ، إن سألت أعطى ، وابن سكت ابتدأ ، وابن عملت شكر ، وإن أذنبت غفر ، فلما أن ابتنى بها PageV17P015 قال علي : يا أبا محمد إن أذنت لي أن أكلم أم أبان قال : كلمها ، فأخذ سجف الحجلة ثم قال : السلام عليك يا عزيزة نفسها فقالت : وعليك السلام قال : خطبك أمير المؤمنين وسيد المسلمين فأبيته ، قالت : كان ذالك ، قال : وخطبك الزبير ابن عمة رسول الله وأحد حواريه فأبيته ، قالت : وقد كان ذالك ، قال : وخطبتك أنا وقرابتي من رسول الله ، قالت : قد كان ذالك ، قال : أما والله لقد تزوجت أحسننا وجها ، وأسمحنا كفا ، يعطي هاكذا وهاكذا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8942 عن النزال بن سبرة قال :(@)(@@) | 30 ( قالوا لعلي رضي الله عنه : حدثنا عن طلحة رضي الله عنه ، قال : ذاك امرؤ نزل فيه آية من كتاب الله : { فمنهم من قضاى نحبه ومنهم من ينتظر } طلحة ممن قضاى نحبه لا حساب عليه فيما يستقبل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8943 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( لما انهزم الناس عن رسول الله يوم أحد حتى لم يبق معه إلا طلحة فغشوهما ، فقال رسول الله : ( من لهاؤلاء ) ؟ فقال طلحة رضي الله عنه : أنا ، فقاتل فأصيب بعض أنامله فقال : حس ، فقال رسول الله 