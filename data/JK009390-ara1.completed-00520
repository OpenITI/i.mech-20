ms506	 ، وإن لم يكن هو فلا خير لك في قتله ) )(@)(@@) ( ق ت ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4735 ) قال النبي :(@)(@@) | 30 ( أن يمنح أحدكم أخاه خير له من أن يأخذ عليه خرجا معلوما ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4736 ) قال النبي :(@)(@@) | 30 ( أنا ابن العواتك من سليم ) )(@)(@@) ( ص طب ) عن سبابة بن عاصم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4737 ) قال النبي :(@)(@@) | 30 ( أنا أبو القاسم ، الله يعطي وأنا أقسم ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4738 ) قال النبي :(@)(@@) | 30 ( أنا أتقاكم لله وأعلمكم بحدود الله ) )(@)(@@) ( حم ) عن رجل من الأنصار ( ز ) .(@)(@@) PageV02P184(@)(@@)(@@)(@@) $ ( 4739 ) قال النبي :(@)(@@) | 30 ( أنا أعربكم ، أنا من قريي ولساني لسان بني سعد بن بكر ) )(@)(@@) ( ابن سعد ) عن يحيى بن يزيد السعدي مرسلا .(@)(@@)(@@)(@@) $ ( 4740 ) قال النبي :(@)(@@) | 30 ( إناء كاناء ، وطعام كطعام ) )(@)(@@) ( ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4741 ) قال النبي :(@)(@@) | 30 ( أنا أكثر الأنبياء تبعا يوم القيامة ، وأنا أول من يقرع باب الجنة ) )(@)(@@) ( م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4742 ) قال النبي :(@)(@@) | 30 ( أنا أكرم من وفى بذمته ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4743 ) قال النبي :(@)(@@) | 30 ( أنا الشاهد على الله أن لا يعثر عاقل إلا رفعه ، ثم لا يعثر إلا رفعه ثم لا يعثر إلا رفعه حتى يجعل مصيره إلى الجنة ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4744 ) قال النبي :(@)(@@) | 30 ( أنا النبي الأمي الصادق الزكي الويل لمن كذبني وتولى عني وقاتلني ، والخير لمن آواني ونصرني ، وآمن بي وصدق قولي وجاهد معي ) )(@)(@@) ( ابن سعد ) عن عبد عمرو بن جبلة الكلبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4745 ) قال النبي :(@)(@@) | 30 ( أنا النبي لا كذب أنا ابن عبد المطلب ) )(@)(@@) ( حم ق ن ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4746 ) قال النبي :(@)(@@) | 30 ( أنا النبي لا كذب أنا ابن عبد المطلب ، أنا أعرب العرب ، ولدتني قريش ونشأت في بني سعد بن بكر ، فأنى يأتيني اللحن ) )(@)(@@) ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4747 ) قال النبي :(@)(@@) | 30 
ms507	 ( أنا أنبئك بخير رجل ربح ، ركعتين بعد الصلاة ) )(@)(@@) ( د ) عن رجل ( ز ) .(@)(@@) PageV02P185(@)(@@)(@@)(@@) $ ( 4748 ) قال النبي :(@)(@@) | 30 ( أنا أولى الناس بعيسى بن مريم في الدنيا والآخرة ، ليس بيني وبينه نبي ، والأنبياء أولاد علات ، أمهاتهم شتى ودينهم واحد ) )(@)(@@) ( حم ق د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4749 ) قال النبي :(@)(@@) | 30 ( أنا أولى بالمؤمنين في كتاب الله ، فأيكم ما ترك دينا أو ضيعة فادعوني فأنا وليه ، وأيكم ما ترك مالا فليؤثر بماله عصبته من كان ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4750 ) قال النبي :(@)(@@) | 30 ( أنا أولى بالمؤمنين من أنفسهم فمن توفي من المؤمنين فترك دينا فعلي قضاؤه ، ومن ترك مالا فهو لورثته ) )(@)(@@) ( حم ق ن ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4751 ) قال النبي :(@)(@@) | 30 ( أنا أولى بكل مؤمن من نفسه ، فمن ترك دينا أو ضيعة فإلي ، ومن ترك مالا فلورثته ، وأنا مولى من لا مولى له ، أرث ماله وأفك عانيه ، والخال مولى من لا مولى له يرث ماله ويعقل عنه ) )(@)(@@) ( د ) عن المقدام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4752 ) قال النبي :(@)(@@) | 30 ( أنا أولى بكل مؤمن من نفسه ، فمن ترك دينا فعلي ، ومن ترك مالا فلورثته ) )(@)(@@) ( حم د ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4753 ) قال النبي :(@)(@@) | 30 ( أنا أول الناس خروجا إذا بعثوا ، وأنا خطيبهم إذا وفدوا ، وأنا مبشرهم إذا أيسوا ، لواء الحمد يومئد بيدي ، وأنا أكرم ولد آدم على ربي ولا فخر ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@) PageV02P186(@)(@@)(@@)(@@) $ ( 4754 ) قال النبي :(@)(@@) | 30 ( أنا أول الناس يشفع في الجنة وأنا أكثر الأنبياء تبعا ) )(@)(@@) ( م ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4755 ) قال النبي :(@)(@@) | 30 ( أنا أول شفيع في الجنة ، لم يصدق نبي من الأنبياء ما صدقت ، وإن من الأنبياء نبيا ما يصدقه من أمته إلا رجل واحد ) )(@)(@@) ( م ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4756 ) قال النبي :(@)(@@) | 30 ( أنا أول من تنشق الأرض عنه ، ثم أبو بكر ثم عمر ، ثم آتي أهل البقيع فيحشرون معي ، ثم أنتظر أهل 
ms508	 مكة حتى أحشر بين الحرمين ) )(@)(@@) ( ت ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4757 ) قال النبي :(@)(@@) | 30 ( أنا أول من تنشق الأرضضعنه فاكسى حلة من حلل الجنة ، ثم أقوم عن يمين العرش ليس أحد من الخلائق يقوم ذالك المقام غيري ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4758 ) قال النبي :(@)(@@) | 30 ( أنا أول من يأخذ بحلقة باب الجنة فاقعقعها ) )(@)(@@) ( حم ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4759 ) قال النبي :(@)(@@) | 30 ( أنا أول من يدق باب الجنة ، فلم تسمع الآذان أحسن من طنين الحلق على تلك المصاريع ) )(@)(@@) ( ابن النجار ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4760 ) قال النبي :(@)(@@) | 30 ( أنا يريء ممن حلق وسلق وخرق ) )(@)(@@) ( م ن ه ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4761 ) قال النبي :(@)(@@) | 30 ( أنا بريء من كل مسلم يقيم بين أظهر المشركين ، PageV02P187 لا تراءى نارهما ) )(@)(@@) ( د ت ) و الضياء عن جرير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4762 ) قال النبي :(@)(@@) | 30 ( أنا حرب لمن حاربتم ، وسلم لمن سالمتم ) )(@)(@@) ( ت ه حب ك ) عن زيد بن أرقم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4763 ) قال النبي :(@)(@@) | 30 ( أنا دار الحكمة وعلي بابها ) )(@)(@@) ( ت ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4764 ) قال النبي :(@)(@@) | 30 ( أنا دعوة إبراهيم ، وكان آخر من بشر بي عيسى بن مريم ) )(@)(@@) ( ابن عساكر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4765 ) قال النبي :(@)(@@) | 30 ( أنا رسول من أدركت حيا ، ومن يولد من بعدي ) )(@)(@@) ( ابن سعد ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 4766 ) قال النبي :(@)(@@) | 30 ( أنا زعيم بيت في ربض الجنة لمن ترك المراء وإن كان محقا ، وبيت في وسط الجنة لمن ترك الكذب وإن كان مازحا ، وبيت في أعلى الجنة لمن حسن خلقه ) )(@)(@@) ( د ) و الضياء عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4767 ) قال النبي :(@)(@@) | 30 ( أنا زعيم لمن آمن بي وأسلم وهاجر ببيت في ربض الجنة ، وبيت في وسط الجنة ، وبيت في أعلى غرف الجنة ، وأنا زعيم لمن آمن بي وأسلم وجاهد في سبيل الله ببيت في ربض 
ms509	 الجنة ، وبيت في وسط الجنة ، وبيت في أعلى غرف الجنة ، فمن فعل ذالك لم يدع للخير مطلبا ولا من الشر مهربا يموت حيث شاء أن يموت ) )(@)(@@) ( ن حب ك ) عن فضالة بن عبيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4768 ) قال النبي :(@)(@@) | 30 ( أنا سابق العرب ، وصهيب سابق الروم ، وسلمان سابق الفرس ، وبلال سابق الحبش ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@) PageV02P188(@)(@@)(@@)(@@) $ ( 4769 ) قال النبي :(@)(@@) | 30 ( أنا سيد الناس يوم القيامة وهل تدرون مم ذالك ؟ يجمع الله الأولين والآخرين في صعيد واحد ، يسمعهم الداعي ، وينفذهم البصر ، وتدنو الشمس منهم فيبلغ الناس من الغم والكرب ما لا يطيقون ولا يحتملون ، فيقول بعض الناس لبعض : ألا ترون ما قد بلغكم ؟ ألا تنظرون ؟ من يشفع لكم إلى ربكم ؟ فيقول بعض الناس لبعض : ائتوا آدم ، فيقولون : يا آدم أنت أبونا ، أنت أبو البشر ، خلقك الله بيده ، ونفخ فيك من روحه ، وأمر الملائكة فسجدوا لك ، اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ، ألا ترى ما قد بلغنا ؟ فيقول لهم آدم : إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ، ولن يغضب بعده مثله ، وإنه نهاني عن الشجرة فعصيته ، نفسي نفسي نفسي اذهبوا إلى غيري ، اذهبوا إلى نوح فيأتون نوحا فيقولون : يا نوح أنت أول الرسل إلى أهل الأرض وسماك الله عبدا شكورا ، اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ؟ ألا ترى ما قد بلغنا ؟ فيقول لهم نوح : إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ، ولن يغضب بعده مثله ، وإنه قد كانت لي دعوة دعوت بها على قومي ، نفسي نفسي نفسي ، اذهبوا إلى غيري ، اذهبوا إلى إبراهيم ، فيأتون إبراهيم فيقولون : يا إبراهيم ، أنت نبي الله وخليله من أهل الأرض اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ؟ ألا ترى ما قد بلغنا ؟ فيقول لهم إبراهيم : إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ، ولن يغضب بعده مثله ، وإني قد كنت كذبت ثلاث كذبات ، نفسي نفسي نفسي ، اذهبوا إلى 
ms510	 غيري ، اذهبوا إلى موسى ، فيأتون موسى فيقولون : يا موسى أنت رسول الله ، فضلك الله برسالاته وبكلامه على الناس اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ؟ ألا ترى ما قد بلغنا ؟ فيقول لهم موسى : إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ، ولن يغضب بعده مثله ، وإني قتلت PageV02P189 نفسا لم أؤمر بقتلها ، نفسي نفسي نفسي ، اذهبوا إلى غيري ، اذهبوا إلى عيسى ، فيأتون عيسى فيقولون : يا عيسى أنت رسول الله وكلمته ألقاها إلى مريم وروح منه وكلمت الناس في المهد ، اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ؟ ألا ترى ما قد بلغنا ؟ فيقول لهم عيسى : إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ، ولن يغضب بعده مثله ، نفسي نفسي نفسي ، اذهبوا إلى غيري ، اذهبوا إلى محمد ، فيأتوني ، فيقولون : يا محمد أنت رسول الله وخاتم الأنبياء ، وغفر الله لك ما تقدم من ذنبك وما تأخر اشفع لنا إلى ربك ، ألا ترى ما نحن فيه ؟ ألا ترى ما قد بلغنا ؟ فأنطلق فآتي تحت العرش فأقع ساجدا لربي ، ثم يفتح الله علي ويلهمني من محامده وحسن الثناء عليه شيئا لم يفتحه لأحد قبلي ، ثم يقال : يا محمد إرفع رأسك ، سل تعط ، واشفع تشفع فأرفع رأسي فأقول : يا رب أمتي أمتي ، فيقال : يا محمد أدخل الجنة من أمتك من لا حساب عليه من الباب الأيمن من أبواب الجنة وهم شركاء الناس فيما سوى ذالك من الأبواب ، والذي نفسي بيده ، إن ما بين مصراعين من مصاريع الجنة لكما بين مكة وهجر ، أو كما بين مكة وبصرى ) )(@)(@@) ( حم ق ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4770 ) قال النبي :(@)(@@) | 30 ( أنا سيد ولد آدم يوم القيامة وأول من ينشق عنه القبر ، وأول شافع وأول مشفع ) )(@)(@@) ( م د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4771 ) قال النبي :(@)(@@) | 30 ( أنا سيد ولد آدم يوم القيامة ولا فخر ، وبيدي لواء الحمد ولا فخر ، وما من نبي يومئذ ، آدم فمن سواه إلا تحت 
ms511	 لوائي ، وأنا أول شافع وأول مشفع ولا فخر ) )(@)(@@) ( حم ت ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4772 ) قال النبي :(@)(@@) | 30 ( أنا سيد ولد آدم يوم القيامة ولا فخر وبيدي لواء الحمد ولا فخر ، وما من نبي يومئذ ، آدم فمن سواه إلا تحت لوائي ، وأنا أول من PageV02P190 تنشق عنه الأرض ولا فخر ، فيفزع الناس ثلاث فزعات فيأتون آدم فيقولون : أنت أبونا آدم فاشفع لنا إلى ربك فيقول : إني أذنبت ذنبا أهبطت منه إلى الأرض ، ولاكن ائتوا نوحا ، فيأتون نوحا فيقول إني دعوت على أهل الأرض دعوة فاهلكوا ، ولاكن اذهبوا إلى إبراهيم فيأتون إبراهيم فيقول إني كذبت ثلاث كذبات ما منها كذبة إلا ماحل بها عن دين الله ، ولاكن ائتوا موسى ، فيأتون موسى فيقول : إني قتلت نفسا ، ولاكن ائتوا عيسى فيأتون عيسى فيقول إني عبدت من دون الله ، ولاكن ائتوا محمدا فيأتوني فأنطلق معهم فآخذ بحلقة باب الجنة فأقعقعها فيقال : من هاذا ؟ فأقول محمد ، فيفتحون لي ويرحبون ، فيقولون مرحبا فأخر ساجدا ، فيلهمني الله من الثناء والحمد ، فيقال لي ارفع رأسك سل تعطه واشفع تشفع وقل يسمع لقولك وهو المقام المحمود الذي قال الله : عسى أن يبعثك ربك مقاما محمودا ) )(@)(@@) ( ت و ابن خزيمة ) عن أبي سعيد إلا قوله : فآخذ بحلقة باب الجنة فإنها ، عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4773 ) قال النبي :(@)(@@) | 30 ( أنا شفيع لكل أخوين تحابا في الله ، من مبعثي إلى يوم القيامة ) )(@)(@@) ( حل ) عن سل مان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4774 ) قال النبي :(@)(@@) | 30 ( أنا فئة المسلمين ) ( د ) عن ا$ بن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4775 ) قال النبي :(@)(@@) | 30 ( أنا فرطكم على الحوض ) )(@)(@@) ( حم ق ) عن جندب ( خ ) عن ابن مسعود رضي الله عنه ( م ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4776 ) قال النبي :(@)(@@) | 30 ( أنا فرطكم على الحوض أنتظركم ليرفع لي رجال PageV02P191 منكم حتى إذا عرفتهم اختلجوا دوني فأقول : رب أصحابي رب أصحابي ، فيقال : إنك لا تدري ما أحدثوا بعدك ) )(@)(@@) ( حم خ ) عن حذيفة رضي الله 
