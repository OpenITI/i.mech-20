ms141	 وهو يرتاع خيفة % كما ارتاع ظبي خوف كفة جازر % 4(@)(@@) % وعيناه مملوءان دمعا كنرجس % عليه سقيط الطل ليس بقاطر % % PageV01P530 البحر : طويل 1(@)(@@) % وأقسم بالبزل النوافج في البرى % % تؤم منى والنافرات ضحى النفر % 2(@)(@@) % فما لجة الدأماء يوما تقاذفت % % بها عاصف نكباء في شاطىء البحر % 3(@)(@@) % بأكثر من قلبي اضطرابا ولم تعث % % يد الدهر فينا بل حذار يد الدهر % PageV01P531 البحر : سريع 1(@)(@@) % يا حسنها جارية أقبلت % % في الليل والليل بها كالنهار % 2(@)(@@) % لما رأتني خفضت طرفها % % فقلت ما أحسن خفض الجوار % % PageV01P532 البحر : كامل تام 1(@)(@@) % إن لم تفز يوما بقرب مزاره % % فاقنع بما شاهدت من آثاره % % 2(@)(@@) % واكحل جفونك من مواطىء نعله % % واسفح دموعك في رسوم دياره % % PageV01P533 البحر : كامل تام 1(@)(@@) % قسما بخصرك وهو واه واهن % وبروض خدك وهو زاه زاهر % % 2(@)(@@) % إني لأهوى ما تحب وإنما % % أنا فيه بين الناس شاك شاكر % PageV01P534 البحر : وافر تام 1(@)(@@) % ومن ركب العجوز فلا يبالي % % إذا ما اضطر من أكل العجوز % 2(@)(@@) % ولا تخل عجوزك من سهام % إذا ما اسطعت إعمال العجوز % 3(@)(@@) % وكم أمسى عجوز في عجوز % بمرتبة أجل من العجوز % % 4(@)(@@) % ورب فتى يرى نقع العجوز % % بمفرقه أجل من العجوز % 5(@)(@@) % ولا ترج الجسيم فكم عجوز % لعمر الله أجدى من عجوز % % 6(@)(@@) % ولا ترم الصغير فكل عضب % لقبضته افتقار للعجوز % % 7(@)(@@) % عسى عدل يزول الجور منه % % وترعى الشاة فيه مع العجوز % PageV01P535 البحر : خفيف تام 1(@)(@@) % جليت كالعروس وهي عجوز % من عذيري من العروس العجوز % % PageV01P536 البحر : - 1(@)(@@) % ولئن قضيت لنا بشرب مدامة % % يا رب فلتك من لماه الألعس % PageV01P537 البحر : طويل 1(@)(@@) % وقالوا به صفراء يرجى زوالها % % لقد صدقوا صفراء من خرد الحبش % % 2(@)(@@) % تفوق ضياء البدر إن تبد في الدجى % % وتزري بضوء الصبح إن تبد في الغبش % % PageV01P538 البحر : سريع 1(@)(@@) % من لحزين كلف موجع % % قد شفه الشوق إلى الأربع % 2(@)(@@) % مالي وللأربع ما لم تكن % % ربوع سلمى ربة البرقع % % 3(@)(@@) % لم أنس عصرا قد تقضى بها % % وجمعنا إذا هو لم يصدع % % 4(@)(@@) % بكيت 
ms142	 يوم البين وجدا فلم % % أبق لذكرى الوصل من أدمعي % % 5(@)(@@) % فهل لذاك الشمل من ناظم % أم هل لذاك العصر من مرجع % PageV01P539 البحر : سريع 1(@)(@@) % الله لي من واعد وعده % % كذب وفي الإنجاز من يلمع % % 2(@)(@@) % يمنعني العذب ولما يزل % % ينهلني بالآجن المنقع % 3(@)(@@) % مال مع الدهر على روعتي % % ولم يمل يوما عليه معي % % PageV01P540 البحر : كامل تام 1(@)(@@) % إن المكارم والفضائل والندى % % طبع جبلت عليه غير تطبع % % 2(@)(@@) % والمجد والشرف المؤثل والعلى % % وقف عليك وليس بالمستودع % PageV01P541 البحر : طويل 1(@)(@@) % لقد ظلمتني واستطالت يد النوى % % وقد طمعت في جانبي أي مطمع % 2(@)(@@) % إلى كم أقاسي فرقة بعد فرقة % وحتى متى يا بين أنت معي معي % % PageV01P542 البحر : بسيط تام 1(@)(@@) % أهكذا دوحة العلياء تنقصف % % وهكذا الشمس في الآفاق تنكسف % % 2(@)(@@) % وهكذا ظبة الماضي تفل شبا % من بعد ما زانها الإمضاء والرهف % % 3(@)(@@) % وهكذا بهجة العليا ونضرتها % % يزري بمشرقها الإظلام والسدف % % 4(@)(@@) % وهكذا درة المجد الأثيل غدت % % يضمها بعد حسن الحلية الصدف % % 5(@)(@@) % لله أية روح فارقت جسدا % وأي جثمان عز ضمه جدف % % 6(@)(@@) % يا قرة لعيون المجد قد سخنت % بكى لها الأشرفان المجد والشرف % % PageV01P543 البحر : رجز تام 1(@)(@@) % قد نال غايات المنى المنافق % إذ آذنتنا بالنوى النواعق % % PageV01P544 البحر : طويل 1(@)(@@) % أتانا لذيذ العنب رطبا ويانعا % بطعم كطعم الخسروي المعتق % % 2(@)(@@) % ونظم كنظم الدر يزهو على الدمى % % ذكي متى يتلى على السمع يعبق % % 3(@)(@@) % فشرد هما بين جنبي كامنا % وطاب به عيش الزمان المرنق % 4(@)(@@) % تزيد قلبي في الغرام إقلاق % % PageV01P545 البحر : مجزوء الرمل 1(@)(@@) % زرتها يوما فقالت % % وافني من قبل تدرك % % 2(@)(@@) % مذ كشفت الستر نادت % يا جميل الستر سترك % % PageV01P546 البحر : خفيف تام 1(@)(@@) % كل نجم سيعتريه أفول % وقصارى سفر البقاء القفول % 2(@)(@@) % لاحق إثر سابق والليالي % % بالمقادير راحلات نزول % 3(@)(@@) % والأماني كالمنايا وإن نا % % زع غر فالاشتقاق دليل % 4(@)(@@) % يا مصابا قد جرع القلب صابا % كل صبر إلا عليك جميل % % PageV01P547 البحر : كامل تام 1(@)(@@) % قف طالبا فضل الإله وسائلاقف طالبا فضل الإله وسائلا 
ms143	 % % واجعل فواضله إليك وسائلا % % PageV01P548 البحر : خفيف تام 1(@)(@@) % يا ربيب الندى وترب المعالي % % وأديبا فاق الورى بالمقال % % 2(@)(@@) % إستمع لي - لا زلت - وأصغ لقولي % % وأجبني بما يخف ثقالي % % 3(@)(@@) % فأنا اليوم منذ عامين صب % بغزال يفوق كل غزال % 4(@)(@@) % رق لي من جفاه كل عذول % ورثى لي من صده كل قال % % 5(@)(@@) % كلما رمت رشفة من لماه % % صد عني وسامني بالمحال % % 6(@)(@@) % وأنا والذي أعل فؤادي % % بهواه لست الغداة بسالي % % 7(@)(@@) % كيف والوجد قد أباح اصطباري % % ودموعي لما تزل في انهمال % % 8(@)(@@) % فافتني لا برحت فتوى أريب % % فعساه يصغي ويرثي لحالي % % 9(@)(@@) % وابق واسلم في عزة وعلاء % يا ربيب الندى وترب المعالي % % PageV01P549 البحر : بسيط تام 1(@)(@@) % نفسي الفداء لمقتول على ظمأ % لم يسق إلا بحد البيض والأسل % 2(@)(@@) % نفس الفداء له من هالك هلكت % % له الهداية من علم ومن عمل % % 3(@)(@@) % قرت به أعين الأعداء شامتة % وأسخنت أعين الأملاك والرسل % 4(@)(@@) % أفديه مستنصرا قد قل ناصره % % ومستضاما قليل الخيل والخول % % 5(@)(@@) % يا صرعة صرعت شم الأنوف بها % % وأصبح الدين منها عاثر الأمل % % 6(@)(@@) % قد أثكلت بضعة المختار فاطمة % وأوجعت قلب خير الأوصياء علي % % PageV01P550 البحر : طويل 1(@)(@@) % وإني غريب بين قومي وجيرتي % % وأهلي وحتى ما كأنهم أهلي % % 2(@)(@@) % وليس غريب الدار من راح نائيا % عن الأهل لكن من غدا نائي الشكل % 3(@)(@@) % فمن لي بخل في الزمان مشاكل % ألف به من بعد طول النوى شملي % % PageV01P551 البحر : مجزوء الكامل 1(@)(@@) % حزنت لموتك طيبة % ومنى وزمزم والحطيم % % 2(@)(@@) % فلذا أتى ببديهة % تاريخه حزن عظيم % PageV01P552 البحر : طويل 1(@)(@@) % وثم أمور ليس يمكن كشفها % % شكايتها عزت فواجبها الكتم % PageV01P553 البحر : - 1(@)(@@) % وشاعر قريضه % % من كل حسن معدم % % 2(@)(@@) % لم يلتزم شيئا سوى % % لزوم ما لا يلزم % PageV01P554 البحر : وافر تام 1(@)(@@) % بعون الله تم الشرح نظما % ونثرا مخجلا در النظام % 2(@)(@@) % ومسك ختامه مذ طاب نشرا % أتى تاريخه طيب الختام % PageV01P555 البحر : بسيط تام 1(@)(@@) % تاريخ ختمي لأنوار الربيع أتى % % طيب الختام فيا طوبى لمختتم % PageV01P556 البحر : بسيط تام 
ms144	 1(@)(@@) % يا متعبا بنقوش الخط أنمله % % وساهر الليل لم يرقد ولم ينم % 2(@)(@@) % دع عنك ما راحت الأقلام تنقشه % % في صفحة السيف ما يغني عن القلم % % PageV01P557 البحر : طويل 1(@)(@@) % تراءت سليمي وهي كالبدر أو أسنى % % فضاء فضاء الربع من ضوئها وهنا % % PageV01P558 البحر : رمل تام 1(@)(@@) % من لصب شفه جور النوى % % كلما أوجعه التذكار أنا % % 2(@)(@@) % وإذا هبت صبا نجد صبا % % قلبه شوقا إلى نجد وحنا % % PageV01P559 البحر : بسيط تام 1(@)(@@) % فارقت مكة والأقدار تقحمني % % ولي فؤاد بها ثاو مدى الزمن % 2(@)(@@) % فارقتها لا رضى مني وقد شهدت % بذلك أملاك ذاك الحجر والركن % % 3(@)(@@) % فارقتها وبودي إذ فرقت بها % % لو كان قد فارقت روحي بها بدني % % PageV01P560 البحر : كامل تام 1(@)(@@) % هذا كتاب في معانيه حسن % للديلمي أبي محمد الحسن % 2(@)(@@) % أشهى إلى المضني العليل من الشفا % % وألذ في العينين من غمض الوسن % PageV01P561 البحر : مجزوء الكامل 1(@)(@@) % جاء البشير مبشرا % فأقر من بشراه عيني % % 2(@)(@@) % وافى يقول أتى الحسي % % ن فقلت أهلا بالحسين % % 3(@)(@@) % أهو الذي حاز المكا % % رم والعلى ملء اليدين % 4(@)(@@) % قالوا نعم هو ذاك من % % فاق الورى من غير مين % % PageV01P562 البحر : مجزوء الكامل 1(@)(@@) % يا قهوة قشرية % حكت النضار بلونها % % 2(@)(@@) % ولكم حباك حبابها % % بخلاصها ولجينها % % 3(@)(@@) % جليت علي مصونة % بزفافها وبصونها % % 4(@)(@@) % وكأن كل حبابة % ترنو إلي بعينها % % PageV01P563 البحر : بسيط تام 1(@)(@@) % قامت تدير سلافا من مراشفها % % حبابها لؤلؤء الثغر الجماني % % 2(@)(@@) % في ليلة من أثيث الشعر حالكة % منها دجا حندس الليل الدجوجي % 3(@)(@@) % تريك إن أسفرت غراء مائسة % بدر السماء على أعطاف خطي % % 4(@)(@@) % كم لوعة بت أخفيها وأظهرها % % فيها وسر التصابي غير مخفي % % 5(@)(@@) % أما وصعدة قد من معاطفها % % وعضب لحظ نضته هندواني % % 6(@)(@@) % ما إن عذلت على حبي الفؤاد لها % % إلا وجاء بعذر فيه عذري % % 7(@)(@@) % وافت فأذكت هموما غير خامدة % % واذكرتني عهدا غير منسي % 8(@)(@@) % يا حبذا نظرة هام الفؤاد بها % % أزرت - وعينيك - بالظبي الكناسي % % 9(@)(@@) % لقد نعمت بوعد منك منتظر % ونائل من نظام الدين 
ms145	 مقضي % % PageV01P564 
