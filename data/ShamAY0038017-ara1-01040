ms1021	 صالح بن صالح الأسدي يروي عن الشعبي، وعبد خير، ولا يروي عن غيرهما، وصالح بن أبي صالح سدوسي، يروي عن علي بن أبي طالب، ولم نذكره في التابعين.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبد الرحمن بن المسور المدني(@)(@@) يروي عن عائشة بنت سعد، روى عنه مزاحم بن زفر.(@)(@@)(@@)(@@) ||| AUTO صالح بن غزوان الحفار(@)(@@) يروي عن سعد بن مسعود التيمي، عن ابن عباس، روى عنه حبان بن هلال.(@)(@@)(@@)(@@) ||| AUTO صالح بن عجلان(@)(@@) يروي المراسيل، روى عنه سليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO صالح بن مسلم العجلي(@)(@@) يروي عن الشعبي، روى عنه جرير بن عبد الحميد.(@)(@@) (340) -[3: 449] ثنا محمد بن المنذر، قال: حدثنا أحمد بن منصور، قال: ثنا محمد بن كناسة، قال: ثنا صالح بن مسلم العجلي: لقد نزلوا هذا المسجد ناس وهم أبغض إلي من كناسة أهلي، قيل: ومن هم يا أبا عمرو؟ قال: هؤلاء الرائيون أرأيت أرأيت.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي مريم، أبو الخليل البصري(@)(@@) يروي عن عبد الله بن الحارث بن نوفل، روى عنه قتادة، وأيوب.(@)(@@)(@@)(@@) ||| AUTO صالح بن مسلم بن رومان(@)(@@) يروي عن ابن الزبير، روى عنه يونس بن محمد المؤدب.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبيد(@)(@@) يروي عن نابل، صاحب العباء، عن أبي هريرة، روى عنه عمرو بن الحارث المصري.(@)(@@)(@@)(@@) ||| AUTO صالح بن الوليد الرياحي(@)(@@) يروي عن جدته، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 450] [8603 [صالح بن زياد أبو محمد، بصري، يروي عن عمرو بن دينار، روى عنه أبو الخطاب زياد بن يحيى الحسان.(@)(@@)(@@)(@@) ||| AUTO صالح بن مسمار(@)(@@) يروي المراسيل، روى عنه معمر، وجعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO صالح بن هلال(@)(@@) يروي عن أبي المليح، روى عنه سوادة بن أبي الأسود.(@)(@@)(@@)(@@) ||| AUTO صالح بن مرداس، أبو خزيمة العبدي(@)(@@) يروي عن طاوس، روى عنه عبد الرحمن بن مهدي.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبد الأعلى التيمي(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه ابنه خلف بن صالح.(@)(@@)(@@)(@@) ||| AUTO صالح بن معبد الجرمي(@)(@@) يروي عن الشعبي، روى عنه محمد بن ربيعة، والكوفيون، وهو الذي روى عنه وكيع، 
ms1022	 قال: سألت الشعبي عن رجل قال لرجل: يا معفوج، قال: ليس عليه حد، يعزر.(@)(@@)(@@)(@@) ||| AUTO صالح بن محرز الحمصي(@)(@@) يروي عن أبي مصبح المقرئي، روى عنه محمد بن يوسف الفريابي.(@)(@@)(@@)(@@) ||| AUTO صدقة بن صالح، أبو الزنباع الكوفي(@)(@@) يروي عن أبي الدهقان، عن عبد الله بن مسعود، روى عنه أبو حيان التيمي.(@)(@@)(@@)(@@) ||| AUTO صدقة بن سعيد الحنفي(@)(@@) كوفي، يروي عن جميع بن عمير، روى عنه عبد الواحد بن زياد.(@)PageV01P002(@)(@@) [ج 3: ص 451](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صدقة بن المثنى النخعي(@)(@@) يروي عن جده رياح بن الحارث، روى عنه عمر بن عبيد الطنافسي، والكوفيون.(@)(@@) صدقة(@)(@@) يروي عن أبي الأحوص عوف بن مالك بن نضلة، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO صدقة بن خالد، أبو العباس القرشي الدمشقي(@)(@@) يروي عن الشاميين، روى عنه هشام بن عمار، كان مولده سنة ثمان عشرة ومائة، ومات سنة ثمانين ومائة، وكان مولى أم البنين أخت معاوية بن يزيد بن معاوية.(@)(@@)(@@)(@@) ||| AUTO صدقة بن أبي عمران(@)(@@) قاضي الأهواز، يروي عن عون بن أبي جحيفة، روى عنه أبو أسامة، ومحمد بن بكر الكوفي، وسعدان بن يحيى الدمشقي.(@)(@@)(@@)(@@) ||| AUTO صدقة القرشي أبو محمد(@)(@@) يروي عن سليمان بن يسار، روى عنه عمرو بن يونس اليمامي.(@)(@@)(@@)(@@) ||| AUTO صدقة الشعباني(@)(@@) يروي عن الحسن بن عمارة، والأعمش، روى عنه عمران بن أبي عمران.(@)(@@)(@@)(@@) ||| AUTO صدقة، أبو الهذيل(@)(@@) يروي عن السدي، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO صدقة بن ميمون(@)(@@) يروي عن نافع، عن ابن عمر، روى عنه الحسن بن يحيى الخشني، يعتبر بحديثه إذا روى عنه غير الخشني.(@)PageV01P002(@)(@@) [ج 3: ص 452](@)(@@)(@@)(@@) ||| AUTO صدقة بن عبد الله بن كثير القرشي(@)(@@) يروي عن الزهري، روى عنه ابن عيينة، أحسبه الأول.(@)(@@)(@@)(@@) ||| AUTO صدقة بن طيسلة(@)(@@) يروي عن معن بن ثعلبة المازني، عن الأعشى المازني، وله صحبة، روى عنه أبو معشر البراء يوسف بن يزيد.(@)(@@)(@@)(@@) ||| AUTO صدقة، أبو سهل(@)(@@) بصري، يروي عن ابن سيرين، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO صدقة بن سهل(@)(@@) يروي عن كثير أبي الفضل الطفاوي، روى عنه 
ms1023	 مسلم بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO صفوان بن سليم(@)(@@) مولى حميد بن عبد الرحمن بن عوف القرشي، من أهل المدينة، يروي عن عطاء بن يسار، ونافع، روى عنه مالك، وابن عيينة، كنيته أبو عبد الله، مات سنة اثنتين وثلاثين ومائة، وكان من عباد أهل المدينة وزهادهم.(@)(@@)(@@)(@@) ||| AUTO صفوان بن عمرو بن هرم السكسكي(@)(@@) من أهل الشام، كنيته أبو عمرو، وأمه الهجرس بنت عوسجة بن أبي ثوبان، يروي عن راشد بن سعيد، وقد قيل: إنه أدرك أبا أمامة وهو صغير، روى عنه ابن المبارك، والوليد بن مسلم، مات سنة خمس وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO صفوان بن قبيصة، أبو قبيصة(@)(@@) يروي عن طارق بن شهاب إن كان سمع منه، روى عنه أمي الصيرفي.(@)PageV01P002(@)(@@) [ج 3: ص 453](@)(@@)(@@)(@@) ||| AUTO صفوان بن أبي عياش(@)(@@) يروي عن أمه، خادم عثمان بن عفان، روى عنه ابنه عبد الواحد بن صفوان.(@)(@@)(@@)(@@) ||| AUTO صفوان بن موهب(@)(@@) يروي عن مسلم بن عقيل، روى عنه عطاء، وعمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO صفوان بن سعد بن حذيفة بن اليمان(@)(@@) يروي المقاطيع، روى عنه أبو بكر بن عياش.(@)(@@)(@@)(@@) ||| AUTO صفوان بن أبي يزيد(@)(@@) وقد قيل: صفوان بن يزيد، يروي عن حصين بن اللجلاج، عن أبي هريرة، روى عنه محمد بن عمرو بن علقمة.(@)(@@)(@@)(@@) ||| AUTO صفوان بن عبد الله المكي(@)(@@) يروي عن مولى لعمر بن الخطاب، روى عنه أبو هانئ الخولاني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الصلت بن غالب الهجيمي(@)(@@) يروي عن مسلم، عن أبي هريرة، روى عنه يونس بن عبيد.(@)(@@)(@@)(@@) ||| AUTO الصلت بن عبد الله بن الحارث الهاشمي(@)(@@) يروي عن أبيه، روى عنه ابن إسحاق، وهو أخو إسحاق بن عبد الله بن الحارث.(@)(@@) الصلت(@)(@@) مولى سويد بن منجوف السدوسي، يروي المراسيل، روى عنه ثور بن يزيد الشامي.(@)(@@)(@@)(@@) ||| AUTO الصلت بن مسلم(@)(@@) يروي عن الحسن، روى عنه ابن إسحاق.(@)PageV01P002(@)(@@) [ج 3: ص 454](@)(@@)(@@)(@@) ||| AUTO الصلت بن راشد(@)(@@) يروي عن طاوس، ومجاهد، روى عنه حماد بن زيد، وأبان بن يزيد العطار.(@)(@@)(@@)(@@) ||| AUTO الصلت بن بهرام(@)(@@) كوفي، عزيز الحديث، يروي عن جماعة من التابعين، روى عنه 
ms1024	 أهل الكوفة، وهو الذي يروي عن الحسن، روى عنه محمد بن بكر، المقرئ الكوفي، ليس بالبرساني، ومن قال: إنه الصلت بن مهران فقد وهم، إنما هو الصلت بن بهرام.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الصلت بن الحجاج(@)(@@) كوفي، يروي عن جماعة من التابعين، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الصلت المكي(@)(@@) يروي عن ابن أبي رافع، روى عنه حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO الصلت بن زبيد بن الصلت الكندي(@)(@@) من أهل المدينة، يروي عن سليمان بن يسار، روى عنه عبد العزيز بن أبي سلمة الماجشون.(@)(@@)(@@)(@@) ||| AUTO الصلت بن طريف المعولي(@)(@@) بصري، يروي عن الحسن، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO الصلت بن عبد الرحمن الأنصاري(@)(@@) يروي المراسيل، روى عنه أبو بكر بن نافع.(@)(@@) الصلت بن الحجاج(@)(@@) يروي عن عاصم الأحول، روى عنه يحيى بن سعيد العطار الحمصي.(@)(@@)(@@)(@@) ||| AUTO الصلت بن سالم(@)(@@) يروي عن سليمان بن ثعلبة، روى عنه موسى بن يعقوب الزمعي.(@)PageV01P002(@)(@@) [ج 3: ص 455](@)(@@)(@@)(@@) ||| AUTO الصلت الربعي(@)(@@) يروي المقاطيع، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO صخر بن الوليد الفزاري(@)(@@) كوفي، يروي عن عمرو بن صليع، عن علي، روى عنه إسماعيل بن أبي رجاء، والحارث بن حصيرة.(@)(@@)(@@)(@@) ||| AUTO صخر بن بدر العجلي(@)(@@) يروي عن سبيع بن خالد، روى عنه أبو التياح يزيد بن حميد.(@)(@@)(@@)(@@) ||| AUTO صخر بن عبد الله بن بريدة الأسلمي(@)(@@) يروي عن أبي جعفر محمد بن علي، وعكرمة، روى عنه الحجاج بن حسان.(@)(@@)(@@)(@@) ||| AUTO صخر بن عبد الله بن حرملة المدلجي(@)(@@) يروي عن أبي سلمة، وعامر بن عبد الله بن الزبير، روى عنه بكر بن مضر.(@)(@@)(@@)(@@) ||| AUTO صخر بن عبد الله الأيلي(@)(@@) يروي المقاطيع، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO صخر بن جويرية(@)(@@) مولى بني تميم، من أهل البصرة، كنيته أبو نافع، يروي عن نافع، روى عنه ابن المبارك، ويحيى القطان.(@)(@@)(@@)(@@) ||| AUTO صخر بن مالك(@)(@@) يروي المراسيل، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO الصباح بن ثابت البجلي(@)(@@) يروي عن الشعبي، روى عنه حفص بن غياث.(@)PageV01P002(@)(@@) [ج 3: ص 456](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الصباح بن عبيد الله(@)(@@) يروي عن 
ms1025	 إبراهيم النخعي، روى عنه حنش بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الصباح بن مجاهد بن جبير(@)(@@) مولى عبد الله بن السائب القرشي، أخو عبد الوهاب بن مجاهد، يروي عن الحجازيين، روى عنه محمد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO الصباح العبدي(@)(@@) يروي عن عبد الله بن سليمان، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO الصباح بن عبد الرحمن التيمي(@)(@@) يروي المراسيل، روى عنه أهل الحجاز.(@)(@@) الصباح(@)(@@) شيخ يروي عن الحسن، وأشرس، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO صهيب(@)(@@) شيخ يروي عن الحسن، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO صبيح بن عبد الله(@)(@@) يروي عن عبد الله بن عامر بن كريز، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO صبيح بن القاسم، أبو الجهم(@)(@@) مولى عبس، يروي عن سعيد بن جبير، روى عنه عبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO صبيح، أبو المليح المدني(@)(@@) يروي عن أبي صالح، روى عنه مروان بن معاوية الفزاري، وأبو عاصم.(@)(@@)(@@)(@@) ||| AUTO صعصعة بن مالك(@)(@@) شيخ يروي المراسيل، روى عنه ابن أخيه ضابئ بن بشار، وقد روى صعصعة هذا عن أبي هريرة، وما أظنه لقيه.(@)PageV01P002(@)(@@) [ج 3: ص 457](@)(@@)(@@)(@@) ||| AUTO صعصعة(@)(@@) شيخ يروي عن نافع بن جبير، قوله، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO صعب بن زيد(@)(@@) عم جرير بن حازم الأزدي، يروي عن عبيد الله بن زياد، روى عنه حماد بن زيد، وجرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO صيفي بن ربعي(@)(@@) يروي عن عبد الله بن عمر، روى عنه الحسين بن يزيد الطحان، وأبو كريب، وأهل الكوفة، يخطئ.(@)(@@)(@@)(@@) ||| AUTO صيفي بن هلال(@)(@@) كان يقرأ كتب الأوائل، روى عنه يونس بن عبيد.(@)(@@)(@@)(@@) ||| AUTO صيفي، أبو أشعث(@)(@@) مولى الأنصار، من أهل المدينة، يروي عن أبي السائب، مولى هشام بن زهرة، روى عنه ابن عجلان، ومالك، وهو صيفي مولى أفلح.(@)(@@)(@@)(@@) ||| AUTO صبيح بن العلاء(@)(@@) يروي عن عمار بن أبي عمار، عن عبد الرحمن بن سمرة، روى عنه محمد بن عبد الملك بن أبي الشوارب.(@)(@@)(@@)(@@) ||| AUTO صاعد بن محمد(@)(@@) يروي عن أبي عبيدة بن عقبة بن نافع، روى عنه نافع بن يزيد.(@)(@@)(@@)(@@) ||| AUTO صاعد بن مسلم(@)(@@) يروي عن الشعبي، روى 
ms1026	 عنه عيسى بن يونس، وهو صاعد بن مسلم اليشكري الكوفي.(@)(@@)(@@)(@@) ||| AUTO صبي بن أشعث بن سالم السلولي(@)(@@) من أهل الكوفة، يروي عن عطية العوفي، وأبي إسحاق السبيعي، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO صحار بن عائذ الطائي(@)(@@) قال: سمعت الحسن في طريق مكة، وهو يحدو: يا PageV01P002 [ج 3: ص 458] فالق الإصباح، أنت ربي، وأنت مولاي، وأنت حسبي، فأصلح باليقين قلبي، ونجني من كرب يوم الكرب.(@)(@@) (341) -[3: 458] حدثنا محمد بن إسحاق الثقفي، ثنا عمرو بن شيبة، قال: ثنا زاجر بن الصلت، قال: ثنا أبو الصلت، عن حوشب، عن صحار بن عائذ، قال: لقيت الحسن في طريق مكة، وكان يحدو، وقد ذكره.(@)(@@)(@@)(@@) ||| AUTO صلهب الكوفي(@)(@@) يروي عن عمه: المقاطيع، روى عنه أبو بكر بن عياش.(@)(@@)(@@)(@@) ||| AUTO صبيح، أبو الوسيم(@)(@@) من أهل البصرة، يروي عن عقبة بن صهبان، عن أبي هريرة، روى عنه عمير بن عبد المجيد.(@)(@@)(@@)(@@) ||| AUTO صبيح، أبو العلاء(@)(@@) يروي عن شريح، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO صرد بن أبي المنازل(@)(@@) من أهل البصرة، يروي عن حبيب بن أبي فضالة، عن عمران بن حصين، روى عنه محمد بن عبد الله الأنصاري.(@)(@@)(@@)(@@) ||| AUTO صمصوم(@)(@@) أخو الزبيدي، يروي عن الزهري، روى عنه بقية.(@)(@@) (342) -[3: 458] حدثنا القطان، قال: ثنا موسى بن مروان، قال: ثنا بقية بن الوليد، عن صمصوم، أخو الزبيدي، قال: ثنا الزهري، عن سالم، عن ابن عمر، أنه كان يمشي أمام الجنازة، قال: كان رسول الله صلى الله عليه وسلم وأبو بكر، وعمر يمشون أمام الجنازة. له حديثان هذا واحد، والآخر: عصابتان من أمتي يدخلون الجنة. الحديث(@)(@@)(@@)(@@) ||| AUTO صلب بن عبد الرحمن(@)(@@) قوله، روى عنه ابن عجلان.(@)(@@)(@@)(@@) ||| AUTO الصعق بن حزن بن قيس العيشي، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن الحسن، وقتادة، روى عنه سليمان بن حرب، وشيبان بن فروخ، والبصريون.(@)(@@)(@@)(@@) ||| AUTO الصقعب بن زهير الأزدي(@)(@@) بصري، يروي عن زيد بن أسلم، وعطاء بن PageV01P002 [ج 3: ص 459] يسار، عن ابن عمر في الزجر عن ثياب الديباج. روى عنه جرير بن حازم، وحماد 
ms1027	 بن زيد، وهو أخو العلاء بن زهير الأزدي.(@)(@@)(@@)(@@) ||| AUTO صفية بنت عليبة(@)(@@) تروي عن جدتها زيدة بنت قيلة، عن أمها قيلة بنت مخرمة بن قرط، روى عنها كثير بن قيس بن الصلت العنبري.(@)(@@)(@@)(@@) || AUTO باب الضاد(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن أتباع التابعين ممن ابتدأ اسمه على الضاد:(@)(@@)(@@)(@@) ||| AUTO الضحاك بن مزاحم الهلالي(@)(@@) من بني هلال بن عامر بن صعصعة، كنيته أبو القاسم، وقد قيل: أبو محمد، لقي جماعة من التابعين، ولم يشافه أحدا من أصحاب رسول الله صلى الله عليه وسلم ومن زعم أنه لقي ابن عباس فقد وهم.(@)(@@) (343) -[3: 459] حدثنا محمد بن المسيب، قال: ثنا إسحاق بن منصور، قال: ثنا أبو داود الطيالسي، قال: ثنا شعبة، عن عبد الملك بن ميسرة، قال: لم يلق الضحاك ابن عباس، إنما لقي سعيد بن جبير بالري، فأخذ عنه التفسير.(@)(@@) (344) -[3: 459] حدثنا محمد بن إسحاق الثقفي، قال: ثنا أبو سعيد الأشج، قال: ثنا أبو أسامة، عن شعبة، عن عبد الملك بن ميسرة، قال: قلت للضحاك: سمعت من ابن عباس؟ قال: لا، قلت: فهذا الذي تحدث به عمن أخذته، قال: عن ذا وعن ذا. قال أبو حاتم: كان أصل الضحاك بن مزاحم من بلخ، وكان يقيم بها مدة وبسمرقند مدة وببخارى مدة، وهم إخوة ثلاثة: مسلم، ومحمد، والضحاك، ومات الضحاك سنة ثنتين ومائة، وقد قيل: سنة خمس ومائة، وكانت أمه حاملة به سنتين، وولد وله أسنان، وكان الضحاك معلم كاتب، يعلم الصبيان ولا يأخذ منهم شيئا، ورواية أبي إسحاق السبيعي، عن الضحاك، قال: قلت لابن عباس، وهم من شريك، عن أبي إسحاق.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن عثمان بن عبد الله بن خالد بن حزام(@)(@@) ابن أخي PageV01P002 [ج 3: ص 460] حكيم بن حزام القرشي، أبو عثمان، من أهل المدينة، يروي عن نافع، روى عنه الثوري، وابن أبي فديك، مات سنة ثلاث وخمسين ومائة، كنيته أبو عثمان، وأمه من بني عامر.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن زميل(@)(@@) يروي عن بنت عم له، عن ابن عباس، روى عنه 
ms1028	 عياش بن عباس.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن المنذر بن جرير بن عبد الله البجلي(@)(@@) عداده في أهل الكوفة، يروي عن أبيه، عن جرير، روى عنه أبو حيان التيمي.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن علي(@)(@@) يروي عن أبيه، عن علي، روى عنه الكوفيون، لست أدري من علي هذا.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن عبد الرحمن بن أبي حوشب(@)(@@) يروي عن الشاميين، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن ميمون الثقفي(@)(@@) يروي عن علي بن زيد بن جدعان، روى عنه عمرو بن علي الفلاس، وإسحاق بن أبي إسرائيل، مات سنة اثنتين وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن يسار(@)(@@) من أهل البصرة، يروي عن أبي تميمة الهجيمي، وأبي العلاء بن الشخير، روى عنه وكيع، والحوضي.(@)(@@)(@@)(@@) ||| AUTO أبو عاصم النبيل، اسمه الضحاك بن مخلد بن الضحاك PageV01P002 [ج 3: ص 461](@)(@@) مولى بني شيبان، من أهل البصرة، يروي عن يزيد بن أبي عبيد، عن سلمة بن الأكوع، وقد سمع من ابن جريج، والثوري، وشعبة، روى عنه أحمد بن حنبل، ويحيى بن معين، كان مولده سنة ثنتين وعشرين ومائة، ومات سنة ثنتي عشرة ومائتين ليلة الخميس لأربع عشرة ليلة خلت من ذي الحجة.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن فائد(@)(@@) يروي عن الزهري، روى عنه عباس بن أبي شملة.(@)(@@)(@@)(@@) ||| AUTO الضحاك بن حمرة الأملوكي(@)(@@) من أهل الشام، يروي عن الشاميين، روى عنه أبو بكر بن أبي مريم الغساني.(@)(@@)(@@)(@@) ||| AUTO ضرار بن مرة، أبو سنان الشيباني(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، وعبد الله بن أبي الهذيل، روى عنه شعبة، وأهل العراق، وكان عابدا، مات سنة اثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO ضابي بن بشار(@)(@@) يروي عن عمه صعصعة بن مالك، عن أبي هريرة، أنه كان سمع منه، روى عنه جعفر بن حيان.(@)(@@)(@@)(@@) ||| AUTO ضمضم بن عبد الله بن أبي الطفيل القيسي(@)(@@) يروي(@)(@@) (345) -[3: 461] عن عبد الأعلى، عن ابن عمر، وحذيفة، عن النبي صلى الله عليه وسلم قال: يخرج المسيح الدجال من يهودية أصفهان. حدثنا الحسن بن سفيان، قال: ثنا أبو الأشعث العجلي، قال: ثنا عمرو بن يونس، 
ms1029	 قال: ثنا ضمضم، ولكني لست أدري من عبد الأعلى هذا.(@)(@@)(@@)(@@) ||| AUTO ضمضم بن زرعة الحضرمي(@)(@@) من أهل حمص، يروي عن شريح بن عبيد، روى عنه إسماعيل بن عياش.(@)PageV01P002(@)(@@) [ج 3: ص 462](@)(@@)(@@)(@@) ||| AUTO ضرغامة بن عليبة بن حرملة العنبري(@)(@@) يروي عن أبيه، عن جده، روى عنه قرة بن خالد السدوسي.(@)(@@)(@@)(@@) ||| AUTO ضمام بن إسماعيل بن مالك المعافري(@)(@@) من أهل مصر، كنيته أبو شريح، وقد قيل: أبو إسماعيل، يروي عن أبي قبيل، وموسى بن وردان، روى عنه يحيى بن بكير، وسويد بن سعيد، وأهل مصر، كان مولده سنة سبع وتسعين، وتوفي سنة خمس وثمانين ومائة، وكان يخطئ.(@)(@@)(@@)(@@) ||| AUTO ضبثم الضبي(@)(@@) يروي عن الكوفيين، روى عنه ابن أخيه محمد بن أبي يعقوب.(@)(@@)(@@)(@@) ||| AUTO ضيف بن يربوع(@)(@@) يروي عن موهب، خادم عبد الرحمن بن سمرة، روى عنه بشر بن السري.(@)(@@)(@@)(@@) ||| AUTO ضبيب بن العلاء الضبي(@)(@@) قال: سألت قتادة عن رجل طلق امرأته سرا، وجحدها في العلانية، قال: لا يأتيها إلا وهي كارهة. روى عنه أحمد بن عبد الله العداني.(@)(@@)(@@)(@@) ||| AUTO ضيغم بن مالك، أبو مالك الراسبي العابد(@)(@@) يروي عن مالك بن دينار، روى عنه ابنه مالك بن ضيغم، أخباره في العبادة مشهورة يستغنى بشهرتها عن الاستغراق فيها.(@)(@@)(@@)(@@) || AUTO باب الطاء(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين، من أهل الصدق ممن ابتدأ اسمه على الطاء:(@)(@@)(@@)(@@) ||| AUTO طلحة بن يحيى بن طلحة بن عبيد الله التيمي القرشي(@)(@@) عداده(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 3: ص 463] في أهل الكوفة، يروي عن عمه عيسى بن طلحة، وعمته عائشة بنت طلحة، روى عنه سفيان الثوري، وكان يخطئ، مات سنة ست وأربعين ومائة، وقد قيل: إنه رأى ابن عمر، وليس عليه اعتماد.(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الملك الأيلي(@)(@@) يروي عن القاسم بن محمد، روى عنه عبيد الله بن عمر، ومالك بن أنس.(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الله الكندي(@)(@@) يروي المراسيل، روى عنه موسى الجهني.(@)(@@)(@@)(@@) ||| AUTO طلحة بن أبي قنان(@)(@@) يروي المراسيل، روى عنه الوليد بن سليمان بن أبي السائب.(@)(@@)(@@)(@@) ||| AUTO طلحة 
ms1030	 بن الشحاج(@)(@@) يروي عن ورقاء بنت هذاب، روى عنه أبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO طلحة بن الأعلم، أبو الهيثم الحنفي(@)(@@) يروي عن الشعبي، روى عنه الثوري، ومروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO طلحة بن حسين، أبو خلف العنبري(@)(@@) يروي عن الشعبي، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO طلحة بن قيس(@)(@@) يروي عن الحسن، روى عنه موسى بن إسماعيل.(@)(@@) طلحة(@)(@@) مولى آل سراقة، يروي عن معاوية بن عبد الله بن جعفر، عن عبد الله بن جعفر، روى عنه العطاف بن خالد.(@)(@@)(@@)(@@) ||| AUTO طلحة القناد، أبو حماد الكوفي(@)(@@) يروي عن الشعبي، روى عنه وكيع بن PageV01P002 [ج 3: ص 464] الجراح، وعبدة بن سليمان، وهو جد عمرو بن حماد بن طلحة القناد.(@)(@@)(@@)(@@) ||| AUTO طلحة الضبعي(@)(@@) يروي عن جابر بن زيد، روى عنه قرة بن خالد.(@)(@@)(@@)(@@) ||| AUTO طلحة بن عبد الرحمن القناد(@)(@@) من أهل البصرة، يروي عن قتادة، روى عنه القاسم بن عيسى الطائي، وليس هذا بالأول.(@)(@@)(@@)(@@) ||| AUTO طلحة بن النضر(@)(@@) يروي عن ابن سيرين، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO طلحة بن زيد(@)(@@) يروي عن أبي قلابة، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO طلحة بن أبي سعيد المصري(@)(@@) يروي عن سعيد المقبري، روى عنه ابن المبارك، والليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO طلحة بن سليمان(@)(@@) يروي عن سالم بن عبد الله، روى عنه وهب بن جرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO طلحة بن إياس(@)(@@) يروي المقاطيع، وقد روى عن أنس بن مالك، ولم يره، عداده في أهل مرو، روى عنه الحسين بن واقد.(@)(@@)(@@)(@@) ||| AUTO طارق بن عبد الرحيم(@)(@@) قال: شهدت الشعبي ضرب نصرانيا قذف مسلما ثمانين. روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO طارق بن أبي الحسناء(@)(@@) يروي عن الحسن، روى عنه الأعمش،(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 3: ص 465] أحسب أن اسم أبيه: عبد الرحمن، لأن الأعمش روى عن طارق بن عبد الرحمن، عن سعيد بن جبير: أحرفا يسيرة.(@)(@@) طارق بن عبد الرحمن(@)(@@) يروي عن زاذان، عن أبي هريرة: أوصاني خليلي بثلاث. الحديث. روى عنه ابن المبارك، ثنا ابن مكرم، قال: ثنا محمد بن علي الشقيقي، قال: سمعت أبي، 
ms1031	 يقول: حدثنا عبد الله بن المبارك، بهذا.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO طريف بن الدفاع الحنفي(@)(@@) يروي عن إسحاق بن عبد الله بن أبي طلحة، روى عنه عمر بن يونس اليمامي.(@)(@@) طريف(@)(@@) شيخ يروي عن المصريين، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO طلق بن جعبان(@)(@@) يروي عن عبد الرحمن بن أبي أمية، عن ابن عمر، روى عنه موسى بن علي بن رباح.(@)(@@)(@@)(@@) ||| AUTO طلق بن معاوية النخعي(@)(@@) يروي عن أبي زرعة بن عمرو بن جرير، روى عنه ابن ابنه حفص بن غياث.(@)(@@) (346) -[3: 465] حدثنا أحمد بن مكرم بن خالد اليشكري، ببغداد، قال: ثنا علي بن المدني، قال: ثنا حفص بن غياث، قال: سمعت طلق بن معاوية، يحدث عن أبي زرعة بن عمرو، عن أبي هريرة، أن امرأة أتت النبي صلى الله عليه وسلم بصبي لها، فقالت: يا رسول الله، ادع الله له قد دفنت ثلاثة، فقال: احتظرت بحظار شديد من النار.(@)(@@)(@@)(@@) ||| AUTO طلق البصري(@)(@@) يروي المقاطيع، روى عنه المختار بن فلفل.(@)(@@)(@@)(@@) ||| AUTO طالب بن حبيب بن سهل بن قيس(@)(@@) يروي عن عبد الرحمن بن جابر بن عبد الله، وكان جده ضجيع حمزة بن عبد المطلب، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO طالب بن سلم بن عاصم بن الحكم(@)(@@) يروي عن بعض أهله، عن جده وله صحبة، روى عنه أبو عاصم النبيل.(@)PageV01P002(@)(@@) [ج 3: ص 466](@)(@@)(@@)(@@) ||| AUTO طالب بن سلمى(@)(@@) يروي عن الحسن، روى عنه عبد الرحمن بن مهدي، كأنه الأول إن شاء الله.(@)(@@)(@@)(@@) ||| AUTO طعمة بن غيلان الجعفي(@)(@@) يروي عن الشعبي، روى عنه الثوري، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO طعمة بن عمرو الجعفري العامري(@)(@@) من أهل الكوفة، يروي عن موسى بن طلحة، روى عنه وكيع، ومالك بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO طعمة بن ثابت(@)(@@) يروي عن الحسن، روى عنه نوح بن قيس.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الطيب بن محمد(@)(@@) يروي عن عطاء، روى عنه أيوب السختياني.(@)(@@)(@@)(@@) ||| AUTO الطيب بن سلمان(@)(@@) يروي عن عمرة، قالت:(@)(@@) (347) -[3: 466] سمعت عائشة، تقول: نهى رسول الله صلى الله عليه وسلم عن اتباع النساء الجنائز، وقال: ليس لهن في 
ms1032	 ذلك أجر. ثنا السختياني، قال: ثنا شيبان بن فروخ، قال: ثنا طيب بن سلمان، قال: سمعت عمرة، تقول: سمعت عائشة.(@)(@@) الطيب(@)(@@) شيخ يروي عن سعيد بن جبير، روى عنه سلام بن أبي مطيع، أحسبه الأول.(@)(@@)(@@)(@@) ||| AUTO الطيب بن زبان الكناني(@)(@@) من أهل فلسطين، يروي عن زياد بن سيار، عن أبي قرصافة، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO طالوت بن أبي الحجاج القرشي البصري(@)(@@) يروي عن الحسن، وثابت، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 467](@)(@@)(@@)(@@) ||| AUTO طليق بن عمران بن حصين(@)(@@) يروي عن أبي بردة، عن أبي موسى، روى عنه إبراهيم بن إسماعيل بن مجمع.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الطفيل بن أبي الطفيل(@)(@@) يروي عن ابن سيرين، روى عنه علي بن عاصم.(@)(@@) الطفيل(@)(@@) شيخ يروي عن صعصعة بن ناجية، روى عنه عباد بن كسيب.(@)(@@)(@@)(@@) ||| AUTO طليق بن شمير(@)(@@) يروي عن الشاميين، روى عنه حريز بن عثمان.(@)(@@)(@@)(@@) ||| AUTO طوف بن وهب الطائي(@)(@@) يروي عن أبي نضرة، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) || AUTO باب الظاء(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين ممن ابتدأ اسمه على الظاء:(@)(@@)(@@)(@@) ||| AUTO ظبيان(@)(@@) مولى عمير، من أهل الكوفة، يروي عن سعيد بن جبير، روى عنه عيسى بن يونس.(@)PageV01P002(@)(@@) [ج 4: ص 3](@)(@@)(@@)(@@) || AUTO باب العين(@)(@@) قال أبو حاتم رضي الله تعالى عنه:(@)(@@) وممن روى عن التابعين ممن ابتدأ اسمه على العين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حسن بن حسن بن علي بن أبي طالب الهاشمي(@)(@@) يروي عن أبيه، عن فاطمة بنت الحسين، روى عنه إسماعيل بن علية، وعبد الرحمن بن أبي الموالي، مات في حبس أبي جعفر المنصور بالهاشمية قبل ابنه بأشهر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن عبد الله بن عمر بن الخطاب(@)(@@) من أهل المدينة، يروي عن سالم بن عبد الله، روى عنه أبو صخر حميد بن صخر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محمد بن عمر بن علي بن أبي طالب الهاشمي(@)(@@) يروي عن أبيه، عن علي، روى عنه ابن المبارك، وأهل المدينة، كنيته أبو محمد، أمه صفية 
ms1033	 بنت علي بن الحسين، مات بالمدينة في ولاية أبي جعفر، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محمد بن علي بن أبي طالب الهاشمي(@)(@@) أخو الحسن بن محمد، كنيته أبو هاشم من أهل المدينة، يروي عن أبيه، عن علي، روى عنه الزهري، مات بالشام في ولاية سليمان بن عبد الملك.(@)PageV01P002(@)(@@) [ج 4: ص 4](@)(@@)(@@)(@@) ||| AUTO عبد الله بن علي بن الحسين بن علي بن أبي طالب(@)(@@) يروي عن أبيه، وأهل المدينة، روى عنه أهلها عمارة بن غزية، وغيره، أمه أم عبد الله بنت الحسن بن علي بن أبي طالب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عروة بن الزبير بن العوام(@)(@@) أخو هشام بن عروة، يروي عن أبيه عروة، روى عنه أخوه هشام بن عروة، والزهري، كنيته أبو بكر، أمه فاختة بنت الأسود بن أبي البخترى بن هشام بن الحارث بن أسد بن عبد العزى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن علقمة المكي(@)(@@) يروي عن عبد الله بن عثمان بن خثيم، روى عنه عيسى بن يونس السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن كعب بن مالك الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه عبد الله بن محمد بن عقيل، وعاصم بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عون بن أرطبان(@)(@@) مولى مزينة من أهل البصرة، كنيته أبو عون، رأى أنسا، ولم يسمع منه شيئا، يروي عن القاسم، والحسن، وابن سيرين، روى عنه ابن المبارك، وأهل البصرة، وكان مولده سنة ست وستين قبل الجارف بثلاث سنين، ومات سنة إحدى وخمسين ومائة وهو ابن خمس وثمانين سنة، وصلى عليه جميل بن محفوظ الأزدي وكان والى البصرة، وقد قيل: إنه مولى عبد الله بن سراقة، وكان عبد الله بن عون من سادات أهل زمانه عبادة، وفضلا، وورعا، ونسكا، وصلابة في السنة، وشدة على أهل البدع، وكان أكبر من التيمي، وأيوب، بينه وبين أيوب سنة واحدة.(@)(@@) (348) -[4: 4] حدثنا مكحول، قال: ثنا الحسن بن أبي أمية، قال: ثنا يزيد بن هارون، قال: ثنا ابن عون، قال: " رأيت على أنس 
ms1034	 بن مالك جبة خز وعمامة خز ومطرف خز "(@)PageV01P002(@)(@@) [ج 4: ص 5](@)(@@)(@@)(@@) ||| AUTO عبد الله بن طاوس بن كيسان الخولاني(@)(@@) من أهل اليمن، مولاهم قيل: إنه من ولد النمر بن قاسط، كنيته أبو محمد، يروي عن أبيه، وعكرمة بن خالد، روى عنه الثوري، وابن عيينة، مات في سنة ثنتين وثلاثين ومائة بعد أيوب بسنة، وكان من خيار عباد الله فضلا ونسكا ودينا.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زرارة بن مصعب بن شيبة القرشي(@)(@@) يروي عن أبيه، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعيد بن جبير(@)(@@) مولى والبة الأسدي، أخو عبد الملك بن سعيد، يروي عن أبيه، روى عنه أيوب السختياني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن عثمان(@)(@@) يروي عن أبي عمرة الأنصاري، عن زيد بن خالد الجهني، روى عنه أبو بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي نجيح الثقفي(@)(@@) مولى لآل الأخنس، واسم أبي نجيح يسار، وكنية عبد الله أبو يسار، يروي عن عطاء، وطاوس، روى عنه ورقاء بن عمر اليشكري، وأهل الحجاز، مات سنة إحدى أو اثنتين وثلاثين ومائة، قال يحيى القطان: لم يسمع التفسير بن أبي نجيح من مجاهد، قال أبو حاتم: ابن أبي نجيح، وابن جريج نظرا في كتاب القاسم بن أبي بزة، عن مجاهد في التفسير، فرويا عن مجاهد من غير سماع.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سلمان الأغر(@)(@@) أخو عبيد الله بن سلمان من أهل المدينة، يروي عن أبيه، عن أبي هريرة، روى عنه صفوان بن سليم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شبرمة بن الطفيل بن عمرو بن ضرار بن عمرو بن زيد بن مالك بن زيد بن كعب بن ذهل بن مالك بن بكر بن سعد بن ضبة الضبي PageV01P002 [ج 4: ص 6](@)(@@) من أهل الكوفة، أبو شبرمة، يروي عن الشعبي، وأبي زرعة بن عمرو بن جرير، وقد رأى بن سيرين بواسط، روى عنه شعبة، وأهل العراق، مات سنة أربع وأربعين ومائة، وكان من فقهاء أهل العراق، وهو عم عمارة بن القعقاع بن شبرمة. 
ms1035	(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قرط شامي(@)(@@) يروي عن عطاء بن يسار، روى عنه يحيى بن أيوب التجيبي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عامر بن شراحيل الشعبي(@)(@@) من أهل الكوفة، يروي عن أبيه، والحسن، روى سلام بن مسكين، عن شيخ له عنه.(@)(@@)(@@)(@@) ||| AUTO أبو الزناد اسمه عبد الله بن ذكوان(@)(@@) من أهل المدينة، كنيته أبو عبد الرحمن، مولى رملة بنت شيبة بن ربيعة زوجة عثمان بن عفان، وكان ذكوان أخا أبي لؤلؤة قاتل عمر بن الخطاب، سمع أبو الزناد الأعرج، روى عنه مالك، والثوري، وأهل الحجاز، مات في رمضان سنة إحدى وثلاثين ومائة في آخرها، وكان فقيها صاحب كتاب، وقد قيل: إنه مات سنة ثلاثين ومائة، وكان له يوم مات ست وستون سنة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عراك بن مالك الغفاري المدني(@)(@@) يروي عن أبيه، روى عنه عيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله الرازي القرشي(@)(@@) كان على قضاء الري، يروي عن عبد الرحمن بن أبي ليلى، عن البراء بن عازب، وعن سعيد بن جبير، عن ابن عمر، روى عنه الأعمش.(@)PageV01P002(@)(@@) [ج 4: ص 7](@)(@@)(@@)(@@) ||| AUTO عبد الله بن المبارك(@)(@@) مولى بني حنظلة، من أهل مرو، كنيته أبو عبد الرحمن، يروي عن إسماعيل بن أبي خالد، وحميد الطويل، وعاصم الأحول، روى عنه أهل العراق، وخراسان، كان مولده سنة ثماني عشرة ومائة، ومات في رمضان منصرفا من طرسوس سنة إحدى وثمانين ومائة، وقبره بهيت مدينة على الفرات، مشهور يزار، والأخبار في مناقب ابن المبارك، وشمائله أشهر وأكثر من أن تذكر أو تحتاج إلى الإغراق في ذكرها، وكان ابن المبارك رحمه الله فيه خصال مجتمعة لم يجتمع في أحد من أهل العلم في زمانه في الدنيا كلها، كان فقيها، ورعا، عالما بالاختلاف، حافظا يعرف السنن، رحالا في جمع العلم، شجاعا ينازل الأقران، ويكابت الأبطال، أديبا يقول الشعر فيجيد، سخيا بما ملك من الدنيا، وكان إذا سافر يحمل سفرته على عجلة من كبرها فإذا نزل طرحها ثم يردها من احتاج إليه، وكان يقول: لولا فضيل 
ms1036	 ما اتجرت.(@)(@@) (349) -[4: 7] حدثنا ابن قتيبة، قال: ثنا ابن أبي السرى، قال: ثنا معتمر بن سليمان، قال: حدثنا ابن المبارك، عن الأوزاعي، قال: سألت يحيى بن سعيد، والزهري، وعطاء بن أبي رباح، عن " الرجل يجامع امرأته فيما دون الفرج فينزل فيسيل الماء حتى يدخل في الفرج، قالوا: عليها أن تغتسل "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك بن يخامر السكسكي(@)(@@) يروي عن أبيه، عن معاذ بن جبل، روى عنه سليمان بن موسى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحسن بن أبي الحسن البصري(@)(@@) يروي عن أبيه، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي المجالد(@)(@@) ختن مجاهد، يروي عن جماعة من التابعين، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إبراهيم القرشي(@)(@@) يروي عن مولى لهم، عن جابر بن عبد الله، روى عنه أيوب السختياني.(@)PageV01P002(@)(@@) [ج 4: ص 8](@)(@@)(@@)(@@) ||| AUTO عبد الله بن إبراهيم بن عبد الرحمن(@)(@@) مولى أم حبيبة، يروي عن جميلة مولاة أم حبيبة، روى عنه محمد بن راشد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن أبزى(@)(@@) أخو سعيد بن عبد الرحمن مولى خزاعة من أهل الكوفة، يروي عن أبيه، روى عنه أسلم المنقري، والأجلح.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أنيس(@)(@@) من أهل المدينة، يروي عن أمه وهى ابنة كعب بن مالك، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نعيم(@)(@@) يروي عن الضحاك بن عبد الرحمن بن عرزب، عن أبي موسى، روى عنه يحيى بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حريث(@)(@@) يروي عن الكوفيين، روى عنه أبو إسحاق الشيباني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد المعافري(@)(@@) يروي عن قبيصة بن ذؤيب، روى عنه بكير بن سوادة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إياس بن أبي مريم الحنفي(@)(@@) يروي عن أبيه، عن عثمان، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بكر بن محمد بن عمرو بن حزم(@)(@@) يروي عن عروة، وأهل المدينة، روى عنه الزهري، وهو يروي عن الزهري، كنيته أبو محمد، مات سنة خمس وثلاثين ومائة، وله يوم مات سبعون سنة. 
ms1037	(@)PageV01P002(@)(@@) [ج 4: ص 9](@)(@@)(@@)(@@) ||| AUTO عبد الله بن شوذب، كنيته أبو عبد الرحمن(@)(@@) أصله من البصرة، سكن الشام، يروي عن ثابت البناني، وأبي التياح، روى عنه ابن المبارك، وضمرة بن ربيعة، مات سنة ست وخمسين ومائة، وقد قيل: سنة أربع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الوليد المزني(@)(@@) من أهل مصر، يروي عن سعيد بن المسيب، ويروي عن أبي سليمان الليثي، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي أمية(@)(@@) يروي عن الحارث بن عبد الله بن أبي ربيعة، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن صبيح(@)(@@) يروي عن محمد بن سيرين، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الله بن يزيد الصهباني(@)(@@) من النخع كوفي، يروي عن همام بن الحارث، عن جرير، وعن أبي بردة بن أبي موسى، عن أبيه، روى عنه حفص بن سلمان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد بن هرمز المدني(@)(@@) مولى بني ليث، كنيته أبو بكر، يروي عن المدنيين، روى عنه مالك بن أنس، مات سنة ثمان وأربعين ومائة، وأبوه يزيد بن هرمز هو يزيد الفارسي، الذي روى عنه عوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسحاق(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه قدامة بن موسى.(@)(@@) عبد الله بن يزيد(@)(@@) مولى الأسود بن سفيان، يروي عن أبي سلمة، وأبي عياش الزرقي، روى عنه مالك، وأهل المدينة.(@)PageV01P002(@)(@@) [ج 4: ص 10](@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعيد بن أبي هند(@)(@@) مولى بني سهم، كنيته أبو بكر، يروي عن أبيه، والأعرج، روى عنه ابن المبارك، وإسماعيل بن جعفر، مات سنة سبع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن طلحة الخزاعي(@)(@@) يروي عن أبي يزيد المدني، روى عنه هشيم بن بشير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الأهتم(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه أهل الشام. عبد الله بن يزيد، رجل من بني سعد بن بكر، يروي عن سعيد بن المسيب، روى عنه سهيل بن أبي صالح.(@)(@@) (350) -[4: 10] حدثنا أبو يعلى بالموصل، قال: ثنا المقدمي، قال: ثنا يحيى القطان، 
ms1038	 عن سفيان، قال: حدثني سهيل بن أبي صالح، عن عبد الله بن يزيد، قال: سألت سعيد بن المسيب عن الضبع فكرهها، فقلت: إن قومك يأكلونها، فقال: إنهم لا يعلمون، فقال رجل عنده سمعت أبا الدرداء يحدث عن النبي صلى الله عليه وسلم " أنه نهى عن أكل كل ذي نهبة، وعن كل ذي خطفة، وعن كل ذي ناب من السباع "، فقال: صدق(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مسلم بن يسار بصري(@)(@@) يروي عن أبيه، روى عنه المعتمر بن سليمان.(@)(@@) (351) -[4: 10] حدثنا ابن قتيبة، قال: ثنا ابن أبي السرى، قال: ثنا معتمر بن سليمان، قال: ثنا عبد الله بن مسلم بن يسار، عن أبيه، " أنه كان إذا سجد يبدأ فيضع ركبتيه ثم يديه، وإذا يبدأ فيرفع رأسه ثم يديه ثم ركبتيه "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أمية بن أبي عثمان بن عبد الله بن خالد بن أسيد(@)(@@) يروي عن محمد بن جبير عداده في أهل الحجاز، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسحاق بن محمد الزهري(@)(@@) من أهل البصرة، يروي عن سالم بن عبد الله، روى عنه التبوذكي.(@)PageV01P002(@)(@@) [ج 4: ص 11](@)(@@)(@@)(@@) ||| AUTO عبد الله بن ذكوان(@)(@@) شيخ بصري، وليس بأبي الزناد، يروي عن محمد بن المنكدر، روى عنه عبد الصمد بن عبد الوارث، يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعيد بن أبان بن سعيد بن العاص الأموي القرشي(@)(@@) أخو عنبسة بن سعيد، يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه أحمد بن إبراهيم الموصلي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حميد بن عبيد الأنصاري(@)(@@) يروي عن أبيه عداده في أهل الكوفة، روى عنه أبو أسامة، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن علي بن يزيد بن ركانة(@)(@@) يروي عن أبيه، عن جده، روى عنه الزبير بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الأسود القرشي(@)(@@) يروي عن عامر بن عبد الله بن الزبير، روى عنه ابن وهب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن(@)(@@) شيخ، يروي عن المدنيين، روى عنه معمر بن راشد وهو الذي يروي عن عمر بن 
ms1039	 عبد العزيز، في إجازة شهادة الابن علي أبيه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الفضل الهاشمي(@)(@@) من أهل المدينة، يروي عن الأعرج، روى عنه مالك، وأهل المدينة وهو عبد الله بن الفضل بن عباس بن ربيعة بن الحارث بن عبد المطلب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسماعيل بن دينار(@)(@@) ابن أخي عمرو بن دينار، يروي عن عمرو بن دينار، روى عنه سفيان بن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أزهر(@)(@@) يروي عن شيخ له يقال له: أبو الربيع عن جابر، روى عنه عبد الصمد بن عبد الوارث.(@)PageV01P002(@)(@@) [ج 4: ص 12](@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسماعيل بن عبد الرحمن السدى(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه سعيد بن زيد أخو حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد بن قسط الهذلي، كنيته أبو يزيد(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل المدينة، مات سنة تسع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن السائب(@)(@@) يروي عن عبد الله بن معقل، روى عنه الشيباني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سيار(@)(@@) وقيل: يسار، وقد قيل: سنان مولى عائشة بنت طلحة، يروي عن عائشة بنت طلحة، روى عنه مروان بن معاوية الفزاري والقاسم بن مالك المزني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بشر الخثعمي(@)(@@) من أهل الكوفة، يروي عن أبي زرعة بن عمرو بن جرير، روى عنه شعبة، والثوري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك بن حذافة(@)(@@) شيخ، يروي عن أمه العالية بنت سبيع عن أم سلمة، روى عنه ابنه معقل بن عبد الله بن مالك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إنسان(@)(@@) من أهل المدينة، يروي عن عروة بن الزبير، روى عنه ابنه محمد بن عبد الله بن إنسان كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي أمامة بن ثعلبة الأنصاري(@)(@@) من أهل المدينة، كنيته أبو رملة، يروي عن أبيه، روى عنه ابنه المنيب بن عبد الله.(@)PageV01P002(@)(@@) [ج 4: ص 13](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الله بن خالد العبسي(@)(@@) من أهل الكوفة، يروي عن عبد الرحمن بن معقل بن مقرن المزني، روى عنه الأعمش، والثوري.(@)(@@)(@@)(@@) ||| AUTO عبد 
ms1040	 الله بن سليمان بن أبي سلمة الأسلمي(@)(@@) من أهل المدينة، يروي عن معاذ بن عبد الله، روى عنه سليمان بن بلال، وخالد بن مخلد القطواني يخطئ.(@)(@@) عبد الله بن خالد(@)(@@) يروي عن سعيد بن المسيب، والقاسم وسالم، روى عنه العطاف بن خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن المسيب(@)(@@) يروي عن عكرمة، روى عنه عبد الله بن وهب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن إسماعيل(@)(@@) من أهل الكوفة، يروي عن إسماعيل بن أبي خالد، روى عنه أبو كريب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمران بن محمد بن طلحة بن عبيد الله(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل العراق، وولي القضاء ببغداد بعد أبيه، ومات سنة تسع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن موهب(@)(@@) مولى لبني نوفل، كنيته أبو نوفل، كنيته أبو محمد، يروي عن جماعة من التابعين، روى عنه أهل المدينة، مات سنة أربع وخمسين ومائة، وهو ابن ثمانين سنة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد العزيز بن عبد الله بن عبد الله بن عمر بن الخطاب العمري الزاهد(@)(@@) أمه أمة الحميد بنت عبد الرحمن بن عياض بن عمرو بن بلال بن أحيحة بن PageV01P002 [ج 4: ص 14] الجلاح، كنيته أبو عبد الرحمن، يروي عن أبي طوالة، عن أنس، روى عنه جابر بن مرزوق الجدي، وكان عبد الله من أزهد أهل زمانه وأكثرهم تخليا للعبادة وأكثرهم مواظبة عليها، ولعل كل شيء حدث في الدنيا لا يكون أربعة أحاديث، منها ما(@)(@@) (352) -[4: 14] حدثنا إسحاق بن إبراهيم بن إسماعيل القاضي ببست، قال: ثنا قتيبة بن سعيد، قال: ثنا جابر بن مرزوق الجدي، قال: ثنا عبد الله بن عبد العزيز العمري الزاهد، عن أبي طوالة، عن أنس، قال: قال رسول الله صلى الله عليه وسلم: " من أذنب ذنبا فعلم أن الله عز وجل إن شاء أن يعذبه عليه عذبه وإن شاء أن يغفر له غفر له، كان حقا على الله عز وجل أن يغفر له ". قال أبو حاتم رضي الله تعالى عنه: أبو طوالة هذا اسمه عبد 