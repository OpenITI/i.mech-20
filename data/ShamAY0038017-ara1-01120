ms1101	(@)(@@) يروي عن سالم بن عبد الله، ونافع أصله من المدينة سكن الكوفة، روى عنه أبو أسامة، ومروان بن معاوية الفزاري والكوفيون كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO عمر بن بيان التغلبي(@)(@@) من أهل الكوفة، يروي عن عروة بن المغيرة بن شعبة، روى عنه طعمة بن عمرو والكوفيون.(@)(@@)(@@)(@@) ||| AUTO عمر بن جاوان(@)(@@) من بني سعد بن زيد مناة، وقد قيل: عمرو بن جاوان، يروي عن الأحنف بن قيس، روى عنه حصين بن عبد الرحمن، فأما أكثر الناس فقد رووا عن حصين، عن عمر بن جاوان، وقال سليمان التيمي، وأبو عوانة عن حصين، عن عمرو بن جاوان.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص(@)(@@) يروي عن عامر بن عبد الله بن الزبير عداده في أهل الحجاز، روى عنه ابن جريج.(@)PageV01P002(@)(@@) [ج 4: ص 102](@)(@@)(@@)(@@) ||| AUTO عمر بن إبراهيم بن محمد بن الأسود(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه هاشم بن القاسم.(@)(@@)(@@)(@@) ||| AUTO عمر بن سليط أبو حفص الهذلي(@)(@@) يروي عن عطاء، روى عنه أبو عبيدة الحداد.(@)(@@)(@@)(@@) ||| AUTO عمر بن شيبة بن قارظ(@)(@@) حليف بني زهرة أخو قارظ بن شيبة، يروي عن أمه أم قارظ بنت إبراهيم بن قارظ، عن أبي هريرة: " صومي كيف شئت وأحصي العدة "، يعني رمضان، عداده في أهل المدينة، روى عنه ابن أبي ذئب، وقد قيل: إن أم عمر بن شيبة أم الحكم، قاله: وكيع بن الجراح، عن ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن عمر بن سعد القرظ(@)(@@) مولى بني مخزوم أخو عمارة بن حفص من أهل المدينة، يروي عن آبائه، روى عنه عبد الرحمن بن سعد في الأذان.(@)(@@)(@@)(@@) ||| AUTO عمر بن إسماعيل الأعمى الأنصاري(@)(@@) مولى محمد بن سيرين، يروي عن ثابت البناني، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عمر بن حسين(@)(@@) مولى حاطب، يروي عن نافع، روى عنه عبد العزيز بن المطلب، وابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO عمر بن خباب(@)(@@) يروي عن طاوس وسالم والحسن، روى عنه أبو نعيم الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الملك بن المغيرة بن نوفل 
ms1102	 بن الحارث بن عبد المطلب(@)(@@) يروي PageV01P002 [ج 4: ص 103] عن أبيه، عن أبي سعيد الخدري، قال: " أمرني عمر بن الخطاب أن أضرب من كان يصلي بعد العصر الركعتين بالدرة ". روى عنه محمد بن عمر وهم إخوة ثلاثة، يزيد، وعمر، ونوفل بنو عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عمر بن نافع(@)(@@) مولى بن عمر، يروي عن أبيه، روى عنه عبد الله بن عمر وهو أخو أبي بكر بن نافع، مات عمر بن نافع في ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبان(@)(@@) يروي عن عمرو بن عثمان بن عفان، روى عنه ابنه إبراهيم بن عمر بن أبان من حديث أبي معشر البراء.(@)(@@)(@@)(@@) ||| AUTO عمر بن جعثم اليحصبي(@)(@@) من أهل حمص، يروي عن خالد بن معدان وسليم بن عامر، روى عنه بقية، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عمر بن حسيل بن سعد بن حذيفة بن اليمان(@)(@@) يروي عن الشعبي عداده في أهل الكوفة، روى عنه عيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله بن الأشج(@)(@@) أخو بكير، يروي عن سعيد بن المسيب، روى عنه يزيد بن أبي حبيب والمصريون.(@)(@@)(@@)(@@) ||| AUTO عمر بن بشير الهمداني(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمر بن أيوب(@)(@@) عداده في أهل الكوفة، يروي عن الشعبي، روى عنه الثوري، ومسعر بن كدام.(@)PageV01P002(@)(@@) [ج 4: ص 104](@)(@@)(@@)(@@) ||| AUTO عمر بن تيري الصنعاني(@)(@@) يروي عن هانئ مولى عثمان، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمر بن حمزة الضبي(@)(@@) من أهل البصرة، يروي عن الحسن، وعكرمة بن خالد وأبيه، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO عمر بن حبيب القاضي(@)(@@) من أهل مكة انتقل إلى اليمن وسكنها، يروي عن عطاء، وعمرو بن دينار، روى عنه رباح بن زيد، وأهل اليمن، وكان حافظا متقنا وليس هذا بعمر بن حبيب القاضي الذي كان على قضاء البصرة ذاك ضعيف.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص النميري(@)(@@) بصري، يروي عن مالك بن دينار، روى عنه يحيى بن حسان.(@)(@@)(@@)(@@) ||| AUTO عمر بن سليمان بن عاصم بن عمر بن الخطاب(@)(@@) يروي.(@)(@@) (381) -[4: 104] عن عبد الرحمن 
ms1103	 بن أبان، عن أبيه، عن زيد بن ثابت، عن النبي صلى الله عليه وسلم قال: " نضر الله امرأ سمع منا حديثا فأداه كما سمعه ". عداده في أهل المدينة، روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) ||| AUTO عمر بن العلاء بن حارثة الثقفي(@)(@@) يروي عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم: " المدينة ومكة محفوفتان بالملائكة وعلى كل نقب منهما ملك لا يدخلها الدجال ولا الطاعون ". روى عنه فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عمر بن المطلب السهمي(@)(@@) يروي عن سعيد بن ميناء، عن أبي هريرة، عن النبي صلى الله عليه وسلم " دعوا عنكم المصلين ". روى عنه قزعة بن سويد.(@)(@@)(@@)(@@) ||| AUTO عمر بن الحزور أبو بشر(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه شباك بن عائذ الأزدي.(@)PageV01P002(@)(@@) [ج 4: ص 105](@)(@@)(@@)(@@) ||| AUTO عمر بن زياد أبو حفص الهلالي(@)(@@) يروي عن عبد الملك بن عمير، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص أبو حفص المكي(@)(@@) يروي عن سالم، روى عنه هاشم بن القاسم.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي إسماعيل(@)(@@) واسم أبي إسماعيل راشد من أهل الكوفة، يروي عن الشعبي، وأبي الضحى، روى عنه الثوري، وإسماعيل بن زكريا، وليس هذا بعمر بن راشد اليمامي ذاك واه ضعيف.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي زائدة الهمداني(@)(@@) واسم أبي زائدة خالد الهمداني، يروي عن الشعبي، وعون بن أبي جحيفة، روى عنه محمد بن عرعرة البرند.(@)(@@) (382) -[4: 105] حدثنا بكر بن أحمد الطاحي بالبصرة، قال: ثنا نصر بن علي، قال: ثنا أبي، عن عمر بن أبي زائدة، قال: " سمعت أبا إسحاق الهمداني قرأ: " لا يكادون يفقهون قولا "(@)(@@)(@@)(@@) ||| AUTO عمر بن روبة الثعلبي(@)(@@) من أهل الشام، يروي عن عبد الواحد بن عبد الله النصري، عن واثلة بن الأسقع، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعيد(@)(@@) شيخ، يروي المقاطيع، روى عنه أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعيد بن شريح(@)(@@) من أهل المدينة، يروي عن الزهري، وعبد الرحمن بن حميد، روى عنه عبد الرحمن بن إسحاق، وفضيل بن سليمان، يعتبر بحديثه من غير 
ms1104	 الضعفاء عنه.(@)(@@)(@@)(@@) ||| AUTO عمر بن السائب(@)(@@) يروي عن والمدنيين، روى عنه PageV01P002 [ج 4: ص 106] عمرو بن الحارث، والليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO عمر بن سليم بن ثابت(@)(@@) يروي القاسم بن أبي القاسم عن أبي روح، روى عنه موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO أبو عثمان الأنصاري اسمه عمر بن سالم(@)(@@) أصله من المدينة انتقل إلى خراسان، وكان على قضاء مرو، يروي عن القاسم بن محمد، روى عنه مهدي بن ميمون، ومطرف بن طريف، وليث بن أبي سليم، وقد قيل: اسمه عمرو بن سالم.(@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد بن أبي العريف الهمداني الكوفي(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل الكوفة، مات في ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO عمر بن سليم البصري(@)(@@) يروي عن أبي غالب عن أبي أمامة، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO عمر بن سيف(@)(@@) عداده في أهل البصرة، يروي عن المهلب بن أبي صفرة، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO عمر بن سلام(@)(@@) يروي عن الشعبي، وعبد الملك بن مروان، روى عنه معن ابن عيسى.(@)(@@)(@@)(@@) ||| AUTO عمر بن سويد الثقفي(@)(@@) يروي عن عائشة بنت طلحة عداده في أهل الكوفة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمر بن شيبة(@)(@@) مولى معقل بن سنان، يروي عن عون بن أبي جحيفة، روى عنه حيوة بن شريح والمصريون.(@)PageV01P002(@)(@@) [ج 4: ص 107](@)(@@)(@@)(@@) ||| AUTO عمر بن سيف الأسدي(@)(@@) يروي عن الشعبي، وابن سيرين، روى عنه مروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيدة بن سفيان الحضرمي(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه الحجازيون.(@)(@@)(@@)(@@) ||| AUTO عمر بن سويد العجلي(@)(@@) يروي عن سلامة التيمي عداده في أهل الكوفة، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الله بن معمر التيمي القرشي، كنيته أبو حفص(@)(@@) يروي عن العراقيين، روى عنه عبد الله بن عون.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمر بن عبد الرحمن أبو أمية الذماري(@)(@@) من أهل اليمن، يروي عن عكرمة، روى عنه عبد الملك بن عبد الرحمن الذماري.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الرحمن بن محيصن السهمي القرشي أبو حفص(@)(@@) يروي عن صفية، روى عنه 
ms1105	 ابن عيينة، وعبد الله بن المؤمل، وكانت أمه تحت المطلب بن أبي وداعة السهمي.(@)(@@)(@@)(@@) ||| AUTO عمر بن مسكين(@)(@@) يروي عن نافع، روى عنه المحاربي.(@)(@@) عمر بن عبد الرحمن(@)(@@) مولى الأخنس بن شريق حليف لقريش عداده في أهل اليمن، يروي عن وهب بن منبه، روى عنه ابن المبارك، وعبد الرزاق.(@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد النصري(@)(@@) من أهل الشام، يروي عن الزهري، روى عنه PageV01P002 [ج 4: ص 108] عمرو بن واقد في روايته أشياء وعمرو بن واقد لا شيء.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الرحمن المدني(@)(@@) يروي عن أبي سلمة بن سفيان، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO عمر بن نعيم(@)(@@) يروي عن أسامة بن سلمان عداده في أهل الشام، روى عنه مكحول.(@)(@@)(@@)(@@) ||| AUTO عمر بن عثمان بن الهدير القرشي المدني(@)(@@) يروي عن عروة بن الزبير، روى عنه عبد الحميد بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الملك العبدي(@)(@@) يروي عن الحسن، وابن سيرين، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عمر بن عثمان بن عبد الرحمن بن سعيد بن يربوع الصرم المخزومي القرشي(@)(@@) من أهل المدينة، يروي عن جده، عن أبيه، وله صحبة، روى عنه زيد بن الحباب وهو أخو محمد بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عمر بن كثير بن المطلب بن أبي وداعة السهمي القرشي(@)(@@) أخو كثير بن كثير، يروي عن المدنيين، روى عنه عبيد الله بن عمر العمري.(@)(@@)(@@)(@@) ||| AUTO عمر بن علي بن الحسين بن علي بن أبي طالب(@)(@@) يروي عن أبيه، روى عنه ابن أخيه جعفر بن محمد بن علي يخطئ.(@)(@@)(@@)(@@) ||| AUTO عمر بن عاصم بن عمر بن سعد القرظ(@)(@@) المؤذن مولى بني مخزوم من أهل المدينة، يروي عن جده، وعمه، روى عنه ابن عجلان.(@)PageV01P002(@)(@@) [ج 4: ص 109](@)(@@)(@@)(@@) ||| AUTO عمر بن عطاء بن وراد بن أبي الخوار(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عمر بن مغيث(@)(@@) من أهل المدينة، يروي عن أبي حسن مولى بني نوفل، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عمر بن عامر السلمي(@)(@@) من أهل البصرة، كنيته أبو حفص، يروي 
ms1106	 عن قتادة، روى عنه سالم بن نوح وزيد بن زريع، مات سنة خمس وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي فروة(@)(@@) واسم أبي فروة مسلم بن سالم الجهني من أهل الكوفة، كنيته أبو حفص، يروي عن أبيه، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمر بن قيس الماصر(@)(@@) من أهل الكوفة، كنيته أبو الصباح مولى الأشعث بن قيس، يروي عن شريح، وزيد بن وهب ومجاهد، روى عنه شعبة وابن عون، وليس هو بعمر بن قيس سندل ذاك ضعيف.(@)(@@)(@@)(@@) ||| AUTO عمر بن عمران السدوسي أبو حفص(@)(@@) يروي عن أبي سعد البقال، قال: " رأيت علي بن أبي أوفى ضربة، فقال: أصابتني يوم خيبر ". روى عنه المنذر بن الوليد الجارودي.(@)(@@)(@@)(@@) ||| AUTO عمر بن مخراق(@)(@@) يروي عن رجل عن عائشة، روى عنه أسامة بن زيد.(@)(@@)(@@)(@@) ||| AUTO عمر بن الحكم بن قيس أبو حفص(@)(@@) يروي عن الحكم بن عتيبة، روى عنه عمرو بن صالح.(@)PageV01P002(@)(@@) [ج 4: ص 110](@)(@@)(@@)(@@) ||| AUTO عمر بن مضرس بن عثمان الجهني أبو عثمان(@)(@@) من أهل مضر، يروي عن أبيه، روى عنه حرملة بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عمر بن عطية(@)(@@) يروي عن أبي جعفر محمد بن علي عداده في أهل الكوفة، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي مسلم(@)(@@) من أهل المدينة، يروي عن عروة بن الزبير، روى عنه عبد الرحمن بن أبي الموالي.(@)(@@)(@@)(@@) ||| AUTO عمر بن كيسان(@)(@@) يروي عن وهب بن أبي مغيث عداده في أهل اليمن، روى عنه ابنه إبراهيم بن عمر بن كيسان، وقد قيل: وهب بن أبي معتب.(@)(@@)(@@)(@@) ||| AUTO عمر بن الفضل الحرشي(@)(@@) يروي عن أبي العلاء بن الشخير، روى عنه حرمي بن عمارة، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمر بن كثير الثقفي(@)(@@) يروي عن الشعبي عداده في أهل الكوفة، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي كبشة(@)(@@) يروي عن مورق العجلي، روى عنه سلام بن أبي مطيع.(@)(@@)(@@)(@@) ||| AUTO عمر بن صالح بن أبي الزاهرية الأزدي(@)(@@) من أهل البصرة، يروي عن أبي جمرة الضبعي، روى عنه هشام بن عمار وداود بن رشيد.(@)(@@)(@@)(@@) ||| AUTO 
ms1107	 عمر بن سعيد(@)(@@) يروي عن الزهري، روى عنه الفضيل بن سليمان النميري.(@)(@@)(@@)(@@) ||| AUTO عمر بن كعب(@)(@@) يروي عن أم طلحة عن عائشة، روى عنه بكير بن عبد الله بن الأشج.(@)PageV01P002(@)(@@) [ج 4: ص 111](@)(@@)(@@)(@@) ||| AUTO عمر بن عمرو(@)(@@) يروي عن أبي عون الأنصاري عداده في أهل الشام عن محمد بن كعب، روى عنه أهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعيد المدلجي حمصي(@)(@@) يروي عن عمران بن سليم عن أبي هريرة، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عمر بن محمد بن جبير بن مطعم بن عدى القرشي(@)(@@) أخو جبير، وسعيد ابني محمد بن جبير، يروي عن أبيه، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO عمر بن محمد بن يحيى بن سعيد بن العاص الأموي القرشي(@)(@@) يروي عن قيس بن محمد بن الأشعث، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الواحد(@)(@@) شيخ، يروي عن مجاهد، روى عنه عبد الله بن كيسان من حديث الغنجار.(@)(@@)(@@)(@@) ||| AUTO عمر بن معن(@)(@@) يروي عن يوسف بن ماهك، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمر بن مجاشع المدائني(@)(@@) يروي عن عبد العزيز بن صهيب، روى عنه الخضر بن محمد الحراني.(@)(@@)(@@)(@@) ||| AUTO عمر بن نبيه الخزاعي(@)(@@) من أهل المدينة، يروي عن أبي عبد الله القراظ، روى عنه شريك بن أبي نمر وحاتم بن إسماعيل.(@)PageV01P002(@)(@@) [ج 4: ص 112](@)(@@)(@@)(@@) ||| AUTO عمر بن محمد بن المنكدر التيمي القرشي(@)(@@) من أهل المدينة، يروي عن أبيه وسمى، روى عنه هشام بن حسان ووهيب بن الورد وكان من العباد، مات في قراءة قرآن قرئ عليه.(@)(@@)(@@)(@@) ||| AUTO عمر بن هلال الباهلي(@)(@@) يروي عن أبي غالب عن أبي أمامة، روى عنه العلاء بن عمر.(@)(@@)(@@)(@@) ||| AUTO عمر بن رديح(@)(@@) شيخ، يروي عن عطاء بن أبي ميمونة، روى عنه محمد بن أبي بكر المقدمي مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد بياع الخمر(@)(@@) من أهل البصرة، يروي عن هشام بن عروة ولم أر في القلب من حديثه إلا ما.(@)(@@) (383) -[4: 112] حدثنا أبو يعلى بالموصل، ثنا حفص بن عبد الله بن عمر الحلواني، قال: ثنا عمر بن 
ms1108	 عبيد البصري بياع الخمر، قال: ثنا هشام بن عروة، عن أبيه، عن عائشة، قالت: قال رسول الله صلى الله عليه وسلم: " إن الله يحب أن تؤتى رخصه كما يحب أن تؤتى عزائمه "(@)(@@)(@@)(@@) ||| AUTO عمر بن موسى بن عبد الله بن يزيد الخطمي الأنصاري(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمر بن فروخ القتاب(@)(@@) يروي عن حبيب بن الزبير، روى عنه يعقوب بن إسحاق الحضرمي.(@)(@@)(@@)(@@) ||| AUTO عمر بن معروف(@)(@@) يروي عن عكرمة، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد(@)(@@) خال أبي معاوية الضرير، يروي عن طاوس، روى عنه أبو معاوية الضرير.(@)PageV01P002(@)(@@) [ج 4: ص 113](@)(@@)(@@)(@@) ||| AUTO عمر بن أبي مالك(@)(@@) يروي عن الزهري، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله بن عبد الرحمن الرومي(@)(@@) من أهل البصرة، يروي عن الحسن وقتادة، روى عنه التبوذكي وقتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عمر بن نصر المحاربي(@)(@@) من أهل الكوفة، يروي عن الكوفيين، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي وهب الخزاعي(@)(@@) واسم أبي وهب ثروان وهو الذي أعتق سلام بن أبي مطيع، يروي عن البصريين، روى عنه ابن المبارك، وعبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد العبدي(@)(@@) يروي عن الحسن، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعيد بن مسروق الثوري(@)(@@) من أهل الكوفة، أخو سفيان، والمبارك ابني سعيد بن مسروق، يروي عن الأعمش، وابن أبي خالد، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن بيهس البيهسي كوفي(@)(@@) يروي عن حماد بن أبي سليمان، روى عنه محمد بن يعلى الكوفي.(@)(@@)(@@)(@@) ||| AUTO عمر بن مصعب(@)(@@) أخو خارجة بن مصعب، يروي عن أبيه، روى عنه يحيى بن يحيى.(@)(@@) (384) -[4: 113] حدثني محمد بن عبد الرحمن الدغولي، قال: ثنا خارجة بن مصعب السرخسي، قال: حدثنا يحيى بن يحيى، عن عمر بن مصعب، عن أبيه، " أن رايات علي كانت سوداء "، وعمر بن مصعب هو أول مولود ولد بسرخس في الإسلام(@)(@@)(@@)(@@) ||| AUTO عمر بن علي بن 
ms1109	 عطاء بن مقدم المقدمي أبو حفص(@)(@@) من PageV01P002 [ج 4: ص 114] أهل البصرة، يروي عن إسماعيل بن أبي خالد، روى عنه ابن أخيه محمد بن أبي بكر المقدمي، وأهل العراق، مات سنة تسعين ومائة، وقد قيل: سنة ثنتين وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمر الدمشقي(@)(@@) شيخ، يروي عن أم الدرداء الصغرى، روى عنه سعيد بن أبي هلال، لا أدري من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الرحمن أبو حفص الأبار القرشي(@)(@@) من أهل الكوفة، يروي عن الأعمش، وابن أبي خالد وحميد الطويل، روى عنه يحيى بن معين، وأهل العراق، مات في ولاية هارون.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الطنافسي الحنفي(@)(@@) من أهل الكوفة، كنيته أبو حفص، يروي عن أبي إسحاق السبيعي، وسماك بن حرب، روى عنه إسحاق بن إبراهيم الحنظلي، وأهل العراق، مات سنة سبع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO أبو داود الحفري اسمه عمر بن سعد(@)(@@) يروي عن الأعمش، مات في جمادى الآخرة سنة ثلاث ومائتين، روى عنه أحمد ويحيى والناس.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الأسود بن موسى بن باذان(@)(@@) مولى بني جمح من أهل مكة، يروي عن مجاهد، روى عنه الثوري، وعبيد الله بن موسى، مات بمكة سنة سبع وأربعين ومائة، وقد قيل: سنة خمسين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 115](@)(@@)(@@)(@@) ||| AUTO عثمان بن إسحاق بن خرشة(@)(@@) من أهل المدينة، يروي عن قبيصة، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حكيم بن عباد بن حنيف الأنصاري(@)(@@) أخو حكيم بن حكيم، كنيته أبو سهل، يروي عن عكرمة، وزياد بن علاقة، وعبد الرحمن بن أبي عمرة، روى عنه الثوري، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد الله بن أبي رافع(@)(@@) مولى سعيد بن العاص من أهل المدينة، يروي عن محرز بن أبي هريرة، روى عنه محمد بن جعفر بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عثمان بن النعمان بن عجلان الزرقي الأنصاري(@)(@@) من أهل المدينة، يروي عن أبان بن عثمان، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد الله بن رافع(@)(@@) مولى النبي صلى الله عليه وسلم يروي عن أبيه، روى عنه عبد 
ms1110	 العزيز بن محمد الدراوردي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عروة بن الزبير بن العوام(@)(@@) يروي عن أبيه، روى عنه أهل المدينة، مات في ولاية أبي جعفر أمه فاختة بنت أبي الأسود بن أبي البخترى.(@)(@@)(@@)(@@) ||| AUTO عثمان بن وثاب المدني(@)(@@) يروي عن سعيد بن المسيب، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الجراد(@)(@@) يروي عن رجل عن ابن مسعود، روى عنه سعيد بن أبي هلال.(@)PageV01P002(@)(@@) [ج 4: ص 116](@)(@@)(@@)(@@) ||| AUTO عثمان بن الضحاك(@)(@@) يروي عن محمد بن يوسف بن عبد الله بن سلام وأبي حازم، روى عنه أبو مودود المدني، وزياد بن يونس.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي سليمان بن جبير بن مطعم القرشي(@)(@@) يروي عن ابن أبي مليكة وعامر بن عبد الله بن الزبير، روى عنه ابن جريج، وابن عيينة وكان قاضيا على مكة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي حازم البجلي(@)(@@) يروي عن صخر بن العيلة، روى عنه أبان بن عبد الله بن أبي حازم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن يسار(@)(@@) يروي عن طاوس روى بن المبارك عن عبيد الله بن عبد الرحمن عنه وهذا هو الأشجعي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حيان الدمشقي(@)(@@) مولى أبي الدرداء، يروي عن أم الدرداء، روى عنه هشام بن سعد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي الوليد(@)(@@) يروي عن عروة بن الزبير، روى عنه هشام بن عروة ومحمد بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الحارث الهمداني(@)(@@) يروي عن السدى، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حسان العامري(@)(@@) يروي عن فلفلة الجعفي عن ابن مسعود، روى عنه الوليد بن قيس السكوني.(@)PageV01P002(@)(@@) [ج 4: ص 117](@)(@@)(@@)(@@) ||| AUTO عثمان بن عمار(@)(@@) يروي عن سعيد بن المسيب، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عثمان بن المغيرة الثقفي(@)(@@) من أهل الكوفة، يروي عن علي بن ربيعة، روى عنه الثوري، وأبو عوانة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن خالد الشامي(@)(@@) يروي عن أبي الأشعث الصنعاني، روى عنه ثور بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن جبير(@)(@@) مولى أبي أيوب، يروي عن أبيه، روى عنه عثمان بن خثيم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن بن عبد الله بن موهب(@)(@@) مولى 
ms1111	 لآل الحكم بن أبي العاص، كنيته أبو عبد الله، يروي عن جماعة من التابعين، روى عنه أهل المدينة، مات سنة ستين ومائة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن رشيد الثقفي(@)(@@) يروي عن أنس بن سيرين، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عثمان بن دينار(@)(@@) أخو مالك بن دينار، يروي عن مالك بن دينار روت عنه ابنته حكامة بنت عثمان بن دينار، وحكامة لا شيء.(@)(@@)(@@)(@@) ||| AUTO عثمان بن خالد القرشي(@)(@@) يروي عن الحسن ونافع، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن فرقد العطار(@)(@@) يروي عن هشام بن عروة مستقيم الحديث، PageV01P002 [ج 4: ص 118] روى عنه علي بن المديني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عثمان بن زائدة الرازي(@)(@@) أصله من الكوفة انتقل إلى الري وكان من العباد المتقشفة، وأهل الورع الدقيق والجهد الشديد، يروي عن الزبير بن عدى عن أنس، روى عنه حكام بن سلم الرازي، وأبو الوليد الطيالسي.(@)(@@) عثمان بن زائدة(@)(@@) شيخ يروي عن عكرمة بن عمار، قال: سمعت الهرماس بن زياد، يقول:(@)(@@) (385) -[4: 118] سمعت رسول الله صلى الله عليه وسلم يقول: " للضيف حق وإن جاء على فرس ". حدثنا محمد بن خالد البردعي بمكة من كتابه، قال: ثنا عبد العظيم بن إبراهيم السالمي، قال: ثنا سليمان بن عبد الرحمن، قال: ثنا عثمان بن زائدة، قال: ثنا عكرمة بن عمار، قال: سمعت الهرماس بن زياد أخاف أن يكون هذا عثمان بن فائد(@)(@@)(@@)(@@) ||| AUTO عثمان بن سليمان الحارثي(@)(@@) يروي عن يزيد بن المهلب، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي دهرش(@)(@@) يروي عن آل الحكم بن أبي العاص، روى عنه سفيان بن عيينة ويحيى بن سليم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن راشد السلمي(@)(@@) من أهل الكوفة، يروي عن عائشة بنت عجرد، روى عنه سفيان بن سعيد الثوري.(@)(@@)(@@)(@@) ||| AUTO عثمان بن النجاشي(@)(@@) يروي عن سعيد بن المسيب، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO عثمان بن نجيح(@)(@@) يروي عن الحجازيين، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن السائب(@)(@@) يروي عن أبيه، روى عنه ابن جريج.(@)PageV01P002(@)(@@) [ج 4: ص 119](@)(@@)(@@)(@@) ||| AUTO عثمان بن حصين بن عبيدة 
ms1112	 بن علاق الدمشقي(@)(@@) يروي عن الشاميين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي سلمة(@)(@@) يروي المقاطيع، روى عنه حجاج بن أبي عثمان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن ربيعة بن أبي عبد الرحمن التيمي(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه الدراوردي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن واقد العمري(@)(@@) من أهل المدينة، يروي عن نافع، وأهل المدينة، روى عنه زيد بن الحباب والعراقيون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن الأسود(@)(@@) يروي عن عبد الله بن أبي هلال، روى عنه إبراهيم بن ميسرة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد الله أبو المنازل(@)(@@) ابن أخي شريح كان على قضاء خراسان، يروي عن شريح، روى عنه الشيباني والحجاج بن أرطأة.(@)(@@)(@@)(@@) ||| AUTO عثمان الشحام العدوى(@)(@@) من أهل البصرة، كنيته أبو سلمة، يروي عن عكرمة، ومسلم بن أبي بكرة، روى عنه حماد بن سلمة ووكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عثمان بن صهيب(@)(@@) يروي عن أبيه عداده في أهل المدينة، روى عنه يزيد بن الهاد.(@)PageV01P002(@)(@@) [ج 4: ص 120](@)(@@)(@@)(@@) ||| AUTO عثمان بن صفوان المكي(@)(@@) يروي المراسيل، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مسلم بن هرمز(@)(@@) يروي عن نافع بن جبير بن مطعم، روى عنه المسعودي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن محمد بن عبيد الله بن عبد الله بن عمر بن الخطاب(@)(@@) من أهل المدينة، كنيته أبو قدامة، يروي عن عائشة بنت سعد بن أبي وقاص، روى عنه خالد بن مخلد القطواني.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن أوس بن حذيفة الثقفي(@)(@@) يروي عن عمه عمرو بن أوس، روى عنه عبد الله بن عبد الرحمن الطائفي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن الأرقم القرشي(@)(@@) يروي عن جده، روى عنه العطاف بن خالد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن شبرمة كوفي(@)(@@) يروي عن عاصم عن زر عن عبد الله لو لم يبق من الدنيا إلا يوم، روى عنه محمد بن فضيل بن غزوان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن أبي عتيق(@)(@@) يروي عن سعيد بن عمرو بن جعدة، روى عنه سليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عثمان بن غياث الراسبي(@)(@@) من أهل 
ms1113	 البصرة، يروي عن أبي عثمان النهدي وعكرمة، روى عنه يحيى بن سعيد القطان والنضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن علاثة العقيلي(@)(@@) من أهل الشام، يروي عن طارق بن PageV01P002 [ج 4: ص 121] أحمر، روى عنه أخوه محمد بن عبد الله بن علاثة يعتبر حديثه من غير رواية أخيه عنه لان أخاه لا شيء.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن بن عبيد الله التيمي القرشي(@)(@@) أخو معاذ بن عبد الرحمن من أهل المدينة، يروي عن ربيعة بن عبد الله بن الهدير، روى عنه عبد المجيد بن سهيل بن عبد الرحمن بن عوف.(@)(@@)(@@)(@@) ||| AUTO عثمان بن قيس(@)(@@) يروي عن رجل عن ابن عباس، روى عنه الحجاج بن حسان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن بن أبان بن عثمان القرشي الأموي(@)(@@) يروي عن أبان بن عثمان، روى عنه ابن أبي الزناد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن بن سعيد بن يربوع المخزومي القرشي(@)(@@) يروي عن عروة بن الزبير، روى عنه أبو بكر بن عثمان ابنه.(@)(@@)(@@)(@@) ||| AUTO عثمان بن القاسم الباهلي(@)(@@) من أهل البصرة، يروي عن عكرمة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@) عثمان بن عبد الرحمن(@)(@@) يروي عن سعيد بن جبير، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمر الجمحي(@)(@@) يروي عن سالم بن عبد الله، وخارجة بن زيد، روى عنه عبد العزيز بن محمد الدراوردي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمر بن موسى التيمي القاضي(@)(@@) من أهل المدينة، يروي عن الزهري وأبي الغيث وعامر بن سعد، روى عنه عبد الواحد بن زياد والدراوردي، وابنه عمر بن عثمان.(@)(@@)(@@)(@@) ||| AUTO أبو حصين اسمه عثمان بن عاصم بن حصين الأسدي(@)(@@) من PageV01P002 [ج 4: ص 122] أهل الكوفة، يروي عن سعيد بن جبير والشعبي وشريح، روى عنه الثوري وشعبة وابن عيينة، مات سنة ثمان وعشرين ومائة، وقيل: سنة سبع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن كعب القرظي(@)(@@) من أهل المدينة، يروي عن محمد بن كعب، روى عنه يزيد بن عبد الله بن الهاد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد أبو دوس اليحصبي(@)(@@) من 
ms1114	 أهل الشام، يروي عن شريح بن عبيد، روى عنه أبو المغيرة، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عثمان بن علي بن كثير بن شهاب(@)(@@) يروي عن سعيد بن عمرو بن سعيد بن أبي هريرة، روى عنه إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الملك(@)(@@) الذي يقال له: مستقيم كان يؤذن في المسجد الحرام، يروي عن ابن المسيب وعطاء وسالم، روى عنه محمد بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مسلم الدمشقي(@)(@@) يروي عن مكحول، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي الكنات(@)(@@) يروي عن أبي مليكة، روى عنه يسرة بن صفوان اللخمي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمارة(@)(@@) يروي عن سعيد بن المسيب، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عثمان بن جهم الهجري(@)(@@) يروي عن زر بن حبيش، روى عنه وكيع بن محرز الناجي.(@)PageV01P002(@)(@@) [ج 4: ص 123](@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي العاتكة القاص(@)(@@) من أهل الشام، كنيته أبو حفص، يروي عن سليمان بن حبيب المحاربي، روى عنه محمد بن شعيب بن شابور وأهل الشام، مات سنة ثنتين وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مورع أبو شيبة(@)(@@) يروي عن الشعبي، روى عنه عمرو بن محمد العنقزي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي عثمان(@)(@@) يروي عن القاسم بن محمد، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن موسى بن بقطر(@)(@@) من أهل البصرة، كنيته أبو الخطاب، يروي عن الحسن وعطاء، روى عنه ابن مهدي والبصريون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عثمان الغطفاني أبو عمرو القرشي(@)(@@) من أهل البصرة، يروي عن علي بن زيد بن جدعان، روى عنه أحمد بن حنبل، وأهل العراق كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO عثمان بن معاوية القرشي(@)(@@) يروي عن الحسن، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي زرعة(@)(@@) مولى أبي عقيل الثقفي من أهل الكوفة، كنيته أبو المغيرة واسم أبي زرعة المغيرة، يروي عن سعيد بن جبير وسالم بن أبي الجعد، روى عنه الثوري، وشعبة، ومسعر.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سليمان الليثي أبو عمرو(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه الثوري، وأشعث.(@)PageV01P002(@)(@@) [ج 4: ص 124](@)(@@)(@@)(@@) ||| AUTO عثمان 
ms1115	 بن محمد بن المغيرة بن الأخنس بن شريق الثقفي الأخنسي(@)(@@) يروي عن والزهري، روى عنه محمد بن عمرو بن علقمة، وعبد الله بن جعفر المخرمي يعتبر حديثه من غير رواية المخرمي عنه لأن المخرمي ليس بشيء في الحديث.(@)(@@) (386) -[4: 124] حدثنا البغوي ببغداد، قال: ثنا عبد الله بن عمر الخطابي، قال: ثنا الدراوردي، عن عبد الله بن سعيد بن أبي هند، عن عثمان بن محمد الأخنسي، عن سعيد المقبري، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم قال: " من استعمل على القضاء فقد ذبح بغير سكين "(@)(@@)(@@)(@@) ||| AUTO عثمان بن العلاء(@)(@@) يروي عن سلمة بن وردان، روى عنه محمد بن معن.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مرة(@)(@@) من أهل البصرة، يروي عن القاسم بن محمد، روى عنه النضر بن شميل، وأبو عاصم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مضرس بن عثمان الجهني(@)(@@) أخو عمر بن مضرس، يروي عن أبيه، روى عنه حرملة بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مرجعة أبو مرجعة الهنائي(@)(@@) من أهل البصرة، يروي عن عكرمة، ومالك بن دينار، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن جبلة بن أبي رواد(@)(@@) يروي عن أهل المدينة، روى عنه ابنه عبد العزيز بن عثمان بن جبلة من أهل مرو والد خلف بن عبد العزيز، وكان عثمان بن جبلة مع أبي تميلة بالكوفة في طلب الحديث فهاج به غم وكرب فوضع رأسه في حجر أبي تميلة فمات فدفن بالكوفة.(@)(@@)(@@)(@@) ||| AUTO علي بن محمد بن علي بن أبي طالب الهاشمي(@)(@@) يروي عن أبيه محمد بن PageV01P002 [ج 4: ص 125] الحنفية، روى عنه ابنه حسن بن علي بن محمد.(@)(@@)(@@)(@@) ||| AUTO علي بن الحسن بن حسن بن علي بن أبي طالب الهاشمي(@)(@@) يروي عن أهل المدينة، روى عنه عبد الرحمن بن أبي الموالي.(@)(@@)(@@)(@@) ||| AUTO علي بن يحيى بن خلاد بن رافع الأنصاري الزرقي(@)(@@) من أهل المدينة، يروي عن أبيه، عن عمه رفاعة بن رافع، روى عنه ابن عجلان، وابنه يحيى بن علي بن يحيى، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد 
ms1116	 الله بن رفاعة القرظي(@)(@@) من أهل المدينة، يروي عن الربيع بن معبد، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO علي بن الحكم البناني(@)(@@) من أهل البصرة، كنيته أبو الحكم، يروي عن عطاء ونافع، وأبي نضرة، روى عنه معمر، وأهل البصرة، مات سنة ثلاثين أو إحدى وثلاثين ومائة بالبصرة.(@)(@@)(@@)(@@) ||| AUTO على الجعفي(@)(@@) من أهل الكوفة والد الحسين بن علي الجعفي، يروي عن سويد بن غفلة، روى الحسين بن علي عن أخيه الوليد الجعفي عن أبيه.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الملك بن عمير(@)(@@) يروي عن أبيه، قال: قال أكثم بن صيفى: " الوحشة في ذهاب الأعمام ". روى عنه عمر بن علي المقدمي.(@)(@@)(@@)(@@) ||| AUTO علي بن يزيد بن أبي حكيمة(@)(@@) يروي عن إياس بن سلمة، روى عنه الحميدي.(@)(@@)(@@)(@@) ||| AUTO على البناني(@)(@@) يروي عن أبي نضرة. قال: كانوا إذا قعدوا يتذاكرون الفقه يأمرون رجلا فيقرأ عليهم سورة، روى عنه شعبة بن الحجاج.(@)PageV01P002(@)(@@) [ج 4: ص 126](@)(@@)(@@)(@@) ||| AUTO علي بن مسلم بن خباب(@)(@@) مولى بني ليث أخو محمد بن مسلم بن خباب، كنيته أبو الحسن، يروي عن سعيد المقبري، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO علي بن نفيل جد أبي جعفر النفيلي، كنيته أبو محمد(@)(@@) يروي عن سعيد بن المسيب، روى عنه النضر بن عربي والثوري.(@)(@@)(@@)(@@) ||| AUTO علي بن ثابت بن عمر بن أخطب الأنصاري(@)(@@) البصري أخو عروة بن ثابت ومحمد بن ثابت، يروي عن نافع، روى عنه سعيد بن أبي عروبة وعمران القطان، مات سنة خمس وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن الأرقط(@)(@@) يروي عن عطاء، وميمون بن مهران، روى عنه الحجاج بن الحجاج الأسلمي.(@)(@@)(@@)(@@) ||| AUTO علي بن خالد الدؤلي(@)(@@) يروي عن النصر بن سفيان الدؤلي عن أبي هريرة، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO علي بن جعدة(@)(@@) يروي عن جعدة عن علي، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO علي بن بذيمة الجزري(@)(@@) مولى جابر بن سمرة السوائي، يروي عن سعيد بن جبير وعكرمة، روى عنه الثوري وشريك، مات سنة ثلاث وثلاثين ومائة، وقد قيل: سنة ست 
ms1117	 وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن ميسر(@)(@@) يروي عن عبيد بن عمير، روى عنه محمد بن الفضيل بن غزوان.(@)PageV01P002(@)(@@) [ج 4: ص 127](@)(@@)(@@)(@@) ||| AUTO علي بن بلال(@)(@@) يروي المراسيل والمقاطيع، روى عنه أبو بشر جعفر بن أبي وحشية.(@)(@@)(@@)(@@) ||| AUTO علي بن حنظلة الشيباني(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه جبلة بن سحيم.(@)(@@)(@@)(@@) ||| AUTO علي بن حوشب السلمي(@)(@@) من أهل الشام، يروي عن مكحول، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO علي بن صالح بن حي الهمداني(@)(@@) من أهل الكوفة أخو الحسن بن صالح، كنيته أبو محمد، يروي عن أبي إسحاق السبيعي، والكوفيين، كان مولد على والحسن أخيه سنة مائة لأنهما كانا توأمين، وكان سفيان الثوري أسن منهما بخمس سنين، روى عنهما أهل العراق وإسماعيل بن عمرو البجلي، مات علي بن صالح سنة إحدى وخمسين ومائة وقيل سنة أربع وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن حصين بن مالك بن الخشخاش العنبري(@)(@@) كان يذهب مذهب الشراة، يروي عن جابر بن زيد، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي حميد الجندي(@)(@@) من أهل اليمن، يروي عن طاوس، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO علي بن ربيعة البجلي(@)(@@) من أهل الكوفة، يروي عن أسماء بن الحكم الفزاري، وأهل العراق، روى عنه العلاء بن صالح وعثمان بن المغيرة الثقفي.(@)PageV01P002(@)(@@) [ج 4: ص 128](@)(@@)(@@)(@@) ||| AUTO علي بن صالح المكي(@)(@@) يروي عن ابن خثيم، روى عنه المعتمر بن سليمان يغرب.(@)(@@)(@@)(@@) ||| AUTO علي بن زرارة(@)(@@) يروي عن سعيد بن جبير عداده في أهل الكوفة، روى عنه موسى الصغير.(@)(@@)(@@)(@@) ||| AUTO علي بن طلق(@)(@@) يروي عن عبد الله بن محيريز، روى عنه حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO علي بن خليفة الطائي(@)(@@) كوفي، يروي عن جماعة من التابعين، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO علي بن سويد بن منجوف السدوسي سدوس شيبان بن ذهل، كنيته أبو الفضل(@)(@@) من أهل البصرة، يروي عن عبد الله بن بريدة، روى عنه حماد بن زيد والنضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO علي بن علي(@)(@@) شيخ من أهل الكوفة، يروي عن إبراهيم النخعي أحرفا يسيرة، روى 
ms1118	 عنه شريك بن عبد الله النخعي.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي حملة(@)(@@) من أهل فلسطين، يروي عن الشاميين، كنيته أبو نصر، وقد قيل: أبو حملة مولى آل عتبة بن ربيعة القرشي، روى عنه أهل بلده، مات سنة ست وخمسين ومائة، وقد قيل: سنة ست وستين ومائة.(@)(@@) (387) -[4: 128] حدثنا ابن قتيبة بعسقلان، قال: ثنا ابن أبي السرى، قال: ثنا ضمرة بن ربيعة، عن علي بن أبي حملة، قال: قال لي زياد بن صخر: " يا أبا نصر، إذا صنعت يدا فاصنعها إلى ذي دين أو حسب "(@)PageV01P002(@)(@@) [ج 4: ص 129](@)(@@)(@@)(@@) ||| AUTO علي بن أبي المغيرة الزبيري(@)(@@) كوفي، يروي عن أبي إسحاق السبيعي، روى عنه أبو غسان مالك بن إسماعيل، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO علي بن سالم(@)(@@) يروي عن علي بن زيد، روى عنه إسرائيل بن يونس.(@)(@@)(@@)(@@) ||| AUTO علي بن السائب(@)(@@) كوفي، يروي عن إبراهيم النخعي، روى عنه المسعودي يعتبر بحديثه من غير رواية المسعودي عنه.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي طلحة(@)(@@) مولى بني هاشم سكن الشام، كنيته أبو الحسن واسم أبي طلحة سالم، يروي عن مجاهد وأبي الوداك، روى عنه داود بن أبي هند، وراشد بن سعد، ومعاوية بن صالح، وهو الذي يروي عن بن عباس الناسخ والمنسوخ ولم يره.(@)(@@)(@@)(@@) ||| AUTO علي بن الأقمر الوادعي(@)(@@) أهل الكوفة، يروي ابن عباس الناسخ عن أبي الأحوص عن عبيد الله، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO علي بن سليمان(@)(@@) يروي عن مكحول، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله بن علي(@)(@@) من بني عبد شمس من أهل الحجاز، يروي عن أبيه، روى عنه عمر بن سعيد بن أبي حسين.(@)(@@)(@@)(@@) ||| AUTO علي بن نافع(@)(@@) مولى بني نمير من أهل البصرة، يروي المراسيل والمقاطيع، روى عنه أيوب السختياني وصخر بن جويرية.(@)(@@)(@@)(@@) ||| AUTO علي بن عبيد الله أبو عاصم الغطفاني(@)(@@) من أهل الكوفة، يروي عن ثابت بن عبيد ويسار بن نمير، روى عنه الثوري، وأبو عوانة.(@)PageV01P002(@)(@@) [ج 4: ص 130](@)(@@)(@@)(@@) ||| AUTO علي بن عتيق(@)(@@) يروي عن أبي بردة، روى عنه مسعر بن 
ms1119	 كدام.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي العالية(@)(@@) يروي عن مورق العجلي، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO علي بن محرز الضبي(@)(@@) كوفي، يروي عن جماعة من التابعين، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO علي بن العلاء الخزاعي(@)(@@) مولى أم مسكين من أهل البصرة، يروي عن الحسن، روى عنه عبد الوارث بن سعيد.(@)(@@)(@@)(@@) ||| AUTO علي بن حرملة(@)(@@) القاضي من أهل الكوفة، يروي عن جماعة من التابعين، روى عنه أهل الكوفة، مات في ولاية هارون.(@)(@@)(@@)(@@) ||| AUTO علي بن المعارك الوادي(@)(@@) من أهل وادى القرى، يروي عن رجل عن المقداد، روى عنه عياش بن عباس القتباني.(@)(@@)(@@)(@@) ||| AUTO علي بن سليمان الكلبي أبو نوفل(@)(@@) يروي عن أبي إسحاق السبيعي والأعمش، روى عنه الوليد بن مسلم وهشام بن عمار يغرب.(@)(@@)(@@)(@@) ||| AUTO علي بن المبارك الهنائي(@)(@@) من أهل البصرة، يروي عن هشام بن عروة، وكان راويا ليحيى بن أبي كثير، روى عنه وكيع ومسلم وكان متقنا ضابطا.(@)(@@)(@@)(@@) ||| AUTO علي بن هاشم بن البريد العامري البزاز(@)(@@) من أهل الكوفة، PageV01P002 [ج 4: ص 131] كنيته أبو الحسن، يروي عن إسماعيل بن أبي خالد، روى عنه أهل الكوفة، مات سنة تسع وثمانين ومائة وكان يتشيع.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الأعلى بن عامر أبو الحسن الثعلبي الأحول(@)(@@) من أهل الكوفة، يروي عن كثير بن زياد أبي سهل، روى عنه زهير بن معاوية، وأبو بدر والكوفيون.(@)(@@)(@@)(@@) ||| AUTO علي بن قادم(@)(@@) يروي عن الأعمش، كنيته أبو الحسن، مات سنة ثلاث عشرة ومائتين، روى عنه أبو بكر بن أبي شيبة، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO علي بن مسهر بن علي بن عمير بن عاصم بن عبيد بن مسهر(@)(@@) أخو عبد الرحمن بن مسهر القرشي كنيته أبو الحسن، وكان قد ولى القضاء، يروي عن الشيباني وابن أبي خالد، روى عنه أهل العراق، مات سنة تسع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن حجر بن إياس بن مقاتل بن المشمرخ السعدي(@)(@@) من أهل مرو، كنيته أبو الحسن، يروي عن معروف الخياط، عن واثلة بن الأسقع، حدثنا عنه شيوخنا الحسن بن سفيان، وغيره.(@)(@@)(@@)(@@) ||| AUTO 
ms1120	 عمرو بن هرم بن حيان الأزدي البصري(@)(@@) يروي عن ربعي بن PageV01P002 [ج 4: ص 132] حراش، روى عنه أهل البصرة وصلى عليه قتادة بعد ما دفن.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مصعب بن الزبير بن العوام القرشي(@)(@@) يروي عن عروة بن الزبير، روى عنه سعيد بن زيد، وأبو هلال.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن وهب النخعي(@)(@@) عم أبي داود النخعي، كنيته أبو معاوية، وقد قيل أبو سليمان، يروي عن جماعة من التابعين، روى عنه سليمان بن ثابت النخعي، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO أبو العنبس اسمه عمرو بن مروان النخعي(@)(@@) من أهل الكوفة، يروي عن شقيق بن سلمة وأبيه، روى عنه حفص بن غياث ووكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عمرو بن يحيى بن عمارة بن أبي حسن المازني الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه مالك والثوري، واسم أبي حسن تميم بن عبد عمرو بن قيس من بني مازن بن النجار، وأم عمرو بن يحيى أم النعمان بنت أبي حبة بن عابد بن عمرو بن قيس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبان بن عثمان بن عفان القرشي(@)(@@) أخو عبد الرحمن بن أبان، يروي عن أبي غطفان بن طريف المدني عن أبي رافع، روى عنه الزهري، وأهل المدينة، وقد روى عن جابر بن عبد الله " أن أبا بكر نيط برسول الله صلى الله عليه وسلم وأن عمر نيط بأبي بكر ". فلا أدري أسمع منه أم لا(@)(@@)(@@)(@@) ||| AUTO عمرو بن يحيى بن قمطة(@)(@@) من خيار أهل مكة، يروي عن سالم بن عبد الله، روى عنه ابن عيينة.(@)PageV01P002(@)(@@) [ج 4: ص 133](@)(@@)(@@)(@@) ||| AUTO عمرو بن منصور المشرقي الهمداني(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه عيسى بن يونس ووكيع.(@)(@@)(@@)(@@) ||| AUTO عمرو بن إياس(@)(@@) يروي عن سعيد بن أبي الحسن عن أبي هريرة، روى عنه قرة بن خالد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مسلم الجندي(@)(@@) من أهل اليمن، يروي عن طاوس وعكرمة، روى عنه زياد بن سعد ومعمر، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن تميم(@)(@@) مولى زمانة، يروي عن أبيه، عن أبي هريرة، روى 