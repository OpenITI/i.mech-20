ms81	 الشباب إذا مضى % % وكانت يد منه على فولت % % PageV01P311 11(@)(@@) % فقد كنت في ظل العذارى مرفلا % أحب وأعطي حاجتي حيث حلت % % 12(@)(@@) % فغير ذاك العيش تاج لبسته % وطاعة وال أحرمت وأحلت % % 13(@)(@@) % ونبئت نسوانا كرهن تحلمي % % ولله أوبي أكثرت أم أقلت % % 14(@)(@@) % إذا أنا لم أعط الخليفة طائعا % يميني فلا قامت لكأس وشلت % % 15(@)(@@) % لقد أرسلت صفراء نحوي رسولها % % لتجعلني صفراء ممن أظلت % % 16(@)(@@) % فمن مبلغ عني قريشا رسالة % وأفناء قيس حيث سارت وحلت % % 17(@)(@@) % بأنا تداركنا ضبيعة بعدما % % أغارت على أهل الحمى ثم ولت % % 18(@)(@@) % وقد نزلوا يوما بأوضاح كامل % ولأيا بلاي من اضاخ استقلت % % 19(@)(@@) % فسار إليهم من نمير بن عامر % فوارس قتل المقرفين استحلت % % 20(@)(@@) % فما لحقت أهل اليمامة عامر % على الخيل حتى أسأرت وأكلت % % PageV01P312 21(@)(@@) % فلما التقينا زلت النعل زلة % بأقدامهم ، تعسا لهم حيث زلت % % 22(@)(@@) % فشك نمير بالقنا صفحاتهم % % وكم ثم من نذر لها قد أحلت % % 23(@)(@@) % وترمي عقيل كل عين وجبهة % وتنتظم الأبدان حيث احزألت % % 24(@)(@@) % ولما لحقناهم كأنا سحابة % من الملمعات البرق حين استهلت % % 25(@)(@@) % صففنا وصفوا مقبلين كأنهم % % أسود الأشاري استتبلت وأدلت % % 26(@)(@@) % تركنا على النشناش بكر بن وائل % % وقد نهلت منها السيوف وعلت % % 27(@)(@@) % غداة أرى ابن الوازع السيف حتفه % وقد ضربت يمنى يديه فشلت % % 28(@)(@@) % وأفلت يمري ذات عقب كأنها % % حذارية من رأس نيق تدلت % 29(@)(@@) % وبالفلج العادي قتلى إذا التقت % % عليها ضباع الجر بانت وضلت % PageV01P313 البحر : هزج 1(@)(@@) % ألا يا خاتم الملك ال % % ذي أملك لو نلته % % 2(@)(@@) % فؤادي بك مجنون % ولو أسطيع سلسلته % 3(@)(@@) % وقد أمسكت معرو % % فك عندي حين أملته % % 4(@)(@@) % لقد نحيتني عنك % % بداء منك حملته % 5(@)(@@) % وما بات شجي القل % مشتاق كما بته % % 6(@)(@@) % أقاسي بك تسهيدا % ولو أسطيع حولته % 7(@)(@@) % ولا والله لو حملت % % ني سرك ما خنته % 8(@)(@@) % رأيت الصبر عن وجهك % % لا يلفى وقد رمته % % 9(@)(@@) % وإني لرقيق القلب % % للمشعوف إذ كنته % 10(@)(@@) % أحييه وأدنيه % % وإن لام وإن لمته % PageV01P314 11(@)(@@) % براني حبك المكنو 
ms82	 % % ن في الأحشاء إذ صنته % 12(@)(@@) % وما ذكرك إلا السح % % ر أو كالسحر علقته % 13(@)(@@) % وأنت الحجر الأسو % % د لو يخلو لقبلته % 14(@)(@@) % أما ينفعني عند % % ك قول معجب قلته % % 15(@)(@@) % وصومي لك عنهن % ولولا أنت ما صمته % 16(@)(@@) % فإني كلما اشتقت % % إلى وجهك صورته % 17(@)(@@) % أناجي شبها منك % على الترب إذا اشتقته % % 18(@)(@@) % فيا واها له والله % % وجها حين شبهته % % 19(@)(@@) % حبيب خط في الترب % % وما زار وما زرته % % 20(@)(@@) % لقد فديته ألفا % ولو كلمني زدته % % PageV01P315 البحر : هزج 1(@)(@@) % ألا يا كاهن المصر % % الذي ينظر في الزيت % % 2(@)(@@) % تراني عائشا حتى % % أرى ' عبدة ' في البيت % % 3(@)(@@) % فقال : ادن أرى موتا % ودورا سابق الموت % % 4(@)(@@) % وقد قالت لنا جا % % رية تعرف في الصوت % 5(@)(@@) % أمن فوت الهوى تبكي % % فلا تبك من الفوت % % 6(@)(@@) % سأرقيها فتأتيك % % ولو كانت على حوت % 7(@)(@@) % فقلت : امشي لنا قصدا % بما صمت وصليت % 8(@)(@@) % فيا حسنا لما قلت % وبشرت ومنيت % 9(@)(@@) % إذا هممت بنا كنت % % مع الهم فأمليت % % 10(@)(@@) % وإن مال بها النسيا % % ن ذكرت وسميت % PageV01P316 11(@)(@@) % وطاب العيش لي منها % % كما أبدت وأبديت % 12(@)(@@) % خذي ودي بما أبليت % % ني فيه وأبديت % % 13(@)(@@) % فقالت : في الذي سقنا % % إليك الروح من ' ليت ' % PageV01P317 البحر : هزج 1(@)(@@) % أ ' حبى ' فيم خليت % وفيم الحبل مبتوت % 2(@)(@@) % أأدللت بما عندي % % من الشوق فأقصيت % % 3(@)(@@) % أتاني بقض ما ألقيت % % ن هاروت وماروت % 4(@)(@@) % فما أمسيت حتى صرخ % الحي وسجيت % 5(@)(@@) % لقد كنت على العيني % % ن والرأس فنحيت % % 6(@)(@@) % أحبى لو دنت من قل % % بك الرحمة أدنيت % 7(@)(@@) % إذا باعدت أضنيت % وإن قربت عوفيت % 8(@)(@@) % وعزاني أبو عمرو % % وقدما عنك عزيت % % 9(@)(@@) % فلم أسمع من الشوق % على سمعي فنوديت % 10(@)(@@) % أمات الشوق أوصالي % % وبعض الشوق تمويت % PageV01P318 12(@)(@@) % وأن الدمع منهل % وأن القلب مرفوت % % 13(@)(@@) % % ولا أصبر إن شيت % 14(@)(@@) % ألا يا ليتني منك % الذي أعطيت أعطيت % 15(@)(@@) % وأعتبتك من سومي % % كما أعتب من سوت % % 16(@)(@@) % كأني يوم لاقيت % ك خلف العين مبهوت % % 17 
ms83	(@)(@@) % كأني ذاك من حبك % % أو أخرس سكيت % 18(@)(@@) % إذا أزمعت أن أنظر % الحاجة أنسيت % % 19(@)(@@) % لقد رحت وما أدري : % أسحر ذاك أم ليت ؟ % 20(@)(@@) % أحبى ليس لي صبر % وإن رخصت لي جيت % 21(@)(@@) % ولا والله ما يصبر % % في البرية الحوت % PageV01P319 22(@)(@@) % دعاني لك جني % من الجنان عفريت % 23(@)(@@) % بوجه زاهر الحسن % زهاه الجيد والليث % % 24(@)(@@) % كأن الروح والريحا % % 25(@)(@@) % جرى في ماء خديك % % وفي الأنياب تنبيت % 26(@)(@@) % كأن القول من فيك % % لنا در وياقوت % 27(@)(@@) % إذا أدبرت مات النا % % س إن قيل لهم : موتوا % % 28(@)(@@) % أعادي فيك يا حبى % % وقبل اليوم عوديت % 29(@)(@@) % فلم أجزع وإن كنت % جزوعا حين خوفيت % PageV01P320 البحر : رجز تام 1(@)(@@) % مهلا أخي لم تلق ما قد لقيت % تكاد أنفاسي بروحي تفوت % 2(@)(@@) % في القول يأتيك بيان الفتى % % والعي ما أغناك عنه السكوت % 3(@)(@@) % من حكم صمت فدع منطقا % إن كان خيرا لك منه الصموت % 4(@)(@@) % إن تجفني فإني امرؤ % أصبو وأصبي ربما قد جفيت % 5(@)(@@) % قل أيها اللائم في حبها % % لم تدر ما ودي ولا ما هويت % % 6(@)(@@) % سلمى هي النفس وهم الفتى % % رضيت منها بمقال رضيت % 7(@)(@@) % من حب سلمى عبرتي ثرة % تمنعني النوم ورأيي شتيت % 8(@)(@@) % قد مت من شوق إلى وجهها % % ولو أراها في منامي حييت % 9(@)(@@) % يا حبذا سلمى على بخلها % % صدت وقلبي هالك مستميت % 10(@)(@@) % وبالمنهى يوم راح العدى % % ذكرتها وأيا فقالت : نسيت % PageV01P321 11(@)(@@) % وربما راحت على رقبة % تنوي لقائي معها العنكبوت % % 12(@)(@@) % أيام معروف علي الضنا % % منها ولولا حبها ما ضنيت % 13(@)(@@) % لما رأتني غرقا في الهوى % % أجرض بالموت وحولي كتيت % 14(@)(@@) % قالت : ثقيل قد دنا موته % % فقلت : ما كال مريض يموت % % 15(@)(@@) % تحت يد الله فلا تحزني % % إن مت من داء الهوى أو بريت % % 16(@)(@@) % وروقة بكر يصلى بها % % حين تجلى ويطال القنوت % 17(@)(@@) % جهزتها ليلا إلى مالك % يفوت أجنادا ومن لا يفوت % % 18(@)(@@) % لما أتت قال لها مرحبا % فداك من ضمت عليه البيوت % 19(@)(@@) % بمثلها أعطى الفتى ماله 
ms84	 % ومال ذي الوفر معاش وصيت % 20(@)(@@) % عندي لمن زفك طول الغنى % % من نائل يبقى له ما بقيت % % PageV01P322 21(@)(@@) % من طعم الله المحيا به % % بلج المحيا أيريحي زميت % PageV01P323 البحر : مجزوء الكامل 1(@)(@@) % يا منظرا حسنا رأيته % من وجه جارية فديته % % 2(@)(@@) % لمعت إلي تسومني % % لعب الشباب وقد طويته % % 3(@)(@@) % وتقول : إنك قد جفو % % ت وكنت لي شجنا حويته % 4(@)(@@) % فأريد صرمك تارة % وإذا ارعوى قلبي نهيته % 5(@)(@@) % وأرى عليك مهابة % ويحل ذنبك لو بغيته % 6(@)(@@) % ثم اعتذرت من الصدود % % فما سخطت وما ارتضيته % 7(@)(@@) % يا سلم طاب لك الفؤا % % د وعز سخطك فاحتميته % 8(@)(@@) % والله رب محمد % ما إن غدرت ولا نويته % % 9(@)(@@) % أمسكت عنك وربما % % عرض البلاء وما بغيته % 10(@)(@@) % إن الخليفة قد بغى % % وإذا أبى شيئا أبيته % PageV01P324 11(@)(@@) % ومخضب رخص البنا % % ن بكى علي وما بكيته % % 12(@)(@@) % ودعاني الرشأ الغر % ير إلى اللعاب فما أتيته % 13(@)(@@) % ولقد أخذت من الصفا % % ما في الضمير وقد لويته % 14(@)(@@) % ويشوقني بيت الحبيب % % إذا غدوت ، وأين بيته % 15(@)(@@) % قام الخليفة دونه % % فصبرت عنه وما لقيته % % 16(@)(@@) % ونهاني الملك الهما % % م عن النساء وما عصيته % 17(@)(@@) % لا بل وفيت ولم أضع % عهدا ولا وأيا وأيته % % 18(@)(@@) % وأنا المطل على العدى % % وإذا غلا علق شريته % 19(@)(@@) % أصفي الخليل إذا دنا % % وإذا نأى عني رأيته % % 20(@)(@@) % وأميل في أنس النديم % % من الحياء وما اشتهيته % PageV01P325 21(@)(@@) % حال الصفاء على الصفا % % ء ولم يكن عودا بريته % 22(@)(@@) % فالأمر غير مقصر % لو خفت صاحبي اتقيته % % PageV01P326 البحر : - 1(@)(@@) % أراني قد تصابيت % % وقد كنت تناهيت % % 2(@)(@@) % تولى سقمي حتى % % إذا قلت تعليت % 3(@)(@@) % دهاني نكس الحب % بما قد كنت سديت % % 4(@)(@@) % فلم أبق على النفس % ولو أسطيع أبقيت % 5(@)(@@) % أناجي كلما أصبحت % جدواها وأمسيت % % 6(@)(@@) % وفيم أنا من عبد % ة لولا ما ترجيت % 7(@)(@@) % تأنى نظري فيها % % مليا وتأنيت % 8(@)(@@) % فلما لم أنل حظا % بما رحت وغاديت % 9(@)(@@) % تفردت بما أبديت % من حقي وأخفيت % 10(@)(@@) % كذي الوحدة نحاني % % هواها فتنحيت % % PageV01P327 11 
ms85	(@)(@@) % عدت عبدة في الهجر % وفي الحب تعديت % 12(@)(@@) % وعزم لا يواتيني % % عزاء لو تعزيت % 13(@)(@@) % ولكن غلب الحب % عزائي فتماديت % 14(@)(@@) % تعاطيت هوى عبد % % ة يأبى ما تعاطيت % 15(@)(@@) % هوى بالمنظر الأبعد % % إلا ما تمنيت % 16(@)(@@) % ومن أغرب من حاول % % في الأمر وقاسيت % 17(@)(@@) % خليل رأيه النأي % % ورأيي لو تدنيت % % 18(@)(@@) % ألا يا ليتني أدري % % ومن شر المنى ( ليت ) % 19(@)(@@) % أتوفي بالذي قالت % % كما قلت فأوفيت % 20(@)(@@) % فقد أشفى بي الحب % على الحتف فأشفيت % PageV01P328 21(@)(@@) % ولو قد يئست نفسي % % من البذل لأوديت % % 22(@)(@@) % وقوم زعموا أني % % من الشك تخليت % 23(@)(@@) % فأقسمت لهم ألا % % ولكني تجافيت % % 24(@)(@@) % ولو يتركني الحب % % لقد صمت وصليت % % 25(@)(@@) % كلا الميت وإيانا % % كما لاقى ولاقيت % % 26(@)(@@) % فما صاحبي الحي % % ولكن صاحبي الميت % % 27(@)(@@) % كأن قد فقت من وجد % بها يوما فقضيت % 28(@)(@@) % ولو يشهدني ذو ث % % قتي بعد لأوصيت % 29(@)(@@) % وحي من بني عمرو % % رآني قد تصديت % 30(@)(@@) % فقالوا لي ألا تجلس % إذ زرت فحييت % PageV01P329 31(@)(@@) % ومن عجب بعباد % ة قد أعجبني البيت % % 32(@)(@@) % يكن ما لا يرائيني % % إذا الوسواس ناجيت % 33(@)(@@) % وإني كلما شئت % بمن أهوى تعليت % 34(@)(@@) % فحدثتهم أني % % على الرجعة آليت % 35(@)(@@) % ولا أجلس في المجلس % س إلا ما تمسيت % 36(@)(@@) % أعبادة لو تنسا % % ك نفسي لتناسيت % % 37(@)(@@) % ولو كان التراخي عنك % ك يلهيني تراخيت % % 38(@)(@@) % تحليت بهجراني % % وبالحب تحليت % 39(@)(@@) % وما زلت بنا حتى % % بكت عيني وأبكيت % 40(@)(@@) % أثيبيني بما أتع % % بت نفسي وتعنيت % % PageV01P330 41(@)(@@) % فقد آثرك القلب % % على من كنت آخيت % 42(@)(@@) % فمن حاربت حاربت % ومن صافيت صافيت % PageV01P331 البحر : سريع 1(@)(@@) % يا سلم إن الرزق جم وقوت % % وليس بعد القول إلا السكوت % 2(@)(@@) % يا سلم نفسي بك مشغولة % شغل وداد دام لي ماحييت % % 3(@)(@@) % لا أشتهي السلوة إني امرؤ % زينت نفسي بهوى من هويت % % 4(@)(@@) % لاقيت من حبك جهد الهوى % % لله دري في الهوى ما لقيت ! % 5(@)(@@) % دفنتني حيا ولا ذنب لي % % والحي لا يدفن حتى يموت % % 6(@)(@@) % فاقضي بما شئت 
ms86	 على عاشق % قلبي مقر ولساني صموت % % 7(@)(@@) % بل أيها العاذل في حبها % % يجري ولا يدري ، كذاك المقيت % 8(@)(@@) % لم تدر ما حبي وعذبتني % % والشوق قد كاد بروحي يفوت % 9(@)(@@) % في مجسديها ظبي برية % قلبي عليها هالك مستميت % % 10(@)(@@) % أصبحت ظمآن إلى وجهها % % شوقا ولو أسقى بفيها رويت % PageV01P332 البحر : كامل تام 1(@)(@@) % من أبي هشام يا رجال قصيدة % تبكي لها الفتيان والفتيات % % 2(@)(@@) % كتبت بما جرت الدموع فصليت % أبدا على من قالها الصلوات % 3(@)(@@) % من داخل الشوق الدخليل إلى التي % % فيها تروح لعينه العبرات % 4(@)(@@) % ففؤاده طرا يعيش بذكرها % % ويموت حين تطله الزفرات % % 5(@)(@@) % شوقا إلى صنم العراق فعينه % % قد وكلت بمنامها اليقظات % 6(@)(@@) % ما من جميلة معشر إلا لها % % أخت تعد وما لها أخوات % % 7(@)(@@) % لا الشمس تقشرها ولا قمر الدجى % % وهما اللذان إليهما المثلات % 8(@)(@@) % قل للغواني إن قتلت من الهوى % % فلكن من عدوى دمي برآت % % 9(@)(@@) % سقمي عبيدة إن سقمت وصحتي % % ولها تطيب لنفسي الخلوات % % 10(@)(@@) % يا عبد أقسم بالذي أنا عبده % وله المقام وما حوت عرفات % % PageV01P333 11(@)(@@) % لا أصطفي أبدا سواك خليلة % فثقي بذلك والكرام ثقات % % 12(@)(@@) % ولو أنني في الترب ثم دعوتني % % لبيت صوتك والعظام رفات % 13(@)(@@) % فإذا ذكرتك يا عبيد تقطعت % % نفسي عليك وعادني حسرات % % 14(@)(@@) % طوبى لمن يمسي وأنت ضجيعه % قد عجلت لضجيعك الحسنات % % PageV01P334 البحر : مجزوء الرمل 1(@)(@@) % قل ' لحبى ' قربيني % % انت نفسي وحياتي % % 2(@)(@@) % وهمومي حين أغدو % % وحديثي في صلاتي % % 3(@)(@@) % ( حب ) إن البخل شر % ليس من فعل السراة % % 4(@)(@@) % فصليني أو دعيني % % نصبا للزائرات % % 5(@)(@@) % ' حب ' لو شئت التقينا % % مجلسا قبل الممات % % 6(@)(@@) % فأعشناك وعشنا % % بهنات وهنات % % 7(@)(@@) % قد تصبرت ولكن % ليس صبري بمواتي % % 8(@)(@@) % وتذكرتك في الحي % % ففاضت عبراتي % % 9(@)(@@) % وتناسيت لأنسى % % فاعتراني كالسبات % % 10(@)(@@) % وبدا لي ملك المو % ت يغشيني وفاتي % % PageV01P335 11(@)(@@) % إن ( حبى ) سحرتني % % بالأمامني والعدات % % 12(@)(@@) % بدلالا وحديث % % مثل تنوير النبات % % 13(@)(@@) % ولها عين وثغر % % من كبار الفتنات % 14(@)(@@) % وجمال ودلال % % مثل دل القاصرات % % 15(@)(@@) % أنا ممن عذب 
ms87	 الله % ه بحبى والوشاة % % 16(@)(@@) % فعلى ' حبى ' عويلي % % وإلى الله شكاتي % % PageV01P336 البحر : طويل 1(@)(@@) % ألا يا اسقياني بالرحيق ، فنيت % ولو بقيت ' حبى ' لنا لبقيت % 2(@)(@@) % أرى سقمي يزداد من أم مالك % ولو ذقت يوما ريقها لبريت % 3(@)(@@) % أظل كأني شارب سم حية % ويعتادني الوسواس حين أبيت % 4(@)(@@) % فسبحان ربي لا جلادة بعدما % % جريت وأبلاني الهوى فبليت % 5(@)(@@) % ظمئت فلم أظمأ إلى برد مشرب % ولكن إلى وجه الحبيب ظميت % % 6(@)(@@) % وقد وعدتنا نائلا ثم أخلفت % وقالت لنا يوم الفراق : نسيت % 7(@)(@@) % فما إن سقتنا شربة من رضابها % % ولو فعلت مات الهوى ورضيت % % PageV01P337 البحر : طويل 1(@)(@@) % فتاتي نديمي غنيا بحياتي % % ولا تقطعا شوقي ولا طرباتي % % 2(@)(@@) % يكلفني مولاكما الكأس غاديا % وكيف أطيق الكأس والعبرات % 3(@)(@@) % فقلت له : يكفيك ما قد أصابني % % من الحب في نومي وفي يقظاتي % % 4(@)(@@) % وما كل ما حملته النفس بالغا % رضاك ولا كل الخطوب تواتي % % 5(@)(@@) % فلا تسقني أصبحت من سكرة الهوى % % أميد ، ألا حسبي من السكرات % 6(@)(@@) % ذكرت حبيبي فاستهلت مدامعي % % وفي الدمع أشغال عن النشوات % % 7(@)(@@) % لقد قلت للعين المريضة بالهوى : % أفيقي وإن لم تفعلي فأسات % 8(@)(@@) % وعزيت نفسي عن عبيدة بالرقى % % لتسلى وما تسلى عن الرقيات % % 9(@)(@@) % فما أعتبتني العين من فيض عبرة % ولا يرعوي قلبي إلى دعوات % % 10(@)(@@) % وإني لأهواها وإن كنت كاذبا % فلا رفعت في الصالحين صلاتي % % PageV01P338 11(@)(@@) % تقطع قلبي زفرة بعد زفرة % عليها وما صبري على الزفرات ؟ % 12(@)(@@) % وأحجب زواري اغتباطا بخلوة % وما كنت أهوى قبلها خلواتي % % 13(@)(@@) % وأضمرها في النفس حتى كأنما % % أكلمها بين الحشا ولهاتي % % 14(@)(@@) % وجارية في مقلتيها لناظر % دواء وداء غير أم عدات % % 15(@)(@@) % دسست إليها منطقي ، وكسوتها % % مناسب مثل الوشي فالحبرات % 16(@)(@@) % فجاءت ثقال الردف مهضومة الحشا % % وكالشمس لاتلفى إلى أخوات % 17(@)(@@) % رأت خللا بين الهيون فأقبلت % % على خوف أعداء وخوف ولاة % % 18(@)(@@) % وقالت لتربيها : فقا دون حاجة % لنا عند أمثال المها خفرات % 19(@)(@@) % فإنكما إن تعرفا تزريا بنا % % وبعض الهوى يرتاد بالخلوات % 20(@)(@@) % فلما التقينا ضقت 
ms88	 ذرعا بما أرى % % وألقى عليها معشقي شبهاتي % % PageV01P339 21(@)(@@) % فقلت لنفسي : الشمس جلت لناظر % % أم البدر يجلى في قناع فتاة % 22(@)(@@) % فلم تر عيني مثل عيش سرقته % ولا مثل حسادي على السرقات % % 23(@)(@@) % وما كان إلا مأخذي بيمينها % % وعض بنان كن من فتنات % 24(@)(@@) % وموضع كف خضبت للقائنا % % على كبد مجنونة الهفوات % % 25(@)(@@) % فلولا التقى راحت ورحت عشية % نعد هنات بيننا وهنات % 26(@)(@@) % فيا مجلسا أبقى لقلبك ذكرة % على عدواء الشوق راديات % % 27(@)(@@) % إذا شئت أبكاني الحمام بصوته % % وهاج علي الشوق طول سباتي % % 28(@)(@@) % وعند ولي العهد شاف من الجوى % % فروحا عليه ذكرة بشكاتي % % 29(@)(@@) % لعل أمين الله موسى بن أحمد % يذوق لنا كأسا من السلوات % % 30(@)(@@) % هو الملك المأمول والقائم الذي % % يؤلف بين الذئب والنقدات % PageV01P340 31(@)(@@) % من المطعمين المنعمين نعده % ليوم لقاء أو لفك عناة % 32(@)(@@) % يقوم بأفعال النبي وقوله % % كوحي ابن بيض في صفاء صفات % 33(@)(@@) % إذا فزعت يوما لؤي بن غالب % رمى دونهم بالخيل معترضات % 34(@)(@@) % وإن دهموا في مأزق قام دونهم % % كما قام جاري النبل دون نبات % 35(@)(@@) % على ملكه ضمت قريش وأفرطت % % قبائل من ود له وعداة % % 36(@)(@@) % مصيخين من وقع السيوف كأنهم % % خراب تلوذ من صقور فلاة % % 37(@)(@@) % فقل للذي يرجو الخلافة بالمنى : % تنح لموسى صانع الحسنات % PageV01P341 البحر : خفيف تام 1(@)(@@) % قل لفرخ الزنجي : لا تشك ليثا % وتعوذ من شره ما استطعتا % % 3(@)(@@) % إن ليث القصباء لاقيك فارجع % % في حر جئت منه واستأن سكتا % % 4(@)(@@) % لوعرفت الرئبال يابن خليق % لتنصفت وجهه واستخرتا % % 5(@)(@@) % كان قد نام عن أذاك فآديت على % % رأسه فذق ما صنعتا % % 6(@)(@@) % كان لقط النوى ألذ وأشهى % % من قريض يفت رأسك فتا % % 7(@)(@@) % لم أشفع فيك الرجال ، ولو عا % % ش أخوك القواس شفعت رتا % % 8(@)(@@) % لنساء الزنجي فيمن يصلي % % صدقات فضحن بنتا وأختا % % 9(@)(@@) % وعلى وجهك المحتت سما % % خبرتنا عن استه خبث استا % % PageV01P342 البحر : مجزوء الرجز 1(@)(@@) % ذر خلتا ذر خلتا % % يابن خليق قد أتا % % 2(@)(@@) % ذر خلتا ذر خلتا % % هل لك 
ms89	 في أني فتى % % 3(@)(@@) % ذر خلتا ذر خلتا % % عرد إذا قام عتا % % 4(@)(@@) % ذر خلتا ذر خلتا % % سخن إذا جاء الشتا % % 5(@)(@@) % ذر خلتا ذر خلتا % % فعلت فيك القلتى % % 6(@)(@@) % ذر خلتا ذر خلتا % % قال : متى قال : متى % % 7(@)(@@) % ذر خلتا ذر خلتا % % فتت قلبي فتتا % % PageV01P343 البحر : مجزوء الكامل 1(@)(@@) % يا صاح قل في حاجتي : % أذكرتها فيما ذكرتا % % 2(@)(@@) % أو لا ترى أن العدا % % ت إذا التويت بها ذممتا % % 3(@)(@@) % وشح لبانة صاحب % واذكر بها ما كنت قلتا % % 4(@)(@@) % إن السراح مع السما % % ح إذا شقيت بما طلبتا % % 5(@)(@@) % والوعد من دين الكرام % % فما ترى فيما وعدتا % % 6(@)(@@) % أسهل مطالع حاجة % قصد اللسان بها وجرتا % % 7(@)(@@) % المال أهون هالك % والحمد أنفع ما استطعتا % % 8(@)(@@) % ومن العجائب أن ما % % منيتني ثم انقلبتا % % 9(@)(@@) % وبعثت وأية كاذب % وإذا وأيت لنا كذبتا % % 10(@)(@@) % فأراك تتبع ما يذم % % ولا تعيج بما حمدتا % % PageV01P344 11(@)(@@) % إن كان في الخطل الصوا % % ب فقد أصبت وما عجزتا % % PageV01P345 البحر : مجزوء الرمل 1(@)(@@) % هام قلبي باللواتي % % هن دائي وشقاتي % % 2(@)(@@) % ذهبت نفسي إليهن % بقلبي حسرات % 3(@)(@@) % ولقد قلت لراج % راحتي بالرقيات % % 4(@)(@@) % إنما تيم قلبي % % بقر في الحجلات % 5(@)(@@) % مثل ( عبادة ) فيهن % فتاة الفتيات % 6(@)(@@) % بهواها طال ليلي % % وبها طالت شكاتي % % 7(@)(@@) % أكثرت في القرب خلفي % % وعلى النأي عداتي % % 8(@)(@@) % ما الذي منتك إلا % % نظرة في الخطرات % 9(@)(@@) % أمسكت نفسي عليها % % بعد ما ملت لهاتي % % 10(@)(@@) % ولقد أغرى ( بعبا % % دة ' قول القائلات : % PageV01P346 11(@)(@@) % اسل عن ( عبدة ) قد انزفت % فيها العبرات % 12(@)(@@) % ولقد أيقن أني % % لا أطيع العاذلات % 13(@)(@@) % تيمتني إذ تهادت % % في ثلاث تائبات % 14(@)(@@) % بتهادي مرجحن % مثل مهتز القناة % 15(@)(@@) % واعتدال في قوام % % فوق نعت الناعتات % % 16(@)(@@) % وبخد خد شمس % % طالعت من مزنات % 17(@)(@@) % وبعيني بقر في % % بقر أو جؤذرات % % 18(@)(@@) % وبجيد جيد ريم % % يرتعي حر النبات % 19(@)(@@) % وبذي طعم شتيت % بارد عذب اللثات % 20(@)(@@) % طعمه من ذوب شه % د شيب بالماء الفرات % PageV01P347 21(@)(@@) % يصف الجارات منه % % نفحة المسك 
ms90	 الفتات % 22(@)(@@) % عظتي فيها رويدا % قد مللت الواعظات % % 23(@)(@@) % لا أطيع الناس فيها % % أبدا حتى الممات % 24(@)(@@) % تلك أسقامي وبرئي % % من سقامي لو تواتي % % 25(@)(@@) % ومنى نفسي وهمي % % في مقيلي وبياتي % % 26(@)(@@) % ونعيمي حين أغفي % % وشفاء اليقظات % 27(@)(@@) % والتي أمسي وأغدو % % في عشي وغداة % 28(@)(@@) % ذاهب اللب إليها % % معلنا بالزفرات % % 29(@)(@@) % فإذا قمت أصلي % % عرضت لي في صلاتي % % 30(@)(@@) % ليتني أعطيت منه % % ليلة في حسناتي % % PageV01P348 31(@)(@@) % وكأني من هواها % % ببكاء وصمات % 32(@)(@@) % فاشفني بالصبر منها % % يا مجيب الدعوات % 33(@)(@@) % او أذقها يوم عني % % كربة من كرباتي % % 34(@)(@@) % بلغت بي من هواها % % فوق ما سر عداتي % % 35(@)(@@) % صاح أوصيك إليها % % ثقة فاحفظ وصاتي % % 36(@)(@@) % قل ' لعبادة ' ردي % % بعض خزني وأذاتي % % 37(@)(@@) % ' عبد ' أصبحت حياتي % % فصليني يا حياتي % % 38(@)(@@) % أغلقي عني بوصل % باب سقمي وأذاتي % % 39(@)(@@) % وإذا ما مت فابكي % % لطفا في الباكيات % % 40(@)(@@) % لا تكوني مثل أخرى % % تتجنى جفواتي % % PageV01P349 41(@)(@@) % فلقد أصفيتك الش % % عر برغم الحاسدات % % PageV01P350 البحر : بسيط تام 1(@)(@@) % يأيها الراكب الغادي لطيته % % لا تطلب الخبز بين الكلب والحوت % 2(@)(@@) % دينار آل سليمان ودرهمهم % % كالبابليين حفا بالعفاريت % 3(@)(@@) % لا يوجدان ولا يرجى لقاؤهما % % كما سمعت بهاروت وماروت % PageV01P351 البحر : طويل 1(@)(@@) % خليلي عوجا بي على طرباتي % % فوالله لا أنسى الحبيب حياتي % % 2(@)(@@) % وما ذقت طعم النوم مذ مسني الهوى % % ولا الكأس إلا ماؤها عبراتي % % 3(@)(@@) % ودارت صبابات الهوى بمسامعي % % كما درا مخمور من النشوات % % 4(@)(@@) % لقد تركتني من هواها كأنني(@)(@@) % هبنقة ) القيسي ذو الودعات % 5(@)(@@) % دعاها الهوى والحب نحوي فأرسلت : % عليك سلام الله في البركات % 6(@)(@@) % تلاعب أترابا كأن عيونها % % غداة التقينا أعين البقرات % 7(@)(@@) % حلفت بمن حد الملبون بيته % وبالخيف والرامين للجمرات % 8(@)(@@) % لتقبيل خديها ومص لسانها % % ألذ من الباكين في عرفات % % PageV01P352 البحر : مجزوء الوافر 1(@)(@@) % ربابة ربة البيت % % تصب الخل في الزيت % % 2(@)(@@) % لها عشر دجاجات % وديك حسن الصوت % % PageV01P353 البحر : رجز تام 1(@)(@@) % يا بنت من لم يك يهوى بنتا % % ما كنت إلا خمسة أو ستا % % 2(@)(@@) % حتى حللت 
ms91	 في الحشى وحتى % % فتت قلبي من جوى فانفتا % % 3(@)(@@) % لأنت خير من غلام بتا % % يصبح سكران ويمسي بهتا % % PageV01P354 البحر : متقارب تام 1(@)(@@) % أتوب إليك من السيآ % % ت وأستغفر الله من فعلتي % % 2(@)(@@) % تناولت ما لم أرد نيله % % على جهل أمري وفي سكرتي % % 3(@)(@@) % ووالله والله ما جئته % % لعمد وما كان من همتي % % 4(@)(@@) % وإلا فمت إذن ضائعا % وعذبني الله في ميتتي % % 5(@)(@@) % فمن نال خيرا على قبلة % % فلا بارك الله في قبلتي % % PageV01P355 البحر : مجزوء الكامل 1(@)(@@) % يا عبد أنت ذخيرتي % % نفسي فدتك وجيرتي % % 2(@)(@@) % الله يعلم فيكمو % % يا عبد حسن سريرتي % % 3(@)(@@) % نفسي لنفسك خلة % % وكذاك أنت أميرتي % % PageV01P356 البحر : طويل 1(@)(@@) % وأعرج يأتينا كظل نعامة % % يقوم على الأبواب في السبرات % PageV01P357 البحر : طويل 1(@)(@@) % إذا ما أمور الناس رثت وضيعت % % وجدت أموري كلها قد رممتها % % PageV01P358 البحر : خفيف تام 1(@)(@@) % تمركم يا سهيل در وهل يط % مع في الدر من يدي متعت % 2(@)(@@) % فاحبني يا سهيل من ذلك الت % % مر نواة تكون قرطا لبنتي % % PageV01P359 البحر : مجزوء الكامل 1(@)(@@) % أخداش أنت ابن الثلا % % ثة ليس فوقهمو ثلاثه % 2(@)(@@) % ليزيد بن مخلد % ثم المهلب ذي النباثه % 3(@)(@@) % بهمو تفرعت العلى % % ونزلت من بلد دماثه % % 4(@)(@@) % النازلين على المنية % سيوف لهم حثاثه % % 5(@)(@@) % قوم أحلوك الذرى % % وبنوا بناءك في الدماثه % % 6(@)(@@) % فالضامنين لجارهم % % ولكل منتجع غياثه % 7(@)(@@) % ركب لعيدان الملو % % ك ، عن المكارم غير راثه % 8(@)(@@) % ذهبوا وحزت تراثهم % % والمرء مصطنع تراثه % 9(@)(@@) % فاحرث حراثة والد % % كان السماح له حراثه % % 10(@)(@@) % ودع الملاثة إنه % داء على النجح الملاثه % % PageV01P360 11(@)(@@) % تمم بفضل يد يدا % % PageV01P361 البحر : سريع 1(@)(@@) % يا ' سلم ' هل قيمكم ماكث % % وهل لغادي من غد رائث % % 2(@)(@@) % قد بلغت نفسي مدى حبها % % وزادني وجدا بك الحادث % % 3(@)(@@) % يا ' سلم ' إني ملال الهوى % % في نصب يفري ويستأنث % % 4(@)(@@) % كيد من الخرطوم يضحي به % كأنما يبعثه باعث % % 5(@)(@@) % يا ' سلم ' رجعاك بميت الهوى % % كما تميت الحية النافث % % 6(@)(@@) % أقول للناي وقد مثه : % أصغن بما ضن به المائث 
ms92	 % 7(@)(@@) % يا حسن سلمى حين يحدو بها % % لا عجل السوق ولا رائث % 8(@)(@@) % بيضاء صفراء قضافية % وإنما يشفى بها الباحث % 9(@)(@@) % تميل شقيها إذا ما مشت % كأنما يخنثها خانث % % 10(@)(@@) % تلك التي لو نلتها والهوى % % والسقم بين الأضلع الآرث % PageV01P362 11(@)(@@) % كأنما في كبدي قرحة % من حبها يفرثها فارث % 12(@)(@@) % لو ذقتها يقظان أو نائما % عشت ولم يكرثني الكارث % 13(@)(@@) % وصاحب كالسيف جردته % لا ماذق ودا ولا ناكث % 14(@)(@@) % من المميتين هموم الفتى % % يعبث في معروفه عابث % % 15(@)(@@) % لا يعبد المال ويبكي العدى % % بالخيل لا وان ولا لائث % 16(@)(@@) % صحبته في الملك أو سوقة(@)(@@) % في مذهب حداده باحث ) % 17(@)(@@) % لما رآني جئته زائرا % بالمحض لا يغلثه غالث % % 18(@)(@@) % كسا وأعطى من ذرى ماله % % بعثا ولا يبقي لك الباعث % % 19(@)(@@) % وعجرد ينزو على أمه % خنزيرة يرغثها راغث % 20(@)(@@) % كأنه حين تصدى له % طالب عرف أسد شارث % % PageV01P363 21(@)(@@) % وكيف يؤديك على طائل % من لا يصلي إنه طامث ! % 22(@)(@@) % يا بن شبيرى أنت علج القا % % طير ومنك الخبث الخابث % % 23(@)(@@) % لما تعبثت بعبثت بي % % والليث لا يلهو به العابث % % 24(@)(@@) % وكنت كالباحث عن مدية % % 25(@)(@@) % أصبحت من كأس تغبقتها % % بعد كئاس مرها دالث % 26(@)(@@) % كأن في رأسك ذا آمة % % أو دب فيه شبث شابث % % 27(@)(@@) % هلا على أمك يوم الرجا % % حاميت والجون بها لاهث % 28(@)(@@) % سامى برجليها وطابت له % عجزاء منها الأنث الآنث % 29(@)(@@) % كأن أيرا في استها في استه % يخفى ويبدو أجرد نابث % % 30(@)(@@) % ووالث عهدا لنا عنده % % ثم انثنى عن عهده الوالث % % PageV01P364 31(@)(@@) % كأنما لم يك ودي له % والنصح لا عر ولا واعث % 32(@)(@@) % ضيع حرثي رجل هالك % موقا ، ونعم الحرث والحارث % 33(@)(@@) % يا حارث المهري أنت امرؤ % شبعان لا يحمدك الغارث % % 34(@)(@@) % كأن من يعنى بتضبيعه % رأس يتيم قمل شاعث % % 35(@)(@@) % أنكرتني حين عرفت الغنى % % أف وتف لك يا حارث % % 36(@)(@@) % فاشرب بكأسيك ولا تسقني % % عما قليل يورث الوارث % % 37(@)(@@) % آليت أرضى بالذي سمتني % % أو يبعث الموتى لنا باعث % % PageV01P365 البحر : متقارب 
ms93	 تام 1(@)(@@) % ومرت فقالت : متى نلتقي ؟ % فهش اشتياقا إليها الخبيث % % 2(@)(@@) % وكاد يمزق سرباله % % فقلت : إليك يساق الحديث % PageV01P366 البحر : منسرح 1(@)(@@) % تحمل الظاعنون فادلجوا % % والقلب مني الغداة مختلج % 2(@)(@@) % بانوا بخود كأن رؤيتها % % بدر بدا والظلام مرتهج % 3(@)(@@) % غراء ريا العظام آنسة % مكسورة العين زانها دعج % % 4(@)(@@) % يا ويح نفسي أما لنا أبدا % من حبها سلوة ولا فرج % 5(@)(@@) % إن يك أمسى الغيور حصنها % % وغيرتها الشهور والحجج % 6(@)(@@) % فقد لهونا في ظل . . % والدهر فيه القوام والعوج % % 7(@)(@@) % ولو ترانا مع الجلاء إذا % بدا لعينيك منظر بهج % % 8(@)(@@) % يا حسنها إذ تقول مازحة % ونحن فوق السرير نعتفج % 9(@)(@@) % لقد حرجنا وهي معانقتي % % تلثمني والصباح منبلج % % 10(@)(@@) % فقلت : يا منيتي ويا سكني % % ما في عنا وقبلة حرج ! % PageV01P367 البحر : مجزوء الخفيف 1(@)(@@) % قل لسعدى : تحرجي % % وجهيني لمخرجي % % 2(@)(@@) % لا تكوني علي كالنفس % نفس إن تنه تلجج % % 3(@)(@@) % منك طيف يزورني % % ويرى كل منهج % % 4(@)(@@) % فإلى الله مشتكا % % ي من الهائم الشجي % % 5(@)(@@) % غرني منك وافد % % بالحديث الملهوج % 6(@)(@@) % فعديني ثم انجزي % % أنا خاش ومرتجي % % 7(@)(@@) % وكأني سلبت نو % مي بسحر المهيج % 8(@)(@@) % ومتى تذكري الصدو % % د أعول وأنشج % % 9(@)(@@) % أنت همي في مجلسي % % ومقيلي ومدرجي % % 10(@)(@@) % فاذكري ليلة الخميس % % لساني الملجلج % % PageV01P368 11(@)(@@) % ووقوفي خلف الريا % % ح بليل مدجج % % 12(@)(@@) % ومسيري إليك من % % بحر ليل ملجج % 13(@)(@@) % أرقب البدر كي أرى % % وجه بدر متوج % 14(@)(@@) % فالتقينا على العتا % % ب ننادي وننتجي % % 15(@)(@@) % وابن سلمان ساقط % كالحمار المودج % 16(@)(@@) % لا يراني وقد أرى % % وجهه غير أبلج % PageV01P369 البحر : بسيط تام 1(@)(@@) % ' خشاب ' هل لمحب عندكم فرج % أو لا فإني بحبل الموت معتلج % % 2(@)(@@) % لو كان ما بي بخلق الله كلهم % لا يخلصون إلى أحبابهم درجوا % % 3(@)(@@) % للهجر نار على قلبي وفي كبدي % % إذا نأيت ، ورؤيا وجهك الثلج % 4(@)(@@) % كأن حبك فوقي حين أكتمه % % وتحت رجلي لج فوقه لجج % 5(@)(@@) % قد بحت بالحب ضيقا عن جلالته % وأنت كالصاع تطوى تحته السرج % 6(@)(@@) % خشاب جودي جهارا أو مسارقة 
ms94	 % فقد بليت ومرت بالمنى حجج % 7(@)(@@) % حتى متى أنت يا خشاب جالسة % لا تخرجين لنا يوما ولا تلج % 8(@)(@@) % لو كنت تلقين ما نلقى قسمت لنا % % يوما نعيش به منكم ونبتهج % % 9(@)(@@) % لا خير في العيش إن كنا كذا أبدا % لا نلتقي وسبيل الملتقى نهج % 10(@)(@@) % من راقب الناس لم يظفر بحاجته % وفاز بالطيبات الفاتك اللهج % PageV01P370 11(@)(@@) % وقد نهاك أناس لا صفا لهم % % عيش ولا عدموا خصما ولا فلجوا % % 12(@)(@@) % قالوا : حرام تلاقينا فقد كذبوا % % ما في التزام ولا في قبلة حرج % 13(@)(@@) % أما شعرت ، فدتك النفس جارية % أن ليس لي دون ما منيتني فرج % 14(@)(@@) % إني أبشر نفسي كلما اختلجت % عيني ، أقول : بنيل منك تختلج % 15(@)(@@) % وقد تمنيت أن ألقاك خالية % يوما وأني وفيما قلت لي عوج % % 16(@)(@@) % أشكو إلى الله شوقا لا يفرطني % % وشرعا في سواد القلب تختلج % 17(@)(@@) % يا رب لا صبر لي عن قرب جارية % % تنأى دلالا وفيها إن دنت غنج % % 18(@)(@@) % غراء حوراء من طيب إذا نكهت % للبيت والدار من أنفاسها أرج % % 19(@)(@@) % كأنها قمر راب روادفه % عذب الثنايا بدا في عينه دعج % PageV01P371 البحر : طويل 1(@)(@@) % أجارتنا أخطأت حظك فاخرجي % % ولا تدخلي بيني وبين المشمرج % 2(@)(@@) % أخي لامني أو لمته ثم نرعوي % % إلى ثابت من حلمنا غير مخدج % 3(@)(@@) % نعود إذا اعوج سبيل بأهلها % % حفاظا وليس الحق فينا بأعوج % 4(@)(@@) % فأبقي على ود كرهطك عندنا % % ولا تذهبي في التيه يابنة مغنج % 5(@)(@@) % أنا الشاعر المشهور في كل موطن % أحل بمثل السيف غير ملجلج % % 6(@)(@@) % تركت ابن نهيا ضحكة لابن سالم % % وأضحكت حمادا من است المعفج % 7(@)(@@) % وإني لنهاض اليدين إلى العلى % % قروع لأبواب الهمام المتوج % % 8(@)(@@) % أهون إذا عز الخليط ، وربما % % أمت برأس الحية المتمعج % 9(@)(@@) % وما زال لي جد يقيني من الردى % % ويسمو على رغم العدو المزلج % % 10(@)(@@) % وما ذاك من حول ولكن كرامة % من الله يرعاني بها كل منهج % PageV01P372 11(@)(@@) % يرى لي ذوو الأحساب فيهم جلالة % وليس خليلي بالدني الملهوج % 12(@)(@@) % وعير أناس 
ms95	 قد كويت عجانه % إذا ما كويت العير يوما فأنضج % % 13(@)(@@) % وإني ومدحي هيثما أبتغي الندى % % لكالمبتغي المعروف في است ابن دعلج % 14(@)(@@) % وليلة خرطوم وصلت نعيمها % % بحوراء تستحيي إذا لم تحرج % % 15(@)(@@) % لباخية الأرداف لم ترع ثلة % بفيء ولم تركب بعيرا بهودج % % 16(@)(@@) % وبيضاء يندى خدها وجبينها % % من المسك فوق المجمر المتأجج % % 17(@)(@@) % فباتت مزاج الكأس حتى تبينت % تباشير منشق عن الصبح أبلج % % 18(@)(@@) % فلما دنا وجه الوداع تفجعت % على ليلة طابت وسر مولج % % 19(@)(@@) % وقالت لتربيها ابكيا وترقرقت % % مدامع عينيها تخاف وترتجي % % 20(@)(@@) % فيا حسنها إذ نلتقي بمهايل % محبين في بحر من الحب نلتجي % % PageV01P373 21(@)(@@) % ليالي قالت : أنت غاد ضحى غد % ونبقى على شوق إليك وننشج % % 22(@)(@@) % هناك التقينا تحت عين مطيرة % وريان ملقى كالحمار المودج % 23(@)(@@) % فبت ببدر يملأ العين نوره % % هضيم الحشا في الزعفران مضرج % % 24(@)(@@) % إذا أحرقتني الكأس داويت حرها % % بمثلوجة في نظم در مفلج % 25(@)(@@) % وكيف بسلمى أحرم النأي وجهها % % علي وإن طافت بنا لم تعرج % 26(@)(@@) % وقد زوجت عثمان درا غريرة % فيا ليتني عثمان إذ لم تزوج % PageV01P374 البحر : طويل 1(@)(@@) % أ ( عاتك ) بعض الود مر ممزج % % وليس من أقوال الخليفة أعوج % 2(@)(@@) % له حين ينأى مذكر من سماحة % يعود به طلقا ولا يتلجلج % 3(@)(@@) % أ ( عاتك ) ظني بالخليفة همة % وقولي : كريم ماجد يتحرج % 4(@)(@@) % يفيء إلى حلم ويصدق نجدة % وتنساب منه الحية المتمعج % % 5(@)(@@) % وفي القوم ميلاع وليس بنافع % يضج كما ضج القعود المحدج % % 6(@)(@@) % لبست الغنى طورا وأحوجت تارة % ومن ذا من الأحرار لا يتحوج % % 7(@)(@@) % ولما رأيت الناس تهوي قلوبهم % إلى ملك يجبى إليه الشمرج % 8(@)(@@) % عرضت إلى وجه الحبيب وراعني % % غزال عليه زعفران مضرج % % 9(@)(@@) % ونازعني شوقي إلى ملك قدى % % وداع إلى ' المهدي ' لا يتلجلج % % 10(@)(@@) % فوالله ما أدري : أأجلس قانعا % إلى المصر أم ألقى الإمام فأفلج % % PageV01P375 11(@)(@@) % وإني لميلاع مرارا وربما % % تصدع عني المجلس المتوشج % 12(@)(@@) % أقول وقد دفت إلي عصابة % من القوم منها حاسر ومدجج % 13(@)(@@) % أ ' واقد ' ذب 
ms96	 القوم عني بزجرة % وهات نصيحا لا يطيب الملهوج % % 14(@)(@@) % ولا تبك من خيس بباب خليفة % يذل عليه القسوري الخمرنج % % 15(@)(@@) % يطيعك في التقوى ويعطيك في الندى % % ولا تلقه إلا وللجود أمعج % 16(@)(@@) % أرقت إلى بطن الخرين ورغبتي % % إلى ملك يجلو الدجى حين يخرج % 17(@)(@@) % من الصيد مكتوب على حر وجهه : % جواد قريش هاشمي متوج % % 18(@)(@@) % يصب دماء الراغبين عن الهدى % % كما صب ماء الظبية المترجرج % % 19(@)(@@) % ولا بد أني راحل للقائه % % فقد بشرت بالنجح عين تخلج % 20(@)(@@) % لقد سرني فأل جرى من موفق % وتأويل ما قال الغراب المشحج % % PageV01P376 21(@)(@@) % فهيجت مرقال العشي شملة % تزف كما زف الهجف السفنج % % 22(@)(@@) % تلوح لغامات النجاء بوجهها % % كما لاح بيت العنكبوت المنسج % % 23(@)(@@) % تعز عن الحوراء إن مقامنا % % عليها وترك الملك رأي مزلج % 24(@)(@@) % سألقى أمير المؤمنين لحاجتي % % وإن عط في حجر الفتاة الخدلج % 25(@)(@@) % فتى الدين قواما به وفتى الندى % % ونعم لزاز الحرب حين تبرج % 26(@)(@@) % لقد زين الإسلام ملك محمد % وفي الحرب للأعداء نار تأجج % 27(@)(@@) % إمام الهدى أمسكت بعد كرامتي % % وقد كنت تعطيني ووجهك أبلج % % 28(@)(@@) % إمام الهدى صغوي إليك وحاجتي % % ولي حشم أصغى إليك وأحوج % % 29(@)(@@) % فلو كان حرماني يزيدك نعمة % ثلجت به ، إني بما نلت أثلج % 30(@)(@@) % لعمري لقد أشمت بي غير نائم % % فنام وهمي ساهر يتوهج % PageV01P377 31(@)(@@) % أخاف انقطاع الدر بعد ابتزازه % % وتبليغ من يسدي الحديث وينسج % % 32(@)(@@) % وقد تبت فاقبل توبتي يابن هاشم % % فإن الذي بيني وبينك مدمج % % 33(@)(@@) % وما لك لا ترجى وأنت خليفة % تحج كما حج الدوار المدلج % % 34(@)(@@) % وإن سر حسادي فسيبك واسع % على الناس لا يسطيعه المتفجفج % % 35(@)(@@) % فدونك فامسكها أو اعط فإنها % % زواريق من كفيك للناس تخرج % % 36(@)(@@) % فضول فتى أسخى يدا في سبيلها % % ففاضت عبابا أو حواري ينسج % % 37(@)(@@) % ستحمد ما يأتي إذا بلغ المدى % % وضمك في الفردوس ظل وسجسج % 38(@)(@@) % صنيع امرئ أعطاه رب محبة % وللخير صناع وللبر منهج % % 39(@)(@@) % تجيء مواعيد الكرام سوية % وتنضى مواعيد اللئام فتخدج % % 40(@)(@@) % ولي 
ms97	 حاجة لا تدريها بحجة % إلى ملك يجلو الدجى حين يخرج % PageV01P378 البحر : طويل 1(@)(@@) % أ ' خشاب ' حقا أن دارك تزعج % % وأن الذي بيني وبينك ينهج % % 2(@)(@@) % إلى الله أشكو أن بالقلب كربة % من الشوق لا تبلى ولا تتفرج % 3(@)(@@) % أقول لأصحابي : دعوني وهينة % لبحر الهوى لا شك أني ملجج % % 4(@)(@@) % لخشابة السلوان والعطر والجنا % % ولي حرق تحت الهوى تتوهج % % 5(@)(@@) % تقطع نفسي حسرة بعد حسرة % إذا قيل : تغدو من غد لا تعرج % 6(@)(@@) % ومن نكد الأيام سيقت لعانس % من اللؤم لا يندى ولا يتبلج % 7(@)(@@) % ولم أعط فيها حيلة غير أنني % % أحن إلى ما فات منها وأنشج % 8(@)(@@) % دعوت بويل يوم راح عتادها % % وأودعني الزفزاف ليلة أدلجوا % % 9(@)(@@) % وقد زادني وجدا عليها وما درت % % مجامر في أيدي الجواري تأجج % 10(@)(@@) % بعمن منصور المغيري جماله % وقلبي له هذا من الحلم أعوج % % PageV01P379 11(@)(@@) % وما خرجت فيهن حتى عذلنها % % قياما وحتى كادت الشمس تخرج % 12(@)(@@) % فقامت عليها نظرة واستكانة % تساقط كالنشوى حياء وتنهج % 13(@)(@@) % وما كان مني الدمع حتى توجهت % مع الصبح يقفوها الفنيد المسرج % 14(@)(@@) % فيا عبرا من بينها قبل نيلها % % ومن سفط فيه القوارير تحرج % 15(@)(@@) % خرجن به في حجر أخرى كأنه % بني ليال في المعاوز يدرج % % 16(@)(@@) % وقربن ممهود السراة كأنما % % غدا في ديايورد الكسا يترجرج % 17(@)(@@) % كنجم الدجى إذ لاح ، لا ، بل كأنه % سنا نار نشوان تشب وتبلج % 18(@)(@@) % فلما دنا منها بكت من دنوه % وقلنا لها : قومي اركبي الصبح أبلج % % 19(@)(@@) % وفدينها كيما تخف فاعرضت % تجشم مما سمنها وتغنج % 20(@)(@@) % وما زلن حتى أشرفت لعيونهم % وغنى المغني واليراع المفلج % % PageV01P380 21(@)(@@) % ولما جلاها الشمع سبح ناظر % وكبر رفاف وساروا فأرهجوا % % 22(@)(@@) % وما صدقت رؤياي يحففن مركبا % وفي المركب المحفوف بدر متوج % 23(@)(@@) % ويا كبدا قد أنضج الشوق نصفها % % ونصف على نار الصبابة ينضج % % 24(@)(@@) % إذا ركبت منا بليل فقل لها : % عليك سلام مات من يتزوج % 25(@)(@@) % بكيت وما في العين مني خليفة % ولكن أحزانا علي تولج % 26(@)(@@) % ولو مت كان 
ms98	 الموت خيرا من الشقا % % وما للفتى مما قضى الله مخرج % PageV01P381 البحر : - 1(@)(@@) % أتفخر بعد . . . بني قشير % وأنت مخنث فيك اعوجاج % 2(@)(@@) % تعادي في الصباح عمود فرو % كما تعدو على القدر الدجاج % PageV01P382 البحر : بسيط تام 1(@)(@@) % تجلو بمسواكها عن بارد رتل % % كذاك خبرني مسواكها الأرج % PageV01P383 البحر : كامل تام 1(@)(@@) % نزلت نجوم الليل فوق رؤوسهم % % ولكل قوم كوكب وهاج % PageV01P384 البحر : مجزوء الرمل 1(@)(@@) % إن عمرا فاعرفوه % % عربي من زجاج % 2(@)(@@) % مظلم النسبة لا % % يعرف إلا بالسراج % PageV01P385 البحر : كامل أحذ 1(@)(@@) % قاس الهموم تنل بها نجحا % % والليل إن وراءه صبحا % % 2(@)(@@) % لا يؤيسنك من مخدرة % قول تغلظه وإن جرحا % % 3(@)(@@) % عسر النساء إلى مياسرة % والصعب يمكن بعد ما رمحا % % 4(@)(@@) % بل كيف يحمل طول ليلته % قلق الوساد يبيت مجتنحا % % 5(@)(@@) % قال ابن حاجته التي كتمت % % وطبيبه للقلب إن قرحا % % 6(@)(@@) % ما بال يومك لا تسر به % لتروح ذاك اليوم أو تلحا % % 7(@)(@@) % فأجبته بمقالة صدقت % وأخوك تصدقه وإن كلحا % % 8(@)(@@) % إن الحبيب طوى زيارته % % وشجيت بالمكتوم إن صرحا % % 9(@)(@@) % أرقي لشخص ما يفارقني % % ويحبه قلبي وإن نزحا % % 10(@)(@@) % لما تبين أنني كلف % بحديثه وبقربه صفحا % % PageV01P386 11(@)(@@) % شهد اللسان بما أجن له % والدمع يشهد كلما سفحا % % 12(@)(@@) % أشقى بما لاقيت من سكني % % أحببته وأثابني نزحا % % 13(@)(@@) % ندما عليه غداة فارقني % % هلا أباعده فإن ملحا % % 14(@)(@@) % يا بعد قلبي من مودته % % أمسى بصالحة وما صلحا % % 15(@)(@@) % قد كان يمنحني صبابته % % وأثبته ودي بما منحا % % 16(@)(@@) % فتبدلت سعدى بشيمتها % % شيما لتكدح غير ما كدحا % % 17(@)(@@) % صبرت سعيدة لا تساعفني % % وجزعت من مس الهوى مرحا % % 18(@)(@@) % تعس الفؤاد ! ألا يصابرها % % حتى تكون كمازح مزحا % % 19(@)(@@) % ومسهر في العين تحسبه % يبدي نصيحته وما نصحا % % 20(@)(@@) % ختمت على قلبي بخاتمها % % ويلومني في حبها ، قبحا % % PageV01P387 21(@)(@@) % وظللت أصدقه وأكذبه % حتى يبايعني وما ربحا % % 22(@)(@@) % لا تلحني حبا وأنت فتى % % فمشايعي قلبي وإن طمحا % % 23(@)(@@) % ( وهو ) المعلق عند غانية % بعد النوال ببارق لمحا % % 24(@)(@@) % لو زاده ربي لخلته % % حبا كعين الذرة 
ms99	 افتضحا % % 25(@)(@@) % أخشى الردى حزنا إذا شحطت % % وأخافه بدنوها فرحا % % 26(@)(@@) % جد الهوى فجددت أطلبها % % لتريح من عيش الذي سرحا % % 27(@)(@@) % لم يلق مثلي في مواظبة % لشفائها ممن صبا وصحا % % 28(@)(@@) % نهى فؤادي عن تذكرها % % ويزيدني عيا إذا جمحا % % 29(@)(@@) % ليت المنى ردت لنا زمنا % كزماننا ذاك الذي نزحا % % 30(@)(@@) % إذ مدخلي سرق أسارقه % للقاء أحور زين الوشحا % % PageV01P388 31(@)(@@) % حسن الدلال على ثنيته % مسك يحييني إذا نفحا % % 32(@)(@@) % برحت بأتلع في قلائده % وغدت تهز روادفا رجحا % % 33(@)(@@) % لم أنس مجلسنا وقينتها % % ونباح مزهرها إذا نبحا % % 34(@)(@@) % بيدي مسورة تزينه % بسماعها وسماعها سرحا % % 35(@)(@@) % حتى إذا أخذت برمته % وحنت عليه م لجينا مرحا % % 36(@)(@@) % ارتج واندفعت تعارضه % غناء خالط صوتها بححا % % 37(@)(@@) % في مجلس رقدت غوائله % وصلت به الإبريق والقدحا % % 38(@)(@@) % ترد السرائر ثم تصدرها % % تحت الظلام ولا تري كشحا % % 39(@)(@@) % حتى إذا انكشفت دجنته % وتنبه العصفور أو صدحا % % 40(@)(@@) % طرد الصباح لعاشق غزل % يهوى جنوح الليل إن جنحا % % PageV01P389 41(@)(@@) % سقيا لتلك على تثاقلها % % ولطيب عارضها إذا رشحا % % 42(@)(@@) % بت النجي على نمارقها % % وسلبتها في الصبح إذ وضحا % % PageV01P390 البحر : طويل 1(@)(@@) % خليلي ما بال الدجى لا تزحزح % وما بال ضوء الصبح لا يتوضح % 2(@)(@@) % أضل الصباح المستنير سبيله % أم الدهر ليل كله ليس يبرح % 3(@)(@@) % وطال علي الليل حتى كأنه % بليلين موصول فما يتزحزح % % 4(@)(@@) % كأن الدجى زادت وما زادت الدجى % % ولكن أطال الليل هم مبرح % 5(@)(@@) % لقد هاج دمعي نازح بنزوحه % ونومي إذا ما نوم الناس أنزح % 6(@)(@@) % وقال نساء الحي : مالك صافحا % وما كنت عن أنس الأوانس تصفح % 7(@)(@@) % فقلت : لسعدى شافع من مودتي % % إذ رمت أخرى ظل في القلب يقدح % 8(@)(@@) % أبيت كأني للهموم ت . . . . . . . % . . . . . . . . . . . . . . . . . . . . . % 9(@)(@@) % أرقت إلى سعدى فمن . . . % . . . . . . . . . . . . . . . . . . . . . . % 10(@)(@@) % أسرح فما لا . . . . . . . . . . . . % . . . . . . . . . . . . . . . . . . . . . . . % PageV01P391 11(@)(@@) % فدرت ودارت بي البلاد كأنني % % من العي في . . . . . . . . . . % 12(@)(@@) % فقلت أفي ذنب أتاك أتيته % تأنيب أم . . . . . . . . . . . . . . . % 13(@)(@@) % فقالت لنأي في القصيرة معت % . . . . . . . . . . . . . . . . . . . . . . . % 14(@)(@@) % وجنية الأعلا رداح خريدة % . . . . . . . . . . . . . . . . . . . . . . % 15(@)(@@) % إذا جاوزتها العين لم تلق 
ms100	 لذة % بعيش ولا . . . . . . . . . . . . . . . . . % 16(@)(@@) % يخف بأحشائي إليها صبابة % وتطرق بالهجران عيني فتسفح % % 17(@)(@@) % فيا طول هذا الليل لا أعرف الكرى % % ولا الصبح فيه راحة فأروح % 18(@)(@@) % أناسية سعدى هوائي بعدما % % لهونا بها عصرا نخف ونمزح % 19(@)(@@) % محبين معشوقين نغرق في الهوى % % مرارا وطورا نستقل فنسبح % 20(@)(@@) % كأن هوانا في العقاب وفي الرضى % % سرابيلنا تنشق عنا وتنضح % PageV01P392 21(@)(@@) % ليالي نقتاد الهوى ويقودنا % % على رصدات العين والكلب ينبح % 22(@)(@@) % فقد ساغ للغيران من ذاك ريقه % ونام العدى حتى افترقنا وأنجحوا % % PageV01P393 البحر : متقارب تام 1(@)(@@) % تثاقل ليلي فما أبرح % % ونام الصباح فما أصبح % 2(@)(@@) % وكنت امرأ بالصبا مولعا % وباللهو عندي له مفتح % 3(@)(@@) % لقد كنت أمسي على طربة % وأصبح من مرح أمرح % 4(@)(@@) % فلما نهاني إمام الهدى % % ولاح لي المطلع الأفيح % % 5(@)(@@) % وجارية دلها رائع % تعف فإن سامحت تمزح % % 6(@)(@@) % كأن على نحرها فأرة % من المسك في جيبها تذبح % % 7(@)(@@) % كأن القرون على متنها % % أساود شت بها أبطح % % 8(@)(@@) % لها منطق فاخر فاتن % % كحلي العرائس يستملح % 9(@)(@@) % وعينان يجري الردى فيهما % % ووجه يصلى له أسجع % 10(@)(@@) % وثدي لرؤيته سجدة % يدين له الناسك الأجلح % % PageV01P394 11(@)(@@) % وثغر إذا ذقته لم تمت % وطاب لك العيش والمسرح % 12(@)(@@) % وخد أسيل وكف إذا % % أشارت لقوم بها سبحوا % % 13(@)(@@) % وساق تزين خلخالها % % على أنها صعبة ترمح % % 14(@)(@@) % وتضحك عن برد بارد % % تلالا كما لمع الوحوح % 15(@)(@@) % مبتلة فخمة فعمة % هضيم الكشح بوصها أرجح % 16(@)(@@) % إذا ذكرت سبقت عبرتي % % وكادت لها كبدي تقرح % % 17(@)(@@) % من البيض تجمع هم الفتى % % كما يجمع اللبن الإنفح % % 18(@)(@@) % جلت عن معاصم جنية % تغش بها الدين لا تنصح % 19(@)(@@) % وزجاء برجاء في جوهر % تروق بها عين من يلمح % 20(@)(@@) % خروج على جمع أترابها % % كما يخرج الأبلق الأقرع % % PageV01P395 21(@)(@@) % نهاني الخليفة عن ذكرها % % وكنت بما سره أكدح % 22(@)(@@) % فأعرضت عن حاجتي عندها % % وللموت من تركها أروح % % 23(@)(@@) % على أن في النفس من حبها % % أحاديث ليس لها مطرح % % 24(@)(@@) % تركت سديفا وأصحابه % وأحرمت ما يجتني شرمح % 25 