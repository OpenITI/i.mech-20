ms5552	 عن أبي عبد الله عليه السلام، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 3، ك 4، ب 32، ح 8، ب 78، PageV17P449(@)(@@) ح 1. والتهذيب: ج 2، ح 400، و 1066 (الاستبصار: ج 1، ح 1010)، و 1194، و ج 3، ح 192، و 603، و 913.(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 6، ك 9، ب 8، ح 1.(@)(@@) * وروى عن أبي حمزة أو محمد بن مسلم، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 3، ك 4، ب 101، ح 1.(@)(@@) * وروى عن أبيه.(@)(@@) الفقيه: ج 3، ح 368، و 1009.(@)(@@) وروى عنه علي بن أسباط.(@)(@@) الكافي: ج 5، ك 2، ب 4، ح 12، وب 30، ح 1. والتهذيب: ج 6، ح 898.(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 5، ك 2، ب 4، ح 16.(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الكافي: ج 2، ك 2، ب 27، ح 1.(@)(@@) * وروى عن إسحاق بن عمار، وروى عنه عمار بن المبارك.(@)(@@) التهذيب: ج 2، ح 478 (الاستبصار:(@)(@@) ج 1، ح 1023).(@)(@@) وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 5، ك 2، ب 168، ح 68.(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 3، ك 3، ب 40، ح 1، وب 70، ح 1، و ج 5، ك 1، ب 30، ح 1.(@)(@@) والتهذيب: ج 1، ح 902، و 1511، و ج 6، ح 364.(@)(@@) وروى عنه محمد بن عمر بن يزيد.(@)(@@) التهذيب: ج 5، ح 784 (الاستبصار:(@)(@@) ج 2، ح 994).(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه محمد بن إسماعيل.(@)(@@) التهذيب: ج 1، ح 13 (الاستبصار: ج 1، ح 353).(@)(@@) * وروى عن عثمان بن يزيد، وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 204.(@)(@@) * وروى عن عقبة، وروى عنه محمد ابن إسماعيل بن بزيع.(@)(@@) التهذيب: ج 3، ح 985.(@)(@@) * وروى عن عقبة بن بشير، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 5، ك 1، ب 10، ح 5.(@)(@@) والتهذيب: ج 6، ح 276.(@)(@@) * وروى عن عمر بن يزيد، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 3، ك 4، ب 66، ح 13، و ب 85، ح 14. والتهذيب: ج 2، ح 480، PageV17P450(@)(@@) و ج 3، ح 9، و 106.(@)(@@) وروى عنه عمرو بن عثمان الأزدي.(@)(@@) الكافي: ج 4، ك 3، ب 168، ح 8.(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 5، ك 2، ب 123، ح 8، و ج 6، ك 8، ب 30، ح 11.(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) التهذيب: ج 2، ح 491.(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع أو 
ms5553	 غيره.(@)(@@) الكافي: ج 4، ك 1، ب 10، ح 1.(@)(@@) وروى عنه محمد بن عمر.(@)(@@) التهذيب: ج 4، ح 141، و ج 5، ح 10، و 808، و 831 (الاستبصار: ج 2، ح 1020)، و 848.(@)(@@) وروى عنه محمد بن عمر بن يزيد.(@)(@@) التهذيب: ج 1، ح 1042، و ج 2، ح 94 (الاستبصار: ج 1، ح 964)، و 480 (الاستبصار: ج 1، ح 1024)، و 1034 (الاستبصار: ج 1، ح 964)، و ج 5، ح 313 (الاستبصار: ج 2، ح 586)، و 561 (الاستبصار: ج 2، ح 886)، و 900 (الاستبصار: ج 2، ح 1060)، و 1021، و 1077، و 1148 (الاستبصار: ج 2، ح 657)، و 1168.(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 102، و 130، و 170، و 229، و 231، و 281 (الاستبصار: ج 2، ح 563)، و 301، و 473، و 576 (الاستبصار: ج 2، ح 871)، و 583 (الاستبصار: ج 2، ح 878)، و 1513.(@)(@@) * وروى عن محمد بن مسلم، أو أبي حمزة، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 3، ك 4، ب 101، ح 1.(@)(@@) * وروى عن بعض أصحابه، عن محمد بن مسلم أو أبي حمزة.(@)(@@) الكافي: ج 2، ك 1، ب 163، ح 7.(@)(@@) * وروى عن بعض أصحابه، عن محمد بن مسلم، وأبي حمزة.(@)(@@) الكافي: ج 2، ك 4، ب 4، ح 7.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى عنه علي ابن أسباط.(@)(@@) الفقيه: ج 3، ح 1412.(@)(@@) محمد بن علي * روى عن أبي عبد الله عليه السلام، PageV17P451(@)(@@) وروى عنه عمران.(@)(@@) التهذيب: ج 3، ح 356 (الاستبصار:(@)(@@) ج 1، ح 1640) و 575 (الاستبصار:(@)(@@) ج 1، ح 1640).(@)(@@) * وروى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 1، ك 4، ب 130، ح 21.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 8، ب 5، ح 12.(@)(@@) وروى عنه موسى بن بكر.(@)(@@) التهذيب: ج 7، ح 1387 (الاستبصار:(@)(@@) ج 3، ح 744).(@)(@@) * وروى عن الرضا عليه السلام، وروى عنه علي بن سيف.(@)(@@) التهذيب: ج 2، ح 86 (الاستبصار: ج 1، ح 958).(@)(@@) وروى عنه محمد بن عبد الحميد.(@)(@@) التهذيب: ج 7، ح 275 * وروى عن أبي البختري، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 18، ح 5.(@)(@@) * وروى عن أبي جميلة، وروى عنه أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 54، ح 14.(@)(@@) وروى عنه أحمد بن أبي عبد الله. 
