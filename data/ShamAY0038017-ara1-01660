ms1641	(@)(@@) من أهل مكة، يروي عن ابن عيينة، ثنا عنه زكريا بن يحيى الساجي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن هشام المروزي(@)(@@) من أهل بغداد، يروي عن إسماعيل ابن علية وأهل العراق، ثنا عنه عمر بن محمد الهمداني وغيره، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون البزاز(@)(@@) من أهل بغداد، سكن مكة، يروي عن ابن عيينة والحجازيين، حدثنا عنه الهمداني وغيره من شيوخنا، ربما وهم.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة المخزومي(@)(@@) من أهل المدينة، يروي عن عبد الله بن الحارث المخزومي وأنس بن عياض أبي ضمرة، روى عنه أهل المدينة، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي زفر الواسطي(@)(@@) شيخ، كان بمكة، يروي عن إسحاق الأزرق ويزيد بن هارون، حدثنا عنه شيوخنا، مستقيم الحديث(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الأسفاطي، أبو عبد الله البصري(@)(@@) يروي عن يزيد بن هارون وأبي عاصم، حدثنا عنه عبد الله بن قحطبة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى القطان الواسطي(@)(@@) يروي عن أبي عاصم وبشر بن مبشر، حدثنا عنه أحمد بن يحيى بن زهير وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن كرامة، أبو جعفر العجلي(@)(@@) يروي عن PageV01P002 [ج 5: ص 473] عبيد الله بن موسى وأهل العراق، حدثنا عنه شيوخنا، مات سنة خمس وستين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن أبي هارون، أبو طاهر المصري(@)(@@) يروي عن أبي عاصم ووهيب بن جرير، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن مسكين بن تميلة اليمامي، أبو الحسن(@)(@@) يروي عن عبيد الله بن موسى وبشر بن بكر التنيسي، حدثنا عنه عمرو بن محمد الهمداني.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد الجراح الجوزجاني، أبو عبد الرحمن(@)(@@) يروي عن العراقيين، وكان صديقا لابن حنبل رحل إلى علي بن حرب فجالسه أهل مرو، وأهل مرو عندهم عنه حكايات، وكان صاحب سنة وفضل وخير، وكان أبوه ينتحل مذهب أبي حنيفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن البخترى الحساني، أبو عبد الله الضرير(@)(@@) من أهل واسط، يروي عن أبي معاوية ويزيد بن هارون، حدثنا عنه إسحاق بن إبراهيم القاضي وغيره من شيوخنا. 
ms1642	(@)(@@)(@@)(@@) ||| AUTO محمد بن هاشم بن سعيد البعلبكي(@)(@@) يروي عن محمد بن حمير عن إبراهيم بن أبي عبلة، حدثنا عنه أحمد بن عمير بن جوصاء وغيره من شيوخنا، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن سمرة الأحمسي السراج(@)(@@) من أهل الكوفة، يروي عن وكيع والكوفيين، حدثنا عنه عبد الملك وغيره من شيوخنا.(@)PageV01P002(@)(@@) [ج 5: ص 474](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن يزيد المقرئ(@)(@@) من أهل مكة، يروي عن سفيان بن عيينة ويحيى بن سليم، ثنا عنه مكحول.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى، أبو يحيى المحاربي(@)(@@) كوفي، يروي عن أبي نعيم والكوفيين، حدثنا عنه محمد بن صالح الطبري وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن عبيد بن عقيل(@)(@@) من أهل البصرة، يروي عن أبي عاصم وجده وعبيد الله، حدثنا عنه عمر بن حفص البزار وجماعة من شيوخنا، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن سفيان بن أبي الزرد الأبلي(@)(@@) يروي عن أبي عاصم ويزيد بن هارون والبصريين، حدثنا عنه بعض شيوخنا الحسن بن محمد بن أبي معشر وغيره، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن الأبح الصنعاني(@)(@@) يروي عن هارون بن معاوية الفزاري، روى عنه علي بن محمد بن المبارك الصنعاني.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن حرملة(@)(@@) شيخ، يروي عن حماد بن زيد، روى عنه عليك الرازي علي بن سعيد بن بشير، كان بمصر.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن الحكم الهروي(@)(@@) يروي عن يعلى بن عبيد، روى عنه أهل بلده، وقد كتب عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن هياج الهمداني الأرحبي، أبو عبد الله(@)(@@) من أهل الكوفة، يروي عن عبيد الله بن موسى وغيره، حدثنا عنه الحسن بن محمد بن مصعب وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الآدمي(@)(@@) من أهل بغداد، يروي عن أبي ضمرة وأهل الحجاز، حدثنا عنه عمر بن محمد الهمداني وغيره من شيوخنا.(@)PageV01P002(@)(@@) [ج 5: ص 475](@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن مخلد التمار الواسطي(@)(@@) يروي عن يزيد بن هارون وخالد بن سليمان، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن عبد الحميد بن زيد 
ms1643	 البسري، أبو عبد الله القرشي(@)(@@) من أهل البصرة، يروي عن غندر وابن عيينة والبصريين، وعبد الوهاب الثقفي حدثنا عنه شيوخنا ابن خزيمة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي رجاء العباداني(@)(@@) يروي عن عامر بن يساف، عن يحيى بن أبي كثير، قال: كان ابن مسعود، يقول: من تعلم القرآن فليتعلم الفرائض ولا يكن مثل رجل أتاه أهل البادية فسألوه عنها فلم يدر، فقالوا: ما فضلك علينا أيها المهاجر، حدثنا عبد الله بن قحطبة، ثنا محمد بن أبي رجاء.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد بن معروف(@)(@@) من أهل جرجان، يروي عن أبي نعيم وإسحاق بن سليمان الرازي، حدثنا عنه عمران بن موسى السجستاني، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن الوليد الكندي(@)(@@) من أهل الكوفة، يروي عن أبي أسامة ويزيد بن هارون، حدثنا عنه أبو يعلى محمد بن زهير وغيره، قال: كنيته أبو جعفر.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن يزيد المقرئ(@)(@@) يروي عن ابن عيينة كان متقنا، مات بعد الخمسين والمائتين، كنيته أبو يحيى.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن حميد بن ثعلبة الحماني(@)(@@) من أهل الكوفة، يعرف بالجرب، يروي عن وكيع وأهل العراق، حدثنا عنه عبد الرحمن بن محمد بن حماد الطهراني وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن الفرح البغدادي(@)(@@) يروي عن إسماعيل ابن علية وأهل البصرة، حدثنا عنه محمد بن إسحاق بن إبراهيم الثقفي.(@)PageV01P002(@)(@@) [ج 5: ص 476](@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن عبد الكريم الأزدي(@)(@@) من أهل البصرة، يروي عن يزيد بن هارون، حدثنا عنه عبد الله بن قحطبة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن المخزومي(@)(@@) (688) -[5: 476] يروي عن عيسى بن يونس، عن أبيه، عن جده، عن ذي الجوشن، قال: أتيت رسول الله صلى الله عليه وسلم بعد ما فرغ من بدر، روى عنه الحضرمي(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن المبارك المخرمي، أبو جعفر البغدادي(@)(@@) يروي عن أبي عاصم وأهل العراق، حدثنا عنه ابن خزيمة وغيره، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوزير بن قيس، أبو عبد الله(@)(@@) من 
ms1644	 أهل واسط، يروي عن ابن عيينة وعبد الوهاب الثقفي، حدثنا عنه أحمد بن عمير بن جوصاء وغيره من شيوخنا، وكان من العباد الخشن.(@)(@@)(@@)(@@) ||| AUTO محمد بن جبلة بن حرمة(@)(@@) شيخ، يروي عن حماد بن زيد، روى عنه علية الرازي، يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن الجنيد بن عبيد الله البغدادي(@)(@@) يروي عن أبي عاصم وأبي نعيم والعراقيين، روى عنه صالح بن محمد البغدادي، حدثنا محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهدي الأبلي(@)(@@) أخو الحسين بن مهدي، يروي عن يزيد بن هارون وأبي عاصم، حدثنا عنه أبو يعلى.(@)PageV01P002(@)(@@) [ج 5: ص 477](@)(@@)(@@)(@@) ||| AUTO محمد بن معمر بن ربعي القيسي، أبو عبد الله(@)(@@) من أهل البصرة، مات بعد سنة خمسين ومائتين، يروي عن أبي عاصم وغيره من البصريين.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن يوسف(@)(@@) عن الأنصاري، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن هارون بن إبراهيم، أبو بسيط البغدادي(@)(@@) يروي عن أبي عاصم وعبيد الله بن موسى، وكان راويا لأبي المغيرة، حدثنا عنه محمد بن المسيب وغيره، ربما أخطأ، وكنيته أبو جعفر، وأبو نشيط لقب، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن هشام بن ملاس، أبو جعفر الدمشقي(@)(@@) يروي عن بقية بن الوليد وحرملة بنت عبد العزيز، حدثنا عنه محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن الأزهر(@)(@@) شيخ، من أهل الجوزجان، يروي عن يحيى القطان وابن مهدي، روى عنه أحمد بن سيار، كثير الحديث يتعاطى الحفظ من جلساء أحمد بن حنبل.(@)(@@)(@@)(@@) ||| AUTO محمد بن الفضيل بن العباس بن الحجاج البلخي العابد، كنيته أبو سليمان(@)(@@) يروي عن أبي ضمرة ويعلى بن عبيد حدثنا عنه أحمد بن خالد وغيره وكان شيخا متعبدا متقنا، ولكنه كان مرجئا.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن زيد، أبو جعفر المدادي(@)(@@) من أهل البصرة، يروي عن الأنصاري والبصريين، حدثنا عنه عبد الله بن قحطبة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن ثواب بن الحصين بن معبد بن عبد الله الهباري، أبو جعفر PageV01P002 [ج 5: ص 478](@)(@@) من أهل الكوفة، يروي عن أبي 
ms1645	 أسامة وجعفر بن عون، حدثنا عنه الحسين بن مصعب وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن حنان الكلبي(@)(@@) من أهل حمص، يروي عن محمد بن حمير وبقية بن الوليد والناس، حدثنا عنه أحمد بن يحيى بن زهير، ربما أغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن رزق الله الكلوذاني، أبو بكر(@)(@@) من أهل بغداد، يروي عن أبي عاصم وأهل العراق، حدثنا عنه حاجب بن أركين وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن عبد الله بن المستورد البغدادي، أبو سيار(@)(@@) يروي عن أبي نعيم وأهل العراق، حدثنا عنه محمد بن أحمد بن إسحاق الثقفي، وقال: كان كخير الرجال، حدثنا عمر بن حفص البزاز، ثنا أبو سيار البغدادي، قال: سمعت أبا نعيم الفضل بن دكين، يقول: كان خط سفيان الثوري خوباشا.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن قهزاد(@)(@@) من أهل مرو، يروي عن أبي نعيم، حدثنا عنه شيوخنا، مات سنة اثنتين وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين بن إبراهيم بن الحر بن أشكاب، أبو جعفر البغدادي(@)(@@) يروي عن يزيد بن هارون والعراقيين، حدثنا عنه أحمد بن يحيى بن زهير وغيره، وكان صاحب حديث ويتعسر.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح بن النطاح(@)(@@) يروي عن أبي عاصم ومحمد بن عبد الله، ثنا عنه عمرو بن محمد الهمداني.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان القيراطي، أبو عبد الله(@)(@@) من أهل مرو، يروي عن أبي أسامة، حدثنا عنه محمد بن المنذر بن سعيد وغيره من شيوخنا، مات سنة اثنتين وستين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 479](@)(@@)(@@)(@@) ||| AUTO محمد بن سوار بن راشد الكوفي(@)(@@) سكن مصر، يروي عن عبدة بن سليمان ووكيع، حدثنا عنه علي بن الحسين بن سليمان المعدل بالفسطاط وغيره، ويغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن حرب النشائي، أبو عبد الله(@)(@@) من أهل واسط، يروي عن يزيد بن هارون والعراقيين، حدثنا عنه الطبري وغيره، مات بعد الخمسين والمائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق البكائي(@)(@@) من أهل الكوفة، يروي عن أبي نعيم والكوفيين، ثنا عنه محمد بن المنذر وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن محمد بن مرزوق الباهلي(@)(@@) من أهل البصرة، يروي عن 
ms1646	 الأنصاري وأبي عاصم، ثنا عنه ابن خزيمة، وكان ابن ابنته مهدي بن ميمون، ربما أخطأ، مات سنة ثمان وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن مسعود بن يوسف العجمي(@)(@@) من أهل طرسوس، يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه حاجب بن أركين الفرغاني وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن مرزوق بن النعمان البصري(@)(@@) يروي عن أبي عاصم وأهل البصرة، روى عنه أهل العراق، وليس هذا بالباهلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحجاج بن جعفر بن إياس بن يزيد، بغدادي(@)(@@) يروي عن محمد بن سعيد بن أمية الأعمش، حدثنا عنه محمد بن خالد البردعي بمكة، يغرب.(@)PageV01P002(@)(@@) [ج 5: ص 480](@)(@@)(@@)(@@) ||| AUTO محمد بن عبادة بن البختري، أبو جعفر واسطي(@)(@@) يروي عن يزيد بن هارون وأبي أسامة، حدثنا عنه خنيس بن عبد الله السلمي بواسط.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن حكيم الشيباني(@)(@@) من أهل مرو، يروي عن أبي نعيم، حدثنا عنه محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن منصور الجعفي(@)(@@) من أهل الكوفة، يروي عن أبي نعيم والكوفيين، ثنا عنه الحسين بن سفيان، كنيته أبو جعفر.(@)(@@)(@@)(@@) ||| AUTO محمد بن مشكان السرخسي(@)(@@) يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه محمد بن عبد الرحمن الدغولي وغيره، مات سنة تسع وخمسين وثلاثمائة، وكان ابن حنبل رحمه الله يكاتبه.(@)(@@)(@@)(@@) ||| AUTO محمد بن سهل بن عسكر بن عثمان بن دويد التميمي، أبو بكر البغدادي(@)(@@) يروي عن أبي عاصم، أصله من خراسان، حدثنا عنه ابن زهير وغيره، مات سنة إحدى وخمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الأسود الكوفي(@)(@@) حدث ببغداد، يروي عن عبيد الله بن موسى والكوفيين، روى عنه أهل العراق، سمعت ابن قحطبة، يقول: كتبنا عنه ببغداد سنة إحدى وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص الوصابي، أبو عبيد(@)(@@) من أهل حمص، يروي عن محمد بن حمير عن إبراهيم بن أبي عبلة، حدثنا عنه أحمد بن عمير بن يوسف، يغرب.(@)PageV01P002(@)(@@) [ج 5: ص 481](@)(@@)(@@)(@@) ||| AUTO محمد بن حاتم الأنصاري، أبو حاتم(@)(@@) يروي عن سفيان بن عيينة، حدثنا عنه الحسين بن أحمد بن بسطام بالأبلة. 
ms1647	(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن محرز(@)(@@) من أهل الفسطاط، يروي عن أبي أسامة، حدثنا عنه علان بن الصيقل وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن غالب، أبو يحيى العطار(@)(@@) من أهل بغداد، يروي عن أبي عاصم وأهل البصرة، حدثنا عنه محمد بن عثمان بن سعيد الدارمي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الوهاب بن حبيب الفراء، الذي يقال له: حمك(@)(@@) من أهل نيسابور، يروي عن أبي نعيم وأهل العراق، حدثنا عنه أصحابنا بنيسابور.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعقوب اللؤلؤي(@)(@@) من أهل بلخ، يروي عن سعيد بن سنان عن داود بن أبي هند، روى عنه علي بن محمد بن علي بن رافع.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيسى(@)(@@) جار ليعلى بن عبيد، يروي عن محمد بن سوقة، روى عنه محمد بن يزيد بن رفاعة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حازم الرملي(@)(@@) يروي عن الفضيل بن عياض، روى عنه يوسف بن سعيد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO محمد بن هاشم بن سعيد(@)(@@) من أهل دمشق، يروي عن سعيد بن إسحاق وسويد بن عبد العزيز، حدثنا عنه ابن جوصاء.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن الصائغ المروزي(@)(@@) يروي عن أبي الوليد الطيالسي وأهل PageV01P002 [ج 5: ص 482] العراق، حدثنا عنه محمد بن أحمد بن أبي عون.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن أبي رجاء المصيصي(@)(@@) يروي عن وكيع، ثنا عنه أحمد بن عبيد الله الدارمي، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن سليمان بن أبي مذعور القحطبي(@)(@@)(@@)(@@) ||| AUTO يروي عن معاذ بن معاذ وأهل العراق، حدثنا عنه محمد بن إسحاق بن إبراهيم، عداده في أهل بغداد.(@)(@@)(@@)(@@) ||| AUTO محمد بن حماد الطهراني، أبو عبد الله العابد(@)(@@) من أهل الري، يروي عن يزيد بن هارون وعبد الرزاق حدثنا عنه ابنه عبد الرحمن بن محمد بن حماد وغيره،.(@)(@@) (689) -[5: 482] حدثنا مهران بن هارون، حدثنا محمد بن حماد الطهراني، قال: سمعت عبد الرزاق، يقول: سئل سفيان الثوري عن الرجل يضيق عليه فرج امرأته، قال: يوسعه بأصبعه، وحكى الثوري أن أصحاب رسول الله صلى الله عليه وسلم: كانوا يوسعون بالدرهم الوصخ(@)(@@)(@@)(@@) ||| AUTO 
ms1648	 محمد بن حسان بن فيروز الأزرق(@)(@@) من أهل واسط، يروي عن يزيد بن هارون، حدثنا عنه شيوخنا.(@)(@@) محمد بن إسحاق بن إبراهيم(@)(@@) مولى ثقيف وغيره، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق السجستاني يعرف بشبويه(@)(@@) سكن مكة، يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه عبد الرحمن بن قيس وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن الربيع بن الحكم البزاز(@)(@@) من أهل واسط، يروي عن يزيد بن هارون، حدثنا عنه يوسف بن حبان بن إسحاق العطار بواسط.(@)(@@)(@@)(@@) ||| AUTO محمد بن سهل بن مهير(@)(@@) يروي عن إبراهيم بن أبي يحيى، روى عنه إبراهيم بن عبد الأحد بن الحجاج بن أبي عثمان الصواف.(@)PageV01P002(@)(@@) [ج 5: ص 483](@)(@@)(@@)(@@) ||| AUTO محمد بن علي الملطي(@)(@@) شيخ، يروي عن أبي عاصم وعبد الرزاق، مستقيم الحديث، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن منصور الطوسي(@)(@@) من أهل بغداد، يروي عن أبي عاصم، حدثنا عنه محمد بن عمرو بن يوسف وغيره، مات سنة أربع وخمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز(@)(@@) شيخ، يروي عن وكيع.(@)(@@) (690) -[5: 483] حدثنا ابن قتيبة، ثنا محمد بن عبد العزيز، ثنا وكيع بن الجراح، عن أبيه، عن الشعبي، قال: من رق وجهه رق علمه، قلت لوكيع: بين أبيك وبين الشعبي أحد، قال: لا.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن قهزاد(@)(@@) من أهل مرو، يروي عن جعفر بن عون والعراقيين وأهل بلده، حدثنا عنه الدغولي بالغرائب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن علي الأنصاري(@)(@@) يروي عن أبي أسامة، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن زنجويه، أبو بكر البغدادي(@)(@@) أصله من خراسان، يروي عن يزيد بن هارون وأبي عاصم وعبد الرزاق، وكان من جلساء أحمد بن حنبل.(@)(@@)(@@)(@@) ||| AUTO محمد بن حسان الأزرق البرجماني، أبو جعفر(@)(@@) من أهل واسط، يروي عن يزيد بن هارون وأهل بلده، مات سنة خمسين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن المعتمر السجزي(@)(@@) يروي عن أبي عاصم وأبي عامر العقدي، حدثنا عنه أحمد بن محمد بن الأزهر السجزي، مات سنة ستين ومائتين أو قبلها أو بعدها 
ms1649	 بقليل، ولقبه حبك.(@)PageV01P002(@)(@@) [ج 5: ص 484](@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن هاشم، ابن ابنة مطر(@)(@@) من أهل بغداد، يروي عن أبي معاوية وأبي أسامة، حدثنا عنه العباس بن الفضل النصيبي وغيره، ليس له في القلب حلاوة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين بن كردي(@)(@@) من أهل البصرة، يروي عن أبي أسامة، حدثنا عنه أحمد بن زهير بالأبلة.(@)(@@)(@@)(@@) ||| AUTO محمد بن جبلة الرافقي، أبو بكر(@)(@@) يروي عن أبي نعيم وأهل حران حدثنا عنه أبو عروبة، مات بالرافقة سنة خمس وثمانين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن مروان الدقيقي(@)(@@) من أهل واسط، يروي عن يزيد بن هارون، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحيم، أبو يحيى البغدادي، الذي يقال له: صاعقة(@)(@@) يروي عن أبي عاصم وأهل العراق، حدثنا عنه محمد بن إسحاق الثقفي وغيره، وكان صاحب حديث يحفظ، مات سنة خمس وخمسين ومائتين، وهو من موالي أبي طالب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن عبد الحكم بن أعين(@)(@@) يروي عن أبي ضمرة أنس بن عياض، حدثنا عنه شكر وغيره.(@)PageV01P002(@)(@@) [ج 5: ص 485](@)(@@)(@@)(@@) ||| AUTO محمد بن المهلب الحراني(@)(@@) يروي عن أبي نعيم، روى عنه أهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن دهلم(@)(@@) سكن الثغر، يروي عن أبي نعيم.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد الله بن المنادى أبو جعفر البغدادي(@)(@@) يروي عن أبي أسامة والمكي بن إبراهيم، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر البيكندي(@)(@@) يروي عن أبي عاصم وعبد الرزاق، روى عنه أهل بلده، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر بن أبي مواثة الكلبي(@)(@@) يروي عن أبي نعيم وعبد الرحمن بن أبي حماد، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سنان القزاز(@)(@@) أخو يزيد بن سنان، من أهل البصرة، يروي عن الأنصاري وأبي عاصم، كنيته أبو الحسن، حدثنا عنه أبو عروبة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن جامع بن أبي كامل(@)(@@) يروي عن عبيد الله بن موسى وأهل العراق، حدثنا عنه أحمد بن الحسين الجرادي بالموصل.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن سالم الصائغ، أبو جعفر(@)(@@) من أهل مكة، يروي 
ms1650	 عن أبي عاصم وأهل العراق، حدثنا عنه أصحابنا محمد بن عبد الرحمن الدغولي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن خزيمة البصري، أبو عمر(@)(@@) سكن مصر، يروي عن محمد بن عبد الله الأنصاري وأهل العراق، حدثنا عنه أحمد بن الفضل بن حاتم بالأبلة وغيره، مستقيم الحديث.(@)PageV01P002(@)(@@) [ج 5: ص 486](@)(@@)(@@)(@@) ||| AUTO محمد بن حمدويه بن عبيدة بن شيبة الخزرجي، أبو عبد الله(@)(@@) حدث بمكة، يروي عن أبي نعيم، حدثنا عنه محمد بن شعيب بن موسى الفسوي، عن أبي نعيم بكتاب التاريخ في جزء.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن صالح التيمي، أبو عبد الله(@)(@@) كوفي، يروي عن أبي نعيم وأهل بلده، حدثنا عنه محمد بن المنذر بن سعيد وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحجاج الضبي(@)(@@) كوفي، يروي عن عبد الرحيم بن سليمان والكوفيين، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحكم بن أعين المروزي(@)(@@) يروي عن أبي نعيم والعراقيين، وكان راويا للوليد بن مسلم، حدثنا عنه الحسين بن محمد بن مصعب السنجي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن أبي الوليد الفحام البغدادي(@)(@@) يروي عن أهل العراق، روى عنه الناس.(@)(@@) (691) -[5: 486] حدثنا عبد الله بن قحطبة، ثنا محمد بن أبي الوليد، ثنا إسماعيل ابن علية، عن الحجاج بن أبي عثمان، عن أبي الزبير، عن عون بن عبد الله بن عتبة، عن ابن عمر، قال: بينما نحن نصلي مع رسول الله صلى الله عليه وسلم إذ قال رجل من القوم: الله أكبر كبيرا، والحمد لله كثيرا، وسبحان الله بكرة وأصيلا، فقال رسول الله صلى الله عليه وسلم من القائل: كذا وكذا؟ فقال رجل من القوم: أنا يا رسول الله، قال: عجبت مما فتحت لها أبواب السماء، قال لابن عمر: فما تركتهن منذ سمعت رسول الله صلى الله عليه وسلم يقول ذاك. الحديث منقطع، لأن عون بن عبد الله لم ير ابن عمر(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن يزيد بن أبي العوام الرباحي(@)(@@) من أهل بغداد، يروي عن يزيد بن هارون وأبي عاصم، روى عنه العراقيون، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن غالب، 
ms1651	 أبو الحسن(@)(@@) شيخ، من أهل نسا، يروي عن جعفر بن عون وعلي بن عاصم وأبي نعيم، مستقيم الحديث، حدثنا أحمد بن زنجويه بنسا، ثنا محمد بن غالب النسوي.(@)PageV01P002(@)(@@) [ج 5: ص 487](@)(@@)(@@)(@@) ||| AUTO محمد بن هلال بن رداد الكناني(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه الشاميون.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن أبي الثلج(@)(@@) من أهل بغداد، سكن الري، يروي عن يزيد بن هارون وقراد، حدثنا عنه ابن خزيمة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن محرز البغدادي(@)(@@) سكن الفسطاط، يروي عن أبي أسامة والعراقيين، حدثنا عنه علي بن الحسين بن سلمان بالفسطاط، مستقيم الأمر في الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن ماهان(@)(@@) من أهل بغداد، يروي عن أبي الوليد الطيالسي، حدثنا عنه محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن الليث، أبو الصباح(@)(@@) من أهل البصرة، يروي عن أبي عاصم، حدثنا عنه ابن الطهراني، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن شجاع المروروذي(@)(@@) يروي عن إسماعيل ابن علية، حدثنا عنه محمد بن إسحاق الثقفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الخليل المخرمي، بغدادي(@)(@@) يروي عن عبيد الله بن موسى، حدثنا عنه علي بن إبراهيم بن الهيثم الخالدي وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد بن أبان البغدادي(@)(@@) سكن الشام وحدثهم بها، يروي عن عبيد الله بن موسى وأهل العراق، حدثنا وشيوخنا، ربما أخطأ وأغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الكريم بن محمد، أبو جعفر العبدي(@)(@@) من أهل مرو، يروي عنه القطان عن يزيد بن هارون والعراقيين، حدثنا عنه ابن ابنه أحمد بن الحارث بن محمد بن عبد الكريم وغيره، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)PageV01P002(@)(@@) [ج 5: ص 488](@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق الصغاني، أبو بكر(@)(@@) من أهل بغداد، يروي عن أبي عاصم والعراقيين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو السوسي(@)(@@) سكن الفسطاط، يروي عن عبد الله بن نمير، حدثنا عنه أحمد بن عمير بن جوصاء.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين بن أبي الحسين(@)(@@) كوفي، يروي عن أبي نعيم، حدثنا عنه الطبري.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم 
ms1652	 بن الجنيد أبو بكر النسوي(@)(@@) يروي عن يعلى بن عبيد وأبي نعيم.(@)(@@) (692) -[5: 488] ثنا عنه محمد بن سوقة، عن نافع، عن ابن عمر، قال: من تنخم في قبلة المسجد بعث يوم القيامة وهي في وجهه.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن مسلم، أبو أمية السجستاني(@)(@@) سكن طرسوس، يروي عن يزيد بن هارون وأبي عاصم، حدثنا عنه ابنه إبراهيم بن أبي أمية بطرسوس، وكان من الثقات، دخل مصر، فحدثهم من حفظه من غير كتاب بأشياء أخطأ فيها فلا يعجبني الاحتجاج بخبره إلا ما حدث من كتابه.(@)(@@)(@@)(@@) ||| AUTO محمد بن إدريس بن المنذر، أبو حاتم الرازي(@)(@@) يروي عن الأنصاري، حدثنا عنه ابنه أبو محمد عبد الرحمن بن محمد، مات سنة سبع وسبعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عزيز بن عبد الله بن زياد بن خالد الأيلي(@)(@@) يروي عن PageV01P002 [ج 5: ص 489] سلامة بن روح بن خالد الأيلي، حدثنا محمد بن المنذر بن سعيد عنه.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن ميمون القطان(@)(@@) من أهل الرقة، كنيته أبو العباس، يروي عن أبي نعيم وقرة بن حبيب والعراقيين، حدثنا عنه الحسن بن مصعب وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن إدريس بن عمر، أبو بكر وراق الحميدي(@)(@@) من أهل مكة، يروي عن أبي عاصم النبيل، حدثنا عنه محمد بن المنذر بن سعيد وغيره، مستقيم الأمر في الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمار بن الحارث الوازعي، أبو جعفر(@)(@@) من أهل الري، يروي عن أبي نعيم وأهل العراق، حدثنا عنه أحمد بن محمد بن يحيى وغيره، مستقيم الحديث.(@)(@@) (693) -[5: 489] سمعت أحمد بن محمد بن يحيى، يقول: سمعت محمد بن عمار، يقول: سمعت أبا نعيم، يقول: سمعت سفيان الثوري، يقول: الإيمان يزيد وينقص، قلت: ما تقول أنت يا أبا نعيم، فنظر إلي نظرا منكرا، ثم قال: أقول بقول سفيان، ولقد مات مسعر بن كدام وكان من خيارهم وسفيان وشريك شاهدان فما حضرا جنازته، ولقد شهد رجل عند شريك سبع مرات فرد شهادته، فقيل له في ذلك، فقال: قبل شهادته من يزعم أن الصلاة ليست من الإيمان(@)(@@) (694) -[5: 489] سمعت 
ms1653	 أحمد بن محمد بن يحيى، يقول: سمعت محمد بن عمار، يقول: سمعت أبا الوليد الطيالسي، يقول: لما قدم أبو يوسف الري أتيته فسلمت عليه فلقيني عثمان بن زائدة، فقال لي: لعلك أتيت هذا الرجل فسلمت عليه، فقلت: نعم، قال: بئس ما صنعت، قال: وما رأت عيناي خيرا من عثمان بن زائدة.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي الواسطي، يعرف بكبشة(@)(@@) يروي عن عبد الوهاب بن عطاء ويزيد بن هارون، حدثنا عنه يوسف بن حبان بن إسحاق الواسطي.(@)(@@)(@@)(@@) ||| AUTO محمد بن بندار السباك(@)(@@) يروي عن أبي عاصم وأهل العراق، حدثنا عنه محمد بن إسحاق بن إبراهيم بن مهران وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن عبد الرحمن السرخسي(@)(@@) سكن بغداد، يروي عن يزيد بن هارون، حدثنا عنه إسحاق بن أيوب بن حسان بواسط.(@)PageV01P002(@)(@@) [ج 5: ص 490](@)(@@)(@@)(@@) ||| AUTO محمد بن عقيل بن خويلد بن ميسرة، أبو عبد الله(@)(@@) من أهل نيسابور، يروي عن أبي نعيم وأهل بلده، حدثنا عنه ابن خزيمة وغيره، من أهل بلده نيسابور، ربما أخطأ، حدث بالعراق بمقدار عشرة أحاديث مقبولة.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف بن عيسى بن الطباع(@)(@@) يروي عن أبي نعيم وأهل العراق، سكن الثغر، حدثنا عنه علي بن إبراهيم بن القاسم البلدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الخطاب البلدي الزاهد(@)(@@) سكن الموصل، يروي عن المؤمل بن إسماعيل وأبي نعيم والكوفيين، حدثنا عنه أبو يعلى وأهل الموصل.(@)(@@)(@@)(@@) ||| AUTO محمد بن غالب الأنطاكي(@)(@@) يروي عن سعيد بن مسلمة عن يحيى بن سعيد الأنصاري، حدثنا عنه علي بن حمزة بن صالح بأنطاكية.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيسى العصار(@)(@@) من أهل واسط، يروي عن يزيد بن هارون والعراقيين، حدثنا عنه بشران بن أحمد بن الخليل بواسط.(@)(@@)(@@)(@@) ||| AUTO محمد بن ذكويه البزاز(@)(@@) من أهل سرخس، يروي عن المكي بن إبراهيم، وقد سمع المكي من يزيد بن أبي عبيد ويزيد سمع من سلمة بن الأكوع، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن الجنيد الدقاق، أبو جعفر(@)(@@) من أهل بغداد، سكن الشام، يروي عن أبي عاصم ونابل بن 
ms1654	 نجيح، حدثنا عنه أبو عروبة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن بشر، أبو حفص الطبرزادفاني(@)(@@) من أهل سرخس، يروي عن مكي بن إبراهيم ووهب بن زمعة وأصحاب ابن المبارك، روى عنه أهل بلده.(@)PageV01P002(@)(@@) [ج 5: ص 491](@)(@@)(@@)(@@) ||| AUTO محمد بن الحارث البزار(@)(@@) شيخ، بغدادي، يروي عن عبد الوهاب بن عطاء بن سليمان التيمي، حدثنا عنه محمد بن إسحاق بن إبراهيم الثقفي، مولى ثقيف.(@)(@@)(@@)(@@) ||| AUTO محمد بن محمد بن مصعب(@)(@@) من أهل صور، يعرف بوحشي، يروي عن المؤمل بن إسماعيل وأبي عاصم، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن الخليل بن عمران(@)(@@) يروي عن خلاد بن يحيى وأبي نعيم، حدثنا عنه محمد بن يعقوب الخطيب بالأهواز.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن يزيد بن إبراهيم التستري(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، وقد سمع أبو عاصم من يزيد بن أبي عبيد، عن سلمة بن الأكوع، حدثنا عنه ابن زهير بتستر.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد الله بن يزيد القردواني(@)(@@) من أهل حران، يروي عن أبي نعيم ومحمد بن سليمان بن أبي داود وأهل الجزيرة، كنيته أبو جعفر، من بني شيبان، حدثنا عنه مكحول ببيروت وغيره، مات بحران سنة ثمان وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن خلف الحدادي، أبو بكر(@)(@@) يروي عن أبي نعيم والعراقيين، حدثنا عنه محمد بن إبراهيم الفارسي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيدة بن الحكم المروزي(@)(@@) يروي عن المكي بن إبراهيم عن يزيد بن أبي عبيد عن سلمة بن الأكوع، حدثنا عنه الدغولي وأهل مرو.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن عتبة الكندي(@)(@@) من أهل الكوفة، يروي عن أبي نعيم، حدثنا عنه الحسين بن إسحاق بن إبراهيم الخلال.(@)PageV01P002(@)(@@) [ج 5: ص 492](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي خالد الصومعي الطبري(@)(@@) يروي عن أبي عاصم وأهل العراق، حدثنا عنه إبراهيم بن علي بسارية، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن عفان العامري(@)(@@) أخو الحسين بن علي بن عفان، من أهل الكوفة، يروي عن يعلى وأبي نعيم وقد سمعا جميعا الأعمش، حدثنا عنه زكريا بن يحيى الشافعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الهيثم 
ms1655	 بن كعب الذراع(@)(@@) من أهل واسط، يروي عن يزيد بن هارون وأبي عاصم، حدثنا عنه ابنه.(@)(@@)(@@)(@@) ||| AUTO محمد بن المهلب السرخسي، أبو عبد الله(@)(@@) يروي عن يعلى بن عبيد وعبيد الله بن موسى وأبي نعيم، حدثنا عنه محمد بن عبد الرحمن وغيره، مات في سنة ستين ومائتين في شهر ربيع الآخر، وكان صاحب حديث ممن جمع وصنف.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو التوبني(@)(@@) سكن مصر، يروي عن عبيد الله بن نصير والعراقيين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوزير بن قيس السلمي، أبو عبد الله الدمشقي(@)(@@) يروي عن شعيب بن أبي إسحاق والوليد بن مسلم، حدثنا عنه أحمد بن عمرو بن يوسف وغيره من أهل الشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن ثواب الحضرمي(@)(@@) كوفي، يروي عن أبي أسامة والكوفيين، حدثنا عنه محمد بن أحمد بن علي الجوري بالموصل، وليس هذا بسعيد بن محمد بن أيوب، ذاك البصري وهذا كوفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن الوليد البغدادي، أبو جعفر(@)(@@) يروي عن PageV01P002 [ج 5: ص 493] عبد الوهاب بن عطاء، حدثنا عنه محمد بن إسحاق الثقفي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن كثير الحراني(@)(@@) يروي عن يعلى بن عبيد وأبي نعيم وأهل بلده، كنيته أبو عبد الله، حدثنا عنه مكحول وغيره، مات بحران في صفر سنة سبع وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن بحير الهمداني(@)(@@) من أهل خشوفغن، يروي عن القعنبي وأبي الوليد، حدثنا عنه ابنه أبو حفص عمر بن محمد بن بجير، مات في شعبان سنة ثمان وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عوف بن سفيان الطائي، أبو عبد الله(@)(@@) من أهل حمص، يروي عن أبي عاصم وعبيد الله بن موسى وأهل الكوفة، حدثنا عنه ابن فضيل وأهل الشام، وكان صاحب حديث يحفظ.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي الوراق، أبو جعفر(@)(@@) من أهل بغداد، يقال له: حمدان بن علي، يروي عن أبي عاصم والبصريين، حدثنا عنه محمد بن المنذر بن سعيد وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيسى بن حيان المدائني، أبو عبد الله(@)(@@) يروي عن عبيد الله بن موسى وأهل العراق، حدثنا عنه 
ms1656	 وصيف الأنطاكي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن جعفر بن الزبير البلخي(@)(@@) والد أبي علي الحافظ، يروي عن المكي بن إبراهيم، روى عنه ابنه وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن داود بن دينار الكرماني(@)(@@) سكن سرخس، يروي عن يعلى ومحمد ابني عبيد، حدثنا عنه محمد بن عبد الرحمن الدغولي وغيره، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)PageV01P002(@)(@@) [ج 5: ص 494](@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن المثنى(@)(@@) خال أبي يعلى، من أهل الموصل، يروي عن أبي نعيم والكوفيين، حدثنا عنه علي بن الحسين بن عبد الجبار البلدي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن معدان الحراني، أبو عبد الله(@)(@@) يروي عن أبي نعيم وأهل العراق والجزيرة، مات سنة ستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص الأوصابي، أبو عبد الله(@)(@@) يروي عن محمد بن الحسين.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن يزيد، أبو هارون الخراز(@)(@@) من أهل الري، يروي عن عبيد الله بن موسى وأهل بلده، حدثنا عنه مهران بن هارون بالري.(@)(@@)(@@)(@@) ||| AUTO محمد بن الهيثم، أبو الأحوص العكبري(@)(@@) قاضي عكبرا، يروي عن أبي الوليد وأهل العراق، حدثنا عنه أصحابنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن كثير الصوري، أبو الحسن(@)(@@) سكن أنطاكية، يروي عن أبي نعيم والمؤمل والفريابي، حدثنا عنه وصيف وغيره بأنطاكية.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن ميمون العطار، أبو العباس(@)(@@) من أهل الرقة، يروي عن أبي نعيم والعراقيين، حدثنا عنه القطان الحسين بن عبد الله بن يزيد بالرقة وغيره، مات في ذي الحجة سنة ثمان وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الفرج الأزرق(@)(@@) من أهل بغداد، يروي عن عبد الوهاب بن عطاء، حدثنا عنه أحمد بن محمد بن سعيد بن ذؤيب.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة بن بسام الحرمي(@)(@@) من أهل أذنة، أصله من شهرورد، يروي عن أبي إسحاق وأهل العراق، حدثنا عنه عمر بن سعيد بن سنان الطائي.(@)PageV01P002(@)(@@) [ج 5: ص 495](@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن ماهان البلخي(@)(@@) يروي عن المكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الجبار الهمداني، يعرف بسندوله(@)(@@) يروي عن أبي 
ms1657	 نعيم، وقد سمع ابن المبارك، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله الكريزي، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، ثنا عنه أبو عروبة، مات في ذي القعدة سنة خمسين ومائتين، وكان قاضيا على ديار مصر.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف الأنباري(@)(@@) يروي عن أبي عاصم ويحيى بن أبي بكير عن يزيد بن هارون ويعلى بن عبيد وأبي نعيم، روى عنه أهل بلده، وكانت فيه دعابة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن علي بن أبي بكر الكتاني(@)(@@) يروي عن محمد بن سعدان بن حبان عن يزيد بن أبي عبيد، روى عنه أبو حاتم الرازي في أفراد الإقامة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن بن عبد الملك البناء(@)(@@) كوفي، يروي عن أبي نعيم وعثمان بن سعيد، حدثنا عنه محمد بن إبراهيم الدستوائي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن فليح(@)(@@) شيخ، سمع ابن عيينة قصة سماعه من ابن طاوس بطولها، رواها عنه شعيب بن الخليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن خلف العسقلاني(@)(@@) يروي عن أبي نعيم وأهل الشام، حدثنا عنه ابن قتيبة.(@)PageV01P002(@)(@@) [ج 5: ص 496](@)(@@)(@@)(@@) ||| AUTO محمد بن الوليد الفحام(@)(@@) بغدادي، يروي عن أبي عاصم، ثنا عنه محمد بن صالح الطبري.(@)(@@)(@@)(@@) ||| AUTO محمد بن القاسم بن حبيب(@)(@@) من أهل بلخ، يروي عن مكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباس بن إسماعيل(@)(@@) أصله من واسط، سكن بغداد، يروي عن أبي نعيم وشعيب بن حرب، حدثنا عنه أحمد بن محمد بن الأزهر.(@)(@@)(@@)(@@) ||| AUTO محمد بن كامل البغدادي(@)(@@) سكن مرو، يروي عن وكيع وأسد بن عمرو البلخي، روى عنه المراوزة.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن أبي الحناجر(@)(@@) من أهل طرابلس، يروي عن أبي عاصم والأنصاري، حدثنا عنه الحر بن سليمان بطرابلس وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عامر بن كامل، أبو عبد الله(@)(@@) من أهل بلخ، يروي عن المكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن سنجر الجرجاني، أبو عبد الله(@)(@@) سكن مصر، يروي عن أبي عاصم والعراقيين، حدثنا عنه أحمد بن الحسن 
ms1658	 بن أبي الصغير المدائني بالفسطاط وأهل مصر، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن عقيل بن خويلد بن ميسرة(@)(@@) من أهل نيسابور، ربما أخطأ، حدث بالعراق مقدار عشرة أحاديث مقلوبة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن بن مكي بن إبراهيم(@)(@@) من أهل بلخ، يروي عن المكي بن إبراهيم، روى عنه أهل بلده، وكان قد كتب عن يحيى القطان وعبد الرحمن بن مكي.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن النضر بن سعد بن بحير بن النضر بن جندب بن عبد الله بن قطن بن المنذر بن حذافة بن حبيب بن ثعلبة بن سعد بن قيس بن ثعلبة بن عكابة بن صعب بن علي بن بكر بن وائل بن قاسط بن هنب بن أفصى بن دعمي بن جديلة بن أسد بن ربيعة بن نزار بن معد بن عدنان، أبو الفضل نبيرة PageV01P002 [ج 5: ص 497](@)(@@) ممن رحل وجمع وعنى بالعلم وجمعه وشمر الغزو وأسبابه مع الورع الخفي والجهد والسخاء الوافر، مات بعد ثمانين والمائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمران بن حبيب الهمداني(@)(@@) يروي عن أبي نعيم والقاسم بن الحكم، ثنا عنه علي بن الحسن بن سعيد وأهل همدان.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن الحسين، الذي يقال له: مدويه(@)(@@) من أهل الترمذ، يروي عن أبي نعيم ومكي بن إبراهيم ويونس المؤدب والعراقيين، ويونس المؤدب حدثنا عنه محمد بن إبراهيم الخالدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يونس بن المنير، أبو عبد الرحمن السرخسي(@)(@@) يروي عن أبي نعيم والعراقيين، حدثنا وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح الأشج(@)(@@) من أهل همدان، يروي عنه الدغولي عن يحيى بن نصر بن حاجب وأبي نعيم وعبد الصمد بن حسان، حدثنا عنه أحمد بن سعيد بهمدان وغيره، كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن زهير(@)(@@) من أهل جرجان، يروي عن أبي عاصم والأنصاري وهوذة، مستقيم الحديث، حدثنا عنه ابنه عبد الرحمن بن محمد الزهيري.(@)(@@)(@@)(@@) ||| AUTO محمد بن أيوب بن إسماعيل(@)(@@) من أهل واسط، يروي عن يزيد بن هارون، حدثنا عنه الحسن بن إبراهيم الخلال بواسط.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح الصيدلاني، 
ms1659	 أبو أحمد(@)(@@) من أهل بلخ، يروي عن مكي بن إبراهيم، روى عنه أهل بلده، وكان ربما استملى لمكي.(@)PageV01P002(@)(@@) [ج 5: ص 498](@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر البغدادي، يعرف بلقلوق(@)(@@) يروي عن أبي عاصم، حدثنا عنه الأزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن نفيل الحراني النفيلي(@)(@@) يروي عن أبي نعيم وعلي بن عباس، حدثنا عنه محمد بن المنذر بن سعيد وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن الأشعث السجستاني(@)(@@) أخو أبي داود سليمان بن الأشعث، يروي عن أبي الوليد الطيالسي، حدثنا عنه ابن أخيه أبي داود السجستاني.(@)(@@)(@@)(@@) ||| AUTO محمد بن داود السمناني، أبو جعفر(@)(@@) يروي عن أبي نعيم وأبي حذيفة، حدثنا عنه عبد الملك بن محمد وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن السلمي(@)(@@) يروي عن أبي حذيفة والبصريين، مستقيم الحديث، روى عنه أهل الأهواز.(@)(@@) (695) -[5: 498] حدثنا محمد بن يعقوب الخطيب بالأهواز، ثنا محمد بن عبد الرحمن السلمي، ثنا أبو حذيفة، ثنا سفيان، عن أبي إسحاق، قال: قرأت على نقش خاتم علي على الصلح الذي كان بينه وبين معاوية لله لا للملك.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن الحارث، أبو بكر الباغندي الواسطي(@)(@@) سكن بغداد، يروي عن عبيد الله بن موسى والعراقيين، ثنا عنه ابنه أبو بكر محمد بن محمد بن سليمان الباغندي.(@)(@@)(@@)(@@) ||| AUTO محمد بن حبيب السامي(@)(@@) يروي عن أبي نعيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن الجهم السمري(@)(@@) حدث ببغداد، يروي عن أبي نعيم والغرباء، حدثنا عنه محمد بن الأحوص بدبوسية.(@)(@@)(@@)(@@) ||| AUTO محمد بن ماهان السمسار(@)(@@) بغدادي، يروي عن أبي نعيم، كتب عنه أصحابنا.(@)PageV01P002(@)(@@) [ج 5: ص 499](@)(@@)(@@)(@@) ||| AUTO محمد بن مسلمة بن الوليد بن دينار الطيالسي، أبو جعفر(@)(@@) من أهل واسط، يروي عن يزيد بن هارون وأهل العراق، حدثنا عنه محمد بن يعقوب الهلالي.(@)(@@)(@@)(@@) ||| AUTO محمد بن شاذان الجوهري، أبو بكر(@)(@@) يروي عن أبي نعيم والمعلى بن منصور، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن منصور، أبو سليمان الفقيه(@)(@@) من أهل بلخ، يروي عن مكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة بن عبد الرحمن 
ms1660	 الحراني(@)(@@) يروي عن يحيى بن السكن وأبو نعيم، حدثنا عنه الحسين بن محمد بن أبي معشر وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن الجنيد الواسطي(@)(@@) يروي عن يزيد بن هارون، روى عنه أهل العراق والغرباء.(@)(@@)(@@)(@@) ||| AUTO محمد بن مسلم بن وارة، أبو عبد الله الرازي(@)(@@) يروي عن أبي نعيم، حدثنا عنه محمد بن المنذر بن سعيد، كان صاحب حديث، يحفظ على صلف فيه.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن يوسف السلمي، أبو إسماعيل الترمذي(@)(@@) سكن بغداد، يروي عن أبي نعيم وأبي الوليد، حدثنا عنه محمد بن إبراهيم الخارجي، مات سنة خمس وسبعين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن البناء(@)(@@) من أهل سرخس، يروي عن أبي نعيم، ثنا عنه محمد بن عبد الرحمن، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن الوضاح، أبو عبد الله(@)(@@) من أهل بلخ، يروي عن مكي بن إبراهيم، روى عنه أهل بلده.(@)PageV01P002(@)(@@) [ج 5: ص 500](@)(@@)(@@)(@@) ||| AUTO محمد بن الهيثم، أبو الأحوص العكبري(@)(@@) يروي عن أبي نعيم وإسحاق الجبني وأهل العراق، وروى عنه العراقيون والغرباء، وكان قاضيا بعكبرا، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن خشنام بن صالح(@)(@@) من أهل بلخ، يروي عن المكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن هارون بن محمد بن بكار بن هلال العاملي(@)(@@) من أهل دمشق، كنيته أبو عمر، يروي عن أبي اليمان، قد سمع أبو اليمان من جرير بن عثمان، وجرير سمع عبد الله بن بشر، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله السامي، أبو عمرو المقرئ، يعرف بالسوسي(@)(@@) كان مقيما بحلب، يروي عن أبي الوليد، حدثنا عنه محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن غالب، أبو جعفر التمتام(@)(@@) يروي عن أبي نعيم وأبي الوليد، روى عنه أهل العراق، وكان متقنا صاحب دعابة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيسى بن يزيد الطرسوسي، أبو بكر(@)(@@) يروي عن أبي نعيم وأبي اليمان، دخل ما وراء النهر فحدثهم بها يخطئ كثيرا.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن سعيد، أبو عبد الله البوشنجي(@)(@@) يروي عن 