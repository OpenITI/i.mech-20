ms101	 الرمل 1(@)(@@) % حارت الألباب منا % % حين ناجينا الحبيب % % 2(@)(@@) % فاطو برد الهجر عنا % % أيها الغصن الرطيب % % 3(@)(@@) % دور % % 4(@)(@@) % كلنا معناك نهوى % % وبذاك النشر نطوى % % 5(@)(@@) % كم أخذنا عنك فحوى % % من تغني العندليب % % 6(@)(@@) % دور % % 7(@)(@@) % لك في لوح السرائر % % مظهر خاف وظاهر % % 8(@)(@@) % كل أرباب البصائر % % نالهم منه نصيب % % 9(@)(@@) % دور % % 10(@)(@@) % أنت بين الخلق واحد % % بك نور للمشاهد % % PageV01P350 11(@)(@@) % كل شيء لك شاهد % % أنك الفرد المهيب % % 12(@)(@@) % دور % % 13(@)(@@) % ذكرك المحبوب يتلى % % وعلى العشاق يملى % % 14(@)(@@) % أبد الآباد يجلى % % نور مجلاك العجيب % % 15(@)(@@) % دور % % 16(@)(@@) % رحت بالتعظيم تذكر % % ولذكر الله أكبر % % 17(@)(@@) % لك جل الله مظهر % % سر سر غريب % % 18(@)(@@) % دور % % 19(@)(@@) % إسمك المأمون وردا % % قد تخذناه وسعدا % % 20(@)(@@) % فلك التسليم يهدى % % من قريب ومجيب % % PageV01P351 البحر : مجزوء الرمل 1(@)(@@) % برقه هيج قلبي % % حينما أج ولاح % % 2(@)(@@) % هكذا أنوار حبي % % تكسب القلب انشراح % % 3(@)(@@) % يا نسيم الصبح مني % % إرو أشواقي وعني % % 4(@)(@@) % لحبيب هو فني % % وإليه اللب راح % % 5(@)(@@) % دور % % 6(@)(@@) % كم به في الحب مضنى % % حن مولوها وأنا % % 7(@)(@@) % ذكره في كل معنى % % صار للأرواح راح % % 8(@)(@@) % دور % % 9(@)(@@) % يا كراما بالعطايا % % ملؤا كل الزوايا % % 10(@)(@@) % عبدكم خلا البرايا % % في هواكم واستراح % % PageV01P352 11(@)(@@) % دور % % 12(@)(@@) % بابكم للحشر يقصد % % وله الإحسان يسند % % 13(@)(@@) % كلما القمري ردد % % باسمكم للقوم صاح % % 14(@)(@@) % دور % % 15(@)(@@) % عجبا تلك الحقائق % % كم أطارت قلب عاشق % % 16(@)(@@) % ساقه بالوجد سائق % % نحو أرجاء البطاح % % 17(@)(@@) % دور % % 18(@)(@@) % رب أنعم بالصلاة % % لإمام الكائنات % % 19(@)(@@) % ما لتلك الواردات % % عاشق بالسر باح % % PageV01P353 البحر : خفيف تام 1(@)(@@) % يا شهودي حقق بمشهودي % % سر محو الوجود % % 2(@)(@@) % وافن طورا عن كل موجود % % عند ذاك الشهود % % 3(@)(@@) % دور % % 4(@)(@@) % لاح لي ينجلى سنا بدري % % من خلال الستور % % 5(@)(@@) % وتبدى معناه في سري % % بالخفا والظهور % % 6(@)(@@) % أطلع الحظ ليلة القدر % % في بروج السرور % % 7(@)(@@) % وجلا السعد بالهنا عمري % % فالليالي سعود % % 8(@)(@@) % دور % % 9(@)(@@) % ملأ الكون نور محبوبي % % فأزال الظلام % % 10(@)(@@) % وأتى يوسفي ليعقوبي % % بحصول المرام 
ms102	 % % PageV01P354 11(@)(@@) % يا بقايا كونيتي ذوبي % % وانشإي بالغرام % % 12(@)(@@) % حيث أني قد نلت مطلوبي % % ونزعت القيود % % 13(@)(@@) % دور % % 14(@)(@@) % برزت لي أنوار من أهوى % % بصنوف المدد % % 15(@)(@@) % ثم حلت طلاسم الفحوى % % بعد طول المدد % % 16(@)(@@) % وبمنشور غايتي القصوى % % ووثيق السند % % 17(@)(@@) % طاب وقتي بالبر والتقوى % % والوفا بالعهود % % 18(@)(@@) % دور % % 19(@)(@@) % يا عذولي رأيت بي حالك % % فجهلت الصواب % % 20(@)(@@) % وانعكاسا كرهت أفعالك % % يا لهذا الحجاب % % PageV01P355 21(@)(@@) % أنت لما واليت آمالك % % وشربت السراب % % 22(@)(@@) % حط ربي بالرد أقوالك % % وحباني الصعود % % 23(@)(@@) % دور % % 24(@)(@@) % أنا بالله مظهري حافل % % بالفخار العجيب % % 25(@)(@@) % ولتأييد شأنه كافل % % عزم طه الحبيب % % 26(@)(@@) % والرفاعي شبله الكامل % % ألحسيب النسيب % % 27(@)(@@) % مد باعي بباعه الطائل % % فقهرت الحسود % % 28(@)(@@) % دور % % 29(@)(@@) % وصلاة المهيمن القادر % % للرسول العظيم % % 30(@)(@@) % نور عيني ذخري أبي الطاهر % % ذي الجناب الكريم % % PageV01P356 31(@)(@@) % وإلى أهل بيته العامر % % بالكمال الصميم % % 32(@)(@@) % ولصحب حازوا العلا الباهر % % بإمام الوجود % % PageV01P357 البحر : مجزوء الرجز 1(@)(@@) % مولاي يا شمس الهدى % % دارك فدهري قد عدا % % 2(@)(@@) % بزلتي وذلتي % % رجوت منك المددا % % 3(@)(@@) % دور % % 4(@)(@@) % يا رحمة للعالمين % % يا تاج كل المرسلين % % 5(@)(@@) % أنت أمان الخائفين % % أليوم حقا وغدا % % 6(@)(@@) % دور % % 7(@)(@@) % ياسر آيات الشهود % % يا نور ساحات الوجود % % 8(@)(@@) % قد أثقلت عزمي القيود % % والعمر قد راح سدى % % 9(@)(@@) % دور % % 10(@)(@@) % دارك فأنت المصطفى % % وروح اصحاب الوفا % % PageV01P358 11(@)(@@) % من أم علياك اكتفى % % عن البرايا أبدا % % 12(@)(@@) % دور % % 13(@)(@@) % مولاي يا جد الحسين % % ويا ضياء كل عين % % 14(@)(@@) % أغث بجاه البضعتين % % عبدا إليك استندا % % 15(@)(@@) % دور % % 16(@)(@@) % يا كنز أسرار الكتاب % % يا أيها العالي الجناب % % 17(@)(@@) % أجبر فؤادي بالجواب % % فإن صبري نفدا % % 18(@)(@@) % دور % % 19(@)(@@) % عليك أزكى الصلوات % % بل والتحايا الطيبات % % 20(@)(@@) % والآل والصحب الثقاة % % والتابعين السعدا % % PageV01P359 21(@)(@@) % ما لاح نجم في الظلام % % وأن أرباب الغرام % % 22(@)(@@) % وما دعاك المستهام % % عبيدكم أبو الهدى % % PageV01P360 البحر : مجزوء الخفيف 1(@)(@@) % يا رسول الرضا المدد % % أنت للملتجي سند % % 2(@)(@@) % يا نبي الهدى أغث % % حل بالهمة العقد % % 3(@)(@@) % دور % % 4(@)(@@) % سر علياك قد 
ms103	 سرى % % وندا بحره جرى % % 5(@)(@@) % نحن يا سيد الورى % % غيركم ما لنا أحد % % 6(@)(@@) % دور % % 7(@)(@@) % يا رسول الملاحم % % يا نبي العوالم % % 8(@)(@@) % قام من قبل آدم % % نور مجلاك في رصد % % 9(@)(@@) % دور % % 10(@)(@@) % يا غياث البرية % % عند حطم البلية % % PageV01P361 11(@)(@@) % بالأيادي العلية % % مزق الهم والنكد % % 12(@)(@@) % دور % % 13(@)(@@) % يا حبيبا لربه % % في معاريج غيبه % % 14(@)(@@) % أنا عبد بذنبه % % لك يا سيدي استند % % 15(@)(@@) % دور % % 16(@)(@@) % موج ذنبي مذ اضطرب % % راعني الخطب باللهب % % 17(@)(@@) % فارغ لي ذمة النسب % % يا غيورا على الولد % % 18(@)(@@) % دور % % 19(@)(@@) % لك في حضرة العلا % % موكب الصولة انجلا % % 20(@)(@@) % قبل قول الألى بلى % % حولك الرفرف انعقد % % PageV01P362 21(@)(@@) % دور % % 22(@)(@@) % فاض للعرب والعجم % % منك بحر من النعم % % 23(@)(@@) % عنك يا سيدي الكرم % % قد أخذناه بالسند % % 24(@)(@@) % دور % % 25(@)(@@) % لك شمس قد انجلت % % وظلام الشقا جلت % % 26(@)(@@) % دولة الأنبيا علت % % بك يا خير مستند % % 27(@)(@@) % دور % % 28(@)(@@) % وعلى آلك الكرام % % وصحاب أولي رشد % % PageV01P363 البحر : سريع 1(@)(@@) % هب الصبا الفياح من لعلع % % ولاح يجلي بارق الأجرع % % 2(@)(@@) % يقال قل للقلب أن يصطبر % % قلت نعم لو كان قلبي معي % % 3(@)(@@) % دور % % 4(@)(@@) % أقسمت بالفجر وليل الوصال % % وطالع الشمس وذاك الجمال % % 5(@)(@@) % ما التفتت آرام تلك التلال % % إلا وكالسيل جرت أدمعي % % 6(@)(@@) % دور % % 7(@)(@@) % يا حيرة العشاق لما انجلى % % بدري منيعا في سماء العلا % % 8(@)(@@) % قد لألأت أنواره في الملا % % وسجف الإجلال لم ترفع % % 9(@)(@@) % دور % % 10(@)(@@) % كم عاشق مضنى على بابه % % يمرغ الوجه بأعتابه % % PageV01P364 11(@)(@@) % وكم ولوه ضمن سردابه % % غير أحاديث الهوى لم يعى % % 12(@)(@@) % دور % % 13(@)(@@) % يا واحد الكون بكل الشؤن % % تنوعت في الحب فيك الفنون % % 14(@)(@@) % لله كم أجرت عيونا عيون % % عليك رغم الغافل المدعي % % 15(@)(@@) % دور % % 16(@)(@@) % يا سيدي والستر شأن الحبيب % % عيبي صريح بل ودمعي صبيب % % 17(@)(@@) % أستر عيوب المستهام الكئيب % % لطفا وحبل الود لا تقطع % % 18(@)(@@) % دور % % 19(@)(@@) % يا راحة الروح ونور الفؤاد % % أدرك بنشر القرب واطو البعاد % % 20(@)(@@) % عليك صلى الله رب العباد % % ما 
ms104	 ضاء فجر الصبح في المطلع % % PageV01P365 البحر : مشطور الخبب 1(@)(@@) % ألبرق لمع والطرف دمع % % 2(@)(@@) % والقوم مضوا في الحب شيع % % 3(@)(@@) % دور % % 4(@)(@@) % حادي الركب عجلا طربي % % 5(@)(@@) % نحو الحب فالهجر صدع % % 6(@)(@@) % دور % % 7(@)(@@) % طر يا حادي نحو الهادي % % 8(@)(@@) % قرب النادي والفجر طلع % % 9(@)(@@) % مذ بان البان % % حول الكثبان % % 10(@)(@@) % قبل الركبان % % قلبي أسرع % % PageV01P366 11(@)(@@) % دور % % 12(@)(@@) % حدقت إليه % % لأكون لديه % % 13(@)(@@) % قد خفت عليه % % أن يتقطع % % 14(@)(@@) % دور % % 15(@)(@@) % قلب مغرم % % فيمن يعلم % % 16(@)(@@) % والحب قسم % % ممن أودع % % 17(@)(@@) % دور % % 18(@)(@@) % فاعشق واسكر % % في ذا المظهر % % 19(@)(@@) % هو في المحشر % % فينا يشفع % % 20(@)(@@) % دور % % PageV01P367 21(@)(@@) % وصلاة الله % % لحبيب الله % % 22(@)(@@) % مقبول الجاه % % طه الأورع % % PageV01P368 البحر : رمل تام 1(@)(@@) % كلما رام حسودي ذلتي % % قال ربي رح عزيزا لا تخف % % 2(@)(@@) % وبمحض الفضل أعلى رتبتي % % وحباني منه بالغيب الشرف % % 3(@)(@@) % دور % % 4(@)(@@) % هذه آيات رب العالمين % % لم تزل بالأمن تحمي الخائفين % % 5(@)(@@) % وعنايات إمام المرسلين % % في بنيه خلفا بعد سلف % % 6(@)(@@) % دور % % 7(@)(@@) % نحن ترك الكون من مذهبنا % % وخيول الغيب في موكبنا % % 8(@)(@@) % كل من حاربنا حار بنا % % ومضى بالهم في قيد التلف % % 9(@)(@@) % دور % % 10(@)(@@) % نحن أهل البيت أبناء البتول % % جدنا شمس الهدى طه الرسول % % PageV01P369 11(@)(@@) % ومن الله لنا دوما قبول % % ما سألناه الرضا إلا عطف % % 12(@)(@@) % دور % % 13(@)(@@) % نحن كم منا ولي ذو مدد % % حل بالسر الإلهي العقد % % 14(@)(@@) % ولكم منا مرب معتقد % % قام عن اسلافنا خير الخلف % % 15(@)(@@) % دور % % 16(@)(@@) % نحن منا علم الشرق الخطير % % ألرفاعي الحسيني الكبير % % 17(@)(@@) % سيد أبرد بالعزم السعير % % وعن الأكوان لله انصرف % % 18(@)(@@) % دور % % 19(@)(@@) % نحن منا القطب ترياق السموم % % شيخنا المهدي نبراس العلوم % % 20(@)(@@) % عارف عد لدى أهل الفهوم % % في خبايا الغيب من أبهى التحف % % PageV01P370 21(@)(@@) % دور % % 22(@)(@@) % نحن قوم قد طرقنا بالأدب % % باب بارينا ولم نبغ السبب % % 23(@)(@@) % قلبنا عن قالب الكون انقلب % % وبصدق العزم لله انعطف % % 24(@)(@@) % دور % % 25(@)(@@) % رب أنعم بصلاة وسلام % % للنبي المصطفى سر الأنام % % 26(@)(@@) % وإلى 
ms105	 الأصحاب والأل الكرام % % ما بباب الله ذو حال وقف % % PageV01P371 البحر : مجزوء الخفيف 1(@)(@@) % يا حبيبي إلى متى % % غصة الهجر والجفا % % 2(@)(@@) % لطف معناك أثبتا % % شيم العطف والوفا % % 3(@)(@@) % دور % % 4(@)(@@) % أنت والله قبلتي % % ومن الكون بغيتي % % 5(@)(@@) % لك وجهت وجهتي % % بدل السقم بالشفا % % 6(@)(@@) % دور % % 7(@)(@@) % لاح مجلاك للشهود % % وعلينا لك العهود % % 8(@)(@@) % قام في سرك الوجود % % وبه أنت مصطفى % % 9(@)(@@) % دور % % 10(@)(@@) % أين يا سيدي الكرم % % والندى الجم والهمم % % PageV01P372 11(@)(@@) % حارب القلب جيش هم % % فتداركه بالصفا % % 12(@)(@@) % دور % % 13(@)(@@) % عتمة الهم تنجلي % % بك يا خير مرسل % % 14(@)(@@) % أنت حصن المؤمل % % إن وفا الدهر أو جفا % % 15(@)(@@) % دور % % 16(@)(@@) % سر معناك قد سرى % % ولقد حير الورى % % 17(@)(@@) % أنا عبد كما ترى % % بك عن غيرك اكتفى % % 18(@)(@@) % دور % % 19(@)(@@) % سيدي العمر قد مضى % % وبحكم الهوى انقضى % % 20(@)(@@) % فمتى جدت بالرضا % % حسبي الله وكفى % % PageV01P373 البحر : هزج 1(@)(@@) % ملح الوجد قد أفنى % % بنار الحب عشاقك % % 2(@)(@@) % وقد أحياهم المعنى % % وخط الحظ أوراقك % % 3(@)(@@) % دور % % 4(@)(@@) % بدا في عالم الأسما % % رفيعا بدرك الأسمى % % 5(@)(@@) % وفي فرقانه قدما % % أجل الله أخلاقك % % 6(@)(@@) % دور % % 7(@)(@@) % بقيد الصدق للطلاب % % إلى العليا فتحت الباب % % 8(@)(@@) % وبعد القيد للأحباب % % لقد أبرزت إطلاقك % % 9(@)(@@) % دور % % 10(@)(@@) % لعمري أنت شمس الله % % أضاءت في بلاد الله % % PageV01P374 11(@)(@@) % وفي آفاق غيب الله % % أباح السر إشراقك % % 12(@)(@@) % دور % % 13(@)(@@) % أقامت عندك الآمال % % وتم الحط والترحال % % 14(@)(@@) % قلوب القوم أهل الحال % % طوت للحشر أشواقك % % 15(@)(@@) % دور % % 16(@)(@@) % تبدى نورك الأجلى % % فجلى ليلنا فضلا % % 17(@)(@@) % لهذا المظهر الأعلى % % حمدنا الله خلاقك % % 18(@)(@@) % دور % % 19(@)(@@) % بعزمك للوجود العون % % وللعبد المحب الصون % % 20(@)(@@) % ودهرا في سماء الكون % % ترى الأبصار إبراقك % % PageV01P375 21(@)(@@) % دور % % 22(@)(@@) % عليك تحية الوهاب % % وأهل البيت والأصحاب % % 23(@)(@@) % فهم في زمرة الأحباب % % بهم أفرغت أذواقك % % PageV01P376 البحر : مشطور الرجز 1(@)(@@) % مولاي يا حامي الحمى % % مضناك يهواك % % 2(@)(@@) % كم جفنه الباكي هما % % شوقا لمغناك % % 3(@)(@@) % عبد لعلياك استند % % وأنت حلال العقد % % 4(@)(@@) % ما كان أرض أو سما % % والله 
ms106	 لولاك % % 5(@)(@@) % لازمة % % 6(@)(@@) % لك التجلي في الأزل % % برفعة الشان % % 7(@)(@@) % يا من عليك قد نزل % % بالوحي قرآن % % 8(@)(@@) % ونظم ما زاغ البصر % % أبدى علاك للبشر % % 9(@)(@@) % وقمت فردا علما % % والرب أعطاك % % 10(@)(@@) % دور % % PageV01P377 11(@)(@@) % يا تاج سادات الملا % % يا حجة الله % % 12(@)(@@) % يا رأس أصحاب العلى % % في حضرة الله % % 13(@)(@@) % أبرزت أسرار الخفا % % يا مجتبى يا مصطفى % % 14(@)(@@) % وكل هم عظما % % يجلوه معناك % % 15(@)(@@) % دور % % 16(@)(@@) % لله يا جد الحسين % % يا نعم ناصر % % 17(@)(@@) % يا روح جسم الثقلين % % خاف وظاهر % % 18(@)(@@) % لعزك المجد انتهى % % ومس خمصيك السها % % 19(@)(@@) % والأنبياء العظما % % لاذوا بعلياك % % 20(@)(@@) % دور % % PageV01P378 21(@)(@@) % عليك يا طه السلام % % ما أن عاشق % % 22(@)(@@) % والآل والصحب الكرام % % أهل السوابق % % 23(@)(@@) % والتابعين الأصفيا % % والعارفين الأوليا % % 24(@)(@@) % ما أج في أسمى % % نور محياك % % PageV01P379 البحر : مشطور الرجز 1(@)(@@) % ألله حسبي وكفى % % في كل حال % % 2(@)(@@) % وفي رحاب المصطفى % % حطت رحالي % % 3(@)(@@) % به احتمى أهل الصفا % % في كل ناد % % 4(@)(@@) % وبالظهور والخفا % % نالوا المعالي % % 5(@)(@@) % لازمة % % 6(@)(@@) % يا تاج هام الأنبيا % % والمرسلين % 7(@)(@@) % ويا ملاذ الأوليا % % والعارفين % 8(@)(@@) % أدرك عبيدا نابه % % ناب الأعادي % % 9(@)(@@) % وقال يا بحر الوفا % % خذ عرض حالي % % 10(@)(@@) % دور % % PageV01P380 11(@)(@@) % أنت لك الجاه الرفيع % % في كل نازل % % 12(@)(@@) % ورحبك الرحب الوسيع % % لكل داخل % % 13(@)(@@) % إليك يا حامي الحمى % % كل استنادي % % 14(@)(@@) % أرفق فرسمي قد عفا % % والجسم بالي % % 15(@)(@@) % دور % % 16(@)(@@) % يا صاحب الخلق العظيم % % يا خير مرسل % % 17(@)(@@) % أدعوك للهم المقيم % % فالصبر قد قل % % 18(@)(@@) % إرحم عويلي واحمني % % يوم المعاد % % 19(@)(@@) % فأنت نلت الإصطفا % % من ذي الجلال % % 20(@)(@@) % دور % % PageV01P381 21(@)(@@) % لا زال داعي الصلوات % % يا روح روحي % % 22(@)(@@) % من قدس رب الكائنات % % إليك يوحي % % 23(@)(@@) % والآل والصحب الألى % % أزكى العباد % % 24(@)(@@) % ما طاب قلب وصفا % % حال بحال % % PageV01P382 البحر : رمل تام 1(@)(@@) % يا نسيما هب من أرض الحجاز % % فطوى في القلب نيران الغرام % % 2(@)(@@) % عن حقيقي المعاني والمجاز % % هات أخبار الأخلاء الكرام % % 3(@)(@@) % دور % % 4(@)(@@) % لاح برق في سموات الجنوب % % فتداعت 
ms107	 عندما لاح القلوب % % 5(@)(@@) % هكذا والله آيات الغيوب % % دائما تبدو لأهل الإصطلام % % 6(@)(@@) % دور % % 7(@)(@@) % لمعت نيرانهم في لعلع % % أهل ودي وأبيحت أدمعي % % 8(@)(@@) % أين قلبي آه لو كان معي % % لتسلقت به نحو الخيام % % 9(@)(@@) % دور % % 10(@)(@@) % جذبتني من شذاهم نفحات % % صرفتني عن شؤن الكائنات % % PageV01P383 11(@)(@@) % هي تلك الباقيات الصالحات % % والسوى بالعدم الطمسي قام % % 12(@)(@@) % دور % % 13(@)(@@) % يا شموسا في قلوب العاشقين % % أبرزت أنوارها للعارفين % % 14(@)(@@) % أنتم مقصودنا في كل حين % % حيث كنا في مسير أو مقام % % 15(@)(@@) % دور % % 16(@)(@@) % قسما بالعهد والود القديم % % يا ملوك الحي والحب الصميم % % 17(@)(@@) % حالكم ما زال في سري مقيم % % يتجلى في قعودي والقيام % % 18(@)(@@) % دور % % 19(@)(@@) % جاء ريح الحب من نحو الحرم % % فانتشقنا مسكه الزاكي الشمم % % 20(@)(@@) % وتداعينا على باب الكرم % % نلثم الأرض بأنواع الهيام % % PageV01P384 21(@)(@@) % دور % % 22(@)(@@) % حاجة في نفس يعقوب انطوت % % قصة المحزون يا قوم روت % % 23(@)(@@) % قصدتكم وعن الكون التوت % % فأغيثوها حنانا يا كرام % % 24(@)(@@) % دور % % 25(@)(@@) % سركم سار بكل العالمين % % وتجلى نوره للواصلين % % 26(@)(@@) % فارحموا فضلا أنين العاشقين % % عل يجلو نوركم هذا الظلام % % 27(@)(@@) % دور % % 28(@)(@@) % رب أنعم دائما بالصلوات % % والتحايا الزاكيات الطيبات % % 29(@)(@@) % لإمام الرسل رب المعجزات % % ولأبناء وصحب والسلام % % PageV01P385 البحر : مجزوء الرجز 1(@)(@@) % ما حيلة الصب المهام % % فالهجر والهفاه دام % % 2(@)(@@) % أبكته ركبان الحمى % % مذ يممت ذاك المقام % % 3(@)(@@) % دور % % 4(@)(@@) % يا أهل وادي المنحنى % % ظهري من الصد انحنى % % 5(@)(@@) % هلا مننتم بالمنى % % فضلا لهذا المستهام % % 6(@)(@@) % دور % % 7(@)(@@) % عبد على باب الكرم % % قد صار نهبا للسقم % % 8(@)(@@) % راعني مولاي واستر للعيوب % % كرما فالعفو من شأن الكرام % % 9(@)(@@) % دور % % 10(@)(@@) % كل أوقاتي بكاء وعويل % % يا ضياء العين والقلب عليل % % PageV01P386 11(@)(@@) % ها أنا في بابك العالي دخيل % % ودخيل المصطفى ليس يضام % % 12(@)(@@) % دور % % 13(@)(@@) % سيدي مني عليك الصلوات % % ومن الله التحايا الزاكيات % % 14(@)(@@) % وعلى آلك أهل المكرمات % % وعلى الأصحاب دهرا والسلام % % PageV01P387 البحر : مجزوء الرمل 1(@)(@@) % ما تبدى البدر إلا % % همت للبدر التهامي % % 2(@)(@@) % وفرشت الخد ذلا % % عند ذياك 
ms108	 المقام % % 3(@)(@@) % لازمه % % 4(@)(@@) % يا حبيبا هو روحى % % وغبوقي وصبوحي % % 5(@)(@@) % راح منك اللطف يوحي % % لفؤادي باصطلام % % 6(@)(@@) % دور % % 7(@)(@@) % بك عزي وافتخاري % % لك ذلي وافتقاري % % 8(@)(@@) % إن طور الإنكسار % % دين أصحاب الغرام % % 9(@)(@@) % دور % % 10(@)(@@) % أنت سر الكائنات % % أنت نور البارزات % % PageV01P388 11(@)(@@) % أنت في طور الحياة % % روح أرباب الهيام % % 12(@)(@@) % دور % % 13(@)(@@) % كم لك العشاق طارت % % ومن الهجر استجارت % % 14(@)(@@) % جارت المزن وحارت % % بين سحب وضرام % % 15(@)(@@) % دور % % 16(@)(@@) % لك إسراء القلوب % % بمعاريج الغيوب % % 17(@)(@@) % بك غفران الذنوب % % عند خلاق الأنام % % 18(@)(@@) % دور % % 19(@)(@@) % عنك سر الغيب ينقل % % ولك المجد المؤثل % % 20(@)(@@) % وعليك الله أنزل % % للهدى محي العظام % % PageV01P389 21(@)(@@) % دور % % 22(@)(@@) % أنت مولى كل مولى % % إن تدني أو تدلى % % 23(@)(@@) % فعليك الله صلى % % وعلى الآل الكرام % % PageV01P390 البحر : مجزوء الرمل 1(@)(@@) % الأمان الأمان % % يا حبيب الرحمن % % 2(@)(@@) % أنت شمس الهدى % % في بروج العيان % % 3(@)(@@) % لازمه % % 4(@)(@@) % لك في الحضرتين % % صولة الدولتين % % 5(@)(@@) % منك في النشأتين % % لاح نور البيان % % 6(@)(@@) % أعظم المرسلين % % أنت في العالمين % % 7(@)(@@) % درع أهل اليقين % % أنت في كل آن % % 8(@)(@@) % دور % % 9(@)(@@) % لك فصل الخطاب % % وعظيم الجناب % % 10(@)(@@) % وبيوم الحساب % % فعليك الضمان % % PageV01P391 11(@)(@@) % دور % % 12(@)(@@) % بك مجلى الشهود % % لصدور الوجود % % 13(@)(@@) % منك فجر السعود % % عم عتم الزمان % % 14(@)(@@) % دور % % 15(@)(@@) % دامت المعجزات % % منك في الكائنات % % 16(@)(@@) % أنت في الحادثات % % ذخر إنس وجان % % 17(@)(@@) % دور % % 18(@)(@@) % بخشوع لديك % % قد هرعنا إليك % % 19(@)(@@) % فالصلاة عليك % % يا صراط الأمان % % PageV01P392 البحر : مجزوء الرمل 1(@)(@@) % يا رسول الثقلين % % يا إمام القبلتين % % 2(@)(@@) % أنت معراج فؤادي % % قبلتي قرة عيني % % 3(@)(@@) % دور % % 4(@)(@@) % أنت سلطان الوجود % % أنت نبراس الشهود % % 5(@)(@@) % لك بالسر وفودي % % يا هزبرالحضرتين % % 6(@)(@@) % دور % % 7(@)(@@) % أنت تاج الأنبياء % % أنت عزالأولياء % % 8(@)(@@) % أنت روح الأصفياء % % أنت جد الحسنين % % 9(@)(@@) % دور % % 10(@)(@@) % أنت سلطان الحظائر % % لك تزدان المحاضر % % PageV01P393 11(@)(@@) % سرك السيار حاضر % % أبدا في العالمين % % 12(@)(@@) % دور % % 13(@)(@@) % أنت برهان التجلي % % ضمن سرداب التدلي % % 14(@)(@@) % لك أشكو فرط ذلي % % يا عزيز النشأتين % % 15 
ms109	(@)(@@) % دور % % 16(@)(@@) % وعليك الله صلى % % كلما فضلا تجلى % % 17(@)(@@) % ما دعا داع وصلى % % خاشع في الحرمين % % 18(@)(@@) % دور % % 19(@)(@@) % وعلى الآل الأكابر % % وصحاب كالزواهر % % 20(@)(@@) % وعلى قطب الدوائر % % شيخنا ذي العلمين % % PageV01P394 البحر : منهوك الرجز 1(@)(@@) % يا غصن نعمان % % عطفك ما آن % % 2(@)(@@) % عبدك حقا % % للقرب ظمآن % % 3(@)(@@) % دور % % 4(@)(@@) % بلطف معناك % % أرفق بمضناك % % 5(@)(@@) % قد ضاء مجلاك % % للإنس والجان % % 6(@)(@@) % دور % % 7(@)(@@) % كم فيك مغرم % % مثلي مهيم % % 8(@)(@@) % أنعم تكرم % % فالقلب ولهان % % 9(@)(@@) % دور % % 10(@)(@@) % ناجتك أرواح % % باسمك ترتاح % % PageV01P395 11(@)(@@) % والعشق فضاح % % والوجد نيران % % 12(@)(@@) % دور % % 13(@)(@@) % للشوق إضرام % % والقلب قد هام % % 14(@)(@@) % عليك من لام % % لا كان من كان % % 15(@)(@@) % دور % % 16(@)(@@) % أدمت صدك % % أطلت وعدك % % 17(@)(@@) % عبدك عهدك % % في الحب ما خان % % 18(@)(@@) % دور % % 19(@)(@@) % عليك صلى % % مولاك فضلا % % 20(@)(@@) % ما رحت تجلى % % والبدر حيران % % PageV01P396 البحر : مجزوء الرجز 1(@)(@@) % يا حادي الركبان % % متى وصلت البان % % 2(@)(@@) % أرح هناك العيس % % وبشر الولهان % % 3(@)(@@) % دور % % 4(@)(@@) % أرواحنا راحت % % وباللقا ارتاحت % % 5(@)(@@) % شمس الحمى لاحت % % فضاءت القيعان % % 6(@)(@@) % دور % % 7(@)(@@) % ما أكثر الأحباب % % وجدا بذاك الباب % % 8(@)(@@) % تطوف بالأعتاب % % وكلها أشجان % % 9(@)(@@) % دور % % 10(@)(@@) % يا ساكني رامة % % ألنار ضرامة % % PageV01P397 11(@)(@@) % والروح صوامة % % لكم عن الأكوان % % 12(@)(@@) % دور % % 13(@)(@@) % لأجلكم سرنا % % روحا وقد طرنا % % 14(@)(@@) % وفي الهوى حرنا % % وذو الهوى حيران % % 15(@)(@@) % دور % % 16(@)(@@) % يا بغية العشاق % % في القيد والإطلاق % % 17(@)(@@) % أسرارنا تشتاق % % معناكم الفتان % % 18(@)(@@) % دور % % 19(@)(@@) % ألله أعطاكم % % فضلا وأعلاكم % % 20(@)(@@) % والكون لولاكم % % وحقكم ما كان % % PageV01P398 21(@)(@@) % دور % % 22(@)(@@) % عليكم الأرواح % % دارت لها أقداح % % 23(@)(@@) % وذكركم كالراح % % طابت به الندمان % % 24(@)(@@) % دور % % 