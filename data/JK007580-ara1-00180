ms161	 عن مسيء تابا(@)PageV01P716(@)(@@) البحر : طويل(@)(@@) 1 عوى في سواد الليل عاف لعله %~% يجاب ، وأنى ، والديار عوافي ؟(@)(@@) 2 وليس ، إذا الحساد كانت عيونهم %~% شوافن للداء الدفين شوافي(@)(@@) 3 صوافن خيل عند باب مملك %~% جمعن ، وما أوقاته بصوافي(@)(@@) 4 وسرك مثل العرس أوفت لواحد ، %~% وأعوزها ، للصاحبين ، توافي(@)(@@) 5 وأسرار بعض الناس بانت لناظر %~% كأسرار كف ، غيرهن ، خوافي(@)(@@) 6 خواتم أعمال الفتى ، إن بغى الهدى ، %~% هدته وإلا ، فالهموم ضوافي(@)(@@) 7 وأعمارنا أبيات شعر كأنما %~% أواخرها ، للمنشدين ، قوافي(@)(@@) 8 إذا حسنت زانت ، وإن قبحت جنت %~% أذى وهوى فيما يسوء هوافي(@)(@@) 9 نوى في باغ ما يضر ، ودونه %~% خطوب لإيجاب الحقود نوافي(@)(@@) 10 وكم طالب وافى ، وقد سار للغنى ، %~% سوافي ريح ، فانثنى بسواف PageV01P717(@)(@@) 11 طوافي در يمنح الجد أهله %~% برفق ، فيغني عن سرى وطواف(@)(@@) 12 حوى في رخاء وادع فضل نعمة %~% عداها مكل والركاب حوافي(@)PageV01P718(@)(@@) البحر : كامل تام(@)(@@) 1 أتصح توبة مدرك من كونه %~% أو أسود من لونه فيتوبا(@)(@@) 2 كتب الشقاء على الفتى ، في عيشه ، %~% وليبلغن قضاءه المكتوبا(@)(@@) 3 وإذا عتبت المرء لست بمعتب %~% ألفيت فيما جئته معتوبا(@)(@@) 4 يبغي المعاشر في الزمان وصرفه %~% رتبا كأن لهن عليه رتوبا(@)PageV01P719(@)(@@) البحر : وافر تام(@)(@@) 1 أيا شجر العرا ! أوسعت ريا ، أيا شجر العرا ! أوسعت ريا ، %~% فقد جف العضاه ، ولم تجفي(@)(@@) 2 وما يبقى ، إذا فتشت ، حي %~% تخيره الحوادث ، أو تنفي(@)(@@) 3 لكافور غدا الكافور زادا %~% وجفت أبحر من آل جف(@)(@@) 4 وهل فات ، الحتوف ، أخو هذيل ، %~% تكلفت الوفاء ، وحم يوم(@)(@@) 5 أو العادي السليك وصاحباه ، %~% أو الأسدي كالصعل الهزف(@)(@@) 6 تجم جيوشها ، فيضل فيها %~% فتى يجتاب صفا بعد صف(@)(@@) 7 %~% أراح من التوافي بالتوفي(@)(@@) 8 ودهري بالمغار أغار صبري %~% وعلمني التعفف بالتعفي(@)(@@) 9 أما شغل الأنام ، عن التقافي ، %~% بما وعد الزمان من التقفي(@)(@@) 10 وقد صدقت ظنون من رجال ، %~% تخفوا ما توارى بالتخفي PageV01P720(@)(@@) 11 رأوا متسترا عنهم بسد %~% ليأجوج ، كمستتر بشف(@)(@@) 12 لقد عجب القضاء لركب موج %~% يقابله بمزمار ودف(@)(@@) 13 ولو نالت عقاب اللوح لبا 
ms162	 ، %~% عداها عن تكفؤها التكفي(@)(@@) 14 وقد يغني المسف ، إلى الدنايا ، %~% تعيشه من الخوص المسف(@)(@@) 15 ووطء السف ، يحمي الرجل منه %~% بكور يد على ذرة بسف(@)(@@) 16 وكم بسط البنان فعاد صفرا %~% وزار الجود كفا ذات كف(@)(@@) 17 وما زف الكعاب سوى عناء %~% وإن عنيت لمسواك برف(@)(@@) 18 وكم زفت إلى جدث عروس ، %~% وقد همت إلى عرس بزف(@)(@@) 19 أرى دنياك خالطها قذاها %~% وأعيت أن يهذبها مصفي(@)(@@) 20 بنوها مثلها فحللت منهم %~% بوهد أو بهضب أو بقف PageV01P721(@)(@@) 21 تهيج ضغائر الأشياء خطبا %~% جليلا ما سناه بمستشف(@)(@@) 22 وإن القتل في أحد وبدر ، %~% جنى القتلين في نهر وطف(@)(@@) 23 وإن لذ القبيح غواة قوم ، %~% فإن الفضل يعرف للأعف(@)(@@) 24 وليس علي غير بلوغ جهدي %~% وضيفي قانع مني بضف(@)(@@) 25 إذا استثقلت أثوابي ونعلي %~% فثقلي في التجرد والتحفي(@)(@@) 26 لعل مطية مني قريب %~% فيحمل سيرها قدما بخف(@)(@@) 27 وما سل المهند للتوقي ، %~% كسل المشرفية للتشفي(@)(@@) 28 وليس الخمس ضاربة بسيف %~% نظير الخمس ضاربة بدف(@)(@@) 29 أباغي حظه بقنا وخيل ، %~% كباغيه بمنوال وحف ؟(@)(@@) 30 وما الجبل الوقور لجاذبيه ، %~% على العلات كالجزء الأخف PageV01P722(@)(@@) 31 وجسمي شمعة والنفس نار %~% إذا حان الردى خمدت بأف(@)(@@) 32 أعيرت النعام أولات فرع %~% خلو الهام من ريش وزف(@)(@@) 33 لعل النبع تثنيه الليالي %~% أخا ورق ، ونور مستكف(@)(@@) 34 إذا ما القائل الكندي ذلت %~% له الأوزان ، فاعترفي بشف(@)(@@) 35 فإن عطاردا ، في الجو ، أولى %~% بأن يزن الكلام وأن يقفي(@)(@@) 36 وأقصي عن مآربك البرايا ، %~% ولا يغررك خلك بالتحفي(@)(@@) 37 وفذ ، في مقاصده ، بليغ ، %~% أحب إلي من إلف ألف(@)(@@) 38 لعمر أبيك ما خالي بخال %~% لشائمه ، ولا شهدي بهف(@)(@@) 39 فإن أعط القليل يكن هنيا %~% يجيء المستميح بغير شف(@)(@@) 40 إذا ورد الفقير على احتياجي %~% أغثت لهيفه بالمستدف PageV01P723(@)(@@) 41 ولو كان الكثير لقل عندي ، %~% وأهون بالطفيف المستطف(@)PageV01P724(@)(@@) البحر : سريع(@)(@@) 1 عفوك للعالم لا تخلين %~% حنظبه منه ولا عنظبه(@)(@@) 2 لا ظبة الصارم باشرتها ، %~% فيك ، ولا زرت ، لحجي ، ظبه(@)PageV01P725(@)(@@) البحر : وافر تام(@)(@@) 1 
ms163	 غدونا مثقلين بما اكتسبنا %~% وعل العفو منه سوف يعفي(@)(@@) 2 وفكري سل حب المال مني ، %~% ووجدي بالحياة أطال شعفي(@)(@@) 3 وكون الجسم في جسد خبيئا %~% أشق عليه من هرم وضعف(@)(@@) 4 ستضربني الحوادث في نظيري ، %~% فتمحقني ، ولا أزداد ضعفي(@)(@@) 5 وتنزلني سيول الدهر كرها %~% إلى وادي من جبلي ونعفي(@)PageV01P726(@)(@@) البحر : خفيف تام(@)(@@) 1 قد صحبنا الزمان بالرغم منا ، %~% وهو يردي ، كما علمت ، الصحابا(@)(@@) 2 وحللنا المضيق ، ثم أتينا الرحب ، %~% لو دام تركنا والرحابا(@)(@@) 3 والجسوم التران تحيا بسقيا ، %~% فلهذا قلنا سقيت السحابا(@)(@@) 4 قد رضينا الشحوب لوكان صرف الده %~% ر يرضى ، للأوجه ، الإشحابا(@)(@@) 5 وضحكنا ، وليس ما يوجب الضحك %~% ك ، لدينا ، بل ما يهيج انتحابا(@)(@@) 6 كم أمير أمير في عاصفات %~% بعدما حاب في الحياة وحابى(@)PageV01P727(@)(@@) البحر : وافر تام(@)(@@) 1 بحمد الله لم تخلق كعاب %~% تجنب كل مخزية وعنف(@)(@@) 2 فجدع حل في أذني غلام ، %~% أبر لديه من قرط وشنف(@)(@@) 3 ولا سيما إذا أعطيت أيدا ، %~% لمد يديك ، أو أنفا بأنف(@)(@@) 4 أرى الأيام تجحد ثم تثني %~% بإيجاب ، وتوجب ثم تنفي(@)(@@) 5 وإن لم يعقل الأقدام عيب %~% حملن الثقل من فدع وحنف(@)(@@) 6 وقد يحتال في رد الرزايا %~% بعود مغرد ، أو عود صنف(@)(@@) 7 وكم غرت معاطس ، من رجال ، %~% بريح ألوة أو ريح رنف(@)PageV01P728(@)(@@) البحر : خفيف تام(@)(@@) 1 زاره حتفه فقطب للموت %~% ت ، وألقى من بعدها التقطيبا(@)(@@) 2 زوده طيبا ليلحق بالناس %~% وحسب الدفين بالتراب طيبا(@)(@@) 3 نام في قبره ، ووسد يمنا %~% ه ، فخلناه قام فينا خطيبا(@)(@@) 4 للمنايا حواطب لا تبالي %~% أهشيما جرت لها أم رطيبا(@)(@@) 5 صرفت كأسها ، فلم تسق شربا %~% مرة ، خالصا ، وأخرى قطيبا(@)PageV01P729(@)(@@) البحر : وافر تام(@)(@@) 1 لقد نفق الرديء ورب مر %~% من الأقوات يجعل في الصحاف(@)(@@) 2 وأكرمني ، على عيبي ، رجال ، %~% كما روي القريض على الزحاف(@)(@@) 3 ومن يركب إلى الهيجاء خيلا %~% فإن سواه يقدم ، وهو حافي(@)PageV01P730(@)(@@) البحر : خفيف تام(@)(@@) 1 زعموا أن ما يدكر إن %~% رن أنثى ، لم يعدم التغليبا(@)(@@) 2 باطل ذاك ، إن 
ms164	 لبي ، إلى الدن %~% قرين ، وما يزال سليبا(@)(@@) 3 والمنايا كالأسد ، تفترس الأح %~% ياء ، جمعا ولا تعاف الكليبا(@)(@@) 4 مثل ما في جرير أخي القول %~% يصيد الكركي والعندليبا(@)(@@) 5 تفرع الشامخ المنيف ، من الش %~% م ، وتهوي ، فتستبيح القليبا(@)(@@) 6 كم سقين الحمام شارب ماء %~% ومدام ، أو من يسقى حليبا(@)(@@) 7 قدر نازل من الجو ، نادى %~% بالنصارى حتى أجلوا الصليبا(@)(@@) 8 والنجاشي صار ملك أناس %~% بعدما هم أن يعد جليبا(@)PageV01P731(@)(@@) البحر : وافر تام(@)(@@) 1 إذا ما ألحدت أمم بجهل %~% فقابلها بتلحيد السيوف(@)(@@) 2 كأنا في سجايانا نقود %~% كثيرات البهارج والزيوف(@)(@@) 3 وهذي الأرض للملك المرجى %~% نلم بها ، كإلمام الضيوف(@)PageV01P732(@)(@@) البحر : مجتث(@)(@@) 1 إن يقرب الموت مني %~% فلست أكره فربه(@)(@@) 2 وذاك أمنع حصن %~% يصبر القبر دربه(@)(@@) 3 والوقت مامر ، إلا %~% خطبا ، ولا يخش كربه(@)(@@) 4 كأنني رب إبل ، %~% أضحى يمارس جربه(@)(@@) 5 أو ناشط يتبغى ، %~% في مقفر الأرض ، عربه(@)(@@) 6 وإن رددت لأصلي ، %~% دفنت في شر تربه(@)(@@) 7 و اليوم ما مر إلا %~% وحل في العمر أربه(@)(@@) 8 كل يحاذر حتفا ، %~% وليس يعدم شربه(@)(@@) 9 ويتقي الصارم العض %~% أن يباشر عربه(@)(@@) 10 والنزع ، فوق فراش ، %~% أشق من ألف ضربه PageV01P733(@)(@@) 11 واللب حارب ، فينا ، %~% طبعا يكابد حربه(@)(@@) 12 يا ساكن اللحد ! عرف %~% ني الحمام وإربه(@)(@@) 13 ولا تضن ، فإني %~% ما لي بذلك دربه(@)(@@) 14 يكر في الناس كالأج %~% المعاود سربه(@)(@@) 15 وما أظن المنايا ، %~% تخطو كواكب جربه(@)(@@) 16 لا ذات سرب يعري %~% دى ، ولا ذات سربه(@)(@@) 17 ستأخذ النسر والغفر %~% والسماك وتربه(@)(@@) 18 فتشن عن كل نفس %~% شرق الفضاء وغربه(@)(@@) 19 وزرن عن غير بر %~% عجم االأنام وعربه(@)(@@) 20 ما ومضة من عقيق %~% إلا تهيج طربه PageV01P734(@)(@@) 21 هوى تعبد حرا %~% فما يحاول هربه(@)(@@) 22 من رامني لم يجدني ، %~% إن المنازل غربه(@)(@@) 24 كانت مفارق جون ، %~% كأنها ريش غربه(@)(@@) 25 ثم انجلت فعجبنا %~% للقار بدل صربه(@)(@@) 26 إذا خمصت قليلا ، %~% عددت ذلك قربه(@)(@@) 27 وليس عندي ، من آلة %~% السرى غير قربه(@)PageV01P735(@)(@@) البحر : مجتث(@)(@@) 1 
ms165	 الله ينقل من شا %~% رتبة بعد رتبه -(@)(@@) 2 أبدى العتاهي نسكا %~% وتاب من ذكر عتبه(@)(@@) 3 والخوف ألزم سفيا %~% ن أن يغرق كتبه(@)PageV01P736(@)(@@) البحر : -(@)(@@) 1 كأنما دنياك وحشية ، %~% نظرت في آثار أظلافها(@)(@@) 2 ما بقي الواحد من ألفها ، %~% بل هو من ستة آلافها(@)(@@) 3 إن أخلفتك ، اليوم ، موعودها ، %~% فعرفها جار بإخلافها(@)(@@) 4 حلفت : ما حالفها عاقل ، %~% _ وشأنها الغدر بأحلافها _(@)(@@) 5 %~% وذائب السم بأخلافها(@)(@@) 6 أتلف إذا أعطتك ، أعراضها %~% فإنها رهن بإتلافها(@)(@@) 7 تلك عجوز ألفت شرها ، %~% قبل بني فهر وإيلافها(@)PageV01P737(@)(@@) البحر : متقارب تام(@)(@@) 1 كريم أناب ، وما أنبا ، %~% وأنساه طول المدى زينبا(@)(@@) 2 لإحدى الأرانب في قومها %~% وإن صبحت بعدنا أرنبا(@)(@@) 3 لها والد ، بيته شامخ ، %~% مع النسر أو مثله طنبا(@)(@@) 4 عهدتك لا تتوقى الهجير ، %~% ولا ترهب الأشيب الأشنبا(@)(@@) 5 ولكن لقيت صروف الزمان %~% وباشرتها مقنبا مقنبا(@)(@@) 6 إذا المرء مرت له أربعون %~% فليس يعنف إن حنبا(@)(@@) 7 وإن يفر خطبا ، فأهل له ، %~% وإلا ، فكم من حسام نبا(@)(@@) 8 ولا عقل للدهر فيما أرى ، %~% فكيف يعاتب إن أذنبا ؟(@)(@@) 9 فهلا تراح لأهل الجناب ، %~% إذا الركب ، أفراسه ، جنبا(@)(@@) 10 وكنت إلى وصلهم مائلا %~% تعاصي العذول ، وإن أطنبا(@)PageV01P738(@)(@@) البحر : خفيف تام(@)(@@) 1 زعم الزاعمون ، والقول ، من مي %~% ن وصدق ، يروى ، فعالي وعيفي(@)(@@) 2 إن شقا ، يلوح في باطن البر %~% قسم بيني وبين الضعيف(@)PageV01P739(@)(@@) البحر : متقارب تام(@)(@@) 1 صحبنا الحياة فطال العناء ، %~% ولا خير في العيش مستصحبا(@)(@@) 2 وقد كنت فيما مضى جامحا %~% ومن راضه دهره أصحبا(@)(@@) 3 متى ما شحبت لوجه المليك %~% كسيت جمالا بأن تشحبا(@)(@@) 4 حبا الشيخ لا طامعا في النهو %~% نقيض الصبي ، إذا ما حبا(@)(@@) 5 ولم يحبني أحد نعمة ؛ %~% ولكن مولى الموالي حبا(@)(@@) 6 نصحتك فاعمل له دائما %~% وإ ، جاء موت فقل : مرحبا(@)PageV01P740(@)(@@) البحر : خفيف تام(@)(@@) 1 الليالي مغيرات السجايا ، %~% كم جعلن الذيفان شرب عيوف(@)(@@) 2 قد غدا القوم للنضار فنالوه %~% وبتنا ومن لنا بالزيوف(@)(@@) 3 أولا يبصر الفتى الذهب الأح %~% مر ، تحذى به نعال 
ms166	 السيوف ؟(@)(@@) 4 للحديد العلا على سائر الجو %~% ذل العدى وعز الضيوف(@)PageV01P741(@)(@@) البحر : متقارب تام(@)(@@) 1 يؤدبك الدهر بالحادثات ، %~% إذا كان شيخاك ما أدبا(@)(@@) 2 بدت فتن مثل سود الغمام ، %~% ألقت على العالم الهيدبا(@)(@@) 3 ومن دونها اختلفت غالب %~% وأبعد عثمانها جندبا(@)(@@) 4 فلا تضحكن ابنة السنبسي %~% فأوجب من ذاك أن تندبا(@)(@@) 5 إذا عامر تبعت صالحا ، %~% وزجت بنو قرة الحردبا(@)(@@) 6 وأردف حسان في مائح ، %~% متى هبطوا مخصبا أجدبا(@)(@@) 7 وإن فرعوا جبلا شامخا ، %~% فليس يعنف إن يحدبا(@)(@@) 8 رأيت نظير الدبا كثرة %~% قتيرهم كعيون الدبا(@)PageV01P742(@)(@@) البحر : متقارب تام(@)(@@) 1 أيا والي المصر لا تظلمن ، %~% فكم جاء مثلك ثم انصرف(@)(@@) 2 وقد أبر النخل ملاكه %~% وقيض غيرهم فاخترف(@)(@@) 3 إن القول حرفه كاذب ، %~% فإن القضاء به ما انحرف(@)(@@) 4 فلا ترسلن حبال الرجا ، %~% وأمسك بكفك منها طرف(@)(@@) 5 تواضع إذا ما رزقت العلى %~% فذلك مما يزيد الشرف(@)(@@) 6 ودارك أحسن إلى جارها ، %~% ولا تجعلن لها مشترف(@)(@@) 7 وإن ألبس الله ثوب الشفاء %~% فلا تؤثرن عليه الترف(@)(@@) 8 تغيض المياه ، وقد طالما %~% تيممها وارد ، فاغترف(@)(@@) 9 ومن أمنته خطوب المنون ، %~% تخوف من هرم أو خرف(@)(@@) 10 يقارف مستكبرات الذنوب ، %~% ويغفل عن ذنبه المقترف PageV01P743(@)(@@) 11 ولي منزل ، في الثرى ، ما يزار ، %~% ولو رامه زائر ما عرف(@)(@@) 12 وقد لمت أن جمدت أدمعي %~% وما لمت جفني لما ذرف(@)PageV01P744(@)(@@) البحر : طويل(@)(@@) 1 بني آدم بئس المعاشر أنتم ، %~% وما فيكم واف لمقت ، ولا حب(@)(@@) 2 وجدتكم لا تقربون إلى العلى %~% كما أنكم لا تبعدون عن السب(@)(@@) 3 ولم تكفكم أكباد شاء وجامل ، %~% ووحش إلى أن رمتم كبد الضب(@)(@@) 4 فإن كان ما بين البهائم قاضيا %~% فهذا قضاء جاء من قبل الرب(@)(@@) 5 ركبتم سفين البحر من فرط رغبة %~% فما للمطايا والمطهمة القب(@)(@@) 6 وكلكم يبدي لدنياه بغضة %~% على أنه يخفي بها كمد الصب(@)(@@) 7 إذا جولس الأقوام بالحق أصبحوا ، %~% عداة ، فكل الأصفياء على خب(@)(@@) 8 نشاهد بيضا من رجال كأنهم %~% غرابيب طير ساقطات على حب 
ms167	(@)(@@) 9 إذا طلبوا فاقنع لتظفر بالغنى ، %~% وإن نطقوا ، فاصمت لترجع باللب(@)(@@) 10 وإن لم تطق هجران رهطك دائما ، %~% فمن أدب النفس الزيارة عن غب PageV01P745(@)(@@) 11 ويدعو الطبيب المرء ، وافاه حينه ؛ %~% رويدك إن الأمر جل عن الطب(@)PageV01P746(@)(@@) البحر : متقارب تام(@)(@@) 1 وجدت ابن آدم في غرة ، %~% بما يستفيد وما يطرف(@)(@@) 2 تعلق دنياه قبل الفطام ، %~% وما زال يدأب حتى خرف(@)(@@) 3 وتسمو لطارفها عينه ، %~% وخير لناظرها لو طرف(@)(@@) 4 يسر عصر إقبالها %~% كأن تغيرها ما عرف(@)(@@) 5 ويذرف من حبها دمعة %~% وما يجلب الحظ دمع ذرف(@)(@@) 6 وكم مر ، يوما ، على قبره ، %~% حسان الوجوه ، فلم تشترف(@)(@@) 7 أيلتمس الماء من ناكز ، %~% ويترك جما لمن يغترف ؟(@)(@@) 8 ولم يقترب من رضا ربه %~% ولكن جرائمه يقترف(@)(@@) 9 كعامل يوم أساء الصنيع %~% ولا ريب في أنه ينصرف(@)(@@) 10 وقد جاء ، غافلنا ، رزقه ، %~% وإن كان للقوت لم يحترف PageV01P747(@)(@@) 11 أيا ظبية القاع خافي الرماة %~% ولا يخدعنك روض يرف(@)PageV01P748(@)(@@) البحر : طويل(@)(@@) 1 أرى اللب مرآة الليبب ، ومن يكن %~% مرائيه الإخوان يصدق ويكذب(@)(@@) 2 أأخشى عذاب الله ، والله عادل %~% وقد عشت عيش المستضام المعذب(@)(@@) 3 نعم إنها الأرزاق ، والمرء جاهل %~% يهذب ، من دنياه ، ما لم يهذب(@)(@@) 4 فإن حبال الشمس لسن ثوابتا ، %~% لشد رحال ، أو قوابض جذب(@)PageV01P749(@)(@@) البحر : طويل(@)(@@) 1 لك الملك ، إن تنعم فذاك تفضل %~% علي ، وإن عاقبتني ، فبواجب(@)(@@) 2 يوما لفتى من قبره إن دعوته %~% وما جر مخطوط له في الرواجب(@)(@@) 3 عصا النسك أحمى ، ثم ، من رمح عامر %~% وأشرف عند الفجر من قوس حاجب(@)PageV01P750(@)(@@) البحر : طويل(@)(@@) 1 وجوهكم كلف ، وأفواهكم عدى ، %~% وأكبادكم سود ، وأعينكم زرق(@)(@@) 2 وما بي طرق للمسير ولا السرى %~% لأني ضرير لا تضيء لي الطرق(@)(@@) 3 أغربانك السحم استقلت مع الضحى %~% سوانح ، أم مرت حمائمك الورق(@)(@@) 4 رحلت ، فلا دنيا ولا دين نلته ، %~% وما أوبتي إلا السفاهة والخرق(@)(@@) 5 متى يخلص التقوى لمولاه لا تغض %~% عطاياه من صلى وقبلته الشرق(@)(@@) 6 أرى حيوان الأرض يرهب حتفه ، %~% ويفزعه رعد ، ويطمعه برق(@)(@@) 7 
ms168	 فيا طائر أثمني ، ويا ظبي لا تخف %~% شذاتي ، فما بيني وبينكما فرق(@)PageV01P751(@)(@@) البحر : طويل(@)(@@) 1 عصا في يد الأعمى ، يروم بها الهدى ، %~% أبر له من كل خدن وصاحب(@)(@@) 2 فأوسع بني حواء هجرا ، فإنهم %~% يسيرون في نهج من الغدر لاحب(@)(@@) 3 وإن غير الإثم الوجوه ، فما ترى %~% لدى الحشر إلا كل أسود شاحب(@)(@@) 4 إذا ما أشار العقل بالرشد ، جرهم %~% إلى الغي طبع أخذه أخذ ساحب(@)PageV01P752(@)(@@) البحر : طويل(@)(@@) 1 لعمرك ! ما في الأرض كهل مجرب ، %~% ولا ناشىء إلا لإثم مراهق(@)(@@) 2 إذا بض بالشيء القليل فإنه %~% لسوء السجايا ، بالتبجح فاهق(@)(@@) 3 ولو كان من هذي الشواهق سيد %~% ثنته المنايا ، وهو بالنفس شاهق(@)(@@) 4 وكم من جواد شهدت له %~% نواهقه والشاحجات النواهق(@)PageV01P753(@)(@@) البحر : طويل(@)(@@) 1 متى ينفع الأقوام حي يكن له %~% أذاة بهم ، والحين بالنفس لاحق(@)(@@) 2 فما تسحق ، المرو ، الأكف ، ولا الحصى %~% ولكن يغادي إثمد العين ساحق(@)(@@) 3 فإن بورك الخير الذي أنت صانع ، %~% فأهل ، وإلا فالخطوب مواحق(@)PageV01P754(@)(@@) البحر : طويل(@)(@@) 1 لو اتبعوني ويحهم لهديتهم %~% إلى الحق ، أو نهج لذاك مقارب(@)(@@) 2 فقد عشت حتى ملني ، ومللته ، %~% زماني ، وناجتني غيوب التجارب(@)(@@) 3 إذا حان وقتي ، فالمثقف طاعني ، %~% بغير معين ، والمهند ضاربي(@)(@@) 4 وإنا من الغبراء فوق مطية %~% مذللة ، ما أمكنت يد خارب(@)(@@) 5 فمن لي بأرض رحبة ، لا يحلها %~% سواي ، تضاهي دارة المتقارب(@)(@@) 6 فما للفتى إلا انفراد ووحدة %~% إذا هو لم يرزق بلوغ المآرب(@)(@@) 7 فحارب وسالم ، إن أردت ، فإنما %~% أخو السلم في الأيام مثل المحارب(@)PageV01P755(@)(@@) البحر : طويل(@)(@@) 1 أرى الناس شرا من زمان حواهم ؛ %~% فهل وجدت للعالمين حقائق ؟(@)(@@) 2 وقد كذبوا عن ساعة ودقيقة ، %~% وما كذبت ساعاتهم والدقائق(@)(@@) 3 إذا لم يكن لي في الشقيقة منزل %~% فلا طهرت عزاؤها والشقائق(@)PageV01P756(@)(@@) البحر : -(@)(@@) 1 يقولون صنع من كواكب سبعة ؛ %~% وما هو إلا من زعيم الكواكب(@)(@@) 2 إذا رفعت تلك المواكب قسطلا %~% فرافعه للعين مجرى المواكب(@)(@@) 3 أترجع نفس الميت بعد رحيله %~% فيجزي قوما بالدموع السواكب(@)(@@) 4 تبدل أعناق الرجال وأيديا 
ms169	 %~% تناقله من عسجدي المراكب(@)(@@) 5 أحب إليه كونه متواطأ %~% بأقدامهم ، لا الحمل فوق المناكب(@)(@@) 6 هو الموت ، مثر عنده مثل مقتر ، %~% وقاصد نهج مثل آخر ناكب(@)(@@) 7 ودرع الفتى ، في حكمه ، درع غادة ، %~% وأبيات كسرى من بيوت العناكب(@)(@@) 8 فرجل في غبراء والخطب فارس %~% وما زال ، في الأهلين ، أشرف راكب(@)(@@) 9 وما النعش إلا كالسفينة راميا %~% بغرقاه ، في موج الردى المتراكب(@)PageV01P757(@)(@@) البحر : طويل(@)(@@) 1 أراني في قيد الحياة مكلفا %~% ثقائل أمشي تحتها وأطابق(@)(@@) 2 إذا كنت في دار الشقاء مصليا %~% فإنك في دار السعادة سابق(@)(@@) 3 إذا الحر لم ينهض بفرض صلاته %~% فذلك عبد من يد الدين آبق(@)(@@) 4 تقي يعاني ظمأه ، ومضلل %~% له صابح من غير حل وغابق(@)PageV01P758(@)(@@) البحر : طويل(@)(@@) 1 أجل هبات الدهر ترك المواهب ، %~% يمد ، لما أعطاك ، راحة ناهب(@)(@@) 2 وأفضل من عيش الغنى عيش فاقة ، %~% ومن زي ملك رائق زي راهب(@)(@@) 3 وما خلته إلا سيبعث حادثا %~% يحل الثريا عن جبين الغياهب(@)(@@) 4 جلا فرقديه قبل نوح وآدم %~% إلى اليوم ، لما يدعيا في القراهب(@)(@@) 5 ولي مذهب في هجري الإنس نافع ، %~% إذا القوم خاضوا في اختيار المذاهب(@)(@@) 6 أرانا على الساعات فرسان غارة %~% وهن بنا يجرين جري السلاهب(@)(@@) 7 ومما يزيد العيش إخلاق ملبس %~% تأسف نفس ، لم تطق رد ذاهب(@)PageV01P759(@)(@@) البحر : طويل(@)(@@) 1 فؤادك خفاق وبرقك خافق %~% وأعياك في الدنيا خليل موافق(@)(@@) 2 تخير فإما وحدة مثل ميتة ، %~% وإما جليس في الحياة منافق(@)(@@) 3 أردت رفيقا كي ينالك رفقه ، %~% فدعه إذا لم تأت منه المرافق(@)PageV01P760(@)(@@) البحر : طويل(@)(@@) 1 إذا عبت ، عندي ، غيري اليوم ظالما ، %~% فأنت بظلم عند غيري عائبي(@)(@@) 2 عرفتك فاعلم : إن ذممت خلائقي %~% ورابك بعضي ، أن كلك رائبي(@)(@@) 3 فأين الذي في الترب يدفن شخصه ، %~% وأسراره مدفونة في الترائب(@)(@@) 4 يظل نبيه غائبا مثل شاهد %~% وخامل قوم شاهدا مثل غائب(@)(@@) 5 وقد يورث المال البعيد مضلل %~% من الناس ، يأبى وضعه في القوائب(@)(@@) 6 وإن بني حواء زور عن الهدى ، %~% ولو ضربوا بالسيف ضرب الغرائب 
ms170	(@)(@@) 7 ومن حب دنياهم رموا في وغاهم %~% بغيض المنايا بالنفوس الحبائب(@)(@@) 8 وكم غوروا ، في مورد وتظمؤ ، %~% عيون ركي ، أو عيون ركائب(@)(@@) 9 وأسروا على الخيل العتاق ، وأصمتوا %~% نواطقها ، إلا تحمحم هائب(@)(@@) 10 وشد لسان الطرف ، خوف صهيله ، %~% فقد ألجموا أفواهها بالسبائب PageV01P761(@)(@@) 11 وغرهم صبح الوجوه ، وفوقه %~% جوامد ليل ، سميت بالذوائب(@)(@@) 12 غرائز في شيب ومرد ، بمشرق %~% وغرب ، جرت مجرى الصبا والجنائب(@)(@@) 13 أرادت لها خضر المضارب والظبى %~% جلاء ، فلم تبيض سود الضرائب(@)(@@) 14 يقول الفتى : أخلصت غيا ولم أرح ، %~% وشائب فودي بالتورع شائبي(@)PageV01P762(@)(@@) البحر : طويل(@)(@@) 1 توخ بهجر أم ليلى ، فإنها %~% عجوز ، أضلت حي طسم ومارب(@)(@@) 2 دبيب نمال عن عقار ، تخالها %~% بجسمك ، شر من دبيب العقارب(@)(@@) 3 ولو أنها كالماء طلق لأوجبت ، %~% قلاها ، أصيلات النهى والتجارب(@)(@@) 4 تحيي وجوه الشرب فعل مسالم %~% يضاحكه ، والكيد كيد محارب(@)(@@) 5 إذا قتلت ، خاف الرشاد جناية ، %~% فكان من الفتيان أول هارب(@)(@@) 6 عدوة لب سلت السيف ، واعتلت %~% به القوم ، إلا أنها لم تضارب(@)(@@) 7 وما شامت الهندي في الكف عنوة ؛ %~% ولكن ثنته في أنامل ضارب(@)(@@) 8 فلو كان سرح العقل أذواد عامر %~% رمت كل ذود من سفاه بخارب(@)(@@) 9 فما أبعدت إلا أجل مقارن ؛ %~% ولا بلغت إلا خسيس المآرب(@)(@@) 10 تعري الفتى من ثوبه وهو غافل ، %~% وتوقع حرب الدهر بين الأقارب PageV01P763(@)(@@) 11 تألى الحجى ، واستشهد السكر أنها %~% ذميمة غب ، لا تحل لشارب(@)PageV01P764(@)(@@) البحر : طويل(@)(@@) 1 أرقت ، فهل نجم الدجنة آرق %~% وتجري الغوادي ، بالردى ، والطوارق(@)(@@) 2 ويطربني ، بعد النهى ، قول قائل : %~% سقى بارقا من جانب الغور بارق(@)(@@) 3 أبى الدهر جودا بالسرور ، فإن دنا %~% إليه الفتى ، أو ناله ، فهو سارق(@)(@@) 4 هل اليوم إلا شارق ثم غارب ، %~% أو الليل إلا غارب ثم شارق ؟(@)(@@) 5 مزارب كسرى ما وقت مهجة له ، %~% وقيصر لم يمنع رداه البطارق(@)(@@) 6 ويغبر في الأيام ، من طال عمره ، %~% فتغبر ، من طول البقاء ، المفارق(@)(@@) 7 محا ألفات الشرخ عن طرس شيبه ، %~% لتخلو من لون الشباب المهارق(@)(@@) 8 وما زال ، في 
ms171	 شرب الأباريق ، كارها %~% لما بعثته في الرياح الأبارق(@)(@@) 9 يعافون تربا فيه تطوى جسومهم ، %~% ومنه بحق فرشها والنمارق(@)(@@) 10 ويشبه كعبا إذا بكى ، ومتمما ، %~% لدى كل عقل معبد ومخارق PageV01P765(@)(@@) 11 نظير ابنة الجون التي النوح شأنها %~% مغنية ، عن صوتها ، اللب مارق(@)PageV01P766(@)(@@) البحر : طويل(@)(@@) 1 تناهبت ، العيش ، النفوس ، بغرة ، %~% فإن كنت تسطبع النهاب فناهب(@)(@@) 2 بقائي في الدنيا ، علي ، رزية ، %~% وهل أنا إلا غابر نثل ذاهب ؟(@)(@@) 3 إذا خلق الانسان ظل حمامه ، %~% وإن نال يسرا ، من أجل المواهب(@)(@@) 4 تقادم عمر الدهر ، حتى كأنما %~% نجوم الليالي شيب هذي الغياهب(@)(@@) 5 يهود باغي الحاج ، والليل مسلم ، %~% على كفره ، والأرض في زي راهب(@)(@@) 6 تألف غي الناس شرقا ومغربا %~% تكامل فيهم ، باختلاف المذاهب(@)(@@) 7 وإن قطوف الساع فيما علمته %~% أحث مرورا من وساع السلاهب(@)PageV01P767(@)(@@) البحر : طويل(@)(@@) 1 أيعلم نجم طارق برزية ، %~% من الدهر ، أم لا هم للإنس طارقه ؟(@)(@@) 2 وهل فرقد الخضراء ، في الجو ، موقن %~% بأن أخاه ، بعد حين ، مفارقه ؟(@)(@@) 3 وما أرقته الحادثات ، وكلنا %~% إذا ناب خطب ، ساهر الليل ، آرقه(@)(@@) 4 لقد مر حرس ، بعد حرس ، جميعه ، %~% حنادس لم يذرر ، مع الصبح ، شارقه(@)(@@) 5 تغيرت الأشياء والملك ثابت %~% مغاربه موفورة ومشارقه(@)(@@) 6 مراد جرت أقلامه فتبادرت %~% بأمر ، وجفت بالقضاء مهارقه(@)(@@) 7 وهل أفلت الأيام كسرى وحوله %~% مرازبه ، أو قيصر وبطارقه ؟(@)(@@) 8 أبارق هذا المزن سبح ربه %~% نعم ! وأعانت أكمه وأبارقه(@)(@@) 9 ودنياك ليست للسرور معدة ، %~% فمن ناله من أهلها فهو سارقه(@)(@@) 10 وقد عشت حتى لو ترى العيش لاح لي %~% هباء ، كنسج العنكبوت شبارقه PageV01P768(@)(@@) 11 فخف دعوة المظلوم ، إن دعاءه %~% ملم بنوري الحجاب وخارقه(@)(@@) 12 يخادع ملك الأرض ، حتى إذا أتت %~% منيته ، لم تغن عنه مخارقه(@)PageV01P769(@)(@@) البحر : طويل(@)(@@) 1 متى عدد الأقوام لبا وفطنة %~% فلا تسأليني عنهما وسليبي(@)(@@) 2 أرى عالما يرجون عفوا مليكهم ، %~% بتقبيل ركن ، واتخاذ صليب(@)(@@) 3 فغفرانك اللهم هل أنا طارح %~% بمكة في وفد ثياب سليب(@)(@@) 4 وهلأراد الغدران بين صحابة %~% يمانين ، لم يبغوا احتفار قليب(@)(@@) 5 أفارقهم ، ما 
ms172	 العرض مني عندهم %~% ثليبا ، ولا عرض لهم بثليب(@)(@@) 6 ولست بلاح من أراح سوامه %~% إذا لم يجئني ، موهنا ، بحليب(@)(@@) 7 وهان على سمعي ، إذا القبر ضمني %~% هرير ضباع حوله وكليب(@)(@@) 8 عبيدك جم ، ربنا ، ولك الغنى ، %~% ولم تك معروفا برق جليب(@)PageV01P770(@)(@@) البحر : طويل(@)(@@) 1 طباع الورى فيها النفاق ، فأقصهم %~% وحيدا ، ولا تصحب خليلا تنافقه(@)(@@) 2 وما تحسن الأيام أن ترزق الفتى ، %~% وإن كان ذا حظ ، صديقا يوافقه(@)(@@) 3 يضاحك خل خله وضميره %~% عبوس ، وضاع الود لولا مرافقه(@)PageV01P771(@)(@@) البحر : طويل(@)(@@) 1 وجدت عوادي الحياة كثيرة %~% كأن بقاء المرء شعر حبيب(@)(@@) 2 وتلقاه ، من فرط الصبابة ، جاهلا ، %~% يغر أعلى رأسه بصبيب(@)(@@) 3 وما كرهت خيل تخال ، وأينق %~% بياضا بدا في غرة وسبيب(@)(@@) 4 فإن طريق الناس في الحتف واحد %~% أكنت طبيبا أم نقيض طبيب(@)PageV01P772(@)(@@) البحر : طويل(@)(@@) 1 يسيء امرؤ يوما فيبغض دائما %~% ودنياك ما زالت تسيء وتومق(@)(@@) 2 أسر هواها الشيخ والكهل والفتى ، %~% بجهل ، فمن كل النواظر ترمق(@)(@@) 3 وما هي أهل أن يؤهل مثلها %~% لود ، ولكن ابن آدم أحمق(@)PageV01P773(@)(@@) البحر : طويل(@)(@@) 1 إذا غيبوني لم أبال متى هفا %~% نسيم شمال ، أو نسيم جنوب(@)(@@) 2 تنوب الرزايا أعظمي ، لا أصونها %~% بمتخذ من عرعر وتنوب(@)(@@) 3 فهل عاينوا ، في مضجعي لجرائمي %~% كتائب من زنج تروع ، ونوب(@)(@@) 4 وهل يجعل الأرض التي ابيض لونها %~% كلون الحرار الحمس ، لون ذنوب(@)(@@) 5 يقول الثرى كم رم تحتي للورى %~% وسائد هام أو مهود جنوب(@)(@@) 6 وإني ، وإن لم آت خيرا أعده ، %~% لآمل إرواء بخير ذنوب(@)PageV01P774(@)(@@) البحر : بسيط تام(@)(@@) 1 خير لآدم والخلق الذي خرجوا %~% من ظهره أن يكونوا قبل ما خلقوا(@)(@@) 2 فهل أحس ، وبالي جسمه رمم ، %~% بما رآه بنوه من أذى ، ولقوا ؟(@)(@@) 3 وما تريد بدار لست مالكها ، %~% تقيم فيها قليلا ثم تنطلق(@)(@@) 4 فارقتها ، غير محمود ، على سخط ، %~% وفي ضميرك ، من وجد بها ، علق(@)(@@) 5 تبوأ الشخص من غبراء مظلمة %~% قرارة ، بعدما أزرى به القلق(@)(@@) 6 تكون للروح ثوبا ثم يخلعه ، %~% والثوب ينهج حتى الدرع 
ms173	 والحلق(@)(@@) 7 وأخلقته الليالي في تجددها %~% والغدر منهن في إخلاقه خلق(@)(@@) 8 والناس شتى فيعطى المقت صادقهم %~% عن الأمور ، ويحبى الكاذب الملق(@)(@@) 9 يغدو إلى المين من قلت دراهمه %~% فيجمع المال ما يفري ويختلق(@)(@@) 10 وربما عذل الإنسان مهجته %~% في الصدق حتى يرى جد الذي يلق PageV01P775(@)(@@) 11 ويخلف الظن ، في الأشياء ، صاحبه ، %~% والغيم يكدى وداعي البرق يأتلق(@)PageV01P776(@)(@@) البحر : طويل(@)(@@) 1 وجدتك أعطيت الشجاعة حقها %~% غداة لقيت الموت غير هيوب(@)(@@) 2 إذا قرن الظن المصيب من الفتى %~% بتجربة جاءا بعلم غيوب(@)(@@) 3 وإن جيوب السرد من سبل الردى %~% إذا لم يكن من تحت نصح جيوب(@)PageV01P777(@)(@@) البحر : بسيط تام(@)(@@) 1 سلطانك النار إن يعدل فنافعة %~% وإن يجر فلها ضير وإحراق(@)(@@) 2 وقربه اللج ، إن أعطاك فائدة ، %~% فليس يؤمن إهلاك وإغراق(@)(@@) 3 والمال رزق فمن يدركه يحظ به %~% وليس يغنيك إشآم وإعراق(@)(@@) 4 والحق كالشمس ، وارتها حنادسها ، %~% فما لها ، في عيون الناس ، إشراق(@)PageV01P778(@)(@@) البحر : طويل(@)(@@) 1 إذا سكت الإنسان قلت خصومه ، %~% وإن أضجعته الحادثات لجنبه(@)(@@) 2 حسا طامر ، في صمته ، من دم الفتى ، %~% فصغر ذاك الصمت معظن ذنبه(@)(@@) 3 ولم يك في حال البعوض ، إذا شدا ، %~% له نغم عال ، وأنت أذ به(@)(@@) 4 وإن سل سيفا ، من كلام ، مسفه ، %~% عليك ، فقابله بصبرك تنبه(@)PageV01P779(@)(@@) البحر : بسيط تام(@)(@@) 1 يغنيك ما حل في السجايا ، %~% أن يتعدى بك الفسوق(@)(@@) 2 كيف يطيق النهوض غاد %~% عليه ، من مأثم ، وسوق ؟(@)(@@) 3 كم غرست نخلة بأرض ، %~% فلم يقدر لها بسوق(@)(@@) 4 لا يفرحن ، بالحياة ، غر ، %~% فإنها مهلكا تسوق(@)(@@) 5 ما نفق الصدق في البرايا %~% ولم تزل للمحال سوق(@)PageV01P780(@)(@@) البحر : بسيط تام(@)(@@) 1 لقد ترفع فوق المشتري زحل %~% فأصبح الشر فينا ظاهر الغلب(@)(@@) 2 وإن كيوان والمريخ ، ما بقيا ، %~% لا يخليانك من فجع ومن سلب(@)(@@) 3 وكم طلبت أمورا لست مدركها ، %~% تبارك الله ، من أغراك بالطلب(@)(@@) 4 أما رأيت رجالا ، بعد شربهم ، %~% في النضر ، يرضون أن يسقوا من العلب(@)(@@) 5 وما أمنت زماني ، في تصرفه ، %~% أن ينقل الملك من مصر 
ms174	 إلى حلب(@)PageV01P781(@)(@@) البحر : بسيط تام(@)(@@) 1 الدهر ينسخ أولاه أواخره ، %~% فلا يطيلن بهذا اللوم إنصابي(@)(@@) 2 داء الحياة قديم ، لادواء له ، %~% لم يخل بقراط من سقم وأوصاب(@)(@@) 3 تلك اليهود فهل من هائد لهم ، %~% والصابئون ، وكل جاهل صابي(@)(@@) 4 والإنس ما بين إكثار إلى عدم %~% كالوحش ما بين إمحال وإخضاب(@)(@@) 5 لم يثبتوا بقياس أصل دينهم ، %~% فيحكموا بين رفاض ونصاب(@)(@@) 6 ما الركن في قول ناس ، لست أذكرهم ، %~% أذكرهم إلا بقية أوثان وأنصاب(@)(@@) 7 لا أستقيل زماني عثرة أبدا %~% ما شاء فليات إن الشهد كالصاب(@)PageV01P782(@)(@@) البحر : كامل تام(@)(@@) 1 فرق بدا ، ومن الحوادث يفرق %~% شبح يغادى بالخطوب ويطرق(@)(@@) 2 سبحان خالقنا ، وطاء أغبر %~% من تحتنا ، وله غطاء أزرق(@)(@@) 3 والشهب ، في بحر السماء ، سوابح ، %~% تطفو لناظرة العيون ، وتغرق(@)(@@) 4 أعرقت خيلك في محاولة الغنى ، %~% وحواه غيرك مشئم أو معرق(@)(@@) 5 وأخو الحجى ، في أمره ، متحير ، %~% جمع التجارب عمره المتفرق(@)(@@) 6 وتعهد ابن العبد برقة ثهمد %~% فمضى وشيكا ، واستقر الأبرق(@)(@@) 7 عز الذي أعفى الجماد فما ترى %~% حجرا يغص بمأكل ، أو يشرق(@)(@@) 8 متعريا في قيظه وشتائه %~% ما ريع ، قط ، لملبس يتخرق(@)(@@) 9 متجلدا ، أو خلته متبلدا ، %~% لا دمع فيه لفادح يترقرق(@)(@@) 10 لا حس يؤلمه فيظهر مجزعا %~% إن راح يضرب ملطس أو مطرق PageV01P783(@)(@@) 11 لم يغد غدوة طائر متكسب ، %~% وافاه يلقط أجدل أو زرق(@)(@@) 12 أحمام ما لك في ركوب حمائم %~% ورق ، ومن شر الركاب الأورق ؟(@)(@@) 13 والصخر يلبث لا يقارف مرة %~% ذنبا ، ولا هو ، من حياء ، مطرق(@)(@@) 14 والدهر أخرق ، ما اهتدى لصنيعة ، %~% وبنوه كلهم سفيه أخرق(@)(@@) 15 وتشابهت أجسامنا ، وتخالفت %~% أغراضنا ، فمغرب ومشرق(@)(@@) 16 يا هم ! ويحك غيرتك نوائب ؛ %~% والغصن يورق ، في الزمان ، ويورق(@)(@@) 17 ملأت صحيفتك الذنوب ، وفعلك %~% الحبر الأحم ، وفود رأسك مهرق(@)(@@) 18 وكأنما نفض الرماد كآبة %~% فوق الجبين ، وقلبك المتحرق(@)(@@) 19 لص الكرى ملك الردى ، في زعمهم ؛ %~% إن الحياة ، من الأنام ، لتسرق(@)(@@) 20 من يعط شيئا يستلبه ، ومن ينم %~% جنح الظلام ، فإنه سيؤرق PageV01P784(@)(@@) 21 زجر 
ms175	 الغراب تطيرا ونقيضه %~% ديك لأهل الدار أبيض أفرق(@)(@@) 22 هذا السفاه كأننا حمضية %~% أو خيط بلقعة غذاه العشرق(@)PageV01P785(@)(@@) البحر : بسيط تام(@)(@@) 1 إذا رأيتم كريما عند غيركم %~% فاكرموه على يسر وإنضاب(@)(@@) 2 فالسيف تعرف ذات الخدر موضعه %~% من قومها ، وهي لم تضرب بقرضاب(@)(@@) 3 والشر ينشر ، بعد الخير ، ميته ، %~% كما أصاب عميرا مت جنى ضابي(@)PageV01P786(@)(@@) البحر : كامل تام(@)(@@) 1 الدهر يزبق من حواه ، كأنهم %~% شعر يغير فهو أحمق أزبق(@)(@@) 2 والبهم يربق ، والأنام بهائم %~% أبدا تقيد ، بالقضاء ، وتربق(@)(@@) 3 فلك يدور على معاشر جمة ، %~% وكأنه سجن عليهم مطبق(@)(@@) 4 في كل حين يستهل ، من الأذى ، %~% مطر ، يخص أماكنا ، ويطبق(@)(@@) 5 مهج تهارش في الخسيس ، وإن غدت %~% كالنابحات ، فكل طعم خربق(@)(@@) 6 لا تفرحن بما بلغت من العلا ، %~% وإذا سبقت فعن قليل تسبق(@)(@@) 7 وليحذر الدعوى اللبيب فإنها %~% للفضل ، مهلكة ، وخطب موبق(@)(@@) 8 لو قال بدر التم : إني درهم ؛ %~% قالت له السفهاء أنت مزأبق(@)(@@) 9 إياك والدنيا فإن لباسها %~% يبلي الجسوم ، وطيبها لا يعبق(@)(@@) 10 ولها هموم ، بالنفوس لوابق ، %~% وسرورها بصدورنا لا يلبق PageV01P787(@)(@@) 11 والله خالقنا لأمر شاءه ، %~% أبق العبيد ، وعبده لا يأبق(@)PageV01P788(@)(@@) البحر : بسيط تام(@)(@@) 1 يأتي الردى ويواري إثلب جسدا %~% فافعل جميلا ، وجانب كل ثلاب(@)(@@) 2 والناس كالخيل ، ما هجن بمعطية ، %~% في مريها ، كعطايا آل حلاب(@)(@@) 3 فاسمع كلامي ، وحاول أن تعيش به ، %~% فسوف أعوز بعد اليوم طلابي(@)(@@) 4 إستغفر الله ، واترك ما حكاه لهم %~% أبو الهذيل ، وما قال ابن كلاب(@)(@@) 5 فالدين قد خس ، حتى صار أشرفه %~% بازا لبازين أو كلبا لكلاب(@)(@@) 6 والظلم عندي قبيح لا أجوزه ، %~% ولو أطعت لما فاؤوا بأجلاب(@)(@@) 7 إن السواد لجنس ، خيره زمر ، %~% فقس بني آدم منه على االلاب(@)(@@) 8 لا تنبت الحرة المرعى ، ولو سقيت %~% بعارض لمياه البحر حلاب(@)(@@) 9 لا يكتسون قميصا في ديارهم %~% كالأرض لم تكس من نبت بأسلاب(@)(@@) 10 دهري قتاد ، وحالي ضالة ضؤلت %~% عما أريد ولوني لون لبلاب PageV01P789(@)(@@) 11 وإن شكرت فشكري شكر بروقة %~% ترضى ببرق ، من 
ms176	 الأمطار ، خلاب(@)(@@) 12 فدار خصمك إن حق أنار له %~% ولا تنازع بتمويه وإجلاب(@)(@@) 13 وحب دنياك طبع في المقيم بها ، %~% فقد منيت بقرن منه غلاب(@)(@@) 14 لما رأيت سجايا العصر ترخصني ، %~% رددت قدري إلى صبري ، فإغلابي(@)PageV01P790(@)(@@) البحر : كامل تام(@)(@@) 1 الغيب مجهول ، يحار دليله ؛ %~% والب يأمر أهله أن يتقوا(@)(@@) 2 لا تظلموا الموتى ، وإن طال المدى %~% إني أخاف عليكم أن تلتقوا(@)(@@) 3 هذي المهابط والمراتب صورت %~% للعالمين ليهبطوا أو يرتقوا(@)(@@) 4 لا تدعوا عتقا على مولاكم %~% فالرأي أوجب أنكم لم تعتقوا(@)(@@) 5 لم تستطيعوا أن تقوا مجاتكم %~% فتخيروا قبل الندامة وانتقوا(@)(@@) 6 إن مسكم ظمأ فقول نذيركم ، %~% لا ذنب لي ، قد قلت للقوم : استقوا(@)PageV01P791(@)(@@) البحر : بسيط تام(@)(@@) 1 أسوان أنت لأن الحي نيتهم %~% أسوان ، أي عذاب دون عيذاب(@)(@@) 2 والعقل يسعى لنفسي ، في مصالحها %~% فما لطبع إلى الآفات جذاب ؟(@)PageV01P792(@)(@@) البحر : سريع(@)(@@) 1 ما ركب الخائن ، في فعله ، %~% أقبح مما ركب السارق(@)(@@) 2 شتان مأمون وذو خلسة %~% كأنه ، من عجل ، بارق(@)(@@) 3 قد أنست فعلك شهب الدجى %~% ليلا ، وقد أبصرك الشارق(@)(@@) 4 فكيف لم تحرقك شمس الضحى ؛ %~% وكيف لا يرجمك الطارق ؟(@)(@@) 5 هذي طباع الناس معروفة %~% فخالطوا العالم ، أو فارقوا(@)PageV01P793(@)(@@) البحر : بسيط تام(@)(@@) 1 الحظ لي ولأهل الأرض كلهم %~% ألا يراني ، أخرى الدهر ، أصحابي(@)(@@) 2 وشقوة غشيت وجهي بنضرته %~% أبر بي من نعيم جر إشحابي(@)(@@) 3 حابي كثير ، وما نبلي بصائبة %~% وكيف لي في مراميهن بالحابي ؟(@)(@@) 4 قد كنت صعبا ولكن أرهفت غير %~% حتى تبين كل الناس أصحابي(@)(@@) 5 فاحذر من الإنس ، أدناهم وأبعدهم ، %~% وإن لقوك بتبجيل وترحاب(@)PageV01P794(@)(@@) البحر : -(@)(@@) 1 يا ناق صبرا أنت في أينق %~% شطت مراعيها وأيناقها(@)(@@) 2 أغراضها جالت بأغراضها %~% وقد برى الأعناق إعناقها(@)PageV01P795(@)(@@) البحر : بسيط تام(@)(@@) 1 استنبط لعرب لفظا وانبرى نبط %~% يخاطبونك من أفواه أعراب(@)(@@) 2 كلمت باللحن أهل اللحن أنفسهم ، %~% لأن عيبي عند القوم إعرابي(@)(@@) 3 دنياي - لاكنت من أم مخادعة - %~% كم ميسم لك في وجهي وأقرابي(@)(@@) 4 أشربت حبك لا ينفيه عن جسدي %~% سوى 
ms177	 ثرى لدماء الإنس شراب(@)(@@) 5 عند الفراقد أسراري مخبأة ، %~% إذ لست أرضى لآرابي بآرابي(@)(@@) 6 ترائبي ، وهي مغنى السر ، ما علمت %~% به لدي ، فهل نالته أترابي ؟(@)(@@) 7 ضربتني بحسام ، أو بقاطعة %~% من منطق ، وعن الجرحين إضرابي(@)(@@) 8 ما شد ربك أزرا بي ، فينقصني ، %~% من رتبة لي من بالقول أزرى بي(@)(@@) 9 أضعت ما كنت أفنيت الزمان به ، %~% بل جر ما سر أعدائي وحرابي(@)(@@) 10 كقينة الكأس إذ باتت مطربة %~% بين الشروب وليست ذات إطراب PageV01P796(@)(@@) 11 والشر جم ، ومن تسلم له إبل %~% من غارة الجيش يتركها لخرلب(@)(@@) 12 أسرى بي الأمل اللاهي بصاحبه ، %~% حتى ركبت سرايا ، بين أسراب(@)(@@) 13 هربت من بين إخواني لتحسبني %~% في معشر ، من لباس الذام ، هراب(@)(@@) 14 كأنني ، كل حول ، محدث حدثا ، %~% يرى به ، من تولى المصر ، إغرابي(@)(@@) 15 السيف والرمح قد أودى زمانهما ، %~% فهل لكفك في عود ومضراب ؟(@)PageV01P797(@)(@@) البحر : متقارب تام(@)(@@) 1 ألم ير أفعالك ، الشارق ، %~% وكوكب ليلتك الطارق(@)(@@) 2 تخون أمينك ديناره %~% وفي ربعه يقطع السارق(@)PageV01P798(@)(@@) البحر : بسيط تام(@)(@@) 1 انفض ثيابك من ودي ومعرفتي ، %~% فإن شخصي هباء ، في الضحى ، هابي(@)(@@) 2 وقد نبذت على جمر خبا يبسا %~% فإن يكن فيه سقط يذك إلهابي(@)(@@) 3 وقد نصحتك ، فاحذر أن ترى أذنا %~% ترمي إلى السهب إكثاري ، وإسهابي(@)PageV01P799(@)(@@) البحر : بسيط تام(@)(@@) 1 الحمد لله ! ما في الأرض وادعة ، %~% كل البرية في هم وتعذيب(@)(@@) 2 جاء النبي بحق ، كي يهذبكم ؛ %~% فهل أحس لكم طبع بتهذيب ؟(@)(@@) 3 عود يصدق ، أو غر يكذب ، أو %~% مردد بين تصديق وتكذيب(@)(@@) 4 ولو علمتم بداء الذئب من سغب ، %~% إذا لسامحتم بالشاة للذيب(@)PageV01P800(@)(@@) البحر : طويل(@)(@@) 1 لسان الفتى يدعى سنانا ، وتارة %~% حساما ، وكم من لفظة ضربت عنقا(@)(@@) 2 لقد ورد الناس الحياة أمامنا ، %~% فما تركوا إلا الأجونة والرنقا(@)(@@) 3 وأنقى سواد الرأس دهر وغاسل %~% لباسا ، فأما سوء طبع ، فما أنقى(@)PageV01P801(@)(@@) البحر : بسيط تام(@)(@@) 1 لا يحسب الجود من رب النخيل جدا %~% حتى يجود على السود الغرابيب(@)(@@) 2 ما أغدر الإنس ، كم خشف ترببهم %~% فغادروه 
ms178	 أكيلا بعد تربيب(@)(@@) 3 هذي الحياة ، أجاءتنا ، بمعرفة ، %~% إلى الطعام ، وستر بالجلابيب(@)(@@) 4 لو لم تحس لكان الجسم مطرحا ، %~% لذع الهواجر ، أو وقع الشآبيب(@)(@@) 5 فاهجر صديقك ، إن خفت الفساد به ؛ %~% إن الهجاء لمبدوء بتشبيب(@)(@@) 6 طرق النفوس إلى الأخرى مضللة ؛ %~% والرعب فيهن من أجل الرعابيب(@)(@@) 7 ترجو انفساحا ، وكم للماء من جهة ، %~% إذا تخلص من ضيق الأنابيب(@)(@@) 8 أما رأيت صروف الدهر غادية ، %~% على القلوب بتبغيض وتحبيب(@)(@@) 9 عجبت للروم ، لم يهد الزمان لها %~% حتفا ، هداه إلى سابور أو بيب(@)(@@) 10 إن تجعل اللجة الخضراء واقية ، %~% فالملك يحفظ بالخضر اليعابيب PageV01P802(@)(@@) 11 وكل حي ، إذا كانت له أذن ، %~% لم تخله من وشايات وتخبيب(@)PageV01P803(@)(@@) البحر : بسيط تام(@)(@@) 1 إذا قضى الله أمرا جاء مبتدرا %~% وكل ما أنت لاقيه بتسبيب(@)(@@) 2 ظلت ملاحية في الشيء تفعله %~% جهلا ، ملاحية من بعد غربيب(@)(@@) 3 لو لم يضيبوا مداما من غراسهم %~% لجاز أن يمطروها في الشآبيب(@)(@@) 4 ولامترتها ، وخيل القوم جائاة ، %~% أيدي الفوارس من صم الأنابيب(@)PageV01P804(@)(@@) البحر : طويل(@)(@@) 1 يباين شكل غيره ، في حياته ، %~% فإن هلكا لم تلف بينهما فرقا(@)(@@) 2 ومن يفتقد حال الزمان وأهله ، %~% يذم بهم غربا من الأرض أو شرقا(@)(@@) 3 يجد قولهم مينا وودهم قلى %~% وخيرهم شرا ، وصنعتهم خرقا(@)(@@) 4 وبشرهم خدعا وفقرهم غنى %~% وعلمهم جهلا وحكمتهم زرقا(@)(@@) 5 أحي كلاب ! كم رعى النبت قبلكم %~% فريق ، وشاموا ، في حنادسهم ، برقا(@)(@@) 6 وصابوا على عاف ، وآبوا إلى رضى ، %~% وجابوا إلى علياء نازحة خرقا(@)(@@) 7 وليلا طلى قارا بقار وأكمه %~% مراقبة ، من شهبه ، حدقا زرقا(@)(@@) 8 إذا نشأت فيه الغمامة خلتها ، %~% بإيماضها زنجية فصدت عرقا(@)(@@) 9 ومروا بمقصود الحمام فغادروا %~% خوالد ضمت فيه أفرخها الورقا(@)(@@) 10 رأينا شؤون الدهر خفضا ورفعة ، %~% ونحن أسارى ، في الحوادث ، أو غرقى PageV01P805(@)(@@) 11 هوى معتل كالغيث ملمزن ، واعتلى %~% خفيض ، كنقع من لدن حافر يرقى(@)(@@) 12 فلا تأمنوا شامية يمنية %~% تغادي فلا تبقي خباء ولا فرقا(@)(@@) 13 تخرق درع المرء سمر رماحها %~% وإن كان مرا ، في مذاقته ، خرقا(@)(@@) 14 
ms179	 إذا طلبوا أقصى العلى تخذوا له %~% بصم العوالي ، في ترائبكم ، طرقا(@)(@@) 15 إذا كنتم أوراق أثل زهوا لكم %~% جراد نبال ، كي تبيدكم ، ورقا(@)(@@) 16 أطارق هم ضاف ، هل أنت عاذر ، %~% متى لم تجد بي ، عند مرتحل ، طرقا ؟(@)(@@) 17 وأعوزني ماء أزيل به الصدى ، %~% فلا عيش إن لم أشرب الكدر الطرقا(@)(@@) 18 هم الناس أجبال شوامخ في الذرى %~% وأودية لا تبلغ الأكم والبرقا(@)(@@) 19 فسكران يسترقي ويبذل بسلة %~% وآخر صاحي اللب يغضب أن يرقى(@)PageV01P806(@)(@@) البحر : مخلع البسيط(@)(@@) 1 دنياك تكنى بأم دفر %~% لم يكنها الناس أم طبيب(@)(@@) 2 فأذن إلى هاتف مجيد %~% قام على غصنه الرطيب(@)(@@) 3 يكون عند اللبيب منا %~% أبلغ من واعظ خطيب(@)(@@) 4 يحاف ما جادت الليالي %~% إلا بسم لنا قطيب(@)PageV01P807(@)(@@) البحر : طويل(@)(@@) 1 إذا سلقت عرس الفتى في كلامها %~% فما هي إلا سلقة عارضت سلقا(@)(@@) 2 وأحسن أثواب الأوانس بردة %~% من الحسن لا تنضى لغسل ولا تلقى(@)(@@) 3 ويفعل ، فعلا سيئا ، رب منظر %~% جميل ، ويأتي الخير من لم يرق خلقا(@)(@@) 4 وما أم غيلان محرمة الصلى ، %~% ولا أم ليلى ، في محابسها ، طلقا(@)PageV01P808(@)(@@) البحر : وافر تام(@)(@@) 1 قبيح أن يحس نحيب باك ، %~% إذا حان الردى ، فقضيب نحبي(@)(@@) 2 ولم أرد المنية باختياري ، %~% ولكن أوشك الفتيان سحبي(@)(@@) 3 ولو خيرت لم أترك محلي ، %~% وأسكن في مضيق بعد رحب(@)(@@) 4 وجدت الموت ينتظم البرايا ، %~% بشجب منه في أعقاب شجب(@)(@@) 5 فأوصيكم لدنياكم هوانا %~% فإني تابع آثار صحبي(@)PageV01P809(@)(@@) البحر : طويل(@)(@@) 1 عليك بتقوى الله في كل مشهد %~% فلله ما أذكى نسيما وما أبقى(@)(@@) 2 إذا ما ركبت الحزم ، مستبطنا له ، %~% سبقت به من لا تظن له سبقا(@)(@@) 3 وحبي للدنيا كحبك خالص ، %~% وفي عنقينا من هوى جعلت ربقا(@)(@@) 4 حذرنا ، فصادتنا الخلوب كغيرنا ، %~% وأي غراب ما أجادت له طبقا(@)PageV01P810(@)(@@) البحر : طويل(@)(@@) 1 سقينا بفضل الله ، والأرض منزل %~% يحل به من ليس أهلا لأن يسقى(@)(@@) 2 وما طهرت بالعشر خمسة أوسق %~% نفوس أقلت من مآثمها وسقا(@)(@@) 3 وفي كل أرض أمة جعلوا 
ms180	 التقى %~% هي الشيمة الشنعاء ، واستحسنوا الفسقا(@)PageV01P811(@)(@@) البحر : وافر تام(@)(@@) 1 يهاب الناس إيجاف المنايا ، %~% وهل حاد القضاء عن الهيوب ؟(@)(@@) 2 إذا كشفت أجناس البرايا ، %~% وجدت العالمين ذوي عيوب(@)(@@) 3 ذيولهم كثيرات المخازي ، %~% لما فقدوه من نصح الجيوب(@)(@@) 4 تحدثك الظنون بما تلاقي %~% كأن الظن علام الغيوب(@)PageV01P812(@)(@@) البحر : طويل(@)(@@) 1 إذا ما استهل الطفل قال ولاته ، %~% وإن صمتوا : عان الخطوب ورشقها(@)(@@) 2 شقينا بدنيانا ، على طول ودها ، %~% فدونك مارسها حياتك واشقها(@)(@@) 3 ولا تظهرن الزهد فيها ، فكلنا %~% شهيد بأن القلب يضمر عشقها(@)PageV01P813(@)(@@) البحر : بسيط تام(@)(@@) 1 جاء القران ، وأمر الله أرسله ، %~% وكان ستر على الأديان ، فانخرقا(@)(@@) 2 ما أبرم الملك إلا عاد منتقضا %~% ولا تألف إلا شت وافترقا(@)(@@) 3 مذاهب ، جعلوها من معايشهم ، %~% من يعمل الفكر فيها تعطه الأرقا(@)(@@) 4 إحذر سليلك ، فالنار التي خرجت %~% من زندها ، إن أصابت عوده احترقا(@)(@@) 5 وكلنا قوم سوء ، لا أخص به %~% بعض الأنام ، ولكن أجمع الفرقا(@)(@@) 6 لا ترجون أخا منهم ، ولا ولدا ، %~% وإن رأيت حياء أسبغ العرقا(@)(@@) 7 والنفس شر من الأعداء كلهم %~% وإن خلت بك يوما ، فاحترز فرقا(@)(@@) 8 كم سيد ، بارق الجدوى بميسمه ، %~% ساووا به الجدي ، عند الحتف ، والبرقا(@)(@@) 9 إن رمت من شيخ رهط في ديناته %~% دليل عقل على ما قاله خرقا(@)(@@) 10 وكيف أجني ، ولم يورق لهم غصني ؛ %~% والغصن لم يجن حتى ألبس الورقا PageV01P814(@)(@@) 11 عز المهيمن ، كم من راحة بتكت %~% ظلما ، وكان سواها يأخذ السرقا(@)(@@) 12 والدر لاقى المنايا في أكفهم %~% وكم ثوى البحر لا يخشى به غرقا(@)(@@) 13 مين يردد ، لم يرضوا بباطله ، %~% حتى أبانوا ، إلى تصديقه ، طرقا(@)(@@) 14 لا رشد ، فاصمت ، ولا تسألهم رشدا ، %~% فاللب في الإنس ضيف زائر طرقا(@)(@@) 15 وآكل القوت لم يعدم له عنتا %~% وشارب الماء لم يأمن به شرقا(@)(@@) 16 وناظر العين والدنيا به رئيت _ %~% ما إن درى أسوادا حل أو زرقا(@)(@@) 17 إذا كشفت عن الرهبان ، حالهم ، %~% فكلهم يتوخى التبر والورقا(@)PageV01P815(@)(@@) البحر : وافر تام(@)(@@) 1 بني الآداب ! غرتكم ، قديما %~% زخارف 