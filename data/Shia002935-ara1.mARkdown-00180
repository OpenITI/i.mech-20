ms161	 الميم(@)(@@)(@@)(@@) $ 5885 - محمد بن أحمد بن مطهر، بغدادي، يونسي.(@)(@@)(@)(@@)(@@)(@@) $ 5886 - محمد بن علي التستري، من أهل تستر.(@)(@@)(@)(@@)(@@)(@@) $ 5887 - محمد بن عيسى اليقطيني، بغدادي، يونسي.(@)(@@)(@)(@@)(@@)(@@) $ 5888 - محمد بن علي بن بلال، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 5889 - محمد بن أبي الصهبان، قمي، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 5890 - محمد بن بلال، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 5891 - محمد بن علي الكاتب.(@)PageV00P401(@)(@@)(@)(@@)(@@)(@@) $ 5892 - محمد بن الحسين بن أبي الخطاب، كوفي، زيات.(@)(@@)(@)(@@)(@@)(@@) $ 5893 - محمد بن علي القسري.(@)(@@)(@)(@@)(@@)(@@) $ 5894 - محمد بن عبد الحميد العطار، كوفي، مولي بجيلة.(@)(@@)(@)(@@)(@@)(@@) $ 5895 - محمد بن يحيى المعاذي.(@)(@@)(@)(@@)(@@)(@@) $ 5896 - محمد بن يزداد الرازي.(@)(@@)(@)(@@)(@@)(@@) $ 5897 - محمد بن أحمد بن نعيم، أبو عبد الله الشاذاني، نيسابوري.(@)(@@)(@)(@@)(@@)(@@) $ 5898 - محمد بن حفص بن عمرو بن العمري. 1(@)(@@)(@@)(@@) $ 5899 - محمد بن إبراهيم بن مهزيار.(@)(@@)(@)(@@)(@@)(@@) $ 5900 - محمد بن الحسن الصفار، له إليه عليه السلام مسائل، يلقب ممولة.(@)(@@)(@)(@@)(@@)(@@) $ 5901 - محمد بن أحمد بن جعفر القمي، وكيله عليه السلام، أدرك أبا الحسن عليه السلام. 2(@)(@@)(@@)(@@) $ 5902 - محمد بن صالح بن محمد الهمداني، وكيل، الدهقان. 3(@)(@@)(@@)(@@) $ 5903 - محمد بن موسى السريعي، غالي.(@)(@@)(@)(@@)(@@)(@@) $ 5904 - محمد بن نصير، غال.(@)(@@)(@)(@@)(@@)(@@) $ 5905 - محمد بن الحسن بن شمون، غالي، بصري.(@)(@@)(@)(@@)(@@)(@@) $ 5906 - محمد بن يحيى بن زياد.(@)(@@)(@)(@@)(@@)(@@) $ 5907 - محمد بن علي الذراع.(@)(@@)(@)(@@)(@@)(@@) $ 5908 - محمد بن صالح الأرمني.(@)(@@)(@)(@@)(@@)(@@) $ 5909 - محمد بن ربيع بن سويد السائي.(@)(@@)(@)(@@)(@@)(@@) $ 5910 - محمد بن موسى بن فرات.(@)(@@)(@)(@@)(@@)(@@) $ 5911 - محمد بن صالح الخثعمي.(@)PageV00P402(@)(@@)(@@)(@@) || باب الهاء(@)(@@)(@@)(@@) $ 5912 - هارون بن مسلم بن سعدان، الأصل كوفي تحول إلي البصرة، ثم تحول إلي بغداد ومات بها.(@)(@@)(@@)(@@) || باب الياء(@)(@@)(@@)(@@) $ 5913 - يعقوب بن منقوش.(@)(@@)(@)(@@)(@@)(@@) $ 5914 - يوسف بن السخت، أبو يعقوب، بصري.(@)(@@)(@)(@@)(@@)(@@) $ 5915 - يعقوب بن إسحاق البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 5916 - يحيى البصري.(@)(@@)(@@)(@@) || باب الكنى(@)(@@)(@@)(@@) $ 5917 - أبو خلف العجلي، روى عنه علي بن الحسين بن بابويه، عن أبي محمد الحسن بن علي.(@)(@@)(@)(@@)(@@)(@@) $ 5918 - أبو محمد بن علي بن بلال. 1(@)(@@)(@@)(@@) $ 5919 - أبو البختري، مؤدب ولد الحجاج.(@)PageV00P403(@)(@@)(@@)(@@) | باب ذكر أسماء من لم يرو عن واحد من الأئمة عليهم السلام PageV00P405(@)(@@)(@@)(@@) || باب الهمزة(@)(@@)(@@)(@@) $ 5920 - أحمد بن إبراهيم، المعروف بعلان الكليني، خير فاضل، من أهل الري.(@)(@@)(@)(@@)(@@)(@@) $ 5921 - إبراهيم بن 
ms162	 علي الكوفي، راو مصنف زاهد عالم، قطن بسمرقند، وكان نصر بن أحمد صاحب خراسان يكرمه ومن بعده الملوك.(@)(@@)(@)(@@)(@@)(@@) $ 5922 - أحمد بن محمد الدينوري، يكنى أبا العباس، يلقب باستونه.(@)(@@)(@)(@@)(@@)(@@) $ 5923 - أحمد بن علي بن كلثوم، من أهل سرخس، متهم بالغلو.(@)(@@)(@)(@@)(@@)(@@) $ 5924 - آدم بن محمد القلانسي، من أهل بلخ، قيل: إنه كان يقول بالتفويض.(@)(@@)(@)(@@)(@@)(@@) $ 5925 - إبراهيم بن محمد بن العباس الختلي، يروي عن سعد بن عبد الله وغيره من القميين، وعن علي بن الحسن بن فضال، وكان رجلا صالحا.(@)(@@)(@)(@@)(@@)(@@) $ 5926 - أحمد بن عيسى بن جعفر العلوي العمري، ثقة، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5927 - إبراهيم بن مجاهد، وهو ابن أبي ثواب المؤدب.(@)(@@)(@)(@@)(@@)(@@) $ 5928 - أحمد بن يعقوب السنائي، يكنى أبا نصر، له تصانيف، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5929 - أحمد بن علي القمي، المعروف بشقران، المقيم بكش وكان أشل دوارا. 1(@)(@@)(@@)(@@) $ 5930 - إبراهيم الحبوبي، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5931 - أحمد بن الصفار، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5932 - أحمد بن يحيى، يكنى أبا نصر، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5933 - إبراهيم بن نصير الكشي، ثقة مأمون، كثير الرواية.(@)(@@)(@)(@@)(@@)(@@) $ 5934 - إسماعيل بن محمد الإسكاف، تلميذ العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 5935 - أحمد بن محمد بن الحسين الأزدي، غلام العياشي.(@)PageV00P407(@)(@@)(@)(@@)(@@)(@@) $ 5936 - أحمد بن أبي عوف، يكنى أبا عوف، من أهل بخاري، لا بأس به.(@)(@@)(@)(@@)(@@)(@@) $ 5937 - أحمد بن علي الحموي الصيدي، روى عنه حميد بن زياد. 1(@)(@@)(@@)(@@) $ 5938 - أحمد بن وهيب، روى عنه حميد بن زياد. 2(@)(@@)(@@)(@@) $ 5939 - أحمد بن بكر بن جناح، يكنى أبا الحسين، روى عنه حميد كتاب عبد الله بن بكير رواية فضال. 3(@)(@@)(@@)(@@) $ 5940 - أحمد بن ميثم بن أبي نعيم الفضل بن دكين، روى عنه حميد بن زياد كتاب الملاحم وكتاب الدلالة وغير ذلك من الأصول.(@)(@@)(@)(@@)(@@)(@@) $ 5941 - أحمد بن محمد بن مسلمة الرماني البغدادي، روى عنه حميد أصولا كثيرة، منها كتاب زياد بن مروان القندي. 4(@)(@@)(@@)(@@) $ 5942 - أحمد بن محمد بن زيد الخزاعي، يكنى أبا جعفر، روى عنه حميد أصولا كثيره، ومات سنة اثنتين وستين ومائتين، وصلي عليه الحسن بن محمد بن سماعة الصيرفي.(@)(@@)(@)(@@)(@@)(@@) $ 5943 
ms163	 - إبراهيم بن سليمان بن حيان، يكنى أبا إسحاق الخزاز الهلالي، من بني تميم، روى عنه حميد بن زياد أصولا كثيرة.(@)(@@)(@)(@@)(@@)(@@) $ 5944 - أحمد بن الحسين البصري القزاز، روى عنه حميد كتاب عاصم بن حميد وغيره، مات سنة أحدي وستين ومائتين. 5(@)PageV00P408(@)(@@)(@)(@@)(@@)(@@) $ 5945 - أحمد بن الحسين بن مفلس الضبي النخاس، روى عنه حميد كتاب زكريا بن محمد المؤمن وغير ذلك من الأصول. 1(@)(@@)(@@)(@@) $ 5946 - إبراهيم بن محمد بن جعفر بن الحسن بن جعفر بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام، الحسني العلوي الكوفي، روى عنه التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 5947 - أحمد بن علي بن إبراهيم بن محمد بن الحسن بن عبيد الله بن الحسين بن علي بن الحسين بن علي بن أبي طالب عليهم السلام، يكنى أبا العباس الكوفي الجواني، روى عنه التلعكبري أحاديث يسيرة، وسمع منه دعاء الحريق، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5948 - أحمد بن جعفر بن محمد بن إبراهيم بن محمد بن إبراهيم بن موسى بن جعفر العلوي الحيري، يكنى أبا جعفر، روى عنه التلعكبري وسمع منه في سنة سبعين وثلاثمائة، وكان يروي عن حميد.(@)(@@)(@)(@@)(@@)(@@) $ 5949 - أحمد بن محمد بن سعيد بن عبد الرحمان بن إبراهيم بن زياد بن عبد الله بن عجلان، مولي عبد الرحمان بن سعيد بن قيس الهمداني السبيعي الكوفي، المعروف بابن عقدة، يكنى أبا العباس، جليل القدر، عظيم المنزلة، له تصانيف كثيره، ذكرناها في كتاب الفهرست، وكان زيد يا جاروديا، إلا أنه روى جميع كتب أصحابنا وصنف لهم وذكر أصولهم، وكان حفظة، سمعت جماعة يحكون أنه قال:(@)(@@) احفظ مائة وعشرين الف حديث بأسانيدها وأذاكر بثلاثمائة الف حديث، روى عنه التلعكبري من شيوخنا وغيره، وسمعنا من ابن المهدي ومن أحمد بن محمد المعروف بابن الصلت رويا عنه، وأجاز لنا ابن الصلت عنه بجميع رواياته، ومولده سنة تسع وأربعين ومائتين، ومات سنة اثنتين وثلاثين وثلاثمائة. 2(@)(@@)(@@)(@@) $ 5950 - أحمد بن نصر بن سعيد الباهلي، المعروف بابن أبي هراسة، يلقب أبوه هوذة، سمع منه التلعكبري سنة أحدي وثلاثين وثلاثمائة، وله 
ms164	 منه إجازة، مات في(@)PageV00P409(@)(@@) ذي الحجة سنة ثلاث وثلاثين وثلاثمائة يوم التروية بجسر النهروان ودفن بها. 1(@)(@@)(@@)(@@) $ 5951 - أحمد بن محمد بن أبي الغريب الضبي، يكنى أبا الحسن، نزيل بغداد، روى عنه التلعكبري، سمع منه سنة اثنتين وعشرين وثلاثمائة، وله منه إجازة بجميع ما رواه محمد بن زكريا الغلابي. 2(@)(@@)(@@)(@@) $ 5952 - أحمد بن علي بن مهدي بن صدقة بن هشام بن غالب بن محمد بن علي الرقي الأنصاري، يكنى أبا علي، سمع منه التلعكبري بمصر سنة أربعين وثلاثمائة عن أبيه عن الرضا عليه السلام، وله منه إجازة. 3(@)(@@)(@@)(@@) $ 5953 - أحمد بن محمد بن سليمان بن الحسن بن الجهم بن بكير بن أعين بن سنسن الزراري الكوفي، نزيل بغداد، يكنى أبا غالب، جليل القدر، كثير الرواية، ثقة، روى عنه التلعكبري وسمع منه سنة أربعين وثلاثمائة، وله مصنفات ذكرناها في الفهرست، وأخبرنا عنه محمد بن محمد بن النعمان والحسين بن عبيد الله وأحمد بن عبدون المعروف بابن حاشر وابن عزور، مات سنة ثمان أو سبع وستين وثلاثمائة. 4(@)(@@)(@@)(@@) $ 5954 - أحمد بن جعفر بن سفيان البزوفري، يكنى أبا علي، ابن عم أبي عبد الله، روى عنه التلعكبري وسمع منه سنة خمس وستين وثلاثمائة، وله منه إجازة وكان يروي عن أبي علي الأشعري، أخبرنا عنه محمد بن محمد بن النعمان و الحسين بن عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 5955 - أحمد بن محمد بن يحيى العطار القمي، روى عنه التلعكبري، وأخبرنا عنه الحسين بن عبيد الله وأبو الحسين بن أبي جيد القمي، وسمع منه سنة ست(@)PageV00P410(@)(@@) وخمسين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5956 - أحمد بن إدريس القمي الأشعري، يكنى أبا علي، وكان من القواد، روى عنه التلعكبري قال: سمعت منه أحاديث يسيره في دار ابن همام وليس لي منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5957 - أحمد بن الحسن الرازي، يكنى أبا علي، خاصي، روى عن أبي الحسين الأسدي، روى عنه التلعكبري، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5958 - أحمد بن محمد بن يحيى الفارسي، يكنى أبا علي، روى عنه التلعكبري، وسمع منه سنة ثمان وعشرين وثلاثمائة، 
ms165	 وخرج إلي قزوين، وليس له منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5959 - أحمد بن القاسم بن أبي بن كعب، يكنى أبا جعفر، روى عنه التلعكبري، سمع منه سنة ثمان وعشرين وثلاثمائة وما بعدها، وله منه إجازة. 1(@)(@@)(@@)(@@) $ 5960 - أحمد بن إبراهيم بن أبي رافع الصيمري، يكنى أبا عبد الله، روى عنه التلعكبري، وقال: كنا نجتمع ونتذاكر، فروي عني ورويت عنه، وأجاز لي جميع رواياته، وأخبرنا عنه الحسين بن عبيد الله ومحمد بن محمد بن النعمان وأحمد بن عبدون وابن عزور.(@)(@@)(@)(@@)(@@)(@@) $ 5961 - أحمد بن محمد السري، المعروف بابن أبي دارم، يكنى أبا بكر، كوفي، روى عنه التلعكبري وسمع منه ثلاث وثلاثين وثلاثمائة وإلي ما بعدها، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5962 - إبراهيم بن أحمد بن بسام المصري، يكنى أبا إسحاق، روى عنه التلعكبري. 2(@)(@@)(@@)(@@) $ 5963 - أحمد بن إبراهيم بن أحمد بن المعلي بن أسد العمي البصري، يكنى أبا بشر، واسع الرواية ثقة، روى عنه التلعكبري إجازة ولم يلقه، وله مصنفات ذكرناها في الفهرست.(@)PageV00P411(@)(@@)(@)(@@)(@@)(@@) $ 5964 - أحمد بن العباس النجاشي الصيرفي، المعروف بابن الطيالسي، يكنى أبا يعقوب، سمع منه التلعكبري سنة خمس وثلاثين وثلاثمائة وله منه إجازة، وكان يروي دعاء الكامل، ومنزله كان في درب البقر.(@)(@@)(@)(@@)(@@)(@@) $ 5965 - أحمد بن محمد المقري، صاحب أحمد بن بديل، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5966 - إبراهيم بن محمد، مولي قريش، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5967 - أحمد بن عبد الله الكوفي، صاحب إبراهيم بن إسحاق الأحمري، يروي عنه كتب إبراهيم كلها، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5968 - أحمد بن علي البلخي، الرجل الصالح، أجاز للتلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 5969 - أحمد بن إسماعيل الفقيه، صاحب كتاب الإمامة من تصنيف علي ابن محمد الجعفري، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 5970 - أحمد بن عمر الحلال، روى عنه محمد بن عيسى اليقطيني.(@)(@@)(@)(@@)(@@)(@@) $ 5971 - أحمد بن عبدوس الخلنجي، روى ابن الوليد عن الحسن بن متوية بن السندي العريشي عنه. 1(@)(@@)(@@)(@@) $ 5972 - إسماعيل بن مرار، روى عن يونس بن عبد الرحمان، روى عنه إبراهيم ابن هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 5973 - أحمد بن الحسين بن سعيد.(@)(@@)(@)(@@)(@@)(@@) $ 5974 - أحمد بن بشير 
ms166	 البرقي، روى عنهما محمد بن أحمد بن يحيى، وهما ضعيفان، ذكر ذلك ابن بابويه. 2(@)(@@)(@@)(@@) $ 5975 - أحمد بن علوية الأصفهاني، المعروف بابن الأسود الكاتب، روى عن إبراهيم بن محمد الثقفي كتبه كلها، روى عنه الحسين بن محمد بن عامر، وله(@)PageV00P412(@)(@@) دعاء الاعتقاد، تصنيفه.(@)(@@)(@)(@@)(@@)(@@) $ 5976 - إبراهيم بن رجاء الجحدري، روى عنه إبراهيم بن هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 5977 - أحمد بن عبيد الله بن يحيى بن خاقان، وصف أبا محمد الحسن بن علي العسكري عليهما السلام، روى ذلك عنه عبد الله بن جعفر الحميري وغيره.(@)(@@)(@)(@@)(@@)(@@) $ 5978 - أحمد بن هارون الفامي.(@)(@@)(@)(@@)(@@)(@@) $ 5979 - أحمد بن محمد بن يحيى، روى عنهما أبو جعفر ابن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 5980 - أحمد بن علي بن إبراهيم، روى عنه أيضا أبو جعفر.(@)(@@)(@)(@@)(@@)(@@) $ 5981 - أحمد بن حمدان القزويني، روى عنه ابن نوح، وسمع منه سنة اثنتين و أربعين وثلاثمائة، وكان يروي عن محمد بن جعفر الأسدي أبي الحسين.(@)(@@)(@)(@@)(@@)(@@) $ 5982 - أحمد بن محمد بن عيسى القسري، يكنى أبا الحسن، روى عن أبي جعفر محمد بن العلا بشيراز - وكان أديبا فاضلا - بالتوقيع الذي خرج في سنة أحدي وثمانين ومائتين في الصلاة علي النبي محمد وآله.(@)(@@)(@)(@@)(@@)(@@) $ 5983 - أحمد بن محمد بن عياش، يكنى أبا عبد الله، كثير الرواية الا انه اختل في آخر عمره، أخبرنا عنه جماعة من أصحابنا، مات سنة أحدي وأربعمائة. 1(@)(@@)(@@)(@@) $ 5984 - أحمد بن محمد بن داود، يكنى أبا الحسين، يروي عن أبيه محمد بن أحمد بن داود القمي، أخبرنا عنهما الحسين بن عبيد الله.(@)(@@)(@)(@@)(@@)(@@) $ 5985 - أحمد بن الحسن بن إسحاق، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 5986 - إسحاق بن محمد بن علي بن خالد المقري التمار، عن أحمد بن حازم الغفاري عن يوسف بن كليب المسعودي عن يحيى بن سالم، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 5987 - أحمد بن محمد بن رميم المروزي النخعي بالبصرة، روى عن محمد ابن همام، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 5988 - أحمد بن عبدون، المعروف بابن الحاشر، يكنى أبا عبد الله، كثير السماع(@)PageV00P413(@)(@@) والرواية، وسمعنا منه، وأجاز لنا بجميع ما رواه، مات سنة ثلاث 
ms167	 وعشرين و أربعمائة.(@)(@@)(@)(@@)(@@)(@@) $ 5989 - أحمد بن علي الكوفي، يكنى أبا الحسين، روى عن الكليني، أخبرنا عنه علي بن الحسين الموسوي المرتضي. 1(@)(@@)(@@)(@@) $ 5990 - إبراهيم بن صالح الأنماطي، روى عنه أحمد بن نهيك، ذكرناه في الفهرست. 2(@)(@@)(@@)(@@) $ 5991 - إبراهيم بن رجاء الجحدري، من بني قيس بن ثعلبة، له كتب ذكرناها في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 5992 - إبراهيم بن محمد بن سعيد الثقفي، كوفي، له كتب ذكرناها في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 5993 - إبراهيم بن سليمان النهمي، له كتب ذكرناها في الفهرست، روى عنه حميد بن زياد.(@)(@@)(@)(@@)(@@)(@@) $ 5994 - إبراهيم بن إسحاق الأحمري النهاوندي، له كتب، وهو ضعيف.(@)(@@)(@)(@@)(@@)(@@) $ 5995 - إبراهيم بن محمد المذاري، روى عنه ابن حاشر.(@)(@@)(@)(@@)(@@)(@@) $ 5996 - إبراهيم بن محمد الأشعري، أخو الفضل بن محمد، روى عنهما الحسن بن علي بن فضال.(@)(@@)(@)(@@)(@@)(@@) $ 5997 - إبراهيم العجمي، من أهل نهاوند، روى عنه البرقي. 3(@)(@@)(@@)(@@) $ 5998 - إبراهيم بن قتيبة، من أهل أصفهان، روى عنه البرقي. 4(@)(@@)(@@)(@@) $ 5999 - إبراهيم بن هراسة. 5(@)PageV00P414(@)(@@)(@)(@@)(@@)(@@) $ 6000 - إسماعيل بن شعيب العريشي، قليل الحديث ثقة، روى عنه عبد الله بن جعفر.(@)(@@)(@)(@@)(@@)(@@) $ 6001 - إسماعيل بن علي العمي، أبو علي البصري، له كتب ذكرناها في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 6002 - إسماعيل بن محمد بن إسماعيل بن هلال المخزومي، مكي، أبو محمد، روى عن أيوب بن نوح ونظرائه.(@)(@@)(@)(@@)(@@)(@@) $ 6003 - إسماعيل بن علي بن علي بن رزين، ابن أخ دعبل، يكنى أبا القاسم، أخبرنا عنه هلال الحفار.(@)(@@)(@)(@@)(@@)(@@) $ 6004 - إسماعيل بن محمد، قمي، يعرف بقنبرة.(@)(@@)(@)(@@)(@@)(@@) $ 6005 - إسماعيل بن عثمان بن أبان، روى عنه أحمد بن ميثم.(@)(@@)(@)(@@)(@@)(@@) $ 6006 - أحمد بن الحسين بن سعيد، روى عن جميع شيوخ أبيه الا حماد بن عيسى، يرمي بالغلو، مات بقم.(@)(@@)(@)(@@)(@@)(@@) $ 6007 - أحمد بن الحسن بن الحسين اللؤلؤي. 1(@)(@@)(@@)(@@) $ 6008 - أحمد بن الحسين بن عبد الملك الأودي، روى عنه ابن الزبير، روى عن الحسن بن محبوب. 2(@)(@@)(@@)(@@) $ 6009 - أحمد بن علي العلوي العقيقي، مكي. 3(@)(@@)(@@)(@@) $ 6010 - أحمد بن عبدوس الخلنجي.(@)PageV00P415(@)(@@)(@)(@@)(@@)(@@) $ 6011 - أحمد بن أبي زاهر موسى، أبو جعفر الأشعري، روى عنه محمد بن يحيى العطار.(@)(@@)(@)(@@)(@@)(@@) $ 6012 - أحمد بن عبد الله بن 
ms168	 مهران، يعرف بابن خانبة، أبو جعفر، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6013 - أحمد بن محمد بن الحسين بن سعيد القرشي، أبو عبد الله، روى عنه ابن عقده. 1(@)(@@)(@@)(@@) $ 6014 - أحمد بن محمد بن علي بن عمر بن رباح، أبو الحسن، وأخوه محمد أبو الحسين، وأبو القاسم علي، وهو الأصغر وهو أكثرهم حديثا [وجدهم عمر بن رباح القلا روى عن أبي عبد الله وأبي الحسن موسى عليهما السلام ووقف وكل أولاده] واقفة، وآخر من بقي من بني رباح أبو عبد الله محمد بن علي بن محمد بن علي بن عمر بن رباح، وكان شديد العناد، وأحمد المتقدم ثقة. 2(@)(@@)(@@)(@@) $ 6015 - أحمد بن الحسن الاسفرائني، أبو العباس الضرير المفسر، روى ابن أبي رافع عن ابن بهلول عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6016 - أحمد بن محمد بن عاصم، أبو عبد الله، يقال له: العاصمي، ابن أخ علي ابن عاصم المحدث، روى عنه ابن الجنيد وابن داود.(@)(@@)(@)(@@)(@@)(@@) $ 6017 - أحمد بن محمد بن عمار، كوفي ثقة، روى عنه ابن داود.(@)(@@)(@)(@@)(@@)(@@) $ 6018 - أحمد بن علي الفائدي القزويني، ثقة، روى عنه ابن حاتم القزويني.(@)(@@)(@)(@@)(@@)(@@) $ 6019 - أحمد بن إبراهيم بن معلي بن أسد العمي، أبو بشر، بصري، ثقة، مستملي أبي أحمد الجلودي.(@)(@@)(@)(@@)(@@)(@@) $ 6020 - أحمد بن علي، أبو العباس الرازي الخضيب الأيادي، متهم بالغلو.(@)(@@)(@)(@@)(@@)(@@) $ 6021 - أحمد بن اصفهبذ، أبو العباس القمي الضرير المفسر، روى عنه ابن قولويه.(@)PageV00P416(@)(@@)(@)(@@)(@@)(@@) $ 6022 - أحمد بن إسماعيل بن سمكة القمي، أديب، أستاذ ابن العميد.(@)(@@)(@)(@@)(@@)(@@) $ 6023 - أحمد بن محمد بن جعفر، أبو علي الصولي، صحب الجلودي، روى الشيخ أبو عبد الله محمد بن محمد بن النعمان عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6024 - أحمد بن عبد الله بن أحمد بن جلين الدوري، أبو بكر الوراق، ثقة، روى عنه ابن الغضائري.(@)(@@)(@)(@@)(@@)(@@) $ 6025 - أحمد بن محمد بن عمر بن موسى بن الجراح، أبو الحسن، المعروف بابن الجندي، روى عنه ابن عزور. 1(@)(@@)(@@)(@@) $ 6026 - أحمد بن داود بن سعيد الفزاري، أبو يحيى الجرجاني، كان عاميا.(@)(@@) متقدما في علم الحديث، ثم استبصر، له كتب ذكرناها في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 6027 - أحمد بن محمد بن نوح 
ms169	 البصري السيرافي، يكنى أبا العباس، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6028 - أحمد بن سليمان الحجال، روى عنه البرقي.(@)(@@)(@@)(@@) || باب الباء(@)(@@)(@@)(@@) $ 6029 - بكر الكرماني، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6030 - بكار بن أحمد بن زياد، روى عنه ابن الزبير.(@)(@@)(@)(@@)(@@)(@@) $ 6031 - بكر بن صالح الرازي، روى عنه إبراهيم بن هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 6032 - بكر بن محمد الأزدي، روى عنه العباس بن معروف.(@)(@@)(@)(@@)(@@)(@@) $ 6033 - بندار بن محمد، امامي، له كتب ذكرناها في الفهرست.(@)(@@)(@@)(@@) || باب التاء(@)(@@)(@@)(@@) $ 6034 - تقي بن نجم الحلبي، ثقة، له كتب، قرأ علينا وعلي المرتضي(@)PageV00P417(@)(@@)(@@)(@@) || باب الثاء(@)(@@)(@@)(@@) $ 6035 - ثابت بن شريح، روى عنه عبيس بن هشام.(@)(@@)(@@)(@@) || باب الجيم(@)(@@)(@@)(@@) $ 6036 - جعفر بن علي بن أحمد القمي، المعروف بابن الرازي، يكنى أبا محمد، صاحب المصنفات. 1(@)(@@)(@@)(@@) $ 6037 - جعفر بن محمد بن مالك، كوفي، ثقة، ويضعفه قوم، روى في مولد القائم عليه السلامأعاجيب.(@)(@@)(@)(@@)(@@)(@@) $ 6038 - جعفر بن محمد بن قولويه، يكنى أبا القاسم القمي، صاحب مصنفات، قد ذكرنا بعض كتبه في الفهرست، روى عنه التلعكبري، وأخبرنا عنه محمد بن محمد بن النعمان والحسين بن عبيد الله وأحمد بن عبدون وابن عزور، مات سنة ثمان وستين وثلاثمائة.(@)(@@)(@)(@@)(@@)(@@) $ 6039 - جعفر بن محمد بن جندب، يكنى أبا محمد، من أهل قزوين.(@)(@@)(@)(@@)(@@)(@@) $ 6040 - جعفر بن أحمد بن أيوب، يعرف بابن التاجر، من أهل سمرقند، متكلم، له كتب.(@)(@@)(@)(@@)(@@)(@@) $ 6041 - جعفر بن معروف، يكنى أبا محمد، من أهل كش، وكيل، وكان مكاتبا.(@)(@@)(@)(@@)(@@)(@@) $ 6042 - جبريل بن أحمد الفاريابي، يكنى أبا محمد، وكان مقيما بكش، كثير الرواية عن العلماء بالعراق وقم وخراسان.(@)(@@)(@)(@@)(@@)(@@) $ 6043 - جعفر بن محمد بن مسعود العياشي، فاضل، روى عن أبيه جميع كتب أبيه، روى عنه أبو المفضل الشيباني.(@)(@@)(@)(@@)(@@)(@@) $ 6044 - جعفر بن محمد، يكنى أبا القاسم الشاشي، من غلمان العياشي.(@)PageV00P418(@)(@@)(@)(@@)(@@)(@@) $ 6045 - جعفر بن أبي جعفر السمرقندي وابنه، يروي بعضهم عن بعض، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6046 - جعفر بن علي بن حازم، يروي عنه حميد بن زياد.(@)(@@)(@)(@@)(@@)(@@) $ 6047 - جعفر بن عبد الرحمان، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6048 - جعفر بن محمد السنجاري، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6049 - جعفر بن هذيل، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6050 
ms170	 - جعفر بن الوراق، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6051 - جعفر بن محمد الدوريستي، أبو عبد الله، ثقة. 1(@)(@@)(@@)(@@) $ 6052 - جعفر بن محمد بن إبراهيم بن عبيد الله بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليه السلام، العلوي الحسيني الموسوي المصري، روى عنه التلعكبري، وكان سماعه منه سنة أربعين وثلاثمائة بمصر، و له منه إجازة. 2(@)(@@)(@@)(@@) $ 6053 - جعفر بن محمد العلوي الحسيني، من ولد علي بن عبد الله بن الحسين ابن علي بن الحسين بن علي بن أبي طالب عليه السلام، يكنى أبا هاشم، روى عنه التلعكبري وقال: كان قليل الرواية، وسمع منه شيئا يسيرا.(@)(@@)(@)(@@)(@@)(@@) $ 6054 - أبو عبد الله جعفر بن محمد بن إبراهيم بن محمد بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليه السلام الحيري، روى عنه التلعكبري وسمع منه سنة ستين وثلاثمائة، وله منه إجازة، روى عن حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6055 - جعفر بن علي بن سهل بن فروخ الدقاق الدوري الحافظ، بغدادي، يكنى أبا محمد، سمع منه التلعكبري سنة ثمان وعشرين وثلاثمائة وما بعدها وله منه إجازة.(@)PageV00P419(@)(@@)(@)(@@)(@@)(@@) $ 6056 - جعفر بن عبد الله، روى عن الحسن بن محبوب، روى عنه ابن عقدة. 1(@)(@@)(@@)(@@) $ 6057 - جعفر بن محمد الكوفي، روى عنه محمد بن أحمد بن يحيى.(@)(@@)(@)(@@)(@@)(@@) $ 6058 - جعفر بن الحسين، روى عنه ابن بابويه أبو جعفر.(@)(@@)(@)(@@)(@@)(@@) $ 6059 - جعفر بن محمد بن مروان بن إسماعيل بن إبراهيم البخاري، روى عنه أبو عبد الله محمد بن محمد بن رباط الخزاز الكوفي، روى عنه ابن نوح. 2(@)(@@)(@@)(@@) $ 6060 - جعفر بن علي البجلي، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6061 - جعفر بن علي بن حسان.(@)(@@)(@)(@@)(@@)(@@) $ 6062 - وجعفر بن عبد الرحمان الكاهلي.(@)(@@)(@)(@@)(@@)(@@) $ 6063 - وجعفر الهذلي.(@)(@@)(@)(@@)(@@)(@@) $ 6064 - وجعفر الوراق، روى عنهم حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6065 - جعفر بن محمد، يكنى أبا محمد، روى عنه محمد بن علي بن محبوب.(@)(@@)(@@)(@@) || باب الحاء(@)(@@)(@@)(@@) $ 6066 - الحسن بن خالد البرقي، أخو محمد بن خالد، أبو علي.(@)(@@)(@)(@@)(@@)(@@) $ 6067 - الحسن بن العباس الحريشي.(@)(@@)(@)(@@)(@@)(@@) $ 6068 - الحسن بن موسى 
ms171	 الخشاب، روى عنه الصفار.(@)(@@)(@)(@@)(@@)(@@) $ 6069 - الحسن بن موسى النوبختي، ابن أخت أبي سهل، أبو محمد، متكلم، ثقة(@)(@@)(@@)(@@) $ 6070 - الحسين بن الحسن الحسيني الأسود، فاضل، يكنى أبا عبد الله، رازي.(@)(@@)(@)(@@)(@@)(@@) $ 6071 - الحسن بن علي الخياط، رازي، فاضل.(@)(@@)(@)(@@)(@@)(@@) $ 6072 - الحسين بن اشكيب المروزي، فاضل، جليل متكلم، فقيه مناظر، صاحب تصانيف، لطيف الكلام، جيد النظر.(@)(@@)(@)(@@)(@@)(@@) $ 6073 - حيدر بن محمد بن نعيم السمرقندي، عالم جليل، يكنى أبا أحمد، يروي(@)PageV00P420(@)(@@) جميع مصنفات الشيعة وأصولهم عن محمد بن الحسن بن أحمد بن الوليد القمي، وعن أبي عبد الله الحسين بن أحمد بن إدريس القمي، وعن أبي القاسم جعفر بن محمد بن قولويه القمي، وعن أبيه، روى عن الكشي عن العياشي جميع مصنفاته، روى عنه التلعكبري وسمع منه سنة أربعين وثلاثمائة، وله منه إجازة، وله كتب ذكرناها في الفهرست. 1(@)(@@)(@@)(@@) $ 6074 - حمدويه بن نصير بن شاهي، سمع يعقوب بن يزيد، روى عن العياشي، يكنى أبا الحسن، عديم النظير في زمانه، كثير العلم والرواية، ثقة، حسن المذهب.(@)(@@)(@)(@@)(@@)(@@) $ 6075 - الحسن بن خرزاذ، من أهل كش.(@)(@@)(@)(@@)(@@)(@@) $ 6076 - الحسين بن نعيم، يروي عن العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6077 - الحسين الغزال الكتنجي، يروي عن العياشي. 2(@)(@@)(@@)(@@) $ 6078 - الحسن بن يوسف.(@)(@@)(@)(@@)(@@)(@@) $ 6079 - الحسن الكرماني، روى عن العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6080 - الحسن بن علي القائد، يكنى أبا محمد، من أهل كش.(@)(@@)(@)(@@)(@@)(@@) $ 6081 - حميد بن زياد، من أهل نينوى، قرية بجنب الحائر علي ساكنه السلام، عالم جليل، واسع العلم كثير التصانيف، قد ذكرنا طرفا من كتبه في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 6082 - الحسن بن عنبسة الصوفي، روى عنه حميد. 3(@)(@@)(@@)(@@) $ 6083 - الحسن بن يحيى الطحان، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6084 - الحسن بن محمد، الداعي بالخير.(@)PageV00P421(@)(@@)(@)(@@)(@@)(@@) $ 6085 - الحسن بن محمد السراج، روى عنهما حميد. 1(@)(@@)(@@)(@@) $ 6086 - الحسن بن هذيل، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6087 - الحسن بن محمد بن أحمد بن جعفر بن محمد بن زيد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام، يكنى أبا محمد، روى عنه التلعكبري وسمع منه سنه ثلاث وعشر بن وثلاثمائة وما بعدها، وكان ينزل بالرميلة ببغداد، وله 
ms172	 منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6088 - الحسن بن محمد بن يحيى بن الحسن بن جعفر بن عبيد الله بن الحسين ابن علي بن الحسين بن علي بن أبي طالب عليهم السلام، صاحب النسب، ابن أخ طاهر، روى عنه التلعكبري وسمع منه سنة سبع وعشرين وثلاثمائة إلي سنة خمس وخمسين، يكنى أبا محمد، وله منه إجازة، أخبرنا عنه أبو الحسين بن أبي جعفر النسابة وأبو علي بن شاذان من العامة.(@)(@@)(@)(@@)(@@)(@@) $ 6089 - الحسن بن محمد بن حمزة بن علي بن عبد الله بن محمد بن الحسن بن الحسين ابن علي بن الحسين بن علي بن أبي طالب عليهم السلام، المرعشي الطبري، يكنى أبا محمد، زاهد عالم أديب فاضل، روى عنه التلعكبري، وكان سماعه منه أولا سنة ثمان وعشرين وثلاثمائة، وله منه إجازة بجميع كتبه ورواياته، أخبرنا عنه جماعه، منهم الحسين بن عبيد الله وأحمد بن عبدون ومحمد بن محمد بن النعمان، وكان سماعهم منه سنة أربع وخمسين وثلاثمائة. 2(@)(@@)(@@)(@@) $ 6090 - حمزة بن القاسم، يكنى أبا عمرو، هاشمي، عباسي، روى عنه التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 6091 - الحسين بن محمد بن الفرزدق، المعروف بالقطعي، يكنى أبا(@)PageV00P422(@)(@@) عبد الله كوفي، روى عنه التلعكبري وسمع منه سنه ثمان وعشرين وثلاثمائة، وله منه إجازة، وروى عنه ابن عياش.(@)(@@)(@)(@@)(@@)(@@) $ 6092 - الحسين بن علي بن سفيان البزوفري، خاصي، يكنى أبا عبد الله، له كتب ذكرناها في الفهرست، روى عنه التلعكبري، وأخبرنا عنه جماعة، منهم محمد بن محمد بن النعمان والحسين بن عبيد الله وأحمد بن عبدون.(@)(@@)(@)(@@)(@@)(@@) $ 6093 - الحسين بن علي بن الحسين بن موسى بن بابويه، كثير الرواية، يروي عن جماعه وعن أبيه وعن أخيه محمد بن علي، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6094 - الحسين بن أحمد بن إدريس القمي الأشعري، يكنى أبا عبد الله، روى عنه التلعكبري، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6095 - حنظلة بن زكريا بن يحيى بن حنظلة التميمي القزويني، يكنى أبا الحسين، خاصي، روى عنه التلعكبري وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6096 - حيدر بن شعيب بن عيسى الطالقاني، خاصي، نزيل بغداد، يكنى أبا القاسم. روى عنه التلعكبري وسمع منه 
ms173	 سنة ست وعشرين وثلاثمائة، وقال: روى كتب الفضل بن شاذان عن أبي عبد الله محمد بن نعيم بن شاذان المعروف بالشاذاني ابن أخ الفضل، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6097 - الحسين بن أحمد بن شيبان القزويني، نزيل بغداد، يكنى أبا عبد الله، روى عنه التلعكبري وله منه إجازة، أخبرنا عنه أحمد بن عبدون.(@)(@@)(@)(@@)(@@)(@@) $ 6098 - الحسين بن حمدان الحصيني الجنبلاني، يكنى أبا عبد الله، روى عنه التلعكبري. 1(@)(@@)(@@)(@@) $ 6099 - الحسن بن محمد بن الحسن السكوني الكوفي، يكنى أبا القاسم، روى عنه التلعكبري وسمع منه في داره بالكوفة سنة أربع وأربعين وثلاثمائة، وليس له منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6100 - الحسن بن إبراهيم بن عبد الصمد الخزاز الكوفي، روى عنه التلعكبري،(@)PageV00P423(@)(@@) سمع منه سنة سبع وثلاثين وثلاثمائة، وليس له منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6101 - الحسن بن محمد بن أحمد الحذاء النيسابوري، يكنى أبا محمد، روى عنه التلعكبري وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6102 - الحسن بن عبد السلام، روى عنه التلعكبري إجازة، أجازها له علي يدي إسماعيل بن يحيى العبسي، وكان يروي عن سعد بن عبد الله وعبد الله بن جعفر الحميري ونظرائهما كتب القميين.(@)(@@)(@)(@@)(@@)(@@) $ 6103 - حمزة بن القاسم بن محمد بن عبد الله بن عبيد الله بن الحسن بن عبيد الله ابن العباس بن علي بن أبي طالب عليه السلام، يروي عن سعد بن عبد الله، روى عنه التلعكبري إجازة. 1(@)(@@)(@@)(@@) $ 6104 - حمزة بن القاسم العلوي العباسي، يروي عن سعد بن عبد الله، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6105 - حمزة بن محمد القزويني العلوي، يروي عن علي بن إبراهيم ونظرائه، روى عنه محمد بن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6106 - الحسين بن أحمد بن عامر الأشعري، يروي عن عمه عبد الله بن عامر عن ابن أبي عمير، روى عنه الكليني.(@)(@@)(@)(@@)(@@)(@@) $ 6107 - الحسين بن علي بن أحمد، روى عنه ابن بابويه محمد بن علي، عن ابن عقدة.(@)(@@)(@)(@@)(@@)(@@) $ 6108 - الحسن بن متيل القمي، روى عنه ابن الوليد.(@)(@@)(@)(@@)(@@)(@@) $ 6109 - الحسين بن الحسن بن أبان، روى عن الحسين بن سعيد كتبه كلها، روى عنه ابن الوليد. 
ms174	(@)(@@)(@)(@@)(@@)(@@) $ 6110 - الحسن بن الحسين اللؤلؤي، روى عنه محمد بن أحمد بن يحيى، ضعفه ابن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6111 - الحسن بن علي بن أحمد الصائغ.(@)PageV00P424(@)(@@)(@)(@@)(@@)(@@) $ 6112 - الحسين بن الحسن بن محمد 1(@)(@@)(@@)(@@) $ 6113 - الحسين بن أحمد بن إدريس، روى عنهم محمد بن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6114 - الحسين بن علي، روى عن حميد بن زياد، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 6115 - الحسن بن علي بن أحمد، يكنى أبا محمد، روى عن ابن همام، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 6116 - الحسين بن الحسن بن بندار، روى عن سعد بن عبد الله، روى عنه الكشي.(@)(@@)(@)(@@)(@@)(@@) $ 6117 - الحسين بن عبيد الله الغضائري، يكنى أبا عبد الله، كثير السماع، عارف بالرجال، وله تصانيف ذكرناها في الفهرست، سمعنا منه وأجاز لنا بجميع رواياته، مات سنة أحدي عشره وأربعمائة.(@)(@@)(@)(@@)(@@)(@@) $ 6118 - الحسن بن عيسى، أبو علي، المعروف بابن أبي عقيل العماني، له كتب. 2(@)(@@)(@@)(@@) $ 6119 - الحسين بن عبد الله بن سهل، روى عنه ابن حاتم. 3(@)(@@)(@@)(@@) $ 6120 - الحسين أبو علي بن الفرج أبي قتادة، روى عنه أحمد بن أبي عبد الله البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6121 - الحسين بن الزبرقان، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6122 - حفص بن غياث القاضي، روى ابن الوليد عن محمد بن حفص، عن أبيه.(@)PageV00P425(@)(@@)(@)(@@)(@@)(@@) $ 6123 - حمدان بن سليمان النيسابوري، روى عنه محمد بن يحيى العطار.(@)(@@)(@@)(@@) || باب الخاء(@)(@@)(@@)(@@) $ 6124 - خلف بن حماد، يكنى أبا صالح، من أهل كش.(@)(@@)(@)(@@)(@@)(@@) $ 6125 - خليفة بن الصباح بن خليفة، روى عن أبيه، عن أبان بن عثمان الأحمر، عن أبي بصير، روى عنه وسمع الحسن بن علي بن نعيم بن سهل بن أبان.(@)(@@)(@)(@@)(@@)(@@) $ 6126 - الخضر بن عيسى، روى عنه محمد بن علي بن محبوب.(@)(@@)(@@)(@@) || باب الدال(@)(@@)(@@)(@@) $ 6127 - داود بن محمد النهدي، روى عنه الصفار.(@)(@@)(@)(@@)(@@)(@@) $ 6128 - داود بن كورة القمي، بوب كتاب النوادر لأحمد بن محمد بن عيسى.(@)(@@)(@@)(@@) || باب الراء(@)(@@)(@@)(@@) $ 6129 - الريان بن الصلت، روى عنه إبراهيم بن هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 6130 - رشيد بن زيد الجعفي، روى حميد بن زياد عن إبراهيم بن سليمان عنه. 1(@)(@@)(@@)(@@) || باب الزاي(@)(@@)(@@)(@@) $ 6131 - زيتون، يكنى أبا 
ms175	 محمد، قمي.(@)(@@)(@)(@@)(@@)(@@) $ 6132 - زيد بن أحمد الخلفي، يزدكي، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6133 - زيد بن محمد بن جعفر، المعروف بابن أبي الياس الكوفي، روى عنه التلعكبري، قال: قدم علينا بغداد ونزل في نهر البزازين، سمع منه سنة ثلاثين و ثلاثمائة وله منه إجازة، وكان له كتاب الفضائل، روى عنه الحسن بن علي بن(@)PageV00P426(@)(@@) الحسن الدينوري العلوي، روى عن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6134 - زكريا بن الحر، روى حميد عن محمد بن موسى خوراء عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6135 - زرعة بن محمد، عن سماعة.(@)(@@)(@@)(@@) || باب السين(@)(@@)(@@)(@@) $ 6136 - سهل بن بحر الفارسي، كان مقيما بكش.(@)(@@)(@)(@@)(@@)(@@) $ 6137 - سعد الصفار، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6138 - سهل بن أحمد بن عبد الله بن سهل الديباجي، بغدادي، وكان ينزل درب الزعفراني ببغداد، سمع منه التلعكبري سنة سبعين وثلاثمائة وله منه إجازة و لابنه، أخبرنا عنه الحسين بن عبيد الله، يكنى أبا محمد.(@)(@@)(@)(@@)(@@)(@@) $ 6139 - سلامة بن محمد بن إسماعيل الأرزني، نزيل بغداد، سمع منه التلعكبري سنة ثمان وعشرين وثلاثمائة، وله منه إجازة يكنى أبا الحسن.(@)(@@)(@)(@@)(@@)(@@) $ 6140 - سلامة بن ذكاء الحراني، يكنى أبا الخير، صاحب التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 6141 - سعد بن عبد الله بن أبي خلف القمي، جليل القدر، صاحب تصانيف، ذكرناها في الفهرست، روى عنه ابن الوليد وغيره، وروى ابن قولويه عن أبيه عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6142 - سهل بن الحسن الصفار، أخو محمد، روى عن يوسف بن الحارث الكمنداني عن عبد الرحمان البرزمي كتابه، روى عنه أخوه محمد بن الحسن.(@)(@@)(@)(@@)(@@)(@@) $ 6143 - سلمة بن الخطاب البراوستاني، له كتب ذكرناها في الفهرست، روى عنه الصفار وسعد وأحمد بن إدريس وغيرهم.(@)(@@)(@)(@@)(@@)(@@) $ 6144 - سليمان بن صالح الجصاص، روى عنه الحسن بن محمد بن سماعة.(@)(@@)(@)(@@)(@@)(@@) $ 6145 - سهل بن زياد الواسطي، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6146 - السندي بن محمد، روى عنه الصفار. 1(@)PageV00P427(@)(@@)(@@)(@@) $ 6147 - السندي بن الربيع.(@)(@@)(@@)(@@) || باب الشين(@)(@@)(@@)(@@) $ 6148 - شعيب المحاملي، روى عنه البرقي.(@)(@@)(@@)(@@) $ 6149 - شعيب بن أعين الحداد، روى عنه ابن سماعة.(@)(@@)(@@)(@@) $ 6150 - شريف بن سابق التفليسي، روى عنه البرقي أحمد.(@)(@@)(@@)(@@) || باب الصاد(@)(@@)(@@)(@@) $ 6151 - صالح بن السندي، روى عن يونس 
ms176	 بن عبد الرحمان، روى عنه إبراهيم ابن هاشم.(@)(@@)(@@)(@@) $ 6152 - صالح القماط.(@)(@@)(@@)(@@) $ 6153 - صالح الحذاء، روى حميد بن زياد عن أحمد بن ميثم عنهم.(@)(@@)(@@)(@@) || باب الضاد(@)(@@)(@@)(@@) $ 6154 - الضحاك بن سعد الواسطي، روى حميد بن زياد عن إبراهيم بن سليمان عنه.(@)(@@)(@@)(@@) || باب الطاء(@)(@@)(@@)(@@) $ 6155 - طاهر بن عيسى الوراق يكنى أبا محمد، من أهل كش صاحب كتب، روى عنه الكشي، وروى هو عن جعفر بن أحمد الخزاعي، عن محمد بن الحسين بن أبي الخطاب(@)(@@)(@@)(@@) $ 6156 - طاهر بن حاتم بن ماهويه، روى عنه محمد بن عيسى بن يقطين، غالي. PageV00P428(@)(@@)(@@)(@@) || باب الظاء(@)(@@)(@@)(@@) $ 6157 - ظفر بن محمد البادرائي، روى عن إبراهيم بن إسحاق الأحمري، أخبرنا عنه ابن شبل الوكيل. 1(@)(@@)(@@)(@@) || باب العين(@)(@@)(@@)(@@) $ 6158 - علي بن صالح، يروي عن الصفار، قمي.(@)(@@)(@)(@@)(@@)(@@) $ 6159 - علي بن محمد القتيبي، تلميذ الفضل بن شاذان، نيسابوري، فاضل.(@)(@@)(@)(@@)(@@)(@@) $ 6160 - عبد الله بن بشر السرخسي، نفاه إسماعيل بن أحمد صاحب خراسان عن البلد.(@)(@@)(@)(@@)(@@)(@@) $ 6161 - علي بن محمد الخلقي، من أهل سمرقند، ثقة، فاضل.(@)(@@)(@)(@@)(@@)(@@) $ 6162 - علي بن الحسين بن علي، يكنى أبا الحسن بن أبي طاهر الطبري، من أهل سمرقند، ثقة، وكيل، يروي عن جعفر بن محمد بن مالك وعن أبي الحسين الأسدي.(@)(@@)(@)(@@)(@@)(@@) $ 6163 - عثمان بن حامد، يكنى أبا سعيد الوجيني من، أهل كش، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6164 - علي بن محمد بن فيروزان القمي، كثير الرواية، يكنى أبا الحسن، كان مقيما بكش.(@)(@@)(@)(@@)(@@)(@@) $ 6165 - عيسى بن عمر السنائي، عالم زيدي المذهب.(@)(@@)(@)(@@)(@@)(@@) $ 6166 - علي بن إسماعيل الدهقان، زاهد خير فاضل، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6167 - علي بن حسنوية الكرماني، من تلامذة أبي النضر محمد بن مسعود العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6168 - عبد الله بن طاهر النقار، ثقة، حلواني، صالح ورع، يكنى أبا القاسم،(@)PageV00P429(@)(@@) من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6169 - عمرو الخياط، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6170 - عبد الله الصيدلاني، من أصحابه أيضا.(@)(@@)(@)(@@)(@@)(@@) $ 6171 - عوانة بن الحسين البزاز، كوفي، روى عنه حميد بن زياد، مات سنة أربع وستين ومائتين، وصلي عليه موسى بن زيد العلوي.(@)(@@)(@)(@@)(@@)(@@) $ 6172 - علي بن أحمد بن علي الخزاز، نزيل الري، يكنى أبا الحسن، 
ms177	 متكلم جليل. 1(@)(@@)(@@)(@@) $ 6173 - عمران بن مسكان، روى عنه حميد بن زياد.(@)(@@)(@)(@@)(@@)(@@) $ 6174 - علي بن جندب كوفي، روى عنه حميد، مات سنة ثمان وستين ومائتين، وصلي عليه الحسن بن أحمد الكوفي ودفن بالكوفة في بني رواس ذاك الجانب. 2(@)(@@)(@@)(@@) $ 6175 - عمر بن طرخان، روى عنه حميد كتاب أبي يحيى المكفوف.(@)(@@)(@)(@@)(@@)(@@) $ 6176 - عبيد الله بن أحمد بن نهيك، يكنى أبا العباس، كوفي، روى عنه حميد كتبا كثيرة من الأصول. 3(@)(@@)(@@)(@@) $ 6177 - علي بن بزرج، يكنى أبا الحسن، روى عنه حميد كتبا كثيرة من الأصول.(@)(@@)(@)(@@)(@@)(@@) $ 6178 - علي بن إبراهيم الخياط، روى عنه حميد أصولا، مات سنة سبع و مائتين، وصلي عليه إبراهيم بن محمد العلوي ودفن عند مسجد السهلة. 4(@)(@@)(@@)(@@) $ 6179 - علي بن محمد بن الزبير القرشي الكوفي، روى عن علي بن الحسن بن(@)PageV00P430(@)(@@) فضال جميع كتبه، وروى أكثر الأصول، روى عنه التلعكبري، وأخبرنا عنه أحمد ابن عبدون، ومات ببغداد سنة ثمان وأربعين وثلاثمائة وقد ناهز مائة سنة، ودفن في مشهد أمير المؤمنين عليه السلام.(@)(@@)(@)(@@)(@@)(@@) $ 6180 - عيسى بن جعفر بن علي بن محمد بن علي بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام، المعروف بابن الرضا عليه السلام، سمع منه التلعكبري سنة خمس وعشرين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6181 - العباس بن علي بن جعفر بن عبد الله بن جعفر بن عبد الله بن جعفر ابن محمد بن علي بن أبي طالب عليه السلام، من ولد بن الحنيفة، يكنى أبا الحسن، روى عنه التلعكبري، وقال: هو ولد ولد أبي عبد الله جعفر بن عبد الله المحمد ي، الذي يروي عنه ابن عقدة وسمع منه سنة اثنتين وثلاثين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6182 - علي بن محمد بن يعقوب بن إسحاق بن عمار الصيرفي الكسائي الكوفي العجلي، روى عنه التلعكبري وسمع منه سنة خمس وعشرين وثلاثمائة، وله منه إجازة، مات سنة اثنتين وثلاثين وثلاثمائة. 1(@)(@@)(@@)(@@) $ 6183 - عبد العزيز بن عبد الله بن يونس الموصلي الأكبر، يكنى 
ms178	 أبا الحسن، روى عنه التلعكبري وسمع منه سنة ست وعشرين وثلاثمائة، وأجاز له، وذكر انه كان فاضلا ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6184 - عبد الواحد بن عبد الله بن يونس الموصلي، أخو عبد العزيز، يكني أبا القاسم، سمع منه أيضا سنه ست وعشرين وثلاثمائة وذكر انه كان ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6185 - عبيد الله بن محمد بن الفضل بن هلال الطائي، يكنى أبا عيسى المصري، خاصي، روى عنه التلعكبري وقال: سمعت منه بمصر سنة أحدي وأربعين وثلاثمائة، وله منه إجازة، وقال: كان يروي كتاب الحلبي النسخة الكبيرة.(@)(@@)(@)(@@)(@@)(@@) $ 6186 - علي بن الحسن بن القاسم القشيري الخزاز الكوفي، المعروف بابن الطبال، يكنى أبا القاسم، روى عنه التلعكبري وسمع منه سنه تسع وعشرين و(@)PageV00P431(@)(@@) ثلاثمائة، وذكر انه سمع منه أحاديث محمد بن معروف الهلالي عن أبي عبد الله عليه السلام، قال: ولم يكن من أصحاب الحديث.(@)(@@)(@)(@@)(@@)(@@) $ 6187 - علي بن محمد بن محمد بن عقبة الشيباني الكوفي، يكنى أبا الحسن، سمع منه التلعكبري بالكوفة وببغداد، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6188 - عبد الله بن أحمد بن يعقوب بن نصر الأنباري، يكنى أبا طالب، خاصي، روى عنه التلعكبري، أخبرنا عنه أحمد بن عبدون، وله تصانيف ذكرنا بعضها في الفهرست. 1(@)(@@)(@@)(@@) $ 6189 - علي بن حبشي بن قوني الكاتب، خاصي، روى عنه التلعكبري وسمع منه سنة اثنتين وثلاثين وثلاثمائة إلي وقت وفاته، له منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6190 - علي بن حاتم بن أبي حاتم القزويني، يكنى أبا الحسن، ثقة، له تصانيف ذكرنا بعضها في الفهرست، روى عنه التلعكبري وسمع منه سنه ست و عشرين وثلاثمائة وفيما بعدها، وله منه إجازة. 2(@)(@@)(@@)(@@) $ 6191 - علي بن الحسين بن موسى بن بابويه القمي، يكنى أبا الحسن، ثقة، له تصانيف ذكرناها في الفهرست، روى عنه التلعكبري، قال: سمعت منه في السنة التي تهافتت فيها الكواكب دخل بغداد فيها، وذكران له منه إجازة بجميع ما يرويه.(@)(@@)(@)(@@)(@@)(@@) $ 6192 - علي بن عبد الله، المعروف بالخديجي النيلي، روى عنه التلعكبري، يكنى أبا الحسن.(@)(@@)(@)(@@)(@@)(@@) $ 6193 - علي بن الحسن بن الحجاج الكوفي، خاصي، يكنى أبا الحسن، روى عنه 
ms179	 التلعكبري وقال: سمعت منه بالكوفة في الجامع سنة ثلاث وثلاثين وثلاثمائة، و ليس له منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6194 - عبد العزيز بن إسحاق بن جعفر الزيدي البقال الكوفي، وكان زيديا،(@)PageV00P432(@)(@@) يكنى أبا القاسم، سمع منه التلعكبري سنة ست وعشرين وثلاثمائة.(@)(@@)(@)(@@)(@@)(@@) $ 6195 - عبد الغفار بن عبد الله بن السري الحضيني المقري، يكنى أبا الطيب، روى عنه التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 6196 - عبيد الله بن محمد بن عائذ الحلال، بغدادي، يكنى أبا محمد، سمع منه التلعكبري سنة ستين وثلاثمائة، وله منه إجازة، وكان ينزل باب الطاق.(@)(@@)(@)(@@)(@@)(@@) $ 6197 - علي بن محمد الحداد، يكنى أبا الحسن، صاحب كتب الفضل بن شاذان، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6198 - علي بن عبد الله، العلوي، يكنى أبا طالب، صاحب مسجد الرضا عليه السلام بمطير من ارض طبرستان، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6199 - علي بن الحسين السعد آبادي، روى عنه الكليني، وروى عنه الزراري وكان معلمه.(@)(@@)(@)(@@)(@@)(@@) $ 6200 - عباد بن سليمان، روى عن محمد بن سليمان الديلمي، روى عنه الصفار.(@)(@@)(@)(@@)(@@)(@@) $ 6201 - عبد الله بن محمد الشامي، روى عنه محمد بن أحمد بن يحيى.(@)(@@)(@)(@@)(@@)(@@) $ 6202 - عبد الله بن محمد الرازي، روى عنه محمد بن أحمد بن يحيى. 1(@)(@@)(@@)(@@) $ 6203 - عبد الله بن الحسن المؤدب، روى عن أحمد بن علوية كتب الثقفي، روى عنه علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6204 - علي بن محمد بن سعد الأشعري، روى عنه محمد بن الحسن بن الوليد.(@)(@@)(@)(@@)(@@)(@@) $ 6205 - عبد الله بن أبي الحسين العلوي، روى عن أبيه عن الرضا عليه السلام، روى عنه الصفواني.(@)(@@)(@)(@@)(@@)(@@) $ 6206 - عبد الله بن إبراهيم، يكنى أبا العباس، روى عن أحمد بن أبي عبد الله البرقي. 2(@)(@@)(@@)(@@) $ 6207 - عثمان بن حامد، روى عنه الكشي.(@)PageV00P433(@)(@@)(@)(@@)(@@)(@@) $ 6208 - علي بن داود الحداد، روى عن حريز بن عبد الله، روى عنه إسحاق ابن محمد.(@)(@@)(@)(@@)(@@)(@@) $ 6209 - علي بن الحسين الموسوي، يكنى أبا القاسم، الملقب بالمرتضى، ذي المجدين علم الهدي أدام الله تعالى أيامه، أكثر أهل زمانه أدبا وفضلا، متكلم فقيه جامع للعلوم كلها مد الله في عمره، يروي عن التلعكبري والحسين بن 
ms180	 علي بن بابويه وغيرهم من شيوخنا، له تصانيف كثيره ذكرنا بعضها في الفهرست، وسمعنا منه أكثر كتبه وقرأناها عليه.(@)(@@)(@)(@@)(@@)(@@) $ 6210 - علي بن مالك، روى عنه ابن همام دعاء الصحيفة.(@)(@@)(@)(@@)(@@)(@@) $ 6211 - علي بن أحمد الكوفي، أبو القاسم، مخمس. 1(@)(@@)(@@)(@@) $ 6212 - علي بن زيدويه، نهاوندي، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6213 - علي بن إسحاق بن سعد الأشعري، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6214 - علي بن محمد بن الأشعث، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6215 - علي بن بلال المهلبي، روى عنه ابن حاشر.(@)(@@)(@)(@@)(@@)(@@) $ 6216 - علي بن محمد بن رباح النحوي، روى عنه ابن همام.(@)(@@)(@)(@@)(@@)(@@) $ 6217 - علي بن أحمد العقيقي، روى عنه ابن أخ طاهر، مخلط.(@)(@@)(@)(@@)(@@)(@@) $ 6218 - عبد الله بن أبي زيد الأنباري، روى عنه ابن حاشر، ضعيف.(@)(@@)(@)(@@)(@@)(@@) $ 6219 - عبد الملك بن منذر، بصري، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6220 - عمر بن عبد العزيز، الملقب بزحل، روى عنه أحمد بن محمد بن عيسى و البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6221 - عيسى بن مهران، روى ابن همام عن أحمد بن محمد بن موسى النوفلي عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6222 - العباس بن عامر القصباني، روى عنه أيوب بن نوح.(@)PageV00P434(@)(@@)(@)(@@)(@@)(@@) $ 6223 - عبد العزيز بن المهتدي، جد محمد بن الحسين، روى عنه أحمد بن محمد بن عيسى والبرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6224 - عبد العزيز بن يحيى الجلودي، أبو أحمد، بصري، ثقة.(@)(@@)(@)(@@)(@@)(@@) $ 6225 - عبيس بن هشام الناشري، روى عنه محمد بن الحسين والحسن بن علي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 6226 - عبد الجبار، من أهل نهاوند، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6227 - عبد الباقي بن قانع، روى عنه الدوري.(@)(@@)(@)(@@)(@@)(@@) $ 6228 - عبد الغفار الجازي. 1(@)(@@)(@@)(@@) $ 6229 - عامر بن جذاعة، روى حميد عن إبراهيم بن سليمان الخزاز عنهما. 2(@)(@@)(@@)(@@) $ 6230 - عون بن جرير، صاحب عمرو بن هارون، روى عنه أحمد بن أبي عبد الله، [عن أبيه]. 3(@)(@@)(@@)(@@) || باب الغين(@)(@@)(@@)(@@) $ 6231 - غالب بن عثمان، روى عنه الحسن بن علي بن فضال.(@)(@@)(@)(@@)(@@)(@@) $ 6232 - غياث بن إبراهيم، روى محمد بن يحيى الخزاز عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6233 - غياث بن كلوب بن فيهس البجلي، روى عنه الصفار.(@)(@@)(@@)(@@) || باب الفاء(@)(@@)(@@)(@@) $ 6234 - الفضل بن عامر، روى عنه سعد بن عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6235 - الفضل وإبراهيم 