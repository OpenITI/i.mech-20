ms4283	 ج 5، ح 1583.(@)(@@) * وروى عن محمد بن علي بن الشجاع النيسابوري، وروى عنه أحمد ابن محمد.(@)(@@) التهذيب: ج 4، ح 39، (الإستبصار:(@)(@@) ج 2، ح 48). PageV13P359(@)(@@) * وروى عن محمد بن الفضيل.(@)(@@) الفقيه: ج 2، ح 1297.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 38، ح 9.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 3، ب 38، ح 9.(@)(@@) والتهذيب: ج 1، ح 961.(@)(@@) * وروى عن محمد بن القاسم بن الفضيل.(@)(@@) الفقيه: ج 2، ح 1560.(@)(@@) * وروى عن محمد بن يحيى.(@)(@@) التهذيب: ج 4، ح 558.(@)(@@) وروى عنه عبد الله بن عامر.(@)(@@) الكافي: ج 3، ك 1، ب 17، ح 8، و ك 4، ب 75، ح 6.(@)(@@) * وروى عن محمد بن يحيى الخزاز.(@)(@@) التهذيب: ج 3، ح 25.(@)(@@) * وروى عن مخلد بن موسى، وروى عنه العباس بن معروف.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 54.(@)(@@) * وروى عن موسى بن القاسم، وروى عنه الحسن بن علي الكوفي.(@)(@@) الكافي: ج 4، ك 3، ب 71، ح 2.(@)(@@) والتهذيب: ج 5، ح 1573.(@)(@@) * وروى عن النضر بن سويد.(@)(@@) التهذيب: ج 2، ح 1185، و 1521.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 1، ب 192، ح 9.(@)(@@) وروى عنه الحسين بن إسحاق.(@)(@@) الكافي: ج 2، ك 1، ب 192، ح 9، و ج 5، ك 1، ب 28، ح 8.(@)(@@) وروى عنه عبد الله بن عامر.(@)(@@) الكافي: ج 3، ك 4، ب 23، ح 1، و ب 59، ح 3، و ب 75، ح 1. والتهذيب: ج 3، ح 24.(@)(@@) * وروى عن يحيى بن أبي عمران الهمداني، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 4، ب 21، ح 2.(@)(@@) * وروى باسناد له عن أبي عبد الله عليه السلام، وروى عنه عيسى بن محمد.(@)(@@) التهذيب: ج 3، ح 704.(@)(@@) * وروى باسناده عن صفوان الجمال، وروى عنه أبو داود.(@)(@@) الكافي: ج 3، ك 4، ب 21، ح 13.(@)(@@) * وروى عن بعض أصحابنا، عن أبي الحسن عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 7، ك 1، ب 37، ح 8.(@)(@@) * وروى عن بعض أصحابنا، عن PageV13P360(@)(@@) إسماعيل بن جابر.(@)(@@) التهذيب: ج 2، ح 1117.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 3، ك 4، ب 18، ح 25.(@)(@@) * وروى عن رجل عن الرضا عليه السلام، وروى عنه محمد بن عبد الجبار.(@)(@@) التهذيب: ج 2، ح 808 (الإستبصار:(@)(@@) ج 1، ح 1446).(@)(@@) * وروى عن رجل سأل الماضي عليه ا