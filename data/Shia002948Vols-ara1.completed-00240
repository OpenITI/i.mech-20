ms221	 أبي عبد الله وأبي الحسن عليهما السلام، كان ثقة في .(@)(@@) PageV02P245(@)(@@) حديثه، مسكونا إلى روايته، لا يعترض بشئ من الغمز، حسن الطريقة. له كتاب، روى عنه: أبو شعيب صالح بن خالد المحاملي، رجال النجاشي (1).(@)(@@) ثقة، له كتاب (2)، روى عنه: محمد بن أبي عمير وصفوان بن يحيى وابن فضال، الفهرست (3).(@)(@@)(@@)(@@) $ 1989 / 1 - رفيد بن مصقلة العبدي:(@)(@@) الكوفي، من أصحاب الباقر عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 1990 / 2 - رفيد مولى بني هبيرة (5):(@)(@@) روى عنه: أبو خالد القماط، من أصحاب الباقر (6) والصادق (7) عليهما السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 1991 / 1 - رفيع مولى بني سكون:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 1992 / 1 - رقيقة المحاربي:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (9).(@)(@@) .(@)(@@) PageV02P246(@)(@@)(@@)(@@) $ 1993 / 1 - رقيم بن الياس بن عمرو:(@)(@@) البجلي، كوفي، ثقة، روى هو وأبوه وأخواه يعقوب وعمرو عن الصادق عليه السلام وهو خال الحسن بن علي بن بنت الياس (1). له كتاب، روى عنه: علي بن الحسن الطاطري، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 1994 / 2 - رقيم بن عبد الرحمن الأزدي:(@)(@@) أبو محمد الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 1995 / 3 - رقيم بن عبد الله الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 1996 / 1 - ركان اللحام:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 1997 / 1 - ركين بن الربيع:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 1998 / 2 - ركين بن سويد الكلابي:(@)(@@) الجعفي، مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@) .(@)(@@) PageV02P247(@)(@@)(@@)(@@) $ 1999 / 1 - رميث بن عمرو:(@)(@@) من أصحاب الحسين عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2000 / 1 - رميلة:(@)(@@) سيجئ في باب الزاي بعنوان: زميلة (2).(@)(@@)(@@)(@@) $ 2001 / 1 - روح بن السائب اليشكري:(@)(@@) مولاهم، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2002 / 2 - روح بن عبد الرحيم (4):(@)(@@) شريك المعلى بن خنيس، كوفي، ثقة، (روى عن أبي عبد الله عليه السلام (5). له كتاب، روى عنه: غالب بن عثمان، رجال النجاشي (6).(@)(@@)(@@)(@@) $ 2203 / 3 - روح بن القاسم:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2004 / 1 - رومي بن زرارة بن أعين:(@)(@@) الشيباني (8)، روى عن 
ms222	 أبي عبد الله وأبي الحسن عليهما السلام، ثقة، قليل الحديث. له كتاب، روى عنه: محمد بن بكر بياع القطن، رجال النجاشي (9).(@)(@@) .(@)(@@) PageV02P248(@)(@@)(@@)(@@) $ 2205 / 1 - رهم الأنصاري:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (1).(@)(@@) وقال الكشي: قال حمدويه: حدثنا محمد بن عيسى، عن الحسن بن علي بن يقطين، عن رهم، قال أبو الحسن حمدويه: فسألته عنه، فقال:(@)(@@) شيخ من الأنصار كان يقول بقولنا (2).(@)(@@)(@@)(@@) $ 2006 / 1 - الرياش بن عدي الطائي:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2207 / 1 - الريان بن شبيب:(@)(@@) خال المعتصم، ثقة، سكن قم وروى (4) عنه أهلها، وجمع مسائل الصباح بن نصر الهندي للرضا عليه السلام، روى عنه: يحيى بن زكريا اللؤلؤي، رجال النجاشي (5).(@)(@@)(@@)(@@) $ 2008 / 2 - الريان بن الصلت الأشعري:(@)(@@) أبو علي، روى عن الرضا عليه السلام، كان ثقة، صدوقا، ذكر أن له كتابا جمع فيه كلام الرضا عليه السلام في الفرق بين الآل والأمة، قال أبو عبد الله (6) الحسين بن عبيد الله رحمه الله: أخبرنا (7) أحمد بن محمد بن يحيى، قال: حدثنا عبد الله بن جعفر، عن الريان بن الصلت به، وقال: رأيت في نسخة أخرى:(@)(@@) .(@)(@@) PageV02P249(@)(@@) الريان بن شبيب، رجال النجاشي (1).(@)(@@) له كتاب (2)، روى علي بن إبراهيم عن أبيه، عنه، الفهرست (3).(@)(@@) بغدادي، ثقة، خراساني، من أصحاب الرضا (4) والهادي (5) عليهما السلام، رجال الشيخ. ثم قال: الريان بن الصلت، روى عنه: إبراهيم بن هاشم، في من لم يرو عن الأئمة عليهم السلام (6). وهذا مناف لذكره في باب أصحاب الرضا والهادي عليهما السلام على ما قال في أول كتابه قدس سره، ومثل هذا كثير في كتابه كما سيجئ عند ترجمة: القاسم بن محمد الجوهري (7).(@)(@@) .(@)(@@) PageV02P250(@)(@@)(@@)(@@) | باب الزاي(@)(@@)(@@)(@@) $ 2009 / 1 - زاذان:(@)(@@) يكنى أبا عمرة الفارسي (1)، من أصحاب علي عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2010 / 1 - زافر بن سليمان الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2011 / 2 - زافر بن عبد الله الأيادي:(@)(@@) من رجال الصادق عليه السلام، عامي، الخلاصة (4). وكذا في رجال ابن داود، إلا أنه ذكر في موضع الأيادي: الأنباري (5)، وهو سهو.(@)(@@)(@@)(@@) $ 2012 
ms223	 / 1 - زاهر الأسلمي:(@)(@@) والد نجراة (6)، من أصحاب الشجرة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2013 / 2 - زاهر بن الأسود الطائي:(@)(@@) أبو عمارة الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) .(@)(@@) PageV02P251(@)(@@)(@@)(@@) $ 2014 / 3 - زاهر صاحب عمرو بن الحمق:(@)(@@) من أصحاب الحسين عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2015 / 1 - زائدة بن عمرو الهمداني:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2016 / 2 - زائدة بن قدامة:(@)(@@) من أصحاب الباقر عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2017 / 3 - زائدة بن موسى الكندي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2018 / 1 - الزبرقان البصري:(@)(@@) يكنى أبا محمد، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2019 / 1 - الزبير بن بكار:(@)(@@) تقدم مع أبيه (6).(@)(@@)(@@)(@@) $ 2020 / 2 - الزبير بن العوام:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2021 / 1 - زحر بن زياد:(@)(@@) أبو الحصين الأسدي، الكوفي، من أصحاب الصادق عليه السلام، رجال .(@)(@@) PageV02P252(@)(@@) الشيخ (1). ويمكن أن يكون هذا والذي سيجئ بعيد هذا واحدا.(@)(@@)(@@)(@@) $ 2022 / 2 - زحر بن عبد الله:(@)(@@) أبو الحصين الأسدي (2)، ثقة، روى عن أبي جعفر وأبي عبد الله عليهما السلام.(@)(@@) له كتاب، روى عنه: القاسم بن إسماعيل، رجال النجاشي (3).(@)(@@)(@@)(@@) $ 2023 / 3 - زحر بن قيس:(@)(@@) من أصحاب علي عليه السلام، رسوله إلى جرير بن عبد الله إلى الري، رجال الشيخ (4). وفي نسخة: زهير.(@)(@@)(@@)(@@) $ 2024 / 4 - زحر بن مالك:(@)(@@) أبو زياد الغنوي، مولاهم، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2025 / 5 - زحر بن النعمان الأسدي:(@)(@@) أبو الخطاب، مولى، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@) ووثقه ابن داود لا غير (7).(@)(@@)(@@)(@@) $ 2026 / 1 - زر بن حبيش:(@)(@@) وكان فاضلا، من أصحاب علي عليه السلام، رجال الشيخ (8).(@)(@@) .(@)(@@) PageV02P253(@)(@@) وفي الخلاصة: حبيس - بضم الحاء المهملة وفتح الباء المنقطة تحتها نقطة وبعد الياء المنقطة تحتها نقطتين سين مهملة (1).(@)(@@) وفي رجال ابن داود - بالشين المعجمة - وقال: ومن أصحابنا من صحفه، فقال: - بالسين المهملة - وهو وهم (2)، انتهى. وهذا دعوى بلا دليل.(@)(@@)(@@)(@@) $ 2027 / 1 - زرارة بن أعين بن سنسن:(@)(@@) مولى لبني 
ms224	 عبد الله بن عمرو السمين، أبو الحسن، شيخ أصحابنا في زمانه ومتقدمهم، كان قارئا فقيها متكلما شاعرا أديبا، قد اجتمعت (فيه) (3) خلال الفضل والدين، صادقا فيما يرويه، قال أبو جعفر محمد بن علي بن الحسين بن بابويه رحمه الله: رأيت له كتابا في الاستطاعة والجبر. روى ابن أبي عمير عن بعض أصحابه عنه، مات سنة خمسين ومائة (4)، رجال النجاشي (5).(@)(@@) اسمه عبد ربه، يكنى أبا الحسن، وزرارة لقب به، وكان أعين بن سنسن عبدا روميا لرجل من بني شيبان يعلم (6) القرآن، ثم أعتقه، فعرض أن يدخله في نسبه، فأبى أعين ذلك، وقال: أقرني على ولأي، وكان سنسن راهبا في بلد الروم. وزرارة يكنى أبا علي أيضا، وله عدة أولاد، منهم: الحسن والحسين ورومي وعبيد الله (7) - وكان أحول - وعبد الله ويحيى .(@)(@@) PageV02P254(@)(@@) بنو زرارة، ولزرارة أخوة، جماعة منهم: جمران وكان نحويا، وبكير بن أعين وعبد الرحمن و عبد الملك، ولزرارة مصنفات (1)، الفهرست (2).(@)(@@) ثقة. من أصحاب الباقر (3) والصادق (4) والكاظم (5) عليهم السلام، رجال الشيخ.(@)(@@) وقال الكشي: حدثني حمدويه بن نصير قال: حدثنا يعقوب بن يزيد، عن محمد بن أبي عمير، عن جميل بن دراج، قال: سمعت الصادق عليه السلام يقول: بشر المخبتين بالجنة بريد بن معاوية العجلي، وأبو بصير ليث بن البختري المرادي، ومحمد بن مسلم، وزرارة، أربعة نجباء امناء الله على حلاله وحرامه، لولا هؤلاء انقطعت آثار النبوة واندرست (6).(@)(@@) ثم قال الكشي: أجمعت العصابة على تصديق هؤلاء الأولين من أصحاب الباقر والصادق عليهما السلام، وانقادوا لهم بالفقه، فقال: أفقه الأولين ستة زرارة، ومعروف بن خربوذ، وبريد بن معاوية، وأبو بصير الأسدي، والفضيل بن يسار، ومحمد بن مسلم الطائفي، وأفقه الستة زرارة، وقال بعضهم مكان أبو بصير الأسدي: أبو بصير المرادي وهو ليث بن البختري (7). وذكر الكشي أيضا روايات كثيرة تدل على عظم شأنه وجلالة قدره (8)، وذكر .(@)(@@) PageV02P255(@)(@@) أحاديث تدل على ذمة أيضا (1)، وفي طريقها ضعف.(@)(@@) وقال الشهيد الثاني،: فقد ظهر (2) اشتراك جميع الأخبار القادحة في استنادها إلى محمد بن عيسى - وهو قرينة عظيمة - على ميل 
ms225	 وانحراف منه على زرارة، مضافا إلى ضعفه في نفسه، وقد قال السيد جمال الدين بن طاووس ونعم ما قال: ولقد أكثر محمد بن عيسى من القول في زرارة، حتى لو كان بمقام عدالة كادت الظنون تسرع إليه بالتهمة، فكيف وهو مقدوح فيه (3).(@)(@@) وقال العلامة قدس سره في الخلاصة: ذكر الكشي أحاديث تدل على عدالته، وعارضت تلك الأحاديث أخبار اخر تدل على القدح فيه، وقد ذكرنا في كتابنا الكبير وجه الخلاص عنها (4)، والرجل عندي مقبول .(@)(@@) PageV02P256(@)(@@) الرواية (1).(@)(@@)(@@)(@@) $ 2028 / 2 - زرارة بن لطيفة:(@)(@@) أبو عامر الحضرمي، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2029 / 1 - زرعة بن حميد الحارثي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2300 / 2 - زرعة بن محمد:(@)(@@) أبو محمد الحضرمي، ثقة، روى عن أبي عبد الله وأبي الحسن عليهما السلام، كان صحب سماعة وأكثر عنه، ووقف.(@)(@@) له كتاب (4)، روى عنه: يعقوب بن يزيد، رجال النجاشي (5).(@)(@@) .(@)(@@) PageV02P257(@)(@@) واقفي، من أصحاب الصادق (1) والكاظم (2) عليهما السلام، رجال الشيخ. ثم ذكره في باب من لم يرو عن الأئمة عليهم السلام أيضا (3).(@)(@@) وقال في الفهرست: واقفي المذهب، له أصل (4)، روى عنه: الحسن ابن محمد الحضرمي والحسن بن سعيد (5).(@)(@@) وما ذكره العلامة قدس سره في الخلاصة عند ذكر الحسن بن سعيد بعنوان:(@)(@@) زرعة بن مهران (6)، محمول على السهو.(@)(@@) وقال أبو عمرو الكشي: سمعت حمدويه، قال: زرعة بن محمد الحضرمي، واقفي. ثم قال الكشي: حدثني علي بن محمد بن قتيبة، قال:(@)(@@) حدثنا الفضل، قال: حدثنا محمد بن الحسن الواسطي ومحمد بن يونس، قالا: حدثنا الحسن بن قياما الصيرفي، قال: سألت أبا الحسن الرضا عليه السلام، فقلت: جعلت فداك ما فعل أبوك؟ قال: مضى كما مضى آباؤه عليهم السلام، قلت: فكيف أصنع بحديث حدثني به زرعة بن محمد الحضرمي، عن سماعة بن مهران: إن أبا عبد الله عليه السلام قال: إن ابني فيه شبه من خمسة أنبياء، يحسد كما حسد يوسف، ويغيب كما غاب يونس، وذكر ثلاثة .(@)(@@) PageV02P258(@)(@@) اخر، قال: كذب زرعة، ليس هكذا حديث سماعة، إنما 
ms226	 قال: صاحب هذا الأمر - يعني القائم عليه السلام - فيه شبه من خمسة أنبياء، ولم يقل ابني (1).(@)(@@)(@@)(@@) $ 2031 / 1 - زريق بن الزبير:(@)(@@) قد مضى في باب الراء (2) (3).(@)(@@)(@@)(@@) $ 2032 / 2 - زريق بن مرزوق (4):(@)(@@) تقدم في باب الراء (5) (6).(@)(@@)(@@)(@@) $ 2033 / 1 - زفر بن سويد الجعفي:(@)(@@) مولاهم، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2034 / 2 - زفر بن النعمان:(@)(@@) أبو الأزهر العجلي، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2035 / 3 - زفر بن الهذيل:(@)(@@) أبو الهذيل التميمي، العنبري (9)، من أصحاب الصادق عليه السلام، رجال .(@)(@@) PageV02P259(@)(@@) الشيخ (1) ونقل ابن داود عن البرقي أنه: عامي (2).(@)(@@) وقال العلامة قدس سره: زفر من أصحاب الصادق عليه السلام، عامي (3).(@)(@@)(@@)(@@) $ 2036 / 1 - زكار بن الحسن الدينوري:(@)(@@) شيخ من أصحابنا، ثقة، له كتاب، روى عنه: الحسن بن علي بن الحسين الدينوري، رجال النجاشي (4).(@)(@@)(@@)(@@) $ 2037 / 2 - زكار بن سلمة الهمداني:(@)(@@) مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2038 / 3 - زكار بن مالك الكوفي:(@)(@@) أبو عبد الله، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2039 / 4 - زكار بن يحيى الواسطي:(@)(@@) له كتاب الفضائل، وله أصل (7)، روى عنه: الحسن بن علي بن الحسين (8) الدينوري والقاسم بن إسماعيل، الفهرست (9).(@)(@@) .(@)(@@) PageV02P260(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (1)، ويحتمل أن يكون هذا هو الذي سيجئ بعنوان: زكريا بن يحيى الواسطي (2).(@)(@@)(@@)(@@) $ 2040 / 1 - زكريا بن آدم (3) بن عبد الله:(@)(@@) ابن سعد الأشعري القمي، ثقة جليل، عظيم القدر، وكان له وجه عند الرضا عليه السلام. له كتاب، روى عنه: محمد بن خالد، وكتاب مسائله للرضا عليه السلام روى عنه: محمد بن الحسن بن أبي خالد، رجال النجاشي (4).(@)(@@) من أصحاب الصادق (5) والرضا (6) والجواد (7) عليهم السلام، رجال الشيخ.(@)(@@) وقال الكشي: حدثني محمد بن قولويه، قال: حدثنا سعد بن عبد الله ابن أبي خلف، عن محمد بن حمزة، عن زكريا بن آدم، قال: قلت للرضا عليه السلام: إني أريد الخروج عن (8) أهل بيتي، وقد كثر السفهاء فيهم، فقال له: لا تفعل فإن الله تعالى يدفع بك عنهم كما يدفع من أهل 
ms227	 بغداد بأبي الحسن عليه السلام (9).(@)(@@) .(@)(@@) PageV02P261(@)(@@) ثم قال الكشي: عنه، عن سعد بن عبد الله، عن محمد بن عيسى، عن أحمد بن الوليد، عن علي بن المسيب، قال: قلت للرضا عليه السلام: شقتي بعيدة، فلست أصل إليك في كل وقت، فممن اخذ معالم ديني؟ قال: من زكريا بن آدم القمي، المأمون على الدين والدنيا (1).(@)(@@) وحج الرضا عليه السلام سنة من المدينة وكان زكريا بن آدم زميله إلى مكة (2).(@)(@@)(@@)(@@) $ 2041 / 2 - زكريا بن إبراهيم (3) الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (4) (5).(@)(@@)(@@)(@@) $ 2042 / 3 - زكريا أبو يحيى (6):(@)(@@) كوكب الدم، الموصلي، من أصحاب الصادق (7) والكاظم (8) والرضا (9) عليهم السلام، رجال الشيخ.(@)(@@) وقال الكشي: قال حمدويه، عن العبيدي، عن يونس، قال: أبو يحيى .(@)(@@) PageV02P262(@)(@@) الموصلي، كوكب الدم، كان شيخا من الأخبار. وقال العبيدي: أخبرني الحسن بن علي بن يقطين: إنه كان يعرفه أيام أبيه، له فضل ودين (1).(@)(@@) وقال ابن الغضائري: زكريا، أبو يحيى، كوكب الدم، كوفي، ضعيف، روى عن أبي عبد الله عليه السلام (2)، انتهى.(@)(@@) والظاهر أن ما ذكره الشيخ في الرجال والكشي وابن الغضائري واحد، وإن كان يظهر من كلام العلامة قدس سره في الخلاصة أنه رجلان (3). وما ذكره ابن داود من أنه وثقه الكشي وغيره (4)، ليس بمستقيم (5).(@)(@@)(@@)(@@) $ 2043 / 4 - زكريا بن أبي طلحة (6) الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2044 / 5 - زكريا بن إدريس (8) بن عبد الله:(@)(@@) ابن سعيد (9) الأشعري القمي (10)، أبو جرير، قيل: إنه روى عن الصادق(@)(@@) PageV02P263(@)(@@) والكاظم والرضا عليهم السلام، له كتاب، قال ذلك سعد. وقال ابن عقدة: أبو جرير القمي، روى عن أبي عبد الله عليه السلام، روى عنه: محمد بن خالد، رجال النجاشي (1).(@)(@@) كان وجها، الخلاصة (2) (3). والظاهر أنه أخذه من كلام النجاشي عند ذكر أبيه إدريس، حيث قال: إدريس بن عبد الله بن سعد الأشعري، ثقة، له كتاب، وأبو جرير القمي هو زكريا بن إدريس هذا، وكان وجها، له كتاب، روى عنه: محمد بن الحسن بن أبي خالد (4).(@)(@@)(@@)(@@) $ 2045 / 6 - زكريا بن إسحاق المكي:(@)(@@) من أصحاب الصادق عليه 
ms228	 السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2046 / 7 - زكريا بن الحر الجعفي (6):(@)(@@) أخو أديم وأيوب، روى عن أبي عبد الله عليه السلام. له كتاب، روى عنه:(@)(@@) محمد بن موسى، رجال النجاشي (7).(@)(@@) روى عنه: محمد بن موسى خوراء، في من لم يرو عنه الأئمة عليهم السلام، رجال الشيخ (8).(@)(@@) .(@)(@@) PageV02P264(@)(@@)(@@)(@@) $ 2047 / 8 - زكريا بن الحسن الواسطي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2048 / 9 - زكريا بن سابق:(@)(@@) روى الكشي، عن جعفر وفضالة، عن أبي الصباح، عن زكريا بن سابق، قال: وصفت الأئمة لأبي عبد الله عليه السلام حتى انتهيت إلى أبي (2) جعفر [عليه السلام]، فقال: حسبك، قد ثبت الله لسانك وهدى قلبك (3).(@)(@@) وفي الخلاصة، في موضع أبي الصباح: ابن الصباح، ثم قال: وفي ابن الصباح طعن، فالوقف متوجه على هذه الرواية، ولم يثبت عندي عدالة المشار إليه (4). وكأنه اشتبه على العلامة قدس سره.(@)(@@)(@@)(@@) $ 2049 / 10 - زكريا بن سابور الواسطي (5):(@)(@@) وثقه النجاشي عند ترجمة أخيه بسطام (6).(@)(@@)(@@)(@@) $ 2050 / 11 - زكريا بن سوادة:(@)(@@) أبو يحيى البارقي (7)، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2051 / 12 - زكريا بن شيبان:(@)(@@) روى الحديث عن الحسين بن أبي العلاء ومحمد بن حمران وكليب .(@)(@@) PageV02P265(@)(@@) ابن معاوية وصفوان بن يحيى، وروى عنه: ابنه يحيى بن زكريا، رجال النجاشي عند يحيى بن زكريا بن شيبان (1).(@)(@@)(@@)(@@) $ 2052 / 13 - زكريا بن عبد الصمد القمي:(@)(@@) يكنى أبا جرير، ثقة، من أصحاب الكاظم (2) والرضا (3) عليهما السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 2053 / 14 - زكريا بن عبد الله الفياض:(@)(@@) أبو يحيى، الذي روى عن الصادق والكاظم عليهما السلام، قال ابن نوح:(@)(@@) وروى عن أبي جعفر عليه السلام (4)، وروى عنه: أبو جعفر الأحول والفضيل. له كتاب (5)، روى عنه: عمرو بن خالد، رجال النجاشي (6).(@)(@@) وفي رجال الشيخ: النقاص (7) الكوفي، من أصحاب الصادق عليه السلام (8) (9).(@)(@@) .(@)(@@) PageV02P266(@)(@@)(@@)(@@) $ 2054 / 15 - زكريا بن مالك (1) الجعفي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2055 / 16 - زكريا بن محمد (3):(@)(@@) أبو عبد الله المؤمن، روى عن أبي عبد الله وأبي الحسن موسى عليهما السلام، ولقى الرضا عليه السلام في المسجد الحرام، وحكي 
ms229	 عنه ما يدل على أنه كان واقفا، وكان مختلط الأمر في حديثه، وله كتاب منتحل الحديث، روى عنه: محمد بن عيسى بن عبيد، رجال النجاشي (4).(@)(@@)(@@)(@@) $ 2056 / 17 - زكريا بن ميسرة الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2057 / 18 - زكريا بن ميمون الأزدي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 2058 / 19 - زكريا بن يحيى التميمي:(@)(@@) كوفي ثقة، له كتاب، روى عنه إبراهيم بن سليمان، رجال(@)(@@) PageV02P267(@)(@@) النجاشي (1)(@)(@@)(@@)(@@) $ 2059 / 20 - زكريا بن يحيى الحضرمي:(@)(@@) الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2060 / 21 - زكريا بن يحيى الكلابي:(@)(@@) الجعفري، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2061 / 21 - زكريا بن يحيى النهدي:(@)(@@) مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2062 / 23 - زكريا بن يحيى الواسطي (5):(@)(@@) ثقة، روى عن أبي عبد الله عليه السلام، ذكره ابن نوح. له كتاب، روى عنه:(@)(@@) إبراهيم بن محمد بن إسماعيل، رجال النجاشي (6).(@)(@@)(@@)(@@) $ 2063 / 1 - زميلة:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (7).(@)(@@) ونقل ابن داود توثيقه من الكشي (8). ولم أجد توثيقه فيه.(@)(@@) وذكره العلامة قدس سره في الخلاصة في باب الراء (9).(@)(@@) .(@)(@@) PageV02P268(@)(@@)(@@)(@@) $ 2064 / 1 - زواد الكوفي من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2065 / 1 - زويد الفساطيطي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 2066 / 1 - زهرة بن حوية التميمي:(@)(@@) الكوفي، من أصحاب الصادق عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2067 / 1 - زهير بن عمرو:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2068 / 2 - زهير بن القين:(@)(@@) من أصحاب الحسين عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2069 / 3 - زهير بن محمد الخراساني:(@)(@@) أبو المنذر، سكن البصرة (7)، من أصحاب الصادق عليه السلام. رجال الشيخ (8).(@)(@@) له كتاب، روى عنه: ابن عياش القطان، الفهرست (9).(@)(@@) .(@)(@@) PageV02P269(@)(@@)(@@)(@@) $ 2070 / 4 - زهير المدائني:(@)(@@) روى عنه: حماد بن عثمان، من أصحاب الباقر (1) والصادق (2) عليه السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 2071 / 5 - زهير بن معاوية:(@)(@@) أبو خيثمة الجعفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2072 / 1 - زياد بن أبي إسماعيل:(@)(@@) الكوفي، شريك 
ms230	 ابن (4) حفص الأعور، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2073 / 2 - زياد بن أبي الجعد:(@)(@@) سيجئ بعنوان: زياد بن الجعد (6) (7).(@)(@@)(@@)(@@) $ 2074 / 3 - زياد بن أبي الحلال:(@)(@@) كوفي (8)، ثقة، روى عن أبي عبد الله عليه السلام. له كتاب (9)، روى عنه:(@)(@@) محمد بن الوليد، رجال النجاشي (10).(@)(@@) .(@)(@@) PageV02P270(@)(@@) من أصحاب الباقر (1) والصادق (2) عليهما السلام، رجال الشيخ له كتاب (3)، روى عنه: القاسم بن إسماعيل، الفهرست (4).(@)(@@)(@@)(@@) $ 2075 / 4 - زياد بن أبي رجاء (5):(@)(@@) من أصحاب الباقر (6) والصادق (7) عليهما السلام، رجال الشيخ.(@)(@@) وقال الكشي: قال محمد بن مسعود: سألت ابن فضال عن زياد بن أبي رجاء، فقال: ثقة (8). وسيجئ بعض أحواله عند ذكر: زياد بن عيسى الحذاء (9).(@)(@@)(@@)(@@) $ 2076 / 5 - زياد بن أبي زياد:(@)(@@) المنقري التميمي، من أصحاب الباقر عليه السلام، رجال الشيخ (10).(@)(@@)(@@)(@@) $ 2077 / 6 - زياد بن أبي غياث (11):(@)(@@) واسم أبي غياث: مسلم، مولى آل دغش من محارب بن خصفة، .(@)(@@) PageV02P271(@)(@@) روى عن أبي عبد الله عليه السلام، وذكر ابن عقدة وابن نوح. ثقة، سليم، له كتاب (1)، روى عنه: ثابت بن شريح الصائغ الأنباري، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 2078 / 7 - زياد بن أحمر العجلي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3) (4).(@)(@@)(@@)(@@) $ 2079 / 8 زياد بن الأسود النجار:(@)(@@) مجهول، من أصحاب الباقر عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2080 / 9 - زياد بن بياضة الأنصاري:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2081 / 10 - زياد بن الجعد:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (7). من خواصه، الخلاصة ورجال ابن داود (8).(@)(@@) وفي النجاشي عند ترجمة رافع بن سلمة: أن رافع بن سلمة بن زياد ابن أبي الجعد ثقة من بيت الثقات وعيونهم (9)، انتهى.(@)(@@) .(@)(@@) PageV02P272(@)(@@) وكان أباه أبو الجعد، كما يظهر من ذكر أخيه سالم بن أبي الجعد أيضا (1).(@)(@@)(@@)(@@) $ 2082 / 11 - زياد بن الحسن بن فرات:(@)(@@) التميمي القزاز (2)، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2083 / 12 - زياد بن الحسن الوشاء:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2084 / 13 - زياد بن الحصين التميمي (5):(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2085 / 14 - زياد بن حفص التميمي: 
ms231	(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2086 / 15 - زياد بن حمير الهمداني:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2087 / 16 - زياد بن خيثمة الجعفي:(@)(@@) الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (9).(@)(@@) .(@)(@@) PageV02P273(@)(@@)(@@)(@@) $ 2088 / 17 - زياد بن رستم (1):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2089 / 18 - زياد بن سابور الواسطي:(@)(@@) أبو الحسن، أخو بسطام، وثقه النجاشي عند ذكر أخيه بسطام (3)، فلاحظه.(@)(@@)(@@)(@@) $ 2090 / 19 - زياد بن سعد الخراساني (4):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2091 / 20 - زياد بن سليمان البلخي:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2092 / 21 - زياد بن سوقة (7):(@)(@@) وثقه النجاشي عند ترجمة أخيه: حفص (8).(@)(@@)(@@)(@@) $ 2093 / 22 - زياد بن سويد الهلالي (9):(@)(@@) مولاهم، من أصحاب الصادق عليه السلام، رجال الشيخ (10).(@)(@@) .(@)(@@) PageV02P274(@)(@@)(@@)(@@) $ 2094 / 23 - زياد بن صالح الهمداني:(@)(@@) الكوفي، من أصحاب الباقر عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2095 / 24 - زياد بن صدقة:(@)(@@) أبو مسكين الكوفي (2)، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2096 / 25 - زياد بن عبد الرحمن العنزي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2097 / 26 - زياد بن عبد الرحمن الهلالي:(@)(@@) مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2098 / 27 - زياد بن عبيد:(@)(@@) من أصحاب علي عليه السلام، عامله على البصرة، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 2099 / 28 - زياد بن عمارة الطائي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2100 / 29 - زياد بن عيسى:(@)(@@) أبو عبيدة الحذاء، كوفي، مولى (9)، ثقة، روى عن أبي جعفر وأبي .(@)(@@) PageV02P275(@)(@@) عبد الله عليهما السلام، وأخته: حمادة بنت رجاء، وقيل: بنت الحسن (1)، روت عن الصادق عليه السلام، قاله ابن نوح عن ابن سعيد، وقال الحسن بن علي بن فضال: ومن أصحاب أبي جعفر [عليه السلام] أبو عبيدة الحذاء واسمه: زياد، مات في حياة الصادق عليه السلام. وقال سعد بن عبد الله الأشعري: ومن أصحاب أبي جعفر عليه السلام أبو عبيدة وهو زياد بن أبي رجاء، كوفي، ثقة صحيح، واسم أبي رجاء: منذر، وقيل: زياد بن أحزم (2)، ولم يصح. وقال 
ms232	 العقيقي العلوي: أبو عبيدة، زياد الحذاء، وكان حسن المنزلة عند آل محمد عليهم السلام، وكان زامل أبا جعفر [عليه السلام] إلى مكة. له كتاب، يرويه: علي بن رئاب، رجال النجاشي (3).(@)(@@) زياد بن عيسى: أبو عبيدة الحذاء، وقيل: زياد بن رجاء، من أصحاب الباقر والصادق عليهما السلام، مات في حياة الصادق عليه السلام، رجال الشيخ (4).(@)(@@) ولا يخفى من التدافع بين كلام النجاشي هنا وكلام الشيخ في باب النساء من الرجال عند ذكر: حمادة بنت رجاء (5). وكأن ما في الرجال سهو.(@)(@@)(@@)(@@) $ 2101 / 30 - زياد بن عيسى الكوفي:(@)(@@) بياع السابري، من أصحاب الصادق عليه السلام، رجال الشيخ (6) (7).(@)(@@) .(@)(@@) PageV02P276(@)(@@)(@@)(@@) $ 2102 / 31 - زياد بن كعب بن مرحب:(@)(@@) من أصحاب علي عليه السلام، ينظر في أمره وما كان منه في أمر الحسين عليه السلام، وهو رسوله إلى الأشعث بن قيس إلى آذربايجان، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 2103 / 32 - زياد بن مروان (3):(@)(@@) أبو الفضل، وقيل: أبو عبد الله، الأنباري القندي، مولى بني هاشم، روى عن أبي عبد الله وأبي الحسن عليهما السلام، ووقف في الرضا عليه السلام. له كتاب (4)، روى عنه: محمد بن إسماعيل الزعفراني، رجال النجاشي (5).(@)(@@) واقفي، من أصحاب الصادق (6) (7) والكاظم (8) عليهم السلام، رجال الشيخ.(@)(@@) وروى الكشي، عن حمدويه، عن الحسن بن موسى، قال: زياد هو أحد أركان الوقف (9). وروى عن يونس بن عبد الرحمن - بطريق ضعيف - أنه قال: مات أبو الحسن عليه السلام وليس عنده من أقوامه (10) أحد إلا وعنده .(@)(@@) PageV02P277(@)(@@) الكمال الكثير، وكان ذلك سبب وقفهم وجحدهم موته، وكان عند زياد القندي سبعون ألف دينار (1).(@)(@@) وقال المفيد في إرشاده: إنه من خاصة الكاظم عليه السلام، وثقاته وأهل الورع والعلم والفقه من شيعته، وممن روى النص على الرضا عليه السلام (2).(@)(@@)(@@)(@@) $ 2104 / 33 - زياد بن مسلم:(@)(@@) أبو عتاب الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@) والظاهر أن هذا والذي ذكرناه بعنوان: زياد بن أبي غياث (4)، واحد.(@)(@@) إلا أنه يظهر من كلام الشيخ قدس سره في هذا المقام، وفي التهذيب في باب المواقيت من الزيادات وغيره، أن أبا عتاب كنية 
ms233	 لزياد (5)، ويظهر من كلام النجاشي والعلامة أن أبا عتاب كنية لمسلم (6).(@)(@@)(@@)(@@) $ 2105 / 34 - زياد بن المنذر:(@)(@@) ذكرناه بعنوان: زياد بن أبي رجاء (7).(@)(@@)(@@)(@@) $ 2106 / 35 - زياد بن المنذر:(@)(@@) أبو الجارود الهمداني الخارقي (8)، الأعمى، كوفي، من أصحاب أبي .(@)(@@) PageV02P278(@)(@@) جعفر عليه السلام، وروى عن الصادق عليه السلام، وتغير لما خرج زيد رضي الله عنه. له كتاب، روى عنه: أبو سهل كثير بن عياش القطان، رجال النجاشي (1).(@)(@@) زيدي المذهب، وإليه تنسب الجارودية (2). له أصل، وله كتاب التفسير عن الباقر عليه السلام (3)، الفهرست (4).(@)(@@) حديثه في حديث أصحابنا أكثر منه في الزيدية (5)، وأصحابنا يكرهون ما رواه محمد بن سنان عنه، ويعتمدون ما رواه محمد بن بكر الأرجني، رجال ابن الغضائري (6).(@)(@@) الأعمى السرحوب، نسب إليه السرحوبيه من الزيدية، وسماه بذلك .(@)(@@) PageV02P279(@)(@@) الباقر عليه السلام. وذكر إن سرحوبا أسم شيطان أعمى يسكن البحر، رجال الكشي (1). ثم فيه رواية تدل على كذبه وكفره (2).(@)(@@)(@@)(@@) $ 2107 / 36 - زياد بن موسى الأسدي:(@)(@@) مولاهم الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3) (4).(@)(@@)(@@)(@@) $ 2108 / 37 - زياد بن النضر الحارثي:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 2109 / 38 - زياد بن الهيثم الوشاء:(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2110 / 39 - زياد بن يحيى الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2111 / 1 - زيادة بن فضالة الكلبي:(@)(@@) مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 2112 / 1 - زيتون:(@)(@@) يكنى أبا محمد، قمي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (10).(@)(@@) .(@)(@@) PageV02P280(@)(@@)(@@)(@@) $ 2113 / 1 - زيد الآجري:(@)(@@) مجهول، من أصحاب الباقر عليه السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 2114 / 2 - زيد بن أبي الحلال:(@)(@@) المزني، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2115 / 3 - زيد بن أحمد الخلفي:(@)(@@) يزدكي، من أصحاب العياشي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2116 / 4 - زيد بن أرقم الأنصاري (5):(@)(@@) من أصحاب الرسول صلى الله عليه وسال (6) وعلي (7) والحسن (8) والحسين (9) عليهم السلام، رجال الشيخ.(@)(@@) وروى الكشي عن الفضل بن شاذان: أنه من السابقين الذين رجعوا إلى أمير المؤمنين 
ms234	 عليه السلام (10) (11).(@)(@@) .(@)(@@) PageV02P281(@)(@@)(@@)(@@) $ 2117 / 5 - زيد بن أسلم:(@)(@@) مولى عمر بن الخطاب، المدني العدوي، تابعي (1)، فيه نظر، من أصحاب علي بن الحسين (2) والصادق (3) عليهم السلام، رجال الشيخ.(@)(@@) وذكره ابن داود في البابين (4).(@)(@@)(@@)(@@) $ 2118 / 6 - زيد بن بكير بن الحسن:(@)(@@) الكوفي (5)، من أصحاب الصادق عليه السلام، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 2119 / 7 - زيد بن بيان الثعلبي:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2120 / 8 - زيد بن تبيع:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 2121 / 9 - زيد بن ثابت:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (10).(@)(@@) .(@)(@@) PageV02P282(@)(@@)(@@)(@@) $ 2122 / 10 - زيد بن جهيم الهلالي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 2123 / 11 - زيد بن حارثة:(@)(@@) وليس بأبي أسامة بن زيد، من أصحاب علي عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2124 / 12 - زيد بن الحسن الأنماطي (4):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 2125 / 13 - زيد بن الحسن بن علي:(@)(@@) ابن أبي طالب عليه السلام، أبو الحسن الهاشمي، من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2126 / 14 - زيد بن الحصين الأسلمي:(@)(@@) من المهاجرين، من أصحاب علي عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2127 / 15 - زيد بن خالد الجهني:(@)(@@) من أصحاب الرسول صلى الله عليه وآله (9) وعلي عليه السلام (10)، رجال الشيخ (11).(@)(@@) PageV02P283(@)(@@)(@@)(@@) $ 2128 / 16 - زيد بن ربيعة:(@)(@@) يكنى أبا معبد (1)، من أصحاب علي عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2129 / 17 - زيد الزراد:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@) له كتاب، روى عنه: ابن أبي عمير، رجال النجاشي (4).(@)(@@) زيد النرسي وزيد الزراد: لهما أصلان، لم يروهما محمد بن علي بن الحسين بن بابويه، وقال في فهرسته: لم يروهما محمد بن الحسن بن الوليد، وكان يقول: هما موضوعان، وكذلك كتاب خالد بن عبد الله بن سدير، وكان يقول: وضع هذه الأصول محمد بن موسى الهمداني، وكتاب زيد النرسي رواه: ابن أبي عمير، الفهرست (5).(@)(@@) وزيد الزراد - كوفي - وزيد النرسي رويا عن الصادق عليه السلام. قال أبو جعفر بن بابويه: إن كتابهما موضوع، وضعه محمد بن موسى السمان.(@)(@@) وغلط 
ms235	 أبو جعفر في هذا القول، فاني رأيت كتبهما (6) مسموعة من محمد ابن أبي عمير، رجال ابن الغضائري (7).(@)(@@) والذي قاله الشيخ - عن ابن بابويه وابن الغضائري (8) - لا يدل على .(@)(@@) PageV02P284(@)(@@) طعن في الرجلين، فإن كان توقف ففي رواية الكتابين، ولما لم أجد لأصحابنا تعديلا لهما ولا طعنا فيهما، توقفت عن قبول روايتهما، الخلاصة (1).(@)(@@) وذكرهما ابن داود في البابين (2).(@)(@@)(@@)(@@) $ 2130 / 18 - زيد بن سعيد الأسدي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (3) (4).(@)(@@)(@@)(@@) $ 2131 / 19 - زيد بن سوقة البجلي:(@)(@@) مولى حريز بن عبد الله، أبو الحسن الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2132 / 20 - زيد بن سويد الأنصاري:(@)(@@) الحارثي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2133 / 21 - زيد بن سهل:(@)(@@) أبو طلحة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2134 / 22 - زيد بن سيف القيسي:(@)(@@) البكري الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) .(@)(@@) PageV02P285(@)(@@)(@@)(@@) $ 2135 / 23 - زيد الشحام:(@)(@@) سيجئ بعنوان: زيد بن محمد بن يونس (1).(@)(@@)(@@)(@@) $ 2136 / 24 - زيد بن صالح الأسدي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2137 / 25 - زيد بن صوحان:(@)(@@) وكان من الأبدال، قتل يوم الجمل، وقيل: إن عائشة استرجعت حين قتل، من أصحاب علي عليه السلام، رجال الشيخ (3).(@)(@@) وروى الكشي: لما صرع زيد بن صوحان رحمه الله يوم الجمل، جاء أمير المؤمنين عليه السلام حتى جلس عند رأسه، فقال: رحمك الله يا زيد، قد كنت خفيف المؤنة، عظيم المعونة (4). ثم روى عن علي بن محمد بن قتيبة، عن الفضل بن شاذان: أنه من التابعين الكبار، ورؤسائهم وزهادهم (5).(@)(@@)(@@)(@@) $ 2138 / 26 - زيد بن عاصم بن المهاجر:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 2139 / 27 - زيد بن عبد الرحمن الأسدي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@) .(@)(@@) PageV02P286(@)(@@)(@@)(@@) $ 2140 / 28 - زيد بن عبد الله الخياط:(@)(@@) روى عنه: أبان، يكنى أبا حكيم، كوفي، جمحي، وأصله مدني، ثقة، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2141 / 29 - زيد بن عبيد الأزدي:(@)(@@) الغامدي، مولاهم، كوفي، من أصحاب الصادق عليه 
ms236	 السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2142 / 30 - زيد بن عطاء بن السائب:(@)(@@) الثقفي، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2143 / 31 - زيد بن عطية السلمي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4) (5).(@)(@@)(@@)(@@) $ 2144 / 32 - زيد بن علي بن الحسين:(@)(@@) ابن علي بن أبي طالب عليهم السلام، أبو الحسين، مدني، تابعي، قتل سنة إحدى وعشرين ومائة، وله اثنان وأربعون سنة، من أصحاب علي بن الحسين (6) والباقر (7) والصادق (8) عليهم السلام، رجال الشيخ.(@)(@@) .(@)(@@) PageV02P287(@)(@@) وقال الكشي: حدثني نصر بن الصباح، قال: حدثنا إسحاق بن محمد البصري، قال: حدثني علي بن إسماعيل، قال: أخبرني فضيل الرسان، قال: دخلت على أبي عبد الله عليه السلام بعدما قتل زيد بن علي (1)، فأدخلت بيتا جوف بيت، فقال لي: يا فضيل قتل عمي زيد قلت: نعم، جعلت فداك. قال: رحمه الله، أما أنه كان مؤمنا، وكان عارفا، وكان عالما، وكان صدوقا، أما أنه لو ظفر لوفى، أما أنه لو ملك لعرف كيف يضعها (2)، انتهى.(@)(@@) وقوله: لو ظفر لوفى، أي: بتسليم السلطنة إليه، ويظهر منه أنه عهد إليه.(@)(@@) ثم قال الكشي: قال إبراهيم بن محمد بن العباس الختلي، قال:(@)(@@) حدثنا أحمد بن إدريس القمي، عن محمد بن أحمد بن يحيى، عن أحمد ابن محمد بن عيسى، عن ابن أبي عمير، عن عبد الرحمن بن سيابة (3)، قال: دفع إلي الصادق عليه السلام دنانير، وأمرني أن اقسمها في عيالات من أصيب مع عمه زيد، قال: فقسمتها، فأصاب عيال عبد الله بن الزبير الرسان أربعة دنانير (4).(@)(@@)(@@)(@@) $ 2145 / 33 - زيد بن علي بن الحسين:(@)(@@) ابن زيد، روى محمد بن علي، قال: أخبرني زيد بن علي بن الحسين بن زيد، فقال: مرضت، فدخل الطبيب علي ليلا، ووصف لي .(@)(@@) PageV02P288(@)(@@) دواء آخذه في السحر كذا وكذا يوما، فلم يمكني تحصيله من الليل، وخرج الطبيب من الباب، وورد صاحب أبي الحسن عليه السلام في الحال ومعه صرة فيها ذلك الدواء بعينه، فقال لي: أبو الحسن يقرئك السلام، ويقول:(@)(@@) خذ هذا الدواء كذا وكذا يوما، فأخذته فشربت فبرئت، 
ms237	 قال محمد بن علي: قال لي زيد بن علي: يا محمد، أين الغلاة عن هذا الحديث؟! كذا في إرشاد المفيد رحمه الله (1).(@)(@@)(@@)(@@) $ 2146 / 34 - زيد بن عياض الكناني:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 2147 / 35 - زيد بن محمد بن جعفر:(@)(@@) المعروف بابن أبي الياس الكوفي، روى عنه: التلعكبري (4).(@)(@@) له كتاب الفضائل، روى عنه: الحسن بن علي بن الحسن الدينوري العلوي، روى عن: علي بن الحسين بن بابويه، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2148 / 36 - زيد بن محمد بن عطاء:(@)(@@) ابن السائب الثقفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@) .(@)(@@) PageV02P289(@)(@@)(@@)(@@) $ 2149 / 37 - زيد بن محمد بن يونس:(@)(@@) أبو أسامة الشحام، الكوفي، من أصحاب الباقر عليه السلام، رجال الشيخ (1). ثم ذكره عند ذكر أصحاب الصادق عليه السلام، بعنوان: زيد بن يونس، أبو أسامة الشحام الكوفي (2).(@)(@@) وقال في الفهرست: زيد الشحام، يكنى أبا أسامة، ثقة، له كتاب (3)، روى عنه: أبو جميلة (4).(@)(@@) وقال النجاشي: زيد بن يونس، وقيل: ابن موسى، أبو أسامة الشحام، مولى شديد بن عبد الرحمن بن نعيم الأزدي الغامدي، كوفي، روى عن أبي عبد الله وأبي الحسن عليهما السلام. له كتاب (5)، روى عنه: صفوان بن يحيى (6).(@)(@@) وقال العلامة قدس سره في الخلاصة: إن زيد بن يونس - وقيل: ابن موسى، أبو أسامة الشحام - ثقة، عين (7).(@)(@@) وقال ابن داود: وقال بعض أصحابنا: وقيل: ابن موسى - وذاك غيره - واقفي (8)، انتهى.(@)(@@) قلت: لو سلم أنه غير ابن موسى الواقفي كيف نسلم أنه ليس ابن .(@)(@@) PageV02P290(@)(@@) موسى الذي غير الواقفي (1)؟(@)(@@)(@@)(@@) $ 2150 / 38 - زيد بن المستهل بن الكميت:(@)(@@) الأسدي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 2151 / 39 - زيد بن معقل:(@)(@@) من أصحاب الحسين عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 2152 / 40 - زيد بن موسى:(@)(@@) واقفي، من أصحاب الكاظم عليه السلام، رجال الشيخ (4) (5).(@)(@@)(@@)(@@) $ 2153 / 41 - زيد النرسي (6):(@)(@@) روى عن أبي عبد الله وأبي الحسن عليهما السلام. له كتاب (7)، روى عنه: ابن أبي عمير، رجال النجاشي (8). وذكرنا بعض أحواله عند 
ms238	 ترجمة: زيد الزراد (9).(@)(@@)(@@)(@@) $ 2154 / 42 - زيد بن وهب الجهني (10):(@)(@@) كوفي، من أصحاب علي عليه السلام، رجال الشيخ (11). له كتاب خطب أمير .(@)(@@) PageV02P291(@)(@@) المؤمنين عليه السلام على المنابر في الجمع والأعياد وغيرها (1) روى عنه: أبو منصور الجهني، الفهرست (2).(@)(@@)(@@)(@@) $ 2155 / 43 - زيد بن هاني السبيعي:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (3) (4).(@)(@@)(@@)(@@) $ 2156 / 44 - زيد بن يونس:(@)(@@) ذكرناه بعنوان: زيد بن محمد بن يونس (5).(@)(@@)(@@)(@@) $ 2157 / 1 - زين الدين بن علي بن أحمد:(@)(@@) ابن جمال الدين العاملي، المشتهر بالشهيد الثاني رحمه الله، وجه من وجوه هذه الطائفة وثقاتها، كثير الحفظ، نقي الكلام، له تلاميذ أجلاء، وله كتب نفيسة جيدة، منها: شرح شرائع المحقق الحلي قدس سره. قتل رحمه الله لأجل التشيع في قسطنطينية في سنة ست وستين وتسعمائة، رضي الله عنه وأرضاه.(@)(@@) .(@)(@@) PageV02P292(@)(@@)(@@)(@@) | باب السين(@)(@@)(@@)(@@) $ 2158 / 1 - سالم:(@)(@@) مجهول، من أصحاب الباقر عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 2159 / 2 - سالم بن أبي الجعد:(@)(@@) من أصحاب علي عليه السلام، رجال الشيخ (2) (3).(@)(@@) وفي آخر الباب الأول من الخلاصة: سالم وعبيدة وزياد - بنو الجعد الأشجعيون - من خواص أمير المؤمنين عليه السلام (4).(@)(@@)(@@)(@@) $ 2160 / 3 - سالم بن أبي حفصة (5) زياد:(@)(@@) مات سنة سبع وثلاثين ومائة في حياة الصادق عليه السلام، له كتاب، روى عنه: يعقوب بن يزيد، رجال النجاشي (6).(@)(@@) وروى الكشي روايات كثيرة تدل على أن الصادق عليه السلام لعنه وكذبه .(@)(@@) PageV02P293(@)(@@) وكفره (1).(@)(@@)(@@)(@@) $ 2161 / 4 - سالم بن أبي سلمة:(@)(@@) الكندي، السجستاني، حديثه ليس بالنقي، وإن كنا لا نعرف منه إلا خيرا، له كتاب، روى عنه: ابنه محمد بن سالم بن أبي سلمة، رجال النجاشي (2).(@)(@@) ضعيف، روايته، روايته مختلطة (3)، رجال ابن الغضائري (4) (5).(@)(@@)(@@)(@@) $ 2162 / 5 - سالم التمار:(@)(@@) سيجئ بعض أحواله عند ترجمة سلمة بن كهيل (6)، وكأنه المذكور بعنوان: سالم بن أبي حفصة (7) (8).(@)(@@)(@@)(@@) $ 2163 / 6 - سالم الحناط:(@)(@@) أبو الفضل، كوفي، مولى، ثقة، روى عن أبي عبد الله عليه السلام. ذكره أبو العباس، روى عنه: عاصم بن حميد وإسحاق بن عمار. له كتاب، يرويه .(@)(@@) PageV02P294(@)(@@) صفوان، رجال النجاشي (1).(@)(@@) سلم أبو الفضل الحناط، روى عنه: عاصم بن حميد، 
ms239	 من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@) وفي الخلاصة ورجال ابن داود أيضا: سلم (3)، وما وقع في الأخبار:(@)(@@) سالم كما ذكره النجاشي، والظاهر أنهما واحد، قد يكتب بالألف وقد يكتب بغير الألف.(@)(@@)(@@)(@@) $ 2164 / 7 - سالم بن سعيد الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2165 / 8 - سالم بن سلمة:(@)(@@) أبو خديجة الرواجني، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@) وفي رجال ابن داود: سالم بن سلمة، أبو خديجة الرواجني، ق جخ، مهمل: كش، ثقة ثقة (6).(@)(@@) أقول: وهذا غير سالم بن مكرم، وذاك أيضا أبو خديجة، وهو الجمال، مولى بني أسد ذاك من الضعفاء (7)، انتهى.(@)(@@) ولم أجده في الكشي والنجاشي أصلا، نعم ذكر النجاشي سالم بن .(@)(@@) PageV02P295(@)(@@) مكرم وقال: ثقة ثقة (1)، كما سننقله.(@)(@@)(@@)(@@) $ 2166 / 9 - سالم بن عبد الرحمن الأشل (2):(@)(@@) وثقه ابن الغضائري، عند ترجمة ابنه عبد الرحمن بن سالم (3)، فلاحظها.(@)(@@)(@@)(@@) $ 2167 / 10 - سالم بن عبد الله:(@)(@@) أبو محمد الحناط، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2168 / 11 - سالم بن عبد الله الأزدي:(@)(@@) الجصاص الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 2169 / 12 - سالم بن عطية:(@)(@@) أبو عبد الله (7)، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 2170 / 13 - سالم بن عمار الصائدي:(@)(@@) الهمداني، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (9) (10).(@)(@@) .(@)(@@) PageV02P296(@)(@@)(@@)(@@) $ 2171 / 14 - سالم بن مكرم (1) بن عبد الله:(@)(@@) أبو خديجة، ويقال: أبو سلمة الكناسي، يقال: صاحب الغنم، مولى بني أسد، الجمال، يقال: كنيته كانت أبا خديجة، وأن الصادق عليه السلام كناه أبا سلمة، ثقة ثقة، روى عن أبي عبد الله وأبي الحسن عليهما السلام. له كتاب (2)، روى عنه: الحسن بن علي الوشاء، رجال النجاشي (3).(@)(@@) سالم بن مكرم، يكنى أبا خديجة، ومكرم يكنى أبا سلمة، ضعيف، له كتاب (4)، روى عنه: أحمد بن عائذ (5) وعبد الرحمن بن أبي هاشم، الفهرست (6).(@)(@@) قال محمد بن مسعود: سألت أبا الحسن علي بن الحسن، عن اسم أبي خديجة، قال: سالم بن مكرم، قلت له: ثقة؟ فقال: صالح، وكان من .(@)(@@) PageV02P297(@)(@@) أهل الكوفي، 
ms240	 وكان جمالا، وذكر إنه حمل الصادق عليه السلام من مكة إلى المدينة. قال: أخبرنا عبد الرحمن بن أبي هاشم، عن أبي خديجة، قال:(@)(@@) قال الصادق عليه السلام: لا تكنى بأبي خديجة، قلت: فبم أكنى؟! قال عليه السلام:(@)(@@) بأبي سلمة. قال (1): سالم من أصحاب أبي الخطاب، وكان في المسجد يوم بعث عيسى بن موسى بن علي بن عبد الله بن العباس - وكان عامل المنصور على الكوفة - إلى أبي الخطاب، لما بلغه أنهم قد أظهروا الإباحات ودعوا الناس إلى نبوة أبي الخطاب، وأنهم يجتمعون في المسجد ولزموا الأساطين (2) يورون الناس أنهم قد لزموها للعبادة، وبعث إليهم رجلا فقتلهم جميعا، لم يبق (3) منهم إلا رجل واحد أصابته جراحات فسقط بين القتلى يعد منهم، فلما جنه الليل فخرج من بينهم فتخلص، وهو أبو سلمة سالم بن مكرم الجمال، الملقب بأبي خديجة. فذكر بعد ذلك أنه تاب وكان ممن يروي الحديث، رجال الكشي (4).(@)(@@) ونقل العلامة قدس سره في الخلاصة توثيقه عن الشيخ الطوسي رحمه الله مع ما نقلناه، وقال: الوجه عندي التوقف، لتعارض الأقوال فيه (5)، انتهى. ولا يبعد أن يكون سالم بن مكرم هذا والذي ذكرناه بعنوان: سالم بن أبي سلمة الكندي (6) واحد - وإن كان النجاشي ذكرهما (7) - كما يظهر مما نقلناه من .(@)(@@) PageV02P298(@)(@@) الفهرست (1).(@)(@@)(@@)(@@) $ 2172 / 1 - السائب بن عمارة الحضرمي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 2173 / 2 - السائب بن يزيد:(@)(@@) من أصحاب الرسول صلى اله عليه وآله، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 2174 / 1 - سبرة بن معبد:(@)(@@) من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 2175 / 1 - سجيم (6) السندي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 2176 / 1 - سدير بن حكيم (8) الصيرفي:(@)(@@) كوفي، يكنى أبا الفضل (9)، والد حنان، من أصحاب علي بن الحسين (10) .(@)(@@) PageV02P299(@)(@@) والباقر (1) والصادق (2) عليهما السلام، رجال الشيخ.(@)(@@) وقال الكشي: حدثنا محمد بن مسعود، عن علي بن محمد بن فيروزان، عن محمد بن أحمد بن يحيى، عن إبراهيم بن هاشم، عن عمرو ابن عثمان، عن محمد بن عذافر، أن الصادق عليه السلام قال: سدير 