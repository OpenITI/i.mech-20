ms81	 % % فغدا يحوم على الردى ويلوب % 8(@)(@@) % بفؤاده وبصفحتيه من الصدى % % ومن الرماء عن الحياض ندوب % % 9(@)(@@) % أسوان يفتق صبره افتاقة % % أمما ، وبغمز بالجوى ، فيغيب % PageV01P269 البحر : متقارب تام 1(@)(@@) % وابيض كالنصل من همه % % قراع المطالب للطالب % 2(@)(@@) % انيس اليدين ببذل النوال % % اذا احتشمت راحة الواهب % % 3(@)(@@) % فتى كمل المجد أخلاقه % فسد الفجاج على العائب % 4(@)(@@) % دعا فاطعت وكان الدعاء % % إلى الفخر والشرف الراتب % 5(@)(@@) % وكنت إلى مثلها في النهو % % اثقل من كاهل الحاطب % % PageV01P270 البحر : بسيط تام 1(@)(@@) % ابرا إلى المجد من حرصي على الطلب % % ومن قراعي على الارزاق والرتب % % 2(@)(@@) % لو أنصف الدهر دلتني غياهبه % على العلى بضياء العقل والحسب % % 3(@)(@@) % ما ينفع المرء احساب بلا جدة % % اليس ذا منتهى حظي وذاك أبي % % 4(@)(@@) % الآن اطلب ثاراتي بمقربة % % خدعتها عن غمير النور والعشب % 5(@)(@@) % يجول صدر الضحى في افق قسطلها % % واليوم بين العوالي ضيق اللبب % % 6(@)(@@) % أنضيت ستا وعشرا ما قضيت بها % % سوى المنى وطرا الا من الادب % % PageV01P271 البحر : وافر تام 1(@)(@@) % لعل الدهر أمضى منك غربا % % وأقوى في الأمور يدا وقلبا % % 2(@)(@@) % ومقلته اذا لحظت حسامي % % تغض مهابة وتفيض رعبا % % 3(@)(@@) % فكيف وانت اعمى عن مقالي % % ولو عاينته لرأيت شهبا % % 4(@)(@@) % عذرتك انت اردى الناس اصلا % % واخبث منصبا واذل جنبا % % 5(@)(@@) % وأنت أقل في عيني من أن % اروعك أو اشن عليك حربا % % 6(@)(@@) % أأعجب من خصامك لي وجدي % % رسول الله يوسع منك سبا % % 7(@)(@@) % ومن رجم السماء ، فلا عجيب % يقال حثا بوجه البدر تربا % % 8(@)(@@) % فإنك إن هجوت هجوت ليثا % وإني إن هجوت هجوت كلبا % % PageV01P272 البحر : طويل 1(@)(@@) % خليلي ما بيني وبين محرق % سوى وقع اطراف القنا والقواضب % % 2(@)(@@) % أتاني بها بزلاء تلقي جرانها % % على خير بيت في لؤي بن غالب % % 3(@)(@@) % وفاز بكوم ذي رقاب منيفة % واسنمة ملوية بالغوارب % % 4(@)(@@) % ارى ابلي مطروحة عن مراحها % % يصيح بها الأعداء من كل جانب % 5(@)(@@) % اذا هن طالعن المياه عشية % % نشجن وراء الذود نشج الغرائب % 6(@)(@@) % وكنا ، إذا ما أبعد المجد غاية 
ms82	 % دفعنا اليها من صدور النجائب % % 7(@)(@@) % تسير أمام العاصفات كأنها % % طلائع أعناق الصبا والجنائب % 8(@)(@@) % خوارج من ليل كأن نجومه % بياض الحصى بالأمعز المتراكب % PageV01P273 البحر : مجزوء الكامل 1(@)(@@) % إياك أن تسخو بوع % س عزمك ان تفي به % % 2(@)(@@) % فالصدق يحسن بالفتى % % والكذب يحسب من عيوبه % % 3(@)(@@) % واذا قدرت على الوفا % % ء ، فعد عن غدر وذيبه % 4(@)(@@) % اشكوك أم اشكو الزمان % % ن ، لأن مطلك من ذنوبه % 5(@)(@@) % بل اشتكيه فكم دفعت % ت إلى الغرائب من خطوبه % PageV01P274 البحر : طويل 1(@)(@@) % سما كبطون الأتن ريعان عارض % تزجيه لوثاء النسيم جنوب % 2(@)(@@) % رغا بين دوح الواديين برعده % % رغاء مطايا مسهن لغوب % % 3(@)(@@) % بصير برمي القطر حتى كانه % % على الرمل قارئ السهام نجيب % % 4(@)(@@) % تدافع اما برقة فصوارم % % جلاء ، وأما عرضه فكثيب % 5(@)(@@) % اذا ما اراق الماء اسفر وجهه % % ويغدو بعبء الماء ، وهو قطوب % 6(@)(@@) % سهرت له نابي الوسادة ، برقه % يحوم على اعناقه ويلوب % % 7(@)(@@) % فؤادي بنجد والفتى حيث قلبه % % أسير ، وما نجد إلي حبيب % 8(@)(@@) % وما لي فيه صبوة غير أنني % % خلعت شبابي فيه وهو رطيب % % 9(@)(@@) % بلى ان قلبا ربما التاح لوحة % % فهل ماؤه للواردين قريب % 10(@)(@@) % ألا هل ترد الريح ، يا جو ضارج % نسيمك يحلولي لنا ويطيب % PageV01P275 11(@)(@@) % وهل تنظر العين الطليحة نظرة % إليك ، وما في الماقيين غروب % 12(@)(@@) % وما وجد ادمأ الاهاب مروعة % % لاحشائها تحت الظلام وجيب % % 13(@)(@@) % ترود طلا اودت به غفلاتها % % وفي كل حي للمنون نصيب % % 14(@)(@@) % بغوم على آثاره ، وقد اكتسى % % ظلام الدياجي غائط وسهوب % 15(@)(@@) % فلما أضاء الصبح لاح لعينها % % دم بين ايدي الضاريات صبيب % % 16(@)(@@) % كوجدي وقد عرى الشباب جواده % % وغير لون العارضين مشيب % 17(@)(@@) % ولكنها الايام اما قليبها % % فمكد واما برقها فخلوب % % 18(@)(@@) % إذا ما بدأن الأمر أفسدن عقبه % وعفى على إحسانهن ذنوب % 19(@)(@@) % فلله دري يوم أنعت قولة % لها في رؤوس السامعين دبيب % % 20(@)(@@) % ولله دري يوم اركب همة % % إلى كل ارض اغتدي وأؤوب % % PageV01P276 21(@)(@@) % وكم مهمة جاذبت بالسير عرضه % وغالبته بالعزم ، وهو غلوب 
ms83	 % 22(@)(@@) % وليل رأيت الصبح في أخرياته % كما انسل من سر النجاد قضيب % 23(@)(@@) % سريت به اوفي على كل ربوة % % وليس سوى نجم علي رقيب % 24(@)(@@) % وأزرق ماء قد سلبت جمامه % % يعوم الشوى في غمره ويغيب % % 25(@)(@@) % وهاجرة فللت بالسير حدها % % ولا ظل الا ذابل ونجيب % % 26(@)(@@) % وألأم مصحوب قذفت إخاءه % عن الروع والإصباح فيه مريب % 27(@)(@@) % حبست به قلبا جريا على الردى % % وقد رجفت تحت الصدور قلوب % % 28(@)(@@) % وطعنة رمح قد خرطت نجيعها % % كما ماج فرغ في الإناء ذنوب % 29(@)(@@) % وضربة سيف قد تركت مبينة % % وحاملها عمر الزمان معيب % % 30(@)(@@) % والام مصحوب قذفت اخائه % % كما قذف الماء المريض شروب % PageV01P277 31(@)(@@) % ومن كان ما فوق النجوم طلابه % % أمل عناء قلبه ودؤوب % 32(@)(@@) % نظرت إلى الدنيا بعين مريضة % وما لي من داء الرجاء طبيب % 33(@)(@@) % ومن كان في شغل المنى ففراغه % منال الاماني اوردى وشعوب % % 34(@)(@@) % فما لي طول الدهر أمشي كأنني % % لفضلي في هذا الزمان غريب % 35(@)(@@) % إذا قلت قد علقت كفي بصاحب % تعود عواد بيننا وخطوب % % 36(@)(@@) % وما فيه شيء خالد لمكادح % وكل لغايات الامور طلوب % % PageV01P278 البحر : بسيط تام 1(@)(@@) % يا سعد كل فؤاد في بيوتكم % مثلي تحكم فيه الظلم والشنب % % 2(@)(@@) % إني لأكرم نفسي أن يقال جنى % % على الفتى العربي الخرد العرب % 3(@)(@@) % إني على شغفي بالحب معتذر % من ان يقال شجاع فله الوصب % % 4(@)(@@) % إنا معاشر لا تبلى مطارفنا % % إلا وهن لطلاب الندى سلب % 5(@)(@@) % موقرون وأيدي الحلم طائشة % والجد ينقص من أطرافه اللعب % 6(@)(@@) % فالان تغصبنا الدنيا غضارتها % % ظلما وتاخذ من ايامنا النوب % % PageV01P279 البحر : وافر تام 1(@)(@@) % إلى كم لاتلين على العتاب % % وأنت أصم عن رد الجواب % 2(@)(@@) % حذارك ان تغالبني غلابا % % فإني لا أدر على الغضاب % 3(@)(@@) % وإنك إن أقمت على أذاتي % % فتحت إلى انتصاري كل باب % % 4(@)(@@) % واحلم ثم يدركني ابائي % % وكم يبقى القرين على الجذاب % 5(@)(@@) % اذا وليتني ظفرا ونابا % % فدونك فاخش من ظفري ونابي % % 6(@)(@@) % فان حمية القرناء تطغى % % فتثلم جانب النسب القراب 
ms84	 % 7(@)(@@) % نفرالى الشراب اذا غصصنا % % فكيف إذا غصصنا بالشراب % 8(@)(@@) % فلا تنظر الي بعين عجز % % فرب مهند لك في ثيابي % % 9(@)(@@) % ومن لك بي يرد عليك شخصي % % اذا اثبت رجلي في الركاب % % 10(@)(@@) % وما صبري وقد جاشت همومي % % إلى أمر وعب له عبابي % % PageV01P280 11(@)(@@) % سيرمي عنك بي مرمى بعيد % % وتغدو غير منتظر إيابي % % 12(@)(@@) % اذا الاشفاق هزك عدت منه % % بعض أنامل أو قرع ناب % 13(@)(@@) % وتسمع بي وقد أعلنت أمري % % فتعلم ان دأبك غير دابي % % 14(@)(@@) % ورب ركائب من نحو ارضي % % تخب اليك بالعجب العجاب % % 15(@)(@@) % وتظهر أسرة من سر قومي % % تمد إلى انتظاري بالرقاب % % 16(@)(@@) % وتصبح لا تني عجبا وقولا : % أهذا الحد أطلق من ذبابي % % 17(@)(@@) % فكيف إذا رأيت الخيل شعثا % طلعن من المخارم والعقاب % 18(@)(@@) % تعاظل كالجراد زفته ريح % % فمر يطيعها يوم الضباب % % 19(@)(@@) % أمضتها الشكائم فهي خرس % تسيل لها دما بدل اللعاب % % 20(@)(@@) % تذكركم بذي قار طعانا % وما جر القنا يوم الكلاب % % PageV01P281 21(@)(@@) % عليها كل ابلج من قريش % % لبيق بالطعان وبالضراب % 22(@)(@@) % يسير ، وأرضه جرد المذاكي % % وجو سمائه ظل العقاب % % 23(@)(@@) % وعندي للعدى لا بد يوم % % يذيقهم المسمم من عقابي % % 24(@)(@@) % فانصب فوق هامهم قدوري % % وأمزج من دمائهم شرابي % % 25(@)(@@) % واركز في قلوبهم رماحي % % واضرب في ديارهم قبابي % % 26(@)(@@) % فان اهلك فعن قدر جري % % وإن أملك فقد أغنى طلابي % % PageV01P282 البحر : - 1(@)(@@) % لم يبق عندي من الإباء سوى ال % % نظرة محمرة من الغضب % 2(@)(@@) % وعض كفي على الزمان من الغي % ظ ، وشكوى وقائع النوب % 3(@)(@@) % أو زفرة تحسب الضلوع لها % % أطر قسي يرمين باللهب % 4(@)(@@) % مضى الرجال الأولى مذ افترقوا % % عني صار الزمان يلعب بي % % 5(@)(@@) % أقول لما عدمت نصرهم % والهف امي عليكم وابي % % PageV01P283 البحر : وافر تام 1(@)(@@) % أبا حسن ! أتحسب أن شوقي % % يقل على معارضة الخطوب % 2(@)(@@) % وانك في اللقاء تهيج وجدي % % وامنحك السلو على المغيب % % 3(@)(@@) % وكيف ، وأنت مجتمع الأماني % % ومجني العيش ذي الورق الرطيب % % 4(@)(@@) % يهش لكم على العرفان قلبي % % هشاشته إلى الزور الغريب % % 5 
ms85	(@)(@@) % وألفظ غيركم ، ويسوغ عندي % % ودادكم مع الماء الشروب % % 6(@)(@@) % ويسلس في اكفكم زمامي % % ويعسو عند غيركم قضيبي % % 7(@)(@@) % وبي شوق إليك أعل قلبي % % وما لي غير قربك من طبيب % 8(@)(@@) % أغار عليك من خلوات غيري % % كما غار المحب على الحبيب % % 9(@)(@@) % وما أحظى ، إذا ما غبت عني % % بحسن للزمان ولا بطيب % % 10(@)(@@) % أشاق ، إذا ذكرتك من بعيد % واطرب ان رأيتك من قريب % % PageV01P284 11(@)(@@) % كانك قدمة الامل المرجى % % علي ، وطلعة الفرج القريب % 12(@)(@@) % إذا بشرت عنك بقرب دار % نزا قلبي إليك من الوجيب % 13(@)(@@) % مراح الركب بشر بعد خمس % % ببارقة تصوب على قليب % 14(@)(@@) % أسالم حين أبصرك الليالي % % وأصفح للزمان عن الذنوب % 15(@)(@@) % وانسى كلما جئت الرزايا % % علي من الفوادح والندوب % 16(@)(@@) % تميل بي الشكوك إليك حتى % % اميل إلى المقارب والنسيب % % 17(@)(@@) % وتقرب في قبيل الفضل مني % % على بعد القبائل والشعوب % % 18(@)(@@) % أكاد أريب فيك ، إذا التقينا % % من الانفاس والنظر المريب % % 19(@)(@@) % واين وجدت من قبلي شبابا % % يحن من الغرام على مشيب % % 20(@)(@@) % إذا قرب المزار ، فأنت مني % % مكان الروح من عقد الكروب % % PageV01P285 21(@)(@@) % وإن بعد اللقاء على اشتياقي % % ترامقنا بألحاظ القلوب % PageV01P286 البحر : رجز تام 1(@)(@@) % جاءت به من مضر مهذبا % % مثل السنان ذلقا مذربا % % 2(@)(@@) % يضم برداه الجراز المقضبا % % تخير الاحساب اما وابا % % 3(@)(@@) % ابلج لا يشتم الا كذبا % % PageV01P287 البحر : مجتث 1(@)(@@) % لا تنكري حسن صبري % % إن أوجع الدهر ضربا % % 2(@)(@@) % فالعبد أصبر جسما % والحر أصبر قلبا % % PageV01P288 البحر : طويل 1(@)(@@) % نزوت نزاء الجندب الجون ضلة % % إلى باسل عبل الذراعين أغلب % 2(@)(@@) % وما كنت في الأحياء إلا ضميمة % تناط بهم نوط الاباء المذبذب % % 3(@)(@@) % تجاور زلا ، أو تعاقد قلة % من الهون لا تدلي بام ولا اب % % 4(@)(@@) % فحول معد منجبون ، وأنتم % نزالة فحل منهم غير منجب % 5(@)(@@) % تقنصه صرف المقادير غرة % وكم فات من ناب علوق ومخلب % 6(@)(@@) % ولو هيج للهيجاء طار بسرجه % جواد كذئب الردهة المتاؤب % % 7(@)(@@) % وكل سنان طالع فوق ضامر % كما حام زنبور على ظهر عقرب % 8(@)(@@) % وفتيان 
ms86	 غارات كأن رماحهم % بجانب ذي القرم عيدان اثأب % % 9(@)(@@) % بأيمانهم بيض يضيء وجوههم % % قواضب قد جربن كل مجرب % % 10(@)(@@) % غرانق أزوال رعوا عازب الحمى % % بصم العوالي ، والصفيح المقلب % PageV01P289 11(@)(@@) % فلا تحسبوها قطرة من دمائنا % % تضيع ولو في طافح النجم مطلب % % 12(@)(@@) % اذا اعشب الشق اليماني فابشروا % % بيوم عقام ينضح الشر أجرب % 13(@)(@@) % فان ترحمونا اليوم نرحمكم غدا % بعود من الجزم النزاري مصعب % % PageV01P290 البحر : متقارب تام 1(@)(@@) % لكم لقحة الأرض تحمونها % % وفي يدكم صرها والحلب % 2(@)(@@) % فمن اين نبلغ ما نشتهي % % ومن أين نطمع فيما نحب % 3(@)(@@) % إذا المال أصبح في الباخلين % فان مرجي الغنى في تعب % % PageV01P291 البحر : رجز تام 1(@)(@@) % انظر أبا قران ما تعيب % % ماس الذرى قومها لبيب % % 2(@)(@@) % تصغي لها الأسماع والقلوب % مثل السهام كلها مصيب % 3(@)(@@) % لطيمة نم عليها الطيب % تودعها الاردان والجيوب % % 4(@)(@@) % ويغنم الهلباجة المعيب % % يتعب ذو البراعة الاديب % % 5(@)(@@) % يخرج عني العاسل المذروب % % قد قوم الأنبوب والأنبوب % 6(@)(@@) % فلا يزال العض والتنييب % % حتى يعود الذابل الصليب % % 7(@)(@@) % وهو بأيدي معشر كعوب % إن رزايات الفتى ضروب % 8(@)(@@) % في كل يوم هجمة تلوب % هاج عليها الكلأ الرطيب % 9(@)(@@) % يطلبن ارضي والهوى طلوب % % لا أمم مني ولا قريب % % 10(@)(@@) % عند الأعادي وسمها غريب % يرصدهن الحارب المريب % PageV01P292 11(@)(@@) % له على مطلعها رقيب % إذا طلعن اعترض القليب % 12(@)(@@) % تهوي به الأظفار والنيوب % كما هوت خائبة طلوب % 13(@)(@@) % يألم قلبي ، وبها الندوب % يشكو المطى ما ألم العرقوب % 14(@)(@@) % أطبعها ، وهو بها الكسوب % لي اللألي وله الثقوب % % 15(@)(@@) % داء على إعضاله عجيب % يضحك من أوصافه الطبيب % 16(@)(@@) % هل تأمن اليوم وانت ذيب % % بهم بأكناف الحمى غريب % 17(@)(@@) % إن لم يدم الله والخطوب % % PageV01P293 البحر : رمل تام 1(@)(@@) % كيف صبحت أبا الغمر بها % % صعبة تنزوا نزاء الجندب % % 2(@)(@@) % مرح الشقراء في مضمارها % % تتقي الصوت بمر عجب % 3(@)(@@) % يركب الراكب إن جشمها % % دلج الليل وتسبي المستبى % % 4(@)(@@) % بنت كرم ظئرها الشمس ، وما % % درجت في حجر أم وأب % 5(@)(@@) % غصبت ما اثرت في جسمها % % قدم 
ms87	 العلج براس العربي % % PageV01P294 البحر : متقارب تام 1(@)(@@) % يعاقبني ، وهو المذنب % لقد ذل جارك يا جندب % 2(@)(@@) % ويعجب من غضبي جهلة % % ومن ذا يضام فلا يغضب % % 3(@)(@@) % نزاد من اللوم عن وردكم % فعم نزاد ولا مشرب % 4(@)(@@) % نعم اعوز الطول راجيكم % % فلم أعوز الأهل والمرحب % 5(@)(@@) % اذا ابلي مطلت رعيها % % فهل ينفع البلد المعشب % % 6(@)(@@) % وهل نافعي ظاهر باسم % ومن خلفه باطن يقطب % 7(@)(@@) % لقد وقف الركب من بابكم % على مطلب ماؤه مطلب % % 8(@)(@@) % وما كنت في النفر الشائمي % % ن ، بأول من غره الخلب % 9(@)(@@) % ذنابى مصعن بأبعارهن % وقد يمصع الذنب الاهلب % % 10(@)(@@) % لقد ساءني ان يموت السماح % % بموت الكرام ولا يعقب % % PageV01P295 11(@)(@@) % ألا تعجبون لذي سوءة % تحكك في عرضه الاجرب % % 12(@)(@@) % وجعجع لي ظهر عاري الصفاح % % ح عقير ، وقال : ألا تركب % 13(@)(@@) % وسوف أغني بأعراضكم % غناء من الشر لا يطرب % 14(@)(@@) % قواف مطلن لحز الجنوب % % مطل المدى جرعها موعب % % 15(@)(@@) % وحسبك من سفه أنني % % أجد ، وتحسبني ألعب % 16(@)(@@) % وقالوا : احتلب درهم بالسؤا % % ل ، إن الغوارز لا تحلب % 17(@)(@@) % وكيف ولم يرغبوا في الثناء % % إلى المادحين ولم يرغبوا % % 18(@)(@@) % لقد وسع الله ما ضيقوا % % وقد عوض الله ما خيبوا % % PageV01P296 البحر : كامل تام 1(@)(@@) % نزل المسيل وبات يشكو سيله % % الا علوت فبت غير مراقب % % 2(@)(@@) % جمع المثالب ، ثم جاء تعرضا % بالمخزيات يدق باب الثالب % % 3(@)(@@) % وإذا اجتمعت على معايب جمة % فتنح جهدك عن طريق العايب % PageV01P297 البحر : طويل 1(@)(@@) % وركب تفرى بينهم قطع الدجى % % يسير على البيداء ينتهب التربا % % 2(@)(@@) % يصدون عن ورد الكرى وعيونهم % % خوامس حتى تشرب المنظر العذبا % % 3(@)(@@) % اذا زعزتهم نبأة غادرتهم % % وقد أيقظوا من بين أجفانها القضبا % % 4(@)(@@) % سروا وخيول الليل دهم وعرسوا % % وقد غادروها في طراد الضحى شهبا % % 5(@)(@@) % يضوع هجير السير بين رحالهم % % إذا ما نسيم الليل في ثوبه هبا % % PageV01P298 البحر : طويل 1(@)(@@) % أسنة هذا المجد آل المهلب % وفراطه في كل شرق ومغرب % 2(@)(@@) % سلوني عن مجد المفعل واسئلوا % % أبي عن أبيه ذي الجلال المهذب % 3(@)(@@) % يقل 
ms88	 ان ذاك الليث في كل معرك % % وهذا الحسام العضب في كل مضرب % % 4(@)(@@) % وهذا الربيع الطلق رقت فروعه % % نتيجة ذاك العارض المتصبب % 5(@)(@@) % أخلاي من بين الملوك وإخوتي % % واحلى بقلبي من بعيدي واقربي % % 6(@)(@@) % هم قومي الادنون من بين اسرتي % % وان كان شعب القوم من غير مشعبي % % 7(@)(@@) % فهذا ثناي لا اريد به الغنى % % أبى المجد لي أن أجعل المدح مكسبي % % 8(@)(@@) % ولكن رجاء أن تكون لهمتي % % طريقا تؤديني إلى كل مطلبي % % 9(@)(@@) % فازحم منك الحادثات بمنكب % % واقطع منك النائبات بمقضب % % 10(@)(@@) % وارمي إلى امر اظنك بابه % % ألا إن بعض الظن غير مكذب % PageV01P299 البحر : كامل تام 1(@)(@@) % قل للخطوب : ضعي سلاحك قد حمى % % سربي وآمنني أبو الخطاب % 2(@)(@@) % ولقد حططت بك الرجاء ولم يكن % % إلا إليك تسببي وطلابي % % 3(@)(@@) % يا ملبسي النعم القديم لباسها % % جدد علي نضارة الاثواب % % 4(@)(@@) % دار المعالي انت باب دخولها % % فأذن فاني واقف بالباب % % PageV01P300 البحر : طويل 1(@)(@@) % دعوا لي اطباء العراق لينظروا % % سقامي وما يغني الاطباء في الحب % % 2(@)(@@) % أشاروا بريح المندل اللدن والشذا % % ورد ذماء النفس بالبارد العذب % 3(@)(@@) % يطيلون جس النابضين ضلالة % ولو علموا جسوا النوابض من قلبي % % PageV01P301 البحر : مديد تام 1(@)(@@) % صاحب كالغر ليس ارى % % جده مني ولا لعبه % % 2(@)(@@) % يتقيني بالخلاب ، وإن % جدحوا عرضي له شربه % 3(@)(@@) % داعيا لي بالخلود ولو % % طلبوا منه دمي وهبه % 4(@)(@@) % قسما بالبيت طفت به % و برمي جمرة العقبة % % PageV01P302 البحر : خفيف تام 1(@)(@@) % بين عزمي وبينهن حروب % % إن أقواهما هو المغلوب % 2(@)(@@) % عرضت رحلة فعرض بالد % % مع فهان المأمول والمطلوب % % PageV01P303 البحر : - 1(@)(@@) % إساءته شهوة ثرة % و إحسانه درة الارنب % % 2(@)(@@) % فقد زيد شرا إلى شره % % كما استنفر الضب بالعقرب % % PageV01P304 البحر : طويل 1(@)(@@) % اخافك إن الخوف منك محبة % % وما كل مخشي العقاب محببا % % 2(@)(@@) % لئن كان خوفي من سطاك مبعدا % % فيا ربما كان الرجاء مقربا % % PageV01P305 البحر : كامل تام 1(@)(@@) % ضموا قواصي كل سرح سارب % وقفوا السوائم بالندى المتقارب % % 2(@)(@@) % فلقد مضى حامي السروح من العدى % % ومبيح اسواقها غرار 
ms89	 القاضب % % PageV01P306 البحر : رمل تام 1(@)(@@) % آه من دائين عدم ومشيب % رب سقم لا يداوى بطبيب % PageV01P307 البحر : طويل 1(@)(@@) % كان نزارا والخمول رداؤه % % غداة بغى جهلا علي وأجلبا % % 2(@)(@@) % مشبجة من خذل العين واقعت % % على الماء مفتول الذراعين اغلبا % % PageV01P308 البحر : - 1(@)(@@) % ترفق أيها المصيب % % ترفق أيها الرامي المصيب % 2(@)(@@) % تسوء قطيعة وتشوق حبا % % فما أدري عدو أم حبيب % PageV01P309 البحر : طويل 1(@)(@@) % عذيري من العشرين يغمزن صعدتي % % و من نوب الايام يقرعن مروتي % % 2(@)(@@) % ومن همم أوجدنني في عشيرتي % % وأكثرن ما بين الأقارب غربتي % % 3(@)(@@) % ومن عزمات كل يوم يقفن بي % % على كل باب للمقادير مصمت % % 4(@)(@@) % ومن مهجة لا ترأم الضيم مرة % يعجل عن دار المذلة نهضتي % % 5(@)(@@) % ومن لوعة للحب مشحوذة الظبى % % إذا ضربت في جانب القوم ثنت % % 6(@)(@@) % و من زفرة تحت الشغاف مقيمة % % إذا قلت قد ولى بها الدهر كرت % 7(@)(@@) % تذكر أياما مضين ولو فدت % % بنان يدي تلك الليالي لفلت % % 8(@)(@@) % يخالسنا الأحباب حتى تقطعت % % قرائيننا ، ريب الزمان المشتت % 9(@)(@@) % ولم يبق لي إلا عليق مضنة % أداري الليالي عنه إما ألمت % 10(@)(@@) % فياليتها قد انسأته وليتها % % عليه وإن لم ينجح يوما اذمت % % PageV01P310 11(@)(@@) % سقى الله من أمسى على النأي علتي % % و قد كان مع قرب المزار تعلتي % % 12(@)(@@) % أقلني ، أقلني نظرة ما احتسبتها % % فقد انهلت قلبي غليلا وعلت % % 13(@)(@@) % فشوقا إلى وجه الحبيب تلهفي % % وميلا إلى دار الحبيب تلفتي % % 14(@)(@@) % جرت خطرة منه على القلب كلما % % زجرت لها العين الدموع ارشت % % 15(@)(@@) % و مرت على لبي فقلت لعلها % % تجاوزني مكظومة ، فاستمرت % 16(@)(@@) % أداري شجاها كي يخلى مكانه % وهيهات ، ألقت رحلها واطمأنت % 17(@)(@@) % وأعلم ما خاضت يد الدهر للفتى % % أمر مذاقا من فراق الأحبة % 18(@)(@@) % فكم زعزعتني النائبات فلم أزل % % لها قدمي عن وطأة المتثبت % % 19(@)(@@) % وكم صاحب الأيام خلفي بروعة % % فصرت بعين الجازع المتلفت % 20(@)(@@) % تسل علي الحادثات سيوفها % % فمن مغمد قد نال منى ومصلت % % PageV01P311 21(@)(@@) % زمامي بكف الدهر أتبع خطوه % و ما الدهر إلا مالك للأزمة 
ms90	 % % 22(@)(@@) % وقد كنت آبى أن أقاد ، وإنما % % الان قيادي من الآن عريكتي % % 23(@)(@@) % فلا تشتموا أن يثلم الدهر جانبي % % فاكثر مما مر مني بقيتي % % 24(@)(@@) % تحيف شوسا من عيون فاغمضت % % و ذلل غلبا من رقاب فذلت % % 25(@)(@@) % فآه على الدنيا إذ الجد صاعد % و اوه من الدنيا إذا النعل زلت % % 26(@)(@@) % الأهل اخيض الطرف يوما بغمرة % % إذا الخيل بالغر الوجوه تمطت % 27(@)(@@) % و لم تلق فيها غير طعن مضجج % % وضرب سريع بالمنايا مسكت % 28(@)(@@) % ترن له هام الرجال وإن رمت % % بأعينها فيه النساء أرنت % 29(@)(@@) % فسوف تراني طايرا في غبارها % % على سابح تهفو غدائر لمتي % % 30(@)(@@) % بيوم كثير بالغبار عطاسه % إذا ثوب الداعي قليل المشمت % % PageV01P312 31(@)(@@) % معارك يخدجن المهار ، وبعدها % % مناعي رجال ملقيات الأجنة % % 32(@)(@@) % ورمحي إلى الأعداء كيدي ، وصارمي % % جناني يوم الروع ، والصبر جنتي % % 33(@)(@@) % وكل غلام ذي جلاد ونجدة % و كل جواد ذي هبتات وميعة % % 34(@)(@@) % إذا ما الجياد الجرد اجرى لبانها % % و شمصها وقع الظبا والأسنة % % 35(@)(@@) % فان عناني في يمين معود % % على عقب الأيام قود الأعنة % 36(@)(@@) % إذا اعترض المأمول من دونه الردى % % شققت إليه الدارعين بمهجتي % % 37(@)(@@) % و غامست فيه لا أبالي لو أنني % % تلقيت منه منيتي أو منيتي % % 38(@)(@@) % إذا سمحت بالموت نفسي فإنه % % يقل احتفالي بالذي جر ميتتي % % 39(@)(@@) % وما ان أبالي ما جنى الدهر بعدما % % يبل يميني قائم من صفيحتي % % 40(@)(@@) % فما حدثان الدهر عندي بفاتك % ولاجنة القار عندي بجنة % % PageV01P313 41(@)(@@) % ألا لا أعد العيش عيشا مع الأذى % % لأن قعيد الذل حي كميت % 42(@)(@@) % يخيفونني بالموت ، والموت راحة % لمن بين غربي قلبه مثل همتي % % 43(@)(@@) % فلا تبرزوا لي بالانوف فانني % % معودة جدع الموارن شفرتي % % 44(@)(@@) % بنينا رواق المجد تعلو سموكه % % لقد عظمت تلك المباني وجلت % % 45(@)(@@) % أقلوا علينا لا أبا لأبيكم % ولا ترشقونا باللتيا وباللتي % % 46(@)(@@) % تريدون أن نوطى ، وأنتم أعزة % بأي كتاب أم باية سنة % % 47(@)(@@) % فإن كنتم منا فقد طال مليكم % % قديما على عيدان تلك الأرومة % 48(@)(@@) % فلا صلح حتى 
ms91	 تسمعوا من أزيزها % % صواعق أما صكت الأذن صكت % % 49(@)(@@) % ولا صلح حتى ينظروا من زهائها % % شواهق لا يبلغن صوت المصوت % % 50(@)(@@) % تفلت من أرسانها والأجلة % ثفلت من ارسانها والا جلت % % PageV01P314 51(@)(@@) % فإني زعيم للأعادي بمثلها % % وذلك رهن في ذمامي وذمتي % % 52(@)(@@) % فيا منبتي هل أنت بالعز مورقي % % حنانيك كم أبقى ، وقد طال منبتي % % 53(@)(@@) % أما كملت عند الخطوب تجارتي % % أما خلصت عند الأمور رويتي % % 54(@)(@@) % أما انا موزون بكل خليفة % % أرى أنفا من أن يكون خليفتي % % 55(@)(@@) % ألست من القوم الأولى قد تسلفوا % % ديون العلى قبل الورى في الأظلة % 56(@)(@@) % وما خلقت أقدامهم وأكفهم % لغير العوالي والظبى والأسرة % 57(@)(@@) % ذوو الجبهات البيض تلمع بينها % % وسوم المعالي والوجوه المضيئة % 58(@)(@@) % أبوا أن يلم الذل منهم بجانب % و ما العز لا للنفوس الابية % % 59(@)(@@) % وكم بين ذي انف حمي وحاملي % % موازن قد عودن جذب الأخشة % 60(@)(@@) % بلى أنني من تعلمان وإنما % % أرى الدهر يعمى عن بيان فضيلتي % % PageV01P315 61(@)(@@) % فخرت بنفسي لا بأهلي موفرا % على ناقصي قومي مناقب اسرتي % % 62(@)(@@) % ولا بد يوما أن يجيء فجاءة % فلا تنظراني عند وقت موقت % % 63(@)(@@) % و والله لا كديت دون منالها % % وظني بربي أن يبر أليتي % % PageV01P316 البحر : طويل 1(@)(@@) % أبينتها أم ناكرتك شياتها % % نزائع ينقلن الردى صهواتها % % 2(@)(@@) % طلعن سواء ، والرماح عوابس % تعاسلها أعناقها وطلاتها % % 3(@)(@@) % رأوا نقعها يدنو فظنوا غمامة % فما شعروا حتى بدت جبهاتها % % 4(@)(@@) % وفوق قطاها غلمة غالبية % تميس على أكتافها وفراتها % % 5(@)(@@) % مغاوير لا ميل تثني رقابها % % أفتيانها الباكون أم فتياتها % % 6(@)(@@) % تلثم فوق اللثم بالنقع والدجى % % فلولا ظباها لم تبن صفحاتها % % 7(@)(@@) % متى ترها في حيها تر فتية % ليوم الوغى مأخوذة أهباتها % % 8(@)(@@) % مفرغة مما تنيل عبابها % % من المال أو مملوؤة جفناتها % % 9(@)(@@) % تخطى بها أعناق كل قبيلة % صوارمها تهتز أو قنواتها % % 10(@)(@@) % ترى عندها الشهر الحرام محللا % % إذا خفرتها للوغى عزماتها % % PageV01P317 11(@)(@@) % و احلم خلق الله حتى إذا دنا % % إليها الأذى طارت بها جهلاتها % % 12(@)(@@) % إذا وسمت بالنار خيل فعندها 
ms92	 % % كرائم آثار الطعان سماتها % % 13(@)(@@) % متى سمعت صوت الصريخ تنصتت % % قياما إلى داعي الوغى سمعاتها % % 14(@)(@@) % رحلنا بأكباد غلاظ على الهوى % % قليل إلى ما خلفها لفتاتها % % 15(@)(@@) % إذا ازمعت ازماعة الجد لم تبل % % افتياتها الباكون أم فتياتها % % 16(@)(@@) % سوابقها أولى بها لانساؤها % % و ادراعها والبيض لا امهاتها % % 17(@)(@@) % وحي من الأعداء باتوا بليلة % % منعمة لو لم تذم غداتها % % 18(@)(@@) % وخيل خششنا جوهم برماحنا % % كما خش آناف القروم براتها % % 19(@)(@@) % فما استيقظوا حتى تداعى صهيلها % % وقد سبقت ألحاظهم عبراتها % % 20(@)(@@) % و لم ينجح إلا من تخاطت سيوفنا % % و ذاق الردى من عممت شفراتها % % PageV01P318 21(@)(@@) % قواضب لا يودي بشيء قتيلها % % إذا امست القتلى تساق دياتها % % 22(@)(@@) % أنسنا بأطراف الرماح ، وإننا % % لنحن محلوها ونحن سقاتها % % 23(@)(@@) % نبتن لأيدينا خصوصا ، وإنما % % لنا يتواصى بالطعان نباتها % % 24(@)(@@) % بأبوابنا مركوزة ، وإلى الوغى % % تزعزع في أيماننا قصباتها % % 25(@)(@@) % أبيت ، وكان العز مني خليقة % و هل سبة إلا وقومي اباتها % % 26(@)(@@) % فلا تفزعني بالوعيد سفاهة % % فلي همة لا تقشعر شواتها % % 27(@)(@@) % تغاوت على عرضي عصائب جمة % ولو شئت ما التفت علي غواتها % % 28(@)(@@) % أوليهم صماء أذن سميعة % إذا ما وعت ألوت بها غفلاتها % % 29(@)(@@) % يطول إذا همي ، إذا كان كلما % % سمعت نبيحا من كلاب خساتها % % 30(@)(@@) % لذلتها هانت علي ذنوبها % % فلم أدر من نبذي لها من جناتها % % PageV01P319 31(@)(@@) % قوارص لم تعلق بجلدي نصالها % % ولو كان غيري أنفذته شذاتها % % 32(@)(@@) % هم استلدغوا رقش الافاعي ونبهوا % % عقارب ليل نائمات حماتها % % 33(@)(@@) % وهم نقلوا عني الذي لم أفه به % و ما آفة الاخبار الا رواتها % % 34(@)(@@) % رموني بما لو أن عيني رمت به % جناني على عزي لها لفقاتها % % 35(@)(@@) % أريد لئن أحنو على الضغن بيننا % % وتأبى قلوب أنغلتها هناتها % % 36(@)(@@) % دعوها ندوبا بيننا باندمالها % % ولا تبلغوا مني والا نكاتها % % 37(@)(@@) % فإني مطول للأعادي مماحك % اذا نصفوا اوساق ضغن ملاتها % % 38(@)(@@) % لقد غربتني حظوة الفضل عنكم % وإن جمعت أعراقنا نبعاتها % % 39(@)(@@) % و ما النفس في الاهلين الا غربية % % إذا فقدت اشكالها ولداتها 
ms93	 % % 40(@)(@@) % بني مضر خلوا نفوسا عزيزة % % تنام فأولى أن يطول سناتها % % PageV01P320 41(@)(@@) % دعوها فخير للاعادي هجورها % % وشر لمن يغرى بها يقظاتها % % 42(@)(@@) % ثقوا عن قليل أن يهب شرارها % % وإن قلتم قد أخمدت جمراتها % % 43(@)(@@) % ولا تأنسوا ان الجياد بشكلها % % فيا ربما أردتكم نزواتها % % 44(@)(@@) % و لا تأمنوا صول النفوس وان غدت % % مضاربها مفلولة وظباتها % % 45(@)(@@) % بنو هاشم عين ونحن سوادها % % على رغم اقوام وأنتم قذاتها % % 46(@)(@@) % وما زلتم داء يفري إهابها % % و ان كنتم منها ونحن اساتها % % 47(@)(@@) % و اعجب ما يأتي به الدهر انكم % % طلبتم على ما فيكم أدواتها % % 48(@)(@@) % و املتم أن تدركوها طوالعا % دعوها ستسعى للمعالي سعاتها % % 49(@)(@@) % وإما حرنتم عن مداها ، فإننا % % سراع إذا مدت لنا حلباتها % % 50(@)(@@) % أبي دونكم ذاك الذي ما تعلقت % باثوابه الدنيا ولا تبعاتها % % PageV01P321 51(@)(@@) % تجنبها هوجاء لا مستقيمة % % خطاها ولا مأمونة عثراتها % % 52(@)(@@) % غدا راضيا بالنزر منها قناعة % ولو شاء قد كانت له جفناتها % % 53(@)(@@) % تلافظها من بعد ما زاق طعمها % % فكانت زعاقا عنده طيباتها % % 54(@)(@@) % تلافى قريشا حين رق اديمها % % و خفت على ايدي الرجال حصاتها % % 55(@)(@@) % ورجبها من بعد ما مال فرعها % % و حين ابت الا اعوجاجا قناتها % % 56(@)(@@) % و كم عاد في احدى عواليه هامة % % لجبار قوم قطرته شباتها % % 57(@)(@@) % فمن غيره لليعملات يقيمها % % إذا وقعت مثنية ركباتها % % 58(@)(@@) % ومن لعجاج الحرب يجلو ظلامه % إذا خفقت في نقعها عذباتها % % 59(@)(@@) % ومن للمعالي القود يقرع هامها % % إذا نفت الأقدام عنها صفاتها % % 60(@)(@@) % و من لاضاميم الجياد غدوها % % لطعن حماليق العدى وبياتها % % PageV01P322 61(@)(@@) % لنا وعلينا إن لبثنا هنيهة % قطاف رؤس اينعت ثمراتها % % 62(@)(@@) % فيا لهفي كم من نفوس كريمة % % تموت وفي اثنائها حسراتها % % 63(@)(@@) % يعز علينا ان تفوت وانها % % قضت نحبها أو ما انقضت زفراتها % % 64(@)(@@) % و كان بدار اهون ملقى جنوبها % % سواء عليها موتها وحياتها % % 65(@)(@@) % أسارى تعنيها الكبول ، مذودة % بواطشها مقصورة خطواتها % % 66(@)(@@) % و ما برحت تبكي قتيلا عيونها % % فلا دمعها يرقى ولا عبراتها % % 67(@)(@@) % عسى الله ان 
ms94	 يرتاح يوما بفرحة % % فتنطق أنضاء أطيل صماتها % % 68(@)(@@) % و يؤخذ ثار مات هما ولاته % % ولما تمت أضغانها وتراتها % % 69(@)(@@) % فكم فرجت من بعد ما أغلقت لنا % % مغالقها ، واستبهمت حلقاتها % % 70(@)(@@) % غرست غروسا كنت أرجو لحاقها % % وآمل يوما أن تطيب جناتها % % PageV01P323 71(@)(@@) % فان اثمرت لي غيرما كنت آملا % فلا ذنب لي ان حنطلت نخلاتها % % PageV01P324 البحر : خفيف تام 1(@)(@@) % يا ابن عبد العزيز لو بكت العي % % ن فتى من اميه لبكيتك % % 2(@)(@@) % غير اني اقول انك قد طب % % ت ، وإن لم يطب ولم يزك بيتك % 3(@)(@@) % انت نزهتنا عن السب والقذ % % ف فلو امكن الجزاء جزيتك % % 4(@)(@@) % و لو أني رأيت قبرك لا ستح % % ييت من ان ارى وماحييتك % % 5(@)(@@) % و قليل ان لو بذلت دماء ال % % بدن حزنا على الذرى وسقيتك % % 6(@)(@@) % دير سمعان لا اغبك غاد % % خير ميت من آل مروان ميتك % % 7(@)(@@) % انت بالذكر بين عيني وقلبي % % ان تدانيت منك أو قد نأيتك % % 8(@)(@@) % و إذا حرك الحشا خاطر من % % ك توهمت أنني قد رأيتك % 9(@)(@@) % وعجيب أني قليت بني مر % وان طرا ، وأنني ما قليتك % 10(@)(@@) % قرب العدل منك لما نأى الجو % % ر بهم فاجتويتهم واجتبيتك % % PageV01P325 11(@)(@@) % فلو أني ملكت دفعا لما نا % % بك من طارق الردى لفديتك % % PageV01P326 البحر : خفيف تام 1(@)(@@) % من يكن زائري يجدني مقيما % أتبع الغانيات بالزفرات % 2(@)(@@) % في ندامى على الهموم قعود % يدعمون الاذقان بالراحات % % 3(@)(@@) % كلما انزفوا من الدمع مدت % % هم دواعي الهموم بالعبرات % % PageV01P327 البحر : سريع 1(@)(@@) % إذا مضى يوم على هدنة % % و انت في سلم من النائبات % % 2(@)(@@) % فعاجل الفرصة قبل الردى % % وبادر اللذات قبل البيات % 3(@)(@@) % و اسبق وفي حبلك انشوطة % % ضغط الليالي بيد الحادثات % PageV01P328 البحر : سريع 1(@)(@@) % قد آن أن يسمعك الصوت % انائم قلبك أم ميت % % 2(@)(@@) % يا باني البيت على غرة ! % امامك المنزل والبيت % % 3(@)(@@) % أيجزع المرء لما فاته % و كل ما يدركه فوت % % 4(@)(@@) % و انما الدنيا على طولها % % ثنية مطلعها الموت % PageV01P329 البحر : مجزوء الرمل 1(@)(@@) % من معيد 
ms95	 لي أيا % % مي بجزع السمرات % 2(@)(@@) % و ليالي بجمع % % و منى والجمرات % % 3(@)(@@) % و ظباء حاليات % % كظباء عاطلات % % 4(@)(@@) % رائحات في جلابي % % ب الدجى مختمرات % 5(@)(@@) % راميات بالعيون ال % % نجل قبل الحصيات % % 6(@)(@@) % ألعقر القلب راحوا % % أم لعقر البدنات % 7(@)(@@) % كيف اودعت فوادي % % أعينا غير ثقات % 8(@)(@@) % أيها القانص ما أح % سنت صيد الظبيات % 9(@)(@@) % فاتك السرب ، وما زو % دت غير الحسرات % % 10(@)(@@) % يا وقوفا ما وقفن % % في ظلال السلمات % PageV01P330 11(@)(@@) % موقفا يجمع فتيا % % ن الهوى والفتيات % % 12(@)(@@) % نتشاكى ما عنانا % % بكلام العبرات % 13(@)(@@) % نظر يشغل منا % % كل عين بقذاة % % 14(@)(@@) % كم نأى ، بالنفر عنا % % من غزال ومهاة % % 15(@)(@@) % آه من جيد إلى الدا % % ر كثير اللفتات % 16(@)(@@) % و غرام غير ماض % % بلقاء غير آت % % 17(@)(@@) % فسقى بطن منى وال % % خيف صوب الغاديات % 18(@)(@@) % وزمانا نائم العذ % ال مامون الوشاة % % 19(@)(@@) % في ليال كاللآلي % % بالغواني مقمرات % % 20(@)(@@) % غرست عندي غرس ال % % شوق ممرور الجناة % PageV01P331 21(@)(@@) % أين راق لغرامي % % و طبيب لشكاتي % % PageV01P332 البحر : وافر تام 1(@)(@@) % احن إلى لقائك كل يوم % % وأسأل عن إيابك كل وقت % 2(@)(@@) % و اذكر ما مضى فيغيض صبري % % وتنفر عبرتي ويبوح صمتي % % 3(@)(@@) % ولي قلب ، إذا ذكر التلاقي % % تظلم من يد البين المشت % % PageV01P333 البحر : خفيف تام 1(@)(@@) % قال لي عند ملتقى الركب عمرو % % قوم العود بعدنا ، فانصاتا % % 2(@)(@@) % أين ذاك الصبا واين التصابي % % سبقا الطالب المجد وفاتا % % 3(@)(@@) % من قضى عقبة الثلاثين يغدو % % راجعا يطلب الصبا ، هيهاتا % % 4(@)(@@) % لم تزل والمشيب غير قريب % % ناعيا للشباب حتى ماتا % % 5(@)(@@) % كنت تبكي الأحياء فاستكثر اليو % م من الدمع ، واندب الأمواتا % % PageV01P334 البحر : كامل تام 1(@)(@@) % قد قلت للنفس الشعاع اضمها % % كم ذا القراع لكل باب مصمت % % 2(@)(@@) % قد آن أن أعصي المطامع طائعا % لليأس جامع شملي المتشتت % % 3(@)(@@) % يقضي الحريص وليس يقضي اربه % % متعللا ابدا بغير تعلة % % 4(@)(@@) % قل للذين بلوتهم ، فوجدتهم % % آلا وغير الال ينقع غلتي % % 5(@)(@@) % اعددتكم لدفاع كل ملمة % % عني ، فكنتم عون كل ملمة % 6(@)(@@) % وتخذتكم 
ms96	 لي جنة فكأنما % % نظر العدو مقاتلي من جنتي % % 7(@)(@@) % سمع يبل بها الحسود غليلة % % ومتى نبثن على عدو يشمت % % 8(@)(@@) % تابي ثمار ان تكون كريمة % % وفروع دوحتها لئام المنبت % % 9(@)(@@) % لما رميت إليكم بمطامعي % % كثر الخلاج مقلبا لرويتي % % 10(@)(@@) % ووقفت دونكم وقوف مقسم % حذر المنية راجي الأمنية % PageV01P335 11(@)(@@) % قد تؤمكم واخرى تنثني % % عنكم وحزم الرأي للمتثبت % % 12(@)(@@) % لولا الحوادث ما افدت تجاربا % % يعسو الرطيب ويقرح الجذع الفتي % % 13(@)(@@) % يأس ثنى سنن المطالب عنكم % ولوى إلى الوطان عنق مطتي % % 14(@)(@@) % لا عذر لي الا ذهابي عنكم % % فإذا ذهبت فيأسكم من رجعتي % % 15(@)(@@) % فلأرحلن رحيل لا متلهف % % لفراقكم ، أبدا ، ولا متلفت % 16(@)(@@) % ولا نفضن يدي يأسا منكم % % نفض الأنامل من تراب الميت % 17(@)(@@) % ولألمعن بكل بيت شارد % لمع المهند في يمين المصلت % 18(@)(@@) % من كل قافية تخب اليكم % % بشواظها خبب الجواد المفلت % % 19(@)(@@) % وأقول للقلب المنازع نحوكم : % أقصر هواك لك اللتيا والتي % % 20(@)(@@) % أأهز من لا ينثني وأدير من % لا يرعوي والوم من لا يختتي % % PageV01P336 21(@)(@@) % يا ضيعة الامل الذي وجهته % % طمعا إلى الأقوام بل يا ضيعتي % % 22(@)(@@) % وسرى السفائن ينثني بصدورها % % موج كأسنمة الجمال الجلة % 23(@)(@@) % قوم ، إذا حضروا الندي مهانة % عطست موارنهم بغير مشمت % 24(@)(@@) % يا دهر ! حسبك قد أصبت مقاتلي % % ما زلت تطلب بالمقادر غرتي % % 25(@)(@@) % ما لي احيل على سواك بما جنى % % قدر على قدر ، وأنت بليتي % % PageV01P337 البحر : - 1(@)(@@) % وقفنا لهم من وراء الخطو % % ب ، نطالعهم من خصاصاتها % % 2(@)(@@) % ونرقب يوما كأيامها % % وليلة نحس كليلاتها % % 3(@)(@@) % فإن عصا الدهر لما تدع % سياق الأمور لغاياتها % % 4(@)(@@) % و ان الحبائفل منصوبة % % فلا تستغروا بإفلاتها % % 5(@)(@@) % تسنمتموها طوال الذرى % % فصبرا على بعد مهواتها % % 6(@)(@@) % ومن أمطرته سماء الغنى % % هوى في سيول قراراتها % % 7(@)(@@) % فيا لك دنيا تريش الرجا % % ل وتنحي عليهم بمبراتها % % 8(@)(@@) % و ان منائحها للفتى % % لرهن له بنكاياتها % % 9(@)(@@) % فبيننا تقول له هاكها % % إلى أن تقول له : هاتها % % 10(@)(@@) % ألم تعلموا ان ايامكم % % تعد إلى حين ميقاتها % % PageV01P338 11(@)(@@) % فكيف 
ms97	 وثقتم باعوامها % % ونحن نضن بساعاتها % % 12(@)(@@) % فلا تطلبن لهم عثرة % % ستأتيهم هي من ذاتها % % 13(@)(@@) % تمر الليالي على نهجها % % وتجري الخطوب لعاداتها % % PageV01P339 البحر : سريع 1(@)(@@) % يعبن موتاهم باحياثهم % % كما يعاب الحي بالميت % % 2(@)(@@) % قولكم زور ، وقولي لكم % يبقى بقاء الجبل المصمت % PageV01P340 البحر : طويل 1(@)(@@) % رجونا أبا الهيجاء إذ مات حارث % % فمذ مضيا لم يبق للمجد وارث % 2(@)(@@) % ألا إن قرمي وائل ، ليلة السرى % % اقاما وقد سار المطي الدلائث % % 3(@)(@@) % هما البازلان المقرمان تناوبا % % عرى المجد لما عج بالعبء لاهث % % 4(@)(@@) % رفيقان ما باغاهما العز صاحب % نديمان ما ساقاهما المجد ثالث % % 5(@)(@@) % حسامان إن فتشت كل ضريبة % فأثرهما فيها قديم وحادث % % 6(@)(@@) % بقية أسياف طبعن مع الردى % % فجاء وجاءت عاثيات وعائث % 7(@)(@@) % احقا بان المجد هيضت جبوره % % وزال عن الحي الطوال الملاوث % % 8(@)(@@) % وايد على بسط السماح رقائق % % وهن على قبض الرماح شرائث % 9(@)(@@) % و سرب بنو حمدان كانوا حماته % % رعت فيه ذؤبان الليالي العوائث % 10(@)(@@) % فاين كفاة القطر في كل أزمة % % وأين الملاجي منهم ، والمغاوث % PageV01P341 11(@)(@@) % وأين الجياد المعجلات إلى الوغى % % إذا غام بالنقع الملا المتواعث % % 12(@)(@@) % وأين الثنايا المطلعات عن الأذى % % إذا ناب ضغاط من الأمر كارث % 13(@)(@@) % إذا ما دعا الداعون للبأس والندى % % فلا الجود منزور ولا الغوث رائث % 14(@)(@@) % يرف على ناديهم الحلم والحجا % % إذا ما لغا لاغ من القوم رافث % 15(@)(@@) % من المطمعين المجد بالبيض والقنا % % ملاء المقاري ، والعريب غوارث % 16(@)(@@) % إذا طرحوا عماتهم وضحت لهم % مفارق لم يعصب بها العار لائث % 17(@)(@@) % بكتهم صدور المرهفات وبشرت % هجان المتالي والمطى الرواغث % % 18(@)(@@) % قروم على ما روحوا من وسوقها % % و لا منهم الواني ولا المتماكث % % 19(@)(@@) % يخلى لهم من كل ورد جمامه % إذا وردوا والمعشبات الاثائث % % 20(@)(@@) % مشوا في سهول المجد حينا ووقفوا % % بحيث ابتدت أوعاره والأواعث % PageV01P342 21(@)(@@) % إذا ركبوا سال اللديدان بالقنا % % وحنت مطاياها المنايا الروائث % 22(@)(@@) % كأن الصقور اللامحات تلمظت % إلى الطعم وانصاعت لهن الأباغث % 23(@)(@@) % مضوا لا الأيادي مخدجات نواقص % ولا مرر العلياء منهم 
ms98	 رثائث % 24(@)(@@) % و لا طول النعماء فيهم مقلص % % إذا علقته المعصمات الشوابث % 25(@)(@@) % خلجتم لجساس بن مرة طعنة % % رأى الجد فيها هجرس وهو عابث % 26(@)(@@) % و غادرتم اشلاء بكر مقيمة % % على العار لا تحثا عليها النبائث % % 27(@)(@@) % وقد كان دين في كليب وفى به % غريم مطول بالديون مماغث % % 28(@)(@@) % وقائع أيام كأن إكامها % % بجاري دم الطعن ، الإماء الطوامث % 29(@)(@@) % تعودون عنها في قناكم مباشم % % و عند قنا بكر اليكم مغارث % % 30(@)(@@) % عقدتم بها حبلي أسار ومنة % % و خانهم نقص القوى والنكائث % % PageV01P343 31(@)(@@) % تحللتم من نذر طعن ، وغيركم % % كثير الألا ياغب ما قال حانث % % 32(@)(@@) % حروب من الأقدار طاح عراكها % % بجرب ولم يسلم عليهن حارث % % 33(@)(@@) % وكان سنانا أوجر الخطب حده % وكان يدا أردي بها من ألاوث % 34(@)(@@) % باخلاق اباء يعود بها الأذى % % و عورا على الأعداء وهي دمائث % % 35(@)(@@) % أقول لناعيه إلى المجد والعلى : % رمى فاك مسموم الغرارين فارث % % 36(@)(@@) % كان سواد القلب طار بلبه % % إلى الطود أقنى ينفض الطل ضابث % 37(@)(@@) % ورزء رمى بين القلوب شواظه % أجيج المصالي أسعرتها المحارث % 38(@)(@@) % برغمي تمسي نازلا دار هجرة % % وأنت المصافي والقريب المنافث % 39(@)(@@) % و ان لا اجافي الترب عنك براحة % % ولو نازعتنيها الرقاق الفوارث % 40(@)(@@) % وان تشتمل ارض عليك فانما % % على ماء عيني النقا والكثاكث % PageV01P344 41(@)(@@) % سقى النضد النجدي ملقى ضرائح % بها منكم المستصرخون الغوايث % 42(@)(@@) % فسيان فيها ، من وقار ومن على % % عظامكم والراسيات اللوابث % 43(@)(@@) % ولا برحت بندى عقود صعيدها % % نفاثة ما جاد الغمام النوافث % % 44(@)(@@) % لها خدشات بالموامي ، كأنها % % على لقم البيداء أيد عوابث % 45(@)(@@) % صبابة عز عب في مائها الردى % % و عاد إليها وهو ظمأن غارث % % 46(@)(@@) % و افنان دوحات من المجد اشرعت % % مشاظي الردى ما بينها والمشاعث % % 47(@)(@@) % وما كنت أخشى الدهر إلا عليهم % فهان الرزايا بعدهم والحوادث % PageV01P345 البحر : كامل تام 1(@)(@@) % يا آمن الأقدار بادر صرفها % % و اعلم بان الطالبين حثاث % % 2(@)(@@) % خذ من تراثك ما استطعت فإنما % % شركاؤك الأيام والوراث % % 3(@)(@@) % لم يقض حق المال 
ms99	 الا معشر % % وجدوا الزمان يعيث فيه ، فعاثوا % % 4(@)(@@) % تحثوا على عيب الغني يد الغنى % % والفقر عن عيب الفتى بحاث % 5(@)(@@) % المال مال المرء ما بلغت به الش % % شهوات ، أو دفعت به الأحداث % 6(@)(@@) % ما كان منه فاضلا عن قوته % % فليعلمن بأنه ميراث % 7(@)(@@) % مالي إلى الدنيا الغرورة حاجة % % فليخز ساحر كيدها النفاث % % 8(@)(@@) % طلقتها ألفا لأحسم داءها % % وطلاق من عزم الطلاق ثلاث % 9(@)(@@) % سكناتها محذورة وعهودها % % منقوضة ، وحبالها أنكاث % 10(@)(@@) % أم المصائب لا يزال يروعنا % % منها ذكور نوائب وإناث % PageV01P346 11(@)(@@) % إني لأعجب من رجال أمسكوا % % بحبائل الدنيا ، وهن رثاث % 12(@)(@@) % كنزوا الكنوز ، وأغفلوا شهواتهم % % فالارض تشبع والبطون غراث % % 13(@)(@@) % اتراهم لم يعلموا ان التقى % % أزوادنا ، وديارنا الأجداث % PageV01P347 البحر : طويل 1(@)(@@) % خذوا نفثات من جوى القلب نافث % % دفاين ضغن قد رمين بنابث % 2(@)(@@) % لقد كن من قبل البواحث نزعا % فكيف بهن اليوم بعد البواحث % % 3(@)(@@) % عذيري من سيف رجوت قراعه % اعادي طرا من قديم وحادث % % 4(@)(@@) % فخان يدي ثم انثنى بغراره % فكان لعنقي اليوم أول فارث % 5(@)(@@) % ومن جبل اعددت شم هضابه % % مردا لأيدي النائبات الكوارث % 6(@)(@@) % فطوح لي من حالق ، وأزلني % % زليل المطايا عن متون الأواعث % 7(@)(@@) % ومن مشرب انبطت ينبوع مائه % % بأعلى الروابي والرياض الأثائث % 8(@)(@@) % يضن علي اليوم منه بنهلة % % وتبذل دوني للنقا والكثاكث % % 9(@)(@@) % هو الرزق مقسوما وليس تناله % % ببرد التباطي أو بحر الحثاحث % % 10(@)(@@) % أعنتم على حربي المقادير عنوة % ورشتم إلى قلبي سهام الحوادث % PageV01P348 11(@)(@@) % ولم تدعوني والزمان فانه % % لاكرم فعلا منكم في الهنابث % % 12(@)(@@) % كذاك من استدرى إلى غير هضبة % % وشد يدا بالمطمعات الرثائث % 13(@)(@@) % دعائي ذئاب القاع خير مغبة % % إذا ، من دعائي بعضكم للمغاوث % 14(@)(@@) % فلو أنني أدعو لؤي بن غالب % لقد أنجدوني بالطوال الملاوث % 15(@)(@@) % بجيش بهم وادي الظلام كانهم % % صدور العوالي بالملا المتواعث % % 16(@)(@@) % هم اطلعوني بالنجاد وارزموا % % لنصري إرزام المطي الرواعث % 17(@)(@@) % وارخو خناقي بعد ما كان فتله % % يغار على عنقي بأيد عوابث % 18(@)(@@) % ترى حلمهم تحت الظبى غير طائش % % وخطوهم 
ms100	 بين القنا غير رائث % % 19(@)(@@) % فلا الحلم بالنائي ، إذا ما دعوته % % ولا العزم بالواني ولا المتماكث % % 20(@)(@@) % وكل فتى إن آد ثقل ملمة % تورك حنوي عبثها غير لاهث % PageV01P349 21(@)(@@) % ضنين بودي لا يزال بوجهه % % كلام العدى عني ونفث النوافث % % 22(@)(@@) % شعاري من دون الشعار وتارة % % قريبي من دون القريب المنافث % % 23(@)(@@) % تعممتموها سوأة جاهلية % لقد فاز من امسى بها غير لائث % % 24(@)(@@) % فجروا ذيول العار ثم تضائلوا % % تضاؤل أطهار الإماء الطوامث % 25(@)(@@) % تقطعت الأطماع فيكم ، ولم يدع % لكم املا لؤم الطباع الخوابث % % 26(@)(@@) % واصبحتم اطلال دار بقفرة % % ترى الركب مجتازا بها غير لابث % 27(@)(@@) % وكيف ارجيكم لدفع مغارم % % وقد خاب راجيكم لدفع معارث % % 28(@)(@@) % قعوا وقعة الساري ، فقد طال حثكم % % إلى العار ، أعناق المطي الدلائث % 29(@)(@@) % فحتى متى اخفي الترات وأنتم % % تثيرون عن مدفونها بالمباحث % 30(@)(@@) % وكم أدمل الأضغان بيني وبينكم % % واغضي على نقض القوى والنكائث % % PageV01P350 31(@)(@@) % اذا رمت من سوأتكم سد هوة % % تشاغلتم عن غيرها بالنبائث % % 32(@)(@@) % رأيت الصقور الغلب خمصى من الطوى % % وما مطعم الدنيا لغير الاباغث % % 33(@)(@@) % فلا حظ في استنزال رزق محلق % ولا نفع في حث الحظوظ الروائث % % 34(@)(@@) % تركت صدوعا بيننا لانشعابها % % ولم أتجشم لم تلك المشاغث % 35(@)(@@) % فزيدوا ، فإني بعدها غير ناقص % وجدوا فإني بعدها غير عابث % 36(@)(@@) % ديون من الأضغان إن أبق أجزكم % % يبهن وان اعطب يرثهن وارثي % % 37(@)(@@) % وإن أنس يوما ذمكم يمس فعلكم % على الذم عندي من أشد البواعث % 38(@)(@@) % وان ابط يسرع بي إلى ما يسؤكم % % لواعج اضغان اليكم حثائث % % 39(@)(@@) % نحلت إذا ما فيكم من معائب % ونازعتكم طعمات تلك الخبائث % 40(@)(@@) % لئن انا لم اعلق باعراض قومكم % % براثن أظفار القريض الضوابث % PageV01P351 41(@)(@@) % فوالله لا اقلعن الا دواميا % % ألية بر لا ألية حانث % 42(@)(@@) % لكي تعلموا غب العداوة بيننا % % ويعرككم كيد المطول المماغث % 43(@)(@@) % سلام على الآمال فيكم ، ولا سقى % % معاهدها جود القطار الدثائث % 44(@)(@@) % لعلمتموني اليأس من كل مطمع % % وعودتموني الصبر في كل حادث % % 45(@)(@@) % وعرفتموني كيف التمس الجدا 