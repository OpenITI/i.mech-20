ms781	 النجاري من أهل المدينة يروي عن أبيه روى عنه بسر بن سعيد والحضرمي بن لاحق(@)(@@)(@@)(@@) $ 5190 - محمد بن عمار بن ياسر مولى بني مخزوم قتله المختار بن أبى عبيد PageV05P357 يروي عن أبيه روى عنه أبو عبيدة بن محمد(@)(@@)(@@)(@@) $ 5191 - محمد بن ثابت بن شرحبيل بن أبي عزيز القرشي من بني عبد الدار من أهل الحجاز والد مصعب بن محمد بن ثابت يروى عن بن عمر وأبي هريرة وعقبة بن عامر كنيته أبو مصعب روى عنه عبد الرحمن بن جبير بن نفير وابنه مصعب(@)(@@)(@@)(@@) $ 5192 - محمد بن عبد الرحمن بن عبد الله بن أبي ربيعة المخزومي القرشي وهو أخو إبراهيم بن عبد الرحمن يروي عن بن الزبير روى عنه الزهري ومحمد بن الحارث بن سفيان(@)(@@)(@@)(@@) $ 5193 - محمد بن أبي أمامة بن سهل بن حنيف يروي عن أبيه روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 5194 - محمد بن عبد الله بن نوفل يروي عن سعد بن أبي وقاص روى عنه الزهرى PageV05P358(@)(@@)(@@)(@@) $ 5195 - محمد بن الأسود بن خلف بن بياضة الخزاعي من أهل مكة يروي عن عمرو بن العاص روى عنه عمرو بن عبد الله بن صفوان الجمحي(@)(@@)(@@)(@@) $ 5196 - محمد بن المرتفع العبدري القرشي من أهل مكة يروي عن بن الزبير روى عنه بن جريج وابن عيينة(@)(@@)(@@)(@@) $ 5197 - محمد بن عقبة بن أبي مالك القرظي بن أخي ثعلبة بن أبي مالك يروي عن أبيه وابن عباس عداده في أهل المدينة روى عنه محمد بن رفاعة وزكريا بن منظور(@)(@@)(@@)(@@) $ 5198 - محمد بن الأسود بن خلف بن عبد يغوث القرشي يروي عن أبيه وجماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه أبو الزبير وعبد الله بن عثمان بن خثيم(@)(@@)(@@)(@@) $ 5199 - محمد بن عطية بن عروة السعدي يروي عن أبيه وله صحبة عداده في أهل اليمن روى عنه ابنه عروة بن محمد(@)(@@)(@@)(@@) $ 5200 - محمد بن إسماعيل يروي عن أنس روى عنه محمد بن علي الجعفي PageV05P359(@)(@@)(@@)(@@) $ 5201 - محمد بن ركانة بن عبد يزيد يروي عن أبيه 
ms782	 وله صحبة في مصارعة النبي صلى الله عليه وسلم إياه روى عنه ولده عنه إلا أني لست بالمعتمد على إسناده(@)(@@)(@@)(@@) $ 5202 - محمد بن رافع بن خديج الأنصاري يروي المراسيل روى عنه إسحاق بن الحكم(@)(@@)(@@)(@@) $ 5203 - محمد بن قيس من أهل المدينة شيخ يروي عن زيد بن ثابت روى عنه إسماعيل بن أمية وهو مولى أبي سفيان بن حرب مات في فتنة الوليد بن يزيد بالمدينة(@)(@@)(@@)(@@) $ 5204 - محمد بن عمير المحاربي يروي عن أبي هريرة روى عنه أشعث بن سليم عداده في أهل الكوفة(@)(@@)(@@)(@@) $ 5205 - محمد بن عبد الله بن صيفي يروي المراسيل عداده في أهل المدينة PageV05P360 روى عنه بن أبي مليكة(@)(@@)(@@)(@@) $ 5206 - محمد بن عبد الرحمن بن يزيد النخعي أبو جعفر يروي عن جماعة من الصحابة روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 5207 - محمد بن عبد الله بن مالك الدار أخو عيسى بن عبد الله بن مالك يروي عن أم سلمة عداده في أهل المدينة روى عنه عطاف بن خالد المخزومي(@)(@@)(@@)(@@) $ 5208 - محمد بن عمير بن عطارد بن حاجب الدارمي يروي المراسيل روى عنه أبو عمران الجوني(@)(@@)(@@)(@@) $ 5209 - محمد بن بيان التغلبي أخو عمر بن بيان يروي عن بن عمر روى عنه بن أبي ليلى(@)(@@)(@@)(@@) $ 5210 - محمد بن طلحة شيخ يروي عن أبي أيوب الأنصاري روى عنه قيس بن سعد PageV05P361(@)(@@)(@@)(@@) $ 5211 - محمد بن كليب بن جابر بن عبد الله يروي عن جابر بن عبد الله روى عنه عبد الرحمن بن النعمان وموسى بن شيبة ثنا إبراهيم بن خزيم قال ثنا عبد بن حميد قال ثنا أبو نعيم قال ثنا محمد بن كليب الأنصاري قال خرج جابر يهدء وأنا معه فأصابه حجر فنكبه وأوجعه فقال تعس من أخاف رسول الله صلى الله عليه وسلم وقلت له يا أبت مذكم مات رسول الله صلى الله عليه وسلم فقال يا بني سمعته أذناي ووعاه قلبي وهو يقول من أخاف الأنصار فقد أخافنى(@)(@@)(@@)(@@) $ 5212 - (@)(@@) محمد بن أبي أيوب الأنصاري من أهل الكوفة يروي عن أبي موسى 
ms783	 الأشعري روى عنه حرملة بن قيس(@)(@@)(@@)(@@) $ 5213 - محمد بن أبي قتلة يروي عن عمر بن الخطاب روى عنه عبد الرحمن بن ميسرة(@)(@@)(@@)(@@) $ 5214 - محمد بن عبد الرحمن بن أبي لبيبة يروي عن سعد بن أبي وقاص PageV05P362 روى عنه أسامة بن زيد الليثي(@)(@@)(@@)(@@) $ 5215 - محمد بن صدقة شيخ رأى الحسن والحسين روى عنه يعقوب بن إسحاق الحضرمي(@)(@@)(@@)(@@) $ 5216 - محمد بن عمر بن أبي سلمة بن عبد الأسد يروي عن أبيه وله صحبة روى عنه ابنه أبو بكر بن محمد(@)(@@)(@@)(@@) $ 5217 - محمد بن أيوب شيخ يروي عن أبي هريرة روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 5218 - محمد بن أبي سويد يروي عن جده سفيان بن عبد الله الثقفي روى عنه الزهري هكذا قاله يونس عن الزهري وقال الزبيدي عن الزهري عن ماعز بن عبد الرحمن عن جده وقال معمر عن الزهري عن عبد الله بن ماعز ومعمر والزبيدي وإن كانا ثبتين فهما غريبان ويونس ليذاكر مواظبة على مجالسته من هذين وقد قال إبراهيم بن سعد عن الزهري PageV05P363 عن محمد بن عبد الرحمن بن ماعز عن سفيان بن عبد الله الثقفي والقلب إلى رواية يونس أميل(@)(@@)(@@)(@@) $ 5219 - محمد بن زيد بن المهاجر بن قنفذ الجدعاني التيمي القرشي من أهل المدينة يروى عن بن عمر ومعاوية روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 5220 - محمد بن سويد الفهري القرشي يروي عن الضحاك بن قيس روى عنه الزهري(@)(@@)(@@)(@@) $ 5221 - محمد بن عبيد الله شيخ يروي عن أبي سعيد الخدري روى عنه يحيى بن سليمان أبو البلاد(@)(@@)(@@)(@@) $ 5222 - محمد بن حسان من أهل البصرة يروي عن أنس بن مالك عداده في أهل البصرة روى عنه وكيع بن الجراح وهو الذي يقال له محمد بن برجان(@)(@@)(@@)(@@) $ 5223 - محمد بن عبد الله شيخ يروي عن بن عمر روى شعبة عن محمد بن مرة عنه PageV05P364(@)(@@)(@@)(@@) $ 5224 - محمد بن زيد بن عبد الله بن عمر بن الخطاب القرشي يروي عن بن عمر روى عنه ابناه عمر وعاصم(@)(@@)(@@)(@@) $ 5225 - محمد بن عبد الله 
ms784	 الكناني يروي عن معاوية بن أبي سفيان إن كان سمع منه روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 5226 - محمد بن أبي سارة يروي عن الحسن بن علي روى عنه محمد بن عبيد الطنافسي(@)(@@)(@@)(@@) $ 5227 - محمد بن أبي حرملة المديني مولى عبد الرحمن بن أبي سفيان بن حويطب بن عبد العزى القرشي يروى عن بن عمر وكان راويا لعطاء بن يسار روى عنه مالك بن أنس وهو الذي يروي عنه خصيف ويقول محمد بن حويطب القرشي ينسبه إلى مواليه(@)(@@)(@@)(@@) $ 5228 - محمد بن عبد الرحمن القرشي يروي عن واثلة بن الأسقع روى عنه أهل الشام(@)(@@)(@@)(@@) $ 5229 - محمد بن قرظة الأنصاري يروي عن أبي سعيد الخدري روى عنه PageV05P365 جابر الجعفي حدثنا إبراهيم بن خزيم قال ثنا عبد بن حميد قال ثنا عبيد الله بن موسى عن سفيان عن جابر الجعفي عن محمد بن قرظة عن أبي سعيد الخدري قال اشترينا كبشا لنضحي به فقطع الذئب الإلية أو من إليته فسألت النبي صلى الله عليه وسلم فأمرني أن أضحي به(@)(@@)(@@)(@@) $ 5230 - محمد بن بشير الأنصاري يروي المراسيل روى عنه ابنه يحيى بن محمد بن بشير ثنا بن قتيبة قال حدثنا يزيد بن موهب قال حدثنا بن وهب عن خالد بن حميد عن سلمة بن شريح الأنصاري عن يحيى بن محمد بن بشير عن أبيه أن رسول الله صلى الله عليه وسلم قال إذا أراد الله بعبد هوانا أنفق ماله في البنيان هذا مرسل وليس بمسند(@)(@@)(@@)(@@) $ 5231 - محمد بن عبد الله بن عبد الرحمن يروى عن بن عباس وعن عبد الله بن السائب روى عنه السائب بن عمر(@)(@@)(@@)(@@) $ 5232 - محمد بن أبي حكيم يروي عن بن عمر روى حيوة بن شريح PageV05P366 عن محمد بن عبد الرحمن عنه(@)(@@)(@@)(@@) $ 5233 - محمد بن المنتشر الهمداني الكوفى بن أخي مسروق يروي عن عائشة وابن عمر روى عنه ابنه إبراهيم محمد بن إبراهيم بن المنتشر وهو أخو المغيرة بن المنتشر(@)(@@)(@@)(@@) $ 5234 - محمد بن أسلم بن بجرة بن بلحارث بن الخزرج الأنصاري 
ms785	 روى عنه أبو بكر بن عمرو بن حزم فعله وابن إسحاق(@)(@@)(@@)(@@) $ 5235 - محمد بن عبد الله بن أبي سليم يروي عن أنس بن مالك روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 5236 - محمد بن الحجاج يروي عن أبي موسى الأشعري روى عنه حرب أبو رجاء(@)(@@)(@@)(@@) $ 5237 - محمد بن سعيد شيخ يروي عن عمر بن الخطاب روى عنه قتادة لا أدري من هو PageV05P367(@)(@@)(@@)(@@) $ 5238 - محمد بن عمرو بن عطاء بن عباس بن علقمة بن عبد الله بن أبي قيس بن عبد ود بن نصر بن مالك بن حسل القرشي المدني يروى عن بن عباس وأبي حميد الساعدي وأبي قتادة روى عنه الزهري وعبد الحميد بن جعفر وموسى بن عقبة مات في آخر ولاية هشام بن عبد الملك وكان له يوم مات ثلاث وثمانون سنة وأمه أم كلثوم بنت غيلان بن سلمة من ثقيف وكان هيئا في القرشيين(@)(@@)(@@)(@@) $ 5239 - محمد بن أبي بكر بن عوف بن رباح الثقفي من أهل الحجاز يروي عن أنس بن مالك روى عنه مالك بن أنس وموسى بن عقبة(@)(@@)(@@)(@@) $ 5240 - محمد بن يوسف بن عبد الله بن سلام يروي عن أبيه عن جده روى عنه الضحاك بن عثمان وليوسف صحبة(@)(@@)(@@)(@@) $ 5241 - محمد بن أبي المجالد من أهل الكوفة يروي عن بن أبي أوفى روى PageV05P368 عنه أبو إسحاق الشيباني وأشعث بن أبي الشعثاء(@)(@@)(@@)(@@) $ 5242 - محمد بن قيس بن مخرمة القرشي الحجازي يروي عن عائشة وأبي هريرة لما نزلت من يعمل سوء يجز به روى عنه عمر بن عبد الرحمن بن محيصن ويقال بن محيصة يقوله سفيان بن عيينة وهو أخو عبد الله بن قيس بن مخرمة(@)(@@)(@@)(@@) $ 5243 - محمد بن عبد الرحمن بن ثوبان القرشي مولى بنى عامر بن لؤي يروى عن بن عمر وأبي سعيد وأبي هريرة عداده في أهل المدينة روى عنه الزهري وابن قسيط كنيته أبو عبد الله مولى الأخنس بن شريق(@)(@@)(@@)(@@) $ 5244 - محمد بن الزبير يروى عن بن عباس وابن الزبير وكان على إفريقية روى عنه عبدة 
ms786	 بن أبي لبابة(@)(@@)(@@)(@@) $ 5245 - محمد بن ثابت بن سباع يروي عن عائشة عداده في أهل المدينة روت عنه ابنته جبرة PageV05P369(@)(@@)(@@)(@@) $ 5246 - محمد بن عباد المخزومي يروي عن ثوبان روى عنه ميمون بن عجلان(@)(@@)(@@)(@@) $ 5247 - محمد بن زيد بن خليدة اليشكري يروي عن بن عمر روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 5248 - محمد أبو عبد الله الأسدي لا أدري من هو يروي عن وابصة بن معبد روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 5249 - محمد بن ثوبان شيخ يروي المراسيل روى عن النبي صلى الله عليه وسلم قال من كشف امرأة فنظر إلى عورتها فقد وجب الصداق روى عبيد الله بن أبي جعفر عن صفوان بن سليم عن عبد الله بن يزيد عنه وقد وهم من زعم أن له صحبة لأن هذا مرسل والمرسل لا تقوم به الحجة(@)(@@)(@@)(@@) $ 5250 - محمد بن أبي عبس بن جبر الأنصاري يروي عن أبيه روى عنه ابنه عبد المجيد PageV05P370(@)(@@)(@@)(@@) $ 5251 - محمد بن مالك بن المنتصر يروي عن أنس بن مالك إن كان سمع منه روى المطلب بن زياد عن أبي بكر بن عبد الله عنه(@)(@@)(@@)(@@) $ 5252 - محمد بن عباد بن جعفر المخزومي من أهل مكة يروي عن أبي هريرة وابن عمر وجابر روى عنه بن جريج وزياد بن إسماعيل(@)(@@)(@@)(@@) $ 5253 - محمد بن عبد الله بن مطيع يروي عن عمر بن الخطاب روى عنه الحكم بن الصلت(@)(@@)(@@)(@@) $ 5254 - محمد بن ميسرة يروي عن أبي هريرة روى عنه داود بن قيس الفراء(@)(@@)(@@)(@@) $ 5255 - محمد بن أبي كبشة الأنماري يروي عن أبيه وله صحبة واسم أبي كبشة سعد بن عمر ويقال عمر بن سعد وهو أخو عبد الله بن أبي كبشة روى عن محمد بن أبي كبشة سالم بن أبي الجعد وقد قدم محمد بن أبي كبشة الكوفة فكتب عنه ختناه إسماعيل PageV05P371 بن أوسط العجلي وسالم بن أبي الجعد(@)(@@)(@@)(@@) $ 5256 - محمد بن معاذ شيخ يروي المراسيل روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 5257 - محمد بن عمار بن سعد القرظ المؤذن من 
ms787	 أهل المدينة يروي عن أبي هريرة روى عنه عمر بن عبد الرحمن بن أسيد(@)(@@)(@@)(@@) $ 5258 - محمد بن زياد القرشي أبو الحارث مولى عثمان بن مظعون الجمحي سكن البصرة يروي عن أبي هريرة روى عنه شعبة والناس وقد قيل إنه مولى قدامة بن مظعون(@)(@@)(@@)(@@) $ 5259 - محمد بن زياد الألهاني من أهل حمص كنيته أبو سفيان يروي عن أبي أمامة روى عنه أهل الشام لا يعتد من روايته إلا ما كان من رواية الثقات عنه(@)(@@)(@@)(@@) $ 5260 - أبو العنبس اسمه محمد بن عبد الرحمن بن قارب الثقفي وقد قيل محمد بن عبد الله بن قارب يروي عن عبد الله بن عمرو روى عنه عبد الملك بن عمير وقد قيل أبو العبيدين PageV05P372(@)(@@)(@@)(@@) $ 5261 - محمد بن قيس الهمداني شيخ من أهل الكوفة يروي عن بن عمر في الرهن وليس بالأسدي روى عنه الثوري(@)(@@)(@@)(@@) $ 5262 - محمد بن مسلم بن خباب صاحب المقصورة يروي عن أنس بن مالك روى عنه العلاء بن عبد الرحمن ومصعب بن ثابت(@)(@@)(@@)(@@) $ 5263 - محمد بن قيس الأنصاري مولى سهل بن حنيف يروي عن سهل بن حنيف روى عنه الوليد بن مالك(@)(@@)(@@)(@@) $ 5264 - محمد بن عبد الرحمن بن عمرو بن الجموح يروي عن جابر بن عبد الله روى محمد بن إسحاق عن معاذ بن رفاعة عنه(@)(@@)(@@)(@@) $ 5265 - محمد بن مسلمة الأنصاري يروي عن أبي سعيد وأبي هريرة روى بن جريج عن شيخ له عنه(@)(@@)(@@)(@@) $ 5266 - محمد بن مروان أبو جعفر يروي عن علي بن أبي طالب روى عنه محمد بن سواء السدوسي PageV05P373(@)(@@)(@@)(@@) $ 5267 - محمد بن أبي عائشة مولى أمية خرج مع بني مروان حيث خرجوا من المدينة يروي في القراءة خلف الإمام روى عنه أبو قلابة ليس يصح له عن النبي صلى الله عليه وسلم سماع ولا رواية(@)(@@)(@@)(@@) $ 5268 - محمد الكوفي شيخ يروي عن زيد بن ثابت روى عنه ليث بن أبي سليم ثنا بن قتيبة قال ثنا معمر عن ليث بن أبي سليم عن محمد الكوفي عن زيد بن ثابت عن النبي 
ms788	 صلى الله عليه وسلم قال نضر الله امرأ سمع منا وبلغه كما سمعه فرب حامل فقه غير فقيه ورب حامل فقه إلى من هو أفقه منه(@)(@@)(@@)(@@) $ 5269 - محمد بن يحيى بن سهل بن أبي حثمة بن ساعدة بن عامر بن عدي بن جشم سمع أنسا يروي عن جماعة من التابعين روى عنه أهل المدينة كنيته أبو عبد الله مات في ولاية أبي جعفر وأمه ابنة عبد الرحمن بن لبيد بن قيظي(@)(@@)(@@)(@@) $ 5270 - محمد بن عبد الله الراسبي يروي عن أنس بن مالك روى عنه عمار بن عمارة PageV05P374(@)(@@)(@@)(@@) $ 5271 - محمد بن عبد الرحمن بن أسعد بن زرارة الأنصاري المدني يروي عن جابر بن عبد الله وأبي سعيد الخدري روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 5272 - محمد بن محمود بن عبد الله بن مسلمة الحارثي الأنصاري بن أخي محمد بن مسلمة يروي المراسيل روى عنه يحيى بن سعيد الأنصاري وعمارة بن غزية(@)(@@)(@@)(@@) $ 5273 - محمد بن سليمان بن أبي حثمة عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه الحجاج بن أرطأة(@)(@@)(@@)(@@) $ 5274 - محمد بن عثمان الأخنسي يروي عن بن عمر روى عنه يعقوب بن محمد الزهري عن شيخ له عنه(@)(@@)(@@)(@@) $ 5275 - محمد بن عبد الرحمن الجمحي أبو الثورين يروي عن بن عمر روى عنه عمرو بن دينار ومن قال عن عمرو بن دينار عن PageV05P375 أبي السوار فقد وهم(@)(@@)(@@)(@@) $ 5276 - محمد بن مسافع بن مساور يروي عن الحسن بن علي روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 5277 - محمد بن أبي محمد شيخ يروي عن عوف بن مالك الأشجعي روى عنه يعلى بن عطاء(@)(@@)(@@)(@@) $ 5278 - محمد بن أبي موسى يروي عن بن عباس روى عنه أبو سعد البقال(@)(@@)(@@)(@@) $ 5279 - محمد بن عبد الله بن أبي سعيد الخزاعي يروي عن أبي الطفيل روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 5280 - محمد بن يحيى بن حبان بن منقذ الأنصاري كنيته أبو عبد الله سمع أنس بن مالك وأكثر روايته عن التابعين روى عنه مالك وأهل المدينة مات 
ms789	 سنة إحدى وعشرين ومائة وهو بن أربع وسبعين سنة أمه أم العلاء بنت عباد بن سلكان بن سلامة ثنا محمد بن الحسين بن مكرم بالبصرة قال ثنا عبيد الله بن عمر القواريري قال ثنا حماد بن زيد قال ثنا يحيى بن سعيد الأنصاري عن محمد بن يحيى بن حبان عن أنس بن PageV05P376 مالك عن أم حرام قالت أتانا رسول الله صلى الله عليه وسلم فنام عندنا فاستيقظ وهو يضحك قالت قلت يا رسول الله بأبي أنت وأمي ما أضحكك قال رأيت قوما من أمتي يركبون هذا البحر كالملوك على الأسرة ثم قال فاستيقظ وهو يضحك قالت فسألته فقال مثل ذلك فقالت قلت ادع الله أن يجعلني منهم قال أنت من الأولين وتزوجها عبادة بن الصامت فركب وركبت معه فلما قدمت إليها بغلتي لتركبها اندقت عنقها فماتت(@)(@@)(@@)(@@) $ 5281 - محمد بن أبي سليمان يروي عن بن عمر روى عنه زمعة بن صالح(@)(@@)(@@)(@@) $ 5282 - محمد بن عبد الرحمن بن عرق اليحصبي من أهل الشام كنيته أبو الوليد يروي عن عبد الله بن بسر روى عنه أهل الشام لا يحتج بحديثه ما كان من رواية إسماعيل بن عياش وبقية بن الوليد ويحيى بن سعيد العطار وذويهم بل يعتبر من حديثه ما رواه الثقات عنه PageV05P377(@)(@@)(@@)(@@) $ 5283 - محمد بن عبد الله بن أسيد يروي عن بن عمر روى عنه عمر بن وهب(@)(@@)(@@)(@@) $ 5284 - محمد بن عبد الله بن عياض يروي عن عثمان بن أبي العاص روى عنه سعيد بن السائب(@)(@@)(@@)(@@) $ 5285 - محمد بن أبي سفيان الثقفي يروي عن أم حبيبة روى عنه ضمرة بن حبيب بن صهيب وهو الذي روى عنه الزهري عن يوسف بن الحكم عن محمد بن سعد(@)(@@)(@@)(@@) $ 5286 - محمد بن عبد الله بن أهيب كاتب زيد بن ثابت يروي عن زيد بن ثابت روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 5287 - محمد بن نافع شيخ يروي عن أنس بن مالك روى عنه نوح بن قيس الطاحي PageV05P378(@)(@@)(@@)(@@) $ 5288 - محمد بن نافع يروي عن عائشة روى عنه 
ms790	 الوصافي لا يعتد به إذا انفرد(@)(@@)(@@)(@@) $ 5289 - محمد بن عبد الرحمن بن خلاد الأنصاري من أهل المدينة يروي عن أم مبشر ولها صحبة روى عنه يحيى بن عبد الله بن أبي قتادة(@)(@@)(@@)(@@) $ 5290 - محمد بن إياس بن البكير الليثي المدني يروى عن بن عباس وعائشة وأبي هريرة وإياس أبوه شهد بدرا روى عنه أبو سلمة بن عبد الرحمن ونافع(@)(@@)(@@)(@@) $ 5291 - محمد بن النيل الفهري يروي عن بن عمر روى عنه الليث بن سعد وقد قيل محمد بن النيل(@)(@@)(@@)(@@) $ 5292 - محمد بن عبيد بن أوس يروي عن بن الزبير روى عنه أبو مالك الأشجعي PageV05P379(@)(@@)(@@)(@@) $ 5293 - محمد بن عبيد أبو قدامة الحنفي يروي عن عبد الله بن عمرو روى عنه قتادة بن دعامة(@)(@@)(@@)(@@) $ 5294 - محمد بن عبيد الله بن سعيد الأعور أبو عون الثقفي من أهل الكوفة يروي عن جابر بن سمرة وهو الذي يروي عن عبد الله بن شداد روى عنه الثوري ومسعر مات في ولاية خالد على العراق(@)(@@)(@@)(@@) $ 5295 - محمد بن الوليد بن عبادة بن الصامت الأنصاري يروي عن عبادة بن الصامت عداده في أهل الشام روى عنه عيسى بن سنان(@)(@@)(@@)(@@) $ 5296 - محمد بن عمارة بن حزم الأنصاري من أهل المدينة يروي عن أبي هريرة وابن عباس روى عنه يحيى بن سعيد الأنصاري وأبو الزناد(@)(@@)(@@)(@@) $ 5297 - محمد بن أفلح مولى أبي أيوب الأنصاري يروي عن أسامة بن زيد عداده في أهل المدينة روى عنه عثمان بن حكيم(@)(@@)(@@)(@@) $ 5298 - محمد بن مسلم بن عائذ يروي عن أنس بن مالك روى عنه أهل العراق مات سنة إحدى وثلاثين ومائة وهو الذي يروي عن عامر بن سعد بن أبي وقاص(@)(@@)(@@)(@@) $ 5299 - محمد بن أفلح يروي عن أبي هريرة روى عنه يعلى بن عطاء وحميد الطويل إن لم يكن الأول فلا أدرى من هو PageV05P380(@)(@@)(@@)(@@) $ 5300 - محمد بن إبراهيم بن الحارث بن خالد بن صخر بن عامر بن كعب بن سعد بن تيم بن مرة التيمي من أهل المدينة سمع بن عمر ورأى أنسا إلا 
ms791	 أن أكثر روايته عن أبي سلمة وعلقمة بن وقاص وكان أبوه من المهاجرين الأولين روى عنه يحيى بن سعيد الأنصاري ومحمد بن إسحاق مات سنة إحدى وعشرين ومائة وأمه ابنة أبي يحيى من سعد العشيرة(@)(@@)(@@)(@@) $ 5301 - محمد بن عمر المحرمي الحمصي كنيته أبو خالد يروي عن عبد الله بن بسر روى عنه يحيى بن صالح الوحاظي وخطاب بن عثمان الفوزي(@)(@@)(@@)(@@) $ 5302 - محمد بن هدية الصدفي يروي عن عبد الله بن عمر روى عنه شراحيل بن يزيد المعافري(@)(@@)(@@)(@@) $ 5303 - محمد بن يزيد بن أبي يزيد يروي عن بلال روى عنه عمر مولى غفرة(@)(@@)(@@)(@@) $ 5304 - محمد بن أبي يحيى أبو العلانية يروي عن PageV05P381 بن أبي أوفى روى عنه عبد الرحمن بن مهدي(@)(@@)(@@)(@@) $ 5305 - محمد بن عاصم القرشي يروي عن أنس بن مالك وشعيب بن الحبحاب روى عنه حميد بن مسعدة(@)(@@)(@@)(@@) $ 5306 - محمد مولى بنى هاشم قال رأيت بن عمر وابن عباس يمشيان بين يدي الجنازة روى عنه قتادة لا أدري من هو(@)(@@)(@@)(@@) $ 5307 - مالك بن جعشم المدلجي أخو سراقة بن جعشم يروي عن أخيه روى عنه ابنه عبد الرحمن بن مالك بن جعشم(@)(@@)(@@)(@@) $ 5308 - مالك بن أوس بن الحدثان بن الحارث بن عوف بن ربيعة بن يربوع بن واثلة بن دهمان بن نصر بن معاوية بن بكر بن هوازن النصري المدني من بني نصر بن معاوية أخو جشم بن معاوية يروي عن عمر بن الخطاب وعثمان بن عفان وعلى بن أبي طالب وكان من فصحاء العرب روى عنه الزهري والناس مات سنة ثنتين وتسعين ومن زعم أن له صحبة فقد وهم PageV05P382(@)(@@)(@@)(@@) $ 5309 - مالك بن يخامر السكسكي يروي عن معاذ بن جبل ومعاوية أصله من اليمن انتقل إلى الشام روى عنه أهلها مات في ولاية عبد الملك بن مروان حيث سار إلى مصعب بن الزبير(@)(@@)(@@)(@@) $ 5310 - مالك بن أبي عامر الأصبحي حليف عثمان بن عبيد الله التيمي القرشي من أهل المدينة كنيته أبو أنس وهو جد مالك بن أنس يروي عن عمر وعثمان 
ms792	 وطلحة روى عنه سليمان بن يسار وابنه نافع بن مالك وكان فيمن فرض له عثمان وهو حليف بني تيم(@)(@@)(@@)(@@) $ 5311 - مالك بن دينار مولى لبني ناجية بن سامة بن لؤي بن غالب القرشي كنيته أبو يحيى من أهل البصرة يروي عن أنس بن مالك وكان من زهاد التابعين والأخيار والصالحين كان يكتب المصاحف بالأجرة ويتقوت بأجرته وكان يجانب الإباحات جهده ولا يأكل شيئا من الطيبات وكان من المتعبدة الصبر والمتقشفة الخشن مات سنة ثلاث وعشرين ومائة ويقال سنة ثلاثين ومائة ويقال سنة إحدى وثلاثين ومائة وقد قيل سنة سبع PageV05P383 وعشرين ومائة والصحيح أنه مات قبل الطاعون وكان الطاعون سنة إحدى وثلاثين ومائة(@)(@@)(@@)(@@) $ 5312 - مالك بن عياض الدار يروي عن عمر بن الخطاب روى عنه أبو صالح السمان وكان مولى لعمر بن الخطاب أصله من جبلان(@)(@@)(@@)(@@) $ 5313 - مالك بن صحار الهمداني يروي عن حذيفة وابن عباس روى عنه الشعبي(@)(@@)(@@)(@@) $ 5314 - مالك بن عامر أبو عطية الهمداني وقد قيل مالك بن زبيد من أهل الكوفة يروي عن عمر وابن مسعود روى عنه خيثمة ومحمد بن سيرين(@)(@@)(@@)(@@) $ 5315 - مالك بن الحارث الكوفي السلمي أبو موسى يروي عن علي بن أبي طالب وابن عباس روى عنه محمد بن قيس وأهل الكوفة PageV05P384 مات في آخر ولاية الحجاج بن يوسف سنة خمس وتسعين(@)(@@)(@@)(@@) $ 5316 - مالك بن سعد التجيبي من أهل مصر يروي عن بن عباس روى عنه مالك بن خير الزيادي وقد قيل إنه مالك بن ربيعة التجيبي(@)(@@)(@@)(@@) $ 5317 - مالك بن جوين الحضرمي يروي عن علي بن أبي طالب وقد قيل مالك بن الجون روى عنه شيخ يقال له عثمان الثقفي(@)(@@)(@@)(@@) $ 5318 - مالك بن عبد الله الخثعمي كان يسكن لد من فلسطين من العباد يروي عن جماعة من الصحابة روى عنه أهل فلسطين مات فوجد على ساقه مكتوب لله بخط بين الجلد واللحم(@)(@@)(@@)(@@) $ 5319 - مالك بن هرم يروي عن عوف بن مالك وعبد الله بن حوالة PageV05P385 روى عنه ربيعة بن لقيط(@)(@@)(@@)(@@) $ 5320 - مالك بن الصباح يروي 
ms793	 عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 5321 - مالك أبو داود الأحمري يروي عن حذيفة بن اليمان روى عنه الثوري(@)(@@)(@@)(@@) $ 5322 - مالك بن حمزة يروي عن أبي أسيد الساعدي روى عنه عبد الرحمن بن سليمان بن الغسيل(@)(@@)(@@)(@@) $ 5323 - مالك بن أبي مريم الحكمي يروي المراسيل ويروي عن عبد الرحمن بن غنم عداده في أهل الشام روى عنه حاتم بن حريث الطائي(@)(@@)(@@)(@@) $ 5324 - مالك بن يسار البصري يروي عن بن الزبير روى عنه زيد بن هاشم(@)(@@)(@@)(@@) $ 5325 - مالك بن أبي رشيد يروي عن عائشة روى الزبيدي عن حميد بن عبد الله عنه(@)(@@)(@@)(@@) $ 5326 - مالك بن نمير الأزدي الخزاعي بصري يروي عن أبيه وله صحبة روى عنه عصام بن قدامة PageV05P386(@)(@@)(@@)(@@) $ 5327 - مالك بن كعب الأزدي يروي عن بن مسعود روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 5328 - مالك بن يزيد بن ذي حماية يروي عن عائشة روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 5329 - مالك بن شرحبيل الشامي يروي عن شداد بن أوس روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 5330 - مالك بن ضبة الناجي يروي عن أنس بن مالك روى عنه منذر الثوري(@)(@@)(@@)(@@) $ 5331 - مالك بن المنذر بن الجارود يروي عن أبي هريرة وأبي سعيد روى عنه يحيى بن يزيد(@)(@@)(@@)(@@) $ 5332 - مالك بن ظالم يروي عن أبي هريرة روى عنه سماك بن حرب ثنا محمد بن عبد الله بن الجنيد قال حدثنا قتيبة بن سعيد قال ثنا PageV05P387 أبو عوانة عن سماك عن مالك بن ظالم قال سمعت أبا هريرة يقول لمروان بن الحكم سمعت رسول الله صلى الله عليه وسلم يقول إن فساد أمتي على يدي أغيلمة من سفهاء قريش(@)(@@)(@@)(@@) $ 5333 - مالك بن ادا ويقال بن أدنان يروي عن النعمان بن بشير روى عنه أبو إسماعيل(@)(@@)(@@)(@@) $ 5334 - مالك بن أبي سهم مولى أهل مكة يروي عن بن عمر روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 5335 - أبو مريم السلولي اسمه مالك بن ربيعة يروي عن جماعة من الصحابة روى عنه أهل 
ms794	 الكوفة(@)(@@)(@@)(@@) $ 5336 - مالك بن مالك يروي عن صفية بنت حي وكان صديقا لمسروق روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 5337 - مالك بن الصباح يروي عن رجل من ثقيف عن النبي صلى الله عليه وسلم روى عنه عطاء بن السائب PageV05P388(@)(@@)(@@)(@@) $ 5338 - مالك بن الحارث النخعي الأشتر ولاه علي على مصر وهو مالك بن الحارث بن عبد يغوث بن مسلمة بن ربيعة بن الحارث بن جذيمة بن سعد بن مالك بن النخع(@)(@@)(@@)(@@) $ 5339 - مالك بن أسماء بن خارجة يروي عن رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل الكوفة روى عنه المسعودي(@)(@@)(@@)(@@) $ 5340 - مالك بن أبي جمرة يروي عن عائشة وقد قيل بن أبي حمزة روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 5341 - مالك بن أنس شيخ يروي عن بن عمر روى عنه المغيرة بن النعمان(@)(@@)(@@)(@@) $ 5342 - مالك شيخ يروي عن أم ورقة روت عنه بنته ليلى بنت مالك(@)(@@)(@@)(@@) $ 5343 - مالك بن حصين بن عقبة الفزاري من أهل الكوفة يروي المراسيل روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 5344 - مالك بن عبد المعافري يروي المراسيل روى عنه جعفر بن PageV05P389 عبد الله بن أوس بن الحكم(@)(@@)(@@)(@@) $ 5345 - مالك بن زبيد الهمداني يروي عن أبي ذر وجالس عليا روى عنه أبو إسحاق السبيعي وابنه محمد بن مالك(@)(@@)(@@)(@@) $ 5346 - مالك شيخ يروي عن سلمان روى عنه أبو إسحاق السبيعي إن لم يكن مالك بن مالك فلا أدري من هو(@)(@@)(@@)(@@) $ 5347 - مسلم بن يسار أبو عبد الله مولى لبني أمية عداده في أهل البصرة وكان من عبادها وزهادها أدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم وأكثر روايته عن أبي قلابة وأبي الأشعث روى عنه محمد بن سيرين وابنه عبد الله شهد الجماجم لم يرم فيه بسهم ولا طعن فيه برمح مات سنة مائة وقد قيل إنه مولى طلحة بن عبيد الله(@)(@@)(@@)(@@) $ 5348 - مسلم بن يسار أبو عثمان رضيع عبد الملك بن مروان وهو الذي يقال له الطنبذي يروي عن أنس بن مالك وأبي هريرة عداده 
ms795	 في أهل مصر روى عنه أهلها(@)(@@)(@@)(@@) $ 5349 - مسلم بن يسار الجهني يروي عن عمر بن الخطاب روى عنه عبد الحميد PageV05P390 بن عبد الرحمن بن زيد بن الخطاب(@)(@@)(@@)(@@) $ 5350 - مسلم بن يسار بن سكرة المكي يروي عن بن عمر روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 5351 - مسلم بن عقيل بن أبي طالب الهاشمي كنيته أبو داود وكان أشبه ولد عبد المطلب بالنبي صلى الله عليه وسلم أدرك جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه صفوان بن موهب(@)(@@)(@@)(@@) $ 5352 - أبو الضحى اسمه مسلم بن صبيح مولى لآل سعيد بن العاص القرشي يروي عن بن عمر وابن العباس والنعمان بن بشير عداده في أهل الكوفة روى عنه منصور والأعمش والناس مات سنة مائة في خلافة عمر بن عبد العزيز(@)(@@)(@@)(@@) $ 5353 - مسلم بن الحارث بن مسلم التميمي يروي عن أبيه ولأبيه صحبة روى عنه عبد الرحمن بن حسان الكندي(@)(@@)(@@)(@@) $ 5354 - مسلم بن أبي بكرة الثقفي يروي عن أبيه عداده في أهل البصرة PageV05P391 روى عنه أهلها وعثمان الشحام(@)(@@)(@@)(@@) $ 5355 - مسلم بن مهران القرشي أبو المثنى مؤذن الجامع بالكوفة يروي عن بن عمر روى عنه أبو جعفر مؤذن مسجد العربان وابن ابنه محمد بن إبراهيم بن مسلم(@)(@@)(@@)(@@) $ 5356 - مسلم بن باذان ويقال باذام يروي عن رجل من أصحاب النبي صلى الله عليه وسلم في الاحتكار روى عنه عمارة بن ثوبان(@)(@@)(@@)(@@) $ 5357 - مسلم بن مرة بن عمرو بن عبد الله الجمحي القرشي الحجازي يروي عن بن عمر روى عنه يحيى بن سعيد الأنصاري والثوري ومالك وابن عيينة(@)(@@)(@@)(@@) $ 5358 - مسلم بن بانك يروى عن بن عمر وعائشة روى عنه ابنه سعيد بن مسلم المديني قال دخلت أنا وعبد الرحمن بن أبي بكر على عائشة فسمعتها تقول ويل للأعقاب من النار رواه زياد بن يونس عن سعيد بن مسلم عن أبيه PageV05P392(@)(@@)(@@)(@@) $ 5359 - مسلم بن جندب الهذلي يروي عن بن عمر وكان قاضي أهل المدينة روى عنه يحيى بن سعيد الأنصاري وزيد بن أسلم ويحيى بن أبي كثير 
ms796	 مات سنة ست ومائة وكنيته أبو عبد الله(@)(@@)(@@)(@@) $ 5360 - مسلم بن أبي حرة يروي عن بن الزبير روى عنه عمارة بن غزية(@)(@@)(@@)(@@) $ 5361 - أبو حسان الأعرج اسمه مسلم من أهل البصرة قتل يوم الحرورية يروي عن بن عباس روى عنه قتادة(@)(@@)(@@)(@@) $ 5362 - مسلم أبو عبد الله يروي عن أبي الغادية روى عنه أبو بكر بن عياش(@)(@@)(@@)(@@) $ 5363 - مسلم بن جبير الجرشي يروي عن بن عمر روى عنه يعلى بن عطاء(@)(@@)(@@)(@@) $ 5364 - مسلم مولى خالد بن عرفطة يروي عن خالد بن عرفطة روى عنه خالد بن سلمة(@)(@@)(@@)(@@) $ 5365 - مسلم أبو العلانية يروي عن أبي سعيد الخدري روى عنه محمد بن سيرين(@)(@@)(@@)(@@) $ 5366 - مسلم بن مسلم أبو عبد الله الدمشقي من أهل الشام يروى عن PageV05P393 أبي الدرداء روى عنه يزيد بن عبيدة والقاسم بن عبد الرحمن(@)(@@)(@@)(@@) $ 5367 - مسلم أبو أكيس مولى عبد الله بن عامر بن كريز عداده في أهل الشام يروي عن أبي عبيدة بن الجراح روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 5368 - مسلم الخولاني أبو شرحبيل يروي المراسيل عداده في أهل الشام روى عنه ابنه شرحبيل بن مسلم الخولاني(@)(@@)(@@)(@@) $ 5369 - مسلم أبو سعيد يروي عن بن مسعود روى عنه أبو يعفور(@)(@@)(@@)(@@) $ 5370 - مسلم بن سعيد مولى بن الحضرمي يروي عن أبي جهيم رجل من أصحاب النبي صلى الله عليه وسلم روى عنه يزيد بن خصيفة(@)(@@)(@@)(@@) $ 5371 - مسلم بن عمار الجرشي يروي عن بن عباس روى عنه PageV05P394 عبد الحميد بن واصل(@)(@@)(@@)(@@) $ 5372 - مسلم بن سمعان يروي عن أبي هريرة عداده في أهل المدينة روى عنه بن عجلان وهو أخو سعيد بن سمعان مولى بنى رزيق(@)(@@)(@@)(@@) $ 5373 - مسلم بن سلام أبو عبد الملك الحنفي يروي عن علي بن طلق روى عنه عيسى بن حطان(@)(@@)(@@)(@@) $ 5374 - مسلم بن السائب بن خباب يروي المراسيل روى عنه سليمان بن يسار(@)(@@)(@@)(@@) $ 5375 - مسلم بن سالم أبو فروة النهدي من أهل الكوفة كان نازلا في جهينة ويقال له الجهني يروي عن عبد الله بن عكيم روى عنه 
ms797	 الثوري(@)(@@)(@@)(@@) $ 5376 - مسلم بن سلمان يروي عن عمر روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 5377 - مسلم بن عويمر بن الأجدع يروى عن بن عمر وابن عباس PageV05P395 روى عنه أبو بكر بن حفص(@)(@@)(@@)(@@) $ 5378 - مسلم بن قرظة الأشجعي بن عم عوف بن مالك كنيته أبو المقدام يروي عن عوف بن مالك ستكون عليكم أئمة تحبونهم ويحبونكم الحديث عداده في أهل الشام روى عنه يزيد بن يزيد بن جابر وربيعة بن يزيد ورزيق بن حيان ورواه عبد الرحمن بن يزيد بن جابر عن رزيق بن حيان عن مسلم بن قرظة(@)(@@)(@@)(@@) $ 5379 - أبو نوفل الكناني اسمه مسلم بن أبي عقرب وقد قيل معاوية بن مسلم بن عمرو بن أبي عقرب يروي عن بن عباس وابن الزبير وعائشه روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 5380 - مسلم بن عياض يروي عن الحسين بن علي روى عنه نسير بن ذعلوق PageV05P396(@)(@@)(@@)(@@) $ 5381 - مسلم بن عبيد الله بن عبد الله بن شهاب الزهري القرشي يروي عن أبي هريرة روى عنه ابنه محمد بن مسلم الزهري(@)(@@)(@@)(@@) $ 5382 - مسلم بن مخراق مولى حذيفة بن اليمان يروي عن حذيفة روى عنه فضيل بن عمرو أبو عمرو(@)(@@)(@@)(@@) $ 5383 - مسلم بن مخراق يروي عن عائشة روى عنه زياد بن نعيم الحضرمي(@)(@@)(@@)(@@) $ 5384 - مسلم بن مخراق مولى بني قرة من عبد القيس يروي عن بن عمر روى عنه بن عون وشعبة(@)(@@)(@@)(@@) $ 5385 - مسلم بن مخراق كنيته أبو الأسود يروي عن أبي بكرة ومعقل بن يسار روى عنه سوادة بن أبي الأسود PageV05P397(@)(@@)(@@)(@@) $ 5386 - مسلم العجلي يروي عن سمرة بن جندب روى عنه ابنه سليمان بن مسلم(@)(@@)(@@)(@@) $ 5387 - مسلم بن أبي مسلم الخياط يروي عن بن عمر وأبي هريرة روى عنه بن أبي ذئب وابن عيينة وكان يسكن المدينة في دار العطارين(@)(@@)(@@)(@@) $ 5388 - مسلم بن القاسم يروي عن ليلى روى علي بن هاشم عن أبيه عنه(@)(@@)(@@)(@@) $ 5389 - مسلم بن مخشى يروي عن أبي الفراسي عداده في أهل مصر كنيته أبو معاوية روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 5390 
ms798	 - مسلم بن مشكم أبو عبيد الله من أهل دمشق يروي عن معاذ بن جبل وأبي الدرداء وزيد بن أرقم روى عنه أهل الشام(@)(@@)(@@)(@@) $ 5391 - مسلم بن نذير السعدي يروي عن حذيفة بن اليمان روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 5392 - مسلم المصبح الكوفى يروى عن بن عمر وكان رجلا PageV05P398 صالحا روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 5393 - مسلم بن نبهان يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه محمد بن موسى(@)(@@)(@@)(@@) $ 5394 - مسلم بن هيصم يروي عن النعمان بن مقرن والأشعث بن قيس روى عنه مقاتل بن حيان(@)(@@)(@@)(@@) $ 5395 - مسلم بن عبيد أبو نصيرة الواسطي الدمشقي سمع أنسا ويروي عن أبي رجاء العطاردي روى عنه هشيم ويزيد بن هارون وأهل الشام كان يخطىء على قلة روايته حدثنا أحمد بن علي بن المثنى حدثنا أبو خيثمة حدثنا يزيد بن هارون أنا أبو نصيرة مسلم بن عبيد قال سمعت أبا عسيب مولى رسول الله صلى الله عليه وسلم يقول قال رسول الله صلى الله عليه وسلم أتاني جبرائيل بالحمى والطاعون فأمسكت الحمى بالمدينة وأرسلت الطاعون إلى الشام والطاعون شهادة لأمتي ورحمة لهم ورجس على الكافرين(@)(@@)(@@)(@@) $ 5396 - مسلم بن هرمز والد يعلى بن مسلم وسليم بن مسلم وعبد الله بن مسلم يروي عن علي بن أبي طالب ومعاوية روى عنه ابنه عبد الله بن مسلم بن هرمز PageV05P399(@)(@@)(@@)(@@) $ 5397 - مسلم بن يزيد أحد بني سعد بن بكر بن قيس يروي عن أبي شريح الخزاعي روى عنه الزهري(@)(@@)(@@)(@@) $ 5398 - مسلم بن يناق والد الحسن بن مسلم من أهل مكة يروي عن بن عمر روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 5399 - مسلم بن زياد القرشي مولى أم حبيبة قال رأيت على أنس بن مالك خفين أبيضين روى عنه بقية بن الوليد ومن زعم أنه محمد بن زياد فقد وهم(@)(@@)(@@)(@@) $ 5400 - مسلم بن بديل شيخ يروي عن أبي هريرة قال رأيت النبي صلى الله عليه وسلم يشرب على راحلته ثم ناول الذي على يمينه روى يونس 
ms799	 بن عبيد عن الصلت بن غالب الهجيمي عنه وهو الذي روى عنه عبد الله بن عون حديث الطفيل بن عمرو الدوسي(@)(@@)(@@)(@@) $ 5401 - مسلم الهمداني يروي عن عوف بن مالك الأشجعي روى عنه ابنه يحيى بن مسلم PageV05P400(@)(@@)(@@)(@@) $ 5402 - مسلم بن عقال(@)(@@)(@@)(@@) $ 5403 - ومسلم بن عمار(@)(@@)(@@)(@@) $ 5404 - ومسلم بن أبي كريمة(@)(@@)(@@)(@@) $ 5405 - ومسلم بن هرمز(@)(@@)(@@)(@@) $ 5406 - ومسلم مولى علي رووا هؤلاء عن علي بن أبي طالب إلا أني لست أعتمد عليهم ولا يعجبني الاحتجاج بهم لما كانوا فيه من المذهب الردى(@)(@@)(@@)(@@) $ 5407 - موسى بن طلحة بن عبيد الله التيمي القرشي كنيته أبو عيسى انتقل من المدينة إلى الكوفة يروي عن أبيه وعائشة روى عنه سماك بن حرب وطلحة بن يحيى مات بالكوفة سنة أربع ومائة وأمه خولة بنت القعقاع بن معبد بن زرارة بن عدس(@)(@@)(@@)(@@) $ 5408 - موسى بن أنس بن مالك قاضي البصرة يروي عن أبيه روى عنه مكحول وحميد الطويل مات بعد أخيه النضر بن أنس وهو أخو موسى وعمر وأبي بكر بني أنس بن مالك(@)(@@)(@@)(@@) $ 5409 - موسى بن سعد بن زيد بن ثابت الأنصاري يروى عن زيد بن PageV05P401 ثابت روى عنه عمر بن محمد العمري(@)(@@)(@@)(@@) $ 5410 - موسى بن حكيم يروي عن عثمان بن عفان روى بن عون عن محمد بن عبيد الله عنه(@)(@@)(@@)(@@) $ 5411 - موسى بن عبد الله بن قيس يروي عن أبي رافع روى عنه سالم أبو النضر(@)(@@)(@@)(@@) $ 5412 - موسى بن إبراهيم بن عبد الله بن أبي ربيعة المخزومي يروي عن سلمة بن الأكوع روى عنه الدراوردي وأهل المدينة(@)(@@)(@@)(@@) $ 5413 - موسى بن سلمة بن المحبق الهذلي يروي عن بن عباس وأبيه روى عنه قتادة وأبو التياح(@)(@@)(@@)(@@) $ 5414 - موسى بن أيوب أبو الفيض يروي عن معاوية بن أبى سفيان PageV05P402 روى عنه شعبة بن الحجاج وربما أدخل بينه وبين أبي الفيض رجلا آخر(@)(@@)(@@)(@@) $ 5415 - موسى بن سحيم يروي عن بن عمر روى عنه أبو بشر جعفر بن أبي وحشية(@)(@@)(@@)(@@) $ 5416 - موسى بن عبد الله بن يزيد الخطمي الأنصاري يروي عن أبيه 
ms800	 روى عنه الأعمش(@)(@@)(@@)(@@) $ 5417 - موسى بن مسلم بن أبي مسلم مولى بنت قارظ من أهل الحجاز يروي عن أبي هريرة روى عنه أسامة بن زيد(@)(@@)(@@)(@@) $ 5418 - موسى بن أبي موسى الأشعري يروى عن بن عباس وأبيه روى عنه أسيد ومقاتل بن بشير(@)(@@)(@@)(@@) $ 5419 - موسى بن عبيد مولى خالد بن عبد الله بن أسيد يروي عن بن عمر روى عنه واصل مولى أبي عيينة(@)(@@)(@@)(@@) $ 5420 - موسى بن صالح البزاز يروي عن معيقيب روى عنه زهير بن معاوية PageV05P403(@)(@@)(@@)(@@) $ 5421 - موسى بن أبي عائشة مولى آل جعدة بن هبيرة من أهل الكوفة كنيته أبو بكر رأى عمرو بن حريث وغيره من أصحاب النبي صلى الله عليه وسلم إلا أن أكثر روايته عن سعيد بن جبير وعبد الله بن شداد وعبيد الله بن عبد الله روى عنه الثوري وشعبة وزهير بن معاوية وكان موسى من المجتهدين قال عمرو بن قيس وكان جاره ما رفعت رأسي بليل قط إلا رأيت موسى بن أبي عائشة قائما يصلي طويل القيام(@)(@@)(@@)(@@) $ 5422 - موسى بن يسار مولى قيس بن مخرمة من أهل المدينة وهو عم محمد بن إسحاق يروي عن أبي هريرة روى عنه محمد بن إسحاق وداود بن قيس الفراء(@)(@@)(@@)(@@) $ 5423 - موسى بن عقبة بن أبي عياش مولى الزبير بن العوام وقد قيل مولى أم خالد بنت خالد من أهل المدينة أخو إبراهيم ومحمد ابني عقبة رأى موسى بن عمر وسهل بن سعد ويروي عن أم خالد بنت خالد بن سعيد بن العاص ولها صحبة روى عنه الثوري وشعبة PageV05P404 مات سنة إحدى وأربعين ومائة وقد قيل سنة خمس وثلاثين ومائة كنيته أبو محمد(@)(@@)(@@)(@@) $ 5424 - موسى بن ميسرة مولى بني الديل بن بكر كنيته أبو عروة من أهل المدينة وهو خال ثور بن يزيد الديلي يروي عن أنس بن مالك روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 5425 - موسى بن غليط وقد قيل بن أبي غليط يروي عن أبي هريرة روى عنه قرة بن خالد(@)(@@)(@@)(@@) $ 5426 - موسى بن دهقان يروي عن 