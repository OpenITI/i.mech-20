ms891	 -علي بن محمد بن عبد الحميد النيلي.(@)(@)(@@)(@@)(@@) $ نظام الدين: -محمد بن علاء بن الحسن.(@)(@)(@@)(@@)(@@) $ نظام الدين: -محمود...(@)(@)(@@)(@@)(@@) $ نقره كار (1) :(@)(@)(@@) عبد الله بن محمد بن أحمد بن الحسين.(@)(@)(@@)(@@)(@@) $ النقيب:(@)(@)(@@) -ابراهيم بن عبد المطلب بن علي.(@)(@)(@@)(@@)(@@) $ النقيب: -احمد بن أبي علي.(@)(@)(@@)(@@)(@@) $ النقيب: -عبد المطلب بن علي بن المختار.(@)(@)PageV05P229(@)(@)(@@)(@@)(@@) $ النقيب: -عدنان بن جعفر بن محمد...(@)(@)(@@)(@@)(@@) $ النقيب: -علي بن محمد بن علي بن محمد.(@)(@)(@@)(@@)(@@) $ النقيب: -القاسم بن الحسين بن القاسم.(@)(@)(@@)(@@)(@@) $ النقيب: -محمد الآوي...(@)(@)(@@)(@@)(@@) $ النقيب: -محمد بن حماد بن إدريس.(@)(@)(@@)(@@)(@@) $ النقيب: -محمد بن علي بن محمد بن رمضان.(@)(@)(@@)(@@)(@@) $ النقيب: -يونس بن احمد الحسيني.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف:(@)(@)(@@) -جعفر بن محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -الحسن بن علي بن الحسن بن زهرة.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -الحسن بن محمد بن الحسن بن محمد بن علي بن الحسن بن زهرة.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -الحسن بن محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -الحسن بن محمد بن علي بن زهرة.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -علي بن الحسين بن محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -علي بن حمزة بن علي بن الحسن بن زهرة.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ نقيب الأشراف: -محمد بن علي بن حمزة بن علي بن الحسن.(@)(@)(@@)(@@)(@@) $ نما (ابن... ) :(@)(@)(@@) -احمد بن محمد بن جعفر الحلي.(@)(@)(@@)(@@)(@@) $ نما (ابن... ) : -الحسن...(@)(@)(@@)(@@)(@@) $ نما (ابن... ) : -الحسن بن أحمد بن محمد بن جعفر.(@)(@)PageV05P230(@)(@)(@@)(@@)(@@) $ النوقارزي (1) (-نوكاريزي) :(@)(@)(@@) -محمد بن يوسف بن محمد بن يوسف.(@)(@)(@@)(@@)(@@) $ النهاوندي:(@)(@)(@@) -بدر الدين الناوندي.(@)(@)(@@)(@@)(@@) $ النيشابوري (2) :(@)(@)(@@) -الحسن بن محمد بن الحسين نظام الدين.(@)(@)(@@)(@@)(@@) $ النيشابوري: -عبد الله بن محمد بن أحمد بن الحسين.(@)(@)(@@)(@@)(@@) $ النيلي (3) :(@)(@)(@@) -عبد الحميد بن عبد الله بن أحمد...(@)(@)(@@)(@@)(@@) $ النيلي: -علي بن عبد الحميد.(@)(@)(@@)(@@)(@@) $ النيلي: -علي بن عبد الكريم بن عبد الحميد.(@)(@)(@@)(@@)(@@) $ النيلي: -علي بن عبد المجيد...(@)(@)(@@)(@@)(@@) $ النيلي: -علي بن محمد بن عبد الحميد...(@)(@)(@@)(@@)(@@) $ النيلي: -علي بن يوسف بن عبد الجليل.(@)(@)PageV05P231(@)(@)(@@)(@@)(@@) || «و»(@)(@)(@@)(@@)(@@) $ الواسطي (1) :(@)(@)(@@) -الحسين بن علي بن الحسين بن حماد الليثي.(@)(@)(@@)(@@)(@@) $ الواسطي: -علي بن الحسن بن أحمد بن مظاهر.(@)(@)(@@)(@@)(@@) $ الواسطي: -علي بن الحسين بن حماد الليثي...(@)(@)(@@)(@@)(@@) $ الواسطي: -علي بن حماد بن الحسين.(@)(@)(@@)(@@)(@@) $ الواسطي: -علي بن مظاهر...(@)(@)(@@)(@@)(@@) $ الواسطي: -الفضل بن يحيى 
ms892	 بن علي الطيبي.(@)(@)(@@)(@@)(@@) $ الواسطي: -محمد بن محمد بن الحسن بن طويل الصفار.(@)(@)(@@)(@@)(@@) $ الواعظ:(@)(@)(@@) -حيدر بن محمد بن علي.(@)(@)(@@)(@@)(@@) $ الواهاني:(@)(@)(@@) -أحمد بن الحسين...(@)(@)(@@)(@@)(@@) $ الوحيدي:(@)(@)(@@) -محمد بن يوسف بن محمد بن يوسف البيهقي.(@)(@)(@@)(@@)(@@) $ الوزير:(@)(@)(@@) -حيدر بن علي بن حيدر الآملي.(@)(@)(@@)(@@)(@@) $ الوزير: -فضل الله بن عماد الدولة.(@)(@)PageV05P232(@)(@)(@@)(@@)(@@) $ الوزير: -محمد الساوجي سعد الدين.(@)(@)(@@)(@@)(@@) $ الوزير: -محمد بن محمد اليزدي.(@)(@)(@@)(@@)(@@) $ وشاح (ابن... ) :(@)(@)(@@) -محمد بن محفوظ...(@)(@)(@@)(@@)(@@) $ وشاح بن علي بن محمود(@)(@)(@@) بن موسى بن رامي (لامي) بن دخوش ابن محمد بن علي بن موسى هكذا سرد نسبه بخطه في آخر الجزء الرابع من نسخة كتاب «المختلف» للعلامة الحلي (ذ 20: 220-221) كتبه المترجم له بخطه في حياة المؤلف وذكر في آخره أنه فرغ من الكتابة آخر نهار الأربعاء 16 شعبان المبارك من سنة 724 الهلالية فرحم الله من نظر فيه ودعا له بالمغفرة... محمد وآله اجمعين. انتهى كلامه. ويظهر منه أنه لم يكتبه للأجرة بل كتبه للنظر فيه والاستفادة منه، وهذه النسخة موجودة بطهران عند محمد باقر شهيد زاده.(@)(@)(@@)(@@)(@@) $ وشاح بن محمد بن حسن بن عتبة.(@)(@)(@@) كتب بخطه نسخة من «المختلف» للعلامة في 708 رآها صاحب «الرياض» واحتمل أن يكون هو والد شمس الدين محفوظ بن وشاح بن محمد الحلي معاصر ابن داود (أنوار: 146 و199) وليس احتماله صحيحا كما أنه غير وشاح بن علي المذكور آنفا وإن كانا متعاصرين لأن المترجم له كان من تلاميذ العلامة الحلي م 726 كما يظهر من نسخة من «المختلف» للعلامة (ذ 20: 218-221) من باب الحج إلى آخر الديون، كتبه صاحب الترجمة في 724 وعرضه على أستاذه فنظر فيه. والنسخة موجودة في (الرضوية) من وقف مير جبرئيل في 1037. وقطعة أخرى من باب الوديعة إلى آخر النكاح فرغ منه 727 وفراغ المصنف منه 707 أيضا في (الرضوية) ويوجد أيضا بخطه، الجزء الأول من هذا الكتاب إلى آخر صلاة المسافر وتوقيعه فيه: وشاح بن محمد بن عتبة. فرغ من(@)(@)PageV05P233(@) الكتابة 16 ج 2-725 وذكر أن فراغ مصنفه دام ظله في 4 ج 2-699 وذكر 
ms893	 أنه قابله وعرضه على نسخة الأصل. والجزء التالي له بخطه أيضا من أوائل الزكاة إلى أواخر الحج لكنه ناقص الآخر، وتلك النسخة موجودة عند الشيخ محمد الجواد الجزائري في النجف. ورأيت نسخة في خزانة السيد مهدي آل السيد حيدر بالكاظمية، هي الجزء الخامس منه، فرغ المؤلف منه في 707 وفرغ الكاتب-صاحب الترجمة-منه في 5 ذي القعدة 717.(@)(@)(@@) فظهر أنه لما ألف العلامة «المختلف» في 707 كتب وشاح بن محمد منه عدة نسخ عرض بعضها على المؤلف، منها ما كتبه أولا في 708 وقد رآها صاحب «الرياض» وذكر فيها تمام نسبه، ومنها ما كتبه 717 ذكر فيها بعض نسبه، ومنها ما كتبه 724 ولم يذكر فيها نسبه، ومنها ما كتبه 725 مع بعض نسبه، ومنها ما كتبه بعد وفاة المؤلف في 727 وكاتب هذه النسخ ليس هو وشاح بن علي المذكور قبله وليس وشاح بن محمد والد محفوظ المذكور في (الأنوار: 146 و199) .(@)(@)(@@)(@@)(@@) $ وصاف الحضرة:(@)(@)(@@) -عبد الله بن فضل الله بن عبد الله بن روزبه.(@)(@)PageV05P234(@)(@)(@@)(@@)(@@) || «ه»(@)(@)(@@)(@@)(@@) $ هارون بن الحسن بن علي.(@)(@)(@@) هو ضياء الدين أبو محمد هارون بن نجم الدين الحسن بن المير شمس الدين علي بن الحسن الطبري، المجاز من العلامة الحلي في 17 رجب 701 بإجازة مختصرة على ظهر «القواعد» (ذ 1: 178) الذي كتبه بخطه عن نسخة الأصل بخط مؤلفه العلامة الحلي. كتبها بعد قراءته عليه ووصفه فيها بقوله:(@)(@)(@@) [قرأه علي المولى الشيخ الإمام العالم الفاضل الكامل العلامة أفضل المتأخرين، لسان المتقدمين، ضياء الملة والحق والدين، أبو محمد هارون ابن المولى الإمام العالم الفاضل الزاهد العابد الورع شيخ الطائفة ركن الاسلام، عماد المؤمنين نجم الدين الحسن ابن السعيد الأمير شمس الدين علي بن الحسن الطيري أدام الله إفضاله وأعز إقباله وختم بالصالحات أعماله ووفقه لبلوغ أقصى النهايات ورزقه الترقي إلى أعلى ذرى الجلال، هذا الكتاب من أوله إلى آخره، قراءة مهذبة مرضية تشهد بكمال، وتعرب عن جودة قريحة. وسأل في أثناء القراءة وتضاعيف المباحثة، عن معضلات هذا الكتاب ومشكلاته، وبحث عن 
ms894	 دقائقه وشبهاته، وأمعن النظر في أصوله، وبالغ في الاجتهاد في تحصيل فروعه. ودخل ببحث هذا الكتاب تحت المجتهدين، واندرج في زمرة الفقهاء الفاضلين الذين جعلهم الله قدوة الصالحين، وورثة الأنبياء المرسلين، صلوات الله عليهم. وقد أجزت له رواية هذا الكتاب وغيره من مصنفاتي في سائر العلوم العقلية والنقلية عني. وكتب العبد الفقير إلى الله تعالى الحسن بن يوسف بن المطهر مصنف هذا الكتاب في 17 رجب سنة 701 والحمد لله وحده وصلى الله على سيدنا محمد النبي وآله الطاهرين].(@)(@)(@@) وكان قد كتب له إجازة مختصرة أخرى قبل التأريخ بيوم واحد، يظهر أن عباراتها لم تقنع المجاز الذي كان يطالب بشهادة علمية وليس إجازة للرواية فقط. وقد نقل صورة الإجازتين في «الرياض» . ومر والد صاحب الترجمة في ص 42.(@)(@)PageV05P235(@)(@)(@@)(@@)(@@) $ الهاشمي:(@)(@)(@@) -الحسن بن حمزة...(@)(@)(@@)(@@)(@@) $ الهاشمي: -محمد بن محمد بن احمد الكوفي.(@)(@)(@@)(@@)(@@) $ الهاشمي: -المرتضى تاج الدين.(@)(@)(@@)(@@)(@@) $ هبة الله بن أبي محمد الحسن الموسوي.(@)(@)(@@) معاصر العلامة الحلي، وصاحب «المجموع الرائق» (ذ 20: 55-56) الذي فرغ من الباب الثالث من المجلد الأول منه، نهار الجمعة من شهر صفر 703 وهو كتاب كثير الفائدة، تكلم في اعتباره شيخنا النوري في «خاتمة المستدرك» وقد أورد فيه تمام كتاب «جمل العلم والعمل» للمرتضى (ذ 5: 144) وتمام «الاعتقادات للصدوق» (ذ 2: 266) وتمام «المقنع» في الإمامة، للسد آبادي (النابس: 110-111) . وجد المترجم له لأمه أبو نصر محمد الموسوي النقيب في الكاظمية (الأنوار: 175) وابن عم والده زين الدين علي بن أبي عبد الله الحسين الموسوي.(@)(@)(@@)(@@)(@@) $ الهرقلي:(@)(@)(@@) -محمد بن اسماعيل بن الحسين.(@)(@)(@@)(@@)(@@) $ الهروي (1) :(@)(@)(@@) -حسين بن عالم بن محمد.(@)(@)(@@)(@@)(@@) $ الهروي: -علي التايبادي ابو بكر زين الدين.(@)(@)(@@)(@@)(@@) $ الهلال (ابن... ) :(@)(@)(@@) -محمد...(@)(@)(@@)(@@)(@@) $ الهلال (ابن... ) : -موسى بن الحسن بن يوسف...(@)(@)PageV05P236(@)(@)(@@)(@@)(@@) $ الهمداني (1) :(@)(@)(@@) -الحسن بن محمد بن أبي بكر بن أبي القاسم...(@)(@)(@@)(@@)(@@) $ الهمداني: -علي بن محمد بن علي...(@)(@)(@@)(@@)(@@) $ الهمداني: -فضل الله بن عماد الدولة.(@)(@)(@@)(@@)(@@) $ الهمداني: -محمد بن أبي بكر بن أبي القاسم الشهيد.(@)(@)(@@)(@@)(@@) $ هندي:(@)(@)(@@) -يوسف بن عبد الكريم بن هبيل.(@)(@)(@@)(@@)(@@) $ الهيجاء (أبو... ) :(@)(@)(@@) -الحسن بن...(@)(@)(@@)(@@)(@@) $ الهيجاء (أبو... ) : -علي بن...(@)(@)PageV05P237(@)(@)(@@)(@@)(@@) || «ى»(@)(@)(@@)(@@)(@@) $ ياقوت المستعصمي:(@)(@)(@@) جمال الدين 
ms895	 خازن المكتبة المستنصرية. ذكرناه في (الأنوار: 203) لكنه بقي إلى المائة الثامنة.(@)(@)(@@) يحيى بن حمزة بن علي. هو الشريف المؤيد لدين الله يحيى ابن حمزة بن علي بن ابراهيم بن يوسف بن علي بن ابراهيم بن محمد ابن أحمد بن ادريس بن جعفر بن علي بن محمد بن علي بن موسى الكاظم (ع) العلوي اليمني الملقب بالمؤيد الزيدي. سرد نسبه كذلك محمد بن مصطفى الكاني في «بغية الخاطر» الذي ألفه 1033 وعده من أئمة الزيدية. وذكر أنه ولد 669 وقام بالأمر 729 وتوفي بحصن حران في 749 عن ثمانين سنة. أقول: يظهر من نسبه أنه من ولد جعفر بن علي الهادي المكنى بأبي الكرين لكثرة أولاده. والذي خرج في حقه بواسطة نواب الحجة التوقيع المشهور: [وأما سبيل عمي جعفر كسبيل إخوة يوسف... ]وللمترجم له تصانيف كثيرة، الموجود منها «الشامل لحقائق الأدلة العقلية والمسائل الدينية» (ذ 13: 13-14) الموجود عند شيخ الإسلام الزنجاني وفرغ من مجلداتها الثلاثة في 712. ومنها «الطراز في وجوه الاعجاز» المطبوع (ذ 15: 157) . ومنها «شرح نهج البلاغة» المسمى «بالديباج المضي» (ذ 8: 288 و14: 152-153) الموجود عند (السماوي) وعليه خط السيد أحمد بن السيد كاظم الرشتي بتعريف الكتاب ويظهر من النسخة أن المؤلف اثنا عشري ذكر له اسماعيل پاشا:(@)(@)(@@) «الاختبارات» في فقه الزيدية، «الأزهار» في مجلدين، «الإفحام» في الرد على الباطنية، «الاقتصاد» في النحو، «الانتصار» في 18 جزءا،(@)(@)PageV05P238(@) «الأنوار المضيئة» في شرح الأحاديث النبوية، «الايضاح لمعاني المفتاح» في الفرائض، مجلد «التحقيق في التكفير والتفسيق» ، «التصفية» في علم الباطن، «التمهيد في العلم والعدل والتوحيد» ، «الحاضر لفوائد مقدمة الطاهر» لابن بابشاذ في النحو، «الحاوي» في الفقه 3 مجلدات، «الديباج المضي» المذكور، «الجوابات الوافية بالبراهين الشافية» ، «الجواب الرائق في تنزيه الخالق» ، «الجواب القاطع عما يرد على الحكمة والتنزيه» ، «الطراز في علوم حقائق الاعجاز» مجلدين، «الشامل» في الفقه 4 مجلدات، «طوق الحمامة في مباحث الإمامة» ، «عقد اللآلي في الرد على أبي حامد الغزالي» ، «العمدة» في فقه الزيدية 6 مجلدات، «القانون المحقق في علم المنطق» ، «القسطاس» مجلدين، 
ms896	 «الكاشف للغمة عن الاعتراض على الأمة» ، «المحصل في شرح أسرار المفصل» 4 مجلدات، «مشكاة الأنوار في الرد على الباطنية الأشرار» ، «المعالم الدينية» مجلد، «المعيار» مجلد، «المنهاج» مجلدين، «نهاية الوصول إلى علم الأصول» ، «الوازعة لذوي الألباب عن فرط الشك والارتياب» ، «الوازعة للمعتدين عن سب أصحاب سيد المرسلين» . فكما ترى هو من الناحية الفلسفية شيعي ومن الناحية السياسية رافض للخلافة ومقر للإمامة الإلهية في الاثني عشر إماما وان كان لا يقر بالتبري من حكام الجور.(@)(@)(@@)(@@)(@@) $ يحيى بن القاسم بن عمر.(@)(@)(@@) هو الشريف العلوي العباسي المولود 680 كما ترجم في «مطلع البدور» لأحمد بن صالح اليمني م 1092. هو الراوي لدعاء «الصباح» (ذ 8: 190-192. ) بالوجادة عن أمير المؤمنين، وجدها بخطه كما نقلها المجلسي الثاني في «البحار 19: 136» وتاريخ نقل المترجم له للدعاء 27 ذي القعدة 734. أقول: وقد بقي المترجم له حتى 749 حيث حج في هذه السنة كما نقل في «مطلع البدور» عن الصفدي في «الوافي بالوفيات» .(@)(@)PageV05P239(@)(@)(@@)(@@)(@@) $ يحيى بن محمد بن الحسن.(@)(@)(@@) هو أبو المظفر يحيى بن فخر المحققين محمد ابن جمال الدين الحسن بن سديد الدين يوسف بن علي بن المطهر الحلي. من تلاميذ والده فخر المحققين وقد كتب جملة من تصانيف جده العلامة، منها «خلاصة الأقوال» (ذ 8: 214-215) الذي كتب عليه فخر المحققين إجازة لولده المترجم له الكاتب للنسخة وقد كتب بعض نسخ «الخلاصة» عن هذه النسخة، وصورة الإجازة منقولة في «مستدرك الإجازات» للميرزا محمد الطهراني العسكري نزيل سامراء.(@)(@)(@@)(@@)(@@) $ اليزدي (1) :(@)(@)(@@) -عبد الله بن فضل الله بن عبد الله بن روزبه.(@)(@)(@@)(@@)(@@) $ اليزدي: -علي...(@)(@)(@@)(@@)(@@) $ اليزدي: -محمد بن محمد...(@)(@)(@@)(@@)(@@) $ اليزدي: -محمد بن نظام الدين.(@)(@)(@@)(@@)(@@) $ اليمني:(@)(@)(@@) -يحيى بن حمزة بن علي الشريف.(@)(@)(@@)(@@)(@@) $ يوسف بن عبد الكريم بن هبيل.(@)(@)(@@) هو عز الدين أبو المحاسن يوسف الموصلي نزيل اليمن ذكره الشهاب ابن فضل الله، ونقل عن التاج عبد الباقي اليماني أنه ذكره في شعراء اليمن وقال: قدم من الموصل في حدود 680 أيام المظفر يوسف وأقام بها إلى 726 وركب البحر إلى الهند وهو في قبضة التسعين. وكان ذا 
ms897	 ذهن وقاد وكان يتشيع وينسج الحرير الموشى. ترجمه كذلك وأورد شعره في «الدرر الكامنة 5: 237-238» . فهو كردي عربي هندي.(@)(@)PageV05P240(@)(@)(@@)(@@)(@@) $ يوسف بن ناصر بن محمد بن حماد.(@)(@)(@@) جمال الدين أبو المحاسن الحسيني العلوي الغروي المشهدي كما في «الرياض» نقلا عن «المجموع العتيق» ناسبا إليه «غرر الدلائل والآيات في شرح السبع العلويات» وقلنا في (ذ 16: 40-41) إن المترجم له جعل لشرحه هذا مقدمة في أحوال الناظم ابن أبي الحديد (الأنوار: 88-89) نقلا عن ابن الفوطي وختم شرحه بنقل أربعة وعشرين حديثا في فضائل علي (ع) أوردها ابن أبي الحديد في شرح قوله: نحن الشعار... والخزنة والأبواب، ولا تؤتى البيوت إلا من أبوابها، ومن أتاها من غيرها سمي «سارقا» . وقال العسقلاني في «الدرر الكامنة 5: 228» يوسف بن حماد مفتي الشيعة. حج مرات وجاور وله نظم ومات 727 وقد نيف على الستين. أقول: هو من مشايخ تاج الدين بن معية (ص 197) م 776 كما ذكره في إجازته لشمس الدين محمد بن ابن المعالي (ص 177) المسطورة في «البحار» والمجيز والمجاز كلاهما من مشايخ الشهيد 786.(@)(@)(@@) ويروي عن صاحب الترجمة أحمد بن محمد بن الحداد (ص 11) من مشايخ الشهيد وأجازه في رواية قراءة عاصم والكسائي. وطريق روايته واجازته للشهيد أيضا مذكور في «البحار» . وممن روى عنه صاحب الترجمة حسين بن قتادة (1) بن روح الحسني المدني المقري الذي قرأ القرآن على أبي حفص عمر بن معنى الزبري الضرير امام مسجد الرسول (ص) . ويروي أيضا عن رضي الدين أبي عبد الله الدوري عن أبي الحرث الليث بن غالب البغدادي.(@)(@)(@@)(@@)(@@) $ يوسف بن النظام الحسيني.(@)(@)(@@) كتب بخطه الربع الثاني من تفسير «الكشاف» وفرغ منه في الثلاثا 24 صفر 754، والنسخة في مكتبة السيد خليفة اشتراها صالح الجعفري بالنجف.(@)(@)PageV05P241(@)(@)(@@)(@@)(@@) $ يونس بن أحمد الحسيني.(@)(@)(@@) كبير السادة الأشراف ناصر الدين الدمشقي. كان رئيسا وسيما، حدث عن خطيب مردا وذكر للنقابة.(@)(@)(@@) توفي عن إحدى وثمانين سنة في 726. هكذا ذكر في حوادث تلك السنة من «الشذرات» .(@)(@)PageV05P242(@)(@)(@)(@@)(@@)(@@) | الجزء السادس: الضياء اللامع فى القرن التاسع(@)(@)PageV06P001(@)(@)(@@)(@@)(@@) || «آ»(@)(@)(@@)(@@)(@@) $ الآملى (1) : محمد شاه المرعشى... 
ms898	(@)(@)(@@)(@@)(@@) $ الآملى : ظهير الدين بن نصير الدين...(@)(@)(@@)(@@)(@@) $ الآملى : محمود...(@)(@)(@@)(@@)(@@) || «ا»(@)(@)(@@)(@@)(@@) $ ابراهيم الاحساوى:(@)(@)(@@) هو حسام الدين ابراهيم ابن الحسن بن ابراهيم ابن أبى جمهور جد الشيخ محمد بن على بن ابراهيم بن ابى جمهور. وصفه هذا فى أول «غوالى اللئالى» -ذ 15: 359 و16: 71 المؤلف 897 أو 898 (2) بقوله: [الشيخ الولى الفاضل التقى من بين أنسابه وأحزابه حسام الدين... ]وكان قد كتب «الغوالى» بحضور مصنفه عام 899 كما فى نسخة الشيخ مشكور بالنجف.(@)(@)PageV06P001(@)(@)(@@)(@@)(@@) $ ابراهيم البحرانى:(@)(@)(@@) ابن عيسى ابن ابراهيم بن سلطان بن شبيب. كتب فى قطيف عام 838 كتاب «الكشكول فيما جرى على آل الرسول» (1) وقدراى صاحب «الرياض» النسخة بقزوين. والظاهر أن الكاتب من فضلاء البحرين. وعلى النسخة تملك الشيخ عبد الله بن اسماعيل بن محاسن المعمار الأسدى، واحتمل صاحب «الرياض» أنه ابن المعمار (1) الفقيه المشهور.(@)(@)(@@)(@@)(@@) $ ابراهيم البحرانى:(@)(@)(@@) ابن منصور بن على بن عشيرة الأوالى مولدا الجزائرى مغتربا والى ارض بابل طالبا وراغبا لزيارة أهل البيت (ع) كذا وصف نفسه فى شرحه على «الألفية» للشهيد-ذ 2: 296 و13: 108 وهو شرح ب «قال، أقول» . نسخة ناقصة الأول منه فى مكتبة (الخوانسارى) فرغ منه يوم الثلاثاء عام تسع او سبع وثمانمائة. ويأتى الحسن بن عشرة والحسن بن أحمد بن عشرة، والحسن بن يوسف بن عشرة. ولعل الجميع ابن عشيرة كما نراه ها هنا.(@)(@)(@@)(@@)(@@) $ ابرو: حافظ...(@)(@)(@@)(@@)(@@) $ الأحسائى (الاحساوى) : ابراهيم...(@)(@)(@@)(@@)(@@) $ الأحسائى : احمد...(@)(@)(@@)(@@)(@@) $ الأحسائى : الحسن المطوع.(@)(@)(@@)(@@)(@@) $ الأحسائى : على...(@)(@)(@@)(@@)(@@) $ الأحسائى : ناصر البويهى.(@)(@)(@@)(@@)(@@) $ أحمد الأحسائى:(@)(@)(@@) شهاب الدين أحمد بن محمد بن فهد بن الحسن بن محمد بن ادريس.(@)(@)(@@) ألف «خلاصة التنقيح» عام 806-ذ 7: 222-223 و13: 74 ويروى عن أحمد بن(@)(@)PageV06P002(@) عبد الله بن سعيد بن المتوج البحرانى. وصفه محمد بن على بن أبى جمهور فى اول «الغوالى» بالشيخ النحرير العلامة شهاب الدين احمد بن فهد بن ادريس المقرى الأحساوى وذكر أنه يروى عنه الشيخ جمال الدين حسن الشهير المطوع الجروانى الأحساوى وهو نسبة الى الجد وإلا فما ذكرت من نسبه هو الموجود فى متن كتابه «خلاصة التنقيح» المذكور.(@)(@)(@@)(@@)(@@) $ احمد 
ms899	 بن اسماعيل:(@)(@)(@@) بن أحمد بن ابراهيم بن على المتوج. كتب بخطه فى الحضرة الغروية نسخة من «معالم الدين فى فقه آل ياسين» لمحمد بن شجاع الأنصارى-ذ 21:(@)(@)(@@) 199 عن نسخة خط المؤلف فى حياته، لأنه دعى له بقوله: [أدام الله بركاته]وفرغ منه 10 شهر الصيام 832. والنسخة ناقصة الأول والأخير رأيتها فى دمشق عند السيد محسن الأمين مؤلف «أعيان الشيعة» لكنه لم يترجمه فيه ظاهرا. وظنى أن الكاتب كان تلميذ المصنف.(@)(@)(@@)(@@)(@@) $ احمد الأوائلى:(@)(@)(@@) هو فخر الدين أحمد بن محدم من تلاميذ فخر الدين احمد بن عبد الله ابن المتوح البحرانى. يروى عنه حرز الدين الأوائلى من مشايخ ابن أبى جمهور الأحسائى كما ذكره فى طريقه الثالث فى «غوالى اللئالى» ووصفه بالشيخ الزاهد العابد الورع فخر الدين أحمد ابن محدم الأوائلى وفى نسخة «رياض العلماء» «الاوايلى» بالياء فلعله الأوالى من قرى بحرين.(@)(@)(@@)(@@)(@@) $ احمد البحرانى:(@)(@)(@@) هو جمال الدين احمد بن عبد الله بن محمد بن على بن الحسن ابن المتوج. ترجمه سليمان الماحوزى م 1121 فى رسالة عملها فى تاريخ علماء البحرين (ذ 3: 266) بالتماس من صاحب «رياض العلماء» كما فى هامش النسخة التى كتبها مبارك بن على بن عبد الله ابن حميدان الجارودى فى 1167 عن نسخة خط المؤلف سليمان الماحوزى، فقال: [الشيخ العلامة جمال الدين أحمد... المتوج... كذا وجدته بخطه عطر الله مرقده فى آخر كتابه(@)(@)PageV06P003(@) «مختصر التذكرة» (-ذ 20: 187) فى إجازته لتلميذه الشيخ الفقيه فخر الدين أحمد بن فهد بن حسن بن محمد بن أدريس الأحسائى فى 802 الذى هو غير أحمد بن فهد الحلى صاحب «المهذب» و«عدة الداعى» وهما متعاصران]ثم ذكر من تصانيفه غير «مختصر التذكرة» كتاب «آيات الأحكام» و«مجمع الغرائب» فى الفقه ورسالة «كفاية الطالب» ونظم «أخذ الثار» ذ 24: 197 وبعد ترجمة جمال الدين ترجم ابنه فقال: ومنهم الشيخ الفاخر ذو المحامد والمآثر ناصر بن احمد المذكور. فقيه فاضل رأيت خطه فى بعض نسخ «الشرايع» .(@)(@)(@@) وحكى فى «انوار البدرين» عن سليمان الماحوزى أن كتابه فى شرح آيات الأحكام مختصر واسمه «منهاج 
ms900	 الهداية» (-ذ 23: 180-181) قال: وقد قرأته فى حداثة سنى عام 1091 على بعض مشايخى وفيه مسألة أعمية الطلاق البذلى من الخلع والمبارات. قال: وكتابه «مجمع الغرايب» كاسمه يشتمل على فروع غريبة رأيته 1102 وله رسالة فيما يعم به البلوى وفيها أن قبلة البحرين يجعل الجدى محاذيا لطرف الأذن اليمنى فليست كقبلة البصرة وذكر ورود حاكم الى البحرين سنة 1108 وموافقته لذلك. قال: وقبره بجزيرة اكل بمشهد النبى صالح وبجنبه قبر ابنه الشيخ ناصر وقد زرتهما مرارا. وترجمه صاحب «الرياض» فى قسم من الرياض حصلت عند الشيخ يوسف البحرانى فأوردها جميعا فى اوائل كشكوله ومتفرقة فى «اللؤلؤة» منها فى ذكر ابن المتوج فذكر نسبه كما نقل عن سليمان الماحوزى وقال إنه كان تلميذ فخر المحققين وأستاد أحمد بن فهد الأحسائى. وكأن صاحب «رياض العلماء» كتب هذه الترجمة بعد وصول رسالة سليمان الماحوزى اليه فهما متحدان تقريبا. وحكى عن «نظام الأقوال» : إنه كان معاصرا للفاضل المقداد فكلما يقول فى «كنزل العرفان» : قال المعاصر؛ فمراده ابن المتوج. قال: وله تفسير تكلم فيه على وجوه الآيات الناسخة والمنسوخة ثم استخرج منه الآيات الناسخة والمنسوخة وجعلها رسالة مستقلة لتسهيل التناول كما صرح به فى أوله -ذ 24: 9 وعبر عن كتابه «مجمع الغرايب» ب «غرائب المسائل» كما فى الخزانة (الرضوية) وحكى فى «اللؤلؤة» تعبير بعض معاصريه عنه ب «نهج الوسائل الى غرايب المسائل» وهو غير «مختصر التذكرة» الذى عليه الاجازة لتلميذه ابن فهد الأحسائى ومر سميه فى القرن الثامن ص 7.(@)(@)PageV06P004(@)(@)(@@)(@@)(@@) $ أحمد البحرانى:(@)(@)(@@) فخر الدين أحمد بن عبد الله بن سعيد بن المتوج البحرانى من تلاميذ فخر المحققين ابن العلامة الحلى م 771. يروى عنه احمد بن محمد بن فهد الحلى م 841 وتلميذه الآخر أحمد بن محمد السبيعى الآتى. توفى قبل 836 كما يظهر من تلميذه السبيعى وبعد 802 كما يظهر من تاريخ إجازته. له «الوسيلة» ، «النهاية» ، «الكفاية» وياتى تلميذه الآخر باسم احمد بن محدم الأوائلى. ويحتمل اتحاده مع جمال الدين احمد بن عبد الله بن محمد 