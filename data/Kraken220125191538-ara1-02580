ms2561	 القصم محمد بن أحمد بن محيى الادريسى الحسنى عرف بالسلاوى وعنه وأبى العباس أحمد بن محمد بن عبد الرحمن الازدى عرف بابن القصار أخذ العربية والاصول؛ وسمع الحديث على الخمسة الاولين من شيوخه وعلى أبيه وأبى فارس عبد العزيز بن مسعود بن عبد العزيز العجيسى التامسانى وأبى عبد الله عمد بن عبدالر حمن الربعى الصقلى وقال ان أول سماعه له كان فى سنة ثمان وثمانين وهو ابن تسع وأول اشتغاله فى القراءات فى سنة تسعين وفى الفقه فى سنة أربع وتسعين ، وارتحل فى سنة اثنتى عشرة فقدم القاهرة فى شوالها فجج ثم عاد فقطن القاهرة وكان يتردد الى بلاد الشام فطوف فالبها .(@)(@@) ونزل فى كثير منها وحصلت له حظوة من بنى البارزى وبنى الكويز وغيرهم.(@)(@@) و تحول شافعيا ثم ولى قضاء نا بلس فى سنة سبع وثلاثين استقلالا وكان كما قال المقريزى أول من استقل به فيها وسافر اليهامرة بعد أخرى وفى المرة الثانية جعل بها نائبا قرر عليه ضريبة معينة بحيث عزله الكمال بن البارزى لذلك ، وجال البسلاد ولق الرجال واشتهر أمره وكثر اخذ أهل البلاد عن واسفر عن كذب كنير (1) ف هامش الاصل : كل هذاخطأ وصوابه قسنطينة من بلاد الغرب الاوسط والنسبة اليهاقسنطينى، والقسطلانى ليس منها. عطار . أنظر ذيول تذكرة الحفاظ 76(@)(@)PageV10882P068(@) ============================================================(@) واختلاق غزير حتى فى نسبه فانه مرة ساقه كما قدمناه ومرة خالف فيه وقال مرة انه سفيانى ومرة وصل به الى على بن أبى طالب بعد انتسابه لخنيا وكذا اختلف كلامه فى شيوخه وفى المأخوذ عنهم وشحن البلاد بمختلقاته ومركباته . وقال شيخنا فى حرف الفاء من توضيح المشتبه أنه من أهل الفضل يستحضر كيرأ من الاخبار ويجول البلاد يقصه ، وأنه أخبره بمولده وأنه سنة ثمانين وسبعاتة وبأنه سمع من البطرنى وحدث عنه وعن غيره بالسماع ، قال وكثيرا مايطلق الاخيار فى الاجازة الخاصة والعامة وله فى ذلك ترا كيب موهمة وقد سئلت فى بعضها وأنا بحلب ونبهت على خطأ بعضها وكان السائل له ابن خطيب الناصرية فانه 
ms2562	 قال بعد أن ذكرأنه قدم حلب مرارا وأنزله عنده بالمدرسة الشرفية وهمل مواعيد بجامعها الكبير وغيرهوأثى عليه بالفضل واستحضار طرف من التاريخ وغيره وقال انه سمع منه بعض الطلبة المسلسل بالاولية بسند أو ققت عليه وسمى شيخنا فى سنة ست وثلاثين فأنكره وقال أنا أشك فى صحة قوله انه سمع من البطرنى لانه كان صغيرا حين توفى ولم يسكن بلديه بل ذكر أن أكثر من سمى من شيوخ السند لاوجود له فى الخارج، ثم قرأت بخط شيخنا ما نصه : وقفت له على أسانيد لعدة من الكتب المشهورة كلها مفتعلة وقد بينت خللها مع الذى أملاها عليه يعى به الجال بن السابق الحموى . وقال فى سنة ثمان وأربعين من إنبائه انه أطنب الجولان فى قرى الريف الأدنى يعمل المواعيد ويذكر الناس وهو يستحضر من التاريخ والاخبار الماضية شيئا كثير آولكن كان يخلط فى غالبها ويدعى معرفة الحديث النبوى ورجاله ويبالغ فى ذلك عند من يستجهله ويقصر فى المذاكرة به عند من يعرف أنه من أهل الفن وراج أمره فى ذلك دهرا طويلا وذكر أنه ولى قضاء نابلس بعناية الكال بن البارزى ثم هجره ، وصحب الزين عبد الرحمن بن الكويز وانقطع اليه مدة ثم فارقه . وكذا قال فى سنة سبع و ثلاثين منه انه تحول شافعيا لما ولى قضاء نابلس وانه كسثير الاستحضار للتواريخ وكان يتعانى عمل مواعيد بقرى مصروبدمياط و بلادالسواحل وصحب الناس وهو حسن العشرة نزه عفيف، وقد حدث بحلب عن البطرنى وما أظنه سمع منه فانه ذكرلنا أن مولده سنة ثمانين ببلده وكان البطرنى بتونس ومات بعدسنة تسعين قال ودأيت له عند أصحابنا بحلب إسنادا للمسلسل مختلقا الى السلفى وآخر أشد اختلاقا منه الى أبى نصر الوائلى وسئلت عنهما فبينت لهم فسادهما ثم وققت مع جمال الدين بن السابق الحموى على كراسة كتبها عنه بأسانيده فى الكتب الستة(@)(@)PageV10882P069(@) ============================================================(@) أكثرها مختلق وجلها مركب ، وأوقفى المقريزى له على تراجم كتبها له بخطه كلها مختلقة إلا الشىء اليسير غفر الله له، وقد 
ms2563	 كان المقريزى يعظمه جدا ورصفه بالشيخ الحافظ الرحال ذى الكنيتين ، وأكثر من الاعتماد عليه فيما كان يخبره به مما يتعلق بالتاريخ ونحوه من غير إفصاح بالنقل عنه على عادته موقال غيرهماممن أخذ عنهما لم أزل أسمع عنه الاعاجيب من كثرة الحفظ للاخبار القديمة والقوة على جوب البلاد والقدرة على مذاخلة الناس حتى اجتمعت به فى ذى القعدةسنة سبع وثلاثين فوجدته من دهاة العالم فصيعا مفوها قوى الحافظة عديم النظير فى ذلك بحيث أنه يأخذ كتاب العلم فيطلع فيه اطلاعة يحفظ غالبه منها، وبالغ(@) شيخنا فى تكذيبه واختلاقه وأما المقريزى فعلى الضد من ذلك فى اعتماده وتلقيبه بالحافظ ،وترجمه فى عقوده باختصار وأنشد عنه لغيره: لعمرك ماعدمت لواء مجد ولاكل الجوادعن السباق ولكنى بليت بحظ سوء كما تبلى المليحة بالطلاق وقد خرج فى سنة ثمان وأربعين فى بعض بلاد نابلس وأظهر أنه هو السفيانى واحتوى على عقول القلاحين فراج عليهم وتبعه خلق منهم ثم أحس منهم بانحلال عنه فانسل نحو بلاد الشمال حتى مات باللاذقية من بلاد طرا بلس الشام سنة تسع(@) وخمسين يعنى فى المحرم قال بعضهم ثم أخبرت أنه فى صفر سنة اثنتين وستين انتهى.(@)(@@) وقد أرخه فى سنة تسع الشمس المالقى بن المنير ويحتاج الى تحقيق، وجازف من قال إنه مات بمصر فى ربيع الأول سنة أربع وخمسين وقال وقد اتهمه ابن حجر فى سماعه من البطرنى ولاوجه لاتهامه انتهى . ويحتاج هذا القائل الى تآديب كنير سيما وقد علت وجه: 132(عد) بن أحمد بن محمد بن عبد الرحمن بن عمر بن رسلان البدر بن الشهاب ابن التاج بن الجلال بن السراج البلقينى الاصل القاهرى الشافعى والد عبد الباسط الماضى وابراهيم . ولد فى ذى القعدة سنة أربع وثلاثين وثمانماتة بجوار مدرسة جده السراج محارة بهاء الدين ، ونشأ بين أبويه فحفظ القرآن والعمدة وألفية العراقى والمنهاج الفرعى وابن الحاجب الأصلى والتوضيح لابن هشام والتلخيس للقزوينى وكان يصحح بعضها على الشمنى وبعضها على العزعبد السلام البغدادى، وعرض على شيخنا وغيره وأحذالفقه 
ms2564	 عن السيد النسابة والعلاء القلقشندى والمحلى والمناوى وعم جده العلمى وعمه أبى السعادات وبعضهم فى الاخذاكثر من بعض و كذأ عن الزين البوتيجى وما بل معه نصف النكت لشيخه الولى العراقى وعنه وعن(@)(@)PageV10882P070(@) ============================================================(@) بى الجود أخذ فى الفرائض وأخذ فى العريبة عن ابن خضر بمر افقتى وعن الابدى والعز عبذالسلام وفى أصول الفقه عن ابن حسان والتقى الحصنى وأخذ فى هذه العلوم رفى غيردا عن غير هؤلاء، وأذذ له عم جده فى الافتاء والتدريس بل ناب عنه وعن من بعده وتصدى لذلك مقبلا عليه بكليته ولذا تميز فى الشروطمه المداومة على الاسابة محيث كتب فتح البارى مرتين وظادم والتوسط واعراب السبين(@) و نحو مائه مجلد وخطه ليس بالطائل وصار يستحضر من كتابته كتيرا سيما الفقه وكثيرا ما كان يراجع فيه الجلال البكرى ، وأكثر من الحضور عند الصلاح المكبنى والخيضرى وكذا تردد الى كثيرا وراجعنى فى أشياء واستعان بي عند الناوى وغيره ؛ ودرس بالاثار برغبة أبيه له عنه وعمل فيه اجلاسا بحضرة عم جده تكلم فيه على بعض الآيات وكذا بجامع أصلم نيابة عن ولدى التقى بن الرسام وبالظاهرية القديقة نيابة عن أبى اليسر بن النقاش وقرر بعد عمه أبى السعادات فى وقف طقطجى رغيره مما ليس فيه كبير أمروحرم مع أحقيته من جميع من أخذ ، وحج فى سنة ست وثمانين وكان على قضاء المحمل ولم يتأنق فى ملبسه ولا مأكله بل ولاكان يركب الا نادرا مع يبس واقبال على شأنه ونسبة لتسامح وابتلاء(@) بأم أولاده الى أن تعلل اياما ثم مات فى ليلة ثامن جمادى الآولى سنة اثنتين وتسعين وصلى عليه بجامع الحاكم ثم دفن عند أبيه بمدرسة جده رحمه الله وإيانا .(@)(@)(@@) 133(عد) بن أحمد بن عد بن عبد الرحمن بن محد بن عمر بن عنمان بن أبى بكر ناصر الدين أبو القضل بن البهاء أبى حامد بن الشمس التيمى المصرى الشافعى والد أحمد ويعرف بابن المهندس . ولد كما قرأته بخطه فى سنة احدى وتسعين وسبعماثة بمصر ونشأبها فحفظ القرآن 
ms2565	 عند الشهاب الآشقر وتلابه لأبى عمرو عليه وعلى الكى أبى بكر السعودى الضرير وحفظ العمدة والتنبيه وألفية ابن ملك وعرض العمدة على السراجين البلقينى وابن الملقن والعراقى والهيثمى والفخر اتقايانى والشمس بن القطان والشرف القدسى المحدث والتنبيه على الضياء عحمد بن عحد بن محمدالسفطى شيخ الآثار والولى العراقى والعزبن جماعة وأجازوه وبحث فى الفقه على النور الادمى والعز بن جماعة ثم الشرف السبكى ؛ وسمع الحديث على أولهم والولى العراقى ونحوهما، وأكسثر عن شيخنا وكستب عنه من فتاويه جملة ولازم كتابة أماليه والنيابة عنه فى خطابة جامع همرو، وكذا التوقيع ببابه والملازمة(@) لحدمته حتى أنه سافرمعه الى حلب فى سبنة آمد؛ وسمع هناك على البرهان الحلبى الحافظ وغيره وبالشام وغيرها ودخل عنتاب وزار القدس والخليل؛ وحج غير(@)(@)PageV10882P071(@) ============================================================(@) 72 مرة أولها فى سنة إحدى وثلاثين وجاور بعدها، و كان ذامشاركة فى الجملة وبراعة فى التوثيق مع حرص على التلاوة والجماعة ورغبة فى المنسوبين للصلاح ولسكن لم نحمد شهادته فى كون شيخنا أوصى بالدفن فى تربة بنى الخروبى؛ وقد أجازله قديما فى سنة ثلاث وتسعين أبو الفرج بن الشيخة الغزى وبعد ذلك فى استدعاء مؤرخ بسنة ثمان وتسعين أبوهريرة بن الذهبى وأبو الخير بن العلاينى وطائفة، وحدث باليسير أخذت عنه أشياء ولم بحصل له رواج بعدشيخنا. ومات عن قرب فى الحرم سنة خمس وخمسين . ودفن بالقرافة عند أبيه رحمه الله وايانا. (محمد) بن أحمد ابن محمد بن عبد العزيز بن عبدالكريم . صوا به ابن أحمد بن أحمد بن عبد العزيز مضى.(@)(@@) 134 (عد) بن أحمد بن عحد بن عبدالعزيز بن عبد الله بن الفضل العماد الهاشمى الحلبى . ولى مشيخة الشيوخ بحلب بعد أبى الخير الميهنى فباشرها عدة سنين، وكان انسانا حسنا من ذوى البيوت الاعيان وله ثروة . مات أسيرأ بأيدى التتارفى سنة ثلاث ودفن بمشهد الحسين ظاهر حلب . ذكره ابن خطيب الناصرية.(@)(@@) 135 (عمد) بن أحمد بن عحد بن عبد القادر بن حسن بن محمد المحب أبو الفضل الموصلى ثم الدمشقى الاصل القاهرى 
ms2566	 الحنبلى ويعرف بابن جناق - بضم الجيم وكان يزهم عن شيخناان الفتح أصوب ثم نون خفيفة وآخره قاف . ولدفى ليلة النصف من شعبان سنة سبع وثلاثين وثمانماتة بالقاهرة ورام أهله أن يكون عقادا فأقام عند بعض أربابها يسير آثم تحول وحفظ بعض القرآن وجميع العمدة وكان يقول أنه حفظها فى أربعين يوما وأنه عرضها على جماعة منهم شيخنا وأجاز له فالله أعلم، وانتقل الى الشام فى صفر سنة ثلاث وخمسين فأقام بها سنة وأشهرا وأكمل بها حفظ القرآن عند الفقيه عمر اللولوى الحنبلى قال وكنت أقرأ كل يوم منه ربع حزب بداية واتتفعت بملازمته وحضنى على التحنبل فحضرت دروس البرهان بن مفلح وكذا التقى بن قندس ولزمته حتى سمعت عليه بحث المقنع والمحرر والخرقى الايسيرآمنه وأنه قرأ فى الحساب على الشمس السيلى الحنبلى ، ثم عاد الى القاهرة فى آخر سنة أربع وخمسين فحفظ بها كمازعم أيضا التسهيل فى الفقه لابن الباسلار البعلى والهداية فى علوم الحديث لابن الجزرى ويحث فيها على الزين قاسم الحنفى وأخذ فى الفقه يسيرأ عن ابن الرزاز المتبولى والعز الكنانى ولازمه واشتغل بغيره يسير أفحضر دروسا فى العربية عند التقيين الشمنى والحصنى وفى الاصول عند ابن الهائم والجلال المحلى وأبى الفضل المغربى وقرأعلى السيد على انفرضى الفصول فى الفرائض والنزهة فى الحساب كلاهما لابن الهانم وجالس الشهاب الحجازى فى(@)(@)PageV10882P072(@) ============================================================(@) 73 الادب وانتفع بيحيى الطشلاق فى بعض فنونه كثيرا ، وطلب الحديث وقتاودار على متاخرى الشيوخ فسمم جملة وكان يستمد منى في ذلك وفى غيره بل سمع(@) منى فى الاملاء وغيره، وأجاز له غير واحد وكتب بخطه بعض الطياق ورام محاتاة ابن ناصر الدين فى خطه كالخيضرى ، وأذن له المرداوى والجراعى فى التدريس والافتاء بل كتب قاسم الحنفى تحت خطه فى بعض الفتاوى وكذا أذن له العز الكنانى حيث علم من نفسه التاهل لذلك ، وتنزل فى صوفية الشيخونية وهى أول وظائفه ثم الاشرفية والبيبرسية وغيرها وولى الاعادة بالمنصورية والحاكم وبعد حفيد ابن الرزاز إفتاء دار العدل وتدريس الفقه بالقر 
ms2567	 اسنقرية والمنكوتمرية وناب فى القضاء عن شيخه العز وامتنع من التعاطى على الاحكام وأقرأ الطلبة وكذا أفتى خصوصا بعد وفاة النور الششينى ، وكان فاضلا ذاكرا مستحضرا، لكثير من فروع المذهب ذائقا للأدب حريصا على التصميم فى الاحكام وإظهار الصلابة وتحرى العسدل مع قوة نفس واقدام وإظهار تجمل مع التقلل واحتشام ولطف عشرة وتواضع وميل للماجنة مع من ثختاره، وقد حج وجاور بمكة(@) بعض سنة وكتب عنه صاحبنا ابن فهد من نظمه يسيرأ ولم يكن قاضيه بحمد أكثر أفعاله بل ينسبه الى حمق وتصنع ولعدم اعتنائه بشأنه مسه بعض المكروة من العلم البلقينى بسبب خلوه بالمطلع الملاصق لايوان الحنفية من الصلاحية النجمية اقتات فى عمارتها من ماله وغيره بارتكاب مالا يجوز ولذلك لم يكتع بها بل مات عن قرب فى عاشر شوال سنة اثنتين وشبمين وصلى عليه فى مشهد حسن ودفن بحوش البغاددة تربة السلام بالقرب من ضريح المحب بن نصر الله وأثنى الناس عليه جميلا وأظهر العز التأسف على فقده عوضه الله الجنة. ومما أنشدنيه من نظمه: ووصل الذى أهواه من بعد بعده وساقيه مع ساقى لماأن التووا و وجت مم تده وعذاره وطرته مع مقلتيه وما حسووا وودى ولهفى لاسلوت ولو سلوا فؤادى ولبى قد قلوا والحشاشووا 136 (عد) بن أحمد بن عل بن عبداله بن الحسين بن أبى التائب بن أبى الميس ابن أبى على العز الانصارى الدمشقى الاصل القاهرى الحفى ابن حفيد البدر المسند الشهير و يعرف كسلفه بابن أبى التائب . ولد فى شعبان سنة خمس وسبعين وسبعمالة بالقاهرة ونشا بها فحفظ القرآن وتلان لأبى عمرو على الشمس النشوى والعمدة والكنز الفرعى والمغنى فى الاصول وألغية النحو والتلخيص وعرض بعضها على الصدر المناوى والمجد اسمعيل الحنفى ومحمود العجمى وغيرهم وأخذ الفقه عن البدر(@)(@)PageV10882P073(@) ============================================================(@) )ل ابن خاص بك والشهاب العبادى وسمع دروسه فى المنطق والشمس الحجارى الضرير والنحو عن المحب بن هشام والشمس البوصيرى ، ولازم قارى: الهداية كنير آفانتفه به فى الفقه وأصله والعربية وغيرها وسمع على ابن 
ms2568	 حاتم والشهابين ابن بنين السويداوى والتنوخى وابن الشيخة والمليجى وابن أبى المجدو المجد اسماعيل الحنفى والسراج الكومى والتاج بن الفصييح والحلاوى وفتح الدين ابن الشهيدفى آخرين، وأجاز له النشاورى وجماعة ، وحدث سمع منه الفضلاء:(@) وناب فى القضاء عن البدر العينى فمن بعده وجلس بالمدرسة السيفية تجاه الصناد قيين بل ولى قضاء اسكندرية وقتا وشارت سيرته فى قضائه ودخل دمشق و حج نحوست عشرة حجة وجاور وسمع بتمكه على الجمال بن ظهيرةوتوجه لالطائف لزياره ابن عباس ومات بمكة بعلة البطن فى نالث شو ال سنة صت وأر بعين ودفن بالمعلاة وحمه الله وسامحه.(@)(@@) 137 (عد) بن أحمد بن محد بن عبد الله بن ظهيرة بن أحمد بن عطية بن ظهيرة التق أبو الفتح بن المحب بن الجمال القرشى المكى الشافعى وأمه حبشية فناة لا بيه .(@)(@@) ولد فى ذى القعدة سنة ثمان وثمانمائة بمكة وحفظ القرآن والمنهاج وجمع الجوامع(@) والفية ابن ملك وغيرها وسمع الزين المراغى وجده وأباه وابن سلامة وابن الجزرى وغيرهم ، وأحاز له عائشة ابنة ابن عبد الهادى وعبد القادر الارموى والمجداللغوى وخلق وكان ذافهم وذكاه رام تداريس أبيه بعده فأدركته المنية بعد خمسة وخمسين يوما فى جمادى الآخرقسنة سبع وهشرين بجمكة . ذكره الفامى باختصار عن هذا.(@)(@@) 138 (عد) أبو البقاء شقيق الذى قبله . مات قبل سن التمييز فى سنة أربع عشرة.(@)(@@) 136( محمد) أبر الفضل أخوهما وأمه أم الحسن ابنة أبى بكر بن عبدالله بن ظهيرة. مات عن تحو نصف سنة فى رمضاق سنة أوبع عشرة أيضا.(@)(@@) 140(محمد) أبو بكر شقيق الذى قبله . بيض له ابن فهد.(@)(@@) 14(عد) أبو عبد الله اخوهم أمه الشريفة كمالية ابنة عبد الرحمن الفاسى. بيض له أيضا ف عبدالوهاب 142 (عد) أبوحامد أخوهم أمه آم الحسين ابنة عبد الرحمن بن ع اليافعى . مات معها تحت ساقط فى ذى الحجة سنة خمس وعشرين قبلاكمالهسنة.(@)(@@) 143 (عد) بن احمد بن محمد بن عبد الله بن عبد المنعم الشريف جلال الدين ين الشهاب الحسنى الجروانى - يجيم ثم مهملة 
ms2569	 وواو مفتوحات وآخره نون نسية لقرية قريبة من طنتذا بالغربية - القاهرى الشافعى النقيب ويعرف بالشريف الجروانى النقيب . ولد فى عاشر المحرم سنة خمس وتصعين وسبعماة وحفظ القرآن والعمدة والمنهاج وغيرهما ، وعرض على جماعة كالجلال البلقينى ولازم الشهاب الطنتدأى(@)(@)PageV10882P074(@) ============================================================(@) 75 وكان يقرأ عليه فى الروضة وكذا أخذ فى الفقه عن البرهان البيجورى والشمس البوصيرى وآخرين رفيقا لشيخنا ابن خضر ونحوه وأخذ فى النحوعن الحنارى وفى الفرائض وغيره عن ابن المجدى ، وجلس مع الشهود كأسلافه فبرع فى التوثيق وبهم تدرب فأبوه كان متقدما فيها وجدههو صاحب الوراقة الشهيرة كما ستأتى ترجمته ، وتنزل فى بعض الجهات كالمؤيدية والبيبرسية والمنكوتمرية وباشر النقابة عند العلم البلتبنى وقتآفلم يرج عنده ثم عند شيخناوعمل في المودع وقتا . وكان ممن اختص بشيخنا وقرأ عليه فى تقسيم المنهاج وغيره بل قرأ عليه شرح النخبة بكماله وفى القبة البيبرسية ثم تغيظ عليه لأجل ولده فلما ولى ابن الديرى أشارشيخنا عليه باستقراره به تقيبا ، وحيائذ أقبل عليه السعد فكانت الامور جليها وخقيهاجليلعا وحقيرها معذوقه به وتزايدت بين النواب وجاهته وبعدموته لم يظفر بطأل ، مع أنه باشر عند ابن الشحنة قليلا ثم عند ابن الصواف والبرهان بن الديرى أيامهما كالها بل عند الامشاطى حتى مات وقد أسن في ليلة الثلاثاء رابع عشر ذى القعدة سنة اثنتين وثماتين ودفن من الغد بحوش البببرسية: وكان بهج الهيبة عارفا بالصناعة سيماوى الاسجال والمكاتيب لمباشرته النقابة دهرا وبمقادير الناس وأحوال القضاة والشهود طلق العبارة فى ذلك كسثير الثناء على الوالد والعم والجد فى غيبتى وحضرتى تائلا أصول طيبة وفروع طيبة ، جوزى خيرا، وأول ماحج سنة إحدى وعشرين تم فى سنة إحدى وخمسين مع مخدومه ابن الديرى رحمه الله وعفا عنه وإيانا . (عذ) بن أحمد بن محمد بن عبد الله بن محمد ابن أبى بكر الزين أبو الخير بن الزين أبى الطاهر بن الجمال بن الحافظ المحب الطبرى . مضى فين جده عحمد بن المحب أحمد بن عبد الله فسقط من هنا أحمد.(@)(@@) 144 ( محمد) بن أحمد بن 
ms2570	 محمد بن عبد الله بن محمد بن احمد بن قامح بن عبد الرجمن بن أبى بسكر جعال الدين بن شهاب الدين أبي العباس بن كمال الدين أبى الفضل بن العفيف بن القاضى التقى القرشى العمرى الحرازى (1) الاصل المكى الحنفى والد احمد وعبد الله وأخو عبد القادر الماضيين . ولد فى جمادى الاولى سنة ثلاثين وثمانماية بمكة ونشأ بها فحفظ القرآن وأربعى النووى ومختعر القدورى والألفية وبعض المجمع ؛ وعرض على جماعة منهم أبو البقاء وأبو حامدابنا الضياء والزين بن عياش وأخذ عن ثانيهم وابى الوقت عبد الاول وغيزهما وفى العربية عن الاين طاهر المالكى في مجاورته والقاضى عبد القادر (1) بفتح المهملتين نسبة لجبل عظيم فى الين فيه قرى كثيرة .(@)(@)PageV10882P075(@) ============================================================(@) 7 وصاهره على إحدى ابنتيه وآخرين ، وسمع بمكة على أبى الفتح المراغى وبالمدينة على المحب المطرى ، ولم خرج من مكة لغيرها ولما كان ابنه أحمد بالقاهرة فى سنة خس وتسعين طلع مع شيخه احمد بن حاتم المغربى للسلطان فأنعم عليه بعشرين دينارا وعلى أبيه حين ذكرصلاحه بخمسين فحملت له الى مكة وأقرأبها النحو وأخذه عنه جماعة.(@)(@@) 145 (عد) بن أحمد بن محد بن عبد الله الشمس النحريرى ثم الدواخلى = نسبة لمحلة الدواخل من الغربية - نزيل جامع الغمرى وأخوحسن الماضى وأحد أصحاب أبى العباس ممن أقام عنده بجامع أبيه بالمحلة حتى حفظ القرآن ونظم الزيد ثم بجامعه بالقاهرة واشتغل فى الفقه والعربية وغيرهما وفهم ولازمنى فى التقريب للنووى وغيره وسمع على أشياء، وأقرأ بعض بنى شيخه أبى العباس تم باشارته أقرأ عمر بن أبى البقاء بن الجيعان ، وتنزل فى الجهات بعنايتهم بل صار على عمائر الآشرفية وكان يتضرر من ذلك ، وحج ورزق أولادا . ومات فى ربيع الثانى سنة ست وتسعين ونعم الرجل رجمه الله وايانا .(@)(@@) 146 (عد) بن أحمد بن محمد بن عبدالله المظفرى - نسبة لسويقة المظفر خارج باب الشعرية - الفاخورى أبوه الشافمى نزيل جامع الغمرى ويعرف بالمظفرى وبابن الفاخورى . ولد سنة تسع وسبعين بسويقة المظفر وحفظ القرآن والبعض من كل من الحاوى والمنهاج 
ms2571	 وألفية ابن ملك وألفية العروض وغير ذلك ممن قرأعلى بحنا فى التقريب للنووى الى اثناء ثانى أقسام التحمل ورواية صحيح مسلم وغير ذلك وسمع ثلاثيات البخارى والكثير من دلائل النبوة وأشياء كأما كن من القول البديع ومن شرحى للآ لفية وشرح العمدة لابن دقيق العيد والعمدة والموطأ وغير ذلك وكتبت له إجازة فى كراسة وقرأ على الدعى وغيره ؛ واشتغل قليلا ولازء فضلاء الوقت كالبدر الماردانى فى فنون وجاور بجامع الغمرى وربما أذن به وحرصر على القراءة فى السبع وله همة ورغبة فى الاشتغال.(@)(@@) 147 (محمد) بن أحمد بن محمد بن عبد المحجيد بن أبى الفضل بن عبد الرحمن بن زيد بن عبد الباقى بن زيد الفقيه النجم الانصارى الخزرجى البعلى الشافعى أحد أعيان بلده . مات بها فى رجب سنة خمسين . وفى شيوخ الجمال بن ظهيرة ممن ترجمه شيخنا فى الدرر من أتوهم أنه أخ لهذا واعقه فى اسمه أو غير ذلك .(@)(@@) 48(عذ) بن احمدين عحمد بن عنمان بن ايوب ناصر الدين بن الشهاب بن اصيل الدين العمرى فيما قيل الاشليمى الاصل القاهرى الشافعى الماضى أبوه والآتى جمده ويعرف بابن أصيل بفتح الهمزة ثم مهملة مكسورة، ويقال أن جدته لأمه ابنة عم والده(@)(@)PageV10882P076(@) ============================================================(@) 77 الفخر عمان بن الملوك فهو على هذا من ذرية الملك الكامل . نشأ فحفظ القرآن والعمدة والمنهاج والالفية وغيرها . وعرض على جماعة واشتغل يسيرأ عند الشرف السبك والشمس الحجازى وتلحيذهما الكمال امام الكاملية وخدم الشيخ محمد بن سلطان وقتا حتى بكنس بيته ومسحه فيما كان يحكيه ، وأقبل على التوقيع وأتقن المباشرة واختص ببيت ابن خاص بك ، وتقدم فى أيام الاشرف اينال فولى نظر الزردخاناه والجوالى والبيمارستان وغيرها وولاه العلم البلقينى القضاء فى أيام عزه ولم تسعه مخالفته، و تاثل أموالا جمة ووظائ جملة وابتنى دارا هائلة تجاه جامع الاقر وما حمد الطلبة ونحوهم صنيعه، ولمارال عزه أعرض عما كان يقترفه على نفسه واقتصر على التلاوة ونحوها مع الحرص على الصدقة والمحبة فى الاطعام والتبسط فى المعيشه ومزيد الاعتقاد 
ms2572	 فى المنسوبين الى الصلاح خصرصا المسمون بالمجاذيب اقتفاء للكمال إمام الكاملية فقد كان له به مزيد اختصاص بحيث لم ينفك عنه وأظنه كان فقيهه وما عدم من ينكر عليه صحبته سيماقبل توبته وإنابته والظاهر أن تحوله ببر كته. مات فى صفر سنة إحدى ومانين ودفن نحوش سعيد السعداء وقد جاز الستين فوت أبيه كان فى سنة تسع عشرة رمه الله وعفا عنه (عد) بن أمد بن عهدبن عصفور. فيمن لم يسم جده 149 (محمد) بن أحمد بن محمد بن علوان أبو الطيب التوتسى تم السكندرى المالكى الونائى ويعرف بابن المعرى . ولد فى ظهر يوم التروية سنة ست وستين وسبعماتة وسمع بعد السبعين المقتى أبا القسم أحمد بن محمد الغبرينى البجاني الاصل(@) زيل تونس وعرض عليه الرسالة ، وأجاز له أبو عبد الله محمد بن أحمد البطرنى وحدث رفيقا للكال بن خير ومما رواه عن الغبرينى الموطأحضور البعضه واجازة منه بياقيه ، سمع عليه باسكندرية الشهاب بن هاشم المقرى والجمال أحمد بن محمدبن أبى بكر بن قرطاس الماضى؛ وقال شيخنا فى معجمه لقيته بالقاهرة وسمعت من فوانده وأجازلا ولادى يعنى فى سنة سبع عشرة مومات باسكندرية سنة سبع وعشرين 150 (عد) بن احمد بن محمد بن على بن ابراهيم فتح الدين بن المحب القاهرى(@) الشافعى الخطيب والد المحب احمد المالسكى الماضى وولده البدر محمد ويعرف يابن المحب. ولدتقريبا سنة إحدى وسبعين وسبعمالة بالقاهرة ونشأ بها فحفظ القرآن والعمدة والشاطبية والتببيه والمنهاج الاصلى وألفية النحو، وعرض فى بسنة خمس وثمانين فما بعدها على الابناسى والبلقينى والعراقى والدميرى والصدر الا: شيطى وأجازو اله بل ذكر لى أنه كتب عن الزين العراقى من أماليه بالظاهرية(@)(@)PageV10882P077(@) ============================================================(@) 78 العتيقة وأنه ممه من ولده انولى واشتغل يسير أوحضر الدروس وتكسب بالشهادة(@) وكان سا كنا خيرا خطب بجامع القيمرى فى سويقة صفية وقرأ الميعاد والحديث بين يدى الشيخ محمد الحنفى، أجاز لى. ومات فى أو اخر جمادى الثانية سنة أربع وخمسين بعد أن تعلل مدة وصاز عشى على عكازين رحمه 
ms2573	 الله 15 (عد) بن احمد بن محمد بن على بن الحسن بن محمد بن عبد العزيز بن محمد المحب أبو الشفاء بن الشهاب بن ناصر الدين المقرىء المالكى ويعرف بابن القرات باسم النهر . ولد فى سنة سبعين وسبعمانة تقريبا بالقاهرة وقرأ بها القرآن و تلابه لأبى عمرو على الفخر الضرير وللسبعة إلا حمزة على الشمس الشراريي وأخذ فى الفقه عن عبيد البشكالسى والشهاب المغرارى وفى النحو عن المحب بن هشام قرأ عليه جميع التوضبح لأبيه وسمع على قريبه ناصر الدين مد بن الحسن بن الفرات الحنفى وأبى الفرج بن الشيخة وجلس يؤدب الاطفال برأس الزجاجيين أخذ عنه ابن فهد والبقاعى وقال انه مات بالقاهرة فى يوم الاثنين ثامن جمادى الثانية سنةثمان وأربعين ودفن من الغدو جمهور أسلافهم مالكيون رحمه اللهوايانا.(@)(@@) 152(محمد) بن احد بن محمد بن على بن سعيد بن سالم بن غر بن يعقوب بن عبد الله بن صبح انبهاء أبو حامد بن الصدر أبى الطيب بن البهاء الانصادى الخازرجى الدمشقى الشافمى ويعرف بابن امام المشهد . ولد سنة سجع وستين وسبعمائة وأسمع من بعض أصحاب الفخر وابن انقواس ؛ وأجاز له العز بن جماعة وأحمد بن سالم المكى والكال بن حبيب وعلى بن يوسف الزرندى وغيرهم؛ ونشأ نشأة حسنة فاشتغل بالفقه وتميز فيه وتآدب وأفتى ودرس وناب فى الامامة بالجامه الاموى بدمشق وفى القضاء أيضا الكنه امتنع منه فى ولاية الشهاب(@) الحسبانى، وكان لينأ خيرا حسن السيرة لديه فضيلة .مات فى ذى القعدقسنة خمس عشرة. ذكره شيخنا فى انبائه ومعجمه والمقريزى فى عقوده وآبن فهدفى معجمه (1).(@)(@@) 153 (محد) بن احمد بن عحد بن على بن سليمان الشمس المصرى الصوفى تزيل مكة ويعرف بابن النجم سمع بعصر فيماأحسب من قاضيها أبى البقاء السبكى وصحب يوسف العجى وصار من مريديه ونظر فى كتب الصوفية وغيرها من كتب العلم ومال فيما بلغنى لابن عربى وكتب بخطه كتبا وفوائد منهاعلى ماذكر لحفف النفس والمال : الله حفيظ قديم أزلى حى قيوم لاينام ، وذ كر أن 
ms2574	 من قال ذلك الى جهة مال له غائب حفظ ، وجاور بمكة نحو ثمانية عشرعاما وتأهل بها وولد(@) (1) فى هامش الاصل : بلغ مقابلة.(@)(@)PageV10882P078(@) ============================================================(@) 79 له وسمع الحديث بها من بعض شيوخنا بالسماع والاجازة و تعبد كثيرا واشتهر، ثم انتقل الى المدينسة فسكنها عامين وأشهرآ ثم توفى بها فى شهر ربيع الاول سنة إحدى ودفن بالبقيع . ذكره الفاسى بمكة وقال هكذا أملى على نسبه ولده محمد سبط يوسف بن على القروى . وقال ابن حجى انه جاز الستين وكان على طريقة ابن عربى وغيره مع كثرة العبادة ، وهو فى الانباء باختصار . وقال المقريزى فى عقوده : كان كثير العبادة ترتاح النفس عند رؤيته ، لقيته بمكة فى سنة ثلاث و ثمانين ثم في سنة سبع ونمانين رحمه الله .(@)(@@) 154 (عد) بن أحمد بن محمد بن على بن عمربن على بن أحمد الصلاح بن الشهاب ابن البدربن النور القرشى الطنبدى القاهرى أخو أبى الفضل محمد الآتى واخوته وهو أولهم مولدا والماضى أبوه ويعرف كسلفه بابن عرب لكونه سبط الجمال ابن عرب . مات فى حياة أبيه سنة سبعين عن دون الثلاثين: 155 (معد) المحب أبو الفضل أخو الذى قبله . نشأ فحفظ القرآن وغير هواشتغل عند العبادى والبكرى وغيرهما فى الفقه وغيره واختص بفتح الدين بن البلقينى وخالطه، وناب فى القضاء وتردد لتراز وغيره.(@)(@@) 156 (معد) بن أحمد بن محمد بن على بن الزين عد بن الأمين عمد بن القطب أبى بكر محمد بن أحمد الجمال أبو عبد الله القسطلانى الآصل المكى ويعرف كسلفه بابن ازين ، أمه عائشة ابنة محمد بن على العجمى ، أجاز له في سنة تمان وثمانين وسبعائة فما بعدها النشاورى وابن حاتم والعراقى والهيثمى والاميوطلى ورسلان الذهبى وابن الشيخة وآخرون . وماب بممنة سنة تمان وعشرين: 152 (محمد) بن أحمد بن محمد بن على بن هرون بن على البدر بن الشهاب المحلى السكندرى ثم القاهرى الشافعى الماضى أبوه ويعرف باين المحلى قاضى سكندرية وابن قاضيها . ممن ذكر بين الناس عقب موت أبيه قليلا: وابتنى بيتا بالقرب 
ms2575	 من خان الخليلى ؛ وحج وجاور ثم خمد.(@)(@@) 158 (محمد) بن أحمد بن محمد بن على البدر أبو السعادات بن الشهاب المحلى الماضى أبوه ويعرف كهو بابن المصرى . نشأ فحفظ القرآن وكستبا وعرضها على جملة الجماغة بل سمع منى: 159(محمد) بن أحمد بن محمد بن على المكى بن الفيومى جابى وقف الزمام بمكة كأبيه و جبى بعده أخوه أبو بكر . مات بهافى رمضان سنة ست و سبعين. ارخه ابن فهد.(@)(@@) 160 (محمد) بن أحمد بن محمد بن عماد الشمس الدمنهورى المكى العطار .(@)(@)PageV10882P079(@) ============================================================(@) 8 مات غريقا بالمويلحة فى ليلة سابع عشر رجب سنة خمس وثلاثين ودفن بجزيرة هناك . أرخه ابن فهد وقال انه أجاز له فى سنة ثمان وتمانيين وبعدها النشاورى والعراقى والهيثمى وابن حاتم وآخرون : 16(محمد) بن أحمد بن محمد بن عمر بن محمد بن هاشم بن محمد بن عبد الله الشمس بن الشهاب الصنهاجى السكندرى القاهرى المالكى الآشقر نزيل الحسينية ويعرف كآبيه الماضى بابن هاشم . حفظ القرآن وغيره وأسمعه أبوه على ابن الحزرى ، وكذا سمع على شيخنا وأجاز له فى استدعاء ابن فهد المؤرخ برجب سنة ست وثلاثين خلق . وتكسب بالشهادة وبرع فى الشروط مع تقص كتابته وقصد بالاشغال ونال فيها حظا بحيث كان مرجع تلك الدأرة كلها عليه . وكان مذا كرا بكثير من الفوائد محبة فى الصالحين متبسطأ فى معيشته مغرما بتحصيل الكتب بحيث استكتب من تصانيفى عدة وسمع على منها، ورما قصدنى ببعض الأسئلة ويصرح بالاتفراد بوناء غرضه فى أجوبتها . وتزوج بعدة زوجات لورتهن إلا أم أولاد للعلم البلقينى فهى التى ورثته وكان زائد الرغبة فيها . مات فى يوم الآحد تاسع عشر رمضان سنة ست وتمانين وأظنه جاز الستين سامحه الله وإيانا: 162(محمد) بن أحمد بن محمد بن همر فتح الدين أبو الفتح بن الشيخ أبى العباس الغمرى الاصل المحلى الشافعى الماضى أبوه وكل منهما يكنيته أشهر : ولد فى رابع عشر رمضان سنة أربع وخمسين وثمانماتة بالمحلة وحفظ القرآن والمنهاجين الفرعى والاصلى وعرض على فى جملة الجماعة بل 
ms2576	 وسمع منى ومن الشاوى والقمصى وآخرين ومما سمعه على القول البديع وقرأ على دروسا فى التقريب للنووى واشتغل على الشهاب بن المصرى فى الفقه وعليه وعلى أبى عبد الله التونسى فى العربية بل قرأ دروسا فى الققه على الفخر المقسى وكذا أخذ فيه وفى التحوعن الشرف البرمكينى حين سافر اليهم المحلة وفيهما وفى الاصول عن الشهاب بن الاقيطع وأكثر من ملازمته وحضر عند الكمال بن أبى شريف والبدر بن القطان والا بناسى وابن تاسم وزكريا وغيرهم، وخلف والده حين قطن القاهرة فى المحلة وصار رأسا وله مزيدتوجه الى الاشتغال والمذاكرة.(@)(@@) 163 (محمد) المحب أبو الفضل شقيق الذى قبله . ولد تقريبا سنة ثلاث وستين وثانمائة بالمحلة وحفظ القرآن والمنهاج وجمع الجوامع وعرض على أيضا وكذا على المحب بن انشحنة والعضد الصيرامى والشمس الامشاطى وعبد الغنى الهيشى والجوجرى والجلال البكرى وآخرين فى سنة ثمانين بل قرأ هلى فى البحث عدة(@)(@)PageV10882P080(@) ============================================================(@) مقدمات فى علوم الحديث وعلى ابن سولة فى الفقه وأصوله والشيخ عمد العجمى فى العربية والصرف والمنطق ، والزين الا بنامى فى الفقه وفيره كشير آفى آخرين كالشرف موسى البرمكينى وزوجه ابنته واستولدها عدة أولاد ثم عرض له ما يشبه الجذب فكان يفيق منه تارة ويعاوده أخرى ودام به سنين وفى كل حالة أستأنس به وأبتهج برؤيته عافه الله .(@)(@@) 164 (عد) بن أحمد بن محمد بن أبى الفتح بن سالم البدر أو الشمس بن الشهاب بن البدر الحلبى بن الاطعانى (1) والدأحمد الماضى . ولد فى صبيحة يوم الخيس خامس شعبان سنة مان وأربعين وسبعماة بحلب، ونشأ بها فحفظ المنهاج وعرضه فى سنة ثلاث وستين على الشهاب الاذرعى والرين همر بن عيسى بن عمرالبارينى (12 وبه تفقه ونسخ بخطه شرحه لابن الملقن ، وعرض عليه النيابة فى القضاء ببعض البلاد كابيه فامتنع، وتزهد وسلك طريق التصوف، وسافر الى القدس فلبس الخرقة من عبد الله البسطامى، ثم رجع الى بلده وانقطع زاوية خارج باب الجفان وصار معتقدا مقبلا على شأنه دينا بهى المنظر، وتنذ له جماعة ولبس 
ms2577	 منه غير واحد الخرقة، وحج مرارا وجاور فى بعضها واشتهر بين الحلبيين وبنيت له زاوية وتردد اليه الاكابر لزيارته والتبرك به وهو لايزداد مع ذلك إلا تواضعا وتعبدا، وكان منور الشيبة حسن الخلق والخلق كثير الحياء بهى المنظر وسكن بعد الكائنة العظمى فى دار القرآن المجاورة للجامع الكبير حتى مات بعد سلاة الجعة تاسع ذى القعدة سنة سبع وحضر جنازته من لايحصى . ذكره شيخنا فى إنبائه نقلاعن ابن خطيب الناصرية . وقال لى بعض الحلبيين انه ابتنى بحلب زاويتين أعين فيهما من أهل الخير.(@)(@@) (عمد) بن أحمد بن عحد بن فهيد . يأتى بدون فهيد . (عد) بن أحمد بن محمد ابن المجد أبى الفتوح السنكلونى . مضى فيمن جده محمد بن أبى بكر بن اسمعيل : 165 (محمد) بن أحمد بن محد بن كامل بن محمسد بن تمام بن شعبان بن معالى ابن سالم الشمس أبو عبد الله بن الشهاب بن الشمس التدمرى - بفتح الفوقانية ثم دال مهملة بعدها ميم مضمومة - الخليلى الشافعى . ولد فى سنة إحدى وخمسين وسبعماثة وقيل سنة خمسين وبه جزم شيخناوالتجم بن فهد كأنه تبعا له وأحضر فى الثالثة أوالثانية على الصدر الميدومى المسلسل وجزء ابن عرفة ومنتقى الملأى من مغيخة ابن كهايب، وممر حتى تفرد وان خأة اسحابه وبقال انه سم (1) بفتح ثم سكون المهملة ثم مهملة وآخره نون : (2) من أعمال جلب: 6- سابع الضوء)(@)(@)PageV10882P081(@) ============================================================(@) 83 من والده وطبقته فالله أعلم ، وخطب ببلد الخليل وحدث سمع منه الائمة كابن موسى والأبى والنجم بن فهد وفى الخليليين وغيرهم الان غير واحد ممن سعع منه، وكان عسرآفى التحديث أجاز لى ، وذكره شيخنا في معجمه وقال : أجاز لنا مع أولادى، وتبعه المقريزى فى عقوده ولكنه قال: التدمرى ثم المقدسى فغلط قال ولعله آخر من بقى ممن أخذ عن الميدومى مات بعد سنة عشرين، قلت قد مات ببلده فى ليلة الثلاثاء مستهل ذى الحجة سنة ثمان وثلاثين، وقد رجمت والده وجده فى التاريخ الكبير.(@)(@@) 166 (معحد) بن أحمد بن محد بن محد بن أحمد 
ms2578	 بن محمد السكازرونى المدنى ابن أخى عمد وعبد السلام وعلى المذكورين فى محالهم . ولد فى سنة أربع وستين وتماتمائة أو التى قبلها وسمع على أبى الفرج المراغى ثم على بطيبة أشياء : 167 (عد) بن احمد بن الشرف محمد بن حمد بن احمد الشمس الششترى المدني الشافعى ويعرف بابن شرف الدين . ولد سنة اثنتين وستين ونمانمائة تقريبا بالمدينة ونشأ بها فحفظ القرآن والطيبة وقرأ ببعض الروايات على عمه الشمس محمد بن شرف الدين واشتغل بالفقه والعربية يسيرا ب ولازمنى وأنا بالمدينة حتى قرأ على مسند الشافعى وأشياء وسمع منى وعلى جملة وكتبت له ثبتا، ثم سافر الى الروم لاستخلاص الاوقاف بها وعاد وفد ترقع حاله: 168( ممد) بن فتح الدين أبو الفتح أخو الذى قبله . ممن أخذ عنى بطيبة أيضا.(@)(@@) 169 (محمد) بن احمد بن محمد بن محمد بن أيوب بن الياس ناصر الدين بن الشهاب ابن ناصر الدين بن الشمس بن النجم بن الفخر العراقى الاصل الفارسكورى: تحول أيوب من العراق الى القاهرة فسكنها وكان حفيد ولده مقطعا بمنية النصارى بالقرب من أشموم فتروج امرأة منها وانتقل بها الى القاهرة فولدت له بها صاحب الترجمة وذلك في سابع رجب سنة سبعين وسبعماية ونشأ بها فقرأ القرآن وصلى به وذكر أنه قرأ على السراج البلقينى تدريبه تصحيحا، وحضر دروس ابن الملقن ، وأنه سمع على الزين العراقى والبخارى على الغمارى بدرب السلسلة مع الفاقوسى وكان يؤدب أولاده وأنه حج فى سنة ثمان وتسعين وزار بيت المقدس مرتين وتعانى النظم وان أمه كان لها أقرباء بفار سكور فكان يسكن بهاتارة و باشموم أخرى ثم استوطن فارسكور ولقيه بها ابن فهد و البقاعى وقالا إن أهل بلده يثنون عليه بكثرة الصوم والتلاوة والخير وكتبا عنه قوله الذى أضافه لقول البرهان اليوصيرى الشاعر حين استضافه بعضهم وكانه قصر فى خدمته سيما فى(@)(@)PageV10882P082(@) ============================================================(@) 8 المكان الذى أنزله به لكثرة ما فيه من البراغيث : فما كان أطولها ليلة ترجو الاقالة من ربنا فما ضيفونا ولكنهم براغيثهم ضيفوهم بنا 
ms2579	 فقال: مردنا بقوم نروم القرى بلينا بكرب على كربنا فجاءوا بفرش كوينا به كانا مغازون فى حربنا وجاءوا بأكل غصصنا به فلا الاكل طاب ولاشربنا مات ورايث من ساق نسبه بدون محمد الثابى بعد جده فالله أعلم 170 (محمد) بن أحمد بن محمد بن محمد بن أبى بكر البدر أو الشمس بن الشهاب ابن البدر بن الصدر المصرى الشافعى والدعلى وأبى بكر (1) الماضيين ويعرف بابن الخلال بعجمة ثم لام مشددة . ولدفى ربيع الاول سنة ست وسبعين وسبعمأة بمصرونشا بها فحفظ القرآن والعمدة والتنبيه وألفية النحو وغيرها ، وعرض على البلقينى وابن الملقن والفخر القاياتى وأجازوا له وتلا لا بى عمرو على الشيخ مظفرثم لنافع وغيره على الجلال ولم ينسبه، وتفقه بالنورين الأدمى والبكرى والشمس بن القطان والبلقينى قرأ عليه فى الخروبية وغيرها وقال انه لازمه عشر سنين ، وقصد الكمال الدميرى للاخذ عنه فقال له مكانك بعيد والآولى أن تجمع ما يشكل عليك ثم تراجمنى فيه ، وأخذ العربية عن ابن القطان والأ دمى وعلم الحديث عن الزين العراقى وعلم الفلك عن ابن ادريس ولازم العز بن جماعة كثيرآم وأخذ عنه الاصول والعربية والفقه وغيرها وحضر فى المنطق عند البساطى وغيره ، وعرض عليه الشيخ محمد العطار الخلوة فامتنع لكونه حينئذ كان فى تفهم كتابه فلحاتم حضر إليه والتمسها منه وألح فقال انه فات الوقت ، وسمع على الصلاح الزفتاوى وناصر الدين بن الفرات والمطرز والابناسى والعراقى والهينمى والنجم البالسى والسويداوى والفخر القاياتى والشرف القدمى وآخرين ، وباشر بمصر عدة وظائف و درس وخطب بمدرسة ابن سويد ثم استدعى لفوة فى سنة أربعين وقررفى الخظابة والتدريس بجامع ابن نصر الله بها، وتصدى للتدريس والافتاء فانتفع به غير واحد من أهل تلك الناحية وغيرها ، وناب فى القضاء هناك عن السفطى مع امتناعه من قبوله عن من قبله وبعده لمزيد الحاح المشار إليه عليه فيه ، وقد لقيته بفوة وقرات عليه أعياء ، وكان فقيها حافظا للمذهب مشاره فى الفنون بارعا (1) "أبى بكر" ساقطة من الأصل فاستدر كناها ما سيأتى 
ms2580	 حيث ترجم له فى الكنى . وقوله الماضيين خطأ لأن ترجمة أبى بكر ستأتى بعد.(@)(@)PageV10882P083(@) ============================================================(@) فى الميقات طارحا للتكلف خيرا متواضعا متقشفا . مات وهو ساجد بفوة فى عضر يوم السبت حادى عشر رمضان سنة سبع وستين ودفن من الغد بجوار ضريح أيى النجا بعد أن صلى عليه بانمصلى وحمه الله وإيانا .(@)(@@) 17 (ممد) بن احمد بن محمد بن محد بن حامد بن أحمد بن عبد الرحمن الشمس أبو حامد بن الشهاب بن الشمس المقدسى الشافعى الماضى أبوه ويعرف كسلفه بابن حامد. ولد كما أخبر به فى نصف ربيع الآخر سنة سبع وثمانائة ببيت المقدس وتشأ فقرأ القرآن عند أبيه وجماعة وحفظ المنهاجين والالفيتين وقطعة من مختصر ابن الحاجب الأصلى، وعرض على البرماوى وابن الجزرى وابن رسلان والعز القدسى فى آخرين وسمع على والدهو القبابى والتدمرى وطائهة وأخذ الفقه عن ماهر وابن رسلان قرأعليه تصنيفه الزبدو كذا قرأعلى التقى بن قاضى شهبة حين قدم عليهم وراسله بالاذن له بالافتاء والتدريس وكذا أذن له أبو بكر الأذرعى وقرأبعضا من توضيح ابن هشام على الشمس البرماوى، وارتحل الى القاهرة فى سنة سبع وثلاثين فأخذ عن شيخنا وسمع حينئذ على البدر حسين البوصيرى ثلاثة مجالس من آخر سنن الدارقطنى من عشرة بقراءة شيخنا ابن خضر ووصفه بالشيخ الفاضل، وأخذ بعدها عن القاياتى البعض من عقيدة النسفى وتابل مع العلاء القلقشندى ناصحة الموحدين لشيخه العلاء البخارى ، وحج فى سنة أربع وعشرين ثم صحبة أبيه في سنة سبع وخمسين؛ وسافر لدمشق مرارا وأخذبهاعن ابن ناصر الدين وكذا دخل حماة وغيرها، وناب فى الاعادة بالصلاحية بل استقر فى مشيخة الفخرية بعد أبيه، اجتمع بى وسألنى فى ترتيب ما أوقفنى عليه من أثباته فأجبته وسمعت من فوائده وعلقت عنه أشياء ، وكان محبآفى الفائدة مع التواضع والشيبة النيرة.(@)(@@) مات بدمشق فى يوم السبت سابع ربيع الآخر سنة أربع وسبعين رحمه الله.(@)(@@) 173 (مد) بن أحمد بن محمد بن محمد بن سعيد بن محمد بن محمد بن عمر بن يوسف بن 