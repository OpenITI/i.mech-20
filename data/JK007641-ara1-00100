ms81	 ياذا الملامة ناصح % % أرأيت صبا يألف النصاحا % % 29(@)(@@) % إن رمت إصلاحي فإني لم أرد % % ما رمته لي بالملام كفاحا % % 30(@)(@@) % فتشت قبلك في الزمان فلم أجد % % لفساد قلبي في الهوى إصلاحا % % PageV01P416 31(@)(@@) % ماذا يريد العاذلون بعذل من % % لا يستطيع يرى الفلاح فلاحا % % 32(@)(@@) % ألف التهتك والهيام وفي الورى % % لبس الخلاعة واستراح وراحا % % 33(@)(@@) % يا أهل ودي هل لراجي وصلكم % % نيل فعندكم عهدت سماحا % % 34(@)(@@) % إن المشوق إذا شجاه لنحوكم % % طمع فينعم باله استرواحا % % 35(@)(@@) % مذ غبتمو عن ناظري لي أنه % % من هولها صبري استقل وراحا % % 36(@)(@@) % وجفون عين كلما نوت البكا % % ملأت نواحي أرض مصر نواحا % % 37(@)(@@) % وإذا ذكرتكمو أميل كأنني % % غصن يقابل في الرياض رياحا % % 38(@)(@@) % أو شارب ثمل القوام لأنني % % من طيب ذكركمو شربت الراحا % % 39(@)(@@) % وإذا دعيت إلى تناسي عهدكم % % لا أستطيع وأنثني ملتاحا % % 40(@)(@@) % لما طلبت الصبر عنكم في الهوى % % ألفيت أحشائي بذاك شحاحا % % PageV01P417 41(@)(@@) % سقيا لأيام مضت مع جيرة الجرعاء % % حيث بهم لقيت نجاحا % % 42(@)(@@) % لم ندر ما برح البعاد وإنما % % كانت ليالينا بهم أفراحا واها على ذاك الزمان وطيبه نهوى الطلا فنواصل الأقداحا % % 43(@)(@@) % حيث السرور بنا ألم معاودا % % ايام كنت من اللغوب مراحا % % 44(@)(@@) % حيث الحمى وطني وسكان الغضا % % لي جيرة عنهم تركت براحا % % 45(@)(@@) % حيث العتيق منازلي وتلاعه % % سكني ووردي الماء فيه مباحا % % 46(@)(@@) % وأهلية أربي وظل نخيله % % يا صاح منتزهي مسا وصباحا % % 47(@)(@@) % ببروقه وجدي وفي نسماته % % طربي ورملة وادييه مراحا % % 48(@)(@@) % قسما بمكة والمقام ومن أتى % % تلك الأماكن في الحجيج وراحا % % 49(@)(@@) % وسعى وطاف وجاء ملتمسا إلى البيت % % الحرام ملبيا سياحا % % 50(@)(@@) % ما رنحت ريح الصبا شيح الربا % % غلا وقلبي بالحجاز تلاحى % % PageV01P418 51(@)(@@) % أو شمت بارقة لمن قتل الهوى % % إلا وأهدت منكمو أرواحا % % PageV01P419 البحر : - 1(@)(@@) % ركب شوق بدار قلبي أناخا % % أم فؤادي مع الغرام تواخى % % 2(@)(@@) % لي بشرقي رامة فزرود % % صفو عيش هناك كان رخاخا % % 3(@)(@@) % مع صحب عن العيان استقلوا % % فطووه سباسبا وسباخا % % 4(@)(@@) % رفقة لي بهم قديم عهود 
ms82	 % % لا يشوب الثبوت فيها انتساخا % % 5(@)(@@) % ما تغنت بهم حدا المطايا % % قط إلا وصررت كلي صماخا % % 6(@)(@@) % وبهم كلما تألق برق % % ملت عن عالم الكيان انسلاخا % % 7(@)(@@) % وإذا هبت الصبا هب قلبي % % معها لا يني ولا يتراخى % % 8(@)(@@) % يا حبيبا هواة دين أناس % % هم عليه قد عاهدوا الأشياخا غائب الذات حاضر الوصف فينا عرف أسمائه هو المسك فاخا % % 9(@)(@@) % وجهه يوجب الفناء انكشافا % % والفنا فيه يغسل الأوساخا % % 10(@)(@@) % لي على قربه دواوين عشق % % نظمها العذب أطرب النساخا % % PageV01P420 11(@)(@@) % لا تقل وجهه تحجب عني % % هو بالعز لم يزل شماخا % % 12(@)(@@) % إنما أنت عنه خلف حجاب % % عاجزا عن شهوده وخواخا % % 13(@)(@@) % وعليه من القلوب طيور % % حاضنات نفوسها الأفراخا % % 14(@)(@@) % حسنه للعيون لا زال نورا % % وتجليه للقلوب مناخا يا نديمي بحانة الغيب إن الغيب كالعين لم يزل نضاخا % % 15(@)(@@) % فاملأ الكاس لي ولا تترنم % % بسوى من به السوى فيه ساخا % % 16(@)(@@) % وأتى أمره إلي بروح % % قام في زمر نشأتي نفاخا % % 17(@)(@@) % صاد كل القلوب بالحسن لما % % مد أكوانه لهن فخاخا % % 18(@)(@@) % وأنا صيده بغير شباك % % لا حراكا لا نفر لا صراخا % % 19(@)(@@) % نخلتي أثمرت هواه جنيا % % حين مدت حشاشتي شمراخا % % 20(@)(@@) % وأنا اليوم عنده في مقام % % مطرب كل من إليه أصاخا % % PageV01P421 21(@)(@@) % قص لي ذكر حاطب في قريش % % والكتاب الذي أتى روض خاخا % % 22(@)(@@) % أنا بدري وجهه لا ارتشاشا % % نوره في سابقا وانتضاخا % % 23(@)(@@) % أخذتني عيونه النجل لما % % بي تجلى فكان سيلا جلاجا % % PageV01P422 البحر : - 1(@)(@@) % للي كتاب يمحو السطور وينسخ % % وتراه يحكم ما أراد وينسخ % % 2(@)(@@) % قرب له ما إن يزيل كماله % % بعد وإن ميل أزيل وفرسخ % % 3(@)(@@) % هو ذا وهذا في الظهور وهذه % % جبل إذا اختلج المحقق يرسخ % % 4(@)(@@) % خرف تركب في البسيط وإنه % % أبدا بأرواح المحبة ينفخ % % 5(@)(@@) % نور له السبع الكواكب أعين % % والأرض أم والحكيم له أخ % % PageV01P423 البحر : - 1(@)(@@) % طلعت شمس الوجود % % من سموات الشهود % % 2(@)(@@) % فاختفى الرسم وطاح الوهم % % وانحلت قيودي % % 3(@)(@@) % كان في ظني بأني % % مستقل في الوجود 
ms83	 % % 4(@)(@@) % أملك الفعل وأحوي القول % % مع كل العقود % % 5(@)(@@) % كبني الأيام ألهو % % بقيام وقعود % % 6(@)(@@) % وأنا بين ليال % % من ظلام الفكر سود % % 7(@)(@@) % فتأملت وقلبت % % صدوري وورودي % % 8(@)(@@) % وتسايلت إلى أن % % نابت بالوهم عودي % % 9(@)(@@) % وتحققت بأني % % نابت بالوهم عودي % % 10(@)(@@) % وبأني عند نفسي % % كخيال في هجود % % PageV01P424 11(@)(@@) % واعترافي بالذي أعلمه % % عين جحود % % 12(@)(@@) % وكذا الظل له مرئي % % ولكن بالعمود % % 13(@)(@@) % فأنا اليوم أنا ذا ك % % على رغم الحسود % % 14(@)(@@) % وأنا المحبوب والمحبوب % % ذاتي ووجودي % % 15(@)(@@) % وأنا نفس جميع الناس % % نسلي وجدودي % % 16(@)(@@) % وأنا الكل وكل الكل % % من فضله جودي % % 17(@)(@@) % ما معي في الملك غيري % % والورى طرا شهودي % % 18(@)(@@) % ولقد أطلقت نفسي % % من تخاطيط حدودي % % 19(@)(@@) % وسللت السيف مني % % بعد هاتيك الغمود % % 20(@)(@@) % وشققت الحجب عن عيني % % وطالعت ودودي % % PageV01P425 21(@)(@@) % وصلاتي لي جميعا % % وركوعي وسجودي % % 22(@)(@@) % وأنا ناري إذا ما % % شئت أشقي بخلود % % 23(@)(@@) % وأنا الجنة إذ في % % قبضتي كان سعودي % % 24(@)(@@) % ما على نفسي منى % % في وعيدي ووعودي % % 25(@)(@@) % وعلى ذاتي إقبا لي % % كما عني صدودي % % 26(@)(@@) % وهي نفسي لا سواها % % بين حجب وشهود % % 27(@)(@@) % في نعيم أنا طورا % % ثم طورا في وقود % % 28(@)(@@) % وتحياتي على ذا تي % % من غير نفود % % PageV01P426 البحر : - 1(@)(@@) % إن الوجود الحق شيء واحد % % يا سعد من يجلى له فيشاهد % % 2(@)(@@) % وجمال علو واضح متكتم % % وعليه من حسن الملاح شواهد % % 3(@)(@@) % قف ساعة حتى أعلمك الهوى % % يا من يبيت وللهوى هو عابد % % 4(@)(@@) % إن المحبة فيك كدر صفوها % % جهل بمن تهوى لأنك جاحد % % 5(@)(@@) % فلو انمحى عن عين ناظرك السوى % % لعرفت من لهواه أنت القاصد % % 6(@)(@@) % لكن عيونك عن مرادك في عمى % % وتظل تنكر ذاته وتعاند % % 7(@)(@@) % هو ظاهر في كل شيء باطن % % أبدا إليه كل شيء ساجد % % 8(@)(@@) % عود العلا ضربت به يده على % % طبل الملا فالعالمون قصائد % % PageV01P427 البحر : - 1(@)(@@) % غصن بان فوقه البدر بدا % % أم غزال راح يغزو أسدا % % 2(@)(@@) % أم مليح يتثنى مرحا % % حيث أضحى بالبها منفردا % % 3(@)(@@) % صنم الحسن الذي 
ms84	 لم يره % % عاشق الإله قد عبدا % % 4(@)(@@) % يا له بحر جمال عطفه % % موجه بالجسم يرمي زبدا % % 5(@)(@@) % نار خديه مجوسي الهوى % % ما رآها قط إلا سجدا % % 6(@)(@@) % وإذا ما ظهرت من وجهه % % حضرة الغيب طلبنا المددا % % 7(@)(@@) % صار جهلي غيره معرفة % % صار غي وضلالي رشدا % % 8(@)(@@) % آه من قسوته مع شغفي % % في هواه وهوى الغيد ردى % % 9(@)(@@) % قلت يا مولاي جد لي كرما % % بوصال قال لا لا أبدا % % 10(@)(@@) % قلت فالوعد به تسلية % % قال يحتاج يفي من وعدا قلت فاسمح بخيال في الكرى قال لي مالك طرف رقدا % % PageV01P428 11(@)(@@) % قلت ما تفعل بي حينئذ % % قال ما أختاره طول المدى % % 12(@)(@@) % قلت خذ روحي فقال الروح لي % % خل دعواها وهات الجسدا % % 13(@)(@@) % واترك الأمر إلى مالكه % % إن للمحبوب في الحب يدا % % 14(@)(@@) % كل من يعشق وجها حسنا % % لا يرى إلا البلا والنكدا % % 15(@)(@@) % فاصطبر إن شت أو شت فمت % % كم علينا ذاب جلد جلدا % % 16(@)(@@) % أما موسى العشق ربي أرني % % بك أن أنظر ظبيا شردا % % 17(@)(@@) % لاح لي جمر على وجنته % % كلما أدنو إليه بعدا % % 18(@)(@@) % فلعلي منه ألقى قبسا % % أو يرى قلبي على النار هدى % % 19(@)(@@) % قم تأمل أيها الغافل لم % % يخلق الرحمن ذا الحسن سدى % % 20(@)(@@) % وتعرض لهواه فلقد % % جاء من ناحية الستر ندا % % PageV01P429 21(@)(@@) % وإذا لامك من ليس له % % نظر فاخرب عليه البلدا % % 22(@)(@@) % أين أهل اللوم من أهل الهوى % % ما المحبون يساوون العدا % % 23(@)(@@) % كلما أرشف سمعي عاذلي % % مر لومي زدت في الحب صدى % % 24(@)(@@) % فكأن العذل منه طلب % % لهيامي بلسان عقدا % % 25(@)(@@) % أيريد الغر أن يصلح من % % حال أهل العشق ما قد فسدا % % 26(@)(@@) % إنما أهل الهوى مرآته % % وهو فيهم حاله قد شهدا % % 27(@)(@@) % ثم لما أشكل الأمر رمى % % نفسه من جهله وانتقدا % % 28(@)(@@) % وادعى العشق فلم يحصل له % % وعلى أهل الهوى قد حقدا % % 29(@)(@@) % قام فيهم يكثر اللوم لهم % % أو لم يخش الإله الصمدا % % 30(@)(@@) % هبه لا يعرف لذات الهوى % % حسن محبوب فؤادي جحدا % % PageV01P430 31 
ms85	(@)(@@) % إن قلبي اليوم في أسر رشا % % لا يرى للقتل عشقا قودا % % 32(@)(@@) % وجهه الجنة في أعيننا % % خده النار بقلبي وقدا % % 33(@)(@@) % لم يزل يجفو وأبليت على % % حبه أثواب عمري الجددا % % 34(@)(@@) % ولكم أفنيت جسمي سقما % % وتنفست عليه الصعدا وإذا في حبه مت فقد عشت بعد الموت عيش السعدا % % 35(@)(@@) % يا سقى الله زمانا بالحمى % % ورعى بالشعب عيشا رغدا % % 36(@)(@@) % طالما كنت به طوع هوى % % لم أخف في نهب وقتي أحدا % % 37(@)(@@) % حيث غزلان النقا قد أنست % % بي وبعد المنع أولتني ندا % % 38(@)(@@) % وكحلت العين بالعين وما % % بعدها عدت شكوت الرمدا % % 39(@)(@@) % حيث أقمار البها طالعة % % تتجلى ولها الروح فدا % % 40(@)(@@) % وغصون البان لما انعطفت % % طائر القلب عليهن شدا % % PageV01P431 41(@)(@@) % حيث وجه السعد فينا مقبل % % بالهنا والهم عنا طردا % % 42(@)(@@) % وكؤوس الأنس بالقوم صفت % % وبنا الورد إليه وردا % % 43(@)(@@) % في رياض ضحك الزهر بها % % كلما السحب بكت قطر الندى % % 44(@)(@@) % هزت النسمة من أغصانها % % حين جلتها قنا مرتعدا % % 45(@)(@@) % فلهذا كبر الطير وقد % % لبس النهر علينا زردا % % 46(@)(@@) % والصبا يذكرنا عهد الصبا % % ليت بالأمس لي كان غدا % % 47(@)(@@) % ليت لو جاد زماني بالذي % % كان منه قبل ذا قد عهدا % % 48(@)(@@) % يا أصيحابي بأكناف الحمى % % عللاني إن صبري فقدا % % 49(@)(@@) % واذكرا لي سندا أعرفه % % لست ألقى لي سواه سندا % % 50(@)(@@) % نفد الدمع على جفوته % % واشتياقي والجوى ما نفدا % % PageV01P432 51(@)(@@) % هو في القلب مقيم بل أنا % % هو لا بل هو دوني وجدا % % 52(@)(@@) % كذب القائل قد حل به % % والذي قد قال فيه اتحدا % % 53(@)(@@) % إنما المعشوق موجود ولا % % عاشق غير التباس قصدا % % 54(@)(@@) % لي هوى بالشعب من كاظمة % % ساكن هذا الحشى والكبدا % % 55(@)(@@) % وأنا اليوم به مشتهر % % فليمت ضدي ويبلى حسدا % % 56(@)(@@) % أنا مفتي العشق من يسألني % % عن هواه يلقني مجتهدا % % 57(@)(@@) % أنا قاضي شرع أرباب الهوى % % كل حكم بينهم لي حمدا % % 58(@)(@@) % فالذي أمنعه يشقى ومن % % أجعل الحق له قد سعدا % % 59(@)(@@) % غير أني في أناس جهلوا % % ما أنا في شأنه والجهل 
ms86	 دا % % PageV01P433 البحر : - 1(@)(@@) % إن للكفر ظلمة في الوجود % % تستر الروح تحت طي الجلود % % 2(@)(@@) % وهو عين السوى وللنور نار % % هي في النشأتين ذات الوقود % % 3(@)(@@) % فلهذا ترى الكثائف فيه % % آذنت يوم بعدها بالخلود % % 4(@)(@@) % كل علو له من الكفر سفل % % ضم موجوده إلى المفقود % % 5(@)(@@) % ويح قوم باعوا نهارات قرب % % بليال من شدة البعد سود % % 6(@)(@@) % ثم أعمالهم بدت كسراب % % حسبوه المياه في الأخدود % % 7(@)(@@) % ثم لما أتوه لم يجدوه % % ودهتهم جهالة المطرود % % 8(@)(@@) % ورمتهم سماءهم بشهاب % % فرأوا النار تحت ظل العمود % % PageV01P434 البحر : - 1(@)(@@) % قلم يجري له النور يد % % فوق لوح معه يتحد % % 2(@)(@@) % يكتب الظاهر والباطن من % % كل شي كان فهو المدد % % 3(@)(@@) % وهو عين الكل والكل له % % راجع إذ هو فيهم رصد % % 4(@)(@@) % وهو لا شك كثير بالورى % % وهو في تحقيقه منفرد % % 5(@)(@@) % مثل ما أنك ذو عقل به % % تعقل الأشيا كما يعتمد % % 6(@)(@@) % بحر ماء موجه أرواحه % % راق والأجسام فيه الزبد % % 7(@)(@@) % وإذا شئت فقل عقل وقل % % هي نفس كل شيء تلد % % PageV01P435 البحر : - 1(@)(@@) % يا قليل الصبر والجلد % % خلق الإنسان في كبد % % 2(@)(@@) % فالتفت فالظل أنت له % % وتواجد في الهوى تجد % % 3(@)(@@) % كل من في الكون مشتغل % % بالإله الواحد الصمد % % 4(@)(@@) % لكن الجهال عنه به % % في اشتغالات إلى الأبد % % 5(@)(@@) % واشتغال العارفين به % % فيه لم يلووا على أحد % % 6(@)(@@) % والذي يبدو لأعينهم % % كله أوصافه فقد % % PageV01P436 البحر : - 1(@)(@@) % ما الكل إلا رجل واحد % % ففز بهذا الرجل الواحد % % 2(@)(@@) % وما عداه فهي أفكاره % % ترددت في قلبه الواجد % % 3(@)(@@) % فتارة منها له مظهر % % فيها من المولود والوالد % % 4(@)(@@) % وتارة يفقد منها له % % مظهره المفقود بالفاقد % % 5(@)(@@) % وكل ذا دل على حيرة % % من طارف الأمر ومن تالد % % 6(@)(@@) % والعجز عن خلاقه حطه % % فيما ترى من أمرك الشاهد % % PageV01P437 البحر : - 1(@)(@@) % ترك المراد له فكان مرادا % % وجرى بميدان الفناء جوادا % % 2(@)(@@) % طلب الحبيب لأجله منه ولم % % يطلب له من نفسه ليزادا % % 3(@)(@@) % فهو الذي شرب الحقيقة صرفه % % فاختال إطلاقا وفك قيادا % % 4(@)(@@) % وبدا 
ms87	 بأفلاك الوجود على الورى % % شمسا تنير خلائقا وبلادا % % PageV01P438 البحر : - 1(@)(@@) % أمسك الحق باليد % % كل شي محدد % % 2(@)(@@) % ولقد كان مطلقا % % فبدا كالمقيد % % 3(@)(@@) % حين مفقودنا أتى % % بوجود كموجد % % 4(@)(@@) % والذي في ضلالة % % صار فيه كمهتدي % % 5(@)(@@) % ثم قرت عيونه % % وارتوى قلبه الصدى % % 6(@)(@@) % يا أبا الخير لا تكن % % بالسوى في تردد % % 7(@)(@@) % إنما كل منتهي % % في الورى كل مبتدي % % 8(@)(@@) % فإذا لاح كوكب % % منك فاشهده تهتدي % % 9(@)(@@) % ومتى ما بدا أما مك % % في ذانك اقتد % % 10(@)(@@) % واجتنب كل مشرك % % في ثياب الموحد % % PageV01P439 البحر : - 1(@)(@@) % بالأجرع من جهات ذاك الوادي % % برق قد دك لمعه أطوادي % % 2(@)(@@) % والنسمة حين أقبلت تسعدني % % يا نفحة من أحب طاب البادي % % PageV01P440 البحر : - 1(@)(@@) % عرج بالسفح من نواحي نجد % % وأخبر عن حالتي وقل عن وجدي % % 2(@)(@@) % في اليقظة لا أرى عسى في نومي % % من جانبهم طيف خيال يجدي % % PageV01P441 البحر : - 1(@)(@@) % يا من لهجت بشكره % . . . % 2(@)(@@) % للدهر صولة مكره % . . . % 3(@)(@@) % كن منقذي من مكره % . . . % 4(@)(@@) % يا من تحل بذكره % % عقد النوائب والشدائد % % 5(@)(@@) % عبد جنايته شكا % . . . % 6(@)(@@) % أمد التذلل أدركا % . . . % 7(@)(@@) % ودعاك يعلن بالبكا % . . . % 8(@)(@@) % يا من إليه المشتكى % % وإليه أمر الخلق عائد % % 9(@)(@@) % هطلت مدامعه حيا % . . . % 10(@)(@@) % من ذنبه هطل الحيا % . . . % PageV01P442 11(@)(@@) % لك قد أتى مستجديا % . . . % 12(@)(@@) % يا حي يا قيوم يا % % صمد تنزه عن مضادد % % 13(@)(@@) % لك بالجرائم والخطا % . . . % 14(@)(@@) % قد جاء يسرع في الخطا % . . . % 15(@)(@@) % حاشاك تبخل بالعطا % . . . % 16(@)(@@) % أنت المعز لمن أطا عك % % والمذل لكل جاحد % % 17(@)(@@) % فارحم حسيرا مذنبا % . . . % 18(@)(@@) % ألف الهموم من الصبا % . . . % 19(@)(@@) % وغدا بها متلهبا % . . . % 20(@)(@@) % أنت الرقيب على العباد % % وأنت في الملكوت واحد % % PageV01P443 21(@)(@@) % لمتى أروح وأغتدي % . . . % 22(@)(@@) % في لهفة وتنكد % . . . % 23(@)(@@) % ويلاه عز تجلدي % . . . % 24(@)(@@) % أنت المنزة يا بديع % % الخلق عن ولد ووالد % % 25(@)(@@) % فرط اللواعج مذ رسخ % . . . % 26(@)(@@) % في القلب مصطبري انتسخ % . . . % 27(@)(@@) % من لي بمن عهدي فسخ % . . . % 28(@)(@@) % أنت الميسر والمسخخر % % والمسبب والمساعد % % 29(@)(@@) % في الدهر زاد تحيري % . . . % 30(@)(@@) % بتأسف وتحسر % . . . % PageV01P444 31(@)(@@) % وجرت مدامع محجري % . . . % 32 
ms88	(@)(@@) % سبب لنا فرجا قريبا % % يا إلهي لا تباعد % % 33(@)(@@) % يا رب عبدك مسلم % . . . % 34(@)(@@) % ولك الأمور مسلم % . . . % 35(@)(@@) % يا من يجود ويرحم % . . . % 36(@)(@@) % إني دعوتك والهمو م % % جيوشها قلبي تطارد % % 37(@)(@@) % أواه طال تشتتي % . . . % 38(@)(@@) % والبين أحرق مهجتي % . . . % 39(@)(@@) % وبك استغثت لشدتي % . . . % 40(@)(@@) % فافرج بعزك كربتي % % يا من له حسن العوايد % % PageV01P445 41(@)(@@) % أنت المجيب لمن دعا % . . . % 42(@)(@@) % تشفي الفؤاد الموجعا % . . . % 43(@)(@@) % بالذل جئتك مسرعا % . . . % 44(@)(@@) % وخفي لطفك يستعا ن % % به على الزمن المعاند % % 45(@)(@@) % غصن التصبر قد يبس % . . . % 46(@)(@@) % والهم قلبي مفترس % . . . % 47(@)(@@) % وأنا الحزين المبتئس % . . . % 48(@)(@@) % كن راحمي فلقد يئست % % من الأقارب والأباعد % % 49(@)(@@) % واغفر لعبد مذنب % . . . % 50(@)(@@) % قلق الفؤاد معذب % . . . % PageV01P446 51(@)(@@) % والطف أيا مولاي بي % . . . % 52(@)(@@) % ثم الصلاة على النبي % % وآله ما خر ساجد % % PageV01P447 البحر : - 1(@)(@@) % قلوبنا بك أبلتها النوى كمدا % . . . % 2(@)(@@) % ونحن قوم ضعاف صبرنا نفدا % . . . % 3(@)(@@) % وقد أتينا بذل نطلب المددا % . . . % 4(@)(@@) % يا رب هيئ لنا من أمرنا رشدا % % واجعل معونتك الحسنى لنا مددا % % 5(@)(@@) % والطف بنا واسقنا من خمر أكؤسنا % . . . % 6(@)(@@) % صفا صرف من التوحيد مؤنسنا % . . . % 7(@)(@@) % ودبر الأمر واكشف ستر حندسنا % . . . % 8(@)(@@) % ولا تكلنا إلى تدبير أنفسنا % % فالنفس تعجز عن إصلاح ما فسدا % % 9(@)(@@) % لي قلب صب على الأشواق مشتمل % . . . % 10(@)(@@) % وقد بكيت بدمع فيك منهمل % . . . % PageV01P448 11(@)(@@) % وما اعتمادي على علمي ولا عملي % . . . % 12(@)(@@) % أنت الكريم وقد وجهت يا أملي % % إلى جنابك قلبا سالما ويدا % % 13(@)(@@) % عودتنا الخير واستعبدت سائبة % . . . % 14(@)(@@) % وكم رفعت بلا عنا ونائبه % . . . % 15(@)(@@) % والنفس من ذنبها جاءتك تائبة % . . . % 16(@)(@@) % فلا تردنها يا رب خائبة % % فبحر جودك يروي كل من وردا % % PageV01P449 البحر : - 1(@)(@@) % إن ديني وملتي واعتقادي % % حب سلمى وزينب وسعاد % % 2(@)(@@) % فانتقص من ملامتي أو فزدني % % يا عذولي فلست من أندادي % % 3(@)(@@) % كيف أسلو مليح هي مني % % في مقام الأرواح للأجساد % % 4(@)(@@) % إن كلي قد شف عنها جهارا % % فاعرفوها في أرجلي والأيادي % % 5(@)(@@) % أبغضتها مني العدا بعيون % % هي ما بين جفنهم والسواد % % 6(@)(@@) % قذفتهم عنها بوهم حلول % % صوروه بهم ووهم 
ms89	 اتحاد % % 7(@)(@@) % وأشاعوه في اعتقاد رجال % % ربهم عندهم لبالمرصاد % % 8(@)(@@) % وإذا تاهت العقول فهل من % % مرشد غير خالق الإرشاد % % 9(@)(@@) % لي بنجد سقى الحيا أرض نجد % % فرط عشق ما إن له من نفاد % % 10(@)(@@) % وغرام وصبوة بجياد % % يا رعى الله عهدنا بجياد % % PageV01P450 11(@)(@@) % نزل الركب عن يمين المصلى % % وأراهم قد خيموا بفؤادي % % 12(@)(@@) % وأنا الذنب عند من هو كلي % % أرتجي توبة من الإيجاد % % 13(@)(@@) % ملت عني به إليه لأني % % دائما منه طوع كل مراد % % 14(@)(@@) % ثم بي مال عنه لي وهو طوعي % % فرأيت الأشفاع في الأفراد % % 15(@)(@@) % وأتاني الخطاب من طور نفسي % % عندما دك من تجلي الجواد % % 16(@)(@@) % وسرى سر كل شيء بسري % % وبدا النور من يمين الوادي % % 17(@)(@@) % خضت بحر الحياة والكل موتى % % وشربت الوجود والكل صادي % % 18(@)(@@) % وصعدت العلا وخلفت جسمي % % في يدي أصدقائه والأعادي % % 19(@)(@@) % منه قوم ذاقوا اللذيذ وقوم % % مضغوا السم منه في الأكباد % % 20(@)(@@) % عظمت منه الإله علينا % % كل حين من كل العباد % % PageV01P451 21(@)(@@) % وإذا أنعم الكريم فماذا % % أنتجته عداوة الحساد % % PageV01P452 البحر : - 1(@)(@@) % إن أعياننا لثوابت في العلم % % الإلهي قبل هذا الوجود % % 2(@)(@@) % عدم خالص بغير خلاف % % عند أهل الحجا وأهل الشهود % % 3(@)(@@) % فهي ليست مجعولة للزوم الجعل % % حل الموجود في الموجود % % 4(@)(@@) % ولأن الجعل الإضافة للنو ر % % وذي لا تكون للمفقود % % PageV01P453 البحر : - 1(@)(@@) % يا من يمد لأخلاق القلوب يدا % % فيبدل الغي من طغيانها رشدا % % 2(@)(@@) % ويحفظ السوء منها كي يجانبه % % ويغسل القلب منه فاسمع العددا % % 3(@)(@@) % كفر وجهل وغدر والخيانة مع % % كبر وعجب وإخلاف لما وعدا % % 4(@)(@@) % وحب جاه وخوف الذم جربزة % % سخط القضاء كذا في الحق إن مردا % % 5(@)(@@) % والأمن واليأس حب المدح مع حسد % % بخل رياء نفاق والخمور بدا % % 6(@)(@@) % وبدعه سفه حرص مداهنة % % وسوء ظن وتسويف بطول مدى % % 7(@)(@@) % غش وأنس بمخلوق كذا جزع % % وخفة وعناد بعض أهل هدى % % 8(@)(@@) % والجبن والذل والإسراف مع طمع % % شماته ومحاكاة لفعل عدا % % 9(@)(@@) % والحزن والخوف في الدنيا وشهوتها % % غباوة شره إصرار من فسدا % % 10 
ms90	(@)(@@) % تهور صلف ثم اتباع هوى % % وللبطالة أن تلقاه معتمدا % % PageV01P454 11(@)(@@) % وحب دنيا وحب الظالمين وأن % % يعلق القلب بالأسباب والكبدا % % 12(@)(@@) % وحب مال وتقليد فظاظته % % وقاحة فتنة مع كونه حقدا % % 13(@)(@@) % تطير كذا استعجاله أمل % % كفران نعمة من أولى إليه يدا % % 14(@)(@@) % فهذه جملة الأخلاق قد جمعت % % ستين كن في النقا منهن مجتهدا % % PageV01P455 البحر : - 1(@)(@@) % نحن قوم ذنوبنا للأعادي % % أخذوها بغيب وانتقاد % % 2(@)(@@) % وأخذنا طاعاتهم بازدراء وعتوفي حقنا وعناد % . . . % 3(@)(@@) % كيف لا نرتقي عليهم ونعلو % % ونرى كل ساعة في ازدياد % % 4(@)(@@) % وهم العاملون خيرا لنا إن % % عملوا لانتهاك حق العباد % % 5(@)(@@) % وهم الغاسلون للذنب عنا % % مثل بالوعة لنفي فساد % % 6(@)(@@) % ولهم كل ساعة حرب شرك % % واعتراض على عطاء الجواد % % 7(@)(@@) % ولنا صبر ذي الكمال عليهم % % ولنا بالدعا ثواب جهاد % % 8(@)(@@) % خلهم يا أخا المودة فينا % % يطعنوا إن الله بالمرصاد % % PageV01P456 البحر : - 1(@)(@@) % من كان بالعشق مفقود % % فذاك بالحق موجود % % 2(@)(@@) % وذاك ميت وحي % % وشاهد وهو مشهود % % 3(@)(@@) % وكل باب إلى الله % % غير ذاك فمسدود % % 4(@)(@@) % واسمع حديثا صحيحا % % كالدر وافاك معقود % % 5(@)(@@) % في مسند قد رواه % % للديلمي السادة القود % % 6(@)(@@) % يقول خير البرايا % % بحر العطيات والجود % % 7(@)(@@) % عليكمو بالوجوه الملاح % % والحدق السود % % PageV01P457 البحر : - 1(@)(@@) % اجتمعوا يا إخوتي واحشدوا % % فإن لي مسألة تجهد % % 2(@)(@@) % كنت أنا واليوم من مدة % % لست أنا ذاك الذي أعهد % % 3(@)(@@) % ذاك مضى عني وهذا أتى % % وفيهما أني أنا المفرد % % 4(@)(@@) % وتارة حيث التجلي اقتضى % % أذم هذاك وذا أحمد % % 5(@)(@@) % أنا الذي اعهدوهم وقد % % زال وجاء الحق لا يجحد % % 6(@)(@@) % أم ذاك مشهود الذي جاءني % % فإنه كيف يشا يشهد % % 7(@)(@@) % أم تلك أيدي أيدي الكائنات التي % % من فوقها لله طالت يد % % 8(@)(@@) % أم سيئات النفس قد بدلت % % لي حسنات واهتدى المفسد % % 9(@)(@@) % أو سلم الشيطان إرث الذي % % عن النبي المصطفى يسند % % 10(@)(@@) % حقيقة حققها ناطق % % مجازها قد صار لا يقصد % % PageV01P458 11(@)(@@) % أم هو ذاك الغيب من أصله % % شهادة جاءت له ترشد % % 12(@)(@@) % والعلم قسمان مستحضر % % ذكرا ومحفوظ له يمدد 
ms91	 % % 13(@)(@@) % والكل من حفظ قديم إلى % % ذكر هو المحدث لا ينفد % % 14(@)(@@) % وجود حق بشؤن له % % مفروضه أبيض أو أسود % % 15(@)(@@) % وكلها فانية عنده % % وهي به لامعة توجد % % 16(@)(@@) % خلوا معاني الذوق لي أو دعوا % % دعواكم العلم ولا تعتدوا % % 17(@)(@@) % وحققوا أنفسكم وأدركوا % % بالكشف ما جاء به المرشد % % 18(@)(@@) % وميزوا ما قاله عارف % % من الذي يذكره الملحد % % 19(@)(@@) % وكحل في أعين خلقة % % ليس كعين كحلها الإثمد % % 20(@)(@@) % وليس من يملك شيا له % % كمستعير للسوى يردد % % PageV01P459 البحر : - 1(@)(@@) % كن عارفا بوحدة الوجود % % وقاطعا بكثرة الموجود % % 2(@)(@@) % وميز الحادث من قديم % % وخلص الثابت من مفقود % % 3(@)(@@) % واحذر من التباس من تجلي % % بغيره في حالة الشهود % % 4(@)(@@) % فوحدة الوجود في اصطلاحنا % % كناية عن رؤية الودود % % 5(@)(@@) % بالحس والذوق الصحيح الطاهر الطهور % % من شك ومن جحود % % 6(@)(@@) % لا بخيال العقل والفكر وما % % تأتي به طبائع الجلود % % 7(@)(@@) % منزها مقدسا مسبحا % % عن كل والد وعن مولود % % 8(@)(@@) % وعن دخول وخروج في سوى % % وعن جميع مقتضى الحدود % % 9(@)(@@) % وعن كمال نحن ندريه وعن % % نقص وعن زوال أو نفود % % 10(@)(@@) % وإنما كماله بمقتضى % % ما قاله عن نفسه بالجود % % PageV01P460 11(@)(@@) % نعلمه نحن بما علمنا % % به من الوفاء بالعهود % % 12(@)(@@) % والصدق والقيام بالحق له % % على سبيل الركع السجود % % 13(@)(@@) % من زاد عجزا عنه زاد علمه % % به مدى الصدور والورود % % 14(@)(@@) % يا أيها الناظر بالعقل احترز % % أن تفهم المطلق بالقيود % % 15(@)(@@) % واصبر إلى أن يفتح الله ولا % % تهجم على مرابض الأسود % % 16(@)(@@) % ودع علوم الله عند أهلها % % واردع حجا جاهلك الكنود % % 17(@)(@@) % وإن أردت فاترك الدنيا وغب % % عن علمك المزخرف المرصود % % 18(@)(@@) % وعد عن جاه ومنصب وعن % % أهل وعن أصل عن جدود % % 19(@)(@@) % واقنع بمن تطلبه دون الورى % % واخرج عن القيام والقعود % % 20(@)(@@) % واخلص له الني واصبر واصطبر % % على مراده بك المقصود % % PageV01P461 21(@)(@@) % ولا تظن وحدة الوجود ما % % تفهم من وحدة ذا الوجود % % 22(@)(@@) % تفهم معنى وتقول أنه % % هو مراد الأكملين القود % % 23(@)(@@) % وليس ذا مرادهم لأنهم % % فاتوك في منابر 
ms92	 الصعود % % 24(@)(@@) % وأنت في الحضيض مأسور الهوى % % بشهوة كالنار في الوقود % % 25(@)(@@) % اسلك سبيلهم وقل بقولهم % % تدرى الذي دروا بلا صدود % % 26(@)(@@) % فإن تقوى الله من يخلص بها % % حلت عقال عقله المعقود % % 27(@)(@@) % هيهات هيهات لفرد واحد % % يدخل في مراتب المعدود % % 28(@)(@@) % ومطلق حتى عن الإطلاق لا % % يفهم في عقد من العقود % % 29(@)(@@) % وأين نور الحق ممن عقله % % في ظلمات من سواه سود % % 30(@)(@@) % إن المعاني كلها حوادث % % منفية عن ربنا المشهود % % PageV01P462 31(@)(@@) % لأنه مسبح عنها بها % % في سيلان هي أو جمود % % 32(@)(@@) % وإنما الأمر الذي نريده % % بوحدة الوجود في المعهود % % 33(@)(@@) % أمر عظيم خارج عن كل ما % % تدري ذوو الشقوة والسعود % % 34(@)(@@) % حقيقة تفني الجميع إن بدت % % للعقل عنها العقل في رقود % % 35(@)(@@) % ومن أتى بها عليه في الورى % % بغى بسوء وافترى وعودي % % 36(@)(@@) % لأنها السر الذي جاء به % % نبينا رغما عن الحسود % % 37(@)(@@) % وهو الذي في آدم لما بدا % % خرت له الأملاك بالسجود % % 38(@)(@@) % وقد أبى إبليس عن سجوده % % له فلا يزال بالمطرود % % 39(@)(@@) % فيه النصارى بالحلول كفرهم % % والكفر بالتجسيم في اليهود % % 40(@)(@@) % وعنه زاغت عصبة وألحدوا % % حتى بهم آل إلى اللحود % % PageV01P463 41(@)(@@) % وقد مضت نبوة به وقد % % أتت خلافة بلا جنود % % 42(@)(@@) % في كل عصر واحد فواحد % % إلى قيام الساعة الموعود % % 43(@)(@@) % هذا المراد عندنا بوحدة الوجود % % نتلوه على الشهود % % 44(@)(@@) % ليشهدوا لنا به في موقف % % يفي به الكريم في الوعود % % 45(@)(@@) % وتظهر الحج بالشاهد أن % % قد بلغ الغائب ذا الهجود % % 46(@)(@@) % نحن بهذا قائلون دائما % % ونوره فينا بلا خمود % % 47(@)(@@) % لا أننا نقول بالمعنى الذي % % تقول أهل المذهب المردود % % 48(@)(@@) % فالله من ضلالهم يعصمنا % % بفتح باب دونهم مسدود % % 49(@)(@@) % ومن علينا يفتري بغير ما % % قلنا رخهين يومه المشهود % % PageV01P464 البحر : - 1(@)(@@) % لي رتبة العلامة الشهم الأسد % . . . % 2(@)(@@) % قد أنشبت بين العدا ناب الأسد % . . . % 3(@)(@@) % والحب رغما عن أنوف أولي الحسد % . . . % 4(@)(@@) % سكن الفؤاد فعش هنيئا يا جسد % % هذا النعيم هو المقيم إلى الأبد % % 5(@)(@@) % يا نسوة الحظ 
ms93	 الخسيس رويدكن % . . . % 6(@)(@@) % يا ليتكن عرفتني يا ليتكن % . . . % 7(@)(@@) % فأنا الذي نلت العلا من يوم كن % . . . % 8(@)(@@) % أصبحت في كنف الحبيب ومن يكن % % جار الحبيب فعيشه العيش الرغد % % 9(@)(@@) % عرش الوجود أظلني بضيائه % . . . % 10(@)(@@) % وحبا التجلي لي ثياب ولائه % . . . % PageV01P465 11(@)(@@) % وأتى من الرحمن طيب ندائه % . . . % 12(@)(@@) % عش في أمان الله تحت لوائه % % لا خوف في هذا الجناب ولا نكد % % 13(@)(@@) % يا هيكل الأنوار سرك ما اكتمن % . . . % 14(@)(@@) % إن بعت ما تلقاه أنت هو الثمن % . . . % 15(@)(@@) % أنت الحفيظ على الجميع المؤتمن % . . . % 16(@)(@@) % لا تختشي فقدا فعندك بيت من % % كل المنى لك من أياديه مدد % % 17(@)(@@) % هي حضرة في الشام طاب بها اليمن % . . . % 18(@)(@@) % وبعلمها والفضل أشرقت الدمن % . . . % 19(@)(@@) % ذات بها قد جاد مولاي ومن % . . . % 20(@)(@@) % رب الجمال ومرسل الجدوى ومن % % هو في المحاسن كلها فرد أحد % % PageV01P466 21(@)(@@) % أنا من أعز أولي النهى وأجلها % . . . % 22(@)(@@) % وربيت في نهل العلوم وعلها % . . . % 23(@)(@@) % ووقفت في الشجرات لا في ظلها % . . . % 24(@)(@@) % قطب النهى غوث العوالم كلها % % أعلى على سار أحمد من حمد % % 25(@)(@@) % يا من تثنى وهو عندي واحد % . . . % 26(@)(@@) % حق له منه عليه شواهد % . . . % 27(@)(@@) % إني الذي أبدا لوجهك ساجد % . . . % 28(@)(@@) % روح الوجود حياة من هو واجد % % لولاه ما تم الوجود لمن وجد % % 29(@)(@@) % أنا من كبار لا يطاق رضيعهم % . . . % 30(@)(@@) % وبصيرهم عين العلا وسميعهم % . . . % PageV01P467 31(@)(@@) % هم نابتون عليه وهو ربيعهم % . . . % 32(@)(@@) % عيسى وآدم والصدور جميعهم % % هم أعين هو نورها الماورد % % 33(@)(@@) % عجزت عقول ذوي النهى عن كنهه % . . . % 34(@)(@@) % وتولهت عين السوى في شبهه % . . . % 35(@)(@@) % والكل عن كل لنا لم يلهه % . . . % 36(@)(@@) % لو أبصر الشيطان طلعة وجهه % % في وجه آدم كان أول من سجد % % 37(@)(@@) % قمر تبدى في سماء كماله % . . . % 38(@)(@@) % لو تبصر الأقمار نور هلاله % . . . % 39(@)(@@) % غابت وذابت تحت ذيل ظلاله % . . . % 40(@)(@@) % أو لو رأى النمرود نور جماله % % عبد الجليل مع الخليل ولا عند % % PageV01P468 41(@)(@@) % هو باطن حجب الجهول المنكرا % . . . % 42(@)(@@) % بل ظاهر من نوره بهر الورى % . . . % 43(@)(@@) % طمعت نفوس فيه ملقاة ورا 
ms94	 % . . . % 44(@)(@@) % لكن جمال الحق جل فلا يرى % % إلا بتخصيص من الله الصمد % % 45(@)(@@) % في ظلمة الأكوان لاح لك الضيا % . . . % 46(@)(@@) % فاسرع إلى لألائه متمليا % . . . % 47(@)(@@) % وإذا رميت عليه جهدك والعيا % . . . % 48(@)(@@) % فابشر بمن سكن الجوانح منك يا % % أنا قد ملأت من المنى عينا ويد % % 49(@)(@@) % يا مؤمنا دع عنك طاغية الجفا % . . . % 50(@)(@@) % متحيرين وكن بنا متعففا % . . . % PageV01P469 51(@)(@@) % نحن الذين نرى جمال المصطفى % . . . % 52(@)(@@) % عين الوفا معنى الصفا سر الوفا % % نور الهدى بحر الندى جسد الرشد % % 53(@)(@@) % حتى تجلى من سموات الرضى % . . . % 54(@)(@@) % وبه على الأكوان قد سمح القضا % . . . % 55(@)(@@) % لا شيء إلا بعد ظلمته أضا % . . . % 56(@)(@@) % هو للصلاة مع السلام المرتضى % % الجامع المخصوص ما دام الأبد % % PageV01P470 البحر : - 1(@)(@@) % إن السيادة والريا سة % % في الشقي وفي السعيد ثوبان للمولى الذي سمي بأسماء العبيد % % 2(@)(@@) % لهما الشقي قد ادعى % % بنزاع خاطره العنيد % % 3(@)(@@) % فنزاعه المذموم لا % % ما ليس عنه من محيد % % 4(@)(@@) % ولدا السعيد هما لقد % % نسبا إلى الرب المجيد % % 5(@)(@@) % قد أسلمت إفهامه % % فأبت عن الأمر الشديد % % 6(@)(@@) % فغدت سيادته على % % كل الوجود بلا مزيد % % 7(@)(@@) % وله الرياسة دائما % % في دولة الكون الجديد % % 8(@)(@@) % والسر فيه بأنه % % قد زال من بيت القصيد % % 9(@)(@@) % لا زال منه وصفه % % وبقي كأحوال المريد % % 10(@)(@@) % إن المراد هو المريد % % إذا حوى حكم الفريد % % PageV01P471 11(@)(@@) % ومشى إليه القهقرى % % ورأى البرية من بعيد % % 12(@)(@@) % وجميع أبعاد السوى % % قرب لذي الأمر الوحيد % % 13(@)(@@) % والقرب ما قد كان في % % أزل على الشأن المديد % % 14(@)(@@) % والوهم زال ولم يكن % % من قبل في فهم البليد % % 15(@)(@@) % والقوم قد دخلوا إلى % % ذات لقاها يوم عيد % % 16(@)(@@) % والكهف يأوي أهله % % والكلب منهم بالوصيد % % 17(@)(@@) % ودخولهم عين الخرو ج % % بمقتضى القول السديد % % 18(@)(@@) % والأمر أمر واحد % % لكن بتكرار عديد % % 19(@)(@@) % والقرب قرب الذات وهو % % الأصل لأقرب الوريد % % 20(@)(@@) % إن الوريد من الورو د % % وما ورودك بالمفيد % % PageV01P472 21(@)(@@) % أهل الحمى حرسوا الحمى % % عمن يروم وصال غيد % % 22(@)(@@) % لا عن محارمهم فهم % % منهم كأمثال الوليد % % 23 
ms95	(@)(@@) % فاظهر لهم منهم بهم % % وأشهد تكن عين الشهيد % % 24(@)(@@) % إن الفروع من الأصو ل % % صناعة المبدي المعيد % % PageV01P473 البحر : - 1(@)(@@) % كل وقت جمال وجهك بادي % % يتجلى في مهجتي وفؤادي % % 2(@)(@@) % ولقد دلني عليك محيا % % لك قام الجمال فيه ينادي % % 3(@)(@@) % وبجسمي أودى السقام وقلبي % % زال الصبر زاد الإيقاد % % 4(@)(@@) % وعيوني مدى الدجى شاخصات % % آه من فرط دمعها والسهاد % % 5(@)(@@) % وشج بين صبوة وغرام % % واشتياق وحرقة وارتعاد واجتناب وقسوة وجفاء وصدود ونفرة وبعاد % % 6(@)(@@) % ورقيب ولائم وعذول % % وبغيض وكاشح ومعادي % % 7(@)(@@) % كيف يهنا بل كيف يبقى وهذا % % حاله وهو مؤذن بالنفاد % % 8(@)(@@) % يا هلا طلعت بالنفس مني % % فتحققت كثرتي واتحادي % % 9(@)(@@) % شهدت نورك القلوب فولت % % ظلمة الكون من عيون البعاد % % 10(@)(@@) % نظري للسوى إليك ولكن % % دق عن فكرتي لفقد رشادي % % PageV01P474 11(@)(@@) % ثم لما أردت مني تدنو % % كنت أنت الحشى وسر الفؤاد % % 12(@)(@@) % وتلطف بي فشاهدت مرئى % % مقتضى ذاك أنت بالمرصاد % % PageV01P475 البحر : - 1(@)(@@) % وجود كوني من تجلي الجواد % % هذا عطا ما له من نفاد % % 2(@)(@@) % يا عدما أحرفه خطها % % كاتبه النور بنور المداد % % 3(@)(@@) % أنت شؤون الحق لا يلتبس % % عليك معبود هنا بالعباد % % 4(@)(@@) % وبينه فافرق وبين الورى % % وبالغنى والفقر فالفرق باد % % 5(@)(@@) % واجمع فشيء واحد ما به % % تعدد في نظر الاقتصاد % % 6(@)(@@) % واكتب به بالأبيض المجتلي % % والناس دعهم يكتبوا بالسواد % % 7(@)(@@) % واشهد بما تعرف فيما ترى % % شهادة الحق بغير استناد % % 8(@)(@@) % وأيقظ الخاطر من غفلة % % وامسح من الأغيار كحل الرقاد % % 9(@)(@@) % من لي بمن يبدو بأسمائه % % فيفعل الغي بها والرشاد % % 10(@)(@@) % والكل مفعول له مطلق % % عن قيد حرف جامع للتضاد % % PageV01P476 11(@)(@@) % صاد جميعي بظهوراته % % لصدغه والعين دال وصاد % % 12(@)(@@) % يحكم ما شا بنا داما % % لا جور منه كيفما قد أراد % % 13(@)(@@) % وعشقه صيرنا كالهبا % % وزادنا فرط البكا والسهاد % % 14(@)(@@) % بالله يا سئق ركباننا % % قل لسليمى طال هذا البعاد % % 15(@)(@@) % إني على العهد مقيم لها % % وإنني عنها كصوب العهاد % % 16(@)(@@) % يا طالما نلت بها خلوة % % وفزت منها بلذيذ المراد % % 17(@)(@@) % كانت تناجيني على 
ms96	 ذلتي % % وعزها باللطف والأتحاد % % 18(@)(@@) % واليوم لما ذبت في حبها % % والروح والجسم مضى والفؤاد % % 19(@)(@@) % وصار كلي مقتضى كلها % % وقوبل العالي لها بالوهاد % % 20(@)(@@) % واختطفت ذاتي بذات لها % % وزال ذاك الكد والإجتهاد % % PageV01P477 21(@)(@@) % وانطفت النار بنور اللقا % % وللهوى لم يبق غير الرماد % % 22(@)(@@) % غابت فلم أدر لها من نبا % % وأدرك الزرع وصار الحصاد % % 23(@)(@@) % كأنني في كونها لم أكن % % وهي التي كانت بحكم انفراد % % 24(@)(@@) % وإن هذا في الهوى قولها % % على لساني لمرادي أفاد % % 25(@)(@@) % لا أنني قلت فحمدي لها % % منها عليها زاد والشكر زاد % % 26(@)(@@) % وهي التي تعرفني مثل ما % % كنت قديما شررا في زناد % % 27(@)(@@) % واقتدحتني بإرادتها % % فلحت مثل البرق شيا يراد % % 28(@)(@@) % وعدت لا برقا ولا بارقا % % والشمس عنها الغيم في الأفق حاد % % 29(@)(@@) % فتارة عني بما قد مضى % % تترجم الأحوال بالافتقاد % % 30(@)(@@) % وتارة تترك لا تعتني % % حسب الذي منها يكون المراد % % PageV01P478 31(@)(@@) % وهكذا الكل لها راجع % % والكون كون والبلاد البلاد لا تحسب التحقيق غير الذي أنت له تدرك يا ذا العناد % % 32(@)(@@) % لكنك المحكوم منها بها % % عليك بالجهل بانتقاد % % 33(@)(@@) % وهي على ما هي في حضر % % بصدر عنها ذو ضلال وهاد % % 34(@)(@@) % بمقتضى أسمائها للذي % % شاءت من الإبهام في الإعتقاد % % PageV01P479 البحر : - 1(@)(@@) % هذا الكثير الواحد % % فافرح به يا واجد % % 2(@)(@@) % فجميعنا منه له % % طول الزمان محامد % % 3(@)(@@) % ما الكل إلا راكع % % أبدا إليه وساجد % % 4(@)(@@) % ولنا معانيه التي % % منه تلوح مساجد % % 5(@)(@@) % إن السجود هو الفنا % % فيه لمن هو قاصد % % 6(@)(@@) % وكذا الركوع الموت عن % % دعوى النفوس الوارد % % 7(@)(@@) % فاعجب لأمر زائد % % منه وما هو زائد % % 8(@)(@@) % خلق تكثر عدهم % % فتناسلوا وتوالدوا % % 9(@)(@@) % وتفرقوا فرقا وهم % % محسودهم والحاسد % % 10(@)(@@) % وجميعهم صور له % % عادت بهن عوائد % % PageV01P480 11(@)(@@) % وهم الشؤون لذاته % % فطوارف وتوالد % % 12(@)(@@) % وأمورنا انتظمت به % % عنه فنحن قصائد % % 13(@)(@@) % أيقظ فؤادك وانتبه % % لظهوره يا راقد % % 14(@)(@@) % واعلم بأنك واجد % % فيه وأنك فاقد % % 15(@)(@@) % فهو الذي بشؤونه % % متقارب متباعد % % 16(@)(@@) % والكل منه له به % % في الحالتين فوائد 
ms97	 % % 17(@)(@@) % بحر يميد بسفنه % % أبدا وما هو مائد % % 18(@)(@@) % هو مطلق وقيوده % % معدودة والعادد % % 19(@)(@@) % فاسكن به في ظله % % فهو الكريم الماجد % % 20(@)(@@) % أيان تقصده تجد % % منه تمد موائد % % PageV01P481 البحر : - 1(@)(@@) % هو الركبان والحادي % % هو السبعون والحادي % % 2(@)(@@) % هو المسعود والمطرو د % % مع حق وإلحاد % % 3(@)(@@) % هو المعدود والأعداد % % وهو العاد والعادي % % 4(@)(@@) % هو الأرواح والأشبا ح % % من أنواع أجساد هو الأفلاك والأملاك في مثنى وآحاد % % 5(@)(@@) % هو الدنيا وما فيها % % كتكريت وبغداد % % 6(@)(@@) % هو الأخرى وما تحوى % % كعباد وزهاد % % 7(@)(@@) % هو الأزهار والأثما ر % % وهو السيل والوادي % % 8(@)(@@) % هو الطير الذي غنى % % بلحن فوق أعواد % % 9(@)(@@) % هو الأعواد والأنشا د % % والمصغي لإنشاد % % 10(@)(@@) % هو المعروف والمجهو ل % % والمخفي والبادي % % PageV01P482 11(@)(@@) % هو الشمس التي لاحت % % وبدر الأفق في النادي % % 12(@)(@@) % هو المغوي والغاوي % % هو المهدي والهادي % % 13(@)(@@) % هو المدعو بأنساب % % وأنسال وأجداد % % 14(@)(@@) % وأعمام وأخوال % % وآباء وأولاد % % 15(@)(@@) % ثياب كلها يبدو % % بها من خلف أضداد % % 16(@)(@@) % إشارات له منه % % بإعطاء وإمداد % % 17(@)(@@) % على فرض وتقدير % % تراءت برق إيجاد % % 18(@)(@@) % وبالأمثال تكرار % % لها في شكل ترداد % % 19(@)(@@) % وعنها ذاته جلت % % وعزت دون أنداد % % 20(@)(@@) % وأسماء له حسنى % % إليه ذات إرشاد % % PageV01P483 21(@)(@@) % بها يبدو فتدريه % % ذوو التقوى أولو الزاد % % 22(@)(@@) % وجود مطلق عنه % % بدت أشكال أفراد % % 23(@)(@@) % وتسع تلك أعراض % % لها ذكر بتعداد % % 24(@)(@@) % تسمى الكتم مع كيف % % وأين عند نقاد % % 25(@)(@@) % متى والوضع مع ملك % % إضافات بإسناد % % 26(@)(@@) % وفعل وانفعال وهي % % معلومات إشهاد % % 27(@)(@@) % تجلى ربنا فيها % % لتقريب وإبعاد % % 28(@)(@@) % فقوم حققوا المجلى % % بأذكار وأوراد % % 29(@)(@@) % وقوم قد عموا عنه % % بحرمان لآباد % % PageV01P484 البحر : - 1(@)(@@) % اذبح النفس بسيف الاجتهاد % % في رضى مولاك تحظى بالمراد % % 2(@)(@@) % واكشف الحجب عن القلب به % % وتأمل وجه مولاك الجواد % % 3(@)(@@) % لا تكن من نفر قد أمروا % % فعموا عنه وصموا بازياد % % 4(@)(@@) % سألوا واستخبروا واستكشفوا % % ولقد هاموا به في كل واد % % 5(@)(@@) % ولو أن القوم فيهم رشد % % فوضوا الأمر إلى رب العباد % % 6(@)(@@) % وأتوا منه بما قد قدروا 
ms98	 % % واستطاعوا وعلى الله الرشاد % % PageV01P485 البحر : - 1(@)(@@) % إن بين الوجود والموجود % % حرف ميم بها مدار الشهود % % 2(@)(@@) % وهو حرف محمدي شريف % % هو عين الآباء عين الجدود % % 3(@)(@@) % وهو إمكان كل شيء تبدى % % وهو نفس الرسوم نفس القيود % % 4(@)(@@) % وله دورة كلمعة برق % % هي من عين وقفة وجمود % % 5(@)(@@) % وهو أمر الإله في كل خلق % % بالتقادير في الشقا والسعود % % 6(@)(@@) % ألف باستقامة وهي ميم % % حيث دارت في خدمة المعبود % % 7(@)(@@) % والوجود الوجود ما زال عما % % كان فيه بخطها الممدود % % 8(@)(@@) % وهي عقل يرى الإضافة حتما % % لوجود المهيمن المقصود % % 9(@)(@@) % فاعذروه لأنه عبد رب % % هائم في ركوعه والسجود % % 10(@)(@@) % وهو باقي الحروف أيان ولى % % بانحراف لوجهه المشهود % % PageV01P486 البحر : - 1(@)(@@) % وجود وأشيا ما لهن وجود % % فتبدو به منه له وتعود % % 2(@)(@@) % ملابس نور في هياكل ظلمة % % لهن اعتراف بالهوى وجحود % % 3(@)(@@) % على طبق ما في العلم والعلم واحد % % قديم بأشيا ما لهن نفود % % 4(@)(@@) % فحيث وجود لاح بعد خفائه % % يلوح بشيء مدة ويجود % % 5(@)(@@) % وتتبعه الأسماء مطلقة به % % على حسب الأشياء وهي قيود % % 6(@)(@@) % فسميت الأكوان باسم حدوثها % % سماء وأرض صخرة وعمود % % 7(@)(@@) % وما هو إلا الأمر وهو عوالم % % سوائل فيها للعقول جمود % % 8(@)(@@) % وروح وأرواح كشمس أشعة % % بها يكرم المبدي لها ويجود % % 9(@)(@@) % تكاثف منها النشو وهي لطيفة % % لصيغة علم الغيب وهو حدود % % 10(@)(@@) % على صورة الماء الحياة به بدت % % وصورة علم بالهواء ترود % % PageV01P487 11(@)(@@) % وفي صورة النار الإرداة صور % % وقدرته نحو التراب تقود % % 12(@)(@@) % وما صور الأسماء أجمعها سوى % % تفاصيل أفلاك وهن رصود % % 13(@)(@@) % ودارت كما دارت قديما فأنتجت % % حوادثها الأيقاظ وهي رقود % % 14(@)(@@) % فكان جمادا والنبات كلاهما % % حقائق معنى الغيب عنه وفود % % 15(@)(@@) % كذا حيوان ثم إنسانه الذي % % إليه من الأشياء ثم سجود % % 16(@)(@@) % وما هي إلا الروح والجسم علمها % % بخالقها والنفس منه مدود % % 17(@)(@@) % ثلاث شؤون قدرتها صفاته % % له بالتجلي أقمص وبرود % % 18(@)(@@) % تنزه عنها وهو فيها مشبه % % ومنها له في النشأتين خلود % % 19(@)(@@) % قديم هو الحق المبين الذي له 
ms99	 % % بياض وليلات الحوادث سود % % 20(@)(@@) % وحاصل هذا كله هو أنه % % وجود وأشيا ما لهن وجود % % PageV01P488 البحر : - 1(@)(@@) % إن الجميع حدود في العقول وفي % % مراتب الحسن قد زادت على العدد % % 2(@)(@@) % يبدو بها من بدا فيها تحكمه % % ذات من الغيب تدعى حضرة الأحد % % 3(@)(@@) % بمقتضى ما لديها كان من صفة % % قديمة هي في التأثير بالرصد % % 4(@)(@@) % إياك والزهد في الأشياء إن تراها % % بنفسها هي قامت غبت عن رشد % % 5(@)(@@) % وإن تكن ترها قامت به ترها % % تجليات له في كل معتقد % % 6(@)(@@) % نعم تنزه عنها وهو في أزل % % من قبل إظهارها بالمنزه الصمد % % 7(@)(@@) % وهو المنزه أيضا في الظهور بها % % عن والد يقتضي منها وعن ولد % % 8(@)(@@) % لأنها عدم وهو الوجود لها % % وإن خلت عنه لم تبد ولم تعد % % 9(@)(@@) % ما الزهد عندي مقام إذ يدل على % % قطع العوالم لي عن صاحب المدد % % 10(@)(@@) % وكيف أزهد في الأشياء وهي به % % كانت وكان بها أيضا إلى الأبد % % PageV01P489 البحر : - 1(@)(@@) % نهر القضاء بما يختار خالقنا % % وما يريد هو الجاري إلى الأبد % % 2(@)(@@) % عليه طاحونة الأفلاك دائرة % % وقطبها القطب سر الواحد الأحد % % 3(@)(@@) % وما تولد فيما بين طابقها الأعلى % % وطابقها الأدنى على الرصد % % 4(@)(@@) % من الجماد وأنواع النبات وحيوان % % تراه وإنسان بلا عدد % % 5(@)(@@) % مثل الحبوب بدت للطحن مفرغة % % شيا فشيا بحكم النفس والجسد % % 6(@)(@@) % فكلما حبة قد جاء موعدها % % أصابها الطحن لم تبد ولم تعد % % 7(@)(@@) % حتى تصير كما كانت مفرقة إلا % % جزا وهي لهذا الأمر طوع يد % % 8(@)(@@) % عناصر كدقيق ميزته يد % % بمنخل الرتب المكسوبة الجدد % % 9(@)(@@) % حكم من الحاكم القهار في أزل % % بمقتضى ما قضى فيها من الأمد % % 10(@)(@@) % حتى يحول ذاك النهر عن جهة % % يجري إلى جهة أخرى بذي المدد % % PageV01P490 11(@)(@@) % فيفرغ الطحن والطاحون تخرب من % % هنا ويفسد مرأى هذه البلد % % 12(@)(@@) % ويظهر الأمر في دار الخلود بلا % % نهاية عند ذي غي وذي رشد % % 13(@)(@@) % هاك ينكشف السر الذي خفيت % % أنواره اليوم عن ذي الغفلة العد % % PageV01P491 البحر : - 1(@)(@@) % لنا طالع الغيب 
ms100	 المقدس يا سعد % % فلا نحس بل أوقاتنا كلها سعد % % 2(@)(@@) % وأفلاكنا دارت على حكم ربنا % % بما يقتضيه الحظ والعيشة الرغد % % 3(@)(@@) % هي الشمس من أبراج أكوانها بدت % % ولا برج في التحقيق إن هي لا تبدو % % 4(@)(@@) % تقاديرها من حكم أسمائها التي % % تجل عن الإحصا فما أن لها عد % % 5(@)(@@) % وجود حقيقي مضاف له الورى % % جميعا ولا قبل لشيء ولا بعد % % 6(@)(@@) % ولم ينقسم بل قام كل بأمره % % على حده إذ لا يقيده الحد % % 7(@)(@@) % وما الشأن عن شأن يشاغله فلا % % يخص التجلي منه غور ولا نجد % % 8(@)(@@) % وقولي وجود حسب ما هو عارف % % به كاشف عما يشير له الوجد % % 9(@)(@@) % به الكل موجود وما الكل غير ما % % يقدره في علمه ذلك الفرد % % 10(@)(@@) % فليس لموجود بدا مع وجوده % % وجود فحقق لا يضلنك الجحد % % PageV01P492 11(@)(@@) % وكن ظاهرا بالوهم فالكل هالك % % سوى وجهه أي ذاته إذ هو القصد % % 12(@)(@@) % وسالم وسلم للمنازع قوله % % فما قال من عنده حيث لا عند % % 13(@)(@@) % ولكنها الأسماء منه تقابلت % % فبعض له غي وبعض له رشد % % PageV01P493 البحر : - 1(@)(@@) % كلام أهل الله في % % دين الهدى نفع العباد % % 2(@)(@@) % حقائق لها إلى % % شريعة الحق استناد % % 3(@)(@@) % علم إشارة فلا % % لفظ ولا معنى يراد % % 4(@)(@@) % سر خفي خارج % % من الفؤاد لفؤاد % % 5(@)(@@) % وظاهر لذي اعتقاد باطن عن ذي انتقاد % . . . % 6(@)(@@) % فآمنوا به وسلموه % % يا أهل العناد % % 7(@)(@@) % فهو المجرد اللطيف % % عن كثائف المراد % % PageV01P494 البحر : - 1(@)(@@) % تحقق فإن الروح في الكل واحد % % ولا شي إلا الروح يدريه واجد % % 2(@)(@@) % وذلك من أمر الإله كما أتى % % وما الأمر إلا واحد وهو شاهد % % 3(@)(@@) % وذو الأمر وهو الله لا شك أنه % % هو الواحد المقصود والكل قاصد % % 4(@)(@@) % وقد صار ذاك الروح كل العقول والنفوس % % وأجسام الورى تتوارد % % 5(@)(@@) % فتظهر أغيارا له وهو عينها % % يحس به الذوق السليم المشاهد % % 6(@)(@@) % وذو الجهل بالمحسوس يحسب كثرة % % ويتبعه في الوهم عقل معاند % % 7(@)(@@) % ويلمح ذاك الروح كالبرق ظاهرا % % عن الأمر غيب الغيب ثم يعاود % % 8(@)(@@) % على 