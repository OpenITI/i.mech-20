ms461	 ح % % تى جاء ما فل عراكي % % 32(@)(@@) % وتسترت ورزء ال % % فاطميين انهتاكي % % 33(@)(@@) % خمد الجمر ووجدي % % بيني الزهراء ذاكي % % 34(@)(@@) % بأب في قبضة الف % % جار منهم كل زاكي % % 35(@)(@@) % ملصق بالأرض جسما % نفسه فوق السكاك % 36(@)(@@) % مفرد ترميه كف ال % % بغي عن قوس اشتراك % 37(@)(@@) % أظهرت فرقة بدر % فيه أضغان النواكي % % 38(@)(@@) % كل ذاكي الحقد أو يخ % % ضب أعراف المذاكي % % 39(@)(@@) % وغريب الدار يلفي % % موطن الطعن الدراك % 40(@)(@@) % طاهر يخطف بالأي % % دي الخبيثات السهاك % PageV01P1423 41(@)(@@) % يخرس الموت إذا س % % مته أفواه البواكي % % 42(@)(@@) % يا بنة الطاهر كم تق % % شر بالظلم عصاك % 43(@)(@@) % غضب الله لخطب % ليلة الطف عراك % 44(@)(@@) % ورعى النار غدا جس % % م رعى أمس حماك % 45(@)(@@) % شرع الغدر أخو غ % % ل عن الإرث زواك % 46(@)(@@) % يا قبورا بالغريي % ن إلى الطف سقاك % 47(@)(@@) % كل محلول عرى المر % % زم محلوب السماك % 48(@)(@@) % حامل من صلوات الله % ما يرضي ثراك % 49(@)(@@) % وإن استغنيت عن وك % % ف حيا غير حياك % 50(@)(@@) % إنه لو أجدب البح % % ر اجتدى فضل نداك % PageV01P1424 51(@)(@@) % أو أضل البدر في الأف % % ق سناه لاهتداك % 52(@)(@@) % يا هداة الله والنج % وة في يوم الهلاك % 53(@)(@@) % بكم استدللت في حي % % رة أمري وارتباكي % % 54(@)(@@) % أطلم الشك وكنتم % لي مصابيح المشاكي % % PageV01P1425 البحر : - 1(@)(@@) % حبست وأيام الملوك كذاكا % % تكون إسارا مرة وفكاكا % % 2(@)(@@) % ويحجب ظل الأرض غرة شمسها % % فتنزل خفضا تارة وسكاكا % % 3(@)(@@) % وليس يضر النجم مهوى غروبه % إذا عاد في أفق السماء سماكا % % 4(@)(@@) % وما قصروا من خطو سعيك للعلا % % وإن قصروا بالقيد رحب خطاكا % % 5(@)(@@) % ومن كانت الجوزاء بالأمس نعله % يكون له القيد الغداة شراكا % % 6(@)(@@) % ملكت زمانا جائرا فقسرته % على العدل إذ وليته فأباكا % % 7(@)(@@) % ومن جعجع الأقدار عن طرق كيده % عطفن عليه فاستثرن وشاكا % % 8(@)(@@) % حملت الذي أعيا الرجال وغيرهم % فخافوا على ضعف الرقاب قواكا % % 9(@)(@@) % ونفر ذؤبان الغضا ريح ضيغم % تطيح عليه نوشة وعراكا % % 10(@)(@@) % فدبوا فسدوا غابه وهو خادر % فضاق عليه نهضة وحراكا % % PageV01P1426 11(@)(@@) % وقد 
ms462	 غره أن يعمل الحزم سابقا % على الكيد أن ليس الذئاب هناكا % % 12(@)(@@) % مشى حافيا فوق القتادة حاقرا % لما شام منها أخمصيه وشاكا % % 13(@)(@@) % فإن فصدت أظفاره فلطالما % % أراح بها ردع الدماء وصاكا % % 14(@)(@@) % ولاحت به للوثب نفسا حمية % ترد الرقاب المصميات ركاكا % % 15(@)(@@) % فقل للعدا لا تمضغوها تحليا % وإن هي طابت ذوقة وملاكا % % 16(@)(@@) % ولا تلمسوا بعد التجارب حدها % % فإن بني عبد الرحيم أولاكا % % 17(@)(@@) % هم اليزنيات التي إن أغبكم % بها زاعر مني فكر دراكا % % 18(@)(@@) % فلا تستقلوا مغمدا من سيوفهم % وقد حز في أعناقكم فأحاكا % % 19(@)(@@) % ولا تحسبوا استهلاككم خزن مالهم % يجر على غير النفوس هلاكا % % 20(@)(@@) % فإن الجياد الطيبات عروقها % % تكون هزالا مرة وتماكا % % PageV01P1427 21(@)(@@) % ألا يا بشير الخير قلغير متق % متى نلت من رؤيا الوزير مناكا % % 22(@)(@@) % وأمكنك الحراس من بسط قولة % تبوح بها جهرا وتفتح فاكا % % 23(@)(@@) % توكل على من غمها في سفارها % % فكم كنت في أمثالها فكفاكا % % 24(@)(@@) % وإن هذا طمت على إخواتها % % فوكل بها الصبر الجميل أخاكا % % 25(@)(@@) % ولا تحسبن الشر ضربة لازب % وإن طال في هذا المطال مداكا % % 26(@)(@@) % فقد يخطئ الجلد المصيب بغدرة % وكم وألت من عثرة قدماكا % % 27(@)(@@) % ستخلص من أدناسها نازعا لها % % ولم يتعلق عارها برداكا % % 28(@)(@@) % كأنك بالإقبال قد هب ثائرا % فناشك فيها ثم ردك ذاكا % % 29(@)(@@) % وقد زادك التخمير عبقا وضوعة % ونشرا كأن الحبس كان مداكا % % 30(@)(@@) % وسلم سهم الانتقام مفوقا % إليك لترمي من بغى فرماكا % % PageV01P1428 31(@)(@@) % فود إذا لو شق عنه إهابه % وما شق بالغدر المصر عصاكا % % 32(@)(@@) % فعاذر ركن الدين في الحفظ أنه % جناه عليك ماعليه جناكا % % 33(@)(@@) % فما زال مع إلماعه لك بالأذى % % إذا أقرض الإنغام منك قضاكا % % 34(@)(@@) % يزيدك علما بالرجال وفطنة % ويكره قوما بغضة وفراكا % % 35(@)(@@) % ويعلم أن ما زلت في كل حالة % سنادا له في ملكه وملاكا % % 36(@)(@@) % وتمشي بكم وخدا وجمزا أموره % وتمشي بأقوام سواك سواكا % % 37(@)(@@) % فعطفا على المألوف من بر عهده % وإن هو في هذا المقام جفاكا % % 38(@)(@@) % وسمعا 
ms463	 وإن لم تستمع لعيافتي % % وزجري وإن لم تصغ لي أذناكا % % 39(@)(@@) % وحاشاك أن تخلو من اسمك مدحة % ويقفر من وفد الثناء ذراكا % % 40(@)(@@) % وأن لا أرى في الصدر وجهك طالعا % وعين القوافي والرجاء تراكا % % PageV01P1429 41(@)(@@) % وحاشاك من يوم جديد وموقف % أقوم إليه منشدا لسواكا % % PageV01P1430 البحر : - 1(@)(@@) % أزائرة كما زعم الخيال % أم الأحلام أصدقها المحال % 2(@)(@@) % أعلل عنك قلبا ضاق حتى % % غدا ما للمنى فيه مجال % 3(@)(@@) % إذا عادات هجرك آيستني % % رجوت وقلت يعقبها الوصال % 4(@)(@@) % أشمس الركب يوم أنرت فيه % % أليس الشمس كانت لا تنال % 5(@)(@@) % غريمك يوم وعدك ليس يقضى % % وعثرة يوم حبك لا تقال % 6(@)(@@) % هنيئا للعواذل منك قلب % يقلب كيفما شاؤا وقالوا % % 7(@)(@@) % أروك جفاى فاستشعرت حلا % وفيه دمى وغير دمى الحلال % 8(@)(@@) % وجسرك الجمال على التجني % % ألا يا قبح ما صنع الجمال % 9(@)(@@) % وإنى للصبور عل خليلي % % وإن أزرى بخلته الملال % 10(@)(@@) % وأرجع حين تختلف الليالي % % ويصبح ماء قوم وهو آل % PageV01P1431 11(@)(@@) % إلى وزر أحط به ثقالا % % من الآمال وهو لها مآل % 12(@)(@@) % رضينا والعداة لها غضاب % سجايا فيك أعطاك الكمال % 13(@)(@@) % سكوتك حين بعض النطق عي % وقولك حين فصل ما يقال % 14(@)(@@) % وأكسبك الغنى فغنيت منها % % أصول لا تعد ولا تطال % 15(@)(@@) % إذا اختلف الجدود فظلت يوما % تعدهم استوى عم وخال % 16(@)(@@) % من النجباء يرضى السلم منهم % % نفوسا ليس يأباها القتال % 17(@)(@@) % قلوب في سروجهم خفاف % صدور في مجالسهم ثقال % 18(@)(@@) % نموك فأشبه الضرغام شبل % وقايست اليد اليمنى الشمال % 19(@)(@@) % وكنت ابنا لوالده معينا % وبعضهم لوالده عيال % 20(@)(@@) % ولما لم تخب فيك الأماني % % رمى بك حيث لم تنب النصال % PageV01P1432 21(@)(@@) % وآنس منك يوم برقت غيثا % دموع سحابه أبدا سجال % 22(@)(@@) % شمائل طاب مغرسها فطابت % % كما هبت على الروض الشمال % 23(@)(@@) % أعرني عنده عمرت جاها % % تقدمه فبعض الجاه مال % 24(@)(@@) % وما أرضى لسانا دون قلب % وهل يكفي من السيف الصقال % 25(@)(@@) % ووف اليوم عن قوم أحالوا % % بسنته علينا واستحالوا % % 26(@)(@@) % حقوقا لم يضيعها كريم % ولم يكذب 
ms464	 لها في اليمن فال % 27(@)(@@) % وعش ما شئت يغنيك الثناء ال % % ذي يحيي ويفقرك السؤال % PageV01P1433 البحر : - 1(@)(@@) % ألأجل تيس لفظه وضراطه % % سيان في التحصيل عند العاقل % 2(@)(@@) % عبقت به لا للردوع روائح % % ترمي الأنوف بشر خبل خابل % 3(@)(@@) % أنشا يقول بنكهة كعجانه % تفتر عن لكن كلكنة باقل % 4(@)(@@) % فأجل قدرك أن يقال لتابع % أو خادم لك من محال باطل % 5(@)(@@) % أعرضت عني فاستجزت قطيعتي % % وفعلت بي فعل الملول الحائل % 6(@)(@@) % أأردت مني أن أعرض مهجتي % % وأنا أجم لكركدن جاهل % 7(@)(@@) % والعيش لدن والحياة حبيبة % والله يأمر باجتناب القاتل % 8(@)(@@) % أنصف أبا حسن ولا تك جائرا % واحكم بربك حكم قاض عادل % 9(@)(@@) % أو فاغتفر ذنبي ولست بمذنب % وتجاف عن فعلي ولست بفاعل % PageV01P1434 البحر : - 1(@)(@@) % يا ماشيا بالعتب يحمل مرة % في الناس بين مراسل ومراسل % 2(@)(@@) % أبلغ لديك أبا علي لومة % كالنصح تخبر جائرا عن عادل % 3(@)(@@) % لا تنكرن مني العتاب فلم تزل % قدما مثقف كل خل مائل % 4(@)(@@) % أتنام عن قول أرقت لوقعه % ألما وسهدا وهو خر مفاصلي % % 5(@)(@@) % وإذا قذفت فقد قتلت فكيف لي % % بالصفح عنك وقد غفرت لقاتلي % % 6(@)(@@) % تنبو وأنت غرار سيفي في يدي % % ويقصر ابنك وهو لهذم ذابلي % % 7(@)(@@) % وأراكما لا الحق أنت مدافع % عنه ولا هو دافع للباطل % 8(@)(@@) % أفتعرفان لموسر من نصرة % عذرا إذا أمسى بصورة خاذل % 9(@)(@@) % وعلام أرجو صاحبا لعظائم % % يوما إذا لم ينتدب لقلائل % 10(@)(@@) % ومن المحال ولم تذد عني يدي % ضبع نهوضك للهزبر الباسل % PageV01P1435 11(@)(@@) % وأرى فؤادي بعد غير مسالم % % إما جفوتكما وغير مساهل % 12(@)(@@) % ولقد عزمت تصبرا أسلاكما % % معه فأثقل حمل صبري كاهلي % % 13(@)(@@) % فرجعت ما أخذ انتصاري حظه % % مني ولا أخذ الجفاء بطائل % PageV01P1436 البحر : - 1(@)(@@) % لله ساع بلغته قدمه % حيث تعدت عاليات هممه % 2(@)(@@) % طوى السرى يبغي العلا حتى انطوى % % إخوته تحت الظلام أنجمه % 3(@)(@@) % حكم أخطار الفلا في نفسه % % يوغل أو تم له تحكمه % 4(@)(@@) % تحصه الأيام وهو طائر % يزاحم الحظ به تهجمه % 5(@)(@@) % وقاعد مع العفاف قانع 
ms465	 % ببلغة الزاد حشاه وفمه % 6(@)(@@) % لم تنتقص طلاوة في وجهه % % ورقة ذل السؤال يصمه % 7(@)(@@) % يألم كل قطرة سائلة % من مائه كأنما سال دمه % 8(@)(@@) % تلونت خلائق الدهر به % % فحنكته شهبه ودهمه % 9(@)(@@) % واختبر الناس فلو ساومته % % قرب أخيه خلته يحتشمه % 10(@)(@@) % إن كان لا يرزق إلا سائلا % % فرزقه المشكور مما يحرمه % PageV01P1437 11(@)(@@) % والله ما عفتك يا دنيا قلى % وإن فيك لمتاعا أعلمه % 12(@)(@@) % لكن أبناءك من لا صنعتي % % صنعته ولا وفائي شيمه % 13(@)(@@) % أخرج من مكمنه الصل وما % % فيهم بسحري من يصح سقمه % 14(@)(@@) % عندهم شكري وما أموالهم % عندي فهل عندك ذا من يقسمه % 15(@)(@@) % كم باسم لي من وراء شره % % والليث لا يغرني تبسمه % 16(@)(@@) % لو لم يق الله وحزم ثابت % ما نصلت عندي سدادا أسهمه % 17(@)(@@) % وواسع ملكا وصيتا واجد % ما شاء لم يسمع بشئ يعدمه % 18(@)(@@) % أمطر صيفيا فظن أنه % % قد عمت الأرض جميعا ديمه % 19(@)(@@) % أسهرني في المدح لا يلزمني % % عجبا به ونام عما يلزمه % 20(@)(@@) % ما ضاق في قبوله ورأيه % % في الجود لكن ضاق عني فهمه % PageV01P1438 21(@)(@@) % في وجهه بشر وفيه كرم % فبشره لي ولغيري كرمه % 22(@)(@@) % رحمت حظي أمس فيما فاتني % % من ماله واليوم منه أرحمه % 23(@)(@@) % وخاطب على اتحادي صحبتي % % والبدر مولود يعز توأمه % 24(@)(@@) % أرادني مستجلبا فؤاده % % وردني مستعليات قيمه % 25(@)(@@) % فكر فاستكثر لي ديناره % % محاسبا ولم يسعني درهمه % 26(@)(@@) % فإن يكن وصل فمني أو يكن % % حبل وفاق جذ فهو يصرمه % 27(@)(@@) % ليت الحسين الحاملي من بينهم % % على طريق واضح لي لقمه % 28(@)(@@) % تخلده الدنيا وتستبقيه لي % % وغيره تبقيه أو تخترمه % 29(@)(@@) % أو ليته يمنعني مخففا % % فإنها قد أثقلتني نعمه % 30(@)(@@) % سيب على سيب كما تقطعت % أوكية المزن وحلت عصمه % PageV01P1439 31(@)(@@) % كأن ما نغنم من أمواله % % حط يخاف فوته يغتنمه % 32(@)(@@) % أعيا على الوفر فبينا فضله % يبنيه إذ عن سؤال يهدمه % % 33(@)(@@) % كأنه أقسم لا نال الغنى % % فهو بما يعطى يحل قسمه % 34(@)(@@) % عاقدني الود فلا قارضة % تنشره ولا حسود يفصمه 
ms466	 % 35(@)(@@) % مجتهد البر ولو قاطعته % % في صلتي كأن ودي رحمه % 36(@)(@@) % ملكه السودد أصل فارع % فيها وأي بارع يتممه % 37(@)(@@) % يجمع بين كل ضدين له % % حتى تصافى سيفه وقلمه % 38(@)(@@) % ما خلبت من اصطفاك برقة % فيك ولا أخلفه توسمه % 39(@)(@@) % لما قضى قاضي القياس عنده % % من هائب الأمر ومن مقتحمه % 40(@)(@@) % ومن أخو الفخر إذا ما أشكلت % مذاهب الفخر وخيفت ظلمه % PageV01P1440 41(@)(@@) % شم الذليل الترب رغما ووقي % % أنف الحمي أن يضام شممه % 42(@)(@@) % ما للحسود فرصة يعيبها % % منك ولا ذنب عليك ينقمه % 43(@)(@@) % بلى خلال قد شجاه غيظها % % ينفثه طورا وطورا يكظمه % 44(@)(@@) % يكتمها والله يبدي فضلها % % كالشيب صاح باسمه من يكتمه % 45(@)(@@) % اسمع لها كما احتبت بنورها % % غناء يوشى بردها ويعلمه % 46(@)(@@) % در لها نوء السماك وخبا % % من وهج القيظ عليها مرزمه % 47(@)(@@) % تزاحمت مصطخبا نباتها % % بحيث هبهاب الرياح زمزمه % 48(@)(@@) % عرضك منها عبقا معرف % عرف اليلنجوج ذكيا فحمه % 49(@)(@@) % شاهدة لمفصح فاه بها % % أن الكلام الحر عبد يخدمه % 50(@)(@@) % إذا رآك الناس في وشاحها % % تحمله مقلدا أو تفغمه % PageV01P1441 51(@)(@@) % تعجبوا من شكلها في حمله % % وصفك منظوما ومنه أنظمه % 52(@)(@@) % كل كريم منطق شاعره % وأنت من فرط السماح تفحمه % PageV01P1442 البحر : - 1(@)(@@) % تراك ترى غدوا أو أصيلا % % يعود ولم يعد خطبا جليلا % % 2(@)(@@) % وهل تلقى مقيلا من هموم % % وجدن حشاك للبلوى مقيلا % % 3(@)(@@) % بلى هي تلك تأكلني سمينا % أصابتني فتمعن أو هزيلا % % 4(@)(@@) % نواهض بعد لم أنهض بعبء % وقد قربن آخر لي ثقيلا % % 5(@)(@@) % كموج البحر خطب إثر خطب % فليت الدهر روحني قليلا % % 6(@)(@@) % إلام أصاحب الأيام جلدا % وجسمي ليس يصحبني نحولا % % 7(@)(@@) % أعاركها ولي لا بد منها % % غدا قرن يغادرني قتيلا % % 8(@)(@@) % وما خطب أجبت نداء حزني % % له ودعوت يا دمعي نزولا % % 9(@)(@@) % كصبح حين صبح أمس عيني % % أراني كيف أغتبق العويلا % % 10(@)(@@) % ومفجوعين من أبناء سعد % % فروع علا يبكون الأصولا % % PageV01P1443 11(@)(@@) % رضوا بالصمت من حزن خشوعا % وقد وجدوا إلى القول السبيلا % % 12(@)(@@) % وما استغفرتم إلا لشخص % أعد ليومه 
ms467	 الذخر الجزيلا % % 13(@)(@@) % وحاكت أمكم للحشر ثوبا % عريضا من نزاهتها طويلا % % 14(@)(@@) % ستلبسه غدا ويطول عنها % % فتلحقكم شفاعتها الفضولا % % 15(@)(@@) % سقى يا قبر ساقيتي دموعي % % وما عطشا سألت لك السيولا % % 16(@)(@@) % محلتك المنسيتي شبابي % % ومنزلك المذكرني الرحيلا % % 17(@)(@@) % سحاب ينبت الحصباء خصبا % ويؤهل صوبه الربع المحيلا % % 18(@)(@@) % ولا برح النسيم ثراك حتى % % يجرر فوقه الروض الذيولا % % 19(@)(@@) % لقد أنطقت خرساء النواعي % % وعلمت المؤبن أن يقولا % % 20(@)(@@) % وقالوا ما يمسك من مصاب % عداك الأهل والأب والقبيلا % % PageV01P1444 21(@)(@@) % فقلت وهل جناني منه خال % إذا ما ناب تربا أو خليلا % % 22(@)(@@) % أبا الغارات إن الصبر حصن % من التسليم عيبك أن يميلا % % 23(@)(@@) % قبيح والفضائل عنك تروى % % يبصر مثلك الصبر الجميلا % % 24(@)(@@) % وما شمس النهار وأنت بدر % بمزعجة إذا عزمت أفولا % % 25(@)(@@) % أعرها كلما صعبت عزاء % يريك وعور مسلكها سهولا % % 26(@)(@@) % وصن بالصبر قلبك وهو سيف % قراع الهم يملؤه فلولا % % 27(@)(@@) % إذا رضى الحجور الموت قسما % % فمشكور بما ترك الفحولا % % PageV01P1445 البحر : - 1(@)(@@) % للنقص من أعمارنا ما يكمل % والدهر يؤيسنا ونحن يؤمل % 2(@)(@@) % تمشي المنون رويدها لتغرنا % % أبدا فتدركنا ونحن نهرول % 3(@)(@@) % يا معجبا بالعيش طال بقاؤه % % نظرا بقاؤك في المنية أطول % 4(@)(@@) % عن جانبي دنياك فارغب آبقا % % ودى الحريص وما نجا المتوكل % 5(@)(@@) % وإذا الجفون تخلصت من مجهل ال % % شبهات خلص نفسه من يعقل % 6(@)(@@) % من هالك درست عشية هلكه % % سبل الصلاح وكل نهج مشكل % 7(@)(@@) % من كان في الغفلات أعلم نفسه % أن المنية طالب لا يغفل % 8(@)(@@) % أبكيك للحسنات مت فطلقت % % وابن السبيل ثويت فهو مسبل % 9(@)(@@) % حملوك والبركات حولك والهدى % % ميت بموتك فوق نعشك يحمل % 10(@)(@@) % ونزلت حيث تقر عينك لا كما % % كانت عيون الحزن حولك تهمل % PageV01P1446 11(@)(@@) % يا قبره النضر المروض بعدما % % قد كان قبل القطر وهو الممحل % 12(@)(@@) % بلغه عن حزني السلام وقل له % % جلدي وإن أظهرته متعمل % 13(@)(@@) % أوحشت هذا المنزل البالي الربى % % فهل استفاد الأنس ذاك المنزل % 14(@)(@@) % هيهات صم فليس يوصل مفصح % قولا إليه ولا يبلغ مرسل 
ms468	 % 15(@)(@@) % قل لابنه والخير قولك لابنه % % من كان مسعودا فمثلك ينسل % 16(@)(@@) % لو رد بالجود المنية باذل % نجى أباك من الردى ما تبذل % 17(@)(@@) % أو كان طالبه يقاتل دونه % % ملأ البسيطة دونه من تقتل % 18(@)(@@) % أو كان داء يستطب شفيته % لكنه الداء العياء المعضل % 19(@)(@@) % دنيا تسر بما تضر بمثله % % فاسم لها شهد ومعنى حنظل % 20(@)(@@) % صبرا ومن عجب الرزايا أنه % % فيها يبصر كيف يصبر يذبل % PageV01P1447 21(@)(@@) % واعلم بأن أبا فداك بنفسه % % لتهون ميتته عليه وتسهل % 22(@)(@@) % فوزا له إذ كان قبلك يومه % كم موتة هي من حياة أفضل % % 23(@)(@@) % ولئن رمته يد المنون فسهمه % وقد اتقتك بما رمته المخصل % 24(@)(@@) % يسليك عنه أن ملأت فؤاده % % من كل فائدة تقال وتفعل % 25(@)(@@) % وأريته قدميك وهو بمعزل % متودع حيث السماك الأعزل % 26(@)(@@) % لا يظفرن الحزن منك بمهجة % لم تلق يوما ما له تتذلل % 27(@)(@@) % حاشاك يجمعنا بدارك مفزع % أبدا ويعقد للمساءة محفل % 28(@)(@@) % وورثت عمر الدهر سومك عيشة % في العز تسحب ما تشاء وترفل % 29(@)(@@) % فإذا سلمت عليه حيا مقبلا % فأبوك تحت الترب ميت مقبل % PageV01P1448 البحر : - 1(@)(@@) % إذا عارض نحو أرض عدل % وطاب الهواء له واعتدل % % 2(@)(@@) % ومر فجانب صوب الجنو % % ب منحدرا بالشمال اشتمل % 3(@)(@@) % إذا شام دار كرام جرت % عزاليه أو دار لؤم عزل % 4(@)(@@) % بفارس أم ودار الحسي % % ن أحبب بشيراز منها نزل % 5(@)(@@) % ومن جاور الغيث أنى أقا % % م يتبعه الغيث أنى رحل % 6(@)(@@) % فساهمه من عبرتي ما أطاق % وحمله من زفرتي ما حمل % 7(@)(@@) % وقل إن سئلت بشيراز من % قتيل اشتياق إلينا نقل % 8(@)(@@) % وواليكم لم يحله البعاد % وعاشقكم لم يرعه العذل % 9(@)(@@) % يؤمل كبت أعاديكم % وقد حقق الله ذاك الأمل % 10(@)(@@) % وخانك من كذبته الظنون % وكذب فيك الرقى والحيل % PageV01P1449 11(@)(@@) % رضى بالوشاية دون اللقاء % % وما تلك من عزمات البطل % 12(@)(@@) % إذا سرت منتصرا بالنهو % % ض كاتب معتذرا بالفشل % 13(@)(@@) % فكان لك السؤل لما نهضت % وكان له السوء لما نكل % 14(@)(@@) % هنتك وشائح علقتها % % يد الملك 
ms469	 عروتها ما تحل % 15(@)(@@) % وغناء من راية أسكنت % % ك ظلا لها ليس بالمنتقل % 16(@)(@@) % وبعد فسل بفؤادي وعن % % تلاعب شوقي به لا تسل % 17(@)(@@) % وظن بعيني لا ما يقر % إذا فاض دمعهما فانهمل % 18(@)(@@) % أمر بدارك مستسقيا % فأرجع وهي عداد العلل % 19(@)(@@) % أردد هل زمني راجع % بربعك قالت نعم بعد هل % % 20(@)(@@) % تمهل فغير بعيد تراه % % وكم عجل الحظ بعد المهل % PageV01P1450 21(@)(@@) % ويأمر فيك بما لا يرد % ليس كما خالف ابن الجمل % 22(@)(@@) % فقلت أقص عليه الحديث % لعلي أنصف قالت أجل % 23(@)(@@) % لك الخير شكوى ذليل السؤا % % ل لو كنت حاضره لم يذل % 24(@)(@@) % كرمت ابتداء كما قد علم % % ت كالغيث لم ينتظر أن يسل % 25(@)(@@) % فعارض أمرك بالإمتنا % % ع علج إذا خف رضوى ثقل % 26(@)(@@) % وقال ويكذب سيان ما % % أحيل علي وما لم يحل % 27(@)(@@) % وقد كنت كاتبته مرة % فأبرم ما بيننا وانفصل % 28(@)(@@) % فأحسب أن عبيد الصلي % % ب تذكر ما بيننا من ذحل % 29(@)(@@) % وما جنت الفرس أولى الزمان % على الروم فاقتصني بالأول % 30(@)(@@) % كأني أنا قلت في مريم % وحاش لها من تقي الحبل % PageV01P1451 31(@)(@@) % وشاركت في دم عيسى الي % % هود كما عنده أن عيسى قتل % 32(@)(@@) % وهدمت مذبح مرسرجس % وأطفأت قنديله المشتعل % 33(@)(@@) % وحرمت وحدي دون الأنا % % م من لحم خنزيره ما استحل % 34(@)(@@) % وكشفت عن ولد الجاثليق % % وما عرفوا جاثليقا نسل % 35(@)(@@) % ولم لا يغالطني في الحسا % % ب من عنده أن ربا نجل % 36(@)(@@) % وأن ثلاثته واحد % ويزعم من رد هذا جهل % % 37(@)(@@) % وعندي له الأسهم القاصدا % % ت بشر المقاول سود المقل % 38(@)(@@) % قواف تؤد فلو عدلت % على جنب والده ما حمل % 39(@)(@@) % فمرني فيه ودعه معي % % فوارحمتا من يدي للسفل % 40(@)(@@) % ومن أكل السحت كلب إذا % % سمحت بمالك عفوا بخل % PageV01P1452 41(@)(@@) % متى كان أمرك لولا الشقى % % يرد وحاشاك مما فعل % PageV01P1453 البحر : - 1(@)(@@) % لمن الطلول كأنهن رقوم % تضحى لعينك تارة وتغيم % 2(@)(@@) % يعهدن بالإقواء عهدا حادثا % % وكأنه مما بلين قديم % 3(@)(@@) % ما كنت أعرف أنهن نشيدتي 
ms470	 % % حتى تحدث بينهن نسيم % 4(@)(@@) % وكأنما عبق الترائب دلني % % أو ضل عن عرصاتهن لطيم % 5(@)(@@) % أسمعتني يا دار دون صحابتي % % والوحى عند أخي الهوى مفهوم % 6(@)(@@) % أين الموالك فيك أعناق المنى % % والراقيات العيش وهو سليم % 7(@)(@@) % والساريات لنا شموسا في الدجى % % والطالعات ضحى وهن نجوم % 8(@)(@@) % لا يقتضين وفي الديون عليهم % قلبي ولا يقضى لهن غريم % 9(@)(@@) % لم يبق فيك لناشد أوطاره % % إلا الوقوف عليك والتسليم % 10(@)(@@) % ومقيد ذو رمتين كأنه % % غب السواري معصم موشوم % PageV01P1454 11(@)(@@) % دسنا ترابك بالمناسم والهوى % % لو أنه بشفاهنا ملثوم % 12(@)(@@) % ومن الوفاء لساكنيك قيامنا % % وشكولهن من الظباء جثوم % 13(@)(@@) % ولقد وقفت فما رفدت بمسعد % وشكوت لو سمع الشكاة رحيم % 14(@)(@@) % والعين تسمح ثم تبخل حيرة % والركب يعذر تارة ويلوم % 15(@)(@@) % وكأنني فوق الرحالة خالع % لعبت بأم عظامه الخرطوم % 16(@)(@@) % لا الرهن يا لمياء مفكوك ولا % % حبل الوثيقة باللوى مصروم % 17(@)(@@) % ينسى كما تنسى المفاقر في الغنى % % خلف الجوانح سرك المكتوم % 18(@)(@@) % إن الذي عن بغضة زاورته % % لون الصدود بلمتي مأدوم % 19(@)(@@) % حكم يجور على سني وكيف بال % % عدوى عليه وأنت فيه خصيم % 20(@)(@@) % حملتني أوساقه ونفيتني % % فأنا الطريد وغاربي المهدوم % PageV01P1455 21(@)(@@) % ماذا يمسك من شباب راحل % عنى وبلبالي عليك مقيم % 22(@)(@@) % أو ما رأيت الشيب جانس لونه % % في العين در لثاتك المنظوم % 23(@)(@@) % وعلى المقلد والمعصب منك بالن % سبين أخوال له وعموم % 24(@)(@@) % أفتقنعين مع القرابة أنه % % يقصى وإقصاء الأقارب لوم % 25(@)(@@) % لولا تلافي الفجر خابطة السرى % % لقضى عليها الليل وهو بهيم % 26(@)(@@) % هيهات أعوز أن يجامل مبغض % بخديعة أو يحمد المذموم % 27(@)(@@) % ما عفنه حتى رأين ذبوله % % كيف انتجاع النبت وهو هشيم % 28(@)(@@) % يا برقة الفودين إني لم أزل % % للبرق من خلل الخطوب أشيم % 29(@)(@@) % ما كنت أول ما الزمان محملي % % أنا عوده ذو الجلبة المزموم % 30(@)(@@) % يجني وعندي حاقرا لا عاجزا % % فيما جناه الصبر والتسليم % PageV01P1456 31(@)(@@) % أوفض سهامك يا زمان فإنه % % ترمي الحنية والرمي سليم % 32(@)(@@) % نطني بكل غريبة محذورة % أرجع إليك وداؤها 
ms471	 محسوم % 33(@)(@@) % إلا سؤال الباخلين فإنه % % غمى علي سبيلها مغموم % 34(@)(@@) % ولقد كفاني في العفاف بصيرة % ذل الحريص ورزقه مقسوم % 35(@)(@@) % والناس إما واجد متعذر % أو مغرم بالجود وهو عديم % 36(@)(@@) % هذا يضن وذاك يقصر ماله % % فقد استوى المحظوظ والمحروم % 37(@)(@@) % أما ترى نقد العيون يردني % % والباب دوني مرتج مقروم % 38(@)(@@) % عريان من ورق النضارة سوقطت % % كنني وضاع ببردي التسهيم % 39(@)(@@) % ملقى تنابذني الأكف كأنني % % قعب تفاوت صدعه مرجوم % 40(@)(@@) % بين الغنى والفقر لا هو جاهل % حظي ولا هو في الحظوظ حكيم % PageV01P1457 41(@)(@@) % فوراء غمدي صارم ما ضره % % شعث النجاد وغربه المثلوم % 42(@)(@@) % خلس الردى قومي فأقعد نهضتي % % أن لا يقوم سواي حين أقوم % 43(@)(@@) % ما جهد من وجد السلاح ونفسه % % ملآى وناصر غيظه معدوم % 44(@)(@@) % وطئ الزمان بهم محاسن وجهه % % فجبينه بشجاجه مأموم % 45(@)(@@) % نسفوا بأيدي الحادثات كأنهم % % وبر تطارده الصبا مجلوم % 46(@)(@@) % أخرت عنهم للشقاوة بعدهم % % ونجا بهم من عيشي التقديم % 47(@)(@@) % قسما بها معهونة أعناقها % % وظهورها الموشي والمرقوم % 48(@)(@@) % قطرا تراقص في الحبال إمامها % % مرحا فيأخذ إخذه المأموم % 49(@)(@@) % مشي الخرائد ينبعثن مع الطلى % % حتى تعوق روادف وجسوم % 50(@)(@@) % يطرحن أشباحا بمكة كالقنا % % شعثا وهن مسنمات كوم % PageV01P1458 51(@)(@@) % عقدوا الحبى حيث الحلال محرم % % بمنى وحيث يحلل التحريم % 52(@)(@@) % لندى بني عبد الرحيم ومجدهم % % من جنة الدنيا رقى وتميم % 53(@)(@@) % المانعون فما يدعدع جارهم % % والحالبون وسرحهم مصروم % 54(@)(@@) % فيهم عن النظر المريب تخاوص % وعلى جهالات الزمان حلوم % 55(@)(@@) % وإذا السنون أحلن أخلاق الحيا % % أقلعن عنهم والكريم كريم % 56(@)(@@) % نصبوا على وضح الطريق مقاريا % % في الجدب يطعم ليلها وينيم % 57(@)(@@) % وتسلبوا للطارقين وأيقنوا % % في الحمد أن الغانم المغنوم % 58(@)(@@) % وإذا تزاحمت الخطوب وضاق عن % % نفس الجبان ونفسه الحيزوم % 59(@)(@@) % سلوا لهم آراءهم فتفرجت % ومن السيوف خواطر وعزيم % 60(@)(@@) % وإذا الحسين رأيت سؤدد نفسه % % وصف البعيد المدرك المعلوم % PageV01P1459 61(@)(@@) % بالصاحب ابتدأوا المكارم وانتهوا % % فالفخر مفتتح به مختوم % 62(@)(@@) % مد الفرات فما وفى بيمينه % % وسما فحلق والسحاب يحوم % 63(@)(@@) % ورأى مكان 
ms472	 نظيره لصديقه % % بالود وهو على الملوك زعيم % 64(@)(@@) % يا وافيا للملك والأخ غادر % ومصمما وحسامه مهزوم % 65(@)(@@) % ما ضره يتم وأنت له أب % حان وأم بالحفاظ رءوم % 66(@)(@@) % نامت عيون الكالئات تواكلا % عنه وعينك نومها تهويم % 67(@)(@@) % حتى أعدت الدرد من أنيابه % % والليث مفترس بها مضغوم % 68(@)(@@) % وأتاك معترفا بزلة رأيه % % من كان يزعم أنه معصوم % 69(@)(@@) % إن الذي فتل العداوة كفة % لك عاد قبل الصيد وهي رميم % 70(@)(@@) % ما زال ينشب في المطامع كفه % % حتى تحيف ظفره التقليم % PageV01P1460 71(@)(@@) % نطح الصفاة أجم يعلم إنها % % لترد ذا الروقين وهو حطيم % 72(@)(@@) % قطع الحبال وجاء يركب رأسه % % فهوى يود لو أنه مخطوم % 73(@)(@@) % يستولد الآمال شرا والمنى % % أم على طول السفاد عقيم % 74(@)(@@) % حبرات فحل راقصت ألحاظه % % وحلا بفيه شهدها المسموم % 75(@)(@@) % علق الحصار مدافعا عن يومه % % لو أن إملاء الحصار يدوم % 76(@)(@@) % يخشى الفرار ولا يقدم نفسه % % فيموت تحت السيف وهو كريم % 77(@)(@@) % فاختار أخرى ذل فيها أنفه % % لخشاشة يدمى بها الخيشوم % 78(@)(@@) % شر البلية في الحروب أسيرها % % يسلى القتيل ويعذر المهزوم % 79(@)(@@) % أسكنته دار الشقاء وإنها % % في جنب ما هو خائف لنعيم % 80(@)(@@) % عادات جدك في علاك وإنما % % رمح الكمي بحده مدعوم % PageV01P1461 81(@)(@@) % لهم اعوجاج الأمر إن طعنوا به % % ولكفك التثقيف والتقويم % 82(@)(@@) % وأرى الوزارة تسترق وإنما % % هي حرة وتباح وهي حريم % 83(@)(@@) % لعبت بها الهمم القصار وأصبحت % وسرورها عند الرجال هموم % 84(@)(@@) % في كل يوم نابت نبعت به % % عوجاء شائكة الغصون عذوم % 85(@)(@@) % لا ظل فوق الأرض يحمي قائلا % % فيها ولا تحت التراب أروم % 86(@)(@@) % خوارة يمضي شظايا طيحا % تحت النواجذ عودها المعجوم % 87(@)(@@) % تلقاه عارفة أسرة وجهه % % بالذل وهو بعزها موسوم % 88(@)(@@) % محصورة فيه السيادة نافر % من شكله التوقير والتعظيم % 89(@)(@@) % يرضى من العلياء باسم ما له % معنى وزعنفة الأديم أديم % 90(@)(@@) % يعطي الشفاه إذا أراد كرامة % كفا مقبلها بها ملطوم % PageV01P1462 91(@)(@@) % أفتغضبون وأنتم جيرانها % % لسوام مجد ما لهن مسيم % 92(@)(@@) % أم كل فضل في الزمان وأهله 
ms473	 % حتى الوزارة مهمل مظلوم % 93(@)(@@) % غرد فعندك يا حمامة طوقها % % وانظر ففيك لحاظها يا ريم % 94(@)(@@) % واسمح لها أن كنت عنها فاضلا % % كم ناقص وله بكم تتميم % 95(@)(@@) % واجلس لوفد المهرجان وكعبك ال % % عالي وأنف الدهر فيك رغيم % 96(@)(@@) % يأتيك قسرا خادما لك قائما % فيه ومجدك جالس مخدوم % 97(@)(@@) % متسربلا ثوب الخلود وشيعه % حلي القريض ودره المنظوم % 98(@)(@@) % تهب النفوس من النفائس غالبا % % أمر الليالي أمرك المرسوم % 99(@)(@@) % يا أسرتي مالي ألس خشاشتي % % يبسا وواديكم أغن جميم % 100(@)(@@) % أنف الإباء لوائلمن وائل % ففنوا وعزت بالوفاء تميم % PageV01P1463 101(@)(@@) % ولو اكتفى قيس بفتوى أمه % % لمضى عدي طائحا وخطيم % 102(@)(@@) % وأى أخا كسرى يبيتوقومه % % فيهم سيوف النصروهو مضيم % 103(@)(@@) % عهدي بكم زمنا وجرحي بينكم % % يوسى وصدع خصاصتي ملموم % 104(@)(@@) % فإذا خوى قصبي وساند فيكم % طلب الرفادة جنبي المهضوم % 105(@)(@@) % حمت الليوث عن الشبول وجرجرت % % دون البكار مصاعب وقروم % 106(@)(@@) % فعلام إذ طلتم وزدتم بسطة % أنا من رضاع سحابكم مفطوم % 107(@)(@@) % أبغى حياضكم فأضرب دونها % % ضرب الغرائب وهي حرى هيم % 108(@)(@@) % عتب المدل وتحته لودادكم % % صدر على خر الشفار سليم % PageV01P1464 البحر : - 1(@)(@@) % إذا لم يقرب منك إلا التذلل % وعز فؤاد فهو للبعد أحمل % 2(@)(@@) % سلوناك لما كنت أول غادر % وما راعنا في الحب أنك أول % 3(@)(@@) % إذا أحد الحبين كان ممرضا % % فأوفى الحبيبين الذي يتبدل % 4(@)(@@) % وقالت مشيب والجمال عدوه % فقلت خضبناه فأين التجمل % 5(@)(@@) % سوادان لكن مؤنس ومنفر % وما منهما إلا يحول فينصل % 6(@)(@@) % وساترتها سن الكمال بصبغة % رأتها فقالت صبغة الله أفضل % 7(@)(@@) % وبغض خدا بالمشيب معنبرا % إليها عذار بالشباب مغلل % 8(@)(@@) % وكان بعيني شعلة وهو مظلم % فصار بقلبي ظلمة وهو أشعل % 9(@)(@@) % سمحت ببذل العيش يا حار بعدكم % % وكنت بكتمان النصيحة أبخل % 10(@)(@@) % وبت أرى أن الجفاء سجية % لكل خليل والوفاء تعمل % PageV01P1465 11(@)(@@) % وحرم عز الموسوي جوانبي % % على الضيم حتى جازها ما يحلل % 12(@)(@@) % أحق بآمالي أخو كرم أرى % % بعين يقيني عنده ما أؤمل % 13(@)(@@) % ولما أتاح الدهر لي من لقائه 
ms474	 % % بشائر عجلى بالذي أتأجل % 14(@)(@@) % جلا لي وجها طالعا من أحبه % % ومد يمينا حقها ما تقبل % 15(@)(@@) % فقلت أمصباح أم الشمس أفتقت % % وهذي اليد البيضاء أم فاض جدول % 16(@)(@@) % وناشرني ودا شككت لطيبه % % أفغمة مسك أم رداء ممندل % 17(@)(@@) % أبا القاسم استمتع بها نبوية % تراجع عنها الناس فيما توغلوا % % 18(@)(@@) % محاسن إن سارت فقد سار كوكب % بذكرك أو طارت فقد طار أجدل % 19(@)(@@) % تحدث عنها الناطقون وأصبحت % بها العيس تحدى والسوابق تصهل % 20(@)(@@) % سما للعلا قوم سواك فلم تنل % سماؤك حتما إن باعك أطول % PageV01P1466 21(@)(@@) % وأغرى الكمال الحاسدين بأهله % % قديما ولكن داء شانيك أعضل % 22(@)(@@) % ألست من القوم استخفت سيوفهم % % رقاب عدا كانت على الموت تثقل % 23(@)(@@) % طلوبين لحاقين عصم يلملم % تزاور عن أرماحهم ثم تنزل % 24(@)(@@) % مشت فوق أنماط الملوك جيادهم % % وباتت بأعواد الأسرة تعقل % 25(@)(@@) % غلامكم في الحجفل ابن عجاجة % مغيمة من دجنها الدم يهطل % 26(@)(@@) % يعانق منه الموت عريان تحتها % % شجاع بغير الصبر لا يتنثل % 27(@)(@@) % وشيخكم في المحفل ابن مهابة % يوقر عزا بينكم ويبجل % 28(@)(@@) % غني ببادي رأيه عن تليه % صموت كمكفي قؤول فيفصل % 29(@)(@@) % وكهلكم في فتكه وانبساطه % % فتى وفتاكم في الحجا متكهل % 30(@)(@@) % وأنتم ولاة الدين أرباب حقه % مبينوه في آياته وهو مشكل % PageV01P1467 31(@)(@@) % مساقط وحى الله في حجراتكم % % وبينكم كان الكتاب ينزل % 32(@)(@@) % يذاد عن الحوض الشقي ببغضكم % % ويورد من أحببتموه فينهل % 33(@)(@@) % ختمتم على حر الخواطر أنه % % لكم ما انتهى فكر وأسمح مقول % 34(@)(@@) % تؤدى فروض الشعر ما قيل فيكم % وفي الناس إما جازكم يتنفل % 35(@)(@@) % نحمس من آثاركم وعلاكم % وننسب من أحلامكم ونغزل % 36(@)(@@) % لك الخير ظني في اعتلاقك عاذري % % فلا تتركن يا حر وعدك يعذل % 37(@)(@@) % لعمري وبعض الريث خير مغبة % ولكن حساب الناس لي فيك أعجل % 38(@)(@@) % تشبث بها أكرومة في إنها % % كتاب يوفى في يديك مسجل % 39(@)(@@) % وصبرا مضى شهر الصيام وغودرت % % مغانيه حتى الحول تعفو وتعطل % 40(@)(@@) % علمتك حزانا عليه وبعضهم % % بفرقته مستبشر متهلل % PageV01P1468 41(@)(@@) % تعففت فاليومان 
ms475	 عندك واحد % وأحظاهما ما كان بالدين يشغل % 42(@)(@@) % تناهت بك الأيام حتى قد اغتدى % % مهنيك عجزا عن مداهن ينكل % 43(@)(@@) % فوالله ما أدري هل الدهر عارف % بفضلك إلهاما أم الدهر يغفل % PageV01P1469 البحر : - 1(@)(@@) % أحقا يا أبا نصر فترجى % % وعودك أم تسوفني محالا % % 2(@)(@@) % ضربت لحاجتي أجلا قصيرا % عليك سما له عنقي وطالا % % 3(@)(@@) % تمادت مدة الشهر المسمى % % له حتى ظننت الحول حالا % % 4(@)(@@) % علقت الغرب أرقبه بعين % ترى نجما فتحسبه الهلالا % % 5(@)(@@) % إذا سهرت بكت لي من جمادى % % وإن رقدت رأت رجبا خيالا % % 6(@)(@@) % شربت الصبر أجنيه انتظارا % % ليوم يعقب الظفر الزلالا % % 7(@)(@@) % وقفت عليك من ظني مصونا % إذا استدنته مطمعة تعالى % % 8(@)(@@) % تذب يد الإباء المر عنه % % وترفعه القناعة أن ينالا % % 9(@)(@@) % وبعتك أرخص البيعات قلبا % به وعلى نفاسته يغالى % % 10(@)(@@) % رأتك مودتي كفئا فقرت % % وكانت ناشزا تعيي البعالا % % PageV01P1470 11(@)(@@) % فما طرف طريف من نبو % تجدد لا أطيق له احتمالا % % 12(@)(@@) % وتقصير يراه الود حظرا % % إذا ما العجب أبصره حلالا % % 13(@)(@@) % نفى عادات ذاك البر عني % % وبدل ماء ذاك البشر آلا % % 14(@)(@@) % تشكك حين تعرض فيه نفسي % % أإعراضا رأته أم اشتغالا % % 15(@)(@@) % وكم نفرت لتنشز عنك حتى % % نشطت من الوفاء لها عقالا % % 16(@)(@@) % وقلت لها أحس بفرط حبي % % له فازور جانبه دلالا % % 17(@)(@@) % أجلك أن أقول دنا فلما ان % % حططت له بحاجتي استطالا % % 18(@)(@@) % حلفت موافقا نظري وقلبي % % هوى فيما يعادي أو يوالى % % 19(@)(@@) % أطالع صاحبا فأرى بظني % % خلال تجاربي منه الخلالا % % 20(@)(@@) % فأخبره فلا أرضاه قولا % لأخبره فأرضاه فعالا % % PageV01P1471 21(@)(@@) % أحب المرء إن لم تسق ريا % يداه تعدرا رشحت بلالا % % 22(@)(@@) % فإن هو ضاق أن يعطى صلاء % بجذوة ناره وسع الذبالا % % 23(@)(@@) % وأكره كل معتذر المساعي % % إلى التقصير نال فما أنالا % % 24(@)(@@) % إذا أنشأت سحائبه بوعد % أهب قنوطه ريحا شمالا % % 25(@)(@@) % أعيذك جل من تلقى وجوه % توامق فوق أفئدة تقالى % % 26(@)(@@) % تسالم ألسن زعمته زورا % % عيون تشازر تصف القتالا % % 27(@)(@@) % وليس أخاك إلا من تحط ال % % أمور به 
ms476	 فيحملها ثقالا % % 28(@)(@@) % وما للسيف إلا القطع معنى % وإن هو راق حليا أو صقالا % % 29(@)(@@) % إذا استسعدت في خطب جليل % ينوب وفاتك الإسعاد حالا % % 30(@)(@@) % فلم يكن الصديق سوى المواسي % % فراخاها إذا ما بنت مالا % % PageV01P1472 البحر : - 1(@)(@@) % في الظباء الغادين أمس غزال % قال عنه ما لا يقول الخيال % 2(@)(@@) % طارق يزعم الفراق عتابا % % ويرينا أن الملال دلال % 3(@)(@@) % لم يزل يخدع البصيرة حتى % % سرنا ما يقول وهو محال % 4(@)(@@) % لا عدمت الأحلام كم نولتني % % من منيع صعب عليه النوال % 5(@)(@@) % لم تنغص وعدا بمطل ولم يو % % جب له منة علي الوصال % 6(@)(@@) % فلليلي الطويل شكري ودين ال % % عشق أن تكره الليالي الطوال % 7(@)(@@) % لمن الظعن غاصبتنا جمالا % % حبذا ما مشت به الأجمال % 8(@)(@@) % كانفات بيضاء دل عليها % % أنها الشمس أنها لا تنال % 9(@)(@@) % جمح الشوق بالخليع فأهلا % بحليم له السلو عقال % 10(@)(@@) % كنت منه أيام مرتع لذاتي % % تخصيب وماء عيشي زلال % PageV01P1473 11(@)(@@) % حيث ضلعي مع الشباب وسمعي % % غرض لا تصيبه العذال % 12(@)(@@) % يا نديمي كنتما فافترقنا % % فاسلواني لكل شيء زوال % 13(@)(@@) % لي في الشيب صارف ومن الحزن % % على آل أحمد إشغال % 14(@)(@@) % معشر الرشد والهدى حكم البغ % % ي عليهم سفاهة والضلال % 15(@)(@@) % ودعاة الله استجابت رجال % لهم ثم بدلوا فاستحالوا % % 16(@)(@@) % حمولها يوم السقيفة أوزا % % را تخف الجبال وهي ثقال % 17(@)(@@) % ثم جاءوا من بعدها يستقيلو % % ن وهيهات عثرة لا تقال % 18(@)(@@) % يا لها سوءة إذا أحمد قا % % م غدا بينهم فقال وقالوا % % 19(@)(@@) % ربع همي عليهم طلل با % % ق وتبلى الهموم والأطلال % 20(@)(@@) % يا لقوم إذ يقتلون عليا % % وهو للمحل فيهم قتال % PageV01P1474 21(@)(@@) % ويسرون بغضه وهو لا ت ق % % بل إلا بحبه الأعمال % 22(@)(@@) % وتحال الأخمار والله يدري % % كيف كانت يوم الغدير تحال % 23(@)(@@) % ولسبطين تابعيه فمسمو % % م عليه ثرى البقيع يهال % 24(@)(@@) % درسوا قبره ليخفى عن الز % % وار هيهات كيف يخفى الهلال % 25(@)(@@) % وشهيد بالطف أبكى السموا % % ت وكادت له تزول الجبال % 26(@)(@@) % يا غليلي له وقد حرم 
ms477	 الما % % ء عليه وهو الشراب الحلال % 27(@)(@@) % قطعت وصلة النبي بأن تق % % طع من آل بيته الأوصال % 28(@)(@@) % لم تنج الكهول سن ولا الش % % بان زهد ولا نجا الأطفال % 29(@)(@@) % لهف نفسي يا آل طه عليكم % % لهفة كسبتها جوى وخبال % 30(@)(@@) % وقليل لكم ضلوعي تهت % % ز مع الوجد أو دموعي تذال % PageV01P1475 31(@)(@@) % كان هذا كذا وودي لكم حس % % ب ومالي في الدين بعد اتصال % 32(@)(@@) % وطروسي سود فكيف بي الآ % % ن ومنكم بياضها والصقال % 33(@)(@@) % حبكم كان فك أسري من الشر % % ك وفي منكبي له أغلال % 34(@)(@@) % كم تزملت بالمذلة حتى % % قمت في ثوب عزكم أختال % 35(@)(@@) % بركات لكم محت من فؤادي % % ما أمل الضلال عم وخال % 36(@)(@@) % ولقد كنت عالما أن إقبا % % لي بمدحي عليكم إقبال % 37(@)(@@) % لكم من ثناي ما ساعد العم % % ر فمنه الإبطاء والإعجال % 38(@)(@@) % وعليكم في الحشر رجحان ميزا % % ني بخير لو يحصر المثقال % 39(@)(@@) % ويقيني أن سوف تصدق آما % % لي بكم يوم تكذب الآمال % PageV01P1476 البحر : - 1(@)(@@) % أيقظني للبرق وهو نائم % جهالة والعربي حازم % 2(@)(@@) % لو هاج من دائك ما هيج لي % % علمت أني للبروق شائم % 3(@)(@@) % حدثني عن الغضا وأهله % فانكشف الستر ونم الكاتم % 4(@)(@@) % للبارقات مطر وهذه % % مزنتها دموعي السواجم % 5(@)(@@) % في كل ذات صبوة من عبرتي % % ما يشكر الراعي ويرضى السائم % 6(@)(@@) % رعاية وإنه من شيمتي % % عهد حصين وحفاظ دائم % 7(@)(@@) % سلا المحبون وعندي زفرة % عسراء لا تنقضها العزائم % 8(@)(@@) % كم خطر دونك يا ذات اللمى % % خيضت له الفجاج والمخارم % 9(@)(@@) % وقفة ترمقني مرتابة % فيها ظبا قومك واللهاذم % 10(@)(@@) % أساند الدوح فتمتار الجوى % % من نزوات صدري الحمائم % PageV01P1477 11(@)(@@) % وباللوى من نظرة ضائعة % لم تغرميها والزعيم غارم % 12(@)(@@) % إن الظباء بالغضا ضياغم % والأجم الكناس والصرائم % 13(@)(@@) % أصد عن سلع بقلب كلما % % أطير خوفا عاد وهو حائم % 14(@)(@@) % كما يطيع اليأس ثم يلتوي % % طماعة مع الشميم الرائم % 15(@)(@@) % كم أنفق العمر على رعي المنى % % وهي خبيثات الثرى هشائم % 16(@)(@@) % وحاجتي إلى الزمان صاحب % مساعد 
ms478	 وقدر مسالم % 17(@)(@@) % أكل من كاشرني بوجهه % بشرا فوجه قلبه مجاهم % 18(@)(@@) % ما أغضب الناس علي هل سوى % % أني بدنياهم خبير عالم % 19(@)(@@) % عندي الغنى عنها على خصاصة % وعندهم حظوظها الجسائم % 20(@)(@@) % والفضل والعفة عنهم قسمة % % أعطيتها كما أراد القاسم % PageV01P1478 21(@)(@@) % وليس كل شفة مبلولة % وإن سخت بمائها الغمائم % 22(@)(@@) % لله في طرق المعالي فتية % رفيقهم على الزمان حاكم % 23(@)(@@) % تعرفوا ريح الهجير فغدت % نسيم أنفاسهم السمائم % 24(@)(@@) % يضيق رحب الأرض في ازدحامهم % % فأرضهم تحت السرى العزائم % 25(@)(@@) % صوح كل نابت في عامهم % % حتى الجمام السود واللهازم % 26(@)(@@) % تحملهم منتقيات سوقها % % تحل منها للربى المحارم % 27(@)(@@) % تزقو بأصوات الحصا أخفافها % % كما تحص الوبر الجوالم % 28(@)(@@) % كأنما الأرض لها مهارق % يملي السرى وتكتب المناسم % 29(@)(@@) % مثل السهام فوقها بصائر % مبيضة وأوجه سواهم % 30(@)(@@) % إذا استغاثت تحتها تعريسة % % تقاصرت ليلاتها التمائم % PageV01P1479 31(@)(@@) % كأنما الليل سواد لمة % سل من الصبح عليه صارم % 32(@)(@@) % قل للذي يحصب ظهري ريبة % زد سفها إني امرؤ محالم % 33(@)(@@) % لا تطمس الشمس يد مدت ولا % % يغمز في الصعدة ناب عاجم % 34(@)(@@) % قد كان أبدى لك دهري صفحتي % % شيئا وبانت منى المراجم % 35(@)(@@) % فمن لك اليوم ونصري حاضر % وحظي الغائب عني قادم % 36(@)(@@) % والقمر الآفل قد أعيد لي % % بدرا وأنف الظلمات راغم % 37(@)(@@) % رد الندى إلى الثرى ورجعت % فملأت غمودها الصوارم % 38(@)(@@) % لكل شاك غدرة من دهره % % عند بني عبد الرحيمراحم % 39(@)(@@) % الأنجم الزهر فمنها ثاقب % مستسلف النور ومنها ناجم % 40(@)(@@) % والعترة البيضاء لم يعلق بها % % من دنس الهجنة عرق واصم % PageV01P1480 41(@)(@@) % استبقوا الجود فكل دافع % عن ضيفه أخاه أو مزاحم % 42(@)(@@) % وانتصف الفضل بهم مذ جعلت % % منه إلى حكمهم المظالم % 43(@)(@@) % قل لأبي سعد على ما جره ال % % شوق علي والفراق الغاشم % 44(@)(@@) % قد كنت أرضى أمس من أمنيتي % % بأن يقال عاد وهو سالم % 45(@)(@@) % فاليوم يا طيرة قلبي فرحا % بأن يقال سالم وغانم % 46(@)(@@) % قد قلدوا منه زمام أمرهم % % أغلب لا تخضعه العظائم % 47(@)(@@) % إن الكفاة لم 
ms479	 يكن عميدهم % % في دائهم إلا الطبيب الحاسم % 48(@)(@@) % ألقاب قوم نافرات شمس % تنبو وألقابكم مياسم % 49(@)(@@) % وما رأت عين العلا لنفسها % % فيما يسدي المجد أو يلاحم % 50(@)(@@) % كخلع رحت بها مكتسيا % % عزا وتكسى اللبد الضراغم % PageV01P1481 51(@)(@@) % خاطوا السحاب حلة فضمنت % جسمك فلتفخر بمن تجاسم % 52(@)(@@) % بيضاء أو صبيغة وشى لها % % زهر النجوم راقش وراقم % 53(@)(@@) % ظاهرة الفخر ومن باطنها % % أخرى وخير المنح التوائم % 54(@)(@@) % وتوجوك عمة وإنما % % تيجان أمثالكم العمائم % 55(@)(@@) % وختموا ملساء لم يخدش بها % % سن على إثر العطايا نادم % 56(@)(@@) % وسائل الغرة واف ردفه % أدب أن يشفق منه الحازم % 57(@)(@@) % أحوى إذا قام إليه ماسح % قام إلى وجه الوجيه لاطم % 58(@)(@@) % بنية لا يدري صفاتها % % يوم الرهان من لغوب هادم % 59(@)(@@) % منطلق بأربع قوائم % كأنهن خفة قوادم % 60(@)(@@) % مع الرياح لم يكن من قبلها % % تهزأ بالأجنحة القوائم % PageV01P1482 61(@)(@@) % يمرح في مقوده ذئب الغضا % % وتوعد الوحش به القشاعم % 62(@)(@@) % ويتقى ما تتقى برسغه % وهي على بطونها الأراقم % 63(@)(@@) % أركبته بدرا وقد حطت لك ال % % جوزاء فهي العذر والشكائم % 64(@)(@@) % نظائم من النضار عقنه % بهرا بما أثقلهن الناظم % 65(@)(@@) % ورحبة الصدر على ضيق به % % مفصحة وقومها أعاجم % 66(@)(@@) % لمياء تعطيك فما أشدق لا % % يغبه الدهر لسان لائم % 67(@)(@@) % يحمد منه ما تذم أبدا % % بمثله الشفاه والمباسم % 68(@)(@@) % تزهى بصفر من بني الروم لها % % آباؤها الأحابش الأداهم % 69(@)(@@) % لها من الشمس وشاح تحته % % جيد أغم والبنان فاحم % 70(@)(@@) % افتضها الحلى ففي أحشائها % % أجنة لم تحوهم مشائم % PageV01P1483 71(@)(@@) % ليس لهم ما بقيت وما بقوا % % عما أدرت من رضاع فاطم % 72(@)(@@) % تمضي حدود القتل والطقع يد % فيهم وليست لهم جرائم % 73(@)(@@) % لا ينطقون لغة وكلهم % % بين الأنام رسل تراجم % 74(@)(@@) % إمرتها دستك تستخدمها % % يد لها صرف الزمان خادم % 75(@)(@@) % دؤيكم جفون أسيافكم % وكتبكم لملككم دعائم % 76(@)(@@) % وكنتم متى عصت قبيلة % وأخذت بالكظم الخصائم % 77(@)(@@) % أطرتم منها إلى أعدائكم % % أجدادلا أو كارها الجماجم % 78(@)(@@) % قم بمساعيك فنل أمثالها % % إن المساعي للعلا سلالم % 79(@)(@@) % يفديك 
ms480	 مشمول بظل غيره % % يسعى سواه وهو كاس طاعم % 80(@)(@@) % نام على هذي الصفاة غفلة % وأنت من نبذ الحصة قائم % PageV01P1484 81(@)(@@) % عاقد في حب الهوينا عجزه % % أن لا يبالي مايقول اللائم % 82(@)(@@) % إذا نضا سرباله كلمه % من حسد في كل عضو كالم % 83(@)(@@) % بكم بنى عبد الرحيميامنت % % إلى المنى وطيرها أشائم % 84(@)(@@) % زوجت آمالي من أيمانكم % % فولدت بطونها العقائم % 85(@)(@@) % بعا رجائي بكم موسع % وغصن عيشي في ذراكم ناعم % 86(@)(@@) % أسمن قوم ملأت عرينهم % % مثل الحصون الإبل السوائم % 87(@)(@@) % وعندكم جذيم مال أبدا % % تعرفه الحقوق والمغارم % 88(@)(@@) % تلتزمون كرما ما تدعي % % فيه العدا ويستحل الظالم % 89(@)(@@) % إنكم من معشر عندهم % % فيما استفاد ربهم مساهم % 90(@)(@@) % وقد لبستم فاخلعوا إن الندى ال % % عادل أن تقسم المغانم % PageV01P1485 91(@)(@@) % بنتم بها فبينواواصفها % % بمثلها فهكذا المكارم % 92(@)(@@) % خصوا بها تكرمة من لم يزل % % تهدى لكم بناته الكرائم % 93(@)(@@) % معربة بمدحكم فيها رضى % % قوم وفي قوم لها سخائم % 94(@)(@@) % متى تكن سلول أو باهلة % % آباء شعر فأبوها دارم % 95(@)(@@) % سوائر مع النجوم ترتمي % % بها نجود الأرض والتهائم % 96(@)(@@) % تود أكباد العدا إن صغتها % % أسورة لو أنها معاصم % 97(@)(@@) % تدويهم غيظا وتشفيهم بما % % تفصح فهي المس والتمائم % 98(@)(@@) % يحبى بها يقظان منكم حاضر % وغائب عن البلاد حالم % 99(@)(@@) % ضاجعكم طيفي بها فأولت % صادقة وقد يغر النائم % 100(@)(@@) % يشهد لي مفتاحها وختمها % % بأنني للشعراء خاتم % PageV01P1486 البحر : - 1(@)(@@) % اليوم أنجز ماطل الآمال % فأتتك طائعة من الإقبال % 2(@)(@@) % بمنى وفين له وهن غوادر % ولقحن قربك بعد طول حيال % 3(@)(@@) % قطع المنى يستام ذاك بنفسه % % مسترخصا والدهر فيه يغالي % % 4(@)(@@) % فأتى يدوس الهول نحوك شوقه % % والشوق مشاء على الأهوال % 5(@)(@@) % يلقى الخطوب بمثلها من همة % % قطعت جبالا في ابتغاء جبال % 6(@)(@@) % في ظل وحدته وإن رفاقه % % كثر ولكن قلة الأشكال % 7(@)(@@) % فردا فليس يرد صوب صوبه % % إلا مصدقه اختيار الغالي % % 8(@)(@@) % ملء الإهاب عليمة بطلابها % % خفت ليوم تحمل الأثقال % 9(@)(@@) % سيارة فكأنها طيارة % بشمال فارسها عنان شمال % 10(@)(@@) % تجتاب أربعها الوهاد 