ms1162	 فضائل قزوين والرافعي عن كعب بن عجرة رضي الله عنه .(@)(@@) PageV04P064(@)(@@)(@@)(@@) $ ( 10199 ) قال النبي :(@)(@@) | 30 ( تجيء فقراء المسلمين يوم القيامة على كورهم فيقال لهم : قفوا للحساب ، فيقولون : ما أعطيتمونا شيئا فتحاسبونا عليه ، فيدخلون الجنة قبل الناس بأربعين سنة ) )(@)(@@) ( ع طب هق ) عن سعيد بن عامر بن حذيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10200 ) قال النبي :(@)(@@) | 30 ( تجيء فقراء المسلمين يزفون كما تزف الحمام ويقال لهم : قفوا للحساب ، فيقولون : والله ما أعطيتمونا شيئا تحاسبوننا به ، فيقول الله : صدق عبادي فيدخلون الجنة قبل الناس بسبعين عاما ) )(@)(@@) الحسن بن سفيان والبغوي عن سعيد بن عامر بن حذيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10201 ) قال النبي :(@)(@@) | 30 ( تجيء الطير يوم القيامة تحت العرش ترفع مناقيرها وتضرب بأذنابها وتطرح ما في بطونها وليست عليها مظلمة فاتقة ) )(@)(@@) ( عق عد طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10202 ) قال النبي :(@)(@@) | 30 ( تجتمع ملائكة الليل والنهار عند صلاة الفجر وصلاة العصر ، فإذا خرجت ملائكة النهار قال الله عز وجل لهم : من أين جئتم ؟ فيقولون : جئناك من عند عبادك ، أتيناهم وهم يصلون ، وجئناك وهم يصلون ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10203 ) قال النبي :(@)(@@) | 30 ( تجد ذالك عند ربك أحوج ما تكون إليه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما قال : سأل رجل النبي عن رمي الجمار ما له فيه قال : فذكره .(@)(@@)(@@)(@@) $ ( 10204 ) قال النبي :(@)(@@) | 30 ( تجيء الرحم يوم القيامة لها حجنة كحجنة الغزل فتكلم بلسان ذلق طلق فتصل من وصلها ، وتقطع من قطعها ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10205 ) قال النبي :(@)(@@) | 30 ( تجيء الريح التي يقبض الله فيها نفس كل مؤمن ، PageV04P065 ثم طلوع الشمس من مغربها وهي الآية التي ذكر الله في كتابه ) )(@)(@@) ( طب ) عن أبي شريح حسن .(@)(@@)(@@)(@@) $ ( 10206 ) قال النبي :(@)(@@) | 30 ( يجيئون يوم القيامة وعلى أفواههم الفدام ، فأول ما يتكلم من الإنسان فخذه وكفه ) )(@)(@@) ( طب ك ) عن حكيم بن معاوية عن أبيه .(@)(@@)(@@)(@@) ||| ( التاء مع الحاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10207 ) قال النبي :(@)(@@) | 30 ( تحاجت النار والجنة فقالت النار : أوثرت 
ms1163	 بالمتكبرين والمتجبرين ، وقالت الجنة : فما لي لا يدخلني إلا ضعفاء الناس وسقطهم وعجزهم ، فقال الله عز وجل للجنة : إنما أنت رحمتي أرحم بك من أشاء من عبادي ، وقال للنار : إنما أنت عذابي أعذب بك من أشاء من عبادي ، ولكل واحدة منكما ملؤها ، فأما النار فلا تمتليء حتى يضع الله قدمه عليها فتقول قط قط فهنالك تمتليء وينزوي بعضها إلى بعض فلا يظلم الله من خلقه أحدا ، وأما الجنة فإن الله ينشيء لها خلقا ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10208 ) قال النبي :(@)(@@) | 30 ( تحروا الدعاء عند فيء الأفياء ) )(@)(@@) ( حل ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10209 ) قال النبي :(@)(@@) | 30 ( تحروا الصدق وإن رأيتم أن فيه الهلكة فإن فيه النجاة ) )(@)(@@) ( ابن أبي الدنيا في الصمت ) عن منصور بن المعتمر مرسلا .(@)(@@)(@@)(@@) $ ( 10210 ) قال النبي :(@)(@@) | 30 ( تحروا الصدق وإن رأيتم أن فيه الهلكة فإن فيه PageV04P066 النجاة ، واجتنبوا الكذب وإن رأيتم أن فيه النجاة فإن فيه الهلكة ) )(@)(@@) ( هناد ) عن مجمع بن يحيى مرسلا .(@)(@@)(@@)(@@) $ ( 10211 ) قال النبي :(@)(@@) | 30 ( تحروا ليلة القدر ، فمن كان متحريها فليتحرها في ليلة سبع وعشرين ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10212 ) قال النبي :(@)(@@) | 30 ( تحروا ليلة القدر في السبع الأواخر ) )(@)(@@) ( مالك م د ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10213 ) قال النبي :(@)(@@) | 30 ( تحروا ليلة القدر في الوتر من العشر الأواخر من رمضان ) )(@)(@@) ( حم ق ت ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10214 ) قال النبي :(@)(@@) | 30 ( تحروا ليلة القدر ليلة ثلاث وعشرين ) )(@)(@@) ( طب ) عن عبد الله بن أنيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10215 ) قال النبي :(@)(@@) | 30 ( تحرم الصلاة إذا انتصف النهار كل يوم إلا يوم الجمعة ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10216 ) قال النبي :(@)(@@) | 30 ( تحريك الإصبع في الصلاة مذعرة للشيطان ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10217 ) قال النبي :(@)(@@) | 30 ( تحشرون حفاة عراة غرلا ) )(@)(@@) ( خ ) عن عائشة ( ت ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@