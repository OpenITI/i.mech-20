ms501	 % % 44(@)(@@) % بينا الطيور في مداها سائره % % اذا هم من عينه بالساهره % % 45(@)(@@) % كالليث يسطو كفه بأرقم % % والبدر يرمي في الدجى بأنجم % % 46(@)(@@) % و أقبلت مواكب الطيور % % على طروس الجو كالسطور % % 47(@)(@@) % فحبذا السطورفي المهارق % % منقوطة الاحرف بالبنادق % % 48(@)(@@) % من كل تم حق أن يسمي % % ضياءه المشرق بدر التم % % 49(@)(@@) % تخاله من تحت عنق قد سجا % % طرة صبح تحت أذيال الدجى % % 50(@)(@@) % و كل حي حسن الوسامه % % كأنه في أفقه غمامه % % PageV01P2378 51(@)(@@) % تتبعه أوزة دكناء % % من دونها لفلفة غراء % % 52(@)(@@) % تقدمها أنيسة ملونه % % تابعة من كل وصف أحسنه % % 53(@)(@@) % يجني بها الآكل خير ما جنى % % وأحسن المأكول ما تلونا % % 54(@)(@@) % و ربما مر لديها حبرج % % كأنه على نضار يدرج % % 55(@)(@@) % و انقض من بعض الجبال النسر % % له بأبراج النجوم وكر % 56(@)(@@) % مغبر الخلق شديد الأيدي % % يبني على الكسر حروف الصيد % % 57(@)(@@) % و كل كركي عجيب السير % % كأنه طيف خيال الطير % % 58(@)(@@) % ما بين أحشاء الظلام يسري % % من أرض بغداد لأرض مصر % % 59(@)(@@) % يحث مسراه عقاب كاسبه % % خافضة لحظ الطيور ناصبه % % 60(@)(@@) % إذا مضت جملتها المعترضه % % تواصلت خيوطها المنقرضه % % PageV01P2379 61(@)(@@) % و أبيض الغيم يسمى مرزما % % كم بات مثل نوئه منسجما % % 62(@)(@@) % يحث غرنوقا شهي المجتلى % % مقدما على الغرانيق العلى % % 63(@)(@@) % و كل صوع مبهت المفاجي % % كالبرق يخطو فوق ليل داجي % % 64(@)(@@) % و أبيض مثل الغمام يسجم % % وكيف لا يسجم وهو مرزم % 65(@)(@@) % يحفه شبيطر قوي % في ملة الأطيار موسوي % 66(@)(@@) % هذا وكم ذي نظر ممتاز % % ينعت في الواجب بالعناز % % 67(@)(@@) % اسوده ذو غرة في الصدر % % كأنه نور الهدى في الكفر % 68(@)(@@) % فلم تزل قسينا الضواري % % تصيبها بأعين النظار % % 69(@)(@@) % حتى غدت دامية النحور % % ساقطة منها على الخبير % % 70(@)(@@) % كأنها وهي لدينا وقع % % لدى محاريب القسي ركع % PageV01P2380 71(@)(@@) % و أصبحت أطيارنا قد حصلت % % فلا تسل بأي ذنب قتلت % % 72(@)(@@) % مستتبعا وجه العشا وجه السحر % % وكل وجه منهما وجه أغر % % 73(@)(@@) % يالك من صيد مقر العين % % يرضي الصحاب وهو ذو وجهين % % 74(@)(@@) % لم نرض 
ms502	 ما وفى من الأماني % % حتى شفعناه بصيد ثاني % % 75(@)(@@) % صيد الملوك الصيد بالكواسر % % والخيل في وجه الصباح السافر % % 76(@)(@@) % ذاك الذي تصبو له الجوارح % % فهي إلى طلابه طوامح % % 77(@)(@@) % واثقة بالرزق حيث كانا % % تغدو خماصا وتجي بطانا % % 78(@)(@@) % سرنا على اسم الله والمناجح % % نعوم في الأقطار بالسوابح % % 79(@)(@@) % خيل تحاذي الصيد حيث مالا % % كأنها أضحت له ظلالا % % 80(@)(@@) % تسعى لها قوائم لا تتبع % % وكيف لا وهي الرياح الأربع % % PageV01P2381 81(@)(@@) % رائقة المنظر زهراء الغرر % % كأنها الروضات حيت بالزهر % % 82(@)(@@) % من أحمر للبرق عنه خبر % % يشهد أن الحسن حقا أحمر % 83(@)(@@) % و أصفر الجلدة كالدينار % % يسر كف الصائد الممتار % % 84(@)(@@) % و أشهب كالسهم في انقضاضه % % وصفحة الطرس في ابيضاضه % % 85(@)(@@) % ماضي السباق أظهر اللباس % % ناهيك من سهم ومن قرطاس % % 86(@)(@@) % و أخضر مثل سنا العيش النضر % % يطوى الفلا وكيف لا وهو الخضر % % 87(@)(@@) % و أدهم ساد على الجياد % وهكذا السواد في السواد % % 88(@)(@@) % تحفنا من فوقها غلمان % % كأنهم لدوحها أغصان % % 89(@)(@@) % ترك تريك في سناء الملبس % % كواكبا طالعة في الأطلس % 90(@)(@@) % منظومة الأوساط بالسلاح % % من كل سهم رجل الجناح % % PageV01P2382 91(@)(@@) % و كل عضب ذرب المقاطع % % يحرف الهام عن المواضع % % 92(@)(@@) % على يد الزائر منهم زاده % % من كل باز قرم فؤاده % % 93(@)(@@) % قد كتبت في شكله حروف % % تقري بما يقرى به الضيوف % % 94(@)(@@) % فالمنسر الأشفى بحال جيما % % والعين تجلى بالنضار ميما % % 95(@)(@@) % دان لمن يتلوه خير جم % سهم إذا حبرته أو شهم % % 96(@)(@@) % و كل شاهين شهي المرتمى % % كبارق طار وصوب قد همى % % 97(@)(@@) % بينا تراه ذاهبا لصيده % % معتصما بأيده وكيده % % 98(@)(@@) % حتى تراه عائدا من أفقه % % ملتزما طائره في عنقه % % 99(@)(@@) % أفلح من كان على يسراه % % حتى غدت حاسدة يمناه % % 100(@)(@@) % تلك يد لا تعرف الاعسارا % % لأجل ذا قد سميت يسارا % % PageV01P2383 101(@)(@@) % و كل صقر مسبل الجناح % % مواصل الغدو والرواح % % 102(@)(@@) % ذو مقلة لها ضرام واقد % % تكاد تشوي ما يصيد الصائد % % 103(@)(@@) % كأنما المخلب منه منجل % % لحصد أعمار الطيور مرسل % % 104(@)(@@) % عيش 
ms503	 ذوي الصيد به عيش رخي % % يصلح أن يدعى وكيل المطبخ % % 105(@)(@@) % يا حبذا طيور جد ولعب % % تهوي إلى الأرض وللأفق تثب % % 106(@)(@@) % من سنقر عالي المدا والشان % % معظم الأخبار والعيان % % 107(@)(@@) % كأنه خليفة قد أقدما % % يفسد الأرض ويسفك الدما % % 108(@)(@@) % يصعد خلف الرزق ليس يمهله % % كأنه من السما يستعجله % % 109(@)(@@) % و من عقاب بأسها مروع % % كأنها للطير جن تفزع % % 110(@)(@@) % كم جلبت لطائر من مهن % % وكم وكم قد أهلكت من قرن % PageV01P2384 111(@)(@@) % و حبذا كواسر الكواهي % % عديمة الأنظار والأشباه % % 112(@)(@@) % مخصومة بالطرد القويم % % حدبا كظهر الذنب الركيم % % 113(@)(@@) % ذاك لعمري حدب للرائي % % يعدل ملك القلعة الحدباء % % 114(@)(@@) % هذا وقد تجهزت أعداد % تجمعها الكلاب والفهاد % % 115(@)(@@) % من كل فهد عنتري الحمله % % اذا رأى شخص مهاة عبله % % 116(@)(@@) % مبارك الإقبال والإعراض % % مستقبل الحال بناب ماض % % 117(@)(@@) % كأنه من حده كنابه % % قد أحرق الأنجم في إهابه % % 118(@)(@@) % له على مسائل الجفون % % خط لبعض الألفات الجون % % 119(@)(@@) % ما أبصر المبصر خطا مثله % % وكيف لا والخط لابن مقله % % 120(@)(@@) % و كل منسوب إلى سلوق % % أهرت وثاب الخطا مشوق % % PageV01P2385 121(@)(@@) % طاوي الفؤاد ناشر الأظافر % % يا عجبا منه لطاو ناشر % % 122(@)(@@) % يعض بالبيض ويخطو بالقنا % % ويسبق الوهم لإدراك المنى % % 123(@)(@@) % كالقوس إلا أنه كالسهم % % والغيم يجلو عن شهاب رجم % % 124(@)(@@) % اذا ترآى بقر الوحش اندفع % % كأنه المريخ في الثور طلع % % 125(@)(@@) % قاصرة عن طرفه يداه % % مشروطة برجله أذناه % % 126(@)(@@) % لو أمكن الشمس التي تجلى له % % ما سميت من خوفها غزاله % % 127(@)(@@) % يشفعه بكل غور غار % % مغالب الصيد على الأوكار % % 128(@)(@@) % يكاد يبغي سلما إلى السما % % أو نفقا في الأرض حيث يمما % % 129(@)(@@) % واها لها من أكلب طوارد % % معربة عن مضمر المصائد % % 130(@)(@@) % قد بالغت من طمع في كسبها % % ففتشت عن أنفس لم تخبها % % PageV01P2386 131(@)(@@) % حتى اذا تمت بها الأمور % % حفت بنا لصيدها الطيور % % 132(@)(@@) % ما بين روضات صمدنا نحوها % % ودور آفاق ملكنا جوها % % 133(@)(@@) % و استقبلت أطيارها البزاة % % معلمة كأنها عزاة % % 134(@)(@@) % فلم تزل تسطو سطا الحجاج 
ms504	 % % على الكراكي أو الدراج % % 135(@)(@@) % اذا نحت سائرة محلقة % % عادت بها كمضغة مخلقة % % 136(@)(@@) % حتى غدت تلك الضواري صرعى % % مجموعة لدى التراب جمعا % % 137(@)(@@) % كأن أقطار الفلاة مجزره % % أو روضة من الدماء مزهره % % 138(@)(@@) % كأن صرعى وحشها كفار % % الموت عقبى أمرها والنار % % 139(@)(@@) % للمرء فيها منظر أحبه % % يملأ من لحم وشحم قلبه % % 140(@)(@@) % لله ذاك المنظر المهنى % % إن معان عن ذراه عدنا % % PageV01P2387 141(@)(@@) % قد ملئت من ظفر أيدينا % % وقد شكرنا الفضل ما حيينا % % 142(@)(@@) % نشير حول الملك المنصور % % كالشهب حول القمر المنير % % 143(@)(@@) % محمد ناصر دين أحمد % % الملك ابن الملك المؤيد % % 144(@)(@@) % قال الأنام حظه جلي % % قلت نعم وجده علي % 145(@)(@@) % ذاك الذي سامى العلى صبيا % % وجاءه من مهده مهديا % % 146(@)(@@) % ناش على الحر وتقليب المنن % % كأنما مزجته من اللبن % % 147(@)(@@) % بين حجور العلم والاعلام % % تكنفه لواحظ الأقلام % % 148(@)(@@) % محكم السطوة سحاح الديم % % يأخذ بالسيف ويعطي بالقلم % % 149(@)(@@) % لو لمس الصخر لفاض نهرا % أو صحب النجم لعاد بدرا % % 150(@)(@@) % تختمت بيمنه المكارم % فهو على كل الوجوه حاتم % PageV01P2388 151(@)(@@) % لا ظلم تلقى في حماه العالي % % إلا على الأعداء والأموال % % 152(@)(@@) % أما ترى بالصيد فرط حبه % % تمرنا على اعتياد حربه % % 153(@)(@@) % اما ترى الدينار منه خائفا % أصفر في كف العفاة ناشفا % % 154(@)(@@) % يا قاطعا عرض الفلا وواصلا % وقادما يبغي العلى وراحلا % % 155(@)(@@) % إذا تأملت المقام الناصري % % فاعقد عليه أكرم الخناصر % % 156(@)(@@) % ملك إذا حققته قلت ملك % % قاضية بسعده أيدي الفلك % % 157(@)(@@) % كالبدر في سنائه وتمه % % والطود في وقاره وحلمه % % 158(@)(@@) % تسجد ان لاح رؤوس العالم % % وراثة قد حازها من آدم % % 159(@)(@@) % ماضر من خيم في جنابه % % أن لا يكون الشهد من أطنابه % % 160(@)(@@) % مرأى يشف عن فخار الأهل % % ونسخة قد قوبلت بالأصل % % PageV01P2389 161(@)(@@) % جنابه عن جاره لا ينكب % % وباب نجح للمنى مجرب % % 162(@)(@@) % غنيت في ظلاله عن الورى % % غنى نزيل المزن عن قصد القرى % % 163(@)(@@) % و رحت عن نعماه بالتواتر % % أروي أحاديث عطا وجابر % % 164(@)(@@) % معتصما بالكرم المؤيد % % مصلي الحمد على محمد 
ms505	 % % 165(@)(@@) % قديم قصد وثناء أو هوى % % ما ضل سعي فيهما ولا غوى % % 166(@)(@@) % يزيد لفظي بهجة ورونقا % % كأنه الخمرة إذ تعتقا % % 167(@)(@@) % حسبك مني في الثناء شاعرا % % وحسب شعري قوة وناصرا % % PageV01P2390 البحر : - 1(@)(@@) % لهفي على غادة إذا أسفرت % % غارت وجوه الشموس واستترت % % 2(@)(@@) % لها من السمر قامة خطرت % % كم قتلت عاشقا وكم أسرت % % 3(@)(@@) % إذا دعت للنهوض ميلها عطفا % كان سحر الجفون حملها ضعفا % % 4(@)(@@) % في خدها شامة معنبرة % يا نعمة بالشقيق مزهرة % 5(@)(@@) % وكم لها في الشفاه جوهرة % تحفها ريقة معطرة % 6(@)(@@) % من رام بالشهد أن يمثلها رشفا % % فإنما رام أن يعسلها وصفا % % 7(@)(@@) % تحكم في الناس عنسه وردا % % حكم ابن أيوب في سطا وندا % % 8(@)(@@) % بين عفاة له وبين عدا % % ما يد سميت لديه يدا % % 9(@)(@@) % وهي غمام لمن تأملها وطفا % % سبحان من للعباد أرسلها لطفا % % 10(@)(@@) % مؤيد في ملا مراتبه % يتضح الملك في مناقبه % PageV01P2391 11(@)(@@) % اذا طوى الأرض في كتائبه % ثم سقاها حيا مواهبه % 12(@)(@@) % أنبت أزهارها ودللها قطفا % % من بعد ما كاد أن يزلزلها خسفا % % 13(@)(@@) % وغادة حاد سحر مقلتها % % وراق للناس روض طلعتها % % 14(@)(@@) % جنيت نار الأسى بجنتها % % وصحت من صبوتي بوجنتها % % 15(@)(@@) % وجنة ورد تشكو النفوس لها لهفا % % بياض من شملها وقبلها ألفا % % PageV01P2392 البحر : - 1(@)(@@) % زحفت بيض الظبا لما رنا % % فتلقاها سريعا مقتلي % % 2(@)(@@) % عامري اللحظ طائي الفم % % 3(@)(@@) % بارز في حسنه كالصنم % % 4(@)(@@) % قلت والقلب اليه ينتمي % % 5(@)(@@) % لك قلبي عبد ود وأنا % % فيك يا أشهل عبد الأشهل % 6(@)(@@) % آه ما أكثر فيك المللا % % 7(@)(@@) % ما دنا شخصك حتى ارتحلا % % 8(@)(@@) % ودعا الحادي وشد الجملا % % 9(@)(@@) % فاستشار البين عندي فتنا % % وغدا يومي يوم الجمل % 10(@)(@@) % أترى يرجع عيشي الناعم % % PageV01P2393 11(@)(@@) % ومقامي بالحميا قائم % % 12(@)(@@) % والحيا بالبرق معط باسم % % 13(@)(@@) % كعماد الدين جماع الثنا % % أفضل الأمة نجل الأفضل % 14(@)(@@) % ملك عم الورى بالمنن % % 15(@)(@@) % وكفاهم مرتبات المحن % % 16(@)(@@) % طاهر الأسرار شهم العلن % % 17(@)(@@) % راقب الله وأسدى المننا % % فهو الوسمي فينا والولي % % 18(@)(@@) % كرم الأخلاق 
ms506	 من مذهبه % % 19(@)(@@) % والعلا والجود من مطلبه % % 20(@)(@@) % يا أماني الوفد هنيت به % % PageV01P2394 21(@)(@@) % الندى حيث الهدى حيث الثنا % % فاجتدي أو فاجتني أو فاجتلي % % 22(@)(@@) % وفتاة أتمنى وصلها % % 23(@)(@@) % وهي لا تألف إلا بخلها % % 24(@)(@@) % بهواها يا رسولي قل لها % % 25(@)(@@) % عللي القلب بأرواح المنا % % وعدي الصب ودعي المطل % % PageV01P2395 البحر : - 1(@)(@@) % إلي بكأسك الأشهى إليا % % ولا تبخل بعسجدها عليا % % 2(@)(@@) % معتقة تدار على النداما % % 3(@)(@@) % كأن على ترائبها نظاما % % 4(@)(@@) % من الراح التي محت الظلاما % % 5(@)(@@) % أضاءت وهي صاعدة الحميا % % فقلت عصير عنقود الثريا % % 6(@)(@@) % أدرها بين ألحان وزمر % % 7(@)(@@) % على درين من زهر وقطر % % 8(@)(@@) % كأن حديثه في كل قطر % % 9(@)(@@) % حديث ندى المؤيد في يديا % % يطيب رواية ويضوع ريا % % 10(@)(@@) % إلى الملك المؤيد سار مدحي % % PageV01P2396 11(@)(@@) % وخاض إلى حماه كل سمح % % 12(@)(@@) % كما خاض النجوم طلوب صبح % % 13(@)(@@) % فيا لندى طوى الأقطار طيا % % وأنشر حاتما عندي وطيا % % 14(@)(@@) % حلفت ببشرك الوضاح حقا % % 15(@)(@@) % لبق فقت الأنام علا وسبقا % % 16(@)(@@) % فرفقا يا فتى العلياء رفقا % % 17(@)(@@) % شويت جوانح القرناء شيا % % فليتك لو لطفت بهن شيا % % 18(@)(@@) % وغانية يجن بها الجنان % % 19(@)(@@) % يضوع اذا تنفست المكان % % 20(@)(@@) % خلوت بها وقد سمح الزمان % % PageV01P2397 21(@)(@@) % فألقيت الحيا عن منكبيا % % وغافلت الرقيب وقلت هيا % % PageV01P2398 البحر : - 1(@)(@@) % حشى من نار صدك ذائبه % % وتحسبها دموعا ساكبه % % 2(@)(@@) % ولم يفطن لها % % سوى صب أقام % % 3(@)(@@) % على فرش السقام % % 4(@)(@@) % درى ما قصتي فحاكى % % لوعتي وجارى عبرتي % % 5(@)(@@) % و بتنا كالحمائم في الحنين % % و ما يدري الحزين سوى الحزين % % 6(@)(@@) % سباني بالفتور وبالفنون % % 7(@)(@@) % غلام شاهر حد الجفون % % 8(@)(@@) % على وجناته لام ونون % % 9(@)(@@) % يقول وصال مثلي لن يكون % % 10(@)(@@) % فيالك من جفون ضاربه % % بأمثال السيوف القاضبه % % PageV01P2399 11(@)(@@) % اذا ما سلها % % أبادت في الأنام % % 12(@)(@@) % و يالك من غلام % % 13(@)(@@) % كحيل المقلة % % شريف الوجنة % 14(@)(@@) % ضنين العطفة % % 15(@)(@@) % بكيت دما بمرآه الضنين % % كأني فيه من عيني ظعين % % 16(@)(@@) % يعنفني النديم على التصابي % % 17(@)(@@) % و يحلف لا يذوق 
ms507	 لمى الحباب % % 18(@)(@@) % رويدك كيف أسلو عن شراب % % 19(@)(@@) % و عن ساق يطوف على الصحاب % % 20(@)(@@) % بكأس للأنامل خاضبه % % تحل عرى النفوس التائبه % % PageV01P2400 21(@)(@@) % و تنقص حبلها % % فدع عنك الملام % % 22(@)(@@) % و بادر بالمدام % % 23(@)(@@) % زمان اللذة % % و خذ يا منيتي % % 24(@)(@@) % خضاب القهوة % % 25(@)(@@) % و لا تمدد إلى حلف يمين % % فما الخصيب كف من يمين % % 26(@)(@@) % لها وصلي ولابن علي قصدي % % 27(@)(@@) % تضيع ثروتي ونداه يجدي % % 28(@)(@@) % مليك طالع في كل حمد % % 29(@)(@@) % تكاد يمينه بالجود تعدي % % 30(@)(@@) % إلى تلك اليمين الواهبه % % تيمم كل نفس طالبه % % PageV01P2401 31(@)(@@) % و تأوي ظلها % % على غيظ الغمام % 32(@)(@@) % لدى عالم المقام % % 33(@)(@@) % رفيع النسبة % نسيب الرفعة % 34(@)(@@) % سعيد الطلعة % % 35(@)(@@) % أغاث ندى يديه المعتفين % % و أودى بأسه بالمعتدين % % 36(@)(@@) % بني أيوب حسبكم عمادا % % 37(@)(@@) % أعاد سناء بيتكم وزادا % % 38(@)(@@) % كريم كم قصدناه فجادا % % 39(@)(@@) % وعدنا قاصدين له فعادا % % 40(@)(@@) % ولاقينا لها متواثبه % % جوئزنا عليها واجبه % % PageV01P2402 41(@)(@@) % ففتحنا اللهى % % بأنواع الكلام % % 42(@)(@@) % كأسجاع الحمام % % 43(@)(@@) % فكم من منحة % محت من نزحة % 44(@)(@@) % وكم من مدحة % % 45(@)(@@) % لها في كل سامعة رنين % % يكاد بلحنها يشدو الجنين % % 46(@)(@@) % ومشغوف اذا مالليل جنا % % 47(@)(@@) % تذكر وصل من يهوى فجنا % % 48(@)(@@) % كذا من يعشق الأجفان وسنا % % 49(@)(@@) % نهبن منام مقلته فعنا % % 50(@)(@@) % على صحب الجفون الناهبه % % متى تهدى الضلوع اللاهبه % % PageV01P2403 51(@)(@@) % تركتني لأجلها % % إذا جن الظلام % % 52(@)(@@) % جفا عيني المنام % % 53(@)(@@) % وهاجت حسرتي % % على تلك التي % % 54(@)(@@) % أباحت قتلتي % % 55(@)(@@) % وما في دولة الأحباب أمين % % فينظر في قلوب المسلمين % % PageV01P2404 
