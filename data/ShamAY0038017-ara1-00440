ms430	 امرأة أبي موسى الأشعري.(@)(@@)(@@)(@@) ||| AUTO أم عامر بنت سويد.(@)(@@)(@@)(@@) ||| AUTO أم الغادية.(@)(@@)(@@)(@@) ||| AUTO أم ليلى الأنصارية.(@)(@@)(@@)(@@) ||| AUTO أم معبد(@)(@@) مولاة قرظة بن كعب.(@)(@@)(@@)(@@) ||| AUTO أم مالك الأنصارية.(@)(@@)(@@)(@@) ||| AUTO أم معاذ الأنصارية.(@)(@@)(@@)(@@) ||| AUTO أم المنذر العدوية.(@)(@@)(@@)(@@) ||| AUTO أم هشام بنت حارثة بن النعمان.(@)PageV01P002(@)(@@) [ج 1: ص 482](@)(@@)(@@)(@@) ||| AUTO أم هانئ الأنصارية.(@)(@@)(@@)(@@) ||| AUTO أم ورقة بنت حمزة بن عبد المطلب(@)(@@) بنت عم رسول الله صلى الله عليه وسلم اختلفوا في اسمها فمنهم من قال: عمارة ومنهم من قال: أمامة، وقد قيل: أم الفضل.(@)PageV01P002(@)(@@) [ج 2: ص 3](@)(@@)(@@)(@@) | AUTO أول كتاب التابعين PageV01P002 [ج 2: ص 4](@)PageV01P002(@)(@@)(@@)(@@) || AUTO [ج 2: ص 5] باب الألف(@)(@@) قال أبو حاتم:(@)(@@) ومن التابعين الذين شافهوا الصحابة، ورووا عنهم ممن ابتدأ اسمه على الألف:(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الرحمن بن عوف الزهري القرشي، كنيته أبو إسحاق(@)(@@) يروي عن: أبيه، روى عنه: الزهري، وهو أخو حميد بن عبد الرحمن بن عوف، أمهما أم كلثوم بنت عقبة بن أبي معيط، مات إبراهيم سنة ست وتسعين بالمدينة، وهو ابن خمس وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن سعد بن أبي وقاص الزهري المدني(@)(@@) يروي عن: أبيه، وأسامة بن زيد، روى عنه حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن أبي موسى الأشعري(@)(@@) يروي عن: أبيه، والمغيرة بن شعبة، روى عنه الشعبي، والحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن محمد بن طلحة بن عبيد الله القرشي التيمي المدني(@)(@@) يروي عن: أبي هريرة، وعائشة، روى عنه محمد بن عبد الرحمن مولى آل طلحة وعبد الله بن محمد بن عقيل، مات بالمدينة سنة عشر ومائة، وكان أعرج اسم أمه خولة بنت منظور بن زبان.(@)PageV01P002(@)(@@) [ج 2: ص 6](@)(@@)(@@)(@@) ||| AUTO إبراهيم بن البراء بن عازب الأنصاري(@)(@@) أخو الربيع بن البراء كوفي، يروي عن: أبيه، روى عنه: سلمة بن كهيل.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن رافع بن خديج الأنصاري مدني(@)(@@) يروي عن: أبيه، روى عنه: ابن أخيه رفاعة بن هرير.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن جرير بن عبد الله البجلي(@)(@@) يروي عن: أبيه، روى عنه: شعبة بن الحجاج تأخر موته حتى كتب عنه شريك.(@)(@@)(@@)(@@) ||| AUTO 
ms431	 إبراهيم بن عكرمة بن يعلى بن أمية الثقفي(@)(@@) يروي عن: ابن عباس، روى عنه: عبد الله بن عثمان بن خثيم.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن محمد بن عبد الله بن جحش بن رئاب بن يعمر(@)(@@) يروي عن: أبيه، روى عنه: مهدي بن ميمون.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن قارظ القرشي الحجازي(@)(@@) يروي عن: عمر، وعلي، روى عنه الزهري، وهو الذي يروي عن: السائب بن يزيد، وأبي سلمة.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن يزيد بن شريك التيمي تيم الرباب كنيته أبو أسماء كوفي(@)(@@) يروي عن: أنس بن مالك، روى عنه: الحكم، وسلمة بن كهيل، وأهل الكوفة، مات في سنة ثنتين وتسعين، وكان عابدا صابرا على الجوع الدائم، وقد قيل إنه PageV01P002 [ج 2: ص 7] مات في حبس الحجاج بن يوسف بواسط سنة ثلاث وتسعين، وكان قد طرح عليه الكلاب لتنهشه، ثنا الفريابي، قال: ثنا جرير، عن الأعمش، قال: كان إبراهيم يصوم الشهر لا يفطر، فإذا أفطر أفطر على شربة سويق أو شربة لبن لا يزيد عليه، قال يزيد: فحدثت به المغيرة، فقال: إني سمعت قراءته قلت: هذا قراءة رجل أكول.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن يزيد بن عمرو النخعي أبو عمران(@)(@@) سمع المغيرة بن شعبة، وأنس بن مالك، ودخل على عائشة، روى عنه: منصور، ومغيرة، والأعمش كان مولده سنة خمسين ومات سنة خمس أو ست وتسعين، وهو ابن ست وأربعين سنة بعد موت الحجاج بأربعة أشهر، وكانت أمه مليكة بنت قيس، أخت علقمة بن قيس، وهى عمة الأسود بن يزيد، وقد قيل إنه إبراهيم بن يزيد بن الأسود بن ربيعة بن عمرو بن ربيعة بن حارثة بن سعد بن مالك بن النخع بن عمرو، ومن زعم أنه إبراهيم بن يزيد بن عمرو، فقد نسب إلى جده، وقد قيل إنه مات وهو متوار من الحجاج فدفن ليلا وكان له يوم مات ست وأربعين سنة.(@)(@@) (83) -[2: 7] حدثنا محمد بن عمرو بن يوسف، قال: ثنا نصر بن علي الجهضمي، نا خالد بن الحارث، ثنا سعيد بن أبي عروبة، عن أبي معشر، أن 
ms432	 النخعي، حدثهم، أنه " دخل على عائشة، فرأى عليها ثوبا أحمر، فقال له أيوب: كيف دخل على عائشة، قال: كان يحج مع عمه، وخاله، وهو غلام فدخل عليها "(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الرحمن بن عبد القاري(@)(@@) يروي عن: ابن عمر، روى عنه: حمزة بن أبي جعفر من حديث ابن أبي ذؤيب، قال: رأيت ابن عمر " وضع يده على مقعد النبي صلى الله عليه وسلم من المنبر، ثم وضعها على وجهه ".(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الرحمن العذري(@)(@@) يروي المراسيل، روى عنه: معان بن رفاعة.(@)(@@) (84) -[2: 7] ثنا بعض مشايخنا، قال: ثنا أبو الربيع الزهراني، قال: ثنا حماد بن زيد، عن بقية بن الوليد، عن معان بن رفاعة، عن إبراهيم بن عبد الرحمن العذري، قال: قال رسول الله صلى الله عليه وسلم: " يرث هذا العلم من كان خلف عدوله، ينفون عنه تحريف الغالين، وانتحال المبطلين، وتأويل الجاهلين "(@)PageV01P002(@)(@@) [ج 2: ص 8](@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن عبد الرحمن حجازي(@)(@@) أحسبه ابن أبي ربيعة، يروي عن: سعد بن أبي وقاص، روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن أبي ربيعة المخزومي(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: ابنه موسى بن إبراهيم المدني.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن مسلم بن أبي حرة(@)(@@) يروي عن: ابن عباس مدني، روى عنه: عطاف بن خالد المخزومي.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن حرب كوفي(@)(@@) أخو سماك بن حرب، يروي عن: جابر بن سمرة، روى عنه: شريك بن عبد الله النخعي.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن أبي خداش الهاشمي اللهبي(@)(@@) من أهل مكة، يروي عن: ابن عباس، روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن أبي حديد الأودي، ويقال: ابن حديد، وكنيته أبو إدريس(@)(@@) يروي عن: علي، عداده في الكوفيين، روى عنه: إسماعيل بن سالم.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن أبي عبلة واسم أبي عبلة شمر بن يقظان بن عامر بن عبد الله بن المرتحل العقيلي الشامي(@)(@@) يروي عن: أنس بن مالك، وواثلة، وأبي، أبي ابن أم حرام، وقد رأى ابن عمر، وروى عنه ابن المبارك وأهل الشام مات سنة ثنتين 
ms433	 وخمسين ومائة بفلسطين.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن راشد(@)(@@) يروي عن: ابن عمر، روى عن ابن وهب، عن عبد الله بن المسيب عنه.(@)PageV01P002(@)(@@) [ج 2: ص 9](@)(@@)(@@)(@@) ||| AUTO إبراهيم الجهني(@)(@@) يروي عن: أبي هريرة، روى عنه: قرط أبو توبة.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن سعيد(@)(@@) يروي عن: أبي هريرة، روى عنه: عتبة بن أبي حكيم.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن عبد القاري(@)(@@) مدني، يروي عن: رجل من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الجعيد بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن مالك الأشتر(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ابنه مالك بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن إسماعيل(@)(@@) شيخ يروي عن: أبي هريرة، وعائشة، يروي عنه: الحجاج بن عبيد.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن المحرز التيمي(@)(@@) يروي عن: عمرو بن أمية الضمري، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن كثير(@)(@@) يروي عن: ابن عباس، روى عنه: داود بن قيس الفراء.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبيد(@)(@@) شيخ يروي عن ابن عمر، أن رجلا من الأنصار كان له ابن فمات، فقال النبي صلى الله عليه وسلم له: " أما ترضى أن يكون ابنك مع ابني، يناغيه تحت ظل العرش ". روى عنه: أبو طيبة عبد الله بن مسلم.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الرحمن السكسكي كنيته أبو إسماعيل كوفي(@)(@@) يروي عن: ابن أبي أوفى، روى عنه: مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن نعيم بن النحام العدوي حجازي(@)(@@) قتل يوم الحرة، يروي عن: أبيه، روى عنه: ابنه مجاهد.(@)PageV01P002(@)(@@) [ج 2: ص 10](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله(@)(@@) يروي عن: عمر، عداده في البصريين، روى عنه: أبو وهب الجيشاني.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن معبد بن تمام(@)(@@) يروي عن: ابن عباس عداده في أهل الكوفة، روى عنه: محمد بن علي السلمي.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عبد الله بن الحارث بن سراقة العبدي(@)(@@) يروي عن: معاوية وكان قد خرج مع أبيه نحو الشام غازيا، روى عنه: الناس.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن ميسرة الطائفي(@)(@@) عن: أنس بن مالك، روى عنه: ابن جريج، وأيوب، 
ms434	 والثوري، مات قريبا من سنة اثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن يحنس(@)(@@) يروي عن: أبي الدرداء، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن عمير(@)(@@) شيخ يروي عن ابن عمر، روى عنه: إدريس الأودي.(@)(@@)(@@)(@@) ||| AUTO إبراهيم بن إسماعيل(@)(@@) يروي عن أبي هريرة، روى عنه: الحجاج بن يسار.(@)(@@)(@@)(@@) ||| AUTO إبراهيم الأنصاري(@)(@@) يروي عن: مسلمة بن مخلد، روى عنه: ابنه إسماعيل بن إبراهيم.(@)(@@) إبراهيم(@)(@@) مولى أبي هريرة، يروي عن: ابن مسعود، روى عنه: مرزوق أبو بكر.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي مدني(@)(@@) أخو معاوية بن عبد الله بن جعفر، يروي عن: أبيه، روى عنه: عبد الله بن مصعب.(@)PageV01P002(@)(@@) [ج 2: ص 11](@)(@@)(@@)(@@) ||| AUTO إسماعيل بن ثابت(@)(@@) يروي عن ثابت بن قيس الأنصاري، وله صحبة، يروي عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن زيد بن ثابت(@)(@@) أخو خارجة بن زيد، يروي عن: أبيه، روى عنه: عثمان بن عروة كنيته أبو المصعب وهو أصغر ولد زيد.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عمرو بن سعيد القرشي(@)(@@) يروي عن: ابن عباس، روى عنه: مروان بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن محمد بن ثابت بن قيس بن شماس الأنصاري المدني(@)(@@) يروي عن: أنس بن مالك، روى عنه: أبو ثابت من ولد ثابت بن قيس بن الشماس، وهو الذي يروي عن: أبيه، عن جده قصة طويلة.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن هشام بن عامر الأنصاري(@)(@@) يروي عن: أبيه، وأنس بن مالك، روى عنه حميد الطويل.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن إبراهيم بن محمد بن طلحة القرشي حجازي(@)(@@) يروي عن: معاوية روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن إبراهيم السلمي ويقال الشيباني حجازي(@)(@@) يروي عن: ابن عباس روى عنه: عمرو بن دينار، ويعقوب بن خالد.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن سعيد بن عروة البجلي كوفي(@)(@@) ويقال ابن أبي سعيد بن عروة، يروي عن: جندب، روى عنه: يونس بن أبي إسحاق.(@)PageV01P002(@)(@@) [ج 2: ص 12](@)(@@)(@@)(@@) ||| AUTO إسماعيل بن إبراهيم(@)(@@) يروي عن: أبي هريرة.(@)(@@) (85) -[2: 12] روى ليث بن أبي سليم، عن الحجاج، عنه. حدثنا ابن قتيبة، ثنا ابن أبي 
ms435	 السري، ثنا معتمر، ثنا ليث بن أبي سليم، عن الحجاج، عن إسماعيل بن إبراهيم، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: " إذا صلى أحدكم الفريضة، وأراد أن يتطوع، فليتقدم أو يتأخر عن مكانه "، قال: فذكرته لمجاهد، قال: أما المغرب إذا صليت، فتنح عن يمينك، أو عن يسارك(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن جستاس(@)(@@) يروي عن: ابن عمر، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الرحمن بن عطية بصري(@)(@@) يروي عن: جدته أم عطية ولها صحبة، روى عنه: إسحاق بن عثمان.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الرحمن بن أبي ذؤيب الأنصاري الحجازي(@)(@@) يروي عن: ابن عمر، روى عنه: ابن أبي نجيح، وقد قيل: ابن أبي ذؤيب بن أسد بن خزيمة، ومن قال: إنه ابن أبي ذئب فقد وهم.(@)(@@) (86) -[2: 12] ثنا عبد الله بن محمد، قال: ثنا إسحاق، قال: ثنا ابن عيينة، عن ابن أبي نجيح، عن إسماعيل بن عبد الرحمن شيخ من قريش، قال: صحبت ابن عمر إلى الحمى، فلما غربت الشمس هبت أن أقول له: الصلاة، " فسار حتى ذهب بياض الأفق وفحمت العشاء نزل، فصلى المغرب ثلاث ركعات، ثم صلى ركعتين على أثرها، وقال: هكذا رأيت رسول الله صلى الله عليه وسلم فعل "(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الله بن أبي طلحة الأنصاري(@)(@@) أخو إسحاق بن عبد الله بن أبي طلحة الأنصاري، يروي عن: أنس بن مالك، روى عنه: المبارك والحمادان.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن سلمان بن أبي المغيرة الأزرق(@)(@@) يروي عن: أنس بن مالك، روى عنه: وكيع، وعبيد الله بن موسى، والتبوذكي، يخطئ.(@)PageV01P002(@)(@@) [ج 2: ص 13](@)(@@)(@@)(@@) ||| AUTO إسماعيل بن الحسن العتواري(@)(@@) يروي عن: ابن عمر، روى عنه: أخوه يعقوب بن الحسن العتواري.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن سعيد بن رمانة(@)(@@) يروي عن: ابن عمر، روى عنه: يوسف بن عبد الصمد عداده في أهل اليمن.(@)(@@)(@@)(@@) ||| AUTO إسماعيل البجلي(@)(@@) يروي المراسيل عداده في أهل الشام، روى صفوان بن عمرو، عن عبد الرحمن بن أبي عوف، عنه.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن أبي خالد كنيته أبو عبد 
ms436	 الله، كوفي، واسم أبي خالد سعد البجلي(@)(@@) يروي عن: ابن أبي أوفى، وعمرو بن حريث وأنس بن مالك وكان شيخا صالحا مات سنة خمس أو ست وأربعين ومائة، وقد قيل إن اسم أبي خالد هرمز مولى بجيلة.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الله بن أبي طلحة(@)(@@) يروي عن: أنس بن مالك، روى عنه: المبارك بن فضالة.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبيد الأعوري(@)(@@) روى ابن عمر، روى عنه: عمران بن عوف الغافقي.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن أبي سعيد(@)(@@) مولى المهري، يروي عن أبي هريرة، روى عنه: الحارث بن محمد الفهري.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن أبي خالد الفدكي(@)(@@) يروي عن أبي هريرة، روى شعبة، عن عكرمة بن عمار، عنه.(@)(@@)(@@)(@@) ||| AUTO إسماعيل بن ثوبان الأسدي(@)(@@) يروي عن عباس، روى حيوة بن شريح، عن أبي عيسى عنه.(@)PageV01P002(@)(@@) [ج 2: ص 14](@)(@@)(@@)(@@) ||| AUTO إسماعيل بن عبد الرحمن بن أبي كريمة السدي الأعور(@)(@@) مولى زينب بنت قيس بن مخرمة من بني عبد مناف عن أنس بن مالك وقد رأى بن عمر، روى عنه: الثوري وشعبة وزائدة مات سنة سبع وعشرين ومائة في إمارة بن هبيرة.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن سعد بن أبي وقاص القرشي الزهري(@)(@@) عن أبيه، روى عنه: يزيد بن عبد الله بن قسيط.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن سعد بن عبادة الخزرجي الأنصاري المدني(@)(@@) يروي عن: أبيه، روى عنه: سعيد الصراف من حديث حماد بن زيد، عن عبد الرحمن بن أبي شميلة، عن سعيد الصراف.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن طلحة بن عبيد الله التيمي القرشي(@)(@@) يروي عن ابن عباس، روى عنه: ابنه معاوية بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن كعب بن عجرة الأنصاري المدني(@)(@@) يروي عن أبيه، روى عنه: ابنه سعد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن سهل بن أبي حثمة الأنصاري(@)(@@) يروي عن أبيه، روى عنه: محمد بن إبراهيم بن الحارث التيمي(@)(@@)(@@)(@@) ||| AUTO إسحاق بن يحيى بن الوليد بن عبادة بن الصامت(@)(@@) يروي عن عبادة بن PageV01P002 [ج 2: ص 15] الصامت، روى عنه: موسى بن عقبة قتل سنة إحدى وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO إسحاق أبو عبد الله(@)(@@) مولى 
ms437	 زائدة مدني، يروي عن أبي سعيد الخدري وأبي هريرة، روى عنه سعيد المقبري، وأبو صالح، والعلاء بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن أبي إسحاق المدني(@)(@@) يروي عن أبي هريرة، روى عنه: ابن المنكدر، وابنه عبد الله بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن عبد الله بن أبي طلحة الأنصاري المدني(@)(@@) يروي عن أنس بن مالك، روى عنه: الأوزاعي، ومالك مات سنة أربع وثلاثين ومائة وقيل سنة ثنتين وثلاثين ومائة وكنيته أبو يحيى، كان ينزل في دار أبي طلحة الأنصاري، وكان مقدما في رواية الحديث والإتقان فيه، وكان له أخ يقال له: عبد الله بن عبد الله بن أبي طلحة كان أصغر من أخيه إسحاق، وكان ينزل في دار أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن ضمرة(@)(@@) يروي عن: ابن عمر، وروى عنه: بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن عبد الله بن كنانة(@)(@@) يروي عن ابن عباس، روى عنه: ابنه هشام بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن عبد الله بن أبي سرح(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: يحيى بن حمزة إن كان سمع عنه.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن عبد الرحمن(@)(@@) يروي عن حذيفة، روى عنه: سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن بزرج(@)(@@) يروي عن الحسن بن علي بن أبي طالب، روى عنه: الليث بن سعد.(@)PageV01P002(@)(@@) [ج 2: ص 16](@)(@@)(@@)(@@) ||| AUTO إسحاق بن سويد شيخ(@)(@@) يروي عن عمر بن الخطاب، روى عنه: محمد وأبو العلاء.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن راشد(@)(@@) يروي عن أسماء بنت يزيد، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO إسحاق الأعمى(@)(@@) يروي عن عائشة، روى عنه: إسماعيل بن رافع.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن أبي الكهتلة(@)(@@) يروي عن ابن مسعود، روى عنه: الوليد بن قيس.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن أبي حبيبة(@)(@@) مولى رباح، يروي عن أبي هريرة، روى عنه: سعد بن إسحاق المدني.(@)(@@)(@@)(@@) ||| AUTO إسحاق مولى محمد بن زياد(@)(@@) يروي عن أبي واقد الليثي، روى عنه: محمد بن أبي يحيى(@)(@@)(@@)(@@) ||| AUTO إسحاق بن المحتفر(@)(@@) يروي عن عمر، روى عنه: الكوفيون.(@)(@@)(@@)(@@) ||| AUTO إسحاق بن أبي طريف 
ms438	(@)(@@) يروي عن ابن عمر، روى علي بن عبد الرحمن بن وثاب، عن أبيه، عنه، وقد قيل: إسحاق بن أبي طريفة.(@)(@@)(@@)(@@) ||| AUTO أيوب بن خالد بن صفوان الحجازي الأنصاري(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: سعد بن سعيد وعمر مولى غفرة، ومن قال: أيوب بن صفوان فقد نسبه إلى جده.(@)PageV01P002(@)(@@) [ج 2: ص 17](@)(@@)(@@)(@@) ||| AUTO أيوب بن عبد الله اللخمي(@)(@@) يروي عن: ابن عمر، روى عنه: علي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO أيوب بن عبد الله بن يسار(@)(@@) يروي عن: ابن عمر، روى عنه: خالد بن أبي عثمان من حديث داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO أيوب بن عبد الله بن مكرز من بني عامر بن لؤي(@)(@@) وكان رجلا خطيبا، يروي عن: ابن مسعود، ووابصة، روى عنه: الزبير، أبو عبد السلام.(@)(@@)(@@)(@@) ||| AUTO أيوب بن بشير بن سعد المعاوي من الأوس كنيته أبو سليمان(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: سهيل بن أبي صالح والناس، مات سنة تسع عشرة ومائة، وهو ابن خمس وسبعين سنة، وكان مولده سنة أربع وأربعين وربما يروي عن: سعد الأعشى، عن أبي سعيد.(@)(@@) (87) -[2: 17] أنبأ السختياني، قال: ثنا وهب بن بقية، قال: ثنا خالد، عن سهيل بن أبي صالح، عن أيوب بن بشير، عن أبي سعيد الخدري، قال: قال رسول الله صلى الله عليه وسلم: " لا يكون لأحد ثلاث بنات، أو ثلاث أخوات، أو ابنتان، أو أختان فيتقي الله فيهن ويحسن إليهن إلا دخل الجنة "(@)(@@)(@@)(@@) ||| AUTO أيوب بن ميسرة(@)(@@) مولى الخطميين من أهل المدينة، يروي عن: أبي هريرة، روى عنه: هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO أيوب بن حسن بن علي بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: سلمى ولها صحبة، روى عنه: عبد الرحمن بن أبي الموالي.(@)(@@)(@@)(@@) ||| AUTO أيوب بن ميسرة بن حلبس الجبلاني الشامي(@)(@@) أخو يونس بن ميسرة، يروي عن: بسر بن أبي أرطاة، وخريم بن فاتك، روى عنه: ابنه محمد بن أيوب بن ميسرة، قتل(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 18] أيوب بن ميسرة بعد أن عمي 
ms439	 سنة اثنتين وثلاثين ومائة مدخل عبد الله بن علي دمشق،(@)(@@) (88) -[2: 18] أنبأ أبو يعلى، قال: ثنا داود بن رشيد، قال: ثنا الوليد بن مسلم، عن محمد بن أيوب بن ميسرة بن حلبس، عن أبيه، قال: سمعت خريم بن فاتك الأسدي، يقول: أهل الشام سوط الله في أرضه ينتقم بهم ممن يشاء من عباده، وحرام على منافقيهم أن يغلبوا على مؤمنيهم ولا يموتوا إلا غما وهما(@)(@@)(@@)(@@) ||| AUTO أيوب بن سليمان(@)(@@) يروي عن: أنس بن مالك، روى عنه: محمد بن حمير.(@)(@@) (89) -[2: 18] ثنا أحمد بن الحسن بن عبد الجبار، قال: ثنا الهيثم بن خارجة، قال: ثنا محمد بن حمير، عن أيوب بن سليمان، قال: مات مولى أنس بن مالك فبيتوه، فقال أنس: " ضعوا على بطنه حديدة لا ينتفخ "(@)(@@)(@@)(@@) ||| AUTO أيوب بن قطن(@)(@@) أحسبه بصريا، يروي عن: أبي بن عمارة وله صحبة، روى عنه: محمد بن يزيد بن أبي زياد وفى إسناده نظر.(@)(@@) أيوب(@)(@@) شيخ، يروي عن عبد الله بن عمرو: " من تاب قبل موته بساعة قبل منه ". أحسبه أيوب بن فرقد، حديثه عند شعبة، عن إبراهيم بن ميمون، عن رجل من بني الحارث.(@)(@@)(@@)(@@) ||| AUTO أيوب بن بشير الأنصاري(@)(@@) أبو سليمان الأوسي، يروي عن: عباد بن عبد الله بن الزبير، عن عائشة، روى عنه: ابن شهاب الزهري.(@)(@@)(@@)(@@) ||| AUTO أيوب بن خالد(@)(@@) يروي عن: ابن عمر، روى عنه: موسى بن عبيدة يعتبر، بحديثه من غير حديث موسى عنه.(@)(@@)(@@)(@@) ||| AUTO أيوب بن طهمان أبو عطاء الثقفي(@)(@@) قال: رأيت علي بن أبي طالب بالمدائن أمر بالتماثيل التي في القبلة فقطع رؤوسها ثم صلى، روى عنه: شبابة بن سوار.(@)(@@)(@@)(@@) ||| AUTO أشعث بن أبي خالد(@)(@@) يروي عن: أبي هريرة، روى عنه: أخوه إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO أشعث بن طلق النهدي(@)(@@) يروي عن: ابن عمر، روى عنه: ابن عيينة.(@)PageV01P002(@)(@@) [ج 2: ص 19](@)(@@)(@@)(@@) ||| AUTO أشعث بن ثرملة(@)(@@) يروي عن: أبي بكر الثقفي، روى عنه: الحكم بن الأعرج.(@)(@@)(@@)(@@) ||| AUTO أشعث بن عمير بن جودان(@)(@@) يروي عن: أبيه وكان أبوه فيمن وفد على رسول 
ms440	 الله صلى الله عليه وسلم روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO أشعث أبو عبد الله الحملي(@)(@@) يروي عن: أنس بن مالك، روى عنه: هارون المقرئ.(@)(@@)(@@)(@@) ||| AUTO الأسود بن يزيد بن قيس بن عبد الله بن علقمة بن سلامان بن كهيل بن النخع كنيته أبو عمرو(@)(@@) ابن أخي علقمة بن قيس، يروي عن: أبي بكر، وعمر، روى عنه: الشعبي، والنخعي، وكانت أم إبراهيم النخعي مليكة بنت قيس عمة الأسود بن يزيد، وكان الأسود صواما وقواما حج بين أربعين حجة وعمرة، وكان فقيها زاهدا مات سنة خمس وسبعين وقد قيل سنة أربع وسبعين كنيته أبو عبد الرحمن،(@)(@@) (90) -[2: 19] ثنا الحسن بن سفيان، قال: ثنا أبو بكر بن شيبة، قال: ثنا جرير، عن منصور، عن إبراهيم، قال: " كان الأسود يقرأ القرآن في شهر رمضان في ليلتين ويختم في سوى رمضان في ستة، وكان علقمة يختمه في خمس "(@)(@@) (91) -[2: 19] ثنا عمرو بن محمد المهراني، قال: ثنا زيد بن أخزم، قال: ثنا أبو قتيبة، قال: ثنا شعبة، عن أبي إسحاق، قال: جمع الأسود بن يزيد بين ثمانين حجة وعمرة وجمع عمر بن منصور بين ستين حجة وعمرة(@)(@@)(@@)(@@) ||| AUTO الأسود بن هلال المحاربي(@)(@@) يروي عن: معاذ بن جبل، روى عنه: أبو حصين مات سنة أربع وثمانين بعد الجماجم.(@)PageV01P002(@)(@@) [ج 2: ص 20](@)(@@)(@@)(@@) ||| AUTO الأسود بن كلثوم(@)(@@) يروي المراسيل، روى عنه: حميد بن هلال وعلباء بن أحمر وكان من عباد أهل البصرة وكان يأوي المقابر بالليل، فيتعبد بجنبها إلى الصباح.(@)(@@)(@@)(@@) ||| AUTO الأسود بن قيس البجلي كوفي(@)(@@) يروي عن: جندب بن عبد الله البجلي كنيته أبو قيس، روى عنه: الثوري وشعبة وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الأسود بن عبد الله بن حاجب بن عامر بن المنتفق حجازي(@)(@@) يروي عن: أبيه، عن عمه لقيط بن عامر بن المنتفق، روى عنه: ابنه دلهم بن الأسود.(@)(@@)(@@)(@@) ||| AUTO الأسود بن سعيد الهمداني(@)(@@) يروي عن: ابن عمر، وجابر بن سمرة، روى عنه: زياد بن خيثمة، ومعن بن يزيد.(@)(@@)(@@)(@@) ||| AUTO الأسود بن أبي أسامة(@)(@@) يروي عن: ابن عمر، روى عنه: 