ms569	 النبي :(@)(@@) | 30 ( إن الله تعالى جعل السلام تحية لامتنا ، وأمانا لأهل ذمتنا ) )(@)(@@) ( طب هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5311 ) قال النبي :(@)(@@) | 30 ( إن الله جعل العلم قبضات ثم بثها في البلاد ، فإذا سمعتم بعالم قد قبض من الأرض فقد رفعت قبضته ، فلا يزال يقبض حتى لا يتبقى منه شيء ) )(@)(@@) ( فر ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5312 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل ذرية كل نبي في صلبه ، وجعل ذريتي في صلب علي بن أبي طالب ) )(@)(@@) ( طب ) عن جابر ( خط ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 5313 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل عذاب هاذه الأمة في الدنيا القتل ) )(@)(@@) ( حل ) عن عبد الله بن يزيد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5314 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل لكل نبي شهوة ، وإن شهوتي في قيام هاذا الليل ، إذا قمت فلا يصلين أحد خلفي ، وإن الله تعالى جعل لكل نبي طعمة ، وإن طعمتي هاذا الخمس ، فإذا قبضت فهو لولاة الأمر من بعدي ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5315 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل للزرع حرمة غلوة بسهم ) )(@)(@@) ( هق ) عن عكرمة مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 5316 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل للمعروف وجوها من خلقه ، حبب إليهم المعروف وحبب إليهم فعاله ، ووجه طلاب المعروف إليهم ، ويسر عليهم إعطاءه كما يسر الغيث إلى الأرض الجدبة ليحييها ويحيي به أهلها . وإن الله PageV02P268 تعالى جعل للمعروف أعداء من خلقه ، بغض إليهم المعروف وبغض إليهم فعاله ، وحظر إليهم إعطاءه كما يحظر الغيث عن الأرض الجدبة ليهلكها ويهلك بها أهلها وما يعفو أكثر ) )(@)(@@) ( ابن أبي الدنيا ) في قضاء الحوائج عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5317 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل ما يخرج من بني آدم مثلا للدنيا ) )(@)(@@) ( حم طب هب ) عن الضحاك بن سفيان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5318 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعلني عبدا كريما ، ولم يجعلني جبارا عنيدا ) )(@)(@@) ( د ه ) عن عبد الله 
ms570	 بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5319 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعلها لك لباسا وجعلك لها لباسا ، وأهلي يرون عورتي وأنا أرى ذالك منهم ) )(@)(@@) ( ابن سعد طب ) عن سعد بن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5320 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل هاذا الشعر نسكا ، وسيجعله الظالمون نكالا ) )(@)(@@) ( ابن عساكر ) عن عمر بن عبد العزيز بلاغا .(@)(@@)(@@)(@@) $ ( 5321 ) قال النبي :(@)(@@) | 30 ( إن الله جعل هاذه الأهلة مواقيت فإذا رأيتموه فصوموا ، وإذا رأيتموه فأفطروا ، فإن غم عليكم فعدوا ثلاثين ) )(@)(@@) ( طب ) عن طل ق بن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5322 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جميل يحب الجمال ) )(@)(@@) ( م ت ) عن ابن مسعود ( طب ) عن أبي أمامة ( ك ) عن ابن عمر ( وابن عساكر ) عن جابر وعن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 5323 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جميل يحب الجمال سخي يحب السخاء ، نظيف يحب النظافة ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5324 ) قال النبي :(@)(@@) | 30 ( إن الله جميل يحب الجمال ويحب أن يرى أثر نعمته على عبده ويبغض البؤس والتباؤس ) )(@)(@@) ( هب ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV02P269(@)(@@)(@@)(@@) $ ( 5325 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جميل يحب الجمال ، ويحب معالي الأخلاق ، ويكره سفسافها ) )(@)(@@) ( طس ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5326 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جواد يحب الجود ويحب معالي الأخلاق ، ويكره سفسافها ) )(@)(@@) ( هب ) عن طل حة بن عبيد الله ( حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5327 ) قال النبي :(@)(@@) | 30 ( إن الله حبس عن مكة الفيل وسلط عليها رسول الله والمؤمنين ، ألا فإنها لم تحل لأحد قبلي ولا تحل لأحد بعدي ، ألا وإنها حلت لي ساعة من نهار ، ألا وإنها ساعتي هاذه حرام ، لا يختلى شوكها ، ولا يعضد شجرها ، ولا يلتقط ساقطتها إلا لمنشد ، ومن قتل له قتيل فهو بخير النظرين : إما أن يعقل ، وإما أن يقاد أهل القتيل ) )(@)(@@) ( حم ق د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5328 ) قال النبي :(@)(@@) | 30 ( إن الله حد 
ms571	 حدودا فلا تعتدوها ، وفرض فرائض فلا تضيعوها ، وحرم أشياء فلا تنتهكوها ، وترك أشياء من غير نسيان من ربكم ، ولاكن رحمة منه لكم فاقبلوها ولا تبحثوا عنها ) )(@)(@@) ( ك ) عن أبي ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5329 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حرم الجنة على كل مراء ) )(@)(@@) ( حل فر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5330 ) قال النبي :(@)(@@) | 30 ( إن الله حرم الخمر وحرم الميتة وثمنها ، وحرم الخنزير وثمنه ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5331 ) قال النبي :(@)(@@) | 30 ( إن الله حرم على أمتي الخمر والميسر والمزر والكوبة والغبيراء ، وزادني صلاة الوتر ) )(@)(@@) ( طب هق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV02P270(@)(@@)(@@)(@@) $ ( 5332 ) قال النبي :(@)(@@) | 30 ( إن الله حرم عليكم الخمر والميسر والمزر والكوبة ، وكل مسكر حرام ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5333 ) قال النبي :(@)(@@) | 30 ( إن الله حرم عليكم شرب الخمر وثمنها ، وحرم عليكم أكل الميتة وثمنها ، وحرم عليكم الخنازير وأكلها وثمنها ، قصوا الشوارب واعفوا اللحى ، ولا تمشوا في الأسواق إلا وعليكم الأزر ، إنه ليس منا من عمل سنة غيرنا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5334 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حرم عليكم عقوق الأمهات ، ووأد البنات ، ومنعا وهات ، وكره لكم قيل وقال ، وكثرة السؤال ، وإضاعة المال ) )(@)(@@) ( ق ) عن المغيرة بن شعبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5335 ) قال النبي :(@)(@@) | 30 ( إن الله حرم علي الصدقة وعلى أهل بيتي ) )(@)(@@) ( ابن سعد ) عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5336 ) قال النبي :(@)(@@) | 30 ( إن الله حرم مكة يوم خلق السماوات والأرض فهي حرام بحرمة الله إلى يوم القيامة ، لم تحل لأحد قبلي ولا تحل لأحد بعدي ، ولم تحل لي قط إلا ساعة من الدهر ، لا ينفر صيدها ، ولا يعضد شوكها ، ولا يختلى خلاها ، ولا تحل لقطتها إلا لمنشد ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5337 ) قال النبي :(@)(@@) | 30 ( إن الله حرم من الرضاعة ما حرم من الولادة ) )(@)(@@) ( ت ) عن عائشة رضي الله عنها 
ms572	 ( ز ) .(@)(@@)(@@)(@@) $ ( 5338 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حرم من الرضاع ما حرم من النسب ) )(@)(@@) ( ت ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5339 ) قال النبي :(@)(@@) | 30 ( إن الله حرم هاذا البيت يوم خلق السماوات والأرض PageV02P271 وصاغه حين صاغ الشمس والقمر وما حياله من السماء حرام ، وإنه لا يحل لأحد قبلي وإنما حل لي ساعة من نهار ثم عاد كما كان ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5340 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حيث خلق الداء خلق الدواء فتداووا ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5341 ) قال النبي :(@)(@@) | 30 ( إن الله حين خلق الخلق كتب بيده على نفسه أن رحمتي تغلب غضبي ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5342 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حيي ستير يحب الحياء والستر ، فإذا اغتسل أحدكم فليستتر ) )(@)(@@) ( حم د ن ) عن يعلى بن أمية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5343 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حيي كريم يستحي إذا رفع الرجل إليه يديه أن يردهما صفرا خائبتين ) )(@)(@@) ( حم د ت ه ك ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5344 ) قال النبي :(@)(@@) | 30 ( إن الله ختم سورة البقرة بآيتين أعطانيهما من كنزه الذي تحت العرش فتعلموهن وعلموهن نساءكم وأبناءكم ، فإنها صلاة وقرآن ودعاء ) )(@)(@@) ( ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5345 ) قال النبي :(@)(@@) | 30 ( إن الله خلق آدم ثم أخذ الخلق من ظهره ، فقال : هاؤلاء في الجنة ولا أبالي ، وهاؤلاء في النار ولا أبالي ) )(@)(@@) ( حم ك ) عن عبد الرحمن بن قتادة السلمي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5346 ) قال النبي :(@)(@@) | 30 ( إن الله خلق آدم ثم مسح ظهره بيمينه فاستخرج منه ذرية فقال : خلقت هاؤلاء للجنة وبعمل أهل الجنة يعملون ، ثم مسح ظهره PageV02P272 فاستخرج منه ذرية فقال : خلقت هاؤلاء للنار وبعمل أهل النار يعملون ، إن الله إذا خلق العبد للجنة استعمله بعمل أهل الجنة حتى يموت على عمل من أعمال أهل الجنة فيدخله به الجنة ، وإذا خلق العبد للنار استعمله بعمل أهل النار 
ms573	 حتى يموت على عمل من أعمال أهل النار فيدخله به النار ) )(@)(@@) ( مالك حم د ت ك ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5347 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق آدم من طينة الجابية ، وعجنه بماء من ماء الجنة ) )(@)(@@) ( ابن مردويه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5348 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق آدم من قبضة قبضها من جميع الأرض ، فجاء بنو آدم على قدر الأرض ، جاء منهم الأحمر والأبيض والأسود وبين ذالك ، والسهل والحزن والخبيث والطيب وبين ذالك ) )(@)(@@) ( حم د ت ك هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5349 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الجنة بيضاء وأحب شيء إلى الله البياض ) )(@)(@@) ( البزار ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5350 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الجنة وخلق النار ، فخلق لهاذه أهلا ولهاذه أهلا ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5351 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الخلق حتى إذا فرغ من خلقه قامت الرحم ، فقال : مه ، قالت : هاذا مقام العائذ بك من القطيعة ، قال : نعم ، أما ترضين أن أصل من وصلك ، وأقطع من قطعك ؟ قالت : بلى يا رب ، قال : فذالك لك ) )(@)(@@) ( ق ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV02P273(@)(@@)(@@)(@@) $ ( 5352 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الخلق فجعلني في خير فرقهم وخير الفرقتين ، ثم تخير القبائل فجعلني في خير قبيلة ، ثم تخير البيوت فجعلني في خير بيوتهم ، فأنا خيرهم نفسا وخيرهم بيتا ) )(@)(@@) ( ت ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5353 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الداء والدواء فتداووا ولا تتداووا بحرام ) )(@)(@@) ( طب ) عن أم الدرداء رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5354 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الرحمة يوم خلقها مائة رحمة فأمسك عنده تسعا وتسعين رحمة وأرسل في خلقه كلهم رحمة واحدة ، فلو يعلم الكافر بكل الذي عند الله من الرحمة لم ييأس من الجنة ، ولو يعلم المؤمن بالذي عند الله من العذاب لم 
ms574	 يأمن من النار ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5355 ) قال النبي :(@)(@@) | 30 ( إن الله خلق خلقه فجعلهم فرقتين فجعلني في خير الفرقتين ، ثم جعلهم قبائل فجعلني في خيرهم قبيلة ، ثم جعلهم بيوتا فجعلني في خيرهم بيتا ، فأنا خيركم قبيلا وخيركم بيتا ) )(@)(@@) ( ك ) عن ربيعة بن الحارث رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5356 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق خلقه في ظلمة ، فألقى عليهم من نوره ، فمن أصابه من ذالك النور يومئذ اهتدى ، ومن أخطأه ضل ) )(@)(@@) ( حم ت ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5357 ) قال النبي :(@)(@@) | 30 ( إن الله خلق في الجنة ريحا بعد الريح بسبع سنين فمن دونها باب مغلق ، وإنما يأتيكم الروح من خلل ذالك الباب ، ولو فتح ذالك لأذرت ما بين السماء والأرض ، وهي عند الله الأذيب وعندكم الجنوب ) PageV02P274 )(@)(@@) ( ش ) و ابن راهويه والروياني ( هق ) والضياء عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5358 ) قال النبي :(@)(@@) | 30 ( إن الله خلق لوحا محفوظا من درة بيضاء ، صفحاتها من ياقوتة حمراء ، قلمه نور ، وكتابه نور ، لله في كل يوم ستون وثلاثمائة لحظة يخلق ويرزق ويميت ويحيي ، ويعز ويذل ويفعل ما يشاء ) )(@)(@@) ( طب ) و ابن مردويه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5359 ) قال النبي :(@)(@@) | 30 ( إن الله خلق مائة رحمة ، رحمة منها قسمها بين الخلائق ، وتسعة وتسعين إلى يوم القيامة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5360 ) قال النبي :(@)(@@) | 30 ( إن الله خلق مائة رحمة ، فبث بين خلقه رحمة واحدة فهم يتراحمون بها ، وادخر عنده لأوليائه تسعة وتسعين ) )(@)(@@) ( طب ) و ابن عساكر عن معاوية بن حيدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5361 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق يوم خلق السماوات والأرض مائة رحمة ، كل رحمة طباق ما بين السماء والأرض ، فجعل منها في الأرض رحمة فبها تعطف الوالدة على ولدها ، والوحح والطير بعضها على بعض ، وأخر تسعا وتسعين فإذا كان يوم القيامة أكملها بهاذه الرحمة ) )(@)(@@) ( حم م ) عن سل مان رضي الله عنه 
ms575	 ( حم ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5362 ) قال النبي :(@)(@@) | 30 ( إن الله زكى لكم صيد البحر ) )(@)(@@) ( طب هق ) عن عصمة بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5363 ) قال النبي :(@)(@@) | 30 ( إن الله رحيم حيي كريم يستحي من عبده أن يرفع إليه يديه ثم لا يضع فيهما خيرا ) )(@)(@@) ( ك ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5364 ) قال النبي :(@)(@@) | 30 ( إن الله رحيم يحب الرحيم يضع رحمته على كل رحيم ) )(@)(@@) ( ابن جرير ) عن أبي صالح الحنفي مرسلا ( ز ) .(@)(@@) PageV02P275(@)(@@)(@@)(@@) $ ( 5365 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى رضي لهاذه الأمة اليسر ، وكره لها العسر ) )(@)(@@) ( طب ) عن محجن بن الأدرع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5366 ) قال النبي :(@)(@@) | 30 ( إن الله رفيق يحب الرفق ويرضاه ويعين عليه ما لا يعين على العنف ، فإذا ركبتم هاذه الدواب العجم فنزلوها منازلها ، فإن أجدبت الأرض فانجوا عليها ، فإن الأرض تطوى بالليل ما لا تطوى بالنهار ، وإياكم والتعريس بالطريق فإنه طريق الدواب ومأوى الحيات ) )(@)(@@) ( طب ) عن معدان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5367 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى رفيق يحب الرفق ويعطي عليه ما لا يعطي على العنف ) )(@)(@@) ( خد د ) عن عبد الله بن مغفل ( ه حب ) عن أبي هريرة ( حم هب ) عن علي ( طب ) عن أبي أمامة ( البزار ) عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 5368 ) قال النبي :(@)(@@) | 30 ( إن الله زادكم صلاة فحافظوا عليها ، وهي الوتر ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5369 ) قال النبي :(@)(@@) | 30 ( إن الله زوى لي الأرض فرأيت مشارقها ومغاربها ، وإن ملك أمتي سيبلغ ما زوي لي منها ، وإني أعطيت الكنزين الأحمر والأبيض ، وإني سألت ربي لأمتي أن لا يهلكوا بسنة عامة ، ولا يسلط عليهم عدوا من سوى أنفسهم فيستبيح بيضتهم ، وإن ربي عز وجل قال : يا محمد إني إذا قضيت قضاء فإنه لا يرد ، وإني أعطيتك لامتك أن لا أهلكهم بسنة عامة ، وأن لا PageV02P276 أسلط عليهم عدوا من سوى أنفسهم يستبيح بيضتهم ولو اجتمع عليهم من بين أقطارها حتى يكون بعضهم يفني 
ms576	 بعضا ، وإنما أخاف على أمتي الأئمة المضلين ، وإذا وضع في أمتي السيف لم يرفع عنهم إلى يوم القيامة ، ولا تقوم الساعة حتى تلتحق قبائل من أمتي بالمشركين ، وحتى تعبد قبائل من أمتي الأوثان ، وإنه سيكون في أمتي كذابون ثلاثون كلهم يزعم أنه نبي ، وأنا خاتم النبيين لا نبي بعدي ، ولا تزال طائفة من أمتي على الحق ظاهرين لا يضرهم من خالفهم حتى يأتي أمر الله ) )(@)(@@) ( حم م د ت ه ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5370 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى زوجني في الجنة مريم بنت عمران ، وامرأة فرعون ، وأخت موسى ) )(@)(@@) ( طب ) عن سعد بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5371 ) قال النبي :(@)(@@) | 30 ( إن الله سائل كل راع استرعاه رعية قلت أو كثرت ، حتى يسأل الزوج عن زوجته ، والوالد عن ولده ، والرب عن خادمه : هل أقام فيهم أمر الله ) )(@)(@@) ( ابن عساكر ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5372 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى سائل كل راع عما استرعاه ، أحفظ ذالك أم ضيعه ؟ حتى يسأل الرجل عن أهل بيته ) )(@)(@@) ( ن حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5373 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى سمى المدينة طابة ) )(@)(@@) ( حم م ن ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5374 ) قال النبي :(@)(@@) | 30 ( إن الله سيخلص رجلا من أمتي على رؤوس الخلائق يوم القيامة فينشر عليه تسعة وتسعين سجلا ، كل سجل مثل مد البصر ، ثم يقول : أتنكر من هاذا شيئا ؟ أظلمك كتبتي الحافظون ؟ فيقول : لا يا رب ، فيقول : PageV02P277 أفلك عذر ؟ فيقول : لا يا رب ، فيقول : بلى إن لك عندنا حسنة ، وإنه لا ظلم عليك اليوم ، فتخرج بطاقة فيها : أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، فيقول : أحضر وزنك ، فيقول : يا رب ما هاذه البطاقة مع هاذه السجلات ؟ فيقال : فإنك لا تظلم ، فتوضع السجلات في كفة والبطاقة في كفة فطاشت السجلات ، وثقلت البطاقة ، ولا يثقل مع اسم الله تعالى شيء ) )(@)(@@) ( حم ت ك هب ) عن ابن عمرو 
ms577	 رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5375 ) قال النبي :(@)(@@) | 30 ( إن الله سيعز هاذا الدين بنصارى من ربيعة على شاطىء الفرات ) )(@)(@@) ( ع ) و الشاشي عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5376 ) قال النبي :(@)(@@) | 30 ( إن الله شفاني وليس برقيتكم ) )(@)(@@) ( ابن سعد تخ طب ) عن جبلة بن الأزرق رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5377 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى صانع كل صانع وصنعته ) )(@)(@@) ( خ ) في خلق أفعال العباد ( ك ) و البيهقي في الأسماء عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5378 ) قال النبي :(@)(@@) | 30 ( إن الله ضرب الدنيا لمطعم ابن آدم مثلا ، وضرب مطعم ابن آدم مثلا للدنيا ، وإن قزحه وملحه ) )(@)(@@) ( ابن المبارك هب ) عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5379 ) قال النبي :(@)(@@) | 30 ( إن الله ضرب لكم ابني آدم مثلا ، فخذوا خيرهما ودعوا شرهما ) )(@)(@@) ( ابن جرير ) عن الحسن مرسلا ، وعن بكر بن عبد الله مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 5380 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى طيب يحب الطيب ، نظيف يحب النطافة ، كريم يحب الكرم ، جواد يحب الجود ، فنظفوا أفنيتكم ولا تشبهوا باليهود ) PageV02P278 )(@)(@@) ( ت ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5381 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى عفو يحب العفو ) )(@)(@@) ( ك ) عن ابن مسعود ( عد ) عن عبد الله بن جعفر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5382 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى عند لسان كل قائل فليتق الله عبد ولينظر ما يقول ) )(@)(@@) ( حل ) عن ابن عمر ( الحكيم ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ 5383 قال النبي :(@)(@@) | 30 ( إن الله تعالى غيور يحب الغيور وإن عمر غيور ) )(@)(@@) ( رسته في الإيمان ) عن عبد الرحمن بن رافع مرسلا .(@)(@@)(@@)(@@) $ ( 5384 ) قال النبي :(@)(@@) | 30 ( إن الله فضلني على الأنبياء بأربع : أرسلني إلى الناس كافة ، وجعل الأرض كلها لي ولامتي طهورا ومسجدا ، فأينما أدرك رجل من أمتي الصلاة فعنده مسجده وعنده طهوره ، ونصرني بالرعب مسيرة شهر ، وأحل لي المغانم ) )(@)(@@) ( طب ) و الضياء عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5385 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قال : أنا خلقت الخير والشر ، فطوبى لمن قدرت على يده 
ms578	 الخير ، وويل لمن قدرت على يده الشر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5386 ) قال النبي :(@)(@@) | 30 ( إن الله قال : إنا أنزلنا المال لاقام الصلاة وإيتاء الزكاة ، ولو كان لابن آدم واد لأحب أن يكون له ثان ، ولو كان له واديان لأحب أن يكون لهما ثالث ، ولا يملا جوف ابن آدم إلا التراب ، ثم يتوب الله على من تاب ) )(@)(@@) ( حم طب ) عن أبي واقد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5387 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قال : لقد خلقت خلقا ألسنتهم أحلى من العسل ، وقلوبهم أمر من الصبر ، فبي حلفت لاتيحنهم فتنة تدع الحليم منهم PageV02P279 حيران ، فبي يغترون ؟ أم علي يجترئون ؟ ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5388 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قال : من عادى لي وليا فقد آذنته بالحرب ، وما تقرب إلي عبدي بشيء أحب إلي مما افترضته عليه ، وما يزال عبدي يتقرب إلي بالنوافل حتى أحبه ، فإذا أحببته كنت سمعه الذي يسمع به ، وبصره الذي يبصر به ، ويده التي يبطش بها ، ورجله التي يمشي بها ، وإن سألني لأعطينه ، وإن استعاذني لأعيذنه ، وما ترددت عن شيء أنا فاعله ترددي عن قبض نفس المؤمن يكره الموت وأنا أكره مساءته ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5389 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قبض أرواحكم حين شاء ، وردها عليكم حين شاء ، يا بلال قم فأذن في الناس بالصلاة ) )(@)(@@) ( حم خ د ن ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5390 ) قال النبي :(@)(@@) | 30 ( إن الله قبض قبضة فقال : هاذه إلى الجنة برحمتي ، وقبض قبضة فقال : هاذه إلى النار ولا أبالي ) )(@)(@@) ( ع ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5391 ) قال النبي :(@)(@@) | 30 ( إن الله قتل أبا جهل ، فالحمد لله صدق وعده ونصر دينه ) )(@)(@@) ( عق ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5392 ) قال النبي :(@)(@@) | 30 ( إن الله قد اتخذني خليلا ) )(@)(@@) ( ك ) عن جندب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5393 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد أجار أمتي أن تجتمع 
ms579	 على ضلالة ) )(@)(@@) ( ابن أبي عاصم ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5394 ) قال النبي :(@)(@@) | 30 ( إن الله قد أذهب عنكم عبية الجاهلية وفخرها PageV02P280 بالآباء ، مؤمن تقي ، وفاجر شقي ، أنتم بنو آدم ، وآدم من تراب ، ليدعن رجال فخرهم بأقوام إنما هم فحم من فحم جهنم ، أو ليكونن أهون على الله من الجعلان التي تدفع بأنفها النتن ) )(@)(@@) ( حم د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5395 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد أعطى كل ذي حق حقه فلا وصية لوارث ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5396 ) قال النبي :(@)(@@) | 30 ( إن الله قد أعطى كل ذي حق حقه ، فلا وصية لوارث ، الولد للفراش وللعاهر الحجر وحسابهم على الله ، ومن ادعى إلى غير أبيه ، أو انتمى إلى غير مواليه فعليه لعنة الله التابعة إلى يوم القيامة ، لا تنفق امرأة شيئا من بيت زوجها إلا باذن زوجها ، قيل : ولا الطعام ؟ قال : ذالك أفضل أموالنا ) )(@)(@@) ( حم ت ) عن أبي أمامة ، وروى ( د ه ) بعضه ( ز ) .(@)(@@)(@@)(@@) $ ( 5397 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد أمدكم بصلاة هي خير لكم من حمر النعم ، الوتر جعلها الله لكم فيما بين صلاة العشاء إلى أن يطلع الفجر ) )(@)(@@) ( حم د ت ه قط ك ) عن خارجة بن حذافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5398 ) قال النبي :(@)(@@) | 30 ( إن الله قد أمده لرؤيته ، فإن أغمي عليكم فأكملوا العدة ) )(@)(@@) ( حم م ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5399 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد أوقع أجره على قدر نيته ) )(@)(@@) ( مالك حم د ن ه حب ك ) عن جابر بن عتيك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5400 ) قال النبي :(@)(@@) | 30 ( إن الله قد جعل لجعفر جناحين مصرجين بالدم يطير بهما مع الملائكة ) )(@)(@@) ( قط في الأفراد ك ) عن البراء رضي الله عنه ( ز ) .(@)(@@) PageV02P281(@)(@@)(@@)(@@) $ ( 5401 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد حرم على النار من قال لا إلاه إلا الله يبتغي بذالك وجه الله ) )(@)(@@) ( ق ) عن عتبان بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5402 ) قال 
ms580	 النبي :(@)(@@) | 30 ( إن الله قد ذبح كل نون في البحر لبني آدم ) )(@)(@@) ( قط ) عن عبد الله بن سرجس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5403 ) قال النبي :(@)(@@) | 30 ( إن الله قد رفع لي الدنيا فأنا أنظر إليها وإلى ما هو كائن فيها إلى يوم القيامة كأنما أنظر إلى كفي هاذه ، جليان من الله جلاه لنبيه كما جلاه للنبيين من قبله ) )(@)(@@) ( طب حل ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5404 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم ، وإن الله يعطي الدنيا من يحب ومن لا يحب ، ولا يعطي الدين إلا من أحب ، فمن أعطاه الله الدين فقد أحبه ، والذي نفسي بيده ، لا يسلم عبد حتى يسلم قلبه ولسانه ، ولا يؤمن حتى يأمن جاره بوائقه ، غشمه وظلمه ، ولا يكسب عبد مالا من حرام فينفق منه فيبارك له فيه ، ولا يتصدق به فيقبل منه ، ولا يتركه خلف ظهره إلا كان زاده إلى النار ، إن الله لا يمحو السيىء بالسيىء ، ولاكن يمحو السيىء بالحسن ، إن الخبيث لا يمحو الخبيث ) )(@)(@@) ( حم ك هب طب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5405 ) قال النبي :(@)(@@) | 30 ( إن الله قسم لكل وارث نصيبه من الميراث ، ولا تجوز لوارث وصية ، الولد للفراش وللعاهر الحجر ، ومن ادعى إلى غير أبيه ، أو تولى غير مواليه رغبة عنهم فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ( حم ه ) عن عمرو بن خارجة رضي الله عنه ( ز ) .(@)(@@) PageV02P282(@)(@@)(@@)(@@) $ ( 5406 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كتب الإحسان على كل شيء ، فإذا قتلتم فأحسنوا القتلة ، وإذا ذبحتم فأاحسنوا الذبحة ، وليحد أحدكم شفرته وليرح ذبيحته ) )(@)(@@) ( ط حم و الدارمي م د ت ش هب ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5407 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كتب الحسنات والسيئات ثم بين ذالك ، فمن هم بحسنة فلم يعملها كتبها الله تعالى عنده حسنة كاملة ، فإن هم بها فعملها كتبها الله تعالى عنده عشر حسنات 