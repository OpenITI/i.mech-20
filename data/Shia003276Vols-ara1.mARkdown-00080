ms61	 م س.(@)(@@)(@@)(@@) $ 859 -(@)(@@) الحارث بن عبد الله الأعور الهمداني، عن علي، وابن مسعود، وعنه عمرو بن مرة، والشعبي، شيعي لين، / قال النسائي وغيره: ليس بالقوي، وقال ابن أبي داود: كان أفقه الناس، وأفرض الناس، 25 / ب وأحسب الناس، مات 65. 4.(@)(@@)(@@)(@@) $ 860 -(@)(@@) الحارث بن عبد الرحمن بن أبي ذباب الدوسي، عن ابن المسيب، وجماعة، وعنه محمد بن فليح، وأبو ضمرة. قال أبو حاتم: ليس بالقوي. م ت س ق.(@)(@@)(@@)(@@) $ 861 -(@)(@@) الحارث بن عبد الرحمن القرشي العامري، خال ابن أبي ذئب، عن أبي سلمة، وكريب، وعنه ابن أبي ذئب بس، صدوق صالح، توفي 129. 4.(@)(@@)(@@)(@@) $ 862 -(@)(@@) الحارث بن عبيد أبو قدامة الإيادي، بصري، عن أبي عمران الجوني، وعدة، وعنه يحيى بن يحيى، ومسدد، ليس بالقوي، وضعفه ابن معين. م د ت.(@)(@@)(@@)(@@) $ 863 -(@)(@@) الحارث بن عطية، عن هشام بن حسان، والأوزاعي، وعنه حاجب المنبجي، والحسن بن الصباح، ثقة زاهد. س. PageV01P303(@)(@@)(@@)(@@) $ 864 -(@)(@@) الحارث بن عمرو الباهلي، صحابي، عنه ابنه عبد الله، وحفيده زرارة بن كريم. د س.(@)(@@)(@@)(@@) $ 865 -(@)(@@) الحارث بن عمرو، صحابي، عنه ابن أخيه البراء، وقيل هو خاله. ق.(@)(@@)(@@)(@@) $ 866 -(@)(@@) الحارث بن عمرو، ابن أخ للمغيرة بن شعبة، عن أناس من حمص، عن معاذ، وعنه أبو عون الثقفي، في الاجتهاد، قال البخاري: لا يصح. د ت.(@)(@@)(@@)(@@) $ 867 -(@)(@@) الحارث بن عمران المدني، عن هشام بن عروة، وعدة، وعنه محمود بن غيلان، وعلي بن حرب، ضعفوه. ق.(@)(@@)(@@)(@@) $ 868 -(@)(@@) الحارث بن عمير البصري، بمكة، عن أبي طوالة، وأيوب، وعنه ابنه حمزة، ولوين، وأمم، وثقة.(@)(@@) ابن معين، وأبو حاتم، ووهاه ابن حبان، والحاكم. 4.(@)(@@)(@@)(@@) $ 869 -(@)(@@) الحارث بن فضيل الخطمي، عن محمود بن لبيد، وعدة، وعنه فليح، والداروردي، ثقة.(@)(@@) م د س ق.(@)(@@)(@@)(@@) $ 870 -(@)(@@) الحارث بن قيس الجعفي، عن علي، وابن مسعود، وعنه خيثمة بن عبد الرحمن، وجماعة، كان عابدا، صلى عليه أبو موسى. س.(@)(@@)(@@)(@@) $ 871 -(@)(@@) الحارث بن مالك بن البرصاء، صحابي، عنه الشعبي. ت.(@)(@@)(@@)(@@) $ 872 -(@)(@@) الحارث بن مخلد الزرقي، عن عمر، وأبي هريرة، وعنه بسر بن سعيد، وسهيل، صدوق. د س 
ms62	 ق. PageV01P304(@)(@@)(@@)(@@) $ 873 -(@)(@@) الحارث بن مرة اليمامي، عن عسل بن سفيان، وطائفة، وعنه أحمد، وعلي، صدوق. د.(@)(@@)(@@)(@@) $ 874 -(@)(@@) الحارث بن مسكين الفقيه، عن ابن عيينة، وابن وهب، وسأل الليث، وعنه أبو داود، والنسائي، وابن أبي داود، ثقة حجة، عاش 96 سنة مات 25. د س.(@)(@@)(@@)(@@) $ 875 -(@)(@@) الحارث بن منصور الزاهد، عن الثوري، وإسرائيل، وعنه يحيى بن جعفر والدقيقي، ثقة. د.(@)(@@)(@@)(@@) $ 876 -(@)(@@) الحارث بن نبهان الجرمي، عن أبي إسحاق، وعاصم، وعنه طالوت، والعيشي، وأمم، ضعفوه. ت ق.(@)(@@)(@@)(@@) $ 877 -(@)(@@) الحارث بن النعمان الليثي، عن سعيد بن جبير، وجماعة، وعنه سعيد بن عمارة، وثابت بن محمد الزاهد، قال أبو حاتم: ليس بالقوي. ت ق.(@)(@@)(@@)(@@) $ 878 -(@)(@@) الحارث بن نوفل بن الحارث بن عبد المطلب، له ولأبيه صحبة، وعنه ابنه عبد الله، وحفيده الحارث، وأبو مجلز، توفي زمن عثمان. س.(@)(@@)(@@)(@@) $ 879 -(@)(@@) الحارث بن هشام المخزومي. أخو أبي جهل، استشهد باليرموك، أو بعمواس، عنه ابنه عبد الرحمن. ق.(@)(@@)(@@)(@@) $ 880 -(@)(@@) الحارث بن وجيه الراسبي، عن مالك بن دينار، وعنه المقدمي، ونصر بن علي، ضعفوه. د ت ق. [26 / أ](@)(@@)(@@)(@@) $ 881 - الحارث بن يزيد الحضرمي، عن جبير بن نفير، وجماعة، وعنه الأوزاعي، والليث، وكان يصلي كل يوم ستمائة ركعة، توفي 130. م د س ق.(@)(@@)(@@)(@@) $ 882 -(@)(@@) الحارث بن يزيد العكلي الفقيه، عن الشعبي، وإبراهيم، وعنه مغيرة، وابن شبرمة، وأقرانه، مات شابا، وثقه ابن معين. خ س ق.(@)(@@)(@@)(@@) $ 883 -(@)(@@) الحارث بن يعقوب، مولى قيس بن سعدة بن عبادة، عن سهل بن سعد، و عبد الرحمن بن شماسة، وعنه ابنه عمرو، والليث، وبكر بن مضر، ثقة قانت محيي الليل. م ت س.(@)(@@)(@@)(@@) $ 884 -(@)(@@) الحارث، قيل له صحبة، عنه حبيب بن أبي سبيعة. س.(@)(@@)(@@)(@@) $ 885 -(@)(@@) حارثة بن أبي الرجال، له عن أبيه، وجدته عمرة، وعنه ابن نمير، ويعلى، وعدة، ضعفوه. ت ق. PageV01P305(@)(@@)(@@)(@@) $ 886 -(@)(@@) حارثة بن مضرب، عن عمر، وعلي، وابن مسعود، وعنه أبو إسحاق، وثقه ابن معين. 4.(@)(@@)(@@)(@@) $ 887 -(@)(@@) حارثة بن وهب الخزاعي، له صحبة، عنه معبد بن خالد، وأبو إسحاق. ع.(@)(@@)(@@)(@@) $ 888 -(@)(@@) حازم بن 
ms63	 حرملة الغفاري، له صحبة، عنه مولاه أبو زينب. ق.(@)(@@)(@@)(@@) $ 889 -(@)(@@) حاضر بن المهاجر، عن سليمان بن يسار، وعنه شعبة، لا يعرف. س ق.(@)(@@)(@@)(@@) $ 890 -(@)(@@) حامد بن عمر البكراوي، قاضي كرمان، عن بكار بن عبد العزيز بن أبي بكرة، وأبي عوانة، وعنه البخاري، ومسلم، والحسين القباني، توفي 233. خ م.(@)(@@)(@@)(@@) $ 891 -(@)(@@) حامد بن يحيى البلخي، عن أيوب بن النجار، وابن عيينة، وعنه أبو داود، والفريابي، والحسين التستري، ثقة، من أعلمهم بابن عيينة، مات 242. د.(@)(@@)(@@)(@@) $ 892 -(@)(@@) حبان بن هلال، بصري، حافظ، عن معمر، وشعبة، وعنه الدارمي، وعبد، مات سنة 216. ع.(@)(@@)(@@)(@@) $ 893 -(@)(@@) حبان بن واسع بن حبان المازني، عن أبيه، وعنه عمرو بن الحارث، وابن لهيعة. م د ت.(@)(@@)(@@)(@@) $ 894 -(@)(@@) حبان بن جزء السلمي، عن أبيه، وأخيه خزيمة، - ولهما صحبة - وعنه عبد الله بن عثمان بن خثيم، وجماعة. ت ق.(@)(@@)(@@)(@@) $ 895 -(@)(@@) حبان بن زيد الشرعبي، عن عبد الله بن عمرو، وعنه حريز بن عثمان، شيخ. د. PageV01P306(@)(@@)(@@)(@@) $ 896 -(@)(@@) حبان بن عطية، صاحب علي، حكى عنه سعد بن عبيدة. خ.(@)(@@)(@@)(@@) $ 897 -(@)(@@) حبان بن علي العنزي، عن عبد الملك بن عمير، ومغيرة، وعنه لوين، وأبو الربيع الزهراني، فقيه صالح لين الحديث، توفي 171. ق.(@)(@@)(@@)(@@) $ 898 -(@)(@@) حبان بن موسى السلمي، المروزي، عن أبي حمزة السكري، وابن المبارك، وعنه البخاري، ومسلم، والحسن بن سفيان، والفريابي، ثقة، توفي 233. خ م ت س.(@)(@@)(@@)(@@) $ 899 -(@)(@@) حبان بن يسار الكلابي، عن بريد بن أبي مريم، وثابت البناني، وعنه حبان بن هلال، والتبوذكي، صويلح تغير حفظه. د.(@)(@@)(@@)(@@) $ 900 -(@)(@@) حبشي بن جنادة السلولي، له صحبة، عنه الشعبي، وأبو إسحاق، قال البخاري: إسناد حديثه فيه نظر. ت س ق.(@)(@@)(@@)(@@) $ 901 -(@)(@@) حبة بن خالد الأسدي، أخو سواء، صحابيان، عنهما سلام فقط. ق.(@)(@@)(@@)(@@) $ 902 -(@)(@@) حبيب بن أبي ثابت الأسدي، عن ابن عباس، وزيد بن أرقم، وعنه شعبة، وسفيان، وأمم، كان ثقة 26 / ب مجتهدا فقيها، مات 119. ع. PageV01P307(@)(@@)(@@)(@@) $ 903 -(@)(@@) حبيب بن أبي حبيب، عن أنس، وعنه خالد بن طهمان، وعمرو بن محمد العنقزي. ت.(@)(@@)(@@)(@@) $ 904 -(@)(@@) حبيب بن أبي حبيب: يزيد 
ms64	 الجرمي الأنماطي، عن الحسن، وجماعة، وعنه ابن مهدي، وسليمان ابن حرب، فيه لين، توفي 162. م س ق.(@)(@@)(@@)(@@) $ 905 -(@)(@@) حبيب بن أبي حبيب المصري، كاتب مالك، عنه، وعن أبي الغصن ثابت، وشبل بن عباد، وعنه أحمد بن الأزهر، ومقدام بن داود، كذبه أبو داود، مات 218. ق.(@)(@@)(@@)(@@) $ 906 -(@)(@@) حبيب بن الزبير بأصبهان، عن عكرمة، وعطاء، وعنه شعبة، وآخر، وثقه النسائي. ت.(@)(@@)(@@)(@@) $ 907 -(@)(@@) حبيب بن زيد، عن عباد بن تميم، وعنه شعبة، وشريك، ثقة. 4.(@)(@@)(@@)(@@) $ 908 -(@)(@@) حبيب بن سالم، عن مولاه النعمان بن بشير، وعنه قتادة، وأبو بشر، وجماعة، وثقه أبو حاتم، وقال البخاري: فيه نظر. م 4.(@)(@@)(@@)(@@) $ 909 -(@)(@@) حبيب بن سليم العبسي، عن الشعبي، وغيره، وعنه وكيع، ويحيى بن آدم، صالح الحديث. ت ق.(@)(@@)(@@)(@@) $ 910 -(@)(@@) حبيب بن الشهيد الأزدي، عن أبي مجلز، وابن سيرين، وعنه شعبة، والأنصاري، ثبت، توفي 145. ع.(@)(@@)(@@)(@@) $ 911 -(@)(@@) حبيب بن صالح الطائي، عن عبد الرحمن بن سابط، وراشد بن سعد، وعنه إسماعيل بن عياش، وبقية، توفي 147. د ت ق. PageV01P308(@)(@@)(@@)(@@) $ 912 -(@)(@@) حبيب بن عبد الله الأزدي، عن الحكم بن عمرو الغفاري، وعنه ابنه عبد الصمد. د.(@)(@@)(@@)(@@) $ 913 -(@)(@@) حبيب بن عبيد الرحبي، عن العرباض، وأبي أمامة، وعدة، وعنه ثور بن يزيد، ومعاوية بن صالح، قال: أدركت سبعين صحابيا، قال النسائي: ثقة. م 4.(@)(@@)(@@)(@@) $ 914 -(@)(@@) حبيب بن أبي عمرة القصاب، كوفي عن أم الدرداء، وسعيد بن جبير، وعنه شعبة، وابن فضيل، ثقة، توفي 142. خ م ت س ق.(@)(@@)(@@)(@@) $ 915 -(@)(@@) حبيب بن أبي فضلان، عن عمران بن حصين، وأنس وعنه سلام بن مسكين، وجماعة. د.(@)(@@)(@@)(@@) $ 916 -(@)(@@) حبيب بن أبي مرزوق، عن عروة، وعطاء، وعنه جعفر بن برقان، وأبو المليح، صدوق. ت س.(@)(@@)(@@)(@@) $ 917 -(@)(@@) حبيب بن مسلمة الفهري، مختلف في صحبته، وله عن أبي ذر، وعنه زياد بن جارية، وابن أبي مليكة، يقال: شهد اليرموك أميرا، مات 42. د ق.(@)(@@)(@@)(@@) $ 918 -(@)(@@) حبيب بن أبي مليكة أبو ثور النهدي، عن ابن عمر، وعنه هانئ بن قيس، وغيره، وثق. د.(@)(@@)(@@)(@@) $ 919 -(@)(@@) حبيب بن النعمان الأسدي، عن خريم، في الزور، قاله 
ms65	 سفيان العصفري، عن أبيه، عنه. د ق. PageV01P309(@)(@@)(@@)(@@) $ 920 -(@)(@@) حبيب بن يسار الكندي، عن زيد بن أرقم، وسويد بن غفلة، وعنه أبو الجارود زياد، ويوسف بن صهيب، ثقة. ت س.(@)(@@)(@@)(@@) $ 921 -(@)(@@) حبيب بن يساف، عن النعمان بن بشير، وعنه حبيب بن سالم، مجهول. س.(@)(@@)(@@)(@@) $ 922 -(@)(@@) حبيب الأعور، عن مولاه عروة، وأسماء بنت أبي بكر، وعنه الزهري، والضحاك بن عثمان. م د س.(@)(@@)(@@)(@@) $ 923 -(@)(@@) حبيب، عن أبيه، وعنه ولده هرماس، تميمي. د ق.(@)(@@)(@@)(@@) $ 924 -(@)(@@) حبيب المعلم، أبو محمد، عن الحسن، وعطاء، وعنه يزيد بن زريع، و عبد الوارث، صدوق. ع.(@)(@@)(@@)(@@) $ 925 -(@)(@@) حبيش بن شريح، عن عبادة بن الصامت، والأشعث بن قيس، وعنه إبراهيم بن أبي عبلة، وعلي بن أبي حملة. د.(@)(@@)(@@)(@@) $ 926 -(@)(@@) حبيش بن مبشر الثقفي الفقيه، طوسي نزل بغداد، عن يزيد بن هارون، والطبقة، وعنه ابن ماجة، وابن صاعد، ومحمد بن مخلد، ثقة، توفي 258. ق.(@)(@@)(@@)(@@) $ 927 -(@)(@@) حجاج بن إبراهيم الأزرق البغدادي، عن أبي عوانة، وإسماعيل بن جعفر، وعنه أبو حاتم، ومقدام الرعيني، وأهل مصر. د س. PageV01P310(@)(@@)(@@)(@@) $ 928 -(@)(@@) حجاج بن أرطاة الكوفي، أحد الأعلام، على لين فيه، عن عكرمة، وعطاء، وعنه شعبة، و عبد الرزاق، وخلق، قال الثوري: ما بقي أحد أعلم بما يقول منه. وقال حماد بن زيد: كان أفهم لحديثه من سفيان. وقال أحمد: كان من حفاظ الحديث. وقال القطان: هو وابن إسحاق عندي سواء، وقال أبو حاتم: صدوق يدلس فإذا قال " حدثنا ": فهو صالح. وقال النسائي: ليس بالقوي، مات 145.(@)(@@) م قرنه، 4.(@)(@@)(@@)(@@) $ 929 -(@)(@@) حجاج بن تميم، عن ميمون بن مهران، وعنه يوسف بن عدي، وسويد بن سعيد، [قال] النسائي:(@)(@@) ليس بثقة. ق.(@)(@@)(@@)(@@) $ 930 -(@)(@@) حجاج بن حجاج الأسلمي، عن أبيه، وأبي هريرة، وعنه عروة. د ت س. PageV01P311(@)(@@)(@@)(@@) $ * -(@)(@@) حجاج بن حجاج الأسلمي، عن أبيه، وعنه شعبة، لم يخرجوا له.(@)(@@)(@@)(@@) $ 931 -(@)(@@) حجاج بن حجاج الباهلي البصري الأحول، عن الفرزدق، وقتادة، وعدة، وعنه إبراهيم بن طهمان، ويزيد بن زريع، وثقوه، توفي 131، وله ألقاب: حجاج الأسود، والقسملي، وزق العسل، وقيل:(@)(@@) هما اثنان. خ م د 
ms66	 س ق.(@)(@@)(@@)(@@) $ 932 -(@)(@@) حجاج بن حسان الباهلي، عن أنس، وعكرمة، وعنه القطان، والتبوذكي، صدوق. د.(@)(@@)(@@)(@@) $ 933 -(@)(@@) حجاج بن دينار الواسطي، عن معاوية بن قرة، والحكم، وعنه شعبة، ويعلى بن عبيد، وعدة، صدوق. د ت ق.(@)(@@)(@@)(@@) $ 934 -(@)(@@) حجاج بن أبي زينب الواسطي، الصيقل، عن أبي عثمان النهدي، وأبي سفيان، وعنه ابن مهدي، ويزيد، ضعفه ابن المديني، ومشاه النسائي. م د س ق.(@)(@@)(@@)(@@) $ 935 -(@)(@@) حجاج بن شداد الصنعاني، عن أبي صالح سعيد الغفاري، وعنه حيوة، وابن لهيعة. د.(@)(@@)(@@)(@@) $ 936 -(@)(@@) حجاج بن عاصم المحاربي، قاضي الكوفة، عن أبي الأسود، وعنه شعبة. س.(@)(@@)(@@)(@@) $ 937 -(@)(@@) حجاج بن عبيد، أو ابن أبي عبد الله، عن رجل، وعنه ليث بن أبي سليم، مجهول. د ق. PageV01P312(@)(@@)(@@)(@@) $ 938 -(@)(@@) حجاج بن أبي عثمان الصواف البصري، عن الحسن، وعدة، وعنه القطان، وأبو عاصم، ثقة، توفي 143. ع.(@)(@@)(@@)(@@) $ 939 -(@)(@@) حجاج بن عمرو المازني، صحابي، عنه ابن أخيه ضمرة بن سعيد، وعكرمة. 4.(@)(@@)(@@)(@@) $ 940 -(@)(@@) حجاج بن فرافصة الباهلي العابد، عن ابن سيرين، وعطاء، وعنه سفيان، ومعتمر، قال أبو زرعة: 27 / ب ليس بالقوي. د س.(@)(@@)(@@)(@@) $ 941 -(@)(@@) حجاج بن مالك الأسلمي، له صحبة، عنه ابنه حجاج. د ت س.(@)(@@)(@@)(@@) $ 942 -(@)(@@) حجاج بن محمد الأعور، الحافظ، عن ابن جريج، وابن أبي ذئب، وشعبة، وعنه أحمد، والزعفراني، وهلال بن العلاء، قال أحمد: ما كان أضبطه وأشد تعاهده للحروف! ورفع من أمره جدا، وقال أبو داود: بلغني أن ابن معين كتب عنه نحوا من خمسين ألف حديث! توفي 206. ع.(@)(@@)(@@)(@@) $ 943 -(@)(@@) حجاج بن منهال الأنماطي البصري، عن قرة، وشعبة، وعنه البخاري، وعبد والكجي، كان دلالا ثقة ورعا ذا سنة وفضل، توفي 217. ع.(@)(@@)(@@)(@@) $ 944 -(@)(@@) حجاج بن نصير الفساطيطي، البصري، عن قرة، وفطر، وعنه الدارمي، والكجي، ضعفوه، وشذ ابن حبان فوثقه، مات 213. ت.(@)(@@)(@@)(@@) $ 945 -(@)(@@) حجاج بن يوسف الثقفي البغدادي، ابن الشاعر، حافظ رحال، سمع عبد الرزاق، وشبابة، وعنه مسلم، وأبو داود، والمحاملي، وابن أبي حاتم، مات 259. م د.(@)(@@)(@@)(@@) $ 946 -(@)(@@) الحجاج بن يوسف الظالم، قال الأعمش: سمعته يقول على المنبر: السورة التي ذكر 
ms67	 فيها البقرة أخرجه في الحج. خ. PageV01P313(@)(@@)(@@)(@@) $ 947 -(@)(@@) حجاج، عامل الربذة، عن أسيد بن أبي أسيد، وعنه حميد بن الأسود، وغيره. د.(@)(@@)(@@)(@@) $ 948 -(@)(@@) حجاج الضرير، عن عمرو بن عون، وعنه أبو داود، أو ابن الأعرابي، وهو الراجح. د.(@)(@@)(@@)(@@) $ 949 -(@)(@@) حجر بن حجر، عن العرباض، وعنه خالد بن معدان. د.(@)(@@)(@@)(@@) $ 950 -(@)(@@) حجر بن العنبس، كوفي، عن علي، ووائل بن حجر، وعنه سلمة بن كهيل، وعلقمة بن مرثد، ثقة.(@)(@@) د ت.(@)(@@)(@@)(@@) $ 951 -(@)(@@) حجر بن قيس المدري، عن زيد، وابن عباس، وعنه طاوس، وآخر. د س ق.(@)(@@)(@@)(@@) $ 952 -(@)(@@) حجر العدوي، عن علي، وعنه رجل، لم يصح. ت.(@)(@@)(@@)(@@) $ 953 -(@)(@@) حجير بن الربيع أبو السوار العدوي، عن عمر، وعمران، وعنه أبو نعامة، وحميد بن هلال، صدوق. م.(@)(@@)(@@)(@@) $ 954 -(@)(@@) حجير بن عبد الله، عن ابن بريدة، وعنه دلهم بن صالح، صدوق. د ت ق. PageV01P314(@)(@@)(@@)(@@) $ 955 -(@)(@@) حجين بن المثنى اليمامي، عن ابن الماجشون، والليث، وعنه أحمد، وعباس الدوري، ثقة قاض، رئيس، توفي 205. سوى ق.(@)(@@)(@@)(@@) $ 956 -(@)(@@) حجية بن عدي الكندي، عن علي، وجابر، وعنه الحكم، وأبو إسحاق. 4.(@)(@@)(@@)(@@) $ 957 -(@)(@@) حدرد بن أبي حدرد أبو خراش الأسلمي، صحابي، عنه عمران بن أبي أنس، في الهجران. د.(@)(@@)(@@)(@@) $ 958 -(@)(@@) حدير بن كريب أبو الزاهرية الحمصي، عن أبي عنبة الخولاني، وابن بسر، وجبير بن نفير، وعنه ابنه حميد، ومعاوية بن صالح، وعدة، ثقة، توفي سنة 129. م د س ق.(@)(@@)(@@)(@@) $ 959 -(@)(@@) حذيفة بن أسيد أبو سريحة الغفاري، شهد الحديبية، عنه الشعبي، وأبو الطفيل، والربيع بن عميلة.(@)(@@) م 4.(@)(@@)(@@)(@@) $ 960 -(@)(@@) حذيفة بن أبي حذيفة، عن صفوان بن عسال، وعنه الوليد بن عقبة. ق.(@)(@@)(@@)(@@) $ 961 -(@)(@@) حذيفة بن اليمان: حسل بن جابر العبسي، ثم الأشهلي حليفهم، صاحب السر، منعه وأباه شهود بدر استحلاف المشركين لهما، روى عنه الأسود، وربعي بن حراش، وأبو إدريس، وطائفة، توفي 36. ع.(@)(@@)(@@)(@@) $ 962 -(@)(@@) حذيفة البارقي، عن جنادة الأزدي، وعنه مرثد اليزني، وغيره. س. PageV01P315(@)(@@)(@@)(@@) $ 963 -(@)(@@) حذيم بن عمرو السعدي، صحابي، عنه ابنه زياد. س.(@)(@@)(@@)(@@) $ 964 -(@)(@@) الحر بن الصياح النخعي، عن ابن عمر، وعدة، وعنه شعبة، وشريك، 
ms68	 ثقة. د ت س.(@)(@@)(@@)(@@) $ 965 -(@)(@@) حر بن مالك العنبري البصري، أبو سهل، عن مالك بن مغول، وشعبة، وعنه أبو حاتم، وابن واره. ق.(@)(@@)(@@)(@@) $ 966 -(@)(@@) حر بن مسكين، هو أبو مسكين، في الكنى، يروي عن إبراهيم النخعي، وعنه أبو عوانة، وغيره. س.(@)(@@)(@@)(@@) $ 967 -(@)(@@) حرام بن حكيم الدمشقي، عن عمه، وأبي هريرة، وعنه ابن زبر، وزيد بن واقد، وعدة، ثقة. 4.(@)(@@)(@@)(@@) $ 968 -(@)(@@) حرام بن سعد بن محيصة، عن أبيه، والبراء، وعنه الزهري، ثقة، توفي 113. 4.(@)(@@)(@@)(@@) $ 969 -(@)(@@) حرب بن شداد أبو الخطاب، عن الحسن، وشهر، وعنه ابن مهدي، وعمرو بن مرزوق، وثقه أحمد، توفي 161. خ م د ت س.(@)(@@)(@@)(@@) $ 970 -(@)(@@) حرب بن أبي العالية أبو معاذ، عن الحسن، وأبي الزبير، وعنه قتيبة، ولوين، وعدة، اختلف قول ابن معين فيه، توفي قبيل مالك. م س. PageV01P316(@)(@@)(@@)(@@) $ 971 -(@)(@@) حرب بن عبيد الله بن عمير الثقفي، عن جده، وعنه عطاء بن السائب. د.(@)(@@)(@@)(@@) $ 972 -(@)(@@) حرب بن ميمون أبو الخطاب، عن مولاه النضر بن أنس، وعطاء، وأيوب، وعنه بدل، و عبد الله بن رجاء، ثقة، مات في حدود الستين ومائة. م ت.(@)(@@)(@@)(@@) $ * -(@)(@@) وحرب بن ميمون صاحب الأغمية، أصغر منه، وفيه ضعف.(@)(@@)(@@)(@@) $ 973 -(@)(@@) حرب بن وحشي بن حرب، عن أبيه، وعنه ابنه وحشي. د ق.(@)(@@)(@@)(@@) $ 974 -(@)(@@) حرملة بن إياس، ويقال إياس بن حرملة، عن أبي قتادة، وعنه مجاهد، وغيره. س.(@)(@@)(@@)(@@) $ 975 -(@)(@@) حرملة بن عبد العزيز بن سبرة بن معبد، عن أبيه، وعمه، وعنه دحيم، والحميدي، وعدة، صدوق. ت.(@)(@@)(@@)(@@) $ 976 -(@)(@@) حرملة بن عمران التجيبي، عن أبي يونس مولى أبي هريرة، و عبد الرحمن، وعنه ابن وهب، والمقرئ، وأبو صالح، ثقة. م د س ق.(@)(@@)(@@)(@@) $ 977 -(@)(@@) حرملة بن يحيى بن عبد الله بن حرملة بن عمران التجيبي، الفقيه تلميذ الشافعي، وراوية ابن وهب، عنه مسلم، وحفيده أحمد بن طاهر، وابن قتيبة العسقلاني، والحسن بن سفيان، صدوق من أوعية العلم، وقال أبو حاتم: لا يحتج به. مات 243، وعاش 77. م س ق.(@)(@@)(@@)(@@) $ 978 -(@)(@@) حرملة مولى أسامة، شيخ الزهري. خ.(@)(@@)(@@)(@@) $ 979 -(@)(@@) حرمي بن حفص القسملي، عن 
ms69	 أبان، ووهيب، وعنه البخاري، والحربي، والكجي، ثقة، توفي 223. خ د س. PageV01P317(@)(@@)(@@)(@@) $ 980 -(@)(@@) حرمي بن عمارة بن أبي حفصة نابت - ويقال: ثابت - العتكي مولاهم، عن هشام بن حسان، وأبي خلدة، وعنه بندار، وهارون الحمال، ثقة، توفي 201. خ م د س ق.(@)(@@)(@@)(@@) $ 981 -(@)(@@) حريث بن الأبح، عن صحابية، وعنه حبيب بن عبيد. د.(@)(@@)(@@)(@@) $ 982 -(@)(@@) حريث بن السائب، عن الحسن، وأبي نضرة، وعنه ابن مهدي، ومسلم، ثقة، قال أبو حاتم: ما به بأس. ت.(@)(@@)(@@)(@@) $ 983 -(@)(@@) حريث بن ظهير، عن ابن مسعود، وعمار، وعنه عمارة بن عمير. س.(@)(@@)(@@)(@@) $ 984 -(@)(@@) حريث بن أبي مطر الفزاري، الحناط، عن الشعبي وعدة، وعنه وكيع، وعبيد الله، ضعفوه. ت ق. PageV01P318(@)(@@)(@@)(@@) $ 985 -(@)(@@) حريث العذري، عن أبي هريرة، وعنه إسماعيل بن أمية. د ق.(@)(@@)(@@)(@@) $ 986 -(@)(@@) حريز بن عثمان الرحبي المشرقي الحمصي - ورحبة بطن من حمير - عن عبد الله بن بسر، وخالد بن معدان، وراشد بن سعد، وعنه يحيى الوحاظي، وعلي بن عياش، وعلي بن الجعد، ثقة، له نحو مائتي حديث، وهو ناصبي، مات 163. خ 4.(@)(@@)(@@)(@@) $ 987 -(@)(@@) حريز، ويقال أبو حريز، عن معاوية، وعنه عبد الله بن دينار الحمصي. ق.(@)(@@)(@@)(@@) $ 988 -(@)(@@) حريز، أو أبو حريز، عن ابن عمر، وعنه ابن جريج. د.(@)(@@)(@@)(@@) $ 989 -(@)(@@) حريش بن الخريت، أخو الزبير، بصري واه، عن أخيه، وابن أبي مليكة، وعنه حرمي بن عمارة، ومسلم. ق.(@)(@@)(@@)(@@) $ 990 -(@)(@@) حريش بن سليم الكوفي، عن طلحة بن مصرف، وحبيب بن أبي ثابت، وعنه أبو داود، ومحمد بن الصلت، وثق، وقال ابن معين: ليس بشئ. د س.(@)(@@)(@@)(@@) $ 991 -(@)(@@) حزام بن حكيم بن حزام، عن أبيه، وعنه عطاء، وزيد بن رفيع. س.(@)(@@)(@@)(@@) $ 992 -(@)(@@) حزم بن أبي حزم: مهران القطعي، عن الحسن، ومعاوية بن قرة، وعنه أبو الوليد، ولوين، وأحمد ابن المقدام، ثقة، مسن، توفي 175. خ.(@)(@@)(@@)(@@) $ 993 -(@)(@@) حزم بن أبي كعب الأنصاري، له صحبة، عنه ولد جابر. د. PageV01P319(@)(@@)(@@)(@@) $ 994 -(@)(@@) حزن بن أبي وهب المخزومي، من الطلقاء، عنه ابنه المسيب، قتل يوم اليمامة. خ د.(@)(@@)(@@)(@@) $ 995 -(@)(@@) حسان بن إبراهيم الكرماني، العنزي، قاضي كرمان، عن إبراهيم 
ms70	 الصائغ، وسعيد بن مسروق، وعاصم الأحول، وعنه علي بن حجر، وابن المديني، ثقة، قال النسائي: ليس بالقوي، توفي 182 وله مائة. خ م د.(@)(@@)(@@)(@@) $ 996 -(@)(@@) حسان بن أبي الأشرس، عن شريح، وسعيد بن جبير، وعنه منصور، والأعمش، ثقة. س.(@)(@@)(@@)(@@) $ 997 -(@)(@@) حسان بن بلال المزني، عن عمار، وحكيم بن حزام، وعنه قتادة، ويحيى بن أبي كثير، ثقة.(@)(@@) ت س ق.(@)(@@)(@@)(@@) $ 998 -(@)(@@) حسان بن ثابت بن المنذر النجاري، شاعر الإسلام، عنه ابنه عبد الرحمن، وابن المسيب، وأبو سلمة، قال ابن سعد: لم يشهد مشهدا، كان يجبن، وقال ابن الكلبي: كان لسنا شجاعا، أصابته علة فجبن، توفي 54. خ م د س ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) حسان بن حريث، أبو السوار، يأتي. [= 6669].(@)(@@)(@@)(@@) $ 999 -(@)(@@) حسان بن حسان البصري، بمكة، عن شعبة، وهمام، وعنه البخاري، وأبو زرعة، قال أبو حاتم:(@)(@@) منكر الحديث. وقال البخاري: كان المقرئ يثني عليه، مات 213. خ.(@)(@@)(@@)(@@) $ 1000 -(@)(@@) حسان بن أبي سنان البصري، عابد عن الحسن، وعنه جعفر بن سليمان، وغيره، له مناقب. خت.(@)(@@)(@@)(@@) $ 1001 -(@)(@@) حسان بن الضمري، عن عبد الله بن السعدي، وعنه أبو إدريس الخولاني. س.(@)(@@)(@@)(@@) $ 1002 -(@)(@@) حسان بن عبد الله الواسطي، بمصر، عن الليث، ومفضل بن فضالة، وعنه البخاري، والفسوي، ثقة، توفي 222. خ س ق.(@)(@@)(@@)(@@) $ 1003 -(@)(@@) حسان بن عبد الله المصري، عن سعيد بن أبي هلال، وعنه ضمام، وابن لهيعة. س.(@)(@@)(@@)(@@) $ 1004 -(@)(@@) حسان بن عطية أبو بكر المحاربي، عن أبي أمامة، وابن المسيب، وعنه الأوزاعي، وأبو غسان محمد بن مطرف، ثقة عابد نبيل، لكنه قدري. ع. PageV01P320(@)(@@)(@@)(@@) $ 1005 -(@)(@@) حسان بن نوح النصري، حمصي، عن أبي أمامة، وابن بسر، وعنه الوليد بن مسلم، وعلي بن عياش، صدوق. س.(@)(@@)(@@)(@@) $ 1006 -(@)(@@) حسان بن أبي وجزة، عن عبد الله بن عمرو، وعنه مجاهد، ويعلى بن عطاء. س.(@)(@@)(@@)(@@) $ 1007 -(@)(@@) حسان، عن وائل بن مهانة، وعنه ذر. س.(@)(@@)(@@)(@@) $ 1008 -(@)(@@) الحسن بن أحمد بن حبيب، عن مسدد، وطبقته، وعنه النسائي، والطبراني، صدوق، مات 291.(@)(@@) س.(@)(@@)(@@)(@@) $ 1009 -(@)(@@) الحسن بن أحمد بن أبي شعيب الحراني، عن جده، ومحمد بن سلمة، وعنه مسلم، والترمذي، وابنه 
ms71	 أبو شعيب، والمحاملي، ثقة، توفي 25. م ت.(@)(@@)(@@)(@@) $ 1010 -(@)(@@) الحسن بن أسامة بن زيد الكلبي، النبوي، عن أبيه، وعنه ابناه، محمد وزيد، وغيرهما، لم يصح خبره. ت.(@)(@@)(@@)(@@) $ 1011 -(@)(@@) الحسن بن إسحاق بن زياد، أبو علي الليثي، المروزي، الشاعر، عن روح، وطبقته، وعنه البخاري، والنسائي، وعبدان، توفي 241. خ س.(@)(@@)(@@)(@@) $ 1012 -(@)(@@) الحسن بن إسماعيل الكلبي المصيصي، عن إبراهيم بن سعد، وهشيم، وعنه النسائي، وأبو حامد الحضرمي، ثقة. س.(@)(@@)(@@)(@@) $ 1013 -(@)(@@) الحسن بن بشر البجلي، الكوفي، عن أسباط بن نصر، وأبي إسرائيل الملائي، وعنه البخاري، والحربي، وعلي البغوي، قال أبو حاتم: صدوق، توفي 221. خ ت س.(@)(@@)(@@)(@@) $ 1014 -(@)(@@) الحسن بن بكر المروزي، عن يزيد بن هارون، وطبقته، وعنه الترمذي، وجماعة. ت.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن بن التل، غلط بل هو: عمر بن محمد [= 4107]. PageV01P321(@)(@@)(@@)(@@) $ 1015 -(@)(@@) الحسن بن ثوبان الهوزني، المصري، عن أبيه، وعكرمة، وعنه الليث، وضمام، قال أبو حاتم: لا بأس به، توفي 145. عالم عابد فاضل. ق.(@)(@@)(@@)(@@) $ 1016 -(@)(@@) الحسن بن جابر، حمصي، عن معاوية، وأبي أمامة، وعنه الزبيدي، ومعاوية بن صالح. ت ق.(@)(@@)(@@)(@@) $ 1017 -(@)(@@) الحسن بن أبي جعفر الجفري، عن نافع، وأبي الزبير، وعنه ابن مهدي، ومسلم، والحوضي، صالح خير، ضعفوه. توفي 167. ت ق.(@)(@@)(@@)(@@) $ 1018 -(@)(@@) الحسن بن حبيب البصري الكوسج، عن هشام بن عروة، وراشد الحمامي، وعنه الفلاس، وأحمد الدورقي، ثقة، توفي 197. س.(@)(@@)(@@)(@@) $ 1019 -(@)(@@) الحسن بن الحر بن الحكم النخعي، ويقال الجعفي، نزيل دمشق، عن خاله عبدة بن أبي لبابة، وأبي الطفيل، وعنه ابن أخته حسين الجعفي، وحميد بن عبد الرحمن الرؤاسي، ثقة نبيل، توفي 133. د س.(@)(@@)(@@)(@@) $ 1020 -(@)(@@) الحسن بن الحسن بن الحسن بن علي بن أبي طالب، عن أبويه، وعنه فضيل بن مرزوق، وعمرو ابن شبيب، مات في السجن مع أخيه عبد الله 145. ق.(@)(@@)(@@)(@@) $ 1021 -(@)(@@) الحسن بن الحسن بن علي، عن أبيه، و عبد الله بن جعفر، وعنه بنوه، وأبو بكر بن حفص الزهري، توفي 97. س.(@)(@@)(@@)(@@) $ 1022 -(@)(@@) الحسن بن أبي الحسن البصري، الإمام، أبو سعيد، مولى زيد بن ثابت، وقيل مولى جميل بن PageV01P322(@)(@@) قطبة، وقيل غير ذلك، وأبوه يسار، 
ms72	 من سبي ميسان، أعتقته الربيع بنت النضر، ولد الحسن زمن عمر، وسمع عثمان، وشهد الدار ابن أربع عشرة سنة، وروى عن عمران بن حصين، وأبي موسى، وابن عباس، وجندب، وعنه ابن عون، ويونس، وأمم، كان كبير الشأن، رفيع الذكر، رأسا في العلم والعمل، مات في رجب سنة عشرة ومائة. ع.(@)(@@)(@@)(@@) $ 1023 -(@)(@@) الحسن بن الحكم النخعي، الكوفي، عن الشعبي، وإبراهيم، وعنه الخريبي، وأبو أسامة، قال أبو حاتم: صالح الحديث. د ت ق.(@)(@@)(@@)(@@) $ 1024 -(@)(@@) الحسن بن حماد بن كسيب، أبو علي الحضرمي، سجادة، عن أبي خالد الأحمر، وابن المبارك، والمحاربي، وعنه أبو داود، وابن ماجة، وأبو يعلى، وابن صاعد، ثقة صاحب سنة، توفي 241.(@)(@@) د س ق.(@)(@@)(@@)(@@) $ 1025 -(@)(@@) الحسن بن حماد الضبي الكوفي، عن المطلب بن زياد، والمحاربي، وعنه أبو يعلى، والسراج.(@)(@@) والنسائي بواسطة، ثقة، توفي 238. س.(@)(@@)(@@)(@@) $ 1026 -(@)(@@) الحسن بن خلف بن شاذان الواسطي، عن القطان، وأبي معاوية، وعنه البخاري، والمحاملي، وعدة، صدوق، توفي 246. خ.(@)(@@)(@@)(@@) $ 1027 -(@)(@@) الحسن بن داود المنكدري، عن معتمر، وابن عيينة، وعنه النسائي، وابن ماجة، وابن صاعد، قال البخاري: يتكلمون فيه، ومشاه ابن عدي، توفي 247. س ق.(@)(@@)(@@)(@@) $ 1028 -(@)(@@) الحسن بن ذكوان البصري، عن طاوس، والحسن، وعنه يحيى القطان، والخفاف، قال النسائي، ليس بالقوي. خ د ت ق.(@)(@@)(@@)(@@) $ 1029 -(@)(@@) الحسن بن الربيع البجلي البوراني، الخشاب، عن مهدي بن ميمون، وقيس بن الربيع، وعنه PageV01P324(@)(@@) البخاري، ومسلم، وأبو داود، وعلي البغوي، قال أبو حاتم: من أوثق أصحاب بن إدريس، توفي 221. ع.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن بن أبي الربيع: يحيى [= 1071].(@)(@@)(@@)(@@) $ 1030 -(@)(@@) الحسن بن زيد بن الحسن بن علي، عن أبيه، وعكرمة، وعنه مالك، وزيد بن الحباب، ضعفه ابن معين، ولي المدينة، وهو والد السيدة نفيسة، توفي 168. س.(@)(@@)(@@)(@@) $ 1031 -(@)(@@) الحسن بن سعد، عن ابن عباس، وعدة، وعنه أبو إسحاق الشيباني، والمسعودي، وثقه النسائي.(@)(@@) م د س ق.(@)(@@)(@@)(@@) $ 1032 -(@)(@@) الحسن بن سلم العجلي، عن ثابت، وعنه محمد بن موسى الحرشي فقط. ت.(@)(@@)(@@)(@@) $ 1033 -(@)(@@) الحسن بن سهيل بن عبد الرحمن بن عوف، عن ابن عمر، وعنه يزيد بن أبي زياد، 
ms73	 وثق. ق.(@)(@@)(@@)(@@) $ 1034 -(@)(@@) الحسن بن سوار أبو العلاء البغوي، عن عكرمة بن عمار، والماجشون، وعنه أحمد، وأبو حاتم وصدقه، توفي 216. د ت س.(@)(@@)(@@)(@@) $ 1035 -(@)(@@) الحسن بن شجاع البلخي الحافظ، عن عبيد الله بن موسى، وأبي مسهر، وعنه أبو العباس PageV01P325(@)(@@) السراج، والبخاري، وقال في " الصحيح " حدثنا الحسن، حدثنا إسماعيل بن الخليل، فقيل: هو هو، ينظر بالبخاري، عاش 49 سنة، ومات 244. ت.(@)(@@)(@@)(@@) $ 1036 -(@)(@@) الحسن بن شوكر البغدادي، عن إسماعيل بن جعفر، وهشيم، وعنه أبو داود، والهيثم بن خلف، ثقة. د.(@)(@@)(@@)(@@) $ 1037 -(@)(@@) الحسن بن صالح بن صالح بن حي الهمداني، الفقيه، أبو عبد الله، أحد الأعلام، عن سماك، وعمرو بن دينار، وقيس بن مسلم، وعنه يحيى بن آدم، وأحمد بن يونس، وعلي بن الجعد، صدوق عابد متشيع، توفي 169. م 4.(@)(@@)(@@)(@@) $ 1038 -(@)(@@) الحسن بن الصباح الواسطي، ثم البغدادي، البزار، أحد الأعلام، عن ابن عيينة، ومعن، وعنه البخاري، وأبو داود، والترمذي، والمحاملي، وأمم، قال أحمد: ثقة صاحب سنة، وقال أبو حاتم:(@)(@@) صدوق له جلالة عجيبة ببغداد، مات 249. خ د ت.(@)(@@)(@@)(@@) $ 1039 -(@)(@@) الحسن بن عبد الله العرني الكوفي، عن ابن عباس، وعلقمة، وعنه الحكم، وسلمة بن كهيل، ثقة. خ م د س ق.(@)(@@)(@@)(@@) $ 1040 -(@)(@@) الحسن بن عبد العزيز الجذامي المصري الجروي، وهي من قرى تنيس، سمع عمرو بن أبي PageV01P326(@)(@@) سلمة، وبشر بن بكر، وعنه البخاري، والمحاملي، وابن أبي حاتم، قال الدارقطني: لم ير مثله فضلا وزهدا، توفي 257. خ.(@)(@@)(@@)(@@) $ 1041 -(@)(@@) الحسن بن عبيد الله أبو عروة النخعي، عن أبي وائل، وإبراهيم، وعنه شعبة، وزائدة، وابن فضيل، ثقة، توفي 139. م 4.(@)(@@)(@@)(@@) $ 1042 -(@)(@@) الحسن بن عرفة العبدي المؤدب، عن إسماعيل بن عياش، وابن المبارك، وعنه الترمذي، وابن ماجة، وابن أبي حاتم، والصفار، وثقه ابن معين، وعاش مائة وسبع سنين، توفي 257. ت ق.(@)(@@)(@@)(@@) $ 1043 -(@)(@@) الحسن بن عطية العوفي، عن أبيه، وجده سعد، وعنه ابناه: حسين ومحمد، وحكام بن سلم، ضعفه أبو حاتم. د.(@)(@@)(@@)(@@) $ 1044 -(@)(@@) الحسن بن عطية بن نجيح القرشي، البزاز، عن حمزة، وإسرائيل، وعنه أبو زرعة، وأبو حاتم - وقال: صدوق - والبخاري 
ms74	 في " تاريخه " ت.(@)(@@)(@@)(@@) $ 1045 -(@)(@@) الحسن بن علي بن راشد الواسطي، عن أبي الأحوص، وهشيم، وعنه أبو داود، والساجي، صدوق، وثقه بحشل، توفي 237. د.(@)(@@)(@@)(@@) $ 1046 -(@)(@@) الحسن بن علي بن أبي رافع، عن جده، وعنه بكير بن الأشج، والضحاك بن عثمان، ثقة. د س. PageV01P327(@)(@@)(@@)(@@) $ 1047 -(@)(@@) الحسن بن علي بن أبي طالب، السيد، أبو محمد الهاشمي، سبط رسول الله صلى الله عليه وسلم، عنه ابنه الحسن، وأبو الحوراء ربيعة، وعكرمة، وكان أشبه الناس وجها برسول الله صلى الله عليه وسلم، مات سنة 50. 4.(@)(@@)(@@)(@@) $ 1048 -(@)(@@) الحسن بن علي بن عفان، عن أسباط بن نمير، وعنه ابن ماجة، والصفار، وابن الزبير القرشي، قال أبو حاتم: صدوق، توفي 27. ق.(@)(@@)(@@)(@@) $ 1049 -(@)(@@) الحسن بن علي الهذلي، الحلواني الخلال، الحافظ، نزيل مكة، عن أبي معاوية، ووكيع، وعنه البخاري، ومسلم، وأبو داود، والترمذي، وابن ماجة، والسراج، ثبت حجة، توفي 242.(@)(@@) خ م د ت ق.(@)(@@)(@@)(@@) $ 1050 -(@)(@@) الحسن بن علي النوفلي، عن الأعرج، وعنه سلم بن قتيبة، قال البخاري: منكر الحديث. ت ق.(@)(@@)(@@)(@@) $ 1051 -(@)(@@) الحسن بن عمارة أبو محمد الكوفي الفقيه، عن ابن أبي مليكة، والحكم، وعنه شبابة، و عبد الرزاق، ضعفوه، ولي قضاء بغداد للمنصور، ومات 153. ت ق.(@)(@@)(@@)(@@) $ 1052 -(@)(@@) الحسن بن عمر بن شقيق الجرمي التاجر، بالري، عن حماد بن زيد، وذويه، وعنه البخاري، والفريابي، وأبو يعلى، وثق. خ.(@)(@@)(@@)(@@) $ 1053 -(@)(@@) الحسن بن عمر أبو المليح الرقي، عن ميمون بن مهران، وعطاء، وعنه النفيلي، وداود بن رشيد، وثقه أحمد، وأبو زرعة، توفي عن تسعين سنة في 181. د ق.(@)(@@)(@@)(@@) $ 1054 -(@)(@@) الحسن بن عمرو الفقيمي، الكوفي، عن إبراهيم، ومجاهد، وعنه ابن المبارك، وابن فضيل، ثقة، توفي 142. خ د س ق.(@)(@@)(@@)(@@) $ 1055 -(@)(@@) الحسن بن عمرو السدوسي، عن هشيم، وجرير، وعنه أبو داود، وعثمان الدارمي، توفي 224.(@)(@@) د. PageV01P328(@)(@@)(@@)(@@) $ 1056 -(@)(@@) الحسن بن عمران العسقلاني، عن مكحول، وعمر بن عبد العزيز، وعنه شعبة، وقرأ عليه القرآن سويد بن عبد العزيز. د.(@)(@@)(@@)(@@) $ 1057 -(@)(@@) الحسن بن عياش، أخو أبي بكر، عن مغيرة، والأعمش، وعنه ابن مهدي، ويحيى بن آدم، وثقه ابن معين، 
ms75	 مات 172. م ت س.(@)(@@)(@@)(@@) $ 1058 -(@)(@@) الحسن بن عيسى بن ماسرجس النيسابوري، عن مولاه ابن المبارك، وأبي الأحوص، وعنه مسلم، وأبو داود، والبغوي، وابن صاعد، ثقة ورع، أسلم شابا على يد ابن المبارك، واشتغل، توفي 24 .(@)(@@) م د س.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن بن عيسى، عن عفان، بل هو: الحسين. [1102].(@)(@@)(@@)(@@) $ 1059 -(@)(@@) الحسن بن فرات التميمي، القزاز، الكوفي، عن ابن أبي مليكة، وعدة، وعنه ابنه زياد، وأبو نعيم، ثقة. م ت ق.(@)(@@)(@@)(@@) $ 1060 -(@)(@@) الحسن بن قزعة الهاشمي البصري الخلقاني، عن فضيل، ومعتمر، وعنه الترمذي، والنسائي، وابن ماجة، والساجي، ثقة. ت س ق.(@)(@@)(@@)(@@) $ 1061 -(@)(@@) الحسن بن محمد بن أعين الحراني، عن عمه موسى، ومعقل بن عبيد الله، وعنه سلمة بن شبيب، وأحمد الرهاوي، ثقة، توفي 21. خ م س.(@)(@@)(@@)(@@) $ 1062 -(@)(@@) الحسن بن محمد بن الصباح الزعفراني، الفقيه، سمع ابن عيينة، وعبيدة، والشافعي، وعنه البخاري، والأربعة، وابن الأعرابي، وثقه النسائي، مات 260 في رمضان. خ ع.(@)(@@)(@@)(@@) $ 1063 -(@)(@@) الحسن بن محمد بن عبيد الله بن أبي يزيد المكي، عن ابن جريج، وعنه محمد بن خنيس، غير حجة. ت ق.(@)(@@)(@@)(@@) $ 1064 -(@)(@@) الحسن بن محمد بن عثمان، عن الثوري، وعنه إسماعيل بن بهرام، وغيره. ق.(@)(@@)(@@)(@@) $ 1065 -(@)(@@) الحسن بن محمد ابن الحنفية، عن أبيه، وابن عباس، وعدة، وعنه الزهري، وموسى بن عبيدة، PageV01P329(@)(@@) وهو أول المرجئة، ألف في ذلك. قال عمرو بن دينار: أخبرنا الحسن بن محمد ولم أر أحدا قط أعلم منه، مات 95. ع.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن بن محمد البلخي، إنما هو: الحسين. [= 108].(@)(@@)(@@)(@@) $ 1066 -(@)(@@) الحسن بن مدرك الطحان، أبو علي البصري الحافظ، عن يحيى بن حماد، و عبد العزيز الأويسي، وعنه البخاري، والنسائي، وابن ماجة، وابن صاعد، وثق، وقال أبو داود: كذاب.(@)(@@) خ س ق.(@)(@@)(@@)(@@) $ 1067 -(@)(@@) الحسن بن مسلم بن يناق، عن صفية بنت شيبة، وطاوس، وعنه ابن جريج، وشبل بن عباد، ثقة، مات مع طاوس. خ م د س ق.(@)(@@)(@@)(@@) $ 1068 -(@)(@@) الحسن بن منصور أبو علوية البغدادي، ويقال الحسين، عن ابن عيينة، وطبقته، وعنه البخاري، والمحاملي، والجصاص، ثقة. خ.(@)(@@) 31 / أ (@)(@@)(@@)(@@) $ 1069 -(@)(@@) الحسن 
ms76	 بن موسى الأشيب، أبو علي البغدادي، قاضي حمص وطبرستان والموصل، عن ابن أبي ذئب، وشعبة، وعنه الصاغاني، وبشر بن موسى، ثقة، مات 209 بالري. ع.(@)(@@)(@@)(@@) $ 1070 -(@)(@@) الحسن بن واقع الرملي أبو علي، عن ضمرة، وأيوب بن سويد، وعنه سمويه، وابن واره، ثقة، توفي 22. ت.(@)(@@)(@@)(@@) $ 1071 -(@)(@@) الحسن بن أبي الربيع: يحيى الجرجاني أبو علي، محدث صدوق، سمع يزيد، و عبد الرزاق، وعنه ابن ماجة، والمحاملي، وابن عياش، توفي 263. ق.(@)(@@)(@@)(@@) $ 1072 -(@)(@@) الحسن بن يحيى الرزي أبو علي البصري، عن النضر بن شميل، ويعلى وعنه أبو داود، وابن صاعد، وأبو عروبة، ثقة يحفظ. د.(@)(@@)(@@)(@@) $ 1073 -(@)(@@) الحسن بن يحيى بخراسان، عن عكرمة، والضحاك، وعنه ابن المبارك، وثق. س.(@)(@@)(@@)(@@) $ 1074 -(@)(@@) الحسن بن يحيى الخشني البلاطي، عن هشام بن عروة، وزيد بن واقد، وعنه هشام بن عمار، والحكم بن موسى، وهاه جماعة، وقال دحيم وغيره: لا بأس به. ق. PageV01P330(@)(@@)(@@)(@@) $ 1075 -(@)(@@) الحسن بن يزيد بن فروخ أبو يونس القوي، بالكوفة، عن طاوس، وأبي سلمة، وعنه حسين الجعفي، وأبو عاصم، وثقه أحمد، وكان قويا على العبادة. ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن، حدثنا قرة بن حبيب، وعنه البخاري، يقال: الزعفراني (*) خ. [= 1062].(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن العرني، هو: ابن عبد الله. [= 1039].(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسن، عن ابن عباس، إنما هو: أبو الحسن. [= 6579].(@)(@@)(@@)(@@) $ 1076 -(@)(@@) الحسين بن إبراهيم أبو علي البغدادي، إشكاب، عن فليح، ومحمد بن راشد، وعنه ابناه: محمد، وعلي، وعباس الدوري، توفي 216. خ.(@)(@@)(@@)(@@) $ 1077 -(@)(@@) الحسين بن إسحاق، عن إسحاق الأزرق، وعنه النسائي. س.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن الأسود، هو: ابن علي. [= 1095].(@)(@@)(@@)(@@) $ 1078 -(@)(@@) الحسين بن بشير، عن أبيه، عن جابر، وعنه خارجة بن عبد الله، يجهل. س.(@)(@@)(@@)(@@) $ 1079 -(@)(@@) الحسين بن بيان البغدادي، عن زياد البكائي، وعنه ابن ماجة. ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن جعفر اثنان: ابن علي الأحمر (* *)، والحسين بن منصور. [= 1112]. PageV01P331(@)(@@)(@@)(@@) $ 1080 -(@)(@@) الحسين بن الجنيد القومسي، عن أبي أسامة، ويزيد، وعنه أبو داود، وابن ماجة. د ق (@)(@@)(@@)(@@) $ 1081 -(@)(@@) الحسين بن الحارث الجدلي الكوفي، عن ابن عمر، والنعمان بن بشير، وعنه يحيى بن أبي زائدة، وأبو مالك الأشجعي، وثق. د س.(@)(@@)(@@)(@@) $ 1082 -(@)(@@) الحسين بن حريث 
ms77	 أبو عمار الخزاعي المروزي، عن فضيل بن عياض، وابن المبارك، وعنه الجماعة سوى ابن ماجة، لكن أبو داود بالإجازة، وابن صاعد، و أبو حامد الحضرمي، ثقة، توفي 244. ع سوى ق.(@)(@@)(@@)(@@) $ 1083 -(@)(@@) الحسين بن الحسن المروزي، أبو عبد الله، بمكة، عن ابن المبارك، وهشيم، وعنه الترمذي، وابن ماجة وابن صاعد وإبراهيم الهاشمي ثقة عالم، توفي 246. ت ق.(@)(@@)(@@)(@@) $ 1084 -(@)(@@) الحسين بن الحسن البصري الغلابي، عن ابن عون، وغيره، وعنه أحمد، والزعفراني، ثقة، توفي 188. خ م س.(@)(@@)(@@)(@@) $ 1085 -(@)(@@) الحسين بن الحسن الفزاري الكوفي، الأشقر، عن زهير، وقيس بن الربيع، وعنه أحمد ، والكديمي، وعدة، واه، قال البخاري: فيه نظر، توفي 208. س.(@)(@@)(@@)(@@) $ 1086 -(@)(@@) الحسين بن حفص بن الفضل بن يحيى بن ذكوان الهمداني، أبو محمد الكوفي، قاضي أصبهان ورئيسها، عن الثوري، وابن أبي رواد، وعنه الفلاس، / وسمويه، وأسيد بن عاصم، قال أبو حاتم:(@)(@@) محله الصدق، توفي 212، قال أبو نعيم الحافظ، كان دخله في العام مائة ألف، فما وجبت عليه زكاة!. م ق.(@)(@@)(@@)(@@) $ 1087 -(@)(@@) الحسين بن ذكوان المعلم البصري، الثقة، عن ابن بريدة وعطاء، وعمرو بن شعيب، وعنه القطان، وغندر، ويزيد. ع. PageV01P332(@)(@@)(@@)(@@) $ 1088 -(@)(@@) الحسين بن زيد بن علي العلوي، عن أبيه، وعمومته: أبي جعفر، وعمر، و عبد الله، وأم علي، وعنه ابناه: إسماعيل، ويحيى، وأبو مصعب، وخلق، قال أبو حاتم: تعرف وتنكر، ومشاه ابن عدي. ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن أبي السري: متوكل. [= 1105].(@)(@@)(@@)(@@) $ 1089 -(@)(@@) الحسين بن سلمة الأزدي البصري، الطحان، عن ابن مهدي، وعنه الترمذي، وابن ماجة، وابن خزيمة، ثقة. ت ق.(@)(@@)(@@)(@@) $ 1090 -(@)(@@) الحسين بن شفي بن ماتع الأصبحي، عن أبيه، وتبيع الحميري، وعنه حيوة بن شريح، وعدة، توفي 129. د.(@)(@@)(@@)(@@) $ 1091 -(@)(@@) الحسين بن عبد الله بن عبيد الله بن عباس، عن ربيعة بن عباد، وكريب، وعنه ابن جريج، وسليمان ابن بلال، وابن المبارك، ضعفوه، توفي 141. ت ق.(@)(@@)(@@)(@@) $ 1092 -(@)(@@) الحسين بن عبد الرحمن الجرجرائي، عن الوليد بن مسلم، ووكيع، وعنه أبو داود، والنسائي، وابن ماجة، والفريابي، توفي 253. د س ق.(@)(@@)(@@)(@@) $ 1093 -(@)(@@) الحسين بن عبد الرحمن - ويقال: عبد الرحمن بن 
ms78	 الحسين، ويقال: حسيل - الأشجعي، عن PageV01P333(@)(@@) سعد، وعنه بسر بن سعيد، وثق. د.(@)(@@)(@@)(@@) $ 1094 -(@)(@@) الحسين بن عروة، عن مالك، والحمادين، وعنه نصر بن علي، وأحمد بن المعذل، صدوق. ق.(@)(@@)(@@)(@@) $ 1095 -(@)(@@) الحسين بن علي بن الأسود العجلي الكوفي، عن ابن فضيل، وحسين الجعفي، وعنه أبو داود، والترمذي، والمحملي، قال أبو حاتم: صدوق، وضعفه ابن عدي، وغيره، توفي 254. د ت.(@)(@@)(@@)(@@) $ 1096 -(@)(@@) الحسين بن علي بن الحسين، عن أبيه، وأخيه الباقر، وعنه بنوه: محمد، وعبد الله، وإبراهيم، وابن المبارك، وثقه النسائي. ت س.(@)(@@)(@@)(@@) $ 1097 -(@)(@@) الحسين الشهيد، عن جده رسول الله صلى الله عليه وسلم وأبويه، وعنه أولاده: علي وزيد، وسكينة، وفاطمة، وكرز التيمي، وعكرمة، قال ابن سعد: ولد في شعبان سنة أربع مات 61 يوم عاشوراء. ع.(@)(@@)(@@)(@@) $ 1098 -(@)(@@) الحسين بن علي بن الوليد الجعفي عن خاله الحسن بن الحر، وجعفر بن برقان، والأعمش، وعنه أحمد، وعبد، وابن الفرات، قال أحمد: ما رأيت أفضل منه ومن سعيد بن عامر، وقال يحيى بن يحيى: إن بقي أحد من الأبدال فحسين الجعفي. عاش أربعا وثمانين سنة. توفي في ذي القعدة 203. ع.(@)(@@)(@@)(@@) $ 1099 -(@)(@@) الحسين بن علي بن يزيد الصدائي، عن أبيه، ووكيع، وعنه الترمذي، وابن صاعد، والمحاملي، ثقة من الأولياء، توفي 248. ت.(@)(@@)(@@)(@@) $ 1100 -(@)(@@) الحسين بن عمران الجهني، عن الزهري، وغيره، وعنه شعبة، وأبو حمزة السكري، قال البخاري: لا يتابع على حديثه. ق.(@)(@@) 32 / أ (@)(@@)(@@)(@@) $ 1101 -(@)(@@) الحسين بن عياش الباجدائي الرقي، عن جعفر بن برقان، وزهير، وعنه علي بن جميل وهلال بن العلاء، وثقه النسائي، وله مصنف في غريب الحديث، توفي 204. س.(@)(@@)(@@)(@@) $ 1102 -(@)(@@) الحسين بن عيسى أبو علي الطائي القومسي البسطامي الدامغاني، عن ابن عيينة، ووكيع، وعنه PageV01P334(@)(@@) البخاري، ومسلم، وأبو داود، والنسائي، وابن خزيمة، ومأمون، ثقة من أئمة العربية، توفي 247.(@)(@@) خ م د س.(@)(@@)(@@)(@@) $ 1103 -(@)(@@) الحسين بن عيسى بن مسلم الحنفي الكوفي، أخو سليم القارئ، عن معمر، وغيره، وعنه أبو كريب، والأشج، ضعف. د ق.(@)(@@)(@@)(@@) $ 1104 -(@)(@@) الحسين بن قيس الرحبي أبو علي حنش، عن عكرمة، وعطاء، وعنه خالد الطحان، 
ms79	 وعلي بن عاصم، قال البخاري: لا يكتب حديثه. ت ق.(@)(@@)(@@)(@@) $ 1105 -(@)(@@) الحسين بن أبي السري: متوكل بن عبد الرحمن العسقلاني أخو محمد، عن وكيع، وضمرة، وعنه ابن ماجة، وابن قتيبة، كذب. مات 240. ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن أبي كبشة: ابن سلمة. [= 1089].(@)(@@)(@@)(@@) $ 1106 -(@)(@@) الحسين بن محمد الذارع البصري، عن عثام، ويزيد بن زريع، وعنه الترمذي، والنسائي، والبغوي، ثقة، توفي 247. ت س.(@)(@@)(@@)(@@) $ 1107 -(@)(@@) الحسين بن محمد أبو أحمد المؤدب المروذي، ببغداد، عن ابن أبي ذئب، وشيبان، وعنه أحمد، وعباس الدوري، وإسحاق الحربي، توفي 213 وكان يحفظ. ع.(@)(@@)(@@)(@@) $ 1108 -(@)(@@) الحسين بن محمد البلخي الحريري، عن عبد الرزاق، وعبيد الله، وعنه الترمذي، وأحمد الأبار، وعدة. ت.(@)(@@)(@@)(@@) $ 1109 -(@)(@@) الحسين بن محمد بن زياد القباني، أبو علي الحافظ، عن ابن راهويه، وأبي مصعب، وعنه PageV01P335(@)(@@) دعلج، وخلق، قال البخاري: " حدثنا حسين، حدثنا أحمد بن منيع ": فالظاهر أنه هو، توفي 289.(@)(@@)(@@)(@@) $ 1110 -(@)(@@) الحسين بن محمد بن شيبة الواسطي، عن يزيد، وجعفر بن عون، وعنه ابن ماجة، وابن أبي حاتم، ثقة. ق.(@)(@@)(@@)(@@) $ 1111 -(@)(@@) الحسين بن معاذ البصري، عن سلام بن أبي خبزة، و عبد الأعلى السامي، وعنه أبو داود، والحسن ابن سفيان، ثقة. د.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن منذر، هو: ابن واقد. [= 1115 [.(@)(@@)(@@)(@@) $$$ * -(@)(@@) الحسين بن منصور، هو: الحسن. [= 1068].(@)(@@)(@@)(@@) $ 1112 -(@)(@@) الحسين بن منصور بن جعفر السلمي النيسابوري الحافظ، عن عمي أبيه: مبشر، وعمر بن عبد الله بن رزين، وابن عيينة، وعنه البخاري، والنسائي، والسراج، عرض عليه قضاء نيسابور فاختفى، ودعا فمات في ثالث يوم 238. خ س.(@)(@@)(@@)(@@) $ 1113 -(@)(@@) الحسين بن مهدي الأبلي، عن عبد الرزاق، والفريابي، وعنه الترمذي، وابن ماجة، وابن بجير، قال أبو حاتم: صدوق. توفي 247. ت ق.(@)(@@)(@@)(@@) $ 1114 -(@)(@@) الحسين بن ميمون الخندفي الكوفي، عن أبي الجنوب، و عبد الله قاضي الري، وعنه عبد الرحمن ابن الغسيل، وهاشم بن البريد، قال أبو حاتم: ليس بالقوي. د.(@)(@@)(@@)(@@) $ 1115 -(@)(@@) الحسين بن واقد، قاضي مرو، عن ابن بريدة، وعكرمة، وعنه ابناه: علي، والعلاء، وابن PageV01P336(@)(@@) المبارك، وعلي بن الحسن بن شقيق، قال ابن المبارك: من مثله! ووثقه ابن معين 
ms80	 وغيره، توفي 159. م 4.(@)(@@)(@@)(@@) $ 1116 -(@)(@@) الحسين بن الوليد النيسابوري الفقيه، عن ابن جريج، وشعبة، وعنه أحمد، والذهلي، ثقة، قرأ على الكسائي، وكان من أسخى الناس، وأورعهم، وأتقاهم، وأغزاهم! توفي 202. س.(@)(@@)(@@)(@@) $ 1117 -(@)(@@) الحسين بن يزيد الطحان الكوفي، عن المطلب بن زياد، وابن فضيل، وعنه أبو داود، والترمذي، والحسن بن سفيان، مات 244، قال أبو حاتم: لين. د ت.(@)(@@)(@@)(@@) $$$ * -(@)(@@) حسين، عن أحمد بن منيع، وعنه البخاري في الطب، هو القباني، وقيل: حسين بن يحيى البيكندي. خ. 32 / ب (@)(@@)(@@)(@@) $ 1118 -(@)(@@) حشرج بن زياد، عن جدته، صحابية، وعنه رافع بن سلمة. د س.(@)(@@)(@@)(@@) $ 1119 -(@)(@@) حشرج بن نباتة الأشجعي، عن سعيد بن جمهان، وأبي نصر صاحب ابن عباس، وعنه أبو نعيم، وعاصم بن علي، وثقه أحمد، وجماعة، وقال أبو حاتم: لا يحتج به، وقال النسائي: ليس بالقوي، وليس به بأس. ت.(@)(@@)(@@)(@@) $ 1120 -(@)(@@) حصن بن عبد الرحمن - أو ابن محصن - التراغمي، الدمشقي، عن أبي سلمة، وعنه الأوزاعي، في الدية. د س.(@)(@@)(@@)(@@) $ 1121 -(@)(@@) حصين بن أوس - وقيل: بن قيس - النهشلي، له صحبة، عنه ابنه زياد. س. PageV01P337(@)(@@)(@@)(@@) $ 1122 -(@)(@@) حصين بن جندب أبو ظبيان الجنبي الكوفي، عن حذيفة، وعلي، وعنه ابنه قابوس، والأعمش، مات سنة تسعين. ع.(@)(@@)(@@)(@@) $$$ * -(@)(@@) حصين بن أبي الحر: مالك. [= 1129].(@)(@@)(@@)(@@) $ 1123 -(@)(@@) حصين بن عبد الرحمن الأشهلي، عن ابن عباس، ومحمود بن لبيد، وعنه ابنه، وابن إسحاق، ثقة، توفي 126. د س.(@)(@@)(@@)(@@) $ 1124 -(@)(@@) حصين بن عبد الرحمن السلمي، أبو الهذيل الكوفي، ابن عم منصور، عن جابر بن سمرة، وأبي وائل، وعنه شعبة، وهشيم، وعلي بن عاصم، ثقة حجة، مات 136. ع.(@)(@@)(@@)(@@) $ 1125 -(@)(@@) حصين بن عمر الأحمسي، عن أبي الزبير، والأعمش، وعنه منجاب، ويحيى الحماني، ضعفه أحمد والناس. ت.(@)(@@)(@@)(@@) $ 1126 -(@)(@@) حصين بن عوف الخثعمي، له صحبة، عنه ابن عباس. ق.(@)(@@)(@@)(@@) $ 1127 -(@)(@@) حصين بن قبيصة الفزاري - وقيل ابن عقبة - عن علي، و عبد الله، وعنه ركين بن الربيع، وعبد الملك بن عمير. د س ق. PageV01P338(@)(@@)(@@)(@@) $ 1128 -(@)(@@) حصين بن اللجلاج، ويقال خالد، ويقال القعقاع، ويقال أبو العلاء، عن أبي هريرة، وعنه صفوان. س.(@)(@@)(@@)(@@) $ 1129 -(@)(@@) حصين 