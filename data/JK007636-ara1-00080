ms61	 % % 34(@)(@@) % به للبرايا حاجب من هلاله % % ولحت فيا لله عين وحاجب % % 35(@)(@@) % للصاحب بن الصاحب الناصر من % % دعاه رأي في الصلاة الراتبة % % 36(@)(@@) % يمنح من قبل امتداح مجده % % جائزة ثم يراها واجبه % % 37(@)(@@) % لا غرو إن جئت النسيب بمدحة % من غير ما غزل وغير نسيب % % 38(@)(@@) % هزت رؤس السامعين بوصفه % % طربا فلم تحتج إلى تشبيب % % 39(@)(@@) % يا سيدي شكرا لها من أنعم % وقتي بها من بعد مصر خصيب % % 40(@)(@@) % قسما لقد أفردت في نظم وفي % % ود ففي الحالين أنت حبيب % % PageV01P273 41(@)(@@) % لا تنكروا حمرة الأظافر من % % فلان والقمل منه منسرب % % 42(@)(@@) % حمرتها من دماء ما قتلت % % والدم في النصل شاهد عجب % % 43(@)(@@) % إن الأمير سليمان اعتلى رتبا % في الخبر والخبر استعلت على الرتب % % 44(@)(@@) % مجانس الحسن بالحسان في صفة % وفارس الخيل وجه الترك والعرب % % 45(@)(@@) % يا ملاذي الغوث من عائلة % % ليس من تكليفهم لي مهرب % % 46(@)(@@) % طلبوا في أرجلي شيئا وقد % % نقبوا رأسا بما قد طلبوا % % 47(@)(@@) % أشكو لأنعمك التي % % هي للعفاة سحائب % % 48(@)(@@) % حالي التي يرثي العدو % لها فكيف الصاحب % % PageV01P274 البحر : - 1(@)(@@) % شكرا لها من أنعم قد شادها % % نعم العماد فمكنت أسبابي % % 2(@)(@@) % قالوا الحساب فقلت ان عوائدي % % أعطى على يده بغير حساب % % 3(@)(@@) % بشر أمير المعالي باتصال هنا % يحفه السعد من أقصى جوانبه % % 4(@)(@@) % واكتب على بيت سكناه العزيز به % % عزا يدوم وإقبالا لصاحبه % % 5(@)(@@) % يا سادة قد ظفرت عندهمو % % بيمن قصد ونجح مطلوب % % 6(@)(@@) % حاشاكمو أن يبيت جاركمو % % يشكو إلى الناس ضر أيوب % % 7(@)(@@) % جاءت الي الشوربا فحبذا % % يا سيدي منك طعام معجب % % 8(@)(@@) % أفاد جسمي قوة فها أنا % % كما يقال الأسد المشورب % % 9(@)(@@) % وغائب تذكرني كتبه % % لياليا دمعي لها في انسكاب % % 10(@)(@@) % فهاك بالمرسل من أدمعي % % حديث شجوي من كتاب الشهاب % % PageV01P275 11(@)(@@) % عذيري منه معرضا متجنيا % كأني له نحو الوداد أجاذب % % 12(@)(@@) % قسا فوق ما تقسو الجبال فلم يجب % % ندائي وأصداء الجبال تجاوب % % 13(@)(@@) % مولاي قد جئنا لنحمل قصة % % نحو الوزير فقم مع الأصحاب % % 14(@)(@@) % فاليوم 
ms62	 حاجتنا اليك وانما % % يدعى الطبيب لشدة الأوصاب % % 15(@)(@@) % يغيب الذي أهواه عني ساعة % % فأسأم من ليل طويل أراقبه % % 16(@)(@@) % وكيف يطيب الليل عندي والكرى % % وليس إلى جنبي خليل ألاعبه % % 17(@)(@@) % علقتها غيداء حالية الطلا % % تجني على عقل المحب ولبه % % 18(@)(@@) % بخلت بلؤلؤ ثغرها عن لاثم % فتطوقت بمثال ما بخلت به % % 19(@)(@@) % يا حسن كتاب الحساب وخلفهم % % غلمانهم بدفاتر وتعابي % % 20(@)(@@) % كم قد رجوت وفي حساب مثلهم % % فلقيته لكن بغير حساب % PageV01P276 21(@)(@@) % يا غائبين تعللنا لغيبتهم % % بطيب لهو ولا والله لم يطب % % 22(@)(@@) % ذكرت والكاس في كفي لياليكم % % فالكاس في راحة والقلب في تعب % % 23(@)(@@) % أمولاي شكرا لليراع الذي أرى % % بياض العطايا في سواد المطالب % % 24(@)(@@) % لقد قمت بالمسنون والفرض في الندى % % تضيع هذا المال في غير واجب % % 25(@)(@@) % دامت بسعدك للعداة مهالك % يا مطلب الجود الذي لا يحجب % % 26(@)(@@) % والله ما تدري إذا ما فاتنا % % طلب اليك من الذي نتطلب % % 27(@)(@@) % يا حبذا ملك حي الجيوش إلى % % خوض الوغى بشريق اللون محبوب % % 28(@)(@@) % تعجلوا الفال في نحر العدى فغدوا % % حمر الحلى والمطايا والجلابيب % % 29(@)(@@) % أهنيك بالعيد السعيد قدومه % % واشكر برا أنت من قبل واهبه % % 30(@)(@@) % لعمري لقد أصبحت عين زماننا % % فيا حبذا عين الزمان وحاجبه % % PageV01P277 31(@)(@@) % ليهنك يا عين الزمان وأهله % % ويهني الورى عام بسعدك آيب % % 32(@)(@@) % به للبرايا حاجب من هلاله % % ولحت فيا لله عين وحاجب % % 33(@)(@@) % للصاحب بن الصاحب الناصر من % % دعاه رأي في الصلاة الراتبة % % 34(@)(@@) % يمنح من قبل امتداح مجده % % جائزة ثم يراها واجبه % % 35(@)(@@) % لا غرو إن جئت النسيب بمدحة % من غير ما غزل وغير نسيب % % 36(@)(@@) % هزت رؤس السامعين بوصفه % % طربا فلم تحتج إلى تشبيب % % 37(@)(@@) % يا سيدي شكرا لها من أنعم % وقتي بها من بعد مصر خصيب % % 38(@)(@@) % قسما لقد أفردت في نظم وفي % % ود ففي الحالين أنت حبيب % % 39(@)(@@) % لا تنكروا حمرة الأظافر من % % فلان والقمل منه منسرب % % 40(@)(@@) % حمرتها من دماء ما قتلت % % والدم في النصل شاهد عجب % % PageV01P278 41(@)(@@) % إن الأمير 
