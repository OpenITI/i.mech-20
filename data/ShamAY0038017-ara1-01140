ms1121	 عنه كثير بن زيد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن غيلان الثقفي(@)(@@) أمير البصرة، يروي عن كعب، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن يحيى بن سعيد بن عمرو بن سعيد بن العاص(@)(@@) يروي عن جده سعيد بن عمرو عن أبي هريرة، روى عنه أحمد بن محمد القواس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن إسماعيل(@)(@@) يروي عن كعب المقاطيع، روى عنه سعيد بن إياس الجريري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عامر بن عبد الله بن الزبير بن العوام(@)(@@) يروي عن أبيه، روى عنه عمرو بن يحيى المازني.(@)PageV01P002(@)(@@) [ج 4: ص 134](@)(@@)(@@)(@@) ||| AUTO عمرو بن حريث بن عمارة(@)(@@) من بني عمارة من بني عذرة، يروي عن أبيه، روى عنه سعيد المقبري ويزيد بن عبيد الله الهذلي عداده في أهل المدينة، وهو الذي يروي عن عبد الملك بن مروان الذي، روى عنه معاوية بن صالح، وله بن يقال له: أبو محمد، يروي عن جده حريث عن أبي هريرة، روى عنه ابن أبي محمد وإسماعيل بن أمية وابن جريج، وليس هذا بعمرو بن حريث المخزومي ذاك له صحبة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن جارية اللخمي(@)(@@) يروي عن أبي أمية الشعباني عن أبي ثعلبة، روى عنه عتبة بن أبي حكيم.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الأصبغ(@)(@@) يروي عن أبيه عن عائشة، روى عنه الأسود بن شيبان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي مسلم(@)(@@) يروي عن عروة بن الزبير، روى عنه عبد الرحمن بن أبي الموالي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن حية(@)(@@) يروي عن عمرو بن عبد الرحمن بن عوف، روى عنه يوسف بن الحكم.(@)(@@)(@@)(@@) ||| AUTO عمرو بن المهاجر الدمشقي(@)(@@) مولى أسماء بنت يزيد، كنيته أبو محمد وهو أخو محمد بن مهاجر، يروي عن سليمان بن حبيب والشاميين، روى عنه الوليد بن مسلم، وأهل الشام، مات سنة تسع وثلاثين ومائة، وكان على شرطة عمر بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي حكيم أبو سعيد الواسطي(@)(@@) مولى الأزد، كنيته أبو سهل، وهو الذي يقال له عمرو بن كردي، يروي عن عبد الله بن بريدة، روى عنه خالد الحذاء.(@)PageV01P002(@)(@@) [ج 4: ص 135](@)(@@)(@@)(@@) ||| AUTO عمرو بن عثمان بن 
ms1122	 يعلى(@)(@@) يروي عن أبيه، عن جده، روى عنه خلف بن مهران العدوى.(@)(@@)(@@)(@@) ||| AUTO عمرو بن حبيب(@)(@@) يروي عن عبيد الله بن حر روى شريك عن جابر عنه.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي قيس الرازي(@)(@@) يروي عن سماك بن حرب، روى عنه عبد الله بن الجهم، وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عمرو بن قيس بن يسير بن عمرو(@)(@@) الكوفي، يروي عن الكوفيين وأبيه، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمرو بن خزيمة أبو خزيمة(@)(@@) من أهل المدينة، يروي عن عمارة بن خزيمة، روى عنه هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الزبير الصراف(@)(@@) من أهل البصرة، يروي عن أبيه، عن عبد الله بن مغفل، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن القاسم(@)(@@) يروي عن أبي قلابة، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عمر بن عبد الأحموسي(@)(@@) من أهل الشام، ثبت إذا كان فوقه ودونه ثقة، يروي عن جماعة من التابعين، روى عنه أهل الشام.(@)PageV01P002(@)(@@) [ج 4: ص 136](@)(@@)(@@)(@@) ||| AUTO عمرو بن خالد بن عرفطة(@)(@@) يروي عن أبيه، روى عنه كلاب بن عمرو ابنه.(@)(@@)(@@)(@@) ||| AUTO عمرو بن يزيد أبو بردة(@)(@@) يروي عن عطاء، روى عنه عبيد الله بن موسى.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي سفيان الجمحي القرشي(@)(@@) من أهل مكة أخو حنظلة بن أبي سفيان، يروي عن أهل الحجاز، روى عنه الثوري، وابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمرو بن قيس الملائي(@)(@@) من أهل الكوفة، كنيته أبو عبد الله، يروي عن المنهال بن عمرو وعكرمة، روى عنه أبو خالد الأحمر والكوفيون.(@)(@@) (388) -[4: 136] سمعت ابن خزيمة، يقول: سمعت عمر بن حفص الشيباني، يقول: سمعت عبد الرحمن بن مهدي، يقول: نظر الثوري إلى حماد بن سلمة، فقال: " يا أبا سلمة أشبهك بشيخ صالح، قال: ومن هو، قال: عمرو بن قيس الملائي قال أبو حاتم: كان عمرو بن قيس الملائي من ثقات أهل الكوفة ومتقنيهم وعباد أهل بلده وقرائهم، وليس هذا بعمرو بن قيس بن يسير بن عمرو، ذاك شيخ آخر كوفي صدوق أكثر روايته عن أبيه ".(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمرو بن سعيد(@)(@@) يروي عن أبي 
ms1123	 زرعة بن عمرو بن جريج والشعبي، روى عنه يونس بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مساور(@)(@@) وقد قيل مسور، يروي عن الشعبي، روى عنه روح بن القاسم.(@)(@@) عمرو بن سعيد(@)(@@) يروي عن سعيد بن جبير، روى عنه داود بن أبي هند أحسبه الذي، روى عنه يونس بن عبيد.(@)PageV01P002(@)(@@) [ج 4: ص 137](@)(@@)(@@)(@@) ||| AUTO عمرو بن سعيد بن العاص بن سعيد بن العاص الأموي القرشي(@)(@@) أخو عنبسة بن سعيد، كنيته أبو أمية، يروي عن أبيه، عن عمر ومن زعم أن عبد الملك بن مروان قتله بيده، فقد وهم الذي قتله عبد الملك بيده هو عمرو بن سعيد الأشدق.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن وهب أبو معاوية النخعي(@)(@@) من أهل الكوفة، يروي عن أبي عمرو الشيباني، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن شور أبو شور الطائي(@)(@@) يروي عن الشعبي، روى عنه عثام بن علي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن البراء الجعفي(@)(@@) يروي عن طلحة بن مصرف، روى عنه المعلي بن هلال.(@)(@@)(@@)(@@) ||| AUTO عمرو بن شراحيل العيشي أبو المغيرة الشامي(@)(@@) يروي عن الشاميين وبلال بن سعد، روى عنه صدقة بن خالد ومحمد بن شعيب بن شابور.(@)(@@)(@@)(@@) ||| AUTO عمرو بن ميمون بن مهران الجزري(@)(@@) مولى الأزد، كنيته أبو عبد الله، يروي عن أبيه، وقد قيل، كنيته أبو عبد الرحمن، روى عنه الثوري وشريك، مات سنة خمس وأربعين ومائة بحصن مسلمة، وقد قيل: سنة سبع وأربعين ومائة بالكوفة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أيوب بن أبي زرعة بن عمرو بن جرير البجلي(@)(@@) أخو يحيى بن أيوب، وجرير بن أيوب، عن جده أبي زرعة بن عمرو، قال: كان أبو هريرة يقبض على لحيته ثم يأخذ ما تحت القبضة من لحيته، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عمران أبو السوداء النهدي(@)(@@) يروي عن عبد الرحمن بن سابط، روى عنه سفيان الثوري.(@)PageV01P002(@)(@@) [ج 4: ص 138](@)(@@)(@@)(@@) ||| AUTO عمرو بن شرحبيل بن سعيد بن سعد بن عبادة الأنصاري الخزرجي(@)(@@) يروي عن أبيه، روى عنه عبد الله بن محمد بن عقيل: ابن أبي طالب.(@)(@@)(@@)(@@) ||| AUTO 
ms1124	 عمرو بن عبد الرحمن الضبي(@)(@@) يروي عن عمته ليلى بنت عفراء، روى عنه عبيد الله بن هوذة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن الأسوار اليماني(@)(@@) يروي عن عكرمة، روى عنه هشام بن يوسف ومعمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن كعب السلمي الأنصاري(@)(@@) يروي عن نافع بن جبير عداده في أهل المدينة، روى عنه يزيد بن خصيفة.(@)(@@)(@@)(@@) ||| AUTO أبو نعامة العدوى اسمه عمرو بن عيسى بن سويد(@)(@@) بصري، يروي عن أبي نضرة والبصريين، روى عنه مكي بن إبراهيم والناس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الرحمن بن أمية الثقفي(@)(@@) يروي عن أبيه، عن يعلى بن أمية، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الملك بن حريث(@)(@@) ابن أخي عمرو بن حريث المخزومي القرشي، يروي عن الكوفيين، روى عنه حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي عبيد(@)(@@) من أهل المدينة، يروي عن الحجازيين، روى عنه يحيى بن سعيد الأنصاري، وابن أبي ذئب.(@)PageV01P002(@)(@@) [ج 4: ص 139](@)(@@)(@@)(@@) ||| AUTO عمرو بن عثمان بن عبد الله بن موهب التيمي(@)(@@) مولى آل طلحة، يروي عن موسى بن طلحة، روى عنه زائدة بن قدامة ومروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO أبو الزعراء اسمه عمرو بن عمرو بن مالك الجشمي(@)(@@) وقد قيل: عمرو بن عامر ابن أخي أبي الأحوص من أهل الكوفة، يروي عن أبي الأحوص وعكرمة، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سعد(@)(@@) يروي.(@)(@@) (389) -[4: 139] عن نافع، عن ابن عمر، أن رسول الله صلى الله عليه وسلم: " أمر بالمسح في الدار يوما وليلة وفي السفر بثلاثة أيام ولياليهن "، حدثناه الحسن بن سفيان، قال: ثنا يحيى بن موسى خت، قال: ثنا عمر بن يونس اليمامي، قال: ثنا أيوب بن النجار، عن سليمان بن أبي سليمان، عن عمرو بن سعد(@)(@@)(@@)(@@) ||| AUTO عمرو بن عتبة بن فرقد السلمي(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عتبة بن أبي لهب الهاشمي(@)(@@) يروي عن الحجازيين، روى عنه ابنه محمد بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن اللجلاج السكسكي(@)(@@) يروي 
ms1125	 عن عبد الرحمن بن فضالة عداده في أهل الشام، روى عنه جرير بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مالك بن يخامر السكسكي(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه الشاميون.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مالك النكري، كنيته أبو مالك(@)(@@) من أهل البصرة، يروي PageV01P002 [ج 4: ص 140] عن أبي الجوزاء، روى عنه حماد بن زيد وجعفر بن سليمان، وابنه يحيى بن عمرو، ويعتبر حديثه من غير رواية ابنه عنه، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمرو الفقيمي(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، روى عنه ابناه الفضيل والحسن الكوفيان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الحارث بن يعقوب(@)(@@) مولى الأنصار، كنيته أبو أمية عداده في أهل مصر، وكان مؤدبا لصالح بن علي بالمدينة فأخرجه منها إلى مصر وأقام بها إلى أن مات، يروي عن الزهري، ويحيى بن سعيد الأنصاري، روى عنه الليث بن سعد وعبد الله بن وهب، مات سنة ثمان أو تسع وأربعين ومائة، وكان من الحفاظ المتقنين، وأهل الورع في الدين.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي نعيمة المعافري(@)(@@) من أهل مصر، يروي عن أبي عثمان مسلم بن يسار، روى عنه بكر بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن خليفة(@)(@@) أخو هوذة بن خليفة، يروي عن محمد بن عمرو، وسليمان التيمي، روى عنه أبو قلابة الرقاشي، وكان أسن من هوذة ومات قبله، كنيته أبو عثمان ربما كان في بعض روايته بعض المناكير.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبيد الله(@)(@@) يروي عن سعيد بن عمرو، عن أبي سعيد الخدري، أن النبي صلى الله عليه وسلم قال: " لا يبغض الأنصار إلا منافق "، روى عنه سليمان بن هلال(@)(@@)(@@)(@@) ||| AUTO عمرو بن مسلم(@)(@@) صاحب المقصورة مقصورة المدينة، يروي عن أبي حازم عن أنس بن مالك، وسهل بن سعد، روى عنه أبو معاوية الضرير.(@)PageV01P002(@)(@@) [ج 4: ص 141](@)(@@)(@@)(@@) ||| AUTO عمرو بن الوليد(@)(@@) يروي عن سالم بن عبد الله، روى عنه الأوزاعي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن يوسف(@)(@@) مولى عثمان من أهل المدينة، يروي عن سعيد بن المسيب، روى عنه عمر بن حمزة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن نضر أبو 
ms1126	 النضر(@)(@@) من أهل البصرة، يروي عن إسماعيل بن أبي خالد والبصريين، روى عنه أبو عاصم النبيل، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عامر البجلي(@)(@@) والد أسد بن عمرو من أهل الكوفة، يروي عن الكوفيين وعمر بن عبد العزيز، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مجمع أبو المنذر السكوني(@)(@@) من أهل الكوفة، يروي عن هشام بن عروة وابن أبي خالد، روى عنه أحمد بن حنبل رحمه الله، وأهل العراق كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الرحمن البجلي(@)(@@) يروي عن أبي عمرو الشيباني والشعبي، روى عنه أبو غسان، وأبو نعيم عداده في أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الرحمن بن أبي ليلى الأنصاري(@)(@@) من بني عمرو بن عوف من أهل الكوفة، يروي عن أبيه، روى عنه أخوه محمد بن عبد الرحمن بن أبي ليلى يعتبر حديثه من غير رواية محمد بن عبد الرحمن عنه.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عاصم الأسدي(@)(@@) من أهل الكوفة، يروي عن زر بن PageV01P002 [ج 4: ص 142] حبيش، روى عنه سلمة بن كهيل وقد لقيه جرير بن حازم بأرمينية وروى عنه.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الله بن مالك(@)(@@) من أهل المدينة، يروي عن محمد بن عمرو بن عطاء، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عيسى بن سيلان(@)(@@) من أهل المدينة، يروي عن كعب، روى سعيد بن أيوب عن عبد الله بن الوليد عنه.(@)(@@)(@@)(@@) ||| AUTO عيسى بن حفص بن عاصم بن عمر بن الخطاب(@)(@@) أخو عمر بن حفص، يروي عن جماعة من التابعين، روى عنه وكيع بن الجراح، مات سنة سبع وخمسين ومائة وأمه ميمونة بنت داود بن كليب بن إساف.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عتبة(@)(@@) يروي عن خاله عبد الله بن بأبيه، عن ابن عمر، روى عنه عمر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عيسى بن المغيرة(@)(@@) أبو شهاب التميمي من أهل الكوفة، يروي عن الشعبي، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عيسى بن حطان(@)(@@) يروي عن مسلم بن سلام عن علي بن طلق، روى عنه عاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الله الأنصاري(@)(@@) يروي عن 
ms1127	 أبي طوالة، روى عنه الوليد بن مسلم.(@)PageV01P002(@)(@@) [ج 4: ص 143](@)(@@)(@@)(@@) ||| AUTO عيسى بن معاوية(@)(@@) من أهل الحجاز، يروي عن معبد بن كعب الأنصاري، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO عيسى بن المسيب(@)(@@) من أهل الكوفة، يروي عن نافع، روى عنه أبو إسماعيل المؤدب.(@)(@@)(@@)(@@) ||| AUTO عيسى بن موسى(@)(@@) شيخ، يروي عن أبي حازم، روى عنه الوليد بن مسلم، كنيته أبو محمد وهو الذي يروي عن الشاميين.(@)(@@)(@@)(@@) ||| AUTO عيسى بن علي(@)(@@) يروي عن رافع بن بشير، روى عنه عبد الحميد بن جعفر الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عيسى الأنصاري(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه زيد بن أبي أنيسة لست أدري من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عثمان(@)(@@) قال: رأيت فاطمة بنت علي بن أبي طالب، روى عنه عبد الكريم الجزري، وأهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO عيسى بن الفضل بن معقل بن سنان الأشجعي(@)(@@) يروي عن عبد الله بن نيار الأسلمي، روى عنه أبان بن صالح.(@)(@@)(@@)(@@) ||| AUTO عيسى بن معمر(@)(@@) يروي عن عبد الله بن عمرو بن الفغواء، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عيسى بن أزهر(@)(@@) يروي عن الزهري، روى عنه كثير بن هشام ربما أغرب على قلة روايته.(@)PageV01P002(@)(@@) [ج 4: ص 144](@)(@@)(@@)(@@) ||| AUTO عيسى بن عمر القارئ الهمداني أبو عمر الأعمى(@)(@@) من أهل الكوفة، يروي عن الشعبي والكوفيين، روى عنه ابن المبارك وجرير ووكيع.(@)(@@)(@@)(@@) ||| AUTO عيسى بن لهيعة(@)(@@) أخو عبد الله بن لهيعة، يروي(@)(@@) (390) -[4: 144] عن عكرمة، عن ابن عباس: " لما نزلت آية المواريث حرم رسول الله صلى الله عليه وسلم الحبس "، رواه يحيى بن حسان، عن ابن لهيعة، عن أخيه عيسى بن لهيعة(@)(@@)(@@)(@@) ||| AUTO أبو طيبة اسمه عيسى بن سليمان بن دينار الدارمي(@)(@@) من أهل جرجان، يروي عن والأعمش ودونهما، روى عنه ابنه أحمد بن أبي طيبة، مات سنة ثلاث وخمسين ومائة يخطئ.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عيسى بن موسى بن محمد بن إياس بن البكير(@)(@@) يروي الكوفيين الشيباني عن المدنيين وصفوان بن سليم، روى عنه الليث بن سعد، ويحيى بن أيوب.(@)(@@) عيسى بن 
ms1128	 موسى(@)(@@) يروي عن محمد بن عباد بن جعفر، روى عنه السائب بن عمر.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الله(@)(@@) شيخ، يروي(@)(@@) (391) -[4: 144] عن الزهري، عن عبيد الله بن كعب بن مالك، عن أبيه أن النبي صلى الله عليه وسلم " عاد البراء بن معرور "، روى عنه محمد بن شعيب بن شابور(@)(@@)(@@)(@@) ||| AUTO عيسى بن عون بن حفص بن الفرافصة الحنفي(@)(@@) يروي عن يحيى بن سعيد الأنصاري، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO عيسى بن دينار أبو علي المؤذن(@)(@@) مولى عمرو بن الحارث بن المصطلق الخزاعي من أهل الكوفة، يروي عن أبيه، روى عنه ابن المبارك.(@)PageV01P002(@)(@@) [ج 4: ص 145](@)(@@)(@@)(@@) ||| AUTO عيسى بن عبيد المروزي(@)(@@) يروي عن عكرمة، روى عنه أهل مرو.(@)(@@)(@@)(@@) ||| AUTO عيسى بن كنانة(@)(@@) يروي عن محمد بن عمار المؤذن عن أبي هريرة، روى عنه يحيى بن عمير.(@)(@@)(@@)(@@) ||| AUTO أبو سنان الشامي اسمه عيسى بن سنان القسملي(@)(@@) كان ينزل القساملة بالبصرة فنسب إليها، يروي عن عثمان بن أبي سودة ويعلى بن شداد، روى عنه حماد بن سلمة، وعيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عيسى بن أبي عزة كوفي(@)(@@) يروي عن الشعبي، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عيسى بن سوادة(@)(@@) يروي عن عمرو بن دينار المقاطيع، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يزيد(@)(@@) يروي عن أبي زرعة عن أبي هريرة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يزيد بن داب الليثي(@)(@@) من أهل المدينة، يروي عن عبد الرحمن بن أبي زيد عن أبي هريرة، روى عنه يعقوب بن إبراهيم بن سعد.(@)(@@)(@@)(@@) ||| AUTO عيسى بن زيد(@)(@@) قال: سئل عكرمة عن الوضوء بالنبيذ، فقال: لا بأس به، روى عنه أبو تميلة يحيى بن واضح.(@)PageV01P002(@)(@@) [ج 4: ص 146](@)(@@)(@@)(@@) ||| AUTO عيسى بن سنان(@)(@@) يروي عن عثمان بن أبي سودة عن أبي هريرة، روى عنه عيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عيسى بن مسعود بن الحكم الزرقي الأنصاري(@)(@@) يروي عن عمرو بن سليم الزرقي، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبيد أبو همام(@)(@@) يروي عن الحسن، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عيسى بن 
ms1129	 الضحاك(@)(@@) أخو الجراح بن الضحاك كوفي، يروي عن الأعمش، روى عنه علي بن أبي بكر الأسفذني وهى قرية بالري.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبيد الكندي المروزي، كنيته أبو المنيب(@)(@@) يروي عن عكرمة، وابن بريدة، روى عنه يحيى بن واضح والمراوزة، وهو الذي يروي عن الربيع بن أنس.(@)(@@)(@@)(@@) ||| AUTO عيسى بن المنهال العبدي(@)(@@) من أهل البصرة. يروي عن البصريين وغالب القطان، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يزيد(@)(@@) شيخ، يروي عن طاوس، روى عنه الزبيدي.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يزيد أبو معاذ المروزي(@)(@@) يروي عن أبي إسحاق السبيعي، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يونس بن أبي إسحاق السبيعي الهمداني، كنيته أبو عمرو PageV01P002 [ج 4: ص 147](@)(@@) من أهل الكوفة، يروي عن إسماعيل بن أبي خالد والأعمش، روى عنه العراقيون والغرباء، مات بالحدث سنة سبع وثمانين ومائة، وقد قيل: سنة تسع وثمانين ومائة. ويقال أيضا: أول سنة إحدى وتسعين ومائة، وكان متقنا، وهو أخو إسرائيل بن يونس، وكان عيسى يسكن الجزيرة وقبره بالحدث.(@)(@@)(@@)(@@) ||| AUTO عمران بن حدير السدوسي، كنيته أبو عبيدة(@)(@@) من أهل البصرة، يروي عن أبي مجلز، وعكرمة، روى عنه شعبة بن الحجاج، ووكيع بن الجراح، مات سنة سبع وأربعين ومائة، وقد قيل: سنة تسع.(@)(@@)(@@)(@@) ||| AUTO عمران بن مسلم الجعفي الأعمى(@)(@@) من أهل الكوفة، يروي عن سويد بن غفلة وزاذان، روى عنه الثوري، وشعبة، وشريك.(@)(@@)(@@)(@@) ||| AUTO عمران بن أوس بن ضمعج(@)(@@) من أهل الكوفة، يروي عن أبي مسعود وعائشة، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عمران بن ظبيان، كنيته أبو حفص(@)(@@) مولى أسلم من أهل المدينة، يروي عن جماعة من التابعين، روى عنه أهل المدينة، وهو خال إبراهيم بن محمد بن أبي يحيى، مات سنة سبع وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمران بن بشير بن محرز(@)(@@) يروي عن أبيه، روى عنه ابن أبي ذئب.(@)PageV01P002(@)(@@) [ج 4: ص 148](@)(@@)(@@)(@@) ||| AUTO عمران بن بشر أبو بشر السعدي(@)(@@) يروي عن ابن المسيب، قوله، روى عنه الحجازيون.(@)(@@)(@@)(@@) ||| AUTO عمران بن عثمان بن الأرقم بن أبي الأرقم القرشي(@)(@@) يروي 
ms1130	 عن أبيه، روى عنه ابنه يحيى بن عمران.(@)(@@)(@@)(@@) ||| AUTO عمران بن عكرمة الخزاعي(@)(@@) يروي عن ذؤيب بن عباد الخزاعي، روى عنه حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عمران أبو بشر الحلبي(@)(@@) سكن البصرة، يروي عن الحسن المراسيل، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عمران بن موسى بن عمرو بن سعيد بن العاص(@)(@@) أخو أيوب بن موسى، يروي عن سعيد المقبري وعمر بن عبد العزيز، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عمران بن يزيد(@)(@@) يروي المقاطيع، روى عنه ثابت بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عمران بن أنس أبو أنس المكي(@)(@@) يروي عن ابن أبي مليكة وعطاء، روى عنه يحيى بن واضح أبو تميلة ومعاوية بن هشام، ومن قال: عمران بن أبي أنس فقد وهم يخطئ.(@)(@@)(@@)(@@) ||| AUTO عمران بن وهب الطائي(@)(@@) يروي عن أبي رجاء العطاردي، روى عنه محمد بن عبيد الطنافسي.(@)(@@)(@@)(@@) ||| AUTO عمران بن عيينة بن أبي عمران الهلالي(@)(@@) أخو سفيان بن عيينة، PageV01P002 [ج 4: ص 149] كنيته أبو الحسن، يروي عن إسماعيل بن أبي خالد، روى عنه زيد بن الحريش الأهوازي والناس.(@)(@@)(@@)(@@) ||| AUTO عمران بن عمرو(@)(@@) يروي عن أبيه، عن جابر في مس الذكر، روى عنه ضمام بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمران بن أبي يحيى التيمي(@)(@@) يروي عن عبد الله بن كعب بن مالك، روى عنه محمد بن إبراهيم التيمي وسعيد المقبري.(@)(@@)(@@)(@@) ||| AUTO عمران الخياط(@)(@@) مولى الجعفي من أهل الكوفة، يروي عن زيد بن وهب وإبراهيم النخعي، روى عنه عبد الله بن عون.(@)(@@) عمران بن أبي يحيى(@)(@@) يروي عن الحجازيين، روى عنه محمد بن عبيد، وعيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عمران بن حيان الأنصاري(@)(@@) يروي عن أبيه، روى عنه حميد بن علي.(@)(@@)(@@)(@@) ||| AUTO عمران بن يحيى المعافري(@)(@@) من أهل مصر، يروي عن سعيد بن المسيب، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عمران بن سليمان المرادي القبي(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه عيسى بن يونس وحفص بن غياث.(@)(@@) (392) -[4: 149] حدثنا إبراهيم بن نصر العنبري بسمرقند، قال: ثنا علي بن خشرم، قال: ثنا عيسى بن يونس، 
ms1131	 عن عمران القبي، عن الشعبي، عن جابر بن سمرة، قال: سمعت النبي صلى الله عليه وسلم يقول في حجة الوداع: " لا يزال أمر هذه الأمة عاليا على من ناواها حتى يملك اثنا عشر خليفة "(@)(@@)(@@)(@@) ||| AUTO عمران بن مسلم القصير المنقري(@)(@@) من أهل البصرة، كنيته أبو PageV01P002 [ج 4: ص 150] بكر، يروي عن أبي رجاء العطاردي وعطاء، روى عنه شعبة، والبصريون وهو الذي، روى عنه يحيى بن سليم إلا أن في رواية يحيى بن سليم عنه بعض المناكير، وكذلك في رواية سويد بن عبد العزيز عنه.(@)(@@)(@@)(@@) ||| AUTO عمران بن مسلم الفزاري(@)(@@) وقد قيل: ابن أبي مسلم كان يسكن جهينة بالكوفة، يروي عن الشعبي ومجاهد، روى عنه محمد بن ربيعة، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عمران بن عبد الرحمن بن الحارث الهذلي(@)(@@) يروي عن مجاهد، روى عنه ابنه محمد بن عمران، هو من أهل مكة.(@)(@@)(@@)(@@) ||| AUTO عمران بن النعمان(@)(@@) يروي عن الربيع بن سبرة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمران بن نافع(@)(@@) يروي عن حفص بن عبيد الله عن أنس، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عمران بن موسى بن طلحة بن عبيد الله القرشي(@)(@@) الذي يقال له: عمران بن أبي الصعبة، يروي عن أبيه عداده في أهل الكوفة، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عمران بن أبي كثير(@)(@@) يروي عن سعيد بن المسيب، وقبيصة بن ذؤيب، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عمران بن أبي جميل(@)(@@) يروي عن أبي فراس عن عبد الله بن عمرو، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عمران بن عبد الله بن طلحة الخزاعي(@)(@@) يروي عن سعيد بن المسيب عداده في أهل البصرة، روى عنه سلام بن مسكين.(@)PageV01P002(@)(@@) [ج 4: ص 151](@)(@@)(@@)(@@) ||| AUTO عمران بن عون(@)(@@) يروي عن الزهري، روى عنه الليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO عمران القطان، وهو عمران بن داود، كنيته أبو العوام(@)(@@) من أهل البصرة، يروي عن الحسن وقتادة وابن سيرين، روى عنه أبو داود الطيالسي، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عمران البارقي(@)(@@) يروي عن الحسن وعطية، روى عنه الأعمش. 
ms1132	(@)(@@)(@@)(@@) ||| AUTO عمران بن عبيد المكي(@)(@@) يروي عن أمه ليلى مولاة أسماء عن أسماء، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO عمران بن قدامة(@)(@@) يروي عن البصريين، روى عنه زيد العمى، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عمران بن زائدة بن نشيط(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه ابن المبارك، وعيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO عمران بن زيد المدني(@)(@@) يروي عن أبيه، عن عائشة، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي ثبيت الراسبي(@)(@@) من أهل البصرة وهو الذي يقال له: عقبة بن سريج، وقد قيل: عقبة بن شريح، يروي عن أبي الجوزاء، روى عنه شعبة، وأبو هلال الراسبي.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عبد الرحمن بن أبي معمر(@)(@@) من أهل المدينة، يروي عن محمد بن عبد الرحمن بن ثوبان، روى عنه ابن أبي ذئب.(@)PageV01P002(@)(@@) [ج 4: ص 152](@)(@@)(@@)(@@) ||| AUTO عقبة بن واصل بن عبد الله بن الشخير(@)(@@) ابن أخي مطرف، يروي عن عمه مطرف بن عبد الله، روى عنه الأسود بن شيبان.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي زينب(@)(@@) قوله، روى عنه رجاء بن أبي سلمة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي صالح(@)(@@) من أهل الكوفة، يروي عن جماعة من التابعين، روى عنه أهلها.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي جسرة(@)(@@) يروي عن الحسن، وابن سيرين، روى عنه سلام بن مسكين.(@)(@@)(@@)(@@) ||| AUTO عقبة بن علقمة المعافري(@)(@@) يروي عن أبي عقال عن أنس بن مالك، روى عنه أحمد بن البحري الرملي.(@)(@@)(@@)(@@) ||| AUTO أبو الجلاس اسمه عقبة بن سيار السلمي(@)(@@) من أهل الشام، سكن البصرة، يروي عن عثمان بن جحاش، روى عنه عبد الوارث بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عقبة الأسدي(@)(@@) يروي عن أبي العلاء بن الشخير، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عبد الله الرفاعي(@)(@@) يروي عن ابن سيرين وسالم، روى عنه ابن المباك.(@)(@@)(@@)(@@) ||| AUTO عقبة بن صهيب بن أبي الصهباء الباهلي(@)(@@) من أهل البصرة، يروي عن PageV01P002 [ج 4: ص 153] سالم، والحجازيين والحسن، وابن سيرين، روى عنه زيد بن الحباب، وأبو الوليد الطيالسي.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي يزيد القرشي(@)(@@) من أهل المدينة، يروي عن زيد بن 
ms1133	 أسلم، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO عقبة بن موسى(@)(@@) من أصدقاء داود الطائي ممن له الفضائل المذكورة في تعبده، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عطية الرفاعي(@)(@@) يروي عن قتادة، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي الصهباء بصري(@)(@@) يروي عن سالم بن عبد الله بن عمر، روى عنه جويرية بن أشرس والبصريون، سمعت أبا يعلى، يقول: سألت يحيى بن معين، عن عقبة بن أبي الصهباء، فقال: ثقة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن إسحاق السلمي(@)(@@) من أهل الكوفة، يروي عن إسماعيل بن أبي خالد، روى عنه أبو إدريس، وإسحاق بن منصور.(@)(@@)(@@)(@@) ||| AUTO عقبة بن مسلم التجيبي(@)(@@) مصري، يروي عن أبي عبد الرحمن الحبلي، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي العيزار(@)(@@) الكوفي، يروي عن الشعبي والنخعي، روى عنه عبد الواحد بن زياد، يعتبر حديثه من غير رواية ابنه يحيى عنه، لأن يحيى بن عقبة ضعيف الحديث.(@)(@@)(@@)(@@) ||| AUTO عقبة بن خالد الشني(@)(@@) يروي عن أم شبيب عن أم سلمة، روى عنه مسلم بن إبراهيم.(@)(@@) (393) -[4: 153] حدثنا أبو خليفة، قال: ثنا مسلم بن إبراهيم، قال: ثنا عقبة بن خالد، قال: ثنا الحسن، PageV01P002 [ج 4: ص 154] قال: بينما نحن عند عمران بن حصين إذ قال له رجل: يا أبا نجيد! حدثنا بالقرآن، قال: " أليس تقرأ القرآن {وأقيموا الصلاة وآتوا الزكاة} أكنتم تعرفون مواقيتها وركوعها وسجودها وحدودها؟ أكنت تدري كم الزكاة في الورق والذهب والإبل والغنم وأصناف المال؟ شهدت ووعيت فرض رسول الله صلى الله عليه وسلم الزكاة كذا وكذا؟، فقال الرجل: أحييتني أحياك الله أبا نجيد "!، قال: فما مات ذلك الرجل حتى صار من فقهاء المسلمين(@)(@@)(@@)(@@) ||| AUTO عقبة بن خالد بن عقبة بن خالد السكوني، كنيته أبو مسعود(@)(@@) من أهل الكوفة، يروي عن يحيى بن سعيد الأنصاري وهشام بن عروة وعبيد الله بن عمر، روى عنه أحمد بن حنبل والكوفيون(@)(@@)(@@)(@@) ||| AUTO عامر بن جشيب أبو خالد الشامي،(@)(@@) يروي عن خالد بن معدان، روى عنه لقمان بن عامر الوصابي، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عامر بن 
ms1134	 شقيق بن جمرة الأسدي(@)(@@)(@@)(@@) ||| AUTO من أهل الكوفة، يروي عن أبي وائل، روى عنه الثوري ومسعر وابن عيينة.(@)(@@) عامر بن يحيى المصري،(@)(@@) يروي عن أبي عبد الرحمن الحبلي، روى عنه الليث بن سعد، وخالد بن يزيد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عامر بن عبد الله بن نسطاس(@)(@@) من أهل المدينة، يروي عن الحجازيين، روى عنه عبد الله بن يزيد بن هرمز.(@)(@@) عامر بن عبد الله،(@)(@@) يروي عن شهر بن حوشب، روى عنه قرة بن خالد السدوسي.(@)PageV01P002(@)(@@) [ج 4: ص 155](@)(@@)(@@)(@@) ||| AUTO عامر بن عبدة،(@)(@@) يروي عن أبي المليح بن أسامة عداده في أهل البصرة، روى عنه أبو أسامة، وليس هذا بعامر بن عبدة البجلي صاحب بن مسعود ذاك تابعي قد ذكرناه في كتاب التابعين.(@)(@@)(@@)(@@) ||| AUTO عامر بن حصين بن قيس اليربوعي الحنظلي(@)(@@) أخو زياد بن حصين، يروي عن أبيه عداده في أهل البصرة، روى عنه عوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO عامر بن عقبة العقيلي،(@)(@@) يروي عن أبيه عن أبي هريرة، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عامر بن مصعب،(@)(@@)(@@)(@@) ||| AUTO يروي عن طاوس، روى عنه ابن جريج.(@)(@@) عامر بن عبد الله العقيلي،(@)(@@) يروي عن أبيه عن أبي هريرة، روى عنه يحيى بن أبي كثير، وأبو عبد الله بن شقيق العقيلي.(@)(@@)(@@)(@@) ||| AUTO عامر بن رزيق(@)(@@) مولى بني عامر، يروي المقاطيع عداده في أهل البصرة، روى عنه القاسم بن الفضل الحداني.(@)(@@)(@@)(@@) ||| AUTO عامر بن هني،(@)(@@)(@@)(@@) ||| AUTO يروي عن محمد بن علي بن الحنفية روى علي بن عبد الأعلى عن أبيه، عنه.(@)(@@) عامر بن السبط الجذامي وقد قيل: عامر بن السمط والصحيح السمط، كنيته أبو كنانة(@)(@@) من أهل الكوفة، يروي عن أبي الغريف عبد الله بن خليفة الهمداني وكان حافظا، روى عنه علي بن مسهر، وهو الذي روى عاصم بن محمد بن زيد بن عبد الله بن عمر، عن عامر بن السمط، عن معاوية بن إسحاق بن طلحة، عن عطاء بن يسار، عن ابن مسعود حديث الخلفاء.(@)PageV01P002(@)(@@) [ج 4: ص 156](@)(@@)(@@)(@@) ||| AUTO عطاء بن السائب بن زيد الثقفي، كنيته أبو زيد 
ms1135	(@)(@@) من أهل الكوفة، وقد قيل: إنه عطاء بن السائب بن مالك، يروي عن أبيه، والكوفيين، وقد قيل: إنه سمع من أنس ولم يصح ذلك عندي، مات سنة ست وثلاثين ومائة، وكان قد اختلط بآخره، ولم يفحش خطاءه حتى يستحق أن يعدل به عن مسلك العدول بعد تقدم صحة ثباته في الروايات، روى عنه الثوري، وشعبة، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عطاء بن مسعود الكعبي(@)(@@) عداده في أهل المدينة، يروي عن أبيه، روى عنه موسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO عطاء بن يعقوب الكيخاراني(@)(@@) من أهل اليمن مولى بن سباع وكيخاران موضع باليمن نسب إليه، يروي عن أم الدرداء، روى عنه الزهري، والقاسم بن أبي بزة، ومن زعم أنه سمع معاذ بن جبل فقد وهم.(@)(@@)(@@)(@@) ||| AUTO عطاء بن قرة السلولي(@)(@@) يروي عن عبد الله بن ضمرة السلولي، روى عنه عبد الرحمن بن يزيد بن جابر، وعبد الرحمن بن ثابت بن ثوبان الشاميان.(@)(@@)(@@)(@@) ||| AUTO عطاء الأنصاري(@)(@@) من أهل الشام، يروي عن أبي أسيد بن ثابت، روى عنه عبد الله بن عيسى.(@)(@@)(@@)(@@) ||| AUTO عطاء بن مسلم(@)(@@) يروي عن وهب بن منبه، روى عنه أهل اليمن، PageV01P002 [ج 4: ص 157](@)(@@) (394) -[4: 157] حدثنا أبو خليفة، قال: ثنا علي بن المديني، قال: ثنا محمد بن عمرو بن مقسم الصنعاني، قال: حدثنا عطاء بن مسلم، عن وهب بن منبه، قال: " كان شعيب رجلا صالحا ولم يكن نبيا "(@)(@@)(@@)(@@) ||| AUTO عطاء بن مسروق الفزاري(@)(@@) مولى القاسم بن محمد، يروي المراسيل والمقاطيع، روى عنه بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عطاء بن أبي مروان الأسلمي(@)(@@) من أهل المدينة، كنيته أبو مصعب، يروي عن أبيه والمدنيين، روى عنه موسى بن عقبة وغيلان بن جامع والثوري، مات في ولاية أبي العباس السفاح واسم أبي مروان عبد الرحمن بن مغيث.(@)(@@)(@@)(@@) ||| AUTO عطاء بن خباب(@)(@@) يروي عن أبيه، وعطاء بن أبي رباح، روى عنه ابنه محمد بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عطاء بن دينار الهذلي(@)(@@) يروي عن سعيد بن جبير، روى عنه عمرو بن الحارث، وسعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عطاء بن جندب(@)(@@) يروي 
ms1136	 عن ابن سيرين، روى عنه أبان بن خالد.(@)(@@)(@@)(@@) ||| AUTO عطاء بن أبي راشد(@)(@@) يروي عن عبد الله بن الحارث، روى عنه محمد بن عمرو بن علقمة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عبد الله السليمي الزاهد(@)(@@) من أهل البصرة، يروي عن عبد الله بن غالب الحداني، ومالك بن دينار، روى عنه نوح بن قيس الطاحي وأهل البصرة، كان فيمن بايع بن الأشعث وقاتل معه حتى قتل، لست احفظ له سماعا ولا رواية عن أحد من PageV01P002 [ج 4: ص 158] الصحابة، فلذلك أدخلناه في هذه الطبقة، وكان من العباد بقى في متعبده أربعين سنة لا يفطر نهارا ولا ينام ليلا مع دوام البكاء والأنين وكثرة التوجع والحنين إلى أن مات.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عطاء بن مضاء الصغير(@)(@@) يروي عن الحسن، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عطاء بن خالد(@)(@@) يروي عن عامر بن عبد الله بن الزبير، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عطاء الخشك(@)(@@) بصري، يروي عن ابن سيرين، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن محمد(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه أبو حمزة السكري.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عروة(@)(@@) يروي عن الحسن، روى عنه يحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عبد الله الأزرق، كنيته أبو همام(@)(@@) يروي عن الحسن، روى عنه جعفر بن سليمان الضبعي ومحمد بن مروان العقيلي الحكايات في الرقائق.(@)(@@) عطاء(@)(@@) شيخ، يروي عن حكيم بن يزيد عن أبيه، ويقال إن لأبيه صحبة، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عطاء بن مسلم الخفاف(@)(@@) من أهل حلب، يروي عن الأعمش، وأهل الكوفة، روى عنه أهل الشام والعراق، مات في شهر رمضان سنة تسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن المنذر بن الزبير بن العوام القرشي(@)(@@) يروي عن عروة بن الزبير وعبيد الله بن عبد الله بن عمر، روى عنه هشام بن عروة وحماد بن سلمة وهو أخو فاطمة بنت المنذر.(@)PageV01P002(@)(@@) [ج 4: ص 159](@)(@@)(@@)(@@) ||| AUTO عاصم بن محمد بن زيد بن عبد الله بن عمر بن الخطاب(@)(@@) أخو واقد، وعمر، وزيد، وأبي بكر، يروي عن أبيه، 
ms1137	 روى عنه الحجازيون، وأهل العراق، وهو الذي روى شبابة، عن عاصم بن محمد، عن محمد بن سوقة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن كليب بن شهاب الجرمي(@)(@@) من أهل الكوفة، يروي عن أبيه، عن وائل بن حجر، روى عنه الثوري، وشعبة، مات سنة سبع وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن أبي النجود الأسدي وهو عاصم بن بهدلة(@)(@@) كان اسم أبي النجود بهدلة، كنيته أبو بكر من أهل الكوفة، يروي عن أبي وائل وزر بن حبيش، روى عنه أبو بكر بن عياش، وأهل العراق، مات سنة ثمان وعشرين ومائة وكان من القراء.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر الفهري(@)(@@) يروي عن امرأة عن عائشة، روى عنه أبو وهب الجيشاني عداده في أهل مصر.(@)(@@)(@@)(@@) ||| AUTO عاصم بن راشد(@)(@@) يروي عن الحسن، روى عنه سهل بن حصين.(@)(@@)(@@)(@@) ||| AUTO عاصم بن هبيرة(@)(@@) يروي عن الكوفيين والمغيرة بن مقسم، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمرو بن أبي أحمد بن جحش القرشي(@)(@@) يروي عن الحجازيين، روى عنه بكير بن الأشج.(@)PageV01P002(@)(@@) [ج 4: ص 160](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عاصم بن عمر بن عثمان(@)(@@) يروي عن عروة عن عائشة، روى عنه عمرو بن عثمان بن هانئ.(@)(@@) عاصم(@)(@@) مولى قريبة بنت محمد بن أبي بكر الصديق، كنيته أبو بكر، سكن واسط وهو والد علي بن عاصم، يروي عن المدنيين، روى عنه شعبة، وهشيم.(@)(@@)(@@)(@@) ||| AUTO عاصم بن مخلد(@)(@@) يروي عن أبي الأشعث الصنعاني عن شداد بن أوس، روى عنه قزعة بن سويد.(@)(@@)(@@)(@@) ||| AUTO عاصم العنزي(@)(@@) يروي عن نافع بن جبير بن مطعم، عن أبيه، قال: كان النبي صلى الله عليه وسلم إذا دخل في الصلاة، قال: " الله أكبر كبيرا ثلاثا والحمد لله كثيرا وسبحان الله بكرة وأصيلا اللهم إني أعوذ بك من الشيطان الرجيم من نفخه ونفثه وهمزه "، كذا قال: شعبة، عن عمرو بن مرة، عن عاصم العنزي، وقال مسعر: عن عمرو بن مرة، عن رجل من عنزة، وقال بن إدريس: عن حصين، عن عمرو بن مرة، عن عباد بن عاصم، عن نافع بن جبير، وقال عباد 
ms1138	 بن العوام: عن حصين، عن عمرو بن مرة، عن عمار بن عاصم، عن نافع بن جبير، وقال عباد بن العوام عن حصين عن عمروبن مرة عن عمار بن عاصم عن نافع بن جبير، وهو عند بن عياش: عن عبد العزيز بن عبيد الله بن حمزة بن صهيب، عن عبد الرحمن بن نافع بن جبير بن مطعم، عن أبيه بطوله: " ونفخه الكبر وهمزه الموتة ونفثه الشعر ".(@)(@@)(@@)(@@) ||| AUTO عاصم بن رجاء بن حيوة الكندي(@)(@@) من أهل الشام، يروي عن أبيه، والشاميين، روى عنه عبد الله بن داود الخريبي، وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عاصم أبو مالك العطاردي(@)(@@) يروي عن الحسن، روى عنه زيد بن الحباب، وعبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عبد الله(@)(@@) يروي عن صفوان بن محرز، روى عنه داود بن أبي هند.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر بن حفص(@)(@@) أخو عبيد الله بن عمر، يروي عن PageV01P002 [ج 4: ص 161] عبد الله بن دينار، روى عنه عبد الله بن نافع يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عاصم بن سويد بن عامر بن يزيد بن جارية الأنصاري(@)(@@) من أهل المدينة، يروي عن يحيى بن سعيد الأنصاري، روى عنه محمد بن الصباح الجرجرائي وعلي بن الحجر السعدي.(@)(@@)(@@)(@@) ||| AUTO عاصم بن شبرمة(@)(@@) الكوفي، يروي عن الحسن، قوله، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن القعقاع بن شبرمة الضبي(@)(@@) ابن أخي عبد الله بن شبرمة من أهل الكوفة، يروي عن أبي زرعة بن عمرو بن جرير، روى عنه الثوري، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد الله بن صياد المديني(@)(@@) يروي عن عطاء بن يسار والمدنيين، روى عنه مالك بن أنس، كنيته أبو أيوب من بني النجار، مات في ولاية مروان بن محمد.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد الله بن طعمة(@)(@@) يروي عن سعيد بن المسيب، روى عنه محمد بن إسحاق، ويزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عمارة بن غزية بن الحارث بن عمرو بن غزية بن عمرو بن ثعلبة بن خنساء بن مبذول المازني(@)(@@) من أهل المدينة، يروي عن الزهري، والربيع بن 
ms1139	 PageV01P002 [ج 4: ص 162] سبرة وأم عمارة بن غزية أم إسماعيل بنت أبي حبة بن غزية بن عمرو، روى عنه سليمان بن بلال والدراوردي، وأهل الشام ومصر، مات سنة أربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن حفص بن عمر بن سعد بن عائذ القرظي(@)(@@) مولى بني مخزوم من أهل المدينة أخو عمر بن حفص، يروي عن أبيه، روى عنه عبد الرحمن بن سعد.(@)(@@)(@@)(@@) ||| AUTO عمارة بن مهاجر(@)(@@) يروي عن أبي بكر بن محمد بن عمرو بن حزم، روى عنه الدراوردي.(@)(@@)(@@)(@@) ||| AUTO عمارة بن مضرس البجلي(@)(@@) كوفي، يروي عن عكرمة، روى عنه ابنه الحسن بن عمارة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن طريف(@)(@@) وقد قيل: ابن مطرف، يروي عن يزيد بن أبي مريم، روى عنه يحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO عمارة بن أبي حفصة، كنيته أبو روح(@)(@@) واسم أبي حفصة ثابت مولى عتيك، يروي عن عكرمة عداده في أهل البصرة، روى عنه شعبة، وأهل العراق، مات سنة اثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عزاب اليحصبي(@)(@@) يروي عن عمته عن عائشة، روى عنه عبد الرحمن بن زياد بن أنعم يعتبر حديثه من غير رواية الإفريقي عنه.(@)(@@)(@@)(@@) ||| AUTO عمارة بن جارية(@)(@@) يروي عن عمرو بن يثربي، روى عنه عبد الرحمن بن أبي سعيد.(@)(@@)(@@)(@@) ||| AUTO عمارة بن حيان(@)(@@) يروي عن عكرمة، روى عنه الحسين بن واقد.(@)PageV01P002(@)(@@) [ج 4: ص 163](@)(@@)(@@)(@@) ||| AUTO عمارة بن ثوبان(@)(@@) يروي عن عطاء، روى عنه جعفر بن يحيى بن ثوبان.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد الرحمن أبو عبد الرحمن الإسكندراني(@)(@@) يروي عن عكرمة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمارة بن مهران المعولي العابد، كنيته أبو سعيد(@)(@@) من أهل البصرة، يروي عن الحسن، وأبي نضرة، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عمارة بن زاذان الصيدلاني(@)(@@) مولى تيم الله بن ثعلبة من أهل البصرة، كنيته أبو سلمة، يروي عن مكحول، روى عنه موسى بن إسماعيل، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن أبي شعيب القسملي(@)(@@) البصري عن مالك بن دينار سمع منه مسلم ومحمد بن المثنى.(@)(@@)(@@)(@@) ||| AUTO العلاء بن المسيب بن رافع الثعلبي(@)(@@) من 
ms1140	 أهل الكوفة، يروي عن أبيه وعطاء، روى عنه الثوري، وجرير بن حازم.(@)(@@) (395) -[4: 163] حدثنا محمد بن عمر بن الهمداني، قال: ثنا محمد بن أشكيب، قال: ثنا سعيد بن عمرو الأشعثي، قال: ثنا أبو زبيد، عن العلاء بن المسيب، عن سهيل بن أبي صالح، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: " إن الله إذا أحب عبدا .. " الحديث(@)(@@)(@@)(@@) ||| AUTO العلاء بن عبد الكريم اليامي، كنيته أبو عون(@)(@@) من أهل الكوفة، يروي عن مجاهد، روى عنه الثوري، ووكيع بن الجراح وكان من العباد الخشن.(@)PageV01P002(@)(@@) [ج 4: ص 164](@)(@@)(@@)(@@) ||| AUTO العلاء بن زياد بن مطر بن شريح العدوى(@)(@@) من أهل البصرة، يروي عن الحسن الحكايات، روى عنه هشام بن حسان، وأهل البصرة، وكان من عباد أهل البصرة وقرائهم، كان قد دبر غلاما له على أن يأتيه كل يوم برغيفين إلى أن يموت فكان ذلك قوته إلى أن مات.(@)(@@)(@@)(@@) ||| AUTO العلاء بن خالد الأسدي الكوفي(@)(@@) يروي عن أبي وائل، روى عنه الثوري، ومروان بن معاوية، والكوفيون.(@)(@@)(@@)(@@) ||| AUTO العلاء بن الحارث أبو وهب الحضرمي الدمشقي(@)(@@) يروي عن مكحول، روى عنه أهل الشام، مات سنة ست وثلاثين ومائة، يعتبر حديثه من رواية الثقات عنه.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عتبة اليحصبي(@)(@@) من أهل الشام، يروي عن خالد بن معدان، روى عنه الأوزاعي ومعاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عبد الله بن بدر الغنوي(@)(@@) يروي عن أبي الشعثاء جابر بن زيد، روى عنه أبو سنان والكوفيون.(@)(@@)(@@)(@@) ||| AUTO العلاء بن أبي العباس الشاعر(@)(@@) من أهل مكة واسم أبي العباس السائب بن فروخ مولى بني الديل، يروي عن أبي جعفر محمد بن علي، روى عنه الثوري، وابن جريج، وقد روى عن أبي الطفيل إن كان سمع منه.(@)PageV01P002(@)(@@) [ج 4: ص 165](@)(@@)(@@)(@@) ||| AUTO العلاء بن عبد الله بن رافع(@)(@@) يروي المراسيل، روى عنه جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO العلاء بن زهير الأزدي(@)(@@) يروي عن عبد الرحمن بن الأسود عن أبيه، روى عنه أبو نعيم الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO العلاء بن القاسم(@)(@@) يروي المقاطيع عن 