ms1515	 قرة بن أياس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13697 ) قال النبي :(@)(@@) | 30 ( صيام ثلاثة أيام من كل شهر صيام الدهر وهي أيام البيض : صبيحة ثلاث عشرة وأربع عشرة وخمس عشرة ) )(@)(@@) ( ن ع هب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13698 ) قال النبي :(@)(@@) | 30 ( صيام حسن ، صيام ثلاثة أيام من الشهر ) )(@)(@@) ( حم ن حب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13699 ) قال النبي :(@)(@@) | 30 ( صيام شهر رمضان بعشرة أشهر ، وصيام ستة أيام بعده بشهرين فذالك صيام السنة ) )(@)(@@) ( حم ن حب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13700 ) قال النبي :(@)(@@) | 30 ( صيام يوم السبت لا لك ولا عليك ) )(@)(@@) ( حم ) عن امرأة .(@)(@@)(@@)(@@) $ ( 13701 ) قال النبي :(@)(@@) | 30 ( صيام يوم عرفة ، إني أحتسب على الله أن يكفر PageV05P105 السنة التي قبله والسنة التي بعده ، وصيام يوم عاشوراء إني أحتسب على الله أن يكفر السنة التي قبله ) )(@)(@@) ( ت ه حب ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13702 ) قال النبي :(@)(@@) | 30 ( صيام يوم عرفة كصيام ألف يوم ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13703 ) قال النبي :(@)(@@) | 30 ( صيد البر لكم حلال وأنتم حرم ما لم تصيدوه أو يصد لكم ) )(@)(@@) ( ك هق ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13704 ) قال النبي :(@)(@@) | 30 ( صيام الرجل معلق بين السماء والأرض حتى يعطي صدقة الفطر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13705 ) قال النبي :(@)(@@) | 30 ( صيام يوم عرفة تعدل السنة والتي تليها ، وصيام عاشوراء يعدل سنة ) )(@)(@@) ابن أبي الدنيا في فضل عشر ذي الحجة عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13706 ) قال النبي :(@)(@@) | 30 ( صيام كل يوم من أيام عاشوراء كصيام شهر ، وصيام عرفة كصيام أربعة عشر شهرا ) )(@)(@@) ابن زنجويه عن راشد بن معبد مرسلا .(@)(@@)(@@)(@@) $ ( 13707 ) قال النبي :(@)(@@) | 30 ( صيام ثلاثة أيام من كل شهر صيام الدهر ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13708 ) قال النبي :(@)(@@) | 30 ( صيام يوم عرفة تكفر السنة التي فيها والسنة التي بعدها ) )(@)(@@) (