ms513	 مصري عن يزيد بن أبي حبيب وعدة وعنه بكر بن مضر وابن وهب وعدة وثق عابد بكاء مات 153 س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4295- (@)(@@) عنبسة بن الازهر الكوفي قاضي جرجان عن محارب بن دثار والسدي وعنه أحمد بن أبي طيبة وسفيان بن وكيع وجمع قال أبو حاتم لا بأس به وليس بحجة س(@)(@@)(@@)(@@) | 4296- (@)(@@) عنبسة بن خالد الايلي عن عمه يونس وابن جريج وعنه أحمد بن صالح وجماعة مات 198 خ مقرونا د(@)(@@)(@@)(@@) | 4297- (@)(@@) عنبسة بن سعيد الكوفي ثم الرازي قاضي الري عن زبيد اليامي وسماك وعنه بن المبارك(@)(@@) وزيد بن الحباب وعدة وثقوه ت س(@)(@@)(@@)(@@) | 4298- (@)(@@) عنبسة بن سعيد بن العاص الاموي أخو الاشدق عن أبي هريرة وأنس وعنه الزهري ومحمد بن عمرو بن علقمة وعدة وثقوه خ م د(@)(@@)(@@)(@@) | 4299- (@)(@@) عنبسة بن سعيد مولى عثمان عن جدته أم عياش وعنه ابنه روح ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4300- (@)(@@) عنبسة بن سعيد الكوفي الحاسب عن جده كثير رضيع عائشة وعنه حفيده إسماعيل بن صديق وابن مهدي وأبو الوليد وثقوه د(@)(@@)(@@)(@@) | 4301- (@)(@@) عنبسة بن سعيد الواسطي عن شهر والحسن وعنه عبد الوهاب الثقفي وغيره ضعفوه د(@)(@@)(@@)(@@) | 4302- (@)(@@) عنبسة بن أبي سفيان بن حرب عن أخته أم حبيبة وشداد بن أوس وعنه أبو صالح السمان وعطاء وآخرون حج بالناس سنة سبع وأربعين م 4(@)(@@)(@@)(@@) | 4303- (@)(@@) عنبسة بن عبد الرحمن بن عنبسة الاموي عن بن المنكدر وجماعة وعنه إسحاق بن أبي إسرائيل وعبد الواحد بن غياث وجمع قال البخاري تركوه ت ق(@)(@@)(@@)(@@) | 4304- (@)(@@) عنبسة بن عبد الواحد أبو خالد الاموي عن هشام بن عروة وطبقته وعنه أبو عبيد وسريج بن يونس وعدة ثقة يعد من الابدال د(@)(@@)(@@)(@@) | 4305- (@)(@@) عنترة بن عبد الرحمن عن عمر وعلي وعنه ابنه هارون وأبو سنان الشيباني وثق س(@)(@@)(@@)(@@) | 4306- (@)(@@) العوام بن حوشب الواسطي أحد الاعلام عن إبراهيم ومجاهد والطبقة وعنه شعبة ويزيد بن هارون وخلق وثقوه له نحو مائتي حديث توفي 148 ع(@)(@@)(@@)(@@) | 4307- (@)(@@) العوام بن عباد بن العوام حكى عنه الذهلي ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4308- (@)(@@) عوسجة عن بن عباس مولاه وعنه عمرو بن دينار وثق وقال البخاري لم يصح 
ms514	 حديثه 4(@)(@@)(@@)(@@) | 4309- (@)(@@) عوف الاعرابي عن أبي العالية والنهدي والعطاردي وعنه القطان وغندر وهوذة وعثمان بن الهيثم قال النسائي ثقة ثبت توفي 147 ع(@)(@@)(@@)(@@) | 4310- (@)(@@) عوف بن الحارث الازدي عن عمته عائشة وعدة وعنه هشام بن عروة ومحصن بن علي وجماعة وثق خ د س ق(@)(@@)(@@)(@@) | 4311- (@)(@@) عوف بن مالك الاشجعي حمل راية قومه يوم الفتح عنه جبير بن نفير والشعبي وعدة مات 73 ع(@)(@@)(@@)(@@) | 4312- (@)(@@) عوف بن مالك أبو الأحوص الجشمي عن بن مسعود وأبي موسى وعنه بن أخيه أبوالزعراء وأبو إسحاق وخلق وثقوه قتلته الخوارج م 4(@)(@@)(@@)(@@) | 4313- (@)(@@) صلى الله عليه وسلم عون بن أبي جحيفة عن أبيه وجماعة وعنه شعبة وسفيان وعدة وثقوه ع(@)(@@)(@@)(@@) | 4314- (@)(@@) عون بن سلام مولى بني هاشم عن أبي بكر النهشلي وإسرائيل وعدة وعنه مسلم ومطين وجمع مات 23 م(@)(@@)(@@)(@@) | 4315- (@)(@@) عز وجلعون بن أبي شداد عن أنس ومطرف بن الشخير وجماعة وعنه فطر ونوح بن قيس وعدة اختلف فيه ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4316- (@)(@@) عون بن صالح البارقي عن عطية وجماعة وعنه بن المبارك ووكيع س(@)(@@)(@@)(@@) | 4317- (@)(@@) عون بن عبد الله بن عتبة الهذلي الزاهد الفقيه أخو الفقيه عبيد الله عن أبي هريرة وابن عباس وجمع وعنه الزهري وأبو حنيفة وأبو العميس حديثه عن عمر في مسلم ولم يلحقه مات في حدود العشرين ومائة لان بن عيينة رآه يقال غالب رواياته عن الصحابة مرسلة م 4(@)(@@)(@@)(@@) | 4318- (@)(@@) عون بن عمارة العبدي عن حميد والتيمي وعنه أبو قلابة عبد الملك وعباس الدوري والحارث ضعفوه مات 212 ق(@)(@@)(@@)(@@) | 4319- (@)(@@) عون بن كهمس عن أبيه والتيمي وهشام بن حسان وعنه بن مثنى وبندار وعدة ثقة د(@)(@@)(@@)(@@) | 4320- (@)(@@) عويم بن ساعدة صحابي عقبي عنه ابنه عتبة ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4321- (@)(@@) عويمر بن أشقر بدري عنه عباد بن تميم ويحيى بن أبي سعيد ق(@)(@@)(@@)(@@) | 4322- (@)(@@) عويمر أبو الدرداء بن مالك وقيل بن عامر وقيل بن ثعلبة أسلم عقيب بدر عنه ابنه بلال وزوجته أم الدرداء وجبير بن نفير وأبو إدريس فرض له عمر فألحقه بالبدريين لجلالته مات 32 ع(@)(@@)(@@)(@@) | 4323- (@)(@@) العلاء بن بشير عن أبي الصديق الناجي 
ms515	 وعنه معلى بن زياد د(@)(@@)(@@)(@@) | 4324- (@)(@@) العلاء بن الحارث الحضرمي الدمشقي الفقيه عن أبي الاشعث الصنعاني ومكحول وعدة وعنه الاوزاعي والهيثم بن حميد ويحيى بن حمزة وثقوه قدري قال دحيم مقدم على أصحاب مكحول وقال أبو داود ثقة تغير عقله مات 136 م 4(@)(@@)(@@)(@@) | 4325- (@)(@@) العلاء بن الحضرمي حليف بني أمية صحابي له عشرة إخوة روى عنه أبو هريرة وغيره ولي البحرين فأقره الصديق توفي 21 ع(@)(@@)(@@)(@@) | 4326- (@)(@@) العلاء بن أبي حكيم سياف معاوية عنه الوليد بن أبي الوليد وثق ت س(@)(@@)(@@)(@@) | 4327- (@)(@@) لعلاء بن خالد عن أخيه ربعي والحسن وعنه مسدد وقتيبة وجمع لين ت(@)(@@)(@@)(@@) | 4328- (@)(@@) الله عز وجلالعلاء بن خالد الكاهلي عن أبي وائل وعنه سفيان وحفص بن غياث صدوق م ت(@)(@@)(@@)(@@) | 4329- (@)(@@) العلاء بن زهير الازدي عن عبد الرحمن بن الاسود وعنه وكيع والفريابي وعدة وثق س(@)(@@)(@@)(@@) | 4330- (@)(@@) العلاء بن زياد أبو نصر العدوي أرسل وعنه قتادة ومطر الوراق وهشام بن حسان وكان(@)(@@) PageV00P000(@)(@@) عابدا قانتا بكاء وله عن أبي هريرة مات 94 س ق قلت(@)(@@)(@@)(@@) | 4331- (@)(@@) والعلاء بن زياد آخر له عن الحسن وعنه حماد بن زيد خلطهما شيخنا المزي س(@)(@@)(@@)(@@) | 4332- (@)(@@) العلاء بن زيد ويقال بن زيدل أبو محمد الثقفي عن أنس وشهر وعنه يزيد بن هارون وجماعة تركه أبو داود وغيره ق(@)(@@)(@@)(@@) | 4333- (@)(@@) العلاء بن سالم الحذاء عن أبي معاوية وشعيب بن حرب وعنه بن ماجة وابن صاعد وابن مخلد وسط مات 258 ق(@)(@@)(@@)(@@) | 4334- (@)(@@) العلاء بن صالح عن عدي بن ثابت والحكم وعنه أبو نعيم وعبيد الله بن موسى ثقة(@)(@@) يغرب د ت س ق(@)(@@)(@@)(@@) | 4335- (@)(@@) العلاء بن عبد الله بن رافع عن سعيد بن جبير وغيره وعنه بن علاثة وأبو سعيد المؤدب وعدة د س(@)(@@)(@@)(@@) | 4336- (@)(@@) العلاء بن عبد الجبار العطار بصري جاور سمع مبارك بن فضالة وطبقته وعنه البخاري وابن أبي مسرة وبشر بن موسى مات 212 خ ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4337- (@)(@@) العلاء بن عبد الرحمن أبو شبل مولى الحرقة أحد علماء المدينة عن أبيه ومعبد بن كعب وعنه شعبة ومالك وخلق قال أبو حاتم صالح أنكر 
ms516	 من حديثه أشياء مات في أول دولة المنصور م 4(@)(@@)(@@)(@@) | 4338- (@)(@@) العلاء بن عتبة الحمصي عن خالد بن معدان وعمير بن هانئ وعنه الاوزاعي وعبد الله بن سالم قال أبو حاتم صالح د(@)(@@)(@@)(@@) | 4339- (@)(@@) عز وجلالعلاء بن عصيم كوفي عن زهير بن معاوية وجماعة وعنه بن المديني والدارمي وثق مات 238 س(@)(@@)(@@)(@@) | 4340- (@)(@@) العلاء بن غرار عن بن عمر وعنه أبو إسحاق(@)(@@)(@@)(@@) | 4341- (@)(@@) العلاء بن الفضل أبو الهذيل المنقري عن أبيه وعبيد الله بن عكراش وعنه بندار وإسماعيل القاضي فيه ضعف مات 22 ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4342- (@)(@@) الله عز وجلالعلاء بن اللجلاج عن أبيه وابن عمر وعنه ابنه عبد الرحمن وغيره وثق ت(@)(@@)(@@)(@@) | 4343- (@)(@@) العلاء بن مسلمة الرواس البغدادي عن ضمرة وعلي بن عاصم وعنه الترمذي وابن صاعد وعدة اتهم ت(@)(@@)(@@)(@@) | 4344- (@)(@@) العلاء بن المسيب بن رافع الاسدي عن أبيه وإبراهيم وخيثمة بن عبد الرحمن وعنه جرير وابن فضيل وعدة وثق قال أبو حاتم صالح الحديث خ م د س ق(@)(@@)(@@)(@@) | 4345- (@)(@@) العلاء بن هلال بن عمر الرقي عن حماد وخلف بن خليفة وعنه ابنه هلال ومحمد بن جبلة الرافقي وعدة ضعفه أبو حاتم مات 215 س(@)(@@)(@@)(@@) | 4346- (@)(@@) العلاء بن أخي شعيب الرازي عن فلان وعنه شعبة وثق د العلاء الجريري عن عمرو بن شعيب وعنه همام والاصح عباس الجريري سالعلاء الجريري عن عمرو بن شعيب وعنه همام والاصح عباس الجريري س 2607(@)(@@)(@@)(@@) | 4347- (@)(@@) العلاء عن داود وعنه أبو عبد الرحيم الحراني س(@)(@@)(@@)(@@) | 4348- (@)(@@) علاج بن عمرو عن بن عمر وعنه أشعث بن سليم وغيره وثق د(@)(@@)(@@)(@@) | 4349- (@)(@@) علاق بن أبي مسلم عن جابر وابن الحنفية وعنه عنبسة بن عبد الرحمن واه ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4350- (@)(@@) علاقة التميمي له صحبة قال الشعبي عن خارجة بن الصلت عن عمه فقال البغوي هو علاقة بن صحار وقال خليفة عبد الله بن عثير د س(@)(@@)(@@)(@@) | 4351- (@)(@@) عياش بن الازرق أو الازرق عن بن وهب وعنه أبو داود والفريابي وثق د(@)(@@)(@@)(@@) | 4352- (@)(@@) عز وجل عياش بن أبي ربيعة المخزومي من المهاجرين عنه أنس وجماعة قتل يوم اليرموك أو اليمامة ق(@)(@@)(@@)(@@) | 4353- (@)(@@) عياش بن 
ms517	 عباس القتباني عن أبي سلمة ومرثد اليزني وعنه ابنه عبد الله والليث ومفضل بن فضالة وعدة وثق مات 133 م 4(@)(@@)(@@)(@@) | 4354- (@)(@@) عياش بن عقبة الحضرمي عن خير بن نعيم وجماعة وعنه بن المبارك والمقرئ وجمع وثق مات 16 د س(@)(@@)(@@)(@@) | 4355- (@)(@@) عز وجل عياش بن عمرو العامري الكوفي عن بن أبي أوفى وإبراهيم التيمي وعنه سفيان وشعبة وثق م س(@)(@@)(@@)(@@) | 4356- (@)(@@) عياش بن الوليد الرقام عن معتمر والوليد بن مسلم وعنه البخاري وأبو داود وأبو زرعة وعدة مات 226 خ د(@)(@@)(@@)(@@) | 4357- (@)(@@) عياض بن حمار تميمي له وفادة نزل البصرة عنه مطرف ويزيد ابنا الشخير والحسن م 4(@)(@@)(@@)(@@) | 4358- (@)(@@) عياض بن عبد الله بن سعد بن أبي سرح العامري عن أبي هريرة وصحابة وعنه داود بن(@)(@@) قيس وابن عجلان وعدة ع(@)(@@)(@@)(@@) | 4359- (@)(@@) عياض بن عبد الله الفهري عن الزهري وأبي الزبير وعنه الليث وابن وهب وثق وقال أبو حاتم ليس بقوي م د س ق عياض بن عروة ويقال بالقلب عن عائشة وعنه عبد الله بن عبيد بن عمير سعياض بن عروة ويقال بالقلب عن عائشة وعنه عبد الله بن عبيد بن عمير س 3779(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4360- (@)(@@) عياض بن عمرو الاشعري مختلف في صحبته عنه الشعبي وحصين قال أبو حاتم تابعي أرسل م ق عياض بن غطيف عن أبي عبيدة وعنه سليم بن عامر وغيره سعياض بن غطيف عن أبي عبيدة وعنه سليم بن عامر وغيره س 4427(@)(@@)(@@)(@@) | 4361- (@)(@@) عياض بن هلال وقيل بالقلب عن أبي سعيد وعنه يحيى بن أبي كثير 4(@)(@@)(@@)(@@) | 4362- (@)(@@) عياض البجلي عن معقل بن يسار وعنه شعبة وثق س(@)(@@)(@@)(@@) | 4363- (@)(@@) العيزار بن حريث العبدي عن الحسين وابن عباس وعنه ابنه الوليد وأبو إسحاق ويونس بن أبي إسحاق وعدة وثقوه م د ت س(@)(@@)(@@)(@@) | 4364- (@)(@@) عيسى بن إبراهيم البركي مولى بني هاشم عن حماد بن سلمة وعبد العزيز بن مسلم وعنه أبو داود وأحمد الابار ومحمد البوشنجي وعدة وثق مات 228 د(@)(@@)(@@)(@@) | 4365- (@)(@@) عيسى بن إبراهيم بن مثرود أبو موسى الغافقي عن بن عيينة وابن وهب وعنه أبو 
ms518	 داود والنسائي وابن خزيمة وأبو بكر بن زياد وخلق ثقة مات 261 د س(@)(@@)(@@)(@@) | 4366- (@)(@@) عيسى بن أحمد العسقلاني البلخي عن بقية وابن وهب وعنه الترمذي والنسائي وأبو عوانة والهيثم بن كليب وثقه النسائي مات 268 ت س(@)(@@)(@@)(@@) | 4367- (@)(@@) عيسى بن أيوب القيني الدمشقي عن مكحول وعنه الوليد وأبو مسهر د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4368- (@)(@@) عيسى بن جارية الانصاري عن جرير وجابر وعنه أبو صخر حميد بن زياد ويعقوب القمي مختلف فيه قال بن معين عنده مناكير ق(@)(@@)(@@)(@@) | 4369- (@)(@@) عيسى بن حطان الرقاشي عن علي وعبد الله بن عمرو وعنه بن جدعان وابن جحادة وثق د ت س(@)(@@)(@@)(@@) | 4370- (@)(@@) عيسى بن حفص بن عاصم العدوي لقبه رباح عن أبيه وابن المسيب وعنه القطان والقعنبي وآخرون وثقوه مات 159 خ م د س ق(@)(@@)(@@)(@@) | 4371- (@)(@@) عيسى بن حماد زغبة عن الليث وعبد الرحمن بن زيد بن أسلم وجمع وعنه مسلم وأبو داود والنسائي وابن ماجة وابن أبي داود وأحمد بن عيسى الوشاء قال أبو حاتم ثقة رضا مات 248 في ذي الحجة م د س ق(@)(@@)(@@)(@@) | 4372- (@)(@@) عز وجل عيسى بن دينار الخزاعي عن أبيه والباقر وعنه وكيع ومحمد بن سابق وعدة وثقه بن معين د ت(@)(@@)(@@)(@@) | 4373- (@)(@@) عيسى بن سليم أبو حمزة الرستني عن راشد بن سعد وجماعة وعنه بقية وعيسى بن يونس وعدة وثق م س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4374- (@)(@@) عيسى بن سنان الحنفي أبو سنان القسملي الفلسطيني حدث بالبصرة عن يعلى بن شداد بن أوس ووهب وعنه عيسى بن يونس وأبو أسامة وجمع ضعف ولم يترك ت ق(@)(@@)(@@)(@@) | 4375- (@)(@@) عيسى بن سهل عن جده رافع بن خديج وعنه موسى بن عبيدة وسعيد بن يزيد القتباني وثق ومن سماه عثمان وهم س(@)(@@)(@@)(@@) | 4376- (@)(@@) عيسى بن شاذان البصري القطان الحافظ عن أبي الوليد وعارم وعنه أبو داود وابن صاعد وخلق مات شابا د(@)(@@)(@@)(@@) | 4377- (@)(@@) عيسى بن طلحة بن عبيد الله من الحكماء العقلاء عن أبي هريرة وأبيه وعائشة وعنه الزهري ويزيد بن أبي حبيب وعدة مات سنة مائة ظنا ع(@)(@@)(@@)(@@) | 4378- (@)(@@) عيسى بن طهمان بصري نزل الكوفة سمع أنسا 
ms519	 وناسا وعنه يحيى بن آدم وقبيصة وعدة ثقة خ س(@)(@@)(@@)(@@) | 4379- (@)(@@) عيسى بن عاصم الاسدي عن زر وشريح وعنه معاوية بن صالح وثور وغيرهما وثق د ت ق(@)(@@)(@@)(@@) | 4380- (@)(@@) عيسى بن عبد الله بن أنيس الانصاري عن أبيه وعنه عبيد الله بن عمر وأخوه عبد الله وثق د ت(@)(@@)(@@)(@@) | 4381- (@)(@@) عيسى بن عبد الله بن مالك الدار عن زيد بن وهب وغيره وعنه فليح وابن لهيعة وعدة وثق د ق(@)(@@)(@@)(@@) | 4382- (@)(@@) عيسى بن عبد الاعلى الفروي عن إسحاق بن عبد الله بن أبي طلحة وغيره وعنه الوليد بن مسلم د ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4383- (@)(@@) عيسى بن عبد الرحمن الزرقي عن الزهري وزيد بن أسلم وعنه الوليد بن مسلم والطيالسي واه ق(@)(@@)(@@)(@@) | 4384- (@)(@@) عيسى بن عبد الرحمن بن أبي ليلى عن أبيه وعبد الله بن حكيم وعنه أخوه محمد وابنه عبد الله وثقوه د ت ق عيسى بن عبد الرحمن السلمي أبو سلمة عن الشعبي والحسن وعنه يحيى بن آدم وعفان ثقة بخ قد عس(@)(@@)(@@)(@@) | 4385- (@)(@@) عيسى بن عبيد الكندي أبو المنيب المروزي عن أبي مجلز وابن بريدة وعنه عبدان ونعيم بن حماد وعدة قال أبو زرعة لا بأس به د ت س(@)(@@)(@@)(@@) | 4386- (@)(@@) عيسى بن عثمان النهشلي الكوفي عن عمه يحيى بن عيسى وعنه الترمذي وابن جرير وابن أبي داود مات 251 ت(@)(@@)(@@)(@@) | 4387- (@)(@@) عيسى بن أبي عزة عن الشعبي وعنه سفيان وإسرائيل وثقوه ت س(@)(@@)(@@)(@@) | 4388- (@)(@@) عيسى بن علي العباسي صاحب نهر عيسى عن أبيه وعنه الرشيد وشيبان النحوي وعدة لم يل عملا قال بن معين ليس به بأس مات 16 وقيل بعدها د ت(@)(@@)(@@)(@@) | 4389- (@)(@@) عيسى بن عمر بن موسى التيمي عن نافع وعنه بن المبارك وجماعة وثق ق(@)(@@)(@@)(@@) | 4390- (@)(@@) عيسى بن عمر الاسدي الكوفي المقرئ صاحب الحروف ويعرف بالهمداني لا عيسى بن(@)(@@) PageV00P000(@)(@@) عمر البصري الثقفي صاحب النحو عن عطاء وعمرو بن مرة والمسيب بن عبد خير وعنه الفريابي وعبيد الله وخلاد بن يحيى وخلق قال أحمد ليس به بأس مات 156 ت س(@)(@@)(@@)(@@) | 4391- (@)(@@) عيسى بن عمر عن عبد الله بن علقمة 
ms520	 وعنه عمرو بن يحيى س(@)(@@)(@@)(@@) | 4392- (@)(@@) عيسى بن أبي عيسى الحناط عن أبيه وأنس والشعبي وعنه وكيع وابن أبي فديك وعدة ضعفوه وهو كوفي سكن المدينة وكان خياطا أيضا وباع في الخبط مات 151 ق(@)(@@)(@@)(@@) | 4393- (@)(@@) عيسى بن أبي عيسى السليحي الحمصي عن إسماعيل بن عياش ومحمد بن حمير وعنه أبو داود والنسائي وأبو عروبة وابن أبي داود وثق د س(@)(@@)(@@)(@@) | 4394- (@)(@@) عيسى بن فائد تابعي عنه يزيد بن أبي زياد لم يدرك سعد بن عبادة د(@)(@@)(@@)(@@) | 4395- (@)(@@) عيسى بن محمد أبو عمير بن النحاس الرملي عن بن عيينة والوليد وعنه أبو داود والنسائي وابن ماجة وابن أبي داود والدولابي وعدة حافظ عابد فقير مات 256 د س ق(@)(@@)(@@)(@@) | 4396- (@)(@@) عيسى بن المختار عن طلحة بن مصرف ونحوه وعنه بن عمه بكر بن عبد الرحمن د س ق(@)(@@)(@@)(@@) | 4397- (@)(@@) عيسى بن مساور البغدادي الجوهري عن يغنم والوليد بن مسلم وعنه النسائي وأبو حامد الحضرمي وعدة مات 244 س(@)(@@)(@@)(@@) | 4398- (@)(@@) عيسى بن معقل عن جدته أم معقل الاسدية وغيرها وعنه موسى بن عقبة وابن إسحاق وثق د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4399- (@)(@@) عيسى بن معمر عن عبد الله بن عمرو بن الفغواء وغيره وعنه مصعب بن ثابت وابن إسحاق ضعف د(@)(@@)(@@)(@@) | 4400- (@)(@@) عيسى بن المنذر الحمصي السلمي عن إسماعيل بن عياش وبقية وعنه ابنه موسى وابن(@)(@@) واره والكوسج وثق م(@)(@@)(@@)(@@) | 4401- (@)(@@) عيسى بن موسى غنجار أبو أحمد الازرق محدث بخاري عن مقاتل بن حيان وعيسى بن عبيد والثوري وعنه محمد بن سلام ومحمد بن أمية الساوي وعدة صدوق لكنه روى عن مائة مجهول مات 186 خت ق(@)(@@)(@@)(@@) | 4402- (@)(@@) عيسى أخو سليمان بن موسى الدمشقي عن ربيعة بن يزيد وجماعة وعنه الوليد بن مسلم وعمرو بن أبي سلمة وثقه دحيم د ق(@)(@@)(@@)(@@) | 4403- (@)(@@) عيسى بن ميمون المدني عن القاسم وسالم وعنه حجاج بن محمد وآدم وشيبان بن فروخ ضعفوه ت ق(@)(@@)(@@)(@@) | 4404- (@)(@@) عيسى بن نميلة الفزاري عن أبيه وعنه الدراوردي وثق د(@)(@@)(@@)(@@) | 4405- (@)(@@) عيسى بن هلال الصدفي عن عبد الله بن عمرو وعنه دراج أبو السمح وكعب بن علقمة وجماعة 