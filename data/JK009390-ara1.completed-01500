ms1482	 ( شوبوا شيبكم بالحناء فإنه أسرى لوجوهكم ، وأطيب لأفواهكم ، وأكثر لجماعكم ، الحناء سيد ريحان أهل الجنة ، الحناء يفصل ما بين الكفر والإيمان ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13338 ) قال النبي :(@)(@@) | 30 ( شوبوا مجلسكم بمكدر اللذات الموت ) )(@)(@@) ابن أبي الدنيا في ذكر الموت عن عطاء الخراساني مرسلا .(@)(@@)(@@)(@@) ||| ( الشين مع الهاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13339 ) قال النبي :(@)(@@) | 30 ( شهادة المسلمين بعضهم على بعض جائزة ، ولا تجوز شهادة العلماء بعضهم على بعض لأنهم حسد ) )(@)(@@) ( ك ) في تاريخه عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13340 ) قال النبي :(@)(@@) | 30 ( شهداء الله في الأرض ، أمناء الله على خلقه قتلوا أو ماتوا ) )(@)(@@) ( حم ) عن رجال .(@)(@@)(@@)(@@) $ ( 13341 ) قال النبي :(@)(@@) | 30 ( شهدت غلاما مع عمومتي حلف المطيبين ، فما يسرني أن لي حمر النعم وأني أنكته ) )(@)(@@) ( حم ك ) عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@) PageV05P054(@)(@@)(@@)(@@) $ ( 13342 ) قال النبي :(@)(@@) | 30 ( شهر الصبر ، وثلاثة أيام من كل شهر صوم الدهر ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13343 ) قال النبي :(@)(@@) | 30 ( شهر رمضان شهر الله ، وشهر شعبان شهري : شعبان المطهر ، ورمضان المكفر ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13344 ) قال النبي :(@)(@@) | 30 ( شهر رمضان شهر كتب الله عليكم صيامه ، وسننت لكم قيامه ، فمن صامه وقامه إيمانا واحتسابا خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) ( ه هب ) عن عبد الرحمان بن عوف رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13345 ) قال النبي :(@)(@@) | 30 ( شهر رمضان معلق بين السماء والأرض ولا يرفع إلى الله إلا بزكاة الفطر ) )(@)(@@) ابن شاهين في ترغيبه والضياء عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13346 ) قال النبي :(@)(@@) | 30 ( شهر رمضان يكفر ما بين يديه إلى شهر رمضان المقبل ) )(@)(@@) ابن أبي الدنيا في فضل رمضان عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13347 ) قال النبي :(@)(@@) | 30 ( شهران لا ينقصان شهرا عيد : رمضان وذو الحجة ) )(@)(@@) ( حم ق 4 ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13348 ) قال النبي :(@)(@@) | 30 ( شهيد البحر مثل شهيدي البر ، والمائد في البحر كالمتشحط في دمه في البر ، وما 
ms1483	 بين الموجتين في البحر كقاطع الدنيا في طاعة الله ، وإن الله عز وجل وكل ملك الموت بقبض الأرواح إلا شهداء البحر ، فإنه يتولى قبض أرواحهم ، ويغفر لشهيد البر الذنوب كلها إلا الدين ويغفر لشهيد البحر الذنوب كلها والدين ) )(@)(@@) ( ه طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13349 ) قال النبي :(@)(@@) | 30 ( شهيد البر يغفر له كل ذنب إلا الدين والأمانة ، PageV05P055 وشهيد البحر يغفر له كل ذنب والدين والأمانة ) )(@)(@@) ( حل ) عن عمة النبي .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13350 ) قال النبي :(@)(@@) | 30 ( شهابان من نار ) )(@)(@@) ( حم ) عن امرأة قالت : رأى علي رسول الله قرطين من ذهب قال فذكره .(@)(@@)(@@)(@@) $ ( 13351 ) قال النبي :(@)(@@) | 30 ( شهادة القوم فالمؤمنون شهود الله في الأرض ) )(@)(@@) ( ه ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13352 ) قال النبي :(@)(@@) | 30 ( شهرا عيد لا ينقصان في كل واحد منهما عيد : رمضان وذو الحجة ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13353 ) قال النبي :(@)(@@) | 30 ( شهر رمضان شهر الله ، وشهر شعبان شهري : شعبان المطهر ، ورمضان المكفر ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 13354 ) قال النبي :(@)(@@) | 30 ( شهودهما للعشاء والصبح أفضل من قيام ما بينهما ) )(@)(@@) ( عب ) عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 13355 ) قال النبي :(@)(@@) | 30 ( شهداء البر يغفر له كل ذنب إلا الدين والأمانة ، وشهيد البحر يغفر له كل ذنب والدين والأمانة ) )(@)(@@) و ابن النجار عن بعض عمات النبي .(@)(@@) PageV05P056(@)(@@)(@@)(@@) ||| ( الشين مع الياء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13356 ) قال النبي :(@)(@@) | 30 ( شيئان لا أذكر فيهما : الذبيحة والعطاس هما مخلصان لله ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13357 ) قال النبي :(@)(@@) | 30 ( شيبتني سورة هود وأخواتها : الواقعة ، والقارعة ، والحاقة ، وإذا الشمس كورت ، وسأل سائل ) )(@)(@@) ابن مردويه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13358 ) قال النبي :(@)(@@) | 30 ( شيبتني هود وأخواتها ) )(@)(@@) ( طب ) عن عقبة بن عامر وعن أبي جحيفة رضي الله