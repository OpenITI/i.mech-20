ms61	 مرتبط % 33(@)(@@) % بأكلب منوطة % بها السيور ولمقط % 34(@)(@@) % كأنما ضلوعها % % قسي نبع لم تحط % 35(@)(@@) % كأنما احداقها % % لمع الذبال المستلط % 36(@)(@@) % كأنما آذانها % % أنصاف دارتها الشرط % 37(@)(@@) % فمن حليجي كمث % % ل العصب مرموق الخطط % 38(@)(@@) % وأصفر اللون كما % % أسيغ بالورس النمط % 39(@)(@@) % وأحمر مثل الذبيح % بالدماء منشحط % 40(@)(@@) % عالي الذراعين عظيم ال % % زور مخطوف استعط % PageV01P308 41(@)(@@) % % عارض جن فاختلط % 42(@)(@@) % كأنما تنعيمنا % % فرض عليه مشترط % 43(@)(@@) % وتوقن العصم إذا % % رأته أن سوف تحط % 44(@)(@@) % تنثر ما يبقى وما % % تختار منها يلتقط % 45(@)(@@) % توسعنا صيدا فمطبو % % خ ومشوي خلط % 46(@)(@@) % وباشق ذي نخوة % على الطيور ذا سخط % 47(@)(@@) % كأنما جؤجؤه % وشي محوك في نمط % 48(@)(@@) % كأنما مقلته % فص من التبر خرط % 49(@)(@@) % يهبط بالطير معا % إذا علا ثم انهبط % 50(@)(@@) % غدا فأردى حجلا % منها ودراجا وبط % PageV01P309 51(@)(@@) % وفائقا من الأوز % والحمام والحبط % 52(@)(@@) % حتى إذا نلنا به % أوطار لهو وغبط % 53(@)(@@) % أبنا نعيم لم يشب % رجاؤنا فيه قنط % PageV01P310 البحر : كامل تام 1(@)(@@) % أحبابنا بقلوبنا شطوا % % وتحكموا في ذاك واشتطوا % % 2(@)(@@) % أما ترحلهم فأعقله % خبرا فأين تراهم حطوا % % 3(@)(@@) % ساروا ولم أعلم بسيرهم % حتى رأيت جمالهم تمطو % % 4(@)(@@) % وغدت بهم تخطوا وأحسبها % % أسفا على أكبادها تخطو % % 5(@)(@@) % كم في هوادجهن من قمر % يعدو على الألباب أو يسطو % % 6(@)(@@) % ومقبل تبدو مضاحكه % فكأنما يبدو لها سمط % 7(@)(@@) % ومرجل بالمسك يعبق من % % رياه حين يمسه المشط % 8(@)(@@) % ومثقل الأرداف يثقل عن % % أردافه ونهوده المرط % 9(@)(@@) % وتضمنت أستارها لعبا % بيضا زهاها الخلق لا الخرط % 10(@)(@@) % فيهن آنسة كلفت بها % % كالظبية الأدماء إذ تعطو % % PageV01P311 11(@)(@@) % تلوى أناملها على حرج % ويحثها أطرافها السبط % 12(@)(@@) % كالطفل إلا أنه رجل % تصبو إلى نغماته الشمط % 13(@)(@@) % ضدان منثور وملتقط % فترحلوا وتنزل الوخط % 14(@)(@@) % أخذوا العزاء وزودوك أسى % % شتان ما أخذوا وما أعطوا % % 15(@)(@@) % ومذكرات الري هن لنا % % في المعتنين كلامك شرط % 16(@)(@@) % فسقى ديارهم محللة الأ % % خلاف ليس يحلها ربط % 17(@)(@@) % لي من أبي بكر أخ ثقة % لم أسترب بإخائه 
ms62	 قط % 18(@)(@@) % ماحال في قرب ولا بعد % سيان فيه الثوب والشط % 19(@)(@@) % جسمان والروحان واحدة % كالنقطتين حواهما خط % 20(@)(@@) % فإذا افتقرت فلي به جدة % وإذا اغتربت فلي به رهط % PageV01P312 21(@)(@@) % ذاكره او حاوله مختبرا % تر منه بحرا ما له شط % 22(@)(@@) % في نعمة منه جليت بها % % لا الشنف يبلغها ولا القرط % 23(@)(@@) % وببدلة بيضاء ضافية % مثل الملاءة حاكها القبط % 24(@)(@@) % متذلل مغناه متممة % ونتاج مغنى غيره سقط % 25(@)(@@) % وجنان آداب مثمرة % ما شانها أثل ولا خمط % 26(@)(@@) % وتواضع يزداد فيه علا % والحر يعلوا حين ينحط % 27(@)(@@) % وإذا امرؤ شيبت خلائق ه % غدرا فما في وده خلط % PageV01P313 البحر : - 1(@)(@@) % وزائر والعيون هاجعة % وقلبه من رقيبه جزع % 2(@)(@@) % منغص وصله بتحشمة % يعتدل اليأس فيه والطمع % 3(@)(@@) % كان شفائي من خده قبلا % لو جاد أو من رضابه جزع % 4(@)(@@) % فبان بيني وبينه أمل % دون الذي رمت منه منقطع % 5(@)(@@) % يدني للثمي رياض وجنته % طورا ويبدو له فيمتنع % 6(@)(@@) % كأنه مزنة مخيلة % تشف للقطر ثم تنقشع % PageV01P314 البحر : بسيط تام 1(@)(@@) % أرذال قوم أباحوا لومهم شرفي % % وقد ينال من الأشراف أوضاع % 2(@)(@@) % حلمت عنهم فأغراهم لجهلتهم % حلمي وللجهل أصحاب وأتباع % 3(@)(@@) % وجل قدري فاستحلوا مساجلتي % % إن الذباب على الماذي وقاع % PageV01P315 البحر : مجزوء المتقارب 1(@)(@@) % جعلت إليك الهوى % % شفيعي فلم يشفع % 2(@)(@@) % وناديت مستعطفا % رضاك فلم تسمع % 3(@)(@@) % أتاركني مدنفا % أخا جسد موجع % 4(@)(@@) % ومغرقني بالدمو % % ع أحرقت مدمعي % % 5(@)(@@) % أعني سبيت الفؤا % % د بالمنطر المطمع % 6(@)(@@) % جفوت فأقصيتني % % فهلا وقلبي معي % % PageV01P316 البحر : مجزوء الكامل 1(@)(@@) % كلف الفؤاد بجارة % كلفا يكاد يقطعه % 2(@)(@@) % لا مؤيس من وصله % صبا ولا هو مطمعه % 3(@)(@@) % داني المحل مزاره % ينأى ويقرب موضعه % 4(@)(@@) % إن لم تكن عيني تراه % فإن أذني تسمعه % PageV01P317 البحر : متقارب تام 1(@)(@@) % إلى الله أشكو أخا جافيا % يضيع وأحفظ فيه الصنيعه % 2(@)(@@) % إذا ما الوشاة سعوا نحوه % % أصاخ إليهم بأذن سميعه % 3(@)(@@) % ويظهر لي منه في كل يوم % خلائق مستنكرات قطيعه % 4(@)(@@) % كثرت عليه فأمللته % وكل كثير 
ms63	 عدو الطبيعه % 5(@)(@@) % وإني لا أعلم أن المللو % % ل ليس يمرنه غير القطيعه % 6(@)(@@) % ولكن نفسي إذا استكرهت % على الهجر ليست له مستطيعه % PageV01P318 البحر : وافر تام 1(@)(@@) % رأيت تتبه الأعمال أجدى % % على العمل من فضل القناعه % 2(@)(@@) % فمن يك أكثر العمل بذلا % لمال فهو أوجههم شفاعه % 3(@)(@@) % فإما كنت في عمل فصانع % بمرفقه وإن تلم ارتفاعه % 4(@)(@@) % ووفر حصة الأتباع تأمن % بذاك من الملامة والشناعه % 5(@)(@@) % وخذ في جمع مال الصلح لا في % % إقامة حجة لك في الجماعه % 6(@)(@@) % وسامح ذا المعونة واعتقده % ليحسن عنك يوما باندفاعه % 7(@)(@@) % وصادق ذا القضاء ولا تثره % فيشهد بالخيانة وإلا ضاعه % 8(@)(@@) % وكن في كل ذاك على يقين % بأن الصدق يحدث بعد ساعه % PageV01P319 البحر : بسيط تام 1(@)(@@) % يا خاضب الشيب والأيام تظهره % هذا شباب لعمر الله مصنوع % 2(@)(@@) % أذكرتني قول ذي لب وتجربة % في مثله لك تاديب وتوزيع % 3(@)(@@) % إن الجديد إذا ما زيد في خلق % تبين الناس أن الثوب مرقوع % PageV01P320 البحر : مخلع البسيط 1(@)(@@) % ألقي في حبك القناع % وصار كالرؤية السماع % 2(@)(@@) % وشاع من سرنا الذي ما % % كنا نرى أنه يشاع % 3(@)(@@) % وقد خلعنا فلا رقيب % نخشى ولا عاذل يطاع % 4(@)(@@) % صارت مناجاتنا شفاها % وانقضت الرسل والرقاع % 5(@)(@@) % وأسرعت سلوتي وداعا % فحبذا ذلك الوداع % 6(@)(@@) % يا ذا الذي بعته فؤادا % ما كان لولا الهوى يباع % 7(@)(@@) % وصللت لي مذ وصلت فردا % وإنما هجرك المشاع % 8(@)(@@) % وكلما زاد فيك عقد % من كلف زاد في اتباع % 9(@)(@@) % ما إن رأينا سواك ظبيا % تفرق من لحظه السباع % 10(@)(@@) % طبي تراع القلوب منه % % والظبي من ظله يراع % PageV01P321 11(@)(@@) % وجنة ملؤها غرام % ومقلة ملؤها خداع % 12(@)(@@) % متاع لحظ لمستشف % له بما حمل اضطلاع % 13(@)(@@) % طالع أخي وجهه تطالع % بدرا له في الدجا اطلاع % 14(@)(@@) % إن لم تصدق فهات تابع % وانظر لمن يحصل التباع % 15(@)(@@) % وبعد ذا فالمضيع منا % % يوم سرور هو المضاع % 16(@)(@@) % فقم لينفتضها عروسا % تباع في مهرها الضياع % 17(@)(@@) % نار بدت في إناء نور % لها وما 
ms64	 شعشعت شعاع % 18(@)(@@) % إن صدع الرأس من شراب % فهي يداوى بها الصداع % 19(@)(@@) % قد نظمت سمطها الروابي % % وقشرت شعرها البقاع % 20(@)(@@) % فالزهر في الأرض لي بسط % والغيم في الجو لي شراع % PageV01P322 21(@)(@@) % أنظر إلى منظر تولت % صنيعة مزنة صناع % 22(@)(@@) % للنبت تحت الدجا اضطجاع % وللندى فوقه اضطجاع % 23(@)(@@) % طابت لنا قارب فطابت % وهادها الخضر والتلاع % 24(@)(@@) % واستبشرت تلكم المغاني % % واستضحكت تلكم الرباع % 25(@)(@@) % تروى القلوب العطاش منه % % وتشبع الأعين الجياع % 26(@)(@@) % وذاك بستانها الذي ما % % للطرف عن أمره امتناع % 27(@)(@@) % حديث أطياره صياح % ولعب أشجاره صراع % 28(@)(@@) % وصوت دولابها سماع % لنا إذا فاتنا السماع % 29(@)(@@) % يا جنة وسعت فما إن % لجنة عندها اتساع % 30(@)(@@) % لا أزمع الغيث عنك بينا % ولا درى الغيث ما الزماع % PageV01P323 31(@)(@@) % بل جاد بالري فيك جودا % تروى به قارة وقاع % 32(@)(@@) % جود على أخي المعالي % % فجوده في الندى طباع % 33(@)(@@) % السيد الأيد الذي عن % % سؤدده ينجلي القراع % 34(@)(@@) % الأسد المستفيض الأ % سود في عينه ضباع % 35(@)(@@) % للفهم في لحظه اتقاد % للعلم في لفظه التماع % 36(@)(@@) % مماصع في العلى مصاعا % يضيق ذرعا به المصاع % 37(@)(@@) % مدافع دونها دفاعا % يقرع سنا له الدفاع % 38(@)(@@) % ضليع عزم ضليع حزم % يا بأبي مجده اليفاع % 39(@)(@@) % حكم الندى في هواه ماض % وأمره عنده مطاع % 40(@)(@@) % ذو عزمة ما لها ارتداد % دون مداهاولا ارتجاع % PageV01P324 41(@)(@@) % فما أضاعت فليس يحمى % % وما حمته فما يصاع % 42(@)(@@) % يفديه من فعله بطيء % جدا وأقواله سراع % 43(@)(@@) % ديناره في السماح فلس % وكره في النجار صاع % 44(@)(@@) % ياسيدا سؤددا أصيلا % لا سؤددا أصله ابتداع % 45(@)(@@) % غبطت ما عشت في سجاع % وعاش في غبطة سجاع % 46(@)(@@) % وزاد نجما كما ارتفاعا % فما امترى ماثل سجاع % 47(@)(@@) % فأنتما لا عدا اقتراب % شملكما لا ولا اجتماع % 48(@)(@@) % العين والحاجب اقترابا % في الوصل والعضد والذراع % 49(@)(@@) % إن يك قلب رضيع قلب % فبين قلبيكما رضاع % 50(@)(@@) % علي كل ارتفاع عز % له لدى عزك اتضاع % PageV01P325 51(@)(@@) % % ما لم يكن قط يستطاع % 52(@)(@@) % فما امترى مائل 
ms65	 سجاع % في أنه القائل السجاع % 53(@)(@@) % أحرزت منه ركيب فكر % تضمنت وكره القلاع % 54(@)(@@) % إن تصطنعه على اختيار % منك فما ضاع الإصطناع % 55(@)(@@) % أو يكس في ظنك انتفاعا % فقد زكا ذاك الانتفاع % 56(@)(@@) % هاهو مصغ إليك سمعا % له إلى أمرك استماع % 57(@)(@@) % مدرع منك درع فخر % فليهنه ذاك الادراع % 58(@)(@@) % فاصدع به قلب كل لاح % بقلبه منكما انصداع % 59(@)(@@) % فأنت طود العلا الذي قد % % رسا فما إن له انقلاع % 60(@)(@@) % كم ذي نزاع إلى محل % حللته خانه النزاع % PageV01P326 61(@)(@@) % فما يساويه فيه إلا % إذا استوى الرأس والكراع % 62(@)(@@) % وقولنا غير ذا جنون % إن تجن قلناه أو صداع % 63(@)(@@) % عش سالما لاختراع مجد % فإنه نعم الاختراع % 64(@)(@@) % جودك ما إن له انقطاع % ومدحنا ما له انقطاع % PageV01P327 البحر : منسرح 1(@)(@@) % لم ترني قط باريا قلما % في بريه مهنة معا وصنعه % 2(@)(@@) % ما كل من يحمل السلاح لكي % % يعصى به سنه ولا طبعه % PageV01P328 البحر : خفيف تام 1(@)(@@) % آه من بحة لغير انقطاع % لفتاة موضوعة الإيقاع % 2(@)(@@) % أتعبت حلقهاوقد تجتنى من % % تعب الحلق راحة الأسماع % 3(@)(@@) % فغدت تكثر البحاح وحطت % طبقا الأوتار بعد ارتفاع % 4(@)(@@) % كأنين المحب خفض منه % % صوت شكواه شدة الأوجاع % PageV01P329 البحر : مخلع البسيط 1(@)(@@) % سامعة للهوى مطيعة % ليست لهجري بمستطيعة % 2(@)(@@) % علمها أهلها حديثا % وعته أذن لها سميعة % 3(@)(@@) % قد ضحكت من صروف دهر % أحداثه جمة فظيعة % 4(@)(@@) % وخاضب الشيب في ثلاث % يهتكم أستاره الطليعة % 5(@)(@@) % من يتطبع بغير طبع % يرجع صفرا إلى الطبيعة % PageV01P330 البحر : مجزوء الكامل 1(@)(@@) % إن كنت تنكر أن في الأ % % لحان فائدة ونفعا % % 2(@)(@@) % فاننظر إلى الإبل التي % % لا شك أغلظ منك طبعا % % 3(@)(@@) % تصغي لأصوات الحدا % % فتقطع الفلوات قطعا % % PageV01P331 البحر : كامل تام 1(@)(@@) % بأبي وأمي زائر متقنع % لم يخف ضوء الشمس تحت قناعه % 2(@)(@@) % لم أستتم عناقه لقدومه % حتى أعدت عناقه لوداعه % 3(@)(@@) % ومضى وأبقى في ففؤادي حسرة % تركته موقوفا على أوجاعه % PageV01P332 البحر : سريع 1(@)(@@) % جاءت بعود مثلها نافر % كأنه نقنقة الضفدع % 2(@)(@@) % مضطرب الأوتار منقوضها 
ms66	 % % مستفبح المدفع والمقطع % 3(@)(@@) % يود من يسمع أصواته % لو فقد السمع فلم يسمع % 4(@)(@@) % فاقبلت تضرب غير الذي % % تسمع والنغمة لم تتبع % 5(@)(@@) % كأنما قسمة تأليفها % % مثلت مختلف الأضلع % PageV01P333 البحر : كامل تام 1(@)(@@) % حور شغلن قلوبنا بفراع % لرسائل قصرت عن الإبلاغ % 2(@)(@@) % وسعن ورد خدودهن فلم نطق % قطفا له لعقارب الأصداغ % PageV01P334 البحر : رجز تام 1(@)(@@) % وروضة مشبعة الأصباغ % أحكمها تأنق الصباغ % 2(@)(@@) % فبلغت نهاية البلاغ % ظباؤها في الغدق المناغ % 3(@)(@@) % من نعجة تصفى لكبش ناعي % % يحمل فوق قلة الدماغ % 4(@)(@@) % طرحتها في الشغل من فراغي % % بخائض في ردها ولاغ % 5(@)(@@) % جون السراة لهق الأدفاغ % مصغ إلى شيطانه النزاغ % 6(@)(@@) % فصكها كالحجر الدماغ % وشك في كثيره التراغي % % 7(@)(@@) % كلالبا يلين في الأرساغ % من كل معطوف لها لداغ % PageV01P335 البحر : رمل تام 1(@)(@@) % من عذيري من عذاري رشإ % عرض القلب لأسباب التلف % 2(@)(@@) % ومجيري من فتى لا مستعتب % بعذار لم يجز حد السيف % 3(@)(@@) % زيد حسنا وضياء بهما % % فهو الآن كبدر في سدف % 4(@)(@@) % خمشا خديه ثم انعطفا % % آه ما أحسن ذاك المنعطف % 5(@)(@@) % علم الشعر الذي جاعله % % أنه جار عليه فوقف % 6(@)(@@) % وهو في وقفته معترف % بالتناهي في التعدي والسرف % PageV01P336 البحر : منسرح 1(@)(@@) % شيخ لنا من مشايخ الكوفة % نسبته للعليل موصوفه % 2(@)(@@) % لو بدل الله قمله غنما % ما طمع الجار منه في صوفه % PageV01P337 البحر : طويل 1(@)(@@) % تعاورنني الآمال حتى نهكتني % % متى بان منها تالد بان طارف % 2(@)(@@) % وأكثرت في الأرض التفرق معذرا % فما بلغت بي حيث أهوى المصارف % 3(@)(@@) % وعندي لعمر الله سير أعده % إلى الرزق إلا أن حظي واقف % PageV01P338 البحر : خفيف تام 1(@)(@@) % يا أبا الفضل يا أمير الظراف % % ما عهدناك بالملول الجافي % % 2(@)(@@) % سر إلينا بحق ما وكدته % بيننا الحال من صنوف التصافي % % 3(@)(@@) % إننا في ظريف من غناء % وشراب لطارق الهم نافي % % 4(@)(@@) % قد شربنا الأقحاف حتى حسبنا % % أن هاماتنا بلا أقحاف % 5(@)(@@) % وشربنا الأنصاف حتى جهلنا % % حد ما بين الجور والإنصاف % PageV01P339 البحر : طويل 1(@)(@@) % ومازلت ابغي العلم من 
ms67	 حيث ينبغي % % وأفتن في أطرافه أتطرقه % 2(@)(@@) % فقد صرت لا ألقى الذي أستزيده % ولا أذكر الشيء الذي لست أعرفه % PageV01P340 البحر : متقارب تام 1(@)(@@) % تشبه في النحو بالأخفش % فجاء بأعجوبة مطرفه % 2(@)(@@) % ولم يستمع فيه لكنه % قرا منه شيئا وقد صحفه % 3(@)(@@) % فإن لم يكن أخفش الناظرين % فإن الفتى أخفش المعرفه % PageV01P341 البحر : خفيف تام 1(@)(@@) % سيدي أنت مم سووك قل لي % % أمن الدك أم من التتريف % 2(@)(@@) % لا يهولنك ذا أخاك ال % % بدر ما زال مولعا بالكسوف % 3(@)(@@) % واكفنا عقدك المناطق إنا % % قد رأينا لخصرك المخطوف % 4(@)(@@) % إنف ثقل الشنوف عنك فما شكو % ك إلا من ثقل حمل الشنوف % 5(@)(@@) % كم عذلناك في السيوف وقلنا % % لك ما للمها وما للسيوف % 6(@)(@@) % إنما تصلح المها لنعيم % وخدور ولذة وغريف % PageV01P342 البحر : مجزوء الوافر 1(@)(@@) % أنا أفدي التي تبدو % % فتغدو الشمس منكسفه % 2(@)(@@) % دلال لا نظير له % وحسن فوق كل صفه % 3(@)(@@) % تريك الصبح مقبلة % وجنح الليل منصرفه % 4(@)(@@) % وتحسد قدها الأغصا % % ن خاطرة ومنعطفه % 5(@)(@@) % وتضمر ود عاشقها % % وتظهر زهد منحرفه % 6(@)(@@) % وتعلم انني دنف % وأعلم أنها دنفه % 7(@)(@@) % ويمنعها من الشكوى % % إلينا أنها صلفه % PageV01P343 البحر : - 1(@)(@@) % سل بي وبالأيام تعرف % أني ابن دهر ليس ينصف % 2(@)(@@) % وبلاغة معروفة % سهلت وأخطاها التكلف % 3(@)(@@) % وسطور خط مونق % في الطرس كالثوب المفوف % 4(@)(@@) % والخط ليس بنافع % إن لم يكن خطا مصحف % PageV01P344 البحر : كامل تام 1(@)(@@) % ولها من الأوتار حين تجيبها % % إذن على حجب القلوب لطيف % 2(@)(@@) % شغلت قلوب السامعين فكلها % % مصغ إلى نغماتها مصروف % 3(@)(@@) % ترد الجوانح والقلوب شواخص % فيها فتجلس والقلوب وقوف % 4(@)(@@) % لو كان من حجر فؤادك لم ترح % إلا وأنت بحبها مشغوف % PageV01P345 البحر : متقارب تام 1(@)(@@) % وهيفاء من ندماء الملو % % ك صفراء كالعاشق المدنف % 2(@)(@@) % تكيد الظلام كما كادها % % فضتضنى وتفنيه في موقف % PageV01P346 البحر : مجزوء الوافر 1(@)(@@) % بلليت بأحسن الثقلين % إقبالا ومنصرفا % % 2(@)(@@) % فمثل الظبي ملتفتا % ومثل الغصن منعطفا % % 3(@)(@@) % يسوفني بنائله % وقد أهدى لي الأسفا % % 4(@)(@@) % وآخذ وصله عدة % ويأخذ مهجتي 
ms68	 تلفا % % PageV01P347 البحر : خفيف تام 1(@)(@@) % شبت في حالتي سرور وحزن % ومقامي تفرق وتلاق % % 2(@)(@@) % حزن بين فشبت من حزن البي % % ن ومن لا يشيب عند الفراق % 3(@)(@@) % واعتنقنا بالطيب من طيب أنفا % % سك لما جبوتني بالعناق % 4(@)(@@) % هي طيب والطيب والبين شيب % معجل للملوك والعشاق % PageV01P348 البحر : متقارب تام 1(@)(@@) % ذكرتك والعود عانقته % % ودمعي من مقلتي يستبق % 2(@)(@@) % أضم إلى جسدي ما ضمم % ت منه وألزمه معتنق % 3(@)(@@) % وأعجب منه إذا ما دنا % % إلى كبدي كيف لا يحترق % PageV01P349 البحر : رجز تام 1(@)(@@) % أعددت لليل إذا الليل غسق % أغصان تبر عريت من الورق % 2(@)(@@) % ثمارها مثل مصابيح الأفق % % يغني الندامى ضووها عن القلق % 3(@)(@@) % شفاؤها إن مرضت ضرب العنق % % PageV01P350 البحر : كامل تام 1(@)(@@) % وأذا افتخرت بأعظم مقبورة % فالناس بين مكذب ومصدق % 2(@)(@@) % فأقم لنفسك بانتسابك شاهدا % لحديث مجد للقديم مصدق % PageV01P351 البحر : هزج 1(@)(@@) % أعاذ الله شكواك % وأهدى لك إفراقا % % 2(@)(@@) % خرجنا أمس للصيد % وكنا فيه سباقا % % 3(@)(@@) % فسمينا وأرسلنا % % على نخبك أطلاقا % % 4(@)(@@) % فجاد الله بالرزق % وكان الله رزاقا % % 5(@)(@@) % وأحوزنا من الدراج % ما الرجل به ضاقا % % 6(@)(@@) % فأطمعت وأهديت % إلى المطبخ أوساقا % % 7(@)(@@) % وخير اللحم ما أقل % % قه الجارح إقلاقا % % 8(@)(@@) % وذو العادة للصيد % إذا أنضره تاقا % % 9(@)(@@) % فيعرفه فما كان % إليه الدهر مشتاقا % % 10(@)(@@) % فكل منه شفاك الل % % ه مشويا وأمراقا % % PageV01P352 11(@)(@@) % وهذا الحفظ للصح % ة لا تدبير إسحاقا % % PageV01P353 البحر : خفيف تام 1(@)(@@) % يا نديمي جنباني الرحيقا % % إنني لست للرحيق مطيقا % % 2(@)(@@) % قد تيقنت أنها تطرد اله % % م وتلفى إلى السرور طريقا % % 3(@)(@@) % غير أني وجدت للكأس نارا % تلهب الجسم والمزاج الرقيقا % % 4(@)(@@) % فإذا ما جمعتها ومزاجي % % حرقتني بنارها تحريقا % % PageV01P354 البحر : رجز تام 1(@)(@@) % وحاسد ظاهره لي وامق % والغل منه بالضمير لاصق % 2(@)(@@) % تخبرني عن شره الخلائق % وقلما ينكتم المنافق % 3(@)(@@) % له فؤاد إن رآني خافق % وإن أغب فهو بجور ناطق % 4(@)(@@) % يكذب وهو في التجني صادق % وكل مجد في الخلا يسابق % PageV01P355 البحر : بسيط تام 1(@)(@@) % قالوا أبو أحمد يبني 
ms69	 فقلت لهم % % كما بنت دودة بنيان السرق % 2(@)(@@) % ينته حتى إذا تم البناء لها % % كان التمام ووشك الخير في نسق % PageV01P356 البحر : رجز تام 1(@)(@@) % حسبي من البزاة والزدادق % % ببيدق يصيد صيد الباشق % 2(@)(@@) % مؤدب مدرب الخلائق % أصيد من معشوقة لعاشق % 3(@)(@@) % يسبق في السرعة كل سابق % ليس له في قصده من عائق % 4(@)(@@) % ربيته وكنت غير واثق % أن الغزازيق من البيادق % PageV01P357 البحر : طويل 1(@)(@@) % لقد مر عبد الله في السوق راكبا % له حاجب من أنفه وهو مطرق % 2(@)(@@) % وعنت له في جانب السوق مخطة % توهمت أن السوق فيها سيغرق % 3(@)(@@) % فأقذر به أنفا وأقذر بربه % على وجهه منه كنيف معلق % PageV01P358 البحر : مجزوء الخفيف 1(@)(@@) % سيدي أنت لم أكن % كل ذا منك أتقي % % 2(@)(@@) % داو جسمي فإنه % منك بالصد قد شقي % % 3(@)(@@) % لن ترد الذي مضى % % منه فارفق بما بقي % % PageV01P359 البحر : رجز تام 1(@)(@@) % أرقت أم نمت لضوء بارق % مؤتلقا مثل الفؤاد الخافق % 2(@)(@@) % كأنه إصبع كف السارق % تسوقها الرعد بغير سائق % 3(@)(@@) % سوق الحداة طلح الأيانق % لما رآها زهر الحدائق % 4(@)(@@) % مد يد المصافح المعانق % وهز أعطاف سبوق سابق % 5(@)(@@) % فلم يزل حتى الصباح الفائق % يبكي بجفني مثكل وعاشق % 6(@)(@@) % كم خبأت في لهب البوارق % لعاطل الزهاد والشواهق % 7(@)(@@) % من العقود ومن المخانق % فالأرض بعد العري كاليلامق % 8(@)(@@) % من الأقاحي ومن الشقائق % % PageV01P360 البحر : منسرح 1(@)(@@) % الليل يا صاحبي منطلق % يقاد زحفا وما به رمق % 2(@)(@@) % غمض دون الغروب كوكبه % إذ شفه طول ليله الأرق % 3(@)(@@) % ورق جدا رداء ظلمته % % فهو على منكب البرئي خلق % 4(@)(@@) % تأملا الغرب كيف ذهبه % شرق بتوريد فجره شرق % 5(@)(@@) % واصطبحاها على مفوفة % بات لها بالقطار مغتبق % 7(@)(@@) % روض غريق ، ومزنة ضحكت % % عن أفق بالبروق يحترق % 9(@)(@@) % % سل علينا سيوفه درق % 10(@)(@@) % وعصفرت راحة المدير كما % % عصفر جيب الدجنة الشفق % 11(@)(@@) % جازت مدى الفكر والصفا % % مازجها الوهم مسها رنق % PageV01P361 البحر : خفيف تام 1(@)(@@) % من لذاك الطبرزد المدقوق % ولذاك اللوز النقي الأنيق % 2(@)(@@) % ودقيق السميذ يعجن بالما 
ms70	 % % ورد عل بمسكه المسحوق % 3(@)(@@) % ضم أجزاؤه وألف أجسا % % ما حوت كل مطعم موموق % 4(@)(@@) % ثم صفوه كالأهلة لاحت % لمواقيتها حيال الشروق % 5(@)(@@) % ما رأينا كخشكنانجك المو % % صوف رعيا لحقه في الحقوق % 6(@)(@@) % غبت عنه فغاب عني نصيبي % % أنت عندي بذاك غير خلوق % PageV01P362 البحر : مجزوء الكامل 1(@)(@@) % فحم أنارت ناره % % فتضرمت فيه حريقا % % 2(@)(@@) % فكأنها وكأنه % سمج قرنت به رحيقا % % PageV01P363 البحر : مجزوء الوافر 1(@)(@@) % أي أب رزئته % أهلك صبري إذ هلك % 2(@)(@@) % شمس هوت من فلك ال % % مجد وللمجد فلك % 3(@)(@@) % وكوكبي داج فقد % دجا ظلامي وحلك % 4(@)(@@) % يا أبتا أي أسى % لم يبق لابن ثكلك % 5(@)(@@) % تركته مقتفيا % إلى المعالي سبلك % 6(@)(@@) % من بعد ما أدركت أو % % شارفت فيه أملك % 7(@)(@@) % وحمل العبء الذي % % كان أبوك حملك % 8(@)(@@) % يا أبتي كل أب % يورد يوما منهلك % 9(@)(@@) % من أي شيء يعجب ال % % باكون والراثون لك % 10(@)(@@) % أمن سرير حملك % أم من تراب أكلك % PageV01P364 11(@)(@@) % أم الضريح الضيق الأر % جاء كيف شملك % 12(@)(@@) % وددت أني للمنا % % يا كنت يوما بدلك % 13(@)(@@) % وددت لو بجسدي % % كنت احتملت عللك % 14(@)(@@) % كأنما الأيام لم % يعجزن إلا حيلك % 15(@)(@@) % أو لم يمت غيرك من % إنس وجن وملك % 16(@)(@@) % تغمد الله بحس % ن العفو منه زللك % 17(@)(@@) % مسامحا غيرمو % % ف بالحساب عملك % 18(@)(@@) % ولا إلى ما قدمت % يداك منه وكلك % PageV01P365 البحر : مجزوء الكامل 1(@)(@@) % أفدي التي أهدت لنا % % شمس الضحى والليل حالك % 2(@)(@@) % مملوكة جلت فلي % % س تفي بقيتها الممالك % 3(@)(@@) % عرضت فأعطت عودها % % ضربا يعرض للمهالك % 4(@)(@@) % وتبعتها فتصرفت % بالضرب في كل المسالك % 5(@)(@@) % ويئست من إدراكها % % فخفضت صوتي عند ذلك % 6(@)(@@) % قصرت يدي عند الغدا % % ة فكيف لي بيد تتالك % PageV01P366 البحر : بسيط تام 1(@)(@@) % ياهند لا تنكري في الأرض مضطربي % % فإنما ابتغي العلياء لي ولك % 2(@)(@@) % قالت أراك حثيث السير قلت لها % % والبدر أيضا حثيث السير في الفلك % 3(@)(@@) % وقد بليت بدهر ليس يبصفني % % وما علمت له في ذاك من درك % PageV01P367 البحر : طويل 1 
ms71	(@)(@@) % رضى المتجني غاية ليس تدرك % % وفي كل وجه للتجرم مسلك % 2(@)(@@) % إذا صاحب يوما تجنى تركته % على طبعه والطبع بالمرء أملك % 3(@)(@@) % وصلتك لما كنت في موحدا % وعزيت فيك القلب إذ أنت مشرك % 4(@)(@@) % فإن عدت لخلاص عدت به أخا % وإن تأب إلا تركه فهو أترك % PageV01P368 البحر : خفيف تام 1(@)(@@) % أكفنا يا عذول شر لسانك % واله عن فشأننا غير شانك % 2(@)(@@) % دع دموعي على الأحبة تجري % % واجتنبني فلست من أخدانك % 3(@)(@@) % فمكان الحبيب أكثر من أن % % أتسلى عن حبه لمكانك % 4(@)(@@) % وهواه المصون عندي لو ذق % % ت لبان الرقاد عن أجفانك % 5(@)(@@) % أيها الصب بح فقد شفك الشو % % ق وملكت كفه من عنانك % 6(@)(@@) % أي وجديك تشتكي وإلى أي % خليل تحن من خلانك % 7(@)(@@) % أعلى خلك المساعد تبكي % % أم على طيب ما مضى من زمانك % 8(@)(@@) % رب راح باكرتها في دمنهو % % رك مع من تود من خلانك % 9(@)(@@) % من عقار كمثل ذهنك صفوا % في إناء أرق من جثمانك % 10(@)(@@) % تخضب الكف وهي بيضاء فيها % % وتريك الهلال فوق بنانك % PageV01P369 11(@)(@@) % لونها الورد ريحها الند تغني % % ك بطيب النسيم عن ريحانك % 12(@)(@@) % وغزال كان في مقلتيه % سيفك العضب أو شبا أسنانك % 13(@)(@@) % قرطقي يحار ذهنك في وص % ف ملاحاته بحسن بيانك % 14(@)(@@) % قد أراه يطيع أمرك في الوصل % ويعصى العذول في عصيانك % 15(@)(@@) % فلعمري لئن رمتك الليالي % % بنوى أزعجتك عن أوطانك % 16(@)(@@) % فإذا ما تروح في الحي نشوا % % نيفوح العبير من أردانك % 17(@)(@@) % ربما تقسم النهار فشطرا % لنفاذ الأمور في ديوانك % 18(@)(@@) % وعشيا تراوح الراح بالش % ط على نيلنا بصوت قيانك % 19(@)(@@) % مع نديم حلو الحديث يجاري % % ك الذي تشتهيه في ميدانك % 20(@)(@@) % أريحي كأن قلبك في أض % % لاعه أو كلامه بلسانك % PageV01P370 21(@)(@@) % فإذا ما شكوت شجوك في الح % % ب إليه ألهاك عن أشجانك % 22(@)(@@) % ومن الغبن أن تباعدك الأيام % م بعد الدنو من ندمانك % 23(@)(@@) % ومن الضيم أن تشيبك الأحداث % فابن العشرين من أفعوانك % 24(@)(@@) % عل دهرا يديل من لوعة البين 
ms72	 % بحال تدنيك من إخوانك % 25(@)(@@) % فيواتيك من تحب وتشفي % % ما تجن الضلوع من أحزانك % PageV01P371 البحر : سريع 1(@)(@@) % عرش العلا منهدم مؤتفك % مذ جاور الأجداث عبد الملك % 2(@)(@@) % هاتيك شمس المجد مكسوفة % وإنما تكسف شمس الفلك % 3(@)(@@) % ماهي عين سفكت ماءها % % عليك بل أرواحها تنسفك % 4(@)(@@) % كأننا إذ راعنا هلكه % لم نر مخلوقا سواه هلك % 5(@)(@@) % حين تثنى للندى غصنه % وانتظم الأمر له واحتبك % 6(@)(@@) % واهتز كالسيف وأربى على الأ % % قران في المحفل والمعترك % 7(@)(@@) % وبان عن أكفائه مفردا % بالحمد عن إحسانه المشترك % 8(@)(@@) % وآض ركنا لبني هاشم % وصارما إن مس شيئا بتك % 9(@)(@@) % وصار للكل إذا ما بدا % % يقال هذا بشر أم ملك % 10(@)(@@) % وقال مولاه وأعداؤه % % تبارك الرحمن ما أكملك % PageV01P372 11(@)(@@) % راح عليه للردى رائح % وكل حي سالك ما سلك % 12(@)(@@) % يا جبلا راس على نعشه % كيف أطاق النعش أن يحملك % 13(@)(@@) % وشامل الدنيا بمعروفه % أنى لأكفانك أن تشملك % 14(@)(@@) % وتأمل الآمال من بعده % بتك صبري عمرك المنبتك % 15(@)(@@) % أبكيه لا للكأس بل للندى % % والبأس والفتك إذا مافتك % 16(@)(@@) % أبكيه للخصم إذا ما احتبى % % لحجة في مجلس أو برك % 17(@)(@@) % أبكيه للشمل الشتيت الذي % % حريمه من بعده منهتك % 18(@)(@@) % أبكي فتى تبكي لفقدانه ال % % غبراء فالخضراء ذات الحبك % 19(@)(@@) % أبكي كريما لو يرى مثله % ثم رأى طلعة ضيف ضحك % 20(@)(@@) % نادبه قل فيه ما شئت لن % يجحدك الشاني ولن يكذبك % PageV01P373 21(@)(@@) % ياساكن الأطراف أين الذي % % أعهده من حسن ذاك الحرك % 22(@)(@@) % يا لابس الأكفان قل لي لمن % تركت من بعدك لبس التكك % 23(@)(@@) % ويا هلالا محقت نوره % أيدي البلى ما أوحش المجد لك % 24(@)(@@) % زهدت في العيش وقبحته % عندي فما في العيش لي من درك % PageV01P374 البحر : سريع 1(@)(@@) % السحر في ألحاظها الفاتكه % والروح من إعراضها هالكه % 2(@)(@@) % والقهوة الصهباء منء ريقها % % والمسك من أصداغهها الحالكه % 3(@)(@@) % مملوكة تملك يا من رأى % % أحسن من مملوكة مالكه % 4(@)(@@) % منء لم ير الدر وتأليفه % في سلكه فليرها ضاحكه % 5(@)(@@) % تسلك من أجسام 
ms73	 أهل الهوى % % بحيث أرواحهم سالكه % 6(@)(@@) % قد كتب الحسن على خدها % % طل دم أنت له سافكه % PageV01P375 البحر : متقارب تام 1(@)(@@) % أخوك الذي إن عثر % ت أنهض من عثرتك % 2(@)(@@) % وإن ظهرت خلة % له سد من خلتك % 3(@)(@@) % يزينك في حضرتك % % ويرعاك في غيبتك % 4(@)(@@) % شريكك في محنتك % وأنسك في نعمتك % PageV01P376 البحر : كامل تام 1(@)(@@) % الثلج يسقط أم لجين يسبك % أم ذا حصا الكافور ظل يفرك % 2(@)(@@) % راحت به الأرض الفضاء كأنها % % من كل ناحية بثغرك تضحك % 3(@)(@@) % شابت ذوئبها فبين ضحكها % % طربا وعهدي بالمشيب ينسك % 4(@)(@@) % أوفى على خضر الغصون وأصبحت % كالدر في قضب الزمرد تسلك % 5(@)(@@) % وتزين الأشجار منه ملاءة % عما قليل بالرياح تهتك % 6(@)(@@) % كانت كعود الهند عريا فانكفت % في لون أبيض وهو أسود أحلك % 7(@)(@@) % والجو من أرج الهواء كأنه % % ثوب يعنبر تارة ويمسك % 8(@)(@@) % فخذي من الأوتار حظك إنما % % تتحرك الأوتار حين تحرك % 9(@)(@@) % فاليوم يؤذن بالملاحة أنه % سيطل فيه دم الدنان ويسفك % PageV01P377 البحر : مديد تام 1(@)(@@) % ضحكت من مشيبة ضحكت % في سواد اللمة الرجله % 2(@)(@@) % ثم قالت وهي ضاحكة % جاء هذا الشيب بالعجله % 3(@)(@@) % قلت من حبك لا من كبر % شاب رأسي فانثنت خجله % 4(@)(@@) % وثنت جفنا على كحل % هي منه الدهر مكتحله % 5(@)(@@) % أكثرت منه تعجبها % % وهي تجنيه وتعجب له % 6(@)(@@) % كيف لا يبلى شباب فتى % تقطعين الحبل إن وصله % 7(@)(@@) % مفرد بالبين مصطبر % كلما حملته حمله % 8(@)(@@) % وهي مثل البدر تحمله % قامة كالغصن معتدله % 9(@)(@@) % ولها لحظ تظن به % أنها من قهوة ثمله % 10(@)(@@) % أقصدت قلبي به فمضى % % سهمه فيه وقد قتله % PageV01P378 11(@)(@@) % قد تجشمت السؤال فما % % نفعتني عندها المسأله % 12(@)(@@) % وشكوت الوجد وهي بما % % أشتكيه غير محتفله % 13(@)(@@) % عاذلي دع عنك عذل فتى % لح في عصيان من عذله % 14(@)(@@) % أنا مشغوف الفؤاد بها % % وهي بالهجران مشتغله % PageV01P379 البحر : كامل تام 1(@)(@@) % نفسي الفداء لمن يخالفني % % في كل أمر منية وعمل % 2(@)(@@) % قد كدت أجفوه لأغريه % بخلاف ما اختار فيصل % 3(@)(@@) % ولو أنني أعطي 
ms74	 برؤيته % قلبي لقل بالحبيب بدل % PageV01P380 البحر : رمل تام 1(@)(@@) % عذبت بالرشف منه شفة % مصها أطيب منء نيل الأمل % 2(@)(@@) % وعليها حمرة في لعس % تستعير اللون من صبغ الخجل % 3(@)(@@) % فهي فيما خلت آثار دم % من فؤاد عل منه ونهل % PageV01P381 البحر : طويل 1(@)(@@) % يقولون تب والكأس في كف أغيد % وصوت المثاني والمثالث عالي % % 2(@)(@@) % فقلت لهم لو كنت أضمرت توبة % وأبصرت هذا في المنام بدا لي % % PageV01P382 البحر : - 1(@)(@@) % اتخذ الليل حمل % ما حمل الليل حمل % 2(@)(@@) % والليل فيه متعة % والليل أخلى للعمل % 3(@)(@@) % آمن فيه زائرا % يشغلني عن الشغل % 4(@)(@@) % وإن عراني ملل % نفيت بالراح الملل % PageV01P383 البحر : مديد تام 1(@)(@@) % من ترى ينصفني من خليل % لم يزل يلبس ثوب الملول % 2(@)(@@) % كلما طاف به العاذلون % لج به في سرعة بالقبول % 3(@)(@@) % والوشاة ويحهم لا ينون % في اقتضاب حبل وصال الوصول % 4(@)(@@) % كيف لا يحول هوى من لديه % منظر ومستمع للعذول % 5(@)(@@) % لو يرى مودته في الضمير % لم يزل يقابلني بالجميل % 6(@)(@@) % لا ولا كرامة للعاذلين % لا أصد قبل قيام الدليل % 7(@)(@@) % لا أصد منهم للصديق % أسرتي وأسرته من قبيل % 8(@)(@@) % أنفس مؤتلفة بالإخاء % كلها تدين بحب الرسول % 9(@)(@@) % فارج الظلام وهادي الأنام % والوصي صاحبه والبتول % 10(@)(@@) % فضل هذا لصاحبه وال % % عدو مكتئب قلبه بالغليل % PageV01P384 11(@)(@@) % بيننا مواصلة لا يبت % حبلها بقال عدو وقيل % 12(@)(@@) % وامتزاج أنفسنا بالصفاء % كامتزاج صوب حيا بالشمول % 13(@)(@@) % غير أن ذا حسد قد يلح % بالدخول بينهما بالفضول % 14(@)(@@) % فهو لا يفوز بما يرتجيه % ولا يضلهما عن سبيل % 15(@)(@@) % يا أخي با عضدي في الخطوب % والذي أنال به كل سول % 16(@)(@@) % والذي يشاركني في القد % % يم وعزتي ومحولي % % 17(@)(@@) % دم على ودادك ما بقيت % ولا ترد هديت به من بديل % 18(@)(@@) % ليس بيننا بعد في الفخار % كل واحد لأخيه كالرسيل % PageV01P385 البحر : كامل تام 1(@)(@@) % قل للمليحة في الخمار الأكحل % كالشمس من خلل الغمام المنجلي % % 2(@)(@@) % بحياة حسنك أقصري وبحق من % جعل الجمال عليك وفقا أجملي % % 3(@)(@@) % لا تقبلي 
ms75	 قول العذول فإنني % % لم أصغ فيك إلى مقال العذل % 4(@)(@@) % إني أعيذك أن يكدر آخر % بمقالة الواشين صفو الأول % PageV01P386 البحر : بسيط تام 1(@)(@@) % لما رأيت مطاياهم معلقة % ودمعتي من حذار البين تنهمل % 2(@)(@@) % ووجهت من وراء الستر تخبرني % % أن الخليط غروب الشمس مرتحل % 3(@)(@@) % قلت ارفعي السجف نستمتع بوقفتنا % % فالشمس ما غيبت من وجهك الكلل % 4(@)(@@) % فأبرزت وجهها والشمس آفلة % ومر ليلي ولم يرحل لهم جمل % 5(@)(@@) % لم يشعروا بغروب الشمس إذ سفرت % عن وجهها فاضاء السهل والجبل % 6(@)(@@) % حتى إذا نحن قضينا لبانتنا % % وغيبت وجهها في الكلة ارتحلوا % % PageV01P387 البحر : خفيف تام 1(@)(@@) % إن دينارنا الذي فضح المخل % % ف من وعده قديم أصوله % 2(@)(@@) % ماله من سميه حين يبكي % % غير إكرامه لعرض مذيله % 3(@)(@@) % محنق من أحبه ومريد % من أباه ومانع لمنيله % PageV01P388 البحر : كامل تام 1(@)(@@) % يا معرضا عني بوجه مدبر % ووجوه دنياه عليه مقبله % 2(@)(@@) % هل بعد حالك هذه من حالة % أو غاية هي لانحطاط المنزله % 3(@)(@@) % أو ما علمت بأن أحوال الفتى % % كالغي في أحواله المتنقله % 4(@)(@@) % ساع إلى النقصان يسرع حبه % % عجلان يقطع كل يوم مرحله % 5(@)(@@) % الناس أكفاء ولكن فاتهم % بالفضل مأمول أصاخ مؤمله % 6(@)(@@) % ومياه أوجههم سواء كلها % % إلا الذي يعنى بسوء المسأله % 7(@)(@@) % فاجعل لنا حظا من الحال التي % % عما قليل منك تغدو أرمله % 8(@)(@@) % لا تستبد بما منحت فإنما % % هي فلتة أو عادة متحوله % 9(@)(@@) % لسنا نجشمك النوال فإنه % متجسم أعباؤه مستثقله % 10(@)(@@) % لمن نسومك بذل جاهك فاحبنا % % منه فإن زكاته أن تبذله % PageV01P389 11(@)(@@) % وافتح بننك حيث أمكن فتحها % % بالمكرمات ولا تدعها مقفله % 12(@)(@@) % كم من يد ندمت على إمساكها % % في شغلها لما غدت متعطله % 13(@)(@@) % لا يقلينك شكرنا وثناؤنا % % فتعض من ندم عليه الأنمله % PageV01P390 البحر : منسرح 1(@)(@@) % أصبحت لا مال لي سوى الأمل % وأنني عامل بلا عمل % 2(@)(@@) % ولي غريم مراصد ختل % أعجز قصد احتياله حيلي % % 3(@)(@@) % ما حد بيني وبينه أجلا % إلا توهمت أنه أجلي % % PageV01P391 البحر : رجز تام 1(@)(@@) % مهفهف الأعطاف 
ms76	 مرتج الكفل % محكم الأجفان من كحل الكحل % 2(@)(@@) % طوق في الجيد كتطويق الحجل % بعارض منقطع لم يتصل % 3(@)(@@) % يتبعه الحسن وترعاه المقل % % PageV01P392 البحر : بسيط تام 1(@)(@@) % من أين نفرغ أو يأوي لينا فلك % بما درايا وأهل الترب مشغول % 2(@)(@@) % يعاقب الملك فيما بينهم دولا % والحر في خلل الحالين مقتول % PageV01P393 البحر : خفيف تام 1(@)(@@) % تخرجت اقبح المخارج منه % لحية قوبلت بغير الجميل % 2(@)(@@) % لم يدعها تطول حتى علاهلا % % واضح الشيب في الزمان الطويل % 3(@)(@@) % مل من حلقها فشابت ولكن % شيبها كان كامنا في الأصول % 4(@)(@@) % فرأيناه بالعشي غلاما % وغدونا نعده في الكهول % 5(@)(@@) % لم يكن بين مرده ومشيب % فاصل والأمور ذات فصول % PageV01P394 البحر : مجزوء الكامل 1(@)(@@) % بي إن عزرت عليك ذل % ولك الرياسة والمحل % 2(@)(@@) % يا ابن الخلائف والغطا % % رف والألى عقدوا وحلوا % % 3(@)(@@) % ونمتهم العلياء من % عدنان والشرف المطل % 4(@)(@@) % بين النبوة والخلا % % فة حل فخرهم فحلوا % % 5(@)(@@) % إن كان إدلالا بدا % % مني فمثلي من يدل % 6(@)(@@) % آيستني وغدرت بي % % جدلا أراح وأستهل % 7(@)(@@) % وبسطت خلقا لا يعاب % ولا يذم ولا يمل % 8(@)(@@) % فهفوت هفوة غلطة % والحر يهفو ويذل % 9(@)(@@) % والصارم العضب المهند % فيه آثار وفل % 10(@)(@@) % والطرف يعثر ثم يد % ركه النجاء فيستعل % PageV01P395 11(@)(@@) % وهممت عنك بسلوة % فطفقت عن رشدي أضل % 12(@)(@@) % وذكرت ما أوليتني فظلل % ت من عزمي أحل % 13(@)(@@) % فرجعت رجعة شاكر % بحقوق ودك لا يخل % 14(@)(@@) % وعلمت أن فراق مثلك % لا يجوز ولا يحل % PageV01P396 البحر : منسرح 1(@)(@@) % جنبك اله عارض العلل % ونلت ما عشت أبعد الأمل % 2(@)(@@) % يا سيدا كل سيد تبع % له وطوع في الصرف والعمل % 3(@)(@@) % وكاتبا تشهد الكتابة بالف % ضل له وهو بالفضل يشهد لي % % 4(@)(@@) % يعزل قوم فينتقصون ولا % % تنقص يا ذا الجلال والنبل % 5(@)(@@) % يظهر بالعزل ما تقدم من % % آثارك المستنيرة السبل % 6(@)(@@) % تتعب والله صار فيك كما % % يتعب من بعده تراك كلي % % 7(@)(@@) % مستدرك ما أضاع ذاك وما % % حاول ما نلته فلم ينل % 8(@)(@@) % إني وما سيد بمحتشم % ولا ولا 
ms77	 أيضا بمحتفل % 9(@)(@@) % حضرت بالأمس ما أسر به % من التغذي بمخلف الحجل % 10(@)(@@) % فلم أزل مبتغيه مجتهدا % في السهل من أرضه وفي الجبل % PageV01P397 11(@)(@@) % حتى تقنصت ما بعثت به % والبر بر في الدق والجلل % 12(@)(@@) % تفاؤلا فيه بالرياش وبالنج % % ح لما في حروفه الأول % 13(@)(@@) % وهذه أنسة سلكت بها % % مسالك الأولياء والخول % 14(@)(@@) % فإن تطولت بالقبول له % فهذه نعمة تجدد لي % % 15(@)(@@) % لأن في رده مصحفه % % فصن رسولي عن ذله الخجل % PageV01P398 البحر : بسيط تام 1(@)(@@) % كلي إلى اللوم غيري ربة الكله % ما أنت في خلق مني ولا مله % 2(@)(@@) % يأبى قبول ملام تولعين به % خطب عرى لا قلى مني ولا مله % 3(@)(@@) % خافت سلوي فلحت في معاتبتي % % وكفكفت عبرة في الخد منهله % 4(@)(@@) % بيضاء عدل فيها الحسن فاعتدلت % كفاء لا دقة تشكو ولا عثله % 5(@)(@@) % كأنما حكمت في الحسن فانصرفت % عن دقه واقتفت مختارة جله % 6(@)(@@) % واستأثرت بأصول لا كفاء لها % % من الجمال وأعطت غيرها الفضله % 7(@)(@@) % مليكة توجت باللون فاشتملت % كم فتنة تحت ذاك اللون والشمله % 8(@)(@@) % إني توهمت إقصاري ومنحرفي % % بالود عنك وأنت الغادة الطفله % 9(@)(@@) % وفيك ما فيك من معنى يعل به % قلب الصحيح ومعنى برأ العله % 10(@)(@@) % ضدان تفتير ألحاظ يشربها % % غليل شوق وثغر برد الغله % PageV01P399 11(@)(@@) % ومنطق فاتر لم يلق جيش نهى % % إلا سباه بسحر اللحظ أو فله % 12(@)(@@) % وناظر لم يقابل عقد لب فتى % % إلا سناه عن الإقصاد أو جله % 13(@)(@@) % وبين ثوبيك أملود يميس على % % نقا ويعتز عن لين وعن بله % 14(@)(@@) % ضللت في العدل فاثني عنه مقصرة % فهذه جملة في العذر كافية % 15(@)(@@) % وأنصتي لمقالي تعرفي عذري % % وأحسني بعد تسليم لأمر الله % 16(@)(@@) % أخل في من أمور كن من أربي % % ياهذه الجود إن الحال مختله % 17(@)(@@) % وإن شيبي قد لاحت كواكبه % في ظلمة من سواد اللمة الجثله % 18(@)(@@) % وبان مني شباب كان يشفع لي % % سقيا له من شباب بان سقيا له % 19(@)(@@) % قد كان بابي للعافين منتجعا % ينتابه ثلة من بعدها ثله 
ms78	 % 20(@)(@@) % وكنت طود المنى يأوي إلى كفني % % كحائط مشرف من فوقه ظله % PageV01P400 21(@)(@@) % أفني الكثير فما إن زال ينقصني % % متى دفعت إلى الأفنان والقله % 22(@)(@@) % وقد غنيت وأشغالي تبين من % % فضلي فقد سترته هذه العطلة % 23(@)(@@) % والسيف في الغمد مجهول جواهره % وإنما يجتنيه عين من سله % 24(@)(@@) % كم في من خلة لو أنها أمتحنت % أدت إلى غبطة أو سدت الخله % 25(@)(@@) % وهمة في محل النجم موقعها % % وعزمة لم تكن في الخطب منجله % 26(@)(@@) % وذلة أكسبتني عز مكرمة % وربما يستفاد العز بالذله % 27(@)(@@) % صاحبت سادات أقوام فما عثروا % % يوما على هفوة مني وى زله % 28(@)(@@) % واستمتعوا بكفشاياتي وكنت لهم % أوفى من الذرع أو أمضى من الأله % 29(@)(@@) % خط يروق وألفاظ مهذبة % لا وعرة النظم بل مختارة سهله % 30(@)(@@) % لو أنني منهل منها أخا ظمأ % روت صداه فلم يحتج إلى غله % PageV01P401 31(@)(@@) % وكم سننت رسوما غير مشكلة % كانت لمن أمها مسترشدا قبله % 32(@)(@@) % عمت فلا منشىء الديوان مكتفيا % منها ولم يغن عنها كاتب السله % 33(@)(@@) % وصاحبتني رجالات بذلت لها % % مالي فكان سماحي يقتضي بذله % 34(@)(@@) % فاعمل الدهر في ختلي مكائده % والدهر يعمل في أهل الهوى ختله % 35(@)(@@) % لكن قنعت فلم أرغب إلى أحد % والحر يحمل عن إخوانه كله % 36(@)(@@) % هذا على أنني لا أستفيق ولا % % أفيق من رحلة في إثرها رحله % 37(@)(@@) % وما على البدءر نقص في إضاءته % أن ليس ينفك من سير ومن نقله % 38(@)(@@) % أقنى الحياء فأستغني به فإذا % % أعل قوم بحسن الصبر لي عله % 39(@)(@@) % أعملت بعض رجائي في الكرام وفي % % أبي علي قد استغرقته كله % 40(@)(@@) % وما الحضيض إذا أستطعمت من أربي % % وقد وجدت سبيلا لي إلى القله % PageV01P402 41(@)(@@) % مستيقظ بحميل الذكر يكسبه % % ليست به سنة عنه ولا غفله % 42(@)(@@) % زاكي المغارس والأعراق طيبة % من نبعة عودة في المجد لا أثله % 43(@)(@@) % جاز إلى القوم أقواما فبددهم % وجاء من بعد من قد رامه قبله % 44(@)(@@) % وطاولوه فما زالت لهم همم % حتى أحل على هاماتهم نعله % 45(@)(@@) % وقصروا أن 
ms79	 ينالو بعد شأو فتى % جلى فاحرز في مضماره خصله % 46(@)(@@) % كأنما الماء يجري من خلائقه % والنار تستن من ألفاظه الجزله % 47(@)(@@) % يزداد حبا إلينا حين نخبره % لا كالذي قيل فيه أبله تقله % 48(@)(@@) % إن كنت في ريب شك من رياسته % فسمه أو فاختبره تعترف نبله % 49(@)(@@) % مرشح للتي لا يستقل بها % % إلا الذي عرفت أعداؤه فضله % 50(@)(@@) % وما أقلوا على غل الصدور له % بذاك حتى رأوا أن لم يروا مثله % PageV01P403 51(@)(@@) % قرم إذا ما أحالت كفه قلما % في الطرس قلت كمي ينتضي نصله % 52(@)(@@) % يمج ضربين من صاب ومن عسل % ومعنين من النضناض والنحله % 53(@)(@@) % يبكي ببحر من التدبير موقعة % من حيث حل ولكن دمعه طله % 54(@)(@@) % ينفذ الأمر في أمضى وأسرع من % رجع النواظر لا ريث ولا مهله % 55(@)(@@) % تصبو إليه المعالي إذ تراح له % كأنما عشقت منه العلا شكله % 56(@)(@@) % كم مقلة لعظيم من رياسته % تغضي غذا لحظضت يوما بني مقله % 57(@)(@@) % لا يستطيع إلى إيضاحه سبلا % في المجد أكفاؤه إن يسلكوا سبله % 58(@)(@@) % مواهب من عطايا الله خض بها % % ونحلة من جواد والعلا نحله % 59(@)(@@) % لا يبلغ الدهر أن يشكي مجاوره % ولا يهي غير حبل لم يصل حبله % 60(@)(@@) % ياباذل الجود في صون المحل لقد % أبدعت إذ تستفيد الصون بالبذله % PageV01P404 61(@)(@@) % أصبحت جارك فاكنفني برأيك من % زهر أراه مصر الكيد ذا نبله % 62(@)(@@) % إني لموضع أنس حين تفرغ لي % % وإن شغلت فكاف ترتضي شغله % 63(@)(@@) % وقيل : كن جار بحر أو فتى ملك % وأنت بحر ومثوانا على دجله % 64(@)(@@) % متى يضيء عليه ظلكم وأخو ال % % علا يضيء على إخوانه ظله % 65(@)(@@) % ولا أسومك إلا الجاه تبذله % فتستعيض به من مدحتي حله % 66(@)(@@) % والله يزكيه أن يحبوا المحق به % كالعلم يزكيه أو يحبو له أهله % 67(@)(@@) % والدهر دهر مشؤوم قد تهضمني % % جورا علي فأربى مرة عذله % 68(@)(@@) % وأنت ممن ينال الحر بغيته % به ويأمن من ميعاده مطله % PageV01P405 البحر : كامل تام 1(@)(@@) % حب الوصي مبرة وصله % وطهارة بالأصل مكتفله % 2 
ms80	(@)(@@) % والناس عالمهم يدين به % حبا ويجهل حقه الجهله % 3(@)(@@) % ويرى التشيع في سراتهم % والنصب في الأرذال والسفله % PageV01P406 البحر : رمل تام 1(@)(@@) % صاحب لي ليس فيه % خلة أشكرها له % 2(@)(@@) % سمج شخصا ومخبو % % را وتفصيلا وجمله % 3(@)(@@) % كل من جاراه في مض % % مار لؤم جاء قبله % 4(@)(@@) % لابسا كزا على ما % % فيه من غدر ومله % 5(@)(@@) % ومريد من أباه % ومهين من أجله % 6(@)(@@) % فهو كالدينار لا % % يكرم إلا من أذله % PageV01P407 البحر : كامل تام 1(@)(@@) % حي الربيع تحية المستقبل % أهدى لنا غيما بغيث مسبل % 2(@)(@@) % متكاثف الأنواء مغتدق الحيا % % هطل الندى هزج الرعود بجلجل % 3(@)(@@) % جاءت بعزل الجدب فيه وبشرت % بالخصب أنواء السماك الأعزل % 4(@)(@@) % في ليلة حجب السماء نجومها % % وكأنما أفلت ولما تأفل % 5(@)(@@) % والبدر في خلل الغمام كأنه % قبس يضيء وراء ستر مسبل % 6(@)(@@) % وكأن لمع البرق في جنباته % كف الشجاع تهز متن المنصل % 7(@)(@@) % يدنو فيسحب للرياض معانقا % طورا ويقطعه هباب الشمأل % 8(@)(@@) % كالصب هم بقبلة حتى إذا % % لحظته عين رقيبه لم يفعل % 9(@)(@@) % فامنح أخاك الغيث وجه طلاقة % والق الربيع بأنسه وتهلل % 10(@)(@@) % واعرف له حق القدوم بقهوة % عذراء تمزج بالزلال السلسل % PageV01P408 11(@)(@@) % صهباء تمزج بالهلال ويتقى % % منها أليم القتل إن لم تقتل % 12(@)(@@) % كالخد لاقته العيون فعصفرت % مبيض وجنته بلحظة مخجل % 13(@)(@@) % من كف مياس القوام كأنه % % ريحانة ريانة المتقبل % 14(@)(@@) % يلوي أنامله على آذانه % % 15(@)(@@) % كملت ترائبه فبان كلامه % للسمع من جسد خفيف المحمل % 16(@)(@@) % خلخاله في نحر هو لسانه % في أذنه وجبينه من أسفل % 17(@)(@@) % هزج يخف على الأكف ولفظه % يعلوا بتليف الثقيل الأول % 18(@)(@@) % فكأنما شخص الغريض ممثل % في العود أو سلكته روح الموصلي % % 19(@)(@@) % لا سيما إن حث من أصواته % صوتا يصاب به مكان المقتل % 20(@)(@@) % يا أخت ناجية السلام عليكم % قبل الرحيل وقبل لوم العذل % PageV01P409 21(@)(@@) % فاشرب على نغماته من كفه % واجل الصبابة بالمدامة تنجلي % % PageV01P410 البحر : منسرح 1(@)(@@) % يا رب مهد هدية لطفت % قدرا ولكن محلها جلل % 2(@)(@@) % إن هدايا الرجال مخبرة 