ms505	 نوروز مرا بوسه دهد باز %~% وامسال برآنم ‌که فزونتر دهد از پار(@)(@@) 2 پار از من و از رندی من بودگریزان %~% و امسال ‌گریزد به من از صحبت اغیار(@)(@@) 3 ‌قلاشی من پار چنان بود که آن شوخ %~% یک بوسه مرا داد به صد عذر و صد انکار(@)(@@) 4 و امسال بر آنم که اگر پای نهم پیش %~% بر دست من از شوق زند بوسه دو صدبار(@)(@@) 5 پارم همه می‌دید به‌کف شیشه و ساغر %~% وامسال مرا بیند با سبحه و دستار(@)(@@) 6 پار ار ز پی ورد بهم بر زدمی لب %~% می‌گفت پی بوسه مکوب این همه منقار(@)(@@) 7 وامسال فرو چینم اگر لب پی بوسه %~% پیش آید تا بشنود آواز ستغفار(@)(@@) 8 زهد منش از راه برون برده و غافل %~% کز رندی پنهان بود این زهد پدیدار(@)(@@) 9 حاشا که من از زهد کنم توبه ازیراک %~% امروز نکو یافتمش قیمت و مقدار(@)(@@) 10 حال من و آن ترک به یک جای نشسته %~% او روی به من‌کرده و من روی به دیوار(@)(@@) 11 او سر ز در شرم فروداشته در پیش %~% چون‌کودک نادان بر استاد هشیوار(@)(@@) 12 من چشم فراکرده و مژگان زده برهم %~% چون صوفی صافی به‌گه خواندن اذکار(@)(@@) 13 بوزینه صفت‌ گاه نشستم به دو زانو %~% پیچیده به خود خرقه و سر کرده نگونسار(@)(@@) 14 او حالت من دیده و چشمانش ز حیرت %~% چون دیده مکحول فرومانده ز دیدار(@)(@@) 15 حقاکه من این حیله نیاموحتم از خویش %~% زین حیله مرا واعظکی‌کرد خبردار(@)(@@) 16 یک روز به هنگام زدم گام به مسجد %~% کان بود طریقم به سوی خانه خمار(@)(@@) 17 صف صف گرهی دیدم جاجا شده ساکن %~% پنهان همه مدهوش و عیانی همه هشیار(@)(@@) 18 بر رفته یکی واعظ محتال به منبر %~% زانگونه‌که بر طارم رز روبه مکار(@)(@@) 19 گاهی به زبانش سخن از دوزخ و سجین %~% گاهی به دهانش سخن از جنت وانهار(@)(@@) 20 از فرط شبق 
ms506	 ساز بم و زیر نهاده %~% چون‌گربه‌که موموکند از شهوت بسیار(@)(@@) 21 وان جمله دهان در عوض‌گوش‌گشاده %~% کز راه دهانشان ره دل‌گیردگفتار(@)(@@) 22 طاووس خرامان همه‌ حیران شده در وی %~% وان طره چون مار فروهشته به رخسار(@)(@@) 23 زان گونه که پیرامن گل خار بگیرد %~% بگرفته بتان چون گل پیرامن آن خار(@)(@@) 24 وندر شکن طره ایشان دل واعظ %~% جا کرده چو شیطان لعین در دهن مار(@)(@@) 25 با او همه را انس عیان جای تنفر %~% او صرصر و این طرفه که ره جسته به گلزار(@)(@@) 26 من راستی آن سیرت و هنجار چو دیدم %~% گفتم که ازین پس من و این سیرت و هنجار(@)(@@) 27 هنجار من اینست و سپس مصلحتم نیست %~% کان راز نهان را به رفیقان کنم اظهار(@)(@@) 28 من سیرت و هنجار نهان دارم از خلق %~% تا هیچ ‌کسم می‌نشود واقف اسرار(@)(@@) 29 کان راز که ثابت بود اندر دل ظاهر %~% چون‌گشت هماندم به جهان‌گردد سیار(@)(@@) 30 گردند چو خلقم همی آگاه ز تزویر %~% فاسد شود کار و تبه‌ گردد کردار(@)(@@) 31 از من برمد هرجا آهوی خرامیست %~% وانچیزکه آسان شمرم‌ گردد دشوار(@)(@@) 32 ناچار ازین پس من و تزویر کزین راه %~% با خویش توان رام نمودن بت عیار PageV1P255(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 همتی مردانه می‌خواهم‌که اسمعیل‌وار %~% بر خلیل خویشتن امروز جان سازم نثار(@)(@@) 2 عید قربانست و من قربان آن عیدی‌ که هست %~% کوی او دایم بهشت و روی او دایم بهار(@)(@@) 3 زان سبب قربان اسمعیل باید شدکه او %~% گشت قربان ‌کسی ‌کاو را ز قربانیست عار(@)(@@) 4 عار دارد آری از قربانی آن یاری که هست %~% نور هستی از فروغ ذات پاکش مستعار(@)(@@) 5 در چنین روزی ‌که اسمعیل شد قربان دوست %~% بهتر از امروز روزی نبود اندر روزگار(@)(@@) 6 من به حق قربان اسمعیل خواهم شدکه او %~% عاشق حق بود و عاشق راست قربانی شعار(@)(@@) 7 کشته‌کوی محبت را دعا نفرین بود %~% زین دعا 
ms507	 بالله‌ کز اسمعیل هستم شرمسار(@)(@@) 8 من چه حد دارم شوم قربان قربانی‌که او %~% بس امام پاک‌زاد و بس خلیفه نامدار(@)(@@) 9 همچ‌ر ابمعیل منهم جان‌کنم قربان دوست %~% گو مرا دشمن در آذر افکن ابراهیم‌وار(@)(@@) 10 مردم اسمعیلیم خوانند و حق دارند از آنک %~% نام اسمعیل رانم بر زبان بی‌اختیار(@)(@@) 11 اختیاری نیست عاشق را به ذکر نام دوست %~% عشق اول اختیارست عشق آخر اضطرار(@)(@@) 12 تا نپنداری که اسمعیل جان قربان نکرد %~% کاو گذشت از جال شیرین در حقیقت چند بار(@)(@@) 13 وقت گفتن وقت رفتن وقت خفتن زیر تیغ %~% کرد جان تسلیم و در سر باختن بد پایدار(@)(@@) 14 ور دلش را رای آن بودی‌ که بهراسد ز مرگ %~% هفت ره ابلیس را در ره نکردی سنگسار(@)(@@) 15 کار عاشق این بود کز جان شیرین بگذرد %~% وان دگر معشوق داند کشتنش یا زینهار(@)(@@) 16 همچو اسمعیل ‌کاو جان ‌داد اگر یارش نکشت %~% می نباید کشت اسمعیل را بر رغم یار(@)(@@) 17 او‌ به‌معنی جان فداکرد ارچه در صورت خدا %~% کرد میش او را فدا کاین‌ کیش ماند برقرار(@)(@@) 18 حرمت ‌او راست ‌کاندر عید قربان تا به‌ حشر %~% این همه قربان ‌کنند از بهر قرب ‌کردگار(@)(@@) 19 راستی را عید قربان بهترین عیدست از آنک %~% در نشاط آیند جانبازان عشق از هر کنار(@)(@@) 20 میش ‌را عامی‌ کند قربان‌ و مقصودش ریا %~% خویش را عارف کند قربان و عزمش‌ انکسار(@)(@@) 21 آن به بیع‌کشته‌خود خونبها خواهد ز دوست %~% آن به ریع ‌کشته خود برخورد از کشتزار(@)(@@) 22 راستی گویم کسی تا سر نبازد پیش دوست %~% دشمن یارست اگر خود را شمارد دوستدار(@)(@@) 23 عشق طغیان کرد باز ای دل فروکش سر به جیب %~% یا اگر بر صدق دعوی حجتی داری بیار(@)(@@) 24 یا بیا چون شیر مردان سر بنه در پیش تیغ %~% یا برو چون نوعروسان یا بکش از نیش خار(@)(@@) 25 رستم ‌کاموس‌ بند اشکبوس افکن رسید 
ms508	 %~% جنگ را گر مرد جنگی زاستین دستی برآر(@)(@@) 26 عشق ‌سهرابست‌بر وی حمله‌کم‌کن ای هجیر %~% رود غرقابست در وی باره‌کم ران ای سوار(@)(@@) 27 پشه‌یی در کاهدان خز خرطم پیلان مگز %~% روبهی در لانه بنشین‌ گردن شیران مخار(@)(@@) 28 راستی گر عاشقی جان آشکارا ده به دوست %~% پیش از آن‌ کت مرگ موعود از کمین‌ سازد شکار(@)(@@) 29 ‌گر نه مفتی جهولی پیش از استفتا بگو %~% و‌رنه ابر خشک‌سالی پیش‌ از استسقا ببار(@)(@@) 30 عقل را بنیان بکن چون عشق شد فرمانروا %~% شمع را‌ردن بزن چون صبح‌‌ردید آشکار(@)(@@) 31 رنج‌ و راحت هر دو همسنگند در میزان عشق %~% شیر و قطران هر دو همرنگند در شبهای تار(@)(@@) 32 پشک را عنبر شمر چون‌ گشت با مغز آشنا %~% زهر را شکر شمر چون گشت با تن سازگار(@)(@@) 33 مرد افیون‌ خوار می‌نندیشد از افیون تلخ %~% شخص افسون‌کار می‌ نهراسد از دندان مار(@)(@@) 34 زشت و زیبا هر دو مطبوعست نزد حق‌پرست %~% شور و شیرین هر دو ممدوحند نزد حق گزار(@)(@@) 35 عیب‌ مردم پیش ازین می‌گفتم‌ اندر چشم خلق %~% و‌رقتیم آیینه‌گفتا آخر از خود شرم‌دار(@)(@@) 36 با چنین پستی ‌که داری لاف رعنایی مزن %~% با چنین زشتی که داری تخم زیبایی مکار(@)(@@) 37 عیب‌جویی را بهل هیچ ار هنر داری بگو %~% غیب‌گویی را بنه هیچ ار خبر داری بیار(@)(@@) 38 یک خبر دارم بلی یزدان بود پوزش پذیر %~% یک هنر دارم بلی هستم به ‌حق امیدوار(@)(@@) 39 ای دل از سر باختن‌ گردن مکش در پیش دوست %~% کانکه بر جانان سپارد جان عوض گیرد هزار(@)(@@) 40 میش‌ قربانی‌ کش اینک ‌کشته بینی هر طرف %~% باز هر لقمه از آن‌ گردد روانی هوشیار(@)(@@) 41 لقمه او سنگ را ماند کز اول تیره است %~% چون‌گدازد آینه روشن شود انجام‌کار(@)(@@) 42 قدر سربازی شناسد آن‌کسی‌کز روی شوق %~% جان‌فشاند همچو میرملک جم‌بر شهریار(@)(@@) 43 میر دریا دل حسین‌خان آسمان مکرمت %~% صدر دین بدر هدی بحر 
