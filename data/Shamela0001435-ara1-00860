ms841	 بن أبي إسحاق، عن أبي إسحاق الهمداني، عن أبي جحيفة، عن علي، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من أصاب حدا فعجل عقوبته في الدنيا فالله أعدل من أن يثني على عبده العقوبة في الآخرة، ومن أصاب حدا فستره الله عليه وعفا عنه فالله أكرم من أن يعود في شيء قد عفا عنه» : (@)(@@) @MATN@ «وهذا حديث حسن غريب، وهذا قول أهل العلم لا نعلم أحدا كفر أحدا بالزنا أو السرقة وشرب الخمر» (@)(@@) (@)PageV05P016 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في أن المسلم من سلم المسلمون من لسانه ويده (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٢٧ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن عجلان، عن القعقاع بن حكيم، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «المسلم من سلم المسلمون من لسانه ويده، والمؤمن من أمنه الناس على دمائهم وأموالهم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@) ويروى عن النبي صلى الله عليه وسلم أنه سئل أي المسلمين أفضل؟ قال: (@)(@@) @MATN@ «من سلم المسلمون من لسانه ويده» (@)(@@) وفي الباب عن جابر، وأبي موسى، وعبد الله بن عمرو (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٢٨ - (@)(@@) حدثنا بذلك إبراهيم بن سعيد الجوهري قال: حدثنا أبو أسامة، عن بريد بن عبد الله بن أبي بردة، عن جده أبي بردة، عن أبي موسى الأشعري، أن النبي صلى الله عليه وسلم سئل أي المسلمين أفضل؟ قال: (@)(@@) @MATN@ «من سلم المسلمون من لسانه ويده» : (@)(@@) @MATN@ «هذا حديث صحيح غريب من حديث أبي موسى عن النبي صلى الله عليه وسلم» (@)(@@) (@)PageV05P017 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن الإسلام بدأ غريبا وسيعود غريبا (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٢٩ - (@)(@@) حدثنا أبو كريب قال: حدثنا حفص بن غياث، عن الأعمش، عن أبي إسحاق، عن أبي الأحوص، عن عبد الله، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الإسلام بدأ غريبا وسيعود غريبا كما بدأ، فطوبى للغرباء» (@)(@@) وفي الباب عن سعد، وابن عمر، وجابر، وأنس، وعبد الله بن عمرو: (@)(@@) @MATN@ " هذا حديث حسن صحيح غريب من حديث ابن مسعود، إنما نعرفه من حديث حفص بن غياث، عن الأعمش، وأبو الأحوص اسمه: عوف بن مالك بن 
ms842	 نضلة الجشمي. تفرد به حفص " (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٠ - (@)(@@) حدثنا عبد الله بن عبد الرحمن قال: أخبرنا إسماعيل بن أبي أويس قال: حدثني كثير بن عبد الله بن عمرو بن عوف بن زيد بن ملحة، عن أبيه، عن جده، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إن الدين ليأرز إلى الحجاز كما تأرز الحية إلى جحرها، وليعقلن الدين من الحجاز معقل الأروية من رأس الجبل، إن الدين بدأ غريبا ويرجع غريبا، فطوبى للغرباء الذين يصلحون ما أفسد الناس من بعدي من سنتي» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)PageV05P018 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في علامة المنافق (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣١ - (@)(@@) حدثنا أبو حفص عمرو بن علي قال: حدثنا يحيى بن محمد بن قيس، عن العلاء بن عبد الرحمن، عن أبيه، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «آية المنافق ثلاث، إذا حدث كذب، وإذا وعد أخلف، وإذا ائتمن خان» : (@)(@@) @MATN@ «هذا حديث حسن غريب من حديث العلاء وقد روي من غير وجه عن أبي هريرة، عن النبي صلى الله عليه وسلم» (@)(@@) وفي الباب عن ابن مسعود، وأنس، وجابر حدثنا علي بن حجر قال: حدثنا إسماعيل بن جعفر، عن أبي سهيل بن مالك، عن أبيه، عن أبي هريرة، عن النبي صلى الله عليه وسلم نحوه بمعناه،: (@)(@@) @MATN@ " هذا حديث صحيح، وأبو سهيل هو: عم مالك بن أنس، واسمه: نافع بن مالك بن أبي عامر الأصبحي الخولاني " (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٢ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا عبيد الله بن موسى، عن سفيان، عن الأعمش، عن عبد الله بن مرة، عن مسروق، عن عبد الله بن عمرو، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «أربع من كن فيه كان منافقا PageV05P019 وإن كانت خصلة منهن فيه كانت فيه خصلة من النفاق حتى يدعها، من إذا حدث كذب، وإذا وعد أخلف، وإذا خاصم فجر، وإذا عاهد غدر» (@)(@@) هذا حديث حسن صحيح (@)(@@) @MATN@ " حدثنا الحسن بن علي الخلال قال: حدثنا عبد الله بن نمير، عن الأعمش، عن عبد الله بن مرة، بهذا الإسناد نحوه،: (@)(@@) @MATN@ «هذا حديث حسن 
ms843	 صحيح، وإنما معنى هذا عند أهل العلم نفاق العمل، وإنما كان نفاق التكذيب على عهد رسول الله صلى الله عليه وسلم» (@)(@@) هكذا روي عن الحسن البصري، شيء من هذا أنه قال: " النفاق نفاقان: نفاق العمل، ونفاق التكذيب " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٣ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عامر قال: حدثنا إبراهيم بن طهمان، عن علي بن عبد الأعلى، عن أبي النعمان، عن أبي وقاص، عن زيد بن أرقم، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا وعد الرجل وينوي أن يفي به فلم يف به فلا جناح عليه» : (@)(@@) @MATN@ «هذا حديث غريب، وليس إسناده بالقوي، علي بن عبد الأعلى ثقة، ولا يعرف أبو النعمان ولا أبو وقاص وهما مجهولان» (@)(@@) (@)PageV05P020 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء سباب المؤمن فسوق (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٤ - (@)(@@) حدثنا محمد بن عبد الله بن بزيع قال: حدثنا عبد الحكيم بن منصور الواسطي، عن عبد الملك بن عمير، عن عبد الرحمن بن عبد الله بن مسعود، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «قتال المسلم أخاه كفر، وسبابه فسوق» (@)(@@) وفي الباب عن سعد، وعبد الله بن مغفل،: (@)(@@) @MATN@ «حديث ابن مسعود حديث حسن صحيح، وقد روي عن عبد الله بن مسعود من غير وجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٥ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع، عن سفيان، عن زبيد، عن أبي وائل، عن عبد الله بن مسعود، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «سباب المسلم فسوق، وقتاله كفر» : (@)(@@) هذا حديث حسن صحيح (@)PageV05P021 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن رمى أخاه بكفر (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٦ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا إسحاق بن يوسف الأزرق، عن هشام الدستوائي، عن يحيى بن أبي كثير، عن أبي قلابة، عن ثابت بن الضحاك، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ليس على العبد نذر فيما لا يملك، ولاعن المؤمن كقاتله، ومن قذف مؤمنا بكفر فهو كقاتله، ومن قتل نفسه بشيء عذبه الله بما قتل به نفسه يوم القيامة» (@)(@@) وفي الباب عن أبي ذر، وابن عمر: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٧ - (@)(@@) حدثنا قتيبة، 
ms844	 عن مالك، عن عبد الله بن دينار، عن ابن عمر، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «أيما رجل قال لأخيه كافر فقد باء بها أحدهما» (@)(@@) هذا حديث حسن صحيح، ومعنى قوله باء: يعني أقر " (@)PageV05P022 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن يموت وهو يشهد أن لا إله إلا الله (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٨ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن عجلان، عن محمد بن يحيى بن حبان، عن ابن محيريز، عن الصنابحي، عن عبادة بن الصامت، أنه قال: دخلت عليه وهو في الموت فبكيت، فقال: مهلا، لم تبكي؟ فوالله لئن استشهدت لأشهدن لك، ولئن شفعت لأشفعن لك، ولئن استطعت لأنفعنك، ثم قال: والله ما من حديث سمعته من رسول الله صلى الله عليه وسلم لكم فيه خير إلا حدثتكموه إلا حديثا واحدا، وسوف أحدثكموه اليوم وقد أحيط بنفسي، سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من شهد أن لا إله إلا الله وأن محمدا رسول الله، حرم الله عليه النار» (@)(@@) وفي الباب عن أبي بكر، وعمر، وعثمان، وعلي، وطلحة، وجابر، وابن عمر، وزيد بن خالد. سمعت ابن أبي عمر، يقول: سمعت ابن عيينة، يقول: (@)(@@) @MATN@ " محمد بن عجلان كان ثقة مأمونا في الحديث: (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب من هذا الوجه، والصنابحي هو عبد الرحمن بن عسيلة أبو عبد الله» (@)(@@) وقد روي عن الزهري، أنه سئل عن قول النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «من قال PageV05P023 لا إله إلا الله دخل الجنة» ، (@)(@@) فقال: (@)(@@) @MATN@ «إنما كان هذا في أول الإسلام قبل نزول الفرائض والأمر والنهي» : (@)(@@) @MATN@ «ووجه هذا الحديث عند بعض أهل العلم أن أهل التوحيد سيدخلون الجنة، وإن عذبوا بالنار بذنوبهم فإنهم لا يخلدون في النار» (@)(@@) وقد روي عن عبد الله بن مسعود، وأبي ذر، وعمران بن حصين، وجابر بن عبد الله، وابن عباس، وأبي سعيد الخدري، وأنس بن مالك، عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «سيخرج قوم من النار من أهل التوحيد ويدخلون الجنة» (@)(@@) هكذا روي عن سعيد بن جبير، وإبراهيم النخعي، وغير واحد 
ms845	 من التابعين في تفسير هذه الآية @QB@ {ربما يود الذين كفروا لو كانوا مسلمين} @QE@ [الحجر: ٢] قالوا: إذا أخرج أهل التوحيد من النار وأدخلوا الجنة ود الذين كفروا لو كانوا مسلمين " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٣٩ - (@)(@@) حدثنا سويد بن نصر قال: أخبرنا عبد الله، عن ليث بن سعد قال: حدثني عامر بن يحيى، عن أبي عبد الرحمن المعافري ثم الحبلي، قال: سمعت عبد الله بن عمرو بن العاص، يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " إن الله سيخلص رجلا من أمتي على رءوس الخلائق يوم القيامة فينشر عليه تسعة وتسعين سجلا كل سجل مثل مد البصر، ثم يقول: أتنكر من هذا شيئا؟ أظلمك كتبتي الحافظون؟ فيقول: PageV05P024 لا يا رب، فيقول: أفلك عذر؟ فيقول: لا يا رب، فيقول: بلى إن لك عندنا حسنة، فإنه لا ظلم عليك اليوم، فتخرج بطاقة فيها: أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله، فيقول: احضر وزنك، فيقول: يا رب ما هذه البطاقة مع هذه السجلات، فقال: إنك لا تظلم " ، قال: (@)(@@) @MATN@ «فتوضع السجلات في كفة والبطاقة في كفة، فطاشت السجلات وثقلت البطاقة، فلا يثقل مع اسم الله شيء» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) حدثنا قتيبة قال: حدثنا ابن لهيعة، عن عامر بن يحيى، بهذا الإسناد نحوه. والبطاقة: القطعة (@) (@)(@) (@)(@@) ما جاء في افتراق هذه الأمة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٠ - (@)(@@) حدثنا الحسين بن حريث أبو عمار قال: حدثنا الفضل بن موسى، عن محمد بن عمرو، عن أبي سلمة، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «تفرقت اليهود على إحدى وسبعين أو اثنتين وسبعين فرقة، والنصارى مثل ذلك، وتفترق أمتي على ثلاث وسبعين فرقة» (@)(@@) وفي الباب عن سعد، وعبد الله بن عمرو، وعوف بن مالك: (@)(@@) @MATN@ «حديث أبي هريرة حديث حسن صحيح» (@)(@@) (@)PageV05P025 (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤١ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود الحفري، عن سفيان الثوري، عن عبد الرحمن بن زياد الأفريقي، عن عبد الله بن يزيد، عن عبد الله بن عمرو، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ليأتين على أمتي 
ms846	 ما أتى على بني إسرائيل حذو النعل بالنعل، حتى إن كان منهم من أتى أمه علانية لكان في أمتي من يصنع ذلك، وإن بني إسرائيل تفرقت على ثنتين وسبعين ملة، وتفترق أمتي على ثلاث وسبعين ملة، كلهم في النار إلا ملة واحدة» ، (@)(@@) قالوا: ومن هي يا رسول الله؟ قال: (@)(@@) @MATN@ «ما أنا عليه وأصحابي» : (@)(@@) @MATN@ «هذا حديث مفسر غريب لا نعرفه مثل هذا إلا من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٢ - (@)(@@) حدثنا الحسن بن عرفة قال: حدثنا إسماعيل بن عياش، عن يحيى بن أبي عمرو السيباني، عن عبد الله بن الديلمي، قال: سمعت عبد الله بن عمرو، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ " إن الله عز وجل خلق خلقه في ظلمة، فألقى عليهم من نوره، فمن أصابه من ذلك النور اهتدى، ومن أخطأه ضل، فلذلك أقول: جف القلم على علم الله " : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٣ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو أحمد قال: حدثنا سفيان، عن أبي إسحاق، عن عمرو بن ميمون، عن معاذ بن جبل، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أتدري ما حق الله على العباد» ؟ (@)(@@) قلت: PageV05P026 الله ورسوله أعلم قال: (@)(@@) @MATN@ «فإن حقه عليهم أن يعبدوه ولا يشركوا به شيئا» ، (@)(@@) قال: (@)(@@) @MATN@ «أتدري ما حقهم عليه إذا فعلوا ذلك» (@)(@@) قلت: الله ورسوله أعلم، قال: (@)(@@) @MATN@ «أن لا يعذبهم» (@)(@@) هذا حديث حسن صحيح وقد روي من غير وجه عن معاذ بن جبل " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٤ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: أخبرنا شعبة، عن حبيب بن أبي ثابت، وعبد العزيز بن رفيع، والأعمش، كلهم سمعوا زيد بن وهب، عن أبي ذر، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «أتاني جبريل فبشرني أنه من مات لا يشرك بالله شيئا دخل الجنة» ، (@)(@@) قلت: وإن زنى وإن سرق؟ قال: (@)(@@) @MATN@ «نعم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وفي الباب عن أبي الدرداء (@)PageV05P027 (@)(@) (@)(@@)(@@)(@@) | ٣٩ - أبواب العلم عن رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) || باب إذا أراد الله بعبد خيرا فقهه في الدين (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٥ - (@)(@@) حدثنا علي 
ms847	 بن حجر قال: حدثنا إسماعيل بن جعفر قال: حدثني عبد الله بن سعيد بن أبي هند، عن أبيه، عن ابن عباس، أن رسول الله صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «من يرد الله به خيرا يفقهه في الدين» (@)(@@) وفي الباب عن عمر، وأبي هريرة، ومعاوية (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب فضل طلب العلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٦ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو أسامة، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من سلك طريقا يلتمس فيه علما سهل الله له طريقا إلى الجنة» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)PageV05P028 (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٧ - (@)(@@) حدثنا نصر بن علي، قال: حدثنا خالد بن يزيد العتكي، عن أبي جعفر الرازي، عن الربيع بن أنس، عن أنس بن مالك، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من خرج في طلب العلم فهو في سبيل الله حتى يرجع» : (@)(@@) @MATN@ «هذا حديث حسن غريب ورواه بعضهم فلم يرفعه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٨ - (@)(@@) حدثنا محمد بن حميد الرازي قال: حدثنا محمد بن المعلى قال: حدثنا زياد بن خيثمة، عن أبي داود، عن عبد الله بن سخبرة، عن سخبرة، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «من طلب العلم كان كفارة لما مضى» : " (@)(@@) هذا حديث ضعيف الإسناد، أبو داود اسمه نفيع الأعمى يضعف في الحديث، ولا نعرف لعبد الله بن سخبرة كبير شيء ولا لأبيه (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كتمان العلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٤٩ - (@)(@@) حدثنا أحمد بن بديل بن قريش اليامي الكوفي قال: حدثنا عبد الله بن نمير، عن عمارة بن زاذان، عن علي بن الحكم، عن عطاء، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من سئل عن علم علمه ثم كتمه ألجم يوم القيامة بلجام من نار» (@)(@@) PageV05P029 وفي الباب عن جابر، وعبد الله بن عمرو: (@)(@@) @MATN@ «حديث أبي هريرة حديث حسن» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاستيصاء بمن يطلب العلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٠ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا أبو داود الحفري، عن سفيان، عن أبي هارون العبدي، قال: كنا نأتي أبا 
ms848	 سعيد، فيقول: مرحبا بوصية رسول الله صلى الله عليه وسلم، إن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إن الناس لكم تبع، وإن رجالا يأتونكم من أقطار الأرضين يتفقهون في الدين، فإذا أتوكم فاستوصوا بهم خيرا» : (@)(@@) قال علي: قال يحيى بن سعيد: (@)(@@) @MATN@ «كان شعبة يضعف أبا هارون العبدي» (@)(@@) قال يحيى بن سعيد: (@)(@@) @MATN@ «ما زال ابن عون يروي عن أبي هارون العبدي حتى مات» (@)(@@) وأبو هارون اسمه: عمارة بن جوين " (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥١ - (@)(@@) حدثنا قتيبة قال: حدثنا نوح بن قيس، عن أبي هارون العبدي، عن أبي سعيد الخدري، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «يأتيكم رجال من قبل المشرق يتعلمون، فإذا جاءوكم فاستوصوا بهم خيرا» (@)(@@) قال: فكان أبو سعيد، إذا رآنا قال: (@)(@@) @MATN@ «مرحبا بوصية رسول الله صلى الله عليه وسلم» (@)(@@) هذا حديث لا نعرفه إلا من حديث أبي هارون عن أبي سعيد " (@)PageV05P030 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ذهاب العلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٢ - (@)(@@) حدثنا هارون بن إسحاق الهمداني قال: حدثنا عبدة بن سليمان، عن هشام بن عروة، عن أبيه، عن عبد الله بن عمرو بن العاص، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الله لا يقبض العلم انتزاعا ينتزعه من الناس ولكن يقبض العلم بقبض العلماء، حتى إذا لم يترك عالما اتخذ الناس رءوسا جهالا فسئلوا فأفتوا بغير علم فضلوا وأضلوا» (@)(@@) وفي الباب عن عائشة، وزياد بن لبيد: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روى هذا الحديث الزهري، عن عروة، عن عبد الله بن عمرو، وعن عروة، عن عائشة، عن النبي صلى الله عليه وسلم مثل هذا (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٣ - (@)(@@) حدثنا عبد الله بن عبد الرحمن قال: أخبرنا عبد الله بن صالح قال: حدثني معاوية بن صالح، عن عبد الرحمن بن جبير بن نفير، عن أبيه جبير بن نفير، عن أبي الدرداء، قال: كنا مع رسول الله صلى الله عليه وسلم فشخص ببصره إلى السماء ثم قال: (@)(@@) @MATN@ «هذا أوان يختلس العلم من الناس حتى لا يقدروا منه على شيء» (@)(@@) فقال زياد بن لبيد الأنصاري: كيف يختلس منا 
ms849	 وقد قرأنا القرآن فوالله لنقرأنه ولنقرئنه نساءنا PageV05P031 وأبناءنا، فقال: (@)(@@) @MATN@ «ثكلتك أمك يا زياد، إن كنت لأعدك من فقهاء أهل المدينة هذه التوراة والإنجيل عند اليهود والنصارى فماذا تغني عنهم؟» (@)(@@) قال جبير: فلقيت عبادة بن الصامت، قلت: ألا تسمع إلى ما يقول أخوك أبو الدرداء؟ فأخبرته بالذي قال أبو الدرداء قال: (@)(@@) @MATN@ «صدق أبو الدرداء، إن شئت لأحدثنك بأول علم يرفع من الناس؟ الخشوع، يوشك أن تدخل مسجد جماعة فلا ترى فيه رجلا خاشعا» : (@)(@@) @MATN@ «هذا حديث حسن غريب، ومعاوية بن صالح ثقة عند أهل الحديث، ولا نعلم أحدا تكلم فيه غير يحيى بن سعيد القطان، وقد روي عن معاوية بن صالح، نحو هذا» (@)(@@) وروى بعضهم هذا الحديث عن عبد الرحمن بن جبير بن نفير، عن أبيه، عن عوف بن مالك، عن النبي صلى الله عليه وسلم (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن يطلب بعلمه الدنيا (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٤ - (@)(@@) حدثنا أبو الأشعث أحمد بن المقدام العجلي البصري قال: حدثنا أمية بن خالد قال: حدثنا إسحاق بن يحيى بن طلحة قال: حدثني ابن كعب بن مالك، عن أبيه، قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من طلب العلم ليجاري به العلماء أو ليماري به السفهاء أو يصرف به وجوه الناس إليه أدخله الله النار» : (@)(@@) PageV05P032 (@)(@@) @MATN@ «هذا حديث غريب، لا نعرفه إلا من هذا الوجه، وإسحاق بن يحيى بن طلحة ليس بذاك القوي عندهم، تكلم فيه من قبل حفظه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٥ - (@)(@@) حدثنا علي بن نصر بن علي قال: حدثنا محمد بن عباد الهنائي قال: حدثنا علي بن المبارك، عن أيوب السختياني، عن خالد بن دريك، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من تعلم علما لغير الله أو أراد به غير الله فليتبوأ مقعده من النار» (@)(@@) وفي الباب عن جابر: (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه من حديث أيوب إلا من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الحث على تبليغ السماع (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٦ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: أخبرنا شعبة قال: أخبرنا عمر 
ms850	 بن سليمان، من ولد عمر بن الخطاب قال: سمعت عبد الرحمن بن أبان بن عثمان، يحدث عن أبيه، قال: خرج زيد بن ثابت، من عند مروان نصف النهار، قلنا: ما بعث إليه هذه الساعة إلا لشيء يسأله عنه، فقمنا فسألناه، فقال: نعم، سألنا عن أشياء سمعناها من رسول الله صلى الله عليه وسلم، سمعت رسول الله صلى الله عليه وسلم يقول: PageV05P033 (@)(@@) @MATN@ «نضر الله امرأ سمع منا حديثا فحفظه حتى يبلغه غيره، فرب حامل فقه إلى من هو أفقه منه، ورب حامل فقه ليس بفقيه» (@)(@@) وفي الباب عن عبد الله بن مسعود، ومعاذ بن جبل، وجبير بن مطعم، وأبي الدرداء، وأنس: (@)(@@) @MATN@ «حديث زيد بن ثابت حديث حسن» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٧ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: حدثنا شعبة، عن سماك بن حرب، قال: سمعت عبد الرحمن بن عبد الله بن مسعود، يحدث عن أبيه، قال: سمعت النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «نضر الله امرأ سمع منا شيئا فبلغه كما سمع، فرب مبلغ أوعى من سامع» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد رواه عبد الملك بن عمير، عن عبد الرحمن بن عبد الله (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٨ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عبد الملك بن عمير، عن عبد الرحمن بن عبد الله بن مسعود، يحدث عن أبيه، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «نضر الله امرأ سمع مقالتي فوعاها وحفظها وبلغها، فرب حامل فقه إلى من هو أفقه منه» (@)(@@) (@)(@) (@)(@@) @MATN@ " ثلاث لا يغل PageV05P034 عليهن قلب مسلم: إخلاص العمل لله، ومناصحة أئمة المسلمين، ولزوم جماعتهم، فإن الدعوة تحيط من ورائهم " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تعظيم الكذب على رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٥٩ - (@)(@@) حدثنا أبو هشام الرفاعي قال: حدثنا أبو بكر بن عياش قال: حدثنا عاصم، عن زر، عن عبد الله بن مسعود، قال: قال رسول الله صلى الله عليه وسلم: " من كذب علي متعمدا فليتبوأ مقعده من النار (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٠ - (@)(@@) حدثنا إسماعيل بن موسى الفزاري، ابن بنت السدي قال: حدثنا شريك 
ms851	 بن عبد الله، عن منصور بن المعتمر، عن ربعي بن حراش، عن علي بن أبي طالب، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لا تكذبوا علي فإنه من كذب علي يلج في النار» (@)(@@) وفي الباب عن أبي بكر، وعمر، وعثمان، والزبير، وسعيد بن زيد وعبد الله بن عمرو، وأنس وجابر، وابن عباس، وأبي سعيد، وعمرو بن عبسة، وعقبة بن عامر، ومعاوية، وبريدة، وأبي موسى، وأبي أمامة، وعبد الله بن عمر، والمنقع، وأوس الثقفي. حديث علي حديث حسن صحيح، قال عبد الرحمن بن مهدي: (@)(@@) @MATN@ «منصور بن المعتمر أثبت أهل الكوفة» (@)(@@) وقال وكيع: (@)(@@) @MATN@ «لم يكذب ربعي بن حراش في الإسلام كذبة» (@)(@@) (@)PageV05P035 (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦١ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث بن سعد، عن ابن شهاب، عن أنس بن مالك، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من كذب علي - حسبت أنه قال - متعمدا فليتبوأ بيته من النار» : (@)(@@) هذا حديث حسن صحيح غريب من هذا الوجه من حديث الزهري، عن أنس، وقد روي هذا الحديث من غير وجه عن أنس (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن روى حديثا وهو يرى أنه كذب (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن حبيب بن أبي ثابت، عن ميمون بن أبي شبيب، عن المغيرة بن شعبة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من حدث عني حديثا وهو يرى أنه كذب فهو أحد الكاذبين» (@)(@@) وفي الباب عن علي بن أبي طالب، وسمرة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وروى شعبة، عن الحكم، عن عبد الرحمن بن أبي ليلى، عن سمرة، عن النبي صلى الله عليه وسلم هذا الحديث، وروى الأعمش، وابن أبي ليلى، عن الحكم، عن عبد الرحمن بن أبي ليلى، عن علي، عن النبي صلى الله عليه وسلم (@)(@@) @MATN@ «وكأن حديث عبد الرحمن PageV05P036 بن أبي ليلى عن سمرة عند أهل الحديث أصح» (@)(@@) سألت أبا محمد عبد الله بن عبد الرحمن، عن حديث النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «من حدث عني حديثا وهو يرى أنه 
ms852	 كذب فهو أحد الكاذبين» (@)(@@) قلت له: من روى حديثا وهو يعلم أن إسناده خطأ أيخاف أن يكون قد دخل في حديث النبي صلى الله عليه وسلم؟ أو إذا روى الناس حديثا مرسلا فأسنده بعضهم أو قلب إسناده يكون قد دخل في هذا الحديث؟ فقال: (@)(@@) @MATN@ «لا، إنما معنى هذا الحديث إذا روى الرجل حديثا ولا يعرف لذلك الحديث عن النبي صلى الله عليه وسلم أصل فحدث به فأخاف أن يكون قد دخل في هذا الحديث» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما نهي عنه أن يقال عند حديث النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٣ - (@)(@@) حدثنا قتيبة قال: حدثنا سفيان بن عيينة، عن محمد بن المنكدر، وسالم أبي النضر، عن عبيد الله بن أبي رافع، عن أبي رافع، وغيره رفعه قال: (@)(@@) @MATN@ " لا ألفين أحدكم متكئا على أريكته يأتيه أمر مما أمرت به أو نهيت عنه، فيقول: لا أدري، ما وجدنا في كتاب الله اتبعناه " : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وروى بعضهم هذا الحديث عن سفيان، عن ابن المنكدر، عن النبي صلى الله عليه وسلم مرسلا. وعن سالم أبي النضر، عن عبيد الله بن أبي رافع، عن أبيه، عن PageV05P037 النبي صلى الله عليه وسلم. (@)(@@) @MATN@ " وكان ابن عيينة إذا روى هذا الحديث على الانفراد بين حديث محمد بن المنكدر من حديث سالم أبي النضر، وإذا جمعهما روى هكذا، وأبو رافع مولى النبي صلى الله عليه وسلم اسمه: أسلم " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٤ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا معاوية بن صالح، عن الحسن بن جابر اللخمي، عن المقدام بن معدي كرب، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " ألا هل عسى رجل يبلغه الحديث عني وهو متكئ على أريكته، فيقول: بيننا وبينكم كتاب الله، فما وجدنا فيه حلالا استحللناه. وما وجدنا فيه حراما حرمناه، وإن ما حرم رسول الله كما حرم الله " : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية كتابة العلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٥ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا سفيان بن عيينة، عن 
ms853	 زيد بن أسلم، عن عطاء بن يسار، عن أبي سعيد الخدري، قال: (@)(@@) @MATN@ «استأذنا النبي صلى الله عليه وسلم في الكتابة فلم يأذن لنا» : (@)(@@) @MATN@ «وقد روي هذا الحديث من غير هذا الوجه أيضا عن زيد بن أسلم» (@)(@@) رواه همام، عن زيد بن أسلم (@)PageV05P038 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرخصة فيه (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٦ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن الخليل بن مرة، عن يحيى بن أبي صالح، عن أبي هريرة، قال: كان رجل من الأنصار يجلس إلى النبي صلى الله عليه وسلم، فيسمع من النبي صلى الله عليه وسلم الحديث فيعجبه ولا يحفظه، فشكا ذلك إلى النبي صلى الله عليه وسلم فقال: يا رسول الله إني أسمع منك الحديث فيعجبني ولا أحفظه، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «استعن بيمينك» ، (@)(@@) وأومأ بيده للخط وفي الباب عن عبد الله بن عمرو: (@)(@@) @MATN@ «هذا حديث إسناده ليس بذلك القائم» (@)(@@) وسمعت محمد بن إسماعيل، يقول: (@)(@@) @MATN@ «الخليل بن مرة منكر الحديث» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٧ - (@)(@@) حدثنا يحيى بن موسى، ومحمود بن غيلان، قالا: حدثنا الوليد بن مسلم، عن الأوزاعي، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة، أن النبي صلى الله عليه وسلم خطب فذكر القصة في الحديث قال أبو شاه: اكتبوا لي يا رسول الله. فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اكتبوا لأبي شاه» (@)(@@) وفي الحديث قصة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روى شيبان، عن يحيى بن أبي كثير، مثل هذا (@)PageV05P039 (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٨ - (@)(@@) حدثنا قتيبة قال: حدثنا سفيان بن عيينة، عن عمرو بن دينار، عن وهب بن منبه، عن أخيه وهو همام بن منبه، قال: سمعت أبا هريرة، يقول: (@)(@@) @MATN@ «ليس أحد من أصحاب رسول الله صلى الله عليه وسلم أكثر حديثا عن رسول الله صلى الله عليه وسلم مني إلا عبد الله بن عمرو فإنه كان يكتب وكنت لا أكتب» . (@)(@@) هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الحديث عن بني إسرائيل (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٦٩ - (@)(@@) حدثنا محمد بن يحيى قال: حدثنا محمد بن يوسف، عن ابن ثوبان هو عبد 
ms854	 الرحمن بن ثابت بن ثوبان، عن حسان بن عطية، عن أبي كبشة السلولي، عن عبد الله بن عمرو، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «بلغوا عني ولو آية وحدثوا عن بني إسرائيل ولا حرج ومن كذب علي متعمدا فليتبوأ مقعده من النار» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عاصم، عن الأوزاعي، عن حسان بن عطية، عن أبي كبشة السلولي، عن عبد الله بن عمرو، عن النبي صلى الله عليه وسلم نحوه (@)(@@) @MATN@ «وهذا حديث حسن صحيح» (@)(@@) (@)PageV05P040 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء الدال على الخير كفاعله (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٠ - (@)(@@) حدثنا نصر بن عبد الرحمن الكوفي قال: حدثنا أحمد بن بشير، عن شبيب بن بشر، عن أنس بن مالك، قال: أتى النبي صلى الله عليه وسلم رجل يستحمله، فلم يجد عنده ما يحمله فدله على آخر فحمله، فأتى النبي صلى الله عليه وسلم فأخبره فقال: (@)(@@) @MATN@ «إن الدال على الخير كفاعله» (@)(@@) وفي الباب عن أبي مسعود البدري، وبريدة: (@)(@@) @MATN@ «هذا حديث غريب من هذا الوجه من حديث أنس عن النبي صلى الله عليه وسلم» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧١ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: حدثنا شعبة، عن الأعمش، قال: سمعت أبا عمرو الشيباني، يحدث عن أبي مسعود البدري: أن رجلا أتى النبي صلى الله عليه وسلم يستحمله فقال: إنه قد أبدع بي، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ائت فلانا» ، (@)(@@) فأتاه فحمله، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " من دل على خير فله مثل أجر فاعله، أو قال: (@)(@@) @MATN@ «عامله» : " (@)(@@) هذا حديث حسن صحيح، وأبو عمرو الشيباني اسمه: سعد بن إياس، وأبو مسعود البدري اسمه: عقبة بن عمرو " PageV05P041 حدثنا الحسن بن علي الخلال قال: حدثنا عبد الله بن نمير، عن الأعمش، عن أبي عمرو الشيباني، عن أبي مسعود، عن النبي صلى الله عليه وسلم نحوه، وقال: (@)(@@) @MATN@ «مثل أجر فاعله» (@)(@@) ولم يشك فيه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٢ - (@)(@@) حدثنا محمود بن غيلان، والحسن بن علي، وغير واحد قالوا: حدثنا أبو أسامة، عن بريد بن عبد الله 
ms855	 بن أبي بردة، عن جده أبي بردة، عن أبي موسى الأشعري، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «اشفعوا ولتؤجروا، وليقض الله على لسان نبيه ما شاء» : (@)(@@) @MATN@ «هذا حديث حسن صحيح، وبريد يكنى أبا بردة أيضا، وهو كوفي ثقة في الحديث» (@)(@@) روى عنه شعبة، والثوري، وابن عيينة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٣ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وكيع، وعبد الرزاق، عن سفيان، عن الأعمش، عن عبد الله بن مرة، عن مسروق، عن عبد الله بن مسعود، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «ما من نفس تقتل ظلما إلا كان على ابن آدم كفل من دمها، وذلك لأنه أول من أسن القتل» (@)(@@) وقال عبد الرزاق: (@)(@@) @MATN@ «سن القتل» . (@)(@@) هذا حديث حسن صحيح (@)PageV05P042 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن دعا إلى هدى فاتبع أو إلى ضلالة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٤ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا إسماعيل بن جعفر، عن العلاء بن عبد الرحمن، عن أبيه، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من دعا إلى هدى كان له من الأجر مثل أجور من يتبعه لا ينقص ذلك من أجورهم شيئا، ومن دعا إلى ضلالة كان عليه من الإثم مثل آثام من يتبعه، لا ينقص ذلك من آثامهم شيئا» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٥ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا يزيد بن هارون قال: أخبرنا المسعودي، عن عبد الملك بن عمير، عن ابن جرير بن عبد الله، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من سن سنة خير فاتبع عليها فله أجره ومثل أجور من اتبعه غير منقوص من أجورهم شيئا، ومن سن سنة شر فاتبع عليها كان عليه وزره ومثل أوزار من اتبعه غير منقوص من أوزارهم شيئا» (@)(@@) وفي الباب عن حذيفة: (@)(@@) @MATN@ «هذا حديث حسن صحيح، PageV05P043 وقد روي من غير وجه عن جرير بن عبد الله، عن النبي صلى الله عليه وسلم نحو هذا» (@)(@@) وقد روي هذا الحديث عن المنذر بن جرير بن عبد الله، عن أبيه، عن النبي صلى الله 
ms856	 عليه وسلم، وقد روي عن عبيد الله بن جرير، عن أبيه، عن النبي صلى الله عليه وسلم، أيضا (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الأخذ بالسنة واجتناب البدع (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٦ - (@)(@@) حدثنا علي بن حجر قال: حدثنا بقية بن الوليد، عن بحير بن سعد، عن خالد بن معدان، عن عبد الرحمن بن عمرو السلمي، عن العرباض بن سارية، قال: وعظنا رسول الله صلى الله عليه وسلم يوما بعد صلاة الغداة موعظة بليغة ذرفت منها العيون ووجلت منها القلوب، فقال رجل: إن هذه موعظة مودع فماذا تعهد إلينا يا رسول الله؟ قال: (@)(@@) @MATN@ «أوصيكم بتقوى الله والسمع والطاعة، وإن عبد حبشي، فإنه من يعش منكم يرى اختلافا كثيرا، وإياكم ومحدثات الأمور فإنها ضلالة فمن أدرك ذلك منكم فعليه بسنتي وسنة الخلفاء الراشدين المهديين، عضوا عليها بالنواجذ» : (@)(@@) PageV05P044 (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روى ثور بن يزيد، عن خالد بن معدان، عن عبد الرحمن بن عمرو السلمي، عن العرباض بن سارية، عن النبي صلى الله عليه وسلم نحو هذا، حدثنا بذلك الحسن بن علي الخلال، وغير واحد قالوا: حدثنا أبو عاصم، عن ثور بن يزيد، عن خالد بن معدان، عن عبد الرحمن بن عمرو السلمي، عن العرباض بن سارية، عن النبي صلى الله عليه وسلم نحوه (@)(@@) @MATN@ «والعرباض بن سارية يكنى أبا نجيح» (@)(@@) وقد روي هذا الحديث عن حجر بن حجر، عن عرباض بن سارية، عن النبي صلى الله عليه وسلم نحوه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٧ - (@)(@@) حدثنا عبد الله بن عبد الرحمن قال: أخبرنا محمد بن عيينة، عن مروان بن معاوية الفزاري، عن كثير بن عبد الله، عن أبيه، عن جده، أن النبي صلى الله عليه وسلم قال لبلال بن الحارث: (@)(@@) @MATN@ «اعلم عمرو بن عوف» (@)(@@) قال: ما أعلم يا رسول الله؟ قال: (@)(@@) @MATN@ «إنه من أحيا سنة من سنتي قد أميتت بعدي، فإن له من الأجر مثل من عمل بها من غير أن ينقص من أجورهم شيئا، ومن ابتدع بدعة ضلالة لا ترضي الله ورسوله كان عليه مثل آثام من عمل بها لا 
ms857	 ينقص ذلك من أوزار الناس شيئا» : (@)(@@) هذا حديث حسن، ومحمد بن عيينة هو: مصيصي شامي، وكثير بن عبد الله هو: ابن عمرو بن عوف المزني (@)PageV05P045 (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٨ - (@)(@@) حدثنا مسلم بن حاتم الأنصاري البصري قال: حدثنا محمد بن عبد الله الأنصاري، عن أبيه، عن علي بن زيد، عن سعيد بن المسيب، قال: قال أنس بن مالك، قال لي رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «يا بني، إن قدرت أن تصبح وتمسي ليس في قلبك غش لأحد فافعل» (@)(@@) ثم قال لي: (@)(@@) @MATN@ «يا بني وذلك من سنتي، ومن أحيا سنتي فقد أحبني، ومن أحبني كان معي في الجنة» (@)(@@) وفي الحديث قصة طويلة ": (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه، ومحمد بن عبد الله الأنصاري ثقة، وأبوه ثقة، وعلي بن زيد صدوق إلا أنه ربما يرفع الشيء الذي يوقفه غيره» ، (@)(@@) وسمعت محمد بن بشار، يقول: قال أبو الوليد: قال شعبة: حدثنا علي بن زيد (@)(@@) @MATN@ «وكان رفاعا ولا نعرف لسعيد بن المسيب عن أنس رواية إلا هذا الحديث بطوله» (@)(@@) وقد روى عباد بن ميسرة المنقري، هذا الحديث عن علي بن زيد، عن أنس، (@)(@@) @MATN@ «ولم يذكر فيه عن سعيد بن المسيب» : (@)(@@) @MATN@ «وذاكرت به محمد بن إسماعيل فلم يعرفه، ولم يعرف لسعيد بن المسيب، عن أنس هذا الحديث ولا غيره، ومات أنس بن مالك سنة ثلاث وتسعين، ومات سعيد بن المسيب بعده بسنتين، مات سنة خمس وتسعين» (@)(@@) (@)PageV05P046 (@)(@) (@)(@@)(@@)(@@) || باب في الانتهاء عما نهى عنه رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٧٩ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اتركوني ما تركتكم، فإذا حدثتكم، فخذوا عني، فإنما هلك من كان قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في عالم المدينة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٠ - (@)(@@) حدثنا الحسن بن الصباح البزار، وإسحاق بن موسى الأنصاري، قالا: حدثنا سفيان بن عيينة، عن ابن جريج، عن أبي الزبير، عن أبي صالح، عن أبي هريرة، رواية: (@)(@@) @MATN@ «يوشك 
ms858	 أن يضرب الناس أكباد الإبل يطلبون العلم فلا يجدون أحدا أعلم من عالم المدينة» : (@)(@@) @MATN@ «هذا حديث حسن وهو حديث ابن عيينة» ، (@)(@@) وقد روي عن ابن عيينة، أنه قال في هذا: سئل من عالم المدينة؟ فقال: (@)(@@) @MATN@ «إنه مالك بن أنس» (@)(@@) وقال إسحاق بن موسى: سمعت ابن عيينة، PageV05P047 يقول: (@)(@@) @MATN@ «هو العمري الزاهد» (@)(@@) وسمعت يحيى بن موسى، يقول: قال عبد الرزاق: (@)(@@) @MATN@ «هو مالك بن أنس» (@)(@@) والعمري هو عبد العزيز بن عبد الله من ولد عمر بن الخطاب " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل الفقه على العبادة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨١ - (@)(@@) حدثنا محمد بن إسماعيل قال: حدثنا إبراهيم بن موسى قال: أخبرنا الوليد بن مسلم قال: حدثنا روح بن جناح، عن مجاهد، عن ابن عباس، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «فقيه أشد على الشيطان من ألف عابد» : (@)(@@) @MATN@ «هذا حديث غريب ولا نعرفه إلا من هذا الوجه من حديث الوليد بن مسلم» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٢ - (@)(@@) حدثنا محمود بن خداش البغدادي قال: حدثنا محمد بن يزيد الواسطي قال: حدثنا عاصم بن رجاء بن حيوة، عن قيس بن كثير، قال: قدم رجل من المدينة على أبي الدرداء، وهو بدمشق فقال: ما أقدمك يا أخي؟ فقال: حديث بلغني أنك تحدثه عن رسول الله صلى الله عليه وسلم، قال: أما جئت لحاجة؟ قال: لا، قال: أما قدمت لتجارة؟ قال: لا، قال: ما جئت إلا في طلب هذا الحديث؟ قال: فإني سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من سلك طريقا يبتغي فيه علما PageV05P048 سلك الله به طريقا إلى الجنة، وإن الملائكة لتضع أجنحتها رضاء لطالب العلم، وإن العالم ليستغفر له من في السموات ومن في الأرض حتى الحيتان في الماء، وفضل العالم على العابد، كفضل القمر على سائر الكواكب، إن العلماء ورثة الأنبياء، إن الأنبياء لم يورثوا دينارا ولا درهما إنما ورثوا العلم، فمن أخذ به أخذ بحظ وافر» : (@)(@@) ولا نعرف هذا الحديث إلا من حديث عاصم بن رجاء بن حيوة، وليس هو عندي بمتصل هكذا حدثنا محمود بن خداش بهذا 
ms859	 الإسناد وإنما يروى هذا الحديث عن عاصم بن رجاء بن حيوة، عن الوليد بن جميل، عن كثير بن قيس، عن أبي الدرداء، عن النبي صلى الله عليه وسلم (@)(@@) @MATN@ «وهذا أصح من حديث محمود بن خداش، ورأي محمد بن إسماعيل هذا أصح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٣ - (@)(@@) حدثنا هناد قال: حدثنا أبو الأحوص، عن سعيد بن مسروق، عن ابن أشوع، عن يزيد بن سلمة الجعفي، قال: قال يزيد بن سلمة: يا رسول الله، إني قد سمعت منك حديثا كثيرا أخاف أن ينسيني أوله آخره، فحدثني بكلمة تكون جماعا قال: (@)(@@) @MATN@ «اتق الله فيما تعلم» : (@)(@@) @MATN@ " هذا حديث ليس إسناده بمتصل، وهو عندي مرسل، ولم يدرك عندي ابن أشوع يزيد بن سلمة وابن أشوع اسمه: سعيد بن أشوع " (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٤ - (@)(@@) حدثنا أبو كريب قال: حدثنا خلف بن أيوب العامري، عن عوف، عن ابن سيرين، عن أبي هريرة، قال: قال رسول الله صلى الله PageV05P049 عليه وسلم: (@)(@@) @MATN@ «خصلتان لا تجتمعان في منافق، حسن سمت، ولا فقه في الدين» : (@)(@@) @MATN@ «هذا حديث غريب ولا نعرف هذا الحديث من حديث عوف، إلا من حديث هذا الشيخ خلف بن أيوب العامري، ولم أر أحدا يروي عنه غير محمد بن العلاء، ولا أدري كيف هو» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٥ - (@)(@@) حدثنا محمد بن عبد الأعلى الصنعاني قال: حدثنا سلمة بن رجاء قال: حدثنا الوليد بن جميل قال: حدثنا القاسم أبو عبد الرحمن، عن أبي أمامة الباهلي، قال: ذكر لرسول الله صلى الله عليه وسلم رجلان أحدهما عابد والآخر عالم، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «فضل العالم على العابد كفضلي على أدناكم» (@)(@@) (@)(@) (@)(@@) ثم قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن الله وملائكته وأهل السموات والأرضين حتى النملة في جحرها وحتى الحوت ليصلون على معلم الناس الخير» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) سمعت أبا عمار الحسين بن حريث الخزاعي، يقول: سمعت الفضيل بن عياض، يقول: (@)(@@) @MATN@ «عالم عامل معلم يدعى كبيرا في ملكوت السموات» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٦ - (@)(@@) حدثنا عمر بن حفص الشيباني البصري قال: حدثنا عبد الله بن وهب، عن عمرو بن 
ms860	 الحارث، عن دراج، عن أبي الهيثم، عن أبي سعيد الخدري، عن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لن يشبع PageV05P050 المؤمن من خير يسمعه حتى يكون منتهاه الجنة» (@)(@@) هذا حديث حسن غريب " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٧ - (@)(@@) حدثنا محمد بن عمر بن الوليد الكندي قال: حدثنا عبد الله بن نمير، عن إبراهيم بن الفضل، عن سعيد المقبري، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الكلمة الحكمة ضالة المؤمن، فحيث وجدها فهو أحق بها» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من هذا الوجه وإبراهيم بن الفضل المخزومي يضعف في الحديث من قبل حفظه» (@)(@@) (@)PageV05P051 (@)(@) (@)(@@)(@@)(@@) | ٤٠ - أبواب الاستئذان والآداب عن رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في إفشاء السلام (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٨ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «والذي نفسي بيده لا تدخلوا الجنة حتى تؤمنوا، ولا تؤمنوا حتى تحابوا، ألا أدلكم على أمر إذا أنتم فعلتموه تحاببتم؟ أفشوا السلام بينكم» (@)(@@) وفي الباب عن عبد الله بن سلام، وشريح بن هانئ، عن أبيه، وعبد الله بن عمرو، والبراء، وأنس، وابن عمر: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما ذكر في فضل السلام (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٨٩ - (@)(@@) حدثنا عبد الله بن عبد الرحمن، والحسين بن محمد الجريري البلخي، قالا: حدثنا محمد بن كثير، عن جعفر بن سليمان PageV05P052 الضبعي، عن عوف، عن أبي رجاء، عن عمران بن حصين، أن رجلا جاء إلى النبي صلى الله عليه وسلم فقال: السلام عليكم، قال: قال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «عشر» (@)(@@) ثم جاء آخر فقال: السلام عليكم ورحمة الله، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «عشرون» . (@)(@@) ثم جاء آخر فقال: السلام عليكم ورحمة الله وبركاته، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «ثلاثون» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) وفي الباب عن علي، وأبي سعيد، وسهل بن حنيف (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاستئذان ثلاثة (@)(@) (@)(@@)(@@)(@@) ||| ٢٦٩٠ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا عبد الأعلى بن عبد 