ms2281	(@)(@@)(@@)(@@) $ 8458 - [خت]: أبو موسى (5).(@)(@@) عن: جابر في "صلاة الخوف" (6).(@)(@@) وعنه: زياد بن نافع.(@)(@@) يقال: هو علي بن رباح، ويقال: هو أبو موسى الغافقي مالك بن(@)(@@) عبادة، له صحبة، روى عنه ثعلبة بن أبي الكنود ووداعة الجمدي.(@)(@@)(@@)(@@) $ 8459 - [د]: أبو موسى (7).(@)(@)PageV10P411(@)(@)(@@) عن: أبي مريرم عن أبي هريرة في "السلام" (1).(@)(@@) وعنه: معاوية بن صالح. وفي بعض طرقه معاوية عن أبي مريم (2)(@)(@@) نفسه.(@)(@@)(@@)(@@) $ 8460 - [عس]: أبو المؤمن (3) الواثلي الكوفي، وقيل: أبو المؤمر.(@)(@@) عن: علي.(@)(@@) وعنه: سويد بن عبيد العجلي.(@)(@@)(@@)(@@) $ 8461 - [د]: أبو ميسرة (4) العابد.(@)(@@) له حكاية في الجنائز رواها عنه محمد بن محمد بن النعمان (5).(@)(@@)(@@)(@@) $$$ [خ م د ت س]: أبو ميسرة (6) الهمداني عمرو بن شرحبيل.(@)(@@)(@@)(@@) $ 8462 - [س]: أبو ميمون (7).(@)(@@) عن: رافع بن خديج.(@)(@@) وعنه: محمد بن يحيى بن حيان.(@)(@@) لا يعرف، وقيل ذكره خطأ في الحديث.(@)(@@)(@@)(@@) $ 8463 - 4: أبو ميمونة (8) الفارسي المدني الأبار سليم، وقيل:(@)(@@) أسامة، وقيل غير ذلك.(@)(@)PageV10P412(@)(@)(@@) عن: أبي هريرة، ومعاوية، وسمرة.(@)(@@) وعنه: هلال بن أبي ميمونة، وقتادة، ويحيى بن أبي كثير،(@)(@@) وغيرهم.(@)(@@) وثقه العجلي والنسائي، والصحيح أنه ليس بوالد هلال.(@)(@)PageV10P413(@)(@)(@@)(@@)(@@) || حرف النون(@)(@@)(@@)(@@) $$$ [بخ ت س ق]: أبو نباتة (1) [المدني] (2) يونس بن يحيى.(@)(@@)(@@)(@@) $$$ [خ م س ق]: أبو النجاشي مولى رافع بن خديج عطاء بن صهيب (1).(@)(@@)(@@)(@@) $ 8464 - [بخ د س]: أبو النجيب (3) العامري المصري مولى عبد الله بن(@)(@@) بن [أبي] (4) سرح، ويقال: أبو النجيب، يقال: ظليم.(@)(@@) عن: ابن عمر، وأبي سعيد.(@)(@@) وعنه: بكر بن سوادة.(@)(@@) قال عمرو بن [سواد] (5): توفي بإفريقية سنة ثمان وثمانين، وكان(@)(@@) فقيها(@)(@@)(@@)(@@) $$$ أبو نجيح (6) السلمي عمرو بن عبسة، والآخر عرباض بن سارية.(@)(@@)(@@)(@@) $$$ [م د ت س]: أبو نجيح (6) المكي، والد عبد الله بن يسار.(@)(@@)(@@)(@@) $ 8465 - [بخ س]: أبو نخيلة (7) البجلي.(@)(@@) ذكره عبد الغني بالحاء المهملة وذكره غيره بالمعجمة.(@)(@@) عن: جرير بن عبد الله.(@)(@)PageV10P414(@)(@)(@@) وعنه: أبو وائل، وبعضهم يقول: أبو وائل عن أبي جميلة.(@)(@@) وقال بعضهم: لأبي نخيلة صحبة.(@)(@@) قال الأعمش: عن أبي وائل عن أبي نخيلة -رجل من أصحاب(@)(@@) النبي - صلى الله عليه وسلم-- "أنه رمي بسهم فقيل 
ms2282	 له انزعه فقال: اللهم(@)(@@) نقص من الوجع، ولا تنقص من الأجر" (1).(@)(@@)(@@)(@@) $ 8466 - [خت]: أبو نصر (2) الأسدي بصري.(@)(@@) عن: ابن عباس.(@)(@@) وعنه: خليفة بن حصين المنقري.(@)(@@) وثقه أبو زرعة، وقال البخاري: لا يعرف سماعه من ابن عباس.(@)(@@)(@@)(@@) $$$ [م س]: أبو نصر (2) التمار عبد الملك بن عبد العزيز.(@)(@@)(@@)(@@) $$$ [ق]: أبو نصر (3) الضبي (4) عبد الله بن عبد الرحمن.(@)(@@)(@@)(@@) $ 8467 - [س]: أبو نصر (5) الهلالي.(@)(@@) عن: رجاء بن حيوة.(@)(@@) وعنه: محمد بن عبد الله بن أبي يعقوب.(@)(@@) ورواه ابن أبي يعقوب أيضا، عن [رجاء بن حيوة] (6)، عن أبي PageV10P415(@)(@@) أمامة نفسه.(@)(@@)(@@)(@@) $ 8468 - أبو نصر (1) الهلالي.(@)(@@) أرسل عن: النبي -صلى الله عليه وسلم- في "المتحابين".(@)(@@) وعنه: قتادة.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [ت]: أبو نصر (2).(@)(@@) عن: أنس.(@)(@@) وعنه: عوف الأعرابي.(@)(@@) هو خيثمة بن أبي خيثمة.(@)(@@)(@@)(@@) $$$ [س]: أبو نصر (2).(@)(@@) عن: أبي برزة.(@)(@@) هو حميد بن هلال.(@)(@@)(@@)(@@) $ 8469 - [د ت]: أبو (نصيرة) (3) الواسطي مسلم بن عبيد.(@)(@@) عن: أبي عسيب، وأنس، وأبي رجاء العطاردي، ومولى لأبي(@)(@@) بكر، وغيرهم.(@)(@@) وعنه: حشرج بن نباتة، والضحاك بن حمرة، وعثمان بن(@)(@@) [واقد] (4)، وهشيم، ويزيد بن هارون، وجماعة.(@)(@)PageV10P416(@)(@)(@@) وثقه أحمد وغيره، وقال ابن معين: صالح.(@)(@@)(@@)(@@) $$$ [ع]: أبو النضر (1) هاشم بن القاسم.(@)(@@)(@@)(@@) $$$ [خ د س]: أبو النضر (2) الفراديسي إسحاق بن إبراهيم.(@)(@@)(@@)(@@) $$$ [ع]: أبو النضر (3) المدني سالم بن أبي أمية.(@)(@@)(@@)(@@) $$$ [ع]: أبو نضرة (3) العبدي المنذر بن مالك.(@)(@@)(@@)(@@) $$$ [ر 4]: أبو نعامة (3) الحنفي قيس بن عياية.(@)(@@)(@@)(@@) $ 8470 - [م د ت س]: أبو نعامة (4) السعدي البصري عبد ربه، وقيل:(@)(@@) عمرو.(@)(@@) عن: عبد الله بن الصامت، ومطرف بن عبد الله، وأبي عثمان(@)(@@) النهدي، وغيرهم.(@)(@@) وعنه: أيوب، وشعبة، وحماد بن سلمة، ومرحوم العطار(@)(@@) وجماعة.(@)(@@) وثقه ابن معين. وقال أبو حاتم: لا بأس به.(@)(@@)(@@)(@@) $$$ [م قد تم ق]: أبو نعامة (5) العدوي عمرو بن عيسى.(@)(@@)(@@)(@@) $$$ [ع]: أبو النعمان (6) السدوسي محمد بن الفضل.(@)(@@)(@@)(@@) $ 8471 - [د ت]: أبو النعمان (7).(@)(@)PageV10P417(@)(@)(@@) عن: أبي وقاص.(@)(@@) [عنه] (1): علي بن عبد الأعلى.(@)(@@) قال الترمذي: مجهول. ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [ع]: أبو نعيم (2) الملائي الفضل بن دكين.(@)(@@)(@@)(@@) $$$ [د ق]: أبو نعيم (2) النخعي الصغير.(@)(@@) عن: شريك. 
ms2283	(@)(@@) عبد الرحمن بن هانئ.(@)(@@)(@@)(@@) $ 8472 - أبو نعيم (3) النخعي الكبير عبد الرحمن بن نعيم.(@)(@@) يروي عنه اللذان قبله، ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [عخ]: أبو نعيم (4) الطحان ضرار بن صرد.(@)(@@)(@@)(@@) $$$ [د]: أبو نعيم (4) الحلبي عبيد بن هشام.(@)(@@)(@@)(@@) $ 8473 - [د]: أبو نملة (5) الأنصاري الصحابي والد نملة.(@)(@@) قال الواقدي: اسمه عمار بن معاذ. وقيل: عمرو بن معاذ،(@)(@@) وقيل: عمارة بن معاذ الظفري، شهد أحدا وما بعدها، ويقال: شهد(@)(@@) بدرا مع أبيه.(@)(@@) روى الزهري عن ابن أبي نملة، عن أبيه "إذا حدثكم أهل(@)(@@) الكتاب فلا تصدقوهم ولا تكذبوهم" (6). وقيل: إنه أدرك الحرة، PageV10P418(@)(@@) وقتل ولداه عبد الله ومحمد يومئذ، وبقي إلى خلافة عبد الملك.(@)(@@)(@@)(@@) $$$ [خ م س]: أبو نهار (1) عقبة بن عبد الغافر الأزدي، واسمه أشهر.(@)(@@)(@@)(@@) $ 8474 - [بخ د]: أبو نهيك (2) الأزدي الفراهيدي البصري صاحب(@)(@@) القراءات: عثمان بن نهيك.(@)(@@) عن: أبي زيد الأنصاري، وابن عباس.(@)(@@) وعنه: زياد بن سعد، وقتادة، وحسين بن واقد، وجماعة.(@)(@@)(@@)(@@) $ 8475 - أبو نهيك (3) الأسدي الضبي قاسم بن محمد.(@)(@@) عن: القاسم بن محمد بن أبي بكر، وسالم بن عبد الله،(@)(@@) وغيرهما.(@)(@@) وعنه: قرة بن خالد، ومنصور.(@)(@@) في الثقات لابن حبان. ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو نوح (4) قراد، واسمه: عبد الرحمن بن غزوان.(@)(@@)(@@)(@@) $ 8476 - [بخ م د س]: أبو نوفل (5) بن أبي عقرب البكري الكناني(@)(@@) مسلم، وقيل: عمرو بن مسلم، وقيل غير ذلك.(@)(@@) عن: أبيه أو جده أبي عقرب، وعائشة، وعمرو بن العاص، وابن(@)(@@) عباس، وابن عمر، وجماعة.(@)(@)PageV10P419(@)(@)(@@) وعنه: عبد الملك بن عمير، وابن (جدعان) (1) وابن جريج،(@)(@@) وشعبة، والأسود بن شيبان.(@)(@@) وثقه ابن معين وغيره.(@)(@)PageV10P420(@)(@)(@@)(@@)(@@) || حرف الهاء(@)(@@)(@@)(@@) $$$ [عخ ت ق]: أبو هارون (1) العبدي عمارة بن جوين.(@)(@@)(@@)(@@) $$$ [خت م د ق]: أبو هارون (1) المدني موسى بن أبي عيسى.(@)(@@)(@@)(@@) $ 8477 - [ت س ق]: أبو (هاشم) (2) (3) بن عتبة بن ربيعة بن عبد(@)(@@) شمس بن عبد مناف العبشمي، خال معاوية، وأخو أبي حذيفة لأبيه،(@)(@@) وأخو مصعب بن عمير لأمه، من مسلمة الفتح، اسمه: شيبة، وقيل خالد،(@)(@@) وقيل: مهشم، وقيل: هشيم.(@)(@@) روى حديثه أبو وائل، عن سمرة بن سهم 
ms2284	 -[رجل من قومه] (4)(@)(@@) عنه. وروي عن أبي وائل عن أبي هاشم نفسه وكان فاضلا، كان أبو(@)(@@) هريرة إذا ذكره قال: ذاك الرجل الصالح.(@)(@@)(@@)(@@) $ 8478 - [د]: أبو هاشم (5) الدوسي.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: أبو يسار القرشي.(@)(@@)(@@)(@@) $ 8479 - [ع]: أبو هاشم (6) الرماني الواسطي يحيى بن دينار، وقيل:(@)(@@) يحيى بن الأسود، وقيل: ابن نافع.(@)(@)PageV10P421(@)(@)(@@) عن: الحسن، وإبراهيم النخعي، وأبي العالية، وأبي عمر زاذان،(@)(@@) وحبيب بن أبي ثابت، وجماعة كثيرة.(@)(@@) وعنه: سفيان، وشعبة، والحمادان، وخلف بن خليفة، وهشيم،(@)(@@) وآخرون.(@)(@@) وثقه (أحمد وابن معين) (1) قال أبو حاتم: كان فقيها صدوقا.(@)(@@) وروي عن عبد الحميد بن بيان الواسطي، عن أبيه، قال: مات سنة(@)(@@) اثنتين وعشرين ومائة.(@)(@@)(@@)(@@) $$$ [عس]: أبو هاشم (2) بياع السابري القاسم بن كثير.(@)(@@)(@@)(@@) $$$ [د]: أبو هاشم (2) الزعفراني عمار بن عمارة البصري.(@)(@@)(@@)(@@) $$$ [بخ 4]: أبو هاشم (2) المكي.(@)(@@) عن: عاصم بن لقيط.(@)(@@) إسماعيل بن كثير.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو هانئ (3) الخولاني حميد بن هانئ.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو هبيرة (4) يحيى بن عباد تابعي.(@)(@@)(@@)(@@) $$$ [د]: أبو هبيرة (5) الدمشقي محمد بن الوليد.(@)(@@)(@@)(@@) $$$ [د س]: أبو الهذيل (5) الأودي غالب بن الهذيل.(@)(@)PageV10P422(@)(@)(@@)(@@)(@@) $ 8480 - [ع]: أبو هريرة (1) الدوسي الحافظ - رضي الله عنه - عبد(@)(@@) الرحمن بن صخر، وقيل: عبد الرحمن بن غنم، وقيل: عبد شمس،(@)(@@) وقيل: عبد نهم، وقيل غير ذلك.(@)(@@) روى عن: النبي - صلى الله عليه وسلم -، وعن أبي بكر، وعمر، وأبي، وطائفة.(@)(@@) وعنه: ثمانمائة نفس أو أكثر منهم: إبراهيم بن عبد الله بن حنين،(@)(@@) وإسحاق مولى زائدة، والأغر أبو مسلم، وأنس بن مالك، وبسر بن(@)(@@) سعيد، وبشير بن نهيك، وبشر بن كعب، وبعجة بن عبد الله الجهني،(@)(@@) وثابت بن عياض، وجعفر بن عياض، والحسن البصري، وحفص بن(@)(@@) عاصم، وحميد بن عبد الرحمن الزهري، وحميد بن عبد الرحمن(@)(@@) الحميري، وخلاس الهجري، وزرارة بن (أوفى) (2) وسالم بن عبد(@)(@@) الله، وسالم أبو الغيث، وسعيد بن السيب، وسعيد القبري، وسعيد(@)(@@) ابن مرجانة، وسعيد بن أبي هند، وسعيد بن يسار، [وسلمان الأغر،(@)(@@) وسليمان بن يسار] (3) وشريح بن هانئ، وشهر بن حوشب، وصالح(@)(@@) مولى التوءمة، وضمضم بن جوس، وطاوس، والشعبي، 
ms2285	 وعبد الله(@)(@@) ابن شقيق، وابن عباس، وابن عمر، وعبد الرحمن بن أبي عمرة،(@)(@@) وعبد الرحمن بن أبي نعم، وعبد الرحمن الأعرج، وعبد الرحمن(@)(@@) مولى الحرقة، وعبيد الله بن أبي رافع، وعبيد الله بن عبد الله، وعبيد(@)(@@) ابن حنين، وعراك بن مالك، وعروة بن الزبير، وعطاء بن أبي رباح،(@)(@@) وعطاء بن ميناء، وعطاء بن يزيد الليثي، وعطاء بن يسار، وعطاء مولى(@)(@@) ابن أبي أحمد، وعكرمة مولى ابن عباس، وعكرمة بن خالد(@)(@@) المخزومي، وعلي بن الحسين، وعلي بن رباح، وعمار بن أبي عمار، PageV10P423(@)(@@) وعمر بن الحكم الأنصاري، وعمرو بن دينار، وعمرو بن أبي سفيان(@)(@@) الثقفي، وعيسى بن طلحة، وقبيصة بن ذؤيب، وقيس بن أبي حازم،(@)(@@) ومجاهد، وابنه المحرر بن أبي هريرة، ومحمد بن زياد الجمحي، ومحمد(@)(@@) ابن سيرين، ومحمد بن عباد بن جعفر المخزومي، ومحمد بن كعب(@)(@@) القرظي، وهمام بن منبه، ويحيى بن يعمر، ويزيد بن الأصم، ويزيد(@)(@@) ابن عبد الله بن قسيط، ويزيد بن هرمز، وأبوإدريس الخولاني،(@)(@@) وأبو حازم الأشجعي، وأبو زرعة البجلي، وأبو سلمة بن عبد الرحمن،(@)(@@) وأبو صالح السمان، وأبوصالح الأشعري، وأبو صالح الحنفي، وأبو(@)(@@) صالح الخوزي، وأبو صالح مولى ضباعة، وأبو عثمان النهدي.(@)(@@) أسلم عام خيبر، قال الواقدي: كان ينزل بذي الحليفة، وله بها(@)(@@) دار تصدق بها على مواليه.(@)(@@) وقال عبد الرحمن بن لبيبة الطائفي: أتيت أبا هريرة(@)(@@) فإذا هو رجل آدم بعيد ما بين المنكبين، ذو ضفيرتين، أفرق الثنيتين.(@)(@@) وقال الأعرج سمعت أبا هريرة يقول: "إنكم تزعمون أن أبا هريرة(@)(@@) يكثر الحديث على رسول الله - صلى الله عليه وسلم -، والله الموعد، إني كنت رجلا مسكينا(@)(@@) أصحب رسول الله - صلى الله عليه وسلم - على ملء بطني، وكان المهاجرون يشغلهم الصفق(@)(@@) بالأسواق، وكانت الأنصار يشغلهم القيام على أموالهم، فحضرت من(@)(@@) النبي - صلى الله عليه وسلم - مجلسا، فقال: من يبسط رداءه حتى أقضي مقالتي ثم يقبضه(@)(@@) إليه فلن ينسى شيئا سمعه مني. فبسطت بردة علي حتى قضى حديثه ثم(@)(@@) قبضها إلي فوالذي نفسي بيده ما نسيت شيئا بعد سمعته منه". 
ms2286	(@)(@@) قال هشام بن عروة: مات هو وعائشة سنة سبع وخمسين. وفيها(@)(@@) ورخه المدائني وطائفة.(@)(@)PageV10P424(@)(@)(@@) وقال الهيثم بن عدي وجماعة: سنة ثمان وخمسين.(@)(@@) وقال الواقدي وأبو عبيد وغيرهما: سنة تسع وخمسين.(@)(@@) قال الواقدي: صلى على عائشة في رمضان سنة ثمان، وعلى أم(@)(@@) سلمة في شوال سنة تسع وخمسين، ثم توفي بعدها في هذه السنة.(@)(@@) قلت: ترجمته مستقصاة في طبقات ابن سعد، وفي تاريخ ابن(@)(@@) عساكر وفي تاريخي، وكان أحد من يفتي بالمدينة مع ابن عمر وابن(@)(@@) عباس.(@)(@@) قال [عكرمة] (1): كان أبو هريرة يسبح في اليوم اثنتي عشرة ألف(@)(@@) تسبيحة.(@)(@@) وقال أبو عثمان النهدي (2): تضيفت أبا هريرة سبعا فكان هو وامرأته(@)(@@) وخادمه يتعقبون الليل أثلاثا، يصلي هذا، ثم يوقظ هذا هذا ويصلي.(@)(@@) فقلت: يا أبا هريرة: كيف تصوم؟ قال: أصوم من [أول] (3) الشهر(@)(@@) ثلاثا.(@)(@@) وروي (4) أن أبا هريرة كان يصوم يوم الخميس والاثنين.(@)(@@) وقال أبو نضرة العبدي (5)، عن الطفاوي قال: قرأت على أبي(@)(@@) هريرة بالمدينة ستة أشهر فلم أر رجلا من أصحاب رسول الله - صلى الله عليه وسلم - أشد(@)(@@) تشميرا ولا أقوم على ضيف منه، فدخلت عليه ذات يوم ومعه كيس فيه(@)(@@) نوى أو حصى يسبح به. وقد ولي أبو هريرة المدينة وغير ذلك.(@)(@)PageV10P425(@)(@)(@@) قال همام (1): حدثنا إسحاق بن عبد الله بن أبي طلحة: "أن عمر(@)(@@) قال أبي لأبي هريرة: كيف وجدت الإمارة؟ قال: بعثتني وأنا كاره ونزعتني(@)(@@) وقد أحببتها. وأتاه بأربعمائة ألف من البحرين".(@)(@@) ورو معمر (2) عن محمد بن زياد: "أن معاوية استعمل على المدينة(@)(@@) أبا هريرة فإذا غضب عليه عزله بمروان".(@)(@@) وقال عبد الرحمن ين يزيد بن جابر، عن عمير بن هانئ (3) قال:(@)(@@) قال أبو هريرة: "اللهم لا تدركني سنة ستين. فتوفي فيها أو قبلها(@)(@@) بسنة - رحمه الله".(@)(@@) قال الواقدي (3) كما تقدم: توفي سنة تسع وخمسين وله ثمان(@)(@@) وسبعون سنة.(@)(@@)(@@)(@@) $$$ [د ق]: أبو هريرة (4) الصيرفي محمد بن [فراس] (5).(@)(@@)(@@)(@@) $$$ [م ت ق]: أبو هشام (4) الرفاعي محمد بن يزيد.(@)(@@)(@@)(@@) $$$ [خت م د س ق]: أبو هشام (4) المخزومي المغيرة بن سلمة.(@)(@@)(@@)(@@) $$$ [خ م 
ms2287	 د س ق]: أبو همام (6) الأهوازي محمد بن الزبرقان.(@)(@@)(@@)(@@) $$$ [د س ق]: أبو همام (7) الدلال محمد بن [محبب] (8).(@)(@)PageV10P426(@)(@)(@@)(@@)(@@) $$$ [م د ت ق]: أبو همام (1) السكوني الوليد بن شجاع.(@)(@@)(@@)(@@) $$$ [د عس]: أبو همام (1) الكوفي عبد الله بن يسار.(@)(@@)(@@)(@@) $ 8481 - [د س]: أبو هند (2) البجلي.(@)(@@) عن: معاوية.(@)(@@) وعنه: عبد الرحمن بن أبي عوف الجرشي.(@)(@@)(@@)(@@) $ 8482 - [ق]: أبو هند (2) الصديق.(@)(@@) عن: نافع مولى ابن عمر.(@)(@@) وعنه: أبو خالد الدالاني.(@)(@@) مجهول، قال ابن ماكولا (3): اسمه إبراهيم بن ميمون الصائغ.(@)(@@)(@@)(@@) $ 8483 - [بخ عس]: أبو هند (4) الهمداني الدالاني [الكوفي] (5):(@)(@@) الحارث بن عبد الرحمن.(@)(@@) عن: أبي صالح باذام، والضحاك بن مزاحم، وأبي ظبيان الجنبي،(@)(@@) وأبي الجلاس.(@)(@@) وعنه: محمد بن قيس الأسدي، وأبو حنيفة، وهارون بن صالح.(@)(@@) ذكره ابن حبان في الثقات.(@)(@)PageV10P427(@)(@)(@@)(@@)(@@) $$$ [خت 4]: أبو هلال (1) الراسبي محمد بن سليم.(@)(@@)(@@)(@@) $$$ [سي]: أبو هلال (2).(@)(@@) عن: عمر بن عبد العزيز.(@)(@@) وعنه: عبد العزيز بن عمر بن عبد العزيز.(@)(@@) كذا رواه بعضهم، والصواب هلال كما تقدم.(@)(@@)(@@)(@@) $$$ [م د ت س]: أبو هياج (3) الأسدي حيان بن حصين.(@)(@@)(@@)(@@) $ 8484 - [س]: أبو الهيثم (4) بن نصر بن دهر.(@)(@@) عن: أبيه.(@)(@@) وعنه: محمد بن إبراهيم التيمي.(@)(@@) ومن قال: أبو عثمان بن نصر فقد وهم.(@)(@@)(@@)(@@) $$$ [بخ 4]: أبو الهيثم (5) العتواري سليمان بن عمرو تابعي.(@)(@@)(@@)(@@) $ 8485 - مد: أبو الهيثم (6) المرادي الكوفي حاحب القصب ويقال(@)(@@) عمار.(@)(@@) عن: سعيد بن المسيب، وإبراهيم التيمي، وسعيد بن جبير،(@)(@@) وغيرهم.(@)(@@) وعنه: سفيان، وإسرائيل، والحسن وعلي ابنا صالح بن حي.(@)(@)PageV10P428(@)(@)(@@) قال أبو حاتم: لا بأس به.(@)(@@)(@@)(@@) $ 8486 - [بخ د س]: أبو الهيثم (1) المصري.(@)(@@) عن: مولاه عقبة بن عامر، ودخين الحجري.(@)(@@) وعنه: كعب بن علقمة.(@)(@@) قيل: اسمه كثير.(@)(@)PageV10P429(@)(@)(@@)(@@)(@@) || حرف الواو(@)(@@)(@@)(@@) $$$ [بخ م ت ق]: أبو الوازع (1) الراسبي جابر بن عمرو تابعي.(@)(@@)(@@)(@@) $ 8487 - أبو واقد (2) الليثي - رضي الله عنه.(@)(@@) عن: النبي - صلى الله عليه وسلم -، وأبي بكر، وعمر.(@)(@@) وعنه: ابناه عبد الملك وواقد وسعيد بن المسيب،(@)(@@) وسنان بن أبي سنان الدولي، وعروة بن الزبير، وأبو مرة مولى عقيل،(@)(@@) وعطاء بن يسار، وعبيد الله بن عبد الله، وجماعة.(@)(@@) قيل: 
ms2288	 اسمه الحارث بن مالك، وقيل: الحارث بن عوف، وقيل:(@)(@@) عوف بن الحارث بن أسيد. يقال: شهد بدرا. ولم يصح.(@)(@@) وقال أبو حسان الزيادي: ولد في العام الذي ولد فيه ابن عباس.(@)(@@) وقال الواقدي: مات سنة ثمان وستين وهو ابن خمس وستين سنة.(@)(@@) وقيل عاش خمسا وسبعين سنة. وقيل عاش سبعين سنة.(@)(@@) وقال غير واحد: مات سنة ثمان وستين.(@)(@@)(@@)(@@) $$$ [د ت سي ق]: أبو واقد (3) الليثي الصغير صالح بن محمد بن زائدة(@)(@@) المدني.(@)(@@)(@@)(@@) $$$ [ع]: أبو وائل (4) الأسدي شقيق بن سلمة.(@)(@)PageV10P430(@)(@)(@@)(@@)(@@) $$$ [د]: أبو وائل (1) القاصن عبد الله بن بحير الصنعاني.(@)(@@)(@@)(@@) $$$ [د س]: أبو وجزة (2) السعدي يزيد بن عبيد.(@)(@@)(@@)(@@) $$$ [م د ت ق]: أبو الوداك (3) الهمداني جبر بن نوف.(@)(@@)(@@)(@@) $ 8488 - [بخ عس د ت]: أبو الورد (4) بن ثمامة بن حزن القشيري.(@)(@@) عن: ابن أعبد، والجلاح العامري، وشهر بن حوشب، وأبي(@)(@@) محمد الحضرمي، وجماعة.(@)(@@) وعنه: الجريري، وشداد بن سعيد الراسبي.(@)(@@) قال ابن سعد: معروف قليل الحديث.(@)(@@)(@@)(@@) $ 8489 - [ق]: أبو الورد (5) المازني له صحبة ورواية، قيل: اسمه حرب.(@)(@@) سكن مصر وروى عنه لهيعة بن عقبة قوله (6).(@)(@@)(@@)(@@) $$$ [ت ق]: أبو الورقاء (5) العطار فائد بن عبد الرحمن.(@)(@@) عن: ابن أبي أوفى.(@)(@@)(@@)(@@) $$$ [عس ق]: أبو الوضيء (5) القيسي عباد بن نسيب.(@)(@@)(@@)(@@) $ 8490 - [د ت]: أبو وقاص (7).(@)(@)PageV10P431(@)(@)(@@) عن: سلمان، وزيد بن أرقم.(@)(@@) وعنه: أبو النعمان.(@)(@@) وهما مجهولان.(@)(@@)(@@)(@@) $$$ [بخ م د ت ق]: أبو وكيع (1) الرؤاسي الجراح بن مليح.(@)(@@)(@@)(@@) $$$ [س]: أبو وكيع (2) الشيباني عنترة بن عبد الرحمن.(@)(@@)(@@)(@@) $$$ [ت]: أبو الوليد (3) بن أبي الجارود المكي موسى.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو الوليد (3) الدمشقي أحمد بن عبد الرحمن بن بكار.(@)(@@)(@@)(@@) $$$ [ع]: أبو الوليد (3) الطيالسي هشام بن عبد الملك.(@)(@@)(@@)(@@) $$$ [ع]: أبو الوليد (3) البصري عبد الله بن الحارث تابعي.(@)(@@)(@@)(@@) $$$ [د ق]: أبو الوليد (4) المجاشعي بركة.(@)(@@) عن: ابن عباس.(@)(@@)(@@)(@@) $ 8491 - [م]: أبو الوليد (5) المكي.(@)(@@) عن: جابر في "المحاقلة" (6).(@)(@@) وعنه: زيد بن أبي أنيسة.(@)(@@) قيل: اسمه يسار، وقيل: سعيد بن ميناء.(@)(@)PageV10P432(@)(@)(@@)(@@)(@@) $ 8492 - [د]: أبو الوليد (1).(@)(@@) عن: ابن عمر.(@)(@@) وعنه: عمر بن سليم الباهلي.(@)(@@) قال أبو حاتم: هو مولى رواحة. 
ms2289	 وقيل: هو عبد الله بن الحارث(@)(@@) المذكور.(@)(@@)(@@)(@@) $$$ [سي]: أبو الوليد (2) المغيرة أو أبو المغيرة الوليد - بالشك - ذكر في(@)(@@) ترجمة أبي المغيرة.(@)(@@)(@@)(@@) $$$ [ت]: أبو الوليد (2) سنوطا، واسمه عبيد.(@)(@@)(@@)(@@) $ 8493 - [بخ د س]: أبو وهب (3) الجشمي - رضي الله عنه -.(@)(@@) له حديث رواه عنه عقيل بن شبيب.(@)(@@)(@@)(@@) $ 8494 - [د ت ق]: أبو وهب (4) الجيشاني المصري ديلم، وقيل:(@)(@@) الهوشع بن ديلم، وقال ابن يونس: اسمه عبيد بن شرحبيل.(@)(@@) عن: الضحاك بن فيروز الديلمي، وعبد الله بن عمرو،(@)(@@) وغيرهما.(@)(@@) وعنه: يزيد بن أبي حبيب، ويحيى بن أيوب، وعمرو بن الحارث،(@)(@@) والليث، وابن لهيعة، وغيرهم.(@)(@@) قال البخاري: ديلم بن الهوشع أبو وهب الجيشاني في إسناده نظر.(@)(@)PageV10P433(@)(@)(@@)(@@)(@@) $$$ [د ق]: أبو وهب (1) [الكلاعي] (2) عبيد الله بن [عبيد] (3)(@)(@@)(@@)(@@) $ 8495 - أبو وهب (4) الكلاعي أقدم من هذا.(@)(@@) عن: عبد الله بن عمرو.(@)(@@) وعنه: عبد الرحمن بن مرزوق.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [ت]: أبو وهب (4) المروزي محمد بن مزاحم.(@)(@)PageV10P434(@)(@)(@@)(@@)(@@) || حرف اللام ألف(@)(@@)(@@)(@@) $ 8496 - [خت]: أبو لاس (1) الخزاعي، ويقال: ابن لاس، قيل: هو عبد(@)(@@) الله بن عنمة.(@)(@@) عن: النبي - صلى الله عليه وسلم -، وعن عمار.(@)(@@) وعنه: عمر بن الحكم بن ثوبان.(@)(@@) قال يعقوب بن شيبة: له حديثان.(@)(@)PageV10P435(@)(@)(@@)(@@)(@@) || حرف الياء(@)(@@)(@@)(@@) $$$ [4]: أبو يحيى (1) الأسلمي سمعان، جد إبراهيم بن محمد.(@)(@@)(@@)(@@) $$$ [م 4]: أبو يحيى (1) الأعرج مصدع.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو يحيى (2) البزاز محمد بن عبد الرحيم صاعقة.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو يحيى (3) التيمي إسماعيل بن إبراهيم كوفي.(@)(@@)(@@)(@@) $$$ [بخ د ت عس ق]: أبو يحيى (3) التيمي المدني عبيد الله بن عبد الله بن(@)(@@) موهب.(@)(@@)(@@)(@@) $ 8497 - أبو يحيى (4) التيمي إسماعيل بن عبد الله.(@)(@@) عن: سهيل بن أبي صالح.(@)(@@) وعنه: محمد بن عباد الخزاز نزيل الري.(@)(@@) تركوه، ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [بخ من د ت ق]: أبو يحيى (5) الحماني عبد الحميد بن عبد الرحمن(@)(@@) الكوفي.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو يحيى (6) الطويل عمران بن زيد الثعلبي، واسمه أشهر.(@)(@@)(@@)(@@) $ 8498 - [بخ د ت ق]: أبو يحيى (7) القتات الكوفي الكناسي زاذان، PageV10P436(@)(@@) وقيل دينار، وقيل: عبد الرحمن، وقيل: مسلم، وقيل: يزيد، وقيل:(@)(@@) زبان.(@)(@@) عن: مجاهد، وعطاء، وحبيب بن أبي 
ms2290	 ثابت.(@)(@@) وعنه: الأعمش، وسفيان، وإسرائيل، وخديج بن معاوية، وأبو(@)(@@) بكر بن عياش، وجماعة.(@)(@@) قال أحمد بن حنبل: روى عنه إسرائيل أحاديث كثيرة مناكير(@)(@@) جدا. وقال عباس، عن ابن معين: في حديثه ضعف. وقال عثمان(@)(@@) الدارمي، عن ابن معين: ثقة. وقال أحمد بن سنان القطان: سمعت(@)(@@) يحيى بن معين يقول: أبو يحيى القتات في الكوفيين مثل ثابت في(@)(@@) البصريين. وقال النسائي: ليس بالقوي. وقال ابن عدي: يكتب(@)(@@) حديثه على ما فيه.(@)(@@)(@@)(@@) $$$ [د س]: أبو يحيى (1) القرشي زياد.(@)(@@) عن: ابن عباس.(@)(@@)(@@)(@@) $ 8499 - [ق]: أبو يحيى (2) المكي.(@)(@@) عن: فروخ، عن عمر في "الاحتكار" (3).(@)(@@) وعنه: الهيثم بن رافع.(@)(@@) في الثقات لابن حبان، يقال: إنه مصدع.(@)(@@)(@@)(@@) $ 8500 - [عخ د س ق]: أبو يحيى (4) المكي.(@)(@)PageV10P437(@)(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: موسى بن أبي عثمان.(@)(@@) ذكره ابن حبان في الثقات وزعم أنه سمعان الأسلمي.(@)(@@)(@@)(@@) $ 8501 - [بخ م ق]: أبو يحيى (1) مولى آل جعدة بن هبيرة.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: الأعمش.(@)(@@)(@@)(@@) $ 8502 - أبو يحيى (1) عبد الحي بن سويد.(@)(@@) عن: أبي هشام الرفاعي.(@)(@@) وعنه: ابن ماجة.(@)(@@) كذا في الكمال ولعله من شيوخ أبي الحسن بن سلمة القطان صاحب(@)(@@) ابن ماجة.(@)(@@)(@@)(@@) $$$ [قد س]: أبو يزيد (2) الوالبي وقاء بن إياس.(@)(@@)(@@)(@@) $ 8503 - [ت]: أبو يزيد (3) الخولاني مصري.(@)(@@) عن: فضالة بن عبيد.(@)(@@) وعنه: عطاء بن دينار في "الشهداء" (4).(@)(@@)(@@)(@@) $ 8504 - [د ق]: أبو يزيد (5) الخولاني الصغير مصري أيضا.(@)(@)PageV10P438(@)(@)(@@) عن: سيار الصدفي.(@)(@@) وعنه: ابن وهب، ومروان الطاطري، قال: وكان شيخ صدق.(@)(@@)(@@)(@@) $ 8505 - [س ق]: أبو يزيد [الضني] (1).(@)(@@) عن: ميمونة خادم النبي - صلى الله عليه وسلم -.(@)(@@) وعنه: زيد بن جبير.(@)(@@)(@@)(@@) $ 8506 - [خ س]: أبو يزيد (2) المديني.(@)(@@) عن: أبي هريرة، وأسماء بنت عميس، وابن عباس، وابن عمر،(@)(@@) وعكرمة، وغيرهم.(@)(@@) وعنه: أيوب السختياني، وفطر بن كعب، ومبارك بن فضالة،(@)(@@) وسعيد بن أبي عروبة، وجرير بن حازم، وجماعة.(@)(@@) وثقه ابن معين وغيره، وقال أبو زرعة لا أعرف له اسما.(@)(@@)(@@)(@@) $ 8507 - [د ت ق]: أبو يزيد (3) المكي والد عبيد الله بن أبي يزيد.(@)(@@) عن: عمر، وسباع بن ثابت، وأم أيوب الأنصارية. 
ms2291	(@)(@@) وعنه: ابنه.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [م د]: أبو يزيد (4) يحيى بن يزيد الهنائي.(@)(@)PageV10P439(@)(@)(@@)(@@)(@@) $$$ [بخ]: أبو يزيد (1) في ترجمة سهيل بن ذراع.(@)(@@)(@@)(@@) $ 5808 - أبو يسار (1) القرشي.(@)(@@) عن: أبي هاشم الدوسي.(@)(@@) وعنه: الأوزاعي، والليث بن سعد.(@)(@@) قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $$$ أبو يسار (2).(@)(@@) عن: وهب بن خالد.(@)(@@) كذا في الكمالط وإنما هو [أبو] (3) سنان سعيد بن سنان.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو اليسر (2) السلمي كعب بن عمرو.(@)(@@)(@@)(@@) $$$ [ع]: أبو يعفور (2) الأكبر واقد.(@)(@@)(@@)(@@) $$$ [ع]: أبو يعفور (4) الأصغر عبد الرحمن بن عبيد.(@)(@@)(@@)(@@) $ 8509 - [د]: أبو يعقوب (5).(@)(@@) قال (د): ثنا رجل ثقة يكنى أبا يعقوب، ثنا هشام بن يوسف(@)(@@) قال أبو القاسم بن عساكر: هو إسحاق بن أبي إسرائيل.(@)(@@)(@@)(@@) $$$ [ل ت]: أبو يعقوب (5) البويطي الفقيه يوسف بن يحيى.(@)(@)PageV10P440(@)(@)(@@)(@@)(@@) $$$ [د ق] (1): أبو يعقوب (2) التوءم (1) عبد الله بن يحيى الثقفي.(@)(@@)(@@)(@@) $ 8510 - أبو يعقوب (2) التوءم يوسف بن نافع بصري.(@)(@@) عن: عبد الرحمن بن أبي الزناد.(@)(@@) وعنه: جعفر بن عبد الواحد الهاشمي، والكديمي.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [د ت ق]: أيو يعقوب (3) الثقفي إسحاق بن إبراهيم.(@)(@@)(@@)(@@) $$$ [د ق]: أبو يعقوب (4) الحنيني إسحاق بن إبراهيم.(@)(@@)(@@)(@@) $$$ [خ س]: أبو يعلى (4) التوزي محمد بن الصلت.(@)(@@)(@@)(@@) $$$ [ع]: أبو يعلى (4) منذر بن يعلى الثوري.(@)(@@)(@@)(@@) $$$ [د ت ق]: أيو اليقظان (5) عثمان بن عميرة.(@)(@@)(@@)(@@) $$$ [ع]: أبو اليمان (6) البهراني الحكم بن نافع.(@)(@@)(@@)(@@) $ 8511 - [د]: أبو اليمان (6) الرحال المديني كثير بن يمان،(@)(@@) وقيل: ابن جريج.(@)(@@) عن: شداد بن أبي عمرو، وأم ذرة.(@)(@@) وعنه: عبد العزيز الدراوردي، وأبو [هاشم] (7) الزعفراني.(@)(@)PageV10P441(@)(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو اليمان (1) النبال معبى بن راشد البصري.(@)(@@)(@@)(@@) $$$ [مد]: أبو اليمان (1) الهوزني عامر بن عبد الله.(@)(@@)(@@)(@@) $$$ [ت س]: أبو يوسف (1) يعقوب بن سفيان [الفسوي] (2).(@)(@@)(@@)(@@) $$$ [ع]: أبو يونس (3) [القشيري] (4) حاتم بن أبي صغيرة.(@)(@@)(@@)(@@) $$$ [ق]: أبو يونس (5) القوي الحسن بن يزيد.(@)(@@)(@@)(@@) $$$ [بخ م د ت]: أبو يونس (6) مولى. أبي هريرة سليم بن جبير.(@)(@@)(@@)(@@) $ 8512 - [بخ م د ت س]: أبو يونس (7) مولى عائشة.(@)(@@) عنها.(@)(@@) وعنه: زيد بن أسلم، والقعقاع بن حكيم، وأبو طوالة، ومحمد(@)(@@) أبي عتيق.(@)(@@) في الثقات 
ms2292	 لابن حبان.(@)(@@) آخر الكنى. والله أعلم.(@)(@)PageV10P442(@)(@@)(@@)(@@) | فصل فيمن عرف بابن فلان(@)(@@)(@@)(@@) $$$ ابن أبجر (1): عبد الملك بن سعيد.(@)(@@)(@@)(@@) $$$ ابن أبزي (1): عبد الرحمن، وولداه: سعيد وعبد الله.(@)(@@)(@@)(@@) $$$ ابن أبي (1): محمد بن أبي بن كعب.(@)(@@)(@@)(@@) $$$ ابن الأجلح (1): عبد الله.(@)(@@)(@@)(@@) $$$ ابن إدريس (1): عبد الله الأودي، ومحمد بن إدريس الشافعي.(@)(@@)(@@)(@@) $$$ ابن (أردك) (2): عبد الرحمن بن حبيب بن أردك.(@)(@@)(@@)(@@) $$$ ابن أرقم (1): سليمان، وعبد الله.(@)(@@)(@@)(@@) $$$ ابن إسحاق (1): محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) $$$ ابن الأسقع (3): واثلة حديث: "أي القرآن أعظم" (4).(@)(@@)(@@)(@@) $$$ ابن أبي الأسود (5): أبو بكر عبد الله بن محمد بن أبي الأسود.(@)(@@)(@@)(@@) $$$ ابن الأشجعي (5): أبو عبيدة بن عبيد الله.(@)(@@)(@@)(@@) $$$ ابن أشوع (6): سعيد بن عمرو.(@)(@)PageV11P005(@)(@)(@@)(@@)(@@) $$$ ابن الأصبهاني (1): ثلاثة: عبد الرحمن بن عبد الله، وابن أخيه(@)(@@) محمد بن سليمان، ومحمد بن سعيد بن سليمان.(@)(@@)(@@)(@@) $$$ ابن أعبد (1): علي.(@)(@@)(@@)(@@) $$$ ابن أفلح (1): عمرو بن كثير بن أفلح.(@)(@@)(@@)(@@) $$$ ابن أقرم (1): عبد الله.(@)(@@)(@@)(@@) $$$ ابن أكيمة الليثي (1) -: اثنان: عمارة، ويقال: عمرو، وابن ابنه(@)(@@) عمرو، وقيل: عمر بن مسلم.(@)(@@)(@@)(@@) $$$ ابن أبي أمية (1): أخو أم سلمة: عامر.(@)(@@)(@@)(@@) $$$ ابن أبي أنس (1): هو أبو سهيل نافع بن مالك.(@)(@@)(@@)(@@) $$$ ابن أنعم (1) الأفريقي: عبد الرحمن بن زياد بن أنعم.(@)(@@)(@@)(@@) $ 8514 - [س]: ابن أبي أوس (2) الثقفي.(@)(@@) عن: جده في "الوضوء" (3).(@)(@@) وعنه: النعمان بن سالم.(@)(@@)(@@)(@@) $ 8515 - [ق]: ابن أبي أوس (4).(@)(@@) عن: جده.(@)(@@) وعنه: النعمان بن سالم.(@)(@@) أظنه الذي قبله.(@)(@)PageV11P006(@)(@)(@@)(@@)(@@) $$$ ابن أبي أوفى (1): عبد الله.(@)(@@)(@@)(@@) $$$ ابن أبي أويس (1): إسماعيل.(@)(@@)(@@)(@@) $$$ ابن أبي أيوب (1): سعيد.(@)(@@)(@@)(@@) $$$ ابن باباه (2): ويقال: ابن بابيه. ويقال: ابن بابي، عبد الله، ويقال: هم ثلاثة.(@)(@@)(@@)(@@) $$$ ابن بجدان (3): عمرو.(@)(@@)(@@)(@@) $$$ ابن بجيد (3) الأنصاري: عبد الرحمن.(@)(@@) ابن بحينة (3): عبد الله بن مالك.(@)(@@)(@@)(@@) $$$ ابن بذيمة (3): علي.(@)(@@)(@@)(@@) $$$ [د س ق]: ابن البراء بن عازب (3): عبيد.(@)(@@)(@@)(@@) $$$ ابن براد (3): عبد الله.(@)(@@)(@@)(@@) $$$ [س]: ابن أبي بردة (3).(@)(@@) عن: أبيه عن جده.(@)(@@) وعنه: شعبة.(@)(@@) هو سعيد بن أبي بردة بن أبي موسى.(@)(@@)(@@)(@@) $$$ ابن بريدة (3): عبد الله، وأخوه سليمان.(@)(@@)(@@)(@@) $ 8516 - [د ق] (4): ابنا بسر السلمي.(@)(@)PageV11P007(@)(@)(@@) روى عنهما سليم بن عامر. هما: عبد الله، وعطية.(@)(@@)(@@)(@@) $$$ ابن بشار (1): محمد.(@)(@@)(@@)(@@) $$$ [مق]: ابن بشر العبدي (1): محمد.(@)(@@)(@@)(@@) $$$ ابن أبي بصير 
ms2293	 (1): عبد الله.(@)(@@)(@@)(@@) $$$ ابن بكر البرساني (1): محمد.(@)(@@)(@@)(@@) $$$ كن: ابن أبي بكر الصديق (1)(@)(@@) عن: أم سلمة.(@)(@@) هو عبد الله بن عبد الرحمن بن أبي بكر.(@)(@@)(@@)(@@) $$$ ابن أبي بكرة الثقفي (1): عبد الرحمن.(@)(@@)(@@)(@@) $$$ ابن بكير (1): يحيى بن عبد الله.(@)(@@)(@@)(@@) $$$ ابن أبي بكير الكرماني (1): يحيى.(@)(@@)(@@)(@@) $$$ ابن أبي بلال (1): عبد الله.(@)(@@)(@@)(@@) $$$ ابن البيلماني (1): عبد الرحمن، وابنه محمد.(@)(@@)(@@)(@@) $$$ ابن تعلى (1): عبيد.(@)(@@)(@@)(@@) $ 8517 - [د س]: ابن التلب (1).(@)(@@) عن: أبيه في "العتق" (2).(@)(@@) وعنه: الوليد أبو بشر العنبري.(@)(@)PageV11P008(@)(@)(@@)(@@)(@@) $$$ ابن أبي ثابت (1): اثنان: حبيب الكوفي، وعبد العزيز المدني.(@)(@@)(@@)(@@) $$$ ابن أبي الثلج (1): محمد بن عبد الله بن إسماعيل.(@)(@@)(@@)(@@) $$$ ابن ثوبان (1): محمد بن عبد الرحمن بن ثوبان، وعبد الرحمن بن(@)(@@) ثابت بن ثوبان.(@)(@@)(@@)(@@) $$$ ابن أبي ثور (2): جعفر، وعبيد الله بن عبد الله.(@)(@@)(@@)(@@) $$$ ف: ابن جابر (2).(@)(@@) عن: أبيه: في "قتلى أحد".(@)(@@) وعنه: الزهري.(@)(@@) هو محمد أو عبد الرحمن.(@)(@@)(@@)(@@) $ 8518 - [د س]: ابن جابر (2) بن عتيك.(@)(@@) عن: أبيه.(@)(@@) وعنه: محمد بن إبراهيم التيمي. لعله عبد الرحمن.(@)(@@)(@@)(@@) $$$ ابن جابر (3): عبد الرحمن بن يزيد بن جابر.(@)(@@)(@@)(@@) $$$ [د ق]: ابن الجارود (3): عبد الحميد بن المنذر بن الجارود.(@)(@@)(@@)(@@) $$$ ابن جبر (3): عبد الله بن عبد الله بن [جبر] (4).(@)(@@)(@@)(@@) $$$ [د ق]: ابن جبير بن مطعم (5).(@)(@@) عن: أبيه في "التكبير للصلاة" (6).(@)(@)PageV11P009(@)(@)(@@) هو نافع.(@)(@@)(@@)(@@) $$$ ابن جدعان (1): علي بن زيد بن جدعان.(@)(@@)(@@)(@@) $ 8519 - [ت]: ابن جرهد (1).(@)(@@) عن: أبيه "الفخذ عورة" (2).(@)(@@) وعنه: أبو الزناد.(@)(@@)(@@)(@@) $$$ ابن جريج (1): عبد الملك بن عبد العزيز المكي.(@)(@@)(@@)(@@) $ 8520 - [ت]: ابن جرير (1) بن عبد الله البجلي.(@)(@@) عن: أبيه.(@)(@@) وعنه: عبد الملك بن عمير.(@)(@@) روى عن المنذر بن جرير، عن أخيه عبيد الله.(@)(@@)(@@)(@@) $ 8521 - [د]: ابن لجرير (3) بن عبد الله.(@)(@@) عن: أبيه.(@)(@@) وعنه: أبو إسحاق.(@)(@@) يقال: هو ع