ms2466	 قيل هو إسماعيل بن أبان أو اخوه عن يحيى بن يعلى.(@)(@@)(@@)(@@) | 3075 - (@)(@@) " سعيد " بن أبيض بن حمال بالمهملة المرادي أبو هانئ الماربي بكسر الراء بعدها موحدة اليماني.(@)(@@)(@@)(@@) | 3076 - (@)(@@) " سعيد " بن أوس بن ثابت بن بشير أبو زيد الأنصاري النحوي البصري.(@)(@@)(@@)(@@) | 3077 - (@)(@@) " سعيد " بن إياس الجريري بضم الجيم ومهملتين أبو مسعود البصري.(@)(@@)(@@)(@@) | 3078 - (@)(@@) " سعيد " بن بشير الأزدي مولاهم أبو عبد الرحمن أو أبو سلمة الشامي أصله من البصرة أو واسط صاحب قتادة.(@)(@@)(@@)(@@) | 3079 - (@)(@@) " سعيد " بن بشير الأنصاري عن ابن البليماني وعنه الليث.(@)(@@)(@@)(@@) | 3080 - (@)(@@) " سعيد " بن جهمان بضم الجيم واسكان الميم الأسلمي أبو حفص البصري.(@)(@@)(@@)(@@) | 3081 - (@)(@@) " سعيد " بن حسان المخزومي المكي قاص أهل مكة عن ابن عمر رضى الله عنهما وعنه نافع الجمحي.(@)(@@)(@@)(@@) | 3082 - (@)(@@) " سعيد " بن حكيم بن معاوية بن حيدة القشيري البصري أخو بهز.(@)(@@)(@@)(@@) | 3083 - (@)(@@) " سعيد " بن حيان التيمي الكوفي أبو يحيى والد يحيى عن علي وأبي هريرة رضى الله عنهما.(@)(@@)(@@)(@@) | 3084 - (@)(@@) " سعيد " بن خالد بن أبي الطويل القرشي الصيداوي.(@)(@@)(@@)(@@) | 3085 - (@)(@@) " سعيد " بن خالد بن عبد الله بن قارظ1 الكناني المدني عن عمه إبراهيم. PageV07P227(@)(@@)(@@)(@@) | 3086 - (@)(@@) " سعيد " بن خالد الخزاعي المدني.(@)(@@)(@@)(@@) | 3087 - (@)(@@) " سعيد " بن خثيم بمعجمة ومثلثة ثم تحتانية مصغرا بن رشد بفتح الراء والمعجمة الهلالي أبو معمر الكوفي.(@)(@@)(@@)(@@) | 3088 - (@)(@@) " سعيد " بن داود بن أبي زنبر1 الزنبري أبو عثمان المدني عن مالك فيه لين.(@)(@@)(@@)(@@) | 3089 - (@)(@@) " سعيد " بن ذويب المروزي أبو الحسن روى عنه النسائي.(@)(@@)(@@)(@@) | 3090 - (@)(@@) " سعيد " بن ذي حدان الكوفي2 ما روى عنه سوى أبي إسحاق.(@)(@@)(@@)(@@) | 3091 - (@)(@@) " سعيد " بن راشد وابن أبي راشد يروي عن يعلى بن مرة وعنه عبد الله بن عثمان ابن خثيم.(@)(@@)(@@)(@@) | 3092 - (@)(@@) " سعيد " بن زربي3 الخزاعي أبو عبيدة وأبو معاوية البصري العباداني.(@)(@@)(@@)(@@) | 3093 - (@)(@@) " سعيد " بن زربي أبو عبيدة صاحب الموعظة.(@)(@@)(@@)(@@) | 3094 - (@)(@@) " سعيد " بن زرعة الحمصي الجزار4 التيمي الخزاف.(@)(@@)(@@)(@@) | 3095 - (@)(@@) " سعيد " بن زكريا القرشي المدايني أبو عثمان وأبو عمر المدايني عنه ابنه أحمد وأحمد بن حنبل.(@)(@@)(@@)(@@) | 3096 - (@)(@@) " سعيد " بن زياد الشيباني المكي عن طاوس وعنه وكيع ومكي بن إبراهيم. 
ms2467	(@)(@@)(@@)(@@) | 3097 - (@)(@@) " سعيد " بن زياد الأنصاري المدني عن جابر بن عبد الله رضى الله عنه وعنه سعيد بن أبي هلال. PageV07P228(@)(@@)(@@)(@@) | 3098 - (@)(@@) " سعيد " بن زيد بن درهم الأزدي الجهضمي مولاهم أبو الحسن البصري الحافظ أخو حماد.(@)(@@)(@@)(@@) | 3099 - (@)(@@) " سعيد " بن سالم القداح أبو عثمان الخراساني ثم المكي روى عنه الشافعي ويحيى بن آدم.(@)(@@)(@@)(@@) | 3100 - (@)(@@) " سعيد " بن أبي سعيد كيسان المقبري أبو سعيد المدني.(@)(@@)(@@)(@@) | 3101 - (@)(@@) " سعيد " بن سعيد التغلبي1 الكوفي أبو الصباح عن عكرمة وعنه أبو أسامة ضعفه الأزدي قواه بن حبان.(@)(@@)(@@)(@@) | 3102 - (@)(@@) " سعيد " بن أبي سعيد الزبيدي2 هو ابن عبد الجبار أبو عثمان الحمصي.(@)(@@)(@@)(@@) | 3103 - (@)(@@) " سعيد " بن أبي سعيد مولى أبي بكر بن حزم.(@)(@@)(@@)(@@) | 3104 - (@)(@@) " سعيد " بن سفيان الجحدري البصري عن داود بن أبي هند وشعبة.(@)(@@)(@@)(@@) | 3105 - (@)(@@) " سعيد " بن سفيان الأسلمي مولاهم المدني عن جعفر بن محمد الصادق رحمهما الله تعالى وعنه ابن أبي فديك.(@)(@@)(@@)(@@) | 3106 - (@)(@@) " سعيد " بن سلمة بن أبي الحسام العدوي مولاهم السدوسي أبو عمر3 المدني يروي عنه العقدي ومحمد بن أبي بكر المقدمي.(@)(@@)(@@)(@@) | 3107 - (@)(@@) " سعيد " بن سلمان أبو بن أبي سليمان الربعي بفتح الراء الموحدة.(@)(@@)(@@)(@@) | 3108 - (@)(@@) " سعيد " بن سليمان الضبي أبو عثمان نزيل بغداد البزاز آخره زاي الواسطي الحافظ لقبه سعدويه روى عنه أبو داود البخاري.(@)(@@)(@@)(@@) | 3109 - (@)(@@) " سعيد " بن سمعان الأنصاري الزرقي مولاهم المدني.(@)(@@)(@@)(@@) | 3110 - (@)(@@) " سعيد " بن سنان أبو سنان البرجمي4 الشيباني الأصغر الكوفي نزيل PageV07P229(@)(@@) الري وقزوين.(@)(@@)(@@)(@@) | 3111 - (@)(@@) " سعيد " بن سنان الحنفي أو الكندي أبو مهدي الحمصي.(@)(@@)(@@)(@@) | 3112 - (@)(@@) " سعيد " بن عبد الله الجهني حجازي.(@)(@@)(@@)(@@) | 3113 - (@)(@@) " سعيد " بن عامر الضبعي بضم المعجمة وفتح الموحدة أبو محمد البصري أحد الاعلام عن ابن عمر رضى الله عنهما.(@)(@@)(@@)(@@) | 3114 - (@)(@@) " سعيد " بن عبد الله بن جريج الأسلمي مولى أبي برزة بصري عن مولاه.(@)(@@)(@@)(@@) | 3115 - (@)(@@) " سعيد " بن عبد ال