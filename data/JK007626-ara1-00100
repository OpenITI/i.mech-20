ms81	 % عن قدرهم قللوا أو احتفلوا % % 3(@)(@@) % وقد أتانا الذي بعثت به % لا أود شأنه ولا خلل % 4(@)(@@) % مشط من العود لم يعبه ولا % % مالت به خفة ولا ثقل % 5(@)(@@) % يحبو اللحى طبيه وزينته % % فهو على معنيين مشتمل % 6(@)(@@) % ومستقيم المئين عادله % ليست له عثرة ولا زلل % 7(@)(@@) % أسود لا تستبين نقمته % حين يواريه فاحم رجل % 8(@)(@@) % كأنما الأشمط الكبير إذا % % خالط منه البياض مكتهل % 9(@)(@@) % ظرفت فيه وكنت متبعا % في الظرف واللطف أيها الرجل % 10(@)(@@) % فكدت من شدة السرور به % آمن أن المشيب يشتعل % PageV01P411 البحر : رجز تام 1(@)(@@) % لنا على دجلة نخل منتحل % نسلفه ماء ويسقينا عسل % 2(@)(@@) % مسطر على قوام معتدل % لم ينتقل عن سطره ولم يمل % 3(@)(@@) % ذو قدر فما علا ولا سفل % يسقى بماء وهو شتى في الأكل % 4(@)(@@) % كأنما أعذاقه إذا حمل % غدائر من شعر وحف رجل % 5(@)(@@) % وفيه عمري كعمر متصل % يحمس الجود به الصب الغزل % 6(@)(@@) % لو نظمته البكر عقدا لاحتمل % وفاق عقد الدر لونا وفضل % 7(@)(@@) % يمل إدراك المنى ولا يمل % حسبك أن طعمه يشفي العلل % 8(@)(@@) % كأنه أطراف ربات الكلل % لم يندرس خضابها ولا نصل % 9(@)(@@) % يومين بالتسليم إيماء بدل % كأن في أغداقه مثل العسل % 10(@)(@@) % ما زال في الأفياء يغدو ويمل % بشمس أحيانا وأحيانا بظل % PageV01P412 11(@)(@@) % ويكتسى من صنعة البدر حلل % كأنه في الخد ألوان الخجل % 12(@)(@@) % وعظم الأرداف فيه ونبل % مثل أنابيب قنا الخط الذبل % 13(@)(@@) % لولا النوى يمسك منه لهطل % تعاقبته غدوات وأصل % 14(@)(@@) % وجاده ماء معين وسبل % حتى إذا قيل تناهى وكمل % 15(@)(@@) % جاء به القاطف مسرورا جزل % محتفلا أحبب له من محتفل % 16(@)(@@) % في ساعة أطيب من نيل الأمل % لما مضى جيش الظلام فرحل % 17(@)(@@) % وأقبل الصبح منيرا فنزل % فأيما ضيف رجا ولم ينل % 18(@)(@@) % منه فكان الزاد عندي مبتذل % فأمتع الأفواه منه والمقل % 19(@)(@@) % في هذه لذ وفي هاتيك جل % . . . . . . . . . . . % PageV01P413 البحر : طويل 1(@)(@@) % أبعد مصاب الأم آلف مضجعا % وآوى إلى خفض من العيش أو ظل % 2 
ms82	(@)(@@) % سترضع عيني قبرها من دموعها % % كما ألفته من رضاع ومن حمل % 3(@)(@@) % فأقسم لو أبصرتني عند موتها % % وعيني تسح الدمع سجلا على سجل % 4(@)(@@) % رثيث لنصل يأخذ الموت جفنه % وأعجبت من فرع ينوح على أصل % 5(@)(@@) % وكان علها إن أقدم قبلها % % أشد وأدهى من تقدمها قبلي % % 6(@)(@@) % فقد قربت من غمها بي ومن حسرتي % % عليها وفيما بين ذلك ما يبلي % % PageV01P414 البحر : بسيط تام 1(@)(@@) % أما الظلام فقد رقت غلالته % والصبح حين بدا بالنور يختال % 2(@)(@@) % فانظر بعينيك أغصان الشقائق في % % فروعها زهر في الحسن أمثال % 3(@)(@@) % من كل مشرقة الأوراق ناضرة % لها على الغصن إيقاد وإشعال % 4(@)(@@) % حمراء من صبغة الباري بقدرته % مصقولة لم ينلها قط صقال % 5(@)(@@) % كأنها وجنات أربع جمعت % فكل واحدة في صحنها خال % PageV01P415 البحر : متقارب تام 1(@)(@@) % له شغل عن سؤال الطلل % أقام الخليط به أم رحل % 2(@)(@@) % فما تطبيه لحاظ الظبا % % تطالعه من سجوف الكلل % 3(@)(@@) % ولا تستفز حجاه الخدود % بمصفرة واحمرار الخجل % 4(@)(@@) % كفاه كفاه فلا تعذلا % ه كر الجديدين كر العذل % 5(@)(@@) % طوى الغي منتشرا في ذرا % % ه تطفا الصبابة لما اشتعل % 6(@)(@@) % له في البكاء على الطاهري % % ن مندوحة عن بكاء الغزل % 7(@)(@@) % فكم فيهم من هلال بدا % % قبيل التمام وبدر أفل % 8(@)(@@) % هم حجج الله في خلقه % ويوم المعاد على من خذل % 9(@)(@@) % ومن أنزل الله تفضيلهم % فرد على الله ما قد نزل % 10(@)(@@) % فجدهم خاتم الأنبيا % % ء يعرف ذاك جميع الملل % PageV01P416 11(@)(@@) % ووالدهم سيد الأوصياء % ومعطي الفقير ومردي البطل % 12(@)(@@) % ومن علم السمر طعن الحلى % % لذي الروع والبيض ضرب القلل % 13(@)(@@) % ولو زالت الأرض يوم الهيا % % ج من تحت أخمصه لم يزل % 14(@)(@@) % ومن صد عن وجه دنياهم % % وقد لبست حليها والحلل % 15(@)(@@) % وكان إذا ما أضافوا إلي % % ه أرفعهم رتبة في المثل % 16(@)(@@) % سماء اضيف إليها الحضيض % وبحرا قرنت إليه الوشل % 17(@)(@@) % بجود تعلم منه السحاب % وحلم تولد منه الجبل % 18(@)(@@) % وكم شبهة بهداه جلا % % وكم خطة بحجاه فضل 
ms83	 % 19(@)(@@) % وكم أطفا الله نار الضلال % به وهي ترمي الهدى بالشعل % 20(@)(@@) % ومن رد خالقنا شمسه % عليه وقد جنحت للطفل % PageV01P417 21(@)(@@) % ولو لم تعد كان في رأيه % وفي وجهه من سناها بدل % 22(@)(@@) % ومن ضرب الناس بالمرهفات % على الدين ضرب عراب الإبل % 23(@)(@@) % وتردي الحسين سيوف الطغا % % ة ظمآن لم يطف حر الغلل % 24(@)(@@) % ثوى عطشا وتنال الرما % % ح من دمه علها والنهل % 25(@)(@@) % ولم يخسف الله بالظالمين % ولكنه لا يخاف العجل % 26(@)(@@) % لقد نشطت لعناد الرسول % رجال بها عن هداها كسل % 27(@)(@@) % فلا بوعدت أعين من عمى % ولا عوفيت أذرع من شلل % 28(@)(@@) % نظار بأن بنات النب % % ي السبايا ومال النبي النفل % 29(@)(@@) % غدا يتولى الإله الجدا % % ل إن كنتم من رجال الجدل % 30(@)(@@) % فيعلم من في ظلال النعيم % ومن في الجحيم عليه ظلل % PageV01P418 31(@)(@@) % أيا رب وفق لخير المقا % % ل إن لم أوفق لخير العمل % 32(@)(@@) % ولا تقطعن أملي والرجاء % فأنت الرجاء وأنت الأمل % PageV01P419 البحر : متقارب تام 1(@)(@@) % أتتك ودنيا إذا أقبلت % كإسعاف دنيا وإقبالها % % 2(@)(@@) % تميس من الوشي في حلة % تجرو من فضل أذيالها % % 3(@)(@@) % وتحمل عودا فيصيح الجواب % يحاكي اللحون باشكالها % % 4(@)(@@) % له عنق مثل ساق القناة % ودستانة مثل خلخالها % % 5(@)(@@) % فظلت تطارح أوتاره % بأهزاجها وبأرمالها % % 6(@)(@@) % وتحمل حبسا كحبس العرو % % ق وتلوي الملاوي بأمثالها % % PageV01P420 البحر : رجز تام 1(@)(@@) % مقبلة والخصب في إقبالها % % والرعد يحدو الودق من جمالها % % 2(@)(@@) % بخطبة أبدع في ارتجالها % % كأنها من نقل انتقالها % % 3(@)(@@) % تجلها الريح عن استعجالها % % إلا كما تجذب من أذيالها % % 4(@)(@@) % فحين ضاق الجوذ عن مجالها % % والزهر قد أصغى إلى مقالها % % 5(@)(@@) % كأنما نسألها عن حالها % % وراحت الرياح من كلالها % % 6(@)(@@) % وكاد أن ينهض لاستقبالها % % فسمحت بالري من زلالها % % 7(@)(@@) % حتى أتاك اشرب من هطالها % % إن سجلا أتى على سجالها % % 8(@)(@@) % ثم انثنى ينثني على فعالها % % PageV01P421 البحر : بسيط تام 1(@)(@@) % إني فزعت إلى صبري فانقذني % % من سوء فعلك بي إذ قصرت حيلي % % 2(@)(@@) % والصبر مثل اسمه في كل نائبة 
ms84	 % لكن عواقبه أحلى من العسل % PageV01P422 البحر : بسيط تام 1(@)(@@) % لا تسأل الناس شيئا واغد معتصما % بالله تلق الذي املت من أمل % 2(@)(@@) % فالناس تغضبهم إما سألتهم % والله تغضبه إن أنت لم تسل % PageV01P423 البحر : منسرح 1(@)(@@) % وزائر والعيون هاجعة % وقلبه من رقيبه وجل % 2(@)(@@) % منغص وصله تجشمه % يميل من لينه ويعتدل % 3(@)(@@) % كان شفائي من ريقه جرع % تروى من ورد خده قبل % PageV01P424 البحر : كامل تام 1(@)(@@) % وزعمت أنك في الكتابة مدرك % شأوي وقلت سلاحنا الأقلام % 2(@)(@@) % هيهات تلك صناعة ممزوجة % فيها صباح واضح وظلام % 3(@)(@@) % هذا الحديد سلاح أبطال الوغى % % وبه يريق دماءنا الحجام % PageV01P425 البحر : متقارب تام 1(@)(@@) % إذا أومض البرق من أرضها % % يمثل لي أنها تبسم % 2(@)(@@) % وأذكرها في المحل الجديب % فيخصب من دمعي المنسم % PageV01P426 البحر : مخلع البسيط 1(@)(@@) % حب علي علو همه % لأنه سيد الأئمه % 2(@)(@@) % ميز محبيه هل تراهم % إلا ذوي ثروة ونعمه % 3(@)(@@) % بين رئيس إلى أديب % قد أكمل الظرف واستتمه % 4(@)(@@) % وطيب الأصل ليس فيه % عند امتحان الأصول تهمه % 5(@)(@@) % فهم إذا خلصوا ضياء % % والنصب الظالمون ظلمه % PageV01P427 البحر : متقارب تام 1(@)(@@) % وتهتز في مشيها مثلما % % تهز الصبا غصنا ناعما % % 2(@)(@@) % وتأمر بالأمر فيه الذي % % كرهت وأرضى به راغما % % 3(@)(@@) % وأشكو إليها فلا مسعدا % أصادف منها ولا راحما % % 4(@)(@@) % متى ينصف الخصم من ظالم % إذا كان ظالمه حاكما % % PageV01P428 البحر : متقارب تام 1(@)(@@) % شكوت إلى مرحب علة % فصرح بالراح لي بالملام % 2(@)(@@) % وقال أخاف غليظ الشراب % ولست أخاف غليظ العظام % 3(@)(@@) % وأنت لطيف حديد المزاج % نحيف الجوارح عاري العظام % 4(@)(@@) % فلا تجمعن عليك الضنا % % بنار المزاج ونار المدام % 5(@)(@@) % فإن تكن الراح تنفي الهموم % فربتما أعرضت للسقام % PageV01P429 البحر : سريع 1(@)(@@) % يا مشبها في لونه فعله % لم تعد ما أوجبت القسمه % 2(@)(@@) % ظلمك من خلقك مستخرج % والظلم مشتق من الظلمه % PageV01P430 البحر : وافر تام 1(@)(@@) % مضى رمضان قد أديت فيه % حقوق الله قرى نا وصوما % % 2(@)(@@) % وجاء الفطر فاله الآن فيه % ولا تسمع لمن يلحاك لوما % % 3(@)(@@) % وعدل قسمة الأيام 
ms85	 نصفا % وعقد رياسة يوما فيوما % % 4(@)(@@) % وليلك شطر عمرك فاغتنمه % ولا تذهب بنصف العمر نوما % % PageV01P431 البحر : كامل تام 1(@)(@@) % بكرت بلوم ومثلها لك لائمه % كفي الملام فأنت فيه لائمه % 2(@)(@@) % عريت نفسي عن مطالب جمة % ورضيت من حظي بنفس سالمه % 3(@)(@@) % ورأيت أحوالا تحول وشيكة % لمعا وتخييلا كحلم الحالمه % 4(@)(@@) % لا تعجبنك أن تنالي رتبة % غبطت بها عصب وراحت نادمه % 5(@)(@@) % وتأملي دولا تزول بأهلها % % كانت مشاهدة فصارت عادمه % 6(@)(@@) % في أم موسى سلوة لك فانظري % % فعل الزمان بها وبفاطمه % 7(@)(@@) % وضعتهما بإزاء ما رفعتهما % % تلك العلا ورمتهما بالقاصمه % 8(@)(@@) % عقبى النباهة لحظة مثنية % من عين دهرك فاتركيها نائمه % 9(@)(@@) % لا تشربي ريا بكأس حظوظه % فأراك بعد على الموارد حائمه % 10(@)(@@) % وإذا افتتاح الأمر راقك حسنه % فتبيني ماذا تكون الخاتمه % PageV01P432 11(@)(@@) % يارب أفئدة بنار همومها % % تكوى فتشقى في جسوم ناعمه % 12(@)(@@) % ومضلل في الجيش يلعب خيفة % ومقيد متقلب في ظارمه % 13(@)(@@) % بانوا لكف الدهر فاختلستهم % هل تجتنى الزهرات إلا ناجمه % 14(@)(@@) % إن الخوافي يختفين وإنما % % قصد الزمان من الجناح القادمه % PageV01P433 البحر : رجز تام 1(@)(@@) % الم خطب فادح الإلمام % من الخطوب الجلة العظام % 2(@)(@@) % والعين تذري الدمع بانسجام % مقرووحة أجفانها دوامي % % 3(@)(@@) % مفجوعة بلذة المنام % والوجد في الأحشاء ذو اضطرام % 4(@)(@@) % لما خبا نجم بني بسطام % على المعالي وعلى الأنام % 5(@)(@@) % والعلم المولى على الإعلام % والسيد ابن السيد القمقام % 6(@)(@@) % وجمع الفيء على الإمام % ومعمل السيوف للأقلام % 7(@)(@@) % فالحل والعقد بلا تمام % والآمر والنهي بلا نظام % 8(@)(@@) % والنور في اللآفاق كالظلام % والثغر مثغور لغير حام % 9(@)(@@) % يشكو إلى السنان والصمصام % فقد أتى قاسمة الهمام % 10(@)(@@) % كالمال للعافين والأيتام % لله ما غيبت في الرجام % PageV01P434 11(@)(@@) % وضمن التابوت من حسام % عضب وجيش جحفل كهام % 12(@)(@@) % وقمر لليلة التمام % وبحر جود بالنوال طامي % % 13(@)(@@) % وحجج الديوان والأحكام % وفارس ومصر الشآم % 14(@)(@@) % أم من يرد الخصم بالإفحام % بفاصل يشفي من السقام % 15(@)(@@) % غال الردى كنانة الإسلام % وأقدم الموت على الأقدام % 16(@)(@@) % فاستأثر الحمام بالحمام % والدهر 
ms86	 للأخيار ذو اخترام % 17(@)(@@) % يبدأ بالكاهل والسنام % فاسلم أبا عيسى على الأيام % 18(@)(@@) % فأنت نعم خلف الأقوام % من الخؤول الغر والأعمام % 19(@)(@@) % وحسبنا أنت من الكرام % % PageV01P435 البحر : متقارب تام 1(@)(@@) % وكنت أحارب صرف الزما % % ن أيام أعينه نائمه % 2(@)(@@) % فلما تيقظ سالمته % ومن خاف سطوته سالمه % 3(@)(@@) % وقد كنت أسرع في قمرة % فقد صرت أقنع بالقائمه % PageV01P436 البحر : طويل 1(@)(@@) % أخوك الذي إن أفسد الدهر وده % تلطف لاستصلاحه فتقوما % % 2(@)(@@) % ولم يحتفل مستأنفا ود صاحب % لعلك تلقاه أعق وأظلما % % 3(@)(@@) % وإن علاجي علة قد عرفتها % % أداوي الذي أودته مني لأسلما % % 4(@)(@@) % لأيسر خطبا من علاج غريبة % من السقم ما عاينتها متقدما % % PageV01P437 البحر : خفيف تام 1(@)(@@) % ويح عين لم ترو من ماء وجه % قد سقاه الشباب ماء نعيم % PageV01P438 البحر : سريع 1(@)(@@) % مالك موفور فما باله % أكسبك التيه على المعدم % 2(@)(@@) % ولم إذا جئت نهضنا وإن % جئنا تطاولت ولم تهتم % 3(@)(@@) % وإن خرجنا لم تقل مثلما % % نقول قدم طرفه قدم % 4(@)(@@) % ما لك سلطان فتزهى ولو % % تواضع السلطان لم يذمم % 5(@)(@@) % إن كنت ذا علم فمن ذا الذي % % مثل الذي تعلم لم يعلم % 6(@)(@@) % ولست في الغارب من دولة % ونحن من دونك في المنسم % 7(@)(@@) % إن كنت ذا حسن فلو حكمت % في ذاك مظلومة لم تظلم % 8(@)(@@) % وسترها تعلم من يشتهي % % منا وإن مالت إلى الدرهم % 9(@)(@@) % وقد ولينا وعزلنا كما % % أنت فلم نصغر ولم نعظم % 10(@)(@@) % تكافات أحوالنا كلها % % فصل على الإنصاف أو فاصرم % PageV01P439 البحر : طويل 1(@)(@@) % سلام على الأطلال حسنى خيامها % % وهل مستطاع أن يرد سلامها % % 2(@)(@@) % تحية مشتاق أطاع دموعه % وأسعدها بين الرسوم انسجامها % % 3(@)(@@) % غدت لظليم الوحش بعد ظلومها % % وخالفها من بعد نعم نعامها % % 4(@)(@@) % فأين عيون العين والأوجه التي % % إذا لحن في الظلماء زال ظلامها % % 5(@)(@@) % نأين وفيهن التي لفراقها % % نأى عن جفون المستهام منامها % % 6(@)(@@) % معدلة الأقسام للبدر وجهها % % وللغصن منها قدها وقوامها % % 7(@)(@@) % وكم عاذل لو كان يصغى لعذله % ولائمة لو كان ينهى ملامها % % 8(@)(@@) % لحتني 
ms87	 وأربت في الكلام وأنكرت % مقامي وقالت خطة لا أسامها % % 9(@)(@@) % وقد يتقى من صولة الأسد ربضها % % ويحمد للغر الجياد جمامها % % 10(@)(@@) % أحاول أن أغدو وأتبع معشرا % أراذل تنبو عن كرام لئامها % % PageV01P440 11(@)(@@) % ويغمد محمود النصال ويهتبي % % وقد ينتضى في كل حين كهامها ك % % 12(@)(@@) % فيا ليت نفسا لا يصان مصونها % % عن الذل لاقاها وشيكا حمامها % % 13(@)(@@) % سأكرم نفسا لا يهون كريمها % % وأحرمها من أن يذل مقامها % % 14(@)(@@) % أبا حسن حسن الأمور تمامها % % وزينتها أكمالها وختامها % % 15(@)(@@) % وليس يرب العرف بعد اصطناعه % لديك من الأملاك إلا كرامها % % 16(@)(@@) % فكم لك عندي من صنيعة مجمل % وبيض أياد طوقتني جسامها % % PageV01P441 البحر : كامل تام 1(@)(@@) % ياريم كم أدنو وأنت تريم % وتنام عن ليلى وليس تنيم % 2(@)(@@) % أخلفت ميعاد المدام وقلما % % ألفيت عهدا للمدام يدوم % 3(@)(@@) % فاستأنف العهد المحيل فإنه % قد عاد بعد العهد وهو ذميم % 4(@)(@@) % قم غير مذموم القيام فإننا % % سنقيم سوق اللهو حين نقوم % 5(@)(@@) % هذا الصباح فأضحك الإبريق عن % % شمس يحف بها لدي نجوم % 6(@)(@@) % فإذا رآها الصبح في خلل الدجا % % كالجيش زنجيا غزته الروم % 7(@)(@@) % والنجم في افق الغروب كأنه % % نسر يحلق تارة ويحوم % 8(@)(@@) % والأفق أبيض والهلال كأنه % خلخال ساق خريدة مفصوم % 9(@)(@@) % والجو معطور الهواء كأنما % % يأتي بعرف المسك منه نسيم % 10(@)(@@) % ومسلط اللحظات يحسب ظالما % فإذا رنا فكأنه مظلوم % PageV01P442 11(@)(@@) % تمت محاسنه وقام لقده % في التيه إن الحسن فيه يقيم % 12(@)(@@) % يسعى بما في كفه ونظيرها % % في طرفه ورحيقها مختوم % 13(@)(@@) % راحا كأن نسيمها متولد % من نشره ومزاجها تسنيم % 14(@)(@@) % شبهان تنحسر الهموم إذا هما % % حضرا ويحسن فيهما التأثيم % 15(@)(@@) % جاءت بنكهته وجاء بلونها % % في خده فصبا إليه حليم % 16(@)(@@) % وسقى بها سقيا وأثمل مثملا % وتظلمت منه إلي ظلوم % 17(@)(@@) % وشدا لنا فنفى الأسى بمحفق % إيقاعه المحصور والمذموم % 18(@)(@@) % متجاوب الأوتار في نغماته % خنث وفي ألفاظه ترخيم % 19(@)(@@) % متوسد يسرى يديه ممهد % كالطفل إلا أنه مفطوم % 20(@)(@@) % مستعجم لا يستبين كلامه % حتى يرى في الصدر منه كلوم 
ms88	 % PageV01P443 21(@)(@@) % لا يفهم النجوى إذا خاطبته % وحديثه مستحسن مفهوم % 22(@)(@@) % فكأن كسرى فى الزجاجة سابح % في الماء يغرق تارة ويعوم % 23(@)(@@) % اشفي على تمثاله برحيقه % وكأنه لي صاحب ونديم % 24(@)(@@) % في مجلس حجب الزمان صروفه % % عنا فظل العيش فيه مقيم % 25(@)(@@) % لو لم يكدر صفوه لمغيبه % % عني أبو إسحاق إبراهيم % 26(@)(@@) % يا بدر هاشم والذي من بينهم % أضحى له التفضييل والتعظيم % 27(@)(@@) % ياروضة الأخلاق والأدب الذ % % ي فيه علوم جمة وحلوم % 28(@)(@@) % مهلا أبا إسحاق إنك ماجد % ندب ومنتخب الفروع كريم % 29(@)(@@) % وتواضع الكبراء في أخلاقهم % شرف كما أن التكبر لوم % 30(@)(@@) % والبدر جار للنجوم وآلف % والغيث يسقي النبت وهو هشيم % PageV01P444 31(@)(@@) % والمسك يخلط بالعبير وفضله % في طيبه متعارف معلوم % 32(@)(@@) % والظرف يأبى للظريف قطيعتي % % والمجد لا يرضى بها والخيم % 33(@)(@@) % بأبي وامي أنت من متشابه % لم يثنه التبجيل والتعظيم % 34(@)(@@) % لو أعرضت معشوقة عن عاشق % إعراضه عني لكان يهيم % 35(@)(@@) % كثرت حسادي فحين هجرتني % % غادرتني فكأنني المحروم % 36(@)(@@) % فاسلم ظللت بنعمة محروسة % تبقى وطرف الدهر عنك نؤوم % 37(@)(@@) % واعلم بانك ماأقمت على التي % % منها استجرت من العقوق سليم % 38(@)(@@) % لكنني سأزور إن صارمتني % % وعلى الصفاء وإن كدرت أدوم % PageV01P445 البحر : بسيط تام 1(@)(@@) % نعم المعين على الآداب والحكم % صحائف حلك الألوان كالظلم % 2(@)(@@) % لا تستمد مدادا غير صبغتها % % فسر ذي اللب فيها جد مكتتم % 3(@)(@@) % جفت وخفت فلم يدنس لحاملها % % ثوب ولم يخش فيها سورة القلم % 4(@)(@@) % وأمكن المحو فيها الكف فاتسعت % لما تضمن من نثر ومنتظم % 5(@)(@@) % حليتها بلجين وانتخبت لها % % وقاية من زكي العود لا الأدم % 6(@)(@@) % فالكم يعبق منها حين تودعه % عرفا تنسم منها الطيب بالشمم % 7(@)(@@) % لو كن ألواح موسى حين أغضبه % هارون لم يلقها خوفا من الندم % PageV01P446 البحر : كامل تام 1(@)(@@) % صينت بمرفعها الدواة فأصبحت % من شر أحوال التبدل سالمه % 2(@)(@@) % حنت عليه لأنه من جنسها % % وغدت له إدناسة متلائمه % 3(@)(@@) % فكأنه ملك على كرسيه % أو غادة فوق الأريكة نائمه % 4(@)(@@) % سوداء مجت ريقتين فريقة 
ms89	 % للملك بانية وأخرى هادمه % 5(@)(@@) % زجت دموع العابدين بدمعها % % فأنوفهم أبدا لديها راغمه % 6(@)(@@) % زنجية عجماء إلا أنها % % بجليل تبريز البرية عالمه % PageV01P447 البحر : كامل تام 1(@)(@@) % جعلت تأمل زرقة في خاتمي % % وتقول فصك ذا لباس المأتم % 2(@)(@@) % فأجبتها مذ بان وصلك وانقضى % % فبكيته بدم ودمع ساجم % 3(@)(@@) % ورغبت في لبس الحداد لأنه % لبس الحزينة والحزين الهائم % 4(@)(@@) % وخشيت إن أنا في الشباب لبسته % أن يفطنوا فجعلته في خاتمي % % PageV01P448 البحر : منسرح 1(@)(@@) % ومستحث الأوتار من سأم % لا بغبي ولا بنمام % 2(@)(@@) % في حجر مجدولة مذكرة % غلام خلف فتات قدام % 3(@)(@@) % تلوى ملاويه وفي أناملها % % قطا وقدا بمثل أقلام % 4(@)(@@) % تعرك آذانه وتخنقه % ما بين سبابة وإبهام % 5(@)(@@) % قالت له واليمين تنطقه % عصيت فيمن هويت لوامي % % 6(@)(@@) % فقال يحذر مثال نغمتها % % وإن طال الحبيب إرغامي % % PageV01P449 البحر : كامل تام 1(@)(@@) % قد راح تحت الصبح ليل مظلم % إذ لاح في السرج المحلى الدهم % 2(@)(@@) % ديباج ألوان الجياد ولم يكن % ليخص بالديباج إلا الأكرم % 3(@)(@@) % ضحك اللجين على سواد أديمه % وكذا الظلام تبين فيه الأنجم % 4(@)(@@) % فكأنه ببنات نعش ملبب % وكأنما هو بالثريا ملجم % PageV01P450 البحر : منسرح 1(@)(@@) % بؤسى الليالي عقيبة النعم % وكلما غبطة إلى ندم % 2(@)(@@) % من ساورته الخطوب أقصده ال % حتف ومن أغفلته لم يرم % 3(@)(@@) % وكلماصحة إلى سقم % وكلما جدة إلى هرم % 4(@)(@@) % وللمنايا عين موكلة % بالحي لم تغتمض ولم تنم % 5(@)(@@) % % أسمع بروض يسعى على قدم % 6(@)(@@) % حل الدبابي كأن سندسه % ذرت عليه موشية العلم % 7(@)(@@) % متوجا ختلعة حباه بها % % ذو المفطر المعجزات والحكم % 8(@)(@@) % كأنه يزدجرد منتصبا % يبني فيعلي مآثر العجم % 9(@)(@@) % يطبق أجفانه ويحسر عنء % % فصين يستصحبان في الظلم % 10(@)(@@) % أدل بالحسن فاستذال له % ذيلا من الكبر غير محتشم % PageV01P451 11(@)(@@) % ثم مشى مشية العروس فمن % مستظرف معجب ومبتسم % 12(@)(@@) % بعد صحون الديار عوض من % % فسيحها ضيق هذه الرجم % 13(@)(@@) % وللردى همة يغول بها % % كل نفس وكل ذي همم % 14(@)(@@) % كأنما اللازورد نقطه % ونقط اللازورد بالعنم % 15(@)(@@) % ما أحسن الصبر في 
ms90	 البلاء وما % % أجمله عصمة لمعتصم % PageV01P452 البحر : خفيف تام 1(@)(@@) % قد عزمنا على مباكرة الشر % % ب ولكن ما عندنا من طعام % % 2(@)(@@) % غير ما راج من رقاق هنيء % مع هام على عداد الهام % 3(@)(@@) % تلك كالماء ذي الحباب وهاتي % % ك عليه كطير ماء نيام % 4(@)(@@) % يا لإقبالهن أول ما يقبل % ن في جاحم شديد الضرام % 5(@)(@@) % كأناس توسخوا بالمنادي % % ل وقد أخرجوا من الحمام % 6(@)(@@) % يمتطين الحوار أرؤس خرقا % % ن وينزلن عنه بيض نغام % 7(@)(@@) % ولدينا ما تشتهي بعد هذا % % من غناء ينسي غناء الحمام % 8(@)(@@) % ثم من نرجس بصير واعمى % ونبيذ محلل وحرام % 9(@)(@@) % من غلام في زيه كفتاة % وفتاة في زيها كغلام % 10(@)(@@) % يرميان الأسى بسهم سرور % مستعار من بين رطل وجام % PageV01P453 11(@)(@@) % فأطع أمرنا نطعك وإلا % فاعص إن شئت أمرنا بسلام % PageV01P454 البحر : خفيف تام 1(@)(@@) % قد أتانا الذي بعثت إلينا % % وهو شيء في وقتنا معدوم % 2(@)(@@) % طلعة غضة أتتنا تحاكي % % سفطا فيه لؤلؤ منظوم % 3(@)(@@) % وكثير ما قل عندك عندي % % إذ حباني بها رئيس عظيم % 4(@)(@@) % ما جواد من جاد بالمال لكن % المواسي هو الجواد الكريم % PageV01P455 البحر : وافر تام 1(@)(@@) % تقول وعانقتني يوم برد % وما إن عانقت غير السقام % 2(@)(@@) % أجسمك ذا خيال زار جسمي % % فقلت نعم ووصلك كالمنام % PageV01P456 البحر : رمل تام 1(@)(@@) % باكر الصبحة هذا % % يوم عيد ومدام % 2(@)(@@) % ما ترى بالله ما % % أحسن آداب الغمام % 3(@)(@@) % بدأ القطر بطل % ثم ثنى برهام % 4(@)(@@) % وانجلى مثل انجلاء ال % % غمد من متن الحسام % 5(@)(@@) % كافتتاح حسن زين % ه حسن اختتام % 6(@)(@@) % مشتملا مثل أفعا % % لك في حسن النظام % 7(@)(@@) % فاشرب الراح بأرطا % % ل وطاسات وجام % 8(@)(@@) % إنما الدنيا كوهم % أو كأحلام منام % 9(@)(@@) % لا ترومن بعيدا % وارض بالأمر الموام % 10(@)(@@) % لا تدع وسطى من ال % % حال لأحوال جسام % PageV01P457 11(@)(@@) % كل شيء يتوقى % % نقصه عند التمام % PageV01P458 البحر : طويل 1(@)(@@) % فما أنسه لا أنس منه إشارة % بسبابة اليمنى على خاتم الفم % 2(@)(@@) % وأعلنت بالشكوى إليها فاعلنت % حذارا من الواشين لا 
ms91	 تتكلم % 3(@)(@@) % فلم أر شكلا واقعا فوق شكله % كعنابة تومي بها فوق عندم % PageV01P459 البحر : كامل تام 1(@)(@@) % ومهذب الألفاظ منطقه % ما فيه من خطل ومن مين % 2(@)(@@) % ما شئت من ظرف ومن شيم % جلت محاسنهن عن شين % 3(@)(@@) % قد قلت حين تكاملت وعلت % أفعاله زينا من الزين % 4(@)(@@) % ما كان أحوج ذا الكمال إلى % % عيب يوقيه من العين % PageV01P460 البحر : منسرح 1(@)(@@) % ما أرتضي عنك بالرياض غنى % % عنهن لي منظر وطيب جنا % % 2(@)(@@) % قالوا تروح غلى الجنان وما % % يدرون ما في الديار منك لنا % % 3(@)(@@) % أدير طرفي فلا أرى حسنا % إلا أرى فيك ذلك الحسنا % % 4(@)(@@) % بي منك ما لو وزنت أكثره % بما على الأرض كلها وزنا % % 5(@)(@@) % لو قيل لي من أحسن الأنام ومن % أعشقهم قلت هذه وأنا % % PageV01P461 البحر : كامل تام 1(@)(@@) % بأبي أقيك من الحوادث والردى % % يا عود بل من طارق الحدثان % 2(@)(@@) % فجعت به عودا يئن كأنه % صبان مهجوران يشتكيان % 3(@)(@@) % هزجا قوام لسانه في أذنه % يا من رأى أذنا قوام لسان % 4(@)(@@) % وكأن موقع زيره زيران % وكأنه عودان يصطحبان % 5(@)(@@) % ومخفف الأجزاء ليس لجرمه % وزن يميل كفة الميزان % 6(@)(@@) % وكأن مقبضه جبيرة ساعد % قد فصلت بالدر والمرجان % 7(@)(@@) % في صدره من نقبه عينان % وبنحره طوق من الدستان % 8(@)(@@) % لا غرو سيدة القيان فأنسنا % % يبقى ويهلك سيد العيدان % PageV01P462 البحر : رمل تام 1(@)(@@) % قد وفينا لك بالوع % % د وكان الوعد دينا % % 2(@)(@@) % وحكمنا لك بالإي % % ثار بالحظ علينا % % 3(@)(@@) % ببديع ما رأينا % % مثله فبما رأينا % % 4(@)(@@) % فيه للحسن مياه % لو تصوبن جرينا % % 5(@)(@@) % فهو لو يكرع ذود % فيه يوما لارتوينا % % 6(@)(@@) % أو جرى لانبجست من % % ه اثنتا عشرة عينا % % 7(@)(@@) % زينه يهدى إلى ك % ف فتى زادته زينا % % PageV01P463 البحر : بسيط تام 1(@)(@@) % ياقاتل الله كتاب الدواوين % ما يستحلون من سرق السكاكين % 2(@)(@@) % لقد دهاني لطيف منهم ختل % في ذات حد كحد السيف مسنون % 3(@)(@@) % فابتزنيها ولم يشعر به عبثا % ولست لو ساءني ظن بمغبون % 4(@)(@@) % واقفرت بعد عمران بموقعها 
ms92	 % % منها دواة فتى بالكتب مفتون % 5(@)(@@) % تبكي على مديه أودى الزمان بها % % كانت على جائز الأقلام تعديني % % 6(@)(@@) % كانت تقزم أقلامي وتنحتها % % نحتا وتسخطها قطا فترضيني % % 7(@)(@@) % فأضحك الطرس والقرطاس عن حلل % تنوب للعين عن نور البساتين % 8(@)(@@) % إذا بشرت بها سوداء من صحفي % % عادت كبعض خدود الخرد العين % 9(@)(@@) % جزع النصاب لطيفات شعائرها % % محسنات بأصناف التحاسين % 10(@)(@@) % هيفاء مرهفة بيضاء مذهبة % قال الإله لها سبحانه كوني % % PageV01P464 11(@)(@@) % محفوظة الوسط تحكي في تخصرها % % خصر البديع بديع في الحضانين % 12(@)(@@) % كأنها حين يشجيني تذكرها % % في القلب مني وفي الأحشاء تفريني % % 13(@)(@@) % لكن مقطي أمسى شامتا جذلا % وكان في ذلة منها وفي هون % 14(@)(@@) % فصين حتى يضاهي في صيانته % جاهي لصونيه عما لا يدانيني % % 15(@)(@@) % ولو يريد فداء ما جعلت به % منها فديناه بالدنيا وبالدين % 16(@)(@@) % فلست عنها بسال ما حييت ولا % % بواجد عوضا منها بسكين % PageV01P465 البحر : متقارب تام 1(@)(@@) % ولما عبثن باوتارهن % قبيل التبلج يقظنني % % 2(@)(@@) % جسسن مثالث يمزجنها % % بنقر النموم فأطربنني % % 3(@)(@@) % عمدن لإصلاح أوتارهن % فأصلحنني ثم أنشدنني % % PageV01P466 البحر : بسيط تام 1(@)(@@) % سئمت من كل شيىء كان يعجبني % % إلا سماعي أحاديث المحبينا % % 2(@)(@@) % إذا شكا بعضهم وجدا بكيت له % وإن دعا قلت بالإخلاص آمينا % % 3(@)(@@) % ما ذاك إلا لأني قد لقيت كما % % لاقوا وكابدت ما قد كابدوا حينا % % 4(@)(@@) % لكنني لم يكن لي من يساعدني % % وها أنا مسعد من كان محزونا % % PageV01P467 البحر : خفيف تام 1(@)(@@) % شارفتنا طلائع المهرجان % مخبرات بطيب فضل الزمان % 2(@)(@@) % والهدايا في المهرجان حديثا % وقديما من سنة الدهقان % 3(@)(@@) % وتفكرت في الهدايا وفيما % % بعث الفكر من لطيف المعاني % % 4(@)(@@) % فرأيت الأشياء تقصر عن وج % % ه علا أن يرى له من مداني % % 5(@)(@@) % فبعثت الذي ترى منه فيه % كل ما قد نراه في البستان % 6(@)(@@) % بمراة إلى مراة تهادى ال % % حسن فيه ومنه مرآتان % 7(@)(@@) % أخت شمس الضحاء في الشكل وإلا % % شراق غير الإعشاء للأجفان % 8(@)(@@) % جونة الصقل فضلها في المرايا % % فضل أذهانكم على الأذهان % 9(@)(@@) % خط منها 
ms93	 شكل المدور قدا % واعتدالا إقليدس اليوناني % % 10(@)(@@) % ذات طوق مشرق من لجين % أجريت فيه صفرة العقبان % PageV01P468 11(@)(@@) % فهي كالهالة المحيطة بالبد % ر لست مضين بعد ثمان % 12(@)(@@) % ورثت عن متوجين وأدا % % ها إلينا تعاقب الأزمان % 13(@)(@@) % وعلى ظهرها فوراس تلهو % % ببزاة تعدو على غزلان % 14(@)(@@) % لك فيها إذا تأملت حسن % مخبر فضله بنيل الأماني % % 15(@)(@@) % خسروا نية المناسب إلا % أنها في نصاب جزع يماني % % 16(@)(@@) % خط فيها مثال كسرى كما م % % ثل كسرى أباك في التيجان % 17(@)(@@) % وتريك المكان فيها وإن كنت ت % راها ومثلها في المكان % 18(@)(@@) % لم يكن قبلها من الماء جرم % حاضر نفسه لغير أوان % 19(@)(@@) % عدلت عكسها الشعاع فمبدا % % ه إلينا ورجعه سيان % 20(@)(@@) % هي دنيا با تفاءلت إلا % أنها خلوة من الأحزان % PageV01P469 21(@)(@@) % وهي شمس فإن مثالك يوما % لاح فيها فأنتما شمسان % 22(@)(@@) % أينما قابلت مثالك من أر % % ض ففيها تقابل النيران % 23(@)(@@) % فالقها منك بالذي ما رآه % خائف فانثنى بغير أمان % 24(@)(@@) % وعلى المصطفى فضل فقد ي % % شرف فضل العيون بالأعيان % PageV01P470 البحر : مجزوء الوافر 1(@)(@@) % ومغن بارد الن % غمة مختل اليدين % 2(@)(@@) % ما رآه أحد في % % دار قوم مرتين % 3(@)(@@) % قربه أقطع للذا % % ت من صحبة بين % PageV01P471 البحر : متقارب تام 1(@)(@@) % أخ كان مني في قربه % بحيث بنان يدي من بناني % % 2(@)(@@) % وكنا كأحسن لفظ امرىء % يؤلفه في بديع المعاني % % 3(@)(@@) % يروح ويغدوا على حاله % سواء كما ألف الثناني % % 4(@)(@@) % إذا غبت مثلني شخصه % ومن يره فكأن قد رآني % % 5(@)(@@) % وكنت على الدهر أسطو به % فدبت إليه صروف الزمان % 6(@)(@@) % فلم يبق منه سوى ذكره % وذكر الحبيب كبعض العيان % PageV01P472 البحر : متقارب تام 1(@)(@@) % عذيري من صرف هذا الزمن % رماني فأقصدني بالمحن % 2(@)(@@) % كثير النوائب جم الخطوب % قديم الترات شديد الإحن % 3(@)(@@) % بخيل علي بعهد الشباب % يهدم ديوانه بالحزن % 4(@)(@@) % وينفض مورق أغصانه % فيذوي وقد كان نضر الغصن % 5(@)(@@) % ويصرف عني وجوه الحسان % وقد كن يخلعن في الرسن % 6(@)(@@) % كأن الزمان فتى عاشق % وأني أعارضه 
ms94	 في سكن % 7(@)(@@) % فشمل يشتت من نظمه % ودار يباعدها من وطن % 8(@)(@@) % وعين يوكلها بالبكاء % وأخرى مفجعة بالوسن % 9(@)(@@) % أعاتب دهري والدهر عن % % عتاب الأديب أصم الأذن % 10(@)(@@) % فطورا أهون إذا عزني % % وطورا ألين له إن خشن % PageV01P473 11(@)(@@) % وإن شام سيفا من الحادثات % جعلت له القبر دوني مجن % 12(@)(@@) % وما خانني الدهر لكنني % % أرى رأيه في عين الأفن % 13(@)(@@) % سأشكو الزمان فقد مسني % % بنصب إلى الحسن بن الحسن % 14(@)(@@) % كريم إذا ما اعتصمنا به % لجأنا إلى محصنات الجنن % 15(@)(@@) % وإن امسك الغيث جادت لنا % % سحائب من راحتيه هتن % 16(@)(@@) % فتى عشق المجد حتى غدا % % به وهو صب به مفتتن % 17(@)(@@) % سليل الأكابر سنوا العلا % % فأكرم بها وبهم من سنن % 18(@)(@@) % هم أثبتوا الملك في اسه % وشادوا دعائمه والركن % 19(@)(@@) % وبين الأنامل في كفه % فصيح يخبر عما يجن % 20(@)(@@) % إذا ما بكى في قراطيسه % ضحكن من الروض في كل فن % PageV01P474 21(@)(@@) % وينهر كالطل من راحتيه % فيفعل في الأرض فعل المزن % 22(@)(@@) % وفاق إياسا بفضل الذكاء % وقس بن ساعدة في اللسن % 23(@)(@@) % مقيم وأفعاله سير % وثاو وتدبيره قد ظعن % 24(@)(@@) % وكم من رهين به مطلق % وكم من طليق به مرتهن % 25(@)(@@) % ولولا افتتاح المعالي به % كما افتتحت بالسيوف المدن % 26(@)(@@) % إليك ثنيت عنان الرجاء % بامن رجاء على حسن ظن % 27(@)(@@) % ولي خدمة يكشف الإمتحا % % ن عنها فتحمد ما تمتحن % 28(@)(@@) % وموشي خط أضاء به % غرائب موشي نسج اليمن % 29(@)(@@) % منثور لفظ كمعروفك ال % % جميل الذي لم يكدر بمن % 30(@)(@@) % قنوع على أن لي همة % تناط النجوم بها في قرن % PageV01P475 31(@)(@@) % وأنسى السرائر حتى تكو % % ن عندي سواء وما لم يكنء % % 32(@)(@@) % وضعت الصنيعة في حقها % % فأحرزت عندي زكي المنن % 33(@)(@@) % وأنت إذا شئت أن تصطفي % % نصيحا وأن تجتبي مؤتمن % PageV01P476 البحر : هزج 1(@)(@@) % متى تنشط للأكل % فقد كللت الجونه % 2(@)(@@) % وقد زينته الطاهي % % لنا أحسن تزيينه % 3(@)(@@) % كما زين صوب الغي % % ث في الروض أفانينه % 4(@)(@@) % فجاءت وهي من أطي % % ب ما يؤكل 
ms95	 مشحونه % 5(@)(@@) % فمن جدي شهي قد % % أردنا لك تحسينه % 6(@)(@@) % فنضرنا عليه نع % % نع البقل وطرخونه % 7(@)(@@) % وفرخ وافر الزور % أجدنا لك تسمينه % 8(@)(@@) % وطيهوج وفروج % أجدنا لك تطحينه % 9(@)(@@) % وسبوجة مقلو % ة في إثر طروينه % 10(@)(@@) % وحمراء من البيض % إلى جانب زيتونه % PageV01P477 11(@)(@@) % وطع كنظام ال % % در في الأسفاط مكنونه % 12(@)(@@) % برغف ككسور ال % % در بالعنبر معجونه % 13(@)(@@) % وحريف من الجبن % به الأوساط مقرونه % 14(@)(@@) % وباذنجان داراني % % به نفسك مفتونه % 15(@)(@@) % وهليون وعهدي ب % % ك تستعذب هليونه % 16(@)(@@) % ولوزينجة في الدهن % وفي السكر مدفونه % 17(@)(@@) % وعندي لك دستيجة % مطبوخ وقنينه % 18(@)(@@) % وساق وعدت بالقط % % ف منه عطفة النونه % 19(@)(@@) % له شدة ألحاظ % وفي ألفاظه لينه % 20(@)(@@) % وقمري يغنينا % % لحونا غير ملحونه % PageV01P478 21(@)(@@) % ألا يأنى لمحزون % نأى عن دار محزونه % 22(@)(@@) % فما عذرك في أن لا % % ترى من سكر طينه % PageV01P479 البحر : سريع 1(@)(@@) % أي حراك غال منك السكون % ونار كيس أطفأتها المنون % 2(@)(@@) % يا بشر إن تود فكل أمرىء % بمثلما صرت إليه رهين % 3(@)(@@) % أو تمس غصنا في الثرى ذاويا % فقد ذوت قبلكض فيه غصون % 4(@)(@@) % أو يبل من خسنك ريعانه % فهكذا تنمي وتبلى القرون % 5(@)(@@) % وليس مملوك ولا مالك % بخالد كل بموت رهين % 6(@)(@@) % من لدواة كنت تعنى بها % % عناية تعجز عنها القيون % 7(@)(@@) % أم من لحاجات إذا ما مضى % % فيها مضى وهو لنجح ضمين % 8(@)(@@) % أم من لكتب كنت في طيها % % أسرع مما تمتلي في الجفون % 9(@)(@@) % أم من لتذليل صعاب إذا % % باشرها سهل منها الحرون % 10(@)(@@) % أم من لكاس ولدا مشيه % % فيها له من كل فن فنون % PageV01P480 11(@)(@@) % يطوي الطواير بلا كلفة % واللصق في الإلصاق لا يستبين % 12(@)(@@) % ظبي كناس يزنيه الردى % % والليث لا يدفع عنه العرين % 13(@)(@@) % وجه على الباب إذا أمه % % رزق وللكوكب حصن حصين % 14(@)(@@) % يميز الناس بتمييزه % % منازل فيها شريف ودون % 15(@)(@@) % طاهي قدور طيب كفه % % مذاقها فالغث فيها سمين % 16(@)(@@) % يرمي إلى المفصل سكينه % فقبل أن تقرب منه يبين % 17(@)(@@) % يا ناصحي 
ms96	 إذ ليس لي ناصح % ويا أميني إذ يخون الأمين % 18(@)(@@) % لما دفناك رجعنا وفي الأح % % شاء من فقدك داء دفين % 19(@)(@@) % أمتعتني حيا وآجرتني % % ميتا فحظي منك دنيا ودين % 20(@)(@@) % كنت لأسراري فأصبحت قد % % أبيح من سري حماه المصون % PageV01P481 21(@)(@@) % وكنت لي أنسا فلا أنس لي % % وكنت عونا فبمن ستعين % 22(@)(@@) % إن تخلف الآمال في عمره % فلا تكن تخلف فيه الظنون % 23(@)(@@) % تغدوا مع الكتاب غلمانهم % ووأعتدي وحدي وما لي قرين % 24(@)(@@) % ولو أشا اعتضت ولكن ما % % يعتاض إلا تاجر أو خؤون % 25(@)(@@) % فاترة ألحاظه طالما % % جرد من ذاك الفتور العيون % 26(@)(@@) % منقادة للموت أعضاؤوه % يضعف أن يسمع فيه الأنين % 27(@)(@@) % اسأله وهو على ما به % مقنع لقولي ومجيب مبين % 28(@)(@@) % يذبل شيئا بعد شيء كما % % يذبل بعد النظرة الياسمين % 29(@)(@@) % يا موت أخليت مكان الذي % % له مكان من فؤادي مكين % 30(@)(@@) % يا موت لو غيرك أودى به % ما كنت أستجدي ولا أستكين % PageV01P482 31(@)(@@) % ما زال بشري لينا بشره % متبعا حتى أتاه اليقين % 32(@)(@@) % فالدمع جار والأسى في الحشا % % ثاو وقلبي مستطار حزين % 33(@)(@@) % عين أصابته فلا متعة % والعين لا تفضل عنها الع يون % 34(@)(@@) % فكيف حالي بعد من هذه % صفات من الخير فيه تكون % PageV01P483 البحر : هزج 1(@)(@@) % أناس أعرضوا عنا % % بلا جرم ولا معنى % % 2(@)(@@) % أساؤوا ظنهم فينا % % فهلا أحسنوا الظنا % % 3(@)(@@) % و خلونا ولو شاؤوا % % لعادوا كالذي كنا % % 4(@)(@@) % فإن عادوا لنا عدنا % % وإن خانوا لما خنا % % 5(@)(@@) % وإن كانوا قد استغنوا % % فإنا عنهم أغنى % % PageV01P484 البحر : خفيف تام 1(@)(@@) % أنا أفدي من ليس أعرف تيها % ودلالا في أي شيء رضاه % 2(@)(@@) % غائب ليس يترك الحب قلبي % % يتسلى عنه جعلت فداه % 3(@)(@@) % كلما قال لي رضائي في ه % % ذا فثرته أراد سواه % 4(@)(@@) % فأنا الدهر وهو يطلب ما غا % % ب عيانا فليس يعرف ما هو % % PageV01P485 البحر : بسيط تام 1(@)(@@) % جاءت فاكبرها طرفي فقمت لها % % وقد يقوم لأتباعي مواليها % % 2(@)(@@) % ثم استهلت فغنت وهي محسنة % من بعض أبيات شعر قلته 
ms97	 فيها % % 3(@)(@@) % فأحسنت فأصابت في صناعتها % % وما أخلت بمعنى من معانيها % % 4(@)(@@) % هي الشبيبة تطويني وأنشرها % % عند الفتاة فترضيني وأرضيها % % 5(@)(@@) % تهوى مناجاتها نفسي ويقنعها % % بعض العناق بعض اللثم يكفيها % % 6(@)(@@) % ولا أهم بشيء غير ذاك بلى % % استغفر الله مص الريق من فيها % % 7(@)(@@) % غصني نضير وأخلاقي محببة % إلى القيان رقيقات حواشيها % % 8(@)(@@) % كم من حديث قصير لي أصيد به % قلب الفتاة وأشعار أسديها % % 9(@)(@@) % تود كل فتاة حين تسمعها % % أني بها دون خلق الله أعنيها % % 10(@)(@@) % فكيف أخشى صدود الغانيات وقد % أخذت عهد أمان من تجنيها % % PageV01P486 البحر : بسيط تام 1(@)(@@) % لنا شرايح من ظبي قنصناه % وعند طباخنا جدي قرضناه % 2(@)(@@) % وراحنا بنت أعوام وزامرنا % % بدر وقينتنا الحسناء ثنياه % 3(@)(@@) % فكن جوابي ولا تركن إلى عذر % فإن كنت إلى شيء أبيناه % 4(@)(@@) % وقد تيقنت أني ما التمست أخا % مساعدا قط إلا كنت إياه % PageV01P487 البحر : كامل تام 1(@)(@@) % سقيا لها ولظرف من سماها % % فلقد أصاب بلطفه معناها % % 2(@)(@@) % قال العواذل من عشقت فقلت من % نصف اسمها وصف لمن يهواها % % PageV01P488 البحر : متقارب تام 1(@)(@@) % رأيت الرياسة مقرونة % بلبس التكبر والنخوه % 2(@)(@@) % إذا ما تقمصها لابس % ترفع في الجهر والخلوه % 3(@)(@@) % ويقعد عن حق إخوانه % ويطمع أن يهرعوا نحوه % 4(@)(@@) % وينقصهم من جميل الدعاء % ويأمل عندهم الحظوه % 5(@)(@@) % ولست بآت له منزلا % ولو أنه يسكن المروه % PageV01P489 البحر : كامل تام 1(@)(@@) % ولقد كتمت هواك أصدق صاحب % عندي مخافة أن يعود عدوا % % 2(@)(@@) % حذرا عليك وأنت موضع ضنة % لا زلت فيك مسلما مكلوا % % 3(@)(@@) % لا نال قلبي من وصالك سؤله % إن كان قلبي رام عنك سلوا % % PageV01P490 البحر : وافر تام 1(@)(@@) % فما وحشية أدماء ترعى % % أغن كعطفة الخلخال ضاوي % % 2(@)(@@) % فأغفت ساعة عنه فأضحى % % حشاه بنبله غرثان طاوي % % 3(@)(@@) % فباتت من تحرقها عليه % بداء ما لها منه مداوي % % 4(@)(@@) % تثير تراب مصرعه بقرن % أجم كأنه بعض الملاوي % % 5(@)(@@) % بأجزع منك يوم يقول خلي % % أفي الغادين أنت أم انت ثاوي % % PageV01P491 البحر : طويل 1(@)(@@) % أخي بل رئيسي بل 
ms98	 أميري وسيدي % % ومن لم يزل للفضل والبر مأمولا % % 2(@)(@@) % أغثنا فإنا قد ظمئنا ورونا % % من الرائق المطبوخ وليك معسولا % % 3(@)(@@) % فنحن بحال لو ترانا لخلتنا % % لئاما وإن كنا كراما بها ليلا % % 4(@)(@@) % ستارتنا مهجورة لكؤوسنا % % تعلل بالنذر الصبابة تعليلا % % 5(@)(@@) % ترى ماءها أضعاف جزء رحيقها % % فتحسبها فوق الأكف قناديلا % % 6(@)(@@) % وحدثنا الساقي شراء شرابه % وقد قيل في الساقي المحدث ما قيلا % % PageV01P492 البحر : منسرح 1(@)(@@) % يا حبذا يومنا ونحن على % % رؤوسنا نعقد الأكاليلا % % 2(@)(@@) % في جنة ذللت لقاطفها % % قطوفها الدانيات تذليلا % % 3(@)(@@) % كأن أترجها يميل به % أغصانه حاملا ومحمولا % % 4(@)(@@) % سلاسل من زبرجد حملت % من ذهب أصفر قناديلا % % PageV01P493 البحر : كامل تام 1(@)(@@) % عندي معتقة كودك صافيه % ونديمك الدمث الرقيق الحاشيه % 2(@)(@@) % فإذا طربت إلى السماع ترنمت % بيضاء ذاهبة تسمى داهيه % 3(@)(@@) % يصل الغناء يمينها بشمالها % % لمثلث أضلاعه متساويه % 4(@)(@@) % وتحبها سوداء تعمل نأيها % % فتريك كافورا يقاوم غاليه % 5(@)(@@) % فاحضر فقد حضر السرور ولا تدع % يوما يفوتك فهي دنيا فانيه % PageV01P494 
