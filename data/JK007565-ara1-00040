ms21	 % % تشرب أكوابها قياما % % PageV01P102 البحر : طويل 1(@)(@@) % ألا نسخ الله القطار حجارة % تصوب علينا والغمام غموما % % 2(@)(@@) % وكانت سماء الله لا تمطر الحصى % % ليالي كنا لا نطيش حلوما % % 3(@)(@@) % فلما تحولنا عفاريت شرة % تحول شؤبوب السماء رجوما % % PageV01P103 البحر : طويل 1(@)(@@) % لك الله من سار إلي مسلم % فناب وراء الليل عن أم سالم % 2(@)(@@) % يجول به ماء النضارة والندى % % كما جال ماء البشر في وجه قادم % 3(@)(@@) % تنفس يهدي ، عن حبيب ، تحية ، % هززنا لها ، زهوا ، فضول العمائم % 4(@)(@@) % يذكرنا ريا الأحبة نفحة ، % فنذكره بالدمع سقيا الغمائم % PageV01P104 البحر : بسيط تام 1(@)(@@) % يا جامعا بمساوية وطلعته % بين السوادين : من ظلم ومن ظلم % 2(@)(@@) % أمثله جسدا في مثله حسدا % لقد تألف بين النار والفحم % PageV01P105 البحر : كامل تام 1(@)(@@) % وأغر يسفر ، للعوالي والعلى ، % عن حر وجه بالحياء ملثم % 2(@)(@@) % يسري فيمسح للدجى عن صفحة % غراء ، تصدع كل ليل مظلم % 3(@)(@@) % جذلان تحسب وجهه متهللا % في هبوة الهيجاء ، غرة أدهم % 4(@)(@@) % زر الحديد عليه جيب حمامة % ورقاء في غبش العجاج الأقنم % 5(@)(@@) % فكأن جلدة حية خلعت به ، % يوم الككريهة فوق عطفي ضيغم % PageV01P106 البحر : كامل تام 1(@)(@@) % و مقنع بخلا بنضرة حسنه % أمسى هلالا وهو بدر تمام % 2(@)(@@) % قبلت منه أقحوانة مبسم % رقت وراء كمامة لثمام % 3(@)(@@) % ولثمت حمرة وجنة تندى حيا % فكرعت في برد بها وسلام % 4(@)(@@) % وبكل مرقبة مناخ غمامة ، % مثل الضريب بها لحاح لغام % 5(@)(@@) % رعدت فرجعت الرغاء مطية % لم تدر غير البرق خفق زمام % 6(@)(@@) % أوحت هناك إلى الربى : أن بشري % % بالري فرع أراكة وبشام % 7(@)(@@) % و كفى بلمح البرق غمزة حاجب % و بصوت ذاك الرعد رجع كلام % 8(@)(@@) % في ليلة خصرت صباها ، فاصطلى % % فيها أخو التقوى بنار مدام % 9(@)(@@) % و أحم مسود الأديم كأنما % % خلعت على عطفيه جلدة حام % 10(@)(@@) % ذاكي لسان النار ، بحسب أنه % برق ، تمزق عنه جيب غمام % PageV01P107 11(@)(@@) % فكأن بدء النار ، في أطرافه ، % شفق لوى يده بذيل ظلام % PageV01P108 البحر : متقارب تام 1(@)(@@) % بما حزته من شريف النظام ، % و أرهقته من 
ms22	 حواشي الكلام % 2(@)(@@) % تعال إلى الأنس في مجلس % يهز به الشيخ عطفي غلام % 3(@)(@@) % صقيل تخال به بيضة ، % تروقك تحت جناح الظلام % 4(@)(@@) % رطيب النسيم كأن الصبا % % تجرر فيه ذيول الغمام % 5(@)(@@) % يكاد سرورا بأضيافه % يهش فيلقاهم بالسلام % 6(@)(@@) % و عندي لمثلك من خاطب % بنات الحمام وأم المدام % 7(@)(@@) % بنات تنافس فيها الملوك % وتلهو العذارى بها في الخيام % 8(@)(@@) % فقد كدن يلقطن حب القلوب % ويشربن ماء عيون الكرام % 9(@)(@@) % و صفراء طلقت بنتا لها % % و ما للكريم ومأتى الحرام % 10(@)(@@) % أمص مراشفها لوعة ، % وأذكر ما بيننا من ذمام % PageV01P109 11(@)(@@) % فعج تتصفح بديع البديع ، % وتلمح سلامة شعر السلامي % % 12(@)(@@) % وعش تتثنى انثناء القضيب % سرورا ، وتسجع سجع الحمام % 13(@)(@@) % ويحمل ثوبك خطيه ، % و ينطق عنك لسان الحسام % PageV01P110 البحر : منسرح 1(@)(@@) % قل للقبيح الفعال : يا حسنا % % ملأت جفني ظلمة وسنا % % 2(@)(@@) % قاسمني طرفك الضنى ، أفلا % % قاسم ، جفني ، ذلك الوسنا ؟ % 3(@)(@@) % إني وإن كنت هضبة ، جلدا ، % أهتز للحسن لوعة غصنا % % 4(@)(@@) % قسوت بأسا ولنت مكرمة ، % لم ألتزم حالة ولا سننا % % 5(@)(@@) % لست أحب الجمود في رجل ، % تحسبه من جموده وثنا % % 6(@)(@@) % لم يكحل السهد جفنه كلفا ، % ولا طوى جسمه الغرام ضنى % % 7(@)(@@) % فمن عصى داعي الهوى فقسا ، % و كان جلدا من الصفا خشنا % % 8(@)(@@) % فإنني ، والعفاف من شيمي ، % آبى الدنايا وأعشق الحسنا % % 9(@)(@@) % طورا منيب وتارة غزل % أبكي الخطايا وأندب الدمنا % % 10(@)(@@) % إذا اعترت خشية شكا فبكى % % أو انتحت راحة دنا فجنى % % PageV01P111 11(@)(@@) % كأنني غصن بانة خضل ، % تثنيه ريح الصبا هنا وهنا % % PageV01P112 البحر : طويل 1(@)(@@) % و ساق لخيل اللحظ في شأو حسنه % % جماح وللصبر الجميل جران % 2(@)(@@) % ترى للصبا نارا بخديه لم يثر % لها ، من سوادي عارضيه ، دخان % 3(@)(@@) % سقاها ، وقد لاح الهلال عشية ، % كما اعوج في درع الكمي سنان % 4(@)(@@) % عقارا نماها الكرم فهي كريمة % ولم تزن بابن المزن ، فهي حصان % 5(@)(@@) % و ضمخ ردع الشمس نحر حديقة % عليه من الطل السقيط جمان % 6(@)(@@) % و نمت بأسرار الرياض خميلة % لها النور ثغر والنسيم 
ms23	 لسان % PageV01P113 البحر : سريع 1(@)(@@) % و أسود يسبح في لجة % لا تكتم الحصباء غدرانها % % 2(@)(@@) % كأنها في شكلها مقلة % وذلك الأسود إنسانها % % PageV01P114 البحر : كامل تام 1(@)(@@) % وخميلة قد أخملت سربالها % % كفا صناع ، تستهل ، هتون % 2(@)(@@) % طوت السرى ، والبرق سوط خافق % بيد الدجى ، والريح ظهر أمون % 3(@)(@@) % بشرى تهادى في وشاح مذهب ، % قلق ، وتسحب من ذيول جون % 4(@)(@@) % طبعت على النوار بيض دراهم % مدت إليك بها بنان غصون % 5(@)(@@) % فرفلت ، حيث تعثرت بي نشوة ، % في ثوب وشي ، للربيع ، مصون % 6(@)(@@) % والأرض تسفر عن وجوه محاسن % بيض ، وتنظر عن عيون عين % PageV01P115 البحر : طويل 1(@)(@@) % فيا لشجا قلب ، من الصبر ، فارغ ، % و يا لقذى طرف من الدمع ملآن % 2(@)(@@) % و نفس إلى جو الكنيسة صبة % و قلب إلى أفق الجزيرة حنان % 3(@)(@@) % تعوضتمن واها بآه ومن هوى % % بهون ، ومن إخوان صدق بخوان % 4(@)(@@) % و ما كل بيضاء بروق بشحمة % وما كل مرعى ترتعيه بسعدان % 5(@)(@@) % فيا ليت شعري ! هل لدهري عطفة ، % فتجمع أوطاري علي وأوطاني ؟ % 6(@)(@@) % ميادين أوطاري ولذة لذتي ، % ومنشأ تهيامي وملعب غزلاني % % 7(@)(@@) % كأن لم يصلني فيه ظبي ، يقوم لي % % لماه وصدغاه براحي وريحاني % % 8(@)(@@) % فسقيا لواديهم وإن كنت إنما % % أبيت ، لذكراه ، بغلة ظمآن % 9(@)(@@) % فكم يوم لهو قد أدرنا بأفقه % نجوم كؤوس ، بين أقمار ندمان % 10(@)(@@) % و للقضب والأطيار ملهى بجرعة % فما شئت من رقص على رجع ألحان % PageV01P116 11(@)(@@) % و بالحضرة الغراء غر علقته % فأحببت حبا فيه قضبان نعمان % 12(@)(@@) % رقيق الحواشي ، في محاسن وجهه % ومنطقه مسلى قلوب وآذان % 13(@)(@@) % أغار لخديه على الورد كلما % % بدا ، ولعطفيه على أغصن البان % 14(@)(@@) % و هبني أجني ورد خد بناظري % % فمن أين لي منه بتفاح لبنان ؟ % 15(@)(@@) % يعللني منه ، بموعد رشفة ، % خيال له يغري بمطل وليان % 16(@)(@@) % حبيب عليه لجة من صوارم ، % علاها حباب من أسنة مران % 17(@)(@@) % تراءى لنا في مثل صورة يوسف % تراءى لنا في مثل ملك سليمان % 18(@)(@@) % طوى برده منها صحيفة فتنة ، % قرأنا لها ، من وجهه ، سطر عنوان % 19(@)(@@) % محبته 
ms24	 ديني ومثواه كعبتي ، % ورؤيته حجتي وذكراه قرآني % % PageV01P117 البحر : طويل 1(@)(@@) % أبشرك أم ماء يسح ، وبستان ، % وذكرك أم راح تدار ، وريحان ؟ % 2(@)(@@) % وإلا فما بالي ، وفودي أشمط ، % تلويت في بردي ، كأني نشوان ؟ % 3(@)(@@) % و هل هي إلا جملة من محاسن % تغاير أبصار عليها وآذان ؟ % 4(@)(@@) % بأمثالها من حكمة ، في بلاغة ، % تحلل أضغان ، وترحل أظعان % 5(@)(@@) % وتنظم ، في نحر المعالي ، قلادة ، % وتسحب ، في نادي المفاخر ، أردان % 6(@)(@@) % كلام كما استشرفت جيد جداية % وفصل ياقوت ، هناك ، ومرجان % 7(@)(@@) % تدفق ماء الطبع فيه تدفقا ، % فجاء كما يصفو على النار عقيان % 8(@)(@@) % أتاني يرف النور فيه نضارة ، % ويكرع منه في الغمامة ظمآن % 9(@)(@@) % وتأخذ عنه صنعة السحر بابل ، % وتلوي إليه أخدع الصب بغدان % 10(@)(@@) % و جدت به ريح الشباب لدونة % ودون صبا ريح الشبيبة أزمان % PageV01P118 11(@)(@@) % و شاق إلى تفاح لبنان نفحه % و هيهات من أرض الجزيرة لبنان % 12(@)(@@) % فهل ترد الأستاذ مني تحية % تسير كما عاطى ، الزجاجة ، ندمان % 13(@)(@@) % تهش إليها روضة الحزن سحرة % و يثني إليها حمل السريرة سوسان % PageV01P119 البحر : بسيط تام 1(@)(@@) % دن دين معتمل في الله مبتهل ، % وعد عن سر علم ، ثم ، مختزن % 2(@)(@@) % ولا تقف بطوال الكتب تسألها % % فلست تحظى بغير الهم والحزن % 3(@)(@@) % وكن ، إذا التقت الأرماح ، سافلها % % فربما اندق صدر العامل اليزني % % PageV01P120 البحر : منسرح 1(@)(@@) % رحلت عنكم ، ولي فؤاد ، % تنفض أضلاعه حنينا % % 2(@)(@@) % أجود فيكم بعلق دمع % كنت به قبلكم ضنينا % % 3(@)(@@) % يثور في وجنتي جيشا % و كان في جفنه كمينا % 4(@)(@@) % كأنني ، بعدكم ، شمال ، % قد فارقت منكم يمينا % % PageV01P121 البحر : منسرح 1(@)(@@) % يا نزهة النفس يا مناها % % يا قرة العين يا كراها % % 2(@)(@@) % أما ترى لي رضاك أهلا % و هذه حالتي تراها % % 3(@)(@@) % فاستدرك الفضل ، يا أباه ، % في رمق النفس يا أخاها % % 4(@)(@@) % قسوت قلبا ولنت عطفا ، % وعفت من تمرة نواها % % PageV01P122 البحر : رمل تام 1(@)(@@) % أي عيش ، أو غذاء ، أو سنه ، % لابن إحدى وثمانين سنه % 2(@)(@@) % قلص الشيب يه ظل امرئ % طالما جر صباهث رسنه % % 3(@)(@@) % تارة تسطو 
ms25	 به سيئة % تسخن العين أخرى حسنه % PageV01P123 البحر : مجتث 1(@)(@@) % أما لديك حلاوه ، % أما عليك طلاوة ؟ % 2(@)(@@) % طايب وداعب ولاعب ، % و دع سجايا البداوه % 3(@)(@@) % فإن أوحش شيء % جساوة في غباوه % % PageV01P124 البحر : طويل 1(@)(@@) % لقد زار من أهوى على غير موعد % فعاينت بدر التم ذاك التلاقيا % % 2(@)(@@) % و عاتبته والعتبث يحلو حديثه % و قد بلغت روحي لديه التراقيا % % 3(@)(@@) % فلما اجتمعنا قلت من فرحي به % من الشعر ، بيتا ، والدموع سواقيا % % 4(@)(@@) % و قد يجمع الله الشتيتين بعدما % % يظنان كل الظن أن لا تلاقيا % % PageV01P125 البحر : منسرح 1(@)(@@) % لله نورية المحيا ، % تحمل نارية الحميا % % 2(@)(@@) % والدوح رطب المهز لدن ، % قد رق ريا وطاب ريا % % 3(@)(@@) % تجسم النور فيه نورا ، % فكل غصن به ثريا % % PageV01P126 البحر : طويل 1(@)(@@) % أهزك لا إني إخالك نابيا % % و إن كنت مطرور الغرار يمانيا % % 2(@)(@@) % و لكن هز السيف والسوط شيمتي % % وإن رعت سباقا ونبهت ماضيا % % 3(@)(@@) % و ما هز أعطاف الكريم إلى العلى % % كأروع شيحان يهز العواليا % % 4(@)(@@) % إذا السيف لم يشرب يه الدم قانئا % عبيطا ، أبى أن يشرب الماء صاديا % % 5(@)(@@) % وقد نطت آمالي بأبلج واضح ، % يجشمها أمضى من السيف عاريا % % 6(@)(@@) % وأكرم آثارا من المزن غاديا % وأشهر أوضاحا من البدر ساريا % % 7(@)(@@) % فما الغصن المطلول أشرف باسما ، % وماد ، أصيلانا ، على الماء صافيا % % 8(@)(@@) % بألين أعطافا ، وأحسن هشة ، % وأعطر أخلاقا ، وأندى حواشيا % % PageV01P127 البحر : طويل 1(@)(@@) % كفاني شكوى أن أرى المجد شاكيا % % وحسب الرزايا أن تراني باكيا % % 2(@)(@@) % أداري فؤادا ، يصدع الصدر زفرة ، % ورجع أنين ، يحلب الدمع ساجيا % % 3(@)(@@) % و كيف أورى من أار وجدتني % % له صادرا عن منهل الماء صاديا % % 4(@)(@@) % و ها أنا تلقاني الليالي بملئها % % خطوبا وألقى بالعويل اللياليا % % 5(@)(@@) % و تطوي على وخز الأشافي جوانحي % % توالي رزايا لا ترى الدمع شافيا % % 6(@)(@@) % ضمان عليها أن ترى القلب خافقا ، % طوال الليالي أو ترى الطرف داميا % % 7(@)(@@) % و أن صفاء الود والعهد بيننا % % ليكره لي أن أشرب الماء صافيا % % 8(@)(@@) % وكم قد لحتني العاذلات جهالة ، % ويأبى المعنى 
ms26	 أن يطيع اللواحيا % % 9(@)(@@) % فقلت لها : إن البكاء لراحة ، % به يشتفي من ظن أن لا تلاقيا % % 10(@)(@@) % ألا إن دهرا قد تقاضى شبيبتي % % وصحبي لدهر قد تقاضى المرازيا % % PageV01P128 11(@)(@@) % وقد كنت أهدي المدح ، والدار غربة ، % فكيف بإهدائي إليه المراثيا % % 12(@)(@@) % أأحبابنا بالعدوتين صممتم ، % بحكم الليالي أن تجيبوا المناديا % % 13(@)(@@) % فقيدت من شكوى ، وأطلقت عبرتي ، % و خفضت من صوتي هنالك شاكيا % % 14(@)(@@) % وأكبرت خطبا أن أرى الصبر باليا ، % وراء ظلام الليل والنجم ثاويا % % 15(@)(@@) % وإن عطل النادي به من حلاكم ، % و كان على عهد التفاوض حاليا % % 16(@)(@@) % وما كان أحلى مقتضى ذلك الجنى ، % و أحسن هاتيك المرامي مراميا % % 17(@)(@@) % و أندى محيا ذلك العصر مطلعا % وأكرم نادي ذلك الصحب ناديا % % 18(@)(@@) % زمان تولى بالمحاسن عاطر ، % تكاد لياليه تسيلث غواليا % % 19(@)(@@) % تقضى وألقى بين جنبي لوعة % أباكي بها ، أخرى الليالي ، البواكيا % % 20(@)(@@) % كأني لم أنس إلى اللهو ليلة % ولم أتصفح صفحة الدهر راضيا % % PageV01P129 21(@)(@@) % ولم أتلق الريح تندى على الحشى ، % شذاء ولم أطرب إلى الطير شاديا % % 22(@)(@@) % وكانت تحايانا ، على القرب والنوى ، % تطيب على مر الليالي تعاطيا % % 23(@)(@@) % فهل من لقاء معرض ، أو تحية % مع الركب يغشى أو مع الطيف ساريا % % 24(@)(@@) % فها أنا والرزاء تقرع مروة % بصدري وقلبا بين جنبي حانيا % % 25(@)(@@) % أحن ، إذا ما عسعس الليل ، حنة % تذيب الحوايا أو تفض التراقيا % % 26(@)(@@) % وأرخص أعلاق الدموع صبابة ، % و عهدي بأعلاق الدموع غواليا % % 27(@)(@@) % فما بنت أيك بالعراء مرنة % تنادي هديلا قد أضلته نائبا % % 28(@)(@@) % و تندب عهدا قد تقضى برامة % ووكرا بأكناف المشقر خاليا % % 29(@)(@@) % بأخفق أحشاء وأنبا حشية % و أضرم أنفاسا وأندى مآقيا % % 30(@)(@@) % فهل قائل عني لواد بذي الغضا % % تأرج مع الأمساء حييت واديا % % PageV01P130 31(@)(@@) % وعلل بريا الرند نفسا عليلة ، % مع الصبح يندى ، أو مع الليل هاديا % % 32(@)(@@) % فكم شاقني من منظر فيك رائق % هززت له من معطف السكر صاحيا % % 33(@)(@@) % و ضاحكني ثغر الأقاح ومبسم % فلم أدر أي بان ثم أقاحيا % % 34(@)(@@) % ودون حلى تلك الشبيبة شيبة 
ms27	 ، % جلبت بها غما ولم أك خاليا % % 35(@)(@@) % وإن أجد الوجد وجد بأشمط ، % تلدد يستقري الرسوم الخواليا % % 36(@)(@@) % وتهفو صبا نجد به طيب نفحة ، % فيلقى صبا نجد بما كان لاقيا % % 37(@)(@@) % فقل لليالي الخيف : هل من معرج % علينا ولو طيفا سقيت لياليا % % 38(@)(@@) % وردد بهاتيك الأباطح والربى % % تحية صب ليس يرجو التلاقيا % % 39(@)(@@) % فما أستسيغ الماء ، يعذب ، ظامئا ، % ولا أستطيب الظل ، يبرد ، ضاحيا % % 40(@)(@@) % ولولا أمان عللتني ، على النوى ، % % PageV01P131 41(@)(@@) % أخو المجد لم يعدل عن النجد نازلا % بأرض ولم يشمخ مع العز ثاويا % % 42(@)(@@) % تلوذ بركني خالق منه شاهق ، % فتغشى كريما حاملا عنك حاميا % % 43(@)(@@) % يساجل طورا كفه الغيث غاديا ، % ويحمل طورا درعه الليث عاديا % % 44(@)(@@) % وتبأى العلى منه بأبيض ماجد ، % يجرد دون المجد أبيض ماضيا % % 45(@)(@@) % و يحطمه ما بين درع ومغفر % و إن كان عضب الشفرتين يمانيا % % 46(@)(@@) % شريف لآباء ، نمته ، شريفة ، % يطول العوالي بسطة والمعاليا % % 47(@)(@@) % يسابق أنفاس الرياح سماحة ، % ويحمل أوضاح الصباح مساعيا % % 48(@)(@@) % إذا نحن أثنينا عليها وجدتنا % % نحلي صدورا للعلى وهواديا % % 49(@)(@@) % كفى قومه علياء أن كان غاية % لهم وكفاه أن يكونوا مباديا % % 50(@)(@@) % تبوأ من رسم الوزارة رتبة % تمنى ، مراقيها ، النجوم ، مراقيا % % PageV01P132 51(@)(@@) % وأحرز في أخرى الليالي فضائلا % تعد على حكم المعالي أواليا % % 52(@)(@@) % % تنوب ، ونستسقي الغمام غواديا % % 53(@)(@@) % لقيت به والليل رائش نبله % % 54(@)(@@) % وأروع يندى للطلاقة صفحة ، % و يقدح زندا للنباهة واريا % % 55(@)(@@) % فيجمع بين الماء أبيض سلسلا % يسح ، وبين الجمر أحمر حاميا % % 56(@)(@@) % أحن إليه حنة النيب هجرت ، % وقد ذكرت ماء العضاه صواديا % % 57(@)(@@) % فيا أيها النائي مع النجم همة % ومرقى خلال في الوزارة ساميا % % 58(@)(@@) % ترى فرقد الليل السرى منه ثالثا % وترعى به بدر الدجنة ثانيا % % 59(@)(@@) % حنايك في ناء شكا مس لوعة % فسفر ، من شوق إليك ، القوافيا % % 60(@)(@@) % وحيا بها أذكى من الروض نفحة ، % و أرهف من لدن النسيم حواشيا % % PageV01P133 61(@)(@@) % و قد ندبت من حيث لم أدر رقعة % % 62(@)(@@) % و أنك للعذب الفرات على الصدى % % 63(@)(@@) % شقيق الندى 
ms28	 وابن النهى وأبو العلا % % وحسبك بيتا في المكارم عاليا % % PageV01P134 البحر : كامل تام 1(@)(@@) % أقوى محل ، من شبابك ، آهل ، % فوقفت أندب منه رسما عافيا % % 2(@)(@@) % مثل العذار هناك نؤيا داثرا % و اسودت الخيلان فيه أثافيا % % PageV01P135 
