ms3541	 أبي الخطاب.(@)(@@) التهذيب: ج 4، ح 69 (الاستبصار: ج 2، ح 87).(@)(@@) وروى عنه محمد بن عبد الله بن هلال.(@)(@@) الكافي: ج 4، ك 3، ب 92، ح 15، و ب 100، ح 4.(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 5، ك 2، ب 40، ح 8.(@)(@@) والتهذيب: ج 6، ح 1071 (الاستبصار:(@)(@@) ج 3، ح 220).(@)(@@) وروى عنه محمد بن عمران.(@)(@@) الكافي: ج 5، ك 3، ب 187، ح 10.(@)(@@) وروى عنه محمد بن عمران السبيعي.(@)(@@) الكافي: ج 2، ك 1، ب 60، ح 16.(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 1115.(@)(@@) وروى عنه يحيى بن المبارك.(@)(@@) الكافي: ج 1، ك 1، ب 0، ح 19، و ج 2، ك 1، ب 33، ح 2، و ب 78، ح 14، و ب 105، ح 11، و ب 165، ح 17، و ب 169، ح 3، وك 2، ب 33، ح 1، و ج 4، ك 3، ب 41، ح 5، و ب 212، ح 34، و ج 5، ك 2، ب 50، ح 6، و ج 6، ك 6، ب 8، ح 4، و ب 53، ح 6، و ب 80، ح 3، وك 8، ب 33، ح 8، و ج 7، ك 3، ب 21، ح 9، وك 7، ب 17، ح 15، 16.(@)(@@) والروضة: ح 182، 302، 570.(@)(@@) والتهذيب: ج 4، ح 1048، و ج 6، ح 334، 1154، و ج 7، ح 1377 (الاستبصار: ج 3، ح 734)، و ج 8، ح 1138، 1139، 1174، و ج 9، ح 328، و ج 10، ح 206، 513.(@)(@@) وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 5، ك 2، ب 40، ح 10، و ج 6، ك 6، ب 8، ح 4.(@)(@@) التهذيب: ج 6، ح 1069. PageV11P454(@)(@@) * وروى هو عن إسحاق بن عمار أو غيره، وروى عنه يحيى بن المبارك.(@)(@@) الكافي: ج 4، ك 2، ب 74، ح 5.(@)(@@) والروضة: ح 183.(@)(@@) * وروى عن جميل، وروى عنه بن سماعة.(@)(@@) الكافي: ج 6، ك 2، ب 20، ح 3، و ب 63، ح 8.(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 6، ك 2، ب 22، ح 3.(@)(@@) والتهذيب: ج 9، ح 1309 (الاستبصار:(@)(@@) ج 4، ح 713).(@)(@@) * وروى عن جميل بن دراج، وروى عنه بن سماعة.(@)(@@) الكافي: ج 6، ك 2، ب 26، ح 6.(@)(@@) * وروى عن ذريح، وروى عنه الحسن بن محمد.(@)(@@) التهذيب: ج 2، ح 1004 (الاستبصار:(@)(@@) ج 1، ح 925، وفيه الحسن بن محمد بن سماعة).(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) التهذيب: ج 2، ح 1022 (الاستبصار:(@)(@@) ج 1، ح 949).(@)(@@) * وروى عن ذريح المحاربي، وروى عنه الحسن بن محمد بن سماعة.(@)(@@) التهذيب: ج 2، ح 978 (الاستبصار:(@)(@@) ج 1، ح 897).(@)(@@) وروى 
