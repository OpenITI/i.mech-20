ms141	 ما في الكتاب.(@)(@@)(@@)(@@) | 17 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر وأبو عمرو {أن الناس كانوا بآياتنا} [82] بكسر الألف.(@)(@@) وقرأ عاصم وحمزة والكسائي ويعقوب وخلف {أن الناس} بفتح الألف وروي عن روح وزيد أيضا بكسر الألف.(@)(@@) PageV01P335(@)(@@)(@@)(@@) | 18 - (@)(@@) قرأ حمزة، وحفص عن عاصم، وخلف {وكل أتوه داخرين} [87] مقصورة الألف، غير ممدودة والتاء مفتوحة. وقرأ الباقون {وكل أتوه} بمد الألف وضم التاء.(@)(@@)(@@)(@@) | 19 - (@)(@@) قرأ ابن كثير وأبو عمرو، وحماد عن عاصم، والأعشى والبرجمي عن أبي بكر، ويعقوب {إنه خبير بما تفعلون} [88] بالياء وقرأ الباقون {بما تفعلون} بالتاء.(@)(@@)(@@)(@@) | 20 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {وهم من فزع} [89] منونة {يومئذ} مفتوحة الميم. وقرأ أبو جعفر، ونافع برواية ورش وقالون، {وهم من فزع} بغير تنوين {يومئذ} بفتح الميم. وقرأ ابن كثير وابن عامر وأبو عمرو وإسماعيل ويعقوب {من فزع} بغير تنوين {يومئذ} بكسر الميم.(@)(@@)(@@)(@@) | 21 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر، وحفص عن عاصم، ويعقوب {وما ربك بغافل عما تعملون} [93] بالتاء. وقرأ الباقون {تعملون} بالياء.(@)(@@)(@@)(@@) | 22 - (@)(@@) قرأ أبو جعفر ونافع {وقال الذين كفروا أإذا كنا ترابا وآباؤنا} [67] بكسر الألف غير مستفهم {أئنا لمخرجون} مستفهم بهمزة واحدة ممدودة عن أبي جعفر وقالون وغير ممدودة عن نافع برواية ورش وإسماعيل.(@)(@@) وقرأ ابن عامر والكسائي {أإذا} بهمزتين {أئنا} بنونين.(@)(@@) وقرأ ابن كثير ويعقوب {أإذا} و {أئنا} بالاستفهام فيهما جميعا بهمزة واحدة غير ممدودة.(@)(@@) PageV01P336(@)(@@) - وقرأ أبو عمرو {أإذا} و {أئنا} بالاستفهام فيهما بهمزة واحدة ممدودة.(@)(@@) وقرأ عاصم وحمزة وخلف {أإذا} و {أئنا} بالاستفهام فهما جميعا بهمزتين همزتين.(@)(@@) وقد ذكرت باب الاستفهامين يجتمعان في كل القرآن غير موضع من هذا الكتاب إلا أني أعدت ذكر هذا الحرف هاهنا لزيادة خلاف بينهم فيه، فيكون أبين للخاص والعام بمشيئة الله وعونه.(@)(@@) فتح الياءات(@)(@@) فتح أبو جعفر ونافع من الياءات {إني آنست نارا} [7] و {إني ألقي إلي كتاب كريم} [29] {فما آتاني الله خير} [36] و {ليبلوني أأشكر} [40].(@)(@@) وفتح أبو عمرو {إني آنست} و {فما آتاني الله خير}.(@)(@@) - ولا يفتح أبو عمرو في جميع 
ms142	 القرآن إلا ياء ثابتة في الكتاب غير هذه في هذا الحرف {فما آتاني الله} فإنه يفتحها وهي محذوفة في الخط. وفتح ابن كثير {إني آنست} و {ما لي لا أرى الهدهد} [20]. وفتح في رواية البزي {قال رب أوزعني أن أشكر} [19]. واختلف عن ابن فليح عنه في فتحه وإرساله. ولم يختلف عن القواس عنه فيه أنه غير مفتوح.(@)(@@) واختلف عن ورش عن نافع أيضا فيه، ونحن قرأناه من طريق محمد بن إسحاق البخاري {أوزعني أن} بفتح الياء. ومن(@)(@@) PageV01P337(@)(@@) طريق محمد بن عبد الرحيم الأصبهاني بإرسال الياء وفي سورة "الأحقاف" [آية 15] مثله.(@)(@@) وفتح ابن كثير وعاصم والكسائي {فقال ما لي لا أرى الهدهد}.(@)(@@) وفتح أبو جعفر ونافع وأبو عمرو، وابن كثير في رواية ابن فليح وحده، وحفص عن عاصم، {فما آتاني الله} ولم يفتح الباقون منها شيئا.(@)(@@) PageV01P338(@)(@@)(@@)(@@) | سورة القصص(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة والكسائي وخلف {ونري} [6] بالياء {فرعون وهامان وجنودهما} [6] كله بالرفع.(@)(@@) وقرأ الباقون {ونري} بالنون وفتح الياء {فرعون وهامان وجنودهما} كله بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ حمزة والكسائي وخلف ليكون لهم عدوا وحزنا} [8] بضم الحاء وسكون الزاي.(@)(@@) وقرأ الباقون {وحزنا} بفتح الحاء والزاي.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر وحده {فلما أن أراد أن يبطش} [19] بضم الطاء وقرأ الباقون بكسر الطاء وقد ذكرته في الأعراف.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر وأبو عمرو وابن عامر {حتى يصدر الرعاء} [23] بفتح الياء وضم الدال.(@)(@@) وقرأ الباقون {يصدر} بضم الياء وكسر الدال.(@)(@@) PageV01P339(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ عاصم {أو جذوة من النار} [29] بفتح الجيم.(@)(@@) وقرأ حمزة وخلف {أو جذوة} بضم الجيم. قرأ الباقون {أو جذوة} بكسر الجيم.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو ويعقوب {من الرهب} [32] بفتح الراء والهاء.(@)(@@) وقرأ حفص عن عاصم {من الرهب} بفتح الراء وسكون الهاء. وقرأ ابن عامر، وأبو بكر عن عاصم، وحمزة والكسائي وخلف {من الرهب} بضم الراء وسكون الهاء.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن كثير وأبو عمرو {فذانك برهانان} [33] مشددة النون. وقرأ الباقون {فذانك} خفيفة النون.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ عاصم وحمزة {فأرسله معي ردءا 
ms143	 يصدقني} [34] بالرفع وقرأ الباقون. {يصدقني} بالجزم.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو جعفر ونافع {ردءا} بغير همز. وقرأ الباقون {ردءا} [34] بالهمز.(@)(@@) ورش عن نافع {أن يكذبون} [34] بإثبات الياء مثل يعقوب، إلا أن ورشا يثبته في الوصل ويعقوب يثبته في الوصل والوقف على مذهبه كما وصفته وشرحته في سورة البقرة.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ ابن كثير {وقال موسى ربي أعلم} [37] بغير واو؛ وكذلك هي في مصاحف أهل مكة. وقرأ الباقون {وقال موسى} بالواو.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ حمزة والكسائي وخلف {ومن تكون له(@)(@@) PageV01P340(@)(@@) عاقبة الدار} [37] بالياء. وقرأ الباقون {تكون له} بالتاء.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ أبو جعفر وأبو عمرو وابن كثير وابن عامر وعاصم {وظنوا أنهم إلينا لا يرجعون} [39] بضم الياء وفتح الجيم. وقرأ نافع وحمزة والكسائي وخلف {لا يرجعون} بفتح الياء وكسر الجيم.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {قالوا سحران تظاهرا} [48] بغير ألف، وكسر السين. وقرأ الباقون {ساحران} بالألف وكسر الحاء.(@)(@@)(@@)(@@) | 14 - (@)(@@) قرأ أبو جعفر ونافع ويعقوب {حرما آمنا يجبى إليه} [57] بالتاء. وقرأ الباقون {يجبى إليه} بالياء.(@)(@@)(@@)(@@) | 15 - (@)(@@) قرأ أبو عمرو {أفلا تعقلون} [60] بالياء، وكذلك قرأته في رواية شجاع عنه. وقرأت في رواية اليزيدي بالياء والتاء. وقال أصحابه عنه عن أبي عمرو أنه قال: "ما أبالي بالياء قرأتها أم بالتاء". وذكر أبو حمدون الياء والتاء ثم قال: وكان يختار الياء. وذكر أوقية عنه الياء والتاء ثم قال وكان يختار التاء. وقرأ الباقون بالتاء.(@)(@@)(@@)(@@) | 16 - (@)(@@) قرأ حفص عن عاصم، ويعقوب {لولا أن من الله علينا لخسف بنا} [82] بفتح الخاء والسين. وقرأ الباقون {لخسف} بضم الخاء وكسر السين.(@)(@@) PageV01P341(@)(@@) فتح الياءات(@)(@@) فتح أبو جعفر ونافع {قال إني أريد أن أنكحك} [27] و {ستجدني إن شاء الله} [27] و {إني آنست نارا} [29] و {لعلي آتيكم} [29] و {إني أنا الله} [30] و {عسى ربي أن يهديني} [22] و {إني أخاف أن يكذبون} [34] و {وقال موسى ربي أعلم} [37] و {لعلي أطلع} [38] و {قل ربي أعلم من جاء} [85] {على علم عندي أولم يعلم} [78].(@)(@@) وفتح ابن كثير وأبو عمرو {إني آنست} و {عسى ربي} و {لعلي آتيكم} و {إني أنا 
ms144	 الله} و {إني أخاف} و {ربي أعلم} و {لعلي أطلع} و {قل ربي أعلم}.(@)(@@) وفتح أبو عمرو، وابن كثير في رواية ابن فليح وحده، أيضا {على علم عندي أولم يعلم}.(@)(@@) ولم يفتح هذا الحرف - أعني ابن كثير - في رواية القواس والبزي.(@)(@@) وفتح ابن عامر {لعلي آتيكم} و {لعلي أطلع}.(@)(@@) وفتح حفص عن عاصم {فأرسله معي ردءا} [34]. ولم يفتح الباقون منها شيئا.(@)(@@) PageV01P342(@)(@@)(@@)(@@) | سورة العنكبوت(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ ابن كثير وأبو عمرو {ثم الله ينشئ النشأة الآخرة} [20] مفتوحة الشين ممدودة مهموزة حيث كانت.(@)(@@) وقرأ الباقون {النشأة} ساكنة الشين مهموزة غير ممدودة.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ حمزة والكسائي وخلف {أولم يروا كيف يبدئ الله الخلق} [19] بالتاء.(@)(@@) - وقرأ الباقون {أولم يروا} بالياء.(@)(@@) وروي عن يحيى عن أبي بكر {أولم يروا} بالتاء والياء.(@)(@@) والذي قرأته في رواية شعيب بن أيوب عن يحيى بالياء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ ابن كثير وأبو عمرو والكسائي ويعقوب {أوثانا مودة} [25] رفع غير منون {بينكم} بالخفض. وقرأ أبو جعفر ونافع وابن عامر، وعاصم في رواية حماد ويحيى عن أبي بكر،(@)(@@) PageV01P343(@)(@@) ومحمد بن غالب عن الأعشى عن أبي بكر، وخلف {مودة} منصوبة منونة {بينكم} بالنصب.(@)(@@) محمد بن حبيب الشموني عن الأعشى، وعبد الحميد بن صالح البرجمي عن أبي بكر {مودة} مرفوعة منونة {بينكم} بالنصب. وقرأ حمزة، وحفص عن عاصم، {مودة} منصوبة غير منونة {بينكم} بالخفض.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر، وحفص عن عاصم، ويعقوب {ولوطا إذ قال لقومه إنكم لتأتون الفاحشة} [28] بكسر الألف غير مستفهم.(@)(@@) {أئنكم لتأتون الرجال} [29] مستفهم.(@)(@@) - أبو جعفر، وقالون عن نافع، وزيد عن يعقوب: بهمزة واحدة ممدودة.(@)(@@) - وابن كثير، ونافع برواية إسماعيل وورش، ويعقوب بهمزة واحدة غير ممدودة.(@)(@@) - وابن عامر وحفص عن عاصم: بهمزتين.(@)(@@) - قرأ أبو عمرو {إنكم لتأتون الفاحشة} و {أئنكم لتأتون الرجال} بالاستفهام فهما جميعا بهمزة واحدة ممدودة.(@)(@@) وقرأ عاصم في رواية أبي بكر، وحمزة والكسائي وخلف {إنكم لتأتون الفاحشة} و {أئنكم لتأتون الرجال} بالاستفهام فيهما أيضا، إلا أنه بهمزتين.(@)(@@) PageV01P344(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة والكسائي 
ms145	 وخلف {لننجينه وأهله} [32] خفيفة من"انجى ننجي" وقرأ الباقون {لننجينه} مشددة من "نجى ننجي".(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ ابن كثير، وأبو بكر عن عاصم، وحمزة والكسائي ويعقوب وخلف {إنا منجوك وأهلك} [33] خفيفة.(@)(@@) وقرأ أبو جعفر ونافع وأبو عمرو وابن عامر، وحفص عن عاصم، {منجوك وأهلك} مشددة.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن عامر {إنا منزلون على أهل هذه} [34] مشددة.(@)(@@) وقرأ الباقون {إنا منزلون} خفيفة الزاي.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو عمرو ويعقوب وعاصم - إلا في رواية الأعشى والبرجمي عن أبي بكر - {إن الله يعلم ما يدعون} [42] بالياء وقرأ الباقون، والأعشى والبرجمي عن أبي بكر، {تدعون} بالتاء.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو وابن عامر ويعقوب، وحفص عن عاصم، وقتيبة عن الكسائي {وقالوا لولا أنزل عليه آيات من ربه} [50] بالألف على الجمع.(@)(@@) وقرأ ابن كثير، وأبو بكر عن عاصم، وحمزة والكسائي - غير قتيبة - وخلف {آية من ربه} بغير ألف، على واحدة.(@)(@@) PageV01P345(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر وابن كثير وأبو عمرو وابن عامر ويعقوب {ونقول ذوقوا} [55] بالنون.(@)(@@) وقرأ نافع وعاصم وحمزة والكسائي وخلف {ويقول ذوقوا} بالياء.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ عاصم في رواية حماد ويحيى عن أبي بكر - مختلفا عنه - {ثم إلينا ترجعون} [57].(@)(@@) - وقرأ الباقون، وشعيب عن يحيى: بالتاء.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ حمزة والكسائي وخلف {لنبوئنهم من الجنة} [58] بالثاء الساكنة. وقرأ الباقون {لنبوئنهم} بالباء. ولم يختلفوا في "النحل" [آية 41] {لنبوئنهم في الدنيا حسنة} أنه بالباء.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ ابن كثير، ونافع برواية قالون، وعاصم برواية الأعشى والبرجمي عن أبي بكر، وحمزة والكسائي وخلف {ليكفروا بما آتيناهم وليتمتعوا} [66] ساكنة اللام.(@)(@@) وقرأ الباقون {وليتمتعوا} بكسر اللام.(@)(@@) واختلف عن ابن كثير في رواية ابن أبي بزة وحده، والصحيح عنه كسر اللام، وكذلك قرأناه، إلا في رواية أبي ربيعة فإن النقاش ذكر عنه {وليتمتعوا} ساكنة اللام؛ مثل رواية القواس وابن فليح، وأما أبو بكر الهاشمي وغيره فإنهم ذكروا عن أبي بزة {وليتمتعوا} بكسر اللام كما وصفته. والله أعلم.(@)(@@) PageV01P346(@)(@@) فتح الياءات واثباتها(@)(@@) فتح أبو جعفر ونافع وابن كثير وابن عامر وعاصم {يا عبادي الذين آمنوا إن أرضي واسعة} [56].(@)(@@) وقرأ 
ms146	 أبو عمرو وحمزة والكسائي ويعقوب وخلف {يا عبادي} غير مفتوحة. وكلهم يقفون عليها بإثبات الياء: من فتح منهم ومن لم يفتح لأنها مثبتة في جميع المصاحف.(@)(@@) وفتح أبو جعفر ونافع وأبو عمرو {إلى ربي إنه هو} [26] وأسكنها الآخرون وفتح ابن عامر وحده {إن أرضي واسعة} [56] ولم يفتحها الآخرون. والله أعلم.(@)(@@) PageV01P347(@)(@@)(@@)(@@) | سورة الروم(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو ويعقوب {ثم كان عاقبة الذين أساءوا} [10] بالرفع.(@)(@@) وقرأ ابن عامر وعاصم وحمزة والكسائي وخلف {ثم كان عاقبة} بالنصب.(@)(@@) واختلف عن أبي بكر عن عاصم: فروى محمد بن حبيب الشموني عن الأعشى وعبد الحميد بن صالح البرجمي عن أبي بكر {ثم كان عاقبة} بالرفع. وروى محمد بن غالب عن الأعشى ويحيى عن أبي بكر {ثم كان عاقبة} بالنصب، مثل رواية حماد وحفص.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو عمرو، وعاصم في رواية حماد ويحيى عن أبي بكر - مختلفا عنه - {ثم إليه ترجعون} [11] بالياء.(@)(@@) PageV01P348(@)(@@) وقرأ الباقون وأبو قبيصة عن أوقية عن اليزيدي، مثل رواية العباس عن أبي عمرو وشعيب بن أيوب عن يحيى عن أبي بكر {ثم إليه ترجعون} بالتاء.(@)(@@) وكلهم يضمون التاء، غير يعقوب فإنه يفتحه، وكذلك مذهبه في جميع القرآن. وقد ذكرته في سورة البقرة.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة والكسائي وخلف {وكذلك تخرجون} [19] بفتح التاء وضم الراء. وقرأ الباقون {تخرجون} بضم التاء وفتح الراء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حفص عن عاصم {إن في ذلك لآيات للعالمين} [22] بكسر اللام. وقرأ الباقون {للعالمين} بفتح اللام.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن كثير وحده {وما آتيتم من ربا ليربو} [39] مقصورة الألف غير ممدودة. وقرأ الباقون {آتيتم من ربا} ممدودة الألف.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع ويعقوب {ليربو في أموال الناس} [39] بضم التاء وسكون الواو. وقرأ الباقون {ليربو} بالياء وفتح الواو.(@)(@@)(@@)(@@) | 7 - (@)(@@) وقرأ أبو جعفر وابن عامر {ويجعله كسفا} [48] ساكنة السين. وقرأ الباقون {كسفا} بفتح السين.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو جعفر وابن كثير وأبو عمرو، وأبو بكر عن عاصم، ويعقوب {فانظر إلى آثار رحمت الله} [50] بغير ألف، على واحدة. 
ms147	 وقرأ ابن عامر وحمزة والكسائي، وحفص عن عاصم، وخلف {إلى آثار رحمت الله} بالألف على الجمع.(@)(@@) PageV01P349(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ عاصم وحمزة {الله الذي خلقكم من ضعف ثم جعل من بعد ضعف قوة ثم جعل من بعد قوة ضعفا وشيبة} [54] بفتح الضاد فيها.(@)(@@) وقرأ الباقون {من ضعف} بضم الضاد فيها.(@)(@@) وقد ذكرت في سورة "الأنفال" وبينت أن حفصا قال: "ما خالفت عاصما إلا في هذا الحرف" للحديث الذي روي فيه عن عبد الله بن عمرو. وهو مذكور في سورة "الأنفال". وقرأت على أبي بكر النقاش "بحفص" فأخذ علي بضم الضاد في هذه الحروف.(@)(@@) وقرأت على أبي الحسن الخياط فأخذ علي بفتح الضاد. وقال الضم فيه اختياره لنفسه - يعني اختيار حفص - فأما روايته عن عاصم فالفتح.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {فيومئذ لا ينفع الذين ظلموا} [57] بالياء. وقرأ الباقون {لا ينفع} بالتاء. والله أعلم بجميع ذلك.(@)(@@) PageV01P350(@)(@@)(@@)(@@) | سورة لقمان(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة {هدى ورحمة للمحسنين} [3] بالرفع. وقرأ الباقون {هدى ورحمة} بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير وأبو عمرو ويعقوب {ومن الناس من يشتري لهو الحديث ليضل عن سبيل} [6] بفتح الياء. وقرأ الباقون {ليضل} بضم الياء. وكذلك في سورة "إبراهيم" و"الحج" و"الزمر" وقد ذكرته.(@)(@@) وقرأ عاصم وحمزة والكسائي وخلف في سورة "الأنعام" {وإن كثيرا ليضلون} وفي سورة "يونس" {ربنا ليضلوا} بضم الياء أيضا. وقرأ الباقون بفتح الياء. وقد تقدم ذكر ذلك وشرحه في سورة "الأنعام".(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر وأبو عمرو، وأبو بكر عن عاصم، {ويتخذها هزوا} [6] بالرفع. وقرأ حمزة والكسائي، وحفص عن عاصم، ويعقوب وخلف {ويتخذها} بالنصب.(@)(@@) PageV01P351(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ نافع وحده {كأن في أذنيه وقرا} [7] ساكنة الذال كل القرآن. وقرأ الباقون {أذنيه} مضمومة الذال كل القرآن.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن كثير في رواية البزي {يا بني لا تشرك بالله} [13] ساكنة الياء {يا بني إنها} [16] مكسورة الياء {يا بني أقم الصلاة} [17] مفتوحة الياء.(@)(@@) وقرأ في رواية القواس {يا بني إنها} مكسورة الياء {يا بني لا تشرك} {يا 
ms148	 بني أقم} ساكنة الياء فيهما.(@)(@@) وقرأ في رواية ابن فليح {يا بني أقم} مفتوحة الياء {يا بني لا تشرك} {يا بني إنها} مكسورة الياء.(@)(@@) وقد خلط أكثرهم في هذه الأحرف عن ابن كثير وادخلوا الرواية في غيرها، وغلطوا ووهموا. والصحيح فيها رواية الهاشمي أبي بكر ما ذكرته وهو المأخوذ به والمعتمد عليه. والله أعلم.(@)(@@) وقرأ عاصم {يا بني} بفتح الياء في جميع القرآن. وقرأ الباقون {يا بني} بكسر الياء كل القرآن. وقد ذكرتها في سورة هود.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر وابن كثير وابن عامر وعاصم ويعقوب {ولا تصعر خدك للناس} [18] بغير ألف، وتشديد العين. وقرأ نافع وأبو عمرو وحمزة والكسائي وخلف {ولا تصعر} بالألف.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو، وحفص عن عاصم، {وأسبغ عليكم نعمه} [20] بفتح العين وضم الهاء على الجمع.(@)(@@) PageV01P352(@)(@@) وقرأ الباقون {نعمه ظاهرة} ساكنة العين مفتوحة التاء على واحدة.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو عمرو ويعقوب {والبحر يمده} [27] بالنصب. وقرأ الباقون {والبحر يمده} بالرفع.(@)(@@) - {وأن ما يدعون} [30] ذكرته في سورة "الحج".(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ ابن كثير وأبو عمرو وحمزة والكسائي ويعقوب وخلف {وينزل الغيث} [34] وفي "عسق" [آية 28] {وهو الذي ينزل الغيث} بالتخفيف فيهما.(@)(@@) قرأ أبو جعفر ونافع وابن عامر وعاصم {ينزل} بالتشديد فيهما وغيرهما. وقد تقدم ذكره.(@)(@@) PageV01P353(@)(@@)(@@)(@@) | سورة السجدة(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر وابن كثير وابن عامر وأبو عمرو ويعقوب {الذي أحسن كل شيء خلقه} [7] ساكنة اللام.(@)(@@) وقرأ نافع وعاصم وحمزة والكسائي وخلف {الذي أحسن كل شيء خلقه} بفتح اللام.(@)(@@)(@@)(@@) | 2 - (@)(@@) {أإذا ضللنا في الأرض أإنا} [10] مثل ما في "الرعد" و"سبحان" و"المؤمنين" وقد ذكرته وشرحته هناك.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة ويعقوب {ما أخفي لهم} [17] ساكنة الياء. وقرأ الباقون {ما أخفي لهم} بفتح الياء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة والكسائي، ورويس عن يعقوب، {يهدون بأمرنا لما صبروا} بكسر اللام وتخفيف الميم وقرأ الباقون {لما} بفتح اللام وتشديد الميم.(@)(@@)(@@)(@@) | 5 - (@)(@@) زيد عن يعقوب {أولم يهد لهم} [26] بالنون وكذلك في "الأعراف" و"طه".(@)(@@) PageV01P354(@)(@@)(@@)(@@) | سورة الأحزاب(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو 
ms149	 عمرو وحده {إن الله كان بما تعملون خبيرا} [2] بالياء. وكذلك ما بعده {وكان الله بما تعملون بصيرا} [9] أيضا بالياء. وقرأ الباقون بالتاء فيهما.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر وابن كثير وأبو عمرو، وورش عن نافع، {وما جعل أزواجكم اللائي} [4] بغير مد ولا همز. وفي سورة "الطلاق" [آية 4] و"المجادلة" [آية 2] مثله. وقرأ نافع ويعقوب {اللائي} ممدودة مهموزة مختلسة وليس بعد الهمز ياء. وذكر بعضهم لابن كثير مثل ذلك. والصحيح عنه - عندي - ما ذكرته، وبه قرأت.(@)(@@) وقرأ ابن عامر وعاصم وحمزة والكسائي وخلف {اللائي} ممدودة مهموزة مشبعة، بعد الهمزة ياء حيث كان.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ عاصم {تظاهرون منهن} [4] بضم التاء وكسر الهاء وتخفيف الظاء.(@)(@@) PageV01P355(@)(@@) وقرأ حمزة والكسائي وخلف {تظاهرون} بفتح التاء وتخفيف الظاء.(@)(@@) وقرأ ابن عامر {تظاهرون} بفتح التاء وتشديد الظاء.(@)(@@) وقرأ أبو جعفر ونافع وابن كثير وأبو عمرو ويعقوب {تظهرون} بغير ألف وفتح التاء وتشديد الظاء والهاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو عمرو وحمزة ويعقوب {ووتظنون بالله الظنونا} [10] بغير ألف وكذلك {فأضلونا السبيلا} [67] {وأطعنا الرسولا} [66] بغير ألف في الوصل والوقف. قرأ أبو جعفر ونافع وابن عامر، وأبو بكر {الظنونا} و {الرسولا} و {السبيلا} بالألف في الوصل والوقف. وقرأ ابن كثير والكسائي، وحفص عن عاصم، وخلف {الظنونا} و {الرسول} و {السبيل} بغير ألف في الوصل فإذا وقفوا أثبتوا فيها الألف. وروى قتيبة عن الكسائي أنه كان يثبت الألف فيها في الوصل والوقف.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حفص عن عاصم {لا مقام لكم فارجعوا} [13] بضم الميم.(@)(@@) - وقرأ الباقون {لا مقام لكم} بفتح الميم.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير {ثم سئلوا الفتنة لآتوها} [14] مقصورة الألف. وقرأ الباقون {لآتوها} ممدودة الألف.(@)(@@) PageV01P356(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ يعقوب {يسألون عن أنبائكم} [20] مشددة السين ممدودة مهموزة مثل قراءة الحسن والجحدري. وقرأ الباقون {يسألون} ساكنة السين مهموزة غير ممدودة.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ عاصم {لقد كان لكم في رسول الله أسوة حسنة} [21] بضم الألف في جميع القرآن.(@)(@@) وقرأ الباقون {أسوة} بكسر الألف حيث كان.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ ابن كثير وابن عامر {يضاعف لها العذاب} [30] بالنون وكير العين مشددة 
ms150	 {العذاب} بالنصب. وقرأ أبو جعفر وأبو عمرو ويعقوب {يضاعف لها} بالياء وتشديد العين وفتحه {العذاب} بالرفع. وقرأ نافع وعاصم وحمزة والكسائي وخلف {يضاعف لها} بالألف {العذاب} بالرفع.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ حمزة والكسائي وخلف {ومن يقنت منكن لله ورسوله وتعمل صالحا نؤتها أجرها} [31] كله بالياء.(@)(@@) وقرأ روح وزيد عن يعقوب {من يأت منكن} [30] و {يقنت} {وتعمل} كله بالتاء {نؤتها} بالنون.(@)(@@) وقرأ الباقون، ورويس عن يعقوب، {من يأت} {ومن يقنت} بالياء {وتعمل صالحا} بالتاء {نؤتها} بالنون.(@)(@@) PageV01P357(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ أبو جعفر ونافع وعاصم {وقرن في بيوتكن} [33] بفتح القاف.(@)(@@) وقرأ الباقون، وهبيرة عن حفص عن عاصم، {وقرن} بكسر القاف.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {أن يكون لهم الخيرة} [36] بالياء. وقرأ الباقون {أن يكون} بالتاء.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ عاصم {ولكن رسول الله وخاتم النبيين} [40] بفتح التاء. وقرأ الباقون {وخاتم} بكسر التاء.(@)(@@)(@@)(@@) | 14 - (@)(@@) قرأ ابن كثير في رواية البزي {فما لكم عليهن من عدة تعتدونها} [49] خفيفة الدال وروى أبو ربيعة عن ابن أبي بزة {تعتدونها} مشددة. قال: وكان ابن أبي بزة يخففها زمانا ثم رجع إلى التشديد؛ وكذلك ذكر الهاشمي وابن مجاهد عن قنبل أنه أخبرهما أن ابن أبي بزة رجع عنها إلى التشديد؛ إلا أن الهاشمي قال: هكذا قرأنا على أصحابه يعني بالتخفيف على أصحاب ابن أبي بزة؛ والوجه التشديد، وهو الصواب وبه قرأنا. والله أعلم.(@)(@@)(@@)(@@) | 15 - (@)(@@) قرأ أبو جعفر ونافع وحمزة والكسائي وخلف، وحفص عن عاصم، {ترجي من تشاء منهن} [51] بغير همز.(@)(@@) وقرأ ابن كثير وأبو عمرو وابن عامر، وأبو بكر عن عاصم، ويعقوب {ترجي من تشاء} بالهمز. وقد تقدم ذكر هذا(@)(@@) PageV01P358(@)(@@) في سورة التوبة [آية 106] عند قوله {وآخرون مرجون لأمر الله}.(@)(@@) الأعشى عن أبي بكر يهمز {مرجون} ولا يهمز {ترجي من تشاء}. والبرجمي ويحيى عن أبي بكر وحماد عن عاصم يهمزون {ترجي} كما يهمزون {مرجون} والله أعلم.(@)(@@)(@@)(@@) | 16 - (@)(@@) قرأ أبو عمرو ويعقوب {لا يحل لك النساء من بعد} [52] بالتاء. وقرأ الباقون {لا يحل لك} بالياء.(@)(@@)(@@)(@@) | 17 - (@)(@@) قرأ ابن عامر ويعقوب {إنا أطعنا سادتنا} [67] بالألف 
ms151	 وكسر التاء على الجمع. وقرأ الباقون {سادتنا} بغير ألف وفتح التاء.(@)(@@)(@@)(@@) | 18 - (@)(@@) قرأ عاصم {والعنهم لعنا كبيرا} [68] بالباء. وقرأ الباقون {لعنا كبيرا} بالثاء. والله أعلم.(@)(@@) PageV01P359(@)(@@)(@@)(@@) | سورة سبأ(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر، ورويس عن يعقوب، {قل بلى وربي لتأتينكم عالم الغيب} [3] بالرفع.(@)(@@) وقرأ ابن كثير وأبو عمرو وعاصم، وروح وزيد عن يعقوب، وخلف {عالم الغيب} بالخفض.(@)(@@) وقرأ حمزة والكسائي {عالم الغيب} بالخفض واللام قبل الألف.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير، وحفص عن عاصم، ويعقوب {أولئك لهم عذاب من رجز أليم} [5] بالرفع.(@)(@@) وقرأ الباقون {من رجز أليم} بالخفض. وفي "حم الجاثية" [آية 11] مثله.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة والكسائي وخلف {إن نشأ نخسف بهم الأرض أو نسقط عليهم} [9] كله بالياء.(@)(@@) وقرأ الباقون {إن نشأ نخسف بهم الأرض أو نسقط عليهم} كله [بالنون].(@)(@@) PageV01P360(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ روح وزيد عن يعقوب {يا جبال أوبي معه والطير} [10] بالرفع مثل قراءة عبيد بن عمير والأعرج وغيرهما. وقرأ الباقون ورويس {والطير} بالنصب,(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ عاصم في رواية أبي بكر {ولسليمان الريح} [12] بالرفع.(@)(@@) وقرأ الباقون {الريح} بالنصب.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو، وابن كثير في رواية ابن فليح، وزيد عن يعقوب {تأكل منسأته} [14] بغير همز. وقرأ ابن عامر {منسأته} بهمزة ساكنة.(@)(@@) قرأ ابن كثير وعاصم وحمزة والكسائي ويعقوب وخلف {منسأته} بهمزة مفتوحة.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ يعقوب {فلما خر تبينت الجن} [14] بضم التاء والباء وكسر الياء.(@)(@@) وقرأ الباقون {تبينت} بفتح التاء والباء والياء. وكذلك أبو علي الضرير عن روح وزيد وغيرهما عن يعقوب.(@)(@@) - {لقد كان لسبإ} [15] ذكرته في النمل.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ حمزة وحفص عن عاصم {في مسكنهم} [15] بغير ألف ساكنة السين مفتوحة الكاف. وقرأ الكسائي وخلف(@)(@@) PageV01P361(@)(@@) {في مسكنهم} بغير ألف ساكنة السين مكسورة الكاف. وقرأ الباقون {مساكنهم} بالألف على الجمع.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو عمرو ويعقوب {ذواتي أكل خمط} [16] مضاف غير منون. وقرأ [الباقون] {أكل خمط} منونة.(@)(@@) - وابن كثير ونافع {أكل} و {أكله} و {الأكل} ساكنة الكاف في جميع القرآن وقد تقدم ذكره في سورة البقرة. 
ms152	(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ حمزة والكسائي، وحفص عن عاصم، ويعقوب وخلف {وهل نجازي إلا الكفور} [17] {نجازي} بالنون {الكفور} بالنصب.(@)(@@) الكسائي وحده يدغم اللام في النون؛ والآخرون لا يدغمون.(@)(@@) وقرأ أبو جعفر ونافع وابن كثير وابن عامر وأبو عمرو، وأبو بكر عن عاصم، {وهل نجازي} بضم الياء وفتح الزاي {إلا الكفور} بالرفع.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ ابن كثير وأبو عمرو {فقالوا ربنا} [19] بفتح الباء {باعد بين أسفارنا} [19] بغير ألف، وتشديد العين وكسره وقرأ يعقوب {ربنا} بالرفع {باعد} بفتح العين(@)(@@) PageV01P362(@)(@@) والدال، مثل قراءة سلام وغيره. وروى عنه أحمد بن عبد الخالق وأبو علي الضرير عن روح وزيد وغيرهما {ربنا} بالرفع {بعد} بفتح العين وتشديده. وذكر يعقوب عن يحيى بن يعمر كذلك {ربنا} بالرفع {بعد} بالفتح والتشديد. وقال يحيى: إن القوم لم يدعوا على أنفسهم، إنما سكوا ما نزل. وروي الوجهان عن ابن عباس أيضا كما ذكرناه عن يعقوب، وقال: شكا القوم إلى ربهم ولم يسألوا أن يباعد بين أسفارهم والله أعلم بذلك. وقرأ الباقون {ربنا} بالنصب {باعد} بالألف وكسر العين.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {ولقد صدق عليهم} [20] مشددة الدال وقرأ الباقون {صدق} خفيفة الدال.(@)(@@) قرأ ابن عبد الخالق المكفوف وابن مسلم عن يعقوب. وأبو علي الضرير عن روح وزيد وغيرهما عن يعقوب {ولقد صدق} مشدد {عليهم إبليس} بالنصب {ظنه} بالرفع.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ أبو عمرو وحمزة والكسائي، والأعشى والبرجمي عن أبي بكر، وخلف {إلا لمن أذن له} [23] بضم الألف. وقرأ الباقون {أذن له} بفتح الألف.(@)(@@)(@@)(@@) | 14 - (@)(@@) قرأ ابن عامر ويعقوب {حتى إذا فزع عن قلوبهم} [23] بفتح الفاء والزاي. وقرأ الباقون {فزع} بضم الفاء وكسر الزاي.(@)(@@) PageV01P363(@)(@@)(@@)(@@) | 15 - (@)(@@) قرأ حمزة وحده {وهم في الغرفات آمنون} [37] ساكنة الراء بغير ألف، على واحدة وقرأ الباقون {في الغرفات} على الجمع.(@)(@@)(@@)(@@) | 16 - (@)(@@) قرأ يعقوب {فأولئك لهم جزاء الضعف} [37] بالرفع مثل قراءة جده، وما روي عن الخليل وغيره.(@)(@@) وقرأ الباقون {جزاء} بالرفع {الضعف} بالخفض على الإضافة.(@)(@@)(@@)(@@) | 17 - (@)(@@) قرأ ابن كثير وأبو عمرو {والذين يسعون في آياتنا معاجزين} [38] بغير ألف، وتشديد الجيم. وكذلك 
ms153	 في أول السورة وفي سورة "الحج" وقد ذكرته هناك.(@)(@@) وقرأ الباقون {معاجزين} بالألف في جميعها.(@)(@@)(@@)(@@) | 18 - (@)(@@) قرأ حفص عن عاصم، ويعقوب {ويوم يحشرهم جميعا ثم يقول للملائكة} [40] بالياء.(@)(@@) وقرأ الباقون {ويوم نحشرهم جميعا ثم نقول} بالنون. وقد ذكرناه في سورة "الأنعام" على غاية البيان بمشيئة الله وعونه.(@)(@@)(@@)(@@) | 19 - (@)(@@) قرأ يعقوب وحده برواية رويس {ثم تتفكروا} [46] مدغمة التاء في التاء، مشددة وكذلك في سورة "النجم" [آية 55] {فبأي آلاء ربك تتمارى}. ولم يدغمه أبو عمرو ولا أحد غيره.(@)(@@) PageV01P364(@)(@@)(@@)(@@) | 20 - (@)(@@) قرأ أبو عمرو وحمزة والكسائي وخلف {وأنى لهم التناوش من مكان بعيد} [52] بالمد والهمز.(@)(@@) وقرأ أبو جعفر ونافع وابن كثير وابن عامر ويعقوب، وحفص عن عاصم، {التناوش} بغير مد ولا همز.(@)(@@) واختلف عن أبي بكر عن عاصم: فروى حماد ويحيى عن أبي بكر، ومحمد بن غالب عن الأعشى {التناوش} بالمد والهمز.(@)(@@) وروى البرجمي عن أبي بكر، والشموني - وعهو محمد بن حبيب - عن الأعشى {التناوش} بغير همز. والله أعلم.(@)(@@) اثبات الياءات وفتحها(@)(@@) قرأ ابن كثير وأبو عمرو، وورش عن نافع، ويعقوب {وجفان كالجواب} [13] باثبات الياء وقرأ الباقون {كالجواب} بحذف الياء في الوصل والوقف.(@)(@@) قرأ حمزة وحده {من عبادي الشكور} [13] مرسلة الياء. وقرأ الباقون {من عبادي الشكور} بفتح الياء.(@)(@@) فتح أبو جعفر ونافع وأبو عمرو {إلي ربي إنه سميع} [50] وأسكنها الآخرون.(@)(@@) فتح أبو جعفر ونافع وابن عامر وأبو عمرو، وحفص عن عاصم، {إن أجري إلا على الله} [47] في جميع القرآن. ولم يفتحها الآخرون.(@)(@@) PageV01P365(@)(@@)(@@)(@@) | سورة الملائكة [فاطر](@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر {فلا تذهب نفسك} [8] بضم التاء وكسر الهاء {نفسك} بالنصب.(@)(@@) - وقرأ الباقون {فلا تذهب} بفتح التاء والهاء {نفسك} بالرفع.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر وحمزة والكسائي وخلف {هل من خالق غير الله} [3] بالخفض.(@)(@@) وقرأ الباقون {غير الله} بالرفع.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ روح وزيد عن يعقوب {ولا ينقص من(@)(@@) PageV01P366(@)(@@) عمره} [11] بفتح الياء وضم القاف مثل قراءة الحسن وغيره. وقرأ الباقون {ينقص} بضم الياء وفتح القاف.(@)(@@)(@@)(@@) | 4 - (@)(@@) قتيبة عن الكسائي {والذين تدعون من دونه} [13] بالياء.(@)(@@)(@@)(@@) | 5 
ms154	 - (@)(@@) قرأ أبو عمرو {جنات عدن يدخلونها} [33] بضم الياء وفتح الخاء.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو عمرو {كذلك نجزي} [36] بضم الياء وفتح الزاي {كل كفور} [36] بالرفع.(@)(@@) وقرأ الباقون {كذلك نجزي} بالنون {كل كفور} بالنصب.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن كثير وأبو عمرو وحمزة، وحفص عن عاصم، وخلف {فهم على بينت منه} [40] بغير ألف، على واحدة.(@)(@@) قرأ أبو جعفر ونافع وابن عامر، وأبو بكر عن عاصم، والكسائي ويعقوب {على بينت منه} بالألف على الجمع.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ حمزة وحده {ومكر السيئ} ساكنة الهمزة وقرأ الباقون {ومكر السيئ} بكسر الهمزة. والله أعلم.(@)(@@) PageV01P367(@)(@@)(@@)(@@) | سورة يس(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ عاصم في رواية حماد ويحيى عن أبي بكر، وحمزة والكسائي وخلف {يس} [1] بكسر الياء. وقرأ الباقون {يس}.(@)(@@) قرأ أبو جعفر وأبو عمرو وحمزة {يس} باظهار النون من "سين" عند الواو. وكذلك {ن والقلم} [القلم آية 1] يظهرون النون من {نون} عند الواو.(@)(@@) قرأ ابن عامر والكسائي وخلف {يس (1) والقرآن} [1 و2] و {ن والقلم} بإخفاء النون عند الواو فيهما.(@)(@@) واختلف عن الباقين: فأما ابن كثير فإنه يظهر النون عند الواو منهما في رواية القواس والبزي ولا يظهرها في رواية ابن فليح.(@)(@@) وأما نافع فإنه يظهر النون منهما في رواية إسماعيل وورش من طريق محمد بن عبد الرحيم الأصبهاني الذي قرأته بالعراق. وقرأتن بسمرقند من طريق محمد بن أبي إسحاق البخاري بإخفاء النون - أعني لورش.(@)(@@) PageV01P368(@)(@@) - وأما قالون عن نافع فإنه لا يظهر النون من {يس} ويظهرها من {ن والقلم}.(@)(@@) - وأما عاصم فإنه يظهر النون منهما في رواية عبد الحميد ابن صالح البرجمي عن أبي بكر ومحمد بن حبيب الشموني عن الأعشى، ويخفيها في رواية يحيى عن أبي بكر، ومحمد بن غالب عن الأعشى. وقرأت في رواية العليمي عن حماد عن عاصم بإظهار النون من {يس (1) والقرآن} واخفائها من {ن والقلم}.(@)(@@) وأما رواية حفص عن عاصم فإني قرأت بإظهار النون منهما في جميع الروايات، إلا في رواية زرعان، فإن أبا الحسن الخياط أخذ علينا بإخفاء النون في السورتين.(@)(@@) - وأما يعقوب فإنه 
ms155	 يظهر النون فيهما برواية روح وزيد ويخفيهما برواية رويس. والله أعلم.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو، وأبو بكر عن عاصم، ويعقوب {تنزيل العزيز الرحيم} [5] بالرفع.(@)(@@) وقرأ ابن عامر وحمزة والكسائي، وحفص عن عاصم، وخلف {تنزيل العزيز} بالنصب.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ عاصم في رواية أبي بكر {فعززنا بثالث} [14] خفيفة الزاي. وقرأ الباقون {فعززنا} مشددة الزاي.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو عمرو، وقالون عن نافع، وزيد عن يعقوب، {قالوا طائركم معكم أئن ذكرتم} [19] بهمزة واحدة غير ممدودة مثل {إذا وأنا}.(@)(@@) PageV01P369(@)(@@) وقرأ ابن كثير ونافع ويعقوب {أئن ذكرتم} بهمزة واحدة غير ممدودة. وقرأ ابن عامر وعاصم وحمزة والكسائي وخلف {أئن ذكرتم} بهمزتين. وكل ما أشبهه مثله في جميع القرآن إلا ما تقدم ذكره في سورة "الأعراف" وغيرها والله أعلم به.(@)(@@) - قرأ أبو جعفر وحده {إن} بهمزة واحدة مطولة مفتوحة {ذكرتم} خفيفة.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو جعفر وحده {إن كانت إلا صيحة واحدة} [29] بالرفع. وكذلك ما بعده [آية 53] وقرأ الباقون {إلا صيحة واحدة} بالنصب هاهنا وما بعده في الموضعين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ عاصم وابن عامر وحمزة {وإن كل لما جميع} [32] مشددة الميم. وقرأ الباقون {لما} خفيفة.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ عاصم في رواية [169 ب] أبي بكر، وحمزة والكسائي وخلف {وما عملته أيديهم} [35] بغير الهاء. وقرأ الباقون {وما عملته} بالهاء.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو جعفر وابن عامر وعاصم وحمزة والكسائي وخلف، ورويس عن يعقوب، {والقمر قدرناه} [39] بالنصب.(@)(@@) وقرأ نافع وابن كثير وأبو عمرو ويعقوب {والقمر} بالرفع.(@)(@@) PageV01P370(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ يعقوب برواية زيد {والشمس تجري لمستقر لها} [38] بكسر القاف. وقرأ الباقون {لمستقر} بفتح القاف.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر ويعقوب {أنا حملنا ذريتهم} [41] بالألف وكسر التاء.(@)(@@) وقرأ الباقون {ذريتهم} بغير ألف، وفتح التاء.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ ابن كثير، وورش عن نافع، ومحمد بن حبيب عن الأعشى، وروح وزيد عن يعقوب، {تأخذهم وهم يخصمون} [49] بفتح الياء والخاء وتشديد الصاد.(@)(@@) وقرأ أبو عمرو بفتح الخاء أيضا، إلا أنه يشمه الفتح ولا يشبعه. وقرأ أبو جعفر، ونافع برواية إسماعيل وقالون {يخصمون} ساكنة 
ms156	 الخاء مشددة الصاد.(@)(@@) وقرأ حمزة {يخصمون} ساكنة الخاء خفيفة الصاد.(@)(@@) وقرأ عاصم وابن عامر والكسائي وخلف، ورويس عن يعقوب، {يخصمون} بفتح الياء وكسر الخاء وتشديد الصاد.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ نافع وابن كثير وأبو عمرو، وروح عن يعقوب، {إن أصحاب الجنة اليوم في شغل فاكهون} [55] ساكنة الغين. وقرأ الباقون {شغل} بضم الغين.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ أبو جعفر وحده {فاكهون} [55] بغير ألف في جميع القرآن، ووافقه حفص، في سورة "المطففين" [آية 31] {انقلبوا فكهين} بغير ألف في هذا الحرف فقط. وقرأ الباقون {فاكهين} و {فاكهون} في جميع القرآن.(@)(@@) PageV01P371(@)(@@)(@@)(@@) | 14 - (@)(@@) قرأ حمزة والكسائي وخلف {هم وأزواجهم في ظلال} [56] بغير ألف، وضم الظاء وقرأ الباقون {ظلال} بالألف وكسر الظاء.(@)(@@)(@@)(@@) | 15 - (@)(@@) قرأ أبو جعفر ونافع وعاصم {ولقد أضل منكم جبلا} [62] بكسر الجيم والباء وتشديد اللام. وقرأ أبو عمرو وابن عامر {جبلا} بضم الجيم وسكون الباء. وقرا يعقوب برواية روح وزيد {جبلا} بضم الجيم والباء وتشديد اللام مثل قراءة الحسن وابن أبي اسحاق وغيرهما. وقرأ حمزة وابن كثير والكسائي وخلف، ورويس عن يعقوب، {جبلا} بضم الجيم والباء وتخفيف اللام.(@)(@@)(@@)(@@) | 16 - (@)(@@) قرأ عاصم في رواية أبي بكر {على مكانتهم} [67] بالألف على الجمع في جميع القرآن.(@)(@@) وقرأ الباقون {مكانتهم} على واحدة كل القرآن.(@)(@@)(@@)(@@) | 17 - (@)(@@) قرأ عاصم وحمزة {ومن نعمره ننكسه} [68] بضم النون الأولى وكسر الكاف مشددة. وقرأ الباقون {ننكسه} بفتح النون الأولى وسكون الثانية وضم الكاف خفيفة.(@)(@@)(@@)(@@) | 18 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر ويعقوب {أفلا يعقلون} [68] بالتاء. وقرأ الباقون بالياء. وقد ذكرته في سورة "الأنعام".(@)(@@)(@@)(@@) | 19 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر ويعقوب {لينذر(@)(@@) PageV01P372(@)(@@) من كان حيا} [70] بالتاء وفي سورة "الأحقاف" [آية 12] {لينذر الذين ظلموا} بالتاء أيضا. وقرأ ابن كثير هاهنا باليد وهناك {لتنذر} بالتاء قرأ أبو عمرو وعاصم وحمزة والكسائي وخلف {لينذر} بالياء في السورتين.(@)(@@)(@@)(@@) | 20 - (@)(@@) قرأ يعقوب {أوليس الذي خلق السماوات والأرض بقادر على أن يخلق} [81] بالياء وكذلك في آخر سورة "الأحقاف" {ولم يعي بخلقهن بقادر} بالياء أيضا. وهو قراءة استاذه سلام وعاصم الجحدري وغيرهما. وروى أبو علي 
ms157	 الضرير عن روح وزيد عن يعقوب وغيرهما ها هنا {بقادر} بالألف والباء. وهناك {يقدر} بالياء من غير ألف. وهذا قراءة جده عبد الله بن أبي اسحاق الحضرمي، وعيسى بن عمر الثقفي ومالك ابن دينار والأعرج وغيرهم. وقرأ الباقون {بقادر} بالباء والألف في السورتين.(@)(@@)(@@)(@@) | 21 - (@)(@@) قرأ ابن عامر والكسائي {أن يقول له كن فيكون} [82] بالنصب وقرأ الباقون {فيكون} بالرفع.(@)(@@) [اثبات الياءات وفتحها وارسالها](@)(@@) قرأ نافع برواية ورش وحده {ولا ينقذون} [23] بإثبات الياء في الوصل، يعقوب بإثبات الياء في الوصل والوقف؛(@)(@@) PageV01P373(@)(@@) وكذلك مذهبه كل القرآن في جميع أشباهه وقد مر ذكره. الباقون بحذف الياء.(@)(@@) قرأ حمزة ويعقوب وخلف {وما لي لا أعبد} [22] ساكنة الياء. وقرأ الباقون {وما لي لا أعبد} بفتح الياء.(@)(@@) فتح أبو جعفر ونافع وأبو عمرو {إني إذا} [24] و {إني آمنت} [25].(@)(@@) وفتح ابن كثير {إني آمنت} ولم يفتح الآخرون منها شيئا والله أعلم.(@)(@@) PageV01P374(@)(@@) صورة الصافات(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة، وحفص عن عاصم، {إنا زينا السماء الدنيا بزينة} [6] منونة {الكواكب} بالخفض. وقرأ عاصم في رواية أبي بكر {بزينة} منونة {الكواكب} بالنصب.(@)(@@) وقرأ الباقون {بزينة الكواكب} على الإضافة غير منونة.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ حمزة والكسائي، وحفص عن عاصم، وخلف {لا يسمعون إلى الملإ الأعلى} [8] مشددة السين. وقرأ الباقون {لا يسمعون} خفيفة السين.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة والكسائي وخلف {بل عجبت ويسخرون} [12] بضم التاء وقرأ الباقون بفتح التاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر ونافع والكسائي ويعقوب {أإذا متنا} [16] بالاستفهام: أبو جعفر، ونافع برواية قالون، وزيد عن يعقوب بهمزة واحدة ممدودة.(@)(@@) ونافع ويعقوب في سائر الروايات بهمزة غير ممدودة.(@)(@@) PageV01P375(@)(@@) والكسائي بهمزتين. {أإنا لمبعوثون} [16] بكسر الألف غير مستفهم.(@)(@@) وقرأ ابن عامر {أإذا} بكسر الألف غير مستفهم [أإنا] بهمزتين.(@)(@@) ابن كثير يستفهم فيهما بهمزة غير مطولة. وأبو عمرو يستفهم فيهما بهمزة مطولة.(@)(@@) - وعاصم وحمزة وخلف يستفهمون فيهما بهمزتين.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة والكسائي وخلف {ولا هم عنها ينزفون} [47] بكسر الزاي. وفي سورة "الواقعة" [آية 19] {لا يصدعون عنها ولا ينزفون} بكسر الزاي.(@)(@@) وقرأ عاصم هاهنا بفتح الزاي وهناك 
ms158	 بكسر الزاي. وقرأ الباقون {ينزفون} بفتح الزاي في السورتين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ حمزة وحده {فأقبلوا إليه يزفون} [94] بضم الياء. وقرأ الباقون {يزفون} بفتح الياء.(@)(@@)(@@)(@@) | 7 - (@)(@@) قوله تعالى {يقول أإنك لمن المصدقين (52) أإذا متنا وكنا ترابا وعظاما أإنا لمدينون} [53].(@)(@@) قرأ أبو جعفر {أإنا لمدينون} بهمزة واحدة ممدودة على الاستفهام. وقرأ {أإنك} و {أإذا متنا} بكسر الألف من غير استفهام.(@)(@@) وقرأ نافع {أإنك} و {أإذا} بالاستفهام فيهما جميعا بهمزة واحدة غير ممدودة - إلا في رواية قالون - فإنه بمد الهمزة. {أإنا لمدينون} بكسر الألف من غير استفهام.(@)(@@) PageV01P376(@)(@@) وكذلك الكسائي: يستفهم في {أإنك} و {أإذا} إلا إنه يهمز همزتين. ولا يستفهم في {أإنا لمدينون}.(@)(@@) - وقرأ ابن عامر {أإنك} بهمزتين {أإذا متنا} بكسر الألف غير مستفهم {أإنا لمدينون} مستفهم بهمزتين.(@)(@@) - وقرأ يعقوب {أإنك} مستفهما بهمزة واحدة غير مطولة - إلا في رواية زيد - {أإذا} بكسر الألف وكذلك {أإنا} بكسر الألف من غير استفهام فيهما.(@)(@@) وقرأ ابن كثير {أإنك، أإذا أإنا} بالاستفهام في جميعها بهمزة واحدة غير مطولة. وقرأ أبو عمرو أيضا بالاستفهام في جميعها بهمزة واحدة مطولة.(@)(@@) - وقرأ عاصم وحمزة وخلف بالاستفهام في جميعها أيضا إلا أنهم يهمزون همزتين. والله أعلم بذلك.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ حمزة والكسائي وخلف {فانظر ماذا ترى} [102] بضم التاء وكسر الراء. وقرأ الباقون {ماذا ترى} بفتح التاء.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ ابن عامر {وإن إلياس} [123] بقطع الألف مثل سائر القراء. ومن ذكر عنه وصل الألف فيه فقد أخطأ وغلط، وكان أهل الشام ينكرونه ولا يعرفونه. والله أعلم.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو وابن عامر، وأبو بكر عن عاصم، {الله ربكم ورب آبائكم الأولين} [126] بالرفع.(@)(@@) PageV01P377(@)(@@) وقرأ حمزة والكسائي، وحفص عن عاصم، ويعقوب وخلف {الله ربكم ورب آبائكم الأولين} بالنصب.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ نافع وابن عامر، ورويس عن يعقوب {سلام على إل ياسين} [130] بفتح الألف وكسر اللام مقطوعة من {ياسين}. وقرأ الباقون {إل ياسين} بكسر الألف وسكون اللام موصولة بياسين.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ أبو جعفر، ونافع برواية إسماعيل، وورش من طريق الأصبهاني مختلفا عنه: {لكاذبون (152) أصطفى} 
ms159	 [152 - 153] موصولة الألف. والابتداء {أصطفى} بكسر الألف.(@)(@@) وقرأ الباقون {لكاذبون (152) أصطفى} بفطع الألف، وكذلك ورش من طريق البخاري وغيره، والابتداء به مستفهم كما في الوصل.(@)(@@) اثبات الياءات وفتحها(@)(@@) ورش عن نافع {إن كدت لتردين} [56] باثبات الياء مثل قراءة يعقوب إلا أنه في الوصل، ويعقوب في الوصل والوقف الباقون بحذف الياء.(@)(@@) PageV01P378(@)(@@) - قرأ حفص عن عاصم {قال يا بني إني أرى} بفتح الياء. وكذلك يفعل في {يا بني} في جميع القرآن. وقد تقدم في مواضع ذكره. وقرأ الباقون {يا بني} بكسر الياء.(@)(@@) فتح أبو جعفر ونافع {إني أرى في المنام أني أذبحك} [102] و {قال يا أبت افعل ما تؤمر ستجدني إن شاء الله} [102].(@)(@@) وفتح ابن كثير وأبو عمرو {إني أرى في المنام أني أذبحك}. ولم يفتح الباقون منها شيئا.(@)(@@) PageV01P379(@)(@@)(@@)(@@) | سورة ص(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة والكسائي وخلف {ما لها من فواق} [15] بضم الفاء. وقرأ الباقون {من فواق} بفتح الفاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر، والأعشى والبرجمي عن أبي بكر عن عاصم {ليدبروا} [29] بالتاء وتخفيف الدال.(@)(@@) وقرأ الباقون {ليدبروا آياته} بالياء وتشديد الدال.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر {بنصب وعذاب} [41] بضم النون والصاد.(@)(@@) وقرأ يعقوب {بنصب} بفتح النون والصاد. وقرأ الباقون {بنصب} بضم النون وسكون الصاد.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ ابن كثير وحده {واذكر عبادنا إبراهيم} [45] بغير ألف وفتح العين على واحدة. وقرأ الباقون {عبادنا} بالألف وكسر العين على الجمع.(@)(@@) PageV01P380(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو جعفر ونافع {إنا أخلصناهم بخالصة ذكرى الدار} غير منونة وقرأ الباقون {بخالصة} منونة.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ ابن كثير وأبو عمرو {هذا ما توعدون} [53] بالياء. وقرأ الباقون بالتاء.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ حمزة والكسائي وخلف، وحفص عن عاصم، {حميم وغساق} [57] مشددة السين حيث كان. وقرأ الباقون {وغساق} خفيفة السين كل القرآن.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو عمرو ويعقوب {وآخر من شكله أزواج} [58] بضم الألف. وقرأ الباقون {وآخر} بفتح الألف.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر وعاصم {من الأشرار (62) أتخذناهم} [62 و63] [بقطع الألف على الاستفهام وقرأ الباقون] بوصل الألف. والابتداء منه {أتخذناهم} بكسر الألف. 
ms160	(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع وحمزة والكسائي وخلف {سخريا} [63] بضم السين. وقرأ ابن كثير وابن عامر وعاصم وأبو عمرو ويعقوب {سخريا} بكسر السين.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ أبو جعفر {إن يوحى إلي إلا أنما أنا نذير مبين} [70] بكسر الألف. وقرأ الباقون {إلا أنما} بفتح الألف.(@)(@@) PageV01P381(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ عاصم وحمزة وخلف، وروح وزيد عن يعقوب، {قال فالحق} [84] بالرفع {والحق} بالنصب. وقرأ الباقون، ورويس عن يعقوب، وهبيرة عن حفص عن عاصم {فالحق والحق} بالنصب فيهما.(@)(@@) فتح الياءات(@)(@@) قرأ حمزة وحده {مسني الشيطان} [44] مرسلة الياء غير مفتوحة. وقرأ الباقون {مسني الشيطان} بفتح الياء.(@)(@@) وفتح عاصم في رواية حفص، والأعشى والبرجمي عن أبي بكر {ولي نعجة واحدة} [23] وفتح حفص أيضا {ما كان لي من علم} [69].(@)(@@) وفتح أبو جعفر ونافع {فقال إني أحببت} [32] {من بعدي إنك} [35] {وإن عليك لعنتي إلى يوم الدين} [78].(@)(@@) وفتح أبو عمرو {إني أحببت} و {من بعدي إنك}.(@)(@@) وفتح ابن كثير {إني أحببت}. ولم يفتح الباقون منها شيئا.(@)(@@) PageV01P382(@)(@@)(@@)(@@) | سورة الزمر(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر، ونافع برواية ورش وقالون، وأبو عمرو برواية شجاع وأبي أيوب وصاحب السجادة عن اليزيدي، وعاصم وحمزة ويعقوب {وإن تشكروا يرضه لكم} [7] بضم الهاء مختلسة غير مشبعة. وقرأ أبو عمرو في رواية الدوري وأبي شعيب السوسي وأوقية عن اليزيدي، وحمزة في رواية العجلي {يرضه لكم} ساكنة الهاء.(@)(@@) قرأ ابن كثير وابن عامر والكسائي وخلف، وإسماعيل عن نافع، وأبو حمدون وأبو عبد الرحمن بن اليزيدي عن اليزيدي، والبرجمي عن أبي بكر {يرضه لكم} مضمومة الهاء مشبعة.(@)(@@) PageV01P383(@)(@@) - {وجعل لله أندادا ليضل عن سبيله} [8] ذكرته في سورة "لقمان" و"الأنعام".(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير وحمزة {أمن هو قانت} [9] خفيفة الميم. وقرأ الباقون {أمن هو قانت} مشددة الميم.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ ابن كثير وأبو عمرو ويعقوب {ورجلا سلما لرجل} [29] بالألف وكسر اللام وقرأ الباقون {سلما} بغير ألف وفتح اللام.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر وحمزة والكسائي وخلف {أليس الله بكاف عبده} [36] بالألف على الجمع. وقرأ الباقون {عبده} بغير ألف وفتح العين على واحدة.(@)(@@)(@@)(@@) | 5 