ms301	 وفي رواية صفوان عنه امارة أخرى على وثاقته.(@)(@@) PageV01P411(@)(@@)(@@)(@@) $ 3332 - أيوب بن المهلب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3333 - أيوب بن النبال الكوفي " ق ".(@)(@@)(@@)(@@) $ 3334 - أيوب بن واقد البصري " ق ".(@)(@@)(@@)(@@) $ 3335 - أيوب بن هلال الشامي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3336 - بحر بن زياد البصري " ق ".(@)(@@)(@@)(@@) $ 3337 - بحر الطويل الكوفي صاحب متاع مصر " ق ".(@)(@@)(@@)(@@) $ 3338 - بحر بن عدي أبو يحيى الكوفي الوابشي " ق ".(@)(@@)(@@)(@@) $ 3339 - بحر بن كثير السقاء البصري " ق " عده خالي " ح " لان للصدوق طريقا إليه، ويروي عنه حماد بواسطة حريز، وفيه اشعار باعتماده عليه، وقال جدي:(@)(@@) يمكن الحكم بصحة حديثه لذلك، وفيه تأمل مضى " تعق ".(@)(@@)(@@)(@@) $ 3340 - بحر المسلي كوفي " ق ".(@)(@@)(@@)(@@) $ 3341 - بدار بن راشد الكندي كوفي " ق ".(@)(@@)(@@)(@@) $ 3342 - بدر بن رشيد البكري مولاهم " ق ".(@)(@@)(@@)(@@) $ 3343 - بدر بن عمرو العجلي كوفي " ق ".(@)(@@)(@@)(@@) $ 3344 - بدر بن مصعب الحرامي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3345 - بدر بن الوليد الخثعمي كوفي " قي ".(@)(@@)(@@)(@@) $ 3346 - بدر بن الوليد الكوفي " ق " ولعله الذي ذكر في " قي " ويظهر من الشيخ أبي علي اتحاده معه، وفي " تعق " من بعض رواياته في الكافي كونه اماميا، ويروي عنه ابن أبي عمير بواسطة ابن مسكان، وفيه اشعار بالاعتماد والوثاقة.(@)(@@)(@@)(@@) $ 3347 - بدل بن سليمان " ق ".(@)(@@)(@@)(@@) $ 3348 - البراء بن محمد الكوفي، ثقة " صه " " جش " له كتاب، عنه أيوب بن نوح " جش " وهو كأخيه في السابقة أيضا.(@)(@@)(@@)(@@) $ 3349 - برد بن أبي زياد أبو عمرو، مولى بني هاشم كوفي " ق ".(@)(@@)(@@)(@@) $ 3350 - برد بن زائدة الجعفي، مولاهم الكوفي " ق ". PageV01P412(@)(@@)(@@)(@@) $ 3351 - بردة بن رجاء الكوفي " ق ".(@)(@@)(@@)(@@) $ 3352 - بريد بن إسماعيل الطائي أبو عامر كوفي " ق ".(@)(@@)(@@)(@@) $ 3353 - بريد بن عامر الأسلمي، مولاهم المدني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3354 - بريد الكناسي " ق ".(@)(@@)(@@)(@@) $ 3355 - بريد مولى عبد الرحمن القصير كوفي " ق ".(@)(@@)(@@)(@@) $ 3356 - برية العبادي " ست " " ق " الحبري أسلم على يد " ق " عليه السلام يقال: روى عنه ابن أبي عمير " ق " وفي " ست " برية الأنصاري، له كتاب، عنه عبيس واستظهر أنهما واحد.(@)(@@)(@@)(@@) $ 3357 - برية النصراني، له كتاب " ست " وقد توهم بعض اتحاده مع السابق، كما يظهر من " جش " حيث ذكر 
ms302	 في ترجمة العبادي أنه أسلم على يديه وهو هذا لا العبادي، وقد ذكره في " ست " مكررا، ويلوح من الميرزا اتحاده، فلم يذكر أنه الأول بل قد صرح به في الوسيط، فتأمل.(@)(@@)(@@)(@@) $ 3358 - بزيع (1)، في الصحيح عن الصادق عليه السلام أنه قال عندما أخبر بقتله: الحمد لله أما أنه ليس لهؤلاء شئ خير من القتل، لانهم لا يتوبون أبدا. وفي آخر فيه محمد بن خالد الطيالسي، وهو غير مصرح بالتوثيق أنه عليه السلام لعنه، فالرجل مردود.(@)(@@)(@@)(@@) $ 3359 - بزيع مولى عمرو بن خالد كوفي " ق ".(@)(@@)(@@)(@@) $ 3360 - بزيع المؤذن " ق ".(@)(@@)(@@)(@@) $ 3361 - بسر بن أبي غيلان الكوفي " ق " وفي " صه " بضم الباء واسكان السين.(@)(@@)(@@)(@@) $ 3362 - بسطام بياع اللؤلؤ، روى عنه علي بن شجرة " ق " وعلي أيضا من(@)(@@) PageV01P413(@)(@@) أصحابه عليه السلام يروي عنه.(@)(@@)(@@)(@@) $ 3363 - بسطام الحذاء كوفي " ق ".(@)(@@)(@@)(@@) $ 3364 - بسطام بن الحصين الجعفي الكوفي " ق " ابن أخ خثيمة وإسماعيل كان وجها في أصحابنا وأبوه وعمومته وكان أوجههم إسماعيل " صه " " جش ".(@)(@@)(@@)(@@) $ 3365 - بسطام بن سابور الزيات أبو الحسين الواسطي، مولى ثقة، واخوته زكريا وزياد وحفص كلهم ثقات رووا عن " ق " و " ظم " عليهما السلام. ويقال: بسطام الزيات، وبسطام بن الزيات، فقد يتكرر وهو واحد.(@)(@@)(@@)(@@) $ 3366 - بسطام بن يزيد الجعفي كوفي " ق ".(@)(@@)(@@)(@@) $ 3367 - بشار بن الأسود الكندي مولى " ق ".(@)(@@)(@@)(@@) $ 3368 - بشار الأشعري لعنه الصادق عليه السلام روى " كش " لعنه في معرض كونه كذابا أو عاجز الرأي. استظهر البعض أنه الشعيري، وهو في محله، ويأتي في الكنى في أبي إسماعيل الشعيري.(@)(@@)(@@)(@@) $ 3369 - بشار بن بشار، يأتي في ابن يسار " تعق " أقول: قد ذكر " جش " بهذا العنوان وأما غيرهما فقد ذكر بالياء المثناة التحتانية والسين المهملة في أبيه، وأياما كان فالرجل واحد.(@)(@@)(@@)(@@) $ 3370 - بشار بن سوار الأحمري كوفي " ق ".(@)(@@)(@@)(@@) $ 3371 - بشار بن عبيد مولى عبد الصمد كوفي " ق ".(@)(@@)(@@)(@@) $ 3372 - بشار بن مزاحم المنقري مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3373 - بشار بن مقرع العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3374 - بشار بن يسار الضبيعي أخوه سعيد مولى ضبيعة بن عجل، ثقة، روى هو وأخوه عن 
ms303	 " ق " و " ظم " عنه ابن أبي عمير، وأبان بن عثمان، وهو خير من أبان.(@)(@@)(@@)(@@) $ 3375 - بشر بن أبي غيلان الكوفي " ق " وقد تقدم بالمعجمة.(@)(@@)(@@)(@@) $ 3376 - بشر بن أبي إسماعيل كوفي، وهو من وجوه من روى الحديث، وفي PageV01P414(@)(@@) بعض النسخ بشير بالياء المثناة من تحت.(@)(@@)(@@)(@@) $ 3377 - بشر بن بيان بن حمران التفليسي نزل المدائن " ق ".(@)(@@)(@@)(@@) $ 3378 - بشر بن حسان الذهلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3379 - بشر بن زادان الجرزي، أسند عنه " ق " (@)(@@)(@@)(@@) $ 3380 - بشر بن سلم أبو الحسن الكوفي " ق " ولعله ابن سلام المذكور في الطبقة السابقة، ومن أصحابنا من نقله سالم، فتأمل، هكذا ذكره الميرزا، ولتأمله محل.(@)(@@)(@@)(@@) $ 3381 - بشر بن سليمان البجلي، كوفي، له كتاب، عنه محمد بن الربيع " جش " والظاهر أنه في الطبقة التالية.(@)(@@)(@@)(@@) $ 3382 - بشر بن الصلت العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3383 - بشر بن عائذ الأسدي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3384 - بشر بن عبد الله الشيباني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3385 - بشر بن عتبة الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3386 - بشر بن عمارة الخثعمي الكوفي المكتب، وعن بعض النسخ ابن همام.(@)(@@)(@@)(@@) $ 3387 - بشر بن عياض الأسدي مولاهم " ق ".(@)(@@)(@@)(@@) $ 3388 - بشر بن مروان الكلابي الجعفري الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3389 - بشر بن مسلمة، كوفي ثقة روى عن الصادق عليه السلام يكنى أبا صدقة، له كتاب، عنه ابن أبي عمير، ولعله من أصحاب " ظم " عليه السلام أيضا.(@)(@@)(@@)(@@) $ 3390 - بشر بن ميمون الوابشي النبال، كوفي " ق " الهمداني الكوفي، وأخوه شجرة وهما ابنا أبي أراكة ميمون مولى بن وابش، وهو ميمون بن سنجار، وفي " كش ".(@)(@@) و " صه " و " د " بشير.(@)(@@)(@@)(@@) $ 3391 - بشر بن همام الخثعمي الكوفي المكتب " ق " وفي بعض النسخ ابن عمارة، كما تقدم.(@)(@@)(@@)(@@) $ 3392 - بشير بن إسماعيل بن عمار، من وجوه من روى الحديث " جش ". PageV01P415(@)(@@) وفي بعض النسخ المعتبرة بشر، كما تقدم عن " ق " أيضا.(@)(@@)(@@)(@@) $ 3393 - بشير بن خارجة الجهني المدني " ق ".(@)(@@)(@@)(@@) $ 3394 - بشير الدهان، روى عن " ق " وقيل: يسير بالباء والسين غير المعجمة " ظم ".(@)(@@)(@@)(@@) $ 3395 - بشير بن عاصم البجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3396 - بشير الكناسي، يروي عنه يحيى 
ms304	 الحلبي، وكذا حماد بن عثمان، كما في الكافي في باب طاعة الامام عن بشير العطار عن " ق " قال: سمعته الحديث.(@)(@@) واستظهر في " تعق " اتصافه بالوصفين، ثم قال: وفي رواية الحلبي وحماد عنه اشعار بالاعتماد عليه. وفيه نظر.(@)(@@)(@@)(@@) $ 3397 - بشير النبال، روى " كش " حديثا في طريقه محمد بن سنان، وصالح بن أبي حماد، وليس صريحا في تعديله، فأنا في روايته متوقف " صه " وفي الوجيزة " ح ".(@)(@@)(@@)(@@) $ 3398 - بكار بن أبي بكر الحضرمي الكوفي " ق " وفي " تعق " روى عنه صفوان بن يحيى بواسطة منذر، وفيه نوع اعتماد، وعن " في " بكار بن بكر روى عنه يونس فتأمل (1).(@)(@@)(@@)(@@) $ 3399 - بكار بن رجاء اليشكري كوفي " ق ".(@)(@@)(@@)(@@) $ 3400 - بكار بن زياد الكوفي الخزاز " ق ".(@)(@@)(@@)(@@) $ 3401 - بكار بن عاصم، مولى لعبد القيس " ق ".(@)(@@)(@@)(@@) $ 3402 - بكار بن عبد الله بن مصعب، وكان قد ظلم " ظم " عليه السلام في شئ، فدعا عليه فسقط في وقت دعائه عليه من قصر فاندقت عنقه. وأما أبوه عبد الله، ففيه حكاية.(@)(@@)(@@)(@@) $ 3403 - بكار بن كردم الكوفي " ق " " د " في " تعق " قيل: بفتح الكاف وسكون الراء وفتح الدال المهملة، يروي عنه ابن أبي عمير ويونس بن عبد الرحمن. ويظهر(@)(@@) PageV01P416(@)(@@) في أخباره حسن عقيدته. وحكم خالي بحسنه لان للصدوق طريقا إليه.(@)(@@)(@@)(@@) $ 3404 - بكر بن أبي بكر عبد الله بن محمد الحضرمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3405 - بكر بن أبي حبيب كوفي " ق ".(@)(@@)(@@)(@@) $ 3406 - بكر بن الأرقط " ق ".(@)(@@)(@@)(@@) $ 3407 - بكر بن حاجب التميمي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3408 - بكر بن حبيس الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3409 - بكر بن حرب الشيباني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3410 - بكر بن زياد الجعفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3411 - بكر بن صالح الرازي الضبي مولى " ضا " مولى بني ضبة، روى عن " ظم " ضعيف جدا كثير التفرد بالغرائب " صه " " جش ".(@)(@@)(@@)(@@) $ 3412 - بكر بن عبد الله الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3413 - بكر بن عمير الهمداني الارجي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3414 - بكر بن عيسى أبو زيد البصري الأحول، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3415 - بكر بن محمد الأزدي أبو محمد الكوفي، عربي وجه في هذه 
ms305	 الطائفة من بيت جليل بالكوفة من آل نعيم الغامديين عمومته شديد وعبد السلام، وابن عمه الأخير موسى من أصحاب " ظم " و " ضا " عليهما السلام وعمتة غنيمه روت عن " ق " و " ظم " عليهما السلام، وعمر حتى يروي عن " ق ".(@)(@@)(@@)(@@) $ 3416 - بكر بن محمد بن عبد الرحمن بن نعيم الغامدي الأزدي أبو محمد، وجه في هذه الطائفة من بيت جليل في الكوفة كان ثقة، وقد تقدم الكلام فيه، وهو في السابقة.(@)(@@)(@@)(@@) $ 3417 - بكر بن محمد العبدي العابد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3418 - بكروية المحاربي مولاهم صاحب آدم كوفي " ق ".(@)(@@)(@@)(@@) $ 3419 - بكر بن أحمد النخعي الكوفي، يقال له: الغنوي نزل غنى " ق ".(@)(@@)(@@)(@@) $ 3420 - بكير بن عبيد الكوفي " ق ". PageV01P417(@)(@@)(@@)(@@) $ 3421 - بكير بن قابوس بن أبي ظبيان الجهني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3422 - بكير بن قطرب بن خليفة أبو عمرو، مولى عمرو بن حريث الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3423 - بكير بن واصل البرجمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3424 - بهلول الشهير بالمجنون، يظهر من كتب السير وغيرها فضله وجلالته وعلو رتبته، وان لم يذكر في الرجال، الا أن ذلك معلوم بالتسامع والتظافر، وله حكاية مع أبي حنيفة معروفة، وكذا مع غيره من أعداء الدين مناظرات جيدة، وقبره " ره " في بغداد.(@)(@@)(@@)(@@) $ 3425 - بيان الجزري كوفي أبو أحمد مولى، قال محمد بن عبد الحميد: كان خيرا فاضلا " صه " " جش " مع زيادته له كتاب، يحيى بن محمد العليمي عنه به، وفي الوجيزة " ح " وفي الحاوي ذكره في الحسان، والجرزي بفتح الجيم والراء بعدها كما عن " ضح ".(@)(@@)(@@)(@@) $ 3426 - تليد بن سليمان أبو إدريس المحاربي، روى عن " ق " عليه السلام له كتاب يرويه عنه جماعة " جش " وفي " صه " لم أقف لاحد من علمائنا على جرحه ولا على تعديله، لكن عن ابن نمير ثقة (1).(@)(@@)(@@)(@@) $ 3427 - ثابت بن توبة أبو هارون السخي يأتي في الكنى " تعق " وسنذكره فيها انشاء الله.(@)(@@)(@@)(@@) $ 3428 - ثابت بن حماد البصري " ق ".(@)(@@)(@@)(@@) $ 3429 - ثابت بن درهم الجعفي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3430 - ثابت بن شريح أبو إسماعيل الصائغ الأنباري مولى الأزد، ثقة، روى عن " ق " عليه 
ms306	 السلام له كتاب في أنواع الفقه، يرويه عنه جماعات منهم عبيس(@)(@@) PageV01P418(@)(@@) وابن نهيك وخالد، ولعله في السابقة أيضا.(@)(@@)(@@)(@@) $ 3431 - ثابت بن عبد الله، وهو ثابت بن أبي ثابت البجلي الكوفي " ق " وهو ثابت أبو سعيد.(@)(@@)(@@)(@@) $ 3432 - ثابت مولى جرير " ق ".(@)(@@)(@@)(@@) $ 3433 - ثبيت بن محمد مصغرا، أبو محمد العسكري صاحب أبي عيسى الوراق، متكلم حاذق من أصحابنا العسكريين، وكان له اطلاع بالحديث والفقه، وهو ممن كان يروي عن " ق " عليه السلام ولعله أيضا في السابقة.(@)(@@)(@@)(@@) $ 3434 - ثبيت بالتصغير ابن نشيط الكوفي " ق ".(@)(@@)(@@)(@@) $ 3435 - ثعلبة بن راشد الأسدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3436 - ثمامة بن عمرو وأبو سعيد الأودي العطار الكوفي " ق ".(@)(@@)(@@)(@@) $ 3437 - ثوير بن أبي فاخته سعيد بن علاقة، نسبه العامة إلى الرفض، وهي امارة على اماميته، وفي " تعق " لا تأمل في كونه من مشاهير الشيعة. وفي الوجيزة فيه مدح وذم، وروي قال: أشفقت على أبي جعفر من مسائل هيأها له عمرو بن ذر وابن قيس الماصر والصلت بن بهرام. وقال الشهيد: ان دلالته على القدح أظهر، لأنه يدل على عدم علمه بحقيقة الامام، والتوقف أولى.(@)(@@)(@@)(@@) $ 3438 - ثوير بن عمارة الأزدي الكوفي أبو الحسن " ق " وعن نسخة ثور.(@)(@@)(@@)(@@) $ 3439 - ثوير بن عمرو بن عبد الله المرهبي الهمداني الكوفي، أسند عنه " ق " وعن نسخة ثور مكبرا.(@)(@@)(@@)(@@) $ 3440 - جابر بن أبحر النخعي الكوفي الصهباني " ق ".(@)(@@)(@@)(@@) $ 3441 - جابر بن شمير الأسدي، كوفي أبو العلاء، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3442 - جابر المكفوف الكوفي " ق " روى " كش " أن " ق " عليه السلام وصله بثلاثين دينارا وعوض بمدحه، وروى عن " عقد " مثل ما روي عن " كش " مع الاختلاف في اللفظ، وفي الوجيزة " ح ".(@)(@@)(@@)(@@) $ 3443 - جابر بن يزيد، روى " كش " فيه المدح وبعض الذم وكلاهما PageV01P419(@)(@@) ضعيفان سندا و " عق " روى أن " ق " عليه السلام ترحم عليه وقال: انه كان يصدق علينا ولعن المغيرة، وثقه " غض " في نفسه ولكن جل من روى عنه ضعيف، فيترك ما روى هؤلاء عنه ووقف في الباقي " صه " والترك أولى.(@)(@@)(@@)(@@) $ 3444 - الجارود بن عمر الطائي الكوفي " ق 
ms307	 ".(@)(@@)(@@)(@@) $ 3445 - الجارود بن المنذر أبو المنذر الكندي النخاس، كوفي ثقة ثقة، روى عن " ق " عليه السلام ذكره أبو العباس " جش " ويظهر من " جخ " دركه خمسة من الأئمة، وهو بعيد. عنه علي بن الحسن بن رباط، ومحمد بن أبي حمزة.(@)(@@)(@@)(@@) $ 3446 - جبلة بن أعين الجعفي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3447 - جبلة بن حنان بن أبحر الكناني الكوفي، أسند عنه " ق " و " جش " جلبة وهو غلط، وهو والد عبد الله بن جبلة، وقد أشار إليه الشيخ أبو علي " ره ".(@)(@@)(@@)(@@) $ 3448 - جبلة بن الحجاج الصيرفي كوفي " ق ".(@)(@@)(@@)(@@) $ 3449 - جبلة الخراساني، الذي حدث عنه يحيى بن سالم " ق ".(@)(@@)(@@)(@@) $ 3450 - جبلة بن عياض، قال في المنتهى في الكنى: أبو الحسن اسمه جبلة بن عياض ومضى موثقا عن " جش " و " صه " وكأن الميرزا قد غفل عن ذلك وفي الوجيزة " م " وهو سهو من قلمه (1) انتهى. أقول: وهو سهو أيضا من قلمه، إذ لم أجده في رجاله (2) أيضا مع تعدد النسخ الموجودة عندي، فلاحظ.(@)(@@)(@@)(@@) $ 3451 - جبير بن الأسود النخعي أبو عبيد مولى عبد الرحمن بن عابس الصهبائي " ق ".(@)(@@)(@@)(@@) $ 3452 - جبير بن حفص الغمشاني الكوفي أبو الأسود، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3453 - جبير، روى عنه يونس بن يعقوب " ق ".(@)(@@)(@@)(@@) $ 3454 - جحدر بن المغيرة الطائي، يروي عن " ق " عليه السلام قال " غض ": انه كان خطابيا في مذهبه ضعفا، وكتابه لم يرو الا من طريق واحد.(@)(@@) PageV01P420(@)(@@)(@@)(@@) $ 3455 - الجراح بن عبد الله المدني " ق ".(@)(@@)(@@)(@@) $ 3456 - الجراح المدائني " قر " " ق " روى عن " ق " يروي عنه النضر بن سويد بكتابه، وكذا غيره، وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 3457 - الجراح بن مليح الرواسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3458 - جريد بن أحمر العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3459 - جرير بن حكيم الأزدي المدائني أخو مرازم " ق " والظاهر أنه يروي عن " ق " عليه السلام كأخيه المرازم الثقة، وهو أيضا يروي عن " ظم " عليه السلام وله أخ آخر محمد، وجديد في نسخة ولعله مصحف جرير هذا.(@)(@@)(@@)(@@) $ 3460 - جرير بن عبد الحميد الضبي الكوفي نزل الري " ق ".(@)(@@)(@@)(@@) $ 3461 - جرير بن عثمان " ق " وقد كان يبغض 
ms308	 عليا عليه السلام كما عن ابن أبي الحديد، قال محفوظ: قلت ليحيى بن صالح قد رويت من مشايخ نظراء جرير، فما بالك لم تحمل عن جرير؟ قال: اني أتيته فناولني كتابا فإذا فيه حدثني فلان عن فلان ان النبي صلى الله عليه وآله الحديث (1).(@)(@@)(@@)(@@) $ 3462 - جرير بن عجلان الأزدي الكسائي كوفي " ق ".(@)(@@)(@@)(@@) $ 3463 - جعفر بن إبراهيم بن محمد بن علي بن عبد الله بن جعفر الطيار، روى عن " ق " عليه السلام ثقة، وفي " ق " المدني.(@)(@@)(@@)(@@) $ 3464 - جعفر بن أبي عثمان أو سليمان الفزاري الكوفي " ق " قال الميرزا:(@)(@@) وقبيله بلا فصل وهو يدل على التعدد.(@)(@@)(@@)(@@) $ 3465 - جعفر بن أبي عثمان الفزاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3466 - جعفر الأزدي، له كتاب، عنه ابن أبي عمير " ست " ويأتي " جش " الأودي. ويحتمل التصحيف، ورواية ابن أبي عمير عنه دليل الوثاقة.(@)(@@) PageV01P421(@)(@@)(@@)(@@) $ 3467 - جعفر الأودي كوفي، له كتاب، عنه محمد بن أبي عمير " جش " وتقدم عن " ست " الأزدي.(@)(@@)(@@)(@@) $ 3468 - جعفر بن بزاز بن حيان الهاشمي، مولاهم الصيرفي " ق ".(@)(@@)(@@)(@@) $ 3469 - جعفر بن الحارث، أبو الأشهب النخعي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3470 - جعفر بن حبيب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3471 - جعفر بن حيان الصيرفي الكوفي " ق " ثم جعفر بن حيان الصيرفي أخو هذيل، ثم في " ظم " جعفر بن حيان واقفي، ولا يخفى كونه في السابقة أيضا.(@)(@@)(@@)(@@) $ 3472 - جعفر بن سارة الطائي كوفي مولى " ق ".(@)(@@)(@@)(@@) $ 3473 - جعفر بن سليمان الضبعي البصري " ق " " جخ " ثقة أبو سليمان صدوق زاهد، ومع كثرة علومه قيل: كان أميا، وهو من زهاد الشيعة، مات سنة ثمان وسبعين ومائة.(@)(@@)(@@)(@@) $ 3474 - جعفر بن سويد الجعفري القيسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3475 - جعفر بن سويد مولى بني سليم كوفي " ق ".(@)(@@)(@@)(@@) $ 3476 - جعفر بن شبيب النهدي، يعرف بالبرذون الكوفي " ق ".(@)(@@)(@@)(@@) $ 3477 - جعفر بن عبد الله بن جعفر بن محمد بن علي بن أبي طالب عليه السلام، أسند عنه " ق " وفي المنتهى هو جد جعفر بن عبد الله رأس المذري.(@)(@@)(@@)(@@) $ 3478 - جعفر بن عثمان بن زياد الرواسي، روى " كش " عن حمدوية عن أشياخه انه ثقة 
ms309	 خير فاضل " صه " ابن عثمان الرواسي " ق ".(@)(@@)(@@)(@@) $ 3479 - جعفر بن عثمان بن شريك بن عدي الكلابي الوحيدي، وأخوه الحسين رويا عن " ق " عليه السلام ذكر ذلك أصحاب الرجال، له كتاب، عنه جماعة منهم ابن أبي عمير " جش " وفي روايته عنه ايماء بالوثاقة.(@)(@@)(@@)(@@) $ 3480 - جعفر بن عفان الطائي، فيه رواية غير نقي السند أنه كان شاعرا، له أشعار جيدة في أبي عبد الله الحسين عليه السلام وأنشدها عند الصادق عليه السلام فبكى ومن حوله الا ان العلامة توقف فيه. PageV01P422(@)(@@)(@@)(@@) $ 3481 - جعفر بن عمارة الهمداني الخارفي الكوفي أبو عمارة " ق ".(@)(@@)(@@)(@@) $ 3482 - جعفر بن قرط المزني كوفي " ق ".(@)(@@)(@@)(@@) $ 3483 - جعفر بن قعنب بن أعين " ق " ثم عنه كرر فزاد الكوفي.(@)(@@)(@@)(@@) $ 3484 - جعفر بن محمد بن الأشعث الكوفي " ق ".(@)(@@)(@@)(@@) $ 3485 - جعفر بن محمد بن رباح " ق " بالباء المفردة " د ".(@)(@@)(@@)(@@) $ 3486 - جعفر بن محمد بن شريح الحضرمي، له كتاب، عنه محمد بن أمية " ست " وأبوه من أصحاب " قر " فالظاهر أنه من أصحاب " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3487 - جعفر بن محمد بن يحيى، روى عنه صفوان بن يحيى، وفيه اشعار بوثاقته " تعق " بل على وثاقته، فتأمل.(@)(@@)(@@)(@@) $ 3488 - جعفر بن ناجية ابن أبي عمار الكوفي مولى " ق ".(@)(@@)(@@)(@@) $ 3489 - جعفر بن نجيح المدني جد علي بن المثنى، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3490 - جعفر بن هارون الكوفي أبو عبد الله، من أصحاب " ق " عليه السلام ثقة وهو " صه " " جخ " وزاد " صه " من رجال " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3491 - جعفر بن يحيى بن العلاء أبو محمد الرازي، وأبوه أيضا روى عن " ق " وهو أخلط بنا عن أبيه وأدخل فينا، وكان قاضيا بالري، وهو أيضا في السابقة.(@)(@@)(@@)(@@) $ 3492 - جفير بعد الجيم بالفاء ابن الحكم العبدي بن المنذر، عربي ثقة، روى عن جعفر بن محمد " صه " " جش " الا الترجمة وزاد له كتاب منذر جفير عن أبيه عنه به، ويأتي عن " ق " بالحاء المهملة.(@)(@@)(@@)(@@) $ 3493 - جماعة بن سعد الجعفي الصائغ، روى عن " ق " عليه السلام خرج مع أبي الخطاب وقتل، وهو ضعيف في الحديث ومذهبه ما 
ms310	 ذكرت " صه ".(@)(@@)(@@)(@@) $ 3494 - جماعة بن عبد الرحمن الصائغ الكوفي " ق ".(@)(@@)(@@)(@@) $ 3495 - جمهور بن أحمر العجلي مولاهم " ق ".(@)(@@)(@@)(@@) $ 3496 - جميل بن دراج أبو الصبيح بن عبد الله أبو علي النخعي، وقيل: أبو PageV01P423(@)(@@) محمد شيخنا ووجه الطائفة، وأخوه نوح القاضي وهو أكبر منه وعمي في آخر عمره، مات في أيام الرضا عليه السلام من أصحاب الاجماع، روى عن " ق " و " ظم " عليهما السلام.(@)(@@)(@@)(@@) $ 3497 - جميل الرواسي صاحب السابري، مولى جهم بن حميد الرواسي " ق " ليس العمل بحديثه كأضرابه متجها، والله أعلم.(@)(@@)(@@)(@@) $ 3498 - جميل بن زياد الجملي وفي نسخة البجلي المرادي الكوفي أبو حسان " ق " الا وفي نسخة.(@)(@@)(@@)(@@) $ 3499 - جميل بن صالح الأسدي، ثقة وجه روى عن " ق " وابنه " ظم " عليهما السلام ذكره أبو العباس في كتاب الرجال، له أصل " ست " ابن صالح الكوفي " ق ".(@)(@@)(@@)(@@) $ 3500 - جميل بن عبد الرحمن الجعفي أبو الأسود، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3501 - جميل بن عبد الله بن نافع الخثعمي الخياط الكوفي " ق " " صه " لم أر فيه مدحا، غير أن " عقد " روى عن محمد بن عبد الله بن أبي حكيمة قال: سألنا ابن نمير عنه، فقال: ثقة قد رأيته وأبوه ثقة، ولكن " عقد " زيدي ومحمد مجهول.(@)(@@)(@@)(@@) $ 3502 - جميل بن عبد الله النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3503 - جميل بن عياش، أبو علي البزاز الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3504 - جناب بن عائذ الأسدي، مولى عامر بن عداس، أسند عنه " ق " وهو كأمثاله لا يعمل على ما ينفرد به.(@)(@@)(@@)(@@) $ 3505 - جناب بن نسطاس أبو علي الجبني العرزمي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3506 - جناح بن رزين، مولى مفضل بن قيس بن رمانة الأشعري " ق ".(@)(@@)(@@)(@@) $ 3507 - جناح بن عبد الحميد الكوفي " ق " غير معلوم الحال متروك المقال، كما لا يخفى.(@)(@@)(@@)(@@) $ 3508 - جندب أبو علي الكوفي " ق " وهو كنظائره مطعون فقاهة، والله أعلم.(@)(@@)(@@)(@@) $ 3509 - جندب بن جنادة الكوفي " ق ".(@)(@@)(@@)(@@) $ 3510 - جندب بن رباح الأزدي الكوفي " ق ". PageV01P424(@)(@@)(@@)(@@) $ 3511 - جندب بن صالح البصري الأزدي، أسند عنه " ق " وهو مدح غير واف في قبول الرواية، كما أسبقنا الكلام فيه في 
ms311	 مقدمات الكتاب.(@)(@@)(@@)(@@) $ 3512 - جندب بن عبد الله بن جندب البجلي " ق ".(@)(@@)(@@)(@@) $ 3513 - جندب والد عبد الله بن جندب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3514 - جنيد بن عبد الله أبو عبد الله الضبي، مولاهم الحجام الكوفي " ق ".(@)(@@)(@@)(@@) $ 3515 - جويرية بن أسماء، إسحاق بن محمد، عن علي بن داود الحداد، عن حريز، عن الصادق عليه السلام قال: أما حمران فمؤمن، وأما جويرية فزنديق لا يصلح ابدا، فقتل هارون جويرية بعد ذلك " كش " الا أن إسحاق مرمي بالغلو، وعلي مهمل.(@)(@@)(@@)(@@) $ 3516 - جهم بن حميد الرواسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3517 - جهم بن صالح التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3518 - جهم بن عثمان المدني " ق ".(@)(@@)(@@)(@@) $ 3519 - جهير بن أوس الطائي الثعلبي " ق ".(@)(@@)(@@)(@@) $ 3520 - جيفر بن الحكم العبدي الكوفي " ق " ومضى عن " جش " و " صه " في السابق جفير (1) مصغرا وأنه ثقة، والتعدد محتمل، ويظهر من الميرزا وغيره اتحادهما، والله يعلم.(@)(@@)(@@)(@@) $ 3521 - جفير بن صالح مولى غني كوفي " ق " وجدت في بعض الحواشي نقلا عن التقريب أنه يكنى أبا إسماعيل الحارثي مولاهم، أصله من الكوفة، صحيح الكتاب صدوق، مات سنة ست أو سبع وثمانين بعد المائة. وعن الذهبي محقق ثقة.(@)(@@)(@@)(@@) $ 3522 - حاتم بن إسماعيل المدني، أصله كوفي " ق " مولى بني عبد الدار بن قصي، روى عن " ق " عامي، مات سنة ست وثمانين ومائة " جش " عن الواقدي.(@)(@@) PageV01P425(@)(@@)(@@)(@@) $ 3523 - الحارث بن أبي رسن الأودي الكوفي، قال عقد: انه أول من ألقى التشيع في بني أود " صه " " ق " الا أن فيه الأزدي. ويحتمل التحريف وقيل: وسن بالواو.(@)(@@)(@@)(@@) $ 3524 - الحارث بياع الأنماط، كوفي " ق " والنمط محركا ثوب صوف يطرح على الهودج، والنسبة إليه فيقال: الأنماطي والنمطي.(@)(@@)(@@)(@@) $ 3525 - الحارث بن زياد الشيباني الكوفي أبو العلاء، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3526 - الحارث بن زياد الشامي، لين الحديث الا ان " كش " روى حديثا طريقه معتد به أن " ق " عليه السلام قال: إن الحارث الشامي وحمزة البريدي ملعونان وقد ورد في لعنه أيضا روايات كثيرة.(@)(@@)(@@)(@@) $ 3527 - الحارث بن شريح البصري " ق ".(@)(@@)(@@)(@@) $ 3528 - الحارث بن عمرو الجعفي " ق ".(@)(@@)(@@)(@@) $ 3529 - الحارث بن عمران الجعفي 
ms312	 الكلابي، كوفي ثقة، روى عن جعفر بن محمد عليهما السلام " صه " وزاد " جش " له كتاب يرويه جماعة عنه زكريا بن يحيى، و في " مشكا " ابن عمران الثقة الجعفي، عنه زكريا بن يحيى وهو عن " ق " عليه السلام توفي سنة ثلاث وأربعين ومائة.(@)(@@)(@@)(@@) $ 3530 - الحارث بن غصين بالمعجمة والمهملة في الصاد، أبو وهب الثقفي الكوفي، قال عقد: عن محمد بن عبد الله بن أبي حكيمة عن ابن نمير أنه ثقة، توفي سنة ثلاث وأربعين ومائة، وفي " ق " بالمعجمتين، أسند عنه.(@)(@@)(@@)(@@) $ 3531 - الحارث بن محمد بن الكوفي " ق ".(@)(@@)(@@)(@@) $ 3532 - الحارث بن محمد بن النعمان البجلي أبو علي كوفي " ق " كان أحول مولى بجيلة، روى عن " ق " عليه السلام له أصل أو كتاب، يرويه الحسن محبوب، وفيه اشعار على الوثاقة.(@)(@@)(@@)(@@) $ 3533 - حازم بن إبراهيم البجلي الكوفي سكن البصرة، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3534 - حامد بن عمير أبو المعمر الهمداني مولاهم، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3535 - حباب بن حيان الطائي الكوفي " ق ". PageV01P426(@)(@@)(@@)(@@) $ 3536 - حباب بن الرئاب العكلي والد زيد بن حباب الكوفي مولى " ق ".(@)(@@)(@@)(@@) $ 3537 - حباب بن محمد الثقفي كوفي " ق ".(@)(@@)(@@)(@@) $ 3538 - حباب بن موسى التميمي السعيدي " ق ".(@)(@@)(@@)(@@) $ 3539 - حباب بن يحيى الكوفي " ق ".(@)(@@)(@@)(@@) $ 3540 - حبيب الأحول الخثعمي كوفي " ق " احتمل الميرزا كونه ابن المعلى الآتي.(@)(@@)(@@)(@@) $ 3541 - حبيب بن بسرة " ق ".(@)(@@)(@@)(@@) $ 3542 - حبيب الجماعي، في نسختي من عبارة المفيد وسنشير إليها في زياد بن المنذر أنه من الفقهاء الاعلام. ويحتمل أن يكون الجماعي مححف الخثعمي " تعق " أقول: ولا يخفى بعده إذ لم ير غيره في نسخة.(@)(@@)(@@)(@@) $ 3543 - حبيب بن زيد الأنصاري، دخل الكوفة عداده في الكوفيين.(@)(@@)(@@)(@@) $ 3544 - حبيب بن المعلى الخثعمي المدائني، روى عن " ق " و " ظم " و " ضا " عليهم السلام، ثقة ثقة صحيح مولى كوفي، له كتاب، عنه ابن أبي عمير، وهو في السابقة، وما ورد في ذمه من أن " ق " عليه السلام قال: يكذب علي غير نقي السند.(@)(@@)(@@)(@@) $ 3545 - حبيب بن نزار بن حيان الهاشمي، مولاهم الكوفي الصيرفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3546 - حبيب بن 
ms313	 النعمان الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3547 - حبيش بن مبشر أخو جعفر، كان من أصحابنا، روى من أحاديث العامة وأكثر، واسمه محمد كما يأتي، له كتاب فيه الطعون على من قدم على " ين " عليه السلام، عنه علي بن الحسين الرزاد، ويأتي ابن أبي عمير عنه.(@)(@@)(@@)(@@) $ 3548 - حجاج الابزاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3549 - حجاج بن حرة الكندي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3550 - حجاج بن رفاعة الخشاب، أبو رفاعة أو أبو علي، روى عن " ق " عليه السلام، ثقة ثقة، ذكره أبو العباس " صه " " جش " الا أن في الأخير ثقة مرة PageV01P427(@)(@@) واحدة، عنه بنو يحيى وميثم وعامر وبشير.(@)(@@)(@@)(@@) $ 3551 - حديد بن حكم الأزدي المدائني، أسند عنه " ق " ثقة وجه متكلم، روى عن " ق " وابنه " ظم " عليهما السلام له كتاب عنه البرقي محمد " ست ".(@)(@@)(@@)(@@) $ 3552 - حذيفة بن عامر الربعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3553 - حذيفة بن منصور، مولى حسين بن زيد العلوي كوفي " ق ".(@)(@@)(@@)(@@) $ 3554 - حريث بن شريح البصري " ق " وقد تقدم مكبرا، والرجل واحد.(@)(@@)(@@)(@@) $ 3555 - حريث بن عمارة الكوفي الجعفي " ق ".(@)(@@)(@@)(@@) $ 3556 - حريث بن عمير العبدي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3557 - حريث بن مهران الكوفي " ق ".(@)(@@)(@@)(@@) $ 3558 - حريز بن عبد الله السجستاني، أبو محمد الأزدي، كوفي ثقة سكن سجستان، كان ممن شهر السيف في قتال الخوارج في حياة " ق " عليه السلام قيل:(@)(@@) روى عنه عليه السلام، وقيل: روى عن " ظم " عليه السلام، وما ورد في الجرح لا يعبأ به.(@)(@@)(@@)(@@) $ 3559 - حريمة بن عمارة الجهني المدني " ق ".(@)(@@)(@@)(@@) $ 3560 - حزام بن إسماعيل العامري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3561 - حزم بن عبيد البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3562 - حسان بن عبد الله الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3563 - حسان بن المعلم " ق ".(@)(@@)(@@)(@@) $ 3564 - حسان بن مهران الجمال، أخو صفوان، ثقة ثقة، أصح وأوجه من صفوان، روى عن " ق " وابنه " ظم " عليهما السلام وفي " جخ " ادعى تعدد ابن مهران:(@)(@@) أحدهما الجمال، والآخر الغنوي.(@)(@@)(@@)(@@) $ 3565 - حسان بن مهران الغنوي الكوفي " ق " وفي " قر " حسان بن مهران، وهو أحدهما أو كلاهما، كذا في التلخيص، وقد مر الاختلاف في الاتحاد والتغاير، ولعل 
ms314	 الثاني قوي.(@)(@@)(@@)(@@) $ 3566 - الحسن بن أبحر " ق ". PageV01P428(@)(@@)(@@)(@@) $ 3567 - الحسن بن إبراهيم بن عبد الله بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام المدني " ق ".(@)(@@)(@@)(@@) $ 3568 - الحسن بن أبي سارة النيلي الأنصاري القرظي، مولى محمد بن كعب، وهو ابن عم معاذ الهراء، وله ابن يقال له: أبو جعفر الرواسي النحوي، وكنيته أبو علي، ثقة، روى عن " ق " عليه السلام " صه " " د " وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 3569 - الحسن بن أبي قتادة علي بن محمد بن عبيد بن حفص بن حميد، مولى السائب بن مالك الأشتر الأشعري، قتل حميد يوم المختار معه، ويكنى أبا محمد، وكان شاعرا أديبا " د ".(@)(@@)(@@)(@@) $ 3570 - الحسن بن بحر الهمداني " ق " وهو مردود الحديث مطروح القول فقاهة.(@)(@@)(@@)(@@) $ 3571 - الحسن بياع الهروي " ق " غير مقبول الرواية على طريقتنا المسلوكة في علم الرجال.(@)(@@)(@@)(@@) $ 3572 - الحسن بن تميم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3573 - الحسن بن حذيفة بن منصور الكوفي من همدان بياع السابري مولى سبيع، وقال " غض ": انه ضعيف جدا لا يرتفع به. " صه " وفي " د " عن " غض " لا ينتفع به بدل لا يرتفع.(@)(@@)(@@)(@@) $ 3574 - الحسن بن الحر الأسدي الكوفي، تابعي روى عن أبي الطفيل " ق ".(@)(@@)(@@)(@@) $ 3575 - الحسن بن الحسن بن علي بن أبي طالب عليهما السلام، تابعي روى عن جابر " ق " " قر " وهو أخو عبد الله وإبراهيم لأبيهما وأمهما فاطمة بنت الحسين عليه السلام، مات سنة خمس وأربعين ومائة قبل وفاة " ق ".(@)(@@)(@@)(@@) $ 3576 - الحسن بن الحسن بن علي بن عمر بن علي بن الحسين بن علي بن أبي طالب عليهم السلام الهاشمي المدني " ق ".(@)(@@)(@@)(@@) $ 3577 - الحسن بن الحسين بن الحسن الجحدري الكندي، عربي ثقة، روى عن " ق " عليه السلام " صه " " جش " وفي " ق " ابن الحسن مكبرا الكندي الجحدري PageV01P429(@)(@@) الكوفي، ثم ابن الحسين كندي، والظاهر أنهما واحد أبا وابنا.(@)(@@)(@@)(@@) $ 3578 - الحسن بن حماد البكري " ق ".(@)(@@)(@@)(@@) $ 3579 - الحسن بن حماد الطائي " ق ".(@)(@@)(@@)(@@) $ 3580 - الحسن بن خنيس بالخاء مصغرا كما في " د " وجعله من رجال " ق " عليه السلام و " كش " ثقة غير الذي 
ms315	 بالحاء المهملة والباء المفردة، كما يأتي في الآتية، وصححه الميرزا والتعدد محتمل، إذ في " قي " هو عن " ق " وأما بالحاء فعنهما عليهما السلام.(@)(@@)(@@)(@@) $ 3581 - الحسن بن راشد، مولى بني العباس كوفي " ق " " قي " أدرك " ظم " من أصحاب " ق " وكان وزير المهدي موسى وهارون، بغدادي ضعيف في روايته، وفيه اختلاف لا مجال لذكره في هذا المختصر.(@)(@@)(@@)(@@) $ 3582 - الحسن بن راشد الطفاوي، ضعيف في الرواية، له كتاب نوادر كثير العلم، عنه علي بن السندي، والحسن بن راشد، فتأمل.(@)(@@)(@@)(@@) $ 3583 - الحسن بن رباط البجلي الكوفي، روى عن أبي عبد الله واخوته إسحاق ويونس، له كتاب رواه ابن محبوب، وفى " كش " عن نصر كان بنو رباط أربعة اخوة، ثم سماه مع يونس وزاد الحسين وبدل إسحاق بعلي، والظاهر من الشيخ كونه اماميا.(@)(@@)(@@)(@@) $ 3584 - الحسن بن الزبير الأسدي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3585 - الحسن بن زرارة بن أعين الشيباني الكوفي " ق " ويأتي في أبيه زرارة دعاء الصادق عليه السلام له ولأخيه الحسين في حديث صحيح.(@)(@@)(@@)(@@) $ 3586 - الحسن بن زياد الضبي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3587 - الحسن بن زياد العطار مولى بني ضبة، كوفي ثقة، روى عن " ق " عليه السلام عنه ابن أبي عمير بأصله قيل: والظاهر أن هذا والضبي المتقدم واحد، وهو غير معلوم.(@)(@@)(@@)(@@) $ 3588 - الحسن بن زيد بن الحسن بن علي بن أبي طالب عليهما السلام PageV01P430(@)(@@) المدني الهاشمي " ق " والظاهر أنه في الطبقة الآتية، كما لا يخفى.(@)(@@)(@@)(@@) $ 3589 - الحسن بن السري الكاتب " قر " " ست " وفي " ق " ابن السري العبدي الأنباري يعرف بالكاتب ثم " ست " له كتاب، عنه الحسن بن محبوب.(@)(@@)(@@)(@@) $ 3590 - الحسن بن السري الكرخي الكاتب الكرخي، ثقة وأخوه علي رويا عن " ق " عليه السلام، له كتاب عنه الحسن بن محبوب. ويحتمل كونه هو الأنباري، واستظهره الميرزا، فتأمل.(@)(@@)(@@)(@@) $ 3591 - الحسن بن سعيد البجلي الأحمسي الكوفي " ق " غير معروف، فلا يعتمد عليه.(@)(@@)(@@)(@@) $ 3592 - الحسن بن سعيد الهمداني الكوفي " ق " غير معروف الحال.(@)(@@)(@@)(@@) $ 3593 - الحسن بن سيف التمار الكوفي " ق " قال عقد: عن علي بن الحسن انه ثقة 
ms316	 قليل الحديث، ولم أقف له على مدح ولا ذم من طرقنا، فالأولى التوقف، تبعا للعلامة في الخلاصة.(@)(@@)(@@)(@@) $ 3594 - الحسن بن شجرة بن ميمون بن أراكة، ثقة " صه " و " جش " في أخيه علي وثقه مع أبيه وأخيه بأجمعهم، وهو يروي عنهما عليهما السلام كالأب والأخ، وكلهم ثقات أجلاء لا خدشة فيهم.(@)(@@)(@@)(@@) $ 3595 - الحسن بن شهاب الواسطي " ق " وعن نسخة الحسين كما يأتي، ولا يبعد التغاير باحتمال الاخوة.(@)(@@)(@@)(@@) $ 3596 - الحسن بن صالح بن حي، أبو عبد الله الثوري الهمداني، أسند عنه " ق " زيدي، إليه ينسب الصالحية منهم " قر " وفي " يب " انه زيدي بتري متروك العمل بما يختص بروايته، ولعله الذي مضى عن " ظم " في السابقة.(@)(@@)(@@)(@@) $ 3597 - الحسن بن صامت الطائي " ق " غير معلوم الحال فيترك حديثه.(@)(@@)(@@)(@@) $ 3598 - الحسن بن صدقة أخو مصدق بن صدقة، قال " عقد ": أخبرنا علي بن الحسن المدائني أحسبه أزديا وأخوه مصدق رويا عن " ق " و " ظم " عليهما السلام وكانوا ثقاتا، وفي تعديله بذلك نظر " صة " وذلك لضعف المعدل، أو لكونه أزديا. PageV01P431(@)(@@)(@@)(@@) $ 3599 - الحسن بن طيب بن حمزة الشجاعي، غير خاص في أصحابنا " صه " رووا عنه، له كتاب عنه العاصمي " جش " والعاصمي عيسى بن جعفر بن عاصم من أجلاء الرواة كما يأتي.(@)(@@)(@@)(@@) $ 3600 - الحسن بن عبد الرحمن الأنصاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3601 - الحسن بن علوان الكلبي مولاهم، كوفي ثقة، روى عن " ق " عليه السلام، وكذا أخوه الحسين الا أنه عامي، والحسن أخص بنا وأولى " صه " " جش "(@)(@@)(@@)(@@) $ 3602 - الحسن بن علي بن عيسى الجلاب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3603 - الحسن بن علي كلبي " ق " الكلبي، له روايات عنه إبراهيم بن سليمان " ست " إن كان هذا ابن علوان المتقدم عن " صه " و " جش " فقد وثقاه، فتأمل.(@)(@@)(@@)(@@) $ 3604 - الحسن بن عياش الأسدي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3605 - الحسن بن فضالة " ق " لم أقف على غير العنوان، مجهول الوصف مطروح الكلام فقاهة.(@)(@@)(@@)(@@) $ 3606 - الحسن بن قدامة الكناني الحنفي، روى عن " ق " عليه السلام، كان ثقة وتأخر موته " صه " " جش " عنه محمد بن الحسين الحضرمي. وقدامة بالقاف المضمومة 
ms317	 على ما فيهما.(@)(@@)(@@)(@@) $ 3607 - الحسن بن محمد أبو علي القطان الكوفي، أسند عنه " ق " قال عقد:(@)(@@) قال علي بن الحسن: انه ثقة " صه " وفي توثيقه نظر.(@)(@@)(@@)(@@) $ 3608 - الحسن بن محمد الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3609 - الحسن بن المختار القلانسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3610 - الحسن بن مصعب البجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3611 - الحسن بن مسكان، يأتي في الحسين " تعق " يظهر منه الاتحاد وهو غير معلوم.(@)(@@)(@@)(@@) $ 3612 - الحسن بن موسى الأزدي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3613 - الحسن بن موسى الحناط الكوفي أو الخياط، مولى بني أسد ثم بني PageV01P432(@)(@@) والبة، روى عن " ق " عليه السلام بلا واسطة ومع واسطة أبيه، له أصل، عنه ابن أبي عمير، وروى عن أبي حمزة ومعمر وبريد وابن مسلم وغيرهم.(@)(@@)(@@)(@@) $ 3614 - الحسن بن واقد " ق ".(@)(@@)(@@)(@@) $ 3615 - الحسن بن هارون بن خارجة الكوفي " ق ".(@)(@@)(@@)(@@) $ 3616 - الحسن بن هارون، روى عنه ابن مسكان " ق " وفي روايته عنه امارة على وثاقته. والظاهر أنه أحد المذكورين من الكوفة قبيله والكندي بعيده، والكوفي تاليه.(@)(@@)(@@)(@@) $ 3617 - الحسن بن هارون الكندي " ق ".(@)(@@)(@@)(@@) $ 3618 - الحسن بن هارون الكوفي " ق ".(@)(@@)(@@)(@@) $ 3619 - الحسن بن يونس الحميري " ق ".(@)(@@)(@@)(@@) $ 3620 - الحسين بن أبي حمزة، قال " كش " سألت أبا الحسن حمدوية بن نصير عن علي بن أبي حمزة والحسين بن أبي حمزة ومحمد أخويه، فقال: كلهم ثقات فاضلون.(@)(@@) وهذا سند صحيح أعمل عليه وأقبل روايته ورواية أخويه، وفي " جش " لم يذكر الحسين مع أولاده فتأمل.(@)(@@)(@@)(@@) $ 3621 - الحسين بن أبي الخضر الكوفي " ق ".(@)(@@)(@@)(@@) $ 3622 - الحسين بن أبي العرندس " ق " ولعله أخو الحسن بن أبي العرندس المتقدم عن " ظم " و " ق " في السابقة.(@)(@@)(@@)(@@) $ 3623 - الحسين بن أبي العلاء الخفاف أبو علي الكوفي العامري مولاهم أعور " ق " وعن سيدنا جمال الدين في البشرى تزكيته، ويكفي في وثاقته رواية ابن أبي عمير وصفوان عنه، والله أعلم.(@)(@@)(@@)(@@) $ 3624 - الحسين بن أبي غندر، كوفي يروي عن أبيه عن " ق " له كتاب أو أصل عنه صفوان. وغندر بضم المعجمة واسكان النون وفتح المهملة.(@)(@@)(@@)(@@) $ 3625 - الحسين بن أثير الكوفي " ق " ويأتي عن 
ms318	 " قر " ابن أبتر.(@)(@@)(@@)(@@) $ 3626 - الحسين بن أحمد بن ظبيان " ق " عنه ابن أبي عمير وصفوان " ست " PageV01P433(@)(@@) وفي " مشكا " ابن أحمد بن ظبيان عنه ابن أبي عمير وصفوان. وفي روايتهما عنه دليل على الاعتماد.(@)(@@)(@@)(@@) $ 3627 - الحسين بن أحمد المنقري التميمي أبو عبد الله، روى عن " ق " عليه السلام رواية شاذة لا تثبت وكان ضعيفا، عنه عبيس كثيرا، والقاسم بن إسماعيل، وروى أيضا عن داود الرقي.(@)(@@)(@@)(@@) $ 3628 - الحسين الأحمسي، ثقة من رجال " ق " عليه السلام، روى عنه عليه السلام، عنه ابن أبي عمير، كما في " ست " و " مشكا ".(@)(@@)(@@)(@@) $ 3629 - الحسين الارجاني " ق " والارجاني بفتح الهمزة وتشديد الراء وفتح الجيم بعد الألف نون، والنسبة إلى أرجان وهي كورة الأهواز من بلاد خوزستان، وأكثر الناس أنها بالراء المخففة، كما هو المنقول عن أهلها.(@)(@@)(@@)(@@) $ 3630 - الحسين بن ثوير الحازمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3631 - الحسين الجعفي أبو أحمد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3632 - الحسين بن حبيب " ق " وهو كنظائره غير معلوم الحال في كتب الرجال متروك المقال.(@)(@@)(@@)(@@) $ 3633 - الحسين بن الحذاء الكوفي " ق ".(@)(@@)(@@)(@@) $ 3634 - الحسين بن حماد بن ميمون العبدي الكوفي " ق " أبو عبد الله، ذكر في رجال " ق " عليه السلام له كتاب يرويه داود بن حصين، وإبراهيم بن مهزم، والقاسم بن إسماعيل.(@)(@@)(@@)(@@) $ 3635 - الحسين بن حمدة " ق " وفي بعض النسخ غير معلوم الصحة ابن حمزة.(@)(@@)(@@)(@@) $ 3636 - الحسين بن حمزة الليثي الكوفي ابن بنت أبي حمزة الثمالي ثقة، ذكره أبو العباس في رجال " ق " عليه السلام له كتاب عنه ابن أبي عمير، وفى " كش " ابن أبي حمزة، والأول أصح.(@)(@@)(@@)(@@) $ 3637 - الحسين بن خالد بن طهمان، هو الحسين بن أبي العلاء، وقد تقدم. PageV01P434(@)(@@)(@@)(@@) $ 3638 - الحسين بن رباط، مر في أخيه الحسن، وفي الوجيزة " ح " فتأمل، وفيهما رواية رواها كش في أبيهما يدل على حسن حالهما، فقال عليه السلام: ولقد أدى إلي ابناك الحسن والحسين وسألتك أحاطهما الله وكلاهما ورعائهما وحفظهما بصلاح أبيهما كما حفظ الغلامين الخ.(@)(@@)(@@)(@@) $ 3639 - الحسين بن الرماس العبدي الكوفي، أسند عنه " ق " (@)(@@)(@@)(@@) $ 3640 - الحسين بن زرارة أخو 
ms319	 الحسن " ق " ويأتي في أبيهما دعاء الصادق عليه السلام لهما وفي " تعق " ذكرنا فيه ماله ربط ويأتي في أبيه زيادة.(@)(@@)(@@)(@@) $ 3641 - الحسين بن زيد بن علي بن الحسين عليهما السلام أبو عبد الله مدني " ق " يكنى أبا عبد الله يلقب ذا الدمعة كان " ق " ربا، وزوجته بنت الأرقط، روى عن " ق " عليه السلام، عنه إبراهيم بن سليمان.(@)(@@)(@@)(@@) $ 3642 - الحسين بن سلمة أبو عمار الهمداني الخارفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3643 - الحسين بن سليمان الكناني الكوفي أبو عبد الله " ق ".(@)(@@)(@@)(@@) $ 3644 - الحسين بن سيف بن عميرة أبو عبد الله النخعي له كتاب عن أخيه علي وآخر عن الرجال " جش " عنه علي بن الحكم والبرقي محمد.(@)(@@)(@@)(@@) $ 3645 - الحسين بن سيف الكندي العدوي كوفي " ق ".(@)(@@)(@@)(@@) $ 3646 - الحسين بن شداد بن رشيد الجعفي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3647 - الحسين بن شهاب بن عبد ربه " ق ".(@)(@@)(@@)(@@) $ 3648 - الحسين بن شهاب الواسطي " ق " وعن نسخة مكبرا، والأول أكثر.(@)(@@)(@@)(@@) $ 3649 - الحسين بن الشيباني، الظاهر ابن زرارة أو ابن أحمد بن شيبان " تعق " فإن كان الأول ففي هذه الطبقة، وإن كان الثاني فهو من مشايخ هارون بن موسى التلعكبري وقد مضى، وظني أنه غيرهما إذ لا قرينة على كونه أحدهما.(@)(@@)(@@)(@@) $ 3650 - الحسين بن عبد الله الارجاني " قر " وتقدم عن " ق " اسقاط الأب والاقتصار بالموصوف والوصف.(@)(@@)(@@)(@@) $ 3651 - الحسين بن عبد الله البجلي الكوفي، مولى حريز بن عبد الله " ق ". PageV01P435(@)(@@)(@@)(@@) $ 3652 - الحسين بن عبد الله كوفي " ق " ويحتمل كونه هو المتقدم، فتأمل.(@)(@@)(@@)(@@) $ 3653 - الحسين بن عبد الله الرجاني، روى عنه صالح بن حمزة " ق ".(@)(@@)(@@)(@@) $ 3654 - الحسين بن عبد الواحد القصري " ق ".(@)(@@)(@@)(@@) $ 3655 - الحسين بن عطية أبو ناب الدغثمي أخو مالك وعلي " ق ".(@)(@@)(@@)(@@) $ 3656 - الحسين بن عطية الحناط السلمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3657 - الحسين بن علوان الكلبي، كوفي عامي وأخوه الحسن يكنى أبا محمد رويا عن " ق " عليه السلام والحسن أخص وأولى، بل عقد كان أوثق من أخيه، عنه أبو الجوزاء وهارون بن مسلم، وقيل: إن الكلبي كان مستورا ولم يكن مخالفا.(@)(@@)(@@)(@@) $ 3658 - الحسين 
ms320	 بن علي بن نجيح الجعفي مولاهم الكوفي أبو عبد الله " ق ".(@)(@@)(@@)(@@) $ 3659 - الحسين بن عمار الكوفي " ق ".(@)(@@)(@@)(@@) $ 3660 - الحسين بن عمارة البرجمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3661 - الحسين بن عمرو بن محمد بن شداد الأزدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3662 - الحسين بن عمرو بن يزيد " ق ".(@)(@@)(@@)(@@) $ 3663 - الحسين بن عمر بن سليمان، أحمد بن أبي عبد الله عن أبيه عنه " جش " وهو في السابقة أيضا بملاحظة الراوي والمروي عنه.(@)(@@)(@@)(@@) $ 3664 - الحسين بن كثير الخزاز الكوفي " ق " ويحتمل كونه الكلابي الآتي، كما احتمله بعض الأجلة.(@)(@@)(@@)(@@) $ 3665 - الحسين بن كثير القلانسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3666 - الحسين بن كثير الكلابي الجعفري الخزاز الكوفي، أسند عنه " ق " ولعله الكوفي المتقدم.(@)(@@)(@@)(@@) $ 3667 - الحسين بن محمد بن علي الأزدي أبو عبد الله، ثقة من أصحابنا كوفي " صه " " جش " كان الغالب عليه علم السير والأدب والشعر، عنه المنذر بن محمد بن المنذر " جش ".(@)(@@)(@@)(@@) $ 3668 - الحسين بن محمد بن عمران كوفي " ق ". PageV01P436(@)(@@)(@@)(@@) $ 3669 - الحسين بن المختار القلانسي، له كتاب يرويه عنه حماد بن عيسى الا أنه قد قيل: واقفي ثقة، قد حكى جماعة من الثقات عنه أيضا عن " ضا " عليه السلام والمفيد في ارشاده أنه من خاصة " ظم " عليه السلام وثقاته.(@)(@@)(@@)(@@) $ 3670 - الحسين بن مخلد بن الياس الخزاز " ق " ابن مخلد له كتاب عنه البرقي محمد " ست ".(@)(@@)(@@)(@@) $ 3671 - الحسين بن مسكان، قال " غض " لا أعرفه الا أن جعفر بن محمد بن مالك روى عنه أحاديث فاسدة. وعن السرائر أنه ابن أخ جابر الجعفي غريق في ولايته لأهل البيت عليهم السلام الا أن في " تعق " ما في السرائر وهم ولا ثمرة لجعله مكبرا أو مصغرا متحدا أو متعددا مع الجهالة.(@)(@@)(@@)(@@) $ 3672 - الحسين بن مصعب، له كتاب، عنه محمد بن زياد " ست " ويوصف بالبجلي والكوفي والهمداني، وفي " تعق " ابن زياد هذا ابن أبي عمير، وروايته عنه تشير إلى الوثاقة، ثم ذكر أنه يروي عنه صفوان وهو تأييد آخر.(@)(@@)(@@)(@@) $ 3673 - الحسين بن معاذ بن مسلم الأنصاري الهراء الكوفي " ق " وفي " تعق " يأتي في أبيه رواية 