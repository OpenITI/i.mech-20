ms101	 المجد في أفعاله % % قد بناهن البناء المحكما % % 23(@)(@@) % ناشئ في طاعة الله فتى % لم يزل برا رؤوفا منعما % % 24(@)(@@) % قد علا بالفضل فيمن قد علا % % وسما بالعلم فيمن قد سما % % 25(@)(@@) % كم وكم فيمن تولى أمره % % أعين قرت وأنف أرغما % % 26(@)(@@) % رجل لو ملك الدنيا لما % % تركت أيديه شخصا معدما % % 27(@)(@@) % فإذا جاد فما وبل الحيا % % وإذا جادل خصما أفحما % % 28(@)(@@) % بسطت أيديه بالجود فما % % تركت مما اقتناه درهما % % 29(@)(@@) % أظهر الحق بيانا وجلا % % من ظلام الشك ليلا مظلما % % 30(@)(@@) % سيد من هاشم إذ ينتمي % % لرسول الله أعلى منتمى % % PageV01P311 31(@)(@@) % واعظ إن وعظ الناس اهتدت % % لسبيل الرشد من بعد العمى % % 32(@)(@@) % كلما ألقى إلينا كلما % لفظت من فيه كانت حكما % % 33(@)(@@) % تكشف الران عن القلب وما % % 34(@)(@@) % قوله الفصل وفي أحكامه % % ما يريك الحكم أمرا مبرما % % 35(@)(@@) % إن قضى بالدين أمرا ومضى % % أذعن لأبي به واستسلما % % 36(@)(@@) % يحسم الداء من الجهل وكم % % حسم الجهل به فانحما % % 37(@)(@@) % نجم العلم به إذ نجما % % ونمى الفضل به منذ نمى % % 38(@)(@@) % وبدين الله في أقرابه % % لم أجد أثبت منه قدما % % 39(@)(@@) % يدفع الباطل بالحق الذي % % يفلق الهام ويبري القمما % % 40(@)(@@) % ووواكتفى بالسمر عن بيض الظبا % % أغمد السيف وأجرى القلما % % PageV01P312 41(@)(@@) % وجد الفضل به مفتتحا % لا أرى في فقده مختتما % % 42(@)(@@) % علماء الدين أعلام الهدى % % كل فرد كان منهم % % 43(@)(@@) % إنما انت لعمري واحد % % ما رأينا لك فينا توأما % % 44(@)(@@) % أنت أندى الناس إن تثرى ندى % % يا غماما سح يا بحرا طمى % % 45(@)(@@) % إن أيامك أعياد المنى % % حيث كانت للأماني موسما % % 46(@)(@@) % سيدي أنت وها أنت لنا ال % % عروة الوثقى التي لن تفصما % % 47(@)(@@) % كل فرد كان منهم علما % % فتقبل فيك ما قد نظما % % 48(@)(@@) % ذاكرا من أنعم الله لكم % % بنعما تسدي إلينا النعما % % PageV01P313 البحر : طويل 1(@)(@@) % دعاك أمير المؤمنين وإنما % % دعا مسرعا فيما يروم مسابقا % 2(@)(@@) % فلبيته لما دعاك ولم نجد % % عن السير في تلك الإجابة عائقا % % 3(@)(@@) % وقدمت للترحال عزمتك التي % % تحث 
ms102	 إلى المجد الجياد السوابقا % % 4(@)(@@) % على ثقة منه بما أنت أهله % % وما كان إلا في جنابك واثقا % % 5(@)(@@) % فكان إذا ما اعتل أمر بملكه % % رآك طبيبا للممالك حاذقا % % 6(@)(@@) % برأي إذا هز الأسنة واخز % % وعزم إذا استل الظبا كان فالقا % % 7(@)(@@) % نظرت بنور الله في كل غامض % % بعيد المدى حتى عرفت الحقائقا % % 8(@)(@@) % وفيك مع الإقدام واليأس في الوغى % % خلائق ما زالت تسر الخلائقا % % 9(@)(@@) % صلابة دين ترغم الشرك أنفه % % وتخذل أعلاجا له وبطارقا % % 10(@)(@@) % يسر بها من كان بالله مؤمنا % ويكبت فيها ملحدا ومنافقا % % PageV01P314 11(@)(@@) % ولا غرو من كان الفتوح بوجهه % % إذا استتتفتح الإسلام فيه المغالقا % % 12(@)(@@) % إذا التقع وأمسى عارضا متركما % وأرسلت الشهب المنايا صواعقا % % 13(@)(@@) % تحبل نهار الحرب أسود حالكا % وسوسن أوراق الحديد شقائقا % % 14(@)(@@) % فكم ناطق بالكفر أصبح أخرسا % % وكم أخرس بالشعر أصبح ناطقا % 15(@)(@@) % جزيت جزاء الخير عن أهل بلدة % ببأسك تكفيها الخطوب الطوارقا % % 16(@)(@@) % غرست من الإحسان فينا أياديا % فأنبتن بالذكر الجميل حدائقا % % 17(@)(@@) % أجدت نظام الملك حتى كأنه % % من الحسن أضحى لؤلؤا متناسقا % 18(@)(@@) % وفارقتنا بالكرة منا ولم تزل % % حميد السجايا مقبلا ومفارقا % 19(@)(@@) % فحق لبغداد البكاء وكيف لا % % وقد فارقت فخر الوزارة نامقا % % 20(@)(@@) % وكنت بنا برا رؤوفا وواليا % عطوفا وبحرا بالمكارم دافقا % PageV01P315 21(@)(@@) % وعودنا منك الجميل عوايدا % إذا عدت العادات كن خوارقا % % 22(@)(@@) % فدبرت منا رقعة ما تدبرت % % وكم فرزنت أيديك فينا بيادقا % % 23(@)(@@) % وفيما أراك الله إصلاح شأنها % % سددت على أهل الفساد الطرائقا % % 24(@)(@@) % تروق وتصفو إن كدرت سريرة % % فلو كنت ماء كنت إذ ذاك رائقا % % 25(@)(@@) % فسر في أمان الله من كل طارق % % مهم فلا تخشى مع الأمن طارقا % % 26(@)(@@) % إلى ملك تخطى لديه بحظوة % % بنيت بها فوق النجوم سرادقا % % 27(@)(@@) % تكون بمرآى من علاه ومسمع % % فتتخذ البشرى رفيقا موافقا % % 28(@)(@@) % إذا كنت كنت من سلطاننا بمكانة % % فقد أمن السلطان فيك البوائقا % % 29(@)(@@) % عليك ولا ريب بذاك اعتماده % % كما اعتمد المرء الجبال الشواهقا % % 30(@)(@@) % عزمت إليه بالرحيل وطالما % % قطعت 
ms103	 إلى الأمر المهم العوائقا % % PageV01P316 31(@)(@@) % شة قك منه حضرة ملكية % % وما كنتما إلا مشوقا وشائقا % % 32(@)(@@) % سترزق من ثم السعادة كلها % % فتحمد رزاقا وتشكر خالقا % % 33(@)(@@) % وفيك مع الإقدام والبأس سطوة % % تعيد فؤاد الدهر بالرعب خافقا % % 34(@)(@@) % فما وجدا السلطان مثلك ناصحا % ولا وجد السلطان مثلك صادقا % % PageV01P317 البحر : رمل تام 1(@)(@@) % دنف ذو مهجة في الحب تصدا % % كلما زيد ملاما زاد وحدا % % 2(@)(@@) % أمطرت أدمعه وبل الحيا % % وهو يشكو من لظى الأشواق وقدا % % 3(@)(@@) % مغرم أخفى الهوى عن عاذل % % في الهوى العذري ما أخفى وأبدى % % 4(@)(@@) % فتكت أعينها الغيد به % % ورمته أسهم الألحاظ عمدا % % 5(@)(@@) % كيف يسطيع اصطبارا وهو لا % % يجد اليوم من الأشواق بدا % % 6(@)(@@) % لا تلمني فصابات الهوى % % جعلت بيني وبين اللوم سدا % % 7(@)(@@) % عبرة أهرقتها من أعين % % ألفت في هجرها الغمض سهدا % % 8(@)(@@) % وبما قاسيت من حر الجوى % % في غرام مد سيل الدمع مدا % % 9(@)(@@) % أنحل الحب ذويه فاغتدت % من معاناة الضنى عظما وجلدا % % 10(@)(@@) % كلما يقرب مني عاذل % فتقبل ما إليك العبد أهدى % % PageV01P318 11(@)(@@) % رب ليل أطبقت ظلماؤه % % تحسب الشهب عيونا فيه رمدا % % 12(@)(@@) % % وأواري عبرتي أن تتبدى % % 13(@)(@@) % أذكر الأغصان من بان النقا % % كلما أذكر من هيفاء قدا % % 14(@)(@@) % ومع السرب الذي مر بنا % % رشأ يصرع بالألحاظ أسدا % % 15(@)(@@) % من معيد لي أياما مضت % % كان فيها الغي لو انصفت رشدا % % 16(@)(@@) % أهصر الغصن إذا ما كان قدا % وأشم الورد إذا ما كان خدا % % 17(@)(@@) % كم أهاج الشوق من وجد بها % % كلما جدده الذكر استجدا % % 18(@)(@@) % وجرى دمعي من الوجد فما % % يملك الطرف لجاري الدمع ردا % % 19(@)(@@) % خبراني بعد عرفاتي بها % % كيف أقوت دار سعدى بعد سعدى % % 20(@)(@@) % أين قطانك في عهد الصبا % % يا مراحا كان للهو مغدى % % PageV01P319 21(@)(@@) % يوم سارت عنك للركب بهم % % مشمعلات تقد السير قدا % % 22(@)(@@) % قد ذكرنا عهدكم من بعدكم % % هل ذكرتم بعدنا للود عهدا % % 23(@)(@@) % ولو أن الوصل مما يشترى % % 24(@)(@@) % وقصارى منية الصب بكم % % مطلب جد به الوجد فأكدى % % 25 
ms104	(@)(@@) % فسقاكم وسقى أربعكم % % من قطار حامل برقا ورعدا % % 26(@)(@@) % وإذا مرت بكم ريح صبا % حملت ريح الصبا شيحا ورندا % % 27(@)(@@) % زارني الطيف فما أشكوى جوى % من حشا الصادي ولا نول رفدا % % 28(@)(@@) % ما عليه لو ترشفت لمى % مزجت ريقته خرا وشهدا % % 29(@)(@@) % نسب التشبيب في الحب إلى % % ذلك الحسن فكان الهزل جدا % 30(@)(@@) % وإلى عبد الحميد انتسبت ، % غرر الشعر له شكرا وحمدا % % PageV01P320 31(@)(@@) % عالم البصرة قاضيها الذي % % لا ترى فيها له في الناس ندا % % 32(@)(@@) % قوله الفصل وفي أحكامه % % يجحض الباطل والخصم الأدا % % 33(@)(@@) % إذ يريك الحق يبدو ظاهرا % لازما في حكمه لا يتعدى % % 34(@)(@@) % أوجب الشكر علينا فضله % % فمن الواجد عندي أن يؤدى % % 35(@)(@@) % سيد إحسانه في بره % % لم يزل منه العافين يسدى % % 36(@)(@@) % وبأمر الله قاض إن قضى % % كان أمضى من شفير السيف حدا % % 37(@)(@@) % ثابت الجأش شديد ركته % % إذ تخر الراسيات الشم هدا % % 38(@)(@@) % سيد من سيد إذ ينتمي % % أكرم الناس أبا فيهم وحدا % % 39(@)(@@) % آل بيت لبسوا ثوب التقى % % تلبس الفخر نزارا ومعدا % 40(@)(@@) % هم أغاظوا بالذي يرضونه % % زمنا تشقى به الأحرار وغدا % % PageV01P321 41(@)(@@) % ذللووا الصعب وقادوا للعلى % % حيث ما انقادت لهم قودا وجردا % % 42(@)(@@) % هل ترى أبعد منه منظرا % أو ترى يومئذ أثقب زندا % % 43(@)(@@) % باسط أيديه لما خلقت % % ديما ما برحت بالجود تندى % % 44(@)(@@) % عددا لي نعمة الله به % % أنا لا أحصي له النعماء عدا % % 45(@)(@@) % % تركت بالبر حر القوم عبدا % % 46(@)(@@) % حبذا البصرة في أيامه % % لا أراها الله من علياه فقدا % % 47(@)(@@) % وجميل الذكر من أخلاقه % % سار في أقطارها غورا ونجدا % % 48(@)(@@) % توأم المجد فريد في الحجى % % جامع الفضل براه الله فردا % % 49(@)(@@) % بيمين الحق سيف صارم % % يجعل الباطل في غريبه غمدا % % 50(@)(@@) % طالما ألقت إليه كلما % أورثت ما لم يرثه لنثر خلدا % % PageV01P322 51(@)(@@) % فترنمت بها قافية % % 52(@)(@@) % وكفاني صولة الهم امرؤ % % جاعل بيني وبين الهم سدا % % 53(@)(@@) % رغد العيش لمن في ظله % % عاش طول الدهر بالأفراح رغدا % % 54(@)(@@) % كلما يلحظني ناظره % % عكس 
ms105	 الأمر فكان النحس سعدا % % 55(@)(@@) % بأبي أفديه من قاض به % % صرت في رأفته ممن يفدى % % 56(@)(@@) % إن من أخلص فيكم وده % % مخلص في حبه الأمجاد ودا % % 57(@)(@@) % ناظم فيكم على طول المدى % % مدحا ترفع لي بالفخر مجدا % % 58(@)(@@) % فهو مهديها إليكم عبدكم % % فتقبل ما إليك البعد أهدى % % PageV01P323 البحر : بسيط تام 1(@)(@@) % اليوم أصبح فيك الوقت منتظما % وهون الله أمرا كان قد عظما % % 2(@)(@@) % أمست عمان وأنت الشهم سيدها % % لا يستباح لها في الحادثات حمى % % 3(@)(@@) % مدت إليها يد الجاني فما ظفرت % % إلا بما أعقب الخسران والندما % % 4(@)(@@) % من بعد ما هاج شرا من مكانته % % وكاد يوقد في أطرافها ضرما % % 5(@)(@@) % تمسكا بجبال الشمس من طمع % % وموردا من سراب لا يبل ظما % % 6(@)(@@) % فلم يوفق إلى نجح يؤمله % % والمرء إن فقد التوفيق أو عدما % % 7(@)(@@) % لم يهده الرأي إلا للضلال ولا % % يزيده عدم التوفيق غير عمى % % 8(@)(@@) % أضل مسعاه تركي في غوايته % % كأنه اختار عن وجدانه العدما % % 9(@)(@@) % نصحته وبذلت النصح تنذره % % مستعملا بالنذير السيف والقلما % % 10(@)(@@) % فما ارعوى لك عن وهم توهمه % % كأن في أذنه عن ناصح صمما % % PageV01P324 11(@)(@@) % أراد في زعمه أن يستطيل على % % عمان قهرا فلم يظفر بما زعما % % 12(@)(@@) % وكان غايته الحرمان يومئذ % ولو أطاعك واسترضاك ما حرما % % 13(@)(@@) % خيرته قبل هذا اليوم في نعم % % ولم يكن ثم ممن يشكر النعما % % 14(@)(@@) % وجاء يطلب ملكا منك ليس له % % فقيل خصمان في إرث العلى اختصما % % 15(@)(@@) % حتى ذا كان لا يصغي إلى حكم % % حكمتما الصارم الهندي بينكما % % 16(@)(@@) % قضى لك السيف فيما قد قضى ومضى % % فيا له حكم عدل إذا حكما % % 17(@)(@@) % وما تجاوزت الإنصاف شفرته % % وما أضل بمظلوم وإن ظلما % % 18(@)(@@) % وقالت الناس باديها وحاضرها % % ما جار سالم قفي حكم ولا ظلما % % 19(@)(@@) % أنزلته من منيعات الحصون ولو % % تركت تركي رهين الحصن مات ظما % % 20(@)(@@) % أراد مستعصما فيه ومعتصما % وما رأى في منيع الحصن معتصما % % PageV01P325 21(@)(@@) % ولم يجد سلما يرقى السماء به % % ولو رمى نفسه في البحر 
ms106	 لالتقما % % 22(@)(@@) % وإنه قبل إعطاء الأمان له % % ما استشعر الموت حتى استشعر الندما % % 23(@)(@@) % وغره من دعاه في خيانته % % فجاءها عقبات الموت واقتحما % % 24(@)(@@) % أذقته العفو حلوا عن جنايته % % وكان عفوك عمن قد جنى كراما % % 25(@)(@@) % عفوت عنه ولكن عفو مقتدر % والعفو أقرب للتقوى كما علما % % 26(@)(@@) % وما هتكت وأيم الله حرمته % % وكان عندك حتى زال محترما % % 27(@)(@@) % وربما لامك اللوام عن سفه % وقد يلومك بين الناس من لؤما % % 28(@)(@@) % أما وربك لو أربى طغى وبغى % % وما عفا مثلما تعفو بل انتقما % % 29(@)(@@) % رحمته ولو استولى عليك لما % % أبقى عليك ولم يلحق بمن رحما % % 30(@)(@@) % أراد ربك أن تعفو بقدرته % % ليظهر الفضل والتمييز بينكما % % PageV01P326 31(@)(@@) % والله يعلم والدنيا بأجمعها % % لو نال من سالم تركي لما سلما % % 32(@)(@@) % لا زال يولي جميلا من صنائعه % % وهكذا كرم الشهم الذي كرما % % 33(@)(@@) % من سيد بالغ رشد الشيوخ نهى % رضيع ثدي المعالي قبل أن فطما % % 34(@)(@@) % تبارك الله ما أبهى سناه فتى % كالنجم يهدي سبيل الرشد مذ نجما % % 35(@)(@@) % الثابت الجأش في سلم ومعترك % % في موطن الفخر قد أرسى له قدما % % 36(@)(@@) % الباسم الثغر والهيجاء عابسة % % والسيف يقطر من هام الكماة دما % % 37(@)(@@) % فمن صدور العوالي ما يرى وصبا ، % ومن نفوس المعالي ما شفى سقما % % 38(@)(@@) % تساهما هو والجد السعيد بما % % حازاه من كرم الأخلاق واقتسما % % 39(@)(@@) % ويا له ولد أعنيه من ولد % أحيى له ذكره الماضي وإن قدما % % 40(@)(@@) % تحفه من عمان سادة نجب % تسمو لهم في سماوات العلاء سما % % PageV01P327 41(@)(@@) % يحمون سيدهم من كل نازلة % % بفيصل يغلق الهامات والقمما % % 42(@)(@@) % ولم يكن غيره الحامي لحوزتها % % إذا أدلهم من الأخطار ما دهما % % 43(@)(@@) % تبيت لا كملوك الهند تكلأها % % ندعو من الله فيها فاغرين فما % % 44(@)(@@) % لولا وجودك هذا الداء ما حسما % % وذلك الصدع لولا أنت ما التأما % % 45(@)(@@) % لطف من الله فيك أظهره % % من بعد ما كان سر اللطف مكتتما % % 46(@)(@@) % وافت إلينا فوافت بالسرور كما % % 47(@)(@@) % سرت بها البصرة الفيحاء وابتهجت % % منها 
ms107	 النفوس وأنف الصند قد رغما % % 48(@)(@@) % بشارة عمت الدنيا مسرتها % % واهتز منها العلى والمجد وابتسما % % 49(@)(@@) % قد يسر الله أمرا أنت فعله % % وإن لله في تقديره حكما % % 50(@)(@@) % لا زلت بالجود والإحسان مبتدرا % كالغيث حيث همى والبحر حيث طمى % % PageV01P328 51(@)(@@) % فمن مزاياك ما تكسو النجوم سنا % ومن عطاياك ما قد يخجل الديما % % 52(@)(@@) % ولم أزل كلماتي فيك أنظمها % % كما تتابع قطر المزن وانسجما % % PageV01P329 البحر : كامل تام 1(@)(@@) % ما زلت أول مغرم مفتون % فتكت به حدق الظباء العين % 2(@)(@@) % وجنت عليه بما جنته لواحظ % % تركته منها في العذاب الهون % % 3(@)(@@) % ماذا يقيك من الموائس بالقنا % % إن طاعتك قدودها بغصون % % 4(@)(@@) % وسطت عليك جفونها بصوارم % ما أغمدت أمثالها بجفون % % 5(@)(@@) % إن العيون البابلية طالما % % جاءت بسحر للعقول مبين % % 6(@)(@@) % لانت معاطف من تحب وإن قسا % % قلبا فلم يك وصله بمدين % % 7(@)(@@) % % لا زال تشكو قسوة من لين % % 8(@)(@@) % ويلي من اللحظات ما لقتيلها % % قود وليس أمينها بأمين % % 9(@)(@@) % والمسعدون من الغرام بمعزل % % عني فهل من مسعد ومعين % % 10(@)(@@) % ظعن الذين أحبهم فتناهبت % % مهج القلوب حواجب بعيون % % PageV01P330 11(@)(@@) % وتركن أرباب الرجال كأنما % % شربت زعاف السم بالزرجون % % 12(@)(@@) % ما إن أطلت إلى الديار تلفتي % % إلا أطلت تلفتي وحنيني % % 13(@)(@@) % ولقد وقفت على المنازل وقفة % % فقضيت للأطلال فرض ديون % % 14(@)(@@) % وجرت بذياك الوقوف مدامعي % % ومرت لهاتيك الديار شؤوني % % 15(@)(@@) % فسقى مصاب المزن كل عشية % % عهدا يصوب عليه كل هتون % % 16(@)(@@) % يا سعد قد نفرت أوانس ربرب % % بنوى يشط به المزار شطوني % % 17(@)(@@) % فاسعد أخاك على مساعدة الجوى % % إن كان دينك في الصبابة ديني % % 18(@)(@@) % كانت منازلنا منازل صبوة % % وديار وح علاقة وفتون % % 19(@)(@@) % تتلاعب الآرام في عرصاتها % % فيجد بي تلفي وفرط شجوني % % 20(@)(@@) % جمعت فكانت ثم مجتمع الهوى % % ظبي الكتس بها وليث عرين % % PageV01P331 21(@)(@@) % أيام كنت أديرها يا قوتة % % حمراء بين الورد والنسرين % % 22(@)(@@) % والروض متفق المحاسن زهره % % بعد اختلاف الشكل والتلوين % % 23(@)(@@) % وتفنن الورقاء في أفنانها % % ينبيك أن الورق ذات فنون % % 24(@)(@@) % والكأس تبسم 
ms108	 في أكف سقاتها % % عن در مبتسم الحباب ثمين % % 25(@)(@@) % ضمنت لشاربها السرور فحبذا % % ذاك الضمان لذلك المضمون % % 26(@)(@@) % ومهفهف ينشق في غسق الدجى % % من ليل طرته صباح جبين % % 27(@)(@@) % وأنا الطعين بسمهري قوامه % % يا للرجال لصبه المطعون % % 28(@)(@@) % قد بعته روحي ولا عوض لها % % ورجعت عنه بصفقة المغبون % % 29(@)(@@) % علم الضنين بوصله في صده % % أني ببذل الروح غير ضنين % % 30(@)(@@) % قارعت أيامي لعمرك جاهدا % حتى انتضيت لها حسام الدين % % PageV01P332 31(@)(@@) % جردته عضبا يلوح يمانيا % جادت بصيقله يمين القين % % 32(@)(@@) % فإذا ركنت إلى نجيب لم يكن % % إلا إلى ذاك الجناب ركوني % % 33(@)(@@) % أعلى مقامي في علي مقامه % % فرأيت منزلة الكواكب دوني % % 34(@)(@@) % وظفرت منه بما به كان الغنى % % عن غيره في العز والتمكين % % 35(@)(@@) % وصددت عن قوم كأن نوالهم % % مال اليتيم وثروة المسكين % % 36(@)(@@) % فتكاثرت نعم علي بفضله % % من فضله وأقلها يكفيني % % 37(@)(@@) % السيد السند الذي صدقت به % % فيما تحدث عن علاه ظنوني % % 38(@)(@@) % يمحو ظلام الشك صبح يقينه % % والشك ينفيه ثبوت يقين % % 39(@)(@@) % متيقظ الأفكار يدرك رأيه % % ما لم يكن بالظن والتخمين % % 40(@)(@@) % من أسرة رغموا الأنوف وأصحبوا نزيلهم % % ونوالهم بالبر غير مصون % % PageV01P333 41(@)(@@) % اللابسون من الفخار ملابسا % ومن الوقار سكينة بسكون % % 42(@)(@@) % إن الذي تجبت به أم العلى % % ظفرت به في الأكرمين يميني % % 43(@)(@@) % ما زلت في وديب له متمسكا % أبدا بحبل من علاه متين % % 44(@)(@@) % أنفك أقسم ما حييت ألية % بالله بل بالتين والزيتون % % 45(@)(@@) % لولاه ما فارقت من فارقته % % وهجرت ثمة صاحبي وخديني % % 46(@)(@@) % ووجدت من شغفي إليه زيارتي % % ضربا من المفروض والمسنون % % 47(@)(@@) % وحثثت يومئذ ركائبي التي % % لفت سهول فدافد بحزون % % 48(@)(@@) % كم من يد بيضاء أنهلني بها % % ما أنهل من وبل السحاب الجون % % 49(@)(@@) % ورأيت من أخلاقه بوجوده % % ما أبدع الخلاق بالتكوين % % 50(@)(@@) % ولكم تجلى بالمسرة فانجلى % % صدأ الهموم لقلبي المحزون % % PageV01P334 51(@)(@@) % حيث السعادة والرئاسة والعلى % % تبدو بطلعة وجهه الميمون % % 52(@)(@@) % يا من جعلت لما يقول مسامعي % % أصداف ذاك اللؤلؤ المكنون % % 53(@)(@@) % إني أهش إذا 
ms109	 ذكرت فأجتلي % % راحا تسر فؤاد كل حزين % % 54(@)(@@) % وإذا صحوت ففي حديثك نشوتي % % وإذا مرضت فأنت من يشفيني % % 55(@)(@@) % بفكاهة تشفي الصدور وبهجة % % قرت بها في الأنجبين عيوني % % 56(@)(@@) % أطلقت ألسنة الثناء عليك في % % ما أبدعته بأحسن التنظيم % % 57(@)(@@) % إن دونوا فيك المديح فإنما % % مدح الكرام أحق بالتدوين % % 58(@)(@@) % فاسلم ودم أبدا بأرغد عيشة % % تبقى المدى في الحين بعد الحين % % PageV01P335 البحر : وافر تام 1(@)(@@) % سطا بحسام مقلته وصالا % % كأني جئت أسأله الوصالا % % 2(@)(@@) % وجار على المتيم في جفاه % % وأجرى أدمع الصب انهمالا % % 3(@)(@@) % ومهما ازددت بين يديه ذلا % يزد عزا ويتبعه دلالا % % 4(@)(@@) % حكى البدر التمام له محيا % وشابه قده الغصن اعتدالا % % 5(@)(@@) % وأذن حسنه للوجد فيه % % فشاهدنا بوجنته بلالا % % 6(@)(@@) % بقلبي نار خد قد تلظت % فتورث في جوانحي اشتعالا % % 7(@)(@@) % وفي جسمي سقام عيون خشف % % عدت منها لي الداء العضالا % % 8(@)(@@) % وما أنسى بذات الرمث عهدا % مضى لكن حسبناه خيالا % % 9(@)(@@) % زمانا لم نحاذر فيه واش % ولم نسمع لعذال مقالا % % 10(@)(@@) % وكم قد زارني رشأ غرير % % فأرشفني على ظمأ زلالا % % PageV01P336 11(@)(@@) % وعهدي ليله أبدا قصير % % فلما سار من أهواه طالا % % 12(@)(@@) % وأنى يرتجي اللاحي سلوي % % وقد ذابت حشاشتي انسلالا % % 13(@)(@@) % أيهدي عن الشواق لاح % وما قد زادني إلا ضلالا % % 14(@)(@@) % فلا تسأل وقيت الشر دمعا % إذا ما لاح برق الحيف سالا % % 15(@)(@@) % أحلت سرب ذاك الربع قتلي % % ولا يحوي لبذل المال مالا % % 16(@)(@@) % ولو أبصرت إذ رحلوا فؤادي % % رأيت الصبر يتبع الجمالا % % 17(@)(@@) % ألا لله ما فعلت بقلبي % % جفون لم تخل إلا نصالا % % 18(@)(@@) % ورب قد كسا الأحباب حسنا % كساني من صبابتها انتحالا % % 19(@)(@@) % وإني في الغرام وفي التصابي % % كمثل محمد حزت الكمالا % % 20(@)(@@) % فتى في العلم والإكرام بحر % وكان وروده عذبا زلالا % % PageV01P337 21(@)(@@) % له عزم حكى الشم الرواسي % % وخلق قد حكى الريح الشمالا % % 22(@)(@@) % ومرتاح إلى الإكرام طبعا % % 23(@)(@@) % أحب الناس في الدنيا لديه % % فتى أبدى لنائله السؤالا % % 24(@)(@@) % ويهوى المكرمات بكل آن % ولن نلقى به عنها ملالا 
ms110	 % % 25(@)(@@) % وكان نداه للعافين وصلا % وكان على أعاديه وبالا % % 26(@)(@@) % كساه الله تاجا من فخار % % وألبسه المهابة والجلالا % % 27(@)(@@) % فلو زالت جبال الله عنها % % لكان وقاره فيها جبالا % % 28(@)(@@) % ندي الكف راحته غمام % % فلو لمس الحصى فيها لسالا % % 29(@)(@@) % وما بخلت له أبدا يمين % بباع من عزائمه لنالا % % 30(@)(@@) % ويؤذن بشره بسحاب جود % % وكان تبسم الكرماء خالا % % PageV01P338 31(@)(@@) % لقد نلنا به صعب الأماني % % فلم نعرف بساحته المحالا % % 32(@)(@@) % وحبر العلم بل بحر غزير % % أجل الناس في الدنيا نوالا % % 33(@)(@@) % بدا منه محيا ثم نور % % فأمسى في ذوي الآمال فالا % % 34(@)(@@) % ومد يمينه في البسط يوما % فأغمرنا عطاءا واتصالا % % 35(@)(@@) % حباه الله في حسن السجايا % % وتلك عطية الباري تعالى % % 36(@)(@@) % خلال كالصوارم مرهفات % % أجادتها محاسنه الصقالا % % 37(@)(@@) % فإن قلتا لدى الدنيا جميل % % عنينا حسن خلقك والخصالا % % 38(@)(@@) % أتحصي المادحون له كمالا % ومن ذا عد في الأرض الرمالا % % 39(@)(@@) % وما غالت بك المداح حمدا % إذا ما فيك أطنب ثم غالى % % 40(@)(@@) % أعود ببأسه من كل خطب % % فقد أضحى على الدنيا عقالا % % PageV01P339 41(@)(@@) % وعزم يقهر الأعداء قهرا % وإن لم تلتق منه قتالا % % 42(@)(@@) % فلو طاولنه السمر العوالي % % على نيل المرام إذن لطالا % % 43(@)(@@) % وقد كمل العلوم وكل فخر % % وقد زان المفاخر والكمالا % % 44(@)(@@) % وما هو غير بدر في المعالي % % فلا عجب إذا نال الكمالا % % 45(@)(@@) % فلو شاهدت في التقرير منه % % بيانا خلته السحر الحلالا % % 46(@)(@@) % يهدي الله فيه الخلق رشدا % وفيه يكشف الله الضلالا % % 47(@)(@@) % ولم يترك لأهل الفخر فخرا % ولم يترك لذي قول مقالا % % 48(@)(@@) % فما خابت ظنون أخي مرام % % أصارك في مطالبه مآلا % % 49(@)(@@) % فخذها سيدي منها قصيدا % وصير لي رضاك بها نوالا % % PageV01P340 البحر : خفيف تام 1(@)(@@) % ريد لوما فزاد في الحب وجدا % % مستهام تخيل الغي رشدا % % 2(@)(@@) % مازج الحب مرة فأراه % % أن هزل الغرام يصبح جدا % % 3(@)(@@) % ورمى قلبه بجذوة نار % % أوقدته بلاعج الشوق وقدا % % 4(@)(@@) % من غرام رمى به كل مرمى % % يتلظى فلم يجد عنه بدا % % 5(@)(@@) % لوصغى للعذول 
ms111	 ما كان أمسى % % دنفا في شؤونه يتردى % % 6(@)(@@) % يسأل الركب عن منازل نجد % % ناشدا منه خلفت نجدا % % 7(@)(@@) % يتشافى من عهدها بالأحادي % % لازم في أهليه لا يتعدى % % 8(@)(@@) % فهو يقضي لها حقوقا عليه % % ويؤدي ما ينبغي أن يؤدى % % 9(@)(@@) % يا ابن ودي وأكثر الناس حقا % في التصابي عليك أكثر ودا % % 10(@)(@@) % كفكف الدمع ما استطعت فإني % % لست أستطيع للمدامع ردا % % PageV01P341 11(@)(@@) % وإذا ما دعوت للصبر قلبي % % كان لي يا هذيم خصما ألدا % % 12(@)(@@) % زارني طارق الخيال ووافى % % من سليمى يجوب غورا ووهدا % % 13(@)(@@) % كيف زار الخيال في غسق الل % % يل إلى أعيني وأني تسدى % % 14(@)(@@) % وتوالى حر الحشا وتولى % % إذ تصدى لمغرم ما تصدى % % 15(@)(@@) % وشجتني والصب بالبنين يشجي % % أنيق في ظعون ظيماء تحدى % % 16(@)(@@) % ورسوم من آل مي بوال % أصبحت فيه أعين الركب تندى % % 17(@)(@@) % بعدما كان للنياق مناخا % ولعهد الهوى مراحا ومغدى % % 18(@)(@@) % زجر العيس صاحبي يوم أقبل % % ن عليها فقلت مهلا رويدا % % 19(@)(@@) % خلنا والمطي نستفرغ الدم % % ع لأطلالها ونذكر عهدا % % 20(@)(@@) % ونعاني أسى لأرسم دار % % شقيت من بعاد سلمى وسعدى % % PageV01P342 21(@)(@@) % يا سقتها الماء وبل غواد % حاملات للري برقا ورعدا % % 22(@)(@@) % كلما قطبت من الجو وجها % عاد فيها بياضه مسودا % % 23(@)(@@) % من نياق ضوامر جاوز الوجد % % بأحشائها من الحب حدا % % 24(@)(@@) % أنت أعلى يدا وأطول باعا % ذي الصفات العلى ذميلا ووخدا % % 25(@)(@@) % كلما أصدرت أياديه وفدا % أوردت من غير جدواه وفدا % % 26(@)(@@) % باذل من نفيس ما يقتنيه % % من نوال ما يخجل الغيث رفدا % % 27(@)(@@) % أريحي تهدى إليه القوافي % % والقوافي لمثل علياه تهدى % % 28(@)(@@) % ميرينا السحاب يمطر وبلا % ونريه الرياض تنبت وردا % % 29(@)(@@) % ينظم المجد من مناقب علياه % % بجيد الأنام عقدا فعقدا % % 30(@)(@@) % ولآبائه الكرام الأعالي % % زادهم ربهم نعيما وخلدا % % PageV01P343 31(@)(@@) % حضرات تطوى إليها الفيافي % % وتقد البيداء بالسير قدا % % 32(@)(@@) % إن سرت من ثنائهم نفحات % % عاد فيها حر الهواجر بردا % % 33(@)(@@) % فكأن السر الإلهي منهم % % لازم في أهليه لا يستعدى % % 34(@)(@@) % يا علي الجناب وابن علي % أكرم 
ms112	 الناس أحسن الناس جدا % % 35(@)(@@) % أنت أعلى يدا باعا % في المعالي وأنت أثقب زندا % % 36(@)(@@) % هل تدانى برفعة وعلاء % % أو تضاهى فلم نجد لك ندا % % 37(@)(@@) % مثلت لي أيديك وهي تهادي % % مثل وبل الغمام بل هي أندى % % 38(@)(@@) % لا أرى الورد بعد ظلك عذبا % لا ولا العيش بعد جودك رغدا % % 39(@)(@@) % كلما قلت أورد العدم نقصي % % مدني بالنوال جودك مدا % % 40(@)(@@) % يرتجي غيري الثراء وأرجو % % منك بعد الثراء عزا ومجدا % % PageV01P344 41(@)(@@) % فإذا زدت من جنابك قربا % زدت عن خطة النوائب بعدا % % 42(@)(@@) % كل يوم أنال منك مراما % من بلوغ المنى وأبلغ قصدا % % 43(@)(@@) % فإذا كنت راضيا أنت عني % % لا أبالي أن يضمر الدهر حقدا % % 44(@)(@@) % إن نعماك كلما صيرتني % % لك عبدا أرى لي الدهر عبدا % % 45(@)(@@) % لست أقضي شكرانها ولو أني % % أملأ الخافقين شكرا وحمدا % % 46(@)(@@) % فاهنأ يا سيدي بأشراف عيد % % كل عام عليك يرزق عودا % % PageV01P345 البحر : خفيف تام 1(@)(@@) % من يحاول في الدهر مجدا أثيلا % % فليجرد له الحسام الصقيلا % % 2(@)(@@) % جعل السيف ضامنا وكفيلا % لبني المجد فاتخذه مقيلا % % 3(@)(@@) % وإذا ما سلكت ثم سبيلا % فاجعل السيف هاديا ودليلا % % 4(@)(@@) % عرفتكم حوادث الدهر أمرا % كان من قبل هذه مجهولا % % 5(@)(@@) % كشفت عن ضمائر تضمر الغدر % % وتبدي وفاءها المستحيلا % % 6(@)(@@) % وإذا لم تجد خليلا دفيا % فاعلم أن الحسام أوفى خليلا % % 7(@)(@@) % طالما عرف الزمان بقوم % % بدلتهم خطوبه تبديلا % % 8(@)(@@) % لا تبل الغليل ما عشت منهم % % أو يبل الصمصام فيهم غليلا % % 9(@)(@@) % وإذا لم يكن لحلمك أهل % % فمن الحلم أن تكون جهولا % % 10(@)(@@) % لا أرى فعلك الجميل بمن لم % % يرع عهدا من الجميل جميلا % % PageV01P346 11(@)(@@) % رضي الله عنك أغضبت قوما % ما أرادوا غير الفساد حصولا % % 12(@)(@@) % فلبئس القوم الذين أرادوا % % بك من سائر الأنام بديلا % % 13(@)(@@) % وسعوا في خرابها فاستفادوا % % أملا خائبا وعونا خذولا % % 14(@)(@@) % ويمينا لو يملكوها علينا % % تركوها معالما وطلولا % % 15(@)(@@) % إنما حاولوا أماني نفس % % حملتهم إذ ذاك عبئا ثقيلا % % 16(@)(@@) % ربما غرت المطامع قوما % غادرت منهم العزيز ذليلا % % 17 
ms113	(@)(@@) % أملوا والمحال ما أملوه % % سؤددا عنك فيهم لن يحولا % % 18(@)(@@) % لم ينالوا ما نلت من رفعة القدر % % ولو جيء بالجيوش قبيلا % % 19(@)(@@) % أجمعوا أمرهم ولله أمر % كان من فوق أمرهم مفعولا % % 20(@)(@@) % ثم لما جاؤوا إليكم سراعا % نزلوا عن مرابض الأسد ميلا % % PageV01P347 21(@)(@@) % فعبرتم نهر المجرة مخلين % % مكانا لهم عريضا طويلا % % 22(@)(@@) % نزلوا منزل الشيوخ وتأبى % % شفرة السيف أن يكونوا نزولا % % 23(@)(@@) % ثم لم يلبثوا خلافك في الدار % % كما يشتهون إلا قليلا % % 24(@)(@@) % رحلتها عنهم سيوف حداد % % ورجال تعبي الرجال الفحولا % % 25(@)(@@) % إن تصادم بها قواعد رضوى % % أوشكت في صدامهم أن تزولا % % 26(@)(@@) % بذلت نفسها لديك ورامت % % منك في بذلها الرضا والقبولا % % 27(@)(@@) % كلما استلت المهندة البيض % % أسالت من الدماء سيولا % % 28(@)(@@) % فتركت الأعداء ترتقب الموت % % منالرعب بكرة وأصيلا % % 29(@)(@@) % وملأت الأقطار بالخيل والرجل % % صليلا مريعة وصهيلا % % 30(@)(@@) % إن يوما عبرت فيه عليهم % % فتنادت عنك الرحيل الرحيلا % % PageV01P348 31(@)(@@) % هربوا قبل أن يروا صولة اللي % % يث وإن يشهروا دما مطولا % % 32(@)(@@) % يوم كان الفرار أهون من أن % تستبيح السيوف منها قتيلا % % 33(@)(@@) % ذل من لا يرى المنية عزا % في سبيل العلى وعاش ذليلا % % 34(@)(@@) % لو أقاموا فيها ولو بعض يوم % % لأخذت الأعداء أخذا وبيلا % % 35(@)(@@) % ولأكثرت فيهم القتل والسب % % ي ومثلتهم بها تمثيلا % % 36(@)(@@) % وتركت النساء ثكلى أيامى % % تكثر النوح بعدهم والعويلا % % 37(@)(@@) % إن لله حكمة حيرت فيك % % 38(@)(@@) % بلغتك الأقدار ما كنت تبغيه % % وكفت عدوك المخذولا % % 39(@)(@@) % وشفيت الصدور منا فقلنا % % صح جسم العلى وكان عليلا % % 40(@)(@@) % أيد الله فارس بن عجيل % % مثل ما أيد الإله عجيلا % % PageV01P349 41(@)(@@) % وبما رحمة ة منالله حلت % % بلغ اليوم آمل مأمولا % % 42(@)(@@) % أمن الخائفون في ظل قوم % % منع الخطب بأسه أن يصولا % % 43(@)(@@) % عاد للملك حافظا ومن % % على الناس ستره المسبولا % % 44(@)(@@) % كلما كر كرة بعد أخرى % % بعث الرعب في القلوب رسولا % % 45(@)(@@) % ما ثناه عن المكالام ثان % وأبى أن يرى الكريم بخيلا % % 46(@)(@@) % يقتفي إثر جده وأبيه % وكذا تتبع الفروع الأصولا % % 47(@)(@@) % فهنيئا 
ms114	 لكم معارج للمجد % % شبابا تسمونها وكهولا % % 48(@)(@@) % رفعة في العلاء أورثتموها % % من قديم الزمان جيلا فجيلا % % 49(@)(@@) % والمعالي لا ترتضي حيث شاءت % % غير أكفائها الكرام بعولا % % 50(@)(@@) % إن أسلافكم إذا خطبوها % % جعلوا مهرها قنا ونصولا % % PageV01P350 51(@)(@@) % قد بذلتم من النضار سيولا % % وجررتم من الفخار ذيولا % % 52(@)(@@) % لا تنال العداة منكم مراما % افيرجون للنجوم وصولا % % 53(@)(@@) % كيف تدنو منكم وأنتم أسود % ما اتخذتم غير الأسنة غيلا % % 54(@)(@@) % فإذا ما ادعيتم الفخر يوما % فكفى بالقنا شهودا عدولا % % 55(@)(@@) % قد خلقتم صبابة في المعالي % % صبوة الصب ما أطاع العذولا % % 56(@)(@@) % فانتشيتم وللهوى نشوات % % فكأني بكم سقيتم شمولا % % 57(@)(@@) % لابرحتم مناهلا ترد العا % % فون من عذب وردها سلسبيلا % % 58(@)(@@) % وبقيتم مدى الزمان وأبقيتم % % حديثا عن بأسكم منقولا % % PageV01P351 البحر : طويل 1(@)(@@) % قدمت قدوم الخير من بعد غيبة % % كما غاب بدر ثم أشرق ونجلى % % 2(@)(@@) % وأقبلت إقبال السعادة كلها % % علينا فحيا الله وجهك مقبلا % % 3(@)(@@) % فكنت كصوب المزن صادف ممحلا % وكنا بك الظمآن صادف منهلا % % 4(@)(@@) % وشمنا سنا برق المنى غير خلب % تهلل يمري العارض المهتللا % % 5(@)(@@) % تنقلت من دار لدار تنقلا % ومن عادة الأقمار أن تنقلا % % 6(@)(@@) % وجئت إلى بغداد تكشف ما بها % % من الضر حتى ترجع الحال أولا % % 7(@)(@@) % فأهلا وسهلا ما أقمت ومرحبا % عزيزا بأكناف المعالي مجلا % % 8(@)(@@) % بأصدق من وافى من الروم لهجة % % ومن بعث السلطان عينا وأرسلا % % 9(@)(@@) % أمين على العمال تخذل ظالما % وتنصر مظلوما وتننقذ مبتلى % % 10(@)(@@) % فقلنا غداة استبشر الناس كلهم % % عسى هذه الأحوال أن تتبدلا % % PageV01P352 11(@)(@@) % وفي ضمن لحن القول لولا موانع % % دقائق لا تخفى على من تأملا % % 12(@)(@@) % وكم فرج لله من بعد شدة % % تعللنا فيه الأماني تعللا % % 13(@)(@@) % فنحن وإن لم يحسن الكشف حالنا % % ولا شتتا خرقاء واهية الكلا % % 14(@)(@@) % ومن نظر الأشياء نظرة عارف % % رآها لديه مجملا ومفصلا % % 15(@)(@@) % وحسب الفتى ذي اللب متن إشارة % % يرى شرحها لو كان شرحا مطولا % % 16(@)(@@) % وما اختصك السلطان إلا لعلمه % % بأنك لن ترشى ولن تتبرطلا % % 17(@)(@@) % فمن فضله 
ms115	 والله يجزي بفضله % % علينا أمير المؤمنين تفضلا % % 18(@)(@@) % لتذهب عنا البغي جيئة راشد % % ونحمد فيه آملا ومؤملا % % 19(@)(@@) % وننتظر العقبى فإن وراءها % % من اللطف ما يحظى به سائر الملا % % 20(@)(@@) % فلا زال ظل الله يأتي بعدله % % وما لي الأحكام إلا ليعدلا % % PageV01P353 21(@)(@@) % ومن عدله أن يصطفيك لقربه % % ويدينك من نيل الرياسة والعلى % % 22(@)(@@) % ولم أر مثل الفضل يرفع أهله % % ولا حلية كالصدق في القول من حلى % % 23(@)(@@) % فقل ما تشا والقول في ما تقوله % % جلي ويأبى الله أن تتقولا % % 24(@)(@@) % ودم وابق واسلم ترتقي كل منصب % % إلأى قلة العلياء تعلو وتوقلا % % PageV01P354 البحر : طويل 1(@)(@@) % أقلب طرفي لا أرى غير منظر % متى تختبره كان ألأم مخبر % 2(@)(@@) % فلم أدر والأيام ذات تغير % % أيذهب عمري هكذا بين معشر % % 3(@)(@@) % مجالسهم عاق الكريم حلولها % % 4(@)(@@) % أسفت على من ليس يرجى العودة % % وكان يرى عونا على كل شدة % % 5(@)(@@) % قضى الله أن يقضي بأقرب مدة % % وأبقى وحيدا لا أرى ذا مودة % % 6(@)(@@) % من الناس لا عاش الومان ملولها % % 7(@)(@@) % إذا الحر في بغداد أصبح مبتلى % % وعاش عزيز القوم فيها مذللا % % 8(@)(@@) % فلا عجب إن رمت عنها تحولا % % وكيف أرى بغداد للحر منزلا % % 9(@)(@@) % إذا كان مفر الأديم نزيلها % % إلام المعالي يملك الرذل رقها % % 10(@)(@@) % لقد كنت لم أحفل بأيام عرسها % % ولم يتبدل شههمها بأخسها % % PageV01P355 11(@)(@@) % فكيف بها إن سادها غير جنسها % % ويسطو على آسادها ابن عرسها % % 12(@)(@@) % ويرقى على هام السماك ضئيلها % % 13(@)(@@) % عجبت لندب ثابت الجأش مفضل % % يرى بدلا من أرضه بمبدل % % 14(@)(@@) % ولم يك عن دار الهوان بمعزل % % فما منزل فيه الهوان بمنزل % % 15(@)(@@) % وفي الأرض للحر الكريم بديلها % % 16(@)(@@) % سأركلها يا سعد كل معدة % % أجوب عليها شدة بعد شدة % % 17(@)(@@) % وإن مت ألفي البيد موتة وحدة % % فللموت خير أن أقيم ببلدة % % 18(@)(@@) % يفوق بها الصيد الكرام ذليلها % % 19(@)(@@) % فكم قرصتني من عدى بقوارص % % هوابط من أرض المساوي شواخص % % 20(@)(@@) % ولاقيت صعب المرتقى غير ناكص % % وأصعب ما ألقى رئاسة ناقص % % PageV01P356 21(@)(@@) % مستويه 
ms116	 إن عدت كثير قليلها % % 22(@)(@@) % أنبه طرف الحظ والحظ راقد % % وأنهض للعلياء والجد قاعد % % 23(@)(@@) % وأنى أسود اليوم ولادهر فاسد % % وما ساد في أرض العراقين ماجد % % 24(@)(@@) % من الناس إلا فدمها ورذيلها % % 25(@)(@@) % بلاد بقوم قد سعوا في خرابها % % فليس شراب يرتجى من سرابها % % 26(@)(@@) % ولا لكريم منزل في رحابها % % فسر عن بلاد طوحت لا ترى بها % % 27(@)(@@) % مقيل كريم للعثار مقيلها % % 28(@)(@@) % فليس عليها بعد هذا معول % ولا عندها للآملين مؤمل % % 29(@)(@@) % فيالك دار قد نبت بي منزل % % بها الجود مذموم بها الحر مهمل % % 30(@)(@@) % بها الشح محمود فهل لي بديلها % % PageV01P357 31(@)(@@) % ورب أخ للمجد في المجد آلف % له في ربوع الألأمين مواقف % 32(@)(@@) % أقول له والقول كالسم زاعف % % ألا يا شقيق النفس عندي صحائف % % 33(@)(@@) % لقوم لئام هل لديك قبولها % % 34(@)(@@) % صحائف ذي غيظ على الدهر واجد % % عليها طوى قسرا جوانح حاقد % % 35(@)(@@) % وأن لما يبدي لساني وساعدي % % سأنشرها والهندواني شاهدي % % 36(@)(@@) % وأذكرها والسمهري وكيلها % % 37(@)(@@) % فمن مبلغ عني كلاما ملخصا % % أهان به عرض اللئيم وأرخصا % % 38(@)(@@) % أناسا يعيش الحر فيهم منغصا % % ولي كلمات فيهم تصدع الحصا % % 39(@)(@@) % وإني على وهني لما قد أمضني % % 40(@)(@@) % فكم مهمة قفر طويت مشافها % % بها كل هول لم يزل متشابها % % PageV01P358 41(@)(@@) % وواجهني ما لم يكن لي مواجها % عفا الله عني كم أجوب مهامها % % 42(@)(@@) % من الأرض يستف التراب دليلها % % 43(@)(@@) % طويت قيافيها ذهابا وجية % أكان عناء طيها أم بلية % 44(@)(@@) % كمن يبتغيها منية أو منية % لعلي ألاقي عصبة عبشمية % 45(@)(@@) % فروع مناجيب كرام أصولها % % 46(@)(@@) % إذا نطقوا بالقول فالقول مفلق % وإن حاولوا مجدا فعزم محلق % % 47(@)(@@) % لهم أرج لم يكتتم فهم معبق % % ينم بهم مجد رفيع ومنطق % % 48(@)(@@) % وينبي عن الخيل العتاق صهيلها % % 49(@)(@@) % لقد طالما قد بت أطوي وأنطوي % % على مضض أمست على الضيم تحتوي % % 50(@)(@@) % فيا سعد قل لي إن نصحت فأرعوي % % متى يلثم اللبات رمحي وترتوي % % PageV01P359 51(@)(@@) % سيوف بأعناق اللئام صليلها % % 52(@)(@@) % أحن إلى يوم عبوس عصبصب % يبل غليلي 
ms117	 منجب وابن منجب % % 53(@)(@@) % فيا ليت شعري هل أرني بموكب % % وحولي رجال من معد ويعرب % % 54(@)(@@) % مصاليت للحرب العوان قبيلها % % 55(@)(@@) % شفاء لنفسي يا أميمة حشرجت % % أو الساعة الخشنا إلى الأمر أحوجت % % 56(@)(@@) % فهل مثل آساد الشرى حين هيجت % % إذا أوقدوا للحرب نارا تأججت % % 57(@)(@@) % مجامرها والبيض تدمى نصولها % % 58(@)(@@) % كهول وشباب بآيهم % % ظفرنا رأينا كهلهم كفتيهم % % 59(@)(@@) % حماة بماضيهم وفي سمريهم % % وبالسمر تحمي البيض شبان حيهم % % 60(@)(@@) % وبالبيض تحمي السمر قسرا كهولها % % PageV01P360 61(@)(@@) % من القوم ما زالت تطبق سحبهم % % وفي عدم الجدوى تفارط صوبهم % % 62(@)(@@) % كرام بيوم الجدب يعرف خصبهم % % يهشون للعافي إذا ضاق رحبهم % % 63(@)(@@) % وجوها كأسياف يضيء صقيلها % % 64(@)(@@) % نماهم أب عالي الجناب سميذع % % وعن أصل زاكي العنصرين تفرعوا % % 65(@)(@@) % فإن يدعوا العلياء كان كما ادعوا % % إلى خندق ينمى علاهم إذا دعوا % % 66(@)(@@) % ومن خير أقيال إذا عد قيلها % % 67(@)(@@) % فمن لي بأبيات يروقك وصفها % % يهان معاديها ويكرم ضيفها % % 68(@)(@@) % بحيث العلى والعز مما يحضها % % وما العز إلا في بيوت تلفها % % 69(@)(@@) % عذارى وأبكار المطي حمولها % % 70(@)(@@) % تلم بها إن داهمتها ملمة % % رجال مساعيها إلى المجد جمة % PageV01P361 71(@)(@@) % وإن هي زمتها على السير أزمة % % تحف بها من آل وائل غلمة % 72(@)(@@) % لهم صولة في الحرب عال تليلها % % 73(@)(@@) % وإني لأشكو عصبة ما تطأطأت % % لرشد وغن تدع إلى الرشد أبطأت % % 74(@)(@@) % لها الويل قد خطت ضلالا وأخطأت % % إلى الله أشكو عصبة قد تواطأت % % 76(@)(@@) % إلام المعالي الرذل رقها % % ويمنعها من ظلمه مستحقها % % 77(@)(@@) % ألا دعوة للمجد نوف صدقها % % ألا غيرة تقضي المنازل حقها % % 78(@)(@@) % وتوقظ وسنان التراب خيولها % % 79(@)(@@) % عوادي بميدان الوغى لمفاخر % % بكل نزاري على الموت صابر % % 80(@)(@@) % إذا أقبلت من كل عوجاء ضامر % % عليها رجال من نزار وعامر % % 81(@)(@@) % مطاعين في الهيجا كريم قتلها % % PageV01P362 82(@)(@@) % إذا نحن لم نحمد بحال ذهابنا % % إلى شر جيل شرهم قد أنابنا % % 83(@)(@@) % فلم لا نعاني حزننا واكتئابنا % % كفى حزنا أنا نعنى ركابنا % % 85(@)(@@) % تركت ديار اللهو والعقل تابعي % % وبدلت سكناها 
ms118	 بسكنى المرابع % % 86(@)(@@) % وما غرني في الكون برق المطامع % % إذا كانت العلياء حشو مسامعي % % 87(@)(@@) % يريني المعالي سفحها وطلوعها % % 88(@)(@@) % لقد خاب مسعاها إليهم وبئس ما % % تقحمت الأمر الخطير تقحما % % 89(@)(@@) % تروح رواء ترتمي أي مرتمى % % فترجع حسرى ظلعا شفها الظما % % 90(@)(@@) % فيا ليتها ضلت وساء سبيلها % % 91(@)(@@) % لئن كان صحبي كل أروع يجتري % % على كل ليث في الكريهة قسور % % 92(@)(@@) % ترفعت عن رذل الصفات مصعر % % فلا ألوي للأنذال جيدي ومعشري % % PageV01P363 93(@)(@@) % بهاليل مستن المنايا نزولها % % 94(@)(@@) % إذا لم يكن ظل خليا من الأذى % % تلذذت في حر الهجير تلذذا % % 95(@)(@@) % وبدلت هذا بعد أن عفته بذا % % رعى الله نفسي لم ترد مورد القذى % % 96(@)(@@) % وتصدى وفي ظل الهجير ظليلها % % 97(@)(@@) % يرى المجد مجدا من أغار وأنجدا % % ولم يبق في جوب الفدافد فدفدا % % 98(@)(@@) % إلى أن شكته البيد راح أو اغتدى % % ومن رام مجدا دونه جرع الردى % % 99(@)(@@) % شكته الفيافي وعرها وسهولها % % 100(@)(@@) % رجال المعاني بالمعاني منالها % % مناها إذا ما حان يوما نزالها % % 101(@)(@@) % هي المجد أو ما يعجب المجد حالها % % وما المجد إلا دولة ورجالها % % 102(@)(@@) % أسود الوغى والسمهرية غيلها % % PageV01P364 103(@)(@@) % ديار بها نيطت علي تمائمي % % وكان العلى إذ ذاك عبدي وخادمي % % 104(@)(@@) % فكيف أرى في اللهو لمعة شائم % % إذا أبرقت في السفح صوب الغنائم % % 105(@)(@@) % وشاق لعين الناظرين همولها % % 106(@)(@@) % وعاودني ذكرى دمشق وأهلها % % يروقك مرآه إذا كنت رائدا % % 107(@)(@@) % فكن لي على صوب الدموع مساعا % % متى سمعت أذناك مني رواعدا % % 108(@)(@@) % تصوب عزاليها وتهمي سيولها % % 109(@)(@@) % ذكرت زمانا قد مضى في رحابها % % سقته عيون المزن حين انسكابها % % 110(@)(@@) % لقد شاقني ظبي الكناس الذي بها % % فكم مرة في بعدها واقترابها % % 111(@)(@@) % تشافت من الأرض الجراز محولها % % 112(@)(@@) % فأنبتت الخضراء محمر وردها % % وفاخرت البيداء في وشي بردها % % PageV01P365 113(@)(@@) % ولما طغت في جزرها بعد مدها % % سقى كل أرض صوبها فوق حدها % % 115(@)(@@) % فيا ليت شعري هل أرى بعد دارها % % من الغبر الوردي موقد نارها % % 116(@)(@@) % وهل ناشق من رندها وعرارها % % على 
ms119	 أنها مع قربها من مزارها % % 117(@)(@@) % تلوح لعيني في البعاد تلولها % % 118(@)(@@) % قضيت بها عيشا على الرغم ناعما % % أرى صادحا في صفحتيه وباغما % % 119(@)(@@) % فيوقظ من قد كان في الطيف حالما % % ولم يستمع فيها عذولا ولائما % % 120(@)(@@) % إذا كانت الورقاء فيه عذولها % % 121(@)(@@) % فكم راكب فوق الكميت وسابق % بحلبة مجراه غدا غير لاحق % % 122(@)(@@) % إذا لمعت في الليل لمعة بارق % % يذر عليه بالسنا ضوء شارق % % 124(@)(@@) % فكن مسعدي يا سعد حين انقضائها % % متى نفرت جيرانها من فنائها % % PageV01P366 125(@)(@@) % وأقفر ذاك المنحنى من ظبائها % % وحل سواد في مكان ضيائها % % 126(@)(@@) % وما أعطيت عند التوسل سولها % % 127(@)(@@) % فما العيش إلا منية أو منية % % به النفس ترضى وهي حرية % % 128(@)(@@) % فهذي برود نسجها سندسية % % وما النفس إلا فطرة جوهرية % % 129(@)(@@) % يروق لديها بالفعال جميلها % % 130(@)(@@) % ففيها يكون المرء شهما معظما % % لدى كل من لاقا يغدو مكرما % % 131(@)(@@) % فهذا تراه بالفخار معمما % % إذا المرء لم يجعل حلاها تحلما % % 132(@)(@@) % فقد خاب مسعاها وضل مقيلها % % 133(@)(@@) % فألطف آثار الحبيب طلولها % % وأنفس أطرار السيوف نصولها % % 134(@)(@@) % فهذي المزايا قل من قد يقولها % % وأحسن أخلاق الرجال عقولها % % PageV01P367 135(@)(@@) % وأحسن أنواع النياق فحولها % % 136(@)(@@) % كمال الفتى يحلو بحسن صفاته % % فيزهو لدى الأبصار لطف سماته % % 137(@)(@@) % يفوق الفتى أقرانه في هباته % % هل يقبل الإنسان نقصا لذاته % % 138(@)(@@) % إذا كان أنوار الرجال عقولها % % 139(@)(@@) % فلا العرض من هذا الفتى بمدنس % % إذا حل في ناد بخير مؤسس % 140(@)(@@) % وهذا الذي قد فاز في كل أنفس % % فكم أثمرت بالمجد أغصان أنفس % 142(@)(@@) % يؤرقني في ذكرهم حين يعرض % % نسيم الصبا يسري أو البرق يومض % 143(@)(@@) % أحبة قلبي حين صدوا وأعرضوا % % ويوحشني من بالرصافة قوضوا % % 144(@)(@@) % ولي عبرات في الديار أجيلها % % 145(@)(@@) % أرى جاهلا قد نال في جهله المنى % % كذا عالما عانى على علمه العنا % % PageV01P368 146(@)(@@) % وذلك من جور الزمان وما جنى % % ومن نكد الأيام أن يحرم الغنى % % 147(@)(@@) % كريم ، ويحظى بالثراء بخيلها % % 148(@)(@@) % أراني وأنياقي لإلف وصاحبي % % إلى أصبو وتصبو لجانب % % 149(@)(@@) % فما 
ms120	 بالنا لم نتفق في المذاهب % % تحن إلى أرض العراق ركائبي % % 150(@)(@@) % وصحبي بأرض الشام طاب مقيلها % % 151(@)(@@) % فهل تسمح الأيام لي برجوعها % % فأحظى بأحباب كرام جميعها % % 152(@)(@@) % لقد عاقني عنها نوى بنزوعها % % وأخرني عن جلق وربوعها % % 153(@)(@@) % علائق قد أعيا البخاتي حمولها % % 154(@)(@@) % لقد عادت الأيام تزهو بوصلها % % وإشراق محياها وأبيض فعلها % % 155(@)(@@) % لأنتظر العقبى وربي كفيلها % % وعاندني ذكرى دمشق وأهلها % % PageV01P369 156(@)(@@) % بكاء حمامات شجاني هديلها % % 157(@)(@@) % شجتني وما قلب الشجي كقلبها % % ولم تحك من عيني منهل صوبها % % 158(@)(@@) % فما برحت من شجوها أو لجها % % تردد ألحانا كأن الذي بها % % 159(@)(@@) % من الوجد ما بي والدموع أذيلها % % 160(@)(@@) % منازل أشواقي ومنشا علاقتي % % وسكر صباباتي بها وإفاقتي % % 161(@)(@@) % حلفت يمينا صادقا جهد طاقتي % % لئن بلغتني رمل يبرين ناقتي % % 162(@)(@@) % علي حرام ظهرها ومشيلها % % 163(@)(@@) % ولم أنس لا أنست في كل ضامر % % وقوفي على ربع الظمياء داثر % % 164(@)(@@) % بحسرة ملهوف وصفقة خاسر % % وكم لي على جيرون وقفة حائر % % 165(@)(@@) % له عبرات أغرقته سيولها % % PageV01P370 166(@)(@@) % ألم تنظر الأرزاء كيف تعددت % وساعدت النحس الشقي وأسعدت % % 167(@)(@@) % قعدنا وقامت أرذلونا فسودت % وكم باسقات بالرصافة أقعدت % % 168(@)(@@) % على عجزها حيث استطال فسيلها % % 169(@)(@@) % لقد نالها دنيا دني تجبرا % % فتاه على أشرافها وتكبرا % % 170(@)(@@) % وكان أذل العالمين وأحقرا % % لحا الله دنيا نالها أحقر الورى % % 171(@)(@@) % وتاه على القوم الكرام فسولها % % 172(@)(@@) % لعل خطوبا قد أساءت تسرني % % عواقبها حتى أراها بأعيني % % 173(@)(@@) % % سأحمل أعباء الخطوب وإنني % % PageV01P371 البحر : طويل 1(@)(@@) % بكت بدم من بعد عيسى وبندر % % عيون ذوي الحاجات من كل معشر % % 2(@)(@@) % أهرقت الدمع الغرير عليهما % % لواعج حزن في الجوانح مضمر % % 3(@)(@@) % فلم تبق منه زفرة ما تأججت % % ولا عبرة من مقلة لم تحدر % % 4(@)(@@) % أقول لركب راح يرتاد منزلا % لربع على نهر المجرة مقفر % % 5(@)(@@) % سرى ضاربا في الأرض ما بين منجد % % يخد أخاديد الفلاة ومغور % % 6(@)(@@) % أقيموا عل قبر ثوى بندر % % صدور المطايا ما ثوى قبر بندر % % 7(@)(@@) % ولا تسأموا من واكف الدمع وافرجوا % % من الحزن 