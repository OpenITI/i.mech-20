ms61	 مخضر السحاب عجائز % لهن بأطناب البيوت هرير % PageV01P223 البحر : وافر تام 1(@)(@@) % أتذكرهم ، وحاجتك ادكار ، % وقلبك ، في الظعائن ، مستعار % 2(@)(@@) % عسفن على الأماعز من حي % و في الأظعان عن طلح أزورار % % 3(@)(@@) % و قد أبكاك حين علاك شيب % بتوضح ، أو بناظرة ، الديار % 4(@)(@@) % فتحيا مرة ، وتموت أخرى ، % و تمحوها البوارح والقطار % % 5(@)(@@) % فدار الحي لست كما عهدنا % % و أنت إذا الأحبة فيك دار % 6(@)(@@) % و كنت إذا سمعت لذات بو % حنينا ، كاد قلبي يستطار % 7(@)(@@) % أتنفعك الحياة ، وأم عمر و % % قريب لا تزور ، ولا تزار % 8(@)(@@) % وقد لحق الفرزدق بالنصارى % % لينصرهم وليس به انتصار % 9(@)(@@) % ويسجد للصليب مع النصارى ، % و أفلج سهمنا فلنا الخيار % 10(@)(@@) % تخاطر من وراء حماي قيس % و خندف عز ما حمى الذمار % % PageV01P224 11(@)(@@) % أقين يا تميم يعيب قيسا % يطير على لهازمه الشرار % % 12(@)(@@) % أخاكم يا تميم ، ومن يحامي ، % وأم الحرب مجلبة نوار % 13(@)(@@) % و يعلم من يحارب أن قيسا % صناديد ، لها للجج الغمار % 14(@)(@@) % و قيس يا فرزدق لو أجاروا % % بني العوام ما افتضح الجوار % 15(@)(@@) % إذا لحمى فوارس غير ميل % إذا ما امتد في الرهج الغبار % 16(@)(@@) % و كروا كل مقربة سبوح % وطرف في حوالبه اضطمار % 17(@)(@@) % غدرتم بالزبير وما وفيتم % فدادينا يبيت لها خوار % 18(@)(@@) % فما رضيت بذمتكم قريش ؛ % و ما بعد الزبير به اغترار % PageV01P225 البحر : طويل 1(@)(@@) % أزادا سوى يحيى تريد وصاحبا % ألا إن يحيى نعم زاد المسافر % 2(@)(@@) % فما تأمن الوجناء وقعة سيفه % إذا أنفضوا أو خف ما في الغرائر % 3(@)(@@) % وما من فتى حي بيحيى أبيعه % بلا فاجر الدنيا ولا غير فاجر % PageV01P226 البحر : طويل 1(@)(@@) % فدى لبني سعد بن ضبة خالتي % % إذا أفزع الروع السوام المنفرا % % 2(@)(@@) % هموا قتلوا صبرا شيربن خالد % و أبكوا لبسطام مى تم حسرا % % 3(@)(@@) % وهم عصبوا يوم الشقيقة رأسه % رقيق النواحي ، لا رداء محبرا % % 4(@)(@@) % فلما أتى الصهباء موقعهم به ، % دعت ويلها واستعجلت أن تخمرا % % PageV01P227 البحر : طويل 1(@)(@@) % ألا يال قوم من ملامة عيثم ، ألا يال قوم 
ms62	 من ملامة عيثم ، % وداري بجو الأخنسية داريا % % 2(@)(@@) % تلوم على عض الزمان ولم تدع % سناما ولا مخامن العظم واريا % % PageV01P228 البحر : طويل 1(@)(@@) % لمن رسم دار ، هم أن يتغيرا ، % تراوحه الأرواح والقطر أعصرا % % 2(@)(@@) % و كنا عهدنا الدار والدار مرة % هي الدار إذ حلت بها أم يعمرا % % 3(@)(@@) % ذكرت بها عهدا على الهجر والبلى ، % ولابد للمشعوف أن يتذكرا % % 4(@)(@@) % أجن الهوى ما أنس لا أنس موقفا % عشية جرعاء الصريف ومنظرا % % 5(@)(@@) % تباعد هذا الوصل إذ حل أهلها % % وقبح قينا ، بالفرزدق ، أعورا % % 6(@)(@@) % ليالي تسبي القلب من غير ريبة ، % إذا سفرت عن واضح اللون أزهرا % % 7(@)(@@) % أتى دون هذا الهم هم فأسهرا ، % أراعى نجوما تاليات وغورا % % 8(@)(@@) % أقول لها من ليلة ليس طولها % % كطول الليالي ليت صبحك نورا % % 9(@)(@@) % أخاف على نفس ابن أحوز إذ شفى % % وأبلى بلاء ، ذا حجول ، مشهرا % % 10(@)(@@) % شديدا من الأثآر خولة بعدما % % دعت ويلها واستعجلت أن تخمرا % % PageV01P229 11(@)(@@) % ألا رب سامي الطرف من آل مازن ، % إذا شمرت عن ساقها الحرب شمرا % % 12(@)(@@) % أتنسون شدات ابن أحوز ؟ إنها % % 13(@)(@@) % وأدرك ثأر المسمعين بسيفه ، % وأغضب في شأن الخيار فنكرا % % 14(@)(@@) % جعلت ، بقبر للخيار ومالك ، % وقبر عدي في المقابر ، أقبرا % % 15(@)(@@) % وغرقت حيتان المزون وقد لقوا % % تميما ، وعزا ذا مناكب مدسرا % % 16(@)(@@) % و أطفأت نيران النفاق وأهله % وقد حاولوا في فتنة أن تسعرا % % 17(@)(@@) % فلم تبق منهم راية يرفعونها % % و لم تبق من آل المهلب عسكرا % % 18(@)(@@) % فأن لأنصار الخليفة ناصرا % عزيزا إذا طاغ طغى وتجبرا % % 19(@)(@@) % فذو العرش أعطانا الكره والرضا % % إمام الهدى ذا الحكمة المتخيرا % % 20(@)(@@) % فأضحت راوسي الملك في مستقرها % % لمنجب من آل مروان أزهرا % % PageV01P230 21(@)(@@) % و إن الذي أعطى الخلافة أهلها % % أجن الهوى ما أنس موقفا % 22(@)(@@) % منابر ملك كلها مضرية ، % يصلي علينا من أعرناه منبرا % % 23(@)(@@) % أنا ابن الثرى أدعو قضاعة ناصري % % و أل نزار ما أعز وأكثرا % % 24(@)(@@) % عديدا معديا له ثروة الحصى ، % وعزا قضاعيا ، وعزا تنزرا % % 25(@)(@@) % نزار إلى كلب وكلب إليهم ، % أحقز 
ms63	 أدنى من صداء وحميرا % % 26(@)(@@) % و أي معدي يخاف وقد رأى % % جبال معد والعديد المجمهرا % % 27(@)(@@) % وأبناء إسحق الليوث إذا ارتدوا % % محامل موت لابسين السنورا % % 28(@)(@@) % فيوما سرابيل الحديد عليهم ؛ % و يوما ترى خزا وعصبا منيرا % % 29(@)(@@) % إذا افتخروا عدوا الصبهند منهم % وكسرى وآل الهرمزان وقيصرا % % 30(@)(@@) % ترى منهم مستبرصين على الهدى % % وذا التاج يضحي مرزبانا مسورا % % PageV01P231 31(@)(@@) % أغر شبيها بافنيق إذا ارتدى % % على القبطري الفارسي ، المزررا % % 32(@)(@@) % وكان كتاب فيهم ونبوة ، % وكانوا بإصطخر الملوك وتسترا % % 33(@)(@@) % لقد جاهد الوضاح بالحق معلما ، % فأورث مجدا باقيا أهل بربرا % % 34(@)(@@) % أبونا أبو إسحاق يجمع بيننا % % أب كان مهديا نبيا مطهرا % % 35(@)(@@) % و منا سليمان النبي الذي دعى % % فأعطي بنيانا ، وملكا مسخرا % % 36(@)(@@) % وموسى وعيسى والذي خر ساجدا % فأنبت زرعا دمع عينيه أخضرا % % 37(@)(@@) % و يعقوب منا زاده الله حكمة % و كان ابن يعقوب أمينا مصورا % 38(@)(@@) % فيجمعنا والغر أبناء سارة % أب لا نبالي بعده من تعذرا % % 39(@)(@@) % أبونا خليل الله ، والله ربنا ، % رضينا بما أعطى الاله وقدرا % % 40(@)(@@) % بني قبلة الله التي يهتدى بها % % فأورثنا عزا وملكا معمرا % % PageV01P232 41(@)(@@) % لشتان من يحمى معدا من العدا % % و من يسكن الماخور في من تمخرا % % 42(@)(@@) % فبؤ بالمخازي يا فرزدق لم يبت % أديمك إلا واهيا غير أوفرا % % 43(@)(@@) % فإنك لوضمنت من مازن دما ، % لما كان لابن القين أن يتخيرا % % 44(@)(@@) % فلا تأمن الأعداء أسياف مازن % ولكن رأي ابني قفيرة قصرا % % 45(@)(@@) % فأخزيت يا ابن القين آل مجاشع % فأصبح ما تحمى مباحا مدعثرا % % 47(@)(@@) % فما كان جيران الزبير مجاشع % بألأم من جيران وهب وأغدرا % % 48(@)(@@) % و قالت قريش للحواري جاركم % للاقى جوارا صافيا غير أكدرا % % 49(@)(@@) % تراغيتم يوم الزبير ، كأنكم % ضباع مغارات يبادرن أجعرا % % 50(@)(@@) % و جعثن كانت خزية في مجاشع % كما كان غدر بالحواري منكرا % % 51(@)(@@) % فان عقالا والحتات كلاهما % % تردى بثوبي غادر وتأزرا % % PageV01P233 52(@)(@@) % ألم تحبسوا وهبا تمنونه المنى ، % و كان أخا هم طريدا مسيرا % % 53(@)(@@) % فلو أن وهبا كان حل رجاله % بحجر للاقى 
ms64	 ناصرين وعنصرا % % 54(@)(@@) % و لو حل فينا عاين القوم دونه % عوابس يعلكن الشكيم وضمرا % % 55(@)(@@) % إذا لسمعت الخيل والخيل تدعى % % رياحا وتدعوا العاصمين وجعفرا % % 56(@)(@@) % فوارس لا يدعون يال مجاشع % إذا كان ما تذري السنابك عثيرا % % 57(@)(@@) % و لو ضاف أحياء بحزن مليحة % للاقى جوارا صافيا أكدرا % % 58(@)(@@) % هم ضربوا هام الملوك وعجلوا % % بورد غداة الحوفوان فبكرا % % 59(@)(@@) % و قد جرب الهرماس وقع سيوفنا % % و صدعن عن رأس ابن كبشة مغفرا % % 60(@)(@@) % و قد جعلت يوما بطخفة خيلنا % % لآل أبي قابوس ، يوما مذكرا % % 61(@)(@@) % فنورد يوم الروع خيلا مغيرة ، % و تورد نابا تحمل الكير صوأرا % % PageV01P234 62(@)(@@) % سبقت بأيام الفضال ولم تجد % لقومك إلا عقر نابك مفخرا % % 63(@)(@@) % لقيت القروم الخاطرات فلم يكن % نكيرك إلا أن تشول وتيعرا % % 64(@)(@@) % ولاقيت خيرا من أبيك فوارسا ، % و أكرم أياما سحيما وجحدرا % % 65(@)(@@) % هم تركوا قيسا وعمرا كلاهما % % يمج نجيعا من دم الجوف أحمرا % % 66(@)(@@) % و سار لبكر نخبة من مجاشع % فلما رأى شيبان والخيل كفرا % % 67(@)(@@) % وفي أي يوم لم تساقوا غنيمة ، % و جاركم فقع يحالف قرقرا % % 68(@)(@@) % لقد كنت يا ابن القين ذا خبرة بكم % % و عوف أبو قيس بكم كان أخبرا % % 69(@)(@@) % فلا تتقون الشر حتى يصيبكم ، % و لا تعرفون الأمر إلا تدبرا % % 70(@)(@@) % و عوف يعاف الضيم في آل مالك % % وكنتم بني جوخى على الموت أصبرا % % 71(@)(@@) % تركتم مزادا عند عوف رهينة % فأطعمه عوف ضباعا وأنسرا % % PageV01P235 81(@)(@@) % أشاعت قريش للفرزدق خزية % و تلك الوفود النازلون الموقرا % % 82(@)(@@) % عشية لاقى القرد قرد مجاشع % هزبرا ابأشبلين في الغيل قسورا % % 83(@)(@@) % من المحميات الغيل غيل خفية ، % ترى تحت لحييه الفريس المعفرا % % 84(@)(@@) % جزى الله ليلى في جبير ملامة ، % % 85(@)(@@) % إذا ذكرت ليلى جبيرا تعصرت ، % وليس بشاف داءها أن تعصرا % % 86(@)(@@) % ألا قبح الله الفرزدق كلما % % أهل مصل للصلاة وكبرا % % 87(@)(@@) % فلا يقربن المروتين ولا الصفا ، % ولا مسجد الله الحرام المطهرا % % 88(@)(@@) % فإنك لو تعطي الفرزدق درهما % على دين نصرانية ، لتنصرا % % 89(@)(@@) % % و ألأم 
ms65	 منسوب قفا حين أدبرا % % 90(@)(@@) % لحى الله ماء من عروق خبيثة % سقت سابياء جاء فيها مخمرا % % PageV01P236 100(@)(@@) % فهل لكم في حنثر آل حنثر % ولما تصب تلك الصواعق حنثرا % % 101(@)(@@) % فان ربيعا والمشيع فاعلما % % على موطن لم يدريا كيف قدرا % % 102(@)(@@) % ألا رب أعشى ظالم متخمط ، % جعلت لعينيه جلاء فأبصرا % % 103(@)(@@) % ألم أك نارا يتقي الناس شرها % % وسما لأعداء العشيرة ممقرا % % 104(@)(@@) % ألم أك زاد المرملين ووالجا % إذا دفع الباب الغريب المعورا % % 105(@)(@@) % نعد لأيام نعد ، لمثلها ، % فوارس قيس دارعين وحسرا % % 106(@)(@@) % أتنسون يومي رحرحان كليهما % % و قد أشرع القوم الوشيج المؤمرا % % 107(@)(@@) % و ما كنت يا بن القين تلقي جيادهم % وقوفا ولا مستنكرا أن تعقرا % % 108(@)(@@) % تركت بوادي رحرحان نساءكم % % و يم الصفا لاقيتم الشعب أوعرا % % 109(@)(@@) % سمعتم بني مجد دعوا يال عامر % فكنتم نعاما بالحزيز منفرا % % PageV01P237 110(@)(@@) % و أسلتم لابني أسيدة حاجبا % ولاقى لقيط حتفه فتقطرا % % 111(@)(@@) % و أسلمت القلحاء للقوم معبدا % يجاذب مخموسا من القد أسمرا % % PageV01P238 البحر : رجز تام 1(@)(@@) % أعوذ بالله العزيز الغفار % و بالامام العدل غير الجبار % 2(@)(@@) % من ظلم حمان وتخريب الدار % فاسأل بني صحب ورهط الجرار % % 3(@)(@@) % و السلميين العظام الأخطار % والقرشيين ذوي السيح الجار % 4(@)(@@) % هل كان قبل حفرنا من محفار % أو كان من ورد به أو إصدار % 5(@)(@@) % حفرتها وهي كناس البقار ، % مقفرة الجوف أشد الاقفار % % 6(@)(@@) % يمشي بها كل موشى بربار % % موشم الأكرع فيها جار % % 7(@)(@@) % يهز روقية كهز الأسوار % تكسر المنقار بعد المنقار % 8(@)(@@) % بعددم الكف ونزع الأظفار % يصهلن في الجب صهيل الأمهار % 9(@)(@@) % في الجبل الأصم غير الخوار % فسائل الجيران عن جار الدار % 10(@)(@@) % فالجار قد يعلم أخبار الجار ، % و احكم على تبين واستبصار % PageV01P239 11(@)(@@) % يا ليتنا ونمر بن أنمار ، % و الهوبر بن الهنبر بن اليهبار % 12(@)(@@) % عند مصلى البيت دون الأستار ، % مقام إبراهيم حيث الأحجار % 13(@)(@@) % و يرفع الستر بنو عبد الدار % ثم حفنا بالعزيز الغفار % 14(@)(@@) % فلقى الكاذب فوار النار % % PageV01P240 البحر : بسيط تام 1(@)(@@) % حي الديار على 
ms66	 سفي الأعاصير % أسننكرتني أم ضنت بتخبيري % % 2(@)(@@) % حي الديار التي بلى معارفها % % كل البلا نفيان القطر والمور % 3(@)(@@) % هل أنت ذاكرة عهدا على قدم % أسقيت من سبل الغر المباكير % 4(@)(@@) % هل تعرف الربع إذ في الربع عامره ، % فاليوم أصبح قفرا غير معمور % 5(@)(@@) % أو تبصران سنا برق أضاء لنا % % رمل السمينة ذا الأنقاء والدور % % 6(@)(@@) % ما حاجة لك في الظعن التي بكرت % من دارة الجأب كالنخل المواقير % 7(@)(@@) % كاد التذكر يوم البين يشفعني % % إن الحليم بهذا غير معذور % 8(@)(@@) % ماذا أردت إلى ربع وقفت به ، % هل غير شوق وأحزان وتذكير ؟ % 9(@)(@@) % ما كنت أول مخزون أضربه % برح الهوى ، وعذاب غير تفتير % 10(@)(@@) % تبيت ليلك ذا وجد يخامره ، % كأن في القلب أطراف المسامير % PageV01P241 11(@)(@@) % يا أم حزرة ! إن العهد زينه % ود كريم وسر غير منثور % % 12(@)(@@) % حييت شعثا وأطلاحا مخدمة ، % والميس منقوشة نقش الدنانير % 13(@)(@@) % هل في الغواني لمن قتلن من قود % أو من ديات لقتل الأعين الحور % 14(@)(@@) % يجمعن خلفا وموعودا بخلن به % إلى جمال وإدلال وتصوير % 15(@)(@@) % أما يزيد فان الله فهمه % حكما وأعطاه ملكا واضح النور % 16(@)(@@) % سرنا من الدام والروحان والأدمى % % تنوي يزيد يزيد المجد والخير % 17(@)(@@) % عيدية برحال الميس تنسجها % % حتى تفرج ما بين المسامير % 18(@)(@@) % خوض العيون إذا استقبلن هاجرة % يحسبن عورا وما فيهن من عور % 19(@)(@@) % تخدي بنا العيس والحرباء منتصب % و الشمس والجة ظل اليعافير % 20(@)(@@) % من كل شوساء لما خش ناظرها % % أدنت مذمرها من واسط الكور % PageV01P242 21(@)(@@) % ما كاد تبلغ أطلاح أضر بها % % بعد المفاوز بين البشر والنير % 22(@)(@@) % من المهاري التي لم يفن كدنتها % % كر الروايا ولم يحدجن في العير % 23(@)(@@) % صبحن في الركب ، إن الركب قحمهم % % خمس جموح فهذا ورد تبكير % 24(@)(@@) % قفرا الجبا لا ترى إلا الحمام به % من الأنيس خلاء غير محضور % 25(@)(@@) % تنفي دلاء سقاة القوم إذ وردوا % % كالغسل عن جم طام غير مجهور % 26(@)(@@) % كأن اونا به من زيت سامرة % ولون ورد من الحناء معصور % 27 
ms67	(@)(@@) % لما تشوق بعض القوم قلت لهم % % أين اليمامة من عين السواجير % 28(@)(@@) % زوروا يزيد فان الله فضله % و استبشروا بمريع النبت محبور % 29(@)(@@) % لاتسأموا للمطايا ما سرين بكم % و استبشروا بنوال غير منزور % 30(@)(@@) % و استمطروا نفحات غير مخلفة % من سيب مستبشر بالملك مسرور % PageV01P243 31(@)(@@) % سرنا على ثقة حتى نزلت بكم % % مستبشرا بمريع النبت ممطور % 32(@)(@@) % لما بلغت إمام العدل قلت لهم % قد كان من طول إدلاجي وتهجيري % % 33(@)(@@) % فاستوردوا منهلا ريان ذا حبب % من زاخر البحر يرمي بالقراقير % 34(@)(@@) % لقد تركت فلا نعدمك إذ كفروا % % لابن المهلب عظما غير مجبور % 35(@)(@@) % يا ابن المهلب إن الناس قد علموا % % أن الخلافة للشم المغاوير % 36(@)(@@) % لا تحسبن مراس الحرب إذ خطرت % أكل القباب وأدم الرغف بالصبر % 37(@)(@@) % خليفة الله إني قد جعلت لكم % غرا سوابق من نسجي وتحبيري % % 38(@)(@@) % لا ينكر الناس قدما أن تعرفهم % سبقا إذا بلغوا نحز المضامير % 39(@)(@@) % زان المنابر ، واختالت بمنتجب % مثبت بكتاب الله منصور % 40(@)(@@) % في أل حرب وفي الأعياص منبته % هم ورثوك بناء عالي السور % PageV01P244 41(@)(@@) % يستغفرون لعبد الله إذ نزلوا % % بالحوض منزل إهلال وتكبير % 42(@)(@@) % يكفي الخليفة أن الله فضله % عزم وثيق وعقد غير تغرير % 43(@)(@@) % ما ينبت الفرع نبعا مثل نبعتكم % عيدانها غير عشات ولا خور % 44(@)(@@) % قد أخرج الله قسرا من معاقلهم % أهل الحصون وأصحاب المطامير % 45(@)(@@) % كم من عدو فجذ الله دابرهم % كادوا بمكرهم فارتد في بور % 46(@)(@@) % وكان نصرا من الرحمن قدره ؛ % و الله ربك ذو ملك وتقدير % PageV01P245 البحر : بسيط تام 1(@)(@@) % قل للديار : سقى أطلالك المطر ، % قد هجت شوقا فماذا ترجع الذكر % 2(@)(@@) % أسقيت محتفلا يستن وابله ؛ % أو هاطلا مرثعنا صوبه درر % 3(@)(@@) % إذ الزمان زمان لا يقاربه % هذا الزمان وإذ في وحشه غرر % 4(@)(@@) % إن الفؤاد مع الظعن التي بكرت % من ذي طلوح وحالت دونها البصر % 5(@)(@@) % قالوا : لعلك مخزون ! فقلت لهم : % خلوا الملامة لا شكوى ولا عذر % 6(@)(@@) % إن الخليط أجد البين يوم غدوا % % من دارة الجأب 
ms68	 إذ أحد اجهم زمر % 7(@)(@@) % لما ترفع من هيج الجنوب لهم % ردوا الجمال لاصعاد وما انحدروا % % 8(@)(@@) % من كل أصهب أسرى في عقيقته % نسق من الروض حتى طير الوبر % 9(@)(@@) % بزل كأن الكحيل الصرف ضرجها % % حيث المناكب يلقى رجعها القصر % 10(@)(@@) % أبصرن أن ظهور الأرض هائجة % و قلص الرطب إلا أن يرى سرر % % PageV01P246 11(@)(@@) % هل تبصران حمول الحي إذ رفعت % حي بغير عباء الموصل اختدروا % % 12(@)(@@) % قالوا نرى الآل يزهى الدوم أو ظعنا ؛ % يا بعد منظرهم ذاك الذي نظروا % % 13(@)(@@) % ماذا يهيجك من دار ومنزلة % أم بكاؤك إذ جيرانك ابتكروا % % 14(@)(@@) % نادى المنادي ببين الحي فابتكروا % % منا بكورا فما ارتابوا وما انتظروا % % 15(@)(@@) % حاذرت بينهم بالأمس إذ بكروا % % منا وما ينفع الاشفاق والحذر % 16(@)(@@) % كم دونهم من ذرى تيه مخفقة % يكاد ينشق عن مجهولها البصر % 17(@)(@@) % إنا بطخفة أو أيام ذي نجب ، % نغم الفوارس لما التفت العذر % % 18(@)(@@) % لم يخزأول يربوع فوارسهم % ولا يقال لهم : كلا ، إذا افتخروا % % 19(@)(@@) % سائل تميما عن فوارسنا % % حين التقى باياد القلة الكدر % % 20(@)(@@) % لولا فوارس يربوع بذي نجب % ضاق الطريق وعي الورد والصدر % PageV01P247 21(@)(@@) % إن طاردوا الخيل لم يشووا فوارسها % % أو واقفوا عانقوا الأبطال فاهتصروا % % 22(@)(@@) % نحن اجتنبنا حياض المجد مترعة % من حومة لم يخالط صفوها كدر % 23(@)(@@) % إنا وأمك ما ترجى ظلامتنا % % عند الحفاظ وما في عظمنا خور % 24(@)(@@) % تلقى تميما إذا خاضت قرومهم % سائل تميما وبكرا عن فوارسنا % % 25(@)(@@) % هل تعرفون بذي بهدى فوارسنا % % يوم الهذيل بأيدي القوم مقتسر % 26(@)(@@) % الضاربين ، إذا ما الخيل ضرجها % % وقع القنا والتقى من فوقها الغبر % 27(@)(@@) % إن الهذيل بذى بهدى تداركه % ليث إذا شد من نجداته الظفر % 28(@)(@@) % أرجو لتغلب إذ غبت أمورهم % ألا يبارك في الأمر الذي ائتمروا % % 29(@)(@@) % خابت بنو تغلب إذ ضل فارطهم % % حوض المكارم إن المجد مبتدر % % 30(@)(@@) % الظاعنون على العمياء إن ظعنوا % % و السائلون بظهر الغيب ما الخبر % % PageV01P248 31(@)(@@) % وما رضيتم لأجساد تحرقهم % في النار إذ حرقت أرواحهم سقر % % 32(@)(@@) % ألآكلون 
ms69	 خبيث الزاد وحدهم % و النازلون إذا واراهم الخمر % % 33(@)(@@) % يحمي الذين ببطحاوي منى حسبي ، % تلك الوجوه التي يسقى بها المطر % 34(@)(@@) % أعطوا خزيمة والأنصار حكمهم % و الله عزز بالأنصار من نصروا % % 35(@)(@@) % إني رأيتكم والحق مغضبة % تخزون أن يذكر الجحاف أو زفر % 36(@)(@@) % قوما يردن سرح القوم عادية % شعث النواصي إذا ما يطرد العكر % 37(@)(@@) % إن الأخيطل خنزير أطاف به % إحدى الدواهي التي تخشى وتنتظر % 38(@)(@@) % قادوا اليكم صدور الخيل معلمة % تغشى الطعان وفي أعطافها زور % 39(@)(@@) % كانت وقائع قلنا : لن ترى أبدا % من تغلب بعدها عين ولا أثر % 40(@)(@@) % حتى سمعت بخنزير ضغا جزعا % منهم فقلت : أرى الأموات قد نشروا % % PageV01P249 41(@)(@@) % أحياؤهم شر أحياء وألأمه % والأرض تلفظ موتاهم إذا قبروا % % 42(@)(@@) % رجس يكون ، إذا صلوا ، أذانهم % قرع النواقيس لا يدرون ما السور % 43(@)(@@) % فما منعتم غداة البشر نسوتكم % و لاصبرتم لقيس مثل ما صبروا % % 44(@)(@@) % أسلتم كل مجتاب عباءته % و كل مخضرة القربين تبتقر % % 45(@)(@@) % هلا سكنتم فيخفي بعض سوأتكم % إذ لا يغير في قتلاكم غير % % 46(@)(@@) % يا ابن الخبيثة ريحا من عدلت بنا % % أم من جعلت إلى قيس إذا ذخروا % % 47(@)(@@) % قيس وخندف أهل المجد قبلكم % لستم إليهم ولا أنتم لهم خطر % 48(@)(@@) % موتوا من الغيظ غما في جزيرتكم % لم يقطعوا بطن دونه مضر % 49(@)(@@) % ما عد قوم وإن عزوا وإن كرموا % % إلا افتخرنا بحق فوق ما افتخروا % % 50(@)(@@) % نرضى عن الله أن الناس قد علموا % % أن لن يفاخرنا من خلقه بشر % PageV01P250 51(@)(@@) % وما لتغلب إن عدت مساعيها % % نجم يضيء ولا شمس ولا قمر % 52(@)(@@) % كانت بنو تغلب لا يعل جدهم % كالمهلكين بذي الأحقاف إذ دمروا % % 53(@)(@@) % صبت عليهم عقين ما تنظرهم % حتى أصابهم بالحاصب القدر % 54(@)(@@) % تهجون قيسا وقد جذوا دوابركم % حتى أعز حصاك الأوس والنمر % 55(@)(@@) % إني نفيتك عن نجد فما لكم % نجد وما لك من غوريه حجر % 56(@)(@@) % تلقى الأخيطل في ركب مطارفهم % برق العباء وما حجوا وما اعتمروا % % 57(@)(@@) % الضاحكين إلى الخنزير شهوته ، % يا 
ms70	 قبحت تلك أفواها إذا اكتشروا % % 58(@)(@@) % و المقرعين على الخنزير ميسرهم % بئس الجزور وبئس القوم إذ يسروا % % 59(@)(@@) % والتغلبي لئيم ، حين تجهره ؛ % والتغلبي لئيم حين يختبر % 60(@)(@@) % والتغلبي ، إذا تمت مروءته ، % عبد يسوق ركاب القوم مؤتجر % PageV01P251 64(@)(@@) % نسوان تغلب لا حلم ولا حسب % و لا جمال ولا دين ولا خفر % 65(@)(@@) % ما كان يرضى رسول الله دينهم % و الطيبان أبو بكر ولا عمر % 66(@)(@@) % جاء الرسول بدين الحق فانتكثوا ، % وهل يضير رسول الله أن كفروا % % 67(@)(@@) % يا خزر تغلب إن اللؤم حالفكم % ما دام في ماردين الزيت يعتصر % % 68(@)(@@) % تسربلوا اللؤم خلقا من جلودهم % ثم ارتدوا بثياب اللؤم واتزروا % % 69(@)(@@) % الشاتمين بني بكر إذا بطنوا ، % والجانحين إلى بكر إذا افتقروا % % PageV01P252 البحر : طويل 1(@)(@@) % طربت وهاج الشوق منزلة قفر % تراوحها عصر خلا دونه عصر % 2(@)(@@) % أقول لعمرو يوم جمدي نعامة % % بك اليوم بأس لا غراء ولا صبر % 3(@)(@@) % ألا تسألان الجو متاع % أما برحت بعدي يجودة والقصر % % 4(@)(@@) % أقول وذاكم للعجيب الذي أرى % % أمال ابن مال ! ما ربيعة والفخر ؟ % 5(@)(@@) % أساءوا فكانت من ربيعة عادة % بان لا يزالو نازلين ولا يقروا % % 6(@)(@@) % يحالفهم نقر قديم وذلة % و بئس الحليفان المذلة والفقر % 7(@)(@@) % فصبرا على ذل ربيع بن مالك % وكل ذليل خير عادته الصبر % 8(@)(@@) % و أكثر ما كانت ربيعة أنها % % خباءان شتى لا أنيس ولا قفر % 9(@)(@@) % بأي قديم يا ربيع بن مالك % وأنتم ذنابى لا يدان ولا صدر % 10(@)(@@) % إذا قيل يوما يال حنظلة اركبوا % % نزلت بقرواح وطم بك البحر % % PageV01P253 البحر : طويل 1(@)(@@) % عفا ذو حمام بعدنا وحفير ، % وبالسر مبدى منهم وحضور % 2(@)(@@) % تكلفتها لا دانيا منك وصلها ، % ولا صرمها شيء عليك يسير % 3(@)(@@) % لئن يسلم الله المراسيل بالضحى % % و مر القوافي يهتدى وبحور % % 4(@)(@@) % تبلغ بني نبهان مني قصائدا ، % تطالع من سلمى وهن وعور % 5(@)(@@) % وأعور من نبهان يعوي ودونه % من الليل بابا ظلمة وستور % % 6(@)(@@) % دعا وهو حي مثل ميت وإن يمت % فهذا له بعد الممات نشور % 7 
ms71	(@)(@@) % رفعت له مشبوبة يهتدى بها ، % يكاد سناها في السماء يطير % % 8(@)(@@) % فلما استوى جنباه ضاحك نارنا % % عظيم أفاعي الحالبين ، ضرير % 9(@)(@@) % أخو البؤس أما لحمه عن عظامه % فعار ، وأما مخهن فرير % 10(@)(@@) % فقلت لعبدينا أديرا رحاكما % % فقد جاء زحاف العشى جرور % PageV01P254 11(@)(@@) % أبو منزل الأضياف يغشون ناره % ويعرف حق النازلين جرير % 12(@)(@@) % إذا لم يدروا عاتما عطفت لهم % سريعة إبشار اللقاح درور % 13(@)(@@) % و جدنا بني نبهان أذناب طئ % وللناس أذناب ترى وصدور % 14(@)(@@) % ترى شرط المعزي مهور نسائهم % و في قزم المعزي لهن مهور % % 15(@)(@@) % إذا حل من نبهان أذناب ثلة ، % بأوشال سلمى دقة وفجور % % 18(@)(@@) % وأعور من نبهان ، أما نهاره % فأعمى ، وأما ليله فبصير % PageV01P255 البحر : طويل 1(@)(@@) % فورس قيس يمنعون حماهمأزرت ديار الحي أم لا تزورها ؟ % و أني من الحي الجماد فدورها % % 2(@)(@@) % وما تنفع الدار المحيلة ذا الهوى ، % إذا استن أعرافا علا الدار مورها % % 3(@)(@@) % كأن ديار الحي من قدم البلى % قراطيس رهبان أحالت سطورها % % 4(@)(@@) % كما ضربت في معصم حارثية % يمانية بالوشم باق نؤورها % % 5(@)(@@) % تفوت الرماة الوحش وهي غريرة % و تخشى نوار الوحش ما لا يضيرها % % 6(@)(@@) % لئن زل يوما بالفرزدق حلمه % وكان لقيس حاسدا لا يضيرها % % 7(@)(@@) % من الحين سقت الخور خور مجاشع % إلى حرب قيس وهي حام سعيرها % % 8(@)(@@) % كأنك يا بن القين واهب سيفه % لأعدائه والحرب تغلي قدورها % % 9(@)(@@) % فلا تأمنن الحي قيسا فانهم % بنو محصنات لم تدنس حجورها % % 10(@)(@@) % ميامين خطارون يحمون نسوة ؛ % مناجيب تغلو في قريش مهورها % % PageV01P256 11(@)(@@) % الا إنما قيس نجوم مضيئة % يشق دجى الظلماء بالليل نورها % % 12(@)(@@) % تعد لقيس من قديم فعالهم % بيوت أواسيها طوال وسورها % % 13(@)(@@) % فوارس قيس يمنعون حماهم % و فيهم جبال العز صعب وعورها % % 14(@)(@@) % و قيس هم قيس الأعنة والقنا % % و قيس حماة الخيل تدمى نحورها % % 15(@)(@@) % سليم وذبيان وعبس وعامر % حصون إلى عز طوال عمورها % % 16(@)(@@) % ألم تر قيسا لا يرام لها حمى ، % ويقضي بسلطان عليك أميرها % % 17(@)(@@) % ملوك وأخوال الملوك وفيهم % غيوث 
ms72	 الحيا يحي البلاد مطيرها % % 19(@)(@@) % فإن جبال العز من آل خندف ، % لقيس ، فقد عزت وعز نصيرها % % 20(@)(@@) % ألم تر قيسا حين خارت مجاشع % تجير ولا تلقي قبيلا يجيرها % % 21(@)(@@) % بني دارم من رد خيلا مغيرة ، % غداة الصفا ، لم ينج إلا عشورها % % PageV01P257 22(@)(@@) % و ردتم على قيس بخور مجاشع % فبؤتم على ساق بطيء جبورها % % 23(@)(@@) % كأنهم بالشعب مالت عليهم % نضاد ، فأجبال الستور ، فنيرها % % 24(@)(@@) % لقد نذرت جدع الفرزدق جعفر % إذا حزأنف القين حلت نذورها % % 25(@)(@@) % ذوو الحجرات الشم من آل جعفر % يسلم جانيها ويعطى فقيرها % % 26(@)(@@) % حياتهم عز ، وتبنى لجعفر ، % إذا ذكرت مجد الحياة ، قبورها % % 27(@)(@@) % وعردتم عن جعفر يوم معبد ، % فأسلم والقلحاء عان أسيرها % % 28(@)(@@) % أتنسون يومي رحرحان وأمكم % % جنيبة أفراس يخب بعيرها % % 29(@)(@@) % و تذكر ما بين الضباب وجعفر % و تنسون قتلى لم تقتل ثؤورها % % 30(@)(@@) % لقد أكرهت زرق الأسنة فيكم % ضحى ، سمهريات قليل فطورها % % 31(@)(@@) % فقال غناء عنك في حرب جعفر % تغنيك زراعاتها وقصورها % % PageV01P258 32(@)(@@) % إذا لم يكن إلا قيون مجاشع % حماة عن الأحساب ضاعت ثغورها % % 33(@)(@@) % ألم تر أن الله أخزى مجاشعا % إذا ذكرت بعد البلاء أمورها % % 34(@)(@@) % بأنهم لا محرم يتقونه ، % وأن لا يفي يوما لجار مجيرها % % 35(@)(@@) % لقد بينت يوما بيوت مجاشع % على الخبث حتى قد أصلت قعورها % % 36(@)(@@) % فكم فيهم من سوأة ذات أفرخ % تعد وأخرى قد أتمت شهورها % % 38(@)(@@) % بنو نخبات لا يفون بذمة % ولا جارة فيهم تهاب ستورها % % 40(@)(@@) % وخبث حوض الخور خور مجاشع % رواح المخازي نحوها وبكورها % % 41(@)(@@) % أفخرا إذا رابت وطاب مجاشع % و جاءت بتمر من حوارين عيرها % % 42(@)(@@) % بنو عشر لا نبع فيه وخروع % و زنداهم أثل تناوح خورها % % 43(@)(@@) % و يكفي خزير المرجلين مجاشعا % إذا ما السرايا حس ركضا مغيرها % % PageV01P259 44(@)(@@) % لقد علم الأقوام أن مجاشعا % إذا عرفت بالخزى قل نكيرها % % 45(@)(@@) % و لا يعصم الجيران عقد مجاشع % إذا الحرب لم يرجع بصلح سفيرها % % 49(@)(@@) % وفقأ عيني غالب عند كيره % نوازي شرار القين حين يطيرها % % 50(@)(@@) % وداويت من 
ms73	 عر الفرزدق نقبة % بنفط فأمست لا يخاف نشورها % % 51(@)(@@) % و أنهلته بالسم ثم عللته % بكأس من الذيفان مر عصيرها % % 52(@)(@@) % و أب إلى الأقيان ألأم وافد % إذا حل عن ظهر النجيبة كورها % % 53(@)(@@) % أيوما لماخور الفرزدق خزية ، % و يوما زواني بابل وخمورها % % 54(@)(@@) % إذا ما شربت البابلية لم تبل % حياء ولا يسقي عفيفا عصيرها % % 56(@)(@@) % وما زلت يا عقدان باني سوأة ، % تناجي بها نفسا لئيما ضميرها % % 57(@)(@@) % رأيتك لم تعقد حفاظا ولا حجى % و لكن مواخيرا تؤدي أجورها % % PageV01P260 58(@)(@@) % أثرت عليك المخزيات ولم يكن % ليعدم جاني سوأة من يثيرها % % 59(@)(@@) % لقيت شجاعا لم تلده مجاشع % وأخوف حيات الجبال ذكورها % % 60(@)(@@) % و تمدح سعدا لا عليت ومنقرا % لدى حومل السيدان يحبو عقيرها % % 61(@)(@@) % ودرت على عاسي العروق ولم يكن % ليسقي أفواه العروق درورها % % 62(@)(@@) % دعت أمك العمياء ليلة منقر % ثبورا ، لقد زلت وطال ثبورها % % 63(@)(@@) % أشاعت بنجد للفرزدق خزية % وغارت جبال الغور في من يغورها % % 64(@)(@@) % لعمرك ما تنسى فتاة مجاشع ، % ولا ذمة غر الزبير غرورها % % 65(@)(@@) % يلجج أصحاب السفين بغدركم ، % وخوص على مران تجري ضفورها % % 66(@)(@@) % تراغيتم يوم الزبير ، كأنكم % ضباع أصلت في مغار جعورها % % 67(@)(@@) % ولو كنت منا ما تقسم جاركم % سباع وطير لم تجد من يطيرها % % PageV01P261 68(@)(@@) % ولو نحن عاقدنا الزبير لقيته % مكان أنوق ما تنال وكورها % % 69(@)(@@) % تدافع قدما عن تميم فوارسي % % إذا الحرب أبدى حد ناب هريرها % % 70(@)(@@) % فمن مبلغ عن تميما رسالة % علانية والنفس نصح ضميرها % % 71(@)(@@) % عطفت عليكم ود قيس فلم يكن % لهم بدل أقيان ليلى وكيرها % % PageV01P262 البحر : طويل 1(@)(@@) % لقد سرني أن لا تعد مجاشع % من الفخر إلا عقر ناب بصوأر % 2(@)(@@) % أنابك أم قوم تفض سيوفهم % على الهام ثنيي بيضة المتجبر % 3(@)(@@) % لعمري لنعم المستجارون نهشل % وحي القرى للطارق المتنور % 4(@)(@@) % فوارس لا يدعون يال مجاشع % إذا برزت ذات العريش المخدر % 7(@)(@@) % لعمري لقد أردى هلال بن عامر % بتهنية المرباع رهط المجشر % 8(@)(@@) % وما زلت مذ لم تستجب لك نهشل % تلاقي صراحيا 
ms74	 من الذل ، فاصبر % 9(@)(@@) % وعافت بنو شيبان حوض مجاشع % و شيبان أهل الصفو غير المكدر % 10(@)(@@) % و لو غضبت في شأن حدراء نهشل % سموها بدهم أو غزوها بأنسر % 12(@)(@@) % و لو في رياح حل جار مجاشع % لما بات رهنا للقليب المغور % 13(@)(@@) % و ما غرهم من ثأرهم عقد المنى % % و لا عقد إلا عقد جار مشمر % PageV01P263 14(@)(@@) % % و نعصى بها في كل يوم مشهر % 15(@)(@@) % وقد سرني ألا تعد مجاشع ، % من المجد ، إلا عقر ناب بصوأر % 16(@)(@@) % وأنتم قيون تصلقون سيوفنا ، % و نعصى بها في كل يوم مشهر % 17(@)(@@) % فوارس كراون في حومة الوغا % % إذا خرجت ذات العريش المخدر % PageV01P264 البحر : بسيط تام 1(@)(@@) % لجت أمامة في لومي وما علمت % عرض السماوة روحاتي ولا بكرى % % 2(@)(@@) % ولا تقعقع ألحي العيس قاربة ، % بين المراج ورعنى ، رجلتي بقر % 3(@)(@@) % ما هوم القوم مذ شدوا رحالهم % إلا غشاشا لدى أعضادها اليسر % 4(@)(@@) % يضرحن ضرحا حصى المعزاء إذا وقدت % شمس النهار وعاد الظل للقصر % 5(@)(@@) % يوما يصادي المهارى الخوص تحسبها % % عور العيون وما فيهن من عور % 6(@)(@@) % قد طال قولي إذا ما قمت مبتهلا : % يا رب أصلح قوام الذين والبشر % 7(@)(@@) % خليفة الله ثم الله يحفظه ، % و الله يصحبك الرحمن في السفر % 8(@)(@@) % إنا لنرجو ، إذا ما الغيث أخلفنا ، % من الخليفة ما نرجو من المطر % 9(@)(@@) % يا رب سجل مغيث قد نفحت به % من نائل غير منزوح ولا كدر % 10(@)(@@) % أأذكر الجهد والبلوى التي نزلت % أم كفاني الذي بلغت من خبري % % PageV01P265 11(@)(@@) % ما زلت بعدك في دار تعرقني % % قد عي بالحي إصعادي ومنحدري % % 12(@)(@@) % لا ينفع الحاضر المجهود باديه % و لا يعود لنا باد على حضر % 13(@)(@@) % كم بالمواسم من شعئاء أرملة % ومن يتيم ضعيف الصوت والنظر % 14(@)(@@) % يدعوك دعوة ملهوف كأن به % خبلا من الجن أوخبلا من النشر % 15(@)(@@) % ممن يعدك تكفي فقد والده % كالفرخ في العش لم يدرج ولم يطر % 16(@)(@@) % يرجوك مثل رجاء الغيث تجرهم % بوركت جابر عظم هيض منكسر % 17(@)(@@) % فان 
ms75	 تدعهم فمن يرجون بعدكم % أو تنج منها فقد أنجيت من ضرر % 18(@)(@@) % خليفة الله ماذا تنظرون بنا ؟ % لسنا إليكم ولا في دار منتظر % 19(@)(@@) % أنت المبارك و المهدي سيرته ، % تعصي الهوى وتقوم الليل بالسور % 20(@)(@@) % أصبحت للمنبر المعمور مجلسه % زينا وزين قباب الملك والحجر % PageV01P266 21(@)(@@) % نال الخلافة إذ كانت له قدرا % كما أتى ربه موسى على قدر % 22(@)(@@) % فلن تزال لهذا الدين ما عمروا ، % منكم عمارة ملك واضح الغرر % 23(@)(@@) % هم ما هم القوم ما ساروا وما نزلوا % % إلا يسوسون ملكا عالي الخطر % % 24(@)(@@) % ما صاح من حية ينمي إلى جبل % إلا صدعت صفاة الحية الذكر % 25(@)(@@) % أخوالك الشم من قيس إذ افزعوا % % لا يعصون حذار الموت بالعذر % 26(@)(@@) % كم قد دعوتك من دعوى مخللة % لما رأيت زمان الناس في دبر % 27(@)(@@) % لتنعش اليوم ريشي ثم تنهضني % % و تنزل اليسر مني موضع العسر % 28(@)(@@) % فما وجدت لكم ندا يعادلكم ؛ % و ما علمت لكم في الناس من خطر % % 29(@)(@@) % إني سأشكر ما أوليت من حسن % وخير من نلت معروفا ذوو الشكر % % PageV01P267 البحر : كامل تام 1(@)(@@) % لله در عصابة نجدية ، % تركوا سوادة خلفهم ومرارا % % 2(@)(@@) % أنعى أخاك وفارسا ذا نجدة ، % حمسا إذا امتلأ الفجاج غبارا % % PageV01P268 البحر : طويل 1(@)(@@) % أدار الجميع الصالحين بذي السدر ، % أبيني لنا ، إن التحية عن عفر % 2(@)(@@) % لقد طرقت عيني في الدار دمنة % تعاورها الأزمان والريح بالقطر % 3(@)(@@) % فقلت لأدنى صاحبي وإنني % % لأكتم وجدا في الجوانح كالجمر : % 4(@)(@@) % لعمركما لا تعجلا ! إن موقفا % على الدار فيه القتل أو راحة الدهر % 5(@)(@@) % فعاجا وما في الدار عين نحسها % % سوى الربد والظلمان ترعى مع العفر % 6(@)(@@) % فلله ماذا هيجت من صبابة % على هالك يهذي بهند وما يدري % % 7(@)(@@) % طوى حزنا في القلب حتى كأنما % % به نفث سحر أو أشد من السحر % 8(@)(@@) % أخالد ! كان الصرم بيني وبينكم % % دلالا فقد أجرى البعاد إلى الهجر % 9(@)(@@) % جزيت ألا تجزين وجدا يشفنني % % و إني لا أنساك إلا على ذكر % 10(@)(@@) % خليلي ماذا تأمراني بحاجة 
ms76	 % ولولا الحياء قد أشاد بها صدري % % PageV01P269 11(@)(@@) % أقيما ، فإن اليوم يوم جرت لنا % % أيامن طير لا نحوس ولا عسر % 12(@)(@@) % فان بخلت هند عليك فعلها % % وإن هي جادت كان صدعا على وقر % 13(@)(@@) % من البيض أطرافا كأن بنانها % % منابت ثداء من الأجرع المثري % % 14(@)(@@) % لقد طال لوم العاذلين وشفني % % تناء طويل واختلاف من النجر % 15(@)(@@) % أثعلب أولى حلفة ما ذكرتكم % بسوء ولكني عتبت على بكر % 16(@)(@@) % فلا توبسوا بيني وبينكم الثرى % % فان الذي بيني وبينكم مثرى % % 17(@)(@@) % عظام المقاري في السنين وجاركم % يبيت من اللاتي تخاف لدى وكر % 18(@)(@@) % أثعلب إني لم أزل مذ عرفتكم % أرى لكم سترا فلا تهتكوا ستري % % 19(@)(@@) % فلولا ذوو الأحلام عمرو بن عامر % رميت بني بكر بقاصمة الظهر % 20(@)(@@) % هم يمنعون السرح لا يمنعونه % من الجيش أن يزداد نفرا على نفر % PageV01P270 21(@)(@@) % جزى الله يربوعا من السيد قرضها % % 22(@)(@@) % بني السيد آويناكم قد علمتم % إلينا وقد لج الظعائن في نفر % 23(@)(@@) % مننا عليكم لو شكرتم بلاءنا % % و قد حملتكم حرب ذهل على قتر % % 24(@)(@@) % بني السيد لا يمحي ترمز مدرك % ندوب القوافي في جلودكم الخضر % 25(@)(@@) % بأي بلاء تحمدون مجاشعا % غباغب أثوار تلظى على جسر % 26(@)(@@) % ألا تعرفون النافشين لحاهم % إذا بطنوا والفاخرين بلا فخر % 27(@)(@@) % أنا البدر يعشى طرف عينيك ضوؤه % % ومن يجعل القرد المسرول كالبدر % 28(@)(@@) % حمتني ليربوع جبال حصينة % ويزخر دوني قمقمان من البحر % 29(@)(@@) % فضل ضلال العادلين مجاشعا ، % ثلوط الروايا بالحماة عن الثغر % 30(@)(@@) % فما شهدت يوم الغبيط مجاشع % و لا نقلان الخيل من قلتي يسر % % PageV01P271 31(@)(@@) % و لا شهدتنا يوم جيش محرق % طهية فرسان الوقيدية الشقر % % 32(@)(@@) % و لا شهدت يوم النقاخيل هاجر % و لا السيد إذ ينحطن في الأسل الحمر % % 33(@)(@@) % ونحن سلبنا الجون وابني محرق % وعمرا وقتلنا ملوك بني نصر % 34(@)(@@) % إذا نحن جردنا عليهم سيوفنا % % أقمنا بها درء الجبابرة الصعر % 35(@)(@@) % إذا ما رجا روح الفرزدق راحة % تغمده آذي ذي حدب غمر % 36(@)(@@) % فطاشت يد القين الدعي 
ms77	 وغمه % ذرى واسقات يرتمين من البحر % 37(@)(@@) % لعلك ترجو أن تنفس بعدما % % غممت كما غم المعذب في القبر % % 38(@)(@@) % فما أحصنته بالسعود لمالك % ولا ولدته أمه ليلة القدر % 39(@)(@@) % فلا تحسبن الحرب لما تشنعت % مفايشة إن الفياش بكم مزرى % % 40(@)(@@) % أبعد بني بدر وأسلاب جاركم % % رضيتم واحتبيتم على وتر % PageV01P272 41(@)(@@) % ونبئت جوابا وسكنا يسبني ، % و عمرو بن عفري لا سلام على عمرو % % PageV01P273 البحر : وافر تام 1(@)(@@) % ألا حي الديار بسعد إني % أحب لحب فاطمة الديارا % % 2(@)(@@) % أراد الظاعنون ليحزنوني ، % فهاجوا صدع قلبي فاستطارا % % 3(@)(@@) % لقد فاضت دموعك يوم قو % لبين كان حاجته ادكارا % % 4(@)(@@) % أبيت الليل أرقب كل نجم % تعرض حيث أنجد ثم غارا % % 5(@)(@@) % يحن فؤاده والعين تلقى % % من العبرات جولا وانحدارا % % 6(@)(@@) % إذا ما حل أهلك يا سليمى % % بدارة صلصل شحطوا المزارا % % 7(@)(@@) % فيدعونا الفؤاد إلى هواها % % و يكره أهل جهمة أن تزارا % % 8(@)(@@) % كأن مجاشعا نخبات نيب % هبطن الهرم أسفل من سرارا % % 9(@)(@@) % إذا حلوا زرود بنوا عليها % % بيوت الذل والعمد القصارا % % 10(@)(@@) % تسيل عليهم شعب المخازي % % و قد كانوا لنسوأتها قرارا % % PageV01P274 11(@)(@@) % وهل كان الفرزدق غير قرد % أصابته الصواعق فاستدارا % % 12(@)(@@) % و كنت إذا حللت بدار قوم % رحلت بخزية وتركت عارا % % 18(@)(@@) % تزوجتم نوار ولم تريدوا % % ليدرك ثائر بأبي نوارا % % 19(@)(@@) % فديتك يا فرزدق دين ليلى % % نزور القين حجا واعتمارا % % 20(@)(@@) % فظل القين بعد نكاح ليلى % % يطير على سبالكم الشرارا % % 23(@)(@@) % مريتم حربنا لكم فدرت % بذي علق فأبطأت الغرار % % 24(@)(@@) % ألم أك قد نهيت على حفير % بني قرط وعلجهم شقارا % % 25(@)(@@) % سأرهن يا بن حادجة الروايا % % لكم مد الأعنة والحضارا % % 26(@)(@@) % يرى المتعبدون علي ، دوني ، % حياض الموت واللجج الغمارا % % 27(@)(@@) % ألسنا نحن قد علمت معد % غداة الروع أجدر أن نغارا % % PageV01P275 28(@)(@@) % و أضرب بالسيوف إذا تلاقت % هوادي الخيل صادية حرارا % % 29(@)(@@) % و أطعن حين تختلف العوالي % % بمأزول إذا ما النقع ثارا % % 30(@)(@@) % و أحمد في القرى وأعز نصرا % و أمنع جانبا وأعز جارا % % 31(@)(@@) % غضبنا يوم 
ms78	 طخفة قد علمتم % فصفدنا الملوك بها اعتسارا % % 32(@)(@@) % فوارسنا عتيبة وابن سعد % و فؤاد المقانب حيث سارا % % 33(@)(@@) % و منا المعقلان وعبد قيس % و فارسنا الذي منع الذمارا % % 34(@)(@@) % فما ترجو النجوم بنو عقال % و لا القمر المنير إذا استنارا % % 35(@)(@@) % و نحن الموقدون بكل ثغر % يخاف به العدو عليك نارا % % 36(@)(@@) % أتنسون الزبير ورهن عوف % و عوفا حين عزكم فجارا % % PageV01P276 البحر : بسيط تام 1(@)(@@) % هاج الهوى وضمير الحاجة الذكر % واستعجم اليوم من سلومة الخبر % 2(@)(@@) % علقت جنية ضنت بنائلها % % من نسوة زانهن الدل والخفر % 3(@)(@@) % قد كنت أحسب في تيم مصانعة % و فيهم عاقلا بعد الذي ائتمروا % % 5(@)(@@) % هلا أدرأتم سوانا يا بني لجأ % % أمرا يقارب أو وحشا لهاغرر % % 6(@)(@@) % أو تطلبون بتيم ، لا أبا لكم % من تبلغ التيم ؟ أو تيم له خطر % 7(@)(@@) % ترجو الهوادة تيم بعدما وقعت % صماء ليس لها سمع ولا بصر % 8(@)(@@) % قد كانت التيم ممن قد نصبت له % بالمنجنق وكلادقه الحجر % 9(@)(@@) % ذاقوا كما ذاق من قد كان قبلهم % واستعقبوا عثرة الأقيان إذ عثروا % % 10(@)(@@) % قد كان لو وعظت تيم يغيرهم % في ذي الصليب وقيني مالك عبر % 11(@)(@@) % خل الطريق لمن يبني المنار به % وابرز ببرزة حيث اضطرك القدر % PageV01P277 12(@)(@@) % يوم التفاخر ، والغايات تبتدر % ذيخ المريرة حتى استحصد المرر % % 13(@)(@@) % قد حان قبلك أقوام فقلت لهم % جد النضال وقلت بيننا العذر % 14(@)(@@) % لن تستطيع بتيم أن تغاليني % % حين استحن جذاب النبعة الوتر % % 16(@)(@@) % ما التيم إلا ذباب لا جناح له ، % قد كان من عليهم مرة نمر % 17(@)(@@) % أزمان يغشى دخان الذل أعينهم % لا يستعانون في قوم إذا ذكروا % % 18(@)(@@) % و التيم عبد لأقوام يلوذ بهم % يعطى المقادة إن أوفوا أو إن غدروا % % 19(@)(@@) % أتبغي التيم عذرا بعد ما عدروا % % لولا قبائل من زيد تلوذ بها ، % 20(@)(@@) % لا تمنعون لكم عرسا وما لكم % إلا بغيركم ورد ولا صدر % 21(@)(@@) % يا تيم تيم عدي لا أبا لكم % % لا يوقعنكم في سوأة عمر % 22(@)(@@) % يا تيم إن 
ms79	 جسيم الأمر ليس لكم % ولا الجراثيم عند الدعوة الكبر % PageV01P278 23(@)(@@) % و التيم كان سطحيا ثم قيل لهم % شأن السطيح إلى تخبيله العور % 24(@)(@@) % إن الكرام إذا من زيد تلوذ بها % % كانت عصاك التي تلحى وتقتشر % 25(@)(@@) % جاءت فوارسنا غرا محجلة % إذ ليس في التيم تحجيل ولا غرر % 26(@)(@@) % جئنا بكم من زهيرات ومن سبأ % % وللجوامع في أعناقكم أثر % 27(@)(@@) % في جلهم اللؤم معلوما معادنه % وفي حويزة خبث الريح والأدر % 28(@)(@@) % قولو لتيم : أعصب فوق آنفهم % إذيرأمون التي من مثلها نفروا % % 29(@)(@@) % قد خفت يا بن التي ماتت منافقة % من خبث برزة أن لا ينزل المطر % % 30(@)(@@) % أنت ابن برزة منسوبا إلى لجإ % % عبد العصارة والعيدان تعتصر % 31(@)(@@) % أخزيت تيما وما تحمى محارمها % % إذ أنت نفاخة للقين مؤتجر % 32(@)(@@) % ما بال برزة في المنحاة إذ نذرت % صوم المحرم إن لم يطلع القمر % PageV01P279 34(@)(@@) % وصت بنيها وقالت : دون أكبركم % % فادوا أباكم فإن التيم قد كفروا % % 36(@)(@@) % إني لمهد لكم غرا مقشبة ، % فيها السمام وأخرى بعد تنتظر % 37(@)(@@) % إن الحفافيث حقا يا بني لجأ % يطرقن حين يسور الحية الذكر % 38(@)(@@) % لولا عدي ولستم شاكرين لهم % لم تدر تيم بأي القنة الحفر % % 39(@)(@@) % يا رب نعشنا بعد عثرتهم % كنا لهم كسقيف العظم فاجتبروا % % 40(@)(@@) % ذدنا العدو ، وأدنينا محلهم ، % حتى ابتنوا بقباب بعدما احتجروا % % 41(@)(@@) % يوما نشد وراء السبي عادية % شعث النواصي ، ويوما تطرد البقر % 42(@)(@@) % قد يعلم الناس أن التيم ألأمهم % أأخبر الناس ولا يوما إذا افتخروا % % 43(@)(@@) % أوصى تميم يوما أن يكون لهم % سؤر العشي وشرب التابع الكدر % 44(@)(@@) % يا تيم ! خالط مكحول أبا لجإ % % ذا نقبة قد بدا في لونه عرر % PageV01P280 45(@)(@@) % أنا ابن فرعي بني زيد إذا نسبوا % % هل ينكر المصطفى أو ينكر القمر % 46(@)(@@) % واللؤم حالف تيما في ديارهم % واللؤم صير في تيم إذا حضروا % % 47(@)(@@) % اقبض يديك فان التيم قد سبقوا % % يوم التفاخر والغانيات تبتدر % 48(@)(@@) % إن تصبر التيم مخضرا جلودهم % على الهوان فقبل اليوم ما صبروا % % 50(@)(@@) % إن 
ms80	 الذين أضاءوا النار قد عرفوا % % آثار برزة والآثار تفتقر % 51(@)(@@) % قالت لتيم بن قنب وهي تعذلهم : % يا تيم ما لكم البشرى ولا الظفر % 52(@)(@@) % تخزيك أحياء تيم إن فخرت بهم % والحزي أموات تيم إن هم نشروا % % 53(@)(@@) % أعياك والدك الأدنون فالتمسن % هل في شعاعة ذي الأهدام مفتخر % 54(@)(@@) % لا يشهدون نجي القوم بينهم % تقضى الأمور على تيم وما شعروا % % PageV01P281 البحر : كامل تام 1(@)(@@) % صرم الخليط تباينا وبكورا % % وحسبت بينهم عليك يسيرا % % 2(@)(@@) % عرض الهوى وتبلغت حاجاته % منك الضمير فلم يدعن ضميرا % 3(@)(@@) % إن الغواني قد رمين فؤاده % حتى تركن بسمعه توقيرا % % 4(@)(@@) % بيض ترببها النعيم وخالطت % عيشا كحاشية الفرند غريرا % % 5(@)(@@) % أنكرن عهدك بعد ما يعرفنه % ولقد يكن إلى حديثك صورا % % 6(@)(@@) % ورأين ثوب بشاشة أنضيته % فجمعن عنك تجنبا ونفورا % % 7(@)(@@) % ليت الشباب لنا يعود كعهده % فلقد تكون بشرخه مسرورا % % 8(@)(@@) % و بكيت ليلك لا تنام لطوله % ليل التمام وقد يكون قصيرا % 9(@)(@@) % هل ترجوان لما أحاول راحة % أم تطمعان لما أتى تفتيرا % % 10(@)(@@) % قالت جعادة ما لجسمك شاحبا % ولقد يكون على الشباب نضيرا % % PageV01P282 11(@)(@@) % أجعاد : إني لا يزال ينوبني % % هم يروح موهنا وبكورا % % 12(@)(@@) % حتى بليت وما علمت بهمنا % % و رأيت أفضل نفعك التغييرا % % 13(@)(@@) % هلا عجبت من الزمان وريبه % % والدهر يحدث في الأمورر أمورا % % 14(@)(@@) % قال العواذل : ما لجهلك بعدما % % شاب المفارق واكتسين قتيرا % % 15(@)(@@) % حييت زورك إذ ألم ولم تكن % هند لقاصية البيوت زؤورا % % 16(@)(@@) % طرقت نواحل قد أضر بها السرى % % نزحت بأذرعها تنائف زورا % % 17(@)(@@) % مشق الهواجر لحمهن مع السرى % % حتى ذهبن كلا كلا وصدورا % % 18(@)(@@) % من كل جرشعة الهوا زادها % % بعد المفاوز جرأة وضريرا % % 19(@)(@@) % قرعت أخشتها العظام فأخرجت % منها عجارف جمة وبكيرا % % 20(@)(@@) % نفضت بأصهب للمراح شليلها % % نفض النعامة زفها الممطورا % % PageV01P283 21(@)(@@) % يا صاحبي دنا الرواح فسيرا ، % لا كالعشية زائرا ومزورا % % 22(@)(@@) % وجد الأخيطل حين شمصه القنا % % حطما إذا اعتزم الجياد عثورا % % 23(@)(@@) % وعوى الفرزدق للأخيطل محلبا % فتنازعا مرسى القوى مشزورا % % 24(@)(@@) % ما قاد 