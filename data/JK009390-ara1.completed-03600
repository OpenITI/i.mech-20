ms3581	 النبي : ( من أعتق مؤمنا في الدنيا أعتق الله بكل عضو منه عضوا منه من النار ) )(@)(@@) . ( طك ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3731 / 32756(@)(@@) | 30 قال النبي : ( من أعتق شقصا من رقيق فإن عليه أن يعتق بقيته ، فإن لم يكن له مال استسعاى العبد في ثمنه ) )(@)(@@) . ( طس ، عن جابر رضي الله عنه ) .(@)(@@) PageV11P176(@)(@@)(@@)(@@) $ 3732 / 32757(@)(@@) | 30 قال النبي : ( من أعطاى أربعا أعطي أربعا ، وتفسير ذالك في كتاب الله تعالاى : من أعطاى الذكر أعطي الذكر لأن الله عز وجل يقول : { اذكروني أذكركم } ( 1 ) ومن أعطاى الدعاء أعطي الإجابة لأن الله تعالاى يقول : { ادعوني أستجب لكم } ( 1 ) ، ومن أعطاى الشكر أعطي الزيادة لأن الله تعالاى يقول : { لئن شكرتم لاءزيدنكم } ( 1 ) ، ومن أعطاى الاستغفار أعطي المغفرة ، لأن الله تعالاى يقول : { استغفروا ربكم إنه كان غفارا ( 1 ) } ) )(@)(@@) . ( طكسص ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3733 / 32758(@)(@@) | 30 قال النبي : ( من أعتق نصيبا من مملوك ضمن لهم نصيبهم من ماله ) )(@)(@@) . ( بز ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3734 / 32759(@)(@@) | 30 قال النبي : ( من اغبرت قدماه في سبيل الله حرم الله سائر جسده علاى النار ) )(@)(@@) . ( طس ، عن عمرو بن قيس الكندي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3735 / 32760(@)(@@) | 30 قال النبي : ( من اغتسل يوم الجمعة ، ثم مس من أطيب طيب عنده ، ولبس من أحسن ثيابه ثم راح ولم يفرق بين اثنين حتى يقوم من مقامه ، ثم أنصت حتى يفرغ الإمام من خطبته غفر له ما بين الخطبتين وزيادة ثلاثة أيام ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3736 / 32761(@)(@@) | 30 قال النبي : ( من اغتسل يوم الجمعة كان في طهارة إلاى الجمعة الأخراى ) )(@)(@@) . ( طس ، عن عبد الله بن أبي قتادة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3737 / 32762(@)(@@) | 30 قال النبي : ( من اغتسل يوم الجمعة كان في طهارة ) )(@)(@@) . ( ع ، عن أبي قتادة رضي الله عنه ) .(@)(@@) PageV11P177(@)(@@)(@@)(@@) $ 3738 / 32763(@)(@@) | 30 قال النبي : ( من اغتسل يوم الجمعة ومس من طيب إن كان عنده ، ولبس من أحسن ثيابه ، ثم خرج حتى يأتي المسجد فيركع إن بدا له 
ms3582	 ، ولم يؤذ أحدا ، ثم أنصت حتى يصلي كانت كفارة لما بينها وبين الجمعة الأخراى ) )(@)(@@) . ( حم ، طك ، عن أبي أيوب الأنصاري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3739 / 32764(@)(@@) | 30 قال النبي : ( من أفضاى بيده إلاى ذكره وليس دونه شيء وجب عليه الوضوء ) )(@)(@@) . ( حم ، طص ، بز ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3740 / 32765(@)(@@) | 30 قال النبي : ( من اقتصد أغناه الله ، ومن بذر أفقره الله ، ومن تواضع رفعه الله ، ومن تجبر قصمه الله ) )(@)(@@) . ( بز ، عن طلحة بن عبيد الله رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3741 / 32766(@)(@@) | 30 قال النبي : ( من اقتطع مال امرىء بيمينه حرم الله عليه الجنة وأوجب له النار ، قيل : وإن شيئا يسيرا ؟ قال : وإن كان سواكا ) )(@)(@@) . ( طك ، عن جابر بن عتيك ) .(@)(@@)(@@)(@@) $ 3742 / 32767(@)(@@) | 30 قال النبي : ( من أكل أو شرب ناسيا في رمضان فلا قضاء عليه ولا كفارة ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3743 / 32768(@)(@@) | 30 قال النبي : ( من أكل من هاتين الشجرتين : الثوم والبصل ، فلا يقربن مصلانا ، وليأتني أمسح وجهه وأعوذه ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3744 / 32769(@)(@@) | 30 قال النبي : ( من أكل من هاذه الشجرة الخبيثة فلا يقربن مسجدنا يعني الثوم ) )(@)(@@) . ( طك ، عن العلاء بن خباب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3745 / 32770(@)(@@) | 30 قال النبي : ( من أكل من لحم أخيه في الدنيا قرب إليه يوم القيامة فيقال له : كله حيا كما أكلته ميتا فيأكله ويكلح ويصيح ) )(@)(@@) . ( طك ، عن أبي هريرة رضي الله عنه وفيه ابن إسحاق مدلس ) .(@)(@@) PageV11P178(@)(@@)(@@)(@@) $ 3746 / 32771(@)(@@) | 30 قال النبي : ( من أكل من هاذه البقلة المنكرة يعني الثوم فليجلس في بيته ) )(@)(@@) . ( بز ، عن جابر بن سمرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3747 / 32772(@)(@@) | 30 قال النبي : ( من أكل من هاذه الشجرة فلا يقربن مسجدنا يعني الثوم والبصل ) )(@)(@@) . ( طكس ، عن عبد الله بن زيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3748 / 32773(@)(@@) | 30 قال النبي : ( من أكل من هاذه الخضراوات : البصل ، والثوم ، والكراث ، والفجل ، فلا يقربن مسجدنا ، فإن الملائكة تتأذى كما يتأذى منه بنو آدم ) )(@)(@@) . ( طص ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3749 / 32774 
ms3583	(@)(@@) | 30 قال النبي : ( من أكل من خضركم هاذه شيئا فلا يقربن مسجدنا ، فإن الملائكة تتأذى مما يتأذى منه بنو آدم ) )(@)(@@) . ( طك ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3750 / 32775(@)(@@) | 30 قال النبي : ( من أكل من هاذه البقلة الخبيثة فلا يقربنا ) )(@)(@@) . ( حم ، طك ، عن أبي ثعلبة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3751 / 32776(@)(@@) | 30 قال النبي : ( من أكل سبع تمرات عجوة ما بين لابتي المدينة علاى الريق لم يضره يومه ذالك شيء حتى يمسي ، وإن أكلها حين يمسي لم يضره شيء حتى يصبح ) )(@)(@@) . ( حم ، عن عامر بن سعد عن أبيه ) .(@)(@@)(@@)(@@) $ 3752 / 32777(@)(@@) | 30 قال النبي : ( من أكل سبع تمرات من تمر العالية حين يصبح لم يضره سم ولا سحر ) )(@)(@@) . ( طص ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3753 / 32778(@)(@@) | 30 قال النبي : ( من أكل سبع تمرات من عجوة المدينة لم يضره السم ذالك اليوم وأكلهن لبلاء لم يضره السم ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها ) .(@)(@@) PageV11P179(@)(@@)(@@)(@@) $ 3754 / 32779(@)(@@) | 30 قال النبي : ( من أكل منكم يوم عاشوراء فلا يأكل بقية يومه ، ومن لم يأكل فليتم صومه ) )(@)(@@) . ( حم ، طك ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3755 / 32780(@)(@@) | 30 قال النبي : ( من لقط لقطة يسيرة : درهما أو حبلا أو أشبه ذالك فليعرفه ثلاثة أيام ، فإن كان فوق ذالك فليعرفه ستة أيام ) )(@)(@@) . ( حم ، عن يعلاى بن مرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3756 / 32781(@)(@@) | 30 قال النبي : ( من التقط لقطة يسيرة أو أسهم فليعرفه ثلاثة أيام ، ومن التقط أكثر فليعرفه ستة أيام ، فإن جاء صاحبها وإلا فليتصدق بها ، فإن جاء صاحبها فليخير ) )(@)(@@) . ( طك ، عن يعلاى بن مرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3757 / 32782(@)(@@) | 30 قال النبي : ( من أماط أذى عن الطريق كتبت له حسنة ، ومن كتبت له حسنة دخل الجنة ) )(@)(@@) . ( طك ، عن المستنير بن أخضر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3758 / 32783(@)(@@) | 30 قال النبي : ( من أم هاذا البيت من الكسب الحرام شخص في غير طاعة الله ، فإذا أهل ووضع رجله في الغرز أو الركاب أو أتبعت به راحلته قال : لبيك اللهم لبيك ، ناداه مناد 
ms3584	 من السماء : لا لبيك ولا سعديك ، كسبك حرام ، وزادك حرام ، وراحلتك حرام ، فارجع مأزورا غير مأجور ، وابشر بما يسوءك ، وإذا خرج الرجل حاجا بمال حلال ووضع رجله في الركاب ، واستوت به راحلته قال : لبيك اللهم لبيك ، ناداه مناد من السماء : لبيك وسعديك ، قد أجبتك ، راحلتك حلال ، وثيابك حلال ، وزادك حلال ، فارجع مأجورا غير مأزور ، وابشر بما يسرك ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3759 / 32784(@)(@@) | 30 قال النبي : ( من أم قوما فإن أتم فله التمام ، وإن لم يتم فلهم التمام وعليه الإثم ) )(@)(@@) . ( حم ، عن أبي علي المصري رضي الله عنه ) .(@)(@@) PageV11P180(@)(@@)(@@)(@@) $ 3760 / 32785(@)(@@) | 30 قال النبي : ( من أمساى كالا من عمل يده أمساى مغفورا له ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3761 / 32786(@)(@@) | 30 قال النبي : ( من انتظر الصلاتين فهو في صلاة ) )(@)(@@) . ( بز ، عن أبي سلمة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3762 / 32787(@)(@@) | 30 قال النبي : ( من أنظر معسرا أظله الله يوم القيامة ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3763 / 32788(@)(@@) | 30 قال النبي : ( من أنظر معسرا تصدق عليه أظله الله في ظله يوم القيامة ، وكل معروف صدقة ) )(@)(@@) . ( طس ، عن شداد بن أوس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3764 / 32789(@)(@@) | 30 قال النبي : ( من أنظر معسرا فله كل يوم مثليه صدقة ) )(@)(@@) . ( حم ، عن بريدة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3765 / 32790(@)(@@) | 30 قال النبي : ( من أهان لي وليا فقد بارزني بالعداوة ، ابن آدم لم تدرك ما عندي إلا بأداء ما افترضته عليك ، ولا يزال عبدي يتحبب إلي بالنوافل حتى أحبه ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3766 / 32791(@)(@@) | 30 قال النبي : ( من أهداى إليكم فكافئوه ) )(@)(@@) . ( بز ، عن ابن عمر رضي الله عنهما ، وفيه ليث بن أبي سليم ثقة مدلس وبقية رجاله رجال الصحيح ) .(@)(@@)(@@)(@@) $ 3767 / 32792(@)(@@) | 30 قال النبي : ( من أوكأ علاى ذهب أو فضة ولم ينفقها في سبيل الله كان جمرا يوم القيامة يكواى به ) )(@)(@@) . ( حم ، طك ، عن أبي ذر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3768 / 32793(@)(@@) | 30 قال النبي : ( من أولي معروفا فليكافىء به ، فإن 
ms3585	 لم يستطع PageV11P181 فليذكره ، فإذا ذكره فقد شكره ، والمتشبع بما نيل كلابس ثوبي زور ) )(@)(@@) . ( بز ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3769 / 32794(@)(@@) | 30 قال النبي : ( من بات فوق بيت ليس له إجار ( 1 ) فوقع فمات فبرئت منه الذمة ، ومن ركب البحر عند ارتجاجه فقد برئت منه الذمة ) )(@)(@@) . ( حم ، عن أبي عمران الجوني رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3770 / 32795(@)(@@) | 30 قال النبي : ( من بات وفي يده ريح غمر فأصابه شيء فلا يلومن إلا نفسه ) )(@)(@@) . ( بز ، طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3771 / 32796(@)(@@) | 30 قال النبي : ( من بادر العاطس بالحمد عوفي من وجع الخاصرة ، ولم يشتك ضرسه أبدا ) )(@)(@@) . ( طس ، عن علي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3772 / 32797(@)(@@) | 30 قال النبي : ( من باع عبدا وله مال وعليه دين ، فله ماله وعليه دينه إلا أن يشترط المبتاع ، ومن أبر ( 2 ) نخلا أو باعه بعد تأبيره فله ثمرته إلا أن يشترط المبتاع ) )(@)(@@) . ( حم ، عن عمرو عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3773 / 32798(@)(@@) | 30 قال النبي : ( من باع دارا لم يستخلف غيرها لم يبارك له في ثمنها ) )(@)(@@) . ( طس ، عن أبي ذر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3774 / 32799(@)(@@) | 30 قال النبي : ( من بدل دينه فاقتلوه ) )(@)(@@) . ( طس ، عن أبي هريرة بإسناد حسن ، طس ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3775 / 32800(@)(@@) | 30 قال النبي : ( من بنى مسجدا لله كمفحص قطاة أو أصغر بنى الله له بيتا في الجنة من در وياق / وت ) )(@)(@@) . ( ع ، طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV11P182(@)(@@)(@@)(@@) $ 3776 / 32801(@)(@@) | 30 قال النبي : ( من بنى لله مسجدا قدر مفحص قطاة بنى الله له بيتا في الجنة ) )(@)(@@) . ( بز ، طص ، عن أبي ذر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3777 / 32802(@)(@@) | 30 قال النبي : ( من بنى بيتا يعبد الله فيه من مال حلال بنى الله له بيتا في الجنة من در وياقوت ) )(@)(@@) . ( طك ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3778 / 32803(@)(@@) | 30 قال النبي : ( من تاب قبل موته بعام تيب عليه ، ومن تاب قبل موته بشهر تيب عليه ، حتى قال : يوما ، حتى قال : ساعة 
ms3586	 ، حتى قال : فواقا ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3779 / 32804(@)(@@) | 30 قال النبي : ( من تاب قبل طلوع الشمس من مغربها تاب الله عليه ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3780 / 32805(@)(@@) | 30 قال النبي : ( من تختم بالعقيق لم يزل يراى خيرا ) )(@)(@@) . ( طس ، عن فاطمة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3781 / 32806(@)(@@) | 30 قال النبي : ( من ترك دينارا فهو كية ) )(@)(@@) . ( طك ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3782 / 32807(@)(@@) | 30 قال النبي : ( قال الله تعالاى : من ترك الخمر مخافة مني وهو يقدر عليه إلا سقيته إياه من حظيرة القدس ، ومن ترك الحرير وهو يقدر عليه إلا كسوته من حظيرة القدس ) )(@)(@@) . ( حم ، بز ، عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3783 / 32808(@)(@@) | 30 قال النبي : ( من ترك الجمعة ثلاث جمع متواليات فقد نبذ الإسلام وراء ظهره ) )(@)(@@) . ( ع ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3784 / 32809(@)(@@) | 30 قال النبي : ( من ترك الصف الأول مخافة أن يؤذي واحدا أضعف الله له أجر الصف الأول ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3785 / 32810(@)(@@) | 30 قال النبي : ( من تزوج امرأة علاى صداق وهو ينوي أن لا يؤديه إياها فهو زان ، ومن ادان دينا وهو ينوي أن / لا يؤديه إلاى صاحبه فهو سارق ) )(@)(@@) \ PageV11P183 . ( بز ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3786 / 32811(@)(@@) | 30 قال النبي : ( من تزوج فقد استكمل نصف الإيمان ، فليتق الله في النصف الثاني ) )(@)(@@) . ( طس ، بإسنادين عن أنس بن مالك رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3787 / 32812(@)(@@) | 30 قال النبي : ( من تزوج امرأة لعزها لم يزده الله إلا ذلا ، ومن تزوجها لمالها لم يزده الله إلا فقرا ، ومن تزوجها لحسنها لم يزده الله إلا دناءة ، ومن تزوج امرأة لم يتزوجها إلا ليغض بصره ، أو ليحصن فرجه ، أو ليصل رحمه بارك الله فيها وبارك لها فيه ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3788 / 32813(@)(@@) | 30 قال النبي : ( من تشبه بقوم فهو منهم ) )(@)(@@) . ( طس ، عن حذيفة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3789 / 32814(@)(@@) | 30 قال النبي : ( م