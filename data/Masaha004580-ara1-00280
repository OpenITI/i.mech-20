ms280	(@)(@)(@@) @HAD012 لا تستشر الكذاب فإنه كالسراب يقرب إليك البعيد ويبعد عليك القريب(@)(@)(@@)(@@)(@@) ||| 200(@)(@)(@@) @HAD021 لا تكونن ممن لا تنفعه الموعظة إلا إذا بالغت في إيلامه فإن العاقل يتعظ بالأدب والبهائم لا ترتدع إلا بالضرب(@)(@)(@@)(@@)(@@) ||| 201(@)(@)(@@) @HAD012 لا تشركن في مشورتك حريصا يهون عليك الشر ويزين لك الشره(@)(@)(@@)(@@)(@@) ||| 202(@)(@)(@@) @HAD08 لا يكبرن عليك ظلم من ظلمك فإنه يسعى(@)(@)PageV01P756(@)(@)(@@) @HAD011 في مضرته ونفعك وما جزآء من يسرك أن تسوءه(@)(@)(@@)(@@)(@@) ||| 203(@)(@)(@@) @HAD019 لا يكونن أفضل ما نلت من دنياك بلوغ لذة وإشفاء غيظ وليكن إحياء حق وإماتة باطل(@)(@)(@@)(@@)(@@) ||| 204(@)(@)(@@) @HAD023 لا يقنطنك تأخر إجابة الدعاء فإن العطية على قدر النية وربما تأخرت الإجابة ليكون ذلك أعظم لأجر السائل وأجزل لعطاء النائل(@)(@)(@@)(@@)(@@) ||| 205(@)(@)(@@) @HAD017 لا تضيع نعمة من نعم الله سبحانه عندك ولير عليك أثر ما أنعم الله به عليك(@)(@)(@@)(@@)(@@) ||| 206(@)(@)(@@) @HAD023 لا تنابذ عدوك ولا تقرع صديقك واقبل العذر وإن كان كذبا ودع الجواب عن قدرة وإن كان لك(@)(@)(@@)(@@)(@@) ||| 207(@)(@)(@@) @HAD034 لا تذكر الله سبحانه ساهيا ولا تنسه لاهيا واذكره ذكرا كاملا يوافق فيه قلبك ويطابق إضمارك إعلانك ولن تذكره حقيقة الذكر حتى تنسى نفسك في ذكرك وتفقدها في أمرك(@)(@)(@@)(@@)(@@) ||| 208(@)(@)(@@) @HAD010 لا تفن عمرك في المعاصى فتخرج من الدنيا بلا أمل(@)(@)(@@)(@@)(@@) ||| 209(@)(@)(@@) @HAD010 لا تصرف مالك في المعاصي فتقدم على ربك بلا عمل(@)(@)PageV01P757(@)(@)(@@)(@@)(@@) ||| 210(@)(@)(@@) @HAD015 لا تفتننك دنياك بحسن العواري فعواري الدنيا ترتجع ويبقى عليك ما إحتقبته من المحارم(@)(@)(@@)(@@)(@@) ||| 211(@)(@)(@@) @HAD014 لا تغرنك العاجلة بزور الملاهي فإن اللهو ينقطع ويلزمك ما اكتسبت من الإثم(@)(@)(@@)(@@)(@@) ||| 212(@)(@)(@@) @HAD016 لا تؤخر إنالة المحتاج إلى غد فإنك لا تدري ما يعرض لك وله في غد(@)(@)(@@)(@@)(@@) ||| 213(@)(@)(@@) @HAD012 لا تترك الإجتهاد في إصلاح نفسك فإنه لا يعنيك عليها إلا الجد(@)(@)(@@)(@@)(@@) ||| 214(@)(@)(@@) @HAD016 لا تضيعن حق أخيك إاتكالا على ما بينك وبينه فليس لك بأخ من أضعت حقه(@)(@)(@@)(@@)(@@) ||| 215(@)(@)(@@) @HAD022 لا تحدث الجهال بما لا يعلمون فيكذبونك به فإن لعلمك عليك حقا وحقه عليك بذله لمستحقه ومنعه عن غير مستحقه(@)(@)(@@)(@@)(@@) ||| 216(@)(@)(@@) @HAD010 لا يكونن أخوك على الإسائة أقوى منك على الإحسان إليه(@)(@)(@@)(@@)(@@) ||| 217(@)(@)(@@) @HAD09 لا يكونن أخوك على 