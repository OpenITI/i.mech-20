ms41	 أرم الحوادث باسمه % % تقتل أفاعيها سموم عقاربي % % 44(@)(@@) % الرافع الأعلام فوق خوافق % % والقائد الآساد فوق شوازب % % 45(@)(@@) % ملك تكرم عن خلائق غادر % % فأثابه الرحمن قدرة غالية % % 46(@)(@@) % يقضي فيمضي كل حق واجب % % إلا إذا أعطى ففوق الواجب % % 47(@)(@@) % فقل على الإسلام ممنوع له % % عن قلب كل معاند ومناصب % % 48(@)(@@) % لا يخلع الإسلام حلة آمن % % منه ولا الإشراك ربقة هائب % % 49(@)(@@) % حرم الهدى سم العدى أمنية % % لمسالم ومنية لمحارب % % 50(@)(@@) % وقف على علم الثغور مقارب % % لمباعد ومباعد لمقارب % % PageV01P126 51(@)(@@) % فمراقب الإسلام غير مراقب % % ومصاقب الأعداء غير مصاقب % % 52(@)(@@) % موف بعلياء الثغور لرغبة % % من راغب أو رهبة من راهب % % 53(@)(@@) % تضحي عطاياه تحية زائر % % وتبيت روعته نجية هارب % % 54(@)(@@) % يا من يلاقي النازلين قبابه % % بجبين موهوب وراحة واهب % % 55(@)(@@) % وإذا التقي الجمعان أول طاعن % % وإذا استحر الطعن أول ضارب % % 56(@)(@@) % وإذا تئوب الخيل آخر نازل % % وإذا دعا الداعي فأول راكب % % 57(@)(@@) % كرمت أياديك التي أنشأتها % % أتراب كل مؤمل أو راغب % % 58(@)(@@) % من كل بكر في يمينك حرة % % يرفلن بين قلائد وجلابب % % 59(@)(@@) % هذي لأول خاطب ولداتها % % يهتفن في الآفاق هل من خاطب % % 60(@)(@@) % ويجل قدرك عن ولادة يافث % % أو قيصر أو عن أروم صقالب % % PageV01P127 61(@)(@@) % بل أنت بكر غمامة من بارق % % لقحت به أو صعدة من قانب % % 62(@)(@@) % قبلتك أيدي همة وسيادة % % ورضعت در مكارم ومواهب % % 63(@)(@@) % في عز مهد ما استقر مكانه % % إلا بقرب منابر ومحارب % % 64(@)(@@) % بوفطمت يوم فطمت في رهج الوغى % % عند التفاف كتائب بكتائب % % 65(@)(@@) % حتى حلت من السماء مراتبا % % تركت كواكبها بغير مراتب % % 66(@)(@@) % فلئن طلبت هناك حقا صاعدا % % فلأنت أقرب من وريد الطالب % % 67(@)(@@) % ولئن وهبت لقد وهبت مساعيا % % أصبحن حلي ما ثري ومناقبي % % 68(@)(@@) % شيما بها حليت غر قصائدي % % وجعلتهن أهلة لكواكبي % % 69(@)(@@) % وذخرت للأزمان من حسناتها % % مثل القلائد في نحور كواعب % % 70(@)(@@) % ولأشفين بها سقام تغربي % % ولآسون بها جراح مصائبي % % PageV01P128 71(@)(@@) % ولأجعلن منها تمائم خائف % % من طائف أو من رجاء خائب % % 72(@)(@@) % ولأتركن ثناءها 
ms42	 وجزاءها % % قوت المقيم غدا وزاد الراكب % % 73(@)(@@) % وسرور محزون وأنس مغرب % % وحلي أوتار وروضة شارب % % 74(@)(@@) % ولقد نثرت عليك شكلك جوهرا % % لا ما قمشت وضم حبل الحاطب % % PageV01P129 البحر : متقارب تام 1(@)(@@) % سلام وهنيت فيك السلامة % % وعمرا أهني الليالي دوامه % % 2(@)(@@) % ومقدم يوم تجليت فيه % % كريما تحلى بتاج الكرامه % % 3(@)(@@) % كما رفعت مظلمات العيون % % إلى قمر طالع في غمامه % % 4(@)(@@) % ومليت ملك الرضا من مليك % % إذا سل رأيك أمضي حسامه % % 5(@)(@@) % مفيق سهام تباري القضاء % % وقائد خيل تباري سهامه % % 6(@)(@@) % إلى غزوة ما عدا أن أطاع % % بها ربه ثم أرضى إمامه % % 7(@)(@@) % تسربل بأسا يكاد الحمام % % إذا صال يرهب فيه حمامه % % 8(@)(@@) % فلا نسي الله والمسلمون % % والملك والدين فيها مقامه % % 9(@)(@@) % وقد هاج مصعب هيجائها % % بريب المنون وأحمى خطامه % % 10(@)(@@) % فأيمن بيمناك موصولة % % بكف تعالت فجبت سنامه % % PageV01P130 11(@)(@@) % وزيرا تحمل أعباء ملك % % كما نيط بالسيف أذيال لامه % % 12(@)(@@) % ولله سعيك في الله يوما % % تقنعت الشمس منه غمامه % % 13(@)(@@) % تفلل خدا تعالت ذراه % % وتطفئ جمرا يشب اضطرامه % % 14(@)(@@) % أبما أنبت الخط إلا شباه % % وما ينبت الخط حتى نظامه % % 15(@)(@@) % سنانا سننت له المأثرات % % وثقفه العدل حتى أقامه % % 16(@)(@@) % فأوقد في كل نجد سناه % % وأهدى إلى كل أمت قوامه % % 17(@)(@@) % وأتبعه قلم ما ينال % % مساجله في مداه قلامه % % 18(@)(@@) % فصيح الشبا ما استمد الرضاع % % وأعجم ساعة تنوي فطامه % % 19(@)(@@) % يريك ظلام الدجى مشرقا % % إذا مج في وجه صبح ظلامه % % 20(@)(@@) % وإن أمطر المسك كافور أرض % % فقد فض عن كل طيب ختامه % % PageV01P131 21(@)(@@) % تجهز للخطب فصل الخطاب % % فملك أيدي الأماني زمامه % % 22(@)(@@) % ووشج للسلم منك السلامى % % فأهدى له كل أفق سلامه % % 23(@)(@@) % وقلدته سيف رأي وحزم % % يضيء الظلام ويأبى الظلامه % % 24(@)(@@) % سلاحا قتلت بهن الحقود % % وخيلا غنمت بهن السلامه % % 25(@)(@@) % فرب تلاق أباحت حماه % % ورب اعتناق أحلت حرامه % % 26(@)(@@) % وليس بأول شعب رأبت % % ولا صدع شمل ضمنت التئامه % % 27(@)(@@) % فما دوي الثغر إلا بعثت % % إليه شمائل تشفي سقامه % % 28(@)(@@) % ولا ظمئ الدهر إلا سكبت 
ms43	 % % عليه سحائب تروي أوامه % % 29(@)(@@) % ذكاء زكا فاحتبى ثوب حلم % % كما احتبت الماء نار المدامه % % 30(@)(@@) % وآداب علم تحلت بهدي % % كهادي الجواد تحلى لجامه % % PageV01P132 31(@)(@@) % كأن العلا خيرت في الولاة % % وأعطي سلطانهن احتكامه % % 32(@)(@@) % فأعطاك حر الخطاب المقاد % % وولاك در المقال انتظامه % % 33(@)(@@) % فلو غبت يوم استباق الكرام % % لوافاك ذو السبق منها أمامه % % 34(@)(@@) % وكيف وما ضاع حق لحر % % تراعي حماه وترعى سوامه % % 35(@)(@@) % وكيف يقصر عن غاية % % فتى شد طفلا إليها حزامه % % 36(@)(@@) % وعندك أبلغ ساع مداه % % وعندك أدرك جفن منامه % % 37(@)(@@) % وكم من يد حرة عند حر % % تطوقها منك طوق الحمامه % % 38(@)(@@) % وأنت غفرت ذنوب الزمان % % إلي وكفرت عندي أثامه % % 39(@)(@@) % فإن ذكرتني ليالي المقام % % لديك نعيما بدار المقامهب % % 40(@)(@@) % فكم لج بحر وضحضاح قفر % % تمثل لي فيه هول القيامة % % PageV01P133 41(@)(@@) % ليالي أمسي صدى قفرة % % أجول الفلا بين غول وهامه % % 42(@)(@@) % معنى بأفلاذ قلب حوام % % تباري إلى كل ماء سمامه % % 43(@)(@@) % وكلهم نمري وإني % % لكل هنالك كعب بن مامه % % 44(@)(@@) % وأعذر مبلغهم حيث ألقوا % % عصي النوى ورحال السآمه % % 45(@)(@@) % وأنسوا ببحرك موج البحار % % وميد السفين بها وارتطامه % % 46(@)(@@) % وظلك أنساهم ليل هم % % يقاسون في ليل يم غرامه % % 47(@)(@@) % ونورك أنساهم آل قفر % % وحر الهجير بها واحتدامه % % 48(@)(@@) % ووعدك بالفضل أنساهم % % وعيد الردى حيث حلو خيامه % % 49(@)(@@) % وليس على زمن قادني % % إليك وإن شف نفسي ملامه % % 50(@)(@@) % وأنت كسوت نجومي سناها % % فلاحت وأمطرت روضي غمامه % % PageV01P134 51(@)(@@) % وأدنيت من مد كفي جناها % % وقربت من مر سهمي مرامه % % 52(@)(@@) % وأنت أسوت على حر وجهي % % جراح أكف أضاعت ذمامه % % 53(@)(@@) % فإن يصدق الجد صدق الوفاء % % منك فقد نال بدر تمامه % % 54(@)(@@) % وأرطب زهو الأماني فجاءت % % مباكرة الحمد تبغي صرامه % % 55(@)(@@) % وصدق الوفاء بصدق الرجاء % % فهل ينظر الدهر إلا تمامه % % PageV01P135 البحر : متقارب تام 1(@)(@@) % بقاء الخلائق رهن الفناء % % وقصر التداني وشيك التنائي % % 2(@)(@@) % لقد حل من يومه لاقتراب % % وقد حام من عمره لانتهاء % % 3(@)(@@) % هل الملك يملك ريب المنون % % أم العز يصرف صرف 
ms44	 القضاء % % 4(@)(@@) % هو الموت يصدع شمل الجميع % % ويكسو الربوع ثياب العفاء % % 5(@)(@@) % يبز الحياة ببطش شديد % % ويلقى النفوس بداء عباء % % 6(@)(@@) % ألم تر كيف استباحت يداه % % كريم الملوك وعلق السناء % % 7(@)(@@) % أووافى بسيدة السيدات % % مأوى البلى ومناخ الفناء % % 8(@)(@@) % هو الرزء ألوى بعزم القلوب % % مصابا وأودى بحسن العزاء % % 9(@)(@@) % فما في العويل له من كفيء % % ولا في الدموع له من شفاء % % 10(@)(@@) % فهيهات فيه غناء الزفير % % وهيهات منه انتصار البكاء % % PageV01P136 11(@)(@@) % وأنى يدافع سقم بسقم % % وكيف يعالج داء بداء % % 12(@)(@@) % فتلك مآقي جفون رواء % % مفجرة من قلوب ظماء % % 13(@)(@@) % فلا صدر إلا حريق بنار % % ولا جفن إلا غريق بماء % % 14(@)(@@) % فقد كاد يصدع صم السلام % % ويضرم نار الأسى في الهواء % % 15(@)(@@) % وجيب القلوب وشق الجيوب % % وشجو النحيب ولهف النداء % % 16(@)(@@) % فمن مقلة شرقت بالدموع % % ومن وجنة شرقت بالدماء % % 17(@)(@@) % وسافرة من قناع الحياة % % ونابذة صبرها بالعراء % % 18(@)(@@) % وبيض صبغن بلون الحداد % % حمر البنود وبيض الملاء % % 19(@)(@@) % نواشج في سابغات المسوح % % وضافي الشعور بلبس سواء % % 20(@)(@@) % أنجما هوى في سماء المعالي % % لتبك عليك نجوم السماء % % PageV01P137 21(@)(@@) % فحاشى لرزئك أن يقتضيه % % عويل الرجال ولدم النساء % % 22(@)(@@) % لبيض أياديك في الصالحات % % تمسك وجه الضحى بالضياء % % 23(@)(@@) % وقل لفقدك أن يحتبي % % عليه الصباح بثوب المساء % % 24(@)(@@) % فيا أسف الملك من ذات عز % % تعوض منها بعز العزاء % % 25(@)(@@) % وروح القبور لمجد مقيم % % وترح القصور لربع خلاء % % 26(@)(@@) % ولو قبل الموت منها الفداء % % لضاق الأنام لها عن فداء % % 27(@)(@@) % لئن حجبت تحت ردم اللحود % % ومن قبل في شرفات العلاء % % 28(@)(@@) % فتلك مآثرها في التقى % % وبذل اللهى ما لها من خفاء % % 29(@)(@@) % جزاك بأعمالك الزاكيات % % خير المجازين خير الجزاء % % 30(@)(@@) % ولقيت في ضنك ذاك الضريح % % نسيم النعيم وطيب النواء % % PageV01P138 31(@)(@@) % فيا رب زلفى لدى المشرقين % % أبضعت فابتمتها بالعلاء % % 32(@)(@@) % بوعاري الجناحين نبئت عنه % % فأمسى وقد رشته بالعطاء % % 33(@)(@@) % ودعوة عان بأقصى الدروب % % سمعت لوجه سميع الدعاء % % 34(@)(@@) % وذي حبوة بفناء المقام % % سنحت له بسجال الحباء % % 35(@)(@@) % فلله 
ms45	 من طارق لليالي % % رماك بيوم كيوم البراء % % 36(@)(@@) % فودعت فيه إمام الهدى % % وداع نوى مالها من لقاء % % 37(@)(@@) % نجيبك والمصطفى للخلافة % % من سلفي خاتم الأنبياء % % 38(@)(@@) % وما رد عنك سهام الحمام % % بحرز الجناب وعز الفناء % % 39(@)(@@) % ودهر مطيع وسور منيع % % وقصر رفيع مشيد البناء % % 40(@)(@@) % وزأر الأسود وخفق البنود % % وجمع الحشود بملء الفضاء % % PageV01P139 41(@)(@@) % بكل كمي جريء الجنان % % وكل أمير منيف اللواء % % 42(@)(@@) % ووال رعى الله ما قد رعاه % % فابلاه في الصنع خير البلاء % % 43(@)(@@) % تبلج عنه سنا يعرب % % تبلج قرن الضحى عن ذكاء % % 44(@)(@@) % وهزت مضاربه عن حسام % % وفرت نواجذه عن ذكاء % % 45(@)(@@) % فتى قارض الله عن نفس حر % % براها لتخليد حر الثناء % % 46(@)(@@) % وأقحمها مخطرات الحروب % % وأحبسها في سبيل السواء % % 47(@)(@@) % وجاهد في الله حق الجهاد % % وأغنى عن الملك حق الغناء % % 48(@)(@@) % وشد على الدين سور الأمان وسد عن الشرك باب النجاء % % 49(@)(@@) % وسيف إذا لألأته الحروب % % طار العداة به كالهباء % % 50(@)(@@) % وألبسه النصر ثوب الجلال % % وتوجه الصبر تاج البهاء % % PageV01P140 51(@)(@@) % فلو أفصح الدهر عما يكن % % لناداه يا صفوة الأولياء % % 52(@)(@@) % هوالماك العامري المسمى % % يداه كفيلي حياة الرجاء % % 53(@)(@@) % عزاء إمام الهدى فالنفوس % % ما إن سواك لها من عزاء % % 54(@)(@@) % وعوضت منها جزيل الثواب % % ومد لك الله طول البقاء % % PageV01P141 البحر : كامل تام 1(@)(@@) % أبشراك من طول الترحل والسرى % % صبح بروح السفر لاح فأسفرا % % 2(@)(@@) % من حاجب الشمس الذي حجب الدجى % % فجرا بأنهار الندى متفجرا % % 3(@)(@@) % نادى بحي على الندى ثم اعتلى % % سبل العفاة مهللا ومكبرا % % 4(@)(@@) % لبيك أسمعنا نداك ودوننا % % نوء الكواكب مخويا أو ممطرا % % 5(@)(@@) % من كل طارق ليل همي ينتحي % % وجهي بوجه من لقائك أزهرا % % 6(@)(@@) % سار ليعدل عن سمائك أنجمي % % وقد ازدهاها عن سناك محيرا % % 7(@)(@@) % فكأنما أغرته أسباب النوى % % قدرا لبعدي عن يديك مقدرا % % 8(@)(@@) % أو غار من هممي فأنحى شأوها % % فلك البروج مغربا ومغورا % % 9(@)(@@) % حتى علقت النيرين فأعلقا % % مثنى يدي ملك الملوك النيرا % % 10(@)(@@) % فسريت في حرم الأهلة مظلما % % ورفلت في خلع 
ms46	 السموم مهجرا % % PageV01P142 11(@)(@@) % وشعبت أفلاذ الفؤاد ولم أكد % % فحذوت من حذو الثريا منظرا % % 12(@)(@@) % ست تسراها الجلاء مغربا % % وحدا بها حادي النجاء مشمرا % % 13(@)(@@) % لا يستفيق الصبح منها ما بدا % % فلقا ولا جدي الفراقد ما سرى % % 14(@)(@@) % ظعن ألفن القفر في غول الدجى % % وتركن مألوف المعاهد مفقرا % % 15(@)(@@) % يطلبن لج البحر حيث تقاذفت % % أمواجه والبر حيث تنكرا % % 16(@)(@@) % هيم وما يبغين دونك موردا % % أبدا ولا عن بحر جودك مصدرا % % 17(@)(@@) % من كل نضو الآل محبوك المنى % % يزجيه نحوك كل محبوك الفرا % % 18(@)(@@) % فدت منا دماء نحورها % % ببغائها في كل أفق منحرا % % 19(@)(@@) % بنا صدر الدبور فأنبطت % % قلق المضاجع تحت جو أكدرا % % 20(@)(@@) % وصبت إلى نحو الصبا فاستخلصت % % سكن الليالي والنهار المبصرا % % PageV01P143 21(@)(@@) % غوص نفخن بنا البرا حتى انثنت % % أشلاؤهن كمثل أنصاف البرا % % 22(@)(@@) % سرت لنا ألا تلاقي راحة % % مما تلاقي أو تلاقي منذرا % % 23(@)(@@) % وتقاسمت ألا تسيغ حياتها % % دون ابن يحيى أو تموت فتعذرا % % 24(@)(@@) % لله أي أهلة بلغت بنا % % يمناك يا بدر السماء المقمرا % % 25(@)(@@) % بل أي غصن في ذراك هصرته % % نخر فأورق في يديك وأثمرا % % 26(@)(@@) % فلئن صفا ماء الحياة لديك لي % % فبما شرقت إليك بالماء الصرى ب % % 27(@)(@@) % ولئن خلعت علي بردا أخضرا % % فلقد لبست إليك عيشا أغبرا % % 28(@)(@@) % ولئن مددت علي ظلا باردا % % فلكم صليت إليك جوا مسعرا % % 29(@)(@@) % وكفاك من جعل الحياة بضاعة % % ورأى رضاك بها رخيصا فاشترى % % 30(@)(@@) % فمن المبلغ عن غريب نازح % % قلبا يكاد علي أن يتفطرا % % PageV01P144 31(@)(@@) % لهفان لا يرتد طرف جفونه % % إلا تذكر عبرتي فاستعبرا % % 32(@)(@@) % أبني لا تذهب بنفسك حسرة % % عن غول رحلي منجدا أو مغورا % % 33(@)(@@) % فلئن تركت الليل فوقي داجيا % % فلقد لقيت الصبح بعدك أزهرا % % 34(@)(@@) % ولقد وردت مياه مارب حفلا % % وأسمت خيلي وسط جنة عبقرا % % 35(@)(@@) % ونظمت للغيد الحسان قلائدا % % من تاج كسرى ذي البهاء وقيصرا % % 36(@)(@@) % وحللت أرضا بدلت حصباؤها % % ذهبا يرف لناظري وجوهرا % % 37(@)(@@) % وليعلم الأملاك أني بعدهم % % ألفيت كل الصيد في جوف الفرا % % 38 
ms47	(@)(@@) % ورمى علي رداءه من دونهم % % ملك تخير للعلا فتخيرا % % 39(@)(@@) % ضربوا قداحهم علي ففاز بي % % من كان بالقدح المعلى أجدرا % % 40(@)(@@) % من فك طرفي من تكاليف الفلا % % وأجار طرفي من تباريح السرى % % PageV01P145 41(@)(@@) % وكفى عتابي من ألام معذرا % % وتذممي ممن تجمل معذرا % % 42(@)(@@) % ومسائل عني الرفاق ووده % % لو تنبذ السادات رحلي بالعرا % % 43(@)(@@) % وبقيت في لجج الأسى متضللا % % وعدلت عن سبل الهدى متحيرا % % 44(@)(@@) % كلا وقد آنست من هود هدى % % ولقيت يعرب في القيول وحميرا % % 45(@)(@@) % وأصبت في سبأ مورث ملكه % % يسبي الملوك ولا يدب لها الضرا % % 46(@)(@@) % فكأنما تابعت تبع رافعا % % أعلامه ملكا يدين له الورى % % 47(@)(@@) % والحارث الجفني ممنوع الحمى % % بالخيل والآساد مبذول القرى % % 48(@)(@@) % وحططت رحلي بين ناري حاتم % % أيام يقري موسرا أو معسرا % % 49(@)(@@) % ولقيت زيد الخيل تحت عجاجة % % يكسو غلائلها الجياد الضمرا % % 50(@)(@@) % وعقدت في يمن مواثق ذمة % % مشدودة الأسباب موثقة العرى % % PageV01P146 51(@)(@@) % وأتيت بحدل وهو يرفع منبرا % % للدين والدنيا ويخفض منبرا % % 52(@)(@@) % أوخططت بين جفانها وجفونها % % حرما أبت حرمانه أن تحفرا % % 53(@)(@@) % تلك البحور تتابعت وخلفتها % % سعيا فكنت الجوهر المتخيرا % % 54(@)(@@) % ولقد نموك ولادة وسيادة % % وكسوك عزا وابتنوا لك مفخرا % % 55(@)(@@) % فعمرت بالإقبال أكرم أكرم % % ملكا ورثت علاه أكبر أكبرا % % 56(@)(@@) % وشمائل عبقت بها سبل الهدى % % وذرت على الآفاق مسكا أذفرا % % 57(@)(@@) % أهدى إلى شغف القلوب من الهوى % % وألذ في الأجفان من طعم الكرى % % 58(@)(@@) % ومشاهد لك لم تكن أيامها % % ظنا يريب ولا حديثا يفترى % % 59(@)(@@) % لاقيت فيها الموت أسود أدهما % % فذعرته بالسيف أبيض أحمرا % % 60(@)(@@) % ولو اجتلى في زي قرنك معلما % % لتركته تحت العجاج معفرا % % PageV01P147 61(@)(@@) % يا من تكبر بالتكرم قدره % % حتى تكرم أن يرى متكبرا % % 62(@)(@@) % والمنذر الأعداء بالبشرى لنا % % صدقت صفاتك منذرا ومبشرا % % 63(@)(@@) % ما صور الإيمان في قلب امرئ % % حتى يراك الله فيه مصورا % % 64(@)(@@) % فارفع لها علم الهدى فلمثلها % % رفعتك أعلام السيادة في الذرى % % 65(@)(@@) % وانصر نصرت من السماء فإنما % % ناسبت أنصار النبي لتنصرا % % 66(@)(@@) % واسلم ولا وجدوا لجوك 
ms48	 منفسا % % في النائبات ولا لبحرك معبرا % % PageV01P148 البحر : بسيط تام 1(@)(@@) % بشراك أيتها الدنيا وبشرانا % % أحياك بالعدل من بالأمن أحيانا % % 2(@)(@@) % لعل آمالنا في الله قد صدقت % % وصدق موعده بالفتح قد آنا % % 3(@)(@@) % وعودة تمتري عفوا وعافية % % ودعوة تقتضي صفحا وغفرانا % % 4(@)(@@) % تنسمي ريح روح الله منشئة % % غيوث رحمته سحا وتهتانا % % 5(@)(@@) % واستقبلي زهرة العقبى منورة % % بالنور في روضة تهتز رضوانا % % 6(@)(@@) % لتورقن شجر الدنيا لنا ورقا % % بسعدها وتريق الأرض عقيانا % % 7(@)(@@) % وتعبق الأرض من مسك وغالية % % وتمطر المزن ياقوتا ومرجانا % % 8(@)(@@) % وقل لمن قد أضل الشمس طالعة % % لا تسر من بعدها في ليل حيرانا % % 9(@)(@@) % ويا غريبا شريدا عن مواطنه % % لتهنك الأرض ألافا وأوطانا % % 10(@)(@@) % بويا مروع الضحى يزجى ظعائنه % % عرس بجوز الفلا أمنا وإيمانا % % PageV01P149 11(@)(@@) % هاتيك شمس الهدى في برج أسعدها % % وديننا مشرق في عز دنيانا % % 12(@)(@@) % ودوحة الله زكى غرسها فزكت % % أكلا وظلا وأشجارا وأغصانا % % 13(@)(@@) % أوشك بها نعمة راقت لتحيينا % % نعمى ويثمر ذاك الحسن إحسانا % % 14(@)(@@) % خلافة الله في مثوى نبوته % % وحفظه قد تولى من تولانا % % 15(@)(@@) % ودولة سبقت آمالنا كرما % % كأن ما قد تمنينا تمنانا % % 16(@)(@@) % وعودة أعلن الداعي فأسمعها % % من قصر قرطبة أقصى خراسانا % % 17(@)(@@) % وبيعة عرف الإسلام آيتها % % فلم يخروا لها صما وعميانا % % 18(@)(@@) % كادت تحرك للأشجار ألسنة % % تدعو وتخرق للأحجار آذانا % % 19(@)(@@) % للقاسم القائم الهادي الذي هديت % % إليه طاعتنا سرا وإعلانا % % 20(@)(@@) % وابن الذي كتبت في اللوح طاعته % % وود قرباه عند الله قربانا % % PageV01P150 21(@)(@@) % إمامنا وابن من أم الإله به % % أهل السماء ومن في أرضه دانا % % 22(@)(@@) % تلك المنابر لم تثبت قواعدها % % حتى تحلين من ذكراه تيجانا % % 23(@)(@@) % بل الكتائب لم تنشر صحائفها % % حتى رأته لفتح الله عنوانا % % 24(@)(@@) % مقلدا نصل هذا السيف من يمن % % في السلم والحرب تمكينا وإمكانا % % 25(@)(@@) % صيحة عمت الدنيا وساكنها % % نورا وأضرمت الأعداء نيرانا % % 26(@)(@@) % فأصبح المنذر المنصور والينا % % والقاسم الملك المأمون مولانا % % 27(@)(@@) % من بعد فترة أزمان مطلن به % % وددن ألا نسميهن أزماننا % % 28(@)(@@) % يمناه في قائم 
ms49	 السيف المقام له % % في العدل والقسط عند الله ميزانا % % 29(@)(@@) % رد الإله إليه حق والده % % فكل حق به رد لمن كانا % % 30(@)(@@) % أحيا به لابن يحيى حق أوله % % في نصرة الحق إقرارا وإذعانا % % PageV01P151 31(@)(@@) % حكما بما نطقت فيه وما صدقت % % شهادة الله تنزيلا وفرقانا % % 32(@)(@@) % وأسوة برسول الله والده % % فيمن تخير أنصارا وجيرانا % % 33(@)(@@) % فحسب مؤثر هذا الحكم معدلة % % وحسب ناصر هذا الدين برهانا % % 34(@)(@@) % فتى نماه إلى نصر الهدى نسب % % لو قدر البدر ليل التم لازدانا % % 35(@)(@@) % أمن الذين وفت لله بيعتهم % % فأخلصوا العهد إيمانا وأيمانا % % 36(@)(@@) % باعوا نفوسهم من ربهم فجزوا % % خلد الثناء وخلد الفوز أثمانا % % 37(@)(@@) % فأشرقت سبل الدنيا بهديهم % % والأرض قد شرقت كفرا وأوثانا % % 38(@)(@@) % تلقى شبابهم في السلم إن نطقوا % % شيبا وشيبهم في الحرب شبانا % % 39(@)(@@) % هم الملبون والأبصار ناكصة % % نبيهم يوم نادى يالقحفانا % % 40(@)(@@) % والمطلعون نجوم الملك إذا أفلت % % والكافلون بعز الحق إذ هانا % % PageV01P152 41(@)(@@) % لهم مدى السبق في بدر وفي أحد % % وآل حرب وحزبي قيس عيلانا % % 42(@)(@@) % وفي تبوك وأوطاس ومصطلق % % ومن عصى الله من أبناء عدنانا % % 43(@)(@@) % لهم براءة والأنفال إذا ختمت % % والنصف قسمهم من آل عمرانا % % 44(@)(@@) % ويوم صفين لم تخذل سيوفكم % % آل الرسول به يا آل همدانا % % 45(@)(@@) % فليهنكم نصر من أهدى الهدى لكم % % ونصر أبناءه من بعده الآنا % % 46(@)(@@) % سعي الذين هم آووا وهم نصروا % % وأنجبوا ناصرا للدين آوانا % % 47(@)(@@) % أسرى إلى الروع في تأمين روعتنا % % وساور الموت في تمهيد محيانا % % 48(@)(@@) % كأنه لم يجد غير الوغى وطنا % % ولا سوانا لما يحويه خزان % % 49(@)(@@) % سيفا ولكن على الأعداد محتكما % % بحرا ولكن إلى الظمآن ظمآنا % % 50(@)(@@) % أعطى الرغائب حتى كاد يوهمنا % % لو سائل سالنا منه لأعطانا % % PageV01P153 51(@)(@@) % وساجل الدهر حتى لم تدع يده % % في الجود كفئا ولا في الحرب أقرانا % % 52(@)(@@) % إذا المراتب جالت في أعنتها % % وجررت خطط العلياء أرسان % % 53(@)(@@) % فاصمم إليك أقاصيهن مذعنة % % حقا لسعيك لا بغيا وعدوانا % % 54(@)(@@) % فكم ضربت عليها من قداح وغى % % بالبيض والسمر ضرابا 
ms50	 وطعانا % % 55(@)(@@) % وكم سبقت إليها واحتويت لها % % مدى جعلت إليها الصدق ميدانا % % 56(@)(@@) % رياستين كمثل الشعريين سنا % % وكالربيعين روحانا وريحانا % % 57(@)(@@) % وتاج نصر وإعظام وتكرمة % % حلاكها من بأمن الأرض حلانا % % 58(@)(@@) % فإن ولدت لها أقمار مملكة % % أسباط ملحمة أسدا وفرسانا % % 59(@)(@@) % فقد خلعت على يحيى حجابتها % % محفوفة منك إعزازا وسلطاناب % % 60(@)(@@) % حتوى حكم مثنى وزارتها % % ففزتم بالعلا مثنى ووحدانا % % PageV01P154 61(@)(@@) % حباكم أمير المؤمنين به % % كما بقربكم الرحمن حابانا % % 62(@)(@@) % رية جالت الدنيا فما وجدت % % سواكم لنفوس الملك أبدانا % % 63(@)(@@) % وهمة لك يا منصور ما هدأت % % حتى رأتك لعين الدين إنسانا % % 64(@)(@@) % فهدمت بك بنيان العدى فرقا % % وشيدت لك فوق النجم بنيانا % % 65(@)(@@) % ينسي بناءكم صنعاء بل إرما % % ذات العماد وسندادا وغمدانا % % 66(@)(@@) % والأبلق الفرد والأبراج من أجأ % % والسيلحين وسدا كان ما كانا % % 67(@)(@@) % من رسول الله شد بها % % رب العلا للهدى والدين أركانا % % 68(@)(@@) % يكاد وقد لاحت معالمه % % يشدو به الدهر إفصاحا وتبيانا % % 69(@)(@@) % جزاء ربك بالحسنى لذي حرم % % أضحى على حرم الإسلام غيرانا % % 70(@)(@@) % وحفظمن لم يزل بالعدل يحفظنا % % ورعي من لم يزل بالبر يرعانا % % PageV01P155 71(@)(@@) % وصدق ما قد عهدتم في كرائمكم % % إن لم يملكن أكفاء فأكفانا % % 72(@)(@@) % فنهنكم نعمة يحيا السرور بها % % وغبطة حان فيها يوم من حانا % % 73(@)(@@) % فاز بالعز من نادى ببيعتكم % % وباء بالخزي هيان بن بيانا % % PageV01P156 البحر : بسيط تام 1(@)(@@) % أهل بالبين فانهلت مدامعه % % وآنس النفر فاستكت مسامعه % % 2(@)(@@) % وودع المنزل الأعلى فأودعه % % في القلب لاعج بث لا يوادعه % % 3(@)(@@) % يا معهدا لم يضع عهد الوفاء له % % مكسف النور عافي القدر ضائعه % % 4(@)(@@) % ولا ثنى عبراتي عن تذكره % % دهر نقارع في صدري قوارعه % % 5(@)(@@) % حسبي ضلوع ثوت فيها مصائبه % % ومقلة ربعت فيها مرابعه % % 6(@)(@@) % سقاك مثل الذي عفى رباك عسى % % ينبيك كيف غريب الرحل شاسعه % % 7(@)(@@) % صبا كتصعيد أنفاسي وصوب حيا % % تريك عبرة أجفاني مدامعه % % 8(@)(@@) % سح إذا شف صحن الخد ضائره % % شفى تباريح ما في القلب نافعه % % 9(@)(@@) % ألله من وطن قلبي له وطن 
ms51	 % % يبلى وأبلى وما تبلى فجائعه % % 10(@)(@@) % لا يسأم الدهر من شوق يطالعني % % منه ومن زفرة مني تطالعه % % PageV01P157 11(@)(@@) % فطالما قصرت ليلي مقاصره % % لهوا وما صنعت صبحي مصانعه % % 12(@)(@@) % وطالما أينعت حولي حدائقه % % والعيش غض أنيق الروض يانعه % % 13(@)(@@) % وكم أظل مقيلي وسط جنته % % بكل فرع حمام الأيك فارعه % % 14(@)(@@) % إن تسعد اليوم أشجاني نوائحه % % فكم وكم ساعدت شجوي سواجعه % % 15(@)(@@) % وكم وفى لي فيه من حبيب هوى % % خلعت فيه عذاري فهو خالعه % % 16(@)(@@) % روض لعين الهوى راقت أزاهره % % ومشرب للصبا صابت مشارعه % % 17(@)(@@) % وكم صدعت فؤاد الليل عن قمر % % له هوى في صميم القلب صادعه % % 18(@)(@@) % خالت فيه عيونا غير هاجعة % % والحزم عني غضيض الطرف هاجعه % % 19(@)(@@) % وفي نجادي جري الإلف مقدمه % % وفي عناني مشيح الجذل دارعه % % 20(@)(@@) % فما تجاوزت قرن الموت معتسفا % % إلا وقرني رخيم الذل بارعه % % PageV01P158 21(@)(@@) % تحيتي منه تقبيل ومعتنق % % يشدني غله فيه وجامعه % % 22(@)(@@) % لم أخلع الدرع إلا حين شققه % % عن صفح صدري ما تحوي مدارعه % % 23(@)(@@) % ولا توقيت سهما من لواحظه % % يذيب سيفي وفي قلبي مواقعه % % 24(@)(@@) % غصن تجرع أنداء النعيم فما % % يطوق الدر إلا وهو جارعه % % 25(@)(@@) % غض القباطي تحت الوشي ناعمها % % مخلخل الجيد فوق العقد رادعه % % 26(@)(@@) % يميس طورا وسكر الدل عاطفه % % وتارة وانثناء الوشي لاذعه % % 27(@)(@@) % فاستفرغ الخصر كثبانا تباعده % % وأنبت الصدر رمانا تدافعه % % 28(@)(@@) % وفي السوالف خوف الصدغ يجرحه % % تمثال صدغيه مسكا فهو مانعه % % 29(@)(@@) % فبت تحت رواق الليل ثانية % % والشوق ثالثه والوصل رابعه % % 30(@)(@@) % والسحر يسحر من لفظ ينازعني % % والمسك يعبق من كأس أنازعه % % PageV01P159 31(@)(@@) % راحا يمد سناها نور راحته % % لولا المها لجرت فيها أصابعه % % 32(@)(@@) % كأنما ذاب فيها ورد وجنته % % وشجها ريقه المعسول مائعه % % 33(@)(@@) % جنى حياة دنت مني مطاعمه % % من بعد ما قد نأت عني مطامعه % % 34(@)(@@) % بقد أنهب المسك والكافور خازنه % % وأرخص الورد والتفاح بائعه % % 35(@)(@@) % فيا ضلال نجوم الليل إذ عدمت % % بدر السماء وفي حجري مضاجعه % % 36(@)(@@) % ويا حنين ظباء القفر إذ فقدت % % غزالهن وفي روضي 
ms52	 مراتعه % % 37(@)(@@) % مجال طرفي وما حازت لواحظه % % وحر صدري وما ضمت أضالعه % % 38(@)(@@) % والطرف مرآة عيني أستدل به % % على الصباح إذا ما خيف ساطعه % % 39(@)(@@) % جونا أزيد به ليل الرقيب دجى % % ويستثير لي الإصباح لامعه % % 40(@)(@@) % فبات يعجب من ظبي يصارعني % % وقد يحن على ليث أصارعه % % PageV01P160 41(@)(@@) % وما رأى قبلها قرنا أعانقه % % إلا وودع نفسا لا تراجعه % % 42(@)(@@) % حتى بدا الصبح مشمطا ذوائبه % % يطارد الليل موشيا أكارعه % % 43(@)(@@) % كأن جمع ظلال حان مصرعه % % وأنت بالسيف يا منصور صارعه % % 44(@)(@@) % أو كاشتجار رماح أنت مشرعها % % في باب فتح مبين أنت شارعه % % 45(@)(@@) % جيش يجيش برعد الموت يقدمه % % إلى عداك قضاء حم واقعه % % 46(@)(@@) % صباح بارقة لولا عجاجته % % وليل هابية لولا لوامعه % % 47(@)(@@) % دلائل اليمن في الهيجا أدلته % % وأنجم السعد بالبشرى طلائعه % % 48(@)(@@) % يهدي بهدي لواء أنت عاقده % % لله والله بالتأييد رافعه % % 49(@)(@@) % لموعد غير مكذوب عواقبه % % في متجر غير مرجاة بضائعه % % 50(@)(@@) % مثنى جهاد وصم ضم شملهما % % عزم يسايره صبر يشايعه % % PageV01P161 51(@)(@@) % فلا ظلام قرار أنت ساكنه % % ولا نهار مغار أنت وادعه % % 52(@)(@@) % تهيم في الأرض عن حصن تنازله % % وتخرق البيد عن جيش تقارعه % % 53(@)(@@) % حتى جدعت أنوف الشرك قاطبة % % بأنف معقل كفر أنت جادعه % % 54(@)(@@) % غاب الأسود الذي غر الظلال به % % فخادع الله منه وهو خادعه % % 55(@)(@@) % فإن شجت ثغرك الأقصى مرابصه % % فقد شجت أرضه القصوى مصارعه % % 56(@)(@@) % وإن يرع نازح الأوطان عنك فقد % % راع العدى منه يوم أنت رائعه % % 57(@)(@@) % صبحته من رياح النصر عاصفة % % لا تتقي بعدها خسفا بلاقعه % % 58(@)(@@) % كأن نافخ صور الموت أصعقه % % فهد أسواره العليا صواقعه % % 59(@)(@@) % فمقعص ناشز عنه حلائله % % ومرضع ذاهل عنه مراضعه % % 60(@)(@@) % وهام تحت بروق الموت كل رشا % % الليث كافله والليث فاجعه % % PageV01P162 61(@)(@@) % هذا معانقه يأسا فمسلمه % % وذا معانقه إلفا فشافعه % % 62(@)(@@) % عواطلا أنت حليت الخيول بها % % جيشا غدائرها فيه براقعه % % 63(@)(@@) % أوردتها المصر والأبصار طامحة % % لصنع ما لك رب العرش صانعه % % 64(@)(@@) % والأرض تلبسه طورا وتخلعه % % والجسر حامله كرها فواضعه 
ms53	 % % 65(@)(@@) % طود من الخيل أعلاه وأسفله % % بحر من السيل ملتج دوافعه % % 66(@)(@@) % والشمس لابسة منه قناع دجى % % واليوم أزهر وجه الجو ماتعه % % 67(@)(@@) % بيمن حاجبك الميمون طائره % % وسعد قائدك المسعود طالعه % % 68(@)(@@) % أنجبته كاسمه تحيا علاك به % % كهل التجارب شرخ العزم يافعه % % 69(@)(@@) % ساقي الحياة لمن سالمت مطعمها % % ذعاف سم لمن حاربت ناقعه % % 70(@)(@@) % أوفى به في رداء الحلم لابسه % % وعله بلبان الحرب راضعه % % PageV01P163 71(@)(@@) % من أشرقت بسجاياه مقاوله % % وأعرقت في مساعيه تبابعه % % 72(@)(@@) % وقلدته تجيب حلي سابقها % % حتى غدا السابق المتبوع تابعه % % 73(@)(@@) % واحتاز إرث الألى آووا وهم نصروا % % باسم يصدقه فعل يضارعه % % 74(@)(@@) % فإن تضايقت الدنيا بمغترب % % فمنذر بعد رحب الصدر واسعه % % 75(@)(@@) % وإن دجا فلق يوما بذي أمل % % فذو الرياسات طلق الليل ناصعه % % 76(@)(@@) % ومن سواه لمقطوع أواصره % % ومن سواه لمردود شوافعه % % 77(@)(@@) % ومن سواه لخطب جل فادحه % % ومن سواه لخرق قل راقعه % % 78(@)(@@) % ومن يسيم نداه في خزائنه % % كأنه في أعاديه وقائعه % % 79(@)(@@) % واستودع الله للإسلام في يده % % مكارما حفظت فيها ودائعه % % 80(@)(@@) % يا واصلا بالندى ما الله واصله % % وقاطعا بالظبى ما الله قاطعه % % PageV01P164 81(@)(@@) % اسعد بفخر وفطر أنت حاصده % % من بر فتح وصوم أنت زارعه % % 82(@)(@@) % ومشهد للمصلى قد طلعت له % % كالبدر مشرقة منه مطالعه % % 83(@)(@@) % في جيش عز ونصر أنت غرته % % وشمل دين ودنيا أنت جامعه % % 84(@)(@@) % معظم القدر في الأبصار باهره % % وخافض الطرف للرحمن خاشعه % % 85(@)(@@) % وموقف لك في الداعين رفعه % % إلى السموات رائيه وسامعه % % 86(@)(@@) % بك استهل به فصل الخطاب وما % % أسر ساجده الداعي وراكعه % % 87(@)(@@) % وسلموا من صلاة العيد وافتتحوا % % إليك أزكى سلام شاع شائعه % % 88(@)(@@) % جمعا يؤم إليك القصر مستبقا % % الحمد قائده والحمد وازعه % % 89(@)(@@) % حيث المكارم مرفوع معالمها % % ونير الدين معمور شرائعه % % 90(@)(@@) % وتالد الملك محفوظ بخاتمه % % من طينة المجد والرحمن طابعه % % PageV01P165 91(@)(@@) % واسلم لهم ولمن أوفى به أمل % % فات المنايا إلى يمناك نازعه % % 92(@)(@@) % يعلو الجبال بأمثال الجبال أسى % % يحدوه جد عثور الجد ظالعه % % 93(@)(@@) % ورب لجة بحر 
ms54	 تحت بحر دجى % % قاسى إلى بحرك الطامي ينابعه % % 94(@)(@@) % ومن شمائلك المعيي بدائعها % % في الأرض جاءتك تستملي بدائعه % % 95(@)(@@) % فلا تواضع قدر أنت رافعه % % ولا ترفع قدر أنت واضعه % % PageV01P166 البحر : بسيط تام 1(@)(@@) % سعي شفى بالمنى قبل انتها أمده % % ويوم سعد أرانا الفتح قبل غده % % 2(@)(@@) % بمقدم والقنا ملء الفضاء به % % وقادم وعتاد الشرك ملء يده % % 3(@)(@@) % داع إلى دعوة الإسلام ينصرها % % فأي معتمد من شأو معتمده % % 4(@)(@@) % وكم فؤاد وكم جسم وكم بصر % % لباه من قربه سعيا ومن بعده % % 5(@)(@@) % جمعا غدا الحاجب الميمون قائده % % والنصر والصبر والإيمان من مدده % % 6(@)(@@) % لمثلها كنت يا منصور والده % % ومثلها سيريك الله في ولده % % 7(@)(@@) % أنجبته وسط روض الملك تظأره % % بواسق للعلا تهتز في ثأده % % 8(@)(@@) % أثمارها من جنى الجانين دانية % % وورد زهرتها قد راق في نضده % % 9(@)(@@) % فأرضعته ثدي الحرب في كلل % % من القنا فوق مهد من شبا قصده % % 10(@)(@@) % حيث تلاقت نواصي الخيل واعتنقت % % صدور غيظ يذوب الصخر من وقده % % PageV01P167 11(@)(@@) % سرى لأمرك لا ليل بواجده % % على الحشايا ولا نجم بمفتقده % % 12(@)(@@) % مجهزا في سبيل الله جيش هدى % % السمع والطوع للمنصور من عدده % % 13(@)(@@) % لمن بنى قبة العليا ندى ووغى % % فأصبح الملك مرفوعا على عمده % % 14(@)(@@) % مورث الملك من عليا تبابعه % % والسيف من عمره والسيب من أدده % % 15(@)(@@) % والنصر من سعي أعمام له فطروا % % لنصر ذي العرش في بدر وفي أحده % % 16(@)(@@) % مشددا عقد الإسلام إن نكثت % % ولا تحل خطوب الدهر من عقده % % 17(@)(@@) % وقائد الخيل مزجاة مجهزة % % للحرب من صبره فيها ومن جلده % % 18(@)(@@) % هاد هواديها والليل معتكر % % بهدي من أرشد الإسلام في رشده % % 19(@)(@@) % كم بين ليلك يا منصور تركضها % % وليل مرتكض في لهوه ودده % % 20(@)(@@) % ما صبح مصطبح في روضة أنف % % من صبح من ينعم الإسلام في كبده % % PageV01P168 21(@)(@@) % سار إلى غرة الأعداء يطلبها % % إذا تقلب ساهي العيش في رغده % % 22(@)(@@) % مسهدا في سبيل الله يكلأه % % رب أنام عيون الدين في سهده % % 23(@)(@@) % موف على كتدي طاوي 
ms55	 الحزون به % % والملك والدين والدنيا على كتده % % 24(@)(@@) % تقصر الريح عن مسرى كتائبه % % كما تقاصرت الأملاك عن أمده % % 25(@)(@@) % بحور جدواه في الافاق زاخرة % % وقد يزاحم هيم الطير في ثمده % % 26(@)(@@) % شراب أنقع أجواز الفلاة إذا % % ما كان شرب دم الأعداء من صدده % % 27(@)(@@) % حتى يئود القنا في كل معركة % % أودا يقيم قناة الدين من أوده % % 28(@)(@@) % وينهب الموت أرواح الكماة كما % % يبيح في السلم جدواه لمنتقده % % 29(@)(@@) % حيث يعل أديم القرن من دمه % % ويحتبي جسد الجبار في جسده % % 30(@)(@@) % وتلحظ الشمس من أثناء هبوته % % كما يغضغض جفن العين من رمده % % PageV01P169 31(@)(@@) % لا يبعد الجود من يوم الجلاد ولا % % يغيب يوم نداه يوم مجتلده % % 32(@)(@@) % كأنه من دم الأعداء في حرج % % فإن يمت ذو سلاح من يديه يده % % 33(@)(@@) % ومغنفوه لديه أولياء دم % % نداه ذو عقله فيهم وذو قوده % % 34(@)(@@) % مساعيا كتبت في اللوح واكتتبت % % فينا بسعي ابن يحيى واعتلاء يده % % 35(@)(@@) % يخطها بصدور الخط منصلتا % % في كل صدر حليف الكفر معتقده % % 36(@)(@@) % وينثني في صفاح العجم يعجمها % % بصفحتي كل ماضي الغرب متقده % % 37(@)(@@) % والملك ينسخها في أم مفخره % % والدهر يقرأها في منتهى أبده % % 38(@)(@@) % راع الملوك فمخنوق بجرته % % يهيم في الأرض أولاج إلى سنده % % 39(@)(@@) % فتلك نفس ابن شنج لا مآل لها % % من ميتة السيف أو عيش على نكده % % 40(@)(@@) % ما يرتقي شرفا إلا رفعت له % % وجها من روح مرفوعا على رصده % % PageV01P170 41(@)(@@) % ولا انتحى بلدا إلا قرنت به % % هما يبهمه عن منتحى بلده % % 42(@)(@@) % وقد توجس من يمناك بمرقة % % في عارض الطير من برده % % 43(@)(@@) % جيشا إذا آد متن الأرض تعدله % % بحلم أروع الحلم متئده % % 44(@)(@@) % كالبحر تنسجه ريح الصبا حبكه % % إذ ترقرق في من زرده % % 45(@)(@@) % بحر سفائنه غر مسومة % % والبيض والرايات من زبده % % 46(@)(@@) % وجاحم من حريق لا خمود له % % إلا ونفس وضج وسط مفتأده % % 47(@)(@@) % كتائبا تركت عباد ملته % % لا تعرف الأيام من أحده % % 48(@)(@@) % إن ضاق عن مرها رحب الفضاء فقد % % نفأت من فيها 
ms56	 إلى كبده % % 49(@)(@@) % فتت منها قواصي بنبلونته % % هدم في عضده % % 50(@)(@@) % وقدت منها مطاياه موقرة % % كل رضيع قدر أو ولده % % PageV01P171 51(@)(@@) % سما لهم رهج المنصور فانقلبوا % % نجلا جلاه النار عن شهده % % 52(@)(@@) % وراح كل منيع من معاقبهم % % خلا الأسد من أسده % % 53(@)(@@) % يرمي إلى الخيل والأبطال مفتديا % % بكل الذعر في غيده % % 54(@)(@@) % ثم اتقى أعين النظار ينقدها % % من عينه كالحصى عدا ومن نقده % % 55(@)(@@) % فرب ذي قنص زرق حبائله % % قد صاد ظبيا وكان الليث من طرده % % 56(@)(@@) % وقد تركت ابن شنج فل معترك % % إن لم يمت من ظباه مات من كمده % % 57(@)(@@) % مشردا في قواصي البيد مغتربا % % وقد ملأت فجاج الأرض من خرده % % 58(@)(@@) % وفرذلند رددت الملك في يده % % وما رجا غير رد الروح في جسده % % 59(@)(@@) % شبل دعاك لأسد فوقه لبد % % فأقشعت عنه والأظفار في لبده % % 60(@)(@@) % وطار نحوك سبحا في مدامعه % % وقد تزود ملء الصدر من زؤده % % PageV01P172 61(@)(@@) % ثم انثنى وملوك الشرك أعبده % % إذ جاء عبد يد ألقى لها بيده % % 62(@)(@@) % وآب منصور قحطان بعزته % % أوبا تذوب ملوك الأرض من حسده % % 63(@)(@@) % فالله ينقص من أعدائه أبدا % % ويستزيد من الإسلام في عدده % % PageV01P173 البحر : كامل تام 1(@)(@@) % عمرت بطول بقائك الأعمار % % وجرت برفعة قدرك الأقدار % % 2(@)(@@) % ودنت لك الدنيا بقاصية المنى % % وتخيرت لك فوق ما تختار % % 3(@)(@@) % فإذا النجوم تطلعت لك أسعدا % % بدر البدور بهن والأقمار % % 4(@)(@@) % وإذا زجرت ليمن يومك طائرا % % حشرت إليك بيمنها الأطيار % % 5(@)(@@) % وإذا المنى بدأتك غرس رياضها % % حيتك في أغصانها الأثمار % % 6(@)(@@) % سبقا كما سبقت فعالك كلما % % أعيت به الأوهام والأفكار % % 7(@)(@@) % وتجليا للدارعين تصيدها % % بطيور خيلك والعقول تطار % % 8(@)(@@) % بشمائل مشمولة بمكارم % % ما للخطائر عندها أخطار % % 9(@)(@@) % ومعالم لندى يديك وإنها % % سرج إليك لحائر ومنار % % 10(@)(@@) % فإذا عوان المجد رد خطيبها % % فلك الأيامى منه والأبكار % % PageV01P174 11(@)(@@) % وإذا الحروب تساجلت أيامها % % فقتيل سيفك في الملوك جبار % % 12(@)(@@) % ولقد عضضت على الخطوب بناجذ % % للدهر منه سكينة ووقار % % 13(@)(@@) % لكن شمائل في الندى وكلتها % % بعفاة جودك 
ms57	 فتية أغمار % % 14(@)(@@) % ما البحر في الأرض العريضة بعدما % % فاضت عليها من نداك بحار % % 15(@)(@@) % أو ما غناء المسك في الدنيا وقد % % ملئت بطيب ثنائك الأمصار % % 16(@)(@@) % فيه تأنقت الحدائق وازدهى % % زهر الربى وتفتح النوار % % 17(@)(@@) % وتنافحت بنسيمها ريح الصبا % % وتفاوحت برياضها الأسحار % % 18(@)(@@) % وتعاطت الندماء كأس مدامها % % وسرت بها الركبان والسمار % % 19(@)(@@) % فكأن للدنيا بحمدك ألسنا % % تصغي لها الآفاق والأقطار % % 20(@)(@@) % وكأنما الأيام فيك مدائح % % نظمت كما نظمت لك الأشعار % % PageV01P175 21(@)(@@) % والله جارك كم أجرت عباده % % من كل خطب ليس منه جار % % 22(@)(@@) % وضربت عنهم كل جبار عتا % % فحباك بيضة ملكه الجبار % % 23(@)(@@) % في جحفل كالليل جرار له % % من عز نصرك جحفل جرار % % 24(@)(@@) % أمددت فيه بالملائكة التي % % نصرت بها أعمامك الأنصار % % 25(@)(@@) % وكسوت فيه الشمس برد عجاجة % % للموت تحت ظلامها إسفار % % 26(@)(@@) % والجو يحمى والدماء سواكب % % والأرض ريا والسماء غبار % % 27(@)(@@) % والمقفرات سوابق وخوافق % % والشاهقات أسنة وشفار % % 28(@)(@@) % كل رفعت صدورهن لغارة % % ما إن لها قبل الصدور مغار % % 29(@)(@@) % وقد ادرعت لها سوابق عزمة % % البر والتقوى لهن شعار % % 30(@)(@@) % بهرت فهن على ابن يحيى في الوغى % % نور له وعلى ابن شنج نار % % PageV01P176 31(@)(@@) % تحمى فيودعها جوانح صدره % % كي لا تبينه لك النظار % % 32(@)(@@) % أسد حطمت سلاحه فتركته % % بالبيد لا ظفر ولا أظفار % % 33(@)(@@) % رهنا بإلقاء اليدين لقاهر % % أعلى يديه الواحد القهار % % 34(@)(@@) % ملك كأنك يا محاسن فعله % % من سيئات زمانك استغفار % % 35(@)(@@) % خصت به سبأ وعم بنصره % % عليا قريش في الهدى ونزار % % 36(@)(@@) % ربذ القداح من الرماح وماله % % إلا السباع وطيرها أيسار % % 37(@)(@@) % ونديم بيض الهند يوم دم العدى % % خمر له والمأثرات خمار % % 38(@)(@@) % آيات نصر في الورى بسيوفها % % أمن الهداة وآمن الكفار % % 39(@)(@@) % جاهرت حر بلادهم بجهادهم % % حتى غدوا وهم لها أسرار % % 40(@)(@@) % وسريت حتى ظن من صبحته % % أن الظلام على سراك نهار % % PageV01P177 41(@)(@@) % ولكم أطارهم لسيفك بارق % % حتى دعوتهم إليك فطاروا % % 42(@)(@@) % وجنحت للسلم التي جنحوا لها % % وقضاء ربك في العباد خيار % % 43(@)(@@) % فأتوك مستبقين قد 
ms58	 قرب المدى % % منهم إليك وذلل المضمار % % 44(@)(@@) % ودنا ابن رذمير يزلزل خطوه % % أمل تقسم نفسه وحذار % % 45(@)(@@) % فؤاده من ذعر سيفك طائر % % طورا ومن عجل إليك مطار % % 46(@)(@@) % وتقبل أيقن فرذلند ما له % % إلا إليك من الحمام فرار % % 47(@)(@@) % كل يخر لأخمصيك وطالما % % ساموك في رهج الخميس فخاروا % % 48(@)(@@) % فهناك أخلصت النفوس وأكدت % % عقد العهود وشدت الأنصارأ % % 49(@)(@@) % وتواصل البعداء منك بطاعة % % وصلت بها الأرحام والأصهار % % 50(@)(@@) % فعقدت في عنق الضلال مواثقا % % دانت بها الرهبان والأحبار % % PageV01P178 51(@)(@@) % وكأنما كانت عقود تمائم % % سكنت بها الأوجال والأذعار % % 52(@)(@@) % أحييت منها ملك رذمير وقد % % مشت الدهور عليه والأعصار % % 53(@)(@@) % وأقمت تاج جبينه من بعدما % % عفت المعالم منه والآثار % % 54(@)(@@) % وبسطت من قشتلة يد آمن % % لرضاك فيها يارق وسوار % % 55(@)(@@) % ثم انثنوا يبأون منك بطاعة % % رفعوا بها أعلامهم وأناروا % % 56(@)(@@) % ولهم بذكرك في العداة تبجح % % وبقبل كفك في البلاد فخار % % 57(@)(@@) % ورفعت أجياد الجياد لأوبة % % رفعت لها الآمال والأبصار % % 58(@)(@@) % فكأنما البشرى بذلك عندنا % % كأس علينا بالسرور تدار % % 59(@)(@@) % والأرض أرضك كلها لك روضة % % أنف وأنت سماؤها المدرار % % 60(@)(@@) % حتى قدمت وما تقلب ناظر % % إلا له بقدومك استبشار % % PageV01P179 61(@)(@@) % حر المكارم حق قدرك أن ترى % % وعبيدك السادات والأحرار % % 62(@)(@@) % ومجاهدا في الله حق جهاده % % والله أبصر فيك ما يختار % % 63(@)(@@) % واسأل بضيفك كيف بعدك حاله % % وقد اقتضته بعد دار دار % % 64(@)(@@) % غدرت به أيام عام قد وفى % % أن الوفاء بعهده غدار % % 65(@)(@@) % ودنا به أجل الرحيل كأنه % % أجل الممات دنا به المقدار % % 66(@)(@@) % عام كعمر الوصل ليلة زائر % % وأسى تقاصر دونه الأعمار % % 67(@)(@@) % طالت لياليه الزمان بهمه % % وكأنهن من السرور قصار % % 68(@)(@@) % بمشرد قلق الثواء بمنزل % % لا ينثني فيه له الزوار % % 69(@)(@@) % مثواي فيه تقلقل وتأهب % % وقراي فيه ذلة وصغار % % 70(@)(@@) % وحساب أيام كأن متاعها % % نوم على وجل البيات غرار % % PageV01P180 71(@)(@@) % وطلاب مأوى قبل حين أوانه % % فالدهر أجمعه لي استنفار % % 72(@)(@@) % لله من عام جرى عني به % % جري الأهلة فيه والأقمار % % 73(@)(@@) % في أهل 
ms59	 دار كالكواكب والنوى % % بعد النوى فلك بهم دوارب % % 74(@)(@@) % كانوا جمالا للزمان فأصبحوا % % وهم عليه بالتغرب عار % % 75(@)(@@) % تنبو الديار بهم وتلك ديارهم % % غرض المصائب ما بها ديار % % 76(@)(@@) % قد أقفروا وطن الأنيس وأنست % % بهم مفاوز بالفلا وقفار % % 77(@)(@@) % يتأوهون إذا رمت أوهامهم % % دارا لساكنها بها استقرار % % 78(@)(@@) % ويهيجهم عين لهن مرابض % % ويشوقهم طير لها أوكار % % 79(@)(@@) % وإليك يا منصور حطوا أرحلا % % لعبت بهن تنائف وبحار % % 80(@)(@@) % فزعا إليك من الجلاء بأوجه % % في كل عام للجلاء تثار % % PageV01P181 81(@)(@@) % ورأوا بقربك أنهم قتلوا النوى % % فاستحييت ولها عليهم ثار % % 82(@)(@@) % قد طيرت غربان كل مغرب % % وغرابهم للبين ليس يطار % % 83(@)(@@) % جرة عليك وما رأت من قبلها % % خطبا له فيمن أضفت خيار % % 84(@)(@@) % وعلى الليالي منك عهد ثابت % % ألا يباح لمن حميت ذمار % % 85(@)(@@) % والله قد أعلى محلك أن ترى % % مكشوفة في سترك الأستار % % 86(@)(@@) % وحباك بالملك الذي لو شئت لم % % تضق القصور بنا ولا الأحيار % % 87(@)(@@) % وأجار قدرك أن يسوغ لقائل % % جار الزمان وأنت منه جار % % 88(@)(@@) % ولحق من أبقى ثناءك في الورى % % أن تستقر به لديك الدار % % PageV01P182 البحر : طويل 1(@)(@@) % لعل سنا البرق الذي أنا شائم % % يهيم من الدنيا بمن أنا هائم % % 2(@)(@@) % أما في حشاه من جواي مخايل % % أما في ذراه من جفوني مياسم % % 3(@)(@@) % لقد برحت منه ضلوع خوافق % % وقد صرحت منه دموع سواجم % % 4(@)(@@) % ونفح صبا يهفوا على جنباته % % كتصعيد أنفاسي إذا لام لائم % % 5(@)(@@) % وتحنان دعد صادع لمتونه % % كما زفرت نفسي بمن أنا كاتم % % 6(@)(@@) % وميض تشب الريح والرعد ناره % % كما شب نيران المجوس الزمازم % % 7(@)(@@) % حميل بحمل الراسيات إلى الذي % % تحملني عنه القلاص الرواسم % % 8(@)(@@) % وما أنجدت فيه النجود تصبري % % ولا اتهمت وجدي عليه التهائم أ % % 9(@)(@@) % سوى لوعة لو يغلب الصبر نارها % % لشامني البرق الذي أنا شائم % % 10(@)(@@) % فإن يسق من أهوى فدمعي مسعد % % وإن يلقه دوني فأنفي راغم % % PageV01P183 11(@)(@@) % كفاني التماح الشمس والبدر وجهه % % وما اقتبست منه النجوم العواتم % % 12(@)(@@) % وما تجتني من طيب 
ms60	 أردانه الصبا % % ومن ورد خديه الرياض النواعم % % 13(@)(@@) % فلهفي على قرن من الشمس ساطع % % تجلله كسف من الليل فاحم % % 14(@)(@@) % إذا زارني أعشى جفون رقيبه % % وأخرس عني ما تقول اللوائم % % 15(@)(@@) % وآذن أنفاسي ونفسي بنشره % % ورياه أنفاس الرياح النواسم % % 16(@)(@@) % وبشرني من قبله صوت حليه % % تجاوبه فوق الغصون الحمائم % % 17(@)(@@) % إلى ملتقى قلبين ضم عليهما % % جوانحه جنح من الليل عاتم % % 18(@)(@@) % ومعتنق كالجفن أطبق نائما % % على ضم إنسانين والدهر نائم % % 19(@)(@@) % فبتنا وقاضي الوصل يحكم في الهوى % % وغانم قلبي بالحكومة غارم % % 20(@)(@@) % أمص من الكافور مسكا وأجتني % % من الوشي رمانا زهته المقادم % % PageV01P184 21(@)(@@) % ويرجع روح النفس ما أنا ناشق % % ويجبر صدع القلب ما أنا لازم % % 22(@)(@@) % وأرشف من حصباء در وجوهر % % رحيق مدام سكره بي دائم % % 23(@)(@@) % وفي كبدي حر من الشوق لاعج % % وفي عضدي غصن من البان ناعم % % 24(@)(@@) % يقر هواه أنه لي قاتل % % وقلبي له من جفوة الشوق راحم % % 25(@)(@@) % أجنب أنفاسي أزاهر حسنه % % لعلمي أن النور بالنار ناهم % % 26(@)(@@) % وأغمض لحظي عن جنى وجناته % % مخافة أن السهم للورد جاهم % % 27(@)(@@) % وما صرع القتلى كعينيه صارع % % ولا كلم الجرى كصدغيه كالم % % 28(@)(@@) % فإن أشف وجدي من تباريح ظلمه % % بضمي له أيقنت أني ظالم % % 29(@)(@@) % وإن أحي نفسي فيه من ميتة الهوى % % بلثمي له لم أعد أني آثم % % 30(@)(@@) % فكيف وقد غارت به أنجم النوى % % وقيد دون الماء حران هائم % % PageV01P185 31(@)(@@) % متاع من الدنيا أراني فراقه % % بعين النهى والحلم أني حالم % % 32(@)(@@) % وقد صرمته حادثات كأنها % % بيمناك يا منصور بيض صوارم % % 33(@)(@@) % يضرمها أمثالهن كتائب % % يقدمها أشباههن عزائم ب % % 34(@)(@@) % أسنتها للمهتدين كواكب % % وأعلامها للمسلمين معالم % % 35(@)(@@) % وآثارها في الأرض أشلاء كافر % % وغاو وفي جو السماء غمائم % % 36(@)(@@) % وفي كبد الطاغوت منها صوارع % % وفي فقر الشيطان منها قواصم % % 37(@)(@@) % بكل تجيبي إليك انتسابه % % وإن أنجيته تغلب والأراقم % % 38(@)(@@) % ومختار يمناك العلية نسبة % % وان سفرت يربوع عنها ودارم % % 39(@)(@@) % وأذهلهم جدواك عن كل مفخر % % وإن فخرت ذهل بها واللهازم % % 40 