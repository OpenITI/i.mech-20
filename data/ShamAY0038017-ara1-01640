ms1621	(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن البلخي(@)(@@) يروي عن ابن المبارك ومطرف بن مازن والحجازيين، روى عنه محمد بن عبد الوهاب الفراء وأهل بلده، وقال أحمد بن سيار: هو محمد بن الحسن بن محمد الليثي، وكان أبوه علي بمرو أيام ابن المبارك، وقال: رأيته ببلخ، وكان ثبتا في الحديث محمود السيرة، كنيته أبو الحسن.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر الدوسي الرومي(@)(@@) يروي عن شعبة بن الحجاج، روى عنه أبو قلابة الرقاشي.(@)(@@)(@@)(@@) ||| AUTO محمد بن نصر بن الحسين بن عثمان بن بشر بن المحتفز، كنيته أبو علي(@)(@@) شيخ، مروزي، قال: سمعت ابن المبارك، يقول: خراسان ليست بدار عاقل فإن كان لابد فمرو، روى عنه أحمد بن مصعب المروزي، وقال: كان يعرف هذا الشيخ بأخي أبي شداد.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن سعيد القطان(@)(@@) مولى بني تميم، كنيته أبو صالح، من أهل البصرة، يروي عن ابن عيينة وأبيه، حدثنا عنه أبو يعلى، مات في رمضان سنة ثلاث وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى(@)(@@) من أهل الكوفة، يروي عن وكيع وأبيه وأهل الكوفة، روى عنه عثمان بن سعيد الدارمي والناس.(@)(@@)(@@)(@@) ||| AUTO محمد بن الصلت أبو يعلى التوزي(@)(@@) من أهل البصرة، من توز من فارس، يروي عن ابن عيينة والدراوردي، حدثنا عنه الفضل بن حبان الجمحي، مات سنة ثمان وعشرين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 445](@)(@@)(@@)(@@) ||| AUTO محمد بن بكير بن واصل الحضرمي(@)(@@) من أهل بغداد، يروي عن ابن عيينة وابن وهب، روى عنه أحمد بن منصور الرمادي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سهل بن حصين الباهلي(@)(@@) يروي عن الفضل بن سليمان النميري، روى عنه عبد الله بن أحمد بن إبراهيم الدورقي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن ميمون التبان(@)(@@) من أهل المدينة، يروي عن محمد بن جعفر بن أبي كثير، روى عنه محمد بن سليمان بن هارون المصري، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد الكلبي(@)(@@) يروي عن صالح بن عبد الرحمن بن مسور بن مخرمة، روى عنه محمد بن يحيى الأزدي، يخطئ ويهم.(@)(@@)(@@)(@@) ||| AUTO 
ms1622	 محمد بن عمر الثوري(@)(@@) من أهل البصرة، يروي عن ابن فضيل، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الوهاب الحارثي(@)(@@) من أهل بغداد، يروي عن محمد بن مسلم الطائفي، حدثنا عنه عبد الله بن محمد البغوي، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن حدير بن العباس بن رمل السكسكي(@)(@@) كان يسكن ببيت لهيا بدمشق، يروي عن الوليد بن مسلم، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو السويقي(@)(@@) من أهل بلخ، يروي عن عبد العزيز بن محمد الدراوردي وأهل العراق، روى عنه أبو عبد الرحيم الجوزجاني وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن عباد بن جبلة بن أبي رواد العتكي(@)(@@) من أهل PageV01P002 [ج 5: ص 446] البصرة، يروي عن حماد بن زيد والبصريين، ثنا عنه الحسن بن سفيان، يغرب، ويخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى الشيباني(@)(@@) يروي عن خلف بن خليفة، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن القاسم الحراني، لقبه سحيم(@)(@@) يروي عن زهير بن معاوية، حدثنا عنه عمرو بن سعيد بن سنان الطائي بمنبج، مات سنة ثلاث أو أربع وثلاثين ومائتين قبل أبي جعفر النفيلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف الغضيضي(@)(@@) من أهل بغداد، يروي عن ابن عيينة، وكان راويا لابن وهب، حدثنا عنه أبو يعلى الموصلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن فضيل، أبو عبد الله(@)(@@) يروي عن عثمان بن اليمان، روى عنه يعقوب بن سفيان الفارسي، وقال: كتبت عنه بمكة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله الأزدي(@)(@@) من أهل البصرة، يروي عن عاصم بن هلال وعبد الوهاب بن عطاء، حدثنا عنه الحسن بن سفيان وأبو يعلى الموصلي، ربما خالف، وكان من الحفاظ.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلمة بن مالك الباهلي(@)(@@) يروي عن الدراوردي وأهل المدينة، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد بن فروة البلدي(@)(@@) يروي عن ابن شهاب الخياط، روى عنه محمد بن طاهر البلدي وأهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حسان السهمي(@)(@@) يروي عن الفضيل بن عياض والناس، حدثنا عنه عبد الله بن محمد بن عبد العزيز البغوي، مات سنة ثمان وعشرين 
ms1623	 ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 447](@)(@@)(@@)(@@) ||| AUTO محمد بن المنهال الضرير، أبو عبد الله البصري(@)(@@) يروي عن يزيد بن زريع، حدثنا عنه الحسن بن سفيان وغيره، مات سنة إحدى وثلاثين ومائتين بالبصرة ليلة الأحد لسبع خلون من شعبان سمعت أبا يعلى يقوله.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن نمير، أبو عبد الرحمن الهمداني(@)(@@) من أهل الكوفة، يروي عن أبيه وأبي معاوية، حدثنا عنه شيوخنا أبو يعلى وغيره، مات في شعبان سنة أربع وثلاثين ومائتين، وكان من الحفاظ المتقنين وأهل الورع في الدين.(@)(@@)(@@)(@@) ||| AUTO محمد بن خلاد الإسكندراني(@)(@@) يروي عن ضمام بن إسماعيل، روى عنه يعقوب بن سفيان الفارسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن ضبارة الحضرمي(@)(@@) من أهل الشام، يروي عن الشاميين، روى عنه سليمان بن عبد الحميد البهراني أبو أيوب.(@)(@@)(@@)(@@) ||| AUTO محمد بن الفضيل بن عياض أبو عبيدة(@)(@@) يروي عن بشر بن السري وأهل الحجاز، روى عنه الناس.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي بكر بن علي بن عطاء بن مقدم المقدمي، أبو عبد الله(@)(@@) مولى ثقيف، ابن أخي عمر بن علي المقدمي، يروي عن حماد بن زيد والبصريين، ثنا عنه الحسن بن سفيان وأبو يعلى، مات في أول سنة أربع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحارث الهاشمي، أبو عبد الله(@)(@@) مؤذن مسجد جامع مصر، يعرف PageV01P002 [ج 5: ص 448] بصدرة، يروي عن ابن لهيعة ويحيى بن راشد، حدثنا عنه الحسن بن سفيان، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن عيسى بن أبي سمينة البصري(@)(@@) قدم بغداد وحدث بها ثم خرج إلى الثغر عازما، ومات بها، يروي عن المعتمر بن سليمان والبصريين، حدثنا عنه أبو يعلى وغيره ومن أصحابنا، من زعم أنهما اثنان بغدادي وبصري فقد وهم، لأنه من أهل البصرة حدث ببغداد، والقائل بهذا نظر فيما حدث ببغداد وفيما حدث بالبصرة فتوهم أنهما اثنان وليس كذلك، مات سنة ثلاثين ومائتين، كنيته أبو عبد الله.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن أبي سمينة بغدادي(@)(@@) يروي عن هشيم، روى عنه الحضرمي وليس هذا بالأول.(@)(@@)(@@)(@@) ||| AUTO محمد بن حاتم بن ميمون البغدادي المؤدب، 
ms1624	 أبو عبد الله(@)(@@) يروي عن ابن إبراهيم بن سعد والعراقيين، روى عنه محمد بن إسماعيل، مات في ذي الحجة سنة خمس أو ست وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن خلاد بن كثير الباهلي، أبو بكر البصري(@)(@@) يروي عن ابن عيينة، حدثنا عنه الحسن بن سفيان وغيره، مات سنة تسع وثلاثين ومائتين.(@)(@@) (679) -[5: 448] سمعت الحسن بن سفيان، يقول: سمعت أبا بكر الأعين، يقول: سمعت مسددا، يقول: أبو بكر بن خلاد الباهلي ثقة ولكنه صلف.(@)(@@)(@@)(@@) ||| AUTO محمد بن مقاتل العباداني(@)(@@) يروي عن حماد بن سلمة، روى عنه أهل العراق.(@)(@@) (680) -[5: 448] سمعت محمد بن علي القطان بتستر، يقول: سمعت مصلح بن الفضل الأسدي، يقول: سمعت محمد بن مقاتل العباداني، يقول: سمعت حماد بن سلمة، يقول: سمعت PageV01P002 [ج 5: ص 449] أيوب السختياني، يقول: من أحب أبا بكر فقد أقام الدين، ومن أحب عمر فقد أوضح السبيل، ومن أحب عثمان فقد استنار بنور الله، ومن أحب عليا فقد استمسك بالعروة الوثقى، ومن أحسن القول في أصحاب رسول الله صلى الله عليه وسلم فقد بريء من النفاق.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن سهم الأنطاكي(@)(@@) يروي عن ابن المبارك وأبي إسحاق الفزاري، حدثنا عنه عمرو بن سعيد بن سنان وغيره من شيوخنا، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبان بن عمران الواسطي أبو عبد الله وقد قيل أبو الحسن(@)(@@) يروي عن حماد بن سلمة وأبي عوانة، حدثنا عنه أبو يعلى وغيره، ربما أخطأ، مات سنة ثمان وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعقوب بن أبي عبيدة، أبو عبد الرحمن العنبري(@)(@@) من أهل البصرة، يروي عن أبي عاصم، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن بكار بن الريان، أبو عبد الله البغدادي(@)(@@) مولى بني هاشم، يروي عن هشيم، حدثنا عنه شيوخنا السجستاني والسراج وغيرهما، مات سنة ثمان وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن المتوكل بن أبي السري العسقلاني(@)(@@) يروي عن ابن عيينة والمعتمر بن سليمان، حدثنا عنه ابن قتيبة وغيره، مات سنة ثمان وثلاثين ومائتين، وكان من الحفاظ.(@)PageV01P002(@)(@@) [ج 5: ص 450](@)(@@)(@@)(@@) ||| AUTO محمد بن 
ms1625	 إسماعيل الجعفري(@)(@@) من أهل المدينة، يروي عن الدراوردي وأهل الحجاز، روى عنه أحمد بن سعيد الدارمي والناس، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيدة بن مسلم المروزي(@)(@@) يروي الحكايات عن المراوزة والعراقيين، روى عنه عبد الله بن عبد الرحمن الدارمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين البرجلاني(@)(@@) من أهل بغداد، يروي عن أبي عاصم وأبي نعيم، حدثنا عنه أبو يعلى الموصلي، كان صاحب رقائق وحكايات.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر المعيطي(@)(@@) من أهل بغداد، كان من الحفاظ، كتب عن بقية وأهل العراق، روى عنه أحمد بن حبان بن ملاعب والبغداديون، يغرب، مات سنة ثنتين وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن حساب الزهراني(@)(@@) بصري، يروي عن حماد بن زيد، حدثنا عنه الحسن بن سفيان وأبو يعلى.(@)(@@)(@@)(@@) ||| AUTO محمد بن الفرج، أبو جعفر(@)(@@) يروي عن همام الأهوازي، حدثنا عنه أبو يعلى، وليس هذا محمد بن الفرج الأزرق الذي يروي عن الزبيدي، وهما جميعا بغداديان.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق الباهلي(@)(@@) يروي عن عبد الرحمن بن زيد بن أسلم، روى عنه عبد الله بن محمد بن عبيد القرشي.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر بن أبي هاشم الوركاني، أبو عمران(@)(@@) من أهل بغداد، يروي عن عيسى بن يونس، روى عنه أهل العراق، مات سنة ثمان وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد، أبو جعفر المقرئ(@)(@@) من أهل البصرة، يروي عن أبي بكر بن عياش، روى عنه يعقوب بن سفيان.(@)PageV01P002(@)(@@) [ج 5: ص 451](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي سلمة بن فرقد، أبو عبد الله(@)(@@) مولى بني مخزوم، يروي عن محمد بن عبيد المدني.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق بن محمد بن عبد الله بن المسيب المسيبي(@)(@@) من أهل بغداد، يروي عن يزيد بن هارون والناس، حدثنا عنه أحمد بن الحسن بن عبد الجبار الصوفي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن عبد الله الطحان(@)(@@) من أهل واسط، يروي عن أبيه وإبراهيم بن سعد، حدثنا عنه عبد الله بن قحطبة وغيره من شيوخنا، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن حاتم الزمي(@)(@@) سكن بغداد، يروي عن ابن عيينة والناس، 
ms1626	 روى عنه أهل العراق.(@)(@@) (681) -[5: 451] حدثنا ابن الباغندي، ثنا محمد بن حاتم الزمي، ثنا علي بن ثابت، قال: سألت مالك بن أنس عن قول الناس يوم العيد تقبل الله منا ومنك، فقال: ما زال ذلك الأمر عندنا ما نرى به بأسا.(@)(@@)(@@)(@@) ||| AUTO محمد بن منيب العدني(@)(@@) يروي عن السري بن يحيى، روى عنه عبد بن حميد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عون بن أبي عون الزيادي(@)(@@) مولى لآل زياد بن أبي سفيان، بصري، يروي عن محمد بن ذكوان، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباد المكي، أبو عبد الله(@)(@@) سكن بغداد، يروي عن ابن عيينة وحاتم بن إسماعيل، حدثنا عنه شيوخنا أبو يعلى وغيره، توفي في آخر ذي الحجة سنة أربع وثلاثين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 452](@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن عباد بن جبلة بن أبي رواد الباهلي(@)(@@) من أهل البصرة، يروي عن محمد بن مروان العقيلي، حدثنا عنه الحسن بن سفيان، يغرب ويخالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن داود(@)(@@) من أهل مرو، من أصحاب ابن المبارك.(@)(@@) (682) -[5: 452] سمعت محمد بن محمود بن علي، يقول: سمعت أحمد بن مصعب، يقول: سمعت محمد بن داود، يقول: لما جاء نعي سفيان ونحن عند عبد الله بن المبارك، فقال عبد الله بن المبارك: يرحمه الله لم يكن تحت أديم السماء على عهد سفيان من هو أعلم بالسنة منه.(@)(@@)(@@)(@@) ||| AUTO محمد بن حاتم حي الجرجاني(@)(@@) يروي عن أبي معاوية وابن عيينة، روى عنه أهل العراق، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله العنبري(@)(@@) ابن أخي سوار بن عبد الله، من أهل البصرة، يروي عن جعفر بن سليمان الضبعي والفضيل بن عياض الحكايات، روى عنه محمد بن داود بن أبي ناجية الإسكندراني.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن أبي خلف القطيعي، أبو عبد الله البغدادي(@)(@@) يروي عن حصين بن عمر الأحمسي وإسحاق الأزرق، حدثنا عنه شيوخنا السجستاني وغيره، ربما أخطأ، ومات سنة سبع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن المكي(@)(@@) من أهل مرو، يروي عن ابن المبارك، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO 
ms1627	 محمد بن عبد الله العمري، أبو عبد الله الساكب(@)(@@) يروي عن إبراهيم بن صرمة، روى عنه زكريا بن يحيى السجزي خياط السنة.(@)(@@)(@@)(@@) ||| AUTO محمد بن النوشجان البغدادي السويدي(@)(@@) يروي عن يحيى بن سليم وسويد بن عبد العزيز، روى عنه أهل العراق، وقد كتب عنه أحمد بن حنبل.(@)PageV01P002(@)(@@) [ج 5: ص 453](@)(@@)(@@)(@@) ||| AUTO محمد بن طريف بن خليفة البجلي(@)(@@) من أهل الكوفة، يروي عن ابن إدريس والكوفيين، حدثنا عنه الحسن بن سفيان وغيره، وقد قيل: محمد بن طريف بن علقمة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص القطان، أبو عبد الرحمن(@)(@@) من أهل البصرة، يروي عن أبي عامر العقدي والبصريين، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي أيوب(@)(@@) من أهل جنديسابور، يروي عن عبيد الله بن سفيان، روى عنه الجنديسابوريون.(@)(@@)(@@)(@@) ||| AUTO محمد بن النصر بن مساور المروزي(@)(@@) يروي عن الفضيل بن عياض، حدثنا عنه محمد بن عبد الله بن الجنيد وغيره، مات سنة تسع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن شابور الرقي(@)(@@) يروي عن ابن حازم وعبد الحميد بن سليمان، حدثنا عنه الحسين بن عبد الله القطان بالرقة وغيره من شيوخنا، مات سنة بضع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن الجراح الغزي، أبو عبد الله(@)(@@) يروي عن مالك بن أنس، حدثنا عنه محمد بن الحسن بن قتيبة اللخمي بعسقلان.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن العباس بن رملي السكسكي(@)(@@) من أهل دمشق، كان ينزل بيت لبيد، يروي عن الوليد وأهل الشام، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن خنيس الغزي(@)(@@) يروي عن سفيان بن عيينة، حدثنا عنه الحسن بن سفيان وابن قتيبة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز القسطلي(@)(@@) يروي عن الوليد بن محمد، قال: قلت PageV01P002 [ج 5: ص 454] للموقري: صف لي الزهري، فقال: كان قصيرا أعمش له جمة وفصاحة، قال: قلت له يوما: يا أبا بكر لا أعرف لك عيبا إلا كثرة الدين، قال: وما علي من الدين أربعون ألف دينار ولى أربع أعين كل عين خير من أربعين ألف دينار، ولا 
ms1628	 يرثني إلا ابن ابن، وددت أني إذا مت لا يرثني درهما.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهران الجمال، أبو جعفر الرازي(@)(@@) يروي عن ابن عيينة ومحمد بن سلمة، حدثنا عنه شيوخنا محمد بن إسحاق بن إبراهيم مولى ثقيف وغيره، مات سنة تسع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان(@)(@@) من أهل البصرة، يروي عن زياد بن عبد الله، روى عنه البصريون.(@)(@@) (683) -[5: 454] حدثني عمرو بن حفص البزاز بجنديسابور، ثنا محمد بن زياد الزيادي، حدثني خالي محمد بن عثمان، ثنا زياد بن عبد الله بن الربيع، عن حميد، عن أنس بن مالك، أن النبي صلى الله عليه وسلم: صلى الضحى ست ركعات(@)(@@)(@@)(@@) ||| AUTO محمد بن عبدة المرادي اليمامي، أبو يوسف(@)(@@) يروي عن الجراح بن مليح، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن عبد ربه القصري، أبو يحيى(@)(@@) من أهل مرو، يروي عن عبس بن عياز وأهل بلده، حدثنا عنه إسحاق بن إبراهيم القاضي وعبد الله بن محمود السعدي وغيرهما.(@)(@@)(@@)(@@) ||| AUTO محمد بن آدم المصيصي(@)(@@) يروي عن أبي خالد الأحمر وأهل العراق، حدثنا عنه محمد بن سفيان الصفار بالمصيصة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو الجعفي(@)(@@) من أهل مصر، يروي عن ضمام بن إسماعيل، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن المنذر، أبو المنذر(@)(@@) من أهل هراة، يروي عن عبد الله بن نمير وأهل العراق والحجاز، روى عنه أهل بلده، يخطئ أحيانا.(@)PageV01P002(@)(@@) [ج 5: ص 455](@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن خالد، أبو مروان العثماني القرشي(@)(@@) يروي عن إبراهيم بن سعد، حدثنا عنه شيوخنا محمد بن أحمد بن أبي عون وغيره، مات بمكة في آخر سنة أربعين ومائتين أو أول سنة إحدى وأربعين ومائتين، يخطئ ويخالف، وهو محمد بن عثمان بن خالد بن عمر بن عبد الله بن الوليد بن عثمان بن عفان.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن بن أبي عتاب، أبو بكر الأعين(@)(@@) واسم أبي عتاب طريف، من أهل بغداد، يروي عن يزيد بن هارون، حدثنا عنه شيوخنا، مات ببغداد يوم الثلاثاء الثلاثة عشرة بقين من جمادى 
ms1629	 الآخرة سنة أربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن ميمون(@)(@@) مؤذن مسجد الرملة، أبو عبد الله، يروي عن أبيه والشاميين، روى عنه يعقوب بن سفيان الفارسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز بن أبي رزمة، أبو عمرو المروزي(@)(@@) مولى بني يشكر، واسم أبي رزمة غزوان، يروي عن أبي أسامة والفضل بن موسى وأهل بلده، حدثنا عنه إسحاق بن إبراهيم القاضي وغيره، مات سنة أربعين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن أبي رجاء الهاشم، أبو سليمان(@)(@@) يروي عن ابن أبي الزناد، حدثنا عنه الحسن بن سفيان وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص القطان(@)(@@) يروي عن سلم بن قتيبة وأبي عاصم، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي داود البغدادي(@)(@@) (684) -[5: 455] يروي عن حماد بن زيد، عن أيوب، عن محمد بن جابر، عن قيس بن طلق، عن أبيه، عن النبي صلى الله عليه وسلم في مس الذكر: إنما هو بضعة منك، حدثناه أبو قريش محمد بن جمعة، ثنا إبراهيم بن أحمد بن نعيس، حدثنا محمد بن أبي داود PageV01P002 [ج 5: ص 456](@)(@@)(@@)(@@) ||| AUTO محمد بن عامر بن رشيد بن خباب الرملي، أبو عبد الله(@)(@@) شيخ، يروي عن ابن عيينة، ثنا عنه شيوخنا، لم أر في حديثه مما في القلب منه شيء إلا حديثا واحدا.(@)(@@) (685) -[5: 456] حدثناه يحيى بن محمد بن عمرو بالفسطاط، ثنا محمد بن عامر الرملي، ثنا سفيان بن عيينة، عن الزهري، عن سالم بن عبد الله، عن أبيه: أن النبي صلى الله عليه وسلم وأبا بكر وعمر كانوا يقرءونهاف مالك يوم الدينق(@)(@@)(@@)(@@) ||| AUTO محمد بن تسنيم الحضرمي، أبو الطاهر(@)(@@) من أهل الكوفة، يروي عن أبي نعيم وعبيد الله، روى عنه يعقوب بن سفيان وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن نصير، أبو عبد الرحمن الحارثي العابدي(@)(@@) من أهل الكوفة، يروي عن وكيع، روى عنه البخاري محمد بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن السلمي، أبو عبد الله الناعمي(@)(@@) من أهل الرملة، يروي عن بقية بن الوليد، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد 
ms1630	 بن إبراهيم الأسباطي(@)(@@) من أهل العراق، سكن مصر، يروي عن عبد السلام بن حرب، روى عنه صالح بن محمد البغدادي جزرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن، أبو عبد الله العنبري(@)(@@) من أهل البصرة، يروي عن حاتم بن وردان وابن أبي عدي، حدثنا عنه عبدان الجواليقي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن جامع بن خنيس العطار(@)(@@) من أهل البصرة، كنيته أبو عبد الله، يروي عن عبد الوارث بن سعيد والبصريين، حدثنا عنه أبو خليفة وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن رمح بن المهاجر التجيبي(@)(@@) من أهل مصر، يروي عن ابن سعد وابن لهيعة، حدثنا عنه محمد بن زياد بن التجيبي وغيره من شيوخنا، مات سنة ثلاث وأربعين ومائتين، كنيته أبو عبد الله.(@)PageV01P002(@)(@@) [ج 5: ص 457](@)(@@)(@@)(@@) ||| AUTO محمد بن جميل(@)(@@) يروي عن الفضيل بن عياض، روى عنه أحمد بن يحيى الصوفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن دينار الحمصي(@)(@@) يروي عن هشيم، روى عنه ربيعة بن الحارث.(@)(@@)(@@)(@@) ||| AUTO محمد بن النضر بن نصر بن سيار المروزي(@)(@@) يروي عن ابن عيينة ويزيد بن زريع وابن أبي عدي، حدثنا عنه عبد الله بن محمود السعدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أسلم بن سالم الطوسي، أبو الحسن الكندي الزاهد(@)(@@) يروي عن يزيد بن هارون، حدثنا عنه شيوخنا ابن خزيمة وغيره، مات سنة اثنتين وأربعين ومائتين، وكان من العباد الخشن المتجردين للعبادة المواظبين على إقامة السنة، ممن بذل مجهوده في استعمال السنن ورفض الدنيا بأسرها حتى كان يعظ الناس بروية دون علمه وشهد دون نطقه.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن بحر العقيلي، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن أبي عاصم وعبد الأعلى والبصريين، حدثنا عنه عبدان بعسكر مكرم، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن العلاف(@)(@@) من أهل البصرة، يروي عن محمد بن سواء وأبي عاصم، حدثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن أبي عمر العدني، أبو عبد الله(@)(@@) سكن مكة، يروي عن ابن عيينة، حدثنا عنه شيوخنا إسحاق بن إبراهيم بن إسماعيل وغيره، مات بمكة لإحدى عشرة ليلة بقيت من ذي 
ms1631	 الحجة سنة ثلاث وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن قدامة بن إسماعيل المروزي، أبو عبد الله(@)(@@) يروي عن يزيد بن هارون، حدثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن معاوية الزيادي(@)(@@) من أهل البصرة، يروي عن أبي عاصم وأهل PageV01P002 [ج 5: ص 458] العراق، ثنا عنه بكير بن محمد بن عبد الوهاب الفراء، وكان صاحب الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي يعقوب الكرماني(@)(@@) واسم أبي يعقوب إسحاق، يروي عن ابن أبي عدي وحسان بن إبراهيم، روى عنه أهل بلده، مات سنة أربع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن عبد الرحمن بن مهران(@)(@@) مولى كلب، من أهل حران، كنيته أبو حفص، يروي عن أهل الجزيرة، روى عنه أهلها، مات سنة خمس وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن مهدي الأيلي(@)(@@) أخو الحسين بن مهدي، كنيته أبو عبد الله، يروي عن أبي عاصم وعبد الرزاق، حدثنا عنه إسحاق بن إبراهيم وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن حماد الأبيوردي(@)(@@) يروي عن ابن عيينة وأبي ضمرة، حدثنا عنه محمد بن أحمد بن أبي عون والناس، مات سنة ثمان أو تسع وأربعين ومائتين، كنيته أبو عبد الله.(@)(@@)(@@)(@@) ||| AUTO محمد بن ... مضارب الباهلي(@)(@@) يروي عن أبي إسحاق الفزاري، روى عنه أبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن عبد الملك الأسدي(@)(@@) من همدان، يروي عن الربيع بن زياد الطائي ويزيد بن هارون، حدثنا عنه علي بن أحمد بن سعيد وغيره بهمدان، مات آخر سنة ثلاث أو أول سنة أربع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن فياض الزماني(@)(@@) يروي عن أبي عاصم والأنصاري، حدثنا عنه المواصلة وأهل الشام.(@)PageV01P002(@)(@@) [ج 5: ص 459](@)(@@)(@@)(@@) ||| AUTO محمد بن الرومي(@)(@@) يروي عن علي بن مسهر والعراقيين، روى عنه محمد بن إسماعيل الجعفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن ميمون المدني(@)(@@) يروي عن عيسى بن يونس ومحمد بن سلمة الحراني، روى عنه محمد بن إسماعيل البخاري.(@)(@@)(@@)(@@) ||| AUTO محمد بن المنهال(@)(@@) أخو الحجاج بن المنهال الأنماطي، يروي عن يزيد بن زريع وأهل البصرة، حدثنا عنه سليمان بن الحسن المعدل بالبصرة وغيره من شيوخنا. 
ms1632	(@)(@@)(@@)(@@) ||| AUTO محمد بن عقبة السدوسي(@)(@@) من أهل البصرة، كنيته أبو عبد الله، يروي عن ابن عيينة وجرير بن عبد الحميد، حدثنا عنه الحسن بن سفيان وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن المصفي بن بهلول الحمصي، أبو عبد الله(@)(@@) يروي عن ابن عيينة والناس، سمعت ابن فضيل، يقول: عادلته من حمص إلى مكة سنة ست وأربعين ومائتين فاعتل بالجحفة ودخلنا مكة وهو لما به، ومات بمنى، فدخل أصحاب الحديث عليه وهو في النزع فقرءوا عليه حديث ابن جريج، عن مالك وحديث ابن حرب، عن عبيد الله بن عمر، فما عقل مما قرئ عليه شيئا ثم مات، وكان يخطئ.(@)(@@) (686) -[5: 459] سمعت مكحولا، يقول: سمعت هارون بن عوف، يقول: رأيت محمد بن المصفى في النوم، وكان مات بمكة، فقلت: يا أبا عبد الله أليس قد مت؟ إلى ما صرت؟ قال: إلى خير، ومع ذلك فنحن نرى ربنا في كل يوم مرتين، فقلت: يا أبا عبد الله صاحب سنة في الدنيا وصاحب سنة في الآخرة! قال: فتبسم إلي PageV01P002 [ج 5: ص 460](@)(@@)(@@)(@@) ||| AUTO محمد بن إياس(@)(@@) شيخ، يروي عن حماد بن زيد، روى عنه آدم بن أبي إياس(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر بن عون(@)(@@) يروي عن أبيه، روى عنه محمد بن الحسين البرجلاني وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن أبي سكينة الحلبي(@)(@@) يروي عن هشيم وأبي يوسف، حدثنا عنه عمرو بن سنان وابن ابنته يحيى بن علي بن هاشم بحلب، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلام التيمي(@)(@@) يروي عن عيسى بن يونس، حدثنا عنه الفضل بن محمد العطار الباهلي، ربما أغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن حبيب الأسدي، أبو جعفر البغدادي، الذي يقال له: لوين(@)(@@) يروي عن حماد بن زيد وأهل العراق، حدثنا عنه إبراهيم بن إسحاق الأنماطي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحارث بن محمد الحراني، أبو عبد الله الليثي البزاز(@)(@@) يروي عن محمد بن سلمة وأهل بلده، حدثنا عنه أبو عروبة، مات سنة ثلاث وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن أبي الشوارب القرشي، أبو عبد 
ms1633	 الله البصري(@)(@@) يروي عن أبي عوانة، حدثنا عنه شيوخنا الحسين بن إدريس الأنصاري وغيره، مات سنة ثلاث وأربعين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 461](@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد الأنصاري، أبو إسحاق(@)(@@) من أهل حران، يروي عن أبي نعيم والكوفيين، حدثنا عنه أبو عروبة، مات سنة أربع أو خمس وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن رافع بن أبي زيد القشيري، أبو عبد الله النيسابوري(@)(@@) يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه شيوخنا، مات سنة خمس وأربعين ومائتين، وكان تقيا فاضلا.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبان البلخي، أبو بكر المستملي(@)(@@) يروي عن ابن عيينة ووكيع، روى عنه أهل بلده، مات سنة خمس وأربعين ومائتين، وكان حسن المناكرة ممن جمع وصنف، وكان مستملي وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO محمد بن زيد بن علي بن زيد بن دينار(@)(@@) مولى النخع، كنيته أبو جعفر، يروي عن ابن عيينة وأهل الجزيرة، روى عنه أهلها، مات في آخر ليلة من رجب سنة أربع وثلاثين ومائتين، وأبو أسامة جده اسمه علي بن يزيد، وقد قيل: إنه علي بن زيد بن الأصم ابن أخي يزيد بن الأصم.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن عبد الحميد بن يحيى بن سعيد القرشي، كنيته أبو بكر(@)(@@) من أهل الجزيرة، يروي عن أهلها والغرباء، مات يوم الثلاثاء لست خلت من صفر سنة اثنتين وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد(@)(@@) أخو كرخويه، من أهل بغداد، يروي عن أبي عاصم والناس، حدثنا عنه أبو يعلى.(@)(@@)(@@)(@@) ||| AUTO محمد بن الصباح الجرجاني، أبو جعفر(@)(@@) يروي عن هشيم PageV01P002 [ج 5: ص 462] وابن عيينة، حدثنا عنه شيوخنا عبد الله بن قحطبة وغيره، مات سنة أربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن الحسن العصار، أبو عبد الله(@)(@@) من أهل جرجان، يروي عن عبيد الله بن موسى وعبد الرزاق، حدثنا عنه شيوخنا عمران بن موسى السختياني وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن فضيل البغدادي(@)(@@) شيخ، مستقيم الحديث.(@)(@@) (687) -[5: 462] يروي عن وكيع، قال: حدثنا حماد بن سلمة، عن أبي غالب، عن أبي أمامة، قال: جاء رجل إلى النبي صلى الله 
ms1634	 عليه وسلم فسأله، فقال: يا نبي الله أي الجهاد أفضل؟ قال: كلمة الحق عند سلطان جائر. حدثنا عمران بن موسى السختياني، ثنا محمد بن فضيل البغدادي، ثنا وكيع(@)(@@)(@@)(@@) ||| AUTO أبو حمة اسمه محمد بن يوسف الزبيدي(@)(@@) من أهل اليمن، يروي عن ابن عيينة وكان راويا لأبي قرة، حدثنا عنه المفضل بن محمد الجندي وغيره، ربما أخطأ وأغرب، كنيته أبو يوسف، وأبو حمة لقب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الأعلى الصنعاني، أبو عبد الله(@)(@@) يروي عن المعتمر بن سليمان، حدثنا عنه شيوخنا عمر بن محمد الهمداني وغيره، مات سنة خمس وأربعين ومائتين بالبصرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباد بن عباد المهلبي الأزدي(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه نصر بن علي الجهضمي وابنه القاسم بن محمد.(@)(@@)(@@)(@@) ||| AUTO محمد بن أحمد بن محمد بن الحجاج القرشي الكريزي، أبو يوسف ابن الصيدلاني(@)(@@) من أهل الرقة، يروي عن ابن عيينة، حدثنا عنه شيوخنا أبو عروبة وغيرهم، مات بالرقة لخمس بقين من المحرم سنة ست وأربعين ومائتين، وكان جده مولى عبد الله بن عامر بن كريز.(@)PageV01P002(@)(@@) [ج 5: ص 463](@)(@@)(@@)(@@) ||| AUTO محمد بن تقيد العائشي(@)(@@) بصري، يروي عن الصعق بن حزن، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة الأصبهاني(@)(@@) يروي عن النعمان بن عبد السلام وأبي عاصم، روى عنه أسيد بن عاصم.(@)(@@)(@@)(@@) ||| AUTO محمد بن نافع المصري(@)(@@) يروي عن عبد الله بن المغيرة عن مسعر بن كدام بصحيفة، روى عنه إبراهيم بن عبد السلام الوراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن وهب بن عمر بن أبي كريمة الحراني، أبو المعافي(@)(@@) يروي عن محمد بن مسلمة وعتاب بن بشير، حدثنا عنه أبو عروبة وغيره، مات بكفر جديا قرية بحران في شهر رمضان سنة ثلاث وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن العلاء بن كريب، أبو كريب الهمداني(@)(@@) من أهل الكوفة، يروي عن ابن المبارك والكوفيين، حدثنا عنه شيوخنا أبو جعفر بن أحمد بن سنان القطان وغيره، مات يوم الثلاثاء لأربع بقين من جمادى الآخرة سنة ثمان وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن داود 
ms1635	 بن أبي ناجية، أبو عبد الله المهري(@)(@@) من أهل الإسكندرية، يروي عن سفيان بن عيينة وزياد بن يونس، حدثنا عنه عمر بن محمد الهمداني، مستقيم الحديث، مات سنة خمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن حرب بن مقاتل(@)(@@) من أهل مرو، يروي عن عبيد الله بن موسى ويحيى بن آدم، مستقيم الحديث، حدثنا عنه عبد الله بن محمود السعدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن أبي حزم القطعي، أبو عبد الله(@)(@@) ابن أخي حزم بن أبي حزم، من أهل البصرة، يروي عن عمه حزم عن الحسن، حدثنا عنه إسحاق بن إبراهيم وغيره.(@)PageV01P002(@)(@@) [ج 5: ص 464](@)(@@)(@@)(@@) ||| AUTO محمد بن سفيان العامري(@)(@@) من أهل مصر، يروي عن بكر بن مصر والليث بن سعد، روى عنه أبو جعفر الترمذي المتفقه الذي كان ببغداد.(@)(@@)(@@)(@@) ||| AUTO محمد بن نمير المدني(@)(@@) يروي عن أبي نعيم ويعقوب بن إبراهيم بن سعد، روى عنه محمد بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن صدران السليمي، أبو جعفر(@)(@@) من أهل البصرة، يروي عن المعتمر بن سليمان والبصريين، حدثنا عنه محمد بن يزيد الدمشقي بطرسوس وغيره من مشايخنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي معشر، واسمه نجيح السندي(@)(@@) يروي عن أبيه، حدثنا عنه أحمد بن عبد الله الدقاق ببغداد وغيره، يعتبر حديثه إذا يروي عن غير أبيه لأن أباه ضعيف.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص الهروي(@)(@@) شيخ، يروي عن حماد بن زيد، حدثنا عنه محمد بن معاذ وغيره، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عون، أبو بكر البغدادي(@)(@@) واسم أبي عون محمد، يروي عن أبي عاصم وأبي قطن، روى عنه محمد بن إسماعيل، مات سنة تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن مرداس، أبو عبد الله الأنصاري(@)(@@) من أهل البصرة، يروي عن عبد الوهاب وعبد الله بن عيسى الجزار، ثنا عنه عمر بن محمد الهمداني، مستقيم الحديث، مات سنة تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن المغيرة بن بسام الشهرزوري(@)(@@) سكن أذنة، يروي عن إسحاق الأزرق ويزيد بن هارون، حدثنا عنه عمرو بن سنان وغيره من شيوخنا، ربما أخطأ، يعتبر حديثه إذا 
ms1636	 روى عن الثقات.(@)PageV01P002(@)(@@) [ج 5: ص 465](@)(@@)(@@)(@@) ||| AUTO أبو تميلة اسمه محمد بن عبد ربه بن سليمان المروزي(@)(@@) يروي عن الفضيل بن عياض، حدثنا عنه محمد بن أحمد بن أبي عون وغيره، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن حماد البيوردي(@)(@@) شيخ، يروي عن سفيان بن عيينة ويحيى القطان، مات سنة ثمان أو تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن العباس الباهلي(@)(@@) من أهل البصرة، يروي عن ابن عيينة، حدثنا عنه الحسن بن عبد الله القطان وغيره، كنيته أبو بكر، مات سنة تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن ضريس، أبو جعفر(@)(@@) من أهل الكوفة، سكن فيه، يروي عن ابن فضيل وابن عيينة والكوفيين، حدثنا عنه أحمد بن محمد بن عبد الرحمن الشامي وغيره من شيوخنا، مات سنة تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن زنبور، أبو عبد الله(@)(@@) من أهل مكة، يروي عن الفضيل بن عياض، حدثنا عنه محمد بن الحسين السعدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن حاتم بن بزيع، أبو سعيد، وقيل: أبو عبد الله البغدادي المؤدب(@)(@@) يروي عن يزيد بن هارون وأهل العراق، روى عنه أهل بلده، مات في رمضان سنة تسع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبيد بن محمد بن المحاربي(@)(@@) من أهل الكوفة، كنيته أبو جعفر النحاس، يروي عن وكيع وعبد الله بن الأجلح، حدثنا عنه محمد بن إسحاق الثقفي وغيره من شيوخنا، مات سنة خمس وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى الحرشي، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن يزيد بن زريع والبصريين، حدثنا عنه زكريا بن يحيى الساجي وغيره.(@)PageV01P002(@)(@@) [ج 5: ص 466](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن بزيع، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن بشر بن المفضل وابن أبي عدي، ثنا عنه محمد بن الحسين بن مكرم البزاز وغيره من شيوخنا، مات سنة خمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن علي بن عطاء بن مقدم المقدمي(@)(@@) من أهل البصرة، يروي عن أبيه والبصريين، ثنا عنه محمد بن إسحاق بن خزيمة وغيره من شيوخنا، مات سنة 
ms1637	 خمسين ومائتين، أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن بزيع، أبو عبد الله القومسي(@)(@@) يروي عن يزيد بن هارون، روى عنه العراقيون، مات في شهر رمضان سنة خمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعقوب الزبيري(@)(@@) من أهل المدينة، يروي عن أبي ضمرة وأهل الحجاز، حدثنا عنه عمر بن محمد الهمداني، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل ابن علية(@)(@@) كان على قضاء دمشق، يروي عن أبي عاصم وأهل العراق، حدثنا عنه أحمد بن عمير بن جوصاء، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد بن رفاعة بن سماعة، أبو هشام الرفاعي(@)(@@) من أهل الكوفة، يروي عن أبي بكر بن عياش، روى عنه أهل العراق، مات ببغداد يوم الأربعاء سلخ شعبان سنة ثمان وأربعين ومائتين، وكان يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن هشام بن أبي خيرة السدوسي، أبو عبد الله(@)(@@) من أهل البصرة، حدث بمصر، يروي عن ابن أبي عدي والبصريين، حدثنا عنه محمد بن المعافى وغيره، مات سنة خمسين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن حبيب الجارودي(@)(@@) يروي عن أبي حازم، حدثنا عنه عبد الله بن محمد البغوي.(@)PageV01P002(@)(@@) [ج 5: ص 467](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن خالد القطان الأجدب(@)(@@) من أهل طرسوس، يروي عن عبد الرحمن بن مغراء وأهل العراق، حدثنا عنه ابن قتيبة، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن الحسن بن شقيق، أبو عبد الله المروزي(@)(@@) يروي عن أبيه، حدثنا عنه شيوخنا، مات سنة خمسين ومائتين، وقد كتب عن أبي نعيم.(@)(@@)(@@)(@@) ||| AUTO محمد بن شوكر البغدادي(@)(@@) عن أبي نعيم وأبي عاصم، حدثنا عنه شيوخنا.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر، أبو عبد الله الكوفي(@)(@@) سكن فيه، يروي عن فضيل ويزيد بن هارون، حدثنا عنه محمد بن إسحاق بن سعيد السعدي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن شجاع المروروذي(@)(@@) سكن بغداد، يروي عن هشيم، حدثنا عنه شيوخنا، مات سنة أربع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن قدامة بن أعين الجوهري(@)(@@) من أهل المصيصة، يروي عن جرير بن عبد الحميد، حدثنا عنه محمد بن 
ms1638	 سفيان الصفار وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن علي بن حمزة المروزي(@)(@@) يروي عن عبيد الله بن موسى وأهل العراق، حدثنا عنه أحمد بن جعفر بن نصر الكمال وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن بشار بن داود بن كيسان، أبو بكر العبدي(@)(@@) من PageV01P002 [ج 5: ص 468] أهل البصرة، الذي يقال له: بندار، وإنما قيل له بندار لأنه جمع حديث أهل بلده، يروي عن عبد الوهاب والبصريين، حدثنا عنه شيوخنا، مات في رجب سنة اثنتين وخمسين ومائتين، وكان ممن يحفظ حديثه ويقرؤه من حفظه، وكان مولده سنة سبع وستين ومائة في السنة التي مات فيها حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO محمد بن المثنى بن عبيد بن قيس، أبو موسى الزمن العنزي(@)(@@) من أهل البصرة، يروي عن غندر والبصريين، حدثنا عنه شيوخنا، وكان صاحب كتاب لا يحدث إلا من كتابه، مات في ذي القعدة سنة اثنتين وخمسين ومائتين، وكان مولده ومولد بندار في سنة واحدة.(@)(@@)(@@)(@@) ||| AUTO محمد بن ازدانية الدهقان(@)(@@) يروي عن أبي بكر بن عياش، روى عنه الحضرمي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن معاوية بن عبد الرحمن الزيادي(@)(@@) يروي عن أبي عاصم وأهل البصرة، حدثنا عنه الطبري.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمارة بن صبيح الكوفي(@)(@@) يروي عن وكيع، حدثنا عنه أحمد بن محمد بن عبد الكريم الوزان بجرجان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو الرازي، المعروف بزنيج، كنيته أبو غسان(@)(@@) يروي عن جرير وحكام بن سلم، حدثنا عنه محمد بن إسحاق الثقفي وغيره، مات سنة أربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن سماعة الرملي(@)(@@) يروي عن سفيان بن عيينة، حدثنا عنه PageV01P002 [ج 5: ص 469] محمد بن عبيد الله بن الفضل الكلاعي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن بن تسنيم(@)(@@) يروي عن أبي عاصم وكان راويا للحجاج بن محمد، حدثنا عنه محمد بن الحسين بن مكرم، مستقيم الحديث، يغرب، عداده في الكوفيين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن خالويه النجار(@)(@@) من أهل الرقة، يروي عن خالد بن حيان وسعيد بن مسلمة وأهل الجزيرة، حدثنا عنه الحسن بن سفيان وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله 
ms1639	 بن عمار بن سوادة الغامدي(@)(@@) من أهل الموصل، يروي عن عبيد الله بن موسى وأهل العراق، حدثنا عنه الحسين بن إدريس والمواصلة.(@)(@@)(@@)(@@) ||| AUTO محمد بن معدان بن عيسى الحراني، أبو عبد الله(@)(@@) يروي عن عتاب بن بشير، حدثنا عنه أبو عروبة، مات في ذي الحجة سنة اثنتين وخمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن خداش الزهراني(@)(@@) من أهل البصرة، سكن ببغداد، يروي عن الأنصاري وأهل العراق، حدثنا عنه ابن خزيمة، ربما أغرب عن أبيه.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن إبراهيم بن المغيرة الجعفي البخاري، أبو عبد الله(@)(@@) يروي عن عبيد الله بن موسى وأبي عاصم والمكي بن إبراهيم، مات ليلة عيد الفطر سنة ست وخمسين ومائتين، وقبره بخرتنك على فرسخين من سمرقند، ودفن من الغد يوم الفطر يوم السبت، وكان من خيار الناس ممن جمع وصنف ورحل وحفظ وذاكر وحث عليه، وكثرت عنايته بالأخبار وحفظه للآثار مع علمه بالتاريخ ومعرفة أيام الناس ولزوم الورع الخفي والعبادة الدائمة إلى أن مات رحمه الله.(@)PageV01P002(@)(@@) [ج 5: ص 470](@)(@@)(@@)(@@) ||| AUTO محمد بن زياد بن الربيع بن عبيد الله الزيادي(@)(@@) من أهل البصرة، يروي عن فضيل بن عياض، حدثنا عنه إسحاق بن أحمد بن حسان الواسطي وغيره من شيوخنا، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي صفوان الثقفي(@)(@@) من أهل البصرة، يروي عن يحيى القطان وابن مهدي، حدثنا عنه ابن خزيمة وغيره من شيوخنا، مات سنة خمسين ومائتين أو قبلها أو بعدها بقليل، واسم أبي صفوان عثمان بن عمر بن صفوان.(@)(@@)(@@)(@@) ||| AUTO محمد بن أيوب، أبو هريرة الصيرفي(@)(@@) من أهل البصرة، يروي عن يزيد بن هارون وأبي عاصم، حدثنا عنه إسحاق بن إبراهيم القاضي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباد بن آدم(@)(@@) من أهل البصرة، يروي عن أبي عاصم وسهل بن يوسف، حدثنا عنه ابن الطهراني، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباد بن موسى العكلي، أبو جعفر(@)(@@) من أهل بغداد، يروي عن ابن عيينة والحجازيين، حدثنا عنه محمد بن إبراهيم الفارسي، يخطئ أحيانا.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد المستملي، أبو 
ms1640	 بكر الأشلي(@)(@@) من أهل طرسوس، يروي عن أبي أسامة ويزيد بن هارون، روى عنه أهل الثغر، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى القومسي، يعرف بسياه(@)(@@) يروي عن عبيد الله بن موسى وعبد الواحد، حدثنا عنه عمران بن موسى السختياني، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن محمد بن خلاد الباهلي، أبو عمر(@)(@@) ابن أخي أبي بكر بن خلاد، من أهل البصرة، يروي عن أبي عاصم، وكان راويا لمعن بن عيسى، حدثنا عنه ابن الطهراني وغيره، يغرب.(@)PageV01P002(@)(@@) [ج 5: ص 471](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن علي الجعفي، أبو بكر(@)(@@) ابن أخي حسين بن علي الجعفي، يروي عن أبي أسامة وأهل العراق، حدثنا عنه ابن جوصاء وغيره، مستقيم الحديث، حدث بالشام الغرائب.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن فارس، أبو عبد الله الذهلي(@)(@@) من أهل نيسابور، يروي عن يزيد بن هارون وأبي عاصم، روى عنه الناس، مات سنة سبع وخمسين ومائتين، وكان متقنا من الجماعين للحديث والمواظبين عليه مع إظهار السنة وقلة المبالاة بمن خالفها.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين بن عمرو أو عبد الله(@)(@@) من أهل سجستان، يروي عن مالك بن سعير وأبي نعيم وعبيد الله بن موسى ويعلى بن عبيد وغيرهم، روى عنه أهل بلده، وكان ينزل سكة سبنك بروبنج، ومات سنة خمس وخمسين ومائتين في صفر، وكان صاحب سنة وفضل ممن صنف وجمع وأظهر السنة ببلده جهده.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر بن أبي الأزهر، أبو صالح، الذي يقال له: ابن زنبور(@)(@@) من أهل مكة، يروي عن الفضيل بن عياض، حدثنا عنه أبو عروبة وغيره من شيوخنا، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن حفص بن هشام بن زيد بن أنس بن مالك(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، حدثنا عنه ابن خزيمة.(@)(@@)(@@)(@@) ||| AUTO محمد بن معاوية بن صالح الأنماطي(@)(@@) من أهل واسط، يروي عن عباد بن العوام ويزيد بن هارون، حدثنا عنه محمد بن عمرو بن يوسف وغيره، ربما وهم.(@)PageV01P002(@)(@@) [ج 5: ص 472](@)(@@)(@@)(@@) ||| AUTO محمد بن منصور، أبو عبد الله الجواز 