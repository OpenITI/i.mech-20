ms121	 المعاوي من أضباعهم فلهم % % عز تردوا به ضافي الجلابيب % 22(@)(@@) % أبو علي له في خندف شرف % لف العلا منه موروثا بمكسوب % 23(@)(@@) % على نحور الملوك الصيد منشؤه % وفي الحجور من البيض المناجيب % 24(@)(@@) % ذو همة تركت كعبا وأسرته % بغارب في مراقي الفخر مجبوب % 25(@)(@@) % وشيمة فاح رياها كما أرجت % % خميلة وهي نشوى من شآبيب % 26(@)(@@) % فأسفرت عقب الأيام عن مثل % به وإن رغم الطائي مضروب % 27(@)(@@) % له أساليب من مجد أبر بها % % على الورى ، والعلا شتى الأساليب % 28(@)(@@) % يهتز منبره عجبا بمنطقه % ترنح الشرب من سكر وتطريب % 29(@)(@@) % وليس إن ثار في أثناء خطبته % كالمهر يخلط ألهوبا بألهوب % 30(@)(@@) % لكنه يملأ الأسماع من كلم % ضاح على صفحات الدهر مكتوب % PageV01P399 31(@)(@@) % والقارح المتمطي في علالته % يشوب في الحضر تصعيدا بتصويب % 32(@)(@@) % يابن الذين إذا ما أفضلوا غمروا % % عفاتهم بعطاء غير محسوب % 33(@)(@@) % إني بمدحك مغرى غير ملتفت % إلى ندى خضل الأنواء مطلوب % 34(@)(@@) % وكم يد لك لاتخفى أمائرها % % ما هيجت عربيا حنة النيب % 35(@)(@@) % وكيف أشكر نعماك التي هطلت % بها يمينك وطفاء الأهاضيب % 36(@)(@@) % لا زلت تلقح آمالا وتنتجها % % مواهب يمتريها كل محروب % 37(@)(@@) % وتودع الدهر من شعر أحبره % مدائحا لم توشح بالأكاذيب % PageV01P400 البحر : طويل 1(@)(@@) % ألفت الهوينى في زمان لأهله % على غير ما يرضى به المجد تحريض % 2(@)(@@) % ولو وجد ابن الغاب في الأرض ممرحا % لكان له عن خطة الضيم تقويض % 3(@)(@@) % فمن لي بيوم ترتوي فيه من دم % ردينية سمر وهندية بيض % PageV01P401 البحر : طويل 1(@)(@@) % تجنى علينا طيفها حين أرسلا % % وهل يتجنى الحب إلا ليبخلا ؟ % 2(@)(@@) % يعد ، ولم أذنب ، ذنوبا كثيرة % تلقفها من كاشح أو تمحلا % % 3(@)(@@) % ولي همة تأبى ، وللحب لوعة % أضم عليها القلب أن أتنصلا % % 4(@)(@@) % أتحسب تلك العامرية أنني % % أذل ، ويأبى المجد أن أتذللا % 5(@)(@@) % وتزعم أني رضت قلبي لسلوة % إذا لا أقال الله عثرة من سلا % % 6(@)(@@) % أما علمت أن الهوى يستفزني % % إذا الركب من نحو الجنينة أقبلا % % 7(@)(@@) % وأرتاح للبرق اليماني صبابة % وأنشق خفاق 
ms122	 النسيم تعللا % % 8(@)(@@) % حلفت لرعي الود لا لضراعة % يكلفها الحب الغوي المضللا % % 9(@)(@@) % بصعر تبارت في الأزمة شمذ % تؤم بنا فجا من الأرض مجهلا % % 10(@)(@@) % طلعن بدورا بالفلا وهي بدن % وعدن كأشباح الأهلة نحلا % % PageV01P402 11(@)(@@) % عليهن شعث من ذؤابة غالب % ضمنت لهم أن نمسح الركن أولا % 12(@)(@@) % يميل الكرى منهم عمائم لاثها % % على المجد أيد تخلف الغيث مسبلا % % 13(@)(@@) % فلسنا نرى إلا كريما يهزه % حداء سرى عنه رداء مهلهلا % % 14(@)(@@) % لئن صافحت أخرى على نأي دارها % % يميني ، فلا سلت على القرن منصلا % % 15(@)(@@) % وقلت ضياء الملة اختط عزمه % لهمته دون السماكين منزلا % % 16(@)(@@) % ولم يترك الضرغام في حومة الوغى % % جبانا ، ولا صوب الغمام مبخلا % % 17(@)(@@) % ولا اخضر واديه ، على حين لاترى % % مرادا لعيس شفها الجدب مبقلا % % 18(@)(@@) % فتى شرقت بالبشر صفحة وجهه % كأن عليها البدر حين تهللا % % 19(@)(@@) % هو الغيث يروي غلة الأرض مسبلا % % هو الليث يحمي ساحة الغاب مشبلا % % 20(@)(@@) % يلاذ به واليوم قان أديمه % ويدعى إذا ما طارق الخطب أعضلا % % PageV01P403 21(@)(@@) % له إمرة عند الملوك مطاعة % ورأي به يستقبل الأمر مشكلا % % 22(@)(@@) % كأن نجوم الأفق يتبعن أمره % فلو خالفته عاد ذو الرمح أعزلا % % 23(@)(@@) % لقى دون أدنى شأوه كل طالب % وهل غاية ضمت حبارى وأجدلا % % 24(@)(@@) % فحظ مجاريه إذا جد جده % على إثره أن يملأ العين قسطلا % % 25(@)(@@) % أتى العيد طلق المجتلى فتلقه % بوجه يروق الناظر المتأملا % % 26(@)(@@) % وضح بمن يطوي على الحقد صدره % فإنك مهما شئت ولاك مقتلا % % 27(@)(@@) % وأرع عتابا تحته الود كامن % مسامع يملأن الثناء المنخلا % % 28(@)(@@) % أرى مللا حيث التفت يهيب بي % % وما كنت أخشى أن أفارق عن قلى % % 29(@)(@@) % فلقيتني سوءا ، لقيت مسرة % وخيبت آمالي ، بقيت مؤملا % % 30(@)(@@) % أمن كذب الواشي وتكثير حاسد % إذا لم يجد قولا صحيحا تقولا % % PageV01P404 31(@)(@@) % رميت بنا مرمى الغريبة جنبت % على غلة تدمي الجوانح ، منهلا % % 32(@)(@@) % وأطمعت في أعراضنا كل كاشح % يجرعه الغيظ السمام المثملا % % 33(@)(@@) % وراءك إني لست أغرس نخلة % لأجني منها حين تثمر حنظلا % % 34(@)(@@) % أيجمل 
ms123	 أن أجفى فآتي مغضبا % وتأتي ما لا ترتضيه لنا العلا % % 35(@)(@@) % وأسهر في مدحي لغيرك ضلة % وأدعو سواك المنعم المتطولا % % 36(@)(@@) % وكل امرئ تنبو به الدار مطرق % على الهون ما لم ينو أن يتحولا % % 37(@)(@@) % وها أنا أزمعت الفراق ، وفي غد % نميل بصدر الأرحبي إلى الفلا % % 38(@)(@@) % فمن ذا الذي يهدي إليك مدائحا % كما أسلم السلك الجمان المفصلا % % 39(@)(@@) % بنثر يمج السحر طورا ، وتارة % بنظم إذا ما أحزن الشعر أسهلا % % 40(@)(@@) % فمصبحه يجلو به الفجر مبسما % وممساه تلقى عنده الشمس كلكلا % % PageV01P405 41(@)(@@) % ونعم المحامي دون مجدك مقولي % % به ألقمت قسرا أعاديك جندلا % % 42(@)(@@) % بقيت لمن يبغي نوالك ملجأ % ودمت لمن يرجو زمانك موئلا % % PageV01P406 البحر : بسيط تام 1(@)(@@) % يا صاحبي خذا للسير أهبته % فغيرنا بمناخ السوء يحتبس % 2(@)(@@) % أترقدان وفرع الصبح منتشر % عليكما وذماء الليل مختلس % 3(@)(@@) % إن تجهلا ما يناجيني الحفاظ به % فالرمح يعلم ما أبغيه والفرس % 4(@)(@@) % لله دري فكم أسمو إلى أمد % والدهر في ناظريه دونه شوس % 5(@)(@@) % أبغي علا رامها جدي فأدركها % % وكان في غمرة الهيجاء ينغمس % 6(@)(@@) % وفي يدي كلسان الأيم مرهفة % غرارها بمقيل الروح ملتبس % 7(@)(@@) % في معرك يتشكى النسر بطنته % به ، وللذئب في قتلاه منتهس % 8(@)(@@) % وذابلي من نجيع القرن مغترف % ومن لظى الحقد في جنبيه مقتبس % 9(@)(@@) % فأي أروع مني نبهت هممي % % وأي شأو من العلياء ألتمس ؟ % PageV01P407 البحر : طويل 1(@)(@@) % سل الركب يا ذواد عن آل جساس % هل ارتبعوا بعد النقيب بأوطاس % 2(@)(@@) % فإني أرى النيران تهفو فروعها % % على عذب الوادي بميثاء ميعاس % 3(@)(@@) % تنور سناها من بعيد ولا ترع % فليس على من آنس النار من باس % 4(@)(@@) % ومن موقديها غادة دونها الظبا % % تلوح بأيدي غلمة غير أنكاس % 5(@)(@@) % وكل رديني كأن سنانه % يعط رداء الليل عنهم بنبراس % 6(@)(@@) % مهفهفة غرثى الوشاحين ، دونها % % تحرش عذال ورقبة حراس % 7(@)(@@) % يضيء لها وجه يرق أديمه % فما ضرها لو رق لي قلبها القاسي % % 8(@)(@@) % وفي المرط دعص رشه الطل ، أزرت % به تحت غصن ، فوقه البدر ، مياس 
ms124	 % 9(@)(@@) % سموت لها والليل حارت نجومه % على أفق عار ، بظل الدجى كاس % 10(@)(@@) % فهبت كما ارتاع الغزال ، وأوجست % من ابن أبيها خيفة أي إيجاس % PageV01P408 11(@)(@@) % تشير إلى مهري حذار صهيله % وتستكتم الأرض الخطا خشية الناس % 12(@)(@@) % فقلت لها لا تفرقي ، وتشبثي % % بنهاس أقران ومناع أخياس % 13(@)(@@) % ترد يديه عن وشاحك عفة % وعرض صقيل لا يزن بأدناس % 14(@)(@@) % وطوقتها يمنى يدي ، وصارمي % % بيسراي ، فارتاحت قليلا لإينامي % % 15(@)(@@) % وذقت ، عفا عنا الإله وعنكم % جنى ريقة تلهي أخاكم عن الكاس % 16(@)(@@) % فلما استطار الفجر مال بعطفها % % وداعي ، كما هز الصبا قضب الآس % 17(@)(@@) % وكم عبرة بلت وشاحا ومحملا % بها زفرة أدمت مسالك أنفاسي % % 18(@)(@@) % ولاحت تباشير الصباح كأنها % % سنا المقتدي بالله في آل عباس % 19(@)(@@) % حمى بيضة الإسلام فاستحكمت به % عراه ، وقد شدت لديه بأمراس % 20(@)(@@) % يلوذ الرعايا آمنين بعزه % لياذ عتاق الطير بالجبل الراسي % % PageV01P409 21(@)(@@) % ويلحفهم ظلا من العدل وارفا % ويرعاهم بالنائل الغمر والباس % % 22(@)(@@) % إليك أمير المؤمنين رمت بنا % % علا تنتهي أعراقهن إلى الياس % 23(@)(@@) % ولما استقلت بي إلى العز همتي % % نفضت بواديك المقدس أحلاسي % % 24(@)(@@) % فأقلعت الأيام عني ، وربما % % أطلت بأنياب علي وأضراس % 25(@)(@@) % ولولاك لم أستوهب العيس هبة % على طرق تغوي الأدلاء ، أدراس % % 26(@)(@@) % طويت إلى ناديك كل مبخل % أبت شوله أن تستدر بإبساس % 27(@)(@@) % وكنت أرجي الناس قبل لقائكم % فها أنا بعت الزبرقان بشماس % PageV01P410 البحر : بسيط تام 1(@)(@@) % ضلت قبيلة راموا مساجلتي % % ولم تطأ صفحة الغبراء أمثالي % % 2(@)(@@) % وقد فضلتهم في كل مكرمة % إلا الغنى والعلا في الفضل لا المال % 3(@)(@@) % فكم تمرس بي في الفخر جاهلهم % تمرس الأجرب المهنوء بالطالي % % 4(@)(@@) % إن طوقوا نعما واللؤم مشتمل % عليهم فهي أطواق كأغلال % 5(@)(@@) % ولي أب لو أعير الناس سؤدده % لم يرغبوا الدهر في عم ولا خال % PageV01P411 البحر : كامل تام 1(@)(@@) % ومتيم زهرت بواقصة له % مشبوبة تقتاد طرف العاشي % % 2(@)(@@) % وتضيء أحور يستفز إلى الصبا % % نضو المشيب محالف الإرعاش % 3(@)(@@) % ألف الكرى لما اطمأن فراشه % وهجرته قلقا علي فراشي % % 4 
ms125	(@)(@@) % يا من يؤرقني هواه ، ومدمعي % % هطل كصوب العارض الرشاش % 5(@)(@@) % لم يثو حبك في فؤادي وحده % لكن جرى في أعظمى ومشاشى % % 6(@)(@@) % لا تحسب السر الذي استودعتني % % مما يفر حشاي عنه الواشي % % 7(@)(@@) % والشوق يحلم عنه لولا ناظر % سلب الوقار بواكف طياش % 8(@)(@@) % كالعرف يكتمه الأغر وعرفه % أرج تنم به المدائح فاش % 9(@)(@@) % نشزت عرانين العداة على البرى % % فأذلها بأزمة وخشاش % 10(@)(@@) % يجلو دياجير الأمور برأيه % والدهر أغبر ، والخطوب غواش % PageV01P412 11(@)(@@) % وتظل منه السمهرية ضيغما % قلق الصوارم مطمئن الجاش % 12(@)(@@) % وكأن حائمة النسور إذا غزا % % تأوي من القتلى إلى أعشاش % 13(@)(@@) % يا سعد إن الصل عندك مطرق % فاحذر سؤور منضنض نهاش % 14(@)(@@) % واجنب أخاك كل حادث نعمة % آنسته فجزاك بالإيحاش % 15(@)(@@) % جهل الفضيلة فهو ينكر أهلها % % والشمس تعشي ناظر الخفاش % 16(@)(@@) % ويشب نارا لا يرد زفيرها % % والليل معتكر طنين فراش % 17(@)(@@) % طارت به الخيلاء إذ جذب الغنى % % ضبعيه ، والطيران للمرتاش % 18(@)(@@) % ولقد بليت به بلاء مهند % بأبل لا ورع ولا بطاش % 19(@)(@@) % فسد الأنام فكل من صاحبته % راج ينافق أو مداج خاش % 20(@)(@@) % وإذا اختبرتهم ظفرت بباطن % متجهم ، وبظاهر نشاش % PageV01P413 21(@)(@@) % لا شمت بارقة اللئيم وإن غدت % إبلي تلوب على صرى نشاش % 22(@)(@@) % والشمس راكدة ، يذوب لعابها % % والظل يكنس تارة ويماشي % % 23(@)(@@) % وكأنهن ، وهن يألفن الصدى % % من صبرهن عليه ، غير عطاش % 24(@)(@@) % فتبرض العافي عفافة منحة % يحبو بها اللؤماء شر معاشر % 25(@)(@@) % رفع الأظل على السنام ، وأوطئت % قمم السراة أخامص الأوباش % PageV01P414 البحر : - 1(@)(@@) % الناس من خولي ، والدهر من خدمي % % وقمة النجم عندي موطىء القدم % 2(@)(@@) % وللبيان لساني ، والندى خضل % به يدي والعلا يخلقن من شيمي % % 3(@)(@@) % فأين مثل أبي في العرب قاطبة % ومن كخالي في صيابة العجم ؟ % 4(@)(@@) % والنسر يتبع سيفي حين يلحظه % والدهر ينشد ما يهمي به قلمي % % 5(@)(@@) % لو صيغت الأرض لي دون الورى ذهبا % لم ترضها لمرجي نائلي هممي % % 6(@)(@@) % وعن قليل في مأزق حرج % به تشام السريجيات في القمم % 7(@)(@@) % والبيض مردفة تبدو خلاخلها % % في مسلك 
ms126	 وحل من عبرة ودم % 8(@)(@@) % فالمجد في صهوات الخيل مطلبه % والعز في ظبة الصمصامة الخذم % PageV01P415 البحر : سريع 1(@)(@@) % سرت وجنح الليل غربيب % سرب من البيض رعابيب % 2(@)(@@) % يعثرن في ذيل الدجى إذ ضفا % % لها عليهن جلابيب % 3(@)(@@) % وكل سر رمن كتمانه % نم به الحلي أو الطيب % 4(@)(@@) % طرقننا والركب غيد الطلى % % تخدي بنا العيس المطاريب % 5(@)(@@) % ونحن بالجرعاء من عالج % حيث تطيل الحنة النيب % 6(@)(@@) % فقلن إذ أبصرنني باسما % حين زوى الأوجه تقطيب % 7(@)(@@) % أي همام منك قد رشحت % للمجد آباء مناجيب % 8(@)(@@) % فدأبه ، والصبر من خيمه % سرى يعنيه وتأويب % 9(@)(@@) % يجوب بيدا غير مقروعة % للسير فيهن الظنابيب % 10(@)(@@) % فليت شعري هل أزور الحمى % % أم هل يروع الثلة الذيب % PageV01P416 11(@)(@@) % والشمس أخبى الليل أنوارها % % والكوكب الأزهر مشبوب % 12(@)(@@) % في غلمة مرد تمطى بهم % إلى الوغى جرد سراحيب % 13(@)(@@) % خيل عراب فوق أثباجها % % في حومة الحرب أعاريب % 14(@)(@@) % من كل ملبون سليم الشظى % % حابي القصيرى ، فيه تحنيب % 15(@)(@@) % يكل وفد الريح إن هز من % عطفيه إرخاء وتقريب % 16(@)(@@) % وكل يوم من قراع العدا % % لبانه بالدم مخضوب % 17(@)(@@) % يعدو بمرهوب الشذا ، يتقى % % به الردى ، والبأس مرهوب % 18(@)(@@) % في فتية تسحب سمر القنا % % بحيث ذيل النقع مسحوب % 19(@)(@@) % مد قوام الدين أبواعهم % إلى العلا ، والعز مطلوب % 20(@)(@@) % أروع ينميه أب ماجد % إليهما السؤدد منسوب % PageV01P417 21(@)(@@) % مقتبل السن ، عقيد النهى % تقصر عن غايته الشيب % 22(@)(@@) % والملك لا يحمل أعباءه % من لم تهذبه التجاريب % 23(@)(@@) % واحتوشته نوب للفتى % % فيهن تصعيد وتصويب % 24(@)(@@) % غمر الندى ، لم يحتضن سمعه % في جوده عذل وتأنيب % 25(@)(@@) % موطأ الأكناف ، أبوابه % لهن بالزائر ترحيب % 26(@)(@@) % فلا القرى نزر ، ولا المجتلى % % جهم ، ولا النائل محسوب % 27(@)(@@) % كالزهر المطلول أخلاقه % والروض مشمول ومجنوب % 28(@)(@@) % وهو غمام خضل ، فالحيا % % منتظر منه ومرقوب % 29(@)(@@) % شيد ما أثل من مجده % والمجد موروث ومكسوب % 30(@)(@@) % بنائل يمتار منه الغنى % % له على العافي شآبيب % PageV01P418 31(@)(@@) % وعزمة نال بها ما ابتغى % % من العدا ، والسيف مقروب % 32(@)(@@) % والسمر لم تكلف 
ms127	 بلياتهم % راعفة منها الأنابيب % 33(@)(@@) % هذا وكم من غمرة خاضها % % فيها نقيع السم مشروب % 34(@)(@@) % للأسل اللدن بأرجائها % % والخيل أخدود وألهوب % 35(@)(@@) % والله يعلي راية ، نصرها % % برأيه الثاقب معصوب % 36(@)(@@) % فحلم من ساوره عازب % ولب من عاداه مسلوب % 37(@)(@@) % والجهل يغريه على غيه % به ، وقرن الدهر مغلوب % 38(@)(@@) % ألقى مقاليد الورى عنوة % إليه ترهيب وترغيب % 39(@)(@@) % يفرشهم عدلا وأمنا فلا % % يحس مظلوم ومرعوب % 40(@)(@@) % يا من عليه أملي حائم % ومن إليه الحمد مجلوب % PageV01P419 41(@)(@@) % يفديك من شد على ماله % وكاءه ، والعرض منهوب % 42(@)(@@) % له عشار ليس تدمى لها % % في ندوة الحي عراقيب % 43(@)(@@) % يطنب هاجيه ولا يتقي % % إثما ، وفي تقريظه حوب % 44(@)(@@) % فهجوه صدق ، وفي مدحه % تكبو بمطريه الأكاذيب % 45(@)(@@) % والسب يلتف بذي ثروة % يشح والباخل مسبوب % 46(@)(@@) % فما لأيامي تهضمنني % % والسيف دون الضيم مركوب % 47(@)(@@) % غربنني عن وطني ضلة % والوطن المألوف محبوب % 48(@)(@@) % وطبق الآفاق ذكري ، فلم % يخمله إجلاء وتغريب % 49(@)(@@) % والعيش في ظلك حلو الجنى % % كأنه بالأري مقطوب % 50(@)(@@) % فلا فؤادي للنوى خافق % وجدا ، ولا دمعي مسكوب % PageV01P420 51(@)(@@) % وكيف يشكو الدهر من شعره % على جبين الدهر مكتوب % PageV01P421 البحر : طويل 1(@)(@@) % رمى الله سعدا بالذي هو أهله % فقد مل قبل الفجر سوق الأباعر % 2(@)(@@) % يلح على الأقدار باللوم إذ ونى % % وليس على طي الفيافي بصابر % 3(@)(@@) % وبئس زميل السفر من كان دأبه % إذا عير التقصير ذم المقادر % 4(@)(@@) % فلم أجب البيداء إذ أرخت الدجى % % ذلاذلها منه بأبيض باتر % 5(@)(@@) % ولو أرقته همة أموية % لما نام عما أقتني من مآثر % 6(@)(@@) % فبات ضجيعا للهوينى ، وقلصت % برحلي بنيات الجديل وداعر % 7(@)(@@) % وقد شربت أكوارها من ظهورها % % دما والكرى يلقي يدا في المحاجر % 8(@)(@@) % لئن سلمت مني ولم أبلغ المدى % % فلست لصيد من قريش وعامر % PageV01P422 البحر : طويل 1(@)(@@) % أضاء بريق بالعذيب كليل % فثني نجادي للدموع مسيل % 2(@)(@@) % تناعس في حضن الغمام كأنه % حسام رميض الشفرتين صقيل % 3(@)(@@) % ينير سناه منزل الحي باللوى % % ويسديه مرزام العشي هطول % 4(@)(@@) % وألحظه شزرا بمقلة أجدل % له 
ms128	 نطرات كلهن عجول % 5(@)(@@) % يراعي أساريب القطا عصفت بها % % من الريح هوجاء الهبوب بليل % 6(@)(@@) % فأهوى إليها ، وهو طاو وعنده % أزيغب مصفر الشكير ضئيل % 7(@)(@@) % بأقنى على أرجائه الدم مائر % وحجن حكت أطرافهن نصول % 8(@)(@@) % فرحن وما منهن إلا مطرح % جريح ومنزوف الحياة قتيل % 9(@)(@@) % فآها من البرق الذي بز ناظري % % كراه ، وأسراب الدموع همول % 10(@)(@@) % تألق نجديا - - فحنت نويقة % يجاذبها فضل المراح جديل % PageV01P423 11(@)(@@) % وبي ما بها من لوعة وصبابة % ولكن صبر العبشمي جميل % 12(@)(@@) % وما لي إلا البرق يسري أو الصبا % % إلى حيث يستن الفرات ، رسول % 13(@)(@@) % تحن إلى ماء الصراة ركائبي % % وصحبي بشطي زرنروذ حلول % 14(@)(@@) % أشوقا وأجواز المهامه بيننا % % يطيح وجيف دونها وذميل % 15(@)(@@) % ألا ليت شعري هل أراني بغبطة % أبيت على أرجائها وأقيل % 16(@)(@@) % هواء كأيام الهوى ، لا يغبه % نسيم ، كلحظ الغانيات ، عليل % 17(@)(@@) % وعصر رقيق الطرتين تدرجت % على صفحتيه نضرة وقبول % 18(@)(@@) % وأرض حصاها لؤلؤ وترابها % % تضوع مسكا ، والمياه شمول % 19(@)(@@) % بها العيش غض ، والحياة شهية % وليلي قصير ، والهجير أصيل % 20(@)(@@) % فقل لأخلائي ببغداد هل بكم % سلو ؟ فعندي رنة وعويل % PageV01P424 21(@)(@@) % ترنحني ذكراكم فكأنما % % تميل بي الصهباء حين أميل % 22(@)(@@) % لئن قصرت أيام أنسي بقربكم % فليلي على نأي المزار طويل % 23(@)(@@) % وحولي قوم يعلم الله أنني % % بهم - وهم بي يكثرون - قليل % 24(@)(@@) % إذا فتش التجريب عنهم تشابهت % سجايا كأطراف الرماح ، شكول % 25(@)(@@) % ولو لم نرم بطحاء مكة أشرقت % بها غرر من مجدنا وحجول % 26(@)(@@) % إذا ذكرت آل ابن عفان أجهشت % حزون ، ورنت بالحجاز سهول % 27(@)(@@) % برغو العلا تمسي وتصبح دورهم % وهن رسوم رثة وطلول % 28(@)(@@) % ترشح أم الخشف أطلاءها بها % % وتسحب فيها للرياح ذيول % 29(@)(@@) % أثرها أبا حسان حدبا كأنها % % نسوع على أوساطهن تجول % 30(@)(@@) % فقد أنكر الياس النزاري مكثنا % % وخندف بنت الحميري عذول % PageV01P425 31(@)(@@) % إذا لم تنوه بالمكارم همتي % % تشبث بي - حاشا علاي - خمول % 32(@)(@@) % تعيرني بنت المعاوي غربتي % % وكل طلوع يقتفيه أفول % 33(@)(@@) % وتعجب أني من ممارسة النوى % % نحيف ، وفي متن القناة 
ms129	 ذبول % 34(@)(@@) % لئن أنكرت مني نحولا فصارمي % % يغازله في مضربيه نحول % 35(@)(@@) % ولم تبدع الأيام في بنكبة % فبيني وبين النائبات ذحول % PageV01P426 البحر : سريع 1(@)(@@) % وشادن نبهته ، والكرى % % يميله كالغصن المنعطف % 2(@)(@@) % فجاء يمشي ثملا خطوه % وهو بجلباب الدجى ملتحف % 3(@)(@@) % بدر الدجى يسعى بشمس الضحى % % وأدمع الغيم علينا تكف % 4(@)(@@) % وجفنه يثقل من سكره % وكفه بالكأس نحوي تخف % 5(@)(@@) % فبت والنجم وهى عقده % يفسق طرفي وضميري يعف % 6(@)(@@) % والورد من وجنته أجتني % % والراح من ريقته أرتشف % 7(@)(@@) % ثم افترقنا وكلانا شج % له فؤاد بالأسى يعترف % 8(@)(@@) % وأضلع فيها الجوى كامن % وأدمع منها النوى تغترف % PageV01P427 البحر : طويل 1(@)(@@) % سل الدهر عني أي خطب أمارس % وعن ضحكي في وجهه وهو عابس % 2(@)(@@) % فما لبنيه يشتكون بنائه % وهل يبتلى بالبله إلا الأكايس % 3(@)(@@) % سأحمل أعباء الخطوب ، فطالما % % تماشت على الأين الجمال القناعس % 4(@)(@@) % وأنتظر العقبى وإن بعد المدى % % وأرقب ضوء الفجر والليل دامس % 5(@)(@@) % فلله دري حين توقظ همتي % % ولا أنا مما يضمن النجح آيس % 6(@)(@@) % وصحبي وجيهي ورمح وصارم % % 7(@)(@@) % وإني لأقري النائبات عزائما % تروض إباء الدهر والدهر شامس % 8(@)(@@) % % مطامع ، لحظي نحوها متشاوس % 9(@)(@@) % تجافيت عنها وهي خود غريرة % فهل أبتغيها وهي شمطاء عانس ؟ % 10(@)(@@) % وفي عريق من قريش تعطفت % علي به أعياصها والعنابس % PageV01P428 11(@)(@@) % أغالي بعرضي في الخصاصة والمنى % % تراودني عن بيعه وأماكس % 12(@)(@@) % وأصدى إذا ما أعقب الري ذلة % وأزجر عيسي وهي هيم خوامس % 13(@)(@@) % ولي مقلة وحشية لا تروقها % % نفائس تحويها نفوس خسائس % 14(@)(@@) % وقد صرت الخضراء أخلاف مزنها % % وليس على الغبراء رطب وبابس % 15(@)(@@) % وخرق إلى فرعي خزيمة ينتمي % % ويعلم أن الجود للعرض حارس % 16(@)(@@) % لحاني على ترك الغنى ، ومعرسي % % جديب ، وجاري ضارع الخد بائس % 17(@)(@@) % فقلت له إن العلا من مآربي % % وما لي عنها غير عدمي حابس % 18(@)(@@) % وإني بطرف صيغ للعز طامح % إليها ، وأنف أودع الكبر عاطس % 19(@)(@@) % فشد بعبد الله أزري وأعصمت % يميني بمن باهى به العرب فارس % 20(@)(@@) % بأروع من آلائه البحر مطرق 
ms130	 % حياء ، ومن لألائه البدر قابس % PageV01P429 21(@)(@@) % حوى خرزات الملك بالبأس والندى % % وغصن الصبا لدن المهزة مائس % 22(@)(@@) % وأجداده ممن رعاهن ستة % تطيب بهم أعراقه والمغارس % 23(@)(@@) % فصاروا به كالسبعة الشهب مالهم % مسام ، كما لم يدن منهن لامس % 24(@)(@@) % وأعلى منار العلم حين أظلنا % % زمان لأشلاء الأفاضل ناهس % 25(@)(@@) % وقد كان كالربع الذي خف أهله % له أثر ألوى به الدهر دارس % 26(@)(@@) % إذا ركب اختالت به الخيل أو مشى % % لوت من هواديها إليه المجالس % 27(@)(@@) % وإن طرق الأعداء أقمر ليلهم % به ، وأديم الأرض بالدم وارس % 28(@)(@@) % حباه أمير المؤمنين بصارم % كناظرتيه ، دونه القرن ناكس % 29(@)(@@) % وطرف إذا الآجال قفيتها به % فهن لآجال قضين فرائس % 30(@)(@@) % ومرضعة ما لم تلده ، فإن بكى % % تبسم في وجه الصباح الحنادس % PageV01P430 31(@)(@@) % إلى خلع تحكي رياضا أنيقة % بكفيه تسقيها الغمام الرواجس % 32(@)(@@) % وكيف يبالي بالملابس ساحب % ذيول المعالي ، وهو للمجد لابس % 33(@)(@@) % وأحسن ما يكسى الكرام قصائد % أوابد معناها بواديك آنس % 34(@)(@@) % تزف إلى ناديك ملسا متونها % % وتهدى إلى أكفائهن العرائس % 35(@)(@@) % وتدفع عنك الكاشحين كأنما % % مناط قوافيها الرماح المداعس % 36(@)(@@) % وتبعث أرسالا عجالا إليهم % كما تابع الطعن الكمي المخالس % 37(@)(@@) % ولولاك ما أوهى قوى الفكر مادح % ولا افتر عن بيت من الشعر هاجس % 38(@)(@@) % رعيت ذمام الدين بالعدل بعدما % % أضيع ولم يحم الرعية سائس % 39(@)(@@) % فظل يمر السخل بالذئب آمنا % ولا ترهب الأسد الظباء الكوانس % 40(@)(@@) % وعرضت من عاداك للهلك فانتهى % % عن الملك حتى قل فيه المنافس % PageV01P431 41(@)(@@) % وأرهفت من غربي وما كان نابيا % كما سنت البيض الرقاق المداوس % 42(@)(@@) % وجابت إليك البيد هوج عرامس % عليهن صيد من قريش أحامس % 43(@)(@@) % فما أنت ممن يبخس الشعر حقه % % PageV01P432 البحر : بسيط تام 1(@)(@@) % وكاشح خامرت ألحاظه سنة % تركته وهو من جفنيه تنتفض % 2(@)(@@) % فظل مرتعد العرنين من غضب % وسورة التيه في عطفي ترتكض % 3(@)(@@) % أنا الشجا والعدا منه على مضض % بحيث تعترك الأنفاس يعترض % PageV01P433 البحر : متقارب تام 1(@)(@@) % كتمنا الهوى وكففنا الحنينا % % فلم يلق ذو صبوة ما 
ms131	 لقينا % % 2(@)(@@) % وأنتم تبثون سر الغرا % % م طورا شمالا وطورا يمينا % % 3(@)(@@) % ولما تناديتم بالرحي % % ل لم يترك الدمع سرا مصونا % % 4(@)(@@) % وكيف نحاول كتمانه % وقد أخضل العبرات الجفونا % % 5(@)(@@) % أمنتم على السر منا القلوب % فهلا اتهمتم عليه العيونا % % 6(@)(@@) % ومما أذاعته يوم العذيب % مهارى بسرب عذارى حدينا % % 7(@)(@@) % أوانس أبرزهن النوى % % فلاحت بدورا وماست غصونا % % 8(@)(@@) % ومدت إلينا من الخدر غيدا % وأغضت على النظر الشزر عينا % % 9(@)(@@) % أحن إليها ومن دونها % % تعد الركائب بينا فبينا % % 10(@)(@@) % وأين العراق من الأخشبين % وإن أعمل الصب طرفا شفونا % % PageV01P434 11(@)(@@) % بعيشكما أيها الحاديات % قفا وعلى ما أعاني أعينا % % 12(@)(@@) % فإن المطايا رأت بالعقيق % معاهد من آل سعدى بلينا % % 13(@)(@@) % فأحداقهن ترش الدموع % وأنفاسهن تقد الوضينا % % 14(@)(@@) % ويحكي السراب إذا ما زها % % ظعائنها البحر يزهو السفينا % % 15(@)(@@) % ولا بد من زفرة تستطي % % ر من أرحل الرازحات العهونا % % 16(@)(@@) % سقين الحيا الجود من أنيق % أطعن الهوى وعصين البرينا % % 17(@)(@@) % أربع البخيلة مذا دهاك % وما للحمى خاشعا مستكينا % % 18(@)(@@) % فأين الخيام التي ظللت % بسمر ألاحظ فيها المنونا % % 19(@)(@@) % وقد ساءني أن أرى دارها % % تصوغ الحمائم فيها لحونا % % 20(@)(@@) % لئن ضنت السحب الغاديات % فلست بدمعي عليها ضنينا % % PageV01P435 21(@)(@@) % كأن الشآبيب من صوبه % مواهب خير بني الحبر فينا % % 22(@)(@@) % أغر لأعظمهم هامة % وأوضحهم في قريش جبينا % % 23(@)(@@) % إذا ما انتمى عضمت الأبطحين % مآثره ، وامتطين الحجونا % % 24(@)(@@) % وتلك البنية مذ أسست % أبت غير عبد مناف قطينا % % 25(@)(@@) % بها ركزوا السمر فوق العلا % % وشدوا بها الصاهلات الصفونا % % 26(@)(@@) % وشنوا على ولدي يعرب % غوارا يضرم حربا زبونا % % 27(@)(@@) % وحل بنو هاشم بالبطاح % محل الضراغم تحمي العرينا % % 28(@)(@@) % أيبغي العدا شأوهم ، والرياح % إذا ما ابتدرن إليه وجينا % % 29(@)(@@) % أبى الله أن تقبل المكرما % % ت عرضا هزيلا ومالا سمينا % % 30(@)(@@) % وعندي للمقتدي أنعم % أمنت بهن الزمان الخؤونا % % PageV01P436 31(@)(@@) % وإني وإن ضعضعتني الخطوب % لأنفض عن فضل بردي هونا % % 32(@)(@@) % وقد علمت خندف أنني % % أكون بنيل المعالي قمينا % % 33(@)(@@) % وللضيف حق ، وعمرو العلا % % يعد الحقوق 
ms132	 عليه ديونا % % 34(@)(@@) % ولما اقشعرت بطاح الحجاز % كفى قومه أزمة المحل حينا % % 35(@)(@@) % وفاضت لديه دماء العشار % على شعل النار للطارقينا % % 36(@)(@@) % وأنت ابنه والورى يمترو % % ن من راحتيك الغمام الهتونا % % 37(@)(@@) % فلا زلت ملتحفا بالعلا % % تقضي الشهور وتنضو السنينا % % PageV01P437 البحر : وافر تام 1(@)(@@) % تشبث يا أخي بمكرمات % تنوش ذوائب الحسب التليد % 2(@)(@@) % فنحن نحل أندية إليها % % ثنى النعماء طرف المستفيد % 3(@)(@@) % وتعتقل الرماح مثقفات % ونرفل في سرابيل الحديد % 4(@)(@@) % وقد كنا الملوك على البرايا % % نشيد ما بناه أبو يزيد % 5(@)(@@) % فجاذبنا رداء العز دهر % جلا الأحرار في صور العبيد % PageV01P438 البحر : طويل 1(@)(@@) % معاهدها ، والعهد ينسى ويذكر % على عذبات الجزع تخفى وتظهر % 2(@)(@@) % و أشلاء دار بالمحصب من منى % وقفت بها والأرحبية تهدر % 3(@)(@@) % أسائلها والعين شكرى من البكا % % وهن نحيلات المعالم دثر % 4(@)(@@) % وأستخبر الأطلال عن ساكني الحمى % % فلا الدمع يشفيني ولا الربع يخبر % 5(@)(@@) % كأن ديار العامرية باللوى % % صحائف تطويها الليالي وتنشر % 6(@)(@@) % فهل عبرة تقضي المعاهد حقها % % كما يستهل اللؤلؤ المتحدر % 7(@)(@@) % ولي مقلة ما تستريح إلى البكا % % بحزوى ، فقد ألوى بدمعي محجر % 8(@)(@@) % فهل علم الغيران أني على النوى % % وإن ساءه ، من حب سمراء أسهر % 9(@)(@@) % وأغضي على حكم الهوى وهو جائر % فما لسليمى واعهيداه تغدر % 10(@)(@@) % أتنصفني أخت العريب ، وقد أرى % % موشحها يعدو عليه المؤزر % PageV01P439 11(@)(@@) % هلالية ترنو إلي بمقلة % على خفر ، تصحو مرارا وتسكر % 12(@)(@@) % وتكسر جفنيها على نجل بها % % كما أطبق العين الكحيلة جؤذر % 13(@)(@@) % أسمراءكم من نظرة فل غربها % % بوطفاء يطغى دمعها المتحير % 14(@)(@@) % وألوي إليك الجيد حتى كأنني % % لفرط التفاتي نحو يبرين ، أصور % 15(@)(@@) % ذكرتك والوجناء يدمى أظلها % % وتشكو الحفى ، والأرحبيات تزفر % 16(@)(@@) % كأني وإياها من السبر والسرى % % جديل كجرم الأفعوان مخصر % 17(@)(@@) % ولولاك لم أقطع نياط تنوفة % كصدر أبي المغوار ، والعيس حسر % 18(@)(@@) % وإني إذا ما انساب في الأعين الكرى % % يخب ببزي أعوجي مضمر % 19(@)(@@) % وأسري بعيس كالأهلة فوقها % % وجوه من الأقمار أبهى وأنور % 20(@)(@@) % ويعجبني نفح العرار ، وربما % % شمخت 
ms133	 بعرنيني وقد فاح عنبر % PageV01P440 21(@)(@@) % ويخدش غمدي بالحمى صفحة الثرى % % إذا جر من أذياله المتحضر % 22(@)(@@) % فما العيش إلا الضب يحرشه الفتى % % وورد بمستن اليرابيع أكدر % 23(@)(@@) % بحيث يلف المرء أطناب بيته % على العز ، والكوم المراسيل تنحر % 24(@)(@@) % ويغشى ذراه حين يستعتم القرى % % ويسمو إليه الطارق المتنور % 25(@)(@@) % كأني به جار الأمير مفرج % فلا عيش إلا وهو ريان أخضر % 26(@)(@@) % ضربت إليه صدر كل نجيبة % لها نظر شطر النوائب أخزر % 27(@)(@@) % فحطت به رحل المكل ، وظهرها % % من الشكر والشعر المحبر موقر % 28(@)(@@) % ونيرانه حيث العشار دماؤها % % تراق ويذكيها الوشيج المكسر % 29(@)(@@) % وزرنا فناء لم تزل في عراصه % مدائح تروى أو جباه تعفر % 30(@)(@@) % وحاط حمى الملك الذي دون نبيله % يقد بأطراف الرماح السنور % PageV01P441 31(@)(@@) % ويفلى لبان الأعوجي ، ويرتدي % % إذا اشتجرت زرق الأسنة عثير % 32(@)(@@) % تواضع إذ ألفى معرس مجده % مناط السها يشأى الملوك ويبهر % 33(@)(@@) % وما هزه تيه الإمارة والذي % % يصادفها ، في ثني عطفيه ينظر % 34(@)(@@) % فكل حديث بالخصاصة عهده % إذا رفعته ثروة يتكبر % 35(@)(@@) % دعاني إليك الفضل والمجد والعلا % % وبذل الندى والمنصب المتخير % 36(@)(@@) % وقد شملتني نعمة أنت ربها % % هي الروض غاداه الحيا وهو مغزر % 37(@)(@@) % وكم ماجد يبغي ثناء أصوغه % ولكنني عن مدح غيرك أزور % 38(@)(@@) % فكل كناني بعزك يحتمي % % وسيبك يستغني ، وسيفك ينصر % PageV01P442 البحر : كامل تام 1(@)(@@) % يابن الخلائف لا تذل لنكبة % يلتف فيها بالرجاء الياس % 2(@)(@@) % فسجية الأموي كبر زانه % كرم وجود دب فيه باس % 3(@)(@@) % ولنا من الشرف الرفيع يفاعه % والله يعلم ذاك ثم الناس % 4(@)(@@) % وجميع من في الأرض ليس بمنكر % أن الورى ذنب ونحن الراس % PageV01P443 البحر : طويل 1(@)(@@) % ألا من لنفس لا تزال مشيحة % على كمد لم يبق إلا ذماؤها % % 2(@)(@@) % أرى همتي هما تخون مهجتي % % فقل يا شقيق النفس لي ما شفاؤها % % 3(@)(@@) % ومن رام ما أسمو إليه أزاره % صوارم تروى بالنجيع ظماؤها % % 4(@)(@@) % وطلاب مجد دون ما يبتغونه % أعالي ربا لا يستطاع امتطاؤها % % 5(@)(@@) % علونا ذراها كالبدور تألقت % فجلى دياجير الظلام 
ms134	 ضياؤها % % 6(@)(@@) % ونحن معاويون يرضى بنا الورى % % ملوكا ، وفينا من لؤي لواؤها % % 7(@)(@@) % وأخوالنا سادات قيس ووائل % وأعمامنا من خندف خلفاؤها % % 8(@)(@@) % وقد علمت عليا كنانة أننا % % إذا نقض الطيش الحبا ، حلماؤها % % 9(@)(@@) % وما بلغت إلا بنا العرب العلا % % وقد كان منا عزها وثراؤها % % 10(@)(@@) % وأي قريض طبق الأرض لم يرض % قوافيه في مدحنا شعراؤها ؟ % PageV01P444 11(@)(@@) % ولما انتهت أيامنا علقت بها % % شدائد أيام قليل رخاؤها % % 12(@)(@@) % وكان إلينا في السرور ابتسامها % % فصار علينا في الهموم بكاؤها % % 13(@)(@@) % أصيبت بنا فاستعبرت ، وضلوعها % % على مثل وخز السمهري انطواؤها % % 14(@)(@@) % ولو علمت ماذا تعانيه بعدنا % % لما شتمت جهلا بنا سفهاؤها % % 15(@)(@@) % إذا ما ذكرنا أولينا تولعت % بنا ميعة يطغي الفتى غلواؤها % % 16(@)(@@) % وقد ساء قوما من نزار ويعرب % فخاري وهم أرض ونحن سماؤها % % 17(@)(@@) % وهل تخفض الأسد الزئير بموطن % إذا لج فيه من كلاب عواؤها % % 18(@)(@@) % ملكنا أقاليم البلاد فأذعنت % لنا رغبة أو رهبة عظماؤها % % 19(@)(@@) % وجاست بنا الجرد العتاق خلالها % % سواكب من لباتهن دماؤها % % 20(@)(@@) % فصرنا نلاقي في النائبات بأوجه % رقاق الحواشي ، كاد يقطر ماؤها % % PageV01P445 21(@)(@@) % إذا ما أردنا أن نبوح بما جنت % علينا الليالي لم يدعنا حياؤها % % 22(@)(@@) % وأنتم بني من عيب أولاده به % ذوو نعمة يضفو عليكم رداؤها % % 23(@)(@@) % فلم تسألوا عما تجن نفوسنا % % وتمنعنا من ذكره كبرياؤها % % 24(@)(@@) % ولا خير في نفس تذل لحادث % يلم ولا يعتادها خيلاؤها % % 25(@)(@@) % فلا كان دهر نلتم فيه ثروة % وتبا لدنيا أنتم رؤساؤها % % PageV01P446 البحر : طويل 1(@)(@@) % أرقنا وأسراب النجوم هجوع % نعالج هما أضمرته ضلوع % 2(@)(@@) % ونعرض عن بيض تدير وراءنا % % عيون مها فيها دم ودموع % 3(@)(@@) % وننهض للعلياء والجد عاثر % ونحن بمستن الهوان وقوع % 4(@)(@@) % وهل ترفع الأيام إلا عصابة % عفت بهم للمكرمات ربوع % 5(@)(@@) % لهم ثروة يمتد في اللؤم باعها % % حواها نعام في النعيم رتوع % 6(@)(@@) % إذا شبعوا باتوا نياما وجارهم % يصارم جفنيه الكرى ويجوع % 7(@)(@@) % شكت عقب المسرى مطايا تؤمهم % وتذرع أجواز الفلا وتبوع % 8(@)(@@) % فلا زلن حسرى لم حملن إليهم 
ms135	 % فتى لا يناغي ناظريه خشوع % 9(@)(@@) % وهم نفض الآفاق قد خبثت لهم % أصول فما طابت لهن فروع % 10(@)(@@) % إذا زار مغناهم كريم فما له % إليهم إذا حم الفراق رجوع % PageV01P447 البحر : بسيط تام 1(@)(@@) % أردد الظن بين اليأس والأمل % وأعذر الحب يفضي بي إلى العذل % 2(@)(@@) % وأسأل الطيف عن سلمى إذا قبلت % شفاعة النوم للساري إلى المقل % 3(@)(@@) % وما أظن عهود الرمل باقية % وأي عهدك يا ظمياء لم يحل % 4(@)(@@) % لله ما صنعت أيدي الركاب بنا % % عشية استتر الأقمار بالكلل % 5(@)(@@) % إذا ابتسمن سلبن البرق روعته % وإن نظرن فجعن الظبي بالكحل % 6(@)(@@) % من كل بيضاء مصقول ترائبها % % مقسومة العهد بين الغدر والملل % 7(@)(@@) % تسل من مقلتيها صارما أخذت % من حده وجنتاها حمرة الخجل % 8(@)(@@) % طرقتها والدجى شابت ذوائبه % والفجر مقتبل في زي مكتهل % 9(@)(@@) % وللرقيب خشوع في لواحظه % يعيرها نظرات الشارب الثمل % 10(@)(@@) % فرد دون وشاح يها العفاف يدا % تبز في الروع درع الفارس البطل % PageV01P448 11(@)(@@) % ثم انصرفت وقلبانا كأنهما % % عند الوداع جناحا طائر وجل % 12(@)(@@) % وفي مباسمها لي ما يتابعه % براحتيك الملوك الصيد من قبل % 13(@)(@@) % لله درك من قرم كم اختضبت % إليه بالدم أيدي الخيل والإبل % % 14(@)(@@) % سهل الشريعة سباق إلى أمد % تسري الرياح به حسرى على مهل % 15(@)(@@) % ومستبد برأي لا يتعتعه % خطب يشير على الآراء بالزلل % 16(@)(@@) % ينضوه للأمر قد سدت مطالعه % وضاق في طرفيه مسلك الحيل % 17(@)(@@) % والسيف ينفع يوم الروع حامله % إذا تبدل يمناه من الخلل % 18(@)(@@) % فزاده المقتدي بالله تكرمة % كسته برد الشباب الناضر الخضل % 19(@)(@@) % وعاد ريعان عمر بان ريقه % فراجع البيض من أيامه الأول % 20(@)(@@) % يزهى به الخلع الميمون طائرها % % زهو الخرائد بالمكحولة النجل % PageV01P449 21(@)(@@) % هن الرياض لها من خلقه زهر % ومن أياديه صوب العارض الهطل % 22(@)(@@) % ومن غدا برداء الفخر مشتملا % أضحى بما يكتسيه غير محتفل % 23(@)(@@) % وجاءه الطرف والأعداء في كمد % يدمي الجوانح والإخوان في جذل % 24(@)(@@) % يسمو بهاديه والأعناق خاضعة % لحافر بعيون القوم منتعل % 25(@)(@@) % يا سعد كم لك 
ms136	 من نعماء جدت بها % % حتى تركت الحيا يعزى إلى البخل % 26(@)(@@) % أهذه قصبات الملك تعملها % % أم الضرائر للخطية الذبل % 27(@)(@@) % فقد بلغت بها ما عز مطلبه % على ظبا الهند وانيات والأسل % 28(@)(@@) % إن الكتائب كتب عنك صادرة % فاسدد بها لهوات السهل والجبل % 29(@)(@@) % وافخر بما شدت من مجد يؤثله % ندى يروح ويغدو غاية المثل % 30(@)(@@) % إن المكارم شتى في طرائقها % % وأنت تنزل منها ملتقى السبل % PageV01P450 31(@)(@@) % لازال شمل المعالي منك منتظما % ودام صرف الليالي عنك في شغل % PageV01P451 البحر : طويل 1(@)(@@) % إذا غار عزمي في البلاد وأنجدا % % فإن قصارى السعي أن أبلغ المدى % % 2(@)(@@) % وللغاية القصوى سمت بي همتي % % فلا بد من نيلي المعالي أو الردى % % 3(@)(@@) % لأدرعن النقع والسيف ينتضى % % لجينا ونؤويه إلى الغمد عسجدا % % 4(@)(@@) % بجرد يجاذبن الأعنة أيديا % لبيقات أطراف الأنامل بالندى % % 5(@)(@@) % إذا هن نبهن الثرى من رقاده % ذررن به في مقلة النجم إثمدا % % 6(@)(@@) % وشعثن أعراف الصباح بهبوة % يطالعن منها ناظر الشمس أرمدا % % 7(@)(@@) % فلست ابن من ساد الأنام وقادهم % لئن لم أرو الرمح من ثغر العدا % % PageV01P452 البحر : طويل 1(@)(@@) % ثنى عطفه للبارق المتأجج % كما علقت نار بأطاف عرفج % 2(@)(@@) % وقد صغت الجوزاء والفجر ساطع % كما لمعت ريا إلي بدملج % 3(@)(@@) % فبت أراعيه على حد مرفق % بطرف متى يطمح به الشوق أنشج % 4(@)(@@) % وكادت عذارى الحي يقبسن ناره % إذا ما تلوت في السنا المتوهج % 5(@)(@@) % وشوقي حليم غير أن صبابة % تسفه حل الوامق المتحرج % 6(@)(@@) % إذا ما سرى برق وقد هبت الصبا % % كلفت بذكرى أكحل العين أدعج % 7(@)(@@) % ففي ومضان البرق منه ابتسامة % وللريح ريا نشره المتأرج % 8(@)(@@) % لبيت بأعلى تلعة في ظلاله % ملاعب خفاق من الريح سجسج % 9(@)(@@) % تشد النزاريات أطنابه العلا % % بأرض يلوذ الطير فيها بعوسج % 10(@)(@@) % ويمشين رهوا مشية قرشية % تنوء بكثبان النقا المترجرج % PageV01P453 11(@)(@@) % وتشرق بالورد الخدود نواضرا % إذا ابتسمت عن أقحوان مفلج % 12(@)(@@) % ونغمة راعي الذود يزجي إفاله % بدعص يهاديه ندى الليل ، أثبج % 13(@)(@@) % وغارتنا والصبح حط لثامه % على كل موار 
ms137	 الملاطين أهوج % 14(@)(@@) % أحب إلينا من قويق وضجعة % على زهر يستوقف العين مبهج % 15(@)(@@) % فلله مرأى بالعقيق ومسمع % عشية مرت بالحمى أخت مدلج % 16(@)(@@) % يحف بها من فرع خندف غلمة % كنانية تنحو خمائل منعج % 17(@)(@@) % أمالوا العوالي بين آذان قرح % ترددن في آل الضبيب وأعوج % 18(@)(@@) % فلم أر أسدا قبلهم تحت أدرع % ولا رشأ من قبلها وسط هودج % 19(@)(@@) % تجلت لنا كالشمس ، يكنف خدرها % % بدور توارت من حدوج بأبرج % 20(@)(@@) % فما اكتحلت عيني وللبين روعة % بأحسن من يوم الوداع وأسمج % PageV01P454 21(@)(@@) % وهاجت تباريح الصبابة والهوى % % بلابل من صدر على الوجد مشرج % 22(@)(@@) % كأن فؤادي بين أحشاء مجرم % دعاه الفتى الجوثي يخشى ويرتجي % % 23(@)(@@) % يلم بمغشي الرواقين ماجد % يساجل أنواء الربيع المثجج % 24(@)(@@) % وينسبه آل المسيب في الذرا % % إلى كل مشبوح الذراعين أبلج % 25(@)(@@) % وتعرف فيه من وهيب وجعفر % شمائل من يفخر بها لا يلجلج % 26(@)(@@) % سماح إذا ألقى الشتاء جرانه % وهبت لك النكباء من كل منأج % 27(@)(@@) % وطعن يجر القرن عالية القنا % % ويخطر منه في الرداء المضرج % 28(@)(@@) % وتيه عقيلي كأن دلاصه % يزر على ذي لبدتين مهيج % 29(@)(@@) % عليك بهاء الدولتين تعطفت % هوازن في جرثومها المتوشج % 30(@)(@@) % تخوض الوغى والقوم ما بين ملجم % أتاه الصريخ العامري ، ومسرج % PageV01P455 31(@)(@@) % إذا اعتقل القيسي رمحا تكسرت % أعاليه في صدر الكمي المدجج % 32(@)(@@) % فكم لك من يوم أغر محجل % وقتلى عليها الأنسر الفتخ تنتجي % % 33(@)(@@) % تركتم لدى النشاش من سر وائل % جثا حنفيات بكل معرج % 34(@)(@@) % وبالحفر القبر القناني دائر % به هامة لم يسقها آل مذحج % 35(@)(@@) % وكل غلام عامري إذا سما % % إلى القرن لم يحفل صياح المهجهج % 36(@)(@@) % ترشح للهيجاء نفسا شريسة % متى تلقح الحرب العقيمة تنتج % 37(@)(@@) % ولو كنت يوم الجون بالشعب لم يسد % شريح ولم يذكر غناء لخندج % 38(@)(@@) % فسد بك الحي العبادي في العلا % % مكان الخفاجي الأغر المتوج % 39(@)(@@) % ونيط بك الآمال ، لا زال ينتهي % % إليك بآمال الورى كل منهج % 40(@)(@@) % وجاءك بي نضو كأني فوقه % مهيب بصفاق الجناحين أخرج 
ms138	 % PageV01P456 41(@)(@@) % ولولاك لم أخبط دجى الليل والفلا % % بسير يلوي من طلى الركب ، مزعج % 42(@)(@@) % وعندك قوم يلقحون ضغائنا % فألحق متم الحاملات بمخدج % 43(@)(@@) % فذو العر يكوى حين يعضل داؤه % وكل أخي حزم متى يكو ينضج % PageV01P457 البحر : بسيط تام 1(@)(@@) % سقيا لكوفن من أرض إذا ذكرت % هاجت على عدواء الدار أشواقا % % 2(@)(@@) % يطيب عرق الثرى منها بكل فتى % من أسرتي طاب أعراقا وأخلاقا % % 3(@)(@@) % لوى معاوية ابن الأكرمين أبا % منهم إلى المجد أبصارا وأعناقا % % 4(@)(@@) % ترود تحت ظلال السمر عندهم % ملبونة تطأ الهامات أفلاقا % % 5(@)(@@) % فكلهم حين تستوشى حفيظته % يلقي بمعترك الأبطال أرواقا % % 6(@)(@@) % كسا القنا والطلى من أرؤس ولها % في الحرب والسلم تيجانا وأطواقا % % 7(@)(@@) % فإن تهب عند إظلال الخطوب به % يشمر الذيل حتى ينصف الساقا % % PageV01P458 البحر : طويل 1(@)(@@) % ألفت الندى والعامرية تعذل % ومما أفادته الصوارم أبذل % 2(@)(@@) % فلا تعذليني يابنة القوم إنني % % أجود بما أحوي ، وبالعرض أبخل % 3(@)(@@) % وللحمد أولى بالفتى من ثرائه % وخير من المال الثناء المنخل % 4(@)(@@) % ومن خاف أن يستضرع الفقر خده % وفى بالغنى لي أعوجي ومنصل % 5(@)(@@) % ومكتحلات بالظلام أثيرها % % وهن كأشباح الأهلة نحل % 6(@)(@@) % ولا صحب لي إلا الأسنة والظبا % % بحيث عيون الشهب بالنقع تكحل % 7(@)(@@) % وحولي من روقي أمية غلمة % بهم تطفأ الحرب العوان وتشعل % 8(@)(@@) % سريت بهم والناجيات كأنها % % رماح بأيديهم من الخط ذبل % 9(@)(@@) % فحلوا حبا الليل البهيم بأوجه % سنا الفجر في أرجائها يتهلل % 10(@)(@@) % وخاضوا غمار النائبات ، ومالهم % سوى الله والرمح الرديني معقل % PageV01P459 11(@)(@@) % يرومون أمرا دونه جرع الردى % % تعل بها نفس الكمي وتنهل % 12(@)(@@) % على حين نابتني خطوب كثيرة % تؤود بها الأيام متني وأحمل % 13(@)(@@) % وأخفي الصدى والماء زرق جمامه % فهن على الذل السمام المثمل % 14(@)(@@) % ومن سلبته نوشة الدهر عزه % فنحن لريب الدهر لا نتذلل % 15(@)(@@) % ولكننا نحمي ذمار معاشر % لهم آخر في المكرمات وأول % 16(@)(@@) % ولم نغترب مستشرفين لثروة % فمرعى مطايانا بيبرين مبقل % 17(@)(@@) % وقد يصدأ السيف الملازم غمده % ومن لا يرم أوطانه فهو يخمل % 18(@)(@@) % فبتنا 
ms139	 وقد نام الأنام عن العلا % % نساري النجوم الزهر والليل أليل % 19(@)(@@) % ونحن على أثباجها جرد كأنها % % إذا ما استدر الحضر ، بالريح تنعل % 20(@)(@@) % فأوجهها من طرة الصبح تكتسي % % وسائرها في حلة الليل يرفل % PageV01P460 21(@)(@@) % وتعلم ما نبغي فتبتدر المدى % % وليست عليها الأصبحية تجهل % 22(@)(@@) % ويقدمها طرف أغر محجل % لراكبه مجد أغر محجل % 23(@)(@@) % فلم ندر إذ أمت بنا باب أحمد % أنحن إلى ناديه أم هي أعجل % 24(@)(@@) % تذود الكرى عنا تلاوة مدحه % فيرنو إلينا مضغيات وتصهل % 25(@)(@@) % أغر ، رحيب البع ، يستمطر الندى % % جميل المحيا ، مخلط الأمر ، مزيل % 26(@)(@@) % ففي راحتيه للمؤمل مجتدى % وفي ساحتيه للمروع موئل % 27(@)(@@) % سما والشباب الغض يقطر ماؤه % إلى حيث يقصي النظرة المتأمل % 28(@)(@@) % وكان أبوه يرتجي خيره الورى % % وهذا المرجى من بنيه المؤمل % 29(@)(@@) % وقد ولهت شوقا إليه وزارة % لها في بنى إسحاق مثوى ومنزل % 30(@)(@@) % بهم زينت إذ زين غيرهم بها % % وقد يستعير الحلي من يتعطل % PageV01P461 31(@)(@@) % وشام لها الأعداء برقا فأصبحت % عليهم بشؤبوب المنية تهطل % 32(@)(@@) % وقد خيمت فيها بدار مقامة % فليس لها عن ربعهم متحول % 33(@)(@@) % وللدر حسن حيث علق عقده % ولكنه في جيد حسناء أجمل % 34(@)(@@) % من القوم لا مأوى المساكين مقفر % لديهم ، ولا مثوى الصعاليك ممحل % 35(@)(@@) % غطارفة إن حوربوا أرعفوا القنا % % وإن سئلوا النعمى لدى السلم أجزلوا % % 36(@)(@@) % فدونكها غراء لو رام مثلها % % سواي بليغ ظل يصفي ويجبل % 37(@)(@@) % دنت ونأت إذ أطمعت ثم أيأست % وقد أحزن الراؤون فيها وأسهلوا % % 38(@)(@@) % فأجزلها برد عليك مسهم % وأسهلها عقد لديك مفصل % 39(@)(@@) % وها أنا أرجو أن نعيش بغبطة % جميعا وأنت المنعم المتفضل % 40(@)(@@) % فمنك ندى غمر ومني شكره % ونحن كما نهوى أقول وتفعل % PageV01P462 البحر : طويل 1(@)(@@) % أروم العلا والدهر يزجي خطوبه % إلي بإحدى المعضلات القواصم % 2(@)(@@) % وتصحبني سمراء ظمأى لدى الوغى % % وأعرض عن بيضاء ريا المعاصم % 3(@)(@@) % ومن طلب العلياء لم يخف الردى % % فمن دون ما يبغيه حز الغلاصم % PageV01P463 البحر : رجز تام 1(@)(@@) % الفجر يا سعد بني معاذ % فالشهب في مسبحها 
ms140	 جواذ % 2(@)(@@) % ترنو رنو المقل القواذي % % وذو الرعاث باليفاع هاذ % 3(@)(@@) % سقها ولو بالصارم الهذاذ % مقلص الذيل خفيف الحاذ % 4(@)(@@) % لا ري للعيش بذي أجراذ % في أبطن مأشوبة الأفخاذ % 5(@)(@@) % من كل مرهوب الشذا ملاذ % في المجد حاف بالثراء حاذ % 6(@)(@@) % بادي الخنا يسفه أو يباذي % % فالجار شاك والخليط آذ % 7(@)(@@) % وإبلي تأبى صرى الإخاذ % فرع أساريب القطا الشذاذ % 8(@)(@@) % بمنهل مشتبه الألواذ % لما سرى والطرف غير خاذ % 9(@)(@@) % ذو حسب أدرج في بذاذ % مخلولق البردين والمشواذ % 10(@)(@@) % وارقد كالكوكب في الإغذاذ % وامتد باع القرب الحذحاذ % PageV01P464 11(@)(@@) % حثا ثرى نجد على بغداذ % فغمدة الدين بها ملاذي % % 12(@)(@@) % إذا مشى في حلقات الماذي % % رمت إليه الأرض بالأفلاذ % 13(@)(@@) % وانهل شؤبوب النجيع الغاذي % % بالوابل الصيب والرذاذ % 14(@)(@@) % والخطو فوق قمم جذاذ % يابن الإمام دعوة العواذ % 15(@)(@@) % والدهر يبدي صفحة استحواذ % فامنن على الأشلاء بالإنقاذ % 16(@)(@@) % فقد نبذن منبذ الرباذ % وهن إذ روعن بانتباذ % 17(@)(@@) % أهل اصطناع منك واتخاذ % وأنت رب الأنعم اللذاذ % 18(@)(@@) % و عزمة فرت عن النفاذ % تعجل سيبا ريث الإشجاذ % 19(@)(@@) % طامي العباب صخب الأواذي % % ندى قواما في علا أفذاذ % 20(@)(@@) % إن عاد سهمي بك ذا قذاذ % بت أناصي النجم أو أحاذي % % PageV01P465 البحر : طويل 1(@)(@@) % ويوم طوينا أبرديه بروضة % ينشر فيها الأتحمي المعضد % 2(@)(@@) % ونحن على أطراف نهر تظله % أزاهيرها والشمس فيها توقد % 3(@)(@@) % وتظهره طورا وطورا تجنه % فتحسبه سيفا يسل ويغمد % 4(@)(@@) % وتبسم في رأد الضحى وتؤودها % % أبابيل من طير عليها تغرد % 5(@)(@@) % شربنا بها ماء تغازله الصبا % % فيصفو ، ويقتات النسيم فيبرد % 6(@)(@@) % إذا ما ذكرنا طيبه بعد برهة % من الدهر عاودناه ، والعود أحمد % PageV01P466 البحر : متقارب تام 1(@)(@@) % أتروى وقد صدح الجندب % غرائب أخطأها المشرب % 2(@)(@@) % تمد إلى الماء أعناقها % % وهن إذا وردت تضرب % 3(@)(@@) % كأن السماء لها منهل % عليه من الحبب الكوكب % 4(@)(@@) % فليس إلى نيلها مطمح % ولا لكواكبها مطلب % 5(@)(@@) % ويطوين والروض في حلة % يجر رفارفها الأزيب % 6(@)(@@) % وما العشب إلا القنا ترتوي % % دما من أنابيبها يسكب 