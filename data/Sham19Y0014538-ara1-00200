ms181	(@)(@)(@@) (¬3)(@)(@@) أحمد بن مصعب قال: قال وكيع: لم يسمع حفص بن غياث حديث الدجال عن مجالد، إنما سمعه من جنادة وجنادة لا يكتب عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 293 - جعفر بن أبى المغيرة(@)(@)(@@) (¬4) PageV02P192(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: جعفر بن أبى المغيرة كوفى، لا يعلم أحدا روى عنه غير يحيى بن يحيى التميمى (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 294 - الجراح بن مليح بن على(@)(@)(@@) (¬2)(@)(@@) أبو وكيع بن الجراح ضعيف الحديث.(@)(@@) قال: حدثنا يحيى بن معين، حدثنا وكيع بن الجراح، عن أبيه، عن الأعمش عن إبراهيم عن علقمة عن عبد الله قال: ما كان {ياأيها الذين آمنوا} أنزل بالمدينة، وما كان {ياأيها الناس} أنزل بمكة.(@)(@@) قال يحيى: لم يقل أحد عن عبد الله غير أبى وكيع.(@)(@)(@@)(@@)(@@) ||| AUTO 295 - أبو بشر جعفر بن إياس(@)(@)(@@) (¬3) PageV02P193(@)(@@) ابن أبى خيثمة، حدثنا أحمد قال: قال يحيى: كان شعبة يضعف أحاديث أبى بشر عن مجاهد. على قال: قال يحيى: كان شعبة يضعف أحاديث جعفر (¬1) بن أبى وحشية.(@)(@)(@@)(@@)(@@) ||| AUTO 296 - الجلد بن أيوب(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت أبى يقول: كان ابن علية يضعف الجلد بن أيوب، وقد روى عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 297 - وجسر بن فرقد(@)(@)(@@) (¬3)(@)(@@) قال أبو حاتم: وجسر بن فرقد أبو جعفر رجل صالح ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 298 - وجزئ بن بكير العبسى(@)(@)(@@) (¬4) PageV02P194(@)(@@) سمع حذيفة منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 299 - وجبارة بن المغلس(@)(@)(@@) (¬1)(@)(@@) ليس يعتد به فى الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 300 - وجعفر بن ميمون(@)(@)(@@) (¬2)(@)(@@) بصرى وليس هو بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 301 - والجارود الخراسانى(@)(@)(@@) (¬3) PageV02P195(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 302 - وجعفر بن الزبير(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@@) قال ابن المدينى: ذكر يحيى جعفر بن الزبير فقال: لو شئت أن أكتب عنه ألفا لكتبت، وضعفه يحيى جدا.(@)(@)(@@)(@@)(@@) ||| AUTO 303 - وجابر بن نوح(@)(@)(@@) (¬2) PageV02P196(@)(@@) إمام مسجد بنى حمان لم يكن بثقة.(@)(@@) قال ابن معين: جابر بن نوح ليس بشئ وكان حفص بن عياش يضعفه.(@)(@)(@@)(@@)(@@) || AUTO حرف: ح(@)(@)(@@)(@@)(@@) ||| AUTO 304 - الحكم بن عبد الله(@)(@)(@@) (¬1)(@)(@@) قال: الحكم بن عبد الله الأيلى ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 305 - وحديج بن معاوية(@)(@)(@@) (¬2)(@)(@@) أخو زهير بن معاوية ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 306 - وحماد بن أبى 
ms182	 حميد(@)(@)(@@) (¬3) PageV02P197(@)(@@) مدينى وليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 307 - وحارثة بن أبى الرجال(@)(@)(@@) (¬1)(@)(@@) ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 308 - وحسين بن ضميرة(@)(@)(@@) (¬2)(@)(@@) كذاب ليس هو بشئ، وهو ابن أبى ضميرة.(@)(@)(@@)(@@)(@@) ||| AUTO 309 - والحكم بن ظهير(@)(@)(@@) (¬3) PageV02P198(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 310 - والحكم بن عبد الملك(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 311 - وحماد بن شعيب(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 312 - وحكيم بن جبير(@)(@)(@@) (¬3) PageV02P199(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 313 - وحبيب بن حسان(@)(@)(@@) (¬1)(@)(@@) ليس بثقة، وهو حبيب بن حسان بن أبى الأشرس، وهو حبيب بن أبى هلال، يروى عنه مروان الفزارى، قال: وكانت له جاريتان نصرانيتان فكان يذهب معهما [إلى] البيعة.(@)(@)(@@)(@@)(@@) ||| AUTO 314 - وحيان أخو مندل(@)(@)(@@) (¬2) PageV02P200(@)(@@) فيه ضعف.(@)(@)(@@)(@@)(@@) ||| AUTO 315 - وحسام بن مصك(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 316 - والحارث بن نبهان(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 317 - وحنظلة بن عبد الرحمن التيمى القاص(@)(@)(@@) (¬3) PageV02P201(@)(@@) ليس بشئ، روى عنه وكيع.(@)(@)(@@)(@@)(@@) ||| AUTO 318 - والحارث بن ثقف(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 319 - والحسن بن دينار(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 320 - والحسن الجفرى(@)(@)(@@) (¬3) PageV02P202(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 321 - والحارث بن عبيد(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 322 - والحسين بن علوان(@)(@)(@@) (¬2)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 323 - والحارث بن أفلح(@)(@)(@@) (¬3)(@)(@@) لم يكن ثقة.(@)(@)PageV02P203(@)(@)(@@)(@@)(@@) ||| AUTO 324 - وحمزة بن حمزة النصيبى(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ ولا يساوى فلسا.(@)(@)(@@)(@@)(@@) ||| AUTO 325 - وحميد بن مالك اللخمى(@)(@)(@@) (¬2)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 326 - وحاتم بن أنيس بن أبى يحيى(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 327 - حكيم بن الأثرم(@)(@)(@@) (¬4) PageV02P204(@)(@@) قال صدقة بن الفضل: حكيم بن الأثرم منكر الحديث، ولم أر أحدا من أصحابنا(@)(@@) حدث عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 328 - الحسن بن عمارة(@)(@)(@@) (¬1)(@)(@@) قال شهاب بن معمر: بلغنى أن الحسن بن عمارة اجتمع مع شعبة فى سفينة.(@)(@@) قال شعبة: فما زال يحدثنى عن الحكم حتى تمنيت أن السفينة تكفأت بنا فغرقنا.(@)(@)(@@)(@@)(@@) ||| AUTO 329 - حميد بن هلال(@)(@)(@@) (¬2)(@)(@@) قال ابن المدينى: قال يحيى: كان ابن سيرين لا يرضى حميد بن هلال.(@)(@)(@@)(@@)(@@) ||| AUTO 330 - حنظلة السدوسى(@)(@)(@@) (¬3) PageV02P205(@)(@@) قال: وذكر يحيى حنظلة السدوسى وقال: رأيته وتركته على عمد، قلت له: كان قد اختلط؟ ، قال: نعم.(@)(@)(@@)(@@)(@@) ||| AUTO 331 - حبيب صاحب عمرو بن هرم(@)(@)(@@) (¬1)(@)(@@) قال: وسألته عن حبيب صاحب عمرو بن هرم، قلت: 
ms183	 كتبت عنه شيئا؟ .(@)(@@) قال: نعم أتيته بكتابه فقرأه على فرميت به.(@)(@@) قال: ثم قال: كان من التجار ولم يكن فى الحديث بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 332 - حفص بن سليمان(@)(@)(@@) (¬2)(@)(@@) ابن حنبل قال: قال يحيى: أخبرني شعبة قال: أخذ منى حفص بن سليمان كتابا فلم يرده.(@)(@@) قال: وكان يأخذ كتب الناس فينسخها.(@)(@)PageV02P206(@)(@)(@@)(@@)(@@) ||| AUTO 333 - الحجاج بن نصير(@)(@)(@@) (¬1)(@)(@@) محمد بن نصر قال: سمعت سليمان يقول: الحجاج بن نصير ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 334 - حسين بن عبد الله(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين وسئل عن حسين بن عبد الله الذى يحدث عن عكرمة؟ ، قال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 335 - حارث النقال(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته وذكر له إنسان مرة حدثنا عن حارث النقال عن معمر فضعفه.(@)(@)(@@)(@@)(@@) ||| AUTO 336 - الحسين بن عبيد الله بن عباس(@)(@)(@@) (¬4)(@)(@@) أبو بكر قال: سمعت محمد بن الصباح يروى حديث شريك عن الحسين بن عبيد الله PageV02P207(@)(@@) ابن عباس حديث أم الولد (¬1)، فقال: الحسين هذا لين الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 337 - وحسين الرجى(@)(@)(@@) (¬2)(@)(@@) قال: وحسين الرحبى ضعيف، فقيل له: روى عنه التيمى، فقال: هو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 338 - الحارث بن شهاب(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: الحارث بن شهاب بصرى ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 339 - حرب بن أبى العالية(@)(@)(@@) (¬4) PageV02P208(@)(@@) قال: وسئل عن حرب بن أبى العاليه؟ فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 340 - حسين بن ذكوان(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: حسين بن ذكوان روى عنه هشيم والواسطيون، وهو واسطى ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 341 - حسين بن عبد الله بن عبيد الله بن العباس بن عبد المطلب(@)(@)(@@) (¬2)(@)(@@) قال: وسئل عن حسين بن عبد الله بن عبيد الله بن العباس بن عبد المطلب عن عكرمة، فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 342 - حبيب بن حسان(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: حبيب بن حسان كوفى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 343 - حصين بن عمر(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: حصين بن عمر روى عنه ابن الحمان ليس حديثه بشئ (¬5).(@)(@)PageV02P209(@)(@)(@@) [ .................... ] (¬1)(@)(@)(@@)(@@)(@@) ||| AUTO 344 - الحكم بن عبد الملك(@)(@)(@@) (¬2)(@)(@@) قال أبو حاتم الرازى: الحكم بن عبد الملك صاحب قتادة ليس بالقوى (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 345 - وحسين بن الحسن 
ms184	(@)(@)(@@) (¬4)(@)(@@) قال: وحسين بن الحسن صاحب الأشعرى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 346 - حارثة(@)(@)(@@) (¬5)(@)(@@) قال: وسثل أحمد بن حنبل عن افتتاح الصلاة هل فيه حديث صحيح؟ .(@)(@@) ققال: أما أعلمه فى الفريضة، قلت له: حديث حارثة، فقال: حارثة؟ كأنه لم يرضه (¬6).(@)(@)PageV02P210(@)(@)(@@)(@@)(@@) ||| AUTO 347 - وحفص بن سليمان الكوفى(@)(@)(@@) (¬1)(@)(@@) قال: وحفص بن سليمان الكوفى حديثه يكتب ولا يحتج به (¬2)(@)(@)(@@)(@@)(@@) ||| AUTO 348 - حبيب بن أبى الأشرس(@)(@)(@@) (¬3).(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 349 - وحميد الأعرج(@)(@)(@@) (¬4).(@)(@@) قال: وحميد الأعرج عن عبد الله بن الحارث ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 350 - والحارث بن شبل(@)(@)(@@) (¬5)(@)(@@) عن أم النعمان ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 351 - والحارث(@)(@)(@@) (¬6).(@)(@@) ضعيف الحديث.(@)(@)PageV02P211(@)(@)(@@)(@@)(@@) ||| AUTO 352 - وحسين بن على الهاشمى(@)(@)(@@) (¬1)(@)(@@) عن الأعرج ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 353 - الحكم بن سنان أبو عوف البصرى(@)(@)(@@) (¬2)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 354 - والحكم بن عبد الله بن سعد(@)(@)(@@) (¬3)(@)(@@) متروك الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 355 - وحسين بن واقد الخراسانى(@)(@)(@@) (¬4) PageV02P212(@)(@@) ليس بالقوى، كان فى حديثه بعض الصنعة.(@)(@)(@@)(@@)(@@) ||| AUTO 356 - حسين بن عبد الله بن ضمرة(@)(@)(@@) (¬1)(@)(@@) أبو حاتم قال: سمعت عبد العزيز بن عبد الله الأويسى العامرى يقول: لما خرج إسماعيل بن أويس إلى حسين بن عبد الله بن ضمرة فرجع، بلغ مالك بن أنس فهجره أربعين يوما (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 357 - وحماد بن عمرو النصيبى(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 358 - وحنظلة بن عبد الله بن أبى عبد الرحمن السدوسى(@)(@)(@@) (¬4) PageV02P213(@)(@@) يعد فى البصريين عن أنس ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 359 - وحمزة بن نجيح(@)(@)(@@) (¬1)(@)(@@) أبو عمار، سمع الحسن، ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 360 - وحريش بن خريت(@)(@)(@@) (¬2)(@)(@@) أخو الزبير بن حريث ليس عندى بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 361 - وحشرج بن نباتة(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 362 - وحسن اللؤلؤى(@)(@)(@@) (¬4)(@)(@)PageV02P214(@)(@)(@@)(@@)(@@) ||| CHECK 363 - وحفص بن المختار الواسطى(@)(@)(@@) قال: وحسن اللؤلؤى متروك الحديث.(@)(@)(@@) 363 - وحفص بن المختار (¬1) الواسطى (¬2)(@)(@@) ضعيف الحديث، رأيت أبا الوليد الطيالسى يتكلم فيه (¬3).(@)(@@) قال: وسمعت أبا الوليد الطيالسى، وذكر عنده حفص الإمام فقال: قال لى أبى (¬4) [لم] يسمع (¬5) من أبى سنان الشيباني إلا حديثا واحدا، فقدمنا (¬6) البصرة فحدثهم بأحاديث كثيرة عن أبى سنان (¬7).(@)(@)(@@)(@@)(@@) || AUTO حرف: خ(@)(@)(@@)(@@)(@@) ||| AUTO 364 - خارجة بن مصعب 
ms185	(@)(@)(@@) (¬8) PageV02P215(@)(@@) يحيى بن معين قال: خارجة بن مصعب ليس هو شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 365 - خصيب بن جحدر(@)(@)(@@) (¬1)(@)(@@) على بن المدينى قال: سمعت يحيى وذكر خصيب بن جحدر فقال: كان يروى ثلاثة عشر أو أربعة عشر حديثا، قال يحيى: فحدثت بها شعبة فقال: فى نفسى من حديث هذا شئ، فلما كثرت قال شعبة: ألم أقل لك.(@)(@)(@@)(@@)(@@) ||| AUTO 366 - خلاس(@)(@)(@@) (¬2)(@)(@@) على قال: سمعت الوليد بن خالد (¬3) أبا العباس الأعرابى صاحب الهروى قال: قال لى شعبة [قال لى أيوب: لا تروى عن خلاس فإنه صحفى، ثم قال لى بعد ذلك: فإنى أراه صحفيا] (¬4).(@)(@)PageV02P216(@)(@)(@@)(@@)(@@) ||| AUTO 367 - خيثمة بن أبى خيثمة(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة قال: كتب يحيى بن معين على خيثمة بن أبى خيثمة فى حديث جرى ذكره بيده ضعيف.(@)(@@) وروى خيثمة بن أبى خيثمة عن الحسن: كنت أمشى مع عمران بن الحصين وابن المدينى يقول: سمعت يحيى بن سعيد وسئل: أكان الحسن يقول: سمعت عمران بن حصين؟ ، فقال: أما عن ثقة فلا.(@)(@)(@@)(@@)(@@) ||| AUTO 368 - خالد الحذاء(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: كان خالد الحذاء على العشور. قال: وقال يحيى: قال شعبة: خالد يشك فى حديث عكرمة عن ابن عباس - يعنى أحاديث عكرمة.(@)(@)(@@)(@@)(@@) ||| AUTO 369 - خالد بن محدوج الواسطى(@)(@)(@@) (¬3)(@)(@@) وقال أبو حاتم الرازى: خالد محدوج الواسطى أبو روح، رأى أنسا ضعيف الحديث.(@)(@)PageV02P217(@)(@)(@@)(@@)(@@) ||| AUTO 370 - وخالد الإسكاف(@)(@)(@@) (¬1)(@)(@@) وقال يحيى بن معين: وخالد الإسكاف ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 371 - وخيثمة البصرى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 372 - وخالد بن إلياس(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 373 - وخالد بن عمرو السعيدى(@)(@)(@@) (¬4)(@)(@)PageV02P218(@)(@)(@@)(@@)(@@) || CHECK حرف: د(@)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 374 - خصيف(@)(@)(@@) (¬1)(@)(@@) قال ابن المدينى: سمعت يحيى يقول: كنا تلك الأيام نجتنب حديث خصيف.(@)(@)(@@)(@@)(@@) ||| AUTO 375 - داود الأودى(@)(@)(@@) (¬2)(@)(@@) قال يحيى: داود الأودى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 376 - وداود بن الزبرقان(@)(@)(@@) (¬3) PageV02P219(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 377 - دهيم بن عمران(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 378 - دلهم بن صالح(@)(@)(@@) (¬2)(@)(@@) ضعيف.(@)(@)PageV02P220(@)(@)(@@)(@@)(@@) ||| AUTO 379 - داود بن الزبرقان(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ، روى عنه ابن أبى عروبة.(@)(@)(@@)(@@)(@@) ||| AUTO 380 - داود بن عبد الجبار(@)(@)(@@) (¬2)(@)(@@) قال: داود 
ms186	 بن عبد الجبار كان ينزل باب الطاق، وكان يكذب، وقد رأيته.(@)(@)(@@)(@@)(@@) ||| AUTO 381 - داود بن فراهيج(@)(@)(@@) (¬3)(@)(@@) قال ابن المدينى: سمعت يحيى وذكر داود ابن فراهيج، فقال: كان شعبة يضعفه.(@)(@)(@@)(@@)(@@) ||| AUTO 382 - دينار بن قائد(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: دينار بن قائد ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 383 - داود بن محبر(@)(@)(@@) (¬5) PageV02P221(@)(@@) قال أبو حاتم الرازى: داود بن محبر ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 384 - درست بن زياد(@)(@)(@@) (¬1)(@)(@@) شيح يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 385 - دراج أبو السمح(@)(@)(@@) (¬2)(@)(@@) ليس بقوى الحديث.(@)(@)(@@)(@@)(@@) || AUTO حرف: ذ(@)(@)(@@)(@@)(@@) ||| AUTO 386 - ذواد بن علية(@)(@)(@@) (¬3) PageV02P222(@)(@@) قال يحيى: ذواد بن علية ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO حرف: ر(@)(@)(@@)(@@)(@@) ||| AUTO 387 - ركين الضبي(@)(@)(@@) (¬1)(@)(@@) على بن المدينى قال: سألت جريرا عن ركين الذي روى عنه سفيان (¬2) فقال: قد رأيته، هو ركين بن عبد الأعلى، قال: لم يكن ممن يؤخذ عنه الحديث، وكان عريفا، ولم يكن يرتفع بحديثه، وكان مغفلا.(@)(@)(@@)(@@)(@@) ||| AUTO 388 - روح بن أسلم(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين عن روح بن أسلم فقال: ليس بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 389 - رشد [ين] بن سعد(@)(@)(@@) (¬4) PageV02P223(@)(@@) قال أبو حاتم الرازى: رشد [ين] بن سعد أبو الحجاج الفهرى ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 390 - راشد بن معبد الواسطى(@)(@)(@@) (¬1)(@)(@@) عن أنس يروى عنه زيد بن الحباب يقال له: راشد البدن ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 391 - رباح بن عبيد الله بن عمر العمرى(@)(@)(@@) (¬2) PageV02P224(@)(@@) قال: وبلغنى عن أحمد بن حنبل أنه ذكر رباح بن عبيد الله بن عمر العمرى فقال:(@)(@@) كان يكذب.(@)(@)(@@)(@@)(@@) ||| AUTO 392 - رشدين بن كريب(@)(@)(@@) (¬1)(@)(@@) قال يحيى بن معين: رشدين بن كريب مولى ابن عباس مدينى ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 393 - والربيع بن سليمان(@)(@)(@@) (¬2)(@)(@@) صاحب لمازة (¬3): ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 394 - روح بن مسافر(@)(@)(@@) (¬4) PageV02P225(@)(@@) بصرى وهو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 395 - راشد بن معبد(@)(@)(@@) (¬1)(@)(@@) واسطى روى عنه عن أنس وسمع منه زيد بن حباب.(@)(@)(@@)(@@)(@@) ||| AUTO 396 - الربيع(@)(@)(@@) (¬2)(@)(@@) قال ابن المدينى: سألت يحيى عن الربيع الذي روى عن الحسن، وعن حفص، وقلت: إن عبد الرحمن يثنى عليه خيرا، قال يحيى: أنا أعلم [به] وجعل 
ms187	 يضرب فخذه تعجبا من عبد الرحمن (¬3).(@)(@)(@@)(@@)(@@) || AUTO حرف: ز(@)(@)(@@)(@@)(@@) ||| AUTO 397 - زمعة بن صالح(@)(@)(@@) (¬4) PageV02P226(@)(@@) قال: زمعة بن صالح ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 398 - وزكريا(@)(@)(@@) (¬1)(@)(@@) الذي يقال له الحبطى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 399 - وزياد بن أبى عمار(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 400 - والزبير بن سعيد(@)(@)(@@) (¬3) PageV02P227(@)(@@) ليس بشئ، روى عنه جرير بن حازم وأبو عاصم النبيل.(@)(@)(@@)(@@)(@@) ||| AUTO 401 - وزهير بن إسحاق(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، قد روى عنه معتمر، وروى هو عن يونس.(@)(@)(@@)(@@)(@@) ||| AUTO 402 - زياد بن أبى زياد الجصاص(@)(@)(@@) (¬2)(@)(@@) واسطى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 403 - زياد أبو السكن(@)(@)(@@) (*) (¬3) PageV02P228(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 404 - زياد أبو عمر(@)(@)(@@) (¬1)(@)(@@) قال ابن المدينى: قلت ليحيى: إن عبد الرحمن يثبت شيخين من أهل البصرة، قال: من هما؟ ، قلت: زياد أبو عمر، فحرك رأسه وقال: كان يروى حديثين أو ثلاثة، ثم جاءت بعد أشياء، وكان شيخا مغفلا.(@)(@)(@@)(@@)(@@) ||| AUTO 405 - زهير الذي روى عنه أبو عمران الجونى(@)(@)(@@) أحمد قال: سمعت أبا عبيد يقول: زهير الذي روى عنه أبو عمران الجونى، هو أبو الصقعب والعلاء ابنى زهير، وكان واليا أظنه بهراة.(@)(@)(@@)(@@)(@@) ||| AUTO 406 - زاذان(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة: حدثنا أحمد بن حنبل قال: أخبرت عن ابن إدريس، عن شعبة قال: سألت الحكم عن زاذان فقال: أكثر وسألت سلمة فقال: أبو البحترى أعجب (¬3) إلى منه، وهو زاذان الكندى أبو عمر.(@)(@)(@@)(@@)(@@) ||| AUTO 407 - زياد بن أبى حسان(@)(@)(@@) (¬4) PageV02P229(@)(@@) على ما ذكر عند يحيى زياد بن أبى حسان النبطى، فقال: سألت شعبة عن بعض من ذكرتم ققال: أشهد لكان نصرانيا فى حياة أنس بن مالك.(@)(@)(@@)(@@)(@@) ||| AUTO 408 - زياد أبو عمرو(@)(@)(@@) (¬1)(@)(@@) قال: وقلت ليحيى: إن عبد الرحمن قال: إن زياد أبا عمرو كان بيننا، فعوج يحيى فمه وقال: شيخ لا بأس به، فأما الحديث فلا.(@)(@)(@@)(@@)(@@) ||| AUTO 409 - [زياد مولى بنى مخزوم](@)(@)(@@) (¬2)(@)(@@) قال ابن أبى خيثمة: سئل يحيى بن معين عن [ ........... ] (¬3) لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 410 - زياد البكائى(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: زياد البكائى صاحب "المغازى" ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 411 - زياد النميرى(@)(@)(@@) (¬5) PageV02P230(@)(@@) قال: وسئل عن زياد النميرى، عن أنس فقال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 412 
ms188	 - زيد العمى(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: حديث زيد العمى لا يجوز، وكان أمثل من زيد الرقاشى، قال أبو حاتم الرازى: كان سعيد يحدث عن زيد العمى ويحسه قليلا.(@)(@)(@@)(@@)(@@) ||| AUTO 413 - زياد بن ميمون(@)(@)(@@) (¬2)(@)(@@) قال: وزياد الذي يحدث عن أنس فقال: إنه كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 414 - زياد بن محمد(@)(@)(@@) (¬3)(@)(@@) قال: وزياد بن محمد عن محمد بن كعب القرظى ليس بالقوى.(@)(@)PageV02P231(@)(@)(@@)(@@)(@@) || AUTO حرف: س(@)(@)(@@)(@@)(@@) ||| AUTO 415 - سلمة بن وردان(@)(@)(@@) (¬1)(@)(@@) قال يحيى: سلمة بن وردان ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 416 - سعيد بن محمد الوراق(@)(@)(@@) (¬2)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 417 - وسليمان بن أرقم(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@@) قال ابن إسماعيل: هو متروك الحديث، وروى عن الحسن وروى عنه الزهرى، وقال يحيى مرة أخرى: هو أبو معاذ ليس يساوى فلسا.(@)(@)PageV02P232(@)(@)(@@)(@@)(@@) ||| AUTO 418 - سليمان بن يسير(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@@) وقال ابن إسماعيل: هو أبو الصباح ضعيف، قال: وكان الثورى يقول: سليمان بن قسيم.(@)(@)(@@)(@@)(@@) ||| AUTO 419 - سلمة بن رجاء(@)(@)(@@) (¬2)(@)(@@) قال يحيى: وسلمة بن رجاء كوفى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 420 - سلم بن زرير(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)PageV02P233(@)(@)(@@)(@@)(@@) ||| AUTO 421 - وسليمان بن معاذ(@)(@)(@@) (¬1)(@)(@@) ليس بشئ روى عنه أبو داود الطيالسى.(@)(@)(@@)(@@)(@@) ||| AUTO 422 - سوار بن مصعب(@)(@)(@@) (¬2)(@)(@@) هو سوار الأعمى ضعيف.(@)(@@) وقال مرة: ليس بشئ، قال ابن إسماعيل: هو منكر الحديث سمع كليب بن وائل.(@)(@)(@@)(@@)(@@) ||| AUTO 423 - سليم مولى الشعبى(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 424 - وسليمان بن قرم(@)(@)(@@) (¬4) PageV02P234(@)(@@) يحدث عن الأعمش وكان ضعيفا.(@)(@)(@@)(@@)(@@) ||| AUTO 425 - وسعد الإسكاف(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 426 - سيف بن هارون(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 427 - سليمان بن مسلم الخشاب(@)(@)(@@) (¬3) PageV02P235(@)(@@) كان ينزل مكة وكان جهميا خبيثا، ووجدت فى موضع آخر: سليمان بن مسلم الذي يقال له الخاشب ليس بثقة، فلست أدرى هو هذا أو هو غيره.(@)(@)(@@)(@@)(@@) ||| AUTO 428 - سعد بن طريف(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 429 - سيف بن عمر الضبي(@)(@)(@@) (¬2)(@)(@@) ضعيف يحدث عنه المحاربى.(@)(@)(@@)(@@)(@@) ||| AUTO 430 - سيف بن محمد ابن أخت سفيان الثورى(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 431 - سلام بن عمرو(@)(@)(@@) (¬4) PageV02P236(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 432 - سليمان بن الحكم بن عوانة(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 433 - وسعيد بن زربى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 434 - وسعيد 
ms189	 بن السماك(@)(@)(@@) (¬3)(@)(@@) الذي يروى عنه من أذن فهو يقيم ليس بشئ.(@)(@)PageV02P237(@)(@)(@@)(@@)(@@) ||| AUTO 435 - سعيد بن زيد(@)(@)(@@) (¬1)(@)(@@) قال على: ضعف يحيى بن سعيد، سعيد بن يزيد أخا حماد بن زيد وأخذ شيئا من الأرض فقال: ما يسوى هذا.(@)(@)(@@)(@@)(@@) ||| AUTO 436 - سيف بن وهب(@)(@)(@@) (¬2)(@)(@@) على قال: سألت يحيى عن سيف بن وهب فحمض وجهه وقال: كان سيف هالكا من الهلكى.(@)(@)(@@)(@@)(@@) ||| AUTO 437 - سليمان بن سفيان(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سئل ابن معين عن سليمان بن سفيان الذي روى عنه أبو عامر (¬4) العقدى فقال: ليس بشئ.(@)(@)PageV02P238(@)(@)(@@)(@@)(@@) ||| AUTO 438 - سالم الخياط(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 439 - سهل أخو حزم(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول سهل أخو حزم ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 440 - سلام أبو المنذر(@)(@)(@@) (¬3)(@)(@@) قال: وسئل عن سلام أبى المنذر؟ فقال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 441 - سهيل بن ذكوان(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: سهل بن ذكوان ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 442 - سليمان بن داود(@)(@)(@@) (¬5) PageV02P239(@)(@@) قال: وسئل عن سليمان بن داود الذي يحدث عن الزهرى (¬1) روى عنه يحيى بن حمزة فقال: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 443 - سهل بن معاذ بن أنس(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: سهل بن معاذ بن أنس عن أبيه ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 444 - سنان بن هارون(@)(@)(@@) (¬3) PageV02P240(@)(@@) قال: وسمعته يقول: سنان بن هارون ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 445 - سلم العلوى(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته وسئل عن سلم العلوى فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 446 - سلام الطويل(@)(@)(@@) (¬2)(@)(@@) أبو حاتم الرازى قال: سلام الطويل ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 447 - سعيد بن سنان(@)(@)(@@) (¬3) PageV02P241(@)(@@) قال: وسعيد بن سنان أبو المهدى ليس بذاك، يكثر الرواية عن أبى الزاهرية، عن كثير ابن مرة، عن ابن عمر، عن النبى - صلى الله عليه وسلم - بالمناكير.(@)(@)(@@)(@@)(@@) ||| AUTO 448 - سفيان بن وكيع(@)(@)(@@) (¬1)(@)(@@) وسئل عن سفيان بن وكيع فقال: كان أبوه ثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 449 - سالم بن أبى حفصة(@)(@)(@@) (¬2)(@)(@@) أبو يونس يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 450 - سيف بن هارون(@)(@)(@@) (¬3)(@)(@@) وأخوه سنان لا يحتج بحديثهما.(@)(@)(@@)(@@)(@@) ||| AUTO 451 - سعيد بن راشد السماك(@)(@)(@@) (¬4)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 452 - سعيد بن سلام البصرى(@)(@)(@@) (¬5) PageV02P242(@)(@@) عن الثورى ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 453 - سلام بن أبى خبزة 
ms190	(@)(@)(@@) (¬1)(@)(@@) هو أبوه روى عنه وكيع، ليس بالقوى ويقال له: سلام العطار.(@)(@)(@@)(@@)(@@) ||| AUTO 454 - سعيد بن ميسرة(@)(@)(@@) (¬2)(@)(@@) سمع أنسا، ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 455 - سليمان بن عطاء(@)(@)(@@) (¬3) PageV02P243(@)(@@) روى عنه يحيى بن صالح الشامى، والنفيلى، وعثمان بن عبد الرحمن الحرانى، ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 456 - سلمة بن الفضل الأبرش(@)(@)(@@) (¬1)(@)(@@) يكذب حديثه ولا يحتج به، وكان قاضى الرى.(@)(@)(@@)(@@)(@@) ||| AUTO 457 - سعيد بن بشير(@)(@)(@@) (¬2)(@)(@@) يكتب حديثه ولا يحتج به روى عنه هشيم.(@)(@@) [ ........ ] (¬3).(@)(@@) عنه كانوا ينكرون عليه فى القدر، قال يحيى بن معين: سعيد بن بشير ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 458 - سالم بن العلاء(@)(@)(@@) (¬4)(@)(@@) يضعف.(@)(@)(@@)(@@)(@@) ||| AUTO 459 - سليمان بن أبى سليمان القافلانى(@)(@)(@@) (¬5) PageV02P244(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 460 - سنان بن ربيعة(@)(@)(@@) (¬1)(@)(@@) ليس بالقوى، قال ابن إسماعيل: روى عن أنس، وشهر، وروى عنه حماد بن زيد وغيره.(@)(@)(@@)(@@)(@@) ||| AUTO 461 - سلم بن سالم(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 462 - سلام بن سلم التميمى(@)(@)(@@) (¬3)(@)(@@) ليس بشئ، قال ابن إسماعيل: سلام بن سلم تركوه، روى عن زيد العمى.(@)(@)(@@)(@@)(@@) ||| AUTO 463 - سويد الدمشقى(@)(@)(@@) (¬4) PageV02P245(@)(@@) ليس حديثه بشئ، وهو ابن عبد العزيز، كان يقضي بين النصارى بدمشق، وكان(@)(@@) قاضى المسلمين رجلا آخر، قال ابن إسماعيل: فى بعض حديثه نظر.(@)(@)(@@)(@@)(@@) ||| AUTO 464 - السرى بن إسماعيل(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 465 - سهيل بن أبى فرقد(@)(@)(@@) (¬2)(@)(@@) قال ابن إسماعيل: هو منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 466 - سليمان بن يزيد(@)(@)(@@) (¬3)(@)(@@) أبو آدم المحاربى (¬4) سمع ابن أبى أوفى روى عنه وكيع، ومروان، وعبيد الله، قال PageV02P246(@)(@@) ابن إسماعيل: قال الدارمى: وهو أحسن حالا من أبى أسير وليس بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 467 - سليمان بن عمرو(@)(@)(@@) (¬1)(@)(@@) قال ابن إسماعيل: هو متروك الحديث، قال: وكان كتابا فيما قال قتيبة.(@)(@)(@@)(@@)(@@) || AUTO حرف: ش(@)(@)(@@)(@@)(@@) ||| AUTO 468 - شريك بن عبد الله بن أبى نمر(@)(@)(@@) (¬2)(@)(@@) قال: شريك بن عبد الله بن أبى نمر ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 469 - شرحبيل(@)(@)(@@) (¬3) PageV02P247(@)(@@) قال: حدثنا حجاج، عن ابن أبى ذئب قال: كان شرحبيل متهما، وقال مرة: ابن شرحبيل بن سعد سمع من ابن عمر، وأبى هريرة، وجابر بن عبد الله، وسمع منه أبو معشر، وفطر، وهو ليس بشئ، هو ضعيف، قال ابن 
ms191	 إسماعيل: روى شرحبيل عن زيد ابن ثابت، وأبى هريرة، وجابر، وأبى سعيد، وروى عنه يحيى بن سعيد، وابن أبى ذئب، وروى عنه مخول بن راشد وكناه أبا سعيد، قال: وكان عالما بالمغازى فاحتاج (*) فاتهموه.(@)(@)(@@)(@@)(@@) ||| AUTO 470 - شعبة(@)(@)(@@) (¬1)(@)(@@) قال ابن إسماعيل: حدثنا ابن عمار قال: حدثنا بشر بن عمر قال: سألت مالكا عن شعبة الذى روى عن ابن عباس فقال: ليس بثقة [فلا تأخذن عنه شيئا] (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 471 - شقيق الضبى القاضى(@)(@)(@@) (¬3)(@)(@@) قال ابن إسماعيل: حدثنا أحمد بن عبدة، حدثنا حماد بن زيد عن عاصم قال: كنا نأتى [أبا] (¬4) عبد الرحمن السلمى ونحن غلمة أيفاع فيقول لنا: إياكم وشقيق، وسعد بن عبيدة (¬5).(@)(@)PageV02P248(@)(@)(@@)(@@)(@@) ||| AUTO 472 - شملة بن هزال(@)(@)(@@) (¬1)(@)(@@) شملة بن هزال، أبو داود قال: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 473 - شبابة بن سوار(@)(@)(@@) (¬2)(@)(@@) ذكر ذلك ابن إسماعيل عن يحيى قال: صحف شبابة صاحب عبد الله أحاديثه مناكير، قال أبو حاتم الرازى: شبابة بن سوار يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) || AUTO حرف: ص(@)(@)(@@)(@@)(@@) ||| AUTO 474 - صالح مولى التوأمة(@)(@)(@@) (¬3)(@)(@@) إبراهيم بن عرعرة قال: قال سفيان بن عيينة: لقينا صالح مولى التوأمة وهو مختلط، PageV02P249(@)(@@) وهو صالح بن نبهان مولى أم سلمة، وصالح مولى التوأمة خرف قبل الوت، وقال ابن إسماعيل: وسمع منه ابن عيينة، وقد كثر فلم يحدث عنه، ويقال: إن الثورى سمع منه بعد ابن عيينة، قال: وحدثنا ابن عمار، حدثنا بشير بن عمر قال: سألت مالك عن صالح مولى التوأمة فقال: ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 475 - صالح المرى(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: صالح المرى ضعيف الحديث، قال العباس: لم أر ليحيى فى صالح المرى كثير رأى.(@)(@)(@@)(@@)(@@) ||| AUTO 476 - صدقة بن موسى(@)(@)(@@) (¬2)(@)(@@) قال: وسئل عن صدقة بن موسى، وقيل له: روى عنه يزيد بن هارون؟ ، فقال: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 477 - صالح بن أبى الأخضر(@)(@)(@@) (¬3) PageV02P250(@)(@@) قال يحيى بن معين: صالح بن أبى الأخضر ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 478 - صالح الطلحى(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 479 - صالح بن محمد بن زائدة(@)(@)(@@) (¬2)(@)(@@) ضعيف. قال ابن إسماعيل: هو 
ms192	 أبو قدامة، ويقال أبو واقد الليثى من أنفسهم، قال: وتركه سليمان بن حرب وهو منكر الحديث، روى عن سعيد وأبى سلمة وعمر بن عبد العزيز.(@)(@)(@@)(@@)(@@) ||| AUTO 480 - صاعد مولى الشعبى(@)(@)(@@) (¬3) PageV02P251(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 481 - صالح بن حيان(@)(@)(@@) (¬1)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 482 - الصلت بن دينار(@)(@)(@@) (¬2)(@)(@@) ليس بشئ، قال ابن إسماعيل: قال أبو حفص: كان يحيى وعبد الرحمن لا يحدثان عن الصلت بن دينار.(@)(@)(@@)(@@)(@@) ||| AUTO 483 - صبيح(@)(@)(@@) (¬3) PageV02P252(@)(@@) قال العباس: سمعت يحيى وأنبأنا خيثمة يقولان: كان صبيح ينزل الخلد وكان كذابا.(@)(@)(@@)(@@)(@@) ||| AUTO 484 - صغدى البصرى(@)(@)(@@) (¬1)(@)(@@) قال يحيى: وصغدى البصرى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 485 - صالح المرى(@)(@)(@@) (¬2)(@)(@@) قال العباس: لم أر ليحيى فى صالح المرى كثير رأى.(@)(@)(@@)(@@)(@@) ||| AUTO 486 - صلة بن سليمان(@)(@)(@@) (¬3)(@)(@@) قال: وصلة بن سليمان واسطى، وكان ببغداد، وكان كذابا.(@)(@)(@@)(@@)(@@) ||| AUTO 487 - صالح بن حسان(@)(@)(@@) (¬4) PageV02P253(@)(@@) ليس حديثه بشئ، قال ابن إسماعيل: عن عثمان، عن يحيى بن معين قال: هو ضعيف، روى عنه أبو بكر بن عياش.(@)(@)(@@)(@@)(@@) ||| AUTO 488 - صالح بن عبد الله بن صالح(@)(@)(@@) (¬1)(@)(@@) قال ابن إسماعيل: صالح بن أبى صالح منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 489 - صالح بن رستم(@)(@)(@@) (¬2)(@)(@@) قال: وقال ابن علية: صالح بن رستم أبو عامر لم يكن يحفظ.(@)(@)(@@)(@@)(@@) ||| AUTO 490 - صالح بن بشير أبو بشر المرى(@)(@)(@@) (¬3)(@)(@@) قال: وصالح بن بشير أبو بشر المرى منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 491 - صالح بن [ .... ](@)(@)(@@) .(@)(@)PageV02P254(@)(@)(@@) [ ............. ] (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 492 - صاعد اليشكرى(@)(@)(@@) (¬2)(@)(@@) قال ابن إسماعيل: قال أبو حفص: صاعد اليشكرى متروك الحديث.(@)(@@) قال: وكان يحيى وعبد الرحمن يحدثان عن سفيان، عن صاعد هذا.(@)(@)(@@)(@@)(@@) || AUTO حرف: ض(@)(@)(@@)(@@)(@@) ||| AUTO 493 - الضحاك بن نبراس(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى ين معين يقول: الضحاك بن نبراس ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 494 - ضرار بن صرد(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: ضرار بن صرد أبو نعيم، كذاب يسرق الأحاديث ويرويها.(@)(@)PageV02P255(@)(@)(@@) قال: وسمعت الحمانى يقول: لا يكتب عن ضرار فإنه ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 495 - الضحاك بن يسار(@)(@)(@@) (¬1)(@)(@@) قال يحيى: الضحاك بن يسار يضعفه البصريون.(@)(@)(@@)(@@)(@@) || AUTO حرف: ط(@)(@)(@@)(@@)(@@) ||| AUTO 496 - طلحة بن عمرو(@)(@)(@@) (¬2)(@)(@@) قال يحيى: طلحة بن عمرو ليس بشئ، 
ms193	 وقال مرة أخرى: هو ضعيف.(@)(@@) قال ابن إسماعيل: قال الدورى: سمعت أحمد بن حنبل يقول: لا يكتب حديث طلحة بن عمرو.(@)(@)(@@)(@@)(@@) ||| AUTO 497 - طارق بن عبد الرحمن(@)(@)(@@) (¬3) PageV02P256(@)(@@) قال يحيى: طارق بن عبد الرحمن ليس بأقوى عندى من ابن حرمله، قال: فقلت له: ما رأيت من ابن حرملة؟ ، قال: لو شئت أن ألقنه شيئا، قلت: كان يلقن؟ ، قال: نعم.(@)(@)(@@)(@@)(@@) ||| AUTO 498 - طلحة بن عمرو(@)(@)(@@) (¬1)(@)(@@) قال: وقال ابن عمار: طلحة بن عمرو ضعيف، قال: وقال حفص: كان يحيى وعبد الرحمن لا يحدثان عن طلحة بن عمرو.(@)(@)(@@)(@@)(@@) ||| AUTO 499 - طلحة بن زيد الرقى(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت ابن عمار يقول: ألقى المعافى بن عمران من رجاله طلحة بن زيد الرقى، قال: وكتب إلى وكيع ينهاه أن يحدث عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 500 - طريف بن سفيان بن أبى سفيان السعدى(@)(@)(@@) (¬3)(@)(@@) قال: وقال حفص بن شهاب روى أبو فضل عن طريف بن سفيان بن أبى سفيان السعدى وليس بالقوى، روى عن الحسن وأبى نضرة.(@)(@)(@@)(@@)(@@) ||| AUTO 501 - طلحة بن يحيى(@)(@)(@@) (¬4)(@)(@)PageV02P257(@)(@)(@@)(@@)(@@) || CHECK حرف: ظ، وحرف: ع(@)(@)(@@) قال ابن المدينى: سمعت يحيى يقول: لم يكن طلحة بن يحيى بالقوى.(@)(@)(@@) حرف: ظ (¬1)، وحرف: ع(@)(@)(@@)(@@)(@@) ||| AUTO 502 - عبد الله بن مسلم بن هرمز(@)(@)(@@) (¬2)(@)(@@) قال عبد الله بن مسلم بن هرمز: مكى ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 503 - عبد الله بن سعيد المقبرى(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 504 - عمر بن قيس المكى(@)(@)(@@) (¬4)(@)(@@) لقبه سندل وهو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 505 - على بن زيد(@)(@)(@@) (¬5)(@)(@@) ليس بشئ.(@)(@)PageV02P258(@)(@)(@@)(@@)(@@) ||| AUTO 506 - عبيد الله بن أبى زياد القداح(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@@) قال: قلت له: هو أخو سعيد القداح؟ ، قال: لا والله ما بينهما نسب.(@)(@)(@@)(@@)(@@) ||| AUTO 507 - عمر بن عطاء بن وراز(@)(@)(@@) (¬2)(@)(@@) يضعفونه.(@)(@)(@@)(@@)(@@) ||| AUTO 508 - عمرو بن مسلم(@)(@)(@@) (¬3)(@)(@@) صاحب طاووس ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 509 - عمرو بن برق(@)(@)(@@) (¬4)(@)(@@) كان أبوه سأل عكرمة أن يتعاهده، وكان يشرب، فكان عكرمة يقول: اطلبوه فإذا PageV02P259(@)(@@) جاؤا به قال له: لعلك ممن يقول:(@)(@@) أصبب على كبدك (¬1) من بردها ... إنى أرى الناس يموتون(@)(@@) قال العباس: قلت ليحيى: إنى أرى الناس يموجون، قال: لا، إنى أرى الناس 
ms194	 يموتون.(@)(@)(@@)(@@)(@@) ||| AUTO 510 - عمرو بن أبى عمرو(@)(@)(@@) (¬2)(@)(@@) قال: وعمرو بن أبى عمرو: ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 511 - عبد الرحمن بن عبد الله بن عمر(@)(@)(@@) (¬3)(@)(@@) ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 512 - عبد الجبار بن عمر الأيلى(@)(@)(@@) (¬4) PageV02P260(@)(@@) ضعيف، وقال مرة: ليس بشئ يروى عنه ابن وهب.(@)(@)(@@)(@@)(@@) ||| AUTO 513 - عبد الرحمن بن زيد بن أسلم(@)(@)(@@) (¬1)(@)(@)(@@)(@@)(@@) ||| AUTO 514 - عبد الله بن زيد(@)(@)(@@) (¬2)(@)(@@) يضعفان.(@)(@)(@@)(@@)(@@) ||| AUTO 515 - عبد الكريم بن أبى أمية(@)(@)(@@) (¬3)(@)(@@) بصرى ضعيف روى عنه مالك بن أنس، وقال مرة: ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 516 - عاصم بن عبيد الله(@)(@)(@@) (¬4)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 517 - عمرو بن أبى عمرو(@)(@)(@@) (¬5)(@)(@@) يروى عنه مالك بن أنس كان يستضعفه.(@)(@)PageV02P261(@)(@)(@@)(@@)(@@) ||| AUTO 518 - عبد الله بن نافع(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 519 - عاصم بن عمر(@)(@)(@@) (¬2)(@)(@@) صاحب عبد الله بن دينار صاحب [حديث] (¬3): "من أضحى للشمس محرما" (¬4) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 520 - عبد الرحمن بن عبد الله العمرى(@)(@)(@@) (¬5)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 521 - عبد الرحمن بن مجبر(@)(@)(@@) (¬6)(@)(@@) ليس بشئ.(@)(@)PageV02P262(@)(@)(@@)(@@)(@@) ||| AUTO 522 - عامر بن صالح(@)(@)(@@) (¬1)(@)(@@) لم يكن حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 523 - عبد الرحمن بن أبى الزناد(@)(@)(@@) (¬2)(@)(@@) وابن أبى الزناد: لا يحتج بحديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 524 - عبد الله بن ميسرة(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث، روى عنه هشيم ووكيع، وكان هشيم يدلسه بكنيته، ويغير كناه أيضا.(@)(@)(@@)(@@)(@@) ||| AUTO 525 - عبد العزيز بن أبان(@)(@)(@@) (¬4)(@)(@@) ليس بشئ.(@)(@)PageV02P263(@)(@)(@@)(@@)(@@) ||| AUTO 526 - على بن ظبيان(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 527 - عمرو بن شمر(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 528 - وعبيدة(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 529 - وعبد الرحمن بن مسهر(@)(@)(@@) (¬4)(@)(@)PageV02P264(@)(@)(@@)(@@)(@@) ||| CHECK 532 - عبد الله بن سلمة الأفطس(@)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 530 - على بن عابس(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 531 - عمرو بن أبى المقدام(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@) 532 - عبد الله بن سلمة (*) الأفطس (¬3)(@)(@@) قال: وكان يحيى بن سعيد يقول: عبد الله بن سالم الأفطس ليس بثقة.(@)(@)PageV02P265(@)(@)(@@)(@@)(@@) ||| AUTO 533 - عبيد الله بن أبى حميد الهذلى(@)(@)(@@) (¬1)(@)(@@) قال: وعبيد الله بن أبى حميد الهذلى ضعيف الحديث وهو كوفى، يروى عنه وكيع.(@)(@)(@@)(@@)(@@) ||| AUTO 534 - عمرو بن خالد الكوفى(@)(@)(@@) (¬2)(@)(@@) كذاب، حدث عنه أبو حفص الأبار وغيره، وروى هو عن زيد بن على، والحسن بن ذكوان.(@)(@)(@@)(@@)(@@) ||| AUTO 535 - عبد الرحمن 
ms195	 بن إسحاق الكوفى(@)(@)(@@) (¬3)(@)(@@) قال: وعبد الرحمن بن إسحاق الكوفى ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 536 - وعمرو بن ثابت(@)(@)(@@) (¬4)(@)(@@) ضعيف.(@)(@)PageV02P266(@)(@)(@@)(@@)(@@) ||| AUTO 537 - وعيسى بن المسيب(@)(@)(@@) (¬1)(@)(@@) ضعيف، ولاه أسد بن عبد الله القضاء بخراسان.(@)(@)(@@)(@@)(@@) ||| AUTO 538 - وعبد الملك بن هارون(@)(@)(@@) (¬2)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 539 - وعيسى بن قرطاس(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 540 - وعبد الرحمن بن إسحاق(@)(@)(@@) (¬4)(@)(@@) صاحب النعمان بن سعد ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 541 - وعبيد العطار(@)(@)(@@) (¬5) PageV02P267(@)(@@) عطار المطلقات، قلت له: هذه الأحاديث التى تحدث بها باطل، فقال: اتق الله ويحك، فقلت: هى باطل، فسكت.(@)(@)(@@)(@@)(@@) ||| AUTO 542 - وعبيد بن القاسم(@)(@)(@@) (¬1)(@)(@@) قريب سفيان الثورى ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 543 - وعثمان بن عمير أبو اليقظان(@)(@)(@@) (¬2)(@)(@@) كوفى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 544 - وعلى بن نزار(@)(@)(@@) (¬3)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 545 - والعباس بن الفضل(@)(@)(@@) (¬4) PageV02P268(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 546 - وعقبة الأصم(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 547 - وعبد الواحد بن زيد(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 548 - وعباد بن [منصور](@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)PageV02P269(@)(@)(@@)(@@)(@@) ||| AUTO 549 - عبد الرحمن بن إبراهيم الكرمانى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 550 - وعكرمة بن إبراهيم(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 551 - وعبد الله بن واقد(@)(@)(@@) (¬3)(@)(@@) يحدث عن قتادة وليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 552 - وعباد بن ميسرة المنقرى(@)(@)(@@) (¬4)(@)(@)PageV02P270(@)(@)(@@)(@@)(@@) ||| AUTO 553 - وعباد بن راشد(@)(@)(@@) (¬1)(@)(@)(@@)(@@)(@@) ||| AUTO 554 - وعباد بن كثير(@)(@)(@@) (¬2)(@)(@)(@@)(@@)(@@) ||| AUTO 555 - وعباد بن منصور(@)(@)(@@) (¬3)(@)(@@) كلهم (¬4) ليس حديثهم بالقوى ولكنه يكتب.(@)(@)(@@)(@@)(@@) ||| AUTO 556 - عبد الوهاب الثقفى(@)(@)(@@) (¬5)(@)(@@) قال: وكان عبد الوهاب الثقفى قد اختلط بآخره.(@)(@)PageV02P271(@)(@)(@@)(@@)(@@) ||| AUTO 557 - وعثمان البرى(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 558 - وعيسى بن الفضل(@)(@)(@@) (¬2)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 559 - عمر بن راشد(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 560 - والعلاء بن هلال(@)(@)(@@) (¬4)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 561 - وعمر بن حبيب(@)(@)(@@) (¬5) PageV02P272(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 562 - عبد الله بن شقيق(@)(@)(@@) (¬1)(@)(@@) على بن المدينى قال: سمعت يحيى قال: كان التيمى سيئ الرأى فى عبد الله بن شقيق، قال على: قلت ليحيى: سمعته منه؟ ، قال: نعم.(@)(@)(@@)(@@)(@@) ||| AUTO 563 - عبد الواحد بن قيس(@)(@)(@@) (¬2)(@)(@@) على قال: سمعت يحيى وذكر عنده عبد الواحد بن قيس الذى روى عنه الأوزاعى فقال: كان شبه لا شئ، وقال: وقد روى عنه الحسن بن ذكوان (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 564 - عثمان الشحام(@)(@)(@@) (¬4)(@)(@@) على قال: سمعت يحيى وذكر عثمان 
ms196	 الشحام فقال: يعرف وينكر ولم يكن بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 565 - عمرو بن مرزوق(@)(@)(@@) (¬5) PageV02P273(@)(@@) ابن أبى خيثمة: حدثنا عبد الله بن ميسرة قال: كان يحيى بن سعيد القطان لا يرضى عمرو بن مرزوق.(@)(@)(@@)(@@)(@@) ||| AUTO 566 - عبد الله بن جعفر(@)(@)(@@) (¬1)(@)(@@) قال: وسمعت يحيى بن معين يقول: عبد الله بن جعفر المدينى أبو على ليس بشئ، وسئل عنه مرة أخرى فقال: كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 567 - عامر بن صالح(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: عامر بن صالح المدينى من آل الزبير كان كذابا، يروى عن هشام بن عروة كل حديث يسمعه، قال: وقد لقيته وكتبت عامة هذه الأحاديث، وهو عامر بن صالح بن عبد الله بن عروة بن الزبير.(@)(@)PageV02P274(@)(@)(@@)(@@)(@@) ||| AUTO 568 - عبد الوهاب بن مجاهد(@)(@)(@@) (¬1)(@)(@@) قال: حدثنا محمد بن عباد بن موسى، حدثنا وكيع قال: كنا عند عبد الوهاب بن مجاهد قال: فقلنا: حمدا لله بلغنا أن أباك مات وأنت صغير، فغضب فقام، قال: وسمعته يقول: عبد الوهاب بن مجاهد ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 569 - عبد الملك بن الربيع بن سبرة(@)(@)(@@) (¬2)(@)(@@) قال: وسئل يحيى بن معين عن أحاديث عبد الملك بن الربيع بن سبرة، عن أبيه، عن جده فقال: ضعاف.(@)(@)(@@)(@@)(@@) ||| AUTO 570 - عبد العزيز بن أبان(@)(@)(@@) (¬3)(@)(@@) عمرو بن الحسن قال: حدثنى محمد بن بندار قال: سمعت محمد بن سعيد القارى قال: شهدت وكيعا سئل عن عبد العزيز بن أبان، فقال: له لحية له هيئة.(@)(@)(@@)(@@)(@@) ||| AUTO 571 - عزرة بن قيس(@)(@)(@@) (¬4)(@)(@)PageV02P275(@)(@)(@@)(@@)(@@) ||| CHECK 575 - عزرة بن قيس(@)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين عن عروة بن قيس، فقال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 572 - العباس بن الفضل الأنصارى(@)(@)(@@) (¬1)(@)(@@) ثقة، ولكنه حدث بحديث أنكروه عليه، قال: وسمعته مرة أخرى يقول: العباس بن الفضل الأنصارى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 573 - عيسى بن ميمون(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: عيسى بن ميمون ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 574 - عبد الله بن المثنى(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: عبد الله بن المثنى أبو محمد بن عبد الله الأنصارى ليس بشئ.(@)(@)(@@) 575 - عزرة (*) بن قيس (¬4)(@)(@@) قال: وسئل عن عزرة بن قيس روى عنه أحمد بن 
ms197	 إسحاق الحضرمى حديث أم الفيض؟ فقال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 576 - عبد الله بن جعفر الأرطباى(@)(@)(@@) (¬5) PageV02P276(@)(@@) قال: ورجعت إلى أبى يوما وقد كتبت عن الحسن المروروذى، عن عبد الله بن جعفر الأرطبانى، فقال: آيش الأرطبانى أأحد يسمع حديث الأرطبانى؟ ! .(@)(@)(@@)(@@)(@@) ||| AUTO 577 - عبد الواحد بن زيد(@)(@)(@@) (¬1)(@)(@@) قال: وسمعت يحيى بن معين يقول: عبد الواحد بن زيد ليس حديثه بشئ ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 578 - عاصم بن هلال(@)(@)(@@) (¬2)(@)(@@) قال: وسثل عن عاصم بن هلال؟ ، فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 579 - عبد الله بن بسر(@)(@)(@@) (¬3)(@)(@@) قال: قال يحيى: رأيت عبد الله بن بسر كان هاهنا، قلت ليحيى: كيف كان؟ ، قال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 580 - عبد الله بن رجاء البصرى(@)(@)(@@) (¬4) PageV02P277(@)(@@) ابن أبى خيثمة قال: سمعت ابن معين يقول: عبد الله بن رجاء البصرى ليس من أصحاب الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 581 - عامر الأحول(@)(@)(@@) (¬1)(@)(@@) العباس الدورى قال: سمعت أبا بكر بن أبى الأسود قال: سألت إسماعيل عن عامر الأحول؟ ، فقال: سل جدك أبا الأسود؛ فإنه أعلم به، فسألته فقال: كان ضعيفا فى الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 582 - عبد الكريم(@)(@)(@@) (¬2)(@)(@@) قال: حدثنا أبو بكر، أخبرنا إسماعيل قال: خرج عبد الكريم مرة من البصرة فقال أبو العالية: اللهم لا ترد صاحب الأكسية.(@)(@)(@@)(@@)(@@) ||| AUTO 583 - عمران القطان(@)(@)(@@) (¬3) PageV02P278(@)(@@) ابن أبى خيثمة قال: قال يحيى بن معين: عمران بن القطان ضعيف، قال ابن أبى(@)(@@) خيثمة: وهو عمران الداور أبو العوام القطان، أخبرنا بذلك عمرو بن مرزوق.(@)(@)(@@) يتلوه فى الجزء السادس إن شاء الله(@)(@@) على بن المدينى قال: سمعت يحيى يقول: لم يكن عمر بن سعد ممن يعتمد عليه.(@)(@@) الحمد لله رب رب العالمين وصلواته على سيدنا محمد النبى وآله وسلامه.(@)(@@) وهو حسبنا ونعم الوكيل.(@)(@)PageV02P279(@)(@)(@@) الجزء السادس من كتاب(@)(@@) قبول الأخبار ومعرفة الرجال(@)(@@) تأليف أبى القاسم عبد الله بن أحمد بن محمود البلخى (¬1)(@)(@@) بسم الله الرحمن الرحيم(@)(@@) الحمد لله رب العالمين، وصلى الله على سيدنا محمد النبى، وآله الطيبين وسلم تسليما وحسبنا الله ونعم الوكيل (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 584 - عمر بن سعد(@)(@)(@@) (¬3)(@)(@@) على بن المدينى قال: سمعت يحيى بن معين يقول: لم 
ms198	 يكن عمر بن سعد ممن يعتمد عليه.(@)(@)(@@)(@@)(@@) ||| AUTO 585 - وعثمان بن سعد الكاتب(@)(@)(@@) (¬4)(@)(@@) بصرى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 586 - عبد الأعلى بن أبى المساور(@)(@)(@@) (¬5) PageV02P280(@)(@@) واسطى وليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 587 - عتبة بن أبى حكيم(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: عتبة بن أبى حكيم ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 588 - عبد الرزاق بن عمر(@)(@)(@@) (¬2)(@)(@@) وسمعته يقول: عبد الرزاق بن عمر الذى يروى عنه الحكم بن موسى ليس بشئ، وكان شاميا.(@)(@)(@@)(@@)(@@) ||| AUTO 589 - عتاب بن بشير(@)(@)(@@) (¬3) PageV02P281(@)(@@) قال: وسمعت هارون بن معروف يقول: اختلط على عتاب بن بشير العرض والسماع فكان يتكلم فيه.(@)(@)(@@)(@@)(@@) ||| AUTO 590 - عبد الرحمن بن زياد بن أنعم الأفريقى(@)(@)(@@) (¬1)(@)(@@) قال: وسئل يحيى بن معين، عن عبد الرحمن بن زياد بن أنعم الأفريقى، فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 591 - عامر بن شقيق بن جمرة(@)(@)(@@) (¬2)(@)(@@) قال: وقال: عامر بن شقيق بن حمزة، ضعيف الحديث وهو أسدى.(@)(@)(@@)(@@)(@@) ||| AUTO 592 - عمرو بن قيس(@)(@)(@@) قال: وسئل عن حديث عمرو بن قيس، عن عاصم بن أبى النجود، عن شقيق، عن عبد الله قال: قال رسول الله - صلى الله عليه وسلم -: "تابعوا بين الحج والعمرة فإنهما ينفيان الفقر والذنوب كما ينفى الكير خبث الحديد والفضة، وليس للحج المبرور ثواب إلا الجنة" (¬3).(@)(@@) فقال: عمرو ثقة وهو حديث منكر.(@)(@)(@@)(@@)(@@) ||| AUTO 593 - عبيد الله بن الوليد الوصافى(@)(@)(@@) (¬4) PageV02P282(@)(@@) قال: وسئل عن عبيد الله بن الوليد الوصافى، فقال: ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 594 - عمرو بن خالد(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: عمرو بن خالد يحدث عنه الحسن بن ذكوان، كوفى ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 595 - عمران(@)(@)(@@) (¬2)(@)(@@) قال: وسئل عن عمران الذى روى عن عكرمة قال: كان طالوت سقاء فلم يدمن عمران، قال: وحدثنا هو قال: حدثنا أبو أحمد الزبيرى، عن شريك، عن عمران، عن عكرمة قال: كان طالوت سقاء يبيع الماء.(@)(@)(@@)(@@)(@@) ||| AUTO 596 - عمرو بن ثابت الحداد(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: عمرو بن ثابت الحداد لا يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 597 - عمرو بن ثابت(@)(@)(@@) (¬4) PageV02P283(@)(@@) قال: وحدثنا الوليد بن شجاع، حدثنا على بن الحسن بن شقيق قال: سمعت عبد الله بن المبارك يقول: دعوا حديث عمرو بن 
ms199	 ثابت، فإنه كان يسب السلف (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 598 - عمار بن سيف(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت يحيى. يقول: عمار بن سيف ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 599 - عبد الله بن جابر بن ربيعة الضبى(@)(@)(@@) قال: وسمعته يقول: عبد الله بن جابر بن ربيعة الضبى، روى عنه أبو نعيم قال: ضعيف (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 600 - عبد الرحمن بن مسهر(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: عبد الرحمن بن مسهر ليس بشئ، وهو قاضى جبل (¬5)، الذى مدح نفسه عند هارون (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 601 - عزرة(@)(@)(@@) (¬7) PageV02P284(@)(@@) على قال: قلت ليحيى تعرف عزرة صاحب قتادة؟ ، قال: بلى، والله إنى لأعرفه وأكره أن أقول (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 602 - عمرو بن سمرة(@)(@)(@@) (¬2)(@)(@@) قال أبو حاتم الرازى: عمرو بن سمرة ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 603 - وعطاء بن مسلم الحفاف(@)(@)(@@) (¬3)(@)(@@) دفن كتبه وخلط فى حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 604 - وعلى بن قردين(@)(@)(@@) (¬4)(@)(@@) ذاهب الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 605 - عمرو بن محمد العنقزى(@)(@)(@@) (¬5)(@)(@@) ليس بذاك المتين.(@)(@)PageV02P285(@)(@)(@@)(@@)(@@) ||| AUTO 606 - عطية العوفى(@)(@)(@@) (¬1)(@)(@@) لين الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 607 - عمرو بن قيس سندل المكى(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 608 - وعلى بن على اللهبى(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 609 - على بن عابس(@)(@)(@@) (¬4)(@)(@@) ليس بالقوى يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 610 - عطاء بن خالد(@)(@)(@@) (¬5)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 611 - وعلى بن الحسين بن واقد(@)(@)(@@) (¬6)(@)(@@) ليس بالمتين.(@)(@)PageV02P286(@)(@)(@@)(@@)(@@) ||| CHECK 618 - وعبد الرحمن بن سليمان [بن] الغسيل(@)(@)(@@)(@@)(@@) ||| AUTO 612 - وعيسى بن ميمون(@)(@)(@@) (¬1)(@)(@@) صاحب القاسم، عن عائشة، ضعيف الحديث، منكر الحديث، لا ينبغى أن يحدث عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 613 - وعيسى بن أبى عيسى الحناط(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 614 - وعبد الرحمن بن إسحاق(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه ولا يحتج به، روى عنه البصريون بشر بن المفضل، ويزيد بن زريع.(@)(@)(@@)(@@)(@@) ||| AUTO 615 - وعباد بن كثير الرملى(@)(@)(@@) (¬4)(@)(@@) قال: ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 616 - وعبد العزيز بن محمد الدراوردى(@)(@)(@@) (¬5)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 617 - عمرو بن إبراهيم(@)(@)(@@) (¬6)(@)(@@) صاحب قتادة ليس بالمتين، يكتب حديثه ولا يحتج به.(@)(@)(@@) 618 - وعبد الرحمن بن سليمان [بن] (¬7) الغسيل (¬8) PageV02P287(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 619 - وعنبسة بن سعيد(@)(@)(@@) (¬1)(@)(@@) أخو أبى الربيع السمان، ضعيف الحديث، يروى عنه يزيد بن هارون.(@)(@)(@@)(@@)(@@) ||| AUTO 620 - وعمر 
ms200	 بن عبد الله بن يعلى بن مرة الثقفى(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 621 - وعثمان بن عمير(@)(@)(@@) (¬3)(@)(@@) أبو يقظان ليس بالقوى، كان شعبة يتكلم فيه.(@)(@)PageV02P288(@)(@)(@@)(@@)(@@) ||| AUTO 622 - وعبد الله بن محمد بن يحيى بن عروة(@)(@)(@@) (¬1)(@)(@@) صاحب الحرامى، كان يفتعل الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 623 - وعمرو بن دينار فهرمان آل الزبير(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 624 - وعبد الحميد بن جعفر(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 625 - عبد الله بن محمد بن عجلان(@)(@)(@@) (¬4)(@)(@@) وسئل عن عبد الله بن محمد بن عجلان مولى فاطمة بنت عتبة، عن أبيه، عن جده، عن أبى هريرة، فقال: أبوه ثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 626 - وعبد الوهاب بن عطاء الخفاف(@)(@)(@@) (¬5) PageV02P289(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 627 - وعباد بن راشد(@)(@)(@@) (¬1)(@)(@@) عن الحسن ليس بالقوى، يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 628 - وعاصم بن عمرو البجلى(@)(@)(@@) (¬2)(@)(@@) عن أبى أمامة، روى عنه فرقد السبخى والكوفيون، أبو إسحاق، وطارق، والحجاج ابن أرطاة، يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 629 - والعباس بن الفضل الأنصارى الموصلى(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث، يروى عن القاسم بن عبد الرحمن.(@)(@)(@@)(@@)(@@) ||| AUTO 630 - عبد الأعلى بن أبى المساور الكوفى(@)(@)(@@) (¬4)(@)(@)PageV02P290(@)(@)(@@)(@@)(@@) ||| CHECK 632 - عمران بن عيينة وأخوته(@)(@)(@@) قال: حدثنا إبراهيم بن موسى الفراء قال: أخبرنا [100/ أ] ابن أبى زائدة قال: نهيت أنا خالد أن يحدث عن عبد الأعلى بن أبى المساور الكوفي.(@)(@)(@@)(@@)(@@) ||| AUTO 631 - عمر بن يزيد الرفاء(@)(@)(@@) (¬1)(@)(@@) وعمر بن يزيد الرفاء أبو حفص كذاب.(@)(@)(@@) 632 - عمران بن عيينة (¬2) وأخوته.(@)(@)(@@)(@@)(@@) ||| AUTO 633 - محمد(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 634 - وإبراهيم(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 635 - وآدم(@)(@)(@@) (¬5).(@)(@@) ليسوا بالأقوياء.(@)(@)(@@)(@@)(@@) ||| AUTO 636 - عمرو بن أبى عمر(@)(@)(@@) (¬6) PageV02P291(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن عمرو بن أبى عمر؟ ، قال: ضعيف الحديث، هو الذى روى عنه ابن الهاد.(@)(@)(@@)(@@)(@@) ||| AUTO 637 - عبيد الله بن عبد الرحمن بن موهب(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن عبيد الله بن عبد الرحمن بن موهب روى عنه الحنفى (¬2)؟ ، قال: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 638 - عبد الله بن جعفر(@)(@)(@@) (¬3)(@)(@@) قال: وسمعت يحيى يقول: عبد الله بن جعفر ابن أخى إسماعيل بن جعفر، شيخ كان يجالسنا فى المسجد، صاحب مغنيات، لم 