ms110	 دين الله % % 9(@)(@@) % دور % % 10(@)(@@) % يا من له البرهان % % وخلقه القرآن % % PageV01P400 11(@)(@@) % ما كانت الأكوان % % وحقه لولاه % % 12(@)(@@) % دور % % 13(@)(@@) % أدعوك بالسبطين % % لكشف هذا الغين % % 14(@)(@@) % يا ملجأ الكونين % % في الخطب بعد الله % % 15(@)(@@) % دور % % 16(@)(@@) % لواؤك المرفوع % % وقولك المسموع % % 17(@)(@@) % وحبك المطبوع % % في مهجة الأواه % % 18(@)(@@) % دور % % 19(@)(@@) % ها أنت في المحشر % % مويد المظهر % % 20(@)(@@) % فكلما تذكر % % عليك صلى الله % % PageV01P401 البحر : مجزوء المديد 1(@)(@@) % يا رسول الله % % يا حبيب الله % % 2(@)(@@) % دارك الملهوف % % يا عريض الجاه % % 3(@)(@@) % لازمه % % 4(@)(@@) % أنت في الأكوان % % مصطفى الرحمن % % 5(@)(@@) % جئت بالفرقان % % هاديا لله % % 6(@)(@@) % دور % % 7(@)(@@) % قمت للأسرار % % كلها مضمار % % 8(@)(@@) % أيها المختار % % أنت باب الله % % 9(@)(@@) % دور % % 10(@)(@@) % شدت للإسلام % % ركن عز دام % % PageV01P402 11(@)(@@) % شأنك الإنعام % % أنت بعد الله % % 12(@)(@@) % دور % % 13(@)(@@) % ظللك الممدود % % بره مقصود % % 14(@)(@@) % أنت يا محمود % % من سيوف الله % % 15(@)(@@) % دور % % 16(@)(@@) % زارك التسليم % % بيد التعظيم % % 17(@)(@@) % يحمل التكريم % % بصلاة الله % % PageV01P403 البحر : مجزوء الرمل 1(@)(@@) % كأس محبوبي ترقرق % % والربى مالت غصونه % % 2(@)(@@) % ومن الورد المؤنق % % فتحت لطفا عيونه % % 3(@)(@@) % دور % % 4(@)(@@) % يا حبيبا في فؤادي % % حبة حتى التنادي % % 5(@)(@@) % هكذا سر الوداد % % كل ذي دين يصونه % % 6(@)(@@) % دور % % 7(@)(@@) % حط من برج الغيوب % % لك حال في القلوب % % 8(@)(@@) % وبأنواع الشعوب % % ظهرت جهرا فنونه % % 9(@)(@@) % دور % % 10(@)(@@) % كل صديق مقرب % % بك دون الكون يرغب % % PageV01P404 11(@)(@@) % إنما العبد المحبب % % عقله فيك جنونه % % 12(@)(@@) % دور % % 13(@)(@@) % عبدك الملهوف يجري % % دمعه والحال تدري % % 14(@)(@@) % حسنت فيك لعمري % % بعد باريك ظنونه % % 15(@)(@@) % دور % % 16(@)(@@) % وعليك الله صلى % % أبدا يا خير مولى % % 17(@)(@@) % مالك الله تجلى % % وبدت فيك شؤنه % % 18(@)(@@) % دور % % 19(@)(@@) % وعلى الآل الأكابر % % وصحاب كالزواهر % % 20(@)(@@) % ما ازدهى الروض بماطر % % وجرت منه عيونه % % PageV01P405 البحر : مجزوء الرجز 1(@)(@@) % نجم التداني مذ هوى % % حيرا أرباب الهوى % % 2(@)(@@) % هدتهموا حيرتهم % % دهرا إلى ترك السوى % % 3(@)(@@) % دور % % 4(@)(@@) % قد أخلصوا له الهمم % % واستمطروا منه الكرم % % 5(@)(@@) % فقال موتوا بي ولم % % ينطق بآن عن هوى % % 6(@)(@@) % دور 
ms111	 % % 7(@)(@@) % طارت له أرواحهم % % ولطفت أشباحهم % % 8(@)(@@) % فليلهم صباحهم % % ونشرهم به أنطوى % % 9(@)(@@) % دور % % 10(@)(@@) % أجروا لمعناه العيون % % باللهف من تلك العيون % % PageV01P406 11(@)(@@) % وقد يجازى في الشؤن % % كل امرء بما نوى % % 12(@)(@@) % دور % % 13(@)(@@) % حدى لهم حادي الغرام % % فقعد الركب وقام % % 14(@)(@@) % وبينهم دار المدام % % والكل بالمعنى ارتوى % % 15(@)(@@) % دور % % 16(@)(@@) % يا سيد لنا انجلى % % وذكره بنا حلا % % 17(@)(@@) % كوكبك العالي على % % عرش قلوبنا استوى % % 18(@)(@@) % دور % % 19(@)(@@) % بحرمة الحب الصميم % % والعهد والود القديم % % 20(@)(@@) % جد بالقبول المستديم % % فالصد قد هد القوى % % PageV01P407 21(@)(@@) % دور % % 22(@)(@@) % عليك أزكى الصلوات % % والآل والصحب الثقات % % 23(@)(@@) % ما قد أطاب النغمات % % حاد بركبان اللوى % % PageV01P408 البحر : مجزوء الرمل 1(@)(@@) % حين رام الخصم وضعي % % قال لي حبي تعالى % % 2(@)(@@) % أنا في فرقي وجمعي % % حسبي الله تعالى % % 3(@)(@@) % دور % % 4(@)(@@) % يا حسودا راح يجحد % % رفعة العبد المؤيد % % 5(@)(@@) % أنت بالحقد مقيد % % وهو بالله استطالا % % 6(@)(@@) % دور % % 7(@)(@@) % لاح لي بدر التجلي % % في سموات التدلي % % 8(@)(@@) % وجلا بالفرع أصلي % % فازدهى الفرع وطالا % % 9(@)(@@) % دور % % 10(@)(@@) % حب مولى الخلق فني % % فاروه يا صاح عني % % PageV01P409 11(@)(@@) % رونق المهدي مني % % ملأالكون جمالا % % 12(@)(@@) % دور % % 13(@)(@@) % لإمام الأولياء % % أحمد القوم انتمائي % % 14(@)(@@) % لغريب الغرباء % % قمت في الحي ظلالا % % 15(@)(@@) % دور % % 16(@)(@@) % ترجم الإقبال شاني % % رغم ذي جحد وشاني % % 17(@)(@@) % ومن الغيب حباني % % واهب الحظ الجلالا % % 18(@)(@@) % دور % % 19(@)(@@) % نفسي ريضي لا تراعي % % في ملمات الدواعي % % 20(@)(@@) % قد طوى في الرفاعي % % علم الشرق الكمالا % % PageV01P410 21(@)(@@) % دور % % 22(@)(@@) % وصلاة بوفور % % للتهامي الغيور % % 23(@)(@@) % تشمل الدهر بنور % % منه أصحابا وآلا % % PageV01P411 البحر : مجزوء المديد 1(@)(@@) % يا كتابا الغيوب % % قد لجأنا إليك % % 2(@)(@@) % يا شفاء القلوب % % الصلاة عليك % % 3(@)(@@) % لازمه % % 4(@)(@@) % أنت مجلى الجلال % % في نظام الجمال % % 5(@)(@@) % كل هذا النوال % % فاض من راحتيك % % 6(@)(@@) % دور % % 7(@)(@@) % أنت روح الوجود % % كنز فضل وجود % % 8(@)(@@) % في مقام الشهود % % كل فضل لديك % % 9(@)(@@) % دور % % 10(@)(@@) % أنت سر الكتاب % % عنك فصل الخطاب % % PageV01P412 11(@)(@@) % وبيوم الحساب % % فالرجوع إليك % % 12(@)(@@) % دور % % 13(@)(@@) % أنت 
ms112	 بالإفتتاح % % ختم حزب النجاح % % 14(@)(@@) % ومنار الصلاح % % لاح من مظهريك % % 15(@)(@@) % دور % % 16(@)(@@) % أنت في العالمين % % روح جسم اليقين % % 17(@)(@@) % موكب المرسلين % % قام بين يديك % % 18(@)(@@) % دور % % 19(@)(@@) % أنت هادي الأمم % % أنت بحر الكرم % % 20(@)(@@) % أنت صبح النعم % % فج من بردتيك % % PageV01P413 21(@)(@@) % دور % % 22(@)(@@) % أنت طه الرسول % % تاج أهل القبول % % 23(@)(@@) % كل همي يزول % % باعتمادي عليك % % 24(@)(@@) % دور % % 25(@)(@@) % روح هذا الحقير % % عبدك المستجير % % 26(@)(@@) % بالغرام الوفير % % قبلت قدميك % % 27(@)(@@) % دور % % 28(@)(@@) % وعليك السلام % % يا رسول الأنام % % 29(@)(@@) % ما شدا مستهام % % بالصلاة عليك % % PageV01P414 البحر : هزج 1(@)(@@) % رأى البرق الحجازيا % % فجر الآه ناريا % % 2(@)(@@) % نحب ما رأى دهرا % % سوى زي الهوى زيا % % 3(@)(@@) % لازمه % % 4(@)(@@) % لوى برق الحجاز الروح % % فزادت أنه المجروح % % 5(@)(@@) % فكم من عاشق مطروح % % وميت قد حكى حيا % % 6(@)(@@) % دور % % 7(@)(@@) % شؤن تخطف العشاق % % وتجري منهم الآماق % % 8(@)(@@) % ترى منهم أخا الإحراق % % بنشر الوجد مطويا % % 9(@)(@@) % دور % % 10(@)(@@) % حداهم للحمى الحادي % % فأموا ذلك الوادي % % PageV01P415 11(@)(@@) % قلوب من هوى الهادي % % طوت سرا سماويا % 12(@)(@@) % دور % % 13(@)(@@) % دعاهم للهوى المغنى % % وما الهتهمو لبنى % % 14(@)(@@) % فكم منهم ترى مضنى % % على الأعتاب مرميا % % 15(@)(@@) % دور % % 16(@)(@@) % رعاك الله يا سار % % لتلك الأرض والدار % % 17(@)(@@) % تعلم بعض أطواري % % وأشبع أرضهم ريا % % 18(@)(@@) % دور % % 19(@)(@@) % سلام الله حياهم % % بمسك عم مغناهم % % 20(@)(@@) % مدى ما لاح معناهم % % وصار الكون نوريا % % PageV01P416 البحر : مجزوء الرجز 1(@)(@@) % يا أيها النبي % % والكوكب القدسي % % 2(@)(@@) % أنت هزبر الحضرة % % سلطانها الغيبي % % 3(@)(@@) % لازمه % % 4(@)(@@) % لك العلا والسودد % % والشرف المؤبد % % 5(@)(@@) % وأنت يا محمد % % بدر الهدى السني % % 6(@)(@@) % دور % % 7(@)(@@) % درات لك الأفلاك % % لاذت بك الأملاك % % 8(@)(@@) % لولاك ما الأحلاك % % حندسها مجلى % % 9(@)(@@) % دور % % 10(@)(@@) % همتك الفعالة % % ويدك الهطاله % % PageV01P417 11(@)(@@) % وأنت للرسالة % % أمينها القوي % % 12(@)(@@) % دور % % 13(@)(@@) % بدت بك الآثار % % ولألأ النهار % % 14(@)(@@) % جنابك المختار % % ضمن الضريح حي % % 15(@)(@@) % دور % % 16(@)(@@) % إزارك الجمال % % ودرعك الجلال % % 17(@)(@@) % سلطانك الفعال % % برهانه مرئى % % 18(@)(@@) % دور % % 19(@)(@@) % صلاة ذي الإحسان % % عليك والخلان % % 20(@)(@@) % ما قام في 
ms113	 الأكوان % % لكل نشر طى % % PageV01P418 البحر : - 1(@)(@@) % انظر بمرآة الشهود فتجتلي % % روح الوجود بمدحه الفياح % % 2(@)(@@) % طه الرسول المجتبي خير الورى % % نور العيون ومبهج الأرواح % % 3(@)(@@) % مع آله الغر الكرام وصحبه % % والأولياء القادة النصاح % % 4(@)(@@) % من نظم افصح ناطق بالضاد بعد % % المصطفى كنز الوفا الضحضاح % % 5(@)(@@) % أعني به صدر الصدور أبا الهدى % % مولي الندا بل كعبة الامناح % % 6(@)(@@) % بحر العلوم بمنطق لبيانه % % برز البديع ممنطقا بوشاح % % 7(@)(@@) % مذ جاء في مرآته متبتلا % % خلناه موسى جاء بالألواح % % 8(@)(@@) % وبعنصر التقوى لعمري أنه % % لو رام احيى ميت الأشباح % % 9(@)(@@) % ذات تكون من خلاصة هاشم % % وغذى لبان ولا ية وصلاح % % 10(@)(@@) % وبوجهه نور النبوة ظاهر % % يكفيه في الديجور عن مصباح % % PageV01P419 11(@)(@@) % وشؤنه كفلت شريعة جده % % بصلابة وسماحة وفلاح % % 12(@)(@@) % لم لا وبالصياد أحمد دأبه % % صيد المفاخر لا بذات جناح % % 13(@)(@@) % شبل الرفاعي الذي مدت له % % يد النبي ككوكب وضاح % % 14(@)(@@) % فاقصد حماه ولذ بركن جناية % % وأنا الضمين تعد بخير نجاح % % 15(@)(@@) % فلهه الهناء مع الثنا نهديه % % بالجلال والإعظام والأفراح % % 16(@)(@@) % فيما به يا صاح أتحف منه % % من خدمة للمصطفى يا صاح % % 17(@)(@@) % ما أن حدى الحادي بدر نظامها % % مترنما بعشية وصباح % % 18(@)(@@) % ألا تمايلنا نشاوى خلتنا % % دارت علينا الراح بالأقداح % % 19(@)(@@) % واستعبرت اجفاننا بلألىء % % تنهل من طرب بغير نواح % % 20(@)(@@) % وبطي ذا نشر يفوح مضنخا % % بروائح الاوراد والتفاح % % PageV01P420 21(@)(@@) % واسلم ودم يا أيها المولى على % % ما دمت في سر وفي إيضاح % % 22(@)(@@) % متمتعا في نعمة بتجدد % % كتجدد الأزهار في الادواح % % 23(@)(@@) % تبدي فنونا في العلوم بنفعها % % تحي القلوب بجاذب تفاح % % 24(@)(@@) % وحسود شأنك لا يزال على المدى % % من قهره متسليا بنباح % % 25(@)(@@) % بصلاة ربي للحبيب محمد % % حامي الدخيل وكافل المداح % % 26(@)(@@) % والآل والأصحاب ما عبد دعا % % لله إسعافا بنيل مباح % % PageV01P421 البحر : - 1(@)(@@) % كتاب جليل طاب في مدح أحمد % % حبيب آله العرش سيد من بدا % % 2(@)(@@) % فمدح الرسول المصطفى خير نعمة % % بها نال أهل الحب والله مقصدا % % 3(@)(@@) % فهاك كتابا للتوسل جامعا % % لخير الورى من 
ms114	 قد تسمى محمدا % % 4(@)(@@) % توسل به أن جار دهر بفعله % % تنل كل ما ترجو وتنجو من الردى % % 5(@)(@@) % يفوق نظام الدر عقد نظامه % % حبانا به الفرد الهمام أبو الهدى % % PageV01P422 البحر : - 1(@)(@@) % لمرآة الشهود عقود حسن % % تفوق على النجوم بغير مين % % 2(@)(@@) % تراها مثل حبات اللآلي % % قد انتظمت ففاقت كل فن % % 3(@)(@@) % فلازم حيه تحي أديبا % % فبالآداب يبعد كل حين % % 4(@)(@@) % بها غرر القصائد قد تبدت % % عرائس نزهت عن كل شين % % 5(@)(@@) % مدائحها كنشر المسك عرفا % % ونشر المسك لا يخفاك يفني % % 6(@)(@@) % فقرب طبعها حالا وأرخ % % لمرآة الشهود عقود حسن % % 7(@)(@@) % % % PageV01P423 البحر : - 1(@)(@@) % % % PageV01P424 البحر : - 1(@)(@@) % هو البحر لكنه زاخر % % هو الروض لكنه زاهر % % PageV01P425 البحر : - 1(@)(@@) % فاغتنمه عروس خدر تجلت % % فلعمري أحق بالإغتنام % % PageV01P426 البحر : - 1(@)(@@) % غاص بحر المعاني فاستخرج % % الدر مجيدا له بسمط نظام % % 2(@)(@@) % فهو للمهتدي الهداية فاسلك % % نهجه المستقيم بالإهتمام % % PageV01P427 البحر : - 1(@)(@@) % فبحق ما أعطاك ما قرت به % % عيناك بشرني ينجح سؤالي % % 2(@)(@@) % وتولنى وأبا وساعدني ولكن % % لي في الحياة وفي الممات موالي % % 3(@)(@@) % وأجمل حمولي واسعى لي فما به % % شغفي لأعطاء الغير طالي % % 4(@)(@@) % قل قد فعلت فأنني بك واثق % % ويميم مجدك قد وصلت حبالي % % 5(@)(@@) % يا سيدي الرسل الكرام ومن به % % يرجو المؤمل ما يشاء من % % 6(@)(@@) % أرجوك تدخلني لحضرة قربه % % فيحق من أعطاك ما فرق به % % 7(@)(@@) % عيناك بشرني بنجح سؤالي % % 8(@)(@@) % طال اغترابي عنك يا جد الحسن % % فأمنن وجد بالقرب لي % % 9(@)(@@) % لي من أقارب أو حبائب أو سكن ولكن % % ونتولى دأبا وساعدني وكل % % 10(@)(@@) % لي في الحياة وفي الممات موالي % % PageV01P428 11(@)(@@) % وامنن بوصل عاجل الأخطى به % % ما بين وادي المنحنى ورحابه % % 12(@)(@@) % يا صاحب القلب الرحيم إلي به % % واحمل حمولي وسطى لي فيما به % % 13(@)(@@) % شغفي إعطاء وبضر وطبالي % % 14(@)(@@) % فأنا أن العبد المسي الأبق % % والفضل منك على المولى سابق % % 15(@)(@@) % ولقد أتيتك والرجاء السائق % % قل قد فعلت فأنني بك % % 16(@)(@@) % وميم مجدك قد وصلت حبا % % 17(@)(@@) % كم صاح يا أهل الحرم % % عطفا لمأسور السقام 
ms115	 % % 18(@)(@@) % دور % % 19(@)(@@) % وافى إلى أعتابكم % % وانحط في أبوابكم % % 20(@)(@@) % والجود من ميزابكم % % قد سح سيلا للأنام % % PageV01P429 21(@)(@@) % دور % % 22(@)(@@) % أنتم أمان الخائفين % % دهرا وذخر العاجزين % % 23(@)(@@) % من فيضكم للعالمين % % بحر الندى والفضل طام % % 24(@)(@@) % دور % % 25(@)(@@) % يا سادتي طال الجفا % % رقوا فهجراني كفى % % 26(@)(@@) % عنكم أحاديث الوفا % % بالنص يرويها الكرام % % 27(@)(@@) % دور % % 28(@)(@@) % أحييت ليلي بالأنين % % فكم ولي سر أمين % % 29(@)(@@) % عطفا فدين العاشقين % % في حبكم هجر المنام % % 30(@)(@@) % دور % % PageV01P430 31(@)(@@) % ويلاه من نار البعاد % % كم أحرقت مني الفؤاد % % 32(@)(@@) % ألطرف محروم الرقاد % % والقلب في قيد الغرام % % 33(@)(@@) % دور % % 34(@)(@@) % قالوا اصطبر والركب سار % % يبغي الحمى والعج ثار % % 35(@)(@@) % من أين يأتي الاصطبار % % والركب قد وافى الخيام % % 36(@)(@@) % دور % % 37(@)(@@) % صلاة رب العالمين % % تهدى إلى الهادي الأمين % % 38(@)(@@) % والآل أرباب اليقين % % والصحب طرا والسلام % % PageV01P431 البحر : - 1(@)(@@) % يا حبيب القلب أضنانا الغرام % % وبه قد قعد السر وقام % % 2(@)(@@) % لاحظ العشاق وامنن بالرضا % % يا حياة القوم يا روح الأنام % % 3(@)(@@) % دور % % 4(@)(@@) % آه ذنبي عنك عيني قد حجب % % هكذا فالذنب للهجر سبب % % 5(@)(@@) % بلغ الولهان بالفضل الأرب % % وأغثه فهو في أسر السقام % % 6(@)(@@) % دور % % 7(@)(@@) % يا أمين الله في طى الغيوب % % عوقتني واعنا قلبي الذنوب % % PageV01P432 
ms116	