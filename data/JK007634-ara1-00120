ms101	 لجين الدمع في عرصاته % بنضار جاري العبرة الحمراء % 25(@)(@@) % هو مربع للعاشقين ومصرع % فليسق دمعك روضة الشهداء % 26(@)(@@) % كم فيه من بيت تقفى بالظبا % % مضمونه كالدرة البيضاء % 27(@)(@@) % تتوهم الأطناب منه لما ترى % % من ضوء دمينه حبال ذكاء % 28(@)(@@) % أفدي بدور دجى به قد زرروا % % ظلم الستور على شموس ضحاء % 29(@)(@@) % ورماة أحداق سهام فتورها % % صاغ السقام لها نصول بلاء % 30(@)(@@) % وسراة حي لم تزل تشتاقهم % شوق العطاش إلى زلال الماء % PageV01P305 31(@)(@@) % بسواد قلبي من طريقة مقلتي % % دخلوا ومنها أخرجوا حوبائي % % 32(@)(@@) % غر حووا كل الجال كما حوت % راحات عبد الله كلسخاء % 33(@)(@@) % بشر يريك لدى السماح جبينه % بشرا يحاكي الزهر عب سماء % 34(@)(@@) % ولد لأكرم والد ورث الندى % % والبأس عن آبائه الكرماء % 35(@)(@@) % أعني عليا صاحب الفضل الذي % % هو زينة الأيام والآناء % 36(@)(@@) % السيد الورع التقي أخا الندى % % علم الهدى علامة العلماء % 37(@)(@@) % مولى سعى مسعى أبيه إلى العلا % % فاعتاد بسط يد وقبض ثناء % 38(@)(@@) % هو صدر أسمره وقبضة قوسه % % 39(@)(@@) % ويمين دولته وآية ملكه % ودليل نصرته على الخصماء % 40(@)(@@) % غيث الندى غوث الصريخ إذادعا % % قوت النفوس وقوة الضعفاء % PageV01P306 41(@)(@@) % يتعاقبان على الدوام تعاقب ال % % ملوين بالسراء والضراء % 42(@)(@@) % تلقاه إما واهيا أو ضاربا % فزمانه يوما ندى ووغاء % 43(@)(@@) % تدري ذكور البيض حين تسلها % % يده سينكحها طلا الأعداء % 44(@)(@@) % والتبر يعلم إذ يحل وثاقه % أن لا يزال يسير في الأحياء % 45(@)(@@) % تهوى البدور بأن تكون بملكه % بدرا يفرقها على الفقراء % 46(@)(@@) % وكذا الليالي البيض تهوى أنها % % تمسي لديه وهي سود إماء % 47(@)(@@) % حسدت مدائحه النجوم فأوشكت % تهوي لتسكن ألسن الشعراء % 48(@)(@@) % يجد ازديار الوافدين ألذ من % وصل الأحبة بعد طول جفاء % 49(@)(@@) % ويرى بأن البيض من بيض الدمى % % وصليلها بالبيض رجع غناء % 50(@)(@@) % لو أن هذا الدهر أدرك شيمة % منه لبدل غدره بوفاء % PageV01P307 51(@)(@@) % ذو راحة نفخ الندى من روحها % % في ميت الآمال روح رجاء % 52(@)(@@) % مشكاة نادي المجد كوكب أفقه % مصباح ليل الكربة الدهماء % 53(@)(@@) % سر بذات أبيه 
ms102	 كان محجبا % فبدا به لله في الإفشاء % 54(@)(@@) % ولرب ملحمة بنار جحيمها % % تغلي القلوب مراجل الشحناء % 55(@)(@@) % نار مقامعها الحديد وإنما % % يجري الصديد بهاعلى الرخصاء % 56(@)(@@) % يشفي الحمام بها الحميم فظلها % % يحموم ليل مجاجة دكناء % 57(@)(@@) % نزاعة لشوى الضراغم ترتمي % % شرارا حكت قدرا هضاب أجاء % 58(@)(@@) % نضجت بمضارجها النجوم فأكرم ال % بيض السواغب في صفيف شواء % 59(@)(@@) % وجرت عليه من ظباه جداول % فخبت وفاضت في دم الأشلاء % 60(@)(@@) % علم تفرد وهو أوسط إخوة % شركوه في شرف وصدق إخاء % PageV01P308 61(@)(@@) % من كل أبلج تستضيء بوجهه % % وبرأيه في الليلة الظلماء % 62(@)(@@) % من شئت منهم فهو رام معرض % بالجزم نصلا أسهم الآراء % 63(@)(@@) % جمرات هيجاء إذا ما سالموا % % كانوا جنانا طيبات جناء % 64(@)(@@) % كهناء غيب يعلمون فراسة % قبل الوقوع حقائق الأشياء % 65(@)(@@) % وجبال حلم إن إليه نسبتهم % فهم هضاب القدس حول حراء % 66(@)(@@) % فإذا بدا وبدوا علمت بأنهم % قبسات ساطع ذلك اللألاء % 67(@)(@@) % لله في تقسيم جوهر فرده % حكم بدت في هذه الأجزاء % 68(@)(@@) % ووفوا فكانوا في محل بنانه % من راحتيه وأكمل الأعضاء % 69(@)(@@) % فهم مواعده وزينة مجده % وجمال وجه الدولة الغراء % 70(@)(@@) % نطف مطهرة أتت من طاهر % % فصفت من الأرجاس والأكداء % PageV01P309 71(@)(@@) % مولاي سمعا إن غر مدائحي % % فيكم لتشهد لي بصدق ولاءي % % 72(@)(@@) % ولئن شككت بما ادعيت من الولا % أو ليس هذا المدح نصح ولاء % 73(@)(@@) % أو ما تروني كلما بصدودكم % أحرقتم عودي يطيب شذاءي % % 74(@)(@@) % جارتني الفصحاء نحو مديحكم % فتلوا وكنت ملجأ البلغاء % 75(@)(@@) % أنا فرس والدك الذي ثمر الثنا % % منه جنته لكم يد النعماء % 76(@)(@@) % أرضعتكم در الفصاحة طيبا % إذ كان طيب روضه مرعاءي % % 77(@)(@@) % يا من أصول على الزمان ببأسه % ويجيب عند الحادثات نداءي % % 78(@)(@@) % بختان نصر الله قرت أعين الد % نيا وسرت مهجة العلياء % 79(@)(@@) % والوقت راق ورق حتى صفقت % % ورق الغصون على غنا الورقاء % 80(@)(@@) % فتهن بالولد السعيد وختنه % وارشف هنيئا شهدة السراء % PageV01P310 81(@)(@@) % وليه مافيك من شرف ومن % فخر ومن بأس ومن إعطاء % 82(@)(@@) % في بيتك 
ms103	 المعمور منذ ولاده % نشأ السرور به وكل هناء % 83(@)(@@) % نجم أتى من نيرين كلاهما % % وهباه أي سعادة وضياء % 84(@)(@@) % خلع القماط ففاز في خلع العلى % % وسعى فأدرك غاية العقلاء % 85(@)(@@) % لله طينته أكانت نقطة % نقطت ببسم الله تحت الباء % 86(@)(@@) % لله خاتمك الذي في نقشه % كتب المصور أعظم الأسماء % 87(@)(@@) % ريحانة النادي وشمعة أنسه % سلوانة الجلساء والندماء % 88(@)(@@) % الله يحرسه ويحرسكم معا % من سائر الأسواء والأرزاء % 89(@)(@@) % وعسى يمدكم الإله جميعكم % بزيادة الأعمار والأبناء % 90(@)(@@) % ويمد والدكم ودولة مجدكم % بدوام إقبال وطول بقاء % PageV01P311 البحر : طويل 1(@)(@@) % هلم بنا يا برق في أبرق الحمى % % نساقط در الدمع فردا وتوأما % % 2(@)(@@) % هلم بنا نقضي من الندب واجبا % لعصر مضى فيه وعهد تقدما % % 3(@)(@@) % فإن كنت لي يا برق عونا فقم بنا % % نروي قلوبا صاديات وأرسما % % 4(@)(@@) % تشبهت بي دعوى ولو كنت مشبهي % % بوجد إذا أصبحت تبكي معي دما % % 5(@)(@@) % فكم بين باك مستهام وبين من % تباكى خليا وهو يبدي التبسما % % 6(@)(@@) % تقمصت ثوبا من دخان ومهجتي % % عليها قميص من لظاك تجسما % % 7(@)(@@) % فواعجبا تسقي الربوع مدامعي % % وقلبي إلى سكانها يشتكي الظما % % 8(@)(@@) % أروح ولي قلب إذا ما نصحته % بماء عيوني كي يبوخ تضرما % % 9(@)(@@) % وأمسي ولي دمع يجود بمقلتي % % وثوب إذا ما أحجم جيشه كر معلما % % 10(@)(@@) % فمن لي بعصر كلما مر ذكره % بسمعي حلا عندي ووصل تصرما % % PageV01P312 11(@)(@@) % وليلات أنس نادمتني بدورها % % وفي الأرض زارتني بها أنجم السما % % 12(@)(@@) % شهاب تظن الشهب فيها لحسنها % % ثغور الغوابي البيض في حوة اللما % % 13(@)(@@) % سقى الله مغنى بالحمى صوب مزنه % يحوك له وشي الربيع المسهما % % 14(@)(@@) % ولا برحت فيه الأقاحي ضواحكا % ولا صرفت منها يد الدهر درهما % % 15(@)(@@) % محل به حل الشباب تمائمي % % فلا نقص إذ أصبحت فيه متمما % % 16(@)(@@) % ومصرع أسرى موثقين قلوبهم % بحومته أضحت مع الطير حوما % % 17(@)(@@) % حمى حرمة مس الصعيد صعاده % وأصبح فيه السيف بالحل محرما % % 18(@)(@@) % وثغر غدت منه الثنايا منيعة % فأضحى بنقع الصافنات مثلما % % 19(@)(@@) % قد اشتبهت آفاقه 
ms104	 في عراصه % فكل حوى منها بدورا وأنجما % % 20(@)(@@) % فكم ثم من شمس بليل تقنعت % وبدر ظلام بالنهار تعمما % % PageV01P313 21(@)(@@) % وليث عرين بالحديد مسربل % وخشف كناس بالنضلر تخرما % % 22(@)(@@) % تميل بأثواب الحرير غصونه % وتنطق بالسحر الحلال أن يتختما % % 23(@)(@@) % مكان به كنز من الحسن لم يزل % بآيات أرصاد الحديد مطلسما % % 24(@)(@@) % حمته سراة لا تزال رماتهم % مفوقة للحتف هدبا وأسهما % % 25(@)(@@) % قد اتخذوا للفتك والطعن آلة % قدود العذارى والوشج المقوما % % 26(@)(@@) % يرون هوان الحب عزا وسؤددا % وأحسن آجال النفوس التيتما % % 27(@)(@@) % تكاد الأقاحي خجلة من ثغورهم % تعود ثناياها شقيقا معندما % % 28(@)(@@) % إذا نظرت أقمارهم عين مبغض % يطالبهم في مغرم عاد مغرما % % 29(@)(@@) % بروحي منهم جيرة جاوروا الحمى % % فجاروا على قلب بهم قد تذمما % % 30(@)(@@) % هم ألهبوا صدري وفيه توطنوا % % فلله جنات ثوت في جهنما % % PageV01P314 31(@)(@@) % حلالي بهم مر العذاب كم احلا % % لنفس علي خوضها الحتف مطعما % % 32(@)(@@) % همام لدى الهيجاء لو أن بأسه % ببحر طما في مده لتحجما % % 33(@)(@@) % وذو عزمات تصاغ صوارما % لأوشكن في صم الصفا أن تصمما % % 34(@)(@@) % سلالةخيرالمرسلين مطهر % أتى طاهرا من كل أبلج أكرما % % 35(@)(@@) % أجل ملوك الأرض قدرا وقدرة % وأشرفهم نفسا وأطيب منتمى % % 36(@)(@@) % جواد أتى والجو جون فأصبحت % أياديه فيه كالشياه بأدهما % % 37(@)(@@) % ووافى المعالي بعدنما خر سقفها % % فشيد من أركانها ما تهدما % % 38(@)(@@) % إذا الدهر أجرى جحفلا كان قبله % وإن هز سيفا كان كفا ومعصما % % 39(@)(@@) % كريم عيون الجود لولا وجوده % لفاضت جواريها وأغضت على عمى % % 40(@)(@@) % وطلف براه الله لناس مجملا % فنوعه بالمكرمات وقسما % % PageV01P315 41(@)(@@) % هو العدل إلا أنه إذ يرومه % عدو بظلم كان أدهى وأظلما % % 42(@)(@@) % هلال حمام فوقه من دلاصه % هلال حياة يترك الحتف أقضما % % 43(@)(@@) % وبدر كمال بالسروج بروجه % وليث نزال بالعوالي تأجما % % 44(@)(@@) % يرى عامل الخطي قدا مهفهفا % ويحسب إيماض اليماني تبسما % % 45(@)(@@) % إذا ما تولى للوثوب على العدا % % يكاد عليهالدرع أن يتفصما % % 46(@)(@@) % غني لديه لا يزال من الثنا % % كنوز وإن أضحى من المال معدما % % 47(@)(@@) % له نقم 
ms105	 محذورة عند سخطه % ولا غرو أن عادت من العفو أنعما % % 48(@)(@@) % ضحوك إذا استمطرته فهو بارق % يجود وإن جربته كان مخذما % % 49(@)(@@) % وصعب إذا استعطفته لان جانبا % وعذب إذا عاديته صار علقما % % 50(@)(@@) % حوى البأس والمعروف والنسك والنهى % % النهى وحاز المعالي والتقى والتكرما % % PageV01P316 51(@)(@@) % أعار وميض الصاعقات حسامه % وصاغ لسان الموت للرمح لهذما % % 52(@)(@@) % وبرقع في فجر الصباح جياده % وجللها ليلا من النقع معلما % % 53(@)(@@) % فتى أصلح الأيام بعد فسادها % % وكمل أعوان الكرام وتمما % % 54(@)(@@) % وبين ما بين الضلالة والهدى % % فأوضح نهجا طالما كان قيما % % 55(@)(@@) % وقوم زيغ الدين بعد اعوجاجه % فأصبح فيه بعد ما كان قيما % % 56(@)(@@) % وألزم أهل النصب بالنص فاغتدى % % فصيحهم لا يحسن النطق أبكما % % 57(@)(@@) % فلولاه لم يصف الغدير من القذى % % وأصبح غورا ماؤه وتأجما % % 58(@)(@@) % أفاض عليه من أدلة فهمه % سيولا فأضحى طيب الورد مفعما % % 59(@)(@@) % ذكي إذا قصت دواوين مدحه % تنفس صبح الطرس مسكا مختما % % 60(@)(@@) % له قلم يجري الزمان بما جرى % % ويسعى القضا في إثر مسعاه حيثما % % PageV01P317 61(@)(@@) % يمج رضاب النحل طورا لسانه % وينفث طورا نابه سم أرقما % % 62(@)(@@) % يراع يريع البيض إمضاء حكمه % فتحسب أمضاهن ظفرا مقلما % % 63(@)(@@) % يترجم ما يوحي إليه جنانه % فينثر درا في السطور منظما % % 64(@)(@@) % فصيح عن الأسماء جمجم لفظه % وأسمع معناه القلوب وأفهما % % 65(@)(@@) % بروحي منه راحة نفحت بها % % أنامله من دوحه فتكلما % % 66(@)(@@) % تتبع خضر الخط حتى استوى بها % % فحل على عين الحياة وخيما % % 67(@)(@@) % وشارف منها روضة القدس فادعى % % إخاء عصا موسى وأقلام مريما % % 68(@)(@@) % تقدست من طود بأيمن طوره % كريم روى فصل الخطاب وترجما % % 69(@)(@@) % أمولاي إن الدهر يعلم فضلكم % ويعرفكم أندى بنيه وأكرما % % 70(@)(@@) % تملكتم رق الزمان وأهله % فليس الليالي فيه إلا لكم إما % % PageV01P318 71(@)(@@) % لقد كان وجه الأرض أطلس مغبرا % فأمسى لكم كالأفق يزهو منجما % % 72(@)(@@) % تواضعكم أدنى مواضعكم لنا % % وقدركم فوق السموات قد سما % % 73(@)(@@) % لعمرك ما جود السحاب غزيرة % ولكنه علمته فتعلما % % 74(@)(@@) % جريت مع الأقدار في كل غاية % فلم 
ms106	 ندر من كان المؤثر منكما % % 75(@)(@@) % بفتوى أخيك السيف زوجت العلى % % فعز حماها حيث صرت لها حمى % % 76(@)(@@) % % وينبت نوار النضار إذا همى % % 77(@)(@@) % ولا برح الدهر الحروب إذا سطا % % يزورك بالأفراح سلما مسلما % % 78(@)(@@) % ووافاك عيد الفطر بالعز دائما % ووفاك صوم الدهر أجرا معظما % % PageV01P319 البحر : كامل تام 1(@)(@@) % خلط الغرام الشجو في أمشاجه % فبكى فخلت بكاه من أوداجه % 2(@)(@@) % ودعته غزلان العقيق إلى السرى % % فغدا يساري النجم في إدلاجه % 3(@)(@@) % ودعته ناحلة الخصور إلى الضنى % % فكسته صفر الوشي من ديباجه % 4(@)(@@) % تملي عيون الغانيات عليه ما % % يملي النديم به كؤوس زجاجه % 5(@)(@@) % يا من لقلب يستضيئ بقلبه % فكأن جنته ذبال سراجه % 6(@)(@@) % دنف أعارته الخصور سقامها % % أين الأطبا من عزيز علاجه % 7(@)(@@) % قد ظن سكب الدمع يخمد ناره % سفها به فتأججت بأجاجه % 8(@)(@@) % وبياض ساعده المساعد لوعتي % % لله ما صنعب يدا إعواجه % 9(@)(@@) % قربت محاسنه وعز وصوله % فبدا بدو البدر في أبراجه % 10(@)(@@) % كم من ظلام فيه قد نادمته % حتى بدت نار الصباح بساجه % PageV01P320 11(@)(@@) % ولرب زائر أيكة لو أنه % يدعو الجماد لزاد في إبهاجه % 12(@)(@@) % ولقد تأملت الزمان وأهله % وأجلت عين النقد في أفواجه % 13(@)(@@) % فرأيت عربدة الزمان عزيزة % في حال سكرته وصحو مزاجه % 14(@)(@@) % ولربما ظن السفينة بأنه % يصحو بلى لكن لاستدراجه % 15(@)(@@) % ويسر قلب الدهر كل عجيبة % لم يفشها إلا بنو أزواجه % 16(@)(@@) % ورأيت أغلى ما عليه من الحلى % % أربابه وعلي درة تاجه % 17(@)(@@) % قيل تواخى بالمكارم والتقى % % والجود والمعروف منذ نتاجه % 18(@)(@@) % سمح إذا فقد الثرى صوب الحيا % % وشكا الظما يسقيه من ثجاجه % 19(@)(@@) % بطل إذا هز القنا بأكفه % تضحي القلوب مراجزا لزجاجه % 20(@)(@@) % أسد إذا لقي الخميس فعنده % كبش الكثيبة من أذل نعاجه % PageV01P321 21(@)(@@) % جمع الأسود إذا لقيه لدى الوغى % % حذرا يبدل زأره بثؤاجه % 22(@)(@@) % لجب الجيوش إذا يمر بسمعه % لجب الذئاب يظن في أهزاجه % 23(@)(@@) % يقري بلحم الشوس شاغبة الظبا % % ويزيد حر الضرب في إنضاجه % 24(@)(@@) % ترجى منافعه ويحذر ضره % في يوم نائله 
ms107	 ويوم هياجه % 25(@)(@@) % كسد المديح وأكدحوا نظامه % حتى أتى فأقام سوق زواجه % 26(@)(@@) % با ابن الذي ساد الأنام ونجل من % فاق الملائك في علا أدراجه % 27(@)(@@) % إن المديح إذا أردت ثناءكم % تهوي النجوم إلي من أبراجه % 28(@)(@@) % وإذا قصدت سواكم فيه فلم % تظفر يدي إلا ببيض دجاجه % 29(@)(@@) % أيدت دين الحق بعد تأود % وسددت بالإحكام كل فجاجه % 30(@)(@@) % وشفيت علته بكتب قد غدت % مثل الطبائع لاعتدال مزاجه % PageV01P322 31(@)(@@) % أسفار صدق كل خصم مبطل % منها سيعلم كاذبات حجاجه % 32(@)(@@) % نور مبين قد أنار دجى الهوى % % ظلم الضلالة في ضياء سراجه % 33(@)(@@) % وغدير ختم بعد ما لعبت به % ريح الشكوك وآض من لجاجه % 34(@)(@@) % أمطرته بسحابة سميتها % % خير المقال وضاق في أمواجه % 35(@)(@@) % وأبنت في نكت البيان عن الهدى % % فأريتنا المطموس من منهاجه % 36(@)(@@) % وكذاك منتخب من التفسير لم % تنسج يدا أحد على منساجه % 37(@)(@@) % للأعرجين وإن بدت شرفاته % لن يبلغا المعشار من معراجه % 38(@)(@@) % مولاي قد ذهب الصيام مودعا % وأتاك شهر الفطر باستبهاجه % 39(@)(@@) % شهر نوى قتل الصيام هزبره % فاغتالمهجته بمخلب عاجه % PageV01P323 البحر : بسيط تام 1(@)(@@) % سل ضاحك البرق يوما عن ثناياها % % فقد حكاها فهل يروي حكاياها % % 2(@)(@@) % وهل درى كيف رب الحسن رتلها % % والجوهر الفرد منه كيف جزاها % % 3(@)(@@) % وهل سقاه الطلا تدري إذا ابتسمت % أي الحيا بان عند الشرب أشهاها % % 4(@)(@@) % وسل أراك الحمى عن طعم ريقتها % % فليس يدري سواه في محياها % % 5(@)(@@) % وهل رياض الربا تدري شقائقها % % في خدها أي خال في سويداها % % 6(@)(@@) % وإن رأيت بدور الحي وهي بهم % فحي بالسر عني وجه أحياها % % 7(@)(@@) % واقصد لبانات نعمان وجيرتها % % واذكر لبانات قلبي عند لبناها % % 8(@)(@@) % عرج عليها عن الألباب ننشدها % % فإننا منذ أيام فقدناها % % 9(@)(@@) % طعن يصور بالأجسام أقواها % % عن أنفس وقلوب ثم مثواها % % 10(@)(@@) % معاهد كلما أمسيت عامرها % % ليلا وأصبحت مجنونا بليلاها % % PageV01P324 11(@)(@@) % ورب ليل به خضت الظلام كما % % يخوض في مفرق العذراء مدراها % % 12(@)(@@) % جون كحظ به الآفاق قد خضبت % بياضها وجرى بالقار جرياها % % 13 
ms108	(@)(@@) % تبدو النجوم فلم تصبر لظلمته % مثل الشرار بجوف الزند أخفاها % % 14(@)(@@) % هوت بنا فيه عيس كالجبال سمت % نحو السماء ولو شئنا مسسناها % % 15(@)(@@) % ركائب كحروف ركبت جملا % أكرم بها من حروف قد سطرناها % % 16(@)(@@) % أنعام هجن حكت روح النعام إذا % % مرت بها الريح ظنتها نعاماها % % 17(@)(@@) % حتى نزلنا على الدار التي شرفت % بمن بها ولثمنا در حصاها % % 18(@)(@@) % فعاوضتنا بدور من فوراسها % % تحمي خدور شموس من عذاراها % % 19(@)(@@) % ضيفانهم غير أنا لا نريد قرى % % إلا قلوبا إليهم قد أضفناها % % 20(@)(@@) % ما كان يجدي ولا يغني السرى دنفا % لكن حاجة نفس قد أضفناها % % PageV01P325 21(@)(@@) % من لي بوصل فتاة دون مطلبها % % طعن يصور بالأجسام أمواها % % 22(@)(@@) % عزيزة هي شفع الكيمياء لها % % ندي وجودا ولكن ما وجدناها % % 23(@)(@@) % فيها من الحسن كنز لا يرى وكذا % % تخفي الكنوز المنايا في زواياها % % 24(@)(@@) % تكاد ترشح نورا كلما خطرت % بالمشي لا عرقا من كل أمضاها % % 25(@)(@@) % كأنما الفجر رباها فأرضعها % % حليبه وبقرص الشمس غذاها % % 26(@)(@@) % قد صاغها الله من نور فأبرزها % % 27(@)(@@) % محجوبة لا ينال الوهم رؤيتها % % ولا تصيد شراك النوم رؤياها % % 28(@)(@@) % قد منعتها أسود مثل أعينها % % سيوفهم لا تنال البرء جرحاها % % 29(@)(@@) % لو تمسك الريق كادوا حين تقطرها % % أن يلعقوها فلم ترحل برياها % % 30(@)(@@) % ورحمة لجميع الناس سواها % % لفت على زفرات الرعد أحشاها % % PageV01P326 31(@)(@@) % وإن تنفس صبح عن لظى شفق % قاموا غضابا وظنوا الصبح يهواها % % 32(@)(@@) % حرصا عليهم نواح الورق يسخطهم % توهما أن داء الحب أشجاها % % 33(@)(@@) % تهوى الفراش إليها كلما سفرت % فيسترون غياراها محياها % % 34(@)(@@) % بين القلوب وعينيها مضى قسم % أن لا تصح ولا تصحو سكاراها % % 35(@)(@@) % وبالجمال على أهل الهوى حلفت % أن لا تموت ولا تحيا أساراها % % 36(@)(@@) % لله أيام لهو بالعقيق وإن % كانت قصارا وساءتني قصاراها % % 37(@)(@@) % أوقات أنس كأن الدهر أغفلها % % أو من صروف الليالي ما عرفناها % % 38(@)(@@) % لم نشك من محن الدنيا إلى أحد % من البرية إلا كان إحداها % % 39(@)(@@) % أعيذ نفسي من الشكوى إلى بشر % بالله والقائم المهدي 
ms109	 مولاها % % 40(@)(@@) % إبن النبي أبي الفضل الأبي أخي ال % % معروف خير بني الدنيا وأزكاها % % PageV01P327 41(@)(@@) % نور الزجاجة مصباح توقد من % نار الكليم التي في الطور ناجاها % % 42(@)(@@) % جزء من العالم القدسي همته % ينوء بالعالم الكلي أدناها % % 43(@)(@@) % تاج الوزارة طوق المجد خاتمه % إنسان عين المعالي زند يمناها % % 44(@)(@@) % حليف فضل به تدري الوزارة إذ % فيها تجلى بأي الفضل حلاها % % 45(@)(@@) % طيب النبوة فيه عنه يخبرنا % % بأنه ثمر من دوح طوباها % % 46(@)(@@) % كريم نفس من الإحسان قد جبلت % منه الطباع فعم الناس جدواها % % 47(@)(@@) % عظيمة يتقي الجبار سطوتها % % زكية تعرف العباد تقواها % % 48(@)(@@) % تقضي بسعد ونحس في الورى فلها % % حكم النجوم الدراري في قضاياها % % 49(@)(@@) % للطالبين كنوز في أناملها % % وللزمان عقود من سجاياها % % 50(@)(@@) % في أصفهان ديار العز منزله % ونفسه فوق هام النجم مسعاها % % PageV01P328 51(@)(@@) % يرمي الغيوب بآراء مسددة % مثل السهام فلا تخطي رماياها % % 52(@)(@@) % عزت به الدولة العلياء واعتدلت % حتى ملا الأرض قسطا عدل كسراها % % 53(@)(@@) % عمادها العلم والمعروف نائبها % % إكسيرها مومياها برء أدواها % % 54(@)(@@) % لم يتركن ظالما غير العيون بها % % إذ لا تجازى بما تجنيه مرضاها % % 55(@)(@@) % أفديه من عالم تشفي براعته % مرضى قلوب الورى في نفث أفعاها % % 56(@)(@@) % للفاضلين سجود حين يمسكها % % كأن سر العصا فيها فألقاها % % 57(@)(@@) % كأنما ليلنا تطوى غياهبه % إذا صحائفه فيها نشرناها % % 58(@)(@@) % سطورها عن صفوف الجيش مغنية % وأي جيش وغى بالرد يلقاها % % 59(@)(@@) % كأنما ألفات فوقها رقمت % على الأعادي رماحا قد هززناها % % 60(@)(@@) % نسطو بهن على الخصم الملم بنا % % كأن راءاتها قضب سللناها % % PageV01P329 61(@)(@@) % إذا رأينا الحروف المهملات بها % % فودنا بالأناسي لو لقطناها % % 62(@)(@@) % قوم تنال الأماني والأمان بها % % وآخرون بها تلقى مناياها % % 63(@)(@@) % لم يظفر الفهم يوما في تصورها % % ولا يزور خيال الوهم مغناها % % 64(@)(@@) % وبنت فكر سحاب الشك حجبها % % عن العقول وليل الغي غشاها % % 65(@)(@@) % جرت فأجرت لها من عين حكمته % ما لو يفيض على الأموات أحياها % % 66(@)(@@) % فرال عنها نقاب الريب وانكشفت % أسرارها وتجلى وجه معناها % % 67(@)(@@) % قل للذين ادعوا 
ms110	 في الفضل فلسفة % قد أبطل الحجة المهدي دعواها % % 68(@)(@@) % من طور سيناء هذا نور فطنته % % فمن أرسطو ومن طور ابن سيناها % % 69(@)(@@) % فليفخر الفرس وليزهوا بسؤددهم % على جميع الورى وليحمدوا الله % 70(@)(@@) % بمن يقاسون في الدنيا ودولتهم % وزيرها من بني طه ومولاها % % PageV01P330 71(@)(@@) % من مالك أصبح المهدي آصفها % % وقام فيها سليمان الورى شاها % % 72(@)(@@) % إن الرعاية لا تعزى إلى شرف % إلا إذا كانت الأشراف ترعاها % % 73(@)(@@) % يا ابن النبوة حقا أنت عترتها % % فقد حويت كثيرا من مزاياها % % 74(@)(@@) % حافظت فيها على التقوى ودمت على % % عهد المودة والحسنى بقرباها % % 75(@)(@@) % كم في ثناياك منا نفحة عبقت % إليك فيها اهتدينا إذ شممناها % % 76(@)(@@) % من كل منبقة بالفضل معجزة % آياتها من سواكم ما عرفناها % % 77(@)(@@) % مفاخر قبل تشريفي برؤيتكم % آمنت بالغيب فيها إذ سمعناها % % 78(@)(@@) % عنها ثقات بني المهدي قد نقلوا % % لنا روايات صدق فاعتقدناها % % 79(@)(@@) % كانت كنثر اللآلي في مسامعنا % % واليوم فيك عقود قد نظمناها % % 80(@)(@@) % شكرا لصنعك من حر لسادتنا % % بعد الإياس وهبت الملك والجاها % % PageV01P331 81(@)(@@) % تزلزلت في بني المهدي دولتهم % لكن فيك إله العرش أرساها % % 82(@)(@@) % تطلب الفرس والأعراب خطبتها % % فما سمحت بها إلا لأولاها % % 83(@)(@@) % زوجتها بكريم النفس أطهرها % % فرجا وأوفرها علما وأتقاها % % 84(@)(@@) % لولا وجودك يا ابن المصطفى غصبت % منا حقوق معال قد ورثناها % % 85(@)(@@) % عنا رفعت زمان السوء فانقمعت % % بالكره شوكته حتى وطئناها % % 86(@)(@@) % مولاي دعوة مشتاق حشاشته % لولا الرجاء أوار المجد أوراها % % 87(@)(@@) % إليك قد بعثته رغبة غلبت % لم يهجر الأهل والأوطان لولاها % % 88(@)(@@) % لعل عزمة نشط فيك قد رحلت % يرقى الجبال ليلقى طور سيناها % % 89(@)(@@) % فحل بقعة قدرس حين شارفها % % ما شك أنك نار أنت موساها % % 90(@)(@@) % توهم النور نارا إذ رآك وكم % نفس تغالطها في الصدق عيناها % % PageV01P332 91(@)(@@) % دنا ليقبس نارا أو يصيب هدى % إلى مدارك غايات تمناها % % 92(@)(@@) % حاشا عن الرؤية العظمى تجاب بلن % فكل قصد كليم الشوق إياها % % 93(@)(@@) % إن لم يعد باليد البيضاء منك إلى % % ديار مصر أتى منها فقد تاها 
ms111	 % % 94(@)(@@) % عسى بكم ينجح الرحمن مطلبه % فقد توسل فيكم يا بني طه % PageV01P333 البحر : طويل 1(@)(@@) % ينم عليه الدمع وهو جحود % وينتحل السلوان وهو ودود % 2(@)(@@) % ويذكر ذهلا والهوى حيث عامر % ومنزل حزوى والمراد زرود % 3(@)(@@) % ويظهر في لبنى الغرام موريا % ومنه إلى ليلى الضمير يعود % 4(@)(@@) % ويشتاق آرام العقيق وإنه % لعمرك في أشباهها لعميد % 5(@)(@@) % ويصحو فتأتيه الصبا برواية % عن البان تسقيه الطلى فيميد % 6(@)(@@) % تحدثه عن أهله فتميته % وتنفحه في نشرهم فيعود % 7(@)(@@) % أروح ولي روح تسير مع الصبا % % لها صدر نحو السما وورود % 8(@)(@@) % وقلب على كل الخطوب إذا دهت % سوى الدل والبين المشت جليد % 9(@)(@@) % وعين لو ان المزن تحمل ماءها % % لأمسى اشتعال البرق وهو خمود % 10(@)(@@) % إذا شمت إيماضا حدت مزن عبرتي % % نم الزفرات الصاعدات رعود % PageV01P334 11(@)(@@) % علام الجفون السود منكرو دمي % % وفي الوجنات البيض منه شهود % 12(@)(@@) % وما بال هاتيك الخصور نحيفة % أهن لأبناء الكمال جدود % 13(@)(@@) % وما بالنا أحداقنا في نفوسنا % % بحب الظباء الباخلات تجود % 14(@)(@@) % نسمي السيول الحمر منها تجاهلا % دموعا وندري أنهن كبود % 15(@)(@@) % وإني من القوم الذين بنانهم % % وألسنهم للسائلين تفيد % 16(@)(@@) % نسود الأسود الضاريات وإن غدا % % لنا الظبيات الكانسات تسود % 17(@)(@@) % وتضرعنا بيض الظبا وهي أعين % ونحطمها بالهام وهي حديد % 18(@)(@@) % أما وبدور أشرقت وهي أوجه % وسود ليال طلن وهي جعود % 19(@)(@@) % وأغصان بان تنثني في غلائل % وسمر رماح فوقهن برود % 20(@)(@@) % وبيض نحو تحتمي في أساور % وأجفان آرام بهن أسود % % PageV01P335 21(@)(@@) % وأطواق تبر هن للعين حلية % وللصب في أسرار الغرام قيود % 22(@)(@@) % لفي القلبش وجد لو حوى اليم بعضه % لأضحت الحيتان وهي وقود % 23(@)(@@) % وفي الخد دق لو سقى الروض أصبحت % أقاحيه بالأكمام وهي ورود % 24(@)(@@) % فكم في البكا ينثرن ياقوت أدمعي % % ثغور تحاكي الدر وهو نضيد % 25(@)(@@) % ثغور تذيب القلب وهي جوامد % وتضرم في النار وهي برود % 26(@)(@@) % فحتام لا نار الصبابة تنطفي % % ولا للدموع الجاريات جمود % 27(@)(@@) % لعمرك قبل الشيب لم أعرف الدمى % % تسوق إلي الحتف وهو 
ms112	 صدود % 28(@)(@@) % ولم أدر قبل الحب أن يبعث القضا % % إلي المنايا الحمر وهي خدود % 29(@)(@@) % وما خلت أن اللدن والصبر لا متى % % تمكن في الطعن وهي قدود % % 30(@)(@@) % ولم أحسب الرمان من ثمر القنا % % إلى أن رأته العين وهو نهود % PageV01P336 31(@)(@@) % بروحي ظباء نافرات عيونها % % شراك بها صيد الأسود تصيد % 32(@)(@@) % لها لفتات مهلكات كأنها % % لسرح الردى روض القلوب ترود % 33(@)(@@) % كأن على أعناقها ونحورها % % تنظم من مدح الحسين عقود % 34(@)(@@) % قريب إلى المعروف تدعوه شيمة % بها عرفت آباؤه وجدود % 35(@)(@@) % سحاب به تحمى النفوس إذا همى % % وينبت في روض الحديد جلود % 36(@)(@@) % همام إذا لاقى العدا وهو وحده % يصيد أسود الجيش وهو عديد % 37(@)(@@) % من الطعن يحمي العرض عن جنة الندى % % وللمال في سيف النوال يبيد % 38(@)(@@) % أخو كرم أما نوال بنانه % فدان وأما مجده فبعيد % 39(@)(@@) % كأن بيوت المال منه لجوده % عيون محب والحطام هجود % 40(@)(@@) % له شثن أظفار المنايا صوارم % وأجنحة النصر العزيز بنود % PageV01P337 41(@)(@@) % إذا الجدول الهندي يجري بكفه % ففي الورد منه كم يغص وريد % 42(@)(@@) % مقر عواليه القلوب كأنها % % إذا هزها نحو الصدور حقود % 43(@)(@@) % تكهل في علم العلا وهو يافع % وجاز بلوغ الحلم وهو وليد % 44(@)(@@) % وأفصح عن فصل الخطاب بمنطق % لديه لبيد ضارع وبليد % 45(@)(@@) % له بصر يرنو به عن بصيرة % يجوز حدود الغيب وهو حديد % 46(@)(@@) % وليل إذا استجلاه في ليل مارق % غدا لصباح النحج وهو عمود % 47(@)(@@) % وعزم لو أن البيض تحكيه ما نبت % لها عن صدور الدارعين حدود % 48(@)(@@) % وقضب كأمثال النجوم تقدرت % بهن نحوس للورى وسعود % 49(@)(@@) % كأن ضياها للعباد طوالع % ففيها شقي منهم وسعيد % 50(@)(@@) % تشكي الظما منها الشفار وفي الدما % % لها وهي نار القيون ورود % PageV01P338 51(@)(@@) % وتهوى الطلا حتى كأن أديمها % % لها قدما فيه اكتسبن غمود % 52(@)(@@) % سل الغيث عنه إن جهلت فإنه % يقر له بالفضل وهو حسود % 53(@)(@@) % وما الرعد إلا صوت زجر له على % % تشبهه في جوده ووعيد % 54(@)(@@) % وليس انحناء البيض إلا لعلمها % % به 
ms113	 أنه الأمضى فهن سجود % 55(@)(@@) % إذا الدهر أفنى نجله أنفس الغنى % % أفيض عليها من نداه وجود % 56(@)(@@) % دنا فتدلى للعطاء ونعله % له فوق إكليل النجوم صعود % 57(@)(@@) % يسير فتغدو الربد وهي سوابق % لديه وتضحي الفتخ وهي جنود % 58(@)(@@) % قوادمها للشوس ترسل نيله % وأحشاؤها للخائنين لحود % 59(@)(@@) % فيا ابن علي وهي دعوة مخلص % له عهد صدق في ولاك أكيد % 60(@)(@@) % لقد نفذ الرحمن حكمك في الورى % % فلنت لهم لفظا وأنت شديد % PageV01P339 61(@)(@@) % وكافأت بالإحسان من ساء فعله % إليك فحزت الفضل وهو حميد % 62(@)(@@) % وعطلت بئر الظلم حتى تهدمت % فأصبح قصر العدل وهو مشيد % 63(@)(@@) % أرضت خطوب الدهر وهي جوامح % وطاوعك المقدار وهو عنيد % 64(@)(@@) % ليهنك عيد الفطر يا بهجة الورى % % وملك قديم عاد وهو جديد % 65(@)(@@) % فما البصرة الفيحاء إلا قلادة % وأنت بها نحر يليق وجيد % 66(@)(@@) % بطيبك طابت أرضها مذ حللتها % % فسافر منها المسك وهو صعيد % 67(@)(@@) % فلا زلت محروس الجناب مملكا % حليفاك فيها دولة وخلود % 68(@)(@@) % تزورك أملاك الورى وهي خضع % وتقصدك الأيام وهي وفود % PageV01P340 البحر : بسيط تام 1(@)(@@) % هذا الحمى يا فتى فانزل بحومته % واخضع هنالك تعظيما لحرمته % 2(@)(@@) % وإن وصلت إلى حي بأيمنه % بعد البلوغ فبالغ في تحيته % 3(@)(@@) % وحل بالحل واكحل بالثرى بصرا % وقبل الأرض واسجد نحو قبلته % 4(@)(@@) % واطمع بما فوق إكليل النجوم ولا % ترجو الوصول إلى ما في أكلته % 5(@)(@@) % واحذر أسود الشرى إن كنت مقتنصا % فإن حمر ظباها دون ظبيته % 6(@)(@@) % لله حي إذا أوتاده ضربت % يودها الصبلو كانت بمهجته % 7(@)(@@) % بجزعه كم قضت من مهجة جزعا % وكم هوت كبد حرى بحرته % 8(@)(@@) % لم يمكن المرء حفظا للفؤاد به % يوما ولو كان مقبوضا بعشرته % 9(@)(@@) % ما شئت فيه اقتراح إلا الأمان على % % قرحى القلوب وإلا وصل نسوته % 10(@)(@@) % رب الحسام وذات الجفن فيه سوى % كل غدا الحتف مقرونا بضربته % PageV01P341 11(@)(@@) % لن تخفي الحجب أنوار الجمال به % فربة السجف فيه كابن مزنته % 12(@)(@@) % قد أنشأ الغنج شيطان الغرام به % فقام يدعو إلى شيطان فتنته 
ms114	 % 13(@)(@@) % والحسن فيه لسلطان الهوى أخذت % يداه في كل قلب عقد بيعته % 14(@)(@@) % أقماره لحديد الهند حاملة % تحمي شموس العذارى في أهلته % 15(@)(@@) % الله في نفس مصدور بكم خرجت % فكان موسى ويحيى مثل حيته % 16(@)(@@) % فحبكم لتحبوه فهام وما % % يدري محبته تصحيف محنته % 17(@)(@@) % صنتم صغار اللاءلي من مباسمكم % عنه وغرتم على ياقوت عبرته % 18(@)(@@) % فكم أسير رقاد عنه رقكم % فادى جفونكم المرضى بصحته % 19(@)(@@) % يا حاكمي الجور فينا من معاطفكم % تعلموا العدل وانحوا نحو سنته % 20(@)(@@) % قلبي لدى بعضكم رهن وبعضكم % هذا دمي صار مطلولا بوجنته % PageV01P342 21(@)(@@) % وذا ابن عيني خال في مورده % وذاك نومي مسروق بمقلته % 22(@)(@@) % أفدي بكم كل مخصور ذؤابته % تتلو لنا ذكر فرعون وفرقته % 23(@)(@@) % كأنما الخضر فيما نال شاركه % ففي المراشف منه طعم جرعته % % 24(@)(@@) % أعيذ نفسي بكم من سحر أعينكم % فإن أصل بلائي من بليته % 25(@)(@@) % في كل نوع مراد من محاسنكم % نوع من الموت يأتينا بصورته % 26(@)(@@) % تكاد قلبي إذا مر النسيم بكم % عليه في النار يحمى من حميته % 27(@)(@@) % يا حبذا غر أيام بنا سلفت % على منى وليالينا بحمرته % 28(@)(@@) % أوقات أنس كست وجه الزمان سنى % فأهلكوا برجوم من أسنته % 29(@)(@@) % كم نشقتنا رياحين الوصال به % يد الرضا وسقتنا كأس بهجته % 30(@)(@@) % كأن لطف صباها في أصائلها % % لطف الوزير حسين في رعيته % PageV01P343 31(@)(@@) % فزنا بها وأمنا كل حادثة % كأنما نحن في أيام دولته % 32(@)(@@) % مضت وللآن عندي ليس يفضلها % % شيء من الدهر إلا يوم نصرته % 33(@)(@@) % يوم به أعين الأعداء باكية % والسيف يبسم مخضوبا بعزته % 34(@)(@@) % والحتف يترع كاسات النجيع به % والرمح يهتز نشوانا بخمرته % 35(@)(@@) % والذنب أصبح مسرورا ومبتهجا % والليث يندب مفجوعا بإخوته % 36(@)(@@) % لقد رماها بموالر ذوابله % مثل الصلال تسقت سم عزمته % 37(@)(@@) % جيش إذا سار يكسو الجوعثيره % فتعثر الشمس في أذيال هبوته % 38(@)(@@) % دروعه الحزم من تسديد سيده % وبيض راياته آراء حكمته % 39(@)(@@) % إذا الجبال له في غارة عرضت % إلى الرحيل تنادت عوف وطأته % 40(@)(@@) % ترى به كل 
ms115	 مقدام بكل وغى % يرى حصول الأماني في منيته % PageV01P344 41(@)(@@) % شهم إذا ما غدير الدرع جلله % منه توهمت ثعبانا بحليته % % 42(@)(@@) % وإن تأبطت سيفا خلته قدرا % يجري وتجري المنايا تحت قدرته % 43(@)(@@) % فأصبح الحي منها حين صبحها % % يذري الدموع على الصرعى بعرصته % 44(@)(@@) % قد توج الضرب بالهامات معقله % وورد الطعن منه خد تربته % 45(@)(@@) % لم يدر يفرح في فتح الحسين له % إذ حازه أم يعزى في أعزته % 46(@)(@@) % فتح أتاه وكان الصوم ملبسه % فهز عطفيه في ديباج خلعته % 47(@)(@@) % أشاب فوديه باأهوال أولله % وعاد أول يوم من شبيبته % 48(@)(@@) % فتح تراه المعالي نور أعينها % % ويكتسي المجد فيه يوم زينته % 49(@)(@@) % إذا الرواة أتوا في ذكره سطعت % مجامر الند من ألفاظ قصته % 50(@)(@@) % سلش الهفوف عن الأعراب كم تركوا % % من الكنوز وجنات بنقعته % PageV01P345 51(@)(@@) % وسائل الجيش عنهم كم بهم نسفت % عواصف النصر طوقا عند سطوته % 52(@)(@@) % ما هم بأول قوم حيهم فردوا % % 53(@)(@@) % يضيق رحب الفضا في عين هاربهم % خوفا وأضيق منها درع حيلته % 54(@)(@@) % يا خالديون خنتم عهد سيدكم % هلا وفيتم وخفتم بأس صولته % 55(@)(@@) % يحيا دعاكم لمولاكم لتقتبسوا % % من نوره فاصطليتم نار جذوته % 56(@)(@@) % من جيشه أحرقتكم نار صاعقة % فكيف لو تنجلي أنوار طلعته % 57(@)(@@) % عارضتموه بسحر من تخيلكم % فكان موسى ويحيى مثل حتته % 58(@)(@@) % أضلكم عن هداكم سامريكم % حتى اتخذتم إلها عجل ضلته % 59(@)(@@) % كنتم بفوز وجنات فأخرجكم % إبليس منها وحزتم خزي لعنته % 60(@)(@@) % براك ربك ما براك منه ولا % % خصصت في بركات من عطيته % PageV01P346 61(@)(@@) % كفرت في ربك الثاني وخنت به % يكفيك ما فيك من حرمان نعمته % 62(@)(@@) % يا زينة الملك بل يا تاج سودده % وحلية الفخر بل يا طرز حلته % 63(@)(@@) % إن كان من فتح عمورية بقيت % ذرية من بنيه أو عشيرته % 64(@)(@@) % فإن فتحك هذا فذ توأمه % وإن نصرك هذا صنو نخلته % 65(@)(@@) % لو كان يدري له بالقبر معتصم % لقام حيا وعادت روح غيرته % 66(@)(@@) % فليهنك الله في النصر العزيز وفي ال % فتح المبين وفي إدراك 
ms116	 رفعته % 67(@)(@@) % وليت والدك المرحوم يشهد ما % % منك الحضور رواه حال غيبته % 68(@)(@@) % من مبلغ عنك هذا الفتح مسمعه % لكي تكون سواء في مسرته % 69(@)(@@) % سمعا فديتك مدحا من حليف ولا % % عليه صدق ولاء من عقيدته % 70(@)(@@) % مدحا على وجنتيه وردتا خجلي % % منكم وأوضح عذري فوق غرته % PageV01P347 71(@)(@@) % بوجهه من ظنوني في مكارمكم % آثار حسن وبشر فوق بشرته % 72(@)(@@) % أحرقت بالصد عودي فاستطاب شذا % أما تشم مديحي طيب نفحته % 73(@)(@@) % هذا الذي كان في ظرفي نصحت به % فارشف طلا كأسه والذذ بشهدته % 74(@)(@@) % واغفر فدى لك نفسي ذنب معترف % بفضلكم مستقيل من خطيئته % 75(@)(@@) % كن كيف شئت فمالي عنك مصطبر % وارفق بمن أنت ملزوم بذمته % 76(@)(@@) % لا زلت يا ان علي ركن بيت علا % تهوي الوجوه سدا نحو كعبته % PageV01P348 البحر : طويل 1(@)(@@) % طلبت عظيم المجد بالهمة الكبرى % % فأدركت في ضرب الطلا الدولة الغرا % % 2(@)(@@) % وسرت على شوك العوالي إلى العلا % ومن رام إدراك العلا يركب الوعرا % % 3(@)(@@) % لكسب الثنا خضت الحتوف وإنما % % يخوض عباب البحر من يطلب الدرا % % 4(@)(@@) % إذا عرضت دون المنى لك لجة % من الحتف صيرت الحديد لها جسرا % % 5(@)(@@) % وإن غشيت نور البصائر ظلمة % جليت من الرأي السديد بها فجرا % % 6(@)(@@) % درى الملك يا يحيى بأنك قلبه % فضمك حتى منه أسكنك الصدرا % % 7(@)(@@) % جلست على كرسيه فأزنته % فأصبحت كالتوريد في وجنة العذرا % % 8(@)(@@) % خلت منه إحدى راحتيك فخرته % بسعيك بعد الفوت بالراحة الأخرى % % 9(@)(@@) % فخاتمه لم ينتزع من يمينه % سوى كان بالكف اليمين أو اليسرى % % 10(@)(@@) % فما البصرة الفيحاء إلا قلادة % ونحرك من دون النحور بها أحرى % % PageV01P349 11(@)(@@) % وما هي إلا ذات حسن تعجبت % قد اتخذت جيش الأسود لهاخدرا % % 12(@)(@@) % حصان بهالات الحصون تسورت % مخدمة تستخدم البيض والسمرا % % 13(@)(@@) % تمادى زمانا وعدها فتمنعت % وجادت بوصل بعدما مطلت دهرا % % 14(@)(@@) % ولجت قلوب البيض كالسر نحوها % % وخضت بلمات الملمات كالمدرا % % 15(@)(@@) % تزوجتها من بعد ما فاتها الصبا % % فأمست لديك الآن ثيبها بكرا % % 16(@)(@@) % نسجت لها حمر الملابس بالوغى % % وألبستها 
ms117	 في سلمك الحلل الخضرا % % 17(@)(@@) % جعلت رؤوس المعتدين نثارها % % وأنقذت من بيض الحديد لها المهرا % % 18(@)(@@) % دخلت عليها بعدما انكشف الغطا % % فكنتض لعورات الزمان لهل سترا % % 19(@)(@@) % رجعت إليها بالولاية بعد ما % % عرجت عروج الروح في ليلة الإسرا % % 20(@)(@@) % ترحلت عنها كالهلال ولم تزل % تنقل حتى عدت في أفقهابدرا % % PageV01P350 21(@)(@@) % وفارقها محروقة القلب ثاكلا % وأبت فأبدت من مسرتها البشرا % % 22(@)(@@) % فكم مر عام وهي تخفي حنينها % % لقد كان هذا الأمر في نفسها سرا % % 23(@)(@@) % فكم مر عام وهيض تخفي حنينها % % إليك وتحيي ليلها كله سهرا % % 24(@)(@@) % لأمر عدا كانت تصد إذا رأت % لوصلك وقتا لم تجد دونه عذرا % % 25(@)(@@) % بسمر القنا وردت بالطعن خدها % % وبالبيض قد رتلت من ثغرها الثغرا % % 26(@)(@@) % لقد أبصرت بعد العمى فيك عينها % % وأحدث في أجفانها فتحك السحرا % % 27(@)(@@) % وقلدت في عقد المكارم جيدها % % ووشحت منها في صنائعك الخصرا % % 28(@)(@@) % وأضحكتها بعد البكا في صوارم % متى ابتسمت في الروع تستضحك النصرا % % 29(@)(@@) % ورشقتها حتى حكى التبر تربها % % ولولم تكن في أرضها اصبحت قفرا % % 30(@)(@@) % فكنت لها لما استويت بعرشها % % كيوسف إذ ولاه سيده مصرا % % PageV01P351 31(@)(@@) % فلم تجز أهل الكيد يوما بكيدهم % ولم تصطنع غدرا بمن صنع الغدرا % % 32(@)(@@) % وهبت جميع المذنبين نفوسهم % فأوسعتهم عذرا وأثقلتهم شكرا % % 33(@)(@@) % وجودك فيها للعباد مسرة % لأنك بدر وهي بالشرف الزهرا % % 34(@)(@@) % حويت الثنا والبأس والنهى % % وحزت الندى والعفو والحلم والصبرا % % 35(@)(@@) % عمرت بيوت المجد بعد خرابها % % فجددت يا يحي لأمواتها عمرا % % 36(@)(@@) % بخفيك يمشي النعل وهو حديدة % يفوق على تاج النضار على كسرى % % 37(@)(@@) % وفيك ثرى الفيحاء لما حللتها % % تشرف حتى شارف الأنجم الزهرا % % 38(@)(@@) % تهن بها مستمتعا والق وجهها % % ببشر يسري الهم عن مهجة الغرا % % 39(@)(@@) % فلا برحت أيدي الملاحة والصبا % % على وجنتيها تجمع الماء والجمرا % % 40(@)(@@) % وزف الطلا واشرب على ورد خدها % % فشرب الطلا يحلو على الوجنة الحمرا % % PageV01P352 41(@)(@@) % ولا صح معتل النسيم ولا صحت % بعصرك فيها أعين الخرد السكرى % % 42(@)(@@) % ولا زلت غيثا هاميا وهي روضة % % مدى 
ms118	 الدهر تجني من خمائلها الزهرا % % PageV01P353 البحر : - 1(@)(@@) % سلام حكى في حسنه لؤلؤ العقد % وضمخ منه الحبيب بالعنبر الورد % 2(@)(@@) % وأروى تحيات تغنى بروضها % % حمام الثنا شكرا على فنن الود % 3(@)(@@) % وخير دعاء قد أصاب إجابة % بسهم خشوع فوقته يد المجد % 4(@)(@@) % من المخلص المملوك يهدي كرامة % إلى السيد المعروف بالفضل والفوفد % 5(@)(@@) % إلى ابن الكرام الفاخرين ذوي العلا حل % حليف الندى المولى الحسين أخي الرشد % 6(@)(@@) % سحاب إذا استسقى العفاة نواله % يجود بلا وعد ويهمي بلا رعد % 7(@)(@@) % كريم إذا هب السؤال بسمعه % ينبه عن أخلاقه حدق الورد % 8(@)(@@) % بمولده طاب الزمان وأهله % وشب وقرت مقلة العدل والمجد % 9(@)(@@) % يرق إذا رق النسيم لدى الندى % % ويقسو لدى الهيجاء كالحجر الصلد % 10(@)(@@) % تكون من بأس وجود وبأسه % بأعضائه يوري وراحاته تندي % % PageV01P354 11(@)(@@) % إذا جاد يوما من بني المزن خلته % وإن هز سيفا خلته من بني الأسد % 12(@)(@@) % تكمل في وجه السعادة وجهه % فأشرق في إكليله قمر السعد % 13(@)(@@) % ألا فاحملي يا ريح مني أمانة % تحدث عن حفظ العهود له عندي % % 14(@)(@@) % رسالة مشتاق إليه كأنما % % تنفس منها الصبح عن عبق الند % 15(@)(@@) % وعني قبل يا رسول يمينه % وبث إليه ما أجن من الوجد % 16(@)(@@) % وبلغه تسليمي عليه فعله % يجيبك في رد السلام على البعد % 17(@)(@@) % فذلك من منه كالمن طعمه % يلذ به سمعي ويشفى به كبدي % % 18(@)(@@) % وإني لممنون لديك بقصده % ولو كنت مجرى كالدموع على خدي % % 19(@)(@@) % ويا ليتها نعل برجليك شرفا % % بتربة واديه المقدس من جلدي % % 20(@)(@@) % عليه سلام الله ما حن شيق % وأورت صبابات الغرام صبا نجد % PageV01P355 البحر : مجزوء الرجز 1(@)(@@) % ما اشتق بياض مسكها الكافور % مسك الشعر % 2(@)(@@) % إلا كسر الضحى بترك النور % زنج السحر % 3(@)(@@) % خود كحلت جفونها بالغسق % وافتر شنيبها لنا عن فلق % 4(@)(@@) % قد ضم لثامها شعاع الشفق % % 5(@)(@@) % واستودع فجر نحرها البلوري % % شهب الدرر % 6(@)(@@) % وانبث ظلام فرعها الديجوري % % فوق القمر % 7(@)(@@) % ألخمر ملقب بفيها برضاب % والطلع بدا بثغرها وهو حباب % 8(@)(@@) % والدر 
ms119	 بنطقها مسمى بخطاب % % 9(@)(@@) % بكر بزغت ببيتها المعمور % شمس الخفر % 10(@)(@@) % وانقض حول سحفها المزرور % % شهب السمر % PageV01P356 11(@)(@@) % ما الرمح ببالغ مدى قامتها % % والصارم معتز إلى مقلتها % % 12(@)(@@) % والسهم روى النفوذ عن لفتتها % % والدهر مقيد لديه بقيود % 13(@)(@@) % والبحر إلى خضمه المسجور % عين البقر % 14(@)(@@) % أن تصرع في خبا العيون الحور % أسد البشر % 15(@)(@@) % من مبسمها العذب إن بان بريق % يا شامتها احرمي فواديك عقيق % % 16(@)(@@) % من رشف رضابها ومن لثم عتيق % % 17(@)(@@) % والقد قضيبه بدا بالطور % مرخى الحبر % 18(@)(@@) % والخصر نطاقه ثوى بالغور % تحت الأزر % 19(@)(@@) % فاقت بجمالها على الظبي كما % % بالبأس مليكنا على الليث سما % % 20(@)(@@) % بحر بنواله على البحر طما % % PageV01P357 21(@)(@@) % نجل الملك المظفر المنصور % حسن السير % 22(@)(@@) % سيف ضربت به رقاب الجور % سهم الغير % 23(@)(@@) % شهم نظم الثنا له الشهب عقود % والبدر له إلى محياه سجود % 25(@)(@@) % والحتف أمام جيشه المنصور % كالمؤتمر % % 26(@)(@@) % % كالمفتقر % % 27(@)(@@) % سامي رتب تقدست أسماه % هامي نعم تظاهرت آلاه % 28(@)(@@) % الحمد له فلا جواد إلا هو % % 29(@)(@@) % روض حسنت فعاله كالنور % غب المطر % 30(@)(@@) % يحكي بفصول سجعه المنثور % إحدى الكبر % 31(@)(@@) % مولى لكلامه عنى قول لبيد % سحبان لديه إن جرى البحث يليد % PageV01P358 32(@)(@@) % قار لسن مهذب اللفظ مجيد % % 33(@)(@@) % بالرمح يخط بالدم المخصور % فوق الطرر % 34(@)(@@) % % نظم السور % 35(@)(@@) % يا من بيديه مجمع الأرزاق % والمسرف في نواله المهراق % 36(@)(@@) % إقصد فلقد دملت في الأنفاق % % 37(@)(@@) % واكفف فيسير جودك الميسور % فوق الوطر % 38(@)(@@) % واربع فبطي سعيك المشكور % جري القدر % 39(@)(@@) % نوروز أتاك زائرا يا بركه % % بالخير إليك عائد والبركه % 40(@)(@@) % فاشرف بسمائه وزين فلكه % % 41(@)(@@) % واشرب طربا بغفلة المقدور % كأس الظفر % PageV01P359 42(@)(@@) % واسرر أبدا ودم لنفخ الصور % عالي السرر % PageV01P360 البحر : خفيف تام 1(@)(@@) % أيها المصقع المهذب طبعا % وفتى يسحر العقول بيانه % 2(@)(@@) % والفصيح الذي إذا قال شعرا % خلته ينظم النجوم لسانه % 3(@)(@@) % لك من جوهر الكلام نظام % زان ما بين دره مرجانه % 4(@)(@@) % ومعان مثل اليواقيت أضحى الل % فيها مرصعا عقيانه % 5(@)(@@) % عقده 
ms120	 في نحور حور القوافي % % وعلى معصم البلاغة حانه % 6(@)(@@) % هو للشاربين روح وراح % بل وروض زها به ريحانه % 7(@)(@@) % لو رأى ما نبيت عنه ابن عاد % جل في عينيه وهانت جنانه % 8(@)(@@) % أو ليعقوب منه جاؤا بشيء % ذهبت عن فؤاده أحزانه % 9(@)(@@) % يا بديعا فاق الورى وأديبا % رق طبعا وراق فيه زمانه % 10(@)(@@) % أنت أتحفتني بأبلغ مدح % جل قدرا وفي فؤادي مكانه % PageV01P361 11(@)(@@) % در ألفاظه على الدر يزري % % بل وتزري على الشموس حسانه % 12(@)(@@) % منة منه كالأمانة عندي الق % در منها ثقيلة أوزانه % PageV01P362 البحر : كامل تام 1(@)(@@) % هل المحرم فاستهل مكبرا % % وانثر به درر الدموع على الثرى % % 2(@)(@@) % وانظر بغرته الهلال إذا انجلى % % مسترجعا متفجعا متفكرا % 3(@)(@@) % واقطف ثمار الحزن من عرجونه % وانحر بخنجره بمقلتك الكرى % % 4(@)(@@) % وانس العقيق وأنس جيران النقا % % واذكر لنا خبر الصفوف وما جرى % % 5(@)(@@) % واخلع شعار الصبر منك وزرمن % خلع السقام عليك ثوبا أصفرا % % 6(@)(@@) % فثياب ذي الأشجان أليقها به % ما كان من حمر الثياب مزررا % % 7(@)(@@) % شهر بحكم الدهر فيه تحكمت % شرا الكلاب السود في أسد الشرى % % 8(@)(@@) % لله أي مصيبة نزلت به % بكت السماء لها نجيعا أحمرا % % 9(@)(@@) % خطب وهى الإسلام عند وقوعه % % لبست عليه حدادها أم القرى % % 10(@)(@@) % أو ما ترى الحرم الشريف تكاد من % زفراته الجمرات أن تتسعرا % % PageV01P363 11(@)(@@) % وأبا قبيس في حشاه تصاعدت % قبسات وجد حرها يصلي حرا % % 12(@)(@@) % علم الحطيم به فحطمه الاسى % % ودرى الصفا بمصابه فتكدرا % % 13(@)(@@) % واستشعرت منه المشاعر بالبلا % % وعفا محسرها جوى وتحسرا % % 14(@)(@@) % قتل الحسين فيالها من نكبة % أضحى لها الإسلام منهدم الذرا % % 15(@)(@@) % قتل يدلك إنما سر الفدا % % في ذلك الذبح العظيم تأخرا % % 16(@)(@@) % رؤيا خليل الله فيه تعبرت % حقا وتأويل الكتاب تفسرا % % 17(@)(@@) % رزء تدارك منه نفس محمد % كدرا وأبكى قبره والمنبرا % % 18(@)(@@) % أهدى السرور لقلب هند وابنها % % وأساء فاطمة وأشجى حيدرا % % 19(@)(@@) % ويل لقاتله أيدري أنه % عادى النبي وصنوه أم ما درى % % 20(@)(@@) % شلت يداه لقد تقمص خزية % يأتي بها يوم الحساب 