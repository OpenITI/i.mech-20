ms701	 تصطرع % % 12(@)(@@) % يدب في غيرك المديح ول % % كنا رأيناه فيك ينذرع % % 13(@)(@@) % وتهطل الدهر فيك ديمته % لكنها عن سواك تنقشع % % 14(@)(@@) % وأين معط وقلبه بهج % % ممن تمنى وقلبه وجع % % 15(@)(@@) % لا يزل الشر عنك مندفعا % وسيل خير إليك يندفع % % 16(@)(@@) % يا سيدا لم نزل بعفوته % إذا عدمنا الربيع نرتبع % 17(@)(@@) % ولم نزل من ثدي نعمته % % إذا فقدنا الرضاع نرتضع % 18(@)(@@) % ومن علمناه غير متبع % % في المجد بل لا يزال يبتدع % % 19(@)(@@) % ومن عرفناه غير مبتدع % في الدين بل لا يزال يتبع % 20(@)(@@) % أعاذك الله أن نراك وأف % % عالك بعد العلو تتضع % % PageV01P2772 21(@)(@@) % عد لي فليس الجميل فاحشة % تركبها تارة وتتزع % % 22(@)(@@) % ولا طريقا تخاف غيلته % % تركبه تارة وترتدع % % 23(@)(@@) % والعائد العرف بعد بدأته % % ينفع إخوانه وينتفع % % 24(@)(@@) % والبادئ العرف لا معاد له % % يعير إحسانه ويرتجع % 25(@)(@@) % لو كنت ممن يحب ثروته % % أو كنت ممن جداه ممتنع % 26(@)(@@) % إذا عذرناك في المطال به % % لكن عذر الجواد منقطع % 27(@)(@@) % ما دفع مثلي والحال موجبة % % والصدر رحب والوجه متسع % % 28(@)(@@) % لا تمنعني لهى ممنحة % أضحت عليها الأكف تقترع % % 29(@)(@@) % يا من أراه رضا لمنتجع % إن قال أي الرجال أنتجع % 30(@)(@@) % رشنى تجدني رضى لمصطنع % إن قلت أي الرجال أصطنع % PageV01P2773 31(@)(@@) % كم سائل عن نداك قلت له % % مخدع بالسؤال منخدع % 32(@)(@@) % وسائل عن حجاك قلت له % % يحط أمواله ويرتفع % % 33(@)(@@) % وسائل عن ثناك قلت له % % لا يسأم الدهر منه مستمع % % 34(@)(@@) % وكلهم كان في مسائله % % أعمى عن الصبح وهو منصدع % % 35(@)(@@) % يستوضح الصبح بالمصابح وال % % مصباح عند الصباح مختشع % % 36(@)(@@) % لا زلت ما عشت للعدو شجى % في حيث لا يستطيع منتزع % % 37(@)(@@) % تسطو وتعفو وأنت مقتدر % % لا ورع عند ذاك بل ورع % % 38(@)(@@) % ما أقبح المطل من أخي كرم % % وعيب من قل عيبه شنع % % 39(@)(@@) % ولم تعدني بل المنى وعدت % والحر من خلف طيفه جزع % % 40(@)(@@) % متى تعللت أم متى عرف ال % % إقلاع شؤبوب سيبك الهمع % % PageV01P2774 41(@)(@@) % ألست من لم تزل تحمله ال % % علياء 
ms702	 أعباءها فيضطلع % % 42(@)(@@) % ويرتجي خيره اليؤوس إذا % % لم يرج ما عند غيره الطمع % 43(@)(@@) % ويعتفي فضله العزوف إذا % % لم يلتمس فضل غيره الجشع % 44(@)(@@) % ويشمخ المعتفي عليه إذا % % لاقى بخيلا وخده ضرع % 45(@)(@@) % تفترق الصالحات في فرق % وفيك دون الجميع تجتمع % 46(@)(@@) % بلى بلى أنت أنت فلا % % يقطعك دون التمام مقتطع % 47(@)(@@) % يا ذاكر الغنم عند مغرمه % % وذاكر الريع حين يزدرع % % 48(@)(@@) % أولع بي العارفات في يدك الس % % محة إن الزمان بي ولع % 49(@)(@@) % والغوث منه أوان ينتهي الش % شلو ولا غوث حين يبتلع % % 50(@)(@@) % أبا الحسين اهتزز فإنك لا الن % % اكل في موطن ولا الطبع % % PageV01P2775 51(@)(@@) % ولينعطف منك منعطف حسن الط % طاعة لا مانع ولا جزع % % 52(@)(@@) % يا من دعاني إلى الغنى أثر % لطابع الجود فيه منطبع % % 53(@)(@@) % شهدت أني اعتقدت منك أخا % لم يخدع الرأي فيه مختدع % % 54(@)(@@) % متيما بالعلا أخا شعف % يخطب أبكارها ويفترع % % 55(@)(@@) % يمزح بالجود لا السفاه فإن % % جد فزول ذو عقدة مصع % 56(@)(@@) % ما زلت بالإذن لي وبالأذن ال % % مجدي وأي الجميل تتدع % 57(@)(@@) % تمهد لي مطلبي وآونة % تمهد لي مضجعي فأضطجع % % 58(@)(@@) % خذها كصم الصخور أقلعتها % % من جبل شامخ فتنقلع % % 59(@)(@@) % مجدك ذاك الذي أناف على الن % نجم أصيل من طوده فرع % 60(@)(@@) % ومن أبى ما أقول فيك فحي % ياه بموسى قعساه مجتدع % % PageV01P2776 61(@)(@@) % وبعد فاسلم على الزمان ولا % % زالت يد السوء عنك تندفع % % PageV01P2777 البحر : - 1(@)(@@) % لما حق من صد عن مشرب % لبعض القذى فيه أن يمنعه % 2(@)(@@) % بلى حقه أن يصفى له % % ليلتذ عند الصدى مكرعه % 3(@)(@@) % أبى الله قطعك رزق امرىء % أبى الفضل والطول أن يقطعه % % 4(@)(@@) % وعلمك أن السدى كله % % ستنشر ذكراه في مجمعه % 5(@)(@@) % وما ذاك إلا عقاب امرىء % رأى السيف من حيده موضعه % % 6(@)(@@) % منعت الكفاف الذي لم تزل % % تجود به كفك الموسعه % 7(@)(@@) % فإن كنت مسلم ذي حرمة % لقول أعاديه ما أضيعه % 8(@)(@@) % فعجله بالسيف كي تستري % % ح إن كنت من قتله في سعه % % 9(@)(@@) % أتسلمنا للردى 
ms703	 ستة % وقد كنت ترحمنا أربعه % % PageV01P2778 البحر : - 1(@)(@@) % وفقحة كالحوت في ابتلاعها % % يعجز بيت المال عن إشباعها % % 2(@)(@@) % من الغراميل وعن إرضاعها % % ماء الرجال غاية ارتضاعها % % 3(@)(@@) % يعوي عبيد الله من إضباعها % % واسعة الخرق على رقاعها % % 4(@)(@@) % فالأرض كالبقعة من بقاعها % % لو ذرعت شقت على ذراعها % % 5(@)(@@) % فهو سخي النفس عن إقطاعها % % ليت لعينيه من اتساعها % % 6(@)(@@) % ما لاسته من صحنها وقاعها % % مص وفقحة كالحوت في ابتلاعها % % 7(@)(@@) % يعجز بيت المال عن إشباعها % % من الغراميل وعن إرضاعها % % 8(@)(@@) % ماء الرجال غاية ارتضاعها % % يعوي عبيد الله من إضباعها % % 9(@)(@@) % واسعة الخرق على رقاعها % % فالأرض كالبقعة من بقاعها % % 10(@)(@@) % لو ذرعت شقت على ذراعها % % فهو سخي النفس عن إقطاعها % % PageV01P2779 11(@)(@@) % ليت لعينيه من اتساعها % % ما لاسته من صحنها وقاعهانه % % PageV01P2780 البحر : - 1(@)(@@) % سهولة الشريعه % تغني عن الذريعه % % 2(@)(@@) % يا ذا اليد المنيعه % والأذن السميعه % 3(@)(@@) % والهمة الرفيعه % يا قابل الخديعه % 4(@)(@@) % وفاعل البديعه % هل لك في صنيعه % 5(@)(@@) % تجعلها وديعه % % PageV01P2781 البحر : - 1(@)(@@) % ألا قل لذي العطن الواسع % أخي المجد والشرف اليافع % 2(@)(@@) % ليهنك أنك مستقبل % دوام المزيد بلا قاطع % 3(@)(@@) % وأن لست ممنوع أمنية % وأن لست للخير بالمانع % 4(@)(@@) % وأن لست كلا على ناظر % وأن لست وقرا على سامع % 5(@)(@@) % فلا زال جدك مستعليا % له قوة الغالب الصارع % % 6(@)(@@) % ولا زال سعدك مستصحبا % مساعدة القدر الواقع % % 7(@)(@@) % إلى أن تحل ذرى مرغم % أنوف أعاديكم جادع % % 8(@)(@@) % على أنني بعد ذا قائل % ولست لقولي بالدافع % % 9(@)(@@) % ألست المحب ألست المرب % ب من قبل برقكم اللامع % % 10(@)(@@) % ألست المحق ألست المدق % ق في المعييات على الصانع % PageV01P2782 11(@)(@@) % فما لي ظلمت وما لي حرم % % ت منكم وضعت مع الضائع % % 12(@)(@@) % ألم تعلموني علم اليقي % % ن والحق كالفلق الساطع % % 13(@)(@@) % طلعت بأيمن ما طائر % % عليكم وأسعد ما طالع % % 14(@)(@@) % فجاءتكم دولة عضة % تفيأ في ثمر يانع % 15(@)(@@) % ألم أك أدعو بتمكينكم % % سرارا مع الساجد الراكع % % 16(@)(@@) % ألم أك أثني بآلائكم % % جهارا مع المعلن الصادع % % 17(@)(@@) % ألم تعلموا أنني 
ms704	 جئتكم % مجيء المخالص لا الطامع % % 18(@)(@@) % وأني خدمت وأني استقمت % % إذا ضلعت شيمة الضالع % % 19(@)(@@) % وأني نصحت وأني مدح % % ت بالمنطق الرائق الرائع % % 20(@)(@@) % أمن بعد ما سار معروفكم % % إلى ساكن البلد الشاسع % % PageV01P2783 21(@)(@@) % وقام الخطيب بإحسانكم % % على منبر المسجد الجامع % % 22(@)(@@) % يشيع شقائي بحرمانكم % % وشكري مع الشائع الذائع % % 23(@)(@@) % ألا ليت شعري قول امرىء % تراخت مثوبته جازع % % 24(@)(@@) % إذا أنا أخطأني نفعكم % فهل بعدكم لي من نافع % 25(@)(@@) % سيجري على مثل مجراكم % أخو ثقتي جري لا نازع % % 26(@)(@@) % وأي البرية لا يقتدي % % بأفعالكم غير ذي وارع % % 27(@)(@@) % فلله ماذا جنت سادة % على خادم لهم خاضع % 28(@)(@@) % حموه المعاش وأسبابه % % وهم خير مزدرع الزارع % % 29(@)(@@) % أيحسن رفعي بكم صرختي % % أهل هل عن الظلم من رادع % % 30(@)(@@) % وقد طبق الأرض إنصافكم % % فعم المطيع مع الخالع % % PageV01P2784 31(@)(@@) % ألا لا تكن قصتي سبة % فما ذكر مثلي بالخاشع % % 32(@)(@@) % قبيح لدى الناس أن ترتعوا % % وأن لا يروني مع الراتع % % 33(@)(@@) % وأن تشرع الدهم في بحركم % % وأن لا يروني مع الشارع % % 34(@)(@@) % وأن تترأس حثالة % % بكم ويروني مع التابع % % 35(@)(@@) % فلا تضعوا عاليا ربما % % جنى وضعه ندم الواضع % % 36(@)(@@) % يراجع بعض روياته % % وقد وقعت صفقة البائع % % 37(@)(@@) % فتوحشه جورة جارها % % فشاعت مع الخبر الشائع % % 38(@)(@@) % ويأسى على مدح المستمر % ر بالحمد والشكر لا الظالع % % 39(@)(@@) % وحسب أخي الظلم من غفلة % بمكوى ملامته اللاذع % 40(@)(@@) % ألا من لمن طردته الغيو % % ث عن موقع السبل الهامع % PageV01P2785 41(@)(@@) % ألا من لمن وكلته البحا % % ر ظلما إلى الوشل الدامع % 42(@)(@@) % أقاسم يا قاسم العارفا % % ت يا كوكب الفلك الرابع % 43(@)(@@) % أعزمك أنك إن أنت صر % ت في ذروة الفلك السابع % 44(@)(@@) % وجاوزته ساميا ناميا % إلى ثامن وإلى تاسع % 45(@)(@@) % جريت على نهج ذاك الرضا % % بضيق القناعة للقانع % % 46(@)(@@) % أبى الله ذاك وأن العلا % % نمتك إلى الفارع الفارع % % 47(@)(@@) % أعيذك من نائل حائل % ومن بادئ ليس بالراجع % % 48(@)(@@) % أيشبع مولى وعبد له % % يجوع مع الجائع النائع % % 49(@)(@@) % جمالك ياذا السنا 
ms705	 بارع % فصله بإجمالك البارع % % 50(@)(@@) % وزد في ارتفاعك فوق الورى % % بأن تتواضع للرافع % % PageV01P2786 51(@)(@@) % بذلت من القوت لي عصمة % فأوسع علي من الواسع % % 52(@)(@@) % وما لي وإن كنت ذا حرمة % سوى طيب خيمك من شافع % 53(@)(@@) % على أن لي شغلا شاغلا % بعتبك ذي الموقع القارع % 54(@)(@@) % أقول وقد مسني حده % % مقال الذليل لك الباخع % % 55(@)(@@) % ضربت بسيفك يا ابن الكرا % % م غير الشجاع ولا الدارع % % 56(@)(@@) % فصلني بعفوك إني أرا % % ه أكبر من ضرع الضارع % % 57(@)(@@) % وهب حسن رأيك لي محسنا % ليهجع ليلي مع الهاجع % % 58(@)(@@) % فما بعد رأيك من منية % وما بعد عتبك من لائع % % 59(@)(@@) % إذا ما الفجائع بقين لي % % رضاك فما الدهر بالفاجع % % 60(@)(@@) % رضاك ظلال جنانية % وعتبك كاللهب السافع % % PageV01P2787 61(@)(@@) % صدقتك في كل ما قلته % يمينا وما كذب الطائع % % 62(@)(@@) % فإن كان قولي فيما ترا % % ه من خدع الراقىء الراقع % % 63(@)(@@) % فسامح وليك إن الكري % % م قد يتخادع للخادع % % PageV01P2788 البحر : - 1(@)(@@) % إذا أولي النعمى دعا الله أن يرى % % بأصحابها يوم اختبار الصنائع % 2(@)(@@) % فلله ما أغناهم عن جزائه % % إذا كان مقرونا بيوم الفجائع % % PageV01P2789 البحر : - 1(@)(@@) % غن أبا حفص إذا جئته % % بشعره في بإيقاع % 2(@)(@@) % وليكن الإيقاع في رأسه % % من حاذق بالقفد صفاع % PageV01P2790 البحر : - 1(@)(@@) % أغر مخيلات الأماني لموعها % % وأشقى نفوس الشائميها طموعها % % 2(@)(@@) % دعتنا إلى حمد الرجال وذمهم % % هموع سحابات لهم ودموعها % % 3(@)(@@) % وللدهر فينا قسمة عجرفية % % على السخط والمرضاة منا وقوعها % % 4(@)(@@) % فهيماء في ضحل السارب كروعها % % وهيماء في بحر الشراب كروعها % % 5(@)(@@) % وسافلة يزرى عليها سفولها % % ويافعة يزرى عليها يفوعها % % 6(@)(@@) % وفي هذه الدنيا عصائب لم تزل % % لخطة ضيم لا لحق خنوعها % % 7(@)(@@) % فلا في الهنات المحفظات إباؤها % % ولا في الحقوق الواجبات بخوعها % % 8(@)(@@) % فلا يأمنوا وليحذروا غب أمرهم % % فبغي الجدود العاليات صروعها % % 9(@)(@@) % ومن أمن نفس أن تخاف ولم يكن % % لتأمن من مكروهة لا تروعها % % 10(@)(@@) % سينفر من أمن العواقب آمن % بلا من مناه ما جناه خدوعها % % PageV01P2791 11(@)(@@) % وللناس أفعال يجازى مدادها % % وللدهر 
ms706	 أحوال يكايل صوعها % % 12(@)(@@) % لعل ذرى تهوي وعل أسافلا % ستعلو وخفاض المباني رفوعها % % 13(@)(@@) % فكم من جدود ذل منها عزيزها % % وكم من جدود عز منها ضروعها % % 14(@)(@@) % ألا أبلغا عني العلاء بن صاعد % % رسالة ذي نفس قليل هلوعها % % 15(@)(@@) % فإن تحتجز فالله جم عطاؤه % % وإن تحتجب فالشمس جم طلوعها % % 16(@)(@@) % أبت نفسك المعروف حتى تبتلت % % إلى اليأس نفس واطمأن مروعها % % 17(@)(@@) % ولكنكم لا تبطنون محبة % لنخلتكم ماسح أرضا صقوعها % % 18(@)(@@) % فقد عزفت عن كل ما كنت أبتغي % % لديك فأمسى كبرياء خضوعها % % 19(@)(@@) % سأظلف من نفس بذلت سجودها % % وكان حقيقا أن يصان ركوعها % % 20(@)(@@) % هي النفس أغنتها عن الدهر كله % % قناعتها إذ لم يفتها قنوعها % % PageV01P2792 21(@)(@@) % عفاء على الدنيا إذا مستحقها % % بغاها ومن تبغى لديه منوعها % % 22(@)(@@) % جزتكم جوازي الشريا آل مخلد % وأقوت من النعمى عليكم ربوعها % % 23(@)(@@) % ولا انفرجت عنكم من الكره خطة % ولا التأمت إلا عليكم صدوعها % % 24(@)(@@) % ولا صمدت إلا إليكم ملمة % ولا كان فيكم يوم ذاك دفوعها % % 25(@)(@@) % ليهنيكم أن ليس يوجد منكم % لبوس ثياب المجد لكن خلوعها % % 26(@)(@@) % وأن ركايا الماء فيكم جرورها % % إذا كان في القوم الكرام نزوعها % % 27(@)(@@) % نظرنا فأجدى من عطاياكم المنى % % وأندى على الأكباد منهن جوعها % % 28(@)(@@) % وجدناكم أرضا كثيرا بذورها % % رواء سواقيها قليلا ريوعها % % 29(@)(@@) % فلا بوركت عين تسيح لسقيها % % كما لم تبارك في الزروع زروعها % % 30(@)(@@) % جهدناكم مريا فقال ذوو النهى % % لقد أشبهت أظلاف شاة ضروعها % % PageV01P2793 31(@)(@@) % ألا لا سقى الله الحيا شجراتكم % % إذا ما سماء الله صاب هموعها % % 32(@)(@@) % فما بردت للاغبين ظلالها % % ولا عذبت للسائغين نبوعها % % 33(@)(@@) % أبت شجرات أن تطيب ثمارها % % وقد خبثت أعراقها وفروعها % % 34(@)(@@) % نكحتم بلا مهر قوافي لستم % بأكفائها فاللائعات تلوعها % % 35(@)(@@) % رويدكم لا تعجلوا ورويدها % % ستغلو لدى قوم سواكم بضوعها % % 36(@)(@@) % ستمهر أبكاري إذا وخدت بها % % خنوف المهاري بالفلا وضبوعها % % 37(@)(@@) % وإني إذا ما ضقت ذرعا ببلدة % لجواب أقطار البلاد ذروعها % % 38(@)(@@) % وليس القوافي بالقوافي إن اتقى % % هجوعكم عن حقها وهجوعها % % 39(@)(@@) % وليس 
ms707	 بأشباه الأفاعي عرامة % متى لم يطل بالعيث فيكم ولوعها % % 40(@)(@@) % وكانت إذا أبدت خشوعا فخيبت % % أبى عزها أن يستقاد خشوعها % % PageV01P2794 41(@)(@@) % ومن لم تجد في فضل كفيه مرتعا % ففي عرضه لا في سواه روعها % % 42(@)(@@) % ألا تلكم الغيد العطابيل أصبحت % إلى غيركم أرشاقها وتلوعها % % 43(@)(@@) % عذارى قواف كالعذارى خريدها % % يقود الفتى نحو الصبا وشموعها % % 44(@)(@@) % كسوناكم منها ونحن بغرة % مدائح لم تغبط بربح بيوعها % % 45(@)(@@) % وكم نزعت منا إليكم مطامع % فأضحت وعنكم لا إليكم نزوعها % % 46(@)(@@) % لقد ضللت وجناء باتت وأصبحت % % يهز إليكم رحلها وقطوعها % % 47(@)(@@) % قضى ربها أن لا تحل نسوعها % % يد الدهر إذ شدت إليكم نسوعها % % 48(@)(@@) % تسربلتم النعمى فطال عثاركم % % بأذيالها واسود منها نصوعها % % 49(@)(@@) % وما عطرت أثوابها إذ علتكم % ولا حسنت في عين راء دروعها % % 50(@)(@@) % ولم تظلموا أن تعقروا في ملابس % مذيلة أبواعكم لا تبوعها % % PageV01P2795 51(@)(@@) % على أنكم طلتم بحظ علائكم % % فلج بعيدان لئام منوعها % % 52(@)(@@) % بسقتم بسوق النخل ظلما فأبشروا % % ستسموبكم عما قليل جذوعها % % 53(@)(@@) % وقلتم رجحنا بالرجال بحقنا % % وأي رجال لم تزنكم شسوعها % % 54(@)(@@) % وهل أنتم إلا مذيعو مناسب % ترد عليكم ما ادعاه ذيوعها % % 55(@)(@@) % أحلكم ورهاء يرذم أنفها % % فيمخطها من شدة الموق كوعها % % 56(@)(@@) % مفكك أوصال معلل فقحة % عضوض بسفلاه الأيور بلوعها % % 57(@)(@@) % ضعيف اللتيا في الدماغ سخيفها % % قوي اللتيا في الحتار لذوعها % % 58(@)(@@) % يلاحظ دنياه فأحلى متاعها % % طواميرها في عينه وشموعها % % 59(@)(@@) % وما عدمت وجعاء عبدون سلحة % ولا طهرت إلا وفحل يقوعها % % 60(@)(@@) % أنوفكم أعني بما قلت آنفا % بني مخلد حي الأنوف جدوعها % % PageV01P2796 61(@)(@@) % أفدتم ثراء فاستفدتم عروبة % وقد فضح الأنساب منكم شيوعها % % 62(@)(@@) % وإن بيوت البدو لو تصدقوننا % % لأبنية ما ظللتكم نطوعها % % 63(@)(@@) % ولو أنكم كنتم دهاقين سادة % % لما راقكم جوع العريب ونوعها % % 64(@)(@@) % أبت ذكر حزوى منكم واشتياقكم % % إليها قلوب ذكر جوخى يضوعها % % 65(@)(@@) % فديتم بني وهب فإني رأيتهم % % أبوا قذعة يحتج فيها قذوعها % % 66(@)(@@) % وأقنعهم من مدهم ما كفاهم % وأعلى نفوس الراغبين قنوعها % % 67(@)(@@) % وما درك الدهقان في 
ms708	 قيل قائل % ألا ذاك خصاف النعال رقوعها % % 68(@)(@@) % ألا ذاك بناء الحياض ورودها % % ألا ذاك حلاب اللقاح رضوعها % % 69(@)(@@) % وإن كان في عدنان نور نبوة % فروج لظلماء الضلال صدوعها % % 70(@)(@@) % ومن حكمها لعن الدعي وثلبه % % إذا واصل الأرحام عد قطوعها % % PageV01P2797 71(@)(@@) % أرى سقم الدنيا بصحة حظكم % % شفى داءها ضرارها ونفوعها % % 72(@)(@@) % وهذا أبو العباس حيا مؤملا % ضروب الرؤوس الطامحات قموعها % % 73(@)(@@) % فتى من بني العباس كهل جلاله % % ركوب لأشراف النجاد طلوعها % % 74(@)(@@) % فروق لألباس الأمور فصولها % % ضموم لأشتات الأمور جموعها % % 75(@)(@@) % ولله والأيام فيه وديعة % تداوى بها البلوى وشيك نجوعها % % 76(@)(@@) % وما برحت في كل حال تسوسها % % له شيم زهر المحاسن روعها % % 77(@)(@@) % فصبرا لأيام له سترونها % % يطول عليكم أيها القوم سوعها % % 78(@)(@@) % وقد شمتم منه ومن أوليائه % % بوارق لم يخلف هناك لموعها % % 79(@)(@@) % ألا تلك آساد الشرى وبروزها % % فدتها خنازير القرى وقبوعها % % 80(@)(@@) % بدوا وحجرتم ظالمين بني استها % % فبتم وفي الأستاه منكم كسوعها % % PageV01P2798 81(@)(@@) % وما يستوي في الطير صقر وهامة % لعمري ولا شحاجها وسجوعها % % 82(@)(@@) % جمحتم إلى القصوى من الشر كله % % وللدهر فيكم روعة سيروعها % % 83(@)(@@) % وأبطركم أكل الحرام فأمهلوا % % لكل أكول هوعة سيهوعها % % 84(@)(@@) % كأن قد دسعتم بالخبيث ولم تزل % % لكم دسعات لا يسقى دسوعها % % 85(@)(@@) % ستكسع منكم دولة حان بينها % % بدولة صدق قد أظل رجوعها % % 86(@)(@@) % نقوم بها من آل وهب عصابة % تحنت على نصح الملوك ضلوعها % % 87(@)(@@) % لهم دولة منصورة بفعالهم % % أبى النصر أن تنفض عنها جموعها % % 88(@)(@@) % تقدمهم في كل فضل سيوفها % % ومعروفهم في كل أزل دروعها % % 89(@)(@@) % هنالك يشفى من صدور غليلها % % إذا ما الدواهي طال فيكم شروعها % % 90(@)(@@) % أرتني سعودي ذلك اليوم أنه % % برود نفوس حلئت ونقوعها % % PageV01P2799 91(@)(@@) % ولا رقأت إبان ذاك دماؤهم % % ولا أعين فاضت عليكم دموعها % % 92(@)(@@) % منحتكموها شكم نفس أبية % قليل عن الطاغي الأبي كيوعها % % 93(@)(@@) % فدونكم شوهاء فوهاء صاغها % % مشوه أقوال وطورا صنوعها % % 94(@)(@@) % وما كنت قوال الخنا غير أنني % % قؤول التي تشجي اللئيم سموعها % % 95(@)(@@) % رؤوم صفاة أنبتت 
ms709	 وتفجرت % % رجوم صفاة أصلدت وقروعها % % 96(@)(@@) % وإني لمناح الأنوف تحيتي % % فإن جهلت حقي فعندي نشوعها % % 97(@)(@@) % فإن شمخت من بعد ذاك فإنني % % قذوع لآناف قليل قذوعها % % 98(@)(@@) % بحد جرت جري الرياح فأصبحت % % سطوع حياء النيرين سطوعها % % 99(@)(@@) % فمن صد من نفاحها وبرودها % % فعندي له لفاحها وسفوعها % % 100(@)(@@) % وإني لطلاب التي أنا أهلها % % وغيري إذا ولت قفاها تبوعها % % PageV01P2800 101(@)(@@) % وما أنا في حال العطايا فروحها % % وما أنا في حال البلايا جزوعها % % 102(@)(@@) % لقد سرت الدنيا وضرت جناتها % % فمجاجها للقوم أريا لسوعها % % 103(@)(@@) % فلا تأس للدنيا ولا تغتبط بها % % فوهابها سلابها وفجوعها % % PageV01P2801 البحر : - 1(@)(@@) % أيرضى الأمير أطال الإله % % بقاء الأمير عزيزا مطاعا % % 2(@)(@@) % بأن فل حرمانه مقولي % % فأحذاه بعد المضاء انقطاعا % % 3(@)(@@) % وكانت قوافي في مدحه % % مئين فقد صرن فيه رباعا % % 4(@)(@@) % وما كان إلا حساما أضيع % % ومهما أضيع من الأمر ضاعا % % 5(@)(@@) % فلو شاء صيقله رده % % جديدا وولاه كفا صناعا % % 6(@)(@@) % تعيد شباه إلى حاله % % وتلقى على صفحتيه شعاعا % % 7(@)(@@) % ليوم تقنع فيه الرجال % % وتحسر فيه النساء القناعا % % PageV01P2802 البحر : - 1(@)(@@) % راع فؤادي منك ما راعه % ولاعه صدك ما لاعه % 2(@)(@@) % أمرضت قلبي ثم ماعدته % % كلا ولا داويت أوجاعه % 3(@)(@@) % يا مالكا قلبي وتعذيبه % مهلا فما ملكت إقلاعه % 4(@)(@@) % ته عند تمليكك تخليصه % % أو عند إحسانك إمتاعه % % 5(@)(@@) % حق لك الكبر على عاشق % نارك في جنبيه لذاعه % 6(@)(@@) % لو كنت قد ملكت إنقاذه % % منك كما ملكت إيقاعه % 7(@)(@@) % يا ناقص القدرة كم غية % ليست لها نفس بتياعه % 8(@)(@@) % لا تحسبني للهوى طعمة % إن استجاش الرأي أشياعه % % 9(@)(@@) % أنا الذي إن شئت هان الهوى % % خوف أو أطمع إطماعه % 10(@)(@@) % يا عجبا من شنطف إنها % % أضحت تغني غير مرتاعه % % PageV01P2803 11(@)(@@) % ما أصفق الوجه الذي أعطيت % ساق إليه الخزي أنواعه % % 12(@)(@@) % ألق إليها أذنا واستمع % % أبرد ما غنته كراعه % % 13(@)(@@) % وأمر لها ثم برومية % للرقص والإيقاع جماعه % 14(@)(@@) % رقاصة في البطن كبادة % موقعة في الرأس صفاعه % 15(@)(@@) % تعسا لها تعسا إذا ما عوت % ونزعة للنفس 
ms710	 نزاعه % 16(@)(@@) % تفسو فما تنفك عن فسوها % % دواخن في البيت منباعه % 17(@)(@@) % دحداحة الخلقة حدباؤها % % قامتها قامة فقاعه % % 18(@)(@@) % قصيرة القامة مقصوعة % للقمل فوق الطبل قصاعه % % 19(@)(@@) % تطفرها من قصر فأرة % وبظرها يتعب ذراعه % % 20(@)(@@) % مشؤومة للخير حصادة % لكنها للشر زراعه % % PageV01P2804 21(@)(@@) % تضل في السربال من قلة % % كصعوة في جوف قفاعه % % 22(@)(@@) % وعواعة البطن فإن رجعت % % يوما غناء فهي وعواعه % % 23(@)(@@) % لو أنها ملكي ولي ضيعة % نصبتها للطير فزاعه % % 24(@)(@@) % أقبح بذاك الخلق من منظر % وزع فيه القبح أوزاعه % 25(@)(@@) % بالحمق والغلمة مصروعة % بالإبط والنكهة صراعه % 26(@)(@@) % لا تعرف الله ولكنها % % سجادة للأير ركاعه % 27(@)(@@) % منيتها أير عريض القفا % % مضلع تغمز أضلاعه % 28(@)(@@) % حتى إذا قام على سوقه % % سدت به ثقبة بلاعه % % 29(@)(@@) % لها حر أشمط متكرش % شاب وما تترك إرضاعه % % 30(@)(@@) % تجهد أن تشبعه دهرها % % لو أنها تستطيع إشباعه % % PageV01P2805 31(@)(@@) % منقلب الشفرين مستضحك % ما هو إلا جيب دراعه % % 32(@)(@@) % نوسعها ذما على أنها % % بذالة ليست بمناعه % % 33(@)(@@) % تقتل بالبذل فاعجب بها % % ضرارة في زي نفاعه % % 34(@)(@@) % كم عصت الله وما أحسنت % فقحتها شيئا سوى الطاعه % % 35(@)(@@) % خفاضة للرأس لكنها % % لرجلها والردف رفاعه % % 36(@)(@@) % قد لمعت من برص واضح % مؤزر في الوجه لماعه % % 37(@)(@@) % لو عرضت شيراز صوارها % % وعينها لانتابها الباعه % % 38(@)(@@) % صفعانة تأخذ من رأسها % % لطيزها في الفسق رتاعه % % 39(@)(@@) % مبتاعة دفعا بصفع ألا % % قبحها الرحمن مبتاعه % 40(@)(@@) % ترقع من فروتها صدعها % % وحيلة الإنسان رقاعه % PageV01P2806 41(@)(@@) % قلت لداعي الشعر في شتمها % % مهلا فقد أبلغت إسماعه % 42(@)(@@) % ستسمع الآذان في شنطف % قوافيا للجهل رداعه % 43(@)(@@) % ليست عن الثأر بنوامة % ولا عن الوتر بهجاعه % % 44(@)(@@) % إن صكت الوجه فسفاعة % أو صكت الرأس فقماعه % % 45(@)(@@) % يا من تغنينا بما ساءنا % % دونكها للأنف جداعه % % 46(@)(@@) % أسمعتنا سوءا فأسمعته % % فاستمعي إن كنت سماعه % % PageV01P2807 البحر : - 1(@)(@@) % أبا علي للناس ألسنة % إن قلت قالوا بها ولم يدعوا % % 2(@)(@@) % والبغي عون على المدل به % % فأشنأه واجعله بعض ما تدع % 3(@)(@@) % أولا فكن راميا وكن غرضا % ترمي وترمى 
ms711	 وتحصل الشنع % % 4(@)(@@) % وقالة السوء غير راجعة % يوما إذا نوهت بها السمع % % 5(@)(@@) % يا ليت شعري وليت شعرك إن % % قلت وقلنا واستحكم القذع % % 6(@)(@@) % ما ينفع الصارم اللسان إذا % % غودر يوما وعرضه قطع % 7(@)(@@) % لا نفع في ذاك إن نظرت وإن % % قوم منك الحياء والورع % 8(@)(@@) % فارجع وبقيا أخيك باقية % واندم وفي الحلم فسحة تسع % % 9(@)(@@) % أو لا فأيقن بأنني رجل % تكثر فيما يقوله البدع % % 10(@)(@@) % والشهد عندي لمن أناب بما % % ء المزن أو لا فالصاب والسلع % PageV01P2808 11(@)(@@) % وقد هجوت امرءا يجل عن ال % % مدح وعندي الحفاظ لا الجزع % % 12(@)(@@) % ومن هجا ماجدا أخا شرف % فليس إلا من نفسه يضع % 13(@)(@@) % والنبل مبرية منصلة % يحفزهن القسي والشرع % 14(@)(@@) % وكل سهم رمت يداي به % % فليس إلا في مقتل يقع % % 15(@)(@@) % فلا تعد بعدها لذكر أبي % % بكر ولا تخدعنك الخدع % % 16(@)(@@) % فوالذي تسجد الجباه له % % ما بعدها في هوادتي طمع % % 17(@)(@@) % ذلك عرض أبيت لا بل أبى ال % % له له أن يمسه طبع % 18(@)(@@) % ودونه نصرة مؤيدة % مني ولي بالحفاظ مضطلع % 19(@)(@@) % والظلم مخذولة كتائبه % تضرب أدبارها وتكتسع % 20(@)(@@) % والحق منصورة حلائبه % % تكثر أعوانه ويتبع % PageV01P2809 21(@)(@@) % أنذرت حرب الهجاء ملقحها % % فما لها غير حتفه ربع % % 22(@)(@@) % وليس فيها الرؤوس تندر بل % % فيها أنوف الرجال تجتدع % % 23(@)(@@) % ذاك مقام كما سمعت به % % محاسن القوم فيه تنتزع % % 24(@)(@@) % وليس فيه شيء تراه سوى ال % % أعراض دون النفوس تدرع % % 25(@)(@@) % والعيش بعد الممات مرتجع % وليس عرض يودي فيرتجع % % 26(@)(@@) % ونحن في منظر ومستمع % ما مثله منظر ومستمع % % 27(@)(@@) % فليتزع بالعظات متزع % ما دام يجدي عليه متزع % % 28(@)(@@) % إياك أن يستنير مني أق % % دامك صلا في رأسه قرع % % 29(@)(@@) % قد جف واديه من تنفسه % % فما به في الربيع مرتبع % 30(@)(@@) % لا ماء فيه ولا نبات وهل % % خصب بوادي البوار أو مرع % PageV01P2810 31(@)(@@) % إياك إياك أن تطيف به % % وإن تداعت لنصرك الشيع % 32(@)(@@) % فرب إقدام ذي مخاطرة % أحزم منه النكوص والهلع % 33(@)(@@) % لا تنتجع صيفة لها وهج 
ms712	 % حام فما في المصيف منتجع % 34(@)(@@) % ولا تزعزع حلمي وتأمل أن % % ترسو إن الجبال تقتلع % % 35(@)(@@) % فليس حلمي حلما يبلغني الذ % ذل وإن كان فيه متسع % 36(@)(@@) % وليس جهلي جهلا يبلغني الظ % % ظلم وإن كان فيه ممتنع % 37(@)(@@) % أنا الذي ليس في مغامزه % % لين ولا في قناته خضع % 38(@)(@@) % أنا الذي لا يذل صاحبه % % ولا يرى في وليه ضرع % 39(@)(@@) % أنا الذي تحشد الرواة له % % فكل أيام دهره جمع % 40(@)(@@) % أنا الذي ليس في حكومته % % جور ولا في طريقه ضلع % PageV01P2811 41(@)(@@) % وأنت بكر على الهجاء فصن % عرضك إن الأبكار تفترع % % 42(@)(@@) % قارعت قبلي معاشرا قرعا % فازت فخف أن تخونك القرع % 43(@)(@@) % وذقت من غير موردي جرعا % ساغت فخف أن تغصك الجرع % % 44(@)(@@) % متى تعاطيت جرع واحدة % من موردي فالشجا له تبع % 45(@)(@@) % فلا تجرب على الحياة فما % % كل التجاريب فيه منتفع % % 46(@)(@@) % وما تعديت بل ردعتك بال % % وعظ وللصالحين مرتدع % % 47(@)(@@) % وأنت ممن يهاب معصية ال % % حق ولا يستخفه الفزع % % 48(@)(@@) % وفي القوافي لقائل سعة % إن شئت والدهر بيننا جذع % % 49(@)(@@) % وقد عرفت القريض أصلحك ال % % له وفيه الأغلال والخلع % 50(@)(@@) % فاجتنب الشر فهو مجتنب % واتبع الخير فهو متبع % PageV01P2812 البحر : - 1(@)(@@) % أصل نما بك ربه فرعه % من بعدما التمس العدى قلعه % 2(@)(@@) % يا من تجلت للوجود به % % بعد السواد تشوبه سفعه % 3(@)(@@) % ما ينقم الحساد منك سوى % % أمن شننت عليهم درعه % 4(@)(@@) % بل عز مثلك لا كفاء له % % بنيت بعد حفوفه ربعه % % 5(@)(@@) % ملك شروه من عدوهم % سفها فكنت أحق بالشفعه % % 6(@)(@@) % ورياسة كانت مطلقة % منهم فكنت أحق بالرجعه % % 7(@)(@@) % يا آخرا أضحى لأوله % % كالسجدة اتصلت بها الركعه % % 8(@)(@@) % قد قلت حين ملكت أمرهم % % شمل أراد مليكهم جمعه % % 9(@)(@@) % يا من إذا دعي المديح له % % لبى الدعاة وجاء في سرعه % % 10(@)(@@) % هنئت ما أوتيت مغتبطا % بمزيد رب شاكرا صنعه % % PageV01P2813 11(@)(@@) % وفيت حق الشرطتين وما % % وفيت حقك لا ولا ربعه % % 12(@)(@@) % لكنها باكورة بكرت % مما نؤمل فانتظر ينعه % 13(@)(@@) % واسلم على 
ms713	 ريب الحوادث ما % % سجع الحمام مرجعا سجعه % 14(@)(@@) % الآن نام الخائفون وما % % كانت تذوق عيونهم هجعه % 15(@)(@@) % لم تمس عين الله راعية % % أحدا يبيت وأنت لم ترعه % 16(@)(@@) % أضحى عبيد الله سيدنا % % في المجد وترا لا يرى شفعه % 17(@)(@@) % يغري خطوب الدهر منصلتا % كالسيف أحمد ضارب وقعه % % 18(@)(@@) % يقع الربيع وجود سيدنا % % فإليه تصرف دونه النجعه % % 19(@)(@@) % جود يزيد الله صاحبه % % وثوابه المذخور لا السمعه % % 20(@)(@@) % وله إذا ما الرأي حيره % % خطب يشنع ورده قرعه % % PageV01P2814 21(@)(@@) % رأي كأن الدهر أطلعه % % من سر كل خفية طلعه % % 22(@)(@@) % فتاق ما يعيا الدهاة به % % رتاق مالم يرتقوا صدعه % % 23(@)(@@) % كم غبطة لمعاشر صدرت % عنه وكم لمعاشر فجعه % % 24(@)(@@) % فالناس طرا بين مرتقب % سطواته ومؤمل نفعه % % 25(@)(@@) % كالعارض التهبت صواعقه % % وسقى البلاد فلم يدع بقعه % 26(@)(@@) % أحذاه عبدالله شيمته % % والأصل يسقي ماؤه فرعه % 27(@)(@@) % يندى ويصلب عوده فترى % % لدن المهزة صادق المنعه % 28(@)(@@) % كالخيزران لعاطفيه وإن % % عجمته نائبة فكالنبعه % 29(@)(@@) % ملك يباشر ناره صرد % فتظل مدفئة بلا لذعه % % 30(@)(@@) % فإذا اصطليت حريقه بطرا % فهناك لست بآمن سفعه % % PageV01P2815 31(@)(@@) % متسربل حلما بطانته % % عز وليس بكائن فقعه % % 32(@)(@@) % يحيي ويردي وهو مقتدر % حلو المجاجة قاتل السبعه % % 33(@)(@@) % فعال منقذة ومهلكة % قوال مثلهما بلا قذعه % % 34(@)(@@) % لا يرأم العوراء منطقه % % كلا وليس يعيرها سمعه % % 35(@)(@@) % يسع الجسيم من الفعال وما % % يرضى نداه لقدره وسعه % 36(@)(@@) % وأتى الأمير لقد جرى فسعى % % مسعاه غير مطالع طلعه % 37(@)(@@) % وجرى أبو العباس يتبعه % % سعيا فقال ألا كذا فاسعه % % 38(@)(@@) % ولد أقر لعين والده % طالت لوالده به المتعه % 39(@)(@@) % وزعت يداه ما يحاذره % % من دهرنا فأجادتا وزعه % 40(@)(@@) % لم يرع سرح الملك رعيته % % راع ولا قمع العدى قمعه % PageV01P2816 41(@)(@@) % عجبا لطائفة تقيس به % % من لا يوازنه ولا شسعه % % 42(@)(@@) % أنى تقاس شعيلة خمدت % بالشمس في الإشراق والرفعه % % 43(@)(@@) % قوم بغوا بيقينهم بدلا % ممن أبت سقطاته رفعه % % 44(@)(@@) % مستبطني ضغن له وبه % % رفعوا جنوبهم من الصرعه % % 45(@)(@@) % وعليهم للعز أبهة % من بعد ما 
ms714	 رهقتهم الخشعه % % 46(@)(@@) % مالوا بودهم إلى رجل % جعل البوار لأهله شرعه % % 47(@)(@@) % طالت به عثراته فكبا % % وكبوا وكل راكب ردعه % % 48(@)(@@) % يهوون في أهوية قذف % من يمن صاحبه بها ينعه % % 49(@)(@@) % حتى تداركهم فأنقذهم % % صلت الجبين مبارك الطلعه % % 50(@)(@@) % لو قارع الأكفاء كلهم % عن سؤدد وقعت له القرعه % % PageV01P2817 51(@)(@@) % فجزوه أن حفروا له حفرا % جذب المهيمن دونها ضبعه % 52(@)(@@) % وأبيهم ما كان ريعهم % لأخيهم بمشاكل زرعه % 53(@)(@@) % إن المريد بمثله بدلا % لكن يريد بدرة ودعه % 54(@)(@@) % يا زينهم إذ كان أشأمهم % % شينا وليس الأنف كالسلعه % % 55(@)(@@) % شهدوا غداة رقعت وهيهم % أن قد أجدت ولم تسىء رقعه % % 56(@)(@@) % يا بيهقي دع القريض لذي % % حذق يعاون علمه طبعه % 57(@)(@@) % فادفن سلاحا ظلت تسلحه % % من فيك لا استك دفعة دفعه % 58(@)(@@) % أخطأت في المصراع مفتتحا % وأتيت إذ عجزته بدعه % % 59(@)(@@) % سكنت ميما غير ساكنة % وجعلت ربك أنجما سبعه % % 60(@)(@@) % حكمتها في من لو انتظمت % تاجا لقل لمثله خلعه % % PageV01P2818 61(@)(@@) % وزعمت سيدنا الأمير سما % % بالجود حتى صافح الهقعه % % 62(@)(@@) % وهو الذي أدنى مواطئه % % فوق الذي سميت والهنعه % % 63(@)(@@) % وجعلت أقصى ما تجود به % % للمستميح نواله الجرعه % % 64(@)(@@) % ثلط على ثلط وضعت به % % ووضعت بعد هدائل القصعه % 65(@)(@@) % من كان مثلك في جماعته % % أضحى وقيمة رأسه قرعه % 66(@)(@@) % وشكوت جوعك في ذرى ملك % فنقضت مدحك فيه بالشنعه % 67(@)(@@) % أقبلت تشكو في ضيافته % % طول الطوى متمنيا نجعه % % 68(@)(@@) % كذبا عليه بعد زعمكه % % نصب الجفان بربوة تلعه % % 69(@)(@@) % أقبح بإفك في مناقضة % كالنبذة الشمطاء في الصلعه % % 70(@)(@@) % وحكيت أنك مذ أطفت به % % في عيشة تقتاتها لمعه % PageV01P2819 71(@)(@@) % وزعمت صرتك اغتدت عطلا % لا درهم فيها ولا قطعه % % 72(@)(@@) % وهو الذي يضحي مجاوره % % من جنة الفردوس في ترعه % % 73(@)(@@) % وجعلت ذكر الصفع خاتمة % مسترزقا من صافع صفعه % % 74(@)(@@) % فثواب مثلك صفع أخدعه % % بل بصقة في الوجه بل نخعه % % 75(@)(@@) % ما زلت في معنى يحاك وفي % % لفظ يساء كقولك الضبعه % % 76(@)(@@) % وذكرت رهطا تسعة جدعوا % % أنف الفتيل فأوعبوا جدعه % % 77 
ms715	(@)(@@) % فجعلت صاحبهم طويسا وما % % لاقى طويس أولئك التسعه % 78(@)(@@) % أفلا قدار جعلت تاسعهم % % كسع است قاطع زبرها كسعه % 79(@)(@@) % وذكرت بالحولاء بحربة % % ونعتها فجعلتها ربعه % 80(@)(@@) % وجعلت تحفتها مغازلة % لك أن تقول مجيبة نزعه % % PageV01P2820 81(@)(@@) % ووصفت كأسا لا يشاكلها % % فجعلتها صهباء كالدمعه % % 82(@)(@@) % لا دمعة صهباء نعلمها % % إلا دم استك خاضبا فصعه % % 83(@)(@@) % ووصفت ضوء الصبح محتفلا % فجعلته كإضاءة الشمعه % % PageV01P2821 البحر : - 1(@)(@@) % يا أبا الصقر زادك الله في ال % % مجد علوا وفي المكارم باعا % % 2(@)(@@) % مع أن قد علوت في المجد حتى % % لم تدع فيه مبلغا مستطاعا % % 3(@)(@@) % أنت شمس أضاءت الشرق والغر % % ب وأضحى لها إلينا شعاعا % % 4(@)(@@) % بك عادت آمالنا وهي آما % % ل وقد كن مرة أطماعا % % 5(@)(@@) % شهد الله والخليفة والنا % % س جميعا شهادة إجماعا % % 6(@)(@@) % أنك الكاتب الذي يأمن السلطا % % ن منه إضاعة واقنطاعا % % 7(@)(@@) % والجواد الذي إذا نال حظا % لم يكن عند نيله مناعا % % 8(@)(@@) % تجمع الفيء للخليفة جمعا % لا يشذ الفتيل منه ضياعا % % 9(@)(@@) % وإذا ما أخذت سهمك منه % % لم تكن عند أخذه جماعا % % 10(@)(@@) % أبت الجمع منك روحاء من % % كفيك تزداد ما حييت اتساعا % % PageV01P2822 11(@)(@@) % هي خرقاء حين تعطي وكانت % % حين تستخرج الخراج الصناعا % % 12(@)(@@) % عجبا من يديك والفيء أنى % % يجمعان الشتيت منه الشعاعا % % 13(@)(@@) % وهما آفتان للمال حتم % منهما أن يكون نهبا مشاعا % % 14(@)(@@) % ضلة للمهنيك بأن ول % يت ما تستحقه إقطاعا % % 15(@)(@@) % أنت أعلى من أن يقول لك القا % % ئل يهنيك أو وليت الضياعا % % 16(@)(@@) % ولأولى بأن يهنئك النا % % س ضياع حفظتها الرعاء من أن تضاعا % % 17(@)(@@) % ورعايا حميتها بعد أن % % شارك في حفظها الرعاء السباعا % % 18(@)(@@) % فهنيئا لمن رعيت هنيئا % آمن لله سربهم أن يضاعا % % 19(@)(@@) % وهنيئا لك الثواب إذا هن % % نىء وال بأن أصاب متاعا % % 20(@)(@@) % والثناء الجميل فيك إذ صي % ير للسامعين طرا سماعا % % PageV01P2823 21(@)(@@) % ما يداني إيناق منظرك الأب % % صار إيناق ذكرك الأسماعا % % 22(@)(@@) % جعل الله جدك الظاهر الأع % % لى إذا جدت الجدود اصطراعا % % PageV01P2824 البحر : - 1(@)(@@) % سأرحل 
ms716	 يا أسماء عن دار معشر % جوادهم بالعرف معط كمانع % 2(@)(@@) % يجود به جود المقضي بنفسه % % حذار القوافي كارها غير طائع % 3(@)(@@) % إلى ملك لا يملك البخل ماله % % ولا يدري معروفه بالذرائع % % 4(@)(@@) % جواد به من أريحية جوده % تباريح يعجلن اختيار الصنائع % % 5(@)(@@) % من القوم لا يستحمدون ببذلهم % % ولكنهم يعطون جود طبائع % % 6(@)(@@) % ولو تاجروا لم يعبثوا بتجارة % ولا انخدعت تلك الحلوم لخادع % % 7(@)(@@) % أرى مجدهم مثل الجبال فإنها % % بنى الله إذ مجد الورى كالصنائع % % PageV01P2825 البحر : - 1(@)(@@) % لج الفؤاد فليس يلذعه % % عذل ولا النكبات تردعه % 2(@)(@@) % أوهى معاقد صبره كلف % لم يوهه يوما تمتعه % 3(@)(@@) % بمسنع ظلت محاسنه % % تخفي بها بدرا وتطلعه % 4(@)(@@) % فإذا دنا أنأى أخا كلف % وإذا نأى أدناه مضجعه % 5(@)(@@) % لم تعرني وهنا حبالته % % إلا عرا قلبي تفجعه % % 6(@)(@@) % كلا ولم ألمم بمضجعه % % إلا طغى جفني ومدمعه % % 7(@)(@@) % ظغيان مرتجس الذرى خضل % لحنينه زجل يرجعه % % 8(@)(@@) % حيران منبجس الكلى عصفت % % بعد الهدوء عليه زعزعه % % 9(@)(@@) % وكأنما نتجت رواعده % % وبوارق باتت تشيعه % 10(@)(@@) % يما تلاطم في غزارته % % آذيه وطمى تولعه % % PageV01P2826 11(@)(@@) % سقيا لأطلال عفت فعفا % % من بعدهن العيش أجمعه % % 12(@)(@@) % عهدي بريق لهوها خضلا % أرق الرياض يرف ممرعه % % 13(@)(@@) % أيام صيد جنانها بقر % حم تضمنهن أجرعه % 14(@)(@@) % يغدو الأريب لها ليصرعها % % وعيونها للحظ تصرعه % % 15(@)(@@) % من كل آنسة الحديث لها % % وجه كأن الشمس مطلعه % 16(@)(@@) % ولها دجى ليل تجللها % % فتظل تدريه وترفعه % 17(@)(@@) % ومنضد رفت مراشفه % % علا المدام به مشعشعه % 18(@)(@@) % ودعن من كادت حشاشته % % لوداعهن ضحى تودعه % 19(@)(@@) % فتصدعوا ومضوا لطيتهم % % فعرى الفؤاد لهم تصدعه % % 20(@)(@@) % تالله تفتأ باكيا لهم % حتى يخد الخد أدمعه % % PageV01P2827 21(@)(@@) % ولما دموع العين راجعة % ماعشت وصلا فات مرجعه % % 22(@)(@@) % أفلا تسلاهم بمنجرد % كالسيل آنف منه أصمعه % % 23(@)(@@) % وسمت نواظره فجلت به % % جنا تفرعه وتقرعه % % 24(@)(@@) % وكأن أذنيه شبا قلم % % وحي يخططه مرفعه % % 25(@)(@@) % رحبت خواصره وجبهته % % والمنخران وتم أتلعه % % 26(@)(@@) % فأناف متناه على ثبج % % طلعت على الترهيف أضلعه % % 27(@)(@@) % واشتد علباءاه وانقوسا % % دون 
ms717	 العذار فضاق برقعه % % 28(@)(@@) % وتحنبت ساقاه وانشنجت % % أنساؤه فقمصن أكرعه % 29(@)(@@) % فكأنما ائتلقت بأجنحة % يسبقن لمح الطرف أربعه % % 30(@)(@@) % تضحي الرياح إذا تمطر في % % شأويه حسرى ليس تتبعه % % PageV01P2828 31(@)(@@) % شرس السجية إن شرست له % % ويلين إن لا ينت أخدعه % 32(@)(@@) % طرف كأن على معاقده % % شرقا من الجادي يردعه % % 33(@)(@@) % أمطاكه جزل مواهبه % % كلف برب العرف يصنعه % % 34(@)(@@) % يهب الجزيل ولا يكدره % % بأذى ولا بالمن يتبعه % % 35(@)(@@) % لا بل يؤيده ويشفعه % % بندى يحل لديك موقعه % 36(@)(@@) % ويراه محتقرا لديه وإن % % أضحى لسان الشكر يرفعه % 37(@)(@@) % كم من يد سبقت إلي له % % حسناء جاد لها تبرعه % 38(@)(@@) % فشكرته فأثابني نعما % أوهى لها شكري يضعضعه % % 39(@)(@@) % ملك إذا افتخر الملوك سما % % كرم النجار به ومنزعه % 40(@)(@@) % فعلا وقصر دون مبلغه % % من مجد من ناواه أرفعه % PageV01P2829 41(@)(@@) % وله من العز التليد إذا % % عدت بنو شيبان أمنعه % 42(@)(@@) % سيما العزيز تجبر ويرى % % في العز سيماه تخشعه % 43(@)(@@) % وإذا بنو الموت استطالهم % وهج تغشى الموت أينعه % 44(@)(@@) % ودعوا نزال فطاح بالورع ال % % هيابة المنخوب مهلعه % % 45(@)(@@) % غادى كتائبهم بعدوته % % أجل يطحطح من يروعه % % 46(@)(@@) % متقلدا في الروع ذا شطب % كالرجع أبدع فيه مبدعه % % 47(@)(@@) % مما تقلد في كتائبه % % يوم الوغى واختار تبعه % 48(@)(@@) % عضبا كأن شعاعه لهب % يغنى به في الليل رافعه % % 49(@)(@@) % وكأنما كسيت عقيقته % % وشيا تأنق فيه صانعه % % 50(@)(@@) % أو دب فيه الذر فاختلفت % تفراه أكرعه وأذرعه % % PageV01P2830 51(@)(@@) % بأبي وأمي أنت ترب ندى % في بيت مكرمة تريعه % % 52(@)(@@) % إن الوزارة لم تزل بها % % شوق إليك يرى تنزعه % 53(@)(@@) % خطبتك إذا وافقت خطبتها % % وسواك أقصاه تسرعه % 54(@)(@@) % الله وفق مبتغيك لها % % وحباك أمرا كنت تدفعه % 55(@)(@@) % نظرا من الله العزيز لمن % أمسى نظام الملك يجمعه % % 56(@)(@@) % أفلت نجوم الغي حين بدا % % للرشد نجم أنت مصدعه % % 57(@)(@@) % وأقمت للحق المنار على % % لقم الطريق فبان مهيعه % % 58(@)(@@) % ونشرت ميت العدل من جدث % قد كان فيه طال مهجعه % % 59(@)(@@) % أمنت بيمنك في مراتعها % % شاء الفلا وذعرن أضبعه % % 60 
ms718	(@)(@@) % ولقد يرى أوس ويونس من % % جناتها صعبا ممنعه % % PageV01P2831 61(@)(@@) % حسنت بك الدنيا وعادلها % % كف طليل الأيك مونعه % % 62(@)(@@) % وملأت مشرقها ومغربها % % عدلا تغشى الناس أوسعه % % 63(@)(@@) % فتمل معتليا سلامة ما % % قلدته وهناك مكرعه % % PageV01P2832 البحر : - 1(@)(@@) % سألتك إغنائي عن الناس كلهم % فأغنيتني عنهم وعنك جميعا % % 2(@)(@@) % فلست تراني الآن إلا مسلما % عليك مشيعا للثناء مذيعا % % 3(@)(@@) % وأما ارتيادي نائلا فمحرم % علي فإني قد غدوت ربيعا % % 4(@)(@@) % ألا هكذا فليمنع اليوم من غد % وإلا فلا يا من يريد صنيعا % % PageV01P2833 البحر : - 1(@)(@@) % بت وبات الصبيان في أرق % من بحة لم تزل تفزعنا % % 2(@)(@@) % يبكون من خوفها ويسهرني % % بكاؤهم فالبلاء يجمعنا % % 3(@)(@@) % نحتال للنوم كي يواتينا % % بكل شيء وليس ينفعنا % % 4(@)(@@) % لا حفظ الله تلك مسمعة % ما يكره السامعون تسمعنا % % PageV01P2834 البحر : - 1(@)(@@) % وطويل القرن إلا أنه % % لاحق بالأرض كالقرد الجزع % 2(@)(@@) % طال قرناه معا فارتفعا % % وأبت قامته أن ترتفع % 3(@)(@@) % فهو إن فكرت في رجل % % شب قرناه ولكن ما زرع % 4(@)(@@) % سوف تدري من تمرست به % % يا أبا حفص أخا الرأس القرع % % PageV01P2835 البحر : - 1(@)(@@) % نحن تركناه قصرا أصلعا % % من بعد ما كان طويلا أفرعا % % 2(@)(@@) % ما زال يكسوه إذا ما استصفعا % % صفعا . . حتى قرعا % % PageV01P2836 البحر : - 1(@)(@@) % رأس أبي حفص عظيم المنفعه % كم من يد أمست به ممتعه % % 2(@)(@@) % لو عدمته لبكت بأربعه % % وأصبحت لفقده مفجعه % 3(@)(@@) % رأس جلاه الدهر حتى قرعه % % فلم يدع في جانبيه قزعه % 4(@)(@@) % كأنما قرعه ليصفعه % لله تلك الهامة المربعه % 5(@)(@@) % إذا بدت كالفيشة المقصعه % % مصقولة مدهونة مصنعه % % 6(@)(@@) % ثم هوت فيها يد كالمقمعه % % بصفعة هائلة مشعشه % % 7(@)(@@) % كأنها نفاخة مفرقعه % % يا ليت لي يافوخه وأخدعه % % 8(@)(@@) % ملك يد من فضل رب ذي سعه % % بل ليتني أسمع تلك القعقعه % % 9(@)(@@) % مكان أعلى مسمع ومسمعه % % PageV01P2837 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % تأن في بيته من سوف يردعه % 2(@)(@@) % ما حاز منزله عرسا ولا أمة % إلا ومن أجل هجوي سوف يصفعه % % PageV01P2838 البحر : - 1(@)(@@) % لا تحسب الشيخ أبا حفصل % يعيش من 
ms719	 أقلامه الصلع % % 2(@)(@@) % لكن من الله ومن زوجه % % تستدخل الأصلع في المخدع % % 3(@)(@@) % ليست بذي بأس ولكنها % % قوامة الليل على الأربع % % 4(@)(@@) % من كسبها عاش أبو حفصل % وطال ما عاش مع الجوع % % 5(@)(@@) % وربما عاد على نفسه % % بكسب رأس جيد المصفع % % 6(@)(@@) % يمكن بالأكلة من صفعه % % في ساحة الرأس وفي الأخدع % % PageV01P2839 البحر : - 1(@)(@@) % دخلت على خالد مرة % وقد غاب في ذاته الأصلع % 2(@)(@@) % فقلت أشيخ كبير يناك % % فقال أجل خلق يرقع % 3(@)(@@) % فقلت له على أربع % % فقال نعم هكذا أنجع % 4(@)(@@) % إذا لم أكب على أربع % فلم خلقت لي إذا أربع % 5(@)(@@) % تركت السجود لأربابه % % فدعني إذ فاتني أركع % % 6(@)(@@) % قبيح بمثلي على سنه % % يناك فيبطح أو يضجع % % 7(@)(@@) % لأهل الجرائم وضع الصدو % % ر لا لي والمصرع الأضرع % % 8(@)(@@) % فأعرضت عن رجل فاسق % لشيطانه فيه مستمتع % 9(@)(@@) % إذا فعل السوء قال الخنا % % ليشبه منظره المسمع % PageV01P2840 البحر : - 1(@)(@@) % وجهك يا شنطف هول المطلع % يأخذني منه انتفاض وفزع % 2(@)(@@) % ويطلع النحس به إذا طلع % يا ويح أثوابك لو قد تنتزع % % 3(@)(@@) % لنزعت عن برص وعن لمع % % والرأس فيه قزع من القرع % % 4(@)(@@) % والفرج كالبالوع ما شئت بلع % % PageV01P2841 البحر : - 1(@)(@@) % يا تناه والتناهي انقطاع % كن كما سماك مولى لكاع % 2(@)(@@) % كن لدنياه انقطاعا وشيكا % وانقلاعا ليس فيه انخداع % 3(@)(@@) % وانصداعا ليس فيه التئام % وافتراقا ليس فيه اجتماع % 4(@)(@@) % خنه ما أعطاك معطي العطايا % % مثلما خان السحاب انقشاع % % 5(@)(@@) % فهو للسلطان عر وعار % واتضاع ليس فيه ارتفاع % % 6(@)(@@) % رقعة في الملك ليست بزين % أي ثوب زينته الرقاع % % 7(@)(@@) % طلقت نعمى ابن معدان منه % % بثلاث ليس فيها رجاع % % 8(@)(@@) % أو بقول الناس عودا وبدءا % يا لقوم باخ ذاك الشعاع % % 9(@)(@@) % فترت تلك الرياح الجواري % % كلها وانحط ذاك الشراع % % 10(@)(@@) % وحمت آل الفرات الليالي % % أن يروا أسراب نعمى تراع % % PageV01P2842 11(@)(@@) % أيها المصروع في كل حال % استمع مني ففيك استماع % % 12(@)(@@) % قد عجبنا أنك المرء يشقى % % عنده ناس وتحظى سباع % % 13(@)(@@) % بيتك البيت القصير السواري % % ما بنى 
ms720	 فيه ضيوف جياع % % 14(@)(@@) % واستك الاست التي منذ شقت % أبدا فيها فهود شباع % 15(@)(@@) % أيها المصروع من كل وجه % صرعات ما جناها صراع % % 16(@)(@@) % بل بغاء مستحر وخبل % مستمر مذ غذاك الرضاع % 17(@)(@@) % صرعة بيدي لها فوك سلحا % % من كلام يجتويه السماع % 18(@)(@@) % بعد أخرى يلفظ الثلط عنها % % فقحة فيها هناك اتساع % % 19(@)(@@) % قلت إذ قالوا جبان كذبتم % % وأثمتم بل شجاع رواع % % 20(@)(@@) % كل صبر كان في الناس طرا % كلفة والصبر فيه طباع % % PageV01P2843 21(@)(@@) % أبدا عند ابن معدان فحل % يشترى جهرا وأنثى تباع % % 22(@)(@@) % هم أير ثم نوم طويل % وهموم است هناك القراع % % 23(@)(@@) % فإذا ليمت على ذاك قالت % % ليس لي بالجاهلين ارتقاع % 24(@)(@@) % تعمر الحيات في كل يوم % منه حجرا ليس فيه امتناع % % 25(@)(@@) % فقحة فيها اتساع متى لم % % يحشه ضاقت عليه البقاع % 26(@)(@@) % هي في مقدار قبل ودبر % أفضيا فالذرع ذرع مشاع % 27(@)(@@) % هل شجاع القوم إلا شجاع % أبدا ينساب فيه شجاع % 28(@)(@@) % قيل إن العبد عبد كفور % ما لفحشاء لديه قناع % % 29(@)(@@) % قلت لا بل ذاك عبد شكور % يشكر المولى ومفساه باع % % 30(@)(@@) % وترى البلوى التي في حشاه % % نعمة فيها لنفس متاع % PageV01P2844 31(@)(@@) % ولدفع الفحل أشهى إليه % % من دفاع الله إذ لا دفاع % % 32(@)(@@) % إن دنيا ملكته رغيفا % لمباح ما لها بل مضاع % 33(@)(@@) % ملحد لا يعبد الله لكن % كل غرمول قفاه ذراع % % 34(@)(@@) % ومتى أنحى عليه جماع % عد أن قد كان منه الجماع % 35(@)(@@) % فله من ناكة الروم ود % وله منهم أخوهم سواع % 36(@)(@@) % وله منهم أخوه يغوث % وله منهم يعوق مطاع % % 37(@)(@@) % وله نسر ولات وعزى % % ما له لا حط ذاك البعاع % % PageV01P2845 البحر : - 1(@)(@@) % يا بن شهر الصيام أنت رقيع % ووضيع كما يكون الوضيع % 2(@)(@@) % كل شعر جهدت نفسك فيه % % وتكلفت نظمه تفقيع % 3(@)(@@) % لم يقله إلا موطن نفس % أنه عند بثه مصفوع % % 4(@)(@@) % فاترك الشعر وارتدع من قريب % % واعد عنه إلى الذي تستطيع % 5(@)(@@) % فستلهيك إبرة وخيوط % وإلى الأصل ما تؤول الفروع % % PageV01P2846 البحر : - 1 