ms121	 تنوي أن تؤم بنا % % فقلت كلا ولكن مطلع الجود % PageV01P398 البحر : وافر تام 1(@)(@@) % ليهنك يا سليل فقد هنتني % % بما عوفيت عافية هنيه % 2(@)(@@) % يطول لك البقاء قرير عين % وتصرف عنك صائلة المنيه % 3(@)(@@) % أرى الآمال ضاحكة الثنايا % % تبسم عن عطاياك السنيه % 4(@)(@@) % ونور الشمس ما طلعت تباهي % % بنور طلوع طلعتك البهيه % 5(@)(@@) % بنيت بنية في المجد طالت % وطلت بطول مجدك في البنيه % 6(@)(@@) % غنيت ببذل مالك في المعالي % % فنفسك من إفادتها غنيه % 7(@)(@@) % جنى لي فيك من ثمرات مدحي % % لسان الشكر أبياتا جنيه % 8(@)(@@) % وقد أهديتها لك وهي عندي % % على الأيام من أزكى هديه % PageV01P399 البحر : مجزوء الكامل 1(@)(@@) % أعطاك دمعك جهده % فشكا فؤادك وجده % 2(@)(@@) % حملت نفسك في الهوى % % ما لا تطيق فهده % 3(@)(@@) % يا شامتا بي إذ رأى % % هجر الحبيب وصده % 4(@)(@@) % لا تشمتن فإنه % % مولى يعذبث عبده % PageV01P400 البحر : وافر تام 1(@)(@@) % أيا ويل الشجي من الخلي % % وبالي الربع من إحدى بلي % 2(@)(@@) % وما للدار إلا كل سمح % بأدمعه وأضلعه سخي % 3(@)(@@) % سنت عبراته الأطلال حتى % % نزحن غروبها نزح الركي % % 4(@)(@@) % سقى الشرطان جزعك والثريا % % ثراك بمسبل خضل روي % % 5(@)(@@) % فكم لي من هواء فيك صاف % غذي جوه وهوى وبي ! % 6(@)(@@) % وناضرة الصباحين اسبكرت % طلاع المرط في الدرع اليدي % % 7(@)(@@) % تشكى الأين من نصف سريع % إذا قامت ومن نصف بطي % % 8(@)(@@) % تعيرك مقلة نطفت ولكن % قصاراها على قلب بري % % 9(@)(@@) % سأشكر فرجة اللبب الرخي % ولين أخادع الدهر الأبي % % 10(@)(@@) % وإن لدي للحسن بن وهب % حباء مثل شؤبوب الحبي % PageV01P401 11(@)(@@) % أقول لعثرة الأدب التي قد % أوت منه إلى فيح دفي % 12(@)(@@) % أميلوا العيس تنفح في براها % % إلى قمر الندامى والندي % 13(@)(@@) % فقد جعل الإله لكم لسانا % عليا ذكره بأبي علي % % 14(@)(@@) % أغر إذا تمرغ في نداه % تمرغنا على كرم وطي % % 15(@)(@@) % لعمر بني أبي دينا وعمري % % وعمر أبي وعمر بني عدي % % 16(@)(@@) % لقد جلى كتابك كل بث % جو وأصاب شاكلة الرمي % % 17(@)(@@) % فضضت ختامه فتبلجت لي % % غرائبه عن الخبر الجلي 
ms122	 % % 18(@)(@@) % وكان أغض في عيني وأندى % % على كبدي من الزهر الجني % 19(@)(@@) % وأحسن موقعا مني وعندي % % من البشرى أتت بعد النعي % % 20(@)(@@) % وضمن صدره مالم تضمن % صدور الغنيات من الحلي % PageV01P402 21(@)(@@) % فكائن فيه من مغنى خطير % وكائن فيه من لفظ بهي % 22(@)(@@) % وكم أفصحت عن بر جليل % به ووأيت من وأي سني % % 23(@)(@@) % كتبت به بلا لفظ كريه % على أذن ولاخط قمي % % 24(@)(@@) % فأطلق من عقالي في الأماني % % ومن عقل القوافي والمطي % % 25(@)(@@) % وفي رمضاء من رمضان تغلي % % بهامة لا الحصور ولا التقي % % 26(@)(@@) % فيا ثلج الفؤاد وكان رضفا % ويا شبعي إذا يمضي وربي % 27(@)(@@) % رسالة من تمتع بعد حين % ومتعنا من الأدب الرضي % 28(@)(@@) % لئن غربتها في الأرض بكرا % لقد جليت على سمع كفي % % 29(@)(@@) % وإن تك من هداياك الصفايا % % فرب هدية لك كالهدي % % 30(@)(@@) % بيان لم ترثه تراث دعوى % % ولم تنبطه من حسي بكي % PageV01P403 31(@)(@@) % عشوت على عداتك فيه حتى % % خطوت به على أمل مضي % % 32(@)(@@) % فناهض بي من الأسفار وجها % مهاريه ضوامر كالحني % 33(@)(@@) % فلست ترى أقل هوى ونفسا % وألزم للدنو من الدني % 34(@)(@@) % نبت على خلائق منك بيض % كما نبت الحلي على الولي % 35(@)(@@) % فمن جود تدفق سيله لي % % على مطر ومن جود أتي % 36(@)(@@) % ومن جود له حولي صريف % بنابيه ومن عرف فتي % 37(@)(@@) % ومحدود الذريعة ساء ه ما % % ترشح لي من السبب الحظي % 38(@)(@@) % يدب إلي في شخص ضئيل % وينظر من شفا طرف خفي % 39(@)(@@) % ويتبع نعمتي بك عين ضغن % كما نظر اليتيم إلى الوصي % 40(@)(@@) % رجاء أنه يوري بزندي % % إليك وأنه يفري فريي % % PageV01P404 41(@)(@@) % وذاك له إذا العنقاء صارت % مرببة وشب ابن الخصي % 42(@)(@@) % أرى الإخوان ماغيبت عنهم % بمقسط ذلك الشعب القصي % 43(@)(@@) % ومردود صفاؤهم عليهم % كما رد النكاح بلا ولي % % 44(@)(@@) % وهم ما دمت كوكبهم وساروا % % بريحك في غدو أو عشي % 45(@)(@@) % فحينئذ خلا بالقوس بار % وأفرغت الأداة على الكمي % % 46(@)(@@) % وإن لهم لإحسانا ولكن % جرى الوادي فطم على القري % % 47(@)(@@) % وهل 
ms123	 من جاء بعد الفتح يسعى % % كصاحب هجرتين مع النبي ؟ ! % PageV01P405 البحر : مجزوء الخفيف 1(@)(@@) % لا وورد بخده % واعتدال بقده % % 2(@)(@@) % لا تعشقتث غيره % لو براني بصده % 3(@)(@@) % إن يكن أسقم الهوى % % بعد تصحيح وده % 4(@)(@@) % فعساه بعد التم % يرثي لعبده % PageV01P406 البحر : كامل تام 1(@)(@@) % داع دعا بلسان هاد مرشد % فأجاب عزم هاجد في مرقد % 2(@)(@@) % نادى وقد نشر الظلام سدوله % والنوم يحكم في عيون الرقد % 3(@)(@@) % يا ذائد الهيم الخوامس وفها % % عشرا واف بها حياض محمد % 4(@)(@@) % يمددن للشرف المنيف صواديا % أعناقهن إلى حياض السؤدد % 5(@)(@@) % وتنبهت فكر فبتن هواجسا % في قلب ذي سمر بها متهجد % 6(@)(@@) % لما رأيتك يا محمد تصطفي % % صفو المحامد من ثناء المجتدي % % 7(@)(@@) % سيرت فيك مدائحي فتركتها % % غررا تروح بها الرواة وتغتدي % % 8(@)(@@) % مالي إذا ما رضت فيك غربية % جاءت مجيء نجيبة في مقود ! % 9(@)(@@) % ما ذاك إلا أن زندك لم يكن % في كف قادحه بزند مصلد % 10(@)(@@) % صدقت مدحي فيك حين رعيتني % % لتحرمي بالسيد المتشهد % PageV01P407 11(@)(@@) % ولجأت منك إلى ابن ملك أنبأت % عنه خلائقه بطيب المحتد % 12(@)(@@) % ملك يجود ولا يؤامر آمرا % فيه ويحكم في جداه المجتدي % % 13(@)(@@) % ويقول والشرف المنيف يحفه % لا خير في شرف إذا لم أحمد % 14(@)(@@) % وأكون عند ظنون طلاب الندى % % وأذب عن شرفي بما ملكت يدي % % 15(@)(@@) % يأبى لعرضي أن يكون مشعثا % جود وقاه بطارف وبمتلد % 16(@)(@@) % ولراحتيه ديمتان : قديمة % لي بالوداد وديمة بالعسجد % 17(@)(@@) % كم من ضريك قد بسطت يمينه % بعد التحين في ثراء سرمد % 18(@)(@@) % ولرب حرب حائل لقحتها % % ونتجتها من قبل حين المولد % 19(@)(@@) % فإذا بعثت لناكثين عزيمة % عصفت رؤوسق من سيوف ركد % 20(@)(@@) % إن الخلافة لوجزتك بموقف % جعلت مثالك قبلة للمسجد % PageV01P408 21(@)(@@) % وسعت إليك جنودها حتى إذا % % وافتك خر لديك كل مقلد % 22(@)(@@) % والله يشكر والخليفة موقفا % لك شائعا بالبذ صعب المشهد % % 23(@)(@@) % في مأزق ضنك المكر مغصص % أزز المجال من القنا المتقصد % 24(@)(@@) % نازلت فيه مفندا في دينه % لا بأسه فرآك غير مفند % 25(@)(@@) % فعلوت 
ms124	 هامته فطار فراشها % % بشهاب موت في اليدين مجرد % 26(@)(@@) % يافارس الإسلام أنت حميته % % وكفيته كلب العدو المعتدي % % 27(@)(@@) % ونصرته بكتائب صيرتها % % نصبا لعورات العدو بمرصد % 28(@)(@@) % أصبحت مفتاح الثغور وقفلها % % وسداد ثلمتها التي لم تسدد % % 29(@)(@@) % أدركت فيه دم الشهيد وثاره % % وفلجت فيه بشكر كل موحد % 30(@)(@@) % ضحكت له أكباد مكة ضحكها % % في يوم بدر والعتاة الشهد % PageV01P409 31(@)(@@) % أحييت للإسلام نجدة خالد % وفسحت فيه لمتهم ولمنجد % 32(@)(@@) % لو أن هرثمة بن أعين في الورى % % حي وعاين فضله لم يجحد % 33(@)(@@) % أو شاهد الحرب الممر مذاقها % % لرآه أقمع للعتاة العند % 34(@)(@@) % وأجر للخيل المغيرة في السرى % % وأذب منه باللسان وباليد % % 35(@)(@@) % أما الجياد فقد جرت فسبقتها % % وشربت صفو زلالها في المورد % 36(@)(@@) % غادرت طلحة في الغبار وحاتما % وأبان حسرى عن مداك الأبعد % 37(@)(@@) % وطلعت في درج العلى حتى إذا % % جئت النجوم نزلت فوق الفرقد % 38(@)(@@) % فانعم فكنيتك التي كنيتها % % فأل جرى لك بالسعادة فاسعد % 39(@)(@@) % ولقد وفدت إلى الخليفة وفدة % كانت على قدر بعد الأسعد % 40(@)(@@) % زرت الخليفة زورة ميمونة % مذكورة قطعت رجاء الحسد % PageV01P410 41(@)(@@) % يتنفسون فتنثني لهواتهم % من جمرة الحسد التي لم تبرد % 42(@)(@@) % نفسوك فالتمسوا نداك فحاولوا % % جبلا يزل صفيحه بالمصعد % 43(@)(@@) % درست صفائح كيدهم فكأنما % % أذكرن أطلالا برقة ثمهد % PageV01P411 البحر : متقارب تام 1(@)(@@) % نعاء إلى كل حي نعاء % فتى العرب احتل ربع الفناء % 2(@)(@@) % أصبنا جميعا بسهم النضال % فهلا أصبنا بسهم الغلاء ! ! % 3(@)(@@) % ألا أيها الموت فجعتنا % % بماء الحياة وماء الحياء % 4(@)(@@) % فماذا حضرت به حاضرا % وماذا خبأت لاهل الخباء ! % 5(@)(@@) % نعاء نعاء شقيق الندى % % إليه نعيا قليل الجداء % 6(@)(@@) % وكانا جميعا شريكي عنان % رضيعي لبان خليلي صفاء % 7(@)(@@) % على خالد بن يزيد بن مز % يد امر دموعا نجيعا بماء % 8(@)(@@) % ولا ترين البكا سبة % ألصق جوى بلهيب رواء % 9(@)(@@) % فقد كثر الرزء قدر الدموع % وقد عظم الخطب شأن البكاء % 10(@)(@@) % فباطنه ملجأ للأسى % % وظاهره ميسم للوفاء % PageV01P412 11(@)(@@) % مضى الملك الوائلي الذي % % حلبنا به العيش وسع الإناء % 12 
ms125	(@)(@@) % فأودى الندى ناضر العود وال % % فتوة مغموسة في الفتاء % 13(@)(@@) % فأضحت عليه العلى خشعا % وبيت السماحة ملقى الكفاء % 14(@)(@@) % وقد كان مما يضيء السرير % والبهو يملأه بالبهاء % 15(@)(@@) % الملك عن خالد والملوك % بقمع العدى وبنفي العداء % 16(@)(@@) % ألم يك أقتلهم للأسود % صبرا وأوهبهم للظباء ؟ ! % 17(@)(@@) % ألم يجلب الخيل من بابل % شوازب مثل قداح السراء % 18(@)(@@) % فمد على الثغر إعصارها % % برأي حسام ونفس فضاء % 19(@)(@@) % فلما تراءت عفاريته % سنا كوكب جاهلي السناء % 20(@)(@@) % وقد سد مندوحة القاصعاء % منهم وأمسك بالنافقاء % PageV01P413 21(@)(@@) % طوى أمرهم عنوة في يديه % طي السجل وطي الرداء % 22(@)(@@) % أقروا لعمري بحكم السيوف % وكانت أحق بفضل القضاء % 23(@)(@@) % وما بالولاية إقرارهم % ولكن أقروا له بالولاء % 24(@)(@@) % أصبنا بكنز الغنى والإمام % أمسى مصابا بكنز الغناء % 25(@)(@@) % وما إن أصيب براعي الرعية % لا بل أصيب براعي الرعاء % 26(@)(@@) % يقول النطاسي إذ غيبت % عن الداء حيلته والدواء % 27(@)(@@) % ونبو المقيل به والمبيت % أقعصه واختلاف الهواء % 28(@)(@@) % وقد كان لو رد غرب الحمام % شديد توق طويل احتماء % 29(@)(@@) % معرسه في ظلال السيوف % ومشربه من نجيع الدماء % 30(@)(@@) % ذرى المنبر الصعب من فرشه % ونار الوغا ناره للصلاء % PageV01P414 31(@)(@@) % وما من لبوس سوى السابغات % ترقرق مثل متون الإضاء % 32(@)(@@) % فهل كان مذ كان حتى مضى % % حميدا له غير هذا الغذاء % 33(@)(@@) % أذهل بن شيبان ذهل الفخار % وذهل النوال وذهل العلاء % 34(@)(@@) % مضى خالد بن يزيد بن مز % يد قمر الليل شمس الضحاء % 35(@)(@@) % وخلى مساعيه بينكم % فإياي فيها وسعي البطاء % 36(@)(@@) % ردوا الموت مرا ورود الرجال % وبكوا عليه بكاء النساء % 37(@)(@@) % غليلي علي خالد خالد % وضيف همومي طويل الثواء % 38(@)(@@) % فلم يخزني الصبر عنه ولا % % تقنعت عارا بلؤم العزاء % 39(@)(@@) % تذكرت خضرة ذاك الزمان % لديه وعمران ذاك الفناء % 40(@)(@@) % وزواره للعطايا حضور % كأن حضورهم للعطاء % PageV01P415 41(@)(@@) % وإذ علم مجلسه مورد % زلال لتلك العقول الظماء % 42(@)(@@) % تحول السكينة دون الأذى % % به والمروة دون المراء % 43(@)(@@) % وإذ هو مطلق كبل المصيف % وإذ هو مفتاح قيد الشتاء % 44 
ms126	(@)(@@) % لقد كان حظي غير الخسيس % من راحتيه وغير اللفاء % 45(@)(@@) % وكنت أراه بعين الرئيس % % وكان يراني بعين الإخاء % 46(@)(@@) % ألهفي على خالد لهفة % تكون أمامي وأخرى ورائي % % 47(@)(@@) % ألهفي إذا ما ردى للردى % % ألهفي إذا ما احتبى للحباء % 48(@)(@@) % ألحد حوى حية الملحدين % ولدن ثرى حال دون الثراء ؟ ! % 49(@)(@@) % جزت ملكا فيه ريا الجنوب % ورائحة المزن خير الجزاء % 50(@)(@@) % فكم غيب الترب من سؤدد % % وغال البلى من جميل البلاء ! % PageV01P416 51(@)(@@) % أبا جعفر ليعرك الزمان % عزا ويكسبك طول البقاء % 52(@)(@@) % فما مزنك المرتجى بالجهام % ولاريحنا منك بالجربياء % 53(@)(@@) % ولا رجعت فيك تلك الظنون % حيارى ولا انسد شعب الرجاء % 54(@)(@@) % وقد نكس الثغر فابعث له % صدور القنا في ابتغاء الشفاء % 55(@)(@@) % فقد فات جدك جد الملوك % وعمر أبيك حديث الضياء % 56(@)(@@) % ولم يرض قبضته للحسام % ولا حمل عاتقه للرداء % 57(@)(@@) % فما زال يفرع تلك العلى % % مع النجم مرتديا بالعماء % 58(@)(@@) % ويصعد حتى لظن الجهول % أن له منزلا في السماء % 59(@)(@@) % وقد جاءنا أن تلك الحروب % إذا حديت فالتوت بالحداء % 60(@)(@@) % وعاودها جرب لم يزل % يعاود أسعافها بالهناء % PageV01P417 61(@)(@@) % ويمتح سجلا لها كالسجال % ودلوا إذا أفرغت كالدلاء % 62(@)(@@) % ومثل قوى حبل تلك الذراع % كان لزازا لذاك الرشاء % 63(@)(@@) % فلا تخز أيامه الصالحات % وما قد بنى من جليل البناء % 64(@)(@@) % فقد علم الله أن لن تحب % شيئا كحبك كنز الثناء % PageV01P418 البحر : - 1(@)(@@) % صد ومااحتسب الصدا % % لم يحفظ الميثاق والعهدا % % 2(@)(@@) % ولا رعى ودي ولاحرمتي % % ولم أزل أرعى له الودا % % 3(@)(@@) % يا قاتلي ظلما بسيف الهوى % % إذ صرت عبدا فارحم العبدا % % 4(@)(@@) % قد والذي عذب قلبي بكم % قاسيت مذ فارقتني جهدا % % PageV01P419 البحر : كامل تام 1(@)(@@) % أجفان خوط البانة الأملود % مشغولة بك عن وصال هجود % 2(@)(@@) % سكبت ذخيرة دمعة مصفرة % في وجنة محمرة التوريد % 3(@)(@@) % فكأن وهي نظامها نظم وهي % % من يارق وقلائد وعقود % 4(@)(@@) % أذكت حميا وجدها حمة الأسى % % فغدت بنار غير ذات خمود % 5(@)(@@) % طلعت طلوع الشمس في طرف النوى % % والشمس طالعة بطرف حسود 
ms127	 % 6(@)(@@) % وتأملت شبحي بعين أيدت % عمد الهوى في قلبي المعمود % 7(@)(@@) % فنحرت حسن الصبر تحت الصدر عن % جيد بواضح نحرها والجيد % 8(@)(@@) % حاشى لجمر حشاي أن يلقى الحشا % % إلا بلفج مثل لفج وقود % 9(@)(@@) % أضحى الذي بقته نيران الحشا % % مني حبيسا في سبيل البيد % 10(@)(@@) % أذراء أمطاء الغنى يضحكن عن % أذراء أمطاء المطايا القود % PageV01P420 11(@)(@@) % فظللت حد الأرض تحت العزم في % % وجناء تدني حد كل بعيد % 12(@)(@@) % تحثو إذا حث العتاق الوخد في % % غرر العتاق النقع بالتوحيد % 13(@)(@@) % تعريسها خلل السر تقريبها % % حتى أنخت بأحمد المحمود % 14(@)(@@) % فحططت تحت غمامة مغمورة % بحيا بروق ضاحكا ورعود % 15(@)(@@) % تلقاه بين الزائرين كأنه % قمر السماء يلوح بين سعود % 16(@)(@@) % لو فاح عود في الندي وذكره % لعلا بطيب الذكر طيب العود % 17(@)(@@) % ولاه منصور سماح يمينه % % ومضى فقيد المثل غير فقيد % 18(@)(@@) % فيرى فناء المال أفضل ذخره % % وخلود ذكر الحمد خير خلود % 19(@)(@@) % يبدي أبوالحسن اللهى ويعيدها % % فمؤملوه من اللهى في عيد % 20(@)(@@) % حييت غرته بحسن مدائح % غر فحيا غرتي بالجود % PageV01P421 21(@)(@@) % لو رام جلمودا بجانب صخرة % يوما لرضض جانب الجلمود % 22(@)(@@) % وإذا الثغور استنصرته شبا القنا % % أروى الشبا من ثغرة ووريد % 23(@)(@@) % يستل إثر عدوها عزماته % % فيعمها بالنصر والتأييد % 24(@)(@@) % ذو ناظر حدب وسمع عائر % نحو الطريد الصارخ المجهود % 25(@)(@@) % تلقاه منفردا وتحسب أنه % من عزمه في عدة وعديد % 26(@)(@@) % ياأيها الملك المرجى والذي % % قدحت به فطني نظام نشيدي % % 27(@)(@@) % أنا راجل ببلاد مرو راكب % في جودة الأشعار كل مجيد % 28(@)(@@) % فأعز ذلة رجلتي بمهذب % حلو المخيل مقذذ مقدود % 29(@)(@@) % ذي كمتة أوشقرة أو حوة % أو دهمة فهم الفؤاد سديد % 30(@)(@@) % تتنزه اللحظات في حركاته % كتنزهي في ظلك الممدود % PageV01P422 31(@)(@@) % متسربل بردا يفوق بوشيه % بين المواكب حسن وشي برود % 32(@)(@@) % فإذا بدا في مشهد قامت له % نبلاء صدر المحفل المشهود % 33(@)(@@) % يجد السرور الراكب الغادي به % % كسروره بالفارس المولود % 34(@)(@@) % إن سابقته الخيل في ميدانها % % قذفت إليه الخيل بالإقليد % 35(@)(@@) % فيروح بين مؤبيه 
ms128	 مخالفا % متعصبا بعصابة التسويد % 36(@)(@@) % ومشيعوده معوذوه بكل ما % % عرفوه من عوذ من التحميد % 37(@)(@@) % يتعشقون نضارة في وجهه % عضق الفتى وجه الفتاة الرود % 38(@)(@@) % أغضى عليك جفون شكرك إنها % % ثقلت علي لجودك الموجود % 39(@)(@@) % إني اعتصمت بطول طودك إنه % طود يقوم مقام طود حديد % 40(@)(@@) % لا يهتدي صرف الزمان إلى امرىء % % متصرف بفنائك المعهود % PageV01P423 البحر : كامل تام 1(@)(@@) % أمحمد بن سعيد ادخر الأسى % % فيها وراء الحر يوم ظمائه % 2(@)(@@) % أنت الذي لا تعذل الدنيا إذا % % ما النائبات صفحن عن حوبائه % 3(@)(@@) % لو كان يغنى حازم عن واعظ % % كنت الغني بخزمه وذكائه % 4(@)(@@) % لست الفتى إن لم تعر مدامعا % من مائها والوجد بعد بمائه % 5(@)(@@) % وإذا رأيت أسى امرئ أو صبره % % يوما فقد عاينت صورة رائه % 6(@)(@@) % إني أرى ترب المروءة باكيا % فأكاد أبكي معظما لبكائه % 7(@)(@@) % حق على أهل التيقظ والحجى % % وقضاء طب عالم بقضائه % 8(@)(@@) % ألا يعزى جاذع بحميمه % حتى يعزى أولا بعزائه % PageV01P424 البحر : خفيف تام 1(@)(@@) % أنا في لوعة وحزن شديد % ليس عندي للوعة من مزيد % 2(@)(@@) % بأبي شادن تنسمت من عي % نيه يوم الخميس ريح الصدود % 3(@)(@@) % صار ذنبي كذنب آدم يا عمر % رو ، فأخرجت من جنان الخلود % 4(@)(@@) % أناأفدي ساجي الجفون يسمى % % ويكنى ببعض عبد الحميد % PageV01P425 البحر : كامل تام 1(@)(@@) % عن فشاقك طائر غريد % لما ترنم والغصون تميد % 2(@)(@@) % ساق على ساق دعا قمرية % فدعت تقاسمه الهوى وتصيد % 3(@)(@@) % إلفان في ظل الغصون تألفا % % والتف بينهما هوى معقود % 4(@)(@@) % يتطعمان بريق هذا هذه % مجعا وذاك بريق تلك معيد % 5(@)(@@) % يا طائران تمتعا هنيتما % % وعما الصباح فإنني مجهود % 6(@)(@@) % آه لوقع البيي يابن محمد % بين المحب على المحب شديد % 7(@)(@@) % أبكي وقد سمت البروق مضيئة % من كل أقطار السماء رعود % 8(@)(@@) % واهتز ريعان الشباب فأشرقت % % لتهلل الشجر القرى والبيد % 9(@)(@@) % ومضت طواويس العراق فأشرقت % أذناب مشرقة وهن حفود % 10(@)(@@) % يرفلن أمثال العذارى طوفا % حول الدوار وقد تجانى العيد % PageV01P426 11(@)(@@) % إني سأنثر من لساني لؤلؤا % يرد العراق 
ms129	 نظامه معقود % 12(@)(@@) % حتى يحل من المهلب منزلا % للمجد في غرفاته تشييد % 13(@)(@@) % رفع الخلافة راية فتقاصرت % عنها الرجال وحازها داود % 14(@)(@@) % السيد العتكي غير مدافع % إذ ليس سؤدد سيد موجود % 15(@)(@@) % نقرت باسمك في الظلام مسدرا % داود إنك في الفعال حميد % 16(@)(@@) % قد قيل : أين تريد ، قلت : أخا الندى % % وأبا سليمان الأغر أريد % 17(@)(@@) % فافتح بجودك قفل دهري إنه % قفل وجود يديك لي إقليد % 18(@)(@@) % فالجود حي ما حييت وإن تمت % غاضت مناهله ومات الجود % PageV01P427 البحر : طويل 1(@)(@@) % هو الدهر لا يشوي وهن المصائب % وأكثر آمال الرجال كواذب % 2(@)(@@) % فيا غالبا لاغالب لرزية % بل الموت لاشك الذي هو غالب % 3(@)(@@) % وقلت أخي ، قالوا أخ ذو قرابة ؟ % فقلت ولكن الشكول أقارب % 4(@)(@@) % نسيبي في عزم ورأي ومذهب % وإن باعدتنا في الأصول المناسب % 5(@)(@@) % كأن لم يقل يوما كأن فتنثني % % إلى قوله الأسماع وهي رواغب % 6(@)(@@) % ولم يصدع النادي بلفظة فيصل % سنانية في صفحتيها التجارب % 7(@)(@@) % ولم أتسقط ريب دهري برأيه % فلم يجتمع لي رأيه والنوائب % 8(@)(@@) % مضى صاحبي واستخلف البث والأسى % % 9(@)(@@) % عبجت لصبري بعده وهو ميت % وكنت امرءا أبكي دما وهو غائب % 10(@)(@@) % على أنها الأيام قد صرن كلها % % عجائب حتى ليس فيها عجائب ! % PageV01P428 البحر : سريع 1(@)(@@) % و فاتن الألحاظ والخد % معتدل القامة والقد % % 2(@)(@@) % صيرني عبدا له حسنه % % و الطرفث قد صيره عبدي % % 3(@)(@@) % قال وعيني منه في عينه % % راتعة في جنة الخلد % 4(@)(@@) % طرفك زان قلتث دمعي اذا % بجلده أكثر من حد % % 5(@)(@@) % و احمر حتى كدت أن لا أرى % % و جنته من كثرة الورد % 6(@)(@@) % الحسن والطيب إذا استجمعا % % عبدان عندي لأبي عبد % PageV01P429 البحر : كامل تام 1(@)(@@) % حل الأمير محل رفد الرافد % ومبيح طارف ماله والتالد % 2(@)(@@) % لله درك من كريم ماجد % سهل الخليقة في المكارم واحد % 3(@)(@@) % الدهر يسمح بالتي تهب الغنى % % لمؤمل من صادر أو وارد % 4(@)(@@) % فعلام أصبح من نداك بمعزل % وسواي تلحظه بعين الوالد % 5(@)(@@) % كم للأمير محمد من شاكر % في العالمين 
ms130	 وكم له من حامد % 6(@)(@@) % اليأس ألزمني محل القاعد % إذ ليس جدي في الجدود بصاعد % 7(@)(@@) % ما لي حرمت لديك حظوة خالد % أوز لست حرمة من خالد ؟ % 8(@)(@@) % عوز الرجال أقام منة خالد % والصيف نفق سوق برد البارد % 9(@)(@@) % شخصان أفاكان قيلهما الخنا % % حلا لديك محل عمرو الزاهد ! % PageV01P430 البحر : خفيف تام 1(@)(@@) % ريب دهر أصم دون العتاب % مرصد بالأوجال والأوصاب % 2(@)(@@) % جف در الدنيا فقد أصبحت تك % % تال أرواحنا بغير حساب % 3(@)(@@) % لو بدت سافرا أهينت ولكن % شعف الخلق حسنها في النقاب % 4(@)(@@) % إن ريب الزمان يحسن أن يه % % دي الرزايا إلى ذوي الأحساب % 5(@)(@@) % فلهذا يجف بعد اخضرار % قبل روض الوهاد روض الروابي % % 6(@)(@@) % لم تدر عينه عن الحمس حتى % % ضعضعت ركن حمير الأرباب % 7(@)(@@) % بطشت منهم بلؤلؤة الغوا % % ص حسنا ودمية المحراب % 8(@)(@@) % بالصريح الصريح والأروع الأر % وع منهم وباللباب اللباب % 9(@)(@@) % ذهبت محمد الغر من أيا % % مك الواضحات أي ذهاب ! % 10(@)(@@) % عبس اللهد والثرى منك وجها % غير ما عابس ولا قطاب % PageV01P431 11(@)(@@) % أطفأ اللحد والثرى لبك المس % رج في وقت ظلمة الألباب % 12(@)(@@) % وتبدلت منزلا ظاهر الجد % ب يسمى مقطع الأسباب % 13(@)(@@) % منزلا موحشا وإن كان مع % مورا بحل الصديق والأحباب % 14(@)(@@) % يا شهابا خبا لآل عبيد الل % ه أعزز بفقد هذا الشهاب ! % 15(@)(@@) % زهرة غضة تفتق عنها ال % % مجد في منبت أنيق الجناب % 16(@)(@@) % خلق كالمدام أو كرضاب المس % % ك أو كالعبير أو كالملاب % 17(@)(@@) % وحيا ناهيك في غير عي % وصبا مشرق بغير تصاب % 18(@)(@@) % أنزلته الأيام عن ظهرها من % % بعد إثبات رجله في الركاب % 19(@)(@@) % حين سامى الشباب واغتدت الدن % % يا عليه مفتوحة الأبواب % 20(@)(@@) % وحكى الصارم المحلى سوى أن % حلاه جواهر الآداب % PageV01P432 21(@)(@@) % وهو غض الآراء والحزم خرق % ثم غض النوال غض الشباب % 22(@)(@@) % قصدت نحوه المنية حتى % % وهبت حسن وجهه للتراب % PageV01P433 البحر : بسيط تام 1(@)(@@) % رأيت في النوم أن الصلح قد فسدا % % أن مولاي بعد القرب قد بعدا % % 2(@)(@@) % لم لم أمت حزنا 
ms131	 لم لم أمت أسفا % لم لم أمت جزعا لم لم أمت كمدا ! % 3(@)(@@) % قد كدت احلف لولا أن ذا سرف % ألا أذوق مناما بعدها أبدا % % 4(@)(@@) % أصبحت من زفرات لا أقوم بها % % أشكوالرقاد إذاغيري شكاالسهدا % % PageV01P434 البحر : وافر تام 1(@)(@@) % نوار في صواحبها نوار % كما فاجاك سرب أو صوار % 2(@)(@@) % تكذب حاسد فنأت قلوب % أطاعت واشيا ونأت ديار % 3(@)(@@) % قفا نعط المنازل من عيون % لها في الشوق أحساء غزار % 4(@)(@@) % عفت آياتهن وأي ربع % يكون له على الزمن الخيار ! % 5(@)(@@) % أثاف كالخدود لطمن حزنا % ونؤي مثلما انفصم السوار % 6(@)(@@) % وكانت لوعة ثم اطمأنت % كذاك لكل سائل قرار % 7(@)(@@) % مضى الأملاك فانقرضوا وأمست % سراة ملوكنا وهم تجار % 8(@)(@@) % وقوف في ظلال الذم تحمى % % دراهمها لا يحمى الذمار % 9(@)(@@) % فلو ذهبت سنات الدهر عنه % % وألقي عن مناكبه الدثار % 10(@)(@@) % لعدل قسمة الأرزاق فينا % % ولكن دهرنا هذا حمار ! % PageV01P435 11(@)(@@) % سيبتعث الركاب وراكبيها % % فتى كالسيف هجعته غرار % 12(@)(@@) % أطل على كلى الآفاق حتى % % كأن الأرض في عينيه دار % 13(@)(@@) % يقول الحاسدون إذا انصرفنا % % لقد قطعوا طريقا أوأغاروا % % 14(@)(@@) % نؤم أبا الحسين وكان قدما % فتى أعمار موعده قصار % 15(@)(@@) % له خلق نهى القرآن عنه % وذاك عطاؤه السرف البدار % 16(@)(@@) % ولم يك منك إضرار ولكن % تمادت في سجتها البحار % 17(@)(@@) % يطيب لجوده ثمر الأماني % % وتروى عنده الهمم الحرار % 18(@)(@@) % رفعت كواعب الأشعار فيه % كما رفعت لناظرها المنار % 19(@)(@@) % حليم والحفيظة منه خيم % وأي النار ليس لها شرار ؟ % 20(@)(@@) % تحن عداته إثر التقاضي % % وتنتج مثلما نتج العشار % PageV01P436 21(@)(@@) % أرى الداليتين على جفاء % لديك وكل واحدة نضار % 22(@)(@@) % إذا ما شعر قوم كان ليلا % تبلجتا كما انشق النهار % 23(@)(@@) % وإن كانت قصائدهم جدوبا % تلونتا كما ازدوج البهار % 24(@)(@@) % أغرتهما وغيرهما محلى % بجودك والقوافي قد تغار % 25(@)(@@) % وغيرك يلبس المعروف خلفا % ويأخذ ، من مواعده الصفار % 26(@)(@@) % رأيت صنائعا معكت فأمست % ذبائح والمطال لها شفار % 27(@)(@@) % وكان المطل في بدء وعود % دخانا للضنيعة وهي نار % 28(@)(@@) % نسيب البخل مذ كانا وإلا 
ms132	 % % يكن نسب فبينهما جوار % 29(@)(@@) % لذلك قيل بعض المنع أدنى % % إلى كرم وبعض الجود عار % 30(@)(@@) % فدع ذكر الضياع فبي شماس % إذا ذكرت وبي عنها نفار % PageV01P437 31(@)(@@) % ومالي ضيعة إلا المطايا % % وشعر لا يباع ولا يعار % 32(@)(@@) % وما أنا والعقار ولست منه % % على ثقة وجودك لي عقار % PageV01P438 البحر : سريع 1(@)(@@) % أي ندى بين الثرى والحبوب % وسؤدد لدن ورأي صليب ! % 2(@)(@@) % ياابن أبي ربعي استقبلت % من يومك الدنيا بيوم عصيب % 3(@)(@@) % شق جيوبا من رجال لو % % اسطاعوا لشقوا ما وراء الجيوب % 4(@)(@@) % كنت على البعد قريبا فقد % صرت على قربك غير القريب % 5(@)(@@) % راحت وفود الأرض عن قبره % فارغة الأيدي ملاء القلوب % 6(@)(@@) % قد علمت مارزئت إنما % % يعرف فقد الشمس بعد الغروب % 7(@)(@@) % إذا البعيد الوطن انتابه % % حل إلى نهي وجزع خصيب % 8(@)(@@) % أدنته أيدي العيس من ساحة % كأنها مسقط رأس الغريب % 9(@)(@@) % أظلمت الآمال من بعده % وعريت من كل حسن وطيب % 10(@)(@@) % كانت خدودا صقلت برهة % فاليوم صارت مألفا للشحوب % PageV01P439 11(@)(@@) % كم حاجة صارت ركوبا به % ولم تكن من قبله بالركوب ! % 12(@)(@@) % حل عقاليها كما أطلقت % من عقد المزنة ريح الجنوب % 13(@)(@@) % إذا تيممناه في مطلب % كان قليبا أو رشاء القليب % 14(@)(@@) % ونعمة منه تسربلتها % % كأنها طرة ثوب قشيب % 15(@)(@@) % من اللواتي إن ونى شاكر % قامت لمسديها مقام الخطيب % 16(@)(@@) % متى تنخ ترحل بتفضيله % أو غاب يوما حضرت بالمغيب % 17(@)(@@) % فما لنا اليوم ولا للعلى % % من بعده غير الأسى والنحيب % PageV01P440 البحر : منسرح 1(@)(@@) % بلغت بي فوق غاية الكمد % أبكيت عيني آخر الأبد % 2(@)(@@) % واكبدي يوشك الرقيب بأن % يمنعني أن أقول واكبدي % % 3(@)(@@) % لست ألوم الحساد يا أحسن % س لإجماعهم على حسدي % % 4(@)(@@) % كيف ألوم الحسود فيك وقد % % رأى هلال السماء طوع يدي ؟ % PageV01P441 البحر : سريع 1(@)(@@) % قل للأمير الاريحي الذي % % كفاه للبادي وللحاضر % 2(@)(@@) % لتجزك الأيام مندوحة % ونضرة من عودي الناضر % 3(@)(@@) % أشكر نعمى منك مشكورة % وكافر النعماء كالكافر % 4(@)(@@) % موهبا لم تك إلا لمن % نصابه في منصب وافر % 5(@)(@@) % لازلت 
ms133	 من شكري في حلة % لابسها ذو سلب فاخر % 6(@)(@@) % يقول من تقرع أسماعه % كم ترك الأول للآخر % 7(@)(@@) % لي صاحب قد كان لي مؤنسا % ومألفا في الزمن الغابر % 8(@)(@@) % يحتلب الدهر أفاويقه % ويخلط الحلو مع الحازر % 9(@)(@@) % حتى إذا روضي تغنى به % % ذبانه في مونق زاهر % 10(@)(@@) % ألقح بالعزم أمانيه % بعد اعتناق الهمة العاقر % PageV01P442 11(@)(@@) % تحمل منه العيس أعجوبة % تجدد السخري للساخر % 12(@)(@@) % ذا ثروة يطلب من سائل % ومفحما يأخذ من شاعر ! % 13(@)(@@) % فصادفت مالي بإقباله % منية من أمل عاثر % 14(@)(@@) % فشارك المقمور فيه ولا % % تكن شريك الرجل القامر % 15(@)(@@) % فرفدك الزائر مجد ولا % % كرفدك الزائر للزائر % PageV01P443 البحر : خفيف تام 1(@)(@@) % دأب عيني البكاء والحزن دابي % % فاتركيني وقيت ما بي لما بي % % 2(@)(@@) % سأجزي بقاء أيام عمري % % بين بثي وعبرتي واكتئابي % % 3(@)(@@) % فيك يا أحمد بن هارون خصت % ثم عمت رزيئتي ومصابي % % 4(@)(@@) % فجعتني الأيام فيك فأنسي % % في اختلالي وعصمتي في اضطرابي % % 5(@)(@@) % فجعتني الأيام بالصادق النط % ق فتى المكرمات والآداب % 6(@)(@@) % بخليل دون الأخلاء لا بل % صاحبي المصطفى على أصحابي % % 7(@)(@@) % شمري يحتل من سلفي مر % وان في الأكرمين والصياب % 8(@)(@@) % أفلما تسربل المجد واج % تاب من الحمد أيما مجتاب % 9(@)(@@) % وتراءته أعين الناظريه % قمرا باهرا ورئبال غاب % 10(@)(@@) % وعلا عارضيه ماء الندى الجا % % ري وماء الحجى وماء الشباب % PageV01P444 11(@)(@@) % أرسلت نحوه المنية عينا % قطعت منه أوثق الأسباب % PageV01P445 البحر : سريع 1(@)(@@) % وفى البكا بالعهد اذ لم يكن % % للصبر ميثاق ولا عهد % 2(@)(@@) % نغصت حسن النرجس الغض مذ % % 3(@)(@@) % % يجتمع النرجس والورد % PageV01P446 البحر : طويل 1(@)(@@) % محمد إني بعدها لمذمم % إذا ما لساني خانني فيك أوشكري % % 2(@)(@@) % لئن بقيت لي فيك آثار منطق % لقد بقيت ثار كفيك في دهري % % 3(@)(@@) % لقيت صروف الدهر دوني تابعا % لأمر العلى فاخترت شكري على عذري % % 4(@)(@@) % فأوليتني في النائبات صنائعا % كأن أياديها فجرن من البحر % 5(@)(@@) % خلائق لوكانت من الشعر سمجت % بدائعها ما استحسن الناس من شعري % % 6(@)(@@) % فعلمتني أن ألبس الحمد أهله % وذكرتني ما 
ms134	 قد نسيت من الشكر % PageV01P447 البحر : طويل 1(@)(@@) % جفوف البلى أسرعت في الغصن الرطب % وخطب الردى والموت أبرحت من خطب % 2(@)(@@) % لقد شرقت في الشرق بالموت غادة % تعوضت منها غربة الدار في الغرب % 3(@)(@@) % وألبسني ثوبا من الحزن والأسى % % هلال عليه نسج ثوب من الترب % 4(@)(@@) % أقول وقد قالوا استراحت بموتها % % من الكرب روح الموت شر من الكرب % 5(@)(@@) % لقد نزلت ضنكا من اللحد والثرى % % ولو كان رحب الذرع ماكان بالرحب % 6(@)(@@) % وكنت أرجي القرب وهي بعيدة % فقد نقلت بعدي عن البعد والقرب % 7(@)(@@) % لها منزل تحت الثرى وعهدتها % % لها منزل بين الجوانح والقلب % PageV01P448 البحر : خفيف تام 1(@)(@@) % خلس البين أحمد بن يزيد % ليس فعل الأيام بالمحمود % 2(@)(@@) % و نأى الهجر بالذي لا أسمي % % فأنا اليوم في القريب البعيد % 3(@)(@@) % ففراق أصابني من فراق % وفراق أصابني من صدود % 4(@)(@@) % ليس من كان غائبا فقدته % العين غيبا الكشاهد المفقود % PageV01P449 البحر : كامل تام 1(@)(@@) % لا أنت أنت ولا الديار ديار % خف الهوى وتولت الأوطار % 2(@)(@@) % كانت مجاورة الطلول وأهلها % % زمنا عذاب الورد فهي بحار % 3(@)(@@) % أيام تدمي عينه تلك الدمى % % فيها وتقمر لبه الأقمار % 4(@)(@@) % إذ لا صدوف ولا كنود اسماهما % % كالمعنيين ولا نوار نوار % 5(@)(@@) % بيض فهن إذا رمقن سوافرا % صور وهن إذا رمقن صوار % 6(@)(@@) % في حيث يمتهن الحديث لذي الصبا % % وتحصن الأسرار والأسرار % 7(@)(@@) % إذ في القتادة وهي أبخل أيكة % ثمر وإذ عود الزمان نضار % 8(@)(@@) % قد صرحت عن محضها الأخبار % واستبشرت بفتوحك الأمصار % 9(@)(@@) % خبر جلا صدأ القلوب ضياؤه % إذ لاح أن الصدق منه نهار % 10(@)(@@) % لولا جلاد أبي سعيد لم يزل % للثغر صدر ما عليه صدار % PageV01P450 11(@)(@@) % قدت الجياد كأنهن أجادل % بقرى درولية لها أوكار % 12(@)(@@) % حتى التوى من نقع قسطلها على % % حيطان قسطنطينة الإعصار % 13(@)(@@) % أوقدت من دون الخليج لأهلها % % نارا لها خلف الخليج شرار % 14(@)(@@) % إلا تكن حصرت فقد أضحى لها % % من خوف قارعة الحصار حصار % 15(@)(@@) % لو طاوعتك الخيل لم تقفل بها % % والقفل فيه شبا 
ms135	 ولا مسمار % 16(@)(@@) % لما لقوك تواكلوك وأعذروا % % هربا ، فلم ينفعهم الإعذار % 17(@)(@@) % فهناك نار وغى تشب وهاهنا % % جيش له لجب وثم مغار % 18(@)(@@) % خشعوا لصولتك التي هي عندهم % % كالموت يأتي ليس فيه عار % 19(@)(@@) % لما فصلت من الدروب إليهم % بعرمرم للأرض منه خوار % 20(@)(@@) % إن يبتكر ترشده أعلام الصوى % % أو يسر ليلا فالنجوم منار % PageV01P451 21(@)(@@) % فالحمة البيضاء ميعاد لهم % والقفل حتم والخليج شعار % 22(@)(@@) % علموا بأن الغزو كان كمثله % غزوا وأن الغزو منك بوار % 23(@)(@@) % فالمشي همس والنداء إشارة % خوف انتقامك والحديث سرار % 24(@)(@@) % إلا تنل منويل أطراف القنا % % أو تثن عنه البيض وهي حرار % 25(@)(@@) % فلقد تمنى أن كل مدينة % جبل أصم وكل حصن غار % 26(@)(@@) % إلا تفر فقد أقمت وقد رأت % عيناك قدر الحرب كيف تفار % 27(@)(@@) % في حيث تستمع الهرير إذا علا % % وترى عجاج الموت حين يثار % 28(@)(@@) % فانظر بعين شجاعة فلتعلمن % أن المقام بحيث فرار % 29(@)(@@) % لما أتتك فلولهم أمددتهم % % بسوابق العبرات وهي غزار % 30(@)(@@) % وضربت أمثال الذليل وقد ترى % % أن غير ذاك النقص والإمرار % PageV01P452 31(@)(@@) % الصبر أجمل والقضاء مسلط % فارضوا به والشر فيه خيار % 32(@)(@@) % هيهات جاذبك الأعنة باسل % يعطي الأسنة كل ما تختار % 33(@)(@@) % فمضى لو أن النار دونك خاضها % % بالسيف إلا أن تكون النار % 34(@)(@@) % حتى يؤوب الحق وهو المشتفي % % منكم وما للدين فيكم ثار % 35(@)(@@) % لله در أبي سعيد إنه % للضيف محض ليس فيه سمار % 36(@)(@@) % لما حللت الثغر أصبح عاليا % للروم من ذاك الجوار جوار % 37(@)(@@) % واستيقنوا إذ جاش بحرك وارتقى % % ذاك الزئير وعز ذاك الزار % 38(@)(@@) % أن لست نعم الجار للسنن الأولى % % إلا إذا ما كنت بئس الجار % 39(@)(@@) % يقظ يخاف المشركون شذاته % متواضع يعنو له الجبار % 40(@)(@@) % ذلل ركائبه إذا ما استأخرت % أسفاره فهمومه أسفار % PageV01P453 41(@)(@@) % يسري إذا سرت الهموم كأنه % نجم الدجى ويغير حين يغار % 42(@)(@@) % سمقت به أعراقه في معشر % قطب الوغى نصب لهم ودوار % 43(@)(@@) % لا يأسفون إذا هم سمنت لهم % أحسابهم أن تهزل الأعمار % 44 
ms136	(@)(@@) % متبهم في غرسه أنصاره % % عند النزال كأنهم أنصار % 45(@)(@@) % لفظ لأخلاق التجار وإنهم % لغدا بما ادخروا له لتجار % 46(@)(@@) % ومجربون سقاهم من بأسه % فإذا لقوا فكأنهم أغمار % 47(@)(@@) % عكف بجذل للطعان لقاؤه % خطر إذا خطر القنا الخطار % 48(@)(@@) % والبيض تعلم أن دينا لم يضع % مذ سلهن ولا أضيع ذمار % 49(@)(@@) % وإذا القسي العوج طارت نبلها % % سوم الجراد يسيح حين يطار % 50(@)(@@) % ضمنت له أعجاسها وتكفلت % أوتارها أن تنقض الأوتار % PageV01P454 51(@)(@@) % فدعوا الطريق بني الطريق لعالم % أنى يقاد الجحفل الجرار % 52(@)(@@) % لو أن أيديكم طوال قصرت % عنه فكيف تكون وهي قصار % 53(@)(@@) % هو كوكب الإسلام أية ظلمة % يخرق فمخ الكفر فيها رار % 54(@)(@@) % غادرت أرضهم بخيلك في الوغى % % وكأن أمنعها لها مضمار % 55(@)(@@) % وأقمت فيها وادعا متمهلا % حتى ظننا أنها لك دار % 56(@)(@@) % بالملك عنك رضا وجابر عظمه % أرض وبالدنيا عليك قرار % 57(@)(@@) % وأرى الرياض حواملا ومطافلا % مذ كنت فيها والسحاب عشار % 58(@)(@@) % أيامنا مصقولة أطرافها % % بك والليالي كلها أسحار % 59(@)(@@) % تندى عفاتك للعفاة وتغتدي % % رفقا إلى زوارك الزوار % 60(@)(@@) % هممي معلقة عليك رقابها % % مغلولة إن الوفاء إسار % PageV01P455 61(@)(@@) % ومودتي لك لا تعار بلى إذا % % ما كان تامور الفؤاد يعار % 62(@)(@@) % والناس غيرك ما تغير حبوتي % % لفراقهم هل أنجدوا أو غاروا % % 63(@)(@@) % ولذاك شعري فيك قد سمعوا به % سحر وأشعاري لهم أشعار % 64(@)(@@) % فاسلم ولا ينفك يحظوك الردى % % فينا وتسقط دونك الأقدار % PageV01P456 البحر : وافر تام 1(@)(@@) % أعيدي النوح معولة أعيدي % % وزيدي من بكائك ثم زيدي % % 2(@)(@@) % وقومي حاسرا في حاسرات % % خوامش للنحور وللخدود % 3(@)(@@) % هو الخطب الذي ابتدع الرزايا % % وقال لأعين الثقلين جودي % % 4(@)(@@) % ألا رزئت خراسان فتاها % % غداة ثوى عمير بن الوليد % 5(@)(@@) % ألا رزئت بمسؤول منيل % % ألا رزئت بمتلاف مفيد % 6(@)(@@) % ألا إن الندى والجود حلا % % بحيث حللت من حفر الصعيد % 7(@)(@@) % بنفسي أنت من ملك رمته % % منيته بسهم ردى سديد % 8(@)(@@) % تجلت غمرة الهيجاء عنه % % خضيب الوجه من دمه الجسيد % 9(@)(@@) % فيا بحر المنون ذهبت منه % % ببحر الجود 
ms137	 في السنة الصلود % 10(@)(@@) % ويا أسد المنون فرست منه % % غداة فرسته أسد الأسود % PageV01P457 11(@)(@@) % أبالبطل النجيد فرست منه % % نعم وبقاتل البطل النجيد % 12(@)(@@) % ترآى للطعان وقد تراءت % وجوه الموت من حمر وسود % 13(@)(@@) % فلم يكن المقنع فيه رأسا % خلا أن قد تقنع بالحديد % 14(@)(@@) % فيا لك وقعة جللا أعارت % أسى وصبابة جلد الجليد % 15(@)(@@) % ويا لك ساحة أهدت غليلا % إلى أكبادنا أبد الأبيد % 16(@)(@@) % وإن أميرنا لم يأل نصحا % وعدلا فيالرعايا والجنود % 17(@)(@@) % أفاض نوال راحته لديهم % وسامح بالطريف وبالتليد % 18(@)(@@) % وأصحر دونهم للموت حتى % % سقاه الموت من مقر هبيد % 19(@)(@@) % وما ظفروا به حتى قراهم % قشاعم أنسر وضباع بيد % 20(@)(@@) % بطعن في نحورهم مريد % وضرب في رؤوسهم عنيد % PageV01P458 21(@)(@@) % فيا يوم الثلثاء اصطبحنا % % غداة منك هائلة الورود % 22(@)(@@) % ويايوم الثلثاء اعتمدنا % % بفقد فيك للسند العميد % 23(@)(@@) % فكم أسخنت منا من عيون % وكم أعثرت فينا من جدود % 24(@)(@@) % فما زجرت طيورك عن سنيح % ولا طلعت نجومك بالسعود % 25(@)(@@) % ألا يا أيها الملك المردى % % رداء الموت في جدث خديد % 26(@)(@@) % حضرت فناء بابك فاعتراني % % شجى بين المخنق والوريد % 27(@)(@@) % رأيت به مطايا مهملات % وأفراسا صوافن بالوصيد % 28(@)(@@) % وكن عتاد إما فك عان % وإما قتل طاغية عنود % 29(@)(@@) % رأيت مؤمليك غدت عليهم % عواد أصعدتهم في كؤود % 30(@)(@@) % وأضحت عند غيرك في هبوط % حظوظ كن عندك في صعود % PageV01P459 31(@)(@@) % وكلهم أعد إلياس وقفا % عليك ونص راحلة القعود % 32(@)(@@) % واصبحت الوفود إليك وقفا % على ألا مفاد لمستفيد % 33(@)(@@) % لقد سخنت عيون الجود لما % % نويت وأقصدت غرر القصيد % PageV01P460 البحر : سريع 1(@)(@@) % لا آكل التفاح دهري ولو % % جنيته لي من جنان الخلود % 2(@)(@@) % و الله لا أتركه للقلى % % لكنني أتركه للخدود % PageV01P461 البحر : سريع 1(@)(@@) % يامن به يفتخر الفخر % ومن به يبتهج الشعر % 2(@)(@@) % ماطلبي للإذن أن شاقني % % شمس من الإنس ولا بدر % 3(@)(@@) % بلى كتاب أخرس ناطق % أنطق منه طيه النشر % 4(@)(@@) % فانتشرت حين بدا طيه % سرائر يكتمها الجهر % 5(@)(@@) % جاء نذير الحزن في بطنه % بحادث 
ms138	 أظهره الظهر % 6(@)(@@) % فانهل في أسطره أسطر % للدمع سطر فوقه سطر % 7(@)(@@) % فمن بالإذن على نازح % عن أهله ساعته دهر % 8(@)(@@) % فقد صدقت الظن في كل ما % % رجوته إذ كذب القطر % PageV01P462 البحر : كامل تام 1(@)(@@) % يادهر قدك وقلما يغني قدي % % وأراك عشر الظمء مر المورد % 2(@)(@@) % ولقد أحيط بنا ولم نك صورة % % بك واستعد لنا ولما نولد % 3(@)(@@) % يادهر أية زهرة للمجد لم % % تجفف وأية أيكة لم تخضد ! % 4(@)(@@) % أترعت للعنقاء في أشعافها % % كأسا تدفق بالذعاف الأسود % 5(@)(@@) % قد كان قرم كاسمه قرما وما % % ولدت نساء بني أبيه كأحمد % 6(@)(@@) % نجما هدى هذاك نجم الجدي إن % حار الدليل وذاك نجم الفرقد % 7(@)(@@) % هذا سنان زاغبي في الوغى % % وكأنما هذا ذباب مهند % 8(@)(@@) % وجبين هذا كالشهاب جلا الدجى % % عنه وهذا كالشهاب الموقد % 9(@)(@@) % ولنعم درعا الحي في يوميهما % % كانا ونعم الذخر كانا للغد % 10(@)(@@) % لم يشهدا نجوى ولاحشا لظى % % حرب تسعر بالقنا المتقصد % PageV01P463 11(@)(@@) % إلا رأينا ذا على تلك الرحا % % قطبا وذا مصباح ذاك المشهد % 12(@)(@@) % رزئت بنو عمرو بن عامر الذرى % % بهما وصوح نبت واديها الندى % % 13(@)(@@) % وكذا المنايا ما يطأن بمسيم % إلا على أعناق أهل السؤدد % 14(@)(@@) % ولئن أصيبوا إن تلك لغيضة % لم تخل من ليث هنالك ملبد % 15(@)(@@) % ما دام ذاك المعدن الزاكي الثرى % % في جزعنا لم نلتفت للعسجد % 16(@)(@@) % تلك المصائب مشويات كلها % % إلا مصيبة حجوة بن محمد % 17(@)(@@) % ولقد أصاب غليلها من لم يصب % ولصيرت فقدا لمن لم يفقد % 18(@)(@@) % طامن حشاك أبا الحباب فإنها % % نوب تروح على الأنام وتغتدي % % 19(@)(@@) % فلقد أفاق متمم عن مالك % وسلا لبيد قبله عن أربد % 20(@)(@@) % فلئن صبرت لأنت كوكب معشر % صبروا وإن تجزع فغير مفند % PageV01P464 21(@)(@@) % هذي المعونة باللسان ولو أرى % % عين الحمام لقد أعنتك باليد % PageV01P465 البحر : كامل تام 1(@)(@@) % غطت يداك علي في لحدي % % وبقيت ما مد المدى بعدي % % 2(@)(@@) % ورزقت منك العطف ما حملت % عيني الدموع ودام لي وجدي % % 3(@)(@@) % نفسي بكتماني معلقة % بين النوى ومخافة الصد 
ms139	 % PageV01P466 البحر : بسيط تام 1(@)(@@) % يا هذه أقصري ما هذه بشر % ولا الخرائد من أترابها الأخر % 2(@)(@@) % خرجن في خضرة كالروض ليس لها % % إلا الحلي على أعناقها زهر % 3(@)(@@) % بدرة حفها من حولها درر % أرضى غرامي فيها دمعي الدرر % 4(@)(@@) % ريم أبت أن يريم الحزن لي جلدا % والعين عين بماء الشوق تبتدر % 5(@)(@@) % صب الشباب عليها وهو مقتبل % ماء من الحسن ما في صفوه كدر % 6(@)(@@) % لولا العيون وتفاح الخدود إذا % ما كان يحسد أعمى من له بصر % 7(@)(@@) % حييت من طلل لم تبق لي طللا % إلا وفيه أسى ترشيحه الذكر % 8(@)(@@) % قالوا أتبكي على رسم فقلت لهم : % من فاته العين هدى شوقه الأثر % 9(@)(@@) % إن الكرام كثير في البلاد وإن % قلوا كما غيرهم قل وإن كثروا % % 10(@)(@@) % لا يدهمنك من دهمائهم عدد % فإن جلهم بل كلهم بقر % PageV01P467 11(@)(@@) % وكلما أمست الأخطار بينهم % هلكى تبين من أمسى له خطر % 12(@)(@@) % لو لم تصادف شيات البهم أكثر ما % % في الخيل لم تحمد الأوضاح والغرر % 13(@)(@@) % نعم الفتى عمر في كل نائبة % نابت وقلت له ' نعم الفتى عمر % 14(@)(@@) % يعطي ويحمد من يأتيه يحمده % % فشكره عوض وماله هدر % 15(@)(@@) % مجرد سيف رأي من عزيمته % % للدهر صيقله الإطراق والفكر % 16(@)(@@) % عضبا إذا سله في وجه نائبة % جاءت إليه بنات الدهر تعتذر % 17(@)(@@) % وسائل عن أبي حفص فقلت له % % أمسك عنانك عه إنه القدر % 18(@)(@@) % هو الهمام هو الصاب المريح هو ال % حتف الوحي هو الصمصامة الذكر % 19(@)(@@) % فتى تراه فتنفي العسر غرته % % يمنا وينبع من أسرارها اليسر % 20(@)(@@) % فدى له مقشعر حين تسأله % خوف السؤال كأن في جلده وبر % PageV01P468 21(@)(@@) % أنى ترى عاطلا منحلي مكرم ة % % وكل يوم ترى في مالك الغير ! % 22(@)(@@) % لله در بني عبد العزيز فكم % أردوا عزيز عدى في خده صعر % % 23(@)(@@) % % حتى لقد ظن قوم أنها سور % 24(@)(@@) % يا ليت شعري من هاتا مآثره % ماذا الذي ببلوغ النجم ينتظر % 25(@)(@@) % بالشعر طول إذا اصطكت قصائده % في معشر وبه عن 
ms140	 معشر قصر % 26(@)(@@) % سافر بطرفك في أقصى مكارمنا % % إن لم يكن لك في تأسيسها سفر % 27(@)(@@) % هل أورق المجد إلا في بني أدد % % 28(@)(@@) % لولا أحاديث بقتها مآثرنا % % من الندى والردى لم يعجب السمر % PageV01P469 البحر : طويل 1(@)(@@) % لا يشمت الأعداء بالموت إننا % % سنخلي لهم من عرضة الموت موردا % 2(@)(@@) % ولا تحسبن الموت عارا فإننا % % رأينا المنايا قد أصبن محمدا % % 3(@)(@@) % ولا يحسب الأعداء أن مصيبتي % % أكلت لهم مني لسانا ولا يدا % % 4(@)(@@) % تتابع في عام بني وإخوتي % % فأصبحت إن لم يخلف الله واحدا % % PageV01P470 البحر : كامل تام 1(@)(@@) % رقت حواشي الدهر فهي تمرمر % وغدا الثرى في حليه يتكسر % 2(@)(@@) % نزلت مقدمة المصيف حميدة % ويد الشتاء جديدة لا تكفر % 3(@)(@@) % لولا الذي غرس الشتاء بكفه % لاقى المصيف هشائما لاتثمر % 4(@)(@@) % كم ليلة آسى البلاد بنفسه % فيها ويوم وبله مثعنجر % 5(@)(@@) % مطر يذوب الصحو منه وبعده % % صحو يكاد من الغضارة يمطر % 6(@)(@@) % غيثان فالأنواء غيث ظاهر % لك وجهه والصحو غيث مضمر % 7(@)(@@) % وندى إذا ادهنت به لمم الثرى % % خلت السحاب أتاه وهو معذر % 8(@)(@@) % أربيعنا في تسع عشرة حجة % حقا لهنك للربيع الأزهر % 9(@)(@@) % ما كانت الأيام تسلب بهجة % لو أن حسن الروض كان يعمر % 10(@)(@@) % أولا ترى الأشياء إن هي غيرت % سمجت وحسن الأرض حين تغير % PageV01P471 11(@)(@@) % يا صاحبي تقصيا نظريكما % % تريا وجوه الأرض كيف تصور % 12(@)(@@) % تريا نهارا مشمسا قد شابه % زهر الربا فكأنما هو مقمر % 13(@)(@@) % دنيا معاش للورى حتى إذا % % جلي الربيع فإنما هي منظر % 14(@)(@@) % أضحت تصوغ بطونها لظهورها % % نورا تكاد له القلوب تنور % 15(@)(@@) % من كل زاهرة ترقرق بالندى % % فكأنها عين عليه تحدر % 16(@)(@@) % تبدو ويحجبها الجميم كأنها % % عذراء تبدو تارة وتخفر % 17(@)(@@) % حتى غدت وهداتها ونجادها % % فئتين في خلع الربيع تبختر % 18(@)(@@) % مصفرة محمرة فكأنها % % عصب تيمن في الوغا وتمضر % 19(@)(@@) % من فاقع غض النبات كأنه % در يشقق قبل ثم يزعفر % 20(@)(@@) % أو ساطع في حمرة فكأن ما % % يدنو إليه من الهواء معصفر % PageV01P472 21(@)(@@) % صنع الذي 