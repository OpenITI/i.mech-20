ms1252	 لبطن ) )(@)(@@) ( طب عد ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11025 ) قال النبي :(@)(@@) | 30 ( جرى القلم بالشقي والسعيد وفرغ من أربع : من الخلق والخلق والرزق والأجل ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الجيم مع الزاي ( ز )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11026 ) قال النبي :(@)(@@) | 30 ( جزاء الغني من الفقير النصيحة والدعاء ) )(@)(@@) ابن سعد PageV04P193 ( ع طب ) عن أم حكيم رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11027 ) قال النبي :(@)(@@) | 30 ( جزى الله الأنصار عنا خيرا ولا سيما عبد الله بن عمرو بن حرام وسعد بن عبادة ) )(@)(@@) ( ع حب ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11028 ) قال النبي :(@)(@@) | 30 ( جزى الله العنكبوت عنا خيرا فإنها نسجت علي في الغار ) )(@)(@@) أبو سعد السمان في مسلسلاته ( فر ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11029 ) قال النبي :(@)(@@) | 30 ( جزوا الشوارب وارخوا اللحى ، وخالفوا المجوس ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11030 ) قال النبي :(@)(@@) | 30 ( جزاك الله خيرا من سيد قوم فقد أنجزت الله ما وعدته ، ولينجزنك الله ما وعدك ) )(@)(@@) ابن سعد عن عبد الله بن شداد رضي الله عنه قال : دخل رسول الله على سعد بن معاذ رضي الله عنه وهو يكيد بنفسه فقال : فذكره .(@)(@@)(@@)(@@) $ ( 11031 ) قال النبي :(@)(@@) | 30 ( جزاكم الله يا معشر الأنصار خيرا فإنكم ما علمت أعفة صبر ) )(@)(@@) ( طب ) عن أنس عن أبي طلحة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11032 ) قال النبي :(@)(@@) | 30 ( جزاكم الله عني من عصابة شرا ، فقد خونتموني أمينا ، وكذبتموني صادقا ، ثم التفت إلى أبي جهل فقال : هاذا أعتى على الله من فرعون ، إن فرعون لما أيقن بالهلكة وحد الله ، وإن هاذا لما أيقن بالموت دعا باللات والعزى ) )(@)(@@) ( طب خط كر ) عن ابن عباس رضي الله عنهما قال : وقف النبي على قتلى بدر وقال : فذكره .(@)(@@) PageV04P194(@)(@@)(@@)(@@) ||| ( الجيم مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11033 ) قال النبي :(@)(@@) | 30 ( جعل الخير كله في الربعة ) )(@)(@@) ابن لال عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11034 ) قال النبي :(@)(@@) | 30 ( جعل الله الأهلة مواقيت للناس ، فصوموا لرؤيته 
ms1253	 وأفطروا لرؤيته ، فإن غم عليكم فعدوا ثلاثين يوما ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11035 ) قال النبي :(@)(@@) | 30 ( جعل الله التقوى زادك ، وغفر ذنبك ، ووجهك للخير حيثما تكون ) )(@)(@@) ( طب ) عن قتادة بن عياش رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11036 ) قال النبي :(@)(@@) | 30 ( جعل الله الحسنة بعشرة أمثالها : الشهر بعشرة أشهر ، وصيام ستة أيام بعد الشهر تمام السنة ) )(@)(@@) أبو الشيخ في الثواب عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11037 ) قال النبي :(@)(@@) | 30 ( جعل الله الرحمة مائة جزء فأمسك عنده تسعة وتسعين جزءا وأنزل في الأرض جزءا واحدا فمن ذالك الجزء يتراحم الخلق حتى ترفع الفرس حافرها عن ولدها خشية أن تصيبه ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11038 ) قال النبي :(@)(@@) | 30 ( جعل الله عذاب هاذه الأمة في دنياها ) )(@)(@@) ( طب ) عن عبد الله بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11039 ) قال النبي :(@)(@@) | 30 ( جعل الله عليكم صلاة قوم أبرار ، يقومون الليل ويصومون النهار ، ليسوا بأئمة ولا فجار ) )(@)(@@) . عبد بن حميد والضياء عن أنس رضي الله عنه .(@)(@@) PageV04P195(@)(@@)(@@)(@@) $ ( 11040 ) قال النبي :(@)(@@) | 30 ( جعلت قرة عيني في الصلاة ) )(@)(@@) ( طب ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11041 ) قال النبي :(@)(@@) | 30 ( جعلت لي الأرض مسجدا وطهورا ) )(@)(@@) ( ه ) عن أبي هريرة ( د ) عن أبي ذر رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11042 ) قال النبي :(@)(@@) | 30 ( جعلت لي كل أرض طيبة مسجدا وطهورا ) )(@)(@@) ( حم ) و الضياء عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11043 ) قال النبي :(@)(@@) | 30 ( جعفر أشبه خلقي وخلقي ، وأما أنت يا عبد الله فأشبه خلق الله بأبيك ) )(@)(@@) ( كر ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11044 ) قال النبي :(@)(@@) | 30 ( جعل جبريل يدس الطين في فم فرعون مخافة أن يقول لا إلاه إلا الله ) ( ك ) عن ا$ بن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11045 ) قال النبي :(@)(@@) | 30 ( جعل لكم ثلث أموالكم زيادة في أعمالكم ) ( عب ) عن س$ ليمان بن موسى مرسلا .(@)(@@)(@@)(@@) $ ( 11046 ) قال النبي :(@)(@@) | 30 ( جعلت لله ندا بل ما شاء الله وحده ) ( طب ) و ال| شيرازي في الألقاب عن ابن 
ms1254	 عباس رضي الله عنهما قال : قال رجل للنبي ما شاء وشئت ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 11047 ) قال النبي :(@)(@@) | 30 ( جعلتني لله عدلا بل ما شاء الله وحده ) ( طب خط ) عن ع$ بد الله بن يزيد الأنصاري رضي الله عنه .(@)(@@) PageV04P196(@)(@@)(@@)(@@) ||| ( الجيم مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11048 ) قال النبي :(@)(@@) | 30 ( جلساء الله غدا أهل الورع والزهد في الدنيا ) )(@)(@@) ابن لال عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11049 ) قال النبي :(@)(@@) | 30 ( جلوس الإمام بين الأذان والإقامة في المغرب من السنة ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11050 ) قال النبي :(@)(@@) | 30 ( جلود الميتة دباغه يذهب بخبثه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الجيم مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11051 ) قال النبي :(@)(@@) | 30 ( جمال الرجل فصاحة لسانه ) )(@)(@@) القضاعي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11052 ) قال النبي :(@)(@@) | 30 ( جمرة بين كتفيك تقلدتها ) )(@)(@@) ( طب ك هق ) عن عبادة بن الصامت قال : أقرأت رجلا فأهدى لي قوسا فقال النبي فذكره .(@)(@@) PageV04P197(@)(@@)(@@)(@@) $ ( 11053 ) قال النبي :(@)(@@) | 30 ( جمرة عظيمة عليه ) )(@)(@@) ( حم ) عن يعلى بن مرة أن رسول الله رأى رجلا عليه خاتم من ذهب قال : فذكره .(@)(@@)(@@)(@@) $ ( 11054 ) قال النبي :(@)(@@) | 30 ( جمروا كفن الميت ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11055 ) قال النبي :(@)(@@) | 30 ( جمل أزهر يأكل من أطراف الشجر ) )(@)(@@) ( عق خط ) عن أبي هريرة رضي الله عنه قال : قيل : يا رسول الله ما تقول في بني عامر ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 11056 ) قال النبي :(@)(@@) | 30 ( جمع بين الصلاتين من غير عذر من الكبائر ) )(@)(@@) ( هق ) وضعفه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11057 ) قال النبي :(@)(@@) | 30 ( جميع أعمال بني آدم يحضرها الملائكة الكرام الكاتبون الأخيار المجاهدون في سبيل الله تعالى ، فإن الملائكة الذين خلقهم الله عز وجل يعجزون عن علم إحصاء حسنات أدناهم ) )(@)(@@) أبو الشيخ في الثواب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الجيم مع النون(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11058 ) قال النبي :(@)(@@) | 30 ( جنان الفردوس أربع : جنتان من ذهب حليتهما وآنيتهما وما فيهما 
ms1255	 ، وجنتان من فضة حليتهما وآنيتهما وما فيهما ، وما بين القوم وبين أن ينظروا إلى ربهم إلا رداء الكبرياء على وجهه في جنة عدن ، وهاذه الأنهار تشخب PageV04P198 من جنة عدن ثم تصدع بعد ذالك أنهارا ) )(@)(@@) ( حم طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11059 ) قال النبي :(@)(@@) | 30 ( جنبوا مساجدنا صبيانكم ومجانينكم وشراءكم وبيعكم وخصوماتكم ورفع أصواتكم وإقامة حدودكم وسل سيوفكم ، واتخذوا على أبوابها المطاهر وجمروها في الجمع ) )(@)(@@) ( ه ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11060 ) قال النبي :(@)(@@) | 30 ( جنة الفردوس هي ربوة الجنة العليا التي هي أوسطها وأحسنها ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 11061 ) قال النبي :(@)(@@) | 30 ( جنتان من فضة آنيتهما وما فيهما ، وجنتان من ذهب آنيتهما وما فيهما ، وما بين القوم وبين أن ينظروا إلى ربهم إلا رداء الكبرياء على وجهه في جنة عدن ) )(@)(@@) ( ق ت ن ه ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11062 ) قال النبي :(@)(@@) | 30 ( جنبوا مساجدكم صبيانكم ومجانينكم وسل سيوفكم ، وإقامة حدودكم ، ورفع أصواتكم ، وخصوماتكم ، واجمروها في الجمع ، واجعلوها على أبوابها المطاهر ) )(@)(@@) ( عد طب هق كر ) عن مكحول عن واثلة وأبي الدرداء وأبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11063 ) قال النبي :(@)(@@) | 30 ( جنبوا صناعكم مساجدكم ) )(@)(@@) الديلمي عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11064 ) قال النبي :(@)(@@) | 30 ( جنبوا مساجدكم الصبيان والمجانين ) )(@)(@@) ( عب ) عن أبي هريرة وعن مكحول مرسلا .(@)(@@)(@@)(@@) $ ( 11065 ) قال النبي :(@)(@@) | 30 ( جنبوا مساجدكم مجانينكم وصبيانكم ، ورفع أصواتكم ، وسل سيوفكم ، وبيعكم وشراءكم ، وإقامة حدودكم ، وخصوماتكم ، PageV04P199 وجمروها يوم جمعكم ، واجعلوا مطاهركم على أبوابها ) )(@)(@@) ( طب ) عن مكحول عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11066 ) قال النبي :(@)(@@) | 30 ( جن نصيبين جاءوني يختصمون إلي في أمور كانت بينهم وقد سألوني الزاد فزودتهم الرجعة وما وجدوا من روث وجدوه شعيرا ، وما وجدوا من عظم وجدوه كاسيا ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11067 ) قال النبي :(@)(@@) | 30 ( جندب وما جندب والأقطع الخير زيد أما جندب فيضرب ضربة يكون فيها أمة وحده ، وأما زيد فتدخل يده الجنة قبل 
ms1256	 بدنه ببرهة ) )(@)(@@) ابن السكن وابن منده ( كر ) عن عبد الله بن بريدة ، عن أبيه .(@)(@@)(@@)(@@) $ ( 11068 ) قال النبي :(@)(@@) | 30 ( جندب وما جندب زيد الخير وما زيد الخير ، أما أحدهما فيضرب ضربة يفرق بين الحق والباطل ، وأما الآخر فيسبقه عضو من أعضائه إلى الجنة ، ثم يتبعه سائر جسده ) )(@)(@@) . ( كر ) عن علي وعن ابن عباس وعن ابن عمر بن سعد رضي الله عنه عن عبيد بن لاحق .(@)(@@)(@@)(@@) ||| ( الجيم مع الهاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 11069 ) قال النبي :(@)(@@) | 30 ( جهاد الكبير والصغير والضعيف والمرأة : الحج والعمرة ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11070 ) قال النبي :(@)(@@) | 30 ( جهادكن الحج ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها ( ز ) .(@)(@@) PageV04P200(@)(@@)(@@)(@@) $ ( 11071 ) قال النبي :(@)(@@) | 30 ( جهد البلاء إن تحتاجوا إلى ما في أيدي الناس فتمنعوا ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11072 ) قال النبي :(@)(@@) | 30 ( جهد البلاء قلة الصبر ) )(@)(@@) أبو عثمان الصابوني في المائتين ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11073 ) قال النبي :(@)(@@) | 30 ( جهد البلاء كثرة العيال مع قلة الشيء ) )(@)(@@) ( ك ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 11074 ) قال النبي :(@)(@@) | 30 ( جهنم تحيط بالدنيا ، والجنة من ورائها ، فلذالك صار الصراط على جهنم طريقا إلى الجنة ) )(@)(@@) ( خط فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11075 ) قال النبي :(@)(@@) | 30 ( جهادكن الحج المبور هو لكن جهاد ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 11076 ) قال النبي :(@)(@@) | 30 ( جهزوا صاحبكم فإن الفرق فلك كبده ) )(@)(@@) . ( ابن أبي الدنيا في الخوف ) ( ك هب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11077 ) قال النبي :(@)(@@) | 30 ( جهينة مني وأنا منهم ، غضبوا لغضبي ورضوا لرضاي ، أغضب لغضبهم وأرضى لرضاهم ، من أغضبهم فقد أغضبني ، ومن أغضبني فقد أغضب الله ) )(@)(@@) . ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@) PageV04P201(@)(@@)(@@)(@@) ||| ( الجيم مع الواو(@)(@@)(