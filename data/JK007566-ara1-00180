ms161	 % % 18(@)(@@) % وأضحت الأرض في رحب الملا لججا % % سالت عليهم ببيض الهند والأسل % % 19(@)(@@) % والأسد بارقة الألحاظ في أجم % % من القنا بحبيك البيض مشتعل % % 20(@)(@@) % رقت غلائلهم سردا كأنهم % % تسربلوا لبس رقراق من الغلل % % PageV01P497 21(@)(@@) % والصافنات تهادى في أعنتها % % كالغيد يرفلن بين الحلي والحلل % % 22(@)(@@) % وخافقات كأمثال الحشا خفقت % % روعاتها خطرات الذعر والوجل % % 23(@)(@@) % تزينت بسكون الجأش ثابتة % % واستشعرت هفوات الطائش الوجل % % 24(@)(@@) % حتى انتهى يدك العليا وقد قسمت % % أحشاؤه بين أيدي الريث والعجل % % 25(@)(@@) % إذا ونت بخطاه هيبة حكمت % % عليه ثار به مستعذب الأمل % % 26(@)(@@) % فوافق البحر والآفاق تكنفه % % من الرياح ووافى الشمس في الحمل % % 27(@)(@@) % وقابل المجد والإعظام في ملك % % بالسعد مستقبل للسعد مقتبل % % 28(@)(@@) % متوج ببهاء الملك معتصب % % ومحتب في رداء العز مشتمل % % 29(@)(@@) % بالجود مغتبق بالحمد مصطبح % % في السبق منقطع بالحلم متصل % % 30(@)(@@) % لله يوم من الأيام فزت به % % فردا من المثل فيها سائر المثل % % PageV01P498 31(@)(@@) % من بعد ما وعظته الحادثات بمن % % أردت سيوفك من أشياعه الأول % % 32(@)(@@) % وكم تأسف منهم في معاهد قد % % آلت معاهد للأحزان والهبل % % 33(@)(@@) % وأخضل الدمع من أجفان مقلته % % مجاله في نجيع منهم خضل % % 34(@)(@@) % فلتهنك الرتب العليا التي قصرت % % عنهن سامية البرجيس أو زحل % % 35(@)(@@) % فاسلم ولا زال عز الملك متصلا % % من يعرب وبنيه حيث لم يزل % % 36(@)(@@) % في خفض عيش وملك غير منفصم % % وظل عز وأمن غير منتقل % % PageV01P499 البحر : كامل تام 1(@)(@@) % كفي شئونك ساعة فتأملي % % في ليلها بشرى الصباح المقبل % % 2(@)(@@) % وتنجزي وعد المشارق وانظري % % واستخبري زهر الكواكب واسألي % % 3(@)(@@) % فلعل غايات الدجى أن تنتهي % % وعسى غيايات الأسى أن تنجلي % % 4(@)(@@) % لا تخدعي بدموع عينك في الورى % % قلبا يعز عليه أن تتذللي % % 5(@)(@@) % وتجملي لشجا النوى لا تمكني % % أيدي الصبابة من عنان تجملي % % 6(@)(@@) % لا تحذلي بالعجز عزمي بعدما % % شافهت أعجاز النجوم الأفل % % 7(@)(@@) % فليسعدن الحزم إن لم تسعدي % % وليفعلن الجد إن لم تفعلي % % 8(@)(@@) % ولأعسفن الليل غير مشيع % % ولأركبن الهول غير مذلل % % 9(@)(@@) % ولأسطون على الزمان بعزمتي % % ولأنحين 
ms162	 على الخطوب بكلكلي % % 10(@)(@@) % ولأرمين مقاتل النوب التي % % ولعت مع المتخلفين بمقتلي % % PageV01P500 11(@)(@@) % فإذا رأيت النجم يبدي أفقه % % منه بقية جمر نار المصطلي % % 12(@)(@@) % وتخلف العيوق فهو كأنه % % سار تضلل في فضاء مجهل % % 13(@)(@@) % وتعرض الدبران بين كواكب % % مزق كسرب قطا ذعرن بأجدل % % 14(@)(@@) % وكواكب الجوزاء تهوي جنحا % % مثل الخوامس قد عدلن لمنهل % % 15(@)(@@) % وكأنما الشعرى سراج توقد % % وقف على طرق النجوم الضلل % % 16(@)(@@) % وكأن ملتزم الفراقد قطبها % % ركب على عرفان دائر منزل % % 17(@)(@@) % وتحولت أم النجوم كأنها % % زهر تراكم فوق مجرى جدول % % 18(@)(@@) % ورأيت جنح الليل ناط رواقه % % من كل أفق بالسماك الأعزل % % 19(@)(@@) % فهناك وافتك السعود طوالعا % % تقضي لصدق تيمن وتفاؤل % % 20(@)(@@) % فهي المنى فتيقني وهو السرور % % فأبشري وهو الصباح فأملي % % PageV01P501 21(@)(@@) % وتجرعي غصص التنائي واجمعي % % بين المطي وليلهن الأليل % % 22(@)(@@) % واستوطني وحش الفلاة ووطني % % نفسا لبرح تودع وترحل % % 23(@)(@@) % فلأعقدن عليك أكرم ذمة % % ولأبنين عليك أشيد معقل % % 24(@)(@@) % بعزائم لا تنثني وبصائر % % لا تنتهي ووسائل لا تأتلي % % 25(@)(@@) % حتى رأيت العيس وهي لواغب % % يشرعن في نهر الصباح الأول % % 26(@)(@@) % والفجر يرفع جفن طرف أدعج % % والليل يغضي جفن طرف أكحل % % 27(@)(@@) % فكأنما في الجو فارس أبلق % % يشتد في آثار فارس أشعل % % 28(@)(@@) % ولدي للمنصور شكر صنائع % % تنأى الركاب بعبئها المتحمل % % 29(@)(@@) % نشر ينم من الحقائب عرفه % % أرجا ويشرق من خلال الأرحل % % 30(@)(@@) % يهدي ثناء الممحلات إلى الحيا % % وثنا الرياض إلى الغمام المسبل % % PageV01P502 31(@)(@@) % بكرائم لم تمتهن وعقائل % % لم تمتثل ومصونة لم تبذل % % 32(@)(@@) % حملت بها أم العلوم وأرضعت % % من در أخلاف الربيع الحفل % % 33(@)(@@) % وكفيلة بالحمد تهديه إلى % % ملك بغايات المنى متكفل % % 34(@)(@@) % حتى تؤدي الحمد عند مسوف % % وتفي بعهد الشكر عند مؤجل % % 35(@)(@@) % وتنيخ ركب النازل المتوسل % % في ظل عفو المنعم المتفضل % % 36(@)(@@) % وتحط رحل المذنب المتنصل % % في ظل عقر العائد المتطول % % 37(@)(@@) % فلاسلمن إليه همة نازع % % وحبال منقطع وكف مؤمل % % 38(@)(@@) % ملك توسط من ذؤابة يعرب % % في الجوهر المتخير المتنخل % % 39(@)(@@) % بسقت به أعراق ملك أشرقت 
ms163	 % % بعلاه في شرف المحل المعتلي % % 40(@)(@@) % عن كل معدوم القرين مكرم % % ومعظم في المالكين مبجل % % PageV01P503 41(@)(@@) % وغمام عرف في الزمان الممحل % % وسراج نور في الكريهة مشعل % % 42(@)(@@) % يختال تاج الملك فوق جبينه % % لما تبوأ منه أكرم منزل % % 43(@)(@@) % فكأن صفحة وجهه شمس الضحى % % وصلت ببدر بالنجوم مكلل % % 44(@)(@@) % العائدون بكل فضل معجز % % والدافعون لكل خطب معضل % % 45(@)(@@) % ورثوا السيادة كابرا عن كابر % % واستوجبوها آخرا عن أول % % 46(@)(@@) % وتبوأوا دار النبوة والهدى % % صنعا وتفضيلا من الملك العلي % % 47(@)(@@) % فتخير الرحمن طيب ثراهم % % دارا وقبرا للنبي المرسل % % 48(@)(@@) % وتفردوا بالمكرمات وأحرزوا % % جزل الثناء من الكتاب المنزل % % 49(@)(@@) % هم انجبوك وقلدوك سيوفهم % % للنصر تبلي في الإله وتبتلي % % 50(@)(@@) % فضربت أشياع الضلال بعزمة % % عجلت إليهم بالحمام المعجل % % PageV01P504 51(@)(@@) % فأعدت أرضهم وليس لمعقل % % قصد وليس لمفلت من معقل % % 52(@)(@@) % بعزائم ومخائل أعيت على % % بأس الشجاع وحيلة المتحيل % % 53(@)(@@) % فتركت حزب الشرك بين مصرع % % ومعفر ومجدل ومرمل % % 54(@)(@@) % وثنيت حزب الدين بين مملك % % ومظفر ومغنم ومنفل % % 55(@)(@@) % فاسعد بعيد عاد وهو مبشر % % لك بالنعيم وبالبقاء الأطول % % 56(@)(@@) % وبمشهد للملك أعيا دونه % % فكر اللبيب ومقلة المتأمل % % 57(@)(@@) % أمتك أبصار الخلائق واصلي % % نور بتعجيل السرور الأعجل % % 58(@)(@@) % وتيمموك من المصلى فانثنوا % % ساعين بين مكبر ومهلل % % 59(@)(@@) % متزاحمين على يمين أصبحت % % مبسوطة لمؤمل ومقبل % % 60(@)(@@) % وتواضعت صيد الملوك مهابة % % يضعون أوجههم مكان الأرجل % % PageV01P505 61(@)(@@) % ورأوا هلال الملك فوق سريره % % بسنا المكارم والهدى المتهلل % % PageV01P506 البحر : كامل تام 1(@)(@@) % النصر حزبك في الضلالة فاحتكم % % واغضب لدين الله منها وانتقم % % 2(@)(@@) % قد وافق التوفيق سعيك مقدما % % فيها وقد عزم القضاء لما عزم % % 3(@)(@@) % فموارد النصر العزيز لها مدى % % وعوائد الفتح المبين لها أمم % % 4(@)(@@) % فلرب موقف ظافر لك في الوغى % % والخيل تعبس والبوارق تبتسم % % 5(@)(@@) % والشمس في كبد السماء كأنها % % والنقع يغشاها كمي ملتئم % % 6(@)(@@) % وكأنما كسف العجاج إذا التقت % % أسد الكماة سحائب مطرت بدم % % 7(@)(@@) % ثم اقتحمت الحرب في ضنك الوغى % % والموت في علق الجناجن يقتحم % % 8(@)(@@) % حتى انتهيت من العدى 
ms164	 أمد المنى % % ومن العلا أسنى الرغائب والقسم % % 9(@)(@@) % يا بن الألى لم تعص طاعة أمرهم % % عاد على أولى الزمان ولا إرم % % 10(@)(@@) % رفعوا رواق الملك في أرماحهم % % حتى استكان الدهر والدنيا لهم % % PageV01P507 11(@)(@@) % ولو انهم شاموا السيوف لأحرزوا % % ملك الخلائق بالخلائق والشيم % % 12(@)(@@) % ثم انتضوا دون الهدى أسيافهم % % قسرا فعز الدين والدنيا بهم % % 13(@)(@@) % لا نظم أشعاري ولا نثري ولا % % صحفي ولا جهد اللسان ولا القلم % % 14(@)(@@) % مما يقوم بنشر أيسر ما طوى % % صدري من الإخلاص فيك وما كتم % % 15(@)(@@) % وصلاتك اتصلت مع الأيام لي % % حتى عدمت بهن آثار العدم % % 16(@)(@@) % ورفعن ذكري في عبيدك فاعتلى % % ونظمن شملي في جوارك فانتظم % % 17(@)(@@) % وتبوأت بي من جنابك موطنا % % وقفا على كرم الوسائل والذمم % % 18(@)(@@) % فحططت رحلي منك في عز الحمى % % ومنعت أهلي منك في أهل الحرم % % 19(@)(@@) % وغدت تهادى بي إليك بصيرة % % دانت بما شرع الوفاء وما حكم % % 20(@)(@@) % حديث مطايانا بأهبة شاكر % % تزهى بأنعمك التي لا تكتتم % % PageV01P508 21(@)(@@) % ومن الذي يعتاد من شمس الضحى % % نورا ويهدأ في غيابات الظلم % % 22(@)(@@) % وبما يكيد العجز عنك عزيمة % % ألفت جناب العز منك فلم ترم % % 23(@)(@@) % وبما أقيم وقد حشدت محامدي % % لأقل جزء من نداك فلم تقم % % 24(@)(@@) % وأضن عنك ببذل نفس طالما % % سقيت بجود يديك أنداء الكرم % % 25(@)(@@) % ويروعني لفح الهجير إذا التقى % % وهجا وأنسى منك منهل الديم % % 26(@)(@@) % أمثبطي عنك الزمان إذن فلا % % نهضت إلى الظل المبارك لي قدم % % 27(@)(@@) % أأسر دونك بالحياة وكم يد % % لك بشرتني بالحياة وكم وكم % % 28(@)(@@) % أقريرة عيني بعيش لا أرى % % فيه سيوفك في عداتك تحتكم % % 29(@)(@@) % أمكلل وجهي ووجهك بارز % % لشبا الأسنة والهواجر تضطرم % % 30(@)(@@) % إني إذن لكفور أنعمك التي % % صرمت حبال الذل مني فانصرم % % PageV01P509 31(@)(@@) % لا والذي قادت إليك هباته % % ملك الملوك وصفو طاعات الأمم % % 32(@)(@@) % لا أقتدي بالخالفين ولا أرى % % أسعى لنيل رضاك في أدنى الهمم % % 33(@)(@@) % حتى تبين كيف أثمار الندى % % عندي وتبلو كيف شكري للنعم % % 34(@)(@@) % ويريك صدق مواردي ومصادري % % إبطال ما 
ms165	 اختلق الحسود وما زعم % % 35(@)(@@) % ولعل من يقضي الأمور يقيدني % % برضاك من صرف الزمان فأحتكم % % PageV01P510 البحر : كامل تام 1(@)(@@) % عادت عليك عوائد الأعوام % % في العز والإجلال والإعظام % % 2(@)(@@) % وعمرت هذا الملك منتهيا به % % أمد الدهور وغاية الأيام % % 3(@)(@@) % في صحة مصحوبة بتمام % % وسلامة موصولة بدوام % % 4(@)(@@) % وقهرت أشياع الضلال مؤيدا % % بنوافذ الأقدار والأحكام % % 5(@)(@@) % وبلغت حيث نوت لقصدك همة % % موصولة الإنجاد والإتهام % % 6(@)(@@) % متذلل لك عز كل ممنع % % متسهل لك صعب كل مرام % % 7(@)(@@) % حتى تبوأ بالمشارق طاعة % % مأمولة من معرق وشآمي % % 8(@)(@@) % وترد نائي الملك في أوطانه % % من عهد كل متوج فمقام % % 9(@)(@@) % وتنيخ رحل العز غير مدافع % % بمعاهد الأخوال والأعمام % % 10(@)(@@) % وتحل بالحرمين منك كتائب % % مأمونة الإحلال والإحرام % % PageV01P511 11(@)(@@) % فبك استعاذ الملك من سطو العدى % % وغدا بسيفك باهر الأعلام % % 12(@)(@@) % وبنور وجهك أشرقت سبل الهدى % % وانجاب عنها غيهب الإظلام % % 13(@)(@@) % وبجودك اتصلت أماني الورى % % بالنجح وانفصمت عرى الإعدام % % 14(@)(@@) % فليشكرن الدين أن أوليته % % عطف الشقيق وخلة الأرحام % % 15(@)(@@) % فصدعت عنه الجور صدعة ثائر % % ونظمت فيه العدل أي نظام % % 16(@)(@@) % فاسعد بأضعاف الجزاء وخذ به % % أوفى الحظوظ وأوفر الأقسام % % 17(@)(@@) % وليهنك الفوز الذي أحرزته % % نسكا بأزكى قربة وصيام % % 18(@)(@@) % وليهنك الفطر الذي استقبلته % % لهجا بغير تحية وسلام % % 19(@)(@@) % مستبشرا بالحاجب الندب الذي % % في برئه برء من الأسقام % % 20(@)(@@) % بدر المعالي شفه بعض الذي % % ما زال يلحق كل بدر ظلام % % PageV01P512 21(@)(@@) % وشكاة ضرغام جدير كرها % % من جسم ضرغام إلى ضرغام % % 22(@)(@@) % حميت جوانح صدره شوقا إلى % % لمع الأسنة في الهجير الحامي % % 23(@)(@@) % وشكا اعتلالا حين هام تذكرا % % نحو الطعان ونحو ضرب الهام % % 24(@)(@@) % وأنا الزعيم بأن عاجل برئه % % في قرع طبل أو صليل لجام % % 25(@)(@@) % أو لبس درع أو تهادي سابح % % أو مد رمح أو بريق حسام % % 26(@)(@@) % خواض أهوال الحروب مساور % % غلب الليوث مضعضع الآجام % % 27(@)(@@) % مستقبل بالنجح ممنوع الحمى % % ماضي الطعان مؤيد الإقدام % % 28(@)(@@) % أم العداة فصال صول حمام % % وسقى العفاة فصاب صوب غمام % % 29(@)(@@) % ولرب مبهمة الفروج 
ms166	 تمزقت % % غماؤها عن وجهه البسام % % 30(@)(@@) % حازت له الهمم السنية منزلا % % في الفخر أعجز خاطر الأوهام % % PageV01P513 31(@)(@@) % وتهللت منه المكارم والندى % % والبأس عن ملك أغر همام % % 32(@)(@@) % أعطى السيادة حقها حتى اغتدت % % منه الحجابة في المحل السامي % % 33(@)(@@) % وحوى عن المنصور غر شمائل % % قادت له الدنيا بغير زمام % % 34(@)(@@) % يا ربنا فاحفظ علينا منهما % % ذخر الرجاء وعدة الإسلام % % 35(@)(@@) % يا موسع الراجين إفضالا ويا % % مأوى الغريب وكافل الأيتام % % 36(@)(@@) % أعجز بجهدي أن يفي بالعهد من % % منن علي لراحتيك جسام % % 37(@)(@@) % فلأفخرن على الزمان وأهله % % بصلات جود من نداك كرام % % 38(@)(@@) % أصبحن لي دون اللئام وقاية % % وإلى علاك وسيلتي وذمامي % % 39(@)(@@) % والعدل في حكم المكارم والعلا % % أن يشفع الإنعام بالإنعام % % 40(@)(@@) % فلأشكرنك أو تجيء منيتي % % ولأرجونك أو يحم حمامي % % PageV01P514 41(@)(@@) % ولأصرمن علائق الأمل الذي % % يقتادني لسواك أي صرام % % PageV01P515 البحر : خفيف تام 1(@)(@@) % يا غياث العباد إن بخل المزن % % سقاهم وبلا وما استمطروه % % 2(@)(@@) % والذي أمن العباد ببيض % % مرهفات لقاؤهن كريه % % 3(@)(@@) % شهد الناس أمس ما لم يروه % % في الذي أدركوا ولا شهدوه % % 4(@)(@@) % قتل المشركون منا شهيدا % % فتمنوا بأنهم أنشروه % % 5(@)(@@) % سفكت بالدم الكريم دماء % % وكذا يوبق الحليم السفيه % % 6(@)(@@) % قتلوه مصفدا فودوه % % لو علا ظهر طرفه لم يدوه % % 7(@)(@@) % لقي الموت في الرصيف رجال % % كلهم في بني أبيه وجيه % % 8(@)(@@) % غادرتهم صوارم الهند والزرق % % حصيدا يا بؤس يوم لقوه % % 9(@)(@@) % ورأينا الوزير كالليث أنى % % غير هذا والعامري أبوه % % 10(@)(@@) % أيقنوا بالحمام لما رأوه % % مقبلا نحوهم وسيئت وجوه % % PageV01P516 11(@)(@@) % ورأيناه كالحسام مضاء % % فشهدنا أن الحسام أخوه % % 12(@)(@@) % زرق العلج زرقة تركته % % حرضا قد أظله المكروه % % 13(@)(@@) % مات ذعرا منه وكم لقي الأبطال في هبوة فما ذعروه % % 14(@)(@@) % ولكم أيما له وقتيلا % % صم عن أن يجيب من يدعوه % % 15(@)(@@) % وأسيرا مصفدا في وثاق % % وغياثا لطارق جف فوه % % 16(@)(@@) % ذاك حتى إذا اللقاء دعاه % % عاين الناس منه ما استعظموه % % 17(@)(@@) % أسدا ساقطا لزرقة شبل % % لو دروا حيث أوغلت عذروه % % 18(@)(@@) % وقفوا يذعرون منه 
ms167	 فلما % % عاينوا الفضل ماثلا أملوه % % 19(@)(@@) % وكذا العامري ما دام طفلا % % ولعمري لنعم ما شبهوه % % 20(@)(@@) % غصن ما يزال من دوحة المجد فروع كثيرة تغذوه % % PageV01P517 21(@)(@@) % فإذا جاز تسعة وثلاثا % % جل عن أن يحده تشبيه % % 22(@)(@@) % يا ثمال العفاة يا ملك الدنيا ومن فاز بالغنى آملوه % % 23(@)(@@) % قد حباني دهري بإدراك دهر % % ما به ناجه ولا منجوه % % 24(@)(@@) % لو حباني بذاك عصر شبابي % % لرآني على العباد أتيه % % 25(@)(@@) % ورجائي ما قد علمت وشكري % % وثنائي في الناس ما علموه % % 26(@)(@@) % غير أن الزمان ثقل ظهري % % فهو ثقل علي صعب كريه % % 27(@)(@@) % ولعمري مالي سوى الملك المنصور في الأرض سيد أرجوه % % PageV01P518 البحر : كامل تام 1(@)(@@) % طاعت لك الأحرار باستعبادها % % وأباحت الأملاك صعب قيادها % % 2(@)(@@) % فلأخمصيك اليوم حر وجوهها % % ولوطء خيلك أمس حر بلادها % % 3(@)(@@) % ما زلت تخطب بالظبى أرواحها % % حتى أتتك بهن في أجسادها % % 4(@)(@@) % وتحمل الخطي أرؤسها فقد % % جاءتك تحملها على أكتادها % % 5(@)(@@) % من بعدما قد رعتها بعزائم % % هدت لهن الشم من أطوادها % % 6(@)(@@) % وخلت متون الخيل من أبطاها % % ومرابض الآجام من آسادها % % 7(@)(@@) % ومشاهد البيعات من عمارها % % ومعالق الصلبان من عبادها % % 8(@)(@@) % حتى تلافت منك باستسلامه % % ما كان أعجزها بحر جلادها % % 9(@)(@@) % ورمى ابن شنج إليك نفس محكم % % نهج الخضوع لها سبيل رشادها % % 10(@)(@@) % مستعطفا لحشاشة من ملكه % % وثمالة قد آذنت بنفادها % % PageV01P519 11(@)(@@) % فاستنقذته منك عودة منعم % % قامت لمهجته مقام معادها % % 12(@)(@@) % وثنى نواجذه وفلذة كبده % % شفقا وناظر عينه وسوادها % % 13(@)(@@) % فسما يخوض إليك بحر كتائب % % ضاقت جنود الأرض عن أجسادها % % 14(@)(@@) % في سابغات دروعها ومثقفات % % رماحها ومسومات جيادها % % 15(@)(@@) % نيطت نجوم السعد من أعلامها % % وغدت جنود النصر من أمدادها % % 16(@)(@@) % غازت لعطف العامري مجاهد % % في طاعة المنصور حق جهادها % % 17(@)(@@) % مستنجد منه مذلة خاضع % % غنم الحياة أبوه باستنجادها % % 18(@)(@@) % فحمته طاعتك التي لو خانها % % طارت إليه البيض من أغمادها % % 19(@)(@@) % حتى أناخ بعقوة الملك التي % % قد حلق العيوق دون وهادها % % 20(@)(@@) % ومليك قحطان الذي وكلت به % % إحياء مفخرها ورفع 
ms168	 عمادها % % PageV01P520 21(@)(@@) % صفو الملوك الصيد من أذوائها % % وسلالة العظماء من أمجادها % % 22(@)(@@) % وسنيها وعليها وزكيها % % وحليمها وكريمها وجوادها % % 23(@)(@@) % فاسلم لعز الدين والدنيا التي % % أصبحت أنفس ذخرها وعتادها % % 24(@)(@@) % حتى تؤدي شكر سعيك أمة % % وطأت في نعماك خفض مهادها % % 25(@)(@@) % خضت المهالك دون صفو حياتها % % وهجرت غمضك عن لذيذ رقادها % % 26(@)(@@) % بلغت سجالك منتهى رغباتها % % وتجاوزت نعماك شأو مرادها % % 27(@)(@@) % والله يشهد أن بين جوانحي % % نفسا رجاؤك في صميم فؤادها % % 28(@)(@@) % لو قارعت عنك الخلائق كلها % % غلبت عليك بشكرها وودادها % % PageV01P521 البحر : وافر تام 1(@)(@@) % تناضل عنك أقدار السماء % % وتبطش عن يديك يد القضاء % % 2(@)(@@) % وسعي لا يعوج على حلول % % وشأو لا يفوت إلى انتهاء % % 3(@)(@@) % فما قصرت رماحك عن عدو % % ولو أعيا به أمد التنائي % % 4(@)(@@) % إذا أشرعتها في إثر غاو % % فقد ضاقت به سبل النجاء % % 5(@)(@@) % ولو طارت به ألفا عقاب % % يرمن بنفسه خرق الهواء % % 6(@)(@@) % وأين يفر عن درك المنايا % % وأين يشذ من تحت السماء % % 7(@)(@@) % فيهن الدين والدنيا بشير % % بغرسية الأعادى والعداء % % 8(@)(@@) % بصنع أعجز الآمال قدما % % وقصر دونه أمد الرجاء % % 9(@)(@@) % ألذ على المسامع من حياة % % وأنجع في النفوس من الشفاء % % 10(@)(@@) % فيا فتحا لمفتتح وبشرى % % لمنتظر ويا مرأى لراء % % PageV01P522 11(@)(@@) % أسير ما يعادل في فكاك % % وعان ما يساوى في فداء % % 12(@)(@@) % هو الداء العياء شفيت منه % % فما للدين من داء عياء % % 13(@)(@@) % لقد كادت سعودك منه نجما % % منيع الجو وعر الارتقاء % % 14(@)(@@) % وأعظم في الضلالة من صليب % % وأعلى في الكتائب من لواء % % 15(@)(@@) % حمى شيع الضلال فأهلته % % لملك الرق منها والولاء % % 16(@)(@@) % زعيم بالكتاب والمذاكي % % ثمال للرعايا والرعاء % % 17(@)(@@) % مباري سيفه قدما وبأسا % % ومشفوع التجارب بالدهاء % % 18(@)(@@) % وهل للحزم والإقدام يوما % % إذا عنت سعودك من غناء % % 19(@)(@@) % تعاطى في جنود الله كرا % % وقد نبذت إليه على سواء % % 20(@)(@@) % وما للنصر عنها من خلاف % % وما للفتح منها من خفاء % % PageV01P523 21(@)(@@) % فساور نحوها غول المنايا % % وجرع دونها مر اللقاء % % 22(@)(@@) % وأجلت عنه منجدلا صريعا % % مصون الشلو محمي 
ms169	 الذماء % % 23(@)(@@) % وأسلمه إلى الإسلام جيش % % أغص بجمعه رحب الفضاء % % 24(@)(@@) % لئن خذلته أطراف العوالي % % لقد آساه إعوال البكاء % % 25(@)(@@) % بكل مرجع للنوح يشجي % % بواكيه بتثويب النداء % % 26(@)(@@) % نعاء إلى ملوك الروم طرا % % ذوي التيجان غرسية نعاء % % 27(@)(@@) % وهل للروم والإفرنج منه % % وقد أودى سوى سوء العزاء % % 28(@)(@@) % فملك الكفر ليس بذي ولي % % وثأر الشرك ليس بذي بواء % % 29(@)(@@) % لقد أرضت سيوفك فيه مولى % % كريم العهد محمود البلاء % % 30(@)(@@) % فما أغنت بظهر الغيب إلا % % وقد أغنى بها كرم الوفاء % % PageV01P524 31(@)(@@) % ولا أسرت لك الأملاك إلا % % وقد ألبستها سيمى السناء % % 32(@)(@@) % ولا خطفت لك الأرواح إلا % % وقد أرويتهن من الدماء % % 33(@)(@@) % وقد أبليت فيه الله شكرا % % تواصله بإخلاص الدعاء % % 34(@)(@@) % وسعت عباده صفحا وفضلا % % عليما أنه رب الجزاء % % 35(@)(@@) % فوالى بالمزيد من الأماني % % وضاعف بالجزيل من العطاء % % 36(@)(@@) % وأتبع فل غرسية عجالا % % يسوقهم الردى سوق الحداء % % 37(@)(@@) % فأسأل من براهم للمنايا % % بسيفك أن يخصك بالبقاء % % 38(@)(@@) % قرير العين مشفوع الأماني % % سعيد الجد محبور الثواء % % 39(@)(@@) % لملك لا يراع بريب دهر % % وسعد لا يحور إلى انقضاء % % PageV01P525 البحر : كامل تام 1(@)(@@) % عزم حداه السعد والإقبال % % وعلا تضعضع دونها الآجال % % 2(@)(@@) % وعوائد لله ما زالت لكم % % بالنصر عائدة وليس تزال % % 3(@)(@@) % وكتائب لليمن يوم رحيلها % % بالفتح في جنباتها استهلال % % 4(@)(@@) % وعبيد مملكة وشيعة دولة % % قد أيقنوا أن الحياة قتال % % 5(@)(@@) % صبر إذا انتضوا السيوف تبينت % % أعداؤهم أن الليوث رجال % % 6(@)(@@) % مستأنسين إلى الهواجر ما لهم % % إلا متون المشرفي ظلال % % 7(@)(@@) % لهجواب يا منصور فهو شعارهم % % نغم تعود صدقهن الفال % % 8(@)(@@) % وصوارم جلت الظلام وما لها % % بسوى الجماجم والنحور صقال % % 9(@)(@@) % مما انتمى حيث انتميت وأورثت % % آباؤك الأذواء والأقيال % % 10(@)(@@) % من كل مشحوذ الغرار كأنه % % للشمس في ظلم العجاج خيال % % PageV01P526 11(@)(@@) % وقنا إذا اقتضت العداة نفوسها % % لم يعتلل بأدائهن مطال % % 12(@)(@@) % سلب إذا أشرعتهن تقاصرت % % أعمار مطلبهن وهي طوال % % 13(@)(@@) % بهرت مناقبك الضحى وتقاصرت % % عن كنهها الأشباه والأمثال % % 14(@)(@@) % نفسي فداؤك والنفوس هفت بها % % نار 
ms170	 الوغى وتصادم الأجبال % % 15(@)(@@) % والبيض تلمع والأسنة تلتظي % % والخيل في ضنك الوغى تختال % % 16(@)(@@) % ومجال وجهك في مواقف للردى % % ما للخواطر بينهن مجال % % 17(@)(@@) % ونفيسة أقحمت نفسك دونها % % إن النفائس بالنفوس تنال % % PageV01P527 البحر : بسيط تام 1(@)(@@) % اليوم أنكص إبليس على عقبه % % مبرءا سبب الغاوين من سببه % % 2(@)(@@) % واستيقنت شيع الكفار حيث نأت % % في الشرق والغرب أن الشرك من كذبه % % 3(@)(@@) % بشنتياقة لما أن دلفت له % % بالبيض كالبدر يسري في سنا شهبه % % 4(@)(@@) % وحلبة الدين والإسلام عاطفة % % عليك كالفلك الجاري على قطبه % % 5(@)(@@) % حتى فصمت عرى دين الضلالة من % % رأس القواعد ممنوع الحمى أشبه % % 6(@)(@@) % لم يذعر الدهر فيه نفس سائمة % % ولا أصاخت له أذن إلى نوبه % % 7(@)(@@) % مما اصطفت عبد الطاغوت واعتقدتب % % وشيد الكفر في الآلاف من حقبه % % 8(@)(@@) % عمود شركهم السامي ذوائبه % % والروم والحبش والأفرنج من طنبه % % 9(@)(@@) % تحجة فرق الكفار سائلة % % كالجو أظلم فيه ملتقى شحبه % % 10(@)(@@) % مستودع في شعاب الأرض حيث نأى % % شم الجبال ولج البحر من حجبه % % PageV01P528 11(@)(@@) % من كل أغبر من عض السفار به % % وساهم الوجه من طول السرى شجبه % % 12(@)(@@) % وكل مهد إلى أركان بيعته % % ما عز من نفسه فيها ومن نشبه % % 13(@)(@@) % قد طالما أحفت الأملاك أرجلها % % فيه وخرت على الأذقان من رهبه % % 14(@)(@@) % أممته بجنود الحق فانقلبت % % بغرة الفتح من تغيير منقلبه % % 15(@)(@@) % وسمته جاحما للنار ما بقيت % % نفس من الكفر إلا وهي من حطبه % % 16(@)(@@) % يا حسن مرأى الهدى من قبح منظره % % وبرد أكباد حزب الله من لهبه % % 17(@)(@@) % وعاذ برمند منه بالفرار وكم % % من قبلها عاذ بالأنصاب من صلبه % % 18(@)(@@) % مستوطنا مركب الإحجام عنك وهل % % يعدو به وجهه المحتوم من عطبه % % 19(@)(@@) % مستخفيا بظلام الليل منك فإن % % وافاه صبح توارى في دجى كربه % % 20(@)(@@) % قد حفت اليوم منه قلب ملتهب % % منها ومن . . ربه % % PageV01P529 21(@)(@@) % لا يزجر الطير في سهل ولا جبل % % إلا بوارح تعمي عين مقتربه % % 22(@)(@@) % وأين منه سبيل الفوز منك وقد % % سللت سيف الهدى والنصر في طلبه % % 23 
ms171	(@)(@@) % وإيلياء التي كانت ألية ذي % % جهد من الشرك خاشي الإثم مرتقبه % % 24(@)(@@) % رفعت منها سنا نار أضاء لهم % % ما كان أودعها الشيطان من ريبه % % 25(@)(@@) % يشبها منك عزم لو ونى ضرم % % منها لأضرمها في الله من غضبه % % 26(@)(@@) % فالله جازيك يا منصور دعوته % % بسعي ماض لنصر الدين محتسبه % % 27(@)(@@) % وعن كتائب للإسلام قدت بها % % إلى رضا الله حتى كن من كتبه % % 28(@)(@@) % ومؤمن منصب لله مهجته % % بلغته أمد المغبوط من نصبه % % 29(@)(@@) % وعن حسام هدى لم تجل صفحته % % إلا أسلت دماء الشرك في شطبه % % 30(@)(@@) % وليفتخر منك يا منصور يوم علا % % تركت غابرة الأيام تفخر به % % PageV01P530 البحر : كامل تام 1(@)(@@) % طلعت نجوم السعد من آفاقها % % فالأرض تشرق من سنا إشراقها % % 2(@)(@@) % للحاجب الأعلى المصرف همة % % موصولة بشآمها وعراقها % % 3(@)(@@) % بهلال أقمار الهدى من يعرب % % فمنى مساعي شأوها بلحاقها % % 4(@)(@@) % الطالعات على الهدى بتمامها % % والطالعات على العدى بمحاقها % % 5(@)(@@) % والمستهل على العفاة براحة % % وسع الهدى والملك ظل رواقها % % 6(@)(@@) % فالدين يونع من ندى إغداقها % % والكفر يرجف من ردى إصعاقها % % 7(@)(@@) % خلفا من المنصور في عزماته % % والخيل جارية على أعراقها % % 8(@)(@@) % زهيت نحور الغانيات به وقد % % سام الوغى بوداعها وفراقها % % 9(@)(@@) % مترشف الهبوات قبل شفاهها % % ومعانق الأبطال قبل عناقها % % 10(@)(@@) % قلقت إليه البيض في أغمادها % % وثنت إليه الخيل من أعناقها % % PageV01P531 11(@)(@@) % متفجر لعفاته عن شيمة % % زادت بها الأيام في أرزاقها % % 12(@)(@@) % متكشف عن سطوة مذخورة % % للحرب إن كشفت له عن ساقها % % 13(@)(@@) % تفديه منا أنفس وجدت به % % ريحانة الآمال في إنشاقها % % 14(@)(@@) % ونواظر حفت به تواقة % % لو أنها حملته في أحداقها % % 15(@)(@@) % في روضة الملك التي يجري بها % % ماء النعيم يروق في أوراقها % % 16(@)(@@) % وازدادت الأشياء حسنا كلها % % حتى حمام الأيك في أطواقها % % 17(@)(@@) % يا عامرا من أعمروا سبل الهدى % % لا در در الخيل بعد عتاقها % % PageV01P532 البحر : كامل تام 1(@)(@@) % الله جارك ظاعنا ومقيما % % ومثيبك التبجيل والتعظيما % % 2(@)(@@) % قرت عيون المسلمين وقد رأوا % % إقدام عزم بالفتوح زعيما % % 3(@)(@@) % كرات نصر أصبحت لذوي 
ms172	 الهدى % % همما وفي أرض الضلال هموما % % 4(@)(@@) % ما يممت بالفلج مهجة كافر % % إلا انثنى من ذكرهن أميما % % 5(@)(@@) % فارفع لواء بالنجاح عقدته % % بالنصر في سبل الهدى موسوما % % 6(@)(@@) % وانهض بأنصار الهدى نحو العدى % % جيشا بخسفهم أجش هزيما % % 7(@)(@@) % من كل سامي الطرف يحدو ولها % % قد غادرت أم الضلال عقيما % % 8(@)(@@) % تذكي أكفهم لإضرام الوغى % % شعلا وفي قمم الرؤوس نجوما % % 9(@)(@@) % مستلئمين من السيوف بوارقا % % ومن السنور عارضا مركوما % % 10(@)(@@) % عزت بذكرك في البلاد صوارم % % تركت رجاء عداتها مصروما % % PageV01P533 11(@)(@@) % وأسنة الخط التي خطت على % % شيع الضلالة حينها المحتوما % % 12(@)(@@) % طلعت على دين الهدى بك أسعدا % % وعلى دبار المشركين رجوما % % 13(@)(@@) % فاطلب بها والله مسعد حظها % % حظا من الفتح المبين جسيما % % 14(@)(@@) % وامدد على الآفاق كفا لم تزل % % تفني بوادرها العدى واللوما % % 15(@)(@@) % صابت على الإشراك خسفا مفنيا % % وهمت علينا بالنوال غيوما % % 16(@)(@@) % فلقد وسعت الأرض معروفا وقد % % شيدت مجدا في السماء مقيما % % 17(@)(@@) % ولقد حميت ذمار أمة أحمد % % وأبحت من عز الضلال حريما % % 18(@)(@@) % في معرك أظمأت أكباد العدى % % فيه ورويتالرماح الهيما % % 19(@)(@@) % أخضلت فيه السيف من مهجاتهم % % وتركتهم للرامسات هشيما % % 20(@)(@@) % بك أصبح الثغر المروع مشرقا % % ولكاد قبلك أن يكون بهيما % % PageV01P534 21(@)(@@) % يا أيها الملك الذي بسيوفه % % ورماحه أضحى الهدى معصوما % % 22(@)(@@) % بكم اغتدى شمل العدى متبددا % % وبكم غدا شمل الهدى منظوما % % 23(@)(@@) % طبتم فروعا في ذؤابة يعرب % % وزكوتم في المالكين أروما % % 24(@)(@@) % المسرعون إلى الندى والطائرون % % إلى الوغى والراجحون حلوما % % 25(@)(@@) % والمنتضون سيوفهم لوقائع % % عزت قناها فارسا والروما % % 26(@)(@@) % دانت لهم غرر المناقب واصطفوا % % حسبا حديثا في الدنا وقديما % % 27(@)(@@) % كرمت مغارسهم وطاب نجارهم % % حتى غدا بهم الزمان كريما % % PageV01P535 البحر : بسيط تام 1(@)(@@) % قد عادت الشمس في أعلى مطالعها % % ولجة البحر في أعلى مشارعها % % 2(@)(@@) % وعز نظم الهدى في كف ناظمه % % وراق مجتمع الدنيا بجامعها % % 3(@)(@@) % وعاد نور جفون في نواظرها % % به وقرت قلوب في مواضعها % % 4(@)(@@) % وقابلتها اللهى في كف باذلها % % وحوزة الملك في أكناف مانعها % % 5 
ms173	(@)(@@) % وحط رحل الوغى عن ظهر صائفة % % شابت رؤوس الأعادي من وقائعها % % 6(@)(@@) % كادت تهد الصخور الصم روعتها % % لولا تمكن وقر في مسامعها % % 7(@)(@@) % هول نفى الجن عن أخفى ملاعبها % % وأوحش الوحش في أقصى مراتعها % % 8(@)(@@) % تقودها دعوة التوحيد قد أخذت % % عهدا من الله في تشفيع شافعها % % 9(@)(@@) % وغرة أشرفت في كل مظلمة % % بثاقب الهدي والأنوار ساطعها % % 10(@)(@@) % بريح نصر إلى الأعداء تقدمها % % كريح عاد جلتها عن مصانعها % % PageV01P536 11(@)(@@) % فإن يعوذوا بآناف الجبال فقد % % جاءت أنوفهم في سيف جادعها % % 12(@)(@@) % أو عللوا بفرار أنفسا علمت % % أن الفرار دواء غير نافعها % % 13(@)(@@) % فما النجاة تمارى في تفكرها % % ولا الحياة تراءى في مطامعها % % 14(@)(@@) % بل الردى منك مكتوب على مهج % % قد أصبحت بارزات في مضاجعها % % 15(@)(@@) % ولا بسيفك عجز عن معاقلها % % ولا سنانك ناب دون دارعها % % 16(@)(@@) % وما ترجلت إلا ريثما نزلوا % % على الأحبة في أدنى مصارعها % % 17(@)(@@) % وأنت جار من العليا على سنن % % تدارك الحرب من أزكى شرائعها % % 18(@)(@@) % والله جارك في حل ومرتحل % % وساحة الأرض دانيها وشاسعها % % 19(@)(@@) % حتى يثير لك الآفاق مؤتنفا % % كواكبا تسعد الدنيا بطالعها % % PageV01P537 البحر : متقارب تام 1(@)(@@) % لتهنئ سلامتك المسلمينا % % وتفدك أنفسهم أجمعينا % % 2(@)(@@) % فقد صدق الله ما يرغبونا % % وقد حقق الله ما يأملونا % % 3(@)(@@) % غزوت فأعطيت نصرا عزيزا % % وصلت فوفيت فتحا مبينا % % 4(@)(@@) % بسيف ضربت به في الإله % % فأعززت ملكا ودنيا ودينا % % 5(@)(@@) % وبلدة شرك تيممتها % % فغادرتها آية السائلينا % % 6(@)(@@) % ودائع مجد تقلدتها % % فكنت عليها القوي الأمينا % % 7(@)(@@) % نهضت فأرضيت منا النفوس % % وأبت فأقررت منا العيونا % % 8(@)(@@) % فما خيب الله فيك الرجاء % % ولا كذب الله فيك الظنونا % % 9(@)(@@) % فأبقيت حصنا منيعا رفيعا % % ودمت كريما عزيزا مكينا % % PageV01P538 البحر : بسيط تام 1(@)(@@) % عمري لقد أعذر الدمع الذي وكفا % % لو اشتفى من تباريح الأسى وشفى % % 2(@)(@@) % وما غناء دموع العين عن كبد % % حرى ونضو يقاسي الليل ملتهفا % % 3(@)(@@) % يا بن الذين لأيديهم وأمرهم % % ألقى الزمان قياد الذل معترفا % % 4(@)(@@) % ببأسهم قام دين الله منتصرا % % من الحوادث والأعداء منتصفا % % 5 
ms174	(@)(@@) % أعزز على الدين والدنيا وأهلهما % % خطب سما فارتقى من عزكم شرفا % % 6(@)(@@) % غصن من المجد عاذ المسلمون به % % هبت عليه رياح النصر فانقصفا % % 7(@)(@@) % لله من قمر أسرى العفاة به % % حتى إذا ما استوى في أفقه كسفا % % 8(@)(@@) % سما إلى جنة الفردوس معتليا % % إذ لم يزل مستهاما بالعلا كلفا % % 9(@)(@@) % تلك المكارم والته فعلقها % % حبا شهدت لقد أودى بها شغفا % % 10(@)(@@) % وسهم نصر تراع الحادثات به % % أضحى بسهم المنايا والردى قذفا % % PageV01P539 11(@)(@@) % يا من رأى الجود يغشى نعشه شغفا % % بالهم مرتديا بالحزن ملتحفا % % 12(@)(@@) % يدعوه حتى إذا أعيا محاورة % % نادى فأسمع صم الصخر واأسفا % % 13(@)(@@) % وخلفوه لديه رهن ملحدة % % حيران يلثم برد الترب مرتشفا % % 14(@)(@@) % مباريا لدموع المزن ما هتنت % % ومسعدا لحمام الأيك ما هتفا % % 15(@)(@@) % قد كان من دون ذاك الغاب ليث وغى % % أحمى العرين وفي تلك العلا خلفا % % 16(@)(@@) % فاختاره الله في الدنيا لكم فرطا % % ذخرا وفي جنة المأوى لكم سلفا % % 17(@)(@@) % من بعدما اهتز سيف النصر في يده % % وصال غضبان من دون الهدى أسفا % % 18(@)(@@) % وشمرت دون ذاك الملك عزمته % % يود لو كر صرف الدهر أو زحفا % % 19(@)(@@) % واستشرفت أعين الأبطال ناظرة % % أيان يركب درع الموت معتسفا % % 20(@)(@@) % والخيل قد نسجت سفلى سنابكها % % من القتام على فرسانها كسفا % % PageV01P540 21(@)(@@) % كأنهم في لبوس السابغات ضحى % % كواكب لبست من ليلها سدفا % % 22(@)(@@) % والبيض قد غشيت منهم سنا غرر % % كأنها در بحر يسكن الصدفا % % 23(@)(@@) % فاسلم ولا زال شمل الكفر مفترقا % % بالسيف منك وشمل الدين مؤتلفا % % 24(@)(@@) % واستقبل العيد مسرورا ولا برحت % % تهدي الليالي إليك العز مؤتنفا % % 25(@)(@@) % وليهنك الفوز والزلفى وأنفسنا % % يلقين من دونك التبريح والأسفا % % PageV01P541 البحر : كامل تام 1(@)(@@) % أهلا بمن نصر الإله وأيدا % % وحمى من الإشراك أمة أحمدا % % 2(@)(@@) % وسخا لأطراف الرماح بنفسه % % شحا وإشفاقا على دين الهدى % % 3(@)(@@) % وبمن حمى التوحيد ممن سامه % % خسفا فأصبح في المعالي أو حدا % % 4(@)(@@) % حتى أعاد الدين أبيض مشرقا % % بسيوفه والكفر أدهم أسودا % % 5(@)(@@) % بسط الإله بسيفه وبرمحه % % ظلا على 
ms175	 الدين الحنيف ممددا % % 6(@)(@@) % بمكارم شهدت عليه بأنه % % أندى الورى كفا وأطيب محتدا % % 7(@)(@@) % وشمائل لو شام رهبة سيفه % % لغدا لرقتها الورى مستعبدا % % 8(@)(@@) % من أحرز الغايات أدنى شأوه % % حتى تقاصر عن مساعيه المدى % % 9(@)(@@) % وسطا على الأعداء حتى لاغتدت % % عنقاء مغرب في البلاد من العدى % % 10(@)(@@) % بعزائم في الروع قحطانية % % تركت ديار الشرك قاعا فدفدا % % PageV01P542 11(@)(@@) % والقائد الميمون والقمر الذي % % يجلو بغرته الظلام إذا بدا % % 12(@)(@@) % والأزهر الوضاح والملك الذي % % لبس الندى والبأس ثوبا وارتدى % % 13(@)(@@) % إن يكن عن بعض النجوم بأسعد % % فلقد تجلت كلها لك أسعدا % % 14(@)(@@) % فخرا لمصدرك الذي لم يترك % % لظبى الصوارم في الأعاجم موردا % % 15(@)(@@) % لله في الإشراك منك وقائع % % أربت على حرب الذنائب مشهدا % % 16(@)(@@) % لا مثل بربديل يوم حويتها % % فخرا أغار على الزمان وأنجدا % % 17(@)(@@) % جردت للإسلام فيها صارما % % عودته ضرب الطلى فتعودا % % 18(@)(@@) % وسللته لله فيها سلة % % منعت صليبا بعدها أن يعبدا % % 19(@)(@@) % ووقفت دون الدير فيها وقفة % % كانت لنصر الله فيها موعدا % % 20(@)(@@) % وقلنية أنشأت فيها عارضا % % للحرب أبرق بالحتوف وأرعدا % % PageV01P543 21(@)(@@) % وبرأي عيني يوم خضت لفتحها % % بحرا من البيض الصوارم مزبدا % % 22(@)(@@) % فرأيت ما استنزلت من نجم هوى % % وشهدت ما حدثت عن ليث عدا % % 23(@)(@@) % والحرب قائمة تغص بنقعها % % لمحا بنار المشرفية موقدا % % 24(@)(@@) % والشمس حيرى في السماء كأنها % % ترنو إلى الدنيا بمقلة أرمدا % % 25(@)(@@) % والخيل تستلم الصعيد كأنما % % تبغي إلى الجوزاء منها مصعدا % % 26(@)(@@) % ما إن ترى إلا خفوق مهند % % كالبرق يقرع في المكر مهندا % % 27(@)(@@) % وثقوب أزهر كالشهاب مثقف % % يهدى إلى ظلم النفوس به الردى % % 28(@)(@@) % فغدا إليها منك ليث خفية % % ما راح إلا للفخار ولا غدا % % 29(@)(@@) % لا ترتضي للسيف سلة ساعة % % حتى تراه في الكواهل مغمدا % % 30(@)(@@) % وتركت شنت اشتيبنا وكأنما % % حطت سيوفك من عداها الفرقدا % % PageV01P544 31(@)(@@) % فقصرت مدتها بوقفة ساعة % % أبقت لك الفخر الجليل مخلدا % % 32(@)(@@) % شيدت عز المسلمين بهدم ما % % قد كان عز الكفر منها شيدا % % 33(@)(@@) % وتركت غرسية بنقمة غدره % % بالروع في الأرض 
ms176	 الفضاء مقيدا % % 34(@)(@@) % لهفان يجتاب النهار مروعا % % بظباك والليل التمام مسهدا % % 35(@)(@@) % خزيان قد أوسعت حر بلاده % % ودياره لهب السعير الموقدا % % 36(@)(@@) % قد غر أحزاب الكماة وما حمى % % وأضل أشياع الضلال وما هدى % % 37(@)(@@) % إيها بني المنصور أنفسنا لكم % % ونفوس من في الشرق والغرب الفدا % % 38(@)(@@) % اليوم أنسى فتحكم ما قبله % % عظما كما نسا لفتحكم غدا % % PageV01P545 البحر : بسيط تام 1(@)(@@) % ما أطبق الهم إلا ريثما انفرجا % % ما أطبق الهم إلا ريثما انفرجاولا دجا الخطب إلا وشك ما انبلجا % % 2(@)(@@) % ما كاد يبدو الضحى بالحزن مكتئبا % % حتى رأينا الدجى بالنور منبلجا % % 3(@)(@@) % فاليوم قد لبس الإظلام ثوب سنا % % في عقب ما لبس الإصباح ثوب دجى % % 4(@)(@@) % وأورقت شجر الدنيا لدن عريت % % وعاد يشدو حمام الملك إذ نشجا % % 5(@)(@@) % بشر بالشمس إشراق الضحى فشفى % % في إثر ناع نعى نجم الهدى فشجا % % 6(@)(@@) % رزء حكى كظم الأرواح أعقبه % % صنع أعاد إلى أوطانها المهجا % % 7(@)(@@) % فأصبح الملك لا ربثا ولا خللا % % وأصبح الدين لا أمتا ولا عوجا % % 8(@)(@@) % فلتهننا نعم الرحمن حين هدى % % بعبده سبل الحق الذي نهجا % % 9(@)(@@) % بناصر الدين والإسلام مفتتحا % % بيمنه كل باب للمنى أرتتجا % % 10(@)(@@) % يا بن الذي قاد من أذواء ذي يمن % % عرفا بعرف المعالي والهدى وشجا % % PageV01P546 11(@)(@@) % من ذا ينازعك الملك الذي عمرت % % به أوائلك الأحقاب والحججا % % 12(@)(@@) % وفي جبينك سيما الملك قد بهرت % % وفي يمينك قدح الحق قد فلجا % % 13(@)(@@) % ما كان أول كرب جل فادحه % % دجا فكنت لنا من همه فرجا % % 14(@)(@@) % فرب دهياء من خطب أضأت لنا % % آراءك الزهر في آفاقها سرجا % % 15(@)(@@) % ورب يوم وأيام كشفت بها % % عنا وعن مليكك المأزق اللحجا % % 16(@)(@@) % وعزمة لك يوم الروع صادقة % % تركت صم الصفا في جوها رهجا % % 17(@)(@@) % ولجة من صفيح الهند خضت بها % % من المنايا إلى نيل المنى لججا % % 18(@)(@@) % وكرة بعد أخرى في ندى ووغى % % بنيتها لسماوات العلا درجا % % 19(@)(@@) % فما دعت غيرك الآمال حين دعت % % ولا رجا غيرك الإسلام حين رجا % % 20(@)(@@) % ولا أتتك 
ms177	 وفود الحمد عامدة % % إلا تلقتك مشغوفا بها لهجا % % PageV01P547 21(@)(@@) % ولا تيممك التأميل مبتكرا % % إلا ووافاك بالإنعام مدلجا % % 22(@)(@@) % ولا تقلبت في مثوى ولا سفر % % إلا وذكرك في حلق الضلال شجا % % 23(@)(@@) % ولا نجا منك ذو غل ولا دغل % % إلا إلى حكمك الماضي عليه نجا % % 24(@)(@@) % صبر كثهلان يوم الروع متئدا % % جود كسيحان يوم المد معتلجا % % 25(@)(@@) % فيا معاديه أجفل ولا وزرا % % ويا مؤمله أسرف ولا حرجا % % 26(@)(@@) % ولا تزل أيها الدهر السعيد به % % بوجهه بهجا من ذكره أرجا % % PageV01P548 البحر : متقارب تام 1(@)(@@) % هو البدر في فلك المجد دارا % % فما غسق الخطب إلا أنارا % % 2(@)(@@) % تجلى لنا فأرتنا السعود % % غيوب المنى في سناه جهارا % % 3(@)(@@) % وأوفى فكادت صوادي القلوب % % تفوت العيون إليه بدارا % % 4(@)(@@) % وحل فحلت جسام الفتوح % % تبأى اختيالا وتزهى افتخارا % % 5(@)(@@) % وحق له اليوم رق الكرام % % طوعا ورق العداة اقتسارا % % 6(@)(@@) % فيا رب غاية مجد شأوت % % إلى فخرها معجزا أن تجارى % % 7(@)(@@) % ومن يسم في ذروتي حمير % % ويحتل من يمن الملك دارا % % 8(@)(@@) % ينازع إلى شبه ذاك السناء % % وتنح مساعيه ذاك النجارا % % 9(@)(@@) % وحسب الخليفة إيثاره % % لكم دون هذا الأنام اقتصارا % % 10(@)(@@) % تنقاكما عامريين قاما % % بأعبائه فاستجدا الفخارا % % PageV01P549 11(@)(@@) % فلم يأل بحبوحة الملك حظا % % ولا ادخر المسلمين اختيارا % % 12(@)(@@) % رمى بك بحر الأعادي وأدنى % % من الملك حاجبه مستشارا % % 13(@)(@@) % فكان الحسام وكنت السنان % % وكان الشعار وكنت الدثارا % % 14(@)(@@) % ولألأ منه على الدين نورا % % وأضرم منك على الشرك نارا % % 15(@)(@@) % فأوليت نعماه في الله عزما % % ترى النصر يقدمه حيث سارا % % 16(@)(@@) % فصنت العلا وأبحت الندى % % وحطت الهدى وحميت الذمارا % % 17(@)(@@) % فأصبح سيفك للدين حصنا % % وأمسى سنانك للثغر جارا % % 18(@)(@@) % وفي شنت ياقب أوردتها % % شوارب يبغين في البحر ثارا % % 19(@)(@@) % فسرت هلالا تباري الهلال % % إليها وبحرا يخوض البحارا % % 20(@)(@@) % وشمسا تطلع بالمغربين % % بحيث توافي ذكاء الغبارا % % PageV01P550 21(@)(@@) % فما رمت حتى علت جانباها % % بأيدي المذاكي عجاجا مثارا % % 22(@)(@@) % تهب بها في الهواء الرياح % % إما دخانا وإما غبارا % % 23(@)(@@) % ولم يستطع ياقب نصرها 
ms178	 % % ولا دفع الخسف عنه انتصارا % % 24(@)(@@) % لئن غورت في شغاف الشمال % % لقد أنجد الفتح منها وغارا % % 25(@)(@@) % وأخلف برمند منها الرجاء % % وما زاده الشرك إلا تبارا % % 26(@)(@@) % أطرت إلى ناظريه عجاجا % % تركت به عقله مستطارا % % 27(@)(@@) % فما يعرف العهد إلا امتراء % % ولا يوقن العهد إلا ادكارا % % 28(@)(@@) % ولما ادرعت إليه اليقين % % لم يدرع منك إلا الفرارا % % 29(@)(@@) % وشام غراري حسام المنايا % % فما يطعم النوم إلا غرارا % % 30(@)(@@) % ولنيوش أمطرتها صائبات % % تصيب النفوس وتعفو الديارا % % PageV01P551 31(@)(@@) % هززت إليها رماحا طوالا % % تصير أعمار قوم قصارا % % 32(@)(@@) % فغادرتها في ضمان الإله % % ويممت أعلى وأنأى مزارا % % 33(@)(@@) % وقد يفرس الليث أروى الهضاب % % ويهمل حرش الضباب احتقارا % % 34(@)(@@) % وخلفت فيها مبيد الضلال % % يقربها لك ثوبا معارا % % 35(@)(@@) % يكفكف أدمع عين سجاما % % ويبرد أحشاء صدر حرارا % % 36(@)(@@) % فإن أخطأته كئوس المنايا % % لقد خلدت في حشاه خمارا % % 37(@)(@@) % وعم بها فتحك الأرض نورا % % كما ذرت الشمس فيها النهارا % % 38(@)(@@) % فعرج على الحج بالمسلمين % % بعقب اصطلامك حج النصارى % % 39(@)(@@) % فقد نشرت مصر والقيروان % % ومدت عيون الحجاز انتظارا % % PageV01P552 البحر : طويل 1(@)(@@) % تسليت حتى أنسي الهائم الهما % % وأغنيت حتى أعدم المعدم العدما % % 2(@)(@@) % وإلا فكيف اغتالت القطب والسها % % وعارضت الجوزاء واعتامت النجما % % 3(@)(@@) % وكيف ابتغت للسقم عندك موضعا % % وأنت الذي يشفي الإله به السقما % % 4(@)(@@) % وكم رعتها بالسيف في كل بلدة % % فإن أقدمت يوما ففي بسطك السلما % % 5(@)(@@) % ألا أقدمت في حومة الموت والردى % % تطارده حمرا وتبهره قدما % % 6(@)(@@) % وهلا وأبصار الكماة شواخص % % وبيض الظبى تحمى وسمر القنا تدمى % % 7(@)(@@) % وما كانت الحمى بأول كاشح % % سعى لك بالبؤسى فجازيته النعمى % % 8(@)(@@) % فأوليتها الصبر اللجوج إلى العدى % % وعرفتها الصبر الخروح من الغمى % % 9(@)(@@) % ومن قبل ما أوسعتها صدر صافح % % ونفسا يلذ المسك أنفاسها شما % % 10(@)(@@) % فإن جددت في بعدها لك صحة % % فمن بعد أن زودتها الطيب والحلما % % PageV01P553 11(@)(@@) % وإن تلق جسما بعد جسمك في الورى % % وكيف بها أن ترتضي بعده جسما % % 12(@)(@@) % فقد أهدت البشرى إليه وأفرغت % % عليه السرور المحض والكرم 
ms179	 الجما % % 13(@)(@@) % وما نقصت منك الليالي فعود % % عليك به إلا الخطيئة والإثما % % 14(@)(@@) % وعد ذبول الروض يرجى له الحيا % % وعند محاق البدر يستقبل التما % % 15(@)(@@) % ومن يصل نار الحرب في جاحم الوغى % % فلا غرو أن يحصى حشاه وأن يحمى % % 16(@)(@@) % ولا عجب من وهب جسم تعاورت % % قواه الحصون الصم والمدن الشما % % 17(@)(@@) % فبسطة باع جازت الوهم والمدى % % ورحب ذراع حازت العرب والعجما % % 18(@)(@@) % فإن يبق من شكواك باق فهذه % % تمائمك اللاتي شفيت بها قدما % % 19(@)(@@) % خيولا كساها الجو نورا فأقدمت % % محجلة غرا وإن نتجت دهما % % 20(@)(@@) % وبيضا تشكت من شكاتك وحشة % % بما أنست حتى قرنت بها العزما % % PageV01P554 21(@)(@@) % وسمرا كأن الليل لما سريته % % كسا كل لدن من كواكبه نجما % % 22(@)(@@) % وكل غريق في الحديد كأنما % % تسربل من غزل الغزالة واعتما % % 23(@)(@@) % تهاوت به الهواء حتى أممته % % إلى طاعة الرحمن فانقاد وائتما % % 24(@)(@@) % فلم يدر إلا ظل ملكك موطنا % % ولا والدا إلا لديك ولا أما % % 25(@)(@@) % ويا ذا الرياسات افتتح فقد انجلت % % فواتحك اللاتي ضمن لك الحتما % % 26(@)(@@) % ويا منذر الرايات والسابحات قم % % فأنذر عداك الذل والخزي والرغما % % 27(@)(@@) % ونادت بك الدنيا أبا الحكم احتكم % % بحول الذي ألقى إلى يدك الحكما % % 28(@)(@@) % وأوف على العلياء واستوف أنعما % % حباك الذي يحبو بأجزلها قسما % % PageV01P555 البحر : طويل 1(@)(@@) % بدالك نجم السعد واطلع النجح % % فبالله فاستفتح فقد جاءك الفتح % % 2(@)(@@) % وقد قدم النصر العزيز لواءه % % وقبل طلوع الشمس ينبلج الصبح % % 3(@)(@@) % فقد في سبيل الله جيشا كأنه % % من الليل قطع طبق الأرض أو جنح % % 4(@)(@@) % كتائب في إقدامها الحق والهدى % % وألوية في عقدها اليمن والنجح % % 5(@)(@@) % فقد حان يوم الفتح واهتزت المنى % % وصح رجاء السيف واستبشر الرمح % % 6(@)(@@) % وحنت إلى يوم اللقاء سوابح % % لها في بحار الموت نحو العدى سبح % % 7(@)(@@) % حملت عليها كل حامل نعمة % % بيمناك مقرونا به الصدق والنصح % % 8(@)(@@) % بضائعهم في متجر الحرب أنفس % % رضاك لها في كل ملحمة ربح % % 9(@)(@@) % فيا أنفس الأملاك نفسا وإنه % % بها في سبيل الله يوم الوغى 
ms180	 سمح % % 10(@)(@@) % ويا أيها المشغوف بالبأس والندى % % وما زال مشغوفا به الحمد والمدح % % PageV01P556 11(@)(@@) % وبحرك مورود السواحل مفعم % % وعبدك قد أودى به الظمأ البرح % % PageV01P557 البحر : بسيط تام 1(@)(@@) % من سبي سيبك مما أنبتت نعمك % % من در بحرك مما عمه كرمك % % 2(@)(@@) % حتى أتيتك طيبا طاب مرتعه % % وسط الرياض التي جادت لها ديمك % % 3(@)(@@) % أو كوكبا مننجوم الحسن مطلعه % % جو السماء التي من فوقها هممك % % 4(@)(@@) % من ريقتي المسك بل رياه من أرجي % % كأنما صافحتني بالضحى شيمك % % 5(@)(@@) % والغصن يسرق من قدي تثنيه % % رقصا وحاشى له ممن غذت نعمك % % 6(@)(@@) % أقول للصبح والدنيا تنير به % % يا صبح من ير وجهي فهو متهمك % % 7(@)(@@) % وكم دعوت وجنح الليل منسدل % % يا ليل شعري يغشي الليل أم ظلمك % % 8(@)(@@) % ورب برق خبا لما هتفت به % % هيهات من مبسمي يا برق مبتسمك % % 9(@)(@@) % بدائع تقتضي حقي لديك وقد % % رأيت آمال أهل الأرض تقتسمك % % 10(@)(@@) % لعل عطفك يا مولاي يأذن لي % % في وضع خدي حيث استوطأت قدمك % % PageV01P558 11(@)(@@) % وتبلو السر من قول يردده % % إليك قلبي لا يعيا به فهمك % % 12(@)(@@) % ما شيد الكفر حصنا من بلادهم % % إلا ليخفق في أبراجه علمك % % 13(@)(@@) % ولا تذوق طعم الأمن ذو حذر % % من النوائب حتى ضمه حرمك % % 14(@)(@@) % ولا تعذر من طالبت مهجته % % ولا تمنع إلا من حمت ذممك % % 15(@)(@@) % ولا تنسم من عاداك منفسه % % حتى تحل بأقصى داره نقمك % % PageV01P559 البحر : متقارب تام 1(@)(@@) % تسمع لدعوة ناء غريب % % كثير الدعاء قليل المجيب % % 2(@)(@@) % يهيم إليك بهم شجاع % % ويجبن عنك بستر هيوب % % 3(@)(@@) % ويقتاده منك صدق اليقين % % فيرتاب منه بظن كذوب % % 4(@)(@@) % أيأذن سمعك لي من بعيد % % ولحظك قد رابني من قريب % % 5(@)(@@) % وكيف بأشجان قلب عزيز % % فيسعده لهو قلب طروب % % 6(@)(@@) % فناداك من غمرات التناسي % % وناجاك في ظلمات الخطوب % % 7(@)(@@) % ببالغة للتراقي حدتها % % إليك وصاة القريب المجيب % % 8(@)(@@) % بما خط للجار وابن السبيل % % وأوجب للمستضام الغريب % % 9(@)(@@) % وما قد حباك الرضا من مليك % % بلاك بلاء الحسام الرسوب % % 10(@)(@@) % فحلاك إكرامه 