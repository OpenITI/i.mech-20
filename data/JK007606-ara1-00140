ms121	 كاد يفنى % % بإشارات المشير % 10(@)(@@) % فائتنا تلق الذي ته % % واه من عيش نضير % PageV01P441 البحر : - 1(@)(@@) % دعانا إلى اللهو داعي السرور % فبتنا نبوح بما في الصدور % 2(@)(@@) % و طافت علينا بشمس الدنا % % نفي غلس الليل شمس الخدور % 3(@)(@@) % كأن الكؤوسو قد كللت % بفضلاتها بأكاليل نور % 4(@)(@@) % جيوب من الوشي مزرورة % يلوح عليها بياض النحور % PageV01P442 البحر : - 1(@)(@@) % هات التي هي يوم البعث أوزار % كالنار في الحسنعقبى شربها النار % 2(@)(@@) % أما ترى الورد قد باح الربيع به % % من بعد ما مر حول و هو إضمار % 3(@)(@@) % و كان في خلع خضر فقد خلعت % % إلا عرى أغفلت منه وأزرار % PageV01P443 البحر : - 1(@)(@@) % صفر مدار نصبها شرف % مفتضح عند نشرها العطر % 2(@)(@@) % تحملها خيزرانة ذبلت % ذبول صب أذله الهجر % 3(@)(@@) % كأنهاإذ زهت بألسنة % أنطقها للمهيمن الذكر % 4(@)(@@) % خناجر من حناجر نزعت % فهي من الماءمن دم حمر % PageV01P444 البحر : - 1(@)(@@) % يا رب مقنعة حمراء تلبسها % % سوداء لليل من تركيبها قار % 2(@)(@@) % تلوح في العيدو الأبصار ترمقها % % كأنها فحمة في رأسها نار % PageV01P445 البحر : - 1(@)(@@) % أخرس ينبيك بإطراقه % عن كل ما شئت من الأمر % 2(@)(@@) % يذريعلى قرطاسهدمعة % تبدي لنا السر وما تدري % % 3(@)(@@) % كعاشق أخفى هواهو قد % % نمت عليه عبرة تجري % % 4(@)(@@) % تبصرهفي كل أحواله % % عريانيكسو الناسأو يعري % % 5(@)(@@) % يرى أسيرا في دواة و قد % % أطلق أقواما من الأسر % PageV01P446 البحر : - 1(@)(@@) % و بديعة أضحى الجمال شعارها % % صبغ الحياء رداءها وإزارها % % 2(@)(@@) % حلت نسيم عقالهاو توشحت % بالأرجوانو شددت أزرارها % % 3(@)(@@) % فالعين تحسرإن رأت إشراقها ؛ % و النفس تنعمإن بلت أخبارها % % 4(@)(@@) % فكأنهافي الكف وجنة عاشق % عبث الحياء بهافأضرم نارها % % 5(@)(@@) % محمولة حملت عجاجة عنبر % فإذا سرى ركب النسيم أثارها % % 6(@)(@@) % أمنتعلى أسرارهاريح الصبا % % وهنا فضيعت الصبا أسرارها % % 7(@)(@@) % و كأنما صافحت منها جمرة % أمنت يمينك حرها وشرارها % % 8(@)(@@) % ما أحسب النارنج إلا فتنة % هتك الزمان لناظر أستارها % % 9(@)(@@) % عشقت محاسنه العيونفلو رنت % أبدا إليهلما قضت أوطارها % % PageV01P447 البحر : - 1(@)(@@) % و روض كساه الغيثإذ جاد أرضه % % مجاسد وشي من بهار ومنثور % 2(@)(@@) % به أبيض 
ms122	 الورد الجنيكأنما % % تبسم للناشي بمسك وكافور % 3(@)(@@) % كأن اصفرارا منه فوق ابيضاضه % برادة تبر في مداهن بلور % PageV01P448 البحر : - 1(@)(@@) % و جندبة تمشي بساق كأنه % % على فخد كالعودمنشار عرعر % 2(@)(@@) % مكتبة تجلو الجناح كأنها % % عروس تجلت في عطاف معنبر % PageV01P449 البحر : - 1(@)(@@) % لسانك السيف لا يخفى له أثر % و أنت كالصل لا تبقي ولا تذر % 2(@)(@@) % سري لديك كأسرار الزجاجةلا % % يخفى على العين منها الصفو والكدر % 3(@)(@@) % فاحذر من الشعر كسرا لا جبار له % % فللزجاجة كسر ليس ينجبر % PageV01P450 البحر : - 1(@)(@@) % و ليلة من نقمات الدهر % قطعتها نزر الكرى والصبر % 2(@)(@@) % مكلم الصدر جريح النحر % مقسما بين أعاد خزر % 3(@)(@@) % كمت إذا عاينتهاو شقر % كأنها آثارها في الأزر % PageV01P451 البحر : - 1(@)(@@) % و منزل يتحامى أهله الخفر % و يفضل البدوفي نعمائهالحضر % 2(@)(@@) % فيه مع الناس أشباه لهم بعدت % في الزي عنهنإن لم تبعد الصور % 3(@)(@@) % فمن ذكور عراة كالذكور به % % و من إناث عليها الوشي والحبر % 4(@)(@@) % بدائع لطفت أفكار مبدعها % % حتى تفجر عن ماء بها الحجر % 5(@)(@@) % فكل ناحية من جدره صنم % و كل ناحية من سقفه قمر % 6(@)(@@) % صفت عن الناس فيه نعمة وصفت % فكل صفو نعيم عندهاكدر % PageV01P452 البحر : - 1(@)(@@) % لست بناف خمار مخمور % إلا بصافي الشراب مقرور % 2(@)(@@) % يطير عن رأسه القناعإذا % % نفست عنه خناق مزرور % 3(@)(@@) % رام بسهم كأنه خضر % و طيب نشر نسيم كافور % 4(@)(@@) % يميل أعلاهو هو مهتضب % كأنه صولجان بلور % PageV01P453 البحر : - 1(@)(@@) % و أزهر وضاح يروق عيوننا % % إذا ما رميناه بلحظ النواظر % 2(@)(@@) % له أربع تأبى السرى غير أنها % % تصافح وجه الأرض مثل الحوافر % 3(@)(@@) % تقل جسوما بعضها من مورد % و سائرها في مثل صبغ الدياجر % 4(@)(@@) % نواصله أيام للقر سطوة % و نهجره أيام لفح الهواجر % PageV01P454 البحر : - 1(@)(@@) % أسعيد هل لك في زيارة منزل % تثني عليه جوانح الزوار % 2(@)(@@) % رحب تلاقي الجدر منه ينابع % و ترى السماء عليه كالأقمار % 3(@)(@@) % ينضو الحيي الوجه ثوب حيائه % % فيهفيخطر كالحسام العاري % % 4(@)(@@) % متقلبا في نعمة فضفاضة % جعلت له عوضا من الأطمار 
ms123	 % 5(@)(@@) % ما عاين البادون يوما فضله % % إلا وأحفظهم على الحضار % 6(@)(@@) % و لربما استمتعت فيه بنزهة % لولاه لم تبرز من الأستار % 7(@)(@@) % و ترى على جدرانه بهم الوغى % % يخطرن ما بين القنا الخطار % 8(@)(@@) % سلت سيوفهم بغير بوارق % و جرت جيادهم بغير غبار % 9(@)(@@) % زحفان لم يحظ العزيز برتبة % فيهمو لا آب الذليل بعار % 10(@)(@@) % و منعمينعن الشمال بمعزل % لبسوا السعود بغفلة الأقدار % PageV01P455 11(@)(@@) % هذا يناوله النديم تحية % حسنتو ذا يحظى بكأس عقار % 12(@)(@@) % عيش لهم بعدت حقيقتهو إن % % قربت محاسنه من الأبصار % 13(@)(@@) % حتى إذا نعمت به أجسامنا % % و قضت به وطرا من الأوطار % 14(@)(@@) % ملنا إلى حسن الصبوح وطيبه % % إن الصبوح مطية الأحرار % 15(@)(@@) % و أحق يوم بالمدام وشربها % % يوم حباك بديمة مدرار % PageV01P456 البحر : - 1(@)(@@) % و منزل نزلته ابتكارا % % معاقرا في ظله العقارا % % 2(@)(@@) % ترى به معركة جهارا % % و قسطلا من حولها أشارا % % 3(@)(@@) % محارتين انضمتا جوارا % % قد منعت إحداهما القرارا % % 4(@)(@@) % لا يعدمان لؤلؤا صغارا % % يطيره حربهما غبارا % % 5(@)(@@) % في موقف يستوقف الأبصارا % % يكحل من قسطله الزوارا % % 6(@)(@@) % حتى يشيب منهم الأشفارا % % فلم نزل نأخذها نهارا % % 7(@)(@@) % محمرة تحسب جلنارا % % و الريح يدمي وقعها الأبشارا % % 8(@)(@@) % حربا ترى في حربنا الأحرارا % % حتى إذا الليل البهيم جارا % % 9(@)(@@) % و أسبلت ظلمته الأستارا % % و انتثر الثلج به انتثارا % % 10(@)(@@) % كما أطرت كرسفا فطارا % % كانت لنا نورا به ونارا % % PageV01P457 البحر : - 1(@)(@@) % أيها المطلون بعدي حذار % إن بعض الصخور طالب ثار % 2(@)(@@) % رب يوم ظللت فيه وقيدا % أتشكى حريق نار بنار % 3(@)(@@) % مئزر كان غاية النفع أضحى % % و هو اليوم غاية الأضرار % 4(@)(@@) % و سراويل سندس عاد وشيا % مؤلما جافيا على الأبشار % 5(@)(@@) % فكأن الأفخاذ تلذع منه % % بشرار يطير إثر شرار % 6(@)(@@) % أخذت ثأرها الحجارة مني % % و سوائي أصابها بالثار % PageV01P458 البحر : - 1(@)(@@) % و فتية تعلو بها أخطارها % % رواحها للمجد وابتكارها % % 2(@)(@@) % و ما اشتهتأنفسهاشعارها % % تطربت لنزهة أقمارها % % 3(@)(@@) % فيممت مؤنسة أقطارها % % تعوم في غدرانها أطيارها % % 4(@)(@@) % قد حليت بزهرها أشجارها % % و 
ms124	 صندلت بمدها أنهارها % % 5(@)(@@) % بمطمعات حصنت ديارها % % نجار خطي القنا نجارها % % 6(@)(@@) % تصان من بهجتها أبشارها % % صون العذارى أسبلت أستارها % % 7(@)(@@) % مصفرة ما شانها اصفرارها % % أحسن من منظرها أخبارها % % 8(@)(@@) % ترجي حسانا قبحت آثارها % % أفتك من كبارها صغارها % % 9(@)(@@) % فلست أدريأيها خيارها % % تلفح مجتاز الهواء نارها % % 10(@)(@@) % ما طار في آثارها شرارها % % طاعته لفتية تختارها % % PageV01P459 11(@)(@@) % يقعن فيما وقعت أبصارها % % حتى إذا الشمس ضبا استعارها % % 12(@)(@@) % و اصفر من مغربها إزارها % % و حان من واردة إصدارها % % 13(@)(@@) % حمر على أيديهم بوارها % % فصرعت موشية أطمارها % % 14(@)(@@) % في حلل قد شددت أزرارها % % يضحك في لجينها نضارها % % 15(@)(@@) % وفي سواد ليلها نهارها % % كروضة مختلط نوارها % % PageV01P460 البحر : - 1(@)(@@) % هذا أوان ثمار له % % وك فاجن بالكاس الثمارا % % 2(@)(@@) % إن الصغار صغيرة % فاغش الكبائر والكبارا % % 3(@)(@@) % سفرت لنا الدنياو كم % % ألقت محاسنها الخمارا % % 4(@)(@@) % و رأيت نرجسها على % % لباتها حليا معارا % % 5(@)(@@) % إن حل حل به السرو % % ر مخيما أو سار سارا % % 6(@)(@@) % ما كان قبل كأنه % % مرض العيون لها شعارا % % 7(@)(@@) % لكنه أزرى بها % % فمرضن ذلا وانكسارا % % PageV01P461 البحر : - 1(@)(@@) % يا رب نائية كأن ضرامها % % دان إذا شمناه بالأبصار % 2(@)(@@) % خفقت كما خفقت ذوائب راية % حمراء في لدن الذرى خطار % 3(@)(@@) % تفري من الليل البهيم سرادقا % دون النواظر مغدف الأستار % 4(@)(@@) % عبثت بها ريح الصبافكأنها % % كف تشير ببارق وسوار % 5(@)(@@) % يا حبذا هي في سرادق ليلنا % % و الصبح يفضح كامن النوار % PageV01P462 البحر : - 1(@)(@@) % أحبب إلي بإلف ذي مساعدة % لا أتقي الكأس منه بالمعاذير % 2(@)(@@) % يقول خذهاو كف الصبح قد أخذت % في حل جيب من الظلماء مزرور % 3(@)(@@) % و كشف البيت ذو الأطناب صفحته % % كأنه فوق صرح من قوارير % 4(@)(@@) % بيت إذا خلع الديجور حلته % % لم يخلع الصبح عنه ثوب ديجور % 5(@)(@@) % مقيد في عباب الماء يسمعنا % % إذا أطفنا بهأنات مأسور % 6(@)(@@) % كأن دهما تبارت في السباق به % % دهم الجياد تبارت في المضامير % 7(@)(@@) % إذا جرين على أرض ممسكة % أثرن بالجري منها نقع كافور % 8(@)(@@) % مازلت أشربها 
ms125	 صرفا و أمزجها % % للظبيمن فلق الأحشاء مسجور % 9(@)(@@) % في مجلس راح طوع الريح تعنته % % أنفاسها بين تقديم وتأخير % 10(@)(@@) % له جناحان نحو الشرب خفقهما % % بلؤلؤ من حباب الماء منثور % PageV01P463 11(@)(@@) % غناؤنا فيه ألحان السكورإذا % % مل الغناءو جنات النواعير % 12(@)(@@) % كأنما الريح من طيب النسيم به % % تسري إلينا بريا الورد من جور % 13(@)(@@) % حتى مضى اليوم مبيضا شمائله % % و عارضت شمسه مصفرة النور % PageV01P464 البحر : - 1(@)(@@) % يا رب جسم كله نواظر % بآمق ليست لها محاجر % 2(@)(@@) % تستر عنك الشيء وهو ظاهر % محبوبة خلالها الغوادر % 3(@)(@@) % إذا ارتدتها اللجج الزواخر % و ضمها مثل المراة مائر % 4(@)(@@) % جاءت من الرزق بها جواهر % صغائر تومض أو كبائر % 5(@)(@@) % كأنهاإذا انتحاها الناظر % مخازن الفضةأو خناجر % PageV01P465 البحر : - 1(@)(@@) % و مخطف الخصر برده حبر % نحذرهو هو خائف حذر % 2(@)(@@) % مجنح طار في مجنحة % تصعد طورا به وتنحدر % 3(@)(@@) % كأنهاو الرياح تنشرها % % غرائب الزهر حين ينتثر % 4(@)(@@) % لها حمات كأنها شعر % تظهر مسودة وتستتر % 5(@)(@@) % قد أذهبت في الجبين غرته % إذ فضضتفي جيادهاالغرر % 6(@)(@@) % سلاحهالدهرفي مؤخره % يفتك طورا به وينتصر % 7(@)(@@) % كأنما شطر ما يجرده % من بين فكيه حية ذكر % PageV01P466 البحر : - 1(@)(@@) % بعثت بها عذراء حالية النحر % مشهرة الجلباب حورية النجر % 2(@)(@@) % تأنى لها طب بإخلاص طيبها % % فأفرغ فيها روح ريحانة الزهر % 3(@)(@@) % و ألبسها وشيا يزر جيوبه % % على النحر منهاو الذيول على الخصر % 4(@)(@@) % مضمنة ماء صفا مثل صفوها % % فجاء كذوب التبر في جامد الدر % 5(@)(@@) % ينوببكفيعن أبيهو قد مضى % % كما نبت عن آبائك السادة الغر % 6(@)(@@) % و يشركني في نشره الريح غدوة % فتجري إلى الآفاق طيبة النشر % 7(@)(@@) % فيا لك من بر يخبر عن فتى % حفي بنافي كل نائبة بر % 8(@)(@@) % فإن يك حياني بها فارسية % فسوف أحييه بمعربة بكر % % 9(@)(@@) % و كم من يد للحر عندي ثيب % كشفت محياها بقافية بكر % PageV01P467 البحر : - 1(@)(@@) % لو تداركتني بوعد غرور % رقأت عبرتيو قل زفيري % % 2(@)(@@) % بأبي خدك الذي وقف الدم % % ع عليه كالطل في ورد جور % 3(@)(@@) % فالتهاب الحياء 
ms126	 يمزج فيه % % حمرة الأرجوان بالكافور % 4(@)(@@) % عبق ريحه كأن دموع ال % % عين أجرت عليه ماء العبير % 5(@)(@@) % لا تلمني على انتثار دموعي % % حين عاينت روضة المنثور % 6(@)(@@) % قابلتني بمثل خدك والثغ % % ر وأنوار حليك المستنير % PageV01P468 البحر : - 1(@)(@@) % لست أرجي انحطاط أوزاري % % ما عمر الله أم عمار % 2(@)(@@) % رضيت بالعار في المجونو هل % % يسخط مثلي تتابع العار % 3(@)(@@) % و جار شيبي علي مجتهدا % فما أرى الشيب أهل إكبار % 4(@)(@@) % و شادن لا يزال يمنحني % % إذا انتشى قبلة بدينار % 5(@)(@@) % تريك أجفانه ونخوته % % ذل ضعيف وتيه جبار % 6(@)(@@) % فالدعص والغصن في غلائله % % و الليل والصبح فوق أزرار % 7(@)(@@) % و النحر والخصر منه قد قسما % % بين صليب وبين زنار % 8(@)(@@) % دنا من الدن حاسرا فجرى % % منه عقيق ينسل من قار % 9(@)(@@) % كشاطر هم بالعدو فما % % أقصر حتى رأى دما جاري % % 10(@)(@@) % فرجي عفيف عن الحرام ول % % كن لساني لسان عيار % PageV01P469 البحر : - 1(@)(@@) % آثار جودك في الخطوب تؤثر % و جميل بشرك بالنجاح يبشر % 2(@)(@@) % كان ابتداؤك شيمة عدوية % تنبي عن الكرم التليد وتخبر % 3(@)(@@) % و صنيعة سمع الملوك بفضلها % % و الجود يسمع والصنائع تشهر % 4(@)(@@) % فعلام كف المنع منك أناملي % % و سماء كفك بالمواهب تمطر % 5(@)(@@) % لي من نوالك كل شهر عادة % مضت الليالي دونها والأشهر % 6(@)(@@) % فابسط بها باعا يطول إلى الندى % % فيضيق باع الخطب فيه ويقصر % 7(@)(@@) % إن كان لي أمل سواك أعده % فكفرت أنعمك التي لا تكفر % PageV01P470 البحر : - 1(@)(@@) % و ندمان دعوت إلى العقار % و قد فضح الدجى ضوء النهار % 2(@)(@@) % فقلتألا تقوم إلى عروس % أتت في حلة من جلنار % 3(@)(@@) % فقام وفي جوارحه فتور % و في أجفانه سنة الخمار % 4(@)(@@) % و مقلته تخبر من رآها % % بما سرقته من لون العقار % PageV01P471 البحر : - 1(@)(@@) % يا حبذا تحية % رحت بها مسرورا % % 2(@)(@@) % إذ جاءني يحملها % % ظبي يباهي الحورا % % 3(@)(@@) % شبهتها في كفه % و قد كساها نورا % % 4(@)(@@) % مخزنة من ذهب % قد ملئت كافورا % % PageV01P472 البحر : - 1(@)(@@) % قصاراك في اللوم أن تقصرا % % و حقي في 
ms127	 الغي أن أعذرا % % 2(@)(@@) % و لم أنس يومي بقطربل % و ليلي على القفصأو عكبرا % % 3(@)(@@) % زمان تمليته مقبلا % و عيش تلقيته مسفرا % % 4(@)(@@) % و ملآن من عبرات الكروم % كأن على فمه عصفرا % 5(@)(@@) % إذا قربته أكف السقاة % من الكأس قهقه واستعبرا % % 6(@)(@@) % تروحه عذبات الغرام % بريا النسيمإذا ما جرى % % 7(@)(@@) % و ريم إذا رام حث الكؤو % % سقطب للتيه واستكبرا % % 8(@)(@@) % و جرد من طرفه خنجرا ؛ % و من نون طرته خنجرا % % 9(@)(@@) % ترى ورد وجنته أحمرا % و ريحان شاربه أخضرا % % 10(@)(@@) % شكرنا لإدريس أفعاله % % و حق لإدريس أن يشكرا % % PageV01P473 11(@)(@@) % عرفنا به طرق المنكرات % و لولاه لم نعرف المنكرا % % 12(@)(@@) % فطورا يعيد لنا كدة ؛ % و طورا يعيد لنا شوذرا % % 13(@)(@@) % إذا عمرت داره لم أطل % بكاي على منزل أقفرا % % 14(@)(@@) % و إن قدمت يومه النائبات % فلست أسر بمن أخرا % % PageV01P474 البحر : - 1(@)(@@) % نل من الأيام ثارا % % و انتصر منها انتصارا % % 2(@)(@@) % بشراب يشبه التف % % فاح طيبا واحمرارا % % 3(@)(@@) % و شقيق جاده الغي % % ث رواحا وابتكارا % % 4(@)(@@) % مثل ما أترع ساقي الر % راح أقداحا صغارا % % PageV01P475 البحر : - 1(@)(@@) % كفرتو لم أشكر نصيحة فارس % و كم من نصيح مثله حرم الشكرا % % 2(@)(@@) % أراني طريق الاعتزالو لم يرد % % سوى أن أسب اللهو العالم الطهرا % % 3(@)(@@) % سأستأذن القرآن فيما دعوتني % % إليهو لا أعصي لمنزله أمرا % % PageV01P476 البحر : - 1(@)(@@) % أبا حسن إن وجه الربيع % جميل يزان بحسن العقار % 2(@)(@@) % فإن الربيع نهار السرو % % ر والراح شمس لذاك النهار % 3(@)(@@) % و إنك مشرقهاإن أردت % و إن لم ترد غربت في استتار % 4(@)(@@) % فأجر إلي بجار العقار % فمن فيض كفيك فيض الجرار % % 5(@)(@@) % فقد عبأ الهم لي جيشه % % و ليس له غير جيش الخمار % PageV01P477 البحر : - 1(@)(@@) % خليليإن الغيث أوله قطر % و نار الهوى قد صار دخانها جمر % 2(@)(@@) % فلا تعذلاني إن هويتفإنني % % هويت رجاء أن يساعدني الدهر % 3(@)(@@) % فلما أبان الدهر لي غدر أهله % % توليت عنهمإذ تداركني الصبر % 4(@)(@@) % فكم من محب قد تبين غدره % فرام اصطبارا فاستقاد له الصبر % 5 
ms128	(@)(@@) % فلم يك قلبي في الهوى مثل قلبه % % فلله حمد دائم و له الشكر % 6(@)(@@) % سأترك من أهوى بما هو أهله % % و لو كان من أهوى يشاكله البدر % 7(@)(@@) % و أصبو إلى قول الذي قد عرفتما % % ألا سقني خمرا و قل لي هي الخمر % 8(@)(@@) % ألا سقياني من سلافة خمرة % يجانبها المحمود والأبله الغمر % 9(@)(@@) % مصفقة كأسا كأن شعاعها % % تورد خد حين يبدو به السكر % 10(@)(@@) % فإن كسروها بالمزاج حكت لنا % % غلائل عشاق أضر بهم هجر % PageV01P478 11(@)(@@) % فلا خير في القربى إذا ما مللتني % % و لا خير في نعمى يقاربها كفر % PageV01P479 البحر : - 1(@)(@@) % عنت تحاوره بطرف أحور % يوم النوى و بورد خد أحمر % 2(@)(@@) % و نظام ثغر ما تهلل وشيه % % إلا بكى خجلا نظام الجوهر % 3(@)(@@) % يهدي إليك نسيمهفكأنما % % شيبت جوانبه بمسك أذفر % 4(@)(@@) % غصن تعالى في كثيب أعفر ؛ % ليل تداجى في صباح مسفر % 5(@)(@@) % شمس يهب على القلوبإذا بدت % عن صحن وجنتهانسيم العنبر % 6(@)(@@) % لم يجتذب طرفا شمائل طرفه % % إلا ثنته حائرا في المحجر % 7(@)(@@) % قرأت علي بزفرة ألفاظها % % آيات شوق في حشاها مضمر % 8(@)(@@) % فكأنما نظرت إلي بناظر % و تحدثت عن قلبي المستهتر % 9(@)(@@) % خلعت لواحظها على وجناتها % % خلع الجوانح بالدموع الهمر % 10(@)(@@) % و تساقطت في وردهافكأنها % % طل تساقط فوق ورد أحمر % PageV01P480 11(@)(@@) % وصلتو لا وقديم حرقة هجرها % % ألا أستلذ الوصل ما لم أهجر % 12(@)(@@) % عطفت علي بصوب ماء وصالها % % عطف الحسين على رجاء المقتر % 13(@)(@@) % ملك أذل الوفد جود يمينه % % حتى تغور في العلاء الأكبر % 14(@)(@@) % تحكي يميناه يميني عابد % و يقولإن لم أحكه لم أعذر % 15(@)(@@) % و كذا الفتى إن لم يذكر سيفه % % و فعاله بصلاته لم يذكر % 16(@)(@@) % شغلت روائحه العجاجو طيبها % % بين القناعن طيب ريح المجمر % 17(@)(@@) % لقرينه بين الصفوف سحائب % موصولة بسحاب ريح صرصر % 18(@)(@@) % يلقى العدو بسيفه وجبينه % % و يقول ليس يكون ما لم يقدر % 19(@)(@@) % تأبى معالي مجده أن يكتسي % % رعدا لقرن أو يرى في مغفر % 20(@)(@@) % أي القلوب أزاره سطواته % % عن 
ms129	 سطوة منهفلم يتفطر % % PageV01P481 21(@)(@@) % أم أي وهم رام كنه صفاته % % متحيرا فيهفلم يتحير % 22(@)(@@) % عجل الرماح إلى الأعاديمسعر % يأبى سوى طعن الشجاع المسعر % 23(@)(@@) % و إذا ارتقى درج العلا قالت له % % أوفيت أقصى المرتقى فتصدر % 24(@)(@@) % يقظ إذا اتقدت عزائم رأيه % % أخمدن رأي الناكب المتجبر % 25(@)(@@) % يا أيها الآمالأنت صوائب ؛ % هذا الحسين أبو الحسينفأقصري % % 26(@)(@@) % حطى رحالك بين خمس يمينه % % فلقد تقوم مقام سبعة أبحر % PageV01P482 البحر : - 1(@)(@@) % و ذي غنج يرنو بمقلة جؤذر % متى يغد فيه خالع العذر يعذر % 2(@)(@@) % له فوق ورد الخد خال كأنه % % إذا احمر ورد الخدنقطة عنبر % PageV01P483 البحر : - 1(@)(@@) % ذو قلم عز جانباه % فذا نعيم و ذا بوار % 2(@)(@@) % مثقف كله سنان % و منصل كله غرار % 3(@)(@@) % يفيض في الطرس منه بحر % يمده السبعة البحار % PageV01P484 البحر : - 1(@)(@@) % كيف يخشى الملحي رقة حال % بعد أن فاز من قفاه بكنز % 2(@)(@@) % و له غرفة يؤلف فيها % % بين تيس من الرجال وعنز % 3(@)(@@) % صافه عرضهفنجاه مني % % إن عرض الملحي أمنع حرز % 4(@)(@@) % قد لعمري رفعته بهجائي % % و ارتفاع المصلوب ليس بعز % 5(@)(@@) % فإذا ما وخزته بسنان الذم % % لم يمتعض لشدة وخزي % % PageV01P485 البحر : - 1(@)(@@) % و مستدير بلا قطب يدور به % و لا له وتد في الأرض مركوز % 2(@)(@@) % كأنه فلك تنقض أنجمه % إذا تصوب من كيزانه كوز % PageV01P486 البحر : - 1(@)(@@) % لما أجد الليل في انحيازه % % و لاح ضوء الصبح من أعجازه % % 2(@)(@@) % دعوت سعدا فأتى ببازه % تحمل يسراه على قفازه % % 3(@)(@@) % ضامن زاد جد في إحرازه % % ندبا هوان الطير في إعزازه % % 4(@)(@@) % أقرانه تنكل عن برازه % % يبادر الفرصة في انتهازه % % 5(@)(@@) % كأنما راح إلى برازه % % فابتزه الموشي من طرازه % % 6(@)(@@) % فصاد قبل الشد في اجتيازه % % خمسينحزناهن باحتيازه % % 7(@)(@@) % ما أسلف البرفلم يجازه % % و لا خلا في الوعد من إنجازه % % PageV01P487 البحر : - 1(@)(@@) % ألا عد لي بباطية وكاس % ورع همي بإبريق وطاس % 2(@)(@@) % و ذكرني بشعر أبي نواس % على روض كشعر أبي نواس % 3(@)(@@) % و غيم مرهفات البرك فيه % % عوار و الرياض به 
ms130	 كواسي % % 4(@)(@@) % و قد سلت جيوش الفطر فيه % % على شهر الصيام سيوف باس % 5(@)(@@) % و لاح لنا الهلال كشطر طوق % على لبات زرقاء اللباس % PageV01P488 البحر : - 1(@)(@@) % در الخطوب على الفوارس % و طلابها الصيد الأشاوس % 2(@)(@@) % و الدهر يطرق بالفوا % % دح أو يصبح بالدهارس % 3(@)(@@) % غاز يظفر بالنفو % % سو بالذخيرات النفائس % 4(@)(@@) % أردى مقاول تبع % و سطا على أحرار فارس % 5(@)(@@) % غاداهم متنمرا % فغدت سعودهم مناحس % 6(@)(@@) % و ملوك كندة حط عن % % تلك الأسرة والقرابس % % 7(@)(@@) % مازال يعمل فيهم % طعن المصالت والمخالس % % 8(@)(@@) % فابتزهم محمرة الت % تيجانأو شهب القوانس % % 9(@)(@@) % و كذاك أطفأ من أبي % % قابوس جمرة كل قابس % % 10(@)(@@) % و أصاب جبار المدا % % ئنقائم الفئتين جالس % % PageV01P489 11(@)(@@) % متفيئا ظل السيو % % فو تارة ظل الفرادس % % 12(@)(@@) % يغدو الخميس أمامه % % جم الغماغم والوساوس % % 13(@)(@@) % و الناس أعراض الحتو % % ففمطلق سهما وحابس % % 14(@)(@@) % ترمي القصور الواضحا % % ت بهم إلى الغبر الدوارس % % 15(@)(@@) % إني لمن قوم مضوا % % شم المآثر والمعاطس % 16(@)(@@) % راع يسير القوم تح % % ت لواء منكبه وسايس % % 17(@)(@@) % و فتىإذا قيس الغما % % م بنيله ظلم المقايس % % 18(@)(@@) % يهدى له در المحا % % مد حشو أصداف القراطس % % 19(@)(@@) % ما نيل مجدهموإني % % يلمس الجوزاء لامس % % 20(@)(@@) % قصدتهم رقش الحوا % % دث بين ناهسة وناهس % % PageV01P490 21(@)(@@) % و ثنت إليهم أوجه الن % نكبات باسلة عوابس % 22(@)(@@) % و تنبهت منهم لبا % % قي العز والشرف القدامس % % 23(@)(@@) % فجعوا بأحمد مستضا % % م القرن مخترم المنافس % % 24(@)(@@) % عبق الحمائل والأعن % نةو القوائم والمعاجس % % 25(@)(@@) % ما لي أرى الربض اقشعر % ر لفقدهفتراه يابس % 26(@)(@@) % و ارتد مسود النها % % رو كان مبيض الحنادس % % 27(@)(@@) % و غدت تجر بساحتي % ه ذيولها النكب الروامس % % 28(@)(@@) % و لقد أراه مفوف ال % % أبراد مهتز المغارس % % 29(@)(@@) % حالي الرياض مصقل ال % % غدرانرقراق المجالس % % 30(@)(@@) % فكأنما انتثرت علي % % ه عقود لبات العرائس % % PageV01P491 31(@)(@@) % و كأنما اتشحت ربا % % ه مجاسد الغيد الأوانس % % 32(@)(@@) % و كأن راحة ريحه % % عبثت ببسباس البسابس % % 33(@)(@@) % و كأن يوم الدجن من % % ه لغرة المفقود شامس % % 34 
ms131	(@)(@@) % يا ابن السري سرى الغما % % م إليك بالغر الرواجس % % 35(@)(@@) % حتى يعود إليك غصن % % العود مخضر الملابس % % 36(@)(@@) % و لئن رحلت عن الأني % % س إلى محل غير آنس % % 37(@)(@@) % فالدهر ليس يفوت رك % % ض خطوبه ركض الفوارس % % 38(@)(@@) % أو ما رأيت ضراغم الد % دنيا لوثبته فرائس % % PageV01P492 البحر : - 1(@)(@@) % و عقفاء مثل هلال السما % % ء لكنها لبست سندسا % % 2(@)(@@) % عراقية لم يذب جسمها % % هزالا و لم تجس فيما جسا % % 3(@)(@@) % زبرجدة حسنت منظرا % و كافورة بردت ملمسا % % 4(@)(@@) % على رأسها زهرة غضة % كنجم الظلامإذا عسعسا % % 5(@)(@@) % حبانا بها مغرس طيب % من الأرض أكرم به مغرسا % % 6(@)(@@) % لها أخوات لطاف القدود % إذا ما تبرجن خضر الكسا % % 7(@)(@@) % محجبة عن شموس النهار % و بارزة لنسيم المسا % % 8(@)(@@) % تقوس في حين ميلادها % % و لم أر ذا صغر قوسا % % 9(@)(@@) % يطول اللسان بإطرائها % % و يصبح عن ذمها أخرسا % % PageV01P493 البحر : - 1(@)(@@) % فقدتأبا عمرانعرسا شفيقة % لها لوعة يدمى عليك رسيسها % % 2(@)(@@) % و كاتبةأقلامهاحين تنتضى % % حديد و أعناق النساء طروسها % % 3(@)(@@) % و أبقت فراخا حين أعدمن زقها % % تصرم نعماها وعاود بوسها % % 4(@)(@@) % فمن ذا يقيها السوء أم من ينجها % % دماء ذوات الذل أم من يسوسها % % 5(@)(@@) % تعز فإنا للحمام نفوسنا % % كذاك الغواني للحمام نفوسها % % PageV01P494 البحر : - 1(@)(@@) % عفاء على اللذات من بعد فارس % فقد عطلت منه حسان المجالس % 2(@)(@@) % جلا حر وجه قد أضاء بثوبه % % كأن سناها فيه شعلة قابس % 3(@)(@@) % تكسر أصناف المعازف بعدها % % كما عقر الأفراس بعد الفوارس % 4(@)(@@) % مضى حسب الزفن التليدو أصبحت % رسوم الملاهي كالرسوم الدوارس % 5(@)(@@) % نعيم رمته الحادثات بفادح % فزالو سعد أردفته بناحس % 6(@)(@@) % و مختلس من حومة اللهو لم تنل % مقاتله أيدي الحمام المخالس % 7(@)(@@) % تسلب روض الياسرية بعده % % و كان جديد الحليغض الملابس % 8(@)(@@) % و جنت ثمار الرند وردا و طالما % % تصدعن ريا في رطاب موائس % 9(@)(@@) % يردد في غرس البطالةبعده % % عيونا تراه مقشعر المغارس % 10(@)(@@) % فما للتقى عار به مشهد الصبا % % و كاد المنى كيد العدو المنافس % PageV01P495 11(@)(@@) % و ما 
ms132	 بال أعناق الكؤوس عواطلا % و كانت به في مثل حلي العرائس % 12(@)(@@) % و ما بال حانات العراق تنكرت % فأصبح منها موحشا كل آنس % 13(@)(@@) % أرى وردها ما بين مود وذابل % و ريحانها ما بين ذاو ويابس % 14(@)(@@) % فدتك نفيسات النفوس من الردى % % و مثلك يفدى بالنفوس النفائس % 15(@)(@@) % نسكتفلا ليل الغبوق بمقمر % عليناو لا يوم الصبوح بشامس % 16(@)(@@) % كأنك لم تحد الكؤوسو قد حدت % طليعة ضوء الصبح غير الحنادس % 17(@)(@@) % و لم تؤنس الشرب الكرام بمخطف % من الزنج حنان الغدو مؤانس % 18(@)(@@) % و قد فتق الإصباح رفق جفونهم % % و قارع طيب الغمض قرع النواقس % 19(@)(@@) % هوى درست أعلامه فكأنما % % ترامت به أيدي الرياح الروامس % 20(@)(@@) % و ربع شكا من فرقة اللهو ما شكت % ربوع التصابي من فراق الأوانس % PageV01P496 21(@)(@@) % فليس هزار الشدو فيه بناطق % و ليس قضيب الرقص فيه بمائس % 22(@)(@@) % أأرغب في اللذات من بعد فارس % و قد رميت من نسكه بالدهارس % 23(@)(@@) % فتبا لهاإذ تاب من نقر دفه % و لا سقيت صوب الغيوث الرواجس % PageV01P497 البحر : - 1(@)(@@) % من ذم إدريس في قيادته % فإنني حامد لإدريس % 2(@)(@@) % كلم لي عاصيا فكان له % % أطوع من آدم لإبليس % 3(@)(@@) % و كان في سرعة المجيء به % آصف في حمل عرش بلقيس % PageV01P498 البحر : - 1(@)(@@) % محلك من وصل الأحبة آنس % و غصنك من ماء الشبيبة مائس % 2(@)(@@) % تمتع من اللذات قبل نفادها % % و بادرفإنا للخطوب فرائس % 3(@)(@@) % ألا حبذا المرج العليل نسيمه % % إذا نبهتني للصبوح النواقس % 4(@)(@@) % و مالت غصون زينتها مناطق % و لاحت شموس توجتها حنادس % 5(@)(@@) % و دارت على الندمان من خمر بابل % عروس حوت حسن الصباو هي عانس % 6(@)(@@) % ألم ترني أجررت في اللهو مقودي % % فأضحكت أياميو هن عوابس % 7(@)(@@) % و لم أعب بالوعد الذي وعد الورى % % فمنكان يرجوهفإني آيس % PageV01P499 البحر : - 1(@)(@@) % رأت شيئا يضاحكهافصدت % و كان جزاؤه منها العبوسا % % 2(@)(@@) % و قالتإذ رأت للمشط فيه % % سوادا لا يشاكله نفيسا % 3(@)(@@) % تلق العاج منه بمشط عاج % و دع للآبنوس الآبنوسا % % 4(@)(@@) % فإن 
ms133	 أسيت لجرح الشيب نفسي % % فإن الشيب جرح ليس يوسى % % PageV01P500 البحر : - 1(@)(@@) % قد تركت عرس أبي جعفر % فؤاده في الحب مخلوسا % % 2(@)(@@) % و آثرت فيشة موسى لما % % غادره من بظرها الموسى % % 3(@)(@@) % فأطلقت فيها وفي بعلها % % كل لسان كان محبوسا % % PageV01P501 البحر : - 1(@)(@@) % إذا ما دعونا لاحقا ومعانقا % و قيد لدينا واثب ومخالس % 2(@)(@@) % فذلك يوم جانب السعد سربه % % و قوبل بالنحس الظباء الكوانس % 3(@)(@@) % كأن جلود الوحش بين كلابه % % و قد دميت أجيادها والمعاطس % 4(@)(@@) % مصندلة القمصان شقت جيوبها % % و رقرق فيها الزعفران الفرائس % PageV01P502 البحر : - 1(@)(@@) % إذا غضبتفلا تعجل بسيئة % فالعفو شأنكم يا آل عباس % 2(@)(@@) % و كن صفوحا فإن الصفح منقبة % أذكى من الوردغب القطرو الآس % 3(@)(@@) % فإنما الحمد مناو الثواب غدا % لكاظم الغيظ والعافي عن الناس % PageV01P503 البحر : - 1(@)(@@) % و جسوم إذا الرؤوس علتهن % ن أثارت حلت قواها الرؤوس % 2(@)(@@) % موتها من نفوسهاو عجيب % من جسوم بدنهن النفوس % PageV01P504 البحر : - 1(@)(@@) % بؤسا لعرس الخالدي بوسا % % أكل يوم تغتدي عروساحذف % % 2(@)(@@) % خلته و اعتاضت فتى نفيسا % % و فارقت من نتنه ناووساحذف % % 3(@)(@@) % فصادفت ربع هوى مأنوسا % % و بدلت من رخم طاووساحذف % % 4(@)(@@) % و كيف تهوى وجهه العبوسا % % و هي ترى الأقمار والشموساحذف % % PageV01P505 البحر : - 1(@)(@@) % قد أشكل الأمرفهل من فاحص % حتام لا أنفك من مقارص % 2(@)(@@) % مطارد شعري طراد قانص % لوى عن الدر يمين الغائص % 3(@)(@@) % و عاب إبريز الخلاص الخالص % و شاهدي بالفضل عيب الناقص % PageV01P506 البحر : - 1(@)(@@) % و لينوفر أوراقه الخضر تحته % % بساط إليه الأعين النجل شخص % 2(@)(@@) % إذا غاص في الماء النمير حسبته % رؤوس إوز في غياض تغوص % PageV01P507 البحر : - 1(@)(@@) % قد أغتدي قبل وجوب الفرض % و الجفن قد ودع طيب الغمض % 2(@)(@@) % و بارق الأفق كليل الومض % كأنه عرق ضعيف النبض % 3(@)(@@) % بكل وافي الطرفين محض % مبتذل الوفر مصون العرض % 4(@)(@@) % قد نصبوا للحائن المنقض % قدا يعض الساق أي عض % 5(@)(@@) % ضعف عيون لم تشن بغض % لها مآق رسبت في الأرض % 6(@)(@@) % طارقها في قلق ونفض % يضرب بعض ريشه ببعض % 7 
ms134	(@)(@@) % بين علو موبق وخفض % و نهض لا منتفع بنهض % 8(@)(@@) % فكم رمت ذا بسطة بقبض % و أمسكت بكرا على مفتض % 9(@)(@@) % معاجل سوارها بفض % يا لك من آلة رزق غض % 10(@)(@@) % تملأ كفي رائد وترضي % % PageV01P508 البحر : - 1(@)(@@) % و مارقة مرق السهام تضمها % % قرارة مسجور طمى ثم عرمضا % % 2(@)(@@) % بعثت لها جسما لحاظ عيونه % % إذا أعرضتحتف لهن تعرضا % % 3(@)(@@) % ترحل عن أوطانه كل مكره % إذا بان عن أوطانه ساعة قضى % % 4(@)(@@) % و كل مليح القدإن نشر الردى % % عليه رداءلاح فيه وأومضا % % 5(@)(@@) % كأن يد المرتادإذا ظفرت به % % مجردة منه سنانا مفضضا % % PageV01P509 البحر : - 1(@)(@@) % خذا من العيشفالأعمار فانية % و الدهر منصرف و العيش منقرض % 2(@)(@@) % في حامل الكأس من شمس الضحى خلف ؛ % و في المدامة من بدر الدجى عوض % 3(@)(@@) % كأن نجم الثريا كف ذي كرم % مبسوطة للعطاياليس تنقبض % 4(@)(@@) % دارت علينا كؤوس الخمر مترعة % و للدجى عارض في الجو معترض % 5(@)(@@) % حتى رأيت نجوم الليل غائرة % كأنهن عيون حشوها رمض % PageV01P510 البحر : - 1(@)(@@) % ثنتني عنكفاستشعرت هجرا % خلال فيك لست لها براضي % % 2(@)(@@) % و أنك كلما استودعت سرا % أنم من النسيم على الرياض % PageV01P511 البحر : - 1(@)(@@) % ألا رب ليل بت أرعى نجومه % % فلم أغتمض فيهو لا الليل أغمضاحذف % % 2(@)(@@) % كأن الثريا راحة تشبر الدجى % % لتعلم طال الليل لي أم تعرضاحذف % % 3(@)(@@) % عجبت لليل بين شرق ومغرب % يقاس بشبر كيف يرجى له نقضاحذف % % PageV01P512 البحر : - 1(@)(@@) % و صفراء من ماء الكروم شربتها % % على وجه صفراء الغلائل غضةحذف % % 2(@)(@@) % تبدت و فضل الكأس يلمع فوقها % % كأترجة زينت بإكليل فضةحذف % % PageV01P513 البحر : - 1(@)(@@) % بين الشنوف الحمر والأقراط % أجياد فاترة الجفون عواطي % % 2(@)(@@) % وصلت بنا سكر الصبابة وانثنت % سكرى القدود نحائف الأوساط % 3(@)(@@) % و علت ثمار صدورها أجسادها % % فحرمن مس مجاسد ورباط % 4(@)(@@) % لم أرض سقيا الدمعو هو رضى لها % % فشرطت سقياها على الأشراط % 5(@)(@@) % و لقد تسلفني الجوى و ترينه % % بسوالف الرشإ الأحم العاطي % % 6(@)(@@) % و حقاق عاج نقطت أطرافها % % بالمسك لم تنسب إلى خراط % 7(@)(@@) % و مرجل لا 
ms135	 صبح في ظلماته % % إلا حلمة الأمشاط % 8(@)(@@) % صقلت سلاسله . . . وكسرت % بأنامل مثل اللجينسباط % 9(@)(@@) % أيام للقلب المفرط في الصبا % % ما شاء من فتك ومن إفراط % 10(@)(@@) % إذ للعواذل غفلتي وتكاسلي % % و إلى الغواية نهضتي و نشاطي % % PageV01P514 11(@)(@@) % أختال بين جآذر ومزاهر % و أرود بين دساكر و بواطي % % 12(@)(@@) % و الروض قد نشر الحيا أنماطه % % فكأنهن غرائب الأنماط % 13(@)(@@) % ما للزمان سطا على أشرافنا % % فتخرموا وعفا عن الأنباط % % 14(@)(@@) % أعداوة لذوي العلى أم همة % سقطت فمال بها إلى السقاط % 15(@)(@@) % خضعت رقاب بني العداوة إذ رأت % آسارها يتعد تحت سياطي % % 16(@)(@@) % حتى إذا نكصت على أعقابها % % دلف النبيط إلي من شمشاط % 17(@)(@@) % صدق المعلم أنه من أسرة % عرب يسوسهم بنو سنباط % 18(@)(@@) % آباؤك الأشراف إلا أنهم % % أشراف موش وشاطح وخلاط % 19(@)(@@) % نسب يبين عن سقوطك نشره % % كالثوب تنشره عن الأسفاط % 20(@)(@@) % ثكلتك دامية القرا مجلودة % نبذتك خائفة بغير قماط % PageV01P515 21(@)(@@) % عجلت فلم تحتط عليك من الردى شاهدتها حسناء يقرع بابها للخسر وفد زنا ووفد لواطولقطت يانعة الثمار فلم أجد لنمار دوحتها أوان لقاطثنوية تعطى الصديق قيادها وتفل غرب عدوه المتعاطى % % و رجت حياطة مسلم محتاطسقط أبيات ص % % 22(@)(@@) % جفت الخلوقفليس يعرف جسمها % % إلا خلوق مواقع الأسواط % 23(@)(@@) % قد كانت الدنيا عليك فسيحة % فاليوم أضحتو هي سم خياط % 24(@)(@@) % أسخطتنيو جناة عيشك حلوة % فجنيت مر العيش من إسخاطي % % 25(@)(@@) % و علمتإذ كلفت نفسك غايتي % % أن الرياح بعيدة الأشواط % 26(@)(@@) % أترومنيو على السماك محلتي % % شرفا و بين الفرقدين صراطي % % 27(@)(@@) % من بعد ما رفع الأكابر مجلسي % % فجلست بين مؤمر و سماط % 28(@)(@@) % و غدت صوارم منطقي مشهورة % بين العراق تهز والفسطاط % % 29(@)(@@) % و حططت منزلة العدو بمقول % كشبا الأسنة رافع حطاط % 30(@)(@@) % هيهات دون مناك حز مفاصل % و جراح أفئدة ونزع نياط % PageV01P516 31(@)(@@) % أغراك جهلك بالقريض ورثه % حتى انتحاك بمخلب عطاط % 32(@)(@@) % و قد امتحنت دعاويا لك بينت % عن بحر تمويه بعيد الشاطي % % 33(@)(@@) % فرأيت علمك من خرا وخراطة % و وجدت سعدك من 
ms136	 فسا وضراط % 34(@)(@@) % و غريبة أضحت لعرضك شامة % علما كما أعلمت ثوب قباطي % % 35(@)(@@) % تركتك نزر القسط من طيب الكرى % % و من الهموم موفر الأقساط % 36(@)(@@) % لفظ تراه عقاربا مبثوثة % و يراه غيرك جوهر الأسفاط % 37(@)(@@) % فاصبر لتقطيع القذال ومن أصن % عنه الحسام أدعه للمشراط % 38(@)(@@) % قل للغواة المسرعين بنصره % إسراع واردة القطا الفراط % 39(@)(@@) % سأعيد بسط القول في أعراضكم % % و الجور للسفهاء خير بساط % 40(@)(@@) % شاموا بوارق حينهمو استنبطوا % % ماء المنية أيما استنباط % PageV01P517 41(@)(@@) % حراث مزرعة وأحمق لحية % و معلم ينمى إلى خياط % 42(@)(@@) % لو حد منتهب القريض تجاوزوا % % في الحدأو قطعوا من الآباط % 43(@)(@@) % كفوافلست أعرض الحسب الذي % % لا خلط فيه لمعشر أخلاط % PageV01P518 البحر : - 1(@)(@@) % انظر إلى صورة مكملة % كأن منها المدام قد خلطا % % 2(@)(@@) % تبرية اللونفي محاسنها % % كعاشق من حبيبه قنطا % % 3(@)(@@) % كأنها كف حاسب عجلت % فهي من الخوف تحذر الغلطا % % PageV01P519 البحر : - 1(@)(@@) % و ركب أمموا قحطا % % نو الليل بهم يسطو % % 2(@)(@@) % فحطوا رحلهممنه % % بوادي الجدبإذ حطوا % % 3(@)(@@) % و أنى يفعل الخير % فتى نصف اسمه قحط % PageV01P520 البحر : - 1(@)(@@) % إلف الخيال أراك إلفا شاسعا % % وصل الهجوع وزار ركبا هاجعا % % 2(@)(@@) % أهلا بمبتسم تغيب آفلا % بدر التمامو قد تجلى طالعا % % 3(@)(@@) % لتلذ لي بين العقيق مضاجعي % % ما دام طيفك لي يهز مضاجعا % % 4(@)(@@) % أبت الركائب أن تعنو قد دعت % قلبا تأبى ثم أصحب طائعا % % 5(@)(@@) % بأوانس تدع الدموع أوانسا % و رواتع تدع القلوب رواتعا % % 6(@)(@@) % لم تنكشف عنها البراقع لوعة % إلا وألبسها الحياء براقعا % % 7(@)(@@) % كتمت سجوف الرقم ذائع حسنها % % و أعدن مكتوم الصبابة ذائعا % % 8(@)(@@) % فسفرن عن شيم الوداد بواذلا % من وصلنا ما كن قبل موانعا % % 9(@)(@@) % لو رمن تضييع العهود ونقضها % % لحفظن درا في المحاجر ضائعا % % 10(@)(@@) % يغتالنا البين المفرق شملنا % % و تبيحنا الأحلام شملا جامعا % % PageV01P521 11(@)(@@) % خلع السرور بعرصتيك عذاره % % ما افتاد فيك جوى الصبابة خالعا % % 12(@)(@@) % و سقت دموع الغيث ربعك ما سقت % منا لذكراك الدموع مدامعا % % 13(@)(@@) % غدت الوفود بنظم حمد شائع % لما رأت 
ms137	 كرما وفضلا شائعا % % 14(@)(@@) % و ثنى الرجاء إلى ابن فهد عطفه % % فغدا على ربع المكارم رابعا % % 15(@)(@@) % ملك يمد إلى العفاة أناملا % كادت تكون من السماح ينابعا % % 16(@)(@@) % أوفى فأشرق بين نشر ساطع % قمر يعيد الليل فجرا ساطعا % % 17(@)(@@) % متتابع المعروف ينبع في الندى % % و البأس أدواء له وتبايعا % % 18(@)(@@) % فإذا رآك البشر برقا لامعا % منهأراك الجود غيثا هامعا % % 19(@)(@@) % تنتابه نوب الخطوبفتنثني % % عنهو هل تثني الخطوب متالعا % % 20(@)(@@) % حلم يرد البأس فيه كأنه % % غمد حوى عضب المهزة قاطعا % % PageV01P522 21(@)(@@) % لما استعنت على الزمان بجوده % % أعطى المنى قسرا و كان ممانعا % % 22(@)(@@) % كم معرك عرك القنا أبطاله % % فسقاهم في النقع سما ناقعا % % 23(@)(@@) % هبت رياحك في ذراه سمائما % و غدت سماؤك تستهل فجائعا % % 24(@)(@@) % فتركت من حر الحديد مصائفا % فيهو من فيض الدماء مراتعا % % 25(@)(@@) % و غدوت من حب الوقائع باسطا % يمناك توقع في التليد وقائعا % % 26(@)(@@) % شغلتك عن حسن السماع مدائح % حسنت فما تنفك تطرب سامعا % % 27(@)(@@) % طلعت عليكأبا الفوارس أنجم % منهنيخجلن النجوم طوالعا % % 28(@)(@@) % زهر إذا صافحن سمع معاند % خفض الكلامو غض طرفا خاشعا % % 29(@)(@@) % جاءتك مثل بدائع الوشي الذي % % ما زال في صنعاء يتعب صانعا % % 30(@)(@@) % أو كالربيع يريك أخضر يانعا % و موردا شرقا و أصفر فاقعا % % PageV01P523 البحر : - 1(@)(@@) % أ إن دنا الشوق بعد ما شسعا % % و أسعد الدمع بعد ما امتنعا % % 2(@)(@@) % وصلت ماء الشؤون من كمد % يقطع القلب حره قطعا % % 3(@)(@@) % أبارق بالغدير أذكرني % % لمع السنايا العذابإذ لمعا % % 4(@)(@@) % أم عارض لا يزال معترضا % يصدع أحشاي كلما انصدعا % % 5(@)(@@) % سقيا لسلع و إن سقيت به الص % صباغداة الوداعو السلعا % % 6(@)(@@) % ودعتهمو الأسى يجرعني % % بالأجرع الفرد كأسه جرعا % % 7(@)(@@) % و من وراء السجوف بدر دجى % يخجل بدر الدجى إذا طلعا % % 8(@)(@@) % أولع جفنيه بي ليقتلني % % سهماهماواقعا و منتزعا % % 9(@)(@@) % لا تولعا بالمشوق لومكما % % و إن تمادى غرامه ولعا % % 10(@)(@@) % ولى وردع العبير يمنحه % % رياه طيب العناق لارتدعا % % PageV01P524 11(@)(@@) % كم عزمة كالشهاب عدت بها % % محت مغيم الهمومفانقشعا 
ms138	 % % 12(@)(@@) % و كم وصلت الوجيف منتجعا % جدوى ابن فهد فرحت منتجعا % % 13(@)(@@) % في غدا رافعا لأسرته % راية مجد يزيدها رفعا % % 14(@)(@@) % يريك فعلا في البشر مبتدعا % منهو معنى في الجود مخترعا % % 15(@)(@@) % ما زال يعلو ربا الفخارو يح % % تل يفاع العلاء مذ يفعا % % 16(@)(@@) % وقتك من عثرة الردى عصب % إن عثروا قلت بالسماحلعا % % 17(@)(@@) % عيد معاد عليك ممتعه % % ما لاح ضوء النهارأو متعا % % 18(@)(@@) % و منزل إن جفاه نازله % % حن اشتياقا إليهأو نزعا % % 19(@)(@@) % رقيق ثوب الهواء تدفعه % % أمواج بحر يموج مندفعا % % 20(@)(@@) % جانبه القر والهجيرفقد % % طاب مصيفا و طاب مرتبعا % % PageV01P525 21(@)(@@) % و صافحت ماءه الصبافغدا % % منخفضا تارةو مرتفعا % % 22(@)(@@) % و اتجهت فيه كل كاشفة % وجها بثوب الظلام مدرعا % % 23(@)(@@) % تحمل في السير إخوةفإذا % % حان مدى السير أصبحوا شيعا % % 24(@)(@@) % فنازلات تهوي على عجل % تهاوي الطير أشعرت جزعا % % 25(@)(@@) % و صاعدات تسير في مهل % كالخيل أبقى بها السرى ظلعا % % 26(@)(@@) % يقودها كل قائد تعب % كأنه راكع و ما ركعا % % 27(@)(@@) % فكل حسن تراه مفترقا % فيهإذا جئته ومبتدعا % % 28(@)(@@) % بدائع لا يزال مبدعها % % يظهر لي من صنيعه بدعا % % 29(@)(@@) % تمل أيامك التي حسنت % فهي تضاهي الأعياد والجمعا % % 30(@)(@@) % و خلعة من ثناي دبجها ال % % فكر ففاقت بحسنها الخلعا % % PageV01P526 31(@)(@@) % و قرب الحذق لفظهافغدا % % من قربه مطمعا وممتنعا % % PageV01P527 البحر : - 1(@)(@@) % تروع هجرها قلبا مروعا % % صديع الشيب يملؤه صدوعا % % 2(@)(@@) % أرتها الأربعون هشيم روض % و قبل الأربعين رأت ربيعا % % 3(@)(@@) % هزيع شبيبة طلعت عليه % % كواكبهفرصعت الهزيعا % % 4(@)(@@) % ألافاعجب لما صنع الغواني % % فقد أفسدن بالغدر الصنيعا % % 5(@)(@@) % كفرن بذلك الصنم المفدى % % و كن له سجودا أو ركوعا % % 6(@)(@@) % يرين بعاده قرب الأماني % % و ضيق عناقه العيش الوسيعا % % 7(@)(@@) % ليالي يخجل الريحان ريحا % إذا اتشحته غانية ضجيعا % % 8(@)(@@) % أ أبناء الطريق دعوا طريقا % سبقت ذوي السباق به جميعا % % 9(@)(@@) % فلست مجاورا إلا جوادا ؛ % و لست مقارعا إلا قريعا % % 10(@)(@@) % أنام على قوارصكم وعندي % % قوارص تسلب المقل الهجوعا % % PageV01P528 11(@)(@@) % أهز بها على قوم سيوفا % و أجعلها 
ms139	 على قوم دروعا % % 12(@)(@@) % إذا سارت مشنعة عليكم % % فردوا ذلك الخبر الشنيعا % % 13(@)(@@) % أزفان المحرم إن شعري % % بحر الشعر أحرى أن يشيعا % % 14(@)(@@) % تركت الدف تنقره اكتسابا % و ملت علي تنقرني ولوعا % % 15(@)(@@) % إذا الشيخ الخليع هفا اغترارا % تيمم بالأذى الصل الخليعا % % 16(@)(@@) % سيذهل عن فنون الرقص هما % إذا رقصت منه حشا مروعا % % 17(@)(@@) % و يفصح نابه سجحات نابي % % إذا استودعن سر فتى أذيعا % % 18(@)(@@) % لقد خلعت بتوبتك الملاهي % % ثياب الكبرو اكتست الخشوعا % % 19(@)(@@) % تركت بها المعازف ضائعات % و عز على المعازف أن تضيعا % % 20(@)(@@) % فقد نتفت لحاك بهاو لاقت % % صنوجكبعدهاخطبا فظيعا % % PageV01P529 21(@)(@@) % و كيف نسكت بعد مقال قوم % إذا نسك المخنث مات جوعا % % 22(@)(@@) % و كنتإذا الزقاق رأتك تشدو % % بألحان الغريض بكت نجيعا % % 23(@)(@@) % أما تشتاق من عرصات غمى % % مغاني الجاشرية والربوعا % % 24(@)(@@) % فقد نبشت شآبيب الغوادي % % عليهن النمارق والقطوعا % % 25(@)(@@) % هجرت الهجر إلا نظم شعر % بهرت بسحره السحر البديعا % % 26(@)(@@) % و عفت العارإلا عير أنس % تخر لهإذا أدلى صريعا % % 27(@)(@@) % يزورك والدجى ستر عليه % % فيرقع منك مأبونا رقيعا % % 28(@)(@@) % أ فارسهل تكون غدا شفيعي % % إذا أنا فيك عاديت الشفيعا % % 29(@)(@@) % دعوت إلى الضلال دعاء غاف % % فلم يكن السميع له سميعا % % 30(@)(@@) % أ أرغب عن وداد أبي تراب % و قد شحن الترائب والضلوعا % % PageV01P530 31(@)(@@) % و أعرض بعد وخط الشيب عنه % % و قد أحببته طفلا رضيعا % % 32(@)(@@) % أقلوا قبل غشيان القوافي % % بذكركم المحافل والجموعا % % 33(@)(@@) % نصحت لكمفلا تردوا المنايا % % و لا تستمطروا السم النقيعا % % 34(@)(@@) % إذا لم تتبعوا أبدا رشادي % % فلست لغيكم أبدا تبيعا % % 35(@)(@@) % ألا متجرد لله ندب % يقرب منكم الحين الشنيعا % % 36(@)(@@) % فيخضب من دمائكم العوالي % % و ينقع من صديدكم الجزوعا % % 37(@)(@@) % أحاكمكم إلى السبع المثاني % % و تلك الشمس أغشتكم طلوعا % % 38(@)(@@) % فقد حفظت صحائفهن حقا % و لست لما احتفظن به مضيعا % % PageV01P531 البحر : - 1(@)(@@) % يا من لديه العفاف والورع % و شيمتاه العلاء والرفع % 2(@)(@@) % كأسك قد فرقت مفاصله % % بين الندامى فليس تجتمع % 3(@)(@@) % كأنما الشمس بينهم سقطت % فجسمها 
ms140	 في أكفهم قطع % 4(@)(@@) % لو لم أكن واثقا بمشبهه % % منكلكاد الفؤاد ينصدع % 5(@)(@@) % فجد به بدعةفعندي من % % جودك أشياء كلها بدع % PageV01P532 البحر : - 1(@)(@@) % أ تكتم أسرار الهوى أم تذيعها % % و تحفظها بعد النوى أم تضيعها % % 2(@)(@@) % مهاة و لكن للفراق لقاؤها ؛ % و شمس و لكن للغروب طلوعها % % 3(@)(@@) % تعن لنا في مشرقات وجوهها % % إذا هي عنت مظلمات فروعها % % 4(@)(@@) % تصانع عن أجيادها بأكفها % % فيحسن عند المستهام صنيعها % % 5(@)(@@) % و لما تبادلنا العناقو أعنقت % دموعي ممزوجا بهن دموعها % % 6(@)(@@) % شكوت الذي تشكو إليكأنما % % تجن ضلوعي ما تجن ضلوعها % % 7(@)(@@) % سلام على الأيام تبيض بينها % % صنائعمسود العذار شفيعها % % 8(@)(@@) % تلفت بعد الأربعينو أسرعت % % عجالا فلم يربع علي ربيعها % % 9(@)(@@) % و تاجرة بالخمر تؤثر صونها % % عن البيعأو تلقى الغنى فتبيعها % % 10(@)(@@) % تسيل فم الزق الرويكأنه % % جراحة زنجي يسيل نجيعها % % PageV01P533 11(@)(@@) % إذا زارها وفد الرضاع تبرعت % بعذراء لا يهوى الفطام رضيعها % % 12(@)(@@) % فلا طيب إلا أن يفوح نسيمها ؛ % و لا فجر إلا أن يلوح صديعها % % 13(@)(@@) % أقمنا لديها في رياض أنيقة % نمارقها موشية و قطوعها % % 14(@)(@@) % نروع بأسياف المدام همومنا % % كأنا بأسياف الوزير نروعها % % 15(@)(@@) % هو المزنة الغراء طبق صوبها % % إذا المزنة الغراء غب لموعها % % 16(@)(@@) % طلوب لغايات الكراملحوقها % % ركوب لأعلام النجاد طلوعها % % 17(@)(@@) % إذا متعت أخلاقه الغر خيلت % لعينيك أن الشمس راج متوعها % % 18(@)(@@) % و أزهر ينقاد الزمان لأمره % و تأمره زهر العلى فيطيعها % % 19(@)(@@) % وقور السجايا في النديركينها % % شرود العطايا في المحولخليعها % % 20(@)(@@) % إذا سجدت في الطرس أقلامه اغتدى % % سجود العدا حمالهو ركوعها % % PageV01P534 21(@)(@@) % تروعها أسيافهفتشيمها % % بدامية الأجفان نزر هجوعها % % 22(@)(@@) % و كيف على هز السيوف بقاؤها % % إذا كان مهتز اليراع يروعها % % 23(@)(@@) % أيا سائلي عن شيمة الحسن استمع % محاسن من نظم الثناء أذيعها % % 24(@)(@@) % إذا عد من آل المهلب أسرة % معاقلها أسيافها ودروعها % % 25(@)(@@) % رأيت العلا منثالة من شعابها % % عليهو مجموعا إليه جميعها % % 26(@)(@@) % همام وقى الأعداء من سطواته % تباعدها من سخطهفتروعها % % 27(@)(@@) % فعدته أسيافه ورماحه % و عدتها إذعانها وخضوعها % % 28 