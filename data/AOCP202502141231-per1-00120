ms118	 تو، شرمسار ماندی و خجل(@)(@@) (@@) بس خواندی، زان پس که به تو دادی دل %~% «سبحانک ما خلقت هذا باطل))(@)(@@)(@@)(@@) | عز اصفهانی(@)(@@) (@@) 1169 این حور وشان، که نازنین آمدهاند %~% گویی مگر از خلد برین آمدهاند(@)(@@) (@@) آب کهنان آسمانی بردند! %~% این نوعهدان، که در زمین آمده اند!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1170 امرونم دکر باره چنان آمدهای %~% گویی زبهشت جاودان آمدهای(@)(@@) (@@) رخشنده، چو ماه آسمان آمدهای %~% از خلد مگر در این زمان آمدهای؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1171 کس نیست، که داد خلق بستاند ازو %~% جان من مستمند برهاند ازو(@)(@@) (@@) سبحان الله! که نیستش در همه تن %~% عیبی، که دلم عنان بگرداند ازوا(@)(@@)(@@)(@@) | له(@)(@@) (@@) 1172 گر بر شمرم زخوبیش تا چند است %~% یامعنی جان پسند، او را چند است(@)(@@) (@@) عمرم، زشمردنش به پایان آید %~% وان را نتوان گفت، که چون یا چند است؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1173 گه بر سر زلف دلر بایت نگرم %~% گه بر لب لعل جانفزایت نگرم(@)(@@) (@@) چندانکه من اندر سر و پایت نگرم %~% عاجز شدهام، که در کجایت نگرم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1174 ای گلبن لطف، یاسمن برخی تو %~% وی سرو روان، سرو چمن برخی تو(@)(@@) (@@) در شیوهآ شکل هر که در روی زمین %~% در می نگرم، هم تو که من برخی تو!(@)(@@)(@@)(@@) | کمال [اسماعیل](@)(@@) (@@) 1175 ای بر دل من غم ترا دلسوزه %~% سرگشتهآ لعلت، فلک فیروزه(@)(@@) (@@) ک ساعته حسنت از خدا می خواهد %~% هم ماه دو هفته، هم گل یکروزه!(@)(@)PageV01P258(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0262.jpg)(@)(@)(@@) (@@) 1176 ای عشق تو را، با دل من خویشی کم %~% لغیره %~% وی مهر تو، از هرچه بر اندیشی کم(@)(@@) (@@) تا حسن تورا، کمی بود هر دم بیش %~% اندوه تو را، کجا بود بیشی کم؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1177 اندام به اندام چو سیم خامش نقاش فلک، نمهی تواند انگیخت %~%(@)(@@) اندام به اندام تر از اندامش! %~% لطفی دارد، که کس نداند نامش(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 1178 لعلت، که شکر سغبهٔ‌ شیرینی اوست %~% او را به جهان کار، گهر چینی اوست(@)(@@) (@@) مثلت به جهان، دیدهآ احول بیند %~% وان نیز، هم ازغایت 
ms119	 کژبینی اوست!(@)(@@)(@@)(@@) | ظهیر(@)(@@) ~~من، فارغم ازملامت دشمن و دوست 1179 دل، گرچه هلاک جان وتن می خواهد(@)(@@) %~% خود حسن تو، عذر دل من می خواهد! %~% رسوایی کار خویشتن می خواهد(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) ~~در چشم منی دایم و، این نیست شگفت 1180 هر دل که تو را بباخت، درتاب(@)(@@) بود 118 با آنکه دوای درد دل نتوان کرد %~% اوله %~% زیرا که پری همیشه(@)(@@) در آب بود! %~% هم ترک تو، ای شمع چگل نتوان کرد %~% هر دیده که بی تو گشت، بیتاب بود(@)(@@) (@@) صورتگر جان، زنور خود کرد تورا %~% ورنه، چوتویی زآب و گل نتوان کرد!(@)(@@)(@@)(@@) | قاضی مراغه(@)(@@) (@@) خط تو، گواه عارض شاهد توست 1182 منشین صنما به جور جویی، برخیز %~%(@)(@@) با ماه، به دعوی نکویی برخیزا %~% پیشت برود هر چه بگویی، برخیز(@)(@@)(@@)(@@) | کمال تفلیسی(@)(@@) (@@) 118 در روی تو، روی خود عیان بتوان دید %~% مغزش زدرون استخوان بتوان دید(@)(@@) (@@) در تاریکی، تو را چنان بتوان دید %~% کزلطف تو، درتن توجان بتوان دید(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) 1184 ای پیش قدت، سرو چمن در باقی %~% با عارض تو، سیم وسمن در بافی(@)(@@) (@@) فی الجمله، سخن ز آفرینش امروز %~% بی مشل کسی، گشت سخن در باقی!(@)(@)PageV01P259(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0263.jpg)(@)(@)(@@)(@@)(@@) | عماد غزنوی(@)(@@) (@@) 1185 در کوی تو، کشت وصل بی بر بینم %~% وز دست تو، دست عقل بر سر بینم(@)(@@) (@@) از بوالعجبیهات یکی فعل آن است %~% کانگه که ببینمت، نکوتر بینم(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 1186 زلف تو، به پیرامن مه می گردد داری الفی زقد و، صفری زدهان %~%(@)(@@) بر خون هزار بیگنه می گردد %~% حسن تو، از آن یکی به ده می گردد(@)(@@)(@@)(@@) | سعد گنجهای(@)(@@) (@@) 1187 در گرد سر زلف تو، جان می نرسد %~% در حسن تو، ماه آسمان می نرسد(@)(@@) (@@) در شکل و شمایل تو، ای جان و جهان %~% چیزی است، که کس به کنه آن می نرسد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1188 با آتکه دمی به مهر پیوندت نیست %~% بنمای، دلی که آرزومندت نیست(@)(@@) (@@) ای دوست، مگر خدای خوبانی از آنک 
ms120	 %~% در دهر، به حسن مثل ومانندت نیست(@)(@@)(@@)(@@) | نجیب عمر(@)(@@) (@@) 1189 در یار نگر، چو کعبه خواهی و حرم %~% در وی، حجرالاسود و زمزم با هم(@)(@@) (@@) خالش حجرالاسود و، رویش کعبه %~% خطش حرم و، چاه زنخدان زمزم(@)(@@)(@@)(@@) | رضیه گنجهای(@)(@@) (@@) 1190 تا در چشمی، برفت خواب از چشمم %~% اشکی نرود، به هیچ باب از چشمم(@)(@@) (@@) لیکن، ز بی آنکه تو در چشم منی %~% لهستی %~% از تری آن، می چکد آب از چشمم!(@)(@@) (@@) 1191 تا ظن نبری کز پی جان می گریم %~% زین سان که به پیدا و نهان می گریم(@)(@@) (@@) از آب لطیف تر نمودی خود را %~% در چشم من آمدی، از آن می گریم(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 1192 یاری، که قدش چوقد سرو چمن است %~% رخسارهآ او، رشک گل و یاسمن است(@)(@@) (@@) دیدم به رهش، زلطف چون آب روان %~% زان، آب روان هنوز در چشم من است(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 1193 سودای تو، راز من برون داد از چشم %~% اشکم به زبان حال، بگشاد از چشم(@)(@@) (@@) تا لطف تو در چشم من آمد، زان پس %~% آب همه عالمم بیفتاد از چشم PageV01P260(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0264.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1194 از گل نه ای ای نگار، از نوری توگویی نه نهاد آدمی، حوری تو(@)(@@) (@@) آن کس که تو را به ماه مانند کند %~% گو نیک براندیش، که بس دوری تو!(@)(@@)(@@)(@@) | لااعرف(@)(@@) ~~1195 روزی، که سر از پرده برون خواهی کردآن روز، زمانه را زبون خواهی کرد(@)(@@) (@@) گر حسن و جمال از این فزون خواهی کرد %~% یارب، چه جگرهاست که خون خواهی کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~119 مه کیست دلا، که حلقه بر در زندتیا چرخ، که خیمهای برابر زندت(@)(@@) (@@) باری داری، که مه خجل گردد از او %~% با نقره زدن، ولیک با زر زندت!(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) ~~1197 تا زلف و رخت، چوصبح و شام افتاده ست در حلق دل از زلف تو دام افتادهست(@)(@@) (@@) تو، نوبت حسن گرچه امروززدی %~% دیرست، که این طشت زبام افتادهست!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~1198 گرچه که 