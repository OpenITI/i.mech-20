ms412	 ) )(@)(@@) ( حم د ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3912 ) قال النبي :(@)(@@) | 30 ( اكلفوا من العمل ما تطيقون ، فإن خير العمل أدومه وإن قل ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3913 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين إيمانا أحسنهم خلقا ) )(@)(@@) ( حم د حب ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3914 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين إيمانا أحسنهم خلقا ، الموطؤون أكنافا الذين يألفون ويؤلفون ، ولا خير فيمن لا يألف ) )(@)(@@) ( طس ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3915 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين إيمانا أحسنهم خلقا ، وخياركم خياركم لنسائهم ) )(@)(@@) ( ت حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3916 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين إيمانا رجل يجاهد في سبيل الله PageV02P063 بنفسه وماله ، ورجل يعبد الله في شعب من الشعاب قد كفى الناس شره ) )(@)(@@) ( د ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3917 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين من سلم المسلمون من لسانه ويده ) )(@)(@@) ( ك ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 3918 ) قال النبي :(@)(@@) | 30 ( أكبر الكبائر عقوق الوالدين يسب الرجل أبا الرجل فيسب أباه ويسب أمه فيسب أمه ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3919 ) قال النبي :(@)(@@) | 30 ( أكبر دعائي ودعاء الأنبياء قبلي بعرفة لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، اللهم اجعل في قلبي نورا وفي سمعي نورا وفي بصري نورا ، اللهم اشرح لي صدري ويسر لي أمري وأعوذ بك من وسواس الصدر وشتات الأمر وفتنة القبر ، اللهم إني أعوذ بك من شر ما يلج في النهار وشر ما تهب به الرياح ومن شر بوائق الدهر ) )(@)(@@) ( هق ) وضعفه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3920 ) قال النبي :(@)(@@) | 30 ( اكتبوا ولا حرج ) )(@)(@@) الحكيم ( طب ) و سمويه والخطيب في كتاب تقييد العلم عن رافع بن خديج قال : قلت : يا رسول الله إنا نسمع منك أشياء فنكتبها قال فذكره .(@)(@@)(@@)(@@) $ ( 3921 ) قال النبي :(@)(@@) | 30 ( اكتحلوا بالإثمد عند النوم فإنه 
ms413	 يجف الدمعة وينبت الشعر ) )(@)(@@) ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3922 ) قال النبي :(@)(@@) | 30 ( اكتني بابنك عبد الله بن الزبير ) )(@)(@@) ابن سعد ( طب ) PageV02P064 عن عبادة بن حمزة بن عبد الله بن الزبير أن عائشة رضي الله عنها قالت : يا نبي الله ألا تكنيتي ؟ قال فذكره ( طب ك لق ) عن عبادة عن عائشة ( حم هق ) عن عروة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3923 ) قال النبي :(@)(@@) | 30 ( أكثر أمتي الذين لم يعطوا فيبطروا ، ولم يقتر عليهم فيسألوا ) )(@)(@@) ( خ ) في تاريخه و البغوي وابن شاهين عن أبي الجدع الأنصاري عن أبيه قال البغوي : ولا أعلم له غيره .(@)(@@)(@@)(@@) $ ( 3924 ) قال النبي :(@)(@@) | 30 ( أكثر ما يدخل الناس الجنة تقوى الله وحسن الخلق ، وأكثر ما يدخل الناس النار الأجوفان الفم والفرج ) )(@)(@@) ( حم خ ) في الأدب ( ت ) صحيح غريب ( ك حب هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3925 ) قال النبي :(@)(@@) | 30 ( أكثر الناس شبعا في الدنيا أطولهم جوعا في الآخرة ، يا سل مان إنما الدنيا سجن المؤمن وجنة الكافر ) )(@)(@@) ( حل ض ) عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3926 ) قال النبي :(@)(@@) | 30 ( أكثر بعدي من السجود فإنه ما أحد يسجد لله إلا رفعه الله بها درجة في الجنة وحط عنه بها خطيئة ) )(@)(@@) ابن سعد ( حم ) والبغوي عن أبي فاطمة الأزدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3927 ) قال النبي :(@)(@@) | 30 ( أكثرهم لله ذكرا ) )(@)(@@) ( حم طب ) عن معاذ بن أنس رضي الله عنه قال : سئل رسول الله أي المجاهدين أعظم أجرا وأي الصائمين أعظم أجرا وكذا الصلاة والزكاة والحج والصدقة ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 3928 ) قال النبي :(@)(@@) | 30 ( أكثرهم للموت ذكرا وأحسنهم له استعدادا قبل نزول الموت أولائك هم الأكياس ذهبوا بشرف الدنيا والآخرة ) )(@)(@@) ( طب ك حل ) عن ابن عمر رضي الله عنهم أن رجلا قال : يا رسول الله أي المؤمنين أكيس ؟ قال فذكره ، PageV02P065 ابن المبارك وأبو بكر في الغيلانيات عن سعد بن مسعود الكندي وقيل إنه تابعي .(@)(@@)(@@)(@@) $ ( 3929 ) قال النبي :(@)(@@) | 30 ( أكثروا الصلاة علي فإنه من صلى علي صلاة صلى الله عليه 
ms414	 عشرا ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3930 ) قال النبي :(@)(@@) | 30 ( أكثروا من قول سبحان الله والحمد لله ولا إلاه إلا الله ، والله أكبر ولا حول ولا قوة إلا بالله فإنهن من الباقيات الصالحات ، وهن يحططن الخطايا كما تحط الشجرة ورقها وهن من كنوز الجنة ) )(@)(@@) الرامهرمزي في الأمثال عن أبي الدرداء رضي الله عنه وفيه عمر بن راشد اليماني قال في المغنى ضعفوه .(@)(@@)(@@)(@@) $ ( 3931 ) قال النبي :(@)(@@) | 30 ( أكثروا ذكر الله تعالى فإنه ليس شيء أحب إلى الله ولا أنجى لعبده من خشيته في الدنيا والآخرة من ذكر الله تعالى ، ولو أن الناس اجتمعوا على ما أمروا شعبة من ذكر الله ) ( هب ) وضعفه عن م$ عاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3932 ) قال النبي :(@)(@@) | 30 ( أكثروا الصلاة علي في الليلة الزهراء واليوم الأزهر فإن صلاتكم تعرض علي ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3933 ) قال النبي :(@)(@@) | 30 ( أكثروا من الحمد لله فإن لها عينين وجناحين تطير في الجنة تستغفر لقائلها إلى يوم القيامة ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3934 ) قال النبي :(@)(@@) | 30 ( أكثروا من الاستغفار في شهر رجب فإن لله في كل ساعة عتقاء من النار ، وإن لله مدائن لا يدخلها إلا من صام شهر رجب ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3935 ) قال النبي :(@)(@@) | 30 ( أكثروا ذكر الموت فإن ذالك تمحيص الذنوب وتزهيد في الدنيا ، الموت القيامة والموت القيامة ) )(@)(@@) ابن لال في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3936 ) قال النبي :(@)(@@) | 30 ( أكثروا ذكر هاذم اللذات فإنكم لا تذكرونه في كثير إلا PageV02P066 قلله ، ولا في قليل إلا كثره ) )(@)(@@) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3937 ) قال النبي :(@)(@@) | 30 ( أكثروا من قول لا حول ولا قوة إلا بالله فإنه كنز من كنوز الجنة وإن فيها شفاء من تسعة وتسعين بابا أولها الهم ) )(@)(@@) ميسرة بن علي في مشيخته عن بهر بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 3938 ) قال النبي :(@)(@@) | 30 ( أكثروا من الصلاة علي يوم الجمعة فإنه يوم مشهود تشهده 
ms415	 الملائكة وإن أحدا منكم لم يصل علي إلا عرضت علي صلاته حتى يفرغ منها ، قيل وبعد الموت ؟ قال : وبعد الموت ، إن الله حرم على الأرض أن تأكل أجساد الأنبياء ، فنبي الله حي يرزق ) )(@)(@@) ( ه هب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3939 ) قال النبي :(@)(@@) | 30 ( أكثروا الكلام بذكر الله فإن كثرة الكلام بغير ذكر الله تقسي القلب ، وإن أبعد الناس من الله القلب القاسي ) )(@)(@@) أبو الشيخ في الثواب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3940 ) قال النبي :(@)(@@) | 30 ( أكذب الناس الصباغ ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3941 ) قال النبي :(@)(@@) | 30 ( أكرم الشهداء يوم القيامة حمزة بن عبد المطلب ، ثم رجل قام إلى إمام جائر فأمره ونهاه فقتله ) )(@)(@@) الرافعي عن أبي حنيفة عن عكرمة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3942 ) قال النبي :(@)(@@) | 30 ( أكرموا العلماء ووقروهم وأحبوا المساكين وجالسوهم ، وارحموا الأغنياء وعفوا عن أموالهم ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3943 ) قال النبي :(@)(@@) | 30 ( أكرموا حملة القرآن فمن أكرمهم فقد أكرم الله ، ألا فلا تنقصوا حملة القرآن حقوقهم فإنهم من الله بمكان ، كاد حملة القرآن أن يكونوا أنبياء إلا إنه لا يوحى إليهم ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنهما .(@)(@@) PageV02P067(@)(@@)(@@)(@@) $ ( 3944 ) قال النبي :(@)(@@) | 30 ( أكرموا القرآن ولا تكتبوه على حجر ولا مدر ولاكن اكتبوه فيما يمحى ولا تمحوه بالبزاق وامحوه بالماء ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3945 ) قال النبي :(@)(@@) | 30 ( أكرموا عمتكم النخلة فإنها خلقت من الطين الذي خلق منه آدم ، وليس من الشجر شيء يلقح غيرها ، فأطعموا نساءكم الولد الرطب ، فإن لم يكن الرطب فالتمر ، وليس شيء من الشجر أكرم على الله من شجرة نزلت عندها مريم بنت عمران ) )(@)(@@) الرامهرمزي في الأمثال عن علي وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 3946 ) قال النبي :(@)(@@) | 30 ( أكرموا أصحابي ثم الذين يلونهم ثم الذين يلونهم ، ثم يظهر الكذب حتى يحلف المرء قبل أن يستحلف ، ويشهد قبل أن يستشهد ، فمن أراد بحبوحة الجنة فعليه بالجماعة ، وإياكم والفرقة فإن الشيطان مع الواحد وهو من 
ms416	 الإثنين أبعد ، لا يخلون رجل بامرأة فإن ثالثهما الشيطان ومن سرته حسنة وساءته سيئة فهو مؤمن ) )(@)(@@) ( حم ع ) و الخطيب وابن عساكر عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3947 ) قال النبي :(@)(@@) | 30 ( أكرميه فإنه من أشبه أصحابي بي خلقا ) )(@)(@@) ( طب ) عن أبي هريرة رضي الله عنه أن رسول الله دخل على ابنته رقية امرأة عثمان رضي الله عنهما قال فذكره .(@)(@@)(@@)(@@) $ ( 3948 ) قال النبي :(@)(@@) | 30 ( أكره أن يتحدث الناس أن محمدا يقتل أصحابه وعسى أن تكفينيهم الدبيلة شهاب من نار يوضع على نياط قلب أحدهم فيقتله ) )(@)(@@) ( طس ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3949 ) قال النبي :(@)(@@) | 30 ( اكفف من حشائك فإن أكثر الناس في الدنيا شبعا أكثرهم في الآخرة جوعا ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3950 ) قال النبي :(@)(@@) | 30 ( أكمل المؤمنين إيمانا أحسنهم خلقا ، وإنما المسلم من سلم المسلمون من لسانه ويده ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@) PageV02P068(@)(@@)(@@)(@@) $ ( 3951 ) قال النبي :(@)(@@) | 30 ( أكووه إن شئتم وإن شئتم فارضفوه ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 3952 ) قال النبي :(@)(@@) | 30 ( ألبان البقر شفاء وسمنها دواء ولحومها داء ) )(@)(@@) ( طب ) عن مل يكة بنت عمرو رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3953 ) قال النبي :(@)(@@) | 30 ( إلبس الخشن الضيق حتى لا يجد العز والفخر فيك مساغا ) )(@)(@@) ( ابن منده ) عن أنيس بن الضحاك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3954 ) قال النبي :(@)(@@) | 30 ( إلبس جديدا وعش حميدا ومت شهيدا ويرزقك الله قرة عين في الدنيا والآخرة ) )(@)(@@) قاله لعمر ( حم ( 1 ) ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3955 ) قال النبي :(@)(@@) | 30 ( إلبسوا الثياب البيض فإنها أطهر وأطيب وكفنوا فيها موتاكم ) )(@)(@@) ( حم ت ن ه ك ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3956 ) قال النبي :(@)(@@) | 30 ( البسوا من ثيابكم البياض فإنها من خير ثيابكم وكفنوا فيها موتاكم ، وإن من خير أكحالكم الإثمد يجلو البصر وينبت الشعر ) )(@)(@@) ( حم د ت حب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3957 ) قال النبي :(@)(@@) | 30 ( التمسوا الجار قبل الدار 
ms417	 والرفيق قبل الطريق ) PageV02P069 )(@)(@@) ( طب ) عن رافع بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3958 ) قال النبي :(@)(@@) | 30 ( إلتمسوا الخير عند حسان الوجوه ) )(@)(@@) ( طب ) عن أبي خصيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3959 ) قال النبي :(@)(@@) | 30 ( التمسوا الرزق بالنكاح ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3960 ) قال النبي :(@)(@@) | 30 ( التمسوا الرزق في خبايا الأرض ) )(@)(@@) ( قط ) في الأفراد ( هب ) عن عائشة رضي الله عنها ( ابن عساكر ) عن عبد الله بن أبي ربيعة ( ز ) .(@)(@@)(@@)(@@) $ ( 3961 ) قال النبي :(@)(@@) | 30 ( التمسوا الساعة التي ترجى في يوم الجمعة بعد العصر إلى غيبوبة الشمس ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3962 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر آخر ليلة من رمضان ) )(@)(@@) ( ابن نصر ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3963 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر في أربع وعشرين ) )(@)(@@) ( محمد بن نصر في الصلاة ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3964 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر في العشر الأواخر من رمضان في وتر فإني قد رأيتتها فنسيتها ) )(@)(@@) ( حم طب ) و الضياء عن جابر بن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3965 ) قال النبي :(@)(@@) | 30 ( التمسوا ليلة القدر ليلة سبع وعشرين ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3966 ) قال النبي :(@)(@@) | 30 ( التمس ولو خاتما من حديد ) )(@)(@@) ( حم ق د ) عن سهل بن سعد رضي الله عنه .(@)(@@) PageV02P070(@)(@@)(@@)(@@) $ ( 3967 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر فإن ضعف أحدكم أو عجز فلا يغلبن على السبع البواقي ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3968 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر فإنها في وتر في إحدى وعشرين أو ثلاث وعشرين أو خمس وعشرين أو سبع وعشرين أو تسع وعشرين أو آخر ليلة ، فمن قامها إيمانا واحتسابا غفر له ما تقدم من ذنبه وما تأخر ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3969 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر في تسع تبقي