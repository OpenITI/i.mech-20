ms21	 : كامل تام 1(@)(@@) % وتقول طورا : ذا فتى غزل من غائب في الحب لم يؤب % لا شيء يرقبه سوى العطب % 2(@)(@@) % من حب شاطرة رمت غرضا % قلبي ، فمن ذا قال لم تصب ؟ ! % 3(@)(@@) % البدر أشبه ما رأيت بها % % حين استوى ، وبدا من الحجب % 4(@)(@@) % وابن الرشا لم يخطها شبها % بالجيد والعينين واللبب % 5(@)(@@) % و إذا تسربل غيرها ، اشتملت % ورد الحواشي ، مسبل الذنب % 6(@)(@@) % فتقول طورا : ذا فتى هتفت % نفس النصيح به ، فلم يجب % 7(@)(@@) % ود لعصبة ريبة ، مجن ، % أعدى لمن عادوا من الجرب % 8(@)(@@) % شنع الأسامي ، مسبلي أزر ، % حمر تمس الأرض بالهدب % 9(@)(@@) % متعطفين على خناجرهم ، % سلب لشربهم من القرب % 10(@)(@@) % و إذا هم لحديثهم جلسوا ، % عطفوا أكفهم على الركب % PageV01P096 11(@)(@@) % و تقول طورا : ذا فتى غزل % بادي الدماثة ، كامل الأدب % 12(@)(@@) % صب إلى حوراء يمنعه % منها الحيا ، وصيانة الحسب % 13(@)(@@) % فكلاهما صب بصاحبه % لو يستطيع لطار من طرب % 14(@)(@@) % فتواعد يوما ، وشأنهما % % ألا يشوبا الوعد بالكذب % 15(@)(@@) % فغدت كواسطة الرياض إلى % % موعودة تمشي على رقب % 16(@)(@@) % و غدا مطرقة أنامله % حلو الشمائل ، فاخر السلب % 17(@)(@@) % من لم يصب في الناس يومئذ % من ريحه إذ مر لم يطب % 18(@)(@@) % لا ، بل لها خلق منيت به ، % وملاحة عجب من العجب % 19(@)(@@) % فالمستعان الله في طلبي % % من لست أدركه عن الطلب % 20(@)(@@) % ما لامني الإنسان أعشقه % حتى يعيره المعير بي % % PageV01P097 البحر : مجزوء الرمل 1(@)(@@) % أيها القادم من بص % رتنا أهلا ورحبا % % 2(@)(@@) % مذ متى عهدك بالل % ه بحمدان بن رحبا % % 3(@)(@@) % كان في ما كنت ودع % ت وقد يممت ركبا % % 4(@)(@@) % فلئن كان كذا صا % % فحت رخص الكف رطبا % % 5(@)(@@) % و لقد صب على أع % لاه ماء الحسن صبا % % 6(@)(@@) % صب حتى قالت الوج % نة واللبة حسبة ! % 7(@)(@@) % أصدر إن واجه العي % ن ، وإن ولى أكبا % % 8(@)(@@) % فترى الأرداف يجذب % نا عنان الخصر جذبا % % PageV01P098 البحر : مديد تام 1(@)(@@) % يا بني حمالة الحطب ! % حربي من ظبيكم حربي ! % 2(@)(@@) % حربا في القلب برح بي ، % ألهبته 
ms22	 مقلة اللهب % 3(@)(@@) % قد رمت ألحاظه كبدي % % بسهام للردى صيب % 4(@)(@@) % لم يجر في البيت منه ، وقد % عذت بالأركان والحجب % 5(@)(@@) % صيغ هذا الناس من حمإ ، % وبراه الله من ذهب % 6(@)(@@) % كيف من لم يثنه حرج % دون قتلي عف عن سلبي ؟ ! % PageV01P099 البحر : منسرح 1(@)(@@) % قل للمسمى باسم الذي قام يد % عو الله لما تجمعوا عصبا % % 2(@)(@@) % و المكتني باسم خاتم الأنبيا % % ء المرسلين الذي أتى العربا % % 3(@)(@@) % وابن المسمى باسم الذي يظفر ال % % طالب إن ناله بما طلب % 4(@)(@@) % كنت لحر الأخلاق أما ، إذا % % ما نص يوما لنسبة ، وأبا % % 5(@)(@@) % فما الذي ، يا فديت ، غير أو % بدل ، أو غال ذالك النسب % 6(@)(@@) % مهلا ! فقد خفت أن يشينك نس % يانك عند التعصب الأدبا % % PageV01P100 البحر : سريع 1(@)(@@) % أشاب رأسي قبل أترابي % % حبي لمن حبييه أزر بي % % 2(@)(@@) % علقت من حين ، ومن شقوتي ، % أخا مزاح يتمرى بي % % 3(@)(@@) % لابس سيما قائل صادق ، % مخبوره مخبور كذاب % 4(@)(@@) % تخبرني عن قلبه كتبه : % إن به أعظم مما بي % % 5(@)(@@) % حتى كأني واجد حسه ، % أو مسه من دون أطرابي % % PageV01P101 البحر : طويل 1(@)(@@) % تشببت الخضراء بعد مشيبها ، % ولم تك إلا بالأمين تشبب % 2(@)(@@) % رددت عليها ما مضى من شبابها ، % وجددت منها منظرا كاد يخرب % 3(@)(@@) % لئن كان من هارون فيك مشابه ، % لأنت إلى المنصور بالشبه أقرب % 4(@)(@@) % لأنك ، إن جداك عدا فإنما % % تصير إلى المنصور من حيث تنسب % 5(@)(@@) % نراك ابنه من جانبيه كليهما ، % فمن جانب جد ، ومن جانب أب % 6(@)(@@) % إمام عليه هيبة ومحبة ، % ألا حبذا ذاك المهيبث المحبب % PageV01P102 البحر : خفيف تام 1(@)(@@) % سخر الله للأمين مطايا % % لم تسخر لصاحب المحراب % 2(@)(@@) % فإذا ما ركابه سرن برا ، % سار في الماء راكبا ليث غاب % 3(@)(@@) % أسدا باسطا ذارعيه يغدو % % أهرت الشدق ، كالح الأنياب % 4(@)(@@) % لا يعانيه باللجام ، ولا السو % ط ، ولا غمز رجله في الركاب % 5(@)(@@) % عجب الناس إذا رأوه على سو % % رة ليث يمر مر السحاب % 6(@)(@@) % سبحوا إذا رأوك سرت عليه ، % كيف لو أبصروك فوق العقاب 
ms23	 % 7(@)(@@) % ذات زور ، ومنسر وجناحي % ن ، تشق العباب بعد العباب % 8(@)(@@) % تسبق الطير في السماء ، إذا ما اس % % تعجلوها بجيئة وذهاب % 9(@)(@@) % بارك الله للأمين ، وأبق % % ه ، وأبقى له رداء الشباب % 10(@)(@@) % ملك تقصر المدائح عنه ، % هاشمي ، موفق للصواب % PageV01P103 البحر : طويل 1(@)(@@) % لقد قام خير الناس من بعد خيرهم ، % فليس على الأيام والدهر معتب % 2(@)(@@) % فأضحى أمير المؤمنين محمد ، % و ما بعده للطالب الخير مطلب % 3(@)(@@) % فلا زالت الآفات عنك بمعزل ، % و لازلت تحلو في القلوب ، وتعذب % 4(@)(@@) % لك الطينة البيضاء من آل هاشم ، % و أنت وإن طابوا أعف وأطيب % PageV01P104 البحر : خفيف تام 1(@)(@@) % لا أحط الحزام طوعا عن المح % ذوف دون ابن خالد الوهاب % 2(@)(@@) % فإذا ما وردت بحر أبي الفض % % ل نفضت النحوس عن أثوابي % % 3(@)(@@) % صورة المشتري لدى بيت نور ا % % لليل ، والشمس أنت عند النصاب % 4(@)(@@) % ليس راويس ، حين سار أمام ال % % حوت ، والبدر ، إذ هوى لانصباب % 5(@)(@@) % منك أسخى بما تشح به الأن % فس ، عند انتقاص در الحلاب % 6(@)(@@) % لا ، وبهرام يستقل سماء ال % % غرب ، والليل زائد في الحساب % 7(@)(@@) % منك أمضى لدى الحروب ، ولا أه % % ول في العين عند ضرب الرقاب % PageV01P105 البحر : بسيط تام 1(@)(@@) % قل للأمين جزاك الله صالحة % لا تجمع الدهر بين السخل والذيب % 2(@)(@@) % السخل يعلم أن الذئب آكله ؛ % والذيب يعلم ما بالسخل من طيب % PageV01P106 البحر : منسرح 1(@)(@@) % لست بدار عفت وغيرها % % ضربان من قطرها وحاصبها % % 2(@)(@@) % ولا لآي الطلول أندبها ، % للريح والرقش من قرانبها % % 3(@)(@@) % و لا نطيل البكا إذا شطت الني % % ة ، واستعبرت لذاهبها % % 4(@)(@@) % بل نحن أرباب ناعط ، ولنا % % صنعاء ، والمسك من محاربها % % 5(@)(@@) % و كان منا الضحاك يعبده ال % % خائل ، والوحش من مساربها % % 6(@)(@@) % ودان أذواؤنا البرية من % معترها رغبة وراهبها % % 7(@)(@@) % ونحن إذ فارس تدافع به % رام قسطنا على مرازبها % % 8(@)(@@) % بالخيل شعثا على لواحق كالسي % % يدان تعطي مدى مذاهبها % % 9(@)(@@) % بالسود من حمير ومن سلف % أرغن والشم من مناسبها % % 10(@)(@@) % و يوم ساتيداما ضربنا بني 
ms24	 الأص % % فر ، والموت في كتائبها % % PageV01P107 11(@)(@@) % إذ لاذ برواز يوم ذاك بنا % % والحرب تمري بكف حالبها % % 12(@)(@@) % يذوذ عنه بني قبيصة بالخ % طي والبيض من قواضبها % % 13(@)(@@) % حتى دفعنا إليه مملكة % ينحسر الطرف عن مواكبها % % 14(@)(@@) % و فاض قابوس في سلاسلنا ، % سنين سبعا ، وفت لحاسبها % % 15(@)(@@) % ونحن حزنا من غير ما كنب ، % بنات أشرافهم لغاصبها % % 16(@)(@@) % من كل مسبية إذا عثرت % قالت لعا متعة لكاسبها % % 17(@)(@@) % تعسا لمن ضيع المحارم يوم % الروع يجتاح من صواحبها % % 18(@)(@@) % و فر من خشية الطعان وأن % يلقى المنايا بكف جالبها % % 19(@)(@@) % فافخر بقحطان غير مكتئب ، % فحاتم الجود من مناقبها % % 20(@)(@@) % ولا ترى فارسا كفارسها ، % إذ زالت الهام عن مناكبها % % PageV01P108 21(@)(@@) % عمر و وقيس والأشتران وزي % % د الخيل أسد لدى ملاعبها % % 22(@)(@@) % بل مل إلى الصيد من أشاعثها % % و السادة الغر من مهالبها % % 23(@)(@@) % و الحي غسان والأولى أودعوا % % الملك ، وحازوا عرنين ناصبها % % 24(@)(@@) % وحمير تنطق الرجال بما اختا % % رت من الفضل في مراتبها % % 25(@)(@@) % أحبب قريشا لحب أحمدها ، % واعرف لها الجزل من مواهبها % % 26(@)(@@) % إن قريشا ، إذا هي انتسبت % كان لها الشطر من مناسبها % % 27(@)(@@) % فأم مهدي هاشم أم موسى % % الخير منا ، فافخر وسام بها % % 28(@)(@@) % إن فاخرتنا فلا افتخار لها ، % إلا التجارات من مكاسبها % % 29(@)(@@) % واهج نزارا وافر جلدتها ، % و هتك الستر عن مثالبها % % 30(@)(@@) % أما تميم ، فغير داحضة % ما شلشل العبد في شواربها % % PageV01P109 31(@)(@@) % أول مجد لها وآخره ، % إن ذكر المجد ، قوس حاجبها % % 32(@)(@@) % و بئس فخر الكريم من قصب ال % % شوحط صفراء في معالبها % % 33(@)(@@) % و قيس عيلانا لا أريد لها % % من المخازي سوى محاربها % % 34(@)(@@) % و إن أكل الأ . . . موبقها ، % ومطلق من لسان عائبها % % 35(@)(@@) % و لم تعف كلبها بنو أسد % عبيد عيرانة ، وراكبها % % 36(@)(@@) % و ما لبكر بن وائل عصم ، % إلا بحمقائها وكاذبها % % 37(@)(@@) % و تغلب تندب الطلول ، ولم % % تثأر قتيلا على ذنائبها % % 38(@)(@@) % نيلت بأدنى المهور أختهم ، % قسرا ، ولم يدم أنف خاطبها % % PageV01P110 البحر : طويل 1(@)(@@) % منحتكم يا أهل 
ms25	 مصر نصيحتي ، % ألا فخذوا من ناصح بنصيب % 2(@)(@@) % ولا تثبوا وثب السفاه ، فتركبوا % % على حد حامي الظهر غير ركوب % 3(@)(@@) % فإن يك فيكم إفك فرعون باقيا ، % فإن عصا موسى بكف خصيب % 4(@)(@@) % رماكم أمير المؤمنين بحية ، % أكول لحيات البلآد شروب % PageV01P111 البحر : كامل تام 1(@)(@@) % تلقى المراتب للحسين ذليلة ، % وإذا سواه يرومها تتعصب % 2(@)(@@) % أعطيت أثمان المحامد أهلها ، % وكسبت صفوتها ونعم المكسب % 3(@)(@@) % إن الإمام إذا اجتباك بسره ، % لمسدد فيما أتى ، ومصوب % 4(@)(@@) % لم يبل مثلك عفة فيما بلا ، % و حرامة في كل أمر يحزب % 5(@)(@@) % و خلطت خوفك للإله بخوفه ، % فعلمت ما تأتي ، وما تتجنب % 6(@)(@@) % أبلغ ، هديت ، إلى الإمام رسالة % عني بأني بعدها أستعتب % 7(@)(@@) % و شهادتي أني حليف عبادة ، % فابلوا على الأيام ذاك ، وجربوا % % PageV01P112 البحر : مجزوء الرمل 1(@)(@@) % لارعى الله ابن روح ، % وسخ اسمي بلعابه % 2(@)(@@) % أسقم اسمي ريح فيه ، % فأظن اسمي لما به % 3(@)(@@) % فاطلبوا لي اسما سواه % و أجدوا في طلابه % % PageV01P113 البحر : سريع 1(@)(@@) % أصبحت محتاجا إلى ضربي ، % إذ أطلب الرزق إلى كلب % 2(@)(@@) % إلى امرئ يطعن في دينه ، % يورق منه خشب الصلب % PageV01P114 البحر : وافر تام 1(@)(@@) % أمير المؤمنين ، وأنت عفو ، أمير المؤمنين ، وأنت عفو ، % و مالك في الخلائق من ضريب % 2(@)(@@) % علام ، وأنت ذو حزم ورأي ، % تصير أمر مصر إلى الخصيب % 3(@)(@@) % فتى ما دان للرحمان دينا ، % وما إن زال يسجد للصليب % PageV01P115 البحر : بسيط تام 1(@)(@@) % الحمد لله هذا أعجب العجب ، % الهيثم بن عدي صار في العرب % 2(@)(@@) % يا هيثم بن عدي لست للعرب ، % و لست من طيء إلا على شغب % 3(@)(@@) % إذا نسبت عديا في بني ثعل ، % فقدم الدال قبل العين في النسب % 4(@)(@@) % كأنني بك فوق الجسر منتصبا % على جواد قريب منك في الحسب % 5(@)(@@) % حتى نراك وقد درعته قمصا % من الصديد مكان الليف والكرب % 6(@)(@@) % لله أنت ، فما قربى تهم بها ، % إلا اجتليت لها الأنساب من كثب % 7(@)(@@) % فلا تزال أخا حل ومرتحل % غلى الموالي ، وأحيانا إلى العرب % PageV01P116 البحر : - 1(@)(@@) % ألا يا 
ms26	 حادثا فيه % % لمن يتعجب العجب % 2(@)(@@) % لأسماء يسميهن % أشجع حين ينتسب % 3(@)(@@) % تعلمها وإخوته ، % فكلهم بها ذرب % 4(@)(@@) % فيا لك عصبة إن حد % ثوا عن أصلهم كذبوا % % 5(@)(@@) % و هم ما لم تنقر عن % % أروم أصولهم عرب % 6(@)(@@) % لهم في بيتهم نسب ، % و في وسط الملا نسب % 7(@)(@@) % كما لم تخف سافرة ، % و تنكر حين تنتقب % PageV01P117 البحر : طويل 1(@)(@@) % لقد غرني من جعفر حسن بابه ، % و لم أدر أن اللؤم حشو إهابه % % 2(@)(@@) % فلست ، وإن أخطأت في مدح جعفر ، % بأول إنسان خري في ثيابه % PageV01P118 البحر : سريع 1(@)(@@) % سيروا إلى أبعد منتاب ، % قد ظهر الدجال بالزاب % 2(@)(@@) % هذا ابن نيبخت له إمرة ، % صاحب كتاب وحجاب % PageV01P119 البحر : رجز تام 1(@)(@@) % بات علي ، وأبات صحبه % في سوءة أكثر منها عتبه % 2(@)(@@) % بشادن لا يسأمون قربه ، % قد جمعوا آذانه وعقبه % 3(@)(@@) % لم يخش في شهر الصيام ربه ، % يا ربنا لا تغفرن ذنبه % PageV01P120 البحر : طويل 1(@)(@@) % ألا حي أطلالا بسيحان ، فالعذب % إلى برع ، فالبئر بئر أبي زغب % 2(@)(@@) % تمر بها عفر الظباء كأنها % % أخاريد من روم يقسمن في نهب % 3(@)(@@) % عليها من السرحاء ظل كأنه % % هذاليل ليل غير منصرم النحب % 4(@)(@@) % تلاعب أبكار الغمام ، وتنتمي % % إلى كل زعلوق ، وخالفة صعب % 5(@)(@@) % منازل كانت من جذام وفرتنى % % و تربهما هند ، فأبرحت من ترب % 6(@)(@@) % غذا مات تميمي أتاك مفاخرا % فقل عد عن ذا كيف أكلك للضب % 7(@)(@@) % تفاخر أبناء الملوك سفاهة ، % و بولك يجري فوق ساقك والكعب % 8(@)(@@) % إذا ابتدر الناس الفعال فخذ عصا % % و دعدع بمعزى يا بن طالقة الذرب % 9(@)(@@) % فنحن ملكنا الأرض شرقا ومغربا ، % و شيخك ماء في الترائب والصلب % 10(@)(@@) % فلما أبى إلا افتخارا بحاجب % هتمت ثناياه بجندلة الشعب % PageV01P121 11(@)(@@) % تفاخرنا جهلا بظئر نبينا ، % ألا إنما وجه التميمي من هضب % 12(@)(@@) % أما بنو دودان ، والحي كاهل ، % فمن جلدة بين الحزيمين والعجب % 13(@)(@@) % فخرتم سفاها أن غدرتم بربكم ، % فمهلا بني اللكناء في كبة الحرب % 14(@)(@@) % فأنتم غطاريس الخميس ، إذا غزا ، % غذاؤكم تلك الأخاطيط 
ms27	 في الترب % 15(@)(@@) % و كنتم على است الدهر لا تنكرونه % عبيد البهاليل السباط بني وهب % 16(@)(@@) % ويوم الصفا أسلمتم رهط حاجب ، % فأنتم من الكنفان أوضع في الوثب % 17(@)(@@) % و آب أبوكم قد اجر لسانه ، % يمج على عثنونه علق الحلب % 18(@)(@@) % و ضيعتم في العامريين نكيركم ، % وقد لحبوا منه السنام عن الصلب % 19(@)(@@) % فأوجعتم بالسمهري ؛ فذقتم % مرارتها مثل العلاقم في العب % 20(@)(@@) % فأصبح رأس الفقعسي كأنما % % تخطفه أقنى ، أبو أفرخ زغب % PageV01P122 21(@)(@@) % وأنتم شمتم بابن دارة سالم ، % فجازتكم الأيام نكبا على نكب % 22(@)(@@) % منعتم أخاكم عقبة وهو رامض ، % وحلأتموه أن يذوق من العذب % 23(@)(@@) % فمتم بأيديكم ، فلا مات غيركم ، % و غنى بكم أبناء دارة في الشرب % 24(@)(@@) % فإن تك منكم شعرة ابنة معكد % فشعرة من شعر العجان أو الأسب % PageV01P123 البحر : كامل تام 1(@)(@@) % خبز الخصيب معلق بالكوكب % يحمى بكل مثقف ومشطب % 2(@)(@@) % جعل الطعام على السغاب محرما % % قوتا ، وحلله لمن لم يسغب % 3(@)(@@) % فإذا هم رأوا الرغيف تطربوا % % طرب الصيام إلى أذان المغرب % PageV01P124 البحر : طويل 1(@)(@@) % رغيف سعيد عنده عدل نفيه % % يقلبه طورا ، وطورا يلاعبه % 2(@)(@@) % و يخرجه من كمه ، فيشمه ، % ويجلسه في حجره ويخاطبه % 3(@)(@@) % وإن جاءه المسكين يطلب فضله ، % فقد ثكلته أمه وأقاربه % 4(@)(@@) % يكر عليه السوط من كل جانب ، % وتكسر رجلاه ، وينتف شاربه % PageV01P125 البحر : مجزوء الرمل 1(@)(@@) % قد علا الديوان كابه % مذ تولاه ابن سابه % 2(@)(@@) % يا غراب البين في الشؤ % % م ، وميزاب الجنابه % 3(@)(@@) % يا كتابا بطلاق ، % يا عزاء بمصابه % 4(@)(@@) % يا مثالا من هموم ، % يا تباريح كآبه % 5(@)(@@) % يا رغيفا رده البقا % % ل يبسا وصلابه % 6(@)(@@) % ما على وجه به قا % % بلتني اليوم مهابه % 7(@)(@@) % كاتب أيضا ، ومر % على رأس الكتابه ! % PageV01P126 البحر : كامل تام 1(@)(@@) % نفس الخصيب جميعه كذب ، % و حديثه لجليسه كرب % 2(@)(@@) % تبكي الثياب عليه معولة % أن قد يجر ذيولها كلب % PageV01P127 البحر : مجزوء الكامل 1(@)(@@) % فاضت دموعك ساكبه ، % جزعا لمصرع والبه % 2(@)(@@) % قامت بموت أبي أسا % % مة ، في الزقاق ، النادبه % 3(@)(@@) % قامت تبث من 
ms28	 المكا % % رم غير قيل الكاذبه % 4(@)(@@) % فجعت بنو أسد به ، % وبنو نزار قاطبه % 5(@)(@@) % بلسانها ، وزعيمها ، % % 6(@)(@@) % لا تبعدن أبا أسا % % مة ؛ فالمنية واجبه % 7(@)(@@) % كل امريء تغتاله % منها سهام صائبه % 8(@)(@@) % كتب الفناء على العبا % % د ، فكل نفس ذاهبه % 9(@)(@@) % كم من أخ لك قد ترك % ت همومه بك ناصبه % 10(@)(@@) % قد كان يعظم قبل مو % تك أن تنوب النائبه ! % PageV01P128 البحر : طويل 1(@)(@@) % لعمرك ما أبقى لنا الموت باقيا ، % نقر به عينا غداة نؤوب % 2(@)(@@) % كأني وترت الموت بابن أفاده ، % على حين حانت كبرة ومشيب % PageV01P129 البحر : بسيط تام 1(@)(@@) % إني عجبت ، وفي الأيام معتبر ، % والدهر يأتي بألوان الأعاجيب % 2(@)(@@) % من صاحب كان دنيائي وآخرتي ، % عدا علي جهارا عدوة الذيب % 3(@)(@@) % من غير ذنب ولا شيء قرفت به % أبدى خبيئته ظلما ، وأغري بي % % 4(@)(@@) % يا واحدي من جميع الناس كلهم ، % ماذا أردت إلى سبي وتأنيبي % % 5(@)(@@) % قد كان لي مثل لو كنت أعقله % % من قول غالب لفظ غير مغلوب % 6(@)(@@) % ' لا تحمدن امرأ حتى تجربه ، % ولا تذمنه من غير تجريب % PageV01P130 البحر : سريع 1(@)(@@) % إن دام إفلاسي على ما أرى ، % هجرت إخواني وأصحابي % % 2(@)(@@) % وبعت أثوابي ، وإن بعتها % % بقيت بين الدار والباب % PageV01P131 البحر : مديد تام 1(@)(@@) % ربما أغدو معي كلبي ، % طالبا للصيد في صحبي % % 2(@)(@@) % فسمونا للحزيز به ، % فدفعناه على أظب % 3(@)(@@) % فاستدرته ، فدر لها ، % يلطم الرفقين بالترب % 4(@)(@@) % فادراها ، وهي لاهية ، % في جميم الحاذ والغرب % 5(@)(@@) % ففرى جماعهن كما % % قد مخلولان من عصب % 6(@)(@@) % غير يعفور أهاب به ، % جاب دفيه عن القلب % 7(@)(@@) % ضم لحييه بمخطمه ، % ضمك الكسرين بالشعب % 8(@)(@@) % وانتهى للباهيات كما % % كسرت فتخاء من لهب % 9(@)(@@) % ظل بالوعساء ينغضه ، % أزما منه على الصلب % 10(@)(@@) % تلك لذاتي ، وكنت فتى ، % لم أقل من لذة حسبي ! % PageV01P132 البحر : مجزوء الكامل 1(@)(@@) % سبحان علام الغيوب % عجبا لتصريف الخطوب % 2(@)(@@) % % وتجتني ثمر القلوب % 3(@)(@@) % حتى متى ، يا نفس ، تغ % ترين بالأمل الكذوب % 4(@)(@@) % يا نفس توبي قبل أن % لا تستطيعي أن تتوبي % % 5(@)(@@) % تعرى 
ms29	 فروع الأنس بي ، % رحمن إفار الذنوب % 6(@)(@@) % أما الحوادث فالريا % % ح بهن دائ % 7(@)(@@) % و الموت شرع واحد ، % و الخلق مختلفو الضروب % 8(@)(@@) % والسعي في طلب التقى ، % من خير مكسبة الكسوب % 9(@)(@@) % والموت خلق واحد ، % % PageV01P133 البحر : رجز تام 1(@)(@@) % يارب بيت بفضاء سبسب ، % بعيد بين السمك والمطنب % 2(@)(@@) % لفتية قد بكروا بأكلب ، % قد أدبوها أحسن التأدب % 3(@)(@@) % من كل أدفى ميسان المنكب ، % يشب في القود شبوب المقرب % 4(@)(@@) % يلحق أذنيه بحد المخلب ، % فما تني وشيقة من أرنب % 5(@)(@@) % عندهم أوتيس وبل علهب ، % و فروة مسلوبة من ثعلب % 6(@)(@@) % مقلوبة الجلدة أو لم تقلب ، % وعير عانات وأم تولب % PageV01P134 البحر : رجز تام 1(@)(@@) % لما رأيت الليل منشق الحجب ، % عن سائل الغرة مئهور النقب % 2(@)(@@) % نازلت عصم الوحش عنا من كثب ، % من كل أحوى اللون مبيض الذنب % 3(@)(@@) % يهتز عند الشد بل والمنجذب ، % هزاك بالكف حساما ذا شطب % % 4(@)(@@) % كأنما يطرف من بين الهدب ، % بجمرتي نار بكف محتطب % 5(@)(@@) % ما كان إلا جولة الأروى الشغب ، % ووثبة التيس بأقراح الحدب % 6(@)(@@) % حتى انثنى مختضبا ، وما خضب % من مغرز الزور إلى عجب الذنب % PageV01P135 البحر : طويل 1(@)(@@) % ألا إنما الدنيا عروس ، وأهلها % % أخو دعة فيها ، وآخر لاعب % 2(@)(@@) % وذو ذلة فقرا ، وآخر بالغنى % % عزيز ، ومكظوظ الفؤاد ، وساغب % 3(@)(@@) % و بالناس كان الناس قدما ، ولم يزل % من الناس مرغوب إليه وراغب % PageV01P136 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والليل في إهابه ، % أدعج ما جرد من خضابه % 2(@)(@@) % مدثر لم يبد من حجابه ، % كالحبشي انسل من ثيابه % 3(@)(@@) % بهيكل قوبل في أنسابه ، % مردد الأعوج في أصلابه % 4(@)(@@) % يهديه مثل العقو في انتصابه ، % وكاهل وعنق يأبى به % 5(@)(@@) % يصافح اللدان من أضرابه ، % بوقح يقيه في انسيابه % 6(@)(@@) % نشا المطاريد ، وحد نابه ، % عن لنا كالرأل لا نرى به % 7(@)(@@) % ذو حوة أفرد عن أصحابه ، % يفري متان الأرض مع سهابه % 8(@)(@@) % أطاعه الحوذان في إسرابه ، % فقد رماه النحض في أقرابه % 9(@)(@@) % و الطرف قد زمل في ثيابه ، % قائده من أرن يشقى به 
ms30	 % 10(@)(@@) % قلنا له عره من أسلابه ، % فلاح كالحاجب من سحابه % PageV01P137 11(@)(@@) % أو كالصنيع استل من قرابه ، % فسدد الطرق وما هاها به % 12(@)(@@) % فانصاع كالأجدل في انصبابه ، % أو كالحريق في هشيم غابه % 13(@)(@@) % ملتهبا يستن في التهابه ، % كأنما البيداء من نهابه % 14(@)(@@) % فحازه بالرمح في أعجابه ، % شك الفتاة الدر في أحزابه % PageV01P138 البحر : رجز تام 1(@)(@@) % لما تبدى الصبح من حجابه لما تبدى الصبح من حجابه % كطلعة الأشمط من جلبابه % 2(@)(@@) % وانعدل الليل إلى مآبه % كالحبشي افتر عن أنيابه % 3(@)(@@) % هجنا بكلب طالما هجنا به % ينتسف المقود من كلابه % 4(@)(@@) % من صرخ يغلو ، إذا اغلولى به ، % وميعة تغلب من شبابه % 5(@)(@@) % كأن متنيه لدى انسلابه % متنا شجاع لج في انسيابه % 6(@)(@@) % كأنما الأظفور في قنابه % موسى صناع رد في نصابه % 7(@)(@@) % تراه في الحضر ، إذا هاها به ، % يكاد أن يخرج من إهابه % 8(@)(@@) % شدا ببطن القاع من ألهى به % يترك وجه الأرض في إلهابه % 9(@)(@@) % كأن نشوان توكلنا به % يعفو على ما جر من ثيابه % 10(@)(@@) % إلا الذي أثر من هدابه % ترى سوام الوحش تحتوى به % PageV01P139 البحر : رجز تام 1(@)(@@) % يا رب غيث آمن السروب ، % حباريات جلهتي ملحوب % 2(@)(@@) % فالقطبيات إلى الذنوب ، % يرفلن في رانس قشوب % 3(@)(@@) % من حبر عولين بالتهذيب ، % مهن أمثال النصارى الشيب % 4(@)(@@) % في يوم عيد مبرز الصليب ، % ذعرتها بمهلب الشؤبوب % 5(@)(@@) % مفهم إهابة المهيب ، % وكلمات كل مستجيب % 6(@)(@@) % أقنى إلى سائسة جنيب ، % و قد جرى منه على تأديب % 7(@)(@@) % يوفي على قفازه المجوب ، % منه بكف سبطة الترحيب % 8(@)(@@) % كأنها براثن من ذيب ، % يضبثهن في ثرى مصوب % % 9(@)(@@) % إلى وظيف فائق الظنبوب ، % و جؤجؤ مثل مداك الطيب % 10(@)(@@) % تحت جناح موجد التنكيب ، % ذي قصب مستوفر الكعوب % PageV01P140 11(@)(@@) % وحف الظهار عصل الأنبوب % آنس بين صردح ولوب % % 12(@)(@@) % بمقلة قليلة التكذيب ، % طراحة خلف لقى الغيوب % 13(@)(@@) % فانقض مثل الحجر المندوب ، % منكفتا تكفت الجنيب % 14(@)(@@) % في الشطر من حملاقه المقلوب % على رفل بالضحى ضغوب % 15(@)(@@) % بذي نواس مرهف الكلوب % غادر في جؤشوشه 
ms31	 المثقوب % 16(@)(@@) % جياشة تذهب في أسلوب ، % بصائك من علق صبيب % 17(@)(@@) % فاصطاد قبل ساعة التأويب ، % خمسين في حسابه المحسوب % 18(@)(@@) % فالقوم من مقتدر مصيب ، % ومعجل النشل عن التضهيب % PageV01P141 البحر : رجز تام 1(@)(@@) % يا بؤس كلبي سيد الكلاب ، % قد كان أغناني عن العقاب % 2(@)(@@) % و كان قد أجزى عن القصاب ، % وعن شراء الجلب الجلاب % 3(@)(@@) % يا عين جودي لي على حلاب ! % من للظباء العفر والذئاب % 4(@)(@@) % و كل صقر طالع وثاب ، % يختطف القطان في الروابي % % 5(@)(@@) % كالبرق بين النجم والسحاب ، % كم من غزال لاحق الأقراب % 6(@)(@@) % ذي جيئة ، صعب وذي ذهاب ، % أشبعني منه من الكباب % 7(@)(@@) % خرجت ، والدنيا إلى تباب ، % به ، وكان عدتي ونابي % % 8(@)(@@) % أصفر قد خرج بالملاب ، % كأنما يدهنث بالزرياب % 9(@)(@@) % فبينما نحن به في الغاب ، % إذ برزت كالحة الأنياب % 10(@)(@@) % رقشاء جرداء من الثياب ، % كأنما تبصر من نقاب % PageV01P142 11(@)(@@) % فعلقت عرقوبه بناب ، % لم ترع لي حقا ، ولم تحاب % 12(@)(@@) % فخر وانصاعت بلا ارتياب ، % كأنما تنفخ من جراب % 13(@)(@@) % لاأبت إن أبت بلا عقاب ، % حتى تذوقي أوجع العذاب % PageV01P143 البحر : رجز تام 1(@)(@@) % يارب خرق نازح حديب ، % أخضله السحاب بالصبيب % 2(@)(@@) % غزوته بمخطف وثوب ، % مضمر الكشحين كاليعسوب % 3(@)(@@) % مصدر ، ملائم العرقوب ، % كأنما يفغر عن قليب % 4(@)(@@) % أو عن وجار ضبع أو ذيب ، % يعلو الإكام في عرى الكثيب % 5(@)(@@) % وتارة ينحط في الغيوب ، % كعوم سفن البحر في الجنوب % 6(@)(@@) % رأى ظباء ذعر القلوب ، % نائية عن نظر المهيب % 7(@)(@@) % فاعتاقها بالشد ذي اللهيب % كأنه في شدة الهببوب % 8(@)(@@) % تهوي به خافيتا رقوب ، % معتمدا لتيسها المهيب % 9(@)(@@) % فصكه بزوره الرحيب % صكا هوى منه إلى شعوب % 10(@)(@@) % فقضقض العجب إلى الظنبوب ، % وانتهس الأرفاغ بالنيوب % PageV01P144 11(@)(@@) % يهوي به صكا على الجنوب % كثائر أمكن من مطلوب % 12(@)(@@) % يالك من ذي حيلة كسوب % % PageV01P145 البحر : سريع 1(@)(@@) % ربع البلى أخرس ، عميت ، % مستلب المنطق ، سكيت % 2(@)(@@) % أعره حيرته عاشق ، % رأى حبيبا ، فهو مبهوت % 3(@)(@@) % ولا عجيب إن جفت دمنة % عن مستهام نومه قوت % 4(@)(@@) % و قهوة كالمسك مشمولة % منزلها 
ms32	 الأنبار أو هيت % 5(@)(@@) % كأنها الشمس ، إذا صفقت % مسكنها الكبش ، أو الحوت % 6(@)(@@) % أو دارة البدر ، إذا ما استوى ، % و تم اللعد المواقيت % 7(@)(@@) % كأنها هذاك في حسنه ، % أو وجه عباس ، إذا شيت % 8(@)(@@) % بل وجه عباس له حسنه % % لأنه در وياقوت % PageV01P146 البحر : بسيط تام 1(@)(@@) % لا أستزيد حبيبي من مواتاتي % % وإن عنفت عليه في الشكايات % 2(@)(@@) % هو المواصل لي لكن ينغصني % % بطول فترة ما بين الزيارات % % 3(@)(@@) % قالوا : ظفرت بمن تهوى ، فقلت لهم : % الآن أكثر ما كانت صباباتي % % 4(@)(@@) % لا عذر للصب أن تهوى جوانحه ، % و قد تطضعم فوه بالمواتاة % 5(@)(@@) % وداهري سما في فرع مكرمة % من معشر خلقوا في الجود غايات % 6(@)(@@) % ناديته بعدما مال النجوم ، وقد % % صاح الدجاج ببشرى الصبح مرات % 7(@)(@@) % فقلت ، والليل يجلوه الصباح كما % % يجلو التبسم عن غر الثنيات % 8(@)(@@) % يا أحمد المرتجى في كل نائبة % قم سيدي نعص جبار السموات % 9(@)(@@) % وهاكها قهوة صهباء ، صافية % منسوبة لقرى هيت وعاتنات % 10(@)(@@) % ألزه بحمياها ، وأزجره % باللين طورا ، وبالتشديد تارات % PageV01P147 11(@)(@@) % حتى تغنى ، وما تم الثلاث له % % حلو الشمائل ، محمود السجيات % 12(@)(@@) % ' ياليت حظي من مالي ومن ولدي % % أنذي أجالس لبنى بالعشيات ! ' % PageV01P148 البحر : رجز تام 1(@)(@@) % يا أيها العاذل دع ملحات % و الوصف للموماة والفلاة % 2(@)(@@) % دراسة ، وغير دراست % ولاقها بأصدق النيات % 3(@)(@@) % حتى تلاقي رب شاصيات % محتطبات لا مخضرات % 4(@)(@@) % بنات كسرى خير ما بنات % جلبن من هيت ومن عانات % 5(@)(@@) % محتجبات غير باديات % إلا بأن يجلبن بالطاسات % 6(@)(@@) % للخاطب المبتكر المواتي % % فسمها بالشيخ لا الفتاة % 7(@)(@@) % ثم اقتعدها باكر الغداة % فاستل منها مهج الحياة % 8(@)(@@) % عن عقد أوفت لذي ميقات % إلى أباريق ، مفدمات % 9(@)(@@) % يصغين للكؤوس راكعات % فهي إذا شجت على العلات % 10(@)(@@) % ببارد الماء من الفرات % تخال فيها ألسن الحيات % PageV01P149 11(@)(@@) % أو وقد نيران على الحافات % أفديك خذها من يدي ، وهات % 12(@)(@@) % عذبني حب غلاميات % ذوات أصداغ معقربات % 13(@)(@@) % نقومات القد ، مهضومات % يمشين في قمص مزررات % 14(@)(@@) % يصلحن للاطة والزناة % أكني بوصفهن عن 
ms33	 مولاتي % % 15(@)(@@) % تلك التي في يدها حياتي % % PageV01P150 البحر : بسيط تام 1(@)(@@) % سقيا للبنى ، ولا سقيا لعنات سقيا للبنى ، ولا سقيا لعنات % سقيا لقطربل ذات اللذاذات % 2(@)(@@) % وإن فيها بنات الكرم ما تركت % منها الليالي سوى تلك الحشاشات % 3(@)(@@) % كأنها دمعة في عين غانية % مرهاء ، رقرقها ذكر المصيبات % 4(@)(@@) % تنزو إذا مسها قرع المزاج كما % % تنزو الجنادب ذكر أوقات الظهيرات % 5(@)(@@) % وتكتسي لؤلؤات من تعطفها % % عند المزاج شبيهات بواوات % PageV01P151 البحر : وافر تام 1(@)(@@) % لنا خمر ، وليس بخمر مخل ، % و لكن من نتاج الباسقات % 2(@)(@@) % كرائم في السماء ، زهين طولا % ففات ثمارها أيدي الجناة % 3(@)(@@) % قلائص في الرؤوس لها ضروع % تدر على أكف الحالبات % 4(@)(@@) % صحائح لا تعد ، ولا نراها % % عجافا في السنين الماحلات % 5(@)(@@) % مسارحها المدار ، فبطن جوخى % % إلى شط الأبلة فالفرات % 6(@)(@@) % تراثا عن أوائل أولينا % % بني الأحرار ، أهل المكرمات % 7(@)(@@) % تذب بها يد المعروف عنا % % وتصبر للحقوق اللازمات % 8(@)(@@) % فحين بدا لك السرطان يتلو % % كواكب كالنعاج الراتعات % 9(@)(@@) % بدا بين الذوائب في ذراها % % نبات كالأكف الطالعات % 10(@)(@@) % فشققت الأكف ، فخلت فيها % % لآلىء في السلوك منظمات % PageV01P152 11(@)(@@) % و مازال الزمان بحافتيها % % و تقليب الرياح اللاقحات % 12(@)(@@) % فعاد زمردا ، واخضر حتى % % تخال به الكباش الناطحات % 13(@)(@@) % فلما لاح للساري سهيل ، % قبيل الصبح من وقت الغداة % 14(@)(@@) % بدا الياقوت ، وانتسبت إليه % بحمر ، أو بصفر فاقعات % 15(@)(@@) % فلما عاد آخرها خبيصا ، % بعثت جناتها بمعقفات % 16(@)(@@) % فضمن صفو ما يجنون منها % % خوابي ، كالرجال ، مقيرات % 17(@)(@@) % وقلت : استعجلوا ، فاستعجلوها % % بضرب بالسياط محدرجات % 18(@)(@@) % ذوائب أمها جعلت سياطا % تحث ، فما تناهى ضاربات % 19(@)(@@) % فولدت السياط لها هديرا % كترجيع الفحول الهائجات % 20(@)(@@) % فلما قيل قد بلغت ، ولما ، % وتوشك أن تقر ، وأن تؤاتي % % PageV01P153 21(@)(@@) % نسجت لها عمائم من تراب % و ماء ، محكمات موثقات % 22(@)(@@) % سترت الجو خوفا من أذاه % فباتت من أذاه آمنات % 23(@)(@@) % فلما قيل قد بلغت كشفنا ال % % عمائم عن وجوه مشرقات % 24(@)(@@) % حساها كل أروع ، شيظمي % كريم الجد ، محمود مؤات % 25(@)(@@) % تحية بينهم ( تفديك روحي 
ms34	 ! % وى خر قولهم ' أفديك ! هات . . ' % PageV01P154 البحر : مجتث 1(@)(@@) % يا نفس كيف لطفت % للصبر حتى صبرت ؟ ! % 2(@)(@@) % ألست صاحبتي يو % م ودعوني ألست ؟ ! % 3(@)(@@) % يا نفس ليتك مني % % يوم الفراق سقطت % 4(@)(@@) % ويل الفؤاد المعنى % % من الفراق المشت % 5(@)(@@) % أستودع الله ريما ، % فارقته منذ ست % 6(@)(@@) % وذات نصح أتتني % % تفجر الماء تحتي % % 7(@)(@@) % تقول : ويحك دعها ، % لساعة ولوقت % 8(@)(@@) % تجني بذلك ودي ، % فما جنت غير مقت % 9(@)(@@) % فقلت نفسي وأهلي % % لها الفداء ، وأنت % 10(@)(@@) % يا عين ما لك لما % % ورطت قلبي سكنت % PageV01P155 11(@)(@@) % و مااستعنتك إلا % أبرقت لي ورعدت % 12(@)(@@) % فكنت مثل اليهودي % فعله ما خرمت % 13(@)(@@) % احتجت يوما إليه ، % فقال : ذا يوم سبت ! % PageV01P156 البحر : مخلع البسيط 1(@)(@@) % نالي على الحب من ثبات ، % إن كان مولاي لا يواتي % % 2(@)(@@) % كيف مواتاة من عليه % أهون من ذرة حياتي % % 3(@)(@@) % إن قلت كذبت ، أو شكوت % هانت على نفسه شكاتي % % 4(@)(@@) % يا عبد أصبحت ، فاعلميني ، % غير حريص على وفاتي % % 5(@)(@@) % إن قلت مت ، مت في مكاني ، % أو قلت عش عشت من مماتي % % 6(@)(@@) % عاقبتني ظالما بذنب ، % فسر من سر من عداتي % % 7(@)(@@) % إني على ما ارتكبت مني % % أدعو لك الله في صلاتي % % 8(@)(@@) % ويلي على شادن سباني ، % أهون من ذرة حياتي % % 9(@)(@@) % نصفين نصف نقا ، ونصف % أحلى استواء من القناة % PageV01P157 البحر : سريع 1(@)(@@) % ياذا الذي يخطر في مشيته ، % قد صفف الشعر على جبهته % 2(@)(@@) % وسرح المئزر من خلفه ، % و دقق البان على وفرته % 3(@)(@@) % قلبي ، على ماكان من شقوته ، % صب بمن يهوى على جفوته % 4(@)(@@) % يختلق السخطة لي ظالما ، % أحوج ما كنت إلى رحمته % 5(@)(@@) % أكلما جدد لي موعدا ، % أخلفه التنغيص من علته % 6(@)(@@) % أضمر في البعد عتابا له ، % فإن دنا أنسيت من هيبته % 7(@)(@@) % مبتل ، تثنيه أعطافه % أميس خلق الله في خطرته % 8(@)(@@) % مهفهف ترتج أردافه ، % يتيه بالحسن على جيرته % 9(@)(@@) % يحار رجع الطرف في وجهه ، % و صورة الشمس على صورته % % 10(@)(@@) % ينتسب الحسن إلى حسنه ، % و الطيب يحتاج إلى نكهته % % PageV01P158 11(@)(@@) % وليلة 
ms35	 قصر في طولها % % بالكرخ ، أن متعت من رؤيته % % 12(@)(@@) % في مجلس يضحط تفاحه % بين الرياحين إلى خضرته % % 13(@)(@@) % ما إن يرى خلوتنا ثالث ، % إلا الذي نشرب من خمرته % % 14(@)(@@) % خمرته في الكأس ممزوجة ، % كالذهب الجاري على فضته % 15(@)(@@) % فتارة أشرب من ريقه ، % وتارة أشرب من فضلته % 16(@)(@@) % وكلما عضض تفاحة ، % قبلت ما يفضل من عضته % % 17(@)(@@) % حتى إذا ألقى قناع الحيا ، % ودار كسر النوم في مقلته % 18(@)(@@) % سرت حميا الكأس في رأسه ، % و ذبت الخمرة في وجنته % % 19(@)(@@) % فصار لا يدفع عن نفسه ، % وكان لا يأذن في قبلته % 20(@)(@@) % دب له إبليس ، فاقتاده % و الشيخ نفاع على لعنته % % PageV01P159 21(@)(@@) % عجبت من إبليس في تيهه % وخبث ما أظهر من نيته % 22(@)(@@) % تاه على آدم في سجدة ، % وصار قوادا لذريته % PageV01P160 البحر : مجتث 1(@)(@@) % ما لي وللعاذلات % زوقن لي ترهات % 2(@)(@@) % سعين من كل فج % يلمن في مولاتي % % 3(@)(@@) % يأمرنني أن أخلي % % من راحتي حياتي % % 4(@)(@@) % وذاك ما لا أراه % % يكون حتى الممات % 5(@)(@@) % و الله منزل طه % % و الطور والذاريات % 6(@)(@@) % الر ، ص ، وق % و الحشر والمرسلات % 7(@)(@@) % ورب هود ونون % والنور والنازعات % 8(@)(@@) % لا رمت هجرك حبي % % حتى وإن لم تواتي % % 9(@)(@@) % يا ويلتا أي شيىء % بين الحشا واللهاة % 10(@)(@@) % من لوعة ليس تطفى % % تطير في جانحاتي % % PageV01P161 11(@)(@@) % أنا المعنى ، ومن لي % % يرثي لطول شكاتي % % 12(@)(@@) % الظاهر العبرات ، % الباطن الزفرات % 13(@)(@@) % منيت بالمتحري % % في كل أمرمساتي % % 14(@)(@@) % يا سائلي عن بلائي ، % انظر إلى لحظاتي % % 15(@)(@@) % بان الهوى في سكون ال % % محب والحركات % 16(@)(@@) % حلفت بالراقصات % في لجة الفلوات % 17(@)(@@) % و منثن بالهدايا ، % يطعن في اللبات % 18(@)(@@) % وما توافى بجمع ، % والشعب في عرفات % 19(@)(@@) % لو سمتني قبض روحي % % لشئت حقا وفاتي % % 20(@)(@@) % ويلاه من نار شوق % ترقى إلى اللهوات % PageV01P162 21(@)(@@) % فأجرت العين دمعا % تفيض فيض الفرات % 22(@)(@@) % و صاحب كان لي في % % هواي ذا تهمات % 23(@)(@@) % لم يطلع طلع شاني ، % إلا اتهام هناتي % % 24(@)(@@) % فبينما نحن نمسي % % نسيح في الطرقات % 25(@)(@@) % إذ 
ms36	 قيل شمس نهار % في أربع عطرات % 26(@)(@@) % فقلت شمس وربي ، % قد أجلت الظلمات % 27(@)(@@) % و أنزفت ماء عيني ، % و أصعدت زفراتي % % 28(@)(@@) % فالحب فيه هناة ، % موصولة بهناة % 29(@)(@@) % يعقبن طورا سرورا ، % وتارة حسرات % PageV01P163 البحر : مجتث 1(@)(@@) % يا لاعبا بحياتي ، % وهاجرا ما يؤاتي % % 2(@)(@@) % و زاهدا في وصالي ، % ومشمتا بي عداتي % % 3(@)(@@) % و حامل القلب مني % % على سنان قناة % 4(@)(@@) % ومسكن الروح ظلما % حبس الهوى من لهاتي % % 5(@)(@@) % هذا كتابي إليكم % % مداده عبراتي % % 6(@)(@@) % لو أن لي منك نصفا % أو قابلا لبراتي % % 7(@)(@@) % ما بات قلبي رهينا ، % لأنجم طالعات % 8(@)(@@) % يا بدعة في مثال ، % لا مدركا بالصفات % 9(@)(@@) % فالوجه بدر تمام ، % بعين ظبي فلاة % 10(@)(@@) % مفرد بنعيم % من الظباء اللواتي % % PageV01P164 11(@)(@@) % ترود بين ظباء % مصائف ومشاتي % % 12(@)(@@) % والجيد جيد غزال ، % والغنج غنج فتاة % 13(@)(@@) % مذكر حين يبدو ، % مؤنث الخلوات % 14(@)(@@) % من فوق خد أسيل % يضيء في الظلمات % 15(@)(@@) % وشارب يتلالا ، % حين ابتدا في النبات % 16(@)(@@) % ذاك الذي لا أسمي % % من هيبتي لثقاتي % % 17(@)(@@) % لكن إذا عيل صبري % % ذكرته في هجاتي : % 18(@)(@@) % عين ولام وميم % مليحة النغمات % PageV01P165 البحر : مجزوء الوافر 1(@)(@@) % تحدر ماء مقلته % % فخرق ورد وجنته % % 2(@)(@@) % لأني رمت قبلته % على ميقات غفلته % 3(@)(@@) % فلما وسدته الكأ % % س حل رباط جبته % % 4(@)(@@) % فويلي منه حين يفي % % ق من غمرات سكرته % 5(@)(@@) % أراه سوف يقتلني ، % ببعض سيوف مقلته % 6(@)(@@) % ولا سيما ، وقد غير % ت عقد رباط تكته % % PageV01P166 البحر : متقارب تام 1(@)(@@) % شهدت البطاقي في مجلس % و كان إلي بغيضا مقيتا % 2(@)(@@) % فقال : اقترح بعض ما تشتهي ، % فقلت اقترحت عليك السكوتا ! % PageV01P167 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والطير في مثواتها ، % لم تعرب الأفواه عن لغاتها % % 2(@)(@@) % بأكلب تمرح في قداتها ، % تعد عين الوحش من أقواتها % % 3(@)(@@) % قد لوح التقديح وارياتها ، % وأشفق القانص من خقاتها % % 4(@)(@@) % من شدة التلويح ، وافتياتها ، % وقلت قد أحكمتها فهاتها % % 5(@)(@@) % وارفع لنا نسبة أمهاتها ، % فجاء يزجيها على شياتها % % 6(@)(@@) % شم العراقيب ، مؤنفاتها ، % مفروشة الأيدي ، شرنبثاتها % % 7(@)(@@) % سودا وصفرا ، واخلنجياتها 
ms37	 ، % مشرفة الأكتاف موفداتها % % 8(@)(@@) % غر الوجوه ، ومحجلاتها ، % كأن أقمارا على لباتها % % 9(@)(@@) % ترى على أفخاذها سماتها ، % منديات ومحمياتها % % 10(@)(@@) % مسميات ، وملقباتها ، % قود الخراطيم ، مخرطماتها % % PageV01P168 11(@)(@@) % ذل المآخير ، عملساتها ، % تسمع في الآثار من وحاتها % % 12(@)(@@) % من نهم الحرص ، ومن خواتها ، % لتفثأ الأرنب عن حياتها % % 13(@)(@@) % إن حياة الكلب في وفاتها ، % حتى ترى القدر على ميقاتها ! % 14(@)(@@) % كثيرة الضيفان من عفاتها ، % تقذف جالاها بجوز شاتها % % 15(@)(@@) % ترمي بغير صائب صلاتها ! % من التظاء النار في لهاتها % % PageV01P169 البحر : بسيط تام 1(@)(@@) % وفتية كنجوم الليل أوجههم ، % من كل أغيد للغماء فراج % 2(@)(@@) % أنضاء كأس ، إذا ما الليل جنهم % ساقتهم نحوها سوقا بإزعاج % 3(@)(@@) % طرقت صاحب حانوت بهم سحرا ، % والليل منسدل الظلماء كالساج % 4(@)(@@) % لما قرعت عليه الباب ، أوجله ، % وقال ، بين مسر الخوف والراجي : % 5(@)(@@) % ' من ذا ؟ ' فقلت : ' فتى نادته لذته % % فليس عنها إلى شيء بمنعاج % 6(@)(@@) % افتح ! ' فقهقه من قولي وقال : لقد % % هيجت خوفي لأمر فيه ابهاجي % % 7(@)(@@) % ومر ذا فرح ، يسعى بمسرجة ، % فاستل عذراء لم تبرز إبهاجي % % 8(@)(@@) % مصونة حجبوها في مخدرها % % عن العيون لكسرى صاحب التاج % 9(@)(@@) % يديرها خنث في لهوه ، دمث % من نسل آذين ، ذو قرط ودواج % 10(@)(@@) % يزهى علينا بأن الليل طرته ، % و الشمس غرته ، واللون للعاج % PageV01P170 11(@)(@@) % و الدهر ليس بلاق شعب منتظم % إلا رماه بتفريق وإزعاج % PageV01P171 البحر : وافر تام 1(@)(@@) % وخمار أنخت إليه رحلي ، % إناخة قاطن ، والليل داج % 2(@)(@@) % فقلت له : اسقني صهباء صرفا % إذا مزجت توقد كالسراج % 3(@)(@@) % فقال : فإن عندي بنت عشر ، % فقلت له مقالة من يناجي : % 4(@)(@@) % أذقنيها لأعلم ذاك منها ، % فأبرز قهوة ذات ارتجاج % 5(@)(@@) % كأن بنان ممسكها أشيمت % خضابا حين تلمع في الزجاج % 6(@)(@@) % فقلت : صدقت يا خمار ، هذا % % شراب قد يطول إليه حاجي % % 7(@)(@@) % فمال إلي حين رأى سروري % % بها . والليل مرتكب الرتاج % 8(@)(@@) % فما هجم الصباح علي حتى % % رأيت الأرض دائرة الفجاج % PageV01P172 البحر : وافر تام 1(@)(@@) % أقول ، وقد رأت بالوجه مني ، % مجاجا ، يا محسنة المجاج % 2(@)(@@) % ويا أحلى ، وأشهى الناس طرا % وإن 
ms38	 شبهت ظلما بالسماج % 3(@)(@@) % صليني ، يا فدتك النفس مني ، % و خلي ذا التعمق في اللجاح % % 4(@)(@@) % و حيي ، يا فديتك من بعيد ، % فإني لست في دار الخر ؟ . % 5(@)(@@) % سنكلف ما هويت بكل شيء ، % و إن أكلفتنا لبن الدجاج % % PageV01P173 البحر : بسيط تام 1(@)(@@) % كم ليلة ذات أبراج وأروقة ، % كاليم ، تقذف أمواجا بأمواج % % 2(@)(@@) % سمرتها برشا كالغصن ، يجذبه % دعص النقا في بياض منه رجراج % % 3(@)(@@) % وسنان ، في فمه سمطان من برد % % 4(@)(@@) % كأنما وجهه ، والشعر ملبسه ، % بدر تنفس في ذي ظلمة داج % 5(@)(@@) % أخذت غرته ، والسكر يوهمه % أن قد نجا ، وهو مني غير ما ن . . . % 6(@)(@@) % فظل يسقي بماء الورد من أسف % وردا ، ويلطم ديباجا بديباج % % 7(@)(@@) % وظلت من حسنات الدهر في مهل ، % حتى أبانت عيون الصبح إزعاجي % % PageV01P174 البحر : بسيط تام 1(@)(@@) % سماه مولاه لاستملاحه السمجا ، % فاختال عجبا لما سماه وابتهجا % % 2(@)(@@) % ظبي كأن الثريا فوق جبهته ، % والمشتري في بيوت السعد ، والسرجا % % 3(@)(@@) % محكم الطرف يدمي سيف ناظره ، % غذا نحاه لقلب قال لا حرجا % % 4(@)(@@) % ما زال يعمله في الناس شاهره ، % حتى يباعد عن أوطانها المهجا % % 5(@)(@@) % لا فرج الله عني إن مددت يدي % % إليه أسأله من حبك الفرجا % % 6(@)(@@) % ولا طعمت بك السلوان ، يا أملي ، % و حل حبك في قلبي وما خرجا % % PageV01P175 البحر : خفيف تام 1(@)(@@) % وعقار كأنما نتعاطى % % في كؤوس اللحين منها سراجا % % 2(@)(@@) % خندريس ، كأنها كل طيب ، % زوجوها ، وليس تهوى الزواجا % % 3(@)(@@) % فرمت أوجه الندامى بنبل ، % ليس يدمي ، وليس يبدي شجاجا % % 4(@)(@@) % مزج الكأس لي غزال ، أديب % هاشمي ، أصاب فيها المزاجا % % 5(@)(@@) % فتحسيتها ، وناولت ظبيا % فاتر الطرف ، ساحرا ، مغناجا % % 6(@)(@@) % قال لي ، والمدام تأخذ فيه : % يا أميري إن كنت بي ملهاجا % % 7(@)(@@) % فقم الآن طائعا ! قلت : عج بي % % يا مليكي إلى الفراش ، فعاجا % % 8(@)(@@) % فحللنا هناك تكت خز ، % و حسرنا قباءه الديباجا % % 9(@)(@@) % ثم أرسلت باز صدق ، نشيطا % يقتل الوز ثم ، والدراجا % % PageV01P176 البحر : مجزوء الخفيف 1(@)(@@) % جفن عيني قد كاد يس % قط من طول ما اختلج % 2(@)(@@) % وفؤادي من 
ms39	 حر حب % ك والهجر قد نضج % 3(@)(@@) % خبريني ، فدتك نف % % سي وأهلي ، متى الفرج ؟ % 4(@)(@@) % كان ميعادنا خرو % % ج زياد ، وقد خرج % 5(@)(@@) % أنت من قتل عائذ % بك في أضيق الحرج % PageV01P177 البحر : سريع 1(@)(@@) % قد ركب الدلفين بدر الدجى ، قد ركب الدلفين بدر الدجى ، % مقتحما للماء قد لججا % % 2(@)(@@) % فأشرقت دجلة من نوره ، % وأسفر الشطان ، واستبهجا % % 3(@)(@@) % لم تر عيني مثله مركبا ، % أحسن إن سار ، وإن عرجا % % 4(@)(@@) % إذا استحثته مجاذيفه ، % أعنق فوق الماء ، أو هملجا % % 5(@)(@@) % خص به الله الأمين ، الذي % % أضحى بتاج الملك قد توجا % % PageV01P178 البحر : خفيف تام 1(@)(@@) % عاذلي في المدام غير نصيح ، % لا تلمني على شقيقة روحي % % 2(@)(@@) % لا تلمني على التي فتنتني ، % و أرتني القبيح غير قبيح % 3(@)(@@) % فهوة تترك الصحيح سقيما ، % وتعير السقيم ثوب الصحيح % 4(@)(@@) % إن بذلي لها لبذل جواد ، % واقتنائي لها اقتناء شحيح % PageV01P179 البحر : كامل تام 1(@)(@@) % يا صاحبي عصيت مصطبحا ، % وغدوت للذات مطرحا % % 2(@)(@@) % فتزودا مني محادثة ، % حذر العصا لم يبق لي مرحا % % 3(@)(@@) % إن الإمام له علي يد ، % فترقبا بمسهد صبحا % % 4(@)(@@) % لا تجمعا بي شمل ذي طرب % قد باكر الإبريق والقدحا % % 5(@)(@@) % فلئن وقرت على ملامته % لقد ابتذلت اللهو ما صلحا % % 6(@)(@@) % ووصلت أسبابي بمختلق % رخص البنان ، مخضب بلحا % % 7(@)(@@) % يزني العيون بحثسن مقلته ، % بيروح منكوحا وما نكحا % % 8(@)(@@) % يحثو اللهى لك من محاسنه ، % فإذا سنحت لوصله برحا % % 9(@)(@@) % ومدامة سجد الملوك لها ، % باكرتها ، والديك قد صدحا % % 10(@)(@@) % صرف ، إذا استنبطت سورتها ، % أدت إلى معقولك الفرحا % % PageV01P180 11(@)(@@) % وكأن فيها من جنادبها % % فرسا إذا سكنته رمحا % % 12(@)(@@) % و تنوفة يجري السراب بها % % شارفتها والظل قد مصحا % % 13(@)(@@) % ببويزل تزداد جرأته % أضما إذا ماليته رشحا % % 14(@)(@@) % ولقد ذعرت الوحش يحملني % % متقارب التقريب قد قرحا % % 15(@)(@@) % عتد يطير إذا هتفت به % فإذا رضيت بعفوه سبحا % % 16(@)(@@) % و هب الصريح له سنابكه % % وأعاره التحجيل والقرحا % % 17(@)(@@) % يثنى العجاج على مفارقه % بمقعب التقريب قد قرحا % % 18(@)(@@) % و لقد حزنت فلم أمت حزنا % و لقد 
ms40	 فرحت فلم أمت فرحا % % PageV01P181 البحر : وافر تام 1(@)(@@) % جريت مع الصبا طلق الجموح ، % وهان علي مأثور القبيح % 2(@)(@@) % وجدت ألذ عارية الليالي % % قران النغم بالوتر الفصيح % 3(@)(@@) % و مسمعة ، إذا ما شئت غنت : % متى كان الخيام بذي طلوح % 4(@)(@@) % تمتع من شباب ليس يبقى ، % وصل بعرى الغبوق عرى الصبوح % 5(@)(@@) % و خذها من مشعشعة كميت ، % تنزل درة الرجل الشحيح % 6(@)(@@) % تخيرها لكسرى رائداه ، % لها حظان من لون وريح % 7(@)(@@) % ألم ترني أبحت الراح عرضي ، % وعض مراشف الظبي المليح % PageV01P182 البحر : منسرح 1(@)(@@) % لست أرى لذة ، ولا فرحا ، % ولا نجاحا ، حتى أرى القدحا % % 2(@)(@@) % نعم سلاح الفتى المدام ، إذا % % ساوره الهم ، أم به جمحا % % 3(@)(@@) % و الخمر شيء ، لو أنها جعلت % مفتاح قفل البخيل لانفتحا % % 4(@)(@@) % لا عيش إلا المدام أشربها ، % مغتبقا تارة ، ومصطبحا % % 5(@)(@@) % يا صاح لا أترك المدام ، ولا % % أقبل في الحب قول من نصحا % % PageV01P183 البحر : بسيط تام 1(@)(@@) % وفتية نازعوا ، والليل معتكر ، % برقا تلوح به أيد وأقداح % 2(@)(@@) % أذكى سراجا ، وساقي القوم يمزجها % % فلاح في البيت كالمصباح مصباح % 3(@)(@@) % كدنا على علمنا ، للشك نسأله % أراحنا نارنا ، أم نارنا الراح ؟ % PageV01P184 البحر : سريع 1(@)(@@) % تفتير عينيك دليل على % % أنك تشكو سهر البارحه % 2(@)(@@) % عليك وجه سيىء حاله ، % من ليلة بت بها صالحه % 3(@)(@@) % رائحة الخمر ، ولذاتها ، % و الخمر لا تخفى لها رائحه % 4(@)(@@) % وغادة هاروت في طرفها % % و الشمس في قرقرها جانحه % 5(@)(@@) % تستقدح العود بأطرافها ، % ونغمة في كبدي قادحه % PageV01P185 البحر : منسرح 1(@)(@@) % يا إخوتي ذا الصباح ، فاصطبحوا % % فقد تغنت أطيره الفصح % 2(@)(@@) % هبوا خذوها ، فقد شكانا إلى ال % % إبريق من طول نومنا القدح % 3(@)(@@) % صرفا ، إذا شجها المزاج بأي % دي شاربيها تولد الفرح % 4(@)(@@) % حتى تريك الحليم ذا طرب ، % يهزه في مكانه المرح % 5(@)(@@) % وعاطها أحمدا تعاط فتى % تقصر عن وصف حسنه المدح % 6(@)(@@) % يشوقني وجهه إليها كما % % يدعوك حتى تقهقه الملح % PageV01P186 البحر : بسيط تام 1(@)(@@) % ومائل الرأس نشوان ، شدوت له : % ودع لميس وداع الصارم الاحي % % 2(@)(@@) % فعالج النفس كي 