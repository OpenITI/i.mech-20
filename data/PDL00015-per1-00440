ms431	 میدان عشرت با بتی %~% کش بود چوگان زلف اندر بر گوی ذقن PageV1P0563(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای امیرالمومنین ای شمع دین ای بوالحسن %~% ای به یک ضربت ربوده جان دشمن از بدن(@)(@@) 2 ای به تیغ تیز رستاخیز کرده روز جنگ %~% وی به نوک نیزه کرده شمع فرعونان لگن(@)(@@) 3 از برای دین حق آباد کرده شرق و غرب %~% کردی از نوک سنانت عالمی را پر سنن(@)(@@) 4 تیغ «الا الله» زدی بر فرق «لا» گویان دین %~% هر که «لا» می‌گفت وی را می‌زدی بر جان و تن(@)(@@) 5 تا جهان خالی نکردی از بتان و بت پرست %~% تا نکردی لات را شهمات و عزارا حزن(@)(@@) 6 تیغ ننهادی ز دست و درع ننهادی ز پشت %~% شاد باش ای شاه دین‌پرور چراغ انجمن(@)(@@) 7 گر نبودی زخم تیغ و تیرت اندر راه دین %~% دین نپوشیدی لباس ایمنی بر خویشتن(@)(@@) 8 لاجرم اکنون چنان کردی که در هر ساعتی %~% کافری از جور دین بر خود بدرد پیرهن(@)(@@) 9 مرحبا ای مهتری کز بیم نیغت در جهان %~% پیش چشم دشمنانت خون همی آید لبن(@)(@@) 10 فرش کفر از روی عالم در نوشتی سر بسر %~% ناصر دین هدی و قاهر کفر و وثن(@)(@@) 11 کهترانت را سزد گر مهتری دعوی کنند %~% ای امیر نام گستر وی سوار نیزه زن(@)(@@) 12 هیچ کس را در جهان این مایه مردی نبود %~% کو به میدان خطر سازد برای دین وطن(@)(@@) 13 راه دین بودست مخوف از ابتدا لیکن به جهد %~% آن همه مخوف را موقوف کردی در زمن(@)(@@) 14 از برای نصرت دین ساختی هر روز و شب %~% طبل و منجوق و عراده نیزه و خود و مجن(@)(@@) 15 پای این مردان نداری جامه ایشان مپوش %~% برگ بی‌برگی نداری لاف درویشی مزن(@)(@@) 16 روز حرب از هیبت تیغت بلرزیدی زمین %~% همچنان کز بیم خصمی تند مردی ممتحن(@)(@@) 17 ذوالفقارت گر بدیدی کرگدن در روز جنگ %~% کاه گشتی 
ms432	 در زمان گر کوه بودی کرگدن(@)(@@) 18 سرکشان را سر بسر نابود کردی در جهان %~% تختهاشان تخته کردی حله‌هاشان را کفن(@)(@@) 19 این جلال و این کمال و این جمال و منزلت %~% نیست کس را در جهان جز مر ترا ای بوالحسن(@)(@@) 20 هر دلی کو مهرت اندر دل ندارد همچو جان %~% هر دلی کو عشقت اندر جان ندارد مقترن(@)(@@) 21 روی جنات العلی هرگز نبیند بی خلاف %~% لایزالی ماند اندر نار با گرم و حزن(@)(@@) 22 گر نبودی روی و مویت هم نبودی روز و شب %~% گر نبودی رنگ و بویت گل نبودی در چمن(@)(@@) 23 چون تو صاحب دولتی هرگز نبودی در جهان %~% هم نخواهد بود هرگز چون تویی در هیچ فن PageV1P0564(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 الا یا خیمه گردان به گرد بیستون مسکن %~% گه از بن دامنت ماهست و گاهت ماه بر دامن(@)(@@) 2 چراغ افروخته در تو بسی و هفت از آن گردان %~% که گه بر گاوشان جایست و گه بر شیرشان مسکن(@)(@@) 3 چو خورشید ملک هنجار و برجیس وزیر آسا %~% چو بهرام سپهسالار و چون ناهید بربط زن(@)(@@) 4 چو کیوان قوی تاثیر دهقان طبع بر گردون %~% چو تیر و ماه دیوان ساز پیک‌انگیز در برزن(@)(@@) 5 همه دانای نادان سر همه تابان تاری دل %~% همه والای دون پرور همه زن خوی مردافگن(@)(@@) 6 سر دانا شده پست و دل عاقل شده تاری %~% ازین افروخته رویان بر آن افراخته گرزن(@)(@@) 7 حکیمان را به نور و سیر بر گردون به روز و شب %~% گهی رهبر چو یزدانند و گه رهزن چو اهریمن(@)(@@) 8 کمان کردار گردونی ازو تیر بلا پران %~% دل عاقل ز زخمش خون زنار تیز نرم آهن(@)(@@) 9 هدفشان گر پذیرفتی نشان زان تیرها بر دل %~% دل دانا شدستی چون مشبکهای پرویزن(@)(@@) 10 ندای گوش هر عاقل ازو هر لحظه «لا بشری» %~% نثار سمع هر احمق ازو هر روز «لا تحزن»(@)(@@) 11 ز 
ms433	 نحسش منزوی مانده دو صد دانا به یک منزل %~% ز سعدش مقتدا گشته هزار ابله به یک برزن(@)(@@) 12 خسیسان را ازو رفعت رییسان را ازو پستی %~% لئیمان را ازو شادی حکیمان را ازو شیون(@)(@@) 13 امامان را ازو گر رشته تابی نیکویی بودی %~% علی خیاط راز و دل نبودی چون دل سوزن(@)(@@) 14 امام صنعت تازی علی‌ابن حسن بحری %~% که شد رایش ز چرخ اعلا و رویش ز آفتاب احسن(@)(@@) 15 امام عالم کافی که چون او درگه صنعت %~% نه از شام آمد و بصره نه از مرو آمد و زوزن(@)(@@) 16 ازو نحو و لغت زنده به هر وقتی چو جسم از جان %~% بدو فضل و ادب قایم به هر حالی چو جان از تن(@)(@@) 17 قریحتهای تازی را ز فضلش هر زمان انجم %~% طبیعتهای روشن را ز فضلش هر زمان گلشن(@)(@@) 18 هزارش دیده از عقل و به هر دیده هزاران دل %~% هزارش صنعت از فضل و به هر صنعت هزاران فن(@)(@@) 19 نماید پیش قدر او ز بالا گنبد و اختر %~% چو در باد هوا ذره چو در آب روان ارزن(@)(@@) 20 دل حاسد کشد هزمان چو لفظ تیغ هنجارش %~% هزاران خون دل دارد پس او هر لحظه در گردن(@)(@@) 21 ثبات زایش معنی به تو کامل چو جان از خون %~% کمال دانش مردان به تو ناقص چو عقل از زن(@)(@@) 22 تنت چون خاک در باد و زبان چون آب در آبان %~% دلت چون باغ در آذر کفت چون ابر در بهمن(@)(@@) 23 به هر طبع اندر آوردی به تعلیم اصل و فضل و دین %~% ز هر خاطر برون بردی به حجت شک و ریب و ظن(@)(@@) 24 نه پیوندد به علمت جهل یک جزو از هزار اجزا %~% ازیرا کل دانش را نگردد جهل پیرامن(@)(@@) 25 تواضع دوستر داری چو گوهر در بن دریا %~% و گرنه چرخ بایستی چو کیوان مر ترا معدن(@)(@@) 26 امام 
ms434	 دانش و معنی تویی امروز هم هستند %~% امامان دگر لیکن به دستار و به پیراهن(@)(@@) 27 بجز تو اهل صنعت را ز دعویهای بی‌معنی %~% همه بانگند چون طبل و همه رنگند چون روین(@)(@@) 28 یگانه عالمی بالله چگویم بیش از این زیرا %~% همان آبست اگر کوبی هزاران بار در هاون(@)(@@) 29 شگفتی نبود از خلقان ترا دشمن بوند ایرا %~% تو دانایی و ضد ضد را به گوهر چیست جز دشمن(@)(@@) 30 خدای از بد نگهدارست ازو زنهار «لاتیاس» %~% زمانه فاضل او بارست ازو هیهات «لاتامن»(@)(@@) 31 درین دوران نیارد سنگ نحو و منطق و آداب %~% ازیرا سغبه ژاژند و بسته رستم و بهمن(@)(@@) 32 ازین بی رونقی عالم چه نیکوتر بزرگان را %~% ز جامه بی‌تنه و تیریز و خانه بی در و روزن(@)(@@) 33 زمان شوخ چشمانست و بی اصلان اگر داری %~% ازین یک مایه بسم‌الله خود اندر گرد حرص افگن(@)(@@) 34 اگر رفعت همی جویی سیه دل باش چون لاله %~% ور آزادی همی خواهی زبان ده دار چون سوسن(@)(@@) 35 چو مرد این چنین میدان نه ای از همت عالی %~% به دست عقل و خرسندی دو پای حرص را بشکن(@)(@@) 36 تو نام الفنج در حکمت فلک را گو مده یک نان %~% تو روح افزای در دانش عدو را گو برو جان کن(@)(@@) 37 به باغ دل ز آب روی تخمی کشتی از حکمت %~% که جز فضل و ادب نبود بر آن یک روز پاداشن(@)(@@) 38 هزاران روشنی بینی ازین یک ظلمت گیتی %~% که از روز درازست این شب کوتاه آبستن(@)(@@) 39 الا تا در سمر گویند وصف بیژن و رستم %~% که این بودست پیل اندام و آن بودست شیراوژن(@)(@@) 40 ز سعی و حشمتت بادا به شادی و به اندوهان %~% ولی بر گاه چون رستم عدو در چاه چون بیژن(@)(@@) 41 همی تا نفی باشد «لا» همی تا جحد باشد «لم» %~% همی تا چیست باشد «ما» همی تا 
ms435	 کیست باشد «من»(@)(@@) 42 همیشه باد حاسد را بدان حاجت که او خواهد %~% جواب دعوتش ز ایزد چو موسل را ز لا و لن(@)(@@) 43 همیشه بی زبان بادت ز تیر حادثه هستی %~% که از عون ملک داری به گرد جان و تن جوشن PageV1P0565(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 پیش پریشان مکن از پی آشوب من %~% زلف گره بر گره جعد شکن بر شکن(@)(@@) 2 ای ز رخت برده نور فر کلاه سپهر %~% وی ز لبت برده آب رنگ عقیق یمن(@)(@@) 3 از لب تو شرم داشت مایه مل در قدح %~% وز رخ تو بوی برد دایه گل در چمن(@)(@@) 4 جادوی استاد را پیش دو بادام تو %~% بسته شود پسته‌وار تیغ زبان در دهن(@)(@@) 5 گردون هم عاشقست بر تو که هر صبحدم %~% در هوس روی تو پاره کند پیرهن(@)(@@) 6 چون به دهانت رسید هیچ نبیند خرد %~% چون به میانت رسید بیش نماند سخن(@)(@@) 7 در چمن روی تو غلتان غلتان رود %~% مردمک چشم من بر گل و بر یاسمن(@)(@@) 8 ای ز لطف لعل تو چشمه حیوان جان %~% وی به شرف کوی تو روضه رضوان تن(@)(@@) 9 ار چه نیارد برون همچو سنایی دگر %~% گردش این هفت مرد جنبش این چار زن(@)(@@) 10 تا نشود چشم زخم خیز بگردان یکی %~% جان چو ما صدهزار گرد سر خویشتن(@)(@@) 11 زان پس بر یاد او پرده عشاق ساز %~% تن تننا تن تنن تن تننا تن تنن(@)(@@) 12 ای که ز بس نازکی از تف روزه ترا %~% خشک شده سرو بن زرد شده نسترن(@)(@@) 13 عیدی خواهی ز ما بیش زیادی مخواه %~% هیچ نباید ترا از من و مانند من(@)(@@) 14 امشب وقت سحر پیش سپهر هنر %~% شعر سنایی بخوان زار نوایی بزن(@)(@@) 15 عمده دیوان شاه نصرالله آنکه هست %~% وقت هنر مقتدی گاه سخن موتمن(@)(@@) 16 با دم خلقش مجو مشک سیه از خطا %~% با سر کلکش مخواه در سپید از 
ms436	 عدن(@)(@@) 17 در شب میلاد او دایه دولت چه گفت %~% آمد بانگ خروس «اذهب عنا الحزن»(@)(@@) 18 پیش تک عزم او تنگ نماید زمین %~% پیش سر کلک او لنگ نماید زمن(@)(@@) 19 حاسدش اندر رحم عمر بخورده چو شمع %~% پوست نبیند به جسم تا بنپوشد کفن(@)(@@) 20 صبح زمانه فروز از پی بدخواه اوست %~% هم به زبان تلخ گوی هم به نفس تیغ زن(@)(@@) 21 در طلب آبرو سوی درش خلق را %~% پای ستون سرست چشم دلیل بدن(@)(@@) 22 آتش کلکش بدیل حل شده بیرون گریخت %~% سوی تکاب مسام خون دل نارون(@)(@@) 23 دشمنش ار مرغ‌وار سوی هوا بر پرد %~% چرخ تنوری شود محور چون باب زن(@)(@@) 24 ای به سخا دست تو ابر سعادت فشان %~% وی به هنر کلک تو برق ستاره فگن(@)(@@) 25 گر چه به گاه سخن در بچکانم همی %~% سود ندارد که من عرش بسنجم به من(@)(@@) 26 هفت فلک را به طبع خاصه بر اهل هنر %~% رسم گرفته زدن خوی دغا باختن(@)(@@) 27 نوبت آدم گذشت نوبت مرغان رسید %~% ورنه چه واجب کند این که به هر انجمن(@)(@@) 28 زاغ فروشد ادب لک لک گوید اصول %~% چنگ سراید کلنگ سیم رباید زغن PageV1P0566(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر شراب دوست را در دست تو نبود ثمن %~% خویشت را در خرابات جوانمردی فگن(@)(@@) 2 کان خراباتیست پر سلوی و من بی قیاس %~% تا سلو یابی ز سلوی منتی یابی ز من(@)(@@) 3 جوی می‌بینی روان در باغهای دلبران %~% عاشقان بینی چمان با جام می اندر چمن(@)(@@) 4 های های و هوی و هوی عاشقان و دلبران %~% هر یکی در امتحان دلفریبی ممتحن(@)(@@) 5 تا شراب عاشقان نوشی ز دست نیکوان %~% تا زمانی خویشتن بینی جدا از خویشتن(@)(@@) 6 سوخته بینی دلی در بیم هجران ساخته %~% همچو جان عاشقان در دام زلف پرشکن(@)(@@) 7 ایستاده زان یکی بر پای چون شمعی برنگ %~% و آن دیگر دست کرده بر سر 
ms437	 زانو لگن(@)(@@) 8 آن یکی از خواجگی پیراهن اندر پاکشان %~% و آن دیگر برکشیده بر سر از تن پیرهن(@)(@@) 9 شاهد حال یکی حالی و آن دیگری %~% آتش بی دود غیرت گشته پیش باب زن(@)(@@) 10 خاک کوی دوست بر سر کرده مهجوری ز درد %~% دیگری فتنه شده بر ربع و اطلال و دمن(@)(@@) 11 مطربان در من یزید افگنده نعمتهای خویش %~% ماه‌رویان پیش ایشان پای کوب و دست زن(@)(@@) 12 این جهان با تن مساعد آن جهان با روح یار %~% مژده داده مر روانها را ز لذتها بدن(@)(@@) 13 خیل مستان بر بساط نردبازان گشته جمع %~% کعبتین گردان و نظاره بمانده مرد و زن(@)(@@) 14 یا کدام از ما بماند یا کدام از ما برد %~% یا به نام که برآید نعره‌ای زان انجمن(@)(@@) 15 دل به دست دوست همچون یوسف اندر من یزید %~% برده او را بی‌گنه افگنده در چاه ذقن(@)(@@) 16 گر قیامت را به صورت دید خواهی شو ببین %~% حشر و نشر و دفع و منع و گیر و دار و عفو و من(@)(@@) 17 عاشقی دعوی کنی انصاف معشوقت بده %~% ناجوانمردی کنی لاف جوانمردی مزن(@)(@@) 18 مرده هجرم حیات من به وصل روی تست %~% گور من در کوی خود کن دلق خود سازم کفن(@)(@@) 19 زنده گرداند وصال روی تو جسم مرا %~% راست هم چونان که عالم را جمال بوالحسن(@)(@@) 20 آن علی کز حسن و احسان دهر او را برگزید %~% تا مقام خویش را در خورد خود سازد وطن(@)(@@) 21 از علو قدر و عدل او زمانه بشکفد %~% چون ببیند بر سر نامه علی ابن حسین(@)(@@) 22 هر علی را کو اضافت منزلت پیدا کند %~% ننگرند اندر اضافت زیرکان با فطن(@)(@@) 23 یا اضافت را بدو عزست یا او را بدو %~% گرچه راهن را نباشد انفعال مرتهن(@)(@@) 24 این حسن را زین اضافت منزلت نفزود و قدر %~% کاین نسب را کرده‌ام با من جمالش مقترن 
