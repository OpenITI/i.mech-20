ms701	 أبي هريرة، روى عنه: ابنه محمد بن عمار.(@)(@@)(@@)(@@) ||| AUTO عمار بن أبي عمار(@)(@@) مولى بني هاشم، كنيته أبو محمد، وقد PageV01P002 [ج 2: ص 416] قيل: أبو عبد الله، عداده في أهل مكة، يروي عن: أبي هريرة، وأبي قتادة، وكان يخطئ، روى عنه: يونس بن عبيد، وشعبة، وحماد بن سلمة، مات في ولاية خالد بن عبد الله القسري على العراق.(@)(@@)(@@)(@@) ||| AUTO عمار الغفاري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عبد الله بن صفوان.(@)(@@)(@@)(@@) ||| AUTO عمار المزني(@)(@@) يروي عن: أنس بن مالك، روى عنه: حميد الطويل.(@)(@@)(@@)(@@) ||| AUTO عمار بن معاوية الدهني البجلي(@)(@@) ودهن قبيلة من بجيلة، عداده في أهل الكوفة، كنيته أبو معاوية، وكنية أبيه: أبو معاوية، وهو الذي يقال له: عمار بن أبي معاوية، يروي عن: أبي الطفيل، ربما أخطأ، وكان راويا لسعيد بن جبير، روى عنه: السفيانان.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن سعيد بن العاص الأموي القرشي(@)(@@) أخو يحيى، وعمرو، كنيته أبو خالد، يروي عن: أبي هريرة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن أبي سفيان بن أمية بن عبد شمس القرشي(@)(@@) أخو أم حبيبة بنت أبي سفيان، كنيته أبو عثمان، يروي عن: أم حبيبة، روى عنه: مكحول، وعمرو بن أوس، وقد قيل: إن كنيته أبو الوليد.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن عمار الدوسي القرشي(@)(@@) من أهل المدينة، قدم الكوفة، فحدثهم بها، يروي عن: ابن عمر، روى عنه: مروان بن معاوية، والكوفيون.(@)(@@)(@@)(@@) ||| AUTO عنبسة أبو رافع(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبد الصمد بن عبد الوارث.(@)PageV01P002(@)(@@) [ج 2: ص 417](@)(@@)(@@)(@@) ||| AUTO عنبسة بن أبي عمرو(@)(@@) يروي عن: أنس بن مالك، روى عنه: أيمن بن نابل.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن حكيم الفزاري(@)(@@) يروي عن: علي، روى عنه: علي بن ربيعة الوالبي.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عدي بن أبي بن كعب(@)(@@) يروي عن: أبيه، روى عنه: أهل المدينة، كنيته أبو معاذ.(@)(@@)(@@)(@@) ||| AUTO عدي بن ثابت الأنصاري(@)(@@) عداده في أهل الكوفة، يروي عن: البراء بن عازب، وأبي أمه: عبد الله بن يزيد، الذي روى عنه: يحيى بن سعيد الأنصاري، روى عنه: أهل 
ms702	 الكوفة، مات في ولاية خالد على العراق.(@)(@@)(@@)(@@) ||| AUTO عدي بن أبي عدي الكندي(@)(@@) واسم أبي عدي فروة، يروي عن: أبيه، ويقال: إن له صحبة، روى عنه: عيسى بن عاصم، مات سنة ست وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO عدي بن أبي عدي بن جبلة بن عدي بن ربيعة(@)(@@) من أهل الكوفة، يروي عن: جماعة من الصحابة، روى عنه: الكوفيون.(@)(@@)(@@)(@@) ||| AUTO عدي بن دينار القرشي(@)(@@) مولى أم قيس بنت محصن، يروي عن: أم قيس، روى الثوري، عن ثابت بن هرمز أبي المقدام، عنه.(@)(@@) عدي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ابنه غيلان بن عدي.(@)(@@)(@@)(@@) ||| AUTO عدي بن عدي الكندي(@)(@@) من أهل الجزيرة، يروي عن: أبي الدرداء PageV01P002 [ج 2: ص 418] وجماعة من الصحابة، روى عنه: عمرو بن قيس السكوني، وأهل بلده، مات سنة عشرين ومائة، وليس هذا بالأول.(@)(@@)(@@)(@@) ||| AUTO عدي بن أرطأة الفزاري(@)(@@) أخو زيد بن أرطأة، يروي المراسيل، روى عنه: بكر بن عبد الله المزني، وعدي بن قبيصة.(@)(@@)(@@)(@@) ||| AUTO عياش بن أبي مسلم(@)(@@) يروي عن: ابن عمر، روى عنه: محمد بن موسى المدني.(@)(@@)(@@)(@@) ||| AUTO عياش بن عبد الله الجشمي(@)(@@) يروي عن: عثمان بن عفان، وأبي هريرة، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO عياش العامري(@)(@@) يروي عن: ابن أبي أوفى، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO عياش بن مؤنس(@)(@@) يروي عن: نمران بن محمد بن شرحبيل بن أوس، ويقال: إن له صحبة، وما أرى بمحفوظ، روى عنه: محمد بن الوليد الزبيدي.(@)(@@)(@@)(@@) ||| AUTO عياش بن عقبة(@)(@@) عم ابن لهيعة، يروي(@)(@@) (204) -[2: 418] عن ابن مسعود، أنه قال: " أول ما تنظرون الدجال فبئس الغائب المنتظر، أم الساعة فالساعة أدهى وأمر ". ثنا عمر بن محمد بن الهمداني، قال: ثنا محمد بن أشكاب، قال: ثنا محمد بن عبيدة بن معن، قال: ثنا أبي، عن الأعمش، عن زيد بن حباب، عن عياش بن عقبة، قال: قال: عبد الله فذكره(@)(@@)(@@)(@@) ||| AUTO عقيل بن جابر بن عبد الله الأنصاري السلمي(@)(@@) من أهل المدينة، يروي عن: أبيه، روى عنه: صدقة بن يسار.(@)PageV01P002(@)(@@) [ج 2: ص 419](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عقيل بن المغيرة 
ms703	(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الملك بن عمير.(@)(@@) عقيل(@)(@@) مولى ابن عباس، يروي عن: أبي موسى الأشعري، روى عنه: سليمان بن يسار.(@)(@@)(@@)(@@) ||| AUTO عقيل بن سمير(@)(@@) ويقال: ابن شمير، يروي عن: ابن عمر، روى عنه: ابنه عبد الله بن عقيل.(@)(@@)(@@)(@@) ||| AUTO عقيل بن شبيب(@)(@@) يروي عن: أبي وهب الجيشاني، وله صحبة، روى عنه: محمد بن المهاجر.(@)(@@)(@@)(@@) ||| AUTO عقيل بن طلحة السلمي(@)(@@) يروي عن: أبي جري الهجيمي وله صحبة، روى عنه: سلام بن مسكين.(@)(@@)(@@)(@@) ||| AUTO عقيل بن حنظلة المحاربي(@)(@@) يروي عن: ابن عمر، روى عنه: ابنه مسلم بن عقيل.(@)(@@)(@@)(@@) ||| AUTO عقيل بن عبد الرحمن الخولاني(@)(@@) يروي عن: علي بن أبي طالب، وكان على قضاء الموصل، وكانت عمته امرأة عقيل بن أبي طالب، روى عنه: أبو إسحاق السبيعي، وأبو السفر.(@)(@@)(@@)(@@) ||| AUTO عقيل بن دينار(@)(@@) مولى جارية، يروي عن: جارية بن ظفر، وله صحبة، روى عنه: دهثم بن قران.(@)(@@)(@@)(@@) ||| AUTO عرفجة بن عبد الله الثقفي(@)(@@) من أهل الكوفة، يروي عن: علي بن أبي طالب، وعبد الله بن مسعود، وعائشة، وهو الذي روى عنه: عطاء بن أبي رباح، فقال: عرفجة بن عبد PageV01P002 [ج 2: ص 420] الواحد، وهو الذي(@)(@@) (205) -[2: 420] روى مروان بن معاوية، عن عمر بن عبد الله الثقفي، عن عرفجة بن عبد الله الثقفي، قال: كان علي بن أبي طالب " يأمر الناس بقيام رمضان، يجعل للرجال إماما وللنساء إماما "، قال عرفجة: فأمرني علي، فكنت إمام النساء(@)(@@)(@@)(@@) ||| AUTO عرفجة السلمي(@)(@@) من أهل الكوفة، يروي عن: أبي بكر الصديق إن كان سمع منه، روى عنه: أبو عون الثقفي.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عتاب بن حنين المكي(@)(@@) ويقال: عباد بن حنين، يروي عن: أبي سعيد الخدري، روى عنه: عمرو بن دينار.(@)(@@) عتاب(@)(@@) مولى بني هرمز، من أهل البصرة، وهو عتاب بن هرمز، يروي عن: أنس بن مالك، روى عنه: شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عتاب البكري(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عبد الله بن ميسرة.(@)(@@)(@@)(@@) ||| AUTO عتاب بن زيد بن أرقم(@)(@@) شيخ كوفي، يروي عن: أبيه زيد 
ms704	 بن أرقم، روى عنه: فراس.(@)(@@)(@@)(@@) ||| AUTO عوف بن مالك بن نضلة الجشمي أبو الأحوص(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي، وعطاء بن السائب قتلته الخوارج في أيام الحجاج بن يوسف.(@)(@@)(@@)(@@) ||| AUTO عوف بن الحارث بن الطفيل بن سخبرة بن جرثومة الأزدي(@)(@@) من النمر بن عثمان، والطفيل بن سخبرة أخو عائشة لأمها من الرضاعة، يروي عوف، عن عائشة، وابن الزبير، وأبي هريرة، روى عنه: الزهري، وبكير بن الأشج.(@)PageV01P002(@)(@@) [ج 2: ص 421](@)(@@)(@@)(@@) ||| AUTO عوف بن حصيرة الشامي(@)(@@) يروي عن: أبي أمامة، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO عوف بن أبي حدرد(@)(@@) يروي عن: السائب بن يزيد وله صحبة، روى عنه: سعيد بن أبي هلال، وابن عجلان.(@)(@@)(@@)(@@) ||| AUTO عوف بن مالك الجابري(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: أبو الضحاك يحيى بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عوف البكالي(@)(@@) يروي عن: عمر البكالي، روى عنه: يحيى بن أبي عمرو السيباني.(@)(@@)(@@)(@@) ||| AUTO عائذ بن نصيب الأسدي الكاهلي(@)(@@) يروي عن: ابن عمر، روى عنه: شعبة، وابنه مسلم بن عائذ.(@)(@@)(@@)(@@) ||| AUTO عائذ أبو معاذ(@)(@@) يروي المراسيل، روى عنه: إسماعيل بن مسلم العبدي.(@)(@@)(@@)(@@) ||| AUTO عائذ بن أبي ضب الكعبي الحبتري(@)(@@) يروي عن: أبي هريرة، روى عنه: أبو رشدين.(@)(@@)(@@)(@@) ||| AUTO عائذ الجعفي(@)(@@) يروي المراسيل، روى عنه: الجعد بن الصلت.(@)(@@)(@@)(@@) ||| AUTO أبو إدريس الخولاني اسمه عائذ الله بن عبد الله(@)(@@) ولد عام حنين، عداده في أهل الشام، يروي عن: شداد بن أوس، وابن مسعود، والمغيرة بن شعبة، ولم يسمع من معاذ بن جبل شيئا، روى عنه: الزهري، وأهل الشام، ولاه عبد الملك بن مروان القضاء بدمشق، وعزل بلال بن أبي الدرداء، وكان أبو إدريس من عباد أهل الشام وقرائهم، مات سنة ثمانين، وإليه كانت أمور دمشق.(@)PageV01P002(@)(@@) [ج 2: ص 422](@)(@@)(@@)(@@) ||| AUTO عائذ الله المجاشعي، قاص عبد الملك بن مروان(@)(@@) يروي المراسيل، روى عنه: سلام بن مسكين، وليس هو بأبي إدريس الخولاني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عجلان(@)(@@) مولى فاطمة بنت عتبة بن ربيعة القرشي، والد ابن عجلان، يروي عن: أبي 
ms705	 هريرة، عداده في أهل المدينة، روى عنه: بكير بن الأشج وابنه محمد بن عجلان.(@)(@@) عجلان(@)(@@) مولى المشمعل، كنيته أبو محمد، يروي عن: أبي هريرة، روى عنه: ابن أبي ذئب، ليس هذا بوالد محمد بن عجلان.(@)(@@) عجلان(@)(@@) مولى لآل يزيد بن الهاد، يروي عن: أبي هريرة، روى عنه: يزيد بن الهاد.(@)(@@)(@@)(@@) ||| AUTO عجلان أبو غالب(@)(@@) يروي عن: ابن عباس، روى عنه: محمد بن الفضل بن عطية الخراساني.(@)(@@)(@@)(@@) ||| AUTO عجلان بن سهل الباهلي(@)(@@) يروي عن: أبي أمامة، روى عنه: سليمان بن موسى.(@)(@@)(@@)(@@) ||| AUTO عجلان بن سمعان(@)(@@) يروي عن: أبي هريرة، روى عنه: أبو سفيان: طلحة بن نافع، وصالح بن صالح.(@)(@@)(@@)(@@) ||| AUTO عجلان بن سالم(@)(@@) يروي عن: أبي قرصافة، واسم أبي قرصافة: جندرة بن خيشنة، روى عنه: زياد بن الجعد.(@)(@@) عجلان(@)(@@) مولى ثقيف، من أهل البصرة، يروي عن: أبي بكرة، وسمرة، روى عنه: يحيى بن مروان.(@)PageV01P002(@)(@@) [ج 2: ص 423](@)(@@)(@@)(@@) ||| AUTO عزرة بن الحارث الشيباني(@)(@@) يروي عن: البراء بن عازب، روى عنه: العوام بن حوشب بن قحطبة.(@)(@@) (206) -[2: 423] قال: ثنا بشر بن معاذ، قال: ثنا هشيم، قال: ثنا العوام بن حوشب، عن عزرة بن الحارث الشيباني، عن البراء بن عازب، قال: " كنا إذا صلينا خلف رسول الله صلى الله عليه وسلم فرفعنا رءوسنا من الركوع، فقمنا صفوفا حتى يسجد رسول الله صلى الله عليه وسلم فنتبعه "(@)(@@)(@@)(@@) ||| AUTO عزرة بن قيس البجلي(@)(@@) يروي عن: خالد بن الوليد، روى عنه: أبو وائل: شقيق بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عزرة بن تميم(@)(@@) يروي عن: أبي هريرة، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO عميرة بن سعد(@)(@@) أبو السكن اليامي الهمداني، من أهل الكوفة، يروي عن: علي بن أبي طالب، روى عنه: طلحة بن مصرف.(@)(@@)(@@)(@@) ||| AUTO عميرة بن زياد(@)(@@) يروي عن: عبد الله بن مسعود، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عميرة بن يثربي الضبي(@)(@@) قاضي البصرة، يروي عن: أبي بن كعب، روى عنه: أنس ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO عفان بن سعيد(@)(@@) يروي عن: ابن الزبير، روى عنه: مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عفان الأزدي(@)(@@) شيخ، يروي 
ms706	 عن: ابن عمر، يروي عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO علباء بن أحمر اليشكري(@)(@@) سكن مرو، أصله من البصرة، يروي عن: أبي زيد الأنصاري، وهو جده، واسم أبي زيد: عمرو بن أخطب، روى عنه: داود بن أبي الفرات، وحسين بن واقد.(@)PageV01P002(@)(@@) [ج 2: ص 424](@)(@@)(@@)(@@) ||| AUTO علباء(@)(@@) شيخ، يروي عن: علي بن أبي طالب، روى عنه: عمرو بن غزى البكري.(@)(@@)(@@)(@@) ||| AUTO عباية بن رفاعة بن رافع بن خديج الأنصاري الحارثي(@)(@@) يروي عن: جده رافع بن خديج، وابن عمر، روى عنه: سعيد بن مسروق، وأبو حيان التيمي، كنيته أبو رفاعة، وهو الذي روى عن: أبي عبس بن جبر، من حديث يزيد بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO عباية بن رداد التيمي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: سلمة بن كهيل، ومحمد بن المنتشر.(@)(@@)(@@)(@@) ||| AUTO عباية بن ربعي الأسدي(@)(@@) رأى جماعة من الصحابة، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عراك بن مالك الغفاري(@)(@@) يروي عن: أبي هريرة، عداده في أهل المدينة، روى عنه: الزهري، وابنه خثيم بن غراك، مات في ولاية يزيد بن عبد الملك، وهو الذي يروي عن: الزهري، عن حميد، عن أبي هريرة قصة المجامع، من حديث بكر بن مضر، عن جعفر بن ربيعة، عن عراك بن مالك.(@)(@@)(@@)(@@) ||| AUTO عوسجة الهاشمي(@)(@@) يروي عن: ابن عباس، روى عنه: عمرو بن دينار، وأحسبه عوسجة بن الرماح.(@)(@@) (207) -[2: 424] ثنا مكحول، قال: ثنا ابن المقري، قال: ثنا سفيان، عن عمرو بن دينار، عن عوسجة، عن ابن عباس، قال: " مات رجل على عهد النبي صلى الله عليه وسلم ولم يترك أحدا إلا عبدا هو أعتقه، فأعطاه النبي صلى الله عليه وسلم المال، وقال: من ميراثه "(@)(@@)(@@)(@@) ||| AUTO عتبان بن عمرو بن إياس(@)(@@) يروي عن: السائب بن يزيد، روى عنه: الضحاك بن عثمان.(@)PageV01P002(@)(@@) [ج 2: ص 425](@)(@@)(@@)(@@) ||| AUTO عنترة(@)(@@) والد هارون بن عنترة، كنيته أبو وكيع، شهد علي بن أبي طالب رضى الله عنه، روى عنه: أبو سنان، وابنه هارون، وهارون، الله المستعان على إثباته.(@)(@@)(@@)(@@) ||| AUTO عريف بن سريع(@)(@@) يروي عن: عبد الله بن عمر، روى عنه: 
ms707	 توبة بن نمر.(@)(@@)(@@)(@@) ||| AUTO عصام بن بشير(@)(@@) أحد بني الحارث بن كعب، من أهل الجزيرة، يروي عن: أنس بن مالك، روى عنه: سعيد بن مروان، مات وقد جاوز على مائة وعشر سنين.(@)(@@)(@@)(@@) ||| AUTO عويمر بن عبد الله السلمي(@)(@@) شيخ، يروي عن: أبي أيوب الأنصاري، روى عنه: محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO العيزار بن حريث العبدي(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، روى عنه: ابنه الوليد، مات في ولاية خالد على العراق.(@)(@@)(@@)(@@) ||| AUTO أبو هنيدة المازني اسمه عريب بن مالك(@)(@@) أدرك أنس بن مالك، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عريب بن حميد بن عمار الهمداني(@)(@@) من أهل الكوفة، يروي المراسيل، روى عنه: أبو إسحاق السبيعي، والقاسم بن مخيمرة، كنيته أبو عمار الفائشي.(@)(@@)(@@)(@@) ||| AUTO عفيف بن معدي كرب(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: هارون بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عطارد(@)(@@) شيخ، يروي عن: ابن عمر، روى عنه: وهيب بن الورد، وجرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO عنبس بن عقبة الحضرمي(@)(@@) يروي عن: ابن مسعود، وكان من عباد أهل PageV01P002 [ج 2: ص 426] الكوفة، وكان إذا صلى تقع العصافير على ظهره تحسبه جذم حائط، روى عنه: يزيد بن حيان، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عقال البجلي(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه عيسى بن عقال.(@)(@@)(@@)(@@) ||| AUTO عقال بن صعصعة بن ناجية بن مجاشع، المجاشعي(@)(@@) يروي عن: أبيه، سمع النبي صلى الله عليه وسلم يقول: " أمك، وأباك، وأختك، وأخاك، وأدناك، وأدناك ".(@)(@@)(@@)(@@) ||| AUTO عليبة بن حرملة العنبري التميمي(@)(@@) يروي عن: أبيه، روى عنه: ابنه ضرغامة بن عليبة.(@)(@@)(@@)(@@) ||| AUTO عيينة بن غصن(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: جرير بن عبد الحميد الضبي.(@)(@@)(@@)(@@) ||| AUTO عائش بن أنس البكري(@)(@@) يروي عن: علي، روى عنه: عطاء بن أبي رباح.(@)(@@)(@@)(@@) ||| AUTO عابس بن ربيعة النخعي(@)(@@) يروي عن: علي بن أبي طالب، وعمر بن الخطاب، روى عنه: إبراهيم النخعي، وابنه عبد الرحمن بن عابس.(@)(@@)(@@)(@@) ||| AUTO عدسة الطائي(@)(@@) يروي عن: ابن مسعود، روى عنه: سلمة بن كهيل.(@)(@@)(@@)(@@) ||| AUTO عتريس بن عرقوب 
ms708	 الشيباني(@)(@@) يروي عن: ابن مسعود، عداده في أهل الكوفة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عصبة بن سعد البلوي(@)(@@) يروي عن: الحسن، والحسين، روى عنه: عبدة بن أبي قيس.(@)PageV01P002(@)(@@) [ج 2: ص 427](@)(@@)(@@)(@@) ||| AUTO عبدة بن أبي المضرب(@)(@@) قال: كنا جلوسا عند أنس بن مالك في رمضان، فلما أمسينا قام مؤذنه فأذن بصلاة المغرب وجاء خبازه بالعشاء، فقال: " اقعدوا حتى نفطر فإنها سنة ". روى عنه: محمد بن هلال من حديث ابن يونس الإسكندراني.(@)(@@)(@@)(@@) ||| AUTO عليم(@)(@@) شيخ، يروي عن: سلمان الفارسي، روى عنه: زاذان.(@)(@@)(@@)(@@) ||| AUTO عتي بن ضمرة السعدي(@)(@@) يروي عن: أبي بن كعب، روى عنه: الحسن.(@)(@@)(@@)(@@) ||| AUTO عتيك بن الحارث بن عتيك بن قيس بن هيشة المعاوي الأوسي الأنصاري(@)(@@) من أهل المدينة، يروي عن: جابر بن عتيك، وجماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: عبد الله بن عبد الله بن جابر بن عتيك، والناس، وهو جد عبد الله بن عبد الله بن جابر بن عتيك.(@)(@@)(@@)(@@) ||| AUTO علاقة بن عبد الله بن زيد بن مربع(@)(@@) من بني حارثة الأنصاري، عداده في أهل المدينة، يروي عن: سهل بن سعد الساعدي، روى عنه: كثير بن جعفر.(@)(@@)(@@)(@@) ||| AUTO عقيصا أبو سعيد التيمي(@)(@@) صاحب الكراش، من أهل الكوفة، يروي عن: علي بن أبي طالب وعمار، روى عنه: الأعمش، ومحمد بن جحادة، وقد قيل: إن اسم أبي سعيد عقيصا: دينار.(@)(@@)(@@)(@@) ||| AUTO عسعس بن سلامة أبو صفرة التميمي البصري(@)(@@) يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الأزرق بن قيس.(@)(@@)(@@)(@@) ||| AUTO عقار بن المغيرة بن شعبة الثقفي(@)(@@) يروي عن: أبيه، روى عنه: مجاهد، وحسان بن أبي وجزة.(@)PageV01P002(@)(@@) [ج 2: ص 428](@)(@@)(@@)(@@) ||| AUTO عتيق(@)(@@) والد عبد الرحمن بن عتيق، يروي عن: عائشة، روى عنه: ابنه عبد الرحمن بن عتيق، وقد قيل: ابن أبي عتيق والصحيح ابن عتيق.(@)(@@)(@@)(@@) ||| AUTO علاج(@)(@@) شيخ، يروي عن: ابن عمر، روى عنه: جامع بن شداد.(@)(@@)(@@)(@@) ||| AUTO العجاج بن رؤبة(@)(@@) يروي عن: أبي هريرة طاف الخيالان فهاجا سقما، روى عنه: ابنه: رؤبة 
ms709	 بن العجاج، وقد قيل: إن اسم العجاج عبد الله.(@)(@@)(@@)(@@) ||| AUTO عزوان بن عزوان الرقاشي(@)(@@) من أهل البصرة، لحق جماعة من الصحابة، روى عنه: البصريون، حلف أنه لا يضحك حتى يعلم أين منزلته، فلم يضحك حتى مات، ويقال أيضا: عزوان بن زيد الرقاشي، وذكر قصته.(@)(@@)(@@)(@@) ||| AUTO عكاظ التيمي(@)(@@) يروي عن: أنس بن مالك، روى عنه: هارون بن موسى. النساء:(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمرة بنت الشافع(@)(@@) تروي عن: أم سلمة، روى عنها: عمار الدهني.(@)(@@)(@@)(@@) ||| AUTO عمرة بنت عبد الرحمن بن سعد بن زرارة(@)(@@) تروي عن: عائشة، وكانت من أعلم الناس بحديثها، روى عنها: أهل المدينة، وأبو الرجال: محمد بن عبد الرحمن ابنها، ماتت سنة ثمان وتسعين.(@)(@@) عمرة(@)(@@) مولاة حمنة بنت شجاع، تروي عن: أم قيس بنت محصن، عن النبي صلى الله عليه وسلم قال: " استتروا من النار ولو بشق تمرة "، روى التبوذكي، قال: ثنا سعد أبو عاصم مولى بني هاشم، عن عمرة.(@)PageV01P002(@)(@@) [ج 2: ص 429](@)(@@)(@@)(@@) ||| AUTO عائشة بنت سعد بن أبي وقاص(@)(@@) تروي عن: أبيها، روى عنها: أهل المدينة، ماتت سنة سبع عشرة ومائة، وكانت من أجمل نساء أهل زمانها.(@)(@@)(@@)(@@) ||| AUTO عائشة بنت طلحة بن عبيد الله التيمي(@)(@@) تروي عن: عائشة، روى عنها: طلحة بن يحيى، وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عائشة بنت قدامة بن مظعون الجمحي(@)(@@) تروي عن: أبيها، روى عنها: قدامة بن إبراهيم بن محمد بن حاطب، وعمرو بن حسين.(@)(@@)(@@)(@@) ||| AUTO العالية بنت أيقع(@)(@@) والدة يونس بن أبي إسحاق، تروي عن: عائشة، روى عنها: ابنها يونس بن أبي إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO العالية أم عبد الله بن مالك بن حذافة(@)(@@) تروي عن: ميمونة زوجة رسول الله صلى الله عليه وسلم روى عنها: ابنها عبد الله بن مالك بن حذافة.(@)(@@)(@@)(@@) ||| AUTO عزة بنت أبي قرصافة واسمه: جندرة بن حبشية(@)(@@) تروي عن: أبيها، روى عنها: أهل فلسطين.(@)(@@)(@@)(@@) || AUTO باب الغين(@)(@@) قال أبو حاتم:(@)(@@)(@@)(@@) || AUTO ممن روى عن الصحابة وشافههم ممن ابتدأ اسمه على الغين:(@)(@@)(@@)(@@) ||| AUTO غالب الرياحي(@)(@@) بصري، يروي عن: ابن عمر، روى عنه: الجريري.(@)PageV01P002(@)(@@) [ج 2: ص 
ms710	 430](@)(@@)(@@)(@@) ||| AUTO غالب بن عجرد التيمي(@)(@@) يروي عن: ابن عمر، روى عنه: ثابت البناني، وعوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO غالب بن سويد الدمشقي(@)(@@) يروي عن: أبي هريرة، روى عنه: إسماعيل بن عبيد الله بن أبي المهاجر.(@)(@@)(@@)(@@) ||| AUTO غيلان بن معشر المقرإي(@)(@@) يروي عن: أبي أمامة، عداده في أهل الشام، روى عنه: معاوية بن صالح، ومن زعم أنه المقرئ فقد وهم، إنما هو المقرإي، ومقرا: قرية بدمشق.(@)(@@)(@@)(@@) ||| AUTO غيلان بن جرير العتكي المعولي الأزدي(@)(@@) من أهل البصرة، يروي عن: أنس بن مالك، وأبي بردة، روى عنه: مهدي بن ميمون، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO غيلان بن عبد الله(@)(@@) مولى قريش، يروي عن: ابن عمر، روى عنه: شعبة، وهشيم.(@)(@@)(@@)(@@) ||| AUTO غيلان بن غيلان الأنصاري(@)(@@) يروي عن: ابن عباس، روى عنه: شريك.(@)(@@)(@@)(@@) ||| AUTO غيلان بن عميرة(@)(@@) يروي عن: ابن عمر، روى عنه: أبو خالد البصري.(@)(@@)(@@)(@@) ||| AUTO غضيف بن الحارث(@)(@@) من أهل الشام، يروي عن: عائشة، روى عنه: عبادة بن نسي.(@)(@@) (208) -[2: 430] ثنا العباس بن الخليل الطائي بحمص، قال: ثنا نصر بن خزيمة بن علقمة بن محفوظ بن علقمة الحضرمي، قال: ثنا أبي، عن نصر بن علقمة، عن أخيه محفوظ بن علقمة، عن ابن عائذ، عن غضيف بن الحارث، عن أبي الدرداء، عن النبي صلى الله عليه وسلم قال: " قال داود النبي صلى الله عليه وسلم: السيئات PageV01P002 [ج 2: ص 431] غضة شوكها، وحسكها "(@)(@@)(@@)(@@) ||| AUTO غطيف بن عبد الله الشامي الهمداني(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: أهل الشام، مات في ولاية مروان بن الحكم.(@)(@@)(@@)(@@) ||| AUTO غطيف بن أبي سفيان الثقفي(@)(@@) يروي عن: ابن عمر، روى عنه: سعيد بن السائب، وغيره، مات سنة ثمان وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO غطيف أبو عبد الكريم(@)(@@) يروي عن: عبد الله بن عمرو، روى سعيد بن زيد، عن رجل من أهل الشام، عنه.(@)(@@)(@@)(@@) ||| AUTO غنام بن قيس(@)(@@) يروي عن: ابن عمر، روى عنه: عاصم بن سليمان الأحول.(@)(@@)(@@)(@@) ||| AUTO غزوان بن عتبة بن غزوان(@)(@@) من بني مازن بن منصور، حليف بني نوفل، وقد قيل: حليف 
ms711	 بني عبد مناف، يروي عن: أبيه، روى عنه: محمد بن الفضل.(@)(@@)(@@)(@@) ||| AUTO غزوان أبو مالك الغفاري(@)(@@) يروي عن: ابن عباس، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO غزوان أبو حاتم(@)(@@) يروي عن: أبي ذر، روى عنه: السري بن يحيى.(@)(@@)(@@)(@@) ||| AUTO غاضرة بن عروة الفقيمي(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: البصريون.(@)(@@) (209) -[2: 431] ثنا محمد بن الحسين بن مكرم بالبصرة، قال: ثنا عمرو بن علي، قال: ثنا عاصم بن هلال أبو النضر البارقي، قال: ثنا ابن عروة الفقيمي منذ ستون سنة، عن أبيه، قال: دخلت مسجد رسول الله، فدخل علينا رجل يقطر رأسه من وضوء توضأ به أو غسل اغتسل، فقام إليه PageV01P002 [ج 2: ص 432] الناس، فقالوا: يا رسول الله، أرأيت كذا يا رسول الله، أرأيت كذا، أرأيت كذا يا رسول الله، فقال رسول الله صلى الله عليه وسلم: " يا أيها الناس، إن دين الله يسر، أيها الناس إن دين الله يسر "(@)(@@)(@@)(@@) ||| AUTO غاضرة العنبري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عبد الله بن عون.(@)(@@)(@@)(@@) ||| AUTO غنيم بن قيس المازني أبو العنبر(@)(@@) يروي عن: أبي موسى الأشعري، وسعد بن أبي وقاص، وعن أبيه وله صحبة، روى عنه: ثابت بن عمارة، مات سنة تسعين.(@)(@@)(@@)(@@) ||| AUTO أبو غطفان(@)(@@) شيخ عن: ابن عباس، روى عنه: قارظ بن شيبة.(@)(@@)(@@)(@@) ||| AUTO غني بن أبي حازم الذهلي، ويقال: ابن أبي حاتم(@)(@@) يروي عن: ابن عمر، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO الغريف بن عياش(@)(@@) من أهل الشام، يروي عن: فيروز الديلمي، وله صحبة، روى عنه: إبراهيم بن أبي عبلة.(@)(@@)(@@)(@@) ||| AUTO الغاز بن ربيعة الجرشي(@)(@@) من أهل الشام، يروي عن: جماعة من الصحابة، روى عنه: ابنه هشام بن الغاز، وأهل الشام.(@)(@@)(@@)(@@) || AUTO باب الفاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن أصحاب النبي صلى الله عليه وسلم ممن ابتدأ اسمه على الفاء:(@)(@@)(@@)(@@) ||| AUTO فضيل بن زيد الرقاشي، كنيته أبو حسان(@)(@@) من أهل البصرة وقرائهم، يروي عن: عمر، روى عنه: عاصم الأحول، مات سنة خمس وتسعين.(@)(@@)(@@)(@@) ||| AUTO فضيل بن بزوان(@)(@@) من أهل 
ms712	 الكوفة، يروي عن: ابن مسعود، روى عنه: أبو رزين.(@)PageV01P002(@)(@@) [ج 2: ص 433](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO فضيل بن كثير(@)(@@) يروي عن: أنس، روى عنه: سيف بن هارون، وهشيم بن أبي ساسان.(@)(@@)(@@)(@@) ||| AUTO فضيل بن فضالة الهوزني(@)(@@) من أهل الشام، يروي المراسيل، روى عنه: صفوان بن عمرو، وأهل الشام.(@)(@@) فضيل(@)(@@) شيخ يروي عن: معاوية، روى عبيد الله بن أبي جعفر، عن صفوان بن سليم، عنه، إن لم يكن الهوزني فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عبيد الله بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: أبي رافع، روى عنه: عباس بن أبي خداش، وابنه العباس بن الفضل.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عمرو بن أمية الضميري(@)(@@) يروي عن: أبيه عمرو بن أمية، روى عنه: صالح بن كيسان.(@)(@@)(@@)(@@) ||| AUTO الفضل بن طلحة(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: فرات القزاز.(@)(@@)(@@)(@@) ||| AUTO الفضل بن الحسن بن عمرو بن أمية الضميري(@)(@@) يروي عن: ابن عمر، وأبي هريرة، روى عنه: جعفر بن ربيعة، ومحمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عيسى(@)(@@) يروي عن: أنس بن مالك، روى عنه: موسى بن عبيدة، إن كان الرقاشي، فليس بمتصل.(@)(@@)(@@)(@@) ||| AUTO الفضل بن مبشر الأنصاري(@)(@@) من أهل المدينة، كنيته أبو بكر، يروي عن: جابر، روى عنه: مروان بن معاوية الفزاري، وأهل الكوفة.(@)PageV01P002(@)(@@) [ج 2: ص 434](@)(@@)(@@)(@@) ||| AUTO فضالة بن عبيد الزهراني، ويقال: ابن عمير(@)(@@) يروي عن: المغيرة بن شعبة، روى عنه: أبو العالية، من حديث داود بن أبي هند.(@)(@@)(@@)(@@) ||| AUTO فضالة بن أبي فضالة الأنصاري(@)(@@) يروي عن: علي بن أبي طالب، قال: " عهد إلي رسول الله صلى الله عليه وسلم أن لا أموت حتى أؤمر، وتخضب هذه من هذه ". يعني لحيته من دم هامته، روى عنه: عبد الله بن محمد بن عقيل.(@)(@@)(@@)(@@) ||| AUTO فضالة بن دينار الخزاعي، كنيته أبو حرب(@)(@@) يروي عن: ابن عمر، روى عنه: مكحول.(@)(@@)(@@)(@@) ||| AUTO فضالة بن أبي أمية(@)(@@) والد المبارك بن فضالة، يروي عن: عمر بن الخطاب، روى عنه: عبد الملك بن أبي بشير.(@)(@@)(@@)(@@) ||| AUTO فضالة 
ms713	 التميمي(@)(@@) يروي المراسيل، روى عنه: خليد بن دعلج.(@)(@@)(@@)(@@) ||| AUTO فروة بن نوفل الأشجعي(@)(@@) أخو عبد الرحمن بن نوفل، عداده في أهل الكوفة، يروي عن: عائشة، روى عنه: أبو إسحاق السبيعي، وأهل الكوفة، وقد قيل: إن له صحبة، وقد ذكرناه في الصحابة، والقلب إلى تلك اللفظة ليست بمحفوظة أميل، إنما قالها عبد العزيز بن مسلم القسملي، عن أبي إسحاق.(@)(@@)(@@)(@@) ||| AUTO فرات بن ثعلبة البهراني(@)(@@) من أهل الشام، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: سليم بن عامر الخبائري، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO فائد بن بكير(@)(@@) من أهل الكوفة، يروي عن: حذيفة، روى عنه: حلام بن صالح، وابنه بكير بن فائد.(@)(@@)(@@)(@@) ||| AUTO فرقد(@)(@@) مولى أوس، يروي عن: ابن عمر، روى عنه: عبد الله بن يزيد بن ضبة.(@)PageV01P002(@)(@@) [ج 2: ص 435](@)(@@)(@@)(@@) ||| AUTO فرقد المكي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: صفوان بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO فرقد الخياط(@)(@@) يروي عن: أنس بن مالك، روى عنه: يوسف بن زيد.(@)(@@)(@@)(@@) ||| AUTO فزع بن عفيق المازني(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: المفضل بن فضالة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO فروخ(@)(@@) مولى عثمان بن عفان، يروي عن: عمر بن الخطاب، روى عنه: أبو يحيى المكي.(@)(@@) فروخ(@)(@@) مولى عمر بن الخطاب، يروي عن: عمر بن الخطاب، روى عنه: ابنه عبد الرحمن بن فروخ.(@)(@@) فروخ(@)(@@) مولى الأشتر النخعي، يروي عن: علي بن أبي طالب، روى عنه: حميد بن الأصم.(@)(@@)(@@)(@@) ||| AUTO فروخ أبو عنان(@)(@@) يروي عن: ابن عباس، روى عنه: أبو جناب القصاب.(@)(@@)(@@)(@@) ||| AUTO فريس بن صعصعة(@)(@@) يروي عن: ابن عمر، روى عنه: فطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO فيل بن عرادة(@)(@@) من أهل البصرة، كنيته أبو سهل، يروي عن: جراد بن طارق، روى عنه: الصعق العيشي.(@)(@@)(@@)(@@) ||| AUTO فرافصة بن عمير الحنفي المدني(@)(@@) يروي عن: عمر، وعثمان، روى عنه: القاسم بن محمد، وعبد الله بن محمد بن عقيل.(@)(@@)(@@)(@@) ||| AUTO فطير(@)(@@) يروي عن: ابن مسعود، روى عنه: عبد الله بن عون.(@)PageV01P002(@)(@@) [ج 2: ص 436](@)(@@)(@@)(@@) ||| AUTO فنك(@)(@@) من أهل اليمن، يروي 
ms714	 عن: يعلى بن أمية، ورجل من أصحاب النبي صلى الله عليه وسلم روى عنه: وهب بن منبه.(@)(@@)(@@)(@@) ||| AUTO فطر بن خليفة الخياط القرشي، أبو بكر(@)(@@) من أهل الكوفة، سمع أبا الطفيل، روى عن عامة التابعين، روى عنه: أهل الكوفة، مات سنة ثلاث وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO فلفلة بن عبد الله الجعفي(@)(@@) يروي عن: ابن مسعود، روى عنه: القاسم بن حسان.(@)(@@)(@@)(@@) ||| AUTO فنج(@)(@@) شيخ، يروي عن: يعلى بن أمية، وعن رجل من أصحاب النبي صلى الله عليه وسلم روى عبد الرزاق، عن داود بن قيس الصنعاني، عن عبد الله بن وهب بن منبه، عن أبيه، عنه في الغراس. النساء:(@)(@@)(@@)(@@) ||| AUTO فاطمة بنت الحسين بن علي بن أبي طالب(@)(@@) تروي عن: أسماء بنت عميس، روى عنها: موسى الجهني، ماتت وقد قاربت التسعين سنة.(@)(@@)(@@)(@@) ||| AUTO فاطمة بنت علي بن أبي طالب(@)(@@) تروي عن: أبيها، روى عنها: أهل المدينة، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO فاطمة بنت المنذر بن الزبير بن العوام(@)(@@) امرأة هشام بن PageV01P002 [ج 2: ص 437] عروة، تروي عن: أسماء بنت أبي بكر وهي جدتها، روى عنها: هشام بن عروة، ومحمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO فكيهة بنت كلاب المحاربية(@)(@@) تروي عن: عائشة، روى عنها: مياح بن سريع.(@)(@@) (210) -[2: 437] ثنا عمر بن محمد الهمداني، قال: ثنا أحمد بن المقدام العجلي، قال: ثنا محمد بن بكر البرساني، قال: ثنا مياح بن سريع، قال: حدثتني فكيهة بنت كلاب المحاربية، قالت: كنت عند عائشة، فمرت امرأة بجرة خضراء، فقالت عائشة: " هذا الحنتم الذي نهى رسول الله صلى الله عليه وسلم أن ينبذ فيه "(@)(@@)(@@)(@@) || AUTO باب القاف(@)(@@) قال أبو حاتم:(@)(@@) وممن روى من الصحابة ورآهم ممن ابتدأ اسمه على القاف:(@)(@@)(@@)(@@) ||| AUTO القاسم بن محمد بن أبي بكر الصديق، كنيته أبو محمد(@)(@@) من سادات التابعين، ومن أفضل أهل زمانه علما وأدبا وعقلا وفقها، وكان صموتا لا يتكلم، فلما ولي عمر بن عبد العزيز، قال أهل المدينة: اليوم تنطق العذراء في خدرها أرادوا به القاسم بن محمد، يروي عن: عمته عائشة، روى عنه: الزهري، وابنه عبد 
ms715	 الرحمن بن القاسم، مات بقديد سنة ثنتين ومائة وهو ابن اثنتين وسبعين سنة بعد عمر بن عبد العزيز بسنة في ولاية يزيد بن عبد الملك، وقد قيل: إنه مات سنة ثمان ومائة، وأمه أم ولد.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عبيد الله بن عبد الله بن عمر بن الخطاب(@)(@@) يروي عن: جده عبد الله، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عبد الله بن ربيعة بن القائف الثقفي(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: يعلى بن عطاء.(@)PageV01P002(@)(@@) [ج 2: ص 438](@)(@@)(@@)(@@) ||| AUTO القاسم بن عبد الرحمن بن عبد الله بن مسعود الهذلي(@)(@@) من أهل الكوفة، يروي عن: جابر بن سمرة، وكان غلب أقرانه بخصال ثلاث: طول الصمت، وحسن الخلق، وسخاوة النفس، روى عنه: الأعمش، ومسعر بن كدام، مات في إمارة خالد على العراق سنة عشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عبد الله بن عمرو بن العاص(@)(@@) يروي عن: أبيه، روى عنه: ابنه يحيى بن القاسم.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عبيد(@)(@@) يروي عن: أنس بن مالك، روى عنه: عقبة بن عبد الله البصري.(@)(@@)(@@)(@@) ||| AUTO القاسم بن الربيع(@)(@@) يروي عن: عبد الله بن مغفل، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO القاسم بن ربيعة بن جوشن الغطفاني(@)(@@) يروي عن: ابن عمر، روى عنه البصريون: أيوب، وخالد، وحميد.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عاصم التميمي(@)(@@) يروي عن: رافع بن خديج، روى عنه: حميد الطويل، وأيوب السختياني.(@)(@@)(@@)(@@) ||| AUTO القاسم بن صفوان بن مخرمة الزهري(@)(@@) يروي عن: ابن عمر، روى عنه: الشعبي، وبشير بن سلمان.(@)(@@)(@@)(@@) ||| AUTO القاسم بن ينخسرة(@)(@@) يروي عن: ابن عمر، عداده في أهل اليمن، روى عنه: إسماعيل بن سعيد بن رمانة.(@)PageV01P002(@)(@@) [ج 2: ص 439](@)(@@)(@@)(@@) ||| AUTO القاسم بن البرحي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: الحكيم بن عبد الله بن قيس.(@)(@@)(@@)(@@) ||| AUTO القاسم بن محمد الثقفي(@)(@@) يروي عن: معاوية بن أبي سفيان، وأسماء بنت أبي بكر، روى عنه: عثمان بن المنذر، وقيس بن الأحنف.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عمير(@)(@@) يروي عن: أبي هريرة، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO القاسم بن حسان(@)(@@) يروي 
ms716	 عن: زيد بن ثابت، روى عنه: الركين بن الربيع.(@)(@@)(@@)(@@) ||| AUTO القاسم بن الحكم(@)(@@) يروي عن: عثمان بن عفان، روى عنه: محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عوف الشيباني البكري(@)(@@) من أهل الكوفة، يروي عن: زيد بن أرقم، وابن أبي أوفى، روى عنه: قتادة، وأيوب، والبصريون كأنه انتقل إلى البصرة.(@)(@@)(@@)(@@) ||| AUTO القاسم بن محمد أبو نهيك الأسدي(@)(@@) يروي عن: أنس بن مالك، روى عنه: منصور، والثوري.(@)(@@)(@@)(@@) ||| AUTO القاسم الرحال أبو مالك(@)(@@) يروي عن: أنس بن مالك، عداده في أهل البصرة، ربما أخطأ، روى عنه: حماد بن سلمة، وابن عيينة.(@)PageV01P002(@)(@@) [ج 2: ص 440](@)(@@)(@@)(@@) ||| AUTO القاسم بن محمد، أبو نهيك(@)(@@) أصله في الكوفة، سكن مرو، سمع أبا زيد عمرو بن أخطب، روى عنه: الحسين بن واقد، وقد ذكرناه في أتباع التابعين لأن الناس لا يعرفون سماعه من أبي زيد.(@)(@@)(@@)(@@) ||| AUTO القاسم بن مخول البهزي السلمي(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: محمد بن سليمان بن مسمول.(@)(@@)(@@)(@@) ||| AUTO القاسم بن كثير(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: أبو هاشم الرماني.(@)(@@)(@@)(@@) ||| AUTO القاسم بن يوسف اليماني(@)(@@) يروي عن: ابن عمر، روى عنه: حنظلة بن أبي سفيان، والحكم بن أبان.(@)(@@)(@@)(@@) ||| AUTO القاسم بن زياد السعدي(@)(@@) يروي عن: أنس بن مالك، روى عنه: شبابة بن سوار.(@)(@@)(@@)(@@) ||| AUTO القاسم بن البرحي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: الحكيم بن عبد الله بن قيس، إن لم يكن البرحي المتقدم فهو آخر.(@)(@@)(@@)(@@) ||| AUTO القاسم بن عثمان أبو العلاء(@)(@@) من أهل البصرة، ربما أخطأ، يروي عن: أنس، روى عنه: إسحاق بن يوسف الأزرق.(@)(@@)(@@)(@@) ||| AUTO القاسم بن مخيمرة(@)(@@) كوفي، سكن الشام، كنيته: أبو عروة، يروي عن: أبي موسى الأشعري إن كان سمع منه، روى عنه: الأوزاعي، وعبدة بن أبي لبابة، وقد سأل عائشة عما تلبس المحرمة، فقالت: " تلبس من خزها، وقزها، وعقدها، وحليها ". مات في خلافة عمر بن عبد العزيز بدمشق.(@)PageV01P002(@)(@@) [ج 2: ص 441](@)(@@)(@@)(@@) ||| AUTO قيس بن أبي حازم الكوفي، كنيته أبو عبد الله، وقد قيل: أبو 
ms717	 عبيد الله(@)(@@) يروي عن: العشرة، روى عنه: إسماعيل بن أبي خالد، وأبو إسحاق السبيعي، وسماك بن حرب، مات سنة أربع وتسعين، وقد قيل: سنة ثمان وتسعين، وقد قيل: سنة أربع وثمانين، وقد قيل: سنة ستة وثمانين، واسم أبي حازم عوف بن الحارث، ويقال: عبد عوف بن الحارث، كان قيس بن أبي حازم أتى النبي صلى الله عليه وسلم ليبايعه، فقدم المدينة وقد قبض النبي صلى الله عليه وسلم فبايع أبا بكر الصديق.(@)(@@) (211) -[2: 441] ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا إسماعيل بن أبي خالد، عن قيس بن أبي حازم، عن جرير، قال: كنا جلوسا مع النبي صلى الله عليه وسلم فنظر إلى القمر ليلة البدر، فقال: " إنكم سترون ربكم كما ترون هذا لا تضامون في رؤيته، فإن استطعتم أن لا تغلبوا على صلاة قبل طلوع الشمس، وصلاة قبل أن تغرب الشمس فافعلوا، ثم قرأ الآية {وسبح بحمد ربك قبل طلوع الشمس وقبل غروبها} "(@)(@@)(@@)(@@) ||| AUTO قيس بن حبتر التميمي النهشلي الأسدي(@)(@@) يروي عن: ابن مسعود، وابن عباس، روى عنه: علي بن بذيمة، والكوفيون.(@)(@@) (212) -[2: 441] ثنا البغوي، قال: ثنا أحمد بن حنبل، قال: ثنا أبو أحمد الزبيري، قال: ثنا سفيان، عن علي بن بذيمة، عن قيس بن حبتر، قال: قال ابن عباس، قال رسول الله صلى الله عليه وسلم: " كل مسكر حرام "(@)(@@)(@@)(@@) ||| AUTO قيس بن عباد اليشكري(@)(@@) من ولد قيس بن ثعلبة، من روى عنه: الحسن، وبكر بن عبد الله المزني.(@)(@@)(@@)(@@) ||| AUTO قيس بن الحارث الغامدي، الشامي الحمصي(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عراك بن مالك والناس.(@)(@@)(@@)(@@) ||| AUTO قيس بن سعد الخارفي(@)(@@) من أهل الكوفة، كنيته أبو المغيرة، يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 442] عثمان بن عفان، وعلي بن أبي طالب، روى عنه: أبو إسحاق، والقاسم بن كثير.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO قيس بن السكن الأسدي الكوفي(@)(@@) يروي عن: ابن مسعود، روى عنه: أشعث بن سليم، مات في ولاية مصعب بن الزبير على العراق.(@)(@@)(@@)(@@) ||| AUTO قيس بن مسلم 
ms718	 الجدلي، جديلة قيس(@)(@@) كوفي، يروي عن: طارق بن شهاب وله صحبة، روى عنه: أهل الكوفة، مات سنة عشرين ومائة، كنيته أبو عمرو.(@)(@@)(@@)(@@) ||| AUTO قيس بن قيس التيمي، وقد قيل: قيس بن أبي قيس، كنيته أبو سعيد(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: كليب بن وائل.(@)(@@)(@@)(@@) ||| AUTO قيس بن عبد الشعبي(@)(@@) شعب من همدان، روى عن: ابن مسعود، روى عنه: الكوفيون.(@)(@@)(@@)(@@) ||| AUTO قيس بن يزيد(@)(@@) يروي عن: ابن مسعود، عداده في أهل الكوفة، روى عنه: ابنه النعمان بن قيس.(@)(@@) قيس(@)(@@) مولى خباب، يروي عن: ابن عمر، روى عنه: ابن جريج، أحسبه ابن سعد.(@)(@@)(@@)(@@) ||| AUTO قيس أبو قدامة(@)(@@) مولى لأم سلمة، يروي عن: أم سلمة، روى عنه: فرات القزاز.(@)(@@)(@@)(@@) ||| AUTO قيس أبو عبد الله اليربوعي(@)(@@) غزا مع خالد بن الوليد، روى عنه: ابن ابنه يونس بن عبد الله بن قيس.(@)PageV01P002(@)(@@) [ج 2: ص 443](@)(@@)(@@)(@@) ||| AUTO قيس بن رافع(@)(@@) يروي عن: جرير بن عبد الله، روى عنه: عبد الله بن الحارث.(@)(@@)(@@)(@@) ||| AUTO قيس بن الأحنف(@)(@@) لقي أسماء بنت أبي بكر، روى عنه: يزيد بن أبي زياد.(@)(@@) (213) -[2: 443] ثنا محمد بن إسحاق الثقفي، قال: ثنا إسحاق بن إبراهيم، ومحمد بن الصباح، قالا: أنبأنا جرير، عن يزيد بن أبي زياد، عن قيس بن أحنف، عن أسماء بنت أبي بكر، قالت: سمعت رسول الله صلى الله عليه وسلم يقول: " في ثقيف كذاب ومبير "، فقالت للحجاج: أما الكذاب فقد رأيناه، وأما المبير فأنت يا حجاج(@)(@@)(@@)(@@) ||| AUTO قيس بن ثعلبة(@)(@@) يروي عن: عمر، وعثمان، وعلي، وابن مسعود، عداده في أهل الكوفة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO قيس بن أبي قيس الجعفي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: القرثع.(@)(@@)(@@)(@@) ||| AUTO قيس أبو يحيى(@)(@@) يروي عن: أبي هريرة، روى عنه: بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO قيس بن عبدة(@)(@@) يروي عن: ابن مسعود، وأبي ذر، روى عنه: الشعبي، وصالح بن جبلة.(@)(@@)(@@)(@@) ||| AUTO قيس الجذامي(@)(@@) يروي عن: نعيم بن همار الغطفاني، عن النبي صلى الله عليه وسلم عن ربه عز وجل 
ms719	 أنه قال: " يابن آدم، صل لي أربع ركعات أول النهار أكفيك آخره ". روى عنه: كثير بن مرة الحضرمي.(@)(@@)(@@)(@@) ||| AUTO قيس بن زهير(@)(@@) يروي عن: حنظلة الكاتب، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO قيس بن ثور(@)(@@) يروي عن: أبي بكر الصديق، روى عنه: سويد بن قيس.(@)PageV01P002(@)(@@) [ج 2: ص 444](@)(@@)(@@)(@@) ||| AUTO قيس العبدي(@)(@@) كوفي، يروي عن: عمر بن الخطاب، روى عنه: ابنه الأسود بن قيس.(@)(@@)(@@)(@@) ||| AUTO قيس بن كركم(@)(@@) يروي عن: ابن عباس، روى عنه: أبو إسحاق السبيعي، وهو قيس بن شفي، كان يحيى القطان يكره أن يقال: ابن كركم.(@)(@@)(@@)(@@) ||| AUTO قيس بن دينار، أبو ثابت(@)(@@) والد حبيب بن أبي ثابت، يروي عن: عمر بن الخطاب، روى عنه: ابنه حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO قيس التغلبي(@)(@@) يروي عن: سهل بن الحنظلية، عن النبي صلى الله عليه وسلم قال: المنفق على الخيل في سبيل الله كالباسط كفيه بالصدقة لا يقبضها، روى عنه: ابنه بشر بن قيس.(@)(@@)(@@)(@@) ||| AUTO قيس بن طلق بن علي الحنفي(@)(@@) من أهل اليمامة، يروي عن: أبيه، روى عنه: عبد الله بن بدر، ومحمد بن جابر.(@)(@@)(@@)(@@) ||| AUTO قيس بن سالم، أبو حزرة(@)(@@) يروي عن: أبي أمامة بن سهل بن حنيف، روى عنه: يحيى بن أيوب المصري، وهو مصري.(@)(@@)(@@)(@@) ||| AUTO قيس بن سيار(@)(@@) يروي عن: أبي هريرة، روى عنه: شيخ يقال له: خداش.(@)(@@)(@@)(@@) ||| AUTO قيس بن طغفة الغفاري(@)(@@) يروي عن: أبيه، وله صحبة، روى يحيى بن أبي كثير، عن ابن قيس، عن أبيه، وقد رواه يحيى، عن أبي سلمة، عن يعيش بن طغفة، عن أبيه.(@)(@@)(@@)(@@) ||| AUTO قيس بن همام التيمي(@)(@@) يروي عن: ابن عباس، روى عنه: أهل العراق.(@)PageV01P002(@)(@@) [ج 2: ص 445](@)(@@)(@@)(@@) ||| AUTO قيس المدايني أبو مريم(@)(@@) يروي عن: علي بن أبي طالب، وعمار بن ياسر، روى عنه: عبد الملك بن حكيم.(@)(@@)(@@)(@@) ||| AUTO قيس بن وهب الهمداني(@)(@@) يروي عن: أنس بن مالك، روى عنه: الثوري، وحسين بن واقد.(@)(@@) (214) -[2: 445] ثنا محمد بن أحمد الشطوي ببغداد، قال: ثنا أبو هشام الرفاعي، قال: ثنا يحيى بن يمان، عن سفيان، 
ms720	 عن قيس بن وهب، عن أنس، قال: كان الأكابر من أصحاب النبي صلى الله عليه وسلم " ينهون عن سب الأمراء "(@)(@@)(@@)(@@) ||| AUTO قيس أبو سعيد الرقاشي(@)(@@) مولى حضين بن المنذر، من أهل البصرة، يروي عن: ابن عباس، روى عنه: سليمان التيمي.(@)(@@)(@@)(@@) ||| AUTO قيس بن عبد الله بن الحارث بن قيس(@)(@@) لقى عمر بن الخطاب، روى عنه: المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO قيس بن محمد بن الأشعث بن قيس الكندي(@)(@@) يروي عن: عدي بن حاتم، روى عنه: ابنه عثمان بن قيس، وهو أخو عبد الرحمن بن محمد بن الأشعث.(@)(@@)(@@)(@@) ||| AUTO قيس بن رافع القيسي(@)(@@) من أهل مصر، كنيته أبو رافع، وقد قيل: أبو عمرو، يروي عن: أبي هريرة، روى عنه: يزيد بن أبي حبيب والمصريون.(@)(@@)(@@)(@@) ||| AUTO قيس بن سعد(@)(@@) مولى خباب الأسلمي، لقى الحسن، والحسين ابني علي بن أبي طالب، روى عنه: عبد العزيز بن رفيع، وابن جريج.(@)(@@)(@@)(@@) ||| AUTO قيس بن مروان(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: حبيب.(@)PageV01P002(@)(@@) [ج 2: ص 446](@)(@@)(@@)(@@) ||| AUTO قيس(@)(@@) مولى الضحاك، يروي عن: ابن عمر، روى عنه: حماد بن سعيد.(@)(@@)(@@)(@@) ||| AUTO قيس بن زيد(@)(@@) يروي عن: ابن عباس، روى عنه: أبو عمران الجوني.(@)(@@)(@@)(@@) ||| AUTO قيس بن الحارث(@)(@@) يروي عن: سلمان الفارسي، روى عنه: عقبة بن مشيم، بالميم.(@)(@@)(@@)(@@) ||| AUTO قيس بن عباية، أبو نعامة الرماني الحنفي(@)(@@) من أهل البصرة، يروي عن: علي بن أبي طالب، روى عنه: الجريري، وزياد بن مخراق.(@)(@@)(@@)(@@) ||| AUTO قيس أبو داود(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: ابنه داود بن قيس.(@)(@@)(@@)(@@) ||| AUTO قيس بن سليم العنبري(@)(@@) يروي عن: ابن مسعود، روى عنه: العلاء بن بدر.(@)(@@)(@@)(@@) ||| AUTO قيس بن عبادة(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: أبو مجلز.(@)(@@)(@@)(@@) ||| AUTO قبيصة بن برمة(@)(@@) يروي عن: المغيرة بن شعبة، روى عنه: سليمان التيمي.(@)(@@) (215) -[2: 446] حدثنا أحمد بن علي بن المثنى، ثنا جعفر بن حميد الكوفي، قال: ثنا عبيد الله بن إياد بن لقيط، قال: سمعت أبي، يحدث، عن قبيصة بن برمة، عن المغيرة بن شعبة، قال: 