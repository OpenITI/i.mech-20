ms1141	 لل % قسم إذا كان شر أقسامي % % 13(@)(@@) % وكيف أغضي على الدنية وال % فرس خؤولي والروم أعمامي % % 14(@)(@@) % وقد تتوجت من ولاء أبي ال % % عباس تاجا يسمو به السامي % % 15(@)(@@) % يا قاتل الله عصبة جعلت % إجرام دهري إلي إجرامي % % 16(@)(@@) % من ضن عني ببذل نائله % ضننت عنه ببذل أيامي % % 17(@)(@@) % تالله لا تلتقي الثلاثة وص % ليه وإثراؤه وإعدامي % % 18(@)(@@) % قد كنت بالله مشركا وثنا % فزال شركي وصح إسلامي % % 19(@)(@@) % أستغفر الله من عبادتهم % % فإنها من عظيم آثامي % % 20(@)(@@) % طالت صلاتي لهم ورافدها % % صومي من مالهم وإحرامي % % PageV01P4342 21(@)(@@) % أستغفر الله كم وكم رجل % % أعظمته وهو دونإعظامي % % 22(@)(@@) % ثم تبينت أنه غرض % ليس من اللائي يقصد الرامي % % 23(@)(@@) % من جامد الكف حين تسأله % % وخائن الحبل عند إعصامي % % 24(@)(@@) % وضاحك بي وليس يضحكه % شيء سوى أن ظلفي الدامي % % 25(@)(@@) % يضحك من كل ما بكيت له % كأن لذاته بآلامي % % 26(@)(@@) % لو احتججنا في محفل لدرى % % أن ليس إلزامه كإلزامي % % 27(@)(@@) % والله لاصح باطني لأخ % % يصحه الله عند إسقامي % % 28(@)(@@) % وما خليلي الخليل يعجبه % تركي أمواله وإجمامي % % 29(@)(@@) % وما أراني يفوز مطرحي % % وما أراني يخيب معتامي % % PageV01P4343 البحر : - 1(@)(@@) % خلياني عند اصطكاك الخصوم % % وازحما بي عند اعتراك القروم % 2(@)(@@) % وكلاني إلى بلائي وصدقي % % تأمنا نبوة الكهام اللئيم % % 3(@)(@@) % يا بن بوران ما نجوت لوأ % % د الخير لكن لوأد شر عظيم % % 4(@)(@@) % لو تبعت الألى مضوا من شهيد % % ووئيد إلى جنان النعيم % % 5(@)(@@) % كان خيرا من البقاء لحربي % % بل أبى شؤم جدك المشؤوم % % 6(@)(@@) % وإذا لم تحن محائن قوم % فلماذا تجري نحوس النجوم % % 7(@)(@@) % أنا من أذعنت له الإنس والجن % ن جميعا بالقسر والترغيم % % 8(@)(@@) % واسع العفو للمنيب وعندي % % نقمات تدوم للمستديم % % 9(@)(@@) % سوف تدري غدا إذا ما التقينا % % للتهاجي في حفل أهل العلوم % % 10(@)(@@) % حين أفتر عن قوافي غرا % وتوري عن مضحك مهتوم % % PageV01P4344 11(@)(@@) % يا بن بوران كيف أخطأك الجس % % م فلم تعل جسم كل جسيم % % 12(@)(@@) % فلعمري لما أتيت من الما % % ء ولكن من السقاء الهزيم 
ms1142	 % % 13(@)(@@) % شمل الناس عدل أمك حتى % % سار فيهم كسير جور سدوم % 14(@)(@@) % لو رآك الرجال شيئا نفيسا % كثرت فيك هثهثات الخصوم % % 15(@)(@@) % كيف ندعوهم لآبائهم ربي % % ومنهم أمثال هذا الزنيم % % 16(@)(@@) % كل فحل أبوك عدلا من ال % % له وعيسى بلا أب كاليتيم % % 17(@)(@@) % تطمث الأرض من مواطىء بو كلث عضو من جسمها فيه فرج يقتضيها الزنا اقتضاء الغريم % % ران ولو بين زمزم والحطيم % % 17(@)(@@) % كلث عضو من جسمها فيه فرج % يقتضيها الزنا اقتضاء الغريم % % 18(@)(@@) % أفحش القذف والهجاء لبو % % ران طهور كالرجم للمرجوم % % 19(@)(@@) % كيف لا تسقط السماء على الأر % % ض ونرمى من أجلها بالرجوم % PageV01P4345 20(@)(@@) % كثرت موبقات بوران حتى % % ضاق عنها عفو الغفور الرحيم % % 21(@)(@@) % غلبته خلاعة ومجونا % يا لقوم للشيخة المغليم % % 22(@)(@@) % ذللت أنفه فكيف أرادت % صرفته كالكودن المخطوم % % 23(@)(@@) % فإذا ليم في تغاضيه عنها % % قال من شأني اطراح الهموم % % 24(@)(@@) % رضي الشيخ بالذي قدر ال % % له فألقى مقالد التسليم % % 25(@)(@@) % غير أن لم تغبنه طرفة عين % % بفجور ولا زنا مكتوم % 26(@)(@@) % بل بسحناء وجه سهل طليق % وبطيب من نفس سمح كريم % % 27(@)(@@) % لو أطاعت كما عصت لاستحقت % خلة الله دون إبراهيم % % 28(@)(@@) % ليس لي من هجاء بوران إلا % % نقل منثوره إلى المنظوم % 29(@)(@@) % ومعاني كلهن اتباع % لا ابتداع والعلم بالتعليم % % PageV01P4346 30(@)(@@) % هي تفري لي الفري فأحذو % % حذوها كالإمام والمأموم % % 31(@)(@@) % ما أراني أسير الشعر فيها % % سيرها في سهولها والحزوم % % 32(@)(@@) % هي أهدى من القوافي وأسرى % % في دجى الليل والفلا الديموم % % 33(@)(@@) % حملاها النهار والليل دأبا % % يعملان الرسيم بعد الرسيم % % 34(@)(@@) % ليس يخلي منها مكانا مكان % هي شيء خصوصه كالعموم % % 35(@)(@@) % تتأنى محيضها ثم تزني % % في المحاريب طاعة للرجيم % % 36(@)(@@) % هي طيف الخيال يطرق أه % % ل الأرض من بين ظاعن ومقيم % % 37(@)(@@) % هي بالليل كل شخص تراه % % ماثلا في الظلام كالجرثوم % % 38(@)(@@) % لا تمل البروك أو تقع الطي % % ر على متنها كبعض الأروم % % 39(@)(@@) % ناقضت مريم العفاف فلما % % قاومتها بالغي والتأثيم % % PageV01P4347 40(@)(@@) % صمدت في الزنا تناسل حوا % % ء 
ms1143	 فحواء عندها كالعقيم % 41(@)(@@) % أيها المؤذني بصرم حبالي % % رب رزء كالمغنم المغنوم % 42(@)(@@) % في الذي بين ترمتيك وبيني % % خلف من وصالك المصروم % % 43(@)(@@) % لا تخلني قرعت سنا بظفر % من ندام عليك أو تنديم % % 44(@)(@@) % في سبيل الشيطان منك نصيبي % % وعليك العفاء لؤم ابن لوم % % 45(@)(@@) % وهنيئا لحرمتيك هنيئا % حازتا فحلتي بغير قسيم % 46(@)(@@) % إن من كون السفاح سفاحا % ساطه من دمائها واللحوم % 46(@)(@@) % كانتا منك في ضرار فأمسى % % لهما شرب يومك المعلوم % % 46(@)(@@) % ثمدتني بنات بوران حتى % % أعقمتني وكنت غير عقيم % % 46(@)(@@) % لقى الناس من زناهن شرا % % فهم بين جافر وسقيم % % PageV01P4348 46(@)(@@) % قد أكلن الأيور الضواري % % وشربن المني شرب الهيم % % 46(@)(@@) % رافعات الأقدام بالليل يدعو % % ن على المحصنين بالتأثيم % % 46(@)(@@) % فهو يجري فيها ويسلك منها % % حيث تجري أرواحها في الجسوم % 46(@)(@@) % نزع الله غيرة الفحل منه % % فهو ما شئت من فؤاد سليم % % 46(@)(@@) % تقليس النخل في مرارته الأر % % ي مصفى من القذى والموم % % 46(@)(@@) % غير أن الفتى يغاير عرسي % ه على كل ناشيء صهميم % % 46(@)(@@) % جذل نيك يمشي الهوينا فينما % % ز وزيم من لحمه عن وزيم % % 46(@)(@@) % جامعات بذاك أمرين في أم % % ر فعال المستمتع المستديم % % 47(@)(@@) % قلت لما قرأت في مجلس الأق % % وام طوبى الأم والمزكوم % % 47(@)(@@) % سائل القمع ليلة القفص عنهبات قمع يدعه في الصمارى مثل دع الربيب وبين الكروم يتقصاه مغرق النزع فيهكتقصى الطبيب سبر الأميم كلما هب هبة بنشاط حفزت جعسه إلى البلعوم فهو يجتر جرة بعد أخرى تترقى من فرثه المزحوم يا % % بين حاناتها وبين الكروم % % PageV01P4349 47(@)(@@) % بات قمع يدعه في الصمارى % % مثل دع الربيب وبين الكروم % % 47(@)(@@) % يتقصاه مغرق النزع فيه % % كتقصى الطبيب سبر الأميم % % 47(@)(@@) % كلما هب هبة بنشاط % حفزت جعسه إلى البلعوم % % 47(@)(@@) % فهو يجتر جرة بعد أخرى % % تترقى من فرثه المزحوم % 47(@)(@@) % يا اخا النحو والمقدم فيه % % لم تر اللام أدغمت في الميم % % 47(@)(@@) % غير لام أدغمتها أنت في مي % % مك ثم احتججت يا بن الخطيم % % 48(@)(@@) % أي نتن وأي مسموع 
ms1144	 سوء % عدماه حاشا الكتاب الحكيم % % 49(@)(@@) % كيف لا يحرق الجنان ابن بورا % % ن بذاك الفم الخبيث النسيم % % 50(@)(@@) % قسما لو يكون الاسم المسمى % % أصبحت كل جنة كالصريم % % 51(@)(@@) % غرك الرائدان ويلك مني % % وأسامك في الوبيل الوخيم % % PageV01P4350 52(@)(@@) % إذ تنقصتني بصعلكة الرأ % % س سفاها فاذممت غير ذميم % % 53(@)(@@) % ما تعديت أن وصفت خشاشا % % لوذعيا كالحية المشهوم % % 54(@)(@@) % لوذعيا كأن مابين عطفي % % ه مصابيح كل ليل بهيم % % 55(@)(@@) % بتضني الفؤاد يسرب في الخر % % ت وينغل في مجاري السموم % % 56(@)(@@) % وقديما ما جرب الناس قبلي % % ثقل الهام في الخفاف الحلوم % % 57(@)(@@) % واعتبر أن أفسل الطير في الطي % ر وفينا كروسات البوم % % 58(@)(@@) % ثم حاولت بالمصيقل تصغي % % ري فما زدتني سوى تعظيم % % 59(@)(@@) % كالذي يعكس الشهاب ليخفى % % وهو أدنى له إلى التضريم % % 60(@)(@@) % وإذا سميت دويهية أح % % دى الدواهي فالأمر غير مروم % % 61(@)(@@) % ما تبالي وبين كشحيك هذا الش % شعر سكنى لظى وشرب الحميم % % PageV01P4351 62(@)(@@) % كلمات ليست بمكروهة المس % % موع لكن مكروهة المشموم % 63(@)(@@) % لم تسرب في خرق أذني وطارت % % كمطير الفساء في خيشوم % % 64(@)(@@) % يابن بوران قد أظلك زجر % كالدخان المذكور في حاميم % % 65(@)(@@) % يابن بوران لامفر من ال % % له ولا من قضائه المحتوم % % 66(@)(@@) % كنت فيما أرى حسبت هجائي % % ك هجاء أبقى مصح أديم % % 67(@)(@@) % فتغاضيت خوف أعرم منه % % راضيا خطة الذليل المضيم % % 68(@)(@@) % فإذا الأمر فوق ماكنت قد % درت وليس اليقين كالترجيم % % 69(@)(@@) % صدمت مسمعيك شنع القوافي % % صدمة غادرتك كالمأموم % % 70(@)(@@) % فتلومت واقفا موقف الأش % % قر بين التأخير والتقديم % % 71(@)(@@) % تقسم الأمر رهن نحر وعقر % قد تحيرت حيرة المدهوم % % PageV01P4352 72(@)(@@) % ساعة ثم قلت قد هلك الهل % ك فأشفي غيظي وأمضي همومي % % 73(@)(@@) % ولعمري لقد عميت من الرش % د وقصد المحجة المستقيم % % 74(@)(@@) % ما مضيض الكلوم مغتبطات % كمضيض الكلوم فوق الكلوم % % 75(@)(@@) % إن شتما ألمته يابن بورا % % ن لأدهى من العذاب الأليم % % 76(@)(@@) % ليس هذا عهدي بصبرك للهو % % ن على سالف الزمان القديم % % 77(@)(@@) % ما عهدناك قط إلا عزوفا % للمذلات مستباح الحريم 
ms1145	 % % 78(@)(@@) % لاتبالي من ناك أمك جهرا % من عدو ومن ولي حميم % % 79(@)(@@) % أفترضى بنيكها وتبالي % % شتمها يا ضلال حلم الحليم % % 80(@)(@@) % اعتبر أين من يجاهر بالسوء % % في أمه من المشتوم % % 81(@)(@@) % غير أني أنضجت جلدك كيا % % فتململ فأنت غير ملوم % % PageV01P4353 82(@)(@@) % لك عذر أن لاتنام لعمري % % أنا أدهى من أن ينام سليمي % % 83(@)(@@) % يابن بوران دعوة لو تجرأ % % ت بها ما قرنت ميما بميم % % 84(@)(@@) % هاكها حلة سيودي بك الده % % ر وفيها طرائق التسهيم % % 85(@)(@@) % قد أردت التشبيب فيها ولكن % لم تكن لي مندوحة في الميم % % 86(@)(@@) % لايراني الإله أهجوك عمري % % أنت عندي في حالة المرحوم % % 87(@)(@@) % للقوافي في وصف أمك شغل % يابن بوران عن صفات الرسوم % % PageV01P4354 البحر : - 1(@)(@@) % له مال يجم على العطايا % % ونعمة كل ذي كرم تدوم % 2(@)(@@) % كماء العد مهما نال منه % % سقاه الماء أخلفه الجموم % % PageV01P4355 البحر : - 1(@)(@@) % مراح شيبي علي مثل الثغامص وغدا عاذلي ألد الخصام % عزني في خطابه أن رآني % % 2(@)(@@) % صار بعضي ظهيره في ملامي % % ويحسب المفندي بمشيب % 3(@)(@@) % رد غرب الجماح رد اللجام % % قنع الرأس ثم لثم وجهي % % 4(@)(@@) % وكفى بالقناع دون اللثام % % حل رأسي فراعني أن في الشي % % 5(@)(@@) % ب نعي الصبا نذير الحمام % % راعني شخصه وراع بشخصي % % 6(@)(@@) % مقر الإنس ساكنات الخيام % % فتناهين قاليات وصالي % % 7(@)(@@) % وتناهيت خائفا ما أمامي % % بل تناهيت مكرها بتناهي ال % % 8(@)(@@) % بيض عني وما انتهت أعرامي % % كالذي ذاده السقاة عن الماء % % 9(@)(@@) % ء ولم يشف ما به من أوام % حسرتي للشباب لابل من الشي % 10(@)(@@) % ب لقد طال مذ بدا تحوامي % % ذادني عن موارد لي كانت % PageV01P4356 11(@)(@@) % شافيات من الغليل الهيام % % حرمت بالمشيب أشياء حلت % 12(@)(@@) % لي زمانا بإذن جعد سخام % % لم تحلل لمن أتاها ولكن % 13(@)(@@) % لم يكن دونها من الشيب حامي % % فأتى الآن دونها فهي اليو % 14(@)(@@) % م حرام علي كل الحرام % % سوأتي أن أطعت شيبي فيماراح شيبي علي مثل الثغام % 15(@)(@@) % وغدا عاذلي ألد الخصام % عزني في خطابه أن رآني % % 16(@)(@@) % صار بعضي 
ms1146	 ظهيره في ملامي % % ويحسب المفندي بمشيب % 17(@)(@@) % رد غرب الجماح رد اللجام % % قنع الرأس ثم لثم وجهي % % 18(@)(@@) % وكفى بالقناع دون اللثام % % حل رأسي فراعني أن في الشي % % 19(@)(@@) % ب نعي الصبا نذير الحمام % % راعني شخصه وراع بشخصي % % 20(@)(@@) % مقر الإنس ساكنات الخيام % % فتناهين قاليات وصالي % % PageV01P4357 21(@)(@@) % وتناهيت خائفا ما أمامي % % بل تناهيت مكرها بتناهي ال % % 22(@)(@@) % بيض عني وما انتهت أعرامي % % كالذي ذاده السقاة عن الماء % % 23(@)(@@) % ء ولم يشف ما به من أوام % حسرتي للشباب لابل من الشي % 24(@)(@@) % ب لقد طال مذ بدا تحوامي % % ذادني عن موارد لي كانت % 25(@)(@@) % شافيات من الغليل الهيام % % حرمت بالمشيب أشياء حلت % 26(@)(@@) % لي زمانا بإذن جعد سخام % % لم تحلل لمن أتاها ولكن % 27(@)(@@) % لم يكن دونها من الشيب حامي % % فأتى الآن دونها فهي اليو % 28(@)(@@) % م حرام علي كل الحرام % % سوأتي أن أطعت شيبي فيما % % 29(@)(@@) % لم أطع فيه حاكم الحكام % وعظ الله والكتاب فصم % 30(@)(@@) % ممت وأقدمت أيما إقدام % % ونهى الشيب بعد ذاك فسلم % PageV01P4358 31(@)(@@) % ت وأحجمت أيما إحجام % % صمت عن كل لذة لمشيبي % % 32(@)(@@) % أفلا كان للإله صيامي % % وإحيائي أن لا يكون من ال % % 33(@)(@@) % له حيائي من غيره واحتشامي % % إذ تعديت لا حياء من الل % 34(@)(@@) % له نهاني ولا اتقاء انتقام % % وتناهيت معظما لمشيبي % % 35(@)(@@) % ومشيبي أحق بالإعظام % % أفلا هبت ذا المهابة من قب % % 36(@)(@@) % ل وأكرمت وجه ذي الإكرام % % كاد هذا المتاب يعتد إجرا % % 37(@)(@@) % ما وبعض المتاب كالإجرام % % توبة مثل حوبة وقديما % 38(@)(@@) % أتبع الجهل زلة بارتطام % % دحضت حجة المنيب إلى الشي % 39(@)(@@) % ب وأنى لطالب بقوام % % أي عذر لتائب لا إلى الل % % 40(@)(@@) % ه ولكن إلى شبيه الثغام % % إن عذرا من الذهاب إلى الل % % PageV01P4359 41(@)(@@) % ه لعذر يغلو على المستام % % أإلى أرذلي جعلت متابي % % 42(@)(@@) % ضلة مثل ضلة الأنعام % بل إلى الله تبت لما ثناني % % 43(@)(@@) % بعناني وزاعني بزمامي % % راعني بالمشيب عما نهى عن % % 44(@)(@@) % ه بآي الكتاب ذي الإحكام % % كم بدا في الكتاب 
ms1147	 لي من ضياء % 45(@)(@@) % كان من قبل دونه كالقتام % % هتك الشيب ذلك الستر لي عن % % 46(@)(@@) % ه فزال العمى وراح التعامي % % وكلا الشيب والكتاب جميعا % 47(@)(@@) % واعظ زاجر عن الآثام % % غير أن الكتاب يكتب بالأق % 48(@)(@@) % لام والشيب ليس بالأقلام % بل بردع الحوادث المصمئلا % 49(@)(@@) % ت ومر الشهور والأعوام % % لن ترى مثله كتابا مبينا % % 50(@)(@@) % لا بشكل له ولا إعجام % % خط غفل الحروف يقرؤه الأم % PageV01P4360 51(@)(@@) % مي كالصبح غير ذي استعجام % % فيه للقارئين أي نذير % 52(@)(@@) % ببلى جدة ووشك اخترام % % عاذلي قد نزعت فانزع عن العذ % 53(@)(@@) % ل وإن كنت في صواب حذام % % قد رأيت الذي هويت فأرضي % 54(@)(@@) % ت وأرغمت فارض لي إرغامي % % حلأتني الخطوب عن شرع الله % % 55(@)(@@) % و فأصبحت حائما في الحيامن راح شيبي علي مثل الثغام % وغدا عاذلي ألد الخصام % 56(@)(@@) % عزني في خطابه أن رآني % % صار بعضي ظهيره في ملامي % % 57(@)(@@) % ويحسب المفندي بمشيب % رد غرب الجماح رد اللجام % % 58(@)(@@) % قنع الرأس ثم لثم وجهي % % وكفى بالقناع دون اللثام % % 59(@)(@@) % حل رأسي فراعني أن في الشي % % ب نعي الصبا نذير الحمام % % 60(@)(@@) % راعني شخصه وراع بشخصي % % مقر الإنس ساكنات الخيام % % PageV01P4361 61(@)(@@) % فتناهين قاليات وصالي % % وتناهيت خائفا ما أمامي % % 62(@)(@@) % بل تناهيت مكرها بتناهي ال % % بيض عني وما انتهت أعرامي % % 63(@)(@@) % كالذي ذاده السقاة عن الماء % % ء ولم يشف ما به من أوام % 64(@)(@@) % حسرتي للشباب لابل من الشي % ب لقد طال مذ بدا تحوامي % % 65(@)(@@) % ذادني عن موارد لي كانت % شافيات من الغليل الهيام % % 66(@)(@@) % حرمت بالمشيب أشياء حلت % لي زمانا بإذن جعد سخام % % 67(@)(@@) % لم تحلل لمن أتاها ولكن % لم يكن دونها من الشيب حامي % % 68(@)(@@) % فأتى الآن دونها فهي اليو % م حرام علي كل الحرام % % 69(@)(@@) % سوأتي أن أطعت شيبي فيما % % لم أطع فيه حاكم الحكام % 70(@)(@@) % وعظ الله والكتاب فصم % ممت وأقدمت أيما إقدام % % PageV01P4362 71(@)(@@) % ونهى الشيب بعد ذاك فسلم % ت وأحجمت أيما إحجام % % 72(@)(@@) % صمت عن كل لذة لمشيبي % % أفلا كان 
