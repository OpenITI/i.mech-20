ms514	 ج 4، ك 3، ب 73، ح 3.(@)(@@) وروى عنه سعد.(@)(@@) التهذيب: ج 2، ح 1343.(@)(@@) وروى عنه محمد.(@)(@@) الكافي: ج 5، ك 2، ب 64، ح 2.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 7، ك 4، ب 41، ح 3.(@)(@@) * وروى عن محمد بن سهل بن اليسع الأشعري، وروى عنه سعد.(@)(@@) التهذيب: ج 2، ح 1471، (الاستبصار:(@)(@@) ج 1. ح 1488 وفيه أحمد بن محمد).(@)(@@) * وروى عن محمد بن عبد الجبار.(@)(@@) الكافي: ج 1، ك 4، ب 59، ح 7.(@)(@@) * وروى عن محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 74، ح 7 و 8 و 9، و ج 5، ك 2، ب 54، ح 14، و 16.(@)(@@) * وروى عن مفضل بن صالح، وروى عنه محمد.(@)(@@) التهذيب: ج 5، ح 780 (الاستبصار:(@)(@@) ج 2، ح 991).(@)(@@) * وروى عن موسى بن القاسم.(@)(@@) الكافي: ج 3، ك 1، ب 36، ح 3.(@)(@@) والتهذيب: ج 2، ح 1399.(@)(@@) وروى عنه سعد.(@)(@@) التهذيب: ج 3، ح 815.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 813 (الاستبصار:(@)(@@) ج 1، ح 672، وفيه أحمد بن محمد)، والتهذيب: ج 1، ح 1347، و ج 3، ح 884 (الاستبصار: ج 1، ح 1756).(@)(@@) * وروى عن يحيى بن إبراهيم.(@)(@@) الكافي: ج 6، ك 6، ب 48، ح 14.(@)(@@) * وروى عن البرقي.(@)(@@) التهذيب ج 2، ح 1082، و 1129، و ج 3، ح 710، و ج 4، ح 1046، و ج 5، ح 1693 و 1723، وروى عنه محمد.(@)(@@) التهذيب: ج 4، ح 969.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1048، و ج 3، ح 742، و ج 7، ح 851، و ج 10، ح 841. PageV02P263(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الروضة: ح 48.(@)(@@) * وروى عن الحجال. الكافي: ج 5، ك 3، ب 2، ح 2. والتهذيب: ج 2، ح 1580.(@)(@@) * وروى عن النوفلي، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 10، ح 1122.(@)(@@) * وروى عن الوشاء، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 5، ك 1، ب 24، ح 4.(@)(@@) * وروى عن بعض أصحابنا، عن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 2، ب 3، ح 4.(@)(@@) * وروى عن بعض أصحابنا، عن صالح بن حمزة، وروى عنه علي بن محمد بن عبد الله.(@)(@@) الكافي: ج 5، ك 1، ب 12، ح 6.(@)(@@) * وروى عن بعض أصحابنا مضمرة.(@)(@@) الكافي: ج 2، ك 2، ب 34، ح 3.(@)(@@) * وروى عن عدة من أصحابنا، عن علي بن أسباط.(@)(@@) الكافي: ج 6، ك 3، ب 16، ح 12.(@)(@@) (أحمد بن 
ms515	 أبي عبد الله) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 38، ح 5.(@)(@@) * وروى عن أبي أيوب المديني، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 39، ح 6.(@)(@@) * وروى عن أبي الخزرج، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 7، ك 4، ب 17، ح 2.(@)(@@) * وروى عن أبي الخزرج الأنصاري.(@)(@@) التهذيب: ج 6، ح 902.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 7، ح 9.(@)(@@) وروى عنه على بن محمد بن بندار.(@)(@@) الكافي: ج 5، ك 2، ب 3، ح 7.(@)(@@) * وروى عن أبي سليمان، وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 6، ب 43، ح 8.(@)(@@) * وروى عن أبي سليمان الحذاء، وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 6، ك 6، ب 91، ح 3.(@)(@@) * وروى عن أبي سليمان الحذاء الجبلي، وروى عنه عدة من أصحابنا. PageV02P264(@)(@@) الكافي: ج 6، ك 6، ب 112، ح 7.(@)(@@) * وروى عن أبي عبد الله أبيه.(@)(@@) الفقيه: ج 1، ح 978. والتهذيب: ج 2، ح 415، و ج 3، ح 295 (الاستبصار:(@)(@@) ج 1، ح 1725) والتهذيب: ج 3، ح 486 (الاستبصار: ج 1، ح 1885) ، والتهذيب: ج 3، ح 711، و ج 6، ح 258 (الاستبصار: ج 3، ح 5، وفيه، أبو عبد الله البرقي)، والتهذيب: ج 6، ح 339 و 388 و 881، و 889، ج 7، ح 193 و 333، و 749 و 986 و 1010، و 1021، و ج 9، ح 405 و 440 و 496.(@)(@@) و ج 10، ح 592.(@)(@@) وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 36، ح 3.(@)(@@) وروى عنه أحمد بن إدريس وسعد بن عبد الله ومحمد بن يحيى.(@)(@@) المشيخة: في طريقه إلى جعفر بن القاسم. وروى عنه أحمد بن عبد الله.(@)(@@) الكافي: ج 3، ك 4، ب 85، ح 20، و ج 5، ك 2، ب 5، ح 8. والمشيخة: في طريقه إلى كل ما كان فيه جاء نفر... وروى عنه أحمد بن محمد بن عبد الله وغيره.(@)(@@) الكافي: ج 3، ك 5، ب 1، ح 15، وروى عنه الحسن بن متيل الدقاق.(@)(@@) المشيخة: في طريقه إلى مفضل بن عمر والى النعمان الرازي.(@)(@@) وروى عنه سعد بن عبد الله المثنى.(@)(@@) المشيخة: في طريقه إلى حفص بن غياث والى أبي عبد الله الفراء.(@)(@@) وروى 
ms516	 عنه سعد بن عبد الله، ومحمد ابن يحيى، وأحمد بن إدريس. المشيخة: في طريقه إلى جعفر بن القاسم.(@)(@@) وروى عنه عبد الله بن جعفر الحميري. المشيخة: في طريقه إلى محمد ابن حكيم.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 11، ح 2، وب 31، ح 2، وب 33، ح 4، وب 38، ح 4، و ب 47، ح 14، وب 48، ح 23، وب 49، ح 15، وب 59، ح 11، و 12، وب 60، ح 8، وب 63، ح 4، وب 106، ح 13، و ب 111، ح 7، وب 128، ح 1، و ب 136، ح 6، وب 139، ح 11، و ب 142، ح 7، وب 148، ح 4 و ب 170، ح 7، و ج 4، ك 1، ب 3، ح 3، و ب 9، ح 2، وب 11، ح 3، وب 14، ح 2، و ب 17، ح 6 وب 27، ح 2، وب 36، ح 4، وب 40، ح 1 و 2، وب 42، ح 9، وك 2، ب 3، ح 2، وك 3، ب 40، ح 1، و PageV02P265(@)(@@) ب 48، ح 1، وب 116، ح 1، و ج 5، ك 2، ب 3، ح 13، وب 4، ح 13، وب 8، ح 4، وب 17، ح 2، وب 20، ح 9، وب 41، ح 1، وب 54، ح 5، وب 102، ح 6، و ب 108، ح 1، وب 121، ح 4، و 5، و ب 155، ح 2، وب 159، ح 17 و 48، و ك 3، ب 2، ح 1، وب 19، ح 6، وب 30، ح 2، وب 50، ح 3، وب 99، ح 3، و ب 139، ح 4، وب 146، ح 5، و ب 149، ح 1، وب 157، ح 5، و 6، و ب 168، ح 1 و 2، وب 169، ح 1 و 4، وب 190، ح 13، و ج 6، ك 1، ب 20، ح 1، وب 23، ح 9، وب 38، ح 2، و ك 3، ب 16، ح 7 و 11، وك 4، ب 13، ح 2، وك 6، ب 8، ح 5، وب 20، ح 1، و ب 25، ح 2، وب 33، ح 5، وب 41، ح 6، وب 47، ح 13، و 14، وب 76، ح 10، وب 82، ح 6، وب 83، ح 3، و ب 88، ح 4، وب 97، ح 9، وب 98، ح 1، وب 101، ح 3، وب 102، ح 10، وب 108، ح 1، وب 118، ح 1، و ب 123، ح 7، وب 132، ح 6، وك 7، ب 4، ح 5، وب 10، ح 3، وب 17، ح 6، وك 8، ب 9، ح 7، وب 26، ح 5، و ب 27، ح 10، وب 31، ح 6 و 7، و ب 32، ح 4، وب 35، ح 5، وب 38، ح 6، و 14، وب 45، ح 4، وب 52، ح 2 و 5، وب 59، ح 2، وك 9، ب 4، ح 5 و 6، و ب 5، ح 9 و ج 7، ك 1، ب 23، ح 28.(@)(@@) والتهذيب: ج 4، ح 307، و ج 5، ح 
ms517	 317، و ج 7، ح 1612، و 1623، و ج 8، ح 398، و 577، و 834، و ج 9، ح 263، و 422.(@)(@@) وروى عنه علي بن إبراهيم.(@)(@@) الكافي: ج 3، ك 1، ب 38، ح 7، و ج 6، ك 8، ب 66، ح 4.(@)(@@) وروى عنه علي بن الحسين.(@)(@@) التهذيب: ج 3، ح 243.(@)(@@) وروى عنه علي بن الحسين السعد آبادي.(@)(@@) المشيخة: في طريقه إلى بزيع المؤذن.(@)(@@) وروى عنه علي بن محمد.(@)(@@) الكافي: ج 4، ك 1، ب 40، ح 7، وك 2، ب 71، ح 1.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 5، ك 2، ب 16، ح 2، وب 20، ح 4، وب 59، ح 8، وب 67، ح 2 و ب 149، ح 8، وك 3، ب 13، ح 2، و ب 140، ح 5، و 7، و ج 6، ك 6، ب 43، ح 5، وب 67، ح 7، وب 83، ح 6، و PageV02P266(@)(@@) ج 7، ك 3، ب 63، ح 6.(@)(@@) وروى عنه علي بن محمد بن بندار، وغيره.(@)(@@) الكافي: ج 4، ك 1، ب 21، ح 7، و ج 6، ك 6، ب 50، ح 11، وب 84، ح 7.(@)(@@) وروى عنه علي بن محمد بن عبد الله.(@)(@@) الكافي: ج 1، ك 3، ب 26، ح 1، و ج 4، ك 1، ب 11، ح 5، وب 32، ح 3، و ب 38، ح 11، وك 3، ب 215، ح 2.(@)(@@) وروى عنه علي بن محمد بن عبد الله القمي.(@)(@@) الكافي: ج 5، ك 2، ب 7، ح 7.(@)(@@) وروى عنه على ماجيلويه.(@)(@@) المشيخة: في طريقه إلى الحارث بن المغيرة النصري.(@)(@@) وروى عنه محمد بن أبي القاسم.(@)(@@) المشيخة: في طريقه إلى داود بن إسحاق وإلى عبد الملك بن أعين، وإلى محمد بن عمران العجلي.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 32، (الاستبصار ج 1، ح 265)، والتهذيب: ج 10، ح 939.(@)(@@) وروى عنه محمد بن علي.(@)(@@) التهذيب: ج 3، ح 311.(@)(@@) وروى عنه محمد بن يحيى، وسعد بن عبد الله وأحمد بن إدريس.(@)(@@) المشيخة: في طريقه إلى جعفر بن القاسم.(@)(@@) * وروى عن أبي عبد الله الجاموراني، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 10، ح 4.(@)(@@) * وروى عن أبي عمران الأرمني، وروى عنه أحمد بن عبد الله.(@)(@@) الكافي ج 4، ك 3، ب 72، ح 10.(@)(@@) * وروى عن أبي هاشم، وروى عنه محمد بن الحسن الصفار.(@)(@@) الكافي: ج 1، ك 4، ب 126، ح 2.(@)(@@) * وروى عن ابن أبي نجران، وروى عنه عدة من أصحابنا. 
ms518	(@)(@@) الكافي: ج 2، ك 1، ب 33، ح 5.(@)(@@) * وروى عن ابن العرزمي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 7، ب 4، ح 6.(@)(@@) * وروى عن ابن فضال.(@)(@@) الكافي: ج 4، ك 1، ب 21، ذيل ح 3، والتهذيب: ج 6، ح 882، و ج 7، ح 332 (الاستبصار: ج 3، ح 368).(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 35، ح 3، وب 53، ح 8، وب 59، ح 10، وب 68، ح 27، و PageV02P267(@)(@@) ب 139، ح 15، ب 203 ح 19، و ج 4، ك 3، ب 81، ح 8، و ج 5، ك 2، ب 102، ح 7، و ج 6، ك 4، ب 14، ح 2، و 3 و 4، وك 8، ب 38، ح 9، وب 41، ح 11، وب 59، ح 2. والتهذيب: ج 9، ح 259، و 260، و 261. وروى عنه علي ابن محمد بن بندار.(@)(@@) التهذيب: ج 7، ح 1046.(@)(@@) وروى عنه علي بن محمد بن عبد الله القمي.(@)(@@) الكافي: ج 5، ك 1، ب 7، ح 8.(@)(@@) * وروى عن ابن محبوب، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 142، ح 8، و ج 5، ك 3، ب 143، ح 1.(@)(@@) * وروى عن أبان، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 10، ح 394، (الاستبصار:(@)(@@) ج 4، ح 907 وفيه أحمد بن محمد).(@)(@@) * وروى عن أبان بن عبد الملك، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 78، ح 5.(@)(@@) * وروى إبراهيم بن محمد الثقفي.(@)(@@) التهذيب: ج 6، ح 901.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 58، ح 9.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 5، ك 2، ب 3، ح 3.(@)(@@) * وروى عن إبراهيم بن محمد الهمداني، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 3، ب 24، ح 3.(@)(@@) والتهذيب: ج 7، ح 1584.(@)(@@) * وروى عن أحمد بن عبد الرحيم أبي الصخر، وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 4، ك 2، ب 83، ح 5.(@)(@@) * وروى عن أحمد بن عبدوس بن إبراهيم، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 47، ح 4.(@)(@@) * وروى عن أحمد بن محمد بن أبي نصر، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 48، ح 5، و ج 6، ك 4، ب 14، ح 1، ب 14، ح 1، وك 6، ب 100، ح 3، وك 8، ب 26، ح 4، و ب 41، ح 9. والتهذيب: ج 9، ح 258.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 6، ك 
ms519	 8، ب 8، ح 5.(@)(@@) * وروى عن أحمد بن موسى، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 3، ب 122، ح 9 PageV02P268(@)(@@) والتهذيب: ج 5، ح 331.(@)(@@) * وروى عن إسحاق بن إبراهيم الكندي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 7، ك 4، ب 56، ح 9.(@)(@@) * وروى عن إسماعيل بن مهران.(@)(@@) الكافي: ج 6، ك 6، ب 32، ح 5.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 47، ح 13، و ب 69، ح 12، وب 136، ح 5، وك 4، ب 24، ح 11، كذا في نسخة وفي بعض النسخ أحمد بن محمد أبي عبد الله، و ج 4، ك 3، ب 47 ح 4، و ج 5، ك 2، ب 13، ح 2، وك 3، ب 168، ح 5.(@)(@@) * وروى عن جعفر بن عيسى، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 9، ح 8.(@)(@@) * وروى عن جعفر بن محمد، وروى عنه علي بن محمد بن بندار.(@)(@@) التهذيب: ج 7، ح 1046.(@)(@@) * وروى عن الجهم بن الحكم.(@)(@@) التهذيب: ج 6، ح 899.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 2، ب 2، ح 2.(@)(@@) * وروى عن الجهم بن الحكم المدائني وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 4، ك 1، ب 5، ح 2.(@)(@@) * وروى عن الحسن، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 8، ح 335، (الاستبصار:(@)(@@) ج 3، ح 1096).(@)(@@) * وروى عن الحسن بن الحسين، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 126، ح 4.(@)(@@) * وروى عن الحسن بن الحسين اللؤلئي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 4، ك 3، ب 47، ح 7.(@)(@@) * وروى عن الحسن بن زبرقان الأنصاري أبي الخزرج، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 134، ح 4، وك 8، ب 17، ح 7.(@)(@@) * وروى عن الحسن بن ظريف ، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 139، ح 13.(@)(@@) * وروى عن الحسن بن علي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 4، ب 10، ح 2، وك 6، ب 121، ح 1. والتهذيب: ج 9، ح 52 (الاستبصار: ج 4، ح 231). وروى عنه محمد بن أحمد بن يحيى. PageV02P269(@)(@@) التهذيب: ج 9، ح 86، (الاستبصار: ج 4، ح 231، وفيه عدة من أصحابنا عن أحمد ابن أبي عبد الله).(@)(@@) * وروى عن الحسن بن علي بن يقطين، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 
ms520	 4، ك 1، ب 20، ح 3، و ج 6، ك 8، ب 63، ح 4.(@)(@@) * وروى عن الحسن بن محبوب، وروى عنه سعد بن عبد الله. المشيخة:(@)(@@) في طريقه إلى يونس بن عمار.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 20، ح 1، و ج 3، ك 5، ب 1، ح 14.(@)(@@) وروى عنه علي بن الحسين.(@)(@@) التهذيب: ج 3، ح 232.(@)(@@) وروى عنه علي بن محمد.(@)(@@) الكافي: ج 4، ك 1، ب 28، ح 2.(@)(@@) * وروى عن الحسن بن يوسف، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 3، ب 125، ح 1.(@)(@@) * وروى عن الحسين بن علي العقيلي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 8، ب 15، ح 4.(@)(@@) * وروى عن الحسين بن منذر، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 98، ح 4.(@)(@@) * وروى عن داود بن أبي داود، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 6، ك 6، ب 114، ح 6.(@)(@@) * وروى عن داود بن إسحاق أبو سليمان الحذاء، وروى عنه عدة من أصحابنا.(@)(@@) الكافي ج 6، ك 8، ب 17، ح 8، وب 60، ح 3.(@)(@@) * وروى عن داود بن إسحاق الحذاء، وروى عنه أحمد بن إدريس، المشيخة: في طريقه إلى محمد بن الفيض التميمي.(@)(@@) * وروى عن زكريا المؤمن، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 4، ك 1، ب 24، ح 1.(@)(@@) * وروى عن زياد القندي، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 6، كذا في هذه الطبعة، والطبعة القديمة، ولكن في نسخة المرآة والطبعتين الحديثتين: عدة من أصحابنا عن أحمد بن أبي عبد الله عن يعقوب بن يزيد، عن زياد القندي.(@)(@@) وروى عنه علي بن إبراهيم.(@)(@@) التهذيب: ج 1، ح 304. PageV02P270(@)(@@) * وروى عن سعدان، وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 2، ك 1، ب 53، ح 7.(@)(@@) * وروى عن شريف بن سابق.(@)(@@) الكافي: ج 5، ك 2، ب 4، ح 5. والتهذيب:(@)(@@) ج 6، ح 896، و 1046 (الاستبصار: ج 3، ح 216)، والتهذيب ج 7، ح 6.(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) الكافي: ج 5، ك 2، ب 4، ح 2.(@)(@@) وروى عنه علي بن محمد بن بندار.(@)(@@) الكافي: ج 5، ك 2، ب 38، ح 2، وب 53، ح 8.(@)(@@) * وروى عن صفوان بن يحيى، وروى عن عدة من أصحابنا.(@)(@@) الكافي ج 6، ك 7، ب 68، ح 7.(@)(@@) * وروى عن عبد 