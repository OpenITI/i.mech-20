ms5533	 4، ك 3، ب 7، ح 14، و ج 5، ك 1، ب 15، ح 5. والتهذيب:(@)(@@) ج 1، ح 863 (الاستبصار: ج 1، ح 735).(@)(@@) وروى عنه إبراهيم بن هاشم. PageV17P425(@)(@@) مشيخة الفقيه: في طريقه إلى إسماعيل ابن أبي فديك.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 14، ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 2، ب 13، ح 5، و ج 2، ك 1، ب 99، ح 20، وب 149، ح 1.(@)(@@) وروى عنه إدريس الحارثي.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 20.(@)(@@) وروى عنه بكر بن صالح.(@)(@@) الكافي: ج 1، ك 4، ب 34، ح 2.(@)(@@) وروى عنه عبد الله بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 55، ح 3، و ب 108، ح 30.(@)(@@) وروى عنه محمد بن جمهور.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 37.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 7، ح 1464 (الاستبصار:(@)(@@) ج 3، ح 810).(@)(@@) وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) التهذيب: ج 3، ح 218 (الاستبصار:(@)(@@) ج 1، ح 1802، وفيه محمد بن الحسين فقط).(@)(@@) وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 5، ك 1، ب 32، ح 5.(@)(@@) والتهذيب: ج 6، ح 369.(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 14، ح 1، و ج 2، ك 1، ب 155، ح 1.(@)(@@) وروى عنه الفهري.(@)(@@) التهذيب: ج 5، ح 1530.(@)(@@) * وروى عن المفضل بن عمر الجعفي، وروى عنه محمد بن الحسين ابن أبي الخطاب.(@)(@@) التهذيب: ج 6، ح 51.(@)(@@) * وروى عن المفضل بن عمر الجعفي الكوفي وهو مولى، وروى أحمد بن أبي عبد الله عن أبيه، عنه.(@)(@@) مشيخة الفقيه: في طريقه إلى المفضل بن عمر.(@)(@@) * وروى عن المفضل الجعفي، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 183، ح 1.(@)(@@) * وروى عن مقرن.(@)(@@) الكافي: ج 2، ك 1، ب 45، ذيل ح 1.(@)(@@) * وروى عن منصور الصيقل، وروى عنه أبو عبد الله البرقي.(@)(@@) التهذيب: ج 7، ح 1211 (الاستبصار:(@)(@@) ج 3، ح 624). PageV17P426(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 69، ح 4.(@)(@@) * وروى عن موسى بن بكر، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 38، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 68، ح 3.(@)(@@) * وروى عن نصر الخثعمي، وروى عنه أحمد بن محمد بن عيسى. 
ms5534	(@)(@@) الكافي: ج 1، ك 2، ب 21، ح 6.(@)(@@) * وروى عن نصير أبي الحكم الخثعمي، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 104، ح 1.(@)(@@) * وروى عن نضر بن قرواش، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 125، ح 5.(@)(@@) * وروى عن النعمان الرازي، وروى عنه محمد بن سالم.(@)(@@) مشيخة الفقيه: في طريقه إلى النعمان الرازي.(@)(@@) * وروى عن الوليد بن العلاء، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 106، ح 7.(@)(@@) * وروى عن هارون بن خارجة، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 84، ح 4.(@)(@@) * وروى عن يحيى بن إبراهيم بن مهاجر، وروى عن أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 30، ح 8.(@)(@@) * وروى عن يعقوب بن شعيب، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 28، و 29، و 30.(@)(@@) * وروى عن يعقوب السراج، وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 71، ح 11.(@)(@@) * وروى عن يوسف بن إبراهيم الطاطري، وروى عنه إبراهيم بن هاشم.(@)(@@) مشيخة الفقيه: في طريقه إلى يوسف الطاطري.(@)(@@) * وروى عن يوسف بن أبي يعقوب بياع الأرز، وروى عنه علي بن النعمان.(@)(@@) الكافي: ج 2، ك 1، ب 191، ح 10.(@)(@@) * وروى عن يوسف بن عمران بن ميثم، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 66، ح 13.(@)(@@) * وروى عن يوسف بن يعقوب، أخي يونس، وروى عنه محمد بن عيسى بن PageV17P427(@)(@@) عبيد.(@)(@@) مشيخة الفقيه: في طريقه إلى يوسف بن يعقوب.(@)(@@) * وروى عن يونس بن رباط، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 106، ح 16.(@)(@@) * وروى عن يونس بن ظبيان، وروى عنه محمد بن جعفر بن إسماعيل.(@)(@@) التهذيب: ج 6، ح 113.(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 4، ح 389 (الاستبصار:(@)(@@) ج 2، ح 194).(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 48، ح 2، و ب 130، ح 15.(@)(@@) * وروى عن غلام أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 3، ب 7، ح 1.(@)(@@) * وروى عن بعض أصحابنا، عن أبي عبد الله عليه السلام، وروى عنه حمزة ابن يعلي.(@)(@@) التهذيب: 
ms5535	 ج 1، ح 1114 (الاستبصار:(@)(@@) ج 1، ح 78).(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله عليه السلام، وروى عنه محمد البرقي.(@)(@@) الكافي: ج 5، ك 3، ب 4، ح 6.(@)(@@) * وروى عن رجل، عن أبي عبد الله عليه السلام، وروى عنه أيوب بن نوح.(@)(@@) الكافي: ج 5، ك 3، ب 21، ح 2.(@)(@@) * وروى مرسلا، وروى عنه الحسين ابن سعيد.(@)(@@) الكافي: ج 1، ك 4، ب 121، ح 11، و ب 122، ح 12.(@)(@@) * وروى مرسلا عن أبي جعفر عليه السلام، وروى عنه عبد الرحمن بن حماد.(@)(@@) الكافي: ج 5، ك 2، ب 54، ح 13.(@)(@@) * وروى مرسلا، عن علي بن الحسين عليهما السلام، وروى أحمد بن محمد بن خالد، عن بعض أصحابنا، عنه.(@)(@@) الكافي: ج 6، ك 1، ب 11، ح 1.(@)(@@) * وروى مرفوعا عن أبي عبد الله عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الفقيه: ج 1، ح 1553.(@)(@@) * وروى مرفوعا مضمرة، وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 1، ك 2، ب 5، ح 6. PageV17P428(@)(@@) * وروى مضمرة، وروى عنه الحسن ابن علي بن عثمان، ومحمد بن عبد الله وموسى بن عمر.(@)(@@) الكافي: ج 1، ك 3، ب 15، ح 3.(@)(@@) * وروى عمن أخبره عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 23.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 1452، و ج 10، ح 1071 (الاستبصار: ج 4، ح 1119، وفيه ابن سنان فقط).(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الروضة: ح 584.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 886.(@)(@@) وروى محمد بن يحيى، عن أحمد، عنه.(@)(@@) الكافي: ج 7، ك 4، ب 41، ح 3.(@)(@@) * وروى عمن حدثه، عن أبي عبد الله عليه السلام، وروى عنه علي ابن أسباط.(@)(@@) التهذيب: ج 6، ح 138.(@)(@@) * وروى عمن حدثه، عن علي بن الحسين عليهما السلام، وروى أحمد بن محمد بن خالد، عن بعض أصحابنا، عنه.(@)(@@) التهذيب: ج 7، ح 1754.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى عنه الحسن ابن الحسين.(@)(@@) الكافي: ج 6، ك 6، ب 126، ح 4.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 7، ب 10، ح 4.(@)(@@) * وروى عمن رواه عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 7، ك 
ms5536	 7، ب 9، ح 2. والتهذيب:(@)(@@) ج 8، ح 1044.(@)(@@) * وروى الحسين بن سعيد، عن محمد ابن سنان أو فضالة، عن ابن مسكان.(@)(@@) الكافي: ج 3، ك 4، ب 74، ح 3.(@)(@@) محمد بن سهل * روى عن الرضا عليه السلام.(@)(@@) الفقيه: ج 1، ح 1205.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 82، ح 4.(@)(@@) والتهذيب: ج 3، ح 812.(@)(@@) * وروى عن أبيه.(@)(@@) الفقيه: ج 1، ح 1172، و ج 3، ح 696، و PageV17P429(@)(@@) ج 4، ح 221.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 2، ب 54، ح 2، و ج 5، ك 2، ب 127، ح 9، و 10، وب 148، ح 2. والتهذيب: ج 1، ح 298 (الاستبصار: ج 1، ح 339)، و ج 3، ح 565، و 601، و ج 7، ح 869، و 921.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 855، و 1141 (الاستبصار: ج 1، ح 339، وفيه أحمد بن محمد فقط)، و ج 4، ح 707 (الاستبصار:(@)(@@) ج 2، ح 344)، و ج 6، ح 403، و ج 9، ح 574 (الاستبصار: ج 4، ح 388).(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 3، ح 511 (الاستبصار:(@)(@@) ج 1، ح 813).(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 259، و 302، و 575 (الاستبصار: ج 2، ح 870)، و 580 (الاستبصار: ج 2، ح 875)، و 581 (الاستبصار: ج 2، ح 876)، و 664 (الاستبصار: ج 2، ح 915)، و 985 (الاستبصار: ج 2، ح 1083).(@)(@@) * وروى عن آدم بن علي، وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 5، و 20 (الاستبصار:(@)(@@) ج 2، ح 469، و 1135)، و 1432 (الاستبصار: ج 2، ح 469، و 1135).(@)(@@) * وروى عن إبراهيم بن أبي البلاد، وروى عنه أبو القاسم الكوفي.(@)(@@) الكافي: ج 1، ك 4، ب 69، ح 1.(@)(@@) * وروى عن إدريس بن زيد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 2، ب 59، ح 1.(@)(@@) * وروى عن زكريا بن آدم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 23، ح 2، و ج 5، ك 2، ب 93، ح 8. والتهذيب: ج 8، ح 246.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 18 (الاستبصار: ج 1، ح 272، وفيه أحمد بن محمد فقط)، و ج 6، ح 296، و ج 7، ح 327، و 328، و 231 (الاستبصار: ج 3، ح 282)، و ج 10، ح 34 (الاستبصار: ج 4، ح 771)، وفيه أحمد بن محمد فقط).(@)(@@) * وروى 
ms5537	 عن علي بن إدريس، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 2، ب 59، ح 1. PageV17P430(@)(@@) * وروى عن محمد بن منصور الكوفي، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1198 (الاستبصار:(@)(@@) ج 3، ح 599).(@)(@@) (محمد بن شعيب) * روى عن أبي جعفر المدائني، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 4، ك 1، ب 34، ح 14.(@)(@@) * وروى عن أبي كهمس، وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 7، ك 1، ب 36، ح 5. والفقيه:(@)(@@) ج 4، ح 627. والتهذيب: ج 1، ح 842، و 898.(@)(@@) * وروى عن الحسين بن الحسن، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 4، ك 1، ب 43، ح 3.(@)(@@) * وروى عن عمران بن إسحاق الزعفراني، وروى عنه محمد بن عيسى ابن عبيد. الكافي: ج 1، ك 4، ب 94، ح 2.(@)(@@) * وروى عن النضر بن شعيب، وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 6، ك 1، ب 4، ح 6، و 7.(@)(@@) * وروى مضمرة، وروى عنه محمد بن عبد الحميد.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 24.(@)(@@) والفقيه: ج 3، ح 1270.(@)(@@) (محمد بن عبد الجبار) * روى عن أبي محمد عليه السلام، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 10.(@)(@@) والتهذيب: ج 2، ح 812 (الاستبصار:(@)(@@) ج 1، ح 1462).(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 810 (الاستبصار:(@)(@@) ج 1، ح 1453).(@)(@@) * وروى عن العسكري عليه السلام، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 664 (الاستبصار:(@)(@@) ج 4، ح 433).(@)(@@) * وروى عن أبي جميلة، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 181.(@)(@@) * وروى عن أبي عبد الله البرقي، وروى عنه أحمد.(@)(@@) الكافي: ج 1، ك 4، ب 59، ح 7.(@)(@@) * وروى عن أبي القاسم، وروى عنه PageV17P431(@)(@@) محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 6، ح 1194 (الاستبصار:(@)(@@) ج 3، ح 230).(@)(@@) * وروى عن أبي القاسم الكوفي، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 69، ح 1.(@)(@@) * وروى عن أبي محمد الأنصاري، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 3، ك 3، ب 12، ح 1.(@)(@@) * وروى عن أبي محمد الدهلي، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى منصور الصيقل.(@)(@@) * وروى عن أبي محمد الهذلي، وروى عنه أبو 
ms5538	 علي الأشعري.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 3.(@)(@@) * وروى عن ابن أبي عمير، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 7، ك 1، ب 19، ح 1.(@)(@@) * وروى عن ابن أبي نجران، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 2، ب 1، ح 6، وك 3، ب 1، ح 9، وك 4، ب 4، ح 10، و ج 5، ك 2، ب 31، ح 2.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 6، ح 916.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 6، ح 1148.(@)(@@) * وروى عن ابن فضال، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 1، ك 4، ب 52، ح 5، و ج 2، ك 1، ب 20، ح 2، وب 54، ح 7، و ب 56، ح 15، وب 58، ح 14، وب 65، ح 8، وب 66، ح 14، وب 75، ح 6، و 13، وب 99، ح 3، وب 106، ح 27، و ب 107، ح 17، وب 111، ح 11، و 16، و 17، وب 113، ح 3، وب 121، ح 2 و 9، وب 124، ح 4، و 8، وب 145، ح 3، و 7، وب 191، ح 7، وك 2، ب 32، ح 2، وك 3، ب 3، ح 1، و ج 3، ك 3، ب 30، ح 1، وب 43، ح 6، وب 82، ح 14، و ب 95، ح 21، و ج 4، ك 3، ب 201، ح 12، و ج 6، ك 4، ب 2، ح 10، وب 6، ح 7، وك 6، ب 28، ح 5، وب 47، ح 4، وب 97، ح 18، وب 102، ح 6، وك 7، ب 1، ح 2، وب 30، ح 5، وك 8، ب 5، ح 10، وب 7، ح 1، وب 8، ح 4، و ب 18، ح 4، وب 31، ح 4، وب 58، ح 4، وب 59، ح 1، وك 9، ب 2، ح 11، و ج 7، ك 6، ب 2، ح 2. والروضة: PageV17P432(@)(@@) ح 100، و 252، و 316، و 495.(@)(@@) والتهذيب: ج 1، ح 998، و 1483، و ج 5، ح 1575، و ج 6، ح 512، و ج 9، ح 147.(@)(@@) وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 13، ح 3.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 6، ح 271.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 2، ب 20، ح 8.(@)(@@) * وروى عن ابن محبوب، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 32، ح 2، وب 66، ح 15.(@)(@@) * وروى عن أحمد بن النضر، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 47، ح 23، و ج 5، ك 2، ب 34، ح 3، وب 40، ح 2، و وب 62، ح 1، وب 69، ح 1. والتهذيب:(@)(@@) ج 6، ح 1010 (الاستبصار: ج 3، ح 192، وفيه ابن أبي علي الأشعري من غلط المطبعة، والصحيح 
ms5539	 ما أثبتناه)، و 1075، و ج 7، ح 58، و 697، و ج 10، ح 362.(@)(@@) * وروى عن إسحاق، وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 5، ح 1284 (الاستبصار:(@)(@@) ج 2، ح 715).(@)(@@) * وروى عن إسماعيل بن سهل، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 3، ب 65، ح 2، و ج 6، ك 3، ب 16، ح 13. والتهذيب: ج 7، ح 1569.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1523.(@)(@@) * وروى عن الحسن بن الحسين، وروى عنه أحمد بن إدريس، ومحمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 71، ح 9.(@)(@@) * وروى عن الحسن بن الحسين اللؤلؤي، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 5.(@)(@@) * وروى عن الحسن بن علي، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 99، ح 19، و ج 6، ك 2، ب 73، ح 28. والروضة: ح 174، و 575.(@)(@@) وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 2، ب 21، ح 5.(@)(@@) وروى عنه محمد بن علي بن محبوب. PageV17P433(@)(@@) التهذيب: ج 2، ح 1571.(@)(@@) * وروى عن الحسن بن علي بن فضال، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 82، ح 10.(@)(@@) والروضة: ح 80.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 2، ح 62 (الاستبصار: ج 1، ح 891).(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى إبراهيم ابن أبي يحيى المدائني.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 26 (الاستبصار: ج 1، ح 263)، و ج 10، ح 1037.(@)(@@) * وروى عن سيف بن عميرة، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 8، ح 572 (الاستبصار:(@)(@@) ج 3، ح 1285).(@)(@@) * وروى عن صفوان: رواية محمد ابن عبد الجبار، عن صفوان في ثلاثمائة وسبعة موارد، وتقدم في صفوان ولا نطيل بذكرها، والراوي عنه في جميع ذلك أحمد ابن إدريس أبو علي الأشعري، إلا في مورد واحد وهو كما يلي:(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 5، ح 1481 (الاستبصار:(@)(@@) ج 2، ح 1177).(@)(@@) * وروى عن صفوان بن يحيى.(@)(@@) روايته عن صفوان بن يحيى في ثلاثمائة وأربعة موارد، وتقدم في صفوان بن يحيى، والراوي عنه في جميع ما تقدم أبو علي الأشعري أحمد 
ms5540	 بن إدريس، إلا في موارد نذكرها هنا:(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 4، ح 229 (الاستبصار:(@)(@@) ج 2، ح 150)، و 230 (الاستبصار:(@)(@@) ج 2، ح 151)، و 360.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1099 (الاستبصار:(@)(@@) ج 3، ح 528.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى أبان بن عثمان. والتهذيب: ج 6، ح 129.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 6، ح 293، و ج 9، ح 564.(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 8، ح 1178 (الاستبصار:(@)(@@) ج 4، ح 162).(@)(@@) * وروى عن العباس، وروى عنه محمد بن أحمد بن يحيى. PageV17P434(@)(@@) التهذيب: ج 9، ح 938 (الاستبصار:(@)(@@) ج 4، ح 475).(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 5، ح 862 (الاستبصار:(@)(@@) ج 2، ح 805)، و ج 7، ح 508 (الاستبصار: ج 3، ح 344).(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 7، ح 1889.(@)(@@) * وروى عن العباس بن معروف، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 937 (الاستبصار:(@)(@@) ج 4، ح 474).(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 7، ح 1170 (الاستبصار:(@)(@@) ج 3، ح 574، وفيه محمد بن الحسن الصفار.(@)(@@) * وروى عن عبد الرحمن بن أبي نجران، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 163، ح 3.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 4، ح 646.(@)(@@) * وروى عن عبد الرحمان بن حماد.(@)(@@) التهذيب: ج 5، ح 1762.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 2، ح 420.(@)(@@) * وروى عن عبد الله بن جبلة، وروى عنه عبد الله بن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى عبد الله بن جبلة.(@)(@@) * وروى عن عبد الله بن الصلت أبي طالب، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 2، ح 91.(@)(@@) * وروى عن عبد الله بن محمد، وروى عنه أبو علي الأشعري.(@)(@@) الروضة: ح 457.(@)(@@) * وروى عن عبد الله الحجال، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 3، ك 3، ب 63، ح 4.(@)(@@) والتهذيب: ج 1، ح 914.(@)(@@) * وروى عن عبيد الله الدهقان، وروى عنه أبو علي الأشعري.(@)(@@) الكافي، ج 6، ك 6، ب 80، ح 2.(@)(@@) * وروى عن علي بن إسحاق، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 6، ك 