ms261	 ضيعته فلامني ، فإن PageV02P507 لامني أحد من أهله ، قال : لو قضى أو قدر أن يكون كان .(@)(@@) 919 - حدثنا موسى بن سهل أبو عمران ، قال : حدثنا أبو توبة الربيع بن نافع ، قال : حدثنا محمد بن مهاجر ، عن عروة بن رويم ، عن أبي خالد الحراشي أو الحرشي ، عن أنس بن مالك ، عن رسول الله [ صلى الله عليه وسلم ] قال : الإيمان يمان إلى لخم وجذام .(@)(@@) 920 - حدثنا إسحاق بن سيار النصيبي ، قال : حدثنا الضحاك بن مخلد ، عن ثور ، عن عثمان أبي خالد عن أبي الأشعث الصنعاني ، عن أوس ابن أوس ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من غسل واغتسل وغدا وابتكر ودنا واقترب وأنصت ، كان له بكل خطوة صيام سنة وقيامها .(@)(@@) 921 - حدثني سعيد بن عمرو السكوني ، قال : حدثنا بقية بن الوليد ، قال : أخبرني ثور بن يزيد أبو خالد الحميري [ إلخ ] .(@)(@@) 922 - أخبرني أحمد بن شعيب ، قال : أنبأ [ سليمان ] بن سلم ، قال : أنبأ النضر بن [ شميل ] ، قال : أنبأ عوف ، عن أبي المهاجر ، عن أبي خالد ، عن رفيع أبي العالية ، قال : قال أبو ذر : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : إن أول من يبدل سنتي رجل من بني أمية .(@)(@@) 923 - حدثنا أبو عبد الله محمد ( 1 / 164 ) بن معمر البحراني ، قال : حدثنا روح بن عبادة ، قال : حدثنا حماد بن سلمة ، قال : حدثنا يحيى بن PageV02P508 سعيد ، والزبير أبو خالد ، عن سعيد بن أبي سعيد المقبري ، عن [ أبي ] قتادة ، أن رجلا أتى النبي [ صلى الله عليه وسلم ] ، فقال : أرأيت إن قتلت في سبيل الله الحديث .(@)(@@) 924 - حدثنا يزيد بن عبد الصمد ، قال : حدثنا عبد الرحمن بن يحيى ، قال : حدثنا أبو خالد زياد بن عبد الله الصائغ ، عن مكحول ، عن الزهري ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من قال لا إله إلا الله الحليم الكريم ، سبحان الله رب السماوات السبع ورب العرش العظيم ، ثلاث مرات كان مثل من أدرك ليلة القدر .(@)(@@) 925 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا [ علي بن 
ms262	 عياش ] ، قال : حدثنا أبو غسان محمد بن مطرف ، قال : ثنا يزيد أبو خالد ، عن سلمة بن الأكوع ، أن رجلا جاء إلى النبي [ صلى الله عليه وسلم ] ، فقال : يا رسول الله ! إن أبي أو أخي مات وترك دينارين ، فقال النبي [ صلى الله عليه وسلم ] : كيتان .(@)(@@) 926 - أخبرني أحمد بن شعيب ، قال : أنبأ الحسن بن إسماعيل بن سليمان ، قال أنبا عبد السلام بن حرب ، عن يزيد أبي خالد الدالاني ، عن أبي العلاء ، عن حميد بن عبد الرحمن ، عن رجل من أصحاب النبي [ صلى الله عليه وسلم ] ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إذا دعاك الداعيان فأجب أقربهما بابا فإن أقربهما بابا أقربهما جوارا ، وإذا سبق أحدهما فأجب الذي سبق . PageV02P509(@)(@@) 927 - حدثنا يزيد بن سنان ، قال : حدثنا أبو كامل ، قال : حدثنا يزيد أبو خالد ، قال : حدثنا عثمان بن عبد الملك ، قال : رأيت عبد الله بن عباس وعبد الله بن عياش ، وعبد الله بن جعفر ذي الجناحين يخضبون رؤسهم بالحناء ، ولحاهم بالحناء .(@)(@@) 928 - حدثني محمد بن خزيمة البصري ، قال : حدثنا عصمة بن سليمان الخزاز ، قال : ( ثنا ) خلف بن خليفة عن أبي هاشم الرماني ، عن إدريس أبي خالد ، عن أم أوس البهزية ، قالت : أسليت سمنا لي وجعلته في عكة وأهديته إلى رسول الله [ صلى الله عليه وسلم ] فقبله ، وترك في العكة قليلا ، ثم نفخ فيه ، ودعا فيه بالبركة ، وقال : اذهبوا فردوا عليها عكتها ، قال : فردوها علي وهي مملوءة سمنا .(@)(@@) 929 - حدثني علي بن عبد العزيز ، قال : حدثنا معلى بن أسد ، قال : حدثنا أيوب بن عبد الله القرشي أبو خالد ، قال : رأيت الحسن بن أبي الحسن قد توضأ وصلى الظهر وخرج ، فاستقبله قوم من أهل خراسان ، فقالوا له : اشتبه علينا الوضوء فنحب أن ترشدنا ، فقال : قد توضأت للظهر ، ولكني سأعيد وضوئي ، فنزل عن دابته ، فدعا جارية له يقال لها : مليحة ، فقال : يا جارية ! أئتينا بتلك القلة فجيء بكوز ماء فصب في تور له ، فغسل يديه ثلاثا ، وتمضمض ثلاث مرات ، واستنشق ثلاث مرات ، ثم غسل 
ms263	 وجهه ثلاث مرات PageV02P510 وغسل ذراعيه إلى المرفقين ثلاث مرات ، ومسح برأسه واحدة ومسح أذنيه ، وخلل لحيته ، وغسل رجليه إلى الكعبين ، ثم قال : أخبرني أنس بن مالك ، أن هذا وضوء رسول الله [ صلى الله عليه وسلم ] .(@)(@@) 930 - وروى إبراهيم بن حمزة ، قال : حدثنا أيوب بن أبي خالد ، واسم أبي خالد يزيد بن أبي حكيم ، عن عمارة بن غزية ، عن عبد الرحمن بن هرمز الأعرج عن أبي هريرة قال : قال النبي [ صلى الله عليه وسلم ] : بينما رجل يمشي في حلة أعجبته يتجلجل به [ في ] الأرض إلى يوم القيامة . PageV02P511(@)(@@)(@@)(@@) ||| ( من كنيته أبو خلدة ، [ وأبو خليد ، وأبو خليفة ، وأبو الخليل ] )(@)(@@)(@@)(@@) $ * أبو خلدة حنظلة سمع من : علي بن أبي طالب .(@)(@@)(@@)(@@) $ * وأبو خلدة خالد بن دينار .(@)(@@)(@@)(@@) $ * وأبو خليد عتبة بن حماد الدمشقي .(@)(@@)(@@)(@@) $ * ( 1 / 165 ) وأبو خليفة حجاج بن غياث(@)(@@)(@@)(@@) $ * وأبو الخليل عبد السلام ، روى عنه : زيد بن حباب .(@)(@@)(@@)(@@) $ * وأبو الخليل صالح بن أبي مريم .(@)(@@)(@@)(@@) $ * وأبو الخليل عبد الله بن الخليل ، يحدث عن : زيد بن أرقم .(@)(@@)(@@)(@@) $ * وأبو الخليل بزيع بن حسان ، يروي عنه : ابن المصفى .(@)(@@)(@@)(@@) $ * وأبو خلاد محمد بن وراد الحميري ، روى عنه : معاذ بن رفاعة ، وسمعت من يقول : [ يزيع ] أبو الخليل روى عنه : عبد الرحمن بن المبارك ، ويحدث بزيع ، عن هشام بن عروة .(@)(@@) 931 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن الأزهر ، قال : حدثنا حباب ، عن جويرية بن [ بشير الهجيمي ] ، قال : حدثنا حنظلة أبو خلدة ، قال : سمعت عليا يخطب الناس يذكر عثمان في خطبته ، فقال : ألا إن الناس يزعمون أني قتلت عثمان ، ولا والله الذي لا إله إلا هو ما قتلته ، ولا أومأت على قتله [ إلخ ] . PageV02P512(@)(@@) 932 - قال : وأخبرني أحمد بن شعيب ، قال : أنبا عبيد الله بن سعيد ، قال : حدثنا أبو سعيد مولى بني هاشم ، قال : أنبأ خالد بن دينار أبو خلدة ، قال : سمعت أنس بن مالك ، قال : كان رسول الله [ صلى الله عليه وسلم ] إذا كان الحر أبرد بالصلاة ، وإذا كان البرد عجل .(@)(@@) [ قال : و ] حدثنا عمرو بن علي ، قال : حدثنا عبد الرحمن بن 
ms264	 مهدي ، قال : حدثنا أبو خلدة خالد بن دينار ، فقال رجل لعبد الرحمن : كان ثقة ؟ قال : كان ثقة خيارا ، الثقة : سفيان ، وشعبة .(@)(@@) 933 - قال : وحدثنا عمرو بن علي ، قال : حدثنا يزيد بن زريع ، قال : حدثنا أبو خلدة وكان ثقة ، ثنا أبو يزيد يوسف بن يزيد القراطيسي ، قال : حدثنا يعقوب بن إسحاق بن أبي عياد المكي ، قال : حدثنا مسلم بن خالد ، عن ابن جريج ، عن عبد الله بن كثير ، عن مجاهد ، وعن أبي الخليل مرزوق ، قال : اشترى سلمان نفسه [ إلخ ] .(@)(@@) سمعت العباس بن محمد يقول : قال : يحيى بن معين : أبو الخليل صاحب قتادة اسمه : صالح بن أبي مريم .(@)(@@) حدثنا العباس بن محمد ، قال : سألت يحيى ، عن حديث أبي إسحاق ، عن [ أبي ] الخليل من أبو الخليل هذا ؟ قال : لا أدري ، قلت : هو أبو الخليل الذي روى عن قتادة ؟ قال : لا . PageV02P513(@)(@@) 934 - حدثنا القاسم بن يونس الحمصي ، قال : ثنا أحمد بن حنبل ، قال : أخبرني عبيد الله بن محمد القرشي ، قال : أخبرني أبو الخليل ، وكان من أهل الخير ، قال : خرج عسعس بن سلامة الجاري إلى أصحابه ، قال : فنظر ، فقال : أما إني كنت أعددت لهم سورة الواقعة ، فقالوا : يا أبا صفرة فنحن إخوانك ، قال : إخوان دون إخوان .(@)(@@) 935 - حدثني أبو بكر بن علي ، قال : حدثنا شيبان بن فروخ ، قال : حدثنا أبو هلال ، قال : ثنا حجاج بن عتاب أبو خليفة ، عن عبيد الله بن معبد الرماني ، عن أبي هريرة ، فقال : إني أدنى أهل الجنة منزلة [ وما منهم يربى ] لمن يغدو عليه ويروح عشرة ألف خادم ، ما منهم من خادم إلا ومعه طرقة ليست مع صاحبه .(@)(@@) 936 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن سليمان بن عبد الملك ، قال : حدثنا زيد ، قال : أخبرني عبد السلام أبو الخليل ، قال : حدثنا أبو يزيد المدني ، عن أبي هريرة ، أن رجلا كان يجلس إلى رسول الله [ صلى الله عليه وسلم ] ففقده فجاء ، فقال : ما حبسك ؟ قال : اشتريت بعيرا فشرد مني ، فطلبته فأصبته ، فأتيت به صاحبه فاستقلته فأقالني ، فقال رسول الله [ صلى 
ms265	 الله عليه وسلم ] : الشراد يرد منه . PageV02P514(@)(@@)(@@)(@@) ||| ( من كنيته أبو خلف )(@)(@@)(@@)(@@) $ * أبو خلف حجر بن الحارث ، روى عنه : محمد بن المبارك الصوري .(@)(@@)(@@)(@@) $ * وأبو خلف [ حازم بن ] عطاء الأعمى ، عن أنس .(@)(@@)(@@)(@@) $ * وأبو خلف عبد الله بن عيسى البصري .(@)(@@)(@@)(@@) $ * وأبو خلف مروان الأصفر ، روى عنه : عوف بن أبي جميلة .(@)(@@)(@@)(@@) $ * وأبو خلف ( 1 / 166 ) الربيع بن حبيب البصري .(@)(@@)(@@)(@@) $ * وأبو خلف ياسين الزيات .(@)(@@)(@@)(@@) $ * وأبو خلف صالح .(@)(@@) 937 - حدثنا سعيد بن عثمان ، قال : حدثنا عصام بن خالد ، قال : حدثنا معاذ بن رفاعة ، عن أبي خلف حازم بن عطاء الأعمى ، عن أنس بن مالك ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : إذا رأيتم الاختلاف ، فعليكم بالسواد الأعظم ، فإنه لا تجتمع أمتي على ضلالة .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، [ يقول ] : ياسين الزيات كنيته أبو خلف .(@)(@@) 938 - أخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، عن جعفر ابن سليمان ، عن صالح أبي خلف ، قال : سألت الحسن ، فقلت : يا أبا سعيد إني إمام قوم ، فما أقرأ بهم في صلاة الغداة ؟ قال : عليك بصدر المفصل . PageV02P515(@)(@@)(@@)(@@) ||| ( من كنيته أبو خيثمة وأبو الخير )(@)(@@)(@@)(@@) $ * أبو خيثمة زهير بن معاوية بن حديج بن رجيل .(@)(@@)(@@)(@@) $ * وأبو خيثمة زهير بن حرب .(@)(@@)(@@)(@@) $ * وأبو خيثمة بن حيان .(@)(@@)(@@)(@@) $ * وأبو خيثمة مصعب بن سعيد المصيصي .(@)(@@)(@@)(@@) $ * وأبو الخير مرثد بن عبد الله اليزني ، يروي عنه : يزيد بن أبي حبيب .(@)(@@)(@@)(@@) $ * وأبو خباب الوليد بن بكير .(@)(@@) سمعت يحيى بن معين يقول : أبو خيثمة زهير بن معاوية .(@)(@@) 939 - حدثنا سعيد بن أبي أيوب أبو بكر الواسطي ، قال : ثنا زيد بن الحباب ، قال : حدثنا زهير بن معاوية الجعفي أبو خيثمة ، قال : حدثنا أبو إسحاق السبيعي ، عن هبيرة بن يريم ، أن عليا قال لهم : يا أهل الكوفة إن فيكم من أصحاب محمد علماء ، فاجتمعوا إلي فاسألوا ، قال : ففعلوا ، فجعل يجيبهم حتى انصرف القوم ، إلا شريحا فجعل يسائله ويجيبه ، فقال له : أنت أفقه العرب .(@)(@@) حدثنا يزيد بن سنان ، قال : حدثنا أبو خيثمة مصعب بن سعيد المصيصي . PageV02P516(@)(@@) وحدثني أحمد بن أيوب البغدادي 
ms266	 ، قال : سمعت العباس يقول : قال يحيى بن معين : أبو الخير مرثد بن عبد الله اليزني رجل صدق ، وكان عند أهل مصر مثل علقمة عند أهل الكوفة .(@)(@@) 940 - حدثنا أحمد بن إبراهيم بن فيل ، قال : أنبأ ابن نفيل ، قال : حدثنا الوليد بن عبد الله الحمصي ، عن أبي خيثمة سليمان بن حيان ، قال : حدثنا واثلة بن واثلة ، قال : كنت من فقراء المسلمين من أهل الصفة ، فأتانا رسول الله [ صلى الله عليه وسلم ] ذات يوم ، فقال : كيف أنتم بعدي إذا شبعتم من خبز البر والزيت ، وأكلتم من ألوان الطعام ، ولبستم ألوان الثياب ؟ فأنتم اليوم خير .(@)(@@) 941 - أخبرني أحمد بن شعيب ، قال : أخبرني أحمد بن خالد الخلال بسر من رأى ، قال : حدثنا أبو خباب الوليد بن بكير ، عن إسرائيل ، عن أبي إسحاق ، عن سعيد بن حذيفة ، عن أبيه ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من فارق الجماعة شبرا فارق الإسلام . PageV02P517(@)(@@)(@@)(@@) ||| ( من كنيته أبو الخطاب )(@)(@@)(@@)(@@) $ * أبو الخطاب قتادة بن دعامة السدوسي .(@)(@@)(@@)(@@) $ * وأبو الخطاب محمد بن سواء .(@)(@@)(@@)(@@) $ * وأبو الخطاب النعمان ، يروي عنه : إسماعيل بن أبي خالد .(@)(@@)(@@)(@@) $ * وأبو الخطاب معروف الخياط .(@)(@@)(@@)(@@) $ * وأبو الخطاب حرب بن ميمون الأنصاري ، ويقال : العبدي ، حدث عنه : بدل بن المحبر ، عن النضر بن أنس ، عن أبيه أنس ، قال : سألت رسول الله [ صلى الله عليه وسلم ] أن يشفع لي يوم القيامة ، فقال : أنا فاعل ( 1 / 167 ) .(@)(@@)(@@)(@@) $ * وأبو الخطاب يحيى بن عمرو بن عمارة الدمشقي .(@)(@@)(@@)(@@) $ * وأبو الخطاب النهاس بن قهم .(@)(@@)(@@)(@@) $ * وأبو الخطاب عبد الله .(@)(@@) 942 - حدثنا سعيد بن أبي زيدون كاتب الفريابي ، قال : حدثنا محمد ابن يوسف يعني : الفريابي ، قال : حدثنا سفيان يعني : الثوري ، عن أبي عروة ، وهو معمر بن راشد ، عن أبي الخطاب ، وهو قتادة بن دعامة ، عن أنس ابن مالك ، أن النبي [ صلى الله عليه وسلم ] كان يطوف على نسائه بغسل واحد .(@)(@@) 943 - أخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : حدثنا محمد بن سواء أبو الخطاب ، قال : أخبرني أبو بكار الحكم بن فروخ ، قال : صلى بنا أبو المليح 
ms267	 على جنازة ، فظننا أنه قد كبر ، فأقبل علينا بوجهه ، فقال : أقيموا صفوفكم ، ولتحسن شفاعتكم ، فقال أبو المليح : حدثني عبد الله ابن سليط ، عن إحدى أمهات المؤمنين ، وهي ميمونة ، قالت : أخبرني النبي PageV02P518 [ صلى الله عليه وسلم ] قال : ما من ميت يصلي عليه أمة من الناس إلا شفعوا فيه ، فسألت أبا المليح عن الأمة ؟ فقال : أربعين .(@)(@@) 944 - حدثني أحمد بن شعيب ، قال : أنبأني علي بن حجر ، قال : حدثنا معروف الخياط مولى بني أمية أبو الخطاب ، قال : رأيت واثلة بن الأسقع يرتعش من الكبر ، وكان يمسح رأسي ، ويقول : يا معروف ! أخشى عليك الكبر ، فعلمت أنها كلمة ألقاها الله في قلبه .(@)(@@) 945 - قال : وأخبرني أحمد بن شعيب ، قال : حدثنا محمد بن إدريس ، قال : حدثنا أبو الخطاب يحيى بن عمر بن عمارة الدمشقي الليثي ، قال : سمعت ابن ثوبان يحدث ، عن عبد الله بن الفضل ، عن الأعرج ، عن أبي هريرة ، أن رسول الله [ صلى الله عليه وسلم ] قال : قيد سوط في الجنة خير من الدنيا وما فيها .(@)(@@) 946 - وروى محمد بن عبد الله بن عمار ، عن المعافى بن عمران ، عن عبد الله أبي الخطاب ، عن شهر بن حوشب ، عن أبيه ، عن معاذ بن جبل ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : الصائم في ظل الله يوم لا ظل إلا ظله .(@)(@@) حدثني عبد الله بن أحمد ، قال : أخبرني أبي ، قال : قال وكيع : النهاس بن قهم أبو الخطاب .(@)(@@) سمعت العباس بن محمد قال ، سمعت يحيى بن معين يقول : كنية النهاس بن قهم أبو الخطاب . PageV02P519(@)(@@) سمعت العباس [ بن محمد ] قال : سمعت يحيى [ بن معين ] : أبو الخطاب لم أسمع به إلا في أحاديث ابن أبي غنية ، انتهى .(@)(@@)(@@)(@@) ||| ( من كنيته أبو خفاف )(@)(@@)(@@)(@@) $ * أبو خفاف ناجية بن كعب العنزي .(@)(@@)(@@)(@@) $ * وأبو خفاف سعيد بن عمير(@)(@@) حدثني صالح بن أحمد بن حنبل ، قال : حدثنا علي بن المديني ، قال : أملى علي يحيى بن سعيد ، قال : ناجية بن خفاف أبو خفاف كوفي ، روى عنه : شعبة ، ولم يرو عنه : الثوري .(@)(@@)(@@)(@@) ||| ( من كنيته أبو خداش ، وأبو 
ms268	 خريم ، وأبو خشينة )(@)(@@)(@@)(@@) $ * أبو خداش حبان بن زيد الشرعبي ، روى عنه : حريز بن عثمان .(@)(@@)(@@)(@@) $ * وأبو خداش زياد بن الربيع اليحمدي .(@)(@@)(@@)(@@) $ * وأبو خريم عقبة بن أبي الصهباء .(@)(@@)(@@)(@@) $ * وأبو خريم يوسف بن ميمون الصباغ .(@)(@@)(@@)(@@) $ * وأبو خشينة حاجب بن عمر ، أخو عيسى بن عمر النحوي . PageV02P520(@)(@@)(@@)(@@) $ * وأبو خشينة صاحب الزيادي ، روى عنه : محمد بن سواء .(@)(@@)(@@)(@@) $ * وأبو خشرم ، عن : وهب بن منبه .(@)(@@)(@@)(@@) $ * وأبو خراش المدلي .(@)(@@) حدثنا إبراهيم بن يعقوب السعدي ، قال : أنبأ إبراهيم [ بن ] المهدي ، قال : ثنا زياد بن الربيع أبو خداش اليحمدي .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو خريم عقبة بن أبي الصهباء ثقة ، كان ينزل المدائن ( 1 / 168 ) .(@)(@@) 947 - حدثنا يزيد بن سنان ، قال : حدثنا مسلمة بن إبراهيم ، قال : حدثنا عقبة بن أبي الصهباء أبو خريم الباهلي ، قال : سمعت سالم بن عبد الله ، يقول : حدثني عبد الله بن عمر ، أنه صلى مع النبي [ صلى الله عليه وسلم ] ذات يوم صلاة الصبح ، فلما أن قضى صلاته قام ، فاستقبل مطلع الشمس ، ثم نادى ألا إن الفتن من ههنا ، ألا إن الفتن من ههنا ثلاث مرات ، ومن ثم يطلع قرن الشيطان .(@)(@@) حدثني أبو بكر بن شعيب بن أيوب ، قال : حدثنا زياد بن حباب ، عن حاجب الزيادي ، قال : أبو حفص واسمه : عبد الله بن الصعدي .(@)(@@) حدثنا إسحاق بن سيار النصيبي ، قال : حدثنا سليمان بن حرب ، قال : حدثنا حماد بن زيد ، عن أبي خشينة ، قال : ذكر أبو قلابة عند محمد ، فقال : ذاك أخي حقا . PageV02P521(@)(@@) 948 - قال : وحدثنا أبو حفص عمرو بن علي ، قال : حدثنا زياد بن الربيع اليحمدي أبو خداش ، قال : حدثنا هشام ، عن محمد ، عن أبي هريرة قال : قال رسول الله [ صلى الله عليه وسلم ] : إذا تقارب الزمان لم تكد رؤيا المؤمن أن تكذب ، وأصدقهم رؤيا أصدقهم حديثا .(@)(@@) حدثنا أبو بكر أحمد بن منصور الرمادي ، قال : حدثنا عبد الوهاب بن عطاء ، قال : حدثنا أبو خشرم ، عن وهب بن منبه ، قال : لما بلغ ذو القرنين مطلع الشمس ، قال له ملكها : يا ذا القرنين 
ms269	 ! صف لي الناس ، قال : إن محادثتك من لا يعقل بمنزلة رجل يغني الموتى ، ومحادثة من لا يعقل بمنزلة رجل يبل الصخر حتى يبتل أو يطبخ [ الحديد ] يلتمس إدامه ، ومحادثتك من لا يعقل بمنزلة من يضع الموائد لأهل القبور ، ونقل الحجارة أيسر من محادثتك من لا يعقل .(@)(@@) سمعت العباس بن محمد يقول : قال يحيى : أبو خراش المدلي هكذا يقولون ، [ وإنما ] هو : أبو خراس المدلي . PageV02P522(@)(@@)(@@)(@@) ||| ( من كنيته أبو خزيمة )(@)(@@)(@@)(@@) $ * أبو خزيمة وبرة بن عبد الرحمن السلمي كوفي .(@)(@@)(@@)(@@) $ * وأبو خزيمة صالح بن مرداس .(@)(@@)(@@)(@@) $ * وأبو خزيمة نصر بن مرداس .(@)(@@)(@@)(@@) $ * وأبو خزيمة بكار بن شعيب .(@)(@@)(@@)(@@) $ * وأبو خزيمة مزاحم بن زفر .(@)(@@)(@@)(@@) $ * وأبو خزامة .(@)(@@)(@@)(@@) $ * وأبو الخصيب زياد بن عبد الرحمن البصري .(@)(@@)(@@)(@@) $ * وأبو الخصيب نقاعة بن مسلم .(@)(@@)(@@)(@@) $ * وأبو خميصة عبد الله بن قيس .(@)(@@) حدثنا إبراهيم بن يعقوب ، قال : حدثنا الحسن بن الربيع ، قال : حدثنا ابن إدريس ، عن وبرة بن عبد الرحمن أبي خزيمة السلمي .(@)(@@) 949 - أنبأ أحمد بن شعيب ، قال : أنبأ محمود بن خالد ، قال : حدثنا أبو خزيمة بكار بن شعيب ، قال : أخبرني ابن أبي حازم ، عن أبيه ، عن سهل بن سعد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إنما الناس كأسنان المشط ، وإنما يتفاضلون بالعافية ، فلا تصحب من لا يرى لك مثل ما ترى له .(@)(@@) سمعت العباس بن محمد قال : سمعت يحيى بن معين يقول : حديث PageV02P523 عثمان بن عمر ، عن يونس بن يزيد ، عن الزهري ، عن أبي خزامة [ عن الحارث بن سعد ، وأخطأ فيه ، إنما هو عن أبي خزامة ، أحد بني الحارث ] .(@)(@@) حدثني الحارث بن سعد ، حدثني أبو يونس محمد بن أحمد بن يزيد المدائني ، قال : أخبرني إبراهيم بن المنذر الخزامي ، قال : أخبرني أبو خزيمة مزاحم بن زفر التميمي .(@)(@@) 950 - حدثنا إبراهيم بن يعقوب السعدي ، قال : حدثنا محمد بن وهب بن عطية الدمشقي ، قال : حدثنا بكار بن شعيب أبو خزيمة العبدي ، قال : حدثنا عبد العزيز بن حازم ، عن أبيه ، عن سهل بن سعد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : الناس مستوون كأسنان المشط ، وإنما 
ms270	 يتفاضلون بالعافية ، فلا تصحبن رجلا لا يرى لك مثل ما ترى له .(@)(@@) 951 - أخبرنا أحمد بن شعيب ، قال : حدثنا موسى بن حزام ، قال : حدثنا عبد الله هو المقرئ ، قال : حدثنا ( 1 / 169 ) حيوة بن شريح ، قال : أنبأ السكن بن أبي كريمة أن أمه أخبرته ، أنها سمعت أبا خميصة عبد الله بن قيس ، يقول : سمعت علي بن أبي طالب يقول في هذه الآية : ' قل هل ننبئكم بالأخسرين أعمالا ' إلى آخر الآية ، أنهم الرهبان الذين حبسوا أنفسهم في السواري . PageV02P524(@)(@@)(@@)(@@) || ( حرف الدال )(@)(@@)(@@)(@@) ||| ( من كنيته أبو داود من التابعين وغيرهم )(@)(@@)(@@)(@@) $ * أبو داود عبد الرحمن بن هرمز الأعرج .(@)(@@)(@@)(@@) $ * وأبو داود يزيد الأودي كوفي ، روى عن : علي بن أبي طالب .(@)(@@)(@@)(@@) $ * وأبو داود نافذ ، روى عنه : حفص بن غياث .(@)(@@)(@@)(@@) $ * وأبو داود الحكم ، روى عنه : عباد بن العوام .(@)(@@)(@@)(@@) $ * وأبو داود سليمان بن موسى ، روى عنه : الوليد بن مسلم .(@)(@@)(@@)(@@) $ * وأبو داود سليمان بن عبد العزيز .(@)(@@)(@@)(@@) $ * وأبو داود سليمان بن كثير ، أخو محمد بن كثير .(@)(@@)(@@)(@@) $ * وأبو داود سليمان بن داود الطيالسي .(@)(@@)(@@)(@@) $ * وأبو داود الحفري عمر بن سعد ، كوفي .(@)(@@)(@@)(@@) $ * وأبو داود نفيع بن الحارث الأعمى .(@)(@@)(@@)(@@) $ * وأبو داود سليمان بن محمد بن سليمان المباركي .(@)(@@) 952 - حدثنا علي بن حرب الطائي أبو الحسن ، قال : حدثنا أبو داود عمر بن سعد الحفري ، عن سفيان الثوري ، عن السدي ، عن أبي هبيرة ، عن أنس ، أن النبي [ صلى الله عليه وسلم ] كره أن يجعل الخل خمرا .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى يقول : سمعت أبا داود النخعي : وكان يكون عند درب البقر [ يقول ] سمعت خصيفا وخصافا PageV02P525(@)(@@) [ قال يحيى ] : وكان أكذب الناس ، واسمه سليمان بن عمرو .(@)(@@) أخبرني محمد بن إبراهيم بن هاشم ، [ عن أبيه ] عن محمد بن عمر ، قال : أبو داود نفيع بن الحارث الأعور ، كان يقال له القاضي ، وكان ابن أمة للحارث الأعور ، فأقر به الحارث قبل موته ، وكان يزعم أنه لقي البراء بن عازب ، وزيد بن أرقم ، وعمران بن الحصين ، ومعقل بن يسار ، وكان فيه اختلاف ، هلك في إمارة مروان بن [ محمد مروان بن الحكم 
ms271	 ] .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : نفيع بن الحارث أبو داود لم يكن ثقة ، وقد رأى زهير بن معاوية أبا داود الأعمى .(@)(@@) أخبرني أحمد بن شعيب ، عن العباس بن عبد العظيم ، قال : سألت ابن حفص بن غياث ، عن اسم أبي داود الذي روى عنه : حفص بن غياث ، فقال : نافذ .(@)(@@) 953 - قال : وأخبرني أبو عبد الرحمن ، عن محمد بن رافع ، قال : حدثنا أبو داود الطيالسي سليمان بن داود ، قال : حدثنا عياش بن سنان الأسدي ، قال : حدثنا أبو نضرة ، عن أبي سعيد الخدري ، قال : قال رسول الله [ صلى الله عليه وسلم ] : يخرج ناس من النار بعد ما احترقوا ويدخلون الجنة . PageV02P526(@)(@@) 954 - أخبرني أحمد بن شعيب ، عن أبي الوليد البسري ، قال : حدثنا الوليد بن مسلم ، قال : أخبرني أبو داود سليمان بن موسى ، عن جعفر بن سعد بن سمرة يعني : ابن جندب ، عن حبيب بن سمرة ، عن أبيه ، قال : جعل رسول الله [ صلى الله عليه وسلم ] شعار المهاجرين يا بني عبد الرحمن ، وشعار الخزرج يا بني عبد الله ، وشعار الأوس يا بني عبيد الله .(@)(@@) 955 - وحدث عبد الله بن المبارك ، عن يحيى بن أبي الهيثم ، قال : أخبرني يزيد أبو داود الأودي ، قال : كنت عند علي بن أبي طالب بعد العصر إذ أتى برجل ، فقالوا : وجدنا هذا في خربة مراد ومعه جارية قد اختضب قميصها بالدم ، فقال له علي : ويحك ما هذا ؟ ما صنعت ؟ قال : أصلح الله أمير المؤمنين ( 1 / 170 ) كانت ابنة عمي ويتيمة في حجري ، وهي غنية من المال ، وأنا رجل قد كبرت ، وليس لي مال ، فخشيت إن هي أدركت مدرك النساء أن ترغب عني فتزوجتها ، وهي تبكي ، فقال لها : تزوجته ، فقائل من القوم عنده يقول لها : قولي نعم ، وقائل يقول لها ، قولي : لا ، فقالت : نعم تزوجته ، فقال : خذ بيد امرأتك .(@)(@@) وسمعت بعض أهل العلم يقول : يزيد أبو داود هذا هو جد عبد الله بن إدريس ، وهو يزيد بن عبد الرحمن .(@)(@@)(@@)(@@) $ * وأبو دراس إسماعيل بن دراس ، يروي عنه : عبد 
ms272	 الصمد بن عبد الوارث كوفي .(@)(@@)(@@)(@@) $ * وأبو دعامة بشير الغنوي .(@)(@@)(@@)(@@) $ * وأبو دحية حوشب بن عقيل ، يحدث عنه : أبو داود سليمان بن حرب .(@)(@@)(@@)(@@) $ * وأبو دغفل إياس بن دغفل .(@)(@@)(@@)(@@) $ * وأبو ديلم موسى بن زياد . PageV02P527(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : حوشب بن عقيل ثقة ، ويكنى أبا دحية .(@)(@@) 956 - حدثنا محمد بن إسماعيل الصائغ ، قال : حدثنا أبو نعيم ، قال : أنبأ إياس بن دغفل ، قال : أخبرني عطاء ، عن عروة بن الزبير ، أن عائشة حدثته ، أن رسول الله [ صلى الله عليه وسلم ] كان يصلي وهي معترضة بينه وبين القبلة .(@)(@@)(@@)(@@) $ * وأبو الدلهمس نفيع .(@)(@@)(@@)(@@) $ * وأبو الدهماء قرفة بن بهيس .(@)(@@)(@@)(@@) $ * وأبو الدالان بن يزيد .(@)(@@)(@@)(@@) $ * وأبو دوس عثمان بن عبيد .(@)(@@)(@@)(@@) $ * وأبو الدهقانة .(@)(@@)(@@)(@@) $ * وأبو دسمة حبان بن يزيد .(@)(@@) 957 - حدثنا يزيد بن مهدي بن يزيد الواسطي ، قال : حدثنا حفص بن عمر النجار الواسطي ، قال : حدثنا قرة بن خالد ، قال : حدثني نفيع الجمال أبو الدلهمس ، قال : أتيت المدينة فرأيت سعيد بن المسيب ووقفت إليه جارية قد دق عبد فاها ، فقضى لها بالعبد ، وما هو يومئذ قاضيا .(@)(@@) قال : وسمعت سعيد بن المسيب يقول : حرف الظل مقيل الشيطان .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، يقول : أبو الدهقانة يروي عن : ابن عمر ، وقد روى فضيل بن غزوان ، عن أبي الدهقانة . PageV02P528(@)(@@) 958 - حدثنا إبراهيم بن محمد بن عبد الأعلى المقابري ، قال : حدثنا محمد بن يوسف الفريابي ، قال : حدثنا سفيان ، عن جرير بن حازم ، عن أبي نصر العذري ، عن أبي الدهماء ، عن عمران بن حصين ، عن النبي [ صلى الله عليه وسلم ] قال : من سمع بالدجال فلينأ عنه ، فإنه يأتيه الرجل فيحسب أنه مؤمن فيتبعه لما يرى معه من الشبهات .(@)(@@) قال : وسمعت العباس بن محمد يقول : عن يحيى بن معين ، قال : أبو الدهماء اسمه قرفة بن بهيس .(@)(@@) 959 - حدثنا محمد بن عوف الطائي ، قال : قال أبو المغيرة عبد القدوس ابن الحجاج ، قال : حدثنا عثمان بن عبيد أبو دوس اليحصبي ، عن عبد الرحمن بن عائذ الثمالي ، عن عمرو بن عبسة السلمي ، قال 
ms273	 : قال رسول الله [ صلى الله عليه وسلم ] : شر قبيلتين في العرب نجران وبنو تغلب .(@)(@@) 960 - أخبرني أبو عبد الله الحسين بن علي بن الحسن العلوي ، عن الحسن بن يحيى بن زيد [ بن حسين بن زيد ] بن علي ، قال : أخبرنا ابن عبد الرحمن الأصباعي ، عن أبي داود الطهوي بن عيسى بن مسلم ، عن أبي الجارود ، عن زيد بن علي ، في قوله تعالى : @QB@ يا أيها الذين آمنوا اتقوا الله وآمنوا برسوله يؤتكم كفلين من رحمته @QE@ الآية ، قال : هو مودتنا أهل البيت . PageV02P529(@)(@@)(@@)(@@) || ( حرف الذال )(@)(@@)(@@)(@@) ||| ( من كنيته أبو ذر )(@)(@@)(@@)(@@) $ * أبو ذر عبد الرحمن بن فضالة .(@)(@@)(@@)(@@) $ * روى عنه : صفوان بن عمرو .(@)(@@)(@@)(@@) $ * وأبو ذر عمر بن ذر .(@)(@@)(@@)(@@) $ * وأبو ذر محمد بن غنيم البصري .(@)(@@)(@@)(@@) $ * وأبو ذر حازم بن محمد بن يونس بن قيس بن أبي غرزة .(@)(@@) 961 - حدثنا عمران بن بكار البراد ، قال : حدثنا أبو المغيرة عبد القدوس بن الحجاج ، قال : حدثنا صفوان بن عمرو ، قال : حدثنا أبو عبد الرحمن بن فضالة ، عن الزبير بن عبد الله القيسي ، قال : قال رسول الله [ صلى الله عليه وسلم ] : عينان حرمهما الله على النار عين بكت من خشية الله ، وعين حرست في سبيل الله .(@)(@@) 962 - حدثني الحسن بن علي بن عفان ، قال : حدثنا حسين الجعفي ، عن عمر بن ذر ، قال : لقيت ربيع بن أبي راشد في السوق فأخذ بيدي ، فتنحى بي ، ثم قال : يا أبا ذر من سأل لقاء الله ، فقد سأله أمرا عظيما .(@)(@@) 963 - أخبرني أحمد بن شعيب بن علي ، [ عن ] أبي زرعة عبيد الله بن عبد الكريم الرازي ، قال : أخبرني أبو ذر حازم بن محمد بن يونس بن قيس بن أبي غرزة الغفاري ، قال : سمعت أمي حمادة بنت محمد بن PageV02P530 عبد الرحمن بن أبي ليلى ، قالت : كانت عمتي تقول : كانت أمي تقول : ليلى تصبغ لها درعها وخمارها وملحفتها في كل شهر ، وتخضب يديها ورجليها غمسة ، وقالت : على ذا بايعنا رسول الله [ صلى الله عليه وسلم ] .(@)(@@) 964 - حدثنا العباس بن محمد ، قال : حدثنا يحيى بن معين ، قال : حدثنا يحيى 
ms274	 بن زكريا بن أبي زائدة ، عن أبي ذر الشامي ، عن أبي إسحاق ، عن أبي ميسرة في صدقة الفطر مثليه بين التمر أو ثمنه .(@)(@@) قلت ليحيى : من أبو ذر الشامي هذا ؟ ومن روى عنه غير ابن أبي زائدة ؟ قال : لا أعلم أحدا روى عنه غير ابن أبي زائدة ، وأظن يحيى يريد بقوله مثليه من التمر : أن من أعطى مدين من بر أعطى مدين من تمر .(@)(@@)(@@)(@@) $ * وأبو ذراع سهيل بن ذراع .(@)(@@)(@@)(@@) $ * وأبو ذبيان خليفة بن كعب ، روى عنه : شعبة .(@)(@@) سمعت عبد الله بن أحمد بن حنبل ، يقول : سمعت أبي يقول : أبو ذبيان خليفة بن كعب ، روى عنه : شعبة .(@)(@@) 965 - حدثني إسحاق بن الحسن بن الحسين ، قال : ثنا آدم بن أبي إياس ، قال : حدثنا شعبة ، قال : حدثنا أبو ذبيان خليفة بن كعب ، قال : سمعت عبد الله بن الزبير ، قال : سمعت عمر بن الخطاب يقول : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من لبس الحرير في الدنيا لم يلبسه في الآخرة . PageV02P531(@)(@@)(@@)(@@) || ( حرف الراء )(@)(@@)(@@)(@@) ||| ( من كنيته أبو روح )(@)(@@)(@@)(@@) $ * أبو روح جميل بن مرة ، روى عنه : حماد بن زيد .(@)(@@)(@@)(@@) $ * وأبو روح عمارة بن أبي حفصة .(@)(@@)(@@)(@@) $ * وأبو روح حوشب بن سيف ، روى عنه : صفوان بن عمرو .(@)(@@)(@@)(@@) $ * وأبو روح شبيب بن نعيم ، روى عنه : جرير .(@)(@@)(@@)(@@) $ * وأبو روح عبد الرحمن بن قيس .(@)(@@)(@@)(@@) $ * وأبو روح حرمي بن عمارة بن أبي حفصة .(@)(@@)(@@)(@@) $ * وأبو روح خالد بن مخرج ، قال يزيد بن هارون : هو كذاب .(@)(@@)(@@)(@@) $ * وأبو روح محمد بن عبد العزيز الواسطي .(@)(@@)(@@)(@@) $ * وأبو روح معاوية بن يحيى الصدفي .(@)(@@)(@@)(@@) $ * وأبو روح سلام بن مسكين ( 1 / 172 ) .(@)(@@)(@@)(@@) $ * وأبو روح قدامة بن عبد الله العامري .(@)(@@)(@@)(@@) $ * وأبو روح نوح بن قيس البصري .(@)(@@)(@@)(@@) $ * وأبو روح النضر بن عربي .(@)(@@)(@@)(@@) $ * وأبو روح الربيع بن روح حمصي .(@)(@@)(@@)(@@) $ * وأبو روح عبد العزيز بن موسى .(@)(@@)(@@)(@@) $ * وأبو روح عون بن موسى .(@)(@@)(@@)(@@) $ * وأبو روح عمارة بن أبي حفصة . PageV02P532(@)(@@) سمعت العباس بن محمد يقول : قال يحيى : حرمي كنيته أبو روح .(@)(@@) قال : وسلام بن مسكين أبو روح .(@)(@@) قال : ويزيد بن رومان أبو روح .(@)(@@) 966 - حدثنا أبو 
ms275	 الحارث أحمد بن سعيد الفهري ، قال : وحدثنا إبراهيم بن المنذر ، قال : حدثنا كثير بن جعفر بن أبي كثير ، قال : سمعت يزيد بن رومان ، وسأله رجل عن ليلة القدر ، فقال يزيد : إذا مضت ليلة ثلاث وعشرين وبقيت سبع ، فقال له رجل : يا أبا روح تلك ليلة أربع وعشرين ، قال يزيد : تريد أن تخدعني ، هكذا سمعت .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : قال يحيى [ قد ] روى عبد الملك بن عمير ، عن شبيب أبي روح .(@)(@@) 967 - حدثنا عمران بن بكار البراد ، قال : حدثنا عبد العزيز بن موسى أبو روح اللاخوني ، قال : حدثنا عمر بن علي بن مقدام ، عن هشام بن عروة ، عن أبيه ، عن عائشة ، أن رسول الله [ صلى الله عليه وسلم ] قال : من بات وفي يده ريح غمر ، فأصابه شيء فلا يلومن إلا نفسه .(@)(@@) أخبرني أحمد بن شعيب ، عن محمد بن إسماعيل بن إبراهيم ، قال : حدثنا يونس ، قال : حدثنا حماد بن زيد ، عن جميل بن مرة أبي روح ، عن أبي الرضى . PageV02P533(@)(@@) 968 - وأخبرني أحمد بن شعيب ، قال : أنبأ عبيد الله بن سعيد ، قال : أخبرني حرمي بن عمارة بن أبي حفصة أبو روح ، قال : حدثنا شعبة ، عن عمرو بن دينار ، قال : سمعت يحيى بن جعدة ، عن عبد الله بن عمرو ، عن أبي طلحة ، أن النبي [ صلى الله عليه وسلم ] قال : توضؤوا مما غيرت النار .(@)(@@) قال أبو عبد الرحمن : هو عبد الله القارئ .(@)(@@) 969 - حدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم ، قال : حدثنا أبو روح يعني سلام بن مسكين ، قال : حدثنا يزيد الضبي ، عن أنس بن مالك ، قال : ما صليت خلف رجل أوجز ولا أخف صلاة من رسول الله [ صلى الله عليه وسلم ] .(@)(@@) 970 - حدثنا محمد بن عوف ، قال : حدثنا أبو المغيرة ، قال : حدثنا جريز بن عثمان ، قال : حدثنا شبيب بن نعيم أبو روح ، عن أبي هريرة ، عن النبي [ صلى الله عليه وسلم ] قال : الإيمان يمان ، والحكمة يمانية .(@)(@@) حدثنا أبو محمد الحسن بن علي بن عفان ، قال : حدثنا زيد بن الحباب ، قال : حدثني 
ms276	 نوح بن قيس أبو روح رجل من أهل البصرة . PageV02P534(@)(@@)(@@)(@@) ||| ( من كنيته أبو الرواغ وغيره )(@)(@@)(@@)(@@) $ * أبو الرواغ مجمع الأرحبي .(@)(@@)(@@)(@@) $ * وأبو الرواغ عباد بن زاهر ، سمع : عثمان بن عفان .(@)(@@)(@@)(@@) $ * وأبو روق عطية بن الحارث الهمداني .(@)(@@)(@@)(@@) $ * وأبو رويحة حبان بن بشار الكلابي ، روى عنه : عمرو بن عاصم .(@)(@@)(@@)(@@) $ * وأبو رواحة يزيد [ بن ] أيهم ، يروي عنه : صفوان بن أبي عمرو .(@)(@@)(@@)(@@) $ * وأبو روبة شداد بن عمران بصري ( 1 / 173 ) .(@)(@@) سمعت العباس بن محمد ، قال : قال يحيى بن معين : أبو الرواغ مجمع الأرحبي .(@)(@@) حدثنا عبد الله بن أحمد ، عن أبيه قال : أبو روق عطية بن الحارث ، روى عنه : الثوري .(@)(@@) حدثنا الحسن بن عفان ، قال : حدثنا أبو أسامة ، عن أبي روق عطية بن الحارث(@)(@@) قال : وسمعت العباس بن محمد ، قال يحيى : أبو رواحة يزيد ابن أيهم .(@)(@@) 971 - حدثنا سعيد بن عمرو السكوني ، ومحمد بن عمرو الكلبي ، قالا : PageV02P535 حدثنا بقية بن الوليد ، قال : حدثنا صفوان بن عمرو ، عن يزيد بن أيهم أبي رواحة ، عن عمرو بن أبي حبيب ، ثنا عمران بن بكار ، قال : ثنا أبو المغيرة ، قال : حدثنا صفوان بن عمرو ، قال : حدثنا أبو رواحة ، عن عمرو بن أبي حبيب ، أنه قال لسعيد بن خالد بن عمرو بن عثمان : أما علمت أن رسول الله [ صلى الله عليه وسلم ] قال : خاب عبد وخسر لم يجعل الله في قلبه رحمة للبشر .(@)(@@) 972 - حدثنا أحمد بن يحيى الصوفي ، قال : حدثنا سعيد بن محمد الجرمي ، عن القاسم بن مالك المزني ، عن أيوب بن عائذ الطائي ، عن أبي رؤبة ، عن عمران بن حصين ، قال : دخل رجل يهودي على النبي [ صلى الله عليه وسلم ] ، وهو في بيت عائشة ، فقال : السلام عليكم ، فقال رسول الله [ صلى الله عليه وسلم ] : وعليكم ، فلما خرج قالت عائشة يا رسول الله ! أما فهمت ما قال هذا الخبيث اليهودي ؟ قال : يا عائشة ! وما سمعت ما رددت عليه ، إن الرفق لو كان خلقا ما رأى الناس خلقا أحسن منه ، وإن الخرق لو كان خلقا ما رأى الناس خلقا أقبح منه .(@)(@@) سمعت العباس 
ms277	 بن محمد ، قال يحيى : حدث عبد الوارث بن سعيد ، عن يحيى بن أبي إسحاق ، قال : أخبرني أبو رؤبة ، قال يحيى : هو كذا هو أبو رؤبة .(@)(@@) 973 - حدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم الكلابي ، قال : حدثنا حبان بن يسار أبو رويحة الكلابي ، قال : حدثنا PageV02P536 عبد الرحمن بن طلحة الخزاعي ، عن أبي جعفر محمد بن علي ، عن محمد بن الحنفية ، عن علي ، قال : من أحب أن يكال له بالمكيال الأوفى إذا صلى علينا أهل البيت ، فليقل : اللهم اجعل صلواتك وبركاتك على محمد النبي وأزواجه أمهات المؤمنين وذريته وأهل بيته ، كما صليت على إبراهيم إنك حميد مجيد . PageV02P537(@)(@@)(@@)(@@) ||| ( من كنيته أبو رجاء ، [ وأبو الرجال ] )(@)(@@)(@@)(@@) $ * أبو رجاء العطاردي عمران بن تيم بصري .(@)(@@)(@@)(@@) $ * وأبو رجاء الهروي عبد الله بن واقد .(@)(@@)(@@)(@@) $ * وأبو رجاء عبد الرحمن بن عبد الحميد بن سالم ، خال أبي طاهر عمرو ابن السرح .(@)(@@)(@@)(@@) $ * وأبو رجاء حصين بن يزيد الكلبي .(@)(@@)(@@)(@@) $ * وأبو رجاء محمد بن سيف بصري .(@)(@@)(@@)(@@) $ * وأبو رجاء محرز الشامي .(@)(@@)(@@)(@@) $ * وأبو رجاء مطر بن طهمان .(@)(@@)(@@)(@@) $ * وأبو رجاء مرجى بن رجاء اليشكري .(@)(@@)(@@)(@@) $ * وأبو رجاء يزيد بن أبي حبيب .(@)(@@)(@@)(@@) $ * وأبو رجاء زيد الأحمسي .(@)(@@)(@@)(@@) $ * وأبو رجاء سلمان مولى أبي قتادة .(@)(@@)(@@)(@@) $ * وأبو رجاء روح بن المسيب الكلبي ، روى عنه : ابن المديني .(@)(@@)(@@)(@@) $ * وأبو الرجال روى عنه : مالك ، اسمه : محمد بن عبد الرحمن بن حارثة .(@)(@@) حدثني أبو يعلى زكريا بن خلاد ، قال : حدثنا الأصمعي ، قال : أبو PageV02P538 رجاء العطاردي ، اسمه : عمران بن تيم مولى لهم .(@)(@@) 974 - حدثنا بشار ، قال : حدثنا أبو عاصم ، قال : حدثنا عبد الصمد ، قال : حدثنا أبو رجاء ، قال : بعث النبي [ صلى الله عليه وسلم ] ( 1 / 174 ) وأنا أرد على أهلي الإبل ، وكان أول ما أنكرنا تنقض الكواكب ، وكانت لا تنتقض قبل ذلك .(@)(@@) 975 - حدثني الحسن بن علي بن عفان ، قال : حدثنا أبو أسامة ، قال : حدثنا جرير بن حازم ، قال : سمعت أبا رجاء ، واسمه : عمران بن تيم ، يقول : سمعت ابن عباس ، وهو يخطب الناس بالبصرة يقول : إن هذه الأمة لا يزال أمرها موائما أو متقاربا ما لم 
ms278	 يتكلموا في القدر والولدان .(@)(@@) أخبرنا أحمد بن يحيى الأودي ، قال : حدثنا إسحاق بن منصور ، قال : حدثنا عبد الله بن واقد أبو رجاء الهروي ، وكان من العباد ، وكان صديقا لسفيان الثوري ، قال أبو جعفر : فسأل رجل إسحاق ، عن أبي رجاء أكان ثقة ؟ قال : أوثق الثقة .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى يقول : أبو رجاء الخرساني ، هو عبد الله بن واقد الهروي ، يروي عنه : محمد بن كثير الذي ينزل بالثغر ، وأبو رجاء لم يسمع من عطاء .(@)(@@) قال يحيى : يزيد بن أبي حبيب يكنى أبا رجاء ، أبو حبيب اسمه : سويد .(@)(@@) ومحرز أبو رجاء الذي يروى عنه الكوفيون هو شامي .(@)(@@) وقال في موضع آخر : أبو رجاء الذي يروى عنه يعلى الطنافسي PageV02P539 اسمه : محرز ، ويروي عنه : محمد بن عبيد وهو شامي .(@)(@@) 976 - حدثني إبراهيم بن الجنيد الختلي ، قال : حدثنا نصر بن علي الأزدي ، قال : حدثنا نوح بن قيس ، عن أبي الرجاء محمد بن سيف ، عن قتادة ، قال : نزل الكوفة ألف وخمسون رجلا من أصحاب النبي [ صلى الله عليه وسلم ] ، وأربعة وعشرون من أهل بدر .(@)(@@) حدثني عبد الله بن أحمد ، قال : سمعت أبي ، يقول : أبو رجاء محمد بن سيف ، روى عنه : شعبة .(@)(@@) سمعت العباس بن محمد ، يقول : قال يحيى بن معين : أبو رجاء الذي يروى عنه : يزيد بن زريع ، محمد بن سيف هو حداني ، وقد روى عنه شعبة .(@)(@@) قال : وسمعت العباس يقول : سمعت يحيى بن معين يقول : ومطر بن طهمان الوراق ، هو أبو رجاء .(@)(@@) قال يحيى : وأبو رجاء الكلبي ثقة .(@)(@@) قال يحيى : وأبو رجاء العطاردي عمران بن تيم .(@)(@@) حدثنا العباس بن محمد ، قال : حدثنا يحيى قال : حدثنا [ عبد الله بن ] إدريس ، عن [ شعبة ، عن ] أبي رجاء ، قال : سألت الحسن عن أهل البصرة وأهل الكوفة ، قال : كان يبدأ بأهل الكوفة . PageV02P540(@)(@@) 977 - حدثنا محمد بن بشار ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، قال : سمعت أبا رجاء محمد بن سيف ، عن عكرمة في هذه الآية : ^ ( الذي أعطى كل شيء خلقه ثم هدى ) ^ قال : أما رأيتم الرجل 
ms279	 يسوق البعير فيتخلف لحاجة ، فيقوم البعير ينتظره ذاك منه .(@)(@@) حدثنا عبد الرحمن بن محمد بن سلام الطرسوسي ، قال : حدثنا يعقوب ابن إسحاق الحضرمي ، قال : أخبرني المرجى بن رجاء اليشكري ، انتهى . PageV02P541(@)(@@)(@@)(@@) ||| ( من كنيته أبو الربيع )(@)(@@)(@@)(@@) $ * أبو الربيع سليمان بن عبد الرحمن بن عبيد بن فيروز .(@)(@@)(@@)(@@) $ * وأبو الربيع سليمان بن عبد العزيز ، روى عنه : العباس بن عبد العظيم .(@)(@@)(@@)(@@) $ * وأبو الربيع سليمان بن داود الأحول بغدادي ، عثمان بن حرزاذ عنه .(@)(@@)(@@)(@@) $ * وأبو الربيع سليمان ، يروي عنه : ابن المبارك .(@)(@@)(@@)(@@) $ * وأبو الربيع أشعث بن سعيد السمان بصري .(@)(@@)(@@)(@@) $ * وأبو الربيع محمد بن زياد قاضي سمشاط ، ليس بشيء هو .(@)(@@)(@@)(@@) $ * ( 1 / 175 ) وأبو الربيع خلف بن مهران مصري ، روي عنه أبو عبيدة ابن الحداد .(@)(@@)(@@)(@@) $ * وأبو الربيع فرقد ، روى عنه : الثوري .(@)(@@)(@@)(@@) $ * وأبو الربيع هلواث .(@)(@@) 978 - حدثنا محمد بن إسماعيل الصائغ ، قال : حدثنا يحيى بن معين ، قال : حدثنا أبو عبيدة بن واصل الحداد ، قال حدثني خلف بن مهران أبو الربيع ، قال : حدثني عباس الأحول ، عن صالح بن دينار ، عن عمرو بن الشريد ، قال سمعت الشريد يقول : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من قتل عصفورا عبثا عج إلى الله يوم القيامة ، وقال : يا رب إن فلانا قتلني عبثا ، ولم يقتلني لمنفعة .(@)(@@) 979 - قال : حدثني بعض أصحابنا ، عن مسدد ، قال : حدثنا PageV02P542 عبد الواحد بن زياد ، قال : سمعت إسماعيل ، أنبأ الربيع ، عن مجاهد ، قال : قلت : لابن عمر : أي ثوب واحد أحب إليك أن أصلي فيه ؟ قال : القميص .(@)(@@) 980 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : حدثنا عبد الله بن المبارك ، عن سليمان أبي الربيع الهمداني ، عن إبراهيم ، قال : التقت جارية لأبي مسعود ، وجارية لابن مسعود ، وأخبرت كل واحدة عن صاحبها أنه يشرب النبيذ في الجرار ، أو قال الأخضر ، شك عبد الله .(@)(@@) وقال محمد بن إسماعيل البخاري : أشعث أبو الربيع السمان واسطي .(@)(@@) وسليمان القافلاني كنيته أبو الربيع ، وليس بشيء .(@)(@@) 981 - حدثنا بشر بن عبد الوهاب ، قال : حدثنا وكيع ، عن سفيان ، عن فرقد أبي الربيع ، عن سعيد بن جبير في 
ms280	 نذر رجل أن يحج ، ولم يحج حجة الإسلام ، قال : تجزئه حجة عنهما جميعا .(@)(@@) سمعت عبد الله بن أحمد ، قال : سمعت أبي يقول : أبو الربيع هلواث الثوري ، يحدث عنه : سفيان الثوري .(@)(@@) قال : وحدثني عبد الله بن أحمد ، قال : سمعت أبي يقول : أبو الربيع هلواث الثوري ، يحدث عنه : سفيان الثوري .(@)(@@) قال : وحدثني عبد الله بن أحمد ، قال : حدثنا أبي ، قال : حدثنا يحيى ابن سعيد ، عن سفيان ، عن أبي الربيع هلواث . PageV02P543(@)(@@)(@@)(@@) ||| ( من كنيته أبو رافع ، وأبو راشد )(@)(@@)(@@)(@@) $ * أبو رافع الصائغ نفيع ، روى عنه : ثابت البناني ، وقتادة .(@)(@@)(@@)(@@) $ * وأبو رافع إسماعيل بن رافع .(@)(@@)(@@)(@@) $ * وأبو راشد المثنى بن زرعة ، يروي عن : محمد بن إسحاق .(@)(@@)(@@)(@@) $ * وأبو رهم أحزاب ابن أسيد .(@)(@@)(@@)(@@) $ * وأبو راشد التنوخي ، يحدث عنه : صفوان بن عمرو .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى يقول : أبو رافع الصائغ ، اسمه نفيع ، وهو الذي يحدث عن خلاس ، وهو أبو رافع الذي يروي عن : أبي بكر الصديق في حديث الكلبي .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : قد روى إسماعيل بن عياش ، عن أبي رافع [ وهو إسماعيل بن رافع ] .(@)(@@) 982 - حدثنا العباس بن محمد ، قال : حدثنا يحيى بن معين ، قال : حدثنا هشام بن يوسف ، عن ابن جريج ، قال : أخبرني إسماعيل بن أمية ، عن أيوب بن خالد ، عن أبي رافع مولى أم سلمة ، عن أبي هريرة ، أن النبي [ صلى الله عليه وسلم ] أخذ بيده ، فقال : خلق الله التربة يوم السبت ، وذكر الحديث .(@)(@@) قال أبو الفضل : أبو رافع هذا هو عندي عبد الله بن رافع مولى أم سلمة . PageV02P544(@)(@@) 983 - حدثنا محمد بن عوف ، وعمران بن بكار ، قالا ، حدثنا أبو المغيرة ، قال : ثنا صفوان بن عمرو ، قال أخبرني أبو راشد التنوخي ، عن يزيد بن ميسرة ، قال : إن مسلمين أحد أصحاب الكهف حين عثروا عليه ، وأنكروا سلعته ، ذهبوا به يجرونه إلى ملكهم ، فقال : اللهم ليدخل معي اليوم منك إلى هذا الملك روح تؤيدني به عليه ، قال يزيد بن ميسرة ، فقلتها حين ( 1 / 176 ) دخلت على العباس بن الوليد ، وهو يقتل 