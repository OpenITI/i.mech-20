ms41	 ، غرثان موشحها ، % حسانة الجيد واللبات والشعر % 5(@)(@@) % لو دب ذر رويدا فوق قرقرها ، % لأثر الذر فوق الثوب في البشر % % 6(@)(@@) % قالت قريبة لما طال بي سقمي % % وأنكرت بي انتقاص السمع والبصر : % 7(@)(@@) % يا ليتني أفتدي ما قد تهيم به % ببعض لحمي وبعض النقص عن عمري % % 8(@)(@@) % قد يعلق القلب حبا ، ثم يتركه % خوف المقال وخوف الكاشح الأشر % 9(@)(@@) % دع حبها ، وتناس الحب تلق به ، % واصبر ، وكن كصريع قام من سكر % % 10(@)(@@) % فقلت قولا مصيبا غير ذي خطل % أتى به حبها في فطنة الفكر % PageV01P172 11(@)(@@) % سمعي وط في حليفاها على جسدي ، % فكيف أصبر عن سمعي وعن بصري % % 12(@)(@@) % لو تابعاني ، على أن لا اكلمها ، % إذا لقضيت من أوطارها وطري % % 13(@)(@@) % دل الفؤاد عليها بعض نسوتها ، % ونظرة عرضت كانت من القدر % 14(@)(@@) % وقول بكر : ألم تلمم لنسألهم ، % وانظر ، فلا بأس بالتسليم والنظر % % 15(@)(@@) % لا انس موقفها وهنا وموقفنا ، % وتربها بترابانا على خطر % % 16(@)(@@) % وقولها ، ودموع العين تسبقها % % في نحرها : دين هذا القلب من عمر % PageV01P173 البحر : بسيط تام 1(@)(@@) % يا صاحبي ، قفا نستخبر الدارا ، % أقوت فهاجت لنا ب لنعف تذكارا % % 2(@)(@@) % تبدل الربع ممن كان يسكنه ، % أدم الظباء به يمشين أسطارا % % 3(@)(@@) % وقد أرى مرة سربا به حسنا % مثل الجآذر أثيابا وأبكارا % % 4(@)(@@) % فيهن هند ، وهند لا شبيه لها ، % ممن أقام من الجيران أو سارا % % 5(@)(@@) % هيفاء مقبلة عجزاء مدبرة % تخالها في ثياب العصب دينارا % % 6(@)(@@) % تفتر عن ذي غروب ، طعمه ضرب ، % تخاله بردا من مزنة مارا % % 7(@)(@@) % كأن عقد وشاحيها على رشإ % يقرو من الروض روض الحزن أثمارا % % 8(@)(@@) % قامت تهادى وأتراب لها معها % % هونا تدافع سيل الزل إذ مارا % % 9(@)(@@) % يممن مورقة الأفنان ، دانية ، % وفي الخلاء ، فما يؤنسن ديارا % % 10(@)(@@) % قالت : لو ان أبا الخطاب وافقنا ، % فنلهو اليوم ، أو تنشدن أشعارا % % PageV01P174 11(@)(@@) % فلم يرعهن إلا العيس طالعة ، % يحملن بالنعف ركابا وأكوارا % % 12(@)(@@) % وفارس معه البازي ، فقلن لها : % ها هم أولاء وما أكثرن إكثارا % % 13(@)(@@) % لما وقفنا وغيبنا ركائبنا % % بدلن بالعرف بعد 
ms42	 الرجع إنكارا % % 14(@)(@@) % قلن : انزلوا نعمت دار بقربكم ، % أهلا وسهلا ، من زائر زارا % % 15(@)(@@) % لما ألمت باصحابي وقد هجعوا ، % حسبت وسط رجال القوم عطارا % % 16(@)(@@) % من طيب نشر التي نامتك إذ طرقت % ونفحة المسك والكافور إذ ثارا % % 17(@)(@@) % فقلت : من ذا المحيي ؟ وانتبهت له ، % أم من محدثنا هذا الذي زارا ؟ % 18(@)(@@) % قالت : محب رماه الحب آونة ، % وهيجته دواعي الحب إذ حارا % % 19(@)(@@) % حلي إزارك سكنى غير صاغرة % إن شئت و جزي محبا ب لذي سارا % % 20(@)(@@) % فقد تجشمت من طول السرى تعبا % وفي الزيارة قد أبلغت أعذارا % % PageV01P175 21(@)(@@) % إن الكواكب لا يشبهن صورتها ، % وهن أسوأ منها ، بعد ، أخبارا % % PageV01P176 البحر : بسيط تام 1(@)(@@) % ألمم بعفراء إن أصحابك ابتكروا ، % وسلهم هل لديها اليوم منتظر % 2(@)(@@) % واها لعفراء ، إن دار بها قربت ، % فما أبالي ألام الناس أم عذروا % % 3(@)(@@) % وإن تبن غربة عنا بها قذف % فما تقضى الهوى منا ، ولا الوطر % % 4(@)(@@) % خود مفهفهة الأعلى ، إذا انصرفت ، % تكاد من ثقل الأرداف تنبتر % % 5(@)(@@) % تفتر عن ذي غروب طعمه عسل ، % مفلج النبت رفاف له أشر % 6(@)(@@) % كأن فاها ، إذا ما جئت طارقها ، % خمر ببيسان أوما عتقت جدر % 7(@)(@@) % شجت بماء سحاب زل عن رصف % من ماء أزهر لم يخلط به كدر % 8(@)(@@) % والعنبر الاكلف المسحوق خالطه ، % والزنجبيل ، ورند هاجه السحر % % 9(@)(@@) % حوراء ممكورة الساقين بهكنة % لا عيب في خلقها طول ولا قصر % % 10(@)(@@) % كأنها الشمس وافت يوم أسعدها ، % أو درة شوفت للبيع أو قمر % PageV01P177 11(@)(@@) % تقول إذ أيقنت أني مفارقها : % يا ليتني مت قبل اليوم يا عمر % PageV01P178 البحر : بسيط تام 1(@)(@@) % يا ليتني قد أجزت الحبل نحوكم % حبل المعرف ، أو جاوزت ذا عشر % 2(@)(@@) % إن الثواء بأرض لا أراك بها % % ف ستيقنيه ثواء حق ذي كدر % 3(@)(@@) % وما مللت ولكن زاد حبكم % وما ذكرتك ، إلا ظلت كالسدر % 4(@)(@@) % أذري الدموع كذي سقم يخامره ، % وما يخامر من سقم سوى الذكر % 5(@)(@@) % كم قد ذكرتك لو أجزى بذكركم % يا أشبه الناس كل الناس بالقمر % 6(@)(@@) % إني 
ms43	 لأجذل إن أمشي مقابله % حبا لرؤية من أشبهت في الصور % 7(@)(@@) % وما جذلت لشيء كان بعدكم ، % ولا منحت سواك الحب من بشر % % PageV01P179 البحر : كامل تام 1(@)(@@) % لمن الديار كأنهن سطور ، % تسدي معالمها الصبا وتنير % 2(@)(@@) % لعبت بها الأرواح بعد أنيسها % % نكباء تطرد السفا ودبور % 3(@)(@@) % دار لهند إذ تهيم بذكرها % % واذ الشباب المستعار نضير % % 4(@)(@@) % إذ تستبيك بجيد آدم شادن ، % در على لباته ، وشذور % % 5(@)(@@) % تلك لتي سبت الفؤاد فأصبحت % و لقلب رهن عندها مأسور % 6(@)(@@) % لو دب ذر فوق ضاحي جلدها ، % لأبان من آثارهن حدور % 7(@)(@@) % غراء واضحة الجبين كأنها % % قمر بدا للناظرين منير % 8(@)(@@) % جم العظام لطيفة أحشاؤها % % والمسك ، من أردانها ، منشور % % 9(@)(@@) % تفتر عن مثل الأقاحي شافها % % هزم أجش من السماك مطير % 10(@)(@@) % وله أثيث كالكروم مذيل % حسن الغدائر حالك مضفور % PageV01P180 11(@)(@@) % ومخضب رخص البنان كأنه % عنم ومنتفخ النطاق وثير % % 12(@)(@@) % قالت : ودمع العين يجري واكفا % كالدر يسبل تارة ويغور : % 13(@)(@@) % ب لله زرنا إن أردت وصالنا % % وآحذر أناسا كلهم مأمور % 14(@)(@@) % أن يأخذوك فكن فتى ذا فطنة % إن الكريم لدى الحذار صبور % % PageV01P181 البحر : طويل 1(@)(@@) % يقولون لي : أقصر ، ولست بمقصر ، % وحبك يا سكن الذي يحسم الصبرا % % 2(@)(@@) % على الهائم المشغوف بالوصل ما دعا % % حمام على أفنان دوحته وترا % % 3(@)(@@) % ثلاث حمامات وقوع إذا دعا % % رددن إليه الحزن إذ هيج الهدرا % % 4(@)(@@) % بصوت حزين مثكل متوجع % ونفس مريض القلب أورثنه ذكرا % % 5(@)(@@) % بكل كعاب طفلة غير حمشة % وتمشي الهوينا ما تجاوزه فترا % % 6(@)(@@) % وظلت تهادى ثم تمشي تأودا % وتشكو مرارا من قوائمها فترا % % 7(@)(@@) % إذا ما دعت بالمرط كيما تلفه % على الخصر ، أبدت من روادفها فخرا % % 8(@)(@@) % لعمري لقد كان الفؤاد مسلما % صحيحا فأمسى لا يطيق لها هجرا % % 9(@)(@@) % فجازي ودودا كان قبلك في الهوى % % دؤولا ، فقد اورثته السقم والأسرا % % 10(@)(@@) % أفي الحق ، إذ حكمتم ، فحكمتم % صوابا ، فما أخطأتم الظلم والكفرا ؟ % PageV01P182 البحر : كامل تام 1(@)(@@) % أأقام أمس خليطنا أم سارا ؟ % سائل بعمرك أي ذاك ختارا ؟ % 2(@)(@@) % وإخال 
ms44	 أن نواهم قذافة ، % كانت معاودة الفراق مرارا % % 3(@)(@@) % قال الرسول ، وقد تحدر واكف ، % فكففت منه مسبلا مدرارا : % 4(@)(@@) % أن سر فشيعنا وليس بنازع % لو شد فوق مطيه الأكوارا % % 5(@)(@@) % في حاجة جهد الصبابة قادها % % وبما يوافق للهوى الأقدارا % % 6(@)(@@) % قامت تراءى ب لصفاح كأنما % % عمدا تريد لنا بذاك ضرارا % % 7(@)(@@) % فبدت ترائب من ربيب شادن ، % ذكر المقيل إلى الكناس فصارا % % 8(@)(@@) % وجلت عشية بطن مكة إذ بدت ، % وجها يضيء بياضه الأستارا % % 9(@)(@@) % ك لشمس تعجب من رأى ويزينها % % حسب أغر ، إذا تريد فخارا % % 10(@)(@@) % سقيت بوجهك كل أرض جئتها ، % وبمثل وجهك نستقي الامطارا % % PageV01P183 11(@)(@@) % لو يبصر الثقف البصير جبينها % % وصفاء خديها العتيق لحارا % % 12(@)(@@) % وأرى جمالك فوق كل جميلة ، % وجمال وجهك يخطف الأبصارا % % 13(@)(@@) % إني رايتك غادة خمصانة ، % ريا الروادف لذة مبشارا % % 14(@)(@@) % محطوطة المتنين أكمل خلقها % % مثل السبيكة بضة معطارا % % 15(@)(@@) % تشفي الضجيع ببارد ذي رونق % لو كان في غلس الظلام ، أنارا % % 16(@)(@@) % فسقتك بشرة عنبرا وقرنفلا % والزنجبيل ، وخلط ذاك ، عقارا % % 17(@)(@@) % والذوب من عسل الشراة ، كأنما % % غصب الأمير تبيعه المشتارا % % 18(@)(@@) % وكأن نطفة بارد وطبرزدا % ومدامة قد عتقت أعصارا % % 19(@)(@@) % تجري على أنياب بشرة كلما % % طرفت ولا تدري بذاك غرارا % % 20(@)(@@) % يروى به الظمآن ، حين يشوفه % % لذ المقبل ، باردا ، مخمارا % % PageV01P184 21(@)(@@) % ويفوز من هي في الشتاء شعاره ، % أكرم بها دون اللحاف شعارا % % 22(@)(@@) % جودي لمحزون ذهبت بعقله ، % لم يقض منك بشيرة الأوطارا % % 23(@)(@@) % وإذا ذهبت أسوم قلبي خطة % من هجرها ألفيته خوارا % % 24(@)(@@) % واغرورقت عيناي حين أسومها % % والقلب هاج لذكرها استعبارا % % 25(@)(@@) % فبتلك اهذي ما حييت صبابة ، % وبها ، الغداة ، أشبب الأشعارا % % 26(@)(@@) % من ذا يواصل إن صرمت حبالنا % % أم من نحدث بعدك الأسرارا % % 27(@)(@@) % هيهات منك قعيقعان وأهلها % % بالحزنتين ، فشط ذاك مزارا ! % PageV01P185 البحر : كامل تام 1(@)(@@) % نعم الفؤاد مزارها محظور % بعد الصفاء ، وبيتها مهجور % 2(@)(@@) % لج البعاد بها وشط بركبها % % نائي المحل عن الصديق غيور % 3(@)(@@) % حذر قليل النوم ذو قاذورة % فطن ، بألباب الرجال بصير % % 4(@)(@@) % لم ينسني 
ms45	 ما قد لقيت ونأيها % % عني وأشغال عدت وأمور % 5(@)(@@) % ممشى وليدتها إلي ، وقد دنا % % من فرقتي يوم الفراق بكور % 6(@)(@@) % ومفيض عبرتها ومومى كفها % % ورداء عصب بيننا منشور % 7(@)(@@) % أن أرج رحلتك الغداة إلى غد ، % وثواء يوم ، إن ثويت ، يسير % % 8(@)(@@) % لما رآني صاحباي كأنني % % تبل بها أو موزع مقمور % 9(@)(@@) % وتبينا أن الثواء لبانة % مني ، وحبسهما علي كبير % % 10(@)(@@) % قالا : أنقعد أن نروح ؟ وما تشأ % % نفعل وأنت بأن تطاع جدير % PageV01P186 11(@)(@@) % إن كنت ترجو أن تلاقي حاجة ، % ف مكث فأنت على الثواء أمير % 12(@)(@@) % فأتيتها و لليل أدهم مرسل % وعليه من سدف الظلام ستور % 13(@)(@@) % رحبت حين لقيتها ، فتبسمت ، % وكذاكم ما يفعل المحبور % 14(@)(@@) % وتضوع المسك الذكي وعنبر % من جيبها ، قد شابه كافور % % 15(@)(@@) % كنا كمثل الخمر ، كان مزاجها % % بالماء لا رنق ، ولا تكدير % % 16(@)(@@) % فلئن تغير ما عهدت وأصبحت % صدفت ، فلا بذل ، ولا ميسور % % 17(@)(@@) % لبما تساعف باللقاء ولبها % % فرح بقرب مزارنا ، مسرور % % 18(@)(@@) % إذ لا تغيرها الوشاة ، فودها % % صاف نراسل مرة وتزور % 19(@)(@@) % لا تأمنن الدهر أنثى بعدها ، % إني لآمن غدرهن نذير % 20(@)(@@) % بعد التي أعطتك من أيمانها % % ما لا يطيق من العهود ثبير % PageV01P187 21(@)(@@) % فإذا وذلك كان ظل سحابة % نفحت به في المعصرات دبور % PageV01P188 البحر : متقارب تام 1(@)(@@) % أمن آل زينب جد البكور % نعم فلأي هواها تصير ؟ % 2(@)(@@) % أللغور أم أنجدت دارها % % وكانت قديما بعهدي تغور % % 3(@)(@@) % هي الشمس تسري على بغلة ، % وما خلت شمسا بليل تسير % % 4(@)(@@) % وما أنس من قولها ، % غداة منى إذ أجد المسير : % 5(@)(@@) % ألم تر أنك مستشرف ، % وأن عدوك حولي كثير ؟ % 6(@)(@@) % فإن جئت ، فأت على بغلة ، % فليس يؤاتي الخفاء البعير % 7(@)(@@) % فإنك عندي ، فيما اشتهيت ، % ت حتى تفارق رحلي أمير % 8(@)(@@) % نظرت بخيف منى نظرة % إليها فكاد فؤادي يطير % PageV01P189 البحر : خفيف تام 1(@)(@@) % أبهجر يودع الأجوار % أم مساء أم قصر ذاك بتكار ؟ % 2(@)(@@) % قربتني إلى قريبة عيني % % يوم ذي الثري ، والهوى المستعار % % 3(@)(@@) % ودواعي الهوى ، وقلب ، إذا % % لج ، لجوج ، فما 
ms46	 يكاد ، يصار % % 4(@)(@@) % قمرته فؤاده أخت رئم % ذات دل خريدة معطار % 5(@)(@@) % طفلة ، وعثة الروادف ، خود ، % كمهاة انساب عنها الصوار % % 6(@)(@@) % حرة الخد خدلة الساق مهضو % % مهضومة كشح يضيق عنها الشعار % % 7(@)(@@) % نظرت حين وازن الركب بالنخ % ل ظلاما ودونها الأستار % 8(@)(@@) % ودعاني ما قال فيها عتيق % وهو ب لحسن عالم بيطار % 9(@)(@@) % قول نسوانها إذا حفل النس % في مجلس ، وقل الإمار % % 10(@)(@@) % أنها عفة عن الخلق لوا % % والطعمة التي هي عار % % PageV01P190 11(@)(@@) % نعتوها فأحسنوا النعت حتى % % كدت من حسن نعتها أستطار % 12(@)(@@) % فثنائي عليك خير ثناء ، % إن تقربت ، أو نأت بك دار % 13(@)(@@) % وبك الهم ، إن مشيت صحيحا ، % وسواري الأحلام ، والأشعار % % 14(@)(@@) % أنتم همنا وكبر منانا % % وأحاديثنا وإن لم تزاروا % % 15(@)(@@) % وأرى اليوم ، إن نأيت ، طويلا ، % والليالي إذا دنوت قصار % 16(@)(@@) % لم يقارب جمالها حسن شيء % غير شمس الضحى عليها النهار % 17(@)(@@) % فلو أني خشيت أو خفت قتلا % غير أن ليس تدفع الأقدار % % 18(@)(@@) % لاتقيت التي بها يفتن الناس ، % ولكن لكل شيء قدار % % 19(@)(@@) % فلنفسي أحق ب للوم عمدا % حيث ما كنت يوم لف الجمار % % PageV01P191 البحر : خفيف تام 1(@)(@@) % ما شجاك الغداة من رسم دار % دارس الربع مثل وحي السطار % 2(@)(@@) % بدل الربع بعد نعم نعاما % وظباء يخدن كالأمهار % % 3(@)(@@) % عجت فيه وقلت للركب عوجوا % % فثنى الركب كل حرف خيار % % 4(@)(@@) % ثم قالوا : اربعن عليك وقض ل % يوم بعض الهموم والأوطار % 5(@)(@@) % عز شيء أن يقضي اليوم حاجا % بوقوف منا على الأكوار % 6(@)(@@) % إن تكن دار آل نعم قواء % خاليا جوها من الأجوار % % 7(@)(@@) % فلقدما رأيت فيها مهاة ، % في جوار أوانس أبكار % 8(@)(@@) % ذكرتني الديار نعما وأترا % % با حسانا نواعما كالصوار % 9(@)(@@) % آنسات مثل التماثيل ، لعسا ، % مع خود خريدة معطار % % 10(@)(@@) % ومقاما قد أقمته مع نعم % وحديثا مثل الجنى المشتار % PageV01P192 11(@)(@@) % نتقي العين تحت عين سجوم % وبلها في دجى الدجنة ساري % % 12(@)(@@) % و كتننا بردين من جيد العص % ب معا ، بين مطرف ، وشعار % % 13(@)(@@) % بت في نعمة وبات وسادي 
ms47	 % % معصما بين دملج وسوار % % 14(@)(@@) % ثم إن الصباح لاح ولاحت % أنجم الصبح مثل جزع العذاري % % 15(@)(@@) % فنهضنا نمشي نعفي مروطا % وبرودا ، وهنا ، على الآثار % % 16(@)(@@) % وتولى نواعم خفرات % يتهادين ك لظباء السواري % % 17(@)(@@) % مثقلات ، يزجين بدر سعود ، % وهي في الصبح مثل شمس النهار % % PageV01P193 البحر : وافر تام 1(@)(@@) % تقول وعينها تذري دموعا % لها نسق على الخدين تجري : % 2(@)(@@) % ألست أقر من يمشي لعيني ، % وأنت لهم في الدنيا وذكري % % 3(@)(@@) % اما لك حاجة فيما لدينا ، % تكن لك عندنا حقا ، فأدري % % 4(@)(@@) % أمن سخط علي صددت عني % % حملت جنازتي وشهدت قبري % % 5(@)(@@) % أشهرا كله إلا ثلاثا % أقمت على مصارمتي وهجري ! % PageV01P194 البحر : خفيف تام 1(@)(@@) % كتبت تعتب الرباب وقالت : % قد أتانا ما قلت في الأشعار % 2(@)(@@) % سادرا عامدا تشهر ب سمي % % كي يبوح الوشاة بالأسرار % 3(@)(@@) % فاعتزلنا ، فلن نجدد وصلا ، % ما أضاءت نجوم ليل لسار % 4(@)(@@) % قلت لا تصرمي لتكثير واش % كاذب ، في الحديث والأخبار % % 5(@)(@@) % لم نبح عنده بسر ، ولكن % كذب ما أتاك والجبار % 6(@)(@@) % لا تطيعي ، فإنني لم أطعه ، % أنت أهوى الأحباب والأجوار % % PageV01P195 البحر : خفيف تام 1(@)(@@) % نام صحبي ، وبات نومي عسيرا ، % أرقب النجم موهنا أن يغورا % % 2(@)(@@) % إذ تذكرت قول هند لتربيها ، % ورحنا نيمم التجميرا % % 3(@)(@@) % قلن بالله للفتى عج قليلا % ليس أن عجت للعتاب كثيرا % % 4(@)(@@) % ف لتقينا فرحبت ثم قالت : % حلت عن عهدنا وكنت جديرا % % 5(@)(@@) % أن ترد الواشين عني ، كما أعصي ، % إذا ما ذكرت عندي ، أميرا % % 6(@)(@@) % قلت : أنت المنى وكبر هوانا % % ف عذري يا خليلتي معذورا % % 7(@)(@@) % وتذكرت قولها لي ، لدى الميل ، % ل وكفت دموعها أن تمورا % % 8(@)(@@) % أسأل الله عالم الغيب أن تر % جع يا حب سالما مأجورا % % 9(@)(@@) % إن تكن ليلتي بنعمان طالت % فبما قد يكون ليلي قصيرا % % 10(@)(@@) % يا خليلي لا تقيما ببصرى % % وحفير فما أحب حفيرا % % PageV01P196 11(@)(@@) % فإذا ما مررتما بعمان ، % فأقلا بها الثواء وسيرا % % 12(@)(@@) % يا خليلي هجرا تهجيرا % ثم روحا وأحكما لي المسيرا % % 13(@)(@@) % يا خليلي ما تشيران إني % % فاعل ما 
ms48	 امرتما ، فأشيرا % % 14(@)(@@) % ضربا الأمر ياعة ، ثم قالا : % قد رضيناك ما صطحبنا أميرا % % 15(@)(@@) % إن خطبا علي حقا يسيرا % % أن أرى منكما بعيرا حسيرا % % 16(@)(@@) % إنما قصرنا وإن حسر السي % بعيرا ، أن نستجد بعيرا % % PageV01P197 البحر : خفيف تام 1(@)(@@) % راح صحبي ولم أحي النوارا % % وقليل لو عرجوا أن تزارا % % 2(@)(@@) % ثم إما يسرون من آخر اللي % ل وإما يعجلون بتكارا % % 3(@)(@@) % ولقد قلت ليلة البين إذ جد % رحيل وخفت أن أستطارا % % 4(@)(@@) % لخليل يهوى هوانا مؤات ، % كان لي عند مثلها نظارا % % 5(@)(@@) % يا خليل اربعن علي وعينا % % من الحزن تهملان ابتدارا % % 6(@)(@@) % ههنا ف حبس البعيرين و حذر % زائدات العيون أن تستنارا % % 7(@)(@@) % إنني زائر قريبة قد يع % % لم ربي أن لا أطيق صطبارا % % 8(@)(@@) % قال : ف فعل لا يمنعنك مكاني % % من حديث تقضي به الاوطارا % % 9(@)(@@) % والتمس ناصحا قريبا من الورد ، % د يحس الحديث والأخبارا % % 10(@)(@@) % فبعثنا مجربا ساكن الري % % خفيفا ، معاودا ، بيطارا % % PageV01P198 11(@)(@@) % فأتاها فقال : ميعادك السر % ح إذا الليل سدل الأستارا % % 12(@)(@@) % فكمنا حتى إذا فقد الصو % ت دجى المظلم البهيم فحارا % % 13(@)(@@) % قلت ، لما بدت لصحبي : إني % % أرتجي عندها لديني يسارا % % 14(@)(@@) % ثم أقبلت رافع الذيل أخفي ل % الوطء ، أخشى العيون والنظارا % % 15(@)(@@) % ف لتقينا فرحبت حين سلم % ت وكفت دمعا من العين مارا % % 16(@)(@@) % ثم قالت عند العتاب : رأينا % % منك عنا تجلدا وازورارا % % 17(@)(@@) % قلت : كلا لاه بن عمك بل خف % نا أمورا كنا بها أغمارا % % 18(@)(@@) % فجعلنا الصدود لما رأينا % % قالة الناس بيننا أستارا % % 19(@)(@@) % وركبنا حالا ، لنكذب عنا % % قول من كان بالبنان أشارا % % 20(@)(@@) % و قتصرت الحديث دون الذي قد % كان من قبل يعلم الأسرارا % % PageV01P199 21(@)(@@) % ليس كالعهد إذ عهدت ، ولكن % % أوقد الناس بالأحاديث نارا % % 22(@)(@@) % فلذاك الإعراض عنك ، وما % % آثر قلبي عليك أخرى اختيارا % % 23(@)(@@) % ما أبالي ، إذا النوى قربتكم % فدنوتم ، من حل ، أو كان سارا % % 24(@)(@@) % و لليالي إذا نأيت طوال % وأراها إذا دنوت قصارا % % 25(@)(@@) % فعرفت القبول منها لعذري ، % إذ رأتني 
ms49	 منها أريد عتذارا % % 26(@)(@@) % ثم لانت ، وسامحت بعد منع ، % وأرتني كفا تزين السوارا % % 27(@)(@@) % فتناولتها ، فمالت كغصن ، % حركته ريح عليه فحارا % % 28(@)(@@) % وأذاقت بعد العلاج لذيذا % كجنى النحل شاب صرفا عقارا % % 29(@)(@@) % ثم كانت دون اللحاف لمشغو % % ف معنى بها مشوق شعارا % % 30(@)(@@) % واشتكت شدة الإزار من ال % % بهر وألقت عنها لدي الخمارا % % PageV01P200 31(@)(@@) % حبذا رجعها إليها يديها % % في يدي درعها تحل الإزارا % % 32(@)(@@) % ثم قالت ، وبان ضوء ، من الصب % % ح منير للناظرين أنارا % % 33(@)(@@) % يا ابن عمي ، فدتك نفسي ، إني % % أتقي كاشحا ، إذا قال ، جارا % % PageV01P201 البحر : كامل تام 1(@)(@@) % لمن الديار رسومها قفر ، % لعبت بها الأرواح والقطر % 2(@)(@@) % وخلا لها من بعد ساكنها % % حجج خلون ثمان أو عشر % 3(@)(@@) % لأسيلة الخدين ، واضحة ، % يعشى بسنة وجهها البدر % 4(@)(@@) % درم مرافقها ، ومئزرها % % لا عاجز تفل ولا صفر % % 5(@)(@@) % والزعفران على ترائبها % % شرق به اللبات والنحر % % 6(@)(@@) % وزبرجد ومن الجمان به % سلس النظام ، كأنه جمر % % 7(@)(@@) % وبدائد المزجان في قرن ، % والدر ، والياقوت ، والشذر % % PageV01P202 البحر : منسرح 1(@)(@@) % هل عند رسم برامة خبر ؟ % أم لا ، فأي الأشياء تنتظر ؟ % 2(@)(@@) % وقفت في رسمها أسائله % والدمع مثل الجمان منحدر % 3(@)(@@) % لا يرجع الرسم بالبيان ، وهل % % يفقه رجعاه حين يندثر ؟ % 4(@)(@@) % قد ذكرتني الديار إذ درست % و لشوق مما تهيجه الذكر % 5(@)(@@) % لا أنس ، طول الحياة ما بقيت % بطيبة روضة لها شجر % % 6(@)(@@) % ممشى رسول إلي يخبرني % % عنهم ، عشيا ، ببعض ما ائتمروا % % 7(@)(@@) % أو مجلس النسوة الثلاث لدى ل % الخيمات ، حتى تبلج السحر % % 8(@)(@@) % ثم انطلقنا ، وعندنا ، ولنا % % فيهن ، لو طال ليلنا ، وطر % % 9(@)(@@) % فيهن هند ، والهم ذكرتها ، % تلك التي لا يرى لها خطر % 10(@)(@@) % قباء ، إن أقبلت ، مبتلة ، % والبوص منها كالقور منعفر % % PageV01P203 11(@)(@@) % غراء في غرة الشباب من الح % % ور اللواتي يزينها خفر % 12(@)(@@) % تفتر عن واضح ، مقبله % مفلج ، واضح ، له أشر % 13(@)(@@) % وقولها للفتاة ، إذ أفد البين : % أغاد ، أم رائح عمر ؟ % 14(@)(@@) % عجلان لم يقض بعد حاجته ، % ألا تأنى يوما فينتظر ؟ % 15(@)(@@) % الله جار له 
ms50	 إذا نزحت % دار به ، أو بدا له سفر % % 16(@)(@@) % رأيتها مرة ونسوتها ، % كأنها من شعاعها القمر % % 17(@)(@@) % يمشين في الخز والمراجل أن % % يعرف آثارهن مقتفر % 18(@)(@@) % يدنين من خشية العيون على % % مثل المصابيح زانها الخمر % PageV01P204 البحر : كامل تام 1(@)(@@) % أعرفت يوم لوى سويقة دارا ، % هاجت عليك رسومها ستعبارا % % 2(@)(@@) % وذكرت هندا ، فاشتكيت صبابة ، % لولا تكفكف دمع عينك مارا % % 3(@)(@@) % وذكرتها حوراء ، لينة المطا ، % مثل المهاة خريدة معطارا % % 4(@)(@@) % وإذا تنازعك الحديث تظرفت % انف الحديث ، ولم ترد إكثارا % % 5(@)(@@) % وإذا نظرت إلى مناكب حسنها ، % كملت وزدت بحسنها ستهتارا % % 6(@)(@@) % إن العواذل قد بكرن يلمنني % % وحسبت أكثر لومهن ضرارا % % 7(@)(@@) % وزعمن أن وصال عبدة عائد % عارا علي ، وليس ذلك عارا % % 8(@)(@@) % والنفس يمنعها الحياء فترعوي ، % وتكاد تغلبني إليك مرارا % % 9(@)(@@) % ما يذكر اسمك في حديث عارض ، % إلا استخف له الفؤاد ، فطارا % % 10(@)(@@) % هل في هوى رجل جناح ، زائر % جهرا ، أحب خريدة معطارا % % PageV01P205 11(@)(@@) % أسف عليك ، يهيم حين قتلته ، % وسلبته لب الفؤاد جهارا % % PageV01P206 البحر : منسرح 1(@)(@@) % يا من لقلب متيم ، كلف ، % يهذي بخود مريضة النظر % 2(@)(@@) % تمشي الهوينا إذا مشت فضلا % وهي كمثل العسلوج في الشجر % 3(@)(@@) % ما إن طمعنا بها ، ولا طمعت ، % حتى التقينا ليلا على قدر % 4(@)(@@) % ما زال طرفي يحار ، إذ نظرت ، % حتى رأيت النقصان في بصري % % 5(@)(@@) % أبصرتها ليلة ونسوتها ، % يمشين بين المقام والحجر % % 6(@)(@@) % بيضا حسانا ، خرائدا ، قطفا ، % يمشين هونا كمشية البقر % % 7(@)(@@) % قد فزن ب لحسن والجمال معا % وفزن رسلا ب لدال والخفر % 8(@)(@@) % ينصتن يوما لها ، إذانظقت ، % كيما يفضلنها على البشر % % 9(@)(@@) % قالت لترب لها ملاطفة : % لنفسدن الطواف في عمر % 10(@)(@@) % قالت : تصدي له ليبصرنا % % ثم غمزيه يا أخت في خفر % PageV01P207 11(@)(@@) % قالت لها : قد غمزته ، فأبى ، % ثم أسبطرت تسعى على أثري % % 12(@)(@@) % من يسق بعد المنام ريقتها % % يسق بمسك ، وبارد خصر % % 13(@)(@@) % حوراء ممكورة محببة % عسراء للشكل عند مجتمر % PageV01P208 البحر : منسرح 1(@)(@@) % قد هاج حزني ، وعادني ذكري ، % يوم لتقينا عشية النفر % % 2(@)(@@) % بالفج من نحو 
ms51	 دار عقبة ، والح % % ج سريع الطواف والصدر % % 3(@)(@@) % إذ كدت لولا الحيا يورعني % % أبدي الذي قد كتمت ، بالنظر % 4(@)(@@) % كأن ثوبا ، لما التقى الرك % % ب ، تدنيه عليها ، يشف عن قمر % % 5(@)(@@) % تلين ، حتى يقول : قد خدعت ! % من لم يكن ب لنساء ذا خبر % 6(@)(@@) % حتى إذا ما التمست غرتها ، % يوم لتقينا عشية النفر % % PageV01P209 البحر : متقارب تام 1(@)(@@) % لمن طلل موحش أقفرا % % فأصبح معروفه منكرا % % 2(@)(@@) % ولو أنه يستطيع لجوا % % لأخبر ، إن سيل أن يخبرا % % 3(@)(@@) % ولكنه غيرته الصبا ، % فأمست معالمه دثرا % % 4(@)(@@) % وكل مسف له هيدب ، % إذا ما حدا رعده أمطرا % % 5(@)(@@) % وقد كنت ألقى به شادنا % قطوف الخطى ناعما أحورا % % 6(@)(@@) % أسيل المحيا هضيم الحشا % % كشمس الضحى واضحا أزهرا % % 7(@)(@@) % أقول لمن لام في حبها : % أرى لك في الرأي أن تقصرا % % 8(@)(@@) % فلست مطاعا فلا تلحني % % وليست بأهل لأن تهجرا % % 9(@)(@@) % فكم من اخ لام في حبها ، % فأقصر من قبل أن أقصرا % % PageV01P210 البحر : رمل تام 1(@)(@@) % آذنت هند ببين مبتكر % وحذرت البين منها ، فاستمر % 2(@)(@@) % أرسلت هند إلينا ناصحا % بيننا : إيت حبيبا قد حضر % 3(@)(@@) % فاعلمن أن محبا زائر ، % حين تخفى العين عنه والبصر % 4(@)(@@) % قلت : أهلا بكم من زائر % أورث القلب عناء وذكر % 5(@)(@@) % فتأهبت لها ، في خفية ، % حين مال الليل واجتن القمر % % 6(@)(@@) % بينما أنظرها في مجلس ، % إذ رماني الليل منها بسكر % 7(@)(@@) % لم يرعني بعد أخذي هجعة % % غير ريح المسك منها والقطر % 8(@)(@@) % قلت : من هذا ؟ فقالت : هكذا % % أنا من جشمته طول السهر % 9(@)(@@) % ما أنا والحب قد أبلغني % % كان هذا بقضاء وقدر % 10(@)(@@) % ليت أني لم أكن علقتكم % كل يوم أنا منكم في عبر % % PageV01P211 11(@)(@@) % كلما توعدني ، تخلفني ، % ثم تأتي حين تأتي بعذر % 12(@)(@@) % سخنت عيني لئن عدت لها % % لتمدن بحبل منبتر % % 13(@)(@@) % عمرك لله أما ترحمني % % أم لنا قلبك أقسى من حجر % 14(@)(@@) % قلت ، لما فرغت من قولها ، % ودموعي كالجمان المنحدر : % 15(@)(@@) % أنت ، يا قرة عيني ، فاعلمي ، % عند نفسي عدل سمعي وبصر % 16(@)(@@) % فاتركي 
ms52	 عنك ملامي ، واعذري ، % و تركي قول أخي الإفك الأشر % 17(@)(@@) % فأذاقتني لذيذا خلته % ذوب نحل شيب بالماء الخصر % 18(@)(@@) % ومدام عتقت في بابل % مثل عين الديك أو خمر جدر % 19(@)(@@) % فتقضت ليلتي في نعمة ، % مرة ألثمها غير حصر % 20(@)(@@) % وأفري مرطها عن مخطف % ضامر الأحشاء ، فعم المؤتزر % % PageV01P212 21(@)(@@) % فلهونا ليلنا حتى إذا % % طرب لديك وهاج المدكر % 22(@)(@@) % حركتني ثم قالت جزعا % ودموع العين منها تبتدر : % 23(@)(@@) % قم صفي النفس ، لا تفضحني ، % قد بدا الصبح وذا برد السحر % 24(@)(@@) % فتولت في ثلاث خرد % كدمى الرهبان أو عين البقر % % 25(@)(@@) % لست أنسى قولها ، ما هدهدت % ذات طوق فوق غصن من عشر % 26(@)(@@) % حين صممت على ما كرهت % هكذا يفعل من كان غدر % PageV01P213 البحر : رمل تام 1(@)(@@) % هيج القلب مغان وصير % دارسات قد علاهن الشجر % 2(@)(@@) % ورياح الصيف قد أذرت بها % % تنسج الترب فنونا والمطر % 3(@)(@@) % ظلت فيه ، ذات يوم ، وقفا ، % أسأل المنزل هل فيه خبر % 4(@)(@@) % للتي قالت لأتراب لها % % قطف ، فيهن أنس وخفر % % 5(@)(@@) % إذ تمشين بجو مؤنق ، % نير النبت تغشاه الزهر % 6(@)(@@) % بدماث سهلة زينها % % يوم غيم لم يخالطه قتر % 7(@)(@@) % قد خلونا ، فتمنين بنا ، % إذ خلونا اليوم نبدي ما نسر % 8(@)(@@) % فعرفن الشوق في مقلتها % % وحباب الشوق يبديه النظر % % 9(@)(@@) % قلن يسترضينها : منيتنا % % لو أتانا اليوم ، في سر ، عمر % % 10(@)(@@) % بينما يذكرنني أبصرنني % % دون قيد الميل يعدو بي الأغر % PageV01P214 11(@)(@@) % قالت الكبرى : أتعرفن الفتى ؟ % قالت الوسطى : نعم ، هذا عمر % % 12(@)(@@) % قالت الصغرى ، وقد تيمتها : % قد عرفناه ، وهل يخفى القمر ! % 13(@)(@@) % ذا حبيب لم يعرج دوننا ، % ساقه الحين إلينا ، والقدر % % 14(@)(@@) % فأتانا ، حين ألقى بركه % جمل الليل عليه و سبطر % 15(@)(@@) % ورضاب المسك من أثوابه ، % مرمر الماء عليه فنضر % 16(@)(@@) % قد أتانا ما تمنينا ، وقد % % غيب الأبرام عنا والقذر % PageV01P215 البحر : بسيط تام 1(@)(@@) % ما كنت أشعر ، إلا مذ عرفتكم ، % أن المضاجع تمسي تنبت الإبرا % % 2(@)(@@) % لقد شقيت ، وكان الحين لي سببا % أن علق القلب قلبا يشبه الحجرا % % 3(@)(@@) % قد لمت 
ms53	 قلبي ، وأعياني بواحدة ، % فقال لي : لا تلمني وادفع القدرا ! % 4(@)(@@) % إن أكره الطرف يحسر دون غيركم ، % ولست أحسن إلا نحوك النظرا % % 5(@)(@@) % قالوا : صبوت ، فلم أكذب مقالتهم ، % وليس ينسى الصبى إن واله كبرا % % PageV01P216 البحر : رمل تام 1(@)(@@) % % وهموم حاضرات وذكر % 2(@)(@@) % ومفقال الخود ، لكا واجهت % جهة الركب وعيناها درر : % 3(@)(@@) % يا أبا الخطاب ما جشمتنا % % حجة فيها عناء وسهر ! % 4(@)(@@) % بعد بر الله ، إلا نظرة % منك ، ليس لها عندي خطر % % 5(@)(@@) % قالت : ما جشمتنا من حبكم ، % يا ابنة الخيرين ، أدهى وأمر % % 6(@)(@@) % ولقد زاد فؤادي حزنا % قولها لي : إرع سري يا عمر ! % 7(@)(@@) % قلت : أنت الشيء يرعى سره % ويؤاتى في هواه ، ويسر % % PageV01P217 البحر : كامل تام 1(@)(@@) % يا عمر حم فراقكم عمرا % % وعدلت عنا النأي والهجرا % % 2(@)(@@) % إحدى بني أود كلفت بها % % حملت بلا ترة لنا وترا % % 3(@)(@@) % والله ، ما أحببت حبكم ، % لا ثيبا خلقت ولا بكرا % % 4(@)(@@) % ما إن أقيم لحاجة عرضت % إلا لأبلي فيكم عذرا % % 5(@)(@@) % وترى لها دلا إذا نطقت % تركت بنات فؤاده صعرا % % 6(@)(@@) % كتساقط الرطب الجني من % % قنوان لا كثرا ولا نزرا % % 7(@)(@@) % بالخيف منزلها ومسكنها ، % وتحل مكة إن شتت ، قصرا % % 8(@)(@@) % من أجلها حبست ركائبنا % % شهرا تجرم بعده شهرا % % PageV01P218 البحر : كامل تام 1(@)(@@) % وذكرت فاطمة التي علقتها ضاق الغداة بحاجتي صدري % % ويئست بعد تقارب الأمر % % 2(@)(@@) % وذكرت فاطمة التي علقت % عرضا فيا لحوادث الدهر ! % 3(@)(@@) % ممكورة ، ردع العبير بها ، % جم العظام لطيفة الخصر % 4(@)(@@) % وكأن فاها عند رقدتها % % تجري عليه سلافة الخمر % 5(@)(@@) % شرقا بذوب الشهد ، يخلطه % بالزنجبيل وفأرة التجر % 6(@)(@@) % عرضت لنا بالخيف في بقر ، % تقرو الكباث وناضر السدر % 7(@)(@@) % وجلت أسيلا يوم ذي خشب % ريان ، مثل فجاءة البدر % 8(@)(@@) % فسبت فؤادي ، إذ عرضت لها ، % يوم الرحيل بساحة القصر % 9(@)(@@) % بمزين ردع العبير به % حسن الترائب واضح النحر % % 10(@)(@@) % وبعينى دم ، شادن ، خرق ، % يرعى الرياض ببلدة قفر % % PageV01P219 11(@)(@@) % لما رأيت مطيها حزقا % خفق الفؤاد وكنت ذا صبر % 12(@)(@@) % وتبادرت عيناي بعد تجلد % فانهلتا جزعا 
ms54	 على الصدر % % 13(@)(@@) % أرق الحبيب إلى الحبيب ، لو ان % عذرت بذلك أول العذر % 14(@)(@@) % ولقد عصيت ذوي قرابتنا % % طرا وأهل الود والصهر % 15(@)(@@) % حتى مقالهم ، إذ اجتمعوا : % أجننت ، أم ذا داخل السحر ؟ % 16(@)(@@) % فأجبت : مهلا بعض عذلكم % لا بل منيت ولم أنل وتري % % 17(@)(@@) % بيدي ضعيف البطش ، معتجر ، % فرمى ولم آخذ له حذري % % PageV01P220 البحر : كامل تام 1(@)(@@) % ذكر الرباب وكان قد هجرا % % ذكرى قريبة أحدثت وطرا % % 2(@)(@@) % ولها بأعلى الخيف منزلة % هاجت له شوقا فما صبرا % % 3(@)(@@) % والبرد ، بين الحلتين ، به % تجنن ممن طاف ، أو نظرا % % 4(@)(@@) % قالت لتربيها بعمركما % % هل تطمعان بأن نرى عمرا % % 5(@)(@@) % إني كأن النفس موجسة ، % ولذاك أطمع أنه حضرا % % 6(@)(@@) % فأجابتاها في مهازلة ، % وأسرتا من قولها سخرا : % 7(@)(@@) % إنا لعمرك ما نخاف وما % % نرجو زيارة زائر ظهرا % % 8(@)(@@) % لو كان يأتينا مجاهرة % فيمن ترين ، إذا لقد شهرا % % 9(@)(@@) % قالت لها الصغرى ، وقد حلفت % بالله : لا يأتيكما شهرا % % 10(@)(@@) % فتنفست صعدا لحلفتها % % وهوت فشقت جيبها فطرا % % PageV01P221 11(@)(@@) % وجرت مآقيها بأدمعها % % جزعا ، وقالت : حب من ذكرا % % 12(@)(@@) % يا رب ، إني قد شغفت به ، % أعقب فؤادي منهم صبرا % % 13(@)(@@) % بينا تحاورهن ، قمت إلى % % أقفائهن لأسمع الحورا % % 14(@)(@@) % فأراب إحداهن ، فالتفتت ، % وطئي فلما أثبتت نظرا % % 15(@)(@@) % قالت لهن : أخو مجاهرة ، % قد جاءنا يمشي وما ستترا % % 16(@)(@@) % فيهن خود لست ناسيها % % حتى تجاوز حفرتي حفرا % % PageV01P222 البحر : كامل تام 1(@)(@@) % ردوا التحية ، أيها السفر ، % وقفوا ، فإن وقوفكم اجر ! % 2(@)(@@) % ماذا عليكم في وقوفكم % ريث السؤال سقاكم القطر % 3(@)(@@) % ب لله ربكم أما لكم % ب لمشعرين وأهله خبر % 4(@)(@@) % أوما أتاكم ب لمحصب من منى % % من أم عمرو وتربها ذكر ؟ % 5(@)(@@) % مكية هام الفؤاد بها ، % نسي العزاء ، فما له صبر % % 6(@)(@@) % مرتجة الردفين بهكنة % رؤد الشباب ، كأنها قصر % % 7(@)(@@) % قدرت له حينا لتقتله % ولكل ما هو كائن قدر % 8(@)(@@) % الشهر مثل اليوم ، إن رضيت ، % واليوم إن غضبت به شهر % 9(@)(@@) % حوراء آنسة مقبلها % % عذب ، كأن مذاقه خمر % % 10(@)(@@) % والعنبر المسحوق خالطه ، % وقرنفل 
ms55	 يأتي به النشر % % PageV01P223 11(@)(@@) % وإذا تراءت في الظلام ، جلت % دجن الظلام ، . . . كأنها بدر % % 12(@)(@@) % وتنو ، فتصرعها عجيزتها ، % ممشى الضعيف ، يؤوده البهر % % 13(@)(@@) % وكأن ضوء الشمس تحت قناعها % % 14(@)(@@) % نظرت إليك بعين مغزلة % حوراء خالط طرفها فتر % 15(@)(@@) % وكأن سمطيها على رشإ ، % مرتاده الغيطان والخمر % PageV01P224 البحر : وافر تام 1(@)(@@) % ألا يا هند قد زودت قلبي % % جوى حزن ، تضمنه الضمير % 2(@)(@@) % إذا ما غبت كاد إليك قلبي % % فدتك النفس ، من شوق يطير % % 3(@)(@@) % يطول اليوم فيه لا أراكم % ويومي عند رؤيتكم قصير % 4(@)(@@) % وقد أقرحت ب لهجران قلبي % % وهجري ف علمي أمر كبير % 5(@)(@@) % فديتك أطلقي حبلي وجودي ، % فإن الله ذو عفو غفور % PageV01P225 البحر : مديد تام 1(@)(@@) % يا خليلي هاجني الذكر % وحمول الحي ، إذ صدروا % % 2(@)(@@) % ظعنوا ، كأن ظعنهم % مونع القنوان ، أو عشر % % 3(@)(@@) % بالتي قد كنت آملها ، % ففؤادي موجع حذر % % 4(@)(@@) % ظبية من وحش ذي بقر ، % شأنها الغيطان والغدر % 5(@)(@@) % رخصة حوراء ناعمة % طفلة ، كأنها قمر % % 6(@)(@@) % لو سقي الأموات ريقتها ، % بعد كأس الموت ، لانتشروا % % 8(@)(@@) % ويكاد العجز إن نهضت % بعد طوله البهر ينبتر % 9(@)(@@) % قد ، إذا خبرت أنهم % قدموا الأثقال ، فابتكروا % % 10(@)(@@) % أخيام البئر منزلهم ، % أم هم بالعمرة ئتمروا % % 11(@)(@@) % أم بأعلى ذي الأراك لهم % % مربع قد جاده المطر % PageV01P226 12(@)(@@) % سلكوا خل الصفاح ، لهم % % زجل أحداجهم زمر % 13(@)(@@) % سلكوا شعب النقاب بها % % زمرا ، تحتثهم زمر % % 14(@)(@@) % قال حاديهم لهم أصلا % أمكنت للشلرب الغدر % % 15(@)(@@) % ضربوا حمر القباب لها % % وأحيطت حولها الحجر % 16(@)(@@) % فطرقت الحي مكتتما % ومعي سيف به أثر % 17(@)(@@) % وأخ لم أخش نبوته ، % بنواحي أمرهم خبر % % 18(@)(@@) % فإذا ريم على مهد % في حجال الخز مستتر % 19(@)(@@) % بادن تجلو مفلجة % عذبة ، غرا ، لها أشر % 20(@)(@@) % حولها الأحراس ترقبها % % نوم ، من طول ما سهروا % % 21(@)(@@) % أشبهوا القتلى ، وما قتلوا ، % ذاك إلا أنهم سمروا % % PageV01P227 22(@)(@@) % فدعت ب لويل ثم دعت ، % حين أدناني لها النظر % 23(@)(@@) % ودعت حوراء آنسة % حرة من شأنها الخفر % 24(@)(@@) % ثم قالت للتي معها : % ويح نفسي قد أتى عمر 
ms56	 % 25(@)(@@) % ما له قد جاء يطرقنا % % ويرى الأعداء قد حضروا ؟ % 26(@)(@@) % لشقائي ، أخت ، علقنا ، % ولحين ساقه القدر % % 27(@)(@@) % قت : عرضي دون عرضكم ، % ولمن عاداكم جزر % % PageV01P228 البحر : رمل تام 1(@)(@@) % شاق قلبي منزل دثروا ، % حالف الأرواح والمطرا % % 2(@)(@@) % شمألا تذري إذا لعبت % عاصفا أذيالها الشجرا % % 3(@)(@@) % للتي قالت لجارتها : % ويح قلبي ، ما دهى عمرا ؟ % 4(@)(@@) % فيم أمسى لا يكلمنا ؟ % وإذا ناطقته بسرا % % 5(@)(@@) % أبه عتبى فأعتبه % أم به صبر ، فقد صبرا % % 6(@)(@@) % أم حديث جاءه كذب ، % أم به هجر ، فقد هجرا % % 7(@)(@@) % أم لقول قاله كاشح % كاذب ، يا ليته قبرا % % 8(@)(@@) % لو علمنا ما يسر به ، % ما طعمنا البارد الخصرا % % 9(@)(@@) % وأرى شوقي سيقتلني ، % وحبيب النفس إن هجرا % % 10(@)(@@) % إن نومي ما يلائمني ، % أجله يا أخت إن ذكرا % % PageV01P229 11(@)(@@) % فأجابت في ملاطفة % أسرعت فيها لها الحورا : % 12(@)(@@) % إنني إن لم امت عجلا ، % أرتجي إن راح ، أو بكرا % % 13(@)(@@) % فإذا ما راح ف ستلمي % % إن دنا في طوفه الحجرا % % 14(@)(@@) % وأشفي البرد عنك له ، % كي تشوقيه إذا نظرا % % 15(@)(@@) % فأرتني مسفرا حسنا ، % خلته ، إذ أسفرت ، قمرا % % 16(@)(@@) % وشتيت النبت متسقا % طيبا أنيابه خصرا % % 17(@)(@@) % لشقائي ، قادني بصري ، % ولحين ، وافق القدرا % % 18(@)(@@) % ثم قالت للتي معها : % لا تديمي نحوه النظرا % % 19(@)(@@) % خالسيه ، أخت ، في خفر % فوعيت القول إذ وقرا % % 20(@)(@@) % إنه يا أخت يصرمنا % % إن قضى من حاجة وطرا % % PageV01P230 21(@)(@@) % قلت : قد أعطيت منزلة % ما أرى عندي لها خطرا % % 22(@)(@@) % فأنيلي عاشقا ، دنفا ، % ثم أخزى الله من كفرا % % PageV01P231 البحر : وافر تام 1(@)(@@) % لمن دمن بخيف منى قفور % كأن عراص مغناها الزبور % 2(@)(@@) % منازل أقفرت من أم عمرو ، % ولو طال الليالي والدهور % 3(@)(@@) % فلا ينسى فؤادك أم عمر و % % ولو طال الليالي والشهور % 4(@)(@@) % أقول ، وشف سجف القز عنها : % أشمس تلك ، أم قمر منير ؟ % 5(@)(@@) % ويسرها لنا الميمون حتى % % لقيناها ببطن منى تسير % 6(@)(@@) % فحيت و ستهل الدمع مني % % لعبرتها على خد يمور % 7(@)(@@) % فقالت : حلت عن عهدي وودي % % جديد ما حييت لكم يسير 
ms57	 % 8(@)(@@) % وطاوعت الوشاة ، وزرت من لم % % يزرك وقد تبين لي الختور % 9(@)(@@) % ولم ترع الوصال كما رعينا ، % وبانت منك لي ، عمدا ، أمور % % 10(@)(@@) % ولم تجز القروض ولم تثبها % % وأنت لكل صالحة كفور % % PageV01P232 11(@)(@@) % حلفت لها برب منى إذا ما % % تغيب في عجاجتهم ثبير : % 12(@)(@@) % لأنتم حب شيء إن جلسنا % % وإن زرنا ، فأوجه من نزور % % 13(@)(@@) % فإن كنت البعاد أردت عني ، % فقلبي عن بعادكم نفور % % PageV01P233 البحر : خفيف تام 1(@)(@@) % منع النوم عينك الإدكار % من حبيب شطت به عنك دار % 2(@)(@@) % ولقد قلت زاجرا لفؤادي % % لو نهاه عن حبها الإزدجار : % 3(@)(@@) % صاح أقصر فلست أول إلف % قد عداه عن إلفه الأقدار % % 4(@)(@@) % وتناءى عنه الحبيب ، فأضحى % % بعد قرب قد شط عنه المزار % PageV01P234 البحر : كامل تام 1(@)(@@) % عوجي علي ، فسلمي جبر ، % فيم الصدود وأنتم سفر % 2(@)(@@) % ما نلتقي إلا ثلاث منى % حتى يفرق بيننا النفر % % 3(@)(@@) % الحول ثم الشهر يتبعه % ما الدهر إلا الحول والشهر % PageV01P235 البحر : طويل 1(@)(@@) % أتحذر وشك البين ، أم لست تحذر ؟ % وذو الحذر النحرير قد يتفكر % 2(@)(@@) % ولست موقى إن حذرت قضية ، % وليس مع المقدار يكدي التهور % 3(@)(@@) % تذكرت إذ بان الخليط زمانه % وقد يسقم المرء الصحيح التذكر % 4(@)(@@) % وكان ادكاري شادنا قد هويته ، % له مقلة حوراء ، فالعين تسحر % % 5(@)(@@) % كأني لما أن تولت به النوى ، % من الوجد ، مأموم الدماغ ، محير % % 6(@)(@@) % إذا رمت عيني أن تفيق من البكا % % تبادر دمعي مسبلا يتحدر % 7(@)(@@) % لقد ساقني حين إلى الشادن الذي % % أضر بنفسي أهله حين هجروا % % 8(@)(@@) % ولو أنه لا يبعد الله داره % ولا زلت منه حيث ألقى وأخبر % 9(@)(@@) % لقد كان حتفي يوم بانوا بجؤذر % عليه سخاب فيه در وعنبر % % 10(@)(@@) % فقلت : ألا يا أيها الركب إنني % % بكم مستهام القلب ، عان ، مشهر % % PageV01P236 11(@)(@@) % بلي كل ود كان في الناس قبلنا ، % وودي لا يبلى ولا يتغير % % 12(@)(@@) % فقالوا لعمري : قد عهدناك حقبة % وأنت امرؤ من دون ما جئت تخطر % % 13(@)(@@) % وقالت لأتراب لها ، حين عرجوا % % علي قليلا إن ذا بي يسخر 
ms58	 % 14(@)(@@) % وقالت : أخاف الغدر منه وإنني % % لأعلم أيضا انه ليس يشكر % % 15(@)(@@) % فقلت لها : يا هم نفسي ومنيتي ، % ألا لا وبيت الله إني مهبر % 16(@)(@@) % مصاب عميد القلب أعلم أنني % % إذا أنا لم ألقاكم ، سوف أدمر % % 17(@)(@@) % وشكري أن لا أبتغي بك خلة ، % وكيف ، وقد عذبت قلبي ، أغدر ؟ % 18(@)(@@) % وإني هداك الله صرمي سفاهة % وفيم بلا ذنب أتيته أهجر % 19(@)(@@) % وقد حال دون الكفر والغدر أنني % % أعالج نفسا هل تفيق وتصبر % 20(@)(@@) % فقالت : فإنا قد بذلنا لك الهوى ، % فب لطائر الميمون تلقى وتحبر % PageV01P237 21(@)(@@) % فقلت لها : إن كنت أهل مودة ، % فميعاد ما بيني وبينك عزور % % 22(@)(@@) % فقالت : فإنا قد فعلنا ، وقد بدا % % لنا عند ما قالت بنان ومحجر % 23(@)(@@) % فرنح قلبي فهو يزعم أنه % سيهلك قبل الوعد ، أو سوف يفتر % % PageV01P238 البحر : مجزوء الوافر 1(@)(@@) % طربت ، ورد من تهوى % % جمال الحي ف بتكرا % % 2(@)(@@) % فظلت مكفكفا دمعا % إذا نهنهته ، ابتدرا % % 3(@)(@@) % وبت لذاك مكتئبا % أقاسي الهم و لسهرا % % 4(@)(@@) % لبين الحي إذ هاجوا % % لك الأحزان والذكرا % % 5(@)(@@) % فإن يك حبل من ته % % واه أمسى منك منبترا % % 6(@)(@@) % فقدما كنت لا تلقى % % لصفو قد مضى كدرا % % 7(@)(@@) % ليالي لا أبالي من % لحى في الحب أو عذرا % % 8(@)(@@) % ولن أنسى بخيف منى % % تسارق زينب النظرا % % 9(@)(@@) % إلي ، بمقلتي ريم ، % ترى في طرفها حورا % % 10(@)(@@) % وثغر واضح رتل % ترى في خده أشرا % % PageV01P239 11(@)(@@) % ولا أنسى مقالتها % % لتربيها : ألا نتظرا % % 12(@)(@@) % أبا الخطاب ، ننظر فيم ، % م بعد وصاله هجرا % % 13(@)(@@) % ولوماه ، وقيتكما ! % على الهجران ، واستترا % % 14(@)(@@) % وقولا : قد ظفرت بها ، % كفاك وخبرا الخبرا % % 15(@)(@@) % وقولا : إن سرك ، يوم % م بطن الخيف قد شهرا % % 16(@)(@@) % فقلت : أغرها أني % % لها عاصيت من زجرا ؟ % 17(@)(@@) % وأن أنزلتها في الود % مني السمع والبصرا ؟ % 18(@)(@@) % فأين العهد والميثا % % لا تشعر بنا بشرا ؟ % 19(@)(@@) % وقل للمالكية لا % % تلومي القلب أن هجرا % % PageV01P240 البحر : مجزوء الوافر 1(@)(@@) % تصابى القلب و دكرا % % صباه ، ولم يكن ظهرا % % 2(@)(@@) % لزينب إذ تجد لنا % % صفاء لم يكن 
ms59	 كدرا % % 3(@)(@@) % أليست ب لتي قالت % لمولاة لها ظهرا : % 4(@)(@@) % أشيري ب لسلام له % إذا هو نحونا نظرا % % 5(@)(@@) % وقولي في ملاطفة % أزينب نولي عمرا ! % PageV01P241 البحر : كامل تام 1(@)(@@) % صدر الحبيب فهاجني صدره % إني كذاك تشوقني ذكره % 2(@)(@@) % إن المحب إذا تخالجه % شوق كذاك لهم يحتضره % 3(@)(@@) % ونظرت نظرة عاشق دنف % بادي الصبابة عازم نظره % 4(@)(@@) % فرأيت رئما في مجاسدها % % وسط الحدائق مشرقا بشره % 5(@)(@@) % أقبلت أطمع أن أزورهم % إني قديم الشوق منتشره % % 6(@)(@@) % فلقيتها ، والعين آمنة ، % والليل داج ، مسفر قمره % % 7(@)(@@) % في موكب لاق الجمال به % كالغيث لاط بنبته زهره % % PageV01P242 البحر : مجزوء الرجز 1(@)(@@) % قد هاج قلبي محضر ، % بذي عكاظ ، مقفر % 2(@)(@@) % ربع لهند قد عفا % % قد كان حينا يعمر % 3(@)(@@) % وجاءني بينهم % % ثقف لطيف مخبر % 4(@)(@@) % ترب لهند ، غادة ، % تلك غزال معصر : % 5(@)(@@) % إن الخليط رائح % قبل الصباح ، يبكر % 6(@)(@@) % بانوا بأمثال لدمى ، % بل دونهن ، الصور % 7(@)(@@) % فيهن هند ، ليتني ، % ما عمرت ، أعمر ! % 8(@)(@@) % حتى إذا ما جاءها % % حتف أتاني القدر % PageV01P243 البحر : مجزوء الرجز 1(@)(@@) % هاج القريض الذكر % لما غدوا فابتكروا % % 2(@)(@@) % على بغال وسج % قد ضمهن السفر % 3(@)(@@) % وقولها لأختها : % أمطمئن عمر % 4(@)(@@) % بأرضنا ، فماكث ، % أم حان منه السفر ؟ % 5(@)(@@) % قالت : غدا أو سبعة % يروح أو يبتكر % 6(@)(@@) % أموا الطريقين معا % ويسروا ما يسروا % % 7(@)(@@) % حتى إذا ما وازنوا % % المروة ، حين ائتمروا % % 8(@)(@@) % قيل : انزلوا من ليلكم ، % فعرسوا ، فاستقمروا % % 9(@)(@@) % لما ستقروا ضربت % حيث أرادوا الحجر % 10(@)(@@) % فيهم مهاة كاعب % كأنما هي قمر % PageV01P244 11(@)(@@) % يضيق عن أردافها % % إذا يلاث المئزر % 12(@)(@@) % خود ، يفوح المسك من % % أردانها والعنبر % 13(@)(@@) % تفتر عن مثل أقا % % حي الرمل فيها أشر % 14(@)(@@) % تلك التي ليس لها % % في الناس شبها بشر % 15(@)(@@) % نأت بها عنا عيو % % ج في مطاها عسر % 16(@)(@@) % تالله أنسى حبها % % حياتنا أو أقبر % % PageV01P245 البحر : متقارب تام 1(@)(@@) % أتوصل زينب ، أم تهجر ، % وإن ظلمتنا ، ألا تغفر ؟ % 2(@)(@@) % أدلت ، ولج بها أنها % % تريد العتاب وتستكبر % 3(@)(@@) % وتعلم أن لها عندنا % % ذخائر 
ms60	 ملحب لا تظهر % 4(@)(@@) % وودا ، ولو نطق الكاشحو % % ن فيها ولو أكثر المكثر % 5(@)(@@) % ولست بناس مقال الفتاة ، % غداة المحصب إذ جمروا % % 6(@)(@@) % ألست ملما بنا يا فتى % % ينفض عنا الذي ينظر % 7(@)(@@) % فقلت : بلى ، أقعدي ناصحا ، % % 8(@)(@@) % وآية ذلك أن تسمعي % % نداء المصلين ، يا معمر ! % 9(@)(@@) % فأقبلت ، والناس قد هجعوا ، % أطوف عليهم وما أنظر % % 10(@)(@@) % إذا كاعبان ورخص لبنان % أسيل مقلده ، أحور % PageV01P246 11(@)(@@) % فسلمت خفيا فحيينني % % وقلبي ، من خشية ، أوجر % 12(@)(@@) % وقالت : طربت ، وطاوعت بي % % مقال العدو ومن يزجر % 13(@)(@@) % فقلت مقال أخي فطنة ، % سميع بمنطقها مبصر : % 14(@)(@@) % أللصرم تطلبين الذنوب % ولم أجن ذنبا لكي تغدروا % % 15(@)(@@) % فإن كنت حاولت صرم الحبا % % ل ، فإن وصالك لا يبتر % % 16(@)(@@) % فإن كنت أدللت كي تعتبي % % فكفي لكم ب لرضا توسر % 17(@)(@@) % فقالت لها حرة عندها ، % لذيذ مقبلها ، معصر : % 18(@)(@@) % دعي عنك عذل الفتى واسعفي ، % فإن الوداد له أسور % % 19(@)(@@) % فبت أحكم فيما أردت ، % ت حتى بدا واضح أشقر % 20(@)(@@) % تميل علي إذا سقتها % % كما نهال مرتكم أعفر % PageV01P247 21(@)(@@) % يفوح القرنفل من جيبها ، % وريح اليلنجوج والعنبر % % 22(@)(@@) % فبت وليلي كلا أو بلى % % لديها ، وبل ليلتي أقصر % % 23(@)(@@) % وكيف اجتنابك دار الحبيب ، % كيف عن ذكره تصبر ؟ % PageV01P248 البحر : متقارب تام 1(@)(@@) % ألم تسأل المنزل المقفرا ، % بيانا فيبخل أو يخبرا ؟ % 2(@)(@@) % ذكرت به بعض ما قد مضى % % وحق لذي الشجو أن يذكرا % % 3(@)(@@) % مبيت الحبيبين قد ظاهرا % % كساء وبردين أن يمطرا % % 4(@)(@@) % ومشي ثلاث به موهنا ، % خرجن إلى عاشق زورا % % 5(@)(@@) % مهاتان شيعتا جؤذرا ، % أسيلا مقلده أحورا % % 6(@)(@@) % إلى مجلس من وراء القباب ، % سهل الربى ، طيب ، أعفرا % % 7(@)(@@) % وحوراء آنسة كالهلال ، % ل رخوا مفاصلها معصرا % % 8(@)(@@) % وأخرى تفدى وتدعو لنا % % إذا خافت العين أن تسترا % % 9(@)(@@) % سمون وقلن : ألا ليتنا % % نرى ليلنا دائما أشهرا % % 10(@)(@@) % ويغفل ذا الناس عن لهونا ، % ونسمره كله مقمرا % % PageV01P249 11(@)(@@) % غفلن عن الليل ، حتى بدت % تباشير من واضح أسفرا % % 12(@)(@@) % وقمن يعفين آثارنا % % بأكسية الخز أن تقفرا % % 13(@)(@@) % وقمن يقلن لو 