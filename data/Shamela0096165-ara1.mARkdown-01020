ms1001	 من المحيض فجامعها.(@)(@@) روى عنه سفيان الثوري (4).(@)(@@)(@@)(@@) $ 7524 - عبيد [3] بن عبيدة التمار، بصري.(@)(@@) يروي عن المعتمر بن سليمان. روى عنه أحمد بن الحسن بن خراش. يغرب (5).(@)(@@)(@@)(@@) $ 7525 - عبيد [2] بن علي، أبو علي.(@)(@@) يروي عن أبي ذر. روى عنه منصور بن المعتمر. واختلف على منصور فيه (6). PageV07P051(@)(@@)(@@)(@@) $ 7526 - عبيد [2] بن عمارة.(@)(@@) يروي عن ابن عباس. روى عنه ابن جريج (1).(@)(@@)(@@)(@@) $ 7527 - عبيد بن عمر الهلالي.(@)(@@) قال ابن أبي حاتم: روى عن شعيب (2) بن أبي سليمان الهلالي عن عكرمة.(@)(@@) روى عنه أحمد بن عبدة الضبي، وزعم أنه ثقة.(@)(@@) سألت أبي عنه فقال: مجهول (3).(@)(@@)(@@)(@@) $ 7528 - عبيد [2] بن عمرو الأعرابي، من أهل الحجاز.(@)(@@) يروي عن أبي هريرة. روى عنه ابن أبي ذئب (4).(@)(@@)(@@)(@@) $ 7529 - عبيد [4] بن عمرو، أبو عبد الرحمن الضرير، من أهل البصرة، كان ينزل [122 - أ] في هجيم (5).(@)(@@) يروي عن عطاء بن السائب، روى عنه محمد بن سلام البيكندي (6).(@)(@@) قال البخاري (7) وأبو حاتم (8): سمع ثابت بن عمارة. PageV07P052(@)(@@) وقال الأزدي (1): يروي عن ابن جدعان، ضعيف جدا.(@)(@@)(@@)(@@) $ 7530 - عبيد [4] بن عمرو، أبو عبد الرحمن.(@)(@@) يروي عن الأوزاعي. روى عنه أهل الشام (2).(@)(@@) قلت: روى عنه أحمد بن أبي الحواري.(@)(@@)(@@)(@@) $ 7531 - عبيد [4] بن الغازي أبو ذهل، من أهل عسقلان.(@)(@@) يروي عن أبي عاصم، حدثنا عنه محمد بن أيوب بن مشكان بطبرية (3).(@)(@@) وقال مسلمة: أخبرنا عنه ابن أبي رجاء.(@)(@@)(@@)(@@) $ 7532 - عبيد بن غنام بن حفص بن غياث النخعي.(@)(@@) قال مسلمة: كوفي ثقة، أخبرنا عنه ابن الأعرابي (4).(@)(@@)(@@)(@@) $ 7533 - عبيد [2] بن فرقد السلمي.(@)(@@) يروي عن عمر بن الخطاب. روى عنه سيار بن حاتم (5).(@)(@@)(@@)(@@) $ 7534 - عبيد [2] بن قارب.(@)(@@) يروي عن أبي هريرة. روى عنه إبراهيم بن ميسرة، عداده في أهل الحجاز (6). PageV07P053(@)(@@)(@@)(@@) $ 7535 - عبيد [2] بن قدامة.(@)(@@) يروي عن عمر. روى عنه قتادة (1).(@)(@@)(@@)(@@) $ 7536 - عبيد [4] بن أبي قرة، من أهل بغداد سكن مصر.(@)(@@) يروي عن الليث، وابن لهيعة. روى عنه إبراهيم بن سعيد الجوهري، والعراقيون، ربما خالف (2).(@)(@@) وروى عن: مالك، وسفيان بن عيينة. وروى عنه: أبو الوليد الطيالسي، ومسدد، وحجاج بن الشاعر، وأحمد بن محمد 
ms1002	 بن يحيى بن سعيد القطان (3).(@)(@@) قال البخاري (4): هو بغدادي، لا يتابع في حديثه في قصة العباس.(@)(@@) وقال أبو حاتم (5): صدوق.(@)(@@) وقال ابن معين (6): ما به بأس.(@)(@@) وقال يعقوب بن شيبة (7): ثقة صدوق. PageV07P054(@)(@@)(@@)(@@) $ 7537 - عبيد [2] بن قيس.(@)(@@) يروي عن ابن الزبير. روى عنه السكن بن أبي المغيرة. مات في إمرة مصعب (1).(@)(@@)(@@)(@@) $ 7538 - عبيد [2] بن مالك.(@)(@@) يروي عن ابن مسعود. روى عنه أهل الكوفة (2).(@)(@@)(@@)(@@) $ 7539 - عبيد بن محمد بن بحر البصري العبدي، نزيل حمص.(@)(@@) روى عن: جعفر بن سليمان، وأبي عوانة.(@)(@@) روى عنه أبو حاتم وقال: ثقة (3).(@)(@@)(@@)(@@) $ 7540 - عبيد بن محمد بن عبيد بن محمد بن محمد بن مهدي، أبو المعلى النيسابوري.(@)(@@) حدث عن أبي سعيد عبد الرحمن بن حمدان بن محمد النصروي (4).(@)(@@) حدث عنه أبو الفتح محمد بن علي بن هبة الله بن عبد السلام [122 - ب] [و] أبو الحسن (5) عبد الغافر بن إسماعيل بن عبد الغافر الفارسي في «ذيل تاريخ PageV07P055(@)(@@) نيسابور» وأثنى عليه ثناء حسنا، ووصفه بالصدق والعدالة والأمانة وصحة السماع، وأنه كان مشتغلا بنفسه وبالعبادة والإنفاق على الفقراء.(@)(@@) توفي سنة اثنتي عشرة وخمسمائة (1).(@)(@@)(@@)(@@) $ 7541 - عبيد [4] بن محمد الوراق، من أهل بغداد.(@)(@@) يروي عن يزيد بن هارون. حدثنا عنه عبد السلام بن معاذ بدمشق (2).(@)(@@)(@@)(@@) $ 7542 - عبيد [3] بن أبي مرزوق، من أهل الكوفة.(@)(@@) يروي المراسيل، روى عنه ابن عيينة (3).(@)(@@)(@@)(@@) $ 7543 - عبيد [3] بن مسلم الثقفي.(@)(@@) روى عن: سالم بن عبيد الله، والحسن. روى عنه عبد الصمد بن عبد الوارث (4).(@)(@@)(@@)(@@) $ 7544 - عبيد [3] بن مسلم، صاحب السابري، من أهل الكوفة.(@)(@@) يروي عن ثابت البناني. روى عنه التبوذكي (5).(@)(@@) وروى عن عمارة الدارمي.(@)(@@) وروى عنه: أبو عاصم النبيل، وهدبة بن خالد، وأحمد بن زياد بن سيار PageV07P056(@)(@@) السياري (1).(@)(@@)(@@)(@@) $ 7545 - عبيد [4] بن معبد البصري.(@)(@@) يروي عن: عيسى بن شعيب، وأبي عاصم، ثنا عنه الحسن بن سفيان (2).(@)(@@)(@@)(@@) $ 7546 - عبيد [4] بن هاشم.(@)(@@) يروي عن شريك. روى عنه أبو شيبة بن أبي بكر ابن أبي شيبة (3).(@)(@@) قلت: هذا هو الغاضري التميمي الضرير، روى عن: مخلد بن حسين، وأبي إسحاق الفزاري. روى 
ms1003	 عنه أبو زرعة وأبو حاتم وقال: كوفي صدوق (4).(@)(@@)(@@)(@@) $ 7547 - عبيد [4] بن الهيثم الحلبي.(@)(@@) يروي عن جعفر بن عون. حدثنا عنه الحسين بن عبد الله القطان، مستقيم الحديث (5).(@)(@@)(@@)(@@) $ 7548 - عبيد [2] بن وردان التجيبي، من أهل مصر.(@)(@@) أدرك معاوية، روى عنه حرملة بن عمران (6). PageV07P057(@)(@@)(@@)(@@) $ 7549 - عبيد (1) بن الوليد بن سليمان (2)، أبو السائب المخزومي، من أهل الشام.(@)(@@) يروي عن أبيه. روى عنه محمد بن عيسى بن سميع (3).(@)(@@) وروى عنه: هشام بن عمار، وأحمد بن أبي الحواري، ومحمود بن خالد (4).(@)(@@)(@@)(@@) $ 7550 - عبيد [3] بن يحيى.(@)(@@) يروي عن معان بن رفاعة. روى عنه يحيى بن محمد بن هانئ المدني (5).(@)(@@) وأعاده في الرابعة (6) وتبعه الهيثمي فكرره.(@)(@@) وقد روى عنه أيضا محمد بن إسحاق (7).(@)(@@)(@@)(@@) $ 7551 - عبيد [4] بن يحيى، أبو يحيى الطريقي، من أهل الكوفة.(@)(@@) يروي عن: محمد بن عمر، وأبي سهيل عن ابن سيرين.(@)(@@) روى عنه إبراهيم بن [123 - أ] إسحاق الصواف والكوفيون (8). PageV07P058(@)(@@)(@@)(@@) $ 7552 - عبيد [3] (1) الأنصاري.(@)(@@) يروي عن عمر بن الخطاب. روى عنه ابنه حميد بن عبيد (2).(@)(@@)(@@)(@@) $ 7553 - عبيد [2] الحميري.(@)(@@) شيخ من أهل الحجاز، يروي عن عثمان بن عفان. روى عنه المغيرة بن عبيد، وقد قيل عبد الله بن عبيد (3).(@)(@@) وروى عن المغيرة بن حديج، وفي كتاب ابن أبي حاتم (4): روى عنه ابن ابنه المغيرة بن عبد الرحمن بن عبيد.(@)(@@)(@@)(@@) $ 7554 - عبيد [2] الطفاوي.(@)(@@) يروي عن جرير بن عبد الله، وطفاوة بالبصرة، روى محمد بن سلمة الحراني عن أبي واصل عنه (5).(@)(@@)(@@)(@@) $ 7555 - عبيد [2] أبو صالح، مولى السفاح من خزاعة.(@)(@@) عداده في أهل المدينة، يروي عن زيد بن ثابت. روى عنه بسر (6) بن سعيد (7). PageV07P059(@)(@@) وروى عن: ابن عمر، وابن عباس.(@)(@@) وقال ابن معين (1): مدني ثقة.(@)(@@) وقال العجلي (2): أبو صالح مولى السفاح، مدني ثقة.(@)(@@)(@@)(@@) $ 7556 - عبيد [2]، أبو هرثم.(@)(@@) يروي عن علي. روى عنه الأعمش (3).(@)(@@)(@@)(@@) $ 7557 - عبيد [2]، أبو يحيى العبسي.(@)(@@) يروي عن حذيفة، عداده في أهل الكوفة، روى عنه ثابت بن زهير (4).(@)(@@)(@@)(@@) $ 7558 - عبيدة [2]-بفتح أوله- بن رواد التيمي.(@)(@@) يروي عن ابن عمر. روى عنه محمد بن المثنى (5)، (6).(@)(@@)(@@)(@@) $ 7559 - عبيدة [3] بن زيد.(@)(@@) يروي 
ms1004	 عن الحسن. روى عنه حماد بن زيد (7). PageV07P060(@)(@@)(@@)(@@) $ 7560 - عبيدة [3] بن قريط الجعفري.(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، عداده في أهل الكوفة. روى عنه ابن عيينة (1).(@)(@@) قلت: كذا ذكره ابن أبي حاتم (2) ثم أعاده في عبيدة (3) بضم أوله، وروى عن أبي الربيع في تفسير آية من القرآن، روى عنه إبراهيم بن عيينة أخو سفيان بن عيينة.(@)(@@)(@@)(@@) $ 7561 - عبيدة [2] بن أبي المهاجر، والد يزيد بن عبيدة.(@)(@@) يروي عن معاوية، عداده في أهل الشام، روى عنه عبد الرحمن بن يزيد بن جابر (4).(@)(@@)(@@)(@@) $ 7562 - عبيدة [2] المليكي، من أهل الشام.(@)(@@) يروي عن معاوية، روى عنه راشد بن سعد.(@)(@@) كذا قال (5) وفي «تاريخ البخاري» (6): عبيدة الأملوكي، قال لنا عبد الله عن معاوية، عن سعيد بن سويد، عن عبيدة قوله، حديثه في الشاميين، قال أحمد بن أبي شعيب: ثنا موسى بن أعين، عن أبي بكر بن عبد الله، عن مهاصر بن حبيب، PageV07P061(@)(@@) عن عبيدة المليكي [123 - ب] صاحب النبي صلى الله عليه وسلم قال: «لا توسدوا القرآن».(@)(@@)(@@)(@@) $ 7563 - عبيدة [3] البرتي.(@)(@@) يروي المراسيل، روى عنه الأحوص بن حكيم (1).(@)(@@)(@@)(@@) $ 7564 - عبيدة [3] النحوي.(@)(@@) يروي عن أبي حيان التيمي. روى عنه يونس بن أبي إسحاق (2).(@)(@@)(@@)(@@) $ 7565 - عبيس [3] بن بيهس.(@)(@@) يروي عن عطاء بن أبي رباح في كيفية الحج. روى عنه قتيبة بن سعيد (3).(@)(@@) ثم أعاده في الرابعة (4) وقال: روى عن أبيه، روى عنه البصريون.(@)(@@) وروى عن أشعث بن عثمان، ويقال أشعث بن عمرو التميمي، قال أبو حاتم: صالح الحديث (5). PageV07P062(@)(@@)(@@)(@@) $ 7566 - عبيس [4] بن مرحوم بن عبد العزيز العطار، مولى أبي معاوية بن أبي سفيان، من أهل البصرة.(@)(@@) يروي عن أبيه. روى عنه بشر بن عيسى، والبصريون، مات سنة ست (1) عشرة ومائتين (2).(@)(@@) وروى عن: بكير بن أبي السميط (3)، وحاتم بن إسماعيل، والنضر بن عربي.(@)(@@) وروى عنه أبو حاتم، وقال: كان ثقة وفي حديثه شيء (4).(@)(@@) وقال ابن معين (5): ثقة.(@)(@@) وقال العجلي (6): بصري ثقة.(@)(@@)(@@)(@@) $ 7567 - عتاب [4] بن أعين، من أهل الري.(@)(@@) يروي عن سفيان الثوري. روى عنه أهل الري (7).(@)(@@) وقال ابن أبي حاتم 
ms1005	 (8): كوفي نزل الري، أبو القاسم، روى عن الأعمش، PageV07P063(@)(@@) وإسماعيل بن أبي خالد، والمسعودي، ومسعر، وأبي العميس، وسعد بن أوس، وخلف بن حوشب، وشريك.(@)(@@) روى عنه: جرير بن عبد الحميد، وعبد الرحمن بن الحكم بن بشير، وهشام بن عبيد الله، وعبد الصمد بن عبد العزيز المقرئ، وابن حميد.(@)(@@) سألت أبي عنه فقال: ثقة.(@)(@@) وسألت أبا زرعة عنه فقال: كوفي سكن الري، لا بأس به.(@)(@@)(@@)(@@) $ 7568 - عتاب بن البراء، بصري.(@)(@@) قدم مصر قديما، وكان بذل في العطية، يحدث عن الحسن بن محمد بن الصباح الزعفراني، وأحمد بن منصور الرمادي، ويحيى بن أبي طالب ونحوهم.(@)(@@) قال ابن يونس: كان رجلا صالحا، كتبت عنه توفي نحو سنة (317ه).(@)(@@)(@@)(@@) $ 7569 - عتاب [4] بن حرب بن عبد الله، أبو بشر، ابن ابنة صالح بن رستم، من أهل البصرة.(@)(@@) يروي عن جده صالح بن رستم عن ابن أبي مليكة (1).(@)(@@) روى عنه إبراهيم بن يعقوب الجوزجاني (2).(@)(@@) وسمع منه: إبراهيم بن محمد بن عرعرة، وعمرو بن علي، وضعفه (3). PageV07P064(@)(@@) وقد ذكره ابن حبان في «المجروحين» (1) أيضا، فقال: كان يتفرد عن الثقات بما لا يشبه حديث الأثبات، فلا يحتج به إذا تفرد.(@)(@@) وذكره العقيلي (2) والساجي (3) وابن الجارود (4) في «الضعفاء».(@)(@@) وقال أبو أحمد الحاكم (5): ليس بالقوي عندهم.(@)(@@)(@@)(@@) $ 7570 - عتاب [4] بن الخليل الأبلي، سكن المنصورة.(@)(@@) يروي عن: الأنصاري، وعبيد الله بن موسى، حدثنا عنه أحمد بن محمد بن الأزهر، يتفرد (6).(@)(@@)(@@)(@@) $ 7571 - عتاب [4] بن درست.(@)(@@) شيخ بصري، يروي عن عبد الله بن عيسى عن يحيى البكاء عن ابن عمر في الغسل.(@)(@@) حدثنا عنه الحسن بن سفيان (7).(@)(@@)(@@)(@@) $ 7572 - عتاب [3] بن زياد بن ورقاء.(@)(@@) يروي عن الشعبي وعكرمة. روى عنه أبو أحمد الزبيري (8). PageV07P065(@)(@@) وروى عن سعيد بن جبير. وروى عنه حفص بن غياث (1).(@)(@@)(@@)(@@) $ 7573 - عتاب بن محمد بن شوذب البلخي.(@)(@@) يروي عن: إسماعيل بن أبي خالد، وكعب بن عبد الرحمن، مستقيم الحديث.(@)(@@) روى عنه: قتيبة بن سعيد، وسعيد بن جناح البخاري الزاهد (2).(@)(@@) وروى عنه: موسى بن إسماعيل الجبلي، ومحمد بن زياد السهمي البلخي (3).(@)(@@)(@@)(@@) $ 7574 - عتاب [3] البكري.(@)(@@) يروي 
ms1006	 عن أبي سعيد الخدري. روى عنه عبد الله بن ميسرة (4).(@)(@@) وروى سهل بن حماد العقوي عن ابن أبي ليلى (5) عنه (6).(@)(@@)(@@)(@@) $ 7575 - عتبان [2] بن عمرو بن إياس.(@)(@@) يروي عن السائب بن يزيد. روى عنه الضحاك بن عثمان (7). PageV07P066(@)(@@)(@@)(@@) $ 7576 - عتبة (1) بن أبان بن صمعة، الذي يعرف بعتبة الغلام.(@)(@@) من عباد أهل البصرة وقرائهم، له حكايات عجيبة في الرقائق.(@)(@@) يروي عن: عبد الواحد بن زيد، وشميط بن عجلان.(@)(@@) روى عنه أهل البصرة، وما له حديث مسند يرجع إليه (2).(@)(@@) وذكره قبل ذلك في الثالثة (3) وقال: كان ممن جالس الحسن وأخذ هديه في العبادة، وذله في التقشف، روى عنه البصريون، ما له حديث مسند صحيح يرويه.(@)(@@)(@@)(@@) $ 7577 - عتبة [3] بن إبراهيم بن أبي خداش، من أهل مكة.(@)(@@) يروي المراسيل. روى عنه سفيان بن عيينة (4).(@)(@@)(@@)(@@) $ 7578 - عتبة [2] بن إبراهيم بن عتبة بن غزوان السلمي، من بني مازن ابن منصور.(@)(@@) يروي عن جده عتبة بن غزوان. روى عنه البصريون (5).(@)(@@) وروى عنه عمرو بن يحيى (6) [124 - ب]. PageV07P067(@)(@@)(@@)(@@) $ 7579 - عتبة [3] بن جبيرة بن محمود بن أبي جبيرة الأشهلي.(@)(@@) يروي عن التابعين، روى عنه أهل المدينة، مات سنة أربع وخمسين ومائة (1).(@)(@@)(@@)(@@) $ 7580 - عتبة [4] بن السكن، من أهل الشام.(@)(@@) يروي عن الأوزاعي، روى عنه: عمران بن بكار (2) الحمصي، وموسى بن سهل الرملي، يخطئ ويخالف (3).(@)(@@) وروى عن: إسماعيل بن عياش، وموسى بن أعين، والضحاك بن حمرة.(@)(@@) وروى عنه أبو الدرداء المقدسي (4).(@)(@@) وقال الدارقطني (5): منكر الحديث، متروك الحديث.(@)(@@) وقال البزار (6): روى عن الأوزاعي أحاديث لم يتابع عليها.(@)(@@)(@@)(@@) $ 7581 - عتبة [2] بن صعصعة السعدي، ابن عم الأحنف بن قيس.(@)(@@) يروي عن عكراش بن ذؤيب. روى عنه شريك بن الخطاب (7). PageV07P068(@)(@@)(@@)(@@) $ 7582 - عتبة [4] بن عبد الله بن خالد بن معدان.(@)(@@) يروي عن أبيه عن جده. روى عنه بقية بن الوليد (1).(@)(@@)(@@)(@@) $ 7583 - عتبة [3] بن عبيد الصدفي، من أهل مصر.(@)(@@) يروي المقاطيع والمراسيل، روى عنه سعيد بن أبي أيوب (2).(@)(@@)(@@)(@@) $ 7584 - عتبة [4] بن علي بن مسلم، أبو الحسن السكوني، من أهل حمص.(@)(@@) كان في سوق البز بها، يروي عن معاوية بن 
ms1007	 يحيى الصدفي. روى عنه يعقوب بن سفيان (3).(@)(@@)(@@)(@@) $ 7585 - عتبة [4] بن عمرو بن عياش (4) بن علقمة المدني.(@)(@@) يروي عن أبي هريرة. روى عنه ابن أبي ذئب (5).(@)(@@)(@@)(@@) $ 7586 - عتبة [3] بن عمرو المكتب، من أهل الكوفة.(@)(@@) يروي عن: عكرمة، والشعبي. روى عنه أبو صيفي والكوفيون، وليس هذا بعبيد بن عمرو المكتب (6). PageV07P069(@)(@@) وروى عن قتادة. وروى عنه: محاضر، والوليد بن مسلم (1).(@)(@@) قال ابن معين (2): هو شيخ لعبد الله بن إدريس.(@)(@@) وقال أبو حاتم (3): لا أعرفه.(@)(@@)(@@)(@@) $ 7587 - عتبة [3] بن عمير.(@)(@@) شيخ، يروي عن أبيه. روى عنه بكير بن عبد الله بن الأشج (4).(@)(@@)(@@)(@@) $ 7588 - عتبة [3] بن قيس، من أهل الكوفة.(@)(@@) يروي عن علي بن الحسين. روى عنه: مسعر، وابن عيينة (5).(@)(@@)(@@)(@@) $ 7589 - عتبة [3] بن محارب الهجيمي.(@)(@@) يروي المقاطيع، روى عنه يحيى بن أبي كثير (6).(@)(@@)(@@)(@@) $ 7590 - عتبة [2] بن مسلم.(@)(@@) يروي عن عثمان بن عفان. روى عنه يوسف بن الماجشون (7).(@)(@@)(@@)(@@) $ 7591 - عتبة [2] العدوي.(@)(@@) قال: دخلت على أم حبيبة زوج النبي صلى الله عليه وسلم.(@)(@@) روى عنه صدقة أبو إسماعيل (8).(@)(@@)(@@)(@@) $ 7592 - عتبة [3]، مولى بني عامر.(@)(@@) يروي عن شريح، روى عنه مطرف بن طريف (9) [125 - أ].(@)(@@)(@@)(@@) $ 7593 - عتبة [2]، مولى معاوية.(@)(@@) يروي عن عبد الله بن معقل. روى عنه عبد الملك بن عمير (10).(@)(@@)(@@)(@@) $ 7594 - عتبة (11) الراسبي.(@)(@@) يروي عن عمرو بن دينار. روى عنه أبو هلال الراسبي (12). PageV07P071(@)(@@)(@@)(@@) $ 7595 - عتبة (1) أبو أمية الدمشقي.(@)(@@) يروي المقاطيع، روى عنه معاوية بن صالح (2).(@)(@@) وروى عن أبي سلام (3).(@)(@@)(@@)(@@) $ 7596 - عتريس [2] بن عرقوب الشيباني.(@)(@@) يروي عن ابن مسعود، عداده في أهل الكوفة، روى عنه أهلها (4).(@)(@@) وروى عنه إبراهيم النخعي (5).(@)(@@)(@@)(@@) $ 7597 - عتيق [4] بن محمد، أبو بكر.(@)(@@) شيخ، يروي عن الدراوردي، وأهل الحجاز.(@)(@@) روى عنه إبراهيم بن إسحاق الأنصاري (6).(@)(@@)(@@)(@@) $ 7598 - عتيق بن محمد أبو بكر الأنصاري، الداني.(@)(@@) روى عن: أبي علي الغساني، وأبي علي بن سكرة، وغيرهما.(@)(@@) قال ابن بشكوال: كان خيرا فاضلا، راوية للعلم، ثقة فيما رواه، أنا عنه PageV07P072(@)(@@) صاحبنا أبو عمر وأثنى عليه (1).(@)(@@)(@@)(@@) $ 7599 - عتيق [2] والد عبد الرحمن بن عتيق.(@)(@@) يروي عن عائشة. روى عنه ابنه عبد الرحمن بن 
ms1008	 عتيق، وقد قيل ابن أبي عتيق، والصحيح ابن عتيق (2).(@)(@@)(@@)(@@) $ 7600 - عثمان [2] بن إبراهيم بن محمد بن حاطب.(@)(@@) يروي عن ابن عمر (3).(@)(@@) روى عنه: ابنه عبد الرحمن بن عثمان، ويعلى بن عبيد (4).(@)(@@) وأعاده مرة أخرى (5).(@)(@@) وروى عن: عائشة بنت قدامة بن مظعون، وأبيه محمد بن حاطب. وروى عنه: شريك بن عبد الله، وابنه عبد الرحمن بن عثمان (6).(@)(@@) قال ابن أبي حاتم (7): سألت أبي عنه فقال: روى عنه ابنه أحاديث منكرة قلت: فما حاله؟ قال: يكتب حديثه وهو شيخ. PageV07P073(@)(@@)(@@)(@@) $ 7601 - عثمان [2] بن أجيل.(@)(@@) يروي عن عتبة بن عبد، عداده في أهل الشام، روى عنه فرج بن يزيد (1).(@)(@@)(@@)(@@) $ 7602 - عثمان بن أحمد بن الحسين بن سليمان بن عبد الرحمن بن الخضر، أبو عمرو البزاز.(@)(@@) قال ابن بشكوال: كان ثقة كثير الحديث (2).(@)(@@)(@@)(@@) $ 7603 - عثمان بن أحمد بن عثمان بن محمد بن عيسى الدباغ، أبو عمرو.(@)(@@) قال ابن يونس (3): سمع من عبيد الله بن سعيد بن كثير بن عفير، ومحمد بن عمرو بن نافع، ونحوهم. توفي في صفر سنة (323ه). كتبت عنه وكان ثقة ثبتا.(@)(@@)(@@)(@@) $ 7604 - عثمان بن أحمد بن محمد بن يوسف المعافري، أبو عمرو القيشطيالي (4).(@)(@@) روى عن: أبيه، وأبي عيسى الليثي، وابن الفوطية. قال ابن خزرج: كان من أهل الطهارة والعفاف والثقة، وروايته كبيرة.(@)(@@) حدث عنه: أبو عبد الله الخولاني، وابنه، ومحمد بن شريح (5). PageV07P074(@)(@@)(@@)(@@) $ 7605 - عثمان بن أحمد، أبو عمرو بن السماك الدقاق [125 - ب].(@)(@@) روى عن: محمد بن عبيد الله بن المنادي، والحسن بن مكرم، وخلق.(@)(@@) قال الدارقطني (1): كتب ابن السماك عن الحسن بن مكرم ومن بعده، وأكثر الكتابة، وكتب الكتب الطوال، والمصنفات بخطه، وكان من الثقات.(@)(@@) وقال الجوهري (2): ثنا عمر بن أحمد -هو ابن شاهين-: ثنا عثمان بن أحمد الدقاق الثقة المأمون. وقال الخطيب: كان ثقة، وسمعت ابن رزقويه روى عنه فتبجح به، فقال: حدثنا الباز الأبيض أبو عمرو بن السماك.(@)(@@) وقال الحاكم في «المستدرك» (3): ثنا أبو عمرو بن السماك الزاهد.(@)(@@) وقال أبو الحسن ابن الفضل القطان (4): توفي في ربيع الأول 
ms1009	 لثلاث بقين منه يوم الجمعة من سنة أربع وأربعين وثلاثمائة، وحزرت من حضر جنازته بخمسين ألف إنسان، وكان ثقة صالحا صدوقا.(@)(@@)(@@)(@@) $ 7606 - عثمان (5) بن الأرقم بن أبي الأرقم، كنيته أبو عمرو (6).(@)(@@) يروي عن أبيه. روى عنه: أهل الحجاز، وابن ابنه يحيى بن عمران PageV07P075(@)(@@) بن عثمان (1).(@)(@@) وروى عنه: عطاف بن خالد، وعمار بن سعد (2).(@)(@@)(@@)(@@) $ 7607 - عثمان [4] بن إسحاق.(@)(@@) يروي عن عبد المجيد بن أبي عبس، عداده في أهل المدينة، روى عنه ابن أبي فديك (3).(@)(@@)(@@)(@@) $ 7608 - عثمان بن بشر الطائفي الثقفي.(@)(@@) روى عن: بشر بن عاصم، وعبد الله (4) بن أبي شديد، سمع منه يحيى بن سليم، قال ابن معين: ثقة (5).(@)(@@)(@@)(@@) $ 7609 - عثمان [3] بن بقطر، من أهل البصرة، كنيته أبو الخطاب.(@)(@@) يروي عن الحسن وعطاء. روى عنه ابن مهدي والبصريون (6).(@)(@@) قلت: هو ابن موسى بن بقطر نسب هنا إلى جده (7)، روى عن نافع مولى ابن عمر. PageV07P076(@)(@@) وروى عنه: أبو عاصم النبيل، وموسى بن إسماعيل، وأبو الوليد (1).(@)(@@)(@@)(@@) $ 7610 - عثمان بن أبي بكر بن حمود بن أحمد الصدفي، أبو عمرو السفاقسي، المعروف بابن الضابط.(@)(@@) حدث عن أبي نعيم أحمد بن عبد الله، وقال: كتبت عنه مائة ألف حديث بخطه، ولم ألق مثله في العلم والعمل، وحدث عن: أبي عبد الله محمد بن علي الفسوي الحافظ، وأبي ذر الهروي، وخلق كثير.(@)(@@) قال الحميدي (2): كان فاضلا عاقلا يفهم، قرأت عليه كثيرا، وكتبت عنه، وذكره ابن الحذاء في شيوخه وقال: كانت له رواية واسعة، وكانت عنده غرائب.(@)(@@) وقال ابن بشكوال: حدث عنه مشايخنا، وعلماء قرطبة، وكل بلد دخله بالأندلس، وكان حافظا للحديث وطرقه، وأسماء رجاله، منسوبا إلى فهمه ومعرفته، يملي الحديث من حفظه، ويتكلم على أسانيده ومعانيه [126 - أ]، عارفا باللغة والإعراب، وذكر من فضله، توفي بعد سنة أربعين وأربعمائة (3).(@)(@@)(@@)(@@) $ 7611 - عثمان [2] بن البهي بن أبي رافع، مولى النبي صلى الله عليه وسلم.(@)(@@) يروي عن جده. روى عنه حماد بن موسى المدني، ويروي أيضا عن أبيه، وقد قيل إن اسم البهي عبيد الله (4). PageV07P077(@)(@@)(@@)(@@) $ 7612 - عثمان [2] بن جابر.(@)(@@) يروي 
ms1010	 عن أنس بن مالك. روى عنه صفوان بن عمرو (1).(@)(@@)(@@)(@@) $ 7613 - عثمان [3] بن الحارث الهمداني.(@)(@@) يروي عن السدي. روى عنه وكيع (2).(@)(@@) وروى عنه أبو نعيم (3).(@)(@@) وقال أبو زرعة الرازي (4): إنما هو عثمان بن ثابت.(@)(@@)(@@)(@@) $ 7614 - عثمان بن الحارث، ويقال له: ختن الشعبي، ويقال: ابن ابنة الشعبي.(@)(@@) روى عن الشعبي. روى عنه: الثوري، ومروان بن معاوية.(@)(@@) قال ابن معين: ثقة (5).(@)(@@)(@@)(@@) $ 7615 - عثمان [2] بن حفص بن خلدة الزرقي.(@)(@@) يروي عن معاوية. روى عنه عبد العزيز ابن الماجشون (6).(@)(@@) وروى إبراهيم بن طهمان عن عباد بن إسحاق عن عثمان بن حفص حديث: PageV07P078(@)(@@) «من قال: يثرب، فليقل المدينة» (1).(@)(@@) قال ابن أبي حاتم (2): لا أدري هذا هو الأول أم لا، أو هو عثمان بن عبد الرحمن الوقاصي؟!.(@)(@@) وقال البخاري في الذي روى عنه عباد بن إسحاق: في إسناده نظر (3).(@)(@@) وقال ابن عبد البر في «التمهيد» (4): هو ثقة، روى عن الزهري. روى عنه مالك، وعبد العزيز بن أبي سلمة، ولم يرو عنه غيرهما؛ إلا أنه قد قيل إنه هو الذي روى عنه عباد بن إسحاق.(@)(@@)(@@)(@@) $ 7616 - عثمان [4] بن حفص التومني، من أهل الأهواز.(@)(@@) يروي عن أبي عاصم وأهل البصرة. حدثنا عنه أهل الأهواز. يغرب (5).(@)(@@)(@@)(@@) $ 7617 - عثمان [4] بن خالد بن الزبير.(@)(@@) يروي عن محمد بن عمرو بن علقمة. روى الليث بن سعد عن يحيى بن أبي أسيد عنه (6). PageV07P079(@)(@@)(@@)(@@) $ 7618 - عثمان [3] بن خالد الشامي.(@)(@@) يروي عن أبي الأشعث الصنعاني. روى عنه ثور بن يزيد (1).(@)(@@)(@@)(@@) $ 7619 - عثمان [3] بن خالد القرشي.(@)(@@) يروي عن الحسن، ونافع. روى عنه قتيبة بن سعيد (2).(@)(@@)(@@)(@@) $ 7620 - عثمان بن خلف بن مفرج، أبو سعيد الأنصاري.(@)(@@) روى عن أبي محمد الأصيلي وغيره. قال ابن بشكوال: سمع منه القاضي محمد بن يحيى بن فورتش، وغيره، وكان عالما حافظا ورعا. توفي سنة خمس وعشرين وأربعمائة (3) [126 - ب].(@)(@@)(@@)(@@) $ 7621 - عثمان بن دليم، أبو عمرو.(@)(@@) أخذ عنه الحميدي وأثنى عليه (4).(@)(@@)(@@)(@@) $ 7622 - عثمان [3] بن أبي دهرش.(@)(@@) يروي عن أبي الحكم (5) بن أبي العاص. روى عنه: سفيان بن عيينة، ويحيى PageV07P080(@)(@@) بن سليم (1).(@)(@@) وروى عنه ابن 
ms1011	 المبارك (2).(@)(@@)(@@)(@@) $ 7623 - عثمان [3] بن دينار، أخو مالك بن دينار.(@)(@@) يروي عن مالك بن دينار. روت عنه ابنته حكامة بنت عثمان بن دينار، وحكامة لا شيء (3).(@)(@@) وقال العقيلي (4): تروي عنه ابنته حكامة أحاديث بواطيل، ليس لها أصل.(@)(@@)(@@)(@@) $ 7624 - عثمان بن راشد الكوفي السلمي، من أهل الكوفة.(@)(@@) يروي عن عائشة بنت عجرد. روى عنه سفيان بن سعيد الثوري (5).(@)(@@)(@@)(@@) $ 7625 - عثمان [3] ربيعة بن أبي عبد الرحمن التيمي، من أهل المدينة.(@)(@@) يروي عن أبيه. روى عنه الدراوردي (6).(@)(@@)(@@)(@@) $ 7626 - عثمان [3] بن رشيد الثقفي.(@)(@@) يروي عن ابن سيرين. روى عنه عبد الصمد بن عبد الوارث (7). PageV07P081(@)(@@) وروى عنه أيضا يونس بن محمد (1).(@)(@@) وقال يحيى (2): ضعيف.(@)(@@)(@@)(@@) $ 7627 - عثمان بن أبي الزنباع روح بن الفرج، أبو عمرو.(@)(@@) روى عن: أبيه، وابن أبي مريم، وغيرهما.(@)(@@) قال ابن يونس: كتبت عنه، وكان ثقة رجلا صالحا. توفي بدمياط في المحرم سنة ست وعشرين وثلاثمائة.(@)(@@)(@@)(@@) $ 7628 - عثمان [4] بن سعيد بن أبان القرشي.(@)(@@) يروي عن أبي فروة. روى عنه محمد بن عيسى بن الطباع (3).(@)(@@)(@@)(@@) $ 7629 - عثمان بن سعيد بن أسلم.(@)(@@) قال ابن يونس: كان مقبولا عند القضاة، عند لهيعة (4)، والمنكدري، وقد حدث.(@)(@@)(@@)(@@) $ 7630 - عثمان [4] بن سعيد بن حماد بن زهدم الغفاري، من أهل مكة.(@)(@@) يروي عن: ابن عيينة، وبشر بن السري. PageV07P082(@)(@@) روى عنه أبو الحسين عبيد الله (1) بن المرزبان (2).(@)(@@)(@@)(@@) $ 7631 - عثمان بن سعيد بن عثمان بن سعيد الأموي، المقرئ المعروف بابن الصيرفي، يكنى أبا عمرو.(@)(@@) روى عن خلق كثير من بلاد شتى، وروى عنه خلق كثير.(@)(@@) قال الحميدي (3): محدث مكثر ومقرئ متقدم، وصفه بالعدالة والثقة والعلم والفهم وحسن الخط والتصنيف ابن بشكوال (4) وابن روبيل (5) وجماعة. توفي سنة (444ه).(@)(@@)(@@)(@@) $ 7632 - عثمان بن سعيد بن محمد بن سعيد بن محمد بن حمزة بن المغيرة، أبو عمرو.(@)(@@) قال ابن يونس: حدث عنه يزيد بن سنان، وعلي بن عبد الرحمن بن المغيرة، توفي سنة إحدى وثلاثمائة في شوال، ثقة صاحب [127 - أ] حديث، يفهم، كتبت عنه.(@)(@@)(@@)(@@) $ 7633 - عثمان [4] بن سعيد المعروف بورش، من أهل مصر.(@)(@@) يروي عن نافع 
ms1012	 ابن أبي نعيم القارئ، كان عالما بقراءة أهل المدينة، صاحب PageV07P083(@)(@@) اختيار (1) ودراية. روى عنه أهل مصر (2).(@)(@@) وروى عنه: إسحاق بن الحجاج، ويونس بن عبد الأعلى (3).(@)(@@) قال ابن يونس: كان قارئ أهل مصر، توفي سنة سبع وتسعين ومائة.(@)(@@)(@@)(@@) $ 7634 - عثمان [4] بن سعيد، أبو وهب، من أهل نصيبين.(@)(@@) روى عن أبي نعيم، وأهل العراق، حدثنا عنه جماعة بنصيبين (4).(@)(@@)(@@)(@@) $ 7635 - عثمان [4] بن سعيد الواسطي.(@)(@@) يروي عن: أبي نعيم، ويزيد، ثنا عنه علي بن أحمد بن عتبة بالمبرك. يغرب (5).(@)(@@) وروى عنه عبد العزيز بن منيب.(@)(@@)(@@)(@@) $ 7636 - عثمان بن سعيد الدارمي.(@)(@@) قال مسلمة: خراساني ثقة.(@)(@@) وقال الخليلي (6): أبو عمرو الدارمي، كبير المحل، عالم بهذا الشأن، يقارن PageV07P084(@)(@@) بالبخاري وأبي زرعة وأبي حاتم.(@)(@@) سمع بالعراق: القعنبي، وأبا الوليد، وأبا نعيم، وأحمد بن يونس، ومن بعدهم، وأخذ العلم عن ابن المديني، ويحيى بن معين، والبعض عن أحمد بن حنبل، وله عنهم تاريخ ينفرد به، وصنف لنفسه تاريخا، وسمع بمصر: كاتب الليث، ويحيى بن بكير، وأقرانهما. وبالشام هشام بن عمار، ودحيما، ومن في عصرهم.(@)(@@) سمع منه حفاظ خراسان: ابن خزيمة، والشرقي، وأبو علي الطوسي، ومن بعدهم، وآخر من روى عنه أحمد بن محمد بن عثمان العنبري (1) النيسابوري.(@)(@@) سمعت عبد الله بن محمد الحافظ يقول: كان عثمان بن سعيد ثقة متفقا عليه.(@)(@@)(@@)(@@) $ 7637 - عثمان [3] بن أبي سلمة.(@)(@@) يروي المقاطيع، روى عنه حجاج بن أبي عثمان (2).(@)(@@)(@@)(@@) $ 7638 - عثمان [2] بن سليمان بن صبيح.(@)(@@) يروي عن أبي سعيد الخدري. روى عنه عثمان بن حكيم (3).(@)(@@)(@@)(@@) $ 7639 - عثمان بن سليمان بن محمد بن عبد الله بن محمد بن عبد الله بن جحش بن رياب الأسدي.(@)(@@) قال ابن يونس: مدني قدم مصر، كان يصحب القضاة بمصر وكانت تقبله، PageV07P085(@)(@@) وكانت وفاته سنة خمس عشرة ومائتين، وقد كتبت عنه.(@)(@@)(@@)(@@) $ 7640 - عثمان [3] بن سليمان الحارثي.(@)(@@) يروي عن يزيد بن المهلب. روى عنه [127 - ب] البصريون (1).(@)(@@) وقال أبو حاتم (2): مجهول.(@)(@@)(@@)(@@) $ 7641 - عثمان [3] بن سليمان الليثي، من أهل البصرة، أبو عمرو.(@)(@@) يروي عن الحسن. روى عنه الثوري، وأشعث (3).(@)(@@)(@@)(@@) $ 7642 - عثمان [4] بن 
ms1013	 شبرمة.(@)(@@) يروي عن عاصم، روى عنه محمد بن فضيل بن غزوان (4).(@)(@@)(@@)(@@) $ 7643 - عثمان [4] بن صالح بن صالح البغدادي.(@)(@@) شيخ، يروي عن أبي عاصم، حدثنا عنه محمد بن إسحاق، وزعم أنه كان ثقة (5). PageV07P086(@)(@@)(@@)(@@) $ 7644 - عثمان [3] بن صفوان المكي.(@)(@@) يروي المراسيل، روى عنه ابن جريج (1).(@)(@@) وروى عن عكرمة (2).(@)(@@)(@@)(@@) $ 7645 - عثمان [2] بن أبي صفية الأنصاري.(@)(@@) يروي عن ابن عباس، عداده في أهل الكوفة، روى عنه صالح بن حي، وصالح بن جبير (3).(@)(@@) وروى عنه فضيل بن غزوان (4).(@)(@@)(@@)(@@) $ 7646 - عثمان [2] بن أبي الصهباء القرشي، من أهل البصرة.(@)(@@) يروي عن أبي هريرة. روى عنه البصريون (5).(@)(@@) وقال أبو حاتم (6): ليس بمشهور.(@)(@@)(@@)(@@) $ 7647 - عثمان [2] بن صهيب بن سنان.(@)(@@) يروي عن أبيه، روى عنه ابن الهاد (7). PageV07P087(@)(@@) وأعاده في الثالثة (1) وقال: عداده في أهل المدينة.(@)(@@)(@@)(@@) $ 7648 - عثمان [4] بن طالوت بن عباد الجحدري، من أهل البصرة.(@)(@@) روى عن: عبد الوهاب البيع، وأبي عاصم، وأهل بلده، وكان أحفظ من أبيه، حدثنا عنه محمد بن علي الصيرفي غلام طالوت بن عباد، مات وهو شاب لم يتمتع بعلمه في سنة (234ه) (2).(@)(@@)(@@)(@@) $ 7649 - عثمان [4] بن طلحة بن عمر بن عبيد الله بن معمر.(@)(@@) يروي عن ابن أبي ذئب. روى عنه إبراهيم بن المنذر الحزامي (3).(@)(@@) وروى عن عبد الرحمن بن عمر بن درهم (4).(@)(@@)(@@)(@@) $ 7650 - عثمان بن الطيب.(@)(@@) قال الخليلي (5): شيخ كبير المحل، قزويني، ثقة، سمع أبا زرعة، وأبا حاتم، وأبا قلابة، وابن أبي العنبس (6)، وغيرهم، عدل، مرضي، له أوقاف وآثار بقزوين، قديم الموت.(@)(@@) روى عنه علي المقبري والقدماء، ولم يدركه الأحداث، وآخر من روى عنه PageV07P088(@)(@@) بالري جعفر بن يعقوب الفناكي.(@)(@@)(@@)(@@) $ 7651 - عثمان [2] بن عامر بن زيد الأنصاري، من بني عمرو بن عوف.(@)(@@) يروي عن أنس بن مالك، عداده في أهل المدينة، روى عنه ابن أخيه عاصم بن سويد (1) [128 - أ].(@)(@@)(@@)(@@) $ 7652 - عثمان [3] بن عبد الله بن الأرقم القرشي.(@)(@@) يروي عن جده. روى عنه عطاف بن خالد (2).(@)(@@)(@@)(@@) $ 7653 - عثمان [3] بن عبد الله بن أبي عتيق.(@)(@@) يروي عن سعيد بن عمرو بن جعدة. روى عنه سليمان بن بلال 
ms1014	 (3).(@)(@@)(@@)(@@) $ 7654 - عثمان [3] بن عبد الله بن علاثة العقيلي، من أهل الشام.(@)(@@) يروي عن طارق بن أحمر. روى عنه أخوه محمد بن عبد الله بن علاثة، يعتبر حديثه من غير رواية أخيه عنه لأن أخاه لا شيء (4).(@)(@@)(@@)(@@) $ 7655 - عثمان [2] بن عبد الله، مولى سعد بن أبي وقاص.(@)(@@) يروي عن: أبي أسيد، وأبي قتادة، وأبي هريرة. روى عنه ابن أبي ذئب (5).(@)(@@) قلت: كذا في الأصل وفي خط الهيثمي وإنما أحفظ أنه ابن عبيد الله (6) وهو PageV07P089(@)(@@) ابن أبي رافع الآتي (1).(@)(@@)(@@)(@@) $ 7656 - عثمان بن عبد الله الباهلي.(@)(@@) سمع عكرمة عن ابن عباس في قدر سقط فيه طير. وروى عن عبد الله بن بريدة، روى عنه ابن المبارك، وأبو داود.(@)(@@) وقال أبو حاتم: شيخ بصري ليس بالمشهور.(@)(@@) وقال ابن معين: عثمان بن عبد الله الباهلي صاحب عكرمة ثقة (2).(@)(@@)(@@)(@@) $ 7657 - عثمان [3] بن عبد الرحمن بن أبان بن عثمان القرشي الأموي.(@)(@@) يروي عن أبان بن عثمان. روى عنه ابن أبي الزناد (3).(@)(@@) وقال أبو حاتم (4): ضعيف الحديث.(@)(@@)(@@)(@@) $ 7658 - عثمان [3] بن عبد الرحمن بن سعيد بن يربوع المخزومي القرشي.(@)(@@) يروي عن عروة بن الزبير. روى عنه أبو بكر بن عثمان ابنه (5).(@)(@@) وفي «تاريخ الغرباء» لابن يونس: عثمان بن يربوع المخزومي، مدني، قدم مصر، وكتبت عنه. روى عنه يحيى بن عثمان بن صالح. PageV07P090(@)(@@)(@@)(@@) $ 7659 - عثمان بن عبد الرحمن بن عثمان بن موسى بن أبي نصر الكزرتي (1) الشهرزوري، الشرخاني، الإمام تقي الدين المعروف بابن الصلاح.(@)(@@) حصل علم الحديث بخراسان، فروى وصنف فيه وفي غيره، ولم يزل أمره على الصلاح والسداد والاجتهاد والنفع إلى أن توفي يوم الأربعاء الخامس والعشرين من ربيع الآخر سنة ثلاث وأربعين وستمائة، ومولده سنة سبع وسبعين وخمسمائة (2).(@)(@@)(@@)(@@) $ 7660 - عثمان [3] بن عبد الرحمن.(@)(@@) يروي عن سعيد بن جبير. روى عنه ابن جريج (3).(@)(@@)(@@)(@@) $ 7661 - عثمان [4] بن عبد الوهاب بن عبد المجيد الثقفي، من أهل البصرة [128 - ب].(@)(@@) يروي عن أبيه. روى عنه عباس بن محمد الدوري (4).(@)(@@)(@@)(@@) $ 7662 - عثمان [3] بن عبيد الله بن أبي رافع، مولى سعيد بن العاص، من 
ms1015	 أهل المدينة.(@)(@@) يروي عن محرز بن أبي هريرة. روى عنه محمد بن جعفر بن أبي كثير (5). PageV07P091(@)(@@)(@@)(@@) $ 7663 - عثمان [3] بن عبيد الله بن أبي رافع (1)، مولى النبي صلى الله عليه وسلم.(@)(@@) يروي عن أبيه. روى عنه عبد العزيز بن محمد الدراوردي (2).(@)(@@) هذا والذي قبله واحد، وهو ابن عبد الله المتقدم، فالثلاثة واحد والله أعلم.(@)(@@)(@@)(@@) $ 7664 - عثمان [3] بن عبيد الله أبو المنازل، ابن أخي شريح.(@)(@@) كان على قضاء خراسان، يروي عن شريح.(@)(@@) روى عنه: الشيباني، والحجاج بن أرطأة (3).(@)(@@) وروى عنه الحسين بن واقد (4).(@)(@@)(@@)(@@) $ 7665 - عثمان [2] بن عبيد الراسبي.(@)(@@) [روى عن أبي الطفيل] (5). روى عنه: مهدي بن ميمون، وحماد بن زيد (6).(@)(@@) وقال ابن معين (7): ثقة.(@)(@@) وقال أبو حاتم (8): مستقيم الأمر. PageV07P092(@)(@@)(@@)(@@) $ 7666 - عثمان [4] بن عثمان (1) بن عثمان [3] البتي (2)، من أهل البصرة.(@)(@@) يروي عن عيسى بن يونس والبصريين. حدثنا عنه الحسن بن سفيان (3).(@)(@@)(@@)(@@) $ 7667 - عثمان [3] بن أبي عثمان، يروي عن القاسم بن محمد، روى عنه ابن أبي ذئب (4).(@)(@@) وروى عن عمر بن الحكم عن كعب. وروى عنه موسى بن عبيدة (5).(@)(@@)(@@)(@@) $ 7668 - عثمان [4] بن عصام.(@)(@@) يروي عن أبيه المقاطيع. روى عنه بسطام بن وائل (6).(@)(@@)(@@)(@@) $ 7669 - عثمان بن علي بن شعيب، أبو عمرو البغدادي.(@)(@@) قال ابن أبي حاتم: كتب الحديث مع أبي بالشام، وكان حافظا، روى عن هدبة، سمع منه أبي في المذاكرة، وكتب عنه (7).(@)(@@)(@@)(@@) $ 7670 - عثمان [3] بن علي بن كثير بن شهاب.(@)(@@) يروي عن سعيد بن عمرو بن سعيد عن أبي هريرة. PageV07P093(@)(@@) روى عنه إسماعيل بن أبي خالد (1).(@)(@@)(@@)(@@) $ 7671 - عثمان بن علي بن مسلم، أبو سعيد السريجي الميورقي.(@)(@@) سمع عبد العزيز بن جعفر الديري (2). ذكره ابن خزرج، وقال: لقيته سنة (437ه)، وكان من أهل الثقة والفضل (3).(@)(@@)(@@)(@@) $ 7672 - عثمان [3] بن عمار.(@)(@@) يروي عن سعيد بن المسيب. روى عنه ابن جريج (4).(@)(@@) وأعاده في ابن عمارة (5).(@)(@@)(@@)(@@) $ 7673 - عثمان [4] بن عمر الضبي البصري.(@)(@@) يروي عن أبي الوليد الطيالسي [129 - أ]. كتب عنه أصحابنا (6).(@)(@@) وقال الحاكم عن الدارقطني (7): لا بأس به، يكنى أبا عمرو.(@)(@@)(@@)(@@) $ 7674 - عثمان بن عمرو الكحال.(@)(@@) يروي عن 
ms1016	 ابن أبي زائدة. روى عنه أهل الكوفة (8). PageV07P094(@)(@@) وروى عن: مبارك بن فضالة، ومحمد بن مروان العجلي (1).(@)(@@) وروى عنه: كثير بن عبد الله التميمي، وأبو حاتم وأبو زرعة الرازيان، وكان أبو زرعة لا يروي إلا عن ثقة (2).(@)(@@)(@@)(@@) $ 7675 - عثمان [4] بن عمران الحنفي.(@)(@@) يروي عن ابن جريج. روى عنه محمد بن حرب النسائي، ربما أغرب، يعتبر حديثه إذا بين السماع في خبره (3).(@)(@@)(@@)(@@) $ 7676 - عثمان [3] بن العلاء.(@)(@@) يروي عن سلمة بن وردان. روى عنه محمد بن معن (4).(@)(@@) وقال أبو حاتم (5): لا أعرف عثمان بن العلاء ولا الحديث الذي رواه.(@)(@@) وقال البخاري: ضعيف (6).(@)(@@) وذكره ابن الجارود في «الضعفاء» (7). PageV07P095(@)(@@)(@@)(@@) $ 7677 - عثمان بن عيسى بن يوسف التجيبي، أبو عمرو بن (1).(@)(@@) روى عن محمد بن إبراهيم الخشني وغيره.(@)(@@) قال ابن بشكوال: كان موثقا، من أهل العلم البارع، والذهن الثاقب، حافظا لرأي مالك، رأسا فيه. وذكره ابن مطاهر (2).(@)(@@)(@@)(@@) $ 7678 - عثمان بن الفضل الواسطي، أبو الحسن.(@)(@@) روى عن: القاسم بن مالك المزني، وسلم بن قتيبة أبو قتيبة. روى عنه أبو زرعة الرازي (3).(@)(@@)(@@)(@@) $ 7679 - عثمان [3] بن القاسم الباهلي، من أهل البصرة.(@)(@@) يروي عن عكرمة. روى عنه عبد الصمد بن عبد الوارث (4).(@)(@@) وروى عن عبد الله بن بريدة. وروى عنه عبيد الله بن موسى (5).(@)(@@) قال ابن معين (6): ليس به بأس.(@)(@@) وقال أبو حاتم (7): لا أعرفه. PageV07P096(@)(@@)(@@)(@@) $ 7680 - عثمان [4] بن قيس بن محمد بن الأشعث الكندي.(@)(@@) يروي عن أبيه. روى عنه حفص بن غياث. وقيس لم يسمع من أبيه (1).(@)(@@) وقال أبو حاتم الرازي (2): سمع أباه.(@)(@@)(@@)(@@) $ 7681 - عثمان [2] بن قيس، من أهل الكوفة.(@)(@@) يروي عن جرير بن عبد الله. روى عنه إسماعيل بن أبي خالد (3).(@)(@@) وقال ابن حزم (4): مجهول، روى عن جرير في الأشربة (5).(@)(@@)(@@)(@@) $ 7682 - عثمان [3] بن قيس.(@)(@@) يروي عن رجل عن ابن عباس. روى عنه حجاج بن حسان (6).(@)(@@) وقال ابن أبي حاتم (7): روى عن قيس بن هشام أنه سأل ابن عباس عن النبيذ. وهذا في طبقة الذي روى له أبو داود في القدر (8)، وغالب ظني أن الذي روى له أبو داود هو أبو 
ms1017	 اليقظان، فالله أعلم. PageV07P097(@)(@@)(@@)(@@) $ 7683 - عثمان [4] بن قيس الكلابي.(@)(@@) يروي عن أبي أيوب الهجري. روى عنه وكيع (1) [129 - ب].(@)(@@)(@@)(@@) $ 7684 - عثمان [3] بن أبي الكنات.(@)(@@) يروي عن ابن أبي مليكة. روى عنه يسرة بن صفوان اللخمي (2).(@)(@@) قال أبو حاتم (3): وروى عنه البصريون.(@)(@@) له حديث: «نهيتكم عن زيارة القبور»، قال البخاري (4): لا يصح.(@)(@@)(@@)(@@) $ 7685 - عثمان [2] بن محصن.(@)(@@) يروي عن ابن عباس. روى عنه نوح بن قيس الطاحي (5).(@)(@@) وقال أبو حاتم (6): روى عن ابن عباس مرسلا.(@)(@@)(@@)(@@) $ 7686 - عثمان بن محمد بن أحمد بن محمد بن هارون السمرقندي التنيسي.(@)(@@) حدث عن: أحمد بن شيبان الرملي، ومحمد بن عبد الحكم القطري، وأبي أمية الطرسوسي، وغيرهم.(@)(@@) قال ابن يونس (7): كانت له سماعات صحاح في كتب أبيه، وكان ثقة، وعلت PageV07P098(@)(@@) سنه. توفي بتنيس في شعبان سنة خمس وأربعين وثلاثمائة.(@)(@@)(@@)(@@) $ 7687 - عثمان [2] بن محمد بن سويد (1).(@)(@@) يروي المراسيل. روى عنه الزهري (2).(@)(@@)(@@)(@@) $ 7688 - عثمان [3] بن محمد بن عبيد الله بن عبد الله بن عمر بن الخطاب، من أهل المدينة، كنيته أبو قدامة.(@)(@@) يروي عن عائشة بنت سعد بن أبي وقاص. روى عنه خالد بن مخلد القطواني (3).(@)(@@) وروى عنه: إسماعيل بن أبي أويس، وهشام بن عبيد الله الرازي (4).(@)(@@)(@@)(@@) $ 7689 - عثمان بن محمد بن علي بن جعفر، أبو الحسين الذهبي.(@)(@@) قال مسلمة: كان كثير الحديث، عنده مصنفات ابن المديني وابن معين. توفي سنة أربع وثلاثين وثلاثمائة.(@)(@@)(@@)(@@) $ 7690 - عثمان [4] بن مخلد التمار، من أهل واسط.(@)(@@) يروي عن هشيم. روى عنه محمد بن عبد الملك الدقيقي (5). PageV07P099(@)(@@)(@@)(@@) $ 7691 - عثمان [3] بن مرجعة، أبو مرجعة الهنائي، من أهل البصرة.(@)(@@) يروي عن: عكرمة، ومالك بن دينار. روى عنه أهل البصرة (1).(@)(@@)(@@)(@@) $ 7692 - عثمان بن أبي مروان ناصح، أبو الحكم الخناق.(@)(@@) روى عنه عثمان بن صالح. قال ابن يونس: كان فاضلا، مقبولا عند القضاة: غوث، وابن لهيعة. وذكره الطحاوي بفضله، وقال: كان من خيار أهل مصر. توفي سنة ست وثمانين ومائة.(@)(@@)(@@)(@@) $ 7693 - عثمان [3] بن مسلم الدمشقي.(@)(@@) يروي عن مكحول. روى عنه سعيد أبي أيوب (2).(@)(@@) وروى عن بلال بن سعد. وروى 
ms1018	 عنه محمد بن شعيب بن شابور (3).(@)(@@)(@@)(@@) $ 7694 - عثمان [3] بن مضرس بن عثمان الجهني، أخو عمر بن مضرس.(@)(@@) يروي [130 - أ] عن أبيه. روى عنه حرملة بن عبد العزيز (4).(@)(@@) وقال الدارمي (5): قلت ليحيى بن معين عثمان وعمر ابنا مضرس؟ قال: ما أعرفهما. PageV07P100(@)(@@)(@@)(@@) $ 7695 - عثمان بن مطيع الرازي، ابن أخت عبد العزيز بن أبي عثمان، ختن عثمان بن زائدة.(@)(@@) روى عن: عبد الواحد بن زياد، وقزعة بن سويد، وحزم بن أبي حزم، وعبد المؤمن بن عبيد الله. روى عنه أبو حاتم وقال: صدوق (1).(@)(@@)(@@)(@@) $ 7696 - عثمان [3] بن معاوية القرشي.(@)(@@) يروي عن الحسن. روى عنه موسى بن إسماعيل (2).(@)(@@)(@@)(@@) $ 7697 - عثمان (3) بن معاوية القرشي.(@)(@@) يروي عن أبيه. روى عنه قراد أبو نوح (4).(@)(@@)(@@)(@@) $ 7698 - عثمان [4] بن مكتل، من أهل مصر.(@)(@@) من ثقات المسلمين ومفتيهم، يروي عن عبيد الله بن عمر، وأهل المدينة.(@)(@@) روى عنه أهل مصر (5).(@)(@@) وروى عن إبراهيم بن إسماعيل بن مجمع. وروى عنه سعيد بن الحكم بن PageV07P101(@)(@@) أبي مريم (1).(@)(@@) وروى عنه زياد بن يونس (2).(@)(@@)(@@)(@@) $ 7699 - عثمان [4] بن المنذر.(@)(@@) يروي عن القاسم بن محمد الثقفي، عداده في أهل الشام، روى عنه الوليد بن مسلم (3).(@)(@@)(@@)(@@) $ 7700 - عثمان [3] بن مورع، أبو شيبة.(@)(@@) يروي عن الشعبي. روى عنه عمرو (4) بن محمد العنقزي (5).(@)(@@)(@@)(@@) $ 7701 - عثمان بن النجاشي.(@)(@@) يروي عن سعيد بن المسيب. روى عنه الزهري (6).(@)(@@)(@@)(@@) $ 7702 - عثمان [3] بن نجيح.(@)(@@) يروي عن الحجازيين. روى عنه ابن أبي ذئب (7).(@)(@@) وروى عن أبي الغيث (8). PageV07P102(@)(@@)(@@)(@@) $ 7703 - عثمان بن نسطاس، مولى كثير بن الصلت. مدني.(@)(@@) روى عن: سعيد بن المسيب، وعطاء بن يسار، وسعيد المقبري.(@)(@@) روى عنه أبو عامر العقدي.(@)(@@) قال أبو حاتم: لا بأس به (1).(@)(@@)(@@)(@@) $ 7704 - عثمان [3] بن النعمان بن عجلان الزرقي الأنصاري، من أهل المدينة.(@)(@@) يروي عن أبان بن عثمان. روى عنه ابن إسحاق (2).(@)(@@)(@@)(@@) $ 7705 - عثمان [4] بن هارون القرشي الأنماطي، من أهل الكوفة.(@)(@@) يروي عن عاصم بن قدامة. روى عنه يعقوب بن سفيان (3).(@)(@@)(@@)(@@) $ 7706 - عثمان [4] بن أبي هند العبسي، من أهل الكوفة.(@)(@@) يروي عن عمر بن عبد العزيز. روى عنه: وكيع، وأبو 
ms1019	 نعيم (4).(@)(@@) وروى عن أبي عبيدة بن عبد الله بن مسعود، وسمع منه وكيع (5).(@)(@@) وقال الإمام أحمد (6): [130 - ب] كوفي شيخ ثقة ثقة. PageV07P103(@)(@@) وقال ابن معين (1): ثقة.(@)(@@) وقال أبو حاتم (2): ما به بأس.(@)(@@)(@@)(@@) $ 7707 - عثمان [4] بن وثاب المدني.(@)(@@) يروي عن سعيد بن المسيب. روى عنه ابن أبي ذئب (3).(@)(@@)(@@)(@@) $ 7708 - عثمان [2] بن وكيع العبدي، من أهل البصرة.(@)(@@) يروي عن سبعة من أصحاب رسول الله صلى الله عليه وسلم. روى عنه السكن بن أبي السكن (4).(@)(@@) قلت: كذا في الأصل، وفي خط الهيثمي، وقال ابن أبي حاتم (5): عثمان بن وكيع أبو مدرك، قال: كان فينا سبعة من أصحاب النبي صلى الله عليه وسلم منهم سكن بن أبي سكن. روى عن يونس بن عبيد. روى عنه عبد الرحمن بن مهدي، ومعتمر بن سليمان، وسليمان بن حرب. سمعت أبي يقول ذلك، ويقول: لا أعرفه. PageV07P104(@)(@@)(@@)(@@) $ 7709 - عثمان [4] بن يحيى بن عيسى (1) القرقساني، إمام مسجد قرقيسياء، كنيته أبو عمرو الصياد.(@)(@@) يروي عن ابن عيينة، حدثنا عنه أحمد بن محمد بن الأزهر السجستاني، مات سنة ثمان وخمسين ومائتين (2).(@)(@@)(@@)(@@) $ 7710 - عثمان [2] بن يزدويه، أبو عمرو.(@)(@@) يروي عن أنس بن مالك. روى عبد الرزاق، عن أبيه، وقد روى عنه معمر، وابن أبي رواد (3).(@)(@@) وروى عن: عمر بن عبد العزيز، ويعفر بن زوذي (4)، ووهب بن منبه، وسعيد بن جبير. وروى عنه أمية بن شبل (5).(@)(@@)(@@)(@@) $ 7711 - عثمان [3] بن يسار.(@)(@@) يروي عن طاووس. روى ابن المبارك عن عبيد الله بن عبد الرحمن عنه، وهذا هو الأشجعي (6). PageV07P105(@)(@@)(@@)(@@) $ 7712 - عثمان [4] بن يسار.(@)(@@) يروي عن المغيرة بن مقسم. روى عنه جرير بن عبد الحميد الضبي (1).(@)(@@) وقال ابن أبي حاتم (2): عثمان بن يسار ، روى عن ابن عباس، وتميم بن حذلم (3). روى عنه المغيرة بن مقسم. سمعت أبي يقول ذلك.(@)(@@) ثنا صالح بن أحمد بن حنبل: ثنا علي يعني ابن المديني، قال: سألت جريرا عن عثمان بن يسار الذي روى عنه المغيرة. فقال: كان [ضبيا] (4) إمام مسجد بني السيد، وأثنى عليه خيرا.(@)(@@)(@@)(@@) $ 7713 - عثمان [2]، مولى الزبير (5).(@)(@@) يروي عن ابن 
ms1020	 عمر. روى عنه إسماعيل بن أبي خالد (6).(@)(@@)(@@)(@@) $ 7714 - عثمان [2] الطويل، من أهل الجزيرة، عداده في أهل البصرة.(@)(@@) يروي عن أنس بن مالك، ربما أخطأ. روى عنه: شعبة بن الحجاج، وزهير بن معاوية (7). PageV07P106(@)(@@) وروى عن أبي العالية. وروى عنه: ليث بن أبي سليم، وعنبسة بن سعيد قاضي الري (1).(@)(@@) قال أبو حاتم (2): هو شيخ [131 - أ].(@)(@@)(@@)(@@) $ 7715 - العجاج [2] بن رؤبة.(@)(@@) يروي عن أبي هريرة: «طاف الخيالان فهاجا سقما». روى عنه ابنه رؤبة بن العجاج، وقد قيل إن اسم أبي (3) العجاج عبد الله (4).(@)(@@)(@@)(@@) $ 7716 - عجلان [3] بن سالم.(@)(@@) يروي عن أبي قرصافة، واسم أبي قرصافة جندرة بن خيشنة، روى عنه زياد بن الجعد (5).(@)(@@)(@@)(@@) $ 7717 - عجلان [2] بن سمعان.(@)(@@) يروي عن أبي هريرة. روى عنه: أبو سفيان طلحة بن نافع، وصالح بن صالح.(@)(@@) كذا في الأصل (6) وفي خط الهيثمي، وقال ابن أبي حاتم (7): روى عنه طلحة PageV07P107(@)(@@) بن صالح، سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول وطلحة مجهول.(@)(@@)(@@)(@@) $ 7718 - عجلان [2] بن سهيل (1) الباهلي.(@)(@@) يروي عن أبي أمامة. روى عنه سليمان بن موسى (2).(@)(@@) وروى عنه رجاء بن أبي سلمة (3).(@)(@@) قال البخاري: لم يصح حديثه.(@)(@@) وذكره العقيلي في «الضعفاء» (4).(@)(@@) وقيل ضعفه أبو زرعة (5).(@)(@@) وقال ابن عدي (6): ليس بمعروف.(@)(@@) وقال أبو حاتم (7): روى حديثا واحدا، لا أعلم بحديثه بأسا، وأدخله بعض الناس في كتاب «الضعفاء» يحول منه. PageV07P108(@)(@@)(@@)(@@) $ 7719 - عجلان [3] بن عبد الله العدوي.(@)(@@) يروي عن مالك بن دينار، عداده في أهل البصرة، روى عنه عبد الرحمن بن صالح (1).(@)(@@) وروى عنه ضرار بن صرد (2).(@)(@@) وقال أبو زرعة (3): بصري لا بأس به.(@)(@@)(@@)(@@) $ 7720 - عجلان [2]، مولى لآل يزيد بن الهاد.(@)(@@) يروي عن أبي هريرة. روى عنه يزيد بن الهاد (4).(@)(@@)(@@)(@@) $ 7721 - عجلان [2] مولى ثقيف، من أهل البصرة (5).(@)(@@) يروي عن أبي بكرة، وسمرة. روى عنه بحر بن مرار (6).(@)(@@)(@@)(@@) $ 7722 - عجلان [2] أبو غالب، يروي عن ابن عباس.(@)(@@) روى عنه محمد بن الفضل بن عطية الخراساني (7).(@)(@@) وقال أبو حاتم (8): هو شيخ، روى عنه محمد بن عون الخراساني. PageV07P109(@)(@@)(@@)(@@) $ 7723 - عجيبة بن عبد الحميد بن عقبة بن طلق. 