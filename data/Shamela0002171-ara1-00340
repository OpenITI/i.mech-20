ms329	 غيره د س ق(@)(@@)(@@)(@@) | 1874- (@)(@@) سعيد بن خالد بن عمرو بن عثمان الاموي الدمشقي عن قبيصة بن ذؤيب وغيره وعنه الزهري ومعن بن محمد الغفاري وثق م(@)(@@)(@@)(@@) | 1875- (@)(@@) سعيد بن خالد الخزاعي عن بن المنكدر وأبي حازم وعنه يعقوب الحضرمي وأبو بحر البكراوي قال البخاري فيه نظر د(@)(@@)(@@)(@@) | 1876- (@)(@@) سعيد بن أبي خالد البجلي عن أبي كاهل وعنه أخوه إسماعيل الحافظ وثق س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1877- (@)(@@) سعيد بن خثيم أبو معمر الهلالي الكوفي عن جدته وزيد بن علي ويزيد بن أبي زياد وعنه أحمد والناقد وثقه بن معين ت س(@)(@@)(@@)(@@) | 1878- (@)(@@) سعيد بن أبي خيرة البصري عن الحسن وعنه بن أبي عروبة وغيره وثق حب د س ق(@)(@@)(@@)(@@) | 1879- (@)(@@) سعيد بن داود الزنبري عن مالك وعدة وعنه إبراهيم الحربي والرمادي ضعفه أبو زرعة خت(@)(@@)(@@)(@@) | 1880- (@)(@@) سعيد بن ذؤيب المروزي عن بن عيينة وأبي أسامة وعنه عبيد الله بن واصل والحسن بن سفيان وثق وقد روى عنه النسائي لكن في السنن بواسطة توفي 237 س(@)(@@)(@@)(@@) | 1881- (@)(@@) سعيد بن أبي راشد أو بن راشد عن يعلى بن مرة وعنه عبد الله بن عثمان بن خثيم صدوق ت ق(@)(@@)(@@)(@@) | 1882- (@)(@@) سعيد بن الربيع أبو زيد الهروي مصري يتجر في الثياب الهروية عن بن أبي عروبة وقرة وعنه البخاري وعبد والكديمي ثقة توفي 211 خ م ت س(@)(@@)(@@)(@@) | 1883- (@)(@@) سعيد بن زربي أبو عبيدة الخزاعي عن الحسن ومحمد وعنه يونس المؤدب وعلي بن الجعد ضعفوه ت(@)(@@)(@@)(@@) | 1884- (@)(@@) سعيد بن زرعة الحمصي الجرار عن ثوبان وعنه حسن بن همام ومرزوق أبو عبد الله وثق حب ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1885- (@)(@@) سعيد بن زكريا المدائني عن حمزة الزيات وزمعة بن صالح وعنه أحمد والزعفراني قال البخاري صدوق وقال أبو حاتم ليس بذاك ت ق(@)(@@)(@@)(@@) | 1886- (@)(@@) سعيد بن زياد المدني عن جابر وأبي سلمة وعنه سعيد بن أبي هلال واه خت د(@)(@@)(@@)(@@) | 1887- (@)(@@) سعيد بن زياد المكي عن طاوس وزياد بن صبيح وغيرهما وعنه وكيع ومكي صالح د س(@)(@@)(@@)(@@) | 1888- (@)(@@) سعيد بن زياد المدني المؤدب عن سليمان بن يسار وعدة وعنه وكيع وخالد بن مخلد وثق 
ms330	 حب د(@)(@@)(@@)(@@) | 1889- (@)(@@) سعيد بن زيد أبو الحسن أخو حماد عن عبد العزيز بن صهيب وابن جدعان وعنه عارم ومسلم قال جماعة ليس بالقوي ووثقه بن معين خت م د ت ق(@)(@@)(@@)(@@) | 1890- (@)(@@) سعيد بن زيد الفزاري عن أبيه وعنه مسعر وحجاج بن أرطاة ثقة ق(@)(@@)(@@)(@@) | 1891- (@)(@@) سعيد بن زيد العدوي أحد العشرة أسلم هو وزوجته فاطمة قبل أخيها عمر عنه قيس بن أبي حازم وأبو عثمان النهدي مات بالمدينة سنة 51 ع(@)(@@)(@@)(@@) | 1892- (@)(@@) سعيد بن سالم القداح أبو عثمان المكي عن بن جريج وطلحة بن عمرو وعنه العدني وعلي بن حرب قال أبو حاتم محله الصدق وقال أبو داود صدوق يذهب إلى الارجاء د س(@)(@@)(@@)(@@) | 1893- (@)(@@) سعيد بن السائب الطائفي عن أبيه وعبد الله بن يزيد وعنه معن القزاز وابن مهدي وخالد(@)(@@) PageV00P000(@)(@@) بن مخلد ثقة بكاء راهب د س ق(@)(@@)(@@)(@@) | 1894- (@)(@@) سعيد بن سعد بن عبادة الانصاري قيل له صحبة عن أبيه وعنه ابنه شراحيل وأبو أمامة بن(@)(@@) سهل ولي اليمن لعلي س ق(@)(@@)(@@)(@@) | 1895- (@)(@@) سعيد بن أبي سعيد مولى بن حزم عن أبي رافع وأدرع السلمي وعنه موسى بن عبيدة مجهول وقد وثق له في صلاة التسبيح ت ق(@)(@@)(@@)(@@) | 1896- (@)(@@) سعيد بن أبي سعيد كيسان أبو سعد المقبري عن أبيه وأبي هريرة وعائشة وعنه الليث ومالك قال أحمد ليس به بأس توفي 123 وقيل 125 ع(@)(@@)(@@)(@@) | 1897- (@)(@@) سعيد بن سفيان الجحدري عن داود بن أبي هند وابن عون وعنه بندار وابن مثنى حسن الترمذي له ت(@)(@@)(@@)(@@) | 1898- (@)(@@) سعيد بن سفيان الاسلمي عن جعفر بن محمد وسدير وعنه بن أبي فديك وآخر ق(@)(@@)(@@)(@@) | 1899- (@)(@@) سعيد بن سلمان عن يزيد بن نعامة وعنه عمران القصير وثق ت(@)(@@)(@@)(@@) | 1900- (@)(@@) سعيد بن سلمة بن أبي الحسام المدني عن أبيه وابن المنكدر وعنه التبوذكي ومحمد بن أبي بكر المقدمي ضعفه النسائي وقواه بن حبان خت م س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1901- (@)(@@) سعيد بن سلمة المخزومي عن المغيرة بن أبي بردة وعنه صفوان بن سليم والجلاح وثقه النسائي 4(@)(@@)(@@)(@@) | 1902- (@)(@@) سعيد بن سليمان الضبي أبو عثمان الواسطي البزاز الحافظ سعدويه عن 
ms331	 فضيل بن مرزوق وعبد العزيز بن الماجشون وعنه البخاري وأبو داود وخلف العكبري قال أبو حاتم لعله أوثق من عفان وقال صالح جزرة سمعته يقول حججت ستين حجة وما دلست قط وقال أحمد كان يصحف عاش مائة سنة مات 225 ع(@)(@@)(@@)(@@) | 1903- (@)(@@) سعيد بن سمعان عن أبي هريرة وابن حسنة وعنه بن أبي ذئب وسابق الرقي وثق د ت س(@)(@@)(@@)(@@) | 1904- (@)(@@) سعيد بن سنان أبو سنان البرجمي كوفي بالري عن الضحاك والشعبي وعنه بكر بن بكار وأبو نعيم عابد زاهد حجاج وثقه أبو حاتم وقال أحمد ليس بالقوي د ت ق(@)(@@)(@@)(@@) | 1905- (@)(@@) سعيد بن سنان أبو مهدي الحمصي عن أبي الزاهرية وراشد بن سعد وعنه أبو اليمان(@)(@@) وأبو جعفر النفيلي زاهد ضعيف الحديث توفي 168 ق(@)(@@)(@@)(@@) | 1906- (@)(@@) سعيد بن شبيب أبو عثمان الحضرمي مصري صدوق عن مالك وخلف بن خليفة وعنه أبو داود والديرعاقولي وأبو حاتم من الصلحاء د س(@)(@@)(@@)(@@) | 1907- (@)(@@) سعيد بن شرحبيل الكندي الكوفي عن الليث وسعيد بن عطارد وعنه البخاري والحارث بن أبي أسامة توفي 212 خ س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1908- (@)(@@) سعيد بن أبي صدقة أبو قرة عن بن سيرين وغيره حماد بن زيد وابن علية ثقة د(@)(@@)(@@)(@@) | 1909- (@)(@@) سعيد بن العاص بن أبي أحيحة الاموي ولد قبل بدر وروى عن عمر وعائشة وعنه ابناه عمر الاشدق ويحيى وعروة بن الزبير وكان أشبه شئ لهجة برسول الله صلى الله عليه وسلم فأقيمت عربية القرآن على لسانه ولي إمرة الكوفة ثم المدينة توفي 58 م س(@)(@@)(@@)(@@) | 1910- (@)(@@) سعيد بن عامر الضبعي أحد الاعلام عن يونس بن عبيد وحبيب بن الشهيد وعنه عبد والدارمي قال يحيى القطان هو شيخ البصرة منذ أربعين سنة قال بن معين ثقة مأمون توفي 208 ع(@)(@@)(@@)(@@) | 1911- (@)(@@) سعيد بن عامر عن بن عمر وعنه ليث بن أبي سليم قال بن معين ليس به بأس ق(@)(@@)(@@)(@@) | 1912- (@)(@@) سعيد بن عبد الله بن جريج عن أبي برزة مولاه وعنه الاعمش وحوشب بن عقيل وثق حب د ت(@)(@@)(@@)(@@) | 1913- (@)(@@) سعيد بن عبد الله الجهني عن محمد بن عمر بن 
ms332	 علي وعنه بن وهب وثق حب ت ق(@)(@@) *- سعيد بن عبد الله هو بن خالد مر 1873(@)(@@) *- سعيد بن عبد الله الاغطش وقيل سعد مر 1834(@)(@@)(@@)(@@) | 1914- (@)(@@) سعيد بن عبد الجبار القرشي البصري الكرابيسي بمكة عن حماد بن سلمة ومالك وعنه مسلم وأبو داود وعبدان ثقة توفي 236 م د(@)(@@)(@@)(@@) | 1915- (@)(@@) سعيد بن عبد الجبار الزبيدي الحمصي عن روح بن جناح وعبيد بن ضمرة وعنه بقية ويحيى بن آدم واه ق(@)(@@)(@@)(@@) | 1916- (@)(@@) سعيد بن عبد الرحمن بن أبزي الخزاعي بالكوفة عن أبيه وعنه قتادة وعطاء بن السائب ع(@)(@@)(@@)(@@) | 1917- (@)(@@) سعيد بن عبد الرحمن أبو عبيد الله المخزومي المكي عن بن عيينة وعدة وعنه الترمذي(@)(@@) PageV00P000(@)(@@) والنسائي ومحمد الديبلي ثقة توفي 249 ت س(@)(@@)(@@)(@@) | 1918- (@)(@@) سعيد بن عبد الرحمن بن أبي سعيد الخدري عن أبيه وعنه بن إسحاق والوليد بن كثير وثق م(@)(@@)(@@)(@@) | 1919- (@)(@@) سعيد بن عبد الرحمن الجمحي أبو عبد الله المدني قاضي العسكر عن عبد الرحمن بن القاسم وسهيل وعنه لوين وعلي بن حجر وثقه بن معين ولينه الفسوي توفي 176 م د س ق(@)(@@)(@@)(@@) | 1920- (@)(@@) سعيد بن عبد الرحمن أبو شيبة الزبيدي الكوفي قاضي الري عن إبراهيم وسعيد بن جبير وعنه بن فضيل وحكام بن سلم يغرب وثقه أبو داود س(@)(@@)(@@)(@@) | 1921- (@)(@@) سعيد بن عبد الرحمن البغدادي بأنطاكية عن إسماعيل بن أبي أويس ونحوه وعنه النسائي وحاجب بن أركين س(@)(@@)(@@)(@@) | 1922- (@)(@@) سعيد بن عبد الرحمن بن أبي العمياء عن السائب بن مهران وغيره وعنه خالد المهري وابن وهب وثق حب د(@)(@@)(@@)(@@) | 1923- (@)(@@) سعيد بن عبد الرحمن بن مكمل عن أيوب بن بشير وغيره وعنه شريك بن أبي نمر وسهيل وثق د ت(@)(@@)(@@)(@@) | 1924- (@)(@@) سعيد بن عبد الرحمن بن يزيد بن رقيش الاسدي عن خاله عبد الله بن أبي أحمد وأنس وعنه مالك وإسماعيل بن جعفر ثقة د(@)(@@)(@@)(@@) | 1925- (@)(@@) سعيد بن عبد الرحمن الغفاري عن علي وكعب وعنه حجاج بن شداد وعمار بن سعد وثق حب د(@)(@@)(@@)(@@) | 1926- (@)(@@) سعيد بن عبد العزيز التنوخي مفتي دمشق وعالمها قرأ على بن عامر وسمع مكحولا وزياد 
ms333	(@)(@@) PageV00P000(@)(@@) بن أبي سودة وسأل عطاء لما حج وعنه بن مهدي وأبو مسهر وأبو اليمان قال أحمد هو والاوزاعي عندي سواء كان سعيد بكاء خوافا فسئل فقال ما قمت إلى الصلاة إلا مثلت لي جهنم وقال أبو مسهر سمعته يقول ما لي كتاب وقال النسائي ثقة ثبت مات 167 من أبناء الثمانين م 4(@)(@@)(@@)(@@) | 1927- (@)(@@) سعيد بن عبيد الله بن جبير بن حية الثقفي البصري عن بن بريدة وبكر المزني وعنه خالد بن الحارث وروح ثقة خ ت س ق(@)(@@)(@@)(@@) | 1928- (@)(@@) سعيد بن عبيد بن السباق الثقفي عن أبي هريرة وأبي سعيد وعنه الزهري وفليح ثقة قاله النسائي د ت ق(@)(@@)(@@)(@@) | 1929- (@)(@@) سعيد بن عبيد الطائي أبو الهذيل عن سعيد بن جبير وعلي بن ربيعة وعبد الله بن شقيق وعنه القطان وأبو نعيم ثقة خ م د ت س(@)(@@)(@@)(@@) | 1930- (@)(@@) سعيد بن عبيد الهنائي عن الحسن وعبد الله بن شقيق وعنه عبد الصمد ومسلم قال أبو حاتم شيخ ت س(@)(@@)(@@)(@@) | 1931- (@)(@@) سعيد بن عبيد عن أبي حاتم المزني وعنه عبد الله بن هرمز مجهول ت(@)(@@)(@@)(@@) | 1932- (@)(@@) سعيد بن عثمان البلوي عن عاصم بن أبي البداح وعروة أو عزرة وعنه عيسى بن يونس وثق د(@)(@@)(@@)(@@) | 1933- (@)(@@) سعيد بن أبي عروبة مهران أبو النضر اليشكري مولاهم أحد الاعلام عن الحسن ومحمد وأبي رجاء العطاردي وقتادة وعنه شعبة والقطان وغندر قال أحمد كان يحفظ لم يكن له كتاب وقال بن معين هو من أثبتهم في قتادة وقال أبو حاتم هو قبل أن يختلط ثقة توفي 156 ع(@)(@@)(@@)(@@) | 1934- (@)(@@) سعيد بن عطية الليثي عن سعيد بن جبير وشهر وعنه أبو داود والمقرئ وثق ت(@)(@@)(@@)(@@) | 1935- (@)(@@) سعيد بن عمارة الكلاعي عن هشام بن الغاز وغيره وعنه بقية وعلي بن عياش مستور ق(@)(@@)(@@)(@@) | 1936- (@)(@@) سعيد بن عمرو بن أشوع الهمداني القاضي عن أبي سلمة والشعبي وعنه خالد الحذاء والثوري ثقة لم يتكهل خ م ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1937- (@)(@@) سعيد بن عمرو السكوني عن بقية وجماعة وعنه النسائي وأبو عوانة قال بن أبي حاتم صدوق كتب إلا بجزء من حديثه س 
ms334	(@)(@@)(@@)(@@) | 1938- (@)(@@) سعيد بن عمرو بن سعيد بن العاص بن أبي أحيحة عن أبي هريرة وابن عباس وعنه ابناه إسحاق وخالد وحفيده عمرو بن يحيى وشعبة نزل الكوفة سوى ت(@)(@@)(@@)(@@) | 1939- (@)(@@) سعيد بن عمرو الكندي الاشعثي عن جعفر بن سليمان وعبثر وعنه مسلم وموسى بن هارون ثقة توفي 23 م س(@)(@@)(@@)(@@) | 1940- (@)(@@) سعيد بن عمرو بن شرحبيل الانصاري السعدي عن أبيه وعنه مالك والداروردي ثقة س(@)(@@)(@@)(@@) | 1941- (@)(@@) سعيد بن عمرو الحضرمي حمصي عن إسماعيل بن عياش وبقية وعنه أبو داود وأبو أمية صدوق د(@)(@@) *- سعيد بن أبي عمران فيروز سعيد بن أبي عمران فيروز 1946(@)(@@)(@@)(@@) | 1942- (@)(@@) سعيد بن علاقة أبو فاختة مولى بني هاشم عن علي وأم هانئ وعائشة وعنه ابنه ثوير وعمرو بن دينار وثقه الدارقطني ت ق(@)(@@)(@@)(@@) | 1943- (@)(@@) سعيد بن عيسى بن تليد الرعيني عن المفضل بن فضالة وابن عيينة وعنه البخاري ومقدام بن داود وثقه أبو حاتم توفي 219 خ س(@)(@@)(@@)(@@) | 1944- (@)(@@) سعيد بن غزوان عن أبيه وصالح بن يحيى وعنه معاوية بن صالح وأبو وهب وثق د(@)(@@)(@@)(@@) | 1945- (@)(@@) سعيد بن الفرج البلخي عن أبي النضر ومكي بن إبراهيم وعنه النسائي وعبد الله بن محمد بن علي البلخي صدوق توفي 241 س(@)(@@)(@@)(@@) | 1946- (@)(@@) سعيد بن فيروز أبوالبختري الطائي مولاهم الكوفي عن علي وعبد الله مرسلا وعن أبي(@)(@@) PageV00P000(@)(@@) برزة وعبيدة السلماني وعنه عمرو بن مرة ومسلم البطين قال حبيب بن أبي ثابت كان أعلمنا وأفقهنا توفي 83 ع(@)(@@)(@@)(@@) | 1947- (@)(@@) سعيد بن كثير بن عفير الحافظ أبو عصمان الانصاري المصري عن مالك والليث وعنه البخاري وعثمان بن خرزاذ وأبو الزنباع قال أبو حاتم صدوق ليس بالثبت كان يقرأ من كتب الناس توفي 226 عن ثمانين سنة خ م س(@)(@@)(@@)(@@) | 1948- (@)(@@) سعيد بن كثير بن المطلب بن أبي وداعة عن أبيه وعمه جعفر وعنه بن جريج س(@)(@@)(@@)(@@) | 1949- (@)(@@) سعيد بن أبي كرب الهمداني عن جابر وعنه سليمان بن كيسان وأبو إسحاق وثق ق(@)(@@)(@@)(@@) | 1950- (@)(@@) سعيد بن محمد بن جبير بن مطعم عن جده وأبي هريرة وعنه بن عمه عثمان وابن أبي ذئب وثق د 
ms335	 س(@)(@@)(@@)(@@) | 1951- (@)(@@) سعيد بن محمد الجرمي عن شريك وحاتم بن إسماعيل وعنه البخاري ومسلم وإبراهيم المخرمي ثقة يتشيع خ م د ق(@)(@@)(@@)(@@) | 1952- (@)(@@) سعيد بن محمد الوراق أبو الحسن كوفي نزل بغداد عن يحيى بن سعيد ومطرف بن طريف وعنه أحمد وابن عرفة ضعيف ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1953- (@)(@@) سعيد بن مرجانة عن أبي هريرة وابن عباس وعنه واقد بن محمد العمري وجماعة ثقة مدني توفي 97 خ م ت س(@)(@@)(@@)(@@) | 1954- (@)(@@) سعيد بن المرزبان العبسي أبو سعد البقال الكوفي الاعور عن أنس وابن أبي ليلى وعنه شعبة وعبيد الله بن موسى قال أحمد منكر الحديث مات مع الاعمش ت ق(@)(@@)(@@)(@@) | 1955- (@)(@@) سعيد بن مروان البغدادي بنيسابور عن أبي نعيم والقعنبي وعنه البخاري وابن ماجة وابن خزيمة توفي 252 خ ق(@)(@@)(@@)(@@) | 1956- (@)(@@) سعيد بن مزاحم عن أبيه وعنه قتيبة مجهول د س(@)(@@)(@@)(@@) | 1957- (@)(@@) سعيد بن مسروق الثوري عن أبي وائل والشعبي وعنه ابناه وأبو عوانة ثقة توفي 126 ع(@)(@@)(@@)(@@) | 1958- (@)(@@) سعيد بن مسلم بن بانك المدني عن أبيه وعلي بن الحسين وعنه معن والقعنبي ثقة س ق(@)(@@)(@@)(@@) | 1959- (@)(@@) سعيد بن مسلمة بن عبد الملك عن ليث وهشام بن عروة وعنه أيوب الوزان ويوسف بن بحر واه توفي بعد المائتين ت ق(@)(@@)(@@)(@@) | 1960- (@)(@@) سعيد بن المسيب بن حزن الامام أبو محمد المخزومي أحد الاعلام وسيد التابعين عن(@)(@@) PageV00P000(@)(@@) عمر وعثمان وسعد وعنه الزهري وقتادة ويحيى بن سعيد ثقة حجة فقيه رفيع الذكر رأس في العلم والعمل عاش تسعا وسبعين سنة مات 94 ع(@)(@@)(@@)(@@) | 1961- (@)(@@) سعيد بن المغيرة المصيصي الصياد عن بن المبارك وأبي إسحاق الفزاري وعنه أبو حاتم والديرعاقولي ثقة س(@)(@@)(@@)(@@) | 1962- (@)(@@) سعيد بن منصور أبو عثمان الخراساني الحافظ مصنف السنن بمكة عن فليح والليث وعنه مسلم وأبو داود وبهلول بن إسحاق وأبو شعيب الحراني مات 227 ع(@)(@@)(@@)(@@) | 1963- (@)(@@) سعيد بن المهاجر أو بن أبي المهاجر الحمصي عن المقدام بن معدي كرب وعنه الحارث بن عمير الشامي د(@)(@@)(@@)(@@) | 1964- (@)(@@) سعيد بن ميمون عن نافع وعنه عبد الله بن عصمة ق(@)(@@)(@@)(@@) | 1965- (@)(@@) سعيد بن ميناء أبو الوليد عن أبي هريرة 
ms336	 وجابر وعنه سليم بن حيان وحنظلة بن أبي سفيان ثقة خ م د ت ق(@)(@@)(@@)(@@) | 1966- (@)(@@) سعيد بن نصير البغدادي بالرقة عن بن عيينة ووكيع وعنه أبو داود والحسن بن فيل صنف في الرقائق وهو صدوق د(@)(@@)(@@)(@@) | 1967- (@)(@@) سعيد بن النضر البغدادي بآمل عن هشيم وإسماعيل بن عياش وعنه البخاري وغيره توفي 234 خ(@)(@@)(@@)(@@) | 1968- (@)(@@) سعيد بن هانئ الخولاني عن العرباض ومعاوية وعنه علي بن زبيد ومعاوية بن صالح ثقة(@)(@@) توفي 127 س ق(@)(@@)(@@)(@@) | 1969- (@)(@@) سعيد بن أبي هند مولى سمرة عن أبي موسى وابن عباس وعنه ابنه عبد الله ونافع بن عمر الجمحي ثقة مشهور ع(@)(@@)(@@)(@@) | 1970- (@)(@@) سعيد بن أبي هلال الليثي مولاهم أبو العلاء المدني بمصر عن نافع ونعيم المجمر وعنه(@)(@@) PageV00P000(@)(@@) شيخه سعيد المقبري والليث توفي 135 ع(@)(@@)(@@)(@@) | 1971- (@)(@@) سعيد بن وهب الخيواني أحد أشراف همدان سمع من معاذ باليمن ومن علي وابن مسعود وعنه ابنه عبد الرحمن وأبو إسحاق ثقة م س(@)(@@)(@@)(@@) | 1972- (@)(@@) سعيد بن يحمد أبو السفر الهمداني عن بن عباس والبراء وعنه شعبة ومالك بن مغول توفي 112 ع(@)(@@)(@@)(@@) | 1973- (@)(@@) سعيد بن يحيى بن الازهر الواسطي عن بن عيينة وأبي معاوية وعنه مسلم وابن ماجة وابن مجاشع السختياني ثقة توفي 243 م ق(@)(@@)(@@)(@@) | 1974- (@)(@@) سعيد بن يحيى بن سعيد بن أبان الاموي عن أبيه وابن المبارك وعنه من عدا بن ماجة وابن صاعد والمحاملي ثقة توفي 249 خ م د ت س(@)(@@)(@@)(@@) | 1975- (@)(@@) سعيد بن يحيى بن صالح اللخمي سعدان عن زكريا بن أبي زائدة وهشام بن عروة وعنه هشام بن عمار وعلي بن حجر صدوق وقال الدارقطني ليس بذاك خ س ق(@)(@@)(@@)(@@) | 1976- (@)(@@) سعيد بن يحيى أبو سفيان الحميري الواسطي عن حصين وعوف وعنه بن راهويه والذهلي صدوق قال الدارقطني ليس بالقوي وقال أبو داود ثقة توفي 202 خ ت(@)(@@)(@@)(@@) | 1977- (@)(@@) سعيد بن يربوع المخزومي الصرم من الطلقاء عن النبي صلى الله عليه وسلم وعنه ابنه عبد الرحمن يقال عاش مائة وعشرين سنة توفي 54 د(@)(@@)(@@)(@@) | 1978- (@)(@@) سعيد بن يزيد أبو مسلمة الازدي عن أنس ومطرف بن 
ms337	 الشخير وعنه يزيد بن زريع وابن علية ثقة ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1979- (@)(@@) سعيد بن يزيد الاحمسي عن الشعبي وعنه وكيع وأبو نعيم شيخ س(@)(@@)(@@)(@@) | 1980- (@)(@@) سعيد بن يزيد عن بن المسيب وعنه قتادة شيخ س(@)(@@)(@@)(@@) | 1981- (@)(@@) سعيد بن يزيد أبو شجاع القتباني الاسكندراني عن الاعرج ويزيد بن أبي حبيب وعنه الليث وابن المبارك ثقة من العابدين الاولياء توفي 154 م د ت س(@)(@@)(@@)(@@) | 1982- (@)(@@) سعيد بن يسار أبو الحباب من علماء المدينة عن عائشة وأبي هريرة وعنه ربيعة ويحيى بن سعيد توفي 117 ع(@)(@@)(@@)(@@) | 1983- (@)(@@) سعيد بن يعقوب الطالقاني عن حماد بن زيد وأيوب بن جابر وعنه أبو داود والترمذي والنسائي والسراج ثقة توفي 244 د ت س(@)(@@) *- سعيد الادم هو بن زكريا 1885(@)(@@) *- سعيد الاعشى هو بن عبد الرحمن 1923(@)(@@) *- سعيد الشامي بن زرعة 1884(@)(@@) *- سعيد التبان أبو عثمان في الكنى 6735(@)(@@)(@@)(@@) | 1984- (@)(@@) سعيد الانصاري عن حصين بن وحوح وعنه بن عروة أو عزرة مجهول د(@)(@@)(@@)(@@) | 1985- (@)(@@) سعيد عن مولاه بن نمران وعنه سعيد بن عبد العزيز يجهل د(@)(@@)(@@)(@@) | 1986- (@)(@@) سعير بن الخمس التميمي الكوفي عن حبيب بن أبي ثابت وزيد بن أسلم وعنه أحوص بن جواب ويحيى بن يحيى وثقه بن معين وقال أبو حاتم لا يحتج به م ت س(@)(@@)(@@)(@@) | 1987- (@)(@@) السفر بن نسير حمصي عن ضمرة بن حبيب ويزيد بن شريح وعنه معاوية بن صالح وجماعة قال الدارقطني لا يعتبر به ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1988- (@)(@@) سفيان بن أسيد الحضرمي له صحبة عنه جبير بن نفير د(@)(@@)(@@)(@@) | 1989- (@)(@@) سفيان بن حبيب البصري البزاز عن سليمان التيمي وعاصم الاحول وعنه الحسن بن قزعة(@)(@@) والجهضمي ثبت عالم بسعيد بن أبي عروبة توفي 4 186(@)(@@)(@@)(@@) | 1990- (@)(@@) سفيان بن حسين أبو محمد الواسطي وأبو الحسن عن الحسن وابن سيرين والزهري وعنه شعبة ويزيد بن هارون قال النسائي ليس به بأس إلا في الزهري وقال بن سعد ثقة يخطئ كثيرا م 4(@)(@@)(@@)(@@) | 1991- (@)(@@) سفيان بن حمزة الاسلمي المدني عن كثير بن زيد وعنه إبراهيم بن حمزة وإبراهيم بن المنذر وثق ق(@)(@@)(@@)(@@) | 1992- (@)(@@) سفيان بن دينار التمار الكوفي عن سعيد بن 
