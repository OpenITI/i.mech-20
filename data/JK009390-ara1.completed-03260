ms3241	 بالله أبدا ، فذهبت عنهما ثم رجعت بصبي تحمله ، فسألاها نفسها قالت : لا والله حتى تقتلا هاذا الصبي ، فقالا : والله لا نقتله أبدا ، فذهبت ثم رجعت بقدح خمر تحمله ، فسألاها نفسها فقالت : لا والله حتى تشربا هاذا الخمر ، فشربا فسكرا فوقعا عليها وقتلا الصبي ، فلما أفاقا قالت المرأة : والله ما تركتما شيئا ما PageV10P146 أبيتماه إلا فعلتماه حين سكرتما ، فخيرا بين عذاب الدنيا والآخرة ، فاختارا عذاب الدنيا ) )(@)(@@) . ( حم ، بز ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 878 / 29903 قال النبي :(@)(@@) | 30 ( إن أبا سفيان خير أهلي أو من خير أهلي ) )(@)(@@) . ( طكس ، عن أبي حية البدري رضي الله عنه قال : كان النبي(@)(@@) | 40 ( يوم خيبر لا ينظر في ناحية إلا رأى أبا سفيان بن الحارث يقاتل فذكره ) 40(@)(@@) يوم خيبر لا ينظر في ناحية إلا رأى أبا سفيان بن الحارث يقاتل فذكره ) .(@)(@@)(@@)(@@) $ 879 / 29904 قال النبي :(@)(@@) | 30 ( إن أبا موساى يقرأ علاى مزمار من مزامير آل داود ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 880 / 29905 قال النبي :(@)(@@) | 30 ( إن أباك محبوس بدينه فاقض عنه ، فقال : قضيته ما خلا امرأة ادعت دينارين وليس لها بينة ، قال : أعطها فإنها صادقة فأعطيتها ) )(@)(@@) . ( ع ، عن سعد بن الأطول رضي الله عنه أن أباه مات وترك ثلاثمائة درهم وعيالا ودينا فذكره ) .(@)(@@)(@@)(@@) $ 881 / 29906 قال النبي :(@)(@@) | 30 ( إن أباكم لم يتق الله فيجعل له من أمره مخرجا ، بانت منه بثلاث علاى غير السنة وتسع مائة وسبع وتسعون إثم في عنقه ) )(@)(@@) . ( طك ، عن إبراهيم بن عبادة بن الصامت عن أبيه عن جده قال : طلق رجل امرأته ألفا فانطلق بنوه إلاى رسول الله فسألوه هل له من مخرج فذكره ) .(@)(@@)(@@)(@@) $ 882 / 29907 قال النبي :(@)(@@) | 30 ( إن أبغض الخلق إلاى الله لمن آمن ثم كفر ) )(@)(@@) . ( طك ، عن معاذ بن جبل رضي الله عنه ) .(@)(@@)(@@)(@@) $ 883 / 29908 قال النبي :(@)(@@) | 30 ( إن إبليس قال لربه : وعزتك وجلالك لا أبرح أغوي بني آدم ما دامت الأرواح فيهم فقال له ربه : فبعزتي وجلالي لا أبرح أغفر لهم ما استغفروني 
ms3242	 ) )(@)(@@) . ( حم ، طس ، عن أبي سعيد رضي الله عنه ) .(@)(@@) PageV10P147(@)(@@)(@@)(@@) $ 884 / 29909 قال النبي :(@)(@@) | 30 ( إن ابن أم مكتوم ينادي فكلوا واشربوا حتى ينادي بلال ) )(@)(@@) . ( حم ، عن حبيب بن عبد الرحمان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 885 / 29910 قال النبي :(@)(@@) | 30 ( إن ابنك أول من ضحك الله له واهتز له العرش قاله لأم سعد بن معاذ لما مات سعد رضي الله عنه ) )(@)(@@) . ( عن أسماء بنت يزيد رضي الله عنها ) .(@)(@@)(@@)(@@) $ 886 / 29911 قال النبي :(@)(@@) | 30 ( إن أبواب السماء تفتح في أول ليلة من شهر رمضان فلا تغلق إلاى آخر ليلة منه ) )(@)(@@) . ( طص ، عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 887 / 29912 قال النبي :(@)(@@) | 30 ( إن أبي وأباك وأنتفي النار ) )(@)(@@) . ( طك ، عن عمران بن حصين رضي الله عنه أن أباه أتاى النبي فقال : أرأيت رجلا كان يقري الضيف ويصل الرحم مات قبلك وهو أبوك فذكره ) .(@)(@@)(@@)(@@) $ 888 / 29913 قال النبي :(@)(@@) | 30 ( إن أحب الأعمال إلاى الله بعد الفرائض إدخال السرور علاى المسلم ) )(@)(@@) . ( طك ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 889 / 29914 قال النبي :(@)(@@) | 30 ( إن أحبكم إلي أحاسنكم أخلاقا الموطأون أكنافا الذين يألفون ، وإن أبغضكم إلي المشاؤون بالنميمة ، المفرقون بين الأحبة ، الملتمسون البراء العنت ) )(@)(@@) . ( طسص ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 890 / 29915 قال النبي :(@)(@@) | 30 ( إن أحبكم إلي يوم القيامة أحاسنكم أخلاقا ، وإن أبغضكم إلي يوم القيامة المتشدقون المتفيهقون ) )(@)(@@) . ( حم ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 891 / 29916 قال النبي :(@)(@@) | 30 ( إن أحب أسمائك أبو تراب ، أنت أبو PageV10P148 تراب ) )(@)(@@) . ( طكس ، عن أبي الطفيل رضي الله عنه قال : جاء النبي وعلي نائم علاى التراب فذكره ) .(@)(@@)(@@)(@@) $ 892 / 29917 قال النبي :(@)(@@) | 30 ( إن أخاكم النجاشي قد مات ، فمن أراد أن يصلي عليه فليصل ، وتوجه نحو الحبشة فكبر عليه أربعا ) )(@)(@@) . ( طك ، عن حذيفة بن أسيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 893 / 29918 قال النبي :(@)(@@) | 30 ( إن أخاكم النجاشي مات ، قوموا فصلوا عليه ، فقالوا : كيف نصلي عليه وقد مات في كفره ؟ فقال : ألا تسمعون إلاى قول الله : { وإن من أهل الكتاب لمن يؤمن بالله 
ms3243	 } الآية ) )(@)(@@) . ( طك ، عن وحشي بن حرب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 894 / 29919 قال النبي :(@)(@@) | 30 ( إن أدناى أهل الجنة منزلة لينظر في ملكه ألفي سنة يراى أقصاه كما كما يراى أدناه ، ينظر أزواجه وخدمه وسرره ، وإن أفضلهم منزلة لمن ينظر في وجه الله تعالاى كل يوم مرتين ) )(@)(@@) . ( حم ، ع ، طك ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 895 / 29920 قال النبي :(@)(@@) | 30 ( إن أرضكم رفعت إلي منذ قعدتم فنظرت إليها من أدناها إلاى أقصاها ، فخير ثمراتكم البرني يذهب الداء ولا داء فيه ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه أن وفد عبد القيس قدموا علاى النبي فأقبل عليهم وقال : لكم ثمرة تدعونها كذا وكذا وثمرة كذا وعد ثمار ألوانهم ، فقال له رجل : لو كنت ولدت في جوف هجر ما كنت أعلم منك الساعة ، أشهد أنك رسول الله فذكره ) .(@)(@@)(@@)(@@) $ 896 / 29921 قال النبي :(@)(@@) | 30 ( إن أزواج أهل الجنة ليغنين أزواجهن بأحسن أصوات ما سمعها أحد قط ، إن مما يغنين به : نحن الخالدات فلا نمت ) )(@)(@@) . ( طسص ، عن ابن عمر رضي الله عنهما ) .(@)(@@) PageV10P149(@)(@@)(@@)(@@) $ 897 / 29922 قال النبي :(@)(@@) | 30 ( إن استلامهما أي الحجر الأسود والكن اليماني يحط الخطايا ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 898 / 29923 قال النبي :(@)(@@) | 30 ( إن أسفل أهل الجنة أجمعين درجة لمن يقوم علاى رأسه عشرة الاف غلام ، بيد كل واحد صفحتان ، واحدة من ذهب وأخراى من فضة ، في كل واحدة لون ليس في الأخراى مثله يأكل من آخرها مثل ما يأكل من أولها ، يجد لآخرها من الطيب واللذة مثل الذي يجد لأولها ثم يكون ذالك ريح المسك الأذفر ، لا يبولون ولا يتغوون ولا يتمخطون إخوانا علاى سرر متقابلين ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 899 / 29924 قال النبي :(@)(@@) | 30 ( إن أشد الناس علاى الله عذابا القاتل غير قاتله ، والضرب غير ضاربه ، ومن جحد نعمة مواليه فقد برىء مما أنزل الله علاى محمد ) )(@)(@@) . ( ع ، عن جعفر بن محمد عن أبيه عن جده ) .(@)(@@)(@@)(@@) $ 900 / 29925 قال النبي :(@)(@@) | 30 ( إن أشكر الناس لله تعالاى 
ms3244	 أشكرهم للناس ) )(@)(@@) . ( حم ، طك ، عن الأشعث بن قيس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 901 / 29926 قال النبي :(@)(@@) | 30 ( إن أصدق الحديث حديث خرافة ، كان خرافة من بني عذرة سبته الجن وكان معهم فإذا استرقوا السمع أخبروه فيخبر به الناس فيحدثون به كما قال ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 902 / 29927 قال النبي :(@)(@@) | 30 ( إن أطهر طعامكم ما مسته النار ) )(@)(@@) . ( طك ، عن الحسن بن مرة دخل علاى النبي في بيت فاطمة رضي الله عنها فناولته كتفا مطبوخا ثم قام يصلي فأخذت ثيابه فقالت ألا تتوضأ ؟ قال : لم ؟ قالت : أكلت ما مسته النار فذكره ) .(@)(@@) PageV10P150(@)(@@)(@@)(@@) $ 903 / 29928 قال النبي :(@)(@@) | 30 ( إن أعجل الطاعة ثوابا صلة الرحم ، حتى إن أهل البيت ليكونون فجارا فتنمو أموالهم ويكثر عددهم إذا وصلوا أرحامهم ، وإن أعجل المعصية عقوبة البغي والخيانة ، واليمين الغموس يذهب المال ويثقل في الرحم ويذر الديار بلاقع ) )(@)(@@) . ( طس ، عن أبي سلمة عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 904 / 29929 قال النبي :(@)(@@) | 30 ( إن أعداى الناس علاى الله من قتل في الحرم أو قتل غير قاتله بدخول الجاهلية ) )(@)(@@) . ( حم ، عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 905 / 29930 قال النبي :(@)(@@) | 30 ( إن أعلم الناس أبصرهم بالحق إذا اختلف الناس وإن كان يقصر في العمل وإن كان يزحف علاى إسته زحفا ، واختلف من كان قبلي علاى ثنتين وسعبعين فرقة نجا منهم ثلاثة وهلك سائرهن ، فرقة آذت الملوك وقاتلوهم علاى دينهم وعدين عيساى فساحوا في الحبلاد وترهبوا فهم الذين قال الله فيهم رهبانية ابتدعوها . . . ، الآية ) )(@)(@@) . ( طك ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 906 / 29931 قال النبي :(@)(@@) | 30 ( إن أفضل الإيمان أن تعلم أن الله معك حيث ما كنت ) )(@)(@@) . ( طكس ، عن عبادة بن الصامت رضي الله عنه ) .(@)(@@)(@@)(@@) $ 907 / 29932 قال النبي :(@)(@@) | 30 ( إن أفضل الصدقة علاى ذي الرحم الكاشح ) )(@)(@@) . ( حم ، طك ، عن أبي أيوب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 908 / 29933 قال النبي :(@)(@@) | 30 ( إن أفضل الناس منزلة عند الله يوم القيامة إمام عدل رفيق ، وشر عباد الله عند الله منزلة يوم القيامة 
ms3245	 إمام جائر خرق ) )(@)(@@) . ( طس ، عن عمر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 909 / 29934 قال النبي :(@)(@@) | 30 ( إن أكمل الناس إيمانا أحسنهم خلقا ، وإن حسن الخلق ليبلغ درجة الصوم والصلاة ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) .(@)(@@) PageV10P151(@)(@@)(@@)(@@) $ 910 / 29935 قال النبي :(@)(@@) | 30 ( إن امرأة عذبت في هرة ربطتها فلم تطعمها ولم تسقه ) )(@)(@@) . ( حم ، عن أبي هريرة رضي الله عنه ولما حدث به قالت عائشة رضي الله عنها أنت الذي تحدثت بكذا ؟ قال : سمعته من رسول الله قالت : هل تدري ما كانت المرأة ؟ إن المرأة مع ما فعلت كانت كافرة ، وإن المؤمن أكرم علاى الله من أن يعذبه في هاذه ، فإذا حدثت عن رسول الله فانظر كيف تحدث ) .(@)(@@)(@@)(@@) $ 911 / 29936 قال النبي :(@)(@@) | 30 ( إن أمة من بني إسرائيل فقدت وإني أخاف أن تكون هي فاكفئوها فأكفأناها وإنا لجياع ) )(@)(@@) . ( حم ، ع ، بز ، طك ، عن عبد الرحمان بن حسنة رضي الله عنه قال : كنا عند النبي في سفر ، فنزلنا أرضا كثيرة الضباب ، قال : فأصبنا منها وذبحنا ، قال : فبينا القدر تغلي بها إذ خرج رسول الله قال فذكره ) .(@)(@@)(@@)(@@) $ 912 / 29937 قال النبي :(@)(@@) | 30 ( إن أناسا من أهل الجنة يطلعون إلاى أناس من أهل النار فيقولون : بم دخلتم النار ؟ فوالله ما دخلنا الجنة إلا بما تعلمنا منكم ، فيقولون لنا : نقول ولا نفعل ) )(@)(@@) . ( طك ، عن الوليد بن عقبة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 913 / 29938 قال النبي :(@)(@@) | 30 ( إن أهل البيت ليقل طمعهم فتستنير بيوتهم ) )(@)(@@) . ( طس ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 914 / 29939 قال النبي :(@)(@@) | 30 ( إن أهل الدرجات العلاى يراهم من هو أسفل منهم كما يراى الكوكب في أفق السماء ، وأبو بكر وعمر منهم ) )(@)(@@) . ( طك ) ، عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 915 / 29940 قال النبي :(@)(@@) | 30 ( إن أهل الشرك يعفون شواربهم ، ويحفون لحاهم ، فاعفوا اللحاى وأحفوا الشوارب ) )(@)(@@) . ( بز ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 916 / 29941 قال النبي :(@)(@@) | 30 ( إن أهل النار يدعون مالكا فلا يجيبهم أربعين PageV10P152 عاما ، ثم يقول : إنكم ماكثون ، ثم يدعون ربهم فيقولون : ربنا أخرجنا منها فإن عدنا 
ms3246	 فإنا ظالمون فلا يجيبهم مثل الدنيا ، ثم يقول : اخسؤوا فيها ولا تكلمون ، ثم ييأس القوم فما هو إلا الزفير والشهيق تشبه أصواتهم أصوات الحمر أولها شهيق وآخرها زفير ) )(@)(@@) . ( طك ) ، عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 917 / 29942 قال النبي :(@)(@@) | 30 ( إن أوسط عراى الايمان أن تحب في الله وتبغض في الله ) )(@)(@@) . ( حم ، طك ، ) عن البراء بن عازب رضي الله عنه قال : قلت يا رسول الله أي عراى الاسلام أوسط ؟ قالوا : الصلاة ، قال : حسنة وما هي بها ، قالوا : الزكاة ، قال : حسنة ، قالوا : وما هي بها ؟ قالوا : صيام رمضان ، قال : حسن وما هو به ، قالوا : الحج ، قال : حسن وما هو به ؟ قالوا : الجهاد ، قال : حسن وما هو به ، إن أوسط عراى الايمان الخ . . . .(@)(@@)(@@)(@@) $ 918 / 29943 قال النبي :(@)(@@) | 30 ( إن أول أربعة يدخلون الجنة : أنا وأنت يا علي والحسن والحسين وذرارينا خلف ظهورنا ، وأزواجنا خلف ذرارينا ، وشيعتنا عن أيماننا وعن شمائلنا ) )(@)(@@) . ( طك ) ، عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ 919 / 29944 قال النبي :(@)(@@) | 30 ( إن أول أشراط الساعة نار تخرج من المشرق وتحشرهم إلاى المغرب ) )(@)(@@) . ( طس ) ، عن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ 920 / 29945 قال النبي :(@)(@@) | 30 ( إن أول ثلاثة تدخل الجنة : الفقراء المهاجرون الذين شعابهم المكاره ، وإذا أمروا سمعوا وأطاعوا ، وإذا كانت لرجل منهم حاجة إلاى سلطان لم تقض حتى يموت وهي في صدره ، وإن الله عز وجل يدعو يوم القيامة الجنة فتأتي بزخرفها وزينتها فيقول : إن عبادي الذين قاتلوا في سبيلي وقتلوا وأوذوا في سبيلي وجاهدوا ادخلوا الجنة فيدخلون بغير عذ 2 اب ولا حساب ، فتأتي الملائكة فيسجدون ويقولون : : أي ربنا ، نحن نسبحك الليل والنهار ونقدس لك من هاؤلاء الذين أشهرتهم علينا ، فيقول الله : ذالكم عبادي الذين قاتلوا في سبيلي ، فتدخل PageV10P153 الملائكة عليهم من كل باب سلام عليكم بما صبرتم فنعم عقبى الدار ) )(@)(@@) . ( طك ) ، عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 921 / 29946 قال النبي :(@)(@@) | 30 ( إن أول خصم يقضاى عليه يوم القيامة عنزان ذات قرن وغير ذات قرن ) )(@)(@@) . ( طس ) ، عن 
ms3247	 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 922 / 29947 قال النبي :(@)(@@) | 30 ( إن أول شيء نهاني عنه ربي بعد عبادة الاوثان : شرب الخمر ، وملاحاة الرجل ) )(@)(@@) . ( بز ، طك ) ، عن أبي الدرداء ومعاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 923 / 29948 قال النبي :(@)(@@) | 30 ( إن أول شيء خلقه الله القلم وأمره أن يكتب كل شيء ) )(@)(@@) . ( ع ) ، عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 924 / 29949 قال النبي :(@)(@@) | 30 ( إن أول عظم من الإنسان يتكلم يوم يختم علاى أفواه فخذه من الشمال ) )(@)(@@) . ( حم ، طك ) ، عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 925 / 29950 قال النبي :(@)(@@) | 30 ( إن أول ما افترض الله علاى الناس من دينهم الصلاة ، وآخر ما يبقاى الصلاة ، وأول ما يحاسب به الصلاة ، يقول الله : انظروا في صلاة عبدي فإن كانت تامة كتبت تامة ، وإن كانت ناقصة قال : انظروا هل من تطوع ؟ فإن وجد له تطوع تممت الفريضة من التطوع ، ثم يقول : انظروا هل زكاته تامة ؟ فإن وجدت تامة كتبت تامة ، وإن كانت ناقصة قال : انظروا هل له صدقة ؟ فإن كانت له صدقة تممت له زكاته من الصدقة ) )(@)(@@) . ( ع ) ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 926 / 29951 قال النبي :(@)(@@) | 30 ( إن أول ما خلق الله تعالاى : القلم والحوت ، فقال له : اكتب ، فقال : ما أكتب ؟ قال : كل شيء كان إلاى يوم القيامة ثم قرأ : PageV10P154 { ن والقلم } فالنون الحوت والقلم العلم ) )(@)(@@) . ( طب ) ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 927 / 29952 قال النبي :(@)(@@) | 30 ( إن أول من صنعت له النورة ودخل الحمامات سليمان بن داود ، فلما دخله وجد حره وعمه فقال : أواه من عذاب الله أوه قبل أن لا تنفع أوه أوه أوه ) )(@)(@@) . طكس ، عن أبي موساى رضي الله عنه .(@)(@@)(@@)(@@) $ 928 / 29953 قال النبي :(@)(@@) | 30 ( إن أول هاذه الامة خيارهم ، وآخرها شرارهم مختلفين متفرقين ، فمن كان يؤمن بالله واليوم الآخر فلتأته منيته وهو يأتي إلاى الناس ما يحب أن يؤتاى إليه ) )(@)(@@) . ( طك ) ، عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 929 / 29954 قال النبي :(@)(@@) | 30 ( إن أيام التشريق أيام أكل وشرب ) )(@)(@@) . ( طك ) ، عن 
ms3248	 عمر بن عبد الله العدوي رضي الله عنه .(@)(@@)(@@)(@@) $ 930 / 29955 قال النبي :(@)(@@) | 30 ( إن بني إسرائيل لو أخذوا أدناى بقرة لاجزأتهم أو لأجزأت عنهم ) )(@)(@@) . ( بز ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 931 / 29956 قال النبي :(@)(@@) | 30 ( إن بلالا ينادي بليل فكلوا واشربوا حتى تسمعوا أذان ابن أم مكتوم ، وكان ابن أم مكتوم لا يؤذن حتى يقال : أصبحت ) )(@)(@@) . ( طس ) ، عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 932 / 29957 قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة ثلاث سنوات ، تمسك السماء أول سنة ثلث قطرها والارض ثلث نباتها ، والسنة الثانية تمسك السماء ثلثي قطرها والارض ثلثي نباتها ، والسنة الثالثة تمسك السماء قطرها والأرض نباتها حتى لا يبقاى ذو خف ولا حافر إلا هلك ، وإن من أشد فتنته أن يأتي الاعرابي فيقول أرأيت إن أحييت لك إبلك تعلم أني ربك ؟ قال : بلاى ، فتمثل له الشيطان نحو إبله كأحسن ما يكون ضروعا وأعظم أسنمة ، ويأتي الرجل قد مات أخوه وأبوه فيقول : أرأيت إن PageV10P155 أحييت لك أباك وأخاك ألست تعلم أني ربك ؟ قال : بلاى ، فيتمثل له الشيطان نحو أبيه ونحو أخيه قيل : لقد خلعت أفئدتنا بذكر الله ذالك ، فقال : إن يخرج يعني الدجال وأنا فيكم فأنا حجيجه ، وإلا فإن الله عز وجل خليفتي علاى كل مؤمن ، قيل : فما يجزىء المؤمن يومئذ ؟ قال : ما يجزىء الملائكة التسبيح والتحميد والتهليل ) )(@)(@@) . ( حم ، طك ) ، عن أسماء بنت يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ 933 / 29958 قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة سنين خداعة ، يصدق فيها الكاذب ، ويكذب فيها الصادق ، ويؤتمن فيها الخائن ، ويخون فيها الأمين ، وينطق فيها الرويبضة ، قيل : وما الرويبضة ؟ قال : السفيه ينطق في أمر العامة ) )(@)(@@) . ( بز ) ، عن عمرو بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 934 / 29959 قال النبي :(@)(@@) | 30 ( إن بين أيديكم عقبة كؤودا لا ينجو منها إلا كل محق ) )(@)(@@) . ( بز ) ، عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 935 / 29960 قال النبي :(@)(@@) | 30 ( إن ثلاثة نفر فيما سلف من الناس انطلقوا يمتارون لاهليهم فأخذتهم السماء فدخلوا غارا فدخل عليهم حجر متجافي 
ms3249	 حتى لا يرون ضياء فيه وقال بعضهم لبعض : قد وقع الحجر وعفاى الأثر ولا يعلم بمكانكم إلا الله ، فادعوا الله تعالاى بأوثق أعمالكم ، فقال أحدهم اللهم إنك تعلم أنه كان لي أبوان شيخان كبيران فحلبت لهما في إنائهما فإذا وجدتهما راقدين قمت علاى رأسيهما كراهية أن أؤذيهما في رؤوسهما حتى يستيقظا متى يستيقظان ، اللهم إنك تعلم أني إنما فعلت ذالك رجاء رحمتك ومخافة عذابك ففرج عنا ، فزال ثلث الحجر ، وقال الآخر : اللهم إنك تعلم أني استأجرت أجيرا علاى عمل يعمله فأتاني يطلب أجره ذالك فجمعته وثمرته حتى كان منه جل الملك ، فعرضت عليه ذالك كله ولو شئت لم أعطه إلا أجره ، اللهم إنك تعلم أني إنما فعلت ذالك رجاء رحمتك ومخافة عذابك ففرج عنا فزال ثلث الحجر ، فقال الثالث : اللهم إن كنت تعلم أني أعجبتني امرأة فجعل لها جعلا ، فلما قدر عليها فر منها وسلمها جعلها ، اللهم إن كنت فعلت ذالك رجاء رحمتك ومخافة PageV10P156 عذابك ففرج عنا فزال الحجر فخرجوا معانيق يمشون ) )(@)(@@) . ( حم ، ع ، بز ) ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 936 / 29961 قال النبي :(@)(@@) | 30 ( إن ثلاثة نفر كانوا في كهف فوقع الجبل علاى باب الكهف فأرصد عليهم ، فقال بعضهم لبعض : تذكرون أيكم عمل حسنة لعل الله برحمته يرحمنا ، فقال رجل منهم : قد عملت حسنة ، مرة كان لي أجراء يعملون فجاءني عمال لي استأجرت كل رجل منهم بأجر معلوم فجاءني رجل ذات يوم نصف النهار فاستأجرته بشطر أصحابه فعمل في بقية نهاره كما عمل رجل منهم في نهاره كله ، فرأيت أن لا أنقصه مما استأجرت به أصحابه لما جهد في عمله ، فقال رجل منهم : تعطي هاذا مثل ما أعطيتني ، فقلت : يا عبد الله لم أبخسك شيئا من شيئك وإنما هو مالي ، فغضب وذهب وترك أجره فوضعته في جانب بيت ما شاء الله ، ثم قرب بي بقر فاشتريت به فصيلة فبلغت ما شاء الله ، فمر بي بعد حين وقد صرت شيخا ضعيفا لا أعرفه فقال : إن لي عندك حقا ، قلت : ذكرنيه 
ms3250	 ، فذكرنيه فعرفته ، فقلت : إياك أبلغ هاذا حقك ، فعرضتها عليه جميعا فقال : لا تسخر بي إن تصدق علي فأعطني حقي ، قال : والله ما أسخر عليك إنها لحقك ما لي منها شيء ، فدفعتها إليه جميعا ، اللهم إن كنت فعلت ذالك لوجهك فافرج عن ، فانصدع الجبل حتى رأوا مكة وأبصروا ، وقال الآخر : قد عملت حسنة مرة ، كان لي فضل فأصاب الناس شدة فجاءتني امرأة تطلب معروفا ، فقلت : والله ما هو دون نفسك ، فأبت علي وذهبت ثم رجعت فذكرتني بالله ، فأتيت عليها ، فقلت لا والله هو دون نفسك فأبت علي ، وذهبت فذكرت ذالك لزوجها فقال لها : أعطه نفسك وأعيني عيالك ، فرجعت إلي فأنشدتني بالله فأبيت وقلت : لا والله ما هو دون نفسك ، فلما رأت ذالك سلمت إلي نفسها ، فلما تكشافتها وهممت بها ارتعدت من تحتي ، فقلت لها : ما شأنك ؟ قالت : أخاف رب العالمين ، فقلت لها : خفته في الشدة ولم أخفه في الرخاء فتركتها PageV10P157 وأعطيتها الحق علاى ما تكشفتها ، اللهم إن كنت تعلم أن ذالك ( سقط : لوجهك فأخرج عنا فانصدع الجبل حتى عرفوا وتبين وقال ) الآخر : قد عملت حسنة ، مرة كان لي أبوان شيخان كبيران وكانت لي غنم فكنت أطعم أبوي وأسقيهما ثم أرجع إلاى غنمي ، فحبسني حابس فلم أبرح حتى أمسيت ، فأتيت أهلي وأخذت محلبي فحلبت وغنمي قائمة ومضيت إلاى أبوي فوجدتهما قد ناما فشق علي أن أوقظهما ، وشق علي أن أترك غنمي ، فما برحت ومحلبي علاى يدي حتى أيقظهما الصبح فسقيتهما ، اللهم إن كنت فعلت ذالك لوجهك فافرج عنا ، فقال الجبل : طاق ، ففرج عنهم فخرجوا ) )(@)(@@) . ( حم ، طكس ، بز ) ، عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ 937 / 29962 قال النبي :(@)(@@) | 30 ( إن ثلاثة نفر ذهبوا رادة لاهليهم ، فأخذهم مطر فلجؤوا إلاى غار فوقع عليهم من فم الغار حجر سد عليهم فم الغار ، ووقع المتجافي عنهم ، فقال بعضهم لبعض : عفاى الأثر ووقع الحجر ، ولا يعلم بمكانكم إلا الله ، فتعالوا فليدع كل رجل منكم بأوثق عمل عمله لله عسى أن يخرجكم من مكانكم ، قال أحدهم : اللهم 
ms3251	 إن كنت تعلم برا بوالدي وأني أرحت غنمي ليلة وكنت أحلب لابوي فأتيتهما ليلة من الليالي وجئت بشرابهما فوجدتهما قد ناما وأني جعلت أرغب لهما في نومهما وأكره أن أرجع بالشراب فيستيقظان فلا يجداني عندهما ، فقمت مقامي قائما علاى رءوسهما كذالك حتى أصبحت ، اللهم إن كنت تعلم أني فعلت ذالك ابتغاء وجهك فافرج عنا ، فزال ثلث الحجر ، قالوا للآخر : أيها أي قل قال : اللهم إن كنت تعلم أني أحببت ابنة عم لي حبا شديدا وخطبتها إلاى أهلها فمنعنيها حتى جعلت لها ما رضيت به بيني وبينها ، ثم دعوت بها وخلوت بها وقعدت منها مقعد الرجل من المرأة ، فقالت : لا يحل لك أن تثقب الخاتم إلا بحقه ، فانقبضت إلي نفسي ووفرت حقها عليها ونفسها ، اللهم إن كنت تعلم أني فعلت ذالك ابتغاء وجهك فافرج عنا فزال ثلثه انفراجا ، وقالوا للثالث : أيها ، فقال : اللهم إن كنت تعلم أني عمل لي عامل علاى صاع من طعام فانطلق ولم يأخذ صاعه فاحتبس علي طويلا من الدهر وإني عمدت إلاى صاعه أجريه PageV10P158 حتى اجتمع منه بقر كثير وشاء كثير ومال كثير ، وإن ذالك العامل أتاني بعد زمان يطلب الصاع وإني قلت له : إن صاعك ذالك من الطعام قد صار مالا كثيرا وشاء كثيرا ، وبقرا كثيرا فخذه كله فإنه من ذالك الصاع ، فقال : أتسخر بي ؟ قلت : لا والله ولاكنه الحق ، فانطلق به يسوق المال أجمع ، اللهم فإن كنت تعلم أني فعلت ذالك ابتغاء وجهك فافرج عنا فانفلق الحجر فوقع وخرجوا يتماشون ) )(@)(@@) . ( بز ، طس ) ، بأسانيد عن أبي هريرة رضي الله عنه )(@)(@@)(@@)(@@) $ 938 / 29963 قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فقال : من صلى عليك من أمتك واحدة صلى الله عليه بها عشرا ، ورفعه بها عشر درجات ) )(@)(@@) . ( طسص ) ، عن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 939 / 29964 قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن الحمى حظ أمتي من جهنم ) )(@)(@@) . ( طسص ) ، عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 940 / 29965 قال النبي :(@)(@@) | 30 ( إن جبريل أمرني أن أقرئك هاذه السورة يعني { لم يكن الذين 
ms3252	 كفروا } قاله لأبي ) )(@)(@@) . ( حم ، طك ) ، عن أبي حبة البدري رضي الله عنه .(@)(@@)(@@)(@@) $ 941 / 29966 قال النبي :(@)(@@) | 30 ( إن جبريل بشرني أنه من صلى علي صلى الله عليه ، ومن سلم علي سلم الله عليه ) )(@)(@@) . ( ع ) ، عن ابن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 942 / 29967 قال النبي :(@)(@@) | 30 ( إن جبريل جاءني فصلى بي الصلوات وقتين وقتين إلا المغرب ، جاءني صلى بي الظهر حين كن الفيء مثل شراك نعل ، ثم جاء فصلى بي العصر حين كان الفيء مثلين ، ثم جاءني في المغرب فصلى بي حين غابت الشمس ، ثم جاءني فصلى بي العشاء ساعة بزق الفجر ، ثم جاءني من الغد فصلى الظهر حين كان الفيء مثلين ، ( سقط : ثم جاءني في العصر فصلى بي حين كان الفيء مثلين ، ) ثم PageV10P159 جاءني في المغرب فصلى حين غابت الشمس لم يغيره عن وقته الأول ، ثم جاءني في العشاء فصلى بي حين ذهب ثلث الليل ، ثم أسفر في الفجر حين لا أراى في السماء نجما ، ثم قال : ما بين هاذين وقت ) )(@)(@@) . ( بز ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 943 / 29968 قال النبي :(@)(@@) | 30 ( إن جبريل كان يعارضني بالقرآن في كل عام مرة ، وأنه عارضني بالقرآن العام مرتين وأخبرني أنه لم يكن نبي إلا عاش نصف عمر الذي كان قبله ، وأخبرني أن عيساى بن مريم عاش عشرين ومائة سنة ولا أراني إلا ذاهب علاى الستين فأبكاني ذالك ) )(@)(@@) . ( طك ) ، عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 944 / 29969 قال النبي :(@)(@@) | 30 ( إن جبريل وعدني أن يأتيني ولم يأتني منذ ثلاث ، فإذا كلب فأمر بقتله فأتاه جبريل ، فقال : ما لك لم تأتني وكنت إذا وعدتني لم تخلفني ؟ فقال : إنا لا ندخل بيتا فيه كلب ولا تصاوير ) )(@)(@@) . ( طك ) ، عن أسامة رضي الله عنه .(@)(@@)(@@)(@@) $ 945 / 29970 قال النبي :(@)(@@) | 30 ( إن جعفر بن أبي طالب مر مع جبريل وميكائيل ، له جناحان عوضه الله من بين يديه فسلم ثم أخبرني كيف كان أمره حين لقي المشركين فلذالك سمي جعفر الطيار ، وفي الجنة ) )(@)(@@) . ( طس ) ، عن ابن عباس رضي الله عنهما 
ms3253	 .(@)(@@)(@@)(@@) $ 946 / 29971 قال النبي :(@)(@@) | 30 ( إن جهنم قالت : يا رب ائذن لي في نفسين فإني أخشاى أن أقضي علاى خلقك ، فأذن لها بنفسين في كل سنة مرتين ، فشدة الحر من فيحها ، وشدة البرد من زمهريرها ) )(@)(@@) . ( بز ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 947 / 29972 قال النبي :(@)(@@) | 30 ( إن جهنم لما سيق إليها تلفهم فتلفحهم لفحة فلم تدع لحما علاى عظم إلا ألقته علاى العرقوب ) )(@)(@@) . ( طس ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 948 / 29973 قال النبي :(@)(@@) | 30 ( إن حسن الصوت يزين القرآن ) )(@)(@@) . ( بز ) ، عن ابن مسعود رضي الله عنه .(@)(@@) PageV10P160(@)(@@)(@@)(@@) $ 949 / 29974 قال النبي :(@)(@@) | 30 ( إن حوضي ما بين عدن إلاى عمان ، أكوابه عدد النجوم ، ماؤه أشد بياضا من الثلج وأحلاى من العسل ، أكثر الناس ورودا عليه فقراء المهاجرين ، قيل يا رسول الله صفهم لنا ، قال : شعث الرؤوس دنس الثياب ، الذين لا ينكحون المتنعمات ، ولا تفتح لهم السدد ، الذين يعطون ما عليهم ولا يأخذون ما لهم ) )(@)(@@) . ( طك ) ، عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ 950 / 29975 قال النبي :(@)(@@) | 30 ( إن حيضتك ليست في يدك ) )(@)(@@) . ( بز ) ، عن أنس رضي الله عنه قال النبي لعائشة : ناوليني الخمرة فقالت : إني حائض فذكره .(@)(@@)(@@)(@@) $ 951 / 29976 قال النبي :(@)(@@) | 30 ( إن داود النبي قال : إلاهي ما لعبادك عليك إذا هم زاروك في بيتك ؟ قال : لكل رجال المزور حق يا داود ، إن لهم علي أن أعافيهم من الدنيا وأغفر لهم إذا لقيتهم ) )(@)(@@) . ( طس ) ، عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 952 / 29977 قال النبي :(@)(@@) | 30 ( إن دماءكم وأعراضكم وأموالكم عليكم حرام كحرمة يومكم هاذا ، في شهركم هاذا ، في بلدكم هاذا ) )(@)(@@) . ( طك ) ، عن البراء بن عازب وزيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ 953 / 29978 قال النبي :(@)(@@) | 30 ( إن دون جسر جهنم طريقا أدحض ومنزلة وإنا نأتي عليه ونحن موافون ) )(@)(@@) . ( حم ) ، عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 954 / 29979 قال النبي :(@)(@@) | 30 ( إن دية المعاهد نصف دية المسلم ) )(@)(@@) . ( طس ) ، عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 955 / 29980 قال النبي :(@)(@@) | 30 ( إن ذا اللسانين في 
ms3254	 الدنيا له لسانان من نار يوم PageV10P161 القيامة ) )(@)(@@) . ( طك ) ، عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 956 / 29981 قال النبي :(@)(@@) | 30 ( إن رأس الدجال من ورائه حبك حبك وإنه سيقول : أنا ربكم ، فمن قال : أنت ربي افتتن ، ومن قال : كذبت ، ربي الله عليه توكلت وإليه أنيب فلا يضره ) )(@)(@@) . ( حم ، طك ) ، عن هشام بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 957 / 29982 قال النبي :(@)(@@) | 30 ( إن ربكم تبارك وتعالاى رحيم ، من هم بحسنة فلم يعملها كتبت له حسنة فإن عملها كتبت له عشرة أضعاف إلاى سبعمائة ضعف إلاى أضعاف كثيرة ، ومن هم بسيئة فلم يعملها كتبت له حسنة ، فإن عملها كتبت له سيئة واحدة أو محاها الله ، ولا يهلك علاى الله تعالاى إلا هالك ) )(@)(@@) . ( حم ، طك ) ، عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 958 / 29983 قال النبي :(@)(@@) | 30 ( إن ربكم يقول : إن عبدي فلانا يلتمس أن يرضيني فرضاي عليه ، فيقول جبريل : رحمة علاى فلان ، ويقول حملة العرش ويقول الذين يلونهم حتى يقول أهل السماوات السبع ، ثم يهبط إلاى الأرض ثم يقول وهي الآية التي أنزل الله عليكم في كتابه : { إن الذين آمنوا وعملوا الصالحات سيجعل لهم الرحمان ودا } وإن العبد ليلتمس بسخط الله ، فيقول الله : يا جبريل يستسخطني ، ألا وإن غضبي عليه ، فيقول جبريل : غضب الله علاى فلان ، ويقول حملة العرش ، فيقول جبريل يستسخطني ، ألا وإن غضبي عليه ، فيقول جبريل : غضب الله علاى فلان ، ويقول حملة العرش ، ويقول من دونهم ، حتى يقول أهل السماوات ثم يهبط إلاى الأرض ) )(@)(@@) . ( طس ) ، عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ 959 / 29984 قال النبي :(@)(@@) | 30 ( إن ربكم ليس عنده ليل ولا نهار ، نور السماوات والأرض من نور وجهه ، وإن مقدار يوم من أيامكم عنده ثنتا عشرة ساعة ، PageV10P162 وتعرض عليه أعمالكم بالأمس أول النهار فينظر فيها ثلاث ساعات فيطلع فيها علاى ما يكره فيغضبه ذالك ، فأول من يعلم غضبه حملة العرش والملائكة المقربون وسائر الملائكة ، ثم ينفخ جبريل بالقرن فلا يبقاى شيء إلا سمع صوته فيسبحون الرحمان ثلاث ساعات فذالك قوله تعالاى : { هو 
