ms61	 % 29(@)(@@) % تدافع عن ملك العراق وأهله % % مدافعة المغتار عن ربة الخدر % % 30(@)(@@) % يضرب ظبا بيض تأجج بالردى % % وطعن قنا سمر أحر من الجمر % % PageV01P189 31(@)(@@) % وأنتم أباة الضيم ما ذل جاركم % % ولا نظرتكم أعين الضيم عن شزر % % 32(@)(@@) % لكم والليالي حيث تمضي وتنقضي % % على كل حال كان في العسر واليسر % % 33(@)(@@) % بيوت على شط الفرات رفيعة % % يرى نارها تبدو لمن حل في مصر % % 34(@)(@@) % ولولا طروق الضيف من كل وجهة % % لما بنيت إلا على الأنجم الزهر % % 35(@)(@@) % وما ضل ساري الليل إلا اهتدى بها % % كنور سنا الإسلام في ظلمة الكفر % % 36(@)(@@) % إلى الغاية القصوى إلى الجود والندى % % إلى منزل رحب إلى نائل وفر % % 37(@)(@@) % فللضيف فيها مشهد الحج في منى % % وللنوق فيها للقرى مشهد النحر % % 38(@)(@@) % مكارم قد أورثتموها قديمة % وتلك مواريث لآبائك الغر % % 39(@)(@@) % سلكت بتلك الخيم ما سلكت به % % وما سلكت إلا بمسلكها الوعر % % 40(@)(@@) % تسل السيوف البيض كفك للورى % % فكفك للجدوى وسيفك للقهر % % PageV01P190 41(@)(@@) % وعلمتها ضرب الرقاب فأصبحت % % تقد رقاب الفاجرين ولا تدري % % 42(@)(@@) % ملأت فؤاد الضد رعبا ورهبة % % وأول ما ترمي أعاديك بالذعر % % 43(@)(@@) % فهابك من خل العراق وراءه % % فكيف بمن لا يستزل عن الوكر % % 44(@)(@@) % ولم تنج من صمصام صولتك العدى % % ولو أنها طارت بأجنحة النسر % % 45(@)(@@) % لك الله ما شيدت بيتا من العلى % % على غير سمر الخط والقضب البتر % % 46(@)(@@) % لك المدح منا والثناء بأسره % % على أن في الأخرى لك الفوز بالأجر % % 47(@)(@@) % عن النعم اللاتي بلغنا بها المنى % % وبيض أياد منك في الأزمن الغبر % % 48(@)(@@) % تجل عن التعداد إن هي أحصيت % % فيا ليت شعري ما أقول من الشعر % % 49(@)(@@) % عجزت بأن أقضي لها حق شكرها % % فليس يعني نظمي بذاك ولا نثري % % PageV01P191 البحر : سريع 1(@)(@@) % نبهت الورقاء ذات الجناح % من غفلة الصحو إلى شرب راح % 2(@)(@@) % والليل قد أجفل من صبحه % % فأكثر الديك عليه الصياح % % 3(@)(@@) % مهفهف الأعطاف من قده % % وطرفه الفتان شاكي السلاح % % 4(@)(@@) % فقام يسقيها ويهدي إلى % % روح الندامى بالمدام ارتياح % % 5(@)(@@) % وما 
ms62	 ألذ الراح من شادن % % مهفهف القد وخود رداح % % 6(@)(@@) % تستنطق العود لدى مجلس % % ألسنة الأوراق فيه فصاح % % 7(@)(@@) % والورق في الأوراق ألحانها % % مطربة بين الغنا والنواح % % 8(@)(@@) % ورب يوم كان عيد المنى % % نحرت فيه الذق نحر الأضاح % % 9(@)(@@) % ورحت في الحب على سكرتي % % بالغي لا أصغي إلى قول لاح % % 10(@)(@@) % ومن يلمني بالهوى قوله % % يمر بي مثل هبوب الرياح % % PageV01P192 11(@)(@@) % فاصطلح القوم على أنه % % ما بين عذالي وبيني اصطلاح % % 12(@)(@@) % يا صاح ما أنت وطيب الكرى % % فبادر اللذات بالاصطباح % % 13(@)(@@) % واشرب ولا تصغ إلى قائل % % هذا حرام ولهذا مباح % % 14(@)(@@) % ما وجد الراحة إلا مرؤ % % أعرض عن عاذله واستراح % % 15(@)(@@) % تنفس الصبح فقم قائما % نحو صراحية ماء صراح % % 16(@)(@@) % وابتسم الورد ودمع الحيا % % في وجنة الورد وثغر الأقاح % % 17(@)(@@) % فاقطع علاقات الأسى بالطلى % % وصل بكاسات الغدو الرواح % % 18(@)(@@) % وانفق نفيس العمر في قهوة % % تقضي على الهم قضاء مناخ % % 19(@)(@@) % مستنشقا منها عبير الشذا % % تفوح كالمسك إذا المسك فاح % % 20(@)(@@) % مع كل ندمان كبدر الدجى % % ما افتض بكر الدن إلا سفاح % % PageV01P193 21(@)(@@) % حي على الراح وقم هاتها % % وقل لمن لاح الفلاح الفلاح % % 22(@)(@@) % ولتك من ريقك ممزوجة % % لا أشرب الراح بماء قراح % % 23(@)(@@) % يا أيها الساقي الذي أثخنت % أحداقه في القلب مني الجراح % % 24(@)(@@) % يشكو إليك القلب من ضعفه % % فتور عينيك المراض الصحاح % % 25(@)(@@) % ما خطر السلوان في خاطري % % بلائم فيه فسادي صلاح % % 26(@)(@@) % يجد بالنصح فألهو به % % وأدفع الجد ببعض المزاح % % 27(@)(@@) % من سره شيء فما سرني % % في الدهر شيء كوجوه الملاح % % 28(@)(@@) % أو فضح الصب فكم مغرم % % أسلمه الحب إلى الافتضاح % % 29(@)(@@) % وما يرى كتمان سر الهوى % % من كتم الحب زمانا وباح % % 30(@)(@@) % إذا وضعت الشعر في أهله % % فلي بزند الافتخار اقتراح % % PageV01P194 31(@)(@@) % إني أرى المنصف في أهله % % يمدح عبد الله أي امتداح % % 32(@)(@@) % قد أثبت الود بقلبي له % % محبة لم يمحها قط ماح % % 33(@)(@@) % فيا رعاه الله من ماجد % % طاب به المغدى وطاب المراح % % 34(@)(@@) % قيدني في البر 
ms63	 من فضله % % فليس لي عن بابه من براح % % 35(@)(@@) % أطرب إن شاهدته مطربا % وما على المطرب فيه جناح % % 36(@)(@@) % ولم أزل في القرب من وده % % أقرع بالأفراح باب النجاح % % 37(@)(@@) % تالله ما شمت له بارقا % إلا ولاح الجود من حيث لاح % % 38(@)(@@) % يلوح لي في الحال من وجهه % % بشر ميامين الندى والسماح % % 39(@)(@@) % يفعل بالأموال يوم الندى % % ما تفعل الأبطال يوم الكفاح % % 40(@)(@@) % أغر صافي القلب مستبشر % % بالأنس مرهوب الظبا والصفاح % % PageV01P195 41(@)(@@) % قد خصه الله وقد زانه % % برفعة القدر وخفض الجناح % % 42(@)(@@) % لا يعرف الهم سميرا له % % ولا يلاقيه بغير انشراح % % 43(@)(@@) % لم يبق لي في أرب بغية % ولا على نيل الأماني اقتراح % % 44(@)(@@) % من الذين افتخرت فيهم % % بيض ظبا الهند وسمر الرماح % % 45(@)(@@) % يصان من لاذ بعلياهم % وما لهم من جودهم مستباح % % 46(@)(@@) % لهم من العلياء إن سوهموا % % سهم المعلى من سهام القراح % % 47(@)(@@) % محاسن المعروف يبدونها % % وأوجه الأيام سود قباح % % 48(@)(@@) % كما استهلت ديمة أمطرت % % على الروابي قطرها والبطاح % % 49(@)(@@) % تشق يوم الروع أيمانهم % % قلب الأعادي بصدور السلاح % % 50(@)(@@) % ترعرعوا في حجر أم العلى % % وأرضعوا منها غريب اللقاح % % PageV01P196 51(@)(@@) % وزاحموا الأنجم في منكب % % يزيح في الأخطار ما لا يزاح % % 52(@)(@@) % كم قدموا للحرب في موطن % % فقربوا بين خطاها الفساح % % 53(@)(@@) % وأعفوها من دماء قنا % ترمد بالطعن عيون الجراح % % 54(@)(@@) % أسد الوغى لا زال أسيافهم % % تنحر بالهيجاء كبش النطاح % % 55(@)(@@) % من كل من تبعثه همة % % تطمح للغايات كل الطماح % % 56(@)(@@) % لم تنب في مضربها عزمة % % منهم ولم تصلد لدى الاقتداح % % 57(@)(@@) % آل زهير الأنجم الزهر في % % سماء أفلاك العلى والسماح % % 58(@)(@@) % إن أمسكوني فبإحسانهم % % أو سرحوني فجميل السراح % % 59(@)(@@) % لا برحت تكسى بأمداحهم % % ذات الغواني حسن ذات الوشاح % % PageV01P197 البحر : طويل 1(@)(@@) % سؤالك هذا الربع أين جوابه ؟ % ومن لا يعي للقول كيف خطابه ؟ % 2(@)(@@) % وقفت وما يغنيك في الدار وقفة % % سقى الدار غيث مستهل سحابة % % 3(@)(@@) % غناؤك في تلك المنازل ناظر % % بدمع توالى غربه وانسكابه % % 4(@)(@@) % إلى طلل أقوى فلم 
ms64	 يك بعدها % % بمغنيك شيئا قربه واجتنابه % % 5(@)(@@) % ذكرت كأيام الشبيبة عهده % % وهل راجع بعد المشيب شبابه % % 6(@)(@@) % وقد كان ذاك العيش والغصن ناعم % % يروق ويصفو كالرحيق شرابه % % 7(@)(@@) % وجدت لقلبي غير ما تجدينه % % أسى في فؤادي قد أناخ ركابه % % 8(@)(@@) % يفض ختام الدمع يا مي حسرة % % ذهاب شباب لا يرجى إيابه % % 9(@)(@@) % ودهر أعاني كل يوم خطوبه % % وذلك دأبي يا أميم ودأبه % % 10(@)(@@) % مسوق إلى ذي اللب في الناس رزؤه % % ووقف على الحر الكريم مصابه % % PageV01P198 11(@)(@@) % وحسبك مني صبر أروع ماجد % % بمستوطن ضاقت بمثلي رحابه % % 12(@)(@@) % يبيت نجي الهم في كل ليلة % % يطول مع الأيام فيها عتابه % % 13(@)(@@) % قضى عجبا منه الزمان تجلدا % وما ينقضي هذا الزمان عجابه % % 14(@)(@@) % تزاد عن الماء النمير أسوده % % وقد تلغ العذب الفرات كلابه % % 15(@)(@@) % ألم يحزن الآبي رؤوس تطامنت % % وفاخر رأس القوم فيها ذنابه % % 16(@)(@@) % وأعظم بها دهياء وهي عظيمة % % إذا اكتنف الضرغام بالذل غابه % % 17(@)(@@) % متى ينجلي هذا الظلام الذي أرى % % ويكشف عن وجه الصباح نقابه % % 18(@)(@@) % وتلمع بعد اليأس بارقة المنى % % ويصدق من وعد الرجاء كذابه % % 19(@)(@@) % ومن لي بدهر لا يزال محاربي % % تفل مواضيه وتنبو حرابه % 20(@)(@@) % عقور على شلوي يعض بنابه % % وتعدو علينا بالعوادي ذئابه % % PageV01P199 21(@)(@@) % رمته الروامي بالسباب مذمة % % وما ضر في عرض اللئيم سبابه % % 22(@)(@@) % تصفحت إخواني فلم أر فيهم % قويما على نهج الوفاء اصطحابه % % 23(@)(@@) % ألإي الناس لا والله من في إخائه % % تشد على العظم المهيض عصابه % % 24(@)(@@) % يساورني كاس الهموم كأنما % % يمج بها السم الزعاف لعابه % % 25(@)(@@) % وأبعد ما حاولت حرا دنوه % % دنوك مما يرتضي واقترابه % % 26(@)(@@) % نصيبك منه شهده دون صابه % % إذا كان ممزوجا مع الشهد صابه % % 27(@)(@@) % يريك الرضا والدهر غضبان معرض % % وترجوه للأمر الذي قد تهابه % % 28(@)(@@) % ورأيك ليست في المشارع شرعة % % ولا منهل عذب يسوغ شرابه % % 29(@)(@@) % وماالناس إلا مثلما أنت عارف % % فلا تطلبن الشيء عز طلابه % % 30(@)(@@) % بلوت بهم حلو الزمان ومره % % فسيان عندي عذبه وعذابه % % PageV01P200 31(@)(@@) % كأني أرى عبد الغني 
ms65	 بأهله % % غريب من الأشراف طال اغترابه % % 32(@)(@@) % يميزه عنهم سجايا منوطة % % بأروع من زهر النجوم سخابه % % 33(@)(@@) % ثمين لئالي العقد حالية به % % من الفضل أعناق الحجى ورقابه % % 34(@)(@@) % إذا ناب عن صرب الغمام فإنه % % إذا لم يصب صوب الغمام منابه % % 35(@)(@@) % تألق فانهلت عزاليه وارتوى % % به حزن راجيه وسالت شعابه % % 36(@)(@@) % أتعرف إلا ذلك القرم آبيا % على الدهر يقسو أو تلين صلابه % % 37(@)(@@) % تسربل فضفاض الأبوة كلها % % وزرت على الليث الهصور ثيابه % % 38(@)(@@) % ولم ينزل الأرض التي قد تطامنت % % ولو أن ذاك الربع مسكا ترابه % % 39(@)(@@) % لقد ضربت فوق الرواسي وطنبت % على قلل المجد الأثيل قبابه % % 40(@)(@@) % فأصبحت الشم العرانين دونه % % وحلق في جو الفخار عقابه % % PageV01P201 41(@)(@@) % أبى الله والنفس الأبية أن يرى % % بغير المعالي همه واكتئابه % % 42(@)(@@) % فدانت له الأخطار بعد عتوها % % وذلت له من كل خطب صعابه % % 43(@)(@@) % ولو شاء كشف الضر فرق جمعه % % وما فارق العضب اليماني قرابه % % 44(@)(@@) % ومجتهد في كل علم أبية % فلا يتعداها لعمري صوابه % % 45(@)(@@) % بفكر يرى ما لا يرى فكر غيره % % يشق جلابيب الظلام شهابه % % 46(@)(@@) % مقيم على أن لا يزال قطاره % % يصوب وهذا صوبه وانصبابه % % 47(@)(@@) % وإما خلا ذاك الغمام فمقلع % % وعما قليل يضمحل ضبابه % % 48(@)(@@) % وناهيك بالندب الذي إن ندبته % % كفاك مهمات الأمور انتدابه % % 49(@)(@@) % ذباب حسام البأس جوهر عضبه % % وما الصارم الهندي لولا ذبابه ؟ % 50(@)(@@) % عليم بما يقني الثناء وعامل % % وداع إلى الخير العظيم مجابه % % PageV01P202 51(@)(@@) % إذا انتسب الفعل الجميل فإنما % % يكون إلى رب الجميل انتسابه % % 52(@)(@@) % هل الفضل والإحسان إلا صنيعه % % أم الحمد والشكران إلا اكتسابه ؟ % 53(@)(@@) % وإني مكتى أخليت من ثروة الغنى % % وأغلق من دون المطامع بابه % % 54(@)(@@) % بدا لي أن أعشو إلى ضوء ناره % % وأصبو إلى ذاك المريع جنابه % % 55(@)(@@) % فأصدرني عنه مصادر وارد % % من اليم زخار النوال عبابه % % 56(@)(@@) % وأصبح مرموق السعادة بعدما % % خلت ثم لا زالت ملاء وطابه % % 57(@)(@@) % إذا ذهب المعروف في كل مذهب % % إليك برغم الحادثات مآبه % % 58(@)(@@) % فلست تراني ما حييت 
ms66	 مؤملا % سواك ولم يعلق بي النذل عابه % % 59(@)(@@) % ولا مستثيبا من دني مثوبة % حرام على الحر الأبي ثوابه % % 60(@)(@@) % وغيرك لم أرفع إلى شيم برقه % % ولا غرني في الظامئين سرابه % % PageV01P203 البحر : بسيط تام 1(@)(@@) % هنيت هنيت بالأقدام والظفر % % فاسلم ودم سالما بالعز وافتخر % % 2(@)(@@) % زلزلت بالسيف أركانا مشيدة % % تكاد تلحق بعد العين بالأثر % % 3(@)(@@) % أنت المنيب إلى الله العزيز به % % والمتقي منه في أمن وفي خطر % % 4(@)(@@) % بطشت بطش شديد البأس منتقم % % من بعد ما كنت قد بالغت في النذر % % 5(@)(@@) % إن الخوارج عن أمر أمرت به % % جاءت إليك لعمري غير مفتقر % % 6(@)(@@) % هم عاهدوك على أن لا تمد لهم % % يد إلى شجر عدوا ولا عشر % % 7(@)(@@) % ولا ينالون منها غير ما ملكت % % أيمانهم بعدما يودى من العشر % 8(@)(@@) % لو أنهم صدقوك القول يومئذ % قبلت بالعفو عنهم عذر معتذر % % 9(@)(@@) % كفى بمكا كان منك اليوم تبصرة % % لو يعقلون لذي سمع وذي بصر % % 10(@)(@@) % لبتك أبناء نجد إذ دعوتهم % % فأقبلت زمرا تأوي إلى زمر % % PageV01P204 11(@)(@@) % جاءت إليك كأسد الغاب عادية % % على أعاديك تحمي البيض بالسمر % % 12(@)(@@) % تهون دونك منهم أنفس كرمت % في عزة الموت أو في لجة الخطر % % 13(@)(@@) % كأنما تنتضيها من عزائمهم % % صوارما طبعوها آفة العمر % % 14(@)(@@) % والحرب قائمة منهم على قدم % % والنفع يكحل عين الشمس بالحور % % 15(@)(@@) % وللمدافع إرعاد وزمجرة % % ترمي جهننمها الطاغين بالشرر % % 16(@)(@@) % إذا قضى الحتف من أبطالها وطرا % ففي سليمان منها لذة الوطر % % 17(@)(@@) % بغلمة كسيوف الهند مصقلة % % ما شيب منها صفاء الود بالكدر % % 18(@)(@@) % لا ينزلون على كره بمنزلة % % ولا يضامون في بدو وفي حضر % % 19(@)(@@) % وكم جمعت وشجعت الرجال وكم % % علمتها الحرب بعد الجبن والخور % % 20(@)(@@) % وافاك من قومه الأعجام في نفر % % حرب تشب بنار من لظى سقر % % PageV01P205 21(@)(@@) % علمتهم كيف يمضي السيف شفرته % % وليس يغني حذار الموت عن قدر % % 22(@)(@@) % سرت بهم نفحات منك تبعثهم % % إلأى الشجاعة بعث النادر الحذر % % 23(@)(@@) % وأنت وحدك فيهم عسكر لجب % % سود الوقائع من راياتك الحمر % % 24(@)(@@) % وأنت 
ms67	 بالله لا بالجيش منتصر % % فيا لمستنصر بالله منتصر % % 25(@)(@@) % قد أفلح الناس باديها وحاضرها % % من آمر بالذي تهوى ومؤتمر % % 26(@)(@@) % وأنت هاد لها في كل مشتور % وأنت مقدامها في كل مشتجر % % 27(@)(@@) % ورب أمر مهول من عظائمه % % أن ليس ترنو إليه عين محتقر % % 28(@)(@@) % فعلت بالرأي والتدبير يؤمئذ % % ما ليس تفعله بالصارم الذكر % % 29(@)(@@) % وإنك العضب راع العين منتظرا % من صنعة الله لا من صنعة البشر % % 30(@)(@@) % ترق للناس ما تصفو ضمائرها % % برقة كنسيم الروض في السحر % % PageV01P206 31(@)(@@) % والغل يكمن من تلك الخوارج في % % قلوبها ككمون النار في الحجر % % 32(@)(@@) % عادوا فعدت إلى ما كنت تفعله % % في حالك من ظلام النقع معتكر % % 33(@)(@@) % والخيل تفعل بالقتلى سنابكها % % لعب الصوالج يوم الروع بالأكر % % 34(@)(@@) % وقمت تخطب في حد الحسام على % % منابر الهام بالآيات والسور % % 35(@)(@@) % والسيف أصدق ما تنبيك لهجته % % بموجزم لسان الحال مختصر % % 36(@)(@@) % دانوا لأمرك بعد الذل وامتثلوا % % وكان عفوك عنهم عفو مقتدر % % 37(@)(@@) % كم من يد لهم طولى تطول على % % سمر العوالي رماها الله بالقصر % % 38(@)(@@) % ومنذ عادوا فقد عادوا لمهلكة % % لما نهوا عنه من بغي ومن وطر % % 39(@)(@@) % في كل عام لهم حرب ومعترك % % وموعد للمنايا غير منتظر % % 40(@)(@@) % وهم متى شئت كانوا منك يومئذ % % لدى المنية بين الناب والظفر % % PageV01P207 41(@)(@@) % لا يبلغ الشر منهم مثل مبلغه % % في عامهم ذلك الماضي ولم يثر % % 42(@)(@@) % ورب أحمق معروف لشهرته % % وافاك قومه الأعجام في نفر % % 43(@)(@@) % لا يعرفون وجوه الموت ترهقهم % % ذلا وتوسعهم طردا إلى الغرر % % 44(@)(@@) % أخزاهم الله في الأدبار إذ ذبحوا % % قبل الخلائف ذبح الشاة والبقر % % 45(@)(@@) % وفر قائدهم من خوفه هربا % حتى تحجب بالحيطان والجدر % % 46(@)(@@) % ليت المنية غالته بمهلكة % % وقد أصيب لحاه الله من دير % % 47(@)(@@) % إن الأباعد لم يوثق بخدمتهم % % هم العدو فكن منهم على حذر % % 48(@)(@@) % أبعد عن العسكر المنصور منزلهم % % فشرهم غير مأمون من الضرر % % 49(@)(@@) % لا يصلح الجاهل المغرور في نظر % % إلا إذا كان مصروفا عن النظر % % 50(@)(@@) % المفسدون بأرض ينزلون 
ms68	 بها % % والبارزون بقبح الفعل والصور % % PageV01P208 51(@)(@@) % لله درك لم تسبق بما فعلت % % منك العزائم في ماض من العصر % % 52(@)(@@) % بعث للبصرة الفيحاء تحفظها % % بصارم البأس من أحداثها الغير % % 53(@)(@@) % طهرتها من فساد كان يكنفها % % ولم تدع باغيا فيها ولم تذر % % 54(@)(@@) % وصنتها عن شرار الناس قاطبة % % صون الجنين لدى الإنفاق بالبدر % % 55(@)(@@) % فعلت فعلاتك الأتي فعلت بها % % تبقى مع الدهر في الأخبار والسير % % PageV01P209 البحر : طويل 1(@)(@@) % أتى ببراهين غدا كل جاحد % ببرهانه بين البرية مفحما % % 2(@)(@@) % فألزمه بالحق والحق قوله % % فأسلم من بعد الجحود وسلما % % 3(@)(@@) % فطورا تراه للأمور مسددا % وطورا تراه للعلوم معلما % % 4(@)(@@) % فلله ما صنفت كل مصنف % % سرى منجدا في العالمين ومتهما % % 5(@)(@@) % ومن مشكلات بالعلوم عرفتها % % فأعربت عما كان فيهن معجما % % 6(@)(@@) % وأبكيت أقلام البراعة والنهى % % فأرضيت حد السيف حتى تبسما % % 7(@)(@@) % وما نلت عما شان بالمجد خاليا % وما زلت بالعلم اللدني مفعما % % 8(@)(@@) % تفردت في علم وفهم وحكمة % % فها أنت والعلياء أصبحت توأما % % 9(@)(@@) % وإن جئتنا في آخر الدهر رحمة % % إذا عدت الأمجاد كنت المقدما % % 10(@)(@@) % وحسبك ما في الناس مثلك سيد % % أنال مقلا أو تكرم معدما % % PageV01P210 11(@)(@@) % وكم نثرت نثرا بلاغتك التي % % أردت بها در المعالي منظما % % 12(@)(@@) % وقد أخرستني من علاك فصاحة % % ألبست تراني أخرس النطق أبكما % % PageV01P211 البحر : وافر تام 1(@)(@@) % أمن بعد الهمام القرم وادي % % تصوب غمامة ويسيل وادي % % 2(@)(@@) % وهل يسقي الغمام بني زبيد % فتنقع غلة ويبل صادي % % 3(@)(@@) % لتصدى بعده الوراد طرا % % وأين الماء من غلل الصوادي % % 4(@)(@@) % شديد البأس أروع مستشيط % % يرد شكيمة الكرب الشداد % % 5(@)(@@) % فكيف يقوده صرف المنايا % % وكنت عهدته صعب القياد % % 6(@)(@@) % قريبا كان ممن يرتجيه % % رماه الحتف منا بالبعاد % % 7(@)(@@) % وذخر الأنجبين وكل ذخر % % ستسلمه الخطوب إلى النفاد % % 8(@)(@@) % فقدنا صبح غرته بليل % % كسا الأيام أردية السواد % % 9(@)(@@) % وروعت النجوم الزهر حتى % % برزن من الدجنة في حداد % % 10(@)(@@) % كأن له من الأحشاء قبرا % فؤادي لو شققت على فؤادي % % PageV01P212 11(@)(@@) % يعز على العوالي والمعالي % % وسمر الخط 
ms69	 والخيل الجياد % % 12(@)(@@) % أسير بين أيديها المنايا % % فلا يفدى وإن كثر المفادي % % 13(@)(@@) % يغض الطرف لا عن كبرياء % % ولم يشغل بمكرمة ودادي % % 14(@)(@@) % فليس القول منه بمستعاد % % وليس الجود منه بمستفاد % % 15(@)(@@) % يبيت بلا أنيس بين قوم % نيام لا تهب من الرقاد % % 16(@)(@@) % ولو يفدى فدته إذن رجال % % عواد بالسيوف على الأعادي % % 17(@)(@@) % وحالت دونه بيض حداد % % شفعن بزرقة السمر الصعاد % % 18(@)(@@) % ولاجتهدت بمنعته عقول % % لها في الرأي حق الاجتهاد % % 19(@)(@@) % ولكن قد أصيب بسهم رام % قضى أن لا يرد عن المراد % % 20(@)(@@) % وليس لما قضاه الله رد % وأمر الله يجري في العباد % % PageV01P213 21(@)(@@) % أرى الآجال تطلبنا حثيثا % ونحن من الغواية في تهاد % % 22(@)(@@) % وأعمار تناكص بانتقاص % % وآمال تهافت بازدياد % % 23(@)(@@) % وقد غلبت لشقوتنا علينا % % وكاد الغي يمكر بالرشاد % % 24(@)(@@) % ونطمع بالبقاء وما برحنا % % نروع بالتفرق والبعاد % % 25(@)(@@) % نودع نائيا بالرغم منا % % إلى سفر يطول بغير زاد % % 26(@)(@@) % ونسلو عن أحبتنا ولسنا % % بملتقيين إلا في المعاد % % 27(@)(@@) % لقد عظم المصاب وجل رزاء % بفقد المكرمين من البلاد % % 28(@)(@@) % فقدنا واديا فيها فقلنا % % على الدنيا العفا من بعد وادي % % 29(@)(@@) % وفل الموت مضرب هندوان % وأرزى بالحمائل والنجاد % % 30(@)(@@) % أذوب عليك بالحزن إدكارا % وأشرق منك بالماء البراد % % PageV01P214 31(@)(@@) % ولي نفس تلهب عن زفير % كما طار الشرار عن الزناد % % 32(@)(@@) % على ليث هزبر تكاد منه % % ليوث الغاب تصفد في صفاد % % 33(@)(@@) % يماط عن الثياب وكان يكسو % % غداة الروع سابغة اللؤادي % % 34(@)(@@) % قد انقشعت سحابة كل عاف % بوبل القطر في السنة الجماد % % 35(@)(@@) % وكدرت المشارب بعد صفو % % وما يجديك رفق من ثماد % % 36(@)(@@) % هي الأيام لا تصفو لحي % ولا تبقي الموالي والمعادي % % 37(@)(@@) % ألم تنظر لما صنعت بعاد % وأقيال مضت من بعد عاد % % 38(@)(@@) % وما أدري على أي اتكال % % وثقنا بالسلامة واعتماد % % 39(@)(@@) % فكم نطأ الرماد ونحن ندري % % ونعلم أن جمرا في الرماد % % 40(@)(@@) % وهبنا مثل نبت الزرع ننمو % % فهل زرع يدوم بلا حصاد % % PageV01P215 41(@)(@@) % وتهلك أمة وتجيء أخرى % % ويخفى ذا وهذا اليوم بادي % % 42 
ms70	(@)(@@) % على هذا اطراد الدهر قدما % فكيف نروم عكس الإطراد % % 43(@)(@@) % لقد كانت بيوت بني زبيد % % ولا أرم بها ذات العماد % % 44(@)(@@) % فراحت كالسوام بغير راع % % وضلت كالجمال بغير حاد % % 45(@)(@@) % فمن للجود بعدك والعطايا % % ومن للحرب يقدم والجلاد % % 46(@)(@@) % فلا تستسقيا غيثا مريعا % وقري يا طوارم في الغماد % % 47(@)(@@) % فقد فقد المكارم ناشدوها % % فلا جود يؤمل من جواد % % 48(@)(@@) % بربك هل سمعت لنا نداء % وما يغني النداء ولا التنادي % % 49(@)(@@) % أما أنت المجيب لكل هول % % ببيض الهند والزرق الحداد % % 50(@)(@@) % ومنتدب الكماة ومقتداها % % إذا انتدب الفوارس للطرد % % PageV01P216 51(@)(@@) % ووابل صوبها المنهل تندى % % بنائله الروائح والغوادي % % 52(@)(@@) % فمن يدعى وقد صم المنادي % % فوالهف الصريخ عن المنادي % % 53(@)(@@) % بللتك بالنجيع نجيع دمعي % % وأقلامي بمسود المداد % % 54(@)(@@) % وقد قلت الرثاء وثم قول % يثير لظى حشا ذات اتقاد % % 55(@)(@@) % فليتك كنت تسمع فيك قولي % % وما أبديه من محض الوداد % % 57(@)(@@) % تشق لها قلوب لا جيوب % % ولو كانت أفظ من الجماد % % 58(@)(@@) % قواف تقطر العبرات منها % % وتستسقى لك الديم الغوادي % % 59(@)(@@) % إذا ناحت عليك بكل ناد % بكينا المكرمات بكل ناد % % PageV01P217 البحر : وافر تام 1(@)(@@) % وقفنا بالركائب يوم سلع % على دار لنا أمست خلاءا % % 2(@)(@@) % نردد زفرة ونجيل طرفا % يجاذبنا على الطلل البكاءا % % 3(@)(@@) % وقفنا والنياق لها حنين % % كأن النوق أعظمنا بلاءا % % 4(@)(@@) % هوى إن لم يكن منها وإلا % فمن إلف لنا عنا تناءى % % 5(@)(@@) % وقفنا عند مرتبع قديم % % فجددنا بموقفنا العزاءا % % 6(@)(@@) % وقلت لصاحبي هل من دواء % % فقد هاج الهوى في الركب داءا % % 7(@)(@@) % ودار طالما أوقفت فيها % % فغادرت الظماء بها رواءا % % 8(@)(@@) % لها حق على المشتاق منا % % فأسرع يا هذيم لها الأداءا % % 9(@)(@@) % أرق يا سعد دمعك إن دمعي % % دم إن كان منك الدمع ماءا % % 10(@)(@@) % وما لك لا تريق لها دموعا % وإني قد أرقت لها دماءا % % PageV01P218 11(@)(@@) % تكاد تميتني الأطلال يأسا % بأهليها وتحييني رجاءا % % 12(@)(@@) % هوى ما سرها إذ سر يوما % وكم سر الهوى من حيث ساءا % % 13(@)(@@) % كأن العيس تشجيها المغاني % % فتشجينا 
ms71	 حنينا أو رغاءا % % 14(@)(@@) % وقد عاجت مطايانا سراعا % فما رحلتها إلا بطاءا % % PageV01P219 البحر : وافر تام 1(@)(@@) % دعاه إلى الهوى داعي التصابي % % فراح يذكر أيام الشباب % % 2(@)(@@) % يذيل مدامعا قد أرسلتها % % لواعج فرط حزن واكتئاب % % 3(@)(@@) % وأبصره العذول كما تراه % % بما قاسى شديد الاضطراب % % 4(@)(@@) % وفي أحشائه وجد كمين % يغذبه بأنواع العذاب % % 5(@)(@@) % فلام ولم يصب باللوم رشدا % وكان العذر أهدى للصواب % % 6(@)(@@) % جفته الغانيات وقد جفاها % % فلا وصل من البيض الكعاب % % 7(@)(@@) % وكان يروعه من قبل هذا % % هوى سلمى وزينب والرباب % % 8(@)(@@) % يروع إلى الدمى صاب إليها % % ويأنس في أوانها العراب % % 9(@)(@@) % أعيدي النوح يا ورقاء حتى % % كأنك قد شكوتك بعض ما بي % % 10(@)(@@) % بكيت وما بكيت لفقد إلف % على أني أصبت ولم تصابي % % PageV01P220 11(@)(@@) % وذكرني وميض البرق ثغرا % برود الشرب خمري الرضاب % % 12(@)(@@) % وما أظمأك يا كبدي غليلا % إلى رشف الثنايات العذاب % % 13(@)(@@) % أتنسى يا هذيم غداة عجنا % % على ربع نهاب للذهاب % % 14(@)(@@) % فأوقفنا المطي على رسوم % % كآثار الكتاب من الكتاب % % 15(@)(@@) % وأطلال لمية باليات % % بكت أطلالها مقل السحاب % % 16(@)(@@) % نسائلها عن النائين عنها % % فتعجز يا هذيم عن الجواب % % 17(@)(@@) % هنالك كانت العبرات منا % % خضابا أو تنوب عن الخضاب % % 18(@)(@@) % أمني النفس بعد ذهاب قومي % % بما يرجو المفارق من إياب % % 19(@)(@@) % ذريني يا أميم من الأماني % % فما كانت خلا وعد كذاب % % 20(@)(@@) % ذريني أصحب الفلوات إني % % رأيت الجد أوفق بالطلاب % % PageV01P221 21(@)(@@) % فما لي يا أميمة في خمول % % يطول به مع الدنيا عتابي % % 22(@)(@@) % سقيم بين ظهراني أناس % أروم بهم شرابا من سراب % % 23(@)(@@) % يجنبني نداهم صون عرضي % % وتركي للدنية واجتنابي % % 24(@)(@@) % وكم لي فيهم من قارصات % % وما نفدت سهام من جعابي % % 25(@)(@@) % سأرسلها وإن كانت حثيا % عليها من أباة الضيم آبي % % 26(@)(@@) % وإني مثلما علمت سعاد % وقور الجأش مقلاق الركاب % % 27(@)(@@) % وأدرع القتام لكل هول % % كما أغمدت سيفا في قراب % % 28(@)(@@) % وأصحب كل مبيض السجايا % % وجنح الليل مسود الاهاب % % 29(@)(@@) % ليأخذ من أحاديثي حديثا % غنيا عن معاطاة الشراب % % 30 
ms72	(@)(@@) % بمدح محمد رب المعالي % % ورائق صفوة الحسب اللباب % % PageV01P222 31(@)(@@) % وها أنا لا أزال الدهر أثني % % عليه بالثناء المستطاب % % 32(@)(@@) % فأطرب فيه لا طرب الأغاني % % وكأس الراح ترقص بالحباب % % 33(@)(@@) % إذا دار نبت بي رحلتها % % عزائم باسل عالي الجناب % % 34(@)(@@) % أطرز باسمه برد القوافي % % كوشي البرد طرز بالذهاب % % 35(@)(@@) % وفيه تنزل الحاجات منا % % وتنزل في منازله الرحاب % % 36(@)(@@) % إذا آب الرجاء إليه لاقى % % بساحة مجده حسن المآب % % 37(@)(@@) % تواضع وهو عالي القدر سام % ولا عجب هو ابن أبي تراب % % 38(@)(@@) % يشرفني إذا أدنيت منه % % شريف من ذؤابة آل بيت % 39(@)(@@) % وفيما بيننا والفضل قربى % % من العرفان والنسب القراب % % 40(@)(@@) % أهيم بمدحه في كل واد % وأقرع في ثناه كل باب % % PageV01P223 41(@)(@@) % إلى حضراته الأمداح تجبى % % ومن ثم انتمى فيها لجابي % % 42(@)(@@) % يرغب فضله الفضلاء فيه % % ويطمعهم بأيديه الرغاب % % 43(@)(@@) % عطاء ليس يسبقه مطال % % وقد يعطي الكثير بلا حساب % % 44(@)(@@) % وينفق في سبيل الله مالا % لأبناء السبيل وفي الرقاب % % 45(@)(@@) % جزى الله الوزير الخير عنا % % وأجزاه بأضعاف الثواب % % 46(@)(@@) % فقد سر العراق ومن عليها % % بقاض لا يروغ ولا يحابي % % 47(@)(@@) % وأبقى الله للإسلام شيخا % به دفع المصاب عن المصاب % % 48(@)(@@) % بمثل قضائه فصل القضايا % % ومثل خطابه فصل الخطاب % % 49(@)(@@) % أطلوا بالعلاء على البرايا % % كما طل الجبال على الروابي % % 50(@)(@@) % ليهنك أنت يا بغداد منه % % بطلعة حسن مرجو مهاب % % PageV01P224 51(@)(@@) % أقام العدل في الزوراء حتى % % وجدنا الشاء يأنس بالذئاب % % 52(@)(@@) % وأنى لا يطاع الحق فيها % % ولا تجري الأمور على الصواب % % 53(@)(@@) % وسيف الله في يد هاشمي % صقال المتن مشحوذ الذباب % % 54(@)(@@) % خروجك من دمشق الشام ضاهى % % خروج العضب أصلت للضراب % % 55(@)(@@) % وجئت مجيء سيل الطم حتى % % لقد بلغ الروابي والزوابي % % 56(@)(@@) % بعلم منك زخار العباب % % وفضل منك ملآن الوطاب % % 57(@)(@@) % فمن هذا ومن هذا جميعا % أتيت الناس بالعجب العجاب % % 58(@)(@@) % فلا أفلت نجومك في مغيب % % ولا حجبت شموسك في ضباب % % PageV01P225 البحر : كامل تام 1(@)(@@) % أكرم بطيف خيالكم من زائر % ما زار إلا مؤذنا ببشائر 
ms73	 % % 2(@)(@@) % وافى على بعد المزار وربما % % بل الغليل بغائب من حاضر % % 3(@)(@@) % والنجم يصرف للغروب عنانه % % حتى بصرت به كليل الناظر % % 4(@)(@@) % وكأن ضوء في أثر الدجى % % إظهار حجة مسلم للكافر % % 5(@)(@@) % لا تحسبوا أني سلوت غرامكم % % هجرا فبعدا للمحب الهاجر % % 6(@)(@@) % جمراك ذاك الوجد حشو جوانحي % % وجمال ذاك الوجه ملء نواظري % % 7(@)(@@) % أعد ادكارك يوم مجتمع الهوى % % إني لأصبو عند ذكر الذاكر % % 8(@)(@@) % أيام نرفل بالنعيم ونصطلي % % نار المدامة من عصير العاصر % % 9(@)(@@) % ولقد ذكرت العيش وهو كأنما % % برزت محاسنه بروض ناضر % % 10(@)(@@) % ومليكه الأفراح في أقداحها % % قد رصعت تيجانها بجواهر % % PageV01P226 11(@)(@@) % صبغت بإكسير الحياة لجينها % % فكأنها ملكت صناعة جابر % % 12(@)(@@) % خلع العذار لها النزيف وبان في % % جنح الظلام منادمي ومسامري % % 13(@)(@@) % متجاهر يهفو إلى لذاته % % أحبب إلى اللذات من متجاهر % % 14(@)(@@) % ذهبت لذاذات الصبا وتصرمت % % أوقات أنسك في الزمان الغابر % % 15(@)(@@) % وإذا امرؤ فقد الشباب فما له % % في اللهو بعد مشيبه من عاذر % % 16(@)(@@) % ولقد أقول لطامع برجوعها % % كيف اقتناصك للغزال النافر ؟ % 17(@)(@@) % لله ما أورى بنا متلفت % % يوم الفحيم بجيد أحوى الناظر % % 18(@)(@@) % والركب مرتحل بكل غريرة % % تبني الكناس بغاب ليث خادر % % 19(@)(@@) % أرأيت ما فعل الوداع بمقلة % % ما قرحت بالدمع غير محاجري % % 20(@)(@@) % وجرت على نسق مدامع عبرة % % شبهتها باللؤلؤ المتناثر % % PageV01P227 21(@)(@@) % شيعت هاتيك الظغون عشية % % ورجعت بعدهم بصفقة خاسر % % 22(@)(@@) % لا كان يوم وداعهم من موقف % % وقف المتيم فيه وقفة حائر % % 23(@)(@@) % والدمع يلحق آخرا في أول % والبين يرفق أولا في آخر % % 24(@)(@@) % من ناصري منكم على مضض الهوى ؟ % هيهات ليس على الهوى من ناصر % % 25(@)(@@) % لا تعذلن فللغرام قضية % % سدت علي مسامعي ومناظري % % 26(@)(@@) % يا سعد حين ذكرت شرقي الحمى % % هل كان قلبي في جناحي طائر % % 27(@)(@@) % كشفت لديك سريرة أخفيتها % % فعرفت ثمة باطني من ظاهري % % 28(@)(@@) % وجفا الخيال ولم يزرني بعدها % % أين الخيال من الكئيب الساهر % % 29(@)(@@) % يا أهل هذا الحي كيف تصبري % % عنكم ومن لي بالفؤاد الصابر % % 30(@)(@@) % ولقد طربت لذكركم فكأنني 
ms74	 % % بغداد يوم قدوم عبد القادر % % PageV01P228 31(@)(@@) % وافى من الشام العراق بطلعة % % شمنا بها برق الحيا المتقاطر % % 32(@)(@@) % فزها بطلعته العراق وأهله % % والروض يزهو بالسحاب الماطر % % 33(@)(@@) % وتقدمته قبل ذاك بشارة % % ما جاءت البشرى لها بنظائر % % 34(@)(@@) % وافى فأشرق كل فج مظلم % % فيه وأحيا كل فضل داثر % % 35(@)(@@) % وضفا السور على أفاضل بلدة % % سروا بمحياه البهي الباهر % % 36(@)(@@) % نعموا بوجه للنعيم نضارة % % فيه وقرت فيه عين الناظر % % 37(@)(@@) % بأغر أبيض تتجلى بجنبينه % % ظلمات سجف ستائر لدياجر % % 38(@)(@@) % يبتاع بالمال الثناء وإنما % % في سوقه ربحت تجارة تاجر % % 39(@)(@@) % صعب على صعب الخطوب وجائر % % أبدا على جور الزمان الجائر % % 40(@)(@@) % إن كان ذا البأس الشديد فرأفة % % فيه أرق من النسيم الحاجري % % PageV01P229 41(@)(@@) % حييت ما بين الورى من قادم % % ونعمت بين أكارمة وأكابر % % 42(@)(@@) % قد زعزعت بك عن دمشق أبوة % نتجت به أم الزمان العاقر % % 43(@)(@@) % وشحذت عزمك للمجيئ غرتره % % ولرب عزم كالحسام الباتر % % 44(@)(@@) % وطلعت كالقمر المنير إذا بدا % % زاه بأنوار المحاسن زاهر % % 45(@)(@@) % واخترت من بغداد أشرف منزل % ما بين خير عصابة وأخاير % % 46(@)(@@) % فانزل على سعة الوقار ورحبه % % في منزل رحب وبيت عامر % % 47(@)(@@) % بنيت قواعده على ما ينبغي % % من سؤدد سامي العلى ومفاخر % % 48(@)(@@) % فلئن تعبت فبعد هذا راحة % % أو قيل ما قالوا فليس بضائر % % 49(@)(@@) % ولسوف تبلغ بعد ذاك مآربا % ما ليس يخطر بعضها بالخاطر % % 50(@)(@@) % وكفاك ربك شر كل معاند % % ركب الغرور فلا لعا للعاثر % % PageV01P230 51(@)(@@) % أبي جميل إنني بجميلكم % % ميزت بين الناس دون معاصري % % 52(@)(@@) % إني لأفخر فيكم فيقال لي % % لله شاعر مجدهم من شاعر % % 53(@)(@@) % فلو نني آتي بكل قصيدة % % عذراء من غرر القصائد باكر % % 54(@)(@@) % وجلوتها فكأنما هي غادة % % حليتها من مدحكم بأساور % % 55(@)(@@) % وإذا تناشدها الرواة حسبتها % % أرواح انفاس النسيم العاطر % % 56(@)(@@) % لم أقض حق الشكر من إحسانكم % % لكن أطاوله بباع قاصر % % 57(@)(@@) % عذبت لديكم في الأنام مواردي % % حتى رأيت من الغريب مصادري % % 58(@)(@@) % هاتكم الأيدي التي لا ينقضي % % مدح الجميل لها وشكر الشاكر 
ms75	 % % PageV01P231 البحر : بسيط تام 1(@)(@@) % يا نائبا غاب عني الصبر مذ بانا % % هلا سألت عن المشتاق ما عانى ؟ % 2(@)(@@) % ما راق في عينه شيء يروق لها % % ولا اصطفى غير من صافيت إخوانا % % 3(@)(@@) % ورلا إذا غردت ورقاء في فنن % % أملت علي من الأوراق أشجانا % % 4(@)(@@) % وصرت في حال من لا يبتغي بدلا % بالأهل أهلا وبالجيران جيرانا % % 5(@)(@@) % ما زلت أخصل أجفاني بأدمعها % % إذا تدكرت أوطارا وأوطانا % % PageV01P232 البحر : كامل تام 1(@)(@@) % إن الأكارم والمكارم % والأفاضل والأماجد % 2(@)(@@) % فقدت محمده الأمين % % فيا لمفقود وفاقد % 3(@)(@@) % وخلت معاهد للتقى % % وتعطلت تلك المساجد % % 4(@)(@@) % وبكت عليه مدارس % من بعده وخلت مساجد % % 5(@)(@@) % قد كان أعظم حجة % في الدين تفحم كل جاحد % % 6(@)(@@) % ما في البرية كلها % % أقوى وأعدل منه شاهد % % 7(@)(@@) % بالله أقسم إنه % % في ملة الإسلام واحد % % 8(@)(@@) % كانت موارد علمه % % شرعا شرعن لكل وارد % % 9(@)(@@) % قد كان للدين القويم % % إذا نظرت يدا وساعد % % 10(@)(@@) % يا واعظا بوجوده % % عظمة تلين لها الجلامد % % PageV01P233 11(@)(@@) % يا نائيا عن صحبه % % هل أنت بعد النأي عائد % % 12(@)(@@) % فلكم سددت على امرىء % باب المطالب والمقاصد % % 13(@)(@@) % وأذبت دمعا كان لي % % من قبل هذا اليوم جامد % % 14(@)(@@) % أين الفرائد والشرائد % والعرائد والفوائد % 15(@)(@@) % ما كنت آمل أنني % % أنعي على الأيام واجد % % 16(@)(@@) % وألين بعد أحبتي % % للحادثات من الشدائد % % 17(@)(@@) % لا ساعدي فيه القوي % ولا على زمني مساعد % % 18(@)(@@) % ولقد سئمت من الحياة % % بما أشاهد أو أكابد % % 19(@)(@@) % لما فقدت الصالحين % % علمت أن الدهر فاسد % % PageV01P234 البحر : - 1(@)(@@) % مذ سل في العشاق الناظر % وسطا كما يسطو بماض باتر % % 2(@)(@@) % جرح الفؤاد بصارم من لحظه % % رشأ يصول بلحظ فاتر % % 3(@)(@@) % ما كنت أعلم أن أرى صرف الردى % % من أعين تحكي عيون جآذر % % 4(@)(@@) % ويلاه من لك العيون فإنها % % فتكت بنا فتك الهزبر الثائر % % 5(@)(@@) % تبدو العيون النجل في حركاتها % % في زي مسحور وسيما ساهر % % 6(@)(@@) % قمر إذا نظر العذول جماله % % أضحى عذولي بالصبابة عاذري % % 7(@)(@@) % يجفو ويوصل في الهوى لمشوقه % % والصد من شيم 
ms76	 الغزال النافر % % 8(@)(@@) % أمسى يعاطيني مدامو ريقه % % والنجم يلحظا بطرق ساهر % % 9(@)(@@) % ما زلت ألثمه وأرشف ثغره % % حتى بلغت به مناء الخاطر % % 10(@)(@@) % لله أيام الوصال فإنها % % مرت ولكن في جناحي طائر % % PageV01P235 11(@)(@@) % وإذا ذكرت لبانة قضيتها % % ولعت مدامع أعيني بمحاجري % % 12(@)(@@) % ولياليا بالأبرقين تصرمت % % كان الحبيب منادمي ومسامري % % 13(@)(@@) % إن غاب من أهوى وعز لقاؤه % % فالقلب لم يبرح بوجد حاضر % % 14(@)(@@) % لي حسرة ممن أود ولوعة % % وقدت لواعج نارها بضمائري % % 15(@)(@@) % لم يبق لي أمل أرجي نيله % % إلا نوال يمين عبد القادر % % 16(@)(@@) % وترى الركائب حاملات في الورى % % أخبار حسن حديثه المتواتر % % 17(@)(@@) % ذو همة وعزائم بين الملا % % أغنته عن حمل الحسام الشاطر % % 18(@)(@@) % أحيا حديث الفضل بعد مماته % % وجمال ذياك الزمان الغابر % % 19(@)(@@) % والتارك العافي بجنة فضله % % ترك المعادي في لحود مقابر % % 20(@)(@@) % ودليل شيمته صفاء جنانه % % والشي يرى من ظاهر % % PageV01P236 21(@)(@@) % شيم له نتلو بحسن ثنائها % % كتبت محاسنها بكل دفاتر % % 22(@)(@@) % يعفو عن الجاني ويغفر ذنبه % % والعفو أحسن ما أتى من قادر % % 23(@)(@@) % لم ألق بين الناس أكرم ماجد % % لوفوده ولضده من قاهر % % 24(@)(@@) % بالرأي آصف ما يحاول رأيه % % يقف الدكي لديه وقفة حائر % % 25(@)(@@) % هيهات أن يأتي الزمان بمثله % % نتجت به أم الزمان العاقر % % 26(@)(@@) % يأتي من الدنيا بكل بديعة % % ومن الفضائل في عجيب باكر % % 27(@)(@@) % في وجهه آيات كل فضيلة % % يلقى العفاة ترحبا ببشائر % % 28(@)(@@) % إن الحياة لوفده بيمينه % % وبسيفه قتل العدو الفاجر % % 29(@)(@@) % ذو همة وشجاعة يوم الوغى % % في الحرب يسطو كالعقاب الكاسر % % 30(@)(@@) % من عصبة جمعوا الشجاعة والندى % % نالوا المعالي كابرا عن كابر % % PageV01P237 31(@)(@@) % وإذا أتيت لبابه في حاجة % % أغناك في بذلك العطاء الوافر % % 32(@)(@@) % بسط اليدين على الأنام تكرما % ونوالها مثل السحاب الماطر % % 33(@)(@@) % صدر المؤمل عن موارد بحره % % يروي أحاديث العطا عن جابر % % 34(@)(@@) % متقمص بالمكرمات مؤزر % من رريه في عزة ومفاخر % % 35(@)(@@) % قسما ببارق مرهف في كفه % % حين النزال وبحره المتكاثر % % 36(@)(@@) % لم ألق بين الناس قط مماثلا % لجنابه العالي 
ms77	 ولا بمناظر % % 37(@)(@@) % غوث الصريح إذا دعى لملمة % % في كشفه الأخطار أي مبادر % % 38(@)(@@) % كم زارد نهر النضار ببابه % % من فضله السامي وكم من صادر % % 39(@)(@@) % يا أيها المولى الذي أفضاله % % في عاتقي وثناؤه في ضامري % % 40(@)(@@) % خذها إليك قصيدة من أخرس % % يثناك ينطق في لسان شاكر % % PageV01P238 41(@)(@@) % هنيت بالعيد الجديد ولم تزل % % سعد الكرام ورغم أنف الفاجر % % 42(@)(@@) % لا زلت مسعود الجناب مؤيدا % وعداك في ذل وحال بائر % % PageV01P239 البحر : كامل تام 1(@)(@@) % انظر إلى الأشراف كيف تسود % وإلى أباة الضيم أين تريد % 2(@)(@@) % إذ يدعي بالملك منهو أهله % % والحزم يقضي والسيوف شهود % % 3(@)(@@) % يوم ثوى فيه ثويني في الثرى % % يوم بسالم للبرية عيد % % 4(@)(@@) % ماللذي عبد الصخور من الذي % % عبد الآله ودينه التوحيد % % 5(@)(@@) % قل للذي ذم الإمام بشعره % % قد فاتك المطلوب والمقصود % % 6(@)(@@) % ولقد عميت عن الهدى فيمن له % % نظر بغايات الأمور حديد % % 7(@)(@@) % السيد السند الرفيع مقامه % % ومقامه الممدوح والمحمود % % 8(@)(@@) % أنى تحقر بالفهاهة سيدا % لما تيقظ عزمه من غفلة % 9(@)(@@) % سخط الحسود بما به من سالم % % رضي الال ه الواحد المعبود % % 10(@)(@@) % من لام سالم في أبيه فلزمه % % حمق لعمري ما عليه مزيد % % PageV01P240 11(@)(@@) % ما عق والده ولا صدق الذي % % نسب العقوق إليه وهو جحود % % 12(@)(@@) % وافى تويني في الفراش حمامه % % وأتى عليه يومه الموعود % % 13(@)(@@) % هذا قضاء الله جل جلاله % % لا والد يبقى ولا مولود % % 14(@)(@@) % رأي رأى فيه الإصابة سالم % بالله أقسم إنه لسديد % % 15(@)(@@) % فله يصح الاجتهاد بعلمه % % في شأنه ولغيره التقليد % % 16(@)(@@) % % فيها عقول الجاهلين رقود % % 17(@)(@@) % وأرابه أمر يعم وباله % % وعلى عمان بما يسوء يعود % % 18(@)(@@) % ولي الأمور بنفسه فتصرمت % تلك الحوادث والخطوب السود % % 19(@)(@@) % وأقر هاتيك الممالك بعدما % % كادت تمور بأهلها وتميد % % 20(@)(@@) % ولقد حماها بالصوارم والقنا % % فعمان غيل والرجال أسود % % PageV01P241 21(@)(@@) % لا خير في ملك إذا لك يحمه % % بأس يذوب له الحديد شديد % % 22(@)(@@) % % ماذا يفيد العذل والتفنيد % % 23(@)(@@) % ولقد قضى نحبا أبوه وقد مضى % % ما لامرئ في الكائنات 
ms78	 خلود % % 24(@)(@@) % خير من المفقود عند وفاته % % هذا الإمام السالم الموجود % % 25(@)(@@) % أبقى له الذكر الحميد فصيته % % قد يخلق الأعمار وهو جديد % % 26(@)(@@) % سفها لهندي أراد بنصحه % % غشا وكل مقاله مردود % % 27(@)(@@) % نظم القريض ليستميل قلوبنا % % عنه وذاك من المريد بعيد % % 28(@)(@@) % خفيت على الغبي مقاصد % % فيها وما عرف المرام بليد % % 29(@)(@@) % متوعد الإسلام من أعدائه % % ما ضمنه التقريع والتهديد % % 30(@)(@@) % ليكيد فيها المسلمين بخدعة % % لا يعرف الشيطان كيف يكيد % % PageV01P242 31(@)(@@) % ليست عمان ولا صحار ومسقط % % هندا ولا العرب الكرام هنود % % 32(@)(@@) % لو تقرب الأعداء منها لاصطلت % % نارا لها في الملحدين وقود % % 33(@)(@@) % وإمام مسقط لا يروع جنابه % % عند اللقاء بوارق ورعود % % 34(@)(@@) % قد بايعته على عمان رجاله % % أكرم بهم فهم الرجال الصيد % % 35(@)(@@) % ووراءه ملك الملوك جميعها % % عبد العزيز وظله الممدود % % 36(@)(@@) % ملك يقوم بنصره فتمده % % أنى يشاء عساكر وجنود % % 37(@)(@@) % ووراء ذلك أمة عربية % % الدين فيها والتقى والجود % % 38(@)(@@) % من كان عبد الله من أنصاره % % آل السعود فإنه لسعيد % % 39(@)(@@) % والله خير الناصرين ولم يكن % % إلا لديه النصر والتأكيد % % PageV01P243 البحر : بسيط تام 1(@)(@@) % إن جئت آل سلمى أو مغانيها % % فاحفظ فؤادك واحذر من غوانيها % % 2(@)(@@) % تلك المغاني معاني لائحة % % منها لعينك فاشرح لي معانيها % % 3(@)(@@) % معالم كلما استسقت معاهدها % % وبلا من الدمع بات الوبل يسقيها % % 4(@)(@@) % منازل وقف العاني بها فشكا % % روية كلما نادت بمعجزة % % 5(@)(@@) % واحبس بها الركب أن تقضي حقوق ثرى % على المتيم حق أن يؤديها % % 6(@)(@@) % قف بي أصب بها أشيب دما % فإنما أنا صب الدار عانيها % % 7(@)(@@) % ويلاه من كبد حرى أضر بها % % منع الأحبة شرب الراح من فيها % % 8(@)(@@) % لي مهجة والقدود السمر ما برحت % % تميتها والصبا النجدي يحييها % % 9(@)(@@) % يأتي إليك هواها بالصبا سحوا % فهل عرفت الهوى من أين يأتيها % % 10(@)(@@) % فما لهاتفة تشجي الخلي جوى % وما رماها بسهم البين راميها % % PageV01P244 11(@)(@@) % لله ما فعلت بي في تفننها % % ورقاء في الدوح تششجيني وأشجيها % % 12(@)(@@) % وهيج البرق لما لاح وامضه % % لواعجا في هوى 
ms79	 مي أعانيها % % 13(@)(@@) % فعبرت عبرات الدمع حين جرت % % عن صبوة بت أخفيها وأبديها % % 14(@)(@@) % يا برق سلم على حي بذي سلم % وجز بأحياء ميثاء وحييها % % 15(@)(@@) % حي حياة المعنى في مواصلهم % % كانوا منى النفس لو نالت أمانيها % % 16(@)(@@) % قد طال عهدي بأحباب شغفت بها % % ولا أرى طول هذا العهد ينسيها % % 17(@)(@@) % ما للملامة تغريني ولي أذن % تملها وأرى العذال تمليها % % 18(@)(@@) % يا عاذلي كلما أبصرت حال شج % فخله فهو مشغوف وخليها % % 19(@)(@@) % فلا تعذب أخي اليوم مهجته % % فإن ما لقيت في الحب يكفيها % % 20(@)(@@) % لا تلحني فتزيد القلب صبوته % % وربما جرح العشاق آسيها % % PageV01P245 21(@)(@@) % أقول للبرق إذ لاحت لوامعه % % يحكي تبسم ذات الخال تشبيها % % 22(@)(@@) % بالله كرر أحاديث العذيب فما % % بغيرها غلة الأشواق ترويها % % 23(@)(@@) % وارفق بمهجة مشتاق لقد رديت % % وكلنفس هواها كان مرديتها % % 24(@)(@@) % ويا نسيما سرى من أرض كاظمة % % يروي أحاديث نشر عن روابيها % % 25(@)(@@) % احمل إلى الموصل الحدبا تحيتنا % % واقرا السلام على من قد سما فيها % % 26(@)(@@) % وإنما هو عبد الله عالمها % % ومقتداها ومهديها وهاديها % % 27(@)(@@) % الفاضل الفرد فيهم في فضائله % % لا يستطيع حسود أن يواريها % % 28(@)(@@) % من عصبة برئت من كل منقصة % % من الورى فتعالى الله باريها % % 29(@)(@@) % منهم تبلج صبح الفضل وابتهجت % % رياضه فزها بالحق زاهيها % % 30(@)(@@) % علاهم سقم أكباد الحسود كما % % تشقى صدور المعالي في عواليها % % PageV01P246 31(@)(@@) % فلتفخر الموصل الحدباء إن لكم % % نهاية الفخر قاصيها ودانيها % % 32(@)(@@) % وللفضائل أهل في الورى أبدا % وما برحتم مدى الأيام أهليها % % 33(@)(@@) % صحف البلاغة قد أصبحت ناشرها % % من بعدما كاد هذا الدهر يطويها % % 34(@)(@@) % جزيت عن بني فكر بعثت بها % % إلى محبيك تهديها فتهديها % % 35(@)(@@) % فلو نجازيك عن معشار قيمتها % % جوزيت إذ ذاك بالدنيا وما فيها % % 36(@)(@@) % ما روضة من رياض الحزن باكرها % % غيث فأضحكها إذ بات يبكيها % % 37(@)(@@) % يوما تضرج فيها الورد وجنته % % حتى تبسم من عجب أقاحيها % % 38(@)(@@) % أبهى وأبهج من نظم نظمت به % % زهر الكواكب نظما في قوافيها % % 39(@)(@@) % بيوت فضل حوت من كل نادرة 
ms80	 % % أحكمت في يدك الطولى مبانيها % % 40(@)(@@) % رقت إلى أن تخيلنا النسيم سرى % % منها ولم يسر إلا من نواحيها % % PageV01P247 41(@)(@@) % تملى على السمع أحيانا فتملأه % % لنالئا ومعانيها لئاليها % % 42(@)(@@) % كأنما طلعة الأ مار مطلعها % % والأنجم الزهر أمست من قوافيها % % 43(@)(@@) % كم أسكرتنا ولم نسق كؤوس طلى % وإنما الخمر معنى من معانيها % % 44(@)(@@) % مصوغة من دموع العين صافية % % ما زال ظاهرها يبدو كخافيها % % 45(@)(@@) % من مظهر السحر من بادي رويته % % بصورة الشعر تخييلا وتمويها % % 46(@)(@@) % كم أبهر العين حسنا من سنى كلم % بدا وتورية فيها توريها % % 47(@)(@@) % وكيف نأتي لها يوما بثانية % % وأنت يا واحد الآحاد منشيها % % 48(@)(@@) % لا زلت ما طلعت شمس وما غربت % % مطالعا المجد حاويها % % PageV01P248 البحر : طويل 1(@)(@@) % متى لاح رسم الدار من طلل قفر % % فلي زفرة تذكو ولي عبرة تجري % % 2(@)(@@) % ذكرت الهوى يوما بمنعرج اللوى % % ولا بد للمشتاق فيه إلى الذكر % % 3(@)(@@) % سقى الله عهدا في النعيم وحاجر % % وجاد على أرجائها وابل القطر % % 4(@)(@@) % وحيى بصوب المزن في الحي منزلا % لي العذر فيه من رسيس الهوى العذري % % 5(@)(@@) % وأيامنا اللاتي قضت باجتماعها % % تصبب من عيني ما ليس بالنزر % % 6(@)(@@) % وإني لمطوي الضلوع من الجوى % % على لاعج برح احر من الجمر % % 7(@)(@@) % كأن التهاب البرق يبرز لوعتي % % ويبرز للأبصار ما كان في صدري % % 8(@)(@@) % ولم أدر ما هاج الحمام بنوحه % % فهيج أشجان الفؤاد ولا يدري % % 9(@)(@@) % كأني به يشكو الفراق على النوى % % ولا غاب عن أنف ولا طار عن وكر % % 10(@)(@@) % أحبتنا هل تذكرون لياليا % لنا في الحمى كانت تعد من العمر % % PageV01P249 11(@)(@@) % تطوف علينا الكأس من كف أغيد % % كما ذكر قرن الشمس في راحة البدر % % 12(@)(@@) % تحدثنا عن نار كسرى لعهده % % قديمة عهد بالمعاصير بالعصر % % 13(@)(@@) % فحيى بها أحوى من الغيد أبلج % مذابا من الياقوت تبسم عن در % 14(@)(@@) % وقلت لساقيها وريدك بالحشا % % فقد زدتني بالراح سكرا على سكر % % 15(@)(@@) % بربك هل أبصرت منذ شربتها % % ألذ لطيب العيش من قدح الخمر % % 16(@)(@@) % وندمان صدق تشهد الراح أنهم 