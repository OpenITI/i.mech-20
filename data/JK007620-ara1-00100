ms81	 وما % % أدعي أني أحب الفتنا % % 38(@)(@@) % كيف يهوى الحرب من إن فزتم % لم يكن بالخير منكم قمنا % % 39(@)(@@) % وإذا ضاقت عليكم خطة % عدم المال بها والوطنا % % 40(@)(@@) % ليس في المعقول أن يؤثرها % % غير من إن خفت فيها أمنا % % PageV01P299 41(@)(@@) % فتنبه لمخاريقهم % ما عهدنا منك هذا الوسنا % % 42(@)(@@) % واحمل الناس على حبهم % ليس من دين العلى أن تغبنا % % 43(@)(@@) % إن من أحرز عنكم مذهبا % % غير من أنتم له كل الدنا % % 44(@)(@@) % ليس من يعبد ربا واحدا % مثل من يشرك فيه الوثنا % % PageV01P300 البحر : طويل 1(@)(@@) % خليلي خلينا الصبا وتعاقلنا % % فيا ليت شعري هل يعود كما كنا % % 2(@)(@@) % وهيهات حال الهم دون مراحنا % % وفارقنا شرخ الشباب وفرقنا % % 3(@)(@@) % سقى الله أيام السباحة ريها % % مداما فإن الله قد أرخص المزنا % % 4(@)(@@) % وحيا زمان الأصمعي ونظرة % % إلى الديلمي غادرت بيننا ضغنا % % 5(@)(@@) % وليلتنا بالبرج من حصن صمع % % رعى الله ذاك الليل والبرج والحصنا % % 6(@)(@@) % وحرب أبي عمرو ودار ابن ثعلب % فكم قد علمنا في الجنون بها فنا % % 7(@)(@@) % وليلا قصرنا بالقريطي طوله % إذا شدد الميمات في شدوه صحنا % % 8(@)(@@) % وقول علي للنيام تعرفا % % على الجسد المقرور والمقلة الوسنا % % 9(@)(@@) % معاهد أتراب الصبا وملاعب % % أجد لنا ذكر السرور بها حزنا % % 10(@)(@@) % ليالي لا نخشى من الترك غارة % ولا نبتغي في وصل أحبابنا إذنا % % PageV01P301 11(@)(@@) % نبيت نشاوى ما شربنا مدامة % ونغدو إلى خلع العذار كما كنا % % 12(@)(@@) % وكم ملح وافى الينا يردنا % % فلما أبينا أن نروح مضى عنا % % 13(@)(@@) % أحاديث أما لفظها فهو واضح % جلي ولكن قل من يفهم المعنى % % 14(@)(@@) % ومستخبر عنا أجبنا سؤاله % بعجماء لا علما أفادت ولا ظنا % % 15(@)(@@) % أتانا فسمينا له الأمر ناسقا % فأنبس في إبهامه وتلذذنا % % 16(@)(@@) % يفسرها للقوم كل ملذذ % تواحشت الأيام في بعده عنا % % 17(@)(@@) % ذكرنا بها أحبابنا فتناثرت % مدامع لا يتركن عينا ولا جفنا % % 18(@)(@@) % مضوا وبقينا للشقاوة بعدهم % نزور ديارا ما نحب لها مغنى % % PageV01P302 البحر : خفيف تام 1(@)(@@) % يا نديمي على الهموم ويا حا % % مل عني في الدهر 
ms82	 خوفا وأمنا % % 2(@)(@@) % كم رعينا الخطوب حلوا ومرا % وقطعنا الزمان سهلا وحزنا % % 3(@)(@@) % ورمتنا صروفه بهنات % هن أمضى من الأسنة طعنا % % 4(@)(@@) % وعبوس فإن تبسم كأن اللؤم % من ذلك التبسم يجنى % % 5(@)(@@) % رب عين إلى الدنية شزرا % ء وأخرى عن المكارم وسنا % % PageV01P303 البحر : كامل تام 1(@)(@@) % % فمتى تجود بها على أجفانها % % 2(@)(@@) % لك كل يوم غضبة مضرية % تدني بها الآجال قبل أوانها % % 3(@)(@@) % تجري بطاعتك الخطوب فإن عصت % يوما فقد عرفت مدى عصيانها % % 4(@)(@@) % ما ينكر الإسلام أن ثغروه % عزت وسمر قناك من أركانها % % 5(@)(@@) % أدبت صرف الدهر فيها بعدما % % جمحت حوادثه على سكانها % % 6(@)(@@) % وصددته عن نهجها فكأنما % % وقفت لك الأفلاك عن دورانها % % 7(@)(@@) % إن أظهرت لعلاك أنطاكية % حزنا فقد ضحكت على قطانها % % 8(@)(@@) % بعث البريد مخبرا عن وثبة % ما كان أحوجه إلى كتمانها % % 9(@)(@@) % لما أظل له لواؤك خافقا % عرفت وجوه الذل في صلبانها % % 10(@)(@@) % إن عاد نحوك جانب من كيده % قامت لك الخطباء في قسانها % % PageV01P304 البحر : خفيف تام 1(@)(@@) % أتظن الورق في الأيك تغني % % إنما تضمر حزنا مثل حزني % % 2(@)(@@) % لا أراك الله نجدا بعدها % % أيها الحادي بنا إن لم تجبني % % 3(@)(@@) % هل تباريني إلى بث الجوى % % في ديار الحي نشوى ذات غصن % 4(@)(@@) % هب لنا السبق ولكن زادنا % % أننا نبكي عليها وتغني % % 5(@)(@@) % يا زمان الخيف هل من عودة % يسمح الدهر بها من بعد ضن % 6(@)(@@) % أرضينا بثنيات اللوى % % عن زورد يا لها صفقة غبن % 7(@)(@@) % سل أراك الجزع هل جادت به % % 8(@)(@@) % وأحاديث الغضا هل علمت % أنها تملك قلبي قبل أذني % % 9(@)(@@) % لست أرتاع لخطب نازل % إنما الخوف لقلب مطمئن % 10(@)(@@) % وكريم القوم لا أسأله % فلماذا يعرض الباخل عني % % PageV01P305 11(@)(@@) % قد رضينا بإباء عن غنى % % ويعز اليأس عن ذل التمني % % 12(@)(@@) % صاحب الدهر قليلا تعترف % فيه بالسجلين من سهل وحزن % 13(@)(@@) % يخبر الصاحب عن إخوانه % فاسأل الصارم ما يعرف مني % % 14(@)(@@) % وذلل موعد لي بالردى % % إنما يطمع أن يحسب قرني % % 15(@)(@@) % نم على ضلعك ما 
ms83	 رعت بها % % إنما قعقعت للطود بشن % 16(@)(@@) % لست أرضاك لحربي فاحترز % بزمام الهون من ضربي وطعني % % 17(@)(@@) % ميسم يشهر قدرا خاملا % أنت من لذعته في شر أمن % 18(@)(@@) % كن مع الأيام ألبا إنما % % صلت في الدهر بكف لم تنلني % % 19(@)(@@) % بعزيز الدولة امتدت يدي % % فعلى فرع السها أسحب ردني % % 20(@)(@@) % سل صروف الدهر عني عنده % أي آباء وفي أي مجن % PageV01P306 21(@)(@@) % قادني بعد شماس بشره % لو بغاني بسواه لم يقدني % % 22(@)(@@) % سبق الناس إليها صفقة % لم يعد رائدها عني بغبن % 23(@)(@@) % قصرت آمالنا عن جوده % فعليه لا على الآمال نثني % % 24(@)(@@) % لا تلوموه على إقتاره % يهدم المترب والمنفض يبني % % 25(@)(@@) % فكأن المال آلى حلفة % لأهينن بخيلا لم يهني % % 26(@)(@@) % من كرام أدب الدهر بهم % بعد ما كان على الأحرار يجني % % 27(@)(@@) % نقلوا سمر القنا يوم الوغى % % بسياط مثلها في الطعن لدن % 28(@)(@@) % كل مياس جرت أعطافه % وعواليه على الحكم التثني % % 29(@)(@@) % هزة للجود صارت نشوة % % لم يكدر عندها العرف بمن % 30(@)(@@) % طلبوا الشأو فوافى سابقا % جذع غبر في وجه المسن % PageV01P307 31(@)(@@) % صيغ للفضل مثالا شخصه % إنما مادحه للفضل يعني % % 32(@)(@@) % % ريحك النكباؤ يا دهر بركني % % 33(@)(@@) % يا ابن فخر الملك فخرا إنه % نسب يقنع في المجد ويغني % % 34(@)(@@) % قدت مدحي بعد ما كانت به % % عزة السرين من صدري وجفني % % 35(@)(@@) % وأبى دون لئام تبعوا % % سنة الأيام في بخل وجبن % 36(@)(@@) % % لمعة الخلب في المحل المبن % 37(@)(@@) % يتبع الجود إذا ما غلطت % كفه بالجود يوما قرع سن % 38(@)(@@) % من بني الدهر لهم من لؤمه % نسب ألحق فيه الأب بابن % 39(@)(@@) % بذلك المعروف مع بخلهم % منظر ما شئت من قبح وحسن % 40(@)(@@) % صرفت عنك الليالي ناظرا % لم يزل يرنو إلى الفضل بضغن % PageV01P308 41(@)(@@) % وسمت بي أن يرامى جانبي % % برعاديد من الأقوام لكن % PageV01P309 البحر : سريع 1(@)(@@) % لا تعذل القلب على وجده % قد ضل عن منهج سلوانه % 2(@)(@@) % لم أر ربعا مثله وافيا % فارقته في إثر سكانه % PageV01P310 البحر : مجزوء الكامل 1(@)(@@) % يا نازحا حكمت 
ms84	 عل % ي ببعده نوب الزمان % 2(@)(@@) % من لي بقرب الدار % ك ولا أراك ولا تراني % % 3(@)(@@) % ما كنت أحسب أنني % % أرضى بهجرك في الأماني % % PageV01P311 البحر : وافر تام 1(@)(@@) % ودوح مالت الأغصان منه % فخلت مميلها وسن العيون % 2(@)(@@) % كأني إذا نبذت النوم فيه % تعلق بالذوائب والغصون % PageV01P312 البحر : متقارب تام 1(@)(@@) % فؤاد يهيم بذكر الوطن % ودمع يعيد رسوم الدمن % 2(@)(@@) % وليل كما علم الساهرون % أسير الصباح عصي الوسن % 3(@)(@@) % وحي نزلت به في الصبا % % وما كنت أعرف بعد الوطن % 4(@)(@@) % أعق خليلي فيه القديم % وأغدر إخواني المؤتمن % 5(@)(@@) % وفقد أناس أعد الحياة % ة بعدهم من تمام المحن % 6(@)(@@) % ففي أي نهج أروم السرور % ومن أي وجه أصد الحزن % 7(@)(@@) % ولي نظرة تستمد الغرام % وقلب له كل يوم شجن % 8(@)(@@) % وبرح من الحب أخفيته % فقد أكثر الناس فيه الظنن % 9(@)(@@) % وقال الوشاة سمعنا به % فقلت صدقتم ولكن بمن % 10(@)(@@) % وهل عندكم غير أني أهيم % بشكوى الصبابة في كل فن % PageV01P313 11(@)(@@) % وأذكر بيضاء من عامر % وكم من بني عامر في اليمن % 12(@)(@@) % خليلي قد عاد قلبي إلي % وقرت بلابله وأطمأن % 13(@)(@@) % وما زلت أزهد في من عرفت % حتى سكنت لفقد السكن % 14(@)(@@) % فلله حر أبي القياد % على القادرين خليع الرسن % 15(@)(@@) % ونفس تعاف جزيل الغنى % % إذا كان فيه قليل المنن % 16(@)(@@) % وكيف أضام ولي ناصران % ن ذو الحسبين وهذا اللسن % 17(@)(@@) % حسامان ما لهما نبوة % % ولا يتقى منهمأ بالجنن % 18(@)(@@) % رعى الله من تيمته العلى % % فهام إلى وصلها وافتتن % 19(@)(@@) % وما نال عفوا جميل الثناء % % ولكن شراه بأغلى الثمن % 20(@)(@@) % يدل على جوده بشره % وما لمع الغيث إلا هتن % PageV01P314 21(@)(@@) % منيع الجوار رفيع المنار % مريع الديار وسيع العطن % 22(@)(@@) % تلوح له خافيات الغيوب % فسر القضاء لديه علن % 23(@)(@@) % إذأ أخصبت بنداه البلاد % فما شاءت السحب فلتفعلن % 24(@)(@@) % وسيفك في هضبات العيون % بدائد ما حسبت أن تشن % 25(@)(@@) % % ن علم قومك ضرب القنن % 26(@)(@@) % وقد علمت حلب أنه % بصير بأدوائها في الفتن % 27(@)(@@) % ولولاك كانت 
ms85	 على عادها % % مروعة كل يوم بفن % 28(@)(@@) % وكم حاسد رامها بالمنى % % وماذا عليها ولهو الثمن % 29(@)(@@) % أتاها يشيم بروق الجهام % م في عارض مخلف كل ظن % 30(@)(@@) % فلما طلعت بملمومة % يلم بها وهج كالدخن % PageV01P315 31(@)(@@) % تبرأ من كاذبات الظنون % وحمل أجماله للظعن % 32(@)(@@) % تخير أبا رافع للجوا % % ر إما عقيلا وإما قطن % 33(@)(@@) % ونم في بيوتهم وادعا % فما لك إلا عناء معن % 34(@)(@@) % وما عز حلم ابن نصر عليك % ولا غاض عنك نداه وضن % 35(@)(@@) % ولكن سننت عقوق الكرام % % فقد تبعوا فيك تلك السنن % 36(@)(@@) % بقيت فكم لك عندي يدا % ومنا بعثت به بعد من % 37(@)(@@) % توالى إلي بلا شافع % وأغنى الفرات يدا عن شطن % 38(@)(@@) % مواهب إن كنت أخفيتهن % فإني بهن كثير التفن % 39(@)(@@) % وإن كان مدحي بها سائرا % فرقي بها علق مرتهن % 40(@)(@@) % قنعت زمانا ولكنني % % فطنت لجودك فيمن فطن % PageV01P316 41(@)(@@) % وأهديت من زفرات الحنين % إليك وما كل من حن حن % 42(@)(@@) % شوارد في كل صدر لها % % مناخ وفي كل سمع سنن % 43(@)(@@) % لزمت بها الفتح قبل الروي % وما أوجب النظم أن يلزمن % 44(@)(@@) % أتتك تجدد عهد الثناء % وتظهر عن هائم ما أجن % 45(@)(@@) % وما كل من حسنت عنده % أياديك جاء بشكر حسن % 46(@)(@@) % ومن كان فيك حديث الهوى % % فإني غذيت به في اللبن % 47(@)(@@) % ولست أريد سوى أن أراك % وهل تسمع المدح إن لم ترن % 48(@)(@@) % ومثلك من جمعت لي يداه % ه بين الثراء وبين الوطن % PageV01P317 البحر : متقارب تام 1(@)(@@) % إذا حدت الريح عيس الحيا % % وهتك بالبرق ستر الدجا % % 2(@)(@@) % وظل يفوق جو الرياض % ويصقلها بنسيم الصبا % % 3(@)(@@) % فمنطق منها خصور الوهاد % وتوج منها رؤس الربا % % 4(@)(@@) % وقبل فيها ثغور الأقاح % % مداعبة لخدود المها % % 5(@)(@@) % فجلى الغوير بأوضاحه % ونجده برقه المنتضى % % 6(@)(@@) % وزار عذيبة زور الخيا % % يعثر بين فروج الكرى % % 7(@)(@@) % فراح على تربها باكيا % % بجفن الرياض ودمع الندى % % 8(@)(@@) % وأصبح رائدنا بعده % يقبل أجراعها والثرى % % 9(@)(@@) % كأن ابن نصر همى كفه % عليها فأخجل صوب الحيا % % 10 
ms86	(@)(@@) % فتى جاد بالمال قبل السؤال % وعاجل بالبشر قبل المنى % % PageV01P318 11(@)(@@) % وقادت مواهبه الطالبين % فأنضى المطي وسد الفلا % % 12(@)(@@) % كأن له غفلات الزمان % يجود بهن وعصر الصبا % % 13(@)(@@) % إذا ما ذكرناه خلنا المطي % عرفن مكارمه والعلا % % 14(@)(@@) % فهن صواد إلى قربه % تسابق انساعها والبرى % % 15(@)(@@) % من القوم إن خطروا للنوال % رأيت الردى في نحور الثرى % % 16(@)(@@) % تدل صوارمهم في الصباح % على نار ليلهم للقرى % % 17(@)(@@) % لهم كل أجرد ملء العنان % رحيب اللبان سليم الشظا % % 18(@)(@@) % تميل بأعطافه هزة % تعرض بالبرق لما جرى % % 19(@)(@@) % ونازعه الليل أوضاحه % فقبله الصبح لما نجا % % 20(@)(@@) % ويأنف من عزه أن يذل % بغير وجوههم في السرى % % PageV01P319 21(@)(@@) % فيا عز دولتهم قدهم % فإن الأباطح دون الذرى % % 22(@)(@@) % يشكو إلى راحتيك الصدى % % وثلم بالضرب بيض الظبا % % 23(@)(@@) % ونل بالمعز علي الأمور % كما تبع البدو شمس الضحى % % 24(@)(@@) % فلو هرب البدر من خوفه % ومال على صوبه ما اهتدى % % 25(@)(@@) % أليس أبوك أبا كامل % فهل فوقه للعلا منتهى % % 26(@)(@@) % فتى وجد العز حيث الحمام % ومن دوحة المجد يجني الردى % % 27(@)(@@) % وجاوده الغيث جهلا به % فلما رأى جوده ما همى % % 28(@)(@@) % سقاه نداك إذا ما العفاة % ملأن إليك فروج الملا % 29(@)(@@) % فكم موقف مثل حد الحسام % يغض به الجو سمر القنا % % 30(@)(@@) % تلقى السنان به خاسرا % كأن عليه قلوب العدى % % PageV01P320 31(@)(@@) % وقد غنت البيض في نقعة % فما شرب الرمح حتى انتشى % % 34(@)(@@) % مدحتك أخطب منك الوداد % إذا حاول القوم منك الغنى % % 35(@)(@@) % ولي في فخاركم شعبة % % وفي الأفق بدر الدجا والسها % % 36(@)(@@) % إذا عامر فرعت في العلا % % ولم يبق من فوقها مرتقى % % 37(@)(@@) % علقت بأطراف ذاك النجار % وحلت بعادي ذاك الينا % % 38(@)(@@) % وقور إذا طرقتني الخطوب % وحل من الخوف عقد النهى % % 39(@)(@@) % بعشرين أنفقتها في الصدود % وجدت بها في زمان النوى % % 40(@)(@@) % وإني على شغفي بالقريض % لأذخره عن جميع الورى % % 41(@)(@@) % ولكن حبك نادى به % ولم يزل المرء طوع الهوى % % 42(@)(@@) % وقد جل قدرك عن نظمه % ولكنها سنة تقتفى % % PageV01P321 البحر : متقارب تام 
ms87	 1(@)(@@) % سرينا إلى الملك الدوفنيي % ولكننا ما حمدنا السرى % % 2(@)(@@) % فأنزلنا الدهر في منزل % كثير الهموم قليل الكرى % % 3(@)(@@) % نظل مع الروم فيه فما % % نعاشر إلا كلاب الورى % % 4(@)(@@) % طوال القرون قصار النفو % % فوق الثريا وتحت الثرى % % 5(@)(@@) % مجاهيل ما فطنوا بالسماح % ولا سمعوا بحديث القرى % % 6(@)(@@) % بلى عند ضيفهم ما يريد % ولكن لعمري إذا ما اشترى % % 7(@)(@@) % وإن كان عندهم ثاويا % فما تتعدد دور الكرى % % PageV01P322 البحر : مجزوء الكامل 1(@)(@@) % يا منفذا ماء الجفون % وكنت أنفقه عليه % 2(@)(@@) % إن لم تكن عيني فأنت % ت أعز من نظرت إليه % PageV01P323 
ms88	