ms1705	 فيه نوره ، وأما القلب الأغلف فقلب الكافر ، وأما القلب المنكوس فقلب المنافق عرف ثم أنكر ، وأما القلب المصفح فقلب فيه إيمان ونفاق ، ومثل الإيمان فيه كمثل البقلة يمدها الماء الطيب ، ومثل النفاق فيه كمثل القرحة يمدها القيح والدم ، فأي المدتين غلبت على الأخرى غلبت عليه ) )(@)(@@) ( حم طس ) عن أبي سعيد وصحح ( ش ) عن حذيفة موقوفا ابن أبي حاتم عن سلمان موقوفا .(@)(@@)(@@)(@@) $ ( 15531 ) قال النبي :(@)(@@) | 30 ( القنطار مائة رطل ، والرطل اثنتا عشر أوقية ، والأوقية سبعة دنانير ، والدينار أربعة وعشرون قيراطا ) )(@)(@@) الديلمي عن جابر وفيه الخليل بن مرة .(@)(@@)(@@)(@@) $ ( 15532 ) قال النبي :(@)(@@) | 30 ( القود بالسيف والخطأ على العاقلة ) )(@)(@@) ( قط ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15533 ) قال النبي :(@)(@@) | 30 ( القلوب أوعية وبعضها أوعى من بعض ، فإذا سألتم الله عز وجل فاسألوه وأنتم موقنون بالإجابة ، فإن الله عز وجل لا يستجيب لعبد دعاه عن ظهر قلب غافل ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV05P390(@)(@@)(@@)(@@) || ( حرف الكاف )(@)(@@)(@@)(@@) ||| ( الكاف مع الألف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 15534 ) قال النبي :(@)(@@) | 30 ( كاتم العلم يلعنه كل شيء حتى الحوت في البحر ، والطير في السماء ) )(@)(@@) ابن الجوزي في العلل ، عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15535 ) قال النبي :(@)(@@) | 30 ( كاد الحكيم أن يكون نبيا ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15536 ) قال النبي :(@)(@@) | 30 ( كاد الفقر أن يكون كفرا ، وكاد الحسد أن يكون سبق القدر ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15537 ) قال النبي :(@)(@@) | 30 ( كادت النميمة أن تكون سحرا ) )(@)(@@) ابن لال ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15538 ) قال النبي :(@)(@@) | 30 ( كافل اليتيم له أو لغيره ، أنا وهو كهاتين في الجنة ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15539 ) قال النبي :(@)(@@) | 30 ( كان الحجر الأسود أشد بياضا من الثلج حتى سودته خطايا بني آدم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV05P391(@)(@@)(@@)(@@) $ ( 15540 ) قال النبي :(@)(@@) | 30 ( كان الرجل قبلكم يؤخذ فيحفر له في الأرض فيجعل فيه فيجاء بالمنشار فيوضع على رأسه فيشق باثنتين ما يصده ذالك عن دينه ، ويمشط بأمشاط الحديد 
ms1706	 ما دون لحمه من عظم أو عصب ما يصده ذالك عن دينه ، والله ليتمن الله هاذا الأمر حتى يسير الراكب من صنعاء إلى حضرموت لا يخاف إلا الله والذئب على غنمه ، ولاكنكم تستعجلون ) )(@)(@@) ( حم خ د ن ) عن خباب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15541 ) قال النبي :(@)(@@) | 30 ( كان الكفل من بني إسرائيل لا يتورع عن ذنب عمله ، فأتته امرأة فأعطاها ستين دينارا على أن يطأها ، فلما قعد منها مقعد الرجل من امرأته أرعدت وبكت فقال : ما يبكيك أأكرهتك قالت : لا ، ولاكنه عمل ما عملته قط ، وما حملني عليه إلا الحاجة ، فقال : تفعلين أنت هاذا وما فعلته ، اذهبي فهي لك ، وقال : والله لا أعصي الله بعدها أبدا ، فمات من ليلته ، فأصبح مكتوب على بابه : إن الله قد غفر للكفل ) )(@)(@@) ( حم ت حب ك ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 15542 ) قال النبي :(@)(@@) | 30 ( كان الناس يعودون داود يظنون أن به مرضا وما به إلا شدة الخوف من الله تعالى ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15543 ) قال النبي :(@)(@@) | 30 ( كان أول من أضاف الضيف إبراهيم ) )(@)(@@) ابن أبي الدنيا في قرى الضيف عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15544 ) قال النبي :(@)(@@) | 30 ( كان أهل الجاهلية يقولون : إنما الطيرة في المرأة والدابة والدار ) )(@)(@@) ( ك هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 15545 ) قال النبي :(@)(@@) | 30 ( كان أيوب أحلم الناس ، وأصبر الناس ، PageV05P392 وأكظمهم للغيظ ) )(@)(@@) الحكيم عن ابن أبزى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15546 ) قال النبي :(@)(@@) | 30 ( كان داود أعبد البشر ) )(@)(@@) ( ت ك ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15547 ) قال النبي :(@)(@@) | 30 ( كان داود يقول : اللهم إني أسألك حبك ، وحب من يحبك ، والعمل الذي يبلغني حبك ، اللهم اجعل حبك أحب إلي من نفسي وأهلي ، ومن الماء البارد ) )(@)(@@) ( ت ك ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15548 ) قال النبي :(@)(@@) | 30 ( كان رجل يداين الناس ، فكان يقول لفتاه : إذا أتيت معسرا فتجاوز عنه لعل الله أن يتجاوز عنا ، فلقي الله فتجاوز عنه ) )(@)(@@) ( حم 
ms1707	 ق ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15549 ) قال النبي :(@)(@@) | 30 ( كان رجلان في بني إسرائيل متواخيان ، وكان أحدهما مذنب ، والآخر مجتهد في العبادة ، وكان لا يزال المجتهد يرى الآخر على الذنب فيقول : أقصر ، فوجده يوما على ذنب فقال له : أقصر ، فقال : خلني ورب ، أبعثت علي رقيبا ، فقال : والله لا يغفر الله لك ، أو لا يدخلك الله الجنة ، فقبض روحهما ، فاجتمعا عند رب العالمين ، فقال لهاذا المجتهد : أكنت بي عالما ، أو كنت على ما في يدي قادرا ؟ وقال للمذنب : اذهب فادخل الجنة برحمتي ، وقال للآخر : اذهبوا به إلى النار ) )(@)(@@) ( حم د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15550 ) قال النبي :(@)(@@) | 30 ( كان زكريا نجارا ) )(@)(@@) ( حم م ه ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P393(@)(@@)(@@)(@@) $ ( 15551 ) قال النبي :(@)(@@) | 30 ( كان عاشوراء يوما يصومه أهل الجاهلية ، فمن أحب منكم أن يصومه فليصمه ، ومن كرهه فليدعه ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 15552 ) قال النبي :(@)(@@) | 30 ( كان على الطريق غصن شجرة يؤذي الناس فأماطها رجل فأدخل الجنة ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15553 ) قال النبي :(@)(@@) | 30 ( كان على موسى يوم كلمه ربه كساء صوف ، وجبة صوف ، وكمة صوف ، وسراويل صوف ، وكانت نعلاه من جلد حمار ميت ) )(@)(@@) ( ت ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15554 ) قال النبي :(@)(@@) | 30 ( كان في بني إسرائيل رجل قتل تسعة وتسعين إنسانا ، ثم خرج يسأل ، فأتى راهبا فسأله ، فقال له : ألي توبة ؟ قال : لا ، فقتله ، فجعل يسأل ، فقال له رجل : ائت قرية كذا وكذا ، فأدركه الموت ، فنأى بصدره نحوها ، فاختصمت فيه ملائكة الرحمة وملائكة العذاب ، فأوحى الله إلى هاذه أن تقربي ، وأوحى إلى هاذه أن تباعدي ، وقال : قيسوا ما بينهما ، فوجداه إلى هاذه أقرب بشبر ، فغفر له ) )(@)(@@) ( ق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15555 ) قال النبي :(@)(@@) | 30 ( كان لكم يومان تلعبون فيهما ، وقد أبدلكم الله بهما خيرا منهما : يوم الفطر ، ويوم الأضحى ) )(@)(@@) ( ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15556 ) قال النبي :(@)(@@) | 30 
ms1708	 ( كان ملك فيمن كان قبلكم ، وكان له ساحر ، فلما كبر ، قال للملك : إني قد كبرت فابعث إلي غلاما أعلمه السحر ، فبعث إليه غلاما يعلمه ، فكان في طريقه إذا سلك راهب ، فقعد إليه وسمع كلامه فأعجبه ، فكان إذا أتى PageV05P394 الساحر مر بالراهب وقعد إليه ، فإذا أتى الساحر ضربه ، فشكى ذالك إلى الراهب ، فقال : إذا جئت الساحر فقل : حبسني أهلي ، وإذا جئت أهلك فقل : حبسني الساحر ، فبينما هو كذالك إذ أتى دابة عظيمة قد حبست الناس ، فقال اليوم أعلم : الساحر أفضل أم الراهب ؟ فأخذ حجرا ، فقال : اللهم إن كان أمر الراهب أحب إليك من أمر الساحر فاقتل هاذه الدابة حتى يمضي الناس ، فرماها فقتلها ومضى الناس ، فأتى الراهب فأخبره ، فقال له الراهب : أي بني ، أنت اليوم أفضل مني ، قد بلغ من أمرك ما أرى ، وإنك ستبتلى فلا تدل علي ، وكان الغلام يبرىء الأكمة والأبرص ويداوي الناس من سائر الأدواء ، فسمع جليس للملك كان قد عمي ، فأتاه بهدايا كثيرة ، فقال : ما هاهنا لك أجمع أجمع إن أنت شفيتني ، قال : إني لا أشفي أحدا إنما يشفي الله عز وجل ، فإن آمنت بالله دعوت الله فشفاك ، فآمن بالله فشفاه الله ، فأتى الملك فجلس إليه كما كان يجلس ، فقال له الملك : من رد عليك بصرك ؟ قال : ربي ، قال : ولك رب غيري ؟ قال : ربي وربك الله ، فأخذه فلم يزل يعذبه حتى دل على الغلام ، فجيء بالغلام ، فقال له الملك : أي بني قد بلغ من سحرك ما يبرىء الأكمة والأبرص ، وتفعل وتفعل ، فقال : إني لا أشفي أحدا إنما يشفي الله عز وجل ، فأخذه فلم يزل يعذبه حتى دل على الراهب ، فجيء بالراهب ، فقيل له : ارجع عن دينك ، فأبى ، فدعا بالمنشار ، فوضع المنشار على مفرق رأسه فشقه به حتى وقع شقاه ، ثم جيء بجليس الملك فقيل له : ارجع عن دينك ، فأبى ، فوضع المنشار في مفرق رأسه فشقه ، حتى وقع شقاه ، ثم جيء بالغلام فقيل له : ارجع عن دينك فأبى ، فدفعه إلى نفر من أصحابه فقال : اذهبوا به إلى جبل 
ms1709	 كذا وكذا فاصعدوا به الجبل ، فإذا بلغتم به ذروته ، فإن رجع عن دينه وإلا فاطرحوه ، فذهبوا به فصعدوا به الجبل ، فقال : اللهم اكفنيهم بما شئت ، وجاء يمشي إلى الملك ، فقال له الملك : ما فعل PageV05P395 أصحابك ؟ فقال : كفانيهم الله ، فقال للملك : إنك لست بقاتلي حتى تفعل ما آمرك به ؟ قال : وما هو ؟ قال : تجمع الناس في صعيد واحد ، وتصلبني على جذع ، ثم خذ سهما من كنانتي ، ثم ضع السهم في كبد القوس ، ثم قل : بسم الله رب الغلام ، ثم ارم ، فإنك إذا فعلت ذالك قتلتني ، فجمع الناس في صعيد واحد وصلبه على جذع ، ثم أخذ سهما من كنانته ، ثم وضع السهم في كبد القوس ، ثم قال : بسم الله رب الغلام ، ثم رماه ، فوقع السهم في صدغه ، فوضع يده في صدغه موضع السهم فمات ، فقال الناس : آمنا برب الغلام ، آمنا برب الغلام ، آمنا برب الغلام ، فأتي الملك فقيل له : أرأيت ما كنت تحذر ، قد والله نزل بك حذرك ، قد آمن الناس ؛ فأمر بالأخدود بأفواه السكك فخدت وأضرم النيران ، وقال : من لم يرجع عن دينه فأقحموه فيها ، ففعلوا ، حتى جاءت امرأة ومعها صبي لها ، فتقاعست أن تقع فيها ، فقال لها الغلام : يا أمه اصبري ، فإنك على الحق ) )(@)(@@) ( حم م ) عن صهيب رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15557 - قال النبي صلى الله عليه وسلم : ' كان نبي من الأنبياء يخط ، فمن وافق خطه فذاك ' | ( حم م د ن ) عن معاوية بن الحكم رضي الله عنه . |(@)(@@)(@@)(@@) $ 15558 - قال النبي صلى الله عليه وسلم : ' كان هذا الأمر في حمير فنزعه الله منهم ، وجعله | في قريش ، وسيعود إليهم ' ( حم طب ) عن ذي مخمر رضي الله عنه . |(@)(@@)(@@)(@@) $ 15559 - قال النبي صلى الله عليه وسلم : ' كان يقال : إن مما أدرك الناس من كلام النبوة | الأولى : إذا لم تستحي فاصنع ما شئت ' ( طس ) عن أبي الطفيل رضي الله | عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15560 - قال النبي صلى الله عليه وسلم : ' كانت امرأة من بني إسرائيل قصيرة تمشي مع | امرأتين طويلتين فاتخذت رجلين من خشب ، وخاتما 
ms1710	 من ذهب مغلق مطبق ، ثم | PageV05P396 | حشته مسكا ، وهو أطيب الطيب ، فمرت بين المرأتين فلم يعرفوها ، فقالت بيدها | هكذا ، ونفض شعبة يده ' ( م ) عن أبي سعيد رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15561 - قال النبي صلى الله عليه وسلم : ' كانت امرأتان معهما ابناهما جاء الذئب فذهب بابن | إحداهما ، فقالت صاحبتها : إنما ذهب بابنك ، وقالت الأخرى : إنما ذهب | بابنك ، فتحاكمتا إلى داود فقضى به للكبرى ، فخرجتا على سليمان بن داود | فأخبرتاه بذلك ، فقال : ائتوني بالسكين أشقه بينهما ، فقالت الصغرى : لا تفعل | يرحمك الله هو ابنها ، فقضى به للصغرى ' ( حم ق ن ) عن أبي هريرة رضي الله | عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15562 - قال النبي صلى الله عليه وسلم : ' كانت بنو إسرائيل تسوسهم الأنبياء ، كلما هلك نبي | خلفه نبي ، وإنه لا نبي بعدي ، وسيكون خلفاء فيكثرون ، قالوا : فما تأمرنا ، | قال : فوابيعة الأول فالأول وأعطوهم حقهم الذي جعله الله لهم ، فإن الله سائلهم | عما استرعاهم ' ( حم ق ه ) عن أبي هريرة رضي الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 15563 - قال النبي صلى الله عليه وسلم : ' كانت بنو إسرائيل يغتسلون عراة ينظر بعضهم إلى | بعض ، وكان موسى عليه السلام يغتسل وحده ، فقالوا : والله ما يمنع موسى أن | يغتسل معنا إلا أنه آدر ، فذهب مرة يغتسل ، فوضع ثوبه على حجر ، ففر الحجر | بثوبه ، فجمع موسى في أثره يقول : ثوبي يا حجر ، ثوبي يا حجر ، حتى نظرت | بنو إسرائيل إلى موسى ، فقالوا : والله ما بموسى من بأس ، وأخذ ثوبه فطفق | بالحجر ضربا ' ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) . | PageV05P397 |(@)(@@)(@@)(@@) $ 1564 - قال النبي صلى الله عليه وسلم : ' كانت سيما الملائكة يوم بدر عمائم سود ، ويوم | أحد عمائم حمر ' ( طب ) وابن مردويه عن ابن عباس رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 1565 - قال النبي صلى الله عليه وسلم : ' كأن الخلق لم يسمعوا القرآن حين يسمعونه من | الرحمن يتلوه عليهم يوم القيامة ' ( فر ) عن أبي هريرة رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15566 - قال النبي صلى الله عليه وسلم : ' كأن الناس لم يسمعوا القرآن حين يتلوه الله عليهم | في الجنة 
ms1711	 ' السجزي في الإبانة عن أنس رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15567 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى خضرة لحم زيد في أسنانكم ' | ( ك ) عن زيد بن ثابت رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 15568 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى موسى في هذه الوادي محرما بين | قطوانتين ' ( طب ) عن ابن مسعود رضي الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 15569 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إليه أسود أفحج ينقضها حجرا حجرا - | يعني الكعبة - ' ( حم خ ) عن ابن عباس رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 15570 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى يونس على ناقة خطامها ليف ، | وعليه جبة من صوف ، وهو يقول : لبيك اللهم لبيك ' ( ك ) عن ابن عباس رضي | الله عنهما ( ز ) |(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 15571 - قال النبي صلى الله عليه وسلم : ' كأنكم براكب قد أتاكم فنزل فقال : الأرض | أرضنا ، والمصر مصرنا ، والفيء فيئنا وإنما أنتم عبيدنا ، فحال بين الأرامل | PageV05P398 | واليتامى وما أفاء الله عليهم ' ابن النجار عن حذيفة رضي الله عنه . |(@)(@@)(@@)(@@) $ 15572 - قال النبي صلى الله عليه وسلم : ' كأنهن الياقوت والمرجان ، ينظر إلى وجهه في | خدها أصفى من المرآة ، وإن أدنى لؤلؤة عليها لتضيء ما بين المشرق والمغرب ، وإنها تكون عليها سبعون ثوبا ينفذها بصره حتى يرى مخ ساقها من وراء ذلك ' ( ك ) | عن أبي سعيد رضي الله عنه . |(@)(@@)(@@)(@@) $ 15573 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى يونس بن متى عليه عباءتان قطوانيتان | يلبي ، تجيبه الجبال والله عز وجل يقول له : لبيك يا يونس ، هذا أنا معك ' ( قط ) | في الأفراد عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 15574 - قال النبي صلى الله عليه وسلم : ' كأني بنساء بني فهر يطفن بالخزرج ، تصطفق | إلياتهن مشركات ' ( حم ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 15575 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى تدافع أمتي بين الحوض | والمقام ، فيلقى الرجل الرجل فيقول : يا فلان أشربت ؟ فيقول : نعم ، ويلقى | الآخر فيقول له : لا صرف وجهي فما قدرت 
ms1712	 أن أشرب ' الحسن بن سفيان عن جابر | رضي الله عنه . |(@)(@@)(@@)(@@) $ 15576 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى أحبار بني إسرائيل واضعي أيمانهم | على شمائلهم في الصلاة ' ( ش ) عن الحسن مرسلا . |(@)(@@)(@@)(@@) $ 15577 - قال النبي صلى الله عليه وسلم : ' كأنها آخذة على غضب ، والمحروم من حرم | وصيته ' ( ط ) عن أنس رضي الله عنه . |(@)(@@)(@@)(@@) $ 15578 - قال النبي صلى الله عليه وسلم : ' كأني قد دعيت فأجبت ، وإني تارك فيكم | الثقلين : كتاب الله حبل ممدود بين السماء والأرض ، وعترتي أهل بيتي ، وإنهما | لن يتفرقا حتى يردا علي الحوض ، فانظروا كيف تخلفوني فيهما ' ( طب ) عن أبي | PageV05P399 | سعيد رضي الله عنه . |(@)(@@)(@@)(@@) $ 15579 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إليك تمشي برجلك هذه صحيحة في | الجنة - قاله لعمرو بن الجموح - رضي الله عنه - ' ( حم ) والحسن بن سفيان وأبو | نعيم ( ض ) عن أبي قتادة رضي الله عنه . |(@)(@@)(@@)(@@) $ 15580 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى موسى عليه السلام هابطا من الثنية | وله جؤار إلى الله بالتلبية ' ( حم م ه ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 15581 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى يونس بن متى عليه السلام على ناقة | حمراء جعدة ، عليه جبة من صوف ، خطام ناقته خلبة ، مارا بهذا الوادي | ملبيا ' ( حم م ه ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 15582 - قال النبي صلى الله عليه وسلم : ' كأني قد دعيت فأجبت ، إني تارك فيكم الثقلين ، | أحدهما أكبر من الآخر : كتاب الله وعترتي أهل بيتي ، فانظروا كيف تخلفوني | فيهما ، فإنهما لن يتفرقا حتى يردا علي الحوض ، إن الله مولاي ، وأنا ولي كل | مؤمن ، من كنت مولاه فعلي مولاه ، اللهم وال من والاه ، وعاد من عاداه ' | ( طب ك ) عن أبي الطفيل عن زيد بن أرقم رضي الله عنه . |(@)(@@)(@@)(@@) $ 15583 - قال النبي صلى الله عليه وسلم : ' كأني أنظر إلى كلب أبقع يلغ في دماء أهل بيتي ' | ( كر ) عن السيد الحسين بن علي رضي الله عنهما . |(@)(@@)(@@)(@@) $ 15584 - قال النبي صلى الله عليه 
ms1713	 وسلم : ' كأني أنظر بعبد الرحمن بن عوف على الصراط | يضل مرة ويستقيم أخرى حتى يفلت ولم يكد ' ابن سعد ( كر ) عن عائشة رضي | الله عنها . | PageV05P400 |(@)(@@)(@@)(@@) $ 15585 - قال النبي صلى الله عليه وسلم : ' كان الله ولم يكن شيء غيره ، وكان عرشه على | الماء ، وكتب في الذكر كل شيء هو كائن ، وخلق السموات والأرض ' ( حم | خ طب ) عن عمران بن حصين ( ك ) عن بريدة رضي الله عنه . |(@)(@@)(@@)(@@) $ 15586 - قال النبي صلى الله عليه وسلم : ' كان في عماء ما تحته هواء وما فوقه هواء ، ثم خلق | عرشه على الماء ' ( حم ) وابن جرير ( طب ) وأبو الشيخ في العظمة عن أبي رزين | رضي الله عنه قال : قلت : يا رسول الله ! أين كان ربنا قبل أن يخلق السماء | والأرض ؟ قال : فذكره . |(@)(@@)(@@)(@@) $ 15587 - قال النبي صلى الله عليه وسلم : ' كان آدم طوالا كأنه نخلة سحوق ، فلما أصاب | الخطيئة هرب في الجنة فأخذته شجرة فالتفت فقال : يا رب يا رب العفو ، فلذلك | إذا أخذ عبد أبق فأول ما يسأل العفو ' أبو الشيخ في العظمة عن أبي رضي الله | عنه |(@)(@@)(@@)(@@) $ 15588 - قال النبي صلى الله عليه وسلم : ' كان في وصية نوح لابنه ، يا بني أوصيك بخصلتين ، وأنهاك عن خصلتين : أوصيك بشهادة أن لا إله إلا الله ، فإنها لو كانت السموات والأرض في كفة وهي في كفة لوزنتها ، وأوصيك بالتسبيح فإنها عبادة | الخلق ، وبالتكبير ، وأنهاك عن خصلتين : عن الكبر والخيلاء ، قيل : | يا رسول الله ! أمن الكبر أن أركب الدابة النجيبة وألبس الثوب الحسن ؟ قال : لا ، | قيل : فما الكبر ؟ قال : أن تسفه الحق ، وتغمص الناس ' ( طب ) عن ابن عمرو | رضي الله عنه . |(@)(@@)(@@)(@@) $ 15589 - قال النبي صلى الله عليه وسلم : ' كان الملك يرد عليه ، فلما رددت عليه صعد | الملك ، فكرهت أن أتخلف بعده ' ابن أبي الدنيا في ذم الغضب عن زيد بن يشبع | رضي الله عنه . | PageV05P401 |(@)(@@)(@@)(@@) $ 15590 - قال النبي صلى الله عليه وسلم : ' كان عيسى بن مريم يعلم أصحابه ، وقال : لو كان | على أحدكم جبل ذهب دينا فدعا الله عز وجل بذلك 
ms1714	 لقضاه الله عنه : اللهم فارج | الهم ، كاشف الغم ، مجيب دعوة المضطرين ، رحمن الدنيا والآخرة ورحيمهما ، | أنت ترحمني ، فارحمني رحمة تغنيني بها عن رحمة من سواك ' ( ك ) عن أبي بكر | رضي الله عنه . |(@)(@@)(@@)(@@) $ 15591 - قال النبي صلى الله عليه وسلم : ' كان داود فيه غيرة شديدة وكان إذا خرج أغلقت | الأبواب فلم يدخل على أهله أحد حتى يرجع ، فخرج ذات يوم وغلقت الأبواب ، | فأقبلت امرأة تطلع إلى الدار ، وإذا رجل قائم وسط الدار ، فقالت لمن في البيت : | من أين دخل هذا الرجل والدار مغلقة ، والله ليفتضحن بداود ، فجاء داود ، وإذا | الرجل قائم وسط الدار ، فقال له داود : من أنت ؟ قال : الذي لا أهاب الملوك ، | ولا يمتنع مني الحجاب ، قال داود : أنت إذن والله ملك الموت ، مرحبا بأمر | الله ، فزمل داود مكانه حيث قبضت نفسه حتى فرغ من شأنه ، فطلعت عليه | الشمس ، فقال سليمان للطير ، أظلي على داود ، فأظلت عليه حتى أظلمت عليه | الأرض ، فقال لها سليمان : اقبضي جناحا جناحا ، وغلبت عليه يومئذ | المضرحية ' ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15592 ) قال النبي :(@)(@@) | 30 ( كان موضع البيت في زمن آدم شبرا أو أكثر علما ، فكانت الملائكة تحجه قبل آدم ، ثم حج آدم فاستقبلته الملائكة ، فقالوا : يا آدم من أين جئت ؟ قال : حججت البيت ، فقالوا : قد حجته الملائكة قبلك ) )(@)(@@) ( هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15593 ) قال النبي :(@)(@@) | 30 ( كان عيسى بن مريم يسيح فإذا مشى أكل بقل PageV05P402 الصحراء ، وشرب ماء القراح ، وتوسد التراب ؛ ثم قال عيسى بن مريم : ليس له بيت يخرج ، ولا ولد يموت ، طعامه بقل الصحراء ، وشرابه ماء القراح ، ووساده التراب ، فلما أصبح ساح فمر بواد فإذا فيه رجل أعمى مقعد مجذوم ، قد قطعه الجذام ، السماء من فوقه ، والوادي من تحته ، والثلج عن يمينه ، والبرد عن يساره ، وهو يقول : الحمد لله رب العالمين ثلاثا ، فقال له عيسى بن مريم : يا عبد الله على ما تحمد الله ، أنت أعمى مقعد مجذوم ، وقد قطعك الجذام ، السماء من فوقك ، والوادي من تحتك ، والثلج 
ms1715	 عن يمينك ، والبرد عن يسارك ؟ قال : يا عيسى أحمد الله إذ لم أكن الساعة ممن يقول : إنك إلاه ، أو ابن إلاه ، أو ثالث ثلاثة ) )(@)(@@) الديلمي وابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15594 ) قال النبي :(@)(@@) | 30 ( كان طعام عيسى الباقلاء حتى رفع ، ولم يأكل عيسى شيئا غيرته النار حتى رفع ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15595 ) قال النبي :(@)(@@) | 30 ( كان خطيئة داود النظر ) )(@)(@@) الديلمي عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15596 ) قال النبي :(@)(@@) | 30 ( كان لهارون ولدان يخدمان المسجد ويسرجان قناديله من نار تأتيهما من السماء ، وإن النار تأخرت ذات ليلة عن وقتها التي كانت تأتي فيه ، فأسرج الغلامان تلك القناديل من نار الدنيا ، فجاءت النار من السماء فوقعت عليهما ، فقام هارون ليطفىء عن ولديه تلك النار ، فصاح موسى : كف عن ذالك ، ودع أمر الله ينفذ فيهما ، فأوحى الله عز وجل إلى موسى : هاذا فعلي بمن خالف أمري من أوليائي ، فكيف بمن خالف أمري من أعدائي ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15597 ) قال النبي :(@)(@@) | 30 ( كان من الأنبياء من يسمع الصوت فيكون بذاك نبيا ، وإن جبريل يأتيني فيكلمني كما يأتي أحدكم صاحبه فيكلمه ) )(@)(@@) أبو نعيم عن ابن عباس PageV05P403 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15598 ) قال النبي :(@)(@@) | 30 ( كان على النصارى صوم شهر رمضان ، وكان عليهم ملك فمرض فقال : لئن شفاه الله ليزيدن عشرا ، ثم كان عليهم ملك بعده يأكل اللحم فوجع فقال : لئن شفاه الله ليزيدن ثمانية أيام ، ثم كان ملك بعده فقال : ما تدع من هاذه الأيام أن يتمها ، ونجعل صومنا في الربيع ففعل ، فصارت خمسين يوما ) )(@)(@@) ( خ ) في تاريخه والنحاس في تاريخه ( طب ) عن دغفل بن حنظلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15599 ) قال النبي :(@)(@@) | 30 ( كان ليعقوب عليه السلام أخ مؤاخ في الله ، فقال ذات يوم : يا يعقوب ما الذي أذهب بصرك ، وما الذي قوس ظهرك ؟ فقال : أما الذي أذهب بصري فالبكاء على يوسف ، وأما الذي قوس ظهري فالحزن على بنيامين ، فأتاه جبريل فقال : يا يعقوب إن الله تعالى 
ms1716	 يقرئك السلام ويقول : أما تستحي تشكوني إلى غيري ، فقال يعقوب : إنما أشكو بثي وحزني إلى الله ، فقال جبريل : أعلم ما تشكو يا يعقوب ، ثم قال يعقوب : أي رب أما ترحم الشيخ الكبير أذهبت بصري وقوست ظهري ، فاردد علي ريحانتي أشمه شما قبل الموت ثم اصنع بي ما أردت ، فأتاه جبريل فقال : إن الله يقرئك السلام ويقول لك : أبشر وليفرح قلبك ، فوعزتي لو كانا ميتين لنشرتهما ، فاصنع طعاما للمساكين ، فإن أحب عبادي إلي الأنبياء والمساكين ، وتدري لم أذهبت بصرك ، وقوست ظهرك ، وصنع إخوة يوسف به ما صنعوا ؟ إنكم ذبحتم شاة ، فأتاكم مسكين يتيم وهو صائم فلم تطعموه منه شيئا ، وكان يعقوب بعد إذا أراد الغداء أمر مناديا فنادى : ألا من أراد الغداء من المساكين فليتغد مع يعقوب ، وإذا كان صائما أمر مناديا فنادى ألا من كان صائما من المساكين فليفطر مع يعقوب ) )(@)(@@) ابن راهويه في تفسيره ( ك ) عن أنس رضي الله عنه .(@)(@@) PageV05P404(@)(@@)(@@)(@@) $ ( 15600 ) قال النبي :(@)(@@) | 30 ( كان فيمن كان قبلكم رجل يأتي وكر طائر إذا أفرخ فيأخذ فرخيه ، فشكى ذالك الطير إلى الله عز وجل ما يصنع ذالك الرجل ، فأوحى الله إليه : إن هو عاد فسأهلكه ، فلما أفرخ خرج ذالك الرجل كما كان يخرج وأسند سلما ، فلما كان في طرف القرية لقيه سائل فأعطاه رغيفا من زاده ومضى ، حتى أتى ذالك الوكر فوضع سلمه ثم صعد فأخذ الفرخين وأبواهما ينظران ، فقالا : يا رب إنك وعدتنا أن تهلكه إن عاد ، وقد عاد فأخذهما ولم تهلكه ، فأوحى الله إليهما أو لم تعلما إني لا أهلك أحدا تصدق في يوم بصدقة ذالك اليوم بميتة سوء ) )(@)(@@) ( ك ) و ابن ماسر في فوائده عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15601 ) قال النبي :(@)(@@) | 30 ( كان في بني إسرائيل جدي ترضعه أمه فترويه ، فأفلت فارتضع الغنم ثم لم يشبع ، فأوحى الله إليهم أن مثل هاذا كمثل قوم يأتون من بعدكم يعطى الرجل منهم ما يكفي الأمة والقبيلة ثم لا يشبع ) )(@)(@@) ابن شاهين ( كر ) عن ابن عمر رضي الله 
ms1717	 عنهما ، وقال ابن شاهين حديث غريب تفرد به شعيب بن صفوان عن عطاء بن السائب لا أعلم حدث به غيره .(@)(@@)(@@)(@@) $ ( 15602 ) قال النبي :(@)(@@) | 30 ( كان فص خاتم سليمان بن داود سماوي ، فألقي إليه فأخذه فوضعه في خاتمه وكان نقشه : أنا الله لاا إلاه إلا أنا محمد عبدي ورسولي ) )(@)(@@) ( طب كر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15603 ) قال النبي :(@)(@@) | 30 ( كان لداود عليه السلام من الليل ساعة يوقظ فيها أهله يقول : يا آل داود قوموا فصلوا ، فإن هاذه ساعة يستجيب الله فيها الدعاء إلا لساحر أو عشار ) )(@)(@@) ( حم ع طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15604 ) قال النبي :(@)(@@) | 30 ( كان في بني إسرائيل ملكان أخوان على مدينتين ، PageV05P405 وكان أحدهما بارا برحمه عادلا في رعيته وكان الآخر عاقا برحمه جائرا على رعيته ، وكان في عصرهما نبي ، فأوحى الله إلى ذالك النبي أنه قد بقي من عمر هاذا البار ثلاث سنين ، وبقي من عمر هاذا العاق ثلاثون سنة ، فأخبر ذالك النبي رعية هاذا ورعية هاذا ، فأحزن ذالك رعية العادل ، وأحزن ذلك رعية الجائر ، ففرقوا بين الأطفال والأمهات ، وتركوا الطعام والشراب وخرجوا إلى الصحراء يدعون الله عز وجل أن يمتعهم بالعادل ، ويزيل عنهم أمر الجائر ، فأقاموا ثلاثا ، فأوحى الله إلى ذالك النبي أن أخبر عبادي أني قد رحمتهم وأجبت دعاءهم ، فجعلت ما بقي من عمر هاذا البار لذالك الجائر ، وما بقي من عمر ذالك الجائر لهاذا البار ، فرجعوا إلى بيوتهم ، ومات العاق لتمام ثلاث سنين ، وبقي العادل فيهم ثلاثين سنة ، ثم تلا رسول الله : { وما يعمر من معمر ولا ينقص من عمره إلا في كتاب إن ذالك على الله يسير } ) )(@)(@@) أبو الحسن بن معروف في ( خط كر ) عن عبد الصمد بن علي بن عبد الله بن عباس عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 15605 ) قال النبي :(@)(@@) | 30 ( كان فيه : عجب لمن أيقن بالموت كيف يفرح بالدنيا ، وعجبت لمن أيقن بالنار كيف يضحك ، وعجبت لمن أيقن بالحساب كيف يعمل السيئات ، وعجبت لمن 
ms1718	 أيقن بالقدر كيف ينصب ، وعجبت لمن يرى الدنيا وتقلبها بأهلها كيف يطمئن إليها ، وعجبت لمن أيقن بالجنة ولا يعمل الحسنات ، لا الاه إلا الله محمد رسول الله ) )(@)(@@) ( كر ) عن أبي ذر رضي الله عنه قال : قلت : يا رسول الله ما كان في صحف موسى ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 15606 ) قال النبي :(@)(@@) | 30 ( كان فيمن كان قبلكم رجل مسرف على نفسه وكان مسلما ، كان إذا أكل طعامه طرح ثفالة طعامه على مزبلة ، فكان يأوي إليها عابد ، فإن وجد كسرة أكلها ، وإن وجد بقلة أكلها ، وإن وجد عرقا تعرقه ، فلم يزل كذالك PageV05P406 حتى قبض الله عز وجل ذالك الملك فأدخله النار بذنوبه ، فخرج العابد إلى الصحراء مقتصرا على مائها وبقلها ثم إن الله عز وجل قبض ذالك العابد فقال : هل لأحد عندك معروف تكافئه ؟ قال : لا يا رب ، قال : فمن أين كان معاشك وهو أعلم بذالك ؟ قال : كنت آوي إلى مزبلة ملك ، فإن وجدت كسرة أكلتها ، وإن وجدت بقلة أكلتها ، وإن وجدت عرقا تعرقته ، فقبضته فخرجت إلى البرية مقتصرا على بقلها ومائها ، فأمر الله عز وجل بذالك الملك فأخرج من النار حممه ، فقال : يا رب هاذا الذي كنت آكل من مزبلته ، فقال الله عز وجل له : خذ بيده فأدخله الجنة من معروف كان منه إليك ، أما لو علم به ما أدخلته النار ) )(@)(@@) تمام ( كر ) وقال غريب وابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15607 ) قال النبي :(@)(@@) | 30 ( كان فيما أعطى الله تعالى موسى في الألواح : اشكر لي ولوالديك أقك المتالف ، وأنسىء لك في عمرك ، وأحيك حياة طيبة ، وأفلتك إلى خير منها ) )(@)(@@) ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15608 ) قال النبي :(@)(@@) | 30 ( كان ينفخ على إبراهيم ) )(@)(@@) ( خ ) عن أم شريك قالت : أمر رسول الله بقتل الوزغ وقال : فذكره .(@)(@@)(@@)(@@) $ ( 15609 ) قال النبي :(@)(@@) | 30 ( كان رجل يعمل بالمعاصي حتى جمع من ذالك مالا ، فلما حضره الموت قال لأهله : إن اتبعتم ما آمركم به دفعت إليكم مالي ، وإلا لم أفعل ، قالوا : فإنا سنتبع ما أمرتنا به ، قال 
ms1719	 : إذا أنا مت فحرقوني بالنار ، ثم دقوا عظامي دقا شديدا ، فإذا رأيتم يوم ريح شديدة فاصعدوا إلى قلة جبل فاذروني في الريح ، ففعلوها ، فوقع في يد الله ، فقال له : ما حملك على الذي صنعت ؟ قال : مخافتك ، قال : قد غفرت لك ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15610 ) قال النبي :(@)(@@) | 30 ( كان سهيل عشارا باليمن يظلمهم ويغصبهم PageV05P407 أموالهم ، فمسخه الله شهابا فعلقه حيث ترون ) )(@)(@@) ( طب ) و ابن السني في عمل يوم وليلة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15611 ) قال النبي :(@)(@@) | 30 ( كان في بني إسرائيل جدي في غنم كثيرة ترضعه أمه ، فانفلت فرضع الغنم كلها ثم لم يشبع ، فبلغ ذالك نبيهم فقال : إن مثل هاذا مثل قوم يأتون من بعدكم ، يعطى الرجل منهم ما يكفي القبيلة أو الأمة ثم لا يشبع ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15612 ) قال النبي :(@)(@@) | 30 ( كان فيما خلا من إخواني من الأنبياء ثمانية آلاف نبي ، ثم كان عيسى بن مريم ، ثم كنت أنا بعده ) )(@)(@@) ( ك ) وتعقب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15613 ) قال النبي :(@)(@@) | 30 ( كان سليمان نبي الله إذا قام في مصلاه رأى شجرة نابتة بين يديه ، فيقول : ما اسمك ؟ فتقول كذا ، فيقول : لأي شيء أنت ؟ فتقول : لكذا وكذا ، فإن كانت لدواء كتبت ، وإن كانت لغرس غرست ، فبينا هو يصلي يوما إذ رأى شجرة فقال : ما اسمك ؟ قالت : الخرنوب ، قال : لأي شيء أنت ؟ قالت : لخراب هاذا البيت ، قال سليمان : اللهم عم على الجن موتي حتى تعلم الإنس أن الجن لا تعلم الغيب ، فنحتها عصا فتوكأ عليها ، فأكلتها الأرضة فسقط ، فوجدوه حولا ، فتبينت الإنس أن الجن لو كانوا يعلمون الغيب ما لبثوا حولا في العذاب ، فشكرت الجن الأرضة فكانت تأتيها بالماء حيث كانت ) )(@)(@@) ( ك ) و ابن السني وأبو نعيم في الطب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15614 ) قال النبي :(@)(@@) | 30 ( كان يعطي للدنيا وحمدها وذكرها وما قال يوما قط اغفر لي يوم الدين ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15615 
ms1720	 ) قال النبي :(@)(@@) | 30 ( كان فيما أعطى الله موسى في الألواح الأولى : اشكر لي ولوالديك أقك المتالف ، وأنسء في عمرك ، وأحيك حياة طيبة ، وأقلبك PageV05P408 إلى خير منها ، ولا تقتل النفس التي حرمت إلا بالحق فتطبق عليها الأرض برحبها ، والسماء بأقطارها ، وتبوء بسخطي من النار ، ولا تحلف باسمي ولا تحلف باسمي كاذبا ، فإني لا أطهر ولا أزكي من لم ينزهني ويعظم اسمي ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15616 ) قال النبي :(@)(@@) | 30 ( كان عبد من عباد الله آتاه الله مالا وولدا فذهب من عمره عمر وبقي عمر فقال لبنيه : أي أب كنت لكم ؟ قالوا : خير أب ، قال : إني والله ما أنا بتارك عند أحد مالا كان مني إليه إلا أخذته ، أو تفعلون بي ما أقول لكم ، فأخذ منهم ميثاقا قال : أما الآن فانظروا إذا أنا مت فاحرقوني بالنار ثم اسحقوني ثم انظروا يوما ذا ريح فاذروني لعلي أضل الله ، فدعي فاجتمع ، فقيل له : ما حملك على ما صنعت ؟ قال : خشية عذابك ، قال : استقل ذاهبا فتيب عليه ) )(@)(@@) ( حم ) و الحكيم ( طب ) عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 15617 ) قال النبي :(@)(@@) | 30 ( كان رجل ممن كان قبلكم يبايع بالأمانة ، فأتاه رجل فأخذ منه ألف دينار إلى أجل ، فحضر الأجل وقد خب البحر ، فأخذ خشبة فجعل فيها الدنانير ثم أتى البحر فقال : اللهم إن فلانا بايعني بالأمانة وقد خب البحر فأدها إليه ورمى بها في البحر ، وأقبلت الخشبة ترفعها موجة وتضعها أخرى ، وخرج الرجل ليتوضأ لصلاة الغداة ، فجاءت الخشبة فصكت كعبه فأخذها ، ثم قال لأهله لا تحدثوا فيها حديثا حتى أصلي ، فأخذها فإذا فيها الدنانير فكتب وزنها عنده ، ثم لقي الرجل بعد زمان فقال : ألست فلانا ؟ قال : بلى ، قال : ألست الذي بايعتك بالأمانة ؟ قال : بلى ، قال : فأين مالي ؟ قال : اتزن ، ثم قال له : يعلم الله لقد فعلت كذا وكذا ، قال : قد أدى الله عز وجل أمانتك ، فأي الرجلين أعظم أمانة ؟ الذي أداها ولو شاء لذهب بها ؟ أم الذي ردها ولو شاء أخذها ) )(@)(@@) الخرائطي 