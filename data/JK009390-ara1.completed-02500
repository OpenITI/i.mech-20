ms2496	 يقوم به ، فإن PageV07P394 نومه صدقة تصدق الله بها عليه وله أجر حزبه ) )(@)(@@) ( حل ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23194 ) قال النبي :(@)(@@) | 30 ( من نام على إجار ليس عليه ما يدفع قدميه فخر فقد برئت منه الذمة ، ومن ركب البحر إذا أريح فقد برئت منه الذمة ) )(@)(@@) ( حم ) عن زهير بن عبد الله عن بعض الصحابة .(@)(@@)(@@)(@@) $ ( 23195 ) قال النبي :(@)(@@) | 30 ( من نام وهو جالس فلا وضوء عليه ، فإذا وضع جنبه فعليه الوضوء ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23196 ) قال النبي :(@)(@@) | 30 ( من نام على تسبيح أو تكبير أو تهليل أو تحميد بعث عليها يوم القيامة ، ومن نام على غفلة بعث عليها يوم القيامة ، فعودوا أنفسكم الذكر عند النوم ) )(@)(@@) الديلمي عن الحكم بن عمير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23197 ) قال النبي :(@)(@@) | 30 ( من نبت لحمه من سحت فالنار أولى به ) )(@)(@@) عن أبي بكر ، ( ك ) عن عمر رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 23198 ) قال النبي :(@)(@@) | 30 ( من نجا من ثلاث فقد نجا ، من نجا من ثلاث فقد نجا ، من نجا من ثلاث فقد نجا : موتي ، والدجال ، وقتل خليفة مصطبر للحق معطيه ) )(@)(@@) ( حم طب ك ص ) عن عبد الله بن خوالة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23199 ) قال النبي :(@)(@@) | 30 ( من نذر نذرا ولم يسمه فكفارته كفارة يمين ) )(@)(@@) ( د ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23200 ) قال النبي :(@)(@@) | 30 ( من نزع يدا من طاعة الله وفارق الجماعة ثم مات ، مات ميتة جاهلية وخلفها بعد عهدها ، لقي الله ولا حجة له ) )(@)(@@) ( خط ) في PageV07P395 المتفق والمفترق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23201 ) قال النبي :(@)(@@) | 30 ( من نزع يدا من طاعة فإنه يأتي يوم القيامة لا طاعة ولا حجة له ، ومن مات مفارقا للجماعة فقد مات موتة جاهلية ) )(@)(@@) ( حم ) عن ابن عمر ، ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23202 ) قال النبي :(@)(@@) | 30 ( من نزلت به حاجة فأنزلها بالناس لم تسد فاقته ، فإن أنزلها بالله أوشك الله له بالغنى ، إما أجل أجل وإما عن عاجل ) )(@)(@@) ابن جرير في 
ms2497	 تهذيبه ( طب حل هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23203 ) قال النبي :(@)(@@) | 30 ( من نسي صلاة فلم يذكرها إلا وهو مع الإمام ، فليصل مع الإمام فإذا فرغ من صلاته فليعد الصلاة التي نسي ثم يعيد الصلاة التي صلاها مع الإمام ) )(@)(@@) ( طس ) و الخطيب عن ابن عمر رضي الله عنهما وصحح أبو زرعة وقفه .(@)(@@)(@@)(@@) $ ( 23204 ) قال النبي :(@)(@@) | 30 ( من نسي أن لا يذكر اسم الله في أول طعامه فليقل حين يذكر : بسم الله في أوله وآخره ، فإنه يستقبل طعاما جديدا ، ويمنع الخبيث ما كان يصيب منه ) )(@)(@@) ( حب طب ) و ابن السني في عمل يوم وليلة عن القاسم بن عبد الرحمان بن عبد الله بن مسعود عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 23205 ) قال النبي :(@)(@@) | 30 ( من نسي ركعتي الفجر فليصلهما إذا طلعت الشمس ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23206 ) قال النبي :(@)(@@) | 30 ( من نسي صلاة فوقتها إذا ذكرها ) )(@)(@@) ( طس هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P396(@)(@@)(@@)(@@) $ ( 23207 ) قال النبي :(@)(@@) | 30 ( من نسي صلاة فلم يذكرها إلا وهو مع الإمام ، فليصل مع الإمام ، فإذا فرغ من صلاته فليعد الصلاة التي نسي ، ثم يعيد الصلاة التي صلاها مع الإمام ) )(@)(@@) ( هق ) وضعفه عن ابن عمر رضي الله عنهما وصحح وقفه .(@)(@@)(@@)(@@) $ ( 23208 ) قال النبي :(@)(@@) | 30 ( من نسي مسح الرأس فذكر وهو يصلي ، فوجد في لحيته بللا فليأخذ منه ويمسح به رأسه فإن ذالك يجزئه ، فإن لم يجد بللا فليعد الوضوء والصلاة ) )(@)(@@) ( طس ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23209 ) قال النبي :(@)(@@) | 30 ( من نسي الصلاة علي خطىء به طريق الجنة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23210 ) قال النبي :(@)(@@) | 30 ( من نسي المضمضة والاستنشاق فليمض ولا ينصرف ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23211 ) قال النبي :(@)(@@) | 30 ( من نسي صلاة فليصلها إذا ذكرها من الغد للوقت ) )(@)(@@) الطحاوي ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23212 ) قال النبي :(@)(@@) | 30 ( من نصب شجرة وصبر على حفظها والقيام عليها حتى تثمر ، كان له في كل 
ms2498	 شيء يصاب من ثمرها صدقة عند الله ) )(@)(@@) ( حم ) و البغوي ( هب ) عن رجل .(@)(@@)(@@)(@@) $ ( 23213 ) قال النبي :(@)(@@) | 30 ( من نظر إلى فرجة في صف فليسدها بنفسه ، فإن لم يفعل فمر مار فليتخط على رقبته فإنه لا حرمة له ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P397(@)(@@)(@@)(@@) $ ( 23214 ) قال النبي :(@)(@@) | 30 ( من نظر إلى أخيه المسلم نظرة مخيفة من غير حق أخافه الله يوم القيامة ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23215 ) قال النبي :(@)(@@) | 30 ( من نظر إلى عورة أخيه متعمدا ، لم يقبل الله له صلاة أربعين ليلة ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23216 ) قال النبي :(@)(@@) | 30 ( من نظر في الدنيا إلى من فوقه ، وفي الدين إلى من تحته لم يكتبه الله صابرا ولا شاكرا ، ومن نظر في الدنيا إلى من تحته ، وفي الدين إلى من فوقه كتبه الله صابرا شاكرا ) )(@)(@@) ( حل هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23217 ) قال النبي :(@)(@@) | 30 ( من نفس عن مؤمن كربة نفس الله عنه كربة يوم القيامة ، ومن ستر على مؤمن عورة ستر الله عورته ، ومن فرج عن مؤمن كربة فرج الله كربته ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23218 ) قال النبي :(@)(@@) | 30 ( من نور بالفجر نور الله في قبره وقبله وقبل صلاته ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23219 ) قال النبي :(@)(@@) | 30 ( من نقى لفرسه شعيرا ثم قام به حتى يعلفه عليه كتب الله له بكل شعيرة حسنة ) )(@)(@@) ابن زنجويه ( طب ) والحاكم في الكنى ا عن تميم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23220 ) قال النبي :(@)(@@) | 30 ( من هاذه المتألية على الله ، وما يدريك يا أم كعب ، لعل كعبا قال ما لا يعنيه ، وصنع ما لا ينفعه ) )(@)(@@) الخطيب عن كعب بن عجرة أنه مرض فعاده النبي فقالت أمه : هنيئا لك الجنة يا كعب ، فقال : فذكره .(@)(@@)(@@)(@@) $ ( 23221 ) قال النبي :(@)(@@) | 30 ( من هاب منكم الليل أن يكابده ، وخاف العدو أن يجاهده ، وضن بالمال أن ينفقه ، فليكثر من ذكر ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن 
ms2499	 ابن عباس رضي الله عنهما .(@)(@@) PageV07P398(@)(@@)(@@)(@@) $ ( 23222 ) قال النبي :(@)(@@) | 30 ( من هاله الليل أن يكابده ، وبخل بالمال أن ينفقه ، وجبن عن العدو أن يقاتله ، فليكثر أن يقول : سبحان الله وبحمده ، فإنه أحب إلى الله من جبل ذهب وفضة ينفقا في سبيل الله ) )(@)(@@) ( طب ) و ابن شاهين وابن عساكر عن أبي أمامة رضي الله عنه ، ولفظ ابن شاهين : فإنهما أحب إلى الله من جبلي ذهب ينفقهما في سبيل الله ، وهو ضعيف .(@)(@@)(@@)(@@) $ ( 23223 ) قال النبي :(@)(@@) | 30 ( من هاهنا من رهط فلان أن صاحبكم قد احتبس عن الجنة بدين كان عليه ، فإما أن تفدوه من عذاب الله ، وإما أن تسلموه ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23224 ) قال النبي :(@)(@@) | 30 ( من هبط منكم إلى هاذه القرية فلا يرجعن إلى أهله حتى يركع ركعتين في هاذا المسجد ثم يرج ع إلى أهله ) )(@)(@@) ( طب ) عن مسلم بن أسلم بن بحيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23225 ) قال النبي :(@)(@@) | 30 ( من هجر أخاه فوق ثلاث فهو في النار ، إلا أن يتداركه الله بكرامته ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23226 ) قال النبي :(@)(@@) | 30 ( من هلل مائة ، وسبح مائة ، وكبر مائة خير له من عشرين ) )(@)(@@) ( خ ) في الأدب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23227 ) قال النبي :(@)(@@) | 30 ( من هم بحسنة ولم يعملها كتبت له حسنة ، فإن عملها كتبت له بعشر أمثالها إلى سبعمائة وسبع أمثالها ، ومن هم بسيئة لم تكتب عليه فإن لم يعملها كتبت له حسنة ، فإن عملها كتبت عليه سيئة واحدة ، فإن لم يعملها لم تكتب عليه ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P399(@)(@@)(@@)(@@) $ ( 23228 ) قال النبي :(@)(@@) | 30 ( من هم بذنبه ثم تركه كانت له حسنة ) )(@)(@@) الديلمي عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23229 ) قال النبي :(@)(@@) | 30 ( من وافق موته عند انقضاء رمضان دخل الجنة ، ومن مات عند انقضاء عرفة دخل الجنة ) )(@)(@@) أبو نعيم عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23230 ) قال النبي :(@)(@@) | 30 ( من وافق من أخيه شهوة غفر له ) )(@)(@@) ( طب 
ms2500	 ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23231 ) قال النبي :(@)(@@) | 30 ( من وافق صيامه يوم الجمعة وعاد مريضا ، وشهد جنازة ، وتصدق وأعتق وجبت له الجنة ذالك اليوم إن شاء الله ) )(@)(@@) ( ع هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23232 ) قال النبي :(@)(@@) | 30 ( من وافق حجامته يوم الثلاثاء لسبعة عشر من الشهر كان كدواء سنة ) )(@)(@@) الرافعي عن ابن شهاب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23233 ) قال النبي :(@)(@@) | 30 ( من وجد سعة لأن يضحي فلم يضح فلا يحضر مصلانا ) )(@)(@@) ( حم ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23234 ) قال النبي :(@)(@@) | 30 ( من وجد متاعه بعينه عند رجل قد أفلس فهو أحق به من غيره ) )(@)(@@) ( حم ) و سمويه عن سمرة قال محمد بن يحيى الدهلي : هاذا في الفلس والأول في السرقة ( ش حم ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23235 ) قال النبي :(@)(@@) | 30 ( من وجد ماله في الفيء قبل أن يقسم فهو له ، ومن وجده بعد ما يقسم فليس له شيء ) )(@)(@@) الخطيب عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P400(@)(@@)(@@)(@@) $ ( 23236 ) قال النبي :(@)(@@) | 30 ( من وجد عين ماله عند مفلس فهو أحق به من الغرماء ) )(@)(@@) ( قط ) في الأفراد عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 23237 ) قال النبي :(@)(@@) | 30 ( من وجد مسلما على عورة فسترها فكأنما أحيا موءودة من قبرها ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23238 ) قال النبي :(@)(@@) | 30 ( من وجدتموه يعمل عمل قوم لوط فارجموا الأعلى والأسفل جميعا ) )(@)(@@) الخرائطي في مساوىء الأخلاق وابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23239 ) قال النبي :(@)(@@) | 30 ( من وجدتموه غل فاضربوه وأحرقوا متاعه ) )(@)(@@) ( حم ) و العدني والدارمي ( ع ) والساسي ( ك ) وتعقب ( ض ) وتعقب عن سالم بن عبد الله بن عمر عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 23240 ) قال النبي :(@)(@@) | 30 ( من وجدتموه يقطع من الحمى شيئا فلكم سلبه ) )(@)(@@) ابن سعد عن أبي بشير المازني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 23241 ) قال النبي :(@)(@@) | 30 ( من وجدتموه يصيد في شيء من هاذه الحدود فمن أخذه فله سلبه ) )(@)(@@) ابن جرير عن سعد بن 