ms341	 جهان %~% جز خنجر و تیغ و سنان جز ناچخ و تیر و تبر(@)(@@) 70 وز بسکه جان اهل کین با خاک ره گردد عجین %~% گویی همه خاک زمین جان داردی چون جانور(@)(@@) 71 چون از کمین آیی برون جاری کنی جیحون خون %~% از نیش تیغ آبگون وز نوک تیغ جان شکر(@)(@@) 72 رمحت بدرد تا فلک تیغت ببرد تا سمک %~% نقش بقا سازند حک این از نشیب آن از زبر(@)(@@) 73 گوید عدویت دمبدم از خوف جان در هر قدم %~% یا حبذا دارالعدم یا مرحبا دارالسقر(@)(@@) 74 گوید ز بس خوف قصاص آین المفر آین المناص %~% این النجاه این الخلاص این المقام این المقر(@)(@@) 75 شاها مرا یک ملتمس باقیست بشنو یک نفس %~% کافکنده چرخم در قفس چون طایر بی‌بال و پر(@)(@@) 76 سالیست افزون تا مرا زاقران نمودی برترا %~% هم سیم داد هم زرا هم‌ گنج دادی هم‌ گهر(@)(@@) 77 بس زر و سیم و خواسته بخشیدیم ناخواسته %~% واکنون ز جا برخاسته عزمم به آهنگ سفر(@)(@@) 78 نه اسب دارم نه رهی وز سیم و زر جیبم تهی %~% هم در سرم فکر مهی هم در دلم عزم خطر PageV1P196(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دی آمد از در من آن دلفریب پسر %~% افکنده دام بلا زلفش به روز مطر(@)(@@) 2 بودی به رنگ قمر رخشنده چهره او %~% نه ‌کی ز سرو روان تابیده جرم قمر(@)(@@) 3 بر سرو قامت او افتاده همچو کمند %~% پرحلقه سلسله‌یی همرنگ مشک تتر(@)(@@) 4 حاشانه مشک تتر هرگزکه از بر سرو %~% چندین شکنج و شکن سر داده یک به دگر(@)(@@) 5 گفتی دوهندوی مست‌گردیده ازپی لعب %~% آسیمه‌سار و نگون آون ز شاخ شجر(@)(@@) 6 یا نی دو مار سیه آسیمه سارودمان %~% دارد به سایه سرو از آفتاب‌گذر(@)(@@) 7 یا نی دو دزد دغل پی برده‌اند به‌گنج %~% از بهر غارت سیم یازیده دست ظفر(@)(@@) 8 آری نگار ختن دارد ز سیم سرین %~% گنجی نهفته همی بیغش به زیر 
ms342	 کمر(@)(@@) 9 دارند خلق جهان ازگنج فربه او %~% از غصه‌ کو به دل از ناله دست به سر(@)(@@) 10 وان ترک تنگ دهان از بس بخیل بود %~% پیوسته منع ‌کند آن سیم را زنفر(@)(@@) 11 غافل‌ که سیم خود ار بر مستحق دهد %~% از بذل سیم شود نامش به دهر سمر(@)(@@) 12 ای‌کاش نقره ی او بودی مرا که همی %~% می‌داد می‌ که مرا گردد فزوده خطر(@)(@@) 13 باری به خلوت من آن غارت دل و دین %~% چون در رسید ز راه چون برگزید مقر(@)(@@) 14 گفتم بیا صنما ای‌کز فروغ رخت %~% روشن شدست مرا دیوار و خانه و در(@)(@@) 15 خواهم‌که بوسه زنم بر تنگ شکر تو %~% تا کام و لب ز لبت شیرین‌ کنم به مگر(@)(@@) 16 خندید وقت ولی از روی عادت و رسم %~% نشنیده‌ام‌ که دهد کس بوسه بر به شکر(@)(@@) 17 ویژه ز بس‌ که لطیف این شکری‌ که مرا %~% بگدازد ار کندی بر در نسیم‌ گذر(@)(@@) 18 کی احتمال‌کند دمهای سرد ترا %~% کامد به نزد خرد از زمهریر بتر(@)(@@) 19 یک ره در آینه بین بر خلق منکر خود %~% تا دانی آنکه ترا باشد چگونه سیر(@)(@@) 20 چندانکه هست ترا پروای خدمت من %~% باشد اضافه مرا از صحبت تو حذر(@)(@@) 21 گر میل صحبت من داری و بوس و کنار %~% ایدون به نقد بزن دستی به‌کیسه زر(@)(@@) 22 کام از لب و دهنم بی‌زر کسی نستد %~% ها زر بیار و فزون زین عرض خود بمبر(@)(@@) 23 گفتم بلای نپسندی ار به بلا %~% جانم ز سر بهلا این عجب و کبر و بطر(@)(@@) 24 هر چند کیسه و جیب از زر تهی بودم %~% دارم ز نظم دری آماده‌ گنج و گهر(@)(@@) 25 گفتا که ‌گنج و گهر گر باشدت بفروس %~% آنگه به مشت زرم این ‌گنج سیم بخر(@)(@@) 26 ور نه مخار زنخ‌ کوتاه ساز سخن %~% دانی‌که شاخ هوس‌ک‌ب را نداده ثمر(@)(@@) 27 قاآنیا جو 
ms343	 زر در چشم سیمبران %~% صد ره ‌گزیده ترست از صد هزار هنر PageV1P197(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 رسید چه‌ خبر فتح‌کی رسید سحر %~% کجا به نزد مالک از چه ملک از خاور(@)(@@) 2 خبر چه بود شکست عدو که‌ گفت‌ بشیر %~% عدو شکست چسان خورده ‌گشت زیر و زبر(@)(@@) 3 مصافگاه ‌کجا بود ساحت بسطام %~% که بر شکست عدورا سمی بن آزر(@)(@@) 4 دگر که ناصر او بود نصرت‌الدوله %~% چه بود منصبش از شه‌ امارت لشکر(@)(@@) 5 کدام لشکر?‌ آن لشکری‌ که رفت زری %~% کجا به طوس‌ چرا بهر نظم آن‌ کشور(@)(@@) 6 سپاه را که فرستاد خواجه ‌‌کی‌ شعبان %~% کدام خواجه‌ مهین خواجه عطاگستر(@)(@@) 7 دگر سپاه فرستد بلی چه مه‌ شوال %~% چه روز عیدکی آن روز می‌رسد ایدر(@)(@@) 8 گذشت روزه‌ بلی ماه نو نمود نعم %~% چه‌وقت‌ دوش کجا درجنوب ‌چون لاغر(@)(@@) 9 کنون چه باید ساغر چگونه باید پر %~% پر از چه باشد از می چه می‌ می خلر(@)(@@) 10 قدح چه باشد نقره چه نقره‌ نقره خام %~% قدح گسارکه‌ ترکی چگونه‌ سیمین بر(@)(@@) 11 قدح به یاد که بخشد بهاد روی ملک %~% قدح نخست‌که نوشد حکیم دانشور(@)(@@) 12 مرآن حکیم‌ که باشد حکیم قاآنی %~% چو خورد می‌چکند مدح شاه‌ کیوان فر(@)(@@) 13 کدام شه‌ شه ایران چه‌کس‌ محمدشاه %~% ورا لقب چه‌ ابوالسیف از که‌ از داور(@)(@@) 14 ز نسل کیست‌ ز ترک از چه ترک‌ از قاجار %~% شهش ‌که ‌کرد نیا جانشینش‌ کیست‌ پسر(@)(@@) 15 کشد که‌ حزمش‌ ‌چه‌ باره ‌از چه‌ از انصاف %~% کجا به ملک چرا بهر دفع فتنه و شر(@)(@@) 16 بود چه تیغش چون پاسبان دولت و دین %~% رود چه‌ رخشش‌ چون همعنان فتح و ظفر(@)(@@) 17 مسلمست‌ بلی در چه‌ در سخا و سخن‌ %~% مقدمست‌ نعم برکه‌ بر قضا و قدر(@)(@@) 18 گذشته‌چه‌ صیتش تاکجا ‌به‌شرق و غرب %~% رسیده چه‌ نامش تاکجا به بحر و ببر(@)(@@) 19 بود که دشمن او چون رمیده 
ms344	 کی‌ شب و روز %~% ز چه‌ ز سایه خ‌رد درکجا به سنگ و مدر(@)(@@) 20 دهد چه‌ زرکی‌ دایم چگونه‌ بی‌منت %~% به که‌ به عارف و عامی چه‌قدر بی‌حد و مر(@)(@@) 21 نظیر اوست چه‌ عکسش‌کجا در آیینه %~% به معنی است نظیرش نه از طریق نظر(@)(@@) 22 به‌دور وی که خورد خون‌ دو کس کجا به دو جا %~% به دشت رزمش تیغ و به مجلسش ساغر(@)(@@) 23 همی‌گشاید چه‌ تیغ او چه چیز حصار %~% همی فشاند چه‌ رمح او چه چیز شرر(@)(@@) 24 ز فر او شده‌کاسد چه چیز ذل و هوان %~% ز جود شده رایج چه چیز فضل و هنر(@)(@@) 25 گشاید آسان چه‌ رمح او چه‌ باره سخت %~% دهد فراوان‌که‌ دست او چه‌ بدره زر(@)(@@) 26 کسی به عهدش پیچد به خویشتن‌ آری %~% کمند درکف او زلف بر رخ دلبر(@)(@@) 27 دلی ز جودش نالد به روزگار بلی %~% به‌کوه سیم و به دریا در و به‌کان‌گوهر(@)(@@) 28 تنی‌گدازد در مجلسش به عید نعم %~% درون مجمر عود و میان آب شکر(@)(@@) 29 به هیچ ‌کشور سرباز او شود حاکم‌ %~% بلی‌کجا همه جاکیستند ها بشمر(@)(@@) 30 به‌ملک فارس حسین‌خان به‌مرز چین خاقان %~% به ارض زنگ نجاشی به رومیان قیصر(@)(@@) 31 همیشه تاکه دمد چه‌‌گل ازکجاز چمن %~% شکفته باد چه‌ بختش‌ چگونه‌ چون عبهر(@)(@@) 32 بودچه یارش ‌که‌ حق دگر که احمد و آل %~% کجا به هر دو سرا تا چه روز تا محشر PageV1P198(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 سحر چو زمزمه آغازکرد مرغ سحر %~% بسان مرغ سحر از طرب ‌گشودم پر(@)(@@) 2 هنوز نامده سلطان یک سواره برون %~% شدم به مشکوی جانان دو اسبه راه سپر(@)(@@) 3 هنوز ناشده‌ گرم چرا غزاله چرخ %~% برآن غزال غزلخوان مرا فتاد نظر(@)(@@) 4 به آب شسته رخش ‌کارنامه مانی %~% به باد داده لبش بارنامه آزر(@)(@@) 5 تنش به نرمی خلاق اطلس وقاقم %~% رخش به خوبی سلطان سوسن و عبهر(@)(@@) 6 زرنگ عارض او سقف بنگهش 
ms345	 بلور %~% ز عکس ساعد او فرش مشکویش مرمر(@)(@@) 7 گرفتم آنکه نیارند گوهر از عمان %~% به یک تکلم او سنگ و گل شود گوهر(@)(@@) 8 گرفتم آنکه نیارند شکر از اهواز %~% به یک تبسم او خار و خس شود شکر(@)(@@) 9 گرفتم آنکه نیارند عنبر از دریا %~% به یک تحرک زلفش‌ گیا شود عنبر(@)(@@) 10 دو خال برلب نوشش دو داغ بر لاله %~% دو زلف بر سر دوشش دو زاغ بر عرعر(@)(@@) 11 غنوده این چو دو زنگی به سایه طوبی %~% نشسته آن چو دو هندو به چشمه‌ کوثر(@)(@@) 12 دو سوسنش را از برگ ضیمران بالین %~% دو سنبلش را از شاخ ارغوان بستر(@)(@@) 13 مرا چو دید هراسان ز جایگه برخاست %~% بدان مثابه‌ که خیزد سپند از مجمر(@)(@@) 14 چو طوق حکم خداوند بر رقاب امم %~% دو سیمگون قلمش شد بنای من چنبر(@)(@@) 15 به صدرخواست نشستم ولی بگفت سپهر %~% نه او نه من بنشستیم هر دو بر در بر(@)(@@) 16 از آن سپس چو غریبان به جایگاه غریب %~% نظاره‌ کردم شیب و فراز و زیر و زبر(@)(@@) 17 چمانه دیدم و چنگ و چمانی و طنبور %~% پیاله دیدم و تار و چغانه و مزهر(@)(@@) 18 به طرز بیضه بیضاش درکفی مینا %~% به رنگ لو لو لالاش در کفی ساغر(@)(@@) 19 میان این یک تابیده پرتو خورشید %~% درون آن یک رو‌ییده لاله احمر(@)(@@) 20 گلوی شیشه صهبا گرفته اندر چنگ %~% چنانکه گیرد خصمی گلوی خصم دگر(@)(@@) 21 به نای بلبله ساغر فروگشاده دهن %~% چو شیرخواره پستان مهربان مادر(@)(@@) 22 ز حلق‌مرغ‌صحرایی چو مرغ‌حق حق‌گوی %~% فرو چکید همی قطره قطره خون جگر(@)(@@) 23 به‌سان مرغک آذر فروز از منقار %~% همی به بال و پر خویش برفشاند آذر(@)(@@) 24 قنینه را خفقان و پیاله را یرقان %~% ز عکس سرخ می و رنگ باده اصفر(@)(@@) 25 ز فرط خشم فروچیدم از غضب دامن %~% چو زاهدی ‌که نماید به باده خوار گذر(@)(@@) 26 
ms346	 به طنزگفتمش ای خشک مغزتر دامن %~% به طعن راندمش ای خوب چهر بد گوهر(@)(@@) 27 حرام صرف بود باده خاصه بر ساده %~% تو ساده‌رویی ساقی مخواه و باده مخور(@)(@@) 28 به ساده‌رویی باکی نداری از مردم %~% ز باده خواری شرمی نداری از داور(@)(@@) 29 ز بی عفافی مانا نباشدت میسور %~% که بگذرانی یک روز بی می و ساغر(@)(@@) 30 گشاده چشم جهان بین به راه باده‌گسار %~% نهاده‌ گوش نیوشا به لحن خنیاگر(@)(@@) 31 به خنده گفت مرو صبر کن غضب بنشان %~% صواب دیدی بنشین وگرنه رخت ببر(@)(@@) 32 مگر نگفته نبی تا به روز باز پسین %~% خدای هردو جهان توبه را نبندد در(@)(@@) 33 شراب‌ خوردن و آسایش از وساوس نفس %~% به از سپاس بزرگان و احتمال خطر(@)(@@) 34 شراب خوردن و آسوده بودن از بد و نیک %~% به از تحمل چندین هزار بوک و مگر(@)(@@) 35 شراب خوردن از آن به‌ که در زمین امید %~% نهال مدح نشانی و فاقه آرد بر(@)(@@) 36 شراب خوردن از آن به‌ که در سرای امیر %~% به‌غرچه‌یی دو سه بی‌پا و سر شوی همسر(@)(@@) 37 نچیده میوه شرم و نبرده نام حیا %~% ندیده سفره مام و نخورده نان پدر(@)(@@) 38 ز تنگ چشمی هم چشم در زن در زی %~% ز سخت‌رویی هم دس تیشه درگر(@)(@@) 39 نه شربشان بجز از ریم و پارگین و زقوم %~% نه خوردشان بجز ازگوز وگندنا وگزر(@)(@@) 40 ز هرکدام پژوهش‌کنی ز باب و نیا %~% جواب ندهد جز نام مادر و خواهر(@)(@@) 41 بدان صفت‌که تفاخر به نام مام‌کند %~% کس ار زباب پژوهش نماید از استر(@)(@@) 42 به خشم‌ گفتمش ای زشت خوی دست بدار %~% حجاب عصمت آزادگان بخیره مدر(@)(@@) 43 مخور شراب مبر نام میر و حضرت میر %~% قفای شیر مخار و متاع طعن مخر(@)(@@) 44 مگر ندانی ‌کاندر سرای خواجه مراست %~% چه مایه مهتر نیکو نهاد نیک سیر(@)(@@) 45 همه خجسته فعال و همه درست آیین %~% همه 
ms347	 فرشته خصال و همه نکو مخبر(@)(@@) 46 به ویژه پیرو سالار هاشمی هاشم %~% که هست هاشم اعدا به تیغ خارا در(@)(@@) 47 به زهد و پاکی دامان همال با سلمان %~% به صدق و نیکی ایمان نظیر با بوذر(@)(@@) 48 به خنده پاسخم آورد کای سپهر کمال %~% زبان دق مگشای و ز راه حق مگذر(@)(@@) 49 بدان خدای‌ کزین بحر باژگون هرشب %~% هزار زورق سیمین نماید از اختر(@)(@@) 50 بدان مشاطه‌ که بر چهره عروس جهان %~% فروهلد به شب تیره عنبرین چادر(@)(@@) 51 به ذات احمد مرسل‌که‌گشت هستی او %~% ظهور دایره ممکنات را پرگر(@)(@@) 52 به فر حیدر صفدر که ‌گشت هستی او %~% وجود سلسله‌کاینات را مصدر(@)(@@) 53 به حسن عالم سوز و به عشق عالم‌گیر %~% به چشم صورت بین و به ‌کلک صورتگر(@)(@@) 54 به شوق خانه فروش و به ذوق بی‌طاقت %~% به فقر خانه بدوش و به صبر با لنگر(@)(@@) 55 به عشوه‌های پیاپی ز دلبر طماع %~% به ‌گریه‌های دمادم ز عاشق مضطر(@)(@@) 56 به عجز این‌که بده بوسه تا فشانم جان %~% به‌کبر آن‌که مکن مویه تا نیاری زار(@)(@@) 57 که ‌گر به قدح ملکزاده برگشایم لب %~% و یا به طعن بزرگان رادکش چاکر(@)(@@) 58 و‌لی مراست جگرخون ازین که ‌غرچه چند %~% زبابکان همه حیز و ز ما مکان همه غر(@)(@@) 59 در آستانه میرند و نی عجب‌کاخر %~% کند بدیشان در خاصگان میر اثر(@)(@@) 60 هزار مرتبه ما نافزون شنیدستی %~% که یار بد بود از مار بد جانگزای بتر(@)(@@) 61 نه از قرآن زحل مشتری شود منحوس %~% چو از تقارن مریخ زهره ازهر(@)(@@) 62 نه ‌گر به عضوی رنج شقا قلوس افتد %~% به چند روز سرایت ‌کند به عضو دگر(@)(@@) 63 نه صحن مسجد یابد کثافت از سرگین %~% نه قلب مومن ‌گیرد کدورت از کافر(@)(@@) 64 نه قیرگون شود از الفت زگال پرند %~% نه زهرگین شود از صحبت شرنگ شکر(@)(@@) 65 نه شام تاری ‌گردد حجاب چهره روز %~% نه 
ms348	 ابر مظلم آید نقاب پیکر خور(@)(@@) 66 نه صحن‌گلشن‌گردد ز خار وار و زبون %~% نه آب روشن آید ز لای تار و کدر(@)(@@) 67 نه تلخ ‌گردد زاب درمنه طعم دهن %~% نه تار آید ازگرد تیره نور بصر(@)(@@) 68 نه شاخ تازه بخوشد ز الفت لبلاب %~% نه شمع زنده بمیرد ز صحبت صرصر(@)(@@) 69 جواب را ز سر خشم برگشادم لب %~% به طنزگفتمش ا‌ی سرو قد سیمین بر(@)(@@) 70 سرای میر جهان و بود جهان چونان %~% ندارد از بد و خوب و پلید و پاک ‌گذر(@)(@@) 71 رواق خواجه بود بحر و بحر بی‌پایان %~% سرای میر بود رود و رود پهناور(@)(@@) 72 نه رودگردد از غوطه‌گرز پلید %~% نه بحر آید ز آمیزش براز قذر(@)(@@) 73 بخنده‌ گفت‌ که نیکو تشبهی‌ کردی %~% به رود و بحر و جهان‌کاخ خواجه را ایدر(@)(@@) 74 اگر جهان نبود از چه بر مثال جهان %~% بود هماره دانا گداز و دون‌پرور(@)(@@) 75 ‌وگرنه رود و نه دریا چرا چو خار و حشیش %~% اگر نه رود و نه دریا چرا چو سنگ و گهر(@)(@@) 76 در آن‌ گزیده ‌گرانمایگان نشست نشیب %~% در آن‌ گرفته سبک پایگان ‌قرار زیر(@)(@@) 77 چو این بگفت بخوشید خونم اندر تن %~% چو این بگفت به توفید جانم اندر بر(@)(@@) 78 سرو دمش نه هر آن را که در فراز مقام %~% سرودمش نه هر آن را که در فرود مقر(@)(@@) 79 از آن فراز فزاید ورا نبالت و قدر %~% ازین فرود کم آید ورا جلالت و فر(@)(@@) 80 به‌کاخ خواجه ‌که میزان دانش و هنرست %~% ز فرط وقع بود انحطاط دانشور(@)(@@) 81 نگر دو کفه میزان که مایلست در آن %~% گران به ‌سمت نگون و سبک به سوی زبر(@)(@@) 82 نه بادبان گه طوفان طیاره غرق شود %~% گرش زمام نگیرد گرانی لنگر(@)(@@) 83 در آن مکابره من تندگشته با جانان %~% در آن محاوره من‌ گرم ‌گشته با دلبر(@)(@@) 84 که ناگه از در 
ms349	 پیری خمیده قد چو کمان %~% دمان درآمد با موی شیرگون از در(@)(@@) 85 قدش به هیات‌ گفتی‌ کمان حلاجست %~% شمیده پنبه محلوجش از کرانه سر(@)(@@) 86 مرا ز حالت آن پیر حالتی رو داد %~% که پای‌تا سر حیرت شدم چو نقش صور(@)(@@) 87 همین نه یاد نگارین شدم ز یاد برون %~% که یاد هر دو جهانم شد از خیال بدر(@)(@@) 88 سرودمش چه‌کسی ‌گفت پیریم سیاح %~% گهی چو باد شتابان به بحر وگاه ببر(@)(@@) 89 به دهر دیده بسی سوک و سور و سود و زیان %~% فراز و پست و نشاط و ملال و نفع و ضرر(@)(@@) 90 ز بصره و حلب و شام و مصر و قسطنطین %~% ز نوبه و حبش و چین و روم وکالنجر(@)(@@) 91 همه بدایع ایام‌کرده استیفا %~% ز هر صنایع آفاق‌ گشته مستحضر(@)(@@) 92 سرودش ز نوادر بدیع‌تر سخنی %~% که نقش می نپذیرد چنان به لوح فکر(@)(@@) 93 شنیده ای ز کسی در زمانه‌ گفت بلی %~% شنیده‌ام سخنی غم بر و نشاط آور(@)(@@) 94 قصیده‌ایست موشح به صدهزار حلی %~% چکامه‌ایست مطرز به صدهزار غرر(@)(@@) 95 ز نعت احمد مختار بینیش زینت %~% ز مدح حیدرکرار یابیش زیور(@)(@@) 96 قویم ‌گشته بدو حسن ملت احمد %~% سدیدگشته به دو سور مذهب جعفر(@)(@@) 97 سطور او همه تابنده چون به چرخ نجوم %~% نقوش او همه رخشنده چون به باغ زهر(@)(@@) 98 ز نقش نون خطوطش فلک ‌کند یاره %~% ز شکل میم حروفش فلک‌کند پرگر(@)(@@) 99 بدایتش همه در قدح ‌گردش‌ گردون %~% نهایتش همه در مدح خواجه قنبر(@)(@@) 100 سرودمش‌ ز کدامین ‌کس آن چکامه‌ سرود %~% ز بوالفضایل قاآنی آسمان هنر(@)(@@) 101 بگفت ‌این و به ‌زانو نشست و یال فراخت %~% ز سر نهاده‌ کلاه از میان ‌گشاد کمر(@)(@@) 102 بدان فصاحت ‌کاحسنت خاست از خاره %~% به لحن دلکش برخواند این قصیده زبر PageV1P199(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مباش غره دلا در جهان به فضل و هنر %~% که شاخ فضل و هنر 
ms350	 فقر و فاقه آرد بر(@)(@@) 2 به خاک دانش هرگز مکار تخم امید %~% ز شاخ آهو هرگز مدار چشم ثمر(@)(@@) 3 به مرد سفله مکن در هوای نان تکریم %~% به عرق مرده مزن از برای خون نشتر(@)(@@) 4 کریم اگر نبود بهره‌ کی برد دانا %~% مسیح اگر نبود زنده‌کی شود عاذر(@)(@@) 5 چو راد رفت ز گیهان چه حمق و چه دانش %~% چو مرد رفت ز میدان چه خود و چه معجر(@)(@@) 6 زمانه نیست مگر رذل جوی و رذل‌پرست %~% ستاره نیست مگر دون‌نواز و دون‌پرور(@)(@@) 7 چنان بود طلب مردمی ز مردم دون %~% که ‌کس ‌کند طمع التیام از خنجر(@)(@@) 8 سهر سهم سعادت نهد به شست‌ کسی %~% که فرق می نکند قاب و قوس را زوتر(@)(@@) 9 ز مشک لخلخه سازد جعل خصالی را %~% که اختیار کند پشک را به مشک تتر(@)(@@) 10 کسی‌که باز نداند دخیل را ز روی‌ %~% کسی‌که فرق نیارد سهل را ز قمر(@)(@@) 11 زبان طعن ‌گشاید به شعر خاقانی %~% سجل طنز نگارد برای بومعشر(@)(@@) 12 چه روی مهر به قومی ‌که مهرشان همه ‌کین %~% چه رای سود ز خیلی که سودشان همه ضر(@)(@@) 13 به نیش ‌کژدم هرگز بود ز مهر نشان‌ %~% به ناب افعی هرگز بود ز سود اثر(@)(@@) 14 پی سلامت خود در تواتر حدثان %~% هنودوار ندارند باکی از آذر(@)(@@) 15 ز خاربن نکند مرد آرمان رطب %~% ز پارگین نکند شخص آرزوی ‌گهر(@)(@@) 16 پلید جفت پلیدست و پاک همسر پاک %~% ز جنس جنس ندارد به هیچ روی‌ گذر(@)(@@) 17 ز علو قطره از آن‌ها بطست سوی نشیب %~% ز سفل شعله از آ‌ن ساعدست سوی زبر(@)(@@) 18 به دیوپا چکنی مدح سبعه الوان %~% به خنفسا چه بری وصف نافه اذفر(@)(@@) 19 برازی این را خوشتر ز دسته سوری %~% ذبابی آن را بهتر ز بسته شکر(@)(@@) 20 مجو زگنبد نیلوفری وفاق آزانک %~% کس آرزو نکند از سراب نیلوفر(@)(@@) 21 ازین مسدس‌گیتی مدار 
