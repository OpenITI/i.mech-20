ms61	(@)(@@) % أسود إذا لاقوا وطير إذا دعوا % % أيامنهم للمعتدين أشائم % % PageV01P186 41(@)(@@) % تلمظ في الأيسار منهم أساود % % وتهتز في الأيمان منهم أراقم % % 42(@)(@@) % ظماء وما غير الدماء مشارب % % لهن ولا غير القلوب مطاعم % % 43(@)(@@) % عرست الفلا منها غياضا أرومها % % حماة الحمى والصافنات الصلادم % % 44(@)(@@) % إذا ما دنت من شربها أجنت الردى % % وكان جناهن الطلى والجماجم % % 45(@)(@@) % فأنستك يا منصور روض حدائق % % تلاعب فيهن المنى وتنادم % % 46(@)(@@) % يضاحك في أرض الزمرد شمسها % % دنانير من ضرب الحيا ودراهم % % 47(@)(@@) % وألهتك عن ليل كواكبه المها % % وعن أبرج أقمارهن الكرائم % % 48(@)(@@) % وما شغلت يمناك عن بذل ما حوت % % وإن غار منهن الندى والمكارم % % 49(@)(@@) % فخاصمن بيض الهند فيك إلى العلا % % وحق لمن في القرب منك يخاصم % % 50(@)(@@) % فإن عزها من صدق بأسك شاهد % % فقد سنها من عدل حكمك حاكم % % PageV01P187 51(@)(@@) % بيوم إلى الهيجا ويوم إلى الندى % % وما عال مقسوم والا جار قاسم % % 52(@)(@@) % ونوديت يوم الجود للسلم في العدى % % فجدت به والمرهفات رواغم % % 53(@)(@@) % حذارا على إلف الهوى غربة النوى % % وما إلفها إلا الوغى والملاحم % % 54(@)(@@) % وعودتها طعم السباع فأشفقت % % بإغبابه أن تدعيه البهائم % % 55(@)(@@) % وكلفتها رزق الذئاب فأحشمت % % لذيب عوى تحت الدجى وهو صائم % % 56(@)(@@) % ومنيتها نفس ابن شنج فأسمحت % % مسالمة من بعده من تآلم % % 57(@)(@@) % على أن بعض العفو قتل ومغنم % % وما رد ربح الملك في الحرب حازم % % 58(@)(@@) % أ فإن قتيل السيف للذيب مطعم % % وإن قتيل العفو للملك خادم % % 59(@)(@@) % فيا لبروق لم يزلن صواعقا % % على الكفر غيث الأمن منهم ساجم % % 60(@)(@@) % نقطع بالأمس الرقاب ووصلت % % بها اليوم أرحام لهم ومحارم % % PageV01P188 61(@)(@@) % غدت وهي أعراس لهم وعرائس % % وبالأمس موت فيهم ومآتم % % 62(@)(@@) % بعقد بناء أنت شدت بناءه % % وليس له في الأرض غيرك هادم % % 63(@)(@@) % فرنجة أعلاه وقشتل أسه % % وسلمك أركان له ودعائم % % 64(@)(@@) % فملكت تاج الملك تاج مليكة % % لتاجيهما تعنو الملوك الخضارم % % 65(@)(@@) % وتوجتها فوق الأكاليل والذرى % % خوافق تغشاها النسور القشاعم % % 66(@)(@@) % وحليتها بعد الدماليج والبرا % % حليا لآليه القنا والصوارم % % 67(@)(@@) % وضمختها من 
ms62	 طيب ذكرك في الورى % % بأضعاف ما تهدي إليها اللطائم % % 68(@)(@@) % ونظمت آفاق الفلا لزفافها % % خيولا حمت ما قلدتها النواظم % % 69(@)(@@) % منى كان فيها لابن شنج منية % % يغرغر منها راهق الروح كاظم % % 70(@)(@@) % مرجت عليه لج بحرين يلتقي % % على نفسه تياره المتلاطم % % PageV01P189 71(@)(@@) % وغادرته ما بين طودين أطبقا % % حتوفا تصادي نفسه وتصادم % % 72(@)(@@) % وأسلمه الأشياع بوا بقفرة % % سراياك أظار عليه روائم % % 73(@)(@@) % فليس له من ناصر الدين ناصر % % وليس له من عاصم الملك عاصم % % 74(@)(@@) % وقد صدرت عنه خيولك آنفا % % وأحشاؤه فيء لها ومغانم % % 75(@)(@@) % أقاطيع ملء الأرض أصوات خيلها % % وأنعامها عما يكن تراجم % % 76(@)(@@) % يناجي نفوسا حازهن غنائما % % بأمنك قد حانت عليها المغارم % % 77(@)(@@) % وأفعال خفض كنت تشكلها له % % برفعك قد أوفت عليها الجوازم % % 78(@)(@@) % بغزوة ميمون النقيبة ثائر % % عزائمه في الناكثين هزائم % % 79(@)(@@) % وكم طمست عينيه برقة مقدم % % تلألأ فيها مجدك المتقادم % % 80(@)(@@) % تجللها جداك عمرو وتبع % % وأعقبها عماك كعب وحاتم % % PageV01P190 81(@)(@@) % ومن أعربت فيه أعاظم يعرب % % فمستصغر في أصغريه العظائم % % 82(@)(@@) % مآثر لم يسبق إليهن سابق % % ولا رامها من قبل سعيك رائم % % 83(@)(@@) % كسا العرب العرباء منهن مفخر % % تصلب منه للوجوه الأعاجم % % 84(@)(@@) % وشدت بها في الروم والقوط رفعة % % تسامي بها عند السها وتزاحم % % 85(@)(@@) % وصرت بها أقلام ضيفك صرة % % تصر لها الآذان بصرى وجاسم % % 86(@)(@@) % فزودها الركبان شرقا ومغربا % % ووافت بها جمع الحجيج المواسم % % 87(@)(@@) % وما لي لا أبلي بذكرك في الورى % % بلاء تهاداه القرون النواجم % % 88(@)(@@) % وأطلعه شمسا على كل أمة % % يكذب فيها عن سنا الشمس زاعم % % 89(@)(@@) % فيحسدني فيك العراق وشامه % % وإياك في عبد شمس وهاشم % % 90(@)(@@) % بخست إذن سعيي إليك وهجرتي % % وما حملت مني إليك المناسم % % PageV01P191 91(@)(@@) % وبين ضلوعي بضع عشرة مهجة % % ظماء إلى جدوى يديك حوائم % % 92(@)(@@) % تلذ الليالي لحمها ودماءها % % وطعم الليالي عندهن علاقم % % 93(@)(@@) % قطعت بهن الليل والليل جامد % % وخضت بهن الآل والآل جاحم % % 94(@)(@@) % إذا ملأ الهول المميت صدورها % % تحرك من ذكراك فيها تمائم % % 95(@)(@@) % على شدنيات تطير بركنها % % إليك 
ms63	 خطوب في القلوب جواثم % % 96(@)(@@) % فكم غال من أجسامها غول قفرة % % وخرم على ألبابهن المخارم % % 97(@)(@@) % وكم عجزت عنا ذوات قوائم % % فعجنا بعوج ما لهن قوائم % % 98(@)(@@) % جاجئ غربان تطير لنا بها % % على مثل أطواد الفيافي نعائم % % 99(@)(@@) % لها من أعاصير الشمال إذا هوت % % خواف ومن عصف الجنوب قوادم % % 100(@)(@@) % يحاجى بها ما حامل وهو راقد % % وما طائر في جوه وهو عائم % % PageV01P192 101(@)(@@) % سرت من عصا موسى إليه قرابة % % فطب بفلق البحر والصخر عالم % % 102(@)(@@) % وشاهد لقم الحوت يونس فاقتدى % % فغاد وسار وهو للسفر لاقم % % 103(@)(@@) % أعوذ بقرع الموج في جنباتها % % إليك بنا أن يقرع السن نادم % % 104(@)(@@) % وما عبرت عنه جسوم نواحل % % وما حسرت عنه وجوه سواهم % % 105(@)(@@) % وما كتبت في واضحات وجوهنا % % إليك الدياجي والرياح السمائم % % 106(@)(@@) % فلا رجعت عنك الأماني حسيرة % % ولا فزعت منا لديك التمائم % % 107(@)(@@) % ولا ختمت عنك الليالي سريرة % % ولا فضت الأيام ما أنت خاتم % % 108(@)(@@) % ولا نظم الأعداء ما أنت ناثر % % ولا نثر الأعداء ما أنت ناظم % % 109(@)(@@) % ولا عدم الإشراك أنك ظافر % % ولا عدم الإسلام أنك سالم % % 110(@)(@@) % ولا زال للسيف الحنيفي قائم % % وأنت به في طاعة الله قائم % % PageV01P193 111(@)(@@) % جهاد على الكفار بالنصر مقدم % % ووجه على الإسلام بالفتح % % PageV01P194 البحر : كامل تام 1(@)(@@) % قل للربيع اسحب ملاء سحائب % % فاجرر ذيولك في مجر ذوائبي % % 2(@)(@@) % لا تكدين ومن ورائك أدمعي % % مددا إليك بفيض دمع ساكب % % 3(@)(@@) % وصبابة أنفاسها لك أسوة % % إن ضاق ذرعك بالغمام الصائب % % 4(@)(@@) % وامزج بطيب تحيتي غدق الحيا % % فاجعله سقي أحبتي وحبائبي % % 5(@)(@@) % عهدا كعهدك من عهاد طالما % % كست البرود معاهدي وملاعبي % % 6(@)(@@) % واجنح لقرطبة فعانق تربها % % عني بمثل جوانحي وترائبي % % 7(@)(@@) % حيث استكانت للعفاء منازلي % % وهوت بأفلاذ الفؤاد نجائبي % % 8(@)(@@) % ذللا تعسفن الدجى بأذلة % % ولواغبا جبن الفلا بلواغب % % 9(@)(@@) % وكواكب ناءت بغربتها النوى % % فقضت مدامعها بنوء الغارب % % 10(@)(@@) % من كل مفجوع بترحة راحل % % لم يسله طمع بفرحة آيب % % PageV01P195 11(@)(@@) % كذبته بارقة المنى عن صادق % % من ظنه وصدقنه عن كاذب 
ms64	 % % 12(@)(@@) % ظعن سرين الليل ضربة لازم % % وسرى إليها الهم ضربة لازب % % 13(@)(@@) % جمدت عليهن القلوب فأسبلت % % فوق المحاجر كل قلب ذائب % % 14(@)(@@) % وتخازرت عنها العيون فأبرزت % % عن أعين بدمائهن سواكب % % 15(@)(@@) % وتقطعت أسبابهن لطية % % وصلت بهن سباسبا بسباسب % % 16(@)(@@) % يطلبن شأو غرائب لي كلما % % نأت البلاد حللن غير غرائب % % 17(@)(@@) % لحقت بأسباب السماء فأعطيت % % فيها خلود أهلة وكواكب % % 18(@)(@@) % وأعدت الأزمان ماء شبابها % % لحنو ظهر أو لرأس شائب % % 19(@)(@@) % وعقدن بالأبد الأبيد وإن نأى % % حلفين حلف مساير ومعاقب % % 20(@)(@@) % ما بل بحر صوفة وتقاذفت % % أمواجه بشمائل وجنائب % % PageV01P196 21(@)(@@) % هدما إلى هدم وحفظ دم دما % % حدب بعطف مشاكه ومناسب % % 22(@)(@@) % زهر طوالعها لكل غد غد % % وجزاؤها رهن بأمس الذاهب % % 23(@)(@@) % تشدو بها خضر الحمام وحظها % % عنقاء ريعت بالغراب الناعب % % 24(@)(@@) % الأرض التي هي فاركي % % وكسوتها الدهر الذي هو سالبي % % 25(@)(@@) % وملأت منهن العقول عجائبا % % ولنقص حظي من تمام عجائبي % % 26(@)(@@) % غربت الرغائب والمسيح مورثي % % إحياء آثاري وخلد مناقبي % % 27(@)(@@) % شوارد في الأرض غير أوابد % % وطوالع في الجو غير غوارب % % 28(@)(@@) % وقد قضيت من الصبابة حقها % % فقضت من الأمل البعيد مآربي % % 29(@)(@@) % فمنها الصبر الجميل فأسفرت % % في آل يحيى عن جميل عواقب % % 30(@)(@@) % وشددت عقد ختامها فاستفتحت % % بمكارم المنصور ضيق مذاهبي % % PageV01P197 31(@)(@@) % فهل أنت يا زمن الربيع مبلغ % % بالمغربين أحبتي وأقاربي % % 32(@)(@@) % أن الربيع لدي شيمة قاطن % % وحيا الغمام علي ديمة دائب % % 33(@)(@@) % من بعد ما غم الصباح لناظري % % واشتف مني البحر جرعة شارب % % 34(@)(@@) % وأنست بالأهوال حتى لم أبل % % ألقاء أسد أم لقاء ثعالب % % 35(@)(@@) % لم أنشبت في الخطوب مخالبا % % حتى انثنت عني بغير مخالب % % 36(@)(@@) % وشفيت سم عقارب بأساود % % ودفعت سم أساود بعقارب % % 37(@)(@@) % حتى تزفن سمومهن فلم يرع % % من نافثات السم ليل الحاطب % % 38(@)(@@) % وسدكت بالغمرات حتى بلدت % % فرمين حبلي فوق ذروة غارب % % 39(@)(@@) % ادراكتني ذمة من يعرب % % مطرت علي ثمار جنة مارب % % 40(@)(@@) % فهناك أنصلت الأسنة وانتحى % % سيفي بها مسحا بسوق ركائبي % % PageV01P198 41(@)(@@) % ورفعت نارا للعيون وقودها % % أقتاب 
ms65	 أحداجي ووقر حقائبي % % 42(@)(@@) % نعم تكاد ترد أيام الصبا % % وتعيد أزمان النعيم الذاهب % % 43(@)(@@) % أيام ألقى الصبح ترب كواكب % % أدبا وأحيي الليل خلب كواعب % % 44(@)(@@) % والمكرمات منازلي ومشاهدي % % والمقربات مراكبي ومراقبي % % 45(@)(@@) % إذا أنت يا زمن الربيع مخيم % % في ساحلي ومغيم من جانبي % % 46(@)(@@) % عبق الروائح من نثير غدائري % % غدق السحائب من فضول مشاربي % % 47(@)(@@) % وتروح مغتبقا شمول شمائلي % % وتعود مصطبحا ضريب ضرائبي % % 48(@)(@@) % تغدو فتستملي بديع محاسني % % وتروح تستقري نفيس غرائبي % % 49(@)(@@) % وتبيت تنشر في الأباطح والربى % % زهرا يخبر عنك أنك كاتبي % % 50(@)(@@) % مما ترف به رياض حدائقي % % ويفيض جوهره عباب غواربي % % PageV01P199 51(@)(@@) % فنظمتها في كل أفق ناذح % % وبعثتها مع كل نجم ثاقب % % 52(@)(@@) % ونظمت يا منصور ذكرك وسطها % % نظم العقود على ترائب كاعب % % 53(@)(@@) % ذكر على الألباب أكرم نازل % % وعلى فجاج الأرض أوضح راكب % % 54(@)(@@) % سور لمجدك رفعت آياتها % % أعلام آدابي وذكر مناقبي % % 55(@)(@@) % فواتح من كل مدح سائر % % وخواتم من كل حمد ذاهب % % 56(@)(@@) % استشرف الثقلان أخطب شاعر % % وأصاخت الدنيا لأشعر خاطب % % 57(@)(@@) % فخطبت والعواء بعض منابري % % وأممت والجوزاء بعض محاربي % % 58(@)(@@) % وكتبت منها لليالي مصحفا % % تتلوه ألسنة الزمان الدائب % % 59(@)(@@) % حتى تركت سناء ملكك حاضرا % % في كل أفق عن بلادك غائب % % 60(@)(@@) % وجلوت للدنيا مثالك في الوغى % % تختال بين ذوابل وقواضب % % PageV01P200 61(@)(@@) % وأريتك الأمم الخلوف متوجا % % بخوافق ومكللا بكتائب % % 62(@)(@@) % ورفعت ستر الليل عنك لغابر % % ومقدم ومباعد ومقارب % % 63(@)(@@) % حتى أريتهم السنا تحت الدجى % % وخيال سار في مخيلة سارب % % 64(@)(@@) % طيار بارقة الوغى بمقادم % % كقوادم ومواكب كمناكب % % 65(@)(@@) % حتى ابن شنج يوم أمك خاضعا % % تسعى إليك به ندامة تائب % % 66(@)(@@) % من بعد ما راز البلاد فلم يجد % % في الأرض عن مأواك مهرب هارب % % 67(@)(@@) % ورأى الضلال عليك أضعف ناصر % % ورأى الفرار إليك أيمن صاحب % % 68(@)(@@) % ودعاك معترفا بذلة مذنب % % وأتاك مشتملا بمبسة راهب % % 69(@)(@@) % ولقد تراءت في ذراك مطالعي % % حين استبد تغربي بمغاربي % % 70(@)(@@) % فختمت طول تقلبي بتقبلي % % وجزيت غر غوائبي برغائب % % PageV01P201 71(@)(@@) % وأجرتني من كل 
ms66	 خطب طارق % % حتى مناجاة الرجاء الخائب % % 72(@)(@@) % ووجدت عند يديك سد مفارقي % % وسلو أحزاني وبرء مصائبي % % 73(@)(@@) % ولقد تجلى العيد عنك بغرة % % جلاءة لفوادح وغياهب % % 74(@)(@@) % يتلوك حاجبك الذي أنجبته % % كالشمس إذ ضربت إليك بحاجب % % 75(@)(@@) % في مشهد بسد جبينك مشرق % % شرق بآساد وجرد سلاهب % % 76(@)(@@) % غر تواعد للطعان صواهل % % تختال بين مخاطب ومجاوب % % 77(@)(@@) % حتى ارتقيت سرير ملكك حفه % % نور السرور جوانبا بجوانب % % 78(@)(@@) % ومددت للتقبيل راحة منعم % % تنهل أنملها بحور مواهب % % 79(@)(@@) % وتكاد تهتف عنك هل من راغب % % أو راهب أو خائف أو طالب % % 80(@)(@@) % فاسلم وكن للأرض آخر عامر % % ولغالب الأعداء أول غالب % % PageV01P202 البحر : طويل 1(@)(@@) % أبى الله إلا أن يرى يدك العليا % % فيبليها سعدا وتبليه سعيا % % 2(@)(@@) % ويوسعها سقيا ورعيا كمثل ما % % سمت للمنى سقيا وسامت بها رعيا % % 3(@)(@@) % وأي حيا في الشرق والغرب للورى % % وأي حمى للملك والدين والدنيا % % 4(@)(@@) % وأي فتى والنفس كاذبة المنى % % وأي فتى والحرب صادقة الرؤيا % % 5(@)(@@) % علا فحوى ميراث عاد وتبع % % بهمته العليا ونسبته الدنيا % % 6(@)(@@) % فأعرب عن إقدام يعرب واحتبى % % فلم ينس من هود سناء ولا هديا % % 7(@)(@@) % ومن حمير رد القنا أحمر الذرى % % ومن سبإ قادت كتائبه السبيا % % 8(@)(@@) % وما نام عنه عرق قحطان إذ فدى % % عروق الثرى من غلة القحط بالسقيا % % 9(@)(@@) % ولا أسكنت عنه السكون سيادة % % ولا رضيت طي لراحته طيا % % 10(@)(@@) % ولا كندت أسيافه ملك كندة % % فيترك في أركان عزتها وهيا % % PageV01P203 11(@)(@@) % ولا أقعدته عن إجابة صارخ % % تجيب ولو حبوا إلى الطعن أو مشيا % % 12(@)(@@) % وكائن له في الأوس من حق أسوة % % بنصر الهدى جهرا وبذل الندى خفيا % % 13(@)(@@) % هم أورثوه نصر دين محمد % % وحازوا له فخر الندى والقرى وحيا % % 14(@)(@@) % وهم أوجدوه الجود أعذب مطعما % % من الريقة الشنباء في الشفة اللميا % % 15(@)(@@) % مناقب أدوها إليه وراثة % % فكان لها صدرا وكان له حليا % % 16(@)(@@) % وروضة ملك عاهدتها عهاده % % فأغدق بها ريا وأعبق بها ريا % % 17(@)(@@) % وصوت ثناء أسمع الله ذكره % % ليسمع منه الصم أو يهدي 
ms67	 العميا % % 18(@)(@@) % لمن يلحظ الأعلين في المجد من عل % % وجارى فأعيا السابقين وما أعيا % % 19(@)(@@) % أنيس القلوب في الصدور ولم يكن % % ليوحش مثواه الفراقد والجديا % % 20(@)(@@) % ومورد من أظمأ وإصباح من سرى % % ومبرك من أعيا وغاية من أعيا % % PageV01P204 21(@)(@@) % فقصر ملوك الأرض سدة قصره % % وإن سحقوا بعد وإن شحطوا نأيا % % 22(@)(@@) % وأهدت له بغداد ديوان علمها % % هدية من والى ونخبة من حيا % % 23(@)(@@) % فكانت كمن حيا الرياض بزهرها % % وأهدى إلى صنعاء من نسجها وشيا % % 24(@)(@@) % وحسب رواة العلم أن يتدارسوا % % مآثره حفظا وآثاره وعيا % % 25(@)(@@) % ويكفي ملوك الأرض من كل مفخر % % إذا امتثلوا من بعض أفعاله شيا % % 26(@)(@@) % وأن يسمعوا من ضيفه في ثنائه % % غرائب حلى من جواهرها الدنيا % % 27(@)(@@) % وأن ينظروا كيف ازدهى مفرق العلا % % بعقدي له تاجا من الكلم العليا % % 28(@)(@@) % أوابد حالفن الليالي أنها % % تموت الليالي وهي باقية تحيا % % 29(@)(@@) % لمن كفل الإسلام أم سيادة % % فبرت به حجرا ودرت له ثديا % % 30(@)(@@) % ومن ذعر الأعداء حتى توهموا % % به الصبح جيشا والظلام له دهيا % % PageV01P205 31(@)(@@) % لطاعة من وصى المنايا بطوعه % % فلم تعصه من الشرك أمرا ولا نهيا % % 32(@)(@@) % فكم رأس كفر قد أنافت برأسه % % من الصرعة السفلى إلى الصعدة العليا % % 33(@)(@@) % فأوفت به في مرقب السور كالحا % % يؤذن بالأعداء حي هلا حيا % % 34(@)(@@) % ونقلي الصبا منه ذوائب لمة % % تفاخر أيدي المصيبات بها فليا % % 35(@)(@@) % فهامته للهام تستامها القرى % % وأشلاؤه للريح تستامها السفيا % % 36(@)(@@) % وكم رد عن نفس ابن شنج سهامها % % وقد أغرقت نزعا وأمكنها رميا % % 37(@)(@@) % طليقك من كف الإسار وقد هوت % % به الرقم الرقماء والموبد الدهيا % % 38(@)(@@) % فحكمت فيه حد سيفك فاقتضى % % وشاورت فيه الفضل فاستعجم الفتيا % % 39(@)(@@) % فأخرت عنه حكم بأسك بالردى % % وأمضيت فيه حكم عفوك بالبقيا % % 40(@)(@@) % ووقيته حر الحمام لو اتقى % % وزودته برد الحياة لو استحبا % % PageV01P206 41(@)(@@) % فأفلت ينزو في حبائل غدرة % % بأوت بها عزا وباء بها خزيا % % 42(@)(@@) % فأتبعته تحت العجاجة راية % % بهرت بها رايا وأعيتها رأيا % % 43(@)(@@) % وجردت سيف الحق مدرع الهدى 
ms68	 % % لمن سل سيف النكث وادرع البغيا % % 44(@)(@@) % وأعليتها في دعوة الحق دعوة % % كفاك بها بشرى وأعداءها نعيا % % 45(@)(@@) % فجاءتك تحت الخافقات كتائبا % % كما حدت الأفلاك أنجمها جريا % % 46(@)(@@) % مهلين بالنصر العزيز لمن دعا % % ملبين بالفتح المبين لمن أيا % % 47(@)(@@) % بكل أمير طوع يمناك جيشه % % وطاعتك العلياء غايته القصيا % % 48(@)(@@) % وكل كمي في مناط نجاده % % دواء لداء الناكثين إذا أعيا % % 49(@)(@@) % وإن لم يبق داء ابن شنج بطبه % % فقد بلغت أدواؤه النار والكيا % % 50(@)(@@) % بسابحة الأجياد في كل لجة % % تريك عباب البحر من هو لها حسيا % % PageV01P207 51(@)(@@) % قدحت بأيديها صفا الشرك قدحة % % جعلت ضرام المشرفي لها وريا % % 52(@)(@@) % خواطف إبراق جلاهن عارض % % من النقع لا يوني دماء العدى مريا % % 53(@)(@@) % عقدن بأيمان الضراب وعوقدت % % بأيمان عهد لا انثناء ولا ثنيا % % 54(@)(@@) % وزرقا تشكى من ظماء كعوبها % % وتسقي ربوع الكفر من دمه ريا % % 55(@)(@@) % إذا غربت ناءت بمنهمر الكلى % % وإن طلعت فاءت بملء الملا فيا % % 56(@)(@@) % فأبت بأعداد النجوم مساعيا % % وأمثالها سمرا وأضعافها سبيا % % 57(@)(@@) % وجوها سلبن العصب والحلي فاكتست % % محاسن أنسين المجاسد % % 58(@)(@@) % كأن لم تدع بالبيد أيكا ولا غضى % % ولا في شعاب الرمل خشفا ولا ظبيا % % 59(@)(@@) % إياب مليك قلدت عزماته % % من الرشد والتوفيق ما دمر الغيا % % 60(@)(@@) % يقر عيون الخيل في حومة الوغى % % إذا ما قدور الحرب فارت بها غليا % % PageV01P208 61(@)(@@) % ويعرض عن فرش القصور وثيرة % % ليركب ظهر الحرب محدودبا عريا % % 62(@)(@@) % ويحسو ذعاف السم في جاحم الوغى % % ليروي آمال النفوس بها أريا % % 63(@)(@@) % ويصلي بحر الشمس حر جبينه % % ليبسط للإسلام من نوره فيا % % 64(@)(@@) % ويا شامتا أني طريد حجابه % % ليخزك أني حزته بين جنبيا % % 65(@)(@@) % ويا حاجبا قد رد طرفي دونه % % تأمل تجده وهو إنسان عينيا % % 66(@)(@@) % صفاء وداد إن رمى فوقه القذى % % ظنونا من الاشفاق طيرها نفيا % % 67(@)(@@) % وصدق رجاء كلما مت رحمة % % على مثل أفراخ القط ردني حيا % % 68(@)(@@) % ظماء وما يدرون في الأرض مشربا % % سوى كبدي الحرى ومهجتي الظميا % % 69(@)(@@) % وكم عسفوا بحرا ولا بحر 
ms69	 للندى % % وخاضوا سراب البيد نهيا ولا نهيا % % 70(@)(@@) % وماتوا يراعون النجوم وقد رأت % % وسائلهم ألا حفاظ ولا رعيا % % PageV01P209 71(@)(@@) % ولا خلة إلا الهجير إذا التظى % % فكان لهم جمرا وكانوا له شيا % % 72(@)(@@) % ولا نسب إلا الثريا إذا انتحت % % فكانت لهم نصفا وكانوا لها ثنيا % % 73(@)(@@) % وكم زجروها باسمها وخفوقها % % فما صدقتهم لا ثراء ولا ثريا % % 74(@)(@@) % ولا صدق إلا للرجاء الذي سرى % % فقصر طول الليل واستقرب النأيا % % 75(@)(@@) % وبارى هوي الريح يسبقها هوى % % وغال قفار البيد ينسفها طيا % % 76(@)(@@) % إلى سابق الأملاك علم سيفه % % ندى كفه أن يسبق الوعد والوأيا % % 77(@)(@@) % أبو الحكم الممضي لحكم عفاته % % رغائب لا يعرفن سوفا ولا ليا % % 78(@)(@@) % ومثل لي في الحرب حسر ذراعه % % بحسري في حرب الخطوب ذراعيا % % 79(@)(@@) % إذا لمعت بيض الصورام حوله % % كإضرام نيران الهموم حواليا % % 80(@)(@@) % وقد عاذ أبطال الجلاد بعطفه % % كما عاذ أطفال الجلاء بعطفيا % % PageV01P210 81(@)(@@) % وقد قصرت عنه رماح عداته % % كما قصرت عنهم رياش جناحيا % % 82(@)(@@) % ولكن أواسي بين عار ولابس % % أقلص عن ذيا لأثني على تيا % % 83(@)(@@) % وإن لوت اللألواء من شأو همتي % % وألحق ذل العسر وجهي بنعليا % % 84(@)(@@) % فلم تلو عن مدح ابن يحيى مدائحي % % بأطيب ذكر في الممات وفي المحيا % % 85(@)(@@) % يصيخ إليه كل سمع موقر % % ويجلو سناه كل ناظرة عميا % % 86(@)(@@) % وأنشيك عنه المسك ما عشت يا ورى % % وأكسوك منه الدر ما دمت يا دنيا % % 87(@)(@@) % وإن برت الأيام من حد همتي % % وفلت سلام الحادثات غراريا % % 88(@)(@@) % فهل قلم خطت به الأرض كلها % % نظاما ونثرا ينكر القط والبريا % % 89(@)(@@) % وزند ينير الشرق والغرب قدحه % % جدير بأن يستلحق المحق والوهيا % % 90(@)(@@) % ويا لك من ذكرى سناء ورفعة % % إذا وضعوا في الترب أيمن جنبيا % % PageV01P211 91(@)(@@) % وفاحت ليالي الدهر مني ميتا % % فأخزين أياما دفنت بها حيا % % 92(@)(@@) % وكان ضياعي حسرة وتندما % % إذا لم يفد شيئا ولم يغنني شيا % % 93(@)(@@) % وأصبحت في دار الغنى عن ذوي الغنى % % وعوضت فاستقبلت أسعد يوميا % % 94(@)(@@) % سوى حسرتي عرض ووجه تضعضعا % % لقارعة البلوى 
ms70	 وكانا عتاديا % % 95(@)(@@) % وللستر والصبر الجميل تأخرا % % فأمهما حرصي وكانا إماميا % % 96(@)(@@) % فيا عبرتي سحي لعلي مبلل % % ببحريك ما أنزفت من ماء عينيا % % 97(@)(@@) % ويا زفرتي هل في وقودك جذوة % % تنير لنا صبحا ثناه الأسى مسيا % % 98(@)(@@) % ويا خلتي إن سوف الغوث بالمنى % % ويا غلتي إن أبطأ الغيث بالسقيا % % 99(@)(@@) % قوما إلى رب السماء فأسعدا % % نقلب وجهي في السماء وكفيا % % 100(@)(@@) % سقى ميت الأظماء في روضة الندى % % سيرجع عن رب السماء وقد أحيا % % PageV01P212 101(@)(@@) % ويا أوجه الأحرار لا تتبدلي % % بظل ابن يحيى بعد ظلا ولا فيا % % 102(@)(@@) % ويا حلبة الآمال زيدي على المدى % % بقاء ابن يحيى ثم حيي على يحيى % % PageV01P213 البحر : كامل تام 1(@)(@@) % أوجفت خيلي في الهوى وركابي % % وقذفت نبلي بالصبا وحرابي % % 2(@)(@@) % وسللت في سبل الغواية صارما % % عضبا ترقرق فيه ماء شبابي % % 3(@)(@@) % حتى افتتحت عن الأحبة معقلا % % وعر المسالك مبهم الأبواب % % 4(@)(@@) % ووقفت موقف عاشق حلت له % % فيه غنيمة كاعب وكعاب % % 5(@)(@@) % بحدائق الحدق التي لاقينني % % بأحد من سيفي ومن نشابي % % 6(@)(@@) % في تربة جاد النعيم رياضها % % فتفتحت بنواعم أتراب % % 7(@)(@@) % من كل مغنوم لقلبي غانم % % عشقا ومسبي لعقلي ساب % % 8(@)(@@) % في جنح ليل كالغراب أطارلي % % عن ملتقى الأحباب كل غراب % % 9(@)(@@) % وجلا لعيني كل بدر طالع % % قمن بهتك حجابه وحجابي % % 10(@)(@@) % جاب الظلام فلم يدع من دجنه % % إلا غدائر شعره المنجاب % % PageV01P214 11(@)(@@) % ففنيت بين ضيائه وظلامه % % مغرى الجفون بطرفه المغرى بي % % 12(@)(@@) % فإذا كتبت بناظري في قلبه % % أخفى فخط بناظريه جوابي % % 13(@)(@@) % وإذا سقاني من عقار جفونه % % أبقى علي فشجها برضاب % % 14(@)(@@) % وسلافة الأعناب تشعل نارها % % تهدى إلى بيانع العناب % % 15(@)(@@) % كل يشاركه ماوراء جوانحي % % للشوق من ضرم ومن إلهاب % % 16(@)(@@) % حتى افتتحت عن الأحبة معقلا % % وعر المالك مبهم الأبواب % % 17(@)(@@) % ووقفت موقف عاشق حلت له % % فيه غنيمة كاعب وكعاب % % 18(@)(@@) % بحدائق الدق التي لاقينني % % وبأحد من سيفي ومن نشابي % % 19(@)(@@) % في تربة جاد النعيم رياضها % % فتفتحت بنواعم أتراب % % 20(@)(@@) % من كل مغنوم لقلبي غانم % % عشقا 
ms71	 ومسبي لعقلي ساب % % PageV01P215 21(@)(@@) % في جنح ليل كالغراب أطارلي % % عن ملتقى الأحباب كل غراب % % 22(@)(@@) % وجلا لعيني كل بدر طالع % % قمن بهتك حجابه وحجابي % % 23(@)(@@) % جاب الظلام فلم يدع من دجنه % % إلا غدائر شعره المنجاب % % 24(@)(@@) % بين ضيائه وظلامه % % مغرى الجفون بطرفه المغرى بي % % 25(@)(@@) % فإذا كتبت بناظري في قلبه % % أخفى فخط بناظريه جوابي % % 26(@)(@@) % وإذا سقاني من عقار جفونه % % أبقى علي فشجها برضاب % % 27(@)(@@) % وسلافة الاعناب تشعل نارها % % تهدي إلى بيانع العناب % % 28(@)(@@) % فسكرت والأيام تسلب جدتي % % والدهر ينسج لي ثياب سلابي % % 29(@)(@@) % سكرين من خمرين كان خمارها % % فقد الشباب وفرقة الأحباب % % 30(@)(@@) % لمدى تناهى في الغواية فانتهى % % فينا إلى أمد له وكتاب % % PageV01P216 31(@)(@@) % وهوى تقاصر بالمنى فأطال بي % % هما إلى قلبي سرى فسرى بي % % 32(@)(@@) % في جاهلية فتنة عبدت بها % % دون الإله مضلة الأرباب % % 33(@)(@@) % بتستقسم الأزلام في مهجاتنا % % وتسيل أنفسنا على الأنصاب % % 34(@)(@@) % غيرا من الأيام أصبح ماؤها % % غورا وأعقب صفوها بعقاب % % 35(@)(@@) % وبوارقا للغي أضرم نورها % % نارا وصاب غمامها بالصاب % % 36(@)(@@) % فلها فقدت النفس إلا قدر ما % % أشجى به لحلول كل مصاب % % 37(@)(@@) % وبها رزيت الأهل إلا لابسا % % بؤسا يزيد به أليم عذابي % % 38(@)(@@) % وبها رفعت حجاب ستري عن مها % % تركت شبا قلبي بغير حجاب % % 39(@)(@@) % وجلوت في خطب الجلاء عقائلا % % قصرت عنها همة الخطاب % % 40(@)(@@) % سرب المقاصر والملاعب صنته % % فأطرتهن مع القطا الأسراب % % PageV01P217 41(@)(@@) % ذعرت بحس الإنس تحت حجالها % % واستأنست بضراغم وذئاب % % 42(@)(@@) % ونزت بهن عن الأرائك روعة % % مهدت لهن حزون كل يباب % % 43(@)(@@) % فطوين آفاق البلاد لطية % % تأبى لها الأيام يوم إباب % % 44(@)(@@) % وإليك يا منصور حط رحالها % % دأب السرى واليعملات ودابي % % 45(@)(@@) % وبحور هم كم وكم داويتها % % ببحور يم أو بحور سراب % % 46(@)(@@) % وشباب ليل طالما بلغته % % تخطيط شيب أو نصول خضاب % % 47(@)(@@) % فوصلت يا منصور منا غربة % % مقطوعة الأنساب والأسباب % % 48(@)(@@) % ووقيتني ريب الخطوب بمنة % % جلت اليقين لظني المرتاب % % 49(@)(@@) % وشملتني بشمائل ذكرنني % % في طيبها طوبى وحسن مآب % % 50(@)(@@) % وأقمت لي سوق 
ms72	 المكارم مغليا % % بجواهر الإبداع والإغراب % % PageV01P218 51(@)(@@) % ورضاك رد لي الرضا في أوجه % % من خزر أيام علي غضاب % % 52(@)(@@) % وهداك أشرق لي وليلي مظلم % % وسناك أبرق لي وزندي كاب % % 53(@)(@@) % وجداك داواني ودائي معضل % % وذراك أواني ورحلي ناب % % 54(@)(@@) % فحللت منه خير دار مقامة % % وثويت منه في أعز جناب % % 55(@)(@@) % وأسمت في أزكى البقاع صوافني % % وضربت في أعلى اليفاع قبابي % % 56(@)(@@) % وشويت للأضياف لحم ركائبي % % في نار أحلاسي وفي أقتابي % % 57(@)(@@) % عوضا من الوطن الذي أصبحت من % % أسلابه إذ كان من أسلابي % % 58(@)(@@) % ولقد جبرت برغم دهر ضامني % % ما أخلقت عصراه من أثوابي % % 59(@)(@@) % خلعا رفعت بفخرها وسنائها % % ما ضاع من قدري ومن آدابي % % 60(@)(@@) % كل ينادي في البرية معلنا % % هذي مواهب منذر الوهاب % % PageV01P219 61(@)(@@) % فلأهدين من طيب ذكرك في الورى % % وقر الركاب وذخرة الركاب % % 62(@)(@@) % ولأكتبن منها على صحف العلا % % غرر الكتاب وغرة الكتاب % % 63(@)(@@) % ولأجلون منها لأبصار النهى % % حر الخطاب وحرة الخطاب % % 64(@)(@@) % ولأجعلن ثناءها وجزاءها % % أبد الأبيد وعاقب الأعقاب % % 65(@)(@@) % ولأتركن خلودها ونشيدها % % دين العصور وملة الأحقاب % % 66(@)(@@) % حتى يعود الدهر بدع شريعة % % بعلاك والأيام أهل كتاب % % 67(@)(@@) % وتراك بعدك أمة لم تلقها % % عين اليقين وجهرة الألباب % % 68(@)(@@) % حتى يروا كرات خيلك في الوغى % % لوحى طعان أو وحي ضراب % % 69(@)(@@) % ويروا سيوفك في الجماجم والطلى % % وسنا بينك في العجاج الهابي % % 70(@)(@@) % إلى الأقران منك منازلا % % إقدام ليث وانقضاض عقاب % % PageV01P220 71(@)(@@) % ويروك حزب الله حزبك والعدى % % بسيوفه مفلولة الأحزاب % % 72(@)(@@) % هذا وكم أعززت في دين الهدى % % من منبر وحميت من محراب % % 73(@)(@@) % ومعاد عيد عدت في إغبابه % % بمكارم كرمت عن الإغباب % % 74(@)(@@) % فكسوت فيه الأرض سابغ حلة % % نسجت بأسد شرى ومأشب غاب % % 75(@)(@@) % وسوابق رد الجهاد جيادها % % قب البطون لواحق الأقراب % % 76(@)(@@) % ولوامع أشرعتهن فأشرقت % % إشراق ملكك في سنا الأحساب % % 77(@)(@@) % وخوافق حفت بوجهك فاحتذت % % شمس النهار تجللت بسحاب % % 78(@)(@@) % حتى انتهيت إلى المصلى لابسا % % عز المليك ورقة الأواب % % 79(@)(@@) % في منظر عجب وأعجب شأنه % % ما ذم من كبر 
ms73	 ومن إعجاب % % 80(@)(@@) % وهدى واتقى % % وزكا فكنت له أجل ثواب % % PageV01P221 81(@)(@@) % فالله يرزقنا بقاءك سالما % % رزقا نوفاه بغير حساب % % 82(@)(@@) % وانصر ومن والاك حلف كرامه % % واقهر ومن عاداك رهن تبابب % % PageV01P222 البحر : طويل 1(@)(@@) % لك الفوز من صوم زكي ومن فطر % % وصلتهما بالبر شهرا إلى شهر % % 2(@)(@@) % فناطق صدق عنك بالصدق والنهى % % وشاهد عدل فيك بالعدل والبر % % 3(@)(@@) % فهذا بما استقبلت من صائب الندى % % وهذا بما زودت من وافر الذخر % % 4(@)(@@) % فكم شافع في ظلك الصوم بالتقى % % وكم واصل في أمنك الليل بالذكر % % 5(@)(@@) % وكم ساجد لله منا وراكع % % يبيت على شفع ويغدو على وتر % % 6(@)(@@) % ووجهك للهيجاء من دون وجهه % % وتسري إلى الأعداء عنه ولا يسري % % 7(@)(@@) % وظلك ممدود عليه وتصطلي % % بجاحم نار الحرب أو جامد القر % % 8(@)(@@) % خلعت عليه ثوب صون ونعمة % % وظاهرت عنه بين صن وصنبر % % 9(@)(@@) % وكم قاطع بالنوم ليلا وصلته % % بغزوك ما بين الأصيل إلى الفجر % % 10(@)(@@) % وأقدمت فيه الخيل حتى رددتها % % وآثارها ثغر لقاصية الثغر % % PageV01P223 11(@)(@@) % كأن دجى ليل يمر على الضحى إذا سرن أو بحرا يمور على البر % % 12(@)(@@) % فأنت جزاء صومنا وصلاتنا % % وفيك رأينا ما ابتغينا من الأجر % % 13(@)(@@) % ومنك استمد الفطر مطعم فطرنا % % وفيك أرتنا قدرها ليلة القدر % % 14(@)(@@) % وباسمك عزت في الخطاب منبر % % بأسعد عيد عاد بالسعد أو فطر % % 15(@)(@@) % ولاح لنا فيه هلال كأنه % % بشير بفتح منك أشرق بالبشر % % 16(@)(@@) % أهل فأهللنا إليه تمثلا % % برحبك جنح الليل بالضيف تستقري % % 17(@)(@@) % وأسفر عن زهر النجوم كأنما % % جبينك أبدى عن خلائقك الزهر % % 18(@)(@@) % علا وتدانى للعيون كما علا % % محلك واستدنيت بعدا عن الكبر % % 19(@)(@@) % وذكرنا عطفا بعطفك حانيا % % على الدين والإسلام في البدو والحضر % % 20(@)(@@) % هلال مساء بات يضمن للضحى % % غداة المصلى مطلع الشمس والبدر % % PageV01P224 21(@)(@@) % وملء عيون الناظرين كتائبا % % كتبت بها الآفاق سطرا إلى سطر % % 22(@)(@@) % مخططة بالخيل والأسد والحلى % % ومعجمة بالبيض والبيض والسمر % % 23(@)(@@) % وصادقة الإقدام تهتز للوغى % % وخافقة الأعلام تعتز بالنصر % % 24(@)(@@) % فصليت وهي النور في مشرق العلا % % وأصليت 
ms74	 وهي النار في مغرب الكفرأ % % 25(@)(@@) % ولم استهلت بالسلام صلاتهم % % أهلت إلى تسليمهم سدة القصر % % 26(@)(@@) % فكروا يعيدون السلام على الذي % % يعاود عنهم في العدى صادق الكر % % 27(@)(@@) % يحيون بالإعظام مولى حنانه % % أخص بهم من رأفة الوالد البر % % 28(@)(@@) % ووافر سرير الملك يستلمونه % % كمستلم الحجاج للركن والحجر % % 29(@)(@@) % مشاهد غارت في البلاد وأنجدت % % محققة الأبناء طيبة النشر % % 30(@)(@@) % أنارت فما بالخلد عنهن من عمى % % ولا بزباب الرمل عنهن من وقر % % PageV01P225 31(@)(@@) % فكيف بأبصار أضاءت لها المنى % % إليك وأسماع صغت فيك للجبر % % 32(@)(@@) % ولا مثل مجلو النواظر بالعدى % % بياتا ومفتوق المسامع بالذعر % % 33(@)(@@) % توقى فأبلى عذر ناج مخاطر % % فرد المنايا عنه مبنية العذر % % 34(@)(@@) % وآنس يا منصور عندك نفسه % % فجلى لنا تحت الدجى ناظري صقر % % 35(@)(@@) % فأهوى إلى مثواك أمض من الهوى % % وأسرى إلى مأواك أخفى من السر % % 36(@)(@@) % فكم جزت من سيف لقتلي منتضى % % وجاوزت من ليث لضغمي مقتر % % 37(@)(@@) % فيا خزي ذا من سبق خطو مخاطر % % ويا لهف ذا من فوت غرة مغتر % % 38(@)(@@) % كأن خفوق القلب مد جوانحي % % بأجنحة ريشت من الروع والذعر % % 39(@)(@@) % وتحت جناحي مقدمي وتعطفي % % ثمان وعالت بالبنين إلى الشطر % % 40(@)(@@) % أخذت لهم إصر الحياة فأجلوا % % وقد أخذ الإشفاق مني لهم إصري % % PageV01P226 41(@)(@@) % فحملتهم وزرا ولو خف منهم % % جناحي لكان الطود أيسر من وزري % % 42(@)(@@) % فلله من أعداد أنجم يوسف % % تحملها منها أقل من العسر % % 43(@)(@@) % إلى كل مأوى للجلاء هوى بنا % % إلى حيث لا مهوى عقاب ولا تبر % % 44(@)(@@) % رحلت له عوجا كأنها هويها % . . . . . . . . . . . . . . . % 45(@)(@@) % طوين بنا بعد السفار كأنها % . . . . . . . . . . . . . . . . % 46(@)(@@) % وربتما استودعتنا بطن حرة % . . . . . . . . . . . . . . . % 47(@)(@@) % رحيبة مأوى الضيف مانعة القرى % . . . . . . . . . . % 48(@)(@@) % فكم لي بين اللوح واللوح طائرا % . . . . . . . . . . . % 49(@)(@@) % وكم أسلموا للعسف والخسف من حمي % % وكم . . % 50(@)(@@) % وكم وجهوا وجها لبارقة الظبى % . . . . . . . . . . . . % PageV01P227 51(@)(@@) % وكم أقدموا بين المنايا كما هوت % . . . . . . . . . . . % 52(@)(@@) % وكم بدلو من وجه راع وحافظ % . . . . . . . . . . . % 53(@)(@@) % ومن رفرف الأستار دون حجالها % . . . . . . . . . . . % 54(@)(@@) % ومن ساجع الأطيار فوق غصونها % . . . . . . . . . . % 55(@)(@@) % تنادي عزيف الجن في ظلم 
ms75	 الدجى % . . . . . . . . . % 56(@)(@@) % وكم زفرة نمت عليهم بحسرة % . . . . . . . . . . . . . % 57(@)(@@) % وثلاث عيون الشامتين إلى القرى % . . . . . . . . . . . % 58(@)(@@) % وماذا جلا وجه الجلاء محاسنا % . . . . . . . . . . . . . . % 59(@)(@@) % وماذا تلظى الحر في حر أوجه % % تنسم فيه برد ظل على نهر % % 60(@)(@@) % وماذا أجن الليل في موحش الفلا % % أوانس بالأتراب في يربع الزهر % % PageV01P228 61(@)(@@) % وماذا ترامى الموج في غول لجة % % بلاهية بين الأرائك والخدر % % 62(@)(@@) % فإن نبت الأوطان من بعد عنهم % % فلا محجري حجر عليهم ولا حجري % % 63(@)(@@) % وإن ضاق رحب الأرض عن منتواهم % % فرحب لهم ما بين سحري إلى بحري % % 64(@)(@@) % وإن تقس أكباد كرام عليهم % % فواكبدي ممن تذوب له صخري % % 65(@)(@@) % وإن تبرم الأيسار في أزماتهم % % فأحبب بأيسار قمرت لهم يسري % % 66(@)(@@) % ففازوا بنفسي غير جزء ذخرته % % لما شف من خطب وما مس من ضر % % 67(@)(@@) % فعفو لهم جهدي وحلو لهم مري % % وصفو لهم طرفي ويسر لهم عسري % % 68(@)(@@) % وإن أضرموا قلبي فجمري لهم ند % % وإن غيضوا شربي فروضي لهم % % 69(@)(@@) % ودائع نفسي عند نفسي حفظتها % % بما ضاع من حقي وما هان من قدري % % 70(@)(@@) % قليل غناهم عن يدي وغناؤهم % % سوى أنهم من ضيم كسبي لهم عذري % % PageV01P229 71(@)(@@) % وأني لهم في ماء وجهي تاجر % % أغنمهم غنمي وأربحهم خسري % % 72(@)(@@) % وأسلم في وخز السفى ثمر المنى % % وأبذل في قذف الحصى جوهر الشكر % % 73(@)(@@) % وإن نففت عندي بضاعة قانع % % تقنعت منها في خزاية معتر % % 74(@)(@@) % وأنجم أنواء تنوء بها النوى % % وليس لها إلا دموعي من قطر % % 75(@)(@@) % ولا مطلع إلى مهادي أو حجري % % ولا مغرب إلا ضلوعي أو صدري % % 76(@)(@@) % إذا ازدحموا في ضنك شربي تمثلوا % % بأسباط لموسى عند منفجر الصخر % % 77(@)(@@) % فما جهدوا فلكا كما جهدوا يدي % % ولا أنقضوا ظهرا كما أنقضوا ظهري % % 78(@)(@@) % كأن لهم وترا علي وما انتحى % % لهم حادث إلا وفي نفسه وتري % % 79(@)(@@) % ولولاهم لم أبد صفحة معدم % % ولم أسمع الأعداء دعوة مضطر % % 80(@)(@@) % ولا جدت للدنيا بخلة واصل % % ولو برزت لي في غيائلها الخضر % % PageV01P230 81(@)(@@) % وناديت في بيض النضار وصفرها % % لغيري فابيضي إذا 
ms76	 شئت واصفري % % 82(@)(@@) % ولكن أبى ما في الفؤاد من الأسى % % وأعضل ما بين الضلوع من الجمر % % 83(@)(@@) % وما لف عهد الله في ثوب غربتي % % من الآنسات الشعث والأفرخ الزعر % % PageV01P231 البحر : طويل 1(@)(@@) % مجدد ملك أحرزته جدوده % % أعزة أملاك الهدى وأكارمهأ % % 2(@)(@@) % فأعرب عن أيام يعرب واقتدى % % بما عظمت أذواؤه وأعاظمه % % 3(@)(@@) % وأنجبه للطعن والضرب عمره % % وأخلصه للجود والحمد حاتمه % % 4(@)(@@) % شجاع ولكن الجياد حصونه % % كريم ولكن المعالي كرائمه % % 5(@)(@@) % تلاقت عليه الخيل والبيض والقنا % % قياما لمن لا سعي ساع يقاومه % % 6(@)(@@) % وخلت له الأملاك عن سبل الهدى % % فليس سوى طيب الثناء يزاحمه % % 7(@)(@@) % مقسم ما يحويه في سبل الندى % % وإن كان قد حاباه في الحظ قاسمه % % 8(@)(@@) % فما خاب في يوم الندى من ينوؤه % % ولا فاز في يوم الوغى من يحاكمه % % 9(@)(@@) % ولا ادعيت في المأثرات حقوقه % % ولو أقبلت زهر النجوم تخاصمه % % 10(@)(@@) % ودعوى النهى والحلم في غير منذر % % خيال من الأحلام أضغث حالمه % % PageV01P232 11(@)(@@) % فمن ذا الذي يرجو من الملك غرة % % وما حومت إلا عليك حوائمه % % 12(@)(@@) % ولا رفعت إلا إليك عيونه % % ولا ظأرت إلا عليك روائمه % % 13(@)(@@) % ولا راق إلى في جبينك تاجه % % ولا قر إلا في يمنيك خاتمه % % 14(@)(@@) % فكيف بذي جهل تعسف مجهلا % % يبرح واقيه ويحتم حاتمه % % 15(@)(@@) % فغالته في غول المهامة غوله % % وهامت به الترهات هوائمه % % 16(@)(@@) % أباح حمى الإسلام للشرك مغنما % % لتقسم بني الناهبين مغانمه % % 17(@)(@@) % وفض ختام الله عن حرماته % % ليفتض عما تحتويه خواتمه % % 18(@)(@@) % وعد دماء المسلمين مدامة % % فبرح في الأعداء عمن ينادمه % % 19(@)(@@) % فإن ألقح الحرب العوان فحسبه % % فواقر ما شالت به وأشائمه % % 20(@)(@@) % وإن زج في جفن الردى فلحينه % % تخازر ساجيه وأوقظ نائمه % % PageV01P233 21(@)(@@) % غداة دعاك الدين من أسر فعلة % % وقد أوشكت أن تستباح محارمه % % 22(@)(@@) % هيأتها فانجاب عنها ظلامه % % ووافيتها فاستنكرتها مظالمه % % 23(@)(@@) % وجاءك مد الله من كل ناصر % % على الحق مهديا إليك مقادمه % % 24(@)(@@) % ونادى أبو مسعود النصر مسعدا % % عزائمك اللاتي تليها عزائمه % % 25(@)(@@) % بود كماء الغيث يسقي 
ms77	 رياضه % % وبأس كحر النار يضرم جاحمه % % 26(@)(@@) % على كل من حاربت فهو محارب % % كفاحا ومن سالمت فهو مسالمه % % 27(@)(@@) % وأعصم بالإشراك قائد بغيها % % إلى ملك رب السموات عاصمه % % 28(@)(@@) % فما ركضوا طرفا إليك لغارة % % وأسهل إلا أسلمته قوائمه % % 29(@)(@@) % ولا أصلتوا سيفا وأنحوك حده % % فعرج عن مثنى يمينك قائمه % % 30(@)(@@) % ولا أشبوا حصنا يردك عنهم % % وقابلته إلا تداعت دعائمه % % PageV01P234 31(@)(@@) % وإن أحرزوا في قطر شنج نفوسهم % % فغانم ما لا يحفظ الله غارمه % % 32(@)(@@) % فكم قدت في أكنافها من مقنع % % نفوس الأعادي شربه ومطاعمه % % 33(@)(@@) % خميس لجنح الليل من أنجم الدجى % % حلاه ومن شمس النهار عمائمه % % 34(@)(@@) % كأن شعاع الشمس تحت عجاجه % % إذا ما التقى الجمعان سر وكاتمه % % 35(@)(@@) % تجيش بودق من جنى النبع صائب % % أساوده نحو العدى وأراقمه % % 36(@)(@@) % كما حملت رحل الدبا عاصف الصبا % % أو انهل بالوبل الأجش غمائمه % % 37(@)(@@) % وهد هواء الجو نحو بنائها % % هوي سلام حان من لا تسالمه % % 38(@)(@@) % ولو لم تصادمه بطود من القنا % % لأقبل أطواد الجبال تصادمه % % 39(@)(@@) % ولو لم تزاحمه المجانيق لانبرت % % عليه نجوم القذف عنك تزاحمه % % 40(@)(@@) % وليس ولو سامى السماء بمعجز % % من المشرفي والعوالي سلالمه % % PageV01P235 41(@)(@@) % فسرعان ما أقوى الشرى من ضباعه % % وبربر في ذاك العرين ضراغمه % % 42(@)(@@) % وطير عن ليل الأباطيل بومه % % وشرد عن بيض النفاق نعائمه % % 43(@)(@@) % وبدلت حكم الله من حكم غيه % % فأنفذ حكم الله ما أنت حاكمه % % 44(@)(@@) % فيا رب أنف للنفاق جدعته % % بها وابن شنج صاغر الأنف راغمه % % 45(@)(@@) % غداة أطار العقل عنه ونفسه % % بسيفك يوم راكد الهول جاثمه % % 46(@)(@@) % فما يرتق الأرواح إلا رياحه % % ولا يفتق الغماء إلا غماغمه % % 47(@)(@@) % فلا نطق إلا أن يفديك صارخ % % ويدعوك بالبقيا عليها أعاجمه % % 48(@)(@@) % فأبرح بيوم أنت بالنصر مقدم % % وأفرح بيوم أنت بالفتح قادمه % % 49(@)(@@) % ومنزل مفلول نزلت وخيلنا % % مرابطها أجساده وجماجمه % % 50(@)(@@) % ومعترف بالذنب مبتئس به % % دعاك وقد قامت عليه مآتمه % % PageV01P236 51(@)(@@) % إذا صده الموت الذي سام نفسه % % يكر به العيش الذي هو سائمهأ % % 52(@)(@@) % فتلقاه أطراف 
ms78	 القنا وهو نصبها % % ويصعقه برق الردى وهم شائمه % % 53(@)(@@) % إذا كاد يقضي بالأسى تحبه قضت % % له الرحم الدنيا بأنك راحمه % % 54(@)(@@) % فلم أر أمضى منك حكما تحكمت % % على سيفه يوم الحفاظ مكارمه % % 55(@)(@@) % ولا مثل حلم أنت للغيظ لابس % % ولا مثل غيظ أنت بالحلم كاظمه % % 56(@)(@@) % فأوسعته حكم النضير وقد حكى % % قريظة منه غله وجرائمه % % 57(@)(@@) % فولى وقد ولاك ذو العرش عرشه % % وطار وقد طارت إليك قوادمه % % 58(@)(@@) % وأبت وقد لاحت سعودك بالمنى % % وغارت به في الأخسرين عواتمه % % 59(@)(@@) % نعني لك الركبان بالفتح قافلا % % وتبكي عليه بالحمام حمائمه % % 60(@)(@@) % فمن ينصر الرحمن هذي عزائمه % % ومن يخذل الرحمن هذي هزائمه % % PageV01P237 البحر : كامل تام 1(@)(@@) % عجبا لغي الحب لاح سبيله % % ولرشد حلمك كيف ضل دليله % % 2(@)(@@) % ولعيش صب لا يرق حبيبه % % مما شجاه ولا يفيق عذوله % % 3(@)(@@) % ولقاتل بالهجر غير مقاتل % % يفديه من مضض العتاب قتيله % % 4(@)(@@) % إن خط في جو السماء مثاله % % بدرا فبين جوانحي تمثيله % % 5(@)(@@) % أو شرد التسهيد طيف خياله % % عن ناظري ففيهما تخييله % % 6(@)(@@) % ولهان فيه ما فقدت من الكرى % % لو كان من نظري إليه بديله % % 7(@)(@@) % أو كان حكم هواه لا تحريمه % % وصلي عليه ولا دمي تحليله % % 8(@)(@@) % غصن يميس به الصبا فيقيمه % % طورا وتوهمه الصبا فتميله % % 9(@)(@@) % فكأنه في لمح طرفي عاثر % % وتقيه تفديني له فتقيله % % 10(@)(@@) % وتكاد أنفاسي تزايل متنه % % لولا كثيب منه ليس يزيله % % PageV01P238 11(@)(@@) % فكأنما يشتق من حركاته % % نغم الغناء خفيفه وثقيله % % 12(@)(@@) % لو أنه يشتق من أعطافه % % عطف يعلل لوعتي تعليله % % 13(@)(@@) % وعليل لحظ الطرف أعدى طرفه % % قلبي بداء لا يفيق عليله % % 14(@)(@@) % سلب الملاحة في الظباء وفي المها % % حتى استبد بجزئها تكميله % % 15(@)(@@) % أنفا لمن سكن الترائب أن يرى % % يطأ التراب شبيهه ومثيله % % 16(@)(@@) % ولقد حفظت له أمانة لاعج % % بالشوق يغلي في الفؤاد غليله % % 17(@)(@@) % وضربت من دمي على خدي له % % غرما غرامي بالقضاء كفيله % % 18(@)(@@) % فلئن صبوت فلست أول عاشق % % نبع الهوى فهوى به تضليله % % 19(@)(@@) % ولئن صبرت فلست بدع 
ms79	 مفارق % % غالت حبيب النفس عنه غوله % % 20(@)(@@) % ولئن سلوت فأي أسوة واعظ % % ألهاه عن قمر السماء أفوله % % PageV01P239 21(@)(@@) % فسما إلى الملأ الأجل بهجرة % % وافى بها الرحمن وهو خليله % % 22(@)(@@) % وهناك يا منصور همت بهمة % % فيها سلو المستهام وسوله % % 23(@)(@@) % طلبا لحظ لا يذل عزيزه % % من حظ غي لا يعز ذليله % % 24(@)(@@) % فهدى وأهداني إليك مبرزا % % شهدت له في السابقات عدوله % % 25(@)(@@) % وعجلا عليك به الجلاء مهندا % % صدقتك عن قرع الحروب فلوله % % 26(@)(@@) % وعفت محاسنه العدى فكأنها % % في معهد الوطن الفقيد طلوله % % 27(@)(@@) % إن يصده رهج الوغى فشعاعه % % بالعلم لماع الجلاء صقيله % % 28(@)(@@) % أو تخلق البلوى حمائل حليه % % فعلى التجمل والمنى تجميله % % 29(@)(@@) % أو تقطع الأيام عهد ذمامه % % فالصبر واصل حبله موصوله % % 30(@)(@@) % فآتاك يا منصور فاقد غمده % % برجاء مجرور إليك ذيوله % % PageV01P240 31(@)(@@) % رسف المقيد في أضاليل الدجى % % والقفر والبحر المحيط كبوله % % 32(@)(@@) % كربا كموج البحر لا إهلاله % % إلا إليك بها ولا تهليله % % 33(@)(@@) % فليهن ذا أمل إليك مآله % % وجلاء مرتحل إليك رحيله % % 34(@)(@@) % وظلام ليل في جبينك صبحه % % وهجير قيظ في ذراك مقيله % % 35(@)(@@) % وليهننا وليهنك العيد الذي % % بسناك أشرق صبحه وأصليه % % 36(@)(@@) % عيد إليك سلامه وقوامه % % ونظامه وزحامه وحفوله % % 37(@)(@@) % وعلى الإله معاده وعتاده % % وإيابه وثوابه وقبوله % % 38(@)(@@) % وليهن كل مليك شرك عيده % % يوم إليك بلوغه ووصوله % % 39(@)(@@) % ضلت به سبل الشرائع واهتدت % % بشريعة الزلفى إليك سبيله % % 40(@)(@@) % ناش على دين السجود وما درى % % قبل السجود إليك ما تأويله % % PageV01P241 41(@)(@@) % أنساه قدرك ما أضل صليبه % % وأراه سيفك ما حوى إنجيله % % 42(@)(@@) % فأجار محياه إليك نزاعه % % وأعزه بك في الورى تذليله % % 43(@)(@@) % ولئن حمى عنك ابن مير محلة % % في شامخ أعيا النجوم حلوله % % 44(@)(@@) % ونماه ملك لا يضعضع تاجه % % ووقاه عز لا يخاف خموله % % 45(@)(@@) % فلقد دعاك إلى رضاك ودونه % % غول الضلال حزونه وسهوله % % 46(@)(@@) % أصبى إليك من الصبا وأحن من % % أفق ونت عنه إليك قبوله % % 47(@)(@@) % وأجل قدرك عن سواه وقدرما % % أخفى إليك نجيه ودخيله % % 48(@)(@@) % عن صدق غيب 
ms80	 بالكتاب يبثه % % أو برح شوق بالرسول يقوله % % 49(@)(@@) % فهوى وصفحته إليك كتابه % % وهفا ومهجته إليك رسوله % % 50(@)(@@) % عجلا إلى أمل دنا تعجيله % % وجلا به أجل نأى تأجيله % % PageV01P242 51(@)(@@) % لله ما رحلت إليك رحاله % % طوعا وما حملت إليك حموله % % 52(@)(@@) % غاز وناصره عليك خضوعه % % سار وطاعته إليك دليله % % 53(@)(@@) % نشر اللواء زماعه ونزاعه % % فطوى المهامه نصه وذميله % % 54(@)(@@) % ولقد خلعت قبل دونه % % بردا تفيض على الفضاء فضوله % % 55(@)(@@) % لجبا من الخلق المضاعف نسجه % % أشبا من الأسل المثقف غيله % % 56(@)(@@) % شرقا به لوح الهواء وجوه % % غرقا به عرض البلاد وطوله % % 57(@)(@@) % مستقبلا بجنوده وبنوده % % ملكا يهل إليك حين تهوله % % 58(@)(@@) % ولشدما ماجت به أمواجه % % حتى أسالته إليك سيوله % % 59(@)(@@) % بصورام في طيهن تراته % % وذوابل في لمعهن ذحوله % % 60(@)(@@) % غاب تساود ناظريه أسوده % % من بعد ما اختالت عليه خيوله % % PageV01P243 61(@)(@@) % فمشى إليك به الزحام كأنه % % عان يقصر خطوه تكبيله % % 62(@)(@@) % مبهور أنفاس الحياة كظيمها % % وغضيض لحظ الناظرين كليله % % 63(@)(@@) % حتى تنفس روحه في راحة % % علياء مقبولا بها تقبيله % % 64(@)(@@) % ورفعت ناظره بنظرة باسط % % للأمن مبلوغا بها تأميله % % 65(@)(@@) % فأريته كيف ارتجاع حياته % % ولتلك أيسر ما بدأت تنيله % % 66(@)(@@) % من فيض عرف تستقل كثيره % % ولقد يزيد على الرجاء قليله % % 67(@)(@@) % نزلا يذكره العراق ومصره % % ملكا ودجلته يداك ونيله % % 68(@)(@@) % وشروق شمس لا يحين غروبها % % في برد ظل لا يحور ظليله % % 69(@)(@@) % ورأي صريع الخطب كيف تقله % % ورأى عثور الجد كيف تقيله % % 70(@)(@@) % ورأى ذليل الحق كيف تعزه % % ورأى عزيز الشرك كيف تديله % % PageV01P244 71(@)(@@) % ورأى صدوع الدين كيف تلمها % % ورأى كثيب الكفر كيف تهيله % % 72(@)(@@) % ولئن تقدم في رضاك قدومه % % فلقد تزود من نداك قفوله % % 73(@)(@@) % خلائق من طيبهن خلوقه % % وشمائل من صفوهن شموله % % 74(@)(@@) % ومعالم لعلاك لا تعظيمه % % لسوى مشاهدها ولا تبجيله % % 75(@)(@@) % فلها بقدر الروم وهي أرومه % % وزرى بملك الصفر وهي أصوله % % 76(@)(@@) % ابن اصطفى قحطان عزة ملكه % % ومن التبابع جذمه وقبيله % % 77(@)(@@) % ولمن نمى سبأ بسبي ملوكها % % واستخلفت أذواؤه وقيوله % % 78(@)(@@) % ولمن 