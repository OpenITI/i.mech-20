ms641	 وهم ولد النضر بن كنانة(@)(@@) PageV01P823(@)(@@) {فليعبدوا} تعلق به لإيلاف والفاء زائدة {رب هذا البيت}(@)(@@) PageV01P823(@)(@@) {الذي أطعمهم من جوع} أي من أجله {وآمنهم من خوف} أي من أجله وكان يصيبهم الجوع لعدم الزرع بمكة وخافوا جيش الفيل = 107 سورة(@)(@@)(@@)(@@) | الماعون(@)(@@) PageV01P823(@)(@@) {أرأيت الذي يكذب بالدين} بالجزاء والحساب أي هل عرفته وإن لم تعرفه(@)(@@) PageV01P823(@)(@@) {فذلك} بتقدير هو بعد الفاء {الذي يدع اليتيم} أي يدفعه بعنف عن حقه(@)(@@) PageV01P823(@)(@@) {ولا يحض} نفسه ولا غيره {على طعام المسكين} أي إطعامه نزلت في العاصي بن وائل أو الوليد بن المغيرة(@)(@@) PageV01P823(@)(@@) {فويل للمصلين}(@)(@@) PageV01P823(@)(@@) {الذين هم عن صلاتهم ساهون} غافلون يؤخرونها عن وقتها(@)(@@) PageV01P823(@)(@@) {الذين هم يراؤون} في الصلاة وغيرها(@)(@@) PageV01P823(@)(@@) {ويمنعون الماعون} كالإبرة والفأس والقدر والقصعة = 108 سورة(@)(@@)(@@)(@@) | الكوثر(@)(@@) PageV01P824(@)(@@) {إنا أعطيناك} يا محمد(@)(@@)(@@)(@@) | {الكوثر} (@)(@@) هو نهر في الجنة هو حوضه ترد عليه أمته والكوثر الخير الكثير من النبوة والقرآن والشفاعة ونحوها(@)(@@) PageV01P824(@)(@@) {فصل لربك} صلاة عيد النحر {وانحر} نسكك(@)(@@) PageV01P824(@)(@@) {إن شانئك} أي مبغضك {هو الأبتر} المنقطع عن كل خير أو المنقطع العقب نزلت في العاصي بن وائل سمى النبي صلى الله عليه وسلم أبتر عند موت ابنه القاسم = 109 سورة(@)(@@)(@@)(@@) | الكافرون(@)(@@) PageV01P824(@)(@@) {قل يا أيها(@)(@@)(@@)(@@) | الكافرون(@)(@@) PageV01P824(@)(@@) {لا أعبد} في الحال {ما تعبدون} من الأصنام(@)(@@) PageV01P824(@)(@@) {ولا أنتم عابدون} في الحال {ما أعبد} وهو الله تعالى وحده(@)(@@) PageV01P824(@)(@@) {ولا أنا عابد} في الاستقبال {ما عبدتم}(@)(@@) PageV01P824(@)(@@) {ولا أنتم عابدون} في الاستقبال {ما أعبد} علم الله منهم أنهم لا يؤمنون وإطلاق ما على الله على وجه المقابلة(@)(@@) PageV01P824(@)(@@) {لكم دينكم} الشرك {ولي دين} الإسلام وهذا قبل أن يؤمر بالحرب وحذف ياء الإضافة القراء السبعة وقفا ووصلا وأثبتها يعقوب في الحالين = 110 سورة(@)(@@)(@@)(@@) | النصر(@)(@@) PageV01P825(@)(@@) {إذا جاء نصر الله} نبيه صلى الله عليه وسلم على أعدائه {والفتح} فتح مكة(@)(@@) PageV01P825(@)(@@) {ورأيت الناس يدخلون في دين الله} أي الإسلام {أفواجا} جماعات بعد ما كان يدخل فيه واحد واحد وذلك بعد فتح مكة جاءه العرب من أقطار الأرض طائعين(@)(@@) PageV01P825(@)(@@) {فسبح بحمد ربك} أي متلبسا بحمده {واستغفره إنه كان توابا} وكان صلى الله عليه 
ms642	 وسلم بعد نزول هذه السورة يكثر من قول سبحان الله وبحمده أستغفر الله وأتوب إليه وعلم بها أنه قد اقترب أجله وكان فتح مكة في رمضان سنة ثمان وتوفي صلى الله عليه وسلم في ربيع الأول سنة عشر = 111 سورة(@)(@@)(@@)(@@) | المسد(@)(@@) PageV01P825(@)(@@) {لما دعا النبي صلى الله عليه وسلم قومه وقال إني نذير لكم بين يدي عذاب شديد فقال عمه أبو لهب تبا لك ألهذا دعوتنا نزل {تبت} خسرت {يدا أبي لهب} أي جملته وعبر عنها باليدين مجازا لأن أكثر الأفعال تزاول بهما وهذه الجملة دعاء {وتب} خسر هو وهذه خبر كقولهم أهلكه الله وقد هلك ولما خوفه النبي بالعذاب فقال إن كان ما يقول بن أخي حقا فإني أفتدي منه بمالي وولدي نزل(@)(@@) PageV01P825(@)(@@) {ما أغنى عنه ماله وما كسب} أي وكسبه أي ولده ما أغنى بمعنى يغني(@)(@@) PageV01P826(@)(@@) {سيصلى نارا ذات لهب} أي تلهب وتوقد فهي مآل تكنيته لتلهب وجهه إشراقا وحمرة(@)(@@) PageV01P826(@)(@@) {وامرأته} عطف على ضمير يصلى سوغه الفصل المفعول وصفته وهي أم جميل {حمالة} بالرفع والنصب {الحطب} الشوك والسعدان تلقيه في طريق النبي صلى الله عليه وسلم(@)(@@) PageV01P826(@)(@@) {في جيدها} عنقها {حبل من مسد} أي ليف وهذه الجملة حال من حمالة الحطب الذي هو نعت لامرأته أو خبر مبتدأ مقدر = 112 سورة(@)(@@)(@@)(@@) | الإخلاص(@)(@@) PageV01P826(@)(@@) النبي صلى الله عليه وسلم عن ربه فنزل {قل هو الله أحد} فالله خبر هو وأحد بدل منه أو خبر ثان(@)(@@) PageV01P826(@)(@@) {الله الصمد} مبتدأ وخبر أي المقصود في الحوائج على الدوام(@)(@@) PageV01P826(@)(@@) {لم يلد} لانتفاء مجانسته {ولم يولد} لانتفاء الحدوث عنه(@)(@@) PageV01P826(@)(@@) {ولم يكن له كفوا أحد} أي مكافئا ومماثلا وله متعلق بكفوا وقدم عليه لأنه محط القصد بالنفي وأخر أحد وهو اسم يكن عن خبرها رعاية للفاصلة = 113 سورة(@)(@@)(@@)(@@) | الفلق(@)(@@) PageV01P826(@)(@@) {قل أعوذ برب(@)(@@)(@@)(@@) | الفلق} (@)(@@) الصبح(@)(@@) PageV01P826(@)(@@) {من شر ما خلق} من حيوان مكلف وغير مكلف وجماد كالسم وغير ذلك(@)(@@) PageV01P827(@)(@@) {ومن شر غاسق إذا وقب} أي الليل إذا أظلم والقمر إذا غاب(@)(@@) PageV01P827(@)(@@) {ومن شر النفاثات} السواحر تنفث {في العقد} التي تعقدها 
ms643	 في الخيط تنفخ فيها بشيء تقوله من غير ريق وقال الزمخشري معه كبنات لبيد المذكور(@)(@@) PageV01P827(@)(@@) {ومن شر حاسد إذا حسد} أظهر حسده وعمل بمقتضاه كلبيد المذكور من اليهود الحاسدين للنبي صلى الله عليه وسلم وذكر الثلاثة الشامل لها ما خلق بعده لشدة شرها = 114 سورة(@)(@@)(@@)(@@) | الناس(@)(@@) PageV01P827(@)(@@) {قل أعوذ برب(@)(@@)(@@)(@@) | الناس} (@)(@@) خالقهم ومالكهم خصوا بالذكر تشريفا لهم ومناسبة للاستعاذة من شر الموسوس في صدورهم(@)(@@) PageV01P827(@)(@@) {ملك الناس}(@)(@@) PageV01P827(@)(@@) {إله الناس} بدلان أو صفتان أو عطفا بيان وأظهر المضاف إليه فيهما زيادة للبيان(@)(@@) PageV01P827(@)(@@) {من شر الوسواس} الشيطان سمي بالحدث لكثرة ملابسته له {الخناس} لأنه يخنس ويتأخر عن القلب كلما ذكر الله(@)(@@) PageV01P827(@)(@@) {الذي يوسوس في صدور الناس} قلوبهم إذا غفلوا عن ذكر الله(@)(@@) PageV01P827(@)(@@) {من الجنة والناس} بيان للشيطان الموسوس أنه جني وإنسي كقوله تعالى شياطين الإنس والجن أو من الجنة بيان له والناس عطف على الوسواس وعلى كل يشتمل شر لبيد وبناته المذكورين واعترض الأول بأن الناس لا يوسوس في صدورهم الناس إنما يوسوس في صدورهم الجن وأجيب بأن الناس يوسوسون أيضا بمعنى يليق بهم في الظاهر ثم تصل وسوستهم إلى القلب وتثبت فيه بالطريق المؤدي إلى ذلك والله تعالى أعلم PageV01P827 
