ms1041	 وفا نقش نام تست(@)(@@) (@@) -گام زده بر حریر کی سپرد این ره آنک %~% دیده قدم ساخته بر سر پیکان برفت(@)(@@) - دل ز هجر تو بس که تنگ آمد %~% مرگ را عمر جاودان دانست(@)(@@) (@@) - هر قدم کاندر ره آن خرامان بر گرفت %~% دیده خاک راه او دامان به دامان بر گرفت(@)(@@) (@@) دل که اندر زلف او افتاد نتوان یافتن %~% چشم کان بر روی تو افتاد نتوان بر گرفت(@)(@@) (@@) - آن بت اندر سینه و سوز دلم قندیل وار %~% چون دلم بتخانه شد، بتخانه چیست؟(@)(@@) (@@) - پس ازین به دیده خواهم به طواف کویت آمد %~% که بسوخت تا به زانو قدمم به جستجویت(@)(@@) (@@) دگر زاهدان به قبلهآ روی تو بنگرند %~% ای بس نمازها که به حیرت قضا کنند(@)(@@) - چون بدید آفتاب رنگ لبت %~% لعل را زیر سنگ پنهان کرد PageV02P1218(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0556.jpg)(@)(@)(@@) چشم بد دور از چنان رویی %~% که ازو چشم دور نتوان کرد(@)(@@) ~~- عشاق را به جز جگر خسته بر نداد - هرگز نرود نقش رخت از دل خسرو(@)(@@) %~% آن دانههای دل که به کوی تو کشتهاند %~% زان گونه که از ران سگان داغ خداوند(@)(@@) (@@) - نتوان زیست به جان دگران گر چه صبا %~% جای خاشاک ز کوی تو همه جان آورد(@)(@@) (@@) - پند بر عاشق بدان ماند که باشد بر جگر %~% ناتوان را زحمت جانی و داغش هم کنند(@)(@@) (@@) - به بوسی جان به جانان ده گرانتر زین بها نبود %~% وگر خواهی1 که بیش ارزد گرانجانی همین باشد(@)(@@) -کشت خال لب توام، آری %~% مگس شهد زهردار بود(@)(@@) - در دلم تیرش ترازو میشود %~% تا درون سینه جان را بر کشد(@)(@@) - دلم گرد آنزلف گردد همه شب %~% چو دزدی که اندر شب تار گردد(@)(@@) مرا گفتی که آیم در بر تو - در نگیرد به بتان گریهآ گرم و دم سرد %~%(@)(@@) لا در آمدن کس را نپرسد %~% کاین درختان به چنین آب و هوا بر ندهند(@)(@@) (@@) - زلفین تو سرگشته چو باد سحرم کرد %~% خاک سرکویت چو صبا در به درم 
ms1042	 کرد(@)(@@) (@@) - عشاق هر شب از تو به خوناب خفتهاند %~% چون شمع، صبح مرده و بی تاب خفتهاند(@)(@@) (@@) خفتند هر کسی ز پی خواب دیدنت %~% بیدار آن کسان که بدین خواب خفتهاند(@)(@@) - باده کش دوزخیان بهتر از آن متقیان - یا رب چه عذاب است که این مرغ(@)(@@) گرفتار - اسیر کفر گیسوی صنم چون برهمن باید %~% کز پی خلد برین طاعت(@)(@@) معبود کنند %~% سمل نیسندند و تییدن نگذارند %~% که گر رگهای جانش بگسلی زنار نگشاید(@)(@@) ~~چه طالع دارم این کز آسمان هر کاروان غم - هنوزت ناز گرد چشم خواب(@)(@@) آلود میگردد %~% که آید بر زمین جز بر دل من بار نگشاید %~% هنوز از تو شکیب عاشقان نابود میگردد(@)(@@) ~~مشو مغرور خورشید جمال خود، چو میدانی - بدین خوشم که تو باری درون(@)(@@) جان منی به صد جان بندهام آن غمزه را با آنکه میدانم %~% من ار به خاطر(@)(@@) تو جا نمیتوانم کرد %~% که دور حسن را سایه به غایت زود میگردد %~% که مرگم گرد آن پیکان زهرآلود میگردد(@)(@@) (@@) - شکیب من همه سیماب شد، نمی دانم %~% که کیمیای صبوری کدام کس دارد؟(@)(@)PageV02P1219(@)(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0557.jpg)(@)(@)(@@) (@@) مرهم از لبهات میجویم بدین جان فگار %~% وای بر زخمی که آنرا از نمک مرهم کنند(@)(@@) (@@) بیگانهوار از سر ما سایه واگرفت %~% ما را به آشنایی او این گمان نبود 215a(@)(@@) (@@) جراحت جگر خستگان چه میپرسی %~% ز غمزه پرس که این شوخی از کجا آموخت(@)(@@) (@@) ز من که عاشق و مستم صلاح کار مجوی %~% چه جای زرگری آن را که کیمیا آموخت(@)(@@) (@@) دل رقیب بسوزد ز آه من چه کنم؟ %~% نمیتوان سگ دیوانه را وفا آموخت(@)(@@) (@@) - هر شب فتاده بر در تو خاک در خورم %~% باشد ز پاسبان تو سنگی به سر خورم(@)(@@) (@@) جایی که تو کمان کشی ای نخل فتنه بار %~% پیکان آبدار چو خرمای تر خورم(@)(@@) (@@) روزی که ببینمت ز پی دیدن دگر %~% شب تا به روز حسرت تیر دگر خورم(@)(@@) (@@) - رسته بودم مه من چند که از 
ms1043	 زاری دل %~% از نمکدان تو شد تازه جگر خواری دل(@)(@@) (@@) هر کسی با دل آزاده ازین شهر برفت %~% من گرفتار بماندم به گرفتاری دل(@)(@@) (@@) میشود زلفت از آسیب نسیمی در هم %~% بس که بیتاب شد از زحمت بسیاری دل(@)(@@) (@@) پند گویا تو ازین گونه خرابم مگذار %~% که نمیآید ازین خسرو معماری دل(@)(@@) (@@) - صد شکایت دارم اما چون درآید در نظر %~% کیست کان ساعت زبانم را به گفتار آورد(@)(@@) (@@) رو به دیوار تو دارم بر درت چون بار نیست %~% هر کرا از در برانی، رو به دیوار آورد(@)(@@) (@@) - ماه هلال ابروی من، عقل مرا شیدا مکن %~% غمزه زنان بیرون1 میا، آهنگ جان ما مکن(@)(@@) (@@) گفتم ز کفر زلف تو2 زنار بندم، گفت رو %~% در کفر هم صادق نهای، زنار را رسوا مکن(@)(@@) (@@) - درد سر دوستان آه و فغان من است %~% کاهش جان طبیب3 درد نهان من است(@)(@@) (@@) از دم سرد فراق برگ حیاتم نماند %~% آفت این برگ ریز باد خزان من است(@)(@@) (@@) گریه که از سوز دل، گرم برون میدهم %~% قطرهآ آب است، لیک شعلهآ جان من است(@)(@@) (@@) -عجب آمد همه را مردنم از هجر و مرا %~% عجب از خلق که ترسند چو تنها مانند(@)(@@) (@@) - جان عاشق چو برون رفت مجویندش باز %~% زانکه در دل دگری هست که جانش خوانند(@)(@@) (@@) میبرد حسرت پابوس تو خسرو در خاک %~% چون شود خاک بگو تا به رهت افشانند6(@)(@@) (@@) - ای ترا بر دیدهآ من جای خواب %~% دیدهآ بی خوابم از تو جای آب PageV02P1220(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0558.jpg)(@)(@)(@@) (@@) شب که خوابم نیست بهر دیدنت %~% چند سازم خویش را عمدا به خواب(@)(@@) (@@) چشمم ای جان با خیال روی تو1 %~% نیمه ابرست و نیمی آفتاب(@)(@@) (@@) زان لب میگون که هوش از من ببرد %~% خون همی گریم چو بر آتش کباب(@)(@@) (@@) با لبت دارم سؤالی چون کنم %~% تنگ میآید دهانت در جواب(@)(@@) (@@) مست گشتم بس که خون دل خورم %~% چون نکردم مست با چندین شراب(@)(@@) (@@) هست خورشید قیامت روی تو %~% خط 
ms1044	 مشکین دفتر یوم الحساب(@)(@@) (@@) زان قیامت عالمی در جنت است %~% بنده خسرو تا قیامت در عذاب(@)(@@) (@@) - عشاق دل غم زده را شاد نخواهند %~% خوبان تن ویران شده آباد نخواهند(@)(@@) (@@) قومی که حق خدمت2 معشوق شناسند %~% در جور بمیرند و زکس داد نخواهند(@)(@@) (@@) در دام بمردیم و به روی تو نگفتیم %~% کآزادی گنجشک ز صیاد نخواهند(@)(@@) (@@) از باد همین بوی تو آید که رود جان %~% آن گل که چو رویت بود از باد نخواهند(@)(@@) (@@) - ترکی و جنگجوی3 و کسی کاینچنین بود %~% نبود عجب اگر دل او آهنین بود(@)(@@) (@@) تیغم نه بر قفا، به گلو، زانکه گاه مرگ %~% رویم به سوی او نه به سوی زمین بود(@)(@@) (@@) شد جان صدهزار چو من در سر لبت ساقی مرنج از من و رسواییم از آنک %~%(@)(@@) دیوانه را شراب بتان اینچنین2 بود %~% آری هلاک5 مور و مگس ز انگبین بود(@)(@@) (@@) - خامشی از گفتن بسیار به %~% آنکه گفت از گفت خود در جوش ماند(@)(@@) (@@) شد لبالب پر در از لب با شکم %~% چون صدف هر کو همه تن گوش ماند(@)(@@) (@@) شانه را بر سر همی سازند جایی %~% زانکه با چندین زبان خاموش ماند(@)(@@) (@@) - سیم و زر به هر روز فتنه بود %~% سر بماند چو مرد زر بازد(@)(@@) (@@) مفلسی کش بلا رسید قرار %~% مال چون نیست تن در اندازد(@)(@@) (@@) گاه کین زخم بر سر گیرند %~% سی سپر دست را سپر سازد(@)(@@) (@@) یک تار زتار عنکبوتی بردار %~% وانگه ببرانش به درازی صدبار PageV02P1221(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0559.jpg)(@)(@)(@@) یکسال درون زعفرانش پرور %~% وانگاه تن ضعیف خسرو انگار(@)(@@) (@@) .یار پیکان زد و من از هوس آن مردم %~% که زنم بوسه بر آن دست که پیکانم زد(@)(@@) (@@) ای اجل آنقدری صبر کن امروز که من %~% لذتی یابم ازین زخم که بر جانم زد(@)(@@) (@@) - راند به دلها سمند، نعل در آتش فکند %~% تافته چون بر کشید، بر جگر ما نهاد(@)(@@) (@@) - دل نیست که در وی غم دلدار نگنجد %~% آهن بود آن دل که درو یار 
ms1045	 نگنجد1(@)(@@) (@@) - جایی که از لب تو باران بوسه بارد %~% دل غنچه غنچه خیزد جان خوشهخوشه روید(@)(@@) (@@) - بر خاک من رسید پس از مرگ هر گیاه %~% کان را نه بوی او بود، از بیخ بر کنید(@)(@@) (@@) نامه کنید سوی وی تا بدو رسم %~% خاکسترم کنید و بر آن خط پراکنید(@)(@@) (@@) - در دیده من مردمک چشم نگنجد %~% اکنون که مرا روی تو در چشم در آمد 215b(@)(@@) (@@) - مرا باری بر آمد جان از آن یار درون مانده %~% کسی باشد که دل بشکافد و او را در درون آرد؟(@)(@@) - دیده تا خط تو را بالای لب %~% دیده خط بر آب حیوان میکشد(@)(@@) (@@) - ز گریه موی بر اندام من همی خیزد %~% گیا بخاستن آید زمین چو تر باشد(@)(@@) (@@) - معذوری اگر نیست دلت را اثر مهر %~% کاین معجز عیسی است ز قصاب نیاید(@)(@@) (@@) از دل نگشاید گره گریهام آری %~% ماتم چو بود صعب، ز چشم آب نیاید(@)(@@) - به سلامیت جان به باد دهم %~% گر به باد از توام سلام رسد(@)(@@) (@@) همه بضاعت عشقت بیار و بر من نه %~% که درد و غم به دل تنگ بیشتر گنجد(@)(@@) (@@) - چو سبزه خویش را خط تو خواند، جای آن باشد %~% که گل از خنده بر خاک افتد و غنچه شکم گیرد(@)(@@) (@@) ستم در عهد تو زانگونه خونی شد که هر ساعت %~% اجل بهر شفاعت آید و دست ستم گیرد(@)(@@) (@@) خیالت بیشتر میبینم اندر دیدهآ پر نم %~% اگر چه روی ننماید آیینه چو نم2 گیرد(@)(@@) (@@) - زگریه زیر دیوار تو هم غمناک و هم شادم %~% غم آن کافتد و شادی آن کان بر سرم افتد(@)(@@) (@@) - بر آستانت لاف رسیدن کرا رسد؟ %~% آن را که زیر پای دو عالم دو گام شد(@)(@@) (@@) - باز آن سوار مست به نخجیر میرود %~% دستم ز کار و کار ز تدبیر میرود(@)(@@) (@@) عشقم نرفتنی است که در شخص آدمی2 %~% با جان برآید آنچه که با شیر میرود PageV02P1222(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0560.jpg)(@)(@)(@@) ~~عرصهآ خائیه /غرفه متوسطین(@)(@@) (@@) - گفتم که می 
ms1046	 بر آید جانم ز هجر گفتا %~% جانی که ماند بی ما مگذار تا بر آید(@)(@@) - بی تو در سینه جان نمی گنجد %~% تو درونی، از آن نمیگنجد(@)(@@) آنچنان در نشستهای به دلم %~% که نفس هم در آن نمی گنجد(@)(@@) (@@) رسید دلبر من ای نظارگی زنهار %~% نه بند دیده گرفت دل به کار میآید(@)(@@) (@@) چه کردهها که بر آورده باشد از دلها %~% که فرق تا به قدم پر غبار میآید(@)(@@) (@@) به خدا که سینهام را بشکاف و دل برون کن %~% که درون خانهآ تو دگری چه کار دارد؟(@)(@@) (@@) : میان نازک او را به بر بگیرم تنگ %~% که از برای گسستن بهانه میطلبد(@)(@@) (@@) - آنچه بر بیگنهان میکند آن روی چو ماه %~% ر گنه کاران خوسند قیامت نکند(@)(@@) (@@) - هر شبی خون کنی وخوش خسبی %~% خون چندین کسی کجا خسبد(@)(@@) (@@) - عجب مدار ز باران اشک و تخم محبت %~% چو سبزه از گل محمود اگر ایاز بر آید(@)(@@) (@@) - مگر هجران قیامت بود کان بگذشت من بر خود %~% در فردوس دیدم باز از روی نگار خود(@)(@@) (@@) - بر ما فتد از تابی زان رخ چه شوی رنجه %~% مهتاب ز افتادن افگار نخواهد شد(@)(@@) (@@) - پس کز حسد چشمش، بیمار شود نرگس %~% از شاخ عصا سازد آنکه ز زمین خیزد(@)(@@) (@@) - مردم چشمم که میگردد به گرد روی تو %~% طفل را ماند که در مهتاب بازی میکند(@)(@@) (@@) - واجب است از دهن غنچه بدوزند به خار %~% تا در ایام جمالت سخن گل نکند(@)(@@) (@@) - چو نقش روی توام در دل حزین گردد %~% مرا نفس به دل خسته تیغ کین گردد(@)(@@) (@@) ترا به دیده کشم لیک غیرتم نکشد %~% که با تو مردمک دیده همنشین گردد(@)(@@) (@@) - دیوانهآ لطافت اندام تست آب %~% مانا که باد سلسله بر آب ازین نهد(@)(@@) (@@) - سیاهروی شدم زین سپید رخساران %~% چو هندویی که پرستار آفتاب شود(@)(@@) (@@) - بهر زمین که چو آب حیات بخرامی %~% دهان مرده به زیر زمین پر آب شود(@)(@@) (@@) - خضر پیش لبت به آب حیات %~% لب چه باشد 
ms1047	 که دست هم نزند(@)(@@) (@@) - صبا آمد ولی دل باز نآمد %~% غریب ما به منزل باز نآمد(@)(@@) نصیحت زندگان را کرد باید %~% کز افسون مرغ بسمل باز نآمد(@)(@@) (@@) - مگر به گرد لب لعل آن صنم گشتهاست %~% که باد صبحدم امروز بوی جان دارد(@)(@@) (@@) - مردمان در من و بیهوشی من حیرانند %~% من در آن کس، که ترا بیند و حیران نشود PageV02P1223(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0561.jpg)(@)(@)(@@) ~~شدم به راه تو خاک و درین غم که مبادا کرشمه چند کنی بر من آخر این(@)(@@) جان است %~% صبا غبار غم آلود من ب %~% نمیدما ز زمین و ص %~% %~% فی تو آرد(@)(@@) (@@) می بینمش ز دور و نیم سیر چون کنم %~% لب تشنگی آب ز دیدن نمیرو(@)(@@) (@@) - غم تو خاک وجودم به باد داد و نخواهد %~% غبار خاطر گردی که در هوای تو باشد(@)(@@) (@@) دای زلف چلیپای تو غارتگر دینها %~% وی کرده گمان دهنت دفع یقینها(@)(@@) (@@) از ناصیهآ ما نشود خاک درت دور %~% چون صندل بت برهمنان را ز جبینها(@)(@@) (@@) من خود شدم از کیش ولی گر صنم اینست %~% بسیار رود در سر کارش دل و دینها(@)(@@) (@@) - هرشب از هرسوی در میآیدم چندین خیال %~% از کدامین سو نگهدارم من این ویرانه را(@)(@@) (@@) جان ز نظاره خراب و ناز او ز اندازه بیش %~% ما به بویی مست و ساقی پر دهد پیمانه را(@)(@@) (@@) خسرو است و سوز دل در ذوق عالم بی خبر %~% مرغ آتشخواره کی لذت شناسد دانه را216a(@)(@@) (@@) - لباس زندگی بر خود مکن تنگ %~% که چون شد پاره نتوان کرد پیوند(@)(@@) (@@) - عاشق که میسوزد دلش از طعنه باکش کی بود %~% شمعی که آتش میخورد زحمت شمارد کاز(@)(@@) ~~- ز چشمت تا بدل تخم بلا رست - ای عشق شغل تو چو به من ناکسی رسید(@)(@@) %~% مرا در سینه میروید سنانها %~% گویا1 کسی نماند جهان خراب را(@)(@@) ~~چو لاله غرقه به تی من رفت وخیالش بماند -خط تو نارسته می بنماید اندر زیر پوست خسروم من گلی از خون دل 
ms1048	 خود رسته گل گریبان چاک و عاشقی ار یک دم است سهل نباید گرفت اشکم برون میافکند راز درون پرده را جان فدای دوست کم کن، کم زان زن هندو نهای - کرشمههای تو از بس که هست(@)(@@) نازآمیز خسرو ز سوز گریه نیارد نگاهداشت %~% زهی شکفته که امسال نوبهار(@)(@@) من %~% اینکه تو بینی نه منم بلکه اوست %~% آری سفال گرم به جوش آرد آب را(@)(@@) %~% نه آشتی تو داند کسی، نه جنگ ترا %~% چون خیال سبز نورسته اندر زیر(@)(@@) %~% آری شکایتها بود از خانه بیرون کردهر %~% کز وفای شو در آتش زنده سوزد(@)(@@) خویش %~% بوی من هست جگر سوز مبویید مر %~% آتش اگر شعلهای است خرد نباید شمرد PageV02P1224(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0562.jpg)(@)(@)(@@) ~~عرصه خائیه غرفه متوسطین(@)(@@) ~~- امشب شب ما نور ز مهتاب دگر داشت وزگریه شادی مژهام آب دگر داشت(@)(@@) (@@) دل هیچ به شیرینی جان میل نمیکرد %~% مسکین مگس آلایش1 جلآب دگر داشت(@)(@@) (@@) - یکقدم در جان خود نه، وان دگر در کوی دوست %~% زین نکوتر رهروان عشق را رفتار نیست(@)(@@) (@@) د بر آن لبی که شکر با حلاوتش سور است %~% هزار ملک سلیمان بهای یک مور است(@)(@@) (@@) فراز کنگرهآ وصل کی توان رفتن %~% که رشته کوته و بازوی بخت بی زور است(@)(@@) (@@) - به نزد تست دلم بازگونه کن که در او %~% کنی نظاره که چند است داغ پنهان است(@)(@@) (@@) - داغ دگر این است که از گریه نشستم %~% آن داغ که دامانت ز خون دل ما داشت(@)(@@) (@@) تا باد برد بوی تو در باغ پیش سرو %~% لاله ز دست باد کله بر زمین زده است(@)(@@) (@@) -کار چون تقدیر دارد رنجش از اختر ز چیست %~% چون کند سلطان سیاست، نالش از جلاد چیست؟(@)(@@) وخط تو درونهآ مرا سوخت %~% شک نیست که آفتاب زاده است(@)(@@) (@@) - عشق خصم من بس است ای چرخ تو زحمت مکش %~% هر کجا جلاد باشد حاجت قصاب نیست(@)(@@) (@@) گر جمال دوست نبود با خیالش هم خوشیم %~% خانهآ درویش را شمعی به 
ms1049	 از مهتاب نیست(@)(@@) (@@) - بر شکر خوانند افسون بهر دلجویی و لیک %~% شکری کو خود فسون خواند، لب دلجوی تست(@)(@@) (@@) موی ابرو را گره نتوان زدن، لیکن ز کبر %~% صد گره بنشست بر هر مو که در ابروی تست(@)(@@) (@@) - راز خون آلود خویش ای دل مده با من برون %~% کین ورق خامست و حرف از وی برون خواهد گذشت(@)(@@) - ز غیرت رخ او آفتاب خواست ز چرخ %~% فرو فتد که ذنب آفتاب را بگرفت(@)(@@)(@@)(@@) | [خسرو سعد کره](@)(@@) ~~عرفهآ اختر برج سعادت و کامکاری، خسرو سعد کره2. از جمله بزرگان عالیقدر و سروران(@)(@@) ~~زمان خود است. او راست:(@)(@@) - دل ربود از من بت سیین بری PageV02P1225(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0563.jpg)(@)(@)(@@) (@@) نازنینی، نازکی، سیمینتنی %~% خوش خرامی، دلبری، جان پروری(@)(@@) (@@) از دو گسیو ظالمی، مردم کشی %~% وز دو نرگس ساحری، افسونگری(@)(@@) (@@) خسرو سعد است از دوری او %~% همچو زلف او پریشان، ابتری(@)(@@) (@@) - عقل را عشق تو شیدا میکند %~% دست زور خویش پیدا میکند(@)(@@) (@@) چون درون چشم مردم جای کرد %~% چشم را از گریه دریا میکند(@)(@@) (@@) خسرو سعد از تو نتواند شکست %~% گر چه دل از سنگ خارا میکند(@)(@@) (@@) - اگر این عیسی ما دم ندادی %~% غمش بر زندگی راهم ندادی(@)(@@) (@@) نی تیر قدت کز مستی چرخ %~% کمان قامتم را خم ندادی(@)(@@) (@@) نماندی آب اندر چشمهآ عشق %~% سرشک چشم ما گر نم ندادی(@)(@@) (@@) تو مقصودی قضا را ورنه هرگز %~% شرف اندر گل آدم ندادی(@)(@@) (@@) غمت گر داد خسرو یار، بستان %~% چه میکردی اگر آن هم ندادی(@)(@@)(@@)(@@) | 93(@)(@@) [خسرو ثانی تخلص](@)(@@) ~~عرفهآ مسکینی در آن نامداری، خسرو ثانی تخلص. جزاین شعر از او نشنیدهایم:(@)(@@) (@@) - ندارم جز علی من شاه، و الله %~% علی دارم شد دلخواه، و الله(@)(@@) (@@) اگر حب علی نبود درین دشت %~% نروید هیچ برگ و کاه، و الله(@)(@@) (@@) به هر حالی، به هر راهی که هستم %~% علی دارم به خود همراه، و الله(@)(@@) (@@) کمینه خسرو ثانی است مسکین %~% ندیم اهل بیت الله، و الله 216b(@)(@@) [خواجه خسرو سمرقندی] 
ms1050	(@)(@@) ~~عرفه؛ در مجالس النفایس خود امیر علیشیر آورده که خواجه خسرو قاضی یک قلمهآ PageV02P1226(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0564.jpg)(@)(@)(@@) ~~عرصهآ خائیه / غرقه منوسطین(@)(@@) ~~سمرقند1 است و مدرس مدرسهآ میرزا الغ بیگ. با کمال فضیلت و تقوا و زهد و حسن(@)(@@) ~~اخلاق به نظم و انشا و معما می پردازد. در همه فنی سرآمد است، این معما به اسم «ملک»(@)(@@) ~~او راست:(@)(@@) ~~در میان هر چیز کان از اوج تا ماهی است مظهر اسمیت گشته، گر ترا آگاهی است(@)(@@) ~~و همو گوید که در تاریخ بابا خدای داد که اهل سمرقندش ابدال دانستندی، (مجذوب(@)(@@) ~~سالک /862) یافت. و تاریخ وقفیهآ فقیر را (من وقف علیشیر /896) پیداکرد.(@)(@@)(@@)(@@) | 939](@)(@@) اخواجه خضر شاه استرآبادی])(@)(@@) ~~عرفهآ خضر وادی نامرادی، خواجه خضر شاه استرآبادی. هم در مجالس النفایس آمده که(@)(@@) ~~وی مردی خوش طبع خوش محاوره بود و نستعلیق خوب نوشتی، و در بحر لیلی و(@)(@@) ~~مجنون، زید و زینب نام مثنوی پرداخته که این بیت توحید از آنجاست:(@)(@@) ای چهره گشای هر جمیلی %~% نام تو شفای هر علیلی(@)(@@)(@@)(@@) | 940)(@)(@@)(@@)(@@) | [خواجه خضر](@)(@@) ~~عرفهآ خضر سر چشمهآ حیات، خواجه خضر از جملهآ مینوشان بزم مقال است و غالبا(@)(@@) ~~همین خواجه خضر شاه مذکور باشد. و الله اعلم:(@)(@@) - گر دلی دارند یاران درد را حاصل کنید دل که در وی درد نبود زودش اندر گل کنید PageV02P1227(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0565.jpg)(@)(@)(@@) (@@) باز سلطان خیالش میرسد ای جان و دل %~% خانهآ چشم مرا از بهر او منزل کنید(@)(@@) (@@) دردم ز حد گذشت به درمان خبر کنید %~% کارم به جان رسید به جانان خبر کنید(@)(@@) (@@) آن خضر را که آب حیات است در لبش %~% از حال تشنگان بیابان خبر کنید(@)(@@) (@@) جان میدهم در آرزوی دیدن رخش %~% آن حال مور پیش سلیمان خبر کنید(@)(@@) (@@) خضرم و لیک همچو سکندر به جستجوی %~% حیران شدم ز چشمهآ حیوان خبر کنید(@)(@@)(@@)(@@) | 941(@)(@@)(@@)(@@) | [مولانا خضری](@)(@@) ~~عرفه؛ همو آورده که مولانا خضری گوییا مملوک کسی بوده که خواجه او را، یا او خواجه را(@)(@@) ~~آزاد 
ms1051	 کرده، و الحال خواجهوار میگردد. از اوست:(@)(@@) (@@) عمر من بی رخت ای زهره جبین میگذرد %~% حیف اوقات شریفم که چنین میگذرد1(@)(@@)(@@)(@@) | 942)(@)(@@)(@@)(@@) | [محمد خلوتی](@)(@@) ~~عرفهآ خلوتی بزم حقیقت، محمد خلوتی. یکی از خلوتنشینان بزم حال بوده در انجمن(@)(@@) ~~متوسطین. و له:(@)(@@) (@@) خیز و دریاب و بیا، زنده ببین یکنفسی %~% که به جز دیدن روی تو ندارم هوسی(@)(@@) (@@) دستگیر از کرم خویش که درمانده شدم %~% آخرین دم نبود غیر تو فریاد رسی(@)(@@) (@@) چه کنم چند خورم خون جگر از غم تو %~% غم تو بحر محیط آمد و من همچو خسی(@)(@@) (@@) عد ازین خلوتی نام محمد به درت %~% بندهآ کمتر و کمتر زکسان نیز کسی PageV02P1228(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0566.jpg)(@)(@)(@@)(@@)(@@) | اسلطان خلیل بن میرانشاه](@)(@@) ~~عرفهآ جمشید سریر صاحب دولتی، خورشید سپهر عالی همتی، گوهر درج تاجداری،(@)(@@) ~~اختر برج بختیاری، نور حدیقهآ ابهت و عالیجاهی، نور حدقهآ سلطنت و پادشاهی، شهزادهآ(@)(@@) ~~دوستنواز بر اعادی منصور، سلطان خلیل بن میرانشاه بن امیر تیمور. به غایت صاحب(@)(@@) ~~جمال، نیکو خصال، پسندیده فعال بوده. دستگاه بخششی وسیع، پایهآ همتی رفیع داشت،(@)(@@) ~~لطیف ظریف، کریم رحیم ،کامل باذل، دانای توانا بوده. بعد از وفات صاحبقران بر تخت(@)(@@) ~~سمرقند به استقلال تمام و قدرت مالاکلام نشست و در عاطفت و نوازش باز کرده،(@)(@@) ~~گوهر افشانی دریوزه گر عمانی را منسوخ ساخت، و خزاینی که به مرور ایام حضرت(@)(@@) ~~صاحب قرانی جمع فرموده بودند به اندک روزی همه را صرف نموده، پریشان ساخت.(@)(@@) ~~القصه، چهار سال به موجب خاطرخواه داد عیش و سلطنت و بخشش داده، آنچه لازمهآ(@)(@@) ~~طرب و عیش و سلطنت بوده به احسن وجوه به جای آورد تا آنکه به سبب استیلای(@)(@@) ~~منکوحهآ او که از روی 217a تعطش1گرفته بود و در امور مملکت تصرفات عظیمه(@)(@@) ~~مینمود، امرا بر وی خروج کرده بشولیدند، الخاص جمعی متعین چون خداداد حسینی و(@)(@@) ~~خداداد جته و غیرهم. پس شاهزاده را گرفته محبوس نمودند و شاه ملک آغای حرم او را(@)(@@) ~~گوش و بینی 
ms1052	 به تیغ انتقام بریدند. بعد هذا میرزا شاهرخ لشکر جرار خونخوار به سمرقند(@)(@@) ~~درآورده سریر سلطنت را از غبار حوادث پاک رفته، بر تخت سلطنت و شهریاری پای ابهت(@)(@@) ~~و بختیاری نهاده، کوس جهانگیری فرو گرفت. و این واقعه در سنهآ احدی عشر و ثمانمایه(@)(@@) ~~[811] رخ نمود. این رباعی عالمگیر را شهزاده در حبس فرمودهاند:(@)(@@) دیروز چنان وصال جان افروزی %~% امروز چنین فراق عالم سوزی(@)(@@) افسوس که بر دفتر عمرم ایام %~% آن را روزی نویسد این را روزی(@)(@@) ~~و هم در حبس فرموده، نزد عم بزرگوار خود میرزا شاهرخ فرستادند: PageV02P1229(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0567.jpg)(@)(@)(@@) (@@) یا واهب العطیه ویا مقضی المراد %~% ما طاقت فراق نداریم ازین زیاد(@)(@@) (@@) ادبار شد مجاور و خوش گفت مرحبا %~% اقبال شد مسافر و خوش گفت خیر باد(@)(@@) (@@) بادی که از دیار محبت رسد به من %~% جانم فدای نکهت آن طرفه باد باد(@)(@@) (@@) غمگین و شادمان چو ازین دیر بگذریم %~% غمگین مشو ز محنت و ز رنج نیز شاد(@)(@@) (@@) داغ جهان ز سینهآ کاووس کی برفت %~% شادان ز بخت تیره بود تخت کیقباد(@)(@@) (@@) در ششدر فراق خلیل از مقیدی %~% روزی ترا سپهر ملاعب دهد گشاد(@)(@@) (@@) حکم خدا بداد به دست خسان مرا %~% کفرست پیش بنده ز حکم خدای داد(@)(@@) ~~اما بعد از ارسال این غزل میرزا شاهرخ نسبت به وی عاطفت وافیه مبذول داشته و وی را از(@)(@@) ~~حبس بر آورده، ایالت ری و قم و همدان تا بغداد تفویض فرمود، و سلطان خلیل دو سال و(@)(@@) ~~نیم دیگر به نیابت عم حکومت کرد و در رجب سنهآ اربع عشر و ثمانمایه [814] در ری به(@)(@@) ~~جوار حضرت حق پیوست. بیست و هشت سال عمر یافت و در وقت فوت گفته و این بیت(@)(@@) ~~را به میرزا پیر بداغ منسوب داشتهاند، علی ای حال این است:(@)(@@) ~~- گفتم بجاهلی، نکشد کس کمان ما مرگ آمد و کشید و کج آمد گمان ما(@)(@@) (@@) -لله الحمد که دیدار تو را دیده بدید %~% دل 
ms1053	 غمدیده دگر ره به مرادات رسید(@)(@@) آخرالامر به مقصود رسد میدانم %~% هر که مطلوب دل از دوست به زاری طلبید(@)(@@) (@@) حاصل عمر گرانمایه به نا وجه فروخت %~% هر که او حاصل کونین به یک جو نخرید(@)(@@) (@@) گوش جان دل عشاق تو از روز ازل %~% جز صدای غم عشق تو نوایی نشنید(@)(@@) هر کسی پیش دلآرام کشد آنچه بود %~% دل من هیچ نمییافت از آن، آه کشید(@)(@@) (@@) شکرها کرد که پابوس تو دریافت خلیل %~% زانکه بسیار به سر در طلب وصل دوید(@)(@@)(@@)(@@) | [خلقی بخاری](@)(@@) ~~عرفهآ مظهر پاکیزه خلقی و بختیاری، خلقی بخاری. از مردم متعین بخارا بو3، در PageV02P1230(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0568.jpg)(@)(@)(@@) ~~رفه خلیه /غرفهٔ‌ متوسطین(@)(@@) ~~نهایت رفاهیت خاطر و جمعیت ظاهر میگذرانیده. گویند جد ایشان از هرات به آن جانب(@)(@@) ~~افتاده. وله:(@)(@@) ~~تا به خال لعل میگونت فکندم دیده را غرق خون دیدم، سواد دیدة غمدیده را1(@)(@@) (@@) سوخت مغز استخوانم از غم و آگه نهای %~% کی بود معلوم مضمون نامهآ پیچیده را(@)(@@) (@@) تا نیندازد صبا دور از سر کوی توام %~% کاه دیوار تو میخواهم تن کاهیده را(@)(@@) ~~روی تو نادیده صد ره از درت گردیدهاماین بود خاصیت آری، بخت برگردیده را(@)(@@) ~~بیش ازین خلقی به من لاف سخندانی مزن این سخن لایق نباشد مردم سنجیده را(@)(@@) ~~و در مجالس النفایس امیر علیشیر آمده که خلقی بخاری بزاز بوده و به تجارت نیز معیشت(@)(@@) ~~نمودی، و او راست:(@)(@@) - خراب ماه وشان چو آفتابم من %~% به هر کدام جدا عاشق خرابم من(@)(@@) (@@) - میروی میرود از پی، دل بی حاصل من %~% آنچنان رو مه من، کز تو نماند دل من(@)(@@)(@@)(@@) | 945(@)(@@)(@@)(@@) | [مولانا خلفی تبریزی](@)(@@) ~~عرفهآ گوهر بحر درر انگیزی، مولانا خلفی2 تبریزی 2170 بسیار خوش طبیعت، خوش فهم(@)(@@) ~~واقع بوده، و در مجالس النفایس مذکور شده که وی از شیخ زادگان النجق است. در خلق و(@)(@@) ~~خلق پسندیده، در فهم و فراست به سر حد کمال رسیده، به سبب تحصیل از مولد به(@)(@@) ~~خراسان آمد 
ms1054	 و مصاحب بدیع الزمان میرزا بوده، به اسم عبدی این معما از اوست:(@)(@@) صد شکر که وصل دوست واقع شد باز %~% سوز دل و آب دیده مانع شد باز(@)(@@) خورشید بدیع ما اگر غایب بود %~% طالع مددی نموده، طالع شد باز1 PageV02P1231(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0569.jpg)(@)(@)(@@)(@@)(@@) | 946(@)(@@)(@@)(@@) | [مولانا خلقی هروی](@)(@@) ~~عرفهآ صاحب اخلاق معنوی، مولانا خلقی هروی. در مجالس امیر علیشیر آمده که طبع وی(@)(@@) ~~در وادی نظم بد نیست، و او راست:(@)(@@) (@@) ای سرو ناز در دل ما جا نمی کنی %~% جا میکنی، ولی به دل ما نمی کنی(@)(@@)(@@)(@@) | 941(@)(@@)(@@)(@@) | [سید خنجر](@)(@@) ~~عرفه؛ در مجالس آمده که سید خنجر از چیچکتو است، مدتی به جهت تحصیل علم در(@)(@@) ~~هرات آمده ساکن بود، اما به سپاهیگری رجعت نمود. و له:(@)(@@) (@@) جدا ز یار به جز درد اشتیاق ندارم %~% اجل بیا که دگر طاقت فراق ندارم2(@)(@@)(@@)(@@) | 948](@)(@@)(@@)(@@) | [خواند امیر](@)(@@) ~~عرفه، هم در مجالس امیر علیشیر آمده که غیاث الدین بن همام الدین خواند امیر فرزند(@)(@@) ~~میر خواند مورخ است و جوانی با صلاحیت 1. در فن تاریخ به غایت ماهر است، و الحق(@)(@@) ~~هزار چندان است که وی گفته، چه صاحب حبیب السیر است و او را همین تعریف کافی(@)(@@) ~~است. او راست معما به اسم تقی:(@)(@@) روی آن دلربای مهر گسل %~% فتنه با خالهاش گشت ای دل PageV02P1232(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0570.jpg)(@)(@)(@@) ~~و مترجم مجالس النفایس آورده که سید خواند امیر پسر یا خواهرزادهآ میر خواند مورخ(@)(@@) ~~قطعهای در مرثیهآ امیر علیشیر گفت، و ملا صاحب یک مصرع در تاریخ ولادت و یک(@)(@@) ~~مصرع در تاریخ فوت او قصیده گفت1، و شعر خواند امیر این است:(@)(@@) جناب امیر هدایت پناهی %~% که ظاهر از او گشت آثار رحمت(@)(@@) شد از خارزار جهان سوی باغی چو نازل شد ابواب رحمت به روحش %~% بجو سال(@)(@@) فوتش ز(انوار رحمت/ 906)2 %~% که آنجا شکفتهاست گلزار رحمت(@)(@@) ~~پوشیده نماند که میان آن دو شخص مخالفت است که یکی خواهرزاده و یکی فرزند ویش(@)(@@) ~~دانسته، 
ms1055	 اما سید غیاث الدین خواند میر مذکور در حبیب السیر به مدح پدر خویش(@)(@@) ~~همام الدین امیر خواند بن خاوند شاه گفته و نقل نموده، جایی که خود را از شاگردان وی(@)(@@) ~~دانسته و نسبت فرزندی هم ظاهر ساخته، چه میگوید که نقل مقال نسبت به آن حضرت(@)(@@) ~~علاقهآ فرزندی ثابت دارم و به زبان گستاخی خود را در سلک شاگردانش در میآرم، سبحان(@)(@@) ~~الله غلط گفتم، انتساب قطره به دریا عین بی ادبی است و اقتباس ذره از خورشید بوالعجبی،(@)(@@) ~~پس درین معنی گفته است:(@)(@@) چه نسبت ذره را با مهر انور %~% نمی شاید خزف در عقد گوهر(@)(@@) اگر خواهم که باشد آبرویم %~% همی گویم که من شاگرد اویم(@)(@@) نه شاگردم، غلام کمترینم %~% به گرد خرمن او خوشه چینم(@)(@@) (@@) او راست: -دردا که ز هجرت دل من خون شد %~% خون جگرم ز چشم تر بیرون شد(@)(@@) در آرزوی تو جان من محزون شد %~% دل پیش تو بود حالش آیا چون شد؟(@)(@@) - کی باشد کی که بخت دمساز آید %~% بار از در من باز به اعزاز آید(@)(@@) مرغ طربم باز به پرواز آید %~% عنی که سفر کردهآ من باز آید(@)(@@) - زنهار به حرف این و آن گوش مکن %~% لب را ز حدیث لطف خاموش مکن PageV02P1233(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0571.jpg)(@)(@)(@@) (@@) گر از سخنم یاد نیاری باری %~% از وعدهآ خویشتن فراموش مکن(@)(@@) (@@) - رشح قلم تو رنگ ظلم از دل شست %~% سر سبز نهال عدل از خامهآ تست(@)(@@) (@@) مکتوب تو شد تذکرهآ دولت ما %~% ای از رقمت سجل اقبال درست218a(@)(@@) ~~در تاریخ ولادت تقی الدین صدر گفته:(@)(@@) (@@) هاتفی مژدهرسان از سر لطف %~% بنده را گفت بشارت بادا(@)(@@) (@@) که نمود اختر مسعود طلوع %~% منزلش برج امارت بادا(@)(@@) (@@) بهر تاریخ و دعایش گفتم %~% (دری اوج صدارت بادا /919)(@)(@@) ~~[در تاریخ فوت سید رضی الدین گفته:](@)(@@) (@@) سید فاضل رضی الدین که بود %~% زبدهآ اولاد امجاد بتول(@)(@@) (@@) رفت از دار فنا سوی بهشت %~% شد مقیم کوی ارباب وصول(@)(@@) (@@) بهر سال 
ms1056	 انتقالش عقل گفت %~% (انتقال زبدهٔ‌ آل رسول /927)(@)(@@) ~~و در تاریخ میر محمد امین گفته:(@)(@@) (@@) از حکم قضای حضرت یزدانی %~% چون میر محمد امین شد فانی(@)(@@) (@@) از سال و مه واقعه پرسید کسی %~% گفتم که (اوایل ربیع الثانی /922)1(@)(@@)(@@)(@@) | ،93(@)(@@) [مولانا خواجوی کرمانی](@)(@@) ~~عرفهآ مفخر الفضلا، زبدة الفصحا، استاد الکلام، اسناد الانام، میوة نخل سخندانی، نخلبند(@)(@@) ~~عرصهآ معانی، مولانا خواجوی کرمانی. از بزرگزادههای آن ولایت است، طبعی قادر(@)(@@) ~~و ذهنی ساحر داشته. شاعری در فنون سخن ماهر است و کمال قدرت و حالت از بطون(@)(@@) ~~بیان او ظاهر. نخل سخن را میوهای از نوبر خاطرش بهتر نیست و نخلبند نظم را شیوهای از PageV02P1234(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0572.jpg)(@)(@)(@@) ~~طرز فکرتش خوشتر نه، چراغ معانی را فطرت او چون نور و باغ سخندانی را فکرت او(@)(@@) ~~چون نور. گویند اکثر اوقات از سیاحت مرهم راحت بر زخم سینهآ پر جراحت نهادی، و(@)(@@) ~~در بستهآ امید خود را از مفتاح نجاح درویشان بزرگوار برگشادی. اشعار آبدارش چون(@)(@@) ~~شعار خسروان همه نفیس و یک دست، نو خطان ضمیرش چون غمزهآ خوبان دلخواه و(@)(@@) ~~سر مست، اقسام سخن را چنان گفته که به آن سلاست و جزالت و پختگی کم کسی را(@)(@@) ~~نظمی رخ نموده، و قصایدش همه عالی، مثنویات بامزه و متوالی، غزل همه چون یواقیت(@)(@@) ~~و لآلی. از جملهآ اشعارش همای و همایون است که به سام نامه انحراف یافته و مشهر(@)(@@) ~~است، و روضة الابرار که در مقابلهآ مخزن الاسرار است و آن را چنان گفته که بعد از شیخ(@)(@@) ~~نظامی در آن بحر هیچکس چنان شعری ندارد، و کمال نامه در بحر حدیقه، و گوهرنامه(@)(@@) ~~بهائیه1 وگل و نوروز در بحر خسرو و شیرین به نظم آورده، مدح سلطان ابوسعیدخان و(@)(@@) ~~مدح وزیر اعظم وی خواجه غیاث الدین محمد بسیار گفته. و گل و نوروز وی که به دیگران(@)(@@) ~~منسوب کردند، یا دیگر شعری است، یا سهو است. کلیاتش به نظر مخلص گذشته.(@)(@@) ~~نقل 
ms1057	 است که در ایام سفر مدتها در صوفی آباد شیخ علاءالدوله سمنانی اعتکاف نموده، و(@)(@@) ~~ارادت وافی شافی صادق به وی داشته، در حق پیر خود فرموده:(@)(@@) هر کو به ره علی عمرانی شد %~% چون خضر به سرچشمهآ حیوانی شد(@)(@@) از وسوسهآ غارت شیطانی رست %~% مانند علا دولهآ سمنانی شد(@)(@@) ~~کلیات خواجه قریب بیست هزار بیت باشد و در سنهآ اثنی و اربعین و سبعمایه موافق (عنقا(@)(@@) ~~صفتان /842)2 و (خاصان /742) و (عزت دارین /742)3 در شیراز وفات یافت.(@)(@@) ~~مضجعش زیر تل الله اکبر است. کما قالوا: PageV02P1235(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0573.jpg)(@)(@)(@@) تن خواجوی کرمانی به شیراز %~% به تنک افتاده آست آلله آکب(@)(@@) ~~و او راست(@)(@@) (@@) پیش صاحب نظران ملک سلیمان بادست %~% بلکه آن است سلیمان که ز ملک آزادست(@)(@@) (@@) آنکه گویند که بر آب نهادهاست جهان %~% مشنو ای خواجه که تا در نگری بر بادست(@)(@@) (@@) دل درین پیرزن عشوهگر دهر مبند %~% نو عروسیاست که در عقد بسی دامادست(@)(@@) (@@) خیمه انس مزن بر در این کهنه رباط %~% که اساسش همه ناموقع و بیبنیادست(@)(@@) (@@) هر زمان مهر فلک بر دگری میافتد %~% چه توان کرد که آن شغل چنین افتادست 2180(@)(@@) (@@) گر پر از لالهآ سیراب شود دامن کوه %~% نیست آن لاله که خون جگر فرهادست(@)(@@) (@@) حاصلی نیست به جز غم به جهان خواجو را %~% خرم آنکس که به کلی ز جهان آزادست(@)(@@) (@@) - چو شد مواصلت قرب معنوی حاصل %~% چه غم ز مدت هجران بیکران ما را(@)(@@) (@@) دین و دنیا گر نباشد گو مباش %~% چون تو هستی هرچه مقصودست هست(@)(@@) - ای که هرگز نمیکنی یادم %~% نکنم یک نفس فراموشت(@)(@@) (@@) -خواجو ز پا در آمد و هیچش به دست نیست %~% جز دامن امید، که محکم گرفته است(@)(@@) (@@) - جان من جان مرا چون ضرر از بیماری است %~% نظری کن که به جانم خطر از بیماری است(@)(@@) (@@) چه شود گر به عیادت قدمی رنجه کنی %~% که فغانم همه شب تا سحر از بیماری است(@)(@@) (@@) - ز خانه هیچ نخیزد 
ms1058	 سفر گزین خواجو %~% که شمع دل بنشاند آنکه در وطن نیست(@)(@@) (@@) .گر ما خطا کنیم عطای تو بی حد است %~% نومیدی از عطای تو حد خطای ماست(@)(@@) (@@) - تو چه یاری که نداری غم و اندیشهآ یار %~% یاری آن است که یار از غم یار اندیشد(@)(@@) (@@) -ای مه روشن اگر جان منی زود بر آی %~% وی شب تیره اگر عمر منی دیر مپای(@)(@@) (@@) - سرو را بر لب هر چشمه اگر جای بود %~% جای آن است که بر چشم منش باشد جای(@)(@@) (@@) - هرکه در ابروی چون ماه نوت دارد چشم %~% گردد از مهر تو چون ماه نو انگشت نمای(@)(@@) (@@) - کز لعل آبدار تو نعلم در آتش است %~% زان رو دلم چو زلف سیاهت مشوش است(@)(@@) (@@) - امشب به خواب زلف خوشت را کشیدمی %~% زانم هنوز رشتهآ جان در کشاکش است(@)(@@) (@@) - سرو را کار ببندد چو میان تنگ ببندی %~% روح را دل بگشاید چو تو برقع بگشایی(@)(@@) (@@) چون در آیی نتوانم که مراد از تو بجویم %~% که من از خود بروم چون تو پری چهره در آیی PageV02P1236(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0574.jpg)(@)(@)(@@) (@@) - من به غوغای رقیبان ز درت باز نگردم %~% که گدا گر بکشندش نکند ترک گدایی(@)(@@) (@@) -تا پشت کمان می شکند ابروی شوخت %~% پیوسته چو ابروی تو پشتم چو کمان است(@)(@@) (@@) آن موی میان تو که سازد کمر از موی %~% مویی به میان آمده یا موی میان است(@)(@@) (@@) - از باد صبا در خم زلفت چو خم افتد %~% صد عاشق دل سوخته در بحر غم افتد(@)(@@) (@@) مشتاق حرم گر بزند آه جگر سوز %~% آتش به مغیلان و دخان در حرم افتد(@)(@@) (@@) - در خرمن خورشید زند آه من آتش %~% زان در تو نگیرد که نداری رخ کاهی(@)(@@) ~~- شب نیست که فریاد به گردون نرسانم - من پرستار دو چشم خوش بیمار(@)(@@) توام %~% گر چه بیمار پرستی بتر از بیماری است %~% لیکن چه توان کرد که فریادرسی نیست(@)(@@) (@@) کس نیست که در دل غم عشق تو ندارد %~% کان را که 
ms1059	 غم عشق کسی نیست، کسی نیست(@)(@@) (@@) - میانش موی و آن شیرین1 دهان هیچ %~% ازین مویی نمیبینم در آن هیچ(@)(@@) (@@) دهانش گویی از تنگی که هیچ است %~% بدان تنگی ندیدم در جهان هیچ(@)(@@) (@@) میانش یک سر مویست و گویی %~% ندارد یک سر مو در میان هیچ(@)(@@) (@@) دهانش بی گمان همچون میان تنگ2 %~% میانش بی سخن همچون دهان هیچ(@)(@@) (@@) - کجا رسم به مکانت که پشهای نتواند %~% که در نشیمن سیمرغ آشیانه کند(@)(@@) (@@) -چون آبگینه این دل مجروح نازکم %~% هر چند بیشتر شکند تیزتر شود(@)(@@) ~~- کی برکنم دل از رخ جانان که مهر او - منزل ار یار قرین است چه دوزخ(@)(@@) چه بهشت %~% با شیر در دل آمد و با جان به در شود %~% سجدهای کان نه نیازست3، چه مجد چه کنشت(@)(@@) (@@) گر سر تربت من باز گشایی بینی %~% قالبم سوخته و گل شده از خون همه خشت(@)(@@) (@@) - هلاک خود به دعا خواستم، ولی چه کنم %~% که دیر دعوت من مستجاب میگردد(@)(@@) (@@) دل است کاین همه خونم ز دیده میریزد %~% براست5 کآفت جان عقاب میگردد(@)(@@) (@@) عجب نباشد اگر شد سیاه و سودایی %~% چنین که زلف تو در آفتاب میگردد(@)(@@) (@@) - قلم چه شرح دهد زانکه داستان فراق %~% نه ممکن است که یک شمه در بیان آید PageV02P1237(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0575.jpg)(@)(@)(@@) (@@) چو خونیان بدود اشک و دامنم گیرد %~% که باش تا خبر یار مهربان آید(@)(@@) (@@) مه را اگر از مشک زرهپوش توان کرد %~% تشبیه بدان زلف و بناگوش توان کرد(@)(@@) (@@) می تلخ نباشد چو ز دست تو ستانند %~% کز دست تو گر زهر بود نوش توان کرد(@)(@@) (@@) گر دست دهد دولت1 وصل تو زمانی %~% غمهای جهان جمله فراموش توان کرد(@)(@@) (@@) همچو خورشید رخ اندر پس دیوار مپوش %~% زانکه کس چشمهآ خورشید به گل ننهفته است(@)(@@) (@@) دل گمگشته که بر خاک رهت2 می جستم %~% گوییا زلف تو دارد که بسی آشفته است(@)(@@) (@@) - به ره در خواهد آمد طفل اشکم %~% بدین گرمی که گلگون میدواند(@)(@@) هر بت که مغانش 
ms1060	 سجده کردند %~% چون نیک بدیدم آن شمن بود(@)(@@) در آینه روی یار جستم %~% خود آینه روی یار من بود(@)(@@) چون پرده ز روی خویش برداشت %~% خود پردهآ روی خویشتن بود(@)(@@) (@@) - ای سبزه دمانیده به گرد قمر از موی %~% سر سبزی خط سیهات سر به سر از موی(@)(@@) (@@) بی موی میانت تن من در غم1 هجران %~% چون موی میانت شده باریکتر از موی(@)(@@) مویی است دهان تو و در موی شکافی %~% هنگام سخن ریخته لؤلؤی تر از موی(@)(@@) - به ناکام از لبت برداشتم دل %~% که از لعل تو کامی بر نیاید(@)(@@) حدیث سوز عشق از پختگان پرس %~% که دود دل ز خامی بر نیاید(@)(@@) (@@) د طره بفشان و مرا بیش پریشان مگذار %~% پرده بگشای و مرا بستهآ هجران مگذار(@)(@@) (@@) زلف مشکین که چنین بر قدمت دارد سر %~% بیش ازینش چو من خسته پریشان مگذار(@)(@@) (@@) باغبان را اگر از غیرت بلبل خبر است %~% گو دگر باد صبا را به گلستان مگذار(@)(@@) (@@) و سرد باشد هر که او بیمهر رویی دم زند %~% چون دم مهر از دم گرمست از آنرو سرد نیست(@)(@@) (@@) در جهان مردی نمیبینم که از دردی جداست %~% یک طربناکاست درگردون و آنهم مرد نیست(@)(@@) (@@) - عمری است که آن عمر عزیزم بشد از دست %~% ماهیاست که آن طلعت چون ماه بدیدم(@)(@@) (@@) - به حق صحبت دیرین که حق صحبت دیرین %~% روا مدار که گردد چو وعدههای تو باطل(@)(@@) (@@) - از عمر چو این یک دو نفس بیش نداریم %~% بنشین نفسی تا نفسی با تو بر آریم PageV02P1238(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V02_0576.jpg)(@)(@)(@@) ~~به وقت خنده ز لعل تو جان فرو ریزد - جز غم به جهان هیچ نداریم ولیکن(@)(@@) %~% به گاه جلوه ز سروت روان فرو ریزد %~% گر هیچ نداریم، غم هیچ نداریم(@)(@@) (@@) چو جعد شانه زنی1 صد هزار دل بینی %~% کزان دو سلسله دلستان فرو ریزد(@)(@@) (@@) به یاد لعل تو هر لحظه خون مژگانم %~% چو دانه گهر از ریسمان فرو ریزد(@)(@@) (@@) ز تاب آتش قهر تو مغز 