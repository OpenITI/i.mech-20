ms1701	 لا يدخل مكة سافك دم روى عنه سفيان بن وكيع وهذا مما أدخل على سفيان بن وكيع(@)(@@)(@@)(@@) $ 15772 - موسى بن هارون البردى من أهل المدينة كان يبيع التمر PageV09P160 البردى فنسب إليه يروي عن بن عيينة وكان راويا للوليد بن مسلم روى عنه محمد بن يحيى الذهلي ربما أخطأ(@)(@@)(@@)(@@) $ 15773 - موسى بن أيوب بن عياض أبو سلمة الليثي من أهل البصرة يروي عن أبيه والبصريين روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 15774 - موسى بن مروان الرقى أبو عمران يروي عن المعافي بن عمران وبقية حدثنا عنه الحسن بن عبد الله القطان بالرقة وغيره من شيوخنا مات في صفر سنة أربعين ومائتين(@)(@@)(@@)(@@) $ 15775 - موسى بن محمد بن حيان من أهل البصرة كنيته أبو عمران يروي عن يحيى القطان والعراقيين حدثنا عنه أبو يعلى ربما خالف مات سنة بضع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 15776 - موسى بن أيوب النصيبي أبو عمران سكن طرسوس يروى عن بن المبارك روى عنه ابنه عمران بن موسى وأهل الشام والثغر(@)(@@)(@@)(@@) $ 15777 - موسى بن خالد يروي عن بن المبارك روى عنه عبد الله بن عبد الرحمن الدارمي(@)(@@)(@@)(@@) $ 15778 - موسى بن سليمان بن عبد العجلى من أهل البصرة يروي عن حماد بن مسلمة وسلام بن أبي مطيع حدثنا عنه عمران بن موسى بن مجاشع السختياني وغيره يغرب PageV09P161(@)(@@)(@@)(@@) $ 15779 - موسى بن عامر بن عمارة بن حريم المري أبو عامر من أهل دمشق يروي عن محمد بن حمير وعراك بن خالد حدثنا عنه بن جوصا وغيره يغرب(@)(@@)(@@)(@@) $ 15780 - موسى بن محمد بن الحكم الشيباني من أهل الكوفة يروي عن وكيع حدثنا عنه محمد بن سليمان بن فارس لم أر في حديثه إلا الاستقامة(@)(@@)(@@)(@@) $ 15781 - موسى بن أبي الوليد أبو الوليد الجاروذى من أهل مكة يروي عن بن عيينة وكان راويا للشافعي حدثنا عنه أحمد بن محمد بن الأزهر وغيره(@)(@@)(@@)(@@) $ 15782 - موسى بن السندي أبو محمد يروي عن وكيع بن الجراح وأبى نعيم والمؤمل حدثنا عنه عمران بن موسى بن مجاشع ثنا موسى بن السندي ثنا 
ms1702	 المؤمل بن إسماعيل قال سمعت أبا حنيفة يقول يقولون من كان طويل اللحية لم يكن له عقل ولقد رأيت علقمة بن مرثد طويل اللحية وافر العقل(@)(@@)(@@)(@@) $ 15783 - موسى بن عبد الرحمن القلا من أهل أنطاكية يروي عن أبي معاوية الضرير وأهل العراق حدثنا عنه الفضل بن محمد العطار بأنطاكية يغرب(@)(@@)(@@)(@@) $ 15784 - موسى بن بحر المروزي أبو عمران أصله من العراق يروى PageV09P162 عن عباد بن العوام ووكيع بن الجراح حدثنا عنه الحسن بن سفيان مات سنة ثلاثين ومائتين(@)(@@)(@@)(@@) $ 15785 - موسى بن حزام الترمذي أبو عمران يروي عن زيد بن الحباب وأبى نعيم روى عنه أحمد بن سيار وأهل بلده وكان في ابتداء أمره ينتحل الأرجاء ثم أعانه الله بأحمد بن حنبل وانتحل السنة وذب عنها وقمع من خالفها مع لزوم الدين إلى أن مات رحمه الله(@)(@@)(@@)(@@) $ 15786 - موسى بن سليمان المنبجي يروي عن بقية بن الوليد حدثنا عنه عمر بن سعيد بن سنان مستقيم الحديث إذا روى عن بقية بن الوليد(@)(@@)(@@)(@@) $ 15787 - موسى بن سفيان الجنديسابوري يروي عن عيسى بن جعفر قاضي الري حدثنا عنه إبراهيم بن محمد الدستوائي وغيره من شيوخنا(@)(@@)(@@)(@@) $ 15788 - موسى بن النعمان من أهل البصرة سكن مصر يروي عن أبي نعيم وأبى الوليد حدثنا عنه محمد بن المنذر بن سعيد(@)(@@)(@@)(@@) $ 15789 - موسى بن عيسى شيخ يروي عن أبي حفص الآبار عن أبي سهل الأزدي حدثنا محمد بن المنذر ثنا محمود بن محمد بن أبي المضا ثنا موسى بن عيسى(@)(@@)(@@)(@@) $ 15790 - موسى بن نصر الرازي من أهل الري وكان من عقلائهم صدوق في الحديث يروي عن جرير بن عبد الحميد حدثنا عنه أصحابنا مات سنة ثلاث وستين ومائتين PageV09P163(@)(@@)(@@)(@@) $ 15791 - موسى بن عبد الرحمن بن مسروق الكندي من أهل الكوفة يروي عن محمد بن بسر العبدي وأبى أسامة حدثنا عنه أحمد بن محمد بن يحيى بن زهير وغيره كنيته أبو عيسى(@)(@@)(@@)(@@) $ 15792 - موسى بن إسحاق الكندي يروي عن وكيع عداده في أهل الكوفة حدثنا عنه محمد بن المنذر وغيره 
ms1703	(@)(@@)(@@)(@@) $ 15793 - مالك بن أبي الرجال واسم أبي الرجال محمد بن عبد الرحمن الأنصاري يروي عن أبيه عن عمرة روى عنه عبيد الله بن موهب(@)(@@)(@@)(@@) $ 15794 - مالك بن زياد يروي عن عمر بن عبد العزيز روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 15795 - مالك بن إسماعيل أبو غسان النهدي من أهل الكوفة يروي عن زهير بن معاوية وإسرائيل روى عنه بن أبي شيبة وأهل العراق مات سنة تسع عشرة ومائتين(@)(@@)(@@)(@@) $ 15796 - أبو غسان المسمعي اسمه مالك بن عبد الواحد يروي عن المعتمر بن سليمان روى عنه الحسن بن يحيى الرزى ومسلم بن الحجاج يغرب PageV09P164(@)(@@)(@@)(@@) $ 15797 - مالك بن سليمان بن مرة النهشلي من أهل هراة يروي عن بن أبي ذئب ومالك روى عنه أهل بلده وكان مرجئا ممن جمع وصنف يخطىء كثيرا وامتحن بأصحاب سوء كانوا يقلبون عليه حديثه ويقرؤن عليه فان اعتبر المعتبر حديثه الذي يرويه عن الثقات ويروي عنه الأثبات مما بين السماع فيه لم يجدها إلا ما يشبه حديث الناس على أنه من جملة الضعفاء أدخل إن شاء الله وهو ممن استخير الله عز وجل فيه(@)(@@)(@@)(@@) $ 15798 - مالك بن سليمان أبو أنس الحمصي الألهاني يروي عن بقية بن الوليد حدثنا عنه الفضل بن محمد العطار والحسن بن إبراهيم بن فيل قدم العراق فحدثهم(@)(@@)(@@)(@@) $ 15799 - مالك بن يحيى بن عمرو بن مالك النكري أبو غسان من أهل البصرة يروي عن أبيه روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 15800 - مالك بن خالد بن داود الواسطي أبو غسان يروي عن يزيد بن هارون حدثنا عنه خنيس بن عبد الله السلمي بواسط(@)(@@)(@@)(@@) $ 15801 - مالك بن حريص من أهل هراة يروي عن يزيد بن هارون وأهل بلده مستقيم الحديث(@)(@@)(@@)(@@) $ 15802 - مالك بن الفديك يروي عن زفر بن الهذيل مستقيم الحديث روى عنه الكوفيون PageV09P165(@)(@@)(@@)(@@) $ 15803 - مالك بن الخليل بن بشير بن نهيك اليحمدي كنيته أبو غسان من أهل البصرة يروي عن بن أبي عدى حدثنا محمد بن هشام بن عروة عن أبيه عن جده عن عبد الله بن 
ms1704	 عمرو قال قال رسول الله صلى الله عليه وسلم إن الله لا يقبض العلم انتزاعا ينتزعه من العباد ولكن يقبض العلم بقبض العلماء حتى إذا لم يبق عالم اتخذ الناس رؤسا جهالا فسئلوا فأفتوا بغير علم فضلوا وأضلوا قال ثم لقيته بعد سنين فحدثني به حدثناه محمد بن المسيب وغيره قال ثنا مالك بن الخليل ثنا بن أبي عدي مات بعد سنة خمسين ومائتين(@)(@@)(@@)(@@) $ 15804 - مالك بن يحيى السوسي أبو غسان سكن بغداد يروي عن يزيد بن هارون وعبد الوهاب بن عطاء وأهل العراق روى عنه أهلها مستقيم الحديث حدثنا الحسين بن إسحاق الأصبهاني ثنا مالك بن يحيى السوسي ثنا عبد الوهاب بن عطاء عن معبد عن قتادة عن الحسن في قوله عز وجل واوينهما إلى ربوة ذات قرار ومعين قال بيت المقدس(@)(@@)(@@)(@@) $ 15805 - معاوية بن سعيد بن شريح التجيبي من أهل مصر يروي المقاطيع روى عنه بن وهب(@)(@@)(@@)(@@) $ 15806 - معاوية بن هشام القصار أبو الحسن مولى بنى أسد من أهل الكوفة يروي عن الثوري وشريك روى عنه بن أبي شيبة وأهل PageV09P166 العراق مات سنة أربع أو خمس ومائتين أخطأ(@)(@@)(@@)(@@) $ 15807 - معاوية بن حفص يروي عن داود بن أبي المهاجر روى عنه أحمد بن عبد الله بن يونس اليربوعي(@)(@@)(@@)(@@) $ 15808 - معاوية بن عمرو بن المهلب الأزدي كنيته أبو عمرو من أهل بغداد يروي عن زائدة وأبى إسحاق الفزاري روى عنه العراقيون مات ببغداد سنة ثلاث عشرة ومائتين في جمادى الأولى وقد قيل سنة أربع عشرة ومائتين(@)(@@)(@@)(@@) $ 15809 - معاوية بن عمار بن معاوية الدهني البجلي ودهن قبيلة من بجيلة من أهل الكوفة يروي عن أبيه وجعفر بن محمد روى عنه يحيى بن يحيى والناس(@)(@@)(@@)(@@) $ 15810 - معاوية بن حفص الشعبي يروي عن أبي معاوية الضرير وعن محمد بن سوقة عن نافع عن بن عمر قال كنا نعد في زمان رسول الله صلى الله عليه وسلم أبا بكر وعمر وعثمان ثم نسكت حدثنا أحمد بن عمير بن جوصا ثنا أبو حميد بن سيار 
ms1705	 ثنا معاوية بن حفص الشعبي ثنا أبو معاوية(@)(@@)(@@)(@@) $ 15811 - معاوية بن عبد الله بن معاوية بن المنذر بن الزبير بن العوام يروي عن PageV09P167 عائشة بنت الزبير بن هشام بن عروة عن هشام بن عروة حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 15812 - مغيرة بن عبد الملك مولى قريش يروي المقاطيع روى عنه إسحاق بن موسى(@)(@@)(@@)(@@) $ 15813 - مغيرة بن زيد الجعفي يروي عن جده عداده في أهل الكوفة روى عنه محمد بن عبد الله الأسدي(@)(@@)(@@)(@@) $ 15814 - مغيرة بن قيس يروي عن عمرو بن شعيب روى عنه أبو عامر العقدي(@)(@@)(@@)(@@) $ 15815 - مغيرة بن الحسن بن راشد الهاشمي من أهل مصر يروي عن يحيى بن عبد الله بن سالم روى عنه بن أخته سعيد بن كثير بن عفير(@)(@@)(@@)(@@) $ 15816 - مغيرة بن عطية يروي عن عبد الملك بن عبد العزيز روى عنه سليمان الجرمي(@)(@@)(@@)(@@) $ 15817 - مغيرة بن محمد أبو المهلب يروي عن الضحاك بن مزاحم روى عنه يونس بن محمد المؤدب PageV09P168(@)(@@)(@@)(@@) $ 15818 - مغيرة بن معمر أبو الفضل من أهل البصرة يروي عن مسعدة بن اليسع عن بهز بن حكيم عن أبيه عن جده قال قلت يا رسول الله إن لي جارين فإلى أيهما أهدي قال إلى أقربهما بابا حدثنا أبو يعلى بالموصل ثنا مغيرة بن معمر ثنا مسعدة(@)(@@)(@@)(@@) $ 15819 - مغيرة بن أبي الجر الكندي يروي عن سعيد بن أبي بردة عداده في أهل الكوفة روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 15820 - مغيرة بن موسى من أهل خوارزم يروي عن سعيد بن أبي عروبة ويعرف بصاحب بن أبي عروبة روى عنه أهل بلده وكان بن مهدى يكثر الثناء عليه وكان أصل المغيرة من البصرة(@)(@@)(@@)(@@) $ 15821 - مغيرة بن محمد المهلبي أبو حاتم البصري سكن السوس يروي عن الأنصاري روى عنه أهل بلده(@)(@@)(@@)(@@) $ 15822 - مغيرة بن سلمة أبو هشام المخزومي القرشي من أهل البصرة يروي عن وهيب بن خالد والبصريين روى عنه إبراهيم بن سعيد الجوهري ومحمد بن يحيى الذهلي مات سنة مائتين(@)(@@)(@@)(@@) $ 15823 - مغيرة بن عبد الرحمن بن عوف بن 
ms1706	 حبيب بن محمش مولى PageV09P169 بنى أسد كنيته أبو أحمد من أهل حران يروي عن يحيى بن السكن وأبى أسامة وأهل بلده حدثنا عنه أبو عروبة مات ليلة الجمعة لأربع بقين من جمادى الآخرة سنة ثلاث وأربعين ومائتين(@)(@@)(@@)(@@) $ 15824 - منصور بن عمار القاص كنيته أبو السرى أصله من مرو يروي عن بن لهيعة والليث بن سعد روى عنه ابنه سليم بن منصور والناس أخباره في القصص والحث على الخير أكثر من أن يحتاج إلى ذكرها ليس من أهل الحديث الذين يحفظون وأكثر روايته عن الضعفاء وفي القلب منه لروايته عن بن لهيعة عن يزيد بن أبي حبيب عن مرتد بن عبد الله اليزني عن عقبة بن عامر قال قال رسول الله صلى الله عليه وسلم مشاش الطير يورث السل حدثنيه محمد بن داود الرازي ثنا أحمد بن شريح الرازي ثنا منصور بن عمار ثنا بن لهيعة وليس هذا من حديث بن لهيعة وإن كان ضعيفا(@)(@@)(@@)(@@) $ 15825 - منصور أبو أمية حضر عمر بن عبد العزيز قال كان عمر بن عبد العزيز له سفط في كوة مفتاحه في إزاره وكان يتغفلني فإذا ظن إني قد نمت فتح السفط فأخرج منه جبة من شعر ورداء من شعر PageV09P170 فلبسهما وقام يصلى الليل كله فإذا نودي بالصبح نزعه ورده في مكانه رواه عنه داود بن رشيد(@)(@@)(@@)(@@) $ 15826 - منصور بن وردان الأسدي العطار يروي عن يوسف بن أبي إسحاق وعلي بن عبد الأعلى الكوفي روى عنه أهل العراق حدثني الحسين بن عبد الله القطان ثنا إسحاق بن موسى الأنصاري ثنا عنه منصور بن ورادن ثنا يوسف بن أبي إسحاق عن أبي إسحاق عن الحارث عن علي قال إن لله ديكا رجلاه في الأرض السابعة وجناح له بالمشرق وجناح له بالمغرب وعنقه مثنية تحت العرش يسبح الله ويحمده ويقدسه فإذا مضى من الليل ما شاء الله أن يمضي صفق بجناحيه فقال قدوس قدوس رب الملك الحق لا إله إلا هو فعند ذاك تصيح الديوك وتصفق بأجنحتها(@)(@@)(@@)(@@) $ 15827 - منصور 
ms1707	 بن سلمة الليثي يروي عن حكيم بن محمد بن عبد الله بن قيس عن أبيه عن أبي هريرة روى عنه زيد بن حباب(@)(@@)(@@)(@@) $ 15828 - أبو نصر الذي يروي عن مقاتل بن سليمان اسمه منصور بن عبد الحميد من أهل بيورد روى عنه الناس يعتبر حديثه إذا كان فوقه ودونه الثقات(@)(@@)(@@)(@@) $ 15829 - منصور بن عكرمة أبو عكرمة الكلابي بصرى يروى PageV09P171 عن بن عون وأبى حرة روى عنه أهل بلده(@)(@@)(@@)(@@) $ 15830 - منصور بن سريرة شيخ مروزي يروى عن بن المبارك روى عنه المراوزة(@)(@@)(@@)(@@) $ 15831 - منصور بن رجاء يروي عن إسماعيل بن عبيد الله بن أبي المهاجر روى عنه سعيد بن عبد الجبار الزبيري(@)(@@)(@@)(@@) $ 15832 - منصور بن أبي نويرة يروي عن الحسن بن صالح بن حي وأبى بكر بن عياش روى عنه محمد بن سفيان بن أبي الزرد الأبلى مستقيم الحديث(@)(@@)(@@)(@@) $ 15833 - منصور بن إسماعيل مولى بنى أمية كنيته أبو إسماعيل من أهل حران يروى عن بن جريج وخصيف روى عنه إبراهيم بن سعيد الجوهري وأهل بلده مات سنة مائتين وصلى عليه إبراهيم بن سعيد الهنى وكان ممن يفتى على مذهب الكوفيين وكان على قضاء المدينة يغرب حدثني بن ناجية ثنا صالح بن زياد السوسي ثنا منصور بن إسماعيل ثنا بن جريج وطلحة بن عمرو عن عطاء عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم زر غبا تزدد حبا حبا(@)(@@)(@@)(@@) $ 15834 - منصور بن سلمة الخزاعي أبو سلمة من أهل بغداد يروي عن الليث بن سعد ومالك بن أنس روى عنه أحمد بن منصور الرمادي وأهل العراق مات سنة تسع ومائتين بطرسوس PageV09P172(@)(@@)(@@)(@@) $ 15835 - منصور بن أبي مزاحم أبو نصر واسم أبي مزاحم بشير مولى الأزد من أهل بغداد يروي عن شريك وعبد الرحمن بن أبي الموالي حدثنا عنه حامد بن محمد بن شعيب الكجي وغيره من شيوخنا مات سنة خمس وثلاثين ومائتين(@)(@@)(@@)(@@) $ 15836 - منصور بن الجنيد أبو محمد من أهل سرخس يروي عن خارجة وقال قلت للفضل بن موسى السنانى أتيت 
ms1708	 عبد الله بن المبارك قال لا بل أتاني روى عنه أحمد بن سيار مات وهو بن مائة وعشر سنين(@)(@@)(@@)(@@) $ 15837 - ميمون بن إبراهيم شيخ يروي عن ليث بن أبي سليم روى عنه أهل العراق حدثنا سليمان بن الحسن العطار بالبصرة ثنا أبو كامل الجحدري ثنا ميمون بن إبراهيم ثنا ليث عن مجاهد قال معلم الصبيان إذ لم يعدل بينهم جاء يوم القيامة مع الظلمة(@)(@@)(@@)(@@) $ 15838 - ميمون بن سوار العبدي من أهل البصرة يروى عن هراوى أبي قزعة روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 15839 - ميمون بن زيد يروي عن الحسن بن ذكوان عداده في أهل البصرة روى عنه عمرو بن علي وأهل البصرة يخطىء(@)(@@)(@@)(@@) $ 15840 - ميمون بن موسى بن عبد الرحمن بن صفوان بن قدامة المري PageV09P173 يروي عن أبيه عن عبد الرحمن بن صفوان عن أبيه أنه أتى النبي صلى الله عليه وسلم فبايعه روى عنه ابنه أبو علقمة موسى بن ميمون(@)(@@)(@@)(@@) $ 15841 - ميمون بن يحيى بن مسلم بن الأشج من أهل مصر يروي عن الليث ومخرمة بن بكير روى عنه يحيى بن بكير وأحمد بن سعيد الهمداني وقد قيل ميمون بن يحيى بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 15842 - ميمون بن الأصبغ بن الفرات من أهل نصيبين يروي عن يزيد بن هارون حدثنا عنه عمر بن عبد العزيز بنصيبين وغيره من أهلها مات سنة ست وخمسين ومائتين(@)(@@)(@@)(@@) $ 15843 - مسور بن زيد يروي عن عمر بن عبد العزيز روى عنه بن عون الحرف بعد الحرف(@)(@@)(@@)(@@) $ 15844 - مسور بن عبد الملك بن عبيد الله المخزومي من أهل المدينة يروي عن أبيه روى عنه بن وهب(@)(@@)(@@)(@@) $ 15845 - مصعب بن الأشج يروي عن ربيح بن عبد الرحمن روى عنه موسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 15846 - مصعب بن خارجة بن مصعب من أهل سرخس يروي عن حماد بن زيد وأبيه روى عنه أهل بلده مات سنة إحدى أو اثنتين ومائتين وكان على قضاء سرخس PageV09P174(@)(@@)(@@)(@@) $ 15847 - مصعب بن ماهان يروي عن سفيان الثوري روى عنه أحمد بن عيسى 
ms1709	 الخشاب التنيسي(@)(@@)(@@)(@@) $ 15848 - مصعب بن المقدام الخثعمي أبو عبد الله الكوفي يروي عن الثوري وزائدة وداود الطائي روى عنه محمد بن رافع وأهل العراق مات سنة ثلاث ومائتين(@)(@@)(@@)(@@) $ 15849 - مصعب بن عبد الله بن مصعب بن ثابت بن عبد الله بن الزبير بن العوام القرشي من أهل المدينة يروي عن مالك حدثنا عنه أبو يعلى وغيره من شيوخنا وكان من علماء الناس بالأنساب وأيام الناس وما كان فيهم من الحوادث مات سنة ست وثلاثين ومائتين كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 15850 - مصعب بن سعيد أبو خيثمة المصيصي يروي عن موسى بن أعين وعبيد الله بن عمر ربما أخطأ يعتبر حديثه إذا روى عن الثقات وبين السماع في خبره لأنه كان مدلسا وقد كف في آخر عمره(@)(@@)(@@)(@@) $ 15851 - مصعب بن عبد الله بن مصعب الواسطي الفزاري يروى عن PageV09P175 أبي عاصم ويزيد بن هارون كنيته أبو شيخ روى عن يزيد بن هارون حدثنا سليم بن حيان ثنا سعيد بن ميناء قال سمعت جابر بن عبد الله يقول نهي رسول الله صلى الله عليه وسلم عن المزابنة والمحاقلة والمخابرة حدثناه سلم بن معاذ بدمشق ثنا مصعب بن عبد الله الفزاري ثنا يزيد بن هارون(@)(@@)(@@)(@@) $ 15852 - المنذر بن سلهب كوفي يروي عن عبد الرحمن بن مسعود الهذلى عن بن الحنفية روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 15853 - المنذر بن النعمان يروي عن إبراهيم الأفطس روى عنه عبد الرزاق(@)(@@)(@@)(@@) $ 15854 - المنذر بن عبد الله الحزامي من أهل المدينة والد إبراهيم بن المنذر يروي عن داود بن قيس روى عنه أبو غسان محمد بن يحيى الكناني(@)(@@)(@@)(@@) $ 15855 - المنذر بن عمار بن حبيب بن حسان بن أبي الأشرس أبو الخطاب الكوفي يروي عن شبيب بن شيبة عن الحسن روى عنه صالح بن محمد البغدادي(@)(@@)(@@)(@@) $ 15856 - المنذر بن الوليد الجارودي من أهل البصرة يروي عن أبي عاصم والبصريين حدثنا عنه محمد بن حصن الأوسي بطرسوس وغيره من شيوخنا(@)(@@)(@@)(@@) $ 15857 - معاذ بن هشام بن أبي عبد الله الدستوائي من أهل البصرة 
ms1710	 يروي عن أبيه روى عنه إسحاق بن إبراهيم الحنظلي وأهل العراق PageV09P176 وكان من المتقنين سكن في آخر عمره ناحية من اليمن وبها مات سنة مائتين في شهر ربيع الآخر(@)(@@)(@@)(@@) $ 15858 - معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري من أهل المدينة يروي عن أبيه روى عنه بن الطباع(@)(@@)(@@)(@@) $ 15859 - معاذ بن حبان يروي عن أبيه روى عنه خليفة بن خياط(@)(@@)(@@)(@@) $ 15860 - معاذ بن خالد بن شفيق بن دينار أبو بكر العبدي مولى عبد القيس من أهل مرو يروي عن حماد بن سلمة وابن المبارك روى عنه بن قهزاد مات قبل المائتين(@)(@@)(@@)(@@) $ 15861 - معاذ بن فضالة أبو زيد الزهراني مولى قريش من أهل البصرة يروي عن الثوري وهشام الدستوائي روى عنه عبيد الله بن جرير بن جبلة وأهل العراق(@)(@@)(@@)(@@) $ 15862 - معاذ بن فضالة أبو زيد من أهل مصر يروي عن يحيى بن أيوب روى عنه إبراهيم بن مرزوق وأهل مصر ومن أصحابنا من زعم أنهما واحد(@)(@@)(@@)(@@) $ 15863 - معاذ بن محمد بن حبان بن أخي سليم بن حبان من أهل البصرة يروي عن الأوزاعي روى عنه محمد بن أبي بكر المقدمي(@)(@@)(@@)(@@) $ 15864 - معاذ بن الحكم أبو خالد يروي عن عبد الرحمن بن زياد بن أنعم روى عنه يزيد بن سنان البصري الذي سكن مصر PageV09P177(@)(@@)(@@)(@@) $ 15865 - معاذ بن هانئ القيسي أبو هانئ القناد من أهل مصر يروي عن حرب بن شداد وإبراهيم بن طهمان روى عنه خليفة بن خياط سكن البصرة(@)(@@)(@@)(@@) $ 15866 - معاذ بن أسد أبو عبد الله المروزي سكن البصرة يروي عن بن المبارك والفضل بن موسى روى عنه العراقيون مات سنة بضع وعشرين ومائتين(@)(@@)(@@)(@@) $ 15867 - معاذ بن مسافر مولى المهري من أهل حلب يروي عن إسماعيل بن عياش روى عنه يزيد بن أحمد بن يزيد الدمشقي أبو عمرو كان ثقة(@)(@@)(@@)(@@) $ 15868 - معاذ بن عوذالله البصري كنيته أبو عبد الرحمن من أهل البصرة يروي عن عوف الأعرابي روى عنه يعقوب بن سفيان الفارسي مستقيم الحديث(@)(@@)(@@)(@@) $ 15869 - معاذ بن شعبة من 
ms1711	 أهل البصرة يروي عن أبي عاصم وأبى داود حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 15870 - مروان بن جناح من أهل الشام يروي عن أبيه وأهل بلده روى عنه الوليد بن مسلم PageV09P178(@)(@@)(@@)(@@) $ 15871 - مروان بن شجاع أبو عمر الحراني مولى مروان بن محمد الأموي يروي عنه أبو عبيد وأحمد بن حنبل مات سنة أربع وثمانين ومائة ببغداد وكان يؤدب ولد المهدى بها(@)(@@)(@@)(@@) $ 15872 - مروان بن محمد الطاطري من أهل دمشق يروي عن مالك وسليمان بن بلال روى عنه ابنه إبراهيم بن مروان بن محمد وأهل الشام مات سنة عشر ومائتين وكان مولده سنة سبع وأربعين ومائة(@)(@@)(@@)(@@) $ 15873 - مروان بن محمد السنجاري شيخ من أهل الجزيرة يروي عن مسلم بن خالد الزنجي مستقيم الحديث روى عنه أهل الجزيرة حدثنا أحمد بن عيسى بن السكين بواسط ثنا محمد بن عيسى الدارمي بنصيبين ثنا مروان بن محمد السنجاري ثنا مسلم بن خالد الزنجي عن بن أبي نجيح عن مجاهد عن بن عمر قال كنت يوم الفتح مع النبي صلى الله عليه وسلم وأنا بن عشرين سنة(@)(@@)(@@)(@@) $ 15874 - مهاجر بن يزيد مولى بن أبي ذئب يروي عن عمر بن عبد العزيز روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 15875 - مهاجر بن عبيد الله العتكي يروي عن خالد بن ميمون روى عنه عبد العزيز بن أبي رزمة وأهل مرو(@)(@@)(@@)(@@) $ 15876 - مهاجر بن شماس العامري يروي عن عمه روى عنه بن الفضيل PageV09P179(@)(@@)(@@)(@@) $ 15877 - مهاجر شيخ يروي عن عمر بن عبد العزيز روى عنه معاوية بن صالح إن لم يكن بن يزيد فلا أدرى من هو(@)(@@)(@@)(@@) $ 15878 - مسلمة بن علقمة أبو محمد المازني من أهل البصرة يروي عن داود بن أبي هند روى عنه قيس بن حفص الدارمي وأهل البصرة(@)(@@)(@@)(@@) $ 15879 - مسلمة بن جعفر البجلي الأحمسي من أهل الكوفة يروي عن عمرو بن قيس والركين بن الربيع روى عنه عمرو بن محمد العنقزي وأبو غسان النهدي(@)(@@)(@@)(@@) $ 15880 - مسلمة بن نافع يروي عن ذؤيب بن نافع عن الزهري روى عنه بقية بن 
ms1712	 الوليد وقد روى أيضا عن عبد الله بن شهاب بن أخي الزهري عن أنس قصة الرجم(@)(@@)(@@)(@@) $ 15881 - مسلمة بن محمد الثقفي من أهل البصرة يروي عن داود بن أبي هند ونعيم العنبري روى عنه مسدد بن مسرهد(@)(@@)(@@)(@@) $ 15882 - مسلمة بن الصلت الشيباني يروي عن النضر بن معبد وعمارة بن أبي حفصة روى عنه أحمد بن حنبل رحمه الله(@)(@@)(@@)(@@) $ 15883 - مسلمة بن محمد بن الريان الثقفي أبو الريان من أهل الرملة يروي عن القاسم بن غصن عن سليمان التيمي حدثنا عنه بن قتيبة نسخة حسنة مستقيمة(@)(@@)(@@)(@@) $ 15884 - معن بن يزيد يروي عن الأسود بن سعيد روى عنه وكيع بن الجراح PageV09P180(@)(@@)(@@)(@@) $ 15885 - معن بن عيسى بن دينار القزاز أبو يحيى مولى أشجع من أهل المدينة يروي عن بن أبي ذئب ومالك روى عنه إبراهيم بن المنذر وأهل المدينة مات سنة ثمان وتسعين ومائة وكان هو الذي يتولى القراءة على مالك رحمه الله(@)(@@)(@@)(@@) $ 15886 - معن بن الوليد بن هشام الدمشقي يروي عن بقية وابن عياش روى عنه أبو زرعة الدمشقي عن عبد الرحمن بن عمرو من ثقات أصحاب الوليد بن مسلم مات قبل سنة عشرين ومائتين(@)(@@)(@@)(@@) $ 15887 - معلى بن حاجب بن أوس الكلابي من أهل جديلة يروي المقاطيع روى عنه يحيى بن راشد وجديلة موضع في طريق مكة على طريق البصرة(@)(@@)(@@)(@@) $ 15888 - معلى بن الأعلم الضبي يروي عن يونس بن عبيد روى عنه المعلى بن راشد(@)(@@)(@@)(@@) $ 15889 - معلى بن عبد الكريم الايامى بن أخي العلاء بن عبد الكريم يروي عن عبيد الله بن عمر روى عنه أهل العراق(@)(@@)(@@)(@@) $ 15890 - معلى بن عبد الله بن مالك يروي عن أبيه عن أمه عن أبيها عبد الله بن أنيس روى عنه عبد الله بن عبد الرحمن بن مالك(@)(@@)(@@)(@@) $ 15891 - معلى بن الفضل شيخ يروي عن هشام بن زياد PageV09P181 أبي المقدام عن محمد بن كعب روى عنه محمد بن يونس الكديمي يعتبر حديثه من غير رواية الكديمي عنه(@)(@@)(@@)(@@) $ 15892 - معلى بن خالد الأصبهاني يروي عن سفيان الثوري 
ms1713	 روى عنه عبد الرحمن بن مهدى(@)(@@)(@@)(@@) $ 15893 - معلى بن أسد العمى أخو بهز بن أسد من أهل البصرة كنيته أبو الهيثم يروي عن وهيب وسلام بن أبي مطيع روى عنه حجاج بن الشاعر وأهل بلده مات بالبصرة في شهر رمضان سنة ثماني عشرة ومائتين وكان معلما(@)(@@)(@@)(@@) $ 15894 - معلى بن الوليد القعقاعي من أهل قنسرين سكن مصر يروي عن موسى بن أعين ويزيد بن سعيد بن ذي عصران روى عنه أهل مصر ربما أغرب(@)(@@)(@@)(@@) $ 15895 - معلى بن منصور الرازي كنيته أبو يعلى سكن بغداد يروي عن هشيم وحماد بن زيد وكان من أصحاب أبي يوسف مات ببغداد في شهر ربيع الأول سنة إحدى عشرة ومائتين وكان ممن جمع وصنف(@)(@@)(@@)(@@) $ 15896 - معلى بن مهدى بن رستم الموصلي أبو يعلى يروي عن حماد بن PageV09P182 زيد وجعفر بن سليمان الضبعي حدثنا عنه إبراهيم بن عبد العزيز العمرى بالموصل وغيره(@)(@@)(@@)(@@) $ 15897 - معلى بن سلام بن الخباز أبو عبد الله القرشي من أهل دمشق يروي عن عبد الملك بن مهران المغازلي حدثنا معروف الخياط قال رأيت واثلة بن الأسقع وهو يشرب الفقاع حدثنا الحسن بن سفيان ثنا معلى بن سلام(@)(@@)(@@)(@@) $ 15898 - مطرف بن عتبة مولى بنى عامر يروي عن أبيه عن شريح روى عنه ابنه داود بن مطرف(@)(@@)(@@)(@@) $ 15899 - مطرف بن عبد الله الأصم الحارثي من ولد سليمان بن يسار من أهل المدينة كنيته أبو مصعب يروي عن مالك روى عنه محمد بن يحيى الذهلي والناس كان مولده سنة سبع وثلاثين ومائة ومات سنة عشرين ومائتين بالمدينة(@)(@@)(@@)(@@) $ 15900 - مفضل بن مهلهل السعدي من أهل الكوفة أخو الفضل بن مهلهل كنيته أبو عبد الرحمن يروي عن منصور وداود الطائي روى عنه أبو أسامة ويحيى بن آدم مات سنة سبع وستين ومائة وكان من العباد الخشن ممن يفضل على الثوري لست أحفظ له عن تابعي سماعا PageV09P183 فلذلك أدخلناه في هذه الطبقة ولست أنكر أن يكون سمع من أبي خالد والأعمش(@)(@@)(@@)(@@) $ 15901 - مفضل بن فضالة بن عبيد الحميري من 
ms1714	 أهل مصر كنيته أبو معاوية يروي عن عقيل بن خالد وعبد الله بن سليمان الطويل وهو الذي يقال له القتباني وقتبان من اليمن روى عنه يزيد بن موهب الرملي وقتيبة بن سعيد كان مولده سنة سبع ومائة ومات في شوال سنة إحدى أو اثنتين وثمانين ومائة وكان على القضاء بمصر(@)(@@)(@@)(@@) $ 15902 - مفضل بن عبيد الله الكوفي يروي عن أبان بن ثعلب وعمرو بن عامر روى عنه أبو معمر القطيعي حدثنا السراج ثنا أبو معمر ثنا المفضل بن عبيد الله عن عمرو بن عامر عن الحجاج بن الحجاج عن أنس بن سيرين عن أنس بن مالك أن رسول الله صلى الله عليه وسلم كان يصلي على ناقته حيث وجهت(@)(@@)(@@)(@@) $ 15903 - مفضل بن يونس يروي عن الأوزاعي روى عنه الكوفيون وقد كتب عنه أبو أسامة ربما أخطأ(@)(@@)(@@)(@@) $ 15904 - مفضل بن غسان بن المفضل الغلابي من أهل البصرة يروي عن PageV09P184 أبي نعيم ويزيد بن هارون وأبى عاصم حدثنا عنه محمد بن إسحاق الثقفي وكان من أصحاب يحيى بن معين(@)(@@)(@@)(@@) $ 15905 - مخلد بن الضحاك بن مسلم الشيباني من أهل البصرة والد أبي عاصم النبيل يروي عن الزبير بن عبيد عن نافع روى عنه ابنه أبو عاصم وحرمي بن عمارة(@)(@@)(@@)(@@) $ 15906 - مخلد بن عقبة بن عبد الرحمن بن شرحبيل الجعفي من أهل اليمامة يروي عن جده روى عنه البصريون وقد سمع عنه حماد بن زيد(@)(@@)(@@)(@@) $ 15907 - مخلد بن الحسين المصيصي من أهل البصرة تحول إلى المصيصة ومات بها كنيته أبو محمد يروي عن هشام بن حسان روى عنه بن المبارك والناس مات سنة إحدى وتسعين ومائة وكان من العباد الخشن ممن لا يأكل إلا الحلال المحض(@)(@@)(@@)(@@) $ 15908 - مخلد بن قريش شيخ يروي عن شعبة بن الحجاج روى عنه محمد بن المصفى يخطىء PageV09P185(@)(@@)(@@)(@@) $ 15909 - مخلد بن يزيد الحراني أبو الحسن وقد قيل أبو يحيى مولى بنى مروان يروي عن الثوري وابن جريج روى عنه عبد الحميد بن محمد بن مستام الحراني وأهل بلده مات سنة ثلاث 
ms1715	 وتسعين ومائة(@)(@@)(@@)(@@) $ 15910 - مخلد بن مالك بن جابر بن سنان القرشي السلمسيني مولى قريش كنيته أبو محمد من أهل حران وسلمسين قرية على فرسخ منها يروي عن عيسى بن يونس وأبى خالد الأحمر حدثنا عنه الحسين بن محمد بن أبي معشر وغيره مات بحران في جمادى الأولى سنة ثنتين وأربعين ومائتين(@)(@@)(@@)(@@) $ 15911 - مخلد بن أبي زميل يروي عن عبيد الله بن عمرو الرقى حدثنا عنه أحمد بن علي بن المثنى مستقيم الحديث(@)(@@)(@@)(@@) $ 15912 - مخلد بن مالك الجمال كنيته أبو جعفر من أهل الري سكن نيسابور يروي عن يحيى القطان ومعاذ بن معاذ ويزيد بن هارون الواسطي حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 15913 - مخلد بن عمرو البلخي شيخ يروي عن الفضيل بن عياض وأهل العراق حدثنا عنه زكريا بن مسلم الفرخاجردي بالرقة لم أر في PageV09P186 حديثه ما يوجب أن يعدل به عن الثقات إلى المجروحين وأنى قبلت روايته(@)(@@)(@@)(@@) $ 15914 - مخلد بن خداش شيخ يروي عن مالك بن أنس حدثني حاجب بن أركين ثنا أحمد بن إبراهيم الدورقي ثنا عبد الرحمن بن مهدي عن مخلد بن خداش قال سأل رجل مالك بن أنس عن اللعب بالشطرنج فقال له مالك أمن الحق هو قال لا قال فما بعد الحق إلا الضلال(@)(@@)(@@)(@@) $ 15915 - مؤمل بن إسماعيل أبو عبد الرحمن مولى آل عمر بن الخطاب رضي الله عنه أصله من البصرة سكن مكة يروي عن الثوري وحماد بن سلمة روى عنه أحمد بن حنبل والناس مات يوم الأحد لسبع عشرة ليلة خلت من رمضان سنة ست ومائتين ربما أخطأ(@)(@@)(@@)(@@) $ 15916 - مؤمل بن يزيد الثقفي يروي عن سهل مولى المغيرة والكوفيين روى عنه أبو كريب(@)(@@)(@@)(@@) $ 15917 - مؤمل بن عبد الرحمن الثقفي يروي عن الزهري روى عنه يونس بن عبد الرحيم الرملي ربما أخطأ(@)(@@)(@@)(@@) $ 15918 - مؤمل بن خارجة بن مصعب من أهل سرخس يروي عن شعبة روى عنه المغيث بن يزيد مستقيم الحديث ممن يغرب PageV09P187(@)(@@)(@@)(@@) $ 15919 - مؤمل بن الفضل بن مجاهد بن عمير المخزومي مولى خالد بن 
ms1716	 الوليد هو حراني كنيته أبو سعيد يروي عن عبيد الله بن عمر وموسى بن أعين روى عنه محمد بن يحيى الذهلي وأهل بلده مات سنة تسع وعشرين ومائتين(@)(@@)(@@)(@@) $ 15920 - مؤمل بن هشام اليشكري أبو هشام من أهل البصرة يروي عن إسماعيل بن علية والبصريين روى عنه بن خزيمة وغيره مات سنة خمسين ومائتين أو قبلها أو بعدها بقليل(@)(@@)(@@)(@@) $ 15921 - مؤمل بن إهاب بن قفل بن سدك المكي أبو عبد الرحمن يروي عن يزيد بن هارون حدثنا عنه بن جوصاء وغيره من شيوخنا مات سنة ستين ومائتين أو قبلها أو بعدها بقليل(@)(@@)(@@)(@@) $ 15922 - مزاحم بن العوام بن مزاحم القيسي يروي عن الأوزاعي روى عنه عمرو بن عاصم وإبراهيم بن الحجاج(@)(@@)(@@)(@@) $ 15923 - مجاهد بن راشد النهدي أخو مخول بن راشد وهو الذي يقال له مجاهد بن أبي المجالد من أهل الكوفة يروي عن أبيه روى عنه إسرائيل والكوفيون PageV09P188(@)(@@)(@@)(@@) $ 15924 - مجاهد بن موسى أبو على المخرمي من أهل بغداد يروي عن يزيد بن هارون والعراقيين حدثنا عنه محمد بن الحسين بن مكرم البزاز بالبصرة وغيره من شيوخنا مات يوم الجمعة لتسع بقين من رمضان سنة أربع وأربعين ومائتين وكان عسر الحفظ وهو الذي يقال له مجاهد بن موسى الختلي كان أصله من ختل خراسان(@)(@@)(@@)(@@) $ 15925 - مطر بن عبد الرحمن الأعنق أبو عبد الرحمن من أهل البصرة يروي المقاطيع روى عنه التبوذكي(@)(@@)(@@)(@@) $ 15926 - مطر بن الفضل شيخ يروي عن وكيع روى عنه أحمد بن حمويه الأندراني مستقيم الحديث(@)(@@)(@@)(@@) $ 15927 - مطر بن العلاء الفزاري من أهل الشام يروي المقاطيع روى عنه سليمان بن عبد الرحمن الدمشقي(@)(@@)(@@)(@@) $ 15928 - مطر بن محمد بن الضحاك السكري من أهل واسط يروي عن يزيد بن هارون حدثنا عنه بن خزيمة يخطىء ويخالف(@)(@@)(@@)(@@) $ 15929 - مرزوق بن نافع يروي عن صالح بن جبير عداده في أهل الشام روى عنه ضمرة بن ربيعة PageV09P189(@)(@@)(@@)(@@) $ 15930 - مرزوق بن ميمون الناجي كنيته أبو بكر من أهل البصرة يروي عن حميد بن أبي حميد الخياط عن الحسن 
ms1717	 ويروي عن بن عجلان روى عنه البصريون(@)(@@)(@@)(@@) $ 15931 - مبارك بن سعيد اليمامي من أهل اليمن يروي عن يحيى بن أبي كثير روى عنه أهل اليمامة المقاطيع(@)(@@)(@@)(@@) $ 15932 - مبارك بن سعيد بن مسروق الثوري أبو عبد الرحمن الأعمى من أهل الكوفة أخو سفيان يروي عن أبيه وأخيه روى عنه الحسن بن عرفة والعراقيون ربما أخطأ(@)(@@)(@@)(@@) $ 15933 - مبارك العيشي والد عبد الرحمن بن المبارك من أهل البصرة يروي عن الحكم بن فروخ روى عنه علي بن المديني(@)(@@)(@@)(@@) $ 15934 - مسعود بن سعد أبو سعيد الجعفي يروى عن بن إسحاق وعطاء بن السائب والكوفيين روى عنه أبو غسان النهدي وأهل الكوفة وقد قيل إنه سمع أبا إسحاق السبيعي فإن صح ذلك فهو من أتباع التابعين(@)(@@)(@@)(@@) $ 15935 - مسعود بن واصل أبو مسلم صاحب السامري من أهل البصرة يروي عن النهاس بن فهم عن قتادة روى عنه عمر بن شيبة ربما أغرب PageV09P190(@)(@@)(@@)(@@) $ 15936 - مسعود بن جويرية من أهل البصرة يروي عن يزيد بن هارون وعبد الله بن خداش بن حوشب مستقيم الحديث حدثنا عنه أبو يعلى وغيره من شيوخنا(@)(@@)(@@)(@@) $ 15937 - مسعود بن يوسف أبو عبد الله الكوسج من أهل جوزجان يروي عن الفضيل بن عياض روى عنه أحمد بن سيار(@)(@@)(@@)(@@) $ 15938 - مسعود بن مسروق من أهل المبارك يروي عن إسماعيل بن جعفر روى عنه أهل بلده لم أر في حديثه إلا ما يشبه حديث الثقات وقد روى عن مسعود هذا أبو خالد يزيد بن محمد بن حماد العقيلي الذي كان يقيم بمكة وكان أصله من أصبهان(@)(@@)(@@)(@@) $ 15939 - محرز بن يزيد يروي عن سليمان بن موسى روى عنه القاسم بن مالك المزني(@)(@@)(@@)(@@) $ 15940 - محرز بن الوضاح من أهل مرو يروي عن عبيد الله بن عمرو روى عنه يحيى بن أكثم وأهل مرو(@)(@@)(@@)(@@) $ 15941 - محرز بن هشام المرادي كوفي يروي عن عبد الملك بن مروان بن عنترة عن أبيه عن جده عن أبي بكر عن النبي صلى الله عليه وسلم في الدعاء في حفظ القرآن روى عنه عثمان 
ms1718	 بن سعيد الدارمي(@)(@@)(@@)(@@) $ 15942 - محرز بن عون بن أبي عون أبو الفضل من أهل بغداد يروى PageV09P191 عن مالك وخلف بن خليفة والعراقيين روى عنه أهل العراق حدثنا عنه أحمد بن علي بن المثنى مات سنة إحدى وثلاثين ومائتين(@)(@@)(@@)(@@) $ 15943 - محرز بن سلمة العبدي البغدادي أصله من مكة يروي عن مالك بن أنس والدراوردي حدثنا عنه أبو يعلى وغيره من شيوخنا(@)(@@)(@@)(@@) $ 15944 - معمر بن سليمان الرقى أبو عبد الله النخعي مولى لهم يروي عن خصيف والحجاج بن أرطاة روى عنه أحمد بن حنبل وعلي بن حجر مات في شعبان سنة إحدى وتسعين ومائة وكان أبيض الرأس واللحية(@)(@@)(@@)(@@) $ 15945 - معمر بن يعمر الليثي يروي عن معاوية بن سلام روى عنه محمد بن يحيى الذهلي كنيته أبو عامر من أهل دمشق يغرب ومعاوية بن سلام سمع نافعا(@)(@@)(@@)(@@) $ 15946 - معمر بن محمد بن معمر أبو شهاب البلخي بن أخي شهاب بن معمر يروي عن مكي بن إبراهيم وهو آخر من روى عن مكي روى عنه أهل بلده(@)(@@)(@@)(@@) $ 15947 - معمر بن المبارك أبو عامر الراسبي يروي عن عتبة الغلام روى عنه محمد بن نعيم بن معاوية الموصلي الحكايات في فضائل عتبة PageV09P192(@)(@@)(@@)(@@) $ 15948 - مبشر بن عبد الله بن رزين السلمي من أهل نيسابور كنيته أبو بكر يروي عن سفيان بن حسين روى عنه حسين بن منصور النيسابوري وأهل بلده مات سنة ثمان أو تسع وثمانين ومائة(@)(@@)(@@)(@@) $ 15949 - مبشر بن إسماعيل الحلبي أبو إسماعيل الكلبي يروي عن الأوزاعي روى عنه علي بن حجر والناس(@)(@@)(@@)(@@) $ 15950 - مبشر بن الحسن بن مبشر بن مكيس أبو بشر يروي عن أبي عاصم والبصريين مستقيم الحديث حدثنا علي بن الحسين بن سليمان المعدل بالفسطاط ثنا مبشر بن الحسين(@)(@@)(@@)(@@) $ 15951 - المطلب بن كثير يروي عن الزبير بن موسى روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 15952 - المثنى بن بكر أبو جابر العبدي يروي عن أشعث بن سليم وداود بن أبي هند روى عنه علي بن أبي هاشم(@)(@@)(@@)(@@) $ 15953 - المثنى بن موسى بن مسلمة الهذلي 
ms1719	 يروي عن أبيه روى عنه محمد بن عباد الهنائي(@)(@@)(@@)(@@) $ 15954 - المثنى بن يحيى بن عيسى التميمي جد أبي يعلى الموصلي يروي عن أبي شهاب عن الأعمش روى عنه محمد بن غالب تمتام(@)(@@)(@@)(@@) $ 15955 - المثنى بن حرب بن الضحاك الأسدي أبو محمد من أهل الثغر PageV09P193 يروي عن وكيع وزياد البكائي حدثنا عنه إبراهيم بن أبي أمية الطرسوسي وأهل الثغر(@)(@@)(@@)(@@) $ 15956 - المثنى بن معاذ بن معاذ العنبري يروي عن أبيه روى عنه أصحابنا(@)(@@)(@@)(@@) $ 15957 - مسكين بن بكير أبو عبد الرحمن الحذاء من أهل حران يروي عن شعبة وجعفر بن برقان روى عنه النفيلي والحرانيون مات سنة ثمان وتسعين ومائة ونصر بن شبيب محاصر لأهل حران يومئذ(@)(@@)(@@)(@@) $ 15958 - مسكين بن عبد الرحمن التجيبي من أهل مصر يروي عن يحيى أبن أيوب حدثنا بن خزيمة ثنا يحيى بن زكريا بن يحيى بن أبان ثنا مسكين بن عبد الرحمن ثنا يحيى بن أيوب عن حميد الطويل عن أنس بن مالك قال كان رسول الله صلى الله عليه وسلم إذا كان صائما لم يصل حتى يأتيه برطب وماء فيأكل ويشرب إذا كان الرطب وإذا كان النساء لم يصل حتى يأتيه بتمر وماء(@)(@@)(@@)(@@) $ 15959 - مختار بن عون بن أبي عون يروي عن أبي جعفر بن سليمان الضبعي روى عنه أخوه محرز بن عون بن أبي عون(@)(@@)(@@)(@@) $ 15960 - معبد بن راشد أبو عبد الرحمن الكوفي سكن بغداد يروي عن معاوية بن عمار ووكيع روى عنه الحسن بن الصباح البزار(@)(@@)(@@)(@@) $ 15961 - مليح بن الجراح بن مليح بن فرس الرواسي من قيس عيلان PageV09P194 يروي عن الثوري روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 15962 - مليح بن وكيع بن الجراح يروي عن أبيه والكوفيين وهو أخو سفيان بن وكيع روى عنه الحضرمي وأحمد بن يحيى الصوفي مستقيم الحديث(@)(@@)(@@)(@@) $ 15963 - محرر بن قعنب الباهلي من أهل البصرة يروي عن شعبة روى عنه بدل بن المحبر والبصريون ربما أخطأ(@)(@@)(@@)(@@) $ 15964 - مشمعل بن ملحان الطائي يروي عن مطرح بن يزيد وأهل البصرة روى عنه إسحاق بن 
ms1720	 أبي إسرائيل ربما أخطأ(@)(@@)(@@)(@@) $ 15965 - مغلس بن زياد أبو الوليد العامري من أهل الكوفة يروي عن عامر بن عبيدة روى عنه محمد بن سلام البيكندي وإسحاق بن إبراهيم الحنظلي(@)(@@)(@@)(@@) $ 15966 - الماضي بن محمد أبو مسعود المصري الغافقي يروي عن ليث بن أبي سليم وهشام بن حسان روى عنه بن وهب يعتبر حديثه إذا روى عن غير ليث(@)(@@)(@@)(@@) $ 15967 - ملازم بن عمرو بن عبد الله بن بدر الحنفي من أهل اليمامة سكن البصرة يروي عن جده عبد الله بن بدر روى عنه مسدد بن مسرهد وأهل البصرة PageV09P195(@)(@@)(@@)(@@) $ 15968 - محشر بن معاوية الباهلي من أهل البصرة يروي عن مطر الوراق روى عنه أهل بلده مستقيم الحديث(@)(@@)(@@)(@@) $ 15969 - معمر بن الحسن الهذلي يروي عن الثوري روى عنه مالك بن سليمان الهروي ربما أخطأ وهو جد أبي معمر القطيعي(@)(@@)(@@)(@@) $ 15970 - معمر بن بكار السعدي يروي عن إبراهيم بن سعد روى عنه نجيح بن إبراهيم الجماني(@)(@@)(@@)(@@) $ 15971 - معمر بن سهل بن معمر الأهوازي شيخ متقن يغرب يروي عن عبيد الله بن موسى ويزيد بن هارون وأهل العراق حدثنا عنه عبدان وأهل الأهواز سمعت محمد بن يعقوب بالأهواز يقول سمعت معمر بن سهل يقول سمعت جعفر بن عون يقول سمع مسعر بن كدام يقول يسر الفتى ما كان قدم من تقى إذا عرف الداء الذي هو قاتله(@)(@@)(@@)(@@) $ 15972 - معمر بن إبراهيم بن الربيع يروي عن أبي عاصم والبصريين حدثنا عنه محمد بن يعقوب الأهوازي(@)(@@)(@@)(@@) $ 15973 - معمر بن المثنى التيمي من أهل البصرة كنيته أبو عبيدة روى عن البصريين مات سنة عشرة ومائتين وقد قارب المائة كان الغالب عليه معرفة الأدب والشعر(@)(@@)(@@)(@@) $ 15974 - مستلم بن سعيد الثقفي مولاهم من أهل واسط يروي عن منصور بن زاذان روى عنه يزيد بن هارون وأهل العراق ربما خالف PageV09P196(@)(@@)(@@)(@@) $ 15975 - مقدام أبو فروة يروي عن جار له عن شريح روى عنه جرير بن حازم(@)(@@)(@@)(@@) $ 15976 - مخارق بن عبد الرحمن السلمي كان ينزل الدثينة يروي عن عمه روى عنه التبوذكي(@)(@@)(@@)(@@) $ 15977 - منقذ 