ms361	 بابني بعده % % لذاكره ما حنت النيب في نجد % 19(@)(@@) % وأولادنا مثل الجوارح أيها % % فقدناه كان الفاجع البين الفقد % 20(@)(@@) % لكل مكان لا يسد اختلاله % مكان أخيه في جزوع ولا جلد % PageV01P1317 21(@)(@@) % هل العين بعد السمع تكفي مكانه % أم السمع بعد العين يهدي كما تهدي % % 22(@)(@@) % لعمريلقد حالت بي الحال بعده % فيا ليت شعري كيف حالت به بعدي % % 23(@)(@@) % ثكلت سروري كله إذ ثكلته % وأصبحت في لذات عيشي أخا زهد % 24(@)(@@) % أريحانة العينين والأنف والحشا % % ألا ليت شعري هل تغيرت عن عهدي % % 25(@)(@@) % سأسقيك ماء العين ما أسعدت به % % وإن كانت السقيا من الدمع لا تجدي % % 26(@)(@@) % أعينيجودا لي فقد جدت للثرى % % بأنفس مما تسألان من الرفد % 27(@)(@@) % أعينيإن لا تسعداني ألمكما % % وإن تسعداني اليوم تستوجبا حمدي % % 28(@)(@@) % عذرتكما لو تشغلان عن البكا % % بنوم وما نوم الشجي أخي الجهد % 29(@)(@@) % أقرة عينيقد أطلت بكاءها % % وغادرتها أقذى من الأعين الرمد % 30(@)(@@) % أقرة عينيلو فدى الحي ميتا % فديتك بالحوباء أول من يفدي % % PageV01P1318 31(@)(@@) % كأني ما استمتعت منك بنظرة % % ولا قبلة أحلى مذاقا من الشهد % 32(@)(@@) % كأني ما استمتعت منك بضمة % ولا شمة في ملعب لك أو مهد % 33(@)(@@) % ألام لما أبدي عليك من الأسى % % وإني لأخفي منه أضعاف ما أبدي % % 34(@)(@@) % محمدما شيء توهم سلوة % لقلبي إلا زاد قلبي من الوجد % 35(@)(@@) % أرى أخويك الباقيين فإنما % % يكونان للأحزان أورى من الزند % 36(@)(@@) % إذا لعبا في ملعب لك لذعا % % فؤادي بمثل النار عن غير ما قصد % 37(@)(@@) % فما فيهما لي سلوة بل حزازة % يهيجانها دوني وأشقى بها وحدي % % 38(@)(@@) % وأنت وإن أفردت في دار وحشة % فإني بدار الأنس في وحشة الفرد % 39(@)(@@) % أود إذا ما الموت أوفد معشرا % إلى عسكر الأموات أني من الوفد % 40(@)(@@) % ومن كان يستهدي حبيبا هدية % فطيف خيال منك في النوم أستهدي % % PageV01P1319 41(@)(@@) % عليك سلام الله مني تحية % ومن كل غيث صادق البرق والرعد % PageV01P1320 البحر : - 1(@)(@@) % للناس عيد ولي عيدان في العيد % إذا رأيتك يابن السادة الصيد % 2(@)(@@) % إذا هم 
ms362	 عيدوا عيدين في سنة % كانت بوجهك لي أيام تعييد % 3(@)(@@) % قالوااستهل هلال الفطرقلت لهم % % وجه الأمير هلال غير مفقود % 4(@)(@@) % بدا الهلال الذي استقبلت طلعته % % مقابلا بهلال منك مسعود % 5(@)(@@) % أجدد وأخلق كلا العيدين في نعم % تأبى لهن الليالي غير تجديد % 6(@)(@@) % إن قاد صنوك جيش العيد عقبته % فما اختللت لفقد الجيش في العيد % 7(@)(@@) % بل لو توحدت دون الناس كلهم % كنت الجميع وكانوا كالمواحيد % 8(@)(@@) % عليك أبهة التأمير واقعة % لا بالجنود ولا بالضمر القود % 9(@)(@@) % أنت الأمير الذي ولته همته % بغير عهد من السلطان معهود % 10(@)(@@) % ولاية ليس يجبي المال صاحبها % % بل الرغيبين من حمد وتمجيد % PageV01P1321 11(@)(@@) % هل الأمير سوى المعدى بنائله % % على عداء صروف البيض والسود % 12(@)(@@) % وأنت تعدي عليها كلما ظلمت % يا بن الكرام برفد منك مرفود % 13(@)(@@) % فليصنع العزل والتأمير ما صنعا % % فأنت ما عشت والي إمرة الجود % 14(@)(@@) % تلك الإمارة أعلاها مؤمرها % % أن يملك الناس منها حل معقود % 15(@)(@@) % عطية الله لا يبتزها أحد % ليست كشيء معاد ثم مردود % 16(@)(@@) % لو كنت أزمان وأد الناس ما وأدوا % % أحيا سماحك فيهم كل موؤود % 17(@)(@@) % فما يضرك ما دار الزمان به % % وأنت حاليك في سربال محسود % 18(@)(@@) % هذا على أنه لافرق بينكما % % وحق ذلك والعودان من عود % 19(@)(@@) % أضحى أخوك على رغم العدا جبلا % ينوء منك بركن غير مهدود % 20(@)(@@) % تظاهران على تقوى إلهكما % % كلا الظهيرين معضود بمعضود % PageV01P1322 21(@)(@@) % فالشمل مجتمع والشكل مؤتلف % والأزر بالأزر مشدود بمشدود % 22(@)(@@) % والمرتان إذا ما التفتا وفتا % % بمستمر من الأمراس ممسود % 23(@)(@@) % ما زاد كل ظهير أمر صاحبه % بأمره غير تثبيت وتأييد % 24(@)(@@) % كلاولا زاد كل مجد صاحبه % % بمجده غير توطيد وتشييد % 25(@)(@@) % فالعز عزكما والمجد مجدكما % % ومن أبى ذاك موطوء اللغاديد % 26(@)(@@) % كل يرى لأخيه فضل سؤدده % وكنتما أهل تفضيل وتسويد % 27(@)(@@) % مات التحاسد والأضغان بينكما % % فمات كل حسود موت مكمود % 28(@)(@@) % ورد كل تميم كان ينفثه % راقي الوشاة فعضوا بالجلاميد % 29(@)(@@) % لا زال شمل اجتماع شمل أمركما % % وشمل أمر 
ms363	 الأعادي شمل تبديد % 30(@)(@@) % إن قيل سفيان يأبى الغمد جمعهما % % فأنتما منصلا سل وتجريد % PageV01P1323 31(@)(@@) % لا تحوجان إلى غمد يضمكما % % كلاكما الدهر سيف غير مغمود % 32(@)(@@) % مجردان على الأعداء قد رغبا % % عن الجفون إلى هام الصناديد % 33(@)(@@) % مؤلفان لنصر الله قد شغلا % % عن التباغي بطاغوت ومريد % 34(@)(@@) % ما في الحسامين مأمور بصاحبه % % عليكما برقاب العند الحيد % 35(@)(@@) % للسيف عن قطع سيف مثله ذكر % مندوحة في رقاب ذات بأويد % 36(@)(@@) % فليعن بالمثل المضروب غيركما % % فليس معناكما فيه بموجود % 37(@)(@@) % لا تعجبا من خصامي عنكما مثلا % قد سار ما سار في العمران والبيد % 38(@)(@@) % فكم خصمت بحكم الحق من مثل % قد أبدته الليالي أي تأبيد % 39(@)(@@) % هذا لذاك وهذا بعده قسم % بمشهد من جلال الله مشهود % 40(@)(@@) % ما اليوم يمضي وعيني غير فائزة % بحظها منك في عمري بمعدود % PageV01P1324 41(@)(@@) % لكن تطاولت الشكوى بقائدتي % % فكنت شهرا وحالي حالمصفود % 42(@)(@@) % شغلت عنك بعوار أكابده % لا بالملاهي ولا ماء العناقيد % 43(@)(@@) % ولو قعدت بلا عذر لمهد لي % % جميل رأيك عذري أي تمهيد % 44(@)(@@) % قاسيت بعدك لا قاسيت مثلهما % % نهار شكوى يباري ليل تسهيد % 45(@)(@@) % أمسي وأصبح في ظلماء من بصري % % فما نهاري من ليلي بمحدود % 46(@)(@@) % كأنني من كلا يومي وليلته % % في سرمد من ظلام الليل ممدود % 47(@)(@@) % إذا سمعت بذكر الشمس اسفني % % فصعدت زفراتي أي تصعيد % 48(@)(@@) % وليس فقد ضياء الشمس أجزعني % % بل فقد وجهك أوهى ركن مجلودي % % 49(@)(@@) % لا يطمئن بجنبي لين مضطجع % % وما فراش أخي شكوى بممهود % 50(@)(@@) % أرعى النجوم وأنى لي برعيتها % % وطرف عيني في أسر وتقييد % PageV01P1325 51(@)(@@) % وإن من يتمنى أن يواتيه % رعي النجوم لمجهود المجاهيد % 52(@)(@@) % وضاقت الأرض بي طرا بما رحبت % فصار حظي منها مثل ملحودي % % 53(@)(@@) % فلم تكن راحتي إلا ملاحظتي % % إياك عن فكر قلب جدمجهود % 54(@)(@@) % وكم دعوتك والعزاء تعصبني % % وأنت غاية مدعى كل منجود % 55(@)(@@) % وقد تبدلت من بلواي عافية % بحمد رب على الحالين محمود % 56(@)(@@) % فافتح لعبدك باب العذر إن له % قدما بلطفك بابا 
ms364	 غير مسدود % 57(@)(@@) % يا من إذا الباب أعيا فتح مقفله % ألقى الدهاة إليه بالمقاليد % 58(@)(@@) % بنجم رأيك تجلى كل داجية % يبلد النجم فيها كل تبليد % 59(@)(@@) % فإن تماريت في عذري وصحته % % فاجعله غفران ذنب غير مجحود % 60(@)(@@) % وما تعاقب إن عاقبت من رجل % بسوطه دون سوط النقم مجلود % % PageV01P1326 61(@)(@@) % حبي بجرمي إلى نفسي معاقبة % إن كنت أطردت نفسي غير مطرود % 62(@)(@@) % فإن عفوتفما تنفك مرتهنا % شكرا بتقليد نعمى بعد تقليد % 63(@)(@@) % تطوق المن يوهي الطود محمله % وإنه لخفيف الطوق في الجيد % 64(@)(@@) % تمن ثم تفك المن مجتهدا % عن الرقاب فيأبى غير توكيد % 65(@)(@@) % وإن سطوت فكم قومت ذا أود % تقويم لدن من الخطي أملود % 66(@)(@@) % يابن الأكارم خذها مدحة صدرت % عن مورد لك صاف غير مورود % 67(@)(@@) % لا فضل فيه سوى ما أنت مفضله % فشرب غيرك منه شرب تصريد % 68(@)(@@) % مكنون ود توخاك الضمير به % % ولم يزاحمك فيه شرك مودود % 69(@)(@@) % توحيد مديحك دون الناس كلهم % سيان عندي وإخلاصي وتوحيدي % % 70(@)(@@) % وما قصدت سوى حظي ومسعدتي % % ولست في ذاك محفوفا بتفنيد % PageV01P1327 71(@)(@@) % أنت الذي كلما رمت المديح له % % أجابني وضميري غير مكدود % 72(@)(@@) % بحري ببحرك ممدود فحق له % % أن لا يرى الدهر إلا غير مثمود % 73(@)(@@) % أمددت شعري بأمداد مظاهرة % من المناقب لا تحصى بتعديد % 74(@)(@@) % وما رميتك من ودي بخاطئة % مني ولا فلتة عن غير تسديد % PageV01P1328 البحر : - 1(@)(@@) % إن المنية لا تبقي على أحد % ولا تهاب أخا عز ولا حشد % 2(@)(@@) % هذا الأمير أتته وهو في كنف % كالليل من عدد ما شئت أو عدد % 3(@)(@@) % من كل مستعذب للموت ديدنه % بز الكماة ولبس البيض والزرد % 4(@)(@@) % معتادة قنص الأبطال شكته % يرى الطراد غداة الروع كالطرد % 5(@)(@@) % كأنه الليث لا تثني عزيمته % إلا عزيمته أو جرعة النفد % 6(@)(@@) % ولم تزل طوع كفيه يصرفها % % بين الأنام ولا تعصيه في أحد % 7(@)(@@) % حتى أتاه رسول الموت يؤذنه % أن البقاء لوجه الواحد الصمد % % 8(@)(@@) % لله من هالك وافى الحمام به % أخرى الحياةوأخرى المجد 
ms365	 في أمد % 9(@)(@@) % كم مقلة بعده عبرى مؤرقة % كأنما كحلت سما على رمد % 10(@)(@@) % جادت عليه فأغنت أن يقال لها % % ياعين جودي بدمع منك مطرد % PageV01P1329 11(@)(@@) % إن لا يكن ظفر الهيجا منيته % فأكرم النبت يذوي غير محتصد % 12(@)(@@) % أما ترى الغرس لا تذوي كرائمه % ألا على سوقها في سائر الأبد % 13(@)(@@) % لميتة السيف قوم يشرفون بها % % ليسوا من المجد في غاياته البعد % 14(@)(@@) % عز الحياة وعز الموت ما اجتمعا % % أسنى وأبنى لبيت العز ذي العمد % 15(@)(@@) % موت السلامة للإنسان نعلمه % وإنما القتلة الشنعاء للأسد % 16(@)(@@) % لم يعمل السيف ظلما في ضرائبه % % فلم يسلط عليه سيف ذي قود % 17(@)(@@) % لا تبعدن أبا العباس من ملك % وإن نأيت وإن أصبحت في البعد % 18(@)(@@) % غادرت حوض المنايا إذ شربت به % عذب المذاق كذوب الشهد بالبرد % 19(@)(@@) % وإن فضلة كأس أنت مفضلها % % لذات برد على الأحشاء والكبد % 20(@)(@@) % ما مت بل مات أهل الأرض كلهم % إذ بنت منهم وكنت الروح في الجسد % PageV01P1330 21(@)(@@) % فأنت أولى وإن أصبحت في جدث % بأن تعزى بأهل الوعث والجدد % 22(@)(@@) % كم من مصائب كان لدهر أخلقها % % أضحى بك الناس في أثوابها الجدد % % 23(@)(@@) % من بين باك له عين تساعده % % وبين آخر مطوي على كمد % 24(@)(@@) % فعبرة في حدور لا رقوء لها % % وزفرة تملأ الأحشاء في صعد % 25(@)(@@) % سويت في الحزن بين العالمين كما % % سويت بينهم في العيشة الرغد % 26(@)(@@) % بثثت شجوك فيهم إذ فقدت كما % % بثثت رفدك فيهم غير مفتقد % 27(@)(@@) % عدلا حياة وموت منك لو وزنا % % هذا بذاك لم ينقص ولم يزد % 28(@)(@@) % قد كنت أنسيتهم أن يذكروا حزنا % فاليوم ينسون ذكر الصبر والجلد % 29(@)(@@) % نكأت منهم كلوما كان يكلمها % % ريب الزمان فتأسوها بخير يد % 30(@)(@@) % عجبت للأرض لم ترجف جوانبها % % وللجبال الرواسي كيف لم تمد % PageV01P1331 31(@)(@@) % عجبت للشمس لم تكسف لمهلكه % وهو الضياء الذي لولاه لم تقد % 32(@)(@@) % هلا وفت كوفاء البدر فادرعت % ثوب الكسوف فلم تشرق على بلد % 33(@)(@@) % لا ظلم لو شاهدت من حال مصرعه 
ms366	 % % ما شاهد البدر لم تشرق ولم تكد % PageV01P1332 البحر : - 1(@)(@@) % يا بن الوزيرين وابن السادة الصيد % % يا سيدا غير مظلوم بتسويد % 2(@)(@@) % لك الهناء بمولود أقر به % عيني أبي النجم مولى كل تمجيد % 3(@)(@@) % وكان أهلا لما يولاه من حسن % % بدر البدور وصنديد الصناديد % 4(@)(@@) % بدر حباه بنجم من حباه بكم % ياآل وهب بني الغر الأماجيد % 5(@)(@@) % أعديته بركات منك في شعب % % شتى من الأمر حتى في المواليد % 6(@)(@@) % لما توالى لك النجمان في نسق % % وافاه نجم هدى السارين في البيد % 7(@)(@@) % وكان دهرا عن الأذكار منغلقا % فكان فألك من خير المقاليد % 8(@)(@@) % طرقت ببنيك لابن جاءه سرحا % واليمن صاحب تطريق وتمهيد % 9(@)(@@) % كما تطرق بالآراء تقدحها % % برأيه فتلقى كل تسديد % 10(@)(@@) % لقد جمعت وإياه على قدر % والحمد لله أنواع التحاميد % PageV01P1333 11(@)(@@) % أضحى التلاؤم في الخيرات بينكما % % مثل التلاؤم بين الرأس والجيد % 12(@)(@@) % فالجد بالجد مؤتم يماثله % % والرأي بالرأي في نقض وتوكيد % 13(@)(@@) % لا زال شمل اجتماع شمل أمركما % % وشمل أمر الأعادي شمل تبديد % 14(@)(@@) % وكلكم فأدام الله نعمته % إدامة بين إعزاز وتأييد % % 15(@)(@@) % فكلكم يابني وهب ذوو كرم % % مردد في المعالي أي ترديد % 16(@)(@@) % من كان أهلا لإمتاع بدولته % % فأنتم أهل إمتاع وتخليد % 17(@)(@@) % أصلحتم الدين والدنيا بيمنكم % من بعد ماطال إفساد المناكيد % 18(@)(@@) % فالملك في روضة منكم وفي عرس % والدين في جمعة منكم وفي عيد % 19(@)(@@) % لا تحمدوني أن جودت مدحكم % % فإنما قام تشييد بتوطيد % 20(@)(@@) % جودت فيكم كما أجودت أيديكم % ماحمد متبع أجواد بتجويد % PageV01P1334 21(@)(@@) % تحكى المكارم عنكم وهي شاهدة % ليست بغيب ولا تحصى بتعديد % 22(@)(@@) % وما حكاية شيء لا خفاء به % % جاء العيان فألوى بالأسانيد % 23(@)(@@) % بل إنما قلت قولي فيكم مقة % مني لكم قبل شكري للمرافيد % 24(@)(@@) % لا تحسبوني لشيء غير أنفسكم % أغرى بتجديد مدح بعد تجديد % 25(@)(@@) % لكن كما راقت القمري جنته % فظل يتبع ت غريدا بتغريد % 26(@)(@@) % أحبكم لحلاكم لا لأنعمكم % كلا وإن أصبحت غوث المجاهيد % 27(@)(@@) % ولينبسط لي عذري إن سألتكم % فإن ديني 
ms367	 فيكم دين توحيد % 28(@)(@@) % أفسدتموني لا إفساد تنحية % للخير عني بل إفساد تعويد % 29(@)(@@) % وزهدتني أياديكم وفضلكم % في كل شيء سواها كل تزهيد % 30(@)(@@) % تالله أسأل قوما غيركم صفدا % يا أعين الماء في دهر الجلاميد % PageV01P1335 31(@)(@@) % وما اعتفيتكم إلا بتجربة % إذا اعتفى القوم عافيهم بتقليد % PageV01P1336 البحر : - 1(@)(@@) % نسبته كاذبة كاسمه % سمي بالخلد ولن يخلدا % % 2(@)(@@) % كذاك قالواقحطبي ولم % يولد لطائي ولن يولدا % % PageV01P1337 البحر : - 1(@)(@@) % لي أربعون من السني % % ن وأربعون من الولد % % 2(@)(@@) % لا بل علي وليس لي % % ما بان مني فانفرد % % 3(@)(@@) % أوليس ما عدته لي % % أيدي الحساب من العدد % 4(@)(@@) % متخونا متنقصا % مني مزيدا في الأبد % 5(@)(@@) % أو ما أرى ولدي قوى % منيبنقصي تستجد % 6(@)(@@) % جعلت وكانت كلها % % حبلا حبالات بدد % 7(@)(@@) % كم من سرور لي بمو % لود أؤمله لغد % 8(@)(@@) % وبأن يهدني الزما % % ن رأيت منته تشد % % 9(@)(@@) % ومن العجائب أن أسر % بما يشد بأن أهد % 10(@)(@@) % دع ذا فخلفك أربعو % % ن ضحى طويلات المدد % PageV01P1338 11(@)(@@) % تلتج فيها نفحة للصور % % ر تنخب ذا الجلد % 12(@)(@@) % شنعاء في الآذان تق % % لق كل روح في جسد % 13(@)(@@) % يا راكضا في لهوه % % مهلا فقد جزت الأمد % 14(@)(@@) % في الأربعينات الثلا % % ث مواعظ لذوي العقد % 15(@)(@@) % كم أربعين وأربعي % % ن وأربعين تقولقد % 16(@)(@@) % في كلهن مواعظ % تدعو الغوي إلى الرشد % 17(@)(@@) % فقد بتوبة مخلص % للواحد الأحد الصمد % PageV01P1339 البحر : - 1(@)(@@) % قل للأمير أدام الله غبطته % % لا زال عيدك موصولا بأعياد % 2(@)(@@) % عيد تنافست الأيام زينته % % واستشرفته بأبصار وأجياد % 3(@)(@@) % طلعت فيه طلوع البدر وافقه % % طلوع سعد فوافاه لميعاد % 4(@)(@@) % في موكب ظلت الدنيا تشيم به % % مخيلة ذات إبراق وإرعاد % 5(@)(@@) % وقع الكراع ولمع البيض يوقده % لألآء وجهك فيه أي إيقاد % 6(@)(@@) % لله ذلك من عيد لقد وثقت % فيه النفوس بركن غير منآد % 7(@)(@@) % في مثله علم الجهال بعد عمى % أن الخلافة مرساة بأوتاد % 8(@)(@@) % أرهبت فيه عداة الملك فانقلبوا % % منه بأقلق أحشاء وأكباد % 9(@)(@@) % فاسعد به وبأعياد تعمرها % % في ظل عيش وريق 
ms368	 العود مياد % 10(@)(@@) % ياأكرم الناس دون الناس كلهم % وليس ذلك من قيلي بإبعاد % PageV01P1340 11(@)(@@) % نفسي فداؤك بل نفسي وأسرتها % % بل كل نفس وما أغلى بك الفادي % % 12(@)(@@) % من كان يهدي على العمياء مدحته % إهداء مستسلم للظن منقاد % 13(@)(@@) % فما امتدحتك إلا بعد ألسنة % ولا انتجعتك إلا بعد رواد % 15(@)(@@) % إليك ساق تجار الحمد عيرهم % ينفدن أسداد ليل بعد أسداد % 16(@)(@@) % لهم بوجهك هاد من أمامهم % ومن رجائك حاد أيما حادي % % 17(@)(@@) % على سواهم يذرعن الفلا عنقا % بأذرع شدنيات وأعضاد % 18(@)(@@) % تطوي الفلا مثقلات وسع طاقتها % % من الثناء مخفات من الزاد % 19(@)(@@) % معولات على غيث تيممه % ما آب رائده إلا بإحماد % 20(@)(@@) % كلتا يديك يمين لا شمال لها % % مخلوقتان لأمجاد وإنجاد % 21(@)(@@) % يدان لا يفتران الدهر من صفد % يغني فقيرا ولا من فك أصفاد % PageV01P1341 22(@)(@@) % إن دام جودك أنزفنا قرائحنا % % بعد الجحوم وآذنا بإنفاد % 23(@)(@@) % تعطي الجزيل بلا وعد تقدمه % % ولا تعاقب إلا بعد إيعاد % 24(@)(@@) % تبني مكارم مرساة قواعدها % % على مكارم آباء وأجداد % 25(@)(@@) % ياآل طاهر الأعلين مرتبة % لا زلتم رغم أعداء وحساد % 26(@)(@@) % أمسى مجاوركم يأوي إلى جبل % % صعب المراقي ويرعى جانبي وادي % % 27(@)(@@) % من عاث في الأرض إفسادا فإنكم % بدلتم الأرض إصلاحا بإفساد % 28(@)(@@) % أنتم بنو ذي اليمينين الذي هجعت % به السيوف وعادت ذات أغماد % 29(@)(@@) % مسومين بسيما اليمن في غرر % مولودة بنجوم غير أنكاد % 30(@)(@@) % أجلت لنا منكم الأيام عن خلف % حكام فصل وأبطال وأجواد % 31(@)(@@) % من نجم رأي ومن بحر له فجر % على العفاة ومن ضرغامة عادي % % PageV01P1342 32(@)(@@) % فكلما نزلت بالناس نازلة % ألفت لها راصدا منكم بمرصاد % 33(@)(@@) % لكم مقامان شتى طال ما ضمنا % % طي الكشوح على شكر وأحقاد % 34(@)(@@) % يفديكم الناس إذ تفدون أنفسهم % % منكم بأفضل أرواح وأجساد % 35(@)(@@) % في كل هيجاء تكنى من فظاعتها % % أم الدهاريس أو تدعى بعصواد % 36(@)(@@) % كم فيكم من شديد الدرء يومئذ % يصلى الوغى بشهاب منه وقاد % 37(@)(@@) % يغشى صدور العوالي دون حوزته % % بصدر حر عن السوآت محياد % 38(@)(@@) % هذا 
ms369	 ثنائي وهاتيكم مناقبكم % % بأعين الناس ما أبعدت إشهادي % % 39(@)(@@) % تحمدت بكم الأيام فأنكفأت % بعد الشكاة بحمد حاضر بادي % % 40(@)(@@) % ماحيد بالناس عن منهاج مكرمة % إلا هداكم إلى منهاجها هادي % % 41(@)(@@) % فابقوا بقاء مساعيكم فقد بقيت % منهن أطواد مجد فوق أطواد % PageV01P1343 البحر : - 1(@)(@@) % قل للأمير الطاهري الماجد % نبهك الله على المراشد % 2(@)(@@) % ليس الجواد مشتري القصائد % % بل الجواد مشتري المحامد % 3(@)(@@) % من جائر في مدحه وقاصد % % بل الجواد باذل المرافد % 4(@)(@@) % لشاكر نعمته وجاحد % % يعطي العطايا ليس للعوائد % 5(@)(@@) % لا كالمفيد طلب الفوائد % % يريغ بالمعروف حمد الحامد % 6(@)(@@) % إراغة البائع نقد الناقد % أعلم فداك طارفي وتالدي % % 7(@)(@@) % أن الذي أثنى برفد الرافد % فقد جزاه بالصواع الزائد % 8(@)(@@) % واستويا على قرار واحد % % PageV01P1344 البحر : - 1(@)(@@) % ياسائلي بأميرنا % % وبآفة نخبت فؤاده % 2(@)(@@) % أبدا عليه هزيمة % في الحرب مبدأة معاده % 3(@)(@@) % سلني فإني عالم % بأموره عدل الشهاده % 4(@)(@@) % ولى قفاه عبيده % واعتاد ذاك فصار عاده % 5(@)(@@) % فلذاك صار موليا % أبدا ولو لاقى جراده % PageV01P1345 البحر : - 1(@)(@@) % لا تحسبن الزمان ينسئك ال % % قرض ولكنه يدا بيد % 2(@)(@@) % يعطيك يوما فيقتضيك به % % مريرة من مرائر الجسد % 3(@)(@@) % يسترق الشيء من قواك وإن % % كان خفيا عن أعين الرصد % 4(@)(@@) % حالا فحالا حتى يرديك ال % % كبرة بعد الشباب والغيد % PageV01P1346 البحر : - 1(@)(@@) % يقتر عيسى على نفسه % % وليس بباق ولا خالد % 2(@)(@@) % فلو يستطيع لتقتيره % % تنفس من منخر واحد % 3(@)(@@) % عذرناه أيام إعدامه % % فما عذر ذي بخل واجد % 4(@)(@@) % رضيت لتفريق أمواله % % يدي وارث ليس بالحامد % PageV01P1347 البحر : - 1(@)(@@) % يختل حولا بخلال واحد % ثم يكر كرة المعاود % 2(@)(@@) % عليه بريا بمدى حدائد % عودن إصلاح الخلال الفاسد % 3(@)(@@) % ثم يقول كالقنوع الزاهد % % أغنى عن الطارف حفظ التالد % 4(@)(@@) % لا خير في البادىء غير العائد % إن أبا موسى لعين الماجد % PageV01P1348 البحر : - 1(@)(@@) % عجبا لمن يلقى الحرو % % ب فلا يقاتل أو يناجد % 2(@)(@@) % لا سيما من كان يو % % قن أنه إن مات عائد % 3(@)(@@) % خوفا وإشفاقا وإر % % صاد الحتوف له رواصد % 4(@)(@@) % إن قالإن النفس وا 
ms370	 % % حدة فإن الموت واحد % PageV01P1349 البحر : - 1(@)(@@) % خجلت خدود الورد من تفضيله % % خجلا توردها عليه شاهد % 2(@)(@@) % لم يخجل الورد المورد لونه % % إلا وناحله الفضيلة عاند % 3(@)(@@) % فصل القضية أن هذا قائد % % زهر الرياض وأن هذا طارد % 4(@)(@@) % شتان بين اثنين هذا موعد % بتسلب الدنيا وهذا واعد % 5(@)(@@) % وإذا احتفظت به فأمتع صاحب % بحياته لو أن حيا خالد % 6(@)(@@) % للنرجس الفضل المبين وإن أبى % % آب وحاد عن الطريقة حائد % 7(@)(@@) % من فضله عند الحجاج بأنه % % زهر ونور وهو نبت واحد % 8(@)(@@) % يحكي مصابيح السماء وتارة % يحكي مصابيح الوجوه تراصد % 9(@)(@@) % ينهى النديم عن القبيح بلحظه % وعلى المدامة والسماع مساعد % 10(@)(@@) % اطلب بعفوك في الملاح سميه % أبدا فإنك لا محالة واجد % PageV01P1350 11(@)(@@) % والورد لو فتشت فرد في اسمه % % مافي الملاح له سمي واحد % 12(@)(@@) % هذي النجوم هي التي ربتهما % % بحيا السحاب كما يربى الوالد % 13(@)(@@) % فتأمل الإثنين من أدناهما % % شبها بوالده فذاك الماجد % 14(@)(@@) % أين العيون من الخدود نفاسة % ورياسة لولا القياس الفاسد % PageV01P1351 البحر : - 1(@)(@@) % سعدت مقلتي بوجهك لولا % % أنها أعقبت بطول السهاد % 2(@)(@@) % نظرت نظرة إليك فأمسى % % ما اجتنت منك وارثا للرقاد % 3(@)(@@) % ليس فيما كسيت من حلل الحس % % ن ولا في هواي من مستزاد % 4(@)(@@) % أنا فرد الهوى كما أنت فرد الحس % % ن مستكبر عن الأنداد % PageV01P1352 البحر : - 1(@)(@@) % ليت هندا أنجزتنا ما تعد % وشفت أنفسنا مما تجد % 2(@)(@@) % واستبدت مرة واحدة % إنما العاجز من لا يستبد % PageV01P1353 البحر : - 1(@)(@@) % لم يكن ما كان شيئا يعتمد % بل أمورا وافقت يوم الأحد % 2(@)(@@) % شغلتنا عن نصيب وافر % من سرور بك يا ذخر الأبد % 3(@)(@@) % وسنعفي بوفاء صادق % ولنا الحظوة فيه والرشد % 4(@)(@@) % وكفانا زاجرا عن غدرة % قولهمأنجز حر ما وعد % 5(@)(@@) % وكفانا مستحثا قولهم % % لا تؤخر لذة اليوم لغد % PageV01P1354 البحر : - 1(@)(@@) % كفي الدموع وإن كان الفراق غدا % فرحلتي لتعيشي عيشة رغدا % % 2(@)(@@) % قالتأترحل والمشتاة قد حضرت % فقلت مثلي في أمثالها انجردا % % 3(@)(@@) % بنيقد قعد الدهر الخؤون بنا % % وليس مثلي في أمثاله قعدا % % 4 
ms371	(@)(@@) % قالتأتنتجع العباس قلت لها % % بل الطليق محيا والجواد بدا % % 5(@)(@@) % ذاك اسمه وله معنى يخالفه % % إلا إذا هو سيم الضيم والضمدا % % 6(@)(@@) % هناك سميه عباسا إذا حميت % منه الحميا وكنيه إذا رفدا % % 7(@)(@@) % مازال للفضل بذالا ككنيته % لا يرحم المال حتى يبلغ النقدا % % 8(@)(@@) % وبالمعادين صوالا يغادرهم % صرعى وإن هو لاقى جمعهم وحدا % % 9(@)(@@) % مما تراه لعافيه وشأنئه % يروح غيثا ويغدوا تارة أسدا % % 10(@)(@@) % كم من أناس رجوا مسعاته ركضوا % % ثم انثنوا قد ونوا واستعبدوا الأمدا % % PageV01P1355 11(@)(@@) % قالتأليس الفتى القاشي قلت لها % % بل الفتى الواضح المحمود منتقدا % % 12(@)(@@) % قالتصدقت ولكن هذه سمة % مثل المعاذة تثني عين من حسدا % % 13(@)(@@) % معاذة الله ألقاها على رجل % حفظا له ودفاعا عنه معتمدا % % 14(@)(@@) % والله حلاه إياها ليحميه % عينا تصيب وكفا تعقد العقدا % % 15(@)(@@) % يامن غدا ماله في الناس مشتركا % ومن توحد بالمعروف وانفردا % % 16(@)(@@) % ومن تحلى من الآداب أحسنها % % فما يرى أحد في ظرفه حدا % % 17(@)(@@) % أشكو إليك خطوبا قد بعلت بها % % لم تترك سبدا عندي ولا لبدا % % 18(@)(@@) % بيني وبينك أسباب أمت بها % % لو رمت إحصاءها لم أحصها عددا % % 19(@)(@@) % وأنت أذكرتنيها حين أذهلني % % دهر أكابد منه صاحبا نكدا % % 20(@)(@@) % وقد وعدت بفكي من شدائده % % وعدا فأنجز حر القوم ما وعدا % % PageV01P1356 21(@)(@@) % إن لا يكن بيننا قربى فآصرة % للدين يقطع فيها الوالد الولدا % % 22(@)(@@) % مقالة العدل والتوحيد تجمعنا % % دون المضاهين من ثنى ومن جحدا % % 23(@)(@@) % وبين مستطرفي غي مرافقة % ترعى فكيف اللذان استطرفا رشدا % % 24(@)(@@) % كن عند أخلاقك الزهر التي جعلت % % عليك موقوفة مقصورة أبدا % % 25(@)(@@) % ماعذر معتزلي موسع منعت % كفاه معتزليا مقترا صفدا % % 26(@)(@@) % أيزعم القدر المحتوم ثبطه % % إن قال ذاك فقد حل الذي عقدا % % 27(@)(@@) % أم ليس مستأهلا جدواه صاحبه % أنى وما حاد عن قصد ولا عندا % % 28(@)(@@) % أم ليس يمكنه ما يرتضيه له % % يكفي أخا من أخ ميسور ما وجدا % % 29(@)(@@) % لا عذر فيما يريني الرأي أعلمه % للمرء مثلك أن لا يأتي السددا % % 30(@)(@@) % قد كنت مضطلعا بالصيف محتملا 
ms372	 % تلك السموم وطورا ذلك الومدا % % PageV01P1357 31(@)(@@) % ولا وربك مالي بالشتاء يد % وقد أتاني يسوق الصر والجمدا % % 32(@)(@@) % وخلف ظهري من لا يرتجي أحدا % سواك للدهر إلا الواحد الصمدا % % 33(@)(@@) % جاء الشتاء ولم يعدد أخوك له % % يابن الأكارم إلا الشمس والرعدا % % 34(@)(@@) % استغفر الله من حوب نطقت به % % بل أنت لي عدة تكفيني العددا % % 35(@)(@@) % فاعطف علينا وألبسنا معا كنفا % من ريشك الوحف تنفي البؤس والصرداص إني أنا المرء إن نفلته نفلا % 36(@)(@@) % فلست تعدم منه الشكر ما خلدا % % وإن أثرت إلى تقليده عملا % 37(@)(@@) % يعيي الرجال بلوت الحزم والجلدا % % لا تحر من امرءا ساق الرجاء به % % 38(@)(@@) % وقد تسلف من جيرانه الحسدا % % وكنت قدما يرى الراؤون كلهم % % 39(@)(@@) % رجاء راجيك مالا حيز منتقدا % % ن % PageV01P1358 البحر : - 1(@)(@@) % أيها السيد الذي ورث السؤ % % دد عن كل سيد صنديد % % 2(@)(@@) % والذي راح يحمل الظرف والح % % جة حمل الذكي غير البليد % 3(@)(@@) % غزاليا وتارة جدليا % % مستعدا لكل خصم عنيد % 4(@)(@@) % أحي ماأبدأت يداك من العر % % ف بعود من مبدىء ومعيد % 5(@)(@@) % واذكر الجعد وارعه في واحفظ % % حرمتينا بالعدل والتوحيد % 6(@)(@@) % فهما يجمعاننا وولاء % ثالث وهو قولنا بالوعيد % 7(@)(@@) % عبد شمس أبوك وهو أبونا % % لا نناديك من مكان بعيد % 8(@)(@@) % عقدنا واحد وهاتيك قربى % % مسها مثل مس حبل الوريد % 9(@)(@@) % فارع شيخا لو استماحك حيا % ما رأيت الرضا له بالزهيد % 10(@)(@@) % وتوهمه شافعا في مكرو % % ثا لضيق أصبحت فيه شديد % % PageV01P1359 11(@)(@@) % حقه واجب عليك وحقي % % بانتحال المقال عين السديد % 12(@)(@@) % وأراني إليك أقرب منه % % بمميلي إلى الوصي الشهيد % % 13(@)(@@) % أنا من شيعة الوصي عليه % % صلوات من الحميد المجيد % % PageV01P1360 البحر : - 1(@)(@@) % ياأيها المرء الكريم والدا % % ذو المحتد المستفرغ المحاتدا % % 2(@)(@@) % أعاذك الله أخا معاضدا % % محاميا عن حوزتي مناجدا % % 3(@)(@@) % منتصرا طورا وطورا صافدا % % مازلت أختار لك المحامدا % % 4(@)(@@) % وأعمر الدهر بها المشاهدا % % عمران تالي السور المساجدا % % 5(@)(@@) % وأرتجي طارفه والتالدا % % وتتقي كفي به الشدائدا % % 6(@)(@@) % إعاذة تحميك أن تناكدا % % أو أن ترى تلك العلى زوائدا % % 7 
ms373	(@)(@@) % تطيع في قطعكها الثرائدا % % إذا علت أنواعها الموائدا % % 8(@)(@@) % و الحلل الخداعة البوائدا % % والكاعبات البيض والنواهدا % % 9(@)(@@) % الخائنات العهد والمعاهدا % % وإن تلبسن لك المجاسدا % % 10(@)(@@) % يحكين غزلان اللوى العواقدا % % حاذر هداك الله أن تعاندا % % PageV01P1361 11(@)(@@) % فيخطىء الغي بك المراشدا % % ويسلك الجور بك المآسدا % % 12(@)(@@) % لا ينصب البغي لك المصائدا % % فتستخف بكتابي وافدا % % 13(@)(@@) % أو بكلامي موعدا وواعدا % % ما كل من وافق جدا صاعدا % % 14(@)(@@) % وأصبح الدهر له مساعدا % % وأحرز الحظ له غدائدا % % 15(@)(@@) % أعرض عن إخوانه لا رافدا % % ولا مجيبا كتبهم بل جامدا % % 16(@)(@@) % كأنما يجامد الجلامدا % % صمتا ومنعا بادئا وعائدا % % 17(@)(@@) % يابن علي إن شكما راصدا % % وإن شعرا يقطع الفدافدا % % 18(@)(@@) % طورا وطورا يرد المواردا % % ولا يزال يقصد المقاصدا % % 19(@)(@@) % فيدرك الآثار والطرائدا % % وينحل الأغلال والقلائدا % % 20(@)(@@) % وينقض الأوتار والحقائدا % % فلا تثر من لم يثرك عامدا % % PageV01P1362 21(@)(@@) % ولا تثر من عتبه الأساودا % % ليس بأن تمنعه المرافدا % % 22(@)(@@) % لكن بأن تحقر منه ماجدا % % ذا همم قد ناغت الفراقدا % % 23(@)(@@) % يحسبه عطارد عطاردا % % قولا وحولا صادرا وواردا % % 24(@)(@@) % تبلوه ألفا وتراه واحدا % % تلقى إليه العضل المقالدا % % 25(@)(@@) % قد طال بالعفوالقيام قاعدا % % أجب كتابي باخلا أو جائدا % % 26(@)(@@) % تجد أخاك عاذرا أو حامدا % % وإن غدوت لشقاقي صامدا % % 27(@)(@@) % مستبطنا من دوني الأباعدا % % ورمت أن ترضي مني حاسدا % % 28(@)(@@) % معتمدا ما ساءني لا حائدا % % عنه تراعي الحرم التلائدا % % 29(@)(@@) % ولم تعظم أن أبيت واجدا % % ألفيتني أحمي محلي حاشدا % % 30(@)(@@) % ذا شيعة طورا وطورا فاردا % % ألقى لقاء الأجدل الصفاردا % % PageV01P1363 31(@)(@@) % منازلا دون الحمى مطاردا % % مطاعنا ذا نجدة مجالدا % % 32(@)(@@) % تكفي هويناي المشيح الجاهدا % % مبارزا طورا وطورا لابدا % % 33(@)(@@) % كالقسور الضاري تربى صائدا % % ولم أزل عضا أكيد الكائدا % % 34(@)(@@) % ولا أخر للمعادي ساجدا % % ولم أقارب صاحبا مباعدا % % 35(@)(@@) % قط ولا أعطيت رأسي القائدا % % ولم أكن للمطمعات عابدا % % 36(@)(@@) % إياك إياك وبعثي حاردا % % فيخطىء الحلم الصراط القاصدا % % 37(@)(@@) % ويركب الجهل الطريق العاندا % % واعلم وإنكنت صليبا ماردا % % 38(@)(@@) % ص % % أن الكريم يتقي القصائدا % % 39(@)(@@) % إذا غدت أعناقها 
ms374	 شواردا % % قد قلدت أمثالها الأوابدا % % 40(@)(@@) % هبك حديدا حاذر المباردا % % واعلم بأن الشعر ليس بائدا % % PageV01P1364 41(@)(@@) % بل خالد إن كان شيء خالدا % % وظالمين استوطئوا المراقدا % % 42(@)(@@) % ذعرت أطغاهم فبات ساهدا % % أسوان لا يستوثر الوسائدا % % 43(@)(@@) % صدقتك الحق فأعتب راشدا % % وليشبه الغائب منك الشاهدا % % 44(@)(@@) % ولا تبت فوق شفير هاجدا % % ولا عن الساهر فيك راقدا % % 45(@)(@@) % ولا لنعماء مجل جاحدا % % ولا تدع حرا حميا حاقدا % % 46(@)(@@) % يحزق أنيابا له حدائدا % % وشحن بأطراف الغنى المراصدا % % 47(@)(@@) % تترك ضراما في القلوب خامدا % % ولا تدع أفئدة مواقدا % % 48(@)(@@) % إن البذور تعقب الحصائدا % % وكنت لا أكذب أهلي رائدا % % 49(@)(@@) % واعلم متى أعتبتني مماجدا % % مراجعا برك بي معاودا % % 50(@)(@@) % وكنت ممن حاذر العوائدا % % أنك إن ماطلتني المواعدا % % PageV01P1365 51(@)(@@) % وأضرم الصيف الأجيج الصاخدا % % جاء الكساء عند ذاك باردا % % 52(@)(@@) % بردا على برد الشتاء زائدا % % لا باردا يفثأ حرا واقدا % % 53(@)(@@) % ولا لذيذا يشبه البواردا % % لكن مسيخا يشبه الجوامدا % % 54(@)(@@) % والرمم البالية الهوامدا % % ثقلا على الظهر ثقيلا كاسدا % % 55(@)(@@) % ولا أحب التحف الزهائدا % % ولا أريغ السلع الكواسدا % % 56(@)(@@) % فالرأي أن تلتمس المحائدا % % عن مطلنا لقيت عيشا راغدا % % 57(@)(@@) % واجعله لا يجني لك المواجدا % % ولا أصادف فيك سلكا عاردا % % 58(@)(@@) % فلست ممن يلبس البراجدا % % رعدت فاستطمر حيائي الراعدا % % 59(@)(@@) % شكري ولا تستصعق الرواعدا % % مني ولا تستجلب العرابدا % % 60(@)(@@) % حاشاك أن تستفره المكائدا % % للنفس أو تنتخب المكائدا % % PageV01P1366 61(@)(@@) % كخائن ينتهش الأرابدا % % وكن صديقا حفظ المعاهدا % % 62(@)(@@) % ولم تخن غيبته المعاقدا % % وراقب النشدة والمناشدا % % 63(@)(@@) % ولا تعد بعد صلاح فاسدا % % واغد إلى سوق العلا مزايدا % % 64(@)(@@) % فملك المكارم القوائدا % % تمليكك الحرائر الولائدا % % 65(@)(@@) % ولا يكن آملك المكابدا % % كلا ولا سائلك المجاهدا % % 66(@)(@@) % وقد وطد الله لك الوطائدا % % فلا يجدك الله إلا شائدا % % 67(@)(@@) % بنيان صدق يحفظ القواعدا % % ولا تواغد حارضا مواغدا % % 68(@)(@@) % يبيت عنمعروفه مراودا % % نفسا ترى في حلها المزاودا % % 69(@)(@@) % خطبا ينص القلص الجلاعدا % % كأنما تركب وأدا وائدا % % 70(@)(@@) % من والد أغرى بها الحواسدا % % لو خلت حالي تبتغي المساندا % % PageV01P1367 71 
ms375	(@)(@@) % عندك أعددت لكف ساعدا % % لكنني لم أخف المناكدا % % 72(@)(@@) % لديك بل أحسنت ظني سامدا % % مراغما للشبهات طاردا % % 73(@)(@@) % ياآل نوبخت أجيبوا ناشدا % % ودا لكم أصبح عنه شاردا % % 74(@)(@@) % ألم أكن عونا لكم مرافدا % % وخادما ناهيكم وحافدا % % 75(@)(@@) % وكنت لي يابن علي ماهدا % % مغايبا للبر لي مشاهدا % % 76(@)(@@) % حابس ظل لا يزال راكدا % % مجري ماء لا يزال ماكدا % % 77(@)(@@) % كن لي على الود كمهدي عاقدا % % لا زلت للأسواء فيك فاقدا % % 78(@)(@@) % فقد غدا حلمي لجهلي غامدا % % وحصن العهد بسور آمدا % % 79(@)(@@) % يا ساعدا ألوي به السواعدا % % قد كنت عينا تسكت المناقدا % % 80(@)(@@) % فلا تبهرج فتسوء الناقدا % % فازت يد تضحي لها معاقدا % % PageV01P1368 81(@)(@@) % فوز يد عانقت الخرائدا % % في جنة يضحي جناها مائدا % % 82(@)(@@) % بحيث لاتلقي هناك ذائدا % % ولا ترى ضدا لها معاندا ن % % PageV01P1369 البحر : - 1(@)(@@) % قل لأمير المؤمنين المعتاد % رعاية الله له بالمرصاد % 2(@)(@@) % أبشر بكيد الله كل كياد % عنكوعمر كبقاء الأطواد % 3(@)(@@) % قد اعتضدت بأشد الأعضاد % بالله مولاك لقتل الأضداد % 4(@)(@@) % يا عرس الدنياوعيد الأعياد % ملكك طول الدهر راسي الأوتاد % 5(@)(@@) % مستمكن العز وريق الأعواد % هذا أبو النجم كنجم وقاد % 6(@)(@@) % وابن سليمان القليل الأنداد % كلاهما دونك جم الأمداد % 7(@)(@@) % ما شئت من يمن ورأي منقاد % وسوق أموال وقود أجناد % 8(@)(@@) % آجام نصر حول ضرغام عاد % موكل الجد بصرع الأجداد % 9(@)(@@) % له إلى ما شاء من رشد هاد % قسورة الغيل وتنين الواد % 10(@)(@@) % غيث الورى من حاضر ومن باد % % ذوي عارض يمطر قبل الإرعاد % % PageV01P1370 11(@)(@@) % هيبته قارعة للأكباد % % يفلق أرواح العدا في الأجساد % % 12(@)(@@) % وجوده يغمر جود الأجواد % % وينشر الموتى بتلك الأرفاد % % 13(@)(@@) % أقذى به الله عيون الحساد % % وعاش في حالة نام مزداد % % 14(@)(@@) % بين كفاة ورجال أنجاد % % فهو إذا ما عد فرد الأفراد % 15(@)(@@) % وليكبت الفساق أهل الإلحاد % قد نسخ الإصلاح كل إفساد % % 16(@)(@@) % وأبعد الفسق أشد الإبعاد % واستأثر الله بصدق الميعاد % % PageV01P1371 البحر : - 1(@)(@@) % هنيئا بني العباس إن إمامكم % إمام الهدى والجود والبأسأحمد % 2(@)(@@) % كما بأبي العباس أنشىء ملككم % % كذا 
ms376	 بأبي العباس منكم يجدد % 3(@)(@@) % إمام يظل الأمس يعمل نحوه % % تلفت ملهوف ويشتاقه الغد % 4(@)(@@) % يود الزمان المنقضي عنه أنه % عليه لزام آخر الدهر سرمد % PageV01P1372 البحر : - 1(@)(@@) % دهر يشبع سبته أحده % متتابع ما ينقضي أمده % 2(@)(@@) % والحال من سعد يساعدنا % % طورا ونحس معقب نكده % 3(@)(@@) % يوم يبكينا وآونة % يوم يبكينا عليه غده % 4(@)(@@) % نبكي على زمن ومن زمن % فبكاؤنا موصولة مدده % 5(@)(@@) % ونرى مكارهنا مخلدة % والعمر يذهب فانيا عدده % 6(@)(@@) % أفلا سبيل إلى تبحبحنا % % في سرمد لا ينقضي أبده % 7(@)(@@) % سكرى شباب لا يعاقبه % % هرم وعيش دائم رغده % % 8(@)(@@) % لا خير في عيش تخوننا % % أوقاته وتغولنا مدده % % 9(@)(@@) % يعطي الفتى الأيام ينفقها % % وقصاصها أن يقترى جلده % % 10(@)(@@) % من أقرض الأوقات أتلفها % % وقضى جميع قروضها جسده % % PageV01P1373 11(@)(@@) % حتى يغيب في مطمطمة % لا أهله فيها ولا ولده % % 12(@)(@@) % وأجل ذلك أن تركت سدى % من قاسم وأقراني بلده % % 13(@)(@@) % ملك إذا اسودت لدي يد % من غيره ابيضت لدي يده % 14(@)(@@) % مهما عدمنا من سدى وندى % عند الملوك فعنده نجده % 15(@)(@@) % خلت الإساءة من إرادته % ويريد إحسانا ويعتمده % % 16(@)(@@) % ما انفك يرفعني وينفعني % % حتى أضر بحاسدي حسده % % 17(@)(@@) % قالت فضائله لآمله % نعم الفتى للدهر تعتقده % % PageV01P1374 البحر : - 1(@)(@@) % كل زرع فإنه للحصاد % والمنايا روائح وغوادي % % 2(@)(@@) % رحم الله من مضى ووقاكم % نوب الدهر يا بني حماد % % 3(@)(@@) % فلئن نلتم سعود جدود % ما حرمتم مكارم الأجداد % 4(@)(@@) % ولئن لم يكن من الموت بد % إن معروفكم لبالمرصاد % % 5(@)(@@) % فاسلموا وانعموا بخير متاع % % واسعدوا بعده بخير معاد % % 6(@)(@@) % جعل الله عيشكم خير عيش % % ما حييتم وزادكم خير زاد % 7(@)(@@) % وأراكم في المال والحال والأن % % فس ما تشتهون والأولاد % % 8(@)(@@) % ووقاكم كيد البغاة ولا ق % % ل أمدادكم من الحساد % % 9(@)(@@) % يابني النسك والحكومة وال % % حكمة والعدل والنهى والرشاد % % 10(@)(@@) % إن فغلتم ففعلكم لصواب % أو نطقتم فنطقكم لسداد % % PageV01P1375 البحر : - 1(@)(@@) % ماخمدت ناري ولكنني % % ألقى قلوبا نارها خامده % 2(@)(@@) % قد حدثت في دهرنا أنفس % تستبرد السخنة لا البارده % 3(@)(@@) % كما تعاف 
ms377	 الطيب المشتهى % % من الطعام المعدة الفاسده % 4(@)(@@) % وليس بالبارد ما استبردت % لكنها الباردة الجامده % PageV01P1376 البحر : - 1(@)(@@) % لك الطائر الميمون والطالع السعد % وطول بقاء ليس من بعده بعد % 2(@)(@@) % تأمل وأنت المرء ينظر نظرة % % فلا غور إلا وهو في عينه نجد % 3(@)(@@) % ذكاء وإشرافا على كل غامض % يقصر قدما دون عفوهما الجهد % % 4(@)(@@) % ألم تر أن الجد مذ كان سيد % % وأن الونى في كل عارفة عبد % 5(@)(@@) % وتكميل معروف الكريم بحشده % % وأسديت معروفا وقد بقي الحشد % 6(@)(@@) % ولست براض منك ما لست راضيا % ولست براض غير ما يرتضي المجد % % 7(@)(@@) % إذا ما قصدت الأمر أول قصده % % ولم تتلها أخرى فما حصحص القصد % % 8(@)(@@) % ولا عمد لم يحفزه عمد مؤكد % من المرء إلا أشبه الخطأ العمد % 9(@)(@@) % وعندي أمثال لذاك كثيرة % % سيحدو بها في البر والبحر من يحدو % % 10(@)(@@) % إذا ما عقدت العقد ثم تركته % % ولم يثنه عقد وهى ذلك العقد % % PageV01P1377 11(@)(@@) % وما النهل دون العل شافي غلة % وإن ساعد الماء العذوبة والبرد % 12(@)(@@) % ولا البرق دون الرعد ضامن مطرة % % ولكن إذا ما البرق عاضده الرعد % 13(@)(@@) % وما العين عينا حين تفقد أختها % % ولا الأذن أذنا ما طوى أختها الفقد % 14(@)(@@) % وما اليد لولا أختها بقوية % ولا الرجل لولا الرجل تمشي ولا تعدو % % 15(@)(@@) % ولا كل محتاج إلى ما يشده % % يسفسف إلا والوهاء له وكد % 16(@)(@@) % فعزز كتابا منك وترا بشفعه % % فما عز إلا الله مستنجد فرد % 17(@)(@@) % ترفع عن التعذير غير مذمم % % إلى شرف الإعذار يخلص لك الحمد % 18(@)(@@) % وزدنا من الفعل الجميل فلم تزل % تكرم حتى يعشق الكرم الوغد % 19(@)(@@) % وبعد فإني يا قريعي زماننا % % مبثكما وجدي فما مثله وجد % 20(@)(@@) % ألا فاسمعا لي إن شكوت فطال ما % % شدوت بمدحي فيكما فوق من يشدو % % PageV01P1378 21(@)(@@) % عميدي ما بالي حرمت جداكما % % ورأيكما رأي وعهدكما عهد % 22(@)(@@) % أعندي منقض الصواعق منكما % % وعند ذوي الكفر الحيا والثرى الجعد % 23(@)(@@) % وتحتي نعلي تخبط الأرض جهدها % % وتحت سواي السرج والسابح النهد % 24(@)(@@) % ولا غرو أن 
ms378	 تحظى علي عصابة % % لوت حمدها والحمد عندي والحقد % % 25(@)(@@) % كذا والوهد تحظى بالسيول على الربا % % ويعشبن بدءا قبل أن يعشب الوهد % 26(@)(@@) % متى أنصرف بالوجه والقلب عنكما % % وأغد على حر فحق لي الحرد % 27(@)(@@) % شهدت لقد أشقيتماني وإنما % % تقدم لي بالحظ لا الشقوة الوعد % 28(@)(@@) % أرجي فما أرجو ضمان لديكما % % وأخشى فما أخشاه عندكما نقد % 29(@)(@@) % وماهو إلا واقع العتب منكما % % وهل مثله حبس وهل مثله جلد % 30(@)(@@) % وما لي من ذنب وإن براءتي % % وعذري مما لا يغيبه الجحد % PageV01P1379 31(@)(@@) % أتنبو بي الدنيا على حين لينها % % وقد سكن الزلزال وامتهد المهد % 32(@)(@@) % وقد ضم عنز الأهل والذئب مرتع % وأصبح ظبيالرمل صالحه الفهد % 33(@)(@@) % أمالي إلى أن تجمعا لي رضاكما % % سبيل ولا يجري بذلك لي سعد % 34(@)(@@) % أمالي إلى أن تغدوا صدر مجلس % % مساغ فلا يغدوا ابن حظ كما أغدو % 35(@)(@@) % هنالك تجري لي سعودي كلها % % فيحيا الشباب اللدن والزمن الرغد % 36(@)(@@) % تعاديتما والحسن والطيب فيكما % % كما يتعادى النرجس الغض والورد % 37(@)(@@) % وما الحسن والطيب الذي قد حويتما % % سوى فضل أخلاق محامدها سرد % 38(@)(@@) % وعلم وحلم لا يوازن بعضه % شرورى ولا رضوى وعروى ولا رقد % 39(@)(@@) % عذلتكما عذلي وليس بجارح % % فإن كان عذلا جارحا فهو القصد % 40(@)(@@) % له النخسة الأولى وينفع غبه % وما زال مني نحو نفعكما صمد % PageV01P1380 41(@)(@@) % بذوركما فاستصلحاها لتجنيا % % صلاحا إذا ما الريع حصله الحصد % 42(@)(@@) % وإياكما والبغي خدنا فإنه % ذميم دميم في أحاديث من يندو % % 43(@)(@@) % وعلمكما بالرشد ما قد علمتما % % ونحوكما نص المشاور والوخد % 44(@)(@@) % وبالله ما مقدار دنيا تنوفست % بمثل ولا عدل لبعض الذي يبدو % % 45(@)(@@) % وما أنا إلا ناصح متحرق % بحبكما حتى يشق له اللحد % 46(@)(@@) % وما زلت عن رأي ولا حلت عن هوى % % ولا قلت حتى قيل لي حجر صلد % 47(@)(@@) % وفدت وآمالي ومدحي عليكما % % ولا عذر مالم يغش وفدكما وفد % PageV01P1381 البحر : - 1(@)(@@) % لا زلت أبيض غرة وأياد % تبدو لنا في سؤدد وسواد % 2(@)(@@) % خلع عليك جمالها وجلالها % % أيامها للناس كالأعياد % 3(@)(@@) % قسما 
ms379	 لقد رضيتك أعين معشر % % من وامقين وشانئين أعادي % % 4(@)(@@) % أقبلت في جيش يظلك ليله % وإليك منك لكل عين هادي % % 5(@)(@@) % متدرعا خلعا أنست بلبسها % % أنس المعود لبسها المعتاد % 6(@)(@@) % طرفا علت شرفا تليدا لم تزل % % متعهدا من مثلها بتلاد % 7(@)(@@) % خلع الإله عليك يوم لبستها % % هدي الشكور وبهجة المزداد % 8(@)(@@) % وكساك من خلع القلوب محبة % كمحبة اللآباء للأولاد % 9(@)(@@) % فظللت في خلع تفاوت نجرها % % خاف تلاحظه العقول وباد % 10(@)(@@) % عمرت تنهض في مراق عفوها % % عفو الحدور وأنت في إصعاد % PageV01P1382 11(@)(@@) % تغدو وأنت جوى لأكباد العدا % % وقلوبهم وندى على أكباد % 12(@)(@@) % وإخال أن عداك قد عطفتهم % % كفاك بالإرفاد فالإرفاد % 13(@)(@@) % ولقد أردت جزاءهم بفعالهم % % فعلمت أن العرف بالمرصاد % 14(@)(@@) % يا من أرى حساده استحقاقه % % للحظ فاستدعى هوى الحساد % 15(@)(@@) % حسن وإحسان إذا ما عوينا % % ردا عليك ولاء كل معادي % % 16(@)(@@) % من ذا يعادي البدر أمسى منعما % نعمى عفو للذنوب جواد % 17(@)(@@) % كم من يد بيضاء قد أوليتها % % تثني إليكعنان كل وداد % 18(@)(@@) % شكر الإله صنائعا أسديتها % % سلكت مع الأرواح في الأجساد % 19(@)(@@) % وعفا نبوك عن وليك إنه % أحدوثة في جانبي بغداد % 20(@)(@@) % ومن الزيادة في البلية أنني % % أصبحت في البلوى من الأفراد % PageV01P1383 21(@)(@@) % أرني سواي من الذين صنعتهم % % رجلا نسخت صلاحه بفساد % 22(@)(@@) % إني أعوذ بيمن جدك أن أرى % % بعد الدنو رهينة الإبعاد % PageV01P1384 البحر : - 1(@)(@@) % لي زرع أتى عليه الجراد % عادني مذ رزئته العواد % 2(@)(@@) % كنت أرجو حصاده فأتاه % % قبل أن يبلغ الحصاد حصاد % PageV01P1385 البحر : - 1(@)(@@) % عيدان مجموعان في عيد % دليل تأكيد وتأييد % 2(@)(@@) % ما جمع الفطر إلى جمعة % إلا لملك ولتخليد % 3(@)(@@) % ولم أقل من ذاك ما قلته % % إلا بتوفيق وتسديد % % 4(@)(@@) % وليس مني ذاك بل منكم % يا نجل صنديد فصنديد % % 5(@)(@@) % حبتك بالنرجس أيامه % والراح فاشرب غير تصريد % 6(@)(@@) % على سماع مطرب معجب % ألذ من نجح المواعيد % 7(@)(@@) % واجعله يا من لم يزل ماجدا % في الفعل موصولا بتمجيد % 8(@)(@@) % لا من حدود سودتها اللحى % % بل من خدود ذات توريد 
ms380	 % 9(@)(@@) % تجمع لعين وفم طاهر % % ماءي خدود وعناقيد % % 10(@)(@@) % دونك ياسيد أكفائه % % عزف الحسان الخرد الغيد % PageV01P1386 11(@)(@@) % فمن صواب الرأي لقيته % جمعك بين العيد والغيد % 12(@)(@@) % وأخلق العيد وأمثاله % % في ظل نعمى ذات تجديد % 13(@)(@@) % لا زالت الدنيا وأملاكها % % تلقى إليكم بالمقاليد % 14(@)(@@) % وشيد الله الذي أسست % % لكم سعادات المواليد % % PageV01P1387 البحر : - 1(@)(@@) % قدم الفطر صاحبا مودودا % ومضى الصوم صاحبا محمودا % 2(@)(@@) % ذهب الصوم وهو يحكيك نسكا % واتى الفطر وهو يحكيك جودا % 3(@)(@@) % وشبيهاك لا يخونانك العه % % د لعمري بل يرعيان العهودا % % 4(@)(@@) % وستبقى عليهما ويعودا % % ن كما أنت مشته أن يعودا % % 5(@)(@@) % جعل الله عمر شانئك المق % % صور حتما وعمرك الممدودا % % PageV01P1388 البحر : - 1(@)(@@) % لاتزل أيها الإمام السعيد % % لك نعمى تنمي وعمر يزيد % 2(@)(@@) % فلأنت الرشيد أمرا وأنى % % يخطيء الرشد من أبوه الرشيد % % 3(@)(@@) % ومن الرشد أن تنادم عيدا % حقه الكأس والسماع السديد % 4(@)(@@) % إن عيدا حيا الخليفة بالنر % % جس والعرس والعروس لعيد % % PageV01P1389 البحر : - 1(@)(@@) % خسأت كلبا مر بي مرة % فقال مهلا يا أخا خالد % % 2(@)(@@) % حسبكم خزيا بني آدم % % شركتكم إياه في والد % % PageV01P1390 البحر : - 1(@)(@@) % إن كنت تعطيني عطا % % ءك للهلال إذا بدا % % 2(@)(@@) % فيحق لي في كل ما % % لاقيتني أن أرفدا % % 3(@)(@@) % لي من جبينك بدر سع % % د طالع لن يفقدا % % 4(@)(@@) % فمتى نظرت إلى سنا % % ه فحق لي أن أسعدا % % 5(@)(@@) % فعلام أمنع واجبي % % وعلام أمطل سرمدا % % 6(@)(@@) % ولما لعبدك واجب % % لكن لكونك سيدا % % PageV01P1391 البحر : - 1(@)(@@) % يرى ما وأى عنه الرجاء كما وأى % % وما وعدت منه الظنون كما وعد % 2(@)(@@) % ويعطي فيكفي بدء جدواه عودها % % ألا هاكذا فليمنع اليوم رفد غد % % 3(@)(@@) % يعاقب ما أدنى العقاب من التقى % % ويعفو فلا يعفو قعودا على ضمد % % PageV01P1392 البحر : - 1(@)(@@) % بان الشباب ونعم الصاحب الغادي % % وكان ما شئت من أنس وإسعاد % 2(@)(@@) % بان الشباب حميدا ماذممت له % % عهدا ولاذم ما زودت من زاد % 3(@)(@@) % وكان واللهو مقرونين في قرن % فأنبت حبلهما مني لميعاد % % 4(@)(@@) % وقد تخايلت في سرباله عصرا % أعود فيه من 