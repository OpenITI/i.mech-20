ms1661	 القيامة. PageV09P075(@)(@@) أبو الموال ويقال أبو الموالي مولى علي بن أبي طالب الهاشمي، يعد في أهل المدينة سمع عليا، روى عنه يحيى بن قيس.(@)(@@)(@@)(@@) || باب النون(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $ 720 - أبو نهيك عن سلمان، روى عنه العلاء بن بدر.(@)(@@)(@@)(@@) $ 721 - أبو نهيك سمع ابن عباس، روى، عنه قتادة وحسين بن واقدو زياد ابن سعد.(@)(@@)(@@)(@@) $ 722 - أبو نهيك عن شهر روى عنه نصر بن حاجب.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 723 - أبو نصر بن عمر وسمع عليا، روى عنه مالك بن الحارث.(@)(@@)(@@)(@@) $ 724 - أبو نصر التمار سمع حماد بن سلمة هو البغدادي واسمه عبد الملك بن عبد العزيز.(@)(@@)(@@)(@@) $ 725 - أبو نصر حدثنا إبراهيم بن نصر قال نا الأشجعي عن سفيان عن الأغر عن خليفة بن حصين عن أبي نصر عن ابن عباس كان بين الأوس والخزرج.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 726 - أبو نصيرة سمع مولى لأبي بكر، روى عنه عثمان بن واقد.(@)(@@)(@@)(@@) $ 727 - أبو نصير (1) سمع أبا سعيد، روى عنه إبراهيم بن يزيد الكوفي.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 728 - أبو النعمان عن أبي وقاص، روى عنه علي بن عبد الأعلى.(@)(@@)(@@)(@@) $ 729 - أبو النعمان أبصر أبا المغيرة يدخل العسن ستة (1) ، قال أبو نعيم عن سفيان عن الركين.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 730 - أبو نجيلة له صحبة، قاله ابن مهدي عن سفيان عن الأعمش عن شقيق. PageV09P076(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 731 - أبو نعامة الأسدي عن خاله سمع ابن عمر، روى عنه الحسن بن صالح.(@)(@@)(@@)(@@) $ 732 - أبو نعامة شيخ من الحي، قال اختصم إلى عبد الرحمن بن سمرة في سيل جاء قال من أين؟ قالوا من ها هنا نحو الجبان قال فإن هذا جهد، قال يحيى يعني العميس (1) .(@)(@@)(@@)(@@) ||| باب الواحد(@)(@@)(@@)(@@) $ 733 - أبو نجيح العبسي عن النبي صلى الله عليه وسلم، روى ربيعة بن لقيط عن رجل عن أبي نجيح.(@)(@@)(@@)(@@) $ 734 - أبو نهشل عن أبي وائل، روى عنه المسعودي.(@)(@@)(@@)(@@) $ 735 - أبو النضر المازني عن الشعبي، روى عنه سلام بن مسكين.(@)(@@)(@@)(@@) $ 736 - (@)(@@) ، أبو نبيه سمع عائشة قالت سمعت النبي صلى الله عليه وسلم يقول ما تحت الكعبين من الإزار في النار، قاله يوسف بن بهلول عن 
ms1662	 عبدة عن ابن إسحاق عن أبي نبيه.(@)(@@)(@@)(@@) $ 737 - أبو نمير عن الهيثم بن مالك عن النبي صلى الله عليه وسلم في الربا (2) ، قاله أبو صالح عن معاوية.(@)(@@)(@@)(@@) $ 738 - أبو نوح عن جابر بن زيد، روى عنه مطر الوراق.(@)(@@)(@@)(@@) || باب الواو(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $ 739 - أبو واصل عن أبي مسعود، روى عنه عبد الكريم.(@)(@@)(@@)(@@) $ 740 - أبو واصل التميمي عن أبي صادق، روى عنه مروان.(@)(@@)(@@)(@@) $ 741 - أبو واصل عن أبي أمية، روى عنه محمد بن سليمان.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 742 - أبو الوليد مولى عمر وبن خراش (3) سمع أبا هريرة، روى عنه ابن PageV09P077(@)(@@) أبي ذئب.(@)(@@)(@@)(@@) $ 743 - أبو الوليد مولى رواحة، روى ابن جريج عن أبي الوليد.(@)(@@)(@@)(@@) $ 744 - أبو الوليد مولى لقريش سمع بلال بن أبي بردة، روى عنه سهل بن عطية.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 745 - أبو الوازع عن عبد الله بن بسر، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) $ 746 - أبو الوازع سمع ابن عمر، روى عنه الثوري وابن عيينة.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 747 - أبو واقد السلاب عن مالك بن أبي الرجال، روى عنه عباس بن أبي سلمة.(@)(@@)(@@)(@@) $ 748 - أبو واقد قال ابن عون سمعته يحدث الحسن في بيت أبي خليفة، مرسل.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 749 - أبو وهب الجشمي نا أحمد بن حنبل قال نا هشام بن سعيد قال ارنا محمد ابن مهاجر قال نا عقيل بن شبيب عن أبي وهب وكانت له صحبة، قال قال رسول الله صلى الله عليه وسلم تسموا بأسماء الأنبياء وأحب الأسماء إلى الله عبد الله وعبد الرحمن، وذكر الحديث.(@)(@@)(@@)(@@) $ 750 - أبو وهب الكلاعي عن عبد الله بن عمرو، روى عنه عبد الرحمن بن مرزوق.(@)(@@)(@@)(@@) $ 751 - أبو وهب عن أبي هريرة، روى حميد بن سعيد.(@)(@@)(@@)(@@) ||| باب الواحد(@)(@@)(@@)(@@) $ 752 - أبو وعلة العجلي قدم علينا كريب من مصر ويريد معاوية فزرناه.(@)(@@) فقال ما أدري ما عدد ما حدثني مرة البهزي في جماعة وفي خلاء سمع النبي صلى الله عليه وسلم لا تزال طائفة من أمتي ظاهرين على من نا واهم، وذكر الحديث.(@)(@@) PageV09P078(@)(@@)(@@)(@@) $ 753 - أبو وقاص قال ابن المثنى نا أبو عامر سمع إبراهيم 
ms1663	 بن طهمان عن علي بن عبد الأعلى عن أبي النعمان عن أبي وقاص عن زيد بن أرقم عن النبي صلى الله عليه وسلم إذا وعد احدكم اخاه فلم يف ولم يجئ إلى الميعاد فلا إثم عليه.(@)(@@)(@@)(@@) $ 754 - أبو وائل القاص المرادي اليامي الصنعاني سمع عروة بن محمد، روى عنه إبراهيم بن خالد الصنعاني.(@)(@@)(@@)(@@) $ 755 - (@)(@@) ابوالوسمى عن زياد بن ملقط، روى عنه ابن عيينة.(@)(@@)(@@)(@@) $ 756 - (@)(@@) أبو ونقة أتانا كتاب عمر بن عبد العزيز، قاله عبيد عن حفص.(@)(@@)(@@)(@@) $ 757 - (@)(@@) أبو الورد بن ثمامة القشيري قلت لعبد الرحمن أدركت أحدا من أصحاب رسول الله صلى الله عليه وسلم قال غير واحد قاله معلى عن عبد الواحد عن الجريري قال علي هو ثمامة بن حزن البصري.(@)(@@)(@@)(@@) $ 758 - (@)(@@) أبو وحشية الصيقل سمع مصعب بن الزبير، روى عنه قرة بن خالد وكان جميلا وكان قاطع الشهادة وكان ابن الحكم الغفاري.(@)(@@) (1)(@)(@@)(@@)(@@) $ 759 - أبو الوضئ، عن الشعبي، روى عنه شريك.(@)(@@)(@@)(@@) || باب الهاء(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $ 760 - أبو الهيثم بن نصر بن دهر الأسلمي عن أبيه.(@)(@@)(@@)(@@) $ 761 - أبو الهيثم العطار ويقال الهيثم.(@)(@@)(@@)(@@) $ 762 - أبو الهيثم صاحب القصب سمع ابن المسيب وابن جبير، روى عنه الثوري(@)(@@) الكوفي.(@)(@@)(@@)(@@) $ 763 - أبو الهيثم الضمري عن سعيد بن أبي عمرة، روى عنه الحكم بن محمد.(@)(@@)(@@)(@@) $ 764 - أبو الهيثم عن الحسن، روى عنه أبو معاوية.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 765 - أبو هاشم بن عتبة بن ربيعة القرشي خال معاوية بن أبي سفيان قال أبو هريرة كان رجلا صالحا، نا دحيم قال نا محمد بن شعيب عن خالد بن دهقان PageV09P079(@)(@@) عن خالد سبلان عن كهيل بن حرملة النميري قال قدم أبو هريرة دمشق فنزل على آل أبي هاشم الدوسي وذكر الحديث.(@)(@@)(@@)(@@) $ 766 - أبو هاشم الدوسي قال قال أبو هريرة قاله النضر بن شميل عن عكرمة بن عمار.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 767 - أبو هلال الكعبي.(@)(@@)(@@)(@@) $ 768 - أبو هلال الليثى، روى عنه عمر مولى غفرة.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 769 - أبو هند الداري أخو تميم بن أوس الداري.(@)(@@)(@@)(@@) $ 770 - أبو هند البجلي قال أبو النعمان نا حريز بن عثمان 
ms1664	 عن أبي عون عن أبي هند البجلي عن معاوية سمعت النبي صلى الله عليه وسلم يقول لا تنقطع الهجرة حتى تنقطع التوبة ثلاث مرات ولا تنقطع التوبة حتى تطلع الشمس من مغربها.(@)(@@)(@@)(@@) $ 771 - أبو هند الهمداني عن أبي ظبيان، روى عنه محمد بن قيس.(@)(@@)(@@)(@@) $ 772 - أبو هند المرهبي عن الضحاك، روى عنه شريك، مرسل.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 773 - أبو هارون الحجام مولى حماد بن عمران التيمي قال حجمت ابا بكر ابن محمد بن عمر وبن حزم يوم السبت، قاله قتيبة عن معاوية (1) .(@)(@@)(@@)(@@) $ 774 - أبو هارون الواسطي بن كعب نا شريك عن أبي هارون الواسطي قال وقعت ثنية ابن لعمر بن سعد فقضى شريح بخمس من الإبل وجعله أخماسا.(@)(@@)(@@)(@@) ||| باب الواحد(@)(@@)(@@)(@@) $ 775 - أبو هشام عن ابى سعيد، روى عنه عمر وبن دينار.(@)(@@)(@@)(@@) $ 776 - أبو هزاز.(@)(@@) (2) PageV09P080(@)(@@)(@@)(@@) $ 777 - أبو هبيرة الضبي، روى عنه حنش بن الحارث.(@)(@@)(@@)(@@) $ 778 - أبو الهندي سمع أبا طالوت، روى عنه معتمر.(@)(@@)(@@)(@@) $ 779 - أبو الهداج - سمع ابن المسيب قوله، روى عنه حرملة.(@)(@@)(@@)(@@) $ 780 - أبو همام الشعباني، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) $ 781 - أبو هنيدة عن أبي ماوية، روى عنه داود بن أبي هند.(@)(@@)(@@)(@@) || باب لام الف(@)(@@)(@@)(@@) $ 782 - ابولاس الخزاعي له صحبة من النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) || باب الياء(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $ 783 - أبو يزيد الخولاني عن فضالة بن عبيد عن عمر عن النبي صلى الله عليه وسلم قال الشهداء أربعة.(@)(@@) قاله عبد الله بن يوسف عن معاوية بن يحيى سمع سعيد.(@)(@@) ابن أبي أيوب عن عطاء بن دينار عن أشياخ من خولان.(@)(@@)(@@)(@@) $ 784 - أبو يزيد المدني سمع ابن عمر قال عمر وبن علي عن أبي ذر عن قرة سمع(@)(@@) أبا يزيد.(@)(@@)(@@)(@@) $ 785 - أبو يزيد الغوثي عن النبي صلى الله عليه وسلم، روى عنه الأوزاعي.(@)(@@)(@@)(@@) $ 786 - أبو يزيد عمن سمع النبي صلى الله عليه وسلم، قاله مسدد عن أبي عوانة عن عطاء بن السائب عن أبي يزيد.(@)(@@)(@@)(@@) $ 787 - أبو يزيد عن أبي سلام الأسود عن ثوبان عن النبي صلى الله عليه وسلم إن ربي 
ms1665	 قال يا محمد هل تدري فيما يختصم الملأ الأعلى.(@)(@@)(@@)(@@) $ 788 - أبو يزيد الضبي.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 789 - أبو يوسف مولى معاوية وفضالة بن عبيد، روى عنه خالد بن يزيد المزني.(@)(@@)(@@)(@@) $ 790 - أبو يوسف المكي سمع عطاء، روى عنه يعقوب بن القعقاع.(@)(@@) PageV09P081(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 791 - أبو يونس عن المقداد بن الأسود عن النبي صلى الله عليه وسلم قال إذا.(@)(@@) بات الضيف محروما فحق على المسلمين نصرته.(@)(@@) قاله وكيع عن يزيد بن سنان عن أبي يونس.(@)(@@)(@@)(@@) $ 792 - أبو يونس وكان نظيرا لمحمد بن كعب قال ما أنكرت من زمانك (1) قاله أبو صالح عن معاوية أن أبا رشدين أخبره عن أبي يونس.(@)(@@)(@@)(@@) ||| باب(@)(@@)(@@)(@@) $ 793 - أبو يحيى عن عبد الله بن عمرو، روى عنه هلال بن يساف.(@)(@@)(@@)(@@) $ 794 - أبو يحيى بن عمرو بن أبي عقرب عن ابن عمر، روى عنه ربيعة ابن كلثوم.(@)(@@)(@@)(@@) $ 795 - أبو يحيى القيسي رأى أبا حسان الاعرج وجمرة السدوسية، روى عنه(@)(@@) يحيى ابنه، يعد في البصريين.(@)(@@)(@@)(@@) $ 796 - أبو يحيى المكي عن فروخ مولى عثمان، روى عنه الهيثم بن رافع.(@)(@@)(@@)(@@) $ 797 - أبو يحيى من اهل اليمن عن ابى عمر، روى عنه ابنه سعيد.(@)(@@)(@@)(@@) $ 798 - أبو يحيى مولى جعدة عن أبي هريرة، روى عنه الأعمش.(@)(@@)(@@)(@@) ||| باب الواحد(@)(@@)(@@)(@@) $ 799 - أبو اليقظان، له صحبة.(@)(@@)(@@)(@@) $ 800 - أبو يعقور مولى سعيد بن العاص، سمع ابن المسيب ويعقور بن عبيد الله روى عنه الضحاك بن عثمان.(@)(@@)(@@)(@@) $ 801 - أبو اليمان المقرئ سمع أبا المنيب الحرشي، روى عنه يحيى بن حمزة.(@)(@@)(@@)(@@) $ 802 - أبو اليسع المكفوف عن علقمة بن مرثد قال أبو أسامة نا أبو اليسع قال حدثنى عمر وبن مرة عن عطاء أبي حمزة قال قال رسول الله صلى الله عليه وسلم إن أوثق عرى الإسلام الحب في الله والبغض في الله.(@)(@@)(@@)(@@) $ 803 - أبو يسار قوله، روى عنه الليث. PageV09P082(@)(@@)(@@)(@@) | وفي الأسماء من كان الغالب على اسمه كنيته وله اسم(@)(@@)(@@)(@@) $ 804 - أبو شريح الخزاعي الكعبي، اسمه خويلد له صحبة.(@)(@@)(@@)(@@) $ 805 - أبو الجوزاء البصري اسمه أوس بن عبد الله الربعي.(@)(@@)(@@)(@@) $ 806 - أبو رافع مولى 
ms1666	 رسول الله صلى الله عليه وسلم، اسمه أسلم.(@)(@@)(@@)(@@) $ 807 - أبو يحيى الهلالي، اسمه أحنف التميمي المدني روى أبو إسحاق عن التميمي.(@)(@@) عن ابن عباس، اسمه أربدة.(@)(@@)(@@)(@@) $ 808 - (@)(@@) أبو رهم السباعي، اسمه أحزاب بن أسد المقري.(@)(@@)(@@)(@@) $ 809 - (@)(@@) أبو مسلم الخولاني، اسمه عبد الله بن ثوب.(@)(@@)(@@)(@@) $ 810 - (@)(@@) أبو اسحاق السبيعى، اسمه عمر وبن عبد الله.(@)(@@)(@@)(@@) $ 811 - (@)(@@) أبو الأحوص اسمه عوف بن مالك بن نضلة الجشمي.(@)(@@)(@@)(@@) $ 812 - (@)(@@) أبو عشانة، اسمه حى بن يومن.(@)(@@)(@@)(@@) $ 813 - (@)(@@) أبو قبيل، اسمه حى بن هانئ.(@)(@@)(@@)(@@) $ 814 - (@)(@@) أبو رهم الغفاري، اسمه كلثوم بن الحصين.(@)(@@)(@@)(@@) $ 815 - (@)(@@) أبو السليل، اسمه نقير بن ضريب ويقال نقيب بن سمير.(@)(@@)(@@)(@@) $ 816 - (@)(@@) أبو عثمان النهدي، اسمه عبد الرحمن بن مل.(@)(@@)(@@)(@@) $ 817 - (@)(@@) أبو العريان، اسمه هيثم بن الأسود.(@)(@@)(@@)(@@) $ 818 - (@)(@@) أبو العريان، اسمه أنيس قاله ابن علية عن خالد الحذاء.(@)(@@)(@@)(@@) $ 819 - (@)(@@) أبو العريان المجاشعي البصري عن ابن عباس، اسمه بركة.(@)(@@)(@@)(@@) $ 820 - (@)(@@) أبو موسى، اسمه إسرائيل، عن الحسين، روى عنه ابن عيينة(@)(@@)(@@)(@@) $ 821 - (@)(@@) أبو عمر والندبى، اسمه بشر بن حرب.(@)(@@)(@@)(@@) $ 822 - (@)(@@) أبو أمامة بن سهل بن حنيف بن واهب، اسمه أسعد.(@)(@@)(@@)(@@) $ 823 - (@)(@@) أبو الصديق الناجي، اسمه بكر بن قيس.(@)(@@) PageV09P083(@)(@@)(@@)(@@) $ 824 - (@)(@@) أبو عتبة ابن الأعتق الذي روى عن عطاء وبكر بن عبد، اسمه بكر روى عنه يزيد بن هارون.(@)(@@)(@@)(@@) $ 825 - (@)(@@) أبو هنيدة، اسمه البراء بن نوفل عن والان.(@)(@@)(@@)(@@) $ 826 - (@)(@@) أبو الغصن، اسمه ثابت بن قيس.(@)(@@)(@@)(@@) $ 827 - (@)(@@) أبو مودود عن الحسن، اسمه بحر بن موسى.(@)(@@)(@@)(@@) $ 828 - (@)(@@) أبو الوازع سمع أبا برزة، اسمه جابر بن عمر والراسبي البصري.(@)(@@)(@@)(@@) $ 829 - (@)(@@) أبو علي الهمداني ويقال الأصبحي، اسمه ثمامة بن شفى سمع عقبة ابن عامر.(@)(@@)(@@)(@@) $ 830 - (@)(@@) أبو واقد الليثي، اسمه الحارث بن عوف المدني.(@)(@@)(@@)(@@) $ 831 - (@)(@@) أبو قتادة، اسمه الحارث بن ربعي ويقال نعمان.(@)(@@)(@@)(@@) $ 832 - (@)(@@) أبو الجودي، اسمه الحارث بن مغيرة ويقال ابن عميرة قاله مغيرة ابن سلمة عن أبي عوانة.(@)(@@)(@@)(@@) $ 833 - (@)(@@) أبو جمعة، اسمه حبيب بن وهب القاري، له صحبة.(@)(@@)(@@)(@@) $ 834 - (@)(@@) أبو عبد الرحمن الحبلي، اسمه عبد الله بن يزيد المصري.(@)(@@)(@@)(@@) $ 835 - (@)(@@) أبو عبد 
ms1667	 الرحمن، اسمه عبد الله بن حبيب.(@)(@@)(@@)(@@) $ 836 - (@)(@@) ابوالعدبس، اسمه منيع بن سليمان، روى عنه أبو بكر بن عياش.(@)(@@)(@@)(@@) $ 837 - (@)(@@) أبو سالم الحنفي، اسمه ماهان قتله الحجاج، ويقال أبو صالح ولا يصح.(@)(@@)(@@)(@@) $ 838 - (@)(@@) أبو هند الأشجعي اسمه النعمان بن أشيم، له صحبة.(@)(@@)(@@)(@@) $ 839 - (@)(@@) أبو جرى الهجيمي اسمه سليم بن جابر، له صحبة، ويقال جابر بن سليم.(@)(@@)(@@)(@@) $ 840 - (@)(@@) أبو عبد الله، اسمه سلمان مولى جهينة.(@)(@@)(@@)(@@) $ 841 - (@)(@@) أبو ثويب الفقيمي، اسمه سهل، بصري.(@)(@@)(@@)(@@) $ 842 - (@)(@@) أبو زميل الحنفي اليمامي، اسمه سماك بن الوليد.(@)(@@)(@@)(@@) $ 843 - (@)(@@) أبو محذورة القرشي اسمه سمرة بن مغيرة ويقال ابن معين.(@)(@@)(@@)(@@) $ 844 - (@)(@@) أبو نضرة الغفاري، اسمه جميل بن نضرة وكناه محمد بن مطرف ويقال.(@)(@@) PageV09P084(@)(@@) ابن حميل.(@)(@@)(@@)(@@) $ 845 - (@)(@@) أبو شيخ الهنائي البصري، اسمه حيوان بن خالد نسبه على.(@)(@@)(@@)(@@) $ 846 - (@)(@@) أبو قلابة الأزدي الحرمي، اسمه عبد الله بن زيد مات بالشام.(@)(@@)(@@)(@@) $ 847 - (@)(@@) أبو معمر الكوفى (1) صاحب ابن مسعود، اسمه عبد الله بن سنحبرة.(@)(@@)(@@)(@@) $ 848 - (@)(@@) أبو الجزل سمع عمر وعائشة، اسمه عبد الله بن شهاب.(@)(@@)(@@)(@@) $ 849 - (@)(@@) أبو طوالة، اسمه عبد الله بن عبد الرحمن بن معمر.(@)(@@)(@@)(@@) $ 850 - (@)(@@) أبو ظبيان الجنبي الكوفي سمع سلمان، اسمه حصين بن جندب.(@)(@@)(@@)(@@) $ 851 - (@)(@@) أبو خلدة السعدي التميمي البصري سمع أنسا وأبا العالية والحسن، اسمه خالد بن دينار.(@)(@@)(@@)(@@) $ 852 - (@)(@@) أبو خلدة سمع عمر وعمارا وابن مسعود، اسمه حنظلة.(@)(@@)(@@)(@@) $ 853 - (@)(@@) أبو السوار العبدري سمع عمران بن حصين، اسمه حسان بن حريث.(@)(@@)(@@)(@@) $ 854 - (@)(@@) أبو هياج الأسدي، اسمه حيان بن حصين، سمع عمار بن ياسر.(@)(@@)(@@)(@@) $ 855 - (@)(@@) أبو السمير الطائي سمع ابن عمر، اسمه حيان بن جحدة.(@)(@@)(@@)(@@) $ 856 - (@)(@@) أبو مسكين الأودي اسمه الحر.(@)(@@)(@@)(@@) $ 857 - (@)(@@) أبو عبيد صاحب سليمان بن عبد الملك، اسمه حوى.(@)(@@)(@@)(@@) $ 858 - (@)(@@) أبو الزاهرية اسمه حدير بن كريب.(@)(@@)(@@)(@@) $ 859 - (@)(@@) أبو أيوب والد سعيد بن أبي أيوب، اسمه مقلاص، سمع أبا هريرة روى عنه ابنه.(@)(@@)(@@)(@@) $ 860 - (@)(@@) أبو أيوب الأزدي العتكي عن عبد الله بن عمرو، اسمه يحيى بن مالك روى عنه قتادة.(@)(@@)(@@)(@@) $ 861 - (@)(@@) أبو داود الأودي، سمع عليا، روى عنه ابناه إدريس وداود، 
ms1668	 اسمه يزيد ابن عبد الرحمن.(@)(@@)(@@)(@@) $ 862 - (@)(@@) أبو ليلى روى عنه ابنه عبد الرحمن، اسمه يسار، له صحبة.(@)(@@)(@@)(@@) $ 863 - (@)(@@) أبو خالد الدالاني، اسمه يزيد بن عبد الرحمن، عن عمر وبن مرة. PageV09P085(@)(@@) أبو التياح الضبعي سمع أنسا، اسمه يزيد بن حميد.(@)(@@)(@@)(@@) $ 865 - (@)(@@) أبو سروعة القرشي، اسمه عقبة بن الحارث، له صحبة.(@)(@@)(@@)(@@) $ 866 - (@)(@@) أبو معد الرازي، اسمه عيسى بن ماهان سمع الربيع بن أنس.(@)(@@)(@@)(@@) $ 867 - (@)(@@) أبو السوداء النهدي، اسمه عمرو بن عمران.(@)(@@)(@@)(@@) $ 868 - (@)(@@) أبو نعامة العدوي، اسمه عمرو بن عيسى.(@)(@@)(@@)(@@) $ 869 - (@)(@@) أبو نعامة الحنفي قيس بن عباية، روى عنه الجريري.(@)(@@)(@@)(@@) $ 870 - (@)(@@) أبو الأسود الدؤلي عن على وعمر، اسمه عمر وبن سفيان بن ظالم ويقال سارق بن ظالم.(@)(@@)(@@)(@@) $ 871 - (@)(@@) أبو الجلاس، اسمه عقبة بن سنان ويقال سيار عن عثمان بن جحاش روى عنه عبد الوارث.(@)(@@)(@@)(@@) $ 872 - (@)(@@) أبو الرحال، اسمه عقبة بن عبيد.(@)(@@)(@@)(@@) $ 873 - (@)(@@) أبو اليمان الهوزني، اسمه عامر، بن عبد الله بن عامر بن لحي الشامي.(@)(@@)(@@)(@@) $ 874 - (@)(@@) أبو بردة أخو أبي موسى، اسمه عامر بن قيس مات سنة أربع ومائة.(@)(@@)(@@)(@@) $ 875 - (@)(@@) أبو إياس البجلي، اسمه عامر بن عبدة سمع ابن مسعود روى عنه المسيب ابن نافع.(@)(@@)(@@)(@@) $ 876 - (@)(@@) أبو جعدة الخطمي، اسمه عمير بن يزيد بن عمير وبن حبيب بن خماشة.(@)(@@) قال أحمد.(@)(@@)(@@)(@@) $ 877 - (@)(@@) أبو المعذل الطفاوي، اسمه عطية.(@)(@@)(@@)(@@) $ 878 - (@)(@@) أبو هاشم الزعفراني البصري اسمه عمار بن عمارة.(@)(@@)(@@)(@@) $ 879 - (@)(@@) أبو سهل الجعفي، اسمه عروة بن عبد الله بن قشير.(@)(@@)(@@)(@@) $ 880 - (@)(@@) أبو هشام الأحول، اسمه عائذ بن حبيب.(@)(@@)(@@)(@@) $ 881 - (@)(@@) أبو حكمية، اسمه عصمة سمع ابا عثمان النهدي.(@)(@@)(@@)(@@) $ 882 - (@)(@@) أبو الدرداء ; اسمه عويمر بن زيد بن قيس بن عامر بن عدي بن الحارث.(@)(@@) ابن الخزرج.(@)(@@) PageV09P086(@)(@@)(@@)(@@) $ 883 - (@)(@@) أبو إدريس الخولاني اسمه عائذ الله بن عبد الله، ولد عام حنين.(@)(@@)(@@)(@@) $ 884 - (@)(@@) أبو المقدام سمع يسار بن سلامة، اسمه غسان بن برزين (1) عن زفر المصري.(@)(@@)(@@)(@@) $ 885 - (@)(@@) أبو مالك العوذي عن قتادة، اسمه غسان بن سيار.(@)(@@)(@@)(@@) $ 886 - (@)(@@) أبو عنان سمع ابن عباس، روى عنه أبو حباب، اسمه فروخ.(@)(@@)(@@)(@@) $ 887 - (@)(@@) أبو كاهل 
ms1669	 اسمه قيس بن عائذ له صحبة، روى عنه ابن ابى خالد.(@)(@@)(@@)(@@) $ 888 - (@)(@@) أبو حرزة سمع أبا أمامة بن سهل، اسمه قيس بن سالم.(@)(@@)(@@)(@@) $ 889 - (@)(@@) أبو الدهماء، اسمه قرفة بن بيهس.(@)(@@)(@@)(@@) $ 890 - (@)(@@) أبو اليسر الأنصاري، اسمه كعب بن عمرو له صحبة.(@)(@@)(@@)(@@) $ 891 - (@)(@@) أبو المشرفي اسمه ليث.(@)(@@)(@@)(@@) $ 892 - (@)(@@) أبو رزين العقيلى اسمه لقيط بن عامر ويقال ابن صبرة بن المنتفق له صحبة.(@)(@@)(@@)(@@) $ 893 - (@)(@@) أبو العلانية اسمه مسلم.(@)(@@)(@@)(@@) $ 894 - (@)(@@) أبو حسان الأعرج اسمه مسلم.(@)(@@)(@@)(@@) $ 895 - (@)(@@) أبو نضيرة الواسطي اسمه مسلم بن عبيد الواسطي.(@)(@@)(@@)(@@) $ 896 - (@)(@@) أبو داود الأحمري اسمه مالك.(@)(@@)(@@)(@@) $ 897 - (@)(@@) أبو الرجال اسمه محمد بن عبد الرحمن الأنصاري.(@)(@@)(@@)(@@) $ 898 - (@)(@@) أبو هشام المخزومي اسمه مغيرة بن سلمة.(@)(@@)(@@)(@@) $ 899 - (@)(@@) أبو سفيان بن حرب له صحبة اسمه صخر.(@)(@@)(@@)(@@) $ 900 - (@)(@@) أبو المهلب عم أبي قلابة اسمه معاوية بن عمروويقال عبد الرحمن بن عمرو ويقال النضر بن عمرو.(@)(@@)(@@)(@@) $ 901 - (@)(@@) أبو العبيد ين السوائي اسمه معاوية بن سبرة بن حصين، كوفي(@)(@@)(@@)(@@) $ 902 - (@)(@@) أبو الجون اسمه ميمون.(@)(@@)(@@)(@@) $ 903 - (@)(@@) أبو حميد الساعدي، اسمه منذر ويقال عبد الرحمن بن سعد بن منذر. PageV09P087(@)(@@) له صحبة.(@)(@@)(@@)(@@) $ 904 - (@)(@@) أبو حليمة الأنصاري اسمه معاذ بن الحارث.(@)(@@)(@@)(@@) $ 905 - (@)(@@) أبو رياب القشيري اسمه مطرف بن مالك.(@)(@@)(@@)(@@) $ 906 - (@)(@@) أبو الوازع اسمه مجمع الأرحبي.(@)(@@)(@@)(@@) $ 907 - (@)(@@) أبو هند الأشجعي، اسمه نعمان بن أشيم.(@)(@@)(@@)(@@) $ 908 - (@)(@@) أبو عمران الجوني اسمه عبد الملك بن حبيب.(@)(@@)(@@)(@@) $ 909 - (@)(@@) أبو عمر والشبيانى اسمه سعد بن إياس.(@)(@@)(@@)(@@) $ 910 - (@)(@@) أبو هارون الغنوي اسمه إبراهيم بن العلاء.(@)(@@)(@@)(@@) $ 911 - (@)(@@) أبو هارون العبدي اسمه عمارة بن جوين.(@)(@@)(@@)(@@) $ 912 - (@)(@@) أبو الشعثاء مولى ابن معمر اسمه قنبر سماه علي.(@)(@@)(@@)(@@) $ 913 - (@)(@@) أبو الشعثاء المحاربي اسمه سليم.(@)(@@)(@@)(@@) $ 914 - (@)(@@) أبو يعلى اسمه منذر بن يعلى.(@)(@@)(@@)(@@) $ 915 - (@)(@@) أبو المهزم اسمه يزيد بن سفيان.(@)(@@)(@@)(@@) $ 916 - (@)(@@) أبو صالح ذكوان مولى جويرية بنت الحارث الغطفاني.(@)(@@)(@@)(@@) $ 917 - (@)(@@) أبو صالح باذان مولى أم هانئ صاحب التفسير.(@)(@@)(@@)(@@) $ 918 - (@)(@@) أبو صالح عبد الرحمن بن قيس الحنفي، كوفي.(@)(@@)(@@)(@@) $ 919 - (@)(@@) أبو صالح تركان مولى عثمان بن عفان.(@)(@@)(@@)(@@) $ 920 - (@)(@@) أبو صالح قيلويه روى عنه يحيى بن أبي كثير. 
ms1670	(@)(@@)(@@)(@@) $ 921 - (@)(@@) أبو صالح ميزان، روى عنه خالد الحذاء.(@)(@@)(@@)(@@) $ 922 - (@)(@@) أبو صالح عبيد مولى السفاح مدني.(@)(@@)(@@)(@@) $ 923 - (@)(@@) أبو صالح الغفاري، اسمه سعيد بن عبد الرحمن المصري.(@)(@@)(@@)(@@) $ 924 - (@)(@@) أبو صالح شعيب بن الحبحاب البصري.(@)(@@)(@@)(@@) $ 925 - (@)(@@) أبو صالح عبد الله بن صالح الجهني كاتب الليث.(@)(@@)(@@)(@@) $ 926 - (@)(@@) أبو صالح عبد الغفار بن داود الحرانى.(@)(@@) PageV09P088(@)(@@)(@@)(@@) $ 927 - (@)(@@) أبو أيوب الأنصاري، اسمه خالد بن زيد الخزرجي من بني مالك بن النجار شهد بدرا.(@)(@@)(@@)(@@) $ 928 - (@)(@@) أبو المنازل، اسمه خالد بن مهران الحذاء المصري.(@)(@@)(@@)(@@) $ 929 - (@)(@@) أبو دينار البصري سمع خليفة بن كعب.(@)(@@)(@@)(@@) $ 930 - (@)(@@) أبو جحاف التميمي الكوفي، اسمه داود بن أبي عوف.(@)(@@)(@@)(@@) $ 931 - (@)(@@) أبو العجفاء السلمي، اسمه هرم.(@)(@@)(@@)(@@) $ 932 - (@)(@@) أبو عبد الله القراظ، اسمه دينار المدني سمع أبا هريرة.(@)(@@)(@@)(@@) $ 933 - (@)(@@) أبو حازم مولى أبي رهم وهو مولى غفار هو البخاري، اسمه دينار.(@)(@@)(@@)(@@) $ 934 - (@)(@@) أبو الحوراء السعدي سمع الحسن بن علي بن أبي طالب، اسمه ربيعة بن شيبان.(@)(@@)(@@)(@@) $ 935 - (@)(@@) أبو الحلال العتكي الأزدي البصري سمع عثمان بن عفان، اسمه ربيعة ابن زرارة ويقال زرارة بن ربيعة.(@)(@@)(@@)(@@) $ 936 - (@)(@@) أبو الكميت رأى ابن عمر، اسمه راشد يعرف بحديث واحد.(@)(@@)(@@)(@@) $ 937 - (@)(@@) أبو لبابة بن عبد المنذر الأنصاري له صحبة، اسمه رفاعة بن عبد المنذر.(@)(@@)(@@)(@@) $ 938 - (@)(@@) أبو العالية البراء مولى لقريش سمع ابن عمر، اسمه زياد بن فيروز.(@)(@@)(@@)(@@) $ 939 - (@)(@@) أبو العالية الرياحي، اسمه رفيع سمع عمر بن الخطاب.(@)(@@)(@@)(@@) $ 940 - (@)(@@) أبو كثير، اسمه رفيع.(@)(@@)(@@)(@@) $ 941 - (@)(@@) أبو طلحة الانصاري، اسمه زيد بن سهل شهد بدرا.(@)(@@)(@@)(@@) $ 942 - (@)(@@) أبو عياش الزرقي، اسمه زيد بن الصامت، له صحبة.(@)(@@)(@@)(@@) $ 943 - (@)(@@) أبو الحواري العمي البصري عن أنس ومعاوية بن قرة، اسمه زيد بن الحواري.(@)(@@)(@@)(@@) $ 944 - (@)(@@) أبو القموص الجرمي ويقال العبدي، اسمه زيد بن علي.(@)(@@)(@@)(@@) $ 945 - (@)(@@) أبو إسحاق الشيباني، اسمه سليمان بن أبي سليمان.(@)(@@)(@@)(@@) $ 946 - (@)(@@) أبو داود المرهبي، اسمه سوار، روى عنه سلمة بن كهيل.(@)(@@) PageV09P089(@)(@@)(@@)(@@) $ 947 - (@)(@@) أبو بكر الهذلي عن الحسن، اسمه سلمى.(@)(@@)(@@)(@@) $ 948 - (@)(@@) أبو وائل، اسمه شقيق بن سلمة ويقال ادرك النبي صلى الله عليه وسلم لم يسمع منه.(@)(@@)(@@)(@@) $ 949 - (@)(@@) أبو 
ms1671	 مالك التميمي، اسمه سعير بن الخمس عن حبيب بن أبي ثابت، روى عنه ابن عيينة.(@)(@@)(@@)(@@) $ 950 - (@)(@@) أبو إسرائيل الخشني سمع جعدة، روى عنه سعيد، اسمه شعيب بصري.(@)(@@)(@@)(@@) $ 951 - (@)(@@) أبو الكنود اسمه عبد الله بن عمران سماه وكيع هو الأزدي.(@)(@@)(@@)(@@) $ 952 - (@)(@@) أبو بحرية، اسمه عبد الله بن قيس نسبه أبو بكر بن أبي مريم.(@)(@@)(@@)(@@) $ 953 - (@)(@@) أبو تميم الجيشاني، اسمه عبد الله بن مالك سمع عمرو اباذر وعن على.(@)(@@)(@@)(@@) $ 954 - (@)(@@) ابو الزعراء ابى اخى ابى الاحوص الجشمى، اسمه عمر وبن عمرو.(@)(@@)(@@)(@@) $ 955 - (@)(@@) أبو الزعراء سمع محل بن خليفة، روى عنه ابن مهدى، اسمه يحيى ابن الوليد.(@)(@@)(@@)(@@) $ 956 - (@)(@@) أبو زرعة بن عمرو بن جرير، اسمه هرم.(@)(@@)(@@)(@@) $ 957 - (@)(@@) أبو خالد والد سعيد بن أبي خالد، اسمه سعد.(@)(@@)(@@)(@@) $ 958 - (@)(@@) أبو خالد الوالبي، اسمه هرم.(@)(@@)(@@)(@@) $ 959 - (@)(@@) أبو مجلز، اسمه لاحق بن حميد.(@)(@@)(@@)(@@) $ 960 - (@)(@@) أبو بكر بن أبي عبد الله الربعي، سمه هشام الدستوائي وهو ابن سنبر.(@)(@@) كنيته أبو بكر.(@)(@@)(@@)(@@) $ 961 - (@)(@@) ابن أكيمة (1) الليثي، اسمه عمارة بن أكيمة، روى عنه الزهري.(@)(@@)(@@)(@@) $ 962 - (@)(@@) ابو جميلة الاعرابي والدعوف، اسمه بندوية ويقال الهجرى. PageV09P090(@)(@@)(@@)(@@) $ 963 - (@)(@@) هلب والدقبيصة، اسمه يزيد بن قنافة.(@)(@@)(@@)(@@) $ 964 - (@)(@@) أبو بزة والد القاسم، اسمه نافع يقال القاسم بن نافع.(@)(@@)(@@)(@@) $ 965 - (@)(@@) أبو حازم عن ابن عباس، روى عنه ابن أبي خالد اسمه نبتل.(@)(@@)(@@)(@@) $ 966 - (@)(@@) أبو ريحانة، اسمه عبد الله.(@)(@@)(@@)(@@) $ 967 - (@)(@@) أبو يعفور، اسمه عبد الرحمن بن عبيد بن نسطاس، سمع أباه وإبراهيم.(@)(@@)(@@)(@@) $ 968 - (@)(@@) أبو إمامة الباهلي، اسمه صدى بن عجلان.(@)(@@)(@@)(@@) $ 969 - (@)(@@) أبو رجاء العطاردي اسمه عمران بن ملحان كان فر من النبي صلى الله عليه وسلم ثم أسلم بعد الفتح.(@)(@@)(@@)(@@) $ 970 - (@)(@@) أبو نهار الأزدي العوذي، اسمه عقبة بن عبد الغافر قال يحى مات سنة.(@)(@@) ثلاث وثمانين في الجماجم.(@)(@@)(@@)(@@) $ 971 - (@)(@@) أبو نضرة اسمه المنذر بن مالك بن قطعة.(@)(@@)(@@)(@@) $ 972 - (@)(@@) أبو حمزة القصاب الأعور التمار عن إبراهيم، روى عنه الثوري، اسمه ميمون.(@)(@@)(@@)(@@) $ 973 - (@)(@@) أبو حمزة الواسطي سمع ابن عباس، اسمه عمران بن أبي عطاء.(@)(@@)(@@)(@@) $ 974 - (@)(@@) أبو حمزة السكوني اسمه محمد بن 
ms1672	 ميمون المروزي.(@)(@@)(@@)(@@) $ 975 - (@)(@@) أبو جمرة الضبعي اسمه نصر بن عمران البصري سمع ابن عباس(@)(@@)(@@)(@@) $ 976 - (@)(@@) أبو مرثد الغنوي، اسمه كناز بن الحصين له صحبة.(@)(@@)(@@)(@@) $ 977 - (@)(@@) أبو موسى الغافقي، اسمه مالك بن عبادة له صحبة.(@)(@@)(@@)(@@) $ 978 - (@)(@@) أبو صرمة المازني له صحبة، اسمه مالك بن قيس.(@)(@@)(@@)(@@) $ 979 - (@)(@@) أبو مريم الذي روى عنه ابنه يزيد بن ابى مريم له صحبة، اسمه مالك ابن ربيعة السلولي.(@)(@@)(@@)(@@) $ 980 - (@)(@@) أبو سهيل بن مالك عم مالك بن أنس، اسمه نافع بن مالك(@)(@@)(@@)(@@) $ 981 - (@)(@@) أبو لينة، اسمه النضر بن أبي مريم.(@)(@@)(@@)(@@) $ 982 - (@)(@@) أبو بكرة نفيع بن الحارث له صحبة.(@)(@@) PageV09P091(@)(@@)(@@)(@@) $ 983 - (@)(@@) أبو معشر البراء، اسمه يوسف بن يزيد بصري.(@)(@@)(@@)(@@) $ 984 - (@)(@@) أبو معشر الكوفي عن إبراهيم، اسمه زياد بن كليب.(@)(@@)(@@)(@@) $ 985 - (@)(@@) أبو معشر السندي عن محمد بن كعب ونافع منكر الحديث، اسمه نجيح.(@)(@@)(@@)(@@) $ 986 - (@)(@@) أبو برزة الأسلمي، اسمه نضلة بن عبيد، له صحبة.(@)(@@)(@@)(@@) $ 987 - (@)(@@) أبو معبد مولى ابن عباس سمع ابن عباس، روى عنه عمر وبن دينار.(@)(@@) اسمه نافد.(@)(@@)(@@)(@@) $ 987 - (@)(@@) أبو ظلال القسملي الأعمى سمع أنس بن مالك اسمه هلال.(@)(@@)(@@)(@@) $ 989 - (@)(@@) أبو بردة ابن نيار، اسمه هانئ بن نيار له صحبة.(@)(@@)(@@)(@@) $ 900 - (@)(@@) أبو صالح ميسرة عن علي، روى عنه عطاء بن السائب.(@)(@@)(@@)(@@) $ 991 - (@)(@@) أبو هاشم الرماني واسطي سمع أبا العالية، اسمه يحيى بن دينار.(@)(@@)(@@)(@@) $ 992 - (@)(@@) أبو جعفر محمد بن النوشجان من أهل بغداد السويدي وإنما قيل السويدي لأنه رحل (1) إلى سويد بن عبد العزيز.(@)(@@)(@@)(@@) $ 993 - أبو المهري خالد بن مخلد.(@)(@@) (2) اسم مسطح بن أثاثة عوف بن أثاثة بن عباد.(@)(@@)(@@)(@@) | (الكنى من النساء) (@)(@@) واسم أم هانئ بنت أبي طالب هند وقال بعضهم اسمها فاختة، اسم أم سلمة هند بنت أبي أمية وأبو أمية اسمه سهل، اسم أم حبيبة رملة، اسم أم الفضل أم ابن عباس لبابة بنت الحارث الهلالية، اسم أم خالد بنت خالد بن سعيد أمة بنت خالد.(@)(@@) اسم أم عطبية نسيبة، اسم ام الدرداء السغرى هجيمة وقال بعضهم جهيمة بنت حيي الوصابية، وأم الدرداء الكبرى خيرة بنت أبي حدرد. 
ms1673	(@)(@@) ه تم وكمل ولله الحمد. PageV09P092(@)(@@)(@@)(@@) |PARATEXT|(@)(@@) هذا آخر كتاب التاريخ الكبير على حروف المعجم وفى آخر من الكنى على ذلك وذكر من غلبت كنيته على اسمه.(@)(@@) تصنيف ابى عبد الله محمد بن اسمعيل بن المغيرة الجعفي البخاري الحافظ رحمه الله تعالى آمين.(@)(@@) وكان الفراغ من كتابة هذا الجزء نهار السبت شهر رمضان المعظم من شهور الف ومائة وواحد على يد الفقير ... (1) الدار كتبه لنفسه ولمن شاء الله تعالى من بعده وكتبته من نسخة بخط مغربي تاريخ كتابتها في شهر رمضان من سنة خمس عشرة واربعمائة وفيها سقم وتحريف كثير أصلحت ما قدرت عليه بعد المراجعة والتأمل وما لم افهمه علمت عليه بصورة -(@)(@@) 2 - (@)(@@) وقبالها في الهامش مثلها ولم أجد نسخة غيرها وعندي من هذا التاريخ جزء من الشين من باب شعبة إلى آخر عمر ومن حرف العين ويليه باب عيسى يسر الله اكماله آمين. PageV09P093(@)(@@)(@@)(@@) |EDITOR|(@)(@@) البحت عن كتاب الكنى للامام البخاري.(@)(@@) بقلم الاستاذ الفاضل الناقد في الرجال الشيخ عبد الرحمن بن يحيى اليماني دام فضله الحمدالله الذى لا تحصى نعمه ولا يتناهى جوده وكرمه وأشهد ان الااله الا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله صلى الله وسلم وبارك عليه وعلى آله وصحبه.(@)(@@) اما بعد فان جمعيتنا العلمية دائرة المعارف العثمانية لما اعتزمت طبع الكتاب الجليل التاريخ الكبير للامام ابى عبد الله محمد بن اسمعيل البخاري رحمه الله(@)(@@) تعالى ظفرت بالجزء الرابع منه في الخزانة الآصفية بحيدر آباد الدكن فسارعت إلى استنساخه ثم بعد البحث والتنقيب علم بأن في بعض مكاتب اسلامبول نسخة من الكتاب وفى المكتبة المصرية نسخة اخرى فاستحصلت الجميعة على صور ما خوذة منها وعند المقابلة تبين ان المصرية منقولة عن الاسلامبولية.(@)(@@) ووجد في آخر المجلد الرابع من النسخة الآصفية زيادة مشتملة على الكنى لا توجد في الاسلامبولية مع ان في آخر الاسلامبولية ما لفظه.(@)(@@) " كمل جميع كتاب التاريخ الكبير ... " وذلك صرييح في ان ابواب الكنى المتصلة بآخر النسخة الآصفية كتاب مستقل عن التاريخ. 
ms1674	(@)(@@) ولكن الذى تبين لنا بامعان النظر أن هذا الجزء المشتمل على الكنى تأليف البخاري قطعا وانه ان لم يكن قطعة من التاريخ فهو تتمة له فان ابن ابى حاتم مع اقتقائه في ترتيب كتابه اثر البخاري في التاريخ غالبا قال في اواخره " باب ذكر من روى عنه العلم ممن عرف بالكنى ولا يسمى " ثم اقتفى في الترتيب اثر البخاري في هذا الجزء غالبا وربما سماه كقوله " أبو المعلى بن رؤبة كذا قال البخاري.(@)(@@) PageV09P094(@)(@@) في كتابه ... " وراجع رقم (685) من هذا الجزء ووجدنا ابن عبد البرفى الكنى من الاستيعاب ربما نقل عن هذا الجزء فيما يظهر كقوله في الترجمة الرابعة من باب الخاء من كنى الاستيعاب " أبو خالد ذكره البخاري قال قال وكيع عن الأعمش عن مالك بن الحارث عن أبي خالد وكانت له صحبة قال وفدنا إلى عمر رضى الله عنه ففضل اهل الشام " وتجد هذه العبارة بتغيير يسير في الترجمة رقم 224 من هذا الجزء.(@)(@@) وقد نقل ابن حجر في كتبه كثير اعنها تارة يسميها " الكنى المفردة " وتارة " الكنى المجردة " قال في ترجمة ابى حريزة " ذكره البخاري في الكنى(@)(@@) المفردة واورد له من طريق هشيم عن ابى اسحاق الكوفى وهو الشيباني عن ابى حريزة " فان نحو هذا تجد في هذا الجزء في ترجمة ابى حريزة رقم 204.(@)(@@) وقال في ترجمة ابى سلالة " قال أبو عمر تبعا لابي حاتم حديثه عند حكام ابن مسلم عن عنبسة بن سعيد عن عاصم بن عبيد الله عن عبد الله بن عبد الله عنه " وهذا ما خوذ من كلام البخاري في الكنى المفردة راجع ترجمة ابى سلالة في هذا الجزء رقم (356) وانظر ترجمة ابى نجيح العبسى في الاصابة وفيها عن البخاري انه ذكره " في الكنى المفردة " وترجمته وفى هذا الجزء رقم (833) وفى تهذيب التهذيب ((@)(@@) 12 - 161 (@)(@@) ) أو عبيدة عن انس في القراءة في الظهر وعنه سفيان بن حسين ذكره البخاري في الكنى المجردة " راجع رقم (448) في هذا الجزء.(@)(@@) وفى تعجيل المنفعة ص 507 " أبو على الكاهلى 
ms1675	 عن ابى موسى الاشعري ذكره الحاكم ابو احمد فيمن لم يسمه ونقل ذلك عن البخاري في الكنى المجردة " وراجع رقم (453) في هذا الجزء وربما اقتصر على قوله " كتاب الكنى " أو الكنى " أو " ذكره البخاري " فقط ويظهر من مواضع في كلامه انه وقف على هذا الكتاب وفى مواضع انما ينقل عنه بواسطة كتاب الكنى للحاكم ابى.(@)(@@) PageV09P095(@)(@@) احمد كأنه كان في نسخته نقص.(@)(@@) وقد عد في مقدمة الفتح تصانيف البخاري إلى ان قال " وكتاب الكنى وذكره الحاكم ابو احمد ونقل منه " المقدمة طبعة ميرية ص 493 وفى تهذيب التهذيب (5 - 358) في ترجمة عبد الله ابن فيروز " قال أبو أحمد الحاكم في الكنى قال مسلم ابو بشر - يعنى بالمعجمة قال - وقد بينا ان ذلك خطأ اخطأ فيه مسلم وغيره وخليق ان يكون محمد - يعنى البخاري قد اشتبه عليه مع جلالته فلما نقله مسلم من كتابه تابعه عليه ومن تأمل كتاب مسلم في الكنى علم انه منقول من كتاب محمد وحذو القذة(@)(@@) بالقذة وتجلد في نقله حق الجلادة إذ لم ينسبه إلى قائله والله يغفر لنا وله ".(@)(@@) اقول لكن السخاوى وغيره ذكروا ان كتاب الكنى لمسلم خاص بكنى من عرفت اسماؤهم راجع فتح المغيث ص 424 وغالب هذا الجزء في كنى من لم تعرف اسماؤهم ثم ظهر لى ان كتاب مسلم في الكنى معظمه فيمن عرفت اسماؤهم واقله فيمن لم تعرف اسماؤهم فقد نقل عنه ذكر من لم يعرف اسمه ففى ترجمة ابى خيرة من التعجيل " خفى ذلك على البخاري وعلى من تبعه كمسلم والحاكم ابى احمد وغيرهم فذكروه فيمن لا يعرف اسمه " التعجيل ص 482.(@)(@@) وفى تهذيب التهذيب فيمن كنيته أبو عمر " ويؤيد ذلك ان مسلما وغيره ذكر والصيني فيمن لا يعرف اسمه " - ج 12 ص 177.(@)(@@) وفيه في ترجمة ابى عمران الانصاري " قال الحاكم ابو احمد اخرجه محمد بن اسمعيل في التاريخ في باب سليم وباب سليمان وهو بسليمان اشبه وكأنه غلط في نقله فأسقط النون وربما يقع له الخطأ لا سيما في الشاميين 
ms1676	 ونقله مسلم في كتابه قتابعه على خطائه " تهذيب (12 - 185) .(@)(@@) أقول فقول الحاكم أبي أحمد , , ومن تأمل كتاب مسلم في الكنى علم انه منقول من كتاب محمد،، يعنى البخاري اراد بكتاب البخاري التاريخ(@)(@@) PageV09P096(@)(@@) مع هذا الجزء من الكنى، نقل مسلم كنى من عرفت اسماؤهم من التاريخ كنى من لم تعرف اسماؤهم من هذا الجزء وقد علمت تسمية الحافظ ابن حجر لهذا الجزء " الكنى المفردة " أو " الكنى المجردة " والاسم الاول يقتضى انها ليست من التاريخ لان معناه الكنى المفردة عن التاريخ كما سموا كتاب الادب للمؤلف " الادب المفرد " يريدون المفرد عن الجامع الصحيح.(@)(@@) والاسم الثاني(@)(@@) محتمل والظاهر ان معناه الكنى المجردة عن الاسماء أي انها فيمن لم تعرف الا كنيته مجردة عن الاسم وذلك بالنظر إلى الغالب.(@)(@@) وبالجملة فعبارة الحاكم ابى احمد " علم انه منقول من كتاب محمد " واراد ما يشمل اصل التاريخ وهذا الجزء مع ما يدل عليه صنيع ابن ابى حاتم كما تقدم ظاهر في ان هذا الجزء ان لم يكن من التاريخ فهو تتمة له والله اعلم.(@)(@@) PageV09P097(@)(@@) خاتمة الطبع قد تم بحمد الله ومنه طبع كتاب الكنى للإمام البخاري رحمه الله تعالى.(@)(@@) وكان الطبع بمطبعة الجمعية العلمية الشهيرة بدائرة المعارف العثمانية بعاصمة الدولة الآصفية حيدر آباد الدكن ادامها مصونة عن الفتن والمحن في ظل الملك المؤيد المعان، الذى اشتهر فضله في كل مكان، حضرة جلالة الملك(@)(@@) السلطان بن السلطان سلطان العلوم مظفر الممالك آصف جاه السابع مير عثمان على خان بهادر لا زالت مملكته بالعز والبقاء، دائمة التقدم والارتقاء، واطال الله عمر ولى عهده الاعظم النواب اعظم جاه بهادر وابنه المعظم النواب معظم جاه بهادر.(@)(@@) وهذه الجمعية تحت صدارة ذى الفضائل السنية والمفاخر العلية النواب السير حيدر نواز جنگ بهادر رئيس الجمعية ورئيس الوزراء في الدولة الآصفية، والعالم العامل بقية الافاضل النواب محمد يار جنگ بهادر، وتحت اعتماد الماجد الاريب الشريف النسيب النواب مهدى يارجنگ بهاد عميد الجمعية ووزير المعارف والمالية في الدولة الآصفية ومعين امير الجامعة العثمانية والنواب 
ms1677	 ناظر يار جنگ بهادر شريك العميد واحد اعضاء العدلية، وضمن ادارة العالم المحقق والفاضل مدقق مولانا السيد هاشم الندوى معين عميد الجمعية ومدير دائرة المعارف ادام الله تعالى درجاتهم سامية ومحاسنهم زاكية.(@)(@@) وعنى بتصحيحه من افاضل دائرة المعارق وعلمائها مولانا السيد هاشم الندوى ومولانا الشيخ عبد الرحمن اليماني، ومولانا السيد احمد الله الندوى والشيخ الحمد بن محمد اليماني، وطبع بعد ملاحظة مولانا العالمة عبد الله العمادى عضو شرف لجمعية دائرة المعارف غفر الله ذنوبهم وستر عيوبهم وكان تمامه يوم الاحد السادس والعشرين من شهر جمادى الاولى سنة 1360 ه وآخر دعوانا ان الحمدالله رب العالمين وصلى الله وسلم على سيدنا ومولانا محمد نبيه الامين وعلى آله وصحبه الطيبين الطاهرين إلى يوم الدين. PageV09P098 
