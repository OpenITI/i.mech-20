ms2481	 عن الحسن بن ذكوان وعنه رواد بن الجراح مجهول.(@)(@@)(@@)(@@) | 3429 - (@)(@@) " عامر " بن عبدة4 البجلي أبو إياس الكوفي عن ابن مسعود تفرد عنه المسيب بن رافع.(@)(@@)(@@)(@@) | 3430 - (@)(@@) " عامر " بن عبد الواحد الأحول البصري.(@)(@@)(@@)(@@) | 3431 - (@)(@@) " عامر " بن مالك بصري عن صفوان ابن أمية وعنه أبو عثمان النهدي PageV07P254(@)(@@) وثقه بن حبان.(@)(@@)(@@)(@@) | 3432 - (@)(@@) " عامر " العقيلي وهو ابن عبد الله أو بن عقبة تقدم.(@)(@@)(@@)(@@) | 3433 - (@)(@@) " عامر " أبو رملة شيخ لابن عون عن مخنف وعنه ابن عون.(@)(@@) PageV07P255(@)(@@)(@@)(@@) | من اسمه عائذ وعائذ الله وعابس(@)(@@)(@@)(@@) | 3434 - (@)(@@) " عائذ " بن حبيب بن الملاح1 أبو أحمد الكوفي في بياع الهروي عن حميد الطويل وأبي حنيفة رحمهما الله تعالى.(@)(@@)(@@)(@@) | 3435 - (@)(@@) " عائذ الله" المجاشعي أبو معاذ قاضي سليمان ابن عبد الملك.(@)(@@)(@@)(@@) | 3436 - (@)(@@) " عابس "2 بن أنس البكري الكوفي عنه عطاء فقط. PageV07P255(@)(@@)(@@)(@@) | من اسمه عباد(@)(@@)(@@)(@@) | 3437 - (@)(@@) " عباد " بن آدم الهذلي البصري عن شعبة وعنه ابنه محمد فقط.(@)(@@)(@@)(@@) | 3438 - (@)(@@) " عباد " بن حبيش3 الكوفي.(@)(@@)(@@)(@@) | 3439 - (@)(@@) " عباد " بن راشد التميمي البصري البزار آخره مهملة قريب داود بن أبي هند عن الحسن.(@)(@@)(@@)(@@) | 3440 - (@)(@@) " عباد4 " بن زياد عن أبيه الأمير أبو حرب.(@)(@@)(@@)(@@) | 3441 - (@)(@@) " عباد " بن أبي سعيد المقبري عن أبي هريرة وعنه اخوه سعيد. PageV07P255(@)(@@)(@@)(@@) | 3442 - (@)(@@) " عباد " بن أبي صالح السمان المدني ويقال: له عبد الله بن أبي صالح عن أبيه.(@)(@@)(@@)(@@) | 3443 - (@)(@@) " عباد " بن عباد بن حبيب بن المهلب بن أبي صفرة العتكي الأزدي أبو معاوية البصري.(@)(@@)(@@)(@@) | 3444 - (@)(@@) " عباد " بن عباد الرملي الارسوفي أبو عتبة الخواص الزاهد1.(@)(@@)(@@)(@@) | 3445 - (@)(@@) " عباد " بن عبد الله الأسدي الكوفي عن علي رضى الله عنه.(@)(@@)(@@)(@@) | 3446 - (@)(@@) " عباد " بن كثير الثقفي البصري العابد نزيل مكة عنه إبراهيم بن أدهم وأبو نعيم رحمة الله عليهما.(@)(@@)(@@)(@@) | 3447 - (@)(@@) " عباد " بن ليث الكرابيسي أبو الحسن القيسي البصري.(@)(@@)(@@)(@@) | 3448 - (@)(@@) " عباد " بن منصور الناجي أبو سلمة البصري القاضي بها.(@)(@@)(@@)(@@) | 3449 - (@)(@@) " عباد " بن موسى بن راشد العكلي المعروف بسند ولا عن عمارة وأبي معشر وعنه ابنه محمد فقط قلت: وعيسى بن يونس.(@)(@@)(@@)(@@) | 3450 - (@)(@@) " عباد " بن موسى الجهني عن أبيه وعنه عبد الله بن داود 
ms2482	 الخريبي وحده قلت: وثقه بن حبان وقد روى عنه أيضا أبو عاصم النبيل.(@)(@@)(@@)(@@) | 3451 - (@)(@@) " عباد " بن أبي موسى الحجازي عن رجل يقال: له سليم عن ميمونة قال البخاري: إسناد مجهول وعنه يحيى بن سليم.(@)(@@)(@@)(@@) | 3452 - (@)(@@) " عباد " بن ميسرة التميمي المنقري البصري المعلم عن الحسن.(@)(@@)(@@)(@@) | 3453 - (@)(@@) " عباد " بن أبي يزيد أو بن يزيد الكوفي عن علي وعنه إسماعيل السدي.(@)(@@)(@@)(@@) | 3454 - (@)(@@) " عباد " بن يعقوب الأسدي الرواجني2 أبو سعيد الكوفي الرافضي.(@)(@@)(@@)(@@) | 3455 - (@)(@@) " عباد " بن يوسف ويقال: ابن سعد كوفي عن أبي بردة ويقال: اسمه عبادة.(@)(@@)(@@)(@@) | 3456 - (@)(@@) " عباد " السماك عن الثوري وعنه قبيصة حكاية. PageV07P256(@)(@@)(@@)(@@) | من اسمه عبادة(@)(@@)(@@)(@@) | 3457 - (@)(@@) " عبادة " بن مسلم الفزاري أبو يحيى البصري.(@)(@@)(@@)(@@) | 3458 - (@)(@@) " عبادة " بن يوسف أو بن سعيد عن أبي بردة وعنه إسماعيل بن إبراهيم بن مهاجر.(@)(@@) PageV07P257(@)(@@)(@@)(@@) | من اسمه عباس وعباءة(@)(@@)(@@)(@@) | 3459 - (@)(@@) " العباس " بن الحسين القنطري1 البغدادي أو البصري.(@)(@@)(@@)(@@) | 3460 - (@)(@@) " العباس " بن عثمان ابن شافع المطلبي جد الإمام الشافعي عنه ابنه محمد.(@)(@@)(@@)(@@) | 3461 - (@)(@@) " العباس " بن الفضل عمرو بن عبيد بن حنظلة بن رافع الأنصاري الواقفي2 أبو الفضل البصري الموصلي وقاضيها المقري.(@)(@@)(@@)(@@) | 3462 - (@)(@@) " العباس " بن الفضل بن العباس بن يعقوب أبو عثمان الأزرق البصري من اقران عفان روى عنه عباس الدوري وغيره كذبه بن معين.(@)(@@)(@@)(@@) | 3463 - (@)(@@) " العباس " بن الفضل العدني نزيل البصرة شيخ لأبي حاتم عن حماد بن سلمة قال أبو حاتم: شيخ.(@)(@@)(@@)(@@) | 3464 - (@)(@@) " العباس " بن الوليد بن نصر النرسي3 أبو الفضل البصري روى عنه البخاري ومسلم.(@)(@@)(@@)(@@) | 3465 - (@)(@@) " العباس " بن الوليد بن صبح4 الخلال أبو الفضل الدمشقي السلمي. PageV07P257(@)(@@)(@@)(@@) | 3466 - (@)(@@) " العباس " بن يزيد بن حبيب البحراني1 أبو الفضل يلقب عباسويه بلفظ عباس وزيادة ويه ويعرف بالعبدي كان قاضي همدان.(@)(@@)(@@)(@@) | 3467 - (@)(@@) " عباءة "2 بن كليب الليثي أبو غسان الكوفي. PageV07P258(@)(@@)(@@)(@@) |