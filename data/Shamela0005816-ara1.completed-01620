ms1601	 أنس يروي عن أبيه روى عنه مهدى بن ميمون(@)(@@)(@@)(@@) $ 14702 - عاصم بن حكيم أبو محمد يروي عن يحيى بن أبي عمرو السيباني PageV08P505 روى عنه بن وهب وأيوب بن سويد(@)(@@)(@@)(@@) $ 14703 - عاصم بن سيار الرقاشي يروي عن كثير عن بن المسيب روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 14704 - عاصم بن مهجع الأسدي يروي عن مالك بن أنس روى عنه العباس بن عبد العظيم العنبري(@)(@@)(@@)(@@) $ 14705 - عاصم بن يوسف اليربوعي التميمي كنيته أبو عمر من أهل الكوفة يروي عن قطبة بن عبد العزيز والكوفيين روى عنه إبراهيم بن يعقوب الجوزجاني(@)(@@)(@@)(@@) $ 14706 - عاصم بن يزيد العمرى يروى عن بن عيينة وسليم بن مسلم روى عنه محمد بن مسلم بن مبارك ربما أغرب(@)(@@)(@@)(@@) $ 14707 - عاصم بن علي بن عاصم أبو الحسن يروي عن شعبة وابن أبي ذئب روى عنه أبو زرعة الرازي مات سنة إحدى وعشرين ومائتين(@)(@@)(@@)(@@) $ 14708 - عاصم بن النضر الأحول من أهل البصرة يروي عن المعتمر بن سليمان والبصريين حدثنا عنه عبدان بمعسكر مكرم وغيره من شيوخنا(@)(@@)(@@)(@@) $ 14709 - عاصم بن عباس الهذلي من أهل البصرة يروي عن عبد الوهاب PageV08P506 الثقفي روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 14710 - عاصم بن عمر بن علي المقدمي يروي عن أبيه ثنا أبو يعلى ثنا عاصم بن عمر بن علي بن مقدم فذكر حدثنا(@)(@@)(@@)(@@) $ 14711 - عتبة بن ضمرة بن حبيب بن صهيب الزبيدي من أهل الشام يروي عن أبيه روى عنه أحمد بن أبي يافع الموصلي(@)(@@)(@@)(@@) $ 14712 - عتبة بن أبان بن صمعة الذي يعرف بعتبة الغلام من عباد أهل البصرة وقرائهم له حكايات عجيبة في الرقائق يروي عن عبد الواحد بن زيد وشميط بن عجلان روى عنه أهل البصرة ما له حديث مسند يرجع إليه(@)(@@)(@@)(@@) $ 14713 - عتبة أبو أمية الدمشقي يروي عن معاوية روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 14714 - عتبة بن تميم التنوخي يروي عن الوليد بن عامر اليزني روى عنه إسماعيل بن عياش(@)(@@)(@@)(@@) $ 14715 - عتبة بن عبد الله بن خالد بن معدان يروي عن أبيه عن جده روى عنه 
ms1602	 بقية بن الوليد(@)(@@)(@@)(@@) $ 14716 - عتبة بن عبد الملك السهمي يروي عن زرارة بن كريم روى PageV08P507 عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 14717 - أبو خليد اسمه عتبة بن حماد الحكمى القارىء إمام مسجد دمشق يروي عن الأوزاعي والزبيدي روى عنه هشام بن خالد الأزرق وأهل الشام(@)(@@)(@@)(@@) $ 14718 - عتبة بن علي بن مسلم أبو الحسن السكوني من أهل حمص كان في سوق البز بها يروي عن معاوية بن يحيى الصدفي روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 14719 - عتبة بن السكن من أهل الشام يروي عن الأوزاعي روى عنه عمران بن بكار الحمصي وموسى بن سهل الرملي يخطىء ويخالف(@)(@@)(@@)(@@) $ 14720 - عتبة بن سعيد بن حبان الرحض من أهل حمص يروي عن إسماعيل بن عياش والشاميين روى عنه إبراهيم بن سعيد الجوهري وعثمان بن سعيد الدارمي(@)(@@)(@@)(@@) $ 14721 - عتبة بن عبد الله بن عتبة اليحمدي أبو عبد الله من أهل مرو يروي عن مالك بن أنس وأبى غانم يونس بن نافع حدثنا عنه إسحاق بن إبراهيم بن إسماعيل وغيره من شيوخنا PageV08P508(@)(@@)(@@)(@@) $ 14722 - عياش بن يونس أبو معاذ الشامي يروي عن نمران بن عتبة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 14723 - عياش بن الوليد أبو الوليد الرقام من أهل البصرة يروي عن عبد الأعلى بن عبد الأعلى والبصريين روى عنه محمد بن يحيى الذهلي والبخاري محمد بن إسماعيل(@)(@@)(@@)(@@) $ 14724 - عمير بن عبد الرحمن يروي عن عمرو بن عبد العزيز روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 14725 - عمير بن عبد المجيد أبو المغيرة الحنفي من أهل البصرة يروي عن شعبة روى عنه أهل العراق وهو أخو أبي بكر وأبى على الحنفيين(@)(@@)(@@)(@@) $ 14726 - عمير بن عمار الصائدي يروي عن إبراهيم بن سعد روى عنه الكوفيون(@)(@@)(@@)(@@) $ 14727 - عمير بن مرداس الزريقي من نهاوند يروي عن أبي نعيم وأهل العراق روى عنه أهل بلده يغرب(@)(@@)(@@)(@@) $ 14728 - عباس بن غزوان يروي عن عمر بن عبد العزيز روى عنه ضمرة بن ربيعة(@)(@@)(@@)(@@) $ 14729 - عباس بن أبي شملة مولى طلحة بن عمر بن عبيد الله بن معمر 
ms1603	 PageV08P509 التيمى يروى عن موسى بن يعقوب الزمعي ومالك بن أنس كنيته أبو الفضل من أهل المدينة روى عنه إبراهيم بن المنذر الحزامي(@)(@@)(@@)(@@) $ 14730 - عباس بن جعفر بن طلق بن زيد الشني العبدي من أهل البصرة روى عن أبيه روى عنه نصر بن علي الجهضمي(@)(@@)(@@)(@@) $ 14731 - عباس بن طالب الأزدي البصري أبو الفضل سكن مصر يروي عن حماد بن زيد روى عنه محمد بن داود بن ناجية وأهل مصر مات سنة سبع عشرة ومائتين(@)(@@)(@@)(@@) $ 14732 - عباس بن الوليد أبو الفضل البصري يروي عن شعبة وهمام روى عنه صالح بن زياد السوسي أبو شعيب وعمر بن عثمان الحمصي(@)(@@)(@@)(@@) $ 14733 - عباس بن الوليد بن حماد القرشي أبو الفضل من أهل البصرة يروي عن يحيى بن سعيد والبصريين حدثنا عنه الحسن بن سفيان وأبو يعلى وهو بن أخي عبد الأعلى بن حماد النرسي(@)(@@)(@@)(@@) $ 14734 - عباس بن الفضل الأزرق العبدي من أهل البصرة يروي PageV08P510 عن السرى بن يحيى روى عنه يعقوب بن سفيان يخطىء ويخالف(@)(@@)(@@)(@@) $ 14735 - عباس بن الفضل القيسي من أهل البصرة يروي عن عبد الوهاب بن سعيد والبصريين روى عنه أحمد بن منصور الرمادي(@)(@@)(@@)(@@) $ 14736 - عباس بن الحسين البغدادي يروي عن مبشر بن إسماعيل والشاميين روى عنه محمد بن إسماعيل مات قريبا من سنة أربعين ومائتين(@)(@@)(@@)(@@) $ 14737 - عباس بن عثمان البجلي أبو الفضل المكتب من أهل دمشق يروي عن عراك بن خالد عن إبراهيم بن أبي عبلة حدثنا عنه عمرو بن سعيد بن سنان الطائي وغيره مات سنة تسع وثلاثين ومائتين ربما خالف(@)(@@)(@@)(@@) $ 14738 - عباس بن عبد العظيم العنبري أبو الفضل من أهل البصرة يروي عن يزيد بن هارون وعبد الرزاق حدثنا عنه إسحاق بن إبراهيم القاضي وغيره مات سنة ست وأربعين ومائتين وكان من عقلاء الناس(@)(@@)(@@)(@@) $ 14739 - عباس بن الفضل بن أبي روح الحلبي يروي عن أسباط بن محمود وابن نمير حدثنا عنه بن ناجية مات بحران سنة إحدى وستين ومائتين(@)(@@)(@@)(@@) $ 14740 - عباس بن يزيد بن أبي حبيب البحراني أبو الفضل عداده 
ms1604	 في PageV08P511 أهل البصرة يعرف ب عباسويه وكان على القضاء بهمدان يروي عن بن عيينة وابن أبي عدى وابن علية والبصريين حدثنا عنه علي بن أحمد بن سعيد وغيره ربما أخطأ(@)(@@)(@@)(@@) $ 14741 - عباس بن الضحاك أبو الفضل من أهل بلخ يروي عن مكي بن إبراهيم روى عنه أهل بلده(@)(@@)(@@)(@@) $ 14742 - عباس بن محمد بن يونس من أهل بلخ يروي عن المكي بن إبراهيم روى عنه أهل بلده(@)(@@)(@@)(@@) $ 14743 - عباس بن بكار من أهل البصرة كنيته أبو الوليد يروي عن أبي بكر الهذلي وأهل البصرة يروي عنه محمد بن زكريا العلاني وغيره من أهل بلده مات بالبصرة وهو بن ثلاث وتسعين سنة وكان يغرب حديثه عن الثقات لا بأس به(@)(@@)(@@)(@@) $ 14744 - عباس بن الوليد بن صبح السلمي من أهل دمشق يروي عن عبد الجبار بن عطاء عن معمر مستقيم الأمر في الحديث حدثنا عنه الحسين بن سفيان وغيره(@)(@@)(@@)(@@) $ 14745 - عباس بن الوليد بن مزيد العذري أبو الفضل من أهل بيروت يروي عن شعيب بن إسحاق ومحمد بن شعيب بن شابور حدثنا عنه مكحول وغيره وكان من خيار عباد الله المتقنين في الروايات PageV08P512 كان مولده في رجب سنة تسع وستين ومائة ومات سنة سبعين ومائتين(@)(@@)(@@)(@@) $ 14746 - عباس بن إسماعيل المقرىء من أهل بغداد سكن الشام يروي عن علي بن مسهر روى عنه أهل الجزيرة(@)(@@)(@@)(@@) $ 14747 - عباس بن عبد الله الترقفي أبو الفضل الباكسائي يروي عن يزيد بن هارون ثنا عنه عبد الله بن قحطبة وغيره(@)(@@)(@@)(@@) $ 14748 - عباس بن الفضل الرياشي أبو الفضل من أهل البصرة يروي عن أبي عاصم وكان راويا للأصمعي حدثنا عنه إسحاق بن إبراهيم القاضي وغيره مستقيم الحديث(@)(@@)(@@)(@@) $ 14749 - عباس بن محمد بن حاتم بن واقد الدوري أبو الفضل من أهل بغداد يروي عن الأنصاري وعبيد الله بن موسى حدثنا عنه محمد بن المنذر بن سعيد وغيره مات سنة إحدى وسبعين ومائتين ببغداد(@)(@@)(@@)(@@) $ 14750 - عباس بن أبي طالب أبو محمد من أهل بغداد يروي عن أبي عاصم وأبى نعيم حدثنا 
ms1605	 عنه محمد بن إسحاق بن إبراهيم الثقفي واسم أبي طالب جعفر بن الزبرقان البزار(@)(@@)(@@)(@@) $ 14751 - عباس بن سفيان الدبوسي يروي عن الفضيل بن عياض الحكايات PageV08P513 روى عنه عبد الله بن عبد الرحمن الدارمي السمرقندي ما أراه سمع من الفضيل وذاك أنه أدخل بينه وبين الفضل الحسن بن جعفر البخاري فإن صح سماعه من الفضيل فهو من هذه الطبقة وإلا تحول إلى الطبقة الخامسة(@)(@@)(@@)(@@) $ 14752 - عباس بن صالح بن علي بن مساور مولى بني أمية من أهل حران يروي عن أبي نعيم حدثنا عنه أبو عروبة مات سنة أربع وسبعين ومائتين(@)(@@)(@@)(@@) $ 14753 - عباس بن إسماعيل بن حماد البغدادي مولى بنى هاشم يروي عن أبي الوليد ومسلم وأقرانهم حدثنا عنه بن قتيبة(@)(@@)(@@)(@@) $ 14754 - عباس بن مصعب بن بشر المروزي يروي عن العراقيين وأهل بلده وكان يتحفظ ممن يتعاطى علم التواريخ والأنساب عاجله الموت فلم يصنف فيه شيئا حدثنا عنه بن أخيه أحمد بن محمد بن مصعب بن بشر بمرو وكان راويا لمحمد بن شجاع وأبى حمزة وسائر مشايخهم(@)(@@)(@@)(@@) $ 14755 - عباس بن السندي من أهل أنطاكية يروي عن القعنبي والبصريين حدثنا عنه أبو الطيب الدارمي بأنطاكية(@)(@@)(@@)(@@) $ 14756 - عباس بن محمد بن عمرو بن الحارث الجمحي أبو الفضل يروي عن أبي الوليد الطيالسي حدثنا عنه محمد بن عبد الرحمن الأصبهاني(@)(@@)(@@)(@@) $ 14757 - عنبسة العابد من أهل الكوفة يروي عن محمد بن جعفر بن محمد روى عنه زيد بن الحباب PageV08P514(@)(@@)(@@)(@@) $ 14758 - عنبسة الوراق يروي عن أبي لبابة روى عنه يحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 14759 - عنبسة بن خالد بن يزيد الأيلي بن أخي يونس بن يزيد يروي عن عمه يونس الأيلي روى عنه أحمد بن صالح المصري مات سنة سبع وتسعين ومائة(@)(@@)(@@)(@@) $ 14760 - أبو المنذر المروزي اسمه عنبسة بن يحيى الزاهد سكن بيكث يروي عن يزيد بن هارون وعبد الرزاق وأبى نعيم روى عنه أهل الشاش مات سنة إحدى وأربعين ومائتين وكان ممن ينصر السنة ويذب عنها ويقمع من يخالفها(@)(@@)(@@)(@@) $ 14761 - عمارة بن عبد الله الأنصاري أحد 
ms1606	 بنى دينار بن النجار من أهل المدينة يروي عن عمار بن مهاجر روى عنه محمد بن يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 14762 - عمارة الأحمر يروي عن حبيب بن يسار وحبيب بن يزيد روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 14763 - عون بن ذكوان أبو جناب الحرشي يروي عن بهز بن حكيم روى عنه غسان بن مالك ويونس المؤدب يخطىء ويخالف(@)(@@)(@@)(@@) $ 14764 - عون بن كهمس بن الحسن من أهل البصرة يروي عن أبيه عن عبد الله بن بريدة وعن داود بن مسافر روى عنه خليفة بن خياط العصفري(@)(@@)(@@)(@@) $ 14765 - عون بن علي بن عبيد الله بن أبي رافع يروي عن أبيه عداده في PageV08P515 أهل المدينة روى عنه موسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 14766 - عون بن معمر البجلي من أهل البصرة يروي عن إبراهيم الصائغ روى عنه أبو همام الخاركي وسعيد بن عامر وكان متقنا ضابطا يغرب وكان جار السلام بن أبي مطيع(@)(@@)(@@)(@@) $ 14767 - عون بن أبي عون القربي يروي عن حماد بن زيد روى عنه عمرو بن شبة(@)(@@)(@@)(@@) $ 14768 - عون بن سلام القرشي من أهل الكوفة يروي عن الحسن بن صالح بن حي وقيس بن الربيع وزهير بن معاوية روى عنه الحضرمي مستقيم الحديث(@)(@@)(@@)(@@) $ 14769 - عون بن الحكم بن سنان القربي يروي عن أبيه عن مالك بن دينار روى عنه هشام السيرافي(@)(@@)(@@)(@@) $ 14770 - عون بن يزيد المروزي شيخ يروي عن أبي معاوية الضرير حدثنا عنه عبد الله بن محمد السعدي مستقيم الأمر في الحديث(@)(@@)(@@)(@@) $ 14771 - عمار بن حفص بن عمر بن سعد القرظ أخو عمر بن حفص يروى عن PageV08P516 أبيه روى عنه عبد الرحمن بن سعد وابنه محمد بن عمار المؤذن(@)(@@)(@@)(@@) $ 14772 - عمار بن مالك كوفي يروي عن المنهال بن عمرو روى عنه أبو خالد الدالاني(@)(@@)(@@)(@@) $ 14773 - عمار بن عبد الله بن يسار يروي عن أبيه عن عبد الرحمن بن أبي ليلى روى عنه العباس بن القاسم أبو مريم(@)(@@)(@@)(@@) $ 14774 - عمار بن سعد بن عمار المخزومي المؤذن يروي عن أبي عبيدة بن محمد بن عمار 
ms1607	 بن ياسر روى عنه علي بن مجاهد(@)(@@)(@@)(@@) $ 14775 - عمار بن الحسن بن بشر النسائي أبو الحسن الهمداني يروي عن جرير بن عبد الحميد وسلمة بن الفضل حدثنا عنه محمد بن أحمد بن أبي عون وغيره من شيوخنا كان أصله من الري فانتقل إلى نسا وسكنها كان مولده سنة تسع وستين ومائة ومات سنة ثنتين وأربعين ومائتين سمعت أحمد بن محمد بن الحسن النسوي يقول سمعت عمار بن الحسن ينشد من قبله عمار لا تغفل عن العمل واعمل لنفسك قبل الموت في مهل وربع عليه فإن الله سايلها وليس ينفعها قول بلا عمل(@)(@@)(@@)(@@) $ 14776 - عمار بن زربى بن منصور بن أخي بشر بن منصور كنيته أبو المعتمر PageV08P517 من أهل البصرة إمام مسجد عمر بن مرزوق وكان ضريرا يروي عن البصريين حدثنا عنه الحسن بن سفيان يغرب ويخطىء(@)(@@)(@@)(@@) $ 14777 - عمار بن نصير المروزي يروي عن أبي سعيد الشرقي عن أبى حمزة عن بن عباس روى عنه أهل مرو(@)(@@)(@@)(@@) $ 14778 - عمار بن عبد الجبار المروزي مولى بنى سعد كنيته أبو الحسن يروي عن ورقاء وشعبة روى عنه أهل بلده مات بمكة بعد التشريق بيوم سنة إحدى عشرة ومائتين(@)(@@)(@@)(@@) $ 14779 - عمار بن طالوت شيخ بصرى يروي عن أبي عاصم وابن وهب حدثنا عبد الرحمن بن محمد بن عبد الرحمن الطهراني بالري ثنا عمار بن طالوت بن عباد الجحدري ذاك لم يذكره(@)(@@)(@@)(@@) $ 14780 - عمار بن عثمان الحلبي يروى الرقائق سمع جعفر بن سليمان الضبعي وأهل العراق روى عنه محمد بن الحسين البرجلاني(@)(@@)(@@)(@@) $ 14781 - عمار بن عثمان من أهل البصرة يروي عن عبد الوارث بن سعيد والبصريين روى عنه حميد بن الربيع الخزاز وأهل العراق(@)(@@)(@@)(@@) $ 14782 - عمار بن هارون المستملى أبو ياسر بصرى يروي عن حماد بن سلمة حدثنا عنه الحسن بن سفيان وغيره ربما أخطأ(@)(@@)(@@)(@@) $ 14783 - عمار بن خالد الواسطي يروي عن يزيد بن هارون وعلي بن PageV08P518 غراب حدثنا عنه الوليد بن بيان وغيره من شيوخنا مات سنة ستين ومائتين(@)(@@)(@@)(@@) $ 14784 - عمار بن رجاء من 
ms1608	 أهل استاراباد يروي عن يزيد بن هارون حدثنا عنه أبو نعيم عبد الملك بن محمد بن عدى(@)(@@)(@@)(@@) $ 14785 - عدى بن عبد الرحمن وليس بالطائي يروي عن محمد بن عمرو بن علقمة روى عنه إبراهيم بن طهمان(@)(@@)(@@)(@@) $ 14786 - عدى بن عبد الحميد يروي عن عروة بن محمد روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 14787 - عدى بن الفضل شيخ يروي عن عمر بن عبد العزيز روى عنه المعتمر بن سليمان وليس هذا بصاحب عبد الله بن عمر وأيوب ذاك مولى بنى تيم أدخلناه في الضعفاء(@)(@@)(@@)(@@) $ 14788 - عصمة بن زامل الطائي يروي عن أبيه روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 14789 - عصمة بن عزرة الفقيمي من أهل الكوفة يروي عن المغيرة بن مقسم روى عنه الحسن بن عمر(@)(@@)(@@)(@@) $ 14790 - عصمة بن سالم الهنائي يروي عن أشعث بن جابر الحداني روى عنه مسلم بن إبراهيم(@)(@@)(@@)(@@) $ 14791 - عصمة بن عثمان أبو محمد شيخ من أهل جوزجان يروى عن PageV08P519 أبى أمامة روى عنه أحمد بن سيار وقال كان حسن المذهب محبا لأهل الخير(@)(@@)(@@)(@@) $ 14792 - عصمة بن محمد شيخ من أهل سرخس من أصحاب أبي لبيد يروي عن بن عيينة روى عنه أهل بلده مستقيم الحديث(@)(@@)(@@)(@@) $ 14793 - عصمة بن المتوكل الحنفي قاضي شيراز يروي عن العراقيين وزافر بن سليمان روى عنه أحمد بن عبد الله بن يوسف الجصاص أبو جعفر بياع الحديد مستقيم الحديث(@)(@@)(@@)(@@) $ 14794 - عصمة بن الفضل أبو الفضل النيسابوري يروي عن يحيى بن آدم وأبى نعيم حدثنا عنه محمد بن إسحاق الثقفي(@)(@@)(@@)(@@) $ 14795 - عصمة بن الفضل شيخ يروي عن يعلى بن عبيد روى عنه إبراهيم بن إسحاق الأنصاري مستقيم الحديث(@)(@@)(@@)(@@) $ 14796 - عصام بن خالد شيخ حمصي يروى عن بن ثوبان روى عنه محمد بن عوف الحمصي أشياء يغرب عنه فيها(@)(@@)(@@)(@@) $ 14797 - عصام بن يزيد بن عجلان مولى مرة الطيب من أهل الكوفة سكن أصبهان ولقب عصام جبر يروي عن الثوري ومالك بن مغول روى عنه ابنه محمد بن عصام يتفرد ويخالف وكان صدوقا حديثه عند الأصبهانيين(@)(@@)(@@)(@@) $ 14798 
ms1609	 - عصام بن الحسين أبو عون أصله من سمرقند سكن الجوزجان PageV08P520 وبها عقبة يروي عن جرير وعيسى بن يونس روى عنه أحمد بن سيار وكان صاحب سنة ثبتا في الحديث يتفقه وكان يخضب رأسه ولحيته(@)(@@)(@@)(@@) $ 14799 - عصام بن يوسف بن ميمون بن قدامة البلخي أخو إبراهيم بن يوسف يروى عن بن المبارك روى عنه أهل بلده وكان صاحب حديث ثبتا في الرواية وربما أخطأ وكنيته أبو عصمة وكان يرفع يديه عند الركوع وعند رفع الرأس منه وأخوه إبراهيم بن يوسف كان يرفع ومات عصام سنة عشر ومائتين(@)(@@)(@@)(@@) $ 14800 - عصام بن رواد بن الجراح العسقلاني يروي عن أبيه حدثنا عنه أصحابنا(@)(@@)(@@)(@@) $ 14801 - عبادة بن كليب أبو غسان يروي عن الثوري والكوفيين روى عنه أحمد بن عمران الأخنسي ومحمد بن عبادة(@)(@@)(@@)(@@) $ 14802 - عوف بن محمد أبو غسان المرادي يروي عن البصريين روى عنه يحيى بن حكيم المقرىء مات في النصف من محرم سنة تسع وعشرين ومائتين(@)(@@)(@@)(@@) $ 14803 - عبادة بن زياد شيخ يروي عن شريك بن عبد الله بن أبي زهير قال رأيت الحسن بن علي يخضب بالوسمة روى عنه الحضرمي(@)(@@)(@@)(@@) $ 14804 - عفان بن جبير يروي عن أبي حريز روى عنه جعفر بن عون PageV08P521(@)(@@)(@@)(@@) $ 14805 - عفان بن مسلم بن عبد الله الصفار كنيته أبو عثمان مولى زيد بن ثابت الأنصاري من أهل البصرة سكن بغداد يروي عن شعبة وحماد بن سلمة روى عنه عبد الله بن أبي عرابة الشاشي وأهل العراق مات سنة عشرين ومائتين ببغداد يوم الخميس إحدى عشرة ليلة بقيت من ربيع الآخر قد قيل إنه مولى عروة بن ثابت الأنصاري(@)(@@)(@@)(@@) $ 14806 - عفان بن سيار الجرجاني يروى عن بن عيينة وشريك النخعي والكوفيين روى عنه عمار بن رجاء الإسترابادي وأهل بلده(@)(@@)(@@)(@@) $ 14807 - عتاب بن بشير الحراني مولى لبنى أمية كنيته أبو الحسن وقد قيل أبو سهل يروي عن خصيف وعلي بن بديمة روى عنه إسحاق بن إبراهيم الحنظلي وأهل بلده مات سنة تسعين ومائة وكان يخضب رأسه ولحيته بالحناء وكان ممن يخالف 
ms1610	 وقد قيل إن عتابا مات سنة ثمان وثمانين ومائة(@)(@@)(@@)(@@) $ 14808 - عتاب بن حرب بن عبد الله أبو بشر بن ابنة صالح بن رستم من أهل البصرة يروي عن جده صالح بن رستم عن أبي مليك روى عنه إبراهيم بن يعقوب الجوزجاني(@)(@@)(@@)(@@) $ 14809 - عتاب بن زياد المروزي يروي عن أبي حمزة وابن المبارك روى عنه الفضل بن أبي طالب وأهل بلده(@)(@@)(@@)(@@) $ 14810 - عتاب بن درست شيخ بصرى يروي عن عبد الله بن عيسى PageV08P522 عن يحيى البكاء عن بن عمر في الغسل حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 14811 - عتاب بن أعين من أهل الري يروي عن سفيان الثوري روى عنه أهل الري(@)(@@)(@@)(@@) $ 14812 - عتاب بن خليل الأبلى سكن المنصورة يروي عن الأنصاري عبيد الله بن موسى حدثنا عنه أحمد بن محمد بن الأزهر يتفرد ثنا محمد بن عبد الله بن الجنيد ثنا عتاب بن الخليل بالمنصورة ثنا عبيد الله بن موسى ابنا أبو جعفر الرازي عن الربيع بن أنس في قوله تعالى ولا تصعر خدك للناس ولا يكون الغني والفقير عندك في العلم سواء(@)(@@)(@@)(@@) $ 14813 - عوف بن محمد أبو غسان المرادي يروي عن البصريين روى عنه يحيى بن حكيم المقرىء مات للنصف من محرم يوم الخميس سنة تسع عشرة ومائتين(@)(@@)(@@)(@@) $ 14814 - عفيف بن سالم البجلي من أهل الموصل يروي عن الثوري روى عنه محمد بن عبد الله بن عمار وأهل بلده مات سنة ثلاث وثلاثين ومائتين وكان من العباد(@)(@@)(@@)(@@) $ 14815 - عبيس بن بيهس من أهل البصرة يروي عن أبيه روى عنه البصريون ربما أخطأ PageV08P523(@)(@@)(@@)(@@) $ 14816 - عبيس بن مرحوم بن عبد العزيز العطار مولى آل معاوية بن أبي سفيان من أهل البصرة يروي عن أبيه روى عنه بشر بن عبيس والبصريون مات سنة سبع عشرة ومائتين(@)(@@)(@@)(@@) $ 14817 - عرفجة العابد من أهل الكوفة ليس له حديث مسند يرجع إليه وله الحكايات في التعبد روى عنه خلف بن نعيم(@)(@@)(@@)(@@) $ 14818 - عسكر بن إبراهيم بن سعيد أبو سعيد المروزي يروي عن منصور بن النعمان عن أبي 
ms1611	 مجلز أن أبا موسى نام وسط أصحابه فقال هل وجدتم ريحا هل سمعتم صوتا قالوا لا قال فقام صلى ولم يتوضأ روى عنه الفضل بن موسى السيناني(@)(@@)(@@)(@@) $ 14819 - عميرة بن عبد المؤمن أبو سماعه الرهاوي مولى لهم يروي عن عصام بن بشير روى عنه أهل الجزيرة(@)(@@)(@@)(@@) $ 14820 - عياض بن عبد الله الفهري يروي عن مخرمة بن سليمان عن كريب روى عنه بن وهب(@)(@@)(@@)(@@) $ 14821 - عوام بن سليمان المديني يروي عن أبيه روى عنه إسحاق بن إبراهيم الحنظلي PageV08P524(@)(@@)(@@)(@@) $ 14822 - عوام بن عباد بن العوام يروي عن أبيه روى عنه العباس بن إسماعيل العريق(@)(@@)(@@)(@@) $ 14823 - علقمة بن عمر الكوفي يروي عن أبي بكر بن عياش والكوفيين حدثنا عنه أحمد بن الحسين الجرادي بالموصل وغيره يغرب(@)(@@)(@@)(@@) $ 14824 - عقيل بن يحيى الطهراني من أهل الري يروي عن أبي عاصم وأهل العراق حدثنا عنه غير واحد بالري(@)(@@)(@@)(@@) $ 14825 - عتيق بن محمد أبو بكر شيخ يروي عن الدراوردي وأهل الحجاز روى عنه إبراهيم بن إسحاق الأنصاري(@)(@@)(@@)(@@) $ 14826 - عروة بن سعيد الأنصاري سكن عبادان يروي عن أبي عوانة عن قتادة عن أنس عن مالك بن صعصعة قصة المعراج حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 14827 - عروة بن محمد الخراز من أهل الرقة يروي عن عبيد الله بن عمرو وموسى بن أعين روى عنه أيوب الوزان وأهل الجزيرة يخطىء ويغرب(@)(@@)(@@)(@@) $ 14828 - عراك بن خالد بن يزيد بن صالح بن صبيح المري كنيته أبو الضحاك من أهل دمشق يروي عن أبيه عن إبراهيم بن أبي عبلة روى عنه هشام بن عمار وأهل الشام ربما أغرب وخالف PageV08P525(@)(@@)(@@)(@@) $ 14829 - علوان بن داود البجلي من أهل الكوفة يروي عن مالك بن مغول روى عنه عمر بن عثمان الحمصي(@)(@@)(@@)(@@) $ 14830 - عرعرة بن البرند بن النعمان أبو عمر الناجي السامي من ولد سامة بن لؤي يروي عن روح بن القاسم وشعبة روى عنه علي بن المديني وأهل العراق(@)(@@)(@@)(@@) $ 14831 - عويذ بن أبي عمران الجوني يروي عن أبيه روى عنه العباس بن الفضل الأزرق من أهل 
ms1612	 البصرة(@)(@@)(@@)(@@) $ 14832 - عيينة بن عاصم يروي عن أبيه روى عنه عبد العزيز بن رستم الأسدي(@)(@@)(@@)(@@) $ 14833 - عكير بن شمير بن يزيد القيسي أبو سلمة من أهل البصرة يروي عن أبيه روى عنه التبوذكي(@)(@@)(@@)(@@) $ 14834 - عرفطة شيخ يروي عن أبي بشر جعفر بن أبي وحشية روى عنه عامر الأحول(@)(@@)(@@)(@@) $ 14835 - عيصا بن أبي بكر بن عبد الرحمن بن أبي سفيان بن حويطب يروي عن أبيه عداده في أهل المدينة يروي عنه غسان بن عبد الحميد(@)(@@)(@@)(@@) $ 14836 - عقال بن شبة بن عقال بن صعصعة بن ناجئة المجاشعي يروى PageV08P526 عن أبيه عن جده عن صعصعة وله صحبة روى عنه إبراهيم بن إسحاق بن رواحة المزني(@)(@@)(@@)(@@) $ 14837 - عتيق بن يعقوب بن صديق بن موسى بن عبد الله بن الزبير بن العوام أبو بكر القرشي من أهل المدينة يروي عن مالك روى عنه إبراهيم بن سعيد الجوهري وأهل العراق(@)(@@)(@@)(@@) $ 14838 - عكرمة بن إبراهيم العدني من أهل اليمن يروي عن الحكم بن أبان روى عنه أهل بلده والغرباء حدثنا الحسن بن سفيان ثنا إبراهيم بن معاوية بن فرات البصري حدثني عكرمة بن إبراهيم العدني ثنا الحكم بن أبان عن عكرمة عن بن عباس قال قال رسول الله صلى الله عليه وسلم الأرواح جنود مجندة فما تعارف منها ائتلف وما تناكر منها اختلف(@)(@@)(@@)(@@) $ 14839 - عكرمة بن طارق السرخسي كنيته أبو عون يروي عن هشيم وأبى عوانة كان صاحب حديث يحفظه نقله المأمون معه إلى العراق وولاه قضاء الشرقية وكان علي بن عيسى الكراشكي يكتب له ومات بالعراق روى عنه ابنه الفضل بن عكرمة(@)(@@)(@@)(@@) $ 14840 - عطية بن بقية بن الوليد الحمصي يروي عن أبيه ثنا عنه القطان وغيره من شيوخنا يخطىء ويغرب يعتبر حديثه إذا روى عن أبيه غير الأشياء المدلسة PageV08P527(@)(@@)(@@)(@@) $ 14841 - عائشة بنت يونس بن عبيد امرأة ليث بن أبي سليم تروى عن زوجها حدثني عبد الله بن جابر بطرسوس ثنا جعفر بن محمد الأذني قال سمعت محمد بن عيسى بن الطباع يقول حدثتني عائشة امرأة ليث 
ms1613	 بن أبي سليم قالت كان لنا جيران يسرقون ويشربون فقال ليث بن أبي سليم ما أقل طلب هؤلاء للحور العين حدثني مجاهد أن الحور العين خلقن من الزعفران PageV08P528(@)(@@)(@@)(@@) || (باب الغين)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن أتباع التابعين ممن ابتدأ اسمه على الغين(@)(@@)(@@)(@@) $ 14842 - غسان بن الأغر بن حصين النهشلي يروي عن زياد بن حصين روى عنه الصلت بن محمد الخاركي وغيره وحبان بن علي(@)(@@)(@@)(@@) $ 14843 - غسان بن عبيد الموصلي يروي عن شعبة نسخة مستقيمة رواها عنه أيوب بن محمد الوزان حدثنا القطان بالرقة عن أيوب بها(@)(@@)(@@)(@@) $ 14844 - غسان بن سليمان الهروي يروي عن إبراهيم بن طهمان وسفيان الثوري روى عنه محمد بن عمرويه الهروي الذي كان ببغداد وهو أخو مالك بن سليمان غسان صدوق ومالك واه(@)(@@)(@@)(@@) $ 14845 - غسان بن المفضل الغلابي من أهل البصرة يروي عن أبي عاصم النبيل والبصريين روى عنه ابنه المفضل بن غسان وقد رأى صالحا المري وسمع منه أشياء حكاها عنه ابنه المفضل عنه عن صالح PageV09P001(@)(@@)(@@)(@@) $ 14846 - غسان بن مالك بن عباد السلمي بصرى يروي عن عون بن ذكوان أبي جناب وعنبسة بن عبد الرحمن روى عنه محمد بن محمد بن مرزوق الباهلي وجعفر بن أبان الحراني(@)(@@)(@@)(@@) $ 14847 - غسان بن عمرو بن عبيد الله العبدي يروي عن حمزة الزيات روى عنه أبو الربيع الزهراني(@)(@@)(@@)(@@) $ 14848 - غسان بن عبد الحميد بن عبيد بن يسار الكناني من أهل المدينة يروي عن بن إسحاق روى عنه أبو غسان محمد بن يحيى بن عبد الحميد الكناني بن أخيه(@)(@@)(@@)(@@) $ 14849 - غسان بن الفضل الشجري أبو عمر يروي عن حزم بن أبي حزم وكان راويا لصبيح بن سعيد لم ندخله في أتباع التابعين لأن صبيحا ليس بثقة روى عنه محمد بن حيان من أهل هراة وأهل بلده(@)(@@)(@@)(@@) $ 14850 - غسان بن الربيع أبو محمد الكوفي سكن الموصل يروي عن الليث بن سعد وحماد بن سلمة والناس حدثنا عنه أبو يعلى بالموصل(@)(@@)(@@)(@@) $ 14851 - غسان بن عمر أبو الهذيل العجلي من 
ms1614	 أهل الكوفة يروي عن الثوري روى عنه محمد بن سلام البيكندي(@)(@@)(@@)(@@) $ 14852 - عوث بن جابر بن غيلان بن منبه اليماني يروى عن عقيل بن PageV09P002 معقل بن منبه عن وهب بن منبه بكتاب في الحكمة روى عنه محمد بن رافع القشيري(@)(@@)(@@)(@@) $ 14853 - غيلان بن أنس الدمشقي يروي عن عمر بن عبد العزيز روى عنه شعيب بن أبي حمزة(@)(@@)(@@)(@@) $ 14854 - غياث بن حمزة من أهل سرخس يروي عن يزيد بن هارون وكان صاحب عبادة وفضل روى عنه أهل بلده(@)(@@)(@@)(@@) $ 14855 - غياث بن جعفر مستملي سفيان بن عيينة يروي عن بن عيينة حدثنا عنه الحسين بن إدريس الأنصاري مستقيم الحديث(@)(@@)(@@)(@@) $ 14856 - غضين شيخ كوفي يروي عن عمه عن الشعبي روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 14857 - غالب بن فهيد أبو الحسن من أهل الكوفة وهو الذي يقال له غالب بن فهيد العالبى كان يعنى بعلم الفرائض حدثنا عمرو بن محمد الهمداني ثنا الفضل بن سهل الأعرج ثنا غالب بن فهيد ثنا عبد الرحمن بن أبي الزناد عن أبيه عن خارجة بن زيد بن ثابت عن عمر قال لا ترث أخ ولا أخت لأم مع جد أب الأب(@)(@@)(@@)(@@) $ 14858 - غالب بن وزير الغزى من أهل فلسطين يروي عن وكيع بن الجراح حدثنا عنه بن قتيبة وغيره مستقيم الحديث PageV09P003(@)(@@)(@@)(@@) $ 14859 - غضبان بن حنظلة بن نعيم العنزي يروي عن أبيه روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 14860 - غصن بن إسماعيل من أهل أنطاكية يروي عن ثوبان عن نافع والزهري روى عنه محمد بن غالب الأنطاكي ربما خالف(@)(@@)(@@)(@@) $$ 14861 - غفيرة بنت واقد متعبدة كانت بالبصرة تروى عن حميدة بنت ثابت البناني عن أبيها ثابت روى عنها محمد بن عبد الملك الدقيقي حدثنا عبد الملك بن محمد بن سميع الدمشقي ثنا محمد بن عبد الملك الدقيقي حدثتنا غفيرة بنت واقد قالت حميدة بنت ثابت حدثتني قالت كان أنس وأبو طلال في بيت ثابت فقال أنس يا أبا طلال متى فقدت بصرك فقال وأنا صبي أعقل قال فهل لا أحدثك 
ms1615	 حديثا حدثنيه حبيبي صلى الله عليه وسلم يرويه عن جبرائيل وجبرائيل يرويه عن الله عز وجل وعلا قال يا جبرائيل ما جزاء من سلبت كريمتيه فقال سبحانك لا علم لنا إلا ما علمتنا قال جزاؤه الخلود في داري والنظر إلى وجهي(@)(@@)(@@)(@@) || (باب الفاء)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى من تبع الأتباع عن أتباع التابعين ممن ابتدأ اسمه على الفاء PageV09P004(@)(@@)(@@)(@@) $ 14862 - الفضل بن مهلهل أبو المفضل الكوفي من العباد أخو المفضل بن مهلهل يروي عن حبيب بن أبي عمرة روى عنه الحسن بن الربيع البوراني(@)(@@)(@@)(@@) $ 14863 - الفضل بن ميمون أبو سلمة السلمي البصري صاحب الطعام يروي عن منصور بن زاذان روى عنه أبو عامر العقدي(@)(@@)(@@)(@@) $ 14864 - الفضل أبو يزيد يروي عن سعيد بن مسروق والد سفيان روى عنه زيد بن حباب(@)(@@)(@@)(@@) $ 14865 - الفضل بن عميرة الطفاوي يروي عن ميمون الكردي روى عنه حرمي بن عمارة(@)(@@)(@@)(@@) $ 14866 - الفضل بن العلاء أبو العلاء الكوفي وقد قيل أبو العباس يروي عن إسماعيل بن أمية روى عنه محمد بن عقبة(@)(@@)(@@)(@@) $ 14867 - الفضل بن خالد أبو معاذ النحوي المروزي مولى باهلة يروي عن بن المبارك وعبيد بن سليمان روى عنه محمد بن علي بن الحسن بن شقيق وأهل بلده مات سنة إحدى عشرة ومائتين(@)(@@)(@@)(@@) $ 14868 - أبو مساور البصري ختن أبي عوانة يروى عن PageV09P005 أبي عوانة روى عنه البصريون النضر بن طاهر وغيره(@)(@@)(@@)(@@) $ 14869 - الفضل بن موفق الثقفي كنيته أبو الجهم من أهل الكوفة وهو الذي يقال له الفضل بن أبي المتئد يروي عن مسعر بن كدام روى عنه بن أبي شيبة وأهل العراق(@)(@@)(@@)(@@) $ 14870 - الفضل بن عنبسة بن ماهان الراسبي الواسطي أبو الحسن الخزاز يروي عن يزيد بن إبراهيم التستري روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 14871 - الفضل بن غانم أبو علي من أهل بغداد يروي عن بن عيينة وعبد الرحمن بن مغراء وأهل العراق حدثنا عنه بن منيع قال كتبت عنه سنة ثمان وعشرين ومائتين(@)(@@)(@@)(@@) $ 14872 - الفضل بن زياد البغدادي الذي يقال له 
ms1616	 الطستي أبو العباس يروي عن إسماعيل بن عياش وأهل العراق حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 14873 - الفضل بن الصباح أبو العباس البغدادي يروي عن أبي ضمرة أنس بن عياض روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 14874 - الفضل بن إسحاق العباداني يروي عن الأشجعي ثنا عنه أبو يعلى(@)(@@)(@@)(@@) $ 14875 - الفضل بن إسحاق الدوري بغدادي يروي عن معاذ بن PageV09P006 معاذ وابن أبي عدى حدثنا عنه محمد بن إبراهيم الفاسي وغيره(@)(@@)(@@)(@@) $ 14876 - الفضل بن يعقوب الجزري أبو العباس سكن البصرة يروي عن أبي عاصم وأهل العراق حدثنا عنه بن خزيمة وغيره مات بعد الخمسين والمائتين(@)(@@)(@@)(@@) $ 14877 - الفضل بن سخيت أبو العباس السندي بغدادي يروي عن صالح بن بيان عن هشام بن عروة عن أبيه عن عائشة كان النبي صلى الله عليه وسلم يأكل الرطب بالبطيخ حدثنا به الحسن بن سفيان عنه(@)(@@)(@@)(@@) $ 14878 - الفضل بن يعقوب الرخامي من أهل بغداد كنيته أبو العباس يروي عن عبيد الله بن موسى وأبى عاصم حدثنا عنه محمد بن عمر بن يوسف(@)(@@)(@@)(@@) $ 14879 - الفضل بن موسى بن عيسى الهاشمي من أهل سامرة أصله من البصرة يروي عن الأنصاري وعبد الرحمن بن مهدى حدثنا عنه مروان بن عيسى بن السكين وغيره مات سنة ستين ومائتين أو قبلها أو بعدها بقليل(@)(@@)(@@)(@@) $ 14880 - الفضل بن أبي طالب أخو يحيى بن أبي طالب من أهل بغداد يروي عن يزيد بن هارون وأهل العراق حدثنا عنه شيوخنا مات سنة ثنتين وخمسين ومائتين(@)(@@)(@@)(@@) $ 14881 - الفضل بن سهل الأعرج أبو العباس من أهل بغداد يروى PageV09P007 عن يزيد بن هارون وأبى عاصم حدثنا عنه محمد بن إسحاق بن إبراهيم مولى ثقيف وغيره مات سنة خمس وخمسين ومائتين(@)(@@)(@@)(@@) $ 14882 - الفضل بن يوسف القصباني من أهل الكوفة يروي عن أبي نعيم وأهل العراق حدثنا عنه الحسن بن أحمد الإصطخري(@)(@@)(@@)(@@) $ 14883 - الفضل بن عبد الجبار المروزي يروي عن أبي نعيم وكان راويا لعلي بن حسن بن سفيان ثنا عنه شكر(@)(@@)(@@)(@@) $ 14884 - الفضل بن عميرة الكوفي يروي عن أبي نعيم ثنا 
ms1617	 عنه حاجب بن أركين الفرغاني(@)(@@)(@@)(@@) $ 14885 - الفضل بن عكرمة بن طارق السرخسي يروي عن يعلى بن عبيد وعبد الله بن بكر السهمي حدثنا عنه محمد بن الليث الوراق وأهل سرخس مات سنة نيف وخمسين ومائتين(@)(@@)(@@)(@@) $ 14886 - الفضل بن العباس بن أبي عرابة أبو علي بن أخي عبد الله بن أبي عرابة من أهل الشاش يروي عن علي بن حجر وأحمد بن حنبل روى عنه أهل بلده مات سنة ست وثمانين ومائتين(@)(@@)(@@)(@@) $ 14887 - الفضل بن عبد الجبار الباهلي من أهل مرو يروي عن أبي نعيم روى عنه أهل بلده مات سنة ثمان وثمانين ومائتين(@)(@@)(@@)(@@) $ 14888 - الفضل بن الحباب بن محمد بن صخر بن عبد الرحمن الجمحي أبو خليفة واسم أبيه عمرو والحباب لقبه يروي عن أبي الوليد الطيالسي PageV09P008 مات سنة خمس وثلاثمائة وكان مولده سنة سبع ومائتين(@)(@@)(@@)(@@) $ 14889 - الفضيل بن ميسرة أبو معاذ الأزدي العقيلي ختن بديل بن ميسرة من أهل البصرة يروي عن أبي حريز واسمه عبد الله بن حسين قاضى سجستان روى عنه المعتمر بن سليمان مستقيم الحديث(@)(@@)(@@)(@@) $ 14890 - الفضيل بن أبى رفيدة يروى عن عاصم بن هبيرة روى عنه جرير بن عبد الحميد الضبي(@)(@@)(@@)(@@) $ 14891 - الفضيل بن ثعلبة يروي عن أبي النوار روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 14892 - الفضيل بن منبوذ روى عن زيد بن أبي عمرو روى عنه بشر بن الحكم(@)(@@)(@@)(@@) $ 14893 - الفضيل بن عبد الوهاب أخو محمد بن عبد الوهاب القناد من أهل الكوفة يروي عن أبي معاوية وأهل الكوفة روى عنه أهل العراق(@)(@@)(@@)(@@) $ 14894 - الفضيل بن عبد الوهاب أبو محمد من أهل البصرة يروي عن جعفر بن سليمان الضبعي وشريك والكوفيين والبصريين روى عنه الحسن بن علي الحلواني والناس PageV09P009(@)(@@)(@@)(@@) $ 14895 - الفضيل بن الحسين أبو كامل الجحدري من أهل البصرة يروي عن حماد بن زيد والبصريين روى عنه شيوخنا مات سنة بضع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 14896 - فضالة بن مفضل بن فضالة بن عبيد القتباني من أهل مصر كنيته أبو ثوابة يروي عن الليث بن سعد وابن لهيعة 
ms1618	 روى عنه يعقوب بن سفيان الفارسي(@)(@@)(@@)(@@) $ 14897 - فضالة بن حسين أبو معاوية العطار من أهل البصرة يروي عن يونس بن عبيد وعطاء بن السائب روى عنه محمد بن عقبة(@)(@@)(@@)(@@) $ 14898 - فضالة بن إبراهيم التيمي أبو أحمد من أهل نسا من كبار أصحاب بن المبارك يروي عن الليث بن سعد وابن لهيعة روى عنه أهل بلده وكان قتيبة بن سعيد معه بمصر وكان من أهل الحفظ والضبط والعلم واللغة والشعر وهو والد أبي قديد عبيد الله بن فضالة وجد فضالة بن عبيد الله وأبو جد المفضل بن فضالة صديقنا رحمه الله(@)(@@)(@@)(@@) $ 14899 - فضالة بن الفضل التميمي أبو الفضل من أهل الكوفة يروي عن أبي بكر بن عياش حدثني عنه الطبري ربما أخطأ كان يحدث بالكوفة في بنى شيطان PageV09P010(@)(@@)(@@)(@@) $ 14900 - فروة بن زبيد المدني يروي عن أبيه عن جده عن بن عمر روى عنه أبو بكر الحنفي(@)(@@)(@@)(@@) $ 14901 - فروة بن أبي المغراء الكندي من أهل الكوفة كنيته أبو القاسم يروي عن بن أبي زائدة وعلي بن مسهر روى عنه عبد الله بن عبد الرحمن وأهل العراق مات سنة خمس وعشرين ومائتين(@)(@@)(@@)(@@) $ 14902 - فياض بن الأسود الطائي من أهل الكوفة يروي عن أبيه روى عنه سويد بن عمرو(@)(@@)(@@)(@@) $ 14903 - فياض بن محمد شيخ يروي عن يحيى بن أبي كثير روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 14904 - فياض بن محمد الرقى مولى هشام يروي عن جعفر بن برقان روى عنه الوليد بن صالح مات سنة مائتين في أول المحرم(@)(@@)(@@)(@@) $ 14905 - فياض بن زهير من أهل نسا يروي عن وكيع بن الجراح وجعفر بن عون ثنا عنه محمد بن أحمد بن أبي عون وغيره من شيوخنا مات بعد سنة خمسين ومائتين(@)(@@)(@@)(@@) $ 14906 - فليح بن محمد بن المنذر بن الزبير بن العوام القرشي يروي عن أبيه روى عنه بن المبارك(@)(@@)(@@)(@@) $ 14907 - فليح بن إسماعيل بن جعفر بن أبي كثير مولى بنى زريق من الأنصار PageV09P011 يروي عن أبيه وسليمان بن بلال روى عنه النصر بن سلمة شاذان يعتبر 
ms1619	 حديثه من غير رواية شاذان عنه(@)(@@)(@@)(@@) $ 14908 - الفيض بن الفضل البجلي من أهل الكوفة مولى بجيلة يروي عن السرى بن إسماعيل ومسعر بن كدام روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 14909 - الفيض بن إسحاق الرقى يروي عن محمد بن عبد الله بن عبد بن عمير وعمرو بن دينار روى عنه أحمد بن هاشم الأنطاكي وأهل الجزيرة كان ممن يخطىء(@)(@@)(@@)(@@) $ 14910 - الفيض بن وثيق يروي عن حماد بن زيد عن يحيى بن عتيق وأيوب عن بن سيرين عن عمران بن حصين أن رجلا أعتق ستة أعبد له عند الموت ولم يكن له مال غيره فأقرع النبي صلى الله عليه وسلم بينهم فأعتق اثنين وأرق أربعة حدثناه حاجب بن أركين ثنا محمد بن نصر البغدادي ثنا الفيض بن وثيق فذكره(@)(@@)(@@)(@@) $ 14911 - فهر بن بشير أبو أحمد مولى بنى سليم الذي يقال له فهير الرقى كان ينزل دامان قرية بالجزيرة يروي عن جعفر بن برقان روى عنه أيوب بن محمد الوزان وأهل الجزيرة مات بعد المائتين وقد قيل مولى بنى أسد ومن الناس من يتوهم أنهما اثنان وليس كذلك PageV09P012(@)(@@)(@@)(@@) $ 14912 - فديك بن سليمان أبو عيسى القيسراني من أهل الشام يروي عن الأوزاعي روى عنه عبد الرحمن بن إبراهيم الدمشقي وأهل الشام(@)(@@)(@@)(@@) $ 14913 - فهد بن عوف أبو ربيعة من أهل البصرة يروي عن شعبة والبصريين روى عنه أهلها مات يوم الإثنين لأربع خلون من المحرم سنة تسع عشرة ومائتين(@)(@@)(@@)(@@) $ 14914 - فرج بن سعيد بن علقمة بن سعيد بن أبيض بن حمال المأربي من أهل اليمن يروي عن عمه ثابت بن سعيد بن أبيض عن أبيه سعيد عن جده أبيض بن حمال أنه سأل النبي صلى الله عليه وسلم عن حمى الأراك فقال لا حمى في الأراك روى عنه محمد بن يحيى بن أبي عمرو العدني(@)(@@)(@@)(@@) $ 14915 - فرج بن رواحة المنبجي يروي عن زهير بن معاوية حدثنا عنه عمر بن سعيد بن سنان بمنبج مستقيم الحديث جدا مات سنة إحدى وثلاثين ومائتين أو قبلها أو بعدها 
ms1620	 بقليل(@)(@@)(@@)(@@) $ 14916 - الفرات بن خالد أبو إسحاق من أهل الري يروي عن الثوري وأسامة بن زيد روى عنه إبراهيم بن موسى الفراء ومحمد بن حميد الرازيان(@)(@@)(@@)(@@) $ 14917 - الفرات بن محبوب يروي عن أبي بكر بن عياش روى عنه أبو شيب بن أبي بكر بن أبي شيبة PageV09P013(@)(@@)(@@)(@@) $ 14918 - الفرات بن نصر أبو حفص من أهل هراة يروي عن يزيد بن هارون وأهل العراق قديم الموت مشهور عندهم روى عنه أهل بلده ما سمعت أحدا بهراة يروي عنه إلا المأمون بن أحمد والمأمون ليس بمأمون(@)(@@)(@@)(@@) $ 14919 - فطر بن حماد بن واقد الصفار يروي عن أبيه عن مالك بن دينار حدثنا عنه الحسن بن سفيان وغيره(@)(@@)(@@)(@@) $ 14920 - الفتح بن هشام الترجماني من أهل بغداد يروي عن أبي عاصم وأهل العراق حدثنا عنه محمد بن إسحاق بن إبراهيم الثقفي يغرب(@)(@@)(@@)(@@) $ 14921 - الفتح بن عمرو الكسي الوراق يروي عن يزيد بن هارون وعبيد الله بن موسى حدثنا عنه أحمد بن محمد بن الحسن البلخي وغيره مستقيم الحديث(@)(@@)(@@)(@@) $ 14922 - الفتح بن سلمويه بن حمران كنيته أبو بشر من أهل الجزيرة يروي عن الجزريين روى عنه أهلها مات في شعبان سنة خمسين ومائتين(@)(@@)(@@)(@@) || (باب القاف)(@)(@@) قال أبو حاتم رضى الله عنه وممن روى من الطبقة الرابعة عن أتباع التابعين ممن ابتدأ اسمه على القاف(@)(@@)(@@)(@@) $ 14923 - قيس الحاجب يروي عن أبي جعفر المدني روى عنه عمرو بن الحارث PageV09P014(@)(@@)(@@)(@@) $ 14924 - قيس مولى عمرو يروي عن بن طاوس روى عنه بن جريج(@)(@@)(@@)(@@) $ 14925 - قيس بن عبد الرحمن بن أبي صعصعة من أهل المدينة يروي عن سعد بن إبراهيم روى عنه أهل بلده(@)(@@)(@@)(@@) $ 14926 - قيس أبو عمارة الفارسي مولى سودة بنت سعد مولاة بنى ساعدة من الأنصار يروي عن عبد الله بن أبي بكر بن محمد بن عمرو بن حزم روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 14927 - قيس بن حفص الدارمي من أهل البصرة يروي عن مسلمة بن علقمة والمعتمر بن سليمان روى عنه أهل البصرة يغرب(@)(@@)(@@)(@@) $ 14928 - قيس بن محمد الكندي 