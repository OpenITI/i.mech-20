ms2397	 ، ووكل الله بذالك ملكا يدخله على قبري كما يدخل على أحدكم الهدايا ، إن علمي بعد موتي كعلمي في الحياة ) )(@)(@@) الديلمي عن حكامه عن أبيها عثمان بن دينار عن أخيه مالك بن دينار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22356 ) قال النبي :(@)(@@) | 30 ( من صلى علي عند قبري سمعته ، ومن صلى علي من بعيد علمته ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22357 ) قال النبي :(@)(@@) | 30 ( من صلى فيه يعني مسجد بني عمرو بن عوف كان كعدل عمرة ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22358 ) قال النبي :(@)(@@) | 30 ( من صلى مكتوبة أو سبحة فليقرأ بأم القرآن وقرآن معها ، فإن انتهى إلى أم القرآن أجزأت عنه ، ومن كان مع الإمام فليقرأ قبله أو أيما سكت ، فمن صلى صلاة لم يقرأ فيها فهي خداج ثلاثا ) )(@)(@@) عبد الرزاق عن ابن عمر رضي الله عنهما وحسن .(@)(@@)(@@)(@@) $ ( 22359 ) قال النبي :(@)(@@) | 30 ( من صلى على جنازة فانصرف قبل أن يفرغ منها كان له قيراط ، فإن انتظر حتى يفرغ منها كان له قيراطان والقيراط مثل أحد في ميزانه ) )(@)(@@) ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22360 ) قال النبي :(@)(@@) | 30 ( من صلى وهو يرائي فقد أشرك ، ومن صام وهو يرائي فقد أشرك ، ومن تصدق وهو يرائي فقد أشرك ) )(@)(@@) ( ط حم طب ك هب ) عن PageV07P268 شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22361 ) قال النبي :(@)(@@) | 30 ( من صلى منكم فلا يفترش افتراش الكلب ذراعيه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22362 ) قال النبي :(@)(@@) | 30 ( من صلى صلاة مكتوبة مع الإمام فليقرأ بفاتحة الكتاب في سكناته ، ومن انتهى إلى أم القرآن فقد أجزأه ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22363 ) قال النبي :(@)(@@) | 30 ( من صلى معنا هاذه الصلاة في هاذا المكان ، ثم وقف هاذا الموقف حتى يفيض الإمام ، وكان وقف قبل ذالك من عرفات ليلا أو نهارا فقد تم حجه وقضى تفثه ) )(@)(@@) ( ك ) عن عبد الله بن مضرس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22364 ) قال النبي :(@)(@@) | 30 ( من صلى عليه أمة 
