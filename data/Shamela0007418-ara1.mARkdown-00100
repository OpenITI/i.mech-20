ms81	(@)(@@)(@@)(@@) $DIC_NIS$ الزيبقي (@)(@@) بالكسر وفتح الموحدة إلى الزيبق المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الزيبي (@)(@@) بالفتح والسكون آخره موحدة إلى زيب قرية عند عكا.(@)(@@)(@@)(@@) $DIC_NIS$ الزيتوني (@)(@@) إلى زيتون بلفظ المأكول قلت: وقرية بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزيداني (@)(@@) بفتح الزاي والدال المهملة إلى صحراء زيدان موضع بالكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ الزيداوني (@)(@@) مثله والواو مفتوحة إلى زيداون قرية من كور الأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ الزيدي (@)(@@) إلى زيد بن علي بن الحسين نسبا ومذهبا وزيد بن ثابت وزيد بن أبي أنيسة وزيد الله بن سعد العشيرة بطن من مذحج وزيد بن عمرو بطن من طيىء وزيد بن الغوث بطن من بجيلة والزيدية قرية بسواد بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الزيقي (@)(@@) بالكسر والسكون وقاف قلت: إلى زيق محلة بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزيكوني (@)(@@) بالكسر والسكون وضم الكاف إلى زيكون قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزيلعي (@)(@@) بفتح أوله واللام قبلها تحتية ساكنة آخره مهملة إلى زيلع قرية على البحر بناحية الحبشة.(@)(@@)(@@)(@@) $DIC_NIS$ والزيلوشي (@)(@@) إلى زيلوش قرية بالرملة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزيني (@)(@@) بالفتح والسكون إلى زين جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزينبي (@)(@@) إلى زينب بنت سليمان بن علي بن عبد الله بن العباس. PageV01P129(@)(@@)(@@)(@@) | حرف السين المهملة(@)(@@)(@@)(@@) || باب السين والألف(@)(@@)(@@)(@@) $DIC_NIS$ الساباطي (@)(@@) إلى ساباط قرية قرب سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ السابح (@)(@@) إلى العوم.(@)(@@)(@@)(@@) $DIC_NIS$ السابري (@)(@@) بفتح الموحدة إلى نوع من الثياب يسمى السابري.(@)(@@)(@@)(@@) $DIC_NIS$ السابوري (@)(@@) بضمها إلى سابور بلد بفارس وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الساجي (@)(@@) بالجيم إلى الساج الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ الساحلي (@)(@@) بكسر المهملة إلى الساحل وهي البلاد على طرف البحر.(@)(@@)(@@)(@@) $DIC_NIS$ الساربان (@)(@@) بفتح الراء والموحدة إلى حفظ الجمال.(@)(@@)(@@)(@@) $DIC_NIS$ الساركوني (@)(@@) بفتح الراء وضم الكاف إلى ساركون قرية بسواد بخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الساري (@)(@@) إلى سارية من مدن مازنداران.(@)(@@)(@@)(@@) $DIC_NIS$ الساسياني (@)(@@) إلى ساسان محلة بمرو انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الساسجردي (@)(@@) بسكون المهملة الثانية والراء وكسر الجيم آخره مهملة إلى ساسجرد قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الساسكوني (@)(@@) إلى ساسكون قرية بحماة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السايساني (@)(@@) بتخفيف التحتية إلى ساسيان محلة بمرو قلت: ذكرها ياقوت بلا ياء وتقدمت من زيادتي.(@)(@@)(@@)(@@) $DIC_NIS$ والساسي (@)(@@) إلى ساس قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الساعدي (@)(@@) إلى ساعدة بن كعب من الخزرج.(@)(@@)(@@)(@@) $DIC_NIS$ الساغرجي (@)(@@) بفتح 
ms82	 المعجمة وسكون الراء وجيم إلى ساغرج قرية بسمرقند ويقال بالصاد أولها.(@)(@@)(@@)(@@) $DIC_NIS$ السافردري (@)(@@) بفتح الفاء والمهملة وسكون الراء الأولى إلى سافردر قرية قرب آمل.(@)(@@)(@@)(@@) $DIC_NIS$ الساكبديازري (@)(@@) بفتح الكاف والباء الموحدة PageV01P130 والتحتية والزاي وسكون الدال المهملة إلى ساكبديازر قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ السالحيني (@)(@@) بفتح اللام وكسر المهملة إلى سالحين قرية بسواد بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السالمي (@)(@@) إلى سالم بطن من الأنصار وجد والسالمية رأسهم أبو الحسن بن سالم.(@)(@@)(@@)(@@) $DIC_NIS$ الساماني (@)(@@) بالنون إلى السامانية ملوك ما وراء النهر قلت: وإلى سامان محلة بأصبهان وقرية بسمرقند أيضا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السامري (@)(@@) بفتح الميم وتشديد الراء إلى سر من رأى مدينة فوق بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السامي (@)(@@) إلى سامة بن لؤي بن غالب قلت: وإلى سام قرية بدمشق ومحلة سامة بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ والساميني (@)(@@) إلى سامين قرية بهمدان انتهى السابخني بسكون النون الأولى وفتح الجيم إلى سانجن قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ السانجني (@)(@@) مثله بلا نون آخره إلى سان قرية بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ السانقاني (@)(@@) بسكون النون الأولى وفتح القاف إلى سانقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السانوجردي (@)(@@) بضم النون وكسر الجيم وراء ومهملة إلى سانرجرد قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الساوكاني (@)(@@) بسكون الواو إلى ساوكان قرية بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الساوي (@)(@@) إلى ساوة مدينة بين الري وهمدان.(@)(@@)(@@)(@@) $DIC_NIS$ السائح (@)(@@) إلى السياحة في البلاد.(@)(@@)(@@)(@@) || باب السين والباء(@)(@@)(@@)(@@) $DIC_NIS$ السباري (@)(@@) بالكسر وفتح الموحدة وراء إلى سبيرى ويقال سبارى قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السباعي (@)(@@) مثله إلى بني سباع وسباع جد.(@)(@@)(@@)(@@) $DIC_NIS$ السباك (@)(@@) إلى سبك النقد.(@)(@@)(@@)(@@) $DIC_NIS$ السباكي (@)(@@) بالكسر والتخفيف إلى سباكة بطن من يحصب. PageV01P131(@)(@@)(@@)(@@) $DIC_NIS$ السباي (@)(@@) بالفتح إلى سبا بن يشجب بن يعرب بن قحطان وإلى عبد الله بن سبأ رأس السبائية من الرافضة.(@)(@@)(@@)(@@) $DIC_NIS$ السبتي (@)(@@) بالفتح والسكون وفوقية إلى سبتة مدينة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ السبحي (@)(@@) بالضم والفتح وإلى السبح التي يسبح بها.(@)(@@)(@@)(@@) $DIC_NIS$ السبختي (@)(@@) بالفتح والضم وسكون الخاء المعجمة وفوقية إلى سبخت جد.(@)(@@)(@@)(@@) $DIC_NIS$ السبخي (@)(@@) بفتحتين إلى السبخة قلت: هو موضع بالبصرة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السبدي (@)(@@) بالضم والفتح ومهملة إلى سبد بطن من قيس.(@)(@@)(@@)(@@) $DIC_NIS$ السبذموني (@)(@@) بالضم والفتح وسكون المعجمة وضم الميم ونون إلى 
ms83	 سبذمون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السبري (@)(@@) بالفتح والسكون وراء إلى سبرة جد.(@)(@@)(@@)(@@) $DIC_NIS$ السبعي (@)(@@) بالضم والسكون ومهملة إلى السبع من القرآن وأبو علي بكر بن أبي بكر بن أبي سهيل النيسابوري لأن جدته أوصت بسبع مالها فاشتهروا به وبالفتح والسكون إلى السبعية طائفة قالوا: إن الأشياء العلوية والسفلية كلها سبعة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السبكي (@)(@@) بالضم والسكون إلى سبك قرية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السبني (@)(@@) بفتحتين ونون قلت: إلى سبن موضع. PageV01P132(@)(@@)(@@)(@@) $DIC_NIS$ والسبيبي (@)(@@) إلى سبيبة بالفتح وكسر الموحدة الأولى ناحية فإفريقية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السبيذغكي (@)(@@) بضم أوله والغين المعجمة وكسر الموحدة وتحتية ومعجمة إلى سبيذغكي قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السبيري (@)(@@) بالفتح والكسر إلى سبيرا تقدمت في السباري.(@)(@@)(@@)(@@) $DIC_NIS$ السبيعي (@)(@@) مثله إلى سبيع بطن من همدان ومحلة السبيع بالكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ السبيي (@)(@@) بالكسر والسكون إلى سبية قرية بالرملة.(@)(@@)(@@)(@@) $DIC_NIS$ السبيلي (@)(@@) بالضم والفتح إلى سبيلة بطن من قضاعة.(@)(@@)(@@)(@@) || باب السين والتاء(@)(@@)(@@)(@@) $DIC_NIS$ الستري (@)(@@) بالكسر وسكون الفوقية إلى حمل أستار الكعبة شرفها الله.(@)(@@)(@@)(@@) $DIC_NIS$ الستوري (@)(@@) إلى الستور.(@)(@@)(@@)(@@) $DIC_NIS$ الستيتي (@)(@@) مصغرا إلى ستيتة مولاة يزيد بن معاوية.(@)(@@)(@@)(@@) $DIC_NIS$ الستيفغني (@)(@@) بالضم والكسر والسكون وفتح الكاف والمعجمة بينهما مفتوحة آخره نون إلى ستيفغنة قريبة ببخارى ونون إلى ستتكين قرية ببخارى.(@)(@@)(@@)(@@) || باب السين والجيم(@)(@@)(@@)(@@) $DIC_NIS$ السجازي (@)(@@) بالكسر وتخفيف الجيم وزاي إلى سجاز قرية قرب بخارى قلت: قال ياقوت براء آخره وبمهملة آخره إلى سجاس بلد بين همدان وأبهر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السجزي (@)(@@) بالكسر والسكون وزاي إلى سجستان على غير قياس وقد يقال سجستاني بكسرتين وسكون.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السجلماسي (@)(@@) بكسرتين وسكون اللام إلى سجلماسة مدينة بالغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السجليني (@)(@@) بكسرات وتشديد اللام إلى سجلين قرية بعسقلان.(@)(@@)(@@)(@@) || باب السين والحاء(@)(@@)(@@)(@@) $DIC_NIS$ السحتني (@)(@@) بفتح أوله والفوقية بينهما مهملة ساكنة آخره نون إلى سحتن لقب جشم بن عوف بن خزيمة.(@)(@@)(@@)(@@) $DIC_NIS$ السحري (@)(@@) بالكسر والسكون. PageV01P133(@)(@@)(@@)(@@) $DIC_NIS$ السحمي (@)(@@) بالضم والسكون إلى سحمة بطن من ثعلبة.(@)(@@)(@@)(@@) $DIC_NIS$ السحولي (@)(@@) بالفتح والضم إلى سحول قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ السحيتي (@)(@@) بالضم والفتح وسكون التحتية وفوقية إلى سحيت جد وبالميم إلى سحيم بطن من بني حنيفة.(@)(@@)(@@)(@@) || باب 
ms84	 السين والخاء(@)(@@)(@@)(@@) $DIC_NIS$ السخبري (@)(@@) بفتح أوله والموحدة وسكون المعجمة بينها آخره راء إلى سخبرة جد.(@)(@@)(@@)(@@) $DIC_NIS$ السختاني (@)(@@) بالفتح والسكون وفوقية إلى سختان جد.(@)(@@)(@@)(@@) $DIC_NIS$ السختوني (@)(@@) مثله بضم الفوقية إلى سختونة جد.(@)(@@)(@@)(@@) $DIC_NIS$ السختياني (@)(@@) بكسر أوله والفوقية وتخفيف التحتية إلى عمل السختيان وبيعه وهو جلود الضأن.(@)(@@)(@@)(@@) $DIC_NIS$ السخلي (@)(@@) بالفتح والسكون إلى سخلة أم قيس بن عبد الله بن غنم.(@)(@@)(@@)(@@) $DIC_NIS$ السخوي (@)(@@) بفتحتين إلى سخا قرية بمصر.(@)(@@)(@@)(@@) || باب السين والدال(@)(@@)(@@)(@@) $DIC_NIS$ السدري (@)(@@) بالكسر وسكون الدال المهملة وراء إلى السدر المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ السدوسي (@)(@@) بالفتح والضم إلى سدوس بن شيبان وبضمتين إلى سدوس بن أصبغ بن أبي عبيد بن ربيعة بن نصر بن سعد بن نبهان الطائي وليس في العرب سدوس بالضم غيره.(@)(@@)(@@)(@@) $DIC_NIS$ السديوري (@)(@@) بفتح أوله والواو وكسر المهملة وسكون التحتية آخره راء إلى سديور قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السدي (@)(@@) بالضم والتشديد إلى سدة جامع أي بابه لأنه كان يبيع عنده.(@)(@@)(@@)(@@) || باب السين والذال(@)(@@)(@@)(@@) $DIC_NIS$ السذابي (@)(@@) بفتح أوله والمعجمة آخره موحدة إلى السذاب نوع من البقول.(@)(@@)(@@)(@@) || باب السين والراء(@)(@@)(@@)(@@) $DIC_NIS$ السراج (@)(@@) بالتشديد إلى عمل السروج. PageV01P134(@)(@@)(@@)(@@) $DIC_NIS$ السراقوسي (@)(@@) بالفتح وضم القاف إلى سراقوس مدينة بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ السراقي (@)(@@) بالضم إلى سراقة بن مالك بن جعشم.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السرتي (@)(@@) بالضم والسكون وفوقية إلى سرته مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السرجسي (@)(@@) بالفتح والسكون وكسر الجيم ومهملة إلى سرجس جد.(@)(@@)(@@)(@@) $DIC_NIS$ السرحي (@)(@@) بالفتح والسكون ومهملة إلى أبي سرح العامري والسرح جد.(@)(@@)(@@)(@@) $DIC_NIS$ السرخسي (@)(@@) بفتحتين وسكون المعجمة ومهملة إلى سرخس مدين بخراسان.(@)(@@)(@@)(@@) $DIC_NIS$ السرخكتي (@)(@@) بالضم والسكون وفتح المعجمة والكاف وفوقية إلى سرخكت قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ السرخكي (@)(@@) مثله بلا تاء إلى سرخك قرية على باب نيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ السردري (@)(@@) بفتح أوله والدال المهملة وسكون الراء الأولى إلى سردرى قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السرفقاني (@)(@@) بضم أوله والفاء وفتح القاف إلى سرفقان قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ السرقسطي (@)(@@) بفتحتين وضم القاف وسكون المهملة إلى سرقسطة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ السركي (@)(@@) بالفتح والسكون إلى سرك قرية بطرس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السركاني (@)(@@) بالكسر والسكون إلى سركان من عمل همذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السرماري 
ms85	 (@)(@@) بالضم والسكون آخره راء إلى سرمارى قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السرمدي (@)(@@) بفتح أوله والميم ثم مهملة إلى سرمد جد قلت: وموضع بحلب.(@)(@@)(@@)(@@) $DIC_NIS$ والسرميني (@)(@@) بالفتح والسكون إلى سرمين بلد بحلب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السروجي (@)(@@) بالفتح والضم آخره إلى سروج بلد بنواحي حران.(@)(@@)(@@)(@@) $DIC_NIS$ السروي (@)(@@) بفتحتين مرت في الساري وبسكون الراء إلى سرو أردبيل من أذربيجان والسرو ناحية تلي مكة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ السرنجاني (@)(@@) بالضم والكسر وسكون النون الأولى وجيم إلى سرنجان قرية بأصبهان. PageV01P135(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السرنوي (@)(@@) بالضم والسكون إلى سرنو قرية بأستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ والسرني (@)(@@) كذلك إلى سرنة موضع بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والسروري (@)(@@) بالضم إلى سرور مدينة بقهستان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السريجي (@)(@@) مصغرا إلى سريج جد وبنسة الطلاق السريجية إلى العباس بن سريج لأنه مخترعها.(@)(@@)(@@)(@@) $DIC_NIS$ السريعي (@)(@@) بالفتح والكسر آخره مهملة إلى بني سريع بطن من المعافر.(@)(@@)(@@)(@@) $DIC_NIS$ السريني (@)(@@) بالكسر وفتح الراء المشددة وتحتية ونون إلى السرين بلد عند جدة بنواحي مكة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ السري (@)(@@) بالضم والتشديد إلى سر قرية بالري.(@)(@@)(@@)(@@) || باب السين والعين(@)(@@)(@@)(@@) $DIC_NIS$ السعتري (@)(@@) بفتح أوله والفوقية وسكون المهملة إلى بيع السعتر المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ السعداني (@)(@@) بالفتح والسكون ومهملة إلى سعدان جد.(@)(@@)(@@)(@@) $DIC_NIS$ السعدوني (@)(@@) مثله إلى سعدون جد.(@)(@@)(@@)(@@) $DIC_NIS$ السعدي (@)(@@) إلى سعد بن بكر بن هوازن وسعد تميم وسعد الأنصار وسعد جذام وسعد خولان وسعد تجيب وسعد بن أبي وقاص وسعد بن عبد شمس وسعد هذيم من قضاعة وسعد بن ليث وسعد بن بكر بن عبد مناة بن كنانة وسعد بن كعب بطن من خزاعة قلت: وإلى السعديين قرية قرب المهدية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السعيدي (@)(@@) مكبرا إلى سعيد جد.(@)(@@)(@@)(@@) || باب السين والغين(@)(@@)(@@)(@@) $DIC_NIS$ السغدي(@)(@@) بالضم وسكون المعجمة إلى سغد ناحية بسمرقند.(@)(@@)(@@)(@@) || باب السين والفاء(@)PageV01P136(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السفاقسي (@)(@@) بفتح أوله والفاء وضم القاف ومهملة إلى سفاقس مدينة بنواحي إفريقية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السفالي (@)(@@) بالكسر وفاء ولام إلى ذي سفال قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ السفرادني (@)(@@) بالضم وسكون الفاء وفتح الراء والمهملة ونون إلى سفرادن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السفرجلي (@)(@@) بفتح أوله والفاء والجيم إلى سفرجلة جد.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms86	 السفرمرطي (@)(@@) بفتح أوله والفاء والميم وسكون الراءين إلى سفرمرطا قرية بحران.(@)(@@)(@@)(@@) $DIC_NIS$ السفطي (@)(@@) بالفتح والسكون إلى سفط القدور قرية بأسفل مصر.(@)(@@)(@@)(@@) $DIC_NIS$ السفياني (@)(@@) بالضم والسكون إلى سفيان جد ومذهب سفيان الثوري وبالكسر إلى سفيان قرية بهراة.(@)(@@)(@@)(@@) || باب السين والقاف(@)(@@)(@@)(@@) $DIC_NIS$ السقاء (@)(@@) إلى سقي الماء.(@)(@@)(@@)(@@) $DIC_NIS$ السقباني (@)(@@) بالفتح وسكون القاف وموحدة إلى سقبا قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السقطي (@)(@@) بفتحتين وقاف إلى بيع السقط.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السقيدنجي (@)(@@) بالفتح والكسر إلى سقيدنج قرية بمرو انتهى.(@)(@@)(@@)(@@) || باب السين والكاف(@)(@@)(@@)(@@) $DIC_NIS$ السكاني (@)(@@) بفتحتين ونون إلى سكان قرية بالسغد: قلت: السكاكي: بالفتح والتشديد يسميه أبو حيان في الارتشاف ابن السكاك فهو إلى جده وكأنه إلى صنعة السكة التي يضرب بها الدرهم انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السكبياني (@)(@@) إلى سكبيان قرية ببخارى قلت: هو بالفتح والسكون وكسر الموحدة وتحتية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السكجكثي (@)(@@) بكسرتين وجيم وكاف مفتوحة ومثلثة إلى سكجكث قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السكري (@)(@@) بالضم والتشديد إلى بيع السكر وبالكسر والسكون إلى سكر جد.(@)(@@)(@@)(@@) $DIC_NIS$ السكسكي (@)(@@) بفتح المهملتين وسكون الكاف الأولى إلى السكاسك بطن من كندة. PageV01P137(@)(@@)(@@)(@@) $DIC_NIS$ السكشي (@)(@@) بكسرتين ومعجمة إلى سكة سكش بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ السكلكندي (@)(@@) بكسرتين وفتح الكاف الثانية ونون ساكنة ومهملة إلى سكلكند بلد بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ السكنداني (@)(@@) بالضم والفتح ونون ساكنة ومهملة إلى سكندان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السكني (@)(@@) بفتحتين إلى سكن جد.(@)(@@)(@@)(@@) $DIC_NIS$ السكوني (@)(@@) بالفتح والضم إلى السكون بطن من كندة.(@)(@@)(@@)(@@) || باب السين واللام(@)(@@)(@@)(@@) $DIC_NIS$ السلسبيلي (@)(@@) إلى سلسبيل بوزن عين الجنة اسم لخصي مولى.(@)(@@)(@@)(@@) $DIC_NIS$ السلطيسي (@)(@@) بالفتح والسكون والكسر تحته ساكنة ومهملة إلى سلطيس قرية بمصر قلت قال ياقوت: بضم أوله وفتح الطاء انتهى.(@)(@@) السلعي بالفتح والسكون ومهملة أبو يعقوب السدوسي إلى سلعة بقفاه.(@)(@@)(@@)(@@) $DIC_NIS$ السلفي (@)(@@) بفتحتين وفاء إلى مذهب السلف وبضم أوله إلى سلف بطن من الكلاع وبكسره إلى سلفة جد الحافظ أبي طاهر.(@)(@@)(@@)(@@) $DIC_NIS$ السلقي (@)(@@) بالكسر والسكون وقاف إلى درب السلق ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السلماسي (@)(@@) بفتحات آخره مهملة إلى سلماس مدينة بأذربيجان.(@)(@@)(@@)(@@) $DIC_NIS$ السلماني (@)(@@) بالفتح والسكون وقيل بالفتح أيضا إلى سلمان حي من مراد وبطن من همدان 
ms87	 وتميم.(@)(@@)(@@)(@@) $DIC_NIS$ السلماناني (@)(@@) بالفتح والسكون إلى سلمانان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السلمسيني (@)(@@) بفتحتين وسكون الميم وكسر المهملة إلى سلمسين قرية قرب حران.(@)(@@)(@@)(@@) $DIC_NIS$ السلمقاني (@)(@@) بالفتح والسكون وضم الميم وقاف إلى سلمقان قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ السلمي (@)(@@) بالفتح والسكون إلى سلم جد وبالضم والفتح إلى سليم قبيلة مشهورة منها العباس بن مرداس والعرباض بن سارية وبفتحتين إلى سلمة بكسر اللام بطن من الأنصار وكسرها المحدثون أيضا في النسبة وإلى سلمية PageV01P138(@)(@@) مدينة بالشام وإلى سلمة بن مالك بالفتح بطن من كندة وسلمة بن عمرو بطن من جعفي.(@)(@@)(@@)(@@) $DIC_NIS$ السلموني (@)(@@) بالفتح والسكون والضم إلى سلمويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السلوقي (@)(@@) إلى سلوق قرية باليمن إليها الدروع والكلاب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السلولي (@)(@@) بالفتح والضم إلى بني سلول بنت ذهل بن شيبان.(@)(@@)(@@)(@@) $DIC_NIS$ السلهمي (@)(@@) بفتح أوله والهاء إلى سلهم بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ السليحي (@)(@@) بالضم وبالفتح والكسر وصححه ابن الأثير وتحتية ساكنة ومهملة إلى سليح بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ السليطي (@)(@@) بالفتح والكسر إلى سليط جد.(@)(@@)(@@)(@@) $DIC_NIS$ السليعي (@)(@@) بالضم والفتح آخره مهملة إلى سليع جد.(@)(@@)(@@)(@@) $DIC_NIS$ السليماني (@)(@@) إلى سليمان جد وسليمان ين جرير رأس السليمانية من الزيدية.(@)(@@)(@@)(@@) $DIC_NIS$ السليماناباذي (@)(@@) مثله بفتح النون ثم الموحدة ثم معجمة إلى سليماناباذ موضع بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ السليمي (@)(@@) بالفتح والكسر إلى سليم درب ببغداد وسليمة بطن من الأزد وبالضم والفتح إلى قبيلة بني سليم.(@)(@@)(@@)(@@) $DIC_NIS$ السلي (@)(@@) بالفتح والتشديد إلى بني سلى بن رفاعة بن عذرة.(@)(@@)(@@)(@@) || باب السين والميم(@)(@@)(@@)(@@) $DIC_NIS$ السماعي (@)(@@) بالفتح إلى سماعة جد.(@)(@@)(@@)(@@) $DIC_NIS$ السماقي (@)(@@) بالضم والتشديد وقاف إلى السماق.(@)(@@)(@@)(@@) $DIC_NIS$ السماك (@)(@@) إلى السمك.(@)(@@)(@@)(@@) $DIC_NIS$ السمالي (@)(@@) بالفتح والتشديد ولام إلى سمال بطن من سليم. PageV01P139(@)(@@)(@@)(@@) $DIC_NIS$ السمان (@)(@@) إلى السمن.(@)(@@)(@@)(@@) $DIC_NIS$ السمتي (@)(@@) بالفتح والسكون وفوقية يوسف بن خالد الكذاب سمي به لسمته وهيئته.(@)(@@)(@@)(@@) $DIC_NIS$ السمحي (@)(@@) بفتحتين ومهملة إلى سمحة بطن من كلب وبسكون الميم إلى سمح جد.(@)(@@)(@@)(@@) $DIC_NIS$ السمذي (@)(@@) بكسرتين وتشديد الميم إلى السمذ وهو الخبز الأبيض يعمل للخواص.(@)(@@)(@@)(@@) $DIC_NIS$ السمرقندي (@)(@@) إلى سمرقند مدينة بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ السمري (@)(@@) بالفتح والضم إلى سمرة بن جندب وبالكسر وفتح 
ms88	 الميم المشددة إلى بلد بين واسط والبصرة قلت: اسمهما سمر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السمسطائي (@)(@@) بكسرتين وسكون المهملة إلى سمسطا قرية بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ السمسي (@)(@@) بكسر المهملتين إلى السمسم المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ السمعاني (@)(@@) بالفتح والسكون إلى سمعان جد وبطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ السمعوني (@)(@@) بالفتح والسكون إلى سمعون جد.(@)(@@)(@@)(@@) $DIC_NIS$ السمعي (@)(@@) بالكسر والسكون إلى السمع بن مالك بن زيد بطن من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السملوطي (@)(@@) بفتحتين وتشديد اللام إلى سملوط قرية بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السمناني (@)(@@) بالكسر والسكون ونونين إلى سمنان بلد بين الدامغان وخوار الري وقرية بنسا أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ السمنجاني (@)(@@) بكسرتين وسكون النون الأولى وجيم إلى سمنجان بلد وراء بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ السمنطاري: قلت (@)(@@) إلى سمنطار قرية بجزيرة صقلية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السمنكي (@)(@@) بالكسر والسكون وفتح النون إلى سمنك بلد متصل بسمنان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السمنودي (@)(@@) إلى سمنود بلد بمصر على طريق دمياط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السموي (@)(@@) بالفتح وضم الميم المشددة إلى سمويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ السميجني (@)(@@) بفتح أوله والجيم وكسر الميم إلى سحيجن قرية بسمرقند. PageV01P140(@)(@@)(@@)(@@) $DIC_NIS$ السميرمي (@)(@@) بالضم والفتح إلى سميرم بلد آخر حدود أصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ السميساطي (@)(@@) بالضم وفتح الميم والمهملة بينهما تحتية ساكنة إلى سميساط بلد بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ السميكي (@)(@@) بالضم والفتح إلى سميكة جد.(@)(@@)(@@)(@@) || باب السين والنون(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السناباذي (@)(@@) إلى سناباذ قرية بطوس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السناجي (@)(@@) بفتح أوله والنون وجيم إلى سناجية قرية بعسقلان.(@)(@@)(@@)(@@) $DIC_NIS$ السناني (@)(@@) بالكسر إلى سنان جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السنياطي (@)(@@) بالضم وسكون النون وموحدة إلى سنباط بلد من الغربية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السنبسي (@)(@@) بكسر أوله والموحدة بينهما نون ساكنة آخره مهملة إلى سنبس قبيلة من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ السنبلاني (@)(@@) بضم أوله والموحدة إلى سنبلان محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السنتري (@)(@@) إلى سنترية بلد قرب الفيوم.(@)(@@)(@@)(@@) $DIC_NIS$ والسنجاباذي (@)(@@) إلى سنجاباذ بالكسر قرية بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السنجاري (@)(@@) بالكسر والسكون وجيم إلى سنجار مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ السنجاني (@)(@@) بالفتح وسكون النون الأولى وجيم إلى باب سنجان قرية بمرو وبالكسر إلى سنجان جد.(@)(@@)(@@)(@@) $DIC_NIS$ السنجبستي (@)(@@) بفتح أوله والجيم والموحدة وسكون النون والمهملة الثانية وفوقية إلى سنج بست منزل بين 
ms89	 نيسابور وسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ السنجديزكي (@)(@@) بفتح أوله والجيم والزاي وكسر المهملة ثم تحتية إلى سنجديزة محلة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ السنجفيني (@)(@@) بالفتح والسكون وضم الجيم وكسر الفاء وتحتية ونون إلى سنجفين قرية بأسروشنة.(@)(@@)(@@)(@@) $DIC_NIS$ السنجوردي (@)(@@) بفتح أوله والواو وسكون النون والراء وضم الجيم آخره مهملة إلى سنجورد محلة ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ السنجي (@)(@@) بالكسر والسكون وجيم إلى سنج PageV01P141 قرية بمرو وبالضم ومهملة آخره إلى السنج موضع بالمدينة.(@)(@@)(@@)(@@) $DIC_NIS$ السندواني (@)(@@) بكسر أوله والمهملة إلى السندية قرية بنواحي بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السندي (@)(@@) بالكسر إلى السند من بلاد الهند.(@)(@@)(@@)(@@) $DIC_NIS$ السنقي (@)(@@) بالفتح والسكون وقاف إلى سنقة لقي جده أوله والكاف والموحدة وآخره مثلثة إلى سنكباث قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ السنكديزكي (@)(@@) بفتح أوله والكاف الأولى والزاي وكسر الدال المهملة إلى سنكديزة قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السنكلومي (@)(@@) بفتح أوله والكاف وسكون النون إلى سنكلوم قرية بمصر ويقال زنكلون على الألسنة وهو خطأ.(@)(@@)(@@)(@@) $DIC_NIS$ والسنهوري (@)(@@) بالفتح إلى سنهور بلد قرب اسكندرية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السني (@)(@@) بالضم والتشديد إلى السنة ضد البدعة وبالكسر إلى السن قرية ببغداد وبالري أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ السنيحي (@)(@@) بالفتح والكسر وتحتية وجيم إلى سنيج قلت: مدينة من عمل كرمان.(@)(@@)(@@)(@@) $DIC_NIS$ والسنيكي (@)(@@) إلى سنيكة قرية بمصر انتهى.(@)(@@)(@@)(@@) || باب السين والواو:(@)(@@)(@@)(@@) $DIC_NIS$ السوادي(@)(@@) بالضم والتخفيف ومهملة إلى سواديزة قرية بنخشب وسواد بطن من بلي وبالفتح إلى سواد العراق.(@)(@@)(@@)(@@) $DIC_NIS$ السوارقي (@)(@@) بالضم والتخفيف وكسر الراء وقاف إلى السوارقية قرية بالمدينة.(@)(@@)(@@)(@@) $DIC_NIS$ السواق (@)(@@) بالتشديد إلى بيع السويق. PageV01P142(@)(@@)(@@)(@@) $DIC_NIS$ السوائي (@)(@@) بالضم والتخفيف والهمز إلى سواة بن عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ السوبخي (@)(@@) بالضم وفتح الباء الموحدة ومعجمة إلى سوبخ قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) السوبيني ...(@)(@@)(@@)(@@) $DIC_NIS$ السوتخني (@)(@@) بالضم وسكون الواو والفوقية وفتح المعجمة ونون إلى سوتخن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السوذاني (@)(@@) بالضم ومعجمة إلى سوذان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ السوذرجاني (@)(@@) بالضم وفتح المعجمة والجيم وسكون الراء إلى سوذرجان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ السورابي (@)(@@) بالضم وراء موحدة إلى سورب قرية باسترباذ.(@)(@@)(@@)(@@) $DIC_NIS$ السورياني (@)(@@) بالضم وسكون الواو وراء وتحتية إلى سوريان قرية نيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ السوريني (@)(@@) بالضم وكسر الراء إلى سورين جد قلت: وقرية بنيسابور 
ms90	 انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السوري (@)(@@) بالضم إلى بن السورين موضع ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السوسقاني (@)(@@) بفتح المهملتين والقاف إلى سوسقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السوسنجردي (@)(@@) بالضم وفتح السين الثانية وسكون النون والراء وكسر الجيم آخره مهملة إلى سوسنجرد قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السوسي (@)(@@) بالضم آخره مهملة إلى السوس مدينة بخوزستان وجد وسوسة مدينة بالمغرب.(@)(@@)(@@)(@@) $DIC_NIS$ السوطي (@)(@@) بالفتح إلى عمل السوط وبيعه.(@)(@@)(@@)(@@) $DIC_NIS$ السومي (@)(@@) بالفتح إلى بني سوم بطن من السكون.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السونخي (@)(@@) إلى سونخ قرية بنسف. PageV01P143(@)(@@)(@@)(@@) $DIC_NIS$ والسوهائي (@)(@@) إلى سوهاي قرية بإخميم انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السويدائي (@)(@@) بالضم وفتح الواو والمهملة بينهما تحتية ساكنة إلى السويداء من ضياع حوران.(@)(@@)(@@)(@@) $DIC_NIS$ السويدي (@)(@@) مثل إلى سويد رجل.(@)(@@)(@@)(@@) $DIC_NIS$ السويفي (@)(@@) بوزنه وفاء إلى ... انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السويقي (@)(@@) مكبرا بقاف إلى بيع السويق وبالتصغير إلى سويقة الصغد موضع بمرو.(@)(@@)(@@)(@@) || باب السين والهاء(@)(@@)(@@)(@@) $DIC_NIS$ السهربي (@)(@@) بضم أوله والراء وموحدة إلى سهرب جد.(@)(@@)(@@)(@@) $DIC_NIS$ السهرجي (@)(@@) بضم أوله وفتح الراء وكسرها وجيم إلى سهرج قرية ببسطام.(@)(@@)(@@)(@@) $DIC_NIS$ السهرودي (@)(@@) بضم أوله وسكون الهاء وفتح الراء والواو وسكون الراء المهملة إلى سهرورد بلد عند زنجان.(@)(@@)(@@)(@@) $DIC_NIS$ السهلوي (@)(@@) بالفتح وضم اللام إلى سهل وسهلويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ السهمي (@)(@@) بالفتح والسكون إلى سهم بن عمرو بن هصيص بن كعب بن لؤي وسهم بطن من باهلة ومن سليم. PageV01P144(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السهواجي (@)(@@) إلى سهواج بالفتح والسكون وجيم قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ والسهيلي (@)(@@) إلى سهيل مصغرا قرية بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ [والسهيلي] (@)(@@) بالفتح والتشديد إلى عمل السلة وبيعها السلاماني:(@)(@@)(@@)(@@) || باب السين واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ السلاحي (@)(@@) بالكسر إلى سوق السلاح ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السلاقي (@)(@@) بالضم وقاف إلى سلاقة بطن من يني سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ السلال (@)(@@) بالفتح إلى سلامان بطن من الأزد ومن جعفي ومن طيء ومن قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ السلامي (@)(@@) بالفتح والتخفيف إلى سلامان بطن من قضاعة وإلى مدينة السلام بغداد منهم الحافظ ابن ناصر وإلى سلام جد وسلامة بطن من كلب قلت: وبالتشديد إلى السلامية قرية بالموصل انتهى.(@)(@@)(@@)(@@) || باب السين والياء(@)(@@)(@@)(@@) $DIC_NIS$ السياري (@)(@@) بالفتح وتشديد التحتية إلى سيار جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيازي (@)(@@) بالكسر والتخفيف وزاي إلى سيازة 
ms91	 قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ السيالي (@)(@@) بالفتح والتشديد ولام إلى سيال جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيباني (@)(@@) بالفتح والسكون وموحدة إلى سبيان بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ السيبي (@)(@@) بالكسر والسكون وموحدة إلى سيب قرية بنواحي قصر اين هبيرة.(@)(@@)(@@)(@@) $DIC_NIS$ السيجي (@)(@@) بوزنه وجيم إلى سيج جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيحاني (@)(@@) بالفتح والسكون ومهملة إلى سيحان جد الأخطل.(@)(@@)(@@)(@@) $DIC_NIS$ السيدي (@)(@@) بالفتح وتشديد الياء المكسورة إلى السيد جد وبالكسر والسكون إلى السيد بطن من ضبة.(@)(@@)(@@)(@@) $DIC_NIS$ السيرافي (@)(@@) بالكسر وفاء إلى سيراف بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ السيرجاني (@)(@@) بالكسر وفتح الراء والجيم إلى سيرجان مدينة بكرمان.(@)(@@)(@@)(@@) $DIC_NIS$ السيرواني (@)(@@) بوزنه قلت: إلى سيروان كورة بالجبل وقرية بنسف أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ والسيري (@)(@@) بالفتح والسكون إلى سير بلد باليمن انتهى. PageV01P145(@)(@@)(@@)(@@) $DIC_NIS$ السيريني (@)(@@) بالكسر إلى والد محمد بن سيرين وجد آخر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: السيزجي (@)(@@) بزاي وجيم إلى سيزج قرية بسجستان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ السيسري (@)(@@) بفتح المهملتين بينهما تحتية ساكنة إلى سيسر جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيسمراباذي (@)(@@) بالكسر والسكون وفتح المهملة والميم والراء والموحدة آخره معجمة إلى سيسمراباذ قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ السيسني (@)(@@) بالكسر والسكون وفتح المهملة ونون إلى سيسن جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيفي (@)(@@) إلى سيف رجل.(@)(@@)(@@)(@@) $DIC_NIS$ السيقذنجي (@)(@@) بالكسر وفتح القاف والمعجمة ونون ساكنة وجيم إلى سيقذنج قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السيلحيني (@)(@@) بفتح أوله واللام وكسر المهملة وسكون التحتيتين ونون آخره إلى سيلحين قرية بسواد بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ السيمجوري (@)(@@) بالكسر وسكون الياء والميم وضم الجيم آخره راء إلى سيمجور جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيناني (@)(@@) بالكسر وسكون الياء وفتح النون إلى سينان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ السيني (@)(@@) إلى سين بلفظ حرف الهجاء قرية على باب أصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ السينيزي (@)(@@) بكسر أوله والنون بين تحتيتين ساكنتين ثم زاي إلى سينيز قرية على ساحل بحر فارس.(@)(@@)(@@)(@@) $DIC_NIS$ السيوري (@)(@@) بضمتين إلى عمل سيور الجلد المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ السيوطي (@)(@@) مر في الألف والسين.(@)(@@)(@@)(@@) $DIC_NIS$ السيوي (@)(@@) بالفتح وضم المشددة إلى سيويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ السيلاني (@)(@@) بفتحات إلى سيلان قلت: جزيرة سرنديب انتهى.(@)(@@)(@@)(@@) | حرف الشين المعجمة(@)(@@)(@@)(@@) || باب الشين والألف(@)(@@)(@@)(@@) $DIC_NIS$ الشاباي (@)(@@) إلى شاباي قرية بمرو انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشابجني (@)(@@) بسكون الموحدة وفتح الجيم ونون إلى شابجن قرية بالسغد. PageV01P146(@)(@@)(@@)(@@) $DIC_NIS$ الشابراباذي 
ms92	 (@)(@@) بفتح الموحدتين والراء آخره معجمة إلى شابزاباذ قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشابرخواستي (@)(@@) إلى شابرخواست انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشابرنجي (@)(@@) بسكون الموحدة والنون وكسر الراء وجيم إلى شابرنج قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الشابورتزي (@)(@@) بضم الموحدة وسكون الواو والراء وفتح الفوقية وزاي إلى شابورتزة قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الشابوري (@)(@@) بالراء إلى شابور جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشابهاري (@)(@@) بضم الباء الموحدة وراء إلى شابهار قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشاتاني (@)(@@) بفوقية إلى شاتان قلعة بديار بكر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاذاني (@)(@@) بمعجمة إلى شاذان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشاذكوني (@)(@@) بفتح المعجمة وضم الكاف إلى شاذكونة وهي المضربات الكبار لبيعها وبالهاء آخره إلى شاذكوه ناحية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الشاذلي (@)(@@) انتهى. PageV01P147(@)(@@)(@@)(@@) $DIC_NIS$ الشاذماني (@)(@@) بسكون المعجمة إلى شاذمانة قرية بهراة.(@)(@@)(@@)(@@) $DIC_NIS$ الشاذياخي (@)(@@) بسكونها وتحتية وخاء معجمة إلى شاذياخ قرية بنيسابور وقرية شاذخ ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الشاربي (@)(@@) بكسر الراء هو السقاء بلغة أهل بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الشاركي (@)(@@) بفتح الراء إلى شارك بلد بنواحي بلخ وجد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشارمساحي (@)(@@) إلى شارمساح بلد قرب دمياط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاري (@)(@@) إلى الشراة وهم الخوارج.(@)(@@)(@@)(@@) $DIC_NIS$ الشاشي (@)(@@) إلى الشاش مدينة وراء نهر جيهون.(@)(@@)(@@)(@@) $DIC_NIS$ الشاصوني (@)(@@) بضم المهملة ونون إلى شاصونة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشاطبي (@)(@@) بكسر الطاء وموحدة إلى شاطبة مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاطري (@)(@@) بالكسر وراء إلى الشاطر جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشاغوري (@)(@@) بمعجمة إلى الشاغور محلة بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشافعي (@)(@@) رضي الله عنه إلى جده شافع.(@)(@@)(@@)(@@) $DIC_NIS$ الشافسقي (@)(@@) بسكون الفاء وفتح المهملة وقاف إلى شافسق قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشافيائي (@)(@@) بفاء إلى شافيا قرية بواسط.(@)(@@)(@@)(@@) $DIC_NIS$ والشاقي (@)(@@) بقاف إلى شاقة مدينة بصقلية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاقلاني (@)(@@) بسكون القاف إلى شاقلا جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشاكري (@)(@@) بكسر الكاف وراء إلى شاكر بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ الشالنجي (@)(@@) بفتح اللام وسكون النون وجيم إلى بيع الأشياء من الشعر كالمخلاة والحبل والمقود.(@)(@@)(@@)(@@) $DIC_NIS$ الشالوسي (@)(@@) بضم اللام ومهملة إلى شالوس قرية بنواحي آمل طبرستان. PageV01P148(@)(@@)(@@)(@@) $DIC_NIS$ الشالي (@)(@@) بلام إلى الشال قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الشاماتي (@)(@@) بفوقية إلى الشامات ناحية بنيسابور وقرية بالسيرجان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشامكاني (@)(@@) إلى شامكان قرية بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاموخي (@)(@@) بضم الميم وخاء معجمة 
ms93	 إلى شاموخ قرية بنواحي البصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الشامي (@)(@@) إلى بلاد الشأم المعروفة وإلى مسجد الشام ببخارى وإلى الشامة الخال الشاواني: إلى شاوان قرية بمرو الشاوجي: بفتح الواو وجيم إلى شاوجه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشاوخراني (@)(@@) بسكون الواو وفتح الخاء المعجمة والراء إلى شاوخران قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الشاغوري (@)(@@) بسكون الواو وفتح الغين المعجمة وراء إلى شاوغر من ثغور الترك.(@)(@@)(@@)(@@) $DIC_NIS$ الشاوكثي (@)(@@) بضبطه آخره مثلثة إلى شاوكث بلد بالشاش.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشاوي (@)(@@) ... انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشاهدي (@)(@@) إلى شاهد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشاهنبري (@)(@@) بفتح الهاء والموحدة وسكون النون بينهما وراء إلى شاهنبر محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الشاهوي (@)(@@) بالضم إلى شاهويه جد. PageV01P149(@)(@@)(@@)(@@) $DIC_NIS$ الشاهيني (@)(@@) إلى شاهين جد.(@)(@@)(@@)(@@) || باب الشين والباء(@)(@@)(@@)(@@) $DIC_NIS$ الشبابي (@)(@@) بموحدتين إلى سراة بني شبابة من نواحي مكة وشبابة بطن من فهم.(@)(@@)(@@)(@@) $DIC_NIS$ الشبامي (@)(@@) بالكسر إلى شبام مدينة باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الشباني (@)(@@) بالضم آخره نون إلى شبانة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشبراني (@)(@@) إلى شبرانة ثغر بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والشبربي (@)(@@) بالضم إلى شبرب من عمل بلنسية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشبلي (@)(@@) بالكسر والسكون إلى شبلية قرية بأسروشنة.(@)(@@)(@@)(@@) $DIC_NIS$ الشبوي (@)(@@) بضم الموحدة المشددة إلى شبويه جد وبسكونها إلى شبوة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشبيبي (@)(@@) بالفتح وكسر الموحدة الأولى إلى شبيب جد وبطن من بارق ومن بهراء ومحمد بن شبيب رأس الشبيبة من المرجئة.(@)(@@)(@@)(@@) $DIC_NIS$ الشبيلي (@)(@@) مصغرا بلام إلى شبيل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشبيني (@)(@@) بالفتح كسر الموحدة المشددة آخره نون إلى الشبين وهو الصنوبر.(@)(@@)(@@)(@@) $DIC_NIS$ الشبي (@)(@@) بالفتح والتشديد إلى الشب الذي يدبغ به وشبة جد.(@)(@@)(@@)(@@) || باب الشين والتاء(@)(@@)(@@)(@@) $DIC_NIS$ الشتوي (@)(@@) بفتح أوله وضم الفوقية المشددة إلى شتويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشتيمي (@)(@@) مصغرا إلى شتيم بطن من ضبة.(@)(@@)(@@)(@@) || باب الشين والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الشجاعي (@)(@@) بالضم إلى شجاع جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشجبي (@)(@@) بفتح أوله والجيم وموحدة إلى شجب لقب عوف بن كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ الشجري (@)(@@) بوزنه إلى الشجرة قرية بالمدينة وشجرة جد أحمد بن كامل وغيره وبطن من ربيعة بن معاوية.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) أما ابن الشجري PageV01P150(@)(@@)(@@)(@@) $DIC_NIS$ النحوي (@)(@@) فإلى شجرة كانت في دارهم ليس في البلد غيرها انتهى.(@)(@@)(@@)(@@) || باب الشين والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الشحام (@)(@@) إلى بيع 
ms94	 الشحم قلت: وكان الشحامي مثله وتقدم نظائره.(@)(@@)(@@)(@@) $DIC_NIS$ والشحاذي (@)(@@) انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشحبي (@)(@@) بالفتح وسكون المهملة وباء موحدة إلى شحب بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الشحري (@)(@@) بالكسر والسكون وراء إلى شحر وهو شحر عمان قلت: هو صقع بينها وبين عدن انتهى.(@)(@@)(@@)(@@) || باب الشين والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الشخاخي (@)(@@) بالفتح وخاءين معجمتين إلى شخاخ قرية بالشاش.(@)(@@)(@@)(@@) $DIC_NIS$ الشخيري (@)(@@) بكسرتين وإعجام الخاء المشددة وراء إلى الشخير جد.(@)(@@)(@@)(@@) || باب الشين والدال(@)(@@)(@@)(@@) $DIC_NIS$ الشدادي (@)(@@) بتشديد المهملة إلى شداد جد.(@)(@@)(@@)(@@) || باب الشين والذال(@)(@@)(@@)(@@) $DIC_NIS$ الشذائي (@)(@@) بفتح المعجمتين إلى شذا قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الشذوني (@)(@@) بفتح أوله والواو وسكون المعجمة ونون إلى شذونة من أعمال إشبيلية بالأندلس وبضم المعجمة وسكون الواو إلى شذونة ناحية بالأندلس وقيل بالزاي بدل الذال وهو غلط.(@)(@@)(@@)(@@) || باب الشين والراء(@)(@@)(@@)(@@) $DIC_NIS$ الشرابي (@)(@@) إلى الشراب وبيعه بالحاء المهملة إلى شراح جد وبالراء المهملة إلى شرارة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشرجي (@)(@@) بالفتح والسكون وجيم إلى شرجة موضع بنواحي مكة شرفها الله تعالى وبالحاء المهملة إلى شرحة بطن من بني سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ الشرحبيلي (@)(@@) بالضم والفتح وسكون المهملة وكسر الموحدة وتحتية ولام إلى شرحبيل جد. PageV01P151(@)(@@)(@@)(@@) $DIC_NIS$ الشرعبي (@)(@@) بفتح أوله والعين المهملة وموحدة إلى شرعب قبيلة من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الشرغي (@)(@@) بالفتح والسكون ومعجمة إلى شرغ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الشرغياني (@)(@@) بالفتح والسكون وكسر المعجمة وتحتية إلى شرغيان سكة بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الشرفدني (@)(@@) بفتح أوله والراء والدال المهملة قبلها فاء ساكنة بعدها نون إلى شرفدن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الشرفي (@)(@@) بفتحتين وفاء إلى شرف قرية بمصر وبالأندلس أيضا الشرفي: بالفتح والسكون وقاف إلى الشرقية محلة ببغداد والجانب الشرقي بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الشروطي (@)(@@) بضمتين إلى كتابة الشروط وهي الوثائق.(@)(@@)(@@)(@@) $DIC_NIS$ الشرمغولي (@)(@@) بفتح أوله والميم وضم المعجمة ولام إلى شرمغول قرية بنسا.(@)(@@)(@@)(@@) $DIC_NIS$ الشرمقاني (@)(@@) بفتح أوله والميم والقاف إلى شرمقان بلد قرب إسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الشرواني (@)(@@) بالفتح وسكون الراء إلى شروان مدينة بدربند بناها أنوشروان فأسقط أنو تخفيفا.(@)(@@)(@@)(@@) $DIC_NIS$ الشروطي (@)(@@) مر آنفا.(@)(@@)(@@)(@@) $DIC_NIS$ الشروي (@)(@@) بفتحتين إلى الشراة قلت: صقع بالشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشريجي (@)(@@) بالفتح والكسر وجيم إلى شريج.(@)(@@)(@@)(@@) $DIC_NIS$ الشريحي 
ms95	 (@)(@@) مصغرا بمهملة إلى شريح جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشريشي (@)(@@) إلى شريش ككريم مدينة بشذونة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشريفي (@)(@@) مثله بفاء إلى شريف بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الشريكي (@)(@@) مثله إلى شريك بطن من دوس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشيريوني (@)(@@) إلى شريون حصن بالأندلس انتهى.(@)(@@)(@@)(@@) || باب الشين مع الشين(@)(@@)(@@)(@@) $DIC_NIS$ الشيشي (@)(@@) بالضم وتشديد المعجمة إلى شش سكة بجرجان.(@)(@@)(@@)(@@) || باب الشين والطاء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشطنوفي (@)(@@) إلى شطنوف بالفتح وتشديد الطاء بلد بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشطوي (@)(@@) بفتحتين إلى شطا قرية بأرض مصر. PageV01P152(@)(@@)(@@)(@@) $DIC_NIS$ الشطي (@)(@@) بالفتح والتشديد إلى شط الفرات وشط عثمان موضع بالبصرة.(@)(@@)(@@)(@@) || باب الشين والعين(@)(@@)(@@)(@@) $DIC_NIS$ الشعاب (@)(@@) إلى إصلاح الأواني.(@)(@@)(@@)(@@) $DIC_NIS$ الشعباني (@)(@@) بالفتح والسكون إلى شعبان قبيلة من قيس ومن حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الشعبي (@)(@@) مثله إلى شعب بطن من همدان وقال ابن الأثير: من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الشعراني (@)(@@) مثله إلى كثرة شعر الرأس.(@)(@@)(@@)(@@) $DIC_NIS$ الشعيبي (@)(@@) بالتصغير إلى شعيب جد وبالمثلثة آخره إلى شعيث بطن من بلعنبر.(@)(@@)(@@)(@@) $DIC_NIS$ الشعيري (@)(@@) بالفتح والكسر إلى بيع الشعير وباب الشعير محلة بالكرخ.(@)(@@)(@@)(@@) || باب الشين والغين(@)(@@)(@@)(@@) $DIC_NIS$ الشغبي (@)(@@) بالفتح وسكون المعجمة وموحدة إلى شغب واد عنده ضيعة مات بها الزهري قلت: هو خلف وادي القرى انتهى.(@)(@@)(@@)(@@) || باب الشين والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الشفطاني (@)(@@) بفتحات ثانية فاء إلى شفطان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشفقي (@)(@@) بفتحح أوله والفاء وقاف إلى الشفق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشفنيني (@)(@@) بالضم وسكون الفاء وكسر النون وتحتية ونون إلى شفنين لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الشفيقي (@)(@@) بالفتح وكسر الفاء آخره قاف.(@)(@@)(@@)(@@) || باب الشين والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الشقاق (@)(@@) إلى شق الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ الشقاني (@)(@@) بالفتح وتشديد القاف إلى شقان قلت: قرية بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشقري (@)(@@) بفتح أوله والقاف إلى شقرة بكسرها ابن الحارث بن تميم وبالضم والسكون إلى شقرة بطن من عبد القيس وبالفتح والسكون إلى شقرة بن نبت بن أدد أخي عدنان.(@)(@@)(@@)(@@) $DIC_NIS$ الشقصي (@)(@@) بالكسر والسكون ومهملة إلى شقص قرية من سراة بجيلة بنواحي مكة. PageV01P153(@)(@@)(@@)(@@) $DIC_NIS$ الشقوري (@)(@@) بالفتح والضم إلى شقورة ناحية بقرطبة.(@)(@@)(@@)(@@) $DIC_NIS$ الشقيري (@)(@@) بالتصغير إلى شقير جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشقيقي (@)(@@) بالفتح والكسر إلى شقيق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشقي (@)(@@) بالفتح والتشديد إلى شق قرية 
ms96	 بمرو وجد.(@)(@@)(@@)(@@) || باب الشين والكاف(@)(@@)(@@)(@@) $DIC_NIS$ الشكاني (@)(@@) بالكسر إلى شكان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الشكستاني (@)(@@) بكسرتين وسكون المهملة وفتح الفوقية إلى شكستان قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ الشكلي (@)(@@) بالكسر والسكون إلى شكل.(@)(@@)(@@)(@@) $DIC_NIS$ الشكلاني (@)(@@) بفتحات إلى شكلان قرية بمرو.(@)(@@)(@@)(@@) || باب السين واللام(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشلبي (@)(@@) بالكسر والسكون وموحدة إلى شلب مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشلجيكثي (@)(@@) بفتح أوله والكاف وسكون اللام بعدها جيم مكسورة وتحتية آخره مثلثة إلى شلجيكث أي شلج من بلاد طراز من ثغور الترك ظنا.(@)(@@)(@@)(@@) $DIC_NIS$ الشلجي (@)(@@) إلى شلج المذكورة وبالكسر والسكون إلى شلج من قرى عكبرا.(@)(@@)(@@)(@@) $DIC_NIS$ الشلمغاني (@)(@@) بفتح أوله والميم والمعجمة واللام ساكنة إلى شلمغان قرية بنواحي واسط.(@)(@@)(@@)(@@) $DIC_NIS$ الشلومي (@)(@@) إلى شلومة حصن بالأندلس وبالنون إلى شلون ناحية بسرقسطة انتهى.(@)(@@)(@@)(@@) || باب الشين والميم(@)(@@)(@@)(@@) $DIC_NIS$ الشماخي (@)(@@) بالفتح آخره معجمة إلى الشماخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشماسي (@)(@@) بالفتح والتشديد ومهملة إلى باب الشماسية ببغداد وإلى درب شماس سكة بنهر القلائين. PageV01P154(@)(@@)(@@)(@@) $DIC_NIS$ الشمتناني (@)(@@) بفتح أوله والفوقية ثم النون الأولى وسكون الميم إلى شمتنان بلد بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الشمجي (@)(@@) بفتحتين وجيم إلى شمج بن جرم وبسكون الميم وخاء معجمة إلى شمخ بطن من فزارة ومن غنم بن سعد بن هذيل.(@)(@@)(@@)(@@) $DIC_NIS$ الشمري (@)(@@) بالكسر والسكون وراء إلى شمر المرجىء وبفتحتين وتشديد الميم إلى شمر بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ الشمسي (@)(@@) إلى شمس بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشمساني (@)(@@) إلى شمسانية بلد بالخابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشمشاطي (@)(@@) بالكسر والسكون ومعجمة إلى شمشاط بلد قرب آمد.(@)(@@)(@@)(@@) $DIC_NIS$ الشمعي (@)(@@) بالفتح والسكون ومهملة.(@)(@@)(@@)(@@) $DIC_NIS$ الشمكوري (@)(@@) بالفتح والسكون وضم الكاف وراء إلى شمكور حصن من عمل أران.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشمنتاني (@)(@@) إلى شمنتان بلد بالأندلس انتهى. PageV01P155(@)(@@)(@@)(@@) $DIC_NIS$ الشمني (@)(@@) بفتحتين ونون إلى شمن قرية بإستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشمني (@)(@@) بضمتين وتشديد النون إلى شمنة مزرعة بباب قسطنطينة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشميد (@)(@@) بفتح أوله والزاي وكسر الميم والدال بين تحتيتين ساكنتين إلى شميديزة قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الشمبراني (@)(@@) بالفتح والكسر وراء ونون إلى شميران قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الشميكاني (@)(@@) بضبطه إلى شميكان محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الشميهني (@)(@@) بفتح أوله والهاء وكسر الميم 
ms97	 وتحتية ونون إلى شميهن قرية بمرو.(@)(@@)(@@)(@@) || باب الشين والنون(@)(@@)(@@)(@@) $DIC_NIS$ الشناباذي (@)(@@) بالكسر وفتح النون والموحدة ومعجمة إلى شناباذ قرية ببلخ. PageV01P156(@)(@@)(@@)(@@) $DIC_NIS$ الشنإي (@)(@@) بفتحتين وهمزة إلى أزد شنوءة.(@)(@@)(@@)(@@) $DIC_NIS$ الشنبوذي (@)(@@) بفتحتين وضم الموحدة ومعجمة إلى شنبوذ جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشنتري (@)(@@) بفتح أوله والفوقية وسكون النون وكسر الراء إلى شنترين مدينة من عمل باجة.(@)(@@)(@@)(@@) $DIC_NIS$ والشنتمري (@)(@@) بفتح أوله والفوقية إلى شنت مرية حصن بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشنجي (@)(@@) بالكسر والسكون وجيم إلى شنج جد وبالضم وحاء مهملة إلى الشنج جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشنوي (@)(@@) بفتحتين إلى أزد شنوءة.(@)(@@)(@@)(@@) $DIC_NIS$ الشني (@)(@@) بالفتح والتشديد إلى شن بطن من عبد القيس.(@)(@@)(@@)(@@) || باب الشين والواو(@)(@@)(@@)(@@) $DIC_NIS$ الشورابي (@)(@@) بكسر الراء إلى أبي شوارب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشوالي (@)(@@) بالفتح والتشديد ولام إلى شوال قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الشوخناكي (@)(@@) بالضم وسكون الواو والمعجمة وفتح النون إلى شوخناك قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشودري (@)(@@) إلى شودر من عمل جيان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشوذبي (@)(@@) بفتح أوله والمعحمة وموحدة إلى شوذب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشورباني (@)(@@) بالضم وفتح الراء والموحدة إلى شوربان قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الشوكاني (@)(@@) بالضم إلى شوكان بلد بين سرخس وأبيورد.(@)(@@)(@@)(@@) $DIC_NIS$ الشوكري (@)(@@) بفتح أوله والكاف وراء إلى شوكر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشوكي (@)(@@) إلى الشوك المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الشوماني (@)(@@) بالضم إلى شومان من بلاد الصغانيان.(@)(@@)(@@)(@@) $DIC_NIS$ الشونيزي (@)(@@) بالضم وكسر النون وتحتية وزاي إلى الشونيزية مقبرة ببغداد وبيع الشونيز وهي الجبة السوداء.(@)(@@)(@@)(@@) || باب الشين والهاء(@)PageV01P157(@)(@@)(@@)(@@) $DIC_NIS$ الشهدلي (@)(@@) بفتح أوله والمهملة ولام إلى شهدل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشهراني (@)(@@) بفتح أوله وراء إلى شهران بطن من خثعم.(@)(@@)(@@)(@@) $DIC_NIS$ الشهرزوري (@)(@@) بفتح أوله وضم الراء الأولى والزاي إلى شهرزور بلد بين الموصل وهمدان.(@)(@@)(@@)(@@) $DIC_NIS$ الشهرستاني (@)(@@) بفتح أوله والراء وسكون المهملة وفوقية ونون إلى شهرستان بلد عند نسا.(@)(@@)(@@)(@@) $DIC_NIS$ الشلاثاني (@)(@@) بالضم والتخفيف ومثلثة إلى شلاثا قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الشلانجردي (@)(@@) بالضم والتخفيف وسكون النون والراء وكسر الجيم آخره مهملة إلى شلانجرد قرية بطوس.(@)(@@)(@@)(@@) || باب الشين والياء:(@)(@@)(@@)(@@) $DIC_NIS$ الشيائي(@)(@@) : بالكسر وتخفيف التحتية إلى شيا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الشيباني (@)(@@) بالفتح والسكون وموحدة إلى شيبان بن ذهل قبيلة من بكر 
ms98	 بن وائل بن وشيبان العاتك بطن من كندة وشيبان بن محارب بن فهر بن مالك بن النضر بن كنانة وشيبان جد وشيبان بن مسلمة رأس الشيبانية من الخوارج.(@)(@@)(@@)(@@) $DIC_NIS$ الشيبي (@)(@@) بالفتح والسكون إلى شيبة بن عثمان بن طلحة سادن الكعبة وبالكسر والجيم إلى شيخ قرية بمرو وبمهملة إلى شيحة قرية بحلب وبالفتح والمعجمة إلى شيخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرازي (@)(@@) بالكسر آخره زاي إلى شيراز قصبة فارس.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرجي (@)(@@) بالكسر وفتح الراء وجيم إلى بيع الشيرج وهو دهن السمسم.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرزاذي (@)(@@) بالكسر وفتح الراء والزاي آخره معجمة إلى شيرزاد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرزي (@)(@@) بالكسر وفتح الراء وزاي إلى شيرز قرية بنواحي سرخس.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرغارشوني (@)(@@) بالكسر وفتح الراء الأولى PageV01P158 والمعجمة وضم الشين الثانية ونون إلى شيرغارشون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الشيركثي (@)(@@) بالكسر وفتح الراء والكاف ومثلثة إلى شيركث قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الشيرنخشيري (@)(@@) بكسر الشينين وسكون الراء الأولى والخاء المعجمة وفتح النون إلى شيرنخشير قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الشيروي (@)(@@) بالكسر وضم الراء إلى شيرويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشيرواني (@)(@@) إلى شيروان قرية ببخارى انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشيريني (@)(@@) بكسر أوله والراء إلى شيرين.(@)(@@)(@@)(@@) $DIC_NIS$ الشيزري (@)(@@) بفتح أوله والزاي ثم راء إلى شيزر قلعة بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الشيطاني (@)(@@) بالفتح إلى شيطان الطاق وبالكسر إلى شيطا رجل وقد ينسب بلا نون.(@)(@@)(@@)(@@) $DIC_NIS$ الشيظمي (@)(@@) بفتح أوله والظاء المعجمة إلى شيظم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الشيعي (@)(@@) بالكسر والسكون ومهملة إلى شيعة علي بن أبي طالب وشيعة بني العباس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الشيفاني (@)(@@) بالكسر وفاء إلى شيفان قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الشيلماني (@)(@@) بفتح أوله واللام إلى شيلمان مدينة بجيلان.(@)(@@)(@@)(@@) | حرف الصاد المهملة(@)(@@)(@@)(@@) || باب الصاد والألف(@)(@@)(@@)(@@) $DIC_NIS$ الصابري (@)(@@) بفتح الموحدة وراء إلى صابر سكة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الصابوني (@)(@@) إلى عمل الصابون وبيعه.(@)(@@)(@@)(@@) $DIC_NIS$ الصارفي (@)(@@) بكسر الراء هو الصيرفي. PageV01P159(@)(@@)(@@)(@@) $DIC_NIS$ الصاغاني (@)(@@) بمعجمة إلى الصاغانيان بلاد وراء نهر جيهون وإلى صاغان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الصاغرجي (@)(@@) بفتح المعجمة وسكون الراء وجيم إلى صاغرج قرية بالصغد.(@)(@@)(@@)(@@) $DIC_NIS$ الصاقري (@)(@@) بكسر القاف وراء إلى الصاقرية من قرى مصر.(@)(@@)(@@)(@@) $DIC_NIS$ الصالحاني (@)(@@) بسكون اللام ومهملة إلى صالحان محلة بأصبهان. 
ms99	(@)(@@)(@@)(@@) $DIC_NIS$ الصالحي (@)(@@) بكسر اللام إلى صالح جد قلت: وإلى الصالحية قرية بدمشق وبلد أخرى قرب بلبيس ومحلة ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصالقاني (@)(@@) بسكون اللام وقاف إلى صالقان قرية ببلخ وبنون بدل اللام إلى صانقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الصايدي (@)(@@) إلى صايد بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ الصايري (@)(@@) بالراء إلى صاير قرين باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الصائغي (@)(@@) إلى صياغة النقد كالصائغ وإلى سكة الصياغة بنسف.(@)(@@)(@@)(@@) || باب الصاد والباء(@)(@@)(@@)(@@) $DIC_NIS$ الصباحي (@)(@@) بالضم وتخفيف الموحدة ومهملة إلى صباح بطن من ضبة ومن قضاعة ومن عنزة ومن عبد القيس وبالفتح والتشديد إلى الصباح بطن من سهم والحسن بن الصباح.(@)(@@)(@@)(@@) $DIC_NIS$ الصبارحي (@)(@@) بالضم وكسر الراء ومهملة إلى صبارح قرية بإفريقية.(@)(@@)(@@)(@@) $DIC_NIS$ الصبري (@)(@@) بالضم والسكون إلى صبر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الصبغي (@)(@@) بالكسر والسكون إلى الصبغ كالصباغ.(@)(@@)(@@)(@@) || باب الصاد والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الصخراباذي (@)(@@) بفتح أوله والراء والموحدة وسكون الخاء المعجمة آخره معجمة إلى صخراباذ قرية بمرو.(@)(@@)(@@)(@@) || باب الصاد والدال(@)(@@)(@@)(@@) $DIC_NIS$ الصداري (@)(@@) بالضم آخره راء إلى صدار موضع بالمدينة.(@)(@@)(@@)(@@) $DIC_NIS$ الصدائي (@)(@@) مثله بهمز إلى صداء قبيلة من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ الصدري (@)(@@) بفتحتين وراء إلى صدر قرية بالقدس.(@)(@@)(@@)(@@) $DIC_NIS$ الصدفي (@)(@@) بفتحتين وفاء إلى الصدف بكسر الدال المهملة قيبلة من حمير وبقاف إلى سكة صدقة بمرو وصدقة جد. PageV01P160(@)(@@)(@@)(@@) $DIC_NIS$ الصديقي (@)(@@) بالفتح والكسر إلى صديق جد وبكسرتين مشددا إلى أبي بكر الصديق رضي الله تعالى عنه.(@)(@@)(@@)(@@) || باب الصاد والراء(@)(@@)(@@)(@@) $DIC_NIS$ الصراري (@)(@@) بالكسر ومهملتين إلى صرار موضع بالمدينة وبالفتح وتشديد الراء إلى الصرارة وهي النعل التي لها صرير عند المشي أي الصوت.(@)(@@)(@@)(@@) $DIC_NIS$ الصرائي (@)(@@) بالفتح إلى الصراة.(@)(@@)(@@)(@@) $DIC_NIS$ الصراف (@)(@@) بالتشديد هو الصيرفي.(@)(@@)(@@)(@@) $DIC_NIS$ الصرام (@)(@@) إلى بيع الصرم وهو الذي يفعل به الخفاف واللوالك.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصرخدي (@)(@@) إلى صرخد بوزن جوهر بلد بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصرخياني (@)(@@) بالضم والسكون وكسر المعجمة وتحتية إلى صرخيان قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصروفي (@)(@@) إلى صروف بلد باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصرصري (@)(@@) بفتح الصادين وسكون الراء الأولى إلى صرصر قرية على فرسخين من بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الصرفندي (@)(@@) بفتح أوله والراء والفاء وسكون النون ومهملة إلى صرفند قرية بالشام إلى 
ms100	 ساحل البحر.(@)(@@)(@@)(@@) $DIC_NIS$ الصرمنجيني (@)(@@) بالفتح وسكون الراء والنون الأولى وكسر الميم والجيم وتحتية ونون إلى صرمنجان ناحية بترمذ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصروي (@)(@@) إلى الصروات قرى بالحلة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصريفيني (@)(@@) بالفتح وكسر الراء والفاء بين تحتيتين ساكنتين آخره نون إلى صريفين قرية بواسط وأخرى ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الصريمي (@)(@@) مكبرا إلى صريم جد وبالتصغير إلى صريم بطن من تميم ومن نهد ومن تيم الرباب.(@)(@@)(@@)(@@) || باب الصاد والعين(@)PageV01P161(@)(@@)(@@)(@@) $DIC_NIS$ الصعبي (@)(@@) بالفتح والسكون وموحدة إلى صعب بطن من كندة ومن بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ الصعدي (@)(@@) بطم آخره مهملة إلى صعدة بلد باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الصعلوكي (@)(@@) بوزنه أوله واللام إلى صعلوك.(@)(@@)(@@)(@@) $DIC_NIS$ الصعوي (@)(@@) بالفتح والسكون إلى أبي الصعو جد.(@)(@@)(@@)(@@) $DIC_NIS$ الصعيدي (@)(@@) بالفتح والكسر إلى صعيد مصر.(@)(@@)(@@)(@@) || باب الصاد والغين(@)(@@)(@@)(@@) $DIC_NIS$ الصغاني (@)(@@) بالفتح وتخفيف المعجمة إلىالصغانيان.(@)(@@)(@@)(@@) $DIC_NIS$ الصغدي (@)(@@) بالضم والسكون ومهملة إلى صغد سمرقند ويقال بالسين.(@)(@@)(@@)(@@) $DIC_NIS$ الصغيري (@)(@@) بالفتح والكسر إلى جد.(@)(@@)(@@)(@@) || باب الصاد والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الصفار (@)(@@) إلى بيع النحاس وكذا الصفري والصفرية من الخوارج إلى زياد بن الأصفر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصفدي (@)(@@) بفتحتين ومهملة إلى صفد بالشام انتهى.(@)(@@)(@@)(@@) || باب الصاد والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الصقلبي (@)(@@) بفتح أوله وسكون القاف آخره موحدة إلى الصقالبة وهم ولد صقلب بن نبطي.(@)(@@)(@@)(@@) $DIC_NIS$ الصقلي (@)(@@) بفتحتين إلى جزيرة صقلية في بحر الروم.(@)(@@)(@@)(@@) || باب الصاد اللام(@)(@@)(@@)(@@) $DIC_NIS$ الصلبي (@)(@@) بالضم والسكون وموحدة إلى صلب بطن من سامة بن لؤي وبالفتح والفوقية إلى عثمان بن أبي الصلت رأس الخوارج وبهما وتشديد اللام وفتحها إلى صلت قرية من عمل ميافارقين.(@)(@@)(@@)(@@) $DIC_NIS$ الصلحي (@)(@@) بالكسر والسكون ومهملة إلى فم الصلح بلد قرب واسط.(@)(@@)(@@)(@@) $DIC_NIS$ الصلواتي (@)(@@) بفتحات كأنه إلى إكثار الصلاة.(@)(@@)(@@)(@@) $DIC_NIS$ الصليحي (@)(@@) مصغرا بمهملة إلى صليح جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصليقي (@)(@@) إلى الصليق موضع بين بغداد وواسط انتهى.(@)(@@)(@@)(@@) || باب الصاد والميم(@)(@@)(@@)(@@) $DIC_NIS$ الصمصامي (@)(@@) بفتح الصادين إلى الصمصامة وهو السيف.(@)(@@)(@@)(@@) || باب الصاد والنون(@)PageV01P162(@)(@@)(@@)(@@) $DIC_NIS$ الصنابحي (@)(@@) بالضم وفتح النون وكسر الموحدة ومهملة إلى صنابح بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ الصنامي (@)(@@) بالفتح والتشديد إلى صنام جد.(@)(@@)(@@)(@@) $DIC_NIS$ الصندوقي (@)(@@) بضم المهملتين وقاف إلى بيع الصندوق وعمله.(@)(@@)(@@)(@@) $DIC_NIS$ الصنعاني (@)(@@) بالفتح والسكون 