ms3121	 (¬8)، وقرأ الكسائي بالنصب على معنى لأنك (¬9).(@)(@)(@@)(@@)(@@) || AUTO 50(@)(@)(@@) - {إن هذا ما كنتم به تمترون} (¬10)(@)(@@) تشكون ولا تؤمنون (¬11)، فقد لقيتموه فذوقوه (¬12).(@)(@)PageV23P542(@)(@)(@@)(@@)(@@) || CHECK 53(@)(@)(@@)(@@)(@@) || AUTO 51(@)(@)(@@) - قوله تعالى: {إن المتقين فى مقامر أمين(@)(@)(@@)(@@)(@@) || AUTO (51)(@)(@)(@@) }(@)(@@) قرأه (¬1) أهل المدينة والشام بضم الميم من المقام على المصدر، أي: في إقامة (¬2)، وقرأ غيرهم بالفتح، أي: في مكان كريم (¬3).(@)(@)(@@)(@@)(@@) || AUTO 52(@)(@)(@@) - {في جنات وعيون(@)(@)(@@)(@@)(@@) || AUTO (52)(@)(@)(@@) يلبسون من سندس} وهو ما رق من الديباج (¬4) (¬5).(@)(@@) {وإستبرق} وهو ما غلظ منه (¬6)، معرب {متقابلين}(@)(@)(@@)(@@)(@@) || AUTO 54(@)(@)(@@) - {كذلك} أي: كما أكرمناهم بالجنان والعيون واللباس(@)(@@) كذلك أكرمناهم بأن {وزوجناهم بحور} وهن (¬7) {عين} (¬8) النساء النقيات البياض (¬9).(@)(@)PageV23P543(@)(@)(@@) قال مجاهد: يحار فيهن الطرف من بياضهن وصفاء لونهن، بادية سوقهن من وراء ثيابهن، ويرى الناظر وجهه في كبد (¬1) إحداهن، كالمرآة من رقة الجلد وصفاء اللون (¬2).(@)(@@) ودليل هذا التأويل أنها في حرف ابن مسعود: (بعيس عين) (¬3)، وهن (¬4) البيض، ومنه يقال (¬5) للإبل البيض: عيس، وواحده بعير أعيس، وناقة عيساء (¬6).(@)(@@) وقيل: (الحور) الشديدات بياض الأعين، الشديدات سوادها (¬7). واحدها أحور (¬8).(@)(@)PageV23P544(@)(@)(@@) (والعين) جمع العيناء، وهي العظيمة العينين (¬1).(@)(@@) [2692] أخبرنا أبو عبد الله الحسن (¬2) بن محمد بن عبد الله المرتب (¬3)، (حدثنا أبو علي الحسن بن إسماعيل بن خلف الخياط (¬4)، حدثنا أبو بكر محمد بن الحسن) (¬5) بن (¬6) الفرج (¬7) حدثنا محمد بن عبيد بن عبد الملك (¬8)، حدثنا محمد بن يعلي أبو علي الكوفي (¬9)، حدثنا عمر (¬10) بن صبح (¬11)، عن مقاتل بن PageV23P545(@)(@@) حيان (¬1)، عن الأعرج (¬2)، عن أبي هريرة - رضي الله عنه - قال: قال رسول الله - صلى الله عليه وسلم -: "مهور الحور (¬3) العين، قبضات التمر، وفلق الخبز" (¬4).(@)(@@) [2693] وأخبرني الحسين بن محمد (¬5)، حدثنا محمد بن عمر بن إسحاق بن حبش (¬6)، حدثنا عبد الله بن سليمان بن الأشعث (¬7)، حدثنا أيوب بن علي الصباحي (¬8)، حدثنا زياد بن سيار (¬9) (مولى لي) (¬10)، PageV23P546(@)(@@) عن عزة بنت أبي قرصافة (¬1) (¬2)، عن أبيها (¬3) قال: سمعت رسول الله - صلى الله عليه وسلم - يقول: "إخراج القمامة من المسجد (¬4)، مهور الحور العين" (¬5).(@)(@)(@@)(@@)(@@) || AUTO 55(@)(@)(@@) - قوله تعالى: {يدعون فيها بكل فاكهة} اشتهوها (¬6)(@)(@@) {آمنين} من نفادها وعدمها في بعض الأزمنة (¬7)، ومن PageV23P547(@)(@@) غائلتها (¬1) ومضرتها 
ms3122	 (¬2). وقال قتادة: آمنين من الموت، والأوصاب، والشيطان (¬3).(@)(@)(@@)(@@)(@@) || AUTO 56(@)(@)(@@) - {لا يذوقون فيها الموت إلا الموتة الأولى}(@)(@@) يعني: سوى الموتة الأولى، وبعدها وضع (إلا) موضع بعد، كقوله تعالى (¬4): {ولا تنكحوا ما نكح آباؤكم من النساء إلا ما قد سلف} (¬5)(@)(@@) يعني: بعدما قد فعل آباؤكم وسواه، وهذا كما تقول في الكلام: ما ذقت اليوم طعاما سوى ما أكلته أمس (¬6).(@)(@@) {ووقاهم عذاب الجحيم}.(@)(@)(@@)(@@)(@@) || AUTO 57(@)(@)(@@) - {فضلا من ربك ذلك هو الفوز العظيم(@)(@)(@@)(@@)(@@) || AUTO (57)(@)(@)(@@) فإنما يسرناه}(@)(@@) سهلناه، القرآن، كناية عن غير مذكور (¬7).(@)(@@) {بلسانك لعلهم يتذكرون}(@)(@)PageV23P548(@)(@)(@@)(@@)(@@) || AUTO 58(@)(@)(@@) - {فارتقب} فانتظر الفتح والنصر من ربك (¬1)(@)(@@) {إنهم مرتقبون} منتظرون بزعمهم قهرك (¬2).(@)(@)PageV23P549(@)(@)(@@) الكشف والبيان عن تفسير القرآن(@)(@)(@@) تأليف(@)(@@) أبي إسحاق أحمد بن إبراهيم الثعلبي المتوفى سنة 427 ه(@)(@)(@@) أشرف على إخراجه(@)(@@) د/ صلاح باعثمان - د/ حسن الغزالي - أ. د/ زيد مهارش - أ. د/ أمين باشه(@)(@)(@@) [المجلد الرابع والعشرون](@)(@@) [سورة الجاثية إلى آخر الذاريات](@)(@)(@@) تحقيق(@)(@@) د/ هند بنت إبراهيم هزازي(@)(@@) د/ فريدة بنت محمد الغامدي PageV24P001(@)(@@) السيرة الذاتية للمحقق(@)(@@) د/ هند بنت إبراهيم هزازي(@)(@@) حصلت على درجة البكالوريوس في تخصص التفسير وعلوم القرآن من جامعة أم القرى - كلية الدعوة وأصول الدين.(@)(@)(@@) بعض من المناصب الإدارية التي شغلتها:(@)(@@) مدرسة تربية إسلامية - بالمرحلة المتوسطة - العوالي - مكة المكرمة.(@)(@@) * * *(@)(@)(@@) السيرة الذاتية للمحقق(@)(@@) د/ فريدة بنت محمد الغامدي(@)(@@) أستاذ مساعد بجامعة أم القرى - كلية الدعوة وأصول الدين - قسم الكتاب والسنة.(@)(@@) حصلت على درجة الدكتوراه عام 1430 ه في تخصص التفسير وعلوم القرآن من جامعة أم القرى - كلية الدعوة وأصول الدين - قسم الكتاب والسنة، وعنوان الرسالة (ترجيحات أبي حيان الأندلسي في التفسير من أول سورة الأعراف إلى آخرها جمعا ودراسة وموازنة من خلال تفسيرها لبحر المحيط).(@)(@)(@@) لها مؤلفات منشورة أهمها:(@)(@@) 1 - عرض شبهات بعض المعاصرين في الإسراء والمعراج والرد عليها، مجلة كلية التربية - جامعة الأزهر، العدد 135 ج 3، يونيو 2008 م / جماد الثاني 1429 ه.(@)(@@) 2 - الإخلاص في القرآن الكريم، مجلة كلية التربية - جامعة الأزهر، 139 ج 1، يناير 2009 م/ جماد الثاني 1430 ه.(@)(@@) 3 - البغوي 
ms3123	 ومنهجه في تفسير "معالم التنزيل" دراسة مقارنة مع "الكشف والبيان" للثعلبي، مجلة كلية التربية - جامعة الأزهر، العدد 140، مايو 2009 م / جماد أول 1430 ه.(@)(@@) * * *(@)(@)PageV24P002(@)(@)(@@) الكشف والبيان عن تفسير القرآن(@)(@@) [24] PageV24P003(@)(@@) جميع الحقوق محفوظة(@)(@@) رقم الإيداع بدار الكتب 15249/ 2013(@)(@)(@@) الطبعة الأولى(@)(@@) 1436 ه - 2015 م(@)(@)(@@) دار التفسير(@)(@@) جدة - المملكة العربية السعودية(@)(@@) شارع محمود نصيف - حي الأندلس(@)(@@) ص. ب: 122497 - جدة: 21332(@)(@@) تلفاكس: 6688823 - 012(@)(@)PageV24P004(@)(@)(@@)(@@)(@@) | AUTO 45 - سورة الجاثية PageV24P005(@)(@@) سورة الجاثية (¬1)(@)(@@) مكية (¬2)، وهي ألفان ومائة وأحد (¬3) وتسعون حرفا، وأربعمائة وثمان وثمانون كلمة، وسبع وثلاثون آية (¬4).(@)(@@) [2694] أخبرنا أبو الحسن محمد بن القاسم الفقيه (¬5)، أخبرنا أبو عمرو محمد (¬6) بن جعفر بن محمد العدل (¬7)، (حدثنا إبراهيم بن شريك بن الفضل (¬8)، حدثنا أحمد بن عبد الله بن يونس (¬9)، حدثنا PageV24P007(@)(@@) سلام بن سليم (¬1)، حدثنا هارون بن كثير) (¬2)، عن زيد (¬3) بن أسلم (¬4)، أبيه (¬5)، عن أبي أمامة (¬6)، عن أبي بن كعب - رضي الله عنه -، قال: قال رسول الله - صلى الله عليه وسلم -: "من قرأ سورة حم الجاثية ستر الله له عورته، وسكن روعته الحساب" (¬7).(@)(@)PageV24P008(@)(@)(@@) قوله تعالى:(@)(@@) {بسم الله الرحمن الرحيم}(@)(@)(@@)(@@)(@@) || AUTO 1(@)(@)(@@) - {حم(@)(@)(@@)(@@)(@@) || AUTO (1)(@)(@)(@@) تنزيل الكتاب من الله العزيز الحكيم(@)(@)(@@)(@@)(@@) || AUTO (2)(@)(@)(@@) إن في السماوات والأرض لآيات للمؤمنين(@)(@)(@@)(@@)(@@) || AUTO (3)(@)(@)(@@) وفي خلقكم وما يبث من دابة آيات}(@)(@@) قرأ حمزة، والكسائي، ويعقوب بكسر التاء (من آيات) (¬(@)(@)(@@)(@@)(@@) || AUTO 1)(@)(@)(@@) وكذلك التي بعدها (¬(@)(@)(@@)(@@)(@@) || AUTO 2)(@)(@)(@@) ردا على قوله: {لآيات} (¬(@)(@)(@@)(@@)(@@) || AUTO 3)(@)(@)(@@) ، وقرأ الباقون برفعها على خبر حرف الصفة.(@)(@@) {لقوم يوقنون}(@)(@)(@@)(@@)(@@) || AUTO 5(@)(@)(@@) - {واختلاف الليل والنهار وما أنزل الله من السماء من رزق}(@)(@@) يعني الغيث سماه رزقا، لأنه سبب أرزاق العباد وأقواتهم (¬(@)(@)(@@)(@@)(@@) || AUTO 4)(@)(@)(@@) {فأحيا به الأرض بعد موتها وتصريف الرياح آيات لقوم يعقلون}.(@)(@)(@@)(@@)(@@) || AUTO 6(@)(@)(@@) - {تلك آيات الله نتلوها عليك بالحق فبأي حديث بعد الله}(@)(@@) أي: بعد حديث الله وكلامه (¬(@)(@)(@@)(@@)(@@) || AUTO 5)(@)(@)(@@) {وآياته} وحججه وأدلته (¬(@)(@)(@@)(@@)(@@) || AUTO 6)(@)(@)(@@) {يؤمنون} قرأ أهل الكوفة والشام (¬7) بالتاء، واختلف فيه عن عاصم(@)(@)PageV24P009(@)(@)(@@)(@@)(@@) || CHECK 9(@)(@)(@@) ويعقوب (¬1)، و (¬2) غيرهم بالياء (¬3).(@)(@)(@@)(@@)(@@) || AUTO 7(@)(@)(@@) - {ويل لكل أفاك} كذاب (¬4) (¬5) {أثيم}.(@)(@)(@@)(@@)(@@) || AUTO 8(@)(@)(@@) - {يسمع آيات الله تتلى عليه ثم يصر مستكبرا كأن 
ms3124	 لم يسمعها فبشره بعذاب أليم(@)(@)(@@)(@@)(@@) || AUTO (8)(@)(@)(@@) وإذا علم}(@)(@@) (يعني: سمع) (¬6) (¬(@)(@)(@@)(@@)(@@) || AUTO 7)(@)(@)(@@) {من آياتنا شيئا اتخذها هزوا أولئك لهم عذاب مهين} نزلت في أبي جهل وأصحابه (¬(@)(@)(@@)(@@)(@@) || AUTO 8)(@)(@)(@@) .(@)(@)PageV24P010(@)(@)(@@)(@@)(@@) || CHECK 13(@)(@)(@@)(@@)(@@) || AUTO 10(@)(@)(@@) - {من ورآئهم} أمامهم (¬1) {جهنم}(@)(@@) نظيرها في سورة إبراهيم عليه السلام (¬2) {ولا يغني عنهم ما كسبوا} من الأموال (¬3) {شيئا ولا ما اتخذوا من دون الله أولياء} يعني: الأوثان (¬4).(@)(@@) {ولهم عذاب عظيم}.(@)(@)(@@)(@@)(@@) || AUTO 11(@)(@)(@@) - {هذا} يعنى (¬5): القرآن (¬6)(@)(@@) {هدى والذين كفروا بآيات ربهم لهم عذاب من رجز أليم} من عذاب موجع (¬7).(@)(@)(@@)(@@)(@@) || AUTO 12(@)(@)(@@) - قوله تعالى: {الله الذي سخر لكم البحر لتجري الفلك فيه بأمره ولتبتغوا من فضله ولعلكم تشكرون(@)(@)(@@)(@@)(@@) || AUTO (12)(@)(@)(@@) وسخر لكم ما في السماوات وما في الأرض جميعا منه} PageV24P011(@)(@@) فلا تجعلوا لله أندادا (¬1).(@)(@@) [2695] أخبرنا ابن فنجويه (¬2)، حدثنا طلحة (¬3) وعبيد الله (¬4)، قالا: حدثنا ابن مجاهد (¬5)، حدثني ابن أبي مهران (¬6)، حدثني أحمد بن يزيد (¬7)، حدثنا شباب (¬8)، (عن أبي تميلة) (¬9)، عن عبد العزيز بن عمار القرشي (¬10)، حدثني محمد بن عبد (¬11) الله بن أيوب الثقفي (¬12)، عن عثمان بن بشير (¬13)، قال: سمعت ابن عباس - رضي الله عنهما - يقرأ: {وسخر لكم ما في السماوات وما في الأرض جميعا منه} (¬14).(@)(@)PageV24P012(@)(@)(@@) [2696] وبه عن شباب (¬1)، عن ابن عمر (¬2)، قال: سمعت مسلمة (¬3) يقرأ: {وسخر لكم ما في السماوات وما في الأرض جميعا منه} مفتوحة (الميم) مرفوعة (النون) وهي (¬4) مشددة، (والهاء) مضمومة (¬5).(@)(@@) {إن في ذلك لآيات لقوم يتفكرون}.(@)(@)(@@)(@@)(@@) || AUTO 14(@)(@)(@@) - {قل للذين آمنوا يغفروا للذين لا يرجون أيام الله}(@)(@@) أي: لا يخافون وقائع الله، ولا يبالون نقمه (¬6) (¬7).(@)(@)PageV24P013(@)(@)(@@) قال (¬1) ابن عباس - رضي الله عنهما - ومقاتل: نزلت في عمر بن الخطاب - رضي الله عنه - وذلك أن رجلا من بني غفار كان يشتمه، فهم عمر - رضي الله عنه - أن يبطش به، فأنزل الله تعالى هذه الآية، وأمره بالعفو عنه (¬2).(@)(@@) [2697] أخبرني الحسين بن محمد بن عبد الله (¬3)، (حدثنا موسى ابن محمد بن علي بن عبد الله) (¬4)، حدثنا الحسن (¬5) بن علوية (¬6)، حدثنا إسماعيل بن عيسى العطار (¬7)، حدثنا محمد بن زياد اليشكري (¬8)، عن ميمون بن مهران (¬9)، عن ابن عباس 
ms3125	 - رضي الله عنه -، قال: لما نزلت هذه الآية: {من ذا الذي يقرض الله قرضا حسنا} (¬10)، PageV24P014(@)(@@) قال (¬1) يهودي بالمدينة -يقال له: فنحاص: احتاج رب محمد. قال: فلما سمع بذلك (¬2) عمر بن الخطاب - رضي الله عنه - اشتمل على سيفه فخرج في طلبه، فجاء جبريل عليه السلام إلى محمد - صلى الله عليه وسلم - فقال: إن ربك يقول: {قل للذين آمنوا يغفروا للذين لا يرجون أيام الله}، واعلم أن عمر بن الخطاب - رضي الله عنه - قد اشتمل على سيفه، وخرج في طلب اليهودي. فبعث النبي - صلى الله عليه وسلم - في طلبه، فلما جاء، قال: "يا عمر ضع سيفك". قال: صدقت يا رسول الله، أشهد أنك أرسلت بالحق، قال: "إن (¬3) ربك يقول: {قل للذين آمنوا يغفروا للذين لا يرجون أيام الله} "، قال: لا جرم، والذي بعثك بالحق لا يرى الغضب في وجهي (¬4).(@)(@@) وقال القرظي والسدي: نزلت في ناس من أصحاب رسول الله - صلى الله عليه وسلم - من أهل مكة كانوا في أذى شديد من المشركين، قبل أن يؤمروا بالقتال، فشكوا ذلك إلى رسول الله - صلى الله عليه وسلم - فأنزل الله هذه الآية، ثم نسختها آية القتال (¬5).(@)(@)PageV24P015(@)(@)(@@) {ليجزي قوما} (¬1) قرأ أهل الكوفة والشام (إلا عاصما) (¬2) (لنجزي) بفتح النون والياء وكسر الزاي (¬3)، وقرأ أبو جعفر بضم الياء الأولى وجزم الثانية (¬4)، قال أبو عمرو: وهو لحن ظاهر (¬5). وقال الكسائي: معناه (¬6): ليجزى الجزاء قوما (¬7).(@)(@@) وقرأ الباقون بفتح اليائين على وجه الخبر عن الله تعالى (¬8)، واختاره أبو عبيد وأبو حاتم لذكر الله قبل ذلك.(@)(@)PageV24P016(@)(@)(@@)(@@)(@@) || CHECK 16(@)(@)(@@) {بما كانوا يكسبون}(@)(@)(@@)(@@)(@@) || AUTO 15(@)(@)(@@) - قوله تعالى: {من عمل صالحا فلنفسه ومن أساء فعليها ثم إلى ربكم ترجعون(@)(@)(@@)(@@)(@@) || AUTO (15)(@)(@)(@@) ولقد آتينا بني إسرائيل الكتاب والحكم والنبوة ورزقناهم من الطيبات}(@)(@@) الحلالات، يعني: المن والسلوى (¬1) {وفضلناهم على العالمين}.(@)(@)(@@)(@@)(@@) || AUTO 17(@)(@)(@@) - {وآتيناهم بينات من الأمر} (يعني: أحكام التوراة) (¬2) (¬3).(@)(@@) {فما اختلفوا إلا من بعد ما جاءهم العلم بغيا بينهم إن ربك يقضي بينهم يوم القيامة فيما كانوا فيه يختلفون}.(@)(@)(@@)(@@)(@@) || AUTO 18(@)(@)(@@) - {ثم جعلناك على شريعة} سنة وطريقة (¬4) {من 
ms3126	 الأمر} من الدين (¬5).(@)(@@) {فاتبعها ولا تتبع أهواء الذين لا يعلمون} يعني: مراد الكافرين الجاهلين، وذلك حين دعي إلى دين آبائه (¬6).(@)(@)PageV24P017(@)(@)(@@)(@@)(@@) || AUTO 19(@)(@)(@@) - {إنهم لن يغنوا عنك من الله شيئا} إن اتبعت أهواءهم (¬1)(@)(@@) {وإن الظالمين بعضهم أولياء بعض والله ولي المتقين}.(@)(@)(@@)(@@)(@@) || AUTO 20(@)(@)(@@) - {هذا} يعني: القرآن (¬2) {بصائر} معالم (¬3) {للناس}(@)(@@) في الحدود (¬4) والأحكام يبصرون بها (¬5).(@)(@@) {وهدى ورحمة لقوم يوقنون}.(@)(@)(@@)(@@)(@@) || AUTO 21(@)(@)(@@) - {أم حسب الذين اجترحوا السيئات} (¬6) يعني الكفر والمعاصي (¬7).(@)(@@) {أن نجعلهم كالذين آمنوا وعملوا الصالحات سواء} قرأها أهل الكوفة (إلا أبا بكر) (¬8) (¬9) نصبا (¬10)، واختاره أبو عبيد، وقال: معناه PageV24P018(@)(@@) نجعلهم سواء (¬1).(@)(@@) وقرأ الآخرون، بالرفع على الابتداء والخبر (¬2)، واختاره أبو حاتم.(@)(@@) وقرأ الأعمش {محياهم ومماتهم} بنصب (¬3) التاء (¬4) على الظرف، أي: في محياهم ومماتهم (¬5).(@)(@@) {ساء ما يحكمون} بئس ما يقضون (¬6). قال المفسرون: معناه المؤمن في الدنيا والآخرة مؤمن، والكافر في الدنيا والآخرة كافر (¬7).(@)(@)PageV24P019(@)(@)(@@) نزلت هذه الآية في نفر من مشركي مكة قالوا للمؤمنين: لئن كان ما تقولون حقا لنفضلن عليكم في الآخرة، كما فضلنا عليكم في الدنيا (¬1).(@)(@@) [2698] أخبرنا ابن فنجويه (¬2)، حدثنا ابن شنبة (¬3)، حدثنا جعفر ابن محمد الفريابي (¬4)، حدثنا محمد بن الحسن البلخي (¬5)، حدثنا عبد الله (¬6) بن المبارك، حدثنا شعبة (¬7)، عن عمرو بن مرة (¬8)، عن أبي الضحي (¬9)، عن مسروق (¬10)، قال: قال لي رجل من أهل مكة: هذا مقام أخيك تميم (¬11) الداري - رضي الله عنه -، لقد رأيته بمكة ذات ليلة حتى أصبح، أو كاد (¬12) أن يصبح يقرأ آية من كتاب الله، ويركع، ويسجد، ويبكي (¬13): {أم حسب الذين اجترحوا السيئات أن نجعلهم} ..(@)(@)PageV24P020(@)(@)(@@) الآية (¬1).(@)(@@) [2699] وأخبرنا ابن فنجويه (¬2)، حدثنا أبو بكر بن مالك القطيعي (¬3)، حدثنا عبد الله بن أحمد بن حنبل (¬4)، حدثني أبو هاشم (¬5) زياد بن أيوب (¬6)، حدثنا علي بن يزيد (¬7)، حدثنا عبد الرحمن بن عجلان (¬8)، عن (¬9) نسير (¬10) أبي طعمة، قال: بت PageV24P021(@)(@@) عند الربيع (¬1) بن خثيم (¬2) ليلة (¬3)، فقام يصلي فمر بهذه الآية: {أم حسب الذين اجترحوا السيئات أن نجعلهم} الآية (¬4)، فمكث ليله حتى أصبح، ما يجوز هذه الآية إلى غيرها، ببكاء شديد. (¬5).(@)(@@) وقال إبراهيم بن الأشعث: كنت كثيرا ما 
ms3127	 أرى الفضيل بن عياض، يردد من أول الليلة إلى آخرها هذه الآية ونظائرها: {أم حسب الذين اجترحوا السيئات} ثم يقول: يا فضيل ليت شعري من أي الفريقين أنت (¬6).(@)(@)PageV24P022(@)(@)(@@)(@@)(@@) || AUTO 22(@)(@)(@@) - قوله عز وجل: {وخلق الله السماوات والأرض بالحق ولتجزى كل نفس بما كسبت وهم لا يظلمون(@)(@)(@@)(@@)(@@) || AUTO (22)(@)(@)(@@) }(@)(@)(@@)(@@)(@@) || AUTO 23(@)(@)(@@) - قوله تعالى: {أفرأيت من اتخذ إلهه هواه}(@)(@@) قال ابن عباس - رضي الله عنه - (¬1) والحسن وقتادة (¬2): ذلك الكافر اتخذ دينه بما (¬3) يهواه، فلا يهوى شيئا إلا ركبه، لأنه لا يؤمن بالله، ولا يخافه ولا يحرم ما حرم (الله تعالى) (¬4)، ولا يحل ما أحل الله (¬5)، إنما دينه ما هويت (¬6) نفسه يعمل به ولا يحجزه عن ذلك تقوى (¬7).(@)(@)PageV24P023(@)(@)(@@) وقال آخرون: (معناه أفرأيت) (¬1) من اتخذ معبوده هواه، فيعبد ما يهوى.(@)(@@) وقال سعيد بن جبير: كانت قريش تعبد (¬2) العزي، وهو حجر أبيض حينا من الدهر، وكانت العرب تعبد الحجارة والذهب والفضة، فإذا وجدوا شيئا أحسن من الأول رموه أو (¬3) كسروه أو ألقوه في بئر، وعبدوا الآخر، فأنزل الله تعالى هذه الآية (¬4).(@)(@@) وقال مقاتل: نزلت في الحارث بن قيس السهمي أحد المستهزئين، وذلك أنه كان يعبد ما تهواه نفسه (¬5).(@)(@@) [2700] أخبرني ابن فنجويه (¬6)، حدثنا طلحة (¬7) وعبيد الله (¬8)، قالا: حدثنا ابن مجاهد (¬9)، حدثني ابن أبي مهران (¬10)، حدثنا PageV24P024(@)(@@) محمد بن يحيى (¬1) بن أبي عمر (¬2)، قال: قال سفيان بن عيينة (¬3): إنما عبدوا الحجارة لأن البيت (¬4) حجارة (¬5).(@)(@@) وقال الحسين بن الفضل: في الآية تقديم وتأخير، مجازها: أفرأيت من اتخذ هواه إلهه (¬6).(@)(@@) [2701] أخبرني ابن فنجويه (¬7)، حدثنا ابن شنبة (¬8)، حدثنا محمد ابن عمران بن هارون (¬9)، حدثنا أبو عبيد الله المخزومي (¬10)، حدثنا سفيان بن عيينة (¬11)، عن ابن شبرمة (¬12)، عن الشعبي (¬13)، قال:(@)(@)PageV24P025(@)(@)(@@) إنما سمي الهوى لأنه يهوي بصاحبه في النار (¬1).(@)(@@) [2702] وبه عن سفيان (¬2)، عن (¬3) سليمان الأحول (¬4)، عن طاووس (¬5)، عن ابن عباس - رضي الله عنهما -، قال: ما ذكر الله هوى في القرآن إلا ذمه (¬6).(@)(@)PageV24P026(@)(@)(@@) وروى أبو أمامة - رضي الله عنه - (¬1)، عن النبي - صلى الله عليه وسلم - أنه، قال: "ما عبد (¬2) (¬3) تحت ظل السماء أبغض إلى الله (¬4) من 
ms3128	 هوى" (¬5).(@)(@@) وقال - صلى الله عليه وسلم -: "ثلاث مهلكات: شح مطاع، وهوى متبع، وإعجاب المرء بنفسه" (¬6).(@)(@@) وروى ضمرة بن حبيب، عن شداد بن أوس - رضي الله عنهما - أن النبي - صلى الله عليه وسلم - PageV24P027(@)(@@) قال: "الكيس من دان نفسه وعمل لما بعد الموت، والعاجز من أتبع نفسه هواها وتمنى على الله" (¬1).(@)(@@) وقال مضر القاري (¬2): لنحت الجبال (¬3) بالأظافير حتى تنقطع الأوصال، أهون من مخالفة الهوى إذا تمكن في النفوس.(@)(@@) وسئل ابن المقفع عن الهوى، فقال: هوان سرقت نونه، فنظمه الشاعر فقال:(@)(@@) نون الهوان من الهوى مسروقة ... وأسير كل هوى أسير هوان (¬4) PageV24P028(@)(@@) وقال (¬1) آخر:(@)(@@) إن الهوى لهو الهوان بعينه ... فإذا هويت فقد لقيت هوانا(@)(@@) وإذا هويت فقد تعبدك الهوى ... فاخضع لحبك كائنا من كانا (¬2)(@)(@@) [2703] وأنشدنا أبو القاسم الحسن (¬3) بن محمد (الحبيبي رحمه الله قال) (¬4): أنشدنا أبو حاتم محمد بن حبان (¬5) البستي (¬6): ولم أر أكمل منه. قال: أنشدنا محمد بن أبي على الخلادي (¬7) لعبد الله المبا رك:(@)(@)PageV24P029(@)(@)(@@) ومن البلاء وللبلاء علامة ... أن لا يرى لك عن هواك نزوع(@)(@@) العبد عبد النفسر في شهواته ... والحر يشبع تارة وبجوع (¬1)(@)(@@) [2704] وأنشدنا أبو القاسم الحبيبي رحمه الله (¬2)، قال: أنشدنا الحسن (¬3) عيسى بن زيد (¬4) العقيلي، قال (¬5): أنشدني (¬6) أبو المثنى معاذ بن المثنى العنبري (¬7) (عن أبيه) (¬8)، لأبي العتاهية (¬9):(@)(@)PageV24P030(@)(@)(@@) فاعص هوى النفس ولا ترضها ... إنك إن أسخطتها زانكا(@)(@@) حتى متى تطلب مرضاتها ... فإنها تطلب عدوانكا (¬1)(@)(@@) [2705] وأنشدني أبو القاسم الحبيبي (¬2)، قال: أنشدنا الإمام بكر (محمد بن علي بن إسماعيل) (¬3) القفال الشاشي (¬4) بمرو، قال: أنشدنا أبو بكر الدريدي:(@)(@@) إذا طالبتك النفس يوما بشهوة ... وكان إليها للخلاف طريق(@)(@@) فدعها وخالف ما هويت فإنما ... هواك عدو والخلاف صديق (¬5) PageV24P031(@)(@@) [2706] وأنشدني أبو القاسم الحبيبي (¬1)، قال: أنشدني أبو عبيد (¬2) الطوسي (¬3):(@)(@@) والنفس إن أعطيتها مناها ... فاغرة نحو هواها فاها (¬4)(@)(@@) [2707] وسمعت أبا القاسم (¬5) يقول: سمعت أبا نصر منصور بن عبد الله الأصفهاني (¬6) بهراة يقول: سمعت أبا الحسن عمر بن واصل PageV24P032(@)(@@) العنبري (¬1) يقول: سئل سهل بن عبد الله التستري (¬2) عن الهوى؛ فقال للسائل: هواك داؤك، فإن خالفته فدواؤك (¬3).(@)(@@) وقال وهب: إذا عرض 
ms3129	 لك أمران شككت في خيرهما فانظر إلى أبعدهما من هواك فأته (¬4).(@)(@@) قوله تعالى: {وأضله الله على علم} منه (¬5) بعاقبة أمره (¬6) {وختم} طبع (¬7) {على سمعه وقلبه وجعل على بصره غشاوة} قرأ حمزة والكسائي وخلف: {غشاوة} بفتح الغين من غير ألف (¬8)، وقرأ (¬9) الباقون:(@)(@)PageV24P033(@)(@)(@@) (غشاوة) بالألف، وكسر الغين (¬1).(@)(@@) {فمن يهديه من بعد الله أفلا تذكرون}.(@)(@)(@@)(@@)(@@) || AUTO 24(@)(@)(@@) - قوله تعالى: {وقالوا}(@)(@@) يعني: المشركين {ما هي إلا حياتنا الدنيا نموت ونحيا}(@)(@@) يموت الآباء ويحيا الأبناء (¬2) {وما يهلكنا إلا الدهر} وما يفنينا إلا ممر (¬3) الزمان، وطول العمر (¬4) (¬5).(@)(@@) وفي حرف عبد الله - رضي الله عنه -: (وما يهلكنا إلا دهر (¬6) يمر) (¬7) {وما لهم بذلك من علم إن هم إلا يظنون}(@)(@@) [2708] أخبرنا أبو عبد الله الحسين (¬8) بن محمد بن فنجويه PageV24P034(@)(@@) الدينوري رحمه الله بقراءتي عليه، حدثنا أبو حذيفة أحمد بن محمد (¬1) ابن علي الدينوري (¬2)، حدثنا أبو عبيد علي بن الحسين (¬3) بن حرب القاضي (¬4)، حدثنا أحمد بن المقدام العجلي (¬5)، حدثنا سفيان بن عيينة (¬6)، عن الزهري (¬7)، عن سعيد بن المسيب (¬8)، عن أبي هريرة - رضي الله عنه -، عن النبي - صلى الله عليه وسلم - قال: "كان أهل الجاهلية يقولون: إنما يهلكنا الليل والنهار، هو الذي يهلكنا فيميتنا ويحينا، (قال (¬9) الله تعالى في كتابه: {وقالوا ما هي إلا حياتنا الدنيا نموت ونحيا وما يهلكنا إلا الدهر}، فيسبون الدهر) (¬10)، فقال الله تعالى: "يؤذيني ابن آدم؛ يسب الدهر، وأنا الدهر، بيدي الأمر، أقلب الليل والنهار" (¬11).(@)(@)PageV24P035(@)(@)(@@) [2709] وأخبرنا أبو سعيد محمد بن عبد الله بن حمدون (¬1) بقراءتي عليه في صفر سنة ثمان وثمانين وثلاثمائة فأقر به، أخبرنا أبو حامد أحمد بن محمد بن الحسن (¬2)، حدثنا محمد بن يحيى (¬3) وعبد الرحمن بن بشر (¬4) وأحمد بن يوسف (¬5)، قالوا: حدثنا عبد الرزاق (بن همام) (¬6)، أخبرنا معمر (بن راشد) (¬7) عن همام بن منبه (¬8)، قال (¬9): هذا ما حدثنا أبو هريرة - رضي الله عنه -، عن محمد رسول PageV24P036(@)(@@) الله - صلى الله عليه وسلم - قال: "قال الله تعالى: لا يقل ابن آدم يا خيبة الدهر، فإني أنا الدهر، أرسل الليل والنهار، فإذا شئت قبضتهما" (¬1).(@)(@@) [2710] وأخبرني ابن 
ms3130	 فنجويه (¬2)، حدثنا عبيد (¬3) الله بن عبد الله بن أبي سمرة (¬4)، حدثنا عبد الملك بن أحمد الخياط البغدادي (¬5)، حدثنا محمود (¬6) بن خداش (¬7)، حدثنا سيف بن محمد الثوري (¬8)، عن الأعمش (¬9)، عن أبي صالح (¬10)، عن أبي هريرة - رضي الله عنه -، قال: قال PageV24P037(@)(@@) رسول الله - صلى الله عليه وسلم -: "لا تسبوا الدهر، فإن الله هو الدهر" (¬1).(@)(@@) قال أبو عبيد القاسم بن سلام (¬2) في تفسير هذا الحديث (¬3): إن هذا مما لا ينبغي لأحد من أهل الإسلام (¬4) أن يجهل وجهه، وذلك أن من شأن العرب أن يذموا (¬5) الدهر ويسبوه عند المصائب والنوائب، فيقولون (¬6): أجتاحهم الدهر، وتخرمتهم (¬7) الأيام، وأتى عليهم الزمان وما أشبه ذلك حتى ذكروها في أشعارهم.(@)(@@) قال عمرو بن قميئة (¬8):(@)(@@) رمتني بنات الدهر من حيث لا أرى ... فكيف بمن يرمى وليس برامي PageV24P038(@)(@@) فلو أنها نبل إذا لاتقيتها ... ولكنني أرمى بغير سهام(@)(@@) على الراحتين مرة وعلى العصا ... أنوء ثلاثا بعدهن قيامي (¬1)(@)(@@) وروي أن الشعبي دخل على عبد الملك بن مروان وقد ضعف، فسأل (¬2) عن حاله، فأنشده هذه الأبيات (¬3) (¬4):(@)(@@) فاستأثر الدهر الغداة بهم ... والدهر يرميني وما أرمي(@)(@@) يا دهر قد أكثرت فجعتنا ... بسراتنا ووقدت (¬5) في العظم(@)(@@) وتركتنا لحما على وضم ... لو كنت تستبقي من اللحم(@)(@@) وسلبتنا ما كان يعجبنا (¬6) ... يا دهر ما أنصفت في الحكم (¬7) PageV24P039(@)(@@) [2711] وأنشدنا الحسن بن محمد السدوسي (¬1)، قال: أنشدنا عبد السميع بن محمد الهاشمي (¬2)، قال: أنشدنا أبو الحسن العبسي (¬3) لابن لنكك (¬4) في هذا المعنى:(@)(@@) قل لدهر عن المكارم عطل ... يا قبيح الفعال جهم المحيا(@)(@@) كم كريم حططته من يفاع ... ولئيم ألحقته بالثريا (¬5) PageV24P040(@)(@@) وقال (أبو عبيد: ناظرت) (¬1) بعض الملحدة، قال (¬2): ألا تراه يقول: فإن الله هو الدهر، فقلت له: هل كان أحد يسب الله في آباد الدهر، بل كانوا يقولون كما قال الأعشى:(@)(@@) استأثر الله بالوفاء وبالعدل ... وولى الملامة الرجلا (¬3)(@)(@@) قال: فتأويل قوله - صلى الله عليه وسلم -: "إن الله هو الدهر"، إن الله جل ذكره هو الذي يأتي بالدهر والشدائد والمصائب، فإذا سببت الدهر وقع السب على الله، تعالى عن ذلك علوا كبيرا؛ لأنه فاعل 
ms3131	 هذه الأشياء وقاضيها ومدبرها (¬4).(@)(@@) وقال الحسين بن الفضل: مجازه: فإن الله هو (¬5) مدهر الدهور (¬6).(@)(@)PageV24P041(@)(@)(@@) وروي عن علي بن أبي طالب - رضي الله عنه - في خطبة له: مدهر (¬1) الدهور، ومن عنده الميسور، ومن لديه المعسور (¬2).(@)(@@) ودليل هذا التأويل.(@)(@@) [2712] ما أخبرنا أبو القاسم الحسن بن محمد بن الحسن النيسابوري (¬3)، حدثنا أبو الحسن (محمد بن محمد بن الحسن) (¬4) الكازري (¬5)، حدثنا أبو عبد الله محمد بن القاسم الجمحي (¬6)، حدثنا عنبر (¬7) بن أحمد (¬8)، قال: بلغني أن سالم (¬9) بن عبد الله بن عمر (¬10) كان كثيرا ما يذكر الدهر، فزبره أبوه عبد الله بن عمر - رضي الله عنه -، وقال له: يا بني إياك وذكر الدهر، (ثم أنشد) (¬11):(@)(@)PageV24P042(@)(@)(@@) فما الدهر بالجائي بشيء تحبه ... ولا جالب البلوى فلا تشتم الدهرا(@)(@@) ولكن متى ما يبعث الله باعثا ... على معشر يجعل مياسيرهم عسرا (¬1)(@)(@@) وأنشدني أبو القاسم (¬2) قال (¬3): أنشدنا الشيخ السدي أبو محمد (أحمد بن عبد الله) (¬4) المزني، قال: أنشدنا معاذ بن نجدة بن العريان (¬5):(@)(@@) دار الزمان على الأمور فإنه ... إن لم تدار رماك بالآلام PageV24P043(@)(@@) وذر الزمان عن الملام فإنما ... يحكي الزمان مجاري الأقلام(@)(@@) يشكى الزمان ويستزاد فإنما ... بيد المليك منافذ الأحكام (¬1)(@)(@@) [2714] وأنشدني الأستاذ (¬2) أبو القاسم الحبيبي (¬3)، قال: أنشدني أبي (¬4)، قال: أنشدني أبو علي (محمد بن عبد الوهاب) (¬5) الثقفي:(@)(@@) يا عالما يعجب من دهره ... لا تلم الدهر على غدره(@)(@@) فالدهر مأمور له آمر ... يصرف (¬6) الدهر إلى أمره(@)(@@) كم كافر أمواله جمة ... يزداد أضعافا على كفره(@)(@)PageV24P044(@)(@)(@@)(@@)(@@) || CHECK 26(@)(@)(@@) ومؤمن ليس له درهم ... يزدادا إيمانا على فقره (¬1)(@)(@)(@@)(@@)(@@) || AUTO 25(@)(@)(@@) - قوله تعالى: {وإذا تتلى عليهم آياتنا بينات ما كان حجتهم إلا أن قالوا ائتوا بآبائنا إن كنتم صادقين(@)(@)(@@)(@@)(@@) || AUTO (25)(@)(@)(@@) قل الله يحييكم ثم يميتكم ثم يجمعكم إلى يوم القيامة}(@)(@@) (يعني: ليوم القيامة) (¬2) (¬3) {لا ريب فيه ولكن أكثر الناس لا يعلمون}.(@)(@)(@@)(@@)(@@) || AUTO 27(@)(@)(@@) - {ولله ملك السماوات والأرض ويوم تقوم الساعة يومئذ يخسر المبطلون(@)(@)(@@)(@@)(@@) || AUTO (27)(@)(@)(@@) }(@)(@)(@@)(@@)(@@) || AUTO 28(@)(@)(@@) - قوله -عز وجل-: {وترى كل أمة جاثية}(@)(@@) مجتمعة مستوفزة على ركبها من هول ذلك اليوم (¬4).(@)(@@) وأصل الجثوة: الجماعة من كل 
ms3132	 شيء (¬5).(@)(@@) قال طرفة يصف قبرين:(@)(@)PageV24P045(@)(@)(@@) ترى جثوتين من تراب عليهما ... صفائح صم من صفيح منضد (¬1)(@)(@@) [2715] أخبرني (¬2) ابن فنجويه (¬3)، حدثنا عبد الله (¬4) بن يوسف (¬5)، حدثنا محمد بن موسى الحلواني (¬6)، حدثنا يعقوب بن سفيان (¬7) الفارسي (¬8)، حدثنا عبد الله بن يحيى الثقفي (¬9)، حدثنا أبو عوانة (¬10)، عن عاصم الأحول (¬11)، عن أبي عثمان النهدي (¬12)، عن سلمان (¬13)، قال: (¬14) في القيامة ساعة هي عشر سنين يكون (¬15) PageV24P046(@)(@@) الناس جثاة (¬1) على ركبهم حتى إن (¬2) إبراهيم (ينادي: نفسي لا أسألك (¬3) إلا نفسي (¬4).(@)(@@) {كل أمة تدعى إلى كتابها} الذي فيه أعمالها (¬5) {اليوم تجزون ما كنتم تعملون}.(@)(@)(@@)(@@)(@@) || AUTO 29(@)(@)(@@) - {هذا كتابنا ينطق عليكم بالحق} يعني: ديوان الحفظة (¬6)، وقيل: اللوح المحفوظ (¬7).(@)(@@) [2716] أخبرني الحسين بن محمد الثقفي (¬8)، حدثنا عمر بن نوح PageV24P047(@)(@@) البجلي (¬1)، حدثنا أبو خليفة (¬2)، حدثنا عثمان بن عبد الله الشامي (¬3)، حدثنا بقية بن الوليد (¬4)، عن أرطاة بن المنذر (¬5)، عن مجاهد (¬6)، عن ابن عمر - رضي الله عنه -، قال: قال رسول الله - صلى الله عليه وسلم -: "أول شيء خلق الله القلم من نور مسيرة خمسمائة عام، واللوح من نور مسيرة خمسمائة عام، فقال للقلم: أجر فجرى بما هو كائن إلى يوم القيامة، برها وفاجرها، ورطبها ويابسها". ثم قرأ (¬7) هذه الآية: {هذا كتابنا ينطق عليكم بالحق إنا كنا نستنسخ ما كنتم تعملون (29)}، قال: "وهل تكون النسخة إلا من شيء قد فرغ منه" (¬8).(@)(@@) ومعنى {نستنسخ} نأمر بالنسخ (¬9).(@)(@)PageV24P048(@)(@)(@@)(@@)(@@) || CHECK 32(@)(@)(@@) وقال الضحاك: نثبت (¬1).(@)(@@) وقال السدي: نكتب (¬2).(@)(@@) وقال الحسن: نحفظ (¬3).(@)(@)(@@)(@@)(@@) || AUTO 30(@)(@)(@@) - قوله تعالى: {فأما الذين آمنوا وعملوا الصالحات فيدخلهم ربهم في رحمته} جنته (¬4) (¬5)(@)(@@) {ذلك هو الفوز المبين} الظفر الظاهر (¬6).(@)(@)(@@)(@@)(@@) || AUTO 31(@)(@)(@@) - {وأما الذين كفروا}(@)(@@) فيقال لهم: {أفلم تكن آياتي تتلى عليكم فاستكبرتم وكنتم قوما مجرمين(@)(@)(@@)(@@)(@@) || AUTO (31)(@)(@)(@@) وإذا قيل إن وعد الله حق والساعة} بالرفع (¬7) قراءة العامة على الابتداء، وخبره فيما بعده (¬8)، ودليلهم قوله تعالى: {إن الأرض لله يورثها من يشاء من PageV24P049(@)(@@) عباده والعاقبة للمتقين} (¬1) بالرفع (¬2).(@)(@@) وقرأ أبو رجاء العطاردي، وحمزة {والساعة} نصبا عطفا بها على الوعد (¬3).(@)(@)(@@)(@@)(@@) || AUTO 33(@)(@)(@@) - {لا ريب فيها قلتم ما ندري ما الساعة إن نظن 
ms3133	 إلا ظنا وما نحن بمستيقنين} بأنها (¬4) كائنة (¬5).(@)(@)(@@)(@@)(@@) || AUTO 34(@)(@)(@@) - قوله -عز وجل-: {وبدا لهم سيئات ما عملوا} أي: جزاؤها (¬6)(@)(@@) {وحاق بهم ما كانوا به يستهزئون}.(@)(@)(@@)(@@)(@@) || AUTO 35(@)(@)(@@) - {وقيل اليوم ننساكم} أي (¬7): نترككم في النار (¬8).(@)(@)PageV24P050(@)(@)(@@) {كما نسيتم لقاء يومكم هذا} كما تركتم الإيمان بيومكم هذا (¬1) (¬2) {ومأواكم النار وما لكم من ناصرين}.(@)(@)(@@)(@@)(@@) || AUTO 36(@)(@)(@@) - {ذلكم بأنكم اتخذتم آيات الله هزوا وغرتكم الحياة الدنيا فاليوم لا يخرجون منها}(@)(@@) قراءة العامة بضم الياء (¬3)، وقرأ أهل الكوفة إلا عاصما بالفتح (¬4) (¬5).(@)(@@) {ولا هم يستعتبون} يسترضون (¬6).(@)(@)(@@)(@@)(@@) || AUTO 37(@)(@)(@@) - {فلله الحمد رب السماوات ورب الأرض رب العالمين(@)(@)(@@)(@@)(@@) || AUTO (36)(@)(@)(@@) }(@)(@@) قراءة العامة (رب) بكسر الباء في ثلاثتها على النعت (¬7) (¬8)، وقرأها ابن محيصن رفعا على معنى (هو رب) (¬9).(@)(@)PageV24P051(@)(@)(@@)(@@)(@@) || AUTO 38(@)(@)(@@) - {وله الكبرياء} العظمة (¬1) (¬2) {في السماوات والأرض وهو العزيز الحكيم}.(@)(@)PageV24P052(@)(@)(@@)(@@)(@@) | AUTO 46 - سورة الأحقاف PageV24P053(@)(@@) سورة الأحقاف(@)(@@) مكية (¬1)، وهي ألفان وخمسمائة وخمسة وتسعون حرفا (¬2)، وستمائة وأربع وأربعون كلمة، وخمسة وثلاثون آية (¬3).(@)(@@) [2717] أخبرنا أبو جعفر كامل بن أحمد المفيد (¬4) رحمه الله، حدثنا أبو عمرو محمد بن جعفر بن محمد الحيري (¬5)، حدثنا إبراهيم بن شريك الكوفي (¬6)، حدثنا أحمد بن عبد الله بن يونس (¬7)، PageV24P055(@)(@@) حدثنا سلام بن سليم (¬1)، حدثنا هارون بن كثير (¬2)، عن زيد بن أسلم، عن أبيه (¬3)، عن أبي أمامة (¬4)، عن أبي بن كعب - رضي الله عنه -، قال: قال رسول الله - صلى الله عليه وسلم -: "من قرأ سورة الأحقاف أعطي من الأجر بعدد كل رمل في الدنيا عشر حسنات، ومحي عنه عشر سيئات، ورفع له عشر درجات" (¬5).(@)(@)PageV24P056(@)(@)(@@) قوله تعالى:(@)(@@) {بسم الله الرحمن الرحيم}(@)(@)(@@)(@@)(@@) || AUTO 1(@)(@)(@@) - {حم(@)(@)(@@)(@@)(@@) || AUTO (1)(@)(@)(@@) تنزيل الكتاب من الله العزيز الحكيم(@)(@)(@@)(@@)(@@) || AUTO (2)(@)(@)(@@) ما خلقنا السماوات والأرض وما بينهما إلا بالحق وأجل مسمى والذين كفروا عما أنذروا معرضون(@)(@)(@@)(@@)(@@) || AUTO (3)(@)(@)(@@) قل أرأيتم}(@)(@@) وفي مصحف عبد الله - رضي الله عنه - (أرأيتكم) (¬(@)(@)(@@)(@@)(@@) || AUTO 1)(@)(@)(@@) {ما تدعون من دون الله أروني ماذا خلقوا من الأرض أم لهم شرك في السماوات ائتوني بكتاب} من عند الله جاءكم (¬(@)(@)(@@)(@@)(@@) || AUTO 2)(@)(@)(@@) .(@)(@@) {من قبل هذا} القرآن فيه بيان ما تقولون (¬(@)(@)(@@)(@@)(@@) || AUTO 3)(@)(@)(@@) {أو أثارة من 
ms3134	 علم} قراءة العامة بالألف (¬(@)(@)(@@)(@@)(@@) || AUTO 4)(@)(@)(@@) ، واختلفت (¬5) العلماء في تأويلها:(@)(@)(@@)(@@)(@@) || AUTO [2(@)(@)(@@) 7(@)(@)(@@)(@@)(@@) || AUTO 1(@)(@)(@@) 8] فأخبرنا عبد الله بن حامد الوزان (¬6)، أخبرنا مكي بن PageV24P057(@)(@@) عبدان (¬1)، حدثنا عبد الله بن هاشم (¬2)، حدثنا يحيى بن سعيد (¬3)، عن سفيان (¬4)، عن صفوان بن سليم (¬5)، عن أبي سلمة (¬6)، عن ابن عباس - رضي الله عنه -، وأظنه عن النبي - صلى الله عليه وسلم - {أو أثارة من علم} قال: "الخط" (¬7).(@)(@)PageV24P058(@)(@)(@@) وقال ميمون بن مهران (¬1)، وأبو سلمة بن عبد الرحمن (¬2)، وقتادة (¬3): خاصة من علم.(@)(@@) وقال الحسن: أثارة من علم يستخرجه فيثيره (¬4) (¬5).(@)(@@) وقال مجاهد: رواية يأثرونها عمن كان قبلهم (¬6).(@)(@@) وقال عكرمة ومقاتل: رواية عن الأنبياء (¬7).(@)(@)PageV24P059(@)(@)(@@) وقال القرظي: هي (¬1) الإسناد (¬2).(@)(@@) وأصل الكلمة من الأثر (¬3)، وهو الرواية. يقال: أثرت الحديث آثره أثرا وأثارة، كالشجاعة، والجلادة، والصلابة، فأنا آثر (¬4)، ومنه قيل للخبر: أثر (¬5).(@)(@@) قال الأعشى:(@)(@@) إن الذي فيه تماريتما بين (¬6) ... للسامع والآثر (¬7)(@)(@@) وقال الكلبي: بقية من علم (¬8).(@)(@)PageV24P060(@)(@)(@@) قال الأخفش: تقول العرب: لهذه الناقة أثارة من سمن، أي بقية (¬1).(@)(@@) قال الراعي:(@)(@@) وذات أثارة أكلت عليها ... نباتا (¬2) في [أكمته قفارا] (¬3) (¬4)(@)(@@) وقرأ علي بن أبي طالب - رضي الله عنه -: (أو أثرة) بفتح الهمزة وسكون الثاء غير ألف (¬5).(@)(@@) وقرأ السلمي والحسن: بفتح الهمزة والثاء، من غير ألف (¬6)، أي:(@)(@)PageV24P061(@)(@)(@@) خاصة من علم أوتيتموه وأوثرتم (¬1) بها على غيركم (¬2).(@)(@@) وقرأ عكرمة: أو ميراث من علم (¬3). {إن كنتم صادقين}.(@)(@)(@@)(@@)(@@) || AUTO 5(@)(@)(@@) - قوله تعالى: {ومن أضل} أجهل (¬4)(@)(@@) {ممن يدعو من دون الله من لا يستجيب له إلى يوم القيامة وهم} يعني الأوثان (¬(@)(@)(@@)(@@)(@@) || AUTO 5)(@)(@)(@@) {عن دعائهم غافلون} لا يسمعون ولا يفهمون، فأخرجها وهي جماد مخرج ذكور بني آدم؛ إذ كانت قد مثلتها عبدتها بالملوك والأمراء التي تخدم (¬(@)(@)(@@)(@@)(@@) || AUTO 6)(@)(@)(@@) .(@)(@)(@@)(@@)(@@) || AUTO 6(@)(@)(@@) - {وإذا حشر الناس كانوا لهم أعداء وكانوا بعبادتهم كافرين(@)(@)(@@)(@@)(@@) || AUTO (6)(@)(@)(@@) }(@)(@@) جاحدين، وعنهم متبرئين (¬7)، بيانه قوله: {تبرأنا إليك ما كانوا إيانا يعبدون} (¬8).(@)(@)PageV24P062(@)(@)(@@)(@@)(@@) || CHECK 8(@)(@)(@@)(@@)(@@) || AUTO 7(@)(@)(@@) - قوله تعالى: {وإذا تتلى عليهم آياتنا بينات قال الذين كفروا للحق لما جاءهم هذا سحر مبين(@)(@)(@@)(@@)(@@) || AUTO (7)(@)(@)(@@) أم يقولون افتراه قل إن افتريته فلا تملكون لي من الله شيئا} 
ms3135	 (¬1)(@)(@@) إن عذبني على افترائي (¬2).(@)(@@) {هو أعلم بما تفيضون} تخوضون (¬3) {فيه كفى به شهيدا بيني وبينكم وهو الغفور الرحيم}.(@)(@)(@@)(@@)(@@) || AUTO 9(@)(@)(@@) - {قل ما كنت بدعا} أي: بديعا مثل نصف ونصيف (¬4)(@)(@@) {من الرسل} أي: لست بأول مرسل، فلم تنكرون نبوتي؟ هل أنا إلا كالأنبياء قبلي؟ وجمع البدع: أبداع (¬5).(@)(@@) قال عدي بن زيد:(@)(@@) فلا أنا بدع من حوادث تعتري ... رجالا عرت من بعد موسى وأسعد(@)(@@) {وما أدري ما يفعل بي ولا بكم} PageV24P063(@)(@@) اختلف العلماء في معنى هذه الآية وحكمها:(@)(@@) فقال بعضهم: معناها وما أدري ما يفعل بي ولا بكم يوم القيامة (¬1)، فلما نزلت هذه الآية فرح المشركون فرحا شديدا، وقالوا: واللات والعزى ما أمرنا وأمر محمد - صلى الله عليه وسلم - عند الله إلا واحد، وما له علينا من مزية وفضل، ولولا أنه أبتدع ما يقوله من ذات (¬2) نفسه، لأخبره الذي بعثه بما يفعل به، فأنزل الله تعالى {ليغفر لك الله ما تقدم من ذنبك وما تأخر} (¬3)، فبين له أمره، ونسخت هذه الآية (¬4)، فقالت الصحابة - رضي الله عنه -: هنيئا لك يا رسول الله، قد علمنا ما يفعل بك، فماذا يفعل بنا؟ فأنزل الله تعالى: {ليدخل المؤمنين والمؤمنات جنات تجري من تحتها الأنهار} (¬5) الآية، {وبشر المؤمنين بأن لهم من الله فضلا كبيرا (47)} (¬6) فبين الله تعالى ما يفعل به PageV24P064(@)(@@) وبهم (¬1). وهذا قول أنس وقتادة والحسن وعكرمة (¬2).(@)(@@) [2719] أخبرني الحسين بن محمد بن الحسين الدينوري (¬3) رحمه الله، حدثنا أحمد بن محمد بن إسحاق السني (¬4)، حدثني إسماعيل بن داود (¬5)، حدثنا هارون بن سعيد (¬6)، حدثنا ابن وهب (¬7)، قال: أخبرني يونس بن يزيد (¬8)، عن ابن شهاب (¬9)، أن خارجة بن زيد بن ثابت (¬10) PageV24P065(@)(@@) أخبر أن أم العلاء (¬1) - رضي الله عنه - امرأة من الأنصار، قد بايعت رسول الله - صلى الله عليه وسلم - أخبرته أنهم اقتسموا المهاجرين سكناهم قرعة، قالت: فطار لنا عثمان ابن مظعون (¬2) - رضي الله عنه - فأنزلناه أبياتنا فوضع موضعه (¬3) الذي توفي فيه، فلما توفي غسل وكفن في أثوابه، ودخل رسول الله - صلى الله عليه وسلم -، فقلت لعثمان بن مظعون: رحمة الله 
ms3136	 عليك أبا السائب، فشهادتي عليك، لقد أكرمك الله، فقال رسول الله - صلى الله عليه وسلم -: "وما يدريك أن الله قد أكرمه".(@)(@@) قالت: فقلت: بأبي أنت وأمي يا رسول الله، فمن قال؟ أما هو فقد جاءه اليقين، وما رأينا إلا خيرا، فوالله إني لأرجو له الجنة، قال: "والله ما أدري وأنا رسول الله ماذا يفعل بي"، قالت: فوالله إني لا أزكي بعده أحدا (¬4).(@)(@)PageV24P066(@)(@)(@@) قالوا: وإنما قال هذا حين لم يخبر بغفران ذنبه، وإنما غفر الله عز وجل له ذنبه في غزوة (¬1) الحديبية قبل موته بسنتين وشيء (¬2).(@)(@@) وقال ابن عباس - رضي الله عنه -: لما اشتد البلاء بأصحاب رسول الله - صلى الله عليه وسلم -، رأى رسول الله - صلى الله عليه وسلم - فيما يرى النائم وهو بمكة أرضا ذات سباخ، ونخل رفعت له، يهاجر إليها، فقال له أصحابه وهو (¬3) بمكة: إلى متى نكون في هذا البلاء الذي نحن فيه؟ ومتى نهاجر إلى الأرض التي أريت؟ فسكت - صلى الله عليه وسلم -، فأنزل الله تعالى: {وما أدري ما يفعل بي ولا بكم}، أترك في مكاني أو أخرج إلى الأرض التي رفعت لي (¬4).(@)(@@) وقال بعضهم: معناه: وما أدري ما يفعل بي ولا بكم، وإلى ما (¬5) يصير أمري وأمركم في الدنيا؟ (¬6).(@)(@)PageV24P067(@)(@)(@@) [2720] أنبأني عقيل بن محمد (¬1)، أخبرنا المعافى بن زكريا (¬2)، أخبرنا محمد بن جرير (¬3)، حدثنا ابن حميد (¬4)، حدثنا يحيى بن واضح (¬5)، حدثنا أبو بكر الهذلي (¬6)، عن الحسن (¬7)، في قوله تعالى: {وما أدري ما يفعل بي ولا بكم}، فقال: أما في الآخرة فمعاذ الله، قد علم أنه في الجنة حين أخذ ميثاقه في الرسل، ولكن قال: {وما أدري ما يفعل بي ولا بكم} في الدنيا، أخرج كما أخرجت الأنبياء من قبلي؟ أو أقتل كما قتلت الأنبياء من قبلي؟ ولا أدري ما يفعل بكم، أمتي المكذبة أم المصدقة، أم أمتي المرمية بالحجارة من السماء قذفا، أم مخسوف بها خسفا.(@)(@@) ثم أنزل الله تعالى: {هو الذي أرسل رسوله بالهدى ودين الحق ليظهره على الدين كله وكفى بالله شهيدا (28)} (¬8) يقول: سيظهر دينكم على 
ms3137	 الأديان. ثم قال في أمته: {وما كان الله ليعذبهم وأنت فيهم وما PageV24P068(@)(@@) كان الله معذبهم وهم يستغفرون (33)} (¬1) فأخبره الله تعالى بما يصنع به وما يصنع بأمته - صلى الله عليه وسلم - (¬2). وهذا قول السدي (¬3) والثمالي (¬4).(@)(@@) وقال الضحاك: {وما أدري ما يفعل بي ولا بكم} أي ما تؤمرون به وما تنهون عنه (¬5).(@)(@@) {إن أتبع إلا ما يوحى إلي وما أنا إلا نذير مبين}.(@)(@)(@@)(@@)(@@) || AUTO 10(@)(@)(@@) - قوله تعالى: {قل أرأيتم إن كان} يعني القرآن (¬6)(@)(@@) {من عند الله وكفرتم به وشهد شاهد من بني إسرائيل على مثله} قال قتادة والضحاك وابن زيد (¬7): هو عبد الله بن سلام - رضي الله عنه - شهد على نبوة PageV24P069(@)(@@) المصطفى - صلى الله عليه وسلم - (¬1)، وآمن (¬2) (¬3) به، واستكبر اليهود فلم يؤمنوا (¬4).(@)(@@) [2721] أخبرنا عبد الرحمن بن إبراهيم بن محمد بن يحيى (¬5)، أخبرنا عبدوس بن الحسين بن منصور (¬6)، حدثنا محمد بن إدريس الحنظلي (¬7) (ح) (¬8).(@)(@)PageV24P070(@)(@)(@@) [2722] وأخبرنا عبد الله بن حامد (¬1)، حدثنا أبو جعفر محمد بن محمد بن عبد الله البغدادي (¬2) (¬3)، حدثنا إسماعيل بن إسحاق (¬4) قالا، حدثنا محمد بن عبد الله الأنصاري (¬5)، قال حدثني حميد الطويل (¬6)، عن أنس - رضي الله عنه -، قال: جاء عبد الله بن سلام (¬7) - رضي الله عنه - إلى رسول الله - صلى الله عليه وسلم - مقدمه إلى المدينة، فقال: إني سائلك عن ثلاث لا يعلمهن إلا نبي! ما أول أشراط الساعة؟ وما أول طعام يأكله أهل الجنة؟ والولد ينزع إلى أبيه أو إلى أمه؟ قال: "أخبرني جبريل عليه السلام بهن آنفا" قال عبد الله - رضي الله عنه -: ذاك عدو اليهود من الملائكة.(@)(@@) فقال: "أما أول أشراط الساعة فنار تحشرهم من المشرق إلى المغرب، وأما أول طعام يأكله أهل الجنة فزيادة كبد حوت، وأما الولد، فإذا سبق ماء الرجل نزعه (¬8)، وإن سبق ماء المرأة نزعته"، فقال: أشهد أن لا إله إلا الله وأشهد أنك رسول الله، ثم قال: يا PageV24P071(@)(@@) رسول الله، إن اليهود قوم بهت (¬1)، وإن علموا بإسلامي قبل أن تسألهم عني (¬2) بهتوني عندك، فجاءت اليهود، فقال لهم رسول الله - صلى الله عليه وسلم 
ms3138	 -: "أي رجل عبد الله فيكم؟ " فقالوا: خيرنا وابن خيرنا، وسيدنا وابن سيدنا، وأعلمنا وابن أعلمنا. قال: "أرأيتم إن أسلم عبد الله؟ "، قالوا: أعاذه الله من ذلك، فخرج إليهم عبد الله - رضي الله عنه -، فقال: أشهد أن لا إله إلا الله، وأشهد أن محمدا رسول الله - صلى الله عليه وسلم -، فقالوا: شرنا وابن شرنا، وانتقصوه، قال (¬3): هذا ما كنت أخاف يا رسول الله وأحذر (¬4).(@)(@@) ودليل هذا التأويل:(@)(@@) [2723] ما أخبرني عقيل بن محمد (¬5) أن المعافى (¬6) أخبره، عن PageV24P072(@)(@@) محمد بن جرير (¬1)، أخبرنا يونس (¬2)، أخبرنا عبد الله بن يوسف التنيسي (¬3)، قال: سمعت مالك بن أنس (¬4) يحدث، عن أبي النضر (¬5)، عن عامر بن سعد بن أبي وقاص (¬6)، عن أبيه (¬7)، قال: ما سمعت رسول الله - صلى الله عليه وسلم - يقول لأحد يمشي على (¬8) الأرض إنه من أهل الجنة، إلا لعبد الله بن سلام، (¬9) وفيه نزلت {وشهد شاهد من بني إسرائيل على مثله} (¬10).(@)(@)PageV24P073(@)(@)(@@) وقال آخرون: هو موسى بن عمران عليه السلام (¬1).(@)(@@) قال (¬2) الشعبي، عن مسروق في هذه الآية، قال: والله ما نزلت في عبد الله بن سلام لأن (آل {حم} (¬3)) نزلت بمكة، وإنما أسلم عبد الله - رضي الله عنه - بالمدينة، وإنما كانت محاجة من رسول الله - صلى الله عليه وسلم - لقومه، فأنزل الله تعالى هذه الآية، ومثل القرآن التوراة، فشهد موسى عليه السلام على التوراة، ومحمد - صلى الله عليه وسلم - على الفرقان (¬4)، وكلاهما يصدق أحدهما الآخر (¬5). وقيل: هو ابن يامين (¬6). وقيل؟ نبي من بني إسرائيل (¬7).(@)(@)PageV24P074(@)(@)(@@) {فآمن واستكبرتم} فلم تؤمنوا {إن الله لا يهدي القوم الظالمين} لدينه وحجته.(@)(@@) وقال أهل المعاني هذه الآية: محذوفة الجواب مجازها: قل أرأيتم إن كان من عند الله وكفرتم به وشهد شاهد من بني إسرائيل على مثله من المحق منا ومنكم، ومن المبطل؟ (¬1).(@)(@)(@@)(@@)(@@) || AUTO 11(@)(@)(@@) - قوله تعالى: {وقال الذين كفروا} من اليهود(@)(@@) {للذين آمنوا لو كان} دين محمد {خيرا ما سبقونا إليه} يعني عبد الله ابن سلام وأصحابه، قاله أكثر المفسرين (¬2).(@)(@@) وقال قتادة: نزلت في فاس من مشركي قريش، قالوا: لو كان ما 
ms3139	 يدعونا إليه محمد خيرا ما سبقنا إليه فلان وفلان، ويختص الله برحمته من يشاء (¬3).(@)(@@) وقال الكلبي: {وقال الذين كفروا} يعني أسدا وغطفان {للذين PageV24P075(@)(@@) آمنوا} يعني جهينة ومزينة {لو كان} ما جاء به محمد {خيرا} ما سبقنا إليه رعاء البهم، ورذال الناس (¬1).(@)(@@) قال الله تعالى: {وإذ لم يهتدوا به} أي: بالقرآن (¬2) كما اهتدى به أهل الإيمان {فسيقولون هذا إفك قديم} كما قالوا أساطير الأولين (¬3).(@)(@)(@@)(@@)(@@) || AUTO 12(@)(@)(@@) - {ومن قبله} أي: ومن قبل القرآن (¬4) {كتاب موسى إماما}(@)(@@) يؤتم به (¬5) {ورحمة} لمن آمن وعمل به (¬6)، ونصبا على الحال، عن الكسائي (¬7).(@)(@@) وقال أبو عبيدة: فيه إضمار. أي: أنزلناه، أو جعلناه إماما PageV24P076(@)(@@) ورحمة (¬1) (¬2).(@)(@@) وقال (¬3) الأخفش على القطع، لأن قوله: {كتاب موسى} معرفة بالإضافة، والنكرة إذا أعيدت أو أضيفت أو أدخلت (¬4) عليها الألف واللام صارت معرفة (¬5).(@)(@@) {وهذا كتاب مصدق لسانا عربيا} نصب على الحال (¬6)، وقيل: أعني لسانا (¬7). وقيل: بلسان (¬8).(@)(@@) {لينذر} (¬9) بالتاء، مدني، وشامي (¬10)، و [البزي] (¬11) بخلاف PageV24P077(@)(@@) عنه (¬1)، ويعقوب، وأيوب (¬2) (¬3)، واختاره أبو عبيد، وأبو حاتم على خطاب النبي - صلى الله عليه وسلم - (¬4)، وقرأ الباقون بالياء (¬5) على (¬6) الخبر عنه (¬7) (¬8)، وقيل: عن الكتاب (¬9).(@)(@@) {الذين ظلموا} أنفسهم بالكفر والمعصية {وبشرى للمحسنين} وفي (¬10) {وبشرى} وجهان من الإعراب: الرفع على العطف على(@)(@)PageV24P078(@)(@)(@@)(@@)(@@) || CHECK 15(@)(@)(@@) الكتاب مجازه (وهذا كتاب مصدق وبشرى) (¬1)، والنصب على معنى (لتنذر الذين ظلموا وتبشر المحسنين) (¬2) فلما جعل مكان و (تبشر) (¬3) (بشرى) أو (بشارة)، نصب كما يقال: أتيتك لأزورك وكرامة لك، وقضاء حقك. بمعني (¬4) لأزورك وأكرمك وأقضي حقك (¬5)، فنصبت الكرامة والقضاء بفعل مضمر (¬6).(@)(@)(@@)(@@)(@@) || AUTO 13(@)(@)(@@) - قوله تعالى: {إن الذين قالوا ربنا الله ثم استقاموا فلا خوف عليهم ولا هم يحزنون(@)(@)(@@)(@@)(@@) || AUTO (13)(@)(@)(@@) أولئك أصحاب الجنة خالدين فيها جزاء بما كانوا يعملون(@)(@)(@@)(@@)(@@) || AUTO (14)(@)(@)(@@) ووصينا الإنسان بوالديه}(@)(@@) {حسنا} قراءة العامة: بضم الحاء، وغير ألف قبلها (¬7)، وقرأ أهل الكوفة: {إحسانا} (¬8)، PageV24P079(@)(@@) وهي قراءة ابن عباس - رضي الله عنه - (¬1).(@)(@@) {حملته أمه كرها} بكره، ومشقة (¬2) (¬3)، (الكوفيون، وابن ذكوان بضم الكاف في الحرفين) (¬4) (¬5) {ووضعته كرها وحمله وفصاله} وفطامه (¬6)، وقرأ الحسن، ويعقوب: (وفصله) بغير ألف (¬7) {ثلاثون شهرا} قال المفسرون: حمله 
ms3140	 ستة أشهر، ورضاعه أربعة وعشرون شهرا (¬8).(@)(@)PageV24P080(@)(@)(@@) وقال ابن إسحاق: تحمله (¬1) تسعة أشهر، وفصاله من اللبن لأحد (¬2) وعشرين شهرا (¬3)(@)(@@) {حتى إذا بلغ أشده} نهاية قوته وقامته وغاية شبابه واستوائه وهو ما بين ثماني عشرة سنة إلى أربعين سنة، فذلك قوله: {وبلغ أربعين سنة} (¬4).(@)(@@) قال السدي والضحاك: نزلت هذه الآية في سعد بن أبي وقاص - رضي الله عنه -، وقد مضت القصة (¬5).(@)(@)PageV24P081(@)(@)(@@) وقال الآخرون (¬1): نزلت (¬2) في أبي بكر الصديق، وأبيه أبي قحافة عثمان [بن عامر] (¬3) بن عمرو (¬4)، وأمه: أم الخير بنت صخر بن عمرو ابن عامر (¬5)، فلما بلغ أبو بكر - رضي الله عنه - أربعين سنة آمن بالنبي - صلى الله عليه وسلم -، وقال لربه: {إني تبت إليك وإني من المسلمين} (¬6).(@)(@@) [2724] أخبرني ابن فنجويه (¬7)، حدثنا ابن شنبة (¬8)، حدثنا إسحاق بن صدقة (¬9)، حدثنا عبد الله بن هاشم (¬10)، عن سيف بن PageV24P082(@)(@@) عمر (¬1)، عن عطية (¬2)، عن أبي أيوب (¬3)، عن علي - رضي الله عنه - في قوله تعالى: {ووصينا الإنسان بوالديه إحسانا} نزلت (¬4) في أبي بكر - رضي الله عنه -، أسلم أبواه جميعا ولم يجتمع لأحد من أصحاب رسول الله - صلى الله عليه وسلم - المهاجرين من أسلم (¬5) أبواه غيره، أوصاه الله بهما ولزم ذلك من بعده (¬6).(@)(@@) {قال رب أوزعني} ألهمني وأولعني (¬7) {أن أشكر نعمتك التي أنعمت علي وعلى والدي وأن أعمل صالحا ترضاه وأصلح لي في ذريتي} أن (¬8) تجعلهم مؤمنين صالحين، قالوا: فأجاب الله تعالى (¬9) أبا بكر - رضي الله عنه - في أولاده فأسلموا، ولم يكن أحد من الصحابة أسلم هو ووالداه وبنوه وبناته إلا أبو بكر - رضي الله عنه - وعنهم.(@)(@)PageV24P083(@)(@)(@@) {إني تبت إليك وإني من المسلمين}.(@)(@)(@@)(@@)(@@) || AUTO 16(@)(@)(@@) - {أولئك الذين نتقبل عنهم أحسن} (¬1)(@)(@@) قرأ حفص وحمزة والكسائي {نتقبل} بالنون {ونتجاوز}، ونصب {أحسن} (¬2) (¬3) {ما عملوا} يعني: أعمالهم الصالحة (¬4) فيثيبهم عليها {ونتجاوز عن سيئاتهم} (¬5) فلا يعاقبهم بها (¬6) {في أصحاب الجنة} أي (¬7): مع أصحاب الجنة (¬8)، (في) بمعنى (مع) (¬9) {وعد الصدق الذي كانوا PageV24P084(@)(@@) يوعدون} وهو قوله تعالى: {وعد الله المؤمنين والمؤمنات جنات} (¬1) (¬2).(@)(@)(@@)(@@)(@@) || AUTO 17(@)(@)(@@) - قوله تعالى: {والذي قال لوالديه}(@)(@@) إذ دعواه (¬3) إلى الإيمان بالله والإقرار 