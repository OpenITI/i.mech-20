ms221	 % مثل شكر الحر الشريف الأديب % 2(@)(@@) % إنما تبذل اللهى لابتغاء ال % % حمد في سد خلة المنكوب % 3(@)(@@) % ليس في الباذلات مكتسب الأم % % وال في كسب موبقات الذنوب % 4(@)(@@) % كل وفر يفنى ويبقى من الصا % % حب حسن الثناء للمصحوب % PageV01P801 البحر : - 1(@)(@@) % يا شبابي وأين مني شبابي % % آذنتني حباله بانقضاب % 2(@)(@@) % دولة يغمر الزمان فتاها % % سودت بالسواد سيمى الشباب % 3(@)(@@) % لهف نفسي على نعيمي ولهوي % % تحت أفنانه اللدان الرطاب % 4(@)(@@) % ومعز عن الشباب مؤس % بمشيب اللدات والأتراب % 5(@)(@@) % قلت لما انتحى يعد أساه % من مصاب شبابه فمصاب % 6(@)(@@) % ليس تأسو كلوم غيري كلومي % % ما به ما به وما بي ما بي % % PageV01P802 البحر : - 1(@)(@@) % وقصير تراه فوق يفاع % فتراه كأنه في غيابه % 2(@)(@@) % لم تدع قفده يد الدهر حتى % % قمعت فيه طوله وشبابه % 3(@)(@@) % وجلت رأسه نعما فأضحى % % بارز الصرح ما يوارى صؤابه % 4(@)(@@) % يا أبا حفص الذي فطن الده % ر لميدان رأسه فاستطابه % 5(@)(@@) % ظرف الدهر في اتخاذك صفعا % % نا وما خلته ظريف الدعابه % PageV01P803 البحر : - 1(@)(@@) % وما قتل بعض الحي بعضا بناهك % % قواه إذا ما جاء حي يحاربه % 2(@)(@@) % وما لطم بعض الموج في البحر بعضه % بمانعه تغريق من هو راكبه % PageV01P804 البحر : - 1(@)(@@) % أمسى الشباب رداء عنك مستلبا % % ولن يدوم على العصرين ما اعتقبا % % 2(@)(@@) % أعزز علي بأن أضحت مناسبه % بدلن فيه وفي أيامه ندبا % % 3(@)(@@) % سقيا لأزمان لم أستسق من أسف % لما تولى ولا بكيت ما ذهبا % % 4(@)(@@) % أيام أستقبل المنظور مبتهجا % ولا أحن إلى المذكور مكتئبا % % 5(@)(@@) % لله درك من عهد ومن زمن % لا يبعدا بعدا بالرغم أو قربا % % 6(@)(@@) % إذا أصحب الدهر مغترا بصحبته % % إذا أعار متاعا خلته وهبا % % 7(@)(@@) % لا أحسب العيس يبلى ثوب جدته % ولا إخال زماني يعقب العقبا % % 8(@)(@@) % أغدو فأجني ثمار اللهو دانية % مثل الغصون وأرمي صيده كثبا % % 9(@)(@@) % بينا كذلك إذ هبت مزعزعة % أضحى لها مجتنى اللذات محتطبا % % 10(@)(@@) % يا ظبية من ظباء كان مسكنها % % في ظل غصني إذا ظل الضحى التهبا % % PageV01P805 11(@)(@@) % فيئي 
ms222	 إليك فقد هزته معصفة % لم تترك ورقا منه ولا هدبا % % 12(@)(@@) % أصبحت شيخا له سمت وأبهة % يدعونني البيض عما تارة وأبا % % 13(@)(@@) % وتلك دعوة إجلال وتكرمة % وددت أني معتاض بها لقبا % % 14(@)(@@) % قد كنت أدعى ابن عم مرة وأخا % حتى تقلب دهر يعقب العقبا % % 15(@)(@@) % واها لذلك في الأنساب من نسب % لكن يا عم لا واها ولا نسبا % % 16(@)(@@) % عجبت للمرء لا يحمي حقيقته % مسلوبة كيف يحمي بعدها سلبا % % 17(@)(@@) % قالوا المشيب نذير قلت لا وأبي % % لكن بشير يجلي وجهه الكربا % % 18(@)(@@) % أليس يخبر من أرسى بساحته % أن اللحاق بحب النفس قد قربا % % 19(@)(@@) % يا حسن هاتيك بشرى عند ذي أسف % على الشبيبة والعيش الذي نضبا % % 20(@)(@@) % لم يرع حق شباب كان يصحبه % من لم يحبب إليه فقده العطبا % % PageV01P806 21(@)(@@) % لو لم يجب حفظه إلا لأن له % حق الرضاع على إخوانه وجبا % % 22(@)(@@) % أخي وإلفي وتربي كان مولدنا % % معا وربتني الأيام حيث ربا % % 23(@)(@@) % يضمنا حجر أم في رضاعتنا % % وملعب حيث نأتي بيننا اللعبا % % 24(@)(@@) % إن الشباب لمألوف لصحبته % تلك القديمة مبكي إذا ذهبا % % 25(@)(@@) % والشيب مستوحش منه لغربته % % والشيء مستوحش منه إذا اغتربا % % 26(@)(@@) % دع الخلافة يا معتز من كثب % فليس يكسوك منها الله ما سلبا % % 27(@)(@@) % أترتجي لبسها من بعد خلعكها % % هيهات هيهات فات الضرع ما حلبا % % 28(@)(@@) % تالله ما كان يرضاك المليك لها % % قبل احتقابك ما أصبحت محتقبا % % 29(@)(@@) % حتى أذلك عنها ثم أبدلها % % كفؤا رضيا لذات الله منتجبا % % 30(@)(@@) % فكيف يرضاك بعد الموبقات لها % % لا كيف لا كيف إلا المين والكذبا % % PageV01P807 31(@)(@@) % هذي خراسان قد جاشت حلائبها % % تزجي لنصر أخيها عارضا لجبا % % 32(@)(@@) % كالبحر ألقى عليه الليل كلكله % وزعزعت جانبيه الريح فاضطربا % % 33(@)(@@) % خيل عليهن آساد مدربة % تأجموا الأسل الخطي لا القصبا % % 34(@)(@@) % مستلئمون حصينات مقاتلهم % % مكممون حبيك البيض واليلبا % % 35(@)(@@) % والمصعبيون قوم من شمائلهم % % قتل الملوك إذا ما قتلهم وجبا % % 36(@)(@@) % هم الألى ينصرون الحق نصرته % ولا يبالون فيه عتب من عتبا % % 37(@)(@@) % الأوفياء إذا 
ms223	 ما معشر نكثوا % % والجاعلون الرضا لله والغضبا % % 38(@)(@@) % قد جرب الناس قبل اليوم أنهم % % معودون إذا ما حاربوا الغلبا % % 39(@)(@@) % يا من جنى لأبيه القتل ثم غدا % % حربا لثائره صدقت من ثلبا % % 40(@)(@@) % يا أولياء عهود الشر هونكم % من غالب الله في سلطانه غلبا % % PageV01P808 41(@)(@@) % لقد جزيتم أباكم حين كرمكم % بالعهد أسوأ ما يجزى البنون أبا % % 42(@)(@@) % أضحى إمام الهدى أولى به صلة % منكم وإن كنتم أولى به نسبا % % 43(@)(@@) % هو الذي سل سيف الثأر دونكم % لا يأتلي للذي ضيعتم طلبا % % 44(@)(@@) % أقام في الناس عصرا لا يخيل لها % % ولا يرشح من أسبابها سببا % % 45(@)(@@) % وكان لله غيب فيه يحجبه % عنا وعنه مع الغيب الذي حجبا % % 46(@)(@@) % حراسة من عدو أن يكيد له % كيدا يحرق في نيرانه الحطبا % % 47(@)(@@) % بل عصمة من ولي الصالحات له % كيلا يجشمه حرصا ولا تعبا % % 48(@)(@@) % حتى إذا مهد الله الأمور له % وراض من جمحات الملك ما صعبا % % 49(@)(@@) % تبلجت غرة غراء واضحة % مثل الشهاب إذا ما ضوؤه ثقبا % % PageV01P809 البحر : - 1(@)(@@) % جعل الله مهربا % % وامتطى الليل مركبا % % 2(@)(@@) % خادم كان مرة % مسرفا ثم أعتبا % % 3(@)(@@) % راكعا ساجدا له % ليس يألو تقربا % % 4(@)(@@) % فرض الخوف دمعه % لثرى الأرض مشربا % % 5(@)(@@) % لو تراه إذا دعا % % يا مليكا محجبا % % 6(@)(@@) % اعف عني فقد ركب % ت من الأمر معطبا % % 7(@)(@@) % كسبتني جرائمي % % مكسبا ساء مكسبا % % 8(@)(@@) % ثم يهتز كالقضي % % ب إذا هبت الصبا % % 9(@)(@@) % أمن الخوف عندها % % ظنه أن يخيبا % % PageV01P810 البحر : - 1(@)(@@) % علني أحمد من الدوشاب % % شربة بغضت قناع الشباب % 2(@)(@@) % لو تراني وفي يدي قدح الدو % % شاب أبصرت بازيار غراب % 3(@)(@@) % ماثلا لا يزايل الكف بالشر % ب وأنى بشرب غير الشراب % 4(@)(@@) % ثم جشمت شربه فتجشم % % ت عذابا يجوز حد العذاب % 5(@)(@@) % ثم أومى بالعود قلت له العو % د حميد لكن إلى مستطاب % 6(@)(@@) % لا أحب المعاد من حفرة القب % ر إذا شيب لي بسوء المآب % 7(@)(@@) % قال ماذا نقمت قلت له قو % لك ماذا نقمت سوء الحساب 
ms224	 % 8(@)(@@) % أنت في لزك العتاب بمن يك % % ره شرب الزقوم أهل العتاب % 9(@)(@@) % ليس بيني وبين قسيس عتاب % غير طعن الكلى وضرب الرقاب % 10(@)(@@) % ما جنينا إليك ذنبا فلا تع % جل علينا بمثل هذا العقاب % PageV01P811 البحر : - 1(@)(@@) % أرضى بصورته وصد فأغضبا % % فغدا المحب منعما ومعذبا % % 2(@)(@@) % يا وجه من أهوى لقد أعتبتني % % لو أن نائله الممنع أعتبا % % 3(@)(@@) % ظبي كأن الله كمل حسنه % ليغيظ سربا أو يكايد ربربا % % 4(@)(@@) % خنث الدلال إذا تبهنس أوثقت % حركاته وإذ تكلم أطربا % % 5(@)(@@) % ذو صورة تحلو وتحسن منظرا % ومراشف تصفو وتعذب مشربا % % 6(@)(@@) % فإذا بدا للزاهدين ذوي التقى % % وجدت هناك قلوبهم متقلبا % % 7(@)(@@) % متوشح بمعاذتين يخيفه % ما لا يخاف وقد سبى من قد سبى % % 8(@)(@@) % متسلح للعين لا متزين % % إلا بما طبع الإله وركبا % % 9(@)(@@) % قاس الملابس والحلي بوجهه % % فرأى محاسن وجهه فتسلبا % % 10(@)(@@) % أغناه ذاك الحسن عن تلك الحلي % % وكفاه ذاك الطيب أن يتطيبا % % PageV01P812 11(@)(@@) % فغدا سليبا غير أن ملابسا % يحمينه الأبصار أن يتنهبا % % 12(@)(@@) % ويقينه برد الهواء وحره % إن أصرد العصران أو إن ألهبا % % 13(@)(@@) % يكسى الثياب صيانة وحجابة % وهو الحقيق بأن يصان ويحجبا % % 14(@)(@@) % كالدرة الزهراء ألبس لونها % % صدفا يغار عليه كي لا يشحبا % % 15(@)(@@) % ومن العجائب أن يرى متعوذا % من عين عاشقه ألا فتعجبا % % 16(@)(@@) % أيخاف عيني من قتلت بحبه % قلب الحديث كما اشتهى أن يقلبا % % 17(@)(@@) % لاقيت من صدغ عليه معقرب % % أفعى تبرح بالفؤاد وعقربا % % 18(@)(@@) % يكسوه صورة مخلب فكأنما % % ينحى على كبدي وقلبي مخلبا % % 19(@)(@@) % إني لأرجو بالخليقة شبهه % مما أحل لنا الإله وطيبا % % 20(@)(@@) % أو ما ترى فيما أباح محمد % عما حماه من الخبائث مرغبا % % PageV01P813 21(@)(@@) % لا سيما وقد اكتهلت وقد ترى % % ورع الإمام وبأسه المتهيبا % % 22(@)(@@) % أضحت أمور الناس عند مصيرها % % في كف من حامى وجاد وأدبا % % 23(@)(@@) % دينا تكهل فاستقام صراطه % % ومعاش دنيا للأنام تسببا % % 24(@)(@@) % الله أكبر والنبي محمد % وابن الخليفة غالب لن يغلبا % % 25(@)(@@) % رزق الإمام بعقب هلك عدوه % ولدا أطاب به الإمام 
ms225	 وأنجبا % % 26(@)(@@) % صدقت بشارته وأفلح فأله % % هلك العدا ونجا الإمام وأعقبا % % 27(@)(@@) % أحيا لنا أملا وأردى مارقا % قد كان لفف للفساد وألبا % % 28(@)(@@) % لا زال من والى الإمام ووده % يحيا ومن عاداه يلقى معطبا % % 29(@)(@@) % لله من ولد أتى وربيعنا % % مستحكم وجنابنا قد أخصبا % % 30(@)(@@) % ضحك الزمان إليه ضحكة قائل % يا مرحبا بابن الخليفة مرحبا % % PageV01P814 31(@)(@@) % فغدا ومولده بشير كله % بالنصر لم يك مثله ليكذبا % % 32(@)(@@) % ذكر أغر كأن غرة وجهه % رأي الإمام إذا أضاء الغيهبا % % 33(@)(@@) % ضمن النجابة عنه يوم ولاده % قمر وشمس أدياه وكوكبا % % 34(@)(@@) % وافى الإمام وقد أجد رحيله % عضدا يعين على الخطوب ومنكبا % % 35(@)(@@) % حقا لقد نطق البشير بيمنه % ولربما نطق البشير فأعربا % % 36(@)(@@) % فأل لعمرك لم أعفه ولم أعف % منه البريح ولا النطيح الأعضبا % % 37(@)(@@) % ورأيته القمري غرد في ذرا % خضراء يانعة الجنى لا الأخطبا % % 38(@)(@@) % ما قوبلت رجل الملوك بمثله % إلا ليملك مشرقا أو مغربا % % 39(@)(@@) % فليمض عزمته الإمام فإنه % % قد هز منها مشرفيا مقضبا % % 40(@)(@@) % فاليمن مقرون به عون له % % ظل عليه إذا الهجير تلهبا % % PageV01P815 41(@)(@@) % والليث في الهيجاء لابس جنة % من نفسه تكفيه أن يتأهبا % % 42(@)(@@) % والله واقيه الردى ومسهل % ما قد رجا ومذلل ما استصعبا % % 43(@)(@@) % هي فرصة سنحت ونعمى أقبلت % % وغنيمة أزفت وصيد أكثبا % % 44(@)(@@) % وافى هزبر بالحديقة مسحلا % وأظل صقر بالبسيطة أرنبا % % 45(@)(@@) % وجد السنان من الطريدة مطعنا % ورأى الحسام من الضريبة مضربا % % 46(@)(@@) % لا يهلكن على الخليفة هالك % قد أرغب الناس الإمام وأرهبا % % 47(@)(@@) % هو عارض زجل فمن شاء الحيا % % أرضى ومن شاء الصواعق أغضبا % % 48(@)(@@) % ملك إذا اعتسف الملوك طريقهم % % في ملكهم ركب الطريق السبسبا % % 49(@)(@@) % أعلاه طول أن يرى متكبرا % وحماه عز أن يرى متسحبا % % 50(@)(@@) % نمتاح منه حاتميا ماجدا % ونثير منه هاشميا قلبا % % PageV01P816 51(@)(@@) % يهتز حين يهز لدنا ناعما % وإذا قرعت قرعت صلدا صلبا % % 52(@)(@@) % ما زال قدما عرفه متوقعا % لعفاته ونكيره مترقبا % % 53(@)(@@) % والعفو منه سجية لكنه % % يعفو إذا ما العفو كان الأصوبا % % 54 
ms226	(@)(@@) % فإذا جنى جان تغاضت عينه % عن ذنبه فكأنه ما أذنبا % % 55(@)(@@) % وإذا تتابع في الخيانة أهلها % % جدع الأنوف ما الجباه فأوعبا % % 56(@)(@@) % فأنا النذير به لغامط نعمة % % وأنا البشير به لحر أجدبا % % 57(@)(@@) % يا ناظمي مدح الإمام وطالبي % % نفحات نائله ذهبتم مذهبا % % 58(@)(@@) % وافى مصاب من سحاب ريه % % ورأى سحاب في مصاب مسكبا % % 59(@)(@@) % أما عداه فما أصابوا مهربا % % ومؤملوه فقد أصابوا مطلبا % % 60(@)(@@) % خطب السؤال إلى العفاة ولم يكن % % لولا مكارمه السؤال ليخطبا % % PageV01P817 61(@)(@@) % ورمى نحور الخائنين بسهمه % وتراسهم قدر البقاء فما نبا % % 62(@)(@@) % ومتى أراد الله قصر مدة % وإذا قضى فأراد أمرا عقبا % % 63(@)(@@) % وأقول قول مسدد في زجره % يقضي القضية لم يكن ليؤنبا % % 64(@)(@@) % سيطول عمر إمامنا في غبطة % % حتى يواكب من بنيه موكبا % 65(@)(@@) % مقلوب كنيته يخبر أنه % % سيرى لسابع سبعة غر أبا % % 66(@)(@@) % حتى تراه في بنيه قد احتبى % % فيخال يذبل في الهضاب قد احتبى % % 67(@)(@@) % ولقد أتاه مبشران بخمسة % رد الإله على الإمام الغيبا % % 68(@)(@@) % ليرى الإمام تكهني وتطيبي % % فلقد تكهن عبده وتطيبا % % 69(@)(@@) % إني وجدت له فئولا جمة % منه ولم أزجر كغيري ثعلبا % % 70(@)(@@) % حق الخليفة أن أطيل مديحه % لكنني أوجزت لما أطنبا % % PageV01P818 71(@)(@@) % طالت يداه على لساني فانتهت % تلك البلاغة فانتهيت وأسهبا % % PageV01P819 البحر : - 1(@)(@@) % صديق ليس يمكن من خطابه % ولا يرعى ذمام ذوي طلابه % 2(@)(@@) % لقيت البرح يوما من لقاء % له قاس ويوما من حجابه % 3(@)(@@) % يعذبني وأصبر كل يوم % فينقم أن صبرت على عذابه % 4(@)(@@) % ويزعم أنني رجل ملح % وما ألححت إلا باكتسابه % 5(@)(@@) % إذا ما كان لا يأسا مبينا % ولا نجحا فإني باجتنابه % 6(@)(@@) % ستأتيه بما اكستبت يداه % قواف لم تدون في حسابه % PageV01P820 البحر : - 1(@)(@@) % فأما ابن بوران الذي تذكرونه % % فليس سوى اسم مفترى متكذب % 2(@)(@@) % ورب مسمى لا حقيقة لاسمه % كعرس وآوى أو كعنقاء مغرب % PageV01P821 البحر : - 1(@)(@@) % يا آل وهب شهدت ضرطة % سارت بها الأمثال في وهب % 2(@)(@@) % بأنها من فقحة رخوة % % وأنها من مضرط رحب % 3(@)(@@) % قد كنتم 
ms227	 من قبل إرسالها % % أحدوثة في الشرق والغرب % 4(@)(@@) % فالآن حقا أطلقت فيكم % بكل ثلب ألسن الثلب % 5(@)(@@) % لو كنتم تعفون أستاهكم % % ما بتم منها على عتب % 6(@)(@@) % لكنكم تحشونها دهركم % % فكلكم متسع الثقب % PageV01P822 البحر : - 1(@)(@@) % يا أبا روبة الريب % يا مسيحا بغير أب % 2(@)(@@) % يا بن أكالة المني % % ي وبلاعة العصب % 3(@)(@@) % كم سمعنا مقالها % % وهي تجثو على الركب % 4(@)(@@) % رحم الله من سقى % % رحم الله من شرب % PageV01P823 البحر : - 1(@)(@@) % وقفنا فلولا أننا راضنا الهوى % % لهتكنا عند الرقيب نحيب % 2(@)(@@) % وفي دون ما نلقاه من ألم الهوى % % تشق جيوب بل تشق قلوب % 3(@)(@@) % ولما بصرنا بالرقيب ولحظه % ولحظي على عين الرقيب رقيب % 4(@)(@@) % صددنا فكل قد طوى تحت صدره % فؤادا بين الضلوع وجيب % PageV01P824 البحر : - 1(@)(@@) % قالوا اشتكت عينه فقلت لهم % % من كثرة القتل مسها الوصب % 2(@)(@@) % حمرتها من دماء من قتلت % والدم في النصل شاهد عجب % PageV01P825 البحر : - 1(@)(@@) % نبت عينها عن عاشق قبحت لها % % محاسنه المسكين آثار حبه % 2(@)(@@) % فقالت لها أترابها حين أعرضت % % بذنبك عاقبت الفتى لا بذنبه % 3(@)(@@) % هواك الذي أبلاه حتى شنئته % وحتى رأيت الموت عدلا لقربه % 4(@)(@@) % وقد تسلميه للمنية بعدما % % ذهبت بحلو العيش منه وعذبه % PageV01P826 البحر : - 1(@)(@@) % لعمري لقد عولت يوم تحملوا % % على هاطل من دمع عينك ساكب % 2(@)(@@) % فلم تبرد العينان بالدمع حرقة % ولم تطفئا حر الهوى المتراكب % 3(@)(@@) % وأبرح شيء فرقة بعد ألفة % وفقدك من علقت بعد التقارب % PageV01P827 البحر : - 1(@)(@@) % إذا جئت أشكو ما بقلبي من الأسى % % إلى مؤنسي أبدى القلى وتغضبا % % 2(@)(@@) % وأظهر لي بعد الوصال تجنيا % فأصبر خوفا منه أن يتجنبا % % 3(@)(@@) % وأكتمه وجدي وأجمل صبوتي % % وأخضع كي يرضى وإن كان مذنبا % % 4(@)(@@) % وفي القلب نار من تخوف غدره % تزيد على مر الليالي تلهبا % % PageV01P828 البحر : - 1(@)(@@) % الله يعلم أنني % % يا سيدي أحيا بقربك % 2(@)(@@) % كمد على ما فات من % ك فلا بليت بيوم عتبك % 3(@)(@@) % وهواك شغلي عن سوا % % ك فليتني من شغل قلبك % PageV01P829 البحر : - 1(@)(@@) % يا غائبا عني بعيد الإياب 
ms228	 % نغصني فقدك برد الشراب % 2(@)(@@) % لهفي على لبسك ثوب البلى % % من قبل إخلاقك ثوب الشباب % PageV01P830 البحر : - 1(@)(@@) % أيها الواعد الذي % % برقه الدهر خلب % 2(@)(@@) % لست أدري أأنت أم % ظن راجيك أكذب % PageV01P831 البحر : - 1(@)(@@) % وصحابة ناكوا القيان تظرفا % يوما فنكت زوامرا ورقائبا % % 2(@)(@@) % إني امرؤ إن لم يكن لي موضع % في مركب يوما ركبت القاربا % % PageV01P832 البحر : - 1(@)(@@) % أصبحت في محن للدهر أعظمها % % جفاء مثلك مثلي في نوائبها % % 2(@)(@@) % أما عجائب دنيانا فقد خلقت % والظلم منك جديد من عجائبها % % PageV01P833 البحر : - 1(@)(@@) % وفي أربع مني خلت منك أربع % فلست بدار أيها هاج لي كربي % % 2(@)(@@) % أوجهك في عيني أم الريق في فمي % % أم النطق في سمعي أم الحب في قلبي % % PageV01P834 البحر : - 1(@)(@@) % قالت غلالته القصب % لما تثنى وانتصب % 2(@)(@@) % مالي جنيت جناية % حتى صلبت على الخشب % PageV01P835 البحر : - 1(@)(@@) % أشرب الماء إذا ما التهبت % نار أحشائي لإطفاء اللهب % 2(@)(@@) % فأراه زائدا في حرقتي % % فكأن الماء للنار حطب % PageV01P836 البحر : - 1(@)(@@) % كيف يرجو الحياء منه صديق % ومكان الحياء منه خراب % PageV01P837 البحر : - 1(@)(@@) % وقد كنت ذا حال أطيل ادكارها % % وإرعاءها قلبي لأهتز معجبا % % 2(@)(@@) % فبدلت حالا غير هاتيك غايتي % % تناسي ذكراها لتغرب مغربا % % 3(@)(@@) % وكنت أدير الكأس ملأى روية % لأجذل مسرورا بها ولأطربا % % 4(@)(@@) % وكانت مزيدا في سروري ومتعتي % % فأضحت مفرا من همومي ومهربا % % PageV01P838 البحر : - 1(@)(@@) % طربت إلى المراة فروعتني % % طوالع شيبتين ألمتا بي % % 2(@)(@@) % فأما شيبة ففزعت منها % % إلى المقراض حبا للتصابي % % 3(@)(@@) % وأما شيبة فصفحت عنها % % لتشهد بالبراءة من خضابي % % 4(@)(@@) % فأعجب بالدليل على مشيبي % % أقمت به الدليل على شبابي % % PageV01P839 البحر : - 1(@)(@@) % ظبيك يا ذا حسن وجهه % وما سوى ذاك جميعا يعاب % 2(@)(@@) % فافهم كلامي يا أبا مالك % لا يشبه العنوان ما في الكتاب % PageV01P840 البحر : - 1(@)(@@) % وامتناع النفس مما تشتهي % % خشية الإنفاق نقص في النسب % PageV01P841 البحر : - 1(@)(@@) % قل لأبي القاسم المرجى % % قابلك الدهر بالعجائب % 2(@)(@@) % مات لك ابن وكان زينا % وعاش ذو النقص والمثالب % 3(@)(@@) % حياة هذا كموت هذا % % فلست تخلو من المصائب % PageV01P842 البحر : - 1 
ms229	(@)(@@) % دعوا الأسد تربض في غابها % % ولا تدخلوا بين أنيابها % % PageV01P843 البحر : - 1(@)(@@) % ولما رأيت الدهر يؤذن صرفه % بتفريق ما بيني وبين الحبائب % 2(@)(@@) % رجعت إلى نفسي فوطنتها على % % ركوب جميل الصبر عند النوائب % 3(@)(@@) % ومن صحب الدنيا على جور حكمها % % فأيامه محفوفة بالمصائب % 4(@)(@@) % فخذ خلسة من كل يوم تعيشه % وكن حذرا من كامنات العواقب % 5(@)(@@) % ودع عنك ذكر الفأل والزجر واطرح % % تطير جار أو تفاؤل صاحب % PageV01P844 البحر : - 1(@)(@@) % يا صاحبا أعضل في كيده % لست خبيرا أيها الصاحب % 2(@)(@@) % فهمت أبياتك تلك التي % % أثقب فيها كيدك الثاقب % 3(@)(@@) % بيت وبيت عقرب تتقى % % وأري نحل في اللها ذاهب % 4(@)(@@) % جرحتني فيها وداويتني % % فأنت أنت الصادع الشاعب % PageV01P845 البحر : - 1(@)(@@) % أموركم بني خاقان عندي % % عجاب في عجاب في عجاب % 2(@)(@@) % قرون في رؤوس في وجوه % صلاب في صلاب في صلاب % 3(@)(@@) % هجرتكم وهجركم ورائي % % صواب في صواب في صواب % PageV01P846 البحر : - 1(@)(@@) % وزهدني في الناس معرفتي بهم % % وطول اختباري صاحبا بعد صاحب % 2(@)(@@) % فلم ترني الأيام خلا يسرني % % بواديه إلا ساءني في العواقب % 3(@)(@@) % ولا صرت أدعوه لدفع ملمة % من الدهر إلا كان إحدى النوائب % PageV01P847 البحر : - 1(@)(@@) % ومستقر على كرسيه تعب % روحي الفداء له منصب نصب % 2(@)(@@) % رأيته سحرا يقلي زلابية % في رقة القشر والتجويف كالقصب % 3(@)(@@) % كأنما زيته المغلي حين بدا % % كالكيمياء التي قالوا ولم تصب % 4(@)(@@) % يلقى العجين لجينا من أنامله % فيستحيل شبابيطا من الذهب % PageV01P848 البحر : - 1(@)(@@) % مدحتكم طمعا فيما أؤمله % فلم أنل غير حظ الإثم والوصب % 2(@)(@@) % إن لم تكن صلة منكم لذي أدب % فأجرة الخط أو كفارة الكذب % PageV01P849 البحر : - 1(@)(@@) % أبكيتني فبكيت % من غير ذنب جنيت % 2(@)(@@) % وقلت لي امض عني % % مصاحبا فمضيت % 3(@)(@@) % ولو أمرت أن أقضي ال % % حياة أيضا قضيت % 4(@)(@@) % أضعتني فرعيت % وخنتني فوفيت % 5(@)(@@) % أطعت في الأعادي % % وكلهم قد عصيت % 6(@)(@@) % فكيف أصبحت غضبى % % لما رضاك أتيت % 7(@)(@@) % فاستضحكت ثم قالت % % جننت قلت رضيت % 8(@)(@@) % قالت لعل وصالي % % أبيت قلت أبيت % 9(@)(@@) % قالت ثكلت أبي إن % % فعلت 
ms230	 إن باليت % 10(@)(@@) % فلم تزل بي حتى % % إلى هواها ارعويت % PageV01P850 البحر : - 1(@)(@@) % يوم كأن سماءه % تحكي جفوني حين بنتا % % 2(@)(@@) % لما غدت كسحائب % أيقظن بالعبرات نبتا % % 3(@)(@@) % متبسما عن شبه مب % سمك البرود إذا ابتسمتا % % 4(@)(@@) % متنسما عن مثل نش % رك للضجيع إذا انتبهتا % % 5(@)(@@) % يا غايتي في منيتي % % ماذا يضرك لو مننتا % % 6(@)(@@) % برضا يعيش ببرده % قلب بسخطك قد أمتا % % 7(@)(@@) % ورددت غمضا صد عن % طرف المتيم مذ صددتا % % 8(@)(@@) % وبسطت من أمل بوص % لك ما بهجري قد قبضتا % % 9(@)(@@) % نفسي فداؤك إن جفو % % ت وإن وصلت وإن قطعتا % % 10(@)(@@) % فاسلم بعيش سالم % من كل بؤس ما سلمتا % % PageV01P851 البحر : - 1(@)(@@) % كيف يا من بها قوام حياتي % % كنت بعدي مذ بنت يا مولاتي % % 2(@)(@@) % أعلى العهد أنت أم حلت عنه % % جعل الله قبل ذاك مماتي % % 3(@)(@@) % لست أنسى امتناع صبرك للتو % ديع والبين مؤذن بشتات % 4(@)(@@) % وانحدار الدموع كاللؤلؤ الرط % ب هوى من مدامع قرحات % 5(@)(@@) % في رياض من الشقائق والنس % رين فوق المراشف الباردات % 6(@)(@@) % والتفاتا نحوي وقد قبضتني % % عنك أيدي النوى حيال التفاتي % % 7(@)(@@) % ومقالا جرى وللشوق في الأح % % شاء نار أليمة الحرقات % 8(@)(@@) % حاطك الله بالكلاءة والصن % % ع ووقاك أعين العائدات % PageV01P852 البحر : - 1(@)(@@) % لأبي يوسف بنت % ليته أعقم ليته % 2(@)(@@) % تشبه القرد أو الشي % طان إن كنت رأيته % 3(@)(@@) % قلت لما سامنيها % % بعض من يألف بيته % 4(@)(@@) % أزنا وابنة يعقو % % ب أخنزيرا وميته % 5(@)(@@) % فقلت شأنك والمحجوج معترف % إن لم يعابد إذا ما حجة وجبت % 5(@)(@@) % الإست دار خراج إن هي اجتبيت % خرجا ولا دخل يأتيها فقد عطبت % 5(@)(@@) % خربتها بالأيور النازلات بها % % فقال أخطأت بل لو عطلت خربت % 5(@)(@@) % لله خالد الطائي من رجل % ثبت المقام إذا ما حجة عزبت % 5(@)(@@) % قد رميت الغرض المر % مي إن كنت رميته % PageV01P853 البحر : - 1(@)(@@) % تجنت فقال الكاشحون تجنت % وضنت فقال الناس ويحك ضنت % % 2(@)(@@) % فقلت لهم لا تعجلوا بملامتي % % فلم تأت ما قلتم ولكن أدلت % 3(@)(@@) % إذا أنت جانبت 
ms231	 الغداة مسرتي % % وواليت أعدائي فأنت عدوتي % % 4(@)(@@) % ستدرين كيف الهجر لو قد أردته % وإن كنت سؤلي في الحياة ومنيتي % % PageV01P854 البحر : - 1(@)(@@) % قد وصلت قارورتي % % وحاجتي ما وصلت % 2(@)(@@) % تسيل مستعبرة % بأي ذنب قتلت % 3(@)(@@) % فأصبحت قد غيرت % عن حالها وبدلت % 4(@)(@@) % مكسورة منقوصة % ليست كأخرى كملت % 5(@)(@@) % كسورة قد غيرت % % عما عليه أنزلت % 6(@)(@@) % يا حسنها إن نصرت % وقبحها إن خذلت % PageV01P855 البحر : - 1(@)(@@) % خدن أبي المستهل خبرني % % عن جوده في الورى بحرمته % 2(@)(@@) % وقال قد والإله غيبت غر % مولي في فرجها وفقحته % 3(@)(@@) % فقلت صفها فقال أوسع من % % طوق الرحى رخوة كسبته % 4(@)(@@) % وقال محلوقة . فقلت له % % كذبت منتوفة كلحيته % PageV01P856 البحر : - 1(@)(@@) % صبرا على أشياء كلفتها % % أعقبتها الآن وسلفتها % % 2(@)(@@) % ويح القوافي ما لها سفسفت % حظي كأني كنت سفسفتها % % 3(@)(@@) % ألم تكن هوجا فسددتها % % ألم تكن عوجا فثقفتها % % 4(@)(@@) % كم كلمات حكت أبرادها % % وسطتها الحسن وطرفتها % % 5(@)(@@) % ما أحسنت إن كنت حسنتها % % ما ظرفت إن كنت ظرفتها % % 6(@)(@@) % أنحت على حظي بمبراتها % % شكرا لأني كنت أرهفتها % % 7(@)(@@) % فرققته حين رققتها % % وهفهفته حين هفهفتها % % 8(@)(@@) % وكثفت دون الغنى سدها % % حتى كأني كنت كثفتها % % 9(@)(@@) % أحلف بالله لقد أصبحت % في الرزق آفتي وما إفتها % % 10(@)(@@) % لم أشكها قط بتقصيرة % فيها ولا من حيفة حفتها % % PageV01P857 11(@)(@@) % حرمت في سني وفي ميعتي % % قراي من دنيا تضيفتها % % 12(@)(@@) % لهفي على الدنيا وهل لهفة % تنصف منها إن تلهفتها % % 13(@)(@@) % كم أهة لي قد تأوهتها % % فيها ومن أف تأففتها % % 14(@)(@@) % أغدو ولا حال تسنمتها % % فيها ولا حال تردفتها % % 15(@)(@@) % أوسعتها صبرا على لؤمها % % إذا تقصته تطرفتها % % 16(@)(@@) % فيعجز الحيلة منزورها % % إلا إذا ما أنا لطفتها % % 17(@)(@@) % قبحا لها قبحا على أنها % % أقبح شيء حين كشفتها % % 18(@)(@@) % تعسفتني أن رأتني امرأ % لم ترني قط تعسفتها % % 19(@)(@@) % تضعفتني ومتى نالني % % عون أبي الصقر تضعفتها % % 20(@)(@@) % أرجوه عن أشياء جربتها % % وليس عن طير تعيفتها % % PageV01P858 21(@)(@@) % مقدار ما يلبث عني الغنى % % إشارة الإصبع أو لفتها % % 22(@)(@@) % سليت نفسي بأفاعيله % % من بعد 
ms232	 ما قد كنت أسفتها % % 23(@)(@@) % وقد يعزيني شبابا مضى % % ومدة للعيش أسلفتها % % 24(@)(@@) % فكرت في خمسين عاما خلت % كانت أمامي ثم خلفتها % % 25(@)(@@) % تبينت لي إذ تذنبتها % % ولم تبين إذا تأنفتها % % 26(@)(@@) % أجهلتها إذ هي موفورة % ثم نضت عني فعرفتها % % 27(@)(@@) % ففرحة الموهوب أعدمتها % % وترحة المسلوب أردفتها % % 28(@)(@@) % لو أن عمري مائة هدني % % تذكري أني نصفتها % % 29(@)(@@) % فكيف والآثار قد أصبحت % % ترجف بالعمر إذا قفتها % % 30(@)(@@) % كنز حياة كان أنفقته % على تصاريف تصرفتها % % PageV01P859 31(@)(@@) % لا عذر لي في أسفي بعدها % % على العطايا عفتها عفتها % % 32(@)(@@) % إلا بلاغا إن تأبيته % أشقيت نفسي ثم أتلفتها % % 33(@)(@@) % قوت يقيم الجسم في عفة % أشعرتها قدما وألحفتها % % 34(@)(@@) % وقد كددت النفس من بعدما % % رفهتها قدما وعففتها % % 35(@)(@@) % لا طالبا رزقا سوى مسكة % % ولو تعدت ذاك عنفتها % % 36(@)(@@) % طالبت ما يمسكها مجملا % فطفت في الأرض وطوفتها % % 37(@)(@@) % وناكد الجد فمنيتها % % وماطل الحظ فسوفتها % % 38(@)(@@) % وإن أراد الله في ملكه % جاوزت خمسي فأضعفتها % % 39(@)(@@) % بقدرة الله ويمن امرىء % نعماه عمر إن تلحفتها % % 40(@)(@@) % فيها مراد إن ترعيتها % % وأي حرز إن تكهفتها % % PageV01P860 41(@)(@@) % يا واحد الناس الذي لم أجد % % شرواه في الأرض التي طفتها % % 42(@)(@@) % إليك أشكو أنني طالب % خابت ركابي منذ أوجفتها % % 43(@)(@@) % أصبحت أرجوك وأخشى الذي % % جربت من حال تسلفتها % % 44(@)(@@) % فاطرد لي الحرفة وادع الغنى % % واذكر سموطا كنت ألفتها % % 45(@)(@@) % مدائح بالحق نمقتها % % وليس بالباطل زخرفتها % % 46(@)(@@) % أعتدها شكوى تشكيتها % % إليك لا زلفى تزلفتها % % 47(@)(@@) % وكيف أعتد بها زلفة % وإن تعملت فأحصفتها % % 48(@)(@@) % ولم أشرفك بها بل أرى % % بالحق أني بك شرفتها % % 49(@)(@@) % ومن مساع لك ألفتها % % لا من مساعي الناس لففتها % % 50(@)(@@) % تعاورتها فكر جمة % أنضيتها فيك وأزحفتها % % PageV01P861 51(@)(@@) % وأنت لا تبخس ذا كلفة % لا بل ترى أن الغنى رفتها % % 52(@)(@@) % بحق من أعلاك فوق الورى % % إحلافة بالحق أحلفتها % % 53(@)(@@) % لا تخطئني منك في موقفي % % سماء معروف توكفتها % % 54(@)(@@) % أنت المرجى للتي رمتها % % أنت المرجى للتي خفتها % % 55(@)(@@) % كم بلغة ما دونها بلغة % قد 
ms233	 نافرتني إذ تألفتها % % 56(@)(@@) % فرحت لا أرجو ولا أبتغي % % وتاقت النفس فكفكفتها % % 57(@)(@@) % حملت من أمري على صعبة % خليتها إذ عزني كفتها % % 58(@)(@@) % بل خفت من كنت له راجيا % ورجت النفس فخوفتها % % 59(@)(@@) % ولم أخف في ذاك أني متى % % وعدتها رفدك أخلفتها % % 60(@)(@@) % لكنني أفرق من حرفة % أنكرت نفسي منذ عرفتها % % PageV01P862 61(@)(@@) % أقول إذ عنفني ناصح % في رفض أثماد ترشفتها % % 62(@)(@@) % إن أبا الصقر على بعده % % داني العطايا إن تكففتها % % 63(@)(@@) % ثماره في شم أغصانه % لكنني إن شئت عطفتها % % 64(@)(@@) % لا كثمار سمت أغصانها % % إدناءها مني فقصفتها % % 65(@)(@@) % لبابه المعمور أسكفة % لتعتبني إن تسكفتها % % 66(@)(@@) % الآن أسلمت إلى نعمة % غناء نفسا كنت أقشفتها % % 67(@)(@@) % قد وعدتني النفس جدوى له % % إن شئت بعد الله وظفتها % % 68(@)(@@) % تالله لا يقصر دون المنى % % قرى سجاياه التي ضفتها % % 69(@)(@@) % نعمى أبي الصقر التي استبشرت % نفسي برياها وقد سفتها % % 70(@)(@@) % خذها ولا تبرم بها إنني % % قرطتها الحسن وشنفتها % % PageV01P863 71(@)(@@) % بينة من منطق محكم % فتنتها فيك وصرفتها % % 72(@)(@@) % كم نظرة فيها تقصيتها % % كم وقفة فيها توقفتها % % 73(@)(@@) % بمجد آبائك أسستها % % ومجد آلائك شرفتها % % 74(@)(@@) % ضوعت فيكم كل مشمولة % % لكنني من مسككم دفتها % % 75(@)(@@) % ولم أدع في كل ما زانها % % فلسفة إلا تفلسفتها % % 76(@)(@@) % إن كنت بالتطويل كميتها % % فليس بالتثبيج كيفتها % % 77(@)(@@) % لو أن خدي كان أهلا له % واستهدفت لي لتهدفتها % % 78(@)(@@) % يا من إذا صغت أماديحه % % جودتها فيه وزيفتها % % 79(@)(@@) % لو أنها ليل لنورته % باسمك أو شمس لأكسفتها % % PageV01P864 البحر : - 1(@)(@@) % رأيت عبيد الله في كل ليلة % تبيت الأيور العجر حشو حقيبته % 2(@)(@@) % هنيئا له إن البغاء بلية % تعجلها في عنفوان شبيبته % 3(@)(@@) % بخيل على إخوانه غير أنه % يجود على من ناكه بخريبته % 4(@)(@@) % جبان ولكن استه ذات جرأة % ولو لقيت عمرو القنا في كتيبته % 5(@)(@@) % هو البحر حدث عنه كل عجيبة % فليس على المغتاب وزر بغيبته % 6(@)(@@) % فيا ربنا أكرم أباه بثكله % ووالله ما يسوى ثواب مصيبته % PageV01P865 البحر : - 1(@)(@@) % كم يعز المفضل المبخوت % ويبز المحبب المنعوت 
ms234	 % 2(@)(@@) % أعتب الله بعد بلوى تشكى % % جهدها الناس والصخور الصموت % 3(@)(@@) % أفيومين خلت عتباه تبقى % % ثم يضحي وحبله مبتوت % 4(@)(@@) % حاشا لله أن يقصر بالعت % بى فيلفى زمانها وهو قوت % 5(@)(@@) % أنشر الله دولة ابن سليما % % ن فأيقن بأنها لا تموت % 6(@)(@@) % ليس بعد النشور موت فكبتا % للأعادي فكلهم مكبوت % 7(@)(@@) % فأل يمن أتاحه الله عمدا % للسان بيانه منعوت % 8(@)(@@) % شاهد أن نعمة الله فيكم % % آل وهب ما حالف اليم حوت % 9(@)(@@) % كم عدو لهم غدا وهو مغمو % % ر بنعماء منهم لا مقوت % 10(@)(@@) % لو صحا ود أن عمركم المم % % دود فيه وعمره المسحوت % PageV01P866 11(@)(@@) % كادكم معشروأوهن بيت % % ما بنته من غزلها العنكبوت % 12(@)(@@) % ولكم أنعم عليهم ولكن % قل ما يقبل الغروس المروت % 13(@)(@@) % أثمروا شكلهم وهل يثمر الخر % روب إلا شبيهه الينبوت % 14(@)(@@) % شنئتهم حثالة من أناس % % أيقنوا أن مخهم منكوت % 15(@)(@@) % فهجوكم بأنكم منذ قمتم % % أثل الملك واقتنى السبروت % 16(@)(@@) % صدق القوم أنتم قطب الدو % % لة ما عاقبت سبوتا سبوت % 17(@)(@@) % عيبكم أنكم أناس كرام % كل شر بفضلكم مغتوت % 18(@)(@@) % لكم مطلب يفوت ذوي الفض % ل وفضل مطلوبه لا يفوت % 19(@)(@@) % لم تزالوا يقوم بالشكر عنكم % % ما فعلتم والجاحدون سكوت % 20(@)(@@) % عندكم نائل مخلى على العس % % ر وبأس عمن هفا مكفوت % PageV01P867 21(@)(@@) % حين لا جودكم يجور عن القص % د ولا وجه عزمكم ملفوت % 22(@)(@@) % فلتدم نعمة الإله عليكم % % ما أقامت ودامت الملكوت % 23(@)(@@) % وفداكم من شان منته المن % ن وأزرت بعزه الجبروت % 24(@)(@@) % حسبنا حسبنا بكم ربنا الل % ه أبينا أن يعبد الطاغوت % 25(@)(@@) % غيركم يا مثابة الملك من ين % أى به يوم نوبة مشموت % 26(@)(@@) % وفداء لما بنته مساعي % كم من المجد ما بنته النحوت % 27(@)(@@) % ووقاء لما عليكم من الأح % % ساب والستر ما حوته التخوت % 28(@)(@@) % إنما يطلب الترفع بالبز % زة والثروة الرجال التحوت % 29(@)(@@) % هل يسر الكريم أن كساه % كمناه وعرضه مهروت % 30(@)(@@) % إن يحاربكم من الأرض خطب % فله في السماء قرن ثبوت % PageV01P868 31(@)(@@) % لو 
ms235	 رأى الدهر جدكم في تعالي % % ه لأضحى كأنه مبهوت % 32(@)(@@) % آل وهب ما روعكم أن نهيتم % % كم نهيتم والنائرات خفوت % 33(@)(@@) % كم رأينا إنهابكم ما ملكتم % % في العطايا إلا بقايا تقوت % 34(@)(@@) % جود أيديكم أحد من النه % ب وأمضى إن فكر المبهوت % 35(@)(@@) % فاصبروا إن جدكم طالب الثأ % % ر وهل جدكم بثأر يفوت % 36(@)(@@) % لن يضر الأصول وهي رواس % % ورق من فروعها محتوت % 37(@)(@@) % حسن رأي الأمير كنز لكم با % % ق وعرنين من بغى مسلوت % 38(@)(@@) % عزكم في نصابه آل وهب % والروابي محلكم لا الخبوت % 39(@)(@@) % لم يجع ضيفكم ولا الجار مزؤو % % د له في جواركم مبهوت % 40(@)(@@) % ولقد أشعر الجناة عليكم % % حذر الطير والعقاب تخوت % PageV01P869 41(@)(@@) % وكفاكم بذاك زادكم الل % ه علوا وضدكم مذعوت % 42(@)(@@) % آل وهب لقد علمت يقينا % أن شعري بمجدكم منخوت % 43(@)(@@) % إن أكن قد أجدت تحت قريض % فيكم جاد ذلك المنحوت % 44(@)(@@) % لي نظم الثناء فيكم ولكن % % لكم الدر منه والياقوت % 45(@)(@@) % من معانيكم نظمت مديحي % % ومعاني النعوت ثم النعوت % 46(@)(@@) % هل ملاك النعوت إلا المعاني % % أو قوام الأبيات إلا البيوت % 47(@)(@@) % ما إخال المديح يوجب حقا % لي عليكم كما يرى المسبوت % 48(@)(@@) % ليس للمادحين حق عليكم % % بل على الله إذ ثناكم قنوت % 49(@)(@@) % ثم إني أقول قولة صاد % غاب عنه المروق البيوت % 50(@)(@@) % لهف نفسي ألا يعيرني النج % دة من قبل موته طالوت % PageV01P870 51(@)(@@) % فيرى الله كل باغ عليكم % % وهو مني بحتفه مبغوت % 52(@)(@@) % لو أطقت القتال عنكم لقاتل % % ت ولو أن قرني التابوت % 53(@)(@@) % دونكم مستقيمة السمت فيكم % % حين تعوج بالكلام السموت % 54(@)(@@) % شكر عرف يجري بكم غير موقو % ت فداكم من عرفه موقوت % 55(@)(@@) % من أكف بيض غدت وهي مشفو % % ع لدينا بجودها ممتوت % 56(@)(@@) % هاكموها تروق مستجمع ال % قوم بسحر لم يؤته هاروت % 57(@)(@@) % صاغها صائغ من الجن لا الإن % س يروغ بكر الكلام نكوت % 58(@)(@@) % حول قلب لو انغل يوما % في خروت لأزلقته الخروت % 59(@)(@@) % لم يضره أن لم يكن 
ms236	 عربيا % داره قرقرى أو المروت % 60(@)(@@) % طاب منها نسيمها آل وهب % % فهو مسك في عنبر مفتوت % PageV01P871 61(@)(@@) % وذكا نشرها فقال أناس % صبحتنا بخمرها بيروت % PageV01P872 البحر : - 1(@)(@@) % وجدت أبا عبد الإله خليفة % لصاحبه إسحاق بعد وفاته % 2(@)(@@) % كفاني وأغناني فلست بفاقد % لعمرك من إسحاق غير حياته % 3(@)(@@) % فيا لك من ذخر امرىء لزمانه % % معف على ما كان من نكباته % 4(@)(@@) % حباني به إسحاق خير بقية % يخلفها المفقود من بركاته % 5(@)(@@) % وما كان إلا الغيث أحيا بقطره % وولى فأحيا بعده بنباته % 6(@)(@@) % فلا يبعد الماضي وعمر بعده % % خليفته من بعده لعفاته % 7(@)(@@) % فتى كل علم فهو في سكناته % وكل ذكاء فهو في حركاته % 8(@)(@@) % يعبس والإنصاف تحت عبوسه % % ويضحك والإيناس في ضحكاته % 9(@)(@@) % نهوض بأعباء الكتابة مرفق % رعيته مستظهر لرعاته % 10(@)(@@) % ترى كل نفس ريها وشفاءها % % إذا رويت أقلامه من دواته % PageV01P873 11(@)(@@) % تنال بأنبوب البراعة كفه % ذرا ما تعاطى فارس بقناته % 12(@)(@@) % ومن كان فردا في عظيم غنائه % عن الملك لم يصغر صغير أداته % 13(@)(@@) % جبى الفيء للسلطان والفيء فاغتدى % % له الرتبة العلياء فوق جباته % 14(@)(@@) % رآه أبو العباس أقوم قائم % بأعماله عند امتحان كفاته % 15(@)(@@) % وألفى لديه عفة وأمانة % وإحداهما يكفي امرأ من ثقاته % 16(@)(@@) % أراني إذا حاولت وصف جلاله % أو الشكر عما كان من فعلاته % 17(@)(@@) % تشاغلت عن شكري له بصفاته % وأذهلني شكري له عن صفاته % 18(@)(@@) % فقصرت في الأمرين والقلب مضمر % مودته في مستقر ثباته % 19(@)(@@) % ولو طال مدحي فيه وانكد لم تجز % % إطالتي المكتوب من حسناته % 20(@)(@@) % ولولا اتقائي للتعدي زعمته % أخا الدهر لا يغضي إلى أخرياته % PageV01P874 21(@)(@@) % وما زال يعلو قدره قدر مدحه % وأين منال الشعر من درجاته % PageV01P875 البحر : - 1(@)(@@) % يا حامد الله إذ لم يكسه نعما % إلا لأوحد وقاع على النكت % 2(@)(@@) % يهنئك أنك لم تنعم عليك يد % دون وأنك لم تسلم إلى العنت % 3(@)(@@) % وأن شكرك مرصود بعارفة % أخرى ستأتيك لم تبخس ولم تلت % 4(@)(@@) % وكيف يبخس من أضحى وليس له % إلا إلى وجه بر 
ms237	 وجه ملتفت % 5(@)(@@) % أعني العلاء الذي لم يجر في أمد % إلا وفات إلى القصوى ولم يفت % 6(@)(@@) % فتى كليل عن الفحشاء منصلت % على ابتناء المعالي كل منصلت % 7(@)(@@) % كم مفلت بالعلاء الخير من عطب % من بعد ما قال إني غير منفلت % 8(@)(@@) % وكلح الدهر من نابيه عن عضل % فيه المنايا ومن شدقيه عن هرت % 9(@)(@@) % فالله يجزيه في دنيا وآخرة % ذكرا إذا ما أميت الذكر لم يمت % 10(@)(@@) % يا من يشك إذا عدت مناقبه % يكفيك ما قدمت كفاه من ثبت % PageV01P876 البحر : - 1(@)(@@) % ما لمن حسنه الل % ه وأعلى درجاته % 2(@)(@@) % أن يرى ملهاه إلا % % آخذا بعض صفاته % 3(@)(@@) % أيهذا السيد المص % غي إلى نصح ثقاته % 4(@)(@@) % لا تجهم بشراء ال % % خير واصدف عن بغاته % 5(@)(@@) % واستمع في اللهو مني % % إنني رأس دعاته % 6(@)(@@) % لا تفرط في نعيم % بعد تكميل أداته % 7(@)(@@) % لا يفوتنك في ده % % رك كبرى مسمعاته % 8(@)(@@) % إنه لا يصلح الإح % % سان إلا لوعاته % 9(@)(@@) % لا تضع إحسان في الإح % % سان يا خير رعاته % 10(@)(@@) % أنت في بستان عيش % فتخير ثمراته % PageV01P877 11(@)(@@) % قد جلاك الدهر للأع % ين يا خير ولاته % 12(@)(@@) % في ربيع من شباب % % وربيع من نباته % 13(@)(@@) % فتنزه في رياض ال % لهو واشمم زهراته % 14(@)(@@) % وائتنف مؤتنف العي % % ش وباكر غدواته % 15(@)(@@) % إن تلك النفس كفء % % لصفايا متعاته % 16(@)(@@) % أمتع الله بك الده % % ر إلى حين وفاته % 17(@)(@@) % ووقى نفسك من شر % ر بنيه وبناته % 18(@)(@@) % في هنيء ومريء % وسني من هباته % 19(@)(@@) % وكسا الدنيا بك الزي % ن إلى أخرى إناته % PageV01P878 البحر : - 1(@)(@@) % أزر صلة قدمتها أخواتها % % وإلا فأطلقها تزر أخواتها % % 2(@)(@@) % ولا تحسبني راضيا منك بالتي % % تسخط قبلي معشر أمهاتها % % 3(@)(@@) % ولم أحتقر ما كان منك وإنه % لكثر إذا عدت رجال صلاتها % % 4(@)(@@) % ولكنه في جنب جودك تافه % وفي عين حر أبعدت غلواتها % % 5(@)(@@) % أتعطي سواي الأمهات من اللهى % % وتختصني منها بصغرى بناتها % % 6(@)(@@) % أبت لي قبول الخسف نفس أبية % تبيع بعز الموت ذل حياتها 
ms238	 % % PageV01P879 البحر : - 1(@)(@@) % كل نفس لموقت % ليس حي بمفلت % 2(@)(@@) % مات إسحاق فاستمع % % نعيه ثم اخبت % 3(@)(@@) % مات إسحاق فاستمع % % لثناه وأنصت % 4(@)(@@) % مات من راح واغتدى % % ذكره غير ميت % 5(@)(@@) % مات من كان للحقا % % ئق عين المثبت % 6(@)(@@) % مات من كان للأبا % % طيل عين المشتت % 7(@)(@@) % لا بوهم مرجم % بل بفهم منكت % 8(@)(@@) % مات من كان شاملا % بالحيا كل مسنت % % 9(@)(@@) % مات من لم نجد له % % واديا غير منبت % 10(@)(@@) % مات من لم نجد له % % جدلا غير مسكت % PageV01P880 11(@)(@@) % يا أخي يا أبا الحسي % ن صريخ المصوت % 12(@)(@@) % حل بي فيك مشمت % جل عن كل مشمت % 13(@)(@@) % كبدي مذ دهيت في % % ك بكفي مفتت % 14(@)(@@) % وكأني لوحشتي % % لك في وحش إصمت % 15(@)(@@) % نالني فيك من زما % % ني إعنات معنت % 16(@)(@@) % أنت من لم يكن يني % % ل نوال المقوت % 17(@)(@@) % بل نوالا مصبحا % ضاحكا عن منبت % 18(@)(@@) % يا خصيما عن الهدى % % مسكتا كل مسكت % 19(@)(@@) % قلت للدهر إذ أصا % % بك أخطأت فاكفت % 20(@)(@@) % وتكذبت في اعتذا % % رك فاصدق أو اصمت % PageV01P881 21(@)(@@) % قد لعمري كبت نف % سك يا دهر فاكبت % 22(@)(@@) % خبت يا دهر بعده % فاحي إن شئت أو مت % 23(@)(@@) % واجتثثت الذكاء وال % خير من خير منبت % 24(@)(@@) % كان محياه فيك أف % % ضل حين وموقت % PageV01P882 البحر : - 1(@)(@@) % عزاؤك أن الدهر ذو فجعات % وكل جميع صائر لشتات % 2(@)(@@) % لك الخير كم أبصرته وسمعته % قرائن حي غير مختلجات % 3(@)(@@) % هل الناس إلا معشر من سلالة % تعود رفاتا ثم أي رفات % 4(@)(@@) % مياه مهينات يؤول مآلها % % إلى رمم من أعظم نخرات % 5(@)(@@) % أرى الدهر ظهرا لا يزال براكب % وإن زل لم يؤمن من العثرات % 6(@)(@@) % ومن عجب أن كلما جد ركضنا % % عليه تباعدنا من الطلبات % 7(@)(@@) % وأعجب منه حرصنا كلما خلت % سنونا كأنا من بني العشرات % 8(@)(@@) % نخلف مأمولاتنا وكأننا % % نسير إليها لا إلى الغمرات % 9(@)(@@) % غررنا وأنذرنا بدهر أملنا % % غرورا وإنذارا بهاك وهات % 10(@)(@@) % إذا مج مجات من الأري أعقبت % % بأقصى سهام في 
ms239	 أحد حمات % PageV01P883 11(@)(@@) % أميري وأنت المرء ينجم رأيه % فيسري به السارون في الظلمات % 12(@)(@@) % وتعصف ريح الخطب عند هبوبها % % وأنت كركن الطود ذي الهضبات % 13(@)(@@) % عليك بتقوى الله والصبر إنه % معاذ وإن الدهر ذو سطوات % 14(@)(@@) % وليس حكيم القوم بالرجل الذي % % تكون الرزايا عنده نقمات % 15(@)(@@) % فجعت فلا عادت إليك فجيعة % كما يفجع الأملاك بالملكات % 16(@)(@@) % أصبت وكل قد أصيب بنكبة % % يهاض بها الماضي من النكبات % 17(@)(@@) % فلا تجزعن منها وإن كان مثلها % % زعيما بنفر الجأش ذي السكنات % 18(@)(@@) % وما نفر نفس من حلول مصيبة % وقد أيقنت قدما بما هو آت % 19(@)(@@) % أتوقن بالمقدور قبل وقوعه % % وتنفر نفر الغر ذي الغفلات % 20(@)(@@) % لقد أونست حتى لقد حان أنسها % % بما شاهدت للدهر من وقعات % PageV01P884 21(@)(@@) % فما بالها نفر الأغراء نفرها % % وقد أنذرت من قبل بالمثلات % 22(@)(@@) % من احتسب الأقدار أيقن فاستوت % لديه منيخات ومنتظرات % 23(@)(@@) % هل المرء في الدنيا الدنية ناظر % سوى فقد حب أو لقاء ممات % 24(@)(@@) % ألم تر غارات الخطوب ملحة % فبين مغاداة وبين ثبات % 25(@)(@@) % تروح وتغدو غير ذات ونية % على حيوان مرة وموات % 26(@)(@@) % وما حركات الدهر في كل طرفة % بلاهية عن هذه الحركات % 27(@)(@@) % سيسقي بني الدنيا كؤوس حتوفهم % % إلى أن يناموا لا منام سبات % 28(@)(@@) % وفاء من الأيام لا شك غدرها % % وهل هن منجزات عدات % 29(@)(@@) % يعدن بغدر ليس بالمخلفاته % % فقل في وفاء من أخي غدرات % 30(@)(@@) % تعز بموت الصيد من آل مصعب % % تجدهم أسى إن شئت أو قدوات % PageV01P885 31(@)(@@) % تعزوا وقد نابتهم كل نوبة % % وماتوا فعروا كل ذي حسرات % 32(@)(@@) % ومن سنن الله التي سن في الورى % % إذا جالت الأراء معتبرات % 33(@)(@@) % زوال أصول الناس قبل فروعهم % % وتلك وهذي غير ذات ثبات % 34(@)(@@) % ليبقى جديد بعد بال وكلهم % % سيبلى على الصيفات والشتوات % 35(@)(@@) % وإن زال فرع قبل أصل فإنما % % تعد من الأحداث والفلتات % 36(@)(@@) % وتلك قضايا الله جل ثناؤه % % وليست قضايا الله بالهفوات % 37(@)(@@) % ليعلم ألا موت ميت لكبرة % ولا عيش حي لا قتبال 
ms240	 نبات % 38(@)(@@) % وتقديم من قدمت شيء بحقه % فدع عنك سح الدمع والزفرات % 39(@)(@@) % ولا تسخط الحق الذي وافق الهدى % % هوى من له أمسيت في كربات % 40(@)(@@) % رزئت التي ودت بقاءك بعدها % % وأحيت به في ليلها الدعوات % PageV01P886 41(@)(@@) % وكانت تمنى أن تردى سريرها % % وبعض أماني النفوس مواتي % % 42(@)(@@) % فلا تكرهن أن أوتيت ما توده % % فكرهك ما ودت من النكرات % 43(@)(@@) % ألم تر رزء الدهر من قبل كونه % كفاحا إذا فكرت في الخلوات % 44(@)(@@) % بلى كنت تلقاه وإن كان غائبا % بفكرك إن الفكر ذو غزوات % 45(@)(@@) % فما لك كالمرمي من مأمن له % بنبل أبته غير مرتقبات % 46(@)(@@) % زع القلب إن الفاجعات مصائب % أصابت وكانت قبل محتسبات % 47(@)(@@) % فإن قلت مكروه ألمت فجاءة % فما فوجئت نفس مع الخطرات % 48(@)(@@) % ولا غوفصت نفس ببلوى وقد رأت % % عظات من الأيام بعد عظات % 49(@)(@@) % إذا بغتت أشياء قد كان مثلها % % قديما فلا تعتدها بغتات % 50(@)(@@) % جزعت وأنت المرء يوصف حزمه % ولا بد للأيقاظ من رقدات % PageV01P887 51(@)(@@) % فأعقب من النوم التنبه راشدا % فلا بد للنوام من يقظات % 52(@)(@@) % ومن راغم الشيطان مثلك لم يجب % رقاه ولم يتبع له خطوات % 53(@)(@@) % ومما ينسيك الأسى حسناتها % % وإن كنت منها يا أخا الحسنات % 54(@)(@@) % فإن ثواب الله في رزء مثلها % % لقاؤكها في أرفع الدرجات % 55(@)(@@) % وذاك إذا قضيت كل لبانة % من المجد واستمتعت بالمتعات % 56(@)(@@) % مضت بعدما مدت على الأرض برهة % لتمجد من فيها من البركات % 57(@)(@@) % فإن تك طوبى راجعت أخواتها % % فقد زودت من طيب الثمرات % 58(@)(@@) % لعمرك ما زفت إلى قعر حفرة % ولكنها زفت إلى الغرفات % 59(@)(@@) % ولولاك قلنا من يقوم مقامها % % ومن يؤثر التقوى على الشبهات % 60(@)(@@) % سقاها مع الدمع الذي بكيت به % % حيا الغيث في الروحات والغدوات % PageV01P888 61(@)(@@) % وصلى عليها كلما ذر شارق % وحان غروب صاحب الصلوات % PageV01P889 البحر : - 1(@)(@@) % قل للأمير أدام الله دولته % وزاده في علو القدر والصيت % 2(@)(@@) % ماذا يقول امرؤ قال الإله له % من اجتبيت لتجديد المواقيت % 3(@)(@@) % من ذا نقيم مواقيت الصلاة 