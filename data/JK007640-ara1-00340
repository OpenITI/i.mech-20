ms321	 % وممن أنت تهواه نزوح % % 9(@)(@@) % كما محيت سطور من كتاب % وما يدري لها عندي شروح % % 10(@)(@@) % وقد راحت ركائب آل مي % فما راحت وللمشتاق روح % % PageV01P1008 11(@)(@@) % فقلت نعم ولي جفن قريح % % بعبرته ولي قلب جريح % % 12(@)(@@) % أروح على منازلها وأغدو % % فأغدو يا هذيم كما أروح % % 13(@)(@@) % لئن جاد السحاب وجاد طرفي % % أريت الدهر أيهما الشحيح % % 14(@)(@@) % فدعني يا هذيم بها لعلي % % أموت من الغرام وأستريح % % PageV01P1009 البحر : طويل 1(@)(@@) % نسيم الصبا أهدى إلى القلب ما أهدى % % وقد حملت أرواحها الشيح والرندا % % 2(@)(@@) % ولي كبد حرى لعلي أرى بها % % بريا نسيم مر بي سحرا بردا % % 3(@)(@@) % فأصبحت أذري الدمع فذا وتوأما % تخذ على خدي حينئذ خدا % % 4(@)(@@) % كأني عتصرت المعصرات بأعين % % نثرن غداة البين من لؤلؤ عقدا % % 5(@)(@@) % فما بل ذاك الدمع مني حشاشة % % أبى الله إلا أن تضرم لي وقدا % % 6(@)(@@) % ولام أصيحابي فؤادا متيما % فما نفع اللوم الفؤاد ولا أجدى % % 7(@)(@@) % ذكرتهم والدمع يجري فلم أكن % ملكت لذاك الدمع يوم جرى ردا % % 8(@)(@@) % وبت أداري مهجة لم أجد لها % % خلاصا من الأشجان يوما ولا بدا % % 9(@)(@@) % وقلت لسعد دع ملامك في الهوى % % فمن زادني لوما فقد زادني وجدا % % 10(@)(@@) % يهيج وجدي وهو غير مساعدي % % وما أنا لاق منه إن لامني سعدا % % PageV01P1010 11(@)(@@) % يقول اصطبر عمن تحب وإنني % % يريني الهوى من دون ما قاله سدا % % 12(@)(@@) % و لاتشم البرق ايماني فإنه % % متى لاح أورى في حشاشتك الزندا % % 13(@)(@@) % وإياك إياك الصريم وأهله % فإن الظباء العفر تقتنص الأسدا % % 14(@)(@@) % وهل نافع ما قال من بعد ما رمى % % لعينيه ريم الجزع سهم الردى عمدا % % 15(@)(@@) % بنفسي الغزال القانصي بلواحظ % من السحر مرضى تمنع الأسد الوردا % % 16(@)(@@) % إذا ما رمين القلب سهما أصبنه % % كأن قصدت في قتل عاشقها قصدا % % 17(@)(@@) % به أربي يا هل ترى هذه النوى % % تبدلنا بالقرب من بعدها بعدا % % 18(@)(@@) % أرى النفس لا تهوى سوى من توده % % ولم تتكلف مهجة الوامق الودا % % PageV01P1011 البحر : بسيط تام 1(@)(@@) % عشت الزمان بخفض العيش منتصبا 
ms322	 % % لا علة تشتكي فيه ولا وصبا % % 2(@)(@@) % والحمد لله شكرانا لنعمته % % أقضي به من حقوق الشكر ما وجبا % % 3(@)(@@) % فاليوم ألبسك الرحمن عافية % تبقى ورد عليك الله ما سلبا % % 4(@)(@@) % من بعد ما مرض برح أصبت به % % وكنت لاقيت مما تشتكي نصبا % % 5(@)(@@) % وكم شربت دواء كنت تكرهه % فكان عافية فيه لمن شربا % % 6(@)(@@) % وقد ظهرت ظهور الصبح منبلجا % فطالما كنت قبل اليوم محتجبا % % 7(@)(@@) % تفديك روحي وأمي في الورى وأبي % % فإنما أنت خير المنجيين أبا % % 8(@)(@@) % لي فيك مولاي عن بدر الدجى عوض % إن لاح بدر الدجى عني وإن غربا % % 9(@)(@@) % يا بدر تم بأفق المجد مطلعه % % من قال إنك بدر التم ما كذبا % % 10(@)(@@) % إن رمت منك مراما نلت غايته % % وإن طلبت منى أدركتها طلبا % % PageV01P1012 11(@)(@@) % وإن هززتك للجدوى هززت فتى % أجني به الفضة البيضاء والذهبا % % 12(@)(@@) % يا أكرم الناس في فضل وفي كرم % ومن رآك رآى من فضلك العجبا % % 13(@)(@@) % لم يذخر في الندى مالا ولا نشبا % إن المكارم لا تبقي له نشبا % % 14(@)(@@) % هب لي رضاك وأتحفني به كرما % فأنت أكرم من أعطى ومن وهبا % % 15(@)(@@) % ما زلت إن لم أجد لي للغنى سببا % وجدت لي أنت في نيل الغنى سببا % % 16(@)(@@) % يرق فيك ثنائي بالقريض كما % % تنفست في رياض الحزن ريح صبا % % 17(@)(@@) % ولاشعر يرتاح أن يثنى عليك به % % وإن دعاه سواكم للثناء أبى % % 18(@)(@@) % فخرا أبا مصطفى في العيش صفوته % % فقد تكدر عيشي فيك واضطربا % % 19(@)(@@) % لما انقلبت كما نبغي بعافية % % بنعمة الله قد أصبحت منقلبا % % 20(@)(@@) % وقلت يوم سروري يا مؤرخه % % يوم به البوس عن سلمان قد ذهبا % % PageV01P1013 البحر : كامل تام 1(@)(@@) % فتن الأنام بطرفه وبجيده % % وأبى الهوى إلا تلاف عميده % % 2(@)(@@) % متمنع وعد المشوق بزورة % يا ليته ممن يفي بوعوده % % 3(@)(@@) % أنى أفوز بطارق من طيفه % % ما دام هذا الطيف في تسهيده % % 4(@)(@@) % رشأ يصول بحد صارم ناظر % % وقفت أسود الغاب عند حدوده % % 5(@)(@@) % فليحذر الصمصام من لحظاته % % والصعدة السمراء من أملوده 
ms323	 % % 6(@)(@@) % تالله ما يحي المتيم وصله % % إلا مميت سلوه بصدوده % % 7(@)(@@) % شهدت محاسنه بجهل عذوله % % وأقام حجة حسنة بشهوده % % 8(@)(@@) % ولكم عصيت مفندا في حبه % % ورأيت عكس الرأي في تفنيده % % 9(@)(@@) % وأقول إذ نبت العذار بخده % % ورد الربيع فمرحبا بوروده % % 10(@)(@@) % ولقد ظفرت به برغم عواذلي % % وضممته ولثمت ورد خدوده % % PageV01P1014 11(@)(@@) % وشكرته حر الفؤاد من الجوى % % شوقا إليه فجاد في تبريده % % 12(@)(@@) % في مجلس عبقت أرائج نده % % وتنفست فيه مباخر عوده % % 13(@)(@@) % والليل يرفل باسوداد ردائه % % والروض يزهر باخضرار بروده % % 14(@)(@@) % ويدير شمس الراح في غسق الدجى % % نظمت قوافي الشعر في تمجيده % % 15(@)(@@) % والنجم يرقبه بعين رقيبه % % والبدر يلحظه بلحظ حسوده % % 16(@)(@@) % والزق تصرعه السقاة وربما % % قطعت يد الندمان حبل وريده % % 17(@)(@@) % حتى رأيت يسقط فوقنا % % في نثر لؤلؤه ونظم عقوده % % 18(@)(@@) % وتفتح النوار في أكمامه % % فكأنما النوار أوجه غيده % % 19(@)(@@) % وإذا القيان تجاوبت بلحونها % % طرب الحمام فلج في تغريده % % 20(@)(@@) % سفرت محاسن زهر روض زاهر % % وتمايلت إذ ذاك هيف قدوده % % PageV01P1015 21(@)(@@) % والبان يركع فالنسيم إذا سرى % % وصل النسيم ركوعه بسجوده % % 22(@)(@@) % إن تنهبوا اللذات قبل فواتها % % وهب الزمان شقيه لسعيده % % 23(@)(@@) % ودعاكم داعي الصبوح وإنه % % ليقوم سيف الصبح في تأييده % % 24(@)(@@) % أو ما ترون الأقحوان وضحكه % % من حض داعيكم ومن تأكيده % % 25(@)(@@) % وشقائق النعمان كيف تضرجت % بدم فظن الكرم من عنقوده % % 26(@)(@@) % % فخذوا بكأس الراح في تجديده % % 27(@)(@@) % يوم به سلمان وافى مقبلا % قد كان للمشتاق أكبر عيده % % 28(@)(@@) % قرت به عين المفارق طلعة % قمرية بحضوره وشهوده % % 29(@)(@@) % في فقده السرور وإنما % % وجد السرور جميعه بوجوده % % 30(@)(@@) % وتولد الفرح المقيم لأهله % % وأجاد طيب العيش في توليده % % PageV01P1016 31(@)(@@) % فكأنه فلق الصباح إذا بدا % % في رفع رايته وخفق بنوده % % 32(@)(@@) % فالسعد والإقبال من خدامه % % لا بل هما في الرق بعض عبيده % % 33(@)(@@) % ظفرت يدي منه بأكرم ماجد % % 34(@)(@@) % ما زال مجتهدا بكل صنيعة % يدعو الكريم بها إلى تقليده % % 35(@)(@@) % المال ما ملكته راحة كفه % % فدعته شيمته إلى تبديده % % 36(@)(@@) % تغني مواهبه 
ms324	 الحطام تكرما % نشرا لذكر ثنائه وحميده % % 37(@)(@@) % إني لأذكره وأنشد مدحه % % وأميل الغصن عند نشيده % % 38(@)(@@) % ومشيد أبنية المفاخر والعلى % % تسمو بيوت المجد في تشيده % % 39(@)(@@) % إن عدت الناس الفخار فإنه % % إنسان مقلته وبيت قصيده % % 40(@)(@@) % الله أكرم آل بيت محمد % حيث اصطفاهم من كرام عبيده % % PageV01P1017 41(@)(@@) % حازوا من الشرف الرفيع أبيه % فهم ولاة طريفه وتليده % % 42(@)(@@) % وإذا تورث والد منهم على % لا يورث العلياء غير وليده % % 43(@)(@@) % ما للبنين الغر من آبائه % % أم أين للآباء مثل جدوده % % 44(@)(@@) % نفسي الفداء له وقل له الفدى % % من كان للإحسان غارس عوده % % 45(@)(@@) % الله يعلم والبرية كلها % % أني أفوز بعزه وبجوده % % 46(@)(@@) % أقبلت إقبال السحاب تباشرت % % زهر الربا ببروقه ورعوده % % 47(@)(@@) % قد غبت عن بغداد غيبة حاضر % في فكر صاحبه وقلب ودوده % % 48(@)(@@) % وإذا طلعت على الأحبة بعدها % % فموفق كل إلى مقصوده % % 49(@)(@@) % يا من يسر الأنجبين قدومه % % كسروره بضيوفه ووفوده % % 50(@)(@@) % فلقد ركبت الوعر غير مقصر % وقطعت يومئذ فدافد بيده % % PageV01P1018 51(@)(@@) % ولقد تعبت فخذ لنفسك راحة % و طلق عنان الأنس من تقييده % % 52(@)(@@) % واسرح من اللذات في متنزه % خلط الغرام ظباءه بأسوده % % PageV01P1019 البحر : رمل تام 1(@)(@@) % برح الشوق أصيحابي بي % % وبما برح بي قد فتكا % % 2(@)(@@) % هي نفس لا بذنب قتلت % ودم في غير جرم سفكا % % 3(@)(@@) % آنسات من ظباء المنحنى % % نصبت لي من هواها شركا % % 4(@)(@@) % يا ظباء المنحنى أنقذنه % % من هواكن وإلا هلكا % % 5(@)(@@) % وصبابات جوى ما وجدت % بسوى قلبي لها معتركا % % 6(@)(@@) % ولأنتم ساكني وادي الغضا % % فيكم الشكوى ومنكم ما شكا % % 7(@)(@@) % كنتم أقمارها طالعة % في مغانيها وكانت فلكا % % 8(@)(@@) % فأثرتم بعدها وخادة % لطمت وجه الفيافي رتكا % % 9(@)(@@) % ليت شعري يوم ولى ركبكم % % للنوى أي طريق سلكا % % 10(@)(@@) % وأحاديث المنى ما صدقت % بتدانيكم وأضحت أفكا % % PageV01P1020 11(@)(@@) % فسقاكم وسقى عهدكم % % عارض إن ضحك البرق بكى % % PageV01P1021 البحر : خفيف تام 1(@)(@@) % شفها السير والأسى والغرام % ويراها الإنجاد والإتهام % % 2(@)(@@) % كم فرت مهمها وجابت قفارا % واشتكتها الأوهاد والأعلام % % 3(@)(@@) % فترفق بها فإن 
ms325	 حشاها % % لو تأملتها جوى وغرام % % 4(@)(@@) % جعلت وردها من الماء عبأ % أفيطفى من الدموع ضرام % % 5(@)(@@) % كم ألمت بنا على آل مي % ونبا من دروسها الآلام % % 6(@)(@@) % يوم لاح الحمى فقلت لصحبي % % هذه دارهم وتلك الخيام % % 7(@)(@@) % فنثرنا من الهوى عبرات % فحسبنا أن الدموع ركام % % 8(@)(@@) % كلمتنا الديار وهي سكوت % إن بعضا من السكوت كلام % % 9(@)(@@) % ذكرتنا بها وما دام عيشا % أي عيش دامت له الأيام % % 10(@)(@@) % ما علمنا حتى نقضت وتولت % أن أيامنا بها أحلام % % PageV01P1022 11(@)(@@) % إذ جلونا من الحميا عروسا % بنت كرم لها الزجاج لثام % % 12(@)(@@) % يا لها ساعة بمجلس أنس % % غاب جام بها وأشرف جام % % 13(@)(@@) % ضيعتها أيدي الحوادث منا % % مثل ما ضيع الجميل اللئام % % 14(@)(@@) % نطلب الدهر أن يعود وهيها % % ت يروى من السراب الأوام % % 15(@)(@@) % وبنفسي ذاك الغرير المفدى % % ففؤادي بحيه مستهام % % 16(@)(@@) % واشتياقي إلى ارتشاف رضاب % % حسدت ذلك الرضاب المدام % % 17(@)(@@) % يا غزالا فدى لعينك قلبي % % نظرات أرسلتها ، أم سهام ؟ % 18(@)(@@) % همت وجدا ودبت فيك هياما % % وقليل على هواك الهيام % % 19(@)(@@) % كيف تخفى سريرة الحب عنكم % % وأخو الوجد دمعه نمام % % 20(@)(@@) % ظعن الركب ضحوة وأراني % % لم يطب لي بعد الحبيب مقام % % PageV01P1023 21(@)(@@) % فاترك الهزل يوم جد بجد % إن هزل المقام بالشهم ذام % % 22(@)(@@) % واطلب العز بالقنا والمواضي % % إنما العز ذابل وحسام % % 23(@)(@@) % فمرام المنى ونيل المعالي % % بسوى البيض والقنا لا يرام % % 24(@)(@@) % وتمسك بسمهري وشيج % % فالعوالي إلى المعالي زمام % % 25(@)(@@) % و قتحمها إذا نبت بك يوما % فأرى المجد بابه الاقتحام % % 26(@)(@@) % و دفع الشر إن علمت بشر % ربما يدفع السقام السقام % 27(@)(@@) % فمتى تكبر العزائم بأسا % صغرت عندها الأمور العظام % % 28(@)(@@) % وتقلد بالرأي قبل المواضي % % ليس يجدي بغير رأي صدام % % 29(@)(@@) % رب رأي بالخطب يفعل مالا % % يفعل السمهري والصمصام % % 30(@)(@@) % و حذر الغدر من طباع لئيم % % عنده الغدر بالصديق ذمام % % PageV01P1024 31(@)(@@) % وادخر للوغى مقالة حرب % لا تقوي الأجسام إلا العظام % % 32(@)(@@) % لا تلومي فتى يخوض المنايا % % كل جبن من الحمام حمام % 33(@)(@@) % واصبري فالأسى 
ms326	 سحابة صيف % ولربي بأمره أحكام % % PageV01P1025 البحر : رمل تام 1(@)(@@) % ناشداها عن فؤادي وسلاها % % أهوى غير هواها قد سلاها ؟ % 2(@)(@@) % واذكراني يا خليلي لها % % فعساها ترحم الصب عساها % % 3(@)(@@) % و سألا عن مهجة دامية % رميت سهم غرام ، من رماها ؟ % 4(@)(@@) % لا أبيت الليل إلا قلقا % يمنع الوجد من العين كراها % % 5(@)(@@) % يا غراما بالدمى ما تنقضي % % حسرات بالحشا طال مداها % % 6(@)(@@) % وقلبي ظبية الخدر التي % % ليس يهوى صبها إلا هواها % % 7(@)(@@) % تركتني أتلظى وأرى % % ذكر نفس الصب من تهوى لظاها % % 8(@)(@@) % زعمت أني سال بعدها % % طلعة ما شاقني شيئا سواها % % 9(@)(@@) % لا ومن أسلو بها مغرى بها % % وأذاب القلب وجدا ما سلاها % % 10(@)(@@) % وسعى الواشي إليها بالذي % % ساءها حتى ستمرت بجفاها % % PageV01P1026 11(@)(@@) % هي صدت ريبة عن صبها % % فشكته يوم صدت وشكاها % % 12(@)(@@) % لو درت إذ طلبت تعذيبه % % ما يقاسي بهواها لكفاها % % 13(@)(@@) % ما عليها في الهوى لو أنها % % سمعت بالوصل يوما لفتاها % % 14(@)(@@) % فشقى داء الهوى من مهجة % % علم الله بما ضمت حشاها % % 15(@)(@@) % لست أنسى ليلة صحت بها % % أعين الأزهار واعتل صباها % % 16(@)(@@) % وعناقي دمية القصر وقد % % شغلت مقلة واشينا عماها % % 17(@)(@@) % بت أسقى ضرب الثغر ولا % % أشرب الخمرة إلا من لماها % % 18(@)(@@) % زهرة الدنيا التي لا تجتنى % % غير باعي في المعالي ما اجتناها % % 19(@)(@@) % سوف أحظى بالتي أهوى وإن % منعوها عن عيوني أن تراها % % 20(@)(@@) % أترى تحجب عن ذي همم % كسيوف الهند بتار شباها % % PageV01P1027 21(@)(@@) % لو رآى من دونها نار الوغى % % تتلظى بالمنايا لاصطلاها % % 22(@)(@@) % لا ترقيت العلى إن لم أكن % مبلغا نفسي بالسيف مناها % % 23(@)(@@) % فلئن خانت أخلائي فما % % خانني من هممي ماضي ظباها % % PageV01P1028 البحر : خفيف تام 1(@)(@@) % حائز الفضل والكمال جميعه % % أنت رأس العلى وصدر الشريعه % % 2(@)(@@) % أنا أهوى غرائب القول طبعا % فأعرني يوما كتاب الطبيعه % % PageV01P1029 البحر : متقارب تام 1(@)(@@) % متى يشتفي كبد مؤلم % ويقضي لباناته مغرم ؟ % 2(@)(@@) % ويحظى بمطلبه آمل % بأحشائه لوعة تضرم % % 3(@)(@@) % لقد قوض الركب يوم الخليط % % فأنجد في قلبي المتهم % 4(@)(@@) % وروعني ضيف 
ms327	 طيف سرى % % يراع به كبد مؤلم % % 5(@)(@@) % خليلي هل وقفة في الديار % % يسح بها المدمع المسجم ؟ % 6(@)(@@) % فإنا وقفنا عليها ضحى % وكل من الركب مستغرم % % 7(@)(@@) % وأفشى بسري دمع العيون % % وسر الصبابة لا يكتم % % 8(@)(@@) % فأترك خوف الوشاة البكا % % وقد يترك المرء ما يلزم % % 9(@)(@@) % إذا ما نسينا عهود الغوير % % تذكرنا عهدها الأرسم % 10(@)(@@) % فيا حبذا يومنا بالعقيق % % مضى و نقضى يومها الألوم % % PageV01P1030 11(@)(@@) % بحيث تلوح شموس الطلا % % ولون الدجى فاحم أسحم % % 12(@)(@@) % إلى أن تبدى كميت الصباح % % وأدبر من ليلنا الأدهم % 13(@)(@@) % تصرم عهد النقا بالنوى % % فما للتصبر لا يصرم % % 14(@)(@@) % أتنكر قتلي ، غزال الصريم % % ويشهد لي خدك العندم ؟ % 15(@)(@@) % ففيم أرقت دمي عامدا % وحللت في الحب ما يحرم ؟ % 16(@)(@@) % حكمت علي بأمر الغرام % % وإني لحكمك مستسلم % % 17(@)(@@) % وقلت لمن لامني في هواك % % جهلت ثكلتك ما أعلم % % 18(@)(@@) % وأرقني في الدجى بارق % كما استل من غمده مخذم % % 19(@)(@@) % وشوقني لظباء الحمى % % فأسقمني والهوى يسقم % % 20(@)(@@) % عجبت وكيف وهن الظباء % % يصاد بأجفانها الضيغم % PageV01P1031 21(@)(@@) % ويسلم من مرهفات السيوف % % ومن لحظهن فلا يسلم % % 22(@)(@@) % ومن مثلهن أخاف الصدام % % ويصدم مثلي ولا يصدم % % 23(@)(@@) % هويتكم يا أهيل الحطيم % % وهذا الهوى كله منكم % % 24(@)(@@) % قضيتم على صبكم بالعباد % % وإن قضاء النوى مبرم % % 25(@)(@@) % فلم يصف لي بعدكم مشرب % ولا لذ لي بعدكم مطعم % % 26(@)(@@) % وأصبر في معضلات الخطوب % % وصبر الفتى للفتى أسلم % % 27(@)(@@) % وعرضي نقي وأنفي حمي % وبأسي كعزمي لا يثلم % % 28(@)(@@) % ولولا مكارم مفتي العراق % % وما غيره المكرم المنعم % % 29(@)(@@) % لما عتذر الدهر من ذنبه % % ولا استغفر الزمن المجرم % % 30(@)(@@) % مناقب محمود محمودة % وفوق جباه العلى ترقم % % PageV01P1032 31(@)(@@) % رقيق الحواشي كريم الطباع % % فهذا هو الأكرم الأشيم % % 32(@)(@@) % ينبيء عن خلقه خلقه % % ويؤذن في سيبه المبسم % 33(@)(@@) % فمن أمل الفضل من كفه % % وجود أياديه لا يحرم % % 34(@)(@@) % لأيديه في كل عنق يد % ومنها أفضيت لنا أنعم % % 35(@)(@@) % ببأسك أقسم لا حانثا % وفي غير بأسك لا أقسم % % 36(@)(@@) % لأنت الفريد بهذا الزمان % % ومنهجك المنهج 
ms328	 الأقوم % % 37(@)(@@) % وأنت الفخار ومنك الفخار % بمثلك فليفتخر آدم % % 38(@)(@@) % بنيت بنفسك بيت العلى % % إلى أبد الدهر لا يهدم % 39(@)(@@) % فهمت الرموز من المشكلات % % وغيرك من ذا الذي يفهم % % 40(@)(@@) % كشفت غوامض إشكالها % % وفي كشفك اتضح المبهم % PageV01P1033 41(@)(@@) % وإن لك الحجج البالغات % يقر بها المؤمن المسلم % % 42(@)(@@) % جوابك يا سيدي مسكت % ونصحك يا سيدي مفحم % 43(@)(@@) % يمر بسخطك حلو المذاق % % ويحلو بنائلك العلقم % % 44(@)(@@) % إذا ما كتبت فإن اليراع % % بأنملك السيف واللهذم % % 45(@)(@@) % ونثرك يزري بعقد الجمان % % قدر المعاني بها تنظم % % 46(@)(@@) % قليل بحقك ما نلته % % وقدرك أكبر بل أعظم % % 47(@)(@@) % نشرت بحقك طي المديح % % وفي مدحك الدين والدرهم % % 48(@)(@@) % لأني بحضرتك المستجير % % وإني بحبلك مستعصم % % 49(@)(@@) % وفيك أسر الولي الحميم % وفيك أنوف العدى أرغم % % 50(@)(@@) % أهنيك بالعيد يا عيدنا % % فأنت الهناء لنا والأعظم % % PageV01P1034 51(@)(@@) % بفضلك رغما يقر الحسود % % وينطق في مدحك الأبكم % % 52(@)(@@) % أجزني رضاك فثم الغنى % % لأن رضاك هو المغنم % % PageV01P1035 البحر : طويل 1(@)(@@) % بحكمك زال الظلم و بتسم العدل % وفي سيفك الماضي وفي قولك الفعل % % 2(@)(@@) % وما زلت ترقى رتبة بعد رتبة % ومثلك من يسمو ومثلك من يعلو % % 3(@)(@@) % وقلدت أمرا أنت في الناس أهله % % ولا منصب في الحكم إلا له أهل % % 4(@)(@@) % وقدمت في أمر الوزير وإنما % % علينا له في مثل تقديمك الفضل % % 5(@)(@@) % وقمت بتدبير العراق مقامه % % فما ضعضع الأقطار نصب ولا عزل % % 6(@)(@@) % وكادت تمور الأرض جهلا فعندما % % استقر عليها أمرك ارتفع الجهل % % 7(@)(@@) % يزينك عقل راجح ورزانة % % ألا إنما الإنسان زينته العقل % % 8(@)(@@) % وفيك جتماع الفضل والحسن كله % وأحسن ما فيك الشجاعة والبذل % % 9(@)(@@) % أطاعتك هذي الناس خوفا ورغبة % % فللطائع الجدوى وللمفسد القتل % % 10(@)(@@) % وما زلت مذ وليت أمرا نظمته % % حسامك مستل وسيبك منهل % % PageV01P1036 11(@)(@@) % وما أنا بالداري إذا كنت في الوغى % % أعزمك أم ما ستل في كفك النصل % % 12(@)(@@) % بنفسك باشرت الأمور جميعها % % فلا وكل عند المرام ولا كل % 13(@)(@@) % إذا أطمعتك النفس بالشيء نلته % % وإن وعدتك النفس شيئا فلا مطل % % 14(@)(@@) % ولست 
ms329	 كمن يبغي الأماني بعدما % % تصرمت الآمال وانقطع الحبل % % 15(@)(@@) % أحالوا على الرمل الماني ضلة % % وأكذب شيء ما يقوله به الرمل % % 16(@)(@@) % ولكنما أنت الذي نال حزمه % % مناه ولم يبعد عليه بها نيل % % 17(@)(@@) % وفتحت أبواب المكارم بالندى % % وكان عليها قبل تفتيحها قفل % % 18(@)(@@) % ليهن العراقين الهناء فقد سرى % % إليها المحض والنائل الجزل % % 19(@)(@@) % عقدت أمورا قد تمادى نحلالها % % ومثلك من في أمره العقد والحل % 20(@)(@@) % وكم لك يوم ضرب والطعن موقف % % هو الهول بل من دون موقفه الهول % % PageV01P1037 البحر : متقارب تام 1(@)(@@) % أقول لها يوم جدت بنا % % وقد أوجب المجد ترحالها % % 2(@)(@@) % إلى حيث تهوى نفوس الكرام % % وتبلغ بالعز تسآلها % % 3(@)(@@) % لئن جزت بي أثلاث الغوير % % وجبت الديار وأطلالها % % 4(@)(@@) % سقيتك يا ناق من مائها % % وقلت شربي اليوم جريالها % % 5(@)(@@) % ونشقتك الريح من حاجر % % تجر على الرند أذالها % % 6(@)(@@) % رآها هذيم كأن الغرام % % يقطع بالوجد أوصالها % % 7(@)(@@) % متى ذكرت عهدها باللوى % % أهاج التذكر بلبالها % % 8(@)(@@) % تؤمل في ذي الغضا وقفة % ويحرمها البين آمالها % % 9(@)(@@) % فقال بها والهوى جنة % % وكم أتلف الشوق أمثالها % % 10(@)(@@) % فلو صبرت عن ربوع الحمى % % لكان التصبر أولى لها % % PageV01P1038 11(@)(@@) % وهل تقبل النفس مشغوفة % % بمن هي تهواه عذالها % % 12(@)(@@) % عرفت بآي الهوى ما بها % % وأنت تقول لنا ما لها % % 13(@)(@@) % وقالت ومن حالها يا هذيم % % لسان يترجم أقوالها % % 14(@)(@@) % نعمت زمانا بتلك الوجوه % % وقاسيت من بعد أهوالها % % 15(@)(@@) % حسبت بعنيك هذي الدموع % % تريدين يا ناق إرسالها % % 16(@)(@@) % هلمي بنا نستجد البكاء % فقد حمل العين أثقالها % % PageV01P1039 البحر : رمل تام 1(@)(@@) % من لصب مستطار القلب هائم % يشتكي المهجة من رمح وصارم % 2(@)(@@) % عاقد الحب على أن لا يرى % % في التصابي غير محلول العزائم % % 3(@)(@@) % إنما تفتك في أحشائه % % نظرات ليس ترقيها التمائم % % 4(@)(@@) % رحمة للصب ما يشكو إلى % % راحم يوما وهل للصب راحم % % 5(@)(@@) % يا خليلي نصفاني من جوى % أنا نظلوم به الشوق ظالم % % 6(@)(@@) % ما لهذا البرق يهفو وامضا % بات يبكيني نجيعا وهو باسم % % 7(@)(@@) % ويثير الوجد يوري 
ms330	 زنده % % فاحم الليل وفرع الليل فاحم % % 8(@)(@@) % أذكر العيش وأيام الحمى % % ناعمات العيش بالبيض النواعم % % 9(@)(@@) % يا سقى الله الحمى من موطن % % يزأر الليث به والظبي باغم % % 10(@)(@@) % كم وكم قد فتكت ف نتصرت % % أعين الغزلان بالأسد الضراغم % % PageV01P1040 11(@)(@@) % وكمي حازم أصبح في % % قبضة الحب وما ثمة حازم % % 12(@)(@@) % نام عني غافلا عن كمدي % % رب ساع ساهر الطرف لنائم % % 13(@)(@@) % ويمج الشهد من ريقته % % ولحظي منه تجريع العلاقم % % 14(@)(@@) % حاربتني الأعين النجل ومن % % مهجتي غذوا ومن لي أن تسالم % % 15(@)(@@) % ما أحل القتل إلا عامدا % مستبيح سيف عينيه المحارم % % 16(@)(@@) % معجب من حسنه مبتسم % يودع اللؤلؤ هاتيك المباسم % % 17(@)(@@) % قاتلي من غير ذنب في الهوى % % أنت في قتلي رعاك الله آثم % % 18(@)(@@) % سفكت أحداقك اسود دمي % % أين من أحداقك البيض الصوارم % % 19(@)(@@) % فعل ألحاظك في عشاقها % % يتعدى بشباها وهو لازم % % 20(@)(@@) % لي على قدك نوح في الدجى % % مثلما ناحت على الغصن الحمائم % % PageV01P1041 21(@)(@@) % ساغ ما جرعتني من غصة % غير أني عن جنى ريقك صائم % % 22(@)(@@) % فضح الحب الهوى في أهله % وبدا من كاتم ما هو كاتم % % 23(@)(@@) % لا أرى الله عذولي راحة % لامني فيك فما أصغي للائم % % 24(@)(@@) % وبلائي كله من لائم % % بات يلحو وحبيب ولا يلائم % % 25(@)(@@) % والهوى داء كمين في الحشا % % ليت شعري ما لهذا الداء حاسم % % 26(@)(@@) % كان لي صبر فما دام وما % % كان صبر الصب بعد الصد دائم % % 27(@)(@@) % كيف يسلو ذاكر عهد الهوى % % جدد الذكر لعهد متقادم % % 28(@)(@@) % عجبا للشوق يبني ما بنى % % يا ترى يهدمه من بعد هادم % % 29(@)(@@) % وبصدري زفرة لو كشفت % % للصبا يومئذ هبت سمائم % % 30(@)(@@) % غير أني والأماني جمة % % لا أبالي وأبو سلمان سالم % % PageV01P1042 31(@)(@@) % سيد أما نداه فالحيا % % مستهل من سحاب متراكم % % 32(@)(@@) % فهو للصادي إذا بل الصدى % % مورد عذب وبحر متلاطم % % 33(@)(@@) % شمت منه البرق علوي السنا % % مؤذن العارض بالغيث لشائم % % 34(@)(@@) % كسحاب القطر إلا أنه % % يتبع الساجم منهلا بساجم % % 35(@)(@@) % إن من يرويك عنه خبرا % لا كمن يرويك 
ms331	 عن كعب وحاتم % % 36(@)(@@) % عن رسول الله عن أبنائه % % ما روينا من أحاديث المكارم % % 37(@)(@@) % صفوة الله من الخلق وهم % % عالم المعروف والناس عوالم % % 38(@)(@@) % هم هداة الخلق لولا جدهم % % وهداهم كانت الخلق بهائم % % 39(@)(@@) % آل بيت خلقوا مذ خلقوا % % للعلى ركنا وللدين دعائم % % 40(@)(@@) % فتح الله علينا بهم % في مفاتيح العطايا والخواتم % % PageV01P1043 41(@)(@@) % حبذا نجل علي إنه % % عبق الأخلاق عطري النسائم % % 42(@)(@@) % قال من أبصره مستبشرا % هكذا فلتك أبناء الأكارم % % 43(@)(@@) % وارث بعد أبيه في العلى % % من بني هاشم ما أورث هاشم % % 44(@)(@@) % شرف محض ومجد باذخ % % أي فرع من فروع الفخر ناجم % % 45(@)(@@) % يرتقي في كل يوم رفعة % % في المعالي ليس ترقى بالسلالم % % 46(@)(@@) % بأبي الأشراف عن بأس لهم % % أعربت سمر القنا وهي أعاجم % % 47(@)(@@) % وتوالت من يديهم أنعم % فاز من كان لها عاش لائم % % 48(@)(@@) % لي ولي منكم وأنتم أهلها % % نعم ترفعني فوق النعائم % % 49(@)(@@) % فجزيتم سيدي عن شاعر % ناثر فيكم مدى الدهر وناظم % % 50(@)(@@) % مثل ما هبت صبا من حاجر % % ترقص الأغصان منها بالكمائم % % PageV01P1044 51(@)(@@) % ولنعمائك فينا أثر % إن آثارك آثار الغمائم % % 52(@)(@@) % هل درى السيد فيما قد درى % % أم هو الآن بما أعلم عالم % % 53(@)(@@) % إن هندواتكم في كربة % ما له منها سواك اليوم عاصم % % 54(@)(@@) % تاب مما قد جنى من ذنبه % % وعلى التوبة قد أصبح نادم % % 55(@)(@@) % ولهذا أنا ب ستعطافكم % % قارع باللطف أبواب المراحم % % 56(@)(@@) % إن تشأ أنقذته أو لا فلا % % فعلى أيهما أصبحت عازم % % 57(@)(@@) % فتعطف سيدي والطف به % % وعليه إنه مولاي خادم % % 58(@)(@@) % دمت لي ظلا ظليلا وله % % وإنما ظلك للراجين دائم % % PageV01P1045 البحر : رمل تام 1(@)(@@) % جسد أشبه شيء بالخيال % % وفؤادي عن هواكم غير سال % 2(@)(@@) % وعيون نثرت أدمعها % % لثغور نظمت نظم اللآلي % % 3(@)(@@) % دنف لولا هواكم ما غتدى % % مع حسن الصبر في أسوأ حال % 4(@)(@@) % قد يراه الشوق فيكم فانبرى % % وهو لا يمتاز من عود الخلال % % 5(@)(@@) % معرضا عن عاذل في حبكم % % لم يكد يصغي إلى قيل وقال % % 6(@)(@@) % سادة 
ms332	 الدنيا وأعلام الهدى % % لشج أصبح مشغوفا بخالي % % 7(@)(@@) % هل ترتحون محبا من جوى % أو تبلون غليلا ببلال % % 8(@)(@@) % وخيال زارني منكم فما % % زادني إذ زارني غير خيال % % 9(@)(@@) % هيج النار التي أعهدها % % ذات إيقاد بقلبي واشتعال % % 10(@)(@@) % ضارب لي مثلا منكم وما % % لوجوه أجتليها من مثال % % PageV01P1046 11(@)(@@) % وبذكراكم على شحط النوى % % كيف لا أشرق بالماء الزلال % % 12(@)(@@) % إن بالشعب سقى الشعب الحيا % % آل بيت المصطفى من خير آل % % 13(@)(@@) % نظمتنا الراح في أسلاكه % % في ليال مثل أيام الوصال % % 14(@)(@@) % كان للهو به لي منزل % غرة في الأعصر الدهم الأوالي % % 15(@)(@@) % سنحت فيه الظبا واقتنصت % % مهجة الضيغم أحداق الغزال % % 16(@)(@@) % سحرتني يا ترى من ذا الذي % % علم الأحداق بالسحر الحلال % % 17(@)(@@) % ورمتني فأصابت مقتلي % % يا سلمى ما لعينك وما لي % % 18(@)(@@) % كم أرتني لا أرتها راحة % غير ما يخطر منهن ببالي % % 19(@)(@@) % نظرات كنت قد أرسلتها % % وبها يا سعد قد كان وبالي % % 20(@)(@@) % ليت شعري يوم صدت زينب % لملال كان منها أم دلال ؟ % PageV01P1047 21(@)(@@) % موقف التوديع كم أجريت لي % % عبرات رخصت وهي غوالي % % 22(@)(@@) % لم أجد فيك التفاتات إلى % % كبد حرى ولا دمع مذال % % 23(@)(@@) % أين لا أين لنوق أصبحت % تتراءى بين حل وارتحال % % 24(@)(@@) % قد ذكرنا عهدكم من بعدكم % % فتعللنا بأنفاس الشمال % % 25(@)(@@) % انقضى العهد جميلا وانقضت % دولة كانت لربات الرجال % % 26(@)(@@) % كنت مشغوفا فلما أن بدا % % وضح الشيب بفودي بدا لي % % 27(@)(@@) % وأراني في خطوب طبقت % أنا والأيام في حرب سجال % % 28(@)(@@) % من رآني قال لي مما أرى % % هكذا تصنع بالحر الليالي % % 29(@)(@@) % لست منحطا بها عن رتبة % % ومقامي من علي القدر عالي % % 30(@)(@@) % من مثيبي سعة العيش وإن % كنت منها اليوم في ضيق مجال % % PageV01P1048 31(@)(@@) % مورد أصدر عنه بالذي % % أبتغيه منه في جاه ومال % % 32(@)(@@) % إن تقدمت إليه فالمنى % % من نداه والعطاء المتوالي % % 33(@)(@@) % وإذا أبصرت منه طلعة % راعني بين جمال وجلال % % 34(@)(@@) % لم تطش دهياء ما وقرها % % من حلوم راسيات كالجبال % % 35(@)(@@) % ومزيل كل خطب فادح % للرزايا 
ms333	 غير مرجو الزوال % % 36(@)(@@) % لم تكد تحصى سجاياه التي % % رفع الله بها بيت المعالي % % 37(@)(@@) % وخلال يشرف المجد بها % % يعرف المعروف من تلك الخلال % % 38(@)(@@) % متبع الحسنى بحسنى مثلها % % يصل الدهر بها والدهر قال % % 39(@)(@@) % رجل أوتي من خالقه % % صولة ترغم آناف الرجال % % 40(@)(@@) % يتوالى منعما إحسانه % % وأجل الغيث ما جاءك تالي % % PageV01P1049 41(@)(@@) % وله الله فغايات العلى % % نال أقصاها على بعد المنال % % 42(@)(@@) % آل بيت كل خير فيهم % منقذي العالم من هلك الضلال % % 43(@)(@@) % بأبي من سادة أذخرهم % % لمعاشي ومعادي ومآلي % % 44(@)(@@) % قوموا الدين وشادوا مجده % % ثقفوا السؤدد تثقيف العوالي % % 45(@)(@@) % دوحة شامخة منها الذرا % % أنا منها أبدا تحت ظلال % % 46(@)(@@) % كمل الفضل بهم بهجته % % أين بدر التم من هذا الكمال % % 47(@)(@@) % شغل الشكر لساني ويدي % % بعلي بعد محمود الفعال % % 48(@)(@@) % رحت أستحلي قوافي به % % وهي فيه أبد الدهر حوالي % % 49(@)(@@) % لعطاء غير ممنون ولا % % يحوج العافي إليه بالسؤال % % 50(@)(@@) % إن لي فيه وربي أملا % منجز الميعاد من غير مطال % % PageV01P1050 51(@)(@@) % فكأني روضة باكرها % % صيب المزن وحالا بعد حال % % 52(@)(@@) % لا أرى منفصلا عن ثروة % % وبعليائك مولاي اتصالي % % 53(@)(@@) % نلت فيك الخير حتى إنني % % صرت لا أطمع إلا بالمحال % % 54(@)(@@) % منعم في كل يوم نعمة % وكذاك المفضل العذب النوال % % 55(@)(@@) % لا براح عن مغاني سيد % % ولدى عليائه حطت رحالي % % 56(@)(@@) % جزت أجر الصوم فاهنأ بعده % % سيد الاسدات في هذا الهلال % % PageV01P1051 البحر : طويل 1(@)(@@) % خليلي هل لي بعد أسنمة النقا % % بسلع إلى من قد هويت وصول % 2(@)(@@) % فقد حال لا حال شتياق اليهم % % مراحل فيما بيننا ورحيل % % 3(@)(@@) % حملت هواهم يا هذيم على النوى % % وما كل صب يا هذيم حمول % % 4(@)(@@) % فصرت إذا لاحت لعيني أرسم % بدار خلت من أهلها ، وطلول % 5(@)(@@) % أكفكفت من عيني دمعي خشية % % من الواشي أن يدري بها فتسيل % % 6(@)(@@) % أفي كل رسم دارس لي وقفة % % تطول عليه أنة وعويل % % 7(@)(@@) % وأرعى نجوم الليل وهي طوالع % % إلى حين تلقى الغرب وهي أفول % % 8(@)(@@) % لعل خيالا طارقا منك 
ms334	 في الكرى % % فيشفى عليل أو يبل غليل % % 9(@)(@@) % وأرسل في طي النسيم تحية % % إليك وما غير النسيم رسول % % 10(@)(@@) % نظيرك مكحول النواظر خلقة % غرير غضيض الناظرين كحيل % % PageV01P1052 11(@)(@@) % فإن نظرت عيناك عيني تارة % % رأيت سيوف الحتف كيف تصول % % 12(@)(@@) % وما فتنة العشاق إلا نواظر % % تصاب قلوب عندها وعقول % % 13(@)(@@) % عصيت بك العذال في طاعة الهوى % % إذا لام جهلا لائم وعذول % % 14(@)(@@) % وما أثقل القول الذي لامني به % % وإن كنت مشتد القوى لضئيل % % 15(@)(@@) % وليس يعين المستهام على الأسى % % من الوجد إلا صاحب وخليل % % PageV01P1053 البحر : رمل تام 1(@)(@@) % جسد ذاب نحولا وسقاما % % وفؤاد زيد وجدا وغراما % % 2(@)(@@) % دنف لولا تباريح الجوى % % جعل اللائم في الحب إماما % % 3(@)(@@) % ما الذي أوجب ما جئتم به % % من صدود وعلاما وإلاما ؟ % 4(@)(@@) % يا أباة الضيم مالي ولكم % % أفترضون بمثلي أن يضاما % % 5(@)(@@) % أظهر الصبر وعندي غيره % % غير أني أكتم الوجد اكتتاما % % 6(@)(@@) % وأراني جلدا فيما أرى % % من أمور أعرفت مني العظاما % % 7(@)(@@) % إن برقا شمته من جانب العارض % % الوسمي أبكاني ابتساما % % 8(@)(@@) % ويح قلب الصب لم لا ينثني % % فإذا قلت ستفق يا قلب هاما % % 9(@)(@@) % ما بكى المغرم إلا بدم % بل كميه وما بل أواما % % 10(@)(@@) % قوض الركب وأبقى لي الأسى % % لا الجوى ولى ولا الصبر أقاما % % PageV01P1054 11(@)(@@) % ونأت سلمى فهل من مبلغ % منكما عني إلى سلمى سلاما % % 12(@)(@@) % خفرت من عاشق ذمته % % إن للعشاق في الحب ذماما % % 13(@)(@@) % لست أنسى السرب أشكو بعده % % كبدا حرى وقلبا مستهاما % % 14(@)(@@) % راح يرميني بسهمي ناظر % غنج أحوى ويدميني قواما % % 15(@)(@@) % أيها الرامي فؤادي عبثا % بؤت بالوزر وقلدت أثاما % % 16(@)(@@) % ما لمن حلل قتلي في الهوى % % حرم الوصل وما كان حراما % % 17(@)(@@) % أرأيتم أنني من بعدكم % % في عذاب لم يكن إلا غراما % % 18(@)(@@) % إن يلاق الصبح ما لاقيته % % أصبح الصبح لما يلقى ظلاما % % 19(@)(@@) % برزت أسماء أو أترابها % % يوقرن السمع عذلا وملاما % % 20(@)(@@) % يتناجين بإيلام فتى % ضيع الحزم فلم يشدد حزاما % % PageV01P1055 21(@)(@@) % قلن لو رام وما في باعه 
ms335	 % % قصر أدرك بالسعي المراما % % 22(@)(@@) % لو تنبهت لها مجتهدا % كيف بالحظ إذا ما الحظ ناما % % 23(@)(@@) % أو رأى المقدور فينا رأيه % % ما تكلفت نهوضا وقياما % 24(@)(@@) % أبرح الدهر على ما لم أرد % ورزاياه صطكاكا و ضطراما % % 25(@)(@@) % لم يلن للدهر مني جانب % % حيث لم أستعطف القوم اللئام % % 26(@)(@@) % وعناء كلها أمنيتي % % في زمان أن أرى الناس كراما % % 27(@)(@@) % بأبي محمود ينبوع الندى % % أبصر الأعلام أطلالا ركاما % % 28(@)(@@) % وأرى كل علي دونه % % فتعالى ذلك القرم الهماما % % 29(@)(@@) % أنفق العمر جميلا فليدم % وجميل الصنع أنى دام داما % % 30(@)(@@) % ويمينا إنه لو لم يجد % في منام لم يذق قط مناما % % PageV01P1056 31(@)(@@) % فسلوه هل خلا مما به % % يصنع البر فيوليه الأناما % % 32(@)(@@) % أم تخلى من جميل ساعة % من زمان غير ما صلى وصاما % % 33(@)(@@) % كم له من نظرة في رأفة % أيقظت لي أعينا كن نياما % % 34(@)(@@) % ذللت مستعصبات لم يكد % يملك القائد منهن زماما % % 35(@)(@@) % أستقل الأنجم الزهر له % % أن ترى فيه نثارا ونظاما % % 36(@)(@@) % ولو ن كلمته في لؤلؤ % ومن اللؤلؤ ما كان كلاما % % 37(@)(@@) % تجتلي قرما إماما بالندى % % بأبي ذيالك القرم الإماما % % 38(@)(@@) % وحسام باتر لا سيما % % إن هززناه على الخطب حساما % % 39(@)(@@) % فنوال ناب عن وبل الحيا % % وجمال يخجل البدر التماما % % 40(@)(@@) % رفعة قد شهد الخصم لها % % قعد الغارب منها والسناما % % PageV01P1057 41(@)(@@) % وإليه وإلى عليائه % % أنيق الراجين أمست تترامى % % 42(@)(@@) % وكأني وكأن شعري له % % مستميح حيث شام البرق شاما % % 43(@)(@@) % بالطويل الباع بالسامي الذرى % % عرف المعروف شيخا وغلاما % % 44(@)(@@) % وعلى ما هو فيه لم يزل % % أو يقال التبر قد عاد رغاما % % 45(@)(@@) % والكريم النفس لا عن غرض % % أيها أزكى شرابا وطعاما % % 46(@)(@@) % هكذا الناس إذا قيل الندى % % سحب تنشا جهاما وركاما % % 47(@)(@@) % من سوى أيديه في فرط الظما % % لا أراني الله أستسقي الغماما % % 48(@)(@@) % كلما اعوجت أموري والتوت % % قوم المعوج منها فاستقاما % % 49(@)(@@) % يا أبا محمود يا من لم يزل % % رحمة للخلق برا باليتامى % % 50(@)(@@) % غير ما خولتني من نعمة % أنا 
ms336	 لا أملك في الدنيا حطاما % % PageV01P1058 51(@)(@@) % أفطر الناس جميعا غيرنا % % وبقينا نحن في الناس صياما % % 52(@)(@@) % فلقد هنيت بها % % غرة الأعياد والشهر الحراما % % 53(@)(@@) % وابق للإسلام ركنا سالما % منعما يا عيدنا عاما فعاما % % PageV01P1059 البحر : طويل 1(@)(@@) % أقول لسعد حين لام على الهوى % % أيجديك لوم مرة فتلوم % 2(@)(@@) % تلوم علة ما لا يفيدك لومه % % وما العشق إلا لائم وملوم % % 3(@)(@@) % وإني على ما بي فقد يستفزني % % غرام بسلمى حادث وقديم % % 4(@)(@@) % شكوتك ما يلقى فؤادي من الأسى % % وما كل من أشكو إليه رحيم % % 5(@)(@@) % فؤاد شجاه ما شجى كل وامق % وما هو بعد الراحلين مقيم % 6(@)(@@) % أرى صبوة المشتاق دائمة المدى % % فما بال صبر الصب ليس يدوم % % 7(@)(@@) % وبين الظباء السانحات عشية % رماني فلم يخط الحشاشة ريم % % 8(@)(@@) % ويا ظبية الوعساء من جانب الحمى % % وإني بها لولا الدموع كتوم % % 9(@)(@@) % وفي القلب مني والغرام سريرة % % 10(@)(@@) % ظما لثناياك العذاب وإنها % % عذاب لقلبي يا أميم أليم % % PageV01P1060 11(@)(@@) % رضابك يروي القلب وهو ممنع % وطرفك يشفي الداء وهو سقيم % % 12(@)(@@) % ولولاك ما هاجت بقلبي زفرة % % ولا هاج مني أربع ورسوم % % 13(@)(@@) % ولا شاقني برق يحاكي وميضه % % ثناياك إذ أصبو لها وأشيم % % 14(@)(@@) % وأهتز في ذكر العذيب وبارق % كما مال بالغصن الرطيب نسيم % % PageV01P1061 البحر : طويل 1(@)(@@) % سعيت لهذا الملك بالهمة الكبرى % % فأدركت أفنائها الدولة الغرا % % 2(@)(@@) % وسرت على نبل الأسنة للعلى % % ومن رام إدراك العلى ركب الوعرا % % 3(@)(@@) % لنيل المنى جزت المسير وإنما % % يخوض عباب البحر من يطلب الدرا % % 4(@)(@@) % إذا عارضت دون المرام بحيرة % % من الحتف صيرت الحديد لها جسرا % % 5(@)(@@) % وإن رقمت فوق الأنام حنادس % جليت من الرأي السديد لها فجرا % % 6(@)(@@) % قدمت قدوم الليث غابة شبله % % ونزهت هذا الملك بالنية الخضرا % % 7(@)(@@) % درى الملك يا مولاي أنت فؤاده % % فضمك منه حين أسكنك الصدرا % % 8(@)(@@) % رقيت على كرسيه فأزنته % % فأصبحت كالتزريد في وجنة العذرا % % 9(@)(@@) % فما هذه الفيحاء إلا قلادة % % ونحرك من كل النحور بها أحرى % % 10(@)(@@) % وما هي إلا كاعب قد تسترت 
ms337	 % قد اتخذت خيس الأسود لها خدرا % % PageV01P1062 11(@)(@@) % فجوزاء أفق بالدراري تمنطقت % مخدمة تستخدم البيض والسمرا % % 12(@)(@@) % لقد مطلت بالوعد عصرا وعاودت % % فجادت بوصل بعدما مطلت دهرا % % 13(@)(@@) % تزوجتها أيما عجوزا مسنة % فأضحت لديك الآن كاعبة بكرا % % 14(@)(@@) % فحكت لها ثوب المفاخر بالندى % % وألبستها من بأسك الحلة الخضرا % % 15(@)(@@) % وهيأت من نقد العوالي صداقها % % وأنقدت من بيض الحديد لها مهرا % % 16(@)(@@) % قدمت لها من بعد كشف حجابها % % فكنت لعوراء الزمان لها سترا % % 17(@)(@@) % فعدت إليها بالتقرب بعدما % % علاها قنوط أن تعود لها أخرى % % 18(@)(@@) % تدانيت منها كالهلال ولم تزل % % تنقل حتى عدت في أفقها بدرا % % 19(@)(@@) % وودعتها مكروبة اللب والحشا % % وأبت وأبدت من مسرتها البشرى % % 20(@)(@@) % فإن طاوعتك اليوم جهرا وصالها % % فقد كان هذا الأمر في نفسها سرا % % PageV01P1063 21(@)(@@) % فكم مر آن وهي تكتم شوقها % % إليك وتحيي ليلها كله سرا % % 22(@)(@@) % لأمر القضا كادت تفر إذا رأت % % لوصلك وقتا لم تجد دونه عذرا % % 23(@)(@@) % لقد أحدقت بعد العمى بك عينها % % وأحدثت في أجفانها الفتك والسحرا % % 24(@)(@@) % وحليت في سلك العزائم جيدها % % ووشحت منها في صنعائك الخصرا % % 25(@)(@@) % وزينتها حتى حكى التبر تربها % % ولو لم تكن في أرضها أصبحت صفرا % % 26(@)(@@) % فصرت بها لما حللت بصدرها % % كيوسف إذ ولاه خالقه مصرا % % 27(@)(@@) % فلم تجز أهل المكر يوما بمكرهم % % ولم تصطنع غدرا لمن صنع الغدرا % % 28(@)(@@) % صفحت عن الجانين إلا أقلهم % % فأوسعتهم عفوا وأثقلتهم شكرا % % PageV01P1064 البحر : بسيط تام 1(@)(@@) % سفينة صنعت بالهند إذ صنعت % % أهدى السفائن في سير وأجراها % % 2(@)(@@) % طوع الهواء متى تجري جرت معه % % وما تخالف مسراه ومسراها % % 3(@)(@@) % جاءت من البحر تجري فيه أرخها % % سفينة البحر باسم الله مجراها % % PageV01P1065 البحر : وافر تام 1(@)(@@) % أدار الكأس صافية المدام % كحيل الطرف ممشوق القوام % % 2(@)(@@) % وقد ركضت بأقداح الحميا % % خيول الصبح في جنح الظلام % % 3(@)(@@) % وأبصر غادة من آل سام % % على الباقين من أولاد حام % % 4(@)(@@) % وما عجنا لأطلال رمام % كما نثر الجمان من النظام % % 5(@)(@@) % ونحن بروضة تندى فتبدي % % لنا شكران آثار 
ms338	 الغمام % % 6(@)(@@) % وقد أملت حمائمها علينا % % من الأوراق آيات الغرام % % 7(@)(@@) % أقمنا بين أفناء الأغاني % % وما اخترنا المقام بلا مقام % % 8(@)(@@) % تلذ القيان بها سماعا % إذا اتصلت بمنقطع الكلام % % 9(@)(@@) % وما رقصت غصون البان إلا % لما سمعته من لحن الحمام % % 10(@)(@@) % فمن طرب إلى طرب توالى % % ومن جام سعى في إثر جام % % PageV01P1066 11(@)(@@) % رضعنا من أفاويق الحميا % % وقلنا لا منعنا بالفطام % % 12(@)(@@) % نفض ختامها مسكا ذكيا % وكان الدن مسكي الختام % % 13(@)(@@) % تحل بها المسرة حيث حلت % بعيد الخطو جواب الموامي % % 14(@)(@@) % عصينا من نهى عنها عتوا % وفزنا بالمعاصي والأثام % % 15(@)(@@) % وحرمنا الحلال على الندامى % % وما يغني الحلال عن الحرام % % 16(@)(@@) % وكم يوم تركنا الزق فيه % % جريحا من يد الندمان دامي % % 18(@)(@@) % وليل يجمع الأحباب شملا % بمن نهوى شديد الالتحام % % 19(@)(@@) % وباتت تسعف اللذات فيه % % ببنت الكرم أبناء الكرام % % 20(@)(@@) % فمن وجه تقر به عيوني % % ومن رشف أبل به أوامي % % 21(@)(@@) % فيبعث بالسرور إلى فؤادي % % ويهدي بالشفاء إلى سقامي % % PageV01P1067 22(@)(@@) % وقد طاب الزمان فلا رقيب % % يكدر صفو عيشي بالملام % % 23(@)(@@) % وما أهنا شموس الراح تترى % % وقد أخذت عن البدر التمام % % 24(@)(@@) % وغايتة تجود إذا استميحت % % بطيب الوصل بعد الانصرام % % 25(@)(@@) % فما غدرت لمشتاق بعهد % ولا خفرت لصب بالذمام % % 26(@)(@@) % تركت العاذلين بها ورائي % % وقدمت السرور بها أمامي % % 27(@)(@@) % تعير بوجهها الأقمار معنى % إذا وافتك بارزة اللثام % % 28(@)(@@) % كأني قد أخذت على الليالي % % عهود الأمن من ريب الحمام % % 29(@)(@@) % ومن أضحى إلى سلمان يعزى % % وخدمته فمحمول السلام % % 30(@)(@@) % أصبت بنيله أملا بعيدا % وما طاشت بمرماها سهامي % % 31(@)(@@) % كأني أستزيد ندى يديه % % بشكراني لأيديه الجسام % % PageV01P1068 32(@)(@@) % وكم نعم له عندي وأبد % رغمت بهن آناف اللئام % % 33(@)(@@) % وصالحت الخطوب على مرادي % % وكنت عهدتها لد الخصام % % 34(@)(@@) % وما نفصلت عرى أمل وثيق % وفيه تمسكي وبه عتصامي % % 35(@)(@@) % مكان تمسكي بالعهد منه % % مكان الكف من ظبة الحسام % % 36(@)(@@) % وسيال اليدين من العطايا % % تسيل من العطاء لكل ظامي % % 37(@)(@@) % إذا ما فاتني التقبيل منها % % فليس يفوتني نوء 
ms339	 الغمام % % 38(@)(@@) % تمام جماله خلق رضي % وحسبك منه بالبدر التمام % % 39(@)(@@) % وتلك خلائق خلصت فكانت % % نضارا لا تدنس بالرغام % % 40(@)(@@) % فتى في الناجبين لقد أراني % % وقار الشيخ في سن الغلام % % 41(@)(@@) % ركبت إليه من أملي جوادا % % PageV01P1069 42(@)(@@) % فأبرق واستهل ورحت أروي % % سجام القطر عن قطر سجام % % 43(@)(@@) % كما نزلت على أرض سماء % تسيل على الأباطح والأكام % % 44(@)(@@) % فأمسى كل آونة قريضي % % يغرد منه تغريد الحمام % % 45(@)(@@) % أرى مدحي لآل البيت فرضا % كمفترض الصلاة أو الصيام % % 46(@)(@@) % أئمة ملة الإسلام كل % يقال له الإمام ابن الإمام % % 47(@)(@@) % وما شرف الأنام بغير قوم % هم مذ كونوا شرف الأنام % % 48(@)(@@) % أفاضوا بالعطاء لمجتديهم % % وللأعداء بالموت الزؤام % % 49(@)(@@) % وكل منهم ليث هصور % وبحر من بحور الجود طامي % % 50(@)(@@) % بنفسي سيدا في كل حال % يرى فيها احتشامي واحترامي % % 51(@)(@@) % ظفرت به حساما ليس ينبو % % نبو مضارب السيف الكهام % % PageV01P1070 52(@)(@@) % وقد يدعى الكريم إلى نوال % كما يدعى الشجاع إلى صدام % % 53(@)(@@) % وعندي في صنائعه قواف % يضيق بهن صدر الاكتتام % % 54(@)(@@) % وشعري في صفات بني علي % رفعت به إلى أعلى مقام % % 55(@)(@@) % سأطرب في مديحك كل واع % ولا طرب الشجي المستهام % % 56(@)(@@) % وأشكر منك فضلك ثم أدعو % % لوجهك بالبقاء وبالدوام % % PageV01P1071 البحر : متقارب تام 1(@)(@@) % بكيت الديار وأطلالها % % وقد بدل البين تمثالها % % 2(@)(@@) % وأخنى عليها خطوب الزمان % % فما خالها تلك من خالها % % 3(@)(@@) % وفي مهجتي للجوى لوعة % تقطع بالوجد أوصالها % % 4(@)(@@) % لقد سولت لي سيل الدموع % % فما قلت يومئذ ما لها % % 5(@)(@@) % تذكرت عصر الصبا والهوى % % يهيج للنفس بلبابها % % 6(@)(@@) % وما اختلس الدهر من لذة % لعهد الصبابة و غتالها % % 7(@)(@@) % زمان أعاقر فيه العقار % % وأعصي بلهوي عذالها % % 8(@)(@@) % وأمشي بها مرحا تستميل % % من السكر بالراح ميالها % % 9(@)(@@) % وكم غادة في ليالي الوصال % % جمعت مع القرط خلخالها % % 10(@)(@@) % وما زلت أرشف من ريقها % % لماها وأشرب جريالها % % PageV01P1072 11(@)(@@) % لئن كان ريقك يحيي النفوس % % فقد كان لحظك قتالها % % 12(@)(@@) % وساقية عمها حسنها % % بجنح دجى قد حكى خالها % % 13(@)(@@) % تدير النضار بكأس 
ms340	 اللجين % % فتحكي المصابيح سيالها % % 14(@)(@@) % كميتا تجول بمضمارها % % جاذر تصرع أبطالها % % 15(@)(@@) % فيا طيب معسول ذاك اللمى % % إذا هصر الصب عسالها % % 16(@)(@@) % ولست بناس لها ما مضى % % وإن كنت أعملت إهمالها % % 17(@)(@@) % ليالي لم أبد تفصيلها % % إذا أنا أبديت إجمالها % % 18(@)(@@) % وأبت لمشبهة في المسير % % زفيف النعامة أو رالها % % 19(@)(@@) % كأني تكلفت مسحا بها % % عروض البلاد وأطوالها % % 20(@)(@@) % طويت القفار وخضت البحار % % ورضت الخطوب وأهوالها % % PageV01P1073 21(@)(@@) % وجربت أبناء هذا الزمان % % وعرفني الدهر أحوالها % % 22(@)(@@) % وإني لذاك الذي تعرفون % حملت المروءة أثقالها % % 23(@)(@@) % وإن قل مافي يدي لك أكن % لأشكو من العصر إقلالها % % 24(@)(@@) % وإن أنا أتربت فالمكرمات % % تحدث بأني فعالها % % 25(@)(@@) % وحسبك من ذي يد أصبحت % % تطول ولا ذو يد طالها % % 26(@)(@@) % وإن أعضلت مشكلات الأمور % % أزال وفسر إشكالها % % 27(@)(@@) % وقافية من شرود الكلام % % بأخبار سلمان قد قالها % % 28(@)(@@) % وأرسلها مثلا في الثناء % % وخص بمن شاء إرسالها % % 29(@)(@@) % فتى يقتفي إثر آبائه % % وحاكت مزاياه أفعالها % % 30(@)(@@) % تنال من الله نعم الثواب % وتنفق لله أموالها % % PageV01P1074 31(@)(@@) % تفجر من راحتيه الندى % % وأورد من شاء سلسالها % % 32(@)(@@) % من السادة النجب الطاهرين % % تزين العصور وأجيالها % % 33(@)(@@) % لقد طهر الله تلك الذوات % % وأجرى على الخير أعمالها % % 34(@)(@@) % بني الغوث غوث فحول الرجال % % ال إذا شتد بالناس ما هالها % % 35(@)(@@) % وأفعالها في جميع الصنيع % % من البر تسبق أقوالها % % 36(@)(@@) % فما زلت أذكر تفضيلها % % وما زلت أشكر إفضالها % % 37(@)(@@) % بكم يستغاث إذا ما الخطوب % % أهالت على الخلق أهوالها % % 38(@)(@@) % فكنتم من الناس أقطابها % % وكنتم من الناس أبدالها % % 39(@)(@@) % فلو حلت الأرض من مثلكم % % لزلزلت الأرض زلزالها % % 40(@)(@@) % أبا مصطفى أنت صوب الغمام % % ويا ربما فقت هطالها % % PageV01P1075 41(@)(@@) % وقد نفقت فيك سوق القريض % % وكان نوالك دلالها % % 42(@)(@@) % ولما بلغت المنى في العلى % % وبلغت نفسي آمالها % % 43(@)(@@) % أتتك النقابة تسعى إليك % % تجر من التيه أذايالها % % 44(@)(@@) % وألقت إليك مقاليدها % % وأبدت لعزك إذلالها % % 45(@)(@@) % وراثة آبائك الطاهرين % % فما أحد غيرهم نالها % % 46(@)(@@) % عليكم وفيكم ومنكم نرى % % وجوه السعادة إقبالها % % 47 