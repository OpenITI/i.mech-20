ms136	 نمود که زر عاشق است بر سیماب(@)(@@) 10 دگر شنیدم با آب دشمنست آتش %~% قسم به جان تو این هم نداشت رونق و آب(@)(@@) 11 ز من نداری باور یکی در آینه‌بین %~% که چهره تو به یکجا هم آتشست و هم آب(@)(@@) 12 دگر شنیدم عناب می نشاند خون %~% به هر که گوید این حرف لازم است عتاب(@)(@@) 13 از آنکه دیدم‌کز دیدگان خونبارم %~% بخاست لجه خون تا مزیدمت عناب(@)(@@) 14 دگر شنیدم جای عذاب نیست بهشت %~% اگر چه نص حدیثست و دیده‌ام به ‌کتاب(@)(@@) 15 ولی جمال تو خرم بهشت را ماند %~% وزان بهشت به جانم رسد هزار عذاب(@)(@@) 16 دگر شنیدم در ری کسی به قاآنی %~% نداده جایزه وین‌گفته هم نبود مصاب(@)(@@) 17 از آنکه دیدم زان پیشتر که ‌گوید مدح %~% بسی جوایز و تشریف یافت از نواب(@)(@@) 18 خجسته مام ولیعهد آن‌که قدرت او %~% سپهر اخضر سازد همی ز برگ سداب(@)(@@) 19 کفایت‌ کرمش سنگ را کند گوهر %~% حلاوت سخنش زهر را کند جلاب(@)(@@) 20 بدان رسید که از خویش هم شود پنهان %~% ز بس که عصمت او بسته‌ بر رخش جلباب‌(@)(@@) 21 بهشت وکوثر و طوبی به مهر اوگروند %~% زهی سعادت‌طوبی لهم و حسن مآ‌ب‌(@)(@@) 22 ز یمن معدلت آبادکرد عالم را %~% از آن سپس‌که ز غوغای حس‌کرد خراب(@)(@@) 23 کفش ببخشد هرچ آن زکان‌کند تاراج %~% هلا ندانم وهاب هست یا نهاب(@)(@@) 24 مگر ولادت او در شب اتفاق افتاد %~% که آفتاب چو شب شد رود به زیر حجاب(@)(@@) 25 اگر چکد عرقی از رخش به بحر محیط %~% ز آبش آید تا روز حشر بوی گلاب(@)(@@) 26 خلوص شاه جهان جای روح و خون شب و روز %~% دوان همی رودش در عروق و در اعصاب(@)(@@) 27 شه ار سوالی از وی‌ کند ز غایت شوق %~% یکان یکان همه اعضای او دهند جواب(@)(@@) 28 به باده میل ندارد شه ار نه از سر مهر %~% ز پاره جگر 
ms137	 خویش ساختیش‌کباب(@)(@@) 29 ز بس‌که دل‌کشدش سوی شاه ینداری %~% فکنده شاه جهان در عروق او قلاب(@)(@@) 30 زهی ز لطف تو در آب مستی باده %~% خهی‌ ز قهر تو در سنگ لرزه سیماب(@)(@@) 31 رسول دید چو هر نطفه و جنینی را %~% که تا به حشر در ارحام هست یا اصلاب(@)(@@) 32 شعاع روی ترا دید در مشیت حق %~% چه گفت گفت الا ان هذه لعجاب(@)(@@) 33 یقین نمود که بی‌پرده ‌گر تو جلوه ‌کنی %~% ز شرم تیره شود آفتاب عالمتاب(@)(@@) 34 خلل‌به‌روز وشب افتدسپس فروض و سنن %~% نکرده ماند و مهمل شود ثواب و عقاب(@)(@@) 35 ز حرمت تو پس آنگه به حکم مطلق گفت %~% که تا زنان همه در چهره افکنند نقاب(@)(@@) 36 وگر به حکم پیمبر نمی‌شدی مستور %~% رخ تو قبله دین بود و ابرویت محراب(@)(@@) 37 تو نیز چون ز رسول این‌ چنین عطا دیدی %~% نثارکردی جان را بر آن خجسته جناب(@)(@@) 38 ترا محبت زهرا چنان‌کشد سوی خویش %~% که ‌گوییت رگ جان و به ‌گردنست طناب(@)(@@) 39 همت به مهر ولیعهد دل‌کشد چندان %~% که در بیابان ظهر تموز تشنه به آب(@)(@@) 40 خجسته ناصر دین آنکه از سیاست او %~% چنان بلرزدگردون چوگوی در طبطاب(@)(@@) 41 عقاب بر همه مرغان از آن بود غالب %~% که روز رزم بود پر تیر او ز عقاب(@)(@@) 42 غراب از آن به شآمت مثل شد از مرغان %~% که تیره‌روی چو اعدای جاه اوست غراب(@)(@@) 43 خدای یک صفت خود به جود او بخشید %~% از آن بود کف جودش مسبب ‌الاسباب(@)(@@) 44 اگر مجسم‌ گشتی محیط همت او %~% سپهر و انجم بودی برآن محیط حباب(@)(@@) 45 ز تیغ‌گیهان سوزش بسی عجب دارم %~% که چون نسوزد کیمخت را به روی قراب(@)(@@) 46 به روز محشر هر چیز در حساب آید %~% به غیر همت او کان برون بود ز حساب(@)(@@) 47 به مدح او نرسی لب به بند قاآنی %~% که تیر با همه 
ms138	 تندی نمی‌رسد به شهاب(@)(@@) 48 مدار چرخ رونده است تا به‌گرد زمین %~% همی به شکل رحا و حمایل و دولاب(@)(@@) 49 شه جهان و و‌لیعهد و مام او را باد %~% خدا معین و ملک ناصر و فلک بواب PageV1P109(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گرفت عرصه‌گیتی شمیم عنبر ناب %~% زگرد خاک سرکوی میرعرش‌ جناب(@)(@@) 2 وکیل ملک ملک مهتری ‌که فلک فلک %~% به بحر همت او چون سفینه درگرداب(@)(@@) 3 بزرگ ‌همت وکوچک‌دلی‌که دست و دلش %~% یکی به بحر زند طعنه دیگری به سحاب(@)(@@) 4 بهادری ‌که ز تف شرار شمشیری %~% بود مزاج معاند همعشه در تب و تاب(@)(@@) 5 سزد که از اثر خلق و لطف جان بخشش %~% به‌ کام افعی‌ گیرد مزاج شهد لعاب(@)(@@) 6 به خدمت ملک آن ملک‌بخش ‌کشورگیر %~% سحرگهان به من از روی لطف‌کرد خطاب(@)(@@) 7 خجسته تهنیتی‌گوی عید اضحی را %~% که تا به‌گوش نیایش نیوشی از احباب(@)(@@) 8 جواب دادمش ای آنکه رای عالی تو %~% بود معاینه چون آفتاب عالمتاب(@)(@@) 9 دو روز پیش که پهلوی استراحت من %~% نسوده است ز دلخستگی به بستر خواب(@)(@@) 10 ز گرد راه چنانم‌ که تل خاک شود %~% گرم به سخره‌کسی افکند به دجله آب(@)(@@) 11 مرا ز بستن نظم این زمان همان عجز ست %~% که صعوه را و شکار تدزو و صید عقاب(@)(@@) 12 به خشم رفت و بر ابرو فکند چین و گشود %~% دو بسدگهرانگیز را ز روی عتاب(@)(@@) 13 که عذر بیهده تاکی همینت عذر بس است %~% که عجز طبع فکندست مر تو را به عذاب(@)(@@) 14 بگیر خامه مشکین ختامه را به بنان %~% مر این چکامه فرخنده را ببر به‌ کتاب(@)(@@) 15 زهی شهنشه دوران خدایگان ملوک %~% که با اسحاب‌ کفت‌ساحت محیط سراب(@)(@@) 16 تو آن شهی‌که ز معماری عدالت تو %~% سرای امن شد آباد وکاخ فتنه خراب(@)(@@) 17 حسام سر فکنت بارور درختی هست %~% که بار او نبود غیر روین و عناب(@)(@@) 18 ز بیم تیغ 
ms139	 تو نالان پلنگ در کهسار %~% ز سهم سهم تو مویان غضنفر اندر غاب(@)(@@) 19 ز شوق بزم تو امروز قدسیان سپهر %~% ز هر طرف متذکر به لیت‌کنت تراب(@)(@@) 20 برای طوف حریم حرم مثال تو جمع %~% چو خلق در حرم ‌کعبه مالکان رقاب(@)(@@) 21 سزاست از پی قربانی توجیش عدو %~% که در شمار بهیمند زی اولواالالباب(@)(@@) 22 به شرط آنکه چو ما بندگان پاک ضمیر %~% که بهر دفع شیاطین دولتیم شهاب(@)(@@) 23 برافکنیم سراسر شکنجها به جبین %~% برآوریم یکایک پرندها ز قراب(@)(@@) 24 ز خون خصم تو آریم لجه‌ای‌که در او %~% قباب نه فلک آمد چو قبهای حباب(@)(@@) 25 الا به‌ بزم جهان تا نشاط و عیش و طرب %~% عیان شود ز بم و زیر تار چنگ و رباب(@)(@@) 26 بود به‌کام موالیت نیش نوش روان %~% بود به‌جام اعادیت نوش نیش مذاب PageV1P110(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه ‌جوهرست ‌که‌هست اعتبار آتش و آب %~% چه‌ گوهرست‌ که زیبد نگار آتش و آب(@)(@@) 2 چه لعبتست‌ که چون‌ کودکانش مادر دهر %~% نموده تربیت اندر کنار آتش و آب(@)(@@) 3 دوام دولت و دین و ثبات چرخ و زمین %~% قرار خاک و هوا و مدار آتش و آب(@)(@@) 4 مگر توگویی معمار چرخ‌کرده بنا %~% شگفت باره‌یی اندر دیار آتش و آب(@)(@@) 5 چه‌ساحریست‌که فوجی‌ضعیف‌مورچگان %~% نمی‌روند برون از حصار آتش و آب(@)(@@) 6 سمندرست همانا درست یا خرچنگ %~% که‌گشته‌اند ز هرگوشه یار آتش و آب(@)(@@) 7 به نیکخواه بود آب و بر عدو آتش %~% بلی به دهر بود پرده‌دار آتش و آب(@)(@@) 8 گهیش مهد تقاضا بودگهی دامن %~% که شیرخواری هست از تبار آتش و آب(@)(@@) 9 سبب تماثل با وی بود وگرنه چرا %~% به خاک و باد بود افتخار آتش و آب(@)(@@) 10 شکار وی نبود غیر صید جان آری %~% نکو نباشد جز جان شکار آتش‌ و آب(@)(@@) 11 به راستی‌که نزیبد نشیمنش به جهان %~% به غیر دست خداوندگار آتش و آب(@)(@@) 12 ابوالشجاع 
ms140	 بهادر حسن شه آنکه بود %~% حسام سر فکنش پیشکار آتش و آب(@)(@@) 13 به‌قهر و لطف چنان آب آب و آتش برد %~% که باد و خاک بود مستجار آتش و آب(@)(@@) 14 ز سیر خنگش‌ کز تندباد برده ‌گرو %~% شد از زمین به فلک زینهار آتش و آب(@)(@@) 15 تبارک‌الله از آن باد سیرخاک سکون %~% که در زمانه بود یادگار آتش و آب(@)(@@) 16 زکین و مهر تو هر لحظه در خروش آیند %~% دلم بسوزد بر روزگار آتش و آب(@)(@@) 17 یکی به قهرتو ماند یکی به رحمت تو %~% بلی عبث نبود اقتدار آتش ‌و آب(@)(@@) 18 به خشم و لطف تو اندک تشابهی دارد %~% وگرنه از چه بود اشتهار آتش و آب(@)(@@) 19 اگر به رشته لطفت نبود پیوسته %~% گسسته بود ز هم پود و تار آتش و آب(@)(@@) 20 چنان ز آتش و آبم به موزه سنگ فتاد %~% که ‌کیک افکنم اندر ازار آتش و آب(@)(@@) 21 الا به دور جهان تا که تیر و تیغ ترا %~% همی قضا شمرد در شمار آتش و آب(@)(@@) 22 ز تیر و تیغ تو کز آب و آتش افزونست %~% همیشه باد عدو خاکسار آتش و آب PageV1P111(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای به از روز دگر هر روز کارت %~% باد بهروزی قرین روزگارت(@)(@@) 2 روز بارت‌کت فتد در پره‌گردون %~% گردن‌گردان بود در زیر بارت(@)(@@) 3 آشکارا بر نهانی پرده پوشد %~% راز پنهان پیش رای آشکارت(@)(@@) 4 رخ چو فرزین آردت هر شه پیاده %~% چون بر اسب پیلتن بیند سوارت(@)(@@) 5 درگهت را چرخ باشد پرده‌داری %~% زان جدا از در نگردد پرده‌ دارت(@)(@@) 6 ابر و دریا در شمار قطره ناید %~% درکجا در پیش بذل بیشمارت(@)(@@) 7 باد رفتار است خنگ خاک توشت %~% آتشین فعل است تیغ آبدارت(@)(@@) 8 لاغران فربه ز بازوی ثمینت %~% فربهان لاغر ز شمشیر نزارت(@)(@@) 9 خصم‌گردون زیرپای خویش خواهد %~% زان به پای خود رود بالای دارت(@)(@@) 10 ای یسار 