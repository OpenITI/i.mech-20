ms5521	 وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 99، ح 2.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 4، ك 2، ب 61، ح 7.(@)(@@) * وروى عن أبان بن تغلب، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 4، ب 118، ح 2.(@)(@@) * وروى عن أبان بن عبد الملك، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 108، ح 1.(@)(@@) * وروى عن أبان بن عثمان، وروى PageV17P410(@)(@@) عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1103 (الاستبصار:(@)(@@) ج 3، ح 519، و 656)، و 1252 (الاستبصار: ج 3، ح 519، و 656).(@)(@@) * وروى عن إبراهيم بن سفيان، وروى عنه محمد بن علي الكوفي.(@)(@@) مشيخة الفقيه: في طريقه إلى إبراهيم بن سفيان.(@)(@@) وروى عن إبراهيم بن يزيد الأشعري، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 146، ح 1.(@)(@@) * وروى عن إدريس بن هلال، وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) مشيخة الفقيه: في طريقه إلى إدريس ابن هلال.(@)(@@) * وروى عن إسحاق بن جرير، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 4، ك 3، وب 236، ح 2.(@)(@@) والتهذيب: ج 5، ح 1500 (الاستبصار:(@)(@@) ج 2، ح 1196).(@)(@@) * وروى عن إسحاق بن عمار، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 4، ك 1، ب 11، ح 3.(@)(@@) وروى عنه أحمد بن عمر.(@)(@@) التهذيب: ج 2، ح 421.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 52، ح 6، وب 59، ح 4، و ج 6، ك 8، ب 57، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 49، ح 11.(@)(@@) والروضة: ح 30. والتهذيب: ج 2، ح 414.(@)(@@) وروى عنه الحسن بن الحسين اللؤلؤي.(@)(@@) التهذيب: ج 4، ح 172.(@)(@@) وروى عنه الحسن بن محبوب.(@)(@@) التهذيب: ج 1، ح 1492.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 3، ك 4، ب 49، ح 4.(@)(@@) والتهذيب: ج 3، ح 750.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 85، ح 4.(@)(@@) * وروى عن إسماعيل بن جابر.(@)(@@) الفقيه: ج 2، ح 811.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 2، ب 13، ح 2، و ج 2، ك 1، ب 118، ح 1، و ج 6، ك 5، ب 15، PageV17P411(@)(@@) ح 13.(@)(@@) والتهذيب: ج 7، ح 1911 (الاستبصار:(@)(@@) ج 3، ح 792).(@)(@@) وروى عنه أحمد بن محمد بن عيسى. 
ms5522	(@)(@@) الكافي: ج 1، ك 2، ب 2، ح 5، و ج 2، ك 2، ب 48، ح 35، و ج 4، ك 1، ب 26، ح 4، و ج 6، ك 6، ب 102، ح 1، وك 7، ب 7، ح 4.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 2، ح 29، و ج 3، ح 353، و ج 9، ح 269 (الاستبصار: ج 4، ح 302).(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الروضة: ح 1.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 5، ك 3، ب 67، ح 13.(@)(@@) والروضة: ح 430.(@)(@@) وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 6، ك 5، ب 15، ح 11.(@)(@@) * وروى عن إسماعيل بن عبد الرحمان الجعفي الكوفي، وروى عنه محمد بن خالد.(@)(@@) مشيخة الفقيه: في طريقه إلى إسماعيل الجعفي.(@)(@@) * وروى عن إسماعيل الجعفي، وروى عنه محمد بن الحسين.(@)(@@) الروضة: ح 427.(@)(@@) * وروى عن بزيع المؤذن، وروى أحمد ابن أبي عبد الله، عن أبيه، عنه.(@)(@@) مشيخة الفقيه: في طريقه إلى بزيع المؤذن.(@)(@@) * وروى عن بشار بن يسار، وروى عنه محمد بن أبي الصهبان.(@)(@@) مشيخة الفقيه: في طريقه إلى بشار بن يسار.(@)(@@) * وروى عن بشير النبال، وروى عنه إبراهيم بن هاشم.(@)(@@) مشيخة الفقيه: في طريقه إلى بشير النبال.(@)(@@) * وروى عن بكار بن كردم، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) مشيخة الفقيه: في طريقه إلى بكار بن كردم.(@)(@@) * وروى عن بندار بن حمار، وروى عنه محمد بن خالد.(@)(@@) مشيخة الفقيه: في طريقه إلى عبد الله بن فضالة.(@)(@@) * وروى عن ثابت بن أبي صفية، وروى أحمد بن عبد الله البرقي، PageV17P412(@)(@@) عن أبيه، عنه.(@)(@@) مشيخة الفقيه: في طريقه إلى النعمان بن سعيد.(@)(@@) * وروى عن ثابت مولى آل حريز، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 54، ح 4.(@)(@@) * وروى عن الجهم بن حميد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 7، ب 36، ح 22.(@)(@@) * وروى عن حارث بياع الأنماط، وروى عنه إبراهيم بن هاشم.(@)(@@) مشيخة الفقيه: في طريقه إلى الحارث بياع الأنماط.(@)(@@) * وروى عن حديد بن حكيم، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 143، ح 1.(@)(@@) * وروى عن حذيفة بن منصور.(@)(@@) الفقيه: ج 2، ح 470. والتهذيب: ج 4، ح 479 
ms5523	 (الاستبصار: ج 2، ح 213).(@)(@@) * وروى أبو علي الأشعري، عن بعض أصحابه، عنه.(@)(@@) الكافي: ج 6، ك 8، ب 6، ح 2.(@)(@@) وروى عنه أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 64، ح 2.(@)(@@) * وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 4، ك 3، ب 48، ح 1.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 91، ذيل ح 1، و ج 4، ك 3، ب 29، ح 6. والتهذيب: ج 5، ح 46 (الاستبصار: ج 2، ح 486).(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 4، ب 5، ح 6، و ج 4، ك 1، ب 27، ح 1، و ج 5، ك 2، ب 53، ح 10. ومشيخة الفقيه: في طريقه إلى حذيفة بن منصور. والتهذيب: ج 7، ح 7.(@)(@@) وروى أحمد بن مهران، عمن حدثه عنه.(@)(@@) الكافي: ج 4، ك 3، ب 17، ح 3.(@)(@@) وروى عنه بكر بن صالح.(@)(@@) التهذيب: ج 10، ح 197 (الاستبصار:(@)(@@) ج 4، ح 828).(@)(@@) وروى عنه الحسن بن الحسين.(@)(@@) الكافي: ج 4، ك 3، ب 29، ح 9.(@)(@@) وروى عنه الحسن بن الحسين اللؤلؤي.(@)(@@) الكافي: ج 4، ك 3، ب 47، ح 7.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 10، ح 509.(@)(@@) وروى عنه سهل بن زياد. PageV17P413(@)(@@) الكافي: ج 6، ك 8، ب 45، ح 14.(@)(@@) وروى عنه صالح بن أبي حماد.(@)(@@) الكافي: ج 5، ك 2، ب 54، ح 19.(@)(@@) والتهذيب: ج 7، ح 24 (الاستبصار:(@)(@@) ج 3، ح 234).(@)(@@) وروى عنه صفوان.(@)(@@) التهذيب: ج 7، ح 565.(@)(@@) وروى عنه العباس بن معروف.(@)(@@) التهذيب: ج 8، ح 919 (الاستبصار:(@)(@@) ج 4، ح 75).(@)(@@) * وروى علي بن إبراهيم، عن بعض أصحابه، عنه.(@)(@@) الكافي: ج 2، ك 1، ب 57، ح 6.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 4، ك 3، ب 236، ح 3.(@)(@@) التهذيب: ج 5، ح 1498 (الاستبصار:(@)(@@) ج 2، ح 1195).(@)(@@) وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 6، ك 8، ب 12، ح 13.(@)(@@) * وروى عن حريز، وروى عنه محمد ابن الحسين.(@)(@@) التهذيب: ج 7، ح 1305 (الاستبصار:(@)(@@) ج 3، ح 709).(@)(@@) * وروى عن الحسن بن رباط، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 5، ح 1. والتهذيب:(@)(@@) ج 1، ح 1290 (الاستبصار: ج 1، ح 126).(@)(@@) * وروى عن الحسن بن السري، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 4، ب 18، ح 26.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 2، ح 232.(@)(@@) * وروى عن الحسن الصيقل، وروى 
ms5524	 عنه محمد بن خالد.(@)(@@) الكافي: ج 6، ك 8، ب 12، ح 8.(@)(@@) * وروى عن الحسين، وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 6، ك 1، ب 9، ح 1. والتهذيب:(@)(@@) ج 7، ح 1743.(@)(@@) * وروى عن الحسين بن المختار، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 184، ح 4.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 4، ك 3، ب 233، ح 2.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) التهذيب: ج 1، ح 1520.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 848، و 1455. PageV17P414(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 8.(@)(@@) وروى عن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 1154.(@)(@@) * وروى عن الحسين بن المنذر، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 9، ح 268 (الاستبصار:(@)(@@) ج 4، ح 301).(@)(@@) * وروى عن الحسين بن نعيم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 4، ب 15، ح 4 1.(@)(@@) * وروى عن الحسين القلانسي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 7، ب 30، ح 3.(@)(@@) * وروى عن الحكم الحناط، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 25، ح 6.(@)(@@) * وروى عن حماد، وروى عنه أحمد ابن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 29، ح 2.(@)(@@) * وروى عن حماد بن أبي طلحة، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 129، ح 3، و ج 2، ك 1، ب 91، ح 1.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 318.(@)(@@) * وروى عن حماد بن أبي طلحة بياع السابري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 25، ح 6.(@)(@@) والتهذيب: ج 6، ح 399.(@)(@@) * وروى عن حماد بن عثمان، وروى عنه إبراهيم بن هاشم.(@)(@@) مشيخة الفقيه: في طريقه إلى عيسى بن يونس.(@)(@@) وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 6، ك 8، ب 27، ح 10.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 102، ح 7.(@)(@@) والتهذيب: ج 3، ح 165، و 868 (الاستبصار: ج 1، ح 1726)، و ج 10، ح 539.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 4، ب 14، ح 1.(@)(@@) والتهذيب: ج 7، ح 1174 (الاستبصار:(@)(@@) ج 3، ح 578)، و 1853، و ج 10، ح 222 (الاستبصار: ج 4، ح 835)، و 519.(@)(@@) وروى عنه سهل بن زياد. 
ms5525	 PageV17P415(@)(@@) الكافي: ج 6، ك 8، ب 41، ح 10.(@)(@@) وروى علي بن الحسن بن فضال، عن رجل، عنه.(@)(@@) التهذيب: ج 9، ح 1022، و 1359 (الاستبصار: ج 4، ح 727).(@)(@@) * وروى عن حمزة بن حمران، وروى عنه محمد بن علي.(@)(@@) الكافي: ج 6، ك 8، ب 66، ح 5.(@)(@@) * وروى عن حمزة بن الطيار، وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الكافي: ج 1، ك 4، ب 6، ذيل ح 2.(@)(@@) * وروى عن حمزة بن محمد الطيار، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 74، ح 1.(@)(@@) * وروى عن خالد بن نافع بياع السابري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 66، ح 18.(@)(@@) * وروى عن خالد القلانسي، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 5، ك 3، ب 146، ح 5.(@)(@@) * وروى عن خلف بن حماد، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 3، ح 165، و 868 (الاستبصار: ج 1، ح 1726).(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1174 (الاستبصار:(@)(@@) ج 3، ح 578)، و 1853، و ج 10، ح 222 (الاستبصار: ج 4، ح 835)، و 519، و 539.(@)(@@) * وروى عن داود بن إسحاق، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) مشيخة الفقيه: في طريقه إلى داود بن إسحاق.(@)(@@) * وروى عن داود بن سرحان، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 3، ب 19، ح 14.(@)(@@) * وروى عن داود بن فرقد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 11.(@)(@@) * وروى عن داود بن كثير الرقي، وروى بعض أصحابنا مرفوعا عنه.(@)(@@) الكافي: ج 1، ك 4، ب 111، ح 39.(@)(@@) * وروى عن داود الرقي، وروى أحمد ابن أبي عبد الله، عن بعض من ذكره عنه.(@)(@@) الكافي: ج 6، ك 8، ب 19، ح 4.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 4، ك 1، ب 20، ذيل ح 3.(@)(@@) وروى عنه الحسن بن علي بن يقطين.(@)(@@) الكافي: ج 4، ك 1، ب 20، ح 3. PageV17P416(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 3.(@)(@@) * وروى عن زياد بن أبي الحلال، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 43، ح 7، وب 66، ح 3.(@)(@@) * وروى عن زياد بن المنذر، وروى عنه 
ms5526	 أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 8، ب 19، ح 5.(@)(@@) * وروى عن زياد بن المنذر أبي الجارود، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 8، ح 72 (الاستبصار: ج 3، ح 941).(@)(@@) * وروى عن زياد بن المنذر أبي الجارود الكوفي، وروى عنه محمد بن علي القرشي الكوفي.(@)(@@) مشيخة الفقيه: في طريقه إلى أبي الجارود.(@)(@@) * وروى عن زياد بن المنذر العبدي أبي الجارود، وروى عنه الحسن بن ابن فضال.(@)(@@) التهذيب: ج 4، ح 462.(@)(@@) * وروى عن زيد الشحام، وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 1، ك 4، ب 2، ح 2. والروضة:(@)(@@) ح 485.(@)(@@) * وروى عن سحيم (سجيم)، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 15.(@)(@@) * وروى عن سعيد النقاش، وروى عنه أبو عبد الله البرقي.(@)(@@) مشيخة الفقيه: في طريقه إلى سعيد النقاش.(@)(@@) * وروى عن سلمة بن محرز، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 22.(@)(@@) * وروى عن سماعة، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 111، ح 24.(@)(@@) * وروى عن صالح بن عقبة، وروى عنه محمد بن خالد.(@)(@@) مشيخة الفقيه: في طريقه إلى صالح بن عقبة.(@)(@@) * وروى عن صباح الأزرق، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 4، ح 382 (الاستبصار:(@)(@@) ج 2، ح 187).(@)(@@) * وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 130، ح 20.(@)(@@) * وروى عن الصباح بن سيابة، PageV17P417(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 2، ك 1، ب 21، ح 4.(@)(@@) * وروى عن طلحة بن زيد.(@)(@@) الفقيه: ج 4، ح 428، و 860.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 115، ح 4، و ب 136، ح 16، و ج 7، ك 3، ب 63، ح 25. والتهذيب: ج 10، ح 232 (الاستبصار: ج 4، ح 845).(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 111، ح 1.(@)(@@) ومشيخة الفقيه: في طريقه إلى طلحة بن زيد.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 45، ح 3، وب 67، ح 7. والتهذيب: ج 3، ح 1002 (الاستبصار: ج 1، ح 1821).(@)(@@) وروى عنه العباس بن معروف.(@)(@@) التهذيب: ج 3، ح 107، و 716.(@)(@@) وروى عنه محمد البرقي.(@)(@@) الكافي: ج 1، ك 2، ب 10، ح 2.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 1، ك 
