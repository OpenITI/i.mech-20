ms321	 الثمانين ومائتين. س.(@)(@@)(@@)(@@) $ 4251 -(@)(@@) عمرو بن يحيى بن سعيد الأموي، عن أبيه، وجده، وعنه الأزرقي أحمد، وسويد، وجماعة، قال ابن معين: صالح. خ ق.(@)(@@)(@@)(@@) $ 4252 -(@)(@@) عمرو بن يحيى بن عمارة بن أبي حسن، عن أبيه، وعباد بن تميم، وعنه مالك، ووهيب، وخلق، ثقة. ع.(@)(@@)(@@)(@@) $ 4253 -(@)(@@) عمرو بن يزيد، أبو بردة التميمي، عن عمرو بن شعيب، وعلقمة بن مرثد، وعنه أحمد بن يونس، وطلق بن غنام، وعدة، ضعفوه. ق.(@)(@@)(@@)(@@) $ 4254 -(@)(@@) عمرو بن يزيد أبو بريد الجرمي، سمع غندرا، وابن مهدي، وعنه النسائي، وأحمد بن عمرو البزار، وعدة، وثق. س.(@)(@@)(@@)(@@) $ 4255 -(@)(@@) عمران بن أنس المكي، عن ابن أبي مليكة، وعطاء، وعنه أبو تميلة، ومصعب بن المقدام، قال البخاري: منكر الحديث. د ت.(@)(@@)(@@)(@@) $ 4256 -(@)(@@) عمران بن أبي أنس العامري، مصري، عن أبي هريرة، وعبد الله بن جعفر، وعنه يونس بن يزيد، والليث، مات 117. م د ت س.(@)(@@)(@@)(@@) $ 4257 -(@)(@@) عمران بن بكار الكلاعي البراد، عن محمد بن حمير، وأحمد بن خالد، الحمصيين، وعنه النسائي، وابن أبي حاتم، وخيثمة، ثقة. س.(@)(@@)(@@)(@@) $ 4258 -(@)(@@) عمران بن الحارث السلمي، عن ابن عباس، وابن عمر، وعنه قتادة، وحصين. م س. PageV02P091(@)(@@)(@@)(@@) $ 4259 -(@)(@@) عمران بن حدير أبو عبيدة السدوسي، عن أبي مجلز، وأبي قلابة، وعنه شعبة، ووكيع، وعثمان ابن عمر، وكان متعبدا، مات 149. م د ت س.(@)(@@)(@@)(@@) $ 4260 -(@)(@@) عمران بن حذيفة، عن ميمونة، وعنه زياد بن عمرو. س ق.(@)(@@)(@@)(@@) $ 4261 -(@)(@@) عمران بن حصين الخزاعي أبو نجيد، أسلم مع أبي هريرة، عنه مطرف بن الشخير، وأخوه، وجماعة، بعثه عمر إلى البصرة ليفقههم، وكانت الملائكة تسلم عليه، مات 52. ع.(@)(@@)(@@)(@@) $ 4262 -(@)(@@) عمران بن حطان السدوسي، عن عمر، وأبي موسى، وجمع، وعنه قتادة، ومحارب بن دثار، وعدة، وثق وكان خارجيا، مدح ابن ملجم. خ د س. PageV02P092(@)(@@)(@@)(@@) $ 4263 -(@)(@@) عمران بن خالد الدمشقي، عن شهاب بن خراش، وعبد العزيز بن محمد، وعنه النسائي، والباغندي، وعدة، ثقة، مات 244. س.(@)(@@)(@@)(@@) $ 4264 -(@)(@@) عمران القطان، أبو العوام ابن داور، عن الحسن، ومحمد، وبكر المزني، وعنه ابن مهدي، وعمرو بن مرزوق، وجمع، 
ms322	 أفتى إبراهيم بن عبد الله بالخروج، ضعفه النسائي، ومشاه أحمد وغيره. 4.(@)(@@)(@@)(@@) $ 4265 -(@)(@@) عمران بن زائدة بن نشيط، عن أبيه، وحسين بن أبي عائشة، وعنه ابن المبارك، وأبو نعيم، وجمع، وثق. د ت ق.(@)(@@)(@@)(@@) $ 4266 -(@)(@@) عمران بن زيد التغلبي، عن زيد العمي، وسعد بن إبراهيم، وعنه أسد بن موسى، وعلي بن الجعد، وعدة، مختلف فيه. ت ق.(@)(@@)(@@)(@@) $ 4267 -(@)(@@) عمران بن طلحة بن عبيد الله، عن أبويه، وعلي، وعنه ابنا أخويه: إبراهيم بن محمد، ومعاوية ابن إسحاق، وثق. د ت ق.(@)(@@)(@@)(@@) $ 4268 -(@)(@@) عمران بن ظبيان الحنفي، عن عدي بن ثابت، وجماعة، وعنه السفيانان، وجماعة، قال البخاري: فيه نظر. س. PageV02P093(@)(@@)(@@)(@@) $ 4269 -(@)(@@) عمران بن عبد المعافري، عن عبد الله بن عمرو، وعنه ابن أنعم الإفريقي، لين. د ق.(@)(@@)(@@)(@@) $ 4270 -(@)(@@) عمران بن عصام أبو عمارة الضبعي، عن رجل، وعنه ابنه أبو جمرة، وقتادة، وثق، قتله الحجاج. ت.(@)(@@)(@@)(@@) $ 4271 -(@)(@@) عمران بن أبي عطاء الواسطي أبو حمزة القصاب، عن ابن عباس، وابن الحنفية، وعنه شعبة، وهشيم، وعدة. م. PageV02P094(@)(@@)(@@)(@@) $ 4272 -(@)(@@) عمران بن عيينة الهلالي، عن أبي إسحاق، وحصين، وعنه الفلاس، وزيد بن الحريش، وجمع، ضعفه أبو زرعة، ومشاه غير واحد. 4.(@)(@@)(@@)(@@) $ 4273 -(@)(@@) عمران بن القاضي محمد بن عبد الرحمن بن أبي ليلى، عن أبيه، وعنه ابنه محمد، وعثمان بن أبي شيبة، وثق. ت ق.(@)(@@)(@@)(@@) $ 4274 -(@)(@@) عمران بن مسلم القصير أبو بكر، عن أبي رجاء العطاردي، وابن سيرين، وعنه القطان، وبشر بن المفضل، وعدة، ثقة. خ م د ت س.(@)(@@)(@@)(@@) $ 4275 -(@)(@@) عمران بن ملحان أبو رجاء العطاردي، أسلم في حياة النبي صلى الله عليه وسلم له، عن عمر، وعلي، وعنه أيوب، وجرير بن حازم، ومهدي بن ميمون، وخلق، عالم عامل نبيل مقرئ معمر مات 107، وقيل 108. ع.(@)(@@)(@@)(@@) $ 4276 -(@)(@@) عمران بن موسى القزاز أبو عمرو البصري، عن حماد، وعبد الوارث، وعنه الترمذي، والنسائي، وابن ماجة، وابن خزيمة، وعدة، ثقة. ت س ق.(@)(@@)(@@)(@@) $ 4277 -(@)(@@) عمران بن موسى الأموي، عن عمر بن عبد العزيز، والمقبري، وعنه ابن جريج، وثق. د ت.(@)(@@)(@@)(@@) $ 4278 -(@)(@@) عمران بن 
ms323	 ميسرة المنقري، عن عبد الوارث، ومعتمر، وعنه البخاري، وأبو داود، وأبو خليفة، وعدة، مات 223. خ د. PageV02P095(@)(@@)(@@)(@@) $ 4279 -(@)(@@) عمران بن نافع، عن حفص بن عبيد الله، وعنه بكير بن الأشج، وثق. س.(@)(@@)(@@)(@@) $ 4280 -(@)(@@) عمران الأنصاري، عن ابن عمر، وعنه ابنه محمد. س.(@)(@@)(@@)(@@) $ 4281 -(@)(@@) عمران البارقي، عن الحسن، وعطية، وعنه الثوري، وثق. د.(@)(@@)(@@)(@@) $ 4282 -(@)(@@) عمير بن إسحاق، عن المقداد، وأبي هريرة، وعنه ابن عون، لينه ابن معين، وقواه غيره. س. PageV02P096(@)(@@)(@@)(@@) $$$ * -(@)(@@) عمير بن حبيب، أرسل حديثا، صوابه: ابن قتادة. ق. [= 4287].(@)(@@)(@@)(@@) $ 4283 -(@)(@@) عمير بن سعد الأوسي الزاهد، له صحبة، عنه ابنه محمود، وأبو إدريس، وجماعة ولي فلسطين لعمر، وكان يسمى: نسيج وحده، قديم الموت. ت.(@)(@@)(@@)(@@) $ 4284 -(@)(@@) عمير بن سعيد النخعي الصهباني، عن علي، وابن مسعود، وعنه الشعبي، والأعمش، وحجاج بن أرطاة، وثقه ابن معين، مات 107. خ م د ق.(@)(@@)(@@)(@@) $ 4285 -(@)(@@) عمير بن سلمة، له صحبة، عنه عيسى بن طلحة. س.(@)(@@)(@@)(@@) $ 4286 -(@)(@@) عمير بن عبد الله الهلالي، عن مولاته أم الفضل، وابن عباس، وعنه سالم أبو النضر، وجماعة، مات 104 بالمدينة. خ م د س.(@)(@@)(@@)(@@) $ 4287 -(@)(@@) عمير بن قتادة، له صحبة، عنه ابنه عبيد. د س ق. PageV02P097(@)(@@)(@@)(@@) $ 4288 -(@)(@@) عمير بن مأموم الدارمي، عن ابن الزبير، وغيره، وعنه سالم بن أبي الجعد، وسعد الإسكاف، وثق. ت.(@)(@@)(@@)(@@) $ 4289 -(@)(@@) عمير بن هانئ العنسي الداراني، عن أبي هريرة، وابن عمر، والكبار، وعنه الأوزاعي، ومعاوية ابن صالح، وغيره، وكان يسبح في اليوم مائة ألف، ذبح صبرا بداريا لحطه على يزيد الناقص 127.(@)(@@) وقال دحيم: بل المذبوح ابنه. ع.(@)(@@)(@@)(@@) $ 4290 -(@)(@@) عمير بن يزيد أبو جعفر الخطمي، عن ابن المسيب، وأبي أمامة بن سهل، وعنه شعبة، والقطان، وعدة، ثقة. 4.(@)(@@)(@@)(@@) $ 4291 -(@)(@@) عمير، مولى آبي اللحم، له صحبة، عنه محمد بن إبراهيم التيمي، ويزيد بن أبي عبيد، وجمع.(@)(@@) م 4.(@)(@@)(@@)(@@) $ 4292 -(@)(@@) عمير، عن مولاه ابن مسعود، وعنه ابنه، وحفيده إسحاق بن إبراهيم، وثق. ق.(@)(@@)(@@)(@@) $ 4293 -(@)(@@) عمير، عن مولاه عمر، وعنه عاصم بن عمرو، وثق. ق.(@)(@@)(@@)(@@) $ 4294 -(@)(@@) عميرة بن أبي ناجية، مصري، عن يزيد بن أبي حبيب، 
ms324	 وعدة، وعنه بكر بن مضر، وابن وهب، وعدة، وثق، عابد بكاء، مات 153. س. PageV02P098(@)(@@)(@@)(@@) $ 4295 -(@)(@@) عنبسة بن الأزهر الكوفي، قاضي جرجان، عن محارب بن دثار، والسدي، وعنه أحمد بن أبي طيبة، وسفيان بن وكيع، وجمع، قال أبو حاتم: لا بأس به وليس بحجة. س.(@)(@@)(@@)(@@) $ 4296 -(@)(@@) عنبسة بن خالد الأيلي، عن عمه يونس، وابن جريج، وعنه أحمد بن صالح، وجماعة، مات 198. خ مقرونا د.(@)(@@)(@@)(@@) $ 4297 -(@)(@@) عنبسة بن سعيد الكوفي ثم الرازي، قاضي الري، عن زبيد اليامي، وسماك، وعنه ابن المبارك، وزيد بن الحباب وعدة، وثقوه. ت س.(@)(@@)(@@)(@@) $ 4298 -(@)(@@) عنبسة بن سعيد بن العاص الأموي، أخو الأشدق، عن أبي هريرة، وأنس، وعنه الزهري، ومحمد بن عمرو بن علقمة، وعدة، وثقوه. خ م د.(@)(@@)(@@)(@@) $ 4299 -(@)(@@) عنبسة بن سعيد، مولى عثمان، عن جدته أم عياش، وعنه ابنه روح. ق. PageV02P099(@)(@@)(@@)(@@) $ 4300 -(@)(@@) عنبسة بن سعيد الكوفي الحاسب، عن جده كثير رضيع عائشة، وعنه حفيده إسماعيل بن صديق، وابن مهدي، وأبو الوليد، وثقوه. د.(@)(@@)(@@)(@@) $ 4301 -(@)(@@) عنبسة بن سعيد الواسطي، عن شهر، والحسن، وعنه عبد الوهاب الثقفي، وغيره، ضعفوه. د.(@)(@@)(@@)(@@) $ 4302 -(@)(@@) عنبسة بن أبي سفيان بن حرب، عن أخته أم حبيبة، وشداد بن أوس، وعنه أبو صالح السمان، وعطاء، وآخرون، حج بالناس سنة سبع وأربعين. م 4.(@)(@@)(@@)(@@) $ 4303 -(@)(@@) عنبسة بن عبد الرحمن بن عنبسة الأموي، عن ابن المنكدر، وجماعة، وعنه إسحاق بن أبي إسرائيل، وعبد الواحد بن غياث، وجمع، قال البخاري: تركوه. ت ق.(@)(@@)(@@)(@@) $ 4304 -(@)(@@) عنبسة بن عبد الواحد أبو خالد الأموي، عن هشام بن عروة، وطبقته، وعنه أبو عبيد، وسريج بن يونس، وعدة ثقة، يعد من الأبدال. د.(@)(@@)(@@)(@@) $ 4305 -(@)(@@) عنترة بن عبد الرحمن، عن عمر، وعلي، وعنه ابنه هارون، وأبو سنان الشيباني، وثق. س.(@)(@@)(@@)(@@) $ 4306 -(@)(@@) العوام بن حوشب الواسطي، أحد الأعلام، عن إبراهيم، ومجاهد، والطبقة، وعنه شعبة، ويزيد ابن هارون، وخلق، وثقوه له نحو مائتي حديث، توفي 148. ع.(@)(@@)(@@)(@@) $ 4307 -(@)(@@) العوام بن عباد بن العوام، حكى عنه الذهلي. ق. PageV02P100(@)(@@)(@@)(@@) $ 4308 -(@)(@@) عوسجة، عن ابن عباس مولاه، وعنه عمرو بن دينار، وثق، 
ms325	 وقال البخاري: لم يصح حديثه. 4.(@)(@@)(@@)(@@) $ 4309 -(@)(@@) عوف الأعرابي، عن أبي العالية، والنهدي، والعطاردي، وعنه القطان، وغندر، وهوذة، وعثمان ابن الهيثم، قال النسائي: ثقة ثبت، توفي 147. ع.(@)(@@)(@@)(@@) $ 4310 -(@)(@@) عوف بن الحارث الأزدي، عن عمته عائشة، وعدة، وعنه هشام بن عروة، ومحصن بن علي وجماعة، وثق. خ د س ق.(@)(@@)(@@)(@@) $ 4311 -(@)(@@) عوف بن مالك الأشجعي، حمل راية قومه يوم الفتح، عنه جبير بن نفير، والشعبي، وعدة، مات 73. ع.(@)(@@)(@@)(@@) $ 4312 -(@)(@@) عوف بن مالك أبو الأحوص الجشمي، عن ابن مسعود، وأبي موسى، وعنه ابن أخيه أبو الزعراء، وأبو إسحاق، وخلق، وثقوه، قتلته الخوارج. م 4.(@)(@@)(@@)(@@) $ 4313 -(@)(@@) عون بن أبي جحيفة، عن أبيه، وجماعة، وعنه شعبة، وسفيان، وعدة، وثقوه. ع.(@)(@@)(@@)(@@) $ 4314 -(@)(@@) عون بن سلام، مولى بني هاشم، عن أبي بكر النهشلي، وإسرائيل، وعدة، وعنه مسلم، ومطين، وجمع، مات 230. م.(@)(@@)(@@)(@@) $ 4315 -(@)(@@) عون بن أبي شداد، عن أنس، ومطرف بن الشخير، وجماعة، وعنه فطر، ونوح بن قيس، وعدة، اختلف فيه. ق. PageV02P101(@)(@@)(@@)(@@) $ 4316 -(@)(@@) عون بن صالح البارقي، عن عطية، وجماعة، وعنه ابن المبارك، ووكيع. س.(@)(@@)(@@)(@@) $ 4317 -(@)(@@) عون بن عبد الله بن عتبة الهذلي الزاهد الفقيه، أخو الفقيه عبيد الله، عن أبي هريرة، وابن عباس، وجمع، وعنه الزهري، وأبو حنيفة، وأبو العميس، حديثه عن عمر في مسلم ولم يلحقه، مات في حدود العشرين ومائة، لأن ابن عيينة رآه، يقال: غالب رواياته عن الصحابة مرسلة. م 4.(@)(@@)(@@)(@@) $ 4318 -(@)(@@) عون بن عمارة العبدي، عن حميد، والتيمي، وعنه أبو قلابة عبد الملك، وعباس الدوري، والحارث، ضعفوه، مات 212. ق.(@)(@@)(@@)(@@) $ 4319 -(@)(@@) عون بن كهمس، عن أبيه، والتيمي، وهشام بن حسان، وعنه ابن مثنى، وبندار، وعدة، ثقة. د.(@)(@@)(@@)(@@) $ 4320 -(@)(@@) عويم بن ساعدة، صحابي عقبي، عنه ابنه عتبة. ق. PageV02P102(@)(@@)(@@)(@@) $ 4321 -(@)(@@) عويمر بن أشقر، بدري، عنه عباد بن تميم، ويحيى بن أبي سعيد. ق.(@)(@@)(@@)(@@) $ 4322 -(@)(@@) عويمر أبو الدرداء بن مالك، وقيل: ابن عامر. وقيل ابن ثعلبة، أسلم عقيب بدر، عنه ابنه بلال، وزوجته أم الدرداء، وجبير بن نفير، وأبو إدريس، فرض له عمر فألحقه بالبدريين لجلالته، مات 32. ع.(@)(@@)(@@)(@@) $ 4323 
ms326	 -(@)(@@) العلاء بن بشير، عن أبي الصديق الناجي، وعنه معلى بن زياد. د.(@)(@@)(@@)(@@) $ 4324 -(@)(@@) العلاء بن الحارث الحضرمي الدمشقي الفقيه، عن أبي الأشعث الصنعاني، ومكحول، وعدة، وعنه الأوزاعي، والهيثم بن حميد، ويحيى بن حمزة، وثقوه، قدري، قال دحيم: مقدم على أصحاب مكحول، وقال أبو داود: ثقة تغير عقله، مات 136. م 4.(@)(@@)(@@)(@@) $ 4325 -(@)(@@) العلاء بن الحضرمي، حليف بني أمية، صحابي له عشرة إخوة، روى عنه أبو هريرة، وغيره، ولي البحرين فأقره الصديق، توفي 21. ع.(@)(@@)(@@)(@@) $ 4326 -(@)(@@) العلاء بن أبي حكيم، سياف معاوية، عنه الوليد بن أبي الوليد، وثق. ت س.(@)(@@)(@@)(@@) $ 4327 -(@)(@@) العلاء بن خالد، عن أخيه ربعي، والحسن، وعنه مسدد، وقتيبة، وجمع، لين. ت.(@)(@@)(@@)(@@) $ 4328 -(@)(@@) العلاء بن خالد الكاهلي، عن أبي وائل، وعنه سفيان، وحفص بن غياث، صدوق. م ت.(@)(@@)(@@)(@@) $ 4329 -(@)(@@) العلاء بن زهير الأزدي، عن عبد الرحمن بن الأسود، وعنه وكيع، والفريابي، وعدة، وثق. س.(@)(@@)(@@)(@@) $ 4330 -(@)(@@) العلاء بن زياد أبو نصر العدوي، أرسل، وعنه قتادة، ومطر الوراق، وهشام بن حسان، وكان PageV02P103(@)(@@) عابدا قانتا بكاء، وله، عن أبي هريرة، مات 94. س ق.(@)(@@) قلت:(@)(@@)(@@)(@@) $ 4331 -(@)(@@) والعلاء بن زياد، آخر، له، عن الحسن، وعنه حماد بن زيد. خلطهما شيخنا المزي. س.(@)(@@)(@@)(@@) $ 4332 -(@)(@@) العلاء بن زيد، ويقال ابن زيدل، أبو محمد الثقفي، عن أنس، وشهر، وعنه يزيد بن هارون وجماعة، تركه أبو داود، وغيره. ق.(@)(@@)(@@)(@@) $ 4333 -(@)(@@) العلاء بن سالم الحذاء، عن أبي معاوية، وشعيب بن حرب، وعنه ابن ماجة، وابن صاعد، وابن مخلد، وسط، مات 258. ق.(@)(@@)(@@)(@@) $ 4334 -(@)(@@) العلاء بن صالح، عن عدي بن ثابت، والحكم، وعنه أبو نعيم، وعبيد الله بن موسى، ثقة يغرب. د ت س ق.(@)(@@)(@@)(@@) $ 4335 -(@)(@@) العلاء بن عبد الله بن رافع، عن سعيد بن جبير، وغيره، وعنه ابن علاثة، وأبو سعيد المؤدب، وعدة. د س.(@)(@@)(@@)(@@) $ 4336 -(@)(@@) العلاء بن عبد الجبار العطار، بصري جاور، سمع مبارك بن فضالة، وطبقته، وعنه البخاري، وابن أبي مسرة، وبشر بن موسى، مات 212. خ ت ق. PageV02P104(@)(@@)(@@)(@@) $ 4337 -(@)(@@) العلاء بن عبد الرحمن أبو شبل مولى الحرقة، أحد علماء المدينة، عن 
ms327	 أبيه، ومعبد بن كعب، وعنه شعبة، ومالك، وخلق، قال أبو حاتم: صالح، أنكر من حديثه أشياء، مات في أول دولة المنصور. م 4.(@)(@@)(@@)(@@) $ 4338 -(@)(@@) العلاء بن عتبة الحمصي، عن خالد بن معدان، وعمير بن هانئ، وعنه الأوزاعي، وعبد الله بن سالم، قال أبو حاتم: صالح. د.(@)(@@)(@@)(@@) $ 4339 -(@)(@@) العلاء بن عصيم، كوفي، عن زهير بن معاوية، وجماعة، وعنه ابن المديني، والدارمي، وثق، مات 238. س.(@)(@@)(@@)(@@) $ 4340 -(@)(@@) العلاء بن غرار، عن ابن عمر، وعنه أبو إسحاق.(@)(@@)(@@)(@@) $ 4341 -(@)(@@) العلاء بن الفضل أبو الهذيل المنقري، عن أبيه، وعبيد الله بن عكراش، وعنه بندار، وإسماعيل القاضي، فيه ضعف، مات 220. ت ق. PageV02P105(@)(@@)(@@)(@@) $ 4342 -(@)(@@) العلاء بن اللجلاج، عن أبيه، وابن عمر، وعنه ابنه عبد الرحمن، وغيره. وثق. ت.(@)(@@)(@@)(@@) $ 4343 -(@)(@@) العلاء بن مسلمة الرواس البغدادي، عن ضمرة، وعلي بن عاصم، وعنه الترمذي، وابن صاعد، وعدة، اتهم. ت.(@)(@@)(@@)(@@) $ 4344 -(@)(@@) العلاء بن المسيب بن رافع الأسدي، عن أبيه، وإبراهيم، وخيثمة بن عبد الرحمن، وعنه جرير، وابن فضيل، وعدة، وثق، قال أبو حاتم: صالح الحديث. خ م د س ق.(@)(@@)(@@)(@@) $ 4345 -(@)(@@) العلاء بن هلال بن عمر الرقي، عن حماد، وخلف بن خليفة، وعنه ابنه هلال، ومحمد بن جبلة الرافقي، وعدة، ضعفه أبو حاتم، مات 215. س.(@)(@@)(@@)(@@) $ 4346 -(@)(@@) العلاء بن أخي شعيب الرازي، عن فلان، وعنه شعبة، وثق. د.(@)(@@)(@@)(@@) $$$ * -(@)(@@) العلاء الجريري، عن عمرو بن شعيب، وعنه همام، والأصح: عباس الجريري. س. [= 2607].(@)(@@)(@@)(@@) $ 4347 -(@)(@@) العلاء، عن داود، وعنه أبو عبد الرحيم الحراني. س.(@)(@@)(@@)(@@) $ 4348 -(@)(@@) علاج بن عمرو، عن ابن عمر، وعنه أشعث بن سليم، وغيره، وثق. د.(@)(@@)(@@)(@@) $ 4349 -(@)(@@) علاق بن أبي مسلم، عن جابر، وابن الحنفية، وعنه عنبسة بن عبد الرحمن، واه. ق. PageV02P106(@)(@@)(@@)(@@) $ 4350 -(@)(@@) علاقة التميمي، له صحبة، قال الشعبي: عن خارجة بن الصلت، عن عمه، فقال البغوي: هو علاقة بن صحار، وقال خليفة: عبد الله بن عثير. د س.(@)(@@)(@@)(@@) $ 4351 -(@)(@@) عياش بن الأزرق، أو الأزرق، عن ابن وهب، وعنه أبو داود، والفريابي، وثق. د.(@)(@@)(@@)(@@) $ 4352 -(@)(@@) عياش بن أبي ربيعة المخزومي، من المهاجرين، عنه أنس، وجماعة، قتل 
ms328	 يوم اليرموك، أو اليمامة. ق.(@)(@@)(@@)(@@) $ 4353 -(@)(@@) عياش بن عباس القتباني، عن أبي سلمة، ومرثد اليزني، وعنه ابنه عبد الله، والليث، ومفضل بن فضالة، وعدة، وثق، مات 133. م 4.(@)(@@)(@@)(@@) $ 4354 -(@)(@@) عياش بن عقبة الحضرمي، عن خير بن نعيم، وجماعة، وعنه ابن المبارك، والمقرئ، وجمع، وثق، مات 160. د س.(@)(@@)(@@)(@@) $ 4355 -(@)(@@) عياش بن عمرو العامري الكوفي، عن ابن أبي أوفى، وإبراهيم التيمي، وعنه سفيان، وشعبة، وثق. م س.(@)(@@)(@@)(@@) $ 4356 -(@)(@@) عياش بن الوليد الرقام، عن معتمر، والوليد بن مسلم، وعنه البخاري، وأبو داود، وأبو زرعة، وعدة، مات 226. خ د.(@)(@@)(@@)(@@) $ 4357 -(@)(@@) عياض بن حمار، تميمي، له وفادة، نزل البصرة، عنه مطرف، ويزيد ابنا الشخير، والحسن. م 4.(@)(@@)(@@)(@@) $ 4358 -(@)(@@) عياض بن عبد الله بن سعد بن أبي سرح العامري، عن أبي هريرة، وصحابة، وعنه داود بن قيس، وابن عجلان، وعدة. ع.(@)(@@)(@@)(@@) $ 4359 -(@)(@@) عياض بن عبد الله الفهري، عن الزهري، وأبي الزبير، وعنه الليث، وابن وهب، وثق، وقال أبو حاتم: ليس بقوي. م د س ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) عياض بن عروة، ويقال بالقلب، عن عائشة، وعنه عبد الله بن عبيد بن عمير، س. [= 3779]. PageV02P107(@)(@@)(@@)(@@) $ 4360 -(@)(@@) عياض بن عمرو الأشعري، مختلف في صحبته، عنه الشعبي، وحصين، قال أبو حاتم: تابعي أرسل. م ق.(@)(@@) * عياض بن غطيف، عن أبي عبيدة، وعنه سليم بن عامر، وغيره. س. [= 4427].(@)(@@)(@@)(@@) $ 4361 -(@)(@@) عياض بن هلال، وقيل بالقلب، عن أبي سعيد، وعنه يحيى بن أبي كثير. 4.(@)(@@)(@@)(@@) $ 4362 -(@)(@@) عياض البجلي، عن معقل بن يسار، وعنه شعبة، وثق. س.(@)(@@)(@@)(@@) $ 4363 -(@)(@@) العيزار بن حريث العبدي، عن الحسين، وابن عباس، وعنه ابنه الوليد، وأبو إسحاق، ويونس بن أبي إسحاق، وعدة، وثقوه. م د ت س.(@)(@@)(@@)(@@) $ 4364 -(@)(@@) عيسى بن إبراهيم البركي، مولى بني هاشم، عن حماد بن سلمة، وعبد العزيز بن مسلم، وعنه أبو داود، وأحمد الأبار، ومحمد البوشنجي، وعدة، وثق، مات 228. د.(@)(@@)(@@)(@@) $ 4365 -(@)(@@) عيسى بن إبراهيم بن مثرود أبو موسى الغافقي، عن ابن عيينة، وابن وهب، وعنه أبو داود، والنسائي، وابن خزيمة، وأبو بكر بن زياد، وخلق، ثقة، مات 261. د س.(@)(@@)(@@)(@@) $ 4366 -(@)(@@) عيسى بن 
ms329	 أحمد العسقلاني البلخي، عن بقية، وابن وهب، وعنه الترمذي، والنسائي، وأبو عوانة، والهيثم بن كليب، وثقه النسائي، مات 268. ت س.(@)(@@)(@@)(@@) $ 4367 -(@)(@@) عيسى بن أيوب القيني الدمشقي، عن مكحول، وعنه الوليد، وأبو مسهر. د. PageV02P108(@)(@@)(@@)(@@) $ 4368 -(@)(@@) عيسى بن جارية الأنصاري، عن جرير، وجابر، وعنه أبو صخر حميد بن زياد، ويعقوب القمي، مختلف فيه، قال ابن معين: عنده مناكير. ق.(@)(@@)(@@)(@@) $ 4369 -(@)(@@) عيسى بن حطان الرقاشي، عن علي، وعبد الله بن عمرو، وعنه ابن جدعان، وابن جحادة، وثق. د ت س.(@)(@@)(@@)(@@) $ 4370 -(@)(@@) عيسى بن حفص بن عاصم العدوي، لقبه رباح، عن أبيه، وابن المسيب، وعنه القطان، والقعنبي، وآخرون، وثقوه، مات 159. خ م د س ق.(@)(@@)(@@)(@@) $ 4371 -(@)(@@) عيسى بن حماد زغبة، عن الليث، وعبد الرحمن بن زيد بن أسلم، وجمع، وعنه مسلم، وأبو داود، والنسائي، وابن ماجة، وابن أبي داود، وأحمد بن عيسى الوشاء. قال أبو حاتم: ثقة رضا، مات 248 في ذي الحجة. م د س ق.(@)(@@)(@@)(@@) $ 4372 -(@)(@@) عيسى بن دينار الخزاعي، عن أبيه، والباقر، وعنه، وكيع، ومحمد بن سابق، وعدة، وثقه ابن معين. د ت.(@)(@@)(@@)(@@) $ 4373 -(@)(@@) عيسى بن سليم أبو حمزة الرستني، عن راشد بن سعد، وجماعة، وعنه بقية، وعيسى بن يونس، وعدة، وثق. م س. PageV02P109(@)(@@)(@@)(@@) $ 4374 -(@)(@@) عيسى بن سنان الحنفي أبو سنان القسملي الفلسطيني، حدث بالبصرة، عن يعلى بن شداد بن أوس، ووهب، وعنه عيسى بن يونس، وأبو أسامة، وجمع، ضعف ولم يترك. ت ق.(@)(@@)(@@)(@@) $ 4375 -(@)(@@) عيسى بن سهل، عن جده رافع بن خديج، وعنه موسى بن عبيدة، وسعيد بن يزيد القتباني، وثق، ومن سماه عثمان: وهم. س.(@)(@@)(@@)(@@) $ 4376 -(@)(@@) عيسى بن شاذان البصري القطان الحافظ، عن أبي الوليد، وعارم، وعنه أبو داود، وابن صاعد، وخلق، مات شابا. د.(@)(@@)(@@)(@@) $ 4377 -(@)(@@) عيسى بن طلحة بن عبيد الله، من الحكماء العقلاء، عن أبي هريرة، وأبيه، وعائشة، وعنه الزهري، ويزيد بن أبي حبيب، وعدة، مات سنة مائة ظنا. ع.(@)(@@)(@@)(@@) $ 4378 -(@)(@@) عيسى بن طهمان، بصري نزل الكوفة، سمع أنسا، وناسا، وعنه يحيى بن آدم، وقبيصة، وعدة، ثقة. 
ms330	 خ س.(@)(@@)(@@)(@@) $ 4379 -(@)(@@) عيسى بن عاصم الأسدي، عن زر، وشريح، وعنه معاوية بن صالح، وثور، وغيرهما، وثق.(@)(@@) د ت ق.(@)(@@)(@@)(@@) $ 4380 -(@)(@@) عيسى بن عبد الله بن أنيس الأنصاري، عن أبيه، وعنه عبيد الله بن عمر، وأخوه عبد الله، وثق.(@)(@@) د ت.(@)(@@)(@@)(@@) $ 4381 -(@)(@@) عيسى بن عبد الله بن مالك الدار، عن زيد بن وهب، وغيره، وعنه فليح، وابن لهيعة، وعدة، وثق. د ق.(@)(@@)(@@)(@@) $ 4382 -(@)(@@) عيسى بن عبد الأعلى الفروي، عن إسحاق بن عبد الله بن أبي طلحة، وغيره، وعنه الوليد بن مسلم. د ق. PageV02P110(@)(@@)(@@)(@@) $ 4383 -(@)(@@) عيسى بن عبد الرحمن الزرقي، عن الزهري، وزيد بن أسلم، وعنه الوليد بن مسلم، والطيالسي، واه. ق.(@)(@@)(@@)(@@) $ 4384 -(@)(@@) عيسى بن عبد الرحمن بن أبي ليلى، عن أبيه، وعبد الله بن حكيم، وعنه أخوه محمد، وابنه عبد الله، وثقوه. د ت ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) عيسى بن عبد الرحمن السلمي أبو سلمة، عن الشعبي، والحسن، وعنه يحيى بن آدم، وعفان، ثقة. بخ قد عس.(@)(@@)(@@)(@@) $ 4385 -(@)(@@) عيسى بن عبيد الكندي أبو المنيب المروزي، عن أبي مجلز، وابن بريدة، وعنه عبدان، ونعيم ابن حماد، وعدة، قال أبو زرعة: لا بأس به. د ت س.(@)(@@)(@@)(@@) $ 4386 -(@)(@@) عيسى بن عثمان النهشلي الكوفي، عن عمه يحيى بن عيسى، وعنه الترمذي، وابن جرير، وابن أبي داود، مات 251. ت.(@)(@@)(@@)(@@) $ 4387 -(@)(@@) عيسى بن أبي عزة، عن الشعبي، وعنه سفيان، وإسرائيل، وثقوه. ت س.(@)(@@)(@@)(@@) $ 4388 -(@)(@@) عيسى بن علي العباسي، صاحب نهر عيسى، عن أبيه، وعنه الرشيد، وشيبان النحوي، وعدة، لم يل عملا، قال ابن معين: ليس به بأس، مات 160، وقيل بعدها. د ت.(@)(@@)(@@)(@@) $ 4389 -(@)(@@) عيسى بن عمر بن موسى التيمي، عن نافع، وعنه ابن المبارك، وجماعة، وثق. ق.(@)(@@)(@@)(@@) $ 4390 -(@)(@@) عيسى بن عمر الأسدي الكوفي، المقرئ، صاحب الحروف، ويعرف بالهمداني - لا عيسى بن PageV02P111(@)(@@) عمر البصري الثقفي صاحب النحو - عن عطاء، وعمرو بن مرة، والمسيب بن عبد خير، وعنه الفريابي، وعبيد الله، وخلاد بن يحيى، وخلق، قال أحمد: ليس به بأس، مات 156. ت س.(@)(@@)(@@)(@@) $ 4391 -(@)(@@) عيسى بن عمر، عن عبد الله 
ms331	 بن علقمة، وعنه عمرو بن يحيى. س.(@)(@@)(@@)(@@) $ 4392 -(@)(@@) عيسى بن أبي عيسى الحناط، عن أبيه، وأنس، والشعبي، وعنه وكيع، وابن أبي فديك، وعدة، ضعفوه، وهو كوفي سكن المدينة، وكان خياطا أيضا، وباع في الخبط، مات 151. ق.(@)(@@)(@@)(@@) $ 4393 -(@)(@@) عيسى بن أبي عيسى السليحي الحمصي، عن إسماعيل بن عياش، ومحمد بن حمير، وعنه أبو داود، والنسائي، وأبو عروبة، وابن أبي داود، وثق. د س.(@)(@@)(@@)(@@) $ 4394 -(@)(@@) عيسى بن فائد تابعي، عنه يزيد بن أبي زياد، لم يدرك سعد بن عبادة. د.(@)(@@)(@@)(@@) $ 4395 -(@)(@@) عيسى بن محمد أبو عمير ابن النحاس الرملي، عن ابن عيينة، والوليد، وعنه أبو داود، والنسائي، وابن ماجة، وابن أبي داود، والدولابي، وعدة، حافظ عابد فقير، مات 256. د س ق.(@)(@@)(@@)(@@) $ 4396 -(@)(@@) عيسى بن المختار، عن طلحة بن مصرف، ونحوه، وعنه ابن عمه بكر بن عبد الرحمن. د س ق.(@)(@@)(@@)(@@) $ 4397 -(@)(@@) عيسى بن مساور البغدادي الجوهري، عن يغنم، والوليد بن مسلم، وعنه النسائي، وأبو حامد الحضرمي، وعدة، مات 244. س.(@)(@@)(@@)(@@) $ 4398 -(@)(@@) عيسى بن معقل، عن جدته أم معقل الأسدية، وغيرها، وعنه موسى بن عقبة، وابن إسحاق، وثق. د. PageV02P112(@)(@@)(@@)(@@) $ 4399 -(@)(@@) عيسى بن معمر، عن عبد الله بن عمرو بن الفغواء، وغيره، وعنه مصعب بن ثابت، وابن إسحاق، ضعف. د.(@)(@@)(@@)(@@) $ 4400 -(@)(@@) عيسى بن المنذر الحمصي السلمي، عن إسماعيل بن عياش، وبقية، وعنه ابنه موسى، وابن واره، والكوسج، وثق. م.(@)(@@)(@@)(@@) $ 4401 -(@)(@@) عيسى بن موسى غنجار أبو أحمد الأزرق، محدث بخاري، عن مقاتل بن حيان، وعيسى بن عبيد، والثوري، وعنه محمد بن سلام، ومحمد بن أمية الساوي، وعدة، صدوق لكنه روى عن مائة مجهول. مات 186. خت ق.(@)(@@)(@@)(@@) $ 4402 -(@)(@@) عيسى، أخو سليمان بن موسى الدمشقي، عن ربيعة بن يزيد، وجماعة، وعنه الوليد بن مسلم، وعمرو بن أبي سلمة، وثقه دحيم. د ق.(@)(@@)(@@)(@@) $ 4403 -(@)(@@) عيسى بن ميمون المدني، عن القاسم، وسالم، وعنه حجاج بن محمد، وآدم، وشيبان بن فروخ، ضعفوه. ت ق.(@)(@@)(@@)(@@) $ 4404 -(@)(@@) عيسى بن نميلة الفزاري، عن أبيه، وعنه الدراوردي، وثق. د.(@)(@@)(@@)(@@) $ 4405 -(@)(@@) عيسى بن هلال الصدفي، عن 
ms332	 عبد الله بن عمرو، وعنه دراج أبو السمح، وكعب بن علقمة، وجماعة، وثق. د ت س.(@)(@@)(@@)(@@) $ 4406 -(@)(@@) عيسى بن يزداد اليماني، عن أبيه، وعنه زكريا بن إسحاق، وزمعة، قال البخاري: لا يصح حديثه. ق. PageV02P113(@)(@@)(@@)(@@) $ 4407 -(@)(@@) عيسى بن يزيد الأزرق أبو معاذ المروزي، عن أبي إسحاق، ومطر الوراق، وعنه ابن المبارك، وأبو تميلة، وعدة، وثق. س ق.(@)(@@)(@@)(@@) $ 4408 -(@)(@@) عيسى بن يونس الرملي الفاخوري، عن الوليد، وضمرة، وعنه النسائي، وابن ماجة، وابن أبي داود، وعبد الله ابن الزفتي، وخلق، وثقوه، مات 264. س ق.(@)(@@)(@@)(@@) $ 4409 -(@)(@@) عيسى بن يونس بن أبي إسحاق، أحد الأعلام في الحفظ، والعبادة، عن أبيه، وهشام بن عروة، والأعمش، وعنه حماد بن سلمة مع تقدمه، وابن المديني، وإسحاق، وابن عرفة، وأمم، كان يحج سنة ويغزو سنة، مات 187. ع.(@)(@@)(@@)(@@) $ 4410 -(@)(@@) عيسى بن يونس الطرسوسي، عن حجاج بن محمد، وعنه أبو داود. د.(@)(@@)(@@)(@@) $ 4411 -(@)(@@) عيينة بن عبد الرحمن بن جوشن الغطفاني، عن أبيه، ونافع، وعنه وكيع، والقطان، ومكي، والمقرئ، وثقه النسائي، وقال أبو حاتم: صدوق، ووثقه ابن معين. 4. PageV02P114(@)(@@)(@@)(@@) | حرف الغين (@)(@@)(@@)(@@) $ 4412 -(@)(@@) غالب بن أبجز، وقيل ابن ذريح، المزني، له صحبة، وعنه خالد بن سعد، وعبد الله بن معقل. د.(@)(@@)(@@)(@@) $ 4413 -(@)(@@) غالب بن حجرة، عن عمه ملقام، وعنه حرمي بن حفص، وموسى بن إسماعيل، وغيرهما. د.(@)(@@)(@@)(@@) $ 4414 -(@)(@@) غالب القطان، عن سعيد بن جبير، والحسن، وعنه شعبة، وابن علية، وطائفة، ثقة. ع.(@)(@@)(@@)(@@) $ 4415 -(@)(@@) غالب بن مهران التمار، عن الشعبي، وجماعة، وعنه شعبة، وابن علية، وجماعة، صالح الحديث. د س ق.(@)(@@)(@@)(@@) $ 4416 -(@)(@@) غالب بن نجيح، عن أيوب بن عائذ، وأبي صخرة جامع، وعنه أبو أحمد الزبيري، وعبيد الله. ت.(@)(@@)(@@)(@@) $ 4417 -(@)(@@) غالب بن الهذيل، عن أنس، وسعيد بن جبير، وعنه سفيان، وإسرائيل، وشريك، صدوق. س.(@)(@@)(@@)(@@) $ 4418 -(@)(@@) غرفة بن الحارث الكندي، شهد حجة الوداع، عنه عبد الله بن الحارث الأزدي، وكعب بن علقمة. د. PageV02P115(@)(@@)(@@)(@@) $ 4419 -(@)(@@) الغريف بن عياش بن فيروز الديلمي، عن جده، وواثلة، وعنه إبراهيم بن أبي عبلة، وثق. د س.(@)(@@)(@@)(@@) $ 4420 -(@)(@@) غزوان بن جرير الضبي، 
ms333	 عن علي، وعنه عبد السلام، وأخضر بن عجلان، وثق، وهو والد فضيل. د.(@)(@@)(@@)(@@) $ 4421 -(@)(@@) غزوان أبو مالك الغفاري، عن ابن عباس، والبراء، وعنه السدي، وحصين، ثقة، قاله ابن معين.(@)(@@) د ت س.(@)(@@)(@@)(@@) $ 4422 -(@)(@@) غزوان، عن مقعد بتبوك، وعنه ابنه سعيد. د.(@)(@@)(@@)(@@) $ 4423 -(@)(@@) غسان بن الأغر النهشلي، عن عمه زياد، وعنه بهز بن أسد، وحبان، وجماعة، وثق. س.(@)(@@)(@@)(@@) $ 4424 -(@)(@@) غسان بن برزين الطهوي، عن ثابت، وعدة، وعنه عفان، ومسدد، وثقوه. ق.(@)(@@)(@@)(@@) $ 4425 -(@)(@@) غسان بن عوف المازني، عن الجريري، وعنه أحمد بن عبيد الله الغداني، وغيره، غير حجة. د.(@)(@@)(@@)(@@) $ 4426 -(@)(@@) غسان بن مضر، عن أبي مسلمة سعيد بن يزيد فقط، وعنه أحمد، وابنا أبي شيبة، وخلق، وثقوه، مات 184. س.(@)(@@)(@@)(@@) $ 4427 -(@)(@@) غضيف - وقيل: غطيف - بن الحارث الحمصي، مختلف في صحبته، عن عمر، وبلال، وعنه مكحول، وابن عائذ، وسليم بن عامر، وعدة. د س ق. PageV02P116(@)(@@)(@@)(@@) $ 4428 -(@)(@@) غضيف بن أبي سفيان الطائفي، ويقال غطيف، عن عمرو بن أوس، وجماعة، وعنه سعيد بن السائب، وعمرو بن وهب، وثق. س.(@)(@@)(@@)(@@) $ 4429 -(@)(@@) غطيف بن أعين الجزري، وقيل غضيف، عن مصعب بن سعد، وعنه عبد السلام بن حرب، وغيره، لينه بعضهم. ت.(@)(@@)(@@)(@@) $ 4430 -(@)(@@) غنيم بن قيس المازني، قدم على عمر، وسمع سعدا، وأبا موسى، وعنه سليمان التيمي، والجريري، وجماعة. م 4.(@)(@@)(@@)(@@) $ 4431 -(@)(@@) غياث بن جعفر، مستملي ابن عيينة، عنه ابن ماجة، وابن جرير، وجمع، وثق. ق. PageV02P117(@)(@@)(@@)(@@) $ 4432 -(@)(@@) غيلان بن أنس دمشقي، عن أبي سلمة، وعكرمة، وعنه الأوزاعي، وشعيب بن أبي حمزة.(@)(@@) د ق.(@)(@@)(@@)(@@) $ 4433 -(@)(@@) غيلان بن جامع المحاربي، قاضي الكوفة، عن قتادة، وسماك، وعنه شعبة، وعلي بن عاصم، وآخرون، ثقة. م د س ق.(@)(@@)(@@)(@@) $ 4434 -(@)(@@) غيلان بن جرير الأزدي المعولي، عن أنس، ومطرف بن الشخير، وعنه شعبة، وجرير بن حازم، وحماد، مات 129. ع.(@)(@@)(@@)(@@) $ 4435 -(@)(@@) غيلان العامري، عن أبي زرعة، في أرض الهجرة، وعنه مهدي بن ميمون، ثقة. ت. PageV02P118(@)(@@)(@@)(@@) | حرف الفاء(@)(@@)(@@)(@@) $ 4436 -(@)(@@) فاتك بن فضالة الأسدي، عن أيمن بن خريم، وعنه سفيان بن زياد، وكان شريفا مطاعا. ت.(@)(@@)(@@)(@@) $ 4437 -(@)(@@) الفاكه بن 
ms334	 سعد، أنصاري له صحبة، عن حفيده عبد الرحمن بن عقبة. ق.(@)(@@)(@@)(@@) $ 4438 -(@)(@@) فائد أبو الورقاء الكوفي العطار، عن ابن أبي أوفى، وغيره، وعنه يزيد بن هارون، والفريابي، وجمع، تركوه. ت ق.(@)(@@)(@@)(@@) $ 4439 -(@)(@@) فائد بن كيسان الباهلي أبو العوام الجزار، عن أبي عثمان النهدي، وابن بريدة، وعنه حماد بن سلمة، ومكي بن إبراهيم، وثق. د ق.(@)(@@)(@@)(@@) $ 4440 -(@)(@@) فائد، عن مولاه عبادل، وأبي مرة مولى عقيل، وعنه القعنبي، وجماعة، وثقه ابن معين. د ت ق.(@)(@@)(@@)(@@) $ 4441 -(@)(@@) فجيع العامري البكائي، له صحبة، وعنه وهب بن عقبة. د.(@)(@@)(@@)(@@) $ 4442 -(@)(@@) فرات بن حيان العجلي، له صحبة، وعنه حارثة بن مضرب، وقيس بن زهير. د.(@)(@@)(@@)(@@) $ 4443 -(@)(@@) فرات القزاز، عن أبي الطفيل، وأبي حازم الأشجعي، وجمع، وعنه شعبة، والسفيانان، وثقوه. ع.(@)(@@)(@@)(@@) $ 4444 -(@)(@@) فراس بن يحيى الهمداني الكوفي المكتب، عن الشعبي، وأبي صالح، وعنه شعبة، وأبو عوانة، مات 129. ع. PageV02P119(@)(@@)(@@)(@@) $ 4445 -(@)(@@) فرج بن سعيد بن علقمة المأربي، عن عمي أبيه، وعنه الحميدي، وابن أبي عمر العدني، صدوق. د ق.(@)(@@)(@@)(@@) $ 4446 -(@)(@@) فرج بن فضالة التنوخي الحمصي، عن ربيعة بن يزيد، ولقمان بن عامر، وعنه قتيبة، ولوين، وعلي بن حجر، وخلق، ضعفه الدارقطني، وغيره، وقواه أحمد، مات 176. د ت ق.(@)(@@)(@@)(@@) $ 4447 -(@)(@@) فرقد السبخي بن يعقوب البصري، الحائك، الصالح الزاهد، عن أنس، وجمع، وعنه الحمادان، وهمام، ضعفوه، لكن قال عثمان الدارمي عن يحيى: ثقة، مات 131. ت ق.(@)(@@)(@@)(@@) $ 4448 -(@)(@@) فرقد أبو طلحة، عن عبد الرحمن بن خباب، وعنه الوليد بن أبي هشام، لا يعرف. ت.(@)(@@)(@@)(@@) $ 4449 -(@)(@@) فروخ، مولى عثمان، عن عمر، وعنه أبو يحيى المكي، وثق. ق.(@)(@@)(@@)(@@) $ 4450 -(@)(@@) فروة بن قيس، عن عطاء، وعنه شيخ. ق.(@)(@@)(@@)(@@) $ 4451 -(@)(@@) فروة بن مجاهد اللخمي، عن عقبة بن عامر، وعنه حسان بن عطية، وإبراهيم بن أدهم، وثق. د. PageV02P120(@)(@@)(@@)(@@) $ 4452 -(@)(@@) فروة بن مسيك المرادي، له صحبة، وعنه الشعبي، وجماعة. د ت.(@)(@@)(@@)(@@) $ 4453 -(@)(@@) فروة بن أبي المغراء الكندي الكوفي، عن شريك، وأبي الأحوص، وعنه البخاري، والدارمي، وجمع، مات 225. خ ت.(@)(@@)(@@)(@@) $ 4454 -(@)(@@) فروة بن نوفل الأشجعي، عن أبيه، وعلي، وعنه 
ms335	 أبو إسحاق، ونصر بن عاصم، وثق، وقيل: له صحبة. م 4.(@)(@@)(@@)(@@) $ 4455 -(@)(@@) فروة بن يونس الكلابي، عن هلال بن جبير، وعنه الأنصاري، وجماعة، مختلف فيه. ق.(@)(@@)(@@)(@@) $ 4456 -(@)(@@) فضاء بن خالد الجهضمي، عن علقمة المزني، وغيره، وعنه ابنه محمد. د ت ق.(@)(@@)(@@)(@@) $ 4457 -(@)(@@) فضالة بن إبراهيم النسوي، عن الليث، وابن المبارك، وعنه أحمد بن عبدة الآملي، ووهب بن زمعة، وثقه النسائي. ت.(@)(@@)(@@)(@@) $ 4458 -(@)(@@) فضالة بن عبيد، شهد أحدا، وولي قضاء دمشق، وعنه أبو علي الجنبي، وحنش الصنعاني، ومحمد بن كعب، مات 53. م 4.(@)(@@)(@@)(@@) $ 4459 -(@)(@@) فضالة بن الفضل الطهوي الكوفي، عن أبي بكر بن عياش، وجماعة، وعنه الترمذي، وابن صاعد، وأبو عروبة، ثقة، توفي 250. ت.(@)(@@)(@@)(@@) $ 4460 -(@)(@@) فضالة الليثي الزهراني، له صحبة، وعنه ابنه عبد الله. د.(@)(@@)(@@)(@@) $ 4461 -(@)(@@) الفضل بن جعفر بن الزبرقان، أخو يحيى، والعباس بنو أبي طالب، سمع يزيد بن هارون، وطبقته، وعنه الترمذي، والمحاملي، وعدة، ثقة، مات 252. ت.(@)(@@)(@@)(@@) $ 4462 -(@)(@@) الفضل بن الحسن الضمري، عن أبي هريرة، وابن عمر، وعنه عبيد الله بن أبي جعفر، وابن إسحاق، والمصريون. د. PageV02P121(@)(@@)(@@)(@@) $ 4463 -(@)(@@) الفضل بن دكين الحافظ أبو نعيم الملائي، مولى آل طلحة، عن الأعمش، وزكريا بن أبي زائدة، وأمم، وعنه البخاري، وعبد، وأبو زرعة، وأمم، مات 219 في سلخ شعبان بالكوفة. ع.(@)(@@)(@@)(@@) $ 4464 -(@)(@@) الفضل بن دلهم القصاب، عن الحسن، وأبي نصرة، وعنه وكيع، ومحمد بن خالد الوهبي، وعدة، قال أبو داود وغيره: ليس بالقوي. د ت ق.(@)(@@)(@@)(@@) $ 4465 -(@)(@@) الفضل بن سهل الأعرج أبو العباس البغدادي، عن يزيد بن هارون، ومحمد بن بشر، وعنه من عدا ابن ماجة، وابن مخلد، والمحاملي، وكان ذكيا يحفظ، مات 255. سوى ق.(@)(@@)(@@)(@@) $ 4466 -(@)(@@) الفضل بن الصباح البغدادي السمسار، عن هشيم، وابن عيينة، وعنه الترمذي، وابن ماجة، وابن جرير، وعدة، ثقة، مات 245. ت ق.(@)(@@)(@@)(@@) $ 4467 -(@)(@@) الفضل بن العباس الحلبي، عن عفان، وطبقته، وعنه النسائي، ومحمد بن جعفر السقاء، وعدة، وثق. س.(@)(@@)(@@)(@@) $ 4468 -(@)(@@) الفضل بن العباس، ابن عم النبي صلى الله عليه وسلم، ورديفه بعرفة، عنه أخوه، وأبو هريرة، وأرسل عنه جماعة، مات 
ms336	 في طاعون عمواس. ع.(@)(@@)(@@)(@@) $ 4469 -(@)(@@) الفضل بن عبيد الله بن أبي رافع، عن جده، وعنه ابنه عباس، ومنبوذ المدني، وثق. س.(@)(@@)(@@)(@@) $ 4470 -(@)(@@) الفضل بن عطية المروزي، عن عطاء، وسالم، وعنه ابنه محمد، وهشيم، وثقه ابن راهويه.(@)(@@) س ق.(@)(@@)(@@)(@@) $ 4471 -(@)(@@) الفضل بن عنبسة الواسطي الخزاز، عن شعبة، وجمع، وعنه محمد بن عبد الله المخرمي، وأحمد ابن سنان، ثقة، مات 197. خ س.(@)(@@)(@@)(@@) $ 4472 -(@)(@@) الفضل بن العلاء، عن ليث بن أبي سليم، وعبد الله بن عثمان بن خثيم، وعنه أحمد، والفلاس، وجمع، صدوق، قرنه البخاري بآخر. خ س.(@)(@@)(@@)(@@) $ 4473 -(@)(@@) الفضل بن عيسى بن أبان الرقاشي الواعظ، عن أنس، وأبي عثمان النهدي، وعنه أبو عاصم، وعلي بن عاصم، وجمع، ساقط. ق. PageV02P122(@)(@@)(@@)(@@) $ 4474 -(@)(@@) الفضل بن الفضل المدني، عن الأعرج، وعنه أسامة بن زيد. س.(@)(@@)(@@)(@@) $ 4475 -(@)(@@) الفضل بن مبشر الأنصاري أبو بكر المدني، عن جابر، وغيره، وعنه زياد البكائي، ويعلى بن عبيد، وجماعة، ضعفه جماعة، وقال أبو حاتم: ليس بقوي، وذكره ابن حبان في " الثقات ". ق.(@)(@@)(@@)(@@) $ 4476 -(@)(@@) الفضل بن مساور البصري، عن عوف، وابن أرطاة، وعنه بندار، وجماعة. خ.(@)(@@)(@@)(@@) $ 4477 -(@)(@@) الفضل بن موسى السيناني، عن هشام بن عروة، وطبقته، وعنه إسحاق، ومحمود بن غيلان، وخلق، ثبت، مات 192. ع.(@)(@@)(@@)(@@) $ 4478 -(@)(@@) الفضل بن الموفق بن أبي المتئد، عن فطر، ومالك بن مغول، وعنه أحمد، وأبو أمية، وجمع، ضعفه أبو حاتم. ق.(@)(@@)(@@)(@@) $ 4479 -(@)(@@) الفضل بن يزيد، عن الشعبي، وعكرمة، وعنه علي بن مسهر، وأبو معاوية، صدوق. ت.(@)(@@)(@@)(@@) $ 4480 -(@)(@@) الفضل بن يعقوب الرخامي، عن أبي النضر، وحجاج بن محمد، وعنه البخاري، وابن ماجة، والمحاملي، وابن أبي حاتم، حافظ حجة، مات 258. خ ق.(@)(@@)(@@)(@@) $ 4481 -(@)(@@) الفضل بن يعقوب البصري، عن نوح بن قيس، وابن عيينة، وعنه أبو داود، وابن ماجة، وابن خزيمة، وجمع، مات 256. د ق. PageV02P123(@)(@@)(@@)(@@) $ 4482 -(@)(@@) فضة أبو مودود، عن سليمان التيمي، وعنه يحيى بن الضريس، وعلي بن الحسن الواسطي. ت.(@)(@@)(@@)(@@) $ 4483 -(@)(@@) فضيل بن حسين أبو كامل الجحدري، ابن أخي كامل بن طلحة، لقي الحمادين، وعنه مسلم، وأبو داود، وزكريا الساجي، 
ms337	 والبغوي، وجمع، مات 237. م د س.(@)(@@)(@@)(@@) $ 4484 -(@)(@@) فضيل بن سليمان النميري، عن أبي مالك الأشجعي، ومنصور بن صفية، وعنه الفلاس، وطبقته، قال عباس عن ابن معين: ليس بثقة، وقال أبو زرعة: لين، وقال أبو حاتم، وغيره: ليس بالقوي.(@)(@@) مات 180. ع.(@)(@@)(@@)(@@) $ 4485 -(@)(@@) فضيل المهري، عن القاسم بن محمد، وغيره، وعنه بكير بن الأشج، ومالك. م د ت س.(@)(@@)(@@)(@@) $$$ * -(@)(@@) فضيل بن أبي عبد الله، مدني، هو المهري، تراه. [= 4485].(@)(@@)(@@)(@@) $ 4486 -(@)(@@) فضيل بن عبد الوهاب السكري القناد، عن حماد بن زيد، وشريك، وعنه أبو داود، وابن أبي الدنيا، وموسى بن هارون، قال أبو حاتم: صدوق. د.(@)(@@)(@@)(@@) $ 4487 -(@)(@@) فضيل بن عمرو الفقيمي، عن إبراهيم، والشعبي، وجمع، وعنه أبان بن تغلب، وحجاج بن أرطاة، مات 110. م ت س ق.(@)(@@)(@@)(@@) $ 4488 -(@)(@@) فضيل بن عياض التميمي الخراساني الزاهد، عن منصور، وحصين، وعنه يحيى القطان، وابن مهدي، ولوين، وخلق، ثقة رفيع الذكر، جاوز الثمانين، مات في المحرم 187. ع سوى ق.(@)(@@)(@@)(@@) $ 4489 -(@)(@@) فضيل بن غزوان الضبي مولاهم، عن عكرمة، وسالم، وأبي حازم الأشجعي، وعنه ابنه محمد، ووكيع، والقطان. ع.(@)(@@)(@@)(@@) $ 4490 -(@)(@@) فضيل بن فضالة، عن أبي رجاء العطاردي، وعنه شعبة. س. PageV02P124(@)(@@)(@@)(@@) $ 4491 -(@)(@@) فضيل بن فضالة الهوزني شامي، عن المقدام بن معدي كرب، وجماعة، وعنه معاوية بن صالح، وصفوان بن عمرو، وعدة. س.(@)(@@)(@@)(@@) $ 4492 -(@)(@@) فضيل بن مرزوق الكوفي، عن أبي حازم الأشجعي، وطائفة، وعنه يحيى بن آدم، وقبيصة، وعلي بن الجعد، ثقة. م 4.(@)(@@)(@@)(@@) $ 4493 -(@)(@@) فضيل بن ميسرة العقيلي، عن طاوس، والشعبي، وعنه شعبة، والقطان، وعدة. د س ق.(@)(@@)(@@)(@@) $ 4494 -(@)(@@) فطر بن خليفة المخزومي مولاهم الحناط، عن أبي الطفيل، وعطاء الشيبي، ومولاه عمرو بن حريث الصحابي، وعن مجاهد، والشعبي، وعنه القطان، ويحيى بن آدم، وخلق، شيعي جلد، وثقه أحمد، وابن معين، مات 153. 4 خ قرنه.(@)(@@)(@@)(@@) $ 4495 -(@)(@@) فلفلة الجعفي، عن ابن مسعود، وحذيفة، وعنه عمرو بن مرة، وجماعة. س.(@)(@@)(@@)(@@) $ 4496 -(@)(@@) فليح بن سليمان العدوي مولاهم المدني، عن سعيد بن الحارث، وضمرة بن سعيد، ونافع، وعنه ابنه محمد، وأبو الربيع الزهراني، وخلق قال ابن معين، 
ms338	 وأبو حاتم، والنسائي: ليس بالقوي، مات 168. ع.(@)(@@)(@@)(@@) $ 4497 -(@)(@@) فيروز الديلمي، صحابي، عنه بنوه: الضحاك وعبد الله وسعيد، وآخرون، قيل: بقي إلى خلافة معاوية. 4. PageV02P125(@)(@@)(@@)(@@) | حرف القاف(@)(@@)(@@)(@@) $ 4498 -(@)(@@) قابوس بن أبي ظبيان الجنبي، عن أبيه، وعنه جرير بن عبد الحميد، وأبو بدر، وعدة، قال أبو حاتم وغيره: لا يحتج به. د ت ق.(@)(@@)(@@)(@@) $ 4499 -(@)(@@) قابوس بن أبي المخارق، عن أبيه، وعن أم الفضل، وعنه سماك بن حرب، يجهل. د س ق. PageV02P126(@)(@@)(@@)(@@) $ 4500 -(@)(@@) قارظ بن شيبة الليثي، عن أبي غطفان المري، وابن المسيب، وعنه ابن أبي ذئب، وغيره، قال النسائي: ليس به بأس. د ق.(@)(@@)(@@)(@@) $ 4501 -(@)(@@) القاسم بن أحمد، عن العقدي، وعنه أبو داود، وابن خزيمة، وعدة، بغدادي. د.(@)(@@)(@@)(@@) $ 4502 -(@)(@@) القاسم بن أبي أيوب، عن سعيد بن جبير حديث القنوت، وعنه شعبة، وأصبغ بن زيد، وثق. س.(@)(@@)(@@)(@@) $ 4503 -(@)(@@) القاسم بن أبي بزة، مولى بني مخزوم، عن أبي الطفيل، ومجاهد، وعنه ابن جريج، وشعبة، وجمع، مات 124. ع.(@)(@@)(@@)(@@) $ 4504 -(@)(@@) القاسم بن أمية البصري الحذاء، عن معتمر، وحفص بن غياث، وعنه أبو زرعة، وأبو حاتم، وتمتام، صدوق، غلط الترمذي فسماه أمية بن القاسم، كما مر. ت [= 470].(@)(@@)(@@)(@@) $ 4505 -(@)(@@) القاسم بن حبيب التمار، عن عكرمة، والقرظي، وعنه وكيع، وأبو نعيم، ضعف. ت.(@)(@@)(@@)(@@) $ 4506 -(@)(@@) القاسم بن حسان العامري، عن زيد بن ثابت، وجماعة، وعنه الركين بن الربيع، والوليد بن قيس، وثق. د س.(@)(@@)(@@)(@@) $ 4507 -(@)(@@) القاسم بن الحكم العرني الكوفي، قاضي همذان، عن زكريا بن أبي زائدة، وداود الأودي، وعدة، وعنه أبو قدامة السرخسي، وإسحاق بن الفيض، وأحمد بن محمد التبعي، وخلق، وثقوه، وقال أبو حاتم: لا يحتج به، مات 208. ت.(@)(@@)(@@)(@@) $ 4508 -(@)(@@) القاسم بن ربيعة، هو: ابن عبد الله بن ربيعة الغطفاني الجوشني، عن ابن عمر، وعقبة بن أوس، وعنه أيوب، والحذاء، وحميد، وثقوه، وكان نسابة، ذكر لقضاء البصرة. د س ق.(@)(@@)(@@)(@@) $ 4509 -(@)(@@) القاسم بن رشدين، عن مخرمة بن بكير، وعنه إبراهيم بن المنذر. س. PageV02P127(@)(@@)(@@)(@@) $ 4510 -(@)(@@) القاسم بن زكريا بن دينار الكوفي الطحان، عن وكيع، وطبقته، وعنه مسلم والترمذي، والنسائي، 
ms339	 وابن ماجة، والقاسم بن زكريا المطرز. م ت س ق.(@)(@@)(@@)(@@) $ 4511 -(@)(@@) القاسم بن سلام أبو عبيد البغدادي، مولى الأزد، ذو التصانيف، عن إسماعيل بن عياش، وإسماعيل بن جعفر، وشريك، وعنه الدارمي، وعلي البغوي، وابن أبي الدنيا، عاش ثمانيا وستين سنة، وكان ثقة علامة، مات 224. د.(@)(@@)(@@)(@@) $ 4512 -(@)(@@) القاسم بن عاصم، عن رافع بن خديج، وابن المسيب، وعنه أيوب، وحميد. خ م س.(@)(@@)(@@)(@@) $ 4513 -(@)(@@) القاسم بن عباس الهاشمي اللهبي، عن نافع بن جبير، وجمع، وعنه ابن أبي ذئب، وغيره، وثق. م د ت ق.(@)(@@)(@@)(@@) $ 4514 -(@)(@@) القاسم بن عبد الله الثقفي، عن سعد، وعنه يعلى بن عطاء. س.(@)(@@)(@@)(@@) $ 4515 -(@)(@@) القاسم بن عبد الله بن عمر العمري، عن سعيد المقبري، وجمع، وعنه قتيبة، وهشام بن عمار، تركوه. ق. PageV02P128(@)(@@)(@@)(@@) $ 4516 -(@)(@@) القاسم بن عبد الرحمن بن عبد الله بن مسعود الهذلي، قاضي الكوفة، عن أبيه، وجابر بن سمرة، وابن عمر، وعنه سماك، وأبو إسحاق، وطائفة آخرهم المسعودي، مات 116. خ 4.(@)(@@)(@@)(@@) $ 4517 -(@)(@@) القاسم بن عبد الرحمن أبو عبد الرحمن الدمشقي، مولى بني أمية، عن علي، وسلمان مرسلا، وعن معاوية، وعمرو بن عبسة، وقيل لم يسمع من صحابي سوى أبي أمامة، وعنه ثابت بن عجلان، وثور، ومعاوية بن صالح، قال يحيى الذماري عنه: لقيت مائة صحابي، صدوق، مات 112. 4.(@)(@@)(@@)(@@) $ 4518 -(@)(@@) القاسم بن عبد الواحد بن أيمن المكي، عن عبد الله بن محمد بن عقيل، وجماعة، وعنه همام، وعبد الوارث، وثق، لم يتكهل. ت س ق.(@)(@@)(@@)(@@) $ 4519 -(@)(@@) القاسم بن عبيد الله بن عبد الله بن عمر، عن أبيه، وعمه سالم، وعنه أبو عقيل يحيى، وعمر وعاصم ابنا محمد بن زيد. م س.(@)(@@)(@@)(@@) $ 4520 -(@)(@@) القاسم بن عوف الشيباني، عن أبي برزة، والبراء، وابن عمر، وعنه أيوب، وهشام الدستوائي، وعدة، مختلف في حاله. م ق.(@)(@@)(@@)(@@) $ 4521 -(@)(@@) القاسم بن غزوان، عن إسحاق بن راشد، وعمر بن عبد العزيز، وعنه شهاب بن خراش، وسعيد ابن محمد الوراق، وثق. د. PageV02P129(@)(@@)(@@)(@@) $ 4522 -(@)(@@) القاسم بن غنام، عن عمته أم فروة، وعنه عبيد الله، وعبد الله ابنا عمر. د 
ms340	 ت.(@)(@@)(@@)(@@) $ 4523 -(@)(@@) القاسم بن الفضل الأزدي الحداني، عنه ثمامة بن حزن، وابن سيرين، وعنه ابن مهدي، وشيبان، وجمع، وثقوه، مات 167. م 4.(@)(@@)(@@)(@@) $ 4524 -(@)(@@) القاسم بن فياض الصنعاني، عن عمه خلاد، وعنه هشام بن يوسف، ضعف. د س.(@)(@@)(@@)(@@) $ 4525 -(@)(@@) القاسم بن كثير، قاضي الإسكندرية، عن الليث، ومحمد بن مطرف، وعنه الدارمي، ومحمد بن البرقي، وثق. ت س.(@)(@@)(@@)(@@) $ 4526 -(@)(@@) القاسم بن مالك المزني الكوفي، عن حصين، والمختار بن فلفل، وعنه أحمد، وابن عرفة، وعدة. سوى د.(@)(@@)(@@)(@@) $ 4527 -(@)(@@) القاسم بن مبرور الأيلي، عن يونس، وهشام بن عروة، وعنه خالد بن نزار، وخالد بن حميد، مات 158. د س.(@)(@@)(@@)(@@) $ 4528 -(@)(@@) القاسم بن محمد التيمي الفقيه، عن عائشة، وأبي هريرة، وفاطمة بنت قيس، وعنه الزهري، وأبو الزناد، وعدة، له نحو مائتي حديث، توفي 107. ع.(@)(@@)(@@)(@@) $ 4529 -(@)(@@) القاسم بن محمد بن عباد المهلبي، عن أبيه، والخريبي، وعنه ابن ماجة، وابن خزيمة، والمحاملي، ثقة. ق. PageV02P130(@)(@@)(@@)(@@) $ 4530 -(@)(@@) القاسم بن محمد المخزومي، عن عمه، وعنه حبيب بن أبي ثابت، وثق. س.(@)(@@)(@@)(@@) $ 4531 -(@)(@@) القاسم بن محمد، عن أبي إدريس الخولاني، وعنه علي بن سليمان، شامي. ق.(@)(@@)(@@)(@@) $ 4532 -(@)(@@) القاسم بن مخيمرة أبو عروة، عن أبي سعيد، وعبد الله بن عمرو، وعلقمة، وعنه الحكم، وابن أبي خالد، والأوزاعي، وعدة، مات 111. م 4.(@)(@@)(@@)(@@) $ 4533 -(@)(@@) القاسم بن معن المسعودي القاضي، عن عبد الملك بن عمير، وحصين، ومنصور، وعنه ابن مهدي، وأبو نعيم، وأبو غسان النهدي، وثقه أحمد، وقيل: كان كالشعبي في زمانه، مات 175.(@)(@@) د س.(@)(@@)(@@)(@@) $ 4534 -(@)(@@) القاسم بن مهران، عن أبي رافع الصائغ، وعنه عبد الوارث، وابن علية، وعدة. م س ق.(@)(@@)(@@)(@@) $ 4535 -(@)(@@) القاسم بن مهران، عن عمران بن حصين، وعنه موسى بن عبيدة. ق.(@)(@@)(@@)(@@) $ 4536 -(@)(@@) القاسم بن نافع، عن جسر بن فرقد، وابن أرطاة، وعنه يعقوب بن حميد. ق.(@)(@@)(@@)(@@) $ 4537 -(@)(@@) القاسم بن الوليد الهمداني القاضي، عن الشعبي، والباقر، وعنه ابنه الوليد، وأبو نعيم، ثقة، توفي 141. ق. PageV02P131(@)(@@)(@@)(@@) $ 4538 -(@)(@@) القاسم بن يحيى بن عطاء بن مقدم، عن منصور بن صفية، والأعمش، وعدة، وعنه ابن أخيه مقدم بن محمد، وغيره. 