ms361	 للجنة بالسلاسل % % 67(@)(@@) % يا باعث الجبن قد ساءت مطاعمه % % وتخلف الوعد في الشهد الذي يصل % % 68(@)(@@) % بخلت بالشهد لا بالجبن تبعثه % % لبئست الخلتان الجبن والبخل % % 69(@)(@@) % دنوت اليها وهو كالفرخ عاجز % % فيا خجلي لما دنوت وإذلالي % % 70(@)(@@) % وقلت امعكيه بالأنامل فالتقى % % لدى وكرها العناب والحشف البالي % % PageV01P1634 71(@)(@@) % سأسعى إلى أبوابكم ولو أنني % % على الرأس أسعى راضيا لا على الرجل % % 72(@)(@@) % وأمشي لكم ما بين مصر وغزة % وإن كنت لا أستحسن المشي في الرمل % % 73(@)(@@) % اذا جاء عثمان مستخبرا % عن المتقارب بحرا فقولوا % % 74(@)(@@) % ثقيل ثقيل ثقيل ثقيل % ثقيل ثقيل ثقيل ثقيل % 75(@)(@@) % أقوادتي إني فرغت من النسا % % وأضحى على ميل العلوق معولي % % 76(@)(@@) % فان كنت قد أزمعت بظرا فلا ولا % % وإن كنت قد أزمعت صرما فأجملي % % 77(@)(@@) % يا رب ناعورة غنت لنا وبكت % % كحالة الصب بين اليأس والأمل % % 78(@)(@@) % قالت ودمع أخي العشاق يتبعها % % أنا الغريق فما خوفي من البلل % % 79(@)(@@) % منع اتضاعك أن تقبل مبسمي % % قدما سموت بها إلى التفضيل % % 80(@)(@@) % فلذاك أهديت الركاب تخيلا % لأكون قد قبلتها برسول % % PageV01P1635 81(@)(@@) % ألا قل لمولانا الإمام أخي التقى % % أغثني فعندي للعلاء عليل % % 82(@)(@@) % فقدت دقيقا من معان ومأكل % ورأيك في استرجاع ذين جميل % % 83(@)(@@) % صحبنا أناسا عاطفين فغيروا % % ومالوا مع الأيام حيث تميل % % 84(@)(@@) % فصرنا نرى أن المتارك محسن % % وأن خليلا لا يضر وصول % % 85(@)(@@) % حمى الله من ريب الحوادث سادة % لشوقي بهم حال وللصبر ترحال % % 86(@)(@@) % كحلت جفوني بالسهاد لبعدهم % % فيا حبذا للسهد والبعد أميال % % 87(@)(@@) % أقول اذا استكتبت صدر رسالة % إلى آل فضل الله مأوى الفضائل % % 88(@)(@@) % أنا العبد يدعو الله في صدره لكم % % نعم ثم يدعو في صدور الرسائل % % 89(@)(@@) % وصلت إلى قصدي وسطر لي بما % % أحلت وصول واستقر حصول % % 90(@)(@@) % ولولا الندى الفخري في كل حالة % % لما كان لي في الحالتين وصول % % PageV01P1636 91(@)(@@) % أفدي رئيسين قد أطلا % على ذرى المجد والمعالي % % 92(@)(@@) % لاق بذا قرب ذا فقلنا % % ما أليق البدر بالكمال % % 93(@)(@@) % أوقفني ودي مع هاجر % يبخل 
ms362	 بالدرج وبالوصل % % 94(@)(@@) % والله لا غررت من بعدها % % ولا جعلت الود في حلي % % 95(@)(@@) % قل لخليلي الذي رجوت به % % تقدمي في الورى وإجلالي % % 96(@)(@@) % كدر لي دهري الحياة ومذ % % رجوت منه الصفاء صفالي % % 97(@)(@@) % قضيت العمر مداحا % وهذا يا أخي الحال % 98(@)(@@) % فقير الوجه والمكف % فلا جاه ولا مال % % 99(@)(@@) % عش يا ولي الوقت تنعش في الورى % % حالي الضعيف وكل حال مؤمل % % 100(@)(@@) % وفديت خطك في الرقاع مجاوبا % بالجود فهو حقيقة خط الولي % % PageV01P1637 101(@)(@@) % قاضي القضاة لقد حويت من العلى % % خط يطل على الكواكب من عل % % 102(@)(@@) % وفتاويا وفتوة شاهدتها % % فحفلت ما في الكون أفنى من علي % % 103(@)(@@) % إن لم تكن لأخي السؤال فمن له % % يا من صرفت له الرجاء فمله % 104(@)(@@) % وأعيذه من أن يراني مقسما % أن لست أفتح بالسؤال فما له % % 105(@)(@@) % جمال الدين قد أتقنت خطا % حوت أوضاعه معنى الجمال % % 106(@)(@@) % يقول ابن العديم لو اختلاه % % وقاك الله من عين الكمال % % 107(@)(@@) % كذا كل عام في وفور سيادة % وقدر له عند النجوم حصول % % 108(@)(@@) % وعليا تنادي لا وصول لحاسد % ولكن لمختار الصلات وصول % % 109(@)(@@) % أقاضي القضاة الذي قد علا % بأسمى السمات وأزكى الفعال % % 110(@)(@@) % بجود وزهد وخط بهر % % ت فأنت الولي على كل حال % % PageV01P1638 111(@)(@@) % رب غيث رام أن يحكي ندى % لك فينا ثم ولى واستحال % % 112(@)(@@) % عاقنا عنك وما حاكى فما % % هو إلا بارد في كل حال % % 113(@)(@@) % لو كان غيرك مخدوما ألوذ به % % لكان حالي على ما أشتهي حالي % % 114(@)(@@) % ولا هجيت فلا أمسيت مفتقرا % وبارك الله في عرضي وفي مالي % % 115(@)(@@) % يا نسبة الشمس في المعالي % % ملت لرجواي كل ميل % % 116(@)(@@) % فحبذا من جوار خير % % أفاد قصدي جراد خيل % % 117(@)(@@) % أيا سيدي ان ذاك الذي % % أمرت ببري سها عن خليلي % % 118(@)(@@) % وقال أناس أتاك الدقيق % % فقلت لهم لا وحق الجليل % % 119(@)(@@) % يسشائلني عن حال إيري من رأى % % على رأس إيري كتلة حين أكتال % % 120(@)(@@) % فقلت له أنت الذي بأذاك ما % % تركت له رأسا مع 
ms363	 الناس تنشال % % PageV01P1639 121(@)(@@) % قالوا وصولات الورى حصلت لهم % % ونراك لم تظفر لها بحصول % % 122(@)(@@) % أطلب وصولك قلت أن لم يقض لي % % قاضي القضاة فأين أين وصولي % % 123(@)(@@) % سل أسياف لحظه % % فالتقتها مقاتلي % % 124(@)(@@) % باخل لا يرق من % % دمع عيني لسائل % % 125(@)(@@) % أنا مجنون حبه % % ودموعي سلاسلي % % 126(@)(@@) % يا هلالا يحل من % % كبدي في منازل % % 127(@)(@@) % ذكر الله بالنع % % يم ليالي التواصل % % 128(@)(@@) % وسقى عهدها وإن % % عهدت بالشقاء لي % % PageV01P1640 البحر : - 1(@)(@@) % م حلوا بعقد الحسن أجيادهم % % وحاولوا صبري حتى استحال % % 2(@)(@@) % فآه من عاطل صبر مضى % % والحمد لله على كل حال % % PageV01P1641 البحر : - 1(@)(@@) % أيا حسنا قد هوى شائبا % لقد بتما والهوى مشكل % % 2(@)(@@) % فلو بتما عند قدريكما % % لبت وأعلا كما الاسفل % % PageV01P1642 البحر : - 1(@)(@@) % بروحي خليلا لم أجد مع صدوده % % إلى القلب عنه سلوة تتخلل % % 2(@)(@@) % ويعلم بأسي من جميل وفائه % % فما ضره بالقول لو يتجمل % % PageV01P1643 البحر : - 1(@)(@@) % أتاني علي الباسي بشعره % % فيا لك من شعر ثقيل مطول % % 2(@)(@@) % مكر مفر مدبر مقبل معا % كجلمود صخر حطه السيل من عل ي % % PageV01P1644 البحر : - 1(@)(@@) % يداوي أسى العشاق من نحو أرضكم % % نسيم صبا أضحى عليه قبول % % 2(@)(@@) % بروحي من ذاك النسيم اذا سرى % % طبيبا يداوي الناس وهو عليل % % PageV01P1645 البحر : - 1(@)(@@) % مبقل الخد قالوا % % فقلت ما ذاك يسلي % % 2(@)(@@) % هذا الزمرد حقا % ماذي حوائج بقلي % % PageV01P1646 البحر : - 1(@)(@@) % لا أرى لي في الشام بعد مادعى % % أحبتي وسادتي الرحيل % % 2(@)(@@) % وكيف أختار المقام في حمى % لا صاحب فيه ولا خليل % % PageV01P1647 البحر : - 1(@)(@@) % سألت الحلال فأعطى وقد % % سألناك يا من عليه يدل % % 2(@)(@@) % وأنت في الدولة ابن المعز % فلا تقصرن عن ابن الاجل % % PageV01P1648 البحر : - 1(@)(@@) % شهاب الدين يا غوث الموالي % % ومن حاز الثنا والفضل كله % % 2(@)(@@) % أغث قوما إلى البطيخ أمسوا % % قياما يسألون عن الأهلة % % PageV01P1649 البحر : - 1(@)(@@) % يفديك عبد مودة % أسليته عن أهله % % 2(@)(@@) % وكتبت عهدة رقه % % بالمكرمات فحله % % PageV01P1650 البحر : - 1(@)(@@) % علي ديون من ثا لم أقم بها % % فيا عجبا لي في ازدياد من الفضل % % 2(@)(@@) % وأعجب من 
ms364	 ذا أنك الشمس أشرقت % % وها أنا منها حيثما كنت في ظل % % PageV01P1651 البحر : - 1(@)(@@) % أرسلت بعدكم بجهد نحوكم % % جبنا فيا خجلي ويا جهلي % % 2(@)(@@) % وبخلت عن مفروض حقكم % فجمعت بين الجبن والخل % % PageV01P1652 البحر : - 1(@)(@@) % يا متقنا علم الشريعة والندى % % أنت الأحق بما يقول الأول % % 2(@)(@@) % تجب الزكاة على الذين وعدتهم % % وعدا فانهم بذاك تمولوا % % PageV01P1653 البحر : - 1(@)(@@) % يا دهر رفقا فما أبقيت لي أملا % في ثروة أتمناها ولا جذل % % 2(@)(@@) % قطعت باليأس آمالي لديك فقد % % تركتني أصحب الدنيا بلا أمل % % PageV01P1654 البحر : - 1(@)(@@) % أهلا بسائرة الصبا من نحوكم % % وبما عهدنا من تعاهد طولها % % 2(@)(@@) % أملت على الزهر المقطب ذكركم % % حتى تبسم ضاحكا من قولها % % PageV01P1655 البحر : - 1(@)(@@) % غاب الوزير وكان العطف شيمته % % وجئت نعم أمير بالرجاء ملي % % 2(@)(@@) % فشيبة الحمد عندي والولاء معا % حقان بين أبي بكر وبين علي % % PageV01P1656 البحر : - 1(@)(@@) % بقلت وجنة المليح وقد ول % ى زمان الضنا الذي كنت أملك % % 2(@)(@@) % يا عذار المليح دعني فاني % % لست في ذا الزمان من خل بقلك % % PageV01P1657 البحر : - 1(@)(@@) % يا ابن النبوة والفتوة والتقى % % عذرا لمعلوم الولا لا يجهل % % 2(@)(@@) % كم بيت مدح قلت فيك لنظمه % % يا بيت عاتكة الذي أتغزل % % PageV01P1658 البحر : - 1(@)(@@) % دامت صلاة الحمى الزيني واصلة % % كأن احسانها نصبا على الحال % % 2(@)(@@) % ولا برحنا وان شط المزار بنا % % من هالة البدر معنى في ابن منهال % % PageV01P1659 البحر : - 1(@)(@@) % يا فتى العليا وصاحبها % % ما ترى في واثق الأمل % % 2(@)(@@) % تاليا إنسان مقلته % % خلق الانسان من عجل % % PageV01P1660 البحر : - 1(@)(@@) % رأينا تواقيع تاج العلوم % % على قصص ذات وصف جلي % % 2(@)(@@) % بنسك وجود وخط أجاد % % فقلت الثلاثة خط الولي % % PageV01P1661 البحر : - 1(@)(@@) % يا صاحبي لك من سقم ومن كبر % عنق متين وفي الخدين تسهيل % % 2(@)(@@) % وطلعة شمل الخيلان وجنتها % % فعمها خالها قوداء شمليل % % PageV01P1662 البحر : - 1(@)(@@) % سار الأمير علي في كفالته % % لمأمن الدهر سير الانزع البطل % % 2(@)(@@) % فنحن في الفضل ماضيه وحاضره % % نروي الثنا عن أمير المؤمنين علي % % PageV01P1663 البحر : - 1(@)(@@) % وضعت سلاح الصبر عنه فما له % % يقاتل بالالحاظ من لا يقاتله 
ms365	 % % 2(@)(@@) % وسال عذار حول خديه جائر % % على مهجتي فليتق الله سائله % % PageV01P1664 البحر : - 1(@)(@@) % أحمد الله كم أجود في الخل % % ق مقالا وما يفيد المقال % % 2(@)(@@) % كلمي في الأنام سحر ولكن % % أنا والسحر باطل بطال % % PageV01P1665 البحر : - 1(@)(@@) % أهلا بمقدمك السعيد وحبذا % % عيش على رغم الأعادي مقبل % % 2(@)(@@) % طلع الهلال وبمن وجهك للورى % % يتفاضلان وأنت أنت الأفضل % % PageV01P1666 البحر : - 1(@)(@@) % عش يا إمام العلى والعلم ذا نعم % لقاصر السعي مثلي طامح الأمل % % 2(@)(@@) % أقسمت ما عثرت بالفقر لي قدم % الا وصاح رجائي فيك يا لعلي % % PageV01P1667 البحر : - 1(@)(@@) % وسمي برك يا ولي الوقت قد % % أربت بوادره على الأمل الملي % % 2(@)(@@) % لا يعدم الشام اقتتال وزارة % يسعى بها الوسمي من حول الولي % % PageV01P1668 البحر : - 1(@)(@@) % أما حمى قاضي القضاة فانني % % عن جاهه أروي الصحيح وماله % % 2(@)(@@) % مهما سألت عن اختلاف مقاصدي % % قالت حلاه أجزته بسؤاله % % PageV01P1669 البحر : - 1(@)(@@) % رسمت عوادي السحر من ألحاظه % % سطر الضنا من فوق جسمي البالي % % 2(@)(@@) % فاذا تأمله الخبير به رأى % % رسم ابن مقلة من يد ابن هلال % % PageV01P1670 البحر : - 1(@)(@@) % حضرت صلاة العصر خلف مبلغ % بهي المحيا يعشق الجمع شكله % 2(@)(@@) % فأقسم من خديه والثغر بالضحى % % وبالصبح ما أبصرت في العصر مثله % % PageV01P1671 البحر : - 1(@)(@@) % ألا رب ليل واعدت فيه بالجفا % % ويا ويح روحي إن جفتها وويلها % % 2(@)(@@) % فبت كأني شعرها وهو مسبل % % أقبل رجلها وأمسك ذيلها % % PageV01P1672 البحر : - 1(@)(@@) % أفدي التي ساق اليها مهجتي % % فرع طويل فوق حسن طائل % % 2(@)(@@) % قلبي بصدغيها إلى طلعتها % % يساق للجنة بالسلاسل % % PageV01P1673 البحر : - 1(@)(@@) % يا باعث الجبن قد ساءت مطاعمه % % وتخلف الوعد في الشهد الذي يصل % % 2(@)(@@) % بخلت بالشهد لا بالجبن تبعثه % % لبئست الخلتان الجبن والبخل % % PageV01P1674 البحر : - 1(@)(@@) % دنوت اليها وهو كالفرخ عاجز % % فيا خجلي لما دنوت وإذلالي % % 2(@)(@@) % وقلت امعكيه بالأنامل فالتقى % % لدى وكرها العناب والحشف البالي % % PageV01P1675 البحر : - 1(@)(@@) % سأسعى إلى أبوابكم ولو أنني % % على الرأس أسعى راضيا لا على الرجل % % 2(@)(@@) % وأمشي لكم ما بين مصر وغزة % وإن كنت لا أستحسن المشي في الرمل % % PageV01P1676 البحر : - 1(@)(@@) % اذا 
ms366	 جاء عثمان مستخبرا % عن المتقارب بحرا فقولوا % % 2(@)(@@) % ثقيل ثقيل ثقيل ثقيل % ثقيل ثقيل ثقيل ثقيل % PageV01P1677 البحر : - 1(@)(@@) % أقوادتي إني فرغت من النسا % % وأضحى على ميل العلوق معولي % % 2(@)(@@) % فان كنت قد أزمعت بظرا فلا ولا % % وإن كنت قد أزمعت صرما فأجملي % % PageV01P1678 البحر : - 1(@)(@@) % يا رب ناعورة غنت لنا وبكت % % كحالة الصب بين اليأس والأمل % % 2(@)(@@) % قالت ودمع أخي العشاق يتبعها % % أنا الغريق فما خوفي من البلل % % PageV01P1679 البحر : - 1(@)(@@) % منع اتضاعك أن تقبل مبسمي % % قدما سموت بها إلى التفضيل % % 2(@)(@@) % فلذاك أهديت الركاب تخيلا % لأكون قد قبلتها برسول % % PageV01P1680 البحر : - 1(@)(@@) % ألا قل لمولانا الإمام أخي التقى % % أغثني فعندي للعلاء عليل % % 2(@)(@@) % فقدت دقيقا من معان ومأكل % ورأيك في استرجاع ذين جميل % % PageV01P1681 البحر : - 1(@)(@@) % صحبنا أناسا عاطفين فغيروا % % ومالوا مع الأيام حيث تميل % % 2(@)(@@) % فصرنا نرى أن المتارك محسن % % وأن خليلا لا يضر وصول % % PageV01P1682 البحر : - 1(@)(@@) % حمى الله من ريب الحوادث سادة % لشوقي بهم حال وللصبر ترحال % % 2(@)(@@) % كحلت جفوني بالسهاد لبعدهم % % فيا حبذا للسهد والبعد أميال % % PageV01P1683 البحر : - 1(@)(@@) % أقول اذا استكتبت صدر رسالة % إلى آل فضل الله مأوى الفضائل % % 2(@)(@@) % أنا العبد يدعو الله في صدره لكم % % نعم ثم يدعو في صدور الرسائل % % PageV01P1684 البحر : - 1(@)(@@) % وصلت إلى قصدي وسطر لي بما % % أحلت وصول واستقر حصول % % 2(@)(@@) % ولولا الندى الفخري في كل حالة % % لما كان لي في الحالتين وصول % % PageV01P1685 البحر : - 1(@)(@@) % أفدي رئيسين قد أطلا % على ذرى المجد والمعالي % % 2(@)(@@) % لاق بذا قرب ذا فقلنا % % ما أليق البدر بالكمال % % PageV01P1686 البحر : - 1(@)(@@) % أوقفني ودي مع هاجر % يبخل بالدرج وبالوصل % % 2(@)(@@) % والله لا غررت من بعدها % % ولا جعلت الود في حلي % % PageV01P1687 البحر : - 1(@)(@@) % قل لخليلي الذي رجوت به % % تقدمي في الورى وإجلالي % % 2(@)(@@) % كدر لي دهري الحياة ومذ % % رجوت منه الصفاء صفالي % % PageV01P1688 البحر : - 1(@)(@@) % قضيت العمر مداحا % وهذا يا أخي الحال % 2(@)(@@) % فقير الوجه والمكف % فلا جاه ولا مال % % PageV01P1689 البحر : - 1(@)(@@) % عش يا ولي الوقت تنعش في الورى % % حالي الضعيف وكل حال مؤمل 
ms367	 % % 2(@)(@@) % وفديت خطك في الرقاع مجاوبا % بالجود فهو حقيقة خط الولي % % PageV01P1690 البحر : - 1(@)(@@) % قاضي القضاة لقد حويت من العلى % % خط يطل على الكواكب من عل % % 2(@)(@@) % وفتاويا وفتوة شاهدتها % % فحفلت ما في الكون أفنى من علي % % PageV01P1691 البحر : - 1(@)(@@) % إن لم تكن لأخي السؤال فمن له % % يا من صرفت له الرجاء فمله % 2(@)(@@) % وأعيذه من أن يراني مقسما % أن لست أفتح بالسؤال فما له % % PageV01P1692 البحر : - 1(@)(@@) % جمال الدين قد أتقنت خطا % حوت أوضاعه معنى الجمال % % 2(@)(@@) % يقول ابن العديم لو اختلاه % % وقاك الله من عين الكمال % % PageV01P1693 البحر : - 1(@)(@@) % كذا كل عام في وفور سيادة % وقدر له عند النجوم حصول % % 2(@)(@@) % وعليا تنادي لا وصول لحاسد % ولكن لمختار الصلات وصول % % PageV01P1694 البحر : - 1(@)(@@) % أقاضي القضاة الذي قد علا % بأسمى السمات وأزكى الفعال % % 2(@)(@@) % بجود وزهد وخط بهر % % ت فأنت الولي على كل حال % % PageV01P1695 البحر : - 1(@)(@@) % رب غيث رام أن يحكي ندى % لك فينا ثم ولى واستحال % % 2(@)(@@) % عاقنا عنك وما حاكى فما % % هو إلا بارد في كل حال % % PageV01P1696 البحر : - 1(@)(@@) % لو كان غيرك مخدوما ألوذ به % % لكان حالي على ما أشتهي حالي % % 2(@)(@@) % ولا هجيت فلا أمسيت مفتقرا % وبارك الله في عرضي وفي مالي % % PageV01P1697 البحر : - 1(@)(@@) % يا نسبة الشمس في المعالي % % ملت لرجواي كل ميل % % 2(@)(@@) % فحبذا من جوار خير % % أفاد قصدي جراد خيل % % PageV01P1698 البحر : - 1(@)(@@) % أيا سيدي ان ذاك الذي % % أمرت ببري سها عن خليلي % % 2(@)(@@) % وقال أناس أتاك الدقيق % % فقلت لهم لا وحق الجليل % % PageV01P1699 البحر : - 1(@)(@@) % يسائلني عن حال إيري من رأى % % على رأس إيري كتلة حين أكتال % % 2(@)(@@) % فقلت له أنت الذي بأذاك ما % % تركت له رأسا مع الناس تنشال % % PageV01P1700 البحر : - 1(@)(@@) % قالوا وصولات الورى حصلت لهم % % ونراك لم تظفر لها بحصول % % 2(@)(@@) % أطلب وصولك قلت أن لم يقض لي % % قاضي القضاة فأين أين وصولي % % PageV01P1701 البحر : - 1(@)(@@) % سل أسياف لحظه % % فالتقتها مقاتلي % % 2(@)(@@) % باخل لا يرق من % % دمع عيني لسائل % % 3(@)(@@) % أنا مجنون حبه % % ودموعي سلاسلي % % 4(@)(@@) % يا هلالا يحل 
ms368	 من % % كبدي في منازل % % 5(@)(@@) % ذكر الله بالنع % % يم ليالي التواصل % % 6(@)(@@) % وسقى عهدها وإن % % عهدت بالشقاء لي ه % % PageV01P1702 البحر : - 1(@)(@@) % أوجز مديحك فالنقام عظيم % % من دونه المنثور والمنظوم % % 2(@)(@@) % من كان في سور الكتاب مديحه % % ماذا تساور فكرة وتروم % % 3(@)(@@) % جبريل راوي نصه الأحلى وفي % % ورق الجنان كتابه مرقوم % % 4(@)(@@) % قل يا محمد تفصح الاكوان عن % % حمد كأن مزاجه تسنيم % % 5(@)(@@) % بدر تالق فالطريق محجة % % لذوي الهداية والصراط قويم % % 6(@)(@@) % حرست بمولده السماء من الذي % % أصغى زمانا فالنجوم رجوم % 7(@)(@@) % وتشرفت أرض بموطيء نعله % % وسمت حصاها فالرجوم نجوم % % 8(@)(@@) % وخبت به نيران فارس آية % % يدري بها من قبل إبراهيم % % 9(@)(@@) % لو لم يكن في صلبه ما بدلت % % نيرانه فرجعن وهي نعيم % % 10(@)(@@) % وكفى لأمته بذاك بشارة % % أن سوف تخمد في الجنان جحيم % % PageV01P1703 11(@)(@@) % هي آية أولى ووسطى تقتضي % % في الحشر أخرى والشفيع كريم % % 12(@)(@@) % ونبوة شفت القلوب وبينت % % ان الكتاب كما رأيت حكيم % % 13(@)(@@) % يا صفوة الرسل الذي لولاه لم % % يثبت على حد المقام كليم % % 14(@)(@@) % كلا ولا سكن الجنان أب ولم % % ينهض إلى روح المسيح رميم % % 15(@)(@@) % الله قد صلى عليك فكل ذي % % مجد لمجدك دأبه التسليم % % 16(@)(@@) % ودعاك في الذكر اليتيم وانما % % أسنى الجواهر ما يقال يتيم % % 17(@)(@@) % سبقت مناقبك السراة ومن سرى % % فوق البراق فسبقه محتوم % % 18(@)(@@) % أنت الامام ورب كل رسالة % % يوم الفخار وراءك المأموم % % 19(@)(@@) % أنت الختام لهم وأنت فخارهم % % وبمسكه فليفخر المختوم % % 20(@)(@@) % أنت الغياث اذا الصحائف نشرت % % وبدا جنا الجنات والزقوم % % PageV01P1704 21(@)(@@) % يوم الفرار من الصديق فماالذي % % صحب سوى العرق الصبيب حميم % % 22(@)(@@) % والخلق شاخصة لجاه مشفع % % فرد الجلال لشأنه التعظيم % % 23(@)(@@) % بمقامك المرفوع يخفض ذنبنا ال % % منصوب ان رجاءنا المجزوم % % 24(@)(@@) % يا أيها البحر المطهر إننا % % طلاب حوضك يوم تسعى الهيم % % 25(@)(@@) % سادت بها الصلوات ما أسرى بنا % % للصبح أشهب والظلام بهيم % % PageV01P1705 البحر : - 1(@)(@@) % هناء محا ذاك العزاء المقدما % % فما عبس المحزون حتى تبسما % % 2(@)(@@) % ثغور ابتسام في ثغور مدامع % % شبيهان 
ms369	 لا يمتاز ذو السبق منهما % % 3(@)(@@) % نرد مجاري الدمع والبشر واضح % % كوابل غيث في ضحى الشمس قد همى % % 4(@)(@@) % سقى الغيث عنا تربة الملك الذي % % عهدنا سجاياه أبر وأكرما % % 5(@)(@@) % ودامت يد النعمى على الملك الذي % % تدانت له الدنيا وعز به الحمى % % 6(@)(@@) % مليكان هذا قد هوى لضريحه % % برغمي وهذا للأسرة قد سما % % 7(@)(@@) % ودوحة ملك شادوي تكافأت % % فغصن ذوى منها وآخر قد نما % % 8(@)(@@) % فقدنا لأعناق البرية مالكا % وشمنا لأنواع الجميل متمما % % 9(@)(@@) % اذا الأفضل الملك اعتبرت مقامه % % وجدت زمان الملك قد عاد مثلما % % 10(@)(@@) % أعاد معاني البيت حتى حسبته % % بوزن الثنا والحمد بيتا منظما % % PageV01P1706 11(@)(@@) % وناداه ملك قد تقادم ارثه % % فقام كما ترضى العلى وتقدما % % 12(@)(@@) % تقابل منه مقلة الدهر سؤددا % % صميما وتنضو الرأي عضبا مصمما % % 13(@)(@@) % ويقسم فينا كل سهم من الندى % % ويبعث للأعداء في الروع أسهما % % 14(@)(@@) % كأن ديار الملك غاب اذا انقضى % % به ظيغم أنشابه الدهر ضيغما % % 15(@)(@@) % كأن عماد البيت غير مقوض % وقد قمت يا أزكى الأنام وأحزما % % 16(@)(@@) % نهضت فما قلنا سيادة معشر % % تداعت ولا بنيان قوم تهدما % % 17(@)(@@) % أما والذي أعطاك ما أنت أهله % % لقد شاد من علياك ركنا معظما % % 18(@)(@@) % وقد أنشر الاسلام بالخلف الذي % % تمكن في عليائه وتحكما % % 19(@)(@@) % فإن يك من أيوب نجم قد انقضى % % فقد أطلعت أوصافك الغر أنجما % % 20(@)(@@) % وإن تك أوقات المؤيد قد خلت % % فقد جددت علياك وقتا وموسما % PageV01P1707 21(@)(@@) % عليه سلام الله ما ذر شارق % % ورحمته ما شاء أن يترحما % % 22(@)(@@) % هو الغيث ولى بالثناء مشيعا % وأبقاك بحرا للمواهب منعما % % 23(@)(@@) % لك الله ما أبهى وأبهر طلعة % وأفضل أخلاقا وأشرف منتمى % % 24(@)(@@) % بك انبسطت فيك التهاني وأنشأت % % ربيع الهنا حتى نسينا المحرما % % 25(@)(@@) % وباسمك في الدنيا استقرت محاسن % وبأس كما يمضي القضاء محتما % % 26(@)(@@) % وفضل به الألفاظ للعجز أخرست % % وعز به قلب الحسود تكلما % % 27(@)(@@) % أعدت حياة المقترين وقد عفت % % فأنت ابن أيوب والا ابن مريما % % 28(@)(@@) % وجددت يا نجل الفضائل والعلى % % من الدين علما 
ms370	 أو من الجود معلما % % 29(@)(@@) % يراعك يوم السلم ينهل ديمة % وسيفك يوم الحرب ينهل في الدما % % 30(@)(@@) % وذكر ندى كفيك يدني من الغنى % % ولثم ثرى نعليك يروي من الظما % % PageV01P1708 31(@)(@@) % لك الملك إرثا واكتسابا فقد غدا % % كلا طرفيه في السيادة معلما % % 32(@)(@@) % ومثلك إما للسرير منعما % يثوب وإما للجواد مطهما % % 33(@)(@@) % ولما عقدنا باسم علياك خنصرا % رأينا من التحقيق أن يتحتما % % 34(@)(@@) % أيا ملكا قد أنجد الناس عزمه % % فأنجد مدح الناس فيه وأتهما % % 35(@)(@@) % سبقت لك المداح قدما وبادرت % % يدا كلمي فاستلزمت منك ملزما % % 36(@)(@@) % ليالي أنشي في أبيك مدائحا % وفيك فأروي مسند الفضل عنكما % % 37(@)(@@) % وأغدو بأنواع الجميل مطوقا % فأسجع في أوصافه مترنما % % 38(@)(@@) % واستوضح العلياء فيك فراسة % % بملكك لا أعطي عليها منجما % % 39(@)(@@) % فعش للورى واسلم سعيدا مهنئا % فحظ الورى في أن تعيش وتسلما % % 40(@)(@@) % وسر في أمان الله قدما بفضله % % أسر الورى مسرى وأيمن مقدما % % PageV01P1709 41(@)(@@) % أعدت زمان البشر والجود والثنا % % إلى أن ملأت العين والأنف والفما % % PageV01P1710 البحر : - 1(@)(@@) % فديت محيا في مسائله ينمي % % فخذ إلى بدر ولحظ إلى سهم % % 2(@)(@@) % و لله قلب في الصبابة والجوى % % أضلته أحداق الحسان على علم % % 3(@)(@@) % وقفت على مغنى الأحبة ناديا % % لما أبلت الأيام منه ومن جسمي % % 4(@)(@@) % وقدم دمعي قصة في رسومه % % فوقع فيها الوجد يجري على الرسم % % 5(@)(@@) % فيالك دمعا من ولي صبابة % % سقى الأرض حتى ما تحن إلى الوسم % % 6(@)(@@) % يقولون حاذر سقم جسمك في الهوى % % ومن لي بجسم تلتقيه يد السقم % % 7(@)(@@) % عشقت على خديك حرف عذارها % % فلم يبق ذاك الحرف مني سوى الاسم % % 8(@)(@@) % اذا فتن الألباب حسنك ساذجا % فما حاجة الخد اليديع إلى الرقم % % 9(@)(@@) % ألم يكفك اللحظ الذي صال وانتشى % % فلم يخل في الحالين من صفة الإثم % % 10(@)(@@) % ومبتسم فيه اللآلي يتيمة % % وليس على أسلاكه ذلة اليتم % % PageV01P1711 11(@)(@@) % يصد بلا ذنب عن الصب ظلمه % % لقد صح عندي أنه بارد الظلم % % 12(@)(@@) % سقى المطر الغادي صباي وصبوتي % % فما كنت الا في ليال وفي حلم 
ms371	 % % 13(@)(@@) % وحيي ديارا بالنقا ومرابعا % بنيت بها هيف القدود على الضم % % 14(@)(@@) % زمان على حكمي تولت هباته % % ولكنها ولت فزالت على رغمي % % 15(@)(@@) % وأملت من إنعام أحمد مسليا % فناجيت وجه النجح من صحة الوهم % % 16(@)(@@) % وراح رجائي يضرب الفأل موقنا % وقامت قوافي الشعر تنظر في النجم % % 17(@)(@@) % اذا لم تجد قاضي القضاة ظماءها % % فأي امريء يروي بنائله الجم % 18(@)(@@) % امام علي عن غاية المدح مجده % % إلى أن حسبنا المدح فيه من الذم % 19(@)(@@) % فلم يكفه أن أذهب الفقر بالندى % % عن الناس حتى أذهب الجهل بالعلم % % 20(@)(@@) % ترى الوفد والسادات من حول شخصه % % كما تشخص الأبصار للقمر التم % % PageV01P1712 21(@)(@@) % تقبل أطراف البساط ثغورهم % % ويقصر ثغر الشهب عن طرف الكم % % 22(@)(@@) % عجبت لمن يردي بهيبته العدى % % ويسطو سطاه كيف يوصف بالحلم % % 23(@)(@@) % ومن يهمل الجاني ويحلم حلمه % % على كل جان كيف يوصف بالعزم % % 24(@)(@@) % يدل لديه المخطئن بجرمهم % % لما أظهروا من شيمة العفو بالجرم % % 25(@)(@@) % ويدعو اليه المعتفين ثناؤه % كما يستدل الطالب الروض بالشم % % 26(@)(@@) % له قلم مد البيان عنانه % % وجال فقال فارس النثر والنظم % % 27(@)(@@) % تعود أن ينشي فتنتج نشوة % % إلى أن ظنناه قضيبا من الكرم % % 28(@)(@@) % وفوق منه الشرع سهم إصابة % % فلا غرو إن أضحى به وافر السهم % % 29(@)(@@) % اذا لاح بين الرفع والخفض شكله % % رأيت القضايا كيف تنفذ بالجزم % % 30(@)(@@) % اليك ثناها الفضل من كل وجهة % وسار ثنا علياك في العرب والعجم % % PageV01P1713 31(@)(@@) % لئن ظن ساع أن ينالك في العلى % % لقد حق عندي ذلك الظن بالرجم % % 32(@)(@@) % أيا ابن السراة المالئين فجاجها % % ردى وندى بوم الكريهة والسلم % % 33(@)(@@) % دعوتك لا أدلي اليك بشافع % ولا سبب إلا بسؤددك الضخم % % 34(@)(@@) % وخفت على قصدي سواك من الورى % % فألفيته من جود كفك في اليم % 35(@)(@@) % وإني وذكري ما حويت من الثنا % % كمن رام تعداد القطار التي تهمي % % 36(@)(@@) % وماذا يقول اللفظ في النجم واصفا % وحسبك أن الله أقسم بالنجم % % PageV01P1714 البحر : - 1(@)(@@) % ليهن بنو الآمال أنك قادم % % لك السعد والاقبال عبد وخادم % % 2 
ms372	(@)(@@) % أرى العمر إلا يوم قربك باطلا % كأني بين الناس بعدك حالم % % 3(@)(@@) % و يظمأ طرفي للقا وهو دامع % فيالك ظام وهو في الماء عائم % % 4(@)(@@) % سقى الغيث عيسا للحجاز ركبتها % % كما ركبت ظهر الرياح الغمائم % % 5(@)(@@) % وحملتها عبء العلوم فمن رأى % % قواعد شرع حملتها قوائم % % 6(@)(@@) % ولما حللت البيت كاد مقامه % للقياك يسعى فهو للسعي قائم % % 7(@)(@@) % وأذكرته في الوفد وفد قديمه % % لأنك للأموال في الجود هاشم % % 8(@)(@@) % يطوف بك المعتر بعد طوافه % % ويلثم بعد الركن كفك لاثم % % 9(@)(@@) % إلى أن ملأت الحجر بالبيت والورى % % لهذا كرامات وهذا مكارم % % 10(@)(@@) % وعدت إلى أوطان يثرب غانما % وفي كل أرض من نداك مغانم % % PageV01P1715 11(@)(@@) % فعاد إلى علم المدينة مالك % وعاد إلى جود البداوة حاتم % 12(@)(@@) % وكادت تبارينا دمشق بشجوها % % اليك وقد تشجى الربى والمعالم % % 13(@)(@@) % لئن أوحشتها منك ربوة سؤدد % % لقد أوحشتها من نداك المقاسم % % 14(@)(@@) % فوافيتها والعيش مقتبل الهنا % % وعزمك مبرور وسرحك سالم % % 15(@)(@@) % تشير لرؤياك الغصون بأنمل % % وتفتر من عجب عليها الكمائم % % 16(@)(@@) % وتهتز أعواد المنابر فرحة % فهل رجعت للعهد وهي نواعم % % 17(@)(@@) % وما هي الا غاب مجد توطنت % % مساكنه أشبالكم والضراغم % % 18(@)(@@) % وعظمتم وقد أحصيتم درجاتها % % كما صدحت فوق الغصون الحمائم % % 19(@)(@@) % اليك جلال الدين أصبحت العلى % % وسلم أعراب الورى والأعاجم % % 20(@)(@@) % اذا ريم خير أو تعرض حادث % % روى نافع عن شيمتيك وعاصم % % PageV01P1716 21(@)(@@) % سبقت إلى الفضل السراة فما لهم % % من الجهد الا أن تعض الأباهم % % 22(@)(@@) % وجدت على داني الديار ونازح % % كأن المداني للبعيد مساهم % % 23(@)(@@) % فما فات رزق من تنبه للسرى % % ومن يتمنى رزقه وهو نائم % % 24(@)(@@) % لك القلم الراقي سحائب أنمل % % تريك رياض الخط وهي بواسم % % 25(@)(@@) % اذا هز في يوم الخطوب فعامل % % وان هز في يوم الخطاب فعالم % % 26(@)(@@) % علوت إلى أن جئت بالشهب منطقا % يضيء به سار وينهل شائم % % 27(@)(@@) % وسكنت من جور الزمان محركا % لأنك بالأفعال في الفضل جازم % % 28(@)(@@) % ونفقت قولي وهو في الدهر كاسد % وحققت ظني وهو في الخلق واهم % % 29 
ms373	(@)(@@) % ونبهت من قدري الذي طال واعتلى % % وأقدار قوم في التراب رمائم % % 30(@)(@@) % وكم مدحة لي فيك عاجلها الغنى % % كما نثرت فوق العروس الدراهم % % PageV01P1717 31(@)(@@) % قطعت بها أيدي وأرجل حاسد % كما تتلوى في الصعيد الأراقم % % 32(@)(@@) % من الاء تسري في دجى من مدادها % % وتجلى كما تجلى النجوم العواتم % % 33(@)(@@) % فخذها صناع اللفظ من متأخر % مضى زمن عن مثلها متقادم % % 34(@)(@@) % مشوقة الممات يحسن رشفها % % فيحلف إلا أنهن مباسم % % 35(@)(@@) % علينا اجتهاد القول فيك وما على % % أخي الجهد أن تقضى الحقوق اللوازم % % 36(@)(@@) % لئن كلفت علياك فكرة مادح % وفاء معانيها لحسنك ظالم % % PageV01P1718 البحر : - 1(@)(@@) % بكيت بأجفان المحب المتيم % % فدع ما بكت قبلا جفون متمم % % 2(@)(@@) % و هيج شوقي في الدجى صوت طائر % % فقل في فصيح شاقة شوق أعجمي % % 3(@)(@@) % ورب عذول لست أفهم قوله % % وان كنت عين السامع المتفهم % % 4(@)(@@) % فان شاء فليسكت وان شاء فليقم % % إلى حيث ألقت رحلها أم قشعم % % 5(@)(@@) % مطيل يرجي أن تحل عقودنا % % فيا عجبا من ناقض الحبل مبرم % % 6(@)(@@) % ويا حربا مما غدوت بلحظه % % قتيل الأسى ما بين نصل ولهذم % % 7(@)(@@) % شهيدا ترى لي فوق وجنتيه دما % روائحه للمسك واللون للدم % % 8(@)(@@) % روائح يعبقن الملا فكأنها % % لذكر علاء الدين في الطيب ينتمي % % 9(@)(@@) % رئيس حوى فضل المكارم شخصه % % كما حوت الالفاظ أحرف يعجم % % 10(@)(@@) % روى الشعر أخبار الندى عن بنانه % % ونص أحاديث التقى كل مسلم % % PageV01P1719 11(@)(@@) % وصحت أسانيد السيادة والنهى % % عن الاذن عن عين البصير عن الفم % % 12(@)(@@) % لئن حاط مصرا والشآم برأيه % % لقد حاط أوطان الحطيم وزمزم % % 13(@)(@@) % كأن فجاج الأرض مما تنورت % % بأوصافه الحسنى منازل أنجم % % 14(@)(@@) % له راحة صلى الحيا خلف جودها % % وأذعن فانظر للمصلي المسلم % % 15(@)(@@) % عجبت لها في الجود تظلم مالها % % وتلك أمان الخائف المتظلم % % 16(@)(@@) % اذا خط فوق الطرس سهم يراعه % % طربت لتخطيط الرداء المسهم % % 17(@)(@@) % فأحسن بذاك الطرس في كل ناظر % % وأعصم بذياك اليراع وأكرم % % 18(@)(@@) % عدا السمر أن تحكي سطاه وبأسه % % فهن متى ما يقرع السن تندم % % 19 
ms374	(@)(@@) % ووفرسعي البيض في حومة الوغى % % فنام إذا في جفنه كل مخدم % % 20(@)(@@) % لك الله ما أزكى وأشرف همة % وأفصح رأيا في الزمان المجمجم % % PageV01P1720 21(@)(@@) % جمعت الندى والزهد والبأس والحجى % % فجد وتورع وامنع الضيم واحلم % % 22(@)(@@) % وجزت بميدان العبادة غاية % تذكرنا يوم السباق ابن أدهم % % 23(@)(@@) % ولما شكونا من جمادى زماننا % % فضلت على نوء الربيع المحرم % % 24(@)(@@) % وأنت الذي لو ملك البدر كفه % % لأنفقته في القاصدين كدرهم % % 25(@)(@@) % إلى بابك الأعلى قصائد مادح % تثنيه على وشي الربيع المنمنم % % 26(@)(@@) % ضربت اليك الرمل سعيا وربما % % ضربنا عليك الرمل عند المنجم % % 27(@)(@@) % وكنت إذا عين الزمان توسمت % % وجدتك أقصى ناظر المتوسم % % 28(@)(@@) % بقيت مدى الأيام تخدم بالهنا % % وكل صناع اللفظ صائبة الرمي % % 29(@)(@@) % يشيب وليد الشعر دون مرامها % % ويرتد عن إدراكها فكر مسلم % % 30(@)(@@) % تقدم حسن المدح حسن مكارم % % لديك وكان الفضل للمتقدم % % PageV01P1721 البحر : - 1(@)(@@) % قاضي القضاة بيمنى حكمه القلم % % يا ساري القصد هذا الباب والعلم % % 2(@)(@@) % هذا اليراع الذي تجني الفخار به % % يد الامام التي معروفها أمم % 3(@)(@@) % إن آلم الحكم فقد الذاهبين فقد % % وافى الهناء فزال اللبس والألم % % 4(@)(@@) % ولى علي ووافى بعد مشبهه % % كالسيل أقبل لما ونت الديم % % 5(@)(@@) % لايبعد الله أيام العلاء فما % % يقضي حقوق ثناها في الأنام فم % 6(@)(@@) % ويمنع الله بالراقي لرتبته % % فقد تشابهت الأخلاق والشيم % % 7(@)(@@) % معيي المماثل في علم وفيض ندى % فالسحب باكية والبحر ملتطم % 8(@)(@@) % وكاتم الصدقات الغر تكرمة % للمرء لوكان عرف المسك يكتتم % % 9(@)(@@) % وافى الشآم وما خلنا الغمام إذا % % بالشام ينشأ من مصر وينسجم % % 10(@)(@@) % آها لمصر وقد شابت لفرقته % % فليس ينكر أن يعزى لها هرم % % PageV01P1722 11(@)(@@) % تقاسمت بعد رؤياه الأسى ودرت % % لأن البلاد لها مثل الورى قسم % % 12(@)(@@) % وأوحش الثغر من مرآي محاسنه % % فما يكاد بوجه الدهر يبتسم % % 13(@)(@@) % ينشي وينشد فيه الثغر من أسف % بيتا تكاد له الأحشاء تضطرم % % 14(@)(@@) % يا من يعز علينا أن نفارقهم % % وجداننا كل شيء بعدكم عدم % % 15(@)(@@) % يزهو الشآم بمن فارقت طلعته % % وا حر قلباه 
ms375	 ممن قلبه شيم % % 16(@)(@@) % نعم الهدى ونجوم الليل حائرة % % والمجتدى وزمان المحل محتدم % % 17(@)(@@) % أقسمت بالمرسلات السمر في يده % % لقد تهيب منها الابيض الخدم % % 18(@)(@@) % وقائل أسرت مسراه قلت له % % نعم المنام الذي أبصرت والحلم % % 19(@)(@@) % لو لم تنم لم تحاول في العلى طرقا % زلت بنجم الثريا دونها القدم % % 20(@)(@@) % كل الفصول ربيع في منازله % % وكل أشهرنا في بابه حرم % PageV01P1723 21(@)(@@) % يا واثق الظن في علياه عش أبدا % وأنت معتضد بالسعد معتصم % % 22(@)(@@) % ورمه إن طاشت الأيام أو بخلت % % فالحلم والجود في ناديه مقتسم % % 23(@)(@@) % هنالك الطود إلا أنه رجل % % في كفه البحر إلا أنه كرم % % 24(@)(@@) % حبر طباق المعالي فيه متضح % فالمال مفترق والمجد ملتئم % % 25(@)(@@) % وللجناس نصيب من مناقبه % % فالفضل والفصل والاحكام والحكم % % 26(@)(@@) % ما يرفع الظن طرفا في مكارمه % % إلا وعزم الرجا بالنجح منجزم % % 27(@)(@@) % لبشره وارتياح المكرمات به % % مقدمات عليها تنتج النعم % % 28(@)(@@) % قالت مناقبه العليا وما أفكت % % هذا التقي النقي الطاهر العلم % % 29(@)(@@) % أهلا بمحتكم الآراء فاصلها % % والقاصدون على جدواه تحتكم % % 30(@)(@@) % كان الزمان لنا حربا نخادعه % % فاليوم ألقي فيما بيننا السلم % % PageV01P1724 31(@)(@@) % وكان مغنى العلى عطلا فقام به % % ركن تطوف به العلياء وتستلم % % 32(@)(@@) % يا حاكما ما رصدنا نجم مقدمه % % إلا انجلت عن ليالي قصدنا الظلم % % 33(@)(@@) % حدوت لي أملا من بعد ما عرفت % % نفسي عن الناس ان ضنوا وان كرموا % % 34(@)(@@) % وكان منطقي العربي ممتنعا % عن الأنام فلا عرب ولا عجم % % 35(@)(@@) % مالي وللشعر في حي وفي زمن % سيان فيه حسام الهند والحلم % % 36(@)(@@) % حتى اذا أشرقت علياك عاطية % % رأيت عقد القوافي كيف ينتظم % % 37(@)(@@) % هدمت بيت الغنى مما تجود به % % فاهنأ بأبيات مدح ليس تنهدم % % 38(@)(@@) % ما بعد علياك يحيى واصف كلما % وليت لو وسعت أوصافك الكلم % % 39(@)(@@) % لا عطلت منك دنيانا ولا فقدت % % نسيم أنفاسك الأرواح والنسم % % PageV01P1725 البحر : - 1(@)(@@) % صيرني في كل واد أهيم % % من حظ قلبي منه هاء وميم % % 2(@)(@@) % مبخل يشبه ريم الفلا % % واطول شجوي من بخيل كريم % % 3 
ms376	(@)(@@) % لم أنس في حبه كم ليلة % خلفني أرعى دجاها البهيم % % 4(@)(@@) % نظرت في أنجمها نظرة % فقال لي جسمي أني سقيم % % 5(@)(@@) % شوقا لمن لست على حبه % % بصالح لكن قلبي كليم % % 6(@)(@@) % بدر على غصن جديد الحيا % % فخل عرجون الهلال القديم % % 7(@)(@@) % وأقسم بواو القسم الصدق من % % صدغيه أن ليس له من قسيم % % 8(@)(@@) % ولا تخلني سامعا لومة % أعوذ بالله السميع العليم % % 9(@)(@@) % في شرعة البين وحكم الأسى % % جفن نزوح وغرام مقيم % % 10(@)(@@) % وثابت الود لديغ الحشا % % يأتي إلى الله بقلب سليم % % PageV01P1726 11(@)(@@) % يا روضة تجني بألحاظنا % % فنجتني حر الشقا من نعيم % % 12(@)(@@) % كن كيفما شئت وعن مهجتي % % فلا تسل عن حال أهل الجحيم % % 13(@)(@@) % ما الشمس الا وجهك المجتلي % % وما الحيا الا ندى ابن العديم % % 14(@)(@@) % كمال دين الله من غيثه % % قد ألحق النائي بخصب المقيم % % 15(@)(@@) % لا يسأل القاصد عن بابه % % إلا سنا النمشر وطيب الشميم % % 16(@)(@@) % ماذا لقينا في حديث الثنا % % من مجده المتضح المستقيم % % 17(@)(@@) % الناطق الواصف في خجلة % % بالعجز والساكت عين الأثيم % % 18(@)(@@) % ذو طلعة في البشر كم ناظرت % % بدرا فأمسى خده كاللطيم % % 19(@)(@@) % وهمة في الفضل كم جاورت % % غيثا فولى غيمه كالهزيم % % 20(@)(@@) % قاض قضى العدل ولكنه % % قضى على المال قضاء الغريم % % PageV01P1727 21(@)(@@) % ما فطمت من كرم كفه % % من قبل ما أدرك سن الفطيم % % 22(@)(@@) % جاء النهى يسأل ميلاده % فبشروه بغلام حليم % % 23(@)(@@) % لا عيب فيه غير نعمى يد % يمشي شذا أنفاسها بالنسيم % % 24(@)(@@) % من معشر سادوا وساسوا الورى % % ببأس قاس ويجدوى رحيم % % 25(@)(@@) % مثل النجوم الزهر كم مهتد % بها من الناس وكم من رجيم % % 26(@)(@@) % تطوف الاشعار من حولهم % % فائزة ما سعيها بالذميم % % 27(@)(@@) % وخير ماطاف لنسك العلى % % بيت نظيم حول بيت عظيم % % 28(@)(@@) % يا عمر الخير لقد نبهت % % منك المعالي طراف راع حكيم % % 29(@)(@@) % لا زلت ذا ذكر كثير السرى % % بكل أرض وندى لا يريم % % 30(@)(@@) % كم عادنا منك ندى مشهر % لواحظ المدح وأمن منيم % % PageV01P1728 31(@)(@@) % وكم رأيناك لمربى الثنا % % أبا فجئناك بدر 
ms377	 يتيم % % PageV01P1729 البحر : - 1(@)(@@) % رب عيش كأس مدامه % % ومليح ضممت غصن قوامه % % 2(@)(@@) % تائه أقنع الهلال افتخارا % انه قد غدى مثال لثامه % % 3(@)(@@) % عربي إلى كنانة معزا % % ه ولكن لحاظه من سهامه % % 4(@)(@@) % ضائع العين كل سهران فيه % % ضيعة القاف في حروف كلامه % % 5(@)(@@) % هب في جامه كخمرة فيه % وسقاني فوه كخمرة جامه % % 6(@)(@@) % وجفاني بعد اللقاء فيا نا % % ر فؤاد المحب بعد سلامه % % 7(@)(@@) % ويح صب يخفى بكميه دمعا % وهو كالزهر لاح في أكمامه % % 8(@)(@@) % سحرته العيون سحر ابن محمو % % د بنفث البيان من أقلامه % % 9(@)(@@) % الرئيس الذي به غنى النا % % س عن الغيث وارتقاء غمامه % % 10(@)(@@) % وثقوا أن غدوا ضيوفا لابرا % % هيم أن النجاح حول مقامه % % PageV01P1730 11(@)(@@) % لم يقيسوا الحيا بجدواه لكن % % بشروه من الحيا بغلامه % % 12(@)(@@) % أكمل العالمين فضلا فما نس % % أل رب العباد غير دوامه % % 13(@)(@@) % أي حر لو لم تفضل ذووه % % لكفته في الفضل نفس عصامه % % 14(@)(@@) % وجواد لو لم يعم سخاه % % لحبا من صلاته وصيامه % % 15(@)(@@) % وبليغ لو قام أهل المعاني % % قال أسى من قولهم في منامه % % 16(@)(@@) % فاض فيض الغمام في الجوج لا قص % % د مديح الغنى ولا خوف ذامه % % 17(@)(@@) % وحمى الدين إذ سما فله الفض % % ل على كل سام دهر وحامه % % 18(@)(@@) % ما روى الناس في التواريخ قدما % مارووا للسماح في أيامه % % 19(@)(@@) % عد بالخنصر المقدم إذ أو % % ضح وجه البيان من إبهامه % % 20(@)(@@) % ودرى المدح عجزه عنه لكن % % خاف عنه الكتمان من آثامه % % PageV01P1731 21(@)(@@) % يا رئيسا نرجو به أدب الده % % ر لأنا نراه من خدامه % % 22(@)(@@) % دم هنيئا بألف صوم وفطر % مسعد في اقتباله وانصرامه % % 23(@)(@@) % من غدا طاهرا كطهرك فينا % % كان كل الشهور شهر صيامه % % 24(@)(@@) % أو غدا جائدا كجودك فينا % % كان كل الأوقات أعياد عامه % % 25(@)(@@) % فاز حر أمسيت مغزى رجاه % % وزمان أصبحت صدر منامه % % PageV01P1732 البحر : - 1(@)(@@) % بكيت ليلا بوجدي وهي تبتسم % % حتى تقايس منثور ومنتظم % % 2(@)(@@) % دمع يجاوب مسراه تبسمها % % كالروض يضحك حيث الغيث ينسجم % % 3(@)(@@) % لا كنت 
ms378	 يا قلب كم تصبيك غانية % يعدي أخا اللحظ من ألحاظها السقم % % 4(@)(@@) % أحسن بها ظبية بالسفح تمنعها % % أسد الكماة لها من اسمها أجم % % 5(@)(@@) % عدمت لبي من وجد بها وكذا % % جفني فالآنم لا حلم ولا حلم % 6(@)(@@) % وأغيد لم أخف فيه الذنوب ولا % % جرى على خده من عارض قلم % 7(@)(@@) % يصان حتى كأن الخمر ما حرمت % % إلا لكيلا تحاكي ريقه الشيم % % 8(@)(@@) % ما اهتز كالغصن في أوراقه بردته % % إلا تساقط من أجفاني الغيم % 9(@)(@@) % كانت غواية قلبي في محبته % % مجهولة السبل لا هاد ولا علم % % 10(@)(@@) % يسلو الشجي ولفظي كله غزل % % ويستفيق وقلبي حشوه ألم % PageV01P1733 11(@)(@@) % فالحب عندي وإن طال الملام به % % كالجود عند ابن صصري مشرع أمم % % 12(@)(@@) % حتى اذا صغت في قاضي القضاة حلا % % مدح تطهر فكر بارع وفم % 13(@)(@@) % أندى البرية والأنواء باخلة % % وأسبق الخلق والسادات تزدحم % % 14(@)(@@) % حبر تجاوز حد المدح من شرف % كالصبح لا غرة تحكى ولا رئم % % 15(@)(@@) % لكنها نفحات من مدائحه % % تكاد تحيي بها في رسمها الرمم % % 16(@)(@@) % مجود الهم للعلياء إذ عجزت % % عنها السراة وقالوا إنها قسم % % 17(@)(@@) % تصنعوا ليحاكوا صنع سؤدده % % ياشيب كم جهد ما قد يكتم الكتم % % 18(@)(@@) % يمضي الزمان وما خابت لديه يد % سعيا إلى المجد لازلت به قدم % % 19(@)(@@) % رام الأقاصي حتى حازها ومضى % % تبارك الله ماذا تبلغ الهمم % % 20(@)(@@) % لا يطرد المحل الاصوب نائله % % ولا يجول على أفكاره الندم % PageV01P1734 21(@)(@@) % في كل يوم ينادي جود راحته % % هذا فتى الندى لا ما دعى هرم % % 22(@)(@@) % يمم حماه ودافع كل معضلة % مهيبة الحرم تعلم أنه حرم % % 23(@)(@@) % واحسن ولاء أياديه فما سفلت % % عزيمة بولاء النجم تلتزم % % 24(@)(@@) % واسعد بمن حاطت الإسلام همته % % حتى تغاير فيها العلم والعلم % % 25(@)(@@) % نعم الملاذ لمن أودت به سنة % % شهباء آثارها في عينه حمم % % 26(@)(@@) % لو أن للدهر جزأ من محاسنه % % لم يبق في الدهر لا ظلم ولا ظلم % % 27(@)(@@) % قالت أياديه للقصاد عن كثب % ماأقرب المجد إلا أنها همم % % 28(@)(@@) % مما أناف به 
ms379	 للمجد إن له % % عرفا يرى فرص الاحسان تغتنم % % 29(@)(@@) % والمجد لا تنثني يوما معالمه % % إلا اذا راح مبنى المال ينهدم % % 30(@)(@@) % وللسيادة معنى ليس يدركه % % من طالب الذكر إلا باحث فهم % PageV01P1735 31(@)(@@) % فليت كل بخيل ينثني بطرا % فداء نعل فتى أودى به الكرم % % 32(@)(@@) % تستشرف الأرض ما حلت مواطنه % % كأنما الوهد في آثاره أكم % % 33(@)(@@) % لمعشر هم لمن ولا هم نعم % هنيئة ولمن عاداهم نقم % 34(@)(@@) % تفرق المجد في الأحياء من قدم % والمجد في تغلب العلياء ملتئم % % 35(@)(@@) % الطاعنين وحر الحرب ملتهب % % والمطمعين وحر الجدب ملتهم % % 36(@)(@@) % والشائدين على كيوان بيت علا % تسعى النجوم بمغناه وتستلم % % 37(@)(@@) % من كل أروع سام طرف سؤدده % % أغر قد ناولته الراية البهم % 38(@)(@@) % مضوا وأحمد زاهي المجد مقتبل % % كالروض أقبل لما ولت الديم % % 39(@)(@@) % يا مانحي مننا من بعدها منن % ما شأنها منك لا عي ولا سأم % 40(@)(@@) % ومظهرا لي في دهر يمجمج بي % % كأنما أنا حرف فيه مدغم % PageV01P1736 41(@)(@@) % شكرا لفضلك ما غنت مطوقة % % وما تتاوح غب الوابل السلم % % 42(@)(@@) % لله برك ما أحلى تكتمه % % في الخلق لو كان عرف المسك يكتتم % % 43(@)(@@) % وافى وقد حذر الحساد من حنق % أن يبصروه فلما أبصروه عموا % % 44(@)(@@) % وطالما كنت والأيام في رهج % فاليوم ألقى فيما بيننا السلم % % 45(@)(@@) % وفتية أنت أحظى من رجاي بها % % يفنى الثراء وتبقى هذه الكلم % % 46(@)(@@) % يا باغي المجد لا والله ما بلغت % % معشار سعيك هذي العرب والعجم % % 47(@)(@@) % وحسد خففت أحشاؤهم حنقا % % كأنها بيد الأحزان تلطم % 48(@)(@@) % أستهكم بثناء فيك غاظهم % غيظ البزاذين لما عضت اللجم % % 49(@)(@@) % أهواك للشيم اللاتي خصصت بها % % اذا تخيرت الأفعال والشيم % % 50(@)(@@) % ما زاد في قول واش غير طيب ثنا % كند يعبق حيث الجمربضطرم % % PageV01P1737 51(@)(@@) % حاشاك حاشاك أن تلقاك شائبة % وان تطرق في أفعالك التهم % % 52(@)(@@) % هم حدثوني فما صدقت ما نقلوا % % وأوهموني فما حققت ما زعموا % % 53(@)(@@) % فليهن مجدك إذ يعلو وقد سفلوا % % وليهن رأيك اذ يزكو وقد أثموا % % 54(@)(@@) % أما الشآم فقد أغنيت 
ms380	 قاصده % % حتى اشتكتك الفلا والاينق الرسم % % 55(@)(@@) % لولاك للطائفين العاكفين به % % لم يبق ركن من النعمى وملتزم % % 56(@)(@@) % خذها عروسا وبكرا بنت ليلتها % % أسيلة الخد في عرنينها شمم % % 57(@)(@@) % لولا أياديك ما ضمت على أمل % يد ولم ينفتح لي بالثنآء فم % % 58(@)(@@) % نوعا من الشعر لا يدعى سواك له % % إن المدائح كالعليا لها قيم % % 59(@)(@@) % هوت إلى لثمه الافواه مسرعة % % كأنما كل ميم فيه مبتسم % % 60(@)(@@) % فهنأ الله عاف أنت نجعته % % وخائفا بك في اللأواء يعتصم % % PageV01P1738 61(@)(@@) % ليشكرنك مني الدهر أربعة % نفس وروح ولحم نابت ودم % % PageV01P1739 البحر : - 1(@)(@@) % رمى حشاي ويا شوقي إلى الرامي % % لحظ برامة من ألحاظ آرام % % 2(@)(@@) % رهنت في الحب نومي عند ناظره % % لما اقترضت لجسمي منه أسقامي % % 3(@)(@@) % أفدي الذي كنت عنه كاتما شجني % % حتى وشى نبت خديه بنمام % % 4(@)(@@) % ممنع الوصل كم حالمت من شغف % عداي فيه وكم عاديت أحلامي % % 5(@)(@@) % ظلمت خديه بالألحاظ أجرحها % % وحسن خديه ظلام لظلام % % 6(@)(@@) % وما لبست به من أدمعي خلعا % الا ووشي دمي فيها كأعلام % % 7(@)(@@) % يا ليت شعري وقلبي فيه ممتحن % ما ذا على عذلي فيع ولوامي % % 8(@)(@@) % لا تخش من عاذل قد جا يحاورني % % يا سالبي في الهوى حلمي وأحلامي % % 9(@)(@@) % وحق عينيك مالي في محبتها % % سمع لعين ولا ذال ولا لام % % 10(@)(@@) % ولا لفكري من شمس ومن قمر % % سوى جبيني في صبحي وإظلامي % % PageV01P1740 11(@)(@@) % سقيا لمعهد أنس كان يسند لي % % بوجهه الطلق عن بشر ابن بسام % % 12(@)(@@) % حيث النسيم يجر الذيل من طرب % والزهر يرقص من عجب بأكمام % % 13(@)(@@) % والنهر طرس تخط الريح أسطره % % والقطر يتبع ما خطت بإعجام % % 14(@)(@@) % والكأس في يد ساقيها مصورة % % تضيء من حول كسرى ضوء بهرام % % 15(@)(@@) % قد أسرجت وعدت للهم ملجمة % % فهي الكميت باسراج وإلجام % % 16(@)(@@) % أنشئ بها العيش ينمو من محاسنه % % ما ليس يحصره الناشي ولا النامي % % 17(@)(@@) % وأجتلي كأسها والشمس ما جليت % % و لا ترشف منها الشرق في جام % % 18(@)(@@) % شهور وصل كساعات قد انقرضت % % بمن أحب وأعوام 