ms1241	 تتكلم ، وينجيك من الحسد أن لا تبغي أخا سوء ) )(@)(@@) ( هب ) عن إسماعيل بن أمية مرسلا .(@)(@@)(@@)(@@) $ ( 10932 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يكترثون للحساب ، ولا تفزعهم الصيحة ، ولا يحزنهم الفزع الأكبر : حامل القرآن مؤديه إلى الله بما فيه ، يقدم على ربه سيدا شريفا حتى يوافق المرسلين ، ومن أذن سبع سنين لا يأخذ على أذانه طمعا ، وعبد مملوك أدى حق الله من نفسه وحق مواليه ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10933 ) قال النبي :(@)(@@) | 30 ( ثلاثة يدخلون الجنة بغير حساب : رجل غسل ثيابه فلم يجد له خلفا ، ورجل لم ينصب على مستوقد قدرين ، ورجل دعا بشراب فلم يقل أيهما تريد ) )(@)(@@) أبو الشيخ في الثواب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10934 ) قال النبي :(@)(@@) | 30 ( ثلاثة يظلهم الله تعالى يوم لا ظل إلا ظله : التاجر الأمين ، والإمام المقتصد ، وراعي الشمس بالنهار ) )(@)(@@) ( ك ) في تاريخه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10935 ) قال النبي :(@)(@@) | 30 ( ثلاثة لعنتهم : أمير ظالم ، وفاسق قد أعلن بفسققه ، ومبتدع يهدم سنة ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10936 ) قال النبي :(@)(@@) | 30 ( ثلاثة لعنهم الله تعالاى : رجل رغب عن والديه ، ورجل سعى بين رجل وامرأته يفرق بينهما ثم يخلف عليها من بعده ، ورجل سعى بين المؤمنين بالأحاديث ليتباغضوا ويتحاسدوا ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10937 ) قال النبي :(@)(@@) | 30 ( ثلاثة أصوات يحبها الله : صوت الديكة ، وصوت الذي يقرأ القرآن ، وصوت المستغفرين بالأسحار ) )(@)(@@) الديلمي عن أم محمد بنت زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10938 ) قال النبي :(@)(@@) | 30 ( ثلاثة حق واجب علاى الله تعالاى أن يؤدي عنهم : PageV04P177 رجل مملوك كاتب نفسه ثقة بالله تعالاى فحق علاى الله تعالاى أن يؤدي عنه ويعينه ، ورجل تزوج ليستعفف عما حرم الله فحق علاى الله أن يعينه ويرزقه ، ورجل اشترى أرضا خرابا فعمرها فحق علاى الله أن يبارك له فيها ويؤجره ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10939 ) قال النبي :(@)(@@) | 30 ( ثلاثة يستغفر لهم السماوات والأرض والليل والنهار والملائكة : العلماء والمتعلمون والأسخياء ) )(@)(@@) أبو 
ms1242	 الشيخ في الثواب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10940 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تمسهم النار : المرأة المطيعة لزوجها ، والولد البار بوالديه ، والمرأة الصبورة علاى عدة زوجها ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10941 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تمسهم فتنة الدنيا والآخرة : المقر بالقدر ، والذي لا ينظر في النجوم ، والمتمسك بسنتي ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10942 ) قال النبي :(@)(@@) | 30 ( ثلاثة يدخلون النار : رجل قاتل للدنيا ، وعالم أراد أن يذكر لا يحتسب علمه ، ورجل وسع عليه فجاد به للثناء والدنيا ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10943 ) قال النبي :(@)(@@) | 30 ( ثلاثة يستوجبون المقت من الله تعالاى : الأكل من غير جوع ، والنوم من غير سهر ، والضحك من غير عجب ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10944 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا حرمة لهم : فاسق معلن بفسقه ، وصاحب هوى ، وسلطان جائر ) )(@)(@@) الديلمي عن الحسن عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10945 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا حرمة لهم : النائحة لا حرمة لها ملعون PageV04P178 كسبها ، والمغنية لا حرمة لها ممحوق مالها ملعون من اتخذها ، وآكل الربا لا حرمة له ممحوق ماله ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10946 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يسألون عن نعيم المطعم والمشرب : المفطر ، والمتسحر ، وصاحب الضيف ، وثلاثة لا يلامون علاى سوء الخلق : المريض ، والصائم حتى يفطر ، والإمام العادل ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10947 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تقبل لهم صلاة : رجل أم قوما وهم له كارهون ، والعبد إذا أبق حتى يرجع إلى مولاه ، والمرأة إذا باتت مهاجرة لزوجها عاصية له ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10948 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تقبل صلاتهم : المرأة تخرج من بيتها بغير إذنه ، والعبد الآبق ، والرجل يؤم القوم وهم له كارهون ) )(@)(@@) ( ش ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10949 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينبغي لأحد أن يردهن : اللبن ، والدهن ، والوسادة ) )(@)(@@) الروياني ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10950 ) قال 
ms1243	 النبي :(@)(@@) | 30 ( ثلاثة لا يخيب قائلهن أو فاعلهن : ثلاث وثلاثون تسبيحة دبر الصلاة ، وثلاث وثلاثون تحميدة وأربع وثلاثون تكبيرة ) )(@)(@@) ابن النجار عن كعب ابن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10951 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يجدون ريح الجنة وإن ريحها ليوجد في مسيرة خمسمائة عام : العاق لوالديه ، ومدمن الخمر ، والبخيل المنان ) )(@)(@@) ابن جرير عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 10952 ) قال النبي :(@)(@@) | 30 ( ثلاثة لاينظر الله إليهم يوم القيامة ولا يكلمهم : PageV04P179 رجل باع مرابحه كذبه ، ورجل حلف علاى يمين كاذبة بعد العصر ، ورجل منع فضل ماء عن أهل الطريق ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10953 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم يوم القيامة ولا يزكيهم ولهم عذاب أليم : رجل كان له فضل ماء بالطريق فمنعه من ابن السبيل ، ورجل بايع إماما لا يبايعه إلا للدنيا ، فإن أعطاه منها رضي ، وإن لحم يعطه منها سخط ، ورجل أقام سلعة بعد العصر فقال : والله الذي لا إلاه غيره لقد أعطيت بها كذا وكذا فصدقه رجل فأخذها ولم يعط بها ) )(@)(@@) ( عب حم خ د ت ه ) و ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10954 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يقبل لهم صلاة ولا تصعد إلاى السماء ، ولا تجاوز رؤوسهم : رجل أم قوما وهم له كارهون وامرأة باتت وزوجها ساخط عليها ، ومملوك أبق من مولاه ) )(@)(@@) ابن خزيمة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10955 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يعادون : صاحب الرمد ، وصاحب الضرس ، وصاحب الدمل ) )(@)(@@) ( عد ) و الخليلي في مشيخته والرافعي في تاريخه ( هب ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10956 ) قال النبي :(@)(@@) | 30 ( ثلاثة يدعون الله فلا يستجاب لهم : رجل أعطى ماله سفيها ، وقد قال الله عز وجل : ولا تؤتوا السفهاء أموالكم ، ورجل له امرأة سيئة الخلق فلا يطلقها ، ورجل بايع ولم يشهد ) )(@)(@@) ابن عساكر عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10957 ) قال النبي :(@)(@@) | 30 ( ثلاثة يوم القيامة علاى كثيب من مسك أسود لا يهولهم الفزع ولا ينالهم الحساب حتى 
ms1244	 يفرغ الله مما بين الناس : رجل قرأ القرآن PageV04P180 ابتعغاء وجه الله تعالى وأم به قوما وهم به رآصون ، ورجل أذن في مسجد دعا إلاى الله ابتغاء وجه الله ، ورجل مملوك ابتلي بالرق في الدنيا فلم يشغله ذالك عن طلب الآخرة ) )(@)(@@) ( هب ) و أبو نصر السجزي في الإبانة والخطيب عن أبي هريرة وأبي سعيد رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 10958 ) قال النبي :(@)(@@) | 30 ( ثلاثة يوم القيامة علاى كثبان المسك لا يحزنهم الفزع الأكبر ، ولا يكترثون للحساب : رجل قرأ القرآن محتسبا ، ورجل أذن محتسبا ، ومملوك أدى حق الله وحق مواليه ) )(@)(@@) ابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10959 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يهولهم الفزع الأكبر ولا الحساب حتى يحشروا إلاى الجنة علاى كثبان من مسك أسود : رجل جمع القرآن قام به قومه وهم به راضون ابتغاء وجه الله ، ورجل يدعو إلاى خمس صلوات بالليل والنهار يبتغي وجه الله عز وجل ، ورجل مملوك لم يمنعه الرق أن يطلب ما عند الله ) )(@)(@@) ( حل ) و أبو النصر في الإبانة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10960 ) قال النبي :(@)(@@) | 30 ( ثلاثة تشتاق إليهم الحور العين : علي ، وعمار ، وسلمان ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10961 ) قال النبي :(@)(@@) | 30 ( ثلاثة يحبهم الله تعالاى ويضحك إليهم ويستبشر بهم : الذي إذا انكشفت فئة قاتل وراءها بنفسه لله فاما أن يقتل وإما أن ينصره الله ويكفيه ، فيقول : انظروا إلاى عبدي هاذا كيف صبر لي بنفسه ، واللذي له امرأة حسنة وفراش لين حسن فيقوم من الليل ، فيقول : يذر شهوته فيذكرني ولو شاء رقد ، والذي إذا كان في سفر وكان معه ركب فسهروا ثم هجعوا فقام من السحر في سراء وضراء ) )(@)(@@) ( طب ك ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10962 ) قال النبي :(@)(@@) | 30 ( ثلاثة من أعمال الجاهلية لا يتركهن الناس : PageV04P181 الطعن في الأنساب ، والنياحة ، وقولهم مطرنا بنجم كذا وكذا ) )(@)(@@) ( طب ) عن كثير بن عبد الله عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 10963 ) قال النبي :(@)(@@) | 30 ( ثلاثة أحجار ليس في شيء منها رجيع يستطيب 
ms1245	 بها ) )(@)(@@) عبد الرزاق عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10964 ) قال النبي :(@)(@@) | 30 ( ثلاثة أحجار عند الخلاء ليس منهن رجيع ) )(@)(@@) عبد الرزاق عن رجل من مزينة عن أبيه .(@)(@@)(@@)(@@) $ ( 10965 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يهولهم الفزع الأكبر ولا ينالهم الحساب هم علاى كثيب من مسك حتى يفرغ من حساب الخلائق : رجل قرأ القرآن ابتغاء وجه الله وأم به قوم وهم يرضون به ، وداع يدعو إلاى الصلوات الخمس ابتغاء وجه الله ، وعبد أحسن فيما بينه وبين ربه وفيما بينه وبين مواليه ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10966 ) قال النبي :(@)(@@) | 30 ( ثلاثة يتبطحون علاى كثبان المسك يوم القيامة في الجنة : رجل دعا إلاى الصلوات الخمس في اليوم والليلة يبتغي بذالك وجه الله تعالاى ، ورجل تعلم كتاب الله تعالاى ثم أم به قوما وهم به راضون ، وعبد مملوك لم يشغله رزق الدنيا عن طاعة الله ) )(@)(@@) ( عب ) عن اسماعيل بن أبي خالد مرسلا .(@)(@@)(@@)(@@) $ ( 10967 ) قال النبي :(@)(@@) | 30 ( ثلاثة لهم أجرهم مرتين : عبد أدى حق الله وحق سيده ، ورجل أعتق سريته ثم نكحها ، أو مسلمة أهل الكتاب ) )(@)(@@) ( عب ) عن عمر بن دينار رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ ( 10968 ) قال النبي :(@)(@@) | 30 ( ثلاثون آية سورة الملك تمنع من عذاب القبر وتسمى في التوراة المانعة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P182(@)(@@)(@@)(@@) ||| ( الثاء مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10969 ) قال النبي :(@)(@@) | 30 ( ثمانية أبغض خليقة الله إليه يوم القيامة : السقارون وهم الكذابون ، والخيالون وهم المستكبرون ، والذين يكنزون البغضاء لاخوانهم في صدورهم فإذا لقوهم تخلقوا لهم ، والذين إذا دعوا إلاى الله ورسوله كانوا بطاء وإذا دعوا إلاى الشيطان وأمره كانوا سراعا ، والذين لا يشرف لهم طمع من الدنيا إلا استحلوه وإن لم يكن لهم ذالك بحق ، والمشاؤون بالنميمة ، والمفرقون بين الأحبة ، والباغون البرآء الدحضة ، أولائك يقذرهم الرحمان عز وجل ) )(@)(@@) أبو الشيخ في التوبيخ وابن عساكر عن الوضين بن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 10970 ) قال النبي :(@)(@@) | 30 ( ثمن الجنة لا إلاه إلا الله ) )(@)(@@) ( عد ) و ابن مردوية عن 
ms1246	 أنس عبد بن حميد في تفسيره عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10971 ) قال النبي :(@)(@@) | 30 ( ثمن الخمر حرام ، ومهر البغي حرام ، وثمن الكلب حرام ، والكوبة حرام ، وإن أتاك صاحب الكلب يلتمس ثمنه فاملأ يديه ترابا ، والخمر والميسر حرام ، وكل مسكر حرام ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10972 ) قال النبي :(@)(@@) | 30 ( ثمن القينة سحت وغناؤها حرام والنظر إليها حرام ، وثمنها مثل ثمن الكلب ، وثمن الكلب سحت ، ومن نبت لحمه علاى السحت فالنار أولاى به ) )(@)(@@) ( طب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10973 ) قال النبي :(@)(@@) | 30 ( ثمن الكلب خبيث ، ومهر البغي خبيث ، وكسب PageV04P183 الحجام خبيث ) )(@)(@@) ( حم م د ت ) عن رافع بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10974 ) قال النبي :(@)(@@) | 30 ( ثمن الكلب خبيث وهو أخبث منه ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10975 ) قال النبي :(@)(@@) | 30 ( ثمرة طيبة وماء طهور ) )(@)(@@) عبد الرزاق ( حم د ت ) وضعفه ( ه هق ) عن ابن مسعود أن النبي قال ليلة الجن ما في إداوتك قال : نبيذ ، قال فذكره عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10976 ) قال النبي :(@)(@@) | 30 ( ثمن الجرسة حرام وأكلها حرام ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الثاء مع النون(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10977 ) قال النبي :(@)(@@) | 30 ( ثنتان ما تردان : الدعاء عند النداء ، وتحت المطر ) )(@)(@@) ( ك ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10978 ) قال النبي :(@)(@@) | 30 ( ثنتان لا تردان : الدعاء عند النداء ، وعند البأس حين يلحم بعضهم بعضا ) )(@)(@@) ( د حب ك ) عن سهل بن سعد رضي الله عنه .(@)(@@) PageV04P184(@)(@@)(@@)(@@) ||| ( الم ح لى ب أل م ن ها ذا الح رف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10979 ) قال النبي :(@)(@@) | 30 ( الثابت في مصلاه بعد صلاة الصبح يذكر الله تعالاى حتى تطلع الشمس أبلغ في طلب الرزق من الضرب في الآفاق ) )(@)(@@) ( فر ) عن عثمان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10980 ) قال النبي :(@)(@@) | 30 ( الث