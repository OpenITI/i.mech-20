ms121	 أبوابه لم تغلق % PageV01P422 11(@)(@@) % تفتح أبواب الملوك لوجهه ، % بغير حجاب دونه أو تملق % 12(@)(@@) % لتبك عليه الأنس والجن إذ ثوى % % فتى مضر في كل غرب ومشرق % 13(@)(@@) % فتى عاش يبني المجد تسعين حجة % و كان إلي الخيرات والمجد يرتقي % % 14(@)(@@) % فما مات حتى لم يخلف وراءه % بحية واد صولة غير مصعق % PageV01P423 البحر : طويل 1(@)(@@) % لقد علموا أن الكتيبة كبشها % % بحجر إذا لاقى الكمي ابن مالك % 2(@)(@@) % هو الذائد الحامي الحقيقة بالقنا % % و في المحل زاد المرملين الصعالك % % 3(@)(@@) % مشى وعصى بالسيف والليل مظلم % إلى بطل قد هابه كل فاتك % PageV01P424 البحر : طويل 1(@)(@@) % قولي لهم يا عبل قد خاب فينكم % و غير وجه القين ذرو السنابك % 2(@)(@@) % فما ضر ما قلتم مهاة تصرفت % بعطف التقى ترعى هجول الدكادك % 3(@)(@@) % لعبلة فرع الحي قد تعلمونه ، % و أطيب عرق في الثرى المتدارك % 4(@)(@@) % لها خنزوان في خزيمة لم تزل % تنقل منه في سنام وحارك % 5(@)(@@) % تنافس فيها عبد شمس وهاشم % إذا قيل من صهر الكريم المشارك % PageV01P425 البحر : وافر تام 1(@)(@@) % ألا تصحو وتقصر عن صبكا % % و هذا الشيب أصبح قد علاكا % % 2(@)(@@) % أمن دمن ، بلين ببطن قو ، % بكيت لها ، وشجو ما بكاكا % % 3(@)(@@) % تباعد من وصالك أي بعد ، % ولو تدنو قتلت بها هواكا % % 4(@)(@@) % إذا ما جردت فنقا كثيب % و في القرى هيكلة ضناكا % % 5(@)(@@) % ألا يا حبذا جرعات قو ، % وحيث يقابل الأثل الأراكا % % 6(@)(@@) % وقد لاح المشيب ، فما أراه % عداك وقد صبوت ولا نهاكا % % 7(@)(@@) % فليتك قد قضيت بذات عرق % % ومن نجد وساكنه مناكا % % 8(@)(@@) % تذاد عن المشارع ، كل يوم ، % ووردك لو وردت به كفاكا % % 9(@)(@@) % أتهوى من دعاك لطول شجو ؛ % و من أضنى فؤادك إذ دعاكا % % 10(@)(@@) % فكيف بمن أصاب فؤاد صب % بذلك لو يشاء لقد شفاكا % % PageV01P426 11(@)(@@) % و قد كانت قفيرة ذات قرن % ترى في زيغ أكعبها أصطكاكا % % 12(@)(@@) % أتفخر بالحبى ، وخزيت فيها % % وقبل اليوم ، ما فضحت حباكا % % 13(@)(@@) % قد انبعث الأخيطل غبر فان % و لا غمر وقد بلغ احتناكا 
ms122	 % % 14(@)(@@) % و ما قرأ المفصل تغلبي % ولا مس الطهور ولا السواكا % % 15(@)(@@) % و لا عرفوا مواقف يوم جمع % و لا حوض السقاية والأراكا % % 16(@)(@@) % أيوعدني الأخيطل من بعيد ، % وقد لاقى أسنتنا شباكا % % 17(@)(@@) % رويد الجهل ان لنا بناء % إذا ما رمته قصرت يداكا % % 18(@)(@@) % تعلم إن أصلي خندفي ، % ستعلم مبتناي ومبتناكا % % 19(@)(@@) % لنا البدر المنير ، وكل نجم ، % ولا بدرا تعد ، ولا سماكا % % 20(@)(@@) % و انك لو تصعد في جبالي % % تباعد ، من نزولك ، مرتقاكا % % PageV01P427 21(@)(@@) % تلاقي العيص ، ذا الشبوات دوني % % وورد الخيل تعترك اعتراكا % % 22(@)(@@) % وحيا ، يقربون بنات قيد ، % بها منعوا المليحة واللكاكا % % 23(@)(@@) % إذا ما عد فضل حصى تميم ، % تحاقر ، حين تجمعه ، حصاكا % % 24(@)(@@) % حمت قيس بدجلة عسكريها % % فأنهب يوم دجلة عسكراكا % % 25(@)(@@) % هم حدروك من نجد فأمست % مع الخنزير قاصية نواكا % % 26(@)(@@) % تكفر باليدين إذا التقينا % % و تلقى من مخافتنا عصاكا % % 27(@)(@@) % عطاء الله تكرمة وفضلا % بسخطك ليس ذلك عن رضاكا % % 28(@)(@@) % رشتك مجاشع سكرا بفلس ، % فلا يهنيك رشوة من رشاكا % % 29(@)(@@) % أليس الله فضل سعي قوم ، % هداهم للصراط وما هداكا % % 30(@)(@@) % تكفر باليدين إذا التقينا % % و أد إلى خليفتنا جزاكا % % PageV01P428 31(@)(@@) % أتزعم ذا المناخر كان سبطا % يهوديا ، ونزعمه أباكا % % PageV01P429 البحر : وافر تام 1(@)(@@) % أجد اليوم جيرتك ارتحالا % % و لا تهوى بذي العشر الزيالا % % 2(@)(@@) % قفا عوجا على دمن برهبي % % فحيوا رسمهن وان أحالا % % 3(@)(@@) % وشبهت الحدوج غداة قو ، % سفين الهند روح من أوالا % % 4(@)(@@) % جعلن القصد عن شطب يمينا ، % و عن أجماد ذي بقر شمالا % % 5(@)(@@) % جمعن لنا مواعد معجبات % و بخلا دون سؤلك واعتلالا % % 6(@)(@@) % أوانيس لم يعشن بعيش سوء % يجددن المواعد والمطالا % % 7(@)(@@) % فقد أفنين عمرك ، كل يوم ، % بوعد ما جزين به قبالا % % 8(@)(@@) % و لة يهوين ذاك سقين عذبا % على العلات آونة زلالا % % 9(@)(@@) % و لكن الحماة حموك عنه % فما تسقى على ظمإ بلالا % % 10(@)(@@) % ألا تجزين ودي في ليال ، % وأيام ، وصلت به طوالا % % PageV01P430 11(@)(@@) % أحب الظاعنين غداة قو % و لا اهوى المقيم به الحلالا 
ms123	 % % 12(@)(@@) % لقد ذرفت دموعك يوم ردوا % % لبين الحي فاحتملوا الجمالا % % 13(@)(@@) % و في الأظعان مثل مهى رماح % نصبن له المصايد والحبالا % % 14(@)(@@) % فما أشوين حين رمين قلبي % % سهاما لم يرشن لها نبالا % % 15(@)(@@) % وولكن بالعيون وكل خد ، % تخال به ، لبهجته ، صقالا % % 16(@)(@@) % لعمرك ما يزيدك قرب هند ، % إذا ما زرتها ، إلا خبالا % % 17(@)(@@) % و قد قال الوشاة فأفزعونا % % ببعض القول نكره أن يقالا % % 18(@)(@@) % رأيتك يا أخيطل إذ جرينا % % و جربت الفراسة كنت فالا % % 19(@)(@@) % و قد نخس الفرزدق بعد جهد % فألقى القوس إذ سئم النضالا % % 20(@)(@@) % ونحن الأفضلون ، فأي يوم ، % تقول التغلبي رجا الفضالا % % PageV01P431 21(@)(@@) % ألم تر أن عز بني تميم % بناه الله يوم بني الجبالا % % 22(@)(@@) % بني لهم رواسي شامخات ، % و عالي الله ذروته فطالا % % 23(@)(@@) % بنى لي كل أزهر خندفي ، % يباري ، في سرادقه ، الشمالا % % 24(@)(@@) % تنصفه البرية وهو سام % و يمسي العالمون له عيالا % % 25(@)(@@) % تواضعت القروم لخندفي % اذا شئنا تخمط ثم صالا % % 26(@)(@@) % ويسعى التغلبي ، إذا اجتبينا ، % بحزيته وينتظر الهلالا % % 27(@)(@@) % لقيتم ، بالجزيرة ، خيل قيس % فقلتم مار سرجس لا قتالا % % 28(@)(@@) % فلا خيل لكم صبرت لخيل % و لا أغنت رجالكم رجالا % % 29(@)(@@) % و أسلتم شعيث بني مليل % أصاب السيف عاتقه فمالا % % 30(@)(@@) % شربت الخمر بعد أبي غويث % % فلا نعمت لك النشوات بالا % % PageV01P432 31(@)(@@) % تسوف التغلبية وهي سكرى % % قفا الخنزير ، تحسبه غزالا % % 33(@)(@@) % تظل الخمر تخلج أخدعيها % % وتشكو في قوائمها امذلالا % % 34(@)(@@) % أتحسب فلس أمك كان مجدا % % و جدكم عن النقد الجفالا % % 36(@)(@@) % تناول ما وجدت أباك يبني ، % فأما الخندفي فلن تنالا % % 37(@)(@@) % أليس أبو الأخيطل تغلبيا ؟ % فبئس التغلبي أبا وخالا % % 38(@)(@@) % إذا ما كان خالك تغلبيا % فبادل إن وجدت له بدالا % % 39(@)(@@) % ويربوع تحل ذرى الروابي ، % و تبني فوقها عمدا طوالا % % 41(@)(@@) % وقد علق الأخيطل حبل سوء ، % فأبرح يومهن به وطالا % 42(@)(@@) % ألم تر يا اخيطل حرب قيس % تمر إذا ابتغ يت لها العلالا % % 43(@)(@@) % إذا لم تصح نشوتكم فذوقوا % % سيوف الهند والأسل النهالا % % PageV01P433 البحر : - 1 
ms124	(@)(@@) % إن الذي بعث محمدا % جعل الخلافة في الامام العادل % 2(@)(@@) % و لقد نفعت بما منعت تحلارجا % مكس العثور على جسور الساحل % 3(@)(@@) % قد نال عدلك من أقام بأرضنا ، % فإليك حاجة كل وفد راحل % 4(@)(@@) % إني لآمل منك خيرا عاجلا ، % و النفس مولعة بحب العاجل % 5(@)(@@) % والله أنزل في الكتاب فريضة ، % لابن السبيل وللفقير العائل % PageV01P434 البحر : وافر تام 1(@)(@@) % أغرتنا أمامة ، فافتحلنا % % أمامة ، إذ تنجبت الفحول % 2(@)(@@) % إذا ما كان فحلك فحل سوء % خلجت الفحل أو لؤم الفصيل % % PageV01P435 البحر : طويل 1(@)(@@) % أقول لأصحابي أربعوا من مطيكم % فيوم لنا ، بالقريتين ، ظليل % 2(@)(@@) % أحب من الفتيان مثل محرق ، % و شيبان إن الكاملينقليل % 3(@)(@@) % فإن يشهدا يوم الحفيظة يطعنا ، % وإن يك سؤل فالعطاء جزيل % PageV01P436 البحر : متقارب تام 1(@)(@@) % ألست اللئيم وفرخ اللئيم % فما لك يا ابن أبي كامل ؟ % 2(@)(@@) % أخالفت سعدا وحكامها ، % أيا ضرة الأرنب الحافل % 3(@)(@@) % فلولا زيدا وحسن البلاء % وأني أهاب أبا كامل % 4(@)(@@) % لنال أبا كامل وابنه % صواعق من برد وابل % PageV01P437 البحر : بسيط تام 1(@)(@@) % خف القطين فقلبي اليوم متبول % بالأعزلين ، وشاقتني العطابيل % % 2(@)(@@) % قربن بزلا تغالى ، في أزمتها ، % إلى الخدور ، ورقما فيه تهويل % 3(@)(@@) % ما زلت أنظر حتى حال دونهم % خرق أمق بعيد الغول مجهول % 4(@)(@@) % تيه يحار به الهادي إذا اطردت % فينا وفي الخيل تردي في مساحلها % % 5(@)(@@) % كأن أعناقها دلق يمانية ، % إذا تغالت ، وأدناها المراقيل % 6(@)(@@) % لحق التوالي بأدييها إذا اندفعت % أعناقهن بسوم فيه تبغيل % 7(@)(@@) % كأنما مرحت ، من تحت أرحلنا ، % قطا قوارب أو ربد مجافيل % 8(@)(@@) % أقصر بقدرك ! إن الله فضلنا ، % وما لما قد قضى ذو العرش تبديل % 9(@)(@@) % بنى لي المجد في عيطاء مشرفة % أبناء حنظلة الصيد المباجيل % 10(@)(@@) % المطعمون إذا هبت شآمية % والجابرون وعظم الرأس مهزول % PageV01P438 11(@)(@@) % و الغر من سلفي سعد وإخوتهم % عمر و كهول وشبان بهاليل % 12(@)(@@) % إذا دعا الصارخ الملهوف هجت به % مثل الليوث جلا عن غلبها الغيل % 13(@)(@@) % تحمي الثغور وتلقاهم إذا فزعوا % % تعدو بهم قرح جرد هذا ليل % % 14(@)(@@) % تلقى 
ms125	 فوارسنا يحمون قاصينا ، % وفي أسنتنا للناس تنكيل % 15(@)(@@) % كم من رئيس عليه التاج معتصب % قد غادرته جيادي وهو مقتول % 16(@)(@@) % قادوا الهذيل بذي بهدى وهم رجعوا % % يوم الغبيط ببشر وهو مغلول % 17(@)(@@) % أسد إذا لحقوا بالخيل لم يقفوا % % نعم الفوارس لا عزل ولا ميل % 18(@)(@@) % % يوم الوغى لمنايا القوم تعجيل % 19(@)(@@) % عوذ النساء غداة الروع تعرفنا % % إذا دعون دعاء فيه تخليل % % 20(@)(@@) % اذا لحقنا بها تردى الجياد بنا % % لم تخش نبوتنا العوذ المطافيل % PageV01P439 21(@)(@@) % تلقى السيوف بأيدينا يعاذ بها % % عند الوغى حين لا تخفي الخلاخيل % 22(@)(@@) % فمن يرم مجدنا العادي ثم يقس % قوما بقومي يرجع وهو مفضول % 23(@)(@@) % حكام فصل وتلقى ، في مجالسنا ، % أحلام عاد إذا ما أهذر القيل % 24(@)(@@) % إني امرؤ مضري في أرومتها % % مشهورة غرتي فيهم وتحجيلي % % 25(@)(@@) % ألأثقلون حصاة في نديهم % والأرزنون ، إذا خف المجاهيل % 26(@)(@@) % إنا وجدنا بني القبحاء ليس لهم % في بني نزار قداميس ولا جول % % 27(@)(@@) % قوم توارث أصل اللؤم أولهم ، % فما لهم عن ديار اللؤم تحويل % 28(@)(@@) % محالفو اللؤم آلى لا يفارقهم % حتى يرد على أدراجه النيل % 29(@)(@@) % قد ارتدوا برداء اللؤم واتزروا ، % وقطعت لهم منه سرابيل % PageV01P440 البحر : طويل 1(@)(@@) % عشية أعلى مذنب الجوف قادني ، % هوى كادينسي الحلم أو يرجع الجهلا % % 2(@)(@@) % عشية تعصني غروب مدامعي ، % و إن قلت أحيانا لعبرتها مهلا % % 3(@)(@@) % و ما خفت وشك البين حتى رأيتهم % لظعنهم ردوا الغريرية البزلا % % 4(@)(@@) % أحب لحب العاصمية معشرا % من الناس ما كانوا صديقا ولا أهلا % % 5(@)(@@) % وأرعاهم بالغيب من أجل حبها ، % وأوليهم مني الكرامة والبذلا % % 6(@)(@@) % لقد جمحت عرس الفرزددق والتوى % % بحدراء قوم لم يروه لها أهلا % % 7(@)(@@) % رأوا أن صهر القوم عار عليهم % وأن لبسطام على غالب فضلا % % 8(@)(@@) % دعت يال ذهل رغبة عن مجاشع % وهل بعدها حدراء داعية ذهلا % % 9(@)(@@) % وفيم ابن ذي الكيرين من بيت خالد % % و هل يجمع البيت اللخنانيص والنحلا % % 10(@)(@@) % و لو رقعت كيريك كانت كظاعن % % من الغيث يختار الجدوبة والمحلا % % PageV01P441 11(@)(@@) % فقد منع القين الجواز 
ms126	 وقد يرى % % لشيبان عين الماء والعطن السهلا % % 12(@)(@@) % هم منعوا عرس الفرزدق والتووا % % عليه فلاقى دونها عتبا بسلا % % 13(@)(@@) % وما رد قوم الحوفزان عليكم % ظلامى وما قالوا لصاحبهم مهلا % % 14(@)(@@) % وقد بات مغترا بحدراء قينكم ، % ونام ولم يجعل على قيدها قفلا % % 15(@)(@@) % ونام وما أسرى وأسرت وأصبحت % تأمل ، من أنقاء أسنمة ، رملا % % 16(@)(@@) % فقد عوفيت حدراء شيبان أن ترى % % حليلة قين أو يكون لها بعلا % % 17(@)(@@) % غذا فوزت عن مسحلان ودافعت % بشيبان لاقى القين من دونها شغلا % % 18(@)(@@) % وهم نزعوا بالروع قلب ابن حابس % كما استوفضت خيل بكتبها الا بلا % % 19(@)(@@) % غضبت علينا أن منعنا مجاشعا % قديما معين الماء فاحتفروا الضحلا % % 20(@)(@@) % إلا إنما جرت على خوف مالك % قلوب تساقين النواكة والجهلا % % PageV01P442 21(@)(@@) % و قد طال أبسى قبل ذاك مجاشعا % بحدراء يلقون الصواعق والأزلا % % 22(@)(@@) % وما نوخوها قينكم آل ضوطر % لألأم من يحذى على قدم نعلا % % 23(@)(@@) % وما رغبوا في صهر آل مجاشع % وما إن رأوا شكل القيون لهم شكلا % % 24(@)(@@) % أبعد ترامينا ثلاثين حجة % فقد صرت يا ابن القين لا تدرك التبلا % % 25(@)(@@) % إذا ما تراجعنا صككتك صكة % ترى بعد تزييل العظام لها دحلا % % 26(@)(@@) % و حبلكم غر الزبير فلم يكن % ليلأمن جار بعده لكم حبلا % % 27(@)(@@) % قفوا فاسألوا الأقوام من ينهل القنا % % و من يكشف البلوى ومن يمنع الأصلا % % 28(@)(@@) % ومن يقتل الأبطال والخيل تنبري % % بفرسانها ورد القطا غللا ضحلا % % 29(@)(@@) % ألا رب جبار سلبناه تاجه ، % فأصبح فينا عانيا يشتكى الكبلا % % PageV01P443 البحر : وافر تام 1(@)(@@) % ألا حي الديار وإن تعفت % وقد ذكرن عهدك بالخميل % 2(@)(@@) % و كم لك بالمجيمر من محل % و بالعزاف من طلل محيل % 3(@)(@@) % وقد خلت الطلول من آل ليلى % % فما لك لا تفيق عن الطلول % 4(@)(@@) % وإن قال العواذل : قد شجاه % محل الحي من لبب الأميل % 5(@)(@@) % لقد شعف الفؤاد غداة رهبي % تفرق نية الأنس الحلول % 6(@)(@@) % إذا رحلوا جزعت ، وإن أقاموا ، % فما يجدي المقام على الرحيل % 7(@)(@@) % أخلاى الكرام سوى سدوس % وما لي 
ms127	 في سدوس من خليل % 8(@)(@@) % إذا أنزلت رحلك في سدوس ، % فقد أنزلت منزلة الذليل % % 9(@)(@@) % و قد علمت سدوس أن فيها % % منار اللؤم واضحة السبيل % % 10(@)(@@) % فما أعطت سدوس من كثير ؛ % و لا حامت سدوس عن قليل % PageV01P444 البحر : طويل 1(@)(@@) % منافتي الفتيان والجود معقل % و منا الذي لاقى بدجلة معقلا % % 2(@)(@@) % و منا أميرا يوم صفين والذي % % أعاد قضاء الأشعري مغربلا % % PageV01P445 البحر : بسيط تام 1(@)(@@) % هاج الشجون برهبى ربع أطلال ، % وقد مضى مر أحوال وأحوال % 2(@)(@@) % بان الشباب وقال الغانيات له : % أودى الشباب وأودى عصرك الخالي % % 3(@)(@@) % قد كن يرهبن من صرمي مباعدة ، % فاليوم يهزأن من صرمي وإدلالي % % 4(@)(@@) % قيس البراجم شر الخلق كلهم % أخزاهم رب جبريل وميكال % 5(@)(@@) % الظاعنون على أهواء نسوتهم % والخافضون بدار غير محلال % 6(@)(@@) % لقد توجس ميجاس فعاينه % معاود جر أوصال وأوصال % 7(@)(@@) % جهم المحيا هزبر ذو مجاهرة % يدني الفريسة من غيل وأشبال % 8(@)(@@) % ماذا أردت إلى أنياب ذي لبد ، % مفرس لرقاب الأسد رئبال % 9(@)(@@) % أخزيت قومك يا ميجاس إذ غلقت % رهن الجياد ومد الغاية الغالي % % 10(@)(@@) % لو كان غيرك يا ميجاس يشتمنا % % يا دودة الحش يا ضل بن ضلال % PageV01P446 11(@)(@@) % عبد تعصب من لؤم عصابته ، % إلى قلنسوة منه وسربال % 12(@)(@@) % يا أعين الهام إني قد وسمتكم % فوق الأنوف علوبا غير اغفال % 13(@)(@@) % تغشى النباج بنو قيس بن حنظلة % والقريتين بسراق ونزال % 14(@)(@@) % أكل يوم ترى القيسي ضائفكم % % كأنه ليس في أهل ولا مال % 15(@)(@@) % إن القتيل الذي جرت بنو قطن ، % أن سب ، قرحان ، لا ذاك ولا عالي % % 16(@)(@@) % قوم هم قتلوا بالكلب ضابئكم % حتى استمات هزالا شر ما حال % 17(@)(@@) % ردوا الهوان عليهم يا بني قطن % ردوا الهوان على المستتبع التالي % % 19(@)(@@) % أخوالي الشم من عمرو بن حنظلة % وما اللئام بنو قيس بأخوالي % % 20(@)(@@) % قومي الذين إذا عدت مكارمهم % فديت أيامهم بالعم والخال % 21(@)(@@) % الصادعون على الجبار بيضته % و الحاملون أمورا ذات أثقال % PageV01P447 22(@)(@@) % لو تنسبون ليربوع فتعرفكم % أو مالك أو عبيد جد نزال % 23 
ms128	(@)(@@) % أذا لقالوا : هجا قوما ذوي حسب ، % يأوون منه إلى دفء وأظلال % % PageV01P448 البحر : وافر تام 1(@)(@@) % لقد نادى أميرك باحتمال % و صدع نية الأنس الحلال % 2(@)(@@) % أمن طرب نظرت غداة رهبى % % لتنظر أين وجه بالجمال % 3(@)(@@) % وما كلفت نفسك من صديق % يمينا ويبخل بالنوال % 4(@)(@@) % لقد تركت حوائم صاديات % و تمنع صفوذي حبب زلال % 5(@)(@@) % و قالت فيم أنت من التصابي % % متى عهد التشوق والدلال % 6(@)(@@) % فما ترجو وليس هوى الغواني % % لأصحاب التنحنح ، والسعال % 7(@)(@@) % دعيني ! إن شيبي قد نهاني ، % وتجريبي ، وشيبي ، واكتهالي % % 8(@)(@@) % رأت مر السنين أخذن مني ، % كما أخذ السرار من الهلال % 9(@)(@@) % ومن يبقى على غرض المنايا ، % وأيام تمر مع الليالي % % 10(@)(@@) % ألم بنا الخيال بذات عرق ، % فحيا الله ذلك من خيال % PageV01P449 11(@)(@@) % فان سراك تقصر عن سرانا % % و عن وخد المخدمة العجال % 12(@)(@@) % لقد أخزى الفرزدق إذ رمينا % % قوارع صدعت غرض النضال % 13(@)(@@) % فإن لآخر الشعراء مني ، % كما للأولين من النكال % 14(@)(@@) % مواسم ما بقيت لهم وبعدي % % مواسم عند حزرة أو بلال % 15(@)(@@) % على أنف الفرزدق لو نهاهم % جديد من وسومي غير بال % 16(@)(@@) % إذا مات الفرزدق فارجموه ، % كما ترمون قبر أبي رغال % 17(@)(@@) % و كنت إذا اغتربت بدار قوم % لأحساب العشيرة شر والي % % 18(@)(@@) % تجدع ما أقمت بها ذليلا % و تخزي عند منزلى ة الزيال % 19(@)(@@) % أتنسون الزبير قتيل سعد ، % و جعثن إذ تصرف كل حال % 28(@)(@@) % و بات أبو الفرزدق وهو يدعو % % بدعوى الذل غير نعيم بال % PageV01P450 29(@)(@@) % لقد ضربت قفيرة بالخلايا % % و حوك الدرع من وبر الفصال % 30(@)(@@) % تطيف مجاشع وبنو حميس % بقين بين شر أب وخال % 31(@)(@@) % قفيرة ساء ما كسبت بنيها % % و ليلى القين قين بني عقال % 32(@)(@@) % أتتهم بالفرزدق أم سوء % لدى حوض الحمار على مثال % 35(@)(@@) % سيخزيك الخليفة ثم تخزي % % بعزة ذي التكرم والجلال % % 36(@)(@@) % % و تمهر ما كدحت من السؤال % 37(@)(@@) % تبدل يا فرزدق مثل قومي % % بقومك إن قدرت على البدال % 38(@)(@@) % فإن أصبحت تطلب ذاك فانقل % % شماما والمقر 
ms129	 إلى وعال % 39(@)(@@) % ليربوع على النخبات فضل ، % كتفضيل اليمين على الشمال % 40(@)(@@) % ويربوع تذبب عن تميم ، % ويقصر دون غلوهم المغالي % % PageV01P451 41(@)(@@) % ونازلنا الملوك بذات كهف ، % و قد خضبت من العلق العوالي % % 42(@)(@@) % و قد ضرب ابن كبشة إذ لحقنا % % حشيش حيث تفرقه الفوالي % % 43(@)(@@) % الفوالي مكارم لست مدركهم حتى % % تزيل الراسيات من الجبال % 44(@)(@@) % خذوا كحلا ومجمرة وعطرا % فلستم يا فرزدق بالرجال % 45(@)(@@) % و شموا ريح عيبتكم فلستم % يا فرزدق بالرجال % 46(@)(@@) % و شموا ريح عيبتكم فلستم % بأصحاب العناق ولا النزال % 47(@)(@@) % بلاء بني قباقب كان خزيا % و عارا كلما ذكر التبالي % % 48(@)(@@) % صفقتم للبزاة حباريات % فأخزى الخنثيين مني الضلال % 49(@)(@@) % و كنت إذا لقيت بني هلال % و كعبا ة الفوارس من هلال % 50(@)(@@) % تقرقر يا فرزدق إذ فزعتم % خزيرا بات في أدر ثقال % PageV01P452 51(@)(@@) % و عبس بالثنيى ة يوم عمرو % سقوه ذواعف الأسل النهال % 52(@)(@@) % ومعبدكم دعا عدس بن زيد % فأسلم للكبول بشر حال % 53(@)(@@) % و كنت غذا لقيت بني نمير % لقيت الموت أقتم ذا ظلال % 54(@)(@@) % كأنكم بأمعز واردات ، % نعام الصيف زف مع الرئال % 55(@)(@@) % فأرسل في الضئيين مجاشعيا ، % أزب المنخرين ، أبا رخال % PageV01P453 البحر : كامل تام 1(@)(@@) % أمست طهية كالبكار أفزها % % بعد الكشيش ، هدير قرم بازل % 2(@)(@@) % يا يحى هل لي في حياتك حاجة % من قبل فاقرة وموت عاجل % 4(@)(@@) % حلت طهية من سفاهة رأيها ، % منى على سنسن الملح الوابل % 5(@)(@@) % أطهي قد غرق الفرزدق فاعلموا % % في اليم ثم رمى به في الساحل % 6(@)(@@) % من كان يمنع يا طهي نساءكم ، % أم من يكر وراء سرح الجامل % 7(@)(@@) % ذاك الذي ، وأبيك ، تعرف مالك ، % والحق يدمغ ترهات الباطل % 8(@)(@@) % إنا تزيد على الحلوم حلومنا % % فضلا ونجهل فوق جهل الجاهل % % PageV01P454 البحر : بسيط تام 1(@)(@@) % قالوا : نصيبك من أجر ، فقلت لهم : % من للعرين إذا فارقت أشبالي % % 2(@)(@@) % لكن سوادة يجلو مقلتي لحم % باز يصرصر فوث المرقب العالي % % 3(@)(@@) % قد كنت أعرفه مني إذا غلقت % رهن الجياد ومد الغاية الغالي % % 4(@)(@@) % إلا تكن 
ms130	 لك بالديرين باكية % فرب باكية بالرمل معوال % 5(@)(@@) % كأم بو عجول ، عند معهده ، % حنت إلى جلد منه وأوصال % 6(@)(@@) % ترتع ما نسيت حتى إذا ذكرت % ردت هماهم حرى الجوف مثكال % 7(@)(@@) % زدنا على وجدها وجدا وإن رجعت % في القلب منها خطوب ذات بلبال % % 8(@)(@@) % فارقتني حين كف الدهر من بصري % % و حين صرت كعظم الرمة البالي % % 9(@)(@@) % إن الثوي بذي الزيتون ، فاحتسبي ، % قد أسرع اليوم في عقلي وفي حالي % % PageV01P455 البحر : وافر تام 1(@)(@@) % علام تلوم عاذلة جهول % و قد تلى رواحلنا الرحيل % 2(@)(@@) % فان السيف يخلق محملاه % ويسرع في مضاربه النحول % 3(@)(@@) % قطعن إليكم متشنعات ، % مهامه ما يعد لهن ميل % 4(@)(@@) % أتين على السماوة بعد خبت ، % قليل ما تأنينا قليل % 5(@)(@@) % و قد عز الكواهل بعدني % عرائكها ، وقد لحق الثميل % 6(@)(@@) % عليك ، وإن بليت كما بلينا ، % سلام الله ، أيتها الطلول % 7(@)(@@) % أبان الحي يوم لوى حي % نعم بانوا ولم يشف الغليل % 8(@)(@@) % ليالي لا تودعنا بصرم % فتؤيسنا ، ولا بجدا تنول % 9(@)(@@) % كأنك حين تشحط عنك سلمى % % أميم حين تذكره تبيل % % 10(@)(@@) % ذكرنا ما نسيت غداة قو ، % و قد يهتاج ذو الطرب الوصول % PageV01P456 11(@)(@@) % أعاذل ما للومك لا أراه % يفيق ، وشر ذي النصح العذول % 12(@)(@@) % سليمان المبارك ، قد علمتم ، % هو المهدي قد وضح السبيل % 13(@)(@@) % أجرت من المظالم كل نفس % % وأديت الذي عهد الرسول % 14(@)(@@) % صفت لك بيعة بثبات عهد % % فوزن العدل أصبح لا يميل % 15(@)(@@) % ألا هل للخليفة في نزار ، % فقد أمسوا وأكثرهم كلول % 16(@)(@@) % وتدعوك الأرامل واليتامى ، % و من أمسى وليس به حويل % % 17(@)(@@) % و تشكو الماشيات اليك جهدا % ولا صعب لهن ولا ذلول % 18(@)(@@) % وأكثر زادهن ، وهن سفع ، % حطام الجلد والعصب المليل % 19(@)(@@) % ويدعوك المكلف بعد جهد ، % و عان قد أضر به الكبول % % 20(@)(@@) % و ما زالت معلقة بثدي % بذي الديماس أو رجل قتيل % PageV01P457 21(@)(@@) % فرجت الهم والحلقات عنهم % فأحيا الناس والبلد المحول % 22(@)(@@) % إذا ابتدر المكارم كان فيكم % ربيع الناس والحسب الأثيل % 23(@)(@@) % تهينون المخاض لكل ضيف 
ms131	 % إذا ما حب في السنة الجميل % 24(@)(@@) % علوتم كل رابية وفرع ، % وغيركم المذانب والهجول % 25(@)(@@) % لكم فرع تفرع كل فرع ، % و فضل لا تعادله الفضول % 26(@)(@@) % لقد طالت منابتكم فطابت ، % فطاب لك العمومة والخؤول % 27(@)(@@) % تزول الراسيات بكل أفق ، % ومجدك لا يهد ولا يزول % PageV01P458 البحر : كامل تام 1(@)(@@) % من ذا يعد بني غدانة للعلى % % و الخير بعد عطية بن جعال % 2(@)(@@) % كان الممانح في العرية بعدما % % ألقى الشتاء أصرة الأشول % 3(@)(@@) % و مدفعين جفا الأقارب عنهم % حلوا إليك بدمثة محلال % PageV01P459 البحر : طويل 1(@)(@@) % إليك كلفنا كل يوم هجيرة % صد معمعاني تلظى أعابله % % 2(@)(@@) % على العيس تعروري الفلاة كأنها % % قطا الأدمى الجوني نشت ثمائله % % 3(@)(@@) % طوى ركبه الإخماس حتى كأنها % % جياد القنا الهندي ثقف ذابله % 4(@)(@@) % إذا قلت لي عبد العزيز كفيتني % % زمانا فشت علاته ومباخله % 5(@)(@@) % فيومان من عبد العزيز تفاضلا ، % ففي أي يوميه تلوم عواذله % 6(@)(@@) % فيوم تحوط المسلمين جياده ؛ % ويوم عطاء ما تغب نوافله % 7(@)(@@) % وللترك ، من عبد العزيز ، وقيعة ، % وللرم يوم ما تتم حوامله % 8(@)(@@) % فما وجدوا عبد العزيز مغمرا ، % ولا ذا سقاط عند أمر يحاوله % 9(@)(@@) % ولا جافيا عن قائم السيف قبضه % إذا الفشل الرعديد قفت أنامله % 10(@)(@@) % يقيض بالفضلين ، فضل مفاضة % و فضل نجاد لم تقطع حمائله % PageV01P460 11(@)(@@) % فلا هو من الدنيا مضيع نصيبه ، % و لا عرض الدنيا عن الدين شاغله % % 12(@)(@@) % فهذا بديع ليس في الناس مثله % وهذا مديح لا يكذب قائله % 13(@)(@@) % أبينا فما يدعو إلى غيرك الهوى % % وما من خليل بابن ليلى نبادله % 14(@)(@@) % أتى زمن البيضاء بعدك فانتحى % % على العظم حتى أسلمته حوامله % % 15(@)(@@) % فرش لي جناحي واتخذني بازيا ، % تخطف حبات القلوب أجادله % PageV01P461 البحر : طويل 1(@)(@@) % كاد مجيب الخبث تلقى يمينه % طبرزين مقضبا للمفاصل % 2(@)(@@) % تداركه عفو المهاجر ، بعدما % % دعا دعوة يالهفه عند نائل % 3(@)(@@) % فان غفل الراعي الذي نام بالحمى % % فان بحجر راعيا غير غافل % 4(@)(@@) % وقعت بأيدي المحرزيين وقعة % نهت باسلا عنا وأصحاب باسل % PageV01P462 البحر : وافر تام 1(@)(@@) % أتنسى 
ms132	 يوم حومل والدخول ، % و موقفنا على الطلل المحيل % 2(@)(@@) % و قالت قد نحلت وشبت بعدي % % بحق الشيب بعدك والنحول % 3(@)(@@) % كان الراح شعشع في زجاج % بماء المزن في رصف ظليل % 4(@)(@@) % يقول لك الخليل أبا فراس % لحى الله الفرزدق من خليل % 5(@)(@@) % خرجت من العراق وأنت رجس % تلبس في الظلال ثياب غول % 6(@)(@@) % وما يخفى عليك شراب حد % و لا ورهاء غائبة الحليل % % 9(@)(@@) % إذا دخل المدينة فارجموه % ولا تدنوه من جدث الرسول % 10(@)(@@) % لقد علم الفرزدق أن تيما % على شرب إذا نهلوا وبيل % 11(@)(@@) % لنا السلف المقدم يا ابن تيم % إذا ما ضاق مطلع السبيل % 12(@)(@@) % وأفخر بالقماقم من تميم ، % وتفخر بالخبيث ، وبالقليل % PageV01P463 13(@)(@@) % فلن تسطيع يا ابن دعي تيم ، % على دحض ، مزاحمة القيول % 14(@)(@@) % كأن التيم ، وسط بني تميم ، % خصي بين أحصنة فحول % 15(@)(@@) % أعبد التيم إن تميم % تلبس فيهم أجمي وغيلي % % 16(@)(@@) % وإني قد رميتك من تميم % بعبء لا تقوم له ثقيل % 17(@)(@@) % فرغت من القيون وعض تيما % فرند الوقع ليس بذي فلول % 18(@)(@@) % وقلت نصاحة لبني عدي : % ثيابكم ونضح دم القتيل % 19(@)(@@) % اعبت فوارسا رجعوا بتيم % و ركضهم مبادرة الأصيل % 20(@)(@@) % فرد المردفات بنات تيم % ليربوع فوارس غير ميل % 21(@)(@@) % تداركنا عيينة وابن شمخ ، % وقد مرا بهن على حقيل % 22(@)(@@) % رأوا قعس الظهور بنات تيم % تكشف عن علاهبة رعول % PageV01P464 23(@)(@@) % لقد خاقت بحوري أصل تيم % فقد غرقوا بمنتطح السيول % 24(@)(@@) % قرنت أبا اللئام ، أباك تيما ، % بأدفي في مناكبه صؤول % 25(@)(@@) % بزيد مناة يحطم كل عظم % بوازله وزدن على البزول % 26(@)(@@) % علا تيما فدق رقاب تيم ، % ثقيل الوطء ذو جرز نبيل % 27(@)(@@) % لقيت لنا حوامي راسيات ، % و جولا يرتمي بك بعدجول % 28(@)(@@) % كأن التيم إذ فخرت بسعد % إماء الحي تفخر بالحمول % 29(@)(@@) % ترى التمي يزحف كالقرنبي % إلى تيمية ، كعصا المليل % 30(@)(@@) % إذا كشرت إليه يقول : بلوى % % بلا حسن كشرت ولا جميل % 31(@)(@@) % تشين الزعفران عروس تيم % وتمشي مشية الجعل الزحول % 32(@)(@@) % يقول المجتلون : عروس تيم % شوى أم 
ms133	 الحبين ورأس فيل % PageV01P465 33(@)(@@) % و لو غسلت بساقيتي دجيل % لقالت : ما اكتفيت من الغسول % 36(@)(@@) % إذا ما استبعرت كلحت إليه % بقحف في عنية مستبيل % PageV01P466 البحر : طويل 1(@)(@@) % شعفت بعهد ذكرته المنازل % وكدت تناسى الحلم والشيب شامل % 2(@)(@@) % لعمرك لا أنسى ليالي منعج % و لا عاقلا إذ منزل الحي عاقل % 3(@)(@@) % وما نام إذ بات الحواضن ولها ، % ولكن هوانا المنفسات العقائل % 4(@)(@@) % ألا حبذا أيام يحتل أهلنا % % بذات الغضا والحي في الدار آهل % % 5(@)(@@) % و إذ نحن ألاف لدى كل منزل % ولما تفرق للطيات الجمائل % 6(@)(@@) % و إذ نحن لم يولع بنا الناس كلهم % وما ترتجي صرم الخليط العواذل % 7(@)(@@) % خليلي مهلا لا تلوما فانه % عذاب إذا لام الصديق المواصل % 8(@)(@@) % عجبت لهذا الزائر الركب موهنا % و من دونه بيد الملا والمناهل % 9(@)(@@) % أقام قليلا ثم باح بحاجة % إلينا ودمع العين بالماء واشل % 10(@)(@@) % وأنى اهتدى للركب في مدلهمة ، % تداعس بالركبان فيها الرواحل % PageV01P467 11(@)(@@) % أناخوا قليلا ثم هاجوا قلائصا % كما هيج خيط مغرب الشمس جافل % 12(@)(@@) % و أي مزار زرت حرف شملة % و طاوى الحشا مستانس القفر ناحل % % 13(@)(@@) % ولولا أمير المؤمنين ، وأنه % إمام وعدل للبرية فاصل % 14(@)(@@) % وبسط يد الحجاج بالسيف لم يكن % سبيل جهاد واستبيح الحلائل % 15(@)(@@) % إذا خاف درءا من عدو رمى به % شديد القوى والنزع في القوس نابل % 16(@)(@@) % خليفة عدل ، ثبت الله ملكه % على راسيات لم تزلها الزلازل % 17(@)(@@) % دعوا الجبن يا أهل العراق فانما % % يباح ويشرى سبي من لا يقاتل % 18(@)(@@) % لقد جرد الحجاج بالحق سيفه % لكم فاستقيموا لا يميلن مائل % 19(@)(@@) % % ولا حجة الخصمين حق وباطل % 20(@)(@@) % و أصبح كالبازي يقلب طرفه % على مربإ ، والطير منه دواخل % PageV01P468 21(@)(@@) % وخافوك حتى القوم تنزو قلوبهم % نزاء القطا التفت عليه الحبائل % 22(@)(@@) % وما زلت حتى أسهلت من مخافة % اليك اللواتي في الشعوف العواقل % % 23(@)(@@) % وثنتان في الحجاج لا ترك ظالم % سويا ولا عند المراشات نائل % 24(@)(@@) % و من غل مال الله غلت يمينه % إذا قيل أدوا لا 
ms134	 يغلن عامل % 25(@)(@@) % وما نفع المستعملين غلولهم ، % وما نفعت أهل العصاة الجعائل % 26(@)(@@) % قدمت على أهل العراق ومنهم % مخالف دين المسلمين وخاذل % 27(@)(@@) % فكنت لمن لا يبرىء الدين قلبه % شفاء ، وخف المدهن المتثاقل % 28(@)(@@) % و أصبحت ترضى كل حكم حكمته % نزار ، وتعطي ما سألت المقاول % 29(@)(@@) % صبحت عمان الخيل رهوا كأنما % % قطا هاج من فوق السماوة ناهل % 30(@)(@@) % يناهبن غيطان الرفاق ، وترتدي % % نقالا إذا ما استعرضتها الجراول % PageV01P469 31(@)(@@) % سلكت لأهل البر برا فنلتهم % و في اليم يأتم السفين الجوافل % 32(@)(@@) % ترى كل مرزاب يضمن بهوها % % ثمانين ألفا ، زايلتها المنازل % 33(@)(@@) % جفول ترى المسمار فيها كأنه ، % إذا اهتز ، جذع من سميحة ذابل % 34(@)(@@) % إذا اعترك الكلاء والماء لم تقد % بأمراسها ، حتى تثوب القنابل % 35(@)(@@) % تخال جبال الثلج لما ترفعت % أجلتها والكيد فيهن كامل % % 36(@)(@@) % تشق حباب الماء عن واسقاته ، % وتغرس حوت البحر منها الكلاكل % 37(@)(@@) % لقد ، جهد الحجاج في الدين واجتبى % % جبا لم تغله في الحياض الغوائل % 38(@)(@@) % و ما نان إذ بات الحواضن ولها % % وهن سبايا ، للصدور بلابل % 39(@)(@@) % أطيعوا فلا الحجاج مبق عليكم % ولا جبرئيل ذو الجناحين غافل % 40(@)(@@) % ألا رب جبار حملت على العصا % % و باب استه عن منبر الملك زائل % PageV01P470 41(@)(@@) % تمنى شبيب منية سفلت به ، % و ذو قطري لفه منك وابل % % 42(@)(@@) % تقول فلا تلقى لقولك نبوة % وتفعل ما أنبأت أنك فاعل % PageV01P471 البحر : كامل تام 1(@)(@@) % لمن الديار كأنها لم تحلل % بين الكناس وبين طلح الأعزل % 2(@)(@@) % ولقد أرى بك ، والجديد إلى بلى ، % موت الهوى وشفاء عين المجتلي % % 3(@)(@@) % نظرت إليك بمثل عيني مغزل % قطعت حبالها بأعلى يليل % 4(@)(@@) % و إذا التمست نوالها بخات به % و إذا عرضت بودها لم تبخل % 5(@)(@@) % ولقد ذكرتك والمطي خواضع % وكأنهن قطا فلاة مجهل % 6(@)(@@) % يسقين بالأدمى فراخ تنوفة ، % زغبا حواجبهن حمر الحوصل % 7(@)(@@) % يا أم ناجية السلام عليكم % قبل الرواح وقبل لوم العزل % 8(@)(@@) % وإذا غدوت فباكرتك تحية % سبقت سروح الشاحجات الحجل % 9(@)(@@) % لو كنت أعلم أن آخر عهدكم 
ms135	 % يوم الرحيل فعلت ما لم أفعل % 10(@)(@@) % أو كنت أرهب وشك بين عاجل % بقنعت أو لسالت ما لم يسأل % % PageV01P472 11(@)(@@) % أعددت للشعراء سما ناقعا % فسقيت آخرهم بكأس الأول % 12(@)(@@) % لما وضعت على الفرزدق ميسمي ، % و ضغا البعيث جدعت أنف الأخطل % 13(@)(@@) % خزى الذي سمك السماء مجاشعا % وبنى بناءك في الحضيض الأسفل % 14(@)(@@) % بيتا يحمم قينكم بفنائه % دنسا مقاعده ، خبيث المدخل % 15(@)(@@) % و لقد بنيت أخسر بيت يبتني % % فهدمت بيتكم بمثلى يذبل % 16(@)(@@) % إني بنى لي في المكارم أولي ؛ % و نفخت كيرك في الزمان الأول % 17(@)(@@) % أعيتك مأثرة القيون مجاشع % فانظر لعلك تدعى من نعهشل % 18(@)(@@) % وامدح سراة بني فقيم ، إنهم % قتلوا أباك وثاره لم يقتل % % 19(@)(@@) % و دع البراجم إن شربك فيهم % مر عواقبه كطعم الحنظل % 20(@)(@@) % إني انصببت من السماء عليكم % حتى اختطفتك يا فرزدق من عل % PageV01P473 21(@)(@@) % من بعد صكتي البعيث كأنه % خرب تنفج من حذار الأجدال % 22(@)(@@) % و لقد وسمتك يا بعيث بميسمى % % و ضغا الفرزدق تحت حد الكلكل % % 23(@)(@@) % حسب الفرزدق أن تسب مجاشع % و يعد شعر مرقش ومهلهل % % 24(@)(@@) % طلبت قيون بني قفيرة سابقا % غمر البديهة جامحا في المسحل % 25(@)(@@) % قتل الزبير وأنت عاقد حبوة % قبحا لحبوتك التي لم تحلل % 31(@)(@@) % لا تذكروا حال الملوك فانكم % بعد الزبير كحائض لم تغسل % % 32(@)(@@) % أبني شعرة لم تسد طريقنا % % بالأعميين ، ولا قفيرة ، فازحل % 33(@)(@@) % وبرحرحان تخضخضت أصلاؤكم % أكل الخزير ولا ارتضاع الفشل % 34(@)(@@) % و لقد تبين في وجوه مجاشع % لؤم يثور ضبابه لا ينجلي % % 35(@)(@@) % % فقع بمدرجة الخميس الجحفل % PageV01P474 36(@)(@@) % إني إلى جبلي تميم معقلي ، % ومحل بيتي في اليفاع الأطول % 37(@)(@@) % أحلامنا تزن الجبال رزانة ، % و يفوق جاهلنا فعال الجهل % % 38(@)(@@) % فارجع إلى حكمي قريش إنهم % أهل النبوة والكتاب المنزل % 39(@)(@@) % فاسأل إذا خرج الخدام وأحمشت % حرب تضرم كالحريق المشعل % 40(@)(@@) % والخيل تنحط بالكماة وقد رأوا % % لمع الربيئة في النياف العيطل % 41(@)(@@) % أبنو طهية يعدلون فوارسي % % وبنو خضاف ، وذاك ما لم يعدل % 42(@)(@@) % و غذا غضبت رمى 
ms136	 ورائي بالحصى % % 43(@)(@@) % عمرو وسعد ، يا فرزدق ، فيهم % زهر النجوم وباذخات الأجبل % 44(@)(@@) % كان الفرزدق إذ يعوذ بخاله % مثل الذليل يعوذ تحت القرمل % 45(@)(@@) % وافخر بضبة إن أمك منهم ، % ليس ابن ضبة بالمعمم المخول % PageV01P475 46(@)(@@) % و قضت لنا مضر عليك بفضلنا % % و قضت ربيعة بالقضاء الفيصل % 47(@)(@@) % إن الذي سمك السماء بنى لنا % % بيتا علاك فما له من منقل % 48(@)(@@) % أبلغ بني وقبان أن حلومهم % خفت فما يزنون حبة خردل % 49(@)(@@) % أزرى بحلمكم الفياش ، فأنتم % مثل الفراش غشين نار المصطلى % % 52(@)(@@) % % يا ابن القيون وذاك فعل الصيقل % 53(@)(@@) % % وفزعتم فزع البطان العزل % 54(@)(@@) % خصى الفرزدق والخصاء مذلة % يرجو مخاطرة القروم البزل % 55(@)(@@) % هاب الخواتن من بنات مجاشع % مثل المحاجن أو قرون الأيل % 57(@)(@@) % قعدت قفيرة بالفرزدق بعدما % % جهد الفرزدق جهده لا يأتلى % % 58(@)(@@) % ألهي أباك عن المكارم والعلا % % لي الكتائف وارتقاع المرجل % PageV01P476 62(@)(@@) % أبلغ هديتي الفرزدق إنها % % ثقل يزاد على حسير مثقل % 63(@)(@@) % إنا نقيم صغا الرؤوس ، ونختلي % % رأس المتوج بالحسام المقصل % PageV01P477 البحر : كامل تام 1(@)(@@) % حي الغداة برامة الأطلالا ، % رسما تحمل أهله ، فأحالا % % 2(@)(@@) % إن السواري والغوادي غادرت % للريح مخترقا به ومجالا % % 3(@)(@@) % لم أر مثلك بعد عهدك منزلا % فسقيت من سبل السماك سجالا % % 4(@)(@@) % أصبحت بعد جميع أهلك دمنة % قفرا ، وكنت مربة محلالا % % 5(@)(@@) % ولقد عجبت من الديار وأهلها % % و الدهر كيف يبدل الأبدالا % % 6(@)(@@) % و رأيت راحلة الصبا قد أقصرت % بعد الوجيف وملت الترحالا % % 7(@)(@@) % إن الظعائن يوم برقة عاقل % قد هجن ذا سقم فزدن خبالا % % 8(@)(@@) % طرب الفؤاد لذكرهن وقد مضت % بالليل أجنحة النجوم فمالا % % 9(@)(@@) % يجعلن مدفع عاقلين أيامنا ، % وجعلن أمعز رامتين شمالا % % 10(@)(@@) % لا يتصلن إذا افتخرن بتغلب ، % ورزقن زخرف نعمة وجمالا % % PageV01P478 11(@)(@@) % طرق الخيال حزرة موهنا % و لحب بالطيف المسلم خيالا % % 12(@)(@@) % يا ليت شعري يوم دارة صلصل % أتريد صرمي ، أم تريد دلالا % % 13(@)(@@) % لو أن عصم عمايتين ويذبل % سمعت حديثك أنزل الأوعالا % % 14(@)(@@) % حييت ، لست غدا لهن بصاحب ، % بحزيز وجرة إذ يخدن 
ms137	 عجالا % % 15(@)(@@) % أجهضن معجلة لستة أشهر % و حذين بعد نعالهن نعالا % % 16(@)(@@) % وإذا النهار تقاصرت أظلاله ، % و ونا المطي سامة وكللا % % 17(@)(@@) % رفع المطي بكل أبيض شاحب % خلق القميص تخاله مختالا % % 18(@)(@@) % إني جعلت ، فلن أعافي تغلبا ، % للظالمين عقوبة ونكالا % % 19(@)(@@) % قبح الإله وجوه تغلب إنها % % هانت عل مراسنا وسبالا % % 20(@)(@@) % قبح الإله وجوه تغلب كلما % % شبح الحجيج وكبروا إهلالا % % PageV01P479 21(@)(@@) % عبدوا الصليب وكذبوا بمحمد % و بجيرئيل وكذبوا ميكالا % % 23(@)(@@) % والتغلبي إذا تنحنح للقرى % % حك استه ، وتمثل الأمثالا % % 24(@)(@@) % أنسيت يومك بالجزيرة بعدما % % كانت عواقبه عليك وبالا % % 25(@)(@@) % حملت عليك حماة قيس خيلها % % شعثا عوابس تحمل الأبطالا % % 26(@)(@@) % ما زلت تحسب كل شيء بعدهم % % خيلا تشد عليكم ورجالا % % 27(@)(@@) % زفر الرئيس أبو الهذيل أبادكم % فسبى النساء وأحرز الأموالا % % 28(@)(@@) % قال الأخيطل إذ راى راياتهم % يا مار سرجس لا نريد قتالا % % 29(@)(@@) % هلا سألت غثاء دجلة عنكم % والخامعات تجمع الأوصالا % % 30(@)(@@) % ترك الأخيطل أمه وكأنها % % منحاة سانية تدير محالا % % 31(@)(@@) % و رجا الأخيطل من سفاهة رأيه % ما لم يكن وأب له لينالا % % PageV01P480 32(@)(@@) % خل الطريق فقد رأيت قرومنا % % تنفي القروم تخمطا وصيالا % % 33(@)(@@) % تمت تميمي يا أخيطل فاحتجز ، % خزى الأخيطل حين قلت وقالا % % 34(@)(@@) % لو أن خندف زاحمت أركانها % % جبلا أصم ، من الجبال ، لزالا % % 35(@)(@@) % إن القوافي قد أمر مريرها % % لبني فد وكسر إذ جدعن عقالا % % 36(@)(@@) % و لقيت دوني من خزيمة معشرا % وشقاشقا بذخت عليك طوالا % % 37(@)(@@) % راحت خزيمة بالجياد كأنها % % عقبان مدجنة نفضن طلالا % % 38(@)(@@) % إنا كذاك لمثل ذاك نعدها ، % تسقى الحليب وتشغعر الأجلالا % % 39(@)(@@) % ما كنت تلقى في الحروب فوارسي % % ميلا إذا ركبوا ولا اكفالا % % 40(@)(@@) % صبحن نسوة تغلب ، فسبينها ، % ورأى الهذيل لوردهن رعالا % % 41(@)(@@) % قيس وخندف إن عددت فعاله % خير وأكرم من أبيك فعالا % % PageV01P481 42(@)(@@) % إن حرموك لتحرمن على العدا % % أو حللوك لتؤكلن حلالا % % 43(@)(@@) % هل تملكون من المشاعر مشعرا ؛ % أو تنزلون من الأراك ظلالا % % 44(@)(@@) % فلنحن أكرم في المنازل منزلا % منكم وأطول في المساء جبالا % % 45 
ms138	(@)(@@) % قدنا خزيمة ، قد علمتم ، عنوة ، % و سشتا الهذيل يمارس الأغلالا % % 46(@)(@@) % و رأت حسينة بالعذاب فوارسي % % نحو النهاب وتقسم الأنفالا % % 48(@)(@@) % ولو ان تغلب جمعت أحسابها % % يوم التفاضل لم تزن مثقالا % % 50(@)(@@) % لا تطلبن خؤولة في تغلب % فالزنج أكرم منهم أخوالا % % 51(@)(@@) % و رميت هضبتنا بأفوق ناصل % تبغي النضال ، فقد لقيت نضالا % % 52(@)(@@) % لولا الجزا قسم السواد وتغلب % في المسلمين فكنتم أنفالا % % PageV01P482 البحر : كامل تام 1(@)(@@) % لم أر مثلك يا أمام خليلا % أنأى بحاجتنا ، وأحسن قيلا % % 2(@)(@@) % لو شئت قد نقع الفؤاد بمشرب % يدع الحوائم لا يجدن غليلا % % 3(@)(@@) % بالعذب في رصف القلاة مقيله % قض الأباطح لا يزال ظليلا % % 4(@)(@@) % أنكرت عهدك غير أنك عارف % طللا بألوية العناب ، محيلا % % 5(@)(@@) % لما تخايلت الحمول حسبتها % % دوما يشرب ناعما ونخيلا % % 6(@)(@@) % فتعز إن نفع العزاء مكلفا % الشوق يظهر للفراق عويلا % % 7(@)(@@) % قطع الخليط وصال حبلك منهم ، % ولقد يكون بحبلهم موصولا % % 8(@)(@@) % و رعت ركبي بالدفينة بعد ما % % ناقلن من وسط الكراع نقيلا % % 9(@)(@@) % من كل يعلمه النجاء تكلفت % جوز الفلاة تأوها وزميلا % % 10(@)(@@) % إني تذكرني الزبير حمامة ، % تدعو بمجمع نخلتين هديلا % % PageV01P483 11(@)(@@) % قالت قريش : ما أذل مجاشعا % جارا وأكرم ذا القتيل قتيلا % % 12(@)(@@) % لو كان يعلم عذر آل مجاشع % نقل الرحال ، فأسرع التحويلا % % 13(@)(@@) % يا لهف نفسي إذ يغرك حبلهم ! % هلا أتخذت على القيون كفيلا % 14(@)(@@) % أفبعد متركهم خليل محمد % ترجو القيون مع الرسول سبيلا % % 15(@)(@@) % ولوا ظهورهم الأسنة بعدما % % كان الزبير مجاورا ودخيلا % % 16(@)(@@) % لو كنت حرا يا ابن قين مجاشع % شيعت ضيفك فرسخين وميلا % 17(@)(@@) % أفتى الندا وفتى الطعان غررتم % وفتى الشمال ، إذا تهب بليلا % % 18(@)(@@) % قتل الزبير وأنتم جيران % غيا لمن غر الزبير طويلا % % 19(@)(@@) % لو كنت حين غررت بين بيوتنا % % لسمعت من صوت الحديد صليلا % % 20(@)(@@) % لحماك كل مغاور يوم الوغى % % ولكان شلو عدوك المأكولا % % PageV01P484 البحر : طويل 1(@)(@@) % أجدك لا يصحو الفؤاد المعلل ، % وقد لاح من شيب عذار ومسحل % 2(@)(@@) % ألا ليت أن الظاعنين بذي الغضا % % أقاموا وبعض 
ms139	 الآخرين تحملوا % % 3(@)(@@) % فيوما يجارين الهوى ، غير ما صبا ؛ % و يوما ترى منهن غولا تغول % 4(@)(@@) % ألا أيها الوادي الذي بان أهله ، % فساكن مغناهم حمام ودخل % % 5(@)(@@) % فمن راقب الجوزاء أو بات ليله % طويلا فليلي بالمجازة أطول % % 6(@)(@@) % بكى دوبل ، لا يرفأ الله دمعه ، % ألا إنما يبكي من الذل دوبل % 7(@)(@@) % جزعت ابن ذات الفلس لما تداركت % من الحرب أنياب عليك وكلكل % % 8(@)(@@) % فإنك والجحاف يوم تحضه % أردت بذاك المكث والورد أعجل % 9(@)(@@) % سرى نحوكم ليل كأن نجومه % قناديل ، فيهن الذبال المفتل % 10(@)(@@) % فما انشق ضوء الصبح حتى تعرفوا % % كراديس يهديهن ورد مجل % PageV01P485 11(@)(@@) % فقد قذفت من حرب قيس نساؤكم % بأولادها ، منها تمام ومعجل % 12(@)(@@) % ومقتولة صبرا ترى عند رجلها % % بقيرا وأخرى ذات بعل تولول % 13(@)(@@) % وقد قتل الجحاف أولاد نسوة ، % يسوق ابن خلاس بهن وعزهل % 14(@)(@@) % تقول لك الثكلى المصاب حليلها % % أبا مالك ما في الظعائن مغزل % 15(@)(@@) % حضضت على القوم الذين تركتهم % % تعل الردينيات فيهم وتنهل % 16(@)(@@) % عقاب المنايا تستدير عليهم % و شعث النواصي لجمهن تصلصل % % 17(@)(@@) % بدجلة إن كروا فقيس وراءهم % صفوفا وإن رامو المخاضة أو حلوا % % 18(@)(@@) % و ما زالت القتلى تمور دماؤها % % بدجلة حتى ماء دجلة أشكل % 19(@)(@@) % فالا تعلق من قريش بذمة % فليس على أسياف قيس معول % 20(@)(@@) % لنا الفضل في الدنيا وأنفك راغم ، % و نحن لكم يوم القيامة أفضل % % PageV01P486 21(@)(@@) % و قد شققت يوم الرحوب سيوفنا % % عواتق لم يثبت عليهن محمل % 22(@)(@@) % أجار بنو مروان منهم دماءكم ، % فمن من بني مروان أعلا وأفضل % PageV01P487 البحر : طويل 1(@)(@@) % أمن عهد ذي عهد تفيض مدامعي % % كأن قذى العينين من حب فلفل % 2(@)(@@) % فإن ير سلمى الجن يستأنسوا بها ، % و إن يرسلى راهب الطور ينزل % 3(@)(@@) % من البيض لم تظعن بعيدا ولم تطأ % % على الأرض إلا نير مرط مرحل % 4(@)(@@) % إذا ما مشت لم تنتهز وتأودت % كما انآد من خيل وج غير منعل % 5(@)(@@) % كما مال فضل الجل عن متن عائذ % أطافت بمهر في رباط مطول % 6 
ms140	(@)(@@) % لها مثل لون البدر في ليلة الدجى % % وريح الخزامى في دماث مسهل % 7(@)(@@) % أإن سب قين وابن قين غضبتم ، % أبهدل ، يا أفناء سعد لبهدل % 8(@)(@@) % أعياش قد ذاق القيون مرارتي % % و أوقدت ناري فادن دونك فاصطل % 9(@)(@@) % سأذكر ما قال الحطيئة جاركم % و أحدث وسما فوق وسم المخبل % 10(@)(@@) % أعياش ما تغني قفيرة بعدما % % سقيتك سما في مرارة حنظل % PageV01P488 11(@)(@@) % أعياش قد آوت قفيرة نسلها % % إلى بيت لؤم ما له من محول % 12(@)(@@) % تذئر أبكار اللقاح ولم تكن % قفيرة تدري ما جناه القرنفل % 13(@)(@@) % فان تدعوا للزبرقان فانكم % بنو بنت قين ذي علاة ومرجل % 16(@)(@@) % فشدوا الحبى للغدر إني مشمر ، % إذا ما علا متن المفاضة محملي % % 17(@)(@@) % ولا تطلبا ، يا ابني قفيرة ، سابقا % يدق جماحا كل فأس ومسحل % 18(@)(@@) % كما رام منا القين أيام صوأر % فلاقى جماحا من حمام معجل % 19(@)(@@) % ضغا القرد لما مسه الجهد واشتكى % % بنو القين منا حد ناب وكلكل % 23(@)(@@) % لعلك ترجو ، يا ابن نافخ كيره ، % قروما شبا أنيابها لم يفلل % 25(@)(@@) % أتعدل يربوعا وأيام خيلها % % بأيام مضفونين في الحرب عزل % 26(@)(@@) % ألا تسألون المردفات عشية % مع القوم لا يخبأن ساقا لمجتلي % % PageV01P489 27(@)(@@) % من المانعون السبي لا تمنعونه % وأصحاب أعلال الرئيس المكبل % 28(@)(@@) % وفي أي يوم لم تسلل سيوفنا ، % فنعلوا بها هام الجبابر من عل % 29(@)(@@) % تبدل به في رهط تسعة مثله % أبا شر ذي نعلين أو غير منعل % 30(@)(@@) % فما لمت نفسي في حديث وليته % ولا لمت ، فيما قدم الناس ، أولي % % PageV01P490 البحر : طويل 1(@)(@@) % عوجي علينا واربعي ربة البغل % ولا تقتليني ، لا يحل لكم قتلي % % 2(@)(@@) % أعاذل مهلا بعض لومك في البطل % و عقلك لا يذهب فان معي عقلي % % 3(@)(@@) % فإنك لا ترضي ، إذا كنت عاتبا ، % خليلك إلا بالمودة والبذل % 4(@)(@@) % أحقا رأيت الظاعنين تحملوا % % من الغيل أو وادي الوريعة ذي الأثل % 5(@)(@@) % ليالي إذ أهلي وأهلك جيرة ، % و إذ لا نخاف الصرم إلا على وصل % 6(@)(@@) % وإذ أنا لا مال أريد ابتياعه % % بمالي ولا 