ms81	 أسير % 2(@)(@@) % ودمعي غزير السكب في عرصاتهم % % فكيف أكف الدمع وهو غزير % 3(@)(@@) % و إنتباريحي بهم وصبابتي % % لهن رواح في الحشا وبكور % 4(@)(@@) % أحن إذا غنت حمائم شعبهم % % وينزع قلبي نحوهم ويطير % % 5(@)(@@) % واذكر من نجد حوارس باسهم % % فتنجد أشواقي بهم وتغير % 6(@)(@@) % فياليتشعري عن محاجر حاجر % وعن أثلات روضهن نضير % 7(@)(@@) % وعن عذبات البان يلعبن بالضحى % % عليهن كاسات النسيم تدور % % 8(@)(@@) % ومنبان لي أروى من الشعب شربة % وانظر تلك الأرض وهي مطير % % 9(@)(@@) % واسمعفي سفح البشام عشية % بكاء حمامات لهنهدير % 10(@)(@@) % فياجيرة الشعب اليمان بحقكم % صلوا أو مروا طيف الخيال يزور % PageV01P254 11(@)(@@) % بعدتم ولم يبعد عن القلب حبكم % و غبتم وأنتم في الفؤاد حضور % 12(@)(@@) % أغار عليكم أن يراكم حواسدي % % و أحجب عنكم والمحب غيور % 13(@)(@@) % أحيباب قلبي هل سواكم لعلتي % % طبيب بداءالعاشقينخبير % 14(@)(@@) % غرستم بقلبيلوعةثمراتها % % هموم لها حشوالحشاءسعير % 15(@)(@@) % جيوشهواكمكللمحةناظر % على حصنقلبي بالغرامتغير % 16(@)(@@) % أعيروا عيوني نظرةمنجمالكم % و ما كلمنيبغي الوصاليعير % 17(@)(@@) % أقام على قلبي وسمعي وناظري % % رقيب فما يخفى عليه ضمير % 18(@)(@@) % مرادي هواكم والهوان كرامة % لحلو هوا كمو السعير يسير % 19(@)(@@) % أعد على ديني ودنياي بركم % فتنقلب الأحزان وهي سرور % 20(@)(@@) % و تأخذ قلبي نشوة عند ذكركم % % كما ارتاح صب خامرته خمور % PageV01P255 21(@)(@@) % و إني لمستغن عن الكون دونكم % و أما إليكم سادتي ففقير % 22(@)(@@) % أصوم عنالأغيار قطعا و ذكركم % لصومي سحور في الهوى وفطور % 23(@)(@@) % و ليلةقدريليلة بت آنسا % بكمولأقلامالقبول صرير % 24(@)(@@) % و ضحوة عيدييوم أضحى بقربكم % علي من اللطف الخفي ستور % 25(@)(@@) % فجودوا بوصل فالزمان مفرق % و أكثر عمر العاشقين قصير % 26(@)(@@) % و لا تغلقوا الأبواب دونيلزلتي % % فأنتم كرام و الكريم غفور % 27(@)(@@) % و قد أثقلتظهري الذنوب وإنما % % رجائيلغفار الذنوب كبير % 28(@)(@@) % و جاه رسولالله أحمد نصرتيع إذا لم يكن لي في الخطوب نصيرصومدح رسول الله فأل سعادتي % % أفوز به يوم السماء تمورسقط بيت ص % % 29(@)(@@) % نبي تقي أريحي مهذب % بشير لكل العالمين نذير % 30(@)(@@) % إذا ذكرارتاحت قلوب لذكره % و طابت نفوس و انشرحن 
ms82	 صدور % PageV01P256 31(@)(@@) % عدمناعلى الدنيا وجود نظيره % لقد قل موجود وعز نظير % 32(@)(@@) % و كيف يسامى خيرمن وطيء الثرى % % و في كل باع عن علاه قصور % 33(@)(@@) % و كل شريف عنده متواضع % و كل عظيمالقريتين حقير % 34(@)(@@) % لئن كان في يمناه سبحت الحصى % % فقد فاض ماء للجيوش نمير % 35(@)(@@) % و خاطبه جذع و ضب و ظبية % و عضو خفي سمه وبعير % 36(@)(@@) % و در له الثدي الأجد كرامة % كما انشق بدر في السماء منير % 37(@)(@@) % و مثل حنين الجذع سجدة سرحة % و أنس غزال البر وهي تفور % 38(@)(@@) % و باض حمام الأيك في إثره كما % % بنت عنكبوت حين كان يسير % 39(@)(@@) % و إن الغمامالهاطلاتتظله % بروحنسيم إنألم هجير % 40(@)(@@) % و يوم حنين إذرمى القوم بالحصى % % فولوا وهمعمي العيون وعور % PageV01P257 41(@)(@@) % و جند في بدر ملائكة السما % % فجبريل تحت الرايتين أمير % 42(@)(@@) % و من قومه في البئر سبعون سيدا % قتيلا ومثل الهالكين أسير % 43(@)(@@) % و من عزمهتخريب خيبر مثل ما % % قريظة قرض و النظير نضير % 44(@)(@@) % و أن رسول الله من مكة سرى % % إلى القدس والروح الأمين سمير % 45(@)(@@) % فجاز السماء السبع في بعض ليلة % و لكن بعد السبعأين يصير % 46(@)(@@) % فلاح له من رفرف النور لائح % من النور للهدى البشير يسير % 47(@)(@@) % و شاهد فوق العرش كل عجيبة % و ما ثم إلا زائر ومزور % 48(@)(@@) % حبيب تملى بالحبيب فخصه % و شرفه بالقرب وهو جدير % 49(@)(@@) % و قال له سلنيرضاك فإنني % % على كل شيء في رضاك قدير % 50(@)(@@) % فعاد قرير العين في خلع الرضا % % و قد شملته بهجة وحبور % PageV01P258 51(@)(@@) % محمد قم بي في الخطوب فإن لي % % تجارة مدح فيك ليس تبور % 52(@)(@@) % عرائس لا ترضى بغيرك ناكحا % لهن عزيزات المهور مهور % 53(@)(@@) % علت وغلت إلا عليك فأرخصت % لترخص حور في القصور قصور % 54(@)(@@) % مؤلفهاعبد الرحيم كأنها % % كواكب في جو السماء تنير % 55(@)(@@) % لبسن معانيهابمدحكبهجة % فلاح لها نور وفاح عبير % 56(@)(@@) % فقل أنت في الدارين في حزبناومن % يليك صغير سنه وكبير % 57(@)(@@) % و 
ms83	 صلى عليك الله واختص واجتبى % % فأنت هدى للعالمين ونور % 58(@)(@@) % و عمر ضاءالآل والصحب إنهم % لدينك ياشمس الزمان بدور % PageV01P259 البحر : - 1(@)(@@) % متى يستقيمالظل والعود أعوج % و هل ذهب صرف يساويه بهرج % 2(@)(@@) % و من رام إخراج الزكاة ولم يجد % نصابا يزكيه فمن أين يخرج % 3(@)(@@) % هي النفس والدنيا وإبليس والهوى % % بطاعتهم عن طاعة الله أزعج % 4(@)(@@) % أروح وأغدو شاربا كأس غفلة % بماء الأماني الكواذب يمزج % 5(@)(@@) % و أمسى وأضحى حاملا في بطاقتي % % ذنوبا تكاد الأرض منهن تخرج % 6(@)(@@) % إذ قلت للنفس استعدي بتوبة % أبت وشقي الحظ لا يتحجج % 7(@)(@@) % و إن قلت للقلب استقم بي تعرضت % له شهوات نارها تتأجج % 8(@)(@@) % فكم أتزيا بالعبادة والتقى % % رياء وباب الرشد عني مرتج % 9(@)(@@) % أريد مقام الصالحين وليس لي % % كمنهجهم في الدين دين ومنهج % 10(@)(@@) % و إن حضر الإخوان للذكروالبكا % % حضرت كأني لاعب متفرج % PageV01P260 11(@)(@@) % فوا خجلتي شيب وعيب و قد دنا % % رحيلي ولا أدري علام أعرج % 12(@)(@@) % و للمرء يوم ينقضي فيه عمره % و موت وقبر ضيق فيه يولج % 13(@)(@@) % و يلقى نكيرا في السؤال ومنكرا % يسومان بالتنكيل من يتلجلج % 14(@)(@@) % و لا بد من طول الحساب وعرضه % و هول مقام حره يتوهج % 15(@)(@@) % و ديان يوم الدين يبرز عرشه % و يحكم بين الخلق والحق أبلج % 16(@)(@@) % فطائفة في جنة الخلد خلدت % و طائفة في النار تصلى فتنضج % 17(@)(@@) % فيا شؤم حظي حين ينكشف الغطا % % إذا لم يكن لي من ذنوبي مخرج % 18(@)(@@) % و ليس معي زاد ولا ليوسيلة % بل هاشمي بالبهاء متوج % 19(@)(@@) % ألوذ به ذاك الجنابفاحتمي % % بمن هو عند الكرب للكرب مفرج % 20(@)(@@) % و أدعوه في الدنيا فتقضى حوائجي % % و إني إليهفي القيامة أحوج % PageV01P261 21(@)(@@) % إذا مدح الشعراء أرباب عصرهم % % مدحت الذي من نوره الكون أبهج % 22(@)(@@) % و إن ذكروا ليلى ولبنى فإنني % % بذكر الحبيب الطيب الذكر ملهج % 23(@)(@@) % أما ومحل الهدى تدمى نحورها % % و من ضمه البيت العتيق المدبج % 24(@)(@@) % لقد شاقني زوار قبر محمد % % فشوقى مع الزوار يسري 
ms84	 ويدلج % 25(@)(@@) % تظل الهوادي بالهوادج ترتمي % % و مالي في ركب المحبين هودج % 26(@)(@@) % و تمسى بروق الأبرقين ضواحكا % فتغرى غرامى بالبكا وتهيج % % 27(@)(@@) % و أرتاح من أرواح أطيب طيبة % % إذا المسك في أرجائها يتأرج % 28(@)(@@) % بلاد بها جبريل يسحب ريشه % و ينزل من جو السماء ويعرج % 29(@)(@@) % نبي تغار الشمس من نور وجهه % بهى نقى الثغر أحور أدعج % 30(@)(@@) % تزيد به الأيام حسنا ويزدهي % % به الدين والدنيا به تتبرج % PageV01P262 31(@)(@@) % مكارم أخلاق وحسن شمائل % و شيمة جود بحره متموج % 32(@)(@@) % غياث لملهوف وغوث لرائد % و ليث إذا صال الكمى المدجج % 33(@)(@@) % يخاصمه الأعداء والسيف حاكم % عليهم وريح النصر في القوم تتأجج % 34(@)(@@) % و من خلفهم بأس شديد ونجدة % و رأي يراهالسمهريالمزجج % 35(@)(@@) % فعز حماهم بالحماة مذلل % و رأس علاهم بالكماة مشجج % 36(@)(@@) % فكم من أسير في الوثاق مقيد % و كم من قتيل بالدماء يضرج % 37(@)(@@) % بضرب تلبيه الجماجم والطلا % % و طعن ذيالات الحشا منه تسرج % 38(@)(@@) % إليكشفيعالمذنبين بجارني % % فرائدفي سلك المحامدتدرج % 39(@)(@@) % مؤلفها عبد الرحيم كأنها % % نجوم لهافيجو جودكأبرج % 40(@)(@@) % فصلني بما يمحو رسومحواسدي % % و يشرحصدري بالسرور ويبلج % PageV01P263 41(@)(@@) % و أكرم لأجلي من يلينيفكلنا % % إلى الريمنفياضفضلكينهج % 42(@)(@@) % و صلى عليك الله ما هبتالصبا % % و مالاحفجر نوره متبلج % 43(@)(@@) % و فاز بحظ منك أرباب هجرة % إليك وأوس ناصروك وخزرج % PageV01P264 البحر : - 1(@)(@@) % أتأمرني بالصبروالطبعأغلب % و تعجب من حالي وحالك أعجب % 2(@)(@@) % و تطلب مني سلوة عن ربائب % و راهن أرواح المحبين تطلب % 3(@)(@@) % فما قر لي دمع و لا كف مدمع % و لا طاب لي عيش و لا لذ مشرب % 4(@)(@@) % زماني أشكو منك عتبك دائما % فلا أنا اشكوا ولا أنت معتب % 5(@)(@@) % تروم ذهوليعن فريق مفارق % و ركب بأكناف الأباطح طنبوا % % 6(@)(@@) % و تسألنيعن زينب ابنة مالك % و ما سألت عني ولا عنك زينب % 7(@)(@@) % مروعتي بالبين هل من زيارة % تعيش بها الأرواح من قبل تذهب % 8(@)(@@) % فلم يبق شيء غير فضلة مهجة % و قلب على جمر الغضى يتقلب % 9(@)(@@) % أورى 
ms85	 بذكر الركب وهو مشرق % و أبكي فيبكيني الفريق المغرب % 10(@)(@@) % إلى الجيرة الغادين شوقي وإنني % % على ولهي أبكي الرسوم وأندب % PageV01P265 11(@)(@@) % إذا وصلوا طاب الزمان بوصلهم % و إن هجروا فالهجر عندي أطيب % 12(@)(@@) % نحن لترداد الحنين حشاشتي % % و يستعذب التعذيب قلبي المعذب % 13(@)(@@) % و طيف خيال زارني بعد هجعه % لدى وطن ينأون عنه ويقرب % 14(@)(@@) % يعللني ذكرى ليال تقدمت % و لكنه من حيث يصدق يكذب % 15(@)(@@) % و ساجعة تبكي فأبكي وإنها % % لتعجم شكواها وأشكو فأغرب % 16(@)(@@) % ألا ليت شعري عن ربا الأثل هل غدا % % و راح على العلات فيهن صيب % 17(@)(@@) % وذر فريس العقيقين هيدب % على كل شعب منه يرفض هيدب % 18(@)(@@) % و هل روع البرق الرياض بضاحك % يفضض أزهار الرياض ويذهب % 19(@)(@@) % يظل يناغي الشمس لؤلؤ ظله % و يصبح در النور بالنور يلهب % 20(@)(@@) % و هل عذبات البان رنحها الصبا % % فعانقها ثم انثنى وهي تلعب % PageV01P266 21(@)(@@) % أحيباب قلبي فرق الدهر بيننا % % فلم يبق شيء بعدكم فيه أرغب % 22(@)(@@) % سوى الكرم الفياض والصفح والرضا % % أرجيه بالظن الذي لا يخيب % 23(@)(@@) % من الهاشمي الطيب الطاهر الذي % % إليه العلا والفضل والفخر ينسب % 24(@)(@@) % أعز الورى أصلا وفعلا ومنشا % % و أعلى وأسما في الفخار وأحسب % 25(@)(@@) % و أحسن خلق الله خلقا وخلقه % و أطولهم في الجودباعا وأرحب % 26(@)(@@) % و أكرم بيتا من لؤى بن غالب % و من غيرهم وابن الأطايب أطيب % 27(@)(@@) % تسلسل من أعلى ذؤابة هاشم % أشم رحيب الباع أروع أغلب % 28(@)(@@) % سرى ليلة المعراج يقصد حضرة % بها الكأس من راح المحبين تشرب % 29(@)(@@) % وحفت به الأملاك منهم مبشر % بما نال من فضل ومنهم مرحب % 30(@)(@@) % و أدناه رب العرش منه على العلا % % فكان كقاب القوس أو هو أقرب % PageV01P267 31(@)(@@) % و آتاه في الحشر الشفاعة واللوا % % على الرسل والحوض الذي ليس ينضب % 32(@)(@@) % فآياته بالمعجزاتنواطق % و راياته بالفتح والنصر تنصب % 33(@)(@@) % صفوه بما شئتم فوالله ما انطوى % % على مثله في الكون أم ولا أب % 34(@)(@@) % أينبي الصفا المكي عن جيرة الحمى % % و 
ms86	 من ضمه البيت العتيق المحجب % 35(@)(@@) % و عن عرفات و المحصب من مني % % فأمنيتيخيفا منى والمحصب % 36(@)(@@) % و من لي بأهلالدار من أهل طيبة % فوجدي موجودو قلبي مقلب % 37(@)(@@) % إلى روضة منبين قبر ومنبر % عليها رياح الخلد تصبو وتجنب % 38(@)(@@) % شذاها من الفردوس مسك وعنبر % على غاية الوصفين أذفر أشهب % 39(@)(@@) % ألا بلغوا عني المحبين أنهم % و إن سكنوا قلبي عن العين غيب % 40(@)(@@) % أحن إليهم من ديار بعيدة % و أسأل عنهم من يجيء ويذهب % PageV01P268 41(@)(@@) % غرامي بهم فوق الغرام ومهجتي % % تذوب ودمعي في المحاجر يسكب % 42(@)(@@) % و من كان مشغوفا بحب محمد % و حب أبي بكر فكيف يعذب % 43(@)(@@) % سلام على الصديق إذ هو لم يزل % لخير البرايا في الحياتين يصحب % 44(@)(@@) % فثانيه في الغار الخليفةبعده % لأمتهنعمالحبيبالمقرب % 45(@)(@@) % أجاب وقد صموا وأبصر إذ عموا % % و صدق بالحق المبين وكذبوا % % 46(@)(@@) % و صاحبه الفاروق ذاك المبارك ال % % أغر أمير المؤمنين المهذب % 47(@)(@@) % ضجيع رسول الله مظهر دينه % غضنفره في اللهيرضي ويغضب % 48(@)(@@) % به اتسع الإسلام واتضح الهدى % % و لم يبق غير الحق للناس مذهب % 49(@)(@@) % و عثنمان ذو النورين من سبح الحصى % % بكفيه وارى الزند والبرق خلب % 50(@)(@@) % كثيرالبكاو الذكرمنفقماله % و جهز جيش العسر والعام مجدب % PageV01P269 51(@)(@@) % لدى الحشر يلقى الله وهو مطهر % بريء شهيد بالدماء مخضب % 52(@)(@@) % و من كعلي كرم الله وجهه % كريم به الأمثال في الجود تضرب % 53(@)(@@) % أخو الحلم بحر العلم حيدرة الرضا % % إمام به صدع الهداية يشعب % 54(@)(@@) % هزبر و لكن صيده الصيد في الوغى % % و مخلبه الرمح الأصم المكعب % 55(@)(@@) % و عمي رسول الله والحسنين من % بهم شرفات المجد تزهو وتعجب % 56(@)(@@) % ومن قومهقوم إلى الله هاجروا % % و خلوا معاني دورهم وتغربوا % % 57(@)(@@) % و راضوا على حب الحبيب نفوسهم % فكان لوجه الله ذاك التقرب % 58(@)(@@) % و آواه قوم آخرون وناصروا % % وذبوا العدى واستمنوا وتغلبوا % % 59(@)(@@) % أولئكم الأنصار والسادة الألى % % نشامنهم فرع طويل ومنصب % 60(@)(@@) % سلام على ذاك النبي وآله % و أزواحه والصحب ما جن 
ms87	 غيهب % PageV01P270 61(@)(@@) % غداة اللقا منهم أسود ضراغم % بسر سرابيل الحديد تجلببوا % % 62(@)(@@) % يخوضون بحرا دونه البحر من دم % وأمواجه بيض وسمر وشذب % 63(@)(@@) % فكل طويل الباع مقتحم الوغى % % أغر طويل العمر لاقيه يعطب % 64(@)(@@) % يجود على شوق الرماح بنفسه % وبردى به في غمرة الموت مقرب % 65(@)(@@) % و سرباله في الروع درع درية % و أبيض من ماء الحديد مشطب % 66(@)(@@) % عليهم سلام الله إذ مهدوا الهدى % % و دان لهم بالسيف شرق ومغرب % 67(@)(@@) % على حب من هابت لسطوة بأسه % وهيبتهالعظمى نزار ويعرب % 68(@)(@@) % نبي حجازي رضي مكرم % كريم جواد صادق الوعد منجب % 69(@)(@@) % إلى صاحب الجاه العريض رمت بنا % % هموم لها في ابن العواتك مطلب % 70(@)(@@) % من الخير والنيابتين تراسلت % إلى مقصد من دونه الهول يركب % PageV01P271 71(@)(@@) % فقامت على باب النبي محمد % مقام ذليل خائف يترقب % 72(@)(@@) % و حطت ببحبوح المكارم والرضا % % لدى سيد منه المكارم توهب % 73(@)(@@) % على الساحة الخضراء والمشهد الذي % % يكادبزوار النبي يرحب % 74(@)(@@) % سلام على ذاك الحبيب فإنني % % إليه على بعدي أحن وأطرب % 75(@)(@@) % عسى يارسول الله نظرة رحمة % إلينا وإلا دعوة ليس تحجب % 76(@)(@@) % فأنت حمانامن زمان معاند % به ينكر المعروف والدين يسلب % 77(@)(@@) % سميكيا مولايطال عكوفه % على كعبة العصيان والرأس أشيب % 78(@)(@@) % فخذ بيد المقري واشفع له ولي % % فوالله إني مذنب وهو مذنب % 79(@)(@@) % و قم يا رسول الله بي وبصاحبي % % و قل ذا كهذا لا خلاف مرتب % 80(@)(@@) % فقد عظمت أوزارنا وذنوبنا % % و لم نأت شيئا للكرامة يوجب % PageV01P272 81(@)(@@) % و قطعت الأيام أسباب بيننا % % و لكن إليكم يلجأ المتسبب % 82(@)(@@) % أحاط بنا طوفان زلاتنا وما % % لنا فيه إلا فلك صفحك مركب % 83(@)(@@) % إذا ما هممنابالزيارة عاقنا % % بعادك عنا لا الجفا والتجنب % 84(@)(@@) % إليك توسلنا بك اصفح وجد وعد % فما منك بد لا ولا منك مهرب % 85(@)(@@) % و قل أنتما مني ولي ومعي وبي % % و عندي فأهوال القيامة تصعب % 86(@)(@@) % نلوذ وندعو المسلمين لظلكم % إذا أخذ الجلل بما كان يكسب % 87(@)(@@) % فما منك إلا نفحة 
ms88	 هاشمية % علينا وإلا رحمة تتشعب % 88(@)(@@) % وصلى عليك الله مادر عارض % و ما لاح في السبع الطرائق كوكب % 89(@)(@@) % صلاة تعم الآلو الصحبدائما فما حملت من ناقة فوق رحلها أبر وأفى ذمة من محمد % % بلا غاية ما دامت الصحف تكتبسقط بيتين ص % % PageV01P273 البحر : - 1(@)(@@) % و لا في بقاع الأرض حيا وميتا % و لا فوق آفاق السماء كأحمد % % PageV01P274 البحر : - 1(@)(@@) % تعلقت بالأسباب دون مدبري % % فقطعها بي فانقلبت إلى خسر % 2(@)(@@) % و لو أننياستغنيت بالله وحده % % عن الخلق لم أحتج لزيد ولاعمرو % % 3(@)(@@) % فيا واسع اللطف الخفي تولني % % بلطفك واشرح سيدي بالرضا صدري % % 4(@)(@@) % و ألبس حمى ذلي بعزك عزة % و أسبل على الستريا مسبل الستر % 5(@)(@@) % ولا تمنحي الورى بعظيمة % يضيق لها ذرعي ويفنى لها صبري % % 6(@)(@@) % و إن رأت الأعداء كيف تكيدني % % فخذها بكف الكف من حيث لا أدري % % 7(@)(@@) % و صن ماء وجهي عن سؤال مذلة % بفضلك وأشملني لدى العسر باليسر % 8(@)(@@) % و جوهر بنورالعلم قلبي وقالبي % % و ضع إصر أوزاري التي أنقضت ظهري % % 9(@)(@@) % و أكرم لأجلي من يليني رحامة % و حط أنسهم بالخير من شرر الشر % 10(@)(@@) % و كن سيدي عونيوغوثي دائما % و عزي وحرزي دائما وغنى فقري % % PageV01P275 البحر : - 1(@)(@@) % صل الرغائب عشرا واثنتين وكن % في كل ركعة اقرا الحمد منفردا % % 2(@)(@@) % و القدر معها ثلاثا مثل ما ذكروا % % واقرا اثنتين وعشرا معهما الصمدا % % 3(@)(@@) % و صل من بعد إكمال الصلاة على الن % % بي سبعين واسجد مثل من سجدا % % 4(@)(@@) % و فيه سبح وقدس مثلها وإذا % % رفعتقل ربي سبعين احصها عددا % % 5(@)(@@) % واسجد لربك واخلص في السجود وسل % تعط فمن جد في إخلاصه وجدا % % PageV01P276 البحر : - 1(@)(@@) % لم يبق في الحي من ربع ولا طلل % إلا رهينة دمع أو دم طلل % % 2(@)(@@) % مشاهد للهوى العذري لو ذكرت % أنست بما كان في صفين والجمل % 3(@)(@@) % راح الفراق بأرواح الرفاق فكم % دم يراق بغير البيض والأسل % 4(@)(@@) % و رب معتصم بالصبر تيمه % بعد الفريق وفقد الجيرة الأول % 5(@)(@@) % تباعد العهد 
ms89	 عن دار رضعت بها % % مع المحبين دار اللهو والغزل % 6(@)(@@) % حياك يا دار هم بالرقمتين حيا % % يهمى بمنهمر في الروض منهمل % 7(@)(@@) % و فاح بالعنبر الهنديروحصبا % % في عبقري ربى أبهى من الحلل % 8(@)(@@) % و لاح في الشعب ذاك الطل مبتسما % عن ثغر زهر بنار النور مشتعل % 9(@)(@@) % فلا ترى العين إلا ما تسر به % من مورق خضر أو مونق خضل % 10(@)(@@) % رعيا لجيرة مجد يوم كنت وهم % في ظل شمل على اللذات مشتمل % PageV01P277 11(@)(@@) % و في الخدور بدور في محاجرها % % سحر من الحسن يدني آجل الأجل % 12(@)(@@) % نعس مكحلة لمس معسلة % يا حبذااللعس الممزوج بالعسل % 13(@)(@@) % ليت الفريق الذي فارقتهمعلموا % % أن الخلي فؤادي منه غير خلى % % 14(@)(@@) % تهفو نوازع قلبي كلما هتفت % حمائم الأيك في الإشراق والطفل % 15(@)(@@) % و ما وقوفي مع الركبان في دمن % بالغور لا ناقتي فيها ولا جملي % % 16(@)(@@) % و فيعواجةنار بتأرقبها % % كأنها نار موسى ليلة الجمل % 17(@)(@@) % أو نور هدي يريك الشمس طالعة % في نقطة المجد لا في نقطة الحمل % 18(@)(@@) % حيث الصفات بفضل الذات شاهدة % في مشهد الحكمى الفرد والبجلى % % 19(@)(@@) % السيدين الكريمين اللذين هما % % في الصالحين كخير الخلق في الرسل % 20(@)(@@) % طودى علا وإمامى أمة وسط % من سادة ذكرهم في الوحى حيث تلى % % PageV01P278 21(@)(@@) % مخصصين ببشرى رحمتي وسعت % مخاطبين بكنتم خير في الأزل % 22(@)(@@) % لزيمهم بعرى التوفيق معتصم % و للنزيل لديهم أكرم النزل % 23(@)(@@) % و جارهم في الحمى الأعلى ومادحهم % يحظى بما شاء في الدارين من أمل % 24(@)(@@) % أولاك في الأوليا أضحت ولا يتهم % كأنها ملة الإسلام في الملل % 25(@)(@@) % صفهم بما شئت من علم ومن عمل % و اضرب لمثلهم الأعلى من المثل % 26(@)(@@) % ياظاميء القصد ذا المرعى الخصيب فعج % نحو الكثيب لدى شرب ومغتسل % 27(@)(@@) % و انظربعينكآثارا مباركة % تمحو بها ما اجترحناهمنالزلل % 28(@)(@@) % لا تبغ بالربع عن تلك الربا بدلا % فالشمس طالعة تغنيك عن زحل % 29(@)(@@) % حيث الجنابمنيع والحمى حرم % معظم أزلي الفضل لم يزل % 30(@)(@@) % أهذهطيبة ما بين منبرها % % و قبرها روضة 
ms90	 مسلوكةالسبل % PageV01P279 31(@)(@@) % أمالصفا والمصلى والنقا ومنى % % والحجر والحجر المخصوص بالقبل % 32(@)(@@) % سر عليه قلوب الخلق عاكفة % لدى وليين حازوا فضل كل ولى % 33(@)(@@) % يا منتشبه من جهل به بهما % % ليس التكحل في العينين كالكحل % 34(@)(@@) % إن الفضائل حيث الشخص متحد % و الناس أجمع في شخصين عن رجل % 35(@)(@@) % سيفين في غمد قلبين في كبد % روحين في جسد نورين في بدل % 36(@)(@@) % بدرين في الخضرة القدسية ارتقيا % % ذؤابة العز والحظ العلي على % 37(@)(@@) % يا لاثما ترب أرض شرفت بهما % % جدد بها عهد ود غير منفصل % 38(@)(@@) % واسجد لربك شكرا وادع مبتهلا % فكم هنالك من داع ومبتهل % 39(@)(@@) % و انزل بمن حل في القبرين مصطحبا % حسن الظنون وسل ما شئته تنل % 40(@)(@@) % و لا تقل كان هذا في حياتهما % % فالجاه جاههما والحال لم يحل % PageV01P280 41(@)(@@) % يا سادتي حصحص الحق العدا هدموا % % مجدى فغلوا يدا الأشرار بالشلل % 42(@)(@@) % كونوا لمادحكم عبد الرحيم حمى % % و فرجوا عنه ما في القلب من شغل % 43(@)(@@) % كهل كبير وأطفال وحاشية % لا يقدرون على التحويل والنقل % 44(@)(@@) % و باغض يشمت الأعداء بي حسدا % منه فسوموه ذل الويل بالنكل % 45(@)(@@) % إني انتصرت بكم والله أصركم % أين الحمية منكم بالحماية لي % 46(@)(@@) % و أي نقص عليكم أن أكون لكم % مولى يليني الجناب الرحب حيث يلي % % 47(@)(@@) % كمعمبركماللهدركما % % بالخير يا سيدي حاف ومنتعل % 48(@)(@@) % و كم دعا بكما نفسي فداؤكما % % مستنصر فانثني بالنصر عن عجل % 49(@)(@@) % لم لا وظلكما صاف وبحركما % % طام فما حاجة الظامي إلى الوشل % 50(@)(@@) % و أنتما أمل الراجي وعطفكما % % أهل الغريب وأمن الخائف الوجل % PageV01P281 51(@)(@@) % و نحن دنيا وأخرى في ذمامكما % % نرجو النجاة إذا ضاقت عرا الحيل % 52(@)(@@) % لا زلتما لمنار الدين تكرمة % و عصمة ماجرى التفصيل في الجمل % 53(@)(@@) % و ها كما عقد جيد الحور ألفه % مهاجري قليل العلم والعمل % 54(@)(@@) % أعده في الأعادي سبف نصرته % و درع عصمته في الحادث الجلل % 55(@)(@@) % و جاد قبريكمافي كلآ ونة % روح الإله بصوب العارض الهطل % 56(@)(@@) % واستوطنت رحمة 
ms91	 الرحمن تربكما % % تفيض بالفضل في الإصباح والأصل % PageV01P282 البحر : - 1(@)(@@) % قسمت قلبك في الهوى فتقسما % % و قتلت نفسك وهي أقدار السما % % 2(@)(@@) % ترمى بعينك في عيون مطافل % لحظاتها بالسحر تقتل من رمى % % 3(@)(@@) % و تحن إن ذكروا معاهد رامة % يابعد رامة من مرامك مرتمى % % 4(@)(@@) % للظاعنينعلى عهد أنني % % أجري المدامع حين أذكرهم دما % % 5(@)(@@) % و أنوح في آثارهم متعللا % من بعد بعدهم بعل وربما % % 6(@)(@@) % و أنا الفداء لذي جمال باهر % أنجدت يوم البين عنه وأتهما % % 7(@)(@@) % لكنني استمتعت منه بنظرة % كالحلم أو كالبرق حين تبسما % % 8(@)(@@) % فرأيت بدرا تحت ليل حالك % و عجبتمنحسن أنار وأظلمنا % % 9(@)(@@) % ترعى النواظر في محاجر خده % روضا أقام الحسن فيه وخيما % % 10(@)(@@) % و يردن من ثغر الحبيب ملسعا % و معسلا ومؤشرا و موشما % % PageV01P283 11(@)(@@) % ظمئت مراشفناإليه وريها % % في ذلك اللعس المعسل وا للمى % % 12(@)(@@) % لم يدر عني ذو المحاسن أنني % % أودعته روحي ورحت متيما % % 13(@)(@@) % خالسته يوم العذيب حشاشتي % % و جلوتهبدرا تقلدأنجما % % 14(@)(@@) % طرح السلام بطرفه فأذابني % % ما ضره لو حين سلم سلما % % 15(@)(@@) % يا صاحبيو للزمان تقلب % بالناس لو أنصفتمالعذرتما % % 16(@)(@@) % لا تكثرا عذلي فإن سجيتي % % شجن حشا الأحشاء جمرا مضرما % % 17(@)(@@) % و متى أعوج إلى عواجه نازلا % بالربع من ذاك الجناب مسلما % % 18(@)(@@) % و أهل بالإحرام زائر سادة % من زار تربتهمأهل وأحرما % % 19(@)(@@) % هي روضة مزجت بطينة طيبة % وسمت فنافست الحطيم وزمزما % % 20(@)(@@) % و عراصها خيم الغنى ومن المنى % % و خضم بر في البرية قد طما % % PageV01P284 21(@)(@@) % ذا ابن الحسين وذا أخوهفتى أبي % بكرهما سرالوجودهما هما % % 22(@)(@@) % قمرانبالذكرالجميلتجملا % و تجللاو تسربلاو تعمما % % 23(@)(@@) % غوثانإنعدتالعواديأوقسا % % قلبالزمانفما أبرو أرحما % % 24(@)(@@) % إنتقصدالبجلى عشتمبجلا % أو لذتبالحكمى قالتحكما % % 25(@)(@@) % فلذاو ذاخلق أرقمنالصبا % % و ألذمنماءالعذيبعلى الظمأ % % 26(@)(@@) % أمحمد ومحمد للهمن % جبلينيحميكلمنبكمااحتما % % 27(@)(@@) % لكمابيحملعرشربكهمة % و يد منالأيديالتيبنتالسما % % 28(@)(@@) % و إليكماجرتالإشارةليلة ال % % معراجإذحياالرسولو سلما % % 29(@)(@@) % كانالورى عدما و آدملميكن % فدعاالنبيبروحه روحيكما % % 30(@)(@@) % و أقيمكرسيالنبوة غاية % لولا سميكماسما لسبقتما % % PageV01P285 31(@)(@@) % فجذبتمابسلال الأنوار في % % سبق العنايةفافعلاماشئتما % % 32(@)(@@) % و شربتماكأسالوصالروية % فيحضرة قدسية جمعتكما % % 33 
ms92	(@)(@@) % و لبستمامنعبقريكرامة % حللالرضالاالعبقري المعلما % % 34(@)(@@) % فغدترياضالأرضرضوانية % بكماتشعشع نورهافتبسما % % 35(@)(@@) % و ثنتخزامى القربعطفسرورها % % طربا و عادحمامها مترنما % % 36(@)(@@) % إنالولايةخلعة مرموقة % بكماوعزمنسموكماسما % % 37(@)(@@) % و الهدى تاج للزمانمرصع % بجواهرالعلمالذيعلمتما % % 38(@)(@@) % تجريبأمركماالأمورإلى مدى % % عزلا و توليةكماأحببتما % % 39(@)(@@) % و يحيطسركماالوجودفكلما % % في الكون لا يخفيهشيء عنكما % % 40(@)(@@) % إنيأعدكمالدفعمكارهال % % دنياوالاخرى حيثكنتو كنتما % % PageV01P286 41(@)(@@) % هل عطفة بجلية حكمية % % نبوية صمدية ليمنكما % % 42(@)(@@) % أبني بهامجديو أمنع جانبي % % و أردأنفمنابتغانيمرغما % % 43(@)(@@) % عار على أهلالحفائظإنرأوا % % روعالثعالبيفترسن الضيغما % % 44(@)(@@) % سلاسيوفكما وذباعنحمى % % عبدالرحيم ومنيليه تكرما % % 45(@)(@@) % قولالمنيبغيأذاه معاندا % شلت يداه وعمعينيه العمى % % 46(@)(@@) % و خذاعلى أيديعدايو أدركا % % حبلالجلالةقبلأنيتصرما % % 47(@)(@@) % أينالحميةبالحمايةليفقد % أعذرتيا أهلالحمايةو الحمى % % 48(@)(@@) % لا زلتماغيما يمد ظلاله % % سترا على مثلى و يمطر أنعما % % 49(@)(@@) % ثم الصلاةعلى النبيو آله % صلى و سلمربناو ترحما % % 50(@)(@@) % ماناح في عذبالعذيبمغرد % أو لاحبرقالأبرقينمغتما % % PageV01P287 البحر : - 1(@)(@@) % سامرتليلكبالغويرفطالا % % و مكثتوحدكتندبالأطلالا % 2(@)(@@) % و عجبتمندمع يصوبو خلفه % كبد تذوبو زفرة تتوالى % 3(@)(@@) % و أمرت قلبكأنيقرفما ارعوى % % و نهيتجفنكأنيسيلفسالا % 4(@)(@@) % و زعمتأنكفي الهوى مستنجد % صبرا فكانالصبرمنك محالا % 5(@)(@@) % للهمنتهفونوازع قلبه % إنبارق بالأبرقينتلالا % 6(@)(@@) % تبكيه ساجعة الرباإنغردت % و تهيجداءفي حشاهعضالا % 7(@)(@@) % إنالعيونالنجلو هيغواقل % تمسى و تصبح للعقول عقالا % 8(@)(@@) % بأبيمودعة تخافت صوتها % % خوف الرقيب وعينها تتمالا % 9(@)(@@) % سارقتهاطرف الحديثو ربماال % % تفتتيمينا والتفشمالا % 10(@)(@@) % قالتتفارقنافقلت لهانعم % قالتفتنسانافقلتلها لا لا % % PageV01P288 11(@)(@@) % قالت فأين تريد قلت أريد من % لم يخش زائر سوحهإهمالا % % 12(@)(@@) % أعني المكين ابن المكين الصالح اب % % ن الصالحين الماجد المفضالا % % 13(@)(@@) % مولاي إسمعيل نجل محمد % فرع لذاك الأصل طاب فطالا % % 14(@)(@@) % أثرى بنو الدنيابهو بأهله % عملا و علما تضرب الأمثالا % % 15(@)(@@) % قمر تسر به العيون وتمتلى % % منه القلوب لنوره إحلالا % % 16(@)(@@) % يا راكبا ظهر العزائم راجيا % نجح المطالب واصل الترحالا % % 17(@)(@@) % و تحل في حرم المضيضا روضة % قدسية مملوأة أبدالا % % 18(@)(@@) % أرضا مباركة يقبل تربها % % وتحط في عرصاتها الأحمالا % % 19(@)(@@) % و بها صبيحة كل سبت موقف % للأنس ينسيك التقى واللالا % % 20(@)(@@) % إن فاتني الحج المبارك زرتها % % ورجوت أجر المحرمين حلالا % % PageV01P289 21(@)(@@) % و عاقني عن قصد طيبة عائق % فهنا معارف لا تذمفعالا % % 22(@)(@@) % هذي 
ms93	 البحور المكدشية قد طفت % فاغرف بكفك واترك الأوشالا % % 23(@)(@@) % و بمشهد القبر اليماني سيد % علم يزيد به الكمال كمالا % % 24(@)(@@) % مستودع البركات خير ثماركن % إذكان غوثا للورى وثمالا % % 25(@)(@@) % سر النبوة في الولاية كامن % يمحو ويثبت كلحال حالا % % 26(@)(@@) % بحر يموج بكل خير لجه % و غمام مرحمة ندى وظلالا % % 27(@)(@@) % يا من يخوفني من الزمنالذي % % عكس الأمور وحول الأحوالا % % 28(@)(@@) % فأبو الثلاثة في الخطوب وسيلتي % % مهما استغثت أو استنلت نوالا % % 29(@)(@@) % و يدالثلاثةبعدهيد نصرتي % % و لسان حالي حجةو جدالا % % 30(@)(@@) % ياسادتي والدهر غير مساعد % إن الليالي بالأمور حبالى % % PageV01P290 31(@)(@@) % أنا غرس نعمتكم وروض غمامكم % و نزيل عزكم المنيع مثالا % % 32(@)(@@) % فارقت قوميإذ ذهبت مغاضبا % و تركت فيهم إخوة وعيالا % % 33(@)(@@) % و جعلت عينا لا تنام عليهم % عينا وحسبي ذو الجلال تعالى % % 34(@)(@@) % ووصلتكم أرجو بجاه وجوهكم % و بجاه سيدنا الجمال جمالا % % 35(@)(@@) % فبمثلكم نرجو الجنان ونأمن الن % % يران يوم نشاهد الأهوالا % % 36(@)(@@) % قوموا قيام المصطفى بخزاعة % وامحوا الرسوم وفتحوا الأقفالا % % 37(@)(@@) % و استنجدوا لهم السرية واقمعوا % % زمنا تكون الحرب فيه سجالا % % 38(@)(@@) % واحموا حمى لا يستباح وأرسلوا % % شهب الهلاك على العدا إرسالا % % 39(@)(@@) % عار على الأسد الغضنفر أن يرى % % ضبعالفلاتتصيد الأشبالا % % 40(@)(@@) % حاشا جلالتكم ومنصب مجدكم % أن تتركوني للخطوب مجالا % % PageV01P291 41(@)(@@) % فلو أنها طارت شرارة بأسكم % غضبا على الجبل الأشم لزالا % % 42(@)(@@) % عودوا علي بحسن شيمتكم فإن % لم ترحمونيفارحموا الأطفالا % % 43(@)(@@) % مازلت أرجوكم لكلملمة % عظمت وأحسن فيكم الآمالا % % 44(@)(@@) % و أعد كم ليعدةووسيلة % و لمنأراد بيالنكالنكالا % % 45(@)(@@) % إنلم يكن في غيمكم غيث ولا % % طلل على روض ذوي أوحالا % % 46(@)(@@) % فالأولياء جبال عز أينما % % كانوا وكنتم للجبال جبالا % % 47(@)(@@) % دمتم منى للطالبين وموسم ال % % راجين ما اعتنق الجنوب شمالا % % PageV01P292 البحر : - 1(@)(@@) % حياك يا ربع ليلى كل هطال % يسقى بقية أظلال وأطلال % 2(@)(@@) % و بات رعد سواريه يحن إلى % % تجديد عهد بذاك المعهد البالي % % 3(@)(@@) % سقى الخمائل من وادي البشام إلى % % سفح الخزام فشعب الشيح والضال % 4(@)(@@) % ملاعب اللهو لا دهرى القديم 
ms94	 بها % % دهري القديم ولا حالي بها حالي % % 5(@)(@@) % ذهبن أيامأهليهاكماذهبت % نسائم الريح بين المهمةالخالي % % 6(@)(@@) % من لي برد نعيم لا لحاق به % و جيرة عن يمين الحي حلال % 7(@)(@@) % يوم الغرامغريميو الحمى وطني % % و أعين العين شغلي دون أشغالي % % 8(@)(@@) % و اللهو ديني ودار الظاعنين إلى % % داري وفي الحي أعمامي وأخوالي % % 9(@)(@@) % هيهات ذاك زمان فات أطيبه % بالغور من غير تفصيل وإجمال % 10(@)(@@) % إذا تذكرت أيامي به وكفت % عيني بعبرة باكي العين مثكال % PageV01P293 11(@)(@@) % ماالحب إلا لقوم يعرفون به % لايشعرون بلوام و عذال % 12(@)(@@) % و راحة الصب أن يروي الصبابة عن % دمع يسيل لدمع غير سيال % 13(@)(@@) % فما على القلب أن تهفو نوازعه % إلى حبيب بدين الحب مطال % 14(@)(@@) % لله در اللياليما فصمن عرى % % صبريالجميل ولا همت بأذيالي % % 15(@)(@@) % و العز طود منيع لا يحل به % إلا نزيل حمى أسد وأشبال % 16(@)(@@) % المكد شيين سر الصالحين فهم % أهل الهدى والندى والمفخر العالي % % 17(@)(@@) % غمائم الجودأعلام الوجود فهم % سهمى المعلى وفألي أسعد الفأل % 18(@)(@@) % لزيمهم في رياض الخير مغتبط % و جارهم في نعيم ناعم البال % 19(@)(@@) % يا رائحا من ربا النيابتين على % % و جناء مجفرة الجنبين شملال % 20(@)(@@) % دعها تنخ في ديار الغانمية في % % روض أريض لذي جود وإفضال % PageV01P294 21(@)(@@) % في ريف رأفة قطب عالم علم % أغر يكثر فيه ضرب الأمثال % 22(@)(@@) % المكدشي الغياث المستغاث به % لحل منعقد أو فتح أقفال % 23(@)(@@) % فردالحقيقة سني الطريقة يا % % لله من قائل بالحقفعال % 24(@)(@@) % غوث لملتجيء غيث لمنتجع % ليث على ملة الإسلام رئبال % 25(@)(@@) % إن الفقيه جمال الدين مدلنا % % عن سر معناه ظلا غير زوال % 26(@)(@@) % الصائم القائم المحي الظلام وما % % أدراك ما سر ذاك القانت التال % 27(@)(@@) % لما تمكن منه الحب من قدر % سقاه غبا بكأس منه سلسال % 28(@)(@@) % فقامفي مشهد التوفيق ممتثلا % للحق بالحقلا بالحول والحال % 29(@)(@@) % صفه بما شئت من علم ومن عمل % و انزل بأغلب لا جاف ولاعالي % % 30(@)(@@) % و يابنه شرف الدين الذي وصلت % به المحامد حرف الميم والدال 
ms95	 % PageV01P295 31(@)(@@) % تدر بالنعمة الخضراأنامله % فتخجل السحب من جود بإجزال % 32(@)(@@) % و صنوه عمر ما صنوه عمرو % % سامى الذوائب واقى العرض بالمال % 33(@)(@@) % ذو العلم والحلم والتبريز إن نجمت % بين العوالم عميا ذات إشكال % 34(@)(@@) % و سابق الدين روض الرائدين له % فضل يقهقر عنه كل مفضال % 35(@)(@@) % نيطت مكارم أخلاق الكرام به % فكل عنه لسان القيل والقال % 36(@)(@@) % تلك الثلاثة جاهى عندوالدهم % و حصن عزى وكنزي عند إقلالي % % 37(@)(@@) % لله در فروع طاب عنصرهم % زهر لزهر و أبدال لأبدال % 38(@)(@@) % يقفون في إثرهمآثار والدهم % حكم التوابع في عطف وإبدال % 39(@)(@@) % أولاهمالفضل من صفى سرائرهم % % عن فخر مفتخر أو كبر مختال % 40(@)(@@) % و في المضيضا شموس ما قصدتهم % % إلا رأيت بقاع الأرض تطوى لي % % PageV01P296 41(@)(@@) % غبار تربتهم تمحى الذنوب به % فكم بتربتهممن حط أثقال % 42(@)(@@) % و كم هنالك من حاج ومعتمر % بغير سعي و إحرام وإهلال % 43(@)(@@) % قوم جرى حبهم مجرى دمي فهم % روح لروحي وأوصال لأوصالي % % 44(@)(@@) % حلت محاسنهم جيد الزمان فما % % أصفى الزمان وأبهى جيده الحالي % % 45(@)(@@) % و زخرفت بهجة الدنيا صنائعهم % للعرب والعجم في سهل وأجيال % 46(@)(@@) % يا ظامىء القصد زرنيل النواتل ولا % % يسد عينك عنه لامع الآل % 47(@)(@@) % تلقى بني مكدش الأجواد بحر غنى % % يغنيك عن ورد ضحضاح وأوشال % 48(@)(@@) % يا سيدي يوسف اسمع ما أقول ولا % % تهمل جنابي فلستم أهل إهمال % 49(@)(@@) % لي منك بل من نبيك الغر واقية % بالله تغتالعني كل مغتال % 50(@)(@@) % و البيت بيتكم والغرس غرسكم % و الدهر ما بين إدبار وإقبال % PageV01P297 51(@)(@@) % فاحموا حماكم وقولوا لا تخفدركا % من اعتداء عدو أو قلى قالي % % 52(@)(@@) % فلي ظنون وآمالي بكم حسنت % لاخيب الله منكم حسن آمالي % % 53(@)(@@) % دمتم ودامت رياض الدين مسفرة % منكمبشيب وشبان وأطفال % 54(@)(@@) % و جاد ترب المصيصا كلمنسجم % يهمى بعارض تعظيم وإجلال % PageV01P298 البحر : - 1(@)(@@) % من أين يخلق وجدك المتجدد % و يزول عنك حنينك المتردد % 2(@)(@@) % و قداستفزك بالرحيل بمودع % قال الرحيل غدا عدمتك يا غد % 3(@)(@@) % لم لا توافق من ينوح على 
ms96	 ربا % % نجد وتبكيه الطلول الهمد % 4(@)(@@) % أتطيب نفسا و الفريقبزينب % من ذى الأراكة يهبطون ويصعد % % 5(@)(@@) % بان الخليط ولم تفز من وصلهم % بأقل مايتزودالمتزود % 6(@)(@@) % هب أن جفنك دمعهمتفجر % و قليبك المسكين صخر أصلد % 7(@)(@@) % تصلى الحنين إلى غوير تهامة % هيهات منك تهامة يا منجد % 8(@)(@@) % و تنوح إن عبر النسيم يمانيا % فينم دمعك بالغرام وتجحد % 9(@)(@@) % أفلا شجتك على الأراكشجية % وقفت بأيمن ذي الأراك تغرد % 10(@)(@@) % ألفت مواصلة السجوع وربما % % غنت فذابت من بكاها الأكيد % PageV01P299 11(@)(@@) % فأنا الفداء لمن يهيمبمثلها % % مثلي فأدنو للوصال وتبعد % 12(@)(@@) % ذهبية القسمات رائعة الصبا % % ترنو فيحسدهاالغزال الأغيد % 13(@)(@@) % يا نازلين على العذيب وثهمد % بأبي وبي كيف العذيب وثهمد % 14(@)(@@) % أخزامه وبشامه وأراكه % خضر على ما تعهدون وأعهد % 15(@)(@@) % و هل النسيم نسيمه بالروح والر % يحان في عذباته متردد % % 16(@)(@@) % فوراء خدع الشعب أهيف لم يدع % في حسنه للحسن شيئا يفقد % 17(@)(@@) % أمسى يعللني جنى عسل لدى % % لعس على برد أذوب وتجمد % 18(@)(@@) % ولهي به ولهي به وصبابتي % % كصبابتيوالشوق أزيد أزيد % 19(@)(@@) % و جفا الزمان فلا عذولمعرض % عنيوعنه ولا صديق مسعد % 20(@)(@@) % لولا الجناب المكدشيحمايتي % % و رعايتيألجاإليه فأسعد % PageV01P300 21(@)(@@) % و بنو الفقيه محمد شهب الهدى % % عزي وكنزيو الفقيه محمد % 22(@)(@@) % سحب يمر بكل خير ظلهم % ملاء لهم في كل صالحة يد % 23(@)(@@) % زهر مهذبةالأصولأئمة % مهدية لهم العلى والسؤدد % 24(@)(@@) % فمنارهمفوق الكواكب رفعة % و نوالهم في الناس بحر مزبد % 25(@)(@@) % سادات سادات الورى وأبوهم % للكل من كل الأفاضل سيد % 26(@)(@@) % العالم العلم الممكنجاهه % قمر تحل به الأمور وتعقد % 27(@)(@@) % بدل من الأبدال بل علم من ال % % أعلام أروع زاهد متعبد % 28(@)(@@) % هو بهجة الدنيا وعصمة أهلها % % و الحق يشهد والخلائق تشهد % 29(@)(@@) % سر سرى من يوسف بن محمد % لمحمد فهو الجمال الأمجد % 30(@)(@@) % حامى الحمى شرف الوجودو إنما % % ذا النور من تلك الغزالة يصعد % PageV01P301 31(@)(@@) % الطيب ابنالطيبينعناصرا % طابتذؤابتهو طابالمحتد % 32(@)(@@) % قيدت آماليبهمو بحبهم % و الحبيطلقأهله ويقيد % 33(@)(@@) % و رجوتهمحيا و ميتا أنهم % حصنى إذا مكر الزمانالأنكد 
ms97	 % 34(@)(@@) % أمحمد العلم بنإسماعيل يا % % من نوره متشعشع متوقد % 35(@)(@@) % بركات وجهك عمت الدنيا ومن % فيهافجارك جاره لا يضهد % 36(@)(@@) % وتراب قبرك للزيارة كعبة % من حب ساكنه الرواحل تسأد % 37(@)(@@) % يهوى إليه الزائرون كأنه % حرم به حجر وركن أسود % 38(@)(@@) % والحج يقصد كل عام مرة % و بك المضيضا كل وقت تقصد % 39(@)(@@) % كم حجة مبرورة وزيارة % يرجو بها في الجنتين تخلد % 40(@)(@@) % فغدت وراحت في ثراكم بكرة % و عشية سحب تجود فتعمد % PageV01P302 41(@)(@@) % مولاي لي فيكم زروعسجية % أرجو بها ثمر السعادة يحصد % 42(@)(@@) % و لقد نزلت بسوحكمو جعلتكم % حرما يلاذ بهو غوثا يقصد % 43(@)(@@) % و جنابكم عزيوكنز مطالبي % % و لسان حالي في الصديق وفي العدو % % 44(@)(@@) % و غريبة عربية كلماتها % % غرر تفوقالدروهومنضد % 45(@)(@@) % وصلت من النيابتين ومالها % % غير البحور المكدشية مورد % 46(@)(@@) % التائبون العابدون الحامدو % % نالسائحون الراكعون السجد % 47(@)(@@) % القائمون وفي المضاجع لذة % الصائمون وفي الهجير توقد % 48(@)(@@) % دمتم دوام الأينيا شهب الهدى % % و عليكم مني السلام السرمد % PageV01P303 البحر : - 1(@)(@@) % هب النسيم فملست منه أشجار % و غردت في بشام الشبح أطيار % 2(@)(@@) % و ضاحكالبرق أزهار الرياض فمن % فضى مذهبها نور وأنوار % 3(@)(@@) % فهزني الشوقلا دمعي يكفو لا % % قلبي إذا ما رمت الصبرصبار % 4(@)(@@) % و طال عهديبدار كنت ساكنها % % قدحال مندونها نجد وأغوار % 5(@)(@@) % فليتشعري هلالأيامتسعدني % % بوصلقوم نأتبي عنهمالدار % % 6(@)(@@) % أحنو جدا وتذكارا لهمبهم % و الحبأقتلهوجد و تذكار % 7(@)(@@) % يا جيرة الحي كيفالمنجدونو هل % بالشعب في سمراتالحيسمار % 8(@)(@@) % و هلألمتصبانجد مودعة % للظاعنينو سارتأينماساروا % % 9(@)(@@) % و أينحلوامنالواديو هلضربت % % لهمعلى العلمالغربيأخدار % 10(@)(@@) % يا هائمالقلبثقبالصبر معتصما % فكلشيء لهحد و مقدار % PageV01P304 11(@)(@@) % و إنبليتبأحكامالزمانفلا % % تجزعفللدهرإقبال و إدبار % 12(@)(@@) % و اعلم بأنكجارالأهدليو في % % ذماممحترم يحميبهالجار % 13(@)(@@) % فانزليتربتهإيمانزلتو سل % أهذه طيبة و الخلقزوار % 14(@)(@@) % أممشهدالكعبةالبيتالحرام وفي % % أكنافها الوفدحجاج وعمار % 15(@)(@@) % بجاهمنشرفتهذى البلادبه % كمابأحمدقدما شرفالغار % 16(@)(@@) % سقى الكثيبكثيبالسدرصوبحيا % غمامهبصنوفالخيرمطار % 17(@)(@@) % ففيهسر منالأسرارمبتهج % فيسمتكلولي منهأسرار % 18(@)(@@) % مهذب شرف اللهالوجودبه % و إنماو لدالمختارمختار % 19(@)(@@) % ظل ظليل وغيث يستغيثبه % عجم و عرب و بدو ثمحضار % 20(@)(@@) % لهالحمايةفيالدنياويوم غد % تمحى بهعنجميعالخلقأوزار % PageV01P305 21 
ms98	(@)(@@) % و لوأشارإلى نارالسعيرخبت % إذذاكو انطفأتمننورهالنار % 22(@)(@@) % و لودعابجمادالأرضمعجزة % لباهترب و أشجار وأحجار % 23(@)(@@) % و كملهمنكرامات إذا قرنت % بالبحرتخجلهو البحرتيار % 24(@)(@@) % حلتمحاسنهالأيامو امتلأت % منهاجهات كثيرات و أقطار % 25(@)(@@) % و فيالمراوعةالغراءشهبهدى % % همفي حظائرقدسالله أزهار % 26(@)(@@) % آلالنبيو أبناء الوصيفهم % في الأرضو العرضسادات وأخيار % 27(@)(@@) % قوم سمعوابرسولاللهمرتبة % فكلأفعالهمفيالمجدآثار % 28(@)(@@) % سبعالمثانيثناء يمدحون به % و مدحغيرهمسجع وأشعار % 29(@)(@@) % و فيهمالفرديحييالأريحيله % فوقالخليقةأخطار و أقدار % 30(@)(@@) % بدر منير إمام عالم علم % سيف منالسرماضيالحد بتار % PageV01P306 31(@)(@@) % مباركالوجهيرجى فيضنائله % و منهتقضى لباناتو أوطار % 32(@)(@@) % أماو آلعلى الأهدليفهم % لخلعةالكون تطريز و أنوار % 33(@)(@@) % لا بعث شعرا نفيسا بالخسيسو لو % هلكتجوعا فللأشعارأسعار % 34(@)(@@) % و لا تعاظمنيفيمدحمنصبهم % مال و دار و دينار و قنطار % 35(@)(@@) % بلأطلبالخلدفيأدنى محبتهم % و ما على إذاأحببتهمعار % 36(@)(@@) % فهمثمالى و منهمنصرتيو غنى % % فقريو قبلةقصدي أينما ساروا % % 37(@)(@@) % أولاكإن عاهدوا أوفواوإن وهبوا % % أغنوا وإنيستشاروانصرة شاروا % % 38(@)(@@) % كأنما الكون شخص ميت و هم % للكونروح و أسماعو أبصار % 39(@)(@@) % و لميزلجارهميحميو سائلهم % يعطى وعارضهمبالخيرمطار % PageV01P307 البحر : - 1(@)(@@) % تطاول ليلي بعد ليليبثهمد % و أحرق طول الهجر قلبي وأكبدي % % 2(@)(@@) % و لما انتهى صبري وعز تجلدي % % سرى طيف ليلى واطمأن بمرقدي % % 3(@)(@@) % لتجديد عهد لم يكن بمجدد % % 4(@)(@@) % فما بك ياطيف الخيال لك الهنا % % و أسراك وهنا من هناك إلى هنا % % 5(@)(@@) % تذكرنيعهدا تقادم بيننا % % فبت بليل طيب مثمر الجنى % % 6(@)(@@) % و أصبحت في يوم نغيص منكد % % 7(@)(@@) % لقد فرق الهجران شملا تجمعا % % و هيج أشجان النفوس وأوجعا % % 8(@)(@@) % و فتت أكباد القلوب وقطعا % % رعى الله أيام الوصال ولا رعى % % 9(@)(@@) % زمانا على الأحباب بالهجر معتدي % % 10(@)(@@) % أما والهوى العذري إن بعدوا فما % % تغيرت عن حفظ الوداد وإنما % % PageV01P308 11(@)(@@) % بليت بمن أنجدت وأتهما % % يقولون لي سلوا وصبرا عن الحمى % % 12(@)(@@) % و ما كان صبري عن أولاك بمسعدي % % 13(@)(@@) % لعمرك ضاقت بي الجهات وأظلمت % و لم أدر عن ذات اللمى أين يممت % 14(@)(@@) % و إني إذا ورق الحمام ترنمت % ذكرت خياما بالأباطح قسمت % 15(@)(@@) % فؤادي على أهل الطراف الممدد % % 16(@)(@@) % ترى تجمع الأيام بعد شتاتها % % مطافل 
ms99	 غزلان الحمى و حماتها % % 17(@)(@@) % و تضرب خدر الحسن في عرصاتها % % و في الخدر بنت العشر في لحظاتها % % 18(@)(@@) % ملامح ترمى الصب في كل مصعد % % 19(@)(@@) % بنفسي فتاة أغلق البين رهنها % % يذكرني غصن الشبيبة غصنها % % 20(@)(@@) % و لم أدر ما أثنى عليها لأنها % % كلؤلؤة الغواص يجمع حسنها % % PageV01P309 21(@)(@@) % زرود النقا تحت القنا المتأود % % 22(@)(@@) % خليلي دع نفسي تموت بحزنها % % ورددأحاديث الفريق وثنها % % 23(@)(@@) % و إن خطرت في الشعر ليلى فغنها % % لقد فضلت كل الحسان بحسنها % % 24(@)(@@) % كما فضل السادات يحيى بن أحمد % % 25(@)(@@) % كريم السجايا ماجد طيب الثنا % % إذ سئل الإحسان جاد فأحسنا % % 26(@)(@@) % وإن لم تجد مزن الغمامة أرضنا % % فيحيى غمام الخير يمطر بالغنى % % 27(@)(@@) % و بالنعمة الخضرا على كل مجتدى % % 28(@)(@@) % حسا الراح من خمر المكارم وانتشى % % وشيد بيتا للعوارف مذ نشا % % 29(@)(@@) % يصرفه فعل المروءة حيث شا % % و من مثل يحيى وهو أفضل من مشى % % 30(@)(@@) % على الأرض قطعا من مغير ومنجد % % PageV01P310 31(@)(@@) % فتى عمت الدنيا عواطف عطفه % و أمطر من فيها غمائم لطفه % 32(@)(@@) % و عطر أفق الأرض من عرف عرفه % و إن عماد الدين في بطن كفه % 33(@)(@@) % فوائد بحر بالمكارم مزبد % % 34(@)(@@) % فلله من دين السماحة دينه % يجود إذا ما القطر ضن ضنينه % 35(@)(@@) % و يلقاك مل العين طلقا جبينه % تدربأرزاق المفاة يمينه % 36(@)(@@) % بفيض الأيادي البيض والكرم الندى % % 37(@)(@@) % فيا ظامىء الآمال ليلك والسرى % % وزر بحر جود مخصب السوح مخضرا % % 38(@)(@@) % أتظمأ وذا يحيى بن أحمد في الذرى % % شريف منيف طال مجدا ومفخرا % % 39(@)(@@) % بأحمد والسبطين خير محتد % % 40(@)(@@) % يسرك إن أوما إلى الخط كاتبا % و إن قرأ القرآن أبدى عجائبا % % PageV01P311 41(@)(@@) % يغادر أكباد القلوب ذوائبا % و يصدع بالتبريز إن قام خاطبا % 42(@)(@@) % و ينسيك تطريب الحمام المغرد % % 43(@)(@@) % فتى جده البدر الأمين المطهر % و أعلى معاليه البتول وحيدر % 44(@)(@@) % و ما هو إلا بالمحامد يذكر % أديب أريب فيصل متبحر % 45(@)(@@) % فصبح صبيح زنده غير مصلد % % 46(@)(@@) % قطعت حبال لفقر حين وصلته % وأدركت 
ms100	 منه كل شيء أملته % 47(@)(@@) % فلله من يعلو على الشعر نعته % يلذ مديحي فيه مهما مدحته % 48(@)(@@) % و يسكر من غير السلافة منشدي % % 49(@)(@@) % جمعت معاني المدح تاجا لأجله % ونظمته عقدا يليق بمثله % 50(@)(@@) % و أنزلته في داره ومحله % و ما من يقول الشعر في غير أهله % PageV01P312 51(@)(@@) % كمادح قوم شرفوابمحمد % % 52(@)(@@) % أمولاي صنى عن زمان تبدلا % و ضعضعني حمل الذنوب وأثقلا % % 53(@)(@@) % و لم ألق غوثا أستغيث به بلا % % و صلتك يا فرد المكارمو العلى % % 54(@)(@@) % لعل يدا بيضا تمد بها يدي % % 55(@)(@@) % جعلت القوافي نحو جودكمنهجا % % لعلى ألقى منأذى الدهر مخرجا % % 56(@)(@@) % و لي فيك يابدر الدجى أحسن الرجا % % فأنت ثمال الخير والخير يرتجى % % 57(@)(@@) % لديك ووجه الخير وجهك سيدي % % 58(@)(@@) % مدحتك يا ذا الفضل والمفخر السنى % % بمن غيركم ألجأ إذا الضر مسني % % 59(@)(@@) % وهل يطلب الإحسان من غير محسن % فرش حسن ظني بالعوارف واكسني % % 60(@)(@@) % واقض لباناتي وودع وزود % % PageV01P313 61(@)(@@) % بحقك يا مولى على له الولى % % أجرني عذابا رحمة وتفضلا % % 62(@)(@@) % حنانيك يا من جوده ملأ الولا % % بقيت لأهل الأرض قصدا ومو ئلا % 63(@)(@@) % و بابك يا فرد العلى غير موصد % % 64(@)(@@) % ومدت بك النعمى غمائم جودها % % مظلة في غورها ونجودها % % 65(@)(@@) % و مدت لأهل الفضل شمس سعودها % % و لا زلت في الدنيا مناخ وفودها % % 66(@)(@@) % و غيم غناها المستفيض بمسجد % % PageV01P314 البحر : - 1(@)(@@) % خطرت كغصن البانة المتأود % ورنت بناظرة الغزال الأغيد % 2(@)(@@) % و غدت تشير إلى السلام بطرفها % % و بكفها المخضوب خوف الحسد % 3(@)(@@) % فنظرت معسول المنى فوق القنا % % و الليل تحت نقاب شمس الأسعد % 4(@)(@@) % فكأن حالية المحاسن صورت % من فضة عجنت بماء العسجد % 5(@)(@@) % أو درة مكنونة معجونة % بهوى النفوس وذائبات الأكبد % 6(@)(@@) % تلهو العيون بمذهب ومفضفض % من حسنها ومنظم ومنضد % 7(@)(@@) % سلبت ببهجتها العقول وتيمت % مهجا يروح بها الغرام ويغتدي % % 8(@)(@@) % لله موقفنا بمنعرج اللوى % % في الشعب من دون الفريق المنجد % 9(@)(@@) % جاذبتهاطرف العتاب فأعرضت % عني وقالت ما أراكبمسعدي % % 10(@)(@@) % فطفقتأثني عطفها متغزلا % بالأبرقينو 