ms1	(@)(@)(@@)(@@)(@@) || [genre: Ar](@)(@@) 1 بکت الرباب فقلت ای بکا %~% ابکا عهد ام بکا اخا(@)(@@) 2 فالعهد للربع المحور بد معنا %~% ثم الخا لزمرة الخلطا(@)(@@) 3 عین المهاة بکت و لیس من الهوی %~% دمع المهاة یفیض کالا بدا(@)(@@) 4 انهمت عذری الهوی و عفانی %~% یستوی تهامة بهمة السودا(@)(@@) 5 فرمت بثالثة الاثافی مهجتی %~% و سمت برابعه الخیام دمائی(@)(@@) 6 سقیالحا العقص و الدا التی %~% خصب کحرف العقص فی‌الاقوا(@)(@@) 7 صحبی تعالوا نبک فی غصص الشجی %~% جیران انصاف و ربع وفا(@)(@@) 8 وطوال مکرمة و رسم فتوة %~% و خیام معرفة و ن صفا(@)(@@) 9 قد فوضت خیم المکارم بیننا %~% ملائت دموعی سوی کل حیا(@)(@@) 10 حالی کماکره الاحبة بعدهم %~% واحب اعدائی من العدوا(@)(@@) 11 جمدت دموعی فاعتدت یاقوته %~% نیطت بعروة برفی عفرا(@)(@@) 12 فهب اللالی من اجاج اصلها %~% هل اصل یاقوت اجاج الما(@)(@@) 13 نبحت طیور النفس لی من بعدما %~% و دعت طرا السعد من اسما(@)(@@) 14 ایام فی حذو ریاض سنابل %~% انس طبائها وای ظبا(@)(@@) 15 کرت بنات العیس مبد نکحها %~% طیف الخبیث و فیه عقد بقا(@)(@@) 16 والطیف کان مع القرا مدیدة %~% و ابوالبنات مدیدة السودا(@)(@@) 17 ما بال لون الجفن احمر ناصعا %~% ادم البکارة دم النفسا(@)(@@) 18 فعجبت من هندیة حبلت و قد %~% رضعت بصقلابیة صفرا(@)(@@) 19 کاللیل ام الیوم حبلی قدرمت %~% ارضا ابی الیقظان بابن ذکا(@)(@@) 20 مثل العنا قید التی الوانها %~% سود و فیها حمرة السودا(@)(@@) 21 من فرط ما ولدت باحشائی اللظی %~% نار الهوی نبکی علی الاعضا(@)(@@) 22 قالوا لهوی تبکی بلاعین بلی %~% تبکی و هاعیناه حرف الها(@)(@@) 23 کالشمس تقشف من خبااللیل‌الذی %~% نشفت دما کبدی علی الاحشا(@)(@@) 24 ضحکت عروسا مقلتی لدی البکا %~% والضحک حلم الطفلة العذرا(@)(@@) 25 ابکی و اضحک کالسحاب واقتنی %~% حالی و تبع الهند فی الانوا(@)(@@) 26 قالوا اتبکی قلت ابکی ود کم %~% کنتم اودا فصرتم دائی(@)(@@) 27 قالوا تضحک قلت اضحک منکم %~% هذا جواب خائف الاعدا(@)(@@) 28 غدر و ابنا و استغدر 
ms2	 الدنیا بهم %~% دهری یجازی الشر شر جزا(@)(@@) 29 کانوا احبائی اذا کان الغنی %~% فاذا افتقرت یعمل و انقضا(@)(@@) 30 یا صاحبی اصدقنی بحق اخا %~% اشممت عرف السحر من شجرا(@)(@@) 31 این الجواب الغرقته مدامع %~% ام احرقته سمائم الصعدا(@)(@@) 32 قل لا سریعا قبل یختنقی البکا %~% لاباس من استدعیت بعد ندا(@)(@@) 33 عجل اجابة ملحف داعی الهوی %~% و تدارک التحقیق بالارجا(@)(@@) 34 ان صار احمر وجهه من خنقه %~% فا حمر وجهی من خناق بکا(@)(@@) 35 نفس الهوی بمودة لم تعدها %~% احد وینشد بعد فی الاحیا(@)(@@) 36 هیهات ظل دم الوفا وفارة %~% ممن یرام و من له بنوا(@)(@@) 37 و به الوفا ورا احیا من %~% الثقلین لالا یقال و الاحیا(@)(@@) 38 دع ذاوقد سدته نفسی قبلکم %~% فخشیت عن وصلة العنقا(@)(@@) 39 سمیتنی این خلا و ان توطنی %~% فدعوتنی فی‌العروة ابن خلا(@)(@@) 40 قلبی کظیم بعد سؤل یعاتبنی %~% عن بلدتی و ذابح شا(@)(@@) 41 فصبی الدنیا نائبات الهوی %~% و تلففت بلها و کل بلا(@)(@@) 42 تصنع کصنع النمر لفظ کالعوی %~% هاتیک شیمة بلدة اسما(@)(@@) 43 غصن البلاد توفقنی فاسقها %~% هذا الشهاد بسرق البیدا(@)(@@) 44 حتی بدا الصبح فی کم الدجی %~% کم من قضیب من ید شلا(@)(@@) 45 فالصبح املی الدیک سورة والضحی %~% بطلاب سوط صاغ فی الطلبا(@)(@@) 46 حملت الی حمائمی کتب الحمی %~% و تبادرت کفی بفک سجا(@)(@@) 47 عنوانها نفی الکرام فویلتی %~% سمیت اللام لموتة الکرما(@)(@@) 48 خنقتنی العبرات حتی خلتنی %~% قد خیفتنی عربتی بردا(@)(@@) 49 للفی حوامل مقلتی اخیته %~% اکفی بها و ملی لدی الالقا(@)(@@) 50 کم لی نوی‌النفس فی جوف‌الجوی %~% کم لی رکوب البحر فی النکبا(@)(@@) 51 فارقت شروان اضطرارا فاشتهت %~% نفسی بتبریز اختیار سوا(@)(@@) 52 عرفت موج الشعر ملک امارتی %~% خلقا بی لابد من ارقا(@)(@@) 53 اختار صحرا الفراغ مخیمی %~% بل خیمتی حلت علی الصحرا(@)(@@) 54 بتحول البحر المحیط بعمقه %~% لمخیمی نوی یا من من آلانا(@)(@@) 55 اطناب خیمة همتی ممدودة %~% حتی ظلال السدرة الزهرا(@)(@@) 56 و وصلت حبل‌الله 
ms3	 لکن سودت %~% فی غصن طوبی واسع الفیا(@)(@@) 57 اما منحی کالنوی لکن لم اقف %~% کالنوی حمل حیا اهل حیا(@)(@@) 58 احدی سؤلا من مواطل بهجتی %~% فی نوی هذه الخیمة الزرقا(@)(@@) 59 اتاها ثم اوردت متنوع المنی %~% فحرمت ها ثم یمین انا(@)(@@) 60 فاذا انقلت فلیت قناعتی %~% عرفت سجالی ثم حدر شا(@)(@@) 61 محسود ابنا الرذیلة عائذ %~% من امهات الکون بالابا(@)(@@) 62 فالامهات اذا قصدت حیوتة %~% کیف انتظار اماتة الاحیا(@)(@@) 63 شربنی بما العلم بل عرفی به %~% عرف المحیا بما حنا(@)(@@) 64 فضلت علما ان علم قائلی %~% والقیل احیی الذی من العلما(@)(@@) 65 کالشمع ینقص حین زاد لهیبه %~% ما قد نمی علی ذوی حوبا(@)(@@) 66 قد هان لی مذجف روض مدامعی %~% غیث الکرام و ضنة البخلا(@)(@@) 67 من صار مکفوفا فسوا عنده %~% فی السهد لیل سدارة و سمرا(@)(@@) 68 قد کنت اصلب شعره بید الفتی %~% انمی فبدل فی الذیول نما(@)(@@) 69 کلفت تودیع الثیاب و قیل لی %~% هذا النفاق نفاق الصعدة السمرا(@)(@@) 70 لو کان للمنقوش حال تسقف %~% فالدهر قومنی و تقعدنی بفقدا(@)(@@) 71 لاعیب فی عوج الفتی نفسی و انما %~% یغنی من التسقیف و العوجا(@)(@@) 72 لازمت حصنی قبل حصن بالفتی %~% و عضضت طرفی قبل ذوالحملا(@)(@@) 73 ما سمنی الجلسا لکن همتی %~% ذات الغنا و بفقری استغنا(@)(@@) 74 طلعت دنیا کم بلبانه %~% من غیر رحبتها و لا استثنا(@)(@@) 75 عمر قصیر لمواعید خدعته %~% و حدثتنی تفسیرها بالزبا(@)(@@) 76 انی عیال‌الله فی فضل النهی %~% و عیال فضلی عصبة البلغا(@)(@@) 77 کالنبت یاتی السحب یستسقی الندی %~% و الحسب یاتی البحر باستسقا(@)(@@) 78 نسج العناکب فی الجدار مهلهلا %~% سیل الذباب و یصعد الافدا(@)(@@) 79 ما ینسج النحل الضیاع معینا %~% الا علیه طراز کل شفا(@)(@@) 80 سیان لی مدح فی ریاض مطالع %~% عیب الکلام و خلب البخلا(@)(@@) 81 ریق بن آدم یقتل الافعی اذا %~% القاه فی فیها فم الحوا(@)(@@) 82 فضل لذنبی و الجهل نقص کامل %~% کالشمس ظلمة مقلة الرمدا(@)(@@) 83 ما ان اخوک 
ms4	 مهلهلا بشواردی %~% شهد الشهدا و هلهل السفها(@)(@@) 84 اسری ورا الکائنات بخاطری %~% ربی و همتی الغیور ورا(@)(@@) 85 سبحان من اسری بخاطر عبده %~% لیلا الی الاقصی بذی الاسرا(@)(@@) 86 ضؤ العیان کصاحب السرطان بل %~% غیل البیان کصاحب الجوزا(@)(@@) 87 اصبحت داود ذالفضل حنظلة %~% ام بل مزامیر النهی بادا PageV1P0001(@)(@@)(@@)(@@) || [genre: Ar](@)(@@) 1 مهمانسجت دروع مجد فی‌السما %~% حلق الدروع و شمسها حربا(@)(@@) 2 لکن لی قلب کما غائر %~% یشکو استمال الصخرة الصما(@)(@@) 3 قلبی لجسمی نقطة موهومة %~% فی نصف دائرة الحرف الیا(@)(@@) 4 انا افضل الدنیا ما اتی خاطری %~% الا بفضل‌الله ذی الالا(@)(@@) 5 فکذا الجلال مد علی بفضله %~% اعلی جلال الدین ذا العلیا(@)(@@) 6 اثنی علی الحبر الامام و انما %~% ار جوالبنا معطرا الارجا(@)(@@) 7 عمد الشریعة زبدة السادات العری %~% منقی الحقایق مفحم الفصحا(@)(@@) 8 علم الاعلام سیف اعلام الهدی %~% علامة الفضلا و النظرا(@)(@@) 9 خضر العلوم کلیم میقات التقی %~% روح البیان خلیل کل بنا(@)(@@) 10 کالخضر ساد بنا کنز العلم بل %~% کالروح عاد بمهجة الاصدا(@)(@@) 11 اعنی بنفح بیانه قد حاجزت %~% روح البیان بقالب الانشا(@)(@@) 12 هوقس ساعدة الایادی اخیر %~% بید الایادی ساعد الشعرا(@)(@@) 13 اعواده طوبی و مجلس مجده %~% جنات عدن موعد العرفا(@)(@@) 14 طوبی لطوبی ان عدت کرسیه %~% فالعرش یحسده علی استعلا(@)(@@) 15 فی لفظة المعول ملح غله %~% ریح العشیق و ادمع العشقا(@)(@@) 16 الوعظ حلو تطیب بملحه %~% و الملح غیر مطیب الحلوا(@)(@@) 17 لما اتانی زائرا صادقته %~% مولی الفضائل سید الفضلا(@)(@@) 18 قد ضاع فی امدی بر مرحی صورة %~% ازرت با زر عارئه الا زرا(@)(@@) 19 مولی اخ و ان استشاط فقد %~% اولی فمولی بی لفرط ولا(@)(@@) 20 ما اعجبتنی عند ضؤ ضمیره %~% انوار سبعة انجم عدا PageV1P0002(@)(@@)(@@)(@@) || [genre: Ar](@)(@@) 1 انی لاخدم ناصح الخلفا %~% مرد الائمة خاضع الحنفا(@)(@@) 2 بتحیة مشفوعة بمحامد %~% و محامد مقرونة بدعا(@)(@@) 3 و تعارف اکبرته بتذکر %~% و تذکر و شخصة بثنا(@)(@@) 4 و لدیه لی مشفع من خلقه %~% قد سرنی لازال فی 
ms5	 السرا(@)(@@) 5 لقبول مدی حبه حرمته %~% مسودة و حمامة البیضا(@)(@@) 6 و قبوله فرشات معارا الامعارا %~% یسود کحلی کل اما(@)(@@) 7 ریح لجمت سلیمان الحجی %~% تختارها من عاصف و رخا(@)(@@) 8 طور کسبعة ابحر من رحله %~% ذو اربع من امهات هوا(@)(@@) 9 فلک یدور منه هلال سرجه %~% یعلوه بدر صادق الالا(@)(@@) 10 ذوهمة و بهذا عزکانه %~% لیل تبرقع من بریق ضحا(@)(@@) 11 لما تمسست الخلال حسبته %~% نوحا کجودی ای علا(@)(@@) 12 یلقی کلام‌الله فارة طوره %~% و یری حبیب‌الله فوق حدا(@)(@@) 13 ولو استطعت نثره کنوز لالی %~% لیراعه الغواص فی الداما(@)(@@) 14 هو قسورة و دواته صیادة %~% و ابیح عین المسک للادوا(@)(@@) 15 عین بصفرتهایری وجه‌المنی %~% هی تقمع السودا باصفرا(@)(@@) 16 مضحاک وجه وجه کل مطالب %~% مسقام عین عین کل دوا(@)(@@) 17 عین کعین الشمس بالیرقان بل %~% وجه کوجه الما للغربا(@)(@@) 18 لطمت ید الضراب سنة وجهها %~% فبدالها حائلا عدوا(@)(@@) 19 مرموقة الافاق بل مرفوقة %~% الاخلاق بل مخلوقة الاضوا(@)(@@) 20 جوالة البلدان بل قیالة الحزان %~% بل ختالة الارا(@)(@@) 21 جرح الشهود و عدل دیوان القضا %~% اقضی القضاة و اشفع الشفعا(@)(@@) 22 عمر الیهود لها و لون غیارهم %~% لکن مسیح العهد فی الاحیا(@)(@@) 23 عمرت بهدم الفضل عنوان الهوی %~% هدم العقول عمارة الاهوا(@)(@@) 24 جرم کجمر جامد مسائلتی %~% یزکی به قندیل کل رخا(@)(@@) 25 فالجمر یخمدلا یلوح ضیاؤه %~% و لها خمود فی جلوة رضیا(@)(@@) 26 خمر السعتر یری رخیصا شعره %~% فی خمرة کالمسک ذات علا(@)(@@) 27 فکانما کما الحار بعینه %~% اضحی بساطا خامد الاجزا(@)(@@) 28 شرق من عرش احبها فاحبها %~% فانی بعرش فارک رعنا(@)(@@) 29 عرش مطلقة الرجال تعوذت %~% سجن‌الیدین و ساق کل نسا(@)(@@) 30 سرقت عقول الناس فی حربه %~% بالضرب ثم القطع للاشلا(@)(@@) 31 نبهتها بالشهب فی افلاکها %~% هذا نوا الیل علی الحربا(@)(@@) 32 شکل المجن قلب مجن ذوالغنی %~% کیلا یضاف بسهم کل جفا(@)(@@) 33 لکن مجن القلب لا یحمی اذا %~% قلب المحن علیه قلب قضا(@)(@@) 34 جرم صغیر شانه متعظم 
ms6	 %~% کالقلب فی صغر و عظم دها(@)(@@) 35 نور جماد ساکن متقابس %~% کالظل وان اخذه ببنا(@)(@@) 36 سهل یمینها و صعب بنیلها %~% امن الکتاب بمعرة العظما(@)(@@) 37 عقدت علی ساق الحمام صغارها %~% لکن یسهل اصعب الاشیا(@)(@@) 38 ما هذه العین التی عاینتها %~% اخت النهی ابنت شمس سما(@)(@@) 39 لابل ابوالفضل المغیث بعیشه %~% حتی یعد عدای ابوالوضا(@)(@@) 40 دع کیسه مجهولة هو عسجد %~% شبیه الکواکب و اسمه الجوزا(@)(@@) 41 مبدا عنصره اصفهان عقوده %~% احدی و عین عقوده اعطا(@)(@@) 42 روحت مهجة باصفهان بمدحتی %~% اضعاف ما قدلی بهجا(@)(@@) 43 کتب الخلیفة للکلام و سیدی %~% سلطان تاج العلم فی الاکفا(@)(@@) 44 اهدی له بذی الخلافة اسودا %~% و سواد بعض الذی للخلفا(@)(@@) 45 قرضته بقصیدة الفیته %~% والخیر فرطنی بحرف الیا(@)(@@) 46 یعنی له التقدیم کالالف التی %~% قفیتها و اتی ابوالنقطا(@)(@@) 47 هذة القصیدة عصبته شعراتی %~% و بدت لرازی حیضة الشعرا(@)(@@) 48 ارایت حیض لرایت شبابها %~% جوف الاسود فی سواد الهیجا(@)(@@) 49 اسد السما اذا طال ذراعه %~% فصرت لجبهته برا العوجا(@)(@@) 50 قلمی کمنقار الحمام براسه %~% هلک الغراب و منطق الببغا(@)(@@) 51 لومسه الطائی یصیر عزمه %~% صدق الغراب متی الاشیا(@)(@@) 52 ضمنت نصف البیت للطائی وها %~% و سمت باسم الحتری الطائی(@)(@@) 53 اظننت حتی کدت اعرق خجلة %~% فی نصفه المحرم للرخصا(@)(@@) 54 نفسی کتبت و ان افشیتها %~% من خجلتی تمشی علی استحیا(@)(@@) 55 دامت جلال الخیر وافیه الهوی %~% و وقاه الاله اجل وقا(@)(@@) 56 یا فاضل الحرمان بکل موطن %~% ما طاول الهرمان کل بنا PageV1P0003(@)(@@)(@@)(@@) || [genre: Ar](@)(@@) 1 امشرب الخضر ما بغداد %~% او نار موسی لقا بغداد(@)(@@) 2 کوثرنا دجلة و جنتنا الکرخ %~% و طوبی هوا بغداد(@)(@@) 3 و قل لمصر بذکر مصراتت %~% فما لمصر سنا بغداد(@)(@@) 4 تالله للنیل صفو دجلة لا %~% ولا لمصر صفا بغداد(@)(@@) 5 هیهات این استقال مصرکم %~% و این این اعتلا بغداد(@)(@@) 6 غرتک مصر بقاهرة %~% قاهرها کبریا بغداد(@)(@@) 7 نادتک بغداد فانها رغبا %~% ینسیک مصرا ندا بغداد(@)(@@) 8 فامس بغداد یومها 
