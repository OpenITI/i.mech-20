ms121	(@)(@@) % أرى كل فتك للحاظ انتسابه % % وهان مضاء ليس فيه لها حظ % % 2(@)(@@) % ألم تر أن السهم غير مقرطس % % ولا صائب حتى يسدده اللحظ % % PageV01P510 البحر : - 1(@)(@@) % باتت نجوم الأفق دون علاكا % % وتحلت الدنيا ببعض حلاكا % % 2(@)(@@) % والدين دين الله أنت عماده % % لولاك أصبح مائلا لولاكا % % 3(@)(@@) % أنسى زمانك كل عصر ذاهب % % حسنا وأكسى ذكرك الأملاكا % % 4(@)(@@) % فإذا هموا راموا لمجدك غاية % % كان القصور لديهم إدراكا % % 5(@)(@@) % ومحت مآثرك المآثر عندما % % نظمن في نحر العلا أسلاكا % % 6(@)(@@) % شرف يجر على المجرة ذيله % % بلغ السماء وزاحم الأفلاكا % % 7(@)(@@) % وندى كصوب الغيث إلا أنه % % لا يعرف الإمحال والإمساكا % % 8(@)(@@) % وخلائق كالروض زاوله الحيا % % غبا ودبجه الربيع وحاكا % % 9(@)(@@) % ورجاحة لو كان بعض وقارها % % بالريح كانت لا تحير حراكا % % 10(@)(@@) % إن راع من يوم الوغى عباسه % % في الحرب كان جبينك الضحاكا % % PageV01P511 11(@)(@@) % من للحيا بنوال كفك إن همى % % من للسوابق أن تجوز مداكا % % 12(@)(@@) % سيف وسيف ضمنا في راحة % % ضمنت حياة للورى وهلاكا % % 13(@)(@@) % لم تأل في حفظ الرعايا جاهدا % % ومراقبا فيها من استرعاكا % % 14(@)(@@) % إن عز مثواك الممنع طاهرا % % فصدورها وقلوبها مثواكا % % 15(@)(@@) % يحلو حديث العلا في أسماعها % % ويلذ في أفواهها ذكراكا % % 16(@)(@@) % ما روضة ضحكت ثغور أقاحها % % وحياها الحيا فتباكا % % 17(@)(@@) % حضر الولي وأحكمت ريح الصبا % % بين الغمام وبينها إملاكا % % 18(@)(@@) % بات تغنيها الحمام فتنثني % % طربا وتنسيها السحاب دراكا % % 19(@)(@@) % والريح تحسبها كصائد لجة % % يرمي على صفح الغدير شياكا % % 20(@)(@@) % بأتم من عرف امتداحك نفحة % % مهما ثنينا القول نحو ثناكا % % PageV01P512 21(@)(@@) % كم قاصد أنضى إليك مطيه % % متوسدا كورا لها ووراكا % % 22(@)(@@) % شهد العيان له بصدق سماعه % % فاستصغر الأخبار حين رآكا % % 23(@)(@@) % لا يغررن الروم في إملائها % % قدر جرى فالحرب هات وهاكا % % 24(@)(@@) % ولملكك العقبى وحسبك ناصرا % % إن الإله عدو من عاداكا % % 25(@)(@@) % لله يوسف من إمام هداية % % جلى بنور يقينه الأحلاكا % % 26(@)(@@) % تنميه من أبناء نصر سادة % % حاطوا العباد ودمروا الإشراكا % % 27(@)(@@) % فتراهم في يوم محتدم الوغى % % أسدا وفي خلواتهم نساكا % % 28(@)(@@) % كانوا 
ms122	 ملائكة إذا جن الدجى % % وإذا الأسرة مهدت أملاكا % % 29(@)(@@) % أبناء نصر آل سعد ناصروا % % خير الورى طرا وما أدراكا % % 30(@)(@@) % مولاي خذها حلة موشية % % أهداكها حسناء عبد علاكا % % PageV01P513 31(@)(@@) % شردت معانيها وأصبحت ترعا % % عني فراوضها اللسان ولاكا % % 32(@)(@@) % وعلى أبياتها فحين دعوتها % % لمديحك انثالت علي وشاكا % % 33(@)(@@) % هذا وكم لي من وسيلة خدمة % % ما إن يضيع ذماؤها حاشاكا % % 34(@)(@@) % هنئت عيد الفطر أسعد قادم % % حث السرى شوقا إلى لقياكا % % 35(@)(@@) % والشهر ود بأن يطول مقامه % % كلفا بودك منه واستمساكا % % 36(@)(@@) % وفيت حق صيامه وقيامه % % بمقام صدق لم يقمه سواكا % % 37(@)(@@) % انعم بملك دائم لا ينقضي % % واخلد قواما للعلا وملاكا % % 38(@)(@@) % فلو أن دنيا خيرت ما تبتغي % % لم تأمل الدنيا سوى بغياكا % % PageV01P514 البحر : - 1(@)(@@) % النصر نصك والحسام دليله % % والفتح وعدك والإلاه كفيله % % 2(@)(@@) % كفلت رياض الملك منك بدوحها % % فرعا نضيرا لا يخاف ذبوله % % 3(@)(@@) % واهتز دوح الملك منه منعما % % ريان يقصفه الندى ويميله % % 4(@)(@@) % وطلعت بدرا لا يخاف محاقه % % يوما ولا يخشى عليه أفوله % % 5(@)(@@) % حتى إذا خطبتك ألسنة الهدى % % وحباك هذا العهد إسماعيله % % 6(@)(@@) % ورآك أهلا للخلافة بعده % % فأراك قدح الملك كيف تجيله % % 7(@)(@@) % وكسا أيا لتك البلاد وأهلها % % ظلا تكفل بالعباد ظليله % % 8(@)(@@) % وحبا السياسة منك حامل عبئها % % فمضت عزائمه وعز قبيله % % 9(@)(@@) % ثم استحث إلى الإلاه ركابه % % وغدا وفي دار النعيم حلوله % % 10(@)(@@) % فهوت حلوم حدن عنك وما اهتدى % % طرف تعامى عن سناك كليله % % PageV01P515 11(@)(@@) % وهفت بدين الكفر أطماع قضت % % أن تقتضي أوتاره ودخوله % % 12(@)(@@) % ثم استبد العزم فيك وما رتأى % % والعزم يوهن عنده تأجيله % % 13(@)(@@) % ورمى إليك مقاليد الأمر الذي % % تركت إليك فروعه وأصوله % % 14(@)(@@) % واستخبر النصر العزيز ولم يزل % % يلوي بدين الدين فيك مطوله % % 15(@)(@@) % فارتاح دين الله في ريعانه % % وأعيد مقتبل الشبيبة خيله % % 16(@)(@@) % وتكنف الإسلام منك وأهله % % نظير يعز عن النهى تأويله % % 17(@)(@@) % عالجته بالمشرفي وطالما % % أعيا مزاولة الأساة عليله % % 18(@)(@@) % حتى إذا غدت البلاد قريرة % % والأمن تسحب بينهن ذيوله % % 19(@)(@@) % والسلم قد كفت 
ms123	 أكف عداتها % % والباس نامت في الغمود نصوله % % 20(@)(@@) % أرضيت دين الله مقتديا بما % % نطق الكتاب به وسن رسوله % % PageV01P516 21(@)(@@) % تستودع الأنساب غرة يعرب % % وتشيد فخر الأبطال أثيله % % 22(@)(@@) % وذهبت تعتام البيوت ميمما % % ما يممت أذواؤه وقيوله % % 23(@)(@@) % فحداك توفيق الإله لمنصب % % مثواك مثواه وغيلك غيله % % 24(@)(@@) % حيث المعالي والعوالي والظبا % % والبيت عال في البنا أصيله % % 25(@)(@@) % حتى إذا رفت عليك ظلاله % % وسرت بأرواح القبول قبوله % % 26(@)(@@) % وتوشجت أغصان دوحة خزرج % % ذمما وحيز لكل مجد سواله % % 27(@)(@@) % أعرست في مثوى الخلافة بعدما % % عكفت علاك تشيده وتطيله % % 28(@)(@@) % فبدا كما لاح الصباح لناظر % % متألقا يغشى العيون صقيله % % 29(@)(@@) % تبلى الليالي وهي تندى جدة % % ويجف زهر الروض وهو بليله % % 30(@)(@@) % حيث الرياض تفتحت أزهاره % % وهما عليها من نداك هموله % % PageV01P517 31(@)(@@) % حيث الجلال يهول أفئدة الورى % % ويند عن إدراكهم تمثيله % % 32(@)(@@) % وقد ازدهى الديباج في روضاته % % خطلا كما جلت الربيع فصوله % % 33(@)(@@) % من كل منسدل الجناح مهدل % % تضفو بمذهبة القباب سدوله % % 34(@)(@@) % وموسد فوق الأرائك رائق % % يزهى على موضوعها محموله % % 35(@)(@@) % ثم اغتديت وملكك السامي العلى % % مجموع شمل بالمنى موصوله % % 36(@)(@@) % والبشر منسحب الجناح على الورى % % والأنس تشتمل الوجود شموله % % 37(@)(@@) % واللحن قد وشجت غصون ضروبه % % فسبى العقول خفيفه وثقيله % % 38(@)(@@) % خلدت سر النصر في أعقابه % % وسلكت قصدا لا يضل سبيله % % 39(@)(@@) % فعم الخلود بها قصور مقامة % % يحبوك سعد عزها وينيله % % 40(@)(@@) % حتى تزين بالبنين صدورها % % ويلين في باع الخلافة طوله % % PageV01P518 41(@)(@@) % فكأنني بالملك قد عقد الحبا % % وزها بفاخر درهم إكليله % % 42(@)(@@) % فكأنني بك والفتوح سوافر % % والسبي قد غمر الربا تنفيله % % 43(@)(@@) % نصر الهدى سعد وفاز بإرثه % % من بعد يوسف سبطه وسليله % % 44(@)(@@) % ملك عزيز الجار ممنوع الحمى % % ممنوح منهل الندى مبذوله % % 45(@)(@@) % يقظان لا حفظ الثغور يؤوده % % كلا ولا صعب الأمور يهوله % % 46(@)(@@) % وإذا دعاه الملك منه للذة % % ناجاه من تقوى الإله عذوله % % 47(@)(@@) % شمل البلاد وأهلها تأمينه % % وهمى عليهم بالندى تأميله % % 48(@)(@@) % أخليفة الله الذي آراؤه % % شهب تنير دجى الهوى وتحيله % % 49 
ms124	(@)(@@) % خذها إليك عقيلة الشعر الذي % % تبدي له سمة الخضوع فحوله % % 50(@)(@@) % درا تكون في بحار بلاغة % % يهدى إليك ثمينه وجليله % % PageV01P519 51(@)(@@) % وصل الدوام إذا نبت بيض الظبا % % تمضي وإن عثر الزمان تقيله % % 52(@)(@@) % فالملك أنت عماده وعتاده % % والدين أنت ملاذه ومقيله % % PageV01P520 البحر : - 1(@)(@@) % سرى والدجى قد آن منه رحيل % % نسيم يتيح البرء وهو عليل % % 2(@)(@@) % وأدار على الأغصان راح ارتياحه % % فغادر أعطاف الغصون تميل % % 3(@)(@@) % وما كنت أعتاد الصبا قبل خمرة % % ولا قلت في الريح الشمال شمول % % 4(@)(@@) % وأهدى إلى الآناف من نفحاته % % لطائم فيها أذخر وجليل % % 5(@)(@@) % رسائل شكري خط أحرفها الجوى % % ومضى على شط الفراق نزيل % % 6(@)(@@) % أجد ادكار العهد والعهد شاسع % % وحل عرى الأجفان فهي همول % % 7(@)(@@) % وهاج ضراما للتشوق ما خبا % % فيا لبليل ثار عنه غليل % % 8(@)(@@) % وقفنا بربع المالكية بعد ما % % تنسم بين قومه ورحيل % % 9(@)(@@) % رسوم جسوم في رسوم تشابها % % كلانا على حكم البعاد نحيل % % 10(@)(@@) % نكلف رسم الدار رجع جوابنا % % وذلك شيء ما إليه سبيل % % PageV01P521 11(@)(@@) % فيا من رآنا والركاب مناخة % % طلول تبكي عهدهن طلول % % 12(@)(@@) % رعى الله قلبي ما أتم وفاءه % % إذا نزحت دار وبان خليل % % 13(@)(@@) % مقيم على رعي العهود على النوى % % كفى القلب ذما أن يقال ملول % % 14(@)(@@) % خليلي من سلمان بالله ساعدا % % فما الخل إلا مسعد ومقيل % % 15(@)(@@) % ولا تجريا ذكر الفراق فإنه % % حديث على سمع الغداة ثقيل % % 16(@)(@@) % ولا تسألا أن يهمي الغيث بالحمى % % فمن مقلتي غيث أجس همول % % 17(@)(@@) % ألا فابليا فود الفلا بنجائب % % لها خبب لا ينقضي وذميل % % 18(@)(@@) % قلاص براها السير حتى كأنها % % خواطر في فكر الفلاة تجول % % 19(@)(@@) % وراض اعتساف البيد حد شماسها % % فأصبح منها الصعب وهو كلول % % 20(@)(@@) % يلومونني في الحب قومي جهالة % % وما كان طبعا فهول ليس يحول % % PageV01P522 21(@)(@@) % وما زلت مذعق الشباب تمائمي % % أدير قداحي في الهوى وأجيل % % 22(@)(@@) % إذا بارق للثغر يوما أهاب بي % % ركبت إليه الخطب وهو جليل % % 23(@)(@@) % ولجت على الغيران بيت قبابه % % وجئت عرين الليث وهو يهول 
ms125	 % % 24(@)(@@) % ولي وطأة فوق الزمان ثقيلة % % يطأطىء هديها لها ويميل % % 25(@)(@@) % أجر رداء العيش والعيش أخضر % % وأخشى رماح اللحظ وهو كحيل % % 26(@)(@@) % وكم ساعة شافهت في موقف النوى % % تقبح وجه الصبر وهو جميل % % 27(@)(@@) % غضضت على التوديع جفني عندها % % وفي القلب داء للفراق دخيل % % 28(@)(@@) % وكم ليلة مزقت جيب ظلامها % % وقد سحبت منها علي ذيول % % 29(@)(@@) % إلى أن تبدى الشيب في مفرق الدجى % % وفجر نهر الفجر فهو يسيل % % 30(@)(@@) % ويوما دعوت الوحش تحت هجيره % % وللأسد في ظل القتاد مقيل % % PageV01P523 31(@)(@@) % إذا زأرت عن جانبي أجابها % % رغاء يباري زأرها وصهيل % % 32(@)(@@) % إلى أن تلقى مغرب الشمس قرصها % % كما التهم القرص الرهيف أكول % % 33(@)(@@) % ولا صاحب إلا سنان وصارم % % وعزم بتيسير السبيل كفيل % % 34(@)(@@) % ووجناء تجني القرب من شجر السرى % % قلوص نماها شدقم وجديل % % 35(@)(@@) % وعاذلة في الجود قلت لها اقصري % % رويدك هل نال العلاء بخيل % % 36(@)(@@) % إذا المرء لم يشر الثناء بما اقتنى % % فكل كثير يقتنيه قليل % % 37(@)(@@) % ولي همة من دونها كل شارق % % يرجع عنها الطرف وهو كليل % % 38(@)(@@) % تقلدني دهري حساما مهندا % % له في رقاب الدار عين صليل % % 39(@)(@@) % وما زال يلقاني في الحوادث ضاربا % % فعندي لإحداث الزمان فلول % % 40(@)(@@) % تغني بأشعاري الحداة إذا سرت % % وشدت لها في الخافقين حمول % % PageV01P524 41(@)(@@) % أبت غير محض العز نفسي فليس لي % % بساحة ضيم ما حييت نزول % % 42(@)(@@) % وكيف بالمام المذلة لامرىء % % ومن يمن رهط له وقبيل % % 43(@)(@@) % إذا العرب العرباء نصت قديمها % % ورجع قال عند ذاك وقيل % % 44(@)(@@) % كفانا افتخارا وانتصارا ونسبة % % تتابعة من يعرب وقيول % % 45(@)(@@) % ذؤابة سلمان وسلمان كندة % % وكندة ظل ما أردت ظليل % % 46(@)(@@) % ستدري عداتي أي ليث حفيظة % % أثرن وأيام الزمان تدول % % 47(@)(@@) % إذا أصبحت خيلي البيوت مغيرة % % وفي كل شعب مقنب ورعيل % % 48(@)(@@) % عذيري من قوم تجيش صدورهم % % لهم عن طريق العدل في عدول % % 49(@)(@@) % إذا قلت غضوا أو إذا لجت أطرقوا % % وإن غبت منهم قائل وفحول % % 50(@)(@@) % عموا عن سنا فضلي فضلوا عن الهدى % % هوى النفس 
ms126	 قدما للرجال قتول % % PageV01P525 51(@)(@@) % ومن حسد الشمس المنيرة نورها % % ورفعتها في الجو فهو جهول % % 52(@)(@@) % أبا قاسم خذها إليك كأنها % % حسام يروع الناقدين صقيل % % 53(@)(@@) % أتت كأنابيب القناة بيوتها % % لها من قوافيها الحسان نصول % % 54(@)(@@) % إذا شردت عني القوافي نوازعا % % فليس لها إلا لديك حلول % % 55(@)(@@) % وإن هطلت سحب البيان حوافلا % % فليس لها إلا عليك همول % % 56(@)(@@) % وأنت عمادي واعتدادي ومفزعي % % وذخر أماني والحديث يطول % % 57(@)(@@) % وأنت حسامي كلما جل حادث % % أذود به عن حوزتي وأصول % % 58(@)(@@) % تحامت حماك النائبات وأصبحت % % سعودك زهرا ما لهن أفول % % PageV01P526 البحر : - 1(@)(@@) % كتبت بدمع عيني صفح خدي % % وقد منع الكرى هجر الخليل % % 2(@)(@@) % وراب الحاضرين فقلت هذا % % كتاب العين ينسب للخليل % % PageV01P527 البحر : - 1(@)(@@) % لقد رام كتم الوجد يوم ارتحاله % % ولكن دمع العين باح بحاله % % 2(@)(@@) % فجاد ولم يملك بوادر عبرة % % حداها مع الأظعان حادي جماله % % 3(@)(@@) % أخو زفرة لا يستقيم كأنها % % يجول فراس البكر حول ذباله % % 4(@)(@@) % إذا حن لاقى دمعه بيمينه % % وإن أن حاذى قلبه بشماله % % 5(@)(@@) % تذكرت عهدا أحلى من الكرى % % وأقصر من المام طيف خياله % % 6(@)(@@) % فيا ليت شعري من أتاح لي الجوى % % وعذب بالي هل أمر بباله % % 7(@)(@@) % خليلي هبا فاجراها وغنيا % % عليها بكثبان الحمى ورماله % % 8(@)(@@) % وإن غالها حر الهجيرة فاذكرا % % غضارة واديه وبرد ظلاله % % 9(@)(@@) % وقولا لها ريا فأكتاف رية % % إمام نوانا فأبشري باحتلاله % % 10(@)(@@) % ستجنين غض العيش من مضض السرى % % إذا حط عنك الكور بين جلاله % % PageV01P528 11(@)(@@) % وتأتي أمير المسلمين خوامسا % % فتكرع من بعد النوى في نواله % % 12(@)(@@) % خليفة صدق لم يجد بشبهه % % زمان ولم تأت الدنيا بمثاله % % 13(@)(@@) % يرف إلى العافين لألاه بشره % % كما رف متن العضب عند صقاله % % 14(@)(@@) % إذا هم كان الدهر عبد مقامه % % وإن قال قال الحق عند مقاله % % 15(@)(@@) % مجير من استعداه قبل ندائه % % ومغني من استجداه قبل سؤاله % % 16(@)(@@) % مثير رياح في حومة الوغى % % ومختطف الأبطال يوم نزاله % % 17(@)(@@) % وموقد نار العدل في علم الهدى % % ومطفىء نار البغي بعد اشتعاله % % 18 
ms127	(@)(@@) % ومطلع شمس البشر في سحب الندى % % وباني معاليه وهادم ماله % % 19(@)(@@) % والله من مجد رفيع عماده % % تبيت النجوم الزهر دون مناله % % 20(@)(@@) % وأقسم ما روض الربا عقب الحيا % % بأعطر عرفا من ثناء خلاله % % PageV01P529 21(@)(@@) % أيوسف دم للدين تحمي ذماره % % وتجني الأماني تحت ظل جلاله % % 22(@)(@@) % وللجود تهمي ساجما من سحابه % % وللباس تذكي جاحما من مصاله % % 23(@)(@@) % حثثت ركاب العزم في خير وجهة % % أتيح بها الإسلام برد اعتلاله % % 24(@)(@@) % نشرت لواء الدين حين طويتها % % مراحل غزو منك في نصر آله % % 25(@)(@@) % إذا جئت قصرا أو حللت بمربع % % ثوى الأمن والتمهيد بين حلاله % % 26(@)(@@) % وصاب غمام الجود فوق بطاحه % % وأشرق نور الهدي فوق جباله % % 27(@)(@@) % كأنك بدر والبلاد منازل % % إذا جبت أفقا راق نور جماله % % 28(@)(@@) % وإن فقته بالحلم والعلم والندى % % وشاركته في نوره وانتقاله % % 29(@)(@@) % فكم بين محفوظ الكمال من الردى % % ومتصف بالنقص بعد كماله % % 30(@)(@@) % ولما أرحت السير في قصورية % % بعزم تضيق الأرض دون مجاله % % PageV01P530 31(@)(@@) % رأى منك بحر الماء بحرا من الندى % % فواصل منه الموج لثم نعاله % % 32(@)(@@) % زجرت بها الأسطول يبتدر العدا % % ويمضي إلى ما اعتداه من فعاله % % 33(@)(@@) % بكل خفيف دافق ومطاوع % % مثار صباه أو مهب شماله % % 34(@)(@@) % فلله عينا من رآها صوافنا % % أفاض عليها القار سحم جلاله % % 35(@)(@@) % إذا سعا عدتها هبة الريح أسرعت % % كما أنساب أيم الروض غب انسلاله % % 36(@)(@@) % وغربان أثباج زجرت سنيحها % % ويظهر نجح الأمر في حسن فاله % % 37(@)(@@) % سحاب إذا تهفو بروق صفاحه % % همى عرض هجم بودق نباله % % 38(@)(@@) % وغيل ليوث غابه من سلاحه % % وآساده يوم الوغى من رجاله % % 39(@)(@@) % وروض سقاه النصر صوب غمامه % % ودارت عليه مفعمات انسجاله % % 40(@)(@@) % فأغصانه ملتفة من رماحه % % وأوراقه مخضرة من نصاله % % PageV01P531 41(@)(@@) % جوار غذاها الغزو در لبانه % % وحجبها الإسلام تحت حجاله % % 42(@)(@@) % هواف إلى جرف العدو وإنما % % وثقن بنصر الله يوم قتاله % % 43(@)(@@) % لملكك عقبى النصر فارقب طلوعها % % فقد آن للإسلام آن اقتباله % % 44(@)(@@) % هو الله يملي للعدا ويد الهدى % % ببرهانها تجلو ظلام محاله % % 45 
ms128	(@)(@@) % وهل يستوي مستبصر في يقينه % % ومستبصر في غيه وضلاله % % 46(@)(@@) % هنيئا لك العيد السعيد فإنه % % أتاك ببشرى الفتح قبل اتصاله % % 47(@)(@@) % طوى البعد عن شوق وحث ركابه % % وأوشك في منغاك حط رحاله % % 48(@)(@@) % فمن استجار علاك عز جواره % % وعزيز قوم لم يطعك ذليل % % 49(@)(@@) % وإذا توخيت السياسة في الورى % % يوما فما للعدل عنك عدول % % 50(@)(@@) % وإذا جنبت المغريات إلى العدا % % سيان عندك فرسخ أو ميل % % PageV01P532 51(@)(@@) % ولو استعنت الدهر واستنجدته % % لبدت لأمرك طاعة وقبول % % 52(@)(@@) % وأتى ومن قطع الظلام كواكب % % ومن الصباح أسنة ونصول % % 53(@)(@@) % إن رمت في الله الجهاد وطالما % % أرضى الإله جهادك المقبول % % 54(@)(@@) % وأنفت للدين الحنيف وأهله % % من أن يطيح نجيعه المطلول % % 55(@)(@@) % وقدحت زند عزيمة نصرية % % تركت ديار الكفر وهي طلول % % 56(@)(@@) % وسلكت للتقوى سبيلا سنها % % علم الملوك أبوك إسماعيل % % 57(@)(@@) % ورجعت والنصر العزيز مصاحب % % لك والملائكة الكرام قبيل % % 58(@)(@@) % في عسكر لجب كأن جموعه % % فوق الوهاد إذا زحفن سيول % % 59(@)(@@) % كالبحر إلا أنهن كتائب % % والريح إلا أنهن خيول % % 60(@)(@@) % والبرق إلا أنهن أسنة % % والرعد إلا أنهن طبول % % PageV01P533 61(@)(@@) % فبكل نجد راية منشورة % % وبكل غور مقنب ورعيل % % 62(@)(@@) % كان افتتاح بني بشير مبدأ % % سبب البشارة بعده موصول % % 63(@)(@@) % سرت بموقعه النفوس وإنه % % نبأ على سمع العدو ثقيل % % 64(@)(@@) % ثم ارتقيت ثنية الثغر التي % % هي للضلال معرس ومقيل % % 65(@)(@@) % ورميتها بعزيمة نصرية % % كادت لها شم الهضاب تزول % % 66(@)(@@) % خود تجلت في منصة شاهق % % مختالة إكليلها الإكليل % % 67(@)(@@) % ومصام عز للنجوم مزاحم % % ما لاستباحة ما حواه سبيل % % 68(@)(@@) % سامي الذرا متمتع أركانه % % يرتد عنه الطرف وهو كليل % % 69(@)(@@) % أصميت ثغرتها بسهم عزيمة % % تذر الأبي الصعب وهو ذليل % % 70(@)(@@) % دارت بأعلى منذريها قهوة % % للحتف مترعة الكؤوس شمول % % PageV01P534 71(@)(@@) % ثم انثنيت وبالرماح تقصد % % مما غزوت وللسيوف فلول % % 72(@)(@@) % وتركت سحب النقع في آفاقها % % تسمو وأنهار السيوف تسيل % % 73(@)(@@) % لا يغررن الروم في أملائها % % قدر فأيام الحروب تدول % % 74(@)(@@) % والعزم وار في الحفيظة زنده % % والرأي مشحوذ الغرار صقيل % % 75(@)(@@) % ولو أنهم 
ms129	 ملأوا البسيطة كثرة % % إن الكثير مع الضلال قليل % % 76(@)(@@) % وإذ امرؤ جعل الصليب نصيره % % دون الإله فإنه مخذول % % 77(@)(@@) % من مثل يوسف في الملوك إذا غدت % % تزهى بفضل قديمها وتصول % % 78(@)(@@) % طلق المحيا والخطوب عوابس % % هامي الأنامل والغمام بخيل % % 79(@)(@@) % بدر ولا غير الكتيبة هالة % % ليث ولا غير الأسنة غيل % % 80(@)(@@) % من أسرة سعدية نصرية % % أثنى عليها الله والتنزيل % % PageV01P535 81(@)(@@) % لله من فتح جليل قدره % % ينميه جد في الملوك جليل % % 82(@)(@@) % دين على الزمان ابتدرت قضاءه % % سهل المرام وإنه لبخيل % % 83(@)(@@) % لبست بك الأيام زخرف حسنها % % وزها على الأجيال هذا الجيل % % 84(@)(@@) % فاهنا بموصول الفتوح فإنما % % هي سنة ما إن لها تبديل % % PageV01P536 البحر : - 1(@)(@@) % أبا مالك أنت نجل الملوك % % غيوث الندى وليوث النزال % % 2(@)(@@) % ومثلك يرتاح للمكرمات % % ومالك بين الورى من مثال % % 3(@)(@@) % عزيز بأنفسنا أن نرى % % ركابك مؤذنة بارتحال % % 4(@)(@@) % وقد شاهدت منك خلقا جميلا % % أناف على درجات الكمال % % 5(@)(@@) % وفازت لديك بساعة أنس % % كما زار في النوم طيف خيال % % 6(@)(@@) % فلولا تعللنا أننا % % نزورك فوق بساط الجلال % % 7(@)(@@) % ونبلغ فيك الذي نرتجي % % وذاك على الله سهل المنال % % 8(@)(@@) % لما فترت أنفس من جوى % % ولا برحت أدمع في انهمال % % 9(@)(@@) % تلقتك حيث احتللت السعود % % وكان لك الله في كل حال % % PageV01P537 البحر : - 1(@)(@@) % أفي فترة السلوان جاء رسلوها % % وقد أسعف النفس الأبية سولها % % 2(@)(@@) % نبذت الهوى نبذ الجفون قذاتها % % فأتعب من يشقى بنفس جهولها % % 3(@)(@@) % وحذرتها عقبى الخليل فإنها % % يعود بإخلال عليها خليلها % % 4(@)(@@) % تمالأت بالدنيا وبالناس خبرة % % فأحقر شيء في عياني جليلها % % 5(@)(@@) % فلو أن رضوى حملت بعض همتي % % لطأطأ من أكتاد رضوى ثقيلها % % 6(@)(@@) % إذا عقدت كف الفتى بنواله % % فشر عتادي التي لا أنيلها % % 7(@)(@@) % وإني لأبدي للصديق تغاضيا % % يغض على زلاته ويقيلها % % 8(@)(@@) % وما ضرني أني ثويت بمغرب % % إذا طلعت أنوار علمي يحيلها % % 9(@)(@@) % فكم طحلب مخف من الماء صفحة % % يشف عن الشيء الخفي صقيلها % % 10(@)(@@) % يترجم عن عذب الشراب مذاقه % % ويعرب عن عتق الجياد صهيلها % % PageV01P538 البحر 
ms130	 : - 1(@)(@@) % وافي بعطفتك البشير فلو غدت % % روحي جزاء وروده لم أعدل % % 2(@)(@@) % فكأن دهري لم يزل لي مسعفا % % وكأن حالي بعد لم يتبدل % % 3(@)(@@) % أنهضتني لما قعدت وقمت في % % نصري ومالي من نصير أول % % 4(@)(@@) % وأجرتني إذ جار دهري واعتدى % % ورمى بسهم منه أصمى مقتل % % 5(@)(@@) % أنحى على الأب والشقيق فغيبا % % عني فحالي بعدهم لا تسأل % % 6(@)(@@) % وأشد ما لقيت فيما نالني % % أن كنت يوما عن رضاك بمعزل % % 7(@)(@@) % يا ملبسي النعمى بأي عبارة % % أصل الثناء لملكك المتفضل % % 8(@)(@@) % يا مبقيا رمقي بفضل حنانه % % يا مفزعي يا ملجأي يا موئل % % 9(@)(@@) % دم في زمام الله حزبك غالب % % وحماك محروس وملكك معتل % % PageV01P539 البحر : - 1(@)(@@) % أبشر فقد نلت ما ترجو على عجل % % ويسر الله ما تبغيه من أمل % % 2(@)(@@) % وساعدتك الدنيا فيما تؤمله % % فاهنأ بسعد على الأيام متصل % % 3(@)(@@) % واحكم على الدهر وافعل ما تشاء به % % فالدهر طوعك والأيام كالخول % % 4(@)(@@) % فما ذعرت ببدر غير مبتدر % % ولا أمرت بأمر غير ممتثل % % 5(@)(@@) % ما لذة العيش إلا في علا وطلا % % ووصل حب بلا صد ولا ملل % % 6(@)(@@) % خذها كمثل شعاع الشمس صافية % % حمراء لا تستمع فيها إلى عذل % % 7(@)(@@) % من كف ساحرة الألحاظ فاتنة % % حسناء تختال بين الحلي والحلل % % 8(@)(@@) % إذا رنت أو ثنت أعطافها مرحا % % فالظبي في نظر والغصن في ميل % % 9(@)(@@) % وأنضر الروض أضحى وهو مصطبح % % والغصن قد مال ميل الشارب الثمل % % 10(@)(@@) % حتى إذا الشمس مالت نحو مغربها % % كأنها عاشق يبكي على طلل % % PageV01P540 11(@)(@@) % وحجب الليل عنا حسن منظره % % بستر جنح من الظلماء منسدل % % 12(@)(@@) % لاحت إلينا شموس الحسن ساطعة % % ولا سماء سوى الإستار والكلل % % 13(@)(@@) % وفي الوجوه لنا روض أزاهرة % % من وردة الخد أو من نرجس المقل % % 14(@)(@@) % وخير ما ظفرت كف المحب به % % خمر من الريق أو نقل من القبل % % 15(@)(@@) % فاستغم الأنس يوما إن ظفرت به % % في دولة أصبحت من أسعد الدول % % 16(@)(@@) % أيام يوسف أعياد مجددة % % ولى عن الخلق فيها الهم يوم ول % % 17(@)(@@) % وأصبحت كالربيع 
ms131	 الطلق ضاحكة % % إذ حل فيها حلول الشمس في الحمل % % 18(@)(@@) % فسار بالعدل في ورد وفي صدر % % وراقب الله في قول وفي عمل % % 19(@)(@@) % أنواره في سماء العدل نيرة % % تبدو وآثاره أسرى من المثل % % 20(@)(@@) % لازال في عزة تصفو مواردها % % مبلغا كل ما يرجوه من أمل % % PageV01P541 البحر : - 1(@)(@@) % سلوا عن فؤادي بعدكم كيف حاله % % وقد قوضت عند الصباح رحاله % % 2(@)(@@) % ولا تحسبوا أني سلوت على النوى % % فسلوان قلبي في هواكم محاله % % 3(@)(@@) % وما حال من شطت بغرب دياره % % وفي الشرق أهلوه وثم حلاله % % 4(@)(@@) % ولكنني وطنت نفسي وإنها % % سجية من طابت وجلت خلاله % % 5(@)(@@) % وعللت نفسي باللقاء فإنني % % لآمل لطف الله جل جلاله % % 6(@)(@@) % وما الحر إلا من يعاني ضرورة % % فيبدو عليها صبره واحتماله % % 7(@)(@@) % سجية آباء كرام ورثتها % % بحق ويبني المجد للمرء آله % % 8(@)(@@) % توارثت عز الملك عن كل ماجد % % سما في المعالي باسه ونواله % % 9(@)(@@) % صهيل الجياد الصافنات غناؤه % % وتحت البنود الخافقات ظلاله % % 10(@)(@@) % سل الدهر عن أبناء نصر وإن ضنا % % فسل عنهم الدين الذي هم رجاله % % PageV01P542 11(@)(@@) % عسى جبل الفتح الذي بجنابه % % حللت بقرب الفتح يصدق فاله % % 12(@)(@@) % نسائل أنفاس النسيم إذا سرى % % عسى خبر عنكم تؤدي شماله % % 13(@)(@@) % ونرجو مزار الطيف في سنة الكرى % % ومن لي بنوم فيه يسري خياله % % 14(@)(@@) % بنفسي غزال قد غزتني لحاظه % % وتيم قلبي حسنه وجماله % % 15(@)(@@) % هو البدر والجوزاء قرط معسجد % % وجنح الليالي فرعه ودلاله % % 16(@)(@@) % تقربه الأوهام مني وإن نأت % % منازله عني وعز مناله % % 17(@)(@@) % وأسأل عن أخباره كل وارد % % فيا ليت شعري كيف عني سؤاله % % 18(@)(@@) % ألا في سبيل الله قلب مقلب % % على البعد لا يخلو من الوجد باله % % 19(@)(@@) % وبالجانب الشرقي سرب من الدما % % بغير الكرى ما إن يصاد غزاله % % 20(@)(@@) % تقنصت منه ظبية الأنس فانثنت % % رهينة حب وثقتها حباله % % PageV01P543 21(@)(@@) % أفاتكة اللحظ الذي بجوانحي % % على غرة منها استقرت نباله % % 22(@)(@@) % يطيع الورى ملكي امتثالا لأمره % % وأمرك مكتوب علي امتثاله % % 23(@)(@@) % لئن غبت عن عيني فشخصك حاضر % % يلازم فكري 
ms132	 شكله ومثاله % % 24(@)(@@) % وإن نقلت عنك الليالي ركائبي % % فؤادي فشيء ليس يخفى انتقاله % % 25(@)(@@) % إذا ما جدت ريح الزفير مدامعي % % تسح فتروى من دموعي رماله % % 26(@)(@@) % وتالله ما اعتل النسيم وإنما % % تعلم من شجوي فبان اعتلاله % % 27(@)(@@) % تذكرت ليلا بالحبيب قطعته % % وشملي على كل الأماني اشتماله % % 28(@)(@@) % تحير فيه الفجر أين طريقه % % وفوق ذراعي بدره وهلاله % % 29(@)(@@) % وعاطيته من خمره ورضابه % % شرابا به منه عليه انتقاله % % 30(@)(@@) % وعانقت منه الغصن مالت يد الصبا % % به فسباني لينه واعتداله % % PageV01P544 31(@)(@@) % ترى هل يعود الشمل كيف عهدته % % ويبلغ قلبي ما اشتهى ويناله % % 32(@)(@@) % سقى الله من غرناطة متبوئا % % غماما يروي ساحتيها سجاله % % 33(@)(@@) % وربعا بحمراء المدينة آهلا % % أنيطت على بدر السماء حجاله % % 34(@)(@@) % وغابا به للملك أشبال ضيغم % % يروع الأعادي باسه وسباله % % 35(@)(@@) % لقد هاجني شوق إليها مبرح % % إذا شمت برق الشرق شب ذباله % % 36(@)(@@) % فكم لي على الوادي بها من عشية % % يقل لها ذكر الفتى ومقاله % % 37(@)(@@) % عسى الله يدني ساعة الفرج التي % % بها يتسرى عن فؤادي خباله % % 38(@)(@@) % صرفت إلى الله الوفاء ضراعة % % وما خاب يوما من عليه اتكاله % % PageV01P545 البحر : - 1(@)(@@) % إذا أنا لم أوثر هواي على عزمي % % فنفسي في طوعي وأمري في حكم % % 2(@)(@@) % وإن أنا أرجأت الأمور إلى غد % % طعنت بغرب الفخر في ثغرة الحزم % % 3(@)(@@) % وإن أحق الناس باللوم لامرؤ % % يضل طريق الرشد وهو على علم % % 4(@)(@@) % كتمت اشتياقي والنحول ينم بي % % كأني أحلت الكتم مني على جسم % % 5(@)(@@) % وقلت لجفني إن دعيت لعبرة % % فساعد بها مطل الغني من الظلم % % 6(@)(@@) % ولم لا وقد حل الركاب بيثرب % % وبؤت بشحط الدار منها على رغم % % 7(@)(@@) % تدامر أقوام إليها وضمروا % % مخيسة تهوي بأجنحة العزم % % 8(@)(@@) % وقام خضم الماء دون مرامهم % % فلم يحفلوا منه بصول ولا لطم % % 9(@)(@@) % إذا النفس أبدت فيه صنا بجسمه % % تقول لها الأشواق ألقه في أليم % % 10(@)(@@) % فما كان إلا أن أتوا معهد الهوى % % وشيكا كما أغفيت في سنة الحلم % % PageV01P546 11(@)(@@) % وفازوا بما حازوا كراما فإنما % % زيارة 
ms133	 خير الخلق من أعظم الغنم % % 12(@)(@@) % كأني بقومي حين حلوا حلالها % % وأعينهم إذ ذاك أجفانهم تهم % % 13(@)(@@) % يكبون للأذقان في عرصاتها % % سلاما وتقبيلا على ذلك الرسم % % 14(@)(@@) % فيعفى عن الأوزار في ذلك الحمى % % وتغتفر الأثام في ذلك اللثم % % 15(@)(@@) % فلله در القوم فيها وقد غدوا % % ضيوفا بمثوى سيد العرب والعجم % % 16(@)(@@) % أقام لهم حيا أمانا من الردى % % وقام مقام الغيث في شدة الأزم % % 17(@)(@@) % وحلوا به ميتا فكان قراهم % % خفاوة ذي روح ومأمن ذي جرم % % 18(@)(@@) % رسول أتى حكم الكتاب بمدحه % % وأثنى عليه الله بالصدق والحلم % % 19(@)(@@) % أحب من المحيا وأجدى من الحيا % % وأهدى لمن ضل السبيل من النجم % % 20(@)(@@) % قريع صميم المجد في آل هاشم % % أولي القسمات الغر والأنف الشم % % PageV01P547 21(@)(@@) % أتى رحمة والناس في مدلهمة % % يروحون في غي ويغدون في إثم % % 22(@)(@@) % فصدق من قادته سابقه الهدى % % وساعده الأسعاد في سالف الحكم % % 23(@)(@@) % وصد عن الآيات من سبقت له % % شقاوته في سابق القدر الحتم % % 24(@)(@@) % وأعجز من أعمى الضلال يقينه % % عمى قد تحدى من معاقره العقم % % 25(@)(@@) % فروى لهام الجيش منه بأنمل % % جرى الماء في أثنائها سائغ الطعم % % 26(@)(@@) % ولما دعا بالبدر شق لحينه % % وأقبل منه الشق يهوي إلى الكم % % 27(@)(@@) % وكلمه ضب الفبلاة مخاطبا % % ومستفهما في القول تكليم ذي فهم % % 28(@)(@@) % وخاطبه الصخر الجماد محدثا % % وحذره ما في الذراع من السم % % 29(@)(@@) % وفي الختم منه للنبيئين آية % % رأينا بها معنى البداية في الختم % % 30(@)(@@) % سرى نوره في أوجه نبوية % % مقدسة ينميه أكرم من ينم % % PageV01P548 31(@)(@@) % ولم تشك ثقل الحمل آمنة الرضا % % ولا دهيت منه بكرب ولا غم % % 32(@)(@@) % وفي ليلة الميلاد منه بدت لها % % شواهد لم تخطر لنفس ولا على وهم % % 33(@)(@@) % وبشرها الأملاك أن وليدها % % إمام النبيئين الكرام أولي العزم % % 34(@)(@@) % إلى أن فرى الليل عن نور وجهه % % كما شف سحب عن سنا قمر تم % % 35(@)(@@) % فخرت له الأصنام صرعى وزلزلت % % بمكتها أجرام أجبالها الشم % % 36(@)(@@) % فرام استراق السمع رائد غائب % % من الجن فانقضت له شهب 
ms134	 الرجم % % 37(@)(@@) % وإيوان كسرى أسرعت شرفاته % % وقد عاينت ما عاينته إلى الهدم % % 38(@)(@@) % وأخبر شق أن في الأرض عندها % % طلوع نبي طاهر الأب والأم % % 39(@)(@@) % رسول من الرحمن يدعو إلى الهدى % % ويدعو إلى دار السلامة والسلم % % 40(@)(@@) % فلله منها ليلة بركاتها % % سحائبها تنهل بالنعم العم % % PageV01P549 41(@)(@@) % أشاد أمير المسلمين بذكرها % % فأحيا سبيلا دارسا لأولي العلم % % 42(@)(@@) % وآثر تقوى الله منها فلم يكن % % بمشتغل عنها بزور ولا فم % % 43(@)(@@) % تقي حذا حذو الخلائف واقتدى % % بهم مثل ما خط الكتاب على الرسم % % 44(@)(@@) % إذا هم أمضى عزمه وإذا سطا % % فلا عدة تغني ولا عدة تحم % % 45(@)(@@) % وإن جد يوما لم يبت دون غاية % % وإن جاد ما ذو العطر يوما بمهتم % % 46(@)(@@) % وإن طلب الصعب الممنع ناله % % بمدركة الأقصى ومنزلة العصم % % 47(@)(@@) % إذا ما دجى روع فغرة يوسف % % تضيء بها الآفاق في الجادة الجهم % % 48(@)(@@) % وإن زمن يوما عرته زمانة % % فراحته برء الزمان من السقم % % 49(@)(@@) % فيا ناصر الإسلام دم في حلى العلا % % وجارك في أمن وقطرك في سلم % % 50(@)(@@) % ولا برحت آثارك الغر تكتسي % % بدائع مما صاغ في وصفها نظم % % PageV01P550 51(@)(@@) % وإني بنعماك التي ملأت يدي % % فأصبحت من إحسانها وافر القسم % % 52(@)(@@) % لأخلق من جفني المسهد بالكرى % % وأليق بالسر المصون من الكتم % % PageV01P551 البحر : - 1(@)(@@) % بشرى تقوم لها الدنيا على قدم % % حيا بها الله حي النصر في القدم % % 2(@)(@@) % وأصبح الدين جذلانا بموقعها % % يثني بكل لسان ناطق وفم % % 3(@)(@@) % واستبشرت دولة الإسلام حين رأت % % سيفا من العرب مسلولا على العجم % % 4(@)(@@) % خلافة الله يهنيك الدوام فما % % تخشى نفادا وقد قال الإله دم % % 5(@)(@@) % ويا بشير بنعمى جل موقعها % % لك البشارة مما شئت فاحتكم % % 6(@)(@@) % ويا أمير الهدى هنيتها نعما % % موصولة العد قد جلت عن النعم % % 7(@)(@@) % أجدى من الغيث بعد الجدب في بلد % % أو الشبيبة بعد الشيب والهرم % % 8(@)(@@) % شهاب هدي تجلى في سماء علا % % وفرع ملك نما في دوحة الكرم % % 9(@)(@@) % تاهت به الجرد واهتزت به طربا % % معاطف الشم والمصقولة الخدم % % 10 
ms135	(@)(@@) % وللتنافس في تقبيل راحته % % ظل التفاخر بين السيف والقلم % % PageV01P552 11(@)(@@) % فاعدد له الخيل تزهى في مرابطها % % شرس اللحاظ لها حقد على اللجم % % 12(@)(@@) % واذكر بمسمعه الأهدى وقائعه % % يلح لوجهك منه وجه مبتسم % % 13(@)(@@) % وكلما كملت فيه القوى وشدا % % فاجعل مجالسه في الحفل كل كم % % 14(@)(@@) % وليكثر القوم ذكرا في مجالسه % % من السياسة والأمثال والحكم % % 15(@)(@@) % حتى إذا كملت فيه الورى وسما % % خطلا وراع أسود الغاب في الأجم % % 16(@)(@@) % فاذعر به الكفر في أقصى مآمنه % % وحط به الدين من خلف ومن أمم % % 17(@)(@@) % لكي تلوح عليه في شمائله % % شمائل من أبيه الطاهر الشيم % % 18(@)(@@) % ومن كيوسف في الأملاك من ملك % % بالحلم متسم بالحزم محتزم % % 19(@)(@@) % تنمي علاك من الأنصار سادتها % % في مفخر ككعوب الرمح منتظم % % 20(@)(@@) % خلائف لم تزل بالهدي صادعة % % بالعدل في الظلم أو بالنور في الظلم % % PageV01P553 21(@)(@@) % السابقون إلى الغايات إن ارتضوا % % والناطقون بفصل الحكم في الكلم % % 22(@)(@@) % من كل أروع أن ضنت بوابلها % % سحب السماء وشحت شحة الديم % % 23(@)(@@) % قامت يداه مقام الغيث وانتجعت % % نداه زاجرة الوخادة الرسم % % 24(@)(@@) % وأصبح الحي بعد الجهد في دعة % % ريان من زفرات الخيل والنعم % % 25(@)(@@) % يا أيها الملك الندب الذي عصمت % % منه البلاد بدفاع من العصم % % 26(@)(@@) % هفا بها الروع وارتجت جوانبها % % وكان ساكنها لحما على وضم % % 27(@)(@@) % فأصبحت بك بعد الروع آمنة % % في ظل ملكك أمن الطير في الحرم % % 28(@)(@@) % فلو رآك زهير ما تخلفها % % غرا على مرر الأحقاب في هرم % % 29(@)(@@) % ولو تناسى الرضى الدهر ثم رأى % % أيام سلمك لم يحفل بذي سلم % % 30(@)(@@) % فاهنأ بغرة سعد طالع لمنى % % سعد بعز جديد غير منصرم % % PageV01P554 31(@)(@@) % بقيت في ظل ملك لا نفاد له % % والدهر طوعك والأيام كالخدم % % 32(@)(@@) % ودام نجلك لا تنفك تحرسه % % عين من الله لم تهجع ولم تنم % % 33(@)(@@) % حتى ترى الجيش يغزو تحت رايته % % مؤيد العزم منصورا على الأمم % % 34(@)(@@) % والرفد ما بين مرفض ومنكسب % % والوفد ما بين منفض ومنزحم % % 35(@)(@@) % مولاي لي ذمم في الملك سابقة % % وأنت 
ms136	 أكرم راع حرمة الذمم % % 36(@)(@@) % مالي لسان بما أوليت من منن % % ولا كفيء لما أسديت من نعم % % PageV01P555 البحر : - 1(@)(@@) % قلدت من نصر الإله حساما % % حاط العباد ومهد الأياما % % 2(@)(@@) % فإذا تنبه حادث نبهته % % وتركت أجفان الأنام نياما % % 3(@)(@@) % وذعرت أسد الغاب في أجماتها % % لما هززت من القنا آجاما % % 4(@)(@@) % فإذا هممت بلغت أقصى غاية % % وإذا رأيت الرأي كان لزاما % % 5(@)(@@) % وإذا الجزيرة نال منها واقع % % جلل وهاج بها العدو ضراما % % 6(@)(@@) % أصليتها نار السيوف فأصبحت % % بردا على كبد الهدى وسلاما % % 7(@)(@@) % وقدمت في يوم الهياج بفتية % % لم تدر إلا البطش والإقداما % % 8(@)(@@) % متسربلين هجيرها فإذا دجى % % قطعوا الدجنة سجدا وقياما % % 9(@)(@@) % فلباس بأسك راع أفئدة العدا % % ووجود جودك أعدم الإعداما % % 10(@)(@@) % عجبا لراحتك الملثة بالندى % % ألا تكون على الغمام غماما % % PageV01P556 11(@)(@@) % تهمي ووجهك نوره متألق % % وللمزن إن سحب السحاب أغاما % % 12(@)(@@) % نظم الشتات ليوم بيعتك التي % % كانت لجمع المسلمين نظاما % % 13(@)(@@) % فتواصلوا حتى كأن قلوبهم % % عقد التواصل بينها أرحاما % % 14(@)(@@) % لله يوسف من إمام هداية % % ملك غدا للمتقين إماما % % 15(@)(@@) % ساس البلاد وراض من دهمائها % % إبلا صعابا لا تطيع خطاما % % 16(@)(@@) % إن أمه العافون ينتجعونه % % يلقاهم متهللا بساما % % 17(@)(@@) % أو حاول الأداب مبتدعا لها % % راض العقول وروض الأفهاما % % 18(@)(@@) % أبدت محبتك الملوك فإن من % % والاك والى الله والإسلاما % % 19(@)(@@) % وأتت هداياها إليك فأكدت % % بين القلوب مودة وذماما % % 20(@)(@@) % جردا تلاعب في الحلي ظلالها % % عفر الأديم تخالها أراما % % PageV01P557 21(@)(@@) % صبرا على حرب الفيافي والسرى % % لا تسأم الإسراج والإلجاما % % 22(@)(@@) % صعب الركائب والحمول حديثها % % حتى تجاوز للعراق الشاما % % 23(@)(@@) % لله قومك والرماح شواجر % % والبيض تلتهم الصلى والهاما % % 24(@)(@@) % عرب صميم من ذؤابة يعرب % % تأبى الدنية أو تموت كراما % % 25(@)(@@) % دخروك للإسلام ندبا أروعا % % سحب الندى ضخيم الهموم هماما % % 26(@)(@@) % وبنوا لك المجد المؤثل والعلا % % ففرعت منها ذروة وسناما % % 27(@)(@@) % كم من جموع للعدو عظيمة % % قد غادروها بالفلاة عظاما % % 28(@)(@@) % وكتيبة جعلوا الصفاح صحائفا % % فيها وخطي القنا أقلاما % % 29(@)(@@) % فترى النجوم مناصلا وأسنة 
ms137	 % % والقطر نبلا والسماء قتاما % % 30(@)(@@) % والخيل لما ضاق رحب مجالها % % لم تستطع خلفا ولا قداما % % PageV01P558 31(@)(@@) % مالت فوائقها على أعرافها % % وهن سكرى ما عرفن مداما % % 32(@)(@@) % فتخالهم جزرا على صهواتها % % وتخالها من تحتهم أوضاما % % 33(@)(@@) % قولا لطاغية الفرنج وقد أبى % % إلا لجاجا قاد منه حماما % % 34(@)(@@) % قدك الأسل فهي التي عودتها % % من قبل سامت أنفك إلا رغاما % % 35(@)(@@) % الخيل جردا والرماح ذوابلا % % والبيض ذلقا والخميس لهاما % % 36(@)(@@) % نكث العهود وغره شيطانه % % ورأى الوفاء بما وفيت حراما % % 37(@)(@@) % وإذا تنكبت الوفاء سياسة % % فأضلت الآراء والأرحاما % % 38(@)(@@) % والغدر مرتعه وخيم وكلما % % لاذ امرؤ بحماه خاب وخاما % % 39(@)(@@) % قد أدهش الذعر المخيف قلوبهم % % ودهى العقول وزلزل الأقداما % % 40(@)(@@) % هموا وأفرط رعبهم فتوقفوا % % فعلام لا تنطى السيوف علاما % % PageV01P559 41(@)(@@) % أنت المؤمل لافتكاك بلادهم % % كم دليل من دون ذلك قاما % % 42(@)(@@) % لم لا وربك قد قضى لك بالعلا % % وبنصر ملكك أحكم الأحكاما % % 43(@)(@@) % فإذا زحفت بحزب ربك غالبا % % قادوا رعاعا نحوه وطغاما % % 44(@)(@@) % وإذا استعنت الله واستنجدته % % استنجدوا الصلبان والأصناما % % 45(@)(@@) % فافتح أعاليها المنيفات الذرى % % وانشر على شرفاتها الأعلاما % % 46(@)(@@) % واحسم بسيفك كل داء كامن % % فلذاك ما دعي الحسام حساما % % 47(@)(@@) % واهنأ بعيد عائد لك بالمنى % % وانعم بقاء في العلا ودواما % % 48(@)(@@) % وصل السعود بكل جد صاعد % % واستقبل الأعصار والأعواما % % 49(@)(@@) % ما دام ثغر الزهر تلمه الصبا % % فتحط عنه من الحكام لثاما % % PageV01P560 البحر : - 1(@)(@@) % أنا طاق تزهى بي الأيام % % تعبت في بدائعي الأفهام % % 2(@)(@@) % وتبديت للنواظر محرابا % % كأن الإناء في إمام % % 3(@)(@@) % واقف للصلاة حتى إذا ما % % جئت للشرب حان منه السلام % % PageV01P561 البحر : - 1(@)(@@) % فتحت سعودك كل باب مبهم % % وجلا يقينك كل خطب مظلم % % 2(@)(@@) % وجنيت غصن الفتح من ورق الظبا % % والنصر من غرس القنا المتحطم % % 3(@)(@@) % فانهل بسعدك قبل جندك للعدا % % وابعث برعبك قبل جيشك تهزم % % 4(@)(@@) % واحفظ بحزمك كل سرب غافل % % واكلأ بسهدك جفن كل مهوم % % 5(@)(@@) % فالحتف فوق غرار سيفك يلتظي % % والرزق بين بنان كفك ينهم % % 6(@)(@@) % يا عصمة الثغر الذي دارت 
ms138	 به % % أعداؤه دور السوار بمعصم % % 7(@)(@@) % يا قائد الخيل المغيرة بالضحى % % ومزير ربع الكفر كل مطهم % % 8(@)(@@) % من كل برق بالأهلة مسرج % % قيد الأوابد بالثريا ملجم % % 9(@)(@@) % من أخضر كالحبر أو من أشقر % % كالتبر أو من أحمر كالعندم % % 10(@)(@@) % أو أشهب إن لاح في غسق الدجى % % فكأنما هو غرة في أدهم % % PageV01P562 11(@)(@@) % قطعت سيوفك كل حكم قاطع % % وقضت سعودك قبل كل منجم % % 12(@)(@@) % وإذا الخطوب جهلت لحن خطابها % % كان الحسام الصلت خير مترجم % % 13(@)(@@) % كم فتكة لك في العدو مشهورة % % يزري حديث تليدها بالأقدم % % 14(@)(@@) % وكتيبة قرأت ظباك كتابها % % فعلمت منها كل ما لم يعلم % % 15(@)(@@) % ولك الجواري المنشآت سوابحا % % في اليم أمثال الصقور الحوم % % 16(@)(@@) % فتح القوادم للفنا قد أبرمت % % أمرا بها كف القضاء المبرم % % 17(@)(@@) % من كل منصاع كأن شراعه % % قطع السحاب سرت بنوء المرزم % % 18(@)(@@) % ساح البياض البحت تحت جناحه % % فتراه في شية الغراب الأعصم % % 19(@)(@@) % تلك الجواري المنشآت صداقها % % مهج العدا وخلوفهن من الدم % % 20(@)(@@) % وحجالهن من البنود فلا ترم % % وصلا بدينار لهن ودرهم % % PageV01P563 21(@)(@@) % نصرت عباد الله جل جلاله % % وسطت بعباد المسيح ومريم % % 22(@)(@@) % يممتها والماء موجود لها % % نحو العدو فكان خير تيمم % % 23(@)(@@) % حملت رجالا كالليوث مصاعبا % % صبرا على الفج المصاع المضرم % % 24(@)(@@) % قصدت بهم بحر الزقاق عزيمة % % قد جردت أسيافها لم تكهم % % 25(@)(@@) % حتى إذا طلعت وجوه سعودها % % بيضا على ذاك السواد الأعظم % % 26(@)(@@) % وكأن قوس الغيم بعض قسيها % % وذرى الذوائب بعض تلك الأسهم % % 27(@)(@@) % نادى لسان النصر يفصح ناطقا % % يا أسرة الدين الحنيف تحكم % % 28(@)(@@) % كم راية للفتح فوق رؤوسهم % % خفقت وكم ملك هناك مصوم % % 29(@)(@@) % فتركن أحزاب الصليب كأنما % % ثملوا بمحتوم الرحيق مفدم % % 30(@)(@@) % تقلي مفارقها المياه كأنما % % في البحر نائمة وليس بنوم % % PageV01P564 31(@)(@@) % صرعى على عفر الرمال وليمة % % للحوت أو للطير أو للضيغم % % 32(@)(@@) % ناديت والحفلاء غير عجيبة % % هذا الصنيع لمثل ذاك الموسم % % 33(@)(@@) % من كل منسحب السوابغ مضمر % % سم الأفاعي تحت جلد الأرقم % % 34(@)(@@) % وملفف في العصب أعرت متنه 
ms139	 % % وكسته حاشية الرداء المعلم % % 35(@)(@@) % أو بالسلاح سيستطع عن نفسه % % دفعا فمد لها يد المستسلم % % 36(@)(@@) % أقفرت ربع الكفر من سكانه % % بهلاكهم وعمرت ربع جهنم % % 37(@)(@@) % وسقيتهم كأس الردى ممزوجة % % سم الأساود في نقيع العلقم % % 38(@)(@@) % وقدحت فوق الماء نارا تلتظى % % وسفحت فوق البحر بحرا من دم % % 39(@)(@@) % فكأن صفح البحر مدت فوقه % % أيدي الرياح مطارفا من عندم % % 40(@)(@@) % بنيان كفر وطدت أساسه % % لولا دفاع الله لم يتهدم % % PageV01P565 41(@)(@@) % لله من يوم تعاظم قدره % % في كل يوم ذاهب متقدم % % 42(@)(@@) % نعش الجزيرة بعد شد وثاقها % % وأجار من حفت به من مسلم % % 43(@)(@@) % بكر الفتوح نضت لديك نقابها % % من بعد طول تقنع وتلثم % % 44(@)(@@) % سمر الركاب إذا تعاورها السرى % % من منجد في الأرض أو من متهم % % 45(@)(@@) % وغريبة الزمن التي آثارها % % متلوة بين الحطيم وزمزم % % 46(@)(@@) % فاهنأ به صنعا جميلا وارتقب % % من بعده إتيان صنع أعظم % % 47(@)(@@) % جمع الإله بيوسف شمل الورى % % وأثنى النوائب وهي فاغرة الفم % % 48(@)(@@) % ثبت الجنان إذا الخطوب تعاظمت % % متبسم في الحادث المتجهم % % 49(@)(@@) % يمضي رياح العزم غير مسوف % % ويلاحظ الآراء بعد تلوم % % 50(@)(@@) % فتراه يوم الحزم آخر مرتىء % % وتراه يوم العزم أول مقدم % % PageV01P566 51(@)(@@) % تنميه من أبناء سعد أسرة % % كرمت فنعم المنتمى والمنتم % % 52(@)(@@) % الطاعنون وما بها من طاعن % % والمطعمون وما بها من مطعم % % 53(@)(@@) % كلف بإدراك المعالي هائم % % صب بابكار المكارم مغرم % % 54(@)(@@) % فتراه بين عزيمة تفري الطلى % % يوما وعفو عن جريمة مجرم % % 55(@)(@@) % قسما بجودك وهو أي ألية % % وبعز ملكلك وهو اسمى مقسم % % 56(@)(@@) % ما ذكر أيام الشباب وقد مضى % % أو ما الغنى عند الفقير المعدم % % 57(@)(@@) % بأجل من نظري لوجهك ساعة % % عندي وأحلى من ثنائك في فم % % 58(@)(@@) % مولاي خذها غادة عربية % % تزهى بعقد من علاك منظم % % 59(@)(@@) % لما اعتزيت إلى ثنائك بان لي % % بالعقل كيف وجوب شكر المنعم % % 60(@)(@@) % لو قال في هرم زهير مثلها % % هرم الزمان وذكره لم يهرم % % PageV01P567 61(@)(@@) % أو مر عنترة عليها لم يقل % % هل غادر الشعراء من متردم 
ms140	 % % PageV01P568 البحر : - 1(@)(@@) % خليلي إذا ما جئتما دار طارق % % سقى الله ذاك الربع صوب غمامه % % 2(@)(@@) % فلا تغفلا أن تنهيا عن أخيكما % % هدية طيب من كريم سلامه % % 3(@)(@@) % إلى منزل للملك وللدين خيمت % % ركائب العلا والجود بين خيامه % % 4(@)(@@) % مضارب عز كالنجوم محيطة % % بأزهر مثل البدر عند تمامه % % 5(@)(@@) % وقولا أمير المسلمين تحية % % حباك بها عبد حليف غرامه % % 6(@)(@@) % ترحل عن مثواك طوع ضرورة % % وخلف قلبا راضيا بمقامه % % PageV01P569 البحر : - 1(@)(@@) % حيى ربوع الحي من نعمان % % جود الحيا وسواجم الأجفان % % 2(@)(@@) % دار عهدت بها الشبيبة دوحة % % طيب الحياة بيها جني دان % % 3(@)(@@) % أيام جفن الدهر عنا مطبق % % فيها وأجفان السعود روان % % 4(@)(@@) % بتنا نجر بها برود عفافنا % % قشب الجيوب صوافي الأردان % % 5(@)(@@) % في فتية يتحاورون بدائعا % % كلقيط در أو سقيط جمان % % 6(@)(@@) % وإذا ثنتهم أريحية مطرب % % قلت النعامى في غصون البان % % 7(@)(@@) % غاض الزمان بها تنعم عيشة % % فأحالها والدهر ذو الوان % % 8(@)(@@) % وسروا وقد أقعى الظلام وغممت % % نهر الثريا غابة السرطان % % 9(@)(@@) % فالسهد بعدهم أليف محاجر % % والوجد إثرهم حليف جنان % % 10(@)(@@) % حسبي من الأيام أني بعدهم % % لا أبتغي سببا إلى السلوان % % PageV01P570 11(@)(@@) % ولرب معتاد السفار رمت به % % أيدي الركاب نوازح البلدان % % 12(@)(@@) % ألف الترحل لا يقيم ببلدة % % إلا مقام العذل في الأذان % % 13(@)(@@) % عاطيته راحا من الأدب الذي % % مزجت سلافته بصرف بيان % % 14(@)(@@) % وهززت دوح بدائهي فتساقطت % % رطب المعاني تستفز الجان % % 15(@)(@@) % فأصاخ مستمعا وقال تعجبا % % إن الخمول نتيجة الأوطان % % 16(@)(@@) % ولأنت يا هذا ضياع مغفل % % بين الكساد ومرخص الأثمان % % 17(@)(@@) % هلا سلكت ذرى قلوصك ظاعنا % % لتحل إعظاما ذرى كيوان % % 18(@)(@@) % تصدى سيوف الهند في أجفانها % % والفخر إن بانت على الأجفان % % 19(@)(@@) % إن التواني جد مستودع الشقى % % وكذا الهوينى أم كل هوان % % 20(@)(@@) % فأجبته ليس التنقل مذهبي % % كلا ولاحت الركائب شان % % PageV01P571 21(@)(@@) % أي البلاد ألم أم أي الورى % % أبغي فأصرف نحو ذاك عنان % % 22(@)(@@) % وبباب مولانا المؤيد يوسف % % ما شئت من حسنى ومن إحسان % % 23(@)(@@) % النهر من مضربه والقطر من % % لدم وروض 