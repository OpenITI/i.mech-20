ms3545	 بن عبد الله.(@)(@@) التهذيب: ج 1، ح 1479.(@)(@@) وروى عنه علي بن الحسين.(@)(@@) التهذيب: ج 1، ح 1447 (الاستبصار:(@)(@@) ج 1، ح 732)، و 1495، و ج 3، ح 983 (الاستبصار: ج 1، ح 1840)، و 1007 (الاستبصار: ج 1، ح 1824).(@)(@@) * وروى عن أحمد بن حمزة، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 4، ح 122.(@)(@@) وروى عنه محمد بن عبد الله.(@)(@@) الكافي: ج 3، ك 5، ب 33، ح 7.(@)(@@) والتهذيب: ج 4، ح 144 (الاستبصار:(@)(@@) ج 2، ح 104).(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 3، ك 5، ب 33، ح 7.(@)(@@) والتهذيب: ج 4، ح 144 (الاستبصار:(@)(@@) ج 2، ح 104).(@)(@@) * وروى عن أيوب بن نوح، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 6، ح 1129، و ج 7، ح 1324 (الاستبصار: ج 3، ح 727).(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 198، ح 8.(@)(@@) والتهذيب: ج 5، ح 935.(@)(@@) * وروى عن الحسن بن ظريف، وروى عنه محمد بن عبد الله، ومحمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 125، ح 3.(@)(@@) * وروى عن الحسن بن علي بن PageV11P459(@)(@@) كيسان، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1524.(@)(@@) وروى عنه محمد بن سعيد الأذربيجاني.(@)(@@) الكافي: ج 7، ك 2، ب 53، ح 1.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 2، ب 32، ح 1، و ج 7، ك 2، ب 53، ح 1.(@)(@@) وروى عنه محمد بن يحيى العطار.(@)(@@) التهذيب: ج 9، ح 1272.(@)(@@) * وروى عن الحسين بن عبيد الله.(@)(@@) التهذيب: ج 6، ح 89.(@)(@@) * وروى عن الحسين بن علي بن كيسان الصنعاني، وروى عن سعد.(@)(@@) التهذيب: ج 2، ح 1248 (الاستبصار:(@)(@@) ج 1، ح 1253، وفيه سعد بن عبد الله).(@)(@@) * وروى عن الحسين بن مالك، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 7، ك 1، ب 37، ح 13.(@)(@@) والتهذيب: ج 9، ح 758 (الاستبصار:(@)(@@) ج 4، ح 470).(@)(@@) * وروى عن عبد العزيز بن زكريا اللؤلؤي، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 6، ب 98، ح 2.(@)(@@) * وروى عن علي بن الريان، وروى عنه سعد.(@)(@@) التهذيب: ج 3، ح 957.(@)(@@) * وروى عن علي بن سليمان بن رشيد، وروى عنه ابنه محمد.(@)(@@) الكافي: ج 6، ك 6، ب 103، ح 6.(@)(@@) * وروى عن محمد بن جزك.(@)(@@) الفقيه: ج 1، ح 1280.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: