ms10302	 4 ص: 1165)(@)(@@) PageV29P041(@)(@@) [32] نفس المصدر: (ج: 4 ص 1167) .(@)(@@) [33] لقد بر الملك عبد العزيز بوعده، وزار مصر زيارة رسمية وشعبية في صفر عام 1365 ه وقوبل من الشعب المصري والخكومة بما لم يقابل لا في السابق ولا في اللاحق من التكريم والحفاوة والترحيب والحب والإخلاص، كل هذا عنوانا على تقدير مصر لما قام به الملك عبد العزيز من أعمال عظيمة، وبخاصة ما قام به تجاه الحرمين والأراضي المقدسة، وسنفرد لها بحثا آخر إن شاء الله.(@)(@@) PageV29P042(@)(@@) تحقيق جزء الضعفاء والمتروكين(@)(@@) للإمام الدارقطني (2)(@)(@@) للشيخ عبد الرحيم محمد القشقري(@)(@@) محاضر بكلية الحديث الشريف بالجامعة(@)(@@) الحمد لله رب العالمين والصلاة على سيدنا محمد خاتم النبيين وبعد:(@)(@@) فإن علم الحديث يحتاج إلى معرفة الرواة الذين أوصلوا السنة النبوية إلينا من حيث جرحهم وتعديلهم ولما كان كتاب الإمام الدارقطني من الأصول المهمة في هذا الفن والذي طوته أيد الإهمال في عدم إخراجه عزمت على نشره في مجلة الجامعة الإسلامية ليتسنى لأكبر قدر ممكن من طلاب العلم الوقوف عليه والاستفادة منه.(@)(@@) وها أنذا أطرح الحلقة الثانية من كتاب الضعفاء والمتروكين لخاتمة الحفاظ، أرجو أن أكون قد وفقت على أقل تقدير في تصحيح النصوص الواردة في كتاب المصنف.(@)(@@) وقد سبق وأن قمت بتحقيق كتاب أسئلة البرقاني للإمام الدارقطني تحقيقا، واستفدت فيه من كتاب الضعفاء.(@)(@@) وسيقدم الكتاب المذكور للطبع بعد الانتهاء من الدراسة العلمية حول المصنف وكتابه السؤالات.(@)(@@) أرجو الله أن يوفقني في إخراجه وأن ينفع به طلاب العلم، إنه على كل شيء قدير.(@)(@@) حرف الحاء(@)(@@)(@@)(@@) | 151 - (@)(@@) الحارث بن عبد الله الأعور، كوفي همداني [1] .(@)(@@)(@@)(@@) | 152 - (@)(@@) الحارث بن عمران، أبو سهل الجعفري، كوفي عن محمد بن سوقه وهشام ابن عروة [2] .(@)(@@)(@@)(@@) | 153 - (@)(@@) الحارث بن نبهان الجرمي، بصري عن عاصم بن بهدلة، وأيوب السختياني، والأعمش، ليس بالقوي [3] .(@)(@@)(@@)(@@) | 154 - (@)(@@) الحارث بن شبل البصري، عن أم النعمان، مقل، وليست بمعروفة [4] .(@)(@@)(@@)(@@) | 155 - (@)(@@) الحارث بن سريج البقال، بغدادي، عن ابن عيينة، ويحيى القطان، ويزيد بن زريع، غمزه يحيى بن معين، وهو كما قال [5] .(@)(@@)(@@)(@@) | 156 - (@)(@@) الحارث بن حصيره، يغلو 
ms10303	 في التشيع [6] .(@)(@@)(@@)(@@) | 157 - (@)(@@) الحارث بن حجاج بن أبي الحجاج، مجهولان [7] .(@)(@@) PageV29P043(@)(@@)(@@)(@@) | 158 - (@)(@@) حكم بن ظهير الفزاري، عن عاصم، وعلقمة بن مرثد السدي، يروي عنه مروان الفزاري، يقول ابن أبي خالد.(@)(@@)(@@)(@@) | 159 - (@)(@@) حكم بن عبد الله بن سعد الأيلي، قرشي، عن القاسم بن محمد وابن أبي مليكة والزهري وابن أبي علي، متروك [8] .(@)(@@)(@@)(@@) | 160 - (@)(@@) حكم بن عبد الله، أبو مطيع الخراساني، بلخي، عن إبراهيم بن طهمان، وأبي حنيفة.(@)(@@)(@@)(@@) | 161 - (@)(@@) حكيم بن جبير، كوفي عن سعيد بن جبير، والنخعي والشعبي.(@)(@@)(@@)(@@) | 162 - (@)(@@) حماد بن عمرو النصيبي، أبو إسماعيل عن الأعمش، وزيد بن رفيع [9] .(@)(@@)(@@)(@@) | 163 - (@)(@@) حماد بن عيسى، غريق الجحفة [10] .(@)(@@)(@@)(@@) | 164 - (@)(@@) حماد المالكي، قدري، عن الحسن، كذاب.(@)(@@)(@@)(@@) | 165 - (@)(@@) حميد بن عطاء وقيل: ابن عامر المكتب، عن عبد الله بن الحارث، متروك.(@)(@@)(@@)(@@) | 166 - (@)(@@) حفص بن عمر الفرخ العدني، عن الحكم بن أبان [11] .(@)(@@)(@@)(@@) | 167 - (@)(@@) حفص بن عمر بن أبي سليمان أبو عمران الإمام النجار الواسطي.(@)(@@)(@@)(@@) | 168 - (@)(@@) حفص بن سليمان بن المغيرة أبو داود، هو القاري وهو حفص بن أبي داود سليمان.(@)(@@)(@@)(@@) | 169 - (@)(@@) حبيب، كاتب مالك، متروك.(@)(@@)(@@)(@@) | 170 - (@)(@@) حبيب الاسكاف، أبو عميرة كوفي عن أنس [12] .(@)(@@)(@@)(@@) | 171 - (@)(@@) حبيب بن حبان، هو ابن أبي الأشرس، ضعيف.(@)(@@)(@@)(@@) | 172 - (@)(@@) حجاج بن بصير، بصري، أجمعوا على تركه.(@)(@@)(@@)(@@) | 173 - (@)(@@) حجاج بن فروخ، واسطي، عن العوام بن حوشب، وابن جريج متروك.(@)(@@)(@@)(@@) | 174 - (@)(@@) حبان بن علي العنزي، عن الأعمش، وليث بن أبي سليم، ضعيف وأخوه مندل ضعيف أيضا.(@)(@@)(@@)(@@) | 175 - (@)(@@) حرام بن عثمان مدني، عن ابني جابر [13] .(@)(@@)(@@)(@@) | 176 - (@)(@@) حبه بن جوين العرني، عن علي رضي الله عنه [14] .(@)(@@)(@@)(@@) | 177 - (@)(@@) حصين بن مخارق، متروك.(@)(@@)(@@)(@@) | 178 - (@)(@@) حصين بن عمر أبو عمر الأحمسي، كوفي عن مخارق بن عبد الله، وإسماعيل بن أبي خالد [15] .(@)(@@)(@@)(@@) | 179 - (@)(@@) حمزة بن أبي حمزة النصيبي، عن أبي الزبير، وعمرو بن دينار [16] .(@)(@@)(@@)(@@) | 180 - (@)(@@) حسام بن مصك أبو سهل، بصري، عن قتادة [17] وعبد الله بن بريدة.(@)(@@) PageV29P044(@)(@@)(@@)(@@) | 181 - (@)(@@) حديج بن معاوية الكوفي، يغلب عليه الوهم، عن أبي إسحاق.(@)(@@)(@@)(@@) | 182 - (@)(@@) حسان بن سياه، كوفي، عن ثابت وعاصم بن أبي النجود.(@)(@@) آخر ما 
ms10304	 وجد في كتاب البرقاني.(@)(@@)(@@)(@@) | 183 - (@)(@@) حسن بن دينار وقيل ابن واصل وقيل ابن دينار زوج أمه عن الحسن وابن سيرين وأيوب [18] .(@)(@@)(@@)(@@) | 184 - (@)(@@) حسن بن عمارة كوفي [19] .(@)(@@)(@@)(@@) | 185 - (@)(@@) حسن بن زياد اللؤلؤي [20] .(@)(@@)(@@)(@@) | 186 - (@)(@@) حسن بن علي الهاشمي، عن الأعرج، عن أبي هريرة [21] .(@)(@@)(@@)(@@) | 187 - (@)(@@) حسن بن أبي جعفر، وفي نسخة حسن بن أبي جعفر الجفري، بصري، يروي عن أيوب، ومحمد بن جحادة، وأبي الزبير [22] .(@)(@@)(@@)(@@) | 188 - (@)(@@) حسن بن يحيى الخشني شامي، عن هشام بن عروة، متروك.(@)(@@)(@@)(@@) | 189 - (@)(@@) حسين بن عبد الله بن ضميرة، عن أبيه عن جده مدني [23] .(@)(@@)(@@)(@@) | 190 - (@)(@@) حسين بن علوان، عن هشام بن عروة، والأعمش، كذاب.(@)(@@)(@@)(@@) | 191 - (@)(@@) حلبس بن محمد المصري، الكلبي، عن الثوري [24] .(@)(@@)(@@)(@@) | 192 - (@)(@@) حسين بن قيس الرحبي، ويقال حنش، عن عكرمة، وعن عطاء، واسطي [25] .(@)(@@)(@@)(@@) | 193 - (@)(@@) حسين بن خالد الأشقر، كوفي، عن شريك، وقيس، وجعفر الأحمر، وهريم ابن سفيان. ليس بالقوي.(@)(@@) باب الخاء(@)(@@)(@@)(@@) | 194 - (@)(@@) خالد بن القاسم أبو الهيثم مدائني من الحفاظ، عن كعب بن سعيد وهشيم [26] .(@)(@@)(@@)(@@) | 195 - (@)(@@) خالد بن إلياس مدني، عن ربيعة بن أبي عبد الرحمن، وهشام بن عروة [27] .(@)(@@)(@@)(@@) | 196 - (@)(@@) خالد العبدي بصري، أكثر روايته عن الحسن، متروك.(@)(@@)(@@)(@@) | 197 - (@)(@@) خالد بن يزيد بن أبي مالك، شامي، عن أبيه، وأبوه من الثقات.(@)(@@)(@@)(@@) | 198 - (@)(@@) خالد بن محدوج، أبو روح واسطي، عن أنس [28] .(@)(@@)(@@)(@@) | 199 - (@)(@@) خالد بن عمرو الأموي، كوفي، عن الثوري والناس من ولد سعيد ابن العاص [29] .(@)(@@)(@@)(@@) | 200 - (@)(@@) خالد بن طليق بن محمد بن عمران بن حصين، بصري عن أبيه عن جده.(@)(@@)(@@)(@@) | 201 - (@)(@@) خليد بن دعلج، شامي، عن قتادة والحسين [30] .(@)(@@)(@@)(@@) | 202 - (@)(@@) خارجة بن مصعب سرخسي عن العالم [31] .(@)(@@) PageV29P045(@)(@@)(@@)(@@) | 203 - (@)(@@) خصيب بن جحدر، بصري عن أبي صالح، وعمرو بن دينار، والنعمان ابن نعيم، لا يعرف إلا برواته.(@)(@@)(@@)(@@) | 204 - (@)(@@) خصيب عنه خالد بن إسماعيل