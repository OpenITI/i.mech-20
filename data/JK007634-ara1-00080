ms61	 % عرفوا أصول المكرمات وفرعوا % % PageV01P180 62(@)(@@) % ما الحوز بعد نداك إلامقلة % مطروفة فدموعها لا تهجع % 63(@)(@@) % لبست مشارقها الظلام فشمسها % % لا تنجلي حتى جبينك يطلع % 64(@)(@@) % أحييتها بالعود بعد مماتها % % وكذا بعود الغيث تحيا الأربع % 65(@)(@@) % فارقتها فكأم موسى قلبها % % يبدي الصبابة فارغا يتوجع % 66(@)(@@) % ورجعت مسرورا فقرت باللقا % % عينا وقر فؤادها المتفزع % 67(@)(@@) % ناداك من نور عليها دوحة % صفو به أزكى الأصول وأينع % 68(@)(@@) % فوطأت أشرف بقعة قد قدست % ولبست خلعة إن نعلك يخلع % 69(@)(@@) % وخصصت بالرؤيا هناك وفزت في % % شرف الخطاب ولذ منك المسمع % 70(@)(@@) % فليهنك الشرف الممجد وليفز % في عودك المجد التليد الأرفع % 71(@)(@@) % مولاي لم أهد القريض إليك من % طمع ولا بي عن عطاك ترفع % PageV01P181 72(@)(@@) % لكنني قد خفت يسرق دره ال % متشاعرون وفي سواك يضيع % 73(@)(@@) % وهواك ألجاني لذلك والهوى % % سحر به ينشأ القريض ويصنع % 74(@)(@@) % فاستجلها بكرا يقلدها الثنا % % بالدر منه وبالحرير يلفع % 75(@)(@@) % عذراء قد زفت إليك وإنما % % منها الوصال على سواك ممنع % 76(@)(@@) % قد طرزت بسني مدحك بردها % % فكأنما هو بالحرير مجزع % 77(@)(@@) % وتمسكت بذيولكم فتمسكت % أردانها من طيبكم والاذرع % 78(@)(@@) % محبوبة سفرت إليك ووجهها % % مني بحسن الإعتذار مبرقع % 79(@)(@@) % خشيت مشاركتي بذنب تخلفي % % عنكم فكان لها لديك تسرع % 80(@)(@@) % سبقت لتشفع لي إليك وإنما ال % % وجه الجميل لدى الكرام يشفع % 81(@)(@@) % زهراء مطلعها بأفق ثنائكم % وختامها مسك بكم يتضوع % PageV01P182 البحر : كامل تام 1(@)(@@) % سطعت شموس قبابهم بزرود % فهوت نجوم مدامعي بخدودي % % 2(@)(@@) % وتلاعبت فرحا بهم فتياتهم % فطفقت أرسف في الهوى بقيودي % % 3(@)(@@) % وعلى الحمى ضربوا الخيام فليتهم % جعلوا من الأطناب حبل وريدي % % 4(@)(@@) % عهدي بهم تحيا الرسوم وإن عفت % فعلام أحشاءي ذوات همود % 5(@)(@@) % وحياتهم لولاهم ما لذ لي % % شهد الهوى المسموم بالتفنيد % 6(@)(@@) % كلا ولا استعذبت سائل عبرة % لولا ملوحتها لا ورق عودي % % 7(@)(@@) % تفدي القنا ما في مناطقهم وإن % هي أشبهت شداتها بعقود % 8(@)(@@) % نفر تكاد لطيبهم بأكفهم % تحكي ذوابلهم رطيب العود % 9(@)(@@) % لازال في وجناتهم ماء الصبا % % يسقي رياض 
ms62	 شقائق التوريد % 10(@)(@@) % وسقتهم مقل الغمام من الحيا % % دمعا يخدد وجنة الجلمود % PageV01P183 11(@)(@@) % لله فيهم أسرة لا تفتدى % % أسرى الهوى من سجنهم بنقود % 12(@)(@@) % كم من قلوب بينهم فوق الثرى % % وجنت وأبد ألصقت بكبود % 13(@)(@@) % تلقى المنية بين بيض خدودهم % بسطت ذراعيها بكل وصيد % 14(@)(@@) % % منهم بدور أسرة وسعود % 35(@)(@@) % ليس الحسام إذا تجرد متنه % في الضرب مثل الصارم المغمود % 36(@)(@@) % حتام تجرع يا فؤاد من المهى % % ومن الزمان مرارة التنكيد % 37(@)(@@) % وتميل للبيض الحسان تطربا % ميل العلي إلى خصال الجود % 38(@)(@@) % خير الملوك سليل أكرم والد % خلف الغطارفة الكرام الصيد % 39(@)(@@) % حر أتى بعد النبي وآله ال % أطهار للتأسيس والتأكيد % 40(@)(@@) % سمح إذا انتجع العفاة بنانه % هطلت سحائبها بغير رعود % PageV01P184 41(@)(@@) % غضب إذا ما العزم جرد حده % ضربت بشعرته يد التأييد % 42(@)(@@) % رام إذا اشتد النصال تنصلت % منه سهام الرأي بالتسديد % 43(@)(@@) % قاض إذا اختلف الخصوم كأنما % % فصل الخطاب رواه عن داود % 44(@)(@@) % بطل أساود لدنه يوم الوغى % % تذر الأسود فرائسا للسيد % 45(@)(@@) % وعزائم يوم الكفاح لدى اللقا % % قامت مقام الجحفل المحشود % 46(@)(@@) % تتنفس الصعداء خوف صعاده % مهج العدا فتذوب بالتصعيد % 47(@)(@@) % عدم الشريك له بكل فضيلة % يقضي له بمزية التوحيد % 48(@)(@@) % طلب العلا بسيوفه فاستخرجت % بالفتك جوهر كنزها المرصود % 49(@)(@@) % حظ العدو لديه بيض حديده % والوفد حمر نضاره المفقود % 50(@)(@@) % وافى العلا من بعد طول تأود % فاقام ما فيها من التأويد % PageV01P185 51(@)(@@) % وتعطلت بئر النوال وإن نشا % % ظفر العفاة بعذبها المورود % 52(@)(@@) % ملك كأني إن نطقت بمدحه % شتت في الأسماع سمط فريد % 53(@)(@@) % فكأنني للناشقين أفض عن % مختوم مسك فيه عند نشيدي % % 54(@)(@@) % لو تشعر الدنيا لقالت إن ذا % % مضمون أشعاري وبيت قصيدي % % 55(@)(@@) % لو تنصف الأيام لاعترفت له % بفضيلة المولى وذل عبيد % 56(@)(@@) % لو لم تنافسه النجوم على العلا % % خدمت رفيع جنابه المحسود % 57(@)(@@) % تلقى برؤيته المنى أو ما ترى % % غنوانه بجبينه المسعود % 58(@)(@@) % تجري بأجمعه المحبة للندى % % جري الصبابة في عروق عميد % 59(@)(@@) % وأشد فتكا في 
ms63	 الكماة بنصله % من لحظ مودود بقلب ودود % 60(@)(@@) % قبس يكاد إذا تسعر بأسه % عنه تسيل الدرع بعد جمود % PageV01P186 61(@)(@@) % لو ترتمي في اليم منه شرارة % لغدت به الأمواج ذات وقود % 62(@)(@@) % تأوي أسنته الصدور كأنما % % خلط القيون حديدها بحقود % 63(@)(@@) % والبيض حيث بدورها اعترفت له % بالفضل أكرمها بكل جحود % 64(@)(@@) % ما فاته فخر ولا ذم الورى % % يرقى لكنه مقامه المحمود % 65(@)(@@) % بنداه يخضر الحصى فكأنما % % أثر الصعيد له بكل صعيد % 66(@)(@@) % فالمجد مقصور عليه أثيله % والعز تحت ظلاله الممدود % 67(@)(@@) % مولى شوارد فضله ونواله % فينا تفوت ضوابط التحديد % 68(@)(@@) % % فيه على الإطلاق والتقييد % 69(@)(@@) % ياابن المصاليت الذين بسعيهم حازوا % % العلا من طارف وتليد % 70(@)(@@) % ورووا أسانيد المفاخر والتقى % % في عز آباء لهم وجدود % PageV01P187 71(@)(@@) % رهط بهم شرف الأنام وعنهم % % 72(@)(@@) % وضعوا لك المجد الأثيل وأسسوا % % فرفعته بقواعد التمهيد % 73(@)(@@) % زخرفته ونقشت فيه لمن يرى % % صورا من التعظيم والتمجيد % 74(@)(@@) % لولا ورودك للجزيرة ما زهت % وجنات جنات لها بورود % 75(@)(@@) % كلا ولا سحبت على ساحاتها % % أغصان قامات ذيول برود % 76(@)(@@) % فارقتها فخشيت بعدك أنها % % تضحي كما أضحت ديار ثمود % 77(@)(@@) % كانت بطوفان المهالك فاغتدت % لما رجعت على نجاة الجودي % % 78(@)(@@) % أنقذت أهليها ولو لم تأتهم % % 79(@)(@@) % الله حسبك كم غفرت لمذنب % منهم وكم أطلقت من مصفود % 80(@)(@@) % فليهنها الرحمن منك برجعة % فيها رجوع سرورها المفقود % PageV01P188 81(@)(@@) % والبس ثياب الأجر صافية فقد % % بعث الصيام بها رسول العيد % 82(@)(@@) % لازلت للإسلام أشرف كعبة % لم تخل يوما من طواف وفود % PageV01P189 البحر : سريع 1(@)(@@) % يامنة لذ بها السكر % لا ينقضي مني لها الشكر % 2(@)(@@) % فلق الدجى بعموده الفخر % وبكى الندى وتبسم الزهر % 3(@)(@@) % وتنفس النسرين عن عبق % منه بأذيال الصبا عطر % 4(@)(@@) % والوقت قد لطفت شمائله % فصفا ورق وراقت الخمر % 5(@)(@@) % فانهض على قدم السرور إلى % % شمس يطوف بكاسها بدر % 6(@)(@@) % بكر إذا ما الماء خالطها % % منها تولد لؤلؤ نثر % 7(@)(@@) % عذراء ما لبني الخلاعة عن % خلع العذار بحبها عذر % 8(@)(@@) % نفس من الياقوت سائلة 
ms64	 % روح ولكن جسمها تبر % 9(@)(@@) % تبدو برافعها فتحسبها % % بردا تلظى تحته جمر % 10(@)(@@) % نور يكاد فؤاد شاربها % % للعين منهاينجلي السر % PageV01P190 11(@)(@@) % لطفت فخلنا ذات جوهرها % % فنيث وقام بنفسها السر % 12(@)(@@) % تذر الزجاج بلونها ذهبا % % 13(@)(@@) % وكأن سر المومياء لها % % فيها لكسر قلوبنا جبر % 14(@)(@@) % وكأنما راووقهادنف % أجرى عقيق دموعه الهجر % 15(@)(@@) % ومهفهف كالشمس طلعته % بالجيد منه كواكب زهر % 16(@)(@@) % شغفت بقامته القنا فلذا % % ألوانها لشحوبها سمر % 17(@)(@@) % ورأى البهار شقيق وجنتها % % 18(@)(@@) % بوشاحه معنى عبارته % رقت ودقق شرحها الخضر % 19(@)(@@) % وبلحظه وفؤاد وإمقه % سكر له بكليهما كسر % 20(@)(@@) % باتت تضاحكني براحته % راح كأن حبابها ثغر % PageV01P191 21(@)(@@) % فأرضته بعد الجماح بها % % حتى تسهل خلقه الوعر % % 22(@)(@@) % نظم الهوى عقد العناق لنا % % ومن العفاف تضمنا أزر % 23(@)(@@) % رفع الشباب حجاب أوجهنا % % ومن الفتوة بيننا ستر % 24(@)(@@) % ولكم عرجت إلى محل علا % فوق السماك وتحته الغفر % 25(@)(@@) % بمطهم مثل الظليم إذا % % ما شد قلت بأنه صقر % 26(@)(@@) % تدري المها أن لا نجاة لها % % منه ويعلم ذلك العفر % 27(@)(@@) % فإذا له آجالها عرضت % عرضت لها آجالها الحمر % 28(@)(@@) % مثل الرياح رواح أربعة % شهر وسير غدوها شهر % 29(@)(@@) % كملت صفات الصافنات به % فبذاته لجميعها حصر % 30(@)(@@) % يجري ويجري الفكر يتبعه % فيفوت ثم ويحسر الفكر % PageV01P192 31(@)(@@) % ويكاد أن يرد السماء إذا % % ظن المجرة أنها نهر % 32(@)(@@) % أطلعت منه سهم حادثة % يرمي به عن قوسه الدهر % 33(@)(@@) % حتى بلغت أبا الحسين به % فبلغت حيث يرفرف النسر % 34(@)(@@) % حيث العلا ضربت سرداقه % فيه وحل المجد والفخر % 35(@)(@@) % حيث التقى والفضل أجمعه % تأوي إليه ويأمن البر % 36(@)(@@) % فوثقت منذ حللت ساحته % أن لا يحل بساحتي فقر % 37(@)(@@) % ما زال يقذف لي جواهره % حتى علمت بأنه بحر % 38(@)(@@) % يجدي ندى ويفيد مسئلة % فنواله وكلامه در % 39(@)(@@) % فوق الخصيب محل رفعته % وبه الخويزة دونها مصر % 40(@)(@@) % كم من أياديه لدي يد % ما ينقضي مني لها الشكر % PageV01P193 البحر : بسيط تام 1(@)(@@) % روى عن الريق منها الثغر والشنب % معنى عن الراح تروي نظمه 
ms65	 الحبب % 2(@)(@@) % وحدثت عن نفوس الصيد وجنتها % % أخبار صدق يقويها دم كذب % 3(@)(@@) % وأرسلت للدجى من فرعها مثلا % تمثلته فروع البان والعذب % 4(@)(@@) % وجال ماء محياها فأوهمنا % % أن الصباح غدير موجه ذهب % 5(@)(@@) % بيضاء عن وجهها في الجنح ما سفرت % إلا وقامت لها الحرباء ترتقب % 6(@)(@@) % لم يلقها الليل إلا دهمه صدرت % بيض الثياب وغارت فوقها الشهب % 7(@)(@@) % ريم بأحداقها ليث يصول وفي % % أطواقها ذنب السرحان منتصب % 8(@)(@@) % إذا أصاب غبار الكحل مقلتها % % تكاد ترقص من أهدابها العضب % 9(@)(@@) % من لحظها لا يصون القرن مهجته % ولا تضم عليه البيض والسلب % 10(@)(@@) % يحنو إليها حمام البان حين يرى % % منها القوام فيشدو وهو مكتئب % PageV01P194 11(@)(@@) % قد أيدت دولة المران قامتها % % وحكمتها على سلطانها القضب % 12(@)(@@) % مهاة خدر سباع الطير تألفها % % لعلمها بحنوب حولها تجب % 13(@)(@@) % تخال سمعا لديها وهي أفئدة % تهوي إليها وفيها الشوق يلتهب % 14(@)(@@) % تمسي العيون إذا من خدرها وردت % ماء الشباب بماء الورد ينسكب % 15(@)(@@) % للحسن سر طواه في مراشفها % % أوحاه منه إليها النحل والعنب % 16(@)(@@) % يظن أصداغها الرائي إذا انسدلت % تتلو عقاربها سحرا فتنقلب % 17(@)(@@) % كأن منها سوار البكر شمس ضحى % شق الصباح حشاها فهي تصطخب % 18(@)(@@) % والخال لص أمير الحسن أفرشه % نطع الدماء وهزت فوقه القضب % 19(@)(@@) % تهوي على جيدها الأقراط ساكنة % فتسحب الفرع ثعبانا فتضطرب % 20(@)(@@) % كأنما في عمود الصبح سحرتها % % تحت الدجى في حبال الشمس قد صلبوا % % PageV01P195 21(@)(@@) % أي القبائل من در البحار إلى % % عين الحياة سوى إنسانها هربوا % % 22(@)(@@) % وأي شهب سوى ما في قلائدها % % أمست صفوفا حوال الشمس تصطحب % 23(@)(@@) % من خدها في قلوب المدنفين لظى % وفي المحبين من أكفانها نصب % 24(@)(@@) % لم يسمك الحسن بيتا للهوى بحشا % إلا وكان له من فرعها طنب % 25(@)(@@) % ولا بنو المجد بيتا للنسيب بنوا % % إلا لها وعليها سجفه ضربوا % % 26(@)(@@) % لله أسد عرين من عشيرتها % % ترضى الصوارم عنهم كلما غصبوا % % 27(@)(@@) % غر إذا انكشفت عنهم ترائكهم % تحت الدجنة من أقمارها حسبوا % % 28(@)(@@) % تطلب الدر معنى من 
ms66	 مباسمهم % فأدرك النظم لما فاته الشنب % 29(@)(@@) % سيوفهم في مضاها مثل أعينهم % سود الجفون ولكن فاتها الهدب % 30(@)(@@) % قاموا لديها وباتوا حولها حرسا % إذا أحسوا بطيف طارق وثبوا % % PageV01P196 31(@)(@@) % عزت لديهم فحازت كلما ملكوا % % حتى لها النوم من أجفانهم وهبوا % % 32(@)(@@) % قد صيروا بالدم المخطوب سنتهم % خد المهاة وكف الليث يختضب % 33(@)(@@) % لحاظهم هندويات ذوائبهم % زنجية اللون إلا أنهم عرب % 34(@)(@@) % لم يحسنوا الخط إن رموا مكاتبة % فوق الصدور بأطراف القنا كتبوا % % 35(@)(@@) % سلوا البروق من الأجفان وابتسموا % % عنها وحادوا فقلنا إنهم سحب % 36(@)(@@) % إذا المنية عن أنيابها كشرت % عضوا عليها بذيل النقع وانتقبوا % % 37(@)(@@) % شنوا الإغار على نهب الجمال وإذ % فيهم أتت وهبوها كلما نهبوا % % 38(@)(@@) % يعزى إلى حيهم شح النساء كما % % إلى علي خصال الجود تنتسب % 39(@)(@@) % رب الخصال التي في مصابحها % % يزهو القريض وفيها تشرق الخطب % 40(@)(@@) % حسب الكواكب لو من بعضها حسبت % يوما فينظمها في سلكها الحبب % PageV01P197 41(@)(@@) % خليفة ورث المعروف عن خلف % فحبذا خلف حاز العلا وأب % 42(@)(@@) % حر إذا افتخروا قوم بمرتبة % ففي أبيه وفيه تفخر الرتب % 43(@)(@@) % نجم رحى الحرب والركبان تعرفه % ودائرات الليالي أنه القطب % 44(@)(@@) % زين الفعال إذا مداحه امتدحوا % % حسانها خلفهم في شعرهم نسبوا % % 45(@)(@@) % لو أنها مثلت في خلقه صورا % لنافستهن فيه الخرج العرب % 46(@)(@@) % فاق السحاب وأبكاها أسى فلذا % % تذري الدموع وفيها الرعد ينتحب % 47(@)(@@) % لولا تعجبها منه لما اجتمعت % لا يحدث الضحك حتى يحدث العجب % 48(@)(@@) % إن كان يشمله لفظ الملوك فقد % يعم بالجنس نوع الصندل الخشب % 49(@)(@@) % جسم تركب تركيب الطباع به % الحلم والبأس والمعروف والأدب % 50(@)(@@) % يغشى الرماح العوالي غير مكترث % بها فيحسب منها أنه لعب % PageV01P198 51(@)(@@) % رأى العلا سكرا يحلو لطالبه % فظن أن أنابيب القنا قصب % 52(@)(@@) % لولاه جسم العلا أوصاله افترقت % كأن آراءه في ربطه عقب % 53(@)(@@) % يحمي الولي ويقضي ذو النفاق به % كالماء يهلك فيه من به الكلب % 54(@)(@@) % في كل أنملة منه وجارحة % يمد بحرا ويسطو فيلق لجب % 55(@)(@@) % قد أضحك 
ms67	 التيه في أيديه صارمه % وهز في راحتيه رمحه الطرب % 56(@)(@@) % يسقي النجيع مواضيه فيضرمها % % فاعجب لنار لها ماء الطلا حطب % 57(@)(@@) % ذؤابة الموت سمراء بلهذمه % كأنه فوقها نجم له ذنب % 58(@)(@@) % لو هز جذعا هشيما في أنامله % يوما لأوشك منه يسقط الرطب % 59(@)(@@) % يفوح نشر الكبا من طي بردته % وفي النبوة منه يعبق النسب % 60(@)(@@) % فأين طين الورى من طيب عنصره % وهل يساوي رطيب المندل الضرب % PageV01P199 61(@)(@@) % قد نزهت آية التطهير ملبسه % من كل نجس ولكن سيفه جنب % 62(@)(@@) % من معشر شرف الله الوجود بهم % وأنزلت فيهم الآيات والكتب % 63(@)(@@) % هم الملائك إلا أنهم بشر % على الورى حلفاء للهدى نصبوا % % 64(@)(@@) % أبناء مجد كرام قبل ما فطموا % % عن الرضاع لأخلاف الندى حلبوا % % 65(@)(@@) % قوم إذا ذكر الرحمن من وجل % لانوا وإن شهدوا يوم الوغى صعبوا % % 66(@)(@@) % غر الوجوه مصاليت إذا نزلوا % % عن السروج محاريب التقى ركبوا % % 67(@)(@@) % لايسكن الحق إلا حيث ما سكنوا % % وليس يذهب إلا حيث ما ذهبوا % % 68(@)(@@) % بحور جود إذا هبت رياح وغى % ماجوا ومجوا وإن هم سالموا عذبوا % % 69(@)(@@) % إذا تنشقت رياهم عرفتهم % بأنهم من جناب القدس قد قربوا % % 70(@)(@@) % سكرى إذا أصبحوا تدري الصحاة بهم % من أي كاس طهور بالدجى شربوا % % PageV01P200 71(@)(@@) % كأنهم يا علي المجد إذ نظروا % % تخيروك من الأولاد وانتخبوا % % 72(@)(@@) % قد خلفوك إماما بعدهم ومضوا % % وأبرزوك إلى الإسلام واحتجبوا % % 73(@)(@@) % تخوي العروش إذا ما غبت عن بلد % حتى تعود فيحيي منه الخرب % 74(@)(@@) % لو لم تعد لم تعد للحوز بهجته % ولا تورد يوما خده الترب % 75(@)(@@) % لولا وجودك فيه أهله هلكوا % % كذاك يهلك بعد الوابل العشب % 76(@)(@@) % لو كنت مولى تجازيهم بما اقترفوا % % من الذنوب إذا بادوا بما كسبوا % % 77(@)(@@) % لم يرج بالعفو منهم فعل مكرمة % من عندهم بل على الرحمن محتسب % 78(@)(@@) % كسرت جبتهم بالسيف فاجتمعوا % % عليك أحزاب ذاك الجبت واعتصبوا % % 79(@)(@@) % هموا بإطفاء نور المجد منك فلا % % فتم فيك ويأبى الله ما طلبوا % % 80(@)(@@) % فكلما أوقدوا نارا بها احترقوا % % وأحدثوا 
ms68	 الحرب فيهم يحدث الحرب % PageV01P201 81(@)(@@) % أخزاهم الله أنى يؤفكون ولو % حازوا الهدى لطريق الإفك ما ارتكبوا % % 82(@)(@@) % فدم على رغمهم بعلا لبكر علا % صداقها منك ضرب الهام والنشب % 83(@)(@@) % والبس قميصا من الإجلال في دمهم % قد دبجته المواضي والقنا السلب % 84(@)(@@) % واسعد بعيد بنحس المعتدين أتى % % مبشرا أرسالته نحوك الحقب % 85(@)(@@) % يوم وليك مسرورا بعودته % وفي عدوك منه الهم والنصب % 86(@)(@@) % فلا عصتك الليالي يا ابن سيدها % % وحالفتك على أعدائك النوب % PageV01P202 البحر : كامل تام 1(@)(@@) % أموا بنا نحو العقيق وأدلجوا % % وقفوا على تلك الربوع وعرجوا % % 2(@)(@@) % واثنوا الأعنة نحو سكان اللوى % % والووا بأعناق المطي وعوجوا % % 3(@)(@@) % فإذا لكم بدت الرسوم فأمسكوا % % أكبادكم حتى يديكم تنضج % 4(@)(@@) % فهناك حي للعيون تنزه % فيه وللقلب الشجي تبهج % 5(@)(@@) % حي على الوادي كأن قبابه % كشف ينوعها الحيا ويزبرج % 6(@)(@@) % حرم ترى من دون بيضة خدره % كم فيه بيضة خادر تتدحرج % 7(@)(@@) % عذب المناهل غير إن ورودها % % نار المنايا دونه تتأجج % 8(@)(@@) % يمسي بأربعه لنيران القرى % % وفد وللبيض الرقاق تموج % 9(@)(@@) % لكواكب الفتيان فيه تحجب % ولأنجم الفتيات فيه تبرج % 10(@)(@@) % أوراقه تشجي ورجع قيانه % أشجى وأوقع في النفوس وأوهج % PageV01P203 11(@)(@@) % كم فيه ظبي بالحرير مسربل % وهزبر حرب بالحديد مدجج % 12(@)(@@) % ورفيع مجد بالنجيع مخضب % وصريع وجد بالدموع مضرج % 13(@)(@@) % ولكم به شمس تقلد جيدها % % شهبا وبدر بالهلال مدملج % 14(@)(@@) % بصعيده تشفى العيون وتنجلي % % فكأن كل حصى عليه دهنج % 15(@)(@@) % لله أيام لنا سلفت به % وليال وصل صفوها لا يمزج % 16(@)(@@) % أوقات أنس كالعرائس بهجة % يا ليتها بالبين لا تتزوج % 17(@)(@@) % كالعقد كان نظامها فتفرقت % فحكت ثنايا الغر وهو مفلج % 18(@)(@@) % حيا الحيا العرب الأولى لضيوفهم % نسجوا به بسط الحرير ودبجوا % % 19(@)(@@) % وبمهجتي منهم علي أعزة % دخلوا الفؤاد ومنه صبري أخرجوا % % 20(@)(@@) % صبح الوجوه ترى على جبهاتهم % تزهو مصابيح الجمال وتسرج % PageV01P204 21(@)(@@) % أخذوا جيادهم أهلة عسجد % وبأنجم البيض الحديد تتوجوا % % 22(@)(@@) % لم أنس موقفهم وقد أرق النوى % % والريح تحدي للرحيل وتحدج % 23(@)(@@) % ساروا فكم قمر على 
ms69	 فرس بدا % % فيهم وكم شمس زواها هودج % 24(@)(@@) % ولرب سافرة غداة رحيلهم % ذهلت وأفزعها الفراق المزعج % 25(@)(@@) % تبكي وتذرى كحلها بدموعها % % فيعود ورد الخد وهو بنفسج % 26(@)(@@) % لمء أدر قبل أرى الدموع بجفنها % % أن اللآءلي البيض قد تتنسج % 27(@)(@@) % حتام أطلب للنجوم فأرتقي % % وأهم في وصل النجوم فأعرج % 28(@)(@@) % وأضل في ليل الغواية والهوى % % وبياض شيبي فجره يتبلج % 29(@)(@@) % ما كنت أول مدنف بفؤاده % لعب الهوى وسباه طرف أدعج % 30(@)(@@) % وإلام تطمعني الحسان بوصلها % % وعهودهن قضية لا تنتج % PageV01P205 31(@)(@@) % وأقول إن الدهر يسمح باللقا % % ونوى الأحبة كربة لا تفرج % 32(@)(@@) % تعس الزمان وليس فيه منظر % حسن إذا جربته لا يسمح % 33(@)(@@) % هل فيه للظن الجميل معرس % أو للقوافي السائرات معرج % 34(@)(@@) % همدت مرابعه فليس به سوى % % مغنى علي روضة تتأرج % 35(@)(@@) % غيث إذا ما النبت صوح والكلا % أولى ووجه الأرض لا يتدجج % 36(@)(@@) % أني أتيت ربوعهم فرياضها % % خضر وورق المكرمات تثجج % 37(@)(@@) % قاس الأنام به الغمام وما يروا % % أن الغمام بجوده يتسرج % 38(@)(@@) % لو في سباخ الأرض يمطر كفه % بالتبر فيها نور الفيروزج % 39(@)(@@) % خلق الندى خلقا له فإن ادعى % % فيه سواه فأحول يتغنج % 40(@)(@@) % أفديه بالمتصنعين فإنهم % ماء عليه طحلب يتفلذج % PageV01P206 41(@)(@@) % يا من أظل الرزق ملك بنانه % فيها إليه بكل حظ منهج % 42(@)(@@) % جمعت به ميم الكرام فأصبحت % حجبا بعشر بنانه يتخلج % 43(@)(@@) % سمح إذا ما الدهر أصبح كالحا % منه تبلج فيه وجه أبلج % 44(@)(@@) % هو للعلا زند وللدنيا إذا % % ما اسودت الأيام خد أنعج % 45(@)(@@) % دع عنك أخبار الكرام فإنه % هو زبدة يكفيكها ونموذج % 46(@)(@@) % عذبت موارده وطاب فمنه % بالمن عند الورد لا يتأرجج % 47(@)(@@) % بصفاته كم ضل عقل واهتدى % % بضيائه في الليل سار مدلج % 48(@)(@@) % قبس يهز خليج فولاذ به % غرقى النفوس الخائنات تلجج % 49(@)(@@) % يجتاز ريح السخط فيه فيلتظي % % ويمر برد العفو فيه فيثلج % 50(@)(@@) % رضع الردى حتى ترشح جسمه % لبنا فأصح فوقه يترجرج % PageV01P207 51(@)(@@) % تمسي الأسود على الثرى صرعى إذا % % شهدت نمال الموت فيه 
ms70	 تدرج % 52(@)(@@) % بطل أسنته تنضنض بالسنا % % منهن السنة الردى وتلجلج % 53(@)(@@) % فيه تثقفت الرماح فأوشكت % تنساب من يده القناة فتخلج % 54(@)(@@) % وتشحذت بيض السيوف بعزمه % فمضت وكاد كمامها يتسرج % 55(@)(@@) % تلقى عواملها الجموع إذا سطا % % فكأنها ألفات وصل تدرج % 56(@)(@@) % آباؤه حجج الإله وحجه % فرض على ذي حاجة يتحوج % 57(@)(@@) % من عترة في جودهم ووجودهم % أمن الورى نوب الزمان وأبلجوا % % 58(@)(@@) % رهط بهم طابت وزادت يثرب % شرفا وعزت أوسها والخزرج % 59(@)(@@) % لو يقسم الداعي بهم يوما على % % صم الجبال لأقبلت تتخزلج % 60(@)(@@) % ركبوا الخطوب وألجموها بالظبا % % PageV01P208 61(@)(@@) % قرنوا السماحة بالشجاعة مثل ما % % بالعفو قد خلطوا العفاف وأدمجوا % % 62(@)(@@) % وتفردوا بالحمد إلا أنهم % شعفوا فرادى المكرمات وزوجوا % % 63(@)(@@) % يا من إذا حدثت عنه بأنه % بحر فلا أخشى ولا أتحرج % 64(@)(@@) % إن قيل مشكاة فرأيك نير % أو قيل مرآة ف أسرج % 65(@)(@@) % أنى تجارى في الكمال وإنما % % لقمان في المضمار خلفك أعرج % 66(@)(@@) % فرجت ضيق المشكلات بفكرة % في السم يمكنها لرضوى تولج % 67(@)(@@) % لازلت خير أب لأبناء الرجا % % وطريق رزق بابه لا يرتج % 68(@)(@@) % فانعم بأجر الصوم وابق بنعمة % تغلي صدور الحاسدين وتوهج % 69(@)(@@) % وابهج بعيد أنت أسنى غرة % منه وأبهى في القوب وأبهج % PageV01P209 البحر : كامل تام 1(@)(@@) % سفرت فبرقعها حجاب جمال % وصحت فرنحها سلاف دلال % 2(@)(@@) % وجلت بظلمة فرعها شمس الضحى % % فمحى نهار الشيب ليل قذال % 3(@)(@@) % وتبسمت خلف الثام فخلتها % % 4(@)(@@) % ورنت فشد على القلوب بأسرها % % أسد المنية من جفون غزال % 5(@)(@@) % وا كنت أدري قبل سود جفونها % % أن الجفون مكامن الآجال % 6(@)(@@) % بكر تقوم تحت حمر ثيابها % % فيه على الإجمال كل فضيلة % 7(@)(@@) % ريانة وهب الشباب أديمها % % لطف النسيم ورقة الجريال % 8(@)(@@) % عذبت مراشفها فأصبح ثغرها % % كالأقحوان على غدير زلال % 9(@)(@@) % وسخا الشقيق لها بحبة قلبه % فاستعملتها في مكان الخال % 10(@)(@@) % حتام يطمع في نمير وصالها % % قلبي فتورده سراب مطال % PageV01P210 11(@)(@@) % علت بخمر رضابها فمزاجها % % لم تصح يوما من خمارملال % % 12(@)(@@) % هي منيتي وبها حصول منيتي % % وضياء عيني وهي 
ms71	 عين ضلالي % % 13(@)(@@) % أدنو إليها والمنية دونها % % فأرى مماتي والحياة حيالي % % 14(@)(@@) % تخفى فيخفيني النحول وينجلي % % فيقوم في الليل التمام ظلالي % % 15(@)(@@) % علقت بها روحي فجردها الضنى % % من جسمها وتملقت بمثال % 16(@)(@@) % فلو أنني من غير نوم زرتها % % وتتبعوا الآثار منه فحاولوا % % 17(@)(@@) % لم يبق مني حبها شيئا سوى % % نفر إذا سئلوا فأبحار وإن % 18(@)(@@) % من لم يصل في الحب مرتبة الفنا % % فوجوده عدم وفرض محال % 19(@)(@@) % فكري يصورها ولم تر غيرها % % عيني ورسم جمالها بخيالي % % 20(@)(@@) % فوقي وقدامي وعكسهما أرى % % منها المثال ويمنتي وشمالي % % PageV01P211 21(@)(@@) % بانت فلا سجعت بلابل بانة % إلا أبانت بعدها بلبالي % % 22(@)(@@) % أنا في غدير الكرختين ومهجتي % % معها بنجد في ظلال الضال % 23(@)(@@) % حيا الحيا حيا بأكناف الحمى % % فأتى بكل مطهر مفضال % 24(@)(@@) % حيا حوى الأضداد فيه فنقعه % ليل يقابله نهار نصال % 25(@)(@@) % تلقى بكل من خدود سراته % شمسا قد اعتنقت ببدر كمال % 26(@)(@@) % جمع الضراغم والمهى فخيامه % كنس الغزال وغابه الرئبال % 27(@)(@@) % وسقى زمانا مر في ظهر النقا % % ولياليا سلفت بعين أثال % 28(@)(@@) % ليلات لذات كأن ظلامها % % خال على وجه الزمان الخالي % % 29(@)(@@) % نظمت على نسق العقود فأشبهت % بيض اللآلي وهي بيض ليالي % % 30(@)(@@) % قلبي وكل جوارحي ومفاصلي % % كم بين من جلى وبين التالي % % PageV01P212 31(@)(@@) % لله كم لك يا زماني في من % جرح بجارحة وسهم وبال % 32(@)(@@) % صيرتني هدفا فلو يسقي الحيا % % جدثي لأربت تربتي بنبال % 33(@)(@@) % سمح به انفرجت عيون قريحتي % % مسحت عليه راحة الإقبال % 34(@)(@@) % بنداه علمني القريض فصغته % فأتيت فيه مرصع الأقوال % 35(@)(@@) % ولهجت فيه وكان دهرا عاطلا % فأزنته منه بحلي خصال % 36(@)(@@) % ولفظت بعضا من فرائد لفظه % فجعلته وسطا لعقد مقالي % % 37(@)(@@) % أتلو مدائحه فيعبق طيبها % % وكذا القوافي العاليات غوالي % % 38(@)(@@) % يا زينة الدنيا ولست مبالغا % وأجل أهليها ولست أغالي % % 39(@)(@@) % هنيت بالأفراح يا أسد الشرى % % بختان سبط أكرم الأشبال % 40(@)(@@) % سبط تشرف في أبيه وجده % ونجابة الأعمام والأخوال % PageV01P213 41(@)(@@) % ما في أبيه السيد اللاوي به % من فتكة وسماحة ومعالي % % 42 
ms72	(@)(@@) % منذ استهل به تبين ذا ولم % تلد الأفاعي الرقم غير صلال % 43(@)(@@) % بالمهد قد أوتي الكمال وإنما % % غلبت عليه عادة الأطفال % 44(@)(@@) % نور أتى من نيرين كلاهما % % منك استفادا أي نور جلال % 45(@)(@@) % سعداهما اقترنا معا فتثلثا % % بجبين أي فتى سعيد الفال % 46(@)(@@) % يجري الصبا في عوده فتظنه % نصلا ترقرق فيه ماء صقال % 47(@)(@@) % ويلوح نور المجد وهو بمهده % فيه فتحسبه شعاع ذبال % 48(@)(@@) % فعساك تختن بعده أولاده % في أحسن الأوقات والأعمال % 49(@)(@@) % وعسى لك الرحمن يقبل دعوتي % % ويجيب فيك وفي بنيك سؤالي % % PageV01P214 البحر : كامل تام 1(@)(@@) % أمن البروج تعد أكناف الحمى % % فلقد حوت منه الملاعب أنجما % % 2(@)(@@) % مغنى توهمت الحسان بأرضه % أن الهبوط به العروج إلى السما % % 3(@)(@@) % أكرم بها من أوجه في أوجه % طلعت على جيش الدجا فتصرما % % 4(@)(@@) % فلك تدلى أطلسا وإذا استوى % % هبطت به مصر فصار منجما % % 5(@)(@@) % في كل سرب من فرائد سربه % وضع الجمال من الفراقد توأما % % 6(@)(@@) % حسد الهلال به السوار فود أن % لو حال من بدل الذراع المعصما % % 7(@)(@@) % حتى إذا سطعت مجامر نده % لبس النهار عليه ليلا مظلما % % 8(@)(@@) % إن كان ما بين الديار قرابة % فله إلى دارين أطيب منتمى % % 9(@)(@@) % حرم يمسي به المهند محرما % وترى به الماء المباح محرما % % 10(@)(@@) % أروته ضاحكة السيوف بدمعها % % حتى نهت عن تربه المتيمما % % PageV01P215 11(@)(@@) % سقيا له من منزل نزل الهوى % % بربوعه وبنى الخيام وخيما % % 12(@)(@@) % وبمهجتي العرب الأولى لولاهم % لم تعرب الأجفان سرا معجما % % 13(@)(@@) % عرب إذا ما البرق ضاحك بينهم % % خجلا بأذيال السحاب تلثما % % 14(@)(@@) % يا قلب أينك من بلوغ بدورهم % ولو اتخذت من حبال شمسك سلما % % 15(@)(@@) % غر تغانوا بالقدود عن القنا % % وكفاهم حور العيون الأسهما % % 16(@)(@@) % لبست أسودهم الحديد مسردا % وظباؤهم وشي الحرير مسهما % % 17(@)(@@) % تبدو بحيهم الغزالة في الدجى % % والبدر يطلع بالنهار مغمما % % 18(@)(@@) % من كل ضرغام بظهر نعامة % للطعن يمسك في الأنامل أرقما % % 19(@)(@@) % محت السواد خدودهم فتوردت % وجفانهم مما سفكن من الدما % % 20(@)(@@) % تجري لطافته بشدة بأسه 
ms73	 % فيلين خطيا ويبسم مخذما % % PageV01P216 21(@)(@@) % عشقوا الردى فتطلبوا أسبابه % فلذاك هاموا في العيون تيمما % % 22(@)(@@) % وترشفوا شهد الشفاه لأنها % % تحكي اسمرار اللدن في لون اللمى % % 23(@)(@@) % ولحبهم سفك الدماء وشربها % % شربوا لخمرتها المدام توهما % % 24(@)(@@) % سجنوا العذارى في الخيام فأشبهت % خفراتها بقبابهم صور الدمى % % 25(@)(@@) % سدوا الكرى من دونهن على الصبا % % كيلا يمر بها النسيم مسلما % % 26(@)(@@) % بوجوه فتيتهم ملاحة يوسف % ومآزر الفتيات عفة مريما % % 27(@)(@@) % ظهر الجمال وكان معنى ناقصا % حتى ألم بحيهم فتتمما % % 28(@)(@@) % والدر في الدنيا تفرق شمله % حتى حوته شفاههم فتنظما % % 29(@)(@@) % عذلوا السلو عن القلوب وحكموا % % فيهن سلطان الهوى فتحكما % % 30(@)(@@) % لله كم في حيهم من جؤذر % يسطو بمهجته فيصرع ضيغما % % PageV01P217 31(@)(@@) % ولكم بهم خد تورد لونه % جدلا وخد بالدموع تعندما % % 32(@)(@@) % نظراتهم تردي القلوب كما غدت % يد محسن تروي العطاش الهوما % % 33(@)(@@) % غيث لديه رياض طلاب الندى % % تزهو برواد النضار إذا همى % % 34(@)(@@) % سمح أياديه لنا كم أوضحت % من غرة بجبين خطب أدهما % % 35(@)(@@) % حسن أزيد به الزمان ملاحة % فحلت ملاحته وكانت علقما % % 36(@)(@@) % تلقاه في الأيام إما ضاربا % أو طاعنا أو معطيا أو مطعما % % 37(@)(@@) % طورا تراه لجة مورودة % عذبت وآونة شهابا مضرما % % 38(@)(@@) % لبس العلا قبل القماط وقبل ما % % خلع التمائم بالسلاح تختما % % 39(@)(@@) % في وجهه نور الهدى وبغمده % نار الردى وبكفه بحر طمى % % 40(@)(@@) % لو أن بعضا من سماحة كفه % بيمين قارون لأصبح معدما % % PageV01P218 41(@)(@@) % علم على ظهر الجواد تظنه % علما تعرض للكتائب معلما % % 42(@)(@@) % يهتز من طرب مهنده فلو % % غنى الجماد لكاد أن يترنما % % 43(@)(@@) % ويكاد ينطق في البنان يراعه % لو أن مقطوع اللسان تكلما % % 44(@)(@@) % وافى وطرف المجد غض على القذى % % دهرا فأبصر فيه من بعد العمى % % 45(@)(@@) % وأتى الزمان وقد تقطب وجهه % غضبا على أبنائه فتبسما % % 46(@)(@@) % قمر تلوح بوجهه سمة العلا % فترسما آثارها وتوسما % % 47(@)(@@) % وتأملاه فتم نور سعادة % وسيادة يأبى العلا أن يكتما % % 48(@)(@@) % تهمي براحته السيوف على العدا % % نقما تعود على المحبة أنعما % % 49(@)(@@) % نار 
ms74	 الحديد لديه في حر الوغى % % أشهى من الماء الزلال على الظما % % 50(@)(@@) % ليس الحيا طبعا خليقته السخا % % بل علمته أكفه فتعلما % % PageV01P219 51(@)(@@) % لولا فصاحته ونسبة حيدر % لظننته يوم الكريهة رستما % % 52(@)(@@) % ولد لأكرم والد من معشر % ورثوا المكارم أكراما عن أكرما % % 53(@)(@@) % عن جده يروي أبوه مآثرا % لأبيه وهو اليوم يروي عنهما % % 54(@)(@@) % وكذاك إخوته الكرام جميعهم % نقلوا روايات المحامد منهما % % 55(@)(@@) % من شئت منهم تلقه في حربه % والسلم ليث وغى وبحرا منعما % % 56(@)(@@) % غر بأخلاق الكرام تشابهوا % % حتى رأينا الفرق أمرا مبهما % % 57(@)(@@) % فهم البدور الساطعات وإنما % % بالعدل بينهم الكمال تقشما % % 58(@)(@@) % مولاي أنتم سادتي وسيادتي % % منكم وقدري في مدائحكم سما % % 59(@)(@@) % قربتموني من رفيع جنابكم % فغدوت مرفوع الجناب معظما % % 60(@)(@@) % لو لم يكلفني السجود لشكرها % % نعماؤكم عندي بلغت المرزما % % PageV01P220 61(@)(@@) % لله درك من لبيب رأيه % لم يحظ أغراض الزمان إذا رمى % % 62(@)(@@) % هنيت بالولد السعيد وخنته % % ورعاه خالقه الحفيظ وسلما % % 63(@)(@@) % ولد تصور يوم مولده الندى % % والمجد عاد إلى الشبيبة بعدما % % 64(@)(@@) % حملته من قمر الدجى شمس الضحى % % نالت به نجلا تخيله هما % % 65(@)(@@) % طهرته بالختن وهو مطهر % قبل الختان تشرعا وتكرما % % 66(@)(@@) % أنى يطهر بالختان صبيكم % أو تنجسون وأنتم ماء السما % % 67(@)(@@) % شهدت لكم آي الكتاب بأنكم % منذ الولادة طاهرون وقبل ما % % 68(@)(@@) % أنتم بنو المختار أشرف عترة % فعليكم صلى الإله وسلما % % PageV01P221 البحر : طويل 1(@)(@@) % كشفت حجاب السجف عن بيضة الخدر % فزحزحت جنح الليل عن طلعة البدر % 2(@)(@@) % وهتكت عن سين الثنايا لثامها % % فأبصرت عين الخضر في ظلمة الشعر % 3(@)(@@) % وجاذبتها سود الذوائب فانثنى % % علي قضيب البان في الحلل الخضر % 4(@)(@@) % وقبلت منها وجنة دون وردها % % وتقبيلها شوك المثقفة السمر % 5(@)(@@) % تأتيتها في الليل كالصقر كاسرا % وقد خفقت في الجنح أجنحة النسر % 6(@)(@@) % وخضت إليها الحتف حتى كأنني % % أفتش أحشاء المنية عن سري % % 7(@)(@@) % وشافهت أحراسا إلى ضوء وجهها % % يرون سواد الطيف إذ نحوها يسري % % 8(@)(@@) % فنبهت منها نرجسا زره الكرى % % كأني أفض الختم عن قدحي خمر 
ms75	 % 9(@)(@@) % وبتنا وقلب الليل يكتمنا معا % وغرتها عند الوشاة بنا تغري % % 10(@)(@@) % وإذا الصبح في الظلماء غار غدير % فمن ضوئها لج السراب بنا يسري % % PageV01P222 11(@)(@@) % فلو لم ترد الليل صبغة فرعها % % عليها لكان الحي في سرنا يدري % % 12(@)(@@) % وباتت تحلي السمع منا بلؤلؤ % على عقدها المنظوم منثوره يزري % % 13(@)(@@) % كلانا له منا نصيب فجامد % على نحرهايزهو وجار على نحري % % 14(@)(@@) % تبارك من قد علم الظبي منطلقا % وسبحان مجري الروح في دمية القصر % 15(@)(@@) % بروحي منها طلعة كلما انجلت % تشمت في موت الدجى هاتف القمري % % 16(@)(@@) % ونقطة خال من عبير بخدها % % كحبة قلب أحجبته يد الذكر % 17(@)(@@) % خلت من سواها مهجتي فتوطنت % % بها والمهى لم ترض دارا سوى القصر % % 18(@)(@@) % كأن فمي من ذكرها فيها وطيبه % قارة بيت النحل أو دارة العطر % 19(@)(@@) % إذا زين الأملاك حلية مفخر % إذا خدها في القلب صوره فكري % % 20(@)(@@) % أردت بها التشبيب في وزر شعرها % % فغزلت في البحر الطويل من الشعر % PageV01P223 21(@)(@@) % وصغت الرقى إذ علمتني جفونها % % بناء القوافي الساحرات على الكسر % 22(@)(@@) % أجانس باللفظ الرقيق خدودها % % وألحظ بالمعنى الدقيق إلى الخصر % 23(@)(@@) % أما والهوى العذري لولا جبينها % % لما رحت في حبي لها واضح العذر % 24(@)(@@) % ولولا اللآلي البيض بين شفاهها % % لما جاد دمعي من يواقيته الحمر % 25(@)(@@) % شغفت بها حبا فرقت رقائقي % % وملكت رقي حيدرا فسما قدري % % 26(@)(@@) % خلاصة أبناء الكرام مطهرا % سلالة آباء مطهرة غو % 27(@)(@@) % حليف الندى واليأس والحلم والنهى % % أخو العدل والإحسان والعفو والبر % 28(@)(@@) % جمال جبين البدر والنير الذي % % بطلعته قد أشرقت غرة الدهر % 29(@)(@@) % فتى جاء والأيام سود وجوهها % % فأصبح كالتوريد في وجنة العصر % 30(@)(@@) % وأضحت وجوه المكرمات قريرة % بمولده والصدر منشرح الصدر % PageV01P224 31(@)(@@) % وأينع من بعد الذبول به الندى % % فغرد في أفنائه طائر الشكر % 32(@)(@@) % ووافى المعالي بعد تشتيت شملها % % فأحسن منها النظم بالنائل النثري % % 33(@)(@@) % أرق من الراح الشمول شمائلا % وألطف خلقا من نسيم الهوى العذري % % 34(@)(@@) % إذا زين الأملاك حلبة مفخر % ففيه وفي آبائه زينة الفخر 
ms76	 % 35(@)(@@) % تكلمه في الصدق آيات سورة % ولكنه في السمع في صورة السحر % 36(@)(@@) % تسميه باسم الجد عندي كناية % كما يتسمى صاحب الجود بالبحر % 37(@)(@@) % إذا بأبيه قست مصباح نوره % تيقنته من ذلك الكوكب الدري % % 38(@)(@@) % يرق ويصبو رحمة وصلابة % فيجري كما تجري العيون من الصخر % 39(@)(@@) % سما للعلاق والشهب تطلب شأوه % % فعبرعند السبق عن جهة الغفر % 40(@)(@@) % فلو كان حوض المزن مثل يمينه % % لما هطلت إلا بمستحسن الدر % PageV01P225 41(@)(@@) % ولو منبت الزقوم يسقى بجوده % لما كان إلا منبت الورد والزهر % 42(@)(@@) % يهز سيوف الهند وهي جداول % فتقذف في أمواجها شعل الجمر % 43(@)(@@) % ويحمل أغصان القنا وهي ذبل % فتحمل في راحاته ثمر النصر % 44(@)(@@) % ويسفر عن ديباجتيه لثامه % فيلبس عظف الليل ديباجة الفخر % 45(@)(@@) % ويسلب نحر الأفق حلية شهبه % فيغنيه عنها في خلائقه الزهر % 46(@)(@@) % سحاب إذا ما جاء يوما تنورت % % رياض الأماني البيض بالورق الصفر % 47(@)(@@) % بوارقه بيض الحديد لدى الوغى % % ووابله في سلمه خالص التبر % 48(@)(@@) % له فطنة يوم القضا عند لبسه % تفرق ما بين السلافة والسكر % 49(@)(@@) % وعزم يذيب الراسيات إذا سطا % % فتجري كما يجري السحاب من الذعر % 50(@)(@@) % وعدل بلا نار وضرب يكاد أن % يقوم فيه الإعوجاج من البتر % PageV01P226 51(@)(@@) % وسخط لو أن النحل ترعى قتاده % لمجته من أفواهها سائل الصبر % 52(@)(@@) % ولطف لو ان الرقش فيه ترشفت % لبدل منها السم بالسكر المصري % % 53(@)(@@) % يعيد رفات المعتفين كأنما % % تفجر في راحاته مورد الخضر % 54(@)(@@) % إذا مر ذكر الفاخرين فذكره % كفاتحة القرآن في أول الذكر % 55(@)(@@) % فيا ابن علي وهي دعوة مخلص % لدولتكم بالسر منه وبالجهر % 56(@)(@@) % لقد زادت الأيام فيك مسررة % % وفاق على وجه العلا رونق البشر % 57(@)(@@) % وعزت بك الأيام حتى كأنما % % لياليك فيها كلها ليلة القدر % 58(@)(@@) % ففي يدك اليمنى المنية والمنى % % ويمن لمن يبغي الأمان من الفقر % 59(@)(@@) % فلا برحت فيك العلا ذات بهجة % ولازال فيك المجد مبتسم الثغر % PageV01P227 البحر : بسيط تام 1(@)(@@) % لله قوم بأكناف الحمى نزلوا % % هم الأحبة إن صدوا وإن وصلوا 
ms77	 % % 2(@)(@@) % ودر درهم من جيرة معهم % لم يبرح القلب إن ساروا وإن نزلوا % % 3(@)(@@) % جعلتهم لي ولاة وارتضيت بما % % يقضون في الحب إنجاروا وإن عدلوا % % 4(@)(@@) % هم هم سادتي رقوا قسوا عطفوا % % جفوا وفوا خلفوني أنجزوا مطلوا % % 5(@)(@@) % ودوا فلو هجروا زاروا صفوزا كدروا % % قد حسن الحب عندي كلما فعلوا % % 6(@)(@@) % رعيا لماضي زمان فزت فيه بهم % وحبذا بالحمى أيامنا الأول % 7(@)(@@) % عصر كأن الليالي فيه بيض دمى % لعس الشفاه وأوقات اللقا قبل % 8(@)(@@) % إذا الرواة رووا عنه لنا خبرا % كأنهم نقلونا بالذي نقلوا % % 9(@)(@@) % كم في القباب لديهم من محجبة % في الحسن والعز يضرب المثل % 10(@)(@@) % بكر هي الشمس في إشراق بهجتها % % لو لم يجن سناها فرعها الجثل % PageV01P228 11(@)(@@) % ودمية القصر لولا سمط منطقها % % وظبية القفر لولا الحلي والعطل % 12(@)(@@) % سيان بيض ثناياها إذا ضحكت % ومبسم البرق لولا النظم والرتل % 13(@)(@@) % يبدو الصباح فيستحي إذا سفرت % عن المحيا فيعلو وجهه الخجل % 14(@)(@@) % تختال في السعي سكرا وهي صاحية % فتنقض الصبر منها وهي تنتقل % 15(@)(@@) % تغزو القلوب بلحظيها ومقلتها % % لولا النعاس لقلنا جفنها خلل % 16(@)(@@) % أفديهم من سراة في جواشنهم % وفي البراقع منهم تلتظي شعل % 17(@)(@@) % فرسان طعن وضرب غير أنهم % أمضى سلاحهم القامات والمقل % 18(@)(@@) % شوس على الشوس بالبيض القاق سط % % وبالجفون على أهل الهوى حملوا % % 19(@)(@@) % في غمد كل هزبر من ضراغمهم % وعين كل مهاة كامن أجل % 20(@)(@@) % لم ادر من قبل ألقى سود أعينهم % أن المنية من أسمائها الكحل % PageV01P229 21(@)(@@) % كلا ولا خلت لولا حلي خردهم % % أن الدنانير مما يثمر الأسل % 22(@)(@@) % بالبيض قد كللوا أقمارهم وعلى % % شموسهم بالدياجي تضرب الكلل % 23(@)(@@) % صباحهم من وجوه البيض منفلق % وليلهم من قرون العين منسدل % 24(@)(@@) % صانوا من الدر ما حازت مباسمهم % وماحووا منه في راحاتهم بذلوا % % 25(@)(@@) % سود الذوائب والأحداق تحسبهم % تعمموا بسواد الليل واكتحلوا % % 26(@)(@@) % يروق في أسدهم نظم القريض وفي % % غزلا نهم يحسن التشبيب والغزل % 27(@)(@@) % تمسي القلوب ضيوفا في منازلهم % ولا لهن سوى نيرانهم نزل % 28 
ms78	(@)(@@) % هم الأكارم إلا أنهم عرب % عند الكرائم منهم يحسن البخل % 29(@)(@@) % أما ولدن تثنت في مناطقهم % تحت الحديد وقضب فوقها حلل % 30(@)(@@) % وبيض حبات در بعضها لفظوا % % وبعضهن لأعناق الدمى جعلوا % % PageV01P230 31(@)(@@) % لولا عيون وقامات بنا فتكت % لم نخش من وقع ما سلوا وما قتلوا % % 32(@)(@@) % لا أطلع الله فجرا في مفارقهم % ولا انجلى ليلها عنهم ولا أفلوا % % 33(@)(@@) % وا صحت من سلاف الدل أعينهم % ولا سرى في سواها منهم الكسل % 34(@)(@@) % لو لا هواهم ما أبلى الضنى جسدي % ولا شجتني رسوم الدار والطلل % 35(@)(@@) % ولا تفرق قلبي بالرسوم كما % % تفرقت من علي في الورى الخول % 36(@)(@@) % الموسوي الذي مشكاة نسبته % أرحامها بشهاب الطور تتصل % 37(@)(@@) % كريم نفس تزان المكرمات به % ومنه تنشأ بالدنيا وتنتقل % 38(@)(@@) % طود لو أن سرنديبا تبدله % لساكني الحوز بالراهون ما قبلوا % % 39(@)(@@) % ولو إلى أرضه يهوي الهلال دجى % لم ترضه أنه من نعلها بدل % 40(@)(@@) % قرن يميل إلى نحو الظبا شغفا % كأنهن لديه أعين نجل % PageV01P231 41(@)(@@) % يغشى العدا مثل ماضيه وعامله % يهتز بشرا ويثني عطفه الجذل % 42(@)(@@) % في طرف هنديه من ضربه رمد % وفي عواليه من خمر الطلا ثمل % 43(@)(@@) % له سيوف إذا ما النصر أضحكها % % تبكي الرقاب وتنعي نفسها الظلل % 44(@)(@@) % جراحها وعيون الصب واحدة % لا تلك ترقى ولا هاتيك تندمل % 45(@)(@@) % بيض الجوانب كالأنهار من لبن % تظنها بالوفا يجري بها العسل % 46(@)(@@) % حليف بأس إذا اشتدت حميته % لولا ندى راحتيه كاد يشتعل % 47(@)(@@) % يغزو العدو على بعد فيدركه % كالنجم يسري إليه والدجى جمل % 48(@)(@@) % يكاد كل مكان حل ساحته % يقفوه شوقا إليه حين يرتحل % 49(@)(@@) % تلقى مراقد نور في مواطئه % كأنه بأديم الشمس منتعل % 50(@)(@@) % لا يطمع الخصم فيه لين جانبه % فقد تلين الأفاعي والقنا الذبل % PageV01P232 51(@)(@@) % ولا يغر العدا ما فيه من كرم % فمحدث الصاعقات العارض الهطل % 52(@)(@@) % يمد نحو العلا والمكرمات يدا % خطوطها للمنايا والمنى سبل % 53(@)(@@) % يد إلى كل مصر من أناملها % % تسري الأيادي وفيها ينزل الأمل % 54(@)(@@) % كأن خاتمه 
ms79	 يوم النوال بها % % قوس السحاب الغوادي حين حا % % 55(@)(@@) % ز الكمال صبيا منذ مولده % وقام بالفضل طفلا قبل ينفصل % 56(@)(@@) % نفس من القدس في ذات مجردة % بالعزف جاز عليها يصدق الرجل % 57(@)(@@) % ما لاح فوق سرير مثله قمر % ولا تمطى جوادا قبله جبل % 58(@)(@@) % ولا تنسك زهدا غيره أسد % ولا تدين في دين الظبا بطل % 59(@)(@@) % هل عانق الشمس إلا سيفه فلق % واستغرق البحر إلا درعه وشل % 60(@)(@@) % باهت مناقبه الدنيا به فعلا % % قدرا على سائر الأيام واستفلوا % % PageV01P233 61(@)(@@) % حكوه خلقا وما حازوا خلائقه % والناس كالوحش منها الليث % % 62(@)(@@) % أنى يحاول فيه مدع صفة % وهل يحصل طيب النرجس البصل % 63(@)(@@) % ما كل ذي كرم تحوي مكارمه % والدر في كل بحر ليس يحتمل % % 64(@)(@@) % لديه أغلى لباس المرء أخشنه % وأحسن الخز والديباج مبتذل % 65(@)(@@) % لو باللباس بدون البأس مفتخر % فاق البزاة بحسن الملبس الحجل % 66(@)(@@) % يا ابن الأسود الأولى يوما إذا حملت % بالأفق يشفق منها الثور والجمل % 67(@)(@@) % زانت بأبنائك الدنيا وفيك ولو % لم يولدوا لم تجد كفؤا لها الدول % 68(@)(@@) % أنتم شموس ضحاها بل وأنجمها % % ليلا وأوقاتها الأسحار والأصل % 69(@)(@@) % عنكم ومنكم رواة المجد قد أخذوا % % علم المعالي ولولاكم به جهلوا % % 70(@)(@@) % يدرون أنكم حقا أئمتهم % ويعلمون يقينا أنكم قبل % PageV01P234 71(@)(@@) % إذا العياء كساكم فضل ملبسه % فأي فخر عليكم ليس يشتمل % 72(@)(@@) % أدواكم لسقيم المجد عافية % لكنهن لأبحار الثنا علل % 73(@)(@@) % كأنما خلطت بالطين طينتكم % فنبتها ليس إلا الورد والنفل % 74(@)(@@) % مولاي ذا الصوم أبقى أجره ومضى % % لديك والفطر والإقبال مقتبل % 75(@)(@@) % واسعد بعودة عيد عاد فيه لنا % % فيك السرور وزال الهم والوجل % 76(@)(@@) % عيد تشرف يا ابن الطاهرين بكم % لذا به ملة الإسلام تحتفل % 77(@)(@@) % فاق الزمان كما فقت الملوك فما % % كلاكما سيد في قومه جلل % 78(@)(@@) % واستجل طلعة فطر فوق غرته % هلال سعد سناه منك منتحل % 79(@)(@@) % شيخا تأتاك كالعرجون منحنيا % وأنت كالرمح رطب العود معتدل % 80(@)(@@) % رآك بعد النوى ليلا فعادله % عمر الشبيبة غضا وهو مكتحل % PageV01P235 81 
ms80	(@)(@@) % ولا برحت مطاع الأمر مقتدرا % يجري القضاء بما تقضي ويمتثل % PageV01P236 البحر : كامل تام 1(@)(@@) % ضحكت فبان لنا عقود جمان % فجلت لنا فلق الصباح الثاني % % 2(@)(@@) % وتزحزحت ظلم البراقع عن سنى % % وجناتها فتثلث القمران % 3(@)(@@) % وتحدثت فسمعت لفظا نظقه % سحر ومعناه سلافة حان % 4(@)(@@) % ورنت فجرحت القلوب بمقلة % طرف السنان وطرفها سيان % 5(@)(@@) % وترنمت فشدت حمائم حليها % % وكذاك دأب حمائم الأغصان % 6(@)(@@) % لم تلق غصنا قبلها من فضة % يهتز في ورق من العقبان % 7(@)(@@) % عربية سعد العشيرة أصلها % % والفرع منها من بني السودان % 8(@)(@@) % خود تصوب عند رؤية خدها % % آراء من عكفوا على النيران % 9(@)(@@) % يبدو محياها فلولا نطقها % % لحسبتها وثنا من الأوثان % 10(@)(@@) % لم تصلب القرط البري لغاية % إلا لتنصر دولة الصلبان % PageV01P237 11(@)(@@) % وكذاك لم تضعف جفون عيونها % % إلا لتقوى فتنة الشيطان % 12(@)(@@) % خلخالها يخفي الأنين وقرطها % % قلق كقلب الصب في الخفقان % 13(@)(@@) % تهوى الأهلة أن تصاغ أساورا % لتحل منها في محل الجاني % % 14(@)(@@) % بخمارها غسق وتحت لثامها % % شفق وفي أكمامها الفجران % 15(@)(@@) % سبحان من بالخد صور خالها % % فأزان عين الشمس بالإنسان % 16(@)(@@) % أمر الهوى قلبي يهيم بحبها % % فأطاعه ونهيته فعصاني % % 17(@)(@@) % هي في غدير الشهد تخزن لؤلؤا % وأجاج دمعي مخرج المرجان % 18(@)(@@) % كثرت علي العاذلون بها فلو % عددتهم ساووا ذنوب زماني % % 19(@)(@@) % يا قلب دع قول الوشاة فإنهم % لو أنصفوك لكنت أعذر جان % 20(@)(@@) % أصحاب موسى بعده في عجلهم % فوق التراقي أو على التيجان % PageV01P238 21(@)(@@) % عذب العذاب بها لدي فصحتي % % سقمي وعزي في الهوى بهواني % % 22(@)(@@) % لله نعمان الأراك فطالما % % نعمت به روحي على نعمان % 23(@)(@@) % وسقى الحيا بمنى كرام عشيرة % كفلوا صيانتها بكل أمان % 24(@)(@@) % أهل الحمية لا تزال بدورهم % تحمي الشموس بأنجم الخرصان % 25(@)(@@) % أسد تخوض السابغات رماحهم % خوض الأفاعي راكد الغدران % 26(@)(@@) % تروى بهم ربد كأن سهامهم % وهبت لهن قوادم العقبان % 27(@)(@@) % كم من مطوفة بهم تشدو على % % رطب الغصون ويابس العيدان % 28(@)(@@) % لانت معاطفهم وطاب أريجهم % % فكأنهم قضب من الريحان % 29(@)(@@) % من كل واضحة كأن 