ms421	 بن سعد بن الحارث.(@)(@@)(@@)(@@) ||| AUTO واقد بن عبد الله بن عبد مناف اليربوعي(@)(@@) له صحبة.(@)(@@)(@@)(@@) || AUTO باب الهاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الهاء:(@)(@@)(@@)(@@) ||| AUTO هانئ بن نيار بن عقبة بن عبيد بن عمرو بن كلاب(@)(@@) حليف لبني مجدعة، ويقال: حليف لبني حارثة بن الحارث بن الخزرج، كنيته أبو بردة الأسلمي، شهد بدرا، وهو خال البراء بن عازب، مات سنة خمس وأربعين.(@)(@@)(@@)(@@) ||| AUTO هانئ أبو مالك(@)(@@) قدم على النبي صلى الله عليه وسلم من اليمن، فأسلم، ودعا له النبي صلى الله عليه وسلم ومسح رأسه، ثم خرج إلى الشام مع يزيد بن أبي سفيان، فنزلها إلى أن مات بدمشق سنة ثمان وستين، وهو جد خالد بن يزيد بن أبي مالك.(@)(@@)(@@)(@@) ||| AUTO هانئ بن يزيد الحارثي(@)(@@) والد شريح بن هانئ، قال له النبي صلى الله عليه وسلم: " هل لك من ولد؟ " قال: نعم شريح، وعبد الله، ومسلم، قال: " فمن أكبرهم؟ " قال: شريح، قال: " أنت أبو شريح ".(@)(@@)(@@)(@@) ||| AUTO هشام بن عامر الأنصاري(@)(@@) بن عم أنس بن مالك، والد سعد PageV01P002 [ج 1: ص 464] ابن هشام، قتل يوم أحد شهيدا، وسعد بن هشام بن عامر سكن البصرة.(@)(@@)(@@)(@@) ||| AUTO هشام بن حبيش الخزاعي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO هشام بن العاص بن وائل بن هاشم بن سعيد بن سهم السهمي(@)(@@) أخو عمرو بن العاص، قال النبي صلى الله عليه وسلم: ابنا العاص مؤمنان هشام، وعمرو، قتل هشام بن العاص بأجنادين، وكان من مهاجرة الحبشة، وأمه أم حرملة بنت هشام بن المغيرة بن عبد الله بن عمرو بن مخزوم، وهو أصغر سنا من أخيه عمرو بن العاص.(@)(@@)(@@)(@@) ||| AUTO هشام بن حكيم بن حزام بن خويلد بن أسد بن عبد العزى بن قصي القرشي(@)(@@) له صحبة، حديثه عند أهل المدينة والشام،(@)(@@) (80) -[1: 464] سمع النبي صلى الله عليه وسلم يقول: " إن الله يعذب يوم القيامة الذين يعذبون الناس في الدنيا ". هكذا قال هشام بن عروة، عن أبيه، عن هشام بن حكيم 
ms422	 بن حزام. وقال عمرو بن دينار: عن أبي يحيى، عن خالد بن حكيم بن حزام. وحديث هشام بن عروة أشبه، أمه زينب بنت العوام بن خويلد(@)(@@)(@@)(@@) ||| AUTO هشام بن عتبة بن زمعة القرشي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO هبيب بن مغفل الطفاوي(@)(@@) له صحبة، عداده في أهل مصر.(@)(@@)(@@)(@@) ||| AUTO هلال بن المعلى بن لوذان بن حارثة بن زيد بن ثعلبة بن عدي بن مالك بن زيد مناة بن حبيب بن عبد حارثة(@)(@@) بدري، استشهد يوم بدر.(@)(@@)(@@)(@@) ||| AUTO هلال بن أمية بن واقف بن امرئ القيس بن مالك بن الأوس الأنصاري الواقفي(@)(@@) بدري.(@)PageV01P002(@)(@@) [ج 1: ص 465](@)(@@)(@@)(@@) ||| AUTO هلال بن الحارث أبو الحمراء(@)(@@) خادم رسول الله صلى الله عليه وسلم سكن حمص، وقد قيل: هانئ بن الحارث سمعت مكحولا، يقول: سمعت يحيى بن عبد الله البيروتي، يقول: سمعت جعفر بن أبان، يقول: سمعت يحيى بن معين، يقول: أبو الحمراء صاحب رسول الله صلى الله عليه وسلم اسمه هلال بن الحارث.(@)(@@)(@@)(@@) ||| AUTO هند بن أسماء بن حارثة بن هند الأسلمي(@)(@@) بعثه النبي صلى الله عليه وسلم إلى قومه يوم عاشوراء، فقال: مرهم أن يصوموا هذا اليوم، حديثه عند ابنه حبيب بن هند.(@)(@@)(@@)(@@) ||| AUTO هند بن هند بن أبي هالة التميمي(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO هاشم بن عتبة بن أبي وقاص(@)(@@) ابن أخي سعد، له صحبة: قتل يوم صفين، تقدم ذكره، ومن زعم أنه هشام بن عتبة فقد وهم.(@)(@@)(@@)(@@) ||| AUTO الهرماس بن زياد الباهلي(@)(@@) من قيس عيلان، عداده في أهل اليمامة، رأى النبي صلى الله عليه وسلم يخطب على ناقته العضباء يوم الأضحى، والعضباء التي يقطع من أذنها النصف فأكثر والقصوى التي يقطع من أذنها الربع،(@)(@@) (81) -[1: 465] ثنا أبو خليفة، قال: ثنا أبو الوليد، قال: ثنا عكرمة بن عمار وذكر، عن الهرماس بن زياد الباهلي، قال: " أبصرت رسول الله صلى الله عليه وسلم وإني مردفي وراء أبي على جمل وأنا صبي صغير فرأيت رسول الله صلى الله عليه وسلم يخطب الناس على ناقته العضباء بمنى(@)(@@)(@@)(@@) ||| AUTO الهرماس 
ms423	 بن حبيب العنبري(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO هالة بن أبي هالة التميمي بن خديجة(@)(@@) امرأة رسول الله صلى الله عليه وسلم له صحبة.(@)PageV01P002(@)(@@) [ج 1: ص 466](@)(@@)(@@)(@@) ||| AUTO هنيدة بن مغفل الغفاري(@)(@@) له صحبة، سكن مصر، أحسبه الذي يقال له: هبيب.(@)(@@)(@@)(@@) ||| AUTO هنيدة بن خالد الخزاعي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO هند بن حارثة الأسلمي(@)(@@) له صحبة، أخو أسماء بن حارثة، مات في ولاية معاوية.(@)(@@)(@@)(@@) ||| AUTO هزال الأسلمي أبو نعيم بن هزال(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO هلال الأسلمي(@)(@@) أبو أم بلال بنت هلال الأسلمية.(@)(@@)(@@)(@@) ||| AUTO هداج أبو عبد الله أدرك الجاهلية(@)(@@) يروي عنه ابنه.(@)(@@)(@@)(@@) || AUTO وممن روى صلى الله عليه وسلم من النساء ممن ابتدأ اسمها على الهاء(@)(@@)(@@)(@@) ||| AUTO هند أم سلمة(@)(@@) زوج النبي صلى الله عليه وسلم وأم المؤمنين، اسمها PageV01P002 [ج 1: ص 467] هند بنت أبي أمية بن المغيرة بن عبد الله بن عمر بن مخزوم، تقدم ذكرنا لها، واسم أبي أمية سهيل، ماتت بعد الحسين بن علي بن أبي طالب في آخر سنة إحدى وستين حين جاءها نعيه.(@)(@@)(@@)(@@) ||| AUTO هند بنت أبي سفيان بن حرب بن أمية(@)(@@) لها صحبة، أمها صفية بنت أبي عمرو بن أمية.(@)(@@)(@@)(@@) ||| AUTO هند بنت أثاثة بن عباد بن المطلب بن عبد مناف(@)(@@) أخت مسطح من المهاجرات.(@)(@@)(@@)(@@) ||| AUTO هند بنت عتبة بن ربيعة بن عبد شمس(@)(@@) امرأة أبي سفيان بن حرب، أم معاوية، أمها صفية بنت أمية بن حارثة بن الأوقص بن مرة بن هلال بن فالج بن ذكوان.(@)(@@)(@@)(@@) ||| AUTO أم هانئ بنت أبي طالب بن عبد المطلب بن هاشم(@)(@@) أخت علي، اسمها هند، ويقال: فاختة، وقد قيل: عاتكة.(@)(@@)(@@)(@@) ||| AUTO همينة بنت خالد بن أسعد بن عامر بن بياضة(@)(@@) امرأة خالد بن سعيد بن العاص، إسلامها قديم.(@)(@@)(@@)(@@) || AUTO باب الياء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الياء:(@)(@@)(@@)(@@) ||| AUTO يعلى بن مرة الثقفي العامري(@)(@@) جد عمر بن عبد الله بن يعلى بن مرة، كنيته أبو المرازم، سكن الكوفة، ومن قال: إنه يعلى 
ms424	 بن سيابة فقد وهم.(@)(@@)(@@)(@@) ||| AUTO يعلى بن أمية بن أبي عبيدة بن همام بن الحارث بن زيد بن مالك ابن حنظلة الثقفي PageV01P002 [ج 1: ص 468](@)(@@) حليف لبني نوفل بن عبد مناف، وقد قيل: لبني عبد شمس عداده في أهل مكة، وهو الذي يقال له: يعلى بن منية أمية أبوه ومنية أمه ومنية هي بنت غزوان بن جابر بن نسيب بن وهب الحارثي امرأة من بني تميم مولاة لقريش.(@)(@@)(@@)(@@) ||| AUTO يعلى بن سيابة(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن ثابت بن الضحاك بن زيد بن لوذان بن عمرو الأنصاري(@)(@@) من بني مالك بن النجار أخو زيد بن ثابت، قتل يوم اليمامة سنة ثنتي عشرة في خلافة أبي بكر الصديق، وقد قيل: إنه مات في طريقها، وكان أكبر من زيد بن ثابت.(@)(@@)(@@)(@@) ||| AUTO يزيد بن ثابت الأنصاري من بني دينار بن النجار(@)(@@) أخو خزيمة بن ثابت.(@)(@@)(@@)(@@) ||| AUTO يزيد بن عبد الله بن الجراح(@)(@@) أخو أبي عبيدة بن الجراح، له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن الأسود الخزاعي العامري السوائي(@)(@@) والد جابر بن يزيد بن الأسود، له صحبة، عداده في أهل مكة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن الحارث بن قيس بن مالك بن أحمر(@)(@@) وهو الذي يقال له: يزيد بن قسحم، استشهد ببدر، ألقى التميرات من يده، وقاتل حتى قتل.(@)PageV01P002(@)(@@) [ج 1: ص 469](@)(@@)(@@)(@@) ||| AUTO يزيد بن نعامة الضبي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن مالك أبو سبرة الجعفي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن أسد بن كرز البجلي القسري(@)(@@) جد خالد بن عبد الله القسري، والي العراق، قال له النبي صلى الله عليه وسلم: " يا يزيد بن أسد أحب للناس ما تحب لنفسك " صحابي، سكن الشام، لا يعرف له إلا هذا الحديث الواحد.(@)(@@)(@@)(@@) ||| AUTO يزيد بن معاوية البكائي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن شيبان(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن مريع الأنصاري(@)(@@) من بني دينار بن النجار، له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن السكن الأنصاري(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن خارجة الأنصاري(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن أبي سفيان بن حرب(@)(@@) أخو 
ms425	 معاوية، وكان من أمراء الأجناد بالشام بعد أبي عبيدة بن الجراح، وكان أبوه تحت رايته بالشام، كنيته أبو خالد، أمه زينب بنت نوفل بن خلف من بني كنانة، مات في طاعون عمواس في الشام سنة ثمان عشرة، PageV01P002 [ج 1: ص 470] وكان من أمراء الأجناد أيام أبي بكر، فلما مات ولى عمر بن الخطاب أخاه معاوية مكانه.(@)(@@)(@@)(@@) ||| AUTO يزيد بن سيف بن حارثة اليربوعي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن عامر السوائي أبو حاجر(@)(@@) كان مع المشركين يوم حنين، ثم أسلم.(@)(@@)(@@)(@@) ||| AUTO يزيد بن الأخنس السلمي(@)(@@) له صحبة، روى عنه أبو أمامة الباهلي.(@)(@@)(@@)(@@) ||| AUTO يزيد بن سعيد بن ثمامة الكندي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن رقيش(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن شجرة الرهاوي(@)(@@) يقال: إن له صحبة، قتل غازيا سنة خمس وخمسين.(@)(@@)(@@)(@@) ||| AUTO يزيد بن سلمة الجعفي(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن ثعلبة الأنصاري(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يزيد بن عتر النميري(@)(@@) وفد إلى النبي صلى الله عليه وسلم يزيد بن بهرام(@)(@@) (82) -[1: 470] وقد قال سعيد بن عبد العزيز، عن يزيد بن نمران، قال: رأيت رجلا بتبوك مقعدا، قال: مررت بين يدي رسول الله صلى الله عليه وسلم وهو يصلي، فقال: " اللهم اقطع أثره " فما مشيت عليهما بعد، يقال: إن اسم المقعد هذا يزيد بن بهرام PageV01P002 [ج 1: ص 471](@)(@@)(@@)(@@) ||| AUTO هلب(@)(@@) والد قبيصة بن هلب، اسمه يزيد بن قنافة الطائي، له صحبة.(@)(@@)(@@)(@@) ||| AUTO يوسف بن عبد الله بن سلام(@)(@@) قال: رأيت النبي صلى الله عليه وسلم أخذ كسرة من خبز شعير فوضع عليها تمرة، وقال: " هذه إدام هذه " إلا أني لست بالمعتمد على إسناد خبر يوسف، ومات يوسف بن عبد الله بن سلام في خلافة عمر بن عبد العزيز، كنيته أبو يعقوب.(@)(@@)(@@)(@@) ||| AUTO يحيى بن عمير بن الحارث بن لبدة بن ثعلبة بن الحارث بن حرام(@)(@@) أبوه بدري، وله صحبة.(@)(@@)(@@)(@@) ||| AUTO يحيى بن هند بن حارثة(@)(@@) من أصحاب الحديبية.(@)(@@)(@@)(@@) ||| AUTO يحيى بن أسعد بن زرارة الأنصاري(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO يسار مولى رسول الله صلى 
ms426	 الله عليه وسلم(@)(@@) أصابه رسول الله صلى الله عليه وسلم في غزوة من غزواته فأعتقه، وهو الذي قتله العرنيون الذين أغاروا على لقاح رسول الله صلى الله عليه وسلم وقطعوا يديه ورجليه، وسملوا عينه، وغرزوا الشوك في لسانه، حتى مات.(@)(@@)(@@)(@@) ||| AUTO يسار أبو ليلى(@)(@@) من الأنصار، من بني عمرو بن عوف، وهو والد عبد الرحمن بن أبي ليلى، سكن الكوفة، وقد قيل: إن اسم أبي ليلى داود بن بلال بن أحيحة بن الجلاح.(@)(@@)(@@)(@@) ||| AUTO يسار بن عبد أبو عزة الهذلي من بني لحيان بن هذيل(@)(@@) سكن البصرة، وحديثه عند أبي المليح.(@)PageV01P002(@)(@@) [ج 1: ص 472](@)(@@)(@@)(@@) ||| AUTO يسار بن سبع أبو الغادية الجهني(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO ياسر بن سويد(@)(@@) بعثه النبي صلى الله عليه وسلم في سرية، ودعا له ولامرأته، حديثه عند ابنه مسرع بن ياسر من حديث ابنه عبد الله بن مسرع، وهؤلاء من أهل الرهاء.(@)(@@)(@@)(@@) ||| AUTO يعمر أبو أبي خزامة(@)(@@) من بني الحارث بن سعد، له صحبة.(@)(@@)(@@)(@@) ||| AUTO يسير(@)(@@) شيخ سمع النبي صلى الله عليه وسلم يقول: " لا يأتيك من الحياء إلا الخير " روى عنه حميد بن عبد الرحمن بن عوف، ولكن في إسناد خبره داود الأودي.(@)(@@)(@@)(@@) ||| AUTO يزداد بن فساة(@)(@@) يقال: إن له صحبة، إلا أني لست أحتج بخبر زمعة بن صالح.(@)(@@)(@@)(@@) ||| AUTO يعيش بن طخفة الغفاري(@)(@@) له صحبة، سكن الصفر.(@)(@@)(@@)(@@) ||| AUTO يسيرة(@)(@@) امرأة من المهاجرات، حديثها واعقدن بالأنامل فانهن مسئولات ومستنطقات.(@)(@@)(@@)(@@) || AUTO باب الكنى وممن روى عن النبي صلى الله عليه وسلم ممن يعرف بالكنى:(@)(@@)(@@)(@@) ||| AUTO أبو سعيد بن المعلى بن لوذان بن حارثة بن عدي بن زيد بن ثعلبة بن زيد مناة بن حبيب بن عبد حارثة بن مالك بن غضب بن جشم الأنصاري(@)(@@) مات سنة أربع PageV01P002 [ج 1: ص 473] وسبعين، وهو أخو هلال بن المعلى بن لوذان الذي، قتل ببدر، وقد قيل: إن اسمه رافع وقد ذكرناه في باب الراء.(@)(@@)(@@)(@@) ||| AUTO أبو سفيان بن وهب بن ربيعة بن أسد بن صهيب بن مالك بن كبير بن غنم(@)(@@) بدري. 
ms427	(@)(@@)(@@)(@@) ||| AUTO أبو بردة بن قيس(@)(@@) أخو أبي موسى الأشعري.(@)(@@)(@@)(@@) ||| AUTO أبو أمامة بن ثعلبة الحارثي(@)(@@) والد عبد الله بن أبي أمامة.(@)(@@)(@@)(@@) ||| AUTO أبو بشير الساعدي المازني الأنصاري(@)(@@)(@@)(@@) ||| AUTO أبو مويهبة(@)(@@) مولى رسول الله صلى الله عليه وسلم أبو السمح،(@)(@@)(@@)(@@) ||| AUTO خادم رسول الله صلى الله عليه وسلم أبو ثعلبة الأشجعي.(@)(@@)(@@)(@@) ||| AUTO أبو جندل بن سهيل بن عمرو بن عبد شمس بن عبد ود(@)(@@) المقيد في ذات الله، مات في طاعون عمواس سنة ثمان عشرة، وأمه فاختة بنت عامر بن نوفل بن عبد مناف.(@)(@@)(@@)(@@) ||| AUTO أبو تحيا الأنصاري(@)(@@)(@@)(@@) ||| AUTO أبو المليح بن عروة بن مسعود بن معتب(@)(@@) له صحبة، أمه رائطة بنت عمرو بن معتب.(@)PageV01P002(@)(@@) [ج 1: ص 474](@)(@@)(@@)(@@) ||| AUTO أبو حثمة العدوي(@)(@@)(@@)(@@) ||| AUTO أبو سنان بن محصن(@)(@@) أخو عكاشة بن محصن.(@)(@@)(@@)(@@) ||| AUTO أبو حاضر(@)(@@) حديثه عند أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO أبو عنبة الخولاني(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو خلاد(@)(@@) حديثه عند أهل الشام.(@)(@@)(@@)(@@) ||| AUTO أبو عسيب مولى رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) ||| AUTO أبو الشموس البلوي،(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو الدحداح الأنصاري. أبو عبد الرحمن الجهني،(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو نملة الأنصاري.(@)(@@)(@@)(@@) ||| AUTO أبو مريم السلولي،(@)(@@) له صحبة.(@)PageV01P002(@)(@@) [ج 1: ص 475](@)(@@)(@@)(@@) ||| AUTO أبو ريمة الأنصاري.(@)(@@)(@@)(@@) ||| AUTO أبو كاهل الأسدي،(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو الرداد الليثي(@)(@@) كان، يسكن المدينة، من بني ليث.(@)(@@)(@@)(@@) ||| AUTO أبو نحيلة البجلي،(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو خراش السلمي،(@)(@@) ويقال: الأسلمي، واسمه حدرد.(@)(@@)(@@)(@@) ||| AUTO أبو أذينة الصدفي.(@)(@@)(@@)(@@) ||| AUTO أبو شهم،(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو الحجاج الثمالي.(@)(@@)(@@)(@@) ||| AUTO أبو حميضة المزني،(@)(@@) له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو سيلان(@)(@@) يقال: إن له صحبة.(@)(@@)(@@)(@@) ||| AUTO أبو خزيمة بن أوس بن أصرم بن زيد بن ثعلبة بن غنم،(@)(@@) بدري.(@)(@@)(@@)(@@) ||| AUTO أبو لاس الخزاعي.(@)PageV01P002(@)(@@) [ج 1: ص 476](@)(@@)(@@)(@@) ||| AUTO أبو شيبة الأنصاري الخدري.(@)(@@)(@@)(@@) ||| AUTO أبو مجيبة.(@)(@@)(@@)(@@) ||| AUTO أبو حاتم المزني.(@)(@@)(@@)(@@) ||| AUTO أبو رهم الغفاري.(@)(@@)(@@)(@@) ||| AUTO أبو ليلى الخزاعي.(@)(@@)(@@)(@@) ||| AUTO أبو هند الأشجعي.(@)(@@)(@@)(@@) ||| AUTO أبو طريف الهذلي.(@)(@@)(@@)(@@) ||| AUTO أبو زهير بن معاذ الثقفي،(@)(@@)(@@)(@@) ||| AUTO والد بن 
ms428	 أبي زهير(@)(@@) كان في الوفد.(@)(@@)(@@)(@@) ||| AUTO أبو أمية أخو بني جعدة.(@)(@@)(@@)(@@) ||| AUTO أبو صخر العقيلي.(@)(@@)(@@)(@@) ||| AUTO أبو بهيسة الفزاري.(@)(@@)(@@)(@@) ||| AUTO أبو خيرة العبدي الصباحي.(@)PageV01P002(@)(@@) [ج 1: ص 477](@)(@@)(@@)(@@) ||| AUTO أبو سلمى(@)(@@) راعي رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) || AUTO وممن روى عن رسول الله صلى الله عليه وسلم من النساء من تعرف بالكنية ولم يعرف لها اسم:(@)(@@)(@@)(@@) ||| AUTO أم كلثوم بنت عقبة بن أبي معيط بن أبي عمرو بن أمية بن عبد شمس بن عبد مناف،(@)(@@) كانت تحت زيد بن حارثة، ثم تزوجها عبد الرحمن بن عوف، وهي أم إبراهيم، وحميد ابني عبد الرحمن بن عوف، ثم تزوجها الزبير بن العوام، ثم تزوجها عمرو بن العاص.(@)(@@)(@@)(@@) ||| AUTO أم كلثوم بنت عتبة بن ربيعة بن عبد شمس،(@)(@@) لها صحبة.(@)(@@)(@@)(@@) ||| AUTO أم كلثوم بنت سهيل بن عمرو،(@)(@@) يقال: إن لها صحبة.(@)(@@)(@@)(@@) ||| AUTO أم قيس بنت محصن بن حرثان بن قيس بن مرة بن كبير بن غنم،(@)(@@) أخت عكاشة بن حصن.(@)(@@)(@@)(@@) ||| AUTO أم عبد الله(@)(@@) من بني زهرة.(@)(@@)(@@)(@@) ||| AUTO أم أسيد الأنصارية.(@)(@@)(@@)(@@) ||| AUTO أم كرز الخزاعية،(@)(@@) لها صحبة.(@)(@@)(@@)(@@) ||| AUTO أم أيوب بنت قيس بن سعد بن قيس بن عمرو بن امرئ القيس الخزرجي.(@)(@@)(@@)(@@) ||| AUTO أم بشر بنت البراء بن معرور.(@)PageV01P002(@)(@@) [ج 1: ص 478](@)(@@)(@@)(@@) ||| AUTO أم مبشر امرأة زيد بن حارثة،(@)(@@) روى عنها جابر بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO أم إسحاق الغنوية.(@)(@@)(@@)(@@) ||| AUTO أم رومان،(@)(@@) أم عائشة، امرأة أبي بكر الصديق، وهي بنت عمير بن عبد مناف بن دهمان بن غنم بن مالك بن كنانة.(@)(@@)(@@)(@@) ||| AUTO أم فروة بنت أبي قحافة،(@)(@@) أخت أبي بكر، لها صحبة.(@)(@@)(@@)(@@) ||| AUTO أم بلال الأسلمية.(@)(@@)(@@)(@@) ||| AUTO أم حفيد بنت الحارث بن حزن،(@)(@@) أخت أم الفضل، لها صحبة.(@)(@@)(@@)(@@) ||| AUTO أم جندب الأزدية.(@)(@@)(@@)(@@) ||| AUTO أم الطفيل،(@)(@@) امرأة أبي بن كعب.(@)(@@)(@@)(@@) ||| AUTO أم سباع بنت كرز الخزاعية.(@)(@@)(@@)(@@) ||| AUTO أم أيمن،(@)(@@) سمعت رسول الله صلى الله عليه وسلم يقول " إنما الأسود لفرجه وبطنه " روى