ms7497	 عن محمد بن يحيى، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 48.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 150، ح 5.(@)(@@) والتهذيب: ج 7، ح 645.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 690.(@)(@@) * وروى عن المرزبان بن عمران، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 2، ح 477 (الإستبصار:(@)(@@) ج 1، ح 1022).(@)(@@) * وروى عن النضر بن سويد.(@)(@@) التهذيب: ج 7، ح 1894.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 32، ح 3، و 7، و ب 53، ح 3.(@)(@@) * وروى عن وهب بن وهب، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 1، ح 83 (الإستبصار: ج 1، ح 134).(@)(@@) * وروى عن يونس بن هشام، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 4، ح 1045.(@)(@@) * وروى عن النوفلي، وروى عنه أحمد.(@)(@@) التهذيب: ج 1، ح 1048، و ج 2، PageV24P331(@)(@@) ح 1129، و ج 3، ح 710، و 742، و ج 5، ح 1693، و ج 7، ح 851، و ج 10، ح 841.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 2، ح 1118، و ج 6، ح 537، و 733، و 788، و ج 7، ح 230، و 736 (الإستبصار: ج 3، ح 416)، و 1257 (الإستبصار: ج 3، ح 661)، و ج 8، ح 639، و 1119، و 1120، و 1181 (الإستبصار: ج 4، ح 163)، و ج 10، ح 177، و 178، و 376 (الإستبصار: ج 4، ح 889)، و ح 422، و 423 (الإستبصار: ج 4، ح 918) و ح 613 و 912.(@)(@@) * وروى عن الشيخ مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 41، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1538.(@)(@@) * وروى مرفوعا، عن ابن أبي يعفور، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1666 (الإستبصار:(@)(@@) ج 3، ح 876).(@)(@@) * وروى مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 30، ح 8.(@)(@@) والتهذيب: ج 1، ح 335 (الإستبصار:(@)(@@) ج 1، ح 371، وفيه، مرفوعة مضمرة).(@)(@@) * وروى مرفوعا، عن زيد الشحام أبي أسامة، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 123، ح 10.(@)(@@) * وروى أحمد بن محمد بن عيسى، عن البرقي أو غيره، عن صفوان.(@)(@@) التهذيب: ج 7، ح 1573.(@)(@@) (البزنطي) * روى عن أبي الحسن عليه 
