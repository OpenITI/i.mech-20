ms201	 %~% عظیم الروم عز الدوله اینجا(@)(@@) 76 یمین عیسی و فخر الحواری %~% امین مریم و کهف النصاری(@)(@@) 77 مسیحا خصلتا قیصر نژادا %~% تورا سوگند خواهم داد حقا(@)(@@) 78 به روح القدس و نفخ روح و مریم %~% به انجیل و حواری و مسیحا(@)(@@) 79 به مهد راستین و حامل بکر %~% به دست و آستین باد مجرا(@)(@@) 80 به بیت المقدس و اقصی و صخره %~% به تقدیسات انصار و شلیخا(@)(@@) 81 به ناقوس و به زنار و به قندیل %~% به یوحنا و شماس و بحیرا(@)(@@) 82 به خمسین و به دنح و لیلة الفطر %~% به عیدالهیکل و صوم العذارا(@)(@@) 83 به پاکی مریم از تزویج یوسف %~% به دوری عیسی از پیوند عیشا(@)(@@) 84 به بیخ و شاخ و برگ آن درختی %~% که آمد میوه‌ش از روح معلا(@)(@@) 85 به ماه تیر کانگه بود نیسان %~% به نخل پیر کانجا گشت برنا(@)(@@) 86 به بانگ و زاری مولو زن از دیر %~% به بند آهن اسقف بر اعضا(@)(@@) 87 به تثلیث بروج و ماه و انجم %~% به تربیع و به تسدیس ثلاثا(@)(@@) 88 ز تثلیثی کجا سعد فلک راست %~% به تربیع صلیبت باد پروا(@)(@@) 89 که بهر دیدن بیت‌المقدس %~% مرا فرمان بخواه از شاه دنیا(@)(@@) 90 ز خط استوا و خط محور %~% فلک را تا صلیب آید هویدا(@)(@@) 91 سزد گر عیسی اندر دیر هرقل %~% کند تسبیح از این ابیات غرا PageV1P0419(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از سر زلف تو بوئی سر به مهر آمد به ما %~% جان به استقبال شد کای مهد جان‌ها تا کجا(@)(@@) 2 این چه موکب بود یارب کاندر آمد شادمان %~% بارگیرش صبح دم بود و جنیبت کش صبا(@)(@@) 3 در میان جان فروشد بر در دل حلقه زد %~% از بن هر موی فریادی برآمد کاندرآ(@)(@@) 4 ما در آب و آتش از فکرت که گوئی آن نسیم %~% باد زلفت بود با خاک جناب پادشا(@)(@@) 5 با غبار صید گاه شاه کز تعظیم هست 
ms202	 %~% ز آهوان مشک ده صد تبتش در یک فضا(@)(@@) 6 صید گاه شاه جان‌ها را چراگاه است ازآنک %~% لخلخه روحانیان بینی در او بعرالظبا(@)(@@) 7 هم در او افعی گوزن آسا شده تریاق‌دار %~% هم گوزنانش چو افعی مهره‌دار اندر قفا(@)(@@) 8 شاه را دیدم در او پیکان مقراضه به کف %~% راست چون بحر نهنگ انداز در نخجیر جا(@)(@@) 9 وحشیان از حرمت دستش سوی پیکان او %~% پای کوبان آمدندی از سر حرص و هوا(@)(@@) 10 خون صید الله اکبر نقش بستی بر زمین %~% جان صید الحمد الله سبحه گفتی در هوا(@)(@@) 11 پیش تیرش آهوان را از غم رد و قبول %~% شیر خون گشتی و خون شیر آن ز خوف این از رجا(@)(@@) 12 تیر چون در زه نشاندی بر کمان چرخ‌وش %~% گفتی او محور همی راند ز خط استوا(@)(@@) 13 سعد ذابح سر بریدی هر شکاری را که شاه %~% سوی او محور ز خط استوا کردی رها(@)(@@) 14 پیش پیکان دو شاخش از برای سجده‌ای %~% شیر چون شاخ گوزنان پشت را کردی دوتا(@)(@@) 15 من شنیدم کز نهیب تیر این شیر زمین %~% شیر گردون را اغثنا یا غیاث آمد ندا(@)(@@) 16 داور مهدی سیاست مهدی امت پناه %~% رستم حیدر کفایت حیدر احمد لوا(@)(@@) 17 خسرو سلطان نشان خاقان اکبر کز جلال %~% روزگارش عبده الاصغر نویسد بر ملا(@)(@@) 18 عطسه جودش بهشت و خنده تیغش سقر %~% ظل چترش آفتاب و گرد رخشش کیمیا(@)(@@) 19 آفتاب مشتری حکم و سپهر قطب حلم %~% زیر دست آورده مصری مار و هندی اژدها(@)(@@) 20 هندی او همچو زنگی آدمی خور در مصاف %~% مصری او چون عرابی تیز منطق در سخا(@)(@@) 21 نام او چون اسم اعظم تاج اسمادان از آنک %~% حلقه میم منوچهر است طوق اصفیا(@)(@@) 22 بلکه رضوان زین پس از میم منوچهر ملک %~% یاره حوران کند گر شاه را بیند رضا(@)(@@) 23 دایره میم منوچهر از ثوابت برتر است %~% آفرینش در میانش 
ms203	 نقطه‌ای بس بینوا(@)(@@) 24 گر سما چون میم نام او نبودی از نخست %~% هم چو سین در هم شکستی تاکنون سقف سما(@)(@@) 25 حرمتی دارد چنان توقیع او کاندر بهشت %~% صح ذلک گشت تسبیح زبان انبیا(@)(@@) 26 چرخ را توقیع او حرز است چون او برکشد %~% آن سعادت بخش مریخ زحل‌وش در وغا(@)(@@) 27 تیغ او خواهد گرفتن روم و هند از بهر آنک %~% این دو جا را هست مریخ و زحل فرمان روا(@)(@@) 28 هم زبانش تیغ و هم تیغش زبان نصرت است %~% این سراید سر وحی و آن کند درس غزا(@)(@@) 29 تیغ حصرم رنگ و بر وی دانه دانه چون عنب %~% بخت کرده زان عنب نقل و ز حصرم توتیا(@)(@@) 30 تیغ او آبستن است از فتح و اینک بنگرش %~% نقطهای چهره بر آبستنی دارد گوا(@)(@@) 31 شاه در یک حال هم خضر است و هم اسکندر است %~% کینه دین کرد و شد با آب حیوان آشنا(@)(@@) 32 هم ز پیش آب حیوان سد ظلمت برگرفت %~% هم میان آب کر سدی دگر کرد ابتدا(@)(@@) 33 از نهیب این چنین سد کوست فتح الباب فتح %~% سد باب الباب لرزان شد به زلزال فنا(@)(@@) 34 شاه بود آگه که وقتی ماه و گاو زمین %~% کلی اجزای گیتی را کنند از هم جدا(@)(@@) 35 پیش از آن کز هم برفتی هفت اندام زمین %~% رفت و پیش گاو و ماهی ساخت سدی از قضا(@)(@@) 36 پس بر آن سد مبارک ده انامل برگماشت %~% جدولی را هفت دریا ساخت از فیض عطا(@)(@@) 37 وز فلک آورد در وی گاو و ماهی و صدف %~% گاو گردنده صدف جنبان و ماهی آشنا(@)(@@) 38 ماهیش دندان فکن گشت و صدف گوهر نمای %~% گاو او عنبر فزای و ساحلش سنبل گیا(@)(@@) 39 بود در احکام خسرو کز پی سی و دو سال %~% خسف آب و باد خواهد بود در اقلیم ما(@)(@@) 40 آب را بربست و 
ms204	 دست و باد را بشکست پای %~% تا نه زآب آید گزند و نه ز باد آید بلا(@)(@@) 41 زآنکه چون نحل این بنا را خود مهندس بود شاه %~% آب چون آیینه‌شان انگبین گشت از صفا(@)(@@) 42 تا چو شاه نحل شاه انگیخت لشکر چشم خصم %~% صد هزاران چشمه شد چون خانه نحل از بکا(@)(@@) 43 تا به افزون برد رنج و گنج افزون برگشاد %~% رنج‌های هرکسی را گنج‌ها دادش جزا(@)(@@) 44 بهر مزدوران که محروران بدند از ماندگی %~% قرصه کافور کرد از قرصه شمس الضحی(@)(@@) 45 وز ملایک نعرها برخاست کاینک در زمین %~% شاه بند باقلانی بست چون بند قبا(@)(@@) 46 قاصد بخت از زبان صبح دم این دم شنید %~% صد زبان شد هم چو خورشید از پی این ماجرا(@)(@@) 47 چون کبوتر نامه آورد از ظفر نعم البرید %~% عنکبوت آسا خبر داد از خطر نعم الفتا(@)(@@) 48 گفت کای خاقانی آتش گاه محنت شد دلت %~% راه حضرت گیر و جان از آتش غم کن رها(@)(@@) 49 شاه سد آب کرد اینک رکاب شاه بوس %~% تا برای سد آتش بندها سازد تورا(@)(@@) 50 زانکه امروز آب و آتش عاجز از اعجاز اوست %~% گر بخواهد زآب سازد شمع و ز آتش آسیا(@)(@@) 51 گفتم ای جبریل عصمت گفتم ای هدهد خبر %~% وحی پردازی عفا الله ملک بخشی مرحبا(@)(@@) 52 دعوتم کردی به لشگرگاه خاقان کبیر %~% حبذا لشگرگه خاقان اکبر حبذا(@)(@@) 53 لیک من در طوق خدمت چون کبوتر بد دلم %~% پیش شه بازی چنان زنهار کی باشد مرا(@)(@@) 54 گفت کان شه باز در نسرین گردون ننگرد %~% بر کبوتر باز بیند اینت پنداری خطا(@)(@@) 55 هین بگو ای فیض رحمت هین بگو ای ظل حق %~% هین بگو ای حرز امت هین بگو ای مقتدا(@)(@@) 56 ای خدیو ماه رخش ای خسرو خورشید چتر %~% ای یل بهرام زهره ای شه کیوان دها(@)(@@) 57 آستانت گنبد سیماب گون را متکاست %~% بنده سیماب دل 
ms205	 سیماب شد زین متکا(@)(@@) 58 خود سپاه پیل در بیت الحرم گو پی منه %~% خود قطار خوک در بیت المقدس گو میا(@)(@@) 59 کی برند آب درمنه بر لب آب حیات %~% کی شود سنگ منات اندر خور سنگ منا(@)(@@) 60 بنده چون زی حضرتت پوید ندارد بس خطر %~% نجم سفلی چون شود شرقی ندارد بس ضیا(@)(@@) 61 خود مدیحت را به گفت او کجا باشد نیاز %~% مصحف مجد از پر طاووس کی بگیرد بها(@)(@@) 62 خاک درگاهت دهد از علت خذلان نجات %~% کاتفاق است این که از یاقوت کم گردد وبا(@)(@@) 63 بنده خاکین به خدمت نیم رو خاکین رسید %~% سهم خسران پس نهاد و سهم خسرو پیشوا(@)(@@) 64 کیمیای جان نثار آورده بر درگاه شاه %~% با عقیق اشک و زر چهره و در ثنا(@)(@@) 65 زید چون در خدمت احمد به ترک زن بگفت %~% نام باقی یافت اینک آیت لماقضی(@)(@@) 66 هم نثار از جان توان کردن به صدر چون تو شاه %~% هم به ترک زن توان گفتن برای مصطفی(@)(@@) 67 جان خاقانی ز تف آفتاب و رنج راه %~% مانده بود آسوده شد در سایه ظل خدا(@)(@@) 68 اجتماع ماه بود امروز و استقبال بخت %~% کاوفتاد این ذره را با چون تو خورشید التقا(@)(@@) 69 مریم طبعش نکاح یوسف وصف تو بست %~% مریمی با حسن یوسف نی چو یوسف کم بها(@)(@@) 70 لیک با ام الخبائث چون طلاقش واقع است %~% خسروش رجعت نفرماید به فتوی جفا(@)(@@) 71 گر بسیط خاک را چون من سخن پیرای هست %~% اصلم آتش دان و فرعم کفر و پیوندم ابا(@)(@@) 72 آسمان صدرا شنیدی لفظ پروین‌بار من %~% قائلان عهد را گو هکذا والا فلا(@)(@@) 73 ای گه توقیع آصف خامه و جمشید قدر %~% وی گه نیت ارسطو علم و اسکندر بنا(@)(@@) 74 ای ربیع فضل از تو گشت آدم را شرف %~% وی ربیع فصل از تو گشت عالم را نما(@)(@@) 75 در ربیع دولتت 
ms206	 هرگز خزان را ره مباد %~% فارغم ز آمین که دانم مستجاب است این دعا PageV1P0420(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مگر به ساحت گیتی نماند بوی وفا %~% که هیچ انس نیامد ز هیچ انس مرا(@)(@@) 2 فسردگان را همدم چگونه برسازم %~% فسردگان ز کجا و دم صفا ز کجا(@)(@@) 3 درخت خرما از موم ساختن سهل است %~% ولیک از آن نتوان یافت لذت خرما(@)(@@) 4 مرا ز فرقت پیوستگان چنان روزی است %~% که بس نماند که مانم ز سایه نیز جدا(@)(@@) 5 اگر به گوش من از مردمی دمی برسد %~% به مژده مردمک چشم بخشمش عمدا(@)(@@) 6 اگر مرا ندای ارجعی رسد امروز %~% وگر بشارت لاتقنطوا رسد فردا(@)(@@) 7 به گوش هوش من آید ندای اهل بهشت %~% نصیب نفس من آید نوید ملک بقا(@)(@@) 8 ندای هاتف غیبی ز چار گوشه عرش %~% صدای کوس الهی به پنج نوبه لا(@)(@@) 9 خروش شهپر جبریل و صور اسرافیل %~% غریو سبحه رضوان و زیور حورا(@)(@@) 10 لطافت حرکات فلک به گاه سماع %~% طراوت نغمات ملک به گاه ندا(@)(@@) 11 صریر خامه مصری میانه توقیع %~% صهیل ابرش تازی میانه هیجا(@)(@@) 12 نوای باربد و ساز بربط و مزمار %~% طریق کاسه‌گر و راه ارغنون و سه‌تا(@)(@@) 13 صفیر صلصل و لحن چکاوک و ساری %~% نفیر فاخته و نغمه هزار آوا(@)(@@) 14 نوازش لب جانان به شعر خاقانی %~% گزارش دم قمری به پرده عنقا(@)(@@) 15 مرا از این همه اصوات آن خوشی نرسد %~% که از دیار عزیزی رسد سلام وفا(@)(@@) 16 چنان که دوشم بی‌زحمت کبوتر و پیک %~% رسید نامه صدر الزمان به دست صبا(@)(@@) 17 درست گوئی صدر الزمان سلیمان بود %~% صبا چو هدهد و محنت سرای من چو سبا(@)(@@) 18 از آن زمان که فرو خواندم آن کتاب کریم %~% همی سرایم یا ایها الملا به ملا(@)(@@) 19 بهار عام شکفت و بهار خاص رسید %~% دو نوبهار کز آن عقل و طبع یافت نوا(@)(@@) 20 بهار عام جهان 
ms207	 را ز اعتدال مزاج %~% بهار خاص مرا شعر سید الشعرا(@)(@@) 21 سزد که عید کنم در جهان به فر رشید %~% که نظم و نثرش عیدی مؤبد است مرا(@)(@@) 22 اگر به کوه رسیدی روایت سخنش %~% زهی رشید جواب آمدی به جای صدا(@)(@@) 23 ز نقش خامه آن صدر و نقش نامه او %~% بیاض صبح و سواد دل مراست ضیا(@)(@@) 24 ز نظم و نثرش پروین و نعش خیزد و او %~% بهم نیامد پروین و نعش در یک جا(@)(@@) 25 عبارتش همه چون آفتاب و طرفه‌تر آن %~% که نعش و پروین در آفتاب شد پیدا(@)(@@) 26 برای رنج دل و عیش بد گوارم ساخت %~% جوارشی ز تحیت مفرحی ز ثنا(@)(@@) 27 معانیش همه یاقوت بود و زر یعنی %~% مفرح از زر و یاقوت به برد سودا(@)(@@) 28 به صد دقیقه ز آب در منه تلخ ترم %~% به سخره چشمه خضرم چو خواند آن دریا(@)(@@) 29 زبون‌تر از مه سی روزه‌ام مهی سی‌روز %~% مرا به طنز چو خورشید خواند آن جوزا(@)(@@) 30 طویله سخنش سی و یک جواهر داشت %~% نهادمش به بهای هزار و یک اسما(@)(@@) 31 به سال عمرم از او بیست و پنج بخریدم %~% شش دگر را شش روز کون بود بها(@)(@@) 32 مگر که جانم از این خشک سال صرف زمان %~% گریخت در کنف او به وجه استسقا(@)(@@) 33 که او به پنج انامل به فتح باب سخن %~% ز هفت کشور جانم ببرد قحط و غلا(@)(@@) 34 حیات بخشا در خامی سخن منگر %~% که سوخته شدم از مرگ قدوة الحکما(@)(@@) 35 شکسته دل تر از آن ساغر بلورینم %~% که در میانه خارا کنی ز دست رها(@)(@@) 36 بدان قرابه آویخته همی مانم %~% که در گلو ببرد موش ریسمانش را(@)(@@) 37 فروغ فکر و صفای ضمیرم از عم بود %~% چو عم بمرد بمرد آن همه فروغ و صفا(@)(@@) 38 جهان به خیره کشی بر کسی کشید کمان %~% که برکشیده حق 
ms208	 بود و برکشنده ما(@)(@@) 39 ازین قصیده نمودار ساحری کن از آنک %~% بقای نام تو است این قصیده غرا(@)(@@) 40 به هرکسی ز من این دولت ثنا نرسد %~% خنک تو کاین همه دولت مسلم است تورا(@)(@@) 41 اگر خری دم ازین معجزه زند که مراست %~% دمش بیند که خر گنگ بهتر از گویا(@)(@@) 42 کمان گروهه گبران ندارد آن مهره %~% که چار مرغ خلیل اندر آورد ز هوا(@)(@@) 43 اگرچه هرچه عیال منند خصم منند %~% جواب ندهم الا انهم هم السفها(@)(@@) 44 که خود زبان زبانی به حبس گاه جحیم %~% دهد جواب به واجب که اخسئوا فیها(@)(@@) 45 محققان سخن زین درخت میوه برند %~% وگر شوند سراسر درختک دانا(@)(@@) 46 دعای خالص من پس رو مراد تو باد %~% که به ز یاد توام نیست پیشوای دعا PageV1P0421(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عشق بیفشرد پا بر نمط کبریا %~% برد به دست نخست هستی ما را ز ما(@)(@@) 2 ما و شما را به نقد بی خودیی در خور است %~% زانکه نگنجد در او هستی ما و شما(@)(@@) 3 چرخ در این کوی چیست حلقه درگاه راز %~% عقل در این خطه کیست شحنه راه فنا(@)(@@) 4 بر سر این سر کار کی رسی ای ساده دل %~% بر در این دار ملک کی شوی این بینوا(@)(@@) 5 هست به معیار عشق گوهر تو کم عیار %~% هست به بازار دل یوسف تو کم بها(@)(@@) 6 دیده ظاهر بدوز بارگه اینک ببین %~% جوشن صورت بدر معرکه اینک درآ(@)(@@) 7 بهره درگاه دان هم خطر و هم خطاب %~% بهر شهنشاه دان هم صفت و هم صفا(@)(@@) 8 در صفت مردان بیار قوت معنی از آنک %~% در ره صورت یکی است مردم و مردم گیا(@)(@@) 9 اول غسلی بکن زین سوی نیل عدم %~% پس به تماشا گذر آن سوی مصر بقا(@)(@@) 10 گیرم چون گل نه‌ای ساخته خونین لباس %~% کم ز بنفشه مباش دوخته نیلی وطا(@)(@@) 11 خیز که 
ms209	 استاده‌اند راهروان ازل %~% بر سر راهی که نیست تا ابدش منتها(@)(@@) 12 مرکب همت بتاز یک ره و بیرون جهان %~% از سر طاق فلک تا به حد استوا(@)(@@) 13 مردمه چشم ساز نعل پی صوفیان %~% دانه دل کن نثار بر سر اصحابنا(@)(@@) 14 در کنف فقر بین سوختگان خام نوش %~% بر شجر لا نگر مرغ‌دلان خوش نوا(@)(@@) 15 هر یکی از رنگ و رای چون فلک و آفتاب %~% هر یکی از قرب و قدر چون ملک و پادشا(@)(@@) 16 خادم این جمع دان و آبده دستشان %~% قبه ازرق شعار خسرو زرین غطا(@)(@@) 17 صاحب دلق و عصا چون خضر و چون کلیم %~% گنج روان زیر دلق مار نهان در عصا(@)(@@) 18 کرده به دیوان دل چرخ و زمین را لقب %~% پیر تجشم نهاد زشت شبانگه لقا(@)(@@) 19 از گه عهد الست چیره زبان در بلی %~% پیش در لا اله بسته میان هم چو لا(@)(@@) 20 کرده به هنگام حال حله نه چرخ چاک %~% داده به وقت نوا نقد دو عالم عطا(@)(@@) 21 رسته دهر و فلک دیده و بشناخته %~% رایج این را دغل بازی آن را دغا(@)(@@) 22 بهر فریدون راز کرده ز عصمت علم %~% در صف فغفور آز کرده به همت غزا(@)(@@) 23 از اثر داغشان هردم سلطان عشق %~% گوید خاقانیا خاک توام مرحبا(@)(@@) 24 رو به هنر صدر جوی بر در صدر جهان %~% رو به صفت بازگرد بر در اصحاب ما(@)(@@) 25 جاه براهیم بین گشته براهیم‌وار %~% مکرم اخوان فقر بر سر خوان رضا(@)(@@) 26 حافظ اعلام شرع ناصر دین رسول %~% کز مدد علم اوست نصرت حزب خدا PageV1P0422(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای صفت زلف تو غارت ایمان ما %~% عشق جهان سوز تو بر دل ما پادشا(@)(@@) 2 بر در ایوان توست پای شکسته خرد %~% بر سر میدان توست دست گشاده هوا(@)(@@) 3 صد لطف از کردگار وز لب تو یک سخن %~% صد ستم از روزگار وز دل تو 
