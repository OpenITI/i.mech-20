ms121	 أظنها بفارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرنباذي (@)(@@) بفتح أوله والنون والموحدة آخره معجمة إلى فرنباذ قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفرنجي (@)(@@) بفتحتين ونون ساكنة وجيم إلى فرنجة بن حام بن نوح عليه السلام وقيل فرنج بن لنطي من ولد يافث.(@)(@@)(@@)(@@) $DIC_NIS$ الفرنداباذي (@)(@@) بفتح أوله والراء والدال المهملة والموحدة وآخره معجمة إلى فرنداباذ قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الفرنكدي (@)(@@) بفتح الفاء والراء والكاف آخره مهملة إلى فرنكد قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرنيفثاني (@)(@@) بفتح الفاءين والمثلثة وسكون الراء وكسر النون وتحتية ساكنة إلى فرنيفثان قرية بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الفرني (@)(@@) بالضم والسكون ونون إلى فرنة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرواجاني (@)(@@) بفتح الفاء والواو والجيم إلى فرواجان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفرواني (@)(@@) بالفتح والسكون إلى فروان بلد عند غزنة.(@)(@@)(@@)(@@) $DIC_NIS$ الفروي (@)(@@) مثله إلى فروة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرهاذجردي (@)(@@) بالفتح وسكون الراءين والذال المعجمة وكسر الجيم آخره مهملة إلى فرهاذجرد قرية بمرو وبنيسابور أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الفرهاذاني (@)(@@) بالفتح والسكون قلت: إلى فرهاذان قال باقوت: أظنها من قرى نسا بخراسان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفريابي (@)(@@) تقدم.(@)(@@)(@@)(@@) $DIC_NIS$ الفرياناني (@)(@@) بالكسر والسكون وتحتية ونونين بينهما ألف إلى فريانان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفرياني (@)(@@) مثله إلى فريان جد قلت: وبالضم وكسر الراء المشددة إلى فريانة قرية قرب سفاقس انتهى. PageV01P196(@)(@@)(@@)(@@) $DIC_NIS$ الفريري (@)(@@) بالفتح وكسر الراء الأولى إلى فرير بطن من بني سلمة ومن طيء.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفريزهندي (@)(@@) بالفتح والكسر وسكون التحتية والزاي والنون إلى فريزهند قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفريزني (@)(@@) بالفتح والكسر وتحتية وفتح الزاي ونون إلى فريزن قرية بهراة.(@)(@@)(@@)(@@) $DIC_NIS$ الفريسي (@)(@@) مصغرا بمهملة إلى فريس جد ومكبرا بمعجمة إلى فريش بطن من تيم الرباب وبتشديد الراء وكسر الفاء إلى فريش بلد بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) وبالضم وكسر الراء المشددة إلى فريانة قرية قرب سفاقس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفريري (@)(@@) بالفتح وكسر الراء الأولى إلى فرير بطن من بني سلمة ومن طيء.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفريزهندي (@)(@@) بالفتح والكسر وسكون التحتية والزاي والنون إلى فريزهند قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفريزني (@)(@@) بالفتح والكسر وتحتية وفتح الزاي ونون إلى فريزن قرية بهراة.(@)(@@)(@@)(@@) $DIC_NIS$ الفريسي (@)(@@) مصغرا بمهملة إلى فريس جد ومكبرا بمعجمة إلى فريش 
ms122	 بطن من تيم الرباب وبتشديد الراء وكسر الفاء إلى فريش بلد بالأندلس.(@)(@@)(@@)(@@) || باب الفاء والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الفزاري (@)(@@) بفتح الفاء والزاي ثم راء إلى فزارة قبيلة من قيس عيلان.(@)(@@)(@@)(@@) $DIC_NIS$ الفزري (@)(@@) بالفتح والسكون وراء إلى الفزر جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفزراني (@)(@@) بالكسر والسكون إلى فزرانيا ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفزعي (@)(@@) بفتحتين ومهملة إلى الفزع بطن من خثعم وبسكون الزاي إلى فزع بطن من تميم ومن كلب ومن خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الفزي (@)(@@) بالضم والتشديد إلى فز محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الفزاوي (@)(@@) بفتحتين إلى فزاوة جد.(@)(@@)(@@)(@@) || باب الفاء والسين(@)(@@)(@@)(@@) $DIC_NIS$ الفساطيطي (@)(@@) بالفتح إلى الفساطيط وهي بيوت الشعر.(@)(@@)(@@)(@@) $DIC_NIS$ الفسحمي (@)(@@) بضم الفاء والحاء المهملة بينهما مهملة ساكنة إلى فسحم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفساطي (@)(@@) إلى فسطاط مصر لأن عمرا ضرب فسطاطه بذلك المكان وهو بيت الشعر.(@)(@@)(@@)(@@) $DIC_NIS$ الفسنجاني (@)(@@) بكسرتين وسكون النون وجيم إلى فسنجان بلد بناحية فارس.(@)(@@)(@@)(@@) $DIC_NIS$ الفسوي (@)(@@) بفتحتين إلى فسا مدينة بفارس.(@)(@@)(@@)(@@) || باب الفاء والشين(@)(@@)(@@)(@@) $DIC_NIS$ الفشني (@)(@@) بالفتح وسكون المعجمة ونون إلى فشنة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفشيديزجي (@)(@@) بالفتح وكسر المعجمة وتحتيتين ساكنتين وفتح المهملة بينهما والزاي وجيم إلى فشيديزة. PageV01P197(@)(@@)(@@)(@@) || باب الفاء والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الفضلي (@)(@@) بالفتح وسكون المعجمة إلى الفضل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفضيلي (@)(@@) مصغرا إلى الفضيل جد.(@)(@@)(@@)(@@) || باب الفاء والطاء(@)(@@)(@@)(@@) $DIC_NIS$ الفطري (@)(@@) بالكسر والسكون وراء إلى الفطريين موالي بني مخزوم.(@)(@@)(@@)(@@) || باب الفاء والغين(@)(@@)(@@)(@@) $DIC_NIS$ الفغانديزي (@)(@@) بفتح الفاء والمعجمة وسكون النون وكسر المهملة وتحتية وزاي إلى فغانديزة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفغديزي (@)(@@) بالفتح وسكون المعجمة وكسر المهملة وتحتية وزاي والفغديني بوزنه إلى فغديز وفغدين قريتين ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفغشتي (@)(@@) بالفتح والكسر وسكون المعجمة وفوقية إلى فغشيت جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفغندزي (@)(@@) بالفتح وكسر المعجمة والمهملة وزاي إلى فغندزة محلة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الفغيطوسيني (@)(@@) بالفتح وكسر المعجمة والسين المهملة وضم الطاء إلى فغيطوسين قرية ببخارى.(@)(@@)(@@)(@@) || باب الفاء والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الفقاعي (@)(@@) بتشديد القاف إلى بيع الفقاع. PageV01P198(@)(@@)(@@)(@@) $DIC_NIS$ الفقيري (@)(@@) بالفتح والكسر إلى الفقير جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفقيمي (@)(@@) بضم الفاء وفتح القاف إلى فقيم بطن من تميم.(@)(@@)(@@)(@@) || باب الفاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الفلخاري (@)(@@) إلى فلخار قرية ببنج ديه.(@)(@@)(@@)(@@) $DIC_NIS$ الفلسطيني (@)(@@) بكسر 
ms123	 الفاء والطاء وفتح اللام وسكون المهملة إلى فلسطين ناحية بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الفلفلاني (@)(@@) بكسر الفاءين وسكون اللام إلى فلفلان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الفلقي (@)(@@) بفتحتين وقاف إلى فلق قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الفلكي (@)(@@) بالفتح والسكون إلى فلك قرية بسرخس وبفتحتين إلى علم الفلك وبالكسر والفتح إلى عمل الفلك جمع فلكه المغزل.(@)(@@)(@@)(@@) $DIC_NIS$ الفلوي (@)(@@) بالفتح والسكون إلى الفلو جد وبضم اللام المشددة إلى الفلو جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفليشي (@)(@@) إلى فليش قرية بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفلبي (@)(@@) بفتحتين وتحتية إلى فلة قرية بخابران.(@)(@@)(@@)(@@) || باب الفاء والنون(@)(@@)(@@)(@@) $DIC_NIS$ الفنجكاني (@)(@@) بضم الفاء والجيم وسكون النون إلى فنجكان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفنجكردي (@)(@@) بالفتح وسكون النون وضم الجيم وكسر الكاف آخره مهملة إلى فنجكرد قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الفنجوي (@)(@@) بالفتح وضم الجيم إلى فنجويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفندورجي (@)(@@) بفتح الفاء والراء وضم الدال المهملة وجيم إلى فندور قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الفندلاوي (@)(@@) بالكسر والسكون وفتح المهملة قلت: إلى فندلاو قال ياقوت: أظنه موضعا بالغرب انتهى. PageV01P199(@)(@@)(@@)(@@) $DIC_NIS$ الفنديني (@)(@@) بالضم والسكون والكسر إلى فندين قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفنكدي (@)(@@) بفتح الفاء والكاف ومهملة إلى فنك قرية بسمرقند وحصن بديار بكر بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الفنوي (@)(@@) بالفتح وضم النون المشددة إلى فنويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفنيني (@)(@@) بكسر الفاء والنون المشددة إلى فنين قرية بمرو.(@)(@@)(@@)(@@) || باب الفاء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الفوذاني (@)(@@) بالضم وذال معجمة إلى فوذان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الفوراردي (@)(@@) بالضم وفتح الراء الأولى وكسر الأخرى ومهملة إلى فورارد قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الفوراني (@)(@@) بالضم إلى فوران جد أبي القاسم الفقيه تلميذ القفال.(@)(@@)(@@)(@@) $DIC_NIS$ الفورسي (@)(@@) بالضم وراء ومهملة إلى فورس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفورفاري (@)(@@) بالضم وفاء ثانية وراءين إلى فورفارة قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ الفوركي (@)(@@) بالضم وفتح الراء إلى فورك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفوري (@)(@@) بالضم وراء إلى فور قرية ببلخ وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الفوزي (@)(@@) بالفتح والسكون وزاي إلى فوز قرية بحمص.(@)(@@)(@@)(@@) $DIC_NIS$ الفوشنجي (@)(@@) بالضم وفتح المعجمة وسكون النون وجيم إلى فوشنج مدينة قرب هراة.(@)(@@)(@@)(@@) $DIC_NIS$ الفوطي (@)(@@) بالضم والفتح إلى بيع الفوط المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الفوكردي (@)(@@) بالضم وكسر الكاف وسكون الراء ومهملة إلى فوكرد قرية بإستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفونكي 
ms124	 (@)(@@) إلى فونكة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفوي (@)(@@) بالضم وتشديد الواو إلى فوة بلد بنواحي البصرة وبمصر قرب رشيد وبالفتح إلى فوه بطن من المعافر.(@)(@@)(@@)(@@) || باب الفاء والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الفهدي (@)(@@) بالفتح إلى فهد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفروي (@)(@@) بالكسر وضم الراء إلى فهرويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفهري (@)(@@) بالكسر إلى فهر بن ملك بن النضر بن كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ الفهمي (@)(@@) بالفتح والسكون إلى فهم بطن من قيس عيلان ومن الأزد ومن أسد بن وبرة. PageV01P200(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفهندجاني (@)(@@) بالفتح والكسر والسكون إلى فهندجان قرية بهمذان انتهى.(@)(@@)(@@)(@@) || باب الفاء واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الفلاحي (@)(@@) بالفتح والتخفيف إلى فلاح جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفلاس (@)(@@) إلى بيع الفلوس.(@)(@@)(@@)(@@) || باب الفاء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الفياذسوني (@)(@@) بالكسر وتخفيف التحتية وسكون المعجمة وضم السين المهملة إلى فياذسون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفياري (@)(@@) بالفتح والتشديد وراء إلى فيار جد وبضاد معجمة إلى فياض جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفيجكثي (@)(@@) بكسر وفتح الجيم والكاف ومثلثة إلى فيجكث قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الفيدي (@)(@@) بالفتح والسكون ومهملة إلى فيد بلد بنجد.(@)(@@)(@@)(@@) $DIC_NIS$ الفيرزاني (@)(@@) بالكسر وفتح الراء والزاي إلى فيرزان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفيروزاباذي (@)(@@) بالكسر وضم الراء وفتح الزاي والموحدة آخره معجمة إلى فيروزاباذ بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الفيروزنخجيري (@)(@@) بالكسر وضم الراء وفتح الزاي والنون وسكون الخاء المعجمة وكسر الجيم وتحيتة وراء إلى فيروزنخجير قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الفيروزي (@)(@@) مثل جزئه الأول إلى فيروز قرية بحمص وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الفيري (@)(@@) بالكسر وراء إلى فيرة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الفيريابي (@)(@@) تقدم في الفاريابي.(@)(@@)(@@)(@@) $DIC_NIS$ الفيني (@)(@@) بالكسر ونون إلى فين قرية بقاسان وبلام إلى فيل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفيومي (@)(@@) بالفتح وضم الياء المشددة إلى الفيوم مدينة بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ الفيي (@)(@@) بالفتح وتشديد التحتية الأولى إلى في قرية بسمرقند.(@)(@@)(@@)(@@) | حرف القاف(@)(@@)(@@)(@@) || باب القاف والألف(@)(@@)(@@)(@@) $DIC_NIS$ القابسي (@)(@@) بكسر الموحدة ومهملة إلى قابس مدينة بإفريقية. PageV01P201(@)(@@)(@@)(@@) $DIC_NIS$ القابوسي (@)(@@) بضم الموحدة إلى قابوس رجل وموضع.(@)(@@)(@@)(@@) $DIC_NIS$ القادحي (@)(@@) بكسر المهملتين إلى قادح النار بن بذية بن عقبة بن السكون.(@)(@@)(@@)(@@) $DIC_NIS$ القادسي (@)(@@) كذلك إلى القادسية قرية عند الكوفة وأخرى بنواحي مرو الروذ.(@)(@@)(@@)(@@) $DIC_NIS$ القاراني (@)(@@) براء إلى قاران بطن من قضاعة وقال ابن الأثير: 
ms125	 بل هو بالفاء.(@)(@@)(@@)(@@) $DIC_NIS$ القارزي (@)(@@) بكسر الراء وزاي إلى قارز ويقال كارز قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ القارىء (@)(@@) بالهمز إلى القرآن وبتشديد التحتية إلى القارة بطن من خزيمة بن مدركة قلت: وإلى قار قرية بالري انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القاساني (@)(@@) بمهملة إلى قاسان بلد عند قم.(@)(@@)(@@)(@@) $DIC_NIS$ القاص (@)(@@) الواعظ.(@)(@@)(@@)(@@) $DIC_NIS$ القافلاني (@)(@@) بسكون الفاء إلى بيع أكسار السفن.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القاقوني (@)(@@) إلى قاقون حصن بفلسطين انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القالي (@)(@@) إلى قالي قلا من ديار بكر.(@)(@@)(@@)(@@) $DIC_NIS$ القانفي (@)(@@) بكسر النون وفاء إلى قانف جد وبتحتية بدل النون إلى القيافة. PageV01P202(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القاياتي (@)(@@) آخره فوقية إلى قايات بلد قرب الفيوم انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القائفي (@)(@@) مر آنفا في القانفي.(@)(@@)(@@)(@@) $DIC_NIS$ القائمي (@)(@@) إلى القائم بأمر الله.(@)(@@)(@@)(@@) $DIC_NIS$ القايني (@)(@@) بنون إلى قاين بلد قرب طبس بين نيسابور وأصبهان.(@)(@@)(@@)(@@) || باب القاف والباء(@)(@@)(@@)(@@) $DIC_NIS$ القباب (@)(@@) بموحدتين إلى عمل القباب التي كالهوادج.(@)(@@)(@@)(@@) $DIC_NIS$ القبابي (@)(@@) بالكسر إلى قباب محلة بنيسابور وبسمرقند أيضا قلت: وإلى قباب ليث قرية ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القباثي (@)(@@) بفتحتين وآخره مثلثة إلى قباث جد.(@)(@@)(@@)(@@) $DIC_NIS$ القباذياني (@)(@@) بالضم والموحدة وكسر المعجمة وتحتية إلى قباذيان بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ القباني (@)(@@) إلى القبان الذي يوزن به.(@)(@@)(@@)(@@) $DIC_NIS$ القباوي (@)(@@) بالضم والواو إلى قبا بلد بفرغانة وبالهمز إلى قبا بالمدينة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القبثوري (@)(@@) بالفتح والسكون وضم المثلثة إلى قبثور جزيرة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ والقبذاقي (@)(@@) إلى قبذاق مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القبرياني (@)(@@) بالضم وسكون الموحدة وكسر الراء وتحتية إلى قبريان قرية بإفريقية.(@)(@@)(@@)(@@) $DIC_NIS$ القبرسي (@)(@@) بضم القاف والراء ومهملة إلى قبرس جزيرة في بحر الروم وبكسرهما إلى قبرس جد.(@)(@@)(@@)(@@) $DIC_NIS$ القبضي (@)(@@) بفتحتين ومعجمة إلى القبض بطن من رعين.(@)(@@)(@@)(@@) $DIC_NIS$ القبطي (@)(@@) بالكسر والسكون إلى القبط أهل مصر نسبوا إلى قبط بن قرط بن حام وإلى القبط بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ القبلي (@)(@@) بفتحتين ولام قلت: كأنه إلى قبلة مدينة من عمل أرمينية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القبي (@)(@@) بالفتح والتشديد إلى القب مكيال للغلات وبالضم والشتديد إلى قب بطن من مراد قلت: وإلى قبة الكوفة وهي الرحبة بها. PageV01P203(@)(@@)(@@)(@@) $DIC_NIS$ والقبيطي (@)(@@) إلى القبيط كجميز الناطف انتهى.(@)(@@)(@@)(@@) || باب القاف 
ms126	 والتاء(@)(@@)(@@)(@@) $DIC_NIS$ القتاب (@)(@@) بموحدة آخره إلى بيع القتب وبفوقية إلى بيع القت العلف.(@)(@@)(@@)(@@) $DIC_NIS$ القتباني (@)(@@) بالكسر وسكون الفوقية وموحدة إلى قتبان بطن من رعين.(@)(@@)(@@)(@@) $DIC_NIS$ القتبي (@)(@@) بالضم والفتح وموحدة إلى قتيبة بطن من باهلة وجد أبي محمد الأديب.(@)(@@)(@@)(@@) $DIC_NIS$ القتيري (@)(@@) بالفتح والكسر وتحتية وراء إلى قتيرة بطن من تجيب.(@)(@@)(@@)(@@) || باب القاف والثاء(@)(@@)(@@)(@@) $DIC_NIS$ القثاثي (@)(@@) بمثلثتين إلى قثاث بطن من مهرة.(@)(@@)(@@)(@@) || باب القاف والحاء(@)(@@)(@@)(@@) $DIC_NIS$ القحافي (@)(@@) بالضم ومهملة وفاء إلى قحافة من خثعم.(@)(@@)(@@)(@@) $DIC_NIS$ القحذمي (@)(@@) بفتح أوله والمعجمة وسكون الحاء المهملة إلى قحذم جد.(@)(@@)(@@)(@@) $DIC_NIS$ القحطاني (@)(@@) بالفتح والسكون إلى قحطان بن عابر بن شالخ بن أرفخشذ بن سام بن نوح وقيل ابن الهميسع بن تيمن بن نبت بن إسماعيل.(@)(@@)(@@)(@@) $DIC_NIS$ القحطبي (@)(@@) بفتح أوله والطاء المهملة وموحدة إلى قحطبة جد.(@)(@@)(@@)(@@) || باب القاف والدال(@)(@@)(@@)(@@) $DIC_NIS$ القداحية (@)(@@) فرقة من الباطنية رأسهم عبد الله بن ميمون القداح.(@)(@@)(@@)(@@) $DIC_NIS$ القدادي (@)(@@) بالضم ومهملتين إلى قداد بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ القدامي (@)(@@) بوزنه إلى قدامة جد.(@)(@@)(@@)(@@) $DIC_NIS$ القدرية (@)(@@) أصحاب القدر.(@)(@@)(@@)(@@) $DIC_NIS$ القدوري (@)(@@) بضمتين إلى بيع القدور.(@)(@@)(@@)(@@) $DIC_NIS$ القديدي (@)(@@) مصغرا إلى قديد منزل بين مكة والمدينة شرفهما الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ القديسي (@)(@@) مثله إلى قديس أو قديسة من عمل بغداد ظنا.(@)(@@)(@@)(@@) || باب القاف والراء(@)(@@)(@@)(@@) $DIC_NIS$ القراب (@)(@@) إلى بيع القرب.(@)(@@)(@@)(@@) $DIC_NIS$ القرادي (@)(@@) بالضم وراء إلى قراد جد وبطن.(@)(@@)(@@)(@@) $DIC_NIS$ القراري (@)(@@) بالفتح ومهملتين إلى قرار قبيلة من بكر وبالكسر إلى قرار بطن من عنزة. PageV01P204(@)(@@)(@@)(@@) $DIC_NIS$ القراطيسي (@)(@@) إلى عمل القراطيس وبيعها.(@)(@@)(@@)(@@) $DIC_NIS$ القراطي (@)(@@) بالفتح إلى قراطة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ القراظ (@)(@@) بظاء معجمة إلى بيع القرظ.(@)(@@)(@@)(@@) $DIC_NIS$ القرافي (@)(@@) بالفتح آخره فاء إلى القرافة بطن من المعافر ومقبرة بمصر نزلوها فنسبت إليهم.(@)(@@)(@@)(@@) $DIC_NIS$ القرائي (@)(@@) بالضم وتشديد الراء إلى القراء جمع قارىء.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القراوي (@)(@@) إلى قراوا قرية بنابلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القربي (@)(@@) بالكسر والفتح وموحدة إلى القرب.(@)(@@)(@@)(@@) $DIC_NIS$ القرتائي (@)(@@) بفتح القاف والراء والفوقية المشددة إلى قرتا قرية بالبحرين.(@)(@@)(@@)(@@) $DIC_NIS$ القرثعي (@)(@@) بفتح أوله والمثلثة ومهملة إلى قرثعة رجل.(@)(@@)(@@)(@@) $DIC_NIS$ القرجني (@)(@@) بالضم والسكون وفتح الجيم ونون إلى قرجن قرية 
ms127	 بالري.(@)(@@)(@@)(@@) $DIC_NIS$ القرجي (@)(@@) بالفتح والسكون وجيم إلى القرج ناحية بالري وبالضم إلى القرج قرية بالري ظنا.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القرحتاوي (@)(@@) إلى قرحتا قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القردمي (@)(@@) بفتح أوله والدال المهملة إلى بني القردم قبيلة.(@)(@@)(@@)(@@) $DIC_NIS$ القردواني (@)(@@) بالفتح وضم المهملة إلى قردوان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) القردي بفتحتين إلى قردا بدمشق انتهى: بضم أوله والمهملة إلى القراديس بطن من الأزد ومحلة لهم بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ القرشي (@)(@@) بالضم والفتح إلى قريش.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القرطاجني (@)(@@) بالفتح والسكون وفتح الجيم وتشديد النون إلى قرطاجنة بلد بنواحي إفريقية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القرطبي (@)(@@) بضم أوله والطاء وموحدة إلى قرطبة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ القرطمي (@)(@@) بكسرهما وميم إلى القرطم المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ القرطي (@)(@@) بالضم والسكون ومهملة إلى القرط المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ القرظي (@)(@@) بفتحتين ومعجمة إلى سعد القرظ PageV01P205 لأنه كان يبيعه وبالضم والفتح إلى قريظة طائفة من اليهود.(@)(@@)(@@)(@@) $DIC_NIS$ القرقري (@)(@@) بفتح القافين وسكون الراء الأولى إلى قرقر جد وبضمهما إلى قرقر جد.(@)(@@)(@@)(@@) $DIC_NIS$ القرقسياني (@)(@@) بفتحهما ومهملة إلى قرقسيا مدينة قرب الرقة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القرقشندي (@)(@@) إلى قرقشندة قرية بأسفل مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القرقوبي (@)(@@) بضمهما وموحدة إلى قرقوب مدينة بين واسط والأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ القرامطة (@)(@@) إلى قرمط بكسر أوله والميم زعيمهم.(@)(@@)(@@)(@@) $DIC_NIS$ القرميسيني (@)(@@) بكسر الراء والميم والسين المهملة إلى قرميسين مدينة بالعراق.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القرمي (@)(@@) إلى .. ..(@)(@@)(@@)(@@) $DIC_NIS$ والقرموني (@)(@@) بالفتح والسكون إلى قرمونية كورة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القزباني (@)(@@) بالفتح والسكون ونونين إلى بني القرنان من تجيب.(@)(@@)(@@)(@@) $DIC_NIS$ القرنجلي (@)(@@) بفتحتين وسكون النون وضم الجيم ولام إلى قرنجل قرية بالأنبار.(@)(@@)(@@)(@@) $DIC_NIS$ القرني (@)(@@) بفتحتين إلى قرن بطن من مراد وبسكون الراء إلى قرن بطن من مذحج ومن الأزد وقرن المنازل ميقات أهل نجد وقرن قرية من عمل بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ القروي (@)(@@) بفتحتين إلى القيروان بلد بالمغرب قلت: وإلى القرية بلد بالشأم وبأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القريبي (@)(@@) بالفتح والكسر إلى أبي قريبة جد وبالتصغير إلى قريبة بنت محمد بن أبي بكر الصديق رضي الله تعالى عنه. PageV01P206(@)(@@)(@@)(@@) $DIC_NIS$ القريحي (@)(@@) بالفتح والكسر ومهملة إلى قريح بطن من سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ القريشي (@)(@@) بالتصغير إلى قريش.(@)(@@)(@@)(@@) $DIC_NIS$ القريعي 
ms128	 (@)(@@) بوزنه آخره مهملة إلى قريع بطن من قيس عيلان وقريعة جد.(@)(@@)(@@)(@@) $DIC_NIS$ القريني (@)(@@) بوزنه ونون إلى قرين جد وبالفتح والكسر إلى قرين جد.(@)(@@)(@@)(@@) $DIC_NIS$ القرينيني (@)(@@) إلى القرينين بلفظ المثنى بلد بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ القري (@)(@@) بالضم والتشديد إلى قرة بطن من عبد القيس وبالكسر إلى القرية بطون عدة.(@)(@@)(@@)(@@) || باب القاف والزاي(@)(@@)(@@)(@@) $DIC_NIS$ القزاز (@)(@@) إلى بيع القز.(@)(@@)(@@)(@@) $DIC_NIS$ القزاداري (@)(@@) بالضم وسكون الزاي ومهملة إلى قزدار ناحية بالهند.(@)(@@)(@@)(@@) $DIC_NIS$ القزغندي (@)(@@) بضم أوله والغين المعجمة وسكون الزاي والنون ومهملة إلى قزغند قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ القزويني (@)(@@) بالفتح والسكون وكسر الواو إلى قزوين.(@)(@@)(@@)(@@) $DIC_NIS$ القزيعي (@)(@@) مصغرا بمهملة إلى قزيع بطن من بجيلة.(@)(@@)(@@)(@@) || باب القاف والسين(@)(@@)(@@)(@@) $DIC_NIS$ القسام (@)(@@) إلى القسمة.(@)(@@)(@@)(@@) $DIC_NIS$ القسحمي (@)(@@) بضم القاف والحاء المهملة وسكون السين المهملة إلى قسحم بطن من الصدف.(@)(@@)(@@)(@@) $DIC_NIS$ القسري (@)(@@) بالفتح والسكون وراء إلى قسر بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ الفسطار (@)(@@) بالضم الذي يحفظ الذهب ليبدله بالورق.(@)(@@)(@@)(@@) $DIC_NIS$ القسطاني (@)(@@) بالضم إلى قسطانة قرية بين الري وساوة.(@)(@@)(@@)(@@) $DIC_NIS$ القسطلي (@)(@@) بفتح أوله والطاء إلى القسطل موضع بالشأم قلت: وبتشديد اللام إلى القسطلة مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القسطنطني (@)(@@) بضم القاف وفتح الطاء الأولى وكسر الثانية إلى القسطنطينية مدينة بالروم.(@)(@@)(@@)(@@) $DIC_NIS$ القسملي (@)(@@) بفتح القاف والميم إلى القساملة من الأزد ومحلة لهم بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القسنطيني (@)(@@) بالضم والفتح والسكون إلى قسنطينية قلعة بحدود إفريقية. PageV01P207(@)(@@)(@@)(@@) || باب القاف والشين(@)(@@)(@@)(@@) $DIC_NIS$ والقشبي(@)(@@) إلى قشب حصن بسرقسطة.(@)(@@)(@@)(@@) $DIC_NIS$ والقشبري (@)(@@) بضمتين وسكون الموحدة إلى قشبرة مدينة بطليطلة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القشري (@)(@@) بالضم وفتح المعجمة وراء إلى القشر بن تميم بن عوف مناة.(@)(@@)(@@)(@@) $DIC_NIS$ القشيري (@)(@@) مصغرا إلى قشير بن كعب بن عامر بن صعصعة وقشير بن حزيمة بطن من أسلم.(@)(@@)(@@)(@@) $DIC_NIS$ القشيبي (@)(@@) بالفتح والكسر آخره موحدة إلى بني القشيب بطن من لخم.(@)(@@)(@@)(@@) $DIC_NIS$ القشيشي (@)(@@) بالكسر وفتح المعجمة الأولى ثم تحتية ساكنة إلى قشيش جد.(@)(@@)(@@)(@@) || باب القاف والصاد(@)(@@)(@@)(@@) $DIC_NIS$ القصاب (@)(@@) الذباح.(@)(@@)(@@)(@@) $DIC_NIS$ القصاري (@)(@@) إلى قصر الثياب قالقصار وإلى سكة القصارين بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ القصاعي (@)(@@) بالكسر إلى القصاع.(@)(@@)(@@)(@@) $DIC_NIS$ القصباني (@)(@@) بفتحات والقصبي إلى بيع القصب.(@)(@@)(@@)(@@) $DIC_NIS$ القصداري (@)(@@) بالضم 
ms129	 والسكون ومهملة إلى قصدار ناحية بغزنة.(@)(@@)(@@)(@@) $DIC_NIS$ القصراني (@)(@@) بالفتح والسكون وراء إلى قصران بنواحي الري. PageV01P208(@)(@@)(@@)(@@) $DIC_NIS$ القصري (@)(@@) مثله إلى قصر ابن هبيرة والقصر موضع بالشأم وقصر عبد الجبار بنيسابور وقصر اللصوص بأسداباذ وقصر رافع بسمرقند وأبي القصر جد وإلى قصر الأحنف بطخارستان وإلى باب القصر بأصبهان وقصر روناش بالأهواز والقصر موضع بين حيفا وقيسارية وقصر الزيت بالبصرة وقصر عبد الكريم مدينة قرب سبتة وقصر قضاعة قرية قرب بغداد وقصر كتامة مدينةبالأندلس وقصر كنكور بلد قرب همذان وقصر الكوفة انتهى.(@)(@@)(@@)(@@) || باب القاف والضاد(@)(@@)(@@)(@@) $DIC_NIS$ القضاعي (@)(@@) بالضم وضاد معجمة وعين مهملة إلى قضاعة شعب من معد وقيل من اليمن.(@)(@@)(@@)(@@) || باب القاف والطاء(@)(@@)(@@)(@@) $DIC_NIS$ القطابي (@)(@@) بالضم وموحدة إلى قطابة قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ القطان (@)(@@) إلى بيع القطن.(@)(@@)(@@)(@@) $DIC_NIS$ القطانقاني (@)(@@) بضم القاف الأولى وسكون النون الأولى إلى قطانقان قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ القطائعي (@)(@@) بالفتح إلى القطائع.(@)(@@)(@@)(@@) $DIC_NIS$ القطراني (@)(@@) بالفتح والكسر إلى القطران.(@)(@@)(@@)(@@) $DIC_NIS$ القطربلي (@)(@@) بضم القاف والراء والموحدة ولام إلى قطربل قرية ببغداد. PageV01P209(@)(@@)(@@)(@@) $DIC_NIS$ القطري (@)(@@) بالفتح والسكون وراء إلى القطر قلت: هو موضع بين البصرة وواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القطعي (@)(@@) بالضم والفتح ومهملة إلى قطيعة بطن من زبيد ومن قيس عيلان وبالكسر إلى بيع قطع الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ القطفتي (@)(@@) بضمتين وسكون الفاء وفوقية إلى قطفتا محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ القطفي (@)(@@) بالضم والسكون وفاء.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القطني (@)(@@) إلى قطنا قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القطواني (@)(@@) بفتحات إلى قطوان موضع بسمرقند وبالكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ القطوطي (@)(@@) بفتح القاف والواو ومهملتين إلى قطوط محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ القطوطائي (@)(@@) بالفتح والضم إلى قطوطا قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ القطيطي (@)(@@) بالتصغير إلى قطيط جد.(@)(@@)(@@)(@@) $DIC_NIS$ القطيعي (@)(@@) بالفتح والكسر إلى قطيعة الربيع وقطيعة عيسى بن علي وقطيعة الفقهاء وقطيعة الدقيق محال ببغداد وأبو بكر راوي المسند من الأخيرة.(@)(@@)(@@)(@@) $DIC_NIS$ القطيفي (@)(@@) بوزنه وفاء إلى القطيف بلد بناحية الأحساء.(@)(@@)(@@)(@@) || باب القاف والظاء(@)(@@)(@@)(@@) $DIC_NIS$ القظيفي (@)(@@) بالضم وفتح المعجمة والسكون وفاء PageV01P210 إلى قظيف بطن من مراد وأنكره ابن الأثير وقال هو بالغين المعجمة.(@)(@@)(@@)(@@) || باب القاف والعين(@)(@@)(@@)(@@) $DIC_NIS$ القعاصي (@)(@@) بالكسر ومهملتين إلى قعاص جد.(@)(@@)(@@)(@@) $DIC_NIS$ القعنبي 
ms130	 (@)(@@) بفتح أوله والنون وسكون المهملة آخره موحدة إلى جده قعنب.(@)(@@)(@@)(@@) $DIC_NIS$ القعيني (@)(@@) مصغرا بنون إلى قعين.(@)(@@)(@@)(@@) || باب القاف والفاء(@)(@@)(@@)(@@) $DIC_NIS$ القفال (@)(@@) إلى صنعة الأقفال: القفصي: بالفتح وسكون الفاء ومهملة إلى قفصة مدينة بالمغرب وبالضم إلى القفص قرية فوق بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القفطي (@)(@@) بالكسر وسكون الفاء إلى قفط بلد بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القفلي (@)(@@) بفتحتين ولام إلى قفل جد.(@)(@@)(@@)(@@) || باب القاف واللام(@)(@@)(@@)(@@) $DIC_NIS$ القلزمي (@)(@@) بالفتح والسكون وضم الزاي إلى القلزم مدينة بين مصر ومكة شرفها الله ينسب بحر القلزم إليها قلت: ضم ياقوت أولها انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القلعي (@)(@@) بفتحتين ومهملة إلى القلعة بلد قلت: بالهند وموضع باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ والقلموني (@)(@@) بفتحتين إلى قلمون موضع بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القلندوشي (@)(@@) بفتحتين وسكون النون وضم المهملة ومعجمة إلى قلندوش قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ القلوحي (@)(@@) بالفتح وضم اللام المشددة وحاء مهملة إلى القلوحة قرية عند الأنبار.(@)(@@)(@@)(@@) $DIC_NIS$ القلوري (@)(@@) بفتح أوله واللام والواو المشددة وراء إلى قلورة جد قلت: وبالكسر وتشديد اللام سكون الواو إلى قلورية جزيرة بصقلية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القلوسي (@)(@@) بضمتين ومهملة إلى القلوس وهي حبال السفن.(@)(@@)(@@)(@@) || باب القاف والميم(@)(@@)(@@)(@@) $DIC_NIS$ القماح (@)(@@) إلى القمح.(@)(@@)(@@)(@@) $DIC_NIS$ القماشوي (@)(@@) بالفتح وضم المعجمة إلى قماشويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ القماصي (@)(@@) بالفتح والتشديد إلى بيع القمصان.(@)(@@)(@@)(@@) $DIC_NIS$ القماطري (@)(@@) بالفتح وكسر الطاء وراء إلى القمطر.(@)(@@)(@@)(@@) $DIC_NIS$ القمراطي (@)(@@) بالفتح والسكون إلى قمراط مدينة بالمغرب. PageV01P211(@)(@@)(@@)(@@) $DIC_NIS$ القمري (@)(@@) بفتحتين إلى القمر وبالضم والسكون إلى القمر بلد بمصر ظنا والطير القمري منسوب إليها.(@)(@@)(@@)(@@) $DIC_NIS$ القمني (@)(@@) بالكسر وفتح الميم المشددة ونون إلى قمن قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القمولي (@)(@@) بالفتح والضم إلى قمولا بلد بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القميري (@)(@@) إلى قمير ككريم ابن حبشة بن سلول بن كعب بن عمرو بن ربيعة وبالتصغير إلى قمير بطن من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ القمي (@)(@@) بالضم والتشديد إلى قم بلد بين ساوة وأصبهان.(@)(@@)(@@)(@@) || باب القاف والنون(@)(@@)(@@)(@@) $DIC_NIS$ القناد (@)(@@) بتشديد النون طلحة وغيره إلى بيع القند وهو السكر.(@)(@@)(@@)(@@) $DIC_NIS$ القنادري (@)(@@) بفتحتين وكسر المهملة وراء إلى قنادر محلة بأصبهان وبراء وزاي إلى قنارز قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القناطري (@)(@@) إلى 
ms131	 القناطر بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القناني (@)(@@) بفتحتين ونون آخره إلى قنان بطن من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ القنائي (@)(@@) بالضم والتشديد قلت: إلى قنا موضع بالنهروان وبالكسر والتخفيف إلى قنا بلد بالصعيد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القنباري (@)(@@) بالكسر وسكون النون وموحد إلى القنبار وهو ليف الرانج. PageV01P212(@)(@@)(@@)(@@) $DIC_NIS$ القنبري (@)(@@) بفتح القاف والباء الموحدة ثالثة إلى قنبر رجل.(@)(@@)(@@)(@@) $DIC_NIS$ القنبلي (@)(@@) بضم أوله والباء الموحدة إلى قنبل رجل.(@)(@@)(@@)(@@) $DIC_NIS$ القنبيطي (@)(@@) بالضم وفتح النون المشددة وكسر الموحدة وتحتية ومهملة إلى بيع القنبيط.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القنبي (@)(@@) بالفتح والسكون إلى قنبة قرية بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القندي (@)(@@) بالفتح والسكون ومهملة إلى قند السكر.(@)(@@)(@@)(@@) $DIC_NIS$ القنديشتني (@)(@@) بالفتح والسكون وكسر المهملة وتحتية وفتح المعجمة والفوقية ونون إلى قنديشتن قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ القنديلي (@)(@@) بكسر القاف والمهملة إلى بيع القنديل.(@)(@@)(@@)(@@) $DIC_NIS$ القنسريني (@)(@@) بالكسر وتشديد النون وفتحها وسكون المهملة وكسر الراء والقنسري إلى قنسرين بلد عند حلب.(@)(@@)(@@)(@@) $DIC_NIS$ القنطري (@)(@@) بفتح أوله والطاء إلى قنطرة البردان محلة ببغداد ورأس القنطرة محلة بنيسابور وقرية بسمرقند قلت: وإلى قنطرة السيف بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القنفذي (@)(@@) بضم أوله والفاء والذال معجمة إلى قنفذ جد وبطن من سليم.(@)(@@)(@@)(@@) $DIC_NIS$ القنفلي (@)(@@) بالفتح والسكون وضم الفاء إلى قنفل جد.(@)(@@)(@@)(@@) $DIC_NIS$ القنوي (@)(@@) بفتحتين إلى عمل القناة وهو الرمح.(@)(@@)(@@)(@@) $DIC_NIS$ القنيني (@)(@@) بالضم وكسر النون الأولى إلى قنين.(@)(@@)(@@)(@@) $DIC_NIS$ القني (@)(@@) بالضم والتشديد إلى قنة قرية ظنا.(@)(@@)(@@)(@@) || باب القاف والواو (@)PageV01P213(@)(@@)(@@)(@@) $DIC_NIS$ القواذي (@)(@@) بفتحتين ومعجمة قلت: إلى قواذيان مدينة فوق ترمذ انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القواريري (@)(@@) إلى عمل القوارير.(@)(@@)(@@)(@@) $DIC_NIS$ القواس (@)(@@) إلى عمل الأقواس.(@)(@@)(@@)(@@) $DIC_NIS$ القورسي (@)(@@) بضم القاف والراء ومهملة إلى قورس قرية بحلب ظنا.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القوري (@)(@@) بالفتح والسكون إلى قورة قرية بإشبيلية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القوريني (@)(@@) بالضم وكسر الراء إلى قورين بلد بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ القوصي (@)(@@) بالضم ومهملة إلى قوص بلد بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القوفاني (@)(@@) بالضم وفاء إلى بيت قوفا قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القوقلي (@)(@@) بفتح القافين إلى قوقل بطن من الخزرج.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القومساني (@)(@@) إلى قومسان من نواحي همذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القومسي (@)(@@) بالضم ومهملة إلى قومس وهي من بسطام إلى 
ms132	 سمنان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القونكي (@)(@@) إلى قونكة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والقونوي (@)(@@) بالضم وفتح النون إلى قونية من بلاد الروم انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القوهستاني (@)(@@) بضم أوله والهاء وسكون المهملة وفتح الفوقية إلى قوهستان ولاية كبيرة متصلة بهراة والعراق وهمذان ونهاوند.(@)(@@)(@@)(@@) $DIC_NIS$ القوهياري (@)(@@) بالضم وكسر الهاء وتخفيف التحتية وراء إلى قوهيار قرية بطبرستان وجد.(@)(@@)(@@)(@@) || باب القاف والهاء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القهجي (@)(@@) إلى قهج قرية بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القهستاني (@)(@@) بضمتين وسكون المهملة وفوقية PageV01P214 إلى قهستان ناحية بخراسان بين هراة ونيسابور وهي قوهستان.(@)(@@)(@@)(@@) $DIC_NIS$ القهمي (@)(@@) بالفتح والسكون إلى قهم بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ القهندري (@)(@@) بضم القاف والهاء والدال المهملة وراء إلى قهندر بلد ببخارى ونيسابور وبمرو وبسمرقند وبهراة.(@)(@@)(@@)(@@) || باب القاف واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ القلاء (@)(@@) إبراهيم بن الحجاج بن منير كان يقلي الحمص.(@)(@@)(@@)(@@) $DIC_NIS$ القلاس (@)(@@) إلى القلس وهي حبال السفن.(@)(@@)(@@)(@@) $DIC_NIS$ القلانسي (@)(@@) إلى عمل القلانس.(@)(@@)(@@)(@@) || باب القاف والياء(@)(@@)(@@)(@@) $DIC_NIS$ القيار (@)(@@) إلى عمل القير.(@)(@@)(@@)(@@) $DIC_NIS$ القافي (@)(@@) بالفتح وفاء إلى القيافة بطن من غافق.(@)(@@)(@@)(@@) $DIC_NIS$ القيراطي (@)(@@) بالكسر إلى القيراط المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ القيرواني (@)(@@) بفتح أوله والراء والواو إلى القيروان بلد بإفريقية.(@)(@@)(@@)(@@) $DIC_NIS$ القيسراني (@)(@@) بوزنه إلى قيسارية مدينة بالشأم.(@)(@@)(@@)(@@) $DIC_NIS$ القيسي (@)(@@) بالفتح إلى قيس عيلان وقيس بطن من بكر بن وائل ومن النخع والقيس قرية بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القيشاطي (@)(@@) بالفتح والسكون إلى قيشاطة مدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القيصري (@)(@@) بفتح أوله والمهملة إلى قيصر جد بالفتح والسكون ومعجمة إلى بطن من حمير وقيل بالظاء المعجمة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: القيلوي (@)(@@) بالكسر إلى قيلوية قرية بنواحي طبراباذ. PageV01P215(@)(@@)(@@)(@@) $DIC_NIS$ والقيمري (@)(@@) بالفتح والسكون وضم الميم إلى قيمر قلعة بين الموصل وخلاط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القيم (@)(@@) القائم بمصالح المساجد أو الحمام أو الأطفال.(@)(@@)(@@)(@@) $DIC_NIS$ القيناني (@)(@@) بالفتح وسكون التحيتة ونونين إلى قينان بن أنوش بن شيث بن آدم وقرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ القيني (@)(@@) بالفتح والسكون إلى القين قبيلة من قضاعة قلت: وإلى قينية قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ القيومي (@)(@@) بالفتح وضم الياء المشددة إلى قيوما لقب جد. PageV01P216(@)(@@)(@@)(@@) | حرف الكاف(@)(@@)(@@)(@@) || باب الكاف والألف(@)(@@)(@@)(@@) $DIC_NIS$ الكابلي (@)(@@) بضم الموحدة إلى كابل ناحية بالهند.(@)(@@)(@@)(@@) $DIC_NIS$ الكاجري 
ms133	 (@)(@@) بفتح الجيم وراء إلى كاجر قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الكاجغري (@)(@@) بفتح الجيم والمعجمة وراء إلى كاجغر ويقال بالشين بدل الجيم مدينة من تركستان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكاجي (@)(@@) بجيم إلى كاج قرية بأصبهان وبخاء معجمة إلى سكة كاخ انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكاخشتواني (@)(@@) بضم المعجمة والفوقية وسكون الشين المعجمة إلى كاخشتوان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكاخي (@)(@@) مر آنفا في الكاجي.(@)(@@)(@@)(@@) $DIC_NIS$ الكاذي (@)(@@) بمعجمة إلى كاذة قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الكاراتي (@)(@@) براء وفوقية إلى كارات.(@)(@@)(@@)(@@) $DIC_NIS$ الكارزني (@)(@@) بسكون الراء ثم زاي مفتوحة ونون إلى كارزن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكارزياتي (@)(@@) بكسر الراء وسكون الزاي وتحتية وآخره فوقية إلى كارزيات بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الكارزي (@)(@@) بكسرهما إلى كارز قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الكاري (@)(@@) براء إلى كار قرية بأصبهان وبالموصل.(@)(@@)(@@)(@@) $DIC_NIS$ الكازروني (@)(@@) بفتح الزاي وضم الراء إلى كازور بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الكازقي (@)(@@) بفتح الزاي وقاف إلى كازة قرية بمرو. PageV01P217(@)(@@)(@@)(@@) $DIC_NIS$ الكاساني (@)(@@) بمهملة إلى كاسان بلد وراء الشاش.(@)(@@)(@@)(@@) $DIC_NIS$ الكاسكاني (@)(@@) بفتح المهملة إلى كاسكان قرية بكازورن.(@)(@@)(@@)(@@) $DIC_NIS$ الكاسني (@)(@@) بقتح المهملة وتشديد النون إلى كاسن قرية بنخشب.(@)(@@)(@@)(@@) $DIC_NIS$ الكاسي (@)(@@) إلى كاس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكاشغري (@)(@@) بسكون الشين وفتح الغين المعجمتين وراء إلى كاشغر مدينة بالمشرق.(@)(@@)(@@)(@@) $DIC_NIS$ الكاغذي (@)(@@) بفتح الغين وكسر الذال المعجمتين إلى عمل الكاغذ وهو الورق.(@)(@@)(@@)(@@) $DIC_NIS$ الكافوري (@)(@@) إلى الكافور المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكافيجي (@)(@@) شيخنا بكسر الفاء وفتح التحتية وحرف من سكنها وجيم إلى كافية ابن الحاجب لكثرة قراءته وإقرائه لها انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكاكني (@)(@@) بفتح الكافين ونون إلى كاكن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكاكوي (@)(@@) بضم الكاف الثانية إلى كاكويه.(@)(@@)(@@)(@@) $DIC_NIS$ الكالفي (@)(@@) بكسر اللام وفاء إلى كالف قلعة قرب بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الكالي (@)(@@) بلام إلى كال جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكامجري (@)(@@) بفتح الميم والجيم وراء إلى كامجر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكامددي (@)(@@) بفتح الميم والمهملة الأولى إلى قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكاملي (@)(@@) إلى كامل جد والكاملية من الشيعة إلى أبي كامل.(@)(@@)(@@)(@@) $DIC_NIS$ الكاوداني (@)(@@) بمهملة إلى كاودان قرية بطبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ الكاورداني (@)(@@) بفتح الواو وسكون الراء ومهملة إلى كاوردان قرية بها قال ابن الأثير رحمه الله هو والذي قبله واحد.(@)(@@)(@@)(@@) $DIC_NIS$ الكاهلي (@)(@@) بكسر الهاء إلى 
ms134	 كاهل بطن من سعد هذيم ومن هذيل ومن أسد بن خزيمة. PageV01P218(@)(@@)(@@)(@@) $DIC_NIS$ الكايشكني (@)(@@) بفتح التحتية والكافين وسكون المعجمة إلى كايشكن قرية ببخارى.(@)(@@)(@@)(@@) || باب الكاف والباء(@)(@@)(@@)(@@) $DIC_NIS$ الكباري (@)(@@) بالضم وموحدة وراء إلى ذي كبار شراحيل الحميري من أقيال اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الكباشي (@)(@@) بالتشديد إلى بيع الكبش.(@)(@@)(@@)(@@) $DIC_NIS$ الكبري (@)(@@) بالفتح والسكون وراء إلى الكبر لقب جد وبشين معجمة إلى الكبش موضع ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الكبندوي (@)(@@) بالفتح وكسر الموحدة وسكون النون وفتح المهملة إلى كبندة قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الكبوذنجكثي (@)(@@) بفتح الكافين والذال المعجمة والجيم وضم الموحدة وسكون النون آخره مثلثة إلى كبوذنجكث مدينة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكبوذي (@)(@@) بالفتح والضم ومعجمة إلى كبوذ قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكبلاني (@)(@@) بالفتح وسكون الموحدة إلى كبلان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكبيري (@)(@@) بالفتح والكسر إلى كبير بطن من أسد وغيره وقرية قرب بخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكبيسي (@)(@@) مصغرا بمهملة إلى كبيسة بلد بالسماوة.(@)(@@)(@@)(@@) || باب الكاف والتاء(@)(@@)(@@)(@@) $DIC_NIS$ الكتامي (@)(@@) بالضم وفوقية إلى كتامة قبيلة من البربر بالمغرب وإلى كتامة والدة.(@)(@@)(@@)(@@) $DIC_NIS$ الكتاني (@)(@@) بالفتح والتشديد إلى الكتان المعروف.(@)(@@)(@@)(@@) || باب الكاف والثاء(@)(@@)(@@)(@@) $DIC_NIS$ الكثومي (@)(@@) بالفتح وتشديد المثلثة إلى كثة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكثيري (@)(@@) بالفتح والكسر إلى كثير جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكثي (@)(@@) بالفتح والتشديد إلى كث قرية ببخارى.(@)(@@)(@@)(@@) || باب الكاف والجيم (@)PageV01P219(@)(@@)(@@)(@@) $DIC_NIS$ الكجي (@)(@@) بالفتح وتشديد الجيم إلى الكج وهو الجص وبالشين المعجمة إلى كش جد واشتهر بهما أبو مسلم لأن في أجداده كشا وكان يبني داره فأكثر من قول هاتوا الكج فسمي به.(@)(@@)(@@)(@@) || باب الكاف والحاء(@)(@@) الكحال والكحلي: إلى الكحل.(@)(@@)(@@)(@@) $DIC_NIS$ الكحرني (@)(@@) بفتح أوله والراء وسكون المهملة إلى كحرن قرية.(@)(@@)(@@)(@@) $DIC_NIS$ الكحلاني (@)(@@) بالضم والسكون إلى كحلان بطن من رعين.(@)(@@)(@@)(@@) || باب الكاف والدال(@)(@@)(@@)(@@) $DIC_NIS$ الكدكي (@)(@@) بالفتح وسكون المهملة إلى كدك.(@)(@@)(@@)(@@) $DIC_NIS$ الكدني (@)(@@) بفتحتين ونون إلى كدن قرية.(@)(@@)(@@)(@@) $DIC_NIS$ الكدوشي (@)(@@) بضمتين آخره معجمة إلى كدوش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكديمي (@)(@@) مصغرا إلى كديم جد محمد بن يونس البصري وغيره.(@)(@@)(@@)(@@) || باب الكاف والذال(@)(@@)(@@)(@@) $DIC_NIS$ الكذرائي (@)(@@) بالفتح وسكون المعجمة وراء إلى كذراء قرية باليمن.(@)(@@)(@@)(@@) || باب الكاف والراء(@)(@@)(@@)(@@) $DIC_NIS$ الكرابيسي (@)(@@) إلى بيع الكرابيس وهي الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ الكراجكي (@)(@@) بفتح 
ms135	 الجيم إلى كراجك قرية بواسط.(@)(@@)(@@)(@@) $DIC_NIS$ الكرازي (@)(@@) بتشديد الراء آخره زاي إلى كراز جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكراعي (@)(@@) بالضم ومهملة إلى بيع الأكارع والرؤوس.(@)(@@)(@@)(@@) $DIC_NIS$ الكرامي (@)(@@) بالفتح والتشديد إلى محمد بن كرام رأس الكرامية.(@)(@@)(@@)(@@) $DIC_NIS$ الكراني (@)(@@) بالفتح والتشديد إلى كران محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الكربي (@)(@@) بالفتح والسكون وموحدة إلى كرب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكرجي (@)(@@) بفتحتين وجيم إلى الكرج مدينة بين أصبهان وهمذان وبالضم والسكون إلى كرج ناحية بأذربيجان وبالفتح والسكون والخاء المعجمة إلى كرخ سامرا وكرخ بغداد وكرخ جدان وكرخ البصرة. PageV01P220(@)(@@)(@@)(@@) $DIC_NIS$ الكردي (@)(@@) بالضم والسكون ومهملة إلى طائفة الأكراد قلت: وبالفتح وراء أخرى بعد الدال إلى كردر ناحية بخوارزم انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكرزي (@)(@@) بالضم والسكون آخره راي إلى كرز بن وبرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكرزباني (@)(@@) بضم الكاف والزاي وسكون الراء إلى كرزبان بلد قرب الطالقان.(@)(@@)(@@)(@@) $DIC_NIS$ والكرزي (@)(@@) بالفتح طلحة بن عبيد الله بن كريز إلى جده وبالضم داود بن سليمان وآخرون.(@)(@@)(@@)(@@) $DIC_NIS$ والكرسكاني (@)(@@) بفتح أوله والمهملة إلى كرسكان قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكركانجي (@)(@@) بالضم والسكون آخره جيم إلى كركانج وهي مدينة خوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الكركنتي (@)(@@) بكسر الكافين وسكون الراء والنون آخره فوقية إلى كركنت قرية بالقيروان.(@)(@@)(@@)(@@) $DIC_NIS$ الكرماني (@)(@@) بالكسر والسكون إلى كرمان ولاية كبيرة وإلى مربعة الكرمانية محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الكرمجيني (@)(@@) بالفتح والسكون وضم الميم وكسر الجيم إلى كرمجين قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الكرميني (@)(@@) بالفتح والسكون والكسر إلى كرمينية بلد بين بخارى وسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكرمي (@)(@@) إلى كرمية بالضم وتشديد الراء بلد من عمل الموصل.(@)(@@)(@@)(@@) $DIC_NIS$ والكرني (@)(@@) إلى كرنة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكرواني (@)(@@) بالفتح والسكون إلى كروان قرية بطوس وبفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ الكروخي (@)(@@) بالفتح وضم الراء آخره معجمة إلى كروخ بلد بنواحي هراة. PageV01P221(@)(@@)(@@)(@@) $DIC_NIS$ الكريزي (@)(@@) بالفتح والكسر آخره زاي إلى كريز جد وبالتصغير إلى كريز جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكريني (@)(@@) بالضم والفتح إلى كرين قرية بطبس.(@)(@@)(@@)(@@) || باب الكاف والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الكزبراني (@)(@@) بضم أوله والموحدة وسكون الزاي قبلها بعدها راء إلى كزبران جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكزماني (@)(@@) بالضم وسكون الزاي إلى كزمان جد.(@)(@@)(@@)(@@) || باب الكاف والسين(@)(@@)(@@)(@@) $DIC_NIS$ الكسادني (@)(@@) بفتح الكاف والمهملتين إلى كسادن 
ms136	 قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكسائي (@)(@@) إلى الكساء.(@)(@@)(@@)(@@) $DIC_NIS$ الكسبوي (@)(@@) بفتح أوله والموحدة وسكون المهملة إلى كسبة قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الكسكري (@)(@@) بوزنه إلى كسكر قرية بالعراق.(@)(@@)(@@)(@@) $DIC_NIS$ الكسي (@)(@@) بالكسر وتشديد المهملة وينطق بها الناس بالفتح والمعجمة إلى كس مدينة بما وراء النهر إليها عبد بن حميد.(@)(@@)(@@)(@@) || باب الكاف والشين(@)(@@)(@@)(@@) $DIC_NIS$ الكشاني (@)(@@) بالضم والمعجمة إلى كشانية بلد بالصغد.(@)(@@)(@@)(@@) $DIC_NIS$ الكشفلي (@)(@@) بفتح أوله والفاء وسكون المعجمة ولام إلى كشفل قرية بآمل طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكشكياني (@)(@@) إلى كشكيانة قرية بقرطبة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكشمردي (@)(@@) بالضم والسكون والفتح وراء ساكنة ومهملة إلى كشمرد جد ظنا.(@)(@@)(@@)(@@) $DIC_NIS$ الكشميهني (@)(@@) بالضم والسكون والكسر وتحتية وفتح الهاء ونون إلى كشمهين قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكشوري (@)(@@) بالكسر أو الفتح قولان والسكون وفتح الواو وراء إلى كشور قرية بصنعاء اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الكشوي (@)(@@) بالفتح فالضم إلى كشويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكشي (@)(@@) بالفتح والتشديد إلى كش قرية على ثلاث فراسخ من جرجان وقد مر أيضا في الكجي وفي الكسي.(@)(@@)(@@)(@@) || باب الكاف والعين(@)(@@)(@@)(@@) $DIC_NIS$ الكعبي (@)(@@) بالفتح وسكون المهملة إلى كعب بن PageV01P222 ربيعة بن عامر بن صعصعة وكعب بن عوف بن أنعم بن مراد وكعب بن عمرو بطن من خزاعة وكعب بن كاهل بطن من هذيل وكعب بن خفاجة وكعب بن جشم بطن من تميم وكعب بن الأرت.(@)(@@)(@@)(@@) || باب الكاف والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الكفربطنائي (@)(@@) بفتح الكاف والفاء والموحدة والنون إلى كفربطنا، قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرتكيسي (@)(@@) بفتح الكاف والفاء والفوقية وكسر الكاف ومهملة إلى كفرتكيس قرية بحمص.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرتوثي (@)(@@) بفتحتين وسكون الراء وضم الفوقية ومثلثة إلى كفرتوثا قرية قرب ماردين.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرجدي (@)(@@) بفتح أوله والفاء والجيم وتشديد المهملة إلى كفرجديا قرية بحران.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرسوسي (@)(@@) بفتحتين وضم المهملة الأولى إلى كفرسوسية قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرطابي (@)(@@) بفتحتين وسكون الراء ومهملة وموحدة إلى كفرطاب مدينة قرب المعرة.(@)(@@)(@@)(@@) $DIC_NIS$ الكفرييي (@)(@@) بالفتح والسكون وفتح الراء والتحتية الأولى وتشديد الياء الأخرى إلى كفريية قرية بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الكفسيسواني (@)(@@) بالفتح والسكون وكسر المهملة الأولى وكسر الأخرى إلى كفسيسوان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكفيني (@)(@@) بالفتح والكسر إلى كفين قرية بها.(@)(@@)(@@)(@@) || باب 
ms137	 الكاف واللام(@)(@@)(@@)(@@) $DIC_NIS$ الكلبي (@)(@@) إلى كلب بطن من قضاعة ومن بني ليث ومن بجيلة. PageV01P223(@)(@@)(@@)(@@) $DIC_NIS$ الكلخباقاني (@)(@@) بالضم والسكون وفتح المعجمة والموحدة والقاف إلى كلخباقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكلختجاني (@)(@@) بضم الكاف والفوقية وفتح اللام وسكون الخاء المعجمة بعدها جيم إلى كلختجان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكلدي (@)(@@) بفتحتين ومهملة إلى كلدة جد الحارث الصحابي: الكلفي: بالضم والسكون وفاء إلى كلفة بطن من تميم ومن الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ الكلماتي (@)(@@) بفتحات إلى معرفة الكلام والأصول.(@)(@@)(@@)(@@) $DIC_NIS$ الكلنكي (@)(@@) بالفتح والسكون إلى كلنك.(@)(@@)(@@)(@@) $DIC_NIS$ الكلوذاني (@)(@@) بفتح أوله والواو والمعجمة وسكون اللام إلى كلواذى قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الكلمني (@)(@@) بالضم والفتح.(@)(@@)(@@)(@@) $DIC_NIS$ الكليني (@)(@@) بالضم والكسر آخره نون إلى كلين. PageV01P224(@)(@@)(@@)(@@) $DIC_NIS$ الكليبي (@)(@@) بالتصغير وموحدة إلى كليب بطن من تميم ومن خزاعة ومن النخع.(@)(@@)(@@)(@@) || باب الكاف والميم(@)(@@)(@@)(@@) $DIC_NIS$ الكمرجي (@)(@@) بفتحتين وسكون الراء وجيم إلى كمرجة قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ الكمردي (@)(@@) بوزنه ومهملة إلى كمرد قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكمري (@)(@@) بفتحتين وراء إلى كمرة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكمساني (@)(@@) بالضم والسكون ومهملة إلى كمسان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكموني (@)(@@) بالفتح والضم إلى بني كمونة أوالي كمونة جد وإلى بيع الكمون.(@)(@@)(@@)(@@) || باب الكاف والنون(@)(@@)(@@)(@@) $DIC_NIS$ الكناركي (@)(@@) بفتح الكاف والنون والراء إلى كنارك محلة بسجستان.(@)(@@)(@@)(@@) $DIC_NIS$ الكناسي (@)(@@) بالضم والتخفيف ومهملة إلى الكناسة موضع بالكوفة وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الكناني (@)(@@) بالكسر إلى كنانة بن خزيمة والد النضر أبي قريش وكنانة بن حرب بن يشكر بن بكر بن وائل وكنانة بطن من تغلب ومن كلب وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الكنجرودي (@)(@@) بفتح أوله والجيم وضم الراء ومهملة إلى كنجرود قرية بنيسابور ويقال لها جنزرود.(@)(@@)(@@)(@@) $DIC_NIS$ الكنجكاني (@)(@@) بالفتح والسكون وضم الجيم إلى كنجكان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكندايجي (@)(@@) بالضم والسكون ومهملة ثم تحتية وجيم إلى كندايج قرية بأصبهان. PageV01P225(@)(@@)(@@)(@@) $DIC_NIS$ الكندراني (@)(@@) بضم أوله والمهملة وراء إلى كندران قرية قرب طبس.(@)(@@)(@@)(@@) $DIC_NIS$ الكندري (@)(@@) بضمهما وراء إلى بيع الكندر المعروف وكندر قرية من قزوين وأخره بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الكندسرواني (@)(@@) بفتح أوله والمهملتين وسكون النون والراء إلى كندسروان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الكندكيني (@)(@@) بالفتح والسكون وضم المهملة وكسر الكاف إلى كندكين قرية بالدبوسية.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms138	 الكندلاني (@)(@@) بضم أوله والمهملة آخره نون إلى كندلان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الكنديكتي (@)(@@) بالضم والسكون وكسر المهملة وتحتية وفتح الكاف وفوقية إلى كنديكت قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الكندي (@)(@@) بالضم والسكون إلى كندى قرية بسمرقند وبالكسر إلى كندة قبيلة من اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الكنوني (@)(@@) بفتح أوله والواو بين نونين إلى كنون محلة بسمرقند.(@)(@@)(@@)(@@) || باب الكاف والواو(@)(@@)(@@)(@@) $DIC_NIS$ الكواري (@)(@@) بالضم آخره راء إلى كوار ناحية بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الكواز (@)(@@) بالفتح والتشديد وزاي إلى عمل الكيزان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكواشي (@)(@@) بالفتح والتخفيف ومعجمة إلى كواشة قلعة بالموصل انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكوجي (@)(@@) بالضم وجيم إلى كوج جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكوراني (@)(@@) بالضم وراء إلى كوران قرية بإسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الكوزي (@)(@@) بزاي إلى الكوز وإلى كوز جد. PageV01P226(@)(@@)(@@)(@@) $DIC_NIS$ الكوشيذي (@)(@@) بالضم وكسر المعجمة آخره معجمة إلى كوشيذ.(@)(@@)(@@)(@@) $DIC_NIS$ الكوفني (@)(@@) بالضم وفتح الفاء ونون إلى كوفن بلد بخراسان.(@)(@@)(@@)(@@) $DIC_NIS$ الكوفي (@)(@@) إلى الكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ الكوفياذقاني (@)(@@) بالضم وكسر الفاء وتحتية وسكون الذال المعجمة وقاف إلى كوفياذقات قرية بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ الكوكبي (@)(@@) إلى كوكب بوزن جوهر.(@)(@@)(@@)(@@) $DIC_NIS$ الكوكلي (@)(@@) بضم الكاف الأولى وفتح الثانية إلى كوكلا جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكولخشي (@)(@@) بالضم وفتح اللام وسكون الخاء وشين معجمتين إلى كولخش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكولي (@)(@@) بالضم والفتح ولام إلى باب كول محلة بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ الكوملاباذي (@)(@@) بضم الكاف والميم وموحدة ومعجمة إلى كوملاباذ قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الكونجاني (@)(@@) بفتح الكاف والجيم وكسر الواو وسكون النون الأولى إلى كونجان قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ الكوهياري (@)(@@) بالضم وكسر الهاء وتحتية وراء إلى كوهيار ويقال قوهيار قرية بطبرستان.(@)(@@)(@@)(@@) || باب الكاف والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الكهممسي (@)(@@) بفتح أوله والميم ومهملة إلى كهمس جد.(@)(@@)(@@)(@@) || باب الكاف واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الكلاباذي (@)(@@) بالفتح وموحدة ومعجمة إلى كلاباذ محلة ببخارى وبنيسابور أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الكلابزي (@)(@@) بالفتح وكسر الموحدة وزاي إلى: تربية الكلاب. PageV01P227(@)(@@)(@@)(@@) $DIC_NIS$ الكلابي (@)(@@) بالضم والتشديد إلى عبد الله بن كلاب من المبتدعة وبالكسر والتخفيف إلى كلاب بن مرة بن كعب بن لؤي وكلاب بن ربيعة بن عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ الكلاس (@)(@@) إلى عمل الكلس.(@)(@@)(@@)(@@) $DIC_NIS$ الكلاشكردي (@)(@@) بالضم وكسر المعجمة والكاف وسكون الراء ومهملة إلى كلاشكرد قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الكلاعي 
ms139	 (@)(@@) بالفتح إلى ذي الكلاع قبيلة من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الكلالي (@)(@@) بالفتح إلى كلالة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الكلاميني (@)(@@) إلى كلامين قرية بزنجان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الكلائي (@)(@@) بالفتح والتشديد إلى الكلاء موضع بالبصرة.(@)(@@)(@@)(@@) || باب الكاف والياء(@)(@@)(@@)(@@) $DIC_NIS$ الكيال (@)(@@) إلى الكيل.(@)(@@)(@@)(@@) $DIC_NIS$ الكيخاراني (@)(@@) بالفتح وسكون التحتية وخاء معجمة وراء إلى كيخاران قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الكيزداباذي (@)(@@) بالكسر وفتح الزاي والمهملة والموحدة ثم معجمة إلى كيزداباذ قرية بطريثيث. PageV01P228(@)(@@)(@@)(@@) $DIC_NIS$ الكيساني (@)(@@) بالفتح والسكون إلى كيسان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الكيشي (@)(@@) بالكسر ومعجمة إلى كيش جزيرة في البحر.(@)(@@)(@@)(@@) | حرف اللام(@)(@@)(@@)(@@) || باب اللام والألف(@)(@@)(@@)(@@) $DIC_NIS$ اللباد (@)(@@) إلى عمل اللبود.(@)(@@)(@@)(@@) $DIC_NIS$ اللبادي (@)(@@) إلى سكة اللبادين محلة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ اللبان (@)(@@) إلى بيع اللبن: اللبشموني: بفتحتين وسكون المعجمة وضم الميم ونون إلى لبشمونة قرية بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ اللبقي (@)(@@) بفتحتين وقاف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: اللبلي (@)(@@) بالفتح والسكون ولاك أخرى إلى لبلة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) || باب اللام والباء(@)(@@)(@@)(@@) $DIC_NIS$ اللبناني (@)(@@) بالضم والسكون ونونين إلى جبل لبنان بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ اللبواني (@)(@@) بالفتح والسكون إلى لبوان بطن من المعافر.(@)(@@)(@@)(@@) $DIC_NIS$ اللبيبي (@)(@@) بالفتح والكسر إلى لبيب جد وبدال مهملة إلى لبيد وبراء إلى لبيرة بلد بالأندلس.(@)(@@)(@@)(@@) || باب اللام والجيم(@)(@@)(@@)(@@) $DIC_NIS$ اللجام (@)(@@) بالجيم إلى عمل اللجم.(@)(@@)(@@)(@@) $DIC_NIS$ اللجوني (@)(@@) بالفتح وضم الجيم المشددة ونون إلى لجون مدينة بالشام بها مسجد الخليل عليه الصلاة والسلام.(@)(@@)(@@)(@@) || باب اللام والحاء(@)(@@)(@@)(@@) $DIC_NIS$ اللحافي (@)(@@) بالكسر والمهملة وفاء إلى اللحاف. PageV01P229(@)(@@)(@@)(@@) $DIC_NIS$ اللحام (@)(@@) إلى بيع اللحم.(@)(@@)(@@)(@@) $DIC_NIS$ اللحجي (@)(@@) بالفتح وسكون المهملة وجيم إلى لحج قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ اللحياني (@)(@@) بالكسر والسكون إلى لحيان بن هذيل بن مدركة بن الياس بن مضر.(@)(@@)(@@)(@@) || باب اللام والخاء(@)(@@)(@@)(@@) $DIC_NIS$ اللخمي (@)(@@) بالفتح وسكون المعجمة إلى لخم قبيلة من اليمن.(@)(@@)(@@)(@@) || باب اللام والدال(@)(@@)(@@)(@@) $DIC_NIS$ اللدي (@)(@@) بالضم وتشديد المهملة إلى لد موضع بالشام يقتل به الدجال.(@)(@@)(@@)(@@) || باب اللام والراء(@)(@@)(@@)(@@) $DIC_NIS$ اللرقي (@)(@@) بالفتح وسكون الراء وقاف إلى لرقة حصن بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ اللري (@)(@@) بالفتح وتشديد الراء إلى لرة جد وبالضم إلى لرستان ناحية قرب جبال أصبهان.(@)(@@)(@@)(@@) || باب اللام والغين(@)(@@)(@@)(@@) $DIC_NIS$ اللغوي (@)(@@) بالضم إلى علم اللغة.(@)(@@)(@@)(@@) || باب اللام والفاء(@)(@@)(@@)(@@) $DIC_NIS$ اللفتواني (@)(@@) بالفتح وسكون 
ms140	 الفاء وضم الفوقية إلى لفتوان قرية بأصبهان.(@)(@@)(@@)(@@) || باب اللام والقاف(@)(@@)(@@)(@@) $DIC_NIS$ اللقيطي (@)(@@) بالفتح والكسر إلى لقيط جد.(@)(@@)(@@)(@@) || باب اللام والكاف(@)(@@)(@@)(@@) $DIC_NIS$ اللكاف (@)(@@) إلى عمل الإكاف.(@)(@@)(@@)(@@) $DIC_NIS$ اللكزي (@)(@@) بالفتح والسكون وزاي إلى لكز بلد بدربند.(@)(@@)(@@)(@@) $DIC_NIS$ اللكي (@)(@@) بالضم والتشديد إلى لك بلد ببرقة.(@)(@@)(@@)(@@) || باب اللام والميم(@)(@@)(@@)(@@) $DIC_NIS$ اللمغاني (@)(@@) بالفتح والسكون ومعجمة إلى لمغان موضع بغزنة.(@)(@@)(@@)(@@) || باب اللام والنون(@)(@@)(@@)(@@) $DIC_NIS$ اللنباني (@)(@@) بالضم وسكون النون ثم الموحدة ونون إلى باب لنبان محلة بأصبهان.(@)(@@)(@@)(@@) || باب اللام والواو(@)(@@)(@@)(@@) $DIC_NIS$ اللواز (@)(@@) إلى بيع اللوز.(@)(@@)(@@)(@@) $DIC_NIS$ اللوبياذي (@)(@@) بالضم وكسر الموحدة الأولى وتحتية آخره معجمة إلى لوبياباذ محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ اللوبي (@)(@@) بالضم وموحدة إلى لوبية بلد بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ اللورقي (@)(@@) بفتحتين وسكون الراء وقاف إلى لورقة بلد بالأندلس. PageV01P230(@)(@@)(@@)(@@) $DIC_NIS$ اللوري (@)(@@) بالضم آخره راء إلى لور بلد بخوزستان.(@)(@@)(@@)(@@) $DIC_NIS$ اللوزي (@)(@@) بالفتح والسكون وزاي إلى اللوزية محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ اللوشي (@)(@@) بالضم ومعجمة إلى لوشة.(@)(@@)(@@)(@@) $DIC_NIS$ اللوكري (@)(@@) بالضم وفتح الكاف وراء إلى لوكر قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ اللؤلؤي (@)(@@) إلى بيع اللؤلؤ.(@)(@@)(@@)(@@) $DIC_NIS$ اللوهوري (@)(@@) بفتح اللام والهاء وسكون الواوين إلى لوهر مدينة بالهند.(@)(@@)(@@)(@@) || باب اللام والهاء(@)(@@)(@@)(@@) $DIC_NIS$ اللهبي (@)(@@) بفتح اللام والهاء إلى أبي لهب وبالكسر والسكون إلى لهب بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ اللهزمي (@)(@@) بالزاي إلى اللهازم هم تيم الله بن ثعلبة وقيس بن ثعلبة وعجل بن لخم بن صعب.(@)(@@)(@@)(@@) || باب اللام والياء(@)(@@)(@@)(@@) $DIC_NIS$ الليثي (@)(@@) إلى ليث بن كنانة وليث بن جداد بن عبد القيس وإلى جد.(@)(@@)(@@)(@@) $DIC_NIS$ الليموسكي (@)(@@) بالكسر والسكون وضم الميم وسكون الواو والمهملة إلى ليموسك قرية بإسترباذ.(@)(@@)(@@)(@@) $DIC_NIS$ الليني (@)(@@) بالكسر آخره نون إلى اللين قرية. PageV01P231(@)(@@)(@@)(@@) | حرف الميم(@)(@@)(@@)(@@) || باب الميم والألف(@)(@@)(@@)(@@) $DIC_NIS$ المابرسامي (@)(@@) بفتح الموحدة والمهملة وسكون الراء إلى مابرسام قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ المابي (@)(@@) بموحدة إلى مابة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماتريتي (@)(@@) بضم الفوقية وكسر الراء وتحتية وفوقية إلى ماتريت ويقال ما تريد محلة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الماجرمي (@)(@@) بفتح الجيم وسكون الراء إلى ماجرم قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الماجندني (@)(@@) بفتح الجيم وسكون النون إلى ماجندن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الماحوزي (@)(@@) بضم المهملة وزاي إلى الماحور قرية بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ 