ms241	 بزا % % PageV01P845 البحر : كامل تام 1(@)(@@) % شرف الخلافة يا بني العباس % % اليبوم جدده أبو العباس % % 2(@)(@@) % وافى لحفظ فروعها وكنيه % % كان المشير مواضع الأغراس % 3(@)(@@) % هذا الذي رفعت يداه بنا % % ئها العالي وذاك موطد الاساس % % 4(@)(@@) % ذا الطود بقاه الزمان ذخيرة % % من ذلك الجبل العظيم الراسي % % 5(@)(@@) % ملك تطاوح مالكوه وأصبحوا % % منه وراء معالم أدراس % 6(@)(@@) % غاب أبن به ضراغم هاشم % من كل أغلب للعدى فراس % 7(@)(@@) % حتى نبا بهم الزمان فازعجوا % % عن تلكم الأغيال والأخياس % 8(@)(@@) % فاليوم لم العز بعد تشعت % % وأعيد ذكر الدين بعد تناس % 9(@)(@@) % قد كان زعزك الزمان فراعه % % عود على عجم النوائب عاس % % 10(@)(@@) % ما كان غير مجرب لك في العلى % % لتكون راعي الامر دون الناس % % PageV01P846 11(@)(@@) % فبلاك عيب البأس يوم كريهة % ورآك طود الحلم يوم مراس % % 12(@)(@@) % فلأنت قائم سيفها الذرب الشبا % % مجدا ووابل نؤها الرجاس % % 13(@)(@@) % من معشر وسموا الزمان مناقبا % تبقى بقاء الوحي في الأطراس % 14(@)(@@) % مترادفين على المكارم والعلى % % متسابقين إلى الندى والباس % 15(@)(@@) % طلعوا على مروان يوم لقائه % من كل أروع بالقنا دعاس % 16(@)(@@) % سدوا النجاء عليه دون جمامه % % بقراع لا عزل ولا نكاس % % 17(@)(@@) % بالزاب والآمال واقفة الخطى % % بين الرجاء لنيلها والياس % % 18(@)(@@) % حتى رأى الجعدي ذل قياده % % ليد المنون تمد بالأمراس % 19(@)(@@) % وهوت به أيد أناملها القنا % % مهوى كليب عن يدي جساس % % 20(@)(@@) % ضربوه في بطن الصعيد بنومة % % PageV01P847 21(@)(@@) % وتسلموها غضة ، فمضى بها % % الأبرار ناشزة عن الأرجاس % 22(@)(@@) % فالان قر العز في سكناته % % ثلج الضمائر بارد الأنفاس % 23(@)(@@) % وقفت أخامص طالبيه ، ورفهت % ايد نفضن معاقد الاجلاس % % 24(@)(@@) % واحتل غاربه ولي خلافه % % ما كان يلبسها على ألباس % 25(@)(@@) % سبق الرجال إلى ذراها ناجيا % من ناب كل مجاذب نهاس % % 26(@)(@@) % يقطان يخرج في الخطوب وينثني % % ولهاه للكلم الرغيب أواس % 27(@)(@@) % ويرق أحيانا ، وبين ضلوعه % قلب على المال المثمر قاس % 28(@)(@@) % تغدوا ظبا البيض الرقاق بقلبه % % احلى واعذب من ظباء كناس % % 29(@)(@@) % وكأن حمل السيف يقطر غربه % % أنسى يمين يديه حمل الكاس 
ms242	 % 30(@)(@@) % احسود ذي الثغر الشوادخ انها % % حرم على الاغيار للافراس % % PageV01P848 31(@)(@@) % لا تحسدن قوما اذا فاضلتهم % % فضلوك في الأخلاق والأجناس % 32(@)(@@) % واذا رميت الطرف راعك منهم % % أطلال أجبال عليك رواس % 33(@)(@@) % كانوا نجوما ثم شعشع نورهم % % والنار أولها من الأقباس % 34(@)(@@) % مجد امير المؤمنين اعدته % % غضا كنور المورق المياس % 35(@)(@@) % وبعثت في قلب الخلافة فرحة % دخلت على الخلفاء في الأرماس % 36(@)(@@) % ومكيدة أشلى عليك نيوبها % % غضبان للقربى القريبة ناس % % 37(@)(@@) % فغرت اليك ففتها وتراجعت % % ففرته بالأنياب والأضراس % 38(@)(@@) % حمراء من جمر الخطوب وطئتها % % فلبست فيها الصبر اي لباس % % 39(@)(@@) % فردا سلكت بها المضيق وإنما % % طرق العلاء قليلة الإيناس % 40(@)(@@) % اورق امين الله عودي انما % % أغراس أصلك في العلى أغراسي % % PageV01P849 41(@)(@@) % واملك على من كان قبلك شاؤه % % في فرط تقريبي ، وفي إيناسي % % 42(@)(@@) % إني لأجتنب السؤال متاركا % خلفا يدر علي بالإبساس % 43(@)(@@) % ولقد اطعتك طاعة مارامها % % مني امرؤ الا عصاه شماسي % % 44(@)(@@) % فرت إليك ، بغير داع ، همتي % % وصغا إليك ، بلا قياد ، راسي % % PageV01P850 البحر : طويل 1(@)(@@) % تمنى رجال نيلها ، وهي شامس % واين من النجم الاكف اللوامس % % 2(@)(@@) % وإن المعالي عن رجال طلائق % وهن على بعض الرجال حبائس % 3(@)(@@) % ولم أر كالعلياء ترضى على الأذى % % وتهوى على علاتها ، وهي عانس % % 4(@)(@@) % فقل للحسود اليوم أغض على القذى % % فما كل نار أوقدت أنت قابس % 5(@)(@@) % وما لك والاقدام بالخيل والقنا % % وحظك عن نيل العلى متقاعس % 6(@)(@@) % وهل نافع يوما وجدك راجل % اذا قيل يوم الروع انك فارس % % 7(@)(@@) % فطب عن بلوغ العز نفسا لئيمة % فمتا للعلى الا النفوس النفائس % % 8(@)(@@) % وإن قوام الدين من دون ثغرها % % له ناظر يقظان والنجم ناعس % % 9(@)(@@) % رعاها بهم لا يمل وهمة % إذا نام عنها حارس قام حارس % 10(@)(@@) % أخو الحرب ذاق الرائعات وذقنه % ونال ، ونالته القنا والفوارس % PageV01P851 11(@)(@@) % يغاديك يوم السلم طلقا ، وفكره % يمارس حد الروع فيما يمارس % 12(@)(@@) % كان ملوك الأرض حول سريره % % بغاث وقوف والقطامي جالس % % 13(@)(@@) % اذا رمقوه والجفون كواسر % % على غير داء والرقاب نواكس 
ms243	 % % 14(@)(@@) % يحيون وضاحا ، كأن جبينه % سنا قمر ما غيرته الحنادس % % 15(@)(@@) % تصرف اعناق الملوك لامره % % وتستخدم الأعضاء والرأس رائس % 16(@)(@@) % من القوم حلوا بالربى وأمدهم % قديم المساعي ، والعلاء القدامس % 17(@)(@@) % تحلهم دار العدو شفارهم % وترعيهم الأرض القني المداعس % 18(@)(@@) % بهاليل ازوال بكل قبيلة % % ملاذع من نيرانهم ومقابس % % 19(@)(@@) % وما جلسوا الا السيوف معدة % % ليوم الوغى ، والمرء ممن يجالس % 20(@)(@@) % اذا اخطئوا مرمى من المجد اجهشوا % % زئير الضواري افلتتها الفرائس % % PageV01P852 21(@)(@@) % فمن خائض غمر الردى غير ناكص % ومن صافق يوم الندى لا يماكس % % 22(@)(@@) % اذا ما اجتداه المجتدون على الطوى % % يبيت رطيب الكف والبطن يابس % % 23(@)(@@) % له في الاعادي كل شوهاء يهتدي % % بتهدارها طلس الذئاب اللغاوس % % 24(@)(@@) % ونشاجة تحت الضلوع مرشة % % كما هاع مملوء من الخمر قالس % % 25(@)(@@) % مطرقة الجالين هطلى كأنما % % 26(@)(@@) % ألا رب حي من رجال أعزة % أسالت بهم منك الغمام الرواجس % 27(@)(@@) % أرادوك بالأمر الجليل فردهم % على عوج الاعقاب جد ممارس % % 28(@)(@@) % تطاعنهم عنك السعود بجدها % % ولا يتقي طعن المقادير تارس % % 29(@)(@@) % اذا افلتوا طعن الرماح رمتهم % % بطعن عواليها النجوم الاناحس % % 30(@)(@@) % سلبتهم عز الثراء ، فلم تدع % لهم ما يرى منه العدو المنافس % % PageV01P853 31(@)(@@) % فما لهم ، غير الشعور ، عمائم % ولا لهم ، غير الجلود ، ملابس % 32(@)(@@) % وعمتهم من حد بأسك سطوة % بها اجتدعت اعناقهم لا المعاطس % % 33(@)(@@) % فما جازها في ذروة النيق صاعد % % ولا فاتها في لجة الماء قامس % % 34(@)(@@) % ولا ناطق للخوف إلا مخافت % ولا ناظر للذل إلا مخالس % 35(@)(@@) % ترى الاب ينبو عن بنيه ويتقي % % اخاه الفتى وهو القريب الموانس % % 36(@)(@@) % وليس يحيا منهم اليوم طالع % % هوانا ولا يجدي اذا اعتام بائس % % 37(@)(@@) % تملس أعواد القنا من أكفهم % % وينفضهم من عن قطاها العوانس % 38(@)(@@) % يكون مزر المرء غلا لعنقه % من الخوف ، حتى ينزع الثوب لابس % 39(@)(@@) % إذا ضربوا في الأرض فهي مهالك % وإن أوطنوا الأبيات فهي محابس % 40(@)(@@) % وعاطسهم في الحفل غير مشمت % فكالنابح العاوي من القوم عاطس % PageV01P854 41(@)(@@) % واطرق شيطان الغواية منهم % % فلم يبق من نعابة 
ms244	 الغي نابس % % 42(@)(@@) % وعند طبيب المعضلات شفاؤهم % % إذا عاد من داء العداوة ناكس % 43(@)(@@) % فيوماه يوم بالمواهب غائم % علينا ويوم بالقواضب شامس % % 44(@)(@@) % سجية بسام يقول عدوه % % أهذا الذي يلقى الوغى وهو عابس % 45(@)(@@) % نزاد ، ويروى الأبعدون بمائكم % ونحن على الورد الظماء الخوامس % 46(@)(@@) % وتندى لقوم آخرين سحابكم % % ونحن مناشي ارضكم والغرائس % % 47(@)(@@) % رجوتك والعشرون ما تم عقدها % % فلم انا من بعد الثلاثين آيس % % 48(@)(@@) % ولي خدمة قدمتها لتعزني % % ولولا الجنى ما رجب الفرع غارس % % 49(@)(@@) % وما همتي الا المعالي وانني % % على المرء بالعلياء لا المال نافس % 50(@)(@@) % وقد غار حظ أنت ثاني جماحه % وتقدع من بعد الجماح الشوامس % % PageV01P855 51(@)(@@) % عسى ملك الأملاك ينتاش أعظما % برتهن ذؤبان الليالي النواهس % 52(@)(@@) % وقد كنت شمت العز منك وجادني % % بغيظ الأعادي ماطر منه راجس % 53(@)(@@) % فباعدني من صوب مزنك حاسد % % يضاحك ثغري والجنان معابس % % 54(@)(@@) % يريني حنانا وهو يضمر بغضه % % كلا ناظرينا من قلى متشاوس % 55(@)(@@) % فجدد يدا عندي يرف لباسها % % فقد اخلقت تلك الايادي اللبائس % % 56(@)(@@) % وبابك اولى بي من الأرض كلها % % فحتام لي عن قرع بابك حابس % % 57(@)(@@) % واقسم لولا ان دارك فارس % % لما انتصفت من ارض بغداد فارس % % PageV01P856 البحر : طويل 1(@)(@@) % أقول لركب خابطين إلى الندى % % رموا غرضا والليل داجي الحنادس % 2(@)(@@) % أقيموا رقاب اليعملات ، فإنني % % سأستمطر النعماء نوءا بفارس % % 3(@)(@@) % بنانا إذا سيم الحيا غير باخل % ووجها اذا سيل الندى غير عابس % % 4(@)(@@) % أحب ثرى أرض أقمت بجوها % % وان كان في ارض سواها مغارسي % % 5(@)(@@) % وكم رفعت لي نار حي فجزتها % % وما نار ممنون القرى من مقابسي % % 6(@)(@@) % نزعت فخاري يوم البس نعمة % % لغيرك ، ما زرت علي ملابسي % % 7(@)(@@) % اذا كنت لي غيثا فانت غرستني % % ومورق عودي بالندى مثل غارسي % % 8(@)(@@) % تركت رجالا لم يهشوا لمنة % ولم ينقعوا غل الظماء الخوامس % 9(@)(@@) % على القرب إني فيهم غير طامع % ومنك على بعد المدى غير آيس % % 10(@)(@@) % غياث الندى ضمت اكف واغلقت % % على اللؤم ابواب النفوس الخسائس % % PageV01P857 11(@)(@@) % ولولاك أمسى الناس 
ms245	 في كل مذهب % على اثر من معلم الجود طامس % % 12(@)(@@) % عضلت ثنائي عنهم وذخرته % % لأبلج ممنون النقيبة رائس % 13(@)(@@) % وما كنت إلا الطرف يمنع ظهره % جبانا ويعطي ظهره كل فارس % % PageV01P858 البحر : مجزوء الكامل 1(@)(@@) % لا ترقدن على الأذى % % واعزم كما عزم ابن موسى % % 2(@)(@@) % لما ألظ به العدى % % عنتا ، وأضرارا وبوسا % % 3(@)(@@) % ورموا إليه نواظرا % كاسنة اليزني شوسا % % 4(@)(@@) % أغضى لهم ، وأثار لي % الغاب يقتنص النفوسا % % 5(@)(@@) % غضبان يغلي بالزماجر % % جر كلما نظر الفريسا % % 6(@)(@@) % يتنكب اللحم الذلي % % ل ويطلب العضو الرئيسا % % 7(@)(@@) % اظننتموه على الاذى % % في داركم أبدا حبيسا % % 8(@)(@@) % إن الذلول على القوا % % عاد بعدكم شموسا % % 9(@)(@@) % وارم مثل الصل ينتظر % % تظر التي تشفي النسيسا % % 10(@)(@@) % حتى أحد لكم حسا % % ما قاطعا نغض الرؤوسا % % PageV01P859 11(@)(@@) % اما عقرن ظباه اعجلن % % ظباه أع % 12(@)(@@) % ان تفجئوا بدخانها % % فيعقب ما شجر الوطيسا % % 13(@)(@@) % كيدا سرى لكم ، ولم % تسمع له أذن حسيسا % % 14(@)(@@) % قد ينزع اللين الكريم % % ويلبس الخلق الشريسا % % 15(@)(@@) % وتكون طلقا ثم يؤنس % % نس ذلة فيرى عبوسا % % 16(@)(@@) % ويعود مر الطعم لا % % عذب المذاق ولا مسوسا % % 17(@)(@@) % جلن العقاير أن تكوسا % % كن طرقت لكم ببوسى % % 18(@)(@@) % وغمطتم تلك السعود % % فابدلت بكم نحوسا % % 19(@)(@@) % وأهنتم ثوب العلى % % فغدى الهوان لكم لبوسا % % 20(@)(@@) % من بعد ما حلتكم ال % % علياء جوهرها النفيسا % % PageV01P860 21(@)(@@) % حتى ظننا الله ليس % % س برازق إلا خسيسا % % 22(@)(@@) % يا حسنكم في الدهر أذ % نابا واقبحكم رؤوسا % % 23(@)(@@) % خلوا الطريق لمن تع % ان تجربه خميسا % % 24(@)(@@) % ودعوا السياسة في العلى % % لأغر يحسن أن يسوسا % % 25(@)(@@) % هذا خمار فتى ادار م % % ر من البلاء لكم كؤوسا % % PageV01P861 البحر : كامل تام 1(@)(@@) % يا ذاكر النعماء إن نسيت % ومجدد المعروف ان درسا % % 2(@)(@@) % ومنبه الآمال ان رقدت % % بالطول لا اغفى ولا نعسا % % 3(@)(@@) % نصل اذا وقف النصول مضى % % جبل إذا اضطرب الجبال رسا % % 4(@)(@@) % لله بحر ما هتفت به % % حتى استهل على وانبجسا % % 5(@)(@@) % أجممت جمته ، ففاض بها % % يطأ الربى ويبلل اليبسا % % 6(@)(@@) % زخرت 
ms246	 غواربه إلي ، ولم % يقل الرجاء لعلما وعسا % % 7(@)(@@) % وأغر مختلس مكارمه % إن الكريم يرى الندى خلسا % % 8(@)(@@) % غرس الصنائع ثم عاد به % % عود الندى فسقى الذي غرسا % % 9(@)(@@) % كالعضب فيه صاقل عمل % ينفي القذى ويباعد الدنسا % % 10(@)(@@) % من معشر ركبوا المكارم في % % أولى الزمان مصاعبا شمسا % % PageV01P862 11(@)(@@) % شغلوا ملابسها فلم يدعوا % % للناس الا الدنس اللبسا % % 12(@)(@@) % العاطفون ، إذا الصديق نبا % % والمحسنون اذا الزمان اسا % % 13(@)(@@) % واذا خناق الكرب ضاق بنا % % ردوا النفوس ورددوا النفسا % % 14(@)(@@) % ما ضر من مطروا ببلدته % إن كان ماء المزن محتبسا % % 15(@)(@@) % لا أزلق اليوم العبوس لكم % قدما ، ولا أطفى لكم قبسا % % 16(@)(@@) % لا تفترن على الزمان ، وإن % عثر الزمان بعزكم تعسا % % PageV01P863 البحر : بسيط تام 1(@)(@@) % خذي حديثك من نفسي عن النفس % % وجد المشوق المعنى غير ملتبس % % 2(@)(@@) % الماء في ناظري والنار في كبدي % % إن شئت فاعترفي ، أو شئت فاقتبسي % % 3(@)(@@) % كم نظرة منك تشفي النفس عن عرض % % وترجع القلب مني جد منثكس % % 4(@)(@@) % تلذ عيني وقلبي منك في الم % % فالقلب في مأتم والعين في عرس % 5(@)(@@) % كم الفؤاد ، حبيسا ، غير منطلق % ودمع عيني ، طليقا ، غير منحبس % 6(@)(@@) % على الزمان على الخلصاء يسمح لي % % يوما بذاك اللمى الممنوع واللعس % 7(@)(@@) % يقول مني كأن الحب اوله % % فكيف أذكرني هذا الضنا ونسي % % 8(@)(@@) % قل لليالي فري نحضي على بدني % % أو فاعرقيني بالانياب وانتهسي % % 9(@)(@@) % خذي سلاحك لي ان كنت اخذة % % قد امكن الناشط الذيال وافترسي % % 10(@)(@@) % فكم اريغ العلى والحظ في صبب % % وكم أقول : لعا ، والجد في تعس % PageV01P864 11(@)(@@) % نذبذب الرزق لا فقر ولا جدة % % حظ لعمرك لم يحمق ولم يكس % % 12(@)(@@) % في كل يوم بسربي منك غادية % إحالة الذئب باد غير مختلس % 13(@)(@@) % فوهاء تفغر نحوي ، وهي ساغبة % شجو الوليد اذا ماعب في النفس % % 14(@)(@@) % يا يؤس الدهر ألقاني بمسبعة % % وقال لي عند غيل الضيغم احترس % % 15(@)(@@) % مضر الرجال الاولى كانت نقائبهم % % لا بالرجاع ، ولا المبذولة اللبس % 16(@)(@@) % وصرت أهون عند الحي بعدهم % مما على الابل الجربا 
ms247	 من العبس % % 17(@)(@@) % استنزل الرزق من قوم خلائقهم % % شمس الاعنة عند الزجر والمرس % % 18(@)(@@) % يستبدلون بي الأبدال معجزة % من يرضى بالعير يهجر كامل الفرس % % 19(@)(@@) % العرض يترك للرامي بمضيعة % والمال يحفظ بالأعوان والحرس % 20(@)(@@) % يحصنون على الراجي مطالعه % % خوفا من السلة الحذاء والخلس % PageV01P865 21(@)(@@) % اصبحت حين اريغ النفع عندهم % % كناشد الغفل بين العمي والخرس % % 22(@)(@@) % لقد زللت وكانت هفوة امما % % أيام أرجو الندى الجاري من اليبس % 23(@)(@@) % وان اعجز من لاقيت ذو امل % % يرجو الصلا عند زند ضن بالقبس % % 24(@)(@@) % أيا الذوائب من قومي أوازنهم % لقد وزنت الصفا العادي بالدهس % 25(@)(@@) % يا صاحبي اشددا النضوين ، وانطلقا % % إن سلم الله أفجرنا من الغلس % 26(@)(@@) % لا تنظرا غير وعد السيف آونة % من لم يرس بذباب السيف لم يرس % % 27(@)(@@) % سيرا عن الوطن المذموم واتبعا % % إلى الاباء قياد الانفس الشمس % % 28(@)(@@) % ولا تقيما على صعب مغالقه % % بعرضه ما بثوبيه من الدنس % % PageV01P866 البحر : سريع 1(@)(@@) % قربت بالبعد من الناس % % وفضت الأطماع بالياس % 2(@)(@@) % إلا بقايا من جميع الهوى % % تهفو بلب الجبل الراسي % % 3(@)(@@) % دمعي كجودي عند بذل الندى % % وحر بأسي مثل انفاسي % % 4(@)(@@) % وجهي رقيق يستشف الحيا % % منه ، وقلبي دونه قاس % 5(@)(@@) % لاحظ في المجد لمن لم يزل % % في حيز الإبريق والكاس % 6(@)(@@) % كل غلام رام خدع العلى % % يلطف في بري وايناسي % % PageV01P867 البحر : طويل 1(@)(@@) % بقاء الفتى مستأنف من فنائه % % وما الحي الا كالمغيب في الرمس % % 2(@)(@@) % ارى الناس ورادين حوضا من الردى % % فمن فارط أو بالغ الورد عن خمس % 3(@)(@@) % ويجري على من مات دمعي وما له % % بكيت ولكني بكيت على نفسي % % 4(@)(@@) % وكل فتى باق سيتبع من مضى % % وكل غد جاء سيلحق بالأمس % 5(@)(@@) % فلا يبعدنك الله من متفرد % رأى الموت انسا فاستراح إلى الانس % % 6(@)(@@) % أقول وقد قالوا مضى لسبيله % مضى غير رعديد الجنان ولا نكس % % 7(@)(@@) % كان حداد الليل زاد سواده % % عليك ورد الضوء من مطلع الشمس % 8(@)(@@) % أرى كل رزء دون رزئك قدره % فليس يلاقيني ليومك ما ينسي % % PageV01P868 البحر 
ms248	 : وافر تام 1(@)(@@) % بقلبي للنوئب جانحات % % عماق القعر موئسة الاواسي % % 2(@)(@@) % اقارع شغبها لو كان يغني % % قراعي للنوائب أو مراسي % % 3(@)(@@) % وتعذمني فتخطي صفحتيها % % عذامي يوم اعذم أو ضراسي % % 4(@)(@@) % كأني بين قادمتي نزور % تراوح بين ولغي وانتهاسي % % 5(@)(@@) % ولم يلبثن غربان الليالي % % نغيقا ان اطرن غراب راسي % % 6(@)(@@) % وما زال الزمان يحيف حتى % % نزعت له على مضض لباسي % % 7(@)(@@) % نضى عني السواد بلا مرادي % % وأعطاني البياض بلا التماسي % % 8(@)(@@) % اروع به الظباء وقد اراني % % زميلا للغزال إلى الكناس % 9(@)(@@) % لمسقط حامل الشعرات عني % % بحد السيف في اليوم الغماس % % 10(@)(@@) % أحب إلي من نزعي رداء % كسانيه الشباب واي كاس % % PageV01P869 11(@)(@@) % واخلق وهو يذكرني التصابي % % وعود النبع يغمز وهو عاس % 12(@)(@@) % وددت بان ما تخبى المواضي % % بدال لي بما جنت المواسي % % 13(@)(@@) % وبغضني المشيب إلى لداتي % % وهونني البقاء على أناسي % % 14(@)(@@) % خذوا بأزمتي فلقد أراني % % قليلا ما يلين لكم شماسي % % 15(@)(@@) % اليس إلى الثلاثين انتسابي % % ولم أبلغ إلى القلل الرواسي % % 16(@)(@@) % فمن دل المشيب على عذاري % % وما جر الذيول على غراسي % % 17(@)(@@) % سابكي للشباب بشاردات % % كصاردة السهام عن القياس % % 18(@)(@@) % يعلل شدوها الطلح المعنى % % اذا سقط العصي من النعاس % % 19(@)(@@) % فمن يك ناسيا عهدا فاني % % لعهدك يا شبابي غير ناس % 20(@)(@@) % وكنت عليك مع طمعي جزوعا % % فكيف يكون وجدي بعد ياسي % % PageV01P870 21(@)(@@) % لضاع بكاء من يبكيك شجوا % ضياع الدمع بالطلل الطماس % 22(@)(@@) % ولو اجدى البكاء على نوار % % لاعيي الدمع عين أبي فراس % % 23(@)(@@) % فان العيش بعدك غير عيش % % وإن الناس بعدك غير ناس % PageV01P871 البحر : كامل تام 1(@)(@@) % أمضرة بالبدر طالعة % عند العيون ، وضرة الشمس % 2(@)(@@) % أنا منك في كمد على كمد % يومي علي امر من امسي % % 3(@)(@@) % جنية وقبيلها بشر % عظم البلاء بها على الإنس % 4(@)(@@) % وتقول لما جئت اسئلها % % كيف الشفاء لداء ذي النكس % % 5(@)(@@) % عجبا له اذ جاء يسئل من % % مس الفؤاد رقي من المس % % 6(@)(@@) % لا تنكري هذا النحول اما % % نفسي تذوب عليك من نفسي % % PageV01P872 البحر : طويل 1 
ms249	(@)(@@) % هم خلفوا دمعي طليقا وغادروا % % فؤادي على داء الغرام حبيسا % % 2(@)(@@) % طلاع الحشى لم يتركوا فيه فضلة % تضم جوى من بعدهم ورسيسا % % 3(@)(@@) % يخافكم قلبي وأنتم احبة % % كأن الأعادي ينظروني شوسا % % 4(@)(@@) % لقد خفت عيني أن تكون طليعة % لكم وفؤادي ان يكون دسيسا % % PageV01P873 البحر : مجزوء الخفيف 1(@)(@@) % باح بالمضمر الدفين لس % % ان من النفس % % 2(@)(@@) % عن مبل من الجوى % % راجع الداء فانتكس % 3(@)(@@) % ما لقلبي عن السلو % % رأى النار فاقتبس % % 4(@)(@@) % جددت نظرة المهاة % % من الوجد ما درس % % 5(@)(@@) % طلبت غرة الفؤاد % % د المعنى ، وما احترس % 6(@)(@@) % ركبت صبغة الهلال % % ل على صبغة الغلس % 7(@)(@@) % في خمار من اللمى % % وقميص من اللغس % % PageV01P874 البحر : بسيط تام 1(@)(@@) % كنا نعظم بالآمال بعضكم % ثم انقضت فتساوى عندنا الناس % % 2(@)(@@) % لم تفضلونا بشيء غير واحدة % % هي الرجاء ، فسوى بيننا الياس % PageV01P875 البحر : بسيط تام 1(@)(@@) % كم عرضوا لي بالدنيا وزخرفها % % مع الهلوك فلم ارفع بها رأسا % 2(@)(@@) % وكيف يقبل رفد الناس محتملا % % ذل المطالب من لا يمدح الناسا % % PageV01P876 البحر : طويل 1(@)(@@) % ومعتادة للطيب ليست تغبه % منغمة الاطراف تدمى من اللمس % % 2(@)(@@) % إذا ما دخان الند من ثوبها علا % % على وجهها ابصرت غيما على شمس % % PageV01P877 البحر : وافر تام 1(@)(@@) % لتبدي اليوم نسوة آل كعب % % بأجياد مدماة الخدوش % 2(@)(@@) % على الفرسان من سلفي تميم % يثلهم الردى ثل العروش % % 3(@)(@@) % مضوا وبقيت بعدهم مهيضا % كما نهض الجناح بغير ريش % % 4(@)(@@) % ومن نهشت اسنة آل كعب % % فلا درياق للرجل النهيش % % 5(@)(@@) % فيا نفس اذهبي اسفا عليهم % % فبعدهم كموتك ان تعيشي % % PageV01P878 البحر : - 1(@)(@@) % ما هاج ذي طرب مخماص % % ليل أبي العوام والقلاص % % 2(@)(@@) % أرسلها خمصاء في خماص % زوراء من رعي الجميم الواصي % % 3(@)(@@) % بعد مطال القرب البصاص % % رام إلى غايتها الاقاصي % % 4(@)(@@) % قذى المآقي لبد العناصي % % في مطلق انجمه شواصي % % 5(@)(@@) % لمع المداري جلن في العقاص % كان خفق الكوكب الوباص % % 6(@)(@@) % زرقاء من زرق بني ملاص % % حتى اتقين الشمس بالنواصي % % 7(@)(@@) % مفتقة من جانب النشاص % % تطلع الرود من الخصاص % 8 
ms250	(@)(@@) % مالي وما للقدر المعاصي % % كالعير مضروبا على القماص % 9(@)(@@) % اين أبو العوام للعواصي % % يروضها والخيل والدلاص % % 10(@)(@@) % ورعيها بين القنا العراص % من آمن القلام والقراص % PageV01P879 11(@)(@@) % وللقرى والطرق الخراص % وللقنا يلدغن بالاخراص % % 12(@)(@@) % هيهات لا حامي إلى العراص % % شيم الظبي وضمت القواصي % % 13(@)(@@) % سم المطايا ليلة الارقاص % % يرجعن ارماقا بلا اشخاص % % 14(@)(@@) % زاد الفتى والقوم في انتقاص % % وبعدوا عن جامح فحاص % % 15(@)(@@) % بعد اللغاديد من القصاص % قام المجاري وكبى المناصي % % 16(@)(@@) % من معشر مطيب الأعياص % بين لباب المجد والمصاص % % 17(@)(@@) % لهم بآداب الندى تواصي % % من كل سباق المدى نواص % 18(@)(@@) % قوم لا عناق العدى قواص % % قرن لقاء عجل الاقعاص % % 19(@)(@@) % يا قبر بين القور والدعاص % ضم على لؤلؤ الغواص % % 20(@)(@@) % ضم الوعا وبز بالعقاص % سقيت من داني الحيا والقاصي % % PageV01P880 21(@)(@@) % قاد ابن ليلى قائد المعتاص % % كان سياغي فغدا اغتصاصي % % 22(@)(@@) % ما اثقل اليأس على الحراص % % هل لجروح الدهر من قصاص % 23(@)(@@) % جد الردى والناس في حياص % حيد الأقاطيع عن القناص % 24(@)(@@) % قد ينزل العالي من الصياصي % % وقد يطيع الرأس وهو عاصي % % 25(@)(@@) % أمر لجام القدر القراص % ما شاء من حكم فلا مناص % % PageV01P881 البحر : كامل تام 1(@)(@@) % يا بؤس مقتنص الغزال طماعة % ذهب الغزال بلب ذاك القانص % % 2(@)(@@) % كالدرة البيضاء حان ضياعها % % من بعد ما ملأت يمين الغائص % 3(@)(@@) % ما كان قربك غير برق لامع % % ولى الغمام به وظل قالص % % 4(@)(@@) % أغدو على أمل كحبك زائد % واروح عن حظ كوصلك ناقص % % PageV01P882 البحر : كامل تام 1(@)(@@) % لمن الديار طلولها وقص % % ما للقطين بعقرها شخص % % 2(@)(@@) % ابقى الخليط بها معاهدة % % اثر لعمرك ما له قص % % 3(@)(@@) % ولقد تحل بها مرببة % ظمأى الوشاح وللبرى غص % 4(@)(@@) % غنيت بحلي الحسن عاطلة % % ما للنضار بجيدها وبص % 5(@)(@@) % فرعاء ان نهضت لحاجتها % % عجل القضيب وابطيء الدعص % % 6(@)(@@) % ومرجل جعد ينوء به % جيد الغزال وناعم رخص % % 7(@)(@@) % سرقت بطرف الريم مهجته % ومن النواظر قاطع لص % 8(@)(@@) % قسما بشعث جعجعت لهم % % بالمأزمين ظوالع خص % % 9(@)(@@) % طعنوا الظلام بكل ناجية 
ms251	 % % في موق كل دجى لها بحص % 10(@)(@@) % ترمي الإكام بمنسم عمم % دامي الأظل كأنه قرص % PageV01P883 11(@)(@@) % والراجمين جمارها بمنى % % غدوا وما حلقوا وما قصوا % % 12(@)(@@) % متجردين من الرياض ضحى % % حل النطاق واطلق العقص % % 13(@)(@@) % لاسقينك كاس لاذعة % % لا العب ينفذها ولا المص % % 14(@)(@@) % بقوارع يمسي الرمي بها % % من غير ما طرب ، له رقص % 15(@)(@@) % تنسي جرائحها قوارصها % % والطلق ينسى عنده المغص % % 16(@)(@@) % أإلى معد جئت مرتقيا % يا عير ! أين رمى بك القمص % 17(@)(@@) % أمن الوهاد إلى الربى عجلا % سرعان ذا الذملان والنص % 18(@)(@@) % الحقت ريشك في قوادمهم % % عجلان تلصقه وينحص % % 19(@)(@@) % إن زدتهم ، فلقد نقصتهم % إن الزيادة بالشغا نقص % 20(@)(@@) % غادرتها شنعاء ضاحية % % لا النقس يصبغها ولا الحص % % PageV01P884 21(@)(@@) % ومن المخازي عند لابسها % % ما لا تواري الازر والقمص % % 22(@)(@@) % يا موعدي بذناب مخلبه % % ان البعوض اذاته القرص % % 23(@)(@@) % لا تحسدن المرء ثروته % % ان البطان إلى غد خمص % % 24(@)(@@) % وخف السقاط على الذين علوا % % ومن العلو يحاذر الوقص % 25(@)(@@) % واعقد يديك بمجتنى كرم % % لاقدح في حسب ولا غمص % % 26(@)(@@) % اسد اذا بصر الرجال به % % خفض الكلام وطومن الشخص % % 27(@)(@@) % من معشر ركبت اوائلهم % % أولى العلى ، وجيادها شمص % 28(@)(@@) % ان احسنوا عموا بنائلهم % % واذا رموا بجزيرة خصوا % % 29(@)(@@) % عدد المكارم في بيوتهم % والجامل القبقاب والقبص % 30(@)(@@) % رفعوا المساعي من قواعدها % % يعلو بهن الرضم والرص % % PageV01P885 31(@)(@@) % حتى انثموا في رأس اشرفها % % وعلى الكعوب يوقع الخرص % 32(@)(@@) % افنى العدو وليس ينقصهم % % من رمل منقطع اللوى القبص % % PageV01P886 البحر : خفيف تام 1(@)(@@) % رب مستغمز إبائي وفي النا % % اس ذلول على الاذى وقموص % % 2(@)(@@) % ناصب لي حبائل الطمع المز % ري ، وغيري للمطمعات قنيص % 3(@)(@@) % بذل المال لي يساوم عرضي % % ان عرضي اذا علي رخيص % % 4(@)(@@) % لا يعاب المقل ، وهو قنوع % ويعاب الغني ، وهو حريص % 5(@)(@@) % لبستي علها تجلى ولم يدنس % % رداء من العلى وقميص % % 6(@)(@@) % وانظرنها تجر زعازعها النك % % ب وبطني من النوال خميص % % 7(@)(@@) % وارقبي ععطفة الزمان بجد % % ربما حلق الجناح الحصيص % 8(@)(@@) % بقدم الباسل الابي 
ms252	 على الحت % % ف وفيه عن الهوان نكوص % % 9(@)(@@) % كلما عضه الاذى غض بالصبر % % ر يزجي الأيام وهي غصيص % 10(@)(@@) % قسما بالأشاعث الخمص أدت % هم إلى المأزمين قود وخوص % PageV01P887 11(@)(@@) % ترتعي جرة البطون من الجه % د ، إذا عز أجرد وقصيص % 12(@)(@@) % اكلت نيها الموامي فلم يب % % ق عليها إلا الذما والشخوص % 13(@)(@@) % لا جعلت الهوان دار مقام % وعن الضيم معدل ومحيص % 14(@)(@@) % خف عن عاتقي الرجاء وكم با % % بات بمن الرجال وهو وقيص % % 15(@)(@@) % إن يكن في ندى الملوك سبوغ % للمرجى ، ففي رجاي قلوص % PageV01P888 البحر : سريع 1(@)(@@) % كيف أضاء البرق ، إذ أومضا % % منابت الرمث بوادي الغضا % % 2(@)(@@) % عهد الحمى لا اين عهد الحمى % % قضى على الصب جوى وانقضى % % 3(@)(@@) % ونازل بالقلب أوطانه % بين حمى الرمل وبين الأضا % % 4(@)(@@) % لا ناله الداء الذي نالني % % منه وان شف وان امرضا % % 5(@)(@@) % ولا يكابد ليل ذي غلة % لو طلع البدر به ما اضا % % 6(@)(@@) % هان على الواجد طعم الكرى % % إن الفتى الساهر ما غمضا % % 7(@)(@@) % ما آن للممطول ان يقتضي % % ولا لذا الماطل ان يقتضى % % 8(@)(@@) % ان غريمي بديون الهوى % % أدان قلبي وأساء القضا % % 9(@)(@@) % يا راكبا تحمله جسرة % كالهقل ناش البلد الأعرضا % % 10(@)(@@) % انحله الخوف وخوف الفتى % % سيف على مفرقه منتضى % % PageV01P889 11(@)(@@) % قل لبهاء الملك ان جئته % % سود دهري بك ما بيضا % % 12(@)(@@) % سخط لو أن الطود يرمى به % ساخ عن الأطواد ، أو خفضا % % 13(@)(@@) % ومر قول ذل عزي له % لو مزج الماء به عرمضا % % 14(@)(@@) % أعوذ بالعفو ، وهل آمن % نذيرة الصل إذا نضنضا % % 15(@)(@@) % أيا غياث الخلق إن أجدبوا % % ويا قوام الدين ان قوضا % % 16(@)(@@) % ويا ضياء ان نأى نوره % % لم نر يوما بعده أبيضا % % 17(@)(@@) % مالي مطويا على غلة % % ارمضني وجدك ما ارمضا % % 18(@)(@@) % قد قلق الجنب وطال الكرى % % وأظلم الجو وضاق الفضا % % 19(@)(@@) % لا تعطش الزهر الذي نبته % % بصوب إنعامك قد روضا % % 20(@)(@@) % إن كان لي ذنب ، ولا ذنب لي % % فاستأنف العفو وهب ما مضى % % PageV01P890 21(@)(@@) % لا تبر عودا أنت 
ms253	 ريشته % حاشا لباني المجد ان ينقضا % % 22(@)(@@) % وارع لغرس أنت أنهضته % لولاك ما قارب ان ينهضا % % 23(@)(@@) % لو عرض الدنيا على عزها % % منك ، لما سر بما عوضا % % 24(@)(@@) % ولا يكن عهدك ، بعد الهوى % % غيما تجلى وخضايا نضا % % 25(@)(@@) % يا راميا لا درع من سهمه % % أقصدني من قبل أن ينتضى % % 26(@)(@@) % قضى على قلبي بإقلاقه % ما انا بالجلد على ما قضى % % 27(@)(@@) % وكيف لا ابكي لاعراض من % % يعرض عني الدهر أن أعرضا % % 28(@)(@@) % قد كنت ارجوه لنيل المنى % % فاليوم لا اطلب غير الرضا % % PageV01P891 البحر : خفيف تام 1(@)(@@) % عند قلبي علاقة ما تقضى % % وجوى كلما ذوى عاد غضا % % 2(@)(@@) % وبكاء على المنازل ابلتهن % % ايدي الأيام بسطا وقبضا % % 3(@)(@@) % والتفات إلى التصابي ، وقد أس % رع بي جامح الثلاثين ركضا % % 4(@)(@@) % من معيد أيام ذي الأثل ، أو ما % % منع الدل دينها أن يقضى % % 5(@)(@@) % سامحا بالقليل من عهد نجد % % ربما أقنع القليل وأرضى % % 6(@)(@@) % إن عيدا من الغواني ، إذا رم % ت التسلي أشجى لقلبي وأنضى % % 7(@)(@@) % وإذا ما عزمت صبرا ارتني % % مقلا تفسخ الدل دينها أن يقضى % % 8(@)(@@) % وإذا ما أمتن بالبعد بعضا % برد عز ، أو حر نصل ، فإني % % 9(@)(@@) % فسقى الرمل منزلا ومعانا % هزجات ينبضن بالبرق نبضا % % 10(@)(@@) % ومشت فيه بالنسيم عليلا % قطع المزن في الرياض المرضى % % PageV01P892 11(@)(@@) % ما لذا الزور ما يغب من الرم % طروقا في مضجع قد اقضا % % 12(@)(@@) % مهديا لي من طيب أرواح نجد % ما يداوي نكس العليلى المنضا % % 13(@)(@@) % لم يكن غير خطرة البرق ما % % ما زود عين المشوق الا ومضا % % 14(@)(@@) % قادة الغمض من زرود فلما % % زار أنبى عن مقلتي الغمضا % % 15(@)(@@) % قد لبست الخطوب سودا وبيضا % وقطعت الزمان طولا وعرضا % % 16(@)(@@) % ووردت الأمور صفوا ورنقا % ورعيت الآمال رطبا وحمضا % % 17(@)(@@) % وتلفعت ريطة من بياض % إنا راض منها بما ليس يرضى % % 18(@)(@@) % ابرمت لي من صنعة الدهر لا % % يسرع فيها إلا المنايا نفضا % % 19(@)(@@) % مخبر فاحم ولون مضيء % من أرى اليوم فاحما مبيضا % % 20(@)(@@) % كم مقامي تلقي علي 
ms254	 الليالي % % نوبا لا اطيق منهن نهضا % % PageV01P893 21(@)(@@) % وخطوبا إذا نحتن من العظم % % فلا بدع أن عرقن النحضا % % 22(@)(@@) % قاعدا مطرح السقاء انتحته % % بصروف الاقدار جرا ومنخضا % % 23(@)(@@) % ركبتني وهما جلالا فما زال % % جدابي حتى رمى بي نقضا % % 24(@)(@@) % كل يوم على مزلة خطب % % اتوقى مرمى إلى الذل دحضا % % 25(@)(@@) % ومسقى على القذى يرد الور % % 26(@)(@@) % كلما سار طالبا خفض عيش % % 27(@)(@@) % أين لا اين من يجير على الدهر إذا % % ر ، إذا الدهر هر يوما وعضا % % 28(@)(@@) % % لم يدعنا حتى وهبنا العرضا % % 29(@)(@@) % وتركنا نفل الزمان قنوعا % % 30(@)(@@) % فذماما على الندى ان يرجى % % وعياب البخيل من أن يفضى % % PageV01P894 31(@)(@@) % وأمانا مني عليه ، فما أذ % عر سربا ، ولا أنازل أرضا % % 32(@)(@@) % لا حملت الحسام إن لم أحمل % رؤوس العدى قراعا وعضا % % 33(@)(@@) % فعل مستثقل الحياة يعد ال % % بعثا على المنون وحضا % % 34(@)(@@) % مستميتا يرى التحية بالضي % م لطاما ، والعار جرحا ممضا % % 35(@)(@@) % طارحا نفسه على كل هول % % قد تعامى عنه الجبان وأغضى % % 36(@)(@@) % حيث يلقى ضرب السيوف اخاديد % % تمج الدماء والطعن وخضا % % 37(@)(@@) % وفتور مثل الأسود أعدوا % % لقنيص العلياء وثبا وربضا % % 38(@)(@@) % فوق اكوار ضمر اقلق النسع % % ع قديم اضطمارها والغرضا % % 39(@)(@@) % كلما اجلوذ الظلام استلذوا % % لعب الليل بالطلاح الانضا % % 40(@)(@@) % كل مستعسف اليدين بقوس % % مجد يرمي عن المكارم عرضا % % PageV01P895 43(@)(@@) % سوطه نسعة العنان ، إذا ح % رك جلى إلى المراد وأفضى % % 45(@)(@@) % فلعلي ألقى المنى أو خلاجا % من حمام قضى علي وأمضى % % 46(@)(@@) % راكبا صهوة الخطار عقيدا % % لبنات الفلا يجبن الارضا % % 47(@)(@@) % % ولهام الاعداء وقما وغضا % % 48(@)(@@) % برد عز أو حر تصل فاني % % أجد اليوم في ضلوعي رمضا % % PageV01P896 البحر : متقارب تام 1(@)(@@) % مواقد نيرانهم قرة % % وسربال طاهيهم ابيض % % 2(@)(@@) % إذا حركوا للمساعي ابوا % % وإن أنزلوا دار ضيم رضوا % % PageV01P897 البحر : طويل 1(@)(@@) % حذار فان الليث قد فر نابه % % وقد أوتر الرامي المصيب وأنبضا % % 2(@)(@@) % اسر بمن ارجى إلى اليوم يومه % % فأدرك ما يهوى ، وآسى لمن مضى % % 3(@)(@@) % وقد كنت ادعو ان تؤخر مدتي 
ms255	 % % لعلي أرى يوما من العدل أبيضا % % PageV01P898 البحر : كامل تام 1(@)(@@) % أهلا به من رائح متصعد % بخوالج من برقه ونوابض % % 2(@)(@@) % هزج البروق ، كأنه متمطق % بأراقم قلن الرمال نضانض % 3(@)(@@) % حتى يقول الساهرون لومضه % % نضر العراق بقطر هذا العارض % PageV01P899 البحر : مجزوء الخفيف 1(@)(@@) % ضوأ حين اومضا % % منبت الرمل والغضا % % 2(@)(@@) % بارقا مزنة اطال % % استنانا واعرضا % % PageV01P900 البحر : رجز تام 1(@)(@@) % لغير تقدير ذرعن الأرضا % % حتى علمن طولها والعرضا % % PageV01P901 البحر : وافر تام 1(@)(@@) % لجام للمشيب ثنى جماحي % % وذللني لا يام وراضا % % 2(@)(@@) % أقر بلبسه ، ولقد أراني % % أجاحده إباء وامتعاضا % % 3(@)(@@) % تعوضت الوقار من التصابي % % لشد على المعوض ما استعاضا % % 4(@)(@@) % لوى عني الخدود من الغواني % % وقطع دوني الحدق المراضا % % 5(@)(@@) % فصار بياضه عندي سوادا % % وكان سواده عندي بياضا % % PageV01P902 البحر : طويل 1(@)(@@) % رضيت من الاحباب دون الذي يرضي % % وداينت من تقضى الديون ولا يقضي % % 2(@)(@@) % وقد أنهرت في الليالي جراحها % % مرارا ، وأنضاني من الهم ما ينضي % % 3(@)(@@) % طوى الدهر أسباب الهوى عن جوانحي % % وحل الصبا عقد الرحايل عن نقضي % % 4(@)(@@) % ولم يبق لي في الأعين النجل طربة % ولا أرب عند الشباب الذي يمضي % % 5(@)(@@) % أضحى اليوم عن ظل الشبيبة مفرقي % % وأبدل مسود العذار بمبيض % 6(@)(@@) % تاني ، وممطول من النأي بيننا % % قوارص تنبو بالجفون عن الغمض % 7(@)(@@) % ومولى ورى قلبي بلذعة ميسم % % من الكلم العوراء مضا على مض % 8(@)(@@) % فعذرا لاعدائي إذا كان اقربى % % يشذب من عودي ويعرق من نحضي % % 9(@)(@@) % إذا ما رمى عرضي القريب بسهمه % % عذرت بعيد القوم اما رمى عرضي % % 10(@)(@@) % الم يأته اني تفردت بعده % % روابي للعلياء جاش لها نهضي % % PageV01P903 11(@)(@@) % وأني جعلت الأنف من كل حاسد % قبالي وخدي كل مضطغن أرضي % % 12(@)(@@) % وكم من مقام دون مجدك قمته % % على زلق بين النوائب أو دحض % 13(@)(@@) % وقارعت من أعياك قبل قراعه % فدامجني بعد التشاور والبغض % 14(@)(@@) % لقد أمست الأرحام منا على شفا % فأخلق بمشف لا يعلل أن يقضي % % 15(@)(@@) % رأيت مخيلات العقوق مليحة % % فلا تجعلن برق الأذى صادق الومض % 16(@)(@@) % ولا 
ms256	 تشمتن من ود لوا اننا معا % % شحيحان تلطينا الجنادل بالأرض % 17(@)(@@) % اذا كنت اغضي والقواذع جمة % % فمثلك أولى أن يرم وأن يغضي % % 18(@)(@@) % على غصص لو كن في البدر لم ينر % % وفي العود لم يورق وفي السهم لم يمض % 19(@)(@@) % رزئتك حيا بالقطيعة والفلى % % وبعض الرزايا قبل يوم الفتى المقضي % % 20(@)(@@) % اناديك فارجع من قريب فانني % % اذا ضاق بي ذرعي مضيت كما تمضي % % PageV01P904 21(@)(@@) % لقد كان في حكم الوشائج لو رأى % % عن المجد بطئي أن يبالغ في حضي % % 22(@)(@@) % فكيف ولم تخرج مناديح همتي % % ولا ذمت العلياء بسطي ولا قبضي % % 23(@)(@@) % اذا هو اغضى ناظري على القذى % % وكان لمثلي مسخطا فلمن يرضي % % 24(@)(@@) % خليلي ما عودي لأول غامز % ولا زبد وطبي للمقيم على مخض % % 25(@)(@@) % فقل للعدى عضوا الأخامص إنكم % تعرقتم الأيدي علي من العض % 26(@)(@@) % هم نقضوا ما قد بنى أولوهم % وشدنا وهيهات البناء من النقض % 27(@)(@@) % وفي كل يوم يضبغ العار منهم % % رداء امرء والعار باق على الرحض % % 28(@)(@@) % يريدون أن يخفوا النواقر بيننا % % وقد صاحت الأضغان في الحدق المرض % 29(@)(@@) % ذكرت حفاظي والحفيظة في الحشا % % لها نغضان العرق يحفز بالنبض % % 30(@)(@@) % دعوتكم قبل التي لا شوى لها % % وقلت لهم فيؤا إلى الخلق المرضي % % PageV01P905 31(@)(@@) % ردوني نميرا قبل أن أحمل القذى % % ولا تردوا إلا على الثمد البرض % % 32(@)(@@) % ولسوا جميمي قبل أن يمنع الحمى % % إبائي أو يوبى على رعيكم حمضي % % 33(@)(@@) % ومن قبل أن يسدي المعادون بيننا % % برود الخنا ما شئت في الطول والعرض % 34(@)(@@) % تقوا عار حرب لا يعود مثيرها % % وان غلب الاقران إلا على رمض % % 35(@)(@@) % ولا تولجوا زور العقوق بيوتكم % اناشدكم بالله في الحسب المحض % % 36(@)(@@) % أراها بعين الظن حمراء جهمة % ستجري إلأى العار العواقب أو تفضي % % 37(@)(@@) % تهضمني من لا يكون لغيره % % من الناس اطراقي على الهون أو غضي % % 38(@)(@@) % افوق نبل القول بيني وبينه % % فيؤلمني من قبل نزعي بها عرضي % % 39(@)(@@) % وارجع لم اولغ لساني في دمي % % ولم ادم اعضائي بنهشي ولا عضي 
ms257	 % % 40(@)(@@) % اذا اضطرمت ما بين جنبي غضبة % % وكاد فمي يمضي من القول ما يمضي % % PageV01P906 41(@)(@@) % شفعت على نفسي بنفسي فكفكفت % % من الغيظ واستعطفت بعضي على بعضي % % PageV01P907 البحر : طويل 1(@)(@@) % أرى موضع المعروف لو أستطيعه % واغضي ولو شاء الغني لي لم اغض % % 2(@)(@@) % ألاحظ خلات الكرام بغصة % ويقصر مالي عن بلوع الذي يرضي % % 3(@)(@@) % وأقبض كفي عن عطاي وقد يرى % % ذهابي بها عند الفضول عن القبض % 4(@)(@@) % تقتلنا هذي الليالي ولا تدي % % وتستقرض الأيام منا ولا تقضي % % 5(@)(@@) % ولولا الندى ما طأطأ العدم هامتي % % ولا كان ينقضيني من الهم ما ينضي % % 6(@)(@@) % وكيف وفور العرض والمال وافر % % ومن يخزن الاموال ينفق من العرض % % 7(@)(@@) % ومن عدم أقري النوازل عذرة % ولو حل لي لحمي قريتهم بعضي % % PageV01P908 البحر : مجزوء الكامل 1(@)(@@) % قالوا تزاور عطفه % % وأرابنا إيماضه % % 2(@)(@@) % وابى اباء الصعب لا % % يسطيعه رواضه % 3(@)(@@) % غضبان سل خطامه % عنه وحل إباضه % 4(@)(@@) % عطلت رباه من الصفا % % ء ، وعريت أنقاضه % 5(@)(@@) % ان يستعض مني فلا % % مغبوطة اعواضه % % 6(@)(@@) % قد عز من يعتاض من % % وذل من يعتاضه % % 7(@)(@@) % هيهات لا احبابه % % مني ولا ابغاضه % % 8(@)(@@) % ما سرني إقباله % فيسؤني اعراضه % % PageV01P909 البحر : رجز تام 1(@)(@@) % أبا علي للألد إن سطا % % وللخصوم ان اطالوا اللغطا % % 2(@)(@@) % تصيب عمدا ان اصابوا غلطا % % ولمع تكشف عنهن الغطا % % 3(@)(@@) % كشفك عن بيض العذري الغطا % % ومصعب للقول صعب الممتطى % % 4(@)(@@) % عسفت حتى عاد مجزول المطا % % دامي الملاط رحله قد أغبطا % % 5(@)(@@) % وسائرات بالخطى لا بالخطا % % شوارد عنك قطعن الربطا % % 6(@)(@@) % كما رأيت الخيل تعدو المرطى % % البست فيها كل اذن قرطا % % 7(@)(@@) % قد وردت أفهامنا ورد القطا % % ومشكلات ما نشطن منشطا % % 8(@)(@@) % عطالها بمقول ، إذا عطا % % ميز من ديجورها ما اختلطا % % 9(@)(@@) % غلل مابين العقاص المشطا % % ضل المجارون وما تورطا % % 10(@)(@@) % ملوا مجاراة فنيق قد مطا % % قرم يهد الأرض إن تخمطا % % PageV01P910 11(@)(@@) % مل المطي اودى ولا مغتبطا % % كانوا العقابيل ، وكنت الفرطا % % 12(@)(@@) % عند السراع يعرف القوم البطا % % أرضى زمان بك ثم أسخطا % % 13 
ms258	(@)(@@) % ما أطلب الأيام منا شططا % % PageV01P911 البحر : وافر تام 1(@)(@@) % كانت لم تقد بعويرضات % % أبا العوام ، فتيانا قطاطا % % 2(@)(@@) % ولم تحمل على الأعداء منهم % قنا لدنا وايمانا سباطا % % 3(@)(@@) % إذا المنجود نبههم طروقا % رأى زعل الشبيبة والنشاطا % % 4(@)(@@) % قيام السمهري تبادروها % % وقد لبسوا المخيلة والشطاطا % % 5(@)(@@) % ولم تسق الجياد مسومات % تجشمها المغاور والوراطا % % 6(@)(@@) % وترسلها العرضنة صاديات % مبادرة إلى الماء الغطاطا % % 7(@)(@@) % تصيب بها فواغر كل ثغر % % كانك ترسل النبل المراطا % % 8(@)(@@) % فلين مفارق المعزاء وخدا % % كفلي الانمل اللمم الشماطا % % 9(@)(@@) % ومن جعل الدليل له ابن ليلى % % فلن يخشى الضلال ولا الغلاطا % % 10(@)(@@) % وناجية تساقطها حسيرا % سقاط حسامك البدن العباطا % % PageV01P912 11(@)(@@) % وتطلق رحلها والفجر طفل % % وقد أكل البواني والملاطا % % 12(@)(@@) % وشاذبة طويت بها اعتسافا % بساط الدو ، إن له بساطا % % 13(@)(@@) % دوارع للبلاد بغير حاد % % تخال فضول أنسعها سياطا % % 14(@)(@@) % وعدت بها تساوك من وجاها % % دبيب النمل يتعل البلاطا % % 15(@)(@@) % ومنخرق كان على رباه % % من الظلم الاكنة واللياطا % % 16(@)(@@) % تعلقت النجوم بجانبيه % كأن الليل البسها القراطا % % 17(@)(@@) % طعنت ظلامه بالركب حتى % % رأيت له انجيابا وانعطاطا % % 18(@)(@@) % وكل فتى تبطن بيت نبع % وصير غمد قاطعه إباطا % % 19(@)(@@) % أغيلمة زحمت بها الأعادي % % تعاطى بالذوابل ما تعاطى % % 20(@)(@@) % تخال على عواملها ، إذا ما % % وردن الطعن السنها السلاطا % % PageV01P913 21(@)(@@) % ويوم للوقيعة ذي اوار % % ككبر القين اوقد فاستشاطا % % 22(@)(@@) % فرقت جموعه فرق العناصي % % وقد مرج الطعان به اختلاطا % % 23(@)(@@) % تعاطي كأسه فتعب فيها % % ويحتقر الجبان فلا يعاطا % % 24(@)(@@) % جعلت طلى العدى فيه اقتراحا % على بيض القواضب واشترطا % % 25(@)(@@) % تغلغل في جماجمها العوالي % % كما غلغلت في اللمم المشاطا % % 26(@)(@@) % تترى بعد يومك كل خطب % % كانك كنت للجلى رباطا % % 27(@)(@@) % ألا أين السريع إلى المنايا % % إذا المعزال عرد ، أو تباطا % % 28(@)(@@) % اذا ولج الرواق رأيت منه % % طويل الباع قد غمز السماطا % % 29(@)(@@) % وكنت اذا اخذت بمنكبيه % % غداة الضيق ، فرج لي الضغاطا % % 30(@)(@@) % وكم بزلاء صيح بها اليه % % تطاطا لها تجزك ، فما تطاطا % % PageV01P914 31(@)(@@) % فقولا للمنفض مذرويه : % خض الامر انغماسا 
ms259	 وانعطاطا % % 32(@)(@@) % مراس الحرب أسحبه العوالي % % وطول الامن اسحبك الرباطا % % 33(@)(@@) % هم حملوا لك الاحسان عفوا % فدونكهن ولغا واستراطا % % 34(@)(@@) % حموكم ، والأسنة في الهوادي % % وقوع الطير تبتدر اللقاطا % % 35(@)(@@) % غداة خلا بداركم الاعادي % % فلم يدعوا لحوضكم لياطا % % 36(@)(@@) % تشقق في جلودكم العوالي % % كان الطعن يلبسها الرهاطا % % 37(@)(@@) % بكل قرارة منكم لحيم % يقضي الليل زفرا وانتحاطا % % 38(@)(@@) % أجمكم ، ولاقى عن علاكم % % عضاض الطعن والضرب الخلاطا % % 39(@)(@@) % ومد ببوعكم حتى غدوتم % % وعالي النجم اقربكم مناطا % % 40(@)(@@) % وحلق مضرحي كان فيكم % وان لكل طائرة سقاطا % % PageV01P915 41(@)(@@) % فلا تبعد رجال من قريش % % وسمت بهم فلم أعد العلاطا % % 42(@)(@@) % رعوا تلعات هذا المجد لسا % بانياب العوامل وانتشاطا % % 43(@)(@@) % تخيرهم حمام الموت منا % % خيار الزائد اعتراض النماطا % % 44(@)(@@) % تداعوا كالسلوك وهت قواها % % مروقا بالنوائب وانخراطا % % 45(@)(@@) % مضوا من كل أغلب مستميت % اذا ما العار جلله اماطا % % 46(@)(@@) % نأوا عني فضعضعني نواهم % % وما كانوا فقد قطعوا النياطا % % PageV01P916 البحر : كامل تام 1(@)(@@) % سنحت لنا بلوى العقيق وربما % % عرض الزلال وزيد عنه الفارط % % 2(@)(@@) % قلبي وطرفي ، يوم حم لقاؤها % % ضدان ذا راض وهذا ساخط % 3(@)(@@) % نظرت بلا قصد فأقصدت الحشا % % ويذيق طعم الموت سهم غالط % 4(@)(@@) % قل للغزال اذا مررت بذي النقا % % فلعل جأشك للبلابل رابط % % 5(@)(@@) % لم انت في هبة القليل مناقش % % أبدا ، وفي عدة الوصال مغالط % PageV01P917 البحر : رمل تام 1(@)(@@) % ما لذا الداني إلى القلب شحط % وغريم الحب بالدين ألط % 2(@)(@@) % ظالم قلد أحكام الهوى % % طالما جار علينا وقسط % % 3(@)(@@) % نسخط الشيء ونرضاه ، إذا % % لم تر العتبى على طول السخط % 4(@)(@@) % كل يوم لي خصيم ضالع % والمقادير لها حكم شطط % % 5(@)(@@) % عجبت ان عاد شغبا منطقي % % كل ذي حلم اذا ضيم لغط % % 6(@)(@@) % ورأت وخط بياض طارق % % وخط التهمام قلبي ، فوخط % 7(@)(@@) % مالها تنكر مع هذا الشجى % % وقعات الشيب بالجعد القطط % % 8(@)(@@) % وارى عودي على صمائه % % أن من غمز الليالي ونحط % % 9(@)(@@) % موقرا يحبسني عن غايتي % % لا المدى يطوي ولا العبء يحط % % 10(@)(@@) % إن قومي صدعتهم نوبة 
ms260	 % شقق البرد اليماني يعط % % PageV01P918 11(@)(@@) % خلتهم والخطب يعتامهم % % شجر الوادي رماه المختبط % % 12(@)(@@) % وكما خايل يوما عاقر % كلما ثارت له البدن عبط % % 13(@)(@@) % تبعوا امر المقادير فهم % % فاطن يطعن أو دان يشط % % 14(@)(@@) % فل أحداث رمى الدهر بهم % فهم في رقع الدهر نقط % 15(@)(@@) % ذاقهم مستحليا أرواحهم % ورأى المضغ طويلا ، فاسترط % 16(@)(@@) % يصطفي كل كريم منهم % وإذا استكرم ذو العقب ربط % 17(@)(@@) % وبواق غير باقين وكم % % يلبث القارب من بعد الفرط % % 18(@)(@@) % كم طوى الموت لهم من بهمة % % خائض الغمرة فراج الضغط % 19(@)(@@) % وجواد متعب مضماره % كلما لزت به الخيل معط % 20(@)(@@) % سلهم ، أو فسل الروع بهم % يوم خدر الشمس بالنقع يلط % % PageV01P919 21(@)(@@) % يبصر الناس على ايديهم % % قصب الاعناق بالبيض يقط % % 22(@)(@@) % اقبلوا الاعداء ملتف القنا % % بين معروض ومجرور يحط % 23(@)(@@) % تحسب الارماح من قعقاعها % % شجرا للطير فيهن لغط % % 24(@)(@@) % ومواض تنثر الهمام لهم % % هبة العاصف ترمي بالخبط % 25(@)(@@) % فارقونا ، فبقينا بعدهم % كالرذايا ، وضعت عنها الغبط % 26(@)(@@) % في ذنابى معشر جيرانهم % مضغ للخطب يغدو أو لقط % % 27(@)(@@) % ليس بالراضي اذا نبهم % % طارق الليل ولا بالمغتبط % % 28(@)(@@) % صور رائعة لا يرتجي % % نفعها ، مثل تهاويل النمط % 29(@)(@@) % شمخوا أن حلق الجد بهم % غلط الدهر وكم يبقى الغلط % % 30(@)(@@) % كسل الايام عنهم غرهم % % ربما جاء زمان قد نشط % PageV01P920 31(@)(@@) % كل مخنوق علي جرته % % خلط العجز بشوك ، فاختلط % 32(@)(@@) % إن رأى المغرم طاطا ، وله % حاجب من حافر اللؤم يمط % % 33(@)(@@) % أهمل العرض على علم به % ورعى ، لما رعى ، المال فقط % 34(@)(@@) % طمع ورطني في حبلهم % ويصاد الطير من حيث لقط % 35(@)(@@) % كنت ارجواهم ثمارا تجتني % % فهم اليوم قتاد يخترط % % 36(@)(@@) % من عذيري من رصيد كيده % % راش ما راش طويلا ومرط % % 37(@)(@@) % جامع لي بين فخر وأذى % % ربما برح بالأذن القرط % 38(@)(@@) % حمل الثقل على ذي غارب % % كلما عج من الحمل ضغط % % 39(@)(@@) % أتقى الرمي ولو شئت مضى % % كل مطرور اذا صمم عط % % 40(@)(@@) % واذا كشفت ما يرمضني % % من مضيض الداء قال الحلم غط % % PageV01P921 41 