ms3061	(@)(@)(@@)(@@)(@@) $ 12054 ( ق ) حديث : ( أوصى امرءا بأمه ) . . . الحديث . ق في الأدب ( 1 : 1 ) عن أبي بكر بن أبي شيبة ، عن شريك ، عن منصور ، عن عبيد الله بن علي ، عن أبي سلامة به . |(@)(@@)(@@)(@@) ||| 2 ( 634 - ومن مسند أبي سيارة المتعي عن النبي صلى الله عليه وسلم ) 2(@)(@)(@@)(@@)(@@) $ 12055 ( ق ) حديث : قلت : يا رسول الله إن لي نخلا ، قال : ( أد العشر ) . . . الحديث . ق في الزكاة ( 20 : 1 ) عن أبي بكر بن أبي شيبة وعلي بن محمد ، كلاهما عن وكيع ، عن سعيد بن عبد العزيز ، عن سليمان بن موسى ، عن أبي سيارة به(@)PageV09P222(@)(@@)(@@)(@@) ||| 1 ( حرف الشين ) 1(@)(@@)(@@)(@@) ||| 2 ( 635 - ومن مسند أبي شريح الخزاعي عن النبي صلى الله عليه وسلم واختلف في اسمه فقيل : كعب بن عمرو ؛ وقيل : هانىء بن عمرو ؛ وقيل : عمرو بن خويلد ؛ وقيل : خويلد بن عمرو ؛ وقيل : عبد الرحمن بن عمرو بن صخر بن عبد العزى بن معاوية بن المحترش ابن عمرو بن زمان بن عدي بن ربيعة ، إخوة بني كعب بن عمرو بن ربيعة ، أسلم يوم الفتح ) 2(@)(@)(@@)(@@)(@@) $ 12056 ( ع ) حديث : ( من كان يؤمن بالله واليوم الآخر فليكرم جاره ، ومن كان يؤمن بالله واليوم الآخر فليكرم ضيفه ، ومن كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليسكت ) . وفي حديث نافع بن جبير : ( فليحسن إلى جاره ) . خ في الأدب ( 31 : 2 ) عن عبد الله بن يوسف ، عن الليث ، عن سعيد المقبري ، عن أبي شريح به . وفي الرقاق ( 23 : 3 ) عن أبي الوليد ، عن الليث ( به بلفظ ) ( الضيافة ثلاثة أيام جائزته ) ، قيل : وما جائزته ؟ . . . الحديث ولم يذكر قصة الجار . وفي الأدب أيضا ( 85 : 1 ) عن عبد الله(@)PageV09P223 ابن يوسف ، عن مالك ، عن سعيد المقبري بقصة الضيف خاصة . و ( 85 : 2 ) عن إسماعيل ، عن مالك مثله وزاد : ( فليقل : خيرا أو ليسكت ) . م في الأحكام ( لا ، بل في اللقطة 4 : 1 ) عن قتيبة ، عن الليث به مختصرا . و ( ؟ ) عن أبي بكر بن أبي شيبة ( في كتاب خلف ) ؛ و ( 4 : 2 ) عن أبي كريب ؛ عن 
ms3062	 وكيع و ( 4 : 3 ) عن محمد بن المثنى ، عن أبي بكر الحنفي كلاهما عن عبد الحميد بن جعفر ، عن سعيد المقبري نحوه وزاد : ( ولا يحل لمسلم أن يقيم عند أخيه حتى يؤثمه ) . . . الحديث . وفي الإيمان ( 20 : 4 ) عن زهير بن حرب ومحمد بن عبد الله بن نمير ، كلاهما عن سفيان بن عيينة ، عن عمرو بن دينار ، عن نافع بن جبير بن مطعم ، عن أبي شريح بتمامه . د في الأطعمة ( 5 : 1 ) عن القعنبي ، عن مالك بقصة الضيف مطولة . ت في البر ( والصلة 43 : 1 ) عن قتيبة به ولم يذكر قصة الجار . و ( 43 : 2 ) عن ابن أبي عمر ، عن سفيان ، عن ابن عجلان ، عن سعيد المقبري بقصة الضيافة . وقال : حسن صحيح . س في الرقائق ( في الكبرى ) عن قتيبة ببعضه : من كان يؤمن با واليوم الآخر فليقل خيرا أو ليصمت . وعن علي بن شعيب ، عن معن بن عيسى وعن الحارث بن مسكين ، عن ابن القاسم كلاهما عن مالك . . . بهذه القصة . وعن محمد بن منصور ، عن سفيان ، عن ابن عجلان بها . وعن عبيد الله بن سعيد ، عن سفيان ، عن عمرو بن دينار بها . ق في الأدب ( 5 : 1 ) عن أبي بكر بن أبي شيبة ، عن سفيان ،(@)PageV09P224 عن عمرو بن دينار بتمامه ، وعن ابن عجلان بقصة الضيافة خاصة * 12057 ( خ م ت س ) حديث : إن مكة حرمها الله ، ولم يحرمها الناس . . . الحديث وفيه قصة عمرو بن سعيد بن العاص . خ في العلم ( 37 : 1 ) عن عبد الله ابن يوسف وفي الحج ( 190 ) عن قتيبة وفي المغازي ( 52 : 3 ) عن سعيد بن شرحبيل ثلاثتهم عن الليث ، عن سعيد المقبري ، عنه به . م في الحج ( 82 : 2 ) عن قتيبة به . ت فيه ( الحج 1 ) عن قتيبة به ، وقال : حسن صحيح . وفي الديات ( 13 : 2 ) عن ابن بشار ، عن يحيى بن سعيد ، عن ابن أبي ذئب ، عن سعيد في معناه . س في الحج ( 111 : 2 ) وفي العلم ( الكبرى 7 ) عن قتيبة به .(@)(@@)(@@)(@@) $ 12058 ( د ت ) حديث 
ms3063	 : ألا إنكم معشر خزاعة قتلتم هذا القتيل من هذيل . . . الحديث مختصر . د في الديات ( 4 : 1 ) عن مسدد ، عن يحيى ، عن ابن أبي ذئب ، عن سعيد بن أبي سعيد ، عنه به . ت فيه ( الديات 13 : 2 ) عن محمد بن بشار ، عن يحيى به في حديث طويل . | * 12059 ( د ق ) حديث : من أصيب بقتل أو خبل ، فإنه يختار إحدى ثلاث . . . الحديث . في الديات ( 3 : 1 ) عن موسى ، عن حماد ، عن ابن إسحاق ، عن الحارث بن فضيل ، عن سفيان بن أبي العوجاء ، عن أبي شريح به . ق فيه ( الديات 3 : 1 ) عن عثمان بن أبي شيبة ( وأبي بكر ، كلاهما ) عن أبي خالد الأحمر وجرير بن عبد الحميد وعبد الرحيم بن سليمان ، ثلاثتهم عن ابن إسحاق نحوه .(@)(@@)(@@)(@@) $ 12060 ( خ ) حديث : والله لا يؤمن ، والله لا يؤمن ، والله لا يؤمن ، قالوا : من يا رسول ا ؟ قال : الذي لا يأمن جاره بوائقه . خ في الأدب ( 29 ) عن عاصم بن علي ، عن ابن أبي ذئب ، عن سعيد المقبري ، عن أبي شريح به . قال : وتابعه(@)PageV09P225 شبابة بن سوار وأسد بن موسى يعني عن ابن أبي ذئب . وقال : حميد بن الأسود وعثمان ابن عمر وأبو بكر بن عياش وشعيب بن إسحاق ، عن ابن أبي ذئب ، عن سعيد ، عن أبي هريرة ( ح 13030 ) .(@)(@@)(@@)(@@) $ 12061 ( س ) حديث : اللهم إني أحرج حق الضعيفين : اليتيم والمرأة . س في عشرة النساء ( الكبرى 52 : 2 ) عن أحمد بن بكار ، عن محمد بن سلمة ، عن ابن عجلان ، عن المقبري ، عن أبيه ، عن أبي شريح به . رواه يحيى بن سعيد ، عن ابن عجلان ، عن سعيد ، عن أبي هريرة ( ح 13047 ) . | ( * )(@)(@@)(@@)(@@) ||| 635 - ألف ومن مسند أبي الشموس البلوي عن النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) ||| * 12061 ( ألف خت ) حديث : أن النبي أمر بإلقاء الطعام . خ في أحاديث الأنبياء 18 : 2 تعليقا عقب حديث ابن عمر ح 7185 : ويروي عن سبرة بن معبد ح 3810 ألف وأبي الشموس )(@)PageV09P226(@)(@@)(@@)(@@) ||| 2 ( 636 - ومن مسند أبي شهم عن النبي صلى الله عليه 
ms3064	 وسلم قيل : اسمه يزيد بن أبي شيبة عداده في أهل الكوفة ) 2(@)(@)(@@)(@@)(@@) $ 12062 ( س ) حديث : كنت بالمدينة فمرت بي جارية فأخذت بكشحها . . . الحديث . س في الرجم ( الكبرى 35 ألف : 9 ) عن محمد بن عبد الله المخرمي ، عن أسود بن عامر ، عن هريم بن سفيان ، عن بيان ، عن قيس بن أبي حازم ، عن أبي شهم به . كان في كتاب أبي القاسم : عن هارون بن سفيان ، عن بيان ، وقال في آخره : كذا قال ، وفيه خطأ في موضعين : أحدهما قوله عن وهب بن سفيان ، وإنما هو هريم بن سفيان . والثاني قوله عن يمان ، وإنما هو بيان بن بشر أبو بشر . وقد رواه أبو بكر وعثمان ابنا أبي شيبة وعلي بن حرب الطائي وغيرهم . عن الأسود على الصواب . كذا قال أبو القاسم ، وكأنه نسب الوهم في ذلك إلى النسائي أو إلى شيخه وليس منه ، ولا من شيخه ، بل من بعض الرواة عنه . فإن المحاملي قد رواه عن المخرمي شيخ النسائي على الصواب ، وأبا علي الأسيوطي رواه عن النسائي على الصواب . |(@)(@@)(@@)(@@) ||| 1 ( حرف الصاد ) 1(@)(@@)(@@)(@@) ||| 2 ( 637 - ومن مسند أبي صرمة الأنصاري المازني عن النبي صلى الله عليه وسلم واسمه فيما قيل : قيس بن مالك ؛ وقيل : مالك بن قيس ؛ وقيل : مالك بن أبي قيس ) 2(@)PageV09P227 * 12063 ( د ت ق ) حديث : من ضار ضار الله به ، ومن شاق شق الله عليه . د في القضايا ( 31 : 3 ) عن قتيبة ، عن ليث ، عن يحيى بن سعيد ، عن محمد بن يحيى بن حبان ، عن لؤلؤة ، عن أبي صرمة به . قال غير قتيبة في هذا الحديث : عن أبي صرمة صاحب النبي . ت في البر ( والصلة 27 : 1 ) عن قتيبة به ، وقال : حسن غريب . ق في الأحكام ( 17 : 3 ) عن محمد بن رمح ، عن الليث به . رواه زهير ، عن يحيى ، عن محمد ، عن مولاة لهم ، سمعت أبا صرمة به . ورواه سليمان بن بلال ، عن يحيى ، عن محمد ، عن لؤلؤة مولاة الأنصار .(@)(@@)(@@)(@@) $ 12064 ( س ) حديث : أصبنا سبايا في غزوة بالمصطلق . . . الحديث . س 
ms3065	 في عشرة النساء ( الكبرى 36 ألف : 5 ) وفي النعوت ( الكبرى 25 ) عن هارون بن عبد الله ، عن ابن أبي فديك ، عن الضحاك بن عثمان ، عن محمد بن يحيى بن حبان ، عن ابن محيريز ، أنه سمع أبا صرمة وأبا سعيد الخدري ( ح 4111 ) يقولان . . . فذكره . رواه إسماعيل بن جعفر ويحيى بن أيوب ، عن ربيعة بن عبد الرحمن ، عن محمد بن يحيى بن حبان ، عن ابن محيريز ، أن أبا صرمة سأل أبا سعيد ، هل سمعت رسول الله يذكر العزل ؟ فالله أعلم .(@)PageV09P228(@)(@@)(@@)(@@) ||| 2 ( ( 221 ) ومن مسند أبي صفوان بن عميرة ) 2(@)(@@) * في مسند سويد بن قيس ( ح 4810 ) . |(@)(@@)(@@)(@@) ||| 1 ( حرف الطاء ) 1(@)(@@) ( * )(@)(@@)(@@)(@@) ||| ( 261 ) ومن مسند أبي الطفيل ، واسمه عامر بن واثلة الليثي(@)(@@)(@@)(@@) ||| * تقدم في حرف العين ( ح 5050 5054 ) . | ( * )(@)(@@)(@@)(@@) ||| ( 169 ) ومن مسند أبي طلحة ، واسمه زيد بن سهل الأنصاري(@)(@@)(@@)(@@) ||| * تقدم في حرف الزاي ( ح 3768 3783 ) . |(@)(@@)(@@)(@@) ||| 1 ( حرف العين ) 1(@)(@@)(@@)(@@) ||| 2 ( 638 - ومن مسند أبي عامر الأشعري عن النبي صلى الله عليه وسلم واختلف في اسمه ، فقيل : عبد الله بن هانىء ؛ وقيل : عبد الله بن وهب ؛ وقيل : عبيد بن وهب ، سكن الشأم ، وليس بعم أبي موسى الأشعري ، ذاك قتل أيام حنين في حياة النبي صلى الله عليه وسلم ، واسمه عبيد بن حضار ، وهذا بقي إلى زمان عبد الملك بن مروان ) 2(@)PageV09P229 * 12065 ( خت د ) حديث : ليكونن في أمتي أقوام يستحلون الخمر والحرير . . . الحديث . في مسند أبي مالك الأشعري ( ح 12161 ) .(@)(@@)(@@)(@@) $ 12066 ( ت ) حديث : نعم الحي الأزد والأشعرون . . . الحديث . ت في المناقب ( 147 : 7 ) عن إبراهيم بن يعقوب ، عن وهب بن جرير ، عن أبيه ، قال : سمعت عبد الله بن ملاذ ، يحدث عن نمير بن أوس ، عن مالك بن مسروح ، عن عامر ابن أبي عامر الأشعري ، عن أبيه به . وقال : غريب ، لا نعرفه إلا من حديث وهب بن جرير(@)PageV09P230 رواه أبو خيثمة زهير بن حرب وغيره ، عن وهب بن جرير ، عن أبيه ، عن ابن ملاذ ، عن نمير بن أوس . | ( * )(@)(@@)(@@)(@@) ||| ( 324 ) ومن مسند أبي عبد الله 
ms3066	 الصنابحي(@)(@@)(@@)(@@) ||| * في مسند عبد الله الصنابحي ( ح 9677 9678 ) . |(@)(@@)(@@)(@@) ||| 2 ( ( 357 ومن مسند أبي عبد الله غير منسوب ) 2(@)(@@) * في مسند عتبة بن فرقد ح 9758 ) . |(@)(@@)(@@)(@@) ||| 2 ( 639 - ومن مسند أبي عبد الرحمن الفهري عن النبي صلى الله عليه وسلم قيل : اسمه عبد ؛ وقيل : كرز بن ثعلبة ؛ وقيل : الحارث بن هشام ؛ وقيل : يزيد ابن أنيس بن عبد الله بن عمرو بن حبيب بن عمرو بن شيبان بن محارب بن فهر ) 2(@)PageV09P231 * 12067 ( د ) حديث : شهدت مع النبي حنينا ، فسرنا في يوم قائظ شديد الحر . . . الحديث . د في الأدب ( 166 ) عن موسى بن إسماعيل ، عن حماد بن سلمة ، عن يعلى بن عطاء ، عن أبي همام عبد الله بن يسار ، أن أبا عبد الرحمن الفهري قال : شهدت . . . فذكره . |(@)(@@)(@@)(@@) ||| 2 ( 640 - ومن مسند أبي عبد الرحمن الجهني عن النبي صلى الله عليه وسلم وهو مختلف في صحبته ) 2(@)(@)(@@)(@@)(@@) $ 12068 ( ق ) حديث : إني راكب غدا إلى اليهود ، فلا تبدؤهم بالسلام . . . الحديث . ق في الأدب ( 13 : 3 ) عن أبي بكر بن أبي شيبة ، عن عبد الله بن نمير ، عن محمد بن إسحاق ، عن يزيد بن أبي حبيب ، عن مرثد بن عبد الله اليزني ، عن أبي عبد الرحمن الجهني به . ز رواه عبد الحميد بن جعفر وعبد الله بن لهيعة ، عن يزيد بن أبي حبيب ،(@)PageV09P232 عن مرثد بن عبد الله اليزني ، عن أبي بصرة الغفاري ( ح 3447 ) ( 9232 ) . |(@)(@@)(@@)(@@) ||| 2 ( ( 330 ) ومن مسند أبي عبس بن جبر ، واسمه عبد الرحمن ) 2(@)(@@) * تقدم في حرف العين ( ح 9692 ) . |(@)(@@)(@@)(@@) ||| 2 ( 641 - ومن مسند أبي عبيد مولى النبي عن النبي صلى الله عليه وسلم ) 2(@)(@)(@@)(@@)(@@) $ 12069 ( تم ) حديث : طبخت للنبي قدرا ، وكان يعجبه الذراع . . . الحديث . ت في الشمائل ( 26 : 19 : عن بندار ، عن مسلم بن إبراهيم ، عن أبان بن يزيد ، عن قتادة ، عن شهر بن حوشب ، عنه به . | ( * )(@)(@@)(@@)(@@) ||| ( 259 ) ومن مسند أبي عبيدة بن الجراح ، واسمه عامر بن عبد الله بن الجراح(@)(@@)(@@)(@@) ||| * تقدم في حرف العين ( ح 5045 5048 ) . | ( * )(@)(@@)(@@)(@@) ||| ( 593 
ms3067	 ) ومن مسند أبي عزة الهذلي ، واسمه يسار بن عبد(@)(@@)(@@)(@@) ||| * تقدم في حرف الياء ( ح 11834 )(@)PageV09P233(@)(@@)(@@)(@@) ||| 2 ( 642 - ومن مسند أبي عقبة الفارسي عن النبي صلى الله عليه وسلم قيل : اسمه رشيد ، وهو مولى الأنصار ؛ وقيل : مولى بني هاشم ) 2(@)(@)(@@)(@@)(@@) $ 12070 ( د ق ) حديث : شهدت مع النبي أحدا ، فضربت رجلا من المشركين . . . الحديث . د في الأدب ( 121 : 7 ) عن محمد بن عبد الرحيم ، عن الحسين بن محمد ، عن جرير بن حازم ، عن محمد بن إسحاق ، عن داود بن حصين ، عن عبد الرحمن بن أبي عقبة ، عن أبي عقبة وكان مولى من أهل فارس . . . فذكره . ق في الجهاد ( 13 : 2 ) عن أبي بكر بن أبي شيبة ، عن حسين بن محمد نحوه . |(@)(@@)(@@)(@@) ||| 2 ( 643 - ومن مسند أبي عقرب البكري عن النبي صلى الله عليه وسلم وهو والد أبي نوفل بن أبي عقرب ؛ وقيل : جده ، مختلف في اسمه ، قيل : اسمه خويلد بن بجير ؛ وقيل : عويج بن خويلد ) 2(@)(@)(@@)(@@)(@@) $ 12071 ( س ) حديث : سألت النبي عن الصوم ، فقال : صم يوما من الشهر ، قلت : إني أقوى . . . الحديث . س في الصوم ( 52 : 1 ) عن عمرو بن علي ، عن سيف بن عبيد الله الجرمي من خيار الخلق و ( 52 : 2 ) عن عبد الرحمن بن محمد بن سلام ، عن يزيد بن هارون كلاهما عن الأسود بن شيبان ، عن أبي نوفل ابن أبي عقرب ، عن أبيه به . أبو نوفل هو معاوية بن مسلم ؛ ويقال : ابن عقرب بن أبي عقرب ، ولكن كذا جاء فيهما .(@)PageV09P234(@)(@@)(@@)(@@) ||| 2 ( 644 - ومن مسند أبي عمرة الأنصاري والد عبد الرحمن بن أبي عمرة عن النبي صلى الله عليه وسلم مختلف في اسمه قيل : اسمه بشير بن عمرو بن محصن ؛ وقيل : ثعلبة بن عمرو بن محصن ؛ وقيل : عمرو بن محصن ؛ وقيل غير ذلك ) 2(@)(@)(@@)(@@)(@@) $ 12072 ( د ) حديث : أتينا النبي ثلاثة نفر ومعنا فرس ، فأعطى كل إنسان منا سهما . . . الحديث . د في الجهاد ( 154 : 3 ) عن مسدد ، عن أمية بن خالد ، عن المسعودي ، عن رجل من آل أبي عمرة ، عن 
ms3068	 أبي عمرة به . و ( 154 : 2 ) عن أحمد بن حنبل ، عن المقرىء ، عن المسعودي ، قال : حدثني أبو عمرة ، عن أبيه نحوه . ز كذا أخرجه أبو القاسم في هذه الترجمة ترجمة أبي عمرة والد عبد الرحمن بن أبي عمرة وهو آخر غيره . وأما الذي بعده ( ح 12073 ) فهو من هذه الترجمة .(@)PageV09P235 * 12073 ( س ) حديث : كنا مع النبي في غزاة ، فأصاب الناس مخمصة . . . الحديث . س في السير ( الكبرى 128 : 2 ) وفي اليوم والليلة ( 311 ألف ) عن سويد ابن نصر ، عن عبد الله بن المبارك ، عن الأوزاعي ، عن المطلب بن عبد الله بن حنطب المخزومي ، قال : حدثني عبد الرحمن بن أبي عمرة الأنصاري ، قال : حدثني أبي . . . فذكره . |(@)(@@)(@@)(@@) ||| 2 ( 645 - ومن مسند أبي عمرو بن حفص بن المغيرة بن عبد الله بن عمر ابن مخزوم المخزومي عن النبي صلى الله عليه وسلم وهو زوج فاطمة بنت قيس ، قيل : اسمه أحمد ؛ وقيل : عبد الحميد ؛ وقيل : اسمه كنيته وهو ابن عم خالد بن الوليد والحارث بن هشام ) 2(@)(@)(@@)(@@)(@@) $ 12074 ( س ) حديث : خطبة عمر في اعتذاره من نزع خالد بن الوليد ، فقال أبو عمرو : لقد نزعت عاملا استعمله رسول الله صلى الله عليه وسلم . . . الحديث . س في المناقب ( الكبرى 42 : 2 ) عن إبراهيم بن يعقوب ، عن وهب بن زمعة ، عن ابن المبارك ، عن سعيد بن يزيد ، قال : سمعت الحارث بن يزيد الحضرمي ، يحدث عن علي بن رباح ، عن ناشرة بن سمي اليزني ، قال : سمعت عمر بن الخطاب . . . فذكره . |(@)(@@)(@@)(@@) ||| 2 ( 646 - ومن مسند أبي عنبة الخولاني عن النبي صلى الله عليه وسلم وقيل : لا صحبة له ) 2(@)PageV09P236 * 12075 ( ق ) حديث : لا يزال الله يغرس في هذا الدين غرسا يستعملهم في طاعته . ق في السنة ( المقدمة 1 : 8 ) عن هشام بن عمار ، عن الجراح بن مليح البهراني ، عن بكر بن زرعة ، قال : سمعت أبا عنبة الخولاني وكان قد صلى مع النبي القبلتين قال : سمعت رسول الله صلى الله عليه وسلم . . . فذكره .(@)(@@)(@@)(@@) $ 12075 ( ألف ق ) ( حديث : أن النبي كان يقرأ 
ms3069	 في الجمعة ب سبح اسم ربك الأعلى } ( الأعلى 87 : 1 ) . . . الحديث . ق في الجمعة الصلاة 129 : 3 عن هشام بن عمار ، عن الوليد بن مسلم ، عن ابن سنان ، عن أبي الزاهرية ، عن أبي عنبة الخولاني به ) . |(@)(@@)(@@)(@@) ||| 2 ( ( 170 ) ومن مسند أبي عياش الزرقي ، واسمه زيد بن الصامت ) 2(@)(@@) * تقدم في حرف الزاي ( ح 3784 ) ( 9237 ) . |(@)PageV09P237(@)(@@)(@@)(@@) ||| 2 ( 647 - ومن مسند أبي عياش ويقال : ابن أبي عياش ؛ ويقال : ابن عائش عن النبي صلى الله عليه وسلم ويقال : إنه الزرقي ) 2(@)(@)(@@)(@@)(@@) $ 12076 ( د سي ق ) حديث : ( من قال إذا أصبح : ( لا إله إلا الله وحده ، لا شريك له ، له الملك ) ) . . . الحديث . د في الأدب ( 110 : 11 ) عن موسى ، عن حماد ووهيب ، كلاهما عن سهيل بن أبي صالح ، عن أبيه ، عن ابن أبي عياش وقال حماد : عن أبي عياش به . وفي حديث حماد : فرأى رجل رسول الله صلى الله عليه وسلم فيما يرى النائم ، فقال : يا رسول الله إن أبا عياش يحدث عنك بكذا وكذا ، قال : ( صدق أبو عياش ) . قال أبو داود : رواه إسماعيل بن جعفر وموسى الزمعي وعبد الله بن جعفر ، عن سهيل ، عن أبيه ، عن أبي عياش . س في اليوم والليلة ( 15 : 3 ) عن إبراهيم بن يعقوب ، عن الحسن بن موسى ، عن حماد بن سلمة ، عن سهيل ، عن أبيه ، عن أبي عياش الزرقي نحوه . ق في الدعاء ( 14 : 1 ) عن أبي بكر بن أبي شيبة ، عن الحسن ابن موسى نحوه(@)PageV09P238 * 12076 ( ألف د ) حديث : كنا مع رسول الله صلى الله عليه وسلم بعسفان وعلى المشركين خالد بن الوليد فصلينا الظهر . . . الحديث . د في الصلاة 282 عن سعيد بن منصور ، عن جرير بن عبد الحميد ، عن منصور ، عن مجاهد ، عن أبي عياش به ) . |(@)(@@)(@@)(@@) ||| 1 ( حرف الغين ) 1(@)(@@)(@@)(@@) ||| 2 ( 648 - ومن مسند أبي الغوث الخثعمي ثم الفرعي عن النبي صلى الله عليه وسلم ) 2(@)(@)(@@)(@@)(@@) $ 12077 ( ق ) حديث : أنه استفتى النبي صلى الله عليه وسلم في حجة كانت على أبيه . . . الحديث . ق في الحج ( 9 
ms3070	 : 3 ) عن هشام بن عمار ، عن الوليد بن مسلم ، عن عثمان ابن عطاء ، عن أبيه ، عن أبي الغوث رجل من الفرع . . . فذكره . |(@)(@@)(@@)(@@) ||| 1 ( حرف الفاء ) 1(@)(@@)(@@)(@@) ||| 2 ( 649 - ومن مسند أبي فاطمة الأزدي الدوسي ويقال : الليثي النبي صلى الله عليه وسلم قيل : اسمه أنيس ؛ وقيل : عبد الله بن أنيس ، سكن الشأم ) 2(@)PageV09P239 * 12078 ( د س ق ) حديث : ( يا أبا فاطمة أكثر من السجود ، فإنه ليس من مسلم يسجدلله سجدة إلا رفعه الله بها درجة ) . وفي حديث زيد بن واقد : أنه قال : يا رسول الله حدثني بعمل أستقيم عليه وأعمله . . . الحديث . ك د في الصلاة ( ؟ ) عن قتيبة بن سعيد ، عن ابن لهيعة ، عن الحارث بن يزيد ، عن كثير الأعرج ، قال : سمعت أبا فاطمة قال : رسول الله صلى الله عليه وسلم . . فذكره . س في البيعة ( 14 ) وفي السير ( الكبرى 18 ) عن هارون بن محمد بن بكار بن بلال ، عن محمد بن عيسى بن القاسم بن سميع ، عن زيد بن واقد ، عن كثير بن مرة أن أبا فاطمة حدثه به . ق في الصلاة ( 240 : 1 ) عن هشام بن عمار ودحيم . كلاهما عن الوليد بن مسلم . عن عبد الرحمن بن ثابت بن ثوبان ، عن أبيه ، عن مكحول ، عن كثير بن مرة نحوه . ز رواه الهيثم بن حميد ، عن زيد بن واقد ، عن سليمان بن موسى ، عن كثير بن مرة . ك حديث د في رواية أبي الطيب الأشناني ، ولم يذكره أبو القاسم . |(@)(@@)(@@)(@@) ||| 1 ( حرف القاف ) 1(@)(@@)(@@)(@@) ||| 2 ( 650 - ومن مسند أبي قتادة الأنصاري عن النبي صلى الله عليه وسلم واختلف في اسمه فقيل : الحارث ؛ وقيل : النعمان ؛ وقيل : عمرو بن ربعي ابن بلدمة بن خناس بن سنان بن عبيد بن عدي بن غنم بن كعب بن سلمة ابن سعد بن علي بن أسد بن ساردة بن تزيد بن جشم بن الخزرج السلمي ) 2(@)PageV09P240 ( * ) أنس بن مالك أبو حمزة الأنصاري ، عن أبي قتادة(@)(@@)(@@)(@@) $ 12079 ( ق ) حديث : ( الآيات بعد المائتين ) . ك ق في الفتن ( 28 : 3 ) عن الحسن 
ms3071	 بن علي الخلال ، عن عون بن عمارة ، عن عبد الله بن المثنى بن ثمامة بن عبد الله بن أنس بن مالك ، عن أبيه ، عن جده ، عن أنس بن مالك به . هكذا وقع نسب عبد الله بن المثنى عنده ، وذكر ( ثمامة ) هنا زيادة ، لا حاجة إليها ، فإن ثمامة ( أخو المثنى ) ، لا ( أبوه ) والله أعلم . وسقط من نسخة السماع عن أنس بن مالك ، وثبت في بعض الأصول القديمة ، وهو الصواب إن شاء الله تعالى . ك لم يذكره أبو القاسم . | ( * ) إياس بن حرملة الشيباني ، عن أبي قتادة ويقال : حرملة بن إياس ؛ ويقال : أبو حرملة(@)(@@)(@@)(@@) $ 12080 ( س ) حديث : ( صوم عاشوراء يكفر السنة الماضية ، وصوم عرفة يكفر السنتين الماضية والمستقبلة ) . س في الصوم ( الكبرى 62 : 1 ) عن عبيد الله بن سعيد ، عن يحيى ، عن سفيان ، عن منصور ، عن مجاهد و ( 62 : 5 ) عن موسى بن عبد الرحمن ، عن حسين بن علي ، عن زائدة ، عن منصور ، عن أبي الخليل كلاهما عن إياس بن حرملة به . و ( 62 : 2 ) عن محمود بن غيلان ، عن عبد الرزاق ، عن سفيان ، عن منصور ، عن مجاهد ، عن حرملة بن إياس به . و ( 62 : 3 ) عن عيسى بن محمد ، عن الفريابي ،(@)PageV09P241 عن سفيان ، عن منصور و ( 62 : 11 ) عن محمد بن عبد الله بن يزيد ، ( 9241 ) عن أبيه ، عن همام ، عن قتادة و ( 62 : 12 ) عن عمرو بن علي ، عن أبي داود ، عن همام ، عن عطاء ثلاثتهم عن أبي الخليل ، عن حرملة بن إياس به . و ( 62 : 8 ) عن محمد بن عبد الله بن يزيد ، عن سفيان ، عن داود بن شابور ، عن قزعة ، عن أبي الخليل ، عن أبي حرملة به . و ( 62 : 9 ) عن مسعود بن جويرية والحسين بن عيسى وهارون بن عبد الله ، ثلاثتهم عن سفيان ، عن داود بن شابور ، عن أبي قزعة ، عن أبي الخليل ، عن أبي حرملة به . و ( 62 : 10 ) عن محمد بن عبيد الله ، عن الحسن بن بشر ، عن زهير ، عن أبي الزبير ، عن أبي الخليل ، عن 
ms3072	 أبي حرملة به . وقال : الحسن ابن بشر ليس بالقوي في الحديث عندنا . روي عن أبي الخليل ، عن أبي قتادة ( ح 1284 ) . وروي عن أبي الخليل ، عن عبد الله بن أبي قتادة ، عن أبي قتادة ( ح 12100 ) . وروي عن أبي الخليل ، عن حرملة بن إياس ، عن مولى لأبي قتادة ، عن أبي قتادة ، وسيأتي ( لم يذكره هناك ، بل أحاله على ههنا ) . | ( * ) جابر بن عبد الله بن عمرو بن حرام الأنصاري ، عن أبي قتادة(@)(@@)(@@)(@@) $ 12081 ( ت ) حديث : أنه رأى النبي صلى الله عليه وسلم يبول مستقبل القبلة . ت في الطهارة ( 7 : 2 ) عن قتيبة ، عن ابن لهيعة ، عن أبي الزبير ، عن جابر به . ز رواه أبان بن صالح ، عن مجاهد ، عن جابر عن النبي صلى الله عليه وسلم وقد مضى ( ح 2574 )(@)PageV09P242 ( * ) ( 2 ) - حرملة بن إياس الشيباني ، عن أبي قتادة | * في ترجمة إياس بن حرملة ، عن أبي قتادة ( ح 12080 ) . | ( * ) ( 20 ) - ( سعد بن مالك أبو سعيد الخدري ، عن أبي قتادة | * يأتي في سعيد ح 12134 ) . | ( * ) سعيد بن المسيب بن حزن المخزومي ، عن أبي قتادة(@)(@@)(@@)(@@) $ 12082 ( د ق ) حديث : ( قال الله تعالى : افترضت على أمتك خمس صلوات ) . . . الحديث . ك د في الصلاة ( 9 : 6 ) عن حيوة بن شريح ق فيه ( الصلاة 233 : 5 ) عن يحيى بن عثمان بن سعيد بن كثير بن دينار كلاهما عن بقية بن الوليد ، عن ضبارة بن عبد الله بن أبي السليك الألهاني ، عن دويد بن نافع ، عن الزهري قال : قال سعيد . . . فذكره . ك حديث د في رواية أبي سعيد بن الأعرابي ، عن محمد بن عبد الملك الرواس ، عن أبي داود ، ولم يذكره أبو القاسم . | ( * ) صالح بن أبي مريم أبو الخليل الضبعي ، عن أبي قتادة(@)(@@)(@@)(@@) $ 12083 ( د ) حديث : أن النبي صلى الله عليه وسلم كره الصلاة نصف النهار ، إلا يوم الجمعة . . . الحديث . د في الصلاة ( 224 ) عن محمد بن عيسى ، عن حسان بن إبراهيم ، عن ليث ، عن مجاهد ، عن أبي الخليل به . وقال : هذا مرسل ، أبو الخليل لم يسمع من 
ms3073	 أبي قتادة ، ومجاهد أكبر من أبي الخليل .(@)PageV09P243 * 12084 ( س ) حديث : ( صوم يوم عاشوراء كفارة سنة ، وصوم يوم عرفة كفارة سنتين ) . . . الحديث . س في الصوم ( الكبرى 62 : 13 ) عن حاجب بن سليمان ، عن وكيع و ( 62 : 14 ) عن عبد الرحمن بن محمد بن سلام ، عن محمد بن ربيعة كلاهما عن ابن أبي ليلى ، عن عطاء ، عن أبي الخليل به . و ( 62 : 6 ) عن القاسم بن زكريا ، عن إسحاق بن منصور ، عن شريك ، عن منصور ، عن أبي الخليل به مختصرا : ( صيام يوم عرفة كفارة سنة قبله وسنة بعده ) . و ( 62 : 15 ) عن إبراهيم بن الحسن ، عن حجاج ، عن ابن جريج ، عن عطاء ، عن أبي الخليل به موقوفا . و ( 62 : 16 ) عن هلال بن العلاء بن هلال ، عن أبيه ، عن عبيد الله بن عمرو ، عن عبد الكريم وهو ابن مالك الجزري ، عن عطاء ، عن كعب قوله : و ( 62 : 17 ) عن أحمد بن إبراهيم بن محمد ، عن أبي النضر وهو إسحاق بن إبراهيم الفراديسي ، عن صدقة وهو ابن خالد ، عن عثمان بن الأسود ، عن عطاء ومجاهد قالا : كنا نصوم عاشوراء ، حتى قدم علينا عبد الكريم بن أبي المخارق فأخبرنا أن صومه . . . فذكره قوله : قال عثمان : فلقيت عبد الكريم ، فلقيني مثل ذلك . ز وفيه خلاف مذكور في ترجمة إياس بن حرملة ، عن أبي قتادة ( ح 12080 ) . | ( * ) عبد الله بن رباح الأنصاري المدني ، عن أبي قتادة(@)(@@)(@@)(@@) $ 12085 ( د ت س ) حديث : ليس في النوم تفريط ، إنما التفريط في اليقظة . . . ( الحديث ) مختر . د في الصلاة ( 11 : 7 ) عن عباس العنبري ، عن سليمان بن داود ، عن(@)PageV09P244 سليمان بن المغيرة ، عن ثابت ، عنه به . ت فيه ( الصلاة 16 ) ( 9244 ) عن قتيبة ، عن حماد بن زيد ، عن ثابت به ، وقال : حسن صحيح . س فيه ( الصلاة 77 : 2 ) عن قتيبة به . و ( 77 : 3 ) عن سويد بن نصر ، عن عبد الله بن المبارك ، عن سليمان بن المغيرة أتم من الأول .(@)(@@)(@@)(@@) $ 12086 ( ت س ق ) حديث : ساقى القوم آخرهم شربا مختصر . ت 
ms3074	 في الأشربة ( 20 ) عن قتيبة ، عن حماد بن زيد ، عن ثابت ، عنه به ، وقال : حسن صحيح . س في الوليمة ( الكبرى 133 ) عن قتيبة به ولم يقل شربا . ق في الأشربة ( 26 ) عن أحمد بن عبدة وسويد بن سعيد ، عن حماد بن زيد به .(@)(@@)(@@)(@@) $ 12087 ( م تم ) حديث : كان النبي إذا كان في سفر فعرس بليل اضطجع على يمينه ، وإذا عرس قبيل الصبح نصب ذراعه ووضع رأسه على كفه . م في الصلاة ( 108 : 6 ) عن إسحاق ، عن سليمان بن حرب ، عن حماد بن سلمة ، عن حميد الطويل ، عن بكر بن عبد الله المزني ، عنه به . ت في الشمائل ( 40 : 7 ) عن حسين ابن محمد الحريري ، عن سليمان بن حرب نحوه . لم يذكره خلف ، وذكره أبو مسعود والحميدي . وقال أبو القاسم : لم أجده في كتاب مسلم .(@)(@@)(@@)(@@) $ 12088 ( د ت ) حديث : أن النبي خرج ليلة ، فإذا هو بأبي بكر يصلي يخفض من صوته ، قال : ومر بعمر بن الخطاب . . . الحديث . د في الصلاة ( 316 : 3 ) عن الحسن بن الصباح ، عن يحيى بن إسحاق ، عن حماد بن سلمة ، عن ثابت البناني ، عنه به .(@)PageV09P245 و ( 316 : 3 ) عن موسى ، عن حماد ، عن ثابت البناني ، عن النبي ( 9245 ) مرسلا . ت فيه ( الصلاة 213 : 1 ) عن محمود بن غيلان ، عن يحيى بن إسحاق به . وقال : غريب ، إنما أسنده يحيى بن إسحاق ، عن حماد ، وأكثر الناس إنما رووا هذا عن ثابت ، عن ابن رباح مرسل .(@)(@@)(@@)(@@) $ 12089 ( د ق ) حديث : أن النبي كان في سفر ، فمال ، وملت معه . . . الحديث في نومهم عن صلاة الصبح مختصر . د في الصلاة ( 11 : 3 ) عن موسى ، عن حماد ، عن ثابت البناني ، عنه به . و ( 11 : 4 ) عن علي بن نصر ، عن وهب بن جرير ، عن الأسود بن شيبان ، عن خالد بن سمير ، عن عبد الله بن رباح نحوه . ق فيه ( الصلاة 10 : 4 ) عن أحمد بن عبدة الضبي ، عن حماد بن زيد ، عن ثابت به .(@)(@@)(@@)(@@) $ 12090 ( م ) حديث : خطبنا النبي فقال : إنكم تسيرون عشيتكم 
ms3075	 وليلتكم وتأتون الماء إن شاء الله غدا . . . الحديث بطوله . وفيه : ليس في النوم تفريط ، إنما التفريط في اليقظة . وفيه قصة نومهم عن صلاة الصبح ، وقوله : فليصلها من الغد لوقتها . وفيه : ساقى القوم آخرهم شربا . وفي آخره قصة عمران بن حصين ( ح 10833 ) . م في الصلاة ( 108 : 3 ) عن شيبان بن فروخ ، عن سليمان بن المغيرة ، عن ثابت ، عنه به .(@)(@@)(@@)(@@) $ 12091 ( د ) حديث : أن النبي كان في سفر له فعطشوا ، فانطلق سرعان الناس ، ولزمت رسول الله تلك الليلة ، فقال : حفظك الله بما حفظت به نبيه . د في الأدب ( 163 ) عن موسى بن إسماعيل ، عن حماد ، عن ثابت ، عنه به . وهو طرف(@)PageV09P246 من الحديث الذي قبله ( ح 12090 ) .(@)(@@)(@@)(@@) $ 12092 ( د ) حديث : أن النبي قال لأبي بكر : متى توتر ؟ قال : من أول الليل ، وقال لعمر . . . الحديث . د في الصلاة ( 343 : 3 ) عن محمد بن أحمد بن أبي خلف ، عن أبي زكريا يحيى بن أبي إسحاق السيلحيني ، عن حماد بن سلمة ، عن ثابت ، عنه به . وهو بعض حديث قد تقدم ( ح 12088 ) .(@)(@@)(@@)(@@) $ 12093 ( س ) حديث : أن النبي لما ناموا عن الصلاة حتى طلعت الشمس ، قال : فليصلها أحدكم من الغد لوقتها مختصر من الحديث الطويل . س في الصلاة ( 78 : 1 ) عن عمرو بن علي الفلاس ، عن أبي داود الطيالسي ، عن شعبة ، عن ثابت البناني ، عنه به .(@)(@@)(@@)(@@) $ 12094 ( س ) حديث : أن النبي صعد المنبر فأمر المنادي أن ينادي الصلاة جامعة ، فقال : ثاب خبر ثاب خبر . . . الحديث . س في المناقب ( الكبرى 6 : 3 ، و 42 : 1 ) عن محمد بن حاتم بن نعيم ، عن محمد بن علي ، عن أبيه ، عن عبد الله ابن المبارك ، عن الأسود بن شيبان ، عن خالد بن سمير ، عنه به .(@)(@@)(@@)(@@) $ 12095 ( س ) حديث : بعث النبي جيش الأمراء ، فقال : عليكم زيد بن حارثة ، فإن أصيب زيد فجعفر . . . الحديث . س في المناقب ( الكبرى 34 : 1 ) عن عمرو بن علي ، عن ابن مهدي ، عن الأسود بن شيبان ، عن خالد بن سمير ، عنه به وهو في معنى الحديث 
ms3076	 المتقدم ( ح 12094 ) . | ( * ) عبد الله بن أبي قتادة الأنصاري ، عن أبيه | ( * ) حصين بن عبد الرحمن ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12096 ( خ د س ) حديث : سرنا مع رسول الله ليلة ، فقال بعض القوم : لو عرست بنا يا رسول الله قال : أخاف أن تناموا عن الصلاة . . . الحديث . خ في الصلاة(@)PageV09P247 ( 145 ) عن عمران بن ميسرة ، عن محمد بن فضيل وفي التوحيد ( 31 : 8 ) عن محمد بن سلام ، عن هشيم د في الصلاة ( 11 : 5 ) عن عمرو بن عون ، عن خالد بن عبد الله و ( 11 : 6 ) عن هناد ، عن عبثر بن القاسم أربعتهم عنه به . س فيه ( الصلاة ، الكبرى 341 ) عن هناد به . وفي التفسير ( في الكبرى ) عن محمد بن كامل المروزي ، عن هشيم به . | ( * ) زيد بن أسلم ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12097 ( سي ق ) حديث : خير ما يخلف الرجل من بعده ثلاث : ولد صالح يدعو له . . . الحديث . س في اليوم والليلة ( ؟ ) عن إسماعيل بن عبيد بن أبي كريمة الحراني ، عن محمد بن سلمة ، عن أبي عبد الرحيم ، عن زيد بن أبي أنيسة ، عن زيد ابن أسلم به . ك ق في السنة ( المقدمة 20 : 3 ) عن إسماعيل بن عبيد به . و ( 20 : 4 ) عن أبي حاتم الرازي ، عن محمد بن يزيد بن سنان الرهاوي ، عن أبيه ، عن زيد بن أبي أنيسة ، عن فليح بن سليمان ، عن زيد بن أسلم به . ك حديث ق عن إسماعيل لم يذكره أبو القاسم وهو في الرواية ، وأما حديثه عن أبي حاتم فهو في بعض النسخ دون بعض ، ولعله من زيادات أبي الحسن القطان ، عن أبي حاتم والله أعلم . | ( * ) سعيد بن أبي سعيد المقبري ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12098 ( م د س ) حديث : أنه قام فيهم فذكر لهم أن الجهاد في سبيل الله والإيمان با أفضل الأعمال ، فقام رجل فقال : يا رسول الله أرأيت إن قتلت في سبيل الله تكفر عني خطاياي . . . الحديث . م في 
ms3077	 الجهاد ( 5 : 1 ) عن قتيبة ، عن ليث و ( 5 : 2 ) عن أبي بكر بن أبي شيبة ومحمد بن المثنى ، كلاهما عن يزيد بن هارون ، عن يحيى بن سعيد كلاهما عن سعيد بن أبي سعيد المقبري به . ت فيه ( الجهاد 58 ) عن قتيبة به ، وقال حسن صحيح . وروى يحيى بن سعيد الأنصاري وغيره هذا عن سعيد(@)PageV09P248 المقبري . وروى بعضهم هذا الحديث عن سعيد المقبري ، عن أبي هريرة ، ( 9248 ) والأول أصح . س فيه ( الجهاد 22 : 3 ) عن قتيبة به . و ( 22 : 2 ) عن محمد بن سلمة والحارث بن مسكين ، كلاهما عن ابن القاسم ، عن مالك ، عن يحيى بن سعيد به . | ( * ) سلمة بن دينار أبو حازم ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12099 ( خ م س ) حديث : في قصة الحمار الوحشي . خ في الجهاد ( 46 : 1 ) عن محمد بن أبي بكر المقدمي ، عن فضيل بن سليمان وفي الأطعمة ( 19 : 1 ) عن محمد بن المثنى ، عن عثمان بن عمر ، عن فليح بن سليمان وفيه ( الأطعمة 19 : 2 ) وفي الهبة ( 3 : 2 ) عن عبد العزيز بن عبد الله ، عن محمد بن جعفر هو ابن أبي كثير ثلاثتهم عن أبي حازم به . م في الحج ( 8 ؛ 14 ) عن أحمد بن عبدة ، عن فضيل بن سليمان به . س في الصيد ( والذبائح 32 : 3 ) عن محمد بن وهب بن أبي كريمة ، عن محمد بن سلمة ، عن أبي عبد الرحيم ، عن زيد بن أبي أنيسة ، عن أبي حازم به . | ( * ) صالح بن أبي مريم أبو الخليل ، عن عبد الله بن أبي قتادة ، عن أبيه | * 12100 ( س ) حديث : صوم يوم عرفة كفارة سنتين . . . الحديث . س في الصوم ( الكبرى 62 : 7 ) عن محمد بن مصطفى ، عن معاوية بن حفص ، عن الحكم بن هشام ، عن قتادة ، عن أبي الخليل به . ز فيه خلاف مذكور في ترجمة إياس ابن حرملة ، عن أبي قتادة ( ح 12080 ) . | ( * ) عبد العزيز بن رفيع ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12101 ( م ) حديث : في قصة 
ms3078	 الحمار الوحشي . م في الحج ( 8 : 15 ) عن قتيبة وإسحاق بن إبراهيم ، كلاهما عن جرير و ( 8 : 15 ) عن أبي بكر بن أبي شيبة ، عن أبي الأحوص كلاهما عنه به . | ( * ) عثمان بن عبد الله بن موهب ، عن عبد الله بن أبي قتادة ، عن أبيه(@)PageV09P249 * 12102 ( خ م س ) حديث : في قصة الحمار الوحشي . خ في الحج ( 187 ) عن موسى بن إسماعيل ، عن أبي عوانة م فيه الحج ( 8 : 11 ) عن أبي كامل الجحدري ، عن أبي عوانة و ( 8 : 12 ) عن محمد بن مثنى ، عن غندر ، عن شعبة ( 8 : 12 ) عن القاسم بن زكريا ، عن عبيد الله بن موسى ، عن شيبان ثلاثتهم عنه به . س فيه المناسك ( 81 : 1 ) عن محمود بن غيلان ، عن أبي داود ، عن شعبة به .(@)(@@)(@@)(@@) $ 12103 ( ت س ق ) حديث : أن النبي أتي برجل ليصلي عليه ، فقال : صلوا على صاحبكم فإن عليه دينا . . . الحديث . ت في الجنائز ( 70 : 1 ) عن محمود بن غيلان ، عن أبي داود ، عن شعبة ، عنه به . وقال : حسن صحيح . س فيه الجنائز ( 67 : 1 ) عن محمود بن غيلان نحوه . وفي البيوع ( 100 ) عن محمد بن عبد الأعلى ، عن خالد ، عن شعبة نحوه . | ق في الأحكام ( 49 : 3 ) عن محمد بن بشار ، عن أبي عامر العقدي ، عن شعبة به . | ( * ) محمد بن قيس المدني ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12104 ( م س ) حديث : في فضل الإيمان با والجهاد في سبيله . م في الجهاد ( 5 : 3 ) عن سعيد بن منصور ، عن سفيان بن عيينة ، عن عمرو بن دينار ، عن محمد بن قيس ؛ و ( 5 : 3 ) عن سفيان ، عن محمد بن عجلان ، عن محمد بن قيس ؛ عن عبد الله بن أبي قتادة به . س فيه الجهاد ( 32 : 4 ) عن عبد الجبار بن العلاء ، عن سفيان بن عيينة ، عن عمرو بن دينار ، عن محمد بن قيس ، عن عبد الله بن أبي قتادة ، عن أبيه : جاء رجل إلى النبي وهو على المنبر فقال : يا رسول الله 
ms3079	 أرأيت إن ضربت بسيفي هذا في سبيل الله صابرا محتسبا . . . فذكره . ز قال حمزة بن محمد الكناني الحافظ صاحب النسائي : هذا الحديث خطأ ، وإنما رواه الثقات عن ابن عيينة ، عن عمرو بن دينار ، عن محمد بن قيس ، عن النبي مرسلا . وعن ابن عيينة ،(@)PageV09P250 عن محمد بن عجلان ، عن محمد بن قيس ، عن عبد الله بن أبي قتادة ، عن أبيه عن النبي صلى الله عليه وسلم . وقد رواه غير واحد عن ابن عيينة ، فجمعهما عمرو بن دينار ومحمد بن عجلان ، فحملوا حديث عمرو بن دينار المرسل على حديث محمد بن عجلان ، ولا أدري كيف جاز هذا على أبي عبد الرحمن ، ولعله اتكل فيه على عبد الجبار .(@)(@@)(@@)(@@) $ 9 - يحيى بن أبي كثير ، عن عبد الله بن أبي قتادة ، عن أبيه(@)(@@)(@@)(@@) $ 12105 ( ع ) حديث : إذا شرب أحدكم فلا يتنفس في الإناء ، وإذا أتى الخلاء فلا يمس ذكره بيمينه ، ولا يتمسح بيمينه . وفي حديث أيوب : نهى أن يتنفس في الإناء ، وأن يمس ذكره بيمينه ، وأن يستطيب بيمينه . وفي حديث أبان : وإذا شرب فلا يشرب نفسا واحدا . وحديث وكيع مختصر : إذا دخل أحدكم الخلاء فلا يمس ذكره بيمينه . وكذلك حديث معمر : نهى أن يمس الرجل ذكره بيمينه . وكذلك حديث القناد : إذا بال أحدكم فلا يأخذ ذكره بيمينه . خ في الطهارة ( 19 ) عن معاذ بن فضالة ، عن هشام و ( 20 ) عن محمد بن يوسف ، عن الأوزاعي وفي الأشربة ( 25 ) عن أبي نعيم ، عن شيبان ثلاثتهم عن يحيى بن أبي كثير به . م في الطهارة ( 18 : 1 ) عن يحيى بن يحيى ، عن عبد الرحمن بن مهدي ، عن همام بن يحيى ، عن يحيى بن أبي كثير به . و ( 18 : 2 ) عن يحيى بن يحيى ، عن وكيع ، عن هشام به . وفيه ( الطهارة 18 : 3 ) وفي الأشربة ( 16 : 1 ) عن ابن أبي عمر ، عن عبد الوهاب الثقفي ، عن أيوب ، عن يحيى بن أبي كثير به . د في الطهارة ( 18 : 1 ) عن مسلم بن إبراهيم وموسى بن إسماعيل ، كلاهما عن أبان 
ms3080	 بن يزيد ، عن يحيى بن أبي كثير به . ت فيه ( الطهارة 11 ) عن ابن أبي عمر ، عن سفيان ، عن معمر ، عن يحيى بن أبي كثير به ، وقال : حسن صحيح . س فيه ( الطهارة 23 : 1 ) عن يحيى بن درست ، عن أبي إسماعيل القناد ، عن يحيى بن أبي كثير به . و ( 23 : 2 ) عن هناد بن السري ، عن(@)PageV09P251 وكيع ( 9251 ) به . و ( 42 : 1 ) عن إسماعيل بن مسعود ، عن خالد بن الحارث ، عن هشام به . و ( 42 : 2 ) عن عبد الله بن محمد بن عبد الرحمن الزهري ، عن عبد الوهاب الثقفي به . ( وفي الوليمة الكبرى 40 عن قتيبة ، عن ابن أبي عدي ، عن حجاج ، عن يحيى ابن أبي كثير بقصة التنفس حسب ) . ق فيه ( الطهارة 15 : 1 ) عن هشام بن عمار ، عن عبد الحميد بن حبيب بن أبي العشرين و ( 15 : 2 ) عن دحيم نحوه ، عن الوليد ابن مسلم كلاهما عن الأوزاعي به ولم يذكر التنفس في الإناء . في كتاب خلف وأبي مسعود : عبد الرحمن بن مهدي ، عن هشام . وفي صحيح مسلم : عن همام . وفي بعض الأصول الصحيحة منه : عن همام بن يحيى .(@)(@@)(@@)(@@) $ 12106 ( خ م د ت س ) حديث : إذا أقيمت الصلاة فلا تقوموا حتى تروني . زاد أبو نعيم : وعليكم السكينة . خ في الصلاة ( 173 ) عن مسلم بن إبراهيم ، عن هشام الدستوائي ، قال : كتب إلي يحيى بن أبي كثير . . . فذكره . و ( 174 ) عن أبي نعيم ، عن شيبان ، عن يحيى به . ( وقال : تابعه علي بن المبارك ) . و ( 334 : 3 ) عن عمرو بن علي ، عن أبي قتيبة ، عن علي بن المبارك ، عن يحيى بن أبي كثير ، عن عبد الله بن أبي قتادة ، عن أبيه لا أعلمه إلا عن النبي به . قال أبو مسعود : كذا : في كتاب(@)PageV09P252 الفربري ، وفي كتاب حماد بن شاكر عن البخاري : عن عبد الله بن أبي قتادة ( 9252 ) أراه عن أبيه . م فيه ( الصلاة 82 : 2 ) عن أبي بكر بن أبي شيبة ، عن سفيان بن عيينة ؛ و ( 82 : 2 ) عن 