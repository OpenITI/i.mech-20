ms2147	 ) قال النبي :(@)(@@) | 30 ( مجالس الذكر تنزل عليهم السكينة ، وتحف بهم الملائكة ، وتغشاهم الرحمة ، ويذكرهم الله على عرشه ) )(@)(@@) ( حل ) عن أبي هريرة وأبي سعيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19822 ) قال النبي :(@)(@@) | 30 ( مجالسة العلماء عبادة ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) ||| ( الميم مع الحاء(@)(@@) من الجامع الكبير ) 3 $(@)(@@)(@@)(@@) $ ( 19823 ) قال النبي :(@)(@@) | 30 ( محبك محبي ، ومبغضك مبغضي قاله لعلي ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الميم مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 19824 ) قال النبي :(@)(@@) | 30 ( مدارة الناس صدقة ) )(@)(@@) ( حب طب هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19825 ) قال النبي :(@)(@@) | 30 ( مدمن الخمر كعابد وثن ) )(@)(@@) ( تخ هب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV06P445(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير(@)(@@)(@@)(@@) $ ( 19826 ) قال النبي :(@)(@@) | مدة رخاء أمتي بعدي مائة سنة ، قيل : يا رسول الله فهل لذالك من آية ؟ قال : نعم ، الخسف والقذف والرجف ) )(@)(@@) ( ك ) والمسخ وإرسال الشياطين الملجمة على الناس ( طب ك ) وتعقب عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19827 ) قال النبي :(@)(@@) | 30 ( مدهن في حدود الله والراكب حدود الله عز وجل والآمر بها ، والناهي ، كمثل قوم استهموا على سفينة من سفن البحر ، فأصاب بعضهم مؤخر السفينة وأبعدها من المرفق وكانوا سفهاء ، وكانوا إذا أتوا على رجال القوم آذوهم ، فقالوا : نحن أقرب أهل السفينة من المرفق وأبعدها من السماء ، فبيننا وبين المرفق أن نخرق السفينة ثم نسده إذا إستضينا عنه ، فقال حزباؤه في السفينة فافعل ، فأهوى بفأس يضرب بها عرض السفينة ، فأشرف عليه رجل فنشده ما تصنع ؟ قال : نحن أقربكم من المرفق وأبعدكم منه أخرق دف هاذه السفينة فإذا استقينا سددناه ، قال : لا تفعل ، فإنك إذا تهلك ونهلك ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19828 ) قال النبي :(@)(@@) | 30 ( مدينة هرقل تفتح أولا ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الميم مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 19829 ) قال النبي :(@)(@@) | 30 ( مر أختك فلتركب ولتختمر ولتصم ثلاثة أيام ، فإن الله عن تعذيب أختك نفسها لغني ) )(@)(@@) ( حم د ن ه ) عن عقبة 
ms2148	 بن عامر ( د ك ) عن ابن عباس PageV06P446 رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 19830 ) قال النبي :(@)(@@) | 30 ( مر رجل بغصن شجرة على ظهر طريق فقال : والله لأنجين هاذا عن المسلمين لا يؤذيهم فأدخل الجنة ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19831 ) قال النبي :(@)(@@) | 30 ( مررت ليلة أسري بي بالملأ الأعلى وجبريل كالحلس البالي من خشية الله تعالى ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19832 ) قال النبي :(@)(@@) | 30 ( مررت ليلة أسري بي على موسى قائما يصلي في قبره ) )(@)(@@) ( حم م ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19833 ) قال النبي :(@)(@@) | 30 ( مروا أبا بكر فليصل بالناس ) )(@)(@@) ( حم ق ت ه ) عن عائشة ، ( ق ) عن أبي موسى ا ، ( خ ) عن ابن عمر ، ( ه ) عن ابن عباس ، وعن سالم بن عبيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 19834 ) قال النبي :(@)(@@) | 30 ( مروا أبا ثابت يتعوذ ، لا رقية إلا في نفس أو حمة أو لدغة ) )(@)(@@) ( حم د ) عن سهل بن حنيف رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 19835 ) قال النبي :(@)(@@) | 30 ( مروا الصبي بالصلاة إذا بلغ سبع سنين ، وإذا بلغ عشر سنين فاضربوه عليها ) )(@)(@@) ( د ) عن سبرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 19836 ) قال النبي :(@)(@@) | 30 ( مروا أولادكم بالصلاة وهم أبناء سبع سنين ، واضربوهم عليها وهم أبناء عشر سنين ، وفرقوا بينهم في المضاجع ، وإذا زوج PageV06P447 أحدكم خادمه عبده أو أجيره فلا ينظر إلى ما دون السرة وفوق الركبة ) )(@)(@@) ( حم د ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19837 ) قال النبي :(@)(@@) | 30 ( مروا بالمعروف وإن لم تفعلوه ، وانهوا عن المنكر وإن لم تجتنبوه كله ) )(@)(@@) ( طص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19838 ) قال النبي :(@)(@@) | 30 ( مروا بالمعروف وانهوا عن المنكر قبل أن تدعوا فلا يستجاب لكم ) )(@)(@@) ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19839 ) قال النبي :(@)(@@) | 30 ( مروه فليتكلم وليستظل وليقعد وليتم صومه ) )(@)(@@) ( حم خ د ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 19840 ) قال النبي :(@)(@@) | 30 ( مرها فإن يك فيها خير فستفعل ، ولا تضرب ظعينتك كضرب أمتك ) )(@)(@@) ( د ح ) عن لقيط