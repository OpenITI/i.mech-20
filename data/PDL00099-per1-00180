ms167	 ملک خامه‌اش‌‌‌ گهربارست PageV1P124(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گاه ط‌رب و رو‌ز می و فصل بهارست %~% جان خرم و دل فارغ و شاهد به‌کنارست(@)(@@) 2 باد سحر از آتش گل مجمره سوزست %~% خاک چمن از آب روان آینه‌دارست(@)(@@) 3 تا می‌نگری کوکبه ی سوری و سرو است %~% تا می‌شنوی زمزمه صلصل و سارست(@)(@@) 4 سورث به چه ماند به یکی حقه یاقوت %~% کان حقه یاقوت پر از مشک تتارست(@)(@@) 5 نسرین به چه ماند به یکی بیضه ی الماس %~% جان بیضه الماس‌ پر از عود قمارست(@)(@@) 6 مانا ز سفر تازه رسیدست بنفشه %~% کش بر خط مشکین اثر گرد و غبارست(@)(@@) 7 از لاله چمن چون خد ترکان خجندست %~% وز سبزه دمن چون خط خوبان تتارست(@)(@@) 8 در پهلوی گل خار شگفتا به چه ماند %~% مانند رقیبی‌که هم آغوش‌ نگارست(@)(@@) 9 مستست مگر نیلوفر از ساغر لاله %~% کافتان خیزان چون صنمی باده گسارست(@)(@@) 10 نی‌نی چو یکی بختی مستست ازیراک %~% بینیش‌ چو بختی که به بینیش مهارست(@)(@@) 11 راغ است‌ ‌که از سبزه همی زمرد خیزست %~% باغ است‌که از لاله همی مرجان زارست(@)(@@) 12 نرگس به چه ماند به یکی‌کفه الماس‌ %~% کان کفه الماس‌ پر از زر عیارست(@)(@@) 13 یا حقه‌یی ازکاه‌ربا ب‌ر طبق سیم %~% یا ساغر سیماب پر از زر و عقارست(@)(@@) 14 نی‌نی ید بیضای کلیمست به سفتش %~% از پاره زربفت یهودا نه غیارست(@)(@@) 15 بط بچه ی پیلست به خون برزده خرطوم %~% یا شاخ بقم رسته ز پیشانی مارست(@)(@@) 16 زان غنچه عزیزست که زر دارد در جیب %~% وین تجربتست آنکه نه زر دارد و خوارست(@)(@@) 17 ای ترک بیاتات ببوسم که به نوروز %~% فکر دل عاشق همه بوسیدن یارست(@)(@@) 18 برخیز و بده باده نه ایام‌ گریزست %~% بنشین و بده بوسه نه هنگام فرار است(@)(@@) 19 می ده ‌که بنوشیم و بجوشیم و بکوشیم %~% کانجا که بت ساده بط باده بکارست(@)(@@) 20 ما نامی گلرنگ و بت شنگ 
ms168	 و دف و چنگ %~% ارکان بهار است از این‌روی چهارست(@)(@@) 21 زین چار مگر چاره نماییم غمان را %~% کاندل رهد از غم‌ که بدین چار دوچارست(@)(@@) 22 پار از تو دلم داشت به یک بوسه قناعت %~% و ‌امسال نه قانع به هزار و دو هزارست(@)(@@) 23 از غایت لطف ار دهیم بوسه بمشمار %~% کان غایت لطفست ‌که بیرون ز شمارست(@)(@@) 24 و‌ر منع ‌کنندت‌ که مده بوسه برآشوب %~% کاین سنت عیدست و در اسلام شعارست(@)(@@) 25 گر سنت پارینه بجز بوسه نبد هیچ %~% امسال همه قاعده بوس‌ و کنارست(@)(@@) 26 هرچندکه بدعت بود این ه‌اعده لیکن %~% این بدعت امسال به از سنت پارست(@)(@@) 27 ای ماه‌ که با روی تو برقع‌ نگشاید %~% هر ماه مبرقع که بنوشاد و حصارست(@)(@@) 28 زلفین تو تا دوش همه تاب و شکنجست %~% چشم تو تاگوش‌ همه‌خواب و رخمارست(@)(@@) 29 گر باده دهی زود که انده به ‌کمین است %~% ور بوسه دهی زود که عشرت به‌ گذارست(@)(@@) 30 به‌ربی دو سه مستانه مرا بخ‌ثث‌ ب تعجیل %~% کز وصل تو واجب‌ترم ایدون ده سه کارست(@)(@@) 31 یک امشبکی بیش مجال سخنم نیست %~% فردا همه هنگامه عید و صف بارست(@)(@@) 32 مدح ملک ه‌ر تهنیت عید ضرورست %~% کاین هر دو زمان را سبب دفع ضرارست(@)(@@) 33 مشکل که دگر باره مراکام دهد بخت %~% زیرا که جهان را نه به یک حال مدارست(@)(@@) 34 بینی که بهاران سپس فصل خزانست %~% بینی ‌که ‌حزیران عقب ماه ایارست(@)(@@) 35 فردا است که از پشت کشف تیره تر آید %~% این دشت که امروز پر از نقش و نگارست(@)(@@) 36 ‌+ مشت زری دارد نازد به خود ام‌روز %~% فرداست‌ که با دست تهی همچو چنارست(@)(@@) 37 چون دولت خسرو نبود عادت گردون %~% تاگویی جاوید به یک عهد و قرارست(@)(@@) 38 دارای جوان بخت فریدون شه غازی %~% کانجا که رخ اوست همه ساله بهارست(@)(@@) 39 گردون شرف و بحر کف و ابر نوالست %~% لشکر 
ms169	 شکن و پیل‌تن شیر شکارست(@)(@@) 40 چون روی به بزم آرد یک چرخ سهیلست %~% چون‌رای به‌رزم آرد یک‌دشت سوارست(@)(@@) 41 شاها به جهانت همه چیزست مهیا %~% وانچ آن بهقین نیست‌ تر‌ا عیب و عوارست(@)(@@) 42 از خون عدوی تو زمین چشمه لعلست %~% وز گرد سمند تو هوا قلزم قارست(@)(@@) 43 شخص امل از قهر تو در سوز و گدازست %~% جان اجل از عفو تو در بند و ‌فشارست(@)(@@) 44 بر سفره جود تو زمین زائده چین است %~% در موکب جاه تو فلک غاشیه‌دارست(@)(@@) 45 یاللعجب از تیغ تو آن مرگ جهانسوز %~% کت گه به یمین اندرو گاهی به یسارست(@)(@@) 46 هره به یمینست همه جنگ و جدالست %~% هرگه به یسارست همه امن و قرارست(@)(@@) 47 برقیست‌ که تابش همه نابنده جحیمست %~% بحریست که آبش همه سوزنده شرارست(@)(@@) 48 در چشم نکوخواه تو یک طایفه نورست %~% بر جان بداندیش تو یک هاویه نارست(@)(@@) 49 گو لاف بزرگی نزند خصم تو بدروغ %~% کایدر مثل او مثل عجل و خوارست(@)(@@) 50 آنجاکه جلال تو فلک خاک‌نشین است %~% آنجا که نوال تو ملک شکر گزارست(@)(@@) 51 گر کلک تو در دست تو آمد گهرافشان %~% ییداست‌ که ‌این خاصیت از قرب جوارست(@)(@@) 52 از در چه‌ گنه دیدی و از زر چه خیانت %~% کان ‌نزد تو بی‌قیمت و این پیش تو خوارست(@)(@@) 53 آن مختفی از چشم تو درصدر جبالست %~% این محتبس از قهر تو در قعر بحارست(@)(@@) 54 از رمح تو چو رمح تو می پیچم بر خویش %~% کاو همچو عدوی‌تو چرا زرد و نزارست(@)(@@) 55 ای شاه ز قاآنیت ار هیچ خبر نیست %~% باری خبرت‌ هست ‌کش‌از مدح دثارست(@)(@@) 56 دارد پی ایثار تو برکف‌ گهری چند %~% وان نیز دریغا که نه در خورد نثارست(@)(@@) 57 آن‌قدر بمانی ‌که خطاب آیدت از چرخ %~% شاها به جنان پوی ‌که نک روز شمارست PageV1P125(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 روز می و وقت عیش وگاه سرورست %~% یار جوان 
ms170	 می ‌کهن خدای غفورست(@)(@@) 2 میل و سکون شوق و صبر ذوق و تحمل %~% شعله‌و خس‌برق و دشت‌سنگ و بلورست(@)(@@) 3 بادیه پر سنگ و وقت تنگ و قدم لنگ %~% توشه‌کم و ره دراز و مرحله دورست(@)(@@) 4 یار غیورست و حسن سرکش و من مست %~% شوق فزون صبر کم شراب طهورست(@)(@@) 5 بادیه بی‌آب و چشمه دور و هواگرم %~% رخ تر و لب خشک و آفتاب حرورست(@)(@@) 6 زهد گنه می ثواب هجر قیامت %~% وصل جنان یار حور بزم قصورست(@)(@@) 7 طاقت و دل زهد و مست واعظ و رندی %~% قوت و شل پند و کر بصبرت و کورست(@)(@@) 8 جعد و بناگوش زلف و رخ خط و رویت %~% هاله و مه ابر و مهر سایه و نورست(@)(@@) 9 خشم و رضا کین و مهر هجر و وصالت %~% خارو رطب نیش و نوش سوک و سرورست(@)(@@) 10 گریه مطر اشک قطره دیده سحابست %~% عشق شرر شوق شعله سینه تنورست(@)(@@) 11 بار عدو چرخ ضد زمانه مخالف %~% نفس رضا دل حلیم طبع صبورست(@)(@@) 12 شاه جهان جم دهر میر زمان‌کش %~% مهر عنان مه رکاب چرخ ستورست(@)(@@) 13 داد به جا دادخواه زنده عدو طی %~% ملک مصون شرع شاد شاه غیورست(@)(@@) 14 دانش‌ن و دل جود و طبع جودت و فکرش %~% نکهت و گل بوی و مشک تابش و هورست(@)(@@) 15 نام حسن فکر بکر ذات‌ کریمش %~% اصل طرب بحر عیش کان حبورست(@)(@@) 16 باغ و رخش مهر و رایتش مه و رویش %~% دیو و ملک نار و نور زنگی و حورست(@)(@@) 17 خصمش بسته‌کفش‌گشاده دلش شاد %~% تا خور و مه روز شب سنین و شهورست PageV1P126(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ترک من آفت چینست و بلای ختن است %~% فتنه پیر و جوان حادثه مرد و زن است(@)(@@) 2 در بهر زلفش یک کابل وجدست و سماع %~% در بهر چشمش یک بابل سحرست و فن است(@)(@@) 3 دوش تا صبح به هر کوچه 
ms171	 منادی ‌کردم %~% زان سر زلف‌ که هم دلبر و هم دل شکن است(@)(@@) 4 کایها القوم بدانید که آن زلف سیاه %~% چو‌ن غرابیست‌ که هم رهبر و هم راهزن است(@)(@@) 5 ذره را نیست به خورشید فلک راه و بتم %~% ذره را بسته به خورشیدکه اینم دهن است(@)(@@) 6 خنجر آهخته ز بادام‌که اینم مژه است %~% گوهر افشانده ز یاقوت‌که اینم سخن است(@)(@@) 7 قرص خورشیدکه معروف بود در همه شهر %~% بسته ‌بر سرو و به‌جد گو‌ید کاین روی من است(@)(@@) 8 قد خود داند و چون بینم نخل رطبست %~% روی خود داند و چون بینم برگ سمنست(@)(@@) 9 گه مراگوید ها طره و رخسارم بین %~% چون نکو یینم آن سنبل و ابا نسترنست(@)(@@) 10 نارون را قدخود خواند ومن خنداخند %~% گویم ای شوخ بمفریبم‌ کاین نارونست(@)(@@) 11 یاسمن را رخ خود داند و من نرمانرم %~% گویم ای‌گل مدهم عشوه ‌که این یاسمن است(@)(@@) 12 آن نه‌گیسوست معلق به زنخدان او را %~% که به ‌سیمین چهی آویخته‌مشکین رسن است(@)(@@) 13 ساخته از مه نخشب چه نخشب آونگ %~% طرفه‌تر اینکه به جد گوید کاینم ذقن است(@)(@@) 14 شمع رویش همه نورست همانا خرد است %~% چین زلفش همه مشکست همانا ختن است(@)(@@) 15 طره او دل ما برده ازان پرگر هست %~% زلف او بر رخ ما سوده ازان پر شکن است(@)(@@) 16 تاکند آتش رویش جگر خلق ‌کباب %~% لب لعلش نمکست و مژه‌اش بابزن است(@)(@@) 17 تا نگردد همی آن آتش رخساره خموش %~% زلفش آن آتش افروخته را بادزن است(@)(@@) 18 روی او آینه رنگست همانا حلبست %~% خط او غالیه بویست همانا چمنست(@)(@@) 19 نور اگر نیست چرا تازه به رویش بصرست %~% روح ا‌گر نیست چرا زنده به‌ عشق بدن است(@)(@@) 20 شوق چهرش نبود عقل و چو عقلم به سرست %~% یاد مهرش نبود روح و چو روحم به تن است(@)(@@) 21 عاشقش را به مثل حالت شمعست ازانک %~% هر نفس شمع 
ms172	 صفت زنده به گردن زدن است(@)(@@) 22 روی رخشان وی اندر کنف زلف سیاه %~% صنمی هست‌که اندر بغل برهمن است(@)(@@) 23 دوش آمد به وثاق من و ننشسته بخاست %~% مرغ‌گفتی ز هوا بر سر سایه فکن‌است(@)(@@) 24 گفتم اهلالک سهلا بنشین رخت مبر %~% گفت تبآ لک خاموش چه‌جای سخن است(@)(@@) 25 هان بمازار دلم راکه نه شرط ادبست %~% هین بماشوب غمم را که نه رسم فطن است(@)(@@) 26 رو ز نخ ‌کم زن و دم درکش و بیهوده ملای %~% که‌مرا جان و دل از غصه شجن در شجن است(@)(@@) 27 خیز و زان باده دیرینه‌گرت هست بیار %~% ورنه زینجا ببرم رخت که بیت‌الحزن است(@)(@@) 28 تنگ ظرفست قدح خیز و به پیمای دنم %~% زانکه صاحب دلی امروز اگر هست دن است(@)(@@) 29 باده آوردم و هی دادم و هی بستد و خورد %~% هی‌همی ‌گفت ‌که می‌ داروی رنج ومحن است(@)(@@) 30 مست ‌چون ‌گشت به‌رخ خون‌جگر ریخت چنانک %~% رخش از خون جگر گفتی‌ کان یمن است(@)(@@) 31 چهرش از اشک چنان شد که مثل را گفتم %~% قرص خورشید فلک مطلع عقد پرن است(@)(@@) 32 گفتم آخر غمت از کیست میندیش و بگو %~% گفت آهسته به ‌گو‌شم که ز صدر ز من است(@)(@@) 33 حاجی اکبر فلک دانش و فر کاهل هنر %~% هر روایت‌که نمایند ز خلقش حسن است(@)(@@) 34 آنکه بر لب نگذشته ز سخا لاولنش %~% در کلام تواش ایدون سخن از لا و لن است(@)(@@) 35 طنز در شعر تو می‌راند و خود می‌داند %~% که سخن‌های تو پیرایه در عدن است(@)(@@) 36 حق‌گواهست‌که‌گفتار تو درگوش خرد %~% گوهری هست که ملک دو جهانش ثمن است(@)(@@) 37 جای آنست‌که بر شعر تو تحسین راند %~% طفل یک روزه کش آلوده لبان از لبن است(@)(@@) 38 وصف زلفم چو کنی ساز جدل ساز کند %~% گویی از زلف منش در دل کین کهن است(@)(@@) 39 کژدم زلف منش بس‌که‌گزیدست جگر %~% عجبی‌نیست‌ گر ازمدحت آن‌ممتحن 
