ms230	 چه غم ار فرش من حصیر آمد(@)(@@) 55 ولیک با همه دانش خجالت از تو برم %~% چو قطره‌یی که بر لجه قعیر آمد(@)(@@) 56 همی بمان که شود روشن از تو شام ابد %~% چنانکه صبح ازل از رخت منیر آمد(@)(@@) 57 به آفتاب شبیهست‌ شعر قاآنی %~% عجب نباشد اگر در جهان شهیر آمد PageV1P153(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هست ‌از دو کعبه ‌امروز دین‌ خدای خرسند %~% کز فر آن دو کعبه است شاخ هدی ‌برومند(@)(@@) 2 آن‌کعبه صدر ملت این‌ کعبه پشت دولت %~% آن را به شرع پیمان این‌ را به عدل پیوند(@)(@@) 3 صید اندر آن حرامست در ملت پیمبر %~% می اندر این حلالست در مذهب خردمند(@)(@@) 4 از فر آن عرب را ساید به چرخ اکلیل %~% از قرب این عجم را نازد به عرش آوند(@)(@@) 5 این قبله ملوکست آن قبله ملایک %~% آن خانه خدایست این خانه خداوند(@)(@@) 6 عباس شاه غازی کز یاری جهاندار %~% صیت جهانگشایی در هفت‌کشور افکند(@)(@@) 7 کوهیست بحر پرداز بحریست‌ کوه پیکر %~% مهریست ابر همت ابریست مهر مانند(@)(@@) 8 با حلم او سه گوی است ‌ثهلان و طور و جودی %~% با جود اوسه‌جوی‌اس‌عمان‌و نیل‌و اروند(@)(@@) 9 با جود بیکرانش چاهیست بحر قلزم %~% با حلم بی ‌قیاسش‌ کاهیست‌ کوه الوند(@)(@@) 10 خنگش چو در تکاد و غوغا و ملک ختلان %~% عزمش چو در روارو آشوب و مرز میمند(@)(@@) 11 جیشش‌ به گاه ‌پیکار خنجر گذار و خونخوار %~% هریک به وقعه الوا هریک به حمله الوند(@)(@@) 12 از قهرکینه‌توزش ولوال در بخارا %~% از رمح فتنه‌سوزش زلزال در سمرقند(@)(@@) 13 با دست گوهرافشان چون پا نهد به یکران %~% بینی سحاب نیسان بر قله دماوند(@)(@@) 14 بر دیرپای‌گیتی‌کاخش‌کند تحکم %~% برگرد گرد گردون خنگش‌‌ زند شکر‌خند(@)(@@) 15 پیر خرد ندیده چون او بهینه استاد %~% مام جهان ندیده چون او مهینه فرزند(@)(@@) 16 سامان هفت کشور عدلش‌ به امن آراست %~% دامان چار مادر جودش به‌ گوهر آکند(@)(@@) 17 ثهلان به پیش 
ms231	 حملش خجلت برد ز خردل %~% عمان به نزد جودش شنعت برد ز فرکند(@)(@@) 18 د‌رکاخ شوکت او گیهان بهنیه چاکر %~% بر خوان نعمت اوگردون‌کمینه آوند(@)(@@) 19 کنزی ز بخش اوست دریا و ‌گنج و معدن %~% رمزی ز دانش اوس استا و زند و پازند(@)(@@) 20 در مرغزار عالیش هرجاکه خار ظلمی %~% با تیشه عدالت عزمش ز ریشه برکند(@)(@@) 21 د‌ی در سرخ دیدی از حمله سپاهش %~% یک‌شهر بنده آزاد یک ملک خواجه دربند(@)(@@) 22 یک جیش را غنیمت از مرو تا به سقلاب %~% یک فوج را هزیمت از طوس‌ تا به دربند(@)(@@) 23 فردا بود که بینی اندر دیار خوارزم %~% فوجی اسیر شادان جوقی امیر دربند(@)(@@) 24 آخر مگر نه سنجر بهر هلاک اتسز %~% شدکینه‌جو به‌خوارزم‌در سال سیصد و اند(@)(@@) 25 از بهرکشور وگنج خود را فکند در رنج %~% تاگنج و مال آورد بر سرکشان پراکند(@)(@@) 26 خسرو نه کم ز سنجر از زور و هور و لشکر %~% خصمش نه بر ز اتسز از زر و زور و پیوند(@)(@@) 27 فرداست ‌کز خراسان لشکر کشد به توران %~% با دست‌ گوهرافشان با تیغ‌ گوهر کند(@)(@@) 28 از بسکه کشته پشته حیران شود محاسب %~% از بسکه خسته بسته نادان شود خردمند(@)(@@) 29 خوارزمشه‌گریزان از دیده اشک‌ریزان %~% بر رخ ز مویه صد چین بر دل ز نال صد بند(@)(@@) 30 توران خراب‌ گشته جیحون سراب ‌گشته %~% میمند و مرو ویران‌ گرگانج و کات فرکند(@)(@@) 31 تا باغ و راغ‌گردد در موسم بهاران %~% از ژاله‌کان الماس از لاله‌کوه یاکند(@)(@@) 32 در رزم و بزم بادا آثار مهر و قهرش %~% در جام دشمنان زهر درکام دوستان قند PageV1P154(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ازین‌سان کابر نیسانی دمادم گوهر افشاند %~% اگر ترک ادب نبود به دست خواجه می‌ماند(@)(@@) 2 درختان را چه شد کامروز می‌رقصند از شادی %~% مگر بر شاخ‌گل بلبل مدیح خواجه می‌خواند(@)(@@) 3 جناب حاجی‌ آقاسی که‌ریزد طرح‌صد گردون %~% اگر شخص جلالش گردی از دامن برافشاند(@)(@@) 4 
ms232	 اگر باد عتاب او زند یک لطمه بر هستی %~% چه جای هفت‌گردون کافرینش‌ را بجنباند(@)(@@) 5 وگر برق خلاف اوکشد یک شعله درگیتی %~% چه جای خار صحرا کاب دریا را بسوزاند(@)(@@) 6 خداوندا بدان ذات خداوندی‌ که‌ گر خواهد %~% به قدرت چرخ را در دیده موری بگنجاند(@)(@@) 7 به قهاری‌که قهرش پشه‌یی راگر دهد فرمان %~% به زخم نیش او خرطوم پیلان را بپیچاند(@)(@@) 8 که تا امروز جز مدحت زبانم حرفی ارگفته %~% مر آن را چون زبان لاله ایزد لال‌ گرداند(@)(@@) 9 بلای بد بود حاسد به جان هر که در عالم %~% دعاکن‌کاین بلا را ایزد از عالم بگرداند(@)(@@) 10 حریف‌خویش چون‌پرمایه بیند خصم بی‌مایه %~% به بهتانی ازو طبع بزرگان را برنجاند(@)(@@) 11 چوصبح‌ار صادقم ‌در این‌سخن ‌روزم‌ بود روشن %~% وگر چون گل دورویم باد غم برگم بریزاند(@)(@@) 12 کسان‌ گویند ببریدست مرسوم مرا خواجه %~% بهزدان‌کاین‌سخن‌راگوش من افسانه می‌داند(@)(@@) 13 برین دعوی دلیلی ‌گویمت از روز روشنتر %~% تو خورشیدی و قطع فیض‌ خود خورشید نتواند(@)(@@) 14 چو مرسم مرا ز اول تو خود دادی یقین دارم %~% که شخصیت با همه ‌حکمت چنین حکمی نمی‌راند(@)(@@) 15 خدا تاندگرفتن آنچه بخشد از ازل لیکن %~% نگیرد آنچه داد اول نمی‌گویم نمی‌تاند(@)(@@) 16 خدا تاند که رنگ از لاله ‌گیرد بوی از عنبر %~% ولی از فرط رحمت داده خود بازنستاند(@)(@@) 17 چو بر حکم‌ مجدد می‌رود تعلیق این مطلب %~% مگر تعلیقه نو جان من زین بند برهاند(@)(@@) 18 چه باشد ابرکلکت‌گر همی‌گرید به حال من %~% وزان یک گریه‌ام تا حشر همچون گل بخنداند(@)(@@) 19 ز فیض تست اینهم‌کز طریق عجز می‌نالم %~% که یزدان هم ز بهر شیر کودک را بگریاند(@)(@@) 20 کدامین‌یک بود زیبنده از جود تو می‌پرسم %~% که بر چرخم رساند یا به خاک تیره بنشاند(@)(@@) 21 خدا هرچند قهارست لیکن از پی روزی %~% عنان فیض خود از مومن و کافر نتاباند(@)(@@) 22 تو مهری مهر نور خود به نیک و بد بیندازد 
ms233	 %~% تو ابری ابر فیض‌ خو‌د بخار و گل بباراند(@)(@@) 23 ازان بخت ترا بیدار دارد سال و مه یزدان %~% که خلق خویش را در مهد آسایش بخواباند(@)(@@) 24 روا نبود که مداح تو با این منطق شیرین %~% نیارد چون مگس لختی ز سختی سر بخاراند(@)(@@) 25 الا تا سال و مه آید الا تا عمر فرساید %~% بپایی تا فلک پاید بمانی تا جهان ماند PageV1P155(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 سرین دلبر من سیم ناب را ماند %~% ز بسکه نرم و لطیفست آب را ماند(@)(@@) 2 هنوز نامده در چشم من روز از هوش %~% به‌خاصیت همه گویی‌که خواب را ماند(@)(@@) 3 درست نقطه سرخی که در میان ویست %~% به جام سیمین‌گلگون شراب را ماند(@)(@@) 4 کنار او همه رخشان میان او همه چین %~% بدن‌‌دو وصف‌یکی‌شیخ‌ و شاب را ماند(@)(@@) 5 به ماه ماند و در وی نشان بوسه من %~% گمان بری‌کلف ماهتاب را ماند(@)(@@) 6 شعاع او همه چشم مرا کند خیره %~% اگر غلط نکنم آفتاب را ماند(@)(@@) 7 به روی یکدیگر افتد از دو سو گویی %~% که جمله دفتر اهل حساب را ماند(@)(@@) 8 چو در ازار قصب یار سازدش پنهان %~% سهیل رفته به زیر سحاب را ماند(@)(@@) 9 به روی او ز قفا طره نگارینم %~% غلاله‌های خطا بر ثواب را ماند(@)(@@) 10 فراز تحسین یا نی نویشته نفرین %~% به روی غفران یا نی عذاب را ماند(@)(@@) 11 و یا به خر‌من نسرین ز بر به شکل‌ کمند %~% همی نگون شده شاخه سداب را ماند(@)(@@) 12 و یا به قرص قمر برهمی به هیات مار %~% به خویش حلقه زده مشک ناب را ماند(@)(@@) 13 و یا به خیمه سیماب ‌رنگ سیمین‌ لون %~% همی ز عنبر سارا طناب را ماند(@)(@@) 14 و یا به پر حواصل ‌که برزده خرمن %~% پراکنیده پر غراب را ماند(@)(@@) 15 و یا به برزو برو کتف پور کیکاووس %~% کمند پر خم افراسیاب را ماند(@)(@@) 16 و یا به 
ms234	 پهلوی بدخواه شه فراز رکاب %~% دوال خسرو مالک رقاب را ماند(@)(@@) 17 خدیو راد محمدشه آفتاب ملوک %~% که برق او به وغا التهاب را ماند(@)(@@) 18 بسان شیر دژ آگه بود پیاده شاه %~% به‌روز جنگ و عدویش‌کلاب را ماند(@)(@@) 19 به هرکجاکه فرازد خیام دولت و فر %~% بلندگردون بر آن قباب را ماند(@)(@@) 20 سپهر توسن‌گویی بودکمیت ملک %~% که ماه یکشبه به روی رکاب را ماند(@)(@@) 21 نهیب تیغ‌ملک چیست بوم و جان عدو %~% که جای ا و بر و بوم خراب را ماند(@)(@@) 22 بلارکش بود الماس رنگ و آتش فعل %~% ولی به واقعه لعل مذاب را ماند(@)(@@) 23 به شیر ماند در خوردن و فش‌اندن خون %~% چنانکه دشمن خسرو دواب را ماند(@)(@@) 24 ز بسکه‌شادی‌خیزبت‌عهد دولت شاه %~% همی معاینه عهد شباب را ماند(@)(@@) 25 ثنا و منقبت من به چهر دولت شه %~% بر آفتاب درخشان نقاب را ماند(@)(@@) 26 دوام دولت او تا گهی‌که حاجب او %~% بگوید ایدون یوم‌الحساب را ماند PageV1P156(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 غم و شادیست‌که با یکدگر آمیخته‌اند %~% یا مه روزه به نوروز درآمیخته‌اند(@)(@@) 2 درکفی رشته تسبیح و کفی ساغر می %~% راست با عقد ثریا قمر آمیخته‌اند(@)(@@) 3 تردماغ از می شب خشک‌لب از روزه روز %~% ورع خشک به دامان تر آمیخته‌اند(@)(@@) 4 در کف شیخ‌ عصا در کف میخواره قدح %~% اژدها با ید بیضا اثر آمیخته‌اند(@)(@@) 5 همه را چهره چو صندل شده از ره‌زه ولی %~% صندلی هست‌ که با دردسر آمیخته‌اند(@)(@@) 6 مطرب و ناله نی واعظ و آوازه وعظ %~% لحن داود به صوت بقر آمیخته‌اند(@)(@@) 7 تا چرا روزه به نوره,ز درآمیخته است %~% خلق با وی ز سرکینه درآمیخته‌اند(@)(@@) 8 همه با روزه بجنگند و علاجش نکنند %~% روبهانندکه با شیر ن‌ر آمیخته‌اند(@)(@@) 9 باز نوروز شود چیره هم آخرکه‌کنون %~% نیمی از خلق بدو بیخبر آمیخته‌اند(@)(@@) 10 رو‌رزه‌کس را ندهد چیز و کند منع ز خور %~% ابله آنان‌که بدو بی‌ثمر آمیخته‌اند(@)(@@) 11 گرچه 
ms235	 بر روزه به شورند هم آخر که سپاه %~% با ملوک از پی تحصیل خور آمیخته‌اند(@)(@@) 12 خوان نوروز پر از نعمت الوان با او %~% زین سبب مردم صاحب هن‌ر آمیخته‌اند(@)(@@) 13 منع می هم ند زانرو با اه سپهی %~% همچو رندان جهان معتبر آمیخته‌اند(@)(@@) 14 زاهدان را اگر از سبحه‌کرامت اینست %~% که یکی رشته به صد عقده‌ بر آمیخته‌اند(@)(@@) 15 ساقیان ‌راست ازین معجزه‌ کز ساغر می %~% آب و آتش را با یکدگر آمیخته‌اند(@)(@@) 16 کرده در جام بلورین می چون لعل روان %~% نی نی الماس به یاقوت تر آمیخته‌اند(@)(@@) 17 آتش طور عجین با ید بیضاکردند %~% نار نمرود به آب خضر آمیخته‌اند(@)(@@) 18 باده درکام فروریخته از زرین جام %~% خاو‌ران ‌گو‌یی با باختر آمیخته‌اند(@)(@@) 19 سرخ مرجان تر آمیخته با لؤلؤ خشک %~% تا به ساغر می مرجان گهر آمیخته‌اند(@)(@@) 20 رنگ و بو داده به‌می لاله‌رخان از لب و زلف %~% یا شفق را به نسیم سحر آمیخته‌اند(@)(@@) 21 کرده در جام هلالی می خورشید مثال %~% یا هلالیست‌که با قرص خور آمیخته‌اند(@)(@@) 22 قطره‌یی آب بهم بسته ‌که هیچش‌ نم نیست %~% با روان آتش نمناک درآمیخته اند(@)(@@) 23 آب بی‌نم نگر و آتش پر نم‌ که به طبع %~% هر نمش را به هزاران شرر آمیخته‌اند(@)(@@) 24 اشک می پاک‌کند خون جگر را گرچه %~% رنگ آن اشک به ‌خون جگر آمیخته‌اند(@)(@@) 25 نی خبر می‌دهد از عشق و خبردار مباد %~% گوش و هوشی که نه با آن خبر آمیخته‌اند(@)(@@) 26 شکل ماریست‌ که باده دهش نیست زبان %~% طبع زهرش به مزاج شکر آمیخته‌اند(@)(@@) 27 چنگ در چنگ خوش‌آهنگی کز آهنگش %~% هوش شنوایی با گوش کر آمیخته‌اند(@)(@@) 28 شاهدان بسته کمر کوه‌کشی را به میان %~% زان سرینهاکه به موی‌کمر آمیخته‌اند(@)(@@) 29 هنت سین کز پی تحویل گذارند به خوان %~% گلرخان رنگی از آن تازه‌تر آمیخته‌اند(@)(@@) 30 ساعد و سینه و سیما و سر و ساق و سرین %~% هفت سین‌آسا با سیم بر 
