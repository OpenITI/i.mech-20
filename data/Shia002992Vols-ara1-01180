ms1176	 123)، والتهذيب: ج 9، ح 1259 (الاستبصار: ج 4، ح 123).(@)(@@) * وروى هو أو عبيد بن زرارة، وروى عنه مروان بن مسلم.(@)(@@) الكافي: ج 7، ك 3، ب 45، ح 7. والفقيه:(@)(@@) ج 4، ح 90. والتهذيب: ج 10، ح 86.(@)(@@) بشير * روى عن أبي عبد الله عليه السلام وروى عنه سويد القلا.(@)(@@) التهذيب: ج 6، ح 226.(@)(@@) وروى عنه سويد القلانسي.(@)(@@) الكافي: ج 5، ك 1، ب 7، ح 2. كذا في هذه الطبعة، وفي الطبعة القديمة سويد القلا كما في التهذيب هو الصحيح.(@)(@@) وروى عنه يحيى ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 116، ح 13.(@)(@@) * وروى عن أبي الحسن عليه السلام، وروى عنه رشيد.(@)(@@) الكافي: ج 6، ك 8، ب 64، ح 4.(@)(@@) * وروى عن أبي حمزة، وروى عنه يحيى بن عمران الحلبي.(@)(@@) الكافي: ج 2، ك 1، ب 77، ح 9.(@)(@@) * وروى عن أبي مريم الأنصاري، وروى عنه أبو القاسم عبد الرحمن بن حماد الكوفي.(@)(@@) التهذيب: ج 1، ح 1313 (الاستبصار: PageV04P415(@)(@@) ج 1، ح 119).(@)(@@) * وروى عن ابن أبي يعفور، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 5، ك 2، ب 30، ح 7.(@)(@@) والتهذيب: ج 6، ح 919.(@)(@@) * وروى عن حريز، وروى عنه محمد ابن عيسى.(@)(@@) التهذيب: ج 7، ح 1008.(@)(@@) وروى عن بعض الكتب، وروى عنه علي بن إسماعيل الميثمي.(@)(@@) الفقيه: ج 4، ح 17.(@)(@@) بشير الدهان * روى عن أبي عبد الله عليه السلام، وروى عنه أبو إسحاق الكندي.(@)(@@) الكافي: ج 1، ك 2، ب 2، ح 6.(@)(@@) وروى الحسن بن عبد الرحمان.(@)(@@) الرواسي عمن حدثه عنه.(@)(@@) التهذيب: ج 6، ح 124.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 3، ك 3، ب 87، ح 2.(@)(@@) وروى عنه سويد القلانسي.(@)(@@) الكافي: ج 5، ك 1، ب 6، ح 3. وفي الطبعة القديمة سويد القلا، وهو الصحيح.(@)(@@) وروى عنه صالح بن عقبة.(@)(@@) الكافي: ج 4، ك 3، ب 233، ح 1، و ج 6، ك 8، ب 56، ح 7، والفقيه: ج 2، ح 1586. والتهذيب: ج 6، ح 101 و 115.(@)(@@) وروى عنه غالب بن عثمان.(@)(@@) الكافي: ج 2، ك 2، ب 21، ح 12، و ج 3، ك 3، ب 3، ح 3، وب 88، ح 7، وب 89، ح 2.(@)(@@) وروى عنه يحيى بن معمر العطار.(@)(@@) الكافي: ج 1، ك 4، ب 66، ح 4.(@)(@@) * وروى عن جعفر بن محمد عليهما السلام، وروى عنه صالح بن عقبة.(@)(@@) التهذيب: ج 6، ح 107.(@)(@@) * وروى عن أبي الحسن موسى عليه السلام، 
ms1177	 وروى ابن فضال عمن ذكره عنه.(@)(@@) الكافي: ج 5، ك 2، ب 9، ح 2.(@)(@@) وروى عن رفاعة النخاس، وروى عنه إبراهيم بن محمد الطحان.(@)(@@) التهذيب: ج 6، ح 125.(@)(@@) * وروى عن كامل التمار، وروى عنه منصور بن يونس. الكافي: ج 1، ك 4، ب 95، ح 5. PageV04P416(@)(@@) بشير النبال * روى عن أبي جعفر عليه السلام، وروى عنه عثمان بن عفان السدوسي.(@)(@@) الكافي: ج 6، ك 8، ب 43، ح 22.(@)(@@) * وروى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 2، ح 350 و 1319.(@)(@@) وروى عنه أبان.(@)(@@) الكافي: ج 6، ك 3، ب 5، ح 4.(@)(@@) وروى عنه أبان بن عثمان.(@)(@@) الروضة: ح 540.(@)(@@) وروى عنه داود بن فرقد.(@)(@@) الكافي: ج 3، ك 4، ب 78، ح 3.(@)(@@) والتهذيب: ج 3، ح 349 (الاستبصار:(@)(@@) ج 1، ح 855)، و 563 (الاستبصار:(@)(@@) ج 1، ح 855).(@)(@@) وروى عنه علي بن شجرة.(@)(@@) الكافي: ج 4، ك 2، ب 9، ح 5، و ج 5، ك 2، ب 68، ح 3. والتهذيب: ج 4، ح 504 (الاستبصار: ج 2، ح 236)، والتهذيب: ج 7، ح 60.(@)(@@) وروى عنه يزيد النخعي.(@)(@@) الكافي: ج 5، ك 3، ب 188، ح 3.(@)(@@) * وروى عن حمران بن أعين، وروى عنه سيف بن عميرة.(@)(@@) الروضة: ح 490.(@)(@@) بكر بن حبيب * روى عن أبي جعفر عليه السلام، وروى عنه منصور.(@)(@@) الكافي: ج 3، ك 4، ب 30، ذيل ح 1.(@)(@@) وروى عنه منصور بن حازم.(@)(@@) الكافي: ج 3، ك 1، ب 10، ح 2، وك 4، ب 30، ح 1. والتهذيب: ج 1، ح 1168، و ج 2، ح 378 (الاستبصار: ج 1، ح 1288)، و 381 و ج 7، ح 842.(@)(@@) * وروى عن أبي عبد الله عليه السلام، وروى عنه منصور.(@)(@@) التهذيب: ج 7، ح 967 (الاستبصار:(@)(@@) ج 3، ح 481.(@)(@@) وروى عنه منصور بن حازم.(@)(@@) التهذيب: ج 7، ح 966.(@)(@@) بكر بن صالح * روى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 1، ب 1، ح 7. PageV04P417(@)(@@) * وروى عن أبي الحسن الأول، عليه السلام، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الروضة: ح 221.(@)(@@) * وروى عن أبي جعفر (الثاني) عليه السلام، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 3، ب 90، ح 12.(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) التهذيب: ج 5، ح 1433 (الاستبصار:(@)(@@) ج 2، ح 1137).(@)(@@) * وروى عن أبي جعفر الثاني عليه السلام، وروى عنه الحسين بن 
ms1178	 سعيد.(@)(@@) التهذيب: ج 5، ح 1068 (الاستبصار:(@)(@@) ج 2، ح 616).(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) الفقيه: ج 2، ح 1061.(@)(@@) * وروى عن ابن أبي عمير، وروى عنه عبد الله.(@)(@@) التهذيب: ج 6، ح 807.(@)(@@) وروى عنه عبد الله بن أحمد الرازي.(@)(@@) التهذيب: ج 6، ح 806.(@)(@@) * وروى عن ابن سنان، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 186.(@)(@@) * وروى عن ابن فضال، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 6، ب 43، ح 10.(@)(@@) * وروى عن الأشعث بن محمد البارقي، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 9، ب 7، ح 15.(@)(@@) * وروى عن بندار بن محمد الطبري، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 4، ك 1، ب 15، ح 2.(@)(@@) * وروى عن جعفر بن محمد الهاشمي، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 29، ح 3.(@)(@@) * وروى عن الحسن بن سعيد، وروى عنه الحسين بن الحسن.(@)(@@) الكافي: ج 1، ك 3، ب 10، ح 3، وب 11، ح 6، وب 23، ح 5.(@)(@@) * وروى عن الحسن بن علي، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 3، ك 5، ب 43، ح 3.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 52، ح 7، وب 87، ح 2، وب 88، ح 5.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 49، ح 12، وب 82، ح 4. PageV04P418(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 34.(@)(@@) وروى عن الحسن بن محمد بن عمران، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 245 (الاستبصار:(@)(@@) ج 1، ح 185).(@)(@@) * وروى عن الحسين بن سعيد، وروى عنه الحسين بن الحسن.(@)(@@) الكافي: ج 1، ك 3، ب 2، ح 2، كذا في هذه النسخة، وفي بعض النسخ الحسن بن سعيد، والظاهر أن هذا هو الصحيح.(@)(@@) * وروى عن الريان بن شبيب، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 7، ح 10.(@)(@@) * وروى عن سليمان بن جعفر.(@)(@@) الفقيه: ج 2، ح 807.(@)(@@) * وروى عن سليمان بن جعفر الجعفري.(@)(@@) الفقيه: ج 2، ح 836 و 837 و 838 و 839.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1748.(@)(@@) وروى عن أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 141، ح 2.(@)(@@) والتهذيب: ج 7، ح 1643.(@)(@@) وروى عنه سهل بن 
ms1179	 زياد.(@)(@@) الروضة: ح 232.(@)(@@) * وروى عن سليمان الجعفري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 1، ب 10، ح 8، وك 6، ب 2، ح 16، وك 9، ب 1، ح 3.(@)(@@) والتهذيب: ج 9، ح 70 و 203 (الاستبصار: ج 4، ح 290).(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 6، ب 2، ح 9. والروضة:(@)(@@) ح 493.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 9، ب 1، ح 3.(@)(@@) * وروى عن عبد الرحمان بن سالم، وروى عنه صالح بن أبي حماد.(@)(@@) الكافي: ج 1، ك 4، ب 126، ح 3.(@)(@@) * وروى عن عبد الله بن إبراهيم الجعفري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 107، ح 2.(@)(@@) * وروى عن عبد الله بن إبراهيم الغفاري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 45، ح 4.(@)(@@) * وروى عن علي بن أسباط، وروى عنه الحسين بن الحسن. PageV04P419(@)(@@) الكافي: ج 1، ك 3، ب 14، ح 2.(@)(@@) * وروى عن علي بن صالح، وروى محمد بن إسماعيل، عن بعض أصحابه، عنه.(@)(@@) الكافي: ج 1، ك 3، ب 15، ح 4.(@)(@@) * وروى عن عيسى بن عبد الله بن محمد بن عمر بن علي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 7، ب 1، ح 1.(@)(@@) * وروى عن القاسم بن بريد، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 1، ب 18، ح 1، وب 19، ح 1، و ج 5، ك 1، ب 4، ح 1. والتهذيب:(@)(@@) ج 6، ح 224.(@)(@@) وروى عن القاسم بن يزيد، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 1، ب 166، ح 1. كذا في الطبعة القديمة أيضا علي نسخة، الطبعة الحديثة المعربة وغير المعربة، ونسخة المرآة. ولكن في نسخة أخرى من الطبعة القديمة، ونسخة الوافي القاسم بن بريد، وهو الصحيح بقرينة سائر الروايات المتقدمة عليها.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 9، ب 10، ح 2، وب 11، ح 2.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 9، ب 7، ح 14.(@)(@@) * وروى عن محمد بن سليمان، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 60، ح 3.(@)(@@) * وروى عن محمد بن سليمان الديلمي، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 4، ب 67، ح 1.(@)(@@) * وروى عن 
ms1180	 محمد بن سنان. وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 34، ح 2، و ج 2، ك 1، ب 155، ح 3، و ج 4، ك 2، ب 1، ح 17، و ج 7، ك 3، ب 21، ح 4.(@)(@@) والروضة: ح 198. والتهذيب: ج 10، ح 192 (الاستبصار: ج 4، ح 818)، و 197 (الاستبصار: ج 4، ح 828).(@)(@@) * وروى عن محمد الشيباني، وروى عنه سهل بن زياد.(@)(@@) التهذيب: ج 9، ح 456.(@)(@@) * وروى عن الجعفري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 76، ح 5، وب 102، ح 2. PageV04P420(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 87، ح 1.(@)(@@) والتهذيب: ج 9، ح 437.(@)(@@) * وروى عن الشيباني، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 7، ب 15، ح 16.(@)(@@) * وروى عن الغفاري، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 56، ح 19.(@)(@@) * وروى عن بعض أصحابه، عن أبي الحسن عليه السلام، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 5، ك 3، ب 16، ح 7.(@)(@@) * وروى مرفوعا عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 99، ح 4.(@)(@@) وروى عنه سهل.(@)(@@) الروضة: ح 197.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 577.(@)(@@) * وروى عمن ذكره عن أبي عبد الله عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 1، ب 9، ح 3. والتهذيب:(@)(@@) ج 7، ح 1744.(@)(@@) بكر بن محمد * روى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 1، ح 657 و 1357، و ج 3، ح 286 و 1403. والتهذيب: ج 2، ح 438.(@)(@@) وروى عنه أبو طالب وأبو عبد الله البرقي.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 5.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 2، ب 49، ح 1.(@)(@@) وروى عنه أحمد بن إسحاق.(@)(@@) الكافي: ج 2، ك 1، ب 77، ح 10، وب 170، ح 5، وك 2، ب 49، ح 1، و ج 6، ك 3، ب 16، ح 4، وك 6، ب 53، ح 3. والتهذيب: ج 3، ح 254 و 255.(@)(@@) وروى عنه أحمد بن محمد بن إسحاق.(@)(@@) الكافي: ج 2، ك 1، ب 83، ح 7. كذا في هذه الطبعة والطبعتين الحديثتين المعربة وغيرها، ولكن في الطبعة القديمة ونسختي المرآة والوافي أحمد بن إسحاق، عن بكر بن محمد، وهو الصحيح بقرينة سائر الروايات.(@)(@@) وروى عنه العباس.(@)(@@) التهذيب: ج 2، ح 