ms81	 ای غایب از آن ماه ای دل عذر من مستمند، می خواه ای دل(@)(@@) مبارکشاه غوری(@)(@@) (@@) 807 ای دل، مرو وجام بلا نوش مکن %~% دم می دهد آن نگار، در گوش مکن(@)(@@) (@@) باری، به ضرورت ار بخواهی رفتن %~% در خدمت او، مرا فراموش مکن(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~808 عشق آمد و، ترتیب هنرمندی، شد دیوانگی آمد و خردمندی، شد(@)(@@) (@@) یکچند، خداوند دل وجان بودم %~% چون بندهآ دل شدم خداوندی، شد(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) گفتی که: دلت زعشق خون می [با]شد %~% من خود، نه بر آنم که دلی بود مرا!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 810 ره رفتم و، هیچ منزلی نیست مرا %~% وز حاصل کار، حاصلی نیست مرا(@)(@@) (@@) گویند: زدل هیچ خبر میداری؟ %~% خود محنتش ارنیست، دلی نیست مرا PageV01P214(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0218.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 811 ای از غم تو هزار شادی دل را %~% پیوسته به مهر، یاد بادی دل را(@)(@@) (@@) آخر، به هزار حیله ودلداری %~% بردی دل من، باز ندادی دل رأ(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~812 تا در ره عشق تو، نهادم دل را خاص از پی تعو، باز گشادم دل را(@)(@@) (@@) از باد، مرا بوی تو آمد امروز %~% شکرانهآ آن، به باد دادم دل را(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) ~~81 جویان کسی بوم، که شد با او دل جزبا غم او، نکرد هرگزخودل(@)(@@) (@@) گفتند که: در دلش طلب کن گفتم: %~% اوله %~% گر حال چنین است، پس اکنون کودل؟(@)(@@) (@@) 814 دل بی غم تو، جام طرب نوش نکرد %~% جزیاد تو، باهیچ کسی گوش نکرد(@)(@@) (@@) از لذت خوبی تو آگاه نشد %~% اوله %~% تا مستی خویش را فراموش نکرد(@)(@@) (@@) 815 ای دل، تو بسی گرد بلا می پویی %~% افسانهآ فتنه، برملا می گویی(@)(@@) (@@) عشقی که وبال است، چرا می طلبی؟ %~% وصلی که محال است، چرا می جویی؟(@)(@@)(@@)(@@) | اوله(@)(@@)(@@)(@@) | خوش باش، که خوش بودن دل برجا نیست(@)(@@) (@@) عیبش مکن ارزعقل بگریزد، از آنک %~% جایی است مراد دل، که عقل آنجا نیست!(@)(@@)(@@)(@@) | وله(@)(@@) ~~817 گفتم: صنما باز دلم برجا نیست زلف توببرد یا لبت، پیدا نیست(@)(@@) (@@) نرم از 
ms82	 سرناز گفت در لحظه مرا: %~% ول %~% «دل می طلبی؟ رو، که دلت با ما نیست!»(@)(@@) ~~818 دل، گر غم تو برنگزیند چه کند؟ تنهاست، چوبا غم ننشیند چه کند؟(@)(@@) ~~و مرغ غم است، درد تو چینهآ اوست بیچاره، که درد تونچیند چه کند؟(@)(@@)(@@)(@@) | وله(@)(@@) ~~819 بر عالم حسن تارخت شاهی (؟) یافتمه را به برت جز خجلی نتوان یافت(@)(@@) (@@) گر مست و صیک وگکی بونی %~% جز پیش من، این چنین دلی نتوان یافت!(@)(@)PageV01P215(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0219.jpg)(@)(@)(@@) (@@) 820 آن یار که آشوب دل انجمنی است %~% اوله %~% سروی است، که از کنارم او را چمنی اسر(@)(@@) (@@) می گفت چو در دلش همی کردم جای %~% وله %~% کان جای چنان تنگ، نه جای چومنی اسه(@)(@@) (@@) 821 ای دل، چوبر آن بت چین می باشی %~% بس بیخود و بسیار نشین می باشی(@)(@@) (@@) یار از توملول می شود، با خود باش %~% در خدمت او، چرا چنین می باشی؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 822 تا روی تو را، خط تو بفزود جمال %~% تا خظ تو، خو بتر شد از نقطهآ خال(@)(@@) (@@) جان جست، میان عشق بنشست چوشین %~% وله %~% دل پیش و پس درد، باستاد چودال(@)(@@) (@@) 823 در هر وقتی، که منزلی می یابم %~% از قصهآ خویش، مشکلی می یابم(@)(@@) (@@) دل در ره عشق گم کند مردم و، من %~% در راه تو، هر روز دلی می یابم(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 824 ای دل یاری که ............ نی است %~% بازیچهآ عمر ماش شکر شکنی است(@)(@@) (@@) سودای چنان بتی، چنین نتوان پخت %~% باخو یشتن آی، این چه بی خویشتنی است(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 825 هر روز هزار بار می ساز کنم %~% تا از رخ زیبای تو خو باز کنم(@)(@@) (@@) خونریز بود میان چشم ودل من %~% هرگه که من این حدیث آغاز کنم(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 826 ای عشق تودر درون و بیرون دلم %~% بگرفت غم تو، ربع مسکون دلم(@)(@@) (@@) امروز، دلم حدیث هجران تو کرد %~% در حال، بریخت دیدهام خون دلم(@)(@@) (@@) 827 در راه تو، گرم و سرد می نشناسم %~% اوله %~% و 
ms83	 آسایش و خواب و خورد می نشناسم(@)(@@) (@@) در درد چنان سوخت دل من، کاکنون %~% درد از دل و، دل ز درد می نشناسم(@)(@@)(@@)(@@) | باج صالح(@)(@@) (@@) 82 ای دل، بی وصل جست و جویی می کن %~% ورعیب ندانی تگ و پویی می کن(@)(@@) (@@) چجون غرقه در آب، دست و پایی میزن %~% چون قلب شکسته، های وهوبی می کن PageV01P216(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0220.jpg)(@)(@)(@@) (@@) گر سوخت در آتش فراقت، حق اوست 829 دل، وصل لب تو بیوفا اندیشد %~%(@)(@@) الغیره %~% بر روی صواب، از خطا اندیشد %~% تا این طمع خام، چرا اندیشد؟(@)(@@) ~~83 تن را بگذار، کوز بونی است عظیم لیکن به خدا، که بر دلم رحم مکن(@)(@@) %~% وله %~% یکبارگیش بکش، که خونی است عظیم! %~% وز جان بگذر، که سرنگونی است عظیم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 831 آمد دل من برت، به غم مسپارش دانی که به ترک من برای توبگفت %~%(@)(@@) آزرم تو جستهست، مجو آزارش %~% ای یوسف روزگار، نیکو دارش(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 832 ای دل، ره و رای آن دلارای بدان %~% بر خون تومی زند همی رای، بدان(@)(@@) (@@) دانی که تو را [دگر] نخواهم هرگز %~% اندیشه بکن، جای ببین جای بدان!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 832 ازیار، همیشه دیده تر دیدستم %~% خود را همه در خون جگر دیدستم(@)(@@) (@@) دی گفت: دلت کجاست؟ تا خون کنمش %~% دلجویی از او همینقدر دیدستم!(@)(@@) (@@) می گوید دل که: دل زمهرش بردار! 836 دل، قصهآ آن مهر گسل می گوید %~%(@)(@@) اوله %~% بامن سخنش خجل خجل می گوید %~% من کافرم، اردل این زدل می گوید!(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~835 در عشق تو، گر دل به زبان می آید در عشق توگم شد دل و، زونیست(@)(@@) دریغ %~% در وی توبدی، دریغ از آن می آید! %~% زاندوه توام، راحت جان می آید(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 83 چون دل پی عشق آن دلارای گرفت %~% در سر، هوس زلف سمن سا ی گرفت(@)(@@) (@@) گریخت زدست او، از آن سوی جهان %~% کنجی است عدم نام، در و جای گرفت!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1837 ای دلبر دلفریب، 
ms84	 دلدار نه ای %~% با روی نکویی و، نکو کار نهای(@)(@@) (@@) من یکدلم وتو را به ده دل یارم %~% توده دلی و، به نیم دل یارنه ای.(@)(@)PageV01P217(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0221.jpg)(@)(@)(@@)(@@)(@@) | رشید خواری(@)(@@) (@@) 838 یارم که ز مه حسن به ناموس ببرد %~% نرخ همه شهدها، به یک بوس ببرد(@)(@@) (@@) بربوذ دلم به لطف و، آنگه برگشت %~% افسوس دل من، که به افسوس ببرد!(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) (@@) 839 باز از دل گمگشته خبر می پرسم %~% در شهر فتاده، در به در می پرسم(@)(@@) (@@) مسکین من سرگشته، که دل خود بر توست %~% وانگه، خبرش جای دگر می پرسم!(@)(@@)(@@)(@@) | موفق الدین سراج(@)(@@) (@@) 840 دل، جز سر کوی تو به منزل نگرفت %~% یک مشکل عشق تو، به مشکل نگرفت(@)(@@) (@@) افزون زهزار گونه پندش دادم %~% تا بر گیرد دل از تو، بر دل نگرفت(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 841 روزی دو سه، پیکار نفرمود دلم %~% پنداشتم، از عشق برآسود دلم(@)(@@) (@@) چون در نگریدم زغم عشق تو من %~% یک منزل، از آن سوی عدم بود دلم!(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 842 در عشق، تنم زموی باریک تر است %~% روزم، ز سر زلف تو تاریک تر است(@)(@@) (@@) کار دل من، که زندگانی زتوداشت %~% دور از تو، کنون به مرگ نزدیک تر است(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) (@@) 843 دل، وصلت آن شمع چگبل می خواهد %~% کو، روز وشبش خوار و خجل می خواهد(@)(@@) ~~بس خون، که زدیدگان بباید پالود 844 آن دل، که هزار کامگاری کردهست(@)(@@) %~% لغیره %~% تا کار چنان شود، که دل می خواهد %~% بر مرکب کامها، سواری کردهست(@)(@@) (@@) امروز، در او نظاره باید کردن %~% تا عشق در او چه دستکاری کردهست!(@)(@@)(@@)(@@) | بوالحسن طلحه(@)(@@) (@@) 845 در کوی تو گم گشت دلم، روز نخست %~% امروز، یقینم شد کآن در کف توست(@)(@@) (@@) زین پس، به دل شکسته وعزم درست %~% دل را وتو را، به جان همی خواهم جست(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 846 چون چشم طرب، دوخته می یابم من %~% سینه، زغم افروخته می یابم من(@)(@@) (@@) هر چند که در خود دل خوش 
ms85	 می طلبم %~% بوی جگر سوخته مییابم من PageV01P218(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0222.jpg)(@)(@)(@@)(@@)(@@) | نزهه المجا لس(@)(@@) (@@) 847 بر دل شمرم زمان زمان کردارش %~% عوافی %~% گویم که مگر طلب کند آزارش(@)(@@) (@@) هر چند که بیش بشکنم بازارش %~% دل گرم تر است هر زمان در کارش(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 848 با دل گفتم: به درد خرسند مباش %~% در بند نگیار ناز پیوند مباش(@)(@@) (@@) زل گفت: مراد من در این کار خوش است %~% تو مردمیی بکن، در این پند مباش!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 84 ترکی، که به شمع چگلش می خوانند %~% پیمان شکن و، دل گسلش می خوانند(@)(@@) (@@) بر بود زمن چیزی و، می پندارم %~% آن است، که مردمان دلش می خوانند!(@)(@@) (@@) 85 پیش شکرت، هر مگسی را مگذار %~% لغیره %~% جز گر مروی، خوش نفسی را مگذار!(@)(@@) (@@) گفتی: دگری بر دل تو رخت نهاد %~% نه خانه خدا تویی ؟ کسی رامگذار!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 85 پنداشت دلم کز تو بری بتوان خورد %~% وز پسته دهانت، شکری بتوان خورد(@)(@@) (@@) یچاره ندانست، که بر خوان لبت %~% یک ذره نمک، بی جگری بتوان خورد(@)(@@)(@@)(@@) | دختر سالار(@)(@@) (@@) 852 از دیدهآ من، چواشک گلگون بچکد %~% هر لحظه، هزار قطره افزون بچکد(@)(@@) (@@) برآتش عشق تو، کباب است دلم %~% چون گرم شود کباب، از او خون بچکد!(@)(@@)(@@)(@@) | فلکی شروانی(@)(@@) (@@) 852 خوبی زجمالت، ای بت سیمین بر %~% حون دیده بدید، از تو به دل داد خبر(@)(@@) (@@) خون گشت دل و، چاره ندانست دگر %~% آمد به ننظارهآ تو، از دیده به در(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 85 در دل چونشست، رحمتی هم نکند %~% صد بار زند زخم، که مرهم نکند(@)(@@) (@@) گیرم که زند در این دل من، آتش %~% آخر چوبه خویشتن رسد، کم نکند؟(@)(@@)(@@)(@@) | عمال اسمابمیل(@)(@@) ~~855 اشکم، که زخون چودردی شیره شدهست وزرفتن او، دو چشم من خیره شدهست(@)(@@) (@@) از دیدهآ بیچاره نمیباید دید %~% کاین آب، زسر چشمهآ دل تیره شده ست!(@)(@)PageV01P219(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0223.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 856 ای دل، اگرت دیده بسی رنج نمود %~% مگذار، که او از تو بود ناخشنود(@)(@@) (@@) زیرا که بدین سان 
ms86	 که تویی، دیرنآه، زود %~% روزی، گذرت بر ره او خواهد بود!(@)(@@)(@@)(@@) | وله(@)(@@) ~~857 عشق تو، مرا به جان روان می بخشد اندوه توام، شادی جان می بخشد(@)(@@) (@@) بخشنده بود مست، از ان خسته دلم %~% تا مست توشد، هر دو جهان می بخشد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 858 نه یاری، ازین دلگسلی هست مرا %~% نه جز غم عشق، حاصلی هست مرا(@)(@@) (@@) وآنگه گویی مرا که: «دل خوش می دار!)) %~% خاموش، کدام دل؟ دلی هست مرا!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 859 ای، دیده ندیده چوتو دلخواهی خوش %~% با بندهآ خود، در آی گه گاهی خوش(@)(@@) (@@) گفتی که: «دولت خوش است!» آری، شک نیست! %~% عشق تو و، آنگه دل و، آنگاهی خوش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 860 هر دل، که زبوی و رنگ بیرون آید %~% مانند گهر، زسنگ بیرون آید(@)(@@) (@@) کآیینهآ خوبروی گردد، آهن %~% وقتی که زتوی زنگ بیرون آید(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 861 عهدی است مرا با دل پر درد زدوست %~% گرچه جگرم به غصه خون کرد زدوست(@)(@@) (@@) کآنگه که زمین و آسمان برگردد %~% در عشق نگو یمش که: بر گرد زدوست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 862 ای دوست، بیا و آتشی در من زن %~% ای صبر، تودر گوشه نشین و تن زن(@)(@@) (@@) ای عشق، من سوخته خرمن را باش %~% و آتش زدلم بگیر و، در خرمن زن!(@)(@@)(@@)(@@) | وله(@)(@@) ~~863 دلدار، که در حجاب دل پیدا نیست با ماست همه ساله و، جزتنها نیست(@)(@@) ~~شک نیست در آنکه، جای او در دل ماست مشکل همه این است، که دل با ما نیست!(@)(@)PageV01P220(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0224.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~864 دل بردی و گفتی: از توجان می خواهم هرچ آرزوی توست، من آن می خواهم!(@)(@@) (@@) لیکن نه برای دل، برای تو زدل %~% سرگشته، به هر گوشه نشان می خواهم!(@)(@@)(@@)(@@) | حمید گنجه ای(@)(@@) (@@) 865 دل، پیش تو ای ترک خطا می میرد %~% خواهی که بگویمت: چرا می میرد؟(@)(@@) (@@) حالی که سر و شکل خوشت می بیند %~% مسکین دل من، به دست و پا می میرد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 866 دل، در غم 
ms87	 سودای تو پیوست بماند %~% جانم، ز تمنای تو سر مست بماند(@)(@@) (@@) از دست بشد، دلی که صد جان ارزید %~% جانی به هزار پاره، در دست بماند!(@)(@@)(@@)(@@) | حمید بلخی(@)(@@) (@@) اسباب خوشیهای جهان، حاضر شد 167 هنگام بهار، عالمی کش دارد %~% خرم(@)(@@) دل آن کس، که دلی خوش دارد! %~% بستان، زگل و بنفشه مفرش دارد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) از چرخ دل خوش مطلب، زانکه هنوز 868 آن کس، که سرافرازی آتش دارد %~%(@)(@@) سر، بر قدم سپهر سرکش دارد %~% اندر عدم است آنکه دلی خوش دارد!(@)(@@)(@@)(@@) | عثمان مراغه ای(@)(@@) (@@) 869 در دیده مرا، سرشک خون است از تو %~% هر لحظه، غمم به دل فزون است از تو(@)(@@) (@@) در عشق تو گرچه نیست دل، مانده مرا %~% دل ماند گیم نگر، که چون است از تو(@)(@@)(@@)(@@) | شمس اسعد گنجهای(@)(@@) (@@) هر غم، که مرا عشق تو آرد در دل 870 ای در هوست بلاکشی کمتر دل %~%(@)(@@) در دل گیزم، ولی نگیرم بر دل %~% وی بی تو، مرا زیان شده یکسر دل(@)(@@)(@@)(@@) | وله(@)(@@) ~~871 آن یار، که کرد از نظرم یکتا دل بی آنکه به دوستی نهد، دل بر ما(@)(@@) %~% عاجز شدهام در اشتیاقش با دل %~% دیدی که چگونه برگرفت، از ما دل؟(@)(@@) (@@) 872 آن دوستیش کرده مرا دشمن خویش %~% وله %~% وان خون دلم گرفته در گردن خویش(@)(@@) (@@) رغبت به جگر خوردن من دارد و، من %~% دل می دهم او را، به جگر خوردن خویش PageV01P221(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0225.jpg)(@)(@)(@@)(@@)(@@) | القائله(@)(@@) (@@) 873 ای درد غم عشق تو، درمان دلم %~% اول قدم وصل تو، پایان دلم(@)(@@) (@@) از دست فراق تو، دلم در تو گریخت %~% از بهر خدا، جان توو، جان دلم!(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~874 مسکین دلم، از غم تو پست افتادهستتا، در پی آن نرگس مست افتادهست(@)(@@) (@@) وان دل، که چو ماه دور بودی ازمهر %~% چون ذره، کنون مهر پرست افتادهست!(@)(@@)(@@)(@@) | کافی ظفر(@)(@@) (@@) 875 دلدار مرا گفت که: ««چون هر باری %~% شادی و طرب نمی کنی بسیاری(@)(@@) (@@) گفتی که شکسته دل شدستی، آری %~% اوله 
ms88	 %~% از مردم دلشکسته ناید کاری!))(@)(@@) (@@) 876 ای دل، یارت کمر در آزار توبست %~% خوش باش، که جمله وهم در کار توبست(@)(@@) (@@) هر عشوه، که در جهان کس از وی نخرید %~% آورد و، به نرخ نیک، در بار توبست!(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 877 گشت از ره صبر باز گمراه دلم %~% و افتاد به دام عشق، ناگاه دلم(@)(@@) ~~شد زیر و زبر به کام بدخواه، دلم 878 زان بود بتا، به مهر تو رای دلم(@)(@@) %~% وله %~% بدرود دلم، وای دلم، آه دلم! %~% کاندر دل تو، شود مگر جای دلم(@)(@@) (@@) گر در تو غلط بود تمنای دلم %~% پس وای من از دست تو و، وای دلم!(@)(@@)(@@)(@@) | ابوالمعالی نحاس(@)(@@) (@@) 879 آن روز مباد، ای تمنای دلم %~% کز کوی تو، بگسسته شود پای دلم(@)(@@) (@@) اردست غمت، مرا زمن بستاند %~% پس وای دلم، وای دلم، وای دلم!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 880 از روز الست، ای تومبدای دلم %~% در چنگ غم تو سخت شد نای دلم(@)(@@) (@@) نارفته هنوز، پای جان در گل جسم %~% کاندر گل عشقت شده بد پای دلم(@)(@@)(@@)(@@) | مبارکشاه غوری(@)(@@) (@@) 881 هر چند، به وصل متصل نیست دلم %~% گر برگردد ز غم، بحل نیست دلم(@)(@@) ~~شکر است، که بی روی تواز غم خوردن در روی تو ای دوست، خجل نیست دلم PageV01P222(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0226.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 88 گر من، ز صلاح کارنه غافلمی %~% تیمار تو را، به جان کجا منزلمبی(@)(@@) (@@) دیوانهآ محضم، که اگر عاقلمی %~% کی با تو هزار دل، چنین یکدلمی(@)(@@)(@@)(@@) | بدر الدین محمود(@)(@@) (@@) 882 ای عشق تو چیره بر من بیچاره %~% از پای فرو فیتم ز سر یکباره(@)(@@) (@@) می جستم، تا دل زغمت پاره کنم %~% در تن چو نبود، جامه کردم پاره!(@)(@@)(@@)(@@) | بدر قوامی(@)(@@) (@@) مگریست دلم زاد و مرا گفت: «هنوز 88 با دل گفتم: «سر خطر داری تو %~%(@)(@@) در راه بلا عزم سفر داری تو» %~% از حال دلم، چنین خبرداری توا!»(@)(@@) ~~هلو مکن ازیار، به هر جور و جفا 88 با یار، اگرت کار به زر برناید 
ms89	(@)(@@) %~% لغیره %~% کاین کاردل است، بی جگر برناید! %~% جان نیزبده، که مختصر برناید(@)(@@) ~~88 بیچاره دلم، عشق تو در سر نگرفت هر جا نتوان گفت، که نیک و بد عشق(@)(@@) %~% لاادری %~% تا دل ز همه مرادها بر نگرفت %~% من جمله بگفتم - چه کنم؟- در نگرفت!(@)(@@) (@@) 882 ای دل، همه آن مکن که رایت باشد %~% اوله %~% جایی منشین، که آن نه جایت باشد(@)(@@) (@@) معشوقه، قلندری و درویش گزین %~% تا او، همه ساله خاک پایت باشد(@)(@@)(@@)(@@) | شهاب الدین سهروردی(@)(@@) (@@) 887 جانا، همه وعدههای باطل دهی ام %~% وز جام شکر، شربت قاتل دهی ام(@)(@@) (@@) تا چند، جگر خورم زدست ستمت %~% نامد گه آنکه اندکی دل دهی ام؟(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) 88 من، دل به جز از توبه کس آسان ندهم %~% چیزی که گران خریدم، ارزان ندهم!(@)(@@) (@@) صد جان، بدهم در آرزوی دل خویش %~% وان دل که تورا خواست، به صد جان ندهما(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 890 عشق تو، به دل خریدم و دین ارزد %~% شادم به خریدنش، که به زین ارزد(@)(@@) (@@) چون شاد نباشم، که خریدم به دلی %~% چیزی، که هزارجان شیرین ارزد!(@)(@)PageV01P223(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0227.jpg)(@)(@)(@@) (@@) 891 ای ماه، که دیدنت جهان بین ارزد %~% ل %~% بگرفته ای از غم و، جهان این ارزد؟(@)(@@) (@@) منشین ترش و، به ساز شوری انگیز %~% تلخی، که هزار جان شیرین ارزد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 892 از خود، سر بخت خود گران می بینم %~% خود را، زمیانه بر کران می بینم(@)(@@) (@@) فارغ زهمه جهان، دلی بود مرا %~% اله %~% آن نیز، به دست دیگران می بینم(@)(@@) ~~893 ای دل، مطلب وفا از او تا برهی یا با خود همچنانکه باشد می ساز(@)(@@) %~% وله %~% زین بیش مجووصال او، تا برهی %~% یا باز به ترک او بگو، تا برهی!(@)(@@) (@@) 894 یک روز نبودم ز تو دلشاد، ای دل %~% از بس که کنم ناله و فریاد، ای دل(@)(@@) (@@) تا چند، زعشق عشق جانم ستدی %~% جان تو زتن خدا ستاناد، ای دل(@)(@@) علاء الدین خواری(@)(@@) (@@) 895 دل، در خم آن دو زلف 
ms90	 عنبر سایش %~% حیران شد و، می دو ید سرتا پایش(@)(@@) (@@) یارب، توبه فضل خود رهی بنمایش %~% زان پیش، که ناگهان خوش آید جایش!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 896 دل گفت مرا که: ««آن بت از دلجویی %~% دیدی که نکرد با تو جز بدخویی!»(@)(@@) (@@) گفتم که: «تو در خدمت او خوش هستی!)) %~% گفت: «ایمه، کدام خوش؟ تونیزاین گویی!»(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~وان دل، که به توبود همه بازارش 897 آن دیده، که دیدن تو بودی کارش(@)(@@) %~% از گریه تباه می شود، مگذارش %~% در حلقهآ زلف توست، نیکودارش!(@)(@@) علاء الدین کبود جامه(@)(@@) (@@) 898 هر دم زدنی، با دل خود ساز کنم %~% تا خو، زتوای نگار، کی باز کنم(@)(@@) (@@) دل می نکند صبر زتو چندانی %~% برهم زنم این دو دیده و، باز کنم(@)(@@) شیخ شهاب الدین سهروردی(@)(@@) (@@) وان مرغ، که دانهآ غم عشق خورد 899 اصل گهرعشق، زکانی دگر است %~%(@)(@@) بیرون زدو کونش، آشیانی دگر است %~% منزلگه عاشقان، جهانی دگر است PageV01P224(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0228.jpg)(@)(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~900 چون نیست پدید در غمم بیرون شو ای دیده، تو خون گری و، ای دل خون شد(@)(@@) (@@) ای دل، تو نو آموز نه ای در ره عشق %~% حاجت نبود مرا، که گویم چون شوا(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) (@@) 901 ای گشته فراق توغم افزای دلم %~% اومید وصال تو، تماشای دلم(@)(@@) (@@) آگاه نه ای بتا، که بندی محکم %~% دست ستمت، نهاد بر پای دلم(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 90 جز درد دلت چیست دلا، حاصل ازاو؟ %~% کارت، زچه گشتهست چنین مشکل از او؟(@)(@@) (@@) جان، در غم او برید اومید چنان %~% ای دل، توهنوز برنداری دل از او!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~9 هرگز، دل من به جزهوای تو نکرد از هر چه به جای دل کنی، حکم تو(@)(@@) راست %~% کاری به غلط، خلاف رای تو نکرد %~% الا دگری، که دل به جای تو نکرد!(@)(@@)(@@)(@@) | نفیس شروانی(@)(@@) (@@) 9 بگرفت مرا، هوای در دانهٔ‌ دل %~% در آتش او بسوخت، پروانهآ دل(@)(@@) (@@) از بادهآ عشق، جرعه ای ارخوردم %~% لغیره %~% ازمستی آن خراب شد خانهآ 
ms91	 دل(@)(@@) (@@) 905 چندانکه به کار خویش وا می بینم %~% خود را، به غم تو مبتلا می بینم(@)(@@) (@@) وین طرفه، که در آینهآ دل شب و روز %~% من می نگرم، ولی تورا می بینم!(@)(@@)(@@)(@@) | اسماعیل باخرزی(@)(@@) ~~906 پیوسته چنین به کام دشمن، زدلم بردی دلم ای نگار، جان نیز ببر(@)(@@) %~% تا باز رهی تو از من و، من زدلم! %~% صد گونه بلا نهاده برتن، زدلم(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 907 چون عود، اگر چه تن بلا کش دارم %~% چون مجمر، اگر چه دل پرآتش دارم!(@)(@@) (@@) غمگین نشوم، از آنکه چون مجمر وعود %~% در عشق دلی گرم و، دمی خوش دارم!(@)(@@)(@@)(@@) | سلطان طغرل(@)(@@) (@@) 908 ای انده تو معتکف سینهآ دل %~% سودای تو، نازنین دیرینهآ دل(@)(@@) (@@) دل با همه درد دل، در اثنای سخن %~% هم پشتی او کرد، زهی سینهآ دل!(@)(@)PageV01P225(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0229.jpg)(@)(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) ~~909 گفتم که مگر یک شب از کینهآ دل با یار، بگویم غم دیرینهآ دل(@)(@@) (@@) زنجیر نفس، می گسلد جان از شوق %~% تا دید، خیال تو در آیینهآ دل(@)(@@) (@@) 910 آخر، ز پی پاسخم آواز دهید %~% لغیره %~% این ساز شکستهآ مرا، ساز دهید(@)(@@) (@@) اومیدم هست، از شما دلداران %~% کان را که دلی نیست، دلی باز دهید!(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 911 گفتم چونشد به عشق، رای دل من %~% خالی بود از بتان، سرای دل من(@)(@@) (@@) کی دانستم که عشقت، ای جان و جهان %~% گیرد به هزار دست، پای دل من!(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) (@@) 912 در خون دلم مشو، که غمخوارهآ توست %~% چشم از دو جهان دوخته، نظارهآ توست(@)(@@) (@@) در چارهآ او سعی کن، از بهرخدا %~% الغیره %~% آخر، نه چنانکه هست بیچارهآ توست؟(@)(@@) (@@) 913 هر دل، که در او سوز غمت سر کار است %~% هر ساز که باشدش، همه بر کار است(@)(@@) (@@) در راه تو، دل دادن وبیدل بودن %~% آن را که به کار توست، کمتر کار است(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 914 خوبان، که به دام زلف خور می گیرند %~% تیهوی دل، از باز نظر می گیرند(@)(@@) (@@) نقد 
