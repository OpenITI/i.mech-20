ms111	(@)(@@) قال البخاري لا يتابع على حديثه وقال الدارقطني متروك(@)(@@)(@@)(@@) | 2130 - (@)(@@) ركن الشامي عن مكحول تركوا حديثه(@)(@@)(@@)(@@) | 2131 - (@)(@@) ركين بن عبد الأعلى شيخ للثوري(@)(@@) ضعفه أبو عبد الرحمن النسائي وغيره(@)(@@)(@@)(@@) | 2132 - (@)(@@) رميح بن هلال عن ابن بريدة مجهول(@)(@@)(@@)(@@) | 2133 - (@)(@@) ت(@)(@@) رميح عن أبي هريرة لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2134 - (@)(@@) ق(@)(@@) رواد بن الجراح العسقلاني(@)(@@) سمع الأوزاعي وثقه ابن معين بالشدة وضعفه الدارقطني وقال أبو حاتم محله الصدق(@)(@@) وله خبر منكر عن سفيان عن منصور عن ربعي عن حذيفة خيركم في المائتين الخفيف الحاذ(@)(@@)(@@)(@@) | 2135 - (@)(@@) رؤبة بن رويبة(@)(@@) روى عن قتادة حديثا واهيا وعنه من لا يحتج به(@)(@@)(@@)(@@) | 2136 - (@)(@@) ت(@)(@@) روح بن أسلم الباهلي عن حماد بن سلمة(@)(@@) ضعفوه ووثقه ابن حبان فقط(@)(@@)(@@)(@@) | 2137 - (@)(@@) ت ق(@)(@@) روح بن جناح عن مجاهد(@)(@@) وثقه دحيم وقال النسائي ليس بالقوي وقال غيره له مناكير(@)(@@)(@@)(@@) | 2138 - (@)(@@) روح بن حاتم عن هشيم من مشيخة أبي يعلى(@)(@@) قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 2139 - (@)(@@) روح بن صلاح المصري عن ابن لهيعة(@)(@@) ضعفه ابن عدي يقال له ابن يسابة(@)(@@)(@@)(@@) | 2140 - (@)(@@) ع(@)(@@) روح بن عبادة ثقة شهير(@)(@@) قال فيه النسائي مرة ليس بالقوي قاله في كتاب العتق وروى الكناني عن أبي حاتم(@)(@@) PageV00P000(@)(@@) أنه قال يكتب حديثه ولا يحتج به(@)(@@)(@@)(@@) | 2141 - (@)(@@) روح بن عبد الكريم عن حماد بن سلمة(@)(@@) قال أبو حاتم يتكلمون فيه(@)(@@)(@@)(@@) | 2142 - (@)(@@) روح بن عبد الواحد عن موسى بن أعين(@)(@@) لين الحديث(@)(@@)(@@)(@@) | 2143 - (@)(@@) روح بن عبيد شيخ لمحمد بن ربيعة الكلابي(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 2144 - (@)(@@) روح بن عطاء بن أبي ميمونة(@)(@@) ضعفه النسائي وغيره(@)(@@)(@@)(@@) | 2145 - (@)(@@) روح بن عيينة الطائي(@)(@@) عن أبيه عن جده مجهول(@)(@@)(@@)(@@) | 2146 - (@)(@@) روح بن غطيف الثقفي(@)(@@) عن الزهري تركه النسائي وغيره(@)(@@)(@@)(@@) | 2147 - (@)(@@) روح بن الفضل عن حماد بن سلمة(@)(@@) مجهول وقال خ معروف بالحديث(@)(@@)(@@)(@@) | 2148 - (@)(@@) روح بن مسافر عن أبي اسحاق(@)(@@) قال أبو داود وغيره متروك(@)(@@)(@@)(@@) | 2149 - (@)(@@) روح بن المسيب عن ثابت(@)(@@) قال ابن معين صويلح وقال ابن حبان يروي الموضوعات عن الثقات لا تحل الرواية عنه 
ms112	(@)(@@)(@@)(@@) | 2150 - (@)(@@) رياح بن صالح مجهول(@)(@@)(@@)(@@) | 2151 - (@)(@@) رياح بن عمرو القيسي(@)(@@) قال أبو داود رجل سوء(@)(@@)(@@)(@@) | 2152 - (@)(@@) د س ريحان بن سعيد الناجي عن عباد بن منصور(@)(@@) صدوق قال أبو حاتم ليس بحجة قلت ليس بالمتقن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2153 - (@)(@@) د ت(@)(@@) ريحان بن يزيد عن عبد الله بن عمرو(@)(@@) وعنه سعد بن إبراهيم مجهول ووثقه ابن معين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الزاي(@)(@@)(@@)(@@) | 2154 - (@)(@@) ت ق سي(@)(@@) زافر بن سليمان القهستاني سمع ابن جريج وثقه جماعة وضعفه آخرون(@)(@@)(@@)(@@) | 2155 - (@)(@@) زامل بن زياد الطائي شيخ لعلي بن محمد المدائني مجهول(@)(@@)(@@)(@@) | 2156 - (@)(@@) زاهر بن طاهر الشحامي صدوق في الرواية لكنه يخل بالصلوات علا سنده وتكاثروا عليه وروى عنه ابن عساكر الكثير(@)(@@)(@@)(@@) | 2157 - (@)(@@) زائدة بن سليم مجهول(@)(@@)(@@)(@@) | 2158 - (@)(@@) س زائده بن أبي الرقاد معاذ عن زياد النميري(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 2159 - (@)(@@) زائدة بن سعد(@)(@@) قال أبو حاتم حديثه منكر(@)(@@)(@@)(@@) | 2160 - (@)(@@) د ت ق(@)(@@) زبان بن فائد عن سهل بن معاذ(@)(@@) ضعف وقال أبو حاتم صالح الحديث(@)(@@)(@@)(@@) | 2161 - (@)(@@) زبرقان بن عبد الله شيخ للثوري(@)(@@) فيه لين ما ذكره العقيلي(@)(@@)(@@)(@@) | 2162 - (@)(@@) زبيد بن الحارث اليامي حجة فيه تشيع يسير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2163 - (@)(@@) الزبير بن بكار صدوق غمزه السليماني(@)(@@)(@@)(@@) | 2164 - (@)(@@) ت(@)(@@) زبير بن جنادة الهجري(@)(@@) عن عطاء فيه جهالة وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) | 2165 - (@)(@@) الزبير بن خبيب المدني عن بعض التابعين(@)(@@) ضعف(@)(@@)(@@)(@@) | 2166 - (@)(@@) الزبير بن خربوذ(@)(@@) قال الأزدي ضعيف مجهول روى عنه عثمان الغطفاني(@)(@@)(@@)(@@) | 2167 - (@)(@@) د(@)(@@) الزبير بن خريق عن أبي أمامة(@)(@@) صدوق قال الدارقطني ليس بالقوي ذكره ابن حبان في الثقات(@)(@@)(@@)(@@) | 2168 - (@)(@@) الزبير بن الزبير الجهضمي مجهول(@)(@@)(@@)(@@) | 2169 - (@)(@@) د ت ق(@)(@@) الزبير بن سعيد الهاشمي عن صفوان بن سليم(@)(@@) لين وثقه يحيى وقال س وغيره ضعيف(@)(@@)(@@)(@@) | 2170 - (@)(@@) الزبير بن الشعشاع(@)(@@) عن علي في إباحة الحمر لم يصح حديثه(@)(@@)(@@)(@@) | 2171 - (@)(@@) ق(@)(@@) الزبير بن سليم(@)(@@) لا يعرف عنه ابن لهيعة(@)(@@)(@@)(@@) | 2172 - (@)(@@) قد(@)(@@) الزبير بن عبد الله المدني عن صفوان بن سليم(@)(@@) ليس بحجة(@)(@@)(@@)(@@) | 2173 - (@)(@@) ق(@)(@@) الزبير بن عبيد(@)(@@) لا يعرف لقي عائشة(@)(@@)(@@)(@@) | 2174 - (@)(@@) الزبير 
ms113	 بن عيسى عن هشام بن عروة وهو والد الحميدي(@)(@@) قال العقيلي حديثه غير محفوظ(@)(@@)(@@)(@@) | 2175 - (@)(@@) ق(@)(@@) الزبير بن المنذر الساعدي تابعي لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2176 - (@)(@@) زحر بن حصن عن جده وعنه أبو السكين الطائي(@)(@@) لا يعرف(@)(@@)(@@)(@@) | 2177 - (@)(@@) ت ق(@)(@@) زربي أبو عبد الله عن أنس(@)(@@) قال البخاري في حديثه نظر وقال الترمذي له مناكير(@)(@@)(@@)(@@) | 2178 - (@)(@@) سي(@)(@@) زرارة(@)(@@) عن عائشة في فضائل الأعمال لا يدرى من هو(@)(@@)(@@)(@@) | 2179 - (@)(@@) زرارة بن أعين أخو حمران(@)(@@) كوفي فيه رفض بين(@)(@@)(@@)(@@) | 2180 - (@)(@@) زرزر المخزومي(@)(@@) حكى عن ابن عيينه لا يعرف من هو(@)(@@)(@@)(@@) | 2181 - (@)(@@) زرعة بن إبراهيم عن عطاء(@)(@@) قال أبو حاتم الرازي ليس بالقوي(@)(@@)(@@)(@@) | 2182 - (@)(@@) زرعة بن عبد الله شيخ لبقية(@)(@@) قال الأزدي متروك(@)(@@)(@@)(@@) | 2183 - (@)(@@) زريق بن محمد الكوفي عن حماد بن زيد(@)(@@) ضعفه ابن ماكولا(@)(@@)(@@)(@@) | 2184 - (@)(@@) س(@)(@@) زفر بن أوس بن الحدثان أخو مالك(@)(@@) لم يرو عنه غير عبيد الله بن عبد الله بن عتبة(@)(@@)(@@)(@@) | 2185 - (@)(@@) زفر بن محمد الفهري مدني(@)(@@) عنه عثمان بن عبد الرحمن الحراني قال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) | 2186 - (@)(@@) زفر بن الهذيل العنبري الفقيه صدوق(@)(@@) وثقه غير واحد وأما محمد بن سعد فقال لم يكن في الحديث بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2187 - (@)(@@) زكار عن علي مجهول(@)(@@)(@@)(@@) | 2188 - (@)(@@) ع(@)(@@) زكريا بن اسحاق المكي عن عطاء(@)(@@) محتج به في الكتب قال أبو حاتم لا بأس به وقال احمد ثقة وقال ابن معين ثقة قدري والصحيح أنه لم يسمع من عطاء(@)(@@)(@@)(@@) | 2189 - (@)(@@) زكريا بن بدر مجهول(@)(@@)(@@)(@@) | 2190 - (@)(@@) زكريا بن حكيم أبو يحيى الحبطي عن الحسن(@)(@@) قال ابن المديني هالك(@)(@@)(@@)(@@) | 2191 - (@)(@@) زكريا بن دويد الكندي(@)(@@) كذاب ادعى السماع من مالك والثوري وأن له مائة وثلاثين سنة قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) | 2192 - (@)(@@) ع(@)(@@) زكريا بن أبي زائدة صدوق مشهور(@)(@@) قال أبو زرعة صويلح وقال أبو حاتم لين الحديث يدلس وثقه د وقال يدلس(@)(@@)(@@)(@@) | 