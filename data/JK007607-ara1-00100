ms81	 % % بكل واد وكل مهمه % 2(@)(@@) % وإن لحى عاذل جهول % فقل له يا عذول مه مه % PageV01P436 البحر : دو بيت 1(@)(@@) % يا من غدت القلوب في طوع يديه % ذا صبك كم تهدي تجنيك إليه % 2(@)(@@) % عذل وتسهد ووجد وقلى % % ما تم على العشاق ما تم عليه % PageV01P437 البحر : مجزوء الكامل 1(@)(@@) % ما بين هجرك والنوى % % قد ذبت فيك من الجوى % % 2(@)(@@) % يا فاتني بمعاطف % سجدت لها قضب اللوى % % 3(@)(@@) % وحياة وجهك لا سلا % % عنك المحب ولا نوى % % 4(@)(@@) % يا من حكى بقوامه % قد القضيب مذ التوى % % 5(@)(@@) % ما أنت عندي والقضي % % ب اللدن في حد سوى % % 6(@)(@@) % ها ذاك حركه الهوا % % ء وأنت حركت الهوى % % PageV01P438 البحر : سريع 1(@)(@@) % لم أنسه لما أتى مقبلا % أولاني الوصل وما ألوى % % 2(@)(@@) % وقعت بالرشف على ثغره % وقع المساطيل على الحلوى % % PageV01P439 البحر : طويل 1(@)(@@) % لنا سكرة من خمر مقلتك النشوى % % تحوذ على ضعف العقول فلا تقوى % % 2(@)(@@) % بها العقل معقول وحالي تحولت % ومالك من من فسل له سلوى % % PageV01P440 البحر : طويل 1(@)(@@) % جرحت فؤاد المستهام فداوهجرحت فؤاد المستهام فداوه % وماثله في حفظ الوداد وساوه % 2(@)(@@) % وأوص به ضعف الجفون فإنه % يقاوي من العشاق من لم يقاوه % 3(@)(@@) % غريب هوى يأوي إلى الوجد قلبه % فأنزله في مغنى رضاك وآوه % 4(@)(@@) % وبي مبسم ألمى فتنت بميمه % غراما وصدغ قد فتنت بواوه % PageV01P441 البحر : مجزوء الرجز 1(@)(@@) % رأى رضابا عن تسلي % ه أولو العشق سلو % % 2(@)(@@) % ما ذاقه وشاقه % هذا وما كيف ولو % % PageV01P442 البحر : وافر تام 1(@)(@@) % جلا ثغرا وأطلع لي ثنايا % % يسوق إلى المحب بها المنايا % % 2(@)(@@) % وأنشد ثغره يبغي افتخارا % % أنا ابن جلا وطلاع الثنايا % % PageV01P443 البحر : مجتث 1(@)(@@) % يا قلب صبرا لنار % كوتك في الحب كيا % % 2(@)(@@) % هيهات تأمن منها % % وأنت طالب دنيا % % PageV01P444 البحر : وافر تام 1(@)(@@) % وخمري الخدود يريد بعدي % % وقلبي بالصدود كواه كيا % % 2(@)(@@) % فقال الوجد يا نار استزيدي % % وقال الشوق للأجفان هيا % % PageV01P445 البحر : منسرح 1(@)(@@) % نعم هي الدار من يناديها % % وقد حمت عند حي ناديها % % 2(@)(@@) % أجلها في 
ms82	 الهوى وأكرمها % % أن أمنح الود غير ناديها % % 3(@)(@@) % كم راقني من ربيع أربعها % % زاهرها بهجة وزاهيها % % 4(@)(@@) % تهدي بنوار نيرها % % سائر عشاقها وساريها % % 5(@)(@@) % وكم بها من مصونة صلنا % % يحجبها غيرها ويحميها % % 6(@)(@@) % نم بها حليها ومبسمها % % وطيب أنفاسها ووانيها % % 7(@)(@@) % نقص صبر المحب من ثمد % ما كحل الحسن من معانيها % % 8(@)(@@) % روضة حسن يذيب من وله % شادن قلب المحب راعيها % % 9(@)(@@) % ودوحة لم تضع روائحها % % إلا سقتها عيون غاديها % % 10(@)(@@) % فمن يجير المحب من مقبل % عربد نشوانها وصاحيها % % PageV01P446 11(@)(@@) % ومن ثغور دمعي الطليق بها % % شقيق ما افتر من أقاحيها % % 12(@)(@@) % ومن خدود بالورد يانعة % % إن لاح جانيه حال جانيها % % 13(@)(@@) % ومن قدود إذا انثنت هيفا % أفردها الحسن في تثنيها % % 14(@)(@@) % كانت تهاب الخدود أدمعه % % لكن عليها الهوى يجريها % % 15(@)(@@) % صب رعى نفسه الغرام فما % % حجبه دونها تنائيها % % 16(@)(@@) % حيث نياق السرورسارية % به وشرخ الشباب حاديها % % 17(@)(@@) % وأطلق العين حيثما سرح ال % % حسن فيحويه وهو يحويها % % 18(@)(@@) % وراح في الحب من تعشقها % % يسخط أحشاءه ويرضيها % % 19(@)(@@) % ما شاب فرع له فيردعها % % أو شان فقر به فيثنيها % % 20(@)(@@) % والنفس ما كذب البعاد لها % % ما صدق القرب من أمانيها % % PageV01P447 21(@)(@@) % فلا هجير للهجر يحذره % كلا ولا قسوة يقاسيها % % 22(@)(@@) % فيا له عصر لذة بعدت % منه ليال لو كان يدنيها % % 23(@)(@@) % فدع وداعا لأهل دار حمى % واغن بدنياك عن مغانيها % % 24(@)(@@) % واستحلها من رضاب سائغها % % واستجلها من رضاب ساقيها % % 25(@)(@@) % فهي مدام كالتبر إن مزجت % أتت يآلائها لآليها % % PageV01P448 البحر : طويل 1(@)(@@) % لنا صاحب لا يرعوي لفضيلة % فلي له عقل ولا لذويه % 2(@)(@@) % ألست ترى من عظم ما هو جاهل % يحب أبا بكر ويطعن فيه % PageV01P449 البحر : سريع 1(@)(@@) % قلت وقد أقبل يسعى بها % % صفراء تحكي فعل عينيه % 2(@)(@@) % إن قسته بالشمس في حسنه % فالشمس في قبضة كفيه % PageV01P450 البحر : متقارب تام 1(@)(@@) % ومستتر من سنا وجهه % بشمس لها ذلك الصدغ في % 2(@)(@@) % كوى القلب مني بلام العذا % % ر فعرفني أنها لام كي % PageV01P451 البحر : مجزوء الكامل 
ms83	 1(@)(@@) % قامت حروب الزهر ما % % بين الرياض السندسيه % 2(@)(@@) % وأتت جيوش الآس تغ % زو روضة الورد الجنيه % 3(@)(@@) % لكنها كسرت لأن % الورد شوطته قويه % PageV01P452 البحر : موشح 1(@)(@@) % قمر يجلو دجى الغلس % بهر الأبصار مذ ظهرا % % 2(@)(@@) % آمن من شبهة الكلف % % 3(@)(@@) % ذبت في جبيه بالكلف % % 4(@)(@@) % لم يزل يسعى إلى تلفي % % 5(@)(@@) % بركاب الدل والصلف % % 6(@)(@@) % آه لولا أعين الحرس % نلت منه الوصل مقتدرا % % 7(@)(@@) % يا أمير جار مذ وليا % % 8(@)(@@) % كيف لا ترثي لمن بليا % % 9(@)(@@) % فبثغر منك لي جليا % % 10(@)(@@) % قد حلا طعما وقد حليا % % PageV01P453 11(@)(@@) % وبما أوتيت من كيس % جد فما أبقيت مصطبرا % % 12(@)(@@) % لك خد يا أبا الفرج % % 13(@)(@@) % زين بالتوريد والضرج % % 14(@)(@@) % وحديث عاطر الأرج % % 15(@)(@@) % كم سبى قلبي بلا حرج % % 16(@)(@@) % لو رآك الغصن لم يمس % أو رآك البدر البدر لاستترا % % 17(@)(@@) % بدر تم في الجمال سني % % 18(@)(@@) % ولهذا لقبوه سني % % 19(@)(@@) % بمحيا باهر حسن % % 20(@)(@@) % قد سباني لذة الوسن % % PageV01P454 21(@)(@@) % هو خشفي وهو مفترسي % % فارو عن أعجوبتي خبرا % % 22(@)(@@) % فقت في الحسن البدور مدا % % 23(@)(@@) % يا مذيبا مهجتي كمدا % % 24(@)(@@) % هل تريني للجفا أمدا % % 25(@)(@@) % عجبا أن تبرئ الرمدا % % 26(@)(@@) % وبسقم الناظرين كسي % % جفنك السحار فانكسرا % % PageV01P455 البحر : طويل 1(@)(@@) % تهيم بدر ثم ترجو له قربا % % لعمري لقد حاولت ممتنعا صعبا % % 2(@)(@@) % إذا كنت تهوى البدر فاقنع بأن ترى % % سناه على بعد وإلا فمت كربا % % 3(@)(@@) % وإن لم يدعك الدمع فانظر جماله % بقلبك إن أبقى الغرام لك القلبا % % 4(@)(@@) % وإلا فيكفيك الخيال مسلما % وإن كنت من تجفو مضاجعه الجنبا % % 5(@)(@@) % وكن قانعا منه وحسبك مفخرا % بأنك تضحى مستهاما به صبا % % PageV01P456 البحر : مجزوء الوافر 1(@)(@@) % ترى باجيرة الشعب % يسر بوصلكم قلبي ؟ % 2(@)(@@) % وتجمع بيننا دار % على الأكرام والرحب % 3(@)(@@) % أهيل الحي واعطشي % % لذاك المنهل العذب % 4(@)(@@) % ويا شوقي إلى عيش % مضى في ظله الرحب % 5(@)(@@) % وأيام بلا عتب % تقضت في ذرا عتب % 6(@)(@@) % إذا ذكرت لياليه % تهيج لاعج القلب % 7(@)(@@) % ويحكى قلب عاشقه % حديث نسيمه 
ms84	 الرطب % 8(@)(@@) % فغن بذكرها سعد % وأثن معاطف الركب % 9(@)(@@) % ومحتجب بمبتسم % يمزق ظلمة الحجب % 10(@)(@@) % من الأقمار منزلتا % % ه في طرفي وفي قلبي % % PageV01P457 11(@)(@@) % وظبي نفار بالأسرار % يأنس ليس بالترب % PageV01P458 البحر : كامل تام 1(@)(@@) % يا مدع أن الغرام بقلبه % أفنى تجلده وطار بلبه % 2(@)(@@) % من كان في دعوى المحبة صادقا % أخفى الحبيب ولن يبوح بحبه % % 3(@)(@@) % أيروم وصل محجب من دونه % % بيض تسل بأسود من هدبه % 4(@)(@@) % هيهات مت كمدا بما قد ضم % منك الحشا واخف الهوى أو ذع به % PageV01P459 البحر : وافر تام 1(@)(@@) % بعثت إليك ما يجليك ثغرا % ولفظا إذ تهنى بالرغائب % 2(@)(@@) % ولستبقانع إن لم تزرني % % لأني لست آمل بالرغائب % PageV01P460 البحر : دو بيت 1(@)(@@) % يا من هجر المحب من غير سبب % واستبدل بالوصل صدودا وغضب % 2(@)(@@) % إن مت من الهجر فما ذاك عجب % % بل إن سلمت روحي فهذاك عجب % PageV01P461 البحر : كامل تام 1(@)(@@) % قلق يحن إلى الأجيرع قلبه % وتشوقه من حبه هضباته % 2(@)(@@) % أخفى الهوى فخفاه دمع جفونه % والحب تظهر سره آياته % 3(@)(@@) % صب يجن بحي أهل وداده % ويلذ فيهم حيفه ومماته % 4(@)(@@) % ما قيس قيس في الغرام به ولا % عبرت بطرف كثير عبراته % PageV01P462 البحر : طويل 1(@)(@@) % غنينا به عن كل لهو ولذة % وقد كملت أوصافه ونعوته % 2(@)(@@) % فمن صد عنا حسبه الصد والقلى % % ومن فاتنا يكفيه أنا نفوته % PageV01P463 البحر : كامل تام 1(@)(@@) % ماست فقيل هي القضيب الأميد % ورنت فقيل هي الغزال الأغيد % 2(@)(@@) % ورأت بديع جمالها فتبسمت % عن لؤلؤ بمثاله تتقلد % 3(@)(@@) % بيضاء روض الحسن فيها أخضر % ومدامعي حمر وعيشي أسود % 4(@)(@@) % فعلت السيوف السحر من أجفانها % % ما يفعل الهندي وهو مجرد % PageV01P464 البحر : طويل 1(@)(@@) % عذارك من ند يجل عن الند % وريقك شهد لا كرامة للشهد % 2(@)(@@) % ولحظك سيف كيف أصبح قاطعا % وليس له والله في الحسن من حد % 3(@)(@@) % حبيبي شرفني بكتبك منعما % فقد حسنت شرعا مكاتبة العبد % 4(@)(@@) % رعى الله بدرا زار من غير موعد % سأشكر محبوبا يزور بلا وعد % 5(@)(@@) % ويصبح للإخلاص قلبي تاليا 
ms85	 % ويمسي لساني تاليا سورة الحمد % 6(@)(@@) % ولله جيران على أيمن الحمى % % لهم أبدا مني حنو على بدي % % 7(@)(@@) % لقد حملت ريح الصبا من ديارهم % % أحاديث ترويهن عن عذب الرند % 8(@)(@@) % فأهدت إلى قلبي سرورا على النوى % % فيا حسن ما تملي ويا طيب ما تهدي % % 9(@)(@@) % أيا سادة ملوا فملت إليهم % % وخانوا ولي قلب مقيم على العهد % 10(@)(@@) % ترى يسمح الدهر الضنين بقربكم % % وأحظى بكم يا جيرة العلم الفرد % PageV01P465 11(@)(@@) % إذا لم يكن لي عندكم يا احبتي % % محل ولا قدر فإن لكم عندي % % PageV01P466 البحر : وافر تام 1(@)(@@) % شكوت إلى الحبيبة ما ألاقي % % لسوء الحظ من ألم البعاد % 2(@)(@@) % فقالت إن حظك مثل عيني % % فقلت نعم ولكن في السواد % % PageV01P467 البحر : كامل تام 1(@)(@@) % أنفقت كنز مدائحي في ثغره % وجمعت فيه كل معنى شارد % 2(@)(@@) % وطلبت منه جزاء ذلك قبلة % فأبى وراح تغزلي في البارد % PageV01P468 البحر : سريع 1(@)(@@) % لعبت بالشطرنج مع شادن % رشاقة الأغصان من قده % 2(@)(@@) % أحل عقد البند من خصره % وألثم الشامات من خده % PageV01P469 البحر : كامل تام 1(@)(@@) % يا ثغره المحمي منه بنابل % من طرفه وبسائف من خده % 2(@)(@@) % وبمترف من صدغه وبناصر % من خاله وبعامل من قده % 3(@)(@@) % أرفق بما فعل الغرام فقد أتى % % حظ العذار موقعا في رده % PageV01P470 البحر : سريع 1(@)(@@) % ظبي له في كل قلب هوى % قد حكم الله بتخليده % 2(@)(@@) % قلده الحسن الذي يشتهي % % وهذه نسخة تقليده % PageV01P471 البحر : مجزوء الرجز 1(@)(@@) % مسك وخمر وبرد % رضا به لذا رفد % 2(@)(@@) % فلو رأى بدر الدجى % % ضياء خديه سجد % 3(@)(@@) % والحسن لو أبصره % لمات من فرط الحسد % 4(@)(@@) % يقتل باللحظ وما % % عليه في ذاك قود % 5(@)(@@) % أعيذه من ناظري % % بقل هو الله أحد % PageV01P472 البحر : دو بيت 1(@)(@@) % يا من لجمال وجهه البدر سجد % ما ترحم من يرحمه كل أحد % 2(@)(@@) % إن قيل بأن لي على الهجر جلد % ما أن صدقوا قد قيل لله ولد % PageV01P473 البحر : طويل 1(@)(@@) % حكى وجهه النقدين والجوهر الذي % % بمنظره قلب الشجي يتلذذ % 2(@)(@@) % لجين ثناياه عقيق 
ms86	 شفاهه % % وخداه تبر والعذار زمرد % PageV01P474 البحر : كامل تام 1(@)(@@) % وكأن سوسنها سبائك فضة % وكأن نرجسها عيون تنظر % 2(@)(@@) % حملت سقوط الطل منه عيونه % فكأنها عن جوهر تستعبر % PageV01P475 البحر : كامل تام 1(@)(@@) % يوم تكاثف غيمه فكأنه % دون السماء دخان غيم أخضر % 2(@)(@@) % والطل مثل برادة من فضة % منثورة في تربة من عنبر % 3(@)(@@) % والشمس من خلل السحاب كأنها % % أمة تعرض نفسها للمشتري % % 4(@)(@@) % ولدي صرف مدامة مشمولة % تلقى الظلام بوجه صبح مسفر % 5(@)(@@) % فكأنها مما تحبك أقسمت % أن لا تطيب لنا إذا لم تحضر % PageV01P476 البحر : كامل تام 1(@)(@@) % حتى متى أنا صابر يا هاجر % أترى لهذا الهجر عند ك آخر % 2(@)(@@) % ما كنت لولا نظم ثغرك ناظما % وبوصف ثغرك صح أني شاعر % 3(@)(@@) % ولقد علاني لاحمرار خدوده % فرط اصفرار حار منه الناظر % 4(@)(@@) % فاعجب له عرضا يقوم بذاته % إذ ليس لي جسد بسقمي ظاهر % 5(@)(@@) % قلبي إليك يميل طبعا في الهوى % % فالام يثنيه العذول القاسر % 6(@)(@@) % ولقد عهدت النار شيمتها الهدى % وبنار خدك كل قلب حائر % 7(@)(@@) % لا تخش من نار بخدك أضرمت % فالبدر للفلك الأثير مجاور % PageV01P477 البحر : متقارب تام 1(@)(@@) % أقلب قلبي شوقا إليه % وأذري عليه دموعا غزارا % % 2(@)(@@) % وأرعى الكواكب أنى سرين % وأرقب بدر الدجى حيث سارا % % 3(@)(@@) % والغيت من ناظري السهاد % وألقيت في القلب نورا ونارا % % PageV01P478 البحر : بسيط تام 1(@)(@@) % أليكم خمركم عني مع الوتر % % ليس المدامة والألحان من وطري % % 2(@)(@@) % فما يعقر سرور عند ذي حزن % ولا يسر قرار عند ذي فكر % 3(@)(@@) % لو أن بالأفق ما لاقيت من حرق % إذا لفرق شمل الأنجم الزهر % 4(@)(@@) % إن رمتموني نديما فارفعوا كمدي % % واستنجدوا جلدي واستوقفوا سهري % % 5(@)(@@) % لا أستلذ كؤوس الخمر دائرة % حتى أرى كأس خمر الهجر لم يدر % PageV01P479 البحر : كامل تام 1(@)(@@) % أمسى الفؤاد على تلهب جمره % كلفا بمن فتن الأنام بسحره % 2(@)(@@) % قمر غنيت بريقه عن قرقف % وكذا غنيت بنوره عن بدره % % 3(@)(@@) % أفنى الفؤاد بحسنه وجماله % فالعاشقون بأسرهم في أسره % 4(@)(@@) % فكأن ضوء الصبح نور 
ms87	 جبينه % وكأن ظلمة ليله من شعره % PageV01P480 البحر : كامل تام 1(@)(@@) % قمر رأيت الكون ضاء ببشره % لما سرى حسنا وضاع بنشره % 2(@)(@@) % ظبي وما للظبي لفتة جيده % غصن وما للغصن دقة خصره % 3(@)(@@) % يبدو اعتدال قوامه في مثله % % وتبين صحة جفنه في كسره % PageV01P481 البحر : طويل 1(@)(@@) % مليح حكاه البدر عند طلوعه % % فلا سر أن يحكيه عند سراره % % 2(@)(@@) % أغر غرار الجفن منه إذا سطا % % جفا فيه جفن الصب طيب غراره % 3(@)(@@) % أبيت ولي جفن غريق بمائه % عليه ولي قلب حريق بناره % PageV01P482 البحر : وافر تام 1(@)(@@) % فديت مؤذنا تصبو إليه % % بجامع جلق منا النفوس % 2(@)(@@) % بطير النسر من شوق إليه % % وتهوى أن تعانقه العروس % PageV01P483 البحر : سريع 1(@)(@@) % ساق يريني قلبه في الهوى % % قساوة شاب لها راسي % % 2(@)(@@) % وليس بدعا ذاك من مثله % فكل ساق قلبه قاس % PageV01P484 البحر : طويل 1(@)(@@) % لعل أراك الحي ليلا أراكه % وميض سنا من نحو طيبة يخلص % 2(@)(@@) % وإلا فما للريح تندى ذيولها % % عبيرا وما بال الركائب ترقص % 3(@)(@@) % فما زال نور المصطفى لائحا لنا % % عليها وأعلام الحمى تتشخص % 4(@)(@@) % ونحن إذا ما قد بدا علم غدا % % لنا مطرب من أجل ذاك ومرقص % 5(@)(@@) % وقالوا غدا ناتي ديار محمد % فقلت لهم هذا الذي عنه أفحص % 6(@)(@@) % أنيخوا فما بال الركوب وإنها % % على الرأس تمشي أو على العين تشخص % 7(@)(@@) % أليس الذي لولاه لم ينج مذنب % ولا كان من نار الجحيم يخلص % 8(@)(@@) % نبي له آيات صدق تبنيت % فكل حسود عندها يتنغص % 9(@)(@@) % أغاث برحماه الغزالة إذ شكت % وكان لها في ذاك غوث ومخلص % 10(@)(@@) % نبي بأملاك السماء مؤيد % وبالمعجزات البينات مخصص % PageV01P485 11(@)(@@) % وإن كلام الروح والضب والعصا % % وظبي الفلا أجلى دليل وأخلص % 12(@)(@@) % وفي مائس الأغصان إذ عاد يانعا % له ضافيا ظلا فلا يتقلص % 13(@)(@@) % حليم كريم للعفاة كانه % من الحلم والجود الجزيل مشخص % 14(@)(@@) % فيا خاتم الرسل الكرام ومن به % % 16(@)(@@) % % سوى أن قلبي في المحبة مخلص % 17(@)(@@) % إذا صح منك القرب يا خير مرسل % % PageV01P486 البحر : طويل 1 
ms88	(@)(@@) % رأت شغفي عند ارتشاف رضابها % % وتقبيلها الشافي لما في الأضالع % 2(@)(@@) % فقالت ترى ماذا الذي كنت قانعا % به من هوانا قلت مقلوب قانع % PageV01P487 البحر : كامل تام 1(@)(@@) % يا أيها الصد الذي وجه العلى % % منه يزان بمنظر مطبوع % 2(@)(@@) % لا تعتقد قلبي يحبك وحده % ها قد بعثت لسيدي مجموعي % % PageV01P488 البحر : طويل 1(@)(@@) % إذا انتقد الدينار شبهت كفه % لدى واضح الدينار في وضح الكف % 2(@)(@@) % بنرجسة صفراء قد طلها الندى % % يخاف عليها مجتنوها من القطف % PageV01P489 البحر : وافر تام 1(@)(@@) % كأن عيونها لما استدارت % بحرف الكأس صفا بعد صف % 2(@)(@@) % وصائف حول جارية عروس % عقدن ملاحة كفا بكف % PageV01P490 البحر : كامل تام 1(@)(@@) % هذا العقيق فما لقلبك يخفق % أتراه من طرب إليه يصفق % 2(@)(@@) % بانت له بانات سلع فانثنى % % وبه إلى نسماتهن تشوق % 3(@)(@@) % عرج بنا عن طيبهن فإنني % % أجد الرقيب لعرفها يستنشق % 4(@)(@@) % وبأيمن الوادي غزال ما بدا % % إلا ويبهرني هواه فأطرق % 5(@)(@@) % رشأ نضارة وجهه لم تبق لي % % رمقا فيا نظري إلى كم ترمق % % 6(@)(@@) % تمضي لواحظنا إلى وجناته % % إن لاح ماء شبابه المترقرق % 7(@)(@@) % قد دب مخضر - العذار بخده % % إني ليعجبني القضيب المورق % 8(@)(@@) % إن قلت أتلفني هواك يقول لي % % من ذا الذي ألجاك أنك تعشق % PageV01P491 البحر : كامل تام 1(@)(@@) % ما إن رأى روحي تحن لقربه % حتى تعجل بالبعاد فراقها % % 2(@)(@@) % تالله ما نظرت عيوني مذ نأى % % أبدا سواه من الأنام فراقها % % PageV01P492 البحر : كامل تام 1(@)(@@) % أتراه لما جار في أخلاقه % علم الذي يجري على مشتاقه % 2(@)(@@) % ظبي يزيد على الظبى في فتكها % % وعلى هلال الأفق في إشراقه % 3(@)(@@) % كم حي صب مغرم في حبه % ومحبه قد مات في أشواقه % 4(@)(@@) % أسر القلوب بأسرها في حبه % فالله يحفظه على عشاقه % PageV01P493 البحر : كامل تام 1(@)(@@) % عجبا وطرفك للدماء محلل % لدوام دولتك التي لا تعدل % 2(@)(@@) % وإذا أتى خط العذار مجددا % لك في الولاية يا ترى من يعزل % 3(@)(@@) % لام العذول على هواك جهالة % تبا له أعلى مثالك يعذل % 4(@)(@@) % فعليه أن يبدي 
ms89	 الملامة جاهدا % وعلى المحب بأنه لا يقبل % 5(@)(@@) % يا طلعة القمر الذي لا أنثني % % عن حبه أبدا ولا أتبدل % 6(@)(@@) % شخص الأنام إلى جمالك وانثنوا % % عنه وقد أثنو عليه وأجملوا % % 7(@)(@@) % فحديثهم عن حسن وجهك مسند % وحديثهم عن طيب ريقك مرسل % PageV01P494 البحر : بسيط تام 1(@)(@@) % يا أقتل الناس ألحاظا وأعذبهم % % ريقا متى كان فيك الصاب والعسل % 2(@)(@@) % في صحن خدك وهي الشمس طالعة % ورد يزيدك فيه الراح والخجل % 3(@)(@@) % إيمان حبك في قلبي تجدده % % من خدك الكتب أو من لحظك الرسل % 4(@)(@@) % إن كنت تنكر أني عبد دولتكم % % مرني بما شئت آتيه وأمتثل % 5(@)(@@) % لو اطلعت على قلبي وجدت به % من فعل عينيك جرحا ليس يندمل % PageV01P495 البحر : - 1(@)(@@) % ويحمر شقيقها خجلا % ويصفر بهارها وجلا % 2(@)(@@) % ويبدو حسنها خضرا % ويبدو زهرها خضلا % % 3(@)(@@) % إذا ما الصب شاهده % صبا واستأنف الغزلا % % 4(@)(@@) % وتحسب جنة الفردو % س عنه حسنها نقلا % % PageV01P496 البحر : خفيف تام 1(@)(@@) % لا ولين المعاطف المياله % وحبيب حكى الهلال جماله % 2(@)(@@) % ليس هتك المحب في الحب عارا % حين ترنو اللواحظ القتاله % 3(@)(@@) % وبروحي ظبي أطاع فؤادي % % وجده فيه إذ عصى عذاله % 4(@)(@@) % قمر زاده العذار جمالا % فلهذا أمسى به بدر هاله % 5(@)(@@) % صنم ناطق هداي غرامي % % في هواه والعذل عندي ظلاله % % 6(@)(@@) % عبد الناس خاله فأتته % أنبياء من صدغه برساله % 7(@)(@@) % إن رنا منه طرفه فغزال % أو بدا منه وجهه فغزاله % 8(@)(@@) % قال لما دنا الرحيل وفاضت % من جفوني سوابق الدمع ، ماله ؟ % 9(@)(@@) % أرتراه بما ألاقيه غر % أم درى ما أجنه وتباله % PageV01P497 البحر : وافر تام 1(@)(@@) % تعد عن الغرام فلست تقوى % % على ما فيه من كمد وذل % 2(@)(@@) % فكم من مغرم قد مات عشقا % بمن تعني ولم يظفر بدل % PageV01P498 البحر : كامل تام 1(@)(@@) % كنا حروفا عاليات لم نقل % متعلقات في ذرى أعلى القلل % 2(@)(@@) % أنا أنت فيه ونحن أنت وأنت هو % والكل في هو هو فسل عمن وصل % PageV01P499 البحر : رمل تام 1(@)(@@) % بأبي أهيف لدن قده % قام يسعى للندامى بالمدامة % 2 
ms90	(@)(@@) % جاء بالكأس وفي وجنته % شامة من أجلها قلنا بشامه % PageV01P500 البحر : سريع 1(@)(@@) % لاعبت بالخاتم إنسانة % كالبدر في جنح الدجى الفاحم % 2(@)(@@) % حتى إذا ما رمت أخذي له % من البنان الترف الناعم % 3(@)(@@) % خبته في فيها فقلت انظروا % % قد خبت الخاتم بالخاتم % PageV01P501 البحر : خفيف تام 1(@)(@@) % لا أجازي حبيب قلبي بظلمه % أنا أحنى عليه من قلب أمه % 2(@)(@@) % جوره مثل عدله عند من يه % % واه مثلي وظلمه مثل ظلمه % PageV01P502 البحر : رمل تام 1(@)(@@) % ما رأينا ضربة من صارم % يوم حرب نكست ألف علم % % 2(@)(@@) % بل رأينا مشقة من كاتب % في سجل كسرت ألف قلم % PageV01P503 البحر : رمل تام 1(@)(@@) % فغدا كل محب في الهوى % % وله قلب من الوجد طعين % 2(@)(@@) % يا له معرك حرب عجب % % كسرت فانتصرت فيه الجفون % PageV01P504 البحر : - 1(@)(@@) % إن شكونا له ظمانا وجدنا % % منه بالري للحديث ضمانا % % 2(@)(@@) % ما سبانا لين المعاطف منه % مذ تثنى إلا وقد ماس بانا % % PageV01P505 البحر : - 1(@)(@@) % يا من إذا وعد الوصال لمغرم % يلوي ويقني موضع الهجران % 2(@)(@@) % لا تظهرن لي الوداد تكلفا % ما الآل مثل الماء للظمآن % PageV01P506 البحر : خفيف تام 1(@)(@@) % بدوي كم جدلت مقلتاه % عاشقا في مقاتل الفرسان % 2(@)(@@) % ذو محيا يصيح يا لهلال % ولحاظ تقول يا لسنان % PageV01P507 البحر : مجزوء الكامل 1(@)(@@) % ما بين هجرك والنوى % % قد ذبت من ألم الجوى % % 2(@)(@@) % وحياة حبك لا سلا % % قلب المحب ولا نوى % % 3(@)(@@) % يا من حكى بقوامه % قد القضيب مذ التوى % % 4(@)(@@) % لي ناظر ظام إلى % % لقياك بالدمع ارتوى % % 5(@)(@@) % يا أحورا علقته % أحوى لرقي قد حوى % % 6(@)(@@) % يا فاتني بمعاطف % سجدت لها قضب اللوى % % 7(@)(@@) % كم لي ديون عند صد % غك قد لواها والتوى % % 8(@)(@@) % من قاس قدك بالقضي % % ب رشاقة فلقد غوى % % 9(@)(@@) % ما أنت عندي والقضيب الل % دن في حد سوى % % 10(@)(@@) % هذاك حركه الهوا % % ء وأنت حركت الهوى % % PageV01P508 البحر : سريع 1(@)(@@) % لو كنت فينا ولها مغرما % شغلت بالحب عن الشكوى % % 2(@)(@@) % حتى ترى أيسر ما نلتقي % % أعظم ما تحكي من البلوى 
ms91	 % % 3(@)(@@) % ما عز صب قط في صبوة % إلا إذا ذل لمن يهوى % % PageV01P509 البحر : خفيف تام 1(@)(@@) % قام يسعى ليلا بكأس الحميا % % شادن أحور جميل المحيا % % 2(@)(@@) % بدر عز في كفه شمس راح % نقطت من حبابها بالثريا % % 3(@)(@@) % ملك القلب منه ظرف وطرف % وضعيفان يغلبان قويا % % PageV01P510 
ms92	