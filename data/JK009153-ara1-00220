ms201	 الحديث عن القاسم عن عائشة . |(@)(@@) 999 - حدثنا معاذ بن المثنى : ثنا القعنبي : ثنا عبد الله بن جعفر الزهري | عن سعد بن إبراهيم عن القاسم عن عائشة قالت : قال رسول الله [ & ] : ' من | عمل عملا ليس عليه أمرنا ، فهو رد ' . | PageV09P725 |(@)(@@) 1000 - حدثنا محمد بن يونس القرشي : ثنا عبد الملك بن عمرو : ثنا | عبد الله بن جعفر عن سعد بن إبراهيم قال : سألت القاسم ( عن رجل له | مساكن فأوصى بثلث مساكن ) ؟ فقال : لا ، يجمع له في مسكن واحد ، | أخبرتني عائشة أن رسول الله [ & ] قال : ' من عمل عملا ليس عليه أمرنا | فهو رد ' . |(@)(@@) 1001 - حدثنا إسحاق بن إبراهيم الأنماطي : ثنا محمود بن خالد : ثنا | مروان ثنا عبد الله بن جعفر قال : ثنا سعد بن إبراهيم قال : سألت القاسم بن | محمد عن رجل أوصى بثلث كل منزل له ؟ فقال القاسم : يجمع ذلك في | مكان واحد . قال : ثم قال القاسم : اشهد لسمعت عائشة تقول : قال | رسول الله [ & ] : ' من عمل عملا ليس عليه أمرنا فأمره رد ' . | PageV09P726 |(@)(@@) 1002 - حدثني عبيد بن خلف البزار - صاحب أبي ثور - قال ثنا إسماعيل | ابن عيسى العطار : ثنا إبراهيم بن سعد قال : حدثني أبي عن القاسم عن | عائشة قالت : قال رسول الله [ & ] : ' من أحدث في أمرنا هذا ما ليس فيه ، فهو رد ' . |(@)(@@) 1003 - حدثنا بشر بن موسى الأسدي : ثنا إبراهيم بن زياد الخياط ، | وثنا جعفر بن محمد بن الخلال : ثنا يعقوب بن حميد ، وحدثني | أبو سنيل عبد الله بن عبد الرحمن بن واقد قال : حدثني أبي قالوا : ثنا | إبراهيم بن سعد عن أبيه عن القاسم بن محمد عن عائشة قالت : قال | رسول الله [ & ] : ' من أحدث في أمرنا هذا ما ليس فيه ، فهو رد ' .(@)(@@) ومن حديث أبي حازم ، واسمه سلمة بن دينار مولى لبني أشجع من بني | ليث ، وكان يقص بعد الفجر والعصر ، مات في خلافة أبي جعفر بعد سنة | أربعين ومائة ، وكان ثقة كثير الحديث عن القاسم عن عائشة . | PageV09P727 |(@)(@@) 1004 - حدثنا أحمد بن محمد بن العراد : ثنا محفوظ بن إبراهيم | الفركي قال : ثنا 
ms202	 ابن أبي مريم : ثنا موسى بن يعقوب قال : ثنا أبو حازم قال | أخبرني القاسم بن محمد أن عائشة ( رضي الله عنها ) أخبرته أن رسول الله | [ & ] لم يشبع شبعتين في يوم حتى مات ( [ & ] ) .(@)(@@) ومن حديث عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب وفد | على أبي العباس عن القاسم عن عائشة . |(@)(@@) 1005 - حدثنا محمد بن سليمان الواسطي قال : ثنا أبو نعيم ح | وحدثنا معاذ ، قال : ثنا محمد بن كثير ، قالا : ثنا سفيان الثوري عن عاصم | بن عبيد الله عن القاسم بن محمد عن عائشة قالت : ' قبل رسول الله [ & ] | عثمان بن مظعون بعد موته ، حتى رأيت دموعه تسيل على عينيه ' . | PageV09P728 |(@)(@@) 1006 - حدثنا معاذ : ثنا مسدد : ثنا يحيى - يعني ابن سعيد - وحدثنا | عبد الله ابن أحمد بن حنبل قال : حدثني أبي قال : ثنا وكيع ، وحدثنا | عبد الله بن ناجية قال : ثنا بندار : ثنا عبد الرحمن - يعني ابن مهدي - قالوا : | أنبأ سفيان الثوري ، وحدثنا عبيد بن عبد الواحد : ثنا محمد بن عبد العزيز | قال : ثنا محمد بن يوسف الفريابي عن سفيان عن عاصم بن عبيد الله عن | القاسم عن عائشة ( رضى الله عنها ) قالت : ' رأيت رسول الله [ & ] قبل | عثمان بن مظعون ، وهو ميت حتى سالت دموعه على خده ' . |(@)(@@) 1007 - حدثنا عبد الله بن أحمد بن حنبل والهيثم بن خلف قالا ثنا | محمد بن بكار ثنا قيس بن الربيع عن عاصم بن عبيد الله عن القاسم عن | عائشة قالت : ' قبل رسول الله [ & ] عثمان بن مظعون بعد ما مات حتى | سالت دموع النبي [ & ] على وجه عثمان ' . | PageV09P729 | ( حديث آخر ) . |(@)(@@) 1008 - حدثنا محمد بن الحسن الهمداني قال : ثنا محمد بن | عبيد الهمداني : ثنا عبد الرحمن بن هانئ أبو نعيم النخعي : ثنا أبو مالك - | يعني : النخعي - عن عاصم بن عبيد الله عن القاسم بن محمد بن أبي بكر | عن عائشة قالت : قال رسول الله [ & ] : ' من صلى علي صلاة صلت عليه | الملائكة ما صلى ، فليكثر عبد أو ليقل ( [ & ] تسليما ) ' . | PageV09P730 |(@)(@@) 1009 - حدثنا الهيثم بن خلف : ثنا محمد بن جعفر 
ms203	 لقلوق : ثنا بكر : | ثنا سفيان عن عاصم بن عبيد الله عن القاسم عن عائشة قالت : قال | رسول الله [ & ] : ' من صلى علي ، صلت عليه الملائكة ما صلى علي ، فليكثر عبد | من ذلك ، أو ليقل ( [ & ] ) ' . | ( حديث آخر ) . |(@)(@@) 1010 - حدثنا حامد بن محمد بن شعيب البلخي قال : ثنا بشر بن | الوليد ، أنبأ شريك عن عاصم بن عبيد الله عن القاسم عن عائشة قالت : قام | رسول الله [ & ] من فراشه في بعض الليل ، فظننت أنه يريد بعض نسائه ، | فاتبعته فأتى المقابر ، فقام عليها ، فقال : ' السلام عليكم دار قوم مؤمنين ، وإنا | بكم لاحقون ' ، ثم قال : ' اللهم لا تحرمنا أجرهم ، ولا تضلنا بعدهم ' . ثم | التفت ، فأبصرني فقال : ' ويحها لو تستطيع ما فعلت ' . | PageV09P731(@)(@@) ومن حديث سعيد بن سعد بن قيس الأنصاري ، توفي سنة إحدى | وأربعين ومائة ، وكان ثقة قليل الحديث دون أخيه عن القاسم عن عائشة . |(@)(@@) 1011 - حدثنا معاذ قال : ثنا عبد الله بن محمد بن أسمال قال : ثنا | عبد الله - يعني : ابن المبارك - عن سعد بن سعيد الأنصاري عن القاسم بن | محمد عن عائشة ( رضى الله عنها ) عن النبي [ & ] قال : ' أحب الأعمال | إلى الله عز وجل ما دام عليه صاحبها ، وإن قل ' قال : فكانت عائشة رضي الله | عنها إذا عملت عملا ، داومت عليه ، لقد أهدت بدنة ، فضلت . قال : | فاشترت بدلها أخرى ، فنحرتها ، ثم وجدت الأخرى ، فنحرتها ، فكانت بعد | تهدي بدنتين . |(@)(@@) 1012 - حدثنا علي بن طيفور النسائي قال : ثنا قتيبة بن سعيد قال : ثنا | عبد العزير عن سعد بن سعيد قال : ثنا القاسم عن عائشة أنها سمعت | رسول الله [ & ] يقول : ' إن أحب الأعمال إلى الله ( تعالى ) أدومها ، وإن قل ' . | PageV09P732(@)(@@) ومن حديث يحيى بن سعيد بن ( قيس ) بن عمرو بن سهل الأنصاري | أحد بني مالك بني النجار ، ويكنى أبا سعيد توفي بالهاشمية سنة ثلاث | وأربعين ومائة ، وكان قاضيا لأبي جعفر ، وكان ثقة كثير الحديث حجة عن | القاسم عن عائشة . |(@)(@@) 1013 - حدثنا إسحاق بن الحسن الحربي : ثنا القعنبي عن مالك عن | يحيى بن سعيد عن القاسم أن عائشة كانت تقول 
ms204	 إذا تشهدت : ' التحيات ، | الطبيات ، الصلوات الزاكيات لله ، أشهد أن لا إله إلا الله وأن محمدا عبده | ورسوله ، السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى | عباد الله الصالحين ، السلام عليكم ' . | PageV09P733 |(@)(@@) | الجزء العاشر من :(@)(@@) فوائد أبي بكر محمد بن عبد الله بن إبراهيم الشافعي | عن شيوخه .(@)(@@) رواه عنه أبو طالب محمد بن محمد بن إبراهيم بن | غيلان البزاز .(@)(@@) رواية الشيخين أبي محمد الحسن بن عبد الملك بن | محمد بن يوسف ، وأبي منصور محمد بن أحمد بن طاهر | ابن حمد الخازن جميعا عنه .(@)(@@) سماع للمبارك بن أحمد بن عبد العزيز بن المعمر | الأنصاري منهما نفعه الله به . | PageV10P734 | بسم الله الرحمن الرحيم | رب أنعمت فزد(@)(@@) أخبرنا الشيخ أبو محمد الحسن بن عبد الملك بن محمد بن يوسف | قراءة عليه ، وأنا أسمع ، وذلك في رجب من سنة أربع وتسعين وأربعمائة ، | وأخبرنا الشيخ أبو منصور محمد بن أحمد بن طاهر بن حمد الخازن قراءة | عليه في يوم السبت سابع عشري رجب من سنة ثلاث وخمسمائة ، | قالا : أخبرنا أبو طالب محمد بن محمد بن إبراهيم بن غيلان قراءة عليه ، | قال : أنبأ أبو بكر محمد بن عبد الله بن إبراهيم الشافعي ، قال : |(@)(@@) 1014 - ثنا موسى بن هارون البزاز ثنا أبو الربيع وحدثنا جعفر بن | محمد بن الحسن الفريابي : ثنا محمد بن عبيد بن حساب ، قالا : ثنا حماد | ابن زيد عن يحيى بن سعيد عن القاسم بن محمد قال : كانت عائشة تعلمنا | التشهد ، وتعقدهن بيدها : التحيات ، الصلوات ، الطيبات ، الزاكيات لله ، | السلام عليك أيها النبي ورحمة الله وبركاته ، السلام علينا وعلى عباد الله | PageV10P735 | الصالحين ، أشهد أن لا إله إلا الله ، وأشهد أن محمدا عبده ورسوله . |(@)(@@) 1015 - حدثني عمر بن إسماعيل بن أبي غيلان : ثنا أبي : ثنا الحجاج : | قال ابن جريح : أخبرني يحيى بن سعيد قال : سمعت القاسم يقول : كانت | عائشة تعلمنا التشهد ، وتشير بيدها ( فذكر مثله ) وزاد : ويدعو الإنسان | لنفسه بعد ذلك . | ومن تابعه على ذلك . |(@)(@@) 1016 - حدثنا إسحاق بن الحسن الحربي : ثنا القعنبي عن مالك عن 
ms205	 | عبد الرحمن بن القاسم ، وحدثنا جعفر بن محمد : ثنا قتيبة عن مالك عن | عبد الرحمن بن القاسم عن أبيه أن عائشة زوج النبي [ & ] كانت تقول إذا | تشهدت : التحيات ( لله ) الطيبات ، الصلوات الزاكيات لله ، أشهد أن لا إله | إلا الله وحده لا شريك له ، وأن محمدا عبد الله ورسوله ، السلام عليك أيها | النبي ورحمة الله وبركاته ، السلام علينا وعلى عباد الله الصالحين ، السلام | PageV10P736 | عليكم . وهذا حديث إسحاق الحربي . |(@)(@@) 1017 - حدثنا عبد الله بن ياسين : ثنا بندار : ثنا عبد الوهاب الثقفي : ثنا | عبيد الله - يعني : ابن عمر - عن عبد الرحمن بن القاسم عن أبيه عن | عائشة أنها كانت إذا شهدت قالت : التحيات لله ، الصلوات ، الطيبات | الزاكيات لله ( الصلوات الطيبات الزاكيات لله ) السلام عليك أيها النبي | ورحمة الله وبركاته ، السلام علينا وعلى عباد الله الصالحين ، أشهد أن | لا إله إلا الله ، وأشهد أن محمدا عبده ورسوله . |(@)(@@) 1018 - حدثني ابن ياسين : ثنا إبراهيم بن حرب العسكري : ثنا يعقوب بن | حميد قال : حدثني صالح بن محمد بن صالح بن دينار قال : حدثني أبي قال | علمني القاسم بن محمد قال : علمتني عائشة ، قالت : هذا ما تشهد | PageV10P737 | رسول الله [ & ] : التحيات لله ، والطيبات ، السلام علينا وعلى عباد الله | الصالحين ، أشهد أن لا إله إلا الله ، وأشهد أن محمدا رسول الله . قال | صالح : قال : أبي قلت للقاسم : بسم الله ؟ قال : بسم الله على كل حال . | PageV10P738 |(@)(@@) | ومن كتاب الأدب :(@)(@@) | باب أكل النبي & العنب(@)(@@) 1019 - حدثنا محمد بن غالب : ثنا محمد بن عقبة السدوسي : ثنا داود | ابن عبد الجبار أبو سليمان الكوفي : ثنا أبو الجارود عن حبيب بن يسار عن | ابن عباس قال : ' رأيت النبي ( [ & ] ) يأكل العنب خرطا ' . | PageV10P739 | صفحة فارغة | PageV10P740 |(@)(@@) | باب : أكل النبي [ & ] الجمار(@)(@@) 1020 - حدثنا محمد بن غالب : ثنا أبو الوليد : ثنا أبو عوانة عن | أبي بشر عن مجاهد عن ابن عمر قال : رأيت رسول الله [ & ] يأكل | جمار نخل ' . | PageV10P741 |(@)(@@) | باب أكل النبي [ & ] لحم الطير(@)(@@) 1021 - حدثنا محمد بن غالب : ثنا داود بن سليمان المنقري : ثنا | ابن أبي فديك قال : حدثني 
ms206	 برية بن عمر بن سفينة عن أبيه عن جده ، قال : | ' أكلت مع النبي [ & ] لحم حباري ' ( الصواب سليمان بن داود المنقري ) . | PageV10P742 |(@)(@@) | باب كراهية أكل الغراب(@)(@@) 1022 - حدثنا أبو الوليد محمد بن أحمد بن برد الأنطاكي : ثنا الهيثم | ابن جميل ثنا شريك عن هشام بن عروة عن أبيه عن ابن عمر قال : ' من | يأكل الغراب وقد سماه رسول الله [ & ] فاسقا ! والله ما هو من الطيبات ' . | PageV10P743 |(@)(@@) | باب ما روي عن النبي [ & ] أنه قال | ' سيد إدامكم الملح '(@)(@@) 1023 - حدثنا أبو علي الحسن بن الطيب البلخي : ثنا جمعة بن | عبد الله البلخي السلمي : ثنا مروان بن معاوية الفزاري عن عيسى بن | أبي عيسى عن موسى بن أنس عن أنس بن مالك قال : قال رسول الله [ & ] : | ' سيد إدامكم الملح ' . | PageV10P744 |(@)(@@) | باب الرخصة في أكل الثوم(@)(@@) 1024 - حدثنا يحيى بن عبد الباقي الأذني : ثنا لوين ثنا زافر بن سليمان | عن إسرائيل عن مسلم عن حبة عن علي قال : قال لي رسول الله [ & ] : | ' كل الثوم ، فلولا أني أناجي الملك ، لأكلته ' . | PageV10P745 |(@)(@@) | باب ما روي عن رسول الله [ & ] : أنه كان يستاك عرضا ، ويشرب مصا(@)(@@) 1025 - حدثنا أبو يحيى الزعفراني جعفر بن محمد بن الحسن الرازي : | ثنا عمر بن علي بن أبي بكر : ثنا علي بن ربيعة القرشي مديني عن يحيى بن | سعيد عن سعيد بن المسيب عن ربيعة بن أكثم قال : كان رسول الله [ & ] | يستاك عرضا ، ويشرب مصا ، ويقول : ' هو أهنأ وأمرأ ' . | PageV10P746 | صفحة فارغة | PageV10P747 |(@)(@@) | باب ما روي عن النبي [ & ] : أنه كره | أكل الضب ، ولم يحرمه ، وقال : ' أجدني أعافه ' .(@)(@@) 1026 - حدثنا محمد بن بشر بن مطر أخو خطاب : ثنا سهل بن زنجلة | الرازي : حدثنا عبد الرحمن بن مغراء : ثنا محمد بن إسحاق عن إسماعيل | ابن مسلم عن عبد الكريم بن أبي المخارق عن حبان بن جزء السلمي عن | أخيه خزيمة بن جزء قال : ' أتيت النبي [ & ] بالمدينة ، فقلت : يا رسول الله | إني جئت أسألك عن أحناش الأرض ؟ قال : سل عما شئت . قال : فسألته عن | الضب ؟ فقال : ' لا آكله ، ولا أحرمه ' : قلت : فإني آكل 
ms207	 ما لم يحرم ، قال ' إنها | فقدت ، وإني رأيت خلقا رابني ' . قال : وسألته عن الأرنب ؟ فقال : ' لا آكله ، | ولا أحرمه ' قلت : فإني آكل ما لم يحرم . قال : ' بلغني أنها تدمي ' قال : | وسألته عن الضبع ؟ فقال : ' ومن يأكل الضبع ؟ ' قال : وسألته عن الذئب ؟ | فقال : ' لا يأكل الذئب أحد فيه خير ' . | PageV10P748 |(@)(@@) 1027 حدثني محمد بن بشر أخو خطاب : ثنا وهب بن بقية : أنبأ خالد | ابن عبد الله عن ابن أبي ليلى عن نافع عن ابن عمر قال : كنت آكل الضب ، | حتى سمعت رسول الله [ & ] يقول : ' لا آكله ، ولا أنهى عنه ' . | PageV10P749 |(@)(@@) 1028 - حدثنا محمد بن بشر بن مطر : ثنا حاجب بن الوليد : ثنا محمد | ابن سلمة عن ابن إسحاق عن عبد الكريم البصري عن حبان بن جزي | السلمي عن أخيه خزيمة بن جزي ، قال : قدمت على رسول الله [ & ] | فقلت : يا رسول الله ، إني جئت أسألك عن أحناش الأرض ؟ قال : ' سل عما | بدا لك ' قلت : الضب يا رسول الله ؟ قال : لا آكله ، ولا أحرمه ' قلت . | فإني آكل ما لم يحرم . قال : ' إنها فقدت أمة من الأمم ، ورأيت خلقا رابني ' ، | قلت : فالأرنب يا رسول الله ؟ قال : ' لا آكلها ، ولا أحرمها ' قلت : فأنا آكل ما | لم يحرم قال : ' إني حدثت أنها تدمى ' ، قلت : فالضبع يا رسول الله ؟ قال : | ' ومن يأكل الضبع ؟ ' قلت : فالثعلب ؟ قال : ' ومن يأكل الثعلب ؟ ' قلت : | فالذئب يا رسول الله ؟ قال : ' لا يأكل الذئب أحد فيه خير ' . |(@)(@@) 1029 - حدثنا ابن ياسين : ثنا يوسف بن موسى : ثنا عبيد الله بن | PageV10P750 | موسى : ثنا شعبة بن الحجاج عن حصين عن زيد بن وهب عن حذيفة : أن | النبي [ & ] قال في الضب : ' أمة مسخت دواب في الأرض ' . |(@)(@@) 1030 - حدثني إسحاق بن موسى الرملي : ثنا يوسف بن مسلم | المصيصي : ثنا خالد بن يزيد القسري : ثنا محمد بن سوقة عن سعيد بن | جبير عن عائشة ، قالت : ' نهى رسول الله [ & ] عن أكل الضب ' . | PageV10P751 | صفحة فارغة | PageV10P752 |(@)(@@) 1031 - حدثنا محمد بن الحسين بن شهريار : ثنا بشر بن معاذ : ثنا ثابت | ابن زهير : ثنا هشام بن 
ms208	 عروة عن أبيه عن عائشة ، مثل ما قال ابن عمر عن | النبي [ & ] في الضب : ' لست بآكله ، ولا محرمه ' . | PageV10P753 |(@)(@@) | باب دعاء النبي [ & ] بعد الطعام(@)(@@) 1032 - حدثنا عمر بن إسماعيل بن أبي غيلان : ثنا عبد الأعلى بن | حماد : ثنا بشر بن منصور السليمي عن زهير بن محمد عن سهيل عن أبيه | عن أبي هريرة قال : ' دعا رجل من الأنصار من أهل قباء النبي [ & ] . قال : | فانطلقنا معه ، فلما طعم ، وغسل يده - أو قال : يديه - قال : ' الحمد لله | الذي يطعم ولا يطعم ، من علينا ، فهدانا ، وأطعمنا ، وسقانا ، وكل بلاء حسن أبلانا ، | الحمد لله غير مودع ولا مكافأ ولا مكفور ولا مستغني عنه ، الحمد لله الذي أطعم | الطعام ، وسقى من الشراب ، وكسا من العرى ، وهدى من الضلال ، وبصر من | العمى ، وفضلني على كثير من خلقه تفضيلا ' . | PageV10P754 |(@)(@@) | باب ما روي أن النبي [ & ] | كان يشرب قائما وقاعدا(@)(@@) 1033 - حدثنا محمد بن أحمد بن النضر الأزدي : ثنا أبو خالد | المعني : ثنا غصن بن محمد بن يونس بن أبي إسحاق السبيعي عن عيسى | ابن محمد بن سعد بن عبد الله عن عطاء عن عائشة قالت : كان رسول الله | [ & ] يشرب قائما وقاعدا ' . |(@)(@@) 1034 - حدثنا أبو حفص عمر بن الحسن قاضي حلب : ثنا أبو خيثمة | PageV10P755 | مصعب بن سعيد : ثنا عيسى بن يونس عن المعلي بن عرفان عن شقيق عن | ابن مسعود قال : ' كان النبي [ & ] إذا شرب ، تنفس في الإناء ثلاثا يحمد الله | على كل نفس ، ويشكره عند آخرهن ' . |(@)(@@) 1035 - حدثنا أحمد بن الحسين المديني : ثنا سفيان بن وكيع : ثنا | يونس ابن بكير عن زياد بن المنذر عن بشر بن غالب عن حسين بن علي | قال : رأيت رسول الله [ & ] يشرب قائما . |(@)(@@) 1036 - حدثنا ابن ياسين : ثنا أحمد بن سنان القطان : ثنا زيد بن | الحباب : ثنا مندل بن علي عن محمد بن إسحاق عن عبيد الله بن عبد الله | عن ابن عباس قال : ' كان لرسول الله [ & ] ( قدح من ) قوارير يشرب فيه ' . |(@)(@@) 1037 - حدثنا ابن كزال : ثنا عمرو الناقد : ثنا عبد الله بن محمد 
ms209	 | PageV10P756 | ابن نفيل : ثنا مسكين بن بكير عن الأوزاعي عن الزهري عن أنس | ابن مالك أن رسول الله [ & ] شرب قائما . |(@)(@@) 1038 - حدثنا أحمد بن علي الأبار : ثنا محمد بن منصور الجواز | المكي : ثنا سفيان عن معمر عن الزهري عن عروة عن عائشة قالت : ' كان | أحب الشراب إلى رسول الله [ & ] الحلو البارد ' . |(@)(@@) 1039 - حدثنا بشر بن موسى : ثنا خلاد بن يحيى : ثنا سفيان عن | عاصم عن الشعبي عن ابن عباس ' أن النبي [ & ] شرب من زمزم قائما ' . |(@)(@@) 1040 - حدثنا أبو حفص عمر بن الحسن القاضي ثنا عامر بن سيار ثنا | عبد القدوس يعني ابن حبيب عن عامر الشعبي عن ابن عباس قال : أتي | رسول الله [ & ] بدلو من ماء زمزم فشرب وهو قائم . | PageV10P757 | صفحة فارغة | PageV10P758 |(@)(@@) | باب نهي النبي [ & ] عن الشرب قائما(@)(@@) 1041 - حدثنا إسماعيل بن إسحاق القاضي : ثنا عارم بن الفضل : ثنا | سعيد بن زيد عن علي بن الحكم عن أبي نضرة عن أبي سعيد قال : ' نهى | أن يشرب الرجل وهو قائم ، وأن يلتقم فم السقاء ، فيشرب منه ' . | PageV10P759 |(@)(@@) | باب ما روي عن النبي [ & ] | ساقي القوم آخرهم(@)(@@) 1042 - حدثنا بشر بن موسى الأسدي : ثنا سعيد بن منصور : ثنا حماد | بن زيد عن ثابت البناني عن عبد الله بن رباح عن أبي قتادة أن رسول الله | [ & ] قال : ' ساقي القوم آخرهم ' . |(@)(@@) 1043 - حدثنا بشر بن موسى : ثنا سعيد : ثنا هشيم : أنبأ علي بن زيد | عن عبد الله بن رباح عن أبي قتادة أن رسول الله [ & ] قال : ' ساقي القوم | آخرهم ' . | PageV10P760 | ومن حديث يحيى بن سعيد الأنصاري عن القاسم عن عائشة . |(@)(@@) 1044 - حدثنا معاذ بن المثنى : ثنا مسدد : ثنا يحيى - يعني : ابن سعيد | القطان - عن يحيى بن سعيد الأنصاري قال : سمعت القاسم يقول : كانت | عائشة إذا سمعت الناس يقولون : حرم كل ذي ناب من السباع ، تلت : | ^ ( قل لا أجد في ما أوحي إلي محرما على طاعم يطعمه ) ^ [ الأنعام : 145 ] الآية . إلا أن | البرمة ليكون في مائها الصفرة ، فلا يحرمها ذلك . |(@)(@@) 1045 - حدثنا أبو عبد الله أحمد بن عبد الجبار 
ms210	 : ثنا العيشي يعني | عبيد الله بن محمد : ثنا حماد : ثنا يحيى بن سعيد عن القاسم عن عائشة | أنها سئلت عن لحوم السباع ؟ فلم تر به بأسا ، وقرأت هذه الآية ^ ( قل لا أجد | في ما أوحي إلي محرما على طاعم يطعمه ) ^ [ الأنعام : 145 ] الآية . حديث آخر |(@)(@@) 1046 - حدثنا جعفر بن محمد بن كزال قال : ثنا أبو الأحوص - يعني : | البغوي - : ثنا حماد بن خالد : ثنا ليث بن سعد عن معاوية بن صالح عن | يحيى بن سعيد عن القاسم عن عائشة ( رضى الله عنها ) قال : سئلت ما | PageV10P761 | كان رسول الله [ & ] يعمل في بيته ؟ قالت : كان بشرا من البشر ، يفلي ثوبه ، | ويحلب شاته ، ويخدم نفسه [ & ] . | حديث آخر . |(@)(@@) 1047 - حدثنا أحمد بن الحسن بن عبد الجبار : حدثنا داود بن عمرو | قال ثنا محمد بن عبد الله بن عبيد بن عمير عن يحيى بن سعيد عن القاسم | عن عائشة قالت : لما قدم جعفر وأصحابه ، تلقاه رسول الله [ & ] ، فاعتنقه ، | وقبل بين عينيه . | PageV10P762 | حديث آخر . |(@)(@@) 1048 - حدثنا عمرو بن بشر النيسابوري : ثنا عبيد الله بن سعد ثنا عمي | - يعني : يعقوب - ثنا أبي عن أبي إسحاق قال : حدثني يحيى بن سعيد عن | عمرة ، والقاسم عن عائشة أنها قالت : ' خير رسول الله [ & ] نساءه ، ثم لم | يذهب من طلاقهن شيء ' . |(@)(@@) 1049 - حدثناه إسماعيل بن الفضل البلخي : ثنا أحمد بن ناصح : ثنا | ابن عثمة : ثنا عبد الرحمن بن أبي الزناد عن عبد الرحمن بن الحارث عن | القاسم عن عائشة قالت : ' أمر الله ( عز وجل ) رسوله ( [ & ] ) ، فخيرنا ، | فما ذلك شيئا . |(@)(@@) 1050 - حدثنا بشر بن موسى الأسدي : ثنا سريج : ثنا الجمحي | عن عبد الرحمن بن القاسم عن أبيه عن عائشة قالت : استأذنت سودة بنت | زمعة رسول الله [ & ] تصلي الصبح يوم النحر بمنى ، وترمي . فأذن لها ، | وكانت امرأة ثقيلة ثبطة . | PageV10P763 |(@)(@@) 1051 - حدثنا القاضي أبو إسحاق إسماعيل بن إسحاق : ثنا يحيى - | يعني : بن عبد الحميد - : ثنا أبو خالد عن يحيى بن سعيد عن القاسم عن | عائشة قالت : ' لوددت أني كنت استأذنت النبي [ & ] ، كما استأذنته سودة أن 
ms211	 | تغدو إلى منى بليل فترمي الجمرة ' . | ومن تابعه على ذلك . |(@)(@@) 1052 - حدثنا معاذ بن المثنى : ثنا القعنبي : ثنا أفلح يعني ابن حميد | عن القاسم عن عائشة قالت : استأذنت سودة رسول الله & ليلة المزدلفة أن | تدفع قبله وقبل حطمة الناس ، وكانت امرأة ثبطة ، يقول القاسم : والثبطة : | الثقيلة ، فأذن لها ، فخرجت قبل دفعة الناس ، وجلسنا حتى أصبحنا ، فدفعنا | بدفعه ، ولأن أكون استأذنت - يعني كما استأذنت سودة - ، فأكون أدفع بإذنه | قبل الناس ، أحب إلي من مفروح به . | PageV10P764 |(@)(@@) 1053 - حدثنا معاذ : ثنا مسدد : ثنا حماد بن زيد : ثنا أفلح بن حميد | قال : سمعت القاسم يحدث عن عائشة : أن سودة كانت امرأة ثبطة ، | فسألت رسول الله [ & ] أن تفيض من جمع قبل الإمام وقبل حطمة الناس ؟ | فأذن لها ، ذكر كلمة قالت عائشة : فأفيض قبل الإمام وقبل حطمة الناس ، | أحب إلي من كذا وكذا . |(@)(@@) 1054 - حدثني علي بن الحسن الفامي : ثنا عمرو الأودي : ثنا وكيع | عن أفلح بن حميد عن القاسم عن عائشة وسفيان عن عبد الرحمن بن | القاسم عن أبيه عن عائشة : أن سودة ابنة زمعة كانت امرأة ثبطة - يعني : | ثقيلة - فاستأذنت النبي [ & ] أن تدفع من جمع قبل دفعة الناس ، فأذن لها . |(@)(@@) 1055 - حدثنا معاذ : ثنا محمد بن كثير قال : أنبأ سفيان - يعني : الثوري - | عن عبد الرحمن بن القاسم عن القاسم عن عائشة ( رضي الله عنها ) قالت : | ' استأذنت سودة النبي [ & ] ليلة جمع - وكانت ثقيلة ثبطة - ؟ فأذن لها ' . | PageV10P765 |(@)(@@) 1056 - حدثنا الهيثم بن خلف : ثنا محمد بن المثنى ، قال : | ثنا عبد الوهاب - يعني : الثقفي - : حدثنا أيوب عن عبد الرحمن بن | القاسم عن أبيه عن عائشة ( رضى الله عنها ) ( بنحوه ) : ' وكانت عائشة | لا تفيض إلا مع الإمام ' . |(@)(@@) 1057 - حدثنا محمد بن بشر بن مطر : ثنا أحمد بن حنبل : ثنا | إسماعيل بن إبراهيم : ثنا أيوب ، قال : سمعت القاسم يحدث عن عائشة | قالت : كان رسول الله [ & ] يبعث بالهدي افتل قلائدها بيدي ، ثم لا يمسك | عن شيء ( لا ) يمسك عنه الحلال . |(@)(@@) 1058 - حدثني جعفر بن محمد بن كزال ، قال : ثنا الجوهري | سريج 
ms212	 بن النعمان : حدثنا أبو إبراهيم عن يحيى بن سعيد عن القاسم ، | وعمرة عن عائشة قالت : كنت أفتل قلائد هدي رسول الله [ & ] ، ثم يقعد | PageV10P766 | فلا يدع شيئا كان يصنعه . |(@)(@@) 1059 - حدثني إسحاق بن موسى الرملي قال : ثنا عمران بن بكار قال : | ثنا الربيع بن روح قال : ثنا ابن عياش عن يحيى بن سعيد عن القاسم عن | عائشة ( رضي الله عنها ) أن رسول الله [ & ] كان يبعث بالهدي ينحر عنه ، | فأفتل قلائد بدنه ، ثم يقيم ، فما يترك شيئا كان يصنعه . |(@)(@@) 1060 - حدثنا محمد بن يونس القرشي قال : ثنا عثمان بن عمر : ثنا | أفلح ابن حميد عن القاسم بن محمد عن عائشة أن رسول الله [ & ] ذكر | كلمة ، وبعدها بدنته ، وقلدها ، ثم بعث بها إلى البيت ، ثم أقام بالمدينة ، | فما حرم عليه شيء . | PageV10P767 |(@)(@@) 1061 - حدثنا معاذ : ثنا القعنبي : ثنا أفلح بن حميد عن القاسم عن | عائشة قالت : ' فتلت قلائد هدي رسول الله [ & ] بيدي ، ثم أشعرها وقلدها | ثم بعث بها إلى البيت ، فأقام بالمدينة ، فما حرم عليه شيء كان له حلا ' . |(@)(@@) 1062 - حدثني أحمد بن يوسف البصري قال : ثنا أحمد بن عيسى : ثنا | ابن وهب قال : أخبرني أفلح بن حميد عن القاسم بن محمد عن عائشة | قالت : ' فتلت قلائد هدي رسول الله & بيدي ، ثم قلدها رسول الله [ & ] | بيده ، وأشعرها ، وساقها ' . |(@)(@@) 1063 - حدثنا بشر بن موسى : ثنا الحميدي : ثا سفيان : ثنا عبد الرحمن | ابن القاسم يخبره عن أبيه عن عائشة ( رضي الله عنها ) قالت : كنت أفتل | قلائد هدي رسول الله & بيدي هاتين ، ثم لا يعتزل شيئا مما يعتزله المحرم ، | ولا يتركه . قالت عائشة : وما نعلم الحاج يحله شيء إلا الطواف بالبيت . | PageV10P768 |(@)(@@) 1064 - حدثني الحسين بن عبد الله بن شاكر : ثنا أحمد بن حفص قال : | حدثني أبي : ثنا إبراهيم بن طهمان عن الحجاج بن الحجاج عن | عبد الرحمن بن القاسم عن أبيه عن عائشة أنها قالت : كنت أفتل قلائد | هدي رسول الله [ & ] ، فيبعث بها ، ثم لا يمسك عن شيء مما حل له . |(@)(@@) 1065 - حدثنا إسحاق بن إبراهيم الأنماطي 
ms213	 : ثنا عبد الرحمن - يعني | دحيما - ثنا عمر - يعني : ابن عبد الواحد - : ثنا الأوزاعي عن عبد الرحمن | بن القاسم عن أبيه عن عائشة قالت : فتلت قلائد هدي رسول الله [ & ] ، ثم | لم يعتزل شيئا ، ولم يتركه ، إنا لا نعلم الحرام يحله إلا الطواف بالبيت . |(@)(@@) 1066 - حدثنا موسى بن هارون البزاز : ثنا قتيبة : ثنا الليث | عن عبد الرحمن بن القاسم عن أبيه عن عائشة ' أنها فتلت قلائد بدن | رسول الله [ & ] ، ولم يحرم ، ولم يترك شيئا من الثياب ' قال موسى : الليث | يقوله : ثم لم يترك شيئا من الثياب . |(@)(@@) 1067 - حدثني ابن ياسين قال : ثنا محمد بن مرداس الأنصاري ، | PageV10P769 | ومحمد ابن معمر قالا : ثنا سالم بن نوح : ثنا عمر بن عامر عن أيوب | وحدثني ابن ياسين : ثنا المخرمي : حدثنا الفضل بن عبد الله الحنظلي : ثنا | عمر بن عامر عن أيوب جميعا عن القاسم بن محمد عن عمته عائشة أنها | قالت : ' طيبت رسول الله [ & ] عند إحرامه وعند إحلاله ' . |(@)(@@) 1068 - حدثني ابن ياسين : ثنا أحمد بن الفرج الحمصي : ثنا | أبو المغيرة عبد القدوس : ثنا سعيد بن بشير عن قتادة عن القاسم عن عائشة | ' أنها كانت تطيب رسول الله [ & ] قبل أن يحرم ، وقبل أن يزور البيت ' . |(@)(@@) 1069 - حدثنا الهيثم بن خلف : ثنا أحمد بن يحيى الصوفي : ثنا قبيصة : | ثنا سفيان عن جابر عن القاسم عن عائشة قالت : ' طيبت رسول الله [ & ] | لحرمه حين أحرم ، ولحله قبل أن يطوف بالبيت ' . |(@)(@@) 1070 - حدثنا الحسين بن شاكر : ثنا ابن أبي عمر : ثنا عبد الرزاق : أنبأ | معمر عن محمد بن المنكدر عن القاسم أو عمرة عن عائشة قالت : ' كنت | أطيب رسول الله [ & ] لحرمه حين أحرم ، ولحله حين أهل قبل أن يطوف | بالبيت ' . |(@)(@@) 1071 - حدثني أحمد بن هارون البرديجي الحافظ : ثنا إبراهيم بن | PageV10P770 | الحسين قال : ثنا إسحاق بن محمد الفروي : ثنا نافع بن أبي نعيم عن | عبد الرحمن بن القاسم عن أبيه عن عائشة قالت : كنت أفتل قلائد هدي | رسول الله [ & ] ، ثم لا يجتنب شيئا مما يجتنبه المحرم ' . |(@)(@@) 1072 - حدثنا معاذ : ثنا مسدد : ثنا 
ms214	 حماد بن زيد عن أيوب عن أبي | قلابة وعبد الرحمن عن القاسم ، عن عائشة أنها قالت : ' كأني أنظر أفتل | قلائد هدي رسول الله [ & ] ، ثم لا يمسك على ما يمسك الحرام ' . | آخر جزء من الأصل ، ومن جزء آخر . |(@)(@@) 1073 - حدثنا الشافعي قال : ثنا أبو عمرو يعقوب بن يوسف القزويني : | ثنا محمد بن سعيد بن سابق : ثنا أبو جعفر الرازي عن حصين عن عمرو بن | ميمون قال : رأيت عمر بن الخطاب واقفا على حذيفة بن اليمان وعثمان بن | حنيف فقال : لعلكما حملتما الأرض ما لا تطيق . قال أحدهما : لو شئت | أن أضعف عليها ، لفعلت ، وقال الآخر : لقد حملتها أمرا هي له مطيقة ، وما | فيها كبير فضل . فقال عمر : لئن عشت لأدعن أرامل العراق ، وهن | لا يحتجن إلى أحد بعدي . قال فما أتت عليه الجمعة حتى قتل . | PageV10P771 |(@)(@@) 1074 - حدثنا أبو عمرو : ثنا محمد بن سعيد : ثنا أبو جعفر عن حصين | عن سالم بن أبي الجعد عن جابر قال : ' ما أحد منا أدرك الدنيا إلا مالت به | ومال بها ، إلا ابن عمر ' . |(@)(@@) 1075 - حدثنا أبو عمرو ثنا محمد : ثنا أبو جعفر عن حصين عن عمرو | ابن ميمون قال : قال عمر بن الخطاب : إنهم يقولون استخلف علينا ، فإن | حدث بي حدث ، فالأمر في الستة الذين فارقهم النبي [ & ] وهو عنهم راض : | على بن أبي طالب ، وعثمان ، وطلحة ، والزبير ، وسعد ، وعبد الرحمن | ابن عوف . | PageV10P772 |(@)(@@) 1076 - حدثنا أبو عمرو : ثنا محمد : ثنا أبو جعفر عن حصين قال : قال | ابن عمر : إني لأخرج ، وما بي حاجة إلا أن أسلم على الناس ، ويسلموا علي . |(@)(@@) 1077 - حدثنا محمد بن غالب قال حدثني عبد الصمد بن النعمان ثنا | أبو جعفر عن حصين عن سعيد بن عبد الرحمن بن أبزى عن أبيه أن النبي | [ & ] ' كان يوتر بسبح اسم ربك الأعلى ، وقل يا أيها الكافرون ، وقل هو الله | أحد ، والمعوذتين ' . |(@)(@@) 1078 - حدثنا أبو عمرو : ثنا محمد بن سعيد : ثنا أبو جعفر عن حصين | قال : ' رأى سعيد بن جبير رجلا وهو مستلقي واضعا إحدى رجليه 
ms215	 على | الأخرى ، فرماه بالحصا ، ثم قال : أو ماعلمت أن هذا يكره ' . | PageV10P773 |(@)(@@) 1079 - حدثنا أبو عمرو : ثنا محمد بن سعيد : ثنا أبو جعفر عن | الأعمش عن زيد بن وهب عن عبد الله ، قال : ' السلام اسم من أسماء الله ، | فأفشوه ' . | PageV10P774 |(@)(@@) 1080 - حدثنا أبو عمرو : ثنا محمد : ثنا أبو جعفر عن الأعمش عن | حبيب بن أبي ثابت عن أبي بكر بن أبي عبد الرحمن ' أن موسى سأل | ربه ، فقال : يا رب ارزقني عملا يكون شكرا لما أنعمت . فقيل له : يا موسى | قل لا إله إلا الله وحده لا شريك له ، له الملك ، وله الحمد ، وهو على كل | شيء قدير . فأراد موسى ( عليه السلام ) أن يؤمر بعمل هو أنهك لبدنه | فقال : يا رب ارزقني عملا يكون شكرا لما أنعمت علي . فقيل له : يا | موسى قل لا إله إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على | كل شيء قدير . فأراد موسى أن يؤمر بعمل هو أنهك لبدنه من ذلك حتى | قالها ثلاث مرات ، فقيل : يا موسى لو أن سموات السبع ، والأرضين | السبع كن حلقة واحدة ، لفصمتها لا إله إلا الله ، ولو أن السموات السبع ، | ( والأرضين السبع ) ، وما فيهن كن في كفة ميزان ، ووضع لا إله إلا الله ، | لرجح لا إله إلا الله . فلما رأى ذلك موسى ( عليه السلام ) انتهى ' . | PageV10P775 |(@)(@@) 1081 - حدثنا أبو عمرو : ثنا محمد : ثنا أبو جعفر عن زيد بن أسلم | عن أبي صالح عن أبي هريرة قال : ' ينزل عيسى ابن مريم ( عليه السلام ) | إماما مقسطا ، وحكما عدلا ، فيكسر الصليب ويقتل الخنزير ، وتضع الحرب | أوزارها ، وتبتز قريش الإمارة ، وتضع كل ذات حمل حملها ، حتى إن الرجل | ليضع قدمه على رأس الحية ، فما يضره ، وحتى إن الذئب ليكون في الغنم | ككلبها ، وحتى إن السبع ليكون في الخيل كراعيها ، وحتى إن الصبي ليدخل | يده في في الذئب ، فما يضره ، وحتى إن الملأ ليأكلون التفاحة ، وحتى إن | العصابة ليأكلون من العنبة ، ثم يقولون : يا ليت إخواننا أدركوا هذا العيش ' . |(@)(@@) 1082 - حدثني أبو إسماعيل 
ms216	 الترمذي : ثنا مخلد بن مالك أبو محمد | الحراني قال : ثنا أبو عمر حفص بن ميسرة : ثنا زيد بن أسلم عن الأعمش | عن أبي صالح عن أبي هريرة قال : قال النبي [ & ] : يقول الله : ' أنا عند ظن | عبدي بي ، وأنا معه حين يذكرني ، والله لله أفرح بتوبة أحدكم من الرجل يجد ضالته | PageV10P776 | بالفلاة ، ومن تقرب مني شبرا ، تقربت منه ذراعا ، وإن جاء يمشي ، أتيته أهرول ' . |(@)(@@) 1083 - حدثنا الشافعي في جمادي الأولى سنة أربع وخمسين وثلاثمائة | قال :(@)(@@) حدثنا إبراهيم يعني ابن إسحاق الحربي : ثنا عبد الله بن عمر قال : ثنا | محمد بن يعلى : حدثنا الحسن بن دينار عن علي بن زيد قال : جاء أعرابي | إلى طلحة ، فسأله ، وتقرب إليه برحم ، فقال : إن هذه الرحم ما سألني بها | أحد قبلك ، إن لي أرضا قد أعطاني بها عثمان ثلاثمائة ألف ، فإن شئت ، | فاغد ، فاقبضها ، وإن شئت بعتها من عثمان ، ودفعت إليك الثمن . فقال | الأعرابي : الثمن ، فباعها من عثمان ، ودفع إليه الثمن . |(@)(@@) 1084 - حدثنا إبراهيم : ثنا مسدد : ثنا حماد عن هشام عن ابن سيرين أن | سعد بن عبادة كان يبسط ثوبه ويقول : ' اللهم وسع علي ، فإنه لا يسعني | إلا الكثير ' . | PageV10P777 |(@)(@@) 1085 - حدثنا إبراهيم : ثنا أبو بكر : ثنا أبو أسامة عن هشام عن أبيه أن | سعد بن عبادة كان يدعو : اللهم هب لي حمدا ومجدا ، لا مجد إلا بفعال ، | ولا فعال إلا بمال ، اللهم لا يصلحني القليل ، ولا أصلح عليه . |(@)(@@) 1086 - حدثنا إبراهيم : ثنا أبو بكر : ثنا عيسى عن الأوزاعي عن يحيى | قال : ' كان للنبي [ & ] من سعد كل يوم جفنة تدور معه حيث دار ، وكان | يقول : اللهم ارزقني مالا ، فلا يصلح الفعال إلا بمال ' . |(@)(@@) 1087 - حدثنا إبراهيم : ثنا أبو بكر : ثنا أبو أسامة : ثنا هشام عن محمد | قال : أدرك سعد بن عبادة وهو ينادي على أطمه من أحب شحما ولحما | فليأت سعد بن عبادة ، ثم أدركت ابنه مثل ذلك ، وارتحل قيس بن سعد نحو | المدينة ، ومعه أصحابه ، فجعل ينحر كل يوم جزورا حتى بلغ صرار . | PageV10P778 |(@)(@@) 1088 - حدثنا 
ms217	 إسحاق بن الأحمر بن جعفر القطان إمام مسجد | بتنيس ثنا فضل بن سهل الأعرج : ثنا محمد بن جعفر المدائني : | ثنا عبد الواحد بن سليمان عن حميد عن أنس قال : قال رسول الله [ & ] | ' أنا زعيم ببيت في عرف الجنة ، وببيت في فناء الجنة ، وببيت في وسط الجنة لمن | ترك الكذب وإن كان مازحا ، ولمن ترك المراء وإن كان محقا ، ولمن حسن | خلقه ' . | PageV10P779 |(@)(@@) 1089 - حدثنا إسحاق ( بن أحمد بتنيس ) قال : ثنا أبو الطيب عمر بن | PageV10P780 | المهلب : ثنا أبو الفضل الربيع بن محمد اللاذقي : ثنا بشر بن إبراهيم أبو سعيد | القرشي : ثنا الأوزاعي عن الزهري عن سعيد بن المسيب عن عائشة عن | رسول الله [ & ] قال : ' ما أذنب عبد ذنبا فساءه ، إلا غفر الله له ، وإن لم يستغفر منه ' . |(@)(@@) 1090 - حدثنا وقاد بن الحسين الكلابي بالرقة : ثنا أيوب بن محمد الوزان | قال : ثنا فهر بن بشر الداماني السلمي : حدثنا أبو الأزعر عن يحيى بن | عبيد الله قال : سمعت أبي يقول : سمعت أبا هريرة يقول : قال رسول الله | [ & ] : ' ما منكم من أحد يدخل الجنة بعمله ' قالوا : ' ولا أنت يا رسول الله ؟ | قال : ' ولا أنا إلا أن يتغمدني الله ( تعالى ) منه برحمة ، أو يسعني منه معافاة ' . | PageV10P781 | وذكر غيره مثله إلا أنه قال : ووضع يده على رأسه . |(@)(@@) 1091 - حدثنا إبراهيم بن إسحاق : ثنا محمد بن سهل : ثنا ابن أبي مريم | قال أنبأ يحيى بن أيوب قال : حدثني جعفر بن ربيعة وعمرو بن الحارث أن | بكر بن سوادة حدثهما : أن أبا حمزة الحميري حدثه : سمع جابر بن عبد الله | أن رسول الله [ & ] بعثهم بعثا عليهم قيس بن سعد بن عبادة ، فجهدوا ، فنحر | لهم قيس تسع ركائب . قال عمرو في حديثه : فقال رسول الله [ & ] : ' إن | الجود لمن شيمة أهل ذلك البيت ' . قال إبراهيم : لم يكن قيس بن سعد أمير | هذا الجيش ، إنما كان أبو عبيدة وقيس معه ، كذا أخبرني محمد بن صالح | PageV10P782 | عن محمد بن عمر ، قال : وحدثني داود بن قيس وإبراهيم بن محمد | الأنصاري وخارجة بن الحارث قالوا 
ms218	 : بعث رسول الله [ & ] أبا عبيدة في | سرية فيها المهاجرون والأنصار ، وهم ثلاثمائة رجل إلى ساحل البحر إلى | حي من جهينة ، فأصابهم جوع شديد ، فقال قيس بن سعد : من يشتري مني | تمرا بجزر ، يوفيني الجزر ها هنا ، وأوفيه التمر بالمدينة ؟ فجعل عمر يقول : | واعجباه لهذا الغلام لا مال له يدين فيما لغيره ؟ فوجد رجلا من جهينة ، | فقال قيس : بعني جزورا أوفيك وسقة من تمر بالمدينة فقال الجهني : والله | ما أعرفك فمن أنت ؟ قال : أنا ابن سعد بن عبادة بن دليم . قال الجهني : ما | أعرفني بنسبك وذكر كلاما ، فابتاع منه خمس جزائر ، كل جزور بوسق من | تمر يشرط عليه البدوي تمر ذخيرة مصلبة من تمر آل دليم . يقول قيس : | نعم ، قال : فأشهد لي . فأشهد له نفرا من الأنصار ومعهم نفر من المهاجرين ، | قال قيس : أشهد من تحب ، وكان فيمن أشهد عمر بن الخطاب فقال عمر : | ما أشهد ، هذا يدين ، ولا مال له ، إنما المال لأبيه ، قال الجهني : والله ما | كان سعد ليخني بابنه في وسقة من تمر ، وأرى وجها حسنا ، وفعالا شريفا . | PageV10P783 | فكان بين عمر وقيس كلام حتى أغلظ لقيس وأخذ الجزر ، فنحرها لهم | في مواطن ثلاثة كل يوم جزورا ، فلما كان اليوم الرابع نهاه أميره ، قال : | أتريد أن تخفر ذمتك ولا مال لك ؟ !(@)(@@) قال محمد : فحدثني محمد بن يحيى بن سهل عن أبيه عن رافع بن | خديج قال : ' أقبل أبو عبيدة ومعه عمر فقال : عزمت عليك أن لا تنحر ، | أتريد أن تخفر ذمتك ؟ قال قيس : يا أبا عبيدة أترى أبا ثابت يقضي ديون | الناس ، ويحمل الكل ، ويطعم في المجاعة لا يقضي عني وسقة من تمر | لقوم مجاهدين في سبيل الله ؟ فكاد أبو عبيدة أن يلين له ، وجعل عمر | يقول : اعزم . فعزم عليه ، وأبى أن ينحر ، وبقيت جزوران ، فقدم بها | قيس المدينة ظهرا يتعاقبون عليها . وبلغ سعدا ما أصاب القوم من المجاعة ، | فقال : إن يك قيس كما أعرف ، فسينحر للقوم فلما قدم قيس لقيه سعد ، | فقال : ما صنعت في مجاعة القوم قال 
ms219	 : نحرت . قال : أصبت . قال : ثم | ماذا ؟ قال : نحرت . قال : أصبت . قال : ثم ماذا ؟ قال : نحرت . قال : | أصبت . قال : ثم ماذا قال : نهيت . قال : من نهاك ؟ قال : أبو عبيدة أميري ، | قال : ولم ؟ قال : زعم أنه لا مال لي ، وإنما المال لأبيك . فقلت : أبي يقضي | PageV10P784 | عن الأباعد ، ويحمل الكل ، ويطعم في المجاعة ، ولا يصنع هذا بي ، قال : | فلك أربع حوائط أدناها حائط منه تجد خمسين وسقا ، قال : وقدم البدوي | مع قيس ، فأوفاه وسقه ، وحمله ، وكساه . فبلغ ذلك النبي [ & ] فعل قيس ، | فقال : ' إنه في قلب جود ' قال محمد : فحدثني عبد الله بن الحجازي | عن عمر بن عثمان بن شجاع قال : لما قدم الأعرابي قال : والله ما مثل | ابنك ضيعت ، ولا تركت بغير مال ، فابنك سيد من سادات قومك نهاني | الأمير أن أبيعه ، فقلت : لم ؟ قال : لا مال له . فلما انتسب ، عرفته وتقدمت | لما أعرف أنك تسمو إلى معالي الأخلاق وجسيمها ، وأنك غير مذمر لا | معرفة لديك ، فأعطى ابنه يومئذ أموالا عظاما . قال إبراهيم : عبد الله بن | خليفة شيخ كوفي روى عنه أبو إسحاق حرفا عن عمر وعبد الله . |(@)(@@) 1092 - حدثنا أحمد بن الممتنع : ثنا أبو جعفر أحمد بن سعيد : | حدثنا عبد الله بن وهب : أخبرني يونس بن يزيد عن الزهري أن عبيد الله | ابن عبد الله ابن عتبة حدثه : أنه سمع أبا هريرة يقول : سمعت رسول الله | PageV10P785 | [ & ] يقول : ' كان رجل يداين الناس ، فإذا أعسر المعسر ، قال لفتاه : تجاوز عنه ، | لعل الله أن يتجاوز عنا ، فلقى الله ( عز وجل ) ، فتجاوز عنه ' . | PageV10P786 |(@)(@@) | باب المتزاورين في الله عز وجل(@)(@@) 1093 - حدثنا ابن شاكر الصائغ : ثنا عفان بن مسلم وعبيد الله بن | محمد ابن عائشة وعبد الأعلى بن حماد ، وحدثنا أبو غالب علي بن | أحمد ابن النضر : ثنا ابن عائشة ، وثنا إسماعيل بن إسحاق : ثنا حجاج قالوا : ثنا | حماد بن سلمة عن ثابت عن أبي رافع عن أبي هريرة قال : قال رسول الله | [ & ] : ' إن رجلا زار أخا له في قرية أخرى ، فأرصد الله على مدرجته ملكا ، فلما 
ms220	 | أتى عليه الملك قال : أين تريد ؟ قال : أزور أخا لي في هذه القرية . قال : هل له عليك | من نعمة ؟ قال : لا ، إلا أني أحببته في الله . قال : فإني رسول الله إليك أن الله قد | أحبك كما أحببته له ' ، قال : جعفر : هذا حديث عفان ، وقال ابن عائشة | وعبد الأعلى : كما أحببته فيه . |(@)(@@) 1094 - حدثنا علي بن بري بن زنجويه بن ماهان الدينوري : ثنا سلمة | ابن شبيب : ثنا محمد بن كثير الكوفي : ثنا ليث : ثنا عمرو بن مرة عن البراء | PageV10P787 | ابن عازب قال : سمعت رسول الله [ & ] يقول : ' إن أفضل عرى الإيمان الحب | في الله ، والبغض في الله ' . |(@)(@@) 1095 - حدثنا علي بن بري أيضا : ثنا سلمة بن شبيب : ثنا محمد بن | جعفر : ثنا معمر بن سليمان عن فضيل بن غزوان عن محمد بن عطية عن | أنس بن مالك قال : قال رسول الله [ & ] : ' إن الله تعالى ينادي يوم القيامة : أين | جيراني ؟ أين جيراني ؟ فتقول الملائكة : ربنا ، ومن ينبغي له أن يجاورك ؟ فيقول : | أين عمار المساجد ؟ ' . | PageV10P788 |(@)(@@) 1096 - حدثنا أحمد بن عيسى : ثنا أبو محمد الحراني هاشم بن | القاسم : ثنا عيسى بن يونس عن حميد بن عطاء عن عبد الله بن الحارث | عن عبد الله ابن مسعود قال : قال رسول الله [ & ] : ' المتحابون في الله في | الجنة على عمود من ياقوتة حمراء ، على رأس ذلك العمود سبعون ألف غرفة | عليها المتحابون في الله يشرفون على أهل الجنة ، فإذا طلع أحدهم على أهل | الجنة ، ملأ حسنه بيوت أهل الجنة كما يملأ ضوء الشمس بيوت أهل الدنيا . قال : | فيخرج إليهم أهل الجنة ينظرون إليهم ، فإذا وجوههم كالقمر ليلة البدر ، عليهم | ثياب خضر ، مكتوب في وجوههم : هؤلاء المتحابون في الله عز وجل ' . |(@)(@@) 1097 - حدثنا جعفر بن محمد بن شاكر الصائغ : ثنا عفان : ثنا | حماد بن سلمة : ثنا أبو سنان عن عثمان بن أبي سودة عن أبي هريرة قال : | قال رسول الله [ & ] : ' إذا عاد الرجل أخاه ، أو زاره ، قال الله تعالى ' طبت ، وطاب | ممشاك ، وتبوأت من الجنة منزلا ' . | PageV10P789 |(@)(@@) 1098 - حدثنا ابن 