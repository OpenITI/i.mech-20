ms10309	 [89] .(@)(@@)(@@)(@@) | 303 - (@)(@@) طريف بن عيسى جزري [90] .(@)(@@)(@@)(@@) | 304 - (@)(@@) طريف بن عبيد الموصلي، حدث عنه الشافعي أبو بكر [91] .(@)(@@)(@@)(@@) | 305 - (@)(@@) طريف بن شهاب السعدي، أبو سفيان، ضعيف.(@)(@@) حرف العين(@)(@@)(@@)(@@) | 306 - (@)(@@) عبد الله بن زياد بن سمعان، مدني متروك، وسعيد بن سمعان ثقة تابعي مدني.(@)(@@)(@@)(@@) | 307 - (@)(@@) عبد الله بن سعيد بن أبي سعيد المقبري، أبو عباد مدني، وأخوه يحيى متروك.(@)(@@)(@@)(@@) | 308 - (@)(@@) عبد الله بن مسلم بن هرمز، مكي، عن مجاهد، وعطاء [92] .(@)(@@) PageV29P050(@)(@@)(@@)(@@) | 309 - (@)(@@) عبد الله بن واقد، أبو قتادة الحراني [93] .(@)(@@)(@@)(@@) | 310 - (@)(@@) عبد الله بن سلمة الأفطس، عن الأعمش، وهشام [94] .(@)(@@)(@@)(@@) | 311 - (@)(@@) عبد الله بن جعفر بن نجيح المديني. والد علي كثير المناكير.(@)(@@)(@@)(@@) | 312 - (@)(@@) عبد الله بن ميسرة الكوفي عن الشعبي، وإبراهيم بن أبي حرة يكنيه هشيم: أبا إسحاق، وأبو عبد الجليل، وغيره يكنيه: أبا ليلى [95] .(@)(@@)(@@)(@@) | 313 - (@)(@@) عبد الله بن عامر الأسلمي، مدني ضعيف.(@)(@@)(@@)(@@) | 314 - (@)(@@) عبد الله بن بشير الشامي، عن عبد الله بن بسر وأبي كبشة صحابيان، وقيل: أن اسم أبي كبشة عمر بن سعيد.(@)(@@)(@@)(@@) | 315 - (@)(@@) عبد الله بن حكيم أبو بكر الداهري، أصله بواسط عن هشام بن عروة [96] .(@)(@@)(@@)(@@) | 316 - (@)(@@) عبد الله بن محرر بصري سكن الشام، عن الزهري، وقتادة [97] .(@)(@@)(@@)(@@) | 317 - (@)(@@) عبد الله بن عبد القدوس، كوفي، سكن الري، عن الأعمش [98] .(@)(@@)(@@)(@@) | 318 - (@)(@@) عبد الله بن عمرو بن حسان الواقعي بصري، يكذب عن شريك.(@)(@@)(@@)(@@) | 319 - (@)(@@) عبد الله بن لهيعة بن عقبة، وربما نسب إلى جده يعتبر بما يروي عنه العبادلة ابن المبارك، والمقرئ، وابن وهب.(@)(@@)(@@)(@@) | 320 - (@)(@@) عبد الله بن مسور، أبو جعفر المدايني، يرسل عن النبي صلى الله عليه وسلم، وعن ابن مسعود، وابن عباس.(@)(@@)(@@)(@@) | 321 - (@)(@@) عبد الله بن محمد بن سنان الدوحي، متروك حدث بالدينور، وولي قضاءها.(@)(@@)(@@)(@@) | 322 - (@)(@@) عبد الله بن خراش كوفي عن العوام بن حوشب [99] .(@)(@@)(@@)(@@) | 323 - (@)(@@) عبد الله بن حمدان بن وهب 