ms141	 .(@)(@@)(@@)(@@) $ ( 1295 ) قال النبي :(@)(@@) | 30 ( إذا خطب أحدكم المرأة وهو يختضب بالسواد فليعلمها أنه يختضب ) )(@)(@@) ( فر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1296 ) قال النبي :(@)(@@) | 30 ( إذا خفت سلطانا أو غيره فقل : لا إلاه إلا الله الحليم الكريم ، سبحان الله رب السماوات السبع ورب العرش العظيم ، لا إلاه إلا أنت عز جارك وجل ثناؤك ) )(@)(@@) ( ابن السنى ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1297 ) قال النبي :(@)(@@) | 30 ( إذا خفضت فأشمي ولا تنهكي فإنه أحسن للوجه وأرضى للزوج ) )(@)(@@) ( خط ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1298 ) قال النبي :(@)(@@) | 30 ( إذا خفضت فأشمي ولا تنهكي فإنه أسرى للوجه وأحظى عند الزوج ) )(@)(@@) ( طس ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1299 ) قال النبي :(@)(@@) | 30 ( إذا خفيت الخطيئة لا تضر إلا صاحبها ، وإذا ظهرت فلم تغير ضرت العامة ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1300 ) قال النبي :(@)(@@) | 30 ( إذا خلص المؤمنون من النار حبسوا بقنطرة بين الجنة والنار فيتقاصون مظالم كانت بينهم في الدنيا حتى إذا نقوا وهذبوا أذن لهم بدخول الجنة ، فوالذي نفس محمد بيده لأحدهم بمسكنه في الجنة أدل منه بمسكنه كان في الدنيا ) )(@)(@@) ( حم خ ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV01P200(@)(@@)(@@)(@@) $ ( 1301 ) قال النبي :(@)(@@) | 30 ( إذا دبغ الإهاب فقد طهر ) )(@)(@@) ( م د ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1302 ) قال النبي :(@)(@@) | 30 ( إذا دبغ جلد الميتة فحسبه فلينتفع به ) )(@)(@@) ( عب ) عن عطاء مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1303 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فلا يجلس حتى يركع ركعتين ، وإذا دخل أحدكم بيته فلا يجلس حتى يركع ركعتين فإن الله جاعل له من ركعتيه في بيته أجرا ) )(@)(@@) ( هق عد هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1304 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فلا يجلس حتى يصلي ركعتين ) )(@)(@@) ( حم ق 4 ) عن أبي قتادة ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1305 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فليسلم على النبي وليقل : اللهم افتح لي أبواب رحمتك ، وإذا خرج فليسلم على 
ms142	 النبي وليقل : اللهم اعصمني من الشيطان ) )(@)(@@) ( ن ه حب ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1306 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فليسلم على النبي وليقل : اللهم افتح لي أبواب رحمتك ، وإذا خرج فليسلم على النبي وليقل : اللهم إني أسألك من فضلك ) )(@)(@@) ( د ) عن أبي حميد أو أبي أسيد ( ه ) عن أبي حميد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1307 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فليصل على النبي وليقل : اللهم افتح لي أبواب رحمتك ، وإذا خرج فليسلم على النبي وليقل : اللهم إني أسألك من فضلك ) )(@)(@@) ( حم م ) عن أبي حميد وأبي أسيد ( حم ن حب هق ) عن أبي حميد وأبي أسيد معا رضي الله عنهما ( ز ) .(@)(@@) PageV01P201(@)(@@)(@@)(@@) $ ( 1308 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم إلى القوم فاوسع له فليجلس فإنما هي كرامة من الله أكرمه بها أخوه المسلم فإن لم يوسع له فلينظر أوسعها مكانا فليجلس فيه ) )(@)(@@) ( الحارث ) عن أبي شيبة الخدري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1309 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم على أخيه المسلم فأراد أن يفطر فليفطر إلا أن يكون صومه رمضان أو قضاء رمضان أو نذرا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1310 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم على أخيه المسلم فأطعمه من طعامه فليأكل ولا يسأل عنه ، وإن سقاه من شرابه فليشرب ولا يسأل عنه ) )(@)(@@) ( طس ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1311 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم على أخيه فهو أمير عليه حتى يخرج من عنده ) )(@)(@@) ( عد ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1312 ) قال النبي :(@)(@@) | 30 ( إذا دخل البصر فلا إذن ) )(@)(@@) ( د هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1313 ) قال النبي :(@)(@@) | 30 ( إذا دخل الرجل الجنة سأل عن أبويه وزوجته ولده فيقال : إنهم لم يبلغوا درجتك وعملك فيقول : يا رب قد عملت لي ولهم فيؤمر بالحاقهم به ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1314 ) قال النبي :(@)(@@) | 30 ( إذا دخل الرجل بيته فذكر اسم الله 
ms143	 تعالى حين يدخل وحين يطعم قال الشيطان : لا مبيت لكم ولا عشاء هاهنا ، وإن دخل فلم يذكر اسم الله عند دخوله قال الشيطان : أدركتم المبيت ، وإن لم يذكر اسم الله عند مطعمه قال : أدركتم المبيت والعشاء ) )(@)(@@) ( حم م د ه ) عن جابر رضي الله عنه ( ز ) .(@)(@@) PageV01P202(@)(@@)(@@)(@@) $ ( 1315 ) قال النبي :(@)(@@) | 30 ( إذا دخل الضيف على القوم دخل برزقه ، وإذا خرج خرج بمغفرة ذنوبهم ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1316 ) قال النبي :(@)(@@) | 30 ( إذا دخل العشر وأراد أحدكم أن يضحي فلا يمس من شعره ولا من بشره شيئا ) )(@)(@@) ( م ن ه ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1317 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة ، وأهل النار النار نادى مناد : يا أهل الجنة إن لكم عند الله موعدا يريد أن ينجزكموه فيقولون : وما هو ؟ ألم يثقل الله موازيننا ويبيض وجوهنا ويدخلنا الجنة وينجنا من النار ، فيكشف الحجاب فينظرون إليه ، فوالله ما أعطاهم الله شيئا أحب إليهم من النظر إليه ولا أقر لأعينهم ) )(@)(@@) ( حم ه و ابن خزيمة حب ) عن صهيب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1318 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة وأهل النار النار ، يجاء بالموت كأنه كبش أملح فيوقف بين الجنة والنار ، فيقال : يا أهل الجنة هل تعرفون هاذا ؟ فيشرئبون فينظرون ويقولون : نعم هاذا الموت وكلهم قد رآه ، ثم ينادى : يا أهل النار هل تعرفون هاذا ؟ فيشرئبون فينظرون ويقولون : نعم هاذا الموت وكلهم قد رآه فيؤمر به فيذبح ويقال : يا أهل الجنة خلود ولا موت ، ويا أهل النار خلود ولا موت ) )(@)(@@) ( حم ق ت ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1319 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة ، يقول الله تعالى : تريدون شيئا أزيدكم ؟ فيقولون : ألم تبيض وجوهنا ، ألم تدخلنا الجنة وتنجنا من النار ، فيكشف الحجاب فما أعطوا شيئا أحب إليهم من النظر إلى ربهم ) )(@)(@@) ( م ت ) عن صهيب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1320 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة يقول الله 
ms144	 عز وجل : هل PageV01P203 تشتهون شيئا فأزيدكم ؟ فيقولون : ربنا وما فوق ما أعطيتنا ؟ فيقول : رضواني أكبر ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1321 ) قال النبي :(@)(@@) | 30 ( إذا دخلت على مر يض فمره يدعو لك فإن دعاءه كدعاء الملائكة ) )(@)(@@) ( ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1322 ) قال النبي :(@)(@@) | 30 ( إذا دخلت ليلا فلا تدخل على أهلك حتى تستحد المغيبة وتمتشط الشعثة ) )(@)(@@) ( خ ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1323 ) قال النبي :(@)(@@) | 30 ( إذا دخلتم بيتا فسلموا على أهله ، فإذا خرجتم فأودعوا أهله بسلام ) )(@)(@@) ( هب ) عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 1324 ) قال النبي :(@)(@@) | 30 ( إذا دخلت مسجدا فصل مع الناس وإن كنت قد صليت ) )(@)(@@) ( ص ) عن محجن الدؤلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1325 ) قال النبي :(@)(@@) | 30 ( إذا دخلتم على المريض فنفسوا له في الأجل فإن ذالك لا يرد شيئا ، وهو يطيب نفس المريض ) )(@)(@@) ( ت ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1326 ) قال النبي :(@)(@@) | 30 ( إذا دخل شهر رمضان فتحت أبواب الجنة ، وغلقت أبواب جهنم ، وسلسلت الشياطين ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1327 ) قال النبي :(@)(@@) | 30 ( إذا دخل عليكم السائل بغير إذن فلا تطعموه ) )(@)(@@) ( ابن النجار ) عن عائشة رضي الله عنها وهو مما بيض له الديلمي .(@)(@@)(@@)(@@) $ ( 1328 ) قال النبي :(@)(@@) | 30 ( إذا دعا أحدكم أخاه فليجب عرسا كان أو نحوه ) )(@)(@@) ( حم د ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV01P204(@)(@@)(@@)(@@) $ ( 1329 ) قال النبي :(@)(@@) | 30 ( إذا دعا أحدكم فلا يقل اللهم اغفر لي إن شئت وليعزم المسألة وليعظم الرغبة فإن الله لا يعظم عليه شيء أعطاه ) )(@)(@@) ( خد ) عن أبي سعيد ( م ) عن أبي هريرة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1330 ) قال النبي :(@)(@@) | 30 ( إذا دعا أحدكم فليؤمن على دعاء نفسه ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه وبيض له الديلمي .(@)(@@)(@@)(@@) $ ( 1331 ) قال النبي :(@)(@@) | 30 ( إذا دعا أحدكم فليعزم المسألة ولا يقل اللهم إن شئت فأعطني فإن الله لا مستكره له ) )(@)(@@) ( حم ق ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1332 ) قال النبي :(@)(@@) | 30 ( إذا دعا الرجل امرأته إلى 
ms145	 فراشه فأبت فبات غضبان عليها لعنتها الملائكة حتى تصبح ) )(@)(@@) ( حم ق د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1333 ) قال النبي :(@)(@@) | 30 ( إذا دعا الرجل امرأته إلى فراشه فلتجب وإن كانت على ظهر قتب ) )(@)(@@) ( البزار ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1334 ) قال النبي :(@)(@@) | 30 ( إذا دعا الرجل زوحته لحاجته فلتأته وإن كانت على التنور ) )(@)(@@) ( ن ت ) عن طل ق بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1335 ) قال النبي :(@)(@@) | 30 ( إذا دعا العبد بدعوة فلم تستجب له كتب له حسنة ) )(@)(@@) ( قط ) عن هل ال بن يساف مرسلا .(@)(@@)(@@)(@@) $ ( 1336 ) قال النبي :(@)(@@) | 30 ( إذا دعا الغائب لغائب قال له الملك ولك مثل ذالك ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1337 ) قال النبي :(@)(@@) | 30 ( إذا دعوت الله فادع الله ببطن كفيك ولا تدع بظهورهما ، فإذا فرغت فامسح بهما وجهك ) )(@)(@@) ( ه ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P205(@)(@@)(@@)(@@) $ ( 1338 ) قال النبي :(@)(@@) | 30 ( إذا دعوتم لأحد من اليهود والنصارى فقولوا : أكثر الله مالك وولدك ) )(@)(@@) ( عد و ابن عساكر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1339 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى الوليمة فليأتها ) )(@)(@@) ( مالك حم ق د ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1340 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى طعام فليجب ، فإن شاء طعم وإن شاء لم يطعم ) )(@)(@@) ( م د ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1341 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى طعام فليجب ، فإن كان مفطرا فليأكل ، وإن كان صائما فليدع بالبركة ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1342 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى طعام فليجب ، فإن كان مفطرا فليأكل ، وإن كان صائما فليصل ) )(@)(@@) ( حم م د ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1343 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى طعام وهو صائم فليقل إني صائم ) )(@)(@@) ( م د ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1344 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى وليمة عرس فليجب ) )(@)(@@) ( م ه ) عن 