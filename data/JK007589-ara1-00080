ms61	 المنكرين وعظ المحقي % % ن وإن لم يلقبوا شعراء % % 728(@)(@@) % وبرغمي هناك تسمع أذنا % % ي ولكن من يضبط الدهماء % % 729(@)(@@) % والتكاليف لاتحد اتساعا % وكثير من ينصر البعداء % % 730(@)(@@) % كم رأيت المكلفين جنودا % ينصرون الأباعد الغرباء % % PageV01P229 731(@)(@@) % ولحى الله مسمعا لي فيكم % % يتوخى بمسخط إرضاء % % 732(@)(@@) % ولما سر جائعا رفد كف % أطعمته من شلوه أعضاء % % 733(@)(@@) % لو سواي استمال مال إليه % % ولألقى لناره حلفاء % % 734(@)(@@) % لكن الله شاهد أن نفسي % % تمنح السيف عند ذاك انتضاء % % 735(@)(@@) % لي عين هواي فيكم يريها % % من جلاها بلومكم إقذاء % % 736(@)(@@) % وجميل المقال فيكم وحظي % % من جداكم مما أراه سواء % % 737(@)(@@) % وأرى حر أن تلاموا حريقا % وأرى حر ظلمكم رمضاء % % 738(@)(@@) % فاظلموا جهدكم فلن تستطيعوا % % أبدا أن توغروا الأحشاء % % 739(@)(@@) % رسخ الحب في عظاميوجارى % % في عروقي قبل ذاك الغذاء % % 740(@)(@@) % ومن الجور أن تجازى يد بي % % ضاء من مخلص يدا سوداء % % PageV01P230 741(@)(@@) % هنكم أعنى فلا أسيء عتابا % كم أمنى فلا أسيء اقتضاء % % 742(@)(@@) % فاستوائي إذا رأيت استواء % والتوائي إذا رأيت التواء % % 743(@)(@@) % أين عني سعادة من سعيد % جدكم لا برحتم سعداء % % 744(@)(@@) % أين عني سلامة من سليما % % ن تقيني بدرعها أن أساء % 745(@)(@@) % أين عني قسم الوزير أبي القا % % سم أحرار ماله أنصباء % % 746(@)(@@) % أين عني إحسان صنوين قدا ال % % حسن قدا تسميا واكتناء % % 747(@)(@@) % ما توهمت أن حقي عليكم % % آل وهب يجشم استبطاء % % 748(@)(@@) % ياابن من لم يزل يخوض الوزارا % % ت ومن قبل يخلف الوزراء % % 749(@)(@@) % قد مضى أكثر الشتاءوجاء الصي % % ف يعدو فلا تزده التظاء % % 750(@)(@@) % يا عليما بما أكابد فيه % % لاتعاونه إن فيه اكتفاء % % PageV01P231 751(@)(@@) % أنا راج جميل ردعك إيا % % ه فلا تجعلنه إغراء % % 752(@)(@@) % لا تعن ناره على الشي والطب % % خ كفى طابخا بها شواء % % 753(@)(@@) % الأمان الأمان منك ومنه % % جنباني لظاكما الكواء % % 754(@)(@@) % بل إذا ما عدا فأعد عليه % % لا تكونن مثله عداء % % 755(@)(@@) % لا تعاقب بما التواء أخوه % % أعقابا تريد بي أم تواء % % 756(@)(@@) % إن تأرى علي عتبك والصي % % ف وحاشاي 
ms62	 كان ذاك الجلاء % % 757(@)(@@) % لا تدعني سدى فترقي مني % % حية لا تطاوع الرقاء % % 758(@)(@@) % لا عدمتم بحلمكم آل وهب % من ولي تسحبا واجتراء % % PageV01P232 البحر : - 1(@)(@@) % يا ذائق الموتى لتعلم هل بقوا % % بعد التقادم منهم بدواء % 2(@)(@@) % بينت عن رعة وصدق أمانة % لولا اتهامك خالق الأشياء % 3(@)(@@) % أحسبت أن الله ليس بقادر % % أن يجعل الأموات كالأحياء % % 4(@)(@@) % وظننت ما شاهدت من آياته % % بلطيفة من حيلة الحكماء % % PageV01P233 البحر : - 1(@)(@@) % ما أستزيد لقاسم % من ربه غير البقاء % % 2(@)(@@) % وكذاك لست أريد من % % ه سوى البقاء مع اللقاء % 3(@)(@@) % حسبي بذاك سعادة % فيها الأمان من الشقاء % % 4(@)(@@) % كفلت بكبت للعدا % % ومسرة للأصدقاء % % 5(@)(@@) % والله بعد يزيده % % أعلى منالة ذي ارتقاء % % 6(@)(@@) % ويزيدني من غيثه % % وغياثه الهزم السقاء % % 7(@)(@@) % ملك كأن خلاله % % خلقت له بعد انتقاء % % 8(@)(@@) % عافيه علق صيانة % وثراؤه ترس اتقاء % % 9(@)(@@) % يلقاك نشر ثنائه % % ونسيمه قبل اللقاء % % 10(@)(@@) % كم قد وردت سماحه % % فسقيت منه بلا استقاء % % PageV01P234 11(@)(@@) % كم زارني معروفه % % من قبل وعد بالتقاء % % 12(@)(@@) % هل من وفاء كفؤه % % فيفي حقيقا بالوفاء % % PageV01P235 البحر : - 1(@)(@@) % ليت شعري من ناكه بهجائي % % من هجاني له من الشعراء % % 2(@)(@@) % من عذيري يا قوم من أشبه الأم % مة بابن الكراعة القطعاء % % 3(@)(@@) % يشتري باسته هجائي لقد قا % % مت عليه عداوتي بالغلاء % % 4(@)(@@) % مهره كفء عقره بل كثير % % ذلك المهر لاسته البخراء % % PageV01P236 البحر : - 1(@)(@@) % فتى لا يرى تأخير غوث وليه % % ولايقتضيه الشكربالعرض الأدنى % % 2(@)(@@) % ولكنه يعطي البلاغ إلى الغنى % % إلى أن يعين الوجد همته الكبرى % % 3(@)(@@) % هنالك يدعو الشاكرين لشكره % % بغير لسان بل بألسنة الجدوى % % 4(@)(@@) % ولا عيب فيه غير أني صحبته % % وليا فأعشى ناظري خشعة المولى % % 5(@)(@@) % تعبدني بالعرف حتى استذلني % % على أن في نفسي على غيره طغوى % % PageV01P237 البحر : - 1(@)(@@) % ألاليت شعري هل تؤخر حاجتي % % لأولى بشكر منك أو بثناء % % 2(@)(@@) % غرست يدا حتى إذا آن حملها % % شكت منك إغفالا وطول جفاء % % 3(@)(@@) % ثنائي لاتسبق إليه فإنه % % خلود لما تبنيوطول بقاء % % 4(@)(@@) % وتمم يدا أسديتها ينم شكرها 
ms63	 % % غداة غد في الناس أي نماء % % 5(@)(@@) % لعمري لقد أعطاك محمود حمده % % أمير غدا من سادة الأمراء % % 6(@)(@@) % وياحسن ذاك الحمد إن أنت زنته % بحمد امرىء من سادة الشعراء % % PageV01P238 البحر : - 1(@)(@@) % ياخالد بن الخالدات مخازيا % مادام فوق الأرض ظل سماء % % 2(@)(@@) % لله درك أي صاحب حيلة % أصبحت فيها واحد الحكماء % % 3(@)(@@) % لما غدا العار الذي سربلته % % أحدوثة الركبان والأملاء % % 4(@)(@@) % عرضت للشعراء عرضك عامدا % % كيما يقالتكذب الشعراء % % 5(@)(@@) % لايعجبنك ماصنعت فإنما % % داويت داءكيا شقيبداء % % PageV01P239 البحر : - 1(@)(@@) % أخالد يابن الخالدات مخازيا % % ماذا دعاك إلى اكتساب هجائي % % 2(@)(@@) % لله در أبيك أية حيلة % % لو أنها جازت على الفهماء % % 3(@)(@@) % لما بدالك أن خزيك قد غدا % % أحدوثة الركبان والأملاء % % 4(@)(@@) % عرضت للشعراء عرضك عامدا % % كيما يقالتكذب الشعراء % % 5(@)(@@) % بل كنت فيما حدت عنه ولم تئل % % كالمستجير لظى من الرمضاء % % 6(@)(@@) % يا شاعرا يهجو نسية خالد % عنك الهجاءكفاك بالأسماء % % 7(@)(@@) % أسماؤهن هجاؤهنومن يقل % % أفعى يبن لاشك عن صماء % % 8(@)(@@) % لاتحسبنك في هجائك تفتري % % مالم يجئن به من الفحشاء % % PageV01P240 البحر : - 1(@)(@@) % يظلم الناس في القيادة أفرى % % أنت منه باللوم أولى وأحرى % % 2(@)(@@) % كان للكركدن قرن فأضحى % % قرنه اليوم عند قرنك مدرى % % 3(@)(@@) % من يكن قرنه كقرنك هذا % % فليكن بابه كإيوان كسرى % % PageV01P241 البحر : - 1(@)(@@) % يا ابن بورانجعلت فدائي % % عشت في غبطة وفي نعماء % % 2(@)(@@) % بخبخ بخبخ لأمك ما أس % ور هماتها إلى العلياء % % 3(@)(@@) % ناقضت مريم العفاف فلما % % قاومتها سمت إلى حواء % % 4(@)(@@) % فانتحت في الزنا تكاثر حوا % % ء عديد البنات والأبناء % % 5(@)(@@) % كيف أهجو امرأ كريما لئيما % % واحد الأم خلفة الآباء % % 6(@)(@@) % كيف أهجو مذبذبا بين شتى % % لاإلى هؤلاء ولا هؤلاء % % 7(@)(@@) % كيف أهجو من فيه مجتمع الأن % % ساب طراوملتقى الأحياء % % 8(@)(@@) % إنما أستطيب كدك في شع % % رك يا ابن الخبازة البظراء % % 9(@)(@@) % فكأني أراك في عكر الفك % % ر توالي تنفس الصعداء % % 10(@)(@@) % مجلبا مغبرا كأنك في شي % % ء ألا ضيعة لذاك العناء % % PageV01P242 11(@)(@@) % وكأني أراك تهتفإيه % % تزجر الشعر حضرة الغوغاء % % 12(@)(@@) % مستميلا أسماعهم لهجائي 
ms64	 % % بنباح ملحن بعواء % % 13(@)(@@) % قد أصاخوا وأنت تيعر كالتي % % س وهم ضامرون مثل الشاء % % 14(@)(@@) % فاهجنيإنما هجاؤك عندي % % ضحكات تزيد في السراء % % 15(@)(@@) % أنا في غبطة بها وسرور % % ملء صدريوأنت في برحاء % % 16(@)(@@) % ومحال أن يسعد السعداء ال % % دهر إلا بشقوة الأشقياء % % 17(@)(@@) % أنا هاجيك ماسكتومعفي % % ك إذا ما هجوتني من هجائي % % 18(@)(@@) % ليس ينجيك من يدي سوى ذا % % ك ولو كنت في بروج السماء % % 19(@)(@@) % ويمينا لألعبن بأشلا % % ئك بين الإشواء والإصماء % % 20(@)(@@) % هاجيامادحاومتخذا إيا % % ك ملهى وعرضة استهزاء % % PageV01P243 البحر : - 1(@)(@@) % هاجرني ظلما أبو حفصل % فأصبحت أعداؤنا جذلى % % 2(@)(@@) % مازحته في بعض أيامه % % فصار في النفخة كالحبلى % % 3(@)(@@) % مالي لم أغضب على عرسه % % إذ سلحت في لحيتي السفلى % % 4(@)(@@) % طعنتها أسفل وجعائها % % فانبجست من ثقبها الأعلى % % PageV01P244 البحر : - 1(@)(@@) % ألاأيهاالمطري العلاء بن صاعد % وشاكره في نية وثناء % % 2(@)(@@) % شكرت امرأ ينمي على الشكر عرفه % ويأبى على الكفران غير نماء % % 3(@)(@@) % فتى نال غايات الكهول وجازها % % على جدة من سنهوفتاء % % 4(@)(@@) % كما بهر البدر النجوم لأربع % % وعشر فأمست غير ذات ضياء % % 5(@)(@@) % وحسب أبي عيسى العلاء بأنه % % يعد بديئا سيد الحكماء % % 6(@)(@@) % وأن أباه الخير طال بقاؤه % % يعد بديئا سيد الوزراء % % 7(@)(@@) % وأن الأمير المستنيم إليهما % % يعد بديئا سيد الأمراء % % 8(@)(@@) % وأن الخطيب الصادق القول فيهما % % يعد بديئا سيد الخطباء % % 9(@)(@@) % خطيبعصاه الرمح والسيف لم يزل % % وآباؤه يبلون خير بلاء % % 10(@)(@@) % كنوز غنى للمقترينوإن دعوا % % لنائرة كانوا كنوز غناء % % PageV01P245 11(@)(@@) % وهذي أمور وفقت لابن صاعد % % أمارات جد صاعدوبقاء % % 12(@)(@@) % ومازال ممدوحا بحق معظما % % على ألسن الأشراف والعظماء % % 13(@)(@@) % وما يضع المرء الشريف امتداحه % علاءولايحذيه غير علاء % 14(@)(@@) % وهل يضع الطود المنيف اعترافه % % لناصبه بالعدل تحت سماء % % PageV01P246 البحر : - 1(@)(@@) % ليس كالسكر دواء % % لغناء كالدواء % % 2(@)(@@) % فاسقني عشرون رطلا % لا تشبهن بماء % % 3(@)(@@) % فلعل السكر يكفي % % ني أذى هذا العواء % % 4(@)(@@) % من رأى منتحيا غي % % ري على سوء الغناء % % PageV01P247 البحر : - 1(@)(@@) % قل لعبدالقوي أنت قوي % % فاتق اللهويكفي الضعفاء % 2(@)(@@) % نحن جموأنت أقرن والل 
ms65	 % ه حسيب القرناء للجماء % % 3(@)(@@) % لو علمت الخفي من كل علم % % جامعا بينه وبين البغاء % % 4(@)(@@) % أعجب الناس ماوعيت وقالوا % % عسل طيب خبيث الوعاء % % PageV01P248 البحر : - 1(@)(@@) % مخففة مثقلة تراها % % كأن لم يغذ نصفيها غذاء % 2(@)(@@) % إذا الإغباب جدد حسن شيء % % من الأشياء جددها اللقاء % % 3(@)(@@) % لها ريق تشف له الثنايا % % وتروي عنه لامنه الظماء % 4(@)(@@) % وأنفاس كأنفاس الخزامى % % قبيل الصبح بلتها السماء % % 5(@)(@@) % تنفس نشرها سحرا فجاءت % به سحرية المسرى رخاء % % PageV01P249 البحر : - 1(@)(@@) % مالقينا من ظرف ضرطة وهب % صيرت أهل دهرنا شعراء % % 2(@)(@@) % هي عندي كجود فضل بن يحيى % % غير أن ليس تنعش الفقراء % % PageV01P250 البحر : - 1(@)(@@) % ليت شعري عن خالد كيف أمسى % % من حكاك استهوحر هجائي % % 2(@)(@@) % جمعت شقوة الشقي عليه % % كل خزيوكل داء عياء % % 3(@)(@@) % لوعلمت الذي يقاسي من الأم % رين عزيته صباح مساء % % 4(@)(@@) % أيهذا المسائلي عن سعيد % وشقيولات حين خفاء % % 5(@)(@@) % أنا في الأرض محنة فاتخذني % % محنة الأشقياء والسعداء % % 6(@)(@@) % من تحامى عداوتي فسعيد % % ومعادي أول الأشقياء % % PageV01P251 البحر : - 1(@)(@@) % سوءةسوءة لك ابن البراء % % يا بديل الخراء عند الخراء % % 2(@)(@@) % شغلتك الذنوب عنا فأعرض % % ت عن الصالحات للفحشاء % % 3(@)(@@) % تركب الشقر غير ساع لمجد % % بل لعار وسبة شنعاء % 4(@)(@@) % ذاك ظنيولست أدري يقينا % % تعتلي أو تنوء بالأعباء % % 5(@)(@@) % ليت شعريأمركب أنت في الهي % % جاء أم من فوارس الهيجاء % % 6(@)(@@) % أم كلا المعنين فيك جميعا % حين تحلو بالقصة العوراء % % 7(@)(@@) % إن يكن كل ذاك فيك فهذا % % مذهب من مذاهب الفقهاء % % 8(@)(@@) % لايرون الجروح إلا قصاصا % % ورعا منهموعدل قضاء % % 9(@)(@@) % بل يقصون قبل أن يوقعوا الجر % % ح ركوبا للسنة البيضاء % % 10(@)(@@) % يسلفون القصاص من جرحوه % % قبل أن يجرحوه وزن السواء % % PageV01P252 11(@)(@@) % ليت شعريأذاك حكم أبي مو % % سى بغاء أم ذاك حكم البغاء % % 12(@)(@@) % لاتلمنا وإن أسأنا ثناء % % أنت مستأهل لسوء الثناء % % PageV01P253 البحر : - 1(@)(@@) % فقدتك يابن أبي طاهر % % وأطعمت ثكلك قبل العشاء % % 2(@)(@@) % فلا برد شعرك برد الشراب % % ولاحر شعرك حر الصلاء % % 3(@)(@@) % تذبذب فنك بين الفنون % % فلا للطبيخ ولا للشواء 
ms66	 % % PageV01P254 البحر : - 1(@)(@@) % قال لعبد القوي تبا لعلم % لم يجد غير عالم بغاء % % 2(@)(@@) % سوءةسوءة لعالم علم % جامع بينه وبين البغاء % % PageV01P255 البحر : - 1(@)(@@) % يقول القائلونضويت جدا % ولم تنضجك أرحام النساء % % 2(@)(@@) % ومن إنضاجها إياي أعرت % % عظامي من لحومهم الوطاء % % 3(@)(@@) % إذا ماكنت ذا عود صليب % % فيكفيني القليل من اللحاء % % PageV01P256 البحر : - 1(@)(@@) % زعم الناس خالد بغاء % % كذبوا القولوافتروه افتراء % % 2(@)(@@) % إنما صادفوه يلمس غرمو % % لا فواراه في استه استحياء % % 3(@)(@@) % فلحوه فيه فصار لجاجا % وهو شيخ يراغم الأعداء % % 4(@)(@@) % فليكفوا عن الجدال وإلا % % فليكونوا له إذا نظراء % % PageV01P257 البحر : - 1(@)(@@) % لم يصف الدواء جسمك إلا % % عن صفاء كما يكون الصفاء % % 2(@)(@@) % فلأعدائك البشاعة منه % % ولك النفع دونهم والشفاء % % PageV01P258 البحر : - 1(@)(@@) % لوتلففت في كساء الكسائي % % وتلبست فروة الفراء % % 2(@)(@@) % وتخللت بالخليلوأضحى % % سيبويه لديك رهن سباء % % 3(@)(@@) % وتكونت من سواد أبي الأس % % ود شخصا يكنى أبا السوداء % % 4(@)(@@) % لأبى الله أن يعدك أهل ال % % علم إلا من جملة الأغبياء % % PageV01P259 البحر : - 1(@)(@@) % رأيتك لاتلذ لطعم شيء % % تطعمه سوى طعم العطاء % % 2(@)(@@) % وما أهدى إليك من امتياحي % % أحب إليك من حسن الثناء % % 3(@)(@@) % فما لي عند تحكيكي مديحي % % أجشم خاطري ثقل العناء % % 4(@)(@@) % ولكني ألقي العرف عرفا % % وإن كنت الغني عن الجزاء % % 5(@)(@@) % أتيتك لم أشفع إليك بشافع % % ولو شئت كان الناس لي شفعاء % % 6(@)(@@) % ولكنني وفرت حمدي بأسره % % عليكولم أشرك بك الشركاء % % 7(@)(@@) % نداك معين كالذي قد علمته % % ولو كان غورا لا لتمست رشاء % 8(@)(@@) % وهذا شتاء قد أظل رواقه % % وجارك جار لا يخاف شتاء % % PageV01P260 البحر : - 1(@)(@@) % أيا رب لو سويت بيني وبينه % % لما كان عدلا أن نكون سواء % % 2(@)(@@) % فكيف وقد أعليته وخفضتني % % فكنت له أرضاوكان سماء % % PageV01P261 البحر : - 1(@)(@@) % وإذاماتحليت الأرض بالنر % % جس باهت به نجوم السماء % PageV01P262 البحر : - 1(@)(@@) % أيا فضلا غدا فضلا % % عن الخلقوفي الزمنى % % 2(@)(@@) % أما والعرج المحض ال % % ذي أنت به تكنى % % 3(@)(@@) % لئن صغر ما تدعى % % به ما كبر المعنى % % 4(@)(@@) % بلونا منك كوفيا % لئيم الأصل والمجنى % % 5(@)(@@) % وأهل الكوفة الرذل 
ms67	 % % ة أدنى الأرذل الأدنى % % 6(@)(@@) % أناس كلهم فرد % % وسوآتهم مثنى % % 7(@)(@@) % فلا دانيهم يجنى % % ولا نائيهم يدنى % % 8(@)(@@) % فأضلاع بني الدنيا % % على بغضهم تحنى % % 9(@)(@@) % مجاهيلمعازيل % % إلى اليسرى عن اليمنى % % 10(@)(@@) % مخاذيلمماييل % % إلى السوأى عن الحسنى % % PageV01P263 11(@)(@@) % على غير تقى الله % % غدت أبياتهم تبنى % % 12(@)(@@) % ويقري ضيفهم فيها % % ملاطا بعده مزنى % % 13(@)(@@) % فسمناهم كعجافهم % % وأنى لهم السمنى % % 14(@)(@@) % محل الشيمة الهجنى % % وأهل اللغة اللكنى % % 15(@)(@@) % إذا قلنا لهم نحن % % فمن قولهم نحنى % % 16(@)(@@) % وكم من مورق فيهم % % لآل الله ما أجنى % % 17(@)(@@) % وكم من ناصر فيهم % % لآل الله ما أغنى % % 18(@)(@@) % وكم من خاذل فيهم % % لآل الله قد أخنى % % 19(@)(@@) % تأملناهم قدما % % بعين لم تكن وسنى % % 20(@)(@@) % فلم يقصر لهم قرن % % ولا طال لهم مبنى % % PageV01P264 21(@)(@@) % إذا عدت مخازيهم % % فما تحصى ولاتفنى % % 22(@)(@@) % فلا عافاهم الله % % ولا أغنى ولا أقنى % % 23(@)(@@) % يد الله على المسك % ن والساكن والسكنى % % 24(@)(@@) % وكل فله هم % من السوء به يعنى % % 25(@)(@@) % وهم الأعرج الوغد % % مني في استه يمنى % % 26(@)(@@) % صحيح علوه جلد % % عليل سفله مضنى % % 27(@)(@@) % إذا ما فيشة لاحت % % صبا قيس إلى لبنى % % PageV01P265 البحر : - 1(@)(@@) % أياغرة العلياوياعينها اليمنى % % وياصفوة الدنياوياحاصل المعنى % % 2(@)(@@) % أأحييتني بالأمس ثم تميتني % % برفضي وإقصائي وحقي أن أدنى % % 3(@)(@@) % ولو أنني أحييت ميتا عشقته % % لحسن الذي أثرت فيه من الحسنى % % 4(@)(@@) % ألايعشق المفضال ميتا أعاشه % % وأجناه من معروفه الحلو ما أجنى % % 5(@)(@@) % أقول لقوم أوعدوا منك نبوة % وما خلتني أبلى بذاك ولاأمنى % % 6(@)(@@) % أأبقى على عهدي وينكث قاسم % % وتفنى أياديهوشكري لا يفنى % % 7(@)(@@) % كذبتمومعطيه العلاإن عزمه % % على العدل والإحسان للعزم لا يثنى % % 8(@)(@@) % أقاسملو نوفيك ماأنت أهله % % لأصبحت لاتسمى لدينا ولاتكنى % % 9(@)(@@) % ولم تدع إلاماجدا وابن ماجد % % وحق لك الأسنى من الوصف فالأسنى % % 10(@)(@@) % وإن كنت مأمولا تناسى حفاظه % % نصيبي وقد أغنى سواي وقد أقنى % % PageV01P266 11(@)(@@) % وأبعدني إبعاد جاني عظيمة % وقد كنت أستدعى زمانا وأستدنى % % 12(@)(@@) % أيحجب عني عشرة قد ومقتها % % فشوقي إليها شوق قيس إلى لبنى % % 13(@)(@@) % نعم أنا 
ms68	 ممنوع الذي لست كفؤه % % أتمنعني قوتي من العرض الأدنى % % 14(@)(@@) % نشدتكم أن تظلموني وتسكنوا % % جوى الحقد أضلاعا على حبكم تحنى % % 15(@)(@@) % أذو آلة فاستخدموني لآلتي % % بقوتيأولا فارزقوني مع الزمنى % % 16(@)(@@) % وإني لأرجو الفوزتينولم تزل % % أياديكم تترى على المجتدى مثنى % % 17(@)(@@) % فلا برحت سبابة تستغيثكم % % ولا خنصر من شاكر بكم تثنى % % 18(@)(@@) % ولازلتم يأوي إلى حجراتكم % % أخو حادث أنحى وذو زمن أخنى % % 19(@)(@@) % ألا يا عباد الله ما بال حالة % % أعالجها تدوى بأدوية المضنى % % 20(@)(@@) % أأشقى بمن لو قلتياخير من مشى % % على الأرضمااستثنى ضميري مستثنى % % PageV01P267 21(@)(@@) % أعيذكم من جور من جار حكمه % % فطائفة أشكى وطائفة أغنى % % 22(@)(@@) % هبوني امرأ لاحظ فيه لمجتن % أما في اصطناع العرف مكرمة تبنى % % 23(@)(@@) % عفاء على الدنيا إذا ساء رأيكم % % فما هي بالدار الدميثة للسكنى % % PageV01P268 البحر : - 1(@)(@@) % فما قلوص تبيت الليل معملة % تضحى وراكبها لم يعد ممساها % % 2(@)(@@) % مما إذا راكب أنضى مطيته % % أضحت جموما وقد أنضاه مسراها % % PageV01P269 البحر : - 1(@)(@@) % كل امرىء مدح امرأ لنواله % % فأطال فيه فقد أراد هجاءه % 2(@)(@@) % لو لم يقدر فيه بعد المستقى % % عند الورود لما أطال رشاءه % 3(@)(@@) % غيري فإني لاأطيل مدائحي % % إلا لأوفي من مدحت ثناءه % 4(@)(@@) % وأعد ظلما أن أقل مديحه % % عمداوأسخط أن أقل عطاءه % PageV01P270 البحر : - 1(@)(@@) % لاتحسب المعروف لامعنى له % % إلا نوافل حمده وثناه % % 2(@)(@@) % فلقد ترى المعروف يحسن عند من % % لم يصطنعهوحمده لسواه % % PageV01P271 البحر : - 1(@)(@@) % مزجت خمرة عينيها بريقتها % % كيما تكفكف عني من حمياها % % 2(@)(@@) % فاشتد إسكارها إياي إذ مزجت % ومزجك الكأس ينفي عنك طغياها % % PageV01P272 البحر : - 1(@)(@@) % أبو الحسين معجب برائه % لايقبل الشورى من أصدقائه % % 2(@)(@@) % فلعنة الله على إخائه % % وأدخل الأجرد في وجعائه % % 3(@)(@@) % وهما يمتعان وقتا من الده % % ر ويفنيهما وشيك المضاء % % 3(@)(@@) % صرحت عن طوية الأصدقاء % واضحات التجريب والابتلاء % 3(@)(@@) % وأبى المخض أن يكشف إلا % % عن صريح مهذب أو غثاء % 3(@)(@@) % ليس للمضمر الدخيل من الصا % % حب غير التكشيف والجتلاء % 3(@)(@@) % ولهذا اكتفى البليغ من الإس % % هاب فيما يريد بالإيحاء % % 3(@)(@@) % يفجأ من لامسه 
ms69	 حتفه % بل حتفه أوحى من الفجء % 3(@)(@@) % وكذا لست تعرف الشيء إلا % % بعد فحص من أمره وابتلاء % % 3(@)(@@) % وخبيء الفؤاد يعلمه العا % % قل قبل السماع بالإيماء % PageV01P273 3(@)(@@) % فالصديق المأمون للزمن الفا % % دح والمرتجى لدى البرحاء % % 3(@)(@@) % والذي أنت وهو في جوهر النف % س جميعا من تربة وهواء % % 3(@)(@@) % وكماء مزجته بمدام % % فاستقرا تجنسا في وعاء % % 3(@)(@@) % لم يكن فيهما من الفضل إلا % % فاصلات الألقاب والأسماء % % 3(@)(@@) % ثم شيء عرفته بالتجاري % % ب وأخلصته بكشف الغطاء % % 3(@)(@@) % وإذا كنت لا تؤثل إلا % % درهما جائزا على البصراء % % 3(@)(@@) % قمرته الفرخ على ضغائه % % بما يفي وكعت عن دوائه % % 3(@)(@@) % وظنون الذكي أنفذ في الحق % ق سهاما من رؤية الأغبياء % % 3(@)(@@) % ومن تعديه ومن إلوائه % % بالحق إذ جار على أعدائه % % 3(@)(@@) % السريع سكيننا هذا له حدة % تصلح للتقطيع والوجء % PageV01P274 3(@)(@@) % إن البخيل ميت بدائه % % وأمره كل إلى ورائه % % 3(@)(@@) % لكنني أفرط في اقتضائه % % وأستخير الله في أقصائه % % 3(@)(@@) % زلقت رجل شنطف في خراها % % فاستغاثت بصفعة في قفاها % % 3(@)(@@) % ثلطت في ندينا فاستحقت % % أن يكافى بصفعة أخدعاها % % 3(@)(@@) % سقطة ملطة شروخ ربوخ % شنطف صدق الذي سماها % % 3(@)(@@) % عذرنا النخل في إبداء شوك % يذود به الأنامل عن جناه % 3(@)(@@) % يسبح في الجهلوفي طخيائه % % وهو لدى الإخوان من جفائه % % 3(@)(@@) % فما للعوسج الملعون أبدى % % لنا شوكا بلا ثمر نراه % 3(@)(@@) % تراه ظن فيه جنى كريما % فأظهر عدة تحمي حماه % % 3(@)(@@) % فلا يتسلحن لدفع كف % كفاه لؤم مجناه كفاه % % PageV01P275 3(@)(@@) % قحبة كلبة نخور صبور % حين تلقى طعن الأيور كلاها % % 4(@)(@@) % بوأخلصته بكشف الغطاء % % إنما تبرز الجواهر مافي % % 5(@)(@@) % ها إذا ما أمعتها بالصلاء % % لايغرنك المماذق بالظا % % 6(@)(@@) % هر في حال مدة الالتقاء % % من كلام يوشى بمدح جميل % 7(@)(@@) % وحديث كالقهوة الصهباء % % ويمين كعطك البرد لاتن % % 8(@)(@@) % ظر في سقمها وفي الإبراء % % عبد عين فإن تغيبت عنه % % 9(@)(@@) % أكل اللحموارتعى في الدماء % % وإذا ما أردته لقتيل % % 10(@)(@@) % لحق الود منه بالعنقاء % % ولقد قال سيد من أولي الفض % % 11(@)(@@) % ل ومن 
ms70	 سر صفوة الأصفياء % % ليس أهل العراق لي بصاحب % % 12(@)(@@) % إن هم جانبوا طريق الوفاء % % إنما صاحبي المشارك في القل % PageV01P276 13(@)(@@) % ل وذو البذل والندى والحياء % % إنما الصاحب الذي يحفظ الصا % % 14(@)(@@) % حب في كل شدة ورخاء % % لايلهيه عنه خفضولا ين % % 15(@)(@@) % ساه عند المربدة الشوهاء % % ماله كنزه إذا خفت الغي % % 16(@)(@@) % ثوضاقت خلائق السمحاء % % وانتفى الشيخ من بنيهولم تع % % 17(@)(@@) % طف على بكرها أعف النساء % % حكمة ما ورثتها عن حكيم % 18(@)(@@) % فيلسوف من عترة الأنبياء % % ليس شيء يفيده المرء في الده % % 19(@)(@@) % ر على حين فقره والثراء % % هو خير من صاحب ورفيق % % 20(@)(@@) % مسعد في الجلية البهماء % % ليس بين الصديق والنفس فرق % % 21(@)(@@) % عندتحصيل قسمة الأشياء % % يا سمي الوصيياشق نفسي % % 22(@)(@@) % وأخي في الململة النكراء % % ياأخا حل في المكارم والسؤ % % PageV01P277 23(@)(@@) % دد على محل أهل السناء % % لم يقصر به اعتيادولم يق % % 24(@)(@@) % عد به مولد عن استعلاء % % وله بعد من مآثره الزه % % 25(@)(@@) % ر خلال تربى على الحصباء % % عجم الدهر خلفتين وسوى % % 26(@)(@@) % بين حالي رخائه والبلاء % % كرم الخيم والنجاروتيكم % 27(@)(@@) % شيمة شارف من النبلاء % % وبيان كأنه خرز النا % % 28(@)(@@) % ظم في جيد طفلة غيداء % % وطباع أرق من ظبة السي % % 29(@)(@@) % فوأمضى من ريقة الرقشاء % % تتراءى له العيون فتلقا % % 30(@)(@@) % ه نقابا بدائها والدواء % % فيصل للأموريأتي المعالي % % 31(@)(@@) % بارتقاء فيهاوحسن اهتداء % % وغريم أمضى من الأجل الحت % % 32(@)(@@) % معصيم بأربة بزلاء % % وهو إلف الحجاوترب المساعي % % PageV01P278 33(@)(@@) % وعقيد الندى وحلف البهاء % % وهو بعل للمكرماتفما ين % % 34(@)(@@) % فك بين العوان والعذراء % % حافظ للصديق إن زلت النع % % 35(@)(@@) % ل به أو هوى عن العلياء % % وجواد عليه بالمال والنف % % 36(@)(@@) % س وبذل العقيلة الوفراء % % لايؤاتي على اقتسارولا ين % % 37(@)(@@) % هض إلا بالعزة القعساء % % غير أن الزمان أقصدني في % % 38(@)(@@) % ه بسهمي تفرق وانتئاء % % لاأراه إلا على شحط الدا % % 39(@)(@@) % روإما عن مدة شقاء % % فإذا ما رأيته فكأني % % 40(@)(@@) % بين أثناء روضة مرجاء % % يتجلى عن ناظري عشا الجه % % 41(@)(@@) % ل بألفاظه العذاب الطراء % % وأحاديث لو دعوت 
ms71	 بها الأع % % 42(@)(@@) % صم لبى من حسن ذاك الدعاء % % طبت خلا فاسلم على نكد الده % % PageV01P279 43(@)(@@) % روعش آمنا من الأسواء % % لا رزئناك عاتبا طلب العت % % 44(@)(@@) % بى بإعفا معاتب الأدباء % % بكلام لو أن للدهر سمعا % % 45(@)(@@) % مال من حسنة إلى الإصغاء % % ولو أن البحار يقذف فيها % % 46(@)(@@) % منه حرف ماأج طعم الماء % % وهو أمضى من السيوف إذا هز % % 47(@)(@@) % زتوأوحى من مبرمات القضاء % % وهو يشفي الصدور من جنف الحق % % 48(@)(@@) % دويغضي من مقلة زرقاء % % يكتسي منشدوه منه رداء % % 49(@)(@@) % ذا الجمالأكرم به من رداء % % لاتعايى به الرواة ولم يس % % 50(@)(@@) % لمه مسموعه إلى استثناء % % ليس بالمعمل الهجين ولا الوح % % 51(@)(@@) % شي ذي العنجهية العثواء % % بل هو البارد الزلال إذا وا % % 52(@)(@@) % فق من صائم حلول عشاء % % تخلق الأرض وهو غض جديد % % PageV01P280 53(@)(@@) % فلكي من عنصر الجوزاء % % عتب إلف أرق من كلم ال % % 54(@)(@@) % أم وإن كان من ذري خلقاء % % إن يكن عن من أخيك فعال % 55(@)(@@) % جار فيه عن مذهب الأوفياء % % جل في مثله العتاب وعالى % % 56(@)(@@) % أن يوازى بزلة العلماء % % فبحق أقولعمرك الل % 57(@)(@@) % ه طويلا في رفعة وعلاء % % ولك القول لالناولك التس % 58(@)(@@) % ليم منا لمذهب الحكماء % % إن خيرا من التقصي على الخل % 59(@)(@@) % ل سماح في الأخذ والإعطاء % % واغتفار لهفوة إن ألمت % % 60(@)(@@) % واطراح التفسير والانتفاء % % ليس في كل زلة يسع العذ % 61(@)(@@) % ر وفي ضيقه انتكاس الإخاء % % مارأيت المراء يوجب إلا % % 62(@)(@@) % فرقة ما اعتمدت طول المراء % % وعروس قد جهزت بطلاق % PageV01P281 63(@)(@@) % عاتبت في وليدة شنئاء % إن طول العتاب يزدرع البغ % % 64(@)(@@) % ضاء في قلب كاره البغضاء % لم أقل ذا لأن عتبت ولكن % % 65(@)(@@) % شجر العتب مثم ر للجفاء % % ليس كل الإخوان يجمع ماير % 66(@)(@@) % ضيك من كل خلة حسناء % % فيه ما في الرجال من خلة تح % 67(@)(@@) % مد يوما وخلة سوآء % % أي خل تراه كالذهب الأح % % 68(@)(@@) % مر أو كالوذيلة الزهراء % % أين من يحفظ الصديق بظهر ال % % 69(@)(@@) % غيب من سوء قرفة الأعداء % % فات هذا 
ms72	 فلن تراه يد الده % % 70(@)(@@) % ر فأنعم في إثره بالبكاء % مثلا ماضربته لك فاسمع % % 71(@)(@@) % وتثبتجزيت خير الجزاء % % كل شيء بالحس يعرف أو بالس % 72(@)(@@) % سمع أو بالأدلة الفصحاء % % فله موضعوفيه طباخ % PageV01P282 73(@)(@@) % لبلاغ ذي مدة وانقضاء % % ولكل من الأخلاء حال % 74(@)(@@) % هو فيها كفء من الأكفاء % أي شيء أجل قدرا من السي % % 75(@)(@@) % ف ليوم الكريهة العزاء % % فأبن لي هل يصلح السيف في العز % 76(@)(@@) % زاء إلا للضربة الرعلاء % % والوشيج الخطي وهو رشاء ال % % 77(@)(@@) % موت يوم الزلزال والبأساء % % هل تراه يراد في حومة المأ % % 78(@)(@@) % قط إلا للطعنة النجلاء % % فكذاك الصديق يصلح للسا % % 79(@)(@@) % عة دون الإصباح والإمساء % % فتمسك بهولا تدعنه % % 80(@)(@@) % فتراه خصما من الخصماء % % وهما يذخران للحال لا الإح % 81(@)(@@) % وال بين الفؤاد والأحشاء % % وصغار الأمور ردف لذي الرت % % 82(@)(@@) % بة منها والفخروالكبرياء % % وملوك الأنام قد أحوج الل % PageV01P283 83(@)(@@) % ه عرا ملكها إلى الدهماء % % ولو أن الملوك أفرادها الل % 84(@)(@@) % ه من التابعين والوزعاء % % لبدت خلة وثلت عروش % % 85(@)(@@) % واستوت بالأخسة الوضعاء % ولما كان بين أكمل خلق ال % % 86(@)(@@) % له فرق وبين أهل الغباء % % حلق الدرع ليس يمسك منها % % 87(@)(@@) % سردها غير شكة الحرباء % ولهذا الإنسان قد سخر الرح % % 88(@)(@@) % من ما بين أرضه والسماء % وبحسب النعماء يطلب الشك % % 89(@)(@@) % ر كفاء لواهب النعماء % % ثم لم يخله من النقص والحا % % 90(@)(@@) % جة والعجز قسمة بالسواء % % ليكون الإنسان في غاية التع % 91(@)(@@) % ديل بين السراء والضراء % % فاصطبر للصديق إن زل أوجا % % 92(@)(@@) % ر برجل عن الهدى نكباء % % فهو كالماءهل رأيت معين ال % % PageV01P284 93(@)(@@) % ماء يعفى من نطفة كدراء % وتمتع بهففيه متاع % 94(@)(@@) % وادخار لساعة سوعاء % % أي جسم يبقى على غير الده % % 95(@)(@@) % ر خليا من قاتل الأدواء % % أيما روضة رأيت يد الأي % % 96(@)(@@) % أم في عبقرية خضراء % % أو ما أبصرت لك الخير عينا % % 97(@)(@@) % ك رباها مصفرة الأرجاء % % إنما هذه الحياة غرور % 98(@)(@@) % وشقاء للمعشر الأشقياء % % نحن فيها ركب نؤم بلادا % 99(@)(@@) % فكأن قد ألنا إلى الانتهاء 
ms73	 % % ماعسى نرتجي ونحن مع الأم % 100(@)(@@) % وات يحدى بنا أحث الحداء % فإذا أعرض الصديق وولى % % 101(@)(@@) % لقفار لاتهتدى فيفاء % ورمى بالإخاء من رأس عليا % % 102(@)(@@) % ء إلى مدلهمة ظلماء % % لم يراقب إلاولم يرج أن يأ % % PageV01P285 103(@)(@@) % تي يوما يمشي على استحياء % % فاتركنه لا يهتدي لمبيت % 104(@)(@@) % بنباح ولا بطول عواء % % إنما ترتجى البقية ممن % % 105(@)(@@) % فيه بقيا وموضع للبقاء % % واشددن راحتيك بالصاحب المس % % 106(@)(@@) % عد يوم البليسة الغماء % بالذي إن دعي أجاب وإن كا % % 107(@)(@@) % ن قراع الفوارس الشجعاء % % كأبي القاسم الذي كل مايم % 108(@)(@@) % لك للمعتقين والخلطاء % % والذي إذا أردته لمقام % 109(@)(@@) % جاء سبقا كاللقوة الشغواء % % وإذا ما أردته لجدال % 110(@)(@@) % جاء كالمصمئلة الدهياء % % فإذا دل جاء بالحج % 111(@)(@@) % جة الغراء ذات المعالم الغراء % % منجح القيل ما علمت وحاشا % % 112(@)(@@) % لخليلي من ترحة الإكداء % % أريحي بمثله يبتنى المج % % PageV01P286 113(@)(@@) % د وتسمو به فروع البناء % % باسط الوجهضاحك السنبسا % % 114(@)(@@) % م على حين كرهه والرضاء % % وثبيت المقام في الموقف الدح % % 115(@)(@@) % ض إذا ما أضاق رحب الفضاء % % وله فكرة يعيد بها الأم % % 116(@)(@@) % وات في مثل صورة الأحياء % % فتراها تفرى الفريوكانت % % 117(@)(@@) % قبله لاتحير رجع النداء % % ليس يرضى لها التحرك أو يب % % 118(@)(@@) % رزها في زلازل الهيجاء % % فترى بينها مقارعة الأب % % 119(@)(@@) % طال راحت من غارة شعواء % % بتدابير تفلق الحجر الصل % 120(@)(@@) % دوتشفي من كل داء عياء % % يهزم الجيش ذكره فتراهم % % 121(@)(@@) % جزر الهام عرضة الأصداء % % يتلقاهم بسيف من الفك % % 122(@)(@@) % رورمح من صنعة الآراء % % وسيوف العقول أمضى من الصم % % PageV01P287 123(@)(@@) % صام في كف فارس الغبراء % % فترى القوم في قليب من المو % % 124(@)(@@) % ت أسارى لدلوه والرشاء % وله حرشف يدير قداما % % 125(@)(@@) % ه زحافا كالفيلق الشهباء % والمغاوير باليات كما عا % % 126(@)(@@) % ينت مور الكتيبة الجأواء % % وهي خرس البيان من جهة النط % % 127(@)(@@) % قفصاح الآثار والأنباء % % أي شيء يكون أحسن منه % % 128(@)(@@) % فارسا ماشيا على العفراء % في حروب لاتصطلى لترات % 129(@)(@@) % وقتال بغير ما شحناء % وقتيل بغير جرم جناه % % 130(@)(@@) % وجريح مسلم 
ms74	 الأعضاء % % وصريع تحت السنابك ينجو % % 131(@)(@@) % برماق ولات حين نجاء % % وهو في ذاك ناعم البال لا ي % % 132(@)(@@) % فصل بين القتيل والأسراء % % وتراه يحث كأس طلاء % PageV01P288 133(@)(@@) % باقتراح لقبلة أو غناء % % لايدانيه في الشجاعة بسطا % % 134(@)(@@) % م بن قيسوفارس الضحياء % % حل من خلتي محل زلال ال % % 135(@)(@@) % ماء من ذات غلة صدياء % % بوداد كأنه النرجس الغض % 136(@)(@@) % ض عليلا بمسكة ذفراء % % راسيا ثابتا وإن خلت الدا % % 137(@)(@@) % ر جنابا وامتد عهد اللقاء % % لست أخشى منه الغياب ولا تخ % % 138(@)(@@) % شاه في حال قربنا والعداء % % حبذا أنتما خليلا صفاء % 139(@)(@@) % لا يدانيكما خليلا صفاء % لكما طوع خلتي وقيادي % % 140(@)(@@) % ما تغنت خطباء في شجراء % ذاك جهدي إذا وددت وإن أق % % 141(@)(@@) % در أكافئكما بخير كفاء % % وحباء الوداد بالمنطق الغض % 142(@)(@@) % ض يجازى به أجل حباء % % ن % PageV01P289 البحر : - 1(@)(@@) % ألا ابلغ لديك بني طاهر % أساة الخلافة من دائها % % 2(@)(@@) % علوتم علو نجوم السماء % % فنوؤوا علينا كأنوائها % % PageV01P290 البحر : - 1(@)(@@) % لا عدمت السرور يا بن أبي بك % ر وأعقبت صحة من دوائك % 2(@)(@@) % وأطال الإله عمرك في عز % ز يسوء الجميع من أعدائك % % 3(@)(@@) % عالي القدر نافذ الأمر والنه % % ي تسر الجميع من أوليائك % % 4(@)(@@) % رمت إذ قيل لي أخذت دواء % لطفا عاليا بقدر اعتلائك % % 5(@)(@@) % فإذا ما ملكته مستقل % لك لا بل لخادم بفنائك % % 6(@)(@@) % وإذا الشكر والثناء هما أف % % ضل شيء يهدى إلى نظرائك % % 7(@)(@@) % فبعث الدعاء والشكر فاعرف % فضل علقين أخبرا عن علائك % % PageV01P291 البحر : - 1(@)(@@) % يا باذل العرف لأعدائه % % مذ كان فضلا عن أودائه % 2(@)(@@) % ويا أخا الجود وخلصانه % لكل ما يشفيه من دائه % 3(@)(@@) % جاء البنفس الرطب فامنن به % % ما دام مطلولا بأندائه % 4(@)(@@) % قد جادت الأرض بإنباته % فجد لنا أنت بإهدائه % 5(@)(@@) % ولا تكن أبخل من طينة % تبديه في إبان إبدائه % % 6(@)(@@) % ما الأرض أولى من فتى ماجد % % بفعل معروف وإسدائه % % 7(@)(@@) % والحر لا يقطع في حالة % % عادات جدواه وإجدائه % % 8(@)(@@) % ولا أياديه بمقفوة % بيضاؤه منه بسودائه % % 9(@)(@@) % ولا 
ms75	 عطاياه بمتلوة % منها الهنيئات بنكدائه % % 10(@)(@@) % ما حق من أسلف تأميله % مثلك أن يجزى بإكدائه % % PageV01P292 البحر : - 1(@)(@@) % طويت بسيط آمالي برفد % كفاني أن أؤمل ما سواه % 2(@)(@@) % أقول وقد طويت به رجائي % % ليطو كذا رجائي من طواه % PageV01P293 البحر : - 1(@)(@@) % سقيتن يا منزلات الهوى % % بوادي الشريجة صوب الحيا % % 2(@)(@@) % ولا زال مسرح غزلانكن % مريع المحلة والمنتأى % % 3(@)(@@) % وجاورت الروض حيث الحسا % % ن تغض النهى من عيون المها % % 4(@)(@@) % مواقف حور بنات الخدور % يبكين أعين من قد هوى % % 5(@)(@@) % بكاء الحمائم في أيكة % تجاوبن وقت ابتسام الضحا % % 6(@)(@@) % إذا ما غدون لطاف الخصور % خفاف الصدور ثقال الخطا % % 7(@)(@@) % رقاق الثنايا عذاب الغروب % صغار القلوب ضعاف القوى % % 8(@)(@@) % زوائر في كل ما جمعة % قبورا أقمن بدار البلى % % 9(@)(@@) % ورحن يجاذبن أردافهن % لواعب في نسوة كالدمى % % 10(@)(@@) % كأن تثني أعطافهن % تثني الغصون بريح الصبا % % PageV01P294 11(@)(@@) % فكم لي في ظل أفنانكن % على النأي من معهد للصبا % % 12(@)(@@) % وبعد التهاجر من وصلة % وبعد التفرق من ملتقى % % 13(@)(@@) % ومن يوم هم نعمنا به % % بأحبابنا صالح مرتضى % % 14(@)(@@) % فبدلت منكن في واسط % مساكن أنباط أهل القرى % % 15(@)(@@) % ومن سر من را وروضاتها % % حشوشا تقابل وسط الملا % % 16(@)(@@) % ومن حسن أوجه سكانها % % قرودا تزحر تحت الغضى % % 17(@)(@@) % رجالا بكسكر ما إن ترى % % لهم شبها من جميع الورى % % 18(@)(@@) % نحاف الجسوم خفاف الحلو % % م صغار الرؤوس عظام اللحى % % 19(@)(@@) % فلا قدست واسط بلدة % ولا جادها من سحاب روا % % PageV01P295 البحر : - 1(@)(@@) % نشر آذار في الثرى حللا % قد كان كانون قبل طواها % % 2(@)(@@) % كسا عراء الربا طيالسة % خضرا وبالعبقري رداها % % 3(@)(@@) % وصاغ للأرض كل تاج بها % % أحسن في صنعه فجلاها % % 4(@)(@@) % أعجب ذاك السماء فانبعثت % تنثر درا على محياها % % 5(@)(@@) % ولو ترانا وقد تكنفنا % % من دكن الخز لابس جاها % % 6(@)(@@) % وتظهر الشمس في النشاص لنا % % من خلل الغيم إذ تغشاها % % 7(@)(@@) % مثل عروس تسترت خجلا % من بعلها بعد أن تجلاها % % PageV01P296 البحر : - 1(@)(@@) % سلوت شبابي والرضاع كليهما % % فكيف تراني ساليا ما سواهما % % 2 
ms76	(@)(@@) % وما أحدث العصران شيئا نكرته % % هما الواهبان السالبان هما هما % % 3(@)(@@) % رأيت احتساب الأمر قبل وقوعه % % حمى مقلتي أن يطول بكاهما % % PageV01P297 البحر : - 1(@)(@@) % يا أبا الفضل لم تكن عوجة من % % ك علينا تحط من عليائك % 2(@)(@@) % لا ولا في قضاء حق أبي شي % بة ما يوجب انتكاث إخائك % 3(@)(@@) % قد بغينا كما بغيت وقد كا % % ن حقيقا وفاؤنا بوفائك % 4(@)(@@) % إن تكن قد علوت عن ساكني الأر % % ض فخاطبهم إذا من سمائك % PageV01P298 البحر : - 1(@)(@@) % إن ابن بلبل نخلة % لانت لصقر من وراء % 2(@)(@@) % ذاك الذي نسخ الإجا % % رة بالوزارة للقضاء % 3(@)(@@) % ملك الرجال بعزة % ملك الرجال الأقوياء % 4(@)(@@) % ولطال ما ملك الرجا % % ل بذلة مثل النساء % 5(@)(@@) % أضحت سعادته له % % رهنا مليا بالشقاء % 6(@)(@@) % عبد الندى ملك الحجا % % ب تراه جبار اللقاء % 7(@)(@@) % يهوى سفالا في الحضي % % ض وأنفه فوق السماء % % PageV01P299 البحر : - 1(@)(@@) % أسل الغنى عنك الذي % % أغناك عني بالثراء % 2(@)(@@) % كيما تراني في الذي % % أبصرت فيك من القضاء % 3(@)(@@) % ولقد أرقت بلا انتفا % % ع ماء وجهي بالرجاء % 4(@)(@@) % فمنعتني منك الجدا % % وسرقتني طيب الثناء % PageV01P300 البحر : - 1(@)(@@) % قولا لسمانة كهف الزنا % % سبحان من وسع أحشاك % 2(@)(@@) % يغيب ماء الناس عن أسرهم % % فيك ولا تبسط أثناك % 3(@)(@@) % يا أرض هل حملت في وسعها % % بالله مذ حملت أعباك % % 4(@)(@@) % كأنما يوحى إلى رحمها % % وقيل يا أرض ابلعي ماك % PageV01P301 البحر : - 1(@)(@@) % لو أن رجلي عرسه يداها % % ما أخطأته رحمة تغشاها % % 2(@)(@@) % مذ خلقت مرفوعة رجلاها % % كأنما تستغفران اللاها % % 3(@)(@@) % يلومه الناس أن اصطفاها % % مع الذي يخبر من زناها % % 4(@)(@@) % وخالد يدري لم اجتباها % % من كان يشفي داءه لولاها % % 5(@)(@@) % يمنعها الشيخ من اشتهاها % % أو يحبس الأصلع في دباها % % PageV01P302 البحر : - 1(@)(@@) % قالوا سقى الماء بطن وهب % فقلت أنى وكيف ذاكا % % 2(@)(@@) % أين هواضيمه اللواتي % % كان يداوي بها براكا % % 3(@)(@@) % لم نر يا وهب ذا بغاء % مستسقيا بطنه سواكا % % 4(@)(@@) % إن يك لم يغن عنك شيئا % وقع الهواضيم في حشاكا % % 5(@)(@@) % لقد سقي الماء بطن 
ms77	 سوء % شفاه ربي ولا شفاك % % PageV01P303 البحر : - 1(@)(@@) % ومغن ببرده ونداه % تخمد النار حين يفتح فاه % 2(@)(@@) % يتغنى بغير رزء ولا يس % % كت إلا بحكمه ورضاه % 3(@)(@@) % يتمنى السميع حين يغني % % أنه قبل ذاك صم صداه % PageV01P304 البحر : - 1(@)(@@) % ألا رب أشياء مذكورة % يحدث عنها وليست ترى % % 2(@)(@@) % بعرس وآوى وما أشبها % % وكابن الرخامي طيف الكرى % % PageV01P305 البحر : - 1(@)(@@) % وذي ود تغيظ إذ جفاني % % أبو حفص فقلت له فداه % 2(@)(@@) % ألم ترني وقفت عليه عرضي % % وأمكنني بذلك من قفاه % 3(@)(@@) % فلست الدهر هاجيه حياتي % % ولكني سأهجو من هجاه % 4(@)(@@) % إذا كافأته سوءا بسوء % فمن ليدي ونزهتها سواه % PageV01P306 البحر : - 1(@)(@@) % أبيتم أن تقيدوا شكر مثلي % % بل الله الذي خلق الإباء % 2(@)(@@) % رآني الله أرفع من جداكم % % وأنى تمطر الأرض السماء % PageV01P307 البحر : - 1(@)(@@) % لعمرك ما أدري إذا ما تنفست % كنزة ما أنفاسها من فسائها % % 2(@)(@@) % بها غلمة قد أحرقتها بحرها % % تبردها عن نفسها بغنائها % % PageV01P308 البحر : - 1(@)(@@) % رأيت أذاكم وإن اعتزلتم % % جنوبا تستدير على ذراها % % 2(@)(@@) % فأما لؤمكم عن كل خير % فعين الفهد لا تقضي كراها % % PageV01P309 البحر : - 1(@)(@@) % لعمرك ما الدنيا بدار إقامة % إذا زال عن عين البصير غطاؤها % % 2(@)(@@) % وكيف بقاء الناس فيها وإنما % % ينال بأسباب الفناء بقاؤها % % PageV01P310 البحر : - 1(@)(@@) % وما الفقر عيبا ما تجمل أهله % ولم يسألوا إلا مداواة دائه % 2(@)(@@) % ولا عيب إلا عيب من يملك الغنى % % ويمنع أهل الفقر فضل ثرائه % 3(@)(@@) % عجبت لعيب العائبين فقيرهم % % بأمر قضاه ربه من سمائه % % 4(@)(@@) % وتركهم عيب الغني ببخله % % ولؤم مساعيه وسوء بلائه % % 5(@)(@@) % وأعجب منه المادحون أخا الغنى % % وليس غناه فيهم بغنائه % 6(@)(@@) % ولو أنه أغنى ووكل نفسه % % بجمع فضول المال بعد اقتنائه % % 7(@)(@@) % لما كان أهل الحمد من قربائه % % إذا أتمروا رشدا ولا بعدائه % % 8(@)(@@) % ولا حمد الله الأولى يحمدونه % % ولا اعتدهم في الناس من أوليائه % % 9(@)(@@) % أولئك أتباع المطامع والمنى % % جزاهم مليك الناس شر جزائه % % 10(@)(@@) % يعيبهم أهل العفاف ومدحهم % حريصا يكد النفس بعد اكتفائه % % PageV01P311 11(@)(@@) % يؤثل لا للحمد ما هو كاسب 
ms78	 % ولا الأجر في إصباحه ومسائه % % 12(@)(@@) % ولكن لكنز من لجين وعسجد % يود فناء العمر قبل فسائه % % 13(@)(@@) % يقيه ويحميه بصفحه وجهه % % ويجعل أيضا عرضه من فدائه % % 14(@)(@@) % ولو حظ أضحى ماله من أمامه % % وقاء وأضحى عرضه من ورائه % % 15(@)(@@) % ولكن أبى إلا الخسار لغيه % وما فوق عيني قلبه من غطائه % % 16(@)(@@) % ولو وزن استمتاعه بغنائه % إذا ما وفى استمتاعه بعنائه % % 17(@)(@@) % سأمنحه ذمي وأختص حزبه % بأوفى نصيب من قبيح ثنائه % % 18(@)(@@) % رضيت لمن يشقى عقابا شقاءه % % وإن لم أكن أرضى له بشفائه % % 19(@)(@@) % إذا حرم الفاني من الخير حظه % فلم يفرح الباقي بطول بقائه % % 20(@)(@@) % ضلالا لمن يسعى إلى غير غاية % ولايرتجى ناهيه عند انتهائه % % PageV01P312 البحر : - 1(@)(@@) % يا ويح هذا الطبيب ويحاه % لقد تعدى بما تجناه % 2(@)(@@) % يألم بالفصد كف ذي غنج % تفصد منا القلوب عيناه % PageV01P313 البحر : - 1(@)(@@) % قد تستر المرآة عن % ك خدوش وجهك مع صداها % % 2(@)(@@) % وكذاك نفسك لا تري % % ك عيوب نفسك مع هواها % % PageV01P314 البحر : - 1(@)(@@) % وحية في رأسها درة % تسبح في بحر قصير المدى % % 2(@)(@@) % فإن تولت فالعمى حاضر % وإن بدت بان طريق الهدى % % PageV01P315 البحر : - 1(@)(@@) % ما للملول وفاء في مودته % قلب الملول إلى هجر وإقصاء % 2(@)(@@) % كأنني كلما أصبحت أعتبه % أخط حرفا على صفح من الماء % PageV01P316 البحر : - 1(@)(@@) % به تنطوي الآمال عند انبساطها % % وتنسط الأعمار بعد انطوائها % % 2(@)(@@) % وما تنطوي الآمال عنه بخيبة % ولكن إلى جدواه أقصى انتهائها % % 3(@)(@@) % إذا غلت الآمال فارض بجوده % فما بعده معدى لسهم غلائها % % PageV01P317 البحر : - 1(@)(@@) % وقهوة رقت عن الهواء % أدفع للداء من الدواء % % 2(@)(@@) % عذراء لاحت في يدي عذراء % أحسن من تظاهر النعماء % % PageV01P318 البحر : - 1(@)(@@) % قال لهاجيك مطنبا في الهجاء % % لا تبع راحة بطول عناء % 2(@)(@@) % سمني لا تزد فأنت إذا ما % % قلت أفعى أنبأت عن رقشاء % % 3(@)(@@) % قسما إن في الهجاء لسترا % % وغطاء للسوءة السوآء % % 4(@)(@@) % لو هجا الأنبياء كلبا لقال الن % ناس هذا تكذب الشعراء % % PageV01P319 البحر : - 1(@)(@@) % لله خالد الطائي من رجل % كم شبهة من عويص الفقه 
ms79	 جلاها % % 2(@)(@@) % أبصرت زوجته يوما بحضرته % % وقد علت دون سقف البيت رجلاها % % 3(@)(@@) % فقلت هلا توارت عنك محسنة % فقال تخشى عقاب الله مولاها % % 4(@)(@@) % لو أنها كاتمتني بالزنا أثمت % إذ تتقيني بما لا تتقي اللاها % % PageV01P320 البحر : - 1(@)(@@) % وشاعر أوقد الطبع الذكاء به % % فكاد يحرقه من فرط إذكاء % 2(@)(@@) % أقام يجهد أياما قريحته % وفسر الماء بعد الجهد بالماء % PageV01P321 البحر : - 1(@)(@@) % وكلام لو ان للدهر سمعا % مال من حسنه إلى الإصغاء % 2(@)(@@) % ولو ان البحار يقذف فيها % % منه حرف ما أج طعم الماء % 3(@)(@@) % تخلق الأرض وهو غض جديد % فلكي من عنصر الجوزاء % PageV01P322 البحر : - 1(@)(@@) % رب عرض منزه عن قبيح % دنسته معرضات الهجاء % 2(@)(@@) % لو أراد الأديب أن يهجو البد % % ر رماه بالخطة الشنعاء % 3(@)(@@) % قال يا بدر أنت تغدر بالسا % % ري وتزري بزورة الحسناء % % 4(@)(@@) % كلف في شحوب وجهك يحكي % % نكتا فوق وجنة برصاء % % 5(@)(@@) % يعتريك المحاق ثم يخلي % % ك شبيه القلامة الحجناء % % 6(@)(@@) % ويليك النقصان في آخر الشه % % ر فيمحوك من أديم السماء % % 7(@)(@@) % فإذا البدر نيل بالهجو هل يأ % % من ذو الفضل ألسن الشعراء % % 8(@)(@@) % لا لأجل المديح بل خيفة الهج % % و أخذنا جوائز الخلفاء % % PageV01P323 البحر : - 1(@)(@@) % روح النفوس تنفس الصهباء % % من دونها كالصبح باللألاء % 2(@)(@@) % فكأنها من فوق عرش زجاجها % % بلقيس تجلى في حلى حسناء % % 3(@)(@@) % وكأنها في الكأس شمس قارنت % برج الهلال فهل بالأضواء % 4(@)(@@) % نظم الحباب على شقائق أرضها % % نثر اللآلىء من ندى الأنواء % % 5(@)(@@) % لم أدر هل أبدت حبابا زاهرا % أو عكس نور كواكب الجوزاء % % 6(@)(@@) % تسري كسري الروح في أعضائها % % أو كالصبا في الروضة الغناء % % 7(@)(@@) % وتعيد نشأتها المشيب إلى الصبا % % فكأن عيسى جاء بالإحياء % % 8(@)(@@) % تروي عن العصر القديم حديثها % % بتسلسل والدور في الندماء % % PageV01P324 البحر : - 1(@)(@@) % لنعم اليوم يوم السبت حقا % لصيد إن أردت بلا امتراء % 2(@)(@@) % وفي الأحد البناء فإن فيه % % بدا الرحمن في خلق السماء % % 3(@)(@@) % وفي الاثنين إن سافرت فيه % % تنبأ بالنجاح وبالنجاء % % 4(@)(@@) % وإن رمت الحجامة فالثلاثا % % فذاك اليوم 
ms80	 مهراق الدماء % % 5(@)(@@) % وإن رام امرؤ يوما دواء % فنعم اليوم يوم الأربعاء % % 6(@)(@@) % وفي يوم الخميس قضاء خير % ففيه الله يأذن بالقضاء % % 7(@)(@@) % ويوم الجعة التنعيم فيه % % وتزويج الرجال مع النساء % % PageV01P325 البحر : - 1(@)(@@) % طلابك للحظوظ من العناء % فدعها للسفاهة والجباء % 2(@)(@@) % وكد دنياك ما بقيت فيها % % بصافية أرق من الهواء % % 3(@)(@@) % ولا تتبع حميا الكأس نقلا % سوى أعراض أولاد الزناء % % PageV01P326 البحر : - 1(@)(@@) % يا ثوبه الأزرق الذي قد % % فاق العراقي في السناء % 2(@)(@@) % كأنه فيه بدر تم % يشق زرقة السماء % PageV01P327 البحر : - 1(@)(@@) % شاب رأسي ولات حين مشيب % وعجيب الزمان غير عجيب % 2(@)(@@) % فاجعلي موضع التعجب من شي % بي عجبا بفرعك الغربيب % 3(@)(@@) % قد يشيب الفتى وليس عجيبا % أن يرى النور في القضيب الرطيب % 4(@)(@@) % ساءها أن رأت حبيبا إليها % % ضاحك الرأس عن مفارق شيب % 5(@)(@@) % فدعته إلى الخضاب وقالت % % إن دفن المعيب غير معيب % 6(@)(@@) % خضبت رأسه فبات بتبري % % ح وأضحى فظل في تأنيب % 7(@)(@@) % ليس ينفك من ملامة زار % قائل بعد نظرتي مستريب % % 8(@)(@@) % ضلة ضلة لمن وعظته % غير الدهر وهو غير منيب % % 9(@)(@@) % يدري غرة الظباء مريغا % صيد وحشيها وصيد الربيب % % 10(@)(@@) % مولعا موزعا بها الدهر يرمي % % ها بسهم الخضاب غير مصيب % % PageV01P328 11(@)(@@) % عاجز واهن القوى يتعاطى % % صبغة الله في قناع المشيب % % 12(@)(@@) % رام إعجاب كل بيضاء خود % % بسواد الخضاب ذي التعجيب % % 13(@)(@@) % فتضاحكن هازئات وماذا % % يونق البيض من سواد جليب % % 14(@)(@@) % يا حليف الخضاب لا تخدع النف % % س فما أنت للصبا بنسيب % % 15(@)(@@) % ليس يجدي الخضاب شيئا من النف % % ع سوى أنه حداد كئيب % % 16(@)(@@) % فاتخذه على الشباب حدادا % وابك فيه بعبرة ونجيب % % 17(@)(@@) % وفتاة رأت خضابي فقالت % % عز داء المشيب طب الطبيب % % 18(@)(@@) % خاضب الشيب في بياض مبين % % حين يبدو وفي سواد مريب % % 19(@)(@@) % يا لها من غريرة ذات عين % غير مغرورة بشيب خضيب % % 20(@)(@@) % وحقيق لعورة الشيب أن تب % % دو للغر غير ذي التدريب % % PageV01P329 21(@)(@@) % لهف نفسي على القناع الذي مح % % ح وأعقبت منه شر عقيب 