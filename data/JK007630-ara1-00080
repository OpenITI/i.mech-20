ms61	 مكتوب % 34(@)(@@) % يتوارثون مكارما مضرية % إرث النبوة في بني يعقوب % 35(@)(@@) % درجوا عليها آخذين بحكمها % % لم يفسدوا حسناتها بعيوب % 36(@)(@@) % و جرى أبو الحملات يطلب شأوهم % % أكرم به من لاحق وطلوب % 37(@)(@@) % قالوا الهمام فأفرجت أبطالهم % لك عن طريق الضيغم المرهوب % 38(@)(@@) % لقب يصدق فيك معناه اسمه % % و من الرجال مموه التقليب % 39(@)(@@) % لك يا شبيب صباحها ورواحها % % عقر الكماة بها وعقر النيب % 40(@)(@@) % و على سلاحك أو سماحك أركزت % راياتها بفنائها المطلوب % PageV01P179 41(@)(@@) % أصبحت غرة مجدها فبياضه % % مستخرج من لونك الغربيب % 42(@)(@@) % و علامة العربي دهمة وجهه % % و من الوجوه البيض غير حسيب % % 43(@)(@@) % و البدر أشرف طالع في أفقه % % و بياضه المرموق فوق شحوب % 44(@)(@@) % لله بيتك أمنه وجفانه % و الحق بين مخافة وجدوب % 45(@)(@@) % و مكرمات النسل تهون في القرى % % بالمصطفى منها وبالمجنوب % 46(@)(@@) % و إذا الوقود خبا جعلت لحومها % % حطبا لنار الطارق المجلوب % 47(@)(@@) % من كل مشرفة تحدث هامة % و رديفة عن صخرة و عسيب % 48(@)(@@) % الكور في وضح الصباح لظهرها % % و السيف في الظلماء للعرقوب % 49(@)(@@) % حدثت والخبر الجلي مصدق % عن سيبك المتدفق المسكوب % 50(@)(@@) % و شمائل لك في الندى مطبوعة % كالتبر ليس صفاؤه بمشوب % PageV01P180 51(@)(@@) % و بما عرفت فضائلي ووصفتها % % و رغبت في ودي وفي تقريبي % % 52(@)(@@) % فاستاق منك غريب أشعاري إلى % % متوحد في المكرمات غريب % 53(@)(@@) % فبعثتها لك فاتحا ما بيننا % % باب الوصال ونهزة الترغيب % 54(@)(@@) % من كل سارية بذكرك صيتها % % في الأرض بين نوافد وسهوب % 55(@)(@@) % تزداد صبرا في الزمان وقوة % أبدا على الإدلاج والتأويب % 56(@)(@@) % و هي التي شجت الملوك وخودعوا % % منها عن المنفوس والمرغوب % % 57(@)(@@) % فاستقربوها مغرمين بها وما % % تزداد غير تمنع ونكوب % 58(@)(@@) % و تفردت في ذا الزمان بمعجز % لم تؤت من رد ومن تكذيب % 59(@)(@@) % فاعرف لها حق الزياره بغتة % و تلقها بالأهل والترحيب % 60(@)(@@) % و أكرم عليها تجتلب أخواتها % % إن الصلاة تتم بالتعقيب % PageV01P181 61(@)(@@) % طلبتك تأمل أن تنال بك الغنى % % فلئن وفيت لها فغير عجيب % PageV01P182 البحر : - 1 
ms62	(@)(@@) % نظرة منك ويوم بالجريب % حسب نفسي من زمان وحبيب % 2(@)(@@) % فمن الواقف بي بينكما % % جمع الفوق على سهم مصيب % 3(@)(@@) % وقفة لا أشتكي من بعدها % % غلة الصدر ولا ذل الغريب % 4(@)(@@) % يا ابنة الجمرة من ذي يزن % في الصميم العد والبيت الرحيب % 5(@)(@@) % ما لكم لا أجدب الله بكم % % يرتعي جاركم غير الخصيب % 6(@)(@@) % الجدي يمنعه ذو جدة % و الجناب الرحب ينبو بالجنوب % 7(@)(@@) % و رماح دون أضيافكم % تأخذ السالم فيكم بالمريب % 8(@)(@@) % أتقيكم والهوى يقدم بي % % و أغض الصوت والدمع يشي بي % % 9(@)(@@) % و من الشقوة في زورتكم % % أن عين الرمح من عين الرقيب % 10(@)(@@) % لا يكن آخر عهدي بكم % ياولاة القلب ليلات القليب % PageV01P183 11(@)(@@) % يا لمن ينكص عن غزلانكم % % و هو وثاب على الليث الغضوب % 12(@)(@@) % و متى العز وفي أبياتكم % % أعين تقهر سلطان القلوب % 13(@)(@@) % يا صبا نجد ويا بان الغضا % % أرفقا بي بالتثني والهبوب % 14(@)(@@) % و أسلما لا مثل ما طاح دمي % % منكما بين نسم وقضيب % 15(@)(@@) % قسم البين فما عدل بي % % غدرة الوافي وتبعيد القريب % 16(@)(@@) % و قضى الدهر فحالت صبغة % عد ذنب الدهر فيها من ذنوبي % % 17(@)(@@) % و فؤادي يشتكي جور النوى % % و عذاري يشتكي جور المشيب % 18(@)(@@) % كم أداري عنت الأيام في % % غبن حظي وأطاطي للخطوب % 19(@)(@@) % و أرد الحزم في أفحوصه % % و هو هاف يتنزى للوثوب % 20(@)(@@) % قاعدا والجد قد رحل بي % % و المعالي يتقاضين ركوبي % % PageV01P184 21(@)(@@) % جلسة الأعزل يلوى يده % و سلاحي بين كوري وجنيبي % % 22(@)(@@) % أمدح المثرين ظنا بهم % ربما يقمر بالظن الكذوب % 23(@)(@@) % كل وغد الكف منبوذ الحيا % % طيب المحضر مسبوب المغيب % 24(@)(@@) % يمنع الرفد وتلقى وفده % % قحة البخل بإدلال الوهوب % 25(@)(@@) % يطلب المدح لأن يفضحه % و هو قبل المدح مستور العيوب % 26(@)(@@) % قلت للآمال فيه كذبت % أمه إن كنت آمالي فخيبي % % 27(@)(@@) % جلب الأرض عريض دونه % % و سرى العيس وإدمان اللغوب % 28(@)(@@) % و غلام آخذ ما طلبت % نفسه أو فائت كل طلوب % 29(@)(@@) % يقمح الضيم ولو أبصره % ليلة 
ms63	 العشر على الماء الشروب % 30(@)(@@) % ما اذل الخصب في دار الأذى % % و ألذ العز في دار الجدوب % PageV01P185 31(@)(@@) % يا بني كل نعيم ضاحك % في حمى وجه من اللؤم قطوب % 32(@)(@@) % قد مللناكم على شارتكم % % و يضيق الصدر في البيت الرحيب % 33(@)(@@) % و عسى الدنيا التي أدتكم % تصطفينا من بنيها بنجيب % 34(@)(@@) % ماجد الشيمة سهل ليله % للقرى صب إلى الحمد طروب % 35(@)(@@) % يكسب المال لأن يتلفه % و العلا في يد متلاف كسوب % 36(@)(@@) % تخبث الأيدي وفي راحته % من نداه أرج المشتا المطيب % 37(@)(@@) % كابن حماد ولا مثل له % % هل ترى للبدر فردا من ضريب % 38(@)(@@) % جاذب الرواض عن مقوده % مرس تنكره كف الجذيب % 39(@)(@@) % و دعا الناس إلى تسويده % واسع الجمرة وهاج الثقوب % 40(@)(@@) % أين يا سائقها أين بها % % جعجع الآمال في غير عزيب % PageV01P186 41(@)(@@) % جمع الصاحب من أطرافها % % و في حيرى الطرق عمياء النكوب % 42(@)(@@) % ضمها بالرأي حتى التأمت % شلتاها من شذوذ وشذوب % 43(@)(@@) % و يد لا تربت تلك يدا % ربقة الجاني وفك المستنيب % 44(@)(@@) % سلت الدولة منه صارما % % شرق الصفحة ظمآن الغروب % 45(@)(@@) % طبع الأقبال من جوهره % زبرة تقدح نيران الحروب % 46(@)(@@) % لو أطاعته يد حاملة % لم تكذب ظبتاه عن ضريب % 47(@)(@@) % جربوه ماضيا حيث مضى % % صادع الوحي ومحتوم الغيوب % 48(@)(@@) % قلقا ينفي الكرى عن وجهه % علمه أن المعالي في الهبوب % 49(@)(@@) % ألمعيا سودته نفسه % و المساعي قبل تسويد الشعوب % 50(@)(@@) % قدمته صاعدا عن قومه % مصعد اللهذم قدام الكعوب % PageV01P187 51(@)(@@) % هبهبوا منه بليث في الوغى % % قرم الأظفار مشتاق النيوب % 52(@)(@@) % خير من خبت له أو وخدت % للجدى ذات سنام وسبيب % 53(@)(@@) % يأخذ الحاجات من حيث غلت % غير معذول على حب الغصوب % 54(@)(@@) % تحسب الغابة مما اجتره % حومة بين عقير وتريب % 55(@)(@@) % ماضيا لم يثنيه عن قصده % هجمة الليل ولا طول الدؤوب % 56(@)(@@) % جمع الجود إلى البأس كما % % شعشعت نار بماء في قضيب % 57(@)(@@) % راحة لم يعلق البخل بها % % و فؤاد لم يسفه بالوجيب % 58(@)(@@) % و لسان يخصم السيف به 
ms64	 % يترك الفارس عبدا للخطيب % % 59(@)(@@) % من رسول سعدت رحلته % يوم أدعوه بلبيك مجيبي % % 60(@)(@@) % ناصح الجيب بما حملته % حيث يخشى مرسل غش الجيوب % PageV01P188 61(@)(@@) % لم أكلفه سرى البيد ولم % % أتعسفه بأخطار السهوب % 62(@)(@@) % عيسه ملمومة يركب منها % % مطمئنا ظهر مذلال ركوب % 63(@)(@@) % تقسم الماء بياع مطلق % و فقار مرسل الحبل سروب % 64(@)(@@) % صعبة الخلقة سهل أرضها % % فهو بين اللين منها والصليب % 65(@)(@@) % ساريا ليست عليه خيفة % ما وقاه الله سورات الجنوب % 66(@)(@@) % قل لنوتيك شرع آمنا % % حدث التيار والموج العصيب % 67(@)(@@) % رد بها ميسان واحبسها على ال % % معقل الممنوع والوادي العشيب % 68(@)(@@) % فإذا ضاقت فعلقها أبا % % طاهر تعلق بفراج الكروب % 69(@)(@@) % و إلى ذي الرتبتين ابتدرت % فرص المجد وحاجات الأريب % 70(@)(@@) % قل له عني حيتك العلا % % بوكيف من حيا الشكر صبيب % PageV01P189 71(@)(@@) % و سقى عرضك ما استسقيته % % بارق من مدحى غير خلوب % 72(@)(@@) % ترفل الأحساب في روضته % مرفل الغادة في البرد القشيب % 73(@)(@@) % خير ما استثمر من غرس الندى % % و اجتنى من غصن الجود الرطيب % 74(@)(@@) % و بذلت الوفر حتى اتبعته % هم آدابك من حسن وطيب % 75(@)(@@) % جاءني أنك مشعوف به % % شعف العذري بالخشف الربيب % 76(@)(@@) % راغبا أن تصطفى من جده % % و الفكاهات بمدح أو نسيب % 77(@)(@@) % و تحلى منه عقدا باقيا % % فخره في كل جيد وتريب % 78(@)(@@) % قلت فضل عجب من دهرنا % % و هو من فاعله غير عجيب % 79(@)(@@) % ما تبالي حين تستام العلا % % أخطيب الشمس أم أنت خطيبي % % 80(@)(@@) % أنا من يعطيك مجدا حاضرا % % و يبقي لك مجدا في العقيب % PageV01P190 81(@)(@@) % لا كقول يطرد الساقي به % % جذوة تخمد من قبل اللهيب % 82(@)(@@) % كم يميني على سلطانها % % نفس مرجو ومخشى مهيب % 83(@)(@@) % و ابتغي بالمال أن يشريني % % فترفعت فطارت عفتي بي % % 84(@)(@@) % لكن اشتقت وقد سميت لي % % بسمات الفضل والجود الغريب % 85(@)(@@) % فاقترع خير هدى وأثب % خير ما جادت به نفس مثيب % 86(@)(@@) % و إذا صرت نصيبي منهم % فقد استوفيت من دهري نصيبي % % PageV01P191 البحر : - 1(@)(@@) % نرق وتقسو بالغوير قلوب 
ms65	 % و نسأل سكان الغضا ونخيب % 2(@)(@@) % و تهفو على ذات النقا بحلومنا % % وجوه تريح الوجد وهو عزيب % 3(@)(@@) % وقفنا ومنا رابط جأش قلبه % بريء ومحلول العزاء مريب % 4(@)(@@) % تجاذبنا أيدي الحمية والهوى % % و نأبى على الأشواق ثم نجيب % 5(@)(@@) % نغالط ألحاظ المها عن قلوبنا % % و بالرمل قاري السهام مصيب % 6(@)(@@) % إذا أخفق القناص راح بكل ما % % يرى مطعم للصيد منه كسوب % 7(@)(@@) % قضى من دماء ما استحل وحلقت % به نية عما أشاط شعوب % 8(@)(@@) % فما هو بعد العنف إلا علالة % أحاديث نفس تفتري وتحوب % 9(@)(@@) % تسرك منها والدجى في قميصه % % زخارف يحلو زورها ويطيب % 10(@)(@@) % فتطرب والشادي بها سامر المنى % % و تشرب ما يسقى وجفنك كوب % PageV01P192 11(@)(@@) % حمى الله عينا من قذاها على الحمى % % تجف ضروع المزن وهي حلوب % 12(@)(@@) % إذا قلت أفنى البرق جمة مائها % % مراها مرور البرق وهي جنوب % 13(@)(@@) % بكت وغدير الحي طام فأصبحت % % عليه المطايا الحائمات تلوب % 14(@)(@@) % و ما خلت قبلي أن عينا ركية % و لا أن ملح الماقيين شروب % 15(@)(@@) % و ليلة ذات البان ساهرت طالعا % % من النجم لم يكتب عليه غروب % 16(@)(@@) % أسائل عن نومي وضوء صباحها % % و أعيا فأي الغائبين يؤوب % 17(@)(@@) % سرت تخبط الوادي إلى وصحبتي % % طريح على أقتابه وكئيب % 18(@)(@@) % أناخوا إلى تعريسة قل عمرها % % فما هي إلا خفقة وهبوب % 19(@)(@@) % فللريح منهم أعين ومسامع % و للترب منهم أذرع وجنوب % 20(@)(@@) % فزارت فحيت ممسكا بفؤاده % له نازع من شوقه وجذيب % PageV01P193 21(@)(@@) % فيا لك باقي ليلة لو تخلصت % من الغش يقذي صفوها ويشوب % 22(@)(@@) % و لكن نهاني الخوف قم أنت مدرك % و صاح الظلام الصبح منك قريب % 23(@)(@@) % و لم أدر أن القرب عين حفيظة % على ولا أن الوصال رقيب % 24(@)(@@) % يخوفني عض الزمان ومنكبي % % رديد على حمل الزمان جليب % 25(@)(@@) % تعودته لا خاضعا لخطوبه % % و كيف وكل العيش فيه خطوب % 26(@)(@@) % و كم غمزة في جانبي لم أقل لها % % ألمت وجرحى لو شكوت رغيب % 27(@)(@@) % تعمق فيها مخلبا ومنيبا % % و 
ms66	 أقلع والنبع الأصم صليب % 28(@)(@@) % و هل أتغطى منه خوفا وموئلي % % جناب منيع للوزير رحيب % 29(@)(@@) % و دوني منه إن مشى نحوي الأذى % % طراب تدمى الناعلات ولوب % 30(@)(@@) % و حصداء من نعماه كل مسدد % له حيد عن سردها ونكوب % PageV01P194 31(@)(@@) % حماني من الأيام أروع لو حمى % % سبابي لم يقدم عليه مشيب % 32(@)(@@) % رعى شرف الدين العلا برعايتي % % فما شم ريحا حول سرحي ذيب % 33(@)(@@) % أثر بزلها يا طالب المجد والغنى % % و خاطر بها فابن الخطار نجيب % 34(@)(@@) % و طرق هواديها الجبال وخلها % % تجوب مع الظلماء حيث تجوب % 35(@)(@@) % تقدم بها فالسعد بالمرء مقبل % و لا تتهيب فالشقاء هيوب % 36(@)(@@) % أقم بني عبد الرحيم صدورها % % إذا حط منها أو أمال لغوب % 37(@)(@@) % و غن بهم أسماعها إن حدوتها % % تحن إذا حنت لتطرب نيب % 38(@)(@@) % ففي العيس قلب مثل قلبك ماجد % و سمع إلى ذكر الكرام طروب % 39(@)(@@) % تميم أعالي دجلة فانح شامة % بحيث تبل العيش وهو جديب % 40(@)(@@) % و ناص بها فرع الدجيل فعنده % % مراد يعم الرائدين عشيب % PageV01P195 41(@)(@@) % و قل لعميد الدولة اسمع فإنها % % ملاحم إن فتشتها وخطوب % 42(@)(@@) % لحظت ذرا أعجازها من صدورها % % و بعض ظنون الألمعي غيوب % 43(@)(@@) % و داويتها بالرأي حتى كفيتها % % و ما كل آراء الرجال طبيب % 44(@)(@@) % عجلت لها مستأنيا ما وراءها % % و للآمر باد ظاهر وعقيب % 45(@)(@@) % خلصت خلوص التبر منها مسلما % عليك وميض صادع ولهيب % 46(@)(@@) % و قالوا خطاء مسرعا متعجلا % % و قد يتأنى في الأمور طلوب % 47(@)(@@) % و أهون بالتغرير فيها كأنه % % بجد الخطوب المثقلات لعوب % 48(@)(@@) % و ما علموا أن السهام موارق % و لا أن خطوات الأسود وثوب % 49(@)(@@) % سهرت ونام الغمر عما رأيته % ففزت وطرف الألمعي رقوب % 50(@)(@@) % كأن لك اليوم المنعم صبحة % و يوم الحريص المستغر عصيب % PageV01P196 51(@)(@@) % و قالوا طوى بغداد بغضا وسلوة % و بغداد مغنى للحياة خصيب % 52(@)(@@) % و ظنوك إذ فارقتها أن قلبها % % على قلة الإعراض عنك يطيب % 53(@)(@@) % و قد تظعن الأشخاص والحب قاطن % و 
ms67	 يكثر هجر البيت وهو حبيب % 54(@)(@@) % و ما الملك إلا جنة عم نورها % % و مذ غبت عنها سهمة وشحوب % 55(@)(@@) % فكيف غدت شلاء لا بدم العدا % % و لا بعطار الغانيات خضيب % 56(@)(@@) % بكى وحشة وهو المغيض دموعه % و أن لحر الجرح وهو ضريب % 57(@)(@@) % و كنت له وجها ضحوكا فبشره % عبوس وقد فارقته وقطوب % 58(@)(@@) % يورى حياء والندامة غصة % لها خدشة في صدره وندوب % 59(@)(@@) % إلى ماجد في صدره قمر الدجى % % إذا تم راض والهزبر غضوب % 60(@)(@@) % تقبل منه راحة تقتل الصدى % % تعلم منها المزن كيق يصوب % PageV01P197 61(@)(@@) % رست في الندى حتى استقرت عروقها % % من البحر والعرق الكريم لصوب % 62(@)(@@) % يد تعجب الأقلام من أنس سيفه % بها وهو فيما بينهن غريب % 63(@)(@@) % إذا اختصموا قالت تأخر فإنما % % لنا السبق فاتبعنا وأنت جنيب % 64(@)(@@) % فيأبى له الحد المصمم أنه % % يؤخر والأقلام عنه تنوب % 65(@)(@@) % و تجري هنات بينهن وبينه % % يحكم فيها فارس وخطيب % 66(@)(@@) % فيجعل للأقلام فيها نصيبها % % بحق وللسيف الحسام نصيب % 67(@)(@@) % و قد زعموا أن الحجا متكهل % و أن رجالات السيادة شيب % 68(@)(@@) % فلله منك المنتهى في إقباله % و من رب أمر الناس وهو ربيب % 69(@)(@@) % و من بسقت أغصانه فتفرعت % على الشجر العادي وهو قضيب % 70(@)(@@) % و لا تبل أثواب الوزارة بعد ما % % كستك بها الأيام وهي سليب % PageV01P198 71(@)(@@) % تقصمها قوم وما خلقت لهم % % فهانوا ومن بعض الجمال عيوب % 72(@)(@@) % أتتك فصار الرق في يد مالك % و قد دنستها بذلة وغضوب % 73(@)(@@) % و سالم معناها بسوددك اسمها % % و بينهما في آخرين حروب % 74(@)(@@) % تنافى بيوت معشر وبيوتها % % و أنت لها في جانبيك نسيب % 75(@)(@@) % فما بيت إسماعيل عنها بنازح % و لا أن بها عبد الرحيم غريب % 76(@)(@@) % فلو هب ميت من كراه فقام أو % % تطلع مرموس الجبين تريب % 77(@)(@@) % لقرت عيون أو لسرت مضاجع % بأنك ميراث لها وعقيب % 78(@)(@@) % إذن لرأت منك الذي الشمس لا ترى % % بأنجمها في الأفق حين تغيب % 79(@)(@@) % نشرت لهم فخرا يعيش حديثه % و 
ms68	 يخلق عمر الدهر وهو قشيب % 80(@)(@@) % لئن عم شر أو أسرت ضغائن % ببغي فإن الله عنك حسيب % PageV01P199 81(@)(@@) % و قد علمت نجوى رقاك عقارب % لها نحوكم تحت الظلام دبيب % 82(@)(@@) % و لم تك إلا هفوة واستقالها ال % % زمان وذنبا وهو منه يتوب % 83(@)(@@) % و لا بد للإقبال من يوم عودة % تدافع عنه العين حين تصيب % 84(@)(@@) % و كم رافع لي بالعداوة صوته % يهبهب في إبعاده ويهيب % 85(@)(@@) % قويا على ظلمي بسيف عدوكم % % و عهدي به بالأمس وهو يخيب % 86(@)(@@) % يظن وحشاكم عراي تقطعت % و أني أخيذ والزمان طليب % 87(@)(@@) % و أن قناتي بعدكم ستلينها % % ضروس له مذروبة ونيوب % 88(@)(@@) % و لم يدر أن الشام لو حال دونكم % % و زيلته عنكم لكنت أصيب % 89(@)(@@) % فقلت لفيك الترب أو فوقك الحصى % % تغيب أسود الغاب ثم تؤوب % 90(@)(@@) % غدا تطلع الرايات والنصر تحتها % % كتيبا يوليه النجاح كتيب % PageV01P200 91(@)(@@) % ترى المجد في أطرافها خافق الحشا % % سرورا بما ضمت وأنت كئيب % 92(@)(@@) % و بغداد طلق وجهها متبسم % و للملك من بعد الخمود شبوب % 93(@)(@@) % بشائر لي في مثلهن مواقف % أصدق فيها والزمان كذوب % 94(@)(@@) % مجرية فيكم كأن عيونها % % لها خلف أستار الغيوب ثقوب % 95(@)(@@) % تمر لكم طيرى يمينا بزجرها % % على مشهد مني وحين أغيب % 96(@)(@@) % نشدتكم بالله كيف رأيتم % مناجحها والعائفات تخيب % 97(@)(@@) % فقولوا نعم وفقت وأرعوا ذمامها % % غدا وغد للناظرين قريب % 98(@)(@@) % بكم يا بني عبد الكريم أنجلي القذى % % و أصبح وعر الجود وهو لحيب % 99(@)(@@) % إذا أجدبت أرضى وسدت مواردي % % فعنكم لي روضة وقليب % 100(@)(@@) % و لما رأيت الحب في الهزل سنة % عشقتكم والعاشقون ضروب % PageV01P201 101(@)(@@) % فمن يعط منكم طالبا فوق حقه % فحقي دين لازم ووجوب % 102(@)(@@) % فلا قلصت عني سحائب ظلكم % % فمنها مرذ تارة وسكوب % 103(@)(@@) % و لا عدمتكم نعمة خلقت لكم % % و دنيا لكم فيها الحياة تطيب % 104(@)(@@) % يزوركم النيروز مقتبل الصبا % % و قد دب في رأس الزمان مشيب % 105(@)(@@) % تصوح أغصان الأعادي وغصنكم % % من السعد ريان النبات رطيب % 106(@)(@@) % دعاء 
ms69	 حيالى فيه ألف مؤمن % توافق منهم ألسن وقلوب % PageV01P202 البحر : - 1(@)(@@) % ألا من مبلغ أسدا رسولا % % متى شهد الندى فما أغيب % 2(@)(@@) % و عوف منهم أربي فعوف % عيون خزيمة وهم القلوب % 3(@)(@@) % أفرسان الصباح إذا اقشعرت % من الفزع السنابك والسبيب % 4(@)(@@) % و ضاق مخارج الأنفاس حتى % % تفرج عن سيوفكم الكروب % 5(@)(@@) % و يا أيدي الحيا والعام جدب % و وجه الأرض مغبر قطوب % 6(@)(@@) % مجازر تفهق الجفنات منها % % و نار قرى شرارتها لهيب % 7(@)(@@) % إذا جمد الضيوف تكفلتهم % % لها فلذ وأسنمة تذوب % 8(@)(@@) % و يا أقمار عدنان وجوها % % يشف على وضاءتها الشحوب % 9(@)(@@) % أصيخوا لي فلي معكم حديث % عجيب يوم أنثوه غريب % 10(@)(@@) % متى أنصفتم فالحق فيه % % عليكم واضح لي والوجوب % PageV01P203 11(@)(@@) % و إن أعرضتم ورضيتموه % فإن المجد ممتعض غضوب % 12(@)(@@) % حديث لو تلوه على زهير % غدا من مدحه هرما يتوب % 13(@)(@@) % بأي حكومة وبأي عدل % أصاب من القريض ولا أصيب % 14(@)(@@) % و كم أعراضكم تزكو بمدحي % % و تنجح والمنى فيكم تخيب % 15(@)(@@) % تردون الغصوب بكل أرض % و توجد في بيوتكم الغصوب % 16(@)(@@) % و تحمون البلاد وفي ذراكم % % حريم الشعر منتهك سليب % 17(@)(@@) % و عندكم لكل طريد قوم % جوار مانع وفري رحيب % 18(@)(@@) % و أبكار وعون من ثنائي % % عجائف عيشها فيكم جديب % 19(@)(@@) % محببة إذا رويت فإما % % طلت مهورهن فلا حبيبي % 20(@)(@@) % إذا أحسنت في قول أساء ال % % فعال كأن إحساني ذنوب % PageV01P204 21(@)(@@) % أجر المطل عاما بعد عام % مواعد برقها أبدا خلوب % 22(@)(@@) % و يا للناس أسلب كل حي % كرائمه ويسلبني شبيب % 23(@)(@@) % أمد اليه أرشية المعالي % % فيعطشني وراحته القليب % 24(@)(@@) % و ألبسه ثياب المدح فخرا % % فيمسك لا يجيب ولا يهيب % 25(@)(@@) % و يسمح خاطري فيه ابتداء % و يمنع وهو بذال وهوب % 26(@)(@@) % و لم نعرف غلاما مزيديا % يناديه السماح فلا يجيب % 27(@)(@@) % و لو ناديت من كثب عليا % تدفق ذلك الغيث السكوب % 28(@)(@@) % و من على عوائده القدامى % % مضي الريح جد به الهبوب % 29(@)(@@) % و لو حماد يزقو لي صداه % % لأكرم 
ms70	 ذلك الجسد التريب % 30(@)(@@) % أصولكم وأجدر إذ شهدتم % % مقام علائهم ألا يغيبوا % % PageV01P205 31(@)(@@) % فما لك يا شبيب خلاك ذم % تجف وعندك الضرع الحلوب % 32(@)(@@) % و ما لخريدة خفيت لديكم % % تكاد على طفولتها تشيب % 33(@)(@@) % محللة النكاح بى صداق % و ذلك عندكم إثم وحوب % 34(@)(@@) % يطيب الشيء مرتحضا مباحا % % و مرتخص المدائح لا يطيب % 35(@)(@@) % فأين حياء وجهك يوم تحدى % % بها في وصفك الإبل اللغوب % 36(@)(@@) % و أين حياء وجهك في البوادي % % إذا غنى بها الشادي الطروب % 37(@)(@@) % و كيف تقول هذا وصف مجدي % % فلا أجدي عليه ولا أثيب % 38(@)(@@) % و كم نشرت على قوم سواكم % % فلم يعلق بها الرجل الطلوب % 39(@)(@@) % و راودني ملوك الناس عنها % % و كل باذل فيها خطيب % 40(@)(@@) % فلم يكشف لها وجه مباح % و لم يعرف لها ظهر ركوب % PageV01P206 41(@)(@@) % فلا يغررك منها مس صل % يلين وتحت هدأته وثوب % 42(@)(@@) % أخاف بأن يعاجلني فيطغى % % فتصبح بالذي تثني تعيب % 43(@)(@@) % و تشرد عنكم متظلمات % و تبغون الإياب فلا تؤوب % PageV01P207 البحر : - 1(@)(@@) % جاء بها والخير مجلوب % طيف على الوحدة مصحوب % 2(@)(@@) % طوى الفى يركب أشواقه % % و الشوق في الأخطار مركوب % 3(@)(@@) % ساعة لا مسرى على شقة % تعيا بها البزل المصاعيب % 4(@)(@@) % يرغب في الظلماء مستأنسا % % و جانب الظلماء مرهوب % 5(@)(@@) % أحسن بي حتى تخيلته % % أصدق شيء وهو مكذوب % 6(@)(@@) % أني تسديت لنا باللوى % % وصارة دارك فاللوب % 7(@)(@@) % و بيننا عمياء من أرضكم % % دليلها أبله مسلوب % 8(@)(@@) % لا يهتدى الذئب إلى رزقه % فيها ولو شم بها الذيب % 9(@)(@@) % فزرت شعثا طاف ساقي الكرى % % عليهم والطاس والكوب % 10(@)(@@) % فما تدلى النجم حتى التوى % % مماكس منهم وشريب % PageV01P208 11(@)(@@) % بت ورحلي بك ريحانة % نم عليها الحسن والطيب % 12(@)(@@) % كأنما ذيل الصبا فوقها % % بالقطر أو ذيلك مسحوب % 13(@)(@@) % يا ابنة قوم وجدوا ثأرهم % % عندي بها والثأر مطلوب % 14(@)(@@) % لولاك والأيام دوالة % ما استعبد الفرس الأعاريب % 15(@)(@@) % أراجع لي بضمان المنى % % ملحوب أو ما ضم ملحوب % 16(@)(@@) % و صالحات من ليالي الحمى % % ما شابها 
ms71	 إثم ولا حوب % 17(@)(@@) % لهوى نسك ووجوه الدمى % % تحت دجاها لي محاريب % 18(@)(@@) % و ذاهل عاب حنيني لها % % و لم يعب أن حنت النيب % 19(@)(@@) % قال سفاه ذكر ما قد مضى % % و ظن أن اللوم تأديب % 20(@)(@@) % ما لك لا أحببت إلا ومن % % فوقك سوط العذل مصبوب % PageV01P209 21(@)(@@) % إن أبك أمرا بعد ما فاتني % % فقد بكى قبلي يعقوب % 22(@)(@@) % و أنكر الصبوة من شائب % حتى كأن ما صبت الشيب % 23(@)(@@) % و هل عدتني شيبة في الحشا % % إذ مفرقي أسود غربيب % 24(@)(@@) % لا لاقط فيها ولا خاضب % و الشيب ملقوط ومخضوب % 25(@)(@@) % يغلب فيها الحب أمر النهى % % و الحزم بالأهواء مغلوب % 26(@)(@@) % أما تقنعت بها رثة % لابسها عريان مسلوب % 27(@)(@@) % تلاقت الأوجه مقتا لها % % عني فمزور ومقطوب % 28(@)(@@) % ناصعة في العين لكنها % % تبغض والناصع محبوب % 29(@)(@@) % فقد أراها وضيا وجهها % % لي شرك في البيض منصوب % 30(@)(@@) % أيام في قوس الصبا منزع % و نبله المكنون منكوب % PageV01P210 31(@)(@@) % و قد أزور الحي مستقبلا % لي منه تأهيل وترحيب % 32(@)(@@) % و أغشم البيت بلا آذن % و هو على الأقمار مضروب % 33(@)(@@) % و أشهد النادي فمستعبد ال % % سمع بآياتي ومخلوب % % 34(@)(@@) % و موصد الأبواب ناديته % حتى بدا لي وهو محجوب % 35(@)(@@) % خادعت من سلطانه صخرة % فانجبست لي وهي شؤبوب % 36(@)(@@) % و رحت عنه والذي يملك ال % % مملوك والغاصب مغصوب % 37(@)(@@) % فاليوم إن صرت إلى ما ترى % % فهي الليالي والأعاجيب % 38(@)(@@) % آنسني بالعدم توفيره % عرضي وأن المال موهوب % 39(@)(@@) % جربت قوما فتجنبتهم % % و رسل العقل التجاريب % 40(@)(@@) % و زادني خبرا بمن أنقى % % أني بمن آمن منكوب % PageV01P211 41(@)(@@) % قل لأخي الحرص أسترح إنما % % حظك إدلاج وتأويب % 42(@)(@@) % إذا الحظوظ انصرفت جانبا % % لم يغن تصعيد وتصويب % 43(@)(@@) % مالك تحت الهون مسرزقا % % و إنما رزقك مكتوب % 44(@)(@@) % لا تذهبن اليوم في ذلة % فاليوم من عمرك محسوب % 45(@)(@@) % و إن جهدت النفس في مكسب % فالمجد إن المجد مكسوب % 46(@)(@@) % جد ابن أيوب ولو قد ونى % % كفاه ما شيد أيوب % 47(@)(@@) % رأى 
ms72	 رويد السير عجزا به % % فسيره حضر وتقريب % 48(@)(@@) % سما إلى المجد فقال العدا % % له طريق فيه ملحوب % 49(@)(@@) % ساد طرير الماء حتى انتهى % % و الشيب في فوديه ألهوب % 50(@)(@@) % و الرمح لا يذرع إلا إذا % % تكاملت فيه الأنابيب % PageV01P212 51(@)(@@) % أضحى وزير الدين ذا مغرم % وزارة الدنيا وتعذيب % 52(@)(@@) % رتبة عز فخرها عاجل % و أجرها ذخر وتعقيب % 53(@)(@@) % ما هجمت غشما ولا ضره % % تدرج فيها وترتيب % 54(@)(@@) % وزارة ما زال من قومه % % معرق فيها ومنسوب % 55(@)(@@) % أبنا عباس و أيوب مذ % % تفرعوا رب ومربوب % 56(@)(@@) % خلائف الله وأنصارهم % % فصاحب طاب ومصحوب % 57(@)(@@) % لا ودهم غل ولا حبلهم % يوما بغدر الكف مقضوب % 58(@)(@@) % جارهم يؤكل في جورهم % % و ما لهم بالإفك منهوب % 59(@)(@@) % و ما على مقص سواكم إذا % % أدناكم في الرأي تثريب % 60(@)(@@) % لا تلكم العادات منكم ولا % % أسلوبكم تلك الأساليب % PageV01P213 61(@)(@@) % باسم عميد الرؤساء الذي % % ما زاد في معناه تلقيب % 62(@)(@@) % رد عليها بعد ما أيمت % أبناؤها الغر المناجيب % 63(@)(@@) % اكف الذي استكفوك واحمل لهم % % ما تحمل الصم الأهاضيب % 64(@)(@@) % ململم الجنب أمين القوى % % و كلهم أدبر مجلوب % 65(@)(@@) % و قد أعاديك بأرسانهم % % قسرا فمركوب ومجنوب % 66(@)(@@) % و ارتع من الدولة في ظلة % رواقها بالعز مطنوب % 67(@)(@@) % محمية الروضة مرقية % % و الروض بالرعيان مسلوب % 68(@)(@@) % أفياؤها فيح وماء الحيا % % في ظلها السابغ مسكوب % 69(@)(@@) % و اصحب من النيروز يوما يفي % % بالعز إن خان الأصاحيب % 70(@)(@@) % يكر بالإقبال ما خولفت % صدور دهر وأعاقيب % PageV01P214 71(@)(@@) % يغشاكم يخدم إقبالكم % % ما حن للفرجة مكروب % 72(@)(@@) % لا تستجيرون بعمرو ولا % % واعدكم بالعمر عرقوب % PageV01P215 البحر : - 1(@)(@@) % من ناظر لي بين سلع و قبا % كيف أضاء البرق أم كيف خبا % 2(@)(@@) % نبهني وميضه ولم تنم % عيني ولكن رد عقلا عزبا % % 3(@)(@@) % قرت له بنات قلبي خافقا % % و استبردته أضلعي ملتهبا % % 4(@)(@@) % كأنه يجلو ثنايا بالغضا % % روقا وينهل لمى أو شنبا % % 5(@)(@@) % يا لعبد من منى دنا به % % يوهمني الصدق بريق كذبا % % 6(@)(@@) % و لنسيم سحر بحاجر % ردت 
ms73	 به عهد الصبا ريح الصبا % % 7(@)(@@) % ألية ما فتح العطار عن % % أعبق منه نفسا وأطيبا % % 8(@)(@@) % سل من يدل الناشدين بالغضا % % على الطريد ويرد السلبا % % 9(@)(@@) % أراجع لي والمنى هلهلة % فطالع نجم زمان غربا % % 10(@)(@@) % و طوفة بين القباب بمنى % لا خائفا عينا ولا مرتقبا % % PageV01P216 11(@)(@@) % مستقبلا بهاهنا وهاهنا % % مقترعا على أو مجتذبا % % 12(@)(@@) % ألقى الوصال مسفرا لي وجهه % و الغدر لي مع قبحه متنقبا % % 13(@)(@@) % هناك من باع الغواني حلمه % بالخرق عد الحازم المجربا % % 14(@)(@@) % و لائم ملتفت عن صبوتي % % ينكرها ولو أحب لصبا % % 15(@)(@@) % إذا نسبت بهواي ساءه % % مصرحا ولو كنيت غضبا % % 16(@)(@@) % و ما عليه أن غرمت بابلا % % بحاجر و فاطما بزينبا % % 17(@)(@@) % يلومني لا مات إلا لائما % % أو عاش عاش بالهوى معذبا % % 18(@)(@@) % قال عشقت أشيبا يعدها % % منقصة نعم عشقت أشيبا % % 19(@)(@@) % هل شعر بدلته بشعر % مبدلي من أرب لي أربا % % 20(@)(@@) % أبى الوفاء والهوى وبالغ % معذرة من سيم غدرا فأبى % % PageV01P217 21(@)(@@) % ما أنا من صبغة أيامكم % و لا الذي إن قبلوه انقلبا % % 22(@)(@@) % و لا ابن وجهين ألم حاضرا % % من الصديق وألوم الغيبا % % 23(@)(@@) % قلبي للإخوان شطوا أو دنوا % % و للهوى ساعف دهر أو نبا % % 24(@)(@@) % من عاذري من متلاش كلما % % أذنب يوما وعذرت أذنبا % % 25(@)(@@) % يضحك في وجهي ملء فمه % و إن أغب وذكر اسمي قطبا % % 26(@)(@@) % يطير لي حمامة فإن رأى % % خصاصة دب ورائي عقربا % % 27(@)(@@) % ما أكثر الناس وما أقلهم % % و ما أقل في القليل النجبا % % 28(@)(@@) % ليتهم إذ لم يكونوا خلقوا % % مهذبين صحبوا المهذبا % % 29(@)(@@) % فعلمتهم نفسه كيف العلا % % و وده كيف الصديق المجتبى % % 30(@)(@@) % و وردوا من خلقه ويده % أبرد ما بل الصدى وأعذبا % % PageV01P218 31(@)(@@) % مثل أبي المنصور فلتلذ لي ال % % دنيا ولا سر سواه ابن أبا % % 32(@)(@@) % أتركه لي غنيمة باردة % يا دهر واذهب ببنيك سلبا % % 33(@)(@@) % الله جار لفتى أجارني % % على زمان لم أفته هربا % % 34(@)(@@) % و فرجت عني يدا إسعاده % حوادثا ضغطنني ونوبا % % 35(@)(@@) % لما رأى الأيام 
ms74	 في صروفها % % نارا تشب ورآني حطبا % % 36(@)(@@) % قام لها يصلي بها وناشني % % فلم أذق حدا لها ولا شبا % % 37(@)(@@) % و صان وجهي لاقيا بوجهه % % ذل السؤال وكفاني الطلبا % % 38(@)(@@) % عفت فلم أشرب سوى أخلاقه % % إذا كؤس الشرب دارت نخبا % % 39(@)(@@) % و صح لي جوهرة من معدن % أملس لا ينبت إلا الذهبا % % 40(@)(@@) % من معشر تنمى العلا اليهم % هم أهلها والناس منها غربا % % PageV01P219 41(@)(@@) % كما اقترحت حربهم وسلمهم % % شدوا رباط الخيل أو شدوا الحبا % % 42(@)(@@) % ساسوا يعدون الملوك واحتبوا % % وسط الندى يصفون العربا % % 43(@)(@@) % يرضيك من حديثهم ساهدهم % % و في القديم ما سألت الكتبا % % 44(@)(@@) % إذا رجال طأطأ اللؤم بهم % % قعصا فشموا بالأنوف الركبا % % 45(@)(@@) % طالوا ينالون ثعالب القنا % % تحسب ماشيهم بسوقا ركبا % % 46(@)(@@) % و حدثت فروعهم عن أصلهم % % تحدث الناجم عما غربا % % 47(@)(@@) % لبيك مشكورا كما لبيتني % % و قد دعوت قذفا لا كثبا % % 48(@)(@@) % و كنت لي بابا إلى مطالبي % % لولا قعود الحظ بي وسببا % % 49(@)(@@) % تعجب الناس وقد وليتها % % أكرومة فقلت لا لا عجبا % % 50(@)(@@) % عيني مني ويدي فهل ترى % % يفوتني ما سلما ما طلبا % % PageV01P220 51(@)(@@) % و كيف لا تحفزه لأربي % % مودة تمت فعادت نسبا % % 52(@)(@@) % و مقة لو خلصت لابن أبي % % منى هز عطفه وطربا % % 53(@)(@@) % و إن يكن هوم فيها ناسيا % % و عاج عن طريقها وجنبا % % 54(@)(@@) % و قدحت في أملي عندهم % قادحة لم يك فيها مذنبا % % 55(@)(@@) % فقد قبلت العذر أو قتلته % علما وقد عاتبته فأعتبا % % 56(@)(@@) % و استقبل الرأي وأعطى ذمة % تصفح للآنف عما ذهبا % % 57(@)(@@) % فاشكر لها وكالة مني على % % نفسي واقض دينها إذ وجبا % % 58(@)(@@) % من لك مثلي بأخ مسامح % ترضيه بالعذر إذا ما غضبا % % 59(@)(@@) % و احذر على مجدك أخرى تنتقي % % عظم الوفاء وتجر الريبا % % 60(@)(@@) % شمر عن الساقين في استداركها % % و امح بوادي شرها معتقبا % % PageV01P221 61(@)(@@) % و لا يزال أملي يقنع لي % % بدون ما سد خصاصي نشبا % % 62(@)(@@) % ذاك ودعني شاكيا وسائلا % % و خذ حديثي منسبا % % 63(@)(@@) % كان جناح الشوق أمس 
ms75	 طائري % % منسرا في كبدي مخلبا % % 64(@)(@@) % و أكل البين سمين جلدي % % حتى غدا سنام صدري ذنبا % % 65(@)(@@) % بان بك العيش الذي يسرني % % و عاد لما عدت لي مقتربا % % 66(@)(@@) % قال البشير قادما فقلت من % قال أبو منصور قلت مرحبا % % 67(@)(@@) % و قمت لا أملك ما يسعه % غير نعمت من جزاء وحبا % % 68(@)(@@) % أرشف من فيه مكان اسمك لا % % أحسبني أرشف إلا الضربا % % 69(@)(@@) % عطف من الأيام لي ونظر % جاء وما كنت له محتسبا % % 70(@)(@@) % لكنني بالبعد في أثنائه % % أصبح أو أمسى مروعا متعبا % % PageV01P222 71(@)(@@) % إذا اطمأنت أضلعي تذكرت % نواك فاهتزت جوى لا طربا % % 72(@)(@@) % فادفع به صدرك ما استطعته % يوما ترد شمل أنسى شعبا % % 73(@)(@@) % راخ يديك في امتداد حبله % و طاول الوقت به أن يجذبا % % 74(@)(@@) % و خف على قلبي غدا من وقفة % يكون لي فيها الوداع العطبا % % 75(@)(@@) % و لا تدعني أسأل الركبان عن % % قلب دو وأستطب الكتبا % % 76(@)(@@) % لا أقفرت منك ربوع عمرت % أنسا ولا أيبس عيش رطبا % % 77(@)(@@) % و لا برحت مالكا مقتسرا % % نواصي الإقبال أو مغتصبا % % 78(@)(@@) % حتى يكون باديا وحاضرا % % بين النجوم بانيا مطنبا % % PageV01P223 البحر : - 1(@)(@@) % أبلغ بها أمنية الطالب % فالرزق بين الردف والغارب % 2(@)(@@) % و لا تذمم لوجاها فما ال % % راحة يوما في مطا اللاغب % 3(@)(@@) % ليلتها في الدائب المنتقي % % بغامها في السارح العازب % 4(@)(@@) % حداؤها في الركب أحظى لها % % من نعقة الراعي أو الراكب % 5(@)(@@) % فاوت بين الطير حالاتها % % من باطش أو فرق هائب % 6(@)(@@) % فالخسف للجاثم في وكره % و الخصب للقاطع والكاسب % 7(@)(@@) % أفلح من داوس طرق العلا % % موفقا للسنن اللاحب % % 8(@)(@@) % تعجبه الفضلة في ماله % % ما لم تشبها منة الواهب % % 9(@)(@@) % ذلك في المولى غدا في العدا % % مثلبة فاسدد فم الثالب % 10(@)(@@) % خوفي من العائب لي نجوة % من الأذى تشكر للعائب % PageV01P224 11(@)(@@) % و الناس أصحابي ما لم تمل % و سوق أثقالي على صاحب % 12(@)(@@) % أكون ما استغنيت عن رفدهم % % جلدة بين العين والحاجب % % 13(@)(@@) % فإن عرت أو حدثت حاجة % فالحبل 
ms76	 ملقي على الغارب % 14(@)(@@) % و كم أخ غيره يومه ال % % مقبل عن أمس به الذاهب % % 15(@)(@@) % كنت وإياه زمان الصدى % % كالماء والقهوة للشارب % 16(@)(@@) % و مد باعيه فخلى يدي % % نهبا لكف القابض الجاذب % 17(@)(@@) % مر فلم يعطف لحب الصبا ال % % جاني ولا حق العلا الواجب % 18(@)(@@) % كأن ما أحكمت من وده % أبرمته للمسحل القاضب % 19(@)(@@) % الله للمغصوب فيكم على % % ديونه يا شيعة الغاصب % 20(@)(@@) % قد قلت للخابط خلف المنى % % مباعدا قارب بها قارب % PageV01P225 21(@)(@@) % احبس مطاياك فما في السرى % % إلا جنون الطمع الكاذب % 22(@)(@@) % لا تطلبن الرزق من معدن % ينبوعه غير أبي طالب % 23(@)(@@) % فالبحر من خلفه خلفه % لم يقتنع بالوشل الناضب % 24(@)(@@) % خاطر في المجد فغالي فتى % لم يخش منه قمرة الغالب % 25(@)(@@) % و كاثر الناس بإحسانه % فلم يحزه عدد الحاسب % 26(@)(@@) % إذا احتبى ينسب علياءه % % دار عليه قطب الناسب % 27(@)(@@) % ضم إلى ما كسبت نفسه % سالفة في عرقه الضارب % 28(@)(@@) % فظل لا يشرف من جانب % إلا دعاه الفخر من جانب % 29(@)(@@) % من معشر تضحك أيمانهم % % إن آد عام السنة الشاحب % 30(@)(@@) % تحلب أموالهم ثرة % و الضرع مبسوس على الحالب % PageV01P226 31(@)(@@) % لهم ندى شرق منهم % بكل مخطوب له خاطب % 32(@)(@@) % لا نائم السامر في الليلة ال % % طولي ولا متقر الآدب % 33(@)(@@) % هم وزروا الدولات واستنصحوا % % رعيا على العاطف والسارب % 34(@)(@@) % و هم سيوف الخلفاء التي % % تعلم الضرب يد الضارب % 35(@)(@@) % غاروا نجوما ووفت بابنهم % % شهادة الطالع للغارب % % 36(@)(@@) % حذا وزادته قوى نفسه % و المجد للموروث والكاسب % 37(@)(@@) % زيادة البدر بشعاعة % على ضياء الكوكب الثاقب % 38(@)(@@) % ليت عيونا لهم في الثرى % % مغضوضة بالقدر اللازب % 39(@)(@@) % تراك في رتبتهم جالسا % % تأمر في العارض والراتب % 40(@)(@@) % حتى يقر الله منها الذي % % أقذي بالرامس والتارب % PageV01P227 41(@)(@@) % قد عرف القائم بالأمر مذ % % سلك أن القطع للقاضب % 42(@)(@@) % ظهرت بالعفة سلطانه % هذا وما الزاهد كالراغب % 43(@)(@@) % و صنت ما حسن من ذكره % عن دنس القادح والقاصب % 44(@)(@@) % فلا تزل عندك من طوله % ما عنده من 
ms77	 رأيك الصائب % 45(@)(@@) % و لا خلا دستك من مركب % غاش ومن راج ومن هائب % 46(@)(@@) % و دام لي منك ربيعي الذي % % يرضي رياضي بالحيا الساكب % 47(@)(@@) % و جنتي الحصداء إن صاح بي % % دهري لا سلم فقم حارب % 48(@)(@@) % ما لي في فقري إلى ناصر % سواك من أحمى به جانبي % % 49(@)(@@) % في ودك استبليت ثوب الصبا % % و فيه أنضو بردة الشائب % 50(@)(@@) % قلبي لك المأمون تقليبه % ما قام ريان على مارب % PageV01P228 51(@)(@@) % أبيض ثوب الود صاف على % % لونيه من راض ومن عائب % 52(@)(@@) % و كلما أنسيتم صحبتي % % ذكرنيكم زمن الصاحب % 53(@)(@@) % و خردا أرسلتها شردا % من حابل منكم ومن حائب % 54(@)(@@) % كل فتاة مع تعنيسها % % تفضح حسن الغادة الكاعب % 55(@)(@@) % ضوافيا من فوق أعراضكم % % للمسدل المرخى وللساحب % 56(@)(@@) % سارت مع الشمس وعمت مع ال % % غيث فمن ذاك ومن هاضب % 57(@)(@@) % تعلق بالآذان موصولة % غشما بلا إذن ولا حاجب % 58(@)(@@) % تنصب أعلاما لكم سيرها % % في الأرض فلتشكر يد الناصب % 59(@)(@@) % كررت الأعياد أعدادها % % و المهرجانات على الحاسب % 60(@)(@@) % حتى لقد خافت بما أكثرت % ملالة القارئ والكاتب % PageV01P229 البحر : - 1(@)(@@) % لك الغرام وللواشي بك التعب % و كل عذل إذا جد الهوى لعب % 2(@)(@@) % أما كفاه انصراف العين معرضة % عنه وسمع بوقر الشوق محتجب % 3(@)(@@) % و أن قلبا وأحشاء مدغدغة % إذا استقامت حمول الحي تضطرب % 4(@)(@@) % لاموا عليك فما حلوا وما عقدوا % % عندي وعابوا فما شقوا ولا شعبوا % % 5(@)(@@) % فكل نار هوى في الصدر كامنة % فاللوم يسعرها والعذل يحتطب % 6(@)(@@) % آها لوحشة ما بيني وبينكم % إذا خلت من دلاء الجيرة القلب % 7(@)(@@) % و عطت القور والأجراع نوقكم % طروح عيني وحالت بيننا الكثب % 8(@)(@@) % من اشتكى الشوق إذ هزت وسادته % مدامع تنتحي أو أضلع تجب % 9(@)(@@) % فما أسفت لشيء فائت أسفي % % من أن أعيش وجيران الغضا غيب % 10(@)(@@) % قد كنت أسرق دمعي في محاجره % % تطيرا بالبكى فاليوم أنتحب % PageV01P230 11(@)(@@) % لا يبعد الله قلبا ظل عندكم % لم يغنني عنه نشدان ولا طلب % 12(@)(@@) % سلبتموه فلم تفتوا برجعته 
ms78	 % % و ربما رد بعد الغارة السلب % 13(@)(@@) % فأين إذمامكم قبل الفراق له % % ألا يضام ولا تمشي له الريب % 14(@)(@@) % أسيرة لكم في الغدر حادثة % تخص أم رجعت عن دينها العرب % 15(@)(@@) % يا أهل ودي وما أهلا دعوتكم % بالحق لكنها العادات والدرب % 16(@)(@@) % كابها نتسمى قبل غدركم % فاليوم كل اسم ود بيننا لقب % 17(@)(@@) % أشبهتم الدهر في تلوين صبغته % فكلكم حائل الألوان منقلب % 18(@)(@@) % كنتم علي مع الأيام إخوتها % % و ليس إلا عقوقي بينكم نسب % 19(@)(@@) % صبرا وإن كان ملبوسا على جزع % ظلمت والصابر المظلوم محتسب % 20(@)(@@) % لعل عازب هذا الحظ يرجع لي % % يوما وقاعد هذا الجد بي يثب % PageV01P231 21(@)(@@) % و ليت أن كمال الملك خالصة % آراؤه لي ورأي الناس مؤتشب % 22(@)(@@) % بل ليت أن قضاياه مواهبه % فكان إنصافه في عرض ما يهب % 23(@)(@@) % فتى قنعت به من بين من حملت % خوص الركاب فسارت تنقل الركب % 24(@)(@@) % أحببته حب عيني أختها ويدي % % يدي ولي في مزيد منهما أرب % 25(@)(@@) % و كان لي حيث لا جفن لناظره % حفظا وصونا ولا تحمي الظيا القرب % 26(@)(@@) % عطفا لحقي وإسبالا على ذممي % % كأنه وهو مولى في الحنو أب % 27(@)(@@) % يرعى شوارد فيه لم تسر معها % % ريح ولا طمعت في شأوها السحب % 28(@)(@@) % فغالبتني على ذاك المكان يد % للدهر كان لها مذ ملني الغلب % 29(@)(@@) % ملالة لم تطر فيها مطاولة % و بغضة كالتجني ما لها سبب % 30(@)(@@) % قسا فأصبح للواشين بي أذنا % تليق ما اختلفوا عني وما اجتلبوا % % PageV01P232 31(@)(@@) % لو قيل إني سرقت السمع أو صرفوا % % إلي تبديل دين الله أو نسبوا % % 32(@)(@@) % لما امترى أن رسل الله بي جبهوا % % بالرد أو حرفت على أمري الكتب % 33(@)(@@) % فقل له طيب الله الوفاء له % % و الحق يسفر والبهتان ينتقب % 34(@)(@@) % يا ناقد الناس كشفا عن جواهرهم % % متى تغير عن أعراقه الذهب % 35(@)(@@) % و كيف أفسد سوء الحظ خبرك بي % % حتى بدا لك أن الدر مخشلب % 36(@)(@@) % أغير أن فراشا طار ينأم بي % % لو شئت كان بنار الرد 
ms79	 يلتهب % 37(@)(@@) % أبعد أن رضتني عشرين أو صعدت % لا الجري تنكره مني ولا الجنب % 38(@)(@@) % يروى لك الخرق عن حزمي فتقبله % % صفحا ويحذبك الواشي فتنجذب . % 39(@)(@@) % حاشاكم أن تكونوا عون حادثة % أو ترتميني على أيدكم النوب % 40(@)(@@) % أذنبي الحب والإخلاص عندكم % فإن ذنبي إلى أيامي الأدب % PageV01P233 41(@)(@@) % أما وقومك والمجد التليد لهم % % إذا حلفت بهم والدين والحسب % 42(@)(@@) % ما خلت والدهر لا تفنى عجائبه % أن العلا نافق في سوقها الكذب % 43(@)(@@) % و لا عجبت لدهري كيف يظلمني % % و إنما ظلمكم أنتم هو العجب . % 44(@)(@@) % يا من به صح سقم العيش واجتمعت % على توحده الأحزاب والشعب % 45(@)(@@) % و من كفى الملك ما لم يكف صارمه % و رد عنه الذي ما رده اليلب % 46(@)(@@) % و من توسط أفق المجد فاعتدلت % به البدور ولبت أمره الشهب % 47(@)(@@) % على بساطك تقضى كل مبهمة % يعنو بها الخطب أو تعيا بها الخطب % 48(@)(@@) % و هالة البدر دست أنت راكبه % % و تارة هو غاب الضغيم الأشب % 49(@)(@@) % بشر وقور وجد ضاحك ورضا % لولا الطلاقة خلنا أنه غضب % 50(@)(@@) % جرى بك الخلق الفضفاض وانقبضت % بك المهابة فالسلسال واللهب % PageV01P234 51(@)(@@) % و أفقرتك العطايا والثناء غنى % و أنصبتك العلا والراحة النصب % 52(@)(@@) % من عنده نشب لا مجد يعضده % فإن عندك مجدا ما له نششب % 53(@)(@@) % حللت باسمك عقد الرزق فاندفعت % عراه تفصم لي عفوا وتنقضب % 54(@)(@@) % و كنت واسطة العقد الذي انتظمت % عنه السلوك ولم تخدش به الثقب % 55(@)(@@) % أنتم رفادة ظهري إن وهي جلدي % % و درة العيش لي والضرع معتصب % 56(@)(@@) % و مشربي العد والغدران غائرة % منكم لي الحوض أو منكم لي القرب % 57(@)(@@) % قدمتموني فلي رهن السباق ومن % يلزني بعد مجنوب ومعتقب % 58(@)(@@) % عزى بنفسي ولكن زادني شرفا % % أني اليكم إذا باهلت أنتسب % 59(@)(@@) % و الناس غيركم من لا يجاوزني % % أبياته عمد تبنى ولا طنب % 60(@)(@@) % إذا صفوتم فلا وردي ولا صدري % % منهم وإن أملحوا يوما وإن عذبوا % % PageV01P235 61(@)(@@) % لي منكم الجبهة الغراء والعتق ال % % تلعاء والناس بعد 
ms80	 الرسغ والذنب % 62(@)(@@) % فلا تنلني الليالي فيكم بيد % إلا التباب لها والشل والعطب % 63(@)(@@) % و لا تصبكم عيون الدهر إن لها % % إلى الكمال لحاظا سهمها غرب % 64(@)(@@) % و إن أتى رائد النيروز مجتديا % أيمانكم فالروابي الخضر والعشب % 65(@)(@@) % فمن جباهكم نور الربيع لنا % % و من أكفكم الأنواء تنسكب % 66(@)(@@) % يوم يكر به إقبال جدكم % غدا على ملككم ما كرت الحقب % 67(@)(@@) % تجلون من حسنه حظ العيون فلل % % أشعار فيكم حظوظ السمع والطرب % 68(@)(@@) % فما بقيتم فأيامي بعزكم % كما أحب وأحوالي كما يجب % PageV01P236 البحر : - 1(@)(@@) % إذا فاتها روض الحمى وجنوبه % كفاها النسيم البابلي وطيبه % 2(@)(@@) % و كم حب من واد إلى العيش مجدب % و أبغض مثرى آخر وخصيبه % 3(@)(@@) % و ما الجانب المسكون إلا وفاقه % هوى النفس لا خضراؤه وعشيبه % 4(@)(@@) % فدعها تلس العيش طوع قلوبها % % فأمرع ما ترعاه ما تستطيبه % 5(@)(@@) % و إن الثماد البرض في عز قومها % % لأنقع من جم يدل غريبه % 6(@)(@@) % و أشبعها ألا تكون طرائدا % % إذا شل من سرح المسيم عزيبه % 7(@)(@@) % و أن كان حيا بالحمى إن توفرت % من الوجد مبرى دائها وطيبه % 8(@)(@@) % و كل هلال ذو الأراك حجابه % يسر البدور الطالعات مغيبه % 9(@)(@@) % تحول الرماح العامرية دونه % % فيقظ راجيه ويعيا طليبه % 10(@)(@@) % و أتعب من حاولت يا قلب وصله % حبيب سنان السمهري رقيبه % PageV01P237 11(@)(@@) % يصيب بعيدا سهمه كل من رمى % % و ترميه أيد حوله لا تصيبه % 12(@)(@@) % يلوم على نجد ضنين بدمعه % إذا فارق الأحباب جفت غروبه % 13(@)(@@) % و هل طائل في أن يكثر عذله % % إذا قل من إصغاء سمعي نصيبه % 14(@)(@@) % و ما الناس إلا من فؤادي فؤاده % لأهل الغضا أو من حبيبي حبيبه % 15(@)(@@) % سأرعى الذي بيني وبين ملون % شربت على صفوى له ما يشوبه % 16(@)(@@) % خذيني بغير الغدر خلقا وإن جنى % % على الوفاء قرفه وندوبه % 17(@)(@@) % فذلك طين الأرض لم تبن فطرتي % % عليها وما ماء سقاني قليبه % 18(@)(@@) % خلقت يدا دون الصديق وجنة % يرد بها عن صدره ما ينوبه % 19 