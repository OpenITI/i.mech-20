ms861	 معهم حتى يفرغوا ، ثم يقول بعضهم لبعض : طوبى لهم لا يرجعون إلا مغفورا لهم ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7751 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملائكة موكلين بأرزاق بني آدم ، ثم قال لهم : أيما عبد جعل الهم هما واحدا فضمنوا رزقه السماوات والأرض وبني آدم ، وأيما عبد وجدتموه طلبه ، فإن تحرى العدل فطيبوا له ويسروا ، وإن تعدى إلى غير ذالك فخلوا بينه وبين ما يريد ، ثم لا ينال فوق الدرجة التي كتبتها له ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7752 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل ثلاثة أثواب : ائتزر العزة ، وتسربل الرحمة ، وارتدى الكبرياء ، فمن تعزز بغير ما أعزه الله فذاك الذي يقال له : ذق إنك أنت العزيز الكريم ، ومن رحم الناس يرحمه الله ، فذالك الذي تسربل بسرباله الذي ينبغي له ، ومن تكبر فقد نازع الله رداءه الذي ينبغي له ، فإن الله تعالى يقول : لا ينبغي لمن نازعني أن أدخله الجنة ) )(@)(@@) ( ك ) و الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7753 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل في الأرض آنية ، وأحب آنية الله إليه ما رق وصفا ، وآنية الله في الأرض قلوب العباد الصالحين ) )(@)(@@) ( حل ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7754 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل عبادا لا يكلمهم يوم القيامة ولا PageV03P136 يزكيهم ولا ينظر إليهم : متبرىء من والديه وراغب عنهما ، ومتبرىء من ولده ، ورجل أنعم عليه قوم فكفر نعمتهم وتبرأ منهم ) )(@)(@@) ( حم ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7755 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل ديكا ، براثنه في الأرض السفلى ، وعنقه مثني تحت العرش ، وجناحاه في الهواء يخفق بهما سحر كل ليلة : سبحوا القدوس ، ربنا الرحمان لا إلاه غيره ) )(@)(@@) أبو الشيخ في العظمة عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7756 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل ديكا ، جناحاه موشيان بالزبرجد واللؤلؤ والياقوت ، جناح له في المشرق ، وجناح له في المغرب ، وقوائمه في الأرض السفلى ، ورأسه مثني تحت 
ms862	 العرش ، فإذا كان في السحر الأعلى خفق بجناحيه ثم قال : سبوح قدوس ، ربنا الله لا إلاه غيره ، فعند ذالك تضرب الديكة بأجنحتها وتصيح ، فإذا كان يوم القيامة ، قال الله له : ضم جناحك ، وغض صوتك ، فيعلم أهل السماوات والأرض أن الساعة قد اقتربت ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7757 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل ديكا رأسه تحت العرش ، وجناحه في الهواء ، وبراثنه في الأرض ، فإذا كان في الأسحار وأذان الصلوات خفق بجناحيه وصفق بالتسبيح فتسبح الديكة تجيبه بالتسبيح ) )(@)(@@) ( طب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7758 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى مائة رحمة ، قسم منها رحمة في دار الدنيا ، فمن ثم يعطف الرجل على ولده ، والطير على فراخه ، فإذا كان يوم القيامة صيرها مائة رحمة ، فعاد بها على الخلق ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7759 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ديكا رجلاه في التخوم ، وعنقه تحت العرش منطوية ، فإذا كان هنة من الليل صاح : سبوح قدوس ، فصاحت الديكة ) )(@)(@@) PageV03P137 ( عد هب ) وضعفه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7760 ) قال النبي :(@)(@@) | 30 ( إن لله خلقا يبثهم تحت الليل كيف شاء ، فأوكئوا السقاء ، وغطوا الإناء ، وأغلقوا الأبواب ، فإنه لا يفتح بابا ، ولا يكشف غطاء ، ولا يحل وكاء ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7761 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى خواص يسكنهم رفيع الدرجات لأنهم كانوا في الدنيا أعقل الناس ، كان همهم المسابقة إلى الطاعة ، وهانت عليهم فضول الدنيا وزينتها ) )(@)(@@) الخطيب في المتفق والمفترق وابن النجار عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7762 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل في كل ليلة من رمضان ستمائة ألف عتيق من النار ، فإذا كان آخر ليلة أعتق الله بعدد من مضى ) )(@)(@@) ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7763 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى عتقاء في كل يوم وليلة ، عبيدا وإماء ، يعتقهم من النار ، وإن لكل مسلم دعوة مستجابة يدعو بها فيستجيب له ) )(@)(@@) ( حل ) عن أبي هريرة 
ms863	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7764 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى آنية من أهل الأرض ، وآنية ربكم قلوب عباده الصالحين ، وأحبها إليه ألينها وأرقها ) )(@)(@@) ( طب ) عن أبي عنبة الخولاني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7765 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى مائة رحمة ، قسم منها رحمة بين أهل الدنيا فوسعتهم إلى آجالهم ، وأخر تسعا وتسعين رحمة لأوليائه يوم القيامة ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7766 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى في الأرض أواني ألا وهي القلوب ، فأحبها إلى الله أرقها وأصفاها ، وأصلبها ، أرقها للاخوان وأصفاها من الذنوب ، PageV03P138 وأصلبها في ذات الله تعالى ) )(@)(@@) الحكيم عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7767 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى عبادا خلقهم لحوائج الناس ، فقضى حوائج الناس على أيديهم ، أولائك آمنون من فزع يوم القيامة ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7768 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل في الخلق ثلاثمائة قلوبهم على قلب آدم ، ولله في الخلق أربعون قلوبهم على قلب موسى ، ولله في الخلق سبعة قلوبهم على قلب إبراهيم ، ولله في الخلق خمسة قلوبهم على قلب جبريل ، ولله في الخلق ثلاثة قلوبهم على قلب ميكائيل ، ولله في الخلق واحد قلبه على قلب إسرافيل ، فإذا مات الواحد أبدل الله مكانه من الثلاثة ، وإذا مات من الثلاثة أبدل الله مكانه من الخمسة ، وإذا مات من الخمسة أبدل الله مكانه من السبعة ، وإذا مات من السبعة أبدل الله مكانه من الأربعين ، وإذا مات من الأربعين أبدل الله مكانه من الثلثمائة ، وإذا مات من الثلاثمائة أبدل الله مكانه من العامة فبهم يحيي ويميت ويمطر وينبت ويدفع البلاء ) )(@)(@@) ( حل ) و ابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7769 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل عبادا يفزع الناس إليهم في حوائجهم ، هم الآمنون يوم القيامة من عذاب الله ) )(@)(@@) أبو الشيخ في الثواب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7770 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل أملاكا خلقهم كيف شاء وصورهم 
ms864	 على ما يشاء تحت عرشه ، ألهمهم أن ينادوا قبل طلوع الشمس وقبل غروب الشمس في كل يوم مرتين ألا من وسع على عياله وجيرانه وسع الله تعالى عليه في الدنيا ، ألا من ضيق ضيق الله عليه ، إن الله قد أعطاكم لنفقة درهم على عيالكم سبعين قنطارا ، والقنطار مثل أحد وزنا ، أنفقوا ولا تجمعوا ولا تضيقوا ولا تقتروا ، ولتكن أكثر نفقتكم يوم الجمعة ) )(@)(@@) ابن لال في مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P139(@)(@@)(@@)(@@) $ ( 7771 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل ملائكة موكلين بأنصاب الحرم منذ خلق الله الدنيا إلى أن تقوم الساعة يدعون لمن حج من مصره ماشيا ) )(@)(@@) الديلمي وابن لال في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7772 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملائكة في السماء الدنيا خشوعا منذ خلقت السماوات والأرض إلى أن تقوم الساعة يقولون : سبحان ذي الملكوت ، فإذا كان يوم القيامة يقولون : سبحانك ما عبدناك حق عبادتك ، ولله ملائكة في السماء الثانية ركوعا منذ خلقت السماوات والأرض إلى أن تقوم الساعة ، فإذا كان يوم القيامة يقولون : سبحانك ما عبدناك حق عبادتك ، ولله ملائكة في السماء الثالثة سجودا منذ خلقت السماوات والأرض إلى أن تقوم الساعة ، فإذا كان يوم القيامة يقولون : سبحانك ما عبدناك حق عبادتك ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7773 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملائكة خلقوا من النور لا يهبطون إلا ليلة الجمعة ويوم الجمعة ، بأيديهم أقلام من ذهب ودوي من فضة وقراطيس من نور لا يكتبون إلا الصلاة على النبي ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7774 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملائكة في الأرض تنطق على ألسنة بني آدم بما في المرء من الخير والشر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7775 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملكا ينادي في كل يوم وليلة : أبناء الأربعين زرع قد دنا حصاده ، أبناء الستين هلموا إلى الحساب ماذا قدمتم وما عملتم ؟ أبناء السبعين هلموا إلى الحساب ماذا 
ms865	 قدمتم وما عملتم ؟ أبناء السبعين هلموا إلى الحساب ، ليت الخلائق لم يخلقوا ، وليتهم إذا خلقوا علموا لماذا خلقوا ، فتجالسوا بينهم فتذاكروا ألا أتتكم الساعة فخذوا حذركم ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7776 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملكا بباب من أبواب السماء يقول : من PageV03P140 يقرض اليوم يجازى غدا ، وملك بباب آخر ينادي : اللهم أعط منفقا خلفا ، وعجل لممسك تلفا ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7777 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى في كل يوم ثلاثمائة وستين نظرة ، لا ينظر فيها إلى صاحب الشاة يعني الشطرنج ) )(@)(@@) الديلمي عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7778 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ملائكة ، ما بين شحمة أذن أحدهم إلى ترقوته مسيرة سبعمائة عام للطير السريع الطيران ) )(@)(@@) أبو الشيخ في العظمة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7779 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى أرضا من وراء أرضكم هاذه بيضاء ، نورها وبياضها مسيرة شمسكم هاذه أربعين يوما ، فيها عباد الله لم يعصوه طرفة عين ، ما يعلمون أن الله خلق الملائكة ولا آدم ولا إبليس ، هم قوم يقال لهم الروحانيون خلقهم الله من ضوء نوره ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7780 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى حقا على كل مسلم أن يغتسل كل سبعة أيام يوما ، فإن كان له طيب مسه ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7781 ) قال النبي :(@)(@@) | 30 ( إن لله عبادا يحييهم في عافية ويميتهم في عافية ، ويدخلهم الجنة في عافية ) )(@)(@@) ( طس ) عن أبي مسعود الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7782 ) قال النبي :(@)(@@) | 30 ( إن لله ملائكة فضلاء يتبعون مجالس الذكر ، يجتمعون عند الذكر ، فإذا مروا بمجلس علا بعضهم على بعض حتى يبلغوا العرش ، فيقول الله لهم وهو أعلم ، من أين جئتم ؟ فيقولون : من عند عبيد لك يسألونك الجنة ويتعوذون بك من النار ويستغفرون ، فيقول : يسألوني جنتي ، فكيف لو رأوها ، ويتعوذون من ناري فكيف لو رأوها ؛ فإني قد غفرت لهم ، فيقولون : ربنا إن فيهم عبدك 
ms866	 الخطاء فلان مر بهم لحاجة له فجلس إليهم ، قال الله عز وجل : أولائك الجلساء لا يشقى بهم جليسهم ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن PageV03P141 أبي هريرة رضي الله عنه قال ابن شاهين : هاذا الحديث من أحسن حديث في الذكر وأصحه سندا .(@)(@@)(@@)(@@) $ ( 7783 ) قال النبي :(@)(@@) | 30 ( إن لله ملكا ، نصف جسده الأعلى ثلج ، ونصفه الأسفل نار ، ينادي بصوت رفيع له ، سبحان الله الذي كف حر هاذه النار ، اللهم يا مؤلف بين الثلج والنار ألف بين قلوب عبادك المؤمنين على طاعتك ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7784 ) قال النبي :(@)(@@) | 30 ( إن لله ملائكة وهم الأكروبيون من شحمة أذن أحدهم إلى ترقوته مسيرة سبعمائة عام للطير السريع في انحطاطه ) )(@)(@@) ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7785 ) قال النبي :(@)(@@) | 30 ( إن لله مائة وسبعة عشر شريعة من وافاه بخلق منها دخل الجنة ) )(@)(@@) ( بز ) عن عثمان رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7786 ) قال النبي :(@)(@@) | 30 ( إن لله مائة خلق وسبعة عشر خلقا ، فمن أتى الله بخلق واحد منها دخل الجنة ) )(@)(@@) ( ط ) و الحكيم ( ع ) عن عثمان رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7787 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل لوحا من زبرجدة خضراء جعله تحت العرش كتب فيه : إني أنا الله لا إلاه إلا أنا ، أرحم الراحمين ، خلقت بضعة عشر وثلاثمائة خلق ، من جاء بخلق منها مع شهادة أن لا إلاه إلا الله أدخل الجنة ) )(@)(@@) ( طس ) و أبو الشيخ في العظمة عن أنس رضي الله عنه وضعفوه .(@)(@@)(@@)(@@) $ ( 7788 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى ثلاثمائة وخمس عشرة شريعة ، يقول الرحمان : وعزتي لا يأتيني عبد من عبادي لا يشرك بي شيئا بواحدة منهن إلا أدخلته PageV03P142 الجنة ) )(@)(@@) الحكيم عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7789 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى في كل يوم ثلاثمائة وخمس عشرة شريعة ، يقول الرحمان : وعزتي لا يأتيني عبد من عبادي لا يشرك بي شيئا بواحدة منهن إلا أدخلته الجنة ) )(@)(@@) الحكيم عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7790 ) قال النبي :(@)(@@) | 30 
ms867	 ( إن لله في كل يوم ثلاثمائة وستين لحظة يلحظ بها إلى أهل الأرض ، فمن أردكته تلك اللحظة صرف الله عنه شر الدنيا وشر الآخرة ، وأعطاه خير الدنيا وخير الآخرة ) )(@)(@@) الحكيم عن علي بن الحسين بلاغا الحكيم عن محمد بن الحنفية مرسلا إلا أنه جعل المرفوع صدره فقط والباقي موقوف .(@)(@@)(@@)(@@) $ ( 7791 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى بحرا من نور ، حوله ملائكة من نور ، على خيل من نور ، بأيديهم حراب من نور ، يسبحون حول ذالك البحر : سبحان ذي الملك والملكوت ، سبحان ذي العرش والجبروت ، سبحان الحي الذي لا يموت ، سبوح قدوس رب الملائكة والروح ، فمن قالها في يوم أو شهر أو سنة مرة أو في عمره غفر الله له ما تقدم من ذنبه وما تأخر ولو كانت ذنوبه مثل زبد البحر ، أو مثل رمل عالج ، أو فر من الزحف ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7792 ) قال النبي :(@)(@@) | 30 ( إن لله بقاعا تسمى المنتقمات فإن كسب الرجل المال من الحرام سلط الله عليه الماء والطين ثم لا يمتعه ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7793 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى خيرتين من خلقه فخيرته من خلقه من العرب قريش ، ومن العجم فارس ) )(@)(@@) الديلمي عن عبد الله بن رزق المخزومي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7794 ) قال النبي :(@)(@@) | 30 ( إن للأرزاق حجبا ، فمن شاء أن يهتك ستره بقلة حياء ويأخذ رزقه فعل ، ومن شاء أبقى حياءه وترك رزقه محجوبا عنه حتى يأتيه رزقه PageV03P143 على ما كتب الله له فعل ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7795 ) قال النبي :(@)(@@) | 30 ( إن للإسلام صوى كمنار الطريق ، فمن ذالك أن يعبد الله لا يشرك به شيء ، وتقام الصلاة ، وتؤتى الزكاة ، ويحج البيت ، ويصام رمضان ، والأمر بالمعروف ، والنهي عن المنكر ، والتسليم على بني آدم ، فإن ردوا عليك ردت عليك وعليهم الملائكة ، وإن لم يردوا عليك ردت عليك الملائكة ولعنتهم أو سكتت عنهم ، وتسليمك على أهل بيتك إذا دخلت ، ومن انتقص منهن شيئا فهو من سهام الإسلام تركه 
ms868	 ، ومن تركهن كلهن فقد ترك الإسلام ) )(@)(@@) ابن السني في عمل يوم وليلة ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7796 ) قال النبي :(@)(@@) | 30 ( إن للجنة بابا يقال له الريان يدعى له الصائمون ، من كان من الصائمين دخله لم يظمأ أبدا ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7797 ) قال النبي :(@)(@@) | 30 ( إن للجنة بابا يدعى الريان ، لا يدخل منه إلا الصائمون ) )(@)(@@) الخطيب وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7798 ) قال النبي :(@)(@@) | 30 ( إن للحائض وقفات ، ولدم الحيض ريح ليس لغيره ، فإذا ذهب قرء الحيض فلتغتسل إحداكن ، ثم لتغسل عنها الدم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7799 ) قال النبي :(@)(@@) | 30 ( إن للرحم حجنة آخذة بحجزة الرحمان عز وجل ، تصل من وصلها وتقطع من قطعها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7800 ) قال النبي :(@)(@@) | 30 ( إن للقاعد في الصلاة نصف أجر القائم ) )(@)(@@) ( عب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7801 ) قال النبي :(@)(@@) | 30 ( إن للقتيل عند الله ست خصال : يغفر له خطيئته في أول دفعة من دمه ، ويجار من عذاب القبر ، ويحلى حلة الكرامة ، ويرى مقعده PageV03P144 من الجنة ، ويؤمن من الفزع الأكبر ، ويزوج من الحور العين ) )(@)(@@) ( هب ) عن قيس الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7802 ) قال النبي :(@)(@@) | 30 ( إن للقلب فرحة عند أكل اللحم ) )(@)(@@) ( هب ) و أبو نعيم في الطب عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7803 ) قال النبي :(@)(@@) | 30 ( إن للقرشي مثلي قوة الرجل من غير قريش ) )(@)(@@) ( ط حم ع ) و ابن أبي عاصم ( حب ) والباوردي ( ك ط هق ) في المعرفة عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7804 ) قال النبي :(@)(@@) | 30 ( إن للماء عوامر من الملائكة كعوامر البيوت ، استحيوهم ، وهابوهم ، وأكرموهم ، إذا دخلتم عليهم الماء فلا تدخلوا إلا بمئزر ) )(@)(@@) الديلمي عن الحسن بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7805 ) قال النبي :(@)(@@) | 30 ( إن للمساجد أوتادا والملائكة جلساؤهم ، فإن غابوا افتقدوهم ، وإن مرضوا عادوهم ، وإن كانوا في حاجة أعانوهم ، جليس المسجد على ثلاث خصال : أخ يستفاد ، أو كلمة محكمة 
ms869	 ، أو رحمة منتظرة ) )(@)(@@) ( حم ) و ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7806 ) قال النبي :(@)(@@) | 30 ( إن للمساجد أوتادا جلساؤهم الملائكة يتفقدونهم ، فإن كانوا في حاجة أعانوهم ، وإن مرضوا عادوهم ، وإن غابوا افتقدوهم ، وإن حضروا قالوا : اذكروا الله يذكركم الله ) )(@)(@@) ( عب هب ) عن عطاء الخراساني مرسلا .(@)(@@)(@@)(@@) $ ( 7807 ) قال النبي :(@)(@@) | 30 ( إن للموت فزعا ، فإذا بلغ أحدكم موت أخيه فليقل : إنا لله وإنا إليه راجعون ، اللهم ألحقه بالصالحين ، واخلفه عله ذريته في PageV03P145 الغابرين ، واغفر لنا وله يوم الدين ، اللهم لا تحرمنا أجره ، ولا تفتنا بعده ) )(@)(@@) ( كر ) في معجمه و ابن النجار عن أبي هند الداري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7808 ) قال النبي :(@)(@@) | 30 ( إن للموت فزعا ، فإذا أتى أحدكم وفاة أخيه فليقل : إنا لله وإنا إليه راجعون ، وإنا إلى ربنا لمنقلبون ، اللهم اكتبه عندك في المحسنين ، واجعل كتابه في عليين ، واخلف عقبه في الآخرين ، اللهم لا تحرمنا أجره ، ولا تفتنا بعده ) )(@)(@@) ( طب ) و ابن السني في عمل يوم وليلة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7809 ) قال النبي :(@)(@@) | 30 ( إن للمؤمن حقا ) )(@)(@@) ( هب ) و ابن عساكر عن واثلة بن الخطاب القرشي قال : دخل رجل المسجد والنبي وحده فتحرك له ، فقيل : يا رسول الله المكان واسع ، قال : فذكره ( طب ) عن واثلة بن الأسقع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7810 ) قال النبي :(@)(@@) | 30 ( إن للوسواس خطما كخطم الطائر ، فإذا غفل ابن آدم وضع ذالك المنقار في أذن القلب يوسوس ، فإن ابن آدم ذكر الله عز وجل نكص وخنس ، فلذالك سمي الوسواس الخناس ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن أنس رضي الله عنه وهو ضعيف .(@)(@@)(@@)(@@) $ ( 7811 ) قال النبي :(@)(@@) | 30 ( إن للمؤمن زوجتين ، يرى مخ سوقهما من بين ثيابهما ) )(@)(@@) أبو الشيخ في العظمة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7812 ) قال النبي :(@)(@@) | 30 ( إن لربكم في بقية أيام دهركم نفحات فتعرضوا لها ، لعل دعوة أن توافق رحمة فيسعد بها صاحبها ثم لا يشقى بعدها أبدا ) )(@)(@@) الحكيم عن محمد بن مسلمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7813 ) قال النبي 
ms870	 :(@)(@@) | 30 ( إن لهاذا الدين إقبالا وإدبارا ألا وإن من إقبال هاذا الدين أن تفقه القبيلة بأسرها حتى لا يبقى إلا الفاسق أو الفاسقان ذليلان فيها ، إن PageV03P146 تكلما قهرا واضطهدا ، ألا وإن من إدبار هاذا الدين أن يلعن آخر هاذه الأمة أولها ، ألا وعليهم حلت اللعنة حتى ليشربوا الخمر علانية ، حتى يمر بالمرأة القوم فيقوم إليها بعضهم فيرفع بذيلها كما يرفع بذنب النعجة ، فقائل يقول يومئذ : ألا واريتها وراء الحائط ؟ فهو يومئذ فيهم مثل أبي بكر وعمر فيكم ، فمن أمر يومئذ بالمعروف ونهى عن المنكر فله أجر خمسين ممن رآني وآمن بي وأطاعني وتابعني ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7814 ) قال النبي :(@)(@@) | 30 ( إن لهاذه البيوت عوامر ، فإذا رأيتم منها شيئا فتعوذوا منه ، فإن عاد فاقتلوه ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7815 ) قال النبي :(@)(@@) | 30 ( إن لهاذا القرآن شرة ، ثم للناس عنه فترة ، فمن كانت فترته للقسط والسنة فنعما هو ، ومن كانت فترته إلى الإعراض فأولائك هم بور ( ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7816 ) قال النبي :(@)(@@) | 30 ( إن لهم عليك من الحق أن تعدل بينهم ، كما أن لك عليهم من الحق أن يبروك ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7817 ) قال النبي :(@)(@@) | 30 ( إن له في الجنة من يتم رضاعه وهو صديق يعني إبراهيم ) )(@)(@@) ( حم ) و ابن سعد عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7818 ) قال النبي :(@)(@@) | 30 ( إن له مرضعا في الجنة ) )(@)(@@) ( ط خ م د ت ن حب ) و أبو عوانة ( ك ) عن البراء ، ابن عساكر عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7819 ) قال النبي :(@)(@@) | 30 ( إن له مرضعا في الجنة يستتم بقية رضاعه ، وإنه صديق شهيد ) )(@)(@@) ابن سعد عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ 7820 قال النبي :(@)(@@) | 30 ( إن له مرضعة تتم رضاعه في الجنة ) )(@)(@@) ابن سعد عن عبد الرحمان بن عبد الله بن أبي صعصعة رضي الله عنه .(@)(@@) PageV03P147(@)(@@)(@@)(@@) $ ( 7821 ) قال النبي :(@)(@@) | 30 ( إن له بكل خطوة 
ms871	 يخطوها إلى المسجد درجة ) )(@)(@@) ( حم ) و الحميدي عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7822 ) قال النبي :(@)(@@) | 30 ( إن له يعني العباس في الجنة غرفة كما تكون الغرف يطل علي يكلمني وأكلمه ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7823 ) قال النبي :(@)(@@) | 30 ( إن لونك الآن يا شقيراء لحسن ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7824 ) قال النبي :(@)(@@) | 30 ( إن ليلة القدر في النصف من السبع الأواخر من رمضان أن تطلع الشمس غداة إذ ذاك صافية ليس لها شعاع ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7825 ) قال النبي :(@)(@@) | 30 ( إن ليلة الجمعة ليلة غراء ويومها يوم زاهر ) )(@)(@@) ابن السني في عمل يوم وليلة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7826 ) قال النبي :(@)(@@) | 30 ( إن لي عند ربي عشرة أسماء : محمد وأحمد وأبو القاسم والفاتح والخاتم والماحي والعاقب والحاشر وياس وطاه ) )(@)(@@) ( عد ) و ابن عساكر عن أبي الطفيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7827 ) قال النبي :(@)(@@) | 30 ( إن لي حوضا طوله ما بين الكعبة إلى بيت المقدس ، أشد بياضا من اللبن ، آنيته عدد النجوم ، وكل نبي يدعو أمته ، ولكل نبي حوض ، فمنهم من يأتيه الفئام ، ومنهم من يأتيه العصبة ، ومنهم من لا يأتيه PageV03P148 ( سقط : النفر ، ومنهم من يأتيه الرجل و الرجلان ، ومنهم من لا يأتيه ) أحد فيقال : قد بلغت ، وإني أكثر الأنبياء تبعا يوم القيامة ) )(@)(@@) عبد بن حميد ( ع ) وابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7828 ) قال النبي :(@)(@@) | 30 ( إن لي حوضا كما بين أيلة وعمان ) )(@)(@@) ابن عساكر عن الفرزدق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7829 ) قال النبي :(@)(@@) | 30 ( إن لي حوضا ما بين عدن إلى عمان ، آنيته عدد نجوم السماء ، له ميزابان ، أحدهما من ورق ، والآخر من ذهب ، يمدانه من الجنة ، لا يرد عليه من كذب به ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7830 ) قال النبي :(@)(@@) | 30 ( إن لي على قريش حقا ، وإن لقريش عليكم حقا ، ما حكموا فعدلوا ، وائتمنوا فأدوا ، واسترحموا فرحموا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه 
ms872	 .(@)(@@)(@@)(@@) $ ( 7831 ) قال النبي :(@)(@@) | 30 ( إن ماعزا البكائي أسلم آخر قومه ، وإنه لا تجني عليه إلا يده ) )(@)(@@) ابن سعد ( طب ) عن عبد الرحمان بن ماعز رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7832 ) قال النبي :(@)(@@) | 30 ( إن ما بين المصراعين في الجنة مقدار أربعين عاما ، وليأتين عليه يوم يزاحم عليه كازدحام الإبل وردت لخمس ظمأ ) )(@)(@@) ( طب ) عن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7833 ) قال النبي :(@)(@@) | 30 ( إن ما تذكرون من جلال الله وتسبيحه وتحميده وتكبيره وتهليله يتعاطفن حول العرش ، لهن دوي كدوي النحل يذكرن بصاحبهن ، أفلا يحب أحدكم أن لا يزال له عند الرحمان شيء يذكر به ) )(@)(@@) الحكيم عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7834 ) قال النبي :(@)(@@) | 30 ( إن مثل هاؤلاء كمثل إخوة لهم كانوا من قبلهم ، قال PageV03P149 نوح : { رب لا تذر على الأرض من الكافرين ديارا } ، وقال موسى : { ربنا اطمس على أموالهم واشدد على قلوبهم } ، وقال إبراهيم : { فمن تبعني فإنه مني ومن عصاني فإنك غفور رحيم } ، وقال عيسى : { إن تعذبهم فإنهم عبادك ، وإن تغفر لهم فإنك أنت العزيز الحكيم } ، وإنكم قوم بكم غيلة ، فلا ينفلتن أحد إلا بفداء أو بضربة عنق ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7835 ) قال النبي :(@)(@@) | 30 ( إن مثل أصحابي في أمتي كالملح في الطعام ، لا يصلح الطعام إلا بالملح ) )(@)(@@) ابن المبارك عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7836 ) قال النبي :(@)(@@) | 30 ( إن محرم الحلال كمحل الحرام ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7837 ) قال النبي :(@)(@@) | 30 ( إن مريم بنت عمران سألت ربها أن يطعمها لحما لا دم فيه فأطعمها الجراد ، فقالت : اللهم أحيه بغير رضاع ، وتابع بينه بغير شياع يعنيب الصوت ) )(@)(@@) ( طب هب ) عن أبي أمامة رضي الله عنه قال الذهبي : إسناده أنظف من الأول .(@)(@@)(@@)(@@) $ ( 7838 ) قال النبي :(@)(@@) | 30 ( إن مسحهما كفارة للخطايا يعني الركنين ) )(@)(@@) ( ت ) حسن ( ك هب ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7839 ) قال النبي :(@)(@@) | 30 ( إن معاذ بن جبل يحشر يوم القيامة بين يدي العلماء نبذة ) )(@)(@@) ( حم ) عن عمر رضي 
ms873	 الله عنه .(@)(@@)(@@)(@@) $ ( 7840 ) قال النبي :(@)(@@) | 30 ( إن معاذ بن جبل إمام العلماء يوم القيامة لا يحجبه PageV03P150 من الله إلا المرسلون ، وإن سالما مولى أبي حذيفة شديد الحب لله ، لو لم يخف الله ما عصاه ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7841 ) قال النبي :(@)(@@) | 30 ( إن معاوية لا يصارع أحدا إلا صرعه ) )(@)(@@) معاوية الديلمي عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7842 ) قال النبي :(@)(@@) | 30 ( إن ملكا موكل بالرحم بضعا وأربعين ليلة ، إذا أراد الله أن يخلق ما شاء باذن الله فيقول : أي رب أذكر أم أنثى ؟ فيقضي ربك ويكتب الملك ثم يطوي ما زاد ولا نقص ) )(@)(@@) ( طب ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7843 ) قال النبي :(@)(@@) | 30 ( إن ملك الموت كان يأتي الناس عيانا ، فأتى موسى فلطمه ففقأ عينه ، فعرج ملك الموت فقال : يا رب إن عبدك موسى فعل بي كذا وكذا ، ولولا كرامته عليك لشققت عليه ، فقال الله : إئت عبدي موسى فخيره بين أن يضع يده على متن ثور فله أن يضع يده على متن ثور فله بكل شعرة وارتها كفه سنة ، وبين أن يموت الآن ، فخيره ، فقال موسى : فما بعد ذالك ؟ قال : الموت ، قال : فالآن ، فشمه شمة فقبض روحه ، ورد الله عليه عينه ، فكان بعد يأتي الناس في خفية ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7844 ) قال النبي :(@)(@@) | 30 ( إن ملكا من ملوك بني إسرائيل أخذ رجلا فخيره بين أن يشرب الخمر أو يقتل نفسا أو يزني أو يأكل لحم خنزير أو يقتلوه إن أبى ، فاختار أن يشرب الخمر ، وإنه لما شربه لم يمتنع من شيء أرادوه منه ، ما من أحد يشربها فتقبل له صلاة أربعين ليلة ولا يموت وفي مثانته منها شيء إلا حرمت عليه بها الجنة ، فإن مات في أربعين ليلة مات ميتة جاهلية ) )(@)(@@) ( طس ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7845 ) قال النبي :(@)(@@) | 30 ( إن ملكا موكل بمن يقول يا أرحم الراحمين ، فمن قالها ثلاثا ، قال له الملك : إن أرحم الراحمين قد أقبل 
ms874	 عليك فاسأل ) )(@)(@@) ( ك ) عن أبي أمامة PageV03P151 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7846 ) قال النبي :(@)(@@) | 30 ( إن ملكا من السماء لم يكن زارني فاستأذن الله في زيارتي ، فبشرني أن فاطمة سيدة نساء أمتي ، وأن الحسن والحسين سيدا شباب أهل الجنة ) )(@)(@@) ( طب ) و ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7847 ) قال النبي :(@)(@@) | 30 ( إن ملكا بباب من أبواب السماء يقول : من يقرض اليوم يجز غدا ، وملك بباب آخر يقول : اللهم أعط منفقا خلفا ، وعجل لممسك تلفا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7848 ) قال النبي :(@)(@@) | 30 ( إن ملكا بباب من أبواب الجنة يقول : من يقرض اليوم يجز غدا ، وملك بباب آخر يمقول : اللهم أعط منفقا خلفا ، وأعط ممسكا تلفا ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7849 ) قال النبي :(@)(@@) | 30 ( إن من الأنبياء من يسمع للصوت فيكون بذالك نبيا ، وكان منهم من يرى في المنام فيكون بذالك نبيا نذيرا ، وإن جبريل يأتيني فيكلمني كما يأتي أحدكم صاحبه فيكلمه ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7850 ) قال النبي :(@)(@@) | 30 ( إن من كان قبلكم من بني إسرائيل إذا عمل العامل منهم الخطيئة فنهاه الناهي تعزيرا ، فإذا كان من الغد جالسه وواكله وشاربه كأنه لم يره على خطيئة بالأمس ، فلما رأى الله تعالى ذالك منهم ضرب بقلوب بعضهم على بعض ولعنهم على لسان داود وعيسى بن مريم ذالك بما عصوا وكانوا يعتدون ، والذي نفس محمد بيده لتأمرن بالمعروف ولتنهن عن المنكر ، ولتأخذن على يدي المسمى ولتأطرنه على الحق أطرا أو ليضربن الله بقلوب بعضكم على بعض PageV03P152 ويلعنكم كما لعنهم ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7851 ) قال النبي :(@)(@@) | 30 ( إن من حافظ على هاؤلاء الصلوات الخمس المكتوبات في جماعة كان أول من يجوز على الصراط كالبرق اللامع وحشره الله في أول زمرة من السابقين وكان له في يوم وليلة حافظ عليهن كأجر ألف شهيد قتلوا في سبيل الله ) )(@)(@@) ( طس ) عن أبي هريرة وابن عباس رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 7852 ) قال 
ms875	 النبي :(@)(@@) | 30 ( إن من الأئمة طرادين ) )(@)(@@) ( ش ) عن عباس الجشمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7853 ) قال النبي :(@)(@@) | 30 ( إن من البيان كالسحر ، وإن من الشعر كالحكم ) )(@)(@@) ( هق ) عن ابن عساكر عن جمعة بنت وابل بن مانيل بن عمر ودوسي عن أبيها .(@)(@@)(@@)(@@) $ ( 7854 ) قال النبي :(@)(@@) | 30 ( إن من البيان سحرا ، فإذا طلب أحدكم من أخيه حاجة فلا يبدأه بالمدحة فيقطع ظهره ) )(@)(@@) ( هب ) و ابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7855 ) قال النبي :(@)(@@) | 30 ( إن من البيان لسحرا ، وإن من الشعر لحكما ، وإن من طلب العلم لجهلا ، وإن من القول عيالا ) )(@)(@@) ( كر ) عن علي رضي الله عنه وفي رواية : لعيا .(@)(@@)(@@)(@@) $ ( 7856 ) قال النبي :(@)(@@) | 30 ( إن من الحق على المسلمين أن يغتسل أحدهم يوم الجمعة ، وأن يمس من طيب إن كان عند أهله ، فإن لم يكن عندهم طيب فإن الماء طيب ) )(@)(@@) ( حم ش ) و الطحاوي عن البراء رضي الله عنه وهو حسن وصحيح .(@)(@@)(@@)(@@) $ ( 7857 ) قال النبي :(@)(@@) | 30 ( إن من السعادة الزوجة الصالحة والمسكن الصالح ، والمركب الصالح ، وإن من الشقاء الزوجة السوء والمسكن السوء ، والمركب السوء ) )(@)(@@) ( طب ) عن محمد بن سعد بن أبي وقاص عن أبيه .(@)(@@) PageV03P153(@)(@@)(@@)(@@) $ ( 7858 ) قال النبي :(@)(@@) | 30 ( إن من السنة إذا كان القوم سفرا أن تكون نفقتهم جميعا سواء ، فإن ذالك أطيب لأنفسهم ، وأحسن لأخلاقهم ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7859 ) قال النبي :(@)(@@) | 30 ( إن من السنة أن يشيع الضيف إلى باب الدار ) )(@)(@@) ( هب ) وقال في إسناده ضعف و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7860 ) قال النبي :(@)(@@) | 30 ( إن من الشعر حكمة ، وأصدق بيت قالته العرب : ألا كل شيء ما خلا الله باطل . . . . ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7861 ) قال النبي :(@)(@@) | 30 ( إن من الشعر حكما ) )(@)(@@) ( ط ) عن أبي ( ت ) حسن صحيح ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7862 ) قال النبي :(@)(@@) | 30 ( إن من الشعر حكمة ، وإذا التبس عليكم شيء من القرآن فالتمسوه من الشعر ، فإنه عربي ) )(@)(@@) ( هق ) عن ابن عباس 
ms876	 رضي الله عنهما وقال : إن اللفظ الثاني محتمل أن يكون من قول ابن عباس فادرج في الحديث .(@)(@@)(@@)(@@) $ ( 7863 ) قال النبي :(@)(@@) | 30 ( إن من الصدقة أن تعتق النسمة ، وتفك الرقبة ، قال قائل : أو ليستا واحدة ؟ قال : لا ، عتقها أن يعتقها ، وفكاكها أن يعين في ثمنها ، قال : أفرأيت إن لم أستطع ذالك ؟ قال : تطعم جائعا ، أو تسقي ظمآنا ، قال : فإن لم أستطع ؟ قال : تأمر بالمعروف وتنهى عن المنكر ، قال : فإن لم أستطع ذالك ؟ قال : فمنحة ووكوف ومعطفة على ذي رحم ، قال : فإن لم أستطع ؟ قال : تكف عن الناس أذاك ) )(@)(@@) الخرائطي في مكارم الأخلاق عن عبد الرحمان بن عبد الله بن عتبة بن مسعود .(@)(@@) حديث 7864 غير مطبوع في الكتاب(@)(@@)(@@)(@@) $ ( 7865 ) قال النبي :(@)(@@) | 30 ( إن من الصلوات صلاة من فاتته فكأنما وتر أهله PageV03P154 وماله ، هي صلاة العصر ) )(@)(@@) ( ش ) عن نوافل بن معاوية وابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7866 ) قال النبي :(@)(@@) | 30 ( إن من مطل الغني ظلما وإذا أتبع أحدكم على مليء فليتبع ، وأكذب الناس الصناع ) )(@)(@@) ( عب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7867 ) قال النبي :(@)(@@) | 30 ( إن من العلم كهيئة المكنون لا يعلمه إلا العلماء بالله ، فإذا نطقوا به لا ينكره إلا أهل الغرة بالله عز وجل ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7868 ) قال النبي :(@)(@@) | 30 ( إن من العنب خمرا ، ومن العسل خمرا ، ومن الزبيب خمرا ، ومن الحنطة خمرا ، وأنا أنهى عن كل مسكر ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7869 ) قال النبي :(@)(@@) | 30 ( إن من المؤمنين من يدخل بشفاعته الجنة مثل ربيعة ومضر ) )(@)(@@) ( كر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7870 ) قال النبي :(@)(@@) | 30 ( إن من المثلة أن ينذر الرجل أن يخزم أنفه ، ومن المثلة أن ينذر أن يحج ماشيا ، فإذا نذر أحدكم أن يحج ماشيا فليهد هديا وليركب ) )(@)(@@) ( ط هق ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7871 ) قال النبي :(@)(@@) | 30 ( إن من الناس من يصلي الصلاة كاملة ، ومنهم من يصلي نصفا ، ومنهم من يصلي ثلثا ، ومنهم من 
ms877	 يصلي ربعا ، ومنهم من يصلي خمسا ، ومنهم من يصلي سدسا ، ومنهم من يصلي سبعا ، ومنهم من يصلي ثمنا ، ومنهم من يصلي عشرا ) )(@)(@@) ( طب ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7872 ) قال النبي :(@)(@@) | 30 ( إن من آية سخط الله على العباد أن يسلط عليهم صبيانهم في مسااجدهم فينهوهم فلا ينتهون ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P155(@)(@@)(@@)(@@) $ ( 7873 ) قال النبي :(@)(@@) | 30 ( إن من أبغض الخلق إلى الله تعالى لمن آمن ثم كفر ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7874 ) قال النبي :(@)(@@) | 30 ( إن من أخوف ما أخاف على أمتي طول الأمل ، واتباع الهوى ، فإن طول الأمل ينسي الآخرة ، واتباع الهوى يصد عن الحق ، وإن الدنيا مدبرة ، والآخرة مقبلة ، ولكل واحدة منهما بنون ، فكونوا بني الآخرة ، ولا تكونوا بني الدنيا ، اليوم عمل ولا حساب ، وغدا حساب ولا عمل ، فرحم الله من تكلم بخير أو سكت فسلم ، وبروا القرابة كانت مقبلة أو مدبرة ) )(@)(@@) ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7875 ) قال النبي :(@)(@@) | 30 ( إن من أشد الناس عذابا يوم القيامة المصورين ) )(@)(@@) ( ن ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7876 ) قال النبي :(@)(@@) | 30 ( إن من أخون الخبانة تجارة الوالي في رعيته ) )(@)(@@) أبو سعيد النقاش في القضاة عن أبي الأسود المالكي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7877 ) قال النبي :(@)(@@) | 30 ( إن من أربى الربا الاستطالة في عرض المسلم بغير حق ، وإن هاذه الرحم شجنة من الرحمان فمن قطعها حرم الله عليه الجنة ) )(@)(@@) ( حم ) و سمويه ( طب وابن قانع ( ض ) عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7878 ) قال النبي :(@)(@@) | 30 ( إن من أربى الربا تفضيل المرء على أخيه بالشتم ، وإن من أكبر الكبائر شتم الرجل والديه ، قالوا كيف يشتم الرجل والديه ؟ قال : يساب الرجل الناس فيستسب لهما ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن ابن أبي نجيح عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 7879 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة أن يفشو المال ، ويكثر العلم ، PageV03P156 وتفشو التجارة ، ويظهر الجهل ، ويبيع الرجل البيع فيقول : لا حتى أستأمر 
ms878	 تاجر بني فلان ، ويلتمس في الحي الحطيم الكاتب فلا يوجد ) ( حم ن ) عن ع$ مرو بن ثعلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7880 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة أن يقبض العلم ، ويظهر القلم ، وتفشو التجارة ) )(@)(@@) ( طب ) عن عمرو بن ثعلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7881 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة أن يفيض المال ، ويكثر الجهل ، وتظهر الفتن ، وتفشو التجارة ) )(@)(@@) ( ك ) عن عمرو بن ثعلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7882 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة ، إذا كانت التحية على المعرفة ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7883 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة الفحح والتفحح ، وسوء الجوار ، وقطع الأرحام ، وأن يؤتمن الخائن ، ويخون الأمين ، ومثل المؤمن كمثل القطعة الذهب الجيدة أوقد عليها فخلصت ووزنت فلم تنقص ، ومثل المؤمن كمثل النحلة أكلت طيبا ووضعت طيبا ، ألا إن أفضل الشهداء المقسطون ، ألا إن أفضل المهاجرين من هجر ما حرم الله عليه ، ألا إن أفضل المسلمين من سلم المسلمون من لسانه ويده ، ألا إن حوضي طوله كعرضه ، أبيض من اللبب ، وأحلى من العسل ، آنيته عدد النجوم من أقداح الذهب والفضة من شرب منه شربة لم يظمأ آخر ما عليها أبدا ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7884 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة أن يغلب على الدنيا لكع ابن لكع ، وأفضل الناس مؤمن بين كريمين ) )(@)(@@) العسكري في الأمثال عن عمرو رجاله ثقات .(@)(@@) PageV03P157(@)(@@)(@@)(@@) $ ( 7885 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة أن يرفع العلم ويظهر الجهل ) )(@)(@@) ابن النجار عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7886 ) قال النبي :(@)(@@) | 30 ( إن من أشراط الساعة إخراب العامر وإعمار الخراب ، وأن يكون الغزو فداء ، وأن يتمرس الرجل بأمانته كما يتمرس البعير بالشجرة ) )(@)(@@) البغوي وابن عساكر عن عروة بن محمد بن عطية عن أبيه .(@)(@@)(@@)(@@) $ ( 7887 ) قال النبي :(@)(@@) | 30 ( إن من أصحابي من لا يراني بعد أن أموت أبدا ) )(@)(@@) ( حم طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7888 ) قال النبي :(@)(@@) | 30 ( إن من 
ms879	 أعتى الناس على الله ثلاثة : رجل قتل غير قاتله ، أو قتل بذحل الجاهلية ، ومن بصر عينيه في النوم ما لم تبصرا ) )(@)(@@) الباوردي ( ك ) عن أبي شريح .(@)(@@)(@@)(@@) $ ( 7889 ) قال النبي :(@)(@@) | 30 ( إن من أفرى الفرى أن يعتزي الرجل إلى غير والديه ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7890 ) قال النبي :(@)(@@) | 30 ( إن من أشد الناس عذابا يوم القيامة الذين يصورون هاذه الصور ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7891 ) قال النبي :(@)(@@) | 30 ( إن من أشد أمتي بي حبا ناسا يكونون بعدي ، يود أحدهم لو رآني بأهله وماله ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه عن سهل بن سعد .(@)(@@)(@@)(@@) $ ( 7892 ) قال النبي :(@)(@@) | 30 ( إن من أفضل الصيام صيام أخي داود ، كان يصوم يوما ويفطر يوما ) )(@)(@@) ( هب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@) PageV03P158(@)(@@)(@@)(@@) $ ( 7893 ) قال النبي :(@)(@@) | 30 ( إن من اقتراب الساعة هلاك العرب ) )(@)(@@) ( ش هق ) في البعث عن طل حة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7894 ) قال النبي :(@)(@@) | 30 ( إن من أكبر ذنب توافى به أمتي يوم القيامة لسورة من كتاب الله كانت مع أحدهم فنسيها ) )(@)(@@) محمد بن نصر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7895 ) قال النبي :(@)(@@) | 30 ( إن من أكبر الكبائر أن ينتفي الرجل من ولده ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7896 ) قال النبي :(@)(@@) | 30 ( إن من أكبر الكبائر أن يقول الرجل علي ما لم أقل ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7897 ) قال النبي :(@)(@@) | 30 ( إن من إكرام جلال الله إكرام ذي الشيبة المسلم والإمام العادل ، وحامل القرآن لا يغلو فيه ولا يجفو عنه ) )(@)(@@) ( عد طب ) و الخرائطي في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7898 ) قال النبي :(@)(@@) | 30 ( إن من أكمل الإيمان حسن الخلق ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7899 ) قال النبي :(@)(@@) | 30 ( إن من أمتي من لا يستطيع أن يأتي مسجده أو مصلاه من العري ، يحجزه إيمانه أن يسأل الناس ، منهم أويس القرني وفراة ابن حسان ) )(@)(@@) ( حم 
ms880	 ) في الزهد ( حل ) عن محارب بن دثار وعن سالم بن أبي الجعد مرسلا .(@)(@@)(@@)(@@) $ ( 7900 ) قال النبي :(@)(@@) | 30 ( إن من أمتي أمة يدخل الله الجنة منهم سبعين ألفا بغير حساب ) )(@)(@@) ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7901 ) قال النبي :(@)(@@) | 30 ( إن من أمتي من يدخل الجنة بشفاعته أكثر من ربيعة ومضر ) )(@)(@@) ( هناد ) عن الحارث بن أقيش هناد وأبو البركات بن السقطي في معجمه وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P159(@)(@@)(@@)(@@) $ ( 7902 ) قال النبي :(@)(@@) | 30 ( إن من أمتي من لو جاء أحدهم إلى أحدكم فسأله دينارا أو درهما ما أعطاه ، ولو سأل الله الجنة لأعطاه إياها ، ولو أقسم على الله تعالى لأبره ، ولو سأله شيئا من الدنيا ما أعطاه الله تكرمة له ) )(@)(@@) ابن صصرى في أماليه عن سالم بن أبي الجعد مرسلا .(@)(@@)(@@)(@@) $ ( 7903 ) قال النبي :(@)(@@) | 30 ( إن من أمتي من لو أتى باب أحدكم فسأله دينارا لم يعطه إياه ، ولو سأله درهما لم يعطه إياه ، ولو سأله فلسا لم يعطه إياه ، ولو سأل الله الجنة لأعطاها إياه ، ولو سأله الدنيا لم يعطها إياه ، وما يمنعها إياه لهوانها عليه ، ررب أشعث أغبر لو أقسم على الله لأبره ) )(@)(@@) ( هناد ) عن سالم بن أبي الجعد مرسلا .(@)(@@)(@@)(@@) $ ( 7904 ) قال النبي :(@)(@@) | 30 ( إن من أمتي لرجالا الإيمان أثبت في قلوبهم من الجبال الرواسي ) )(@)(@@) ابن جرير عن أبي إسحاق السبيعي مرسلا .(@)(@@)(@@)(@@) $ ( 7905 ) قال النبي :(@)(@@) | 30 ( إن من أهل النار من تأخذه النار إلى كعبيه ، ومنهم من تأخذه إلى ركبتيه ، ومنهم من تأخذه إلى حقويه ، ومنهم من تأخذه إلى ترقوته ) )(@)(@@) ( طب ك ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7906 ) قال النبي :(@)(@@) | 30 ( إن من بعدكم الكذاب المضل ، وإن رأسه حبك حبك ، وإنه سيقول : أنا ربكم ، فمن قال : كذبت لست ربنا ولاكن الله ربنا ، عليه توكلنا وإليه أنبنا ، ونعوذ بالله منك ، فلا سبيل له عليك ) )(@)(@@) ( حم ) و الخطيب عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 7907 ) قال النبي :(@)(@@) | 30 ( إن من بر الرجل بأبيه أن يبر أهل ود أبيه ) )(@)(@@) ابن عساكر عن 