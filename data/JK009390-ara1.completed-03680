ms3661	 تشهد به ، فلا يهتدي لاسمه ، فيقال : محمد ، فيقول : سمعت الناس يقولون شيئا فقلته كما قالوا ، فيقال له : صدقت ، علاى هاذا حييت وعليه مت ، وعليه تبعث إن شاء الله ، ويضيق عليه صدره حتى تختلف أضلاعه ، فذلك قول الله عز وجل : { ومن أعرض عن ذكري فإن له معيشة ضنكا } ( 1 ) فيقال له : افتحوا له بابا إلاى الجنة ، فيقال : هاذا منزلك وما أعد الله لك لو أطعته ، فيزداد حسرة وثبورا ، ثم يقال : افتحوا له بابا إلاى النار ، فيفتح له إليها فيقال : هاذا منزلك وما أعد الله لك ، فيزداد حسرة وثبورا ) )(@)(@@) | . ( طكس ، عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV11P283(@)(@@)(@@)(@@) $ 4489 / 33514(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ليدخلن الجنة الفاجر في دينه ، الأحمق في معيشته ، والذي نفسي بيده ليدخلن الجنة الذي محصته النار بذنبه ، والذي نفسي بيده ليغفرن الله يوم القيامة مغفرة يتطاول لها إبليس رجاء أن يغفر له ، والذي نفسي بيده ليغفرن الله يوم القيامة مغفرة لا تخطر علاى قلب بشر ) )(@)(@@) . ( طك ، عن حذيفة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4490 / 33515(@)(@@) | 30 قال النبي : ( والذي نفسي بيده لو اجتمع علاى قتل مؤمن ، أهل السماء والأرض ورضوا به لأدخلهم الله جميعا جهنم ) )(@)(@@) . ( طس ، عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4491 / 33516(@)(@@) | 30 قال النبي : ( والذي نفس محمد بيده ، لو أن أهل السماوات والأرض اجتمعوا علاى قتل مؤمن إلا أدخلهم الله جميعا جهنم ، ولا يبغضنا أهل البيت أحد إلا كبه الله في النار ) )(@)(@@) . ( بز ، عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4492 / 33517(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لا يضع الله رحمته إلا علاى رحيم ، قالوا : كلنا رحيم ، قال : أليس برحمة أحدكم صاحبه يرحم الناس كافة ) )(@)(@@) . ( الحكيم عن أنس رضي الله عنه ورجاله وثقوا إلا ابن إسحاق مدلس ) .(@)(@@)(@@)(@@) $ 4493 / 33518(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لاءن يأخذ أحدكم حبله فيذهب به إلاى الجبل فيحتطب ثم يأتي به فيحمله علاى ظهره فيبيعه فيأكل ، خيرا له من أن يسأل الناس ، ولأن يأخذ ترابا في فيه خيرا له من أن 
ms3662	 يجعل في فيه ما حرم الله عليه ) )(@)(@@) . ( حم ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4494 / 33519(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، إن مثل المؤمن مثل النحلة ، أكلت طيبا ورفعت فلم تكثر ولم تفسد ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 4495 / 33520(@)(@@) | 30 قال النبي : ( والذي نفس محمد بيده ، ما من أحد منكم يؤمن بالله ثم يسدد إلا سلك الجنة ، ولقد وعدني ربي أن يدخل من أمتي سبعين ألفا PageV11P284 لا حساب عليهم ولا عذاب ، وإني لأرجو أن لا يدخلوها حتى تبوءوا أنتم ومن صلح من أزواجكم وذرياتكم مساكن في الجنة ، الحديث ) )(@)(@@) . ( طك ، بز ، عن رفاعة بن غرابة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4496 / 33521(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، الدنيا أهون عند الله عز وجل من هاذه علاى أهلها يعني شاة ميتة مر بها ) )(@)(@@) . ( حم ، ع ، بز ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 4497 / 33522(@)(@@) | 30 قال النبي : ( والذي نفس محمد بيده ، لا يسمع بي أحد من هاذه الأمة ولا يهودي ، ولا نصراني ولم يؤمن بالذي أرسلت به إلا كان من أصحاب النار ) )(@)(@@) . ( حم ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4498 / 33523(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لقد جئتكم بها بيضاء نقية ، لا تسألوهم عن شيء فيخبروكم بحق فتكذبوا به ، أو بباطل فتصدقوا به ، والذي نفسي بيده ، لو أن موساى كان حيا ما وسعه إلا أن يتبعني ) )(@)(@@) . ( حم ، عن جابر رضي الله عنه أن عمر أتاى النبي بكتاب أصابه من أهل الكتاب فقرأه فغضب فذكره ) .(@)(@@)(@@)(@@) $ 4499 / 33524(@)(@@) | 30 قال النبي : ( والذي نفس أبي القاسم بيده ، لينزلن عيساى بن مريم إماما مقسطا ، وحكما عدلا فليكسرن الصليب ، وليقتلن الخنزير ، وليصلحن ذات البين ، وليصلحن الشحناء ، وليعرضن المال فلا يقبله أحد ، ثم لئن قام علاى قبري فقال : يا محمد لاجيبه ) )(@)(@@) . ( ع ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4500 / 33525(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، إنه ليخفف علاى المؤمن حتى يكون أهون عليه من صلاة مكتوبة يصليها في الدنيا ) )(@)(@@) . ( حم ، ع ، عن أبي 
ms3663	 سعيد PageV11P285 رضي الله عنه قال : قيل يا رسول الله { يوم كان مقداره خمسين ألف سنة } ( 1 ) ما أطول هاذ اليوم ؟ فذكره ) .(@)(@@)(@@)(@@) $ 4501 / 33526(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، ما بقي من الدنيا فيما مضاى منها إلا كما بقي من يومكم من هاذا فيما مضاى ، وما يراى من الشمس إلا يسيرا ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4502 / 33527(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، ليختصمن يوم القيامة حتى الشاتان فيم انتطحتا ) )(@)(@@) . ( ع ، وأحمد بنحوه عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4503 / 33528(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، ليقادن لها يوم القيامة ) )(@)(@@) . ( حم ، بز ، طس ، عن أبي ذر رضي الله عنه قال : كان شاتان تعتلفان فنطحت إحداهما الأخراى فأجهضتها ، فضحك رسول الله فقيل : ما يضحكك ؟ قال : عجبت لها فذكره ، وفيه ليث بن أبي سليم وهو مدلس وبقية رجال أحمد رجال الصحيح غير شيخه ابن عائشة وهو ثقة ) .(@)(@@)(@@)(@@) $ 4504 / 33529(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لا تقوم الساعة حتى يظهر الفحش والبخل ويخون الأمين ، ويؤتمن الخائن ، ويهلك الوعول أي وجوه الناس وأشرافهم وتظهر التحوت أي الذين كانوا تحت أقدام الناس لا يعلم بهم ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4505 / 33530(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لا تفنى هاذه الأمة حتى يقوم الرجل إلاى المرأة فيفترسها في الطريق فيكون خيارهم يومئذ من يقول : لو واريتها وراء هاذا الحائط ) )(@)(@@) . ( ع ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4506 / 33531(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لو أن النطفة التي أخذ PageV11P286 الله عليها الميثاق ألقيت علاى صخرة لخلق الله منها إنسانا ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 4507 / 33532(@)(@@) | 30 قال النبي : ( والذي نفس محمد بيده ، لقد ظننت أنك أول من يسألني عن ذالك من أمتي لما رأيت من حرصك علاى العلم ، والذي نفس محمد بيده ، لما يهمني من انفضاضهم علاى أبواب الجنة أهم عندي من تمام شفاعتي ، وشفاعتي لمن شهد أن لا إلاه إلا الله مخلصا يصدق قلبه 
ms3664	 لسانه ، ولسانه قلبه ) )(@)(@@) . ( حم ، عن أبي هريرة رضي الله عنه قال : سألت النبي : ما زاد إليك ربك في الشفاعة ؟ فذكره ) .(@)(@@)(@@)(@@) $ 4508 / 33533(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، ليبعثن الله منكم يوم القيامة إلاى الجنة مثل الليل الأسود زمرة جميعا ، يحيطون الأرض ، فتقول الملائكة : لما جاء مع محمد أكثر مما جاء مع الأنبياء ؟ ) )(@)(@@) . ( طك ، عن أبي مالك الأشعري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4509 / 33534(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، ما يسرني أنه لي قطعا ذهبا أنفقه في سبيل الله عز وجل أدع منه قيراطا ) )(@)(@@) . ( حم ، عن أبي ذر رضي الله عنه قال : قال لي رسول الله : أي جبل هاذا ؟ قلت : أحدا ، فذكره ) .(@)(@@)(@@)(@@) $ 4510 / 33535(@)(@@) | 30 قال النبي : ( والذي نفسي بيده ، لولا أن تقول فيك يا علي طوائف من أمتي بما قالت النصاراى في عيساى بن مريم ، لقلت فيك مقالا لا تمر بأحد من المسلمين إلا أخذ التراب من أثر قدميك يطلب به البركة ) )(@)(@@) . ( طك ، عن أبي رافع رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4511 / 33536(@)(@@) | 30 قال النبي : ( وأين أنت يا نعمان من مهيعة ( 1 ) وكانت PageV11P287 وبيئة ( 2 ) ) )(@)(@@) . ( طكس ، عن أبي رافع بن خديج رضي الله عنه قال : قال نعمان : يا رسول الله بي وعك شديد من الحمى فذكره ، وفيه إسحاق مدلس ) .(@)(@@)(@@)(@@) $ 4512 / 33537(@)(@@) | 30 قال النبي : ( والشاة إن رحمتها رحمك الله ) )(@)(@@) . ( حم ، بز طك ، عن قرة عن أبيه أن رجلا قال : يا رسول الله إني لا أرحم الشاة فأرحمها ؟ ، فذكره ، ورجاله ثقات ، طك ، عن معقل بن يسار رضي الله عنه بلفظ : ( وإن رحمتها رحمك الله ) ) .(@)(@@)(@@)(@@) $ 4513 /(@)(@@)(@@)(@@) ||| الواو مع الضاد(@)(@@)(@@)(@@) $ 33538(@)(@@) | 30 قال النبي : ( وضع عن أمتي : الخطأ والنسيان وما استكرهوا عليه ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 4514 /(@)(@@)(@@)(@@) ||| الواو مع العين(@)(@@)(@@)(@@) $ 33539(@)(@@) | 30 قال النبي : ( وعدني جبريل مواعد وإنه أبطأ علي ثم قال : ما منعني من ذالك إلا صوت جرس أو صورة في بيت ) )(@)(@@) . ( طس ، عن عمر بن الخطاب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4515 / 33540(@)(@@) | 30 قال النبي : ( وعدني ربي عز وجل 
ms3665	 أن يدخل الجنة من أمتي مائة ألف ، فقال أبو بكر : زدنا فقال : وهاكذا وأشار بيده ) )(@)(@@) . ( طس ، حم ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4516 /(@)(@@)(@@)(@@) ||| الواو مع الفاء(@)(@@)(@@)(@@) $ 33541(@)(@@) | 30 قال النبي : ( وفروا اللحى ، خذوا من الشوارب ، وانتفوا الآباط ، وعليكم بالاستحداد والاختتان والانتضاح ) )(@)(@@) . ( طس ، عن عمار بن ياسر وأبي هريرة رضي الله عنهما ) .(@)(@@) PageV11P288(@)(@@)(@@)(@@) ||| ( الواو مع الكاف )(@)(@@)(@@)(@@) $ 4517 / 33542(@)(@@) | 30 قال النبي : ( وكل ما توعدون في مائة سنة ) )(@)(@@) . ( بز ، عن ثوبان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4518 /(@)(@@)(@@)(@@) ||| الواو مع اللام(@)(@@)(@@)(@@) $ 33543(@)(@@) | 30 قال النبي : ( وليس الأجر إلا ذالك ) )(@)(@@) . ( طك ، عن عصمة رضي الله عنه قال : قال نفر : إنا(@)(@@) | 40 ( نمر به ذه الأسواق فننظر الفواكه فنشتهيها وليس معنا ما نشتري به فهل ) 40(@)(@@) نمر بهاذه الأسواق فننظر الفواكه فنشتهيها وليس معنا ما نشتري به فهل لنا في ذالك أجر ؟ فذكره ) .(@)(@@)(@@)(@@) $ 4519 / 33544(@)(@@) | 30 قال النبي : ( ولد الزنا ليس عليه من إثم أبويه شيء ، ثم قرأ : { ولا تزر وازرة وزر أخراى } ( 1 ) ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 4520 / 33545(@)(@@) | 30 قال النبي : ( ولد نوح : سام ، وحام ، ويافث ، فولد سام : العربا ، وفارس ، والروم والخير فيهم ، وولد يافث : يأجوج ومأجوج ، والترك ، والصقالبة ولا خير فيهم ، وولد حام : القبط ، والبربر ، والسودان ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4521 /(@)(@@)(@@)(@@) ||| الواو مع الميم(@)(@@)(@@)(@@) $ 33546(@)(@@) | 30 قال النبي : ( وما كان عليك أن لا تغتسل ما لم تنزل ) )(@)(@@) . ( ع ، بز ، عن ابن عباس رضي الله عنهما قال : أرسل رسول الله إلاى رجل من الأنصار فأبطأ عليه ، فقال : ما حبسك ؟ قال : كنت من حين أتاني علاى المرأة فاغتسلت فذكره ) .(@)(@@)(@@)(@@) $ 4522 / 33547(@)(@@) | 30 قال النبي : ( وما لي لا تطيب نفسي ، ويظهر بشري ، وإنما فارقني جبريل عليه السلام الساعة فقال : يا محمد من صلى عليك من أمتك صلاة كتب الله له بها عشر حسنات ، ومحاى عنه عشر سيئات ، ورفعه بها عشر PageV11P289 درجات ، وقال له الملك : مثل ما قال لك ، قلت : يا جبريل وما ذاك الملك ؟ قال : إن الله عز وجل وكل بك منذ خلقك 
ms3666	 إلاى أن يبعثك لا يصلي عليك أحد من أمتك إلا قال : وأنت صلى الله عليك ) )(@)(@@) . ( طك ، عن أبي طلحة رضي الله عنه قال : دخلت علاى النبي وأسارير وجهه تبرق ، ما رأيتك بأطيب نفسا وأظهر بشرا من يومك ، فذكره ) .(@)(@@)(@@)(@@) $ 4523 /(@)(@@)(@@)(@@) ||| الواو مع الهاء(@)(@@)(@@)(@@) $ 33548(@)(@@) | 30 قال النبي : ( وهل يدرك أهل بدر وأهل أحد ما يدرك الفقير القانع ) )(@)(@@) . ( ع ، عن أبي هريرة رضي الله عنه قال : خرجت أنا ورسول الله ويده في يدي ، فأتاى علاى رجل رث الهيأة ، قال : أبو فلان ما بلغ بك ما أراى ؟ قال : السقم والضر يا رسول الله ، قال : ألا أعلمك كلمات يذهب الله عنك السقم والضر ؟ قال : ما يسرني بها أني شهدت معك بدرا وأحدا ، فضحك رسول الله وذكره ) .(@)(@@)(@@)(@@) $ 4524 /(@)(@@)(@@)(@@) ||| الواو مع الياء(@)(@@)(@@)(@@) $ 33549(@)(@@) | 30 قال النبي : ( ويأكل ذالك أحد ؟ ) )(@)(@@) . ( طك ، عن عبد الله بن معقل السلمي رضي الله عنه قال : سألته رضي الله عنه عن الثعلب والذئب فذكره ) .(@)(@@)(@@)(@@) $ 4525 / 33550(@)(@@) | 30 قال النبي : ( ويحك يا أعرابي ، إنما ألبسها لأقمع بها الكبر ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها قالت : خرج النبي وقد عقد عقدة بين كتفيه ، فقال له أعرابي : ما هاذا يا رسول الله ؟ فذكره ) .(@)(@@)(@@)(@@) $ 4526 / 33551(@)(@@) | 30 قال النبي : ( ويل إنها لقرية يدعها أهلها خير ما تكون ، PageV11P290 فيأتيها الدجال فيجد علاى كل باب من أبوابها ملكا مصلتا بجناحه فلا يدخلها ) )(@)(@@) . ( حم ، عن محجن رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4527 / 33552(@)(@@) | 30 قال النبي : ( ويل أمك قرية يدعك أهلك وأنت خير ما تكونين ) )(@)(@@) . ( طك ، عن محجن رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4528 / 33553(@)(@@) | 30 قال النبي : ( ويل أمها من قرية يدعها أهلها كأينع ما تكون ، قيل : من يأكل ثمرتها ؟ قال : عافية الطير والسباع ، ولا يدخلها الدجال ، كلما أراد أن يدخلها ، بكل نقب من أنقابها ملك فصده ) )(@)(@@) . ( طس ، عن محجن رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4529 / 33554(@)(@@) | 30 قال النبي : ( ويل للأمراء ، ويل للعرفاء ، ويل للأمناء ، ليتمنين أقوام يوم القيامة أن ذوائبهم كانت معلقة بالثريا يتذبذبون بين السماء والأرض ولم يكونوا عملوا علاى شيء 
