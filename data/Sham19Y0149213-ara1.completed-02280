ms2261	(@)(@@)(@@)(@@) $$$ [سي]: أبو فروة (5) الأشجعي.(@)(@@) عن: ظئر لرسول الله - صلى الله عليه وسلم -.(@)(@@) وعنه: أبو إسحاق.(@)(@)PageV10P362(@)(@)(@@) وصوابه: فروة، كما تقدم.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو فروة (1) الرهاوي يزيد بن سنان.(@)(@@)(@@)(@@) $$$ [خ م د س ق]: أبو فروة (2) الجهني مسلم بن سالم.(@)(@@)(@@)(@@) $$$ [خ م د س]: أبو فروة (2) الاكبر عروة بن الحارث.(@)(@@)(@@)(@@) $$$ [ق]: أبو فروة (2).(@)(@@) عن: (أبي) (3) خلاد.(@)(@@) وعنه: يحيى بن سعيد الأموي.(@)(@@) هو يزيد بن سنان الرهاوي.(@)(@@)(@@)(@@) $$$ [بخ م د ت ق]: أبو فزارة (4) العبسي راشد بن كيسان.(@)(@@)(@@)(@@) $ 8366 - [د]: أبو الفضل (4) بن خلف الأنصاري وقيل: أبو الفضيل،(@)(@@) وقيل: أبو المفضل، وقيل: ابن المفضل.(@)(@@) عن: مسلم بن أبي بكرة.(@)(@@) وعنه: نوح بن ربيعة.(@)(@@)(@@)(@@) $ 8367 - [سي]: أبو الفضل (5)، وقيل: ابن المفضل.(@)(@@) عن: ابن عمر.(@)(@@) وعنه: يونس بن خباب.(@)(@)PageV10P363(@)(@)(@@)(@@)(@@) $$$ [د ت س]: أبو الفيض (1) شامي موسى بن أيوب.(@)(@@)(@@)(@@) $$$ [سي]: أبو الفيض (2).(@)(@@) عن: أبي ذر. في ترجمة أبي علي الأزدي.(@)(@)PageV10P364(@)(@)(@@)(@@)(@@) || حرف القاف(@)(@@)(@@)(@@) $ 8368 - [د ت]: أبو قابوس (1).(@)(@@) عن: مولاه عبد الله بن عمرو.(@)(@@) وعنه: عمرو بن دينار حديث "الراحمون" (2) وصححه الترمذي.(@)(@@)(@@)(@@) $ 8369 - [ق]: أبو القاسم (3) بن أبي الزناد المدني أخو عبد الرحمن وكان(@)(@@) الأصغر.(@)(@@) عن: عبيد الله بن عبد الرحمن بن موهب، وسلمة بن وردان،(@)(@@) وأفلح بن حميد، وإسحاق بن حازم، وأبي الغصن ثابت بن قيس،(@)(@@) وجماعة.(@)(@@) وعنه: أحمد بن حنبل، وإبراهيم بن المنذر الحزامي، وعبيد الله(@)(@@) القواريري، ويعقوب بن محمد الزهري، ومحمد بن أبان البلخي،(@)(@@) وجماعة.(@)(@@) أثنى عليه أحمد وقال: كتبت عنه وهو شاب.(@)(@@) وقال ابن معين: اسمه كنيته، ليس به بأس، وأخوه ليس بشيء.(@)(@@)(@@)(@@) $$$ [د س]: أبو القاسم (4) الجدلي حسين بن الحارث تابعي.(@)(@@)(@@)(@@) $$$ [عخ قد ت س فق]: أبو قبيل (5) المعافري حي بن هانىء.(@)(@)PageV10P365(@)(@)(@@)(@@)(@@) $ 8370 - [ع]: أبو قتادة (1) [الأنصاري] (2) فارس رسول الله - صلى الله عليه وسلم - الحارث(@)(@@) ابن ربعي، وقيل: النعمان بن ربعي، وقيل: عمرو، من بني كعب بن(@)(@@) سلمة، شهد أحدا والمشاهد، وله أحاديث صالحة.(@)(@@) وروى أيضا عن: (3) عمر، ومعاذ.(@)(@@) وعنه: أبو سعيد، وجابر، وأنس، وسعيد بن المسيب، ومعبد بن(@)(@@) كعب بن مالك، 
ms2262	 وعبد الله ولده، وعبد الله بن رباح، وعمرو بن سليم(@)(@@) الزرقي، ومولاه نافع، وخلق.(@)(@@) ويقال: كان بدريا. ولم يصح.(@)(@@) قال إياس بن سلمة، عن (أبيه، عن) (4) النبي - صلى الله عليه وسلم - قال: "خير(@)(@@) فرساننا أبو قتادة، وخير رجالنا سلمة". وعن يحيى بن عبد الله بن أبي(@)(@@) قتادة: أن جده فات بالمدينة سنة أربع وخمسين وله سبعون سنة. وكذا(@)(@@) قال يحيى بن بكير وجماعة. وقال الهيثم بن عدي وغيره: مات بالكوفة(@)(@@) وصلى عليه علي - رضي الله عنه -. قال بعضهم: سنة ثمان وثلاثين. قال(@)(@@) الواقدي: لم أر بين ولد أبي قتادة وأهل البلد عندنا اختلافا أن أبا قتادة(@)(@@) توفي بالمدينة، وروى أهل الكوفة أنه توفي بالكوفة والله أعلم.(@)(@@)(@@)(@@) $$$ أبو قتادة (5) الحراني عبد الله بن واقد. تقدم.(@)(@@)(@@)(@@) $ 8371 - [م د س]: أبو قتادة (6) العدوي البصري مختلف(@)(@@) في صحبته.(@)(@)PageV10P366(@)(@)(@@) عن: عمر، وعمران بن حصين، وهشام بن عامر، وأسير بن(@)(@@) جابر.(@)(@@) وعنه: حميد بن هلال، وإسحاق بن سويد.(@)(@@) قال ابن معين: اسمه تميم بن نذير.(@)(@@) وقال غيره: تميم بن الزبير. وقال خليفة: نذير بن قنفذ.(@)(@@) وقال ابن مندة: له صحبة. وثقه ابن معين، له في الكتب(@)(@@) حديثان (1).(@)(@@)(@@)(@@) $$$ [خ 4]: أبو قتيبة (2) الشعيري سلم بن قتيبة.(@)(@@)(@@)(@@) $ 8372 - أبو قتيبة (2) نعيم بن ثابت بصري.(@)(@@) عن: ابن سيرين، وأبي قلابة.(@)(@@) وعنه: أبو يحيى الحماني، وعبد الرحمن بن أبي حماد.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $$$ [د]: أبو قتيلة (3) الشرعبي مرثد بن عبد الله.(@)(@)PageV10P367(@)(@)(@@)(@@)(@@) $$$ [خت م د ت]: أبو قدامة (1) الإيادي الحارث بن عبيد.(@)(@@)(@@)(@@) $$$ [خ م س]: أبو قدامة (1) السرخسي عبيد الله بن سعيد.(@)(@@)(@@)(@@) $$$ [بخ]: أبو قرصافة (2) الكناني جندرة بن خيشنة.(@)(@@)(@@)(@@) $ 8373 - [ت]: أبو قرة (3) الأسدي الصيداوي.(@)(@@) عن: سعيد بن المسيب.(@)(@@) وعنه: النضر بن شميل.(@)(@@)(@@)(@@) $$$ [س]: أبو قرة (4) الزبيدي موسى بن طارق.(@)(@@)(@@)(@@) $$$ [م 4]: أبو قزعة (5) سويد بن حجير الباهلي.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو قطن (6) عمرو بن الهيثم.(@)(@@)(@@)(@@) $$$ [ق]: أبو القلوص (6) حصين بن أبي الحر وهو باسمه أشهر.(@)(@@)(@@)(@@) $$$ [د]: أبو القموص (6) العبدي زيد بن علي.(@)(@@)(@@)(@@) $$$ [ع]: أبو قلابة (7) الجرمي عبد الله بن زيد.(@)(@@)(@@)(@@) $$$ [ق]: أبو قلابة 
ms2263	 (7) الرقاشي عبد الملك بن محمد البصري.(@)(@@)(@@)(@@) $$$ [م س ق]: أبو قيس (7) بن رياح زياد.(@)(@)PageV10P368(@)(@)(@@)(@@)(@@) $$$ [خ 4]: أبو قيس (1) الأودي عبد الرحمن بن ثروان.(@)(@@)(@@)(@@) $$$ أبو قيس (2) الدمشقي يقال: محمد بن سعيد المصلوب، كذا كناه(@)(@@) أبو معاوية.(@)(@@)(@@)(@@) $ 8374 - [ع]: أبو قيس (3).(@)(@@) عن: مولاه عمرو بن العاص، وأم سلمة، وغيرهما.(@)(@@) وعنه: ابنه عروة، وعلي بن رباح، ويزيد بن أبي حبيب، وبسر(@)(@@) ابن سعيد، وغيرهم.(@)(@@) قال أبو سعيد بن يونس: يقال إنه رأى أبا بكر الصديق - رضي الله(@)(@@) عنه - واسمه عبد الرحمن بن ثابت، وكان أحد فقهاء الموالي، شهد(@)(@@) فتح مصر ومات سنة أربع وخمسين فيما قال ابن لهيعة.(@)(@@) قلت: فتكون رواية يزيد عنه منقطعة.(@)(@@) أنبأنا أبو إسحاق بن الدرجي، عن الصيدلاني وجماعة قالوا:(@)(@@) أخبرتنا فاطمة بنت عبد الله [قالت: أخبرنا أبو بكر بن ريذة، قال] (4)(@)(@@) أخبرنا أبو القاسم الطبراني، حدثنا هارون بن ملول، حدثنا المقرئ،(@)(@@) حدثنا حيوة بن شريح، عن ابن الهاد، عن محمد بن إبراهيم، عن(@)(@@) بسر بن سعيد، عن أبي قيس مولى عمرو بن العاص، عن عمرو أنه(@)(@@) سمع رسول الله - صلى الله عليه وسلم - يقول: "إذا حكم الحاكم فاجتهد ثم أصاب فله(@)(@@) أجران، وإذا حكم فاجتهد ثم أخطأ فله أجر". قال ابن الهاد: فحدثت أبا(@)(@@) بكر بن محمد بن عمرو بن حزم، فقال: هكذا حدثني أبو PageV10P369(@)(@@) سلمة عن أبي هريرة. ورواه الدراوردي عن ابن الهاد، أخرجه (خ) (1)(@)(@@) عن المقرئ و (س) (2) عن إسحاق عن المقرئ و (م) (3) من طريق(@)(@@) الدراوردي.(@)(@)PageV10P370(@)(@)(@@)(@@)(@@) || حرف الكاف(@)(@@)(@@)(@@) $$$ [ف س]: أبو كامل (1) الحافظ مظفر بن مدرك.(@)(@@)(@@)(@@) $$$ [خت م د س]: أبو كامل (1) الجحدري فضيل بن الحسين.(@)(@@)(@@)(@@) $ 8375 - [س ق]: أبو كاهل (2) الأحمسي له صحبة رأى النبي - صلى الله عليه وسلم -(@)(@@) يخطب يوم العيد على ناقة. (3)، يقال: قيس بن عائذ، وقيل: عبد الله بن(@)(@@) مالك.(@)(@@) روى إسماعيل بن أبي خالد عن أخيه عنه. وقيل: عنه بلا واسطة.(@)(@@)(@@)(@@) $ 8376 - [ت]: أبو كباش (4) العيشي، وقيل: السلمي، وقيل: أبو(@)(@@) عياش.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: كدام بن عبد الرحمن دي "الأضحية" (5).(@)(@@)(@@)(@@) $ 8377 
ms2264	 - [د ت ق]: أبو كبشة (6) الأنماري المذحجي سعد بن عمرو،(@)(@@) وقيل: عمرو بن سعد، وقيل: عامر بن سعد، قدم الشام مع عمر.(@)(@@) له عن: النبي - صلى الله عليه وسلم - أحاديث، وعن أبي بكر.(@)(@@) وعنه: أزهر الحرازى، وثابت بن ثوبان، وعبد الله بن بسر PageV10P371(@)(@@) الحبراني، وسالم بن أبي الجعد، وأبو البختري الطائي، وجماعة.(@)(@@) قال أبو داود: له صحبة.(@)(@@)(@@)(@@) $ 8378 - [د]: أبو كبشة (1) السدوسي البضري.(@)(@@) عن: أبي موسى الأشعري.(@)(@@) وعنه: عاصم الأحول.(@)(@@)(@@)(@@) $ 8379 - [خ د ت س]: أبو كبشة (2) السلولي الشامي.(@)(@@) عن: أبي الدرداء، وثوبان، وعبد الله بن عمرو، وسهل بن(@)(@@) الحنظلية.(@)(@@) وعنه: أبو سلام ممطور، وربيعة بن يزيد، وحسان بن عطية،(@)(@@) ويونس بن سيف.(@)(@@) وثقه أحمد العجلي وغيره، قال البخاري وأبو حاتم: لم يسم.(@)(@@) وقال عبد الغني في الأوهام التي أخذها على الحاكم قال: وقال أبو كبشة(@)(@@) السلولي اسمه البراء بن قيس فوهم؛ لأن أبا كبشة السلولي شامي،(@)(@@) والبراء ابن قيس سكوني كوفي يكنى أبا كيسة مثلها في الخط إلا أنه بالياء(@)(@@) باثنين من تحتها وسين مهملة. وأما ابن ماكولا (3) فقال: أبو كبشة بباء(@)(@@) وشين معجمة، ومن قال غيره فقد صحفه، هو البراء بن قيس السكوني(@)(@@) سمع سعدا وحذيفة، وعنه: إياد بن لقيط.(@)(@@)(@@)(@@) $ 8380 - [عخ د ت س]: أبو كثير (4) الزبيدي الكوفي، زهير بن PageV10P372(@)(@@) [الأقمر] (1) وقيل: عبد الله، وقيل: جمهان، وقيل: إنهما اثنان.(@)(@@) عن: علي، وولده الحسن، وعبد الله بن عمرو، وغيرهم.(@)(@@) وعنه: عبد الله بن الحارث الزبيدي المؤدب، وعمرو بن مرة.(@)(@@) وثقه النسائي وغيره.(@)(@@)(@@)(@@) $ 8381 - [بخ م 4]: أبو كثير (2) السحيمي الغبري اليمامي الضرير،(@)(@@) يزيد بن عبد الرحمن بن أذينة، وقيل: غفيلة بدل أذينة.(@)(@@) عن: أبي هريرة، وأبيه.(@)(@@) وعنه: ابنه زفر، ويحيى بن أبي كثير، وعقبة بن التوءم،(@)(@@) والأوزاعي، وعكرمة بن عمار، وأيوب بن عتبة، وجماعة.(@)(@@) وثقه أبو حاتم وأبو داود.(@)(@@)(@@)(@@) $ 8382 - [س]: أبو كثير (3) مولى آل جحش الأسدي،(@)(@@) يقال: له صحبة.(@)(@@) عن: مولاه محمد بن عبد الله بن جحش، وسعد بن أبي وقاص.(@)(@@) وعنه: صفوان بن سليم، والعلاء بن عبد 
ms2265	 الرحمن، ومحمد بن(@)(@@) عمرو بن علقمة، وغيرهم.(@)(@@)(@@)(@@) $$$ [م د ت س]: أبو كثير (4) الجلاح.(@)(@)PageV10P373(@)(@)(@@)(@@)(@@) $ 8383 - [د ت]: أبو كثير (1).(@)(@@) عن: مولاته أم سلمة.(@)(@@) وعنه: بنته حفصة، وعبد الرحمن المسعودي.(@)(@@)(@@)(@@) $$$ [خ ت س]: أبو كدينة (2) يحيى بن المهلب.(@)(@@)(@@)(@@) $ 8384 - [ق]: أبو كرب (الأزدي) (3).(@)(@@) عن: نافع.(@)(@@) وعنه: حماد بن عبد الرحمن [الكلبي] (4).(@)(@@) قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $$$ [ع]: أبو كريب (5) محمد بن العلاء الهمداني.(@)(@@)(@@)(@@) $$$ [خ 4]: أبو كريمة (6) المقدام بن معدي كرب.(@)(@@)(@@)(@@) $$$ [د]: أبو كعب (6) البلقاوي أيوب بن موسى.(@)(@@)(@@)(@@) $$$ [ت]: أبو كعب (7) صاحب الحرير عبد ربه بن عبيد.(@)(@@)(@@)(@@) $$$ [كن]: أبو كلثم (8) سلامة بن بشر.(@)(@)PageV10P374(@)(@)(@@)(@@)(@@) $ 8385 - [بخ د]: أبو كنانة (1) القرشي.(@)(@@) عن: أبي موسى الأشعري.(@)(@@) وعنه: زياد بن مخراق، وأبو إياس، وزياد بن أبي زياد.(@)(@@)(@@)(@@) $ 8386 - [ق]: أبو الكنود (2) الأزدي الكوفي (عبد الله بن عامر، وقيل:(@)(@@) [عبد] (3) الله بن عمران، وقيل: عبد الله بن عويمر، وقيل: عمرو بن(@)(@@) حبشي، وقيل: ) (4) عبد الله بن سعد.(@)(@@) عن: علي، وابن مسعود، وخباب.(@)(@@) وعنه: إسماعيل بن أبي خالد، وأبو إسحاق، وأبو سعد قارئ(@)(@@) الأزد.(@)(@@) ذكره ابن حبان في الثقات.(@)(@)PageV10P375(@)(@)(@@)(@@)(@@) || حرف اللام(@)(@@)(@@)(@@) $ 8387 - [خ م د ق]: أبو لبابة (1) بن عبد المنذر الأنصاري المدني بشير،(@)(@@) وقيل: رفاعة، بدري جليل.(@)(@@) يقال: رده رسول الله -صلى الله عليه وسلم- حين خرج إلى بدر من الروحاء،(@)(@@) واستعمله على المدينة، وضرب له بسهمه وأجره، فكان له كمن(@)(@@) شهدها، وهو أحد النقباء ليلة العقبة، مات في خلافة علي، وقيل:(@)(@@) بعد الخمسين.(@)(@@) روى عنه: ابناه: السائب وعبد الرحمن، وابن عمر، وعبد الله(@)(@@) ابن كعب بن مالك، وسلمان الأغر، وسالم بن عبد الله، ونافع مولى(@)(@@) ابن عمر، وعبيد الله بن أبي يزيد، وغيرهم.(@)(@@)(@@)(@@) $$$ [ق]: أبو لبابة (2) القرشي عثمان بن فائد.(@)(@@)(@@)(@@) $$$ [ت س]: أبو لبابة (2) الوراق مروان.(@)(@@) عن: عائشة.(@)(@@)(@@)(@@) $$$ [د ت ق]: أبو لبيد (2) الجهضمي لمازة بن زبار.(@)(@@)(@@)(@@) $ 8388 - [خ م د س ق]: أبو ليلى (3) الأنصاري بن عبد الله بن عبد(@)(@@) الرحمن بن سهل المدني.(@)(@@) عن: سهل بن أبي [حثمة] (4) وغيره حديث "القسامة" (5).(@)(@)PageV10P376(@)(@)(@@) وعنه: مالك وحده.(@)(@@) وقيل: عن 
ms2266	 مالك عن أبي ليلى عبد الله بن سهل. وكذا سماه ابن(@)(@@) سعد، وروى ابن إسحاق عن عبد الله بن سهل بن عبد الرحمن عن(@)(@@) عائشة وجابر.(@)(@@)(@@)(@@) $ 8389 - [د ت سي ق]: أبو ليلى (1) الأنصاري له صحبة ورواية، اسمه(@)(@@) بلال- وقيل: داود بن بلال بن بليل بن أحيحة بن الجلاح.(@)(@@) وقيل: أوس بن خولى.(@)(@@) وعنه: ابنه عبد الرحمن بن أبي ليلى، وأرسل عنه عدي بن ثابت.(@)(@@) شهد أحدا، وله دار بالكوفة، وكان يلقب بالأيسر، وشهد هو(@)(@@) وابنه مع علي مشاهده، يقال: قتل بصفين.(@)(@@)(@@)(@@) $ 8390 - [بخ د ق]: أبو ليلى (2) الكندي مولاهم الكوفي سلمة بن(@)(@@) معاوية، ويقال: معاوية بن سلمة، وقيل: المعلى.(@)(@@) عن: عثمان، وسلمان، وخباب، وأم سلمة، وسويد بن غفلة.(@)(@@) وعنه: عثمان بن أبي زرعة، وأبو إسحاق السبيعي، وأبو جعفر(@)(@@) الفراء، وعبد الملك بن أبي سليمان.(@)(@@) وثقه ابن معين فيما رواه عنه أحمد بن أبي مريم، وضعفه فيما رواه(@)(@@) ابن أبي شيبة عنه.(@)(@@)(@@)(@@) $ 8391 - [ق]: أبو ليلى (3)، يقال: خراساني.(@)(@)PageV10P377(@)(@)(@@) عن: أبي عكاشة الهمداني.(@)(@@) وعنه: وكيع.(@)(@@) يقال: هو عبد الله بن ميسرة [الحارثي] (1).(@)(@)PageV10P378(@)(@)(@@)(@@)(@@) || حرف الميم(@)(@@)(@@)(@@) $ 8392 - [د ت ق]: أبو ماجدة (1) ويقال: أبو ماجد، الحنفي العجلي(@)(@@) الكوفي.(@)(@@) عن: ابن مسعود.(@)(@@) وعنه: أيوب، ويحيى بن عبد الله الجابر.(@)(@@) قال أبو حاتم: اسمه عائذ بن نضلة. قال ابن عيينة: قلت ليحيى(@)(@@) الجابر: من أبو ماجد؟ قال: طير طار علينا فحدثنا، وهو منكر(@)(@@) الحديث. وقال الدارقطني: مجهول متروك.(@)(@@)(@@)(@@) $ 8393 - [د]: أبو ماجدة (2) السهمي.(@)(@@) عن: عمر سمع النبي -صلى الله عليه وسلم- يقول: "وهبت لخالتي غلاما، وقلت(@)(@@) لها: لا تسلميه حجاما ولا صائغا ولا قصابا" (3).(@)(@@) وعنه: العلاء بن عبد الرحمن، وغيره.(@)(@@) وروى ابن إسحاق عن العلاء بن عبد الرحمن.(@)(@@)(@@)(@@) $$$ [د]: أبو مالك (4) أو مالك بن ثعلبة كما تقدم.(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو مالك (4) الأشجعي سعد بن طارق.(@)(@@)(@@)(@@) $ 8394 - [م د س ق]: أبو مالك (5) الأشعري رضي الله عنه له أحاديث، PageV10P379(@)(@@) قيل: الحارث بن الحارث، وقيل: عبيد، وقيل: عمرو، وقيل: كعب بن(@)(@@) عاصم، وقيل غير ذلك.(@)(@@) روى عنه: جابر بن 
ms2267	 عبد الله، وعبد الرحمن بن غنم، وعبد الله(@)(@@) ابن معانق، وشهر بن حوشب، وشريح بن عبيد، وأبو سلام الأسود(@)(@@) وجماعة، وبعض هؤلاء روايتهم عنه مرسلة.(@)(@@) فإن ابن سعد وغيره ذكروا موته في خلافة عمر، وقال شهر بن(@)(@@) حوشب عن عبد الرحمن بن غنم قال: طعن معاذ بن جبل وأبو عبيدة(@)(@@) وأبو مالك الأشعري وشرحبيل بن حسنة في يوم واحد.(@)(@@)(@@)(@@) $$$ [د س]: أبو مالك (1) الجنبي عمرو بن هاشم.(@)(@@)(@@)(@@) $$$ [د ت س]: أبو مالك (2) الغفاري غزوان.(@)(@@)(@@)(@@) $ 8395 - [ق]: أبو مالك (3) النخعي الواسطي عبد الملك بن حسين،(@)(@@) وقيل: عبادة بن حسين، ويعرف بابن در.(@)(@@) عن: سلمة بن كهيل، وعاصم بن كليب، والأسود(@)(@@) ابن قيس، ومنصور، وأبي إسحاق، وعلي بن الأقمر، وطائفة.(@)(@@) وعنه: ابن المبارك، ومروان بن معاوية، ويزيد بن هارون، وأبو(@)(@@) أسامة، وبكر بن بكار، وعلي بن الجعد، وآخرون.(@)(@@) ضعفوه، وقال البخاري: ليس بالقوي عندهم. وقال النسائي: لا(@)(@@) يكتب حديثه.(@)(@@)(@@)(@@) $$$ [س]: أبو مالك (4).(@)(@)PageV10P380(@)(@)(@@) عن: عبد الله بن بريدة، وعمرو بن شعيب.(@)(@@) وعنه: سعيد بن أبي عروبة، ويحيي القطان.(@)(@@) هو عبيد الله بن الأخنس(@)(@@)(@@)(@@) $ 8396 - [ت ق]: أبو المبارك (1).(@)(@@) عن: صهيب مرسلا، وعن أبي سعيد، وعطاء بن أبي رباح.(@)(@@) وعنه: أبو فروة الرهاوي.(@)(@@) وقال الترمذي: مجهول. وذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [ع]: أبو المتوكل (2) الناجي علي بن داود، وقيل: ابن دؤاد.(@)(@@)(@@)(@@) $$$ [د ق]: أبو المثنى (2) الأملوكي ضمضم.(@)(@@)(@@)(@@) $ 8397 - [ت كن]: أبو المثنى (3) الجهني المدني.(@)(@@) عن: سعد، وأبي سعيد الخدري.(@)(@@) وعنه: أيوب بن حبيب، ومحمد بن يحيى الأسلمي.(@)(@@) وثقه ابن معين.(@)(@@)(@@)(@@) $ 8398 - [ت ق]: أبو المثنى (4) الخزاعي الكعبي المدني اسمه سليمان بن(@)(@@) يزيد بن قنقذ.(@)(@@) عن: سالم بن عبد الله، وسعيد المقبري، ويحيى بن سعيد،(@)(@@) وهشام بن عروة، وجماعة.(@)(@@) وعنه: يحيي بن أيوب المصري مع تقدمه، وابن أبي فديك، وابن PageV10P381(@)(@@) وهب، وعبد الله بن نافع الصائغ، ويحيى بن حسان، وجماعة.(@)(@@) قال أبو حاتم: ليس بقوي، منكر الحديث. وذكره ابن حبان في(@)(@@) الثقات، وحسن الترمذي حديثه في "الأضحية" (1).(@)(@@)(@@)(@@) $$$ [د ت س]: أبو المثنى (1) المؤذن مسلم بن 
ms2268	 المثنى، ويقال: مهران.(@)(@@)(@@)(@@) $$$ [خ د ت ق]: أبو المجاهد (3) الطائي سعد.(@)(@@)(@@)(@@) $$$ [ع]: أبو مجلز (3) لاحق بن حميد.(@)(@@)(@@)(@@) $$$ [ق]: أبو مجيبة (3) الباهلي، وقيل: مجيبة، مر.(@)(@@)(@@)(@@) $ 8399 - [بخ م 4]: أبو محذورة (4) القرشي الجمحي المكي المؤذن -(@)(@@) رضي الله عنه- أوس، وقيل: سمرة، وقيل: سلمة، وقيل: سلمان،(@)(@@) واسم أبيه: معير، وقيل: عمير، وقيل: في نسبه خلف، لكنه من ولد سعد(@)(@@) ابن جمح باتفاق. له أحاديث.(@)(@@) وعنه: ابنه عبد الملك، وحفيده عبد العزيز بن عبد الملك، وزوجته(@)(@@) أم عبد الملك، والأسود بن يزيد، والسائب المكي، وعبد الله بن(@)(@@) محيريز، وابن أبي مليكة، وغيرهم.(@)(@@) قال الزبير بن بكار: كان أحسن الناس أذانا وأنداهم صوتا. قال(@)(@@) له عمر -رضي الله عنه- وسمعه يؤذن: كدت أن تنشق مريطاؤك (5).(@)(@@) وأنشدني عمي مصعب لبعضهم:(@)(@@) أما ورب الكعبة المستورة ... وما تلا محمد من سورة(@)(@@) والنغمات من أبي محذورة ... لأفعلن فعلة مذكورة PageV10P382(@)(@@) حماد بن سلمة، عن علي بن زيد، عن أوس بن(@)(@@) خالد قال "كنت إذا قدمت على أبي محذورة سألني عن رجل، وإذا(@)(@@) قدمت علي الرجل سألني عن أبي محذورة، فألت أبا محذورة فقال:(@)(@@) كنت أنا وأبو هريرة وفلان في بيت فقال رسول الله -صلى الله عليه وسلم-: آخركم موتا في(@)(@@) النار، فمات أبو هريرة، ثم مات أبو محذورة أوس بن معير، ثم مات(@)(@@) الرجل".(@)(@@) قال أبو حذيفة النهدي: حدثنا أيوب بن ثابت، عن صفية بنت(@)(@@) تجراة "أن أبا محذورة كانت له قصة في مقدم رأسه إذا قعد أرسلها فتبلغ(@)(@@) إلى الأرض فقالوا له: ألا تحلقها. فقال: إن رسول الله -صلى الله عليه وسلم- مسح عليها(@)(@@) بيده فلم أكن لأحلقها حتي أموت. فلم يحلقها حتى مات".(@)(@@) وقال الزبير بن بكار: اسم أبي محذورة أوس بن معير بن لوذان بن(@)(@@) سعد بن جمح. ولوذان وربيعة وعريج إخوة، من قال غير ذا فقد(@)(@@) أخطأ. قال: وأخوه أنيس بن معير قتل كافرا. وأمهما من خزاعة، وقد(@)(@@) انقرض عقبهما، وورث الأذان بمكة إخوتهم من بني سلامان بن ربيعة بن(@)(@@) جمح.(@)(@@) قال محمد بن جرير الطبري: توفي أبو محذورة 
ms2269	 بمكة سنة تسع(@)(@@) وخمسين، وقيل: سنة تسع وسبعين(@)(@@)(@@)(@@) $ 8400 - [د]: أبو محمد (1) بن عمرو بن حريث العذري، وقيل: أبو(@)(@@) عمرو بن محمد بن حريث.(@)(@@) عن: جده.(@)(@@) وعنه: إسماعيل بن أمية.(@)(@@) ذكره ابن حبان في الثقات.(@)(@)PageV10P383(@)(@)(@@)(@@)(@@) $ 8401 - [د س ق]: أبو محمد (1) الأنصاري المذكور في حديث عبادة(@)(@@) ابن الصامت في الوتر، قيل: اسمه مسعود، وقيل: قيس، نزل دمشق،(@)(@@) ويقال: إنه شهد بدرا ومات بالمغرب.(@)(@@)(@@)(@@) $ 8402 - [خت بخ]: أبو محمد (2) الحضرمي غلام أبي أيوب، يقال هو(@)(@@) أفلح.(@)(@@) عن: أبي أيوب.(@)(@@) وعنه: أبو الورد ثمامة.(@)(@@)(@@)(@@) $$$ أبو محمد (3) الزبيدي: عمر بن حريش في ترجمة أبي سفيان.(@)(@@)(@@)(@@) $ 8403 - [ت ق]: أبو محمد (4) مولى عمر، وقيل: محمد بن أبي محمد.(@)(@@) عن: أبي عبيدة بن عبد الله بن مسعود.(@)(@@) وعنه: العوام بن حوشب.(@)(@@)(@@)(@@) $$$ [ع]: أبو محمد (5) مولى أيي قتادة نافع بن عباس.(@)(@@)(@@)(@@) $ 8404 - [عس]: أبو محمد (6) الهذلي.(@)(@@) عن: علي "أمرت أن أسوي القبور".(@)(@@) وعنه: الحكم بن عتيبة.(@)(@@) ومنهم من قال فيه: أبو المورع.(@)(@@)(@@)(@@) $$$ [م ت س ق]: أبو المحياة (7) التيمي يحيى بن يعلى.(@)(@)PageV10P384(@)(@)(@@)(@@)(@@) $$$ [ت]: أبو المخارق (1).(@)(@@) عن: ابن عمر.(@)(@@) وعنه: الفضل بن يزيد الثمالي حديث "إن الكافر ليجر لسانه" (2)(@)(@@) والصواب: أبو عجلان.(@)(@@)(@@)(@@) $ 8405 - [د]: أبو المختار (3) الأسدي الكوفي سفيان، وقيل: عبد الله(@)(@@) عن: [ابن] (4) أبي أوفى.(@)(@@) وعنه: شعبة، وقيس بن الربيع.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $ 8406 - [عس ت]: أبو المختار (5) الطائي كوفي، يقال: سعد.(@)(@@) عن: القاضي شريح، وسعيد بن جبير، وغيرهما.(@)(@@) وعنه: حمزة الزيات، وشريك.(@)(@@) قال ابن المديني وغيره: لا يعرف.(@)(@@)(@@)(@@) $$$ أبو مخلد (6) عن ابن عباس غلط، إنما هو [أبو] (7) مجلز.(@)(@@)(@@)(@@) $ 8407 - [ت ق]: أبو مدلة (8) المدني مولى عائشة.(@)(@)PageV10P385(@)(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: سعد أبو مجاهد الطائي.(@)(@@) في الثقات لابن حبان.(@)(@@)(@@)(@@) $ 8408 - [خ م س ق]: أبو مراوخ (1) الغفاري، ويقال: الليثي المدني،(@)(@@) يقال: سعد.(@)(@@) عن: أبي ذر، وحمزة بن عمرو الأسلمي.(@)(@@) وعنه: عروة، وسليمان بن يسار، وزيد بن أسلم، وغيرهم.(@)(@@) وثقة العجلي وغيره، وقيل: ولد في حياة النبي -صلى الله عليه وسلم-.(@)(@@)(@@)(@@) $ 8409 - [قد]: أبو مراوخ 
ms2270	 (2).(@)(@@) عن: سلمان.(@)(@@) وعنه: قتادة.(@)(@@) أظنه غير الأول.(@)(@@)(@@)(@@) $$$ [م د ت س]: أبو مرثد (2) الغنوي كناز بن الحصين.(@)(@@)(@@)(@@) $$$ [د]: أبو مرحب (2)، أو مرحب، أو ابن أبي مرحب.(@)(@@)(@@)(@@) $$$ [د ت سي ق]: أبو مرحوم (4) مصري عبد الرحيم بن ميمون.(@)(@@)(@@)(@@) $ 8410 - [د ق]: أبو مرزوق (5) التجيبي، ثم القتيري، مولاهم المصري(@)(@@) حبيب بن الشهيد، وقيل: ربيعة بن سليم، وكأنهما اثنان.(@)(@)PageV10P386(@)(@)(@@) عن: حنش الصنعاني وغيره، أرسل عن فضالة بن عبيد، له وفادة(@)(@@) على عمر بن عبد العزيز.(@)(@@) وعنه: جعفر بن ربيعة، ويزيد بن أبي حبيب، وسالم بن غيلان،(@)(@@) وغيرهم.(@)(@@) وثقة أحمد العجلي وغيره. قال أحمد بن يحيى بن وزير: توفي(@)(@@) سنة تسع ومائة، وكان فقهيا، وكان ينزل أطرابلس المغرب، وكان في(@)(@@) المغرب له ذكر في الفقه، كان بمنزلة يزيد بن أبي حبيب بمصر.(@)(@@)(@@)(@@) $ 8411 - [د ق]: أبو مرزوق (1).(@)(@@) عن: أبي غالب. عن أبي أمامة.(@)(@@) وعنه: مسعر، وأبو العدبس.(@)(@@)(@@)(@@) $ 8412 - [س]: أبو مرة الطائفي (2).(@)(@@) روى عنه: مكحول.(@)(@@)(@@)(@@) $$$ [ع]: أبو مرة (2) مولى عقيل بن أبي طالب يزيد.(@)(@@)(@@)(@@) $$$ أبو مروان (2) بن حمويه.(@)(@@) غلط إنما هو مرار بن حمويه.(@)(@@)(@@)(@@) $ 8413 - [س]: أبو مروان (3) الأسلمي، والد عطاء، مختلف في صحبته(@)(@@) واسمه، فقيل سعد، وقيل مغيث، وقيل عبد الرحمن بن مصعب.(@)(@@) عن: علي، وأبي ذر، وكعب، وعبد الرحمن بن مغيث،(@)(@@) وجماعة.(@)(@)PageV10P387(@)(@)(@@) وعنه: ابنه، وعبد الرحمن بن مهران.(@)(@@) وثقه العجلي وقال: مدني تابعي.(@)(@@)(@@)(@@) $$$ [ق]: أبو مروان (1) العثماني محمد بن عثمان.(@)(@@)(@@)(@@) $ 8414 - [د ت]: أبو مريم (2) الأزدي له صحبة وحديث.(@)(@@) وعنه: القاسم بن مخيمرة، وابن عمه أبو الشماخ بن عمر، وأبو(@)(@@) المعطل مولى بني كلاب.(@)(@@)(@@)(@@) $$$ أبو مريم (3) عبد الله بن زياد الأسدي.(@)(@@)(@@)(@@) $ 8415 - [بخ د ت]: أبو مريم (4) الأنصاري، ويقال: الحضرمي،(@)(@@) صاحب القناديل، خادم مسجد دمشق، ويقال: خادم مسجد حمص.(@)(@@) قيل: ولاؤه لأبي هريرة، وقيل: هما اثنان، وقيل اسمه عبد الرحمن بن(@)(@@) ماعز.(@)(@@) أدرك عليا، وروى عن: أبي هريرة، وجابر.(@)(@@) وعنه: يحيى بن أبي عمرو السيباني، وحريز بن عثمان، ومعاوية(@)(@@) ابن صالح، وفرج بن فضالة، وآخرون.(@)(@@) قال أحمد بن حنبل: رأيت أهل حمص 
ms2271	 يحسنون الثناء عليه. وقال(@)(@@) العجلي: ثقة.(@)(@@)(@@)(@@) $ 8416 - [ى د ص]: أبو مريم (5) الثقفي المدائني، ويقال: الحنفي(@)(@@) الكوفي، ويقال إنهما اثنان.(@)(@)PageV10P388(@)(@)(@@) عن: علي، وعمار، وأبي الدرداء، وغيرهم.(@)(@@) وعنه: عبد الملك ويعلى ابنا حكيم المدائني.(@)(@@) قال أبو حاتم: اسمه قيس. وقال النسائي: ثقة.(@)(@@) وقال ابن المديني: أبو مريم الحنفي اسمه إياس بن ضبيح. وقال أبو(@)(@@) أحمد الحاكم: هو أول من قضى بالبصرة استعمله عليها أبو موسي(@)(@@) الأشعري. روي عن: عمر، وعثمان. روى عنه: ابنه عبد الله وابن(@)(@@) سيرين.(@)(@@) قال ابن ماكولا (1): أبو مريم الحنفي إياس بن ضبيح ولي القضاء(@)(@@) لعمر. وقال أيضا: أبو مريم اسمه عبد الله بن سنان الكوفي. عن:(@)(@@) علي، وابن مسعود، وضرار بن الأزور. وعنه: أخوه حصين،(@)(@@) والأعمش، وشمر بن عطية.(@)(@@)(@@)(@@) $ 8417 - أبو مريم (2) الرقي.(@)(@@) عن: عائشة.(@)(@@) وعنه: خصيف.(@)(@@) وروى أبو فروة [الجزري] (3) عن أبي مريم، عن أبي خلاد. وعند(@)(@@) ابن ماجه: أبو فروة عن أبي خلاد، بإسقاط أبي مريم.(@)(@@)(@@)(@@) $$$ [س]: أبو مريم (4) السلولي مالك بن ربيعة صحابي.(@)(@@)(@@)(@@) $$$ [ت]: أبو مزاحم (5) السمر قندي سباع بن النضر.(@)(@)PageV10P389(@)(@)(@@)(@@)(@@) $ 8418 - [ت]: أبو مزاحم (1).(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: يحيى بن أبي كثير حديث "من صلى على جنازة فله(@)(@@) قيراط" (2).(@)(@@)(@@)(@@) $ 8419 - [بخ]: أبو مزرد (3) عبد الرحمن بن يسار أخو سعيد.(@)(@@) عن: أبي هريرة.(@)(@@) وعنه: ابنه معاوية.(@)(@@)(@@)(@@) $$$ [خ ص]: أبو المساور (4) البصري الفضل بن مساور.(@)(@@)(@@)(@@) $$$ [ع]: أبو مسعود (5) الأنصاري عقبة بن عمرو.(@)(@@)(@@)(@@) $ 8420 - [د]: أبو مسعود (5) الأنصاري الزرقي.(@)(@@) عن: علي.(@)(@@) وعنه: نافع بن جبير بن مطعم.(@)(@@)(@@)(@@) $$$ [ق]: أبو مسعود (5) الجرار عبد الأعلي بن أبي المساور.(@)(@@)(@@)(@@) $$$ [ع]: أبو مسعود (6) الجريري سعيد بن إياس.(@)(@@)(@@)(@@) $$$ [د]: أبو مسعود (7) الرازي أحمد بن الفرات.(@)(@@)(@@)(@@) $$$ [س]: أبو مسكين (7) حر بن مسكين.(@)(@)PageV10P390(@)(@)(@@)(@@)(@@) $$$ [بخ م 4]: أبو مسلم اسمه (1) الأغر.(@)(@@) عن: أبي هريرة(@)(@@)(@@)(@@) $ 8421 - [د سي]: أبو مسلم (2) البجلي.(@)(@@) عن: زيد بن أرقم، وابن عمر.(@)(@@) وعنه: داود الطفاوي القسام.(@)(@@) وثقه ابن حبان.(@)(@@)(@@)(@@) $ 8422 - [ت س]: أبو مسلم (2) الجذمي.(@)(@@) عن: أبي ذر، والجارود العبدي.(@)(@@) وعنه: أبو العالية، ومطرف، ويزيد بن عبد الله بن الشخير، وقتادة 
ms2272	(@)(@@) وغيرهم(@)(@@)(@@)(@@) $$$ [خت]: أبو مسلم (3) قائد الأعمش عبيد الله بن سعيد.(@)(@@)(@@)(@@) $ 8423 - [م 4]: أبو مسلم (4) الخولاني اليماني الزاهد سيد التابعين(@)(@@) بالشام عبد الله بن ثوب، ويقال: ابن ثواب، ويقال: ابن أثوب، ويقال:(@)(@@) ابن عوف، ويقال: ابن مشكم، ويقال: اسمه يعقوب بن عوف.(@)(@@) كان يسكن بداريا (5)، وقد هاجر إلي النبي -صلى الله عليه وسلم- فمات(@)(@@) النبي -صلى الله عليه وسلم- وأبو مسلم في الطريق فلقي أبا بكر.(@)(@@) روى عن: عمر، ومعاذ، وأبي ذر، وأبي عبيدة، وعوف بن(@)(@@) مالك، وأبي مسلم الجليلي معلم كعب الأحبار، وغيرهم.(@)(@)PageV10P391(@)(@)(@@) وعنه: أبو إدريس الخولاني، وأبو العالية الرياحي، [وجبير] (1) بن(@)(@@) نفير، و [عبد الله بن] (2) عروة بن الزبير، وأبو قلابة، ومكحول،(@)(@@) وعطاء بن أبي رباح، وعمير بن هانئ، ويونس بن ميسرة، وآخرون.(@)(@@) وثقه ابن معين وغيره، وله في الكتب حديثان أحدهما في م (3) عن(@)(@@) عوف الأشجعي.(@)(@@) قلت (4): روى غير واحد عن عبد الوهاب بن نجدة، ثنا إسماعيل(@)(@@) ابن عياش، ثنا شرحبيل بن مسلم "أن الأسود بن قيس بن ذي الخمار(@)(@@) تنبأ باليمن فبعث إلى أبي مسلم الخولاني فأتاه فقال: اشهد أني رسول(@)(@@) الله. قال: ما أسمع. قال: اشهد أن محمدا رسول الله. قال:(@)(@@) نعم. قال: فأمر بنار عظيمة وألقى فيها أبا مسلم فلم تضره، فقيل(@)(@@) للأسود: إن لم تنف هذا عنك أفسد عليك من اتبعك. فأمره بالرحيل،(@)(@@) فقدم المدينة وقد قبض النبي -صلى الله عليه وسلم- واستخلف أبو بكر، فأناخ راحلته ودخل(@)(@@) المسجد يصلي، فبصر به عمر فقام إليه فقال: ممن الرجل؟ قال: من(@)(@@) اليمن. قال: ما فعل الذي حرقه الكذاب بالنار؟ قال: ذاك عبد الله(@)(@@) ابن ثوب. قال: فنشدتك بالله أنت هو؟ قال: اللهم نعم. فاعتنقه(@)(@@) عمر وبكى، ثم ذهب به حتى أجلسه فيما بينه وبين [أبي] (5) بكر(@)(@@) فقال: الحمد لله الذي لم يمتني حتى أراني في أمة محمد -صلى الله عليه وسلم- من صنع به(@)(@@) كما صنع بإبراهيم الخليل -صلى الله عليه وسلم-".(@)(@)PageV10P392(@)(@)(@@) قال إسماعيل بن عياش: فأنا أدركت رجالا من الأمداد الذين يمدون(@)(@@) إلينا من أليمن من عنس وخولان 
ms2273	 فكان الخولانيون يقولون للعنسيين:(@)(@@) صاحبكم العنسي الكذاب الذي أحرق صاحبنا بالنار فلم تضره.(@)(@@) وعن مالك بن دينار: أن كعبا رأى أبا مسلم الخولاني فقال: هذا(@)(@@) حكيم هذه الأمة.(@)(@@) وقال معمر (1) عن الزهري قال: كنت عند الوليد فتناول عائشة،(@)(@@) فقلت: يا أمير المؤمنين، ألا أحدثك عن رجل من أهل الشام كان قد(@)(@@) أوتي حكمة؟ فقال: من هو؟ فقلت: أبو مسلم الخولاني سمع أهل(@)(@@) الشام ينالون من عائشة فقال: ألا أخبركم بمثلي ومثل أمكم كمثل عينين(@)(@@) في رأس تؤذيان صاحبهما لا يستطيع أن يعاقبهما إلا بالذي(@)(@@) هو خير لهما. قال فسكت. قال الزهري: حدثنيه أبو إدريس(@)(@@) الخولاني، عن أبي مسلم.(@)(@@) وقال عثمان بن أبي العاتكة: علق أبو مسلم سوطا [أو سوطين] (2)(@)(@@) في مسجده وكان يقول: أنا أولى بالسوط من البهائم، فإذا دخلته فتر(@)(@@) مشق ساقيه سوطا أو سوطين، وكان يقول: لو رأيت الجنة عيانا والنار(@)(@@) عيانا ما كان عندي مستزاد (3). وقال إسماعيل بن عياش (4)، عن(@)(@@) شرحبيل: أن رجلين أتيا أبا مسلم الخولاني في منزله فلم يجداه، فأتيا(@)(@@) المسجد فوجداه يركع فانتظرا انصرافه فأحصيا ركوعه فأحصى أحدهما أنه(@)(@@) ركع ثلاثمائة ركعة، وقال الآخر: أربعمائة ركعة قبل أن ينصرف.(@)(@@) وروى أبو بكر (4) بن أبي مريم، عن عطية بن قيس: أن أبا مسلم PageV10P393(@)(@@) غزا أرض الروم فكان يصوم وقال: لو حضر قتال لأفطرت. وقال أبو(@)(@@) المليح الرقي، عن يزيد بن يزيد بن جابر: كان (1) أبو مسلم الخولاني(@)(@@) يكثر أن يرفع صوته بالتكبير حتى مع الصبيان، وكان يقول: اذكر الله(@)(@@) حتى يرى الجاهل أنك مجنون.(@)(@@) وقال إسماعيل بن عياش، عن عقيل بن مدرك، عن لقمان بن(@)(@@) عامر قال: كان أبو مسلم يذكر الله، فقال رجل: أمجنون هذا؟ !(@)(@@) فقال أبو مسلم: ليس هذا مجنون، ولكن هذا دواء الجنون.(@)(@@) وقال بقية، عن محمد بن زياد، عن أبي مسلم الخولاني: أنه كان(@)(@@) إذا غزا أرض الروم فمروا بنهر، قال: أجيزوا بسم الله. ويمر بين(@)(@@) أيديهم فيمرون بالنهر الغمر فربما لم يبلغ من الدواب إلا في الركب أو(@)(@@) بعض ذلك، 
ms2274	 فإذا جازوا قال للناس: هل ذهب لكم من شيء، فمن(@)(@@) ذهب له شيء فأنا ضامن له فألقى بعضهم مخلاته عمدا فلما جازوا قال:(@)(@@) مخلاتي. فقال: اتبعني فاتبعه فإذا المخلاة قد تعلقت ببعض أعواد(@)(@@) النهر، قال: خذها.(@)(@@) وروى (2) عنبسة بن عبد الواحد، عن عبد الملك بن عمير قال: كان(@)(@@) أبو مسلم إذا استسقى سقي.(@)(@@) وقال الوليد بن مسلم عن [ابن] (3) أبي العاتكة: أن أبا مسلم(@)(@@) اشترى بغلة فقالت امرأته: أدع فيها بالبركة. فقال: اللهم بارك فيها(@)(@@) فأصبحت ميتة، ثم اشترى أخرى فكذلك، ثم اشترى ثالثة فقالت:(@)(@@) ادع فيها بالبركة. فقال: اسكتي يا حمقاء اللهم متعنا بها.(@)(@)PageV10P394(@)(@)(@@) بقية (1)، عن محمد بن زياد، عن أبي مسلم الخولاني: أن امرأة(@)(@@) خببت عليه [امرأته] (2) فدعا [عليها] (3) فذهب بصرها فأتته فقالت:(@)(@@) إني كنت فعلت وفعلت فلا أعود. فقال: اللهم إن كانت صادقة فاردد(@)(@@) عليها بصرها. فأبصرت.(@)(@@) وروى ضمرة، عن بلال بن كعب: أن الصبيان قالوا لأبي مسلم:(@)(@@) ادع الله تعالى أن يحبس [علينا] (4) هذا الظبي فنأخذه. فدعا الله(@)(@@) فحبسه عليهم حتى أخذوه. وروى عثمان بن عطاء الخراساني، عن أبيه(@)(@@) قالت امرأة لأبي مسلم: ليس لنا دقيق، وأعطته درهما باعت به غزلا،(@)(@@) فأخذ الجراب ودخل السوق [فأتاه سائل] (5) فأعطاه الدرهم، ثم ملأ(@)(@@) الجراب من نحاتة النجارة مع التراب، ثم أتى وقلبه مرعوب من المرأة،(@)(@@) فلما فتحت رمى الجراب وذهب، ففتحته فإذا به دقيق فعجنت وخبزت،(@)(@@) فلما ذهب من الليل الهوى جاء أبو مسلم فوضعت بين يديه أرغفة،(@)(@@) فقال: من أين هذا؟ قالت: من الدقيق الذي جئت به فجعل يأكل(@)(@@) ويبكي.(@)(@@) وقال سعيد بن عبد العزيز (6): إن أبا مسلم استبطأ خبر جيش الروم(@)(@@) فأتى طائر فوقع فقال: أنا رتبابيل مسلي الحزن من صدور المؤمنين فأخبره(@)(@@) خبر ذلك الجيش، فقال: ما جئت حتى استبطأتك.(@)(@@) وقال هشام بن الغاز: حدثني يونس بن الهرم: أن أبا مسلم PageV10P395(@)(@@) الخولاني قام إلى معاوية وهو على المنبر فقال: إنما أنت قتر يا معاوية لا(@)(@@) تحسب أن الخلافة جمع المال وتفرقته، إنما الخلافة القول بالحق، 
ms2275	 والعمل(@)(@@) بالمعدلة، ؤأخذ الناس في ذات الله، يا معاوية، إنا لا نبالي بكدر(@)(@@) الأنهار إذا صفا لنا رأس عيننا، يا معاوية إياك أن تميل على قبيلة من(@)(@@) العرب فيذهب حيفك بعدلك. فقال له معاوية: يرحمك الله يا أبا مسلم(@)(@@) رواها إسماعيل بن عياش عنه.(@)(@@) وقال أبو اليمان (1): ثنا أبو بكر بن أبي مريم، عن عطية بن قيس(@)(@@) قال: دخل أبو مسلم على معاوية فقام بين السماطين فقال: السلام(@)(@@) عليك أيها الأخير. فقيل له: مه. فقال [معاوية] (2): دعوه، وعليك(@)(@@) السلام يا أبا مسلم. فقال: اعلم أنه ليس من راع استرعي رعية إلا ورب(@)(@@) أجره يسأله عنها، فإن كان داوى مرضاها، وهنأ جرباها، وجبر(@)(@@) كسراها، ورد أولاها على أخراها، وفاه الله أجره، وإن كان لم يفعل(@)(@@) حرمه، فانظر يا معاوية أين أنت. فقال: يرحمك الله يا أبا مسلم،(@)(@@) الأمر على ذلك.(@)(@@) وقال أبو قلابة: قال أبو مسلم الخولاني: العلماء ثلاثة: رجل(@)(@@) عاش في علمه وعاش الناس فيه، ورجل عاش في علمه ولم يعش معه(@)(@@) أحد فيه، ورجل عاش الناس في علمه وكان علمه وبالا(@)(@@) عليه.(@)(@@) وقال إسماعيل بن عياش: ثنا شرحبيل، عن أبي مسلم الخولاني:(@)(@@) أنه كان إذا دخل أرض الروم لا يزال في المقدمة حتى يؤذن الناس، فإذا(@)(@@) أذن لهم كان في الساقة، وكانت الولاة يتيمنون به فيؤمرونه على المقدمات PageV10P396(@)(@@) قال سعيد بن عبد العزيز: توفي أبو مسلم بأرض الروم وكان شب(@)(@@) مع بشر بن أبي أرطاة، فأتاه بشر في مرضه فقال له أبو مسلم: اعقد لي(@)(@@) على من مات معك في هذه الغزاة، فإني أرجو أن آتي بهم يوم القيامة(@)(@@) لوائهم. وورد ما توهم وفاته بدمشق ولم يصح.(@)(@@) قال إسماعيل بن عياش: عن شرحبيل بن مسلم الخولاني، عن(@)(@@) سعيد ابن هانى قال معاوية: إنما الصيبة كل المصيبة بموت أبي مسلم(@)(@@) الخولاني وكريب بن سيف الأنصاري.(@)(@@) قلت: هذا يدل أنه مات في زمن معاوية.(@)(@@) وقال ابن سعد: توفي في زمن يزيد. وقال الفضل الغلابي: توفي(@)(@@) سنة اثنين وستين والله أعلم.(@)(@@)(@@)(@@) $ 8424 
ms2276	 - [ق]: أبو مسلم (1) العبدي.(@)(@@) عن: سلمان.(@)(@@) وعنه: أبو شريح.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [ع]: أبو مسلمة (2) الأزدي سعيد بن يزيد.(@)(@@)(@@)(@@) $$$ [ع]: أبو مسهر (3) الغساني عبد الأعلى بن مسهر.(@)(@@)(@@)(@@) $ 8425 - [ق]: أبو مشجعة (3) بن ربعي الجهني.(@)(@@) عن: عمر، وعثمان، وسلمان، وأبي الدرداء.(@)(@)PageV10P397(@)(@)(@@) وعنه: ابن أخيه مسلمة بن عبد الله(@)(@@)(@@)(@@) $ 8426 - [د]: أبو مصبح (1) المقرائي الردماني الأوزاعي الحمصي.(@)(@@) عن: ثوبان، وشداد بن أوس، وجابر، وكعب الأحبار، وواثلة،(@)(@@) وجماعة(@)(@@) وعنه: صبيح بن محرز، وحريز بن عثمان، والأوزاعي، وعبد(@)(@@) الرحمن بن يزيد بن جابر، وجماعة.(@)(@@) وثقة أبو زرعة وغيره.(@)(@@)(@@)(@@) $$$ [ع]: أبو مصعب (2) الزهري أحمد بن أبي بكر.(@)(@@)(@@)(@@) $$$ [د ت س]: أبو مصعب (3) المدني عبد السلام بن مصعب في زمن(@)(@@) مالك.(@)(@@)(@@)(@@) $ 8427 - [سي]: أبو المصفى (4).(@)(@@) عن: عبد الرحمن بن أبي ليلى.(@)(@@) وعنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) $ 8428 - [ل]: أبو مصلح (5) الخراساني نصر بن مشارس، ويقال: ابن(@)(@@) مشيرس.(@)(@@) عن: الضحاك.(@)(@@) وعنه: وكيع، والنضر بن شميل، وجماعة.(@)(@)PageV10P398(@)(@)(@@) ذكره ابن حبان في الثقات.(@)(@@) وقال أبو حاتم: شيخ.(@)(@@)(@@)(@@) $ 8429 - [بخ ت سى]: أبو مطر (1).(@)(@@) عن: سالم بن عبد الله.(@)(@@) وعنه: حجاج بن أرطاة، وغيره.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [د س]: أبو مطرف (2) بن أبي الوزير محمد بن عمر.(@)(@@)(@@)(@@) $$$ [د ق]: أبو مطرف (3) الخزاعي عبيد الله بن طلحة.(@)(@@)(@@)(@@) $ 8430 - 4: أبو المطوس (4) وقيل: ابن المطوس.(@)(@@) عن: أبيه عن أبي هريرة "من أفطر من غير عذر" (5).(@)(@@) وعنه: حبيب بن أبي ثابت، وقيل: حبيب عن عمارة بن عمير(@)(@@) عنه. وقيل غير ذلك.(@)(@@) قال ابن معين: أبو المطوس عبد الله بن المطوس ثقة. وقال(@)(@@) البخاري: اسمه يزيد بن المطوس. وقال أبو داود (6): لا يسم.(@)(@)PageV10P399(@)(@)(@@)(@@)(@@) $ 8431 - [س]: أبو مطيع (7) بن عوف الأنصاري.(@)(@@) عن: أبي سعيد الخدري في "العزل" (1).(@)(@@) وعنه: محمد بن عبد الرحمن بن ثوبان.(@)(@@)(@@)(@@) $$$ [بخ د ت ق]: أبو معاذ (2) فضيل بن ميسرة الأزدي واسمه أشهر.(@)(@@)(@@)(@@) $$$ [د ت س]: أبو معاذ (3) البصري سليمان بن أرقم.(@)(@@)(@@)(@@) $ 8432 - [ق]: أبو معاذ (4)، ويقال: أبو معان (ت) وهو الأصح بصري.(@)(@@) عن: أنس، وابن سيرين.(@)(@@) وعنه: عمار 
ms2277	 بن سيف الضبي.(@)(@@)(@@)(@@) $ 8433 - [عس]: أبو معاوبة (5) البجلي، يقال: هو عمار الدهني.(@)(@@) عن: سعيد بن جابر، وسعيد بن جبير، وأبي الصهباء.(@)(@@) وعنه: أبو صخر حميد. بن زياد، وأبو [مودود] (6) المدنيان،(@)(@@) وغيرهما.(@)(@@)(@@)(@@) $$$ [ع]: أبو معاوية (7) الضرير محمد بن خازم.(@)(@@)(@@)(@@) $$$ [ع]: أبو معاوية (8) شيبان بن عبد الرحمن النحوي.(@)(@@)(@@)(@@) $$$ [بخ س ق]: أبو معاوية (8) عمرو بن عبد الله النخعي.(@)(@)PageV10P400(@)(@)(@@)(@@)(@@) $$$ [ع]: أبو معبد (1) مولى ابن عباس نافذ.(@)(@@)(@@)(@@) $$$ [خ م]: أبو معبد (2) السلمي صحابي مجالد بن مسعود.(@)(@@)(@@)(@@) $ 8434 - [د ق]: أبو المعتمر (2) بن عمرو بن رافع المدني.(@)(@@) عن: [عمر] (3) بن خلدة وغيره.(@)(@@) وعنه: ابن أبي ذئب.(@)(@@) ذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) $$$ [د ق]: أبو المعتمر (2) يزيد بن طهمان بصري.(@)(@@)(@@)(@@) $$$ [د ت ص]: أبو المعتمر (4) الكوفي حنش بن المعتمر.(@)(@@)(@@)(@@) $ 8435 - [ت]: أبو معدان (5) المكي عبد الله بن معدان، ويقال عامر بن(@)(@@) مرة.(@)(@@) عن: جدته، وطاوس، وعاصم بن كليب، وغيرهم.(@)(@@) وعنه: [زين] (6) بن شعيب الإسكندراني، وسعيد بن سفيان(@)(@@) الجحدري، ووكيع، وأبو نعيم، وغيرهم.(@)(@@)(@@)(@@) $$$ [س]: أبو معدان (7)، وقيل: ابن معدان، وقيل: خالد بن معدان.(@)(@)PageV10P401(@)(@)(@@) عن: أبي الدرداء وثوبان "أن النبي -صلى الله عليه وسلم- قاء فأفطر" (1).(@)(@@) وعنه: يعيش بن الوليد.(@)(@@) والصواب: معدان (ت س) وهو ابن أبي طلحة.(@)(@@)(@@)(@@) $$$ [خ م]: أبو معشر (2) البراء يوسف بن يزيد.(@)(@@)(@@)(@@) $$$ [م د ت س]: أبو معشر (2) التميمي زياد بن كليب.(@)(@@)(@@)(@@) $$$ [ع]: أبو معشر (2) السندي نجيح بن عبد الرحمن.(@)(@@)(@@)(@@) $ 8436 - [س ق]: أبو معقل (3) الأنصاري حليف بني أسد صحابي،(@)(@@) قيل: اسمه الهيثم.(@)(@@) شهد أحدا ومات في حجة الوداع، وهو والد معقل بن أبي معقل،(@)(@@) وزوج أم معقل.(@)(@@) روى عنه: أبو بكر بن عبد الرحمن بن الحارث بن هشام وغيره.(@)(@@)(@@)(@@) $ 8437 - [د ق]: أبو معقل (4).(@)(@@) عن: أنس.(@)(@@) عنه: عبد العزيز بن مسلم الأنصاري لا القسملي.(@)(@@)(@@)(@@) $ 8438 - [ت]: أبو المعلى (3) بن لوذان الأنصاري صحابي.(@)(@@) له حديث "لو كنت متخذا خليلا ... " (6) قاله عبد الملك بن عمير، PageV10P402(@)(@@) عن ابن أبي المعلى، عن أبيه.(@)(@@)(@@)(@@) $$$ [خت س ق]: أبو العلى (1) العطار الضبي الكوفي.(@)(@@) عن: سعيد بن جبير.(@)(@@) يحيى بن ميمون. 
ms2278	(@)(@@)(@@)(@@) $$$ [ع]: أبو معمر (1) الأزدي عبد الله بن سخبرة.(@)(@@)(@@)(@@) $$$ [ع]: أبو معمر (2) المقعد عبد الله بن عمرو.(@)(@@)(@@)(@@) $$$ [خ م د س]: أبو معمر (3) الهذلي إسماعيل بن إبراهيم.(@)(@@)(@@)(@@) $$$ [م]: أبو معن (3) الرقاشي زيد بن يزيد.(@)(@@)(@@)(@@) $ 8439 - [س]: أبو معن (4) الإسكندراني عبد الواحد بن أبي موسى.(@)(@@) عن: أبي عقيل زهرة بن معبد، ويزيد بن أبي حبيب، وغيرهما.(@)(@@) وعنه: ضمام بن إسماعيل، وابن المبارك.(@)(@@) قال سعيد الآدم: كان أبو معن يتجر، وكان يقال إنه(@)(@@) مجاب الدعوة، وكان من المجتهدين رحمه الله.(@)(@@)(@@)(@@) $ 8440 - [ق]: أبو معن (5).(@)(@@) عن: أنس.(@)(@@) وعنه: مسور بن (6) الحسن، وعبد العزيز بن مسلم.(@)(@)PageV10P403(@)(@)(@@)(@@)(@@) $$$ [س ق]: أبو معبد (1) الرعيني حفص بن غيلان.(@)(@@)(@@)(@@) $$$ [مد]: أبو المغلس (1) ميمون المكي.(@)(@@)(@@)(@@) $$$ [ق]: أبو المغلس (1) النميري عبد ربه بن خالد.(@)(@@)(@@)(@@) $ 8441 - [س]: أبو مغيث (2) بن عمرو.(@)(@@) عن: النبي -صلى الله عليه وسلم- في "القول عند الانصراف من الصلاة" (3)، وقيل:(@)(@@) الرحمن بن مغيث عن كعب [عن] (4) صيب.(@)(@@) وعنه: أبو مروان.(@)(@@)(@@)(@@) $ 8442 - [سي ق]: أبو المغيرة (5) البجلي، ويقال: الخارفي: عبيد.(@)(@@) عن: حذيفة في "ذرب اللسان" (6). قاله أبو إسحاق واختلف عليه(@)(@@) فيه.(@)(@@)(@@)(@@) $$$ [ع]: أبو المغيرة (7) الخولاني عبد القدوس بن الحجاج.(@)(@)PageV10P404(@)(@)(@@)(@@)(@@) $ 8443 - [ق]: أبو المغيرة (1).(@)(@@) عن: ابن عباس.(@)(@@) وعنه: أبو زيد. ولا يعرفان.(@)(@@)(@@)(@@) $ 8444 - [قد]: أبو المغيرة. (2)(@)(@@) "أن النبي -صلى الله عليه وسلم- قال بالقسامة".(@)(@@) وعنه: عامر الأحول وقتادة.(@)(@@)(@@)(@@) $$$ [د]: أبو المفضل (1) في ترجمة أبي الفضل.(@)(@@)(@@)(@@) $$$ [د س ق]: أبو المقدام (1) الحداد ثابت بن هرمز.(@)(@@)(@@)(@@) $$$ [ت ق]: أبو المقدام (3) هشام بن زياد.(@)(@@)(@@)(@@) $$$ [د س ق]: أبو مكين (4) البصري نوح بن ربيعة.(@)(@@)(@@)(@@) $ 8445 - [ع]: أبو المليح (5) بن أسامة بن عمير الهذلي عامر، وقيل:(@)(@@) زيد.(@)(@@) عن: أبيه، وبريدة بن الحصيب، وجابر، وأنس، وعبد الله بن(@)(@@) عمرو، وعائشة، وعوف بن مالك، وجماعة.(@)(@@) وعنه: أبو قلابة، وسالم بن أبي الجعد، وأبو تميمة الهجيمي،(@)(@@) ويزيد الرشك، وقتادة، وأبو بشر، وأيوب، وخالد الحذاء، وحجاج(@)(@@) ابن أرطاة، وأبو بكر الهذلي، وخلق.(@)(@)PageV10P405(@)(@)(@@) وثقه أبو زرعة وغيره، قال الفلاس: مات سنة ثمان وتسعين، وقال(@)(@@) ابن سعد: توفي سنة اثنتي عشرة ومائة. وقيل: سنة 
ms2279	 ثمان ومائة.(@)(@@) قلت: قاله خليفة بن خياط، وقال أبو زرعة: كان عاملا على(@)(@@) الأيلة.(@)(@@)(@@)(@@) $$$ [بخ د ق]: أبو المليح (1) الرقي الحسن بن عمرو.(@)(@@)(@@)(@@) $ 8446 - [بخ ت ق]: أبو المليح (2) الفارسي المدني الخراط صبيح، وقيل:(@)(@@) حميد.(@)(@@) عن: أبي صالح الخوزي.(@)(@@) وعنه: حاتم بن إسماعيل، ووكيع، وأبو عاصم وجماعة.(@)(@@) وثقه ابن معين.(@)(@@)(@@)(@@) $$$ [خت]: أبو مليكة (3) التيمي زهير بن عبد الله بن جدعان.(@)(@@) عن: أبي بكر الصديق.(@)(@@) وعنه: حفيده عبد الله بن عبيد الله بن أبي مليكة.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو المنذر (4) الطفاوي محمد بن عبد الرحمن.(@)(@@)(@@)(@@) $$$ [عخ م د س]: أبو المنذر (4) الواسطي إسماعيل بن عمر.(@)(@@)(@@)(@@) $ 8447 - [د س ق]: أبو المنذر (5) مولى أبي ذر.(@)(@@) عن: أبي أمية المخزومي، وأبي ذر.(@)(@)PageV10P406(@)(@)(@@) وعنه: إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) $ 8448 - [مد]: أبو المنذر (1).(@)(@@) عن: النبي -صلى الله عليه وسلم- "أنه حثا في قبر ثلاثا" (2).(@)(@@) قاله هشام بن سعد، عن زياد وقيل يزيد بن تغلب عنه.(@)(@@)(@@)(@@) $ 8449 - [كن]: أبو المنذر (3).(@)(@@) عن: أبي سلمة.(@)(@@) وعنه: مالك فيما رواه خلف بن خليفة عنه. والصحيح ما رواه غير(@)(@@) واحد عن مالك، عن أبي النضر، وهو في الصحيحين من(@)(@@) حديث ابن عيينة عن سالم أبي النضر.(@)(@@)(@@)(@@) $$$ [د]: أبو منصور (4) الواسطي الحارث بن منصور.(@)(@@)(@@)(@@) $ 8450 - [د]: أبو منظور (5) شامي.(@)(@@) عن: عمه.(@)(@@) وعنه: ابن إسحاق.(@)(@@)(@@)(@@) $$$ [ع]: أبو المنهال (5) سيار بن سلامة تابعي.(@)(@@)(@@)(@@) $$$ [ع]: أبو المنهال (6) المكي عبد الرحمن بن مطعم صاحب ابن عباس.(@)(@@)(@@)(@@) $$$ [س]: أبو المنهال (7) في ترجمة عبد الملك بن قتادة.(@)(@)PageV10P407(@)(@)(@@)(@@)(@@) $ 8451 - [د]: أبو المنيب (1) الجرشي الدمشقي الأحدب.(@)(@@) عن: معاذ مرسلا، وأبي هريرة، وابن عمر، وجماعة.(@)(@@) وعنه: حسان بن عطية، وثور بن يزيد، وعاصم الأحول، وداود(@)(@@) ابن أبي هند، وجماعة.(@)(@@) وثقه العجلي وغيره.(@)(@@)(@@)(@@) $$$ [د س ق]: أبو المنيب (2) المروزي عبيد الله بن عبد الله.(@)(@@)(@@)(@@) $ 8452 - [س ق]: أبو المهاجر (3).(@)(@@) عن: بريدة الأسلمي "بكروا بالصلاة في الغيم" (4) وعن عمرو بن(@)(@@) أمية الضمري، وعن عمران بن حصين.(@)(@@) وعنه: أبو قلابة. وفي بعض الطرق [يسقطه] (5) أبو قلابة، وفي(@)(@@) بعضها وهو المحفوظ: 
ms2280	 أبو قلابة، عن أبي المهلب، عن عمران بن(@)(@@) حصين.(@)(@@)(@@)(@@) $$$ [ق]: أبو المهاجر (6) الرقي سالم بن عبد الله.(@)(@@)(@@)(@@) $$$ [ق]: أبو مهدي (6) الحمصي سعيد بن سنان.(@)(@@)(@@)(@@) $ 8453 - [د ت ق]: أبو المهزم (7) التميمي البصري يزيد بن سفيان،(@)(@@) وقيل: عبد الرحمن بن سفيان.(@)(@)PageV10P408(@)(@)(@@) عن: أبى هريرة.(@)(@@) وعنه: حسين العلم، وحبيب العلم، وعباد بن منصور، وشعبة،(@)(@@) وحماد بن سلمة، وسليم بن حبان، وعبد الوارث السعدي، وجماعة.(@)(@@) قال أحمد: ما أقرب حديثه. وقال ابن معين: ضعيف. وقال أبو(@)(@@) زرعة: ليس بقوي، شعبة يوهنه يقول: كتبت عنه مائة حديث ما(@)(@@) حدثت عنه بشيء. حكى [ابن] (1) المديني عن عبد الرحمن ذلك.(@)(@@) وقال أبو حاتم: ضعيف الحديث. وقال النسائي: متروك.(@)(@@)(@@)(@@) $ 8454 - [بخ م 4]: أبو المهلب (2) الجرمي البصري (عم) (3) أبي قلابة(@)(@@) فى اسمه أقوال أحدها: عمرو بن معاوية.(@)(@@) عن: عمر، وعثمان، وأبي، وتميم الداري، وعمران بن حصين،(@)(@@) وأبي مسعود البدري، وغيرهم.(@)(@@) وعنه: أبو قلابة، والحسن، وا بن سيرين، والجريري، وعوف.(@)(@@)(@@)(@@) $$$ [ق]: أبو المهلب (4) مطرح بن يزيد.(@)(@@)(@@)(@@) $$$ [ت]: أبو مودود (4) البصري فضة.(@)(@@)(@@)(@@) $$$ وأبو مودود (4) البصري بحر بن موسى.(@)(@@) ذكره في ترجمة (5) فضة.(@)(@@)(@@)(@@) $$$ [د ت س]: أبو مودود (6) الهذلي المدني عبد العزيز بن أبي سليمان.(@)(@)PageV10P409(@)(@)(@@)(@@)(@@) $ 8455 - [بخ]: أبو مودود (1).(@)(@@) عن: زيد مولى قيس.(@)(@@) وعنه: ابن المبارك.(@)(@@) لعله بحر بن موسى.(@)(@@)(@@)(@@) $$$ [عس]: أبو المورع (1).(@)(@@) عن: علي. في ترجمة أبو محمد الهذلي.(@)(@@)(@@)(@@) $$$ [ع]: أبو موسى (2) الأشعري (3) عبد الله بن قيس.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو موسى (4) البصري إسرائيل بن موسى.(@)(@@)(@@)(@@) $ 8456 - [س]: أبو موسى (5) الحذاء.(@)(@@) عن: عبد الله بن عمرو في "صلاة القاعد على النصف" (6).(@)(@@) وعنه: حبيب بن أبي ثابت.(@)(@@) وقال الأعمش، عن حبيب، عن عبد الله بن بابا بدل(@)(@@) أبي موسى.(@)(@@)(@@)(@@) $$$ [س]: أبو موسى (7) الحذاء صهيب.(@)(@@) عن: عبد الله بن عمرو.(@)(@)PageV10P410(@)(@)(@@) أظنه الذي قبله.(@)(@@)(@@)(@@) $$$ [ع]: أبو موسى (1) الزمن محمد بن المثنى الزمن.(@)(@@)(@@)(@@) $$$ [عس]: أبو موسى (2) الهمداني [مالك] (3) بن الحارث.(@)(@@)(@@)(@@) $ 8457 - [د]: أبو موسى (4) الهلالي.(@)(@@) عن: أبيه.(@)(@@) وعنه: سليمان بن المغيرة، وأبو هلال.(@)(@@) قال أبو حاتم: مجهول كأبيه.(@)(@@) وذكره ابن حبان في الثقات. 