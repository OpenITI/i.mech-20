ms361	 الدليل على مكانك في العلا % % أن كان جمع صلاته لك مجمعا % % PageV01P1096 11(@)(@@) % فكأنما داعي الأذان لفرضه % لك ساقهم وإليك تثويبا دعا % % 12(@)(@@) % وشككت إذ حملوك غير مدافع % بيد فخطو في الثرى لك مضجعا % % 13(@)(@@) % أعدوا على رجل فواروا شخصه % أم طوحوا بيلملم فتضعضعا % % 14(@)(@@) % يا من عهدت العز فوق جبينه % من راب عزك فاقتضى أن يرجعا % % 15(@)(@@) % من زم مخطمك الأبي فقاده % مع طول ماجذب الحبال فقطعا % % 16(@)(@@) % وحوى لرقيته لجاجك فارعوى % % ودعا نفارك فاستجاب وأتبعا % % 17(@)(@@) % وأرى معاشر كنت ضيق حلوقهم % يتسابقون تفسحا وتوسعا % % 18(@)(@@) % ما كنت مغلوبا فكيف أبحتهم % ذاك الحمى وأضعت ذاك الموضعا % % 19(@)(@@) % ولجوا عرينك آمنين وربما % % جروا به صعب الولوج ممنعا % % 20(@)(@@) % جمعوا فما سدوا مكانك ثلمة % وسعوا فما كانوا لخرقك مرقعا % % PageV01P1097 21(@)(@@) % ما أغمد النعمان سيف لسانه % حتى ثويت فكان يومكما معا % % 22(@)(@@) % ومحدث بالخلد بعدك جهله % وجد الشماتة حلوة فتجرعا % % 23(@)(@@) % لم تشفه منك الحياة بجهده % فشفاه موتك عاجزا فتودعا % % 24(@)(@@) % لا يشمتن وإن أقام مؤخرا % لا بد أن يقفوك ذاك المصرعا % % 25(@)(@@) % كم فته باعا ولو ملك المنى % % لكفاه فخرا أن يفوتك إصبعا % % 26(@)(@@) % مالي وكنتث بربع دارك آنسا % % أمسيت منه موحشا متفزعا % % 27(@)(@@) % وأراه جدبا بعد ما كنت زرته % خصبا بودك لي ويسرك مرتعا % % 28(@)(@@) % أيام أملك منك غير منازع % في كل ما أروى الوفاء وأشبعا % % 29(@)(@@) % سمعا بطيئا في عمن لامه % % وفما إلى ما سرني متسرعا % % 30(@)(@@) % فلأبكينك من فؤاد ناصح % في الحزن إن جفن بكا متصنعا % % PageV01P1098 31(@)(@@) % ولأحفظنك باللسان ولن ترى % % حقا على الحر الفصيح مضيعا % % 32(@)(@@) % وصلت ثراك على البلى وكافة % ترضي بروضتها المكان البلقعا % % 33(@)(@@) % ملىء الثدى على الثرى حنانة % تسقي إذا فطم الحيا ما أرضعا % % 34(@)(@@) % أخذت من الريح الشمال لها الصبا % % عهد الأمان وذمة لن تقشعا % % 35(@)(@@) % إن خان منك الدهر عهدي إنما % % في نقضه وعلى محاسنه سعى % % 36(@)(@@) % رفقا بقلبي يا زمان فإنه % صلب العصا ما أن إلا موجعا % % 37(@)(@@) % راميتني فاترك لكفي ساعدا 
ms362	 % % يصمي الرمية أو لكفي منزعا % % 38(@)(@@) % لو كان من أخذ الردى مني له % عوض أطال على الردى أن أجزعا % % 39(@)(@@) % أو كنت أبكيه وأكحل ناظرا % % بنظيره ما بل مني مدمعا % % PageV01P1099 البحر : - 1(@)(@@) % على كل حال جانب الحق أمنع % وكسب القتى بالعز أولى وأمتع % 2(@)(@@) % ويصعب أحيانا وينتظر الغنى % % فيأتي ولم يخضع له وهو طيع % 3(@)(@@) % ولا تترك الحر الأبي طباعه % لتخطئه والذل ثم التطبع % 4(@)(@@) % سقى الله مر الحزم يعرف نفسه % إلى أين ما يجري وإلى أين ينزع % 5(@)(@@) % إذا بذل الحرص الكرائم صانها % % وغالى بها إن الرخيص مضيع % 6(@)(@@) % يلومون نصلا كيف يزهي بحده % ولا يعلمون الهند من أين تطبع % 7(@)(@@) % دعوه مصون الماء يأكل غمده % إذا كان في أيمانكم ليس يقطع % 8(@)(@@) % وجروا القنا الخوار فاطردوا به % مخادعة ما دام في الحرب مخدع % 9(@)(@@) % أألآن لما أن تفاقم داؤها % % تبينتم أي العلاجين أنفع % 10(@)(@@) % فقد علم الصمصام أن مصيركم % إليه إذا التفت رقاب وأذرع % PageV01P1100 11(@)(@@) % أضعتم أمورا باعتزال محمد % فلما مضت قلتم له كيف ترجع % 12(@)(@@) % إذا كان في الأولى التجارب قبلها % % لمطلع في آخر الأمر مقنع % 13(@)(@@) % بعثتم لها الحاوي المدرب فانظروا % % وشيكا إلى صمائها كيف تسمع % 14(@)(@@) % لقام بها من لم يكن طالبا لها % % يدافع قوم دونها وهو يدفع % 15(@)(@@) % فتى لم تفده رفعة من حطيطة % وبعض الرجال بالولاية يرفع % 16(@)(@@) % لئن أخلفت فيها الولاة وعودكم % لقد جازها من وعده الصدق أجمع % 17(@)(@@) % وإن خان عاميها الربيع فإنها % % بماء يديه الآن في القيظ تربع % 18(@)(@@) % رحيب نواحي الصدر يفضل باعه % ذراعا إذا ضاقت صدور وأضلع % 19(@)(@@) % وقور الاناة ضاحك كما بكى % % على الأمر في إدباره المتسرع % 20(@)(@@) % وجدتم به الرأي المبيت ناصحا % لكم وبديه الرأي آل مشعشع % PageV01P1101 21(@)(@@) % وجربتم من قبله ومحمد % أحد وهزات الهماني أقطع % 22(@)(@@) % فذاك مغطي العجز بالحظ غالط % به الدهر مصنوع الرياسة مبدع % 23(@)(@@) % نفور زجاجي الإباء شفيفه % يكاد بأولى غمزة يتصدع % 24(@)(@@) % إذا ما أصاب أرتاب مما تعود ال % % خطاء فيرعى 
ms363	 الامن وهو مروع % 25(@)(@@) % فأن ساءه في نفسه العجز سره اغ % % تيابك والنقصان بالفضل مولع % 26(@)(@@) % لئن قعدت من لؤمه أربع به % لقد نهضت أضدادها بك أربع % 27(@)(@@) % تفيض إذا أصفى وتعفو إذا هفا % % وتصمى إذا أشوى وتعطي ويمنع % 28(@)(@@) % سقى الكوفة البيضاء ما سر جدبها % % بكفيك فياض الجداول مترع % 29(@)(@@) % أبعد أزورار العيش بالأمس بعدها % % غدت وهي مرعى للعفاة ومنجع % 30(@)(@@) % وأسعد بغدادا على ما أظلها % % من الشوق جفن كلما جف يدمع % PageV01P1102 31(@)(@@) % أعدت لدار موضع الأنس قاطنا % وأوحشت أخرى لا خلا منك موضع % 32(@)(@@) % وأخرني يوم أنطلاقك أن أرى % % على جمرات البين فيمن يشيع % 33(@)(@@) % فؤاد إذا قيل الفراق تسابقت % حقوقا أواخي صبره تقطع % 34(@)(@@) % وجدت صليب العود في كل حادث % ولكنني الخوار يوم أودع % 35(@)(@@) % فمعذرة أن المفارق حافظ % هواك ومثني الخير بعدك مصقع % 36(@)(@@) % وسمعا على بعد المزار وقربه % لسيارة فيكم تحط وترفع % 37(@)(@@) % إذا أبتم سرت وإذا بنتم سرت % وراءكم تقفو علاكم وتتبع % 38(@)(@@) % وقد كان بخل الناس باليأس صانها % % فعلمها تأميلكم كيف تطمع % 39(@)(@@) % لها سابقات كونها في زمامكم % ضمان وعهد عندكم لا يضيع % 40(@)(@@) % ولان لها دهر فما كلفتكم % وقد ضيق الآن الزمان فوسعوا % % PageV01P1103 41(@)(@@) % لئن حلئت فاستحلبتكم صواديا % لقد أنظرتكم برهة وهي نزع % 42(@)(@@) % دعوها ترد أورادها من حياضكم % ولا تدفعوها والغرائب تكرع % 43(@)(@@) % إليك وقد عيا الخطيب أخو العصا % % وخام عن النصح الكمي المقنع % 44(@)(@@) % رغبت بها عن ناصل الود قلبه % خبيث وإن طاب اللسان المصنع % 45(@)(@@) % يريني بفرط البشر أني قسيمه % وشافعه مما يضر وينفع % 46(@)(@@) % وقد كذب الإنسان في أنه أخي % % دعي يراني جائعا وهو يشبع % 47(@)(@@) % إذا قمت أشكو عند الدهر ذمه % وإياه أعني ما أقول وأسمع % PageV01P1104 البحر : - 1(@)(@@) % لكل هوى من رائد الحزم رادع % وحبكم مالم يزع عنه وازع % 2(@)(@@) % تحل عقود العين مبذولة له % وتشرج من ضن عليه الأضالع % 3(@)(@@) % صفاة على العذال لا يصدعونها % % ولو شق شعبا من أبانين صادع % 4(@)(@@) % غرام الصبا كيف ألتفت 
ms364	 بصبوة % إلى غيركم فالقلب فيكم ينازع % 5(@)(@@) % يقولون حولي اللقاء ونظرة % مسارقة حب لعمرك قانع % 6(@)(@@) % أجيراننا أيام جمع تعلة % سلوا النفر هل ماض من النفر راجع % 7(@)(@@) % وهل لثلاث صالحات على منى % ولو أن من أثمانه النفس فاجع % 8(@)(@@) % أجن بنجد حاجة لو بلغتها % % ونجد على مرمى العراقي شاسع % 9(@)(@@) % وحل لظبي حرم الله صيده % دم ساء ما ضلت عليه المسامع % 10(@)(@@) % يفالت أشراكي على ضعف ما به % فطار بها قطعا وقلبي واقع % PageV01P1105 11(@)(@@) % وكم ريع بالبطحاء من متودع % وقلقل ركب للنوى وهو وادع % 12(@)(@@) % ومشرفة غيداء في ظهر مشرف % له عنق في مقود البين خاضع % 13(@)(@@) % جرى بها الوادي ولو شئت مسبلا % جفوني لقد سالت بهن المدامع % 14(@)(@@) % وبيضاء لم تنفر لبيضاء لمتي % % وقد راع منها ناصل الصبغ ناصع % 15(@)(@@) % رأت نحرها في لونه فصبت له % وما خلت أن الشيب في الحب شافع % 16(@)(@@) % عفا الخيف إلا ان يعرج سائل % تعلة شوق أو يغرد ساجع % 17(@)(@@) % وإلا شجيج أعجل السير نزعه % عسا فتعافته الرياع الزعازع % 18(@)(@@) % وفي مثل بطن الراح سحم كأنها % % ثلاث بنانات قضاها مقارع % 19(@)(@@) % وقفت بها لا القلب يصدق وعده % ولا الجفن يرضيني بما هو وادع % 20(@)(@@) % فيا عجبي حتى فؤادي بوده % مداج وحتى ماء عيني مصانع % PageV01P1106 21(@)(@@) % أبى طبع هذا الدهر إلا لجاجة % وأتعب شيء أن تحال الطبائع % 22(@)(@@) % يعز حصا المعزاء والدر هين % ويشبع عير السرح والليث جائع % 23(@)(@@) % وأودعته عهدا فعدت أرومه % ومن دينه ألا ترد الودائع % 24(@)(@@) % وأقسم لا استرجعته ولو أنه % قضى في شبابي أنه لي راجع % 25(@)(@@) % هنا المانعين اليوم أن سؤالهم % منى ما أملتها علي المطامع % 26(@)(@@) % وإني بعنقي من يد المن مفلت % وما المن في الأعناق إلا جوامع % 27(@)(@@) % وفي الأرض أموال ولكن عوائق % من اللؤم قامت دونها وموانع % 28(@)(@@) % حماها رتاج في صدور شحيحة % وأيد خبيثات عليها طوابع % 29(@)(@@) % بأي جمام الماء أرجو عذوبة % إذا أملحت طعم الشفاه الوقائع % 30(@)(@@) % وما خلتني أمشي على البحر ظامئا 
ms365	 % وخمس فمي منه بما بل قانع % PageV01P1107 31(@)(@@) % لعل لفخر الملك آنف نظرة % يعود بها الحق البطيء يسارع % 32(@)(@@) % وكم مثلها مضمونة عند مجده % وفى لي بها والدهر عنها يدافع % 33(@)(@@) % شفت يده غيظ البلاد على الصدى % % وردت جزار الأرض وهو مراتع % 34(@)(@@) % زكا تحتها الترب اللئيم وأورق ال % % قتاد الجفيف فهو ريان يانع % 35(@)(@@) % وجردها بيضاء واحدة الندى % % وخضر البحار السبع منها نوازع % 36(@)(@@) % وقد زعموا أن لا مرد لفائت % وان الردى يوم متى حم قاطع % 37(@)(@@) % وهذي العلا والمكرمات مواتها % % بجودك من تحت التراب رواجع % 38(@)(@@) % برغم ملوك الأرض أن ظهورهم % من العجز عما تستحق ظوالع % 39(@)(@@) % تركتهم ميلا إليك رقابهم % فلا تستقم من حاسيدك الأخادع % 40(@)(@@) % وقد سبروا غوريك عفوا ونقمة % فما عرفوا من أين ماؤك نابع % PageV01P1108 41(@)(@@) % وكنت متى تقدح بزندك ثاقبا % سرى النجم لم تسدد عليك المطالع % 42(@)(@@) % وكم قمت دون الملك كاشف كربة % تيقظ منها الخطب الملك هاجع % 43(@)(@@) % وضيقة الأقطار عمياء ما لها % % إذا انخرقت من جانب الرأي راقع % % 44(@)(@@) % تجانب مثناة النصوح فتوقها % % إذا وصلت أسبابها فتقاطع % 45(@)(@@) % تداركتها بالحزم لا السيف قاطع % حديدته فيها ولا الرمح شارع % 46(@)(@@) % وليت بصغرى عزمتيك كبيرها % % كما دبرت نزع القناة الأصابع % 47(@)(@@) % وأخرى أبت إلا القراع رددتها % % تذم وترضى ما جنته المقارع % 48(@)(@@) % ركبت إليها السيف جسمك حاسر % وقلبك من لبس التصبر دارع % 49(@)(@@) % وفيت بعهد الصبر فيها حمية % وقد غدرت بالراحتين الأصابع % 50(@)(@@) % ومخطوبة بالكتب والرسل مهرها % % غرائب أبكار الكلام البدائع % PageV01P1109 51(@)(@@) % يقوم الخطاب الفصل والجو ساكن % لديها مقام النصل والنقع ساطع % 52(@)(@@) % كتبت فأمليت الرياض وماءها % % وكالنار وعظ تحتها وقوارع % 53(@)(@@) % لك النصر فاسمع كيف أظلم وانتصر % % فما تضع الأيام من أنت رافع % 54(@)(@@) % حرمت عطاياك المقسم رزقها % % وعاقت مديحي عنك منك موانع % 55(@)(@@) % وحلاني عن بحر جودك راكب % هواه وقد لاحت لعيني الشرائع % 56(@)(@@) % ثلاث سنين قد أكلت صبابتي % % فغادرتني شلوا وذا العام رابع % 57(@)(@@) % أرى من قريب شمل عزي مبددا % وقد كان 
ms366	 ظني أنه بك جامع % 58(@)(@@) % على كل ماء لامع من نداكم % سنان من الحظ المماكس لامع % 59(@)(@@) % أيا جابر المنهاض لم يبق مفصل % وإلا ندوب تحته ولواذع % 60(@)(@@) % أعيذك بالمجد المحسب أن يرى % % جنابك عني ضيقا وهو واسع % PageV01P1110 61(@)(@@) % وأعجب ما حدثته حفظك العلا % % ومثلي في أيام ملكك ضائع % 62(@)(@@) % أأنطق مني بالفصاحة يجتبى % % وأمدح إن لفت عليك المجامع % 63(@)(@@) % أبى الله والفضل الذي أنت حاكم % به لي لو قاضى إليك منازع % 64(@)(@@) % وما الشعر إلا النشر بعدا وصورة % فلو شاء لم يطمع يدا فيه رافع % 65(@)(@@) % وقد أفل النجمان منه فلا يضع % على غير سير ثالث فيه طالع % 66(@)(@@) % بقيت لكم وحدي وإن قال معشر % ففي القول ما تنهاك عنه المسامع % 67(@)(@@) % ولو شئت بي أخفى زهير ثناءه % على هرم أيام تجزى الصنائع % 68(@)(@@) % وما شاع عن حسان في آل جفنة % من السائرات اليوم ما هو شائع % 69(@)(@@) % وكان غبينا في أمية من شرى % % مديح غياث وهو مغل فبائع % 70(@)(@@) % على كل حال أنت معط وكلهم % على سعة الأحوال معط ومانع % PageV01P1111 71(@)(@@) % وقد وهبوا مثل الذي أنت واهب % فما سمعوا بعض الذي أنت سامع % 72(@)(@@) % ذرائع من فضل عليك اتكالها % % فما بالها تدنى وتقصى ذرائع % 73(@)(@@) % وما لكم والله يعطف خصبكم % على مجدب دنياه منه بلاقع % 74(@)(@@) % تصان الأسامي عندكم باشتهارها % % وغمض المعاني مهملات ضوائع % 75(@)(@@) % وموشية حوك البرود صفلتك ال % % حسان تساهيم لها ووشائع % 76(@)(@@) % تهب رياحا في عداك خبيثة % وطيبا عليك ردعها متسارع % 77(@)(@@) % كأن اليماني حل منها عيابه % تفاوح من دارين إليها البضائع % 78(@)(@@) % متى ضحكت لي من سمائك برقة % حكت لك أرضي كيف تزكو الصنائع % 79(@)(@@) % وإن كان يوم في الحوائج شافعا % إلى النجح إن المهرجان لشافع % PageV01P1112 البحر : - 1(@)(@@) % أمرتجع لي فارط العيش بالحمى % % غرامي بتذكار الهوى وولوعي % % 2(@)(@@) % وكري المطايا أشتكي غير ضامن % وأدعو من الأطلال غير سميع % 3(@)(@@) % نعم يقنع المشتاق ما ليس طائلا % وإن لم يكن قبل النوى بقنوع % 4(@)(@@) % وقفنا بها 
ms367	 أشباح وجد ولوعة % وأشباه ذل للنوى وخشوع % 5(@)(@@) % نحول ركاب ضامها السير فوقه % نحول جسوم في نحول ربوع % 6(@)(@@) % لعمر البلى ما اقتاد من ضوء ضارج % سوى مسمح للنائبات تبيع % 7(@)(@@) % وقد كسيت أطلال قوم وعريت % فما منعت دار كأم منيع % 8(@)(@@) % رحيبة باع الحسن طاولت الدمى % % فزادت بمعنى في الجمال بديع % 9(@)(@@) % خطت في الثرى خطو البطيء وقاسمت % لحاظا لها في القلب مشي سريع % 10(@)(@@) % كأن مطيبا قال للعترة افتقي % % يقول لها جري الذيول وضوعي % % PageV01P1113 11(@)(@@) % واعهدها والدمع يجري بلونه % % فتصبغه من خدها بنجيع % 12(@)(@@) % كأن شعاع النضار في وجناتها % % يطير شرار النار بين ضلوعي % % 13(@)(@@) % وعصر الحمى عصري وضلع ظبائه % معي وربيع العيش فيه ربيعي % % 14(@)(@@) % ليالي أغشى كل جيد ومعصم % يبيت وحيدا من فمي بضجيع % 15(@)(@@) % إذا رعتها من وصل أخرى بزلة % تلافيتها من لمتي بشفيع % 16(@)(@@) % وفحمة ليل كالشعور اهتديتها % % بقدحة برق كالثغور لموع % 17(@)(@@) % إلى حاجة من جانب الرمل سخرت % لها الشمس حتى ما اهتدت لطلوع % 18(@)(@@) % وجوه تولت من زماني وما أرى % % بأظهرها أمارة لرجوع % 19(@)(@@) % تعيب علي الشيب خنساء أن رأت % تطلع ضوء الفجر تحت هزيع % 20(@)(@@) % وما شبت ولكن ضاع فيما بكيتكم % سواد عذارى في بياض دموعي % % PageV01P1114 21(@)(@@) % وقالت تفرقنا ونمت على الهوى % % سلي طيفك الزوار كيف هجوعي % % 22(@)(@@) % خلعت الهوى إلا الحفاظ ولم أكن % لأخدع فيه عن مقام خليع % 23(@)(@@) % وكنت جنيبا للبطالة فانثنى % % زمام نزاعي في يمين نزوعي % % 24(@)(@@) % سأركبها خرقاء تذرع بوعها % % فضا كل خرق في البلاد وسيع % 25(@)(@@) % إذا قطعت أرضا اعدت لأختها % % ظنابيب لم تقرع بمر قطيع % 26(@)(@@) % ضوامن في الحاجات كل بعيدة % وصائل في الآمال كل قطوع % 27(@)(@@) % تزور بني عبد الرحيم فتعتلي % % بأخفافها خضراء كل ربيع % 28(@)(@@) % تحط بماء للندى مترقرق % معين وواد للسماح مريع % 29(@)(@@) % ترى المدح وسما والثناء معلقا % لهم بين اغراض لها ونسوع % 30(@)(@@) % وكائن لديهم من قراع لنكبة % وللمجد فيهم من إخ وقريع % PageV01P1115 31(@)(@@) % وعندهم من نعمة صاحبية % ترب أصولا من 
ms368	 علا لفروع % 32(@)(@@) % حموا بالندى أعراضهم فوقاهم % من العار ما لا يتقى بدروع % 33(@)(@@) % ونالوا بأقلام تجول بأنمل % مطارح أرماح تطول ببوع % 34(@)(@@) % بنو كل مفطوم من اللؤم والخنا % % وليد وترب للسماح رضيع % 35(@)(@@) % إذا حوملوا زادوا بأوفى موازن % وإن فاخروا كالوا بأوفر صوع % 36(@)(@@) % وإن ريع جار أو تنكرمنزل % فرب جناب للحسين مربع % 37(@)(@@) % رعى الله للآمال جامع شملها % % مشتا من الأموال كل جميع % 38(@)(@@) % وحافظ سرب المكرمات ولم تكن % لتحفظ إلا في يمين مضيع % 39(@)(@@) % أخو الحرب أنى ربها كان ربها % % وأبطالها من سجد وركوع % 40(@)(@@) % وكالراح أخلاقا إذا امتزجت به % ولكنه للكأس غير صريع % PageV01P1116 41(@)(@@) % ومشفقة تنهاه من فرط جوده % ألا تعبا تنهين غير مطيع % 42(@)(@@) % تسومين كف المزن أن تضبط الحيا % % ولا تسلم الأسرار عند مذيع % 43(@)(@@) % شددت بكم أيدي وسددت خلتي % % ورشت جناحي والتحمت صدوعي % % 44(@)(@@) % وأقنعني تجريب دهري وأهله % بكم فحسمتم بذلتي وقنوعي % % 45(@)(@@) % فإن أنا لم أفصح بحسن بلائكم % بشكري فذموني بسوء صنيعي % % 46(@)(@@) % بكل مطاع في البلاغة امرها % % مخلى لها استطراق كل بديع % 47(@)(@@) % لها في القوافي ما لبيتك في العلا % % سنام نصاب لا ينال رفيع % 48(@)(@@) % إذا عري الشعر ارتدت من بروده % بكل وسيم الطرتين وشيع % 49(@)(@@) % أمد بها كفا صناعا كأنني % % أهيب بسيف في الهياج صنيع % 50(@)(@@) % على كل يوم طارف الحسن طارف % لها غير مكرور ولا برجيع % PageV01P1117 51(@)(@@) % هدايا لكم نفسي بها نفس باذل % وصني بها في الناس ضن منوع % PageV01P1118 البحر : - 1(@)(@@) % لعلك , , بالشعب تعلو اليفاعا % % فتؤنس من نار هند شعاعا % % 2(@)(@@) % , , تميمية لم يكن خطمها % % فؤادك بالوعد إلا خداعا % % 3(@)(@@) % غدت نظرا لك تروى العيون % وأمست أحاديث ترعى سماعا % % 4(@)(@@) % حذت أم , , ظبية , , أم النجو % % م ضياء لطالبها وارتفاعا % % 5(@)(@@) % ومن دونها البلد المقشعر % يرد ظباء المهارى ضباعا % % 6(@)(@@) % إذا رمته شجرته الرماح % فسدت عليك الثنايا اطلاعا % % 7(@)(@@) % , , زرود وما جر حبلا , , زرو % % د بيني وبينك إلا إنقطاعا % % 8(@)(@@) % أعيذ هواك وأخذي به ال % % وثيقة من كاشح أن 
ms369	 يطاعا % % 9(@)(@@) % ووقفتنا وهي بكر اللقاء % على , , أجأ أن تكون الوداعا % % 10(@)(@@) % أسام فأرخص بيع الصبا % % وأغلى بحبكم أن يباعا % % PageV01P1119 11(@)(@@) % نزعت الشباب فمن زادني % % مشيبي نحوك إلا نزاعا % % 12(@)(@@) % ظلت , , بنجد يفر الغرا % % م من أضلعي وأجد اتباعا % % 13(@)(@@) % وأنشد خرقاء بالعاشقين % تمد إلى القتل كفا صناعا % % 14(@)(@@) % إذا استبطأت من دجى ليلة % صباحا أماطت يداها القناعا % % 15(@)(@@) % ألا بكرت تستطيب الملام % وتأمل جاهلة أن تطاعا % % 16(@)(@@) % تقول مراحك فافطن له % متى فات لم تستطعه ارتجاعا % % 17(@)(@@) % تغنم من العيش إبانه % وخذ منه حظك ساعا فساعا % % 18(@)(@@) % وتتعذلني في إطراح الرجال % سكونا إلى وحدتي وانقطاعا % % 19(@)(@@) % ولم تدر أني صبغت الزما % % ن لونبه ضرابه وانتفاعا % % 20(@)(@@) % وكاثرت متعة لذاته % فلم أر ذلك إلا متاعا % % PageV01P1120 21(@)(@@) % ولو شئت ما ضاع في العتاب % فإنك لا تنقلين الطباعا % % 22(@)(@@) % وكم من أخ قلت أحرزته % فلما ملئت يدي منه ضاعا % % 23(@)(@@) % أعالج منه على صحتي % % خروقا أقر عليها الرقاعا % % 24(@)(@@) % أريد لأشعب أضغانه % وتأبى الزجاجة إلا انصداعا % % 25(@)(@@) % حمى الله قوما على نأيهم % إذا أبطأ النصر جاءوا سراعا % % 26(@)(@@) % تضم الحفيظة إحسانهم % على المجد أن يتركوه مضاعا % % 27(@)(@@) % بصائرهم جمع بينهم % ولو أصبحوا بالتعادي شعاعا % % 28(@)(@@) % إذا كشحوا بالصدور احتموا % % بألسنهم أن يخوضوا القذاعا % % 29(@)(@@) % تلين الضرورات شمس النفوس % ويأبون في الضر إلا امتناعا % % 30(@)(@@) % إذا قيل عيشوا شباع البطون % وفي الشبع الذل ماتوا جياعا % % PageV01P1121 31(@)(@@) % بني كل معترف منكر % إذا سل راق وإن هز راعا % % 32(@)(@@) % تقول وليدا له أمه % إذا ما أكبت عليه رضاعا % % 33(@)(@@) % رد الموت أو كن عقوقا وعش % إذا أنت كنت جوادا شجاعا % % 34(@)(@@) % بأبناء , , أيوب حط السماح % فحل العياب وألقى البعاعا % % 35(@)(@@) % وجاوز أيديهم شاكرا % بنانا رطابا وبوعا وساعا % % 36(@)(@@) % كرام ترى سر أعراضهم % مصونا وسر غناهم مذاعا % % 37(@)(@@) % إذا أجدبوا خصهم جدبهم % وإن أخصبوا كان خصبا جماعا % % 38(@)(@@) % إذا الخطب أعجز برى السيو % % ف جاءوه بارين فيه اليراعا % % 39(@)(@@) % قواطع يغمدن سر الصدور % ويشهرن حيا موت 
ms370	 تساعى % % 40(@)(@@) % إذا كذبت في اللقاء الرما % % ح قاموا بها يصدقون المصاعا % % PageV01P1122 41(@)(@@) % ظبا في الأعادي تسيء الصنيع % فيحسن أربابها الاصطناعا % % 42(@)(@@) % إذا شهدوا قارعات الخطوب % بها خلتهم يشهدون القراعا % % 43(@)(@@) % معال يزيد , , أبوطالب % سنا شمسها قوة واتساعا % % 44(@)(@@) % ولما رأى كيف طيب الأصول % وفي مكرما وأطاب افتراعا % % 45(@)(@@) % فتى ملء كفك إن جئته % وفاءإذا العضد خان الذراعا % % 46(@)(@@) % ربيع الجناب إذا ما الريا % % ح ألصقن بالوهدات التلاعا % % 47(@)(@@) % إذا فض نافلة الأعطيات % توهم يقسم حقا مشاعا % % 48(@)(@@) % فلو جئت تسأله نفسه % لخالك كلفته ما استطاعا % % 49(@)(@@) % إذا نفرت حسنات الرجال % شذوذا أنس عليه اجتماعا % % 50(@)(@@) % فضائل قرحهن الكمال % وإن عد أعوام عمر جذاعا % % PageV01P1123 51(@)(@@) % فداك قصير المعالي أشل % إذا قاس فتر علا طلت باعا % % 52(@)(@@) % تعلق في نسب كنت منه % سراة الأديم وكان الكراعا % % 53(@)(@@) % إذا ما عدلت به لم يزن % % ك مثقال نجد ولا كال صاعا % % 54(@)(@@) % ومختلف الود خاللته % فكان هواه عدوا مطاعا % % 55(@)(@@) % أراسل نابتة العرق منه % فضولا ويقطع مني النخاعا % % 56(@)(@@) % بك اعتضت من كل مسلوبة % تغصبنيها الزمان انتزاعا % % 57(@)(@@) % ودافعت نجمة أحداثه % وما كان يملك صدى دفاعا % % 58(@)(@@) % فإن هو كافي البلاء الثناء % ضمنت نهوضا به واضطلاعا % % 59(@)(@@) % وسيرتهن خماص البطو % % ن لا يبتغين سواك انتجاعا % % 60(@)(@@) % يقعن بعيدا إذا ما قطعن % بأوعية الشعر خرقا وقاعا % % PageV01P1124 61(@)(@@) % إذا ما خطرن على روضة % بعرضك زدن عليها رداعا % % PageV01P1125 البحر : - 1(@)(@@) % وكنت وأيام المزار رخية % علي ورخص الوصل لي فيك يطمع % 2(@)(@@) % أعز فلا أعطى الهوى فيك حقه % من الشكر والمعطى مع الكفر يمنع % 3(@)(@@) % فلما استرد الدهر مني عطاءه % وعادت شعوب في الهوى تتصدع % 4(@)(@@) % قعدت مع الهجران أبكيه نادما % وأسأل عنه ماضيا كيف يرجع % PageV01P1126 البحر : - 1(@)(@@) % لي عند ظبي , , الأجرع % قصاص جرح ما رعي % % 2(@)(@@) % سهم بعينيه دلي % % ل فوقه والمنزع % 3(@)(@@) % جناية منكرها % % بينة للمدعي % % 4(@)(@@) % غاروما احتسبته % فغار بين أضلعي % % 5(@)(@@) % ما خلت نقع القانصي % % ن ينجلي عن مصرعي % % 6(@)(@@) % يا ليلتي , , بحاجر 
ms371	 % إن عاد ماض فارجعي % % 7(@)(@@) % بتنا على الأحقاف ت % % نهال بكل مضجع % 8(@)(@@) % موسدين اللين من % كراكر وأذرع % 9(@)(@@) % مقلة ليلة بيضت % بفجره المنصدع % 10(@)(@@) % قالوا الصباح فانتبه % فقال لي الطيف اسمع % PageV01P1127 11(@)(@@) % فقمت مخلوطا أظ % % ن البازل ابن الربع % 12(@)(@@) % حيران طرفي دائر % يطلب من ليس معي % % 13(@)(@@) % أرضى بأخبار ا % % لرياح والبروق اللمع % 14(@)(@@) % وأين من برق , , الحمى % % شائمة , , بلعلع % 15(@)(@@) % سلا مجالي الشيب عن % غيم الشباب المقلع % 16(@)(@@) % غمامة طخياء ري % % ع سربها بالفزع % 17(@)(@@) % فأجفلت لا تلتوي % % أخلافها لمرضع % 18(@)(@@) % كما نجت خائفة % ورهاء لم تقنع % 19(@)(@@) % ملكت يا شيب فخذ % ما شئت مني أودع % 20(@)(@@) % طارقة بمثلها % % فاجئة لم ترع % PageV01P1128 21(@)(@@) % أفني الخطوب قبلها % % صبري وأفنت جزعي % % 22(@)(@@) % أعدى جبيني مفرقي % % فاستويا في الصلع % 23(@)(@@) % طليعة وجهي بها % % قبل الممات قد نعي % % 24(@)(@@) % كان الشباب سدفة % من لك لم تقشع % 25(@)(@@) % سترا على أن لا يرا % % ني الدهر لو لم يرفع % 26(@)(@@) % كم ليلة ظلماء طالت % بدرها لم يطلع % 27(@)(@@) % أنكرت استكانتي % % للدهر وتخشعي % % 28(@)(@@) % كريمة ما عهدت % تأوهي لموجع % 29(@)(@@) % لم ألقى أطمارى ولي % % فيها مكان مرقع % 30(@)(@@) % كم حمل الدنيا فلا % % ترق لي من ظلع % PageV01P1129 31(@)(@@) % أعذل منها ضخرة % ليس لها من مصدع % 32(@)(@@) % قد فنيت مواعظي % % والدهر لم يرتدع % 33(@)(@@) % في كل يوم صاحب % يشرع غير مشرعي % % 34(@)(@@) % له شهادى مكثرا % ولي مقلا سلعي % % 35(@)(@@) % يسومني طباعه % مع كلفة التطبع % 36(@)(@@) % يريد من رفد اللئا % % م أن يكون شبعي % % 37(@)(@@) % هيهات ما أبعدها % % هشيمة من نجعي % % 38(@)(@@) % لو كنت ذئب قفرة % لما تبعت طمعي % % 39(@)(@@) % إن البطين مخمص % فاشبع ذليلا أو جع % 40(@)(@@) % أسففت لدنية % فقع لها أوطر معي % % PageV01P1130 41(@)(@@) % زعمت أن الشعر من % رزق الفتى الموسع % 42(@)(@@) % ولمت في ضني به % قلت تسمح وبع % 43(@)(@@) % أما ترى كساده % على نفاق السلع % 44(@)(@@) % وحسبك الجهل به % خسارة للمبضع % 45(@)(@@) % ربوحاشا الكرما % % ء سامع لم يسمع % 46(@)(@@) % صم وأذن عرضه % تسمع عني وتعي 
ms372	 % % 47(@)(@@) % وخاطب وليس كف % % ئا لكريم البضع % 48(@)(@@) % يبني ولم يمهر وإن % طلق لم يمتع % 49(@)(@@) % يمنع أو ينغص ال % % عطاء إن لم يمنع % 50(@)(@@) % وأبيض الثغر ابتسا % % م عن ضمير أسفع % PageV01P1131 51(@)(@@) % ألبسني صنيعة % تسلب بالتصنع % 52(@)(@@) % أفرشني الجمر وقا % % لإن أردت فاهجع % 53(@)(@@) % حملته مغالطا % بجذلي تفجعي % % 54(@)(@@) % يا عطشي إن لم أرد % إلا الخلي المشرع % 55(@)(@@) % لو عفت كل مالح % لما شربت أدمعي % % 56(@)(@@) % ولو أقمت كل عو % % جاء أقمت أضلعي % % 57(@)(@@) % يذاد سرح الحي من % حيث رجى أن يرتعي % % 58(@)(@@) % ويجدب المرء على % % أذيال عام ممرع % 59(@)(@@) % أخي الذي آمن إن % عرفنيه فزعي % % 60(@)(@@) % وكان سيفا كابن , , أيوب % إذا قلت اقطع % PageV01P1132 61(@)(@@) % أخطر مع جبني به % في لأمة المشيع % 62(@)(@@) % إذا رأى ثنية % لسودد قال اطلع % 63(@)(@@) % أمري في نعمته % أمر الهوى المتبع % 64(@)(@@) % في كل يوم جمة % من سيبه الموزع % 65(@)(@@) % وعطفة ترأبشع % % ب شملي المنصدع % 66(@)(@@) % سابقة عثرة حا % % لي أبدا بدعدع % 67(@)(@@) % طال السحاب كف ص % % ب بالسماح مولع % 68(@)(@@) % وبذ حلبات الجيا % % د سابق لم يقرع % 69(@)(@@) % يخرج عنها ناصلا % من جله والبرقع % 70(@)(@@) % خاض الحروب حاسرا % يهزا بالمدرع % PageV01P1133 71(@)(@@) % وحالم ابن الأربع % % ين في سموط الأربع % 72(@)(@@) % من غالبي شمس العلا % % على مكان المطلع % 73(@)(@@) % أصول مجد مابها % % فقر إلى مفرع % 74(@)(@@) % هم لبسوا الدنيا وبع % % د حسنها لم ينزع % 75(@)(@@) % واحتلبوا درتها % % قبل جفوف الأضرع % 76(@)(@@) % من كل أخاذ مع ال % % فتك بامر الورع % 77(@)(@@) % يوري الدجى بموقد % من جوده المشعشع % 78(@)(@@) % يصغي لصوت الضيف إص % % غاء الحصان الأروع % 79(@)(@@) % يمسون غرسى وهم % مشبعة للجوع % % 80(@)(@@) % وفحمة من الخطو % % ب ذات وجه مفزع % PageV01P1134 81(@)(@@) % كانوا بدور تمها % % على الليالي الدرع % 82(@)(@@) % لد إذا القول احتسى % % ريق البليغ المصقع % 83(@)(@@) % تعاوروا صعابه % بكل رخو أصمع % 84(@)(@@) % أعلق بالراحة من % بنانة وأشجع % 85(@)(@@) % كأنذ أقلامهم % في اللبث والتسرع % 86(@)(@@) % نابتة مع الأك % % ف في حبال الأذرع % 87(@)(@@) % مناسب لو قذعت % شمس الضحى 
ms373	 لم تقذع % 88(@)(@@) % واقفة من العلا % % على طريق مهيع % 89(@)(@@) % لو دب كل عائب % أفعى لها لم تلسع % 90(@)(@@) % تحمل فيها ألم ال % % ميسم جبهة الدعي % % PageV01P1135 91(@)(@@) % صابوا رذاذا وتل % % وت بالسيول الدفع % 92(@)(@@) % اقتعدوا الردف وأع % % طوك مكان القمع % 93(@)(@@) % با غيك بنقيصة % قتيل داء الطمع % 94(@)(@@) % أو قص يبغي طلعة % على قصاص الأتلع % 95(@)(@@) % لو كان من نصيحتي % % بمنظر ومسمع % 96(@)(@@) % قلت تنح يا فري % % س عن مكان السبع % 97(@)(@@) % دع العلا واسرح على % % حابسها المجعجع % 98(@)(@@) % أمر يناط بسوا % % ك خرقه لم يرقع % 99(@)(@@) % كل يمين لم ترا % % فدها يسار الاقطع % 100(@)(@@) % وقلما أغنى الفتى % % شميمه بأجدع % PageV01P1136 101(@)(@@) % بك اكتسى عودي وعا % % د جلدا تضعضعي % % 102(@)(@@) % وبان في الدهر الغ % % ني أثرى وموقعي % % 103(@)(@@) % أفسدت قلبي وعقل % % ي قارحي وجذعي % % 104(@)(@@) % فعفت أحبابي واستض % % عفت نصر شيعي % % 105(@)(@@) % فاسمع أكاثرك بها % % أحسن ما قيل اسمع % 106(@)(@@) % مطاربا تخرج نس % % ك الحابس المنقطع % 107(@)(@@) % تحنو النجوم حسدا % لبردها الموشع % 108(@)(@@) % ما خطرت لمحتذ % قبلي ولا مبتدع % 109(@)(@@) % أعيت على الراقين ح % % تى استنزلتها خدعي % % 110(@)(@@) % في كل يوم ملك % بتاجها المرصع % PageV01P1137 111(@)(@@) % يهيج في اغتيابها % % داء الحسود الموجع % 112(@)(@@) % يخرجها بجهله % تروع إن لم تقطع % 113(@)(@@) % غضبان أن تكسر بال % % نبع فروع الخروع % 114(@)(@@) % يسرع في والعثا % % ر مولع بالمسرع % 115(@)(@@) % لما غدت عيونه % تصغر عن تتبعي % % 116(@)(@@) % عاقبته بضحكي % % من ذكره في المجمع % 117(@)(@@) % وآكلين معه % زاد الذباب الوقع % 118(@)(@@) % تغمر كف الذم من % أعراضهم في شمع % 119(@)(@@) % تشابهوا فما عرف % % ت حالقا من أنزع % 120(@)(@@) % قالوا وأصغيتم ومن % يسمع في مسمعي % % PageV01P1138 121(@)(@@) % مالي وأنتم وزري % % من الأذى ومفزعي % % 122(@)(@@) % يطمع في عندكم % بالغيب من لم يطمع % 123(@)(@@) % في كل يوم وقعة % شنعاء إحدى البدع % 124(@)(@@) % يمضغ لحم الليث في % % ها بنيوب الضبع % 125(@)(@@) % وفيك النصر وع % % ز الجانب الممتنع % 126(@)(@@) % وليس عني بلسا % % ن ويد من مدفع % 127(@)(@@) % رعاية للفضل إن % كان ذمامي مارعي % % 128(@)(@@) % ولو 
ms374	 غضبت غضبة % أعوز سد موضعي % % 129(@)(@@) % إذا لطالت غيبتي % % وكدكم توقعي % % 130(@)(@@) % ما في حياض الناس ما % % يزحم عنه مكرعي % % PageV01P1139 131(@)(@@) % ولا يضيق منزل % عني مع تقنعي % % 132(@)(@@) % إذا سلوت داركم % فكل دار مربعي % % 133(@)(@@) % لكن نفسي عن هوا % % كم قط لم تخدع % 134(@)(@@) % لو رأت الخلد النزو % % ع عنكم لم تنزع % 135(@)(@@) % ملأت قلبي شغفا % بكهلكم واليفع % 136(@)(@@) % فلو يسام حب ش % % يء معكم لم يسع % 137(@)(@@) % خيمت فيكم فليضع % من شاء أو فليرفع % 138(@)(@@) % ولو وجدت مقنعا % في غيركم لم أقنع % PageV01P1140 البحر : - 1(@)(@@) % حب إليها بالغضا نرتيعا % % وبالنخيل موردا ومشرعا % % 2(@)(@@) % وبأثيلات النقا طلائلا % يفرشها كراكرا وأذرعا % % 3(@)(@@) % تقامص البزلاء فيها بكرها % % من المراح والصني الجذعا % % 4(@)(@@) % منى لها لو جعل الدهر لها % % أن تأمن الطارد والمدعدعا % % 5(@)(@@) % عزت فما زال بها جور النوى % % والبيد حتى آذنت أن تخنعا % % 6(@)(@@) % أمكنت من الخشاش آنفا % ما طمعت من قبل فيها مطمعا % % 7(@)(@@) % الله يا سائقها فإنها % % جرعة حتف أن تجوز الأجرعا % % 8(@)(@@) % أسل بها الوادي رفيقا انها % % تسيل منها أنفسا وأدمعا % % 9(@)(@@) % قد كان نام البين عن ظهورها % % وضم شتى شملها الموزعا % % 10(@)(@@) % فعاد منها مضرما ألهوبه % لا بد في طائره أن يقعا % % PageV01P1141 11(@)(@@) % من بمنى وأين جيران منى % كانت ثلاثا لا تكون أربعا % % 12(@)(@@) % راحوا فمن ضامن دين ما وفى % % وحالف بالبيت ما تورعا % % 13(@)(@@) % وفي الحدوج غاربون أقسموا % % لا تركوا شمسا تضيء مطلعا % % 14(@)(@@) % سعى بي الواشي إلى أميرهم % لا طاف إلا خائبا ولا سعى % % 15(@)(@@) % لا وأبي ظبية لولا طيفها % % ما استأذنتها مهجتي أن تهجعا % % 16(@)(@@) % ولا رجوت بسؤالي عندها % % جدوى سوى أن أشتكي فتسمعا % % 17(@)(@@) % يا صاحبي سر الهوى إذاعة % طرت خروق سرثا أن ترقعا % % 18(@)(@@) % إشرافة على قبا إشرافة % أو أجتهادا دعوة أن تسمعا % % 19(@)(@@) % يا طلقاء الغدر هل من عطفة % على أسير بالوفاء جمعا % % 20(@)(@@) % سلبتموني كبدا صحيحة % أمس فردوها علي قطعا % % PageV01P1142 21(@)(@@) % عدمت صبري فجزعت بعدكم % ثم ذهلت فعدمت الجزعا % % 22(@)(@@) % وأنت 
ms375	 يا ذات الهوى من بينهم % عهدك يوم وجرة ما صنعا % % 23(@)(@@) % لما ملكت بالخداع جسدي % % نقلت قلبي وسكنت الأضلعا % % 24(@)(@@) % وارتجعا إلي ليلة بحاجر % أن تم في الفائت أن يرتجعا % % 25(@)(@@) % قالوا ألكنا فوعظنا صخرة % لا يجد الغامز فيها مصدعا % % 26(@)(@@) % قلبا على العتب الرفيق مااعوى % % لحاجة فيك وسمعا ما وعى % % 27(@)(@@) % قلت فما ظنكما قالوا نرى % % أن ندع الدار لهم قلت دعا % % 28(@)(@@) % فهو مع اللوعة قلب ماجد % إذا أحس بالهوان نزعا % % 29(@)(@@) % قد باطن الناس وقد ظاهرهم % % وضره تغريره ونفعا % % 30(@)(@@) % وقلب الإخوان وافتلاهم % فلم يجد في خلة مستمتعا % % PageV01P1143 31(@)(@@) % بلى حمى الله العميد ما حمى % % عينا بجفن وسقاه ورعى % % 32(@)(@@) % وصان منه للعلا منبتها الز % اكي وشرع دينها المتعبا % % 33(@)(@@) % والواحد الباقي في أبنائها % % والثكل قد أوجعها فيهم معا % % 34(@)(@@) % ضم فلول الفضل حتى أجتمعت % مفرق من ماله ما اجتمعا % % 35(@)(@@) % وانشر الجود الدفين مطلق ال % % كف إذا أعطى ابتداء أتبعا % % 36(@)(@@) % ودبر الأيام مرتاضا بها % % فلقبته الناهض المضطلعا % % 37(@)(@@) % وفى بما سن الكرام في الندى % % ثم استقل فعلهم فابتدعا % % 38(@)(@@) % من طينة مصمتة طائية % يطبعها المجد على ما طبعا % % 39(@)(@@) % خلى الرجال حلبة الجود لها % % والبأس قداما وجاءوا تبعا % % 40(@)(@@) % ومر منها واحد مع اسمه % يفضح كل من سخا أو شجعا % % PageV01P1144 41(@)(@@) % ولا ومن أولدهم محمدا % واختاره من غصنهم وأفرعا % % 42(@)(@@) % ما خلت أن يبصر ضوء كوكب % من هالة البدر ابيه اوسعا % % 43(@)(@@) % وأننا نغفل ذكر حاتم % في طيء ونذكر المزرعا % % 44(@)(@@) % حتى علت من بيته سحابة % جف لها ما قبلها وأقشعا % % 45(@)(@@) % وامطرت من العميد مزنة % عمت فما فات حياها موضعا % % 46(@)(@@) % صابت حساما ولسانا ويدا % بأيها شاء مضى فقطعا % % 47(@)(@@) % مد إلى أفق العلا فناله % يدا ترد كل كف إصبعا % % 48(@)(@@) % والتقط السودد من اغراضها % % فلم يدع لسهم رام منزعا % % 49(@)(@@) % تختصم الأقلام فيه والظبا % % كل يقول بي بدا ولي سعى % % 50(@)(@@) % ويدعيه الجود ما بينهما % % لنفسه فيعطيان ما ادعى % % PageV01P1145 51(@)(@@) % أيقظك التوفيق لي 
ms376	 وما أرى % % في الناس إلا الهاجع المضطجعا % % 52(@)(@@) % وأجفلت عني صروف زمني % % مذ قمت دوني بطلا مقنعا % % 53(@)(@@) % وغرت للمجد التليد أن ارى % % تقللا عندي أو تقنعا % % 54(@)(@@) % ملأت وطبي فمتى أقرى القرى % % لا أسق إلا مفعما أو مترعا % % 55(@)(@@) % وكنت في ظلك أبدي جانبا % من جادة البحر وأزكى مرتعا % % 56(@)(@@) % فما أبالي حالبات المزن أن % تفطمني بعدك أو أن ترضعا % % 57(@)(@@) % أغنيتني عن كل خلق أنفق ال % % نفاق في ابتياعه والخدعا % % 58(@)(@@) % وملك مستعبد بماله % أحط من عرضي له ما رتفعا % % 59(@)(@@) % غذا دعا مستصرخ برهطه % يدفع ضيم الدهر عنه مدفعا % % 60(@)(@@) % ناديت في تادي آل جعفر % على نوى الدار فكنت مسمعا % % PageV01P1146 61(@)(@@) % وبت أرعى من جنى إسعادكم % روضا أريضا وجنابا ممرعا % % 62(@)(@@) % لبست عيشي أخضرا أسحبه % بينكم وكان رثا أسفعا % % 63(@)(@@) % لياليا يحسبن أياما بكم % حسنا وأياما يخلن جمعا % % 64(@)(@@) % فإن شكوت أن حظي عاثر % بعدكم فقل لحظي لا لعا % % PageV01P1147 البحر : - 1(@)(@@) % بعثت لقلبي الهم يوم هويتكم % وبايعت عيني بالرقاد دموعا % % 2(@)(@@) % وكنت عزيزا لو عصيت خلاعتي % % وبت لنصح العاذلات مطيعا % % 3(@)(@@) % بحقكم لا تهجرون فإنني % % أملت إليكم جانبي جميعا % % PageV01P1148 البحر : - 1(@)(@@) % آنس برقا بالشريف لامعا % معتليا طورا وطورا خاضعا % % 2(@)(@@) % يخرق جنب الليل عن شمس الضحى % % ثم يغور فيعود واقعا % % 3(@)(@@) % كأن هندا فيه أو أترابها % % ترفع ثم تسدل البراقعا % % 4(@)(@@) % يزجي السحاب ينتضي صوارما % على عروق مزنه قواطعا % % 5(@)(@@) % بدا كهداب الرداء وسرى % % فسد من جو الغضا المطالعا % % 6(@)(@@) % فجاد نجدا ملقيا أفلاذه % لا خامرا نصحا ولا مصانعا % % 7(@)(@@) % يكسر فيها بالحيا صم الحصى % % ويبسط الأكم فيها أجارعا % % 8(@)(@@) % تخال بين مائه وتربها % % مواقع القطر بها مواقعا % % 9(@)(@@) % أطر للأرض سهاما لم يدع % جسم فلاة بحصاها دارعا % % 10(@)(@@) % هنيهة ما بين ان أرذها % % وبين ان فجرها ينابعا % % PageV01P1149 11(@)(@@) % فأحسنت عند الثرى صنيعها % % وإن أساءت عندنا الصنائعا % % 12(@)(@@) % استعلنت سر الهوى أيقظت % من عهد غمدان غراما هاجعا % % 13(@)(@@) % كأنما النافض عن قسيها % % نبل الحيا يستنفض الأضالعا % % 14 
ms377	(@)(@@) % يذكرنا من عيشنا على الحمى % % لياليا من بدره نواصعا % % 15(@)(@@) % مواضيا إن عاد ريعان الصبا % % أخضر عدن معه رواجعا % % 16(@)(@@) % كم ليلة بتنا بغير جنحها % % من ذهب الحلى وميضا صادعا % % 17(@)(@@) % تكتم منا ألسنا عوارما % تحت الدجى وأزرا خواشعا % % 18(@)(@@) % نفض مكتوم الحديث بيننا % % عن أرجات تبرد المضاجعا % % 19(@)(@@) % كأننا نرعى الخزامى واقعا % به الندى أو نرد الوقائعا % % 20(@)(@@) % نحفظ ما كان حديثا حسنا % منه وما أعجز كان ضائعا % % PageV01P1150 21(@)(@@) % مراكب للهو كنت غافلا أرتضع الدهر بها ضرورة ياسرعان ما فطمت راضعا % % لطرق عمري فوقهن قاطعاسقط بيت ص % % 22(@)(@@) % أستودع الأيام من مودتي % % لافظة لا تضبط الودائعا % % 23(@)(@@) % وراءها تعطيك أسنى خبها % % بنغضها رأسا مخشا مانعا % % 24(@)(@@) % معاطفا ما لن إلا يبسا % ومنطقا لم يحل إلا خادعا % % 25(@)(@@) % لو حفظت عهدي في ذخيرة % لم ألف يوما بالشباب فاجعا % % 26(@)(@@) % يا من اطار عامدا وعابثا % عن لمتي ذاك الغراب الواقعا % % 27(@)(@@) % ما سرني في مدلهم ليلها % % أني أرى نجومه طوالعا % % 28(@)(@@) % حمائل لعاتقي كن لما % % أقنصه حبائلا جوامعا % % 29(@)(@@) % فاليوم لا يعقلن إلا شاردا % مني ولا يعقلن إلا قاطعا % % 30(@)(@@) % رددن ما كان حبيبا رائقا % مني في العين بغيضا رائعا % % PageV01P1151 31(@)(@@) % ما خلت قبل الشيب أن مفرقا % رصع بالدر يذم الراصعا % % 32(@)(@@) % ما هي يا دهر وإن حملتها % % منك بأولى ما حملت ظالعا % % 33(@)(@@) % قد عرفت مطالبي غايتها % % وجاذبت حظوظها الموانعا % % 34(@)(@@) % وعلمت أن الكمال ذنبها % % وأن في النقص إليك شافعا % % 35(@)(@@) % يلوم في قناعتي ذو نطف % لو كان حر العرض كان قانعا % % 36(@)(@@) % عاد على خبائث من كسبه % عدو الذئاب اقترت المطامعا % % 37(@)(@@) % إن كنت تبغي بالهوان شبعا % فلا شبعت الدهر إلا جائعا % % 38(@)(@@) % ملكت نفسي فمنعت رسني % % ورحت منفوض اللجام خالعا % % 39(@)(@@) % لا فارس الضيم لظهري راكبا % ولا قطيع الذل جنبي قارعا % % 40(@)(@@) % آليت لا أصحب ذلا كارها % يوما ولا آمل رفدا طائعا % % PageV01P1152 41(@)(@@) % لله مذلول على رشاده % يعلم أن الحرص ليس نافعا % % 42(@)(@@) % قامر بدنياك وبعها مرخصا إن 
ms378	 عشت متبوعا بها محسدا أولا فمت ولا تكون تابعا % % بأبخس الأثمان تغبن بائعاسقط بيت ص % % 43(@)(@@) % في الناس من يعطيك من لسانه % شعشعة الآل أطباك لامعا % % 44(@)(@@) % يشعب أذنيك ويرعى لك في % % ضلوعه فلائقا صوادعا % % 45(@)(@@) % فإن ظفرت منهم بماجد % فاضرب به شولك تنجب فارعا % % 46(@)(@@) % واشدد عليه يد مفتون به % فليس إن أفلت منك راجعا % % 47(@)(@@) % حلفت بالمنقبات سوقها % % خوارجا من أهبها نزائعا % % 48(@)(@@) % نواحلا خضن الدجى صوامعا % ثم رجعن دقة أصابعا % % 49(@)(@@) % تعطي السرى من غير ذل أظهرا % حصا وأعناقا له خواضعا % % 50(@)(@@) % إذا رمت وراءها ببلدة % أمست لأخرى ظلعا نوازعا % % PageV01P1153 51(@)(@@) % تحسبها على الفلا طافية % مشرعات لجة قوالعا % % 52(@)(@@) % تحمل كل زاحم بنفسه % لذنبه المرمى المخوف الشاسعا % % 53(@)(@@) % يعطي الهجير حكمه من وجهه % حتى يرى بعد البياض سافعا % % 54(@)(@@) % يطلب أخراه بأخرى جهده % حتى يقوم قانتا وراكعا % % 55(@)(@@) % تحمل اشباحهم هدية % إلى منى طوارحا دوافعا % % 56(@)(@@) % وراش حالي فتحلقت به % من بعد ما كنت قصيصا واقعا % % 57(@)(@@) % وصرت لا أدفع عن باب العلا % % وكنت لا أعرف إلا دافعا % % 58(@)(@@) % أنصفني من الزمان حاكم % لم يبق للفضل نصيبا ضائعا % % 59(@)(@@) % أبلج أبقت خرزات الملك في % % جبينه خواتما طوابعا % % 60(@)(@@) % يورى شهاب النجح من خلالها % % لأعين العافين نورا ساطعا % % PageV01P1154 61(@)(@@) % غيران للسودد لا ترى له % على المحاماة عليه وازعا % % 62(@)(@@) % إذا غمزت عاسرتك صخرة % منه وتستمريه ماء مائعا % % 63(@)(@@) % لا تستطيع نقله عن خلقه % في الجود من ذا ينقل الطبائعا % % 64(@)(@@) % ينجو به أباؤه من أن يرى % % مضعضعا للنائبات خاضعا % % 65(@)(@@) % يلقى سرايا الدهر إن واقعها % % بمهجة عودها الوقائعا % % 66(@)(@@) % ولا ترى نفس فتى عزيزة % حتى يهين عندها الفجائعا % % 67(@)(@@) % إذا بنو عبد الرحيم شمخوا % % بأصلهم طال عليهم فارعا % % 68(@)(@@) % سادوا وجاء فاضلا فسادهم % والبدر يخفي الأنجم الطوالعا % % 69(@)(@@) % ثنى الرءوس المائلات نحوهم % وصير الناس لهم صنائعا % % 70(@)(@@) % أعطاهم سورة مجد لم أكن % في مثلها لمجد قوم طامعا % % PageV01P1155 71(@)(@@) % فلو ظفرت منهم بتابع % رائد نصحي أو ذلت سامعا % % 72 
ms379	(@)(@@) % لقلت شدوا الأزر عن نسائكم % وحرموا من بعده المراضعا % % 73(@)(@@) % كنت وأنت منهم أكرمهم % فضل السراة فاتت الأكارعا % % 74(@)(@@) % وضم ميلادك شمل فخرهم % كما تضم الراحة الأشاجعا % % 75(@)(@@) % وكلكم نال العلاء ناهضا % بنفسه طفلا وساد يافعا % % 76(@)(@@) % من معشر راضوا الزمان جذعا % وزينوا أيامه رواضعا % % 77(@)(@@) % واقتسموا الدنيا بأسيافهم % فاقتطعوها بينهم قطائعا % % 78(@)(@@) % إذا رضوا تمازحوا أو سخطوا % % لم يحسنوا في الغضب التقاذعا % % 79(@)(@@) % تلقى المعاذير بهم ضيقة % إذا استميحوا والعطاء واسعا % % 80(@)(@@) % سدوا خصاصات الثغور بالقنا % % وملكوا على العدا الشرائعا % % PageV01P1156 81(@)(@@) % وبعثوا غر زبرن جمهة % تحلب للأضياف سما ناقعا % % 82(@)(@@) % خرساء أو تسمع ما بين الظبا % % فيها وما بين الطلا قعاقعا % % 83(@)(@@) % يسترفد الطير بها وحش الفلا % % فترقد الكواسر الخوامعا % % 84(@)(@@) % تعير طخياء العجاج فوقها % % من صبغة الليل ضحاها الماتعا % % 85(@)(@@) % ترجع خمس الباترات بطنا % عنها وتروي الأسل الشوارعا % % 86(@)(@@) % إذا نهى النقع العيون جعلوا % % أبصارهم في نقعها المسامعا % % 87(@)(@@) % فاستصبحوا ظلماءها مناصلا % دوالقا وأنصلا دوالعا % % 88(@)(@@) % لا برحت آثارهم منصورة % بعزمتيك رافعا وواضعا % % 89(@)(@@) % ولا رأى الملك مكان نصره % وسره منك مباحا شائعا % % 90(@)(@@) % وقام من دون أماني العدا % % جدك عنك واقيا ودافعا % % PageV01P1157 91(@)(@@) % طالت لشكواك رقاب أصبحت % كفاية الله لها جوامعا % % 92(@)(@@) % وظن قوم فيك ما لا بلغوا % % أو تبلغ الأخامص الأخادعا % % 93(@)(@@) % داء من الأدواء كان هاجدا % فجاء مشتاقا إلأيك نازعا % % 94(@)(@@) % زار مليا ثم خاف غضبة % منك فولى خائفا مسارعا % % 95(@)(@@) % لم ينتقص دأبا ولم ينقض عرى % % عزم ولم يزعج جنانا وادعا % % 96(@)(@@) % حملته حملك أثقال العلا % % لا خائرا ولا نكولا ضارعا % % 97(@)(@@) % رب نفوس أرفدت من ألم % نفسك ما كن له جوازعا % % 98(@)(@@) % تود أن يحفظك الله لها % % ولو غدت مهملة ضوائعا % % 99(@)(@@) % ولا أقر الله عيني حاسد % رأى القذى برك والقوارعا % % 100(@)(@@) % ولا عفا حز المدى عن أنف % كنت لها بأن سلمت جادعا % % PageV01P1158 101(@)(@@) % ولا يرمك المهرجان عودا % % به السنون أبدا رواجعا % % 102(@)(@@) % طوالعا عليك من سعوده % بخير نجم غاربا وطالعا % % 103(@)(@@) % تحسب 
ms380	 من ملابس العز به % ذلاذلا لست لهن نازعا % % 104(@)(@@) % يكسى بأوصافك كل عاطل % منه فنون الكلم البدائعا % % 105(@)(@@) % من الغريبات يكن أبدا % مع الرياح شردا قواطعا % % 106(@)(@@) % إذا احتبى منشدهن خلته % يمانيا ينشر الوقائعا % % 107(@)(@@) % لم تخترق قبلي ولا تولجت % بمثلهن الألسن المسامعا % % 108(@)(@@) % عوانسا أودعتكم شبابها % % علما بتحصينكم الودائعا % % 109(@)(@@) % أبضعت فيكم عمري وعمرها % % يا لكرام أربحوا البضائعا % % 110(@)(@@) % قد بلغت آمالها فيكم فلا % % تنسوا لها الأرحام والذرائعا % % PageV01P1159 111(@)(@@) % كم حاسد دب لها عندكم % لو كان أفعى لم يضرها لاسعا % % 112(@)(@@) % إذا بقيتم ووفيتم لي فما % % شاء الزمان فليكن بي صانعا % % PageV01P1160 البحر : - 1(@)(@@) % دعوها ترد بعد خمس شروعا % % وراعوا علائقها والنسوعا % % 2(@)(@@) % ولا تحسبوا خطمها أن تطول ال % % حياض وأيديها أن تبوعا % % 3(@)(@@) % وقولوا دعاء لها لا عقرت % ولا امتد دهرك إلا ربيعا % % 4(@)(@@) % فقد حملت ونجت أنفسا % كرائم جبن الأماني سريعا % % 5(@)(@@) % حملن نشاوى بكأس الغرا % % م كل غدا لأخيه رضيعا % % 6(@)(@@) % أحبوا فرادى ولكنهم % على صيحة البين ماتوا جميعا % % 7(@)(@@) % حموا راحة النوم أجفانهم % وشدوا على الزفرات الضلوعا % % 8(@)(@@) % وباتوا بأيديهم يسندو % % ن فوق الرحال جنوبا وقوعا % % 9(@)(@@) % وفي الركب إن وصلوا لا حقين % عقائل يشعبن تلك الصدوعا % % 10(@)(@@) % من الراقصات بحب القلو % % ب حتى يكون الحليم الخليعا % % PageV01P1161 11(@)(@@) % قصائد لم يصطبغن المياه % ولم يحترشن اليرابيع جوعا % % 12(@)(@@) % إذا الحسب اعتن في خندق % مسحن ذوائبه والفروعا % % 13(@)(@@) % خرقن نفوسا لنا في السجوف % جعلن العيون عليها وقوعا % % 14(@)(@@) % وصافحنا بسباط البنا % % ن تخضب حناؤهن الدموعا % % 15(@)(@@) % هوى لك من منظر لو يدوم % % ومن آمر بالمنى لو أطيعا % % 16(@)(@@) % هبطن أشهي فظن العذول % وقد ذهب الوجد أن لا رجوعا % % 17(@)(@@) % ولا وهواك ابنة النهشلي % مازاد في البعد إلا ولوعا % % 18(@)(@@) % سقاك مهاة مروي العطاش % وحيا ربوعك عني ربوعا % % 19(@)(@@) % ضمنت لهن فلم آلهن % قلبك مروعا وعينا دموعا % % 20(@)(@@) % وقمت أناشدهن العهو % % د لو يستطعن الكلام الرجيعا % % PageV01P1162 21(@)(@@) % أسكان رامة هل من قرى % فقد دفع الليل ضيفا قنوعا % % 22(@)(@@) % كفاه 