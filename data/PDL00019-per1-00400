ms388	 حبذا بخت مساعد که سوی حضرت شاه %~% مردمی کرد و رهم داد پس از چندین گاه(@)(@@) 2 بعد ما کز سر حسرت همه روز افکندی %~% سخن رفتن و نارفتن من در افواه(@)(@@) 3 اندر آمد ز در حجره من صبحدمی %~% روز بهمنجنه یعنی دوم از بهمن ماه(@)(@@) 4 سال بر پانصد و سی و سه ز تاریخ عجم %~% گفت برخیز که از شهر برون شد همراه(@)(@@) 5 چه روی راه تردد قضی‌الامر فقم %~% چه کنی نقش تخیل بلغ السیل زباه(@)(@@) 6 چون برانگیخت مرا رفت و چراغی بفروخت %~% بی‌تحاشی چو رفیقی که بود از اشباه(@)(@@) 7 تا که من جامه بپوشیدم و بیرون رفتم %~% به شتابی که وداعم نه رهی کرد و نه راه(@)(@@) 8 او برون برد به در مفرش و آورد ستور %~% محملی بست مرا کرد چو شاهی بر گاه(@)(@@) 9 گفت ساکت شو و هشدار و به تعجیل براند %~% آنچنان کز ره و بی‌راه نبودم آگاه(@)(@@) 10 منتی داشتم از وی که ندارد به مثل %~% اعمی از چشم و فقیر از زر و عنین از باه(@)(@@) 11 اتفاقا به در رحبه بوفدی برسید %~% همه اعیان و بزرگان نشابور و هراه(@)(@@) 12 همچنین جمله راهم به سلامت می‌برد %~% نه در آن طبع ملالت نه در آن طوع اکراه(@)(@@) 13 تا به جایی که مرا داد همی مسحی و کفش %~% تا به حدی که همی داد خرم را جو و کاه(@)(@@) 14 خوف جیحون مگر اندر سخنم پیدا شد %~% که حدیثم همه ره بود ز انهار و میاه(@)(@@) 15 رخ به من کرد و مرا گفت کزین جوی مترس %~% ای ز ناجسته و ناگشته ز جویت آگاه(@)(@@) 16 به شنا کرد مرا گفت که این جوی ببین %~% ای بسا جسته و من دیده ز جوی و از چاه(@)(@@) 17 اندر آن عهد که تعلیم همی داد آنجا %~% کند کرت به زبان راند که ماشا الله(@)(@@) 18 بالله ار نیمه 
ms389	 این باشد جیحون صد بار %~% عبده پیش نبشتستست بدین جوی و فداه(@)(@@) 19 گفتم آری چو چنین است مرا باکی نیست %~% که ز ما منع نیاید ز شما استکراه(@)(@@) 20 چون به جیحون برسیدیم ز من هوش برفت %~% گفت لا حول و لا قوة الا بالله(@)(@@) 21 باز از آن ساده دلیهای حکیمان آورد %~% چه کنم تا نکند مصلحت خویش تباه(@)(@@) 22 رفت و بربست ازاری و به جیحون درجست %~% دست‌اندازان بگذشت به یک‌دم به شناه(@)(@@) 23 باز بازآمد و گفتا که بدیدی سهلست %~% درنشین خیز و مکن وقت گذشتن بی‌گاه(@)(@@) 24 کشتی آورد و نشستیم درو هر دو به هم %~% چون دو یار او همه یاری‌ده و من یاری‌خواه(@)(@@) 25 او چو شیری به یکی گوشه کشتی بنشست %~% من سر اندر زن و بیرون‌زن همچون روباه(@)(@@) 26 آخرالامر چو کشتی به سلامت بگذشت %~% جستم از کشتی و آمد به لب کشتی گاه(@)(@@) 27 عرصه‌ای دیدم چون جان و جوانی به خوشی %~% شادی‌افزای چو جان و چو جوانی غم‌کاه(@)(@@) 28 گفتم ای بخت بهشتست سواد ترمد %~% گفت راضی مشو از روضه رضوان به گیاه(@)(@@) 29 باش تا شهر ببینی و درو باد ملک %~% باش تا قلعه ببینی و درو عرض سپاه(@)(@@) 30 تا درین بودم گردی ز در شهر بخاست %~% گفتم آن چیست مرا گفت جنیبت‌کش شاه(@)(@@) 31 آفرین کردم بر شاه که اندر دو جهانش %~% آفریننده ز هر حادثه داراد نگاه(@)(@@) 32 آمد القصه و آورد جنیبت پیشم %~% دیده من چو در آن شکل و شبه کرد نگاه(@)(@@) 33 استری بود سیه زیر مغرق زینی %~% راست چون تیره شبی بسته برو یک شبه ماه(@)(@@) 34 بوسه دادم سم و زانو و رکابش هر سه %~% گفتم ای روز براق از تو چو رنگ تو سیاه(@)(@@) 35 به سعادت به سوی آخر خود باز خرام %~% که ترا پایه بلندست و مرا ره کوتاه(@)(@@) 36 این همی گفتم و او دست همی 
ms390	 کوفت که نی %~% ترک فرمان به همه روی گناهست گناه(@)(@@) 37 متنبه شدم و قصد عنانش کردم %~% بخت آنجا به من و پایه من کرد نگاه(@)(@@) 38 گفت ما را به در شاه فراموش مکن %~% که چو ماهست کنون گرد رکابت پنجاه(@)(@@) 39 گفتم آخر نه همانا که من آن‌کس باشم %~% که به پاداش چنین سعی کنم باد افراه(@)(@@) 40 کردمش خوشدل و پس پای درآوردم و راند %~% تا بدان سده که از سدره فزونست به جاه(@)(@@) 41 سده درگه اعلای خداوند جهان %~% که سلاطین جهان سجده برندش به جباه(@)(@@) 42 شاه حیدر دل هاشم تبع احمد نام %~% که ز گردونش سریرست و ز خورشید کلاه(@)(@@) 43 آنکه با خنجر او هست قضا کارافزای %~% وانکه در حضرت او هست قدر کارآگاه(@)(@@) 44 درشدم جان به طرب رقص‌کنان در پی بخت %~% گویی اندر سر من هوش نوایی زد و راه(@)(@@) 45 چون ازو حاجب بارم بستد مسکین گفت %~% آه آمد به سرم آنچه گمان بردم آه(@)(@@) 46 حاجبش گفت معاذالله ازو باز مگرد %~% ویحک آن رشته همه ساله چنین باد دوتاه(@)(@@) 47 هردو ما را به سر مائده بردند که چشم %~% تا نشد صایم ما زاغ نگفتند صلاه(@)(@@) 48 چو ز ابرام لبم دست ملک فارغ شد %~% گفت بختم خنکا موزه بنه کفش بخواه(@)(@@) 49 زین قدم من چو روی گشته و بختم چو ردیف %~% حالها نیز بگردد ز نسق گاه به گاه(@)(@@) 50 نه کلیمی تو برین کوه که گیری کم تیه %~% نه عزیزی تو درین مصر که گیری کم چاه(@)(@@) 51 بیتکی چند بخوان لایق این حال و برو %~% بر غلامان ملک تنگ چه داری خرگاه(@)(@@) 52 همچنان کردم و این شعر ادا کردم و رفت %~% جان از آن رجعت بر فور پر از واشوقاه(@)(@@) 53 پای یالیت ز پس دست مناجات ز پیش %~% کای بهستی تو بر هرچه وجودست گواه(@)(@@) 54 بخت بیدار ملک را ملکا دایم دار 
