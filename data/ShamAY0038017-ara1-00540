ms521	 نسبه أن يكون من أهل البصرة.(@)(@@) رباب(@)(@@) يروي عن: ابن عباس، روى عنه: تميم بن حدير.(@)(@@)(@@)(@@) ||| AUTO رابة(@)(@@) يروي عن: أبي هريرة، روى عبد الحميد بن جعفر، عن عبد الله بن أبي جعفر، عنه.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO رميثة بنت الحارث بن الطفيل بن سخبرة(@)(@@) تروي عن أم سلمة، روى عنها: أخوها عوف بن الحارث من حديث أهل المدينة، ورميثة هذه هي أم عبد الله بن محمد بن أبي عتيق.(@)(@@) رميثة(@)(@@) جدة القعقاع بن حكيم، تروي عن عائشة، روى عنها: القعقاع بن حكيم.(@)PageV01P002(@)(@@) [ج 2: ص 146](@)(@@)(@@)(@@) ||| AUTO أم الرائح بنت صليع اسمها الرباب(@)(@@) من أهل البصرة، تروي عن عمها سلمان، روت عنها: حفصة بنت سيرين.(@)(@@)(@@)(@@) ||| AUTO ربعية بنت عياض(@)(@@) تروي:(@)(@@) (132) -[2: 146] عن جدها عبيد بن عمرو الكلابي، قال: " رأيت النبي صلى الله عليه وسلم يسبغ الوضوء ". ثنا أبو يعلى، قال: ثنا عثمان بن أبي شيبة، قال: ثنا سعيد بن خثيم الهلالي، قال: حدثتني ربعية بنت عياض، عن جدها(@)(@@)(@@)(@@) ||| AUTO رهيمة خادم عثمان بن عفان(@)(@@) روى عنها: الزبير بن عبد الله بن رهيمة.(@)(@@)(@@)(@@) || AUTO باب الزاي(@)(@@) قال أبو حاتم:(@)(@@) وممن شافه الصحابة، ورآهم ممن ابتدأ اسمه على الزاي:(@)(@@)(@@)(@@) ||| AUTO زيد بن الحسن بن علي الهاشمي(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه حسن بن زيد، مات بالبطحاء على ستة أميال من المدينة، وأمه أم بشر بنت أبي مسعود عقبة بن عمرو، وكان للحسن بن علي منها زيد، وأم الحسن، وأم الحسين بن الحسن بن علي بن أبي طالب.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الله بن عمر بن الخطاب العدوي(@)(@@) يروي عن: ابن عمر، روى عنه: نافع، أمه أم ولد.(@)(@@)(@@)(@@) ||| AUTO زيد بن أسلم(@)(@@) مولى عمر بن الخطاب، كنيته أبو أسامة، يروي عن: ابن عمر، روى عنه: مالك، والناس، توفي في السنة التي استخلف أبو جعفر فيها PageV01P002 [ج 2: ص 147] في شهر ذي الحجة في العشر الأول من سنة ست وثلاثين ومائة، وأخوه خالد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الله بن خليدة الشيباني(@)(@@) يروي عن: ابن عمر، 
ms522	 روى عنه: أبو سنان.(@)(@@)(@@)(@@) ||| AUTO زيد بن أبي عتاب(@)(@@) مولى أم حبيبة، يروي عن: سعد، ومعاوية، روى عنه: ابن أبي ذئب، وموسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO زيد بن ثوب(@)(@@) يروي عن: علي، روى عنه: أبو بشر.(@)(@@)(@@)(@@) ||| AUTO زيد بن جارية الأنصاري(@)(@@) يروي عن: معاوية، روى عنه: حكيم بن ميناء.(@)(@@)(@@)(@@) ||| AUTO زيد بن عقبة(@)(@@) يروي عن: سمرة بن جندب، روى عنه: معبد بن خالد، وعبد الملك بن عمير، وابنه سعيد بن زيد.(@)(@@)(@@)(@@) ||| AUTO زيد بن جبير بن حرقل الجشمي(@)(@@) من بني جشم بن معاوية، عداده في أهل الكوفة، يروي عن: ابن عمر، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO زيد بن حصين(@)(@@) يروي عن: ابن عمر، روى عنه: المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO زيد بن حارثة(@)(@@) يروي المراسيل، روى عنه: علي بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO زيد بن خليدة اليشكري(@)(@@) كوفي، والد محمد بن زيد، يروي عن: ابن مسعود، روى عنه: ابنه.(@)PageV01P002(@)(@@) [ج 2: ص 148](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زيد بن دارة(@)(@@) مولى عثمان بن عفان، يروي عن: عثمان بن عفان، روى عنه: محمد بن عبد الله بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO زيد بن درهم(@)(@@) مولى جرير بن حازم الأزدي، من فوق، من أهل البصرة، وهو والد حماد بن زيد، يروي عن: أنس بن مالك، روى عنه: ابنه حماد بن زيد، وهو الذي يقال له: زيد بن أبي زياد.(@)(@@) زيد(@)(@@) جد الربيع بن أنس، يروي عن: أبي موسى الأشعري، روى عنه: الربيع بن أنس، وقد قيل: جد الربيع بن أنس زياد.(@)(@@)(@@)(@@) ||| AUTO زيد بن إسحاق(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبيد الله بن أبي جعفر، ويزيد بن أبي حبيب، وهو الذي روى عن عمر بن الخطاب: " أنه قضى في جارية رضعت على يدي رجل حتى تحيض فماتت، أنها من مال البائع "، من حديث عبيد الله بن أبي جعفر، عنه.(@)(@@)(@@)(@@) ||| AUTO زيد بن زائد(@)(@@) يروي عن: ابن مسعود، روى عنه: الوليد بن أبي هاشم.(@)(@@)(@@)(@@) ||| AUTO زيد بن سعد الهمداني(@)(@@) عداده في أهل الكوفة، يروي عن: حفصة، روى عنه: أبو 
ms523	 إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO زيد بن شراحة(@)(@@) يروي المراسيل، روى عنه: عاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO زيد بن أبي الشعثاء العنزي، وقد قيل: زيد أبو الحكم بن أبي الشعثاء(@)(@@) يروي عن: البراء بن عازب، روى عنه: أبو بلج.(@)(@@)(@@)(@@) ||| AUTO زيد بن صوحان بن حجر بن الهجرس بن صبرة(@)(@@) من عبد القيس، عداده في PageV01P002 [ج 2: ص 149] أهل الكوفة، كنيته أبو سليمان، ويقال: أبو عائشة، وقد قيل: أبو سلمان، يروي عن: عمر، روى عنه: أبو وائل، قتل يوم الجمل سنة ست وثلاثين، وكان قد قال لهم في ذلك اليوم: " شدوا علي ثيابي ولا تغسلوا عني دما، ولا تنزعوا عني ثوبا، فإنا قوم مخاصمون ". وهو أخو صعصعة بن صوحان.(@)(@@)(@@)(@@) ||| AUTO زيد بن صبحي(@)(@@) يروي عن: عقبة بن عامر، روى عنه: عياش بن عباس، ويقال: ابن صبيح.(@)(@@)(@@)(@@) ||| AUTO زيد بن طلحة التيمي(@)(@@) والد يعقوب بن زيد، يروي عن: ابن عباس، روى عنه: سعيد المقبري، والثوري.(@)(@@)(@@)(@@) ||| AUTO زيد بن علي: أبو القموص العبدي(@)(@@) يروي عن: طلحة بن عبيد الله، وطلحة بن عمرو البصري، روى عنه: قتادة، وعوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO زيد بن أبي عبس بن جبر الأنصاري البخاري المديني(@)(@@) يروي عن: أبيه، واسم أبي عبس عبد الرحمن بن جبر، روى عنه: ابنه ميمون بن زيد.(@)(@@)(@@)(@@) ||| AUTO زيد بن ظبيان الكوفي(@)(@@) يروي عن: أبي ذر، روى عنه: ربعي بن حراش.(@)(@@)(@@)(@@) ||| AUTO زيد بن علي بن حسين بن علي بن أبي طالب(@)(@@) أخو محمد، وحسين ابنا على، ورأى جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: ولده، قتل سنة ثنتين وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO زيد بن وهب الجهني الهمداني، كنيته أبو سليمان(@)(@@) عداده PageV01P002 [ج 2: ص 150] في أهل الكوفة، يروي عن: عمر وعبد الله، روى عنه: منصور، والأعمش، مات سنة ست وتسعين، وكان يصفر لحيته.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زيد بن المعلى(@)(@@) يروي عن: أنس، روى عنه: المعتمر بن سليمان،(@)(@@) (133) -[2: 150] قال: ثنا ابن قتيبة، ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، عن زيد بن المعلى، قال: رأيت أنس بن 
ms524	 مالك توضأ يخلل لحيته(@)(@@)(@@)(@@) ||| AUTO زيد أبو عمر(@)(@@) يروي عن: أنس، روى عنه: زيد بن أبي أنيسة.(@)(@@) زيد(@)(@@) مولى الليثيين، يروي عن: أبي هريرة، روى عنه: ابنه أسامة بن زيد المدني.(@)(@@)(@@)(@@) ||| AUTO زيد بن يثيع الهمداني(@)(@@) كوفي، يروي عن: علي، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO زيد أبو عياش(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: عبد الله بن يزيد مولى الأسود بن سفيان.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الرحمن(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: موسى بن عبيدة، أحسبه ابن أبي عبس الأنصاري.(@)(@@) زيد(@)(@@) يروي عن: عائشة، روى عنه: ابنه عمران بن زيد.(@)(@@)(@@)(@@) ||| AUTO زياد بن حدير الأسدي الكوفي، كنيته أبو المغيرة(@)(@@) يروي عن: عمر، روى عنه: الشعبي، وقد قيل: كنيته أبو عبد الرحمن.(@)PageV01P002(@)(@@) [ج 2: ص 151](@)(@@)(@@)(@@) ||| AUTO زياد بن ثويب(@)(@@) يروي عن: أبي هريرة، روى عنه: عاصم بن عبيد الله العمري.(@)(@@)(@@)(@@) ||| AUTO زياد بن أنعم الشعباني(@)(@@) مصري، يروي عن: أبي أيوب الأنصاري، كان أصله من إفريقية، روى عنه: ابنه عبد الرحمن بن زياد بن أنعم الإفريقي، الأب ثقة، والابن ضعيف.(@)(@@)(@@)(@@) ||| AUTO زياد بن جارية التميمي الدمشقي(@)(@@) يروي عن: حبيب بن مسلمة الفهري، روى عنه: أهل الشام، ومكحول، ومن قال: يزيد بن جارية فقد وهم.(@)(@@)(@@)(@@) ||| AUTO زياد بن ثوبان(@)(@@) لقبه بضعة، من أهل المدينة، يروي عن: أبي هريرة، روى عنه: نافع، وعمر بن نافع، من حديث عبيد الله بن عمر.(@)(@@) (134) -[2: 151] حدثنا علي بن إبراهيم ببلد، ثنا محمد بن إسماعيل الترمذي، قال: ثنا أيوب بن سليمان بن بلال، قال: حدثني أبو بكر بن أبي أويس، عن عبيد الله بن عمر، عن عمر بن نافع، عن بضعة، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: " لا يغرنكم فاجر في نعمة، فإن له عند الله قائلا لا يموت {كلما خبت زدناهم سعيرا} "(@)(@@) (135) -[2: 151] وبإسناده، قال: قال رسول الله صلى الله عليه وسلم: " الدنيا حلوة خضرة، فمن أخذها بحقها بورك له فيها، ورب متخوض في مال الله ورسوله له النار يوم 
ms525	 القيامة "(@)(@@)(@@)(@@) ||| AUTO زياد بن مطر(@)(@@) يروي عن: أبي هريرة، روى عنه: غيلان بن جرير.(@)(@@)(@@)(@@) ||| AUTO زياد بن جبير بن حية الثقفي(@)(@@) يروي عن: ابن عمر، روى عنه: يونس بن عبيد وابن عون.(@)(@@)(@@)(@@) ||| AUTO زياد بن جبل، ويقال: ابن حبل(@)(@@) يروي عن: أبي كعب، وابن الزبير، روى عنه: معمر، وأمية بن شبل الصنعاني.(@)PageV01P002(@)(@@) [ج 2: ص 152](@)(@@)(@@)(@@) ||| AUTO زياد بن أبي الجعد الغطفاني(@)(@@) أخو سالم بن أبي الجعد، وعبيد، وعبد الله بني أبي الجعد، واسم أبي الجعد رافع، يروي زياد عن: وابصة بن معبد، روى عنه: هلال بن يساف، وعبيد بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO زياد بن حزن بن مخارق الزبيدي(@)(@@) بعثه عمر مع عمرو بن العاص إلى فلسطين، روى عنه: القاسم بن قزمان.(@)(@@)(@@)(@@) ||| AUTO زياد الجعفي(@)(@@) يروي عن: جده، عن النبي صلى الله عليه وسلم روى عنه: أبو يعفور العبدي.(@)(@@)(@@)(@@) ||| AUTO زياد بن رياح القيسي أبو قيس(@)(@@) يروي عن: أبي هريرة، روى عنه: الحسن، وغيلان بن جرير.(@)(@@)(@@)(@@) ||| AUTO زياد أبو رشدين(@)(@@) يروي عن: عقبة بن عامر، روى عنه: النعمان الجندي.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي زياد(@)(@@) مولى عبد الله بن عياش بن أبي ربيعة المخزومي القرشي المدني، كان عابدا زاهدا، واسم أبي زياد ميسرة، يروي عن: جابر بن عبد الله، وأنس بن مالك، روى عنه: مالك بن أنس، وعمرو بن يحيى المازني.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي زاذان(@)(@@) مولى بني هلال فخذ من النخع، عداده في أهل الكوفة، كنيته أبو الأشهب، يروي عن: ابن عمر، روى عنه: عبد الله بن إدريس، وهو الذي يقال له: زياد بن زاذان.(@)(@@)(@@)(@@) ||| AUTO زياد بن سيمين كوش(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: طاوس من حديث ليث بن أبي سليم.(@)(@@)(@@)(@@) ||| AUTO زياد بن سعد(@)(@@) يروي عن: أبي هريرة، روى عنه: الحارث بن فضيل.(@)PageV01P002(@)(@@) [ج 2: ص 153](@)(@@)(@@)(@@) ||| AUTO زياد(@)(@@) مولى سعد، يروي عن: ابن عباس، روى عنه: بكير بن مسمار.(@)(@@)(@@)(@@) ||| AUTO زياد بن طارق(@)(@@) كوفي، يروي عن: علي، روى عنه: إبراهيم بن عبد الأعلى.(@)(@@)(@@)(@@) ||| AUTO زياد بن سيار(@)(@@) مولى 
ms526	 أبي قرصافة الكناني، من أهل الشام، يروي عن: أبي قرصافة، واسمه جندرة بن خيشنة، روى عنه: الطيب بن زبان، وكان يسكن قرية يقال لها: سناجية، من كور الرملة.(@)(@@)(@@)(@@) ||| AUTO زياد بن صبيح الحنفي(@)(@@) يروي عن: ابن عمر، روى عنه: سعيد بن زياد، وهو الذي يروي عنه: يزيد بن أبي زياد، ويقال: زياد بن صباح.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الله النميري(@)(@@) بصري، يروي عن: أنس بن مالك، روى عنه: سهيل بن أبي صالح، وعمارة بن زاذان، يخطئ، وكان من العباد.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الله بن حدير الأسدي(@)(@@) يروي عن: أوس، روى عنه: داود بن أبي هند.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الله النخعي(@)(@@) يروي عن: علي، روى الشيباني، عن شيخ له، عنه.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الرحمن أبو الخصيب القيسي(@)(@@) من بني قيس بن ثعلبة، عداده في أهل البصرة، يروي عن: ابن عمر، روى عنه: عقيل بن طلحة.(@)(@@)(@@)(@@) ||| AUTO زياد بن عمرو الفهري القرشي، ويقال: ابن عمر(@)(@@) يروي عن: ابن عباس، روى عنه: يحيى بن عبد الرحمن بن حاطب.(@)PageV01P002(@)(@@) [ج 2: ص 154](@)(@@)(@@)(@@) ||| AUTO زياد بن عبيد القيضي(@)(@@) وقيض: بطن من حمير، يروي عن: رويفع بن ثابت البلوي، روى عنه: حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO زياد أبو عمر(@)(@@) يروي عن أنس بن مالك: " أصيحابي أصيحابي "، روى عنه: أبو حمزة السكري، والحسين بن واقد.(@)(@@)(@@)(@@) ||| AUTO زياد بن حرد(@)(@@) يروي عن عمرو بن العاص: " تقتل عمارا الفئة الباغية "، روى عنه: عمرو بن دينار السمكي.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبيدة(@)(@@) يروي عن: أنس بن مالك، روى عنه: مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO زياد بن سمير(@)(@@) يروي عن: ابن عمر، روى عنه: طاوس.(@)(@@)(@@)(@@) ||| AUTO زياد بن سليم(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو المحجل.(@)(@@)(@@)(@@) ||| AUTO زياد أبو الأوبر(@)(@@) يروي عن: أبي هريرة، روى عنه: أهل العراق.(@)(@@) (136) -[2: 154] حدثنا أبو قتيبة، ثنا ابن أبي السري، ثنا معتمر بن سليمان، قال: ثنا ليث بن أبي سليم، عن زياد، عن أبي هريرة، أن النبي صلى الله عليه وسلم قال: " أمرت أن أقاتل 
ms527	 الناس حتى يقولوا: لا إله إلا الله، فإذا قالوا: لا إله إلا الله، فقد عصموا مني دماءهم، وأموالهم إلا بحقها وحسابهم على الله "(@)(@@)(@@)(@@) ||| AUTO زياد بن نعيم الحضرمي(@)(@@) مصري، يروي عن: زياد بن الحارث الصدائي، روى عنه: بكر بن سوادة، والإفريقي.(@)PageV01P002(@)(@@) [ج 2: ص 155](@)(@@)(@@)(@@) ||| AUTO زياد بن عدي(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو العالية.(@)(@@)(@@)(@@) ||| AUTO زياد بن عياض(@)(@@) ختن أبي موسى الأشعري، يروي عن: عمر، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO زياد بن علاقة بن مالك الثعلبي الكوفي(@)(@@) يروي عن: أسامة بن شريك، وجرير بن عبد الله، والمغيرة بن شعبة، وعمه قطبة بن مالك، روى عنه: الثوري، وشعبة والناس.(@)(@@)(@@)(@@) ||| AUTO زياد بن حذيم بن عمرو السعدي(@)(@@) يروي عن: أبيه وله صحبة، روى عنه: ابنه موسى بن زياد.(@)(@@)(@@)(@@) ||| AUTO زياد بن قيس المدني(@)(@@) مولى لقريش، عن: أبي هريرة، روى عنه: عاصم بن بهدلة.(@)(@@)(@@)(@@) ||| AUTO زياد بن ميناء(@)(@@) يروي عن: أبي سعد بن أبي فضالة الأنصاري، كان من الصحابة، روى عبد الحميد بن جعفر عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO زياد بن فيروز البصري، أبو العالية(@)(@@) يروي عن: ابن عمر، وابن الزبير، روى عنه: عاصم الأحول، ويقال: إن اسم أبي العالية: أذينة، وقد قيل: اسمه كلثوم، مولى لقريش، مات يوم الإثنين في شهر شوال سنة تسعين.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي المغيرة(@)(@@) واسم أبي المغيرة الحارث، يروي عن: أبي هريرة، روى عنه: ليث بن أبي سليم.(@)PageV01P002(@)(@@) [ج 2: ص 156](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زياد بن كسيب العدوي(@)(@@) من أهل البصرة، يروي عن: أبي بكرة، روى عنه: سعد بن أوس.(@)(@@) (137) -[2: 156] ثنا عمرو بن محمد الهمداني، قال: ثنا يزيد بن أخزم، قال: ثنا أبو داود الطيالسي، عن حميد بن مهران، عن سعد بن أوس، عن زياد بن كسيب، عن أبي بكرة، عن النبي صلى الله عليه وسلم قال: " من أهان سلطان الله أهانه الله "(@)(@@) زياد(@)(@@) مولى بني مخزوم، كوفي، يروي عن: أبي هريرة، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO زياد بن مطر بن شريح العدوي(@)(@@) من أهل البصرة، يروي عن: 
ms528	 عمر، روى عنه: ابنه العلاء بن زياد، هو وابنه عابدان زاهدان خيران فاضلان.(@)(@@)(@@)(@@) ||| AUTO زياد بن مالك(@)(@@) يروي عن: ابن مسعود ولم يسمع منه، قال: القارن يطوف طوافين، روى عنه: الحكم.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي مريم(@)(@@) مولى عثمان بن عفان، يروي عن: أبي موسى الأشعري، روى عنه: ميمون بن مهران، واسم أبي مريم: الجراح، وهو الذي يروي عن: عبد الله بن معقل، " الندم: توبة ".(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي سودة(@)(@@) أخو عثمان بن أبي سودة، من أهل بيت المقدس، كنيته أبو نصر، أمهما مولاة لعبادة بن الصامت، وأبوهما مولى لعبد الله بن عمرو بن العاص، يروي عن: عبادة بن الصامت، روى عنه: زيد بن واقد، وأهل الشام.(@)(@@) (138) -[2: 156] ثنا الصوفي، قال: ثنا أبو نصر التمار، قال: ثنا سعيد بن عبد العزيز، عن زياد بن أبي سودة، أن عبادة بن الصامت قعد على سور بيت المقدس الشرقي يبكي، فقال بعضهم: ما يبكيك يا أبا الوليد؟ قال: " من هاهنا أخبرنا رسول الله أنه رأى جهنم "(@)PageV01P002(@)(@@) [ج 2: ص 157](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زياد(@)(@@) مولى عمرو بن العاص، يروي عن: عمرو بن العاص، روى عنه: عمرو بن دينار.(@)(@@) زياد(@)(@@) مولى عثمان بن عفان، يروي عن: عثمان بن عفان، روى عنه: ابنه هشام بن زياد، وهشام ضعيف.(@)(@@)(@@)(@@) ||| AUTO زياد أبو يحيى الأنصاري(@)(@@) من أهل مكة، يروي عن: ابن عباس، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO زياد بن يزيد(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عبد الرحمن بن عوف الزهري(@)(@@) يروي عن: أبيه، روى عنه: أهل المدينة، قتل يوم الحرة سنة ثلاث وستين.(@)(@@)(@@)(@@) ||| AUTO الزبير بن أبي أسيد الساعدي الأنصاري المدني(@)(@@) أخو حمزة بن أبي أسيد، وأبو أسيد شهد بدرا، يروي عن: أبيه، روى عنه: ابن الغسيل.(@)(@@)(@@)(@@) ||| AUTO الزبير بن الوليد(@)(@@) يروي عن: ابن عمر، روى عنه: شريح بن عبيد الحضرمي.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عربي، كنيته أبو سلمة(@)(@@) يروي عن: ابن عمر، روى عنه: حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO الزبير بن الصراف(@)(@@) من 
ms529	 أهل البصرة، يروي عن: عبد الله بن مغفل، روى عنه: ابنه عمرو بن الزبير.(@)PageV01P002(@)(@@) [ج 2: ص 158](@)(@@)(@@)(@@) ||| AUTO الزبير بن عبد الرحمن بن الزبير(@)(@@) من أهل المدينة، يروي عن: رفاعة بن سموأل وله صحبة، روى عنه: مسور بن رفاعة القرظي.(@)(@@)(@@)(@@) ||| AUTO الزبير بن لوط بن عازب(@)(@@) يروي عن: عمه البراء بن عازب، روى عنه: منصور بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عدي الهمداني اليامي، كنيته أبو عدي(@)(@@) من أهل الكوفة، سكن الري، يروي عن: أنس بن مالك، روى عنه: أهل الكوفة، حدث عنه: بشر بن الحسين الأصبهاني، كأن الأرض أخرجت له أفلاذ كبدها، في حديثه شيء لا ينظر في شيء، ولا يروي عنه إلا على جهة التعجب، مات الزبير بالري سنة إحدى وثلاثين ومائة، وكان من العباد، وصلى عليه نباتة بن حنظلة عامل الري.(@)(@@)(@@)(@@) ||| AUTO الزبير بن خريق(@)(@@) يروي عن: أبي أمامة، روى عنه: عروة بن دينار.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عبد الله العنسي(@)(@@) يروي المراسيل، روى عنه: عبد الرحمن بن جبير بن نفير.(@)(@@)(@@)(@@) ||| AUTO زكريا بن أبي مريم الخزاعي(@)(@@) يروي عن: أبي أمامة، روى عنه: هشيم إن لم يكن دلس عنه.(@)(@@)(@@)(@@) ||| AUTO زهير بن حيان(@)(@@) يروي عن: ابن عباس، روى عنه: حميد بن هلال.(@)(@@)(@@)(@@) ||| AUTO زهير بن عثمان الثقفي(@)(@@) يروي عن: رجل من أصحاب رسول الله صلى الله عليه وسلم PageV01P002 [ج 2: ص 159] روى عنه: الحسن.(@)(@@)(@@)(@@) ||| AUTO زهير بن عمرو(@)(@@) يروي المراسيل، روى عنه: أبو عثمان النهدي.(@)(@@)(@@)(@@) ||| AUTO زهير بن ماهان(@)(@@) يروي عن: البراء بن عازب، روى عنه: عروة بن الحارث الشامي.(@)(@@)(@@)(@@) ||| AUTO زهير بن منقذ(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الله بن ميمون القداح.(@)(@@)(@@)(@@) ||| AUTO زهير بن علقمة(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أسلم المنقري.(@)(@@)(@@)(@@) ||| AUTO زهير بن عبد الله(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أبو عمران الجوني، وسمع أنس بن مالك.(@)(@@)(@@)(@@) ||| AUTO زهير بن الأقمر(@)(@@) كوفي، يروي عن: الحسن بن علي، روى عنه: عبد 
ms530	 الله بن الحارث، وقيل: إنه أبو كثير الزبيدي.(@)(@@)(@@)(@@) ||| AUTO زهير بن الأصبغ العامري(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: ابنه عطاء.(@)(@@)(@@)(@@) ||| AUTO زهير بن مالك، أبو الوازع الراسبي(@)(@@) يروي عن: ابن عمر، روى عنه: إسرائيل.(@)(@@)(@@)(@@) ||| AUTO زفر بن الحارث الكلابي(@)(@@) من أهل الشام، والد مزاحم بن زفر، يروي عن: عائشة ومعاوية، روى عنه: ثابت بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO زفر بن وثيمة بن مالك بن أوس بن الحدثان النصري(@)(@@) يروي عن PageV01P002 [ج 2: ص 160]: حكيم بن حزام إن سمع منه، روى عنه: الشعيثي.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زائدة بن عمير الطائي(@)(@@) يروي عن: ابن عباس، روى عنه: شعبة ويونس بن أبي إسحاق.(@)(@@) زائدة(@)(@@) مولى عثمان، يروي عن: سعد بن أبي وقاص، روى عنه: أبو الزناد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الزبرقان بن عبد الله بن مازن(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن الربيع بن كعب.(@)(@@)(@@)(@@) ||| AUTO الزبرقان بن عبد الله الليثي(@)(@@) يروي عن: ابن عمر، روى عنه: ابن أبي الموالي.(@)(@@) الزبرقان(@)(@@) يروي عن: عمه عمرو بن أمية الضمري، روى عنه: كليب بن صبح.(@)(@@) الزبرقان(@)(@@) شيخ، يروي عن: النواس بن سمعان، روى داود بن أبي هند، عن شهر بن حوشب، عنه، لا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زاذان(@)(@@) مولى كندة، يروي عن: علي، وابن مسعود، وابن عمر، روى عنه: ذكوان أبو صالح، وعمرو بن مرة، وعبد الله بن السائب، وهو زاذان أبو عمر الذي يحدث، عن: البراء بن عازب، يخطئ كثيرا، مات بعد الجماجم.(@)(@@) (139) -[2: 160] ثنا محمد بن إسحاق الثقفي، قال: ثنا محمد بن أحمد بن أبي خلف، قال: ثنا إسحاق بن منصور السلولي، قال: ثنا محمد بن طلحة، عن محمد بن جحادة، قال: " كان زاذان يبيع الكرابيس، فإذا جاءه المشتري عرض عليه شر الطرفين وساومه سومة واحدة "(@)(@@) زاذان(@)(@@) والد منصور بن زاذان، مولى عبد الله بن أبي عقيل الثقفي، كنيته أبو PageV01P002 [ج 2: ص 161] المغيرة، يروي عن: الحسن بن علي، روى عنه: هشيم.(@)(@@)(@@)(@@) ||| AUTO زرارة بن أوفى العامري(@)(@@) يروي عن: عمران 
ms531	 بن حصين، وأبي هريرة، وعبد الله بن سلام، كنيته أبو حاجب الحرشي، كان على قضاء البصرة، مات في ولاية عبد الملك بن مروان فجأة في أول قدوم الحجاج العراق قبل ابن سيرين، وكان من العباد، وقد قيل: إن زرارة مات سنة ثلاث وتسعين.(@)(@@) (140) -[2: 161] حدثني عمران بن موسى السختياني، قال: ثنا هدبة بن خالد، قال: ثنا أبو خباب القصاب، قال: أمنا زرارة بن أوفى في مسجد بني قشير فلما بلغ {فإذا نقر في الناقور}، خر ميتا "(@)(@@)(@@)(@@) ||| AUTO زرارة بن مصعب بن شيبة(@)(@@) يروي عن: ابن الزبير، روى عنه: ابنه عبد الله بن زرارة من حديث ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO زرارة بن مصعب بن عبد الرحمن بن عوف(@)(@@) يروي عن: المسور بن مخرمة، روى عنه: الزهري.(@)(@@) (141) -[2: 161] ثنا عمرو بن محمد الهمداني، قال: ثنا الفضل بن سهل الأعرج، قال: ثنا يعقوب بن إبراهيم بن سعد، قال: ثنا أبي بن صالح، عن ابن شهاب، قال: ثنا زرارة بن مصعب بن عبد الرحمن بن عوف، عن المسور بن مخرمة، أخبره، أن عبد الرحمن بن عوف، أخبره، أنه " حرس ليلة مع عمر بن الخطاب، فبينا هم يمشون شب لهم سراج في بيت، فانطلقوا يؤمونه حتى إذا دنوا منه إذا باب البيت مجاف على قوم لهم أصوات مرتفعة ولغط، فقال: عمر وأخذ بيد عبد الرحمن، فقال: أتدري بيت من هو، فقال: هذا بيت ربيعة بن أمية بن خلف وهم الآن في شرب، قال: فماذا ترى؟ قال عبد الرحمن: أرى إنا قد أتينا ما نهينا عنه، قال الله تعالى {ولا تجسسوا}، فانصرف عنهم وتركهم "(@)(@@)(@@)(@@) ||| AUTO زرارة بن جزي(@)(@@) قد قيل نحبي، يروي عن: المغيرة بن شعبة، روى عنه: مكحول.(@)(@@)(@@)(@@) ||| AUTO زرارة بن كريم بن الحارث بن عمرو السهمي(@)(@@) يروي عن: الحارث بن PageV01P002 [ج 2: ص 162] عمرو، أنه أتى النبي صلى الله عليه وسلم روى عنه: عتبة بن عبد الملك السهمي، ومن زعم أن له صحبة فقد وهم.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زرعة بن ثوب(@)(@@) والد ضمضم بن زرعة، من أهل الشام، ولي 
ms532	 القضاء بدمشق زمن الوليد بن عبد الملك، وكان لا يأخذ على القضاء أجرا، يروي عن: ابن عمر، روى عنه: عامر بن جشيب.(@)(@@)(@@)(@@) ||| AUTO زرعة بن عبد الرحمن بن جرهد الأسلمي(@)(@@) من أهل المدينة، يروي عن: جرهد، روى عنه: أبو الزناد، وسالم أبو النضر، ومن زعم أنه زرعة بن مسلم بن جرهد فقد وهم، وقد قيل: روى قتادة، عن زرعة بن عبد الرحمن، عن راشد بن حبيش، عن عبادة بن الصامت.(@)(@@)(@@)(@@) ||| AUTO زرعة بن حصين بن سياه(@)(@@) أخو محمد، وسليمان، يروي عن: جدتهم أم سنبلة أنها أتت النبي صلى الله عليه وسلم بهدية، روى عنه: عمرو بن قيظى بن عمرو بن شداد.(@)(@@)(@@)(@@) ||| AUTO زرعة أبو عبد الرحمن(@)(@@) يروي عن: ابن عباس، روى عنه: مالك بن مغول.(@)(@@) زرعة(@)(@@) يروي عن: ابن عباس، روى عنه: حيان بن عمير.(@)(@@)(@@)(@@) ||| AUTO زر بن حبيش الأسدي(@)(@@) من أهل الكوفة، من بني غاضرة، كنيته أبو مريم، وقد قيل: أبو مطرف، يروي عن: عمر، وعلي، روى عنه: أهل الكوفة، مات بها سنة ثنتين وثمانين قبل الجماجم، وهو ابن اثنتين وعشرين ومائة سنة، وكان من أعرب الناس، وكان عبد الله بن مسعود يسأله عن العربية.(@)PageV01P002(@)(@@) [ج 2: ص 163](@)(@@)(@@)(@@) ||| AUTO زهرة بن حوية السعدي(@)(@@) يروي عن: جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO زاجر بن الصلت البصري(@)(@@) أصله يماني، يروي عن: ابن عباس، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO زهدم بن الحارث الغفاري(@)(@@) يروي عن: ابن عمر، عداده في أهل البصرة، روى عنه: ابنه يحيى بن زهدم.(@)(@@)(@@)(@@) ||| AUTO زهدم بن مضرب الجرمي(@)(@@) بصري، يروي عن: ابن عباس، وعمران بن حصين، روى عنه: قتادة، وأبو جمرة.(@)(@@)(@@)(@@) ||| AUTO زحر بن قيس(@)(@@) خرج حين أصيب علي، إلى المدائن، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO زبيد بن الصلت بن معاوية بن حجر بن معاوية بن الحارث بن ثور(@)(@@) وهو من كندة، كنيته أبو كثير، وقد قيل: أبو عبد الله حليف بني جمح، وهو أخو كثير بن الصلت، يروي عن: عمر، روى عنه: 
ms533	 عروة بن الزبير، وقتادة، يقال: إنه ولد في عهد رسول الله صلى الله عليه وسلم زامل بن أوس الطائي،(@)(@@)(@@)(@@) ||| AUTO يروي عن: أبي هريرة، روى عنه: ابنه عصمة بن زامل بن أوس الطائي.(@)(@@) زربى،(@)(@@)(@@)(@@) ||| AUTO يروي عن: البراء، روى عنه: ابنه إسماعيل بن زربى.(@)(@@) زيادة بن عبد الله بن زيد بن مربع الأنصاري،(@)(@@)(@@)(@@) ||| AUTO من بني حارثة، أخو علاقة بن عبد الله، عداده في أهل المدينة، يروي عن: سهل بن سعد، روى عنه: كثير بن جعفر.(@)(@@) زريق بن حيان الفزاري شامي، يروي عن: رجل من أصحاب PageV01P002 [ج 2: ص 164] النبي صلى الله عليه وسلم روى عنه: أهل الشام، توفي بنيقية من أرض الروم، في إمارة يزيد بن عبد الملك من سهم أصابه وهو ابن ثمانين سنة.(@)(@@)(@@)(@@) ||| AUTO زغب بن عبد الله(@)(@@) يروي عن: عبد الله بن حوالة، روى عنه: ضمرة بن حبيب يغرب.(@)(@@)(@@)(@@) ||| AUTO زاجر بن الهيثم(@)(@@) يروي عن: ابن مسعود، روى عنه: يحيى بن عبيد الله بن قزعة البصري. النساء:(@)(@@)(@@)(@@) ||| AUTO زينب بنت كعب بن عجرة(@)(@@) تروي عن: الفريعة بنت مالك بن سنان ولها صحبة، روى عنها: سعد بن إسحاق بن كعب بن عجرة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زينب بنت أم سلمة(@)(@@) تروي عن: أم سلمة، روى عنها: عروة بن الزبير، وعراك بن مالك.(@)(@@) زينب بنت أم سلمة(@)(@@) تروي عن: أم سلمة، أن النبي صلى الله عليه وسلم أتي بكتف شاة فأكل منها، ثم صلى ولم يتوضأ. روى جعفر بن محمد، عن أبيه، عنها.(@)(@@)(@@)(@@) ||| AUTO زينب بنت نبيط(@)(@@) تروي عن: ضباعة بنت الزبير، روى عنها: حميد الطويل.(@)(@@)(@@)(@@) ||| AUTO زينب بنت أبي حازم(@)(@@) أخت قيس بن أبي حازم، قالت: دخل علي أبو بكر(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 165] الصديق وأنا مصمتة، فقال لي: تكلمي، إن هذا لا يصلح، إن هذا من عمل الجاهلية. قالت: فتكلمت، قاله: بيان، عن قيس، عن أخته زينب.(@)(@@)(@@)(@@) ||| AUTO زينب بنت عبد الله بن أنس بن مالك(@)(@@) تروي عن: جدها أنس بن مالك، عداده في أهل البصرة، روت عنها: يسيرة بنت 
ms534	 بشير بن مسعود.(@)(@@) زينب(@)(@@) (142) -[2: 165] سمعت عائشة، تقول: " لا أحل نبيذ حنتم، ولا نقير، ولا دباء، ولا مزفت، ولا أحرم إلا ما حرم الله ". رواه يحيى بن سعيد القطان، عن جابر بن صبح، عن عمتيه أنيسة، وزينب، عن عائشة(@)(@@)(@@)(@@) ||| AUTO زيدة بنت قيلة بنت مخرمة بن قرط(@)(@@) روت عنها: صفية، ودحيبة ابنتا عليبة.(@)(@@)(@@)(@@) || AUTO باب السين(@)(@@) قال أبو حاتم:(@)(@@) وممن سمع الصحابة، وروى عنهم ممن ابتدأ اسمه على السين:(@)(@@)(@@)(@@) ||| AUTO سعيد بن إياس، أبو عمرو الشيباني(@)(@@) حج في الجاهلية حجتين، وكان في أيام النبي صلى الله عليه وسلم صبيا يعقل، وليس له صحبة، يروي عن: عمر، وابن مسعود، روى عنه: الناس، حضر القادسية وهو ابن أربعين سنة، ومات بعد أن تم له عشرون ومائة سنة، وكانت القادسية سنة إحدى وعشرين، فكأنه مات سنة إحدى ومائة، قال أبو عمرو: كنت أسمع النبي صلى الله عليه وسلم وأنا أرعى إبلا لأهلي بكاظمة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن المسيب بن حزن بن أبي وهب بن عمرو بن عائذ بن عبد الله بن عمرو بن مخزوم بن يقظة المخزومي القرشي، كنيته أبو محمد(@)(@@) ولد لسنتين مضتا من خلافة عمر، وأم سعيد بن المسيب بنت عثمان بن حكيم بن أمية بن حارثة بن الأوقص بن مرة بن هلال بن فالج بن ذكوان السلمي، وكان من سادات التابعين فقها ودينا، وورعا، وعلما، وعبادة، وفضلا، وكان أبوه يتجر في الزيت، وكان سعيد سيد التابعين، وأفقه PageV01P002 [ج 2: ص 166] أهل الحجاز، وأعبر الناس للرؤيا، ما نودي بالصلاة أربعين سنة إلا وسعيد في المسجد ينتظرها، ويقال: " أنه ممن أصلح بين عثمان، وعلي، فلما بويع عبد الملك، وبايع للوليد، ولسليمان من بعده، وأخذ البيعة من الناس أبى سعيد ذلك فلم يبايع، فقال له عبد الرحمن بن عبد القاري: إنك تصلي بحيث يراك هشام بن إسماعيل، فلو غيرت مقامك حتى لا يراك، وكان هشام واليا على المدينة لعبد الملك، فقال سعيد: إني لم أغير مقاما قمته منذ أربعين سنة، قال: فاخرج معتمرا، قال: لم أكن 
ms535	 لأجهد بذلي وأنفق مالي في شيء ليس لي فيه نية، قال: فبايع إذا! قال: أرأيتك إن كان الله أعمى قلبك كما أعمى بصرك، فما علي وأبى أن يبايع، فكتب هشام بن إسماعيل إلى عبد الملك، فكتب عبد الملك إليه: ما دعاك إلى سعيد بن المسيب ما كان علينا منه شيء نكرهه، فأما إذا فعلت فادعه فإن بايع وإلا فاضربه ثلاثين سوطا وأوقفه للناس، فدعاه هشام فأباه، وقال: لست أبايع لاثنتين فضربه ثلاثين سوطا، ثم ألبسه ثيابا من شعر، وأمر به فطيف به حتى بلغوا به الحناطين، ثم ردده وأمر به إلى السجن، فقال سعيد: لولا أني ظننت أنه القتل ما لبسته قلت أستر عورتي عند الموت، مات سنة ثلاث أو أربع وتسعين، وكان يقال لهذه السنة سنة الفقهاء من كثرة من مات من الفقهاء فيها، وقد قيل أنه مات سنة خمس ومائة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن جبير بن هشام(@)(@@) مولى بني والبة بن الحارث من بني أسد بن خزيمة، يروي عن: ابن عمر، وابن عباس، وجماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: عمرو بن دينار، وأيوب، والناس، كنيته أبو عبد الله، وكان فقيها، عابدا، ورعا، فاضلا، وكان يكتب لعبد الله بن عتبة بن مسعود حيث كان على قضاء الكوفة، ثم كتب لأبي بردة بن أبي موسى حيث كان على قضائها، ثم خرج مع ابن الأشعث في جملة القراء، فلما هزم ابن الأشعث بدير الجماجم هرب سعيد بن جبير إلى مكة، فأخذه خالد بن عبد الله القسري بعد مدة، وكان واليا لعبد الملك على مكة، وبعث به إلى الحجاج، فقال له الحجاج: " اختر لنفسك أي قتلة شئت، فقال: اختره أنت فإن القصاص أمامك، فقتله الحجاج بن يوسف سنة خمس وتسعين، وهو ابن تسع وأربعين سنة، ثم مات الحجاج بعده بأيام، وكان مولد الحجاج سنة أربعين.(@)(@@) (143) -[2: 166] ثنا الحسن بن يوسف، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا وكيع، قال: ثنا سفيان، عن حماد بن أبي سليمان، قال: 
ms536	 سمعت سعيد بن جبير، يقول: قرأت القرآن في الكعبة في ليلة(@)(@@) (144) -[2: 166] أنبأ الصوفي ببغداد، قال: أنبأ أحمد بن إبراهيم الدورقي، قال: ثنا مسلم بن قتيبة، قال: ثنا PageV01P002 [ج 2: ص 167] الأصبغ بن زيد، عن القاسم الأعرج، قال: كان سعيد بن جبير يبكي بالليل حتى عمش(@)(@@) (145) -[2: 167] ثنا محمد بن إسحاق بن إبراهيم الثقفي، قال: ثنا أبو حاتم بن الليث، قال: ثنا أبو نعيم، قال: ثنا الحسن بن طلحة، عن وفاء بن إياس، قال: كان سعيد بن جبير ختم القرآن فيما بين المغرب والعشاء في رمضان قد ذكرت وصف قتله في كتاب الخلفاء في إمارة عبد الملك.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي الحسن(@)(@@) أخو الحسن بن أبي الحسن، مولى زيد بن ثابت الأنصاري، واسم أبي الحسن يسار، يروي عن: ابن عباس، روى عنه: قتادة، مات بفارس سنة ثمان ومائة قبل الحسن، وبكى عليه الحسن سنة فعوتب فيه، فقال: " الحمد لله الذي لم يجعل بكاء يعقوب عارا عليه ".(@)(@@)(@@)(@@) ||| AUTO سعيد بن العاص بن سعيد بن العاص بن أمية بن عبد شمس بن عبد مناف القرشي، كنيته أبو عثمان(@)(@@) وقد قيل: أبو عبد الرحمن، يروي عن: عمر، وعثمان، وعائشة، سمع منه سالم، وابنه يحيى، مات سعيد بن العاص، وأبو هريرة، وعائشة، وعبد الله بن عامر، سنة ثمان وخمسين.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عمرو بن سعيد بن العاص الأموي القرشي(@)(@@) يروي عن: أبي هريرة، وابن عمر، وعائشة، وعبد الله بن عامر، روى عنه: ابناه خالد، وإسحاق ابنا سعيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أيمن(@)(@@) مولى كعب بن سور، بصري، يروي عن: أنس، روى عنه: حماد بن زيد، وأبو الأشهب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سعد بن عبادة الخزرجي(@)(@@) يروي عن: أبيه، روى عنه: أبو أمامة بن سهل بن حنيف.(@)PageV01P002(@)(@@) [ج 2: ص 168](@)(@@)(@@)(@@) ||| AUTO سعيد بن حاطب الجمحي(@)(@@) أخو محمد بن حاطب، قال: " كان النبي صلى الله عليه وسلم يجلس على المنبر يوم الجمعة ثم يؤذن المؤذن ". روى عنه: صالح بن صالح بن حي الهمداني والد الحسن بن صالح، وليس يصح له عندي صحبة، 
ms537	 فلذلك أدخلناه في كتاب التابعين، وقد وهم من زعم أن له صحبة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي سعيد الخدري(@)(@@) يروي عن: أبيه، عداده في أهل المدينة، روى عنه: أهلها، وعمران بن أبي أنس.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن أبي عياش الزرقي(@)(@@) يروي عن: أنس بن مالك، روى عنه: موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أسلم(@)(@@) يروي عن: مولى لهم من بني غفار من أصحاب النبي صلى الله عليه وسلم روى عنه: بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سفيان القاري(@)(@@) يروي عن: علي، روى يحيى بن أبي عمرو الشيباني، عن عبد الله بن ناشر، عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن جمهان الأسلمي، كنيته أبو حفص(@)(@@) يروي عن: ابن أبي أوفى، وسفينة، روى عنه: حماد بن سلمة، وعبد الوارث، مات في الطاعون بالبصرة سنة ست وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سمعان الأنصاري(@)(@@) مولى الزرقيين، عداده في أهل المدينة، يروي عن: أبي هريرة، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الله بن جريج(@)(@@) عداده في أهل الكوفة، يروي عن: أبي PageV01P002 [ج 2: ص 169] برزة، روى عنه: الأعمش.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أنس(@)(@@) يروي عن: أنس بن مالك، روى عنه: عباد بن شيبة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن يسار(@)(@@) أخو أبي مزرد، مولى شقران مولى رسول الله صلى الله عليه وسلم وقد قيل: إنه مولى الحسن بن علي، وقد قيل: مولى بني النجار، واسم أبي مزرد: عبد الرحمن بن يسار، كنية سعيد بن يسار: أبو الحباب، يروي عن: أبي هريرة، روى عنه: المقبري، وسهيل بن أبي صالح، مات بالمدينة سنة سبع عشرة ومائة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الله بن يسار(@)(@@) أخو أيوب، وسليط، يروي عن: ابن عمر، روى عنه: خالد بن أبي عثمان، عداده في أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن يزيد بن مسلمة الأزدي، كنيته أبو مسلمة الطحان(@)(@@) عداده في أهل البصرة، يروي عن: أنس بن مالك، وكان راويا لأبي نضرة، روى عنه: شعبة، وحماد بن زيد، والناس.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حيان(@)(@@) أخو بني عدي، وقد قيل: إنه 
ms538	 من تيم الرباب، عداده في أهل الكوفة، عن: علي، روى عنه: أبو حيان التيمي، والحارث بن سويد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الله بن ضرار الأسدي الكوفي(@)(@@) يروي عن: أنس، روى عنه: واصل الأحدب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن الحكم(@)(@@) وقد قيل: سعد بن أحكم، من أهل واسط، يروي عن: أبي أيوب الأنصاري، روى يزيد بن أبي حبيب، عن شيخ، عنه.(@)PageV01P002(@)(@@) [ج 2: ص 170](@)(@@)(@@)(@@) ||| AUTO سعيد بن سويد(@)(@@) يروي عن: معاوية، روى عنه: عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبيض بن حمال السبائي الماربي(@)(@@) عداده في أهل اليمن، يروي عن: فروة بن مسيك، وأبيه، روى عنه ابنه ثابت بن سعيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سليم الضبي، كنيته أبو عثمان(@)(@@) عداده في أهل البصرة، يروي عن: أنس بن مالك، روى عنه: أبو عامر العقدي، يخطئ.(@)(@@)(@@)(@@) ||| AUTO سعيد الثقفي(@)(@@) يروي عن: رجل من قومه من أصحاب رسول الله صلى الله عليه وسلم روى حصين بن عبد الرحمن، عن أبي الحجاج، عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حيان الأزدي اليحمدي(@)(@@) أصله من البصرة، ولي القضاء ببلخ، يروي عن: ابن عباس، روى عنه: عوف بن أبي جميلة الأعرابي، وعامر الأحول.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خالد القرشي(@)(@@) يروي عن: واثلة بن الأسقع، وأنس بن مالك، روى عنه: ابن عياش.(@)(@@)(@@)(@@) ||| AUTO سعيد بن قيس بن قهد الأنصاري(@)(@@) والد يحيى بن سعيد، يروي عن: أبيه، وله صحبة، روى عنه: ابنه يحيى بن سعيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن هانئ الخولاني، أبو عثمان(@)(@@) عداده في أهل الشام، عن: جماعة من الصحابة، روى عنه: أهل الشام، مات سنة سبع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن الحارث بن أبي المعلى الأنصاري، ويقال: ابن المعلى PageV01P002 [ج 2: ص 171](@)(@@) ولي القضاء بالمدينة، يروي عن: ابن عمر، وجابر، وأبي سعيد، روى عنه: عمر بن الحارث، وعمارة بن غزية، وفليح بن سليمان وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن ذي حدان(@)(@@) يروي عن: علي، وسهل بن حنيف، روى عنه: أبو إسحاق السبيعي، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي الحويرث(@)(@@) مولى السائب، يروي عن: ابن عباس، روى عنه: عمرو 
ms539	 بن دينار، وابن جريج، كنيته أبو يزيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن رقيش المدني(@)(@@) يروي عن: أنس بن مالك، روى عنه: يحيى بن سعيد الأنصاري، وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حسان(@)(@@) يروي عن: ابن الزبير، وابن عمر، روى عنه: نافع بن عمر، وإبراهيم بن نافع.(@)(@@)(@@)(@@) ||| AUTO سعيد بن زرعة الجرار الحمصي(@)(@@) يروي عن: ثوبان، روى عنه: الحسن بن همام، ومرزوق أبو عبد الله الشامي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن شفي(@)(@@) يروي عن: ابن عباس، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي خالد(@)(@@) أخو إسماعيل بن أبي خالد، واسم أبي خالد سعد البجلي، وقد قيل: هرمز، عداده في أهل الكوفة، يروي عن: أبي هريرة، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 172] إسماعيل بن أبي خالد أخوه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عمرو بن حذيم(@)(@@) قوله، روى حماد بن سلمة، عن علي بن الحكم، عن جده، عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حرب العبدي(@)(@@) قال: سمعت ابن الزبير، وهو يقلع قواعد البيت، فأتى على تربة صفراء عند الحطيم، فقال: " واروها فإن هذا قبر إسماعيل ". روى عنه: ابن أخيه المنذر بن ثعلبة بن حرب العبدي من حديث المراوزة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن العاص الشمالي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي هند(@)(@@) من أهل المدينة، يروي عن: أبي موسى، روى عنه: ابنه عبد الله بن سعيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خالد بن عمرو بن حزم الأنصاري(@)(@@) يروي عن: بعض أزواج النبي صلى الله عليه وسلم روى عنه: ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي شمر السبائي(@)(@@) عداده في أهل مصر، رأى مالك بن زاهر ينقي باطن قدميه، ولمالك صحبة، روى عنه: بكر بن سوادة، وعمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي سعيد المقبري، كنيته أبو سعد(@)(@@) نسب إلى مقبرة كان يسكن بالقرب منها، واسم أبيه كيسان، كان مكاتبا لأمرأة من بني ليث، عداده في أهل المدينة، يروي عن: أبي هريرة، وعن أبيه، روى عنه: الناس، مات سنة ثلاث وعشرين ومائة، وقد قيل: سنة ست وعشرين ومائة، وكان 
ms540	 قد اختلط قبل أن يموت بأربع سنين.(@)PageV01P002(@)(@@) [ج 2: ص 173](@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي سعيد(@)(@@) مولى أبي بكر بن محمد بن عمرو بن حزم، يروي عن: أبي رافع مولى رسول الله صلى الله عليه وسلم روى عنه: موسى بن عبيدة الربذي حديث صلاة التسبيح.(@)(@@)(@@)(@@) ||| AUTO سعيد بن الصلت(@)(@@) مولى لآل مخرمة، كنيته أبو يعقوب، يروي عن: ابن عباس، روى عنه: بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سليم بن قيس بن قهد الأنصاري(@)(@@) يروي عن: أبي هريرة، وأبيه، روى عنه: أبو بكر بن محمد بن عمرو بن حزم الأنصاري، والزهري.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبيد بن السباق، كنيته أبو السباق(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، والسائب بن يزيد، روى عنه: الزهري، وفليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO سعيد الضبي(@)(@@) يروي عن: علي، عداده في أهل الكوفة، روى عنه: ابنه رزام بن سعيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الله الأغطش(@)(@@) من أهل الشام، يروي عن: جماعة من الصحابة، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن جحش الجحشي الحجازي(@)(@@) يروي عن: ابن عمر، روى عنه: معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن طهمان(@)(@@) يروي عن: أنس بن مالك، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO سعيد بن فيروز الطائي(@)(@@) مولى لهم، أبو البختري، وقد قيل: سعيد بن أبي عمران، عداده في أهل الكوفة، يروي عن: ابن عباس، وابن عمر، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 174] الكوفيون، قتل بالجماجم سنة ثلاث وثمانين، وقد قيل: سعيد بن عبيد مولى بني نبهان.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي كرب الهمداني(@)(@@) من أهل الكوفة، يروي عن: جابر، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن أبو صالح الغفاري(@)(@@) يروي عن: عقبة بن عامر، عداده في أهل مصر، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO سعيد بن رقيش(@)(@@) يروي عن: ابن عباس، روى عنه: محمد بن عمار بن عمارة الخطمي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عمير الحارثي الأنصاري(@)(@@) من أهل المدينة، يروي عن: ابن عمر، وأبي سعيد، روى عنه: جعفر بن عبد الله.(@)(@@) (146) -[2: 174] حدثنا إبراهيم بن 