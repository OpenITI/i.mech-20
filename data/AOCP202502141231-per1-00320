ms301	 دوست جدایی، چونی؟ %~% ای جان وجهان من، کجایی، چونی؟(@)(@@)(@@)(@@) | خم(@)(@@) (@@) 3012 ای مهر نما و کینه گستر چونی؟ %~% ای روحنواز عشق پرور چونی؟(@)(@@) (@@) جانم زمیان جان، تورا می پرسد %~% و %~% چونی و چگونهای و، دیگر چونی؟(@)(@@) (@@) 3013 ای مطرب خوشنوای دلبر، چونی؟ %~% وی گلرخ رعنای سمنبر، چونی؟(@)(@@) (@@) ای سوخته از روی چوماهت خورشید %~% از زحمت دوشینهآ چاکر، چونی؟(@)(@@)(@@)(@@) | اخر(@)(@@) (@@) 3010 چون عقل، زفهرست جهان بیرونی %~% چون روح، ز مشروح صفت افزونی(@)(@@) (@@) بنده، زمیان جان تو را می پرسد %~% چون بودی دی و دوش و، اکنون چونی؟(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 3015 ای باد سحر، که لطف یاور بادت %~% همواره چنین پای تکاور بادت(@)(@@) (@@) رونزد کسی، که رفت و زنهار بخورد %~% گو: من رفتم، خدای داور بادت!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 3016 ای باد، به کوی یارم ار برگذری %~% با یار چو ازحال دلم با خبرنی(@)(@@) (@@) گویی تو: چوبلبل و چوگل شیوهآ او %~% ایضا %~% گه نوحه گری بود و، گهی شیوه گری!(@)(@@) (@@) 3017 ای باد، زهر سو که گذار است تورا %~% فرسنگ چه ده، چه صد هزار است تورا(@)(@@) (@@) ار بهر خدا، به نزد یارم بگذر %~% گو: دوست، هنوز دوستدار است تورا!(@)(@)PageV01P477(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0481.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3018 ای سرو، که بر رهگذر آن پسری %~% چون بر تو گذر کند، مرآن رشک پری(@)(@@) (@@) گو: زآرزوی قد تو، پیش قد من %~% بس لابه گری کرد، یکی رهگذری!(@)(@@) (@@) 3019 ای آنکه زجان و دل فزون می باشی %~% وز دایرهآ وصل، برون می باشی(@)(@@) (@@) من مردم زاشتیاق تو، لیکن تو %~% چونی و چگونه ای و چون می باشی؟(@)(@@) (@@) 3020 ای خسته دلم زتو فزونی، چونی؟ %~% و آسایش بیرون و درونی، چونی؟(@)(@@) (@@) بر من بی تو، خواب و خورش گشت حرام %~% بی من، تو چگونه ای و چونی، چونی؟(@)(@@)(@@)(@@) | نمط هشتم(@)(@@)(@@)(@@) | در غیرت(@)(@@)(@@)(@@) | عنصری(@)(@@) (@@) 3021 در عشق تو، کس پای ندارد جز من %~% در شوره کسی تخم نکارد، جزمن(@)(@@) (@@) با دشمن وبا دوست، بدت می گویم %~% تا هیچ کست، دوست ندارد جزمن!(@)(@@) (@@) 3022 
ms302	 رشک آیدم از شانه، که مویت بوسد %~% وز آینه، کونشان رویت بوسد(@)(@@) ~~هر روز کنم دیده و دل، آتش و آباز باد سحر، که خاک کویت بوسد!(@)(@@) (@@) 3023 هرگه، که همی سوی توباشد نظرم %~% خواهم که تورا نبینم، ای چشم و سرم!(@)(@@) ~~زیرا که در آن زمان که در تو نگرم بر مردمک دیدهآ خود، رشک برم!(@)(@@) (@@) 3024 می رشک آید مرا زخاک کویش %~% بر باد حسد برم، که آرد بویش(@)(@@) (@@) در آینه منگراد، آن بینایی %~% تا دیدهآ او نیز، نبیند رویش!(@)(@@) ~~3025 چشمم، نظر ار بر دگری اندازدیا با دگری، عشق جمالت بازد(@)(@@) (@@) در سینه، ز غیرت آتشی افروزم %~% کزشعلهآ آن، دیدهآ من بگدازد!(@)(@)PageV01P478(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0482.jpg)(@)(@)(@@) ~~از باد، به رشکم که به تو برگذرد -302 با ماه، به جنگم که بدو در(@)(@@) نگری %~% باخاطر خود، بدم که بر وی گذری %~% وز خاک، به دردم که مر او را سپری!(@)(@@) (@@) 3027 بر دیده، دلم رشک برد از پی دوست %~% یعنی: نظرش چرا بر آن روی نکوست!(@)(@@) (@@) این طرفه، که دیده نیزمی رشک برد %~% بردل، که همه ساله چرا دوست در اوست!(@)(@@) (@@) 3028 سرو سهی و ماه تمامست خوانم %~% یا مرغ در افتاده به دامت خوانم(@)(@@) (@@) زین هر سه، ندانم که کدامت خوانم؟ %~% کز رشک نخواهم، که به نامت خوانم!(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~جانم بشود زغیرت، ای جان و جهان 3020 منگر به زمین، که خاک و آبت(@)(@@) بیند %~% ولها %~% گر زانکه شبی، کسی به خوابت بیند! %~% منگر به فلک، که آفتابت بیند(@)(@@) (@@) 3030 از بس که کند زلف توبا روی توراز %~% بیم است، که از رشک کنم کفر آغاز(@)(@@) (@@) من بندهآ بادی شدم، ای شمع طراز %~% کاو زلف تو، از روی تو بر دازد باز(@)(@@)(@@)(@@) | جرجانی(@)(@@) (@@) 3031 جزمن کسی ار کند به وصل توامید %~% بر دیدهآ او کنم سیه، روز سپید(@)(@@) (@@) زیرا که ز رشک، بر نتابد دل من %~% خورشید رخا، که بر تو تابد خورشید!(@)(@@)(@@)(@@) | اخ(@)(@@) ~~3032 ای لطف مه و 
ms303	 حسن پری دایه توراخورشید ز توداده به پیرایه تور(@)(@@) (@@) روزی، که به نزدیک منت رای بود %~% اخ %~% از رشک، نخواهم که بود سایه تورا!(@)(@@) (@@) 3033 هر کس که نگه کند به چشم مستش %~% از رشک، دعای بد کنم پیوستش(@)(@@) ~~وان کس، که به انگشت رخت بنماید گر دسترسم بود، ببرم دستش!(@)(@@)(@@)(@@) | خ(@)(@@) ~~3034 ای عشق تواز جهان پسندیدهآ من وی مهر تو، از زمانه بگزیدهآ من(@)(@@) ~~از رشک تو، خواهم که خیالت به سحر پوشیده رود، ز مردم دیدهآ من] PageV01P479(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0483.jpg)(@)(@)(@@) (@@) 3035 شب، گشت چو روزم از رخ فرخ تو %~% ز هر غم تو، شکر شد از پاسخ تو(@)(@@) (@@) حال من بیچاره، بدان جای رسید %~% کز دیدهآ خود، دریغم آید رخ توا(@)(@@)(@@)(@@) | جمال حاجی(@)(@@) (@@) 3036 روی [تو] که آفتاب گویم او را %~% در بیداری و خواب جویم او را(@)(@@) (@@) گر دیدهآ من، به جز تو در کس نگرد %~% از رشک، به صد آب بشویم او را!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3037 اندر تن من، هیچ نماندهست رگی %~% کآنجا، غم عشق تو نبردهست تگی(@)(@@) (@@) از کوی تو، استخوانها بر چینم %~% تا در ناید به بوی آن، هیچ سگی!(@)(@@) (@@) 3038 گیرم که صبا، زلف تو را می بوسد %~% گه گه، لبت آن زلف دو تا می بوسد(@)(@@) (@@) رشک آیدم از زمین، در آمد شدنت %~% تا او، کف پای تو چرا می بوسد!(@)(@@) (@@) 3039 با این همه لطف، کز جمالت بینم %~% و آسایش جان، کزخط وخالت بینم(@)(@@) (@@) در بیداری نگویم، از غایت رشک %~% در خواب، نخواهم که خیالت بینم!(@)(@@) ~~3040 باد آید و، بوی خوش توفاش کندتا با گل تومری و پرخاش کند(@)(@@) (@@) آتش زنهاد من بر آمد، از رشک %~% تا او که بود؟ که بوی توفاش کند!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3041 گرچه سخنت، قدر گهر می دارد %~% وز شیرینی، طعم شکر می دارد(@)(@@) ~~در آتش رشک، جان من سوخت از آنکتا بر لب من، چرا گذر می دارد!(@)(@@)(@@)(@@) | نمط نهم(@)(@@) درقناعت به دیدار، ونظر(@)(@@)(@@)(@@) | جمال خجندی 
ms304	(@)(@@) ~~30،41 آنها، که به از هزار شادی غمشان جان، برخی آن زلف خم اندر خمشان PageV01P480(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0484.jpg)(@)(@)(@@) (@@) 3043 دل درغم تونشسته، تو بی غم از این %~% الغیره %~% بپسندی اگر کنند با تو، هم از این؟(@)(@@) (@@) از دور به دیدار [تو] قانع شدهام %~% زین بیش طمع ندارم، آخر کم از این؟(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~304 جانا، همه طبع خویش بر ناز مداربر من در صد گونه بلا، باز مدار(@)(@@) (@@) ن دانم قدر در رخ تو دیدن %~% زنهار، مرا از این قدر باز مدار!(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~304 دادم، به امید آنکه بتوانم دادبر پای تو بوسهای، جوانی بر باد!(@)(@@) (@@) ار زانکه جز اینم طمعی می باشد %~% ایضا %~% هرگز به من، این نیز که گفتم مرساد!(@)(@@) (@@) 3046 ای برده قرار دل شوریدهآ من از دور به دیدار تو بودم خرسند %~%(@)(@@) آن نیز حرام کرده بر دیدهآ من! %~% غم داده بدین دل ستمدیدهآ من(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 3041 ای کبک دری، چو باز پرواز مگیر %~% خوی بد روزگار ناساز مگیر(@)(@@) (@@) چون از تو به یک نظر، قناعت کردم %~% سردی مکن، آن نظر زمن باز مگیر!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~راضی شده ام، به یک نظر از رخ تو 3042 با بندهآ خود وفا نداری، شاید(@)(@@) %~% آن نیز به من روا نداری، شاید! %~% میلی به من گدا نداری، شاید(@)(@@) (@@) 3040 من، عشق تو از دل نگذارم هرگز در مدت عشقت، زتو جز یک نظری %~%(@)(@@) لغیره %~% والله که نداشتم، ندارم هرگز! %~% جزبا تو، نباشد سر و کارم هرگز(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 3050 تا در سر زلف توست [پا] بند رهی %~% تا با تو، به مهر کرد پیوند رهی(@)(@@) (@@) گر داشت رهی، جزنظری از توطمع %~% پس گفت خدا را زن و فرزند رهی!(@)(@)PageV01P481(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0485.jpg)(@)(@)(@@)(@@)(@@) | نمط دهم(@)(@@)(@@)(@@) | در بیماری(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 3051 بیمارم از جگر، به صد دشخواری %~% چون چشم تو، کرده ام غذا خونخواری(@)(@@) (@@) گر لعل توام، به پرسشی بنوازد %~% چون چشم تو، خوشتر شوم از بیماری(@)(@@)(@@)(@@) | یمین(@)(@@) (@@) 3052 ای گشته فراموش تو را 
ms305	 دلداری %~% زنهار، ز بد عهدی و بد زنهاری(@)(@@) (@@) بیمار غم توام، چنانک از من هیچ %~% در چشم نیایدت به جز بیماری(@)(@@)(@@)(@@) | فراجه(@)(@@) (@@) 3053 می گفت که: رنج هوست می دانم %~% در کوی وفا دسترست مسی دانم(@)(@@) ~~گفتم که: چه رنج است مرا؟ گفت: خموش بیمار منی، بر مجست می دانم(@)(@@) ~~3054 رفتم به طبیب، گفتمش: یاری کن درمان دلم، از سر هشیاری کن(@)(@@) (@@) خون دل وآب دیده، شربت فرمود %~% گفتم که: غذا؟ گفت: جگر خواری کن!(@)(@@) (@@) 3055 آخرز من - ار یادمنت هست- بپرس %~% هشیار دلی، زین دل سرمست بپرس(@)(@@) (@@) بیمارغم توام، توخود می دانی %~% بیماران را - چنانکه رسم است- بپرس!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3056 آن سرو قدت را زچمن باز مگیر %~% در باغ به حیله جمله تن باز مگیر(@)(@@) ~~من بیدل و بیمار و، تودلدار و طبیبروزی دو سه، پا از سر من باز مگیرا(@)(@@) ~~3057 دوشینه شب، ارچه جانم از درد بکاست چون توبه عیادتم شدی رنجه، رواست(@)(@@) ~~بر بوی عیادت توامشب، همه شب زایزد به دعا، درد همی خواهم خواست!(@)(@@) ~~3058 یکباره، فراموش مکن یاران راغمخوارگیی نمای، غمخواران را(@)(@@) ~~اها، که بیب درددکا بسه PageV01P482(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0486.jpg)(@)(@)(@@)(@@)(@@) | نمط یازدهم(@)(@@) در خرسندی وقناعت(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~3059 در عشق، نشان چشم ترم بس باشد سوز دل و خون جگرم بس باشد(@)(@@) (@@) گر در همه عمر، یک نوازش بینم %~% تا روزقضا، این قدرم بس باشد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3060 نامردم، تاعشق توام هست هوس %~% گر گویم هرگزت که: فریادم رس!(@)(@@) ~~خواهی به فراق کوش و، خواهی به وصالمن فارغم از هر دو، مرا عشق توبس!(@)(@@) ~~3061 چون با تو، به جز عشق نورزم به جهان هجران و وصال تو، مرا شد یکسان(@)(@@) ~~بی عشق تو بودنم، ندارد سامانخواهی تو وصال جوی و، خواهی هجران!(@)(@@) ~~3062 زان یار، که سغبهٔ‌ جهان خواهم شددل بر کندم، با سر جان خواهم شد(@)(@@) (@@) از بندگی کسی، که بی حاصل بود %~% آزادتر از سرو روان، خواهم شد!(@)(@@)(@@)(@@) | آخ(@)(@@) ~~3063 پیوسته زمن، کشیده دامن دل 
ms306	 توست فارغ زمن سوخته خرمن، دل توست!(@)(@@) (@@) گر عمر وفا کند، من از تودل خویش %~% فارغ تر ازآن کنم، که از من دل توست!(@)(@@) ~~3064 با زخم بساز، ای دل ارمرهم نیست گریار زما برید، چندین غم نیست(@)(@@) %~% چون [من] باشم، نگار و دلبر کم نیست! %~% زیرا که نهاذ عمر، بس محکم نیست(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) ~~3065 دل، بیش بر آن نرگس مغمز ننهم بار تو، بر این سینهآ عاجز ننهم(@)(@@) (@@) شکرانه بده، کز تو دل پرخون را %~% برداشتم، آنچنانکه هرگز ننهم!(@)(@)PageV01P483(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0487.jpg)(@)(@)(@@) (@@) 3066 ای دل، تو بسی گرد بلا می پویی %~% لغیره %~% افسانهآ فتنه، بر ملا می گویی(@)(@@) (@@) عشقی که وبال است، چرا می طلبی؟ %~% وصلی که محال است، چرا می جویی؟(@)(@@)(@@)(@@) | ان(@)(@@) (@@) 3067 زان روی که در حسن کمالسن بینم %~% در وهم نیارم، که وصالت بینم(@)(@@) (@@) خرسند شدم بدانکه اندر همه عمر %~% گر خواب آید، شبی خیالت بینم!(@)(@@)(@@)(@@) | آخر(@)(@@) ~~3068 تاجان و دل وعقل و بصر خواهم داشت در عشق تو، بر میان کمر خواهم داشت(@)(@@) (@@) توخواه جفا کن ای صنم، خواه وفا %~% من هر روزیت، دوستر خواهم داشت!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 3069 در کعبهآ وصل تو، طوافی رسدم %~% با لشکر هجر تو، مصافی رسدم(@)(@@) (@@) گیرم که به عاشقیم می نپذیری %~% اندر صف عاشقانت، لافی رسدم!(@)(@@) (@@) 3070 آخر زگل وصل تو، خاری رسدم %~% وز بادهآ عشق تو، خماری رسدم(@)(@@) (@@) گیرم که مرا دست به وصلت نرسد %~% غم خوردن توز دور، باری رسدم!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 3071 تا کی به نیاز دل، از او ناز کشیم؟ %~% تا کی، غم آن سرو سرافراز کشیم؟(@)(@@) (@@) او، پای چو در رکاب بد عهدی کرد %~% روزی دو سه مانیز، عنان باز کشیم!(@)(@@)(@@)(@@) | اخر(@)(@@) (@@) 3072 زین پیش، فراغتی نمودی از من المتة لله، که من ازتواکنون %~%(@)(@@) فارغتر از آنم، که تو بودی از من! %~% صبر و دل و هوش من، ربودی از من(@)(@@) (@@) 3073 گفتم که مگرنگار، واخواست کند %~% کی دانستم، که مهر کم کاست کند!(@)(@@) (@@) برساز هوای 
ms307	 او، دلی کژ بینم %~% زان، شد که دگر ترانه ای راست کند!(@)(@@)(@@)(@@) | اخ(@)(@@) (@@) 3074 گر وصل تسو، داشت از غم آزاد مرا %~% ور هجر تو می دارد، ناشاد مرا(@)(@@) (@@) با وصل تووهجرتوام، کاری نیست %~% با عشق توای یار، خوش افتاد مرا!(@)(@)PageV01P484(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0488.jpg)(@)(@)(@@)(@@)(@@) | نمط دوازدهم(@)(@@) در وقایعی که میان عاشق ومعشوق واقع شود(@)(@@)(@@)(@@) | اوحد(@)(@@) (@@) 307 عمری، رخ یکدگر ندیدیم به چشم %~% امروز، که در او نگریدیم به چشم(@)(@@) (@@) پا همدگر احوال خود، از بیم رقیب %~% %~% گفتیم به ابرو و، شنیدیم به چشم!(@)(@@) (@@) 3076 من، دوش شدم بندهآ آن حلقه و گوش %~% بنواخت مرا یار، بدان لعل خموش(@)(@@) (@@) خورشید، زرشک بر من انگشت گزید %~% چون دست به گردنش در آوردم، دوش!(@)(@@) (@@) 3071 با زلف تو، گر دست درازی کردم %~% بشنو به حقیقت، نه مجازی کردم(@)(@@) (@@) در زلف تودیدم، دل شوریدهآ خویش %~% پس با دل خویش، عشقبازی کردم!(@)(@@) ~~اندر سر زلف تو، بدیدم دل خویش 3078 گر با سر زلف تو، در آمیخته ام(@)(@@) %~% خوش باش، که فتنه ای نینگخته ام %~% جانا، زدل خویش در آو یخته ام!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3079 چشمت به کرشمه، فتنهآ بابلی است زلفت زگره، چو حالم از مشکلی است(@)(@@) (@@) با زلف خوش تو، گر کنم گستاخی %~% آن نه زدلیری است، که از بیدلی است!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3080 زلفش بکشیدم، آن سراسر همه بندتا در نگرد به حالم، آن سرو بلند(@)(@@) ~~چین برد ززلف [و] بر دو ابرو افکند آنم، که بلا به خود کشیدم به کمند!(@)(@@) ~~308 بودیم به گرمابه، من و شمع چگل او زلف به گیل در زد و، من دست به دل(@)(@@) (@@) دو جوی، زآب دیدگان شد حاصل %~% من دست زدل شستم و، او زلف زگل!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 308 عنبر، رهی زلف سیاه تو شود %~% خور، چاکر آن روی چوماه تو شود(@)(@@) (@@) ر دولت فرخنده بود، تکیه گهش %~% آن را که چوبنده، تکیه گاه توشود!(@)(@)PageV01P485(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0489.jpg)(@)(@)(@@)(@@)(@@) | نجیب عمر(@)(@@) (@@) 3083 ای عشق تو در هر نفسی 
ms308	 مایهآ من %~% وی درد و غمت، به روز و شب دایهآ من(@)(@@) (@@) در مذهب عاشقی، روا کی باشد؟ %~% کت سایه ببینم و، تو همسایهآ من!(@)(@@)(@@)(@@) | رضیه گنجه ای(@)(@@) (@@) 3084 مستش دیدم، گرفته راه خانه خود را، به ستم بر او زدم مردانه %~%(@)(@@) خلقی با او، زخویش وزبیگانه %~% زانگونه که با شمع کند، پروانه!(@)(@@)(@@)(@@) | حمید تبریزی(@)(@@) ~~در رهگذری دوش، بری بر من زد 33085 دلدار، که دل به غصه پروردم از او(@)(@@) %~% المتة لله، که بری خوردم از او! %~% دلدار من است، اگر چه با دردم از او(@)(@@) (@@) 3086 دل، باز بدو دهیم تا خود چه بود؟ %~% در گوشهآ غم جهیم، تا خود چه بود؟(@)(@@) (@@) بر رقعهآ بیدلی، چو شهمات شدیم %~% رخ بر رخ او نهیم، تا خود چه بود؟(@)(@@) (@@) 3087 از من، به بهای جان فزونت که برد؟ %~% وز دست من خسته، برونت که برد؟(@)(@@) (@@) جان بر سر رقعهآ امیدم، شب و روز %~% می بازم، تا به دست خونت که برد؟(@)(@@) (@@) 3088 شطرنج جمال، با قمر باختهای %~% فرزین و رخ و بیاذق انداختهای(@)(@@) (@@) شهمات شدم، زبس که بر رقعهآ جان %~% پیل ستم و، اسب جفا تاخته ای!(@)(@@) (@@) 3089 ای دل، چونماند بارخش پیوندت %~% وز پشت فرس، به پای پیل افکندت(@)(@@) (@@) بر چهرهآ رقعه، بیذق اشک روان %~% اخ %~% شهمات شوی، چه سود فرزین بندت!(@)(@@) ~~3090 زان روی، که آن نگار بدخوافتاد بر چهرهآ من، زاشک من جوافتاد(@)(@@) (@@) رخ بر رخ من نهاد امروز، به سهو %~% این بازی سهو بین، چه نیکو افتاد!(@)(@@) (@@) 3091 تا، در غم یار گشت چون زررخ من %~% بی سیم، نظر نمی کند در رخ من!(@)(@@) (@@) شطرنج امید، تا زیم خواهم باخت %~% باشد که به سهو، رخ نهد بر رخ من!(@)(@)PageV01P486(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0490.jpg)(@)(@)(@@)(@@)(@@) | خ(@)(@@) ~~3092 بگریختم ازیار و، غلط کردم راهوز جوی دو دیده، پر زخط کردم راه(@)(@@) (@@) زودم یابد، گر آید اندر پی من %~% کز دیده به خون، نقط نقط کردم راه!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3093 امروز، چو خورشید 
ms309	 بر آمد گه بام بنمود رخ نگارم، از گوشهآ بام(@)(@@) (@@) در هر دو نگه کردم، گفتم: یارب %~% الغیره %~% خورشید کدام است و، دلارام کدام!(@)(@@) ~~309 گر زانکه بدیدی، زتورضوان انگشت در حال زدی، زان همه حوران انگشت(@)(@@) (@@) یک روز، زبام دیدم انگشت تورا %~% زان روز، گرفته ام به دندان انگشت!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~3094 دلدارم از آنچه داشت در دل برخاستدرعذر شد و، لشکر عذرا آراست(@)(@@) ~~زین پس، شکرم زشکر او باید گفت زین پس، عذرم ز عذر او باید خواست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3096 جانا، دلم از عشق توخون افتادهست %~% با اشک، زدیدگان برون افتادهست(@)(@@) (@@) آنگه گویی، که می پسندی تقصیر %~% تقصیر پسندیده، کنون افتادهست!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3097 ای سیب زنخ، بهم فرستادی دوشبر من، در صد مراد بگشادی دوش(@)(@@) (@@) بالله، که زدم هزار شفتالوبیش %~% لغیره %~% امروز بر آن به، که توام دادی دوش!(@)(@@) ~~3098 ای بر دو رخت نموده آثار بهشتایزد گویی مرا، ز مهر تو سرشت(@)(@@) ~~بدرود شبی زمن، که از ناز وعتابمرواریدت، بنفشه بر زرمی کشت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3090 دل داد مرا، که دلستان را بزدم %~% وان قد چو سرو بوستان را بجزدم(@)(@@) (@@) در عشق تو، گفته ام که: جانی بزنم %~% آن قول درست گشت، جان را بزدم(@)(@@)(@@)(@@) | صدر(@)(@@) (@@) 3100 در دست هوای تو اسیرم، تدبیر! %~% وز بندگیت نیست گزیرم تدبیر!(@)(@@) (@@) تو می زنیم، چو من بنالم چاره! %~% تومی کشیم، چومن بمیرم تدبیرا PageV01P487(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0491.jpg)(@)(@)(@@) ~~3101 جانم ز جداییت، بمه فریاد آمدوز تو، به من دلشده بیداد آمد(@)(@@) (@@) چون بشنیدم، که بنده را بد گفتی %~% دلشاد شدم، که از منت یاد آمد!(@)(@@) (@@) 3102 بر بنده، سخن زهر گدا می شنوی %~% خوش خوش، به سزام ناسزا می شنوی(@)(@@) (@@) آسوده نه ای از بدیم، تا دانی %~% یا می گویی همیشه، یا می شنوی!(@)(@@) ~~3103 باز این دل عشقباره، یکباره بسوخت تا بر من خسته دل، دل خاره بسوخت(@)(@@) (@@) ننشانده هنوز، آتش عشق کهن %~% در آتش عشق تازه، بیچاره بسوخت!(@)(@@) (@@) 3104 ای دل، هوس 
ms310	 یار نوت می افتد %~% با هر یاری، کار نوت می افتد(@)(@@) (@@) فارغ نشده، زعشق دلدار کهن %~% اندیشهآ دلدار نوت می افتد!(@)(@@) ~~3105 گر با دگری، مجلس می سازم و لاغهرگز، ننهم زمهر کس بر دل داغ(@)(@@) (@@) لیکن، چوفرو شود کسی را خورشید %~% در پیش نهد، به جای خورشید چراغ!(@)(@@) ~~3106 ناگاه به من رسید، در رهگذری از عقل نماند هیچ، با من اثری(@)(@@) (@@) گریان به رخش نگاه می کردم و، او %~% می کرد به من، زروی رحمت نظری!(@)(@@) ~~3107 دل، یاد لب و نرگس مست تو کندجان، بندگی زلف چوشست تو کند(@)(@@) (@@) دستارچهای به توفرستادم، از آنک %~% تا آمدنم، خدمت دست تو کند!(@)(@@)(@@)(@@) | اسعد گنجهای(@)(@@) ~~3108 دل بی رخ یار، در بلا می افتدجان در هوسش، به صد عنا می افتد(@)(@@) (@@) می افتد آن نگار و، من می گویم: %~% این واقعه بنگر، که مرا می افتد!(@)(@@)(@@)(@@) | فقیه یوسف(@)(@@) ~~3109 ترسم که رخ چوماهت، از تابش خور بر سوزد و، زان شود دل من غمخور(@)(@@) (@@) یارب ابری فرست، بی باد ومطر %~% تا پرده شود، میان خورشید وقمر!(@)(@)PageV01P488(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0492.jpg)(@)(@)(@@) (@@) 3110 مه دوش، به بالین تو آمد به سرای %~% سنایی %~% گفتم که زغیرتش، بکوبم سر و پای(@)(@@) (@@) مه کیست؟ که او با تونشیند یکجای %~% شبگرد جهاندیدهآ انگشت نمای!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 3111 گر بد گویی تورا بدی [گفت]، ای ماه %~% هرگز نشود برتو، دل بنده تباه(@)(@@) (@@) از گفتهآ بد گوی، زما عذر مخواه %~% کآیینه، سیه نگردد از روی سیاه!(@)(@@)(@@)(@@) | له(@)(@@) (@@) 311 زنهار، که قصد دل غمخور نکنی %~% با غمزهآ خود، به کشتنم سر نکنی(@)(@@) (@@) در عهد تو، شمشیر سخن در کف ماست %~% با ما شاید، حدیث خنجر نکتی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 311 دوش، آنکه همیشه زو به نالش باشم %~% و آشفتهآ زلف وخط وخالش باشم(@)(@@) (@@) با بر بر من نهاد، یعنی که : بمال %~% مقصودش آنکه: پایمالش باشم!(@)(@)PageV01P489(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0493.jpg)(@)(@)(@@)(@@)(@@) | باب سیزدهم(@)(@@)(@@)(@@) | در وصال(@)(@@) (@@) %~% وآن ده نمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@) (@@) %~% دروصال وایام آن(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~3114 وصل 
ms311	 تو، که نیست جز طرب توشهآ او صد خرمن دولت است، یک خوشهآ او(@)(@@) (@@) آن است، که بر زمین زند هجر کلاه %~% آنجا که پدید شد، کله گوشهآ او!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3115 امروز، که یار من مرا مهمان است بخشیدن جان ودل، مرا آسان است(@)(@@) (@@) دل را خطری نیست، سخن در جان است %~% جان افشانم، که روز جان افشان است!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3116 برداشت نگار، پردهآ راز امشب با ما بنشست و، شد هم آواز امشب(@)(@@) ~~بگشاد در عیش، به صد ناز امشب ای صبح، مکن گرانی آغاز امشب!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3117 از تاب [تو] بوده درتب، این کیست؟ منم! صدروز به غم کرده شب، این کیست؟ منم!(@)(@@) ~~وین لحظه چنین درطرب، این کیست ؟منم! در پیش توزنده یارب، این کیست؟ منم!(@)(@)PageV01P490(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0494.jpg)(@)(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 3118 از هجر به جان بجسته، یارب منم این؟ %~% وزمحنت و غم برسته، یارب منم این؟(@)(@@) (@@) دیدار توام، به خواب ممکن نشدی %~% با توبه طرب نشسته، یارب منم این؟(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 3119 با توغم دل بگفته، یارب منم این؟ %~% بوسیده عقیق سفته، یارب منم این؟(@)(@@) (@@) دیدار توام، ز دور حاصل نشدی %~% اوله %~% با توبه نشاط خفته، یارب منم این؟(@)(@@) (@@) 312 دارم می و نقل ویار دلدار امشب %~% ای شب، تو شب از دست بمگذار امشب!(@)(@@) (@@) ای صبح، مکن به گریه گرمم نزدیک %~% وله %~% آن خندهآ سرد، دور می دار امشب!(@)(@@) (@@) 3121 ای دل، چوهمای وصل او سایه فکند %~% از محنت هجران، برهی روزی چند(@)(@@) (@@) تاگوش فراق نشنود، هیچ مخند %~% می خوان تو «وان یکاد»» و، می سوز سپند!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3121 گر صبحدمی، باز شدن کردی ساز %~% یا باز آیی به شام، ای مایهآ ناز(@)(@@) (@@) می شاید، از آنکه تو مه چاردهی %~% او نیز شود بام و، به شام آید باز!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3122 امشب منم و، وصل رخ یار ای شب %~% با وعدهآ خوب وخوش دلدار، ای شب(@)(@@) ~~مگذار، که صبح زحمت آرد بر ما با خندهآ سرد خویش، 
ms312	 زنهار ای شب!(@)(@@) (@@) 3124 دادهست پیام، آن بت شهر آرای %~% کای کشتهٔ‌ [از] فراق، برخیز وبیای(@)(@@) (@@) امشب منم و توو، می روح افزای %~% لب بر لب و، رخ بررخ و، الباقی های!(@)(@@) (@@) 3125 ای صبح، شب صلح بود جنگ مکن %~% شمشیر مکش، قصد شه زنگ مکن(@)(@@) (@@) چون هست تورا، پیرهن عیش فراخ %~% از بهر خدا، قبای شب تنگ مکن!(@)(@@) (@@) 3126 هجران تو، از ستیزه و پر کینی %~% گفتا که: دگر با بت خود ننشینی!(@)(@@) (@@) امروز علی رغم ورا، بنشستم %~% ای هجر حرامزاده، چون می بینی!(@)(@)PageV01P491(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0495.jpg)(@)(@)(@@)(@@)(@@) | بهستی(@)(@@) (@@) 3127 کس چون تو، به عقل زندگانی نکند %~% در شیوهآ عشق، مهربانی نکند(@)(@@) (@@) ای یار سبکروح، زوصلت امشب %~% شادم، اگر این صبح گرانی نکند!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 3128 ای صبح، شبی خوش است شبرنگ برآی %~% وی چشمهآ خورشید، تو از سنگ برآی(@)(@@) (@@) ترکانه زچین چند برآیی؟ ای صبح %~% هندوی توام، امشبی از زنگ برآی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3129 ای شب، گذر از پایهآ مبدات مباد %~% وز طبع، به جز مایهآ سودات مباد(@)(@@) (@@) کوتاه مشو، که مایهآ عمر منی! %~% قصه چه کنم دراز؟ فردات مباد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3130 ای شب، تو مرا صورت فردا منمای %~% صبح ازطرف گنبد خضرا منمای(@)(@@) (@@) چون خضر، سفر به سوی تاریکی کن %~% چون موسی عمران، ید بیضا منمای!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~3131 در جانم، از آن می [که ]شبش می خوانند شوری است، که مردم طربش می خوانند(@)(@@) (@@) امشب، که شب وصال آن حوروش است %~% روز است به پیدا، و شبش می خوانند!(@)(@@)(@@)(@@) | ملک مبارکشاه(@)(@@) ~~3132 امروز، که روی من به رویت آراستهر آرزویی که بد، ز پیشم برخاست(@)(@@) (@@) در خاطر من نبد، که هرگز روزی %~% وله %~% این دولت را، به آرزو دانم خواست!(@)(@@) (@@) 3133 می آیم و، از شوق چنان می افتم %~% کاندر تک پا، بر سر جان می افتم(@)(@@) (@@) چشمم به تو در می نگرد، وزشادی %~% می مالم چشم و، در گمان می افتم!(@)(@@)(@@)(@@) | ادیب صابر(@)(@@) ~~3134 امشب، منم و شمع 
ms313	 ومی ویارای شبتعجیل مکن به صبح، زنهارای شب(@)(@@) ~~صد شب زتو، خفتهام به تیمار ای شبیک شب، دل عاشقان نگهدار ای شب!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3134 کم نیست ز روز پادشایی، امشبای عمر گذشتهام، کجایی امشب؟(@)(@@) (@@) ای صبح، مکن کمین گشایی امشب %~% کز عمر برآیم، ار برآیی امشب!(@)(@)PageV01P492(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0496.jpg)(@)(@)(@@)(@@)(@@) | لقائله(@)(@@) (@@) 3136 ای شب، غم من شو از درازی امشب %~% ای شب، چه زیان اگر بسازی امشب!(@)(@@) ~~هندوی توام، گر نگذاری که کند رومی وش صبح، ترکتازی امشب!(@)(@@)(@@)(@@) | القائله(@)(@@) (@@) از زلف بتم، به عاریت بستانی 3137 چون کرد بتم بنده نوازی، ای شب %~%(@)(@@) اسباب سیاهی و درازی، ای شب! %~% از بهر خدا چه چارهسازی، ای شب(@)(@@)(@@)(@@) | خ(@)(@@) ~~3138 مه مژده دهد، به عمر جاو ید امشب بربط ننهد زچنگ، ناهید امشب(@)(@@) (@@) النعیش! که بی زحمت مریخ وزحل %~% خ %~% مهمان عطارد است، خورشید امشب!(@)(@@) (@@) 3130 امروز، برم زمانه شاد آوردت %~% جوزاوش و، مشتری نهاد آوردت(@)(@@) (@@) ومید نداشتم، که آیی بر من %~% ای آتش رخ، کدام باد آوردت!(@)(@@) ~~3140 زین یار فراموش، که یاد آوردت؟وزجور، که بر طریق داد آوردت؟(@)(@@) (@@) نزد من خاکسار آتشکده دل %~% ای آب روان، کدام باد آوردت؟(@)(@@) ~~314 مهمان من آمدهست جانان، ای روز امروزخوشم به روی مهمان، ای روز(@)(@@) (@@) گر شب برسد، به لب رسد جان ای روز %~% شب را بر ما راه مده هان، ای روزا(@)(@@) (@@) 3142 آرامگه دل، خم مویت دیدم %~% %~% بینایی دیده، خاک کویت دیدم(@)(@@) ~~سبحان الله! هیچ ندانم کامروزمن روی که دیدهام؟ که رویت دیدم!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 3142 از بهر وصال، بین که چون آمد شب %~% مشاطهآ چرخ سیمگون آمد شب(@)(@@) (@@) از روشنی روز فراق، آمد شب %~% وله %~% گویی، مگر از پوست برون آمد شب!(@)(@@) ~~314 زلف وخط و لعل وخد یارم بینیدشیرینی نقش آن نگارم بینید(@)(@@) ~~ای دیده وران، محرم ما[ها] باشید تا، امشب روز و روزگارم بینید!(@)(@)PageV01P493(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0497.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3145 بردار ز رخ، پردهآ طتازی را %~% پیش آر، مساعدی و دمسازی را(@)(@@) (@@) امروز، 
ms314	 تو را به کام دل یافتهام %~% کی بیند؟ یار مرغزی رازی را!(@)(@@) (@@) 316 از باغ رخت، گل به نظر می چینم %~% وله %~% وزلعل لبت، به لب شکر می چینم(@)(@@) (@@) آری، به نشاط وصل عیش آرایت %~% شکر زلب تو، بی خبر می چینم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3147 امشب، ز وصال دوست هستم دلشاد %~% از دست فراق و بیم هجران، آزاد(@)(@@) ~~خوش گشته به پیش دوست، با عیش وطرب ای شب، چه شبی؟ که سالها عمرت باد!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3148 امشب، منم و روی دل افروزای شب %~% بر لشکر هجر گشته پیروز، ای شب(@)(@@) (@@) ما را به تو حاجتی است دلسوز، ای شب %~% یک شب، چه شود گر نشوی روز ای شب!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3149 ماییم و، می مغانه ویار امشب %~% فارغ زهمه جهان و، بر کار امشب(@)(@@) (@@) ای عنبر شب، تو پرده داری می کن %~% وی جوهر صبح، دم نگه دار امشب!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 3150 امشب منم و، ماهرخ یغمایی %~% با اوبه حکایت شب تنهایی(@)(@@) (@@) ای شب، اگر اندوه منی، تا نروی %~% وی صبح، اگر کام منی، برنایی!(@)(@@) (@@) 3151 ای شب، به فراق بخش کوتاهی را %~% پیدا مکن، این سماع خرگاهی را(@)(@@) (@@) گر من توامی، پیش چنین مهمانی %~% قربان کنمی، مرغ سحرگاهی را!(@)(@@) (@@) 3152 ای شب، دیدی که آمد آن شمع سپاه %~% کوتاه شدی، تا شودم عیش تباه(@)(@@) (@@) فردا به صبوح، با من است آن دلخواه %~% خواهی تو دراز باش و، خواهی کوتاه!(@)(@@) (@@) 3153 یار آمد و، دست من آشفته گرفت %~% وزمن، گلههای گفته نا گفته گرفت(@)(@@)(@@)(@@) | کاو بخت بد مرا، چنین خفته گرفت!(@)(@)PageV01P494(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0498.jpg)(@)(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~3154 گفتم: ز فراق جاودان می ترسم تو در برو، من هم آنچنان می ترسم(@)(@@) (@@) آنگه، ززبان دشمنان ترسیدم %~% و امروز، زچشم دوستان می ترسم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3155 امشب، که فراق را گذر بر من نیست %~% جز دست و یم، قلادهآ گردن نیست(@)(@@) (@@) ای صبح، زبهر دل من دم در کش %~% انگار، که امشبیت جان در تن نیست!(@)(@@)(@@)(@@) | وله 
ms315	(@)(@@) (@@) 31156 هم لب، منم این با توبه هم یا نه منم! %~% امشب، منم این با تو به هم یا نه منم!(@)(@@) (@@) می بر لب و لب گشاده و در بسته %~% اوله %~% یارب، منم این با توبه هم یا نه منم!(@)(@@) (@@) 3157 ای شب، ره صبحدم به زنجیر ببند %~% بر چهرهآ چرخ، چادر تیر ببند(@)(@@) ~~امشب، که دو دست یار در گردن ماستتو نیز، دو پای خود به زنجیر ببند!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 3158 کی دست دهد، وصل چوتودلبندی؟ %~% الآ به هزار حیله، هر یک چندی(@)(@@) (@@) ای در بن هر موی من، از تومهری %~% وی با سر هر موی توام، پیوندی!(@)(@@) ~~3159 با روی توام، چو سازگار آید عمر گو، بی رخ خوبت به چه کار آید عمر(@)(@@) (@@) آوردمت ای عمر.............. به کنار %~% آری ................ به کنار آید عمر(@)(@@)(@@)(@@) | ابوالحسن(@)(@@) (@@) 3160 امشب، که به صحبت من آمد رایت %~% از دیده و دل، سزد که سازم جایت(@)(@@) (@@) گر نگذاری، که بر لبت بوسه دهم %~% باری بگذار، تا دهم بر پایت!(@)(@@)(@@)(@@) | فرید دبیر(@)(@@) ~~3161 امشب، منم و باده و آن سرو بلندمی را زلبش، چاشنیی داده به قند(@)(@@) ~~ای شب، اگرت هزار کار است مرو وی صبح، اگرت هزار شادی است مخند!(@)(@)PageV01P495(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0499.jpg)(@)(@)(@@) ابوالحسن طلحه(@)(@@) (@@) 3162 از قد تو امروز، کنارم چمن است %~% واندر برم از برت، نسیم سمن است(@)(@@) (@@) آن بند، که بر پای تو از زلف تو بود %~% خوش باش، که از زلف تو بردست من است!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3163 دلدار مرا گفت: شنیدم به درست %~% کز من، دل خویشتن همی خواهی جست(@)(@@) (@@) گیرم که دل تو، در سر زلف من است %~% آخر، نه سر زلف من اندر کف توست!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3164 آن من بودم، زدست عشقت سر مست %~% در پای هزار گونه محنت، شده یست(@)(@@) (@@) اکنون منم این، نشسته پیشت سرمست %~% پایت بوسان، گرفته زلف تو به دست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3165 گفتم که: به بوسه ای دل من کن شاد %~% افزون ز هزار بوسه، 
ms316	 بر رویم داد(@)(@@) (@@) دلتنگ نگشتم و، نکردم فریاد %~% گفتم: چه کنم؟ که مرگ خر از جوباد!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3166 زآنگه که دلم به درد عشقت فرسود هر روز مرا، شکایت از دل بفزود(@)(@@) ~~و اکنون که به من، وصال توروی نمود در روی دلم، خجل همی باید بود!.(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3167 دوشم، سر صلح و جنگ و ناز او بودقوتم، ز دو لعل دلنواز او بود(@)(@@) (@@) وان موی، که در میان ما می گتجید %~% آن زلف مسلسل دراز او بود!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3168 زان شب، که به روز کردهام با توبه راز روز و شبم از غمت، سیاه است و دراز(@)(@@) (@@) بس روز که بی توام، به شب باید برد %~% خ %~% تا با تو چنان شبی، به روز آرم باز!(@)(@@) (@@) 3169 مؤذن که علی رغم مرا برخیزد %~% او حق گوید، ولیک شور انگیزد(@)(@@) (@@) معشوقهآ ما پری است، لاشک که پری %~% چون بانگ نماز بشنود، بگریزد!(@)(@@)(@@)(@@) | مجد گیلانی(@)(@@) (@@) 3170 در خاطر من نیامد، ای عشوه پرست %~% کالبته مرا با توبود خاست نشست(@)(@@) (@@) تقدیر الهی، چوبه هم در پیوست %~% بنشاند مرا با تو، قضا دست به دست!(@)(@)PageV01P496(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0500.jpg)(@)(@)(@@)(@@)(@@) | ابوالعلا شاپور(@)(@@) (@@) 317 گویی به شب آیمت چوبیگاه شود %~% باشد که زبان خصم کوتاه شود(@)(@@) (@@) رخفته، گذر کجا توانی کردن؟ %~% کز بوی خوش تو، مرده آگاه شود!(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 317 در عالم حسن، آنکه سلطانی داشت %~% اقطاع وصالم، امشب ارزانی داشت(@)(@@) (@@) ای صبح، مزن رغم مراتیغ، کزو %~% ما را توبه تیغ، باز نتوانی داشت!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 3174 یارب منم این؟ به عیش کردن با تو %~% فارغ زغمت، به باده خوردن با تو(@)(@@) (@@) دی دست به سر بوده زدستت، وامروز %~% بنشسته چنین، دست به گردن با تو!(@)(@@) (@@) 3174 امشب منم و، کنار آن سرو بلند %~% می را زلبش، چاشنیی داده به قند(@)(@@) (@@) ای صبح، تو آن مکن که بتوانی کرد %~% بر گریهآ زار من ببخشای و، مخند!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 317 ای چرخ، من از توخود جفا بینم وبس 
ms317	 %~% امشب شب وصل است، به فریادم رس(@)(@@) (@@) سردی مکن ای صبح، که گرم است هوس %~% از بهر من امشبی، فرو بند نفس!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3171 یارب، منم این کنار اویافته باز %~% گم کرده نیاز، در میان صد ناز(@)(@@) (@@) تقصیر مکن ای فلک امشب، که دلم %~% پاس توبسی داشت، به شبهای دراز!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3177 ای چرخ، مبر یار به دست آمده راسر گشته مدار، یک شب این دلشده را(@)(@@) (@@) سودا زده است همچومن، رنگ شبم %~% بگذار به سودا زده، سودازده را!(@)(@@)(@@)(@@) | وله(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3179 امشب، سر م وازی با ما PageV01P497(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0501.jpg)(@)(@)(@@) (@@) 3180 عاشق، شب وصل یار بگزیدهآ خویش %~% از بهر صلاح کار شوریدهآ خویش(@)(@@) (@@) تا بوک درازتر شود وصل، کند %~% در دامن شب سیاهی دیدهآ خویش!(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | در شکر(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 3181 زان لعل در رپاش ودررنوش، امشب %~% آمد قدری باز به من، هوش امشب(@)(@@) (@@) المنة لله، که در آغوش من است %~% آن بت که نخفتم زغمش دوش، امشب!(@)(@@) (@@) 3182 اکنون، که ز وصل بر سر افسر دارم %~% ثیر %~% هر بهره که باید، از جهان بر دارم(@)(@@) (@@) نگذاشت مرا خشک لب، ایام وصال %~% شاید، که به شکر او زبان تر دارم!(@)(@@)(@@)(@@) | خا(@)(@@) ~~3183 العیش! که پاکیزه نگاری دارمبا او به مراد، کار و باری دارم(@)(@@) (@@) هرگز نکند به دوست، دشمنکامی %~% یارب، که چه حق شناس یاری دارم!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 3184 آخر شب دوش، دلبرم یکدل شد %~% وان محنت دیریتهآ من، زایل شد(@)(@@) ~~بک لحظه، فلک زکار ما غافل شد مقصود من اندر آن میان، حاصل شد!(@)(@@)(@@)(@@) | اوحد(@)(@@) ~~3185 آن بت، که بر او سزاست فرمان دادن وین درد مرام به لطف درمان دادن(@)(@@) (@@) بنمود جمال عالم آرای، به من %~% تا بر دل من، سهل بود جان دادن!(@)(@@)(@@)(@@) | صدرخجندی(@)(@@) ~~3186 معشوقه مرا گفت که: امشب شب توست!خالی ز هر آن کس، که نه بر مذهب توست(@)(@@) (@@) بگشای دهن، بوسه به خروار ببر! %~% در بسته و، لب گشاده، لب بر لب توست!(@)(@@)(@@)(@@) | مبارکشاه 
ms318	(@)(@@) ~~318 آن بت، که دل رفتهآ من او دار پیوسته مراعات دلم، خودارد(@)(@@) ~~از گفت بدان، هیچ تفاوت نکند نیکوداند مرا و، نیکودارد!(@)(@)PageV01P498(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0502.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3188 ما را شب دوش، از تو کرامتها بود %~% بردیدهآ غایبان غرامتها بود(@)(@@) (@@) هر بار، شب وصل توخوش بود مرا %~% لیکن به شب دوش، قیامتها بود!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3189 باز آمد و، یار من در مهر گشاد %~% وان سرکشی و تکبر، از سر بنهاد(@)(@@) ~~آن بوسه که می داد به دشواری، دیامروز به آن و غیر آن، تن در داد!(@)(@@) (@@) در برش گرفتم و، و بگفتم: ای ماه 319 بر طالع سعد، بامدادان پگاه %~%(@)(@@) خ %~% من در خوابم، یا تو غلط کردی راه! %~% یارم ز در خانه در آمد ناگاه(@)(@@)(@@)(@@) | آخ(@)(@@) ~~319 دوش از لب یار، داد خود بستده ام یک بوسه حواله بود، صد بستده ام!(@)(@@) (@@) زو وعده شب دگر که بادا کر و کور %~% گوش هجران و چشم بد- بستدهام!(@)(@@)(@@)(@@) | عماد اشرف(@)(@@) (@@) 319 گفتم: چه کنی؟ اگر جفا پیش آرم %~% گفتا: چه کنم؟ رضا دهم، ناز آرم(@)(@@) (@@) بارم به جفا، ز من نمی آزارد %~% سبحان الله! چه نیک یاری دارم!(@)(@@)(@@)(@@) | علی(@)(@@) (@@) 3192 چشمم، چه عجب اگر شود دجله و نیل %~% پیلان نکشند انده من، میل به میل(@)(@@) (@@) بی رهبر و بی عدیل و بی هیچ دلیل %~% ناگاه، به جان عنکبوت افتد پیل(@)(@@) ~~3194 گرچه زغمت، خسته جگر می آیم در چشم خوش تو، دیدهام دی خود را(@)(@@) %~% شادم، که تو را به چشم در می آیم %~% در کوی تو، با دیدهآ تر می آیم(@)(@@) ~~3195 آمد به برم، سرشک بر گل ریزانفریاد کنان و، رستخیز انگیزان PageV01P499(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0503.jpg)(@)(@)(@@) ~~معشوقه ببخشود و، به من روی نمود 3197 کار دل بیچاره، به جان آمده(@)(@@) بود %~% صبر از پی دل، هم به فغان آمده بود %~% دانست یقین، که وقت آن آمده بود!(@)(@@)(@@)(@@) | جمال سرخسی(@)(@@) ~~3198 آمد بر من به عذر، آن سرو چمان آزرم من دلشده می 
ms319	 جست، به جان(@)(@@) %~% اومید چنان داشتم، از روی چنان! %~% بسته کمر وفا و، بگشاده میان(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~بس کرد به وصلتم خداوندیها 3199 دوشم، دل و جان وصل تر و تازه گرفت(@)(@@) %~% یعنی که بت بلند آوازه گرفت %~% لیکن شب دوش از حد و اندازه گرفت(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3200 هر شب، زغم تو ماتمی پردازم %~% صد جان بکنم، تا به دمی پردازم(@)(@@) (@@) گر زحمت خود نبردهام، معذورم %~% کز عشق، به بندگی نمی پردازم(@)(@@)(@@)(@@) | نمط سوم(@)(@@)(@@)(@@) | در عذر(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 3201 در عشق تو، چون بار ملامت بکشم %~% اندوه تو، تا روز قیامت بکشم(@)(@@) (@@) بیخردگیی چورفت، معذورم دار %~% تا هم، من بیچاره غرامت بکشم!(@)(@@)(@@)(@@) | رضی الدین(@)(@@) (@@) 3202 پیچ سر گیسو، به سر انگشت مپیچ %~% پیچیده، دگر باره در انگشت مپیچ(@)(@@) (@@) من مستم و، آنچه عاقلان از مستان %~% بر دست نگیرند، بر انگشت مپیچ!(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~ور خدمت من، نه بر مراد دل توست 3203 گر رنج منت خوش است، رنجورم دار(@)(@@) %~% من بسدلسم ای نسگار، معذودم دارا %~% ور سیر شدی، زخویشتن دورم دار PageV01P500(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0504.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 32،4 هرگز نفسی حکایت از تو نکنم %~% کآزادی بی نهایت از تو نکنم(@)(@@) (@@) از دل، نکنم شکایتی کز تو کنم %~% از دل کنم آن شکایت، از تونکنم!(@)(@@)(@@)(@@) | فیره(@)(@@) ~~3204 مسکین تن، اگر چه عزم خدمت نکند نه از سر کبر و ناز و نعمت نکند(@)(@@) (@@) دل عاقلهآ من است و، در خدمت توست %~% بل، تا من مستمند زحمت نکند!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3200 آن مهر مجازیت، کجا شد آخر؟ %~% آن خنده و بازیت، کجا شد آخر؟(@)(@@) (@@) گیرم گنهی - که آن مبادا- کردم %~% آن بنده نوازیت، کجا شد آخر؟(@)(@@) (@@) 320 گر با تو، حدیث تنگدستی کردم %~% یا شیوهآ تو، چنانکه هستی کردم(@)(@@) (@@) بر دست مگیر و، از من آزرده مشو %~% . %~% کان بیهده، از غایت مستی کردم!(@)(@@) ~~3208 چون دل، همه سوی صلح مایل باشدپس جنگ دو روزه را، چه حاصل باشد؟(@)(@@) (@@) مشنو، اگر از عشق تو گویم: بس، بس! %~% اخ %~% کان بس 
ms320	 بس عاشقان، نه از دل باشد!(@)(@@) (@@) 3205 جانا، زحدیث رفته واخواست مکن %~% گفتیم دروغی، زخودش راست مکن(@)(@@) (@@) دل، بر نمط عذر تو بر پاست مکن %~% می گوید صوفیانه : «برماست!» مکن!(@)(@@) ~~321 بی جرم و گناه، در جهان کیست؟ بگویا جرم نکرده، در جهان کیست؟ بگو(@)(@@) (@@) من بد کردم، توبد مکافات کنی %~% پس، فرق میان من و توچیست؟ بگو(@)(@@) ~~3211 راز من و تو، چوهر کسی می گویندهر کس، سخنی ازهوسی می گویند(@)(@@) (@@) نزدیک تو-ای چشم بد از روی تودور %~% کم می آیم، زانکه بسی می گویند!(@)(@@) (@@) 3212 هیچ افتدت از جان مرا برخیزی %~% یک ساعت، از راه جفا برخیزی؟(@)(@@) (@@) با من به مراد دل، دمی بنشینی %~% یک دم، زسر گذشته ها برخیزی؟(@)(@)PageV01P501(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0505.jpg)(@)(@)(@@) (@@) 3213 ناجستن وصل تو، ز کم کوشی نیست %~% نا کردن یادت، از فراموشی نیست(@)(@@) (@@) لیکن چوز روی عقل، در می نگرم %~% اندر همه کار، به زخاموشی نیست!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 3214 شبها زفراق تو کمانکش باشد %~% صبح از بر او، چوتیر آرش باشد(@)(@@) (@@) وان شب، که مرا به وصل توخوش باشد %~% گویی، شب را قدم بر آتش باشد!(@)(@@)(@@)(@@) | نمط چهارم(@)(@@) در شکایت از کوتاهی شب وصال(@)(@@)(@@)(@@) | طغان شاه(@)(@@) (@@) 3215 هر شب، که مرا به وصل توراه بود %~% بالین من، از روی تو پرماه بود(@)(@@) (@@) چون روز بود، به دست من آه بود %~% دردا! که شب وصال کوتاه بود!(@)(@@) (@@) 3216 هر بار، که یار نزد ما می آید %~% شب بین، که چه کوتاه قبا می آید(@)(@@) (@@) بر گریهآ سرد من ببخشای، ای صبح %~% این خندهآ سردت، از کجا می آید؟(@)(@@) (@@) 3217 لعلش به شکر خنده، چودر من خندد %~% در ساعتم آن روز، به شب پیوندد(@)(@@) (@@) ور لشکر هجرانش، کمین بگشاید %~% شب، سلسله در روز قیامت بندد!(@)(@@) (@@) 3218 چون بی تو ببینم، رخ پرخندهآ صبح %~% خوش گردم ف، گویم که: منم بندهآ صبح!(@)(@@) (@@) و آنگه، که شبی باتو برآید گویم: %~% یارب، که چه تلخ است شکر خندهآ صبح!(@)(@@) (@@) 3219 