ms205	 صنما عادت تو %~% کی دانستی که تودهانی داری(@)(@@)(@@)(@@) | شمس هروی(@)(@@) (@@) 2047 گفتم که: رخت، گفت: جنان می طلبی %~% گفتم که: لبت، گفت که: جان می طلبی(@)(@@) (@@) گفتم: دهنت، گفت که: بس شیفته ای %~% کز عالم نیستی نشان می طلبی!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 2048 نقاش، اگر زموی پرگار کند %~% مثل دهن تنگ تو، دشخوار کند(@)(@@) (@@) از تنگی و نازکی، که هست آن دهنت %~% ترسم، که نفس دهانت افگار کند!(@)(@@) جمال حاجی شروانی(@)(@@) (@@) 2049 آن یار، که کس نداندش یار تویی %~% وان گل، که ندید زحمت خارتویی(@)(@@) (@@) گویا شکر تنگ تو، یعنی دهنت %~% اوله %~% یک تنگ شکر، هزار خروار تویی(@)(@@) (@@) 2050 رخسار تو پیرایهآ جان شاید بود %~% گفتار توسرمایهآ کان شاید بود(@)(@@) (@@) کوچک دهنت غم مخور، ارپیدا نیست %~% کان چشمه نوش است، نهان شاید بود(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) 2051 گفتم: زخدا زلف توخواهم، ای ماه %~% گفتا: زخدا مخواه سودای سیاه(@)(@@) (@@) گفتم که: به روزی دهنت خواهم، گفت: %~% از دهر فراخ، روزی تنگ مخواه!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2052 هر گه که سخن بگویی، ای تنگدهانماند به دهانت دهن پسته، عیان(@)(@@) (@@) نه، از دهنت نشان کجا شاید داد %~% چون از دهن تو، بی نشان است نشان(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2053 مشکین خط او، عنبرتر می بارد %~% یاقوت لبش، همه گهر می بارد(@)(@@) (@@) بنگر به نمکدان لبش، تابینی %~% کز پستهآ تنگش، چه شکر می بارد PageV01P360(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0364.jpg)(@)(@)(@@)(@@)(@@) | مظفر تبریزی(@)(@@) (@@) 2054 زنهار، دو گیسوی پر از بندش بین %~% سیمین زنخ و لعل شکر خندش بین(@)(@@) (@@) چون بگشاید پستهآ خندان به سخن %~% الغیره %~% آن یستهآ چون عقیق پر قندش بین(@)(@@) (@@) 205 گفتم: زلبت به جز هوس می نرسد %~% بار شکر از قسم (4) مگس می نرسد(@)(@@) (@@) خندید که: من بیگنهم کز دهنم %~% چون دست توتنگ است، به کس می نرسد!(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 2.5 ای آتش هجران تو دلسوزی من %~% وی شمع رخ تو، عالم افروزی من(@)(@@) (@@) شد تنگ مرا روزی و، یک روز نشد %~% اوله %~% زان تنگ دهانت، شکری روزی من(@)(@@) ~~2057 دلدار مرا دید، 
ms206	 لب از هم نگشاد تا پسته دهانش بسته دیدم گفتم:(@)(@@) %~% بنگر، که چگونه مهر بر هیچ نهاد! %~% داد دل دیوانه، به خاموشی داد(@)(@@)(@@)(@@) | بدرتفلیسی(@)(@@) (@@) 205 بی یاد لبش، انجمنی باید و نیست %~% چون من، به غمش ممتحنی باید و نیست(@)(@@) (@@) گفتم که: یکی بوسه بده، گفت: مرا %~% اول به ضرورت دهنی باید و، نیست!(@)(@@)(@@)(@@) | فخرمراغی(@)(@@) ~~2059 آن عارض خوش بین، که سمن خوانندش در چاه بود آب و، تورا آن چه(@)(@@) چیست %~% در آب معلق، که ذقن خوانندش! %~% وان خانهآ پر در، که دهن خوانندش(@)(@@)(@@)(@@) | فخر عبد الحمید(@)(@@) ~~2060 رخسار تو شمس و، تاب در دیدهآ منروی تو گل و، گلاب در دیدهآ من(@)(@@) (@@) در هیچ شریعتی روا کی دارند %~% چه در زنخ تو، آب در دیدهآ من!(@)(@@)(@@)(@@) | قطب اهری(@)(@@) ~~2061 از رنگ رخش، گل به فغان می آیدوز لعل لبش، شکر به جان می آید(@)(@@)(@@)(@@) | در ویس، آب در دهان می آید(@)(@@) شیخ اوحد الدین کرمانی PageV01P361(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0365.jpg)(@)(@)(@@) ~~2063 ای از رخ و زلف تومه و مشک خجل در چاه زنخدان تو، ای شمع چگل(@)(@@) %~% لغیره %~% جان بر سر جان فتاد و، دل بر سر دل! %~% حوری ثو، نه آدمی، زنوری، نه ز گل(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2064 ای خوش سخنت، مرهم هر خسته تنی %~% وی لعل تو، مهر لب هر طعنه زنی(@)(@@) (@@) گیرم، که زبان کشند در هر دهنی %~% در تنگ دهان تو، نگنجد سخنی(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 2065 عکس رخ تو چه [نکه] برآیینه فتد %~% از رشک رخ تو، مهر در کینه فتد(@)(@@) (@@) خورشید دگر شاید از سینهآ تو %~% چون سایهآ غبغب تو، بر سینه فتد(@)(@@)(@@)(@@) | نمط چهاردهم(@)(@@) در تشبیهات کمر ومیان(@)(@@) (@@) 2066 در عهد تو، عقل باده را مست نکرد %~% کس جزتو، بنای کفر را پست نکرد(@)(@@) (@@) زان روز، که پای در رکاب آوردی %~% جز لعل، کسی در کمرت دست نکرد(@)(@@)(@@)(@@) | ابوالفضل تبریزی(@)(@@) (@@) 2067 گرچه ز میانت به ستوه است کمر %~% زان گنبد سیمین، به شکوه است کمر(@)(@@) (@@) فی 
ms207	 الجمله، کمر ز کوه سیمین مگشا %~% زیرا که خود آرایش کوه است کمر(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2068 لاله، به رخ چو ارغوانت نرسد %~% نسرین، به بر چو پرنیانت نرسد(@)(@@) ~~هر چند، که زلف توست در پای کشان از زلف تو، مویی به میانت نرسد(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2069 بر دی دل و، کارم به زیان آوردی وز خوی بدت، مرا به جان آوردی(@)(@@) (@@) دل چون کمرت بسی به خود بر پیچد %~% از نازکیی که بر میان آوردی(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 2070 طبعم، چو دو چشم تو دژم می گردد %~% پشتم، چو دو زلف تو به خم می گردد(@)(@@) ~~عانم، به امید آنکه از غم برهدهمچون کمرت، گرد عدم می گردد!(@)(@)PageV01P362(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0366.jpg)(@)(@)(@@)(@@)(@@) | ال(@)(@@) ~~2071 ذوقی است لب تورا، که جان دریابد رمزی است، که جان عاشقان دریابد(@)(@@) (@@) اندر کمر تو، معنیی باریک است %~% من بندهآ آن کسم، که آن دریابد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 207 ای گشته فراخ از دهنت دلتنگی %~% وی روز مرا با شب تو یکرنگی(@)(@@) (@@) چون آب، سرین تو چرا لرزان است؟ %~% %~% من، کوه ندیدهام بدین بی سنگی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2073 تا مهر تو، در میان جان دوخته ایم %~% از هر چه نه یاد تو، دهان دوخته ایم(@)(@@) (@@) ما کیسهای از میان تولاغرتر %~% بس کیسه، که ما بر آن میان دوخته ایم(@)(@@) (@@) 207 تا گرد قمره خط معنبر بستی %~% اوله %~% بر جان و دلم، در طرب در بستی(@)(@@) (@@) من، کوه و کمر گرفته ام از غم تو %~% بر کوه چو سیمت، کمر زربستی(@)(@@) (@@) 2075 گرچه چو حدیث، در زبانت گیریم %~% وله %~% خواهیم، که در میان جانت گیریم(@)(@@) (@@) روزی، چو کمر به گرد تو حلقه کنیم %~% وز بهر کنار، در میانت گیریم(@)(@@)(@@)(@@) | کمال مراغه ای(@)(@@) (@@) 2076 عشق من وخوبی تو، زادند به هم %~% چشم من و روی تو، گشادند به هم(@)(@@) (@@) دست ودل من، چشم و میان و کمرت %~% ازین سان دو سه تنگ، چون فتادند به هم!(@)(@@)(@@)(@@) | زکی مراغه ای(@)(@@) ~~207 دل جزغم تو، غذای جان 
ms208	 هیچ نداشت سودی نه، ز تو به جززیان هیچ نداشت(@)(@@) (@@) یرا که هر آن عهد که کردی به وفا %~% همچون کمرتو، در میان هیچ نداشت(@)(@@)(@@)(@@) | قاضی شهاب(@)(@@) (@@) 2078 آنها، که بتان ختن و چین بینند %~% کی چون بت من، چنین به آیین بینند(@)(@@) (@@) صاحبنظران عالم، امروز کجاند %~% تا در بدن تو، برج سیمین بینند PageV01P363(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0367.jpg)(@)(@)(@@)(@@)(@@) | کمال ابوعمر ابهری(@)(@@) (@@) 2079 از چشم و رخ من، آن نگار دلبر %~% هم گوهر سرخ کرد غارت، هم زر(@)(@@) (@@) چون دید که من بر او شدم عاشقتر %~% زان نقش کلاه کرد و، زین طرف کمر(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 2080 دوش از سر لطف، با بت عشوه پرست %~% آن، گشته جهانی ز می مهرش مست(@)(@@) (@@) گفتم که: میان تو به دست آرم، گفت: %~% هیچ است میان، چه داری از هیچ به دست؟(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2081 تا گوش تو، از حلقهآ زر خوبتر است(@)(@@) (@@) پیداست کزین... میانت چه برد %~% بر کوه زر گیر هر آنچ از کمر است(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 2082 گفتم: شب زلفت، به قمر نزدیک است %~% گفتا: غلطی، از آنکه شب تاریک است(@)(@@) (@@) گفتم: کمر تو در میان دارد هیچ %~% گفتا که: برو، که این سخن باریک است!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 2083 سروی، که دل مرا از او بر هیچ است %~% با چشمهآ لطفش، آب کوثر هیچ است(@)(@@) (@@) در وصف میانش، سخنی می گفتم %~% دل گفت: دراین میان، سخن در هیچ است!(@)(@@)(@@)(@@) | نظامی البخاری(@)(@@) (@@) 2084 از لطف، میان آن سمنبر هیچ است %~% وان چندان لطف بین، که اندر هیچ است(@)(@@) (@@) چون بر کمرش فتاد چشمم، گفتم: %~% بیچاره کمر نیز، چو من بر هیچ است(@)(@@)(@@)(@@) | الیاس(@)(@@) (@@) 2085 از حسن خود، آن نگار بی یار و شریک %~% می کرد حکایتی، ز دور و نزدیک(@)(@@) (@@) تا گفت: «قدم»، عبارتش عالی بود %~% حالی که «میان» گفت، سخن شد باریک!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2086 این سیمبران که زلف بر می بندند %~% در زیر کلاه شور و شر می بندند(@)(@@) ~~این طرفه، که در سرو 
ms209	 قبا می پوشند وین طرفه، که بر کوه کمر می بندند(@)(@@) کمال الدین ابوعمرابهری(@)(@@) (@@) 2087 می آمد و، بیدل دو هزار از چپ و راست %~% می دید نهانی که: که افتاد و که خاست(@)(@@) (@@) برطرف کمر، ببسته از زر شطری %~% فریاد شما، از این میان خواهد خاست PageV01P364(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0368.jpg)(@)(@)(@@)(@@)(@@) | کمال کامیار(@)(@@) ~~2088 دل کیست؟ که جفت اندهانش داری چان، حلقه صفت از کمرت خالی نیست(@)(@@) %~% وله %~% یا تن، که به هجر ناتوانش داری %~% یسند، که در بند میانش داری(@)(@@) ~~2089 زلفین تو را، ای صنم سیمین بر جززلف تو، حلقه گشته بر طرف کمر(@)(@@) %~% دیدم [که] نهاده [برا کمر گاه توسر %~% بر هیچ کمر، حلقه ندیدم عنبر(@)(@@)(@@)(@@) | قاضی ابوالمجد(@)(@@) ~~209 در لب، همه ساله قند داری پسرا از چیست میان تو ز من لاغر تر؟(@)(@@) %~% وز عنبر تر، کمند داری پسرا %~% با آن، همه کس به بند داری پسرا(@)(@@)(@@)(@@) | نجم الدین عبد العزیز(@)(@@) (@@) 2091 دی گفت بتم که: از بدی وزنیکی گفتم که: بگو شرح میان خود را %~%(@)(@@) می پرس زمن، چویافتی نزدیکی %~% گفتا که: نگفتمت بدین باریکی!(@)(@@)(@@)(@@) | شمس اهری(@)(@@) (@@) 2092 نازیدن آن شمع طرازی بینید رهیچ، کمر بسته به خون دل من %~%(@)(@@) لغیره %~% از بهر خدا، دوال بازی بینید! %~% زان شهرهآ روم، ترکتازی بینید(@)(@@) (@@) 2092 آن سیمبری، که زر خام است برش %~% بیزر، نتوان یافت بر سیمبرش(@)(@@) (@@) هر کیسه، که از صرهآ سیمش دوزی %~% بی زر همه بر هیچ بود چون کمرش(@)(@@)(@@)(@@) | صفی بیلقانی(@)(@@) ~~2094 درد دلم، آن سرو روان می داند چون مور، میان به خون من می بندد(@)(@@) %~% غمهام، به پیدا و نهان می داند %~% اریکترم از آن میابن می داند(@)(@@)(@@)(@@) | خلیل شروانی(@)(@@) (@@) 209 تا با من خسته دل، زبان در بستی %~% صد درد دل مرا، به جان در بستی(@)(@@) دیدی، که غمت به خون من می کوشد %~% تونیز، به کشتنم میان در بستی PageV01P365(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0369.jpg)(@)(@)(@@)(@@)(@@) | نمط پانزدهم(@)(@@)(@@)(@@) | در لباسهای او(@)(@@)(@@)(@@) | عزشروانی(@)(@@) (@@) 209 از رشکی قباچه توه 
ms210	 ای سرو سهی %~% درخونم، وز بالشت ای جان رهی(@)(@@) (@@) کاینت، همه روز تنگ در بر دارد %~% و آن را، همه شب توروی بر روی نهی!(@)(@@)(@@)(@@) | ابوالحسن طلحه(@)(@@) (@@) 2097 می رشک آید مرا، زپیراهن تو %~% وز گوی گریبان تو، در دامن تو(@)(@@) (@@) کاین بوسه همی زند، قدمهای تورا %~% وان را شب وروز، دست در گردن تو(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2098 مشکین سر زلف یار، و نازک تن اوکز ناز نگشت باد، پیرامن او(@)(@@) (@@) یارب، که چه فرخنده و خوب افتادهست %~% بخت کله و، طالع پیراهن او!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2099 از رنگ رخ تو، عشق صد رنگ آید %~% وز حسن تو، پای عقل در نسنگ آید(@)(@@) (@@) گر بر شکنی طرف کله را، چون ماه %~% با روی تو، ماه را قبا تنک آید(@)(@@)(@@)(@@) | رشید وطواط(@)(@@) (@@) 2100 یک روز، کله بر سر آن روی چوماه %~% پوشیده قبا، به چشمم آمد ناگاه(@)(@@) (@@) زان روز، شدم بستهآ تصحیف قبا %~% زان روز، شدم خستهآ مقلوب کلاه(@)(@@)(@@)(@@) | سنایی(@)(@@) ~~2101 در جامهآ فوطه، سخت خرم شدهایآشوب جهان و، شور عالم شدهای(@)(@@) (@@) در خواب، نگویی که چه دیدستی دوش %~% کامروز، چونقش فوطه درهم شده ای(@)(@@)(@@)(@@) | وله(@)(@@) ~~2102 آن فوطه مگر دام بلای است، که هست دلها همه اندر او، چوماهی در شست(@)(@@) ~~در گوشهآ هر خانه اش، افتاده خرابصد عاشق فبوطه پوش زنار پرست PageV01P366(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0370.jpg)(@)(@)(@@) ~~2103 در جامهآ ازرق، آن [بت] عشوه فروش گرنه فلک است، پس چرا همچوفلک(@)(@@) %~% اوله %~% چون ماه ز آسمان، پدید آمد دوش %~% هم زرق فروش آمد و، هم از رق پوش!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~گفتم که حدیث در کنم با تو، درست 210 بر لاله و مشک است، نشست کلهش(@)(@@) %~% ماییم چوزلف، زیر دست کلهش %~% بشکست مرا پشت، شکست کلهش(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2105 ای لعل لبت بهای فیروزهآ چرخ %~% مینای خطت، ورای فیروزهآ چرخ(@)(@@) ~~شب پوش و قبای تو، چنین نیکویند 2106 ای هر دو جهان، تو در جهان چون(@)(@@) باشی روزی بینی، کلاه فیروزهآ تو %~% الغیره %~% یا مرد 
ms211	 زمین و آسمان چون(@)(@@) باشی %~% منگر، که تواندرآن میان چون باشی! %~% آتش زده، در قبای فیروزهآ چرخ(@)(@@)(@@)(@@) | مسعود سعد(@)(@@) ~~2108 از کوفتن پای تو و، گشتن تو توان دیدن، ز روشنی تن تو 210(@)(@@) خورشید خجل شد، از رخ روشن تو %~% سراج %~% مه را نرسد، دست به پیرامن تو(@)(@@) %~% راز دل تو، برون [ز] پیراهن تو %~% لعبی است هر اندام تورا، برتن تو(@)(@@) (@@) ماهی تو و، از جیب توتا دامن تو %~% چون چرخ، همی گردد پیرامن تو(@)(@@) (@@) 2109 از مهر و مه، ای دوست، به دستار بهی %~% الغیره %~% لیکن به کله زهر دو صدبار بهی!(@)(@@) (@@) ای با من بیچاره به یک بوسه بخیل %~% دستار بیفکن، که کله دار بهی!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2110 بیراهن فوطهآ تو، گرد تن تو %~% کرده شب و روز، دست در گردن تو(@)(@@) (@@) منزلگه جان ماست، پیراهن تو %~% تا جدول حسن گشت، پیرامن تو PageV01P367(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0371.jpg)(@)(@)(@@)(@@)(@@) | مهذب شروانی(@)(@@) (@@) دستم، چو گریبان تو در گردن تو 2111 روزی بینی مرا، چو پیراهن تو %~%(@)(@@) گستاخ، در آمده به گرد تن تو %~% برپای تو سر نهاده، چون دامن تو(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2112 زلف تو به جز بند، چه دیگر دارد %~% بیرون ز دلی چند، چه دیگر دارد(@)(@@) (@@) وان کژ کلهت، زغارت چندین شهر %~% جز زلف پس افکند، چه دیگر دارد!(@)(@@)(@@)(@@) | سنایی(@)(@@) (@@) 2113 پیراهن فوطهآ تو، از روز نخست %~% دل برد و، به جان همی کند عزم درست(@)(@@) (@@) با چندان خانه ها که در فوطهآ توست %~% دل را به کدام خانه در، خواهم جست!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2114 چون لعل سخنگوی تو، شکر نبود %~% مانند سر زلف تو، عنبر نبود(@)(@@) (@@) گر بشکافد، دامن طاق گردون %~% وله %~% با دامن طاق تو، برابر نبود(@)(@@) ~~از عکس برت، جهان شود نورانی 2115 هر شب، که تو عزم خواب را ساز کنی(@)(@@) %~% در جهامهآ خواب رفتن، آغاز کنی %~% در حال، که گوی پیرهن باز کنی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2116 گفتی: شدهاند زان مه مهر گسل %~% ترکان همه چین و 
ms212	 چگل، خوار و خجل(@)(@@) (@@) از چین و چگل مگو، خطایی است عظیم %~% اوله %~% با چین قبایش، سخن چین و چگل(@)(@@) (@@) 2117 اکنون که بساخت وصل با ما، نفسی %~% کرد از من وتو، هجر تبرا نفسی(@)(@@) (@@) پگشای قبا و، جام می برکف نه %~% وز بند بدونیک، برون آنفسی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3118 ای کرده نهان تن چوجان را به حریر %~% و آراسته، جنت وجنان را به حریر(@)(@@) (@@) تن را به حریر چند پوشی، اخر %~% پوشید کسی آب روان را به حریر؟(@)(@)PageV01P368(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0372.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2119 چشم تو، به کشتنم فسون می سازدزین پیش نمی ساخت، کنون می سازد(@)(@@) ~~گویند: کتان و مه نسازند به هم پس پیرهن تو، با تو چون می سازد؟(@)(@@)(@@)(@@) | نمط شانزدهم(@)(@@) در بزرگواری و نازاو(@)(@@)(@@)(@@) | عز شروانی(@)(@@) ~~خلقی به تومشغول و، توفارغ زهمه 2120 از غایت لطف، آب و هوایی گویی(@)(@@) %~% ای بیخبر از خدا، خدایی گویی! %~% وز شیرینی، مهر گیایی گویی(@)(@@)(@@)(@@) | شرف ساوی(@)(@@) ~~هر جا که منم، به عشق او مشغولم 2121 نه با منش، از روی وفا رایی هست(@)(@@) %~% نه در دل من، جز او تمنایی هست %~% او، فارغ از آنکه عاشقی جایی هست!(@)(@@)(@@)(@@) | سنایی(@)(@@) (@@) 2122 یک دل نبری، که دیده جیحون نکنی %~% و آنگه ندهی زدست، تا خون نکنی(@)(@@) (@@) شب نیست، که صد ناز دگرگون نکنی %~% چون می کنی و می رودت، چون نکنی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2123 یک شعله ز نور خویش، پیدا نکنی %~% تا زآب، دو چشم من چو دریا نکنی(@)(@@) (@@) ما اینهمه باد عجب، کاندر سرتوست %~% در خاک نگه کنی و، در ما نکنی!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2125 برخیزم و، آن زلف درازش بکشم %~% ور ناز کند، دو باره بازش بکشم!(@)(@@) (@@) با من چه کند؟ جز آنکه خونم بخورد! %~% با او چه کنم؟ جز آنکه نازش بکشم!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 2125 ای دل، تو که باشی که وصالش جویی %~% یا نیز، حدیث زلف وخالش گویی(@)(@@) (@@) این مایه نه بس بود، که هر شب تا روز %~% خاک سم مرکب 
ms213	 خیالش بویی!(@)(@)PageV01P369(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0373.jpg)(@)(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2126 چون در تو، نیارم که پیاپی نگرم %~% دزدیده به زیر چشم، تا کی نگرم؟(@)(@@) (@@) من خام طمع، وصل کسی می طلبم %~% اوله %~% کم زهره آن نیست، که در وی نگرم!(@)(@@) (@@) 2127 آهو برهای، که شد شکارش عاشق %~% جز جان نکند زدل نثارش عاشق(@)(@@) (@@) یارب، نگهش دار که در دور هوس %~% یک معشوق است و، صد هزارش عاشق!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 2128 خورشید به حسن، در جمالت نرسد %~% دست طمع کس، به وصالت نرسد(@)(@@) (@@) من، با خر لنگ چون رسم درپی تو؟ %~% چون وهم، دو اسبه در خیالت نرسد!(@)(@@)(@@)(@@) | رکن خویی(@)(@@) (@@) 2129 دارم سر خدمت تو، گر سر نکشی %~% دامن ز من و کار من، اندر نکشی(@)(@@) (@@) من، ناز تو با جان و دل و دیده کشم %~% گر تو، دگری به روی من برنکشی!(@)(@@)(@@)(@@) | برهان الدین(@)(@@) (@@) 2130 عشاق، سپر از توفکندند، مکن %~% بر آتش عشقت چو سپندند، مکن(@)(@@) (@@) هر چند، فلک می کشد این مردم را %~% دوران توست، بر توبندند، مکن!(@)(@@) برهان الدین حسین(@)(@@) (@@) 2131 بی کام خود، ارچه دیر دیرت بینم %~% کامم همه آن است، که سیرت بینم(@)(@@) (@@) تو حاضری ای نگار، وزهیبت تو %~% آن زهره ندارم، که دلیرت بینم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2132 شمعی، سر پروانه نداری، رسدت! %~% در کوی وفا خانه نداری، رسدت!(@)(@@) (@@) طبعی به کمال و، رای موزون داری %~% ار، زان سر دیوانه نداری؟ رسدت!(@)(@@) فخر الدین ابوبکر ابهری(@)(@@) (@@) 2132 ای دل، توبه وصل آن سمنبر نرسی %~% چون سایه در آن چهرهآ چون خور نرسی(@)(@@) (@@) گر خواب شوی، به چشمش اندرنایی %~% ور باد شوی، به گردش اندر نرسی!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~213 دارم زتو چشم وصل، گویی : چه کسم؟ در تو تو رسی و، روزگاری باید(@)(@@) %~% با این سر و گوش، ملک عشقت نه بسم %~% تا من توشوم، پس آنگهی در تو رسم!(@)(@)PageV01P370(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0374.jpg)(@)(@)(@@)(@@)(@@) | مهذب نیشابوری(@)(@@) (@@) 2135 ای وصل تو برتر از تمنای امید %~% نایخته بماند با تو، سودای امید(@)(@@) (@@) من در تو کجا 
ms214	 رسم، که آنجا که تویی %~% نه دست هوس رسید و، نه پای امید!(@)(@@)(@@)(@@) | یمین(@)(@@) (@@) 2136 با رنگ رخت، لالهآ خودرو زکجا؟ %~% با لطف خوشت، بهشت خوشبوز کجا؟(@)(@@) (@@) دل یاد تو کرد، آرزو گفت: خموش! %~% اینجا که تویی، تواز کجا او زکجا!(@)(@@)(@@)(@@) | عز شروانی(@)(@@) (@@) 2137 با آنکه به جان آمدم، از خوی بدش %~% صد بار فزون، خواندهام جان خودش(@)(@@) (@@) گر دل به وفای اونهم، می رسدم %~% ورقصد به جان من کند، می رسدش!(@)(@@)(@@)(@@) | نجیب(@)(@@) (@@) 2138 ای همچو بصر عزیز، ما را بر چشم %~% چون چشمهآ آفتاب، اندر هر چشم(@)(@@) (@@) از عجب رسیدهای به جایی، که تورا %~% الغیره %~% جز مردم دیده، در نیابد در چشم(@)(@@) (@@) 2139 خورشید، به حسن دلبر ما نرسد %~% حورا به جمال او رسد، یا نرسد(@)(@@) (@@) کانجا برسید باز، از غایت حسن %~% کاندیشهآ هیچ زیرک، آنجا نرسد(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2140 زینگونه، که حال ناپسندیدهآ ماست حسن رخ تو، چه لایق دیدهآ ماست(@)(@@) (@@) عشق تو، به کیقباد وخسرو نرسد %~% سوداست، که در دماغ پوسیدهآ ماست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2141 وصلت صنما، به هر گدایی نرسد %~% ملک غم تو، به بینوایی نرسد(@)(@@) (@@) دون همتم، ار نه خاک پایت شدمی %~% با همت دون، مرد به جایی نرسد!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2142 شغلم زجهان، تو سازدانی کردن %~% بند دل من، تو باز دانی کردن(@)(@@) (@@) ناز همه کس کشیدمی، نتوانم %~% ناز تو کشم، که ناز دانی کردن!(@)(@)PageV01P371(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0375.jpg)(@)(@)(@@)(@@)(@@) | نمط هفدهم(@)(@@)(@@)(@@) | درخوی او(@)(@@)(@@)(@@) | سنایی(@)(@@) ~~21،3 رویی داری، چنانکه دل بگشاید زلفی داری، چنانکه جان برباید(@)(@@) (@@) لفظی داری، چنانکه عقل افزاید %~% جز خوی نکو، تو را چه در می باید!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2144 چون آب، به هر نشیب جویی داری %~% چون باد، ز هر شکوفه بویی داری(@)(@@) (@@) چون ماه، به هر جانب رویی داری %~% نادر طبعی و، طرفه خویی داری!(@)(@@)(@@)(@@) | ابوالحسن طلحه(@)(@@) ~~2145 ای تیره شده آب به جوی تو، زتو وزخوی تو، بر نخورده روی توزتو(@)(@@) (@@) عشاق زمانه را، فراغت دادهست %~% روی توز دیگران و، خوی توزتو!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2146 
ms215	 با عاشق مبتلاست، مردانگیت با مردم آشناست، بیگانگیت(@)(@@) ~~فی الجمله، زخوی توچه گویم با تودیوانه همی شوم، ز دیوانگیت(@)(@@)(@@)(@@) | وله(@)(@@) ~~2147 مه، در سفر از عشق نکورو یی توست شب، تیره دل از رشک سیه مویی توست(@)(@@) (@@) عالم، همه پر حدیث نیکویی توست %~% بدگویی دشمنان، ز بدخویی توست(@)(@@)(@@)(@@) | ادیب صابر(@)(@@) ~~21،8 مه بر طبقی نهاده، کاین روی من است وزمشک هزار حلقه، کاین موی من است(@)(@@) ~~گل بر کف خود کرده، که این بوی من است شوری به جهان فکنده، کاین خوی من است(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2149 گاهی به سخن زهر شوی، گاهی قندگاهیم زتوسود بود، گاه گزند(@)(@@) (@@) از خوی توعاجز شدم، ای سرو بلند %~% کارتو، چو زلف توست بند اندر بند PageV01P372(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0376.jpg)(@)(@)(@@)(@@)(@@) | علی حسن(@)(@@) (@@) 2150 ای عادت تو، یار موافق بودن %~% وی پیشهآ تو، به وعده صادق بودن(@)(@@) (@@) بر موجب این دو خوی نیکو، که تو راست %~% جز بر تو، حلال نیست عاشق بودن!(@)(@@)(@@)(@@) | شرف اعرج(@)(@@) (@@) 215 گر با تو وفا کنم، نمی دارد سود %~% ورنیز جفا کنم، بیازاری زود(@)(@@) (@@) مانند لب توام، همی باید بود %~% باریک و نزار و خامش و خون آلود!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2152 آتش رویا، زغایت بدخویی %~% پیوسته، رخم به آب حسرت شویی(@)(@@) (@@) بادی در سر، که چه؟ که من نیکویم! %~% با خوی تو، خاک بر سر نیکویی!(@)(@@)(@@)(@@) | فخر مبارکشاه(@)(@@) (@@) 2153 آن دل، که ز عشق تو کمر می بندد %~% نیکو طرفی، که از تو بر می بندد(@)(@@) (@@) در عشق تو، آب چشمم از سر بگذشت %~% خوی تو، هنوز آب ز سر می بندد(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2154 هر چند، به نیکوی سزاورتری %~% با عاشق خویشتن نکوکار تری(@)(@@) (@@) هرگز نبود حسن و وفا با هم و، تو %~% هر چند نکوتری، وفادار تری!(@)(@@)(@@)(@@) | سد ابوبد(؟)(@)(@@) (@@) 2155 آن زلف بدان خوشی و خوشبویی چیست؟ %~% وان لعل بدان فریب و دلجویی چیست؟(@)(@@) (@@) با این دو رفیق نیک، در عالم حسن %~% نور دل من، اینهمه بدخویی چیست؟(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~2156 ای 
ms216	 از گل و مشک، موی و رویت خوشتروزنکهت جان پاک، بویت خوشتر(@)(@@) ~~وز هشت بهشت عدن، کویت خوشترزین هر سه چهار پنج، خویت خوشتر!(@)(@@)(@@)(@@) | وله(@)(@@) ~~2157 گیسوی تو را، زمشک و عنبر دیدم در حسن، رخت ز ماه برتر دیدم(@)(@@) (@@) با آب، تن تو را برابر دیدم %~% خوی تو، از اینها همه خوشتر دیدم!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2158 گفتم خوشی از بوی توام باید گفت وزقد کش و روی توام باید گفت(@)(@@)(@@)(@@) | وین پل، خوشی از خوی توام باید گفت!(@)(@)PageV01P373(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0377.jpg)(@)(@)(@@)(@@)(@@) | له(@)(@@) ~~2159 من، خوی تورا چوجان خوش انگاشتهام زان رو، علم امید افراشته ام(@)(@@) (@@) از خوی توجان، کنون که آگاه شدم %~% از جان عزیز، امید برداشته ام(@)(@@)(@@)(@@) | نمط هجدهم(@)(@@)(@@)(@@) | در آمد وشد او(@)(@@)(@@)(@@) | عز شروانی(@)(@@) (@@) 2160 تا پیش من آن نگارچین آمد و، شد %~% بر من حشری زمهر و کین آمد و، شد(@)(@@) (@@) شد، عقل ودلم هر دو، زآمد شد او %~% لغیره %~% کس یاد ندارد، این چنین آمد و شد(@)(@@) (@@) 2161 چون می رود آن نگار، یا می آید %~% در دیدهآ هر کس به سزا می آید(@)(@@) (@@) می میرم ازاین غصه، که بینایی من %~% در چشم کسی دگر مرا می آید(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2162 می آمدم و، سرو روانم می رفت %~% چه سرو، که ماه آسمانم می رفت(@)(@@) (@@) شرح سبکی رفتنش، نتوان داد %~% فی الجمله دلم می شد و، جانم می رفت(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2163 از لطف، نیاید اندر آغوش تنت %~% وزناز، نگنجد سخن اندر دهنت(@)(@@) (@@) وز چابکی قدت، چوآیی و روی %~% بر شخص تورقص می کند، پیرهنت!(@)(@@)(@@)(@@) | رضی الدین(@)(@@) ~~2164 ای باد صبا زلف تورا تاب زدهعشق توبه دیده در، ره خواب زده.(@)(@@) (@@) فراش غمت، جای خرامیدن تو %~% از دیدهآ صد هزار کس، آب زده!(@)(@@)(@@)(@@) | مرتضی(@)(@@) ~~2164 بر رهگذرت، زخاک جان می رویدوزخون دو دیده، ارغوان می روید(@)(@@) (@@) وز بس رخ عاشقان که فرش ره توست %~% اوله %~% زیر قدم تو، زعفران می روید!(@)(@@) (@@) ار هیچ به کوی بیدلان، برگذری 216 تا 
ms217	 از لب تو، شگر قاتل چینند %~%(@)(@@) از خاک ره تو، سالها دل چینند! %~% بر رهگذرت، جان و دل از گل چینند PageV01P374(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0378.jpg)(@)(@)(@@) صدر خجندی(@)(@@) ~~زان می، که خروس در صبوحش چوبدید 2161 می آمد وز شبانه می در سرداشت(@)(@@) %~% وز بهر صبوح، لب به لب ساغر داشت %~% پنداشت که چشم اوست، افغان برداشت!(@)(@@) کمال اسماعیل(@)(@@) ~~این بتوانم، که هر کجا پای نهی 2168 گر نتوانم، که با تو ساغر گیرم(@)(@@) %~% یا تنگ به آغوش خودت در گیرم %~% در حال، به بوسه خاک از او برگیرم(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~216 چون دید، که در غمش شدم بی خور و خواب ناگه ز درم در آمد، آن در خوشاب(@)(@@) (@@) لب بر لب من نهاد و، نرمک می گفت: %~% جانت چوبه لب رسید، خود را دریاب!(@)(@@)(@@)(@@) | سید غزنوی(@)(@@) (@@) باری نایی و، نزد من ننشینی 217 دل بی تو، زعافیت جدا افتادهست %~%(@)(@@) تا با تو بگویم، که چها افتادهست! %~% وین جان عزیز، در بلا افتادهست(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 217 ماهی تو ومن کمانم، ای شهر آرای %~% اندر ماهی دو رون نزدیک من آی(@)(@@) (@@) اینک بنگر، که ماه گردون پیمای %~% هر ماه، دو روز در کمان دارد جای(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) (@@) 2171 خیزید، که برگ وصل دلبر سازیم %~% وقت خوش وعیش به نوا برسازیم(@)(@@) (@@) بر رهگذرش، ز دیدگان آب زنیم %~% خاک قدمش، زمشک وعنبر سازیم(@)(@@)(@@)(@@) | صدر زنجانی(@)(@@) (@@) تا امشکی دگر بیاییم به هم 2173 از پیش من ای یار دل افروز، مرو %~%(@)(@@) اندیشه کن از آه جهانسوز، مرو %~% از بهر خدای را، یک امروز مرو(@)(@@) جمال عبدالرزاق(@)(@@) ~~217 خاکی، که بر او پای نهد دلجویم پنهان بروم، دیده بر آن خاک نهم(@)(@@) %~% یعنی: چیزی گمشده را می جویم! %~% از بیم زبان حاسد و بدگویم PageV01P375(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0379.jpg)(@)(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~2175 از مشرق، چون علامت صبح بخاست معشوقه به خشم، چادر و موزه بخواست(@)(@@) ~~می رفت و همی گفت که: ای صبح رواست تا شب نرسد، هر چه کنی حکم تو 
ms218	 راست:(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2176 امروز، ندانم به چه دست آمده ای %~% کز اول بامداد، مست آمده ای(@)(@@) (@@) دست از تو، به هیچ حال کوته نکنم %~% زیرا که به خون دل به دست آمده ای!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 2177 گر ز آمدنت شمار می باید کرد %~% در راه تو، انتظار می باید کرد(@)(@@) (@@) پس باز فرست دل، که با دیده و جان %~% در یای توام، نشار می باید کرد(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) 2178 دی، دلبر من ز بوستان می آمد %~% دامن به زمین کشان کشان می آمد(@)(@@) (@@) من، دست به سر زنان زنان می رفتم %~% او، چنگ به بر زنان زنان می آمد(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2179 دی، نزد من آن دلستان(؟) آمد %~% وان عهد شکن، با سر پیمان آمد(@)(@@) (@@) آن لحظه، که او در آمد از در خندان %~% وله %~% پنداشت، دلم جان مرا جان آمد(@)(@@) (@@) 2180 دیروز، که یار دلستان می آمد %~% وان سرو روان، همچو روان می آمد(@)(@@) (@@) گریان گریان، در طلبش می رفتم %~% او، خنده زنان خنده زنان می آمد(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 2181 گویند که آن سرو روان می آید %~% وان ماه چو ماه آسمان می آید(@)(@@) (@@) از ننک وجود خویش، وزدست خودم %~% الغیره %~% تا برهاند، ز بهر آن می آید(@)(@@) (@@) 2182 ای آنکه چو جان و دیده باشی ما را %~% وزجمله جهان، گزیده باشی ما را(@)(@@) (@@) بر ما گذری و، دیده نادیده کنی %~% لغیره %~% نادیده مکن، چو دیده باشی ما را(@)(@@) (@@) و آنگاه، به آمد شدن از سرپای 2183 گلرخ صنمی، به زلف مشکینم کشت %~%(@)(@@) از بد خویی و، از سر کینم کشت %~% شادی جهان، در دل غمگینم کشت PageV01P376(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0380.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~218 کس را نبود، دو چشم بادام چناناز غالیه زلف وز گل اندام چنان(@)(@@) ~~زنهار، منه پیش رهی گام چنان از چشم بدان بترس و، مخرام چنان(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2185 از رشک قدت، سرو چمن می لرزد %~% وز شرم رخت، برگ سمن می لرزد(@)(@@) ~~بخرام، که چون پرتو خورشید برآب 
ms219	 بر تو، در و دیوار چو من می لرزد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2186 افتد، که به چشم لطف درما نگری %~% در کار من غریب و شیدا نگری؟(@)(@@) (@@) زانت چه زیان؟ کنه چون به ما برگذری %~% چون من به رخت در نگرم، وانگری(@)(@@)(@@)(@@) | شیخ کرمانی(@)(@@) (@@) 2187 گفتی: بروم، مرو، مرنجان جانم %~% کز دیده برون جهد، چومرجان جانم(@)(@@) (@@) گر تو بروی، زمن بخواهد رفتن %~% از دل دل و، از تن تن و، ازجان جانم(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2188 ناکرده مرا وصل تو خشنود، مرو وز می لب لعل، نیم آلود مرو(@)(@@) (@@) دیر آیی و، کم نشینی و، زود روی %~% نه، دیرمیا، کم منشین، زود مرو!(@)(@@)(@@)(@@) | ثیر(@)(@@) (@@) 2189 آمد یارم غم از دلم زود ببرد %~% رنجی که از آن دلم بیاسود، ببرد(@)(@@) (@@) صد جان دگر، به آمدن داد مرا %~% لیکن چو برفت، آنچه مرا بود ببرد(@)(@@)(@@)(@@) | جمال سقا(@)(@@) ~~219 می آمد و، خوش خوش نظری می افکند در هر نظر، از لب شکری می افکند(@)(@@) (@@) خوش خوش، به کرشمه سوی ما می نگرید %~% وز ناز، نظر بر دگری می افکند!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2191 می آمد و، در زلف گره می افکند تیر مژه را برو به زه می افکند(@)(@@) ~~تشویر، از آن در دل و جان می انداخت تسشویش، از آن در که و مه می افکند(@)(@@)(@@)(@@) | جمال عصفوری(@)(@@) (@@) 219 می آمد و، خندهآ چو شکر می زد %~% جان و دل عاشقان، به هم بر می زد(@)(@@) (@@) افزون زهزار عاشق سوخته دل %~% فریاد کنان، دو دست بر سرمی زد PageV01P377(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0381.jpg)(@)(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) (@@) 2193 می آمد و، از نوک مژه در می سفت %~% خاک ره آشتی، به مژگان می رفت!(@)(@@) (@@) می گفت که: از تودارم این سودا من %~% گر چه نه چنین بود، ولیکن می گفت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2194 می آمد و، کرده نرگس رعنا را %~% پر آب و، خراشیده رخ زیبا را(@)(@@) (@@) چندانکه مراعات دلش می کردم %~% می گفت که: در کار خدا کن ما را!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2195 
ms220	 می آمد یارم، شکر از لب باران %~% در بسته میان، به شیوهآ عیاران!(@)(@@) (@@) خوی بر رخ او، چنانکه بر گل باران %~% رخساره چومی در قدح میخواران!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2196 می آمد و، از جام طرب مست شده زلفش چونهاد کارها، پست شده(@)(@@) (@@) چون دید مرا، به زیر لب در می گفت: %~% پیداست که هست، کارت از دست شده!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2197 می آمد و، چهره از عرق تر کرده %~% چوگان به کف و، اسب زجا برکرده(@)(@@) (@@) و اندر خم زلفهای گرد آلودش %~% شهری دل خسته، خاک بر سر کرده(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2198 می آمد و، چون زلف دوتا می افتاد %~% او در من و، خلق در بلا می افتاد(@)(@@) (@@) چون دید، که چون غنچه لبش می بوسم %~% از قهقهه، چون گل به قفا می افتاد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2199 می آمد و، سر کرده گران بر بنده %~% وز کبر نگفت ««مردهای یا زنده؟»(@)(@@) (@@) من در پی او، عقیق می باریدم %~% او چون گل ولاله، می شکفت از خنده!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2200 می آمد، و، از هجر تبرا می کرد %~% وز اشک مژه، کنتار دریا می کرد(@)(@@) (@@) از جمله، لطافتی که با ما می کرد %~% هر چند زدل نبود، زیبا می کرد(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2201 می آمد و، بر چهره ایازی بسته وززر کمری، به ترکتازی بصسته(@)(@@) (@@) بر فرق، زچابکی میان چپ و راست %~% جفتی رسن، از برای بازی بسته PageV01P378(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0382.jpg)(@)(@)(@@) (@@) 2202 می آمد گرم و مست و بردست شراب %~% زلفش زعرق، فتاده چون شست در آب(@)(@@) (@@) می کرد زمستی، دل هشیاران را %~% از زلف چوشست و نرگس مست، خراب(@)(@@)(@@)(@@) | فلکی شروانی(@)(@@) (@@) 22،3 من می رفتم، خمار در سر ز شراب %~% او می آمد، به روی بر بسته نقاب(@)(@@) (@@) گفتم: چاره، گفت: نمی دانم کرد %~% الغیره %~% گفتم: آخر، گفت: همین است جواب!(@)(@@) (@@) 2204 مسی آمد یار من، تسر و تسازه چو آب %~% می کرد دلم، در آتش هجر کباب(@)(@@) (@@) در دست گرفته خنجر آبگون (؟) %~% بر 