104 / 12444)، و " الكامل 
ms102	 في الضعفاء " (1/ 325 / 153)، و " تهذيب الكمال " (3/ 210 / 491)، و " الكاشف " (1/ 250 / 411) و " ميزان الاعتدال " (1/ 958 / 2251)، و " المقتنى في سرد الكنى " (1/ 70 / 215) و " المغني في الضعفاء " (1/ 88 / 725) و " سير أعلام النبلاء " (11/ 176 / 77)، و " الكشف الحثيث " (72/ 155): و " لسان الميزان " (7/ 178 / 2337)، و " تهذيب التهذيب (1/ 292 / 606)، و " تقريب التهذيب " (49/ 492) " و " رجال تفسير الطبري " (48/ 192).(@)(@@)(@@)(@@) | 57 - (@)(@@) – أبو العالية العبدي (6392)(@)(@@) (طب: 8 ر / 2 ش)(@)(@@) (تس: 6 ر / 1 ش)، و (تخ: 1 ر / 1 ش)، و (ته: 1 ر / 1 ش)(@)(@@) أبو العالية، إسماعيل بن الهيثم بن عثمان، اليشكري، العبدي، البصري، ثم الرقي توفي بعد سنة خمسين ومائتين، من العاشرة، وثقه الخطيب البغدادي.(@)(@@) روى عن: أبي قتيبة [سلم بن قتيبة] (تس 6392 و 6393 و 9719 و 26868 و 27373 و 27374، و (تخ 1/ 238)، وعبد الوهاب بن عبد المجيد الثقفي (ته 3083) " وحماد بن واقد العيشي " تهذيب الكمال " (7/ 289 / 1491) " وأبي عاصم الضحاك بن مخلد النبيل " الكفاية في علم الرواية " (1/ 145) " وأبي سحيم مبارك بن عبد الله البناني البصري " الكامل " (6/ 321 / 1802)(@)(@@) PageV01P138(@)(@@) روى عنه: أبو عروبة [الحسين بن محمد بن أبي معشر الحراني] " المقتنى في سرد الكنى " (1/ 336 / 3396)، وعبد الله بن أبي سفيان " الكامل " (6/ 321 / 1802) ومحمد بن إسحاق بن خزيمة " المقتنى في سرد الكنى " (1/ 336 / 3396) " وأبو حامد محمد بن هارون الحضرمي " سنن الدارقطني " (2/ 157 / 7) وأبو محمد، يحيى بن محمد بن صاعد " الكفاية في علم الرواية " (1/ 145).(@)(@@) التعديل والتجريح: ذكر الخطيب البغدادي في " الكفاية في علم الرواية " (1/ 145) قال، " إن أبا العالية العبدي كان قد أخطأ في رواية حديث رواه من طريق أبي عاصم حيث قال: ثنا عزرة بن ثابت عن علباء بن أحمر اليشكري عن أبي زيد الأنصاري قال: أتاني رسول الله صلى الله عليه وسلم فقال لي: " يا أبا زيد! هل عندك من شيء؟ قلت: ما عندي إلا خل. قال: هاته. فنعم الإدام الخل ".(@)(@@) قال ابن صاعد: " وهذا حديث غريب الإسناد ما سمعناه إلا منه ".(@)(@@) ثم قال الخطيب بسنده عن أبي عروبة: " قال لنا أبو العالية حين حدثنا بهذا الحديث " " قد رجعت عنه 
ms103	 ".(@)(@@) قلت: وهذا يشعر بثقته وعدالته " وعدم إصراره على الخطأ بعد معرفته، رحمه الله، قال الشيخان شاكر في تحقيقهما " لتفسير الطبري " (6/ 73 / 6295): " شيخ الطبري لم نجد له ترجمة ولا ذكرا في شيء من المراجع، إلا رواية الطبري هذا الخبر والذي بعده وروايته عنه في " التاريخ " مرة واحدة عن أبي قتيبة أيضا " انتهى.(@)(@@) قلت: بل وقفت له على ترجمة مختصرة في " المقتنى في سرد الكنى "! ووقفت له على ذكر في كتب التراجم والحديث التي استخرجت منها معجم شيوخه وتلاميذه.(@)(@@) وأخرج عنه الطبري في " التفسير، في أربعة مواضع غير التي أشار إليها الشيخ شاكر، رحمه الله، وقد فصلتها كما رأيت.(@)(@@) وقد سقط من كنيته في الأثر رقم (6393) حرف (ة) بحيث صار (أبو العالي).(@)(@@) وأخرج له الطبري في " التهذيب " الأثر (3083) عن عبد الوهاب [بن عبد المجيد الثقفي](@)(@@) PageV01P139(@)(@@) وكذلك في " التاريخ " (1/ 238) عن أبي قتيبة أيضا.(@)(@@) وانظر: " المقتنى في سرد الكنى " (1/ 336 / 3396)، و " رجال تفسير الطبري " (48/ 193).(@)(@@) [1] باب الألف (من اسمه أيوب)(@)(@@)(@@)(@@) | 58 - (@)(@@) أبو سليمان البغدادي (16988)(@)(@@) (طب: 6 ر / 4 ش)(@)(@@) (تس: 1 ر / 1 ش) و (ته: 5 ر / 3 ش)(@)(@@) أبو سليمان " أيوب بن إسحاق بن إبراهيم بن سافر، وقيل: سافري - وهو أخو يحيى بن إسحاق البغدادي، نزيل الرملة، ومصر. توفي بدمشق، يوم الأحد، لإحدى عشرة ليلة بقيت من شهر ربيع الآخر سنة ستين ومائتين، وقيل: سنة تسع وخمسين ومائتين. من العاشرة صدوق.(@)(@@) روى عن: أحمد بن إسحاق (ته 1224)، وعبد الله بن رجاء الغداني (تس 16988) وقبيصة [بن عقبة السوائي] (ته 402 و 403 و 1225)، ومسلم بن إبراهيم (ته 2958) وأحمد بن حنبل، مسائل جرح وتعديل، " سير أعلام النبلاء " (7/ 46)، وأبي الجواب [الأحوص بن الجواب التيمي الكوفي] " الجرح والتعديل " (2/ 241 / 856)، وخالد بن مخلد القطواني وزكريا بن عدي وعثمان بن أبي شيبة " تهذيب الكمال " (20/ 518)، وعلي بن قادم " مسند أبي عوانة " (1/ 87 / 261) وعلي بن المديني - مسائل جرح وتعديل - " تهذيب الكمال " (2/ 422) وعمر بن حفص بن غياث " مسند أبي عوانة " (4/ 412 / 7141) وأبي يعلى محمد بن الصلت " مسند أبي عوانة " (4/ 92 / 6132)، ومحمد بن 
ms104	 عبد الله الأنصاري، ومسلم بن إبراهيم " الكامل " (5/ 99) ومعاوية بن عمرو، ومعلى بن منصور الرازي " الجرح والتعديل " (2/ 241 / 856)، وموسى بن داود الضبي، وأبي حذيفة موسى بن مسعود، ويحيى بن معين، - مسائل جرح وتعديل، " الكامل " (3/ 209 / 707) وأبي بكر بن أبي شيبة " تهذيب الكمال " (20/ 518)، وأبي رجاء السندي " تاريخ بغداد "(@)(@@) PageV01P140(@)(@@) (13/ 436) وأبي نصر التمار " تلخيص الحبير " (4/ 171 / 2054).(@)(@@) روى عنه: أحمد بن شبويه المروزي " الجرح والتعديل " (2/ 55 / 71)، وسلامة بن محمود القيسي - مسائل جرح وتعديل. " تاريخ بغداد " (13/ 436) وابن علي الحافظ، وجماعة من الغرباء، وكتب عنه عبد الرحمن بن أبي حاتم بالرملة " الجرح والتعديل " (2/ 241 / 856)، ومحمد بن إسحاق بن خزيمة " صحيح ابن خزيمة " (2/ 137 / 1069)، ومحمد بن الربيع بن سليمان الجيزي " الكامل " (5/ 99) ومحمد بن المنهال " الكامل " (5/ 196)، ومحمد بن موسى الوراق " السنة للخلال " (1/ 170 / 164) وموسى بن العباس - مسائل جرح وتعديل - " الكامل " (3/ 392 / 821) وأبو عوانة " مسند أبي عوانة " (1/ 87 / 261).(@)(@@) التعديل والتجريح: قال ابن أبي حاتم: " كتبنا عنه بالرملة وذكرته لأبي فعرفه " وقال: " كان صدوقا ".(@)(@@) وقال الخطيب البغدادي بسنده إلى أبي سعيد بن يونس: " قدم مصر، وحدث بها وكان إخباريا يقال: إنه بغدادي، ويقال: مروزي، سكن بغداد وقدم إلى دمشق فأقام بها وكان قدومه إلى مصر من دمشق وكان في خلقه دعارة " وسأله أبو حميد في شيء يكتبه عنه من الأخبار فمطله، وكان شاعرا،. ا. ه.(@)(@@) وقال الخلال: " رجل عظيم الشأن؛ لم أسمع منه شيئا ".(@)(@@) قلت: وقد وقفت له على عدة أسئلة متفرقة لأئمة الجرح والتعديل الذين سبق ذكرهم مما يدل على علو كعبه فيه، وتلقيه عن أئمته المعتبرين؛ مثل: أحمد ويحيى، وابن المديني فضلا عن رحلته الواسعة في طلب الحديث، وحرصه على تحصيله.(@)(@@) وكل اسم لم يعز إلى كتاب، من معجم شيوخه وتلاميذه، وميزته بالأسود العريض فهو من ترجمته في " تاريخ بغداد ".(@)(@@) وانظر: " الجرح والتعديل " (2/ 241 / 856)، و " تاريخ بغداد " (7/ 9 / 3472) و " المقصد الأرشد " (1/ 284 / 290) و " رجال تفسير الطبري " (60/ 256).(@)(@@) PageV01P141(@)(@@)(@@)(@@) | [2] باب الباء(@)(@@) (من اسمه: بحر)(@)(@@)(@@)(@@) | 59 - (@)(@@) أبو عبد الله الخولاني المصري (2650)(@)(@@) (النسائي: في مسند مالك حديثا واحدا)(@)(@@) (طب: 21 ر / 4 ش)(@)(@@) (تس 
ms105	 7 ر / 4 ش)، و (تخ 2 ر / 1 ش)، و (ته ر 9/ 4 ش)، و (تق 3 ر / 2 ش)(@)(@@) أبو عبد الله بحر بن نصر بن سابق، الخولاني، مولاهم، المصري، مولده سنة أربع وسبعين ومائة، وقيل: سنة ثمانين ومائة، أو: إحدى وثمانين ومائة، وتوفي سنة سبع وستين ومائتين، وله سبع وثمانون سنة، من الحادية عشرة، ثقة.(@)(@@) وقد ورد اسمه في الأثر رقم (تس 2650)، (يحيى بن نصر)، وهو تصحيف ظاهر، وانظر ترجمة (يحيى بن نصر)، من كتابي هذا إن شئت!!.(@)(@@) روى عن: بشر بن بكر التنيسي (تس 10652)، و (ته: 2473)، وشعيب بن الليث، قراءة بإبهام القارئ عليه، (تس 17235)، و (ته 2118 و 2332)، و (تق 67)، وعبد الله بن وهب (تس 3844 و 10593 و 23333)، و (ته 12 و 641 و 2427 و 2428 و 2688) و (تق410 و 786) و (تخ 1/ 76 و 1/ 539)، ويحيى بن حسان التنيسي (تس 2650 و 17730)، و (ته 190).(@)(@@) روى عنه: أحمد بن الحسين بن الجنيد " سنن الدارقطني " (3/ 263 / 71)، وأبو روق، أحمد بن محمد بن بكر الهزاني " سنن الدارقطني " (2/ 57 / 10)، وعبد الله بن إبراهيم الأكفاني " سنن البيهقي " (10/ 263 / 21050)، وأبو محمد عبد الله بن عبد السلام الأصبهاني " طبقات أصبهان " (3/ 512 / 474) وعبد الله بن علي بن الجارود النيسابوري " المنتقى " (1/ 15 / 7) - وقد أكثر عنه - وعبد الملك بن أحمد الدقاق " سنن الدارقطني " (1/ 333 / 30)، وأبو بكر محمد بن إسحاق بن إبراهيم الكشي " الزهد الكبير "، (2/ 84 / 91)، ومحمد بن زبان " المستخرج " (3/ 308 / 2806)، ومحمد بن صالح بن علي الأشج " معجم الشيوخ " (1/ 75)، ومحمد بن نصر المروزي " السنة " (1/ 82 / 289)(@)(@@) PageV01P142(@)(@@) وقد أكثر عنه فيه، وفي " تعظيم قدر الصلاة " أيضا وابن قتيبة " صحيح ابن حبان (2/ 297 / 539).(@)(@@) التعديل والتجريح: تراوحت أقوال أئمة الجرح والتعديل فيه بين كونه: ثقة، صدوقا وفاضلا، مشهورا.(@)(@@) ذكره الشيخ شاكر في تحقيقه " لتفسير الطبري " (3/ 389 / 2643) وقال: " شيخ الطبري: لم أعرف من هو؟ ولم أجد في الرواة من يعرف بهذا " .. وسماه يحيى بن نصر بن حاجب القرشي، وميزه عن بعض من قد يشتبه به ".(@)(@@) قلت: وقد أبعد النجعة في من 
ms106	 وافقه في الاسم؛ وقال كلاما لم يتعرض فيه لذكر (بحر بن نصر).(@)(@@) ثم ذكره مرة أخرى في (9/ 272 / 10588) وقال: " بحر، ثقة، صدوق " وبهذا يكون قد جعلهما اثنين: وهو خطأ بلا ريب. ولا ريب عندي أنه (بحر بن نصر بن سابق الخولاني).(@)(@@) وقد يشكل بما أشكل على الحافظ (ابن حجر) في " تهذيب التهذيب " (1/ 368 / 776) حيث قال فيه:(@)(@@)(@@)(@@) | 37 - (@)(@@) تمييز بحر بن نصر بن حاجب.(@)(@@) روى عن: ورقاء بن عمر، وهلال بن خباب.(@)(@@) روى عنه: محمد بن صالح الأشج، وذكره أبو الفضل الهروي في " المتفق والمفترق ". ذكرته للتمييز.(@)(@@) وروى ابن حبان في " صحيحه "، من طريق يحيى بن نصر بن حاجب، عن أبيه حديثا. فلعله أخو هذا! إن لم يكن هو؟! فإني أخشى أن يكون أحد الموضعين تصحف. انتهى كلام الحافظ. في " تهذيب التهذيب " (1/ 368 / 776).(@)(@@) قلت: فإن التصحيف ممكن جدا. بل لا ريب فيه، وروايات الطبري (الإحدى والعشرون) عنه في " التفسير "، و " التاريخ " و " تهذيب الآثار "، تؤكد هذا التصحيف في(@)(@@) PageV01P143(@)(@@) اسمه واسم شيخه (يحيى بن حسان) الذي يتصحف أحيانا إلى (يحيى بن حيان).(@)(@@) وانظر: " الجرح والتعديل " (2/ 419 / 1660)، و " مشتبه أسامي المحدثين (1/ 80 / 95) و " مولد العلماء، ووفياتهم " (2/ 584) و (2/ 586)، و " المؤتلف، والمختلف " (1/ 78)، و " تهذيب الكمال " (4/ 16 / 641)، و " سير أعلام النبلاء (12/ 502 / 182)، و " تهذيب التهذيب " (1/ 368 / 775)، و " تقريب التهذيب " (1/ 122 / 675).(@)(@@) [2] باب الباء (من اسمه: بشر)(@)(@@)(@@)(@@) | 60 - (@)(@@) أبو عبد الرحمن البصري (23704)(@)(@@) (الأربعة، لكن النسائي في مسند علي فقط)(@)(@@) (طب: 12 ر / 7 ش)(@)(@@) (تس 8 ر / 4 ش)، و (تخ 1 ر / 1 ش)، و (ته 2 ر / 2 ش)، و (تق 1 ر / 1 ش)(@)(@@) أبو عبد الرحمن، بشر بن آدم بن يزيد، البصري، ابن بنت أزهر بن سعد السمان وهو الأصغر توفي سنة أبع وخمسين ومائتين، من العاشرة، صدوق فيه لين.(@)(@@) روى عن: عبد الرحمن بن مهدي، (تس 27891 و 35039) وعفان بن مسلم، (تس 27504)، وعمرو بن عاصم الكلابي (تق 1019)، و (تخ 2/ 63)، وقبيصة بن عقبة (ته 1843)، ومحمد بن عباد (ته 2758)، وأبي عاصم النبيل، (تس 23704 و 
ms107	 27893 و 31223) و (ق)، وأبي قتيبة (تس 29947 و 37408).(@)(@@) روى عنه: إسحاق بن إبراهيم القاضي " الثقات " (8/ 144 / 12657).(@)(@@) التعديل والتجريح: تراوحت أقوال أئمة الجرح والتعديل فيه بين كونه: صدوقا فيه لين، ليس بقوي، ولا بأس به، وصالحا.(@)(@@) قلت: أغفله الشيخان أحمد ومحمود شاكر في تحقيقهما " لتفسير الطبري ".(@)(@@) وانظر: " تاريخ ابن معين، رواية الدارمي " (1/ 78 / 187)، و " الجرح والتعديل " (2/ 351 / 1332) و " الثقات " (8/ 144 / 12657)، و " تهذيب الكمال " (4/ 90 / 677): و " الكاشف " (1/ 267 / 569)(@)(@@) PageV01P144(@)(@@) و " المقتنى في سرد الكنى " (1/ 372 / 3869)، و " ميزان الاعتدال " (2/ 23 / 1184)، و " المغني في الضعفاء " (1/ 104 / 890) و " لسان الميزان " (7/ 184 / 2424)، و " تهذيب التهذيب " (1/ 387 / 813)، و " تقريب التهذيب " (1/ 122 / 675).(@)(@@)(@@)(@@) | 38 - (@)(@@) تمييز بشر بن آدم، الضرير، البغدادي، وهو أقدم من هذا وأوثق وممن أخرج لهم البخاري، وقد أخرج له الطبري في " التفسير " الأثر قم (تس 34772) من طريق محمد بن خلف، عنه، عن عبد الله بن الزبير .. وله ترجمة في كتابي، المعجم الكبير " و "المعجم الصغير لرواة ابن جرير ".(@)(@@)(@@)(@@) | 61 - (@)(@@) أبو ثابث الخطاب (1386)(@)(@@) أبو ثابت، بشر بن أبان الحطاب، بالمهملتين - وراجع: مشرف بن أبان الخطاب - بالمعجمة والمهملة (تس 1953)؛ ترجمة رقم (339) من كتابي هذا.(@)(@@)(@@)(@@) | 62 - (@)(@@) بشر بن سويد (16658)(@)(@@) (طب: (تس: 1 ر / 1 ش)(@)(@@) بشر بن سويد، من التاسعة، فما دونها، لم أعرفه، ولم أجد له ترجمة، ولم يعرفه الشيخ شاكر قبلي (16643) " وتردد فيه، واضطرب، ولم أقف له في " التفسير " على غير هذا الأثر، ولم يتعرض الشيخ التركي في " تحقيقه " (11/ 420) لترجمته بشيء، مع أنه خرج الأثر (11/ 421)، وطريق البيهقي - والتي أشار إليها في " الشعب " (9394) - فيها (عبيد الله بن عمر الجشمي) في منزلة بشر هذا.(@)(@@) روى عن: سفيان [ابن عيينة] (تس 16658).(@)(@@) روى عنه: أبو جعفر محمد بن جرير الطبري.(@)(@@) التعديل والتجريح: ذكره الشيخ شاكر في تحقيقه " لتفسير الطبري " (14/ 213 / 16643)(@)(@@) PageV01P145(@)(@@) وقال: " لم أجد من يسمى بهذا الاسم، أخشى أن يكون بشر بن معاذ شيخ الطبري عن سويد بن نصر المروزي ". انتهى.(@)(@@) قلت: ربما يكون بين الطبري وسفيان رجلان، هو أحدهما، وسقط اسم الثاني، أو: أن يكون هناك تحريف في الاسم - كما 
ms108	 قال الشيخ شاكر - ولكن لم أقف لبشر بن معاذ، على رواية عن سويد بن نصر لا عند الطبري " ولا عند غيره، ولقد بحثت عن الأثر، في كتب الحديث والآثار، فوجدت له متابعا عند البيهقي الذي أخرجه في " شعب الإيمان " (7/ 45 / 9394)، بأتم منه هنا، سندا ومتنا. حيث قال: أخبرنا أبو سعيد بن أبي عمرو، أنا أبو عبد الله الصفار نا أبو بكر بن أبي الدنيا، نا عبيد الله بن عمر الجشمي، نا سفيان، عن عطاء بن السائب عن ابن البختري، عن حذيفة، في قول الله عز وجل: {اتخذوا أحبارهم ورهبانهم أربابا من دون الله}.(@)(@@) قال: " أما إنهم لم يكونوا يعبدونهم، ولكنهم أطاعوهم في المعاصي ". انتهى.(@)(@@) قلت: وليس (لبشر) فيه ذكر كما ترى!!.(@)(@@)(@@)(@@) | 63 - (@)(@@) أبو سهل العقدي (119)(@)(@@) (الترمذي، والنسائي " وابن ماجه)(@)(@@) (طب: 3452 ر / 4 ش)(@)(@@) (تس: 3423 ر / 2 ش)، و (تخ: 25 ر / 1 ش) " و (ته: 4 ر / 3 ش)(@)(@@) أبو سهل، بشر بن معاذ، العقدي، البصري، الضرير، توفي سنة، خمس وأربعين ومائتين، أو قبلها، أو بعدها بقليل، من العاشرة، صدوق.(@)(@@) روى عن: ثابت بن زهير (ته 2026 و 2029)، وخلف بن خليفة (تس 24038) " وعمر بن علي المقدمي (ته 867) " ويزيد بن زريع (تس 119 و 163 و 275 و 352 و 361 و 368 و 382 و 385 و 390 و 401 و 402 و 410 و 458 و 476 و 479 و 480 و 491 و 501 و 513 و 456 و 557 و 565 و 569 و 572(@)(@@) PageV01P146(@)(@@) و 574 و 585 و 587 و 609 و 639 و 655 و 693 و 697 و 707 و 717 و 722 و 778 و 951 و 1044 و 1053 و 1055 و 1066 و 1080 و 1082 و 1110 و 1119 و 1159 و 1169 و 1217 و 1267 و 1276 و 1319 و 1323 و 1345 و 1363 و 1395 و 1427 و 1467 و 1478 و 1507 
