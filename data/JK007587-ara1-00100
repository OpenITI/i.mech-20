ms81	 كيف تروى فيه أو تقف % 58(@)(@@) % فرأينا فيك قد أضحى علانية % والجند قد عرفوا منه الذي عرفوا % % 59(@)(@@) % وقدمت لك تمهيداتنا وبها % % وحش الفلاة ، إذا ما روعت ، ألف % 60(@)(@@) % كأننا حين تجري ذكرة لكم % على اضطرام لهيب النار نعتكف % % 61(@)(@@) % فإن يبالغ أناس في الثناء على % % أوصافكم قصروا في كل ما وصفوا % % PageV01P396 62(@)(@@) % فخذ نظاماص على قدر الذي كتبت % % يداك إذ عدد النظمين مؤتلف % % PageV01P397 البحر : بسيط تام 1(@)(@@) % دع ذا وقل لبني الآمال قد وضحت % % لكم سبيل الأماني وانجلى الأسف % % 2(@)(@@) % وأينعت دوحة للجود دانية ال % % قطوف يجني الغنى منها ويقتطف % % 3(@)(@@) % أموا بآمالكم مصرا ، فإن بها % % سحابة من نداها السحب تغترف % 4(@)(@@) % أجرى بها الله نيلا زائدا أبدا % فليس ينقص في وقت ، ولا يقف % 5(@)(@@) % مياهه من نضار جامد ، وعلى % % أرجائه ، للأماني ، روضة أنف % 6(@)(@@) % علت بها راية للعدل ، قاصدها % % يقتص من دهره الجاني ، وينتصف % 7(@)(@@) % سعى بها أروع في الروع ذو ورع % % في السلم ، حتى تجلى الجور والجنف % 8(@)(@@) % وجاد بالمال ، حتى لم يدع أملا % ما الجود والفضل إلا البذل والسرف % % 9(@)(@@) % الملك الصالح الهادي الذي كشف ال % % غماء إن الدجى بالصبح منكشف % 10(@)(@@) % من فيه عن زخرف الدنيا وزينتها % % مذ راودته على عليائه ظلف % % PageV01P398 11(@)(@@) % جوابه نعم ، في إثرها نعم % ولا تلائم فاه اللام والألف % 12(@)(@@) % يغنى العفاة ، ويلقاهم بمعذرة % كأنما عاتبوه وهو مقترف % % 13(@)(@@) % ما يبلغ الشكر ما يوليه من منن % % إنعامه فوق ما نثني وما نصف % 14(@)(@@) % لكن مواهبه في الخلق شاهدة % % بشكر إنعامه ، والشكر يختلف % 15(@)(@@) % كالروض إن لم يطق شكر السحاب إذا % % همى فنضرته بالفضل تعترف % % 16(@)(@@) % يا كافي الخلق بالنعمى ، وكافلهم % % حتى لقد أمنوا في عدله وكفوا % % 17(@)(@@) % رأيت مجدك يعلي قدر واصفه % % فكيف لا يتعالى قدر من تصف % % 18(@)(@@) % قلدتني أنجم الجوزاء قد نظمت % % عقدا ، فحق لمثلي الفخر والشرف % 19(@)(@@) % أعلت محلي فقد أصبحت من شرف % % بها على المشتري أسمو ، وأشترف % 20(@)(@@) % حلا بسمعي وحلاه فمنه به ال % % بشرى ، بإدراك ما 
ms82	 يرجوه والشنف % PageV01P399 21(@)(@@) % جعلت نظمي له ضنا بفاخره % % وقاية ووقاء الجوهر الصدف % % 22(@)(@@) % لأصرف العين عنه ، إنها أبدا % عن الكمال برؤيا النقص تنصرف % % 23(@)(@@) % يا كاشف الغمة ، اسمع دعوة كملت % % شكرا ، تظل له الأسماع ترتشف % 24(@)(@@) % من نازح الدار بالإخلاص مقترب % % حر ، برقك دون الخلق يعترف % 25(@)(@@) % إذا رأى بعده عن باب مالكه % % يكاد يقضي عليه الهم والأسف % % 26(@)(@@) % لو حاول الخلق جمعا حمل مالك من % % من عليه وأدنى شكره ضعفوا % % 27(@)(@@) % كم فاجأتني من نعماك عارفة % سبيلها عن سبيل الوعد منحرف % 28(@)(@@) % بها عن الوعد كبر ، كله كرم % وعن تقاضيه تيه ، كله أنف % 29(@)(@@) % وجمع شملي بمن لي في ذراك وإن % % أضحى لهم من نداك البر واللطف % % 30(@)(@@) % مجدد لي ما أوليت من نعم % % ما زال لي تالد منها ومطرف % % PageV01P400 31(@)(@@) % فابرد بهم حر قلب ليس يبرده % % سواهم ، وحشا من ذكرهم يجف % 32(@)(@@) % وارحم ضعافا وأطفالا إذا ذكروا % % بعدى عصتهم ، ففاضت أدمع ذرف % 33(@)(@@) % لهم نشيج وإعوال إذا نظروا % % من حالهم غير ما اعتادوا وما الفوا % % 34(@)(@@) % فنظرة منك تحييهم وتجعلهم % % محمولة عنهم الأثقال والكلف % % 35(@)(@@) % وليس لي شافع إلا مكارمك ال % % لاتي إذا استعطفت للفضل تنعطف % 36(@)(@@) % واسلم ، لتحيا بك الدنيا وساكنها % % ما اغبرت البيد ، أو مااخضرت النطف % 37(@)(@@) % والق الأعادي بجد لا يخونك إن % % خانت غداة اللقاء البيض والزغف % 39(@)(@@) % علومك البحر غمرا ليس تنتزف % % أسماعنا لمعاني درها صدف % 40(@)(@@) % فان يجد فلتة في الدهر ذو أدب % تجده من بحرك الزخار يغترف % 41(@)(@@) % تجيل فكرك في روض العقول فلا % % تزال تختار ما تجني وتقتطف % % PageV01P401 42(@)(@@) % بعثت منها هديا في الورى ، جليت % فالحسن وقف عليها ليس ينصرف % 43(@)(@@) % عذراء ، تثبت فضل الواصفين لها % % فقد أفادت جمالا كل من يصف % 44(@)(@@) % بعثتها ديما تروى بها عطش الص % ادي ، ومسكنها في سيرها الصحف % 45(@)(@@) % تروى القلوب بها بعد العيون ، فلا % % قلب ، ولا عين إلا وهو يرتشف % 46(@)(@@) % ألهت عن الحسن والإحسان أجمعه % % إذ استبان بها عن غيرها أنف % 47(@)(@@) % حسناء 
ms83	 تبرز في عرنينها شمم % % من الجمال وفي أجفانها وطف % % 48(@)(@@) % كأن أسماعنا لما أصخن لها % % عجبا أتيح لها من حليها شنف % % 49(@)(@@) % بدت لنا كمصابيح الظلام وفي % % رأي العيون أتتنا الروضة الأنف % 50(@)(@@) % قد برهنت بالمعاني عن فؤاد شج % قد هاضه الأثقلان : الهم والأسف % % 51(@)(@@) % إن يبتسم غلطة في الدهر عاتبه % % قلب مدامعه في صدره تكف % PageV01P402 52(@)(@@) % ورب صعب بدا من بعد شدته % % لأضعف الناس حولا ، وهو منعطف % 53(@)(@@) % وكم مصاب جنته فرقة ، فغدا % % سحابه بنسم القرب ينكشف % 54(@)(@@) % وكربة نزعت عنها ملابسها % % والقلب منها بثوب الهم ملتحف % 55(@)(@@) % وحين تشرف أنوار الشموس فما % % يضر ماضي ليال عمها السدف % 56(@)(@@) % أحوال ضرك مجد الدين واضحة % % قد كان للدهر في توكيدها سرف % 57(@)(@@) % برق اليقين بدا منا إليك فما % % يغر خلبه بل سحبه تكف % % 58(@)(@@) % لا نخلف الوعد منا بالنجاح لمن % لنا بآماله في القصد يختلف % 59(@)(@@) % يقول حاسدنا ، والحق أنطقه % % إذ شمسه ، لا كمثل الشمس تنكسف : % 60(@)(@@) % أولاد رزيك لا فخر كفخرهم % % حازوا المفاخر في الدنيا وهم نطف % 61(@)(@@) % وكم أراد الورى إحصاء فضلهم % % في المكرمات فما اسطاعوا ولا عرفوا % % PageV01P403 62(@)(@@) % لكنهم أخذوا ما تستقل به % % أفهامهم وإلى حيث انتهوا وقفوا % % 63(@)(@@) % ندني الغنى من يدى رب المنى ، فلنا % % به المطي إلى أوطانهم تجف % % 64(@)(@@) % في غيرنا تخجل الآمال إن قصدت % % وما يخيب رجاء عندنا يقف % 65(@)(@@) % وقد قضى الله بي تأليف شملكم % وكان ظنكم أن ليس يأتلف % 66(@)(@@) % وقد أساء لكم دهر مضى فإذا % % شئتم من الدهر فاقتضوا ، أو انتصفوا % % 67(@)(@@) % واقضوا ديون الهوى عن مدة سلفت % % تشاكيا ، وعلى المستأنف استلفوا % % 68(@)(@@) % وقد بدأنا ، وتممنا ، فهل أمل % يدعو وهل مدمع قد عاد ينذرف % % 69(@)(@@) % نحن الزلال دفعنا غصة عرضت % % لكم ، فلما عرضنا لم تكن تقف % 70(@)(@@) % وعندنا أهلكم ، كانوا لعيشهم % كأنهم عنك ما غابوا ولا انصرفوا % % 71(@)(@@) % كم جهد ذي الهم أن يبقى تجلده % % عليه والهم في استمراره التلف % % PageV01P404 72(@)(@@) % لاتأسفن على فقدان غيرهم % % ففي الملاوم قد جرت له 
ms84	 عطف % 73(@)(@@) % قوم إذا ارتفعوا قدرا هووا همما % فالمكرمات لعمري بينهم طرف % 74(@)(@@) % ولا تقل إن تذكرت البلاد أسى % % بأن قلبك بالأشواق يختطف % 75(@)(@@) % وإن دولتنا كنت الوحيد بها % % فضلا ، فكيف يرى منكم بها خلف % 76(@)(@@) % عليكم بدع الآداب قد وقفت % % فما لها عنكم في الدهر منحرف % % 77(@)(@@) % من ناشد عهد ذاك الإجتماع لنا % % فقد أضاعته منكم نية قذف % 78(@)(@@) % هنيت أهلك مجد الدين فانتجع ال % % فراح ، وانظر ، فإن الخير مؤتنف % PageV01P405 البحر : بسيط تام 1(@)(@@) % تهمى مواهبه والسحب جامدة % فمن يديه مصاب الوابل الغدق % % 2(@)(@@) % نعماه تطلق أسرى ، ثم تأسرهم % % له ، وكم منة أغنت عن الربق % PageV01P406 البحر : خفيف تام 1(@)(@@) % مثل منهل أنعم الملك الصا % % لح : يروى دان به وسحيق % % 2(@)(@@) % سحب وبلها النضار وللأع % % داء فيها صواعق وحريق % 3(@)(@@) % ملك زاده التواضع لل % % ه جلالا ، يروع ، ثم يروق % 4(@)(@@) % سطوات تخشى وحلم يرجى % % ونوال طلق ، ووجه طليق % 5(@)(@@) % من حكى بي ورق الحمائم في الأف % % نان : جيدي حال ، وغصنى وريق % 6(@)(@@) % وثنائي كشدوهن مدى الأي % ام ، يحلو سماعه ، ويروق % 7(@)(@@) % رونق الصدق فيه باد ، وما زا % % ل إلى الصدق كل سمع يتوق % 8(@)(@@) % يا أمير الجيوش ما زال للإس % % لام والدين منك ركن وثيق % % 9(@)(@@) % أسمعت دعوة الجهاد ، فلبا % % ها مليك بالمكرمات خليق % % 10(@)(@@) % ملك عادل أنار به الدي % % ن ، فعم الإسلام منه الشروق % PageV01P407 11(@)(@@) % ما له عن جهاده الكفر والعد % % ل وفعل الخيرات شغل يعوق % 12(@)(@@) % هو مثل الحسام صدر صقيل % % لين مسه ، وحد ذليق % 13(@)(@@) % ذو أناة يخالها الغر إهما % % لا ، وفيها حتف الأعادي المحيق % 14(@)(@@) % فاسلما للإسلام كهفين ما طر % % ز ثوب الظلام برق خفوق % % PageV01P408 البحر : سريع 1(@)(@@) % أبا تراب ، دهرنا جاهل % يرفع للشبه ذوي الجهل % % 2(@)(@@) % كأنه الميزان : يعلو به % % ذو النقص عن رتبة ذي الفضل % % 3(@)(@@) % وما يضر العزل من لم يزل % % من فضله الباهر في شغل % % PageV01P409 البحر : طويل 1(@)(@@) % أبا حسن في طي كل مساءة % من الله صنع للعباد جميل % 2(@)(@@) % كرهت لك 
ms85	 الترحال أمس وربما % % أفاد الفتى طول المقام رحيل % 3(@)(@@) % وقد يكره الشيء الفتى ، وهو خيره % له ، ويحب الشيء وهو وبيل % 4(@)(@@) % ولو لم تفد إلا الجهاد ، فإنه % ثواب كما نص الكتاب جزيل % % 5(@)(@@) % فكيف وقد أصبحت جارا لماجد % % يجود ، على علاته ، وينيل % 6(@)(@@) % كريم كليل الطرف عن عيب جاره % % وما طرفه عند السؤال كليل % % 7(@)(@@) % شرى الحمد بالأموال ، لا يستقيل في % % شراه ، ولا عند البياع يقيل % 8(@)(@@) % ومن كمعين الدين أما جنابه % % فرحب ، وأما ظله فظليل % 9(@)(@@) % إذا وردت آمالنا بحر جوده % % صدرن رواء ، ما بهن غليل % 10(@)(@@) % فكن واثقا بالله ثم بجوده % % فإني بما أملت منه كفيل % PageV01P410 البحر : بسيط تام 1(@)(@@) % يا مستقل الغنى فيما تجود به % % ومن مواهبه كالعارض الهطل % 2(@)(@@) % ومن إذا جاد بالدنيا لآمله % قالت معارفه حاشاك من بخل % % 3(@)(@@) % ومن إذا جرد البيض الصوارم في ال % % هيجاء أسكنها في الهام والقلل % 4(@)(@@) % قد كنت أخضع في الخطب الملم ، فمذ % وليت يا نصر عاد الخطب يخضع لي % % 5(@)(@@) % وبعد لي فيك آمال وظني في % % علاك أنك توفي بي على أملي % % PageV01P411 البحر : خفيف تام 1(@)(@@) % فئتي ألتجي إليه من الخطب ، % ب وذخري إن غال وفري غول % % 2(@)(@@) % بعلاه أسمو ، ومن فضل مان % % ول أقضى فرض العلا وأنيل % 3(@)(@@) % ملك يذكر المواعيد والعه % % د وينسيه فضله ما ينيل % % 4(@)(@@) % ملكه ملك رحمة ، وقضايا % % ه بما جاءنا به التنزيل % 5(@)(@@) % أنت حليت بالمكارم أهل ال % % عصر حتى تعرف المجهول % % 6(@)(@@) % وعلا خامل وحامى جبان % % ووفى غادر وجاد بخيل % % 7(@)(@@) % وحميت البلاد بالسيف ، فاستص % % عب منها سهل ، وعز ذليل % 8(@)(@@) % وقسمت الفرنج بالغزو شطري % % ن فهذا عان وهذا قتيل % % 9(@)(@@) % والذي لم يحن بسيفك من خو % % فك أمسى وعقله مخبول % % 10(@)(@@) % مثل الخوف بين عينيه جيشا % لك في عقر داره ما يزول % PageV01P412 11(@)(@@) % فالربى عنده جيوش وموج ال % % بحر في كل لجة أسطول % 12(@)(@@) % وإذا ما أغفى أقض به المض % % جع في الحلم سيفك المسلول % % 13(@)(@@) % فابق للمسلمين كهفا وللإف 
ms86	 % % رنج حتفاص ما أعقب الجيل جيل % % 14(@)(@@) % بين ملك يدوم ما دامت الدنيا % % وحال في الفضل ليست تحول % 15(@)(@@) % ثابت الدست في اعتلاء وجد % % وعطاياك في البلاد تجول % 16(@)(@@) % بالغ العبد في النيابة والتح % % ريض وهو المفوه المقبول % % 17(@)(@@) % فرأى من عزيمة الغزو ما كا % % دت له الأرض والجبال تميل % % 18(@)(@@) % وأجابته بالصليل سيوف % % ظامئات ، وبالصهيل خيول % 19(@)(@@) % ورأى النقع راكدا دون مجرى الش % مس ، والأرض بالجيوش تسيل % 20(@)(@@) % كل أرض فيها من الأسد جيش % سائر فوقه من السمر غيل % PageV01P413 21(@)(@@) % وإذا عاقت المقادير فلل % % له إذا حسبنا ، ونعم الوكيل % PageV01P414 البحر : سريع 1(@)(@@) % زدني علا لا أرتضي باللهى % % حسبي ما نولت : من مال % % 2(@)(@@) % أغنيت نفسي ويدي فاستوى % % حالي في العفة والمال % % 3(@)(@@) % فلي نوال وندى سيبه % % يرجى ، ومن فضلك إفضالي % % 4(@)(@@) % وإنما أبغي العلا ، لا الغنى % % ومثلها يبغيه أمثالي % % PageV01P415 البحر : كامل تام 1(@)(@@) % والجور في حكم الصبابة جائز % بخلاف أحكام المليك العادل % 2(@)(@@) % الصالح الهادي الذي في عدله % % ساوى انخفاض الزج صدر العامل % % PageV01P416 البحر : سريع 1(@)(@@) % وسر إلى بحر خضم له % % من عزمه سيف وغى مخذم % 2(@)(@@) % حتى إذا أنطقك العدل في % % جلاله والخلق الأكرم % % 3(@)(@@) % قل لأمير المسلمين الذي % % به استنار الزمن المظلم % % 4(@)(@@) % أنت الذي ما جرت يوما ، ولا % % جرى على سيفك ظلما دم % % 5(@)(@@) % ساويت في عدلك بين الورى % % حتى تساوى الزج واللهذم % % 6(@)(@@) % وقمت في الله احتسابا فقد % % وقمت من يطغى ومن يجرم % 7(@)(@@) % وكل أهل الشام أوسعتهم % % عدلا فمالي دونهم أحرم % % 8(@)(@@) % أطعت في حكمك في الهوى % % وما كذا يفعل من يحكم % % 9(@)(@@) % من ينصف المظلوم منا إذا % % كنت ، وحاشاك ، الذي يظلم % 10(@)(@@) % وأنت ظل الله في أرضه % % تردع من يظلم أو يغشم % PageV01P417 11(@)(@@) % فلا يشب أجر الجهاد الذي % % فزت به دون الورى مأثم % PageV01P418 البحر : متقارب تام 1(@)(@@) % دعوتك يا عمر المكرمات % لأمر عرا ومهم ألم % % 2(@)(@@) % وأنت السريع إلى من دعاك % % بذاك قضى لك إرث الكرم % % 3(@)(@@) % وإن نام حظي عما عهدت % % فإن 
ms87	 اهتمامك بي لم ينم % % PageV01P419 البحر : بسيط تام 1(@)(@@) % لو استطعت ولو ملكت أمري في % % قضاء فرضك عما فات من خدمي % % 2(@)(@@) % مشيت أحمل أثقال الثناء إلى % % جنابك الخضل الأهاف كالقلم % PageV01P420 البحر : بسيط تام 1(@)(@@) % خلق تحلى به سلمان بيتك من % % أخلاقك الغر يا ذا البأس والنعم % % 2(@)(@@) % مولى علاك وكم قد عاد شائهه % % بيأسه من ملوك العرب والعجم % % 3(@)(@@) % يقر بالملك للملك الذي نشر ال % % رحمن أيامه ظلا على الأمم % % 4(@)(@@) % للصالح الملك الميمون طائره % % بجيده طوق من غير منفصم % % 5(@)(@@) % حمى ذويه وكم من باسط ليد % % لولا حماه وكم من فاغر لفم % % 6(@)(@@) % وذاد عنهم صروف الدهر إذ كلبت % % عليهم ، وهم لحم على وضم % 7(@)(@@) % ونالهم من توالي سحب نائله % % ما نال نبت الثرى من وابل الديم % 8(@)(@@) % يا حاسديه ، اكظموا ، جراتكم فأنا الن % % ذير من أخذه إن هم بالكظم % % 9(@)(@@) % إياكم عثرات البغي إن لمن % % يبغيه يوما يوارى الشمس بالظلم % 10(@)(@@) % حذار من مصرع الباغين قبلكم % % فالسيف منصلت في كف مصطلم % % PageV01P421 11(@)(@@) % وفي تميم ومن والاه موعظة % % إنذارها يسمع الأموات في الرجم % % 12(@)(@@) % توهموا أن ضاري الأسد ينفر عن % % عرينه لحشود البوم والرخم % 13(@)(@@) % وما دروا أنه في حجفل لجب % من بأسه ، غير هياب ولا برم % % 14(@)(@@) % مغامر ترهب الآجال سطوته % % وتفرق الأسد منه في حمى الأجم % 15(@)(@@) % يستقبل الحرب بساماص وقد كشرت % % بها المنية عن أنيابها الأرم % 16(@)(@@) % يلقى الألوف ويحبوها ، ففي يده % % من العطا والسطا بحراندى ودم % % 17(@)(@@) % ما غركم بصدوق الظن يخبره الر % % أي الصحيح بما في الصدر من سقم % % 18(@)(@@) % يرى الضغائن في قلب الحسود له % % تدب مثل ذبيب النار في الفحم % 19(@)(@@) % فإن سطا عن يقين ، أو عفا كرما % فإنه خير ذي عفو ومنتقم % % 20(@)(@@) % أدناكم ؛ فاعتليتم عن ذوي رحم % وحاطكم فاغتديتم منه في حرم % % PageV01P422 21(@)(@@) % وعمكم سيب جود منه نبه ذا ال % % خمول منكم وأغنى كل ذي عدم % % 22(@)(@@) % كم غمة كشفت عنكم صوارمه % % ولم يزل كاشف اللأواء والغمم % % 23(@)(@@) % لولاه ، لا 
ms88	 زال عنكم ظله أبدا ، % علمتم كيف تأتى فجأة النقم % 24(@)(@@) % إن رابه منكم أمر فلا وزر % % لكم ولا عاصم من سيله العرم % % 25(@)(@@) % يا مالكا مالكا رقي بأنعمه % % وملك مثلي لا يبتاع بالقيم % 26(@)(@@) % ما الشكر كفء لما أوليت من منن % وإن تسهل لي مستوعر الكلم % % 27(@)(@@) % وإن أكن كزهير في الثناء فقد % % علوت مجدا وجودا عن مدى هرم % 28(@)(@@) % وإن تكن مدحى وقفا عليك فلا % % تظن أن ثنائي منتهى هممي % % 29(@)(@@) % ففي يمينك مني صارم خذم % يفري إذا كل حد الصارم الخذم % % 30(@)(@@) % في حده حتف من ناواك وهو لمن % % والاك منبجس بالبارد الشبم % % PageV01P423 31(@)(@@) % فمر بما شئت ؛ ألقى الأمر ممتثلا % بهمة ما اعترتها فترة الهمم % % 32(@)(@@) % مجربا طاعتى تجريب مختبر % إن التجارب تجلو شبهة التهم % % 33(@)(@@) % فبذل نفسي عندي في رضاك فلا % % حرمته بعض ما أنويه من خدمي % % 34(@)(@@) % وحق ذاك لمن أنشرت أسرته % % من بعد ما عدهم من ناخر الرمم % 35(@)(@@) % صرفت صرف الليالي دون غشمهم % وكف بأسك عنهم كف مهتضم % % 36(@)(@@) % وأوصلتهم صلات من نداك إلى % % أرض الشا م ، لقد أغربت في الكرم % 37(@)(@@) % وماالذي نلت من نعماك غاية آم % % مالي ولا منتهى حظي ولا قسمي % % 38(@)(@@) % نيل العلا دون ما أرجوه منك كما % % أن الغنى دون ما تحبوه من نعم % 39(@)(@@) % شرفتني ، فاعتلى قدري ، وأصحب لي % % دهري ، وأصبح فيما رمت من خدمي % % 40(@)(@@) % وطلت عمن يساميني ، ففخرهم % % أن يبلغوا إن سمت هماتهم قدمي % % PageV01P424 41(@)(@@) % لله در طروس ضمنت دررا % أكرم بمنتثر منها ومنتظم % % 42(@)(@@) % أضحت على مفرقي تاجا وفي عنقي % % تميمة من عوادي الخطب والعدم % 43(@)(@@) % لفظ أرق من الشكوى ، وألطف مل عت % % بى ، وأشهى من الإبلال في الألم % % 44(@)(@@) % جرت لطافته من قلب سامعه % % مجرى الهوى من فؤاد المغرم السدم % 45(@)(@@) % فصاحة أسمعت من كان ذا صمم % وحسن معنى أفاد الفهم ذا اللمم % 46(@)(@@) % ووشي خط حكى زهر الربيع سرت % % أكمامه عن بديع الفضل والحكم % 47(@)(@@) % لو كان حالكه لون الشباب لما % % حالت نضارته 
ms89	 بالشيب والهرم % % 48(@)(@@) % يزيد سامعها تكرارها شغفا % % بها وكم جلب التكرير من سأم % % 49(@)(@@) % يا موجد الفضل والإفضال إذ عدما % % حتى لقد أصبحا نارين في علم % 50(@)(@@) % مملوكك الأصغر القن المبالغ في الإخ % % لاص ، والسير مقدود من الأدم % PageV01P425 51(@)(@@) % لو نال ما يتمنى من مشيئته % % مشى إليك خضوعا مشية القلم % PageV01P426 البحر : - 1(@)(@@) % يا منعما ، مورد إحسانه % % سهل فما في منه من % % 2(@)(@@) % قد اقتدى بالمزن في جوده % % بل بنداه يقتدي المزن % 3(@)(@@) % بسطت كفا في الندى والوغى % % ما كفها بخل ولا جبن % % 4(@)(@@) % فاسلم من الدهر ، ففيه على % % كل كريم ماجد ضغن % % PageV01P427 البحر : طويل 1(@)(@@) % أظن العدا أن ارتحالي ضائرى % % ضلالا لما ظنوا ، وهل يكسد التبر % 2(@)(@@) % وما زادني بعدي سوى بعد همة % % كما زاد نورا في تباعده البدر % 3(@)(@@) % ولو كان في طول الثواء فضيلة % لما انتقلت في أفقها الأنجم الزهر % % 4(@)(@@) % ولو لزمت أغمادها البيض ما انجلت % بها غمرات الحرب ، واتضح النصر % 5(@)(@@) % وهل في ارتحالي عن بلاد تنكرت % لمثلي أو للمساكين بها فخر % % 6(@)(@@) % وإن بلادا ضاق عني فضاؤها % % لأرحب من أكنافها للعلا فتر % 7(@)(@@) % وأرضا نبت بي وهي آهلة الربى % % هي القفر لا بل دون وحشتها القفر % % 8(@)(@@) % وهل ينكر الأعداء فضلي وإنه % % لأسير ذكرا أن يواريه الكفر % % 9(@)(@@) % ألست الذي ما زال كهلا ويافعا % له المكرمات الغر والنائل الغمر % % 10(@)(@@) % وخائض وقعات بوارقها الظبا % % ووابل هاتيك البروق دم همر % % PageV01P428 11(@)(@@) % يهول الردى منى تقحمي الردى % % ويعتاده من جأشي الرابط الذعر % 12(@)(@@) % ولو حكمت بيني وبينهم الظبا % % رضيت بما تقضي المهندة البتر % % 13(@)(@@) % ولكن تولى الحاكمان قضاءنا % % فكان أبو موسى لنا ، ولهم عمرو % % PageV01P429 البحر : طويل 1(@)(@@) % أبي الله إلا أن يدين لنا الدهر % % ويخدمنا في ملكنا العز والنصر % % 2(@)(@@) % أبي الله إلا أن يكون لنا الأمر % % لتحيا بنا الدنيا ، ويفتخر العصر % 3(@)(@@) % وتخدمنا الأيام فيما نرومه % وينقاد طوعا في أزمتنا الدهر % 4(@)(@@) % وتخضع أعناق الملوك لعزنا % % ويرهبها منا على بعدنا الذكر % 5(@)(@@) % بحيث حللنا الأمن من 
ms90	 كل حادث % وفي سائر الآفاق من بأسنا ذعر % % 6(@)(@@) % بطاعتنا لله أصبح طوعنا الأ % % نام ، فما يعصى لنا فيهم أمر % 7(@)(@@) % فأيماننا في السلم سحب مواهب % % وفي الحرب سحب وبلهن دم همر % 8(@)(@@) % قضت في بني الدنيا قضاء زمانها % % فسر بها شطر ، وسىء بها شطر % 9(@)(@@) % وما في ملوك المسلمين مجاهد % سوانا فما يثنيه حر ولا قر % % 10(@)(@@) % جعلنا الجهاد همنا واشتغالنا % % ولم يلهنا عنه السماع ولا الخمر % % PageV01P430 11(@)(@@) % دماء العدا أشهى من الراح عندنا % % ووقع المواضي فيهم الناي والوتر % % 12(@)(@@) % نواصلهم وصل الحبيب وهم عدا % زيارتهم ينحط عنا بها الوزر % 13(@)(@@) % وثير حشايانا السروج وقمصنا الد % % روع ومنصوب الخيام لنا قصر % % 14(@)(@@) % ترى الأرض مثل الأفق وهي نجومه % % وإن حسدتها عزها الأنجم الزهر % % 15(@)(@@) % وهم الملوك البيض والسمر كالدمى % % وهمتنا البيض الصوارم والسمر % % 16(@)(@@) % صوارمنا حمر المضارب من دم % % قوائمها من جودنا نضرة خضر % 17(@)(@@) % نسير إلى الأعداء والطير فوقنا % % لها القوت من أعدائنا ، ولنا النصر % 18(@)(@@) % فبأس يذوب الصخر من حر ناره % % ولطف له بالماء ينبجس الصخر % 19(@)(@@) % وجيش إذا لاقى العدو ظننتهم % % أسود الشرى عنت لها الأدم والعفر % % 20(@)(@@) % ترى كل شهم في الوغى مثل سهمه % % نفوذا فما يثنيه خوف ولا كثر % % PageV01P431 21(@)(@@) % هم الأسد من بيض الصوارم والقنا % % لهم في الوغى الناب الحديدة والظفر % 22(@)(@@) % يرون لهم في القتل خلدا ، فكيف بالل % % قاء لقوم قتلهم عندهم عمر % 23(@)(@@) % إذا نسبوا كانوا جميعا بني أب % فطعنهم شزر وضربهم هبر % % 24(@)(@@) % يظنون أن الكفر عصيان أمرنا % % فما عندهم يوما لإنعامنا كفر % % 25(@)(@@) % لنا منهم إقدامهم وولاؤهم % ومنا لهم إكرامم والندى الغمر % 26(@)(@@) % بنا أيد الإسلام ، وازداد عزة % وذل لنا من بعد عزته الكفر % % 27(@)(@@) % قتلنا البرنس ، حين سار بجهله % % تحف به الفرسان والعسكر المجر % 28(@)(@@) % ولم يبق إلا من أسرنا ، وكيف بالب % % قاء لمن أخنت عليه الظبا البتر % 29(@)(@@) % وفي سجننا ابن الفنش خير ملوكهم % % وإن لم يكن خير لديهم ولا بر % % 30(@)(@@) % كأفعالنا في أرض من حان 
ms91	 منهم % وقد قتلت فرسانه فهم جزر % % PageV01P432 31(@)(@@) % وسل عنهم الوادي بإقليس إنه % % إلى اليوم فيه من دمائهم غدر % 32(@)(@@) % هم انتشروا فيه لرد رعيلنا % % فمن تربه يوم المعاد لهم نشر % % 33(@)(@@) % ونحن أسرنا الجوسلين ولم يكن % % ليخشى من الأيام نائبة تعرو % % 34(@)(@@) % وكان يظن الغر أنا نبيعه % % بمال ، وكم ظن به يهلك الغر % 35(@)(@@) % فلما استبحنا ملكه وبلاده % % ولم يبق مال يستباح ولا ثغر % 36(@)(@@) % كحلناه ، نبغى الأجر في فعلنا به % وفي مثل ما قد ناله يحرز الأجر % 37(@)(@@) % ونحن كسرنا البغدوين وما لمن % % كسرناه إبلال يرجى ولا جبر % 38(@)(@@) % % له الغدر دين : ما به صنع الغدر % 39(@)(@@) % وقد ضاقت الدنيا عليه برحبها % % فلم ينجه بر ولم يحمه بحر % % 40(@)(@@) % أفى غدره بالخيل بعد يمينه % % بإنجيله بين الأنام له عذر % PageV01P433 41(@)(@@) % دعته إلى نكث اليمين وغدره % % بذمته النفس الخسيسة والمكر % 42(@)(@@) % وقد كان لون الخيل شتى فأصبحت % % تعاد إلينا ، وهي من دمهم شقر % 43(@)(@@) % توهم عجزا حلمنا وأناتنا % % وما العجز إلا ما أتى الجاهل الغمر % % 44(@)(@@) % فلما تمادى غيه وضلاله % % ولم يثنه عن جهله النهي والزجر % % 45(@)(@@) % برزنا له كالليث فارق غيله % % وعادته كسر الفرائس والهصر % 46(@)(@@) % وسرنا إليه حين هاب لقاءنا % % وبان له من بأسنا البؤس والشر % % 47(@)(@@) % فولى يبارى عائرات سهامنا % % وفي سمعه من وقع أسيافنا وقر % % 48(@)(@@) % وخلى لنا فرسانه وحماته % % فشطر له قتل وشطر له أسر % % 49(@)(@@) % وما تنثني عنه أعنة خيلنا % % ولو طار في أفق السماء به النسر % % 50(@)(@@) % إلى أن يزور الجوسلين مساهما % له في دياج ما لليلتها فجر % % PageV01P434 51(@)(@@) % ونرتجع القدس المطهر منهم % % ويتلى بإذن الله في الصخرة الذكر % % 52(@)(@@) % % فلم يبق منها في ممالكهم شبر % % 53(@)(@@) % إذا استغلقت شم الحصون فعندنا % % مفاتحها : بيض ، مضاربها حمر % 54(@)(@@) % وإن بلد عز الملوك مرامه % % ورمناه ، ذل الصعب واستسهل الوعر % 55(@)(@@) % وأضحى عليه للسهام وللظبا % % ووقع المذاكي الرعد والبرق والقطر % % 56(@)(@@) % بنا استرجع الله البلاد وأمن الع % % باد ، فلا خوف عليهم ولا قهر % 57(@)(@@) % فتحنا الرها 
ms92	 حين استباح عداتنا % % حماها وسنى ملكها لهم الختر % % 58(@)(@@) % جعلنا طلى الفرسان أغماد بيضنا % % وملكنا أبكارها الفتكة البكر % % 59(@)(@@) % وتل عزاز ، صبحته جيوشنا % % وقد عجزت عنه الأكاسرة الغر % % 60(@)(@@) % أتى ساكنوها بالمفاتيح طاعة % إلينا ومسراهم إلى بابنا شهر % % PageV01P435 61(@)(@@) % وما كل ملك قادر ذو مهابة % ولا كل ساع يستتب له الأمر % % 62(@)(@@) % % فلم تحمه عنا الرجال ولا الجدر % % 63(@)(@@) % وملنا إلى برج الرصاص وإنه % % لكاسد لكن الرصاص له قطر % % 64(@)(@@) % وأضحت لأنطاكية حارم شجى % وفيها لها والساكنين بها حصر % 65(@)(@@) % وحصن كفر لاتا وهاب تدانيا % % لنا ، وذراها للأنوق به وكر % 66(@)(@@) % وفي حصن باسوطا وقورص ذلت الص % عاب لنا ، والنصر يقدمه الصبر % 67(@)(@@) % وفامية والبارة استنقذتهما % % لنا همة من دونها الفرع والغفر % 68(@)(@@) % وحصن بسرفود وأنب سهلت % % لنا ، واستحال العسر ، وهو لنا يسر % 69(@)(@@) % وفي تل عمار وفي تل خالد % % وفي حصن سلقين لمملكة قصر % 70(@)(@@) % وما مثل راوندان حصن وإنه % % لممتنع ، لو لم يسهل له القسر % PageV01P436 71(@)(@@) % وكم مثل هذا من قلاع ومن قرى % % ومزدرعات لا يحيط بها الحصر % 72(@)(@@) % فلما استعدناها من الكفر عنوة % ولم يبق في أقطارها لهم أثر % 73(@)(@@) % رددنا على أهل الشآم رباعهم % % وأملاكهم ، فانزاح عنهم بها الفقر % 74(@)(@@) % وجاءتهم من بعد يأس وفاقة % % وقد مسهم من فقدها البؤس والضر % 75(@)(@@) % ومر عليها الدهر ، والكفر حاكم % عليها ، وعمر مر من بعده عمر % 76(@)(@@) % فنالهم من عودها الخير والغنى % % كما نالنا من ردها الأجر والشكر % % 77(@)(@@) % ونحن وضعنا المكس عن كل بلدة % فأصبح مسرورا بمتجره السفر % % 78(@)(@@) % وأصبحت الآفاق من عدلنا حمى % فكدر قطاها لا يروعها صقر % 79(@)(@@) % فكيف تسامينا الملوك إلى العلا % % وعزمهم سر ووقعاتنا جهر % % 80(@)(@@) % وإن وعدوا بالغزو نظما ، فهذه % % رؤوس أعاديهم بأسيافنا نثر % % PageV01P437 81(@)(@@) % سنلقى العدا عنهم ببيض صقالها % % هداياهم والبتر يرهفها البتر % % 82(@)(@@) % وما قولنا عن حاجة ، بل يسوءنا % % إذا لم يكن في غزونا لهم أجر % % 83(@)(@@) % خزائننا ملأى ، وما هي ذخرنا الم % عد ، ولكن الثواب هو الذخر % 84(@)(@@) % ملكنا الذي 
ms93	 لم تحوه كف مالك % ولم يعرنا تيه الملوك ولا الكبر % 85(@)(@@) % فنحن ملوك البأس والجود سوقة الت % % واضع لا بذخ لدينا ولا فخر % % 86(@)(@@) % عزفنا عن الدنيا ، على وجدها بنا % % فمنها لنا وصل ، ومنا لها هجر % 87(@)(@@) % وأحسن شيء في الدنا زهد قادر % % عليها فما يصبيه ملك ولا وفر % % 88(@)(@@) % ولولا سؤال الله عن خلقه الذي % % رعيناهم حفظا إذا ضمنا الحشر % % 89(@)(@@) % لملنا عن الدنيا ، وقلنا لها : اغربي % % لك الهجر منا ما تمادى بنا العمر % % 90(@)(@@) % فما خير ملك أنت عنه محاسب % % ومملكة ، من بعدها الموت والقبر % PageV01P438 91(@)(@@) % فقل لملوك الأرض : ما الفخر في الذي % % تعدونه من فعلكم بل كذا الفخر % % PageV01P439 البحر : كامل تام 1(@)(@@) % يأبى احتمال الضيم لي خلق % % فيه على ما رابني صلف % 2(@)(@@) % سهل العريكة حين تنصفه % % صعب المقادة حين يعتسف % % 3(@)(@@) % خلق نماه أغر أروع مي % % مون النقيبة ماجد أنف % % 4(@)(@@) % من معشر طابت مغارسهم % % فسما لهم فوق السها شرف % 5(@)(@@) % قوم إذا عدت مناقبهم % % كادت لهن الشمس تنكسف % 6(@)(@@) % لو حاولوا الأفلاك ما قصرت % عنها أكفهم ولا ضعفوا % % 7(@)(@@) % لا عيب فيهم غير أنهم % % في جودهم لعفاتهم سرف % 8(@)(@@) % أثني بعلمي فيهم ، وهم % فوق الثناء وفوق ما أصف % % PageV01P440 البحر : كامل تام 1(@)(@@) % جودي بموجودي على النكبات في % % مالي أبى لي أن أعد بخيلا % 2(@)(@@) % أهب الكثير من الكثير فإن لحت % % عودي وهبت من القليل قليلا % 3(@)(@@) % كي لا أكذب في رجائي آملا % إن البخيل يكذب التأميلا % % PageV01P441 البحر : طويل 1(@)(@@) % قتلنا بقتلانا من القوم مثلهم % % مرارا ، ولكن ما الدماء سواء % 2(@)(@@) % ولكن شفينا النفس من لاعج الأسى % % بقتلهم إن كان منه شفاء % % PageV01P442 البحر : سريع 1(@)(@@) % رجلاى والسبعون قد أوهنت % قواي عن سعي إلى الحرب % 2(@)(@@) % وكنت إن ثوب داعي الوغى % % لبيته بالطعن والضرب % 3(@)(@@) % أشق بالسيف دجى نقعها % % شق الدياجي مرسل الشهب % % 4(@)(@@) % أنازل الأقران يرديهم % % من قبل ضربي هامهم رعبي % % 5(@)(@@) % فلم تدع مني الليالي سوى % % صبري على اللأواء والخطب % 6(@)(@@) % ألقى الرزايا رابط الجأش 
ms94	 في % % أحداثها مجتمع اللب % % 7(@)(@@) % ما خانني عزمي ، ولا عزني % % صبري ، ولا ارتاع لها قلبي % % PageV01P443 البحر : كامل تام 1(@)(@@) % أنا تاج فرسان الهياج ، ومن بهم % ثبتت أواخي ملك كل متوج % 2(@)(@@) % قوم إذا لبسوا الحديد عجبت من % % بحر تدافع في لظى متوهج % 3(@)(@@) % صبر إذا ما ضاق معترك القنا % % فرجت سيوفهم مضيق المنهج % % 4(@)(@@) % وإذا رجوتهم لنصر صدقوا % % بعظيم بأسهم رجاء المرتجي % % PageV01P444 البحر : بسيط تام 1(@)(@@) % لخمس عشرة نازلت الكماة إلى % % أن شبت فيها وخير الخيل ما قرحا % % 2(@)(@@) % أخوضها كشهاب القذف مبتسما % طلق المحيا ، ووجه الموت قد كلحا % % 3(@)(@@) % بصارم ، من رآه في قتام وغى % % أفري به الهام ظن البرق قد لمحا % % 4(@)(@@) % أغدو لنار الوغى في الحرب إن خمدت % % بالبيض في البيض والهامات مقتدحا % % 5(@)(@@) % فسل كماة الوغى عني ، لتعلم كم % % كرب كشفت ، وكم ضيق بي انفسحا % % PageV01P445 البحر : طويل 1(@)(@@) % ولكنني ألقى الحوادث وادعا ولكنني ألقى الحوادث وادعا % بقلب أريب بأسه يتوقد % 2(@)(@@) % أبي على عدل الزمان وجوره % % غنى عن الأعوان إن قل مسعد % 3(@)(@@) % فما هو في خطب وإن راع جازع % % مروع ولا في حادث متبلد % % PageV01P446 البحر : رجز تام 1(@)(@@) % يا عجبا من وشك بين ما رغت % % فيه مطايانا ولا الحادي حدا % % 2(@)(@@) % نرى الجمال المصحبات بيننا % % مهملات والرجال بددا % % 3(@)(@@) % موقف توديع ترى البيض به % % شهبا وهابى النقع ليلا أسودا % % 4(@)(@@) % وللطعان في الكماة أعينا % تهمي على السرد نجيعا مزبدا % % 5(@)(@@) % فيا له من موقف رقيبه % % كتائب الأعداء والواشي الردى % % 6(@)(@@) % لو لم تكن عادتي الإقدام في % % أمثاله قضيت فيه كمدا % % 7(@)(@@) % ومنها : لا تحسبن الرزء أوهى جلدي % % إن النسيم لا يفض الجلمدا % % 8(@)(@@) % وهل يروع الخطب قلب أروع % إن كلب الدهر عليه أسدا % % 9(@)(@@) % متى رآني الشامتون ضرعا % لنكبة تعرقني عرق المدى % % 10(@)(@@) % هم يعلمون أنني صلب من % % صم الصفا فما عدا مما بدا % % PageV01P447 11(@)(@@) % هل بزني الخطب سوى وفري الذي % % كان مباحا للنوال والندى % % 12(@)(@@) % إن جمعوا المال فأوعوا أتلفت % يدي طريف ما حوت 
ms95	 والتلدا % % 13(@)(@@) % هم يرون المال ذخرا باقيا % وإنما ذخر الفتى أن يحمدا % % PageV01P448 البحر : بسيط تام 1(@)(@@) % سل بي كماة الوغى في كل معركة % يضيق بالنفس فيها صدر ذي الباس % 2(@)(@@) % ينبؤك بأني في مضايقها % % ثبت إذا الخوف هز الشاهق الراسي % % 3(@)(@@) % أخوضها كشهاب ، القذف ، يصحبني % % عضب كبرق سرى أو ضوء مقباس % % 4(@)(@@) % إذا ضربت به قرنا أنازله % % أوحاه عن عائد يغشاه أو آسي % % PageV01P449 البحر : طويل 1(@)(@@) % وقال في قصيدة مضى أكثرهاولكن قضت فينا الليالي بجورها % % وعادتها كفر الفضائل والغمط % 2(@)(@@) % حكى حكمها الميزان ، لادردرها : % فذو النقص يستعلي وذو الفضل ينحط % % 3(@)(@@) % وعندي على ما راب من حدثانها % % صريمة عزم ، مالما عقلت نشط % 4(@)(@@) % تهون عندي الخطب ، والخطب هائل % وتقبض عني كفه ولها البسط % % PageV01P450 البحر : منسرح 1(@)(@@) % قلبي وصبري إلفان مذ خلقا % % تقاسما صادقين لا افترقا % % 2(@)(@@) % أمشي الهوينى ، والخطب في طلبي % % يوضع طورا ، وتارة عنقا % % 3(@)(@@) % ما يطمع الدهر أن أذل ، ولا % تملأ قلبي أهواله فرقا % % 4(@)(@@) % أحنو ضلوعي في كل نائبة % على فؤاد لا يعرف القلقا % % 5(@)(@@) % لا يزدهيه خوف الحمام ، ولا % % عهدته في ملمة خفقا % % PageV01P451 البحر : كامل تام 1(@)(@@) % قالوا ترشفت الليالي ماءه % % واغتاله بعد التمام محاق % 2(@)(@@) % هو جمرة أفنى الزمان لهيبها % % فتضاءلت ، وطباعها الإحراق % PageV01P452 البحر : مجزوء الكامل 1(@)(@@) % قل لابن منقذ الذي % % قد حاز في الفضل الكمالا % % 2(@)(@@) % فلذاك قد أضحى الأنا % % م على فضائله عيالا % 3(@)(@@) % وقريضه عند الظما % % ينسيهم الماء الزلالا % % 4(@)(@@) % كالدر والياقوت ما % % سكن البحار ولا الجبالا % % 5(@)(@@) % لكن يجاور فيض أيم % % ان وأحلاما ثقالا % % 6(@)(@@) % ما كان ظني أن يح % % رم منه لي السحر الحلالا % 7(@)(@@) % كلا ولا يشكو لحم % % ل رسائل مني كلالا % % 8(@)(@@) % كم قد بعثنا نحوك الأش % % عار مسرعة عجالا % % 9(@)(@@) % مثل الحسان الغيد تا % % هت في محاسنها دلالا % 10(@)(@@) % بذلت لك الممنوع ث % % م منحتها منك ابتذالا % PageV01P453 11(@)(@@) % وصددت عنها حين را % % مت من محاسنك الوصالا % 12(@)(@@) % ما كان مرسلها ، وحق % قك ، يستحق بها الملالا % 13(@)(@@) % هلا 
ms96	 بذلت لنا مقا % % فلم يدع منها خلالا % 14(@)(@@) % مع أننا نوليك صب % % را في المودة واحتمالا % 15(@)(@@) % ونبثك الأخبار إن % % أضحت قصارا أو طوالا % % 16(@)(@@) % سارت سرايانا لقص % % د الشام تعتسف الرمالا % % 17(@)(@@) % تزجى إلى الأعداء جر % % د الخيل أتباعا توالى % % 18(@)(@@) % تمضي خفافا للمغا % % ر بها وتأتينا ثقالا % 19(@)(@@) % حتى لقد رام الأعا % % دي من ديارهم ارتحالا % % 20(@)(@@) % وعلى الوعيرة معشر % لم يعهدوا فيها القتالا % PageV01P454 21(@)(@@) % لما نأت عمن يح % % ف بها يمينا أو شمالا % 22(@)(@@) % نهضت إليها خيلنا % % من مصر تحتمل الرجالا % % 23(@)(@@) % والبيض لامعة وبي % % ضا لهند والأسل النهالا % % 24(@)(@@) % % في أرضها حيا حلالا % 25(@)(@@) % هذا ، وفي تل العجو % % ل ملأن بالقتلى التلالا % % 26(@)(@@) % إذ مر مرى ليس يل % % وى نحو رفقته اشتغالا % 27(@)(@@) % واستاق عسكرنا له % % أهلا يحبهم ومالا % % 28(@)(@@) % وسرية ابن فريج الطا % % ئي طال بها وصالا % % 29(@)(@@) % سارت إلى أرض الخلي % % ل فلم تدع فيها خلالا % % 30(@)(@@) % فلو أن نور الدين يج % % عل فعلنا فيهم مثالا % PageV01P455 31(@)(@@) % ويسير الأجناد جه % % را كي ينازلهم نزالا % % 32(@)(@@) % ويفي لنا ولأهل دو % % لته بما قد كان قالا % 33(@)(@@) % لرأيت للإفرنج ط % % را في معاقلها اعتقالا % 34(@)(@@) % وتجهزوا للسير نحو % و الغرب أو قصدوا الشمالا % % 35(@)(@@) % وإذا أبى إلا اط % حا للنصحية واعتزالا % % 36(@)(@@) % عدنا بتسليم الأمور % لحكم خالقنا تعالى % % 38(@)(@@) % % لاقا وأكرمهم فعالا % % 39(@)(@@) % وأعزهم جارا ، وأم % % نعهم حمى وأجل آلا % % 40(@)(@@) % وأعمهم جودا إذا % % جادوا وأكثرهم نوالا % % 41(@)(@@) % فلذاك قد أضحى الأنا % % م على مكارمه عيالا % PageV01P456 42(@)(@@) % وحمى البلاد بسيفه % % عن أن تذال ، وأن تدالا % 43(@)(@@) % وأحل بالإفرنج في % % بر وفي بحر نكالا % % 44(@)(@@) % حتى لقد سئموا لقا % % ء جيوش مصر والقتالا % 45(@)(@@) % نبهت عبدا طالما % % نبهته قدرا وحالا % 46(@)(@@) % وعتبته فأنلته % % شرفا ومجدا لن ينالا % 47(@)(@@) % وكسوته شرفا إذا % % ما طاولته الشهب طالا % 48(@)(@@) % لكن ذاك العتب يش % % عل في جوانحه اشتعالا % 49(@)(@@) % أسفا لجد مال عن % % ه إلى مساءته ، ومالا % 50(@)(@@) % وحماه ، وهو الحائم 
ms97	 الظ % % ما ن ، أن يرد الزلالا % 51(@)(@@) % وأجر مقوله فصر % % ن الحادثات له عقالا % PageV01P457 52(@)(@@) % فلو استطاع السعى ، وه % % و الفرض ، لم يرض المقالا % 53(@)(@@) % لكنها الأيام تو % % سعنا مطالا واعتلالا % % 54(@)(@@) % وتسوف الراجى ، وتو % % رد ذا الصدى الظمآن آلا % % 55(@)(@@) % والدهر لا ينفك يب % % رى ، أو يريش لنا النبالا % % 56(@)(@@) % ويصدنا عما نحا % % وله جهارا واغتيالا % 57(@)(@@) % وإذا حمدناه على % % حال تنكر واستحالا % % 58(@)(@@) % وذنوبه مغفورة % لو كاثرت فينا الرمالا % 59(@)(@@) % بالصالح الملك الذي % % جمع المهابة والجلالا % 60(@)(@@) % ملك إذا زغنا أقا % % ل ، وإن سألناه أنالا % 61(@)(@@) % فيبيح جاهلنا وسائ % ئلنا نوالا واحتمالا % % PageV01P458 62(@)(@@) % فإليه معذرة المق % % صر من إساءته استقالا % % 63(@)(@@) % وبفضل مالكه تعو % % ذ أن يظن به الملالا % % 64(@)(@@) % أو أنه يشكو الكلا % ل لسمعه السحر الحلالا % % 65(@)(@@) % وهو النهوض بما تح % % مله ، ولو حمل الجبالا % 66(@)(@@) % أما السرايا حين تر % % جع بعد خفتها ثقالا % 67(@)(@@) % فكذاك عاد وفود با % % بك مثقلين نثا ومالا % 68(@)(@@) % ومسيرها في كل أرض % % تبتغي فيها المجالا % % 69(@)(@@) % فكذاك فضلك مثل عد % % لك في الدنا سارا وجالا % % 70(@)(@@) % فاسلم لنا ، حتى نرى % % لك في بني الدنيا مثالا % % 71(@)(@@) % واشدد يديك بود نور % الدين ، والق به الرجالا % PageV01P459 72(@)(@@) % فهو المحامي عن بلا % % د الشام جمعا أن تذالا % % 73(@)(@@) % ومبيد أملاك الفرن % % ج وجمعهم حالا فحالا % % 74(@)(@@) % ملك يتيه الدهر والد % نيا بدولته اختيالا % 76(@)(@@) % فإذا بدا للناظري % % ن رأت عيونهم ، الكمالا % 77(@)(@@) % فبقيتما للمسلمي % % ن حمى وللدنيا جمالا % % PageV01P460 البحر : طويل 1(@)(@@) % يجهل في الإقدام رأيي معاشر % أراهم إذا فروا من الموت أجهلا % 2(@)(@@) % أيرجو الفتى عند انقضاء حياته % % وإن فر عن ورد المنية مزحلا % % 3(@)(@@) % إذا أنا هبت الموت في حومة الوغى % % فلا وجدت نفسي من الموت موئلا % % 4(@)(@@) % وإني إذا نازلت كبش كتيبة % % فلست أبالي أينا مات أولا % PageV01P461 البحر : كامل تام 1(@)(@@) % قل للخطوب : إليك عني ، إن لي % % في الخطب عزما مثل حد المنصل % % 2(@)(@@) % لا يستكين لحادث من نكبة % طرقت ، ولا 
ms98	 يعيا بأمر مشكل % 3(@)(@@) % يلقى الخطوب ، إذا دجت أهوالها % % بالصبر حتى تضمحل وتنجلي % % 4(@)(@@) % تنجاب عنه الحادثات إذا عرت % عن قلب ثبت العزائم حول % % 5(@)(@@) % قد جرب الأيام حتى خلته % % يبدى له الماضي خفي المقبل % PageV01P462 البحر : طويل 1(@)(@@) % إذا ضاق بالخطي معترك الوغى % % وهال الردى وقع الظبا في الجماجم % % 2(@)(@@) % سل الموت عني ، فهو يشهد أنني % % على خوضه في الحرب ثبت العزائم % % PageV01P463 البحر : وافر تام 1(@)(@@) % معين الدين ، كم لك طوق من % بجيدي ، مثل أطواق الحمام % % 2(@)(@@) % تعبدني لك الإحسان طوعا % وفي الإحسان رق للكرام % % 3(@)(@@) % فصار إلى مودتك انتسابي % % على أني العظامي العصامي % % 4(@)(@@) % ألم تعلم بأني لا نتمائي % % إليك رمى سوادي كل رام % % 5(@)(@@) % ولولا أنت لم يصحب شماسي % % لقسر دون إعذار الحسام % % 6(@)(@@) % ولكن خفت من نار الأعادي % % عليك فكنت إطفاء الضرام % % PageV01P464 البحر : طويل 1(@)(@@) % ألا هكذا في الله تمضي العزائم % % وتمضي لدى الحرب السيوف الصوارم % 2(@)(@@) % وتستنزل الأعداء من طود عزهم % % وليس سوى سمر الرماح سلالم % % 3(@)(@@) % وتغزى جيوش الكفر في عقر دارها % % ويوطا حماها والأنوف رواغم % % 4(@)(@@) % ويوفي الكرام الناذرون بنذرهم % % وإن بذلت فيه النفوس الكرائم % % 5(@)(@@) % نذرنا مسير الجيش في صفر فما % % مضى نصفه ، حتى انثنى وهو غائم % 6(@)(@@) % بعثناه من مصر إلى الشام قاطعا % مفاوز وخد العيس فيهن دائم % % 7(@)(@@) % وناهيك من أرض الجفار إذا التظى % % بجنبيه مشبوب من القيظ جاحم % % 8(@)(@@) % وصارت عيون الماء كالعين عزة % إذا ما أتاها العسكر المتزاحم % 9(@)(@@) % فما هاله بعد الديار ولا ثنى % % عزيمته جهد الظما والسمائم % 10(@)(@@) % يهجر والعصفور في قعر وكره % % ويسرى إلى الأعداء ، والنجم نائم % PageV01P465 11(@)(@@) % إذا ما طوى الرايات وقت مسيره % % غدت عوضا منها الطيور الحوائم % 12(@)(@@) % تباري خيولا ما تزال كأنها % % إذا ما هي انقضت نسور قشاعم % 13(@)(@@) % فإن طلبت قصدا تساوين سرعة % قوادمها في جوها والقوائم % 14(@)(@@) % هي الدهم ألوانا وصبغ عجاجة % فإن طلبت أعداءها فالأداهم % % 15(@)(@@) % تصاحبها علما بأن سوف نغتدي % % بها ولها في الكافرين مطاعم % % 16(@)(@@) % كما أن وحش 
ms99	 القفر ما زال منهم % مدى الدهر أعراس لهم وولائم % 17(@)(@@) % خيول إذا ما فارقت مصر تبتغي % % عدى فلها النصر المبين ملازم % % 18(@)(@@) % يسير بها ضرغام في كل مأزق % % وما يصحب الضرغام إلا الضراغم % % 19(@)(@@) % ورفقته عين الزمان وحاتم % % ويحيى وإن لاقى المنية حاتم % % 20(@)(@@) % مضى طاهر الأثواب من كل ريبة % % شهيدا ، كما تمضي السراة الأكارم % PageV01P466 21(@)(@@) % هنيئا له يسقى الرحيق إذا غدت % % تحييه في الخلد الحسان النواعم % % 22(@)(@@) % ولو أننا نبكي على فقد هالك % % لقلت له منا الدموع السواجم % 23(@)(@@) % ولكننا بعنا الإله نفوسنا % % ورحنا وما منا على البيع نادم % % 24(@)(@@) % تهون علينا أن تصاب نفوسنا % % إذا لم تصبنا في الحياة المآثم % % 25(@)(@@) % وما خام إذ لاقى همام وصنوه % % عشية أصوات الرجال هماهم % 26(@)(@@) % وبرقية شاموا السيوف فلم يعش % % لبارقها في ساحة الشام شائم % 27(@)(@@) % وأفناء جند لو توجه جمعهم % % لرومية جالت عليها المقاسم % % 28(@)(@@) % وجمع مماليك بأفعالنا اقتدوا % % فكلهم بالطعن والضرب عالم % 29(@)(@@) % وسنبس قد شادوا المعالي بفعلهم % % وليس لهم إلا العوالي دعائم % % 30(@)(@@) % وثعلبة أضحوا بنا قد تأسدوا % % فما لهم في المشركين مقاوم % PageV01P467 31(@)(@@) % وإن جذاما لم يزل قط منهم % قديما لحبل الكفر بالشام جاذم % 32(@)(@@) % جيوش أفدناها اعتزاما ونجدة % فطاعننا منهم ومنا العزائم % % 33(@)(@@) % إذا ماأثاروا النقع ، فالثغر عابس % وإن جردوا الأسياف فالثغر باسم % 34(@)(@@) % ولما وطوا أرض الشا م تحالفت % % فأضحت جميعا عربها والأعاجم % 35(@)(@@) % وواجههم جمع الفرنج بحملة % تهون على الشجعان منها الهزائم % 36(@)(@@) % فلقوهم رزق الأسنة وانطووا % % عليهم فلم ينجم من الكفر ناجم % % 37(@)(@@) % وما زالت الحرب العوان أشدها % % إذا ما تلاقى العسكر المتصادم % 38(@)(@@) % يشبههم من لاح جمعهم له % % بلجة بحر موجها متلاطم % % 39(@)(@@) % وحسبك أن لم يبق في القوم فارس % من الجيش إلا وهو للرمح حاطم % 40(@)(@@) % وعادوا إلى سل السيوف ؛ فقطعت % رؤوس وحزت للفرنج غلاصم % % PageV01P468 41(@)(@@) % فلم ينج منهم يوميذاك مخبر % % ولا قيل : هذا وحده اليوم سالم % 42(@)(@@) % كذلك ما ينفك تهدى إلى العدا % % وللوحش أعراس لهم وما تم % 43(@)(@@) % وتسري 
ms100	 لهم آراؤنا وجيوشنا % % بداهية تبيض منها المقادم % 44(@)(@@) % نقتلهم بالرأي طورا وتارة % تدوسهم منا المذاكي الصلادم % 45(@)(@@) % وما العازم المحمود إلا الذي يرى % % مع العزم في أحواله ، وهو حازم % 46(@)(@@) % وقد غرق الكفار منه بقطرة % سحاب انتقام عندنا متراكم % % 47(@)(@@) % فكيف إذا سالت عليهم سيولنا % % وجاشت لنا تلك البحار الخضارم % 48(@)(@@) % وما نحن بالإسلام للشرك هازم % % ولكننا الإيمان للكفر هادم % % 49(@)(@@) % فقولوا لنور الدين ، لا فل حده % % ولا حكمت فيه الليالي الغواشم % % 50(@)(@@) % تجهز إلى أرض العدو ولا تهن % وتظهر فتورا أن مضت منك حارم % PageV01P469 51(@)(@@) % فما مثلها تبدي احتفالا به ولا % % تعض عليها للملوك الأباهم % 52(@)(@@) % فعندك من ألطاف ربك ما به % % علمنا يقينا أنه لك راحم % % 53(@)(@@) % أعادك حيا بعد أن زعم الورى % % بأنك قد لاقيت ما الله حاتم % % 54(@)(@@) % بوقت أصاب الأرض ما قد أصابها % % وحلت بها تلك الدواهي العظائم % % 55(@)(@@) % وخيم جيش الفكر في أرض شيزر % % فسيقت سبايا واستحلت محارم % % 56(@)(@@) % وقد كان تاريخ الشآم وهلكه % % ومن يحتويه أنه لك عادم % 57(@)(@@) % فقم واشكر الله الكريم بنهضة % % إليهم ، فشكر الله للخلق لازم % 58(@)(@@) % فنحن على ما قد عهدت نروعهم % % ونحلف جهدا أننا لا نسالم % 59(@)(@@) % وغاراتنا ليست تفتر عنهم % % يسوق أساطيل الفرنج اليهم % 60(@)(@@) % وأسطولنا أضعاف ما كان سائرا % إليهم فلا حصن لهم منه عاصم % PageV01P470 61(@)(@@) % ونرجو بأن نجتاح باقيهم به % % وتحوى الأسارى منهم والغنائم % % 62(@)(@@) % على أننا نلنا من المجد ما به % % نفاخر أملاك الورى ونقاوم % % 63(@)(@@) % ولكننا نبغي المثوبة جهدنا % % وطاقتنا ، والله معط وحارم % 64(@)(@@) % ونختم بالحسنى الفعال ، وإنما % % ترين أعمال الرجال الخواتم % % 66(@)(@@) % % فمن حاتم ما نال ذا الفخر حاتم % % 67(@)(@@) % وصلت ، فأغنيت الأنام عن الحيا % % وصلت ؛ فخافت من سطاك الصوارم % 68(@)(@@) % وجدت على بخل الزمان فأين من % % نداك السكوب المستهل الغمائم % % 69(@)(@@) % تكفلت للإسلام أنك مانع % % حماه مبيح ما حمى الكفر هادم % % 70(@)(@@) % فأصبحت ترعى سرحه بصريمة % % من العزم ، لم تبلغ مداها العزائم % 71(@)(@@) % وأيدته بالعدل والبذل والتقى % % وضرب الطلى والصالحات دعائم 