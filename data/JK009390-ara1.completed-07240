ms7221	 ) . )(@)(@@)(@@)(@@) $ 16996 عن نافع قال :(@)(@@) | 30 ( أقيمت الصلاة في مسجد بطائفة المدينة ، ولعبد الله بن عمر رضي الله عنهما هناك أرض ، وإمام ذالك المسجد مولى ، فجاء ابن عمر يشهد الصلاة ، فقال المولاى تقدم فصل ، فقال ابن عمر رضي الله عنهما : أنت أحق أن تصلي في مسجدك ، فصلى المولاى ) . ( عب ) . )(@)(@@)(@@)(@@) $ 16997 عن عبد الله بن دينار ، عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سئل رسول الله عن القراءة خلف الإمام ، فقال : الإمام يقرأ ) . ( هق في القراءة وضعفه ) . )(@)(@@)(@@)(@@) $ 16998 عن رجاء بن حيوة ، عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( صلينا مع رسول الله فقال : هل تقرءون القرآن معي إذا كنتم معي في الصلاة ؟ قالوا : نعم ، قال : فلا تفعلوا إلا بأم القرآن ) . ( هق في كتاب القراءة ) . )(@)(@@)(@@)(@@) $ 16999 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ما خطا رجل خطوة أعظم أجرا من خطوة خطاها إلاى ثلمة صف سدها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17000 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لأن تقع ثنيتاي أحب إلي من أن أراى فرجة في الصف أمامي ولا أصلها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17001 عن الزهري :(@)(@@) | 30 ( أن زيد بن ثابت ، وابن عمر رضي الله عنهما كانا يفتيان الرجل : إذا انتهاى إلاى القوم وهم ركوع أن يكبر تكبيرة وقد أدرك الركعة ، قالا : وإن وجدهم سجودا سجد معهم ولم يعتد بذالك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17002 عن نافع قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما إذا سبق بشيء من الصلاة ، فإذا سلم الإمام قام فقضاى ما فاته ، وإذا لم يسبق بشيء لم يقم حتى يقوم الإمام ) . ( عب ، ه ) . )(@)(@@) PageV20P335(@)(@@)(@@)(@@) $ 17003 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لا يصلين أحد عن أحد ، ولاكن إن كنت فاعلا تصدقت عنه أو أهديت ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17004 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا رأى الإنسان في ثوبه دما وهو في الصلاة فانصرف يغسله ، أتم ما بقي علاى ما مضاى ما لم يتكلم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17005 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا رعف 
ms7222	 الرجل في الصلاة ، أو ذرعه القيء ، أو وجد مذيا ، فإنه ينصرف فيتوضأ ، ثم يرجع فيتم ما بقي علاى ما مضاى ما لم يتكلم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17006 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا ونحن شباب نبيت في عهد رسول الله في المسجد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17007 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا نجمع ، ثم نرجع فنقيل ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17008 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما أذن وهو بضجنان بين مكة والمدينة في عشية ذات ريح وبرد ، فلما قضاى النداء قال لأصحابه : ألا صلوا في الرحال ، ثم حدث أن رسول الله كان يأمر مناديه بذالك في الليلة الباردة والمطيرة أو ذات ريح ، إذا فرغ من أذانه قال : ( ألا صلوا في الرحال مرتين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17009 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه وجد بردا شديدا وهو في سفر ، فأمر المؤذن ومن معه أن يصلوا في رحالهم ، فقال : إني رأيت رسول الله يأمر بذالك إذا كان مثل هاذا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17010 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان المسلمون حين قدموا المدينة يجتمعون فيتحينون الصلاة ليس ينادي بها أحد ، فتكلموا يوما في ذالك ، فقال بعضهم : اتخذوا ناقوسا مثل ناقوس النصاراى ، وقال بعضهم : اتخذوا بوقا مثل بوق اليهود ، فقال عمر رضي الله عنه : أولا تبعثون رجلا ينادي بالصلاة ؟ فقال رسول الله : يا بلال قم فأذن بالصلاة ) . ( عب وأبو الشيخ في الأذان ) . )(@)(@@) PageV20P336(@)(@@)(@@)(@@) $ 17011 عن الزهري ، عن سالم ، عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( استشار النبي المسلمين فيما يجمعهم علاى الصلاة ، فقالوا : البوق ، فكرهه من أجل اليهود ، ثم ذكر الناقوس ، فكرهه من أجل النصاراى ، فأري تلك الليلة النداء رجل من الأنصار ، يقال له : عبد الله بن زيد ، وعمر بن الخطاب رضي الله عنهما ، وطرق الأنصاري رسول الله ليلافأمر رسول الله بلالا فأذن به ، قال الزهري : وزاد بلال رضي الله عنه في نداء صلاة الفجر : الصلاة خير من النوم ، فأقرها النبي فقال عمر رضي الله 
ms7223	 عنه : أما إني قد رأيت مثل الذي رأى ، ولاكنه سبقني ) . ( أبو الشيخ في كتاب الأذان ، وسنده علاى شرط ( م ) ) . )(@)(@@)(@@)(@@) $ 17012 عن عبد الله بن نافع ، عن أبيه ، عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن بلالا رضي الله عنه كان يقول أول ما أذن : أشهد أن لا إلاه إلا الله ، حي علاى الصلاة ، فقال عمر : قل في أثرها : أشهد أن محمدا رسول الله ، فقال النبي : قل كما أمرك عمر ) . ( أبو الشيخ ، وعبد الله بن نافع ضعيف ) . )(@)(@@)(@@)(@@) $ 17013 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( الإقامة واحدة ، قال : كذالك أذان بلال ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17014 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان الأذان علاى عهد رسول الله مثنى مثناى ، والإقامة واحدة ) . ( أبو الشيخ في الأذان ) . )(@)(@@)(@@)(@@) $ 17015 عن يعلاى بن عطاء ، عن أبيه قال :(@)(@@) | 30 ( كنت مع عبد الله بن عمر رضي الله عنهما ، فحضرت الصلاة ، فقال لي : أذن وامدد صوتك ، فإنه لا يسمع من حجر ، ولا شجر ، ولا مدر ، إلا شهد لك به يوم القيامة ، ولا يسمعك من شيطان إلا وله نفير ، قال هشيم : يعني ضراطا ، حتى لا يسمع مد صوتك ، وإنهم لأمد الناس أعناقا يوم القيامة ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17016 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي أمر بلالا رضي الله عنه أن يشفع الأذان ، ويوتر الإقامة ) . ( ابن النجار ) . )(@)(@@) PageV20P337(@)(@@)(@@)(@@) $ 17017 عن مجاهد قال :(@)(@@) | 30 ( كنت مع ابن عمر رضي الله عنهما فسمع رجلا يثوب في المسجد ، فقال : اخرج بنا من عند هاذا المبتدع ) . ( عب ، ض ) . )(@)(@@)(@@)(@@) $ 17018 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( جاء بلال رضي الله عنه إلاى النبي يؤذنه الصلاة صلاة الصبح ، فقال : السلام عليك أيها النبي ورحمة الله وبركاته ، الصلاة يرحمك الله قالها مرتين أو ثلاثا ، ورسول الله قد أغفاى ، فجاء بلال فقال : الصلاة خير من النوم ، فانتبه رسول الله . فقال : اجعله في أذانك إذا أذنت لصلاة الصبح ، فقل : الصلاة خير من النوم مرتين فجعل بلال يقولها في كل أذانه إذا أذن في صلاة الصبح 
ms7224	 ، كما أمره رسول الله ) . ( أبو الشيخض ) . )(@)(@@)(@@)(@@) $ 17019 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان بلال رضي الله عنه يشفع الأذان ، ويوتر الإقامة ) . ( ص ، ش ) . )(@)(@@)(@@)(@@) $ 17020 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان للنبي مؤذنان بلال ، وابن أم مكتوم رضي الله عنهما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17021 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أن النبي كان يخطب خطبتين يجلس بينهما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17022 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله إذا دنا من منبره يوم الجمعة ، سلم علاى من عنده من الجلوس ، فإذا صعد المنبر ، استقبل الناس بوجهه ثم سلم ) . ( كر ، عد ) . )(@)(@@)(@@)(@@) $ 17023 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي كان يصلي بعد الجمعة ركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17024 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله يصلي PageV20P338 الركعتين بعد الجمعة في بيته ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17025 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أشد حديث جاء عن النبي أنه قال : إذا جاء أحدكم إلاى الجمعة فليغتسل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17026 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي لم يكن يصلي بعد المغرب ولا بعد الجمعة إلا في بيته ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17027 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما صلى علاى راحلته وأوتر عليها ، قال : وكان النبي يفعله ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17028 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه كان يصلي علاى راحلته تطوعا حيث توجهت به ، ويخبرهم أن رسول الله كان يفعله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17029 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( رأيت رسول الله يصلي علاى حمار تطوعا ، وهو متوجه إلاى خيبر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17030 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أوتر رسول الله علاى بعير ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17031 عن قيصر :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يصلي علاى راحلته حيث توجهت به فسئل : أسنة هي ؟ قال : سنة ، قال : أسمعتها من رسول الله ؟ فتبسم وقال : سمعتها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17032 عن عبد الله بن عمر رضي الله 
ms7225	 عنهما قال :(@)(@@) | 30 ( كان الرجل في حياة رسول الله إذا رأى رؤيا قصها علاى رسول الله فتمنيت أن أراى رؤيا أقصها علاى رسول الله ، وكنت غلاما شابا عزبا ، فكنت أنام في المسجد علاى عهد رسول الله ، فرأيت في النوم كأن ملكين أخذاني فذهبا بي إلاى النار ، فإذا هي مطوية كطي البئر ، فإذا للنار شيء كقرني البئر ، وإذا فيها ناس عزقتهم النار ، PageV20P339 فجعلت أقول : أعوذ بالله من النار ، قال : فلقيهما ملك آخر ، فقال : لن تراع ، فقصصتها علاى حفصة فقصتها حفصة رضي الله عنها علاى رسول الله ، فقال : نعم الرجل عبد الله لو كان يصلي من الليل ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17033 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فسأله عن صلاة الليل ، فقال : مثنى مثنى ، فإذا خشيت أن تصبح فصل واحدة توتر بها صلاتك ، فإن الله تعالاى فرد يحب الفرد ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17034 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ناداى رجل من أهل البادية رسول الله وأنا بينهما ، ما تقول في صلاة الليل ؟ فقال : مثنى مثنى ، فإذا خشيت أو أحسست الصبح فاسجد سجدتين قبل صلاة الصبح ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17035 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رجلا قال : يا نبي الله كيف تأمرنا أن نصلي بالليل ؟ فقال : يصلي أحدكم مثنى مثنى فإذا خشي الصبح واحدة أوتر بها ما صلى من الليل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17036 عن عقبة بن حريث قال :(@)(@@) | 30 ( سمعت ابن عمر رضي الله عنهما يحدث أن رسول الله قال : صلاة الليل مثنى مثنى ، فإذا رأيت الصبح يدركك فأوتر بواحدة ، فقيل لابن عمر : ما مثنى مثنى ؟ قال : تسلم في كل ركعتين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17037 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( صلى النبي صلاة الخوف بإحداى الطائفتين ركعة ، والطائفة الأخراى مواجهة العدو ، ثم انصرفوا وقاموا في مقام أصحابهم مقبلين علاى العدو ، وجاء أولائك فصلى بهم النبي ركعة ، ثم سلم النبي ، ثم قضاى هاؤلاء ركعة وهاؤلاء ركعة ) . ( عب )(@)(@@)(@@)(@@) $ 17038 عن ابن عمر رضي الله عنهما 
ms7226	 :(@)(@@) | 30 ( أنه صلى مع رسول الله صلاة الخوف قال : فكبر رسول الله ، فصف وراءه طائفة منا ، وأقبلت الطائفة علاى العدو ، فركع لهم النبي ركعة وسجدتين ، يسجد مثل نصف صلاة الصبح ، ثم انصرفوا فأقبلوا علاى العدو ، وجاءت الطائفة الأخراى فصلوا مع النبي ففعل مثل PageV20P340 ذالك ، ثم سلم ، فقام كل رجل من الطائفتين وصلى لنفسه ركعة وسجدتين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17039 عن ابن عمر رضي الله عنهما أنه قال :(@)(@@) | 30 ( والله إن هاذا القمر ليبكي من خشية الله ، فمن استطاع منكم أن يبكي فليبك ومن لم يستطع فليتباك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17040 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( انكسفت الشمس علاى عهد رسول الله يوم مات إبراهيم ابنه ، فقال الناس : انكسفت لموت إبراهيم ، فخرج رسول الله فأطال القيام حتى قيل : لن يركع ، ثم ركع حتى قيل : لن يرفع رأسه ، ثم رفع رأسه فأطال القيام علاى نحو الأول ، فصلى أربع ركعات في سجدتين ، ثم قال : يا أيها الناس إن الشمس والقمر آيتان من آيات الله تعالاى ، لا ينكسفان لموت أحد ولا لحياته ، فإذا رأيتموهما قد انكسفا فافزعوا إلاى الصلاة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17041 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله صلى في كسوف الشمس ركعتين ، في كل ركعة ركعتين ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17042 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله إذا رأى الهلال قال : الله أكبر ، اللهم أهله علينا بالأمن والأمان والسلامة والإسلام ، والتوفيق لما تحب وترضاى ، ربنا وربك الله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17043 عنابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : أتاكم شهر رمضان ، تزين فيه الحور العين ، قال رسول الله : إذا كان آخر يوم من شهر رمضان أعتق فيه مثل جميع ما أعتق يعني في رمضان ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17044 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إنما سمي رمضان لأن الذنوب ترمض فيه ، وإنما سمي شوال لأنه يشول الذنوب كما تشول الناقة ذنبها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17045 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله احتجم بين مكة 
ms7227	 PageV20P341 والمدينة وهو محرم صائم ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17046 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال النبي : انطلق فناد : إنه لا تدخل الجنة إلا نفس مسلمة ، وإن أيام التشريق أيام أكل وشرب ) . ( ابن عساكر ، عن بشر بن سحيم ) . )(@)(@@)(@@)(@@) $ 17047 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( بينما النبي يتسحر ، فلما فرغ من سحوره ، جاء علقمة بن علاثة ، فدخل علاى النبي برأس ، فبينما هو يأكل إذ جاء بلال رضي الله عنه يؤذن النبي بالصلاة ، فقال النبي : رويدك يا بلال حتى يفرغ علقمة من سحوره ) . ( كر ، الديلمي ) . )(@)(@@)(@@)(@@) $ 17048 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان علقمة بن علاثة عند رسول الله . فجاء بلال رضي الله عنه يؤذنه بالصلاة ، فقال رسول الله : رويدك يا بلال يتسحر علقمة ، قال : وهو يتسحر برأس ) . ( ط ، كر ) . )(@)(@@)(@@)(@@) $ 17049 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال النبي : إن الله تبارك وتعالاى وهب لامتي ليلة القدر ، ولم يعطها من كان قبلكم ) . ( الديلمي ، عن أنس ) . )(@)(@@)(@@)(@@) $ 17050 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله كان يكبر يوم الفطر ، من حين يخرج من بيته حتى يأتي المصلى ) . ( هق ، كر ) . )(@)(@@)(@@)(@@) $ 17051 عن عطاء :(@)(@@) | 30 ( أن عروة قال لعبد الله بن عمر رضي الله عنهما : هل كان رسول الله يصوم في رجب ؟ قال : نعم ويشرفه ) . ( أبو الحسن علي بن محمد بن شجاع الربعي في فضل رجب ؛ ورجاله كلهم ثقات ) . )(@)(@@)(@@)(@@) $ 17052 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان يوم عاشوراء يوما يصومه أهل الجاهلية ، فلما فرض صوم رمضان سئل عنه النبي ؟ فقال : هو يوم من أيام الله تعالاى ، فمن شاء صامه ، ومن شاء تركه ) . ( ذكره ابن جرير ) . )(@)(@@)(@@)(@@) $ 17053 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن أهل الجاهلية كانوا يصومون يوم PageV20P342 عاشوراء ، وأن رسول الله صامه والمسلمون قبل أن يفترض رمضان ، فلما افترض رمضان قال رسول الله : إن يوم عاشوراء يوم من أيام الله تعالاى ، فمن شاء صامه ، ومن شاء تركه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17054 عن 
ms7228	 ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه ذكر لرسول الله يوم عاشوراء ، فقال : هو يوم كان يصومه أهل الجاهلية ، فمن شاء منكم فليصمه ، ومن كره منكم فليتركه وفي لفظ : فمن أحب أن يصومه فليصمه ، ومن أحب أن يتركه فليتركه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17055 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( دخل رسول الله مسجد بني عمرو بن عوف يصلي فيه ، ودخل معه صهيب رضي الله عنه ، فدخل عليه رجال من الأنصار يسلمون عليه ، فسألت صهيبا ، كيف كان النبي يصنع إذا سلم عليه في الصلاة ؟ قال : كان يشير بيده ) . ( عب ، ش ، وابن جرير ، هب ) . )(@)(@@)(@@)(@@) $ 17056 عن ابن عمر رضي الله عنهما ، عن النبي :(@)(@@) | 30 ( أنه أقبل من الغائط ، فلقيه رجل عند بئر جمل ، فسلم عليه ، فلم يرد عليه النبي ، حتى أتاى الحائط ، فضرب بيده علاى الحائط ، فمسح وجهه ويديه ، ثم رد علاى الرجل السلام ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17057 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( بينما النبي في سكة من سكك المدينة إذ خرج عليه رجل ، وقد خرج النبي من غائط أو بول ، فسلم الرجل عليه ، فلم يرد النبي ، ثم إن النبي ضرب بكفيه علاى الحائط ، ، ثم مسح كفيه علاى وجهه ، ثم ضرب ضربة أخراى ومسح ذراعيه إلاى المرفقين ، ثم رد علاى الرجل السلام ، ثم قال : لم يمنعني أن أرد عليك السلام إلا أني لم أكن علاى وضوء أو علاى طهارة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17058 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رجلا مر علاى النبي وهو يبول ، فسلم عليه فلم يرد عليه السلام ) . ( ابن جرير ) . )(@)(@@) PageV20P343(@)(@@)(@@)(@@) $ 17059 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا سلمت فأسمع ، وإذا رددت فأسمع ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17060 عن ابن عمر رضي الله عنهما ، عن النبي في السواك قال :(@)(@@) | 30 ( ناوله أكبر القوم ، ثم قال : إن جبريل أمرني أن أكبر ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17061 عن ابن عمر رضي الله عنهما قال : ' كره رسول الله صلى الله عليه وسلم أن يقام الرجل من مجلسه فيجلس فيه آخر ، ولكن 
ms7229	 يقول : تفسحوا وتوسعوا ' . ( ابن النجار ) .(@)(@@)(@@)(@@) $ 17062 عن ابن عمر رضي الله عنهما قال : ' لا يقبل الله صلاة بغير طهور ، ولا صدقة من غلول ، ولا نفقة من رياء ' . ( ص ) .(@)(@@)(@@)(@@) $ 17063 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان إذا عطس فقيل له : يرحمك الله ، قال : يرحمنا الله وإياكم ، وغفر لنا ولكم ) . ( هب ) . )(@)(@@)(@@)(@@) $ 17064 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( اجتمع المسلمون واليهود عند رسول الله فشمته الفريقان جميعا ، فقال للمسلمين : يغفر الله لكم ويرحمنا وإياكم ، وقال لليهود : يهديكم الله ويصلح بالكم ) . ( هب ، وقال : تفرد به عبد الله ابن عبد العزيز بن أبي داود ، عن أبيه وهو ضعيف ) . )(@)(@@)(@@)(@@) $ 17065 عن نافع قال :(@)(@@) | 30 ( عطس رجل عند ابن عمر رضي الله عنهما فحمد الله ، فقال له ابن عمر رضي الله عنهما : قد بخلت ، فهلا حيث حمدت الله صليت علاى النبي ) . ( هب ) . )(@)(@@)(@@)(@@) $ 17066 عن الضحاك بن قيس اليشكري قال :(@)(@@) | 30 ( عطس رجل عند ابن عمر رضي الله عنهما ، فقال : الحمد لله رب العالمين ، فقال عبد الله : لو تممتها ، والسلام علاى رسول الله ) . ( هب ) . )(@)(@@) PageV20P344(@)(@@)(@@)(@@) $ 17067 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يمسح رأسه مرة ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17068 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يضع بطن كفه اليمناى علاى الماء ثم لا ينفضها ، ثم يمسح بها ما بين قرنه إلاى الجبين مرة واحدة لا يزيد عليها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17069 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يدخل يديه في الوضوء فيمسح بهما مسحة واحدة اليافوخ فقط ، ثم يدخل أصبعيه في الماء ، ثم يدخلهما في أذنيه ، ثم يرد إبهاميه خلف أذنيه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17070 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يحدث لرأسه ماء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17071 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( الأذنان من الرأس ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17072 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يغسل ظهور أذنيه وبطونهما إلاى الصماخ مع الوجه مرة أو مرتين 
ms7230	 ، ويدخل أصبعيه بعد ما يمسح برأسه في الماء ، ثم يدخلهما في الصماخ مرة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17073 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( دعا رسول الله بماء فتوضأ مرة مرة فقال : هاذه وظيفة الوضوء ، وضوء من لا يقبل الله له صلاة إلا به ، ثم تحدث ساعة ، ثم دعا بماء فتوضأ مرتين مرتين ، فقال : هاذا وضوء ، من يتوضأ به ضعف الله له الأجر مرتين مرتين ، ثم تحدث ساعة ، ثم دعا بماء فتوضأ ثلاثا ثلاثا فقال : هاذا وضوئي ووضوء النبيين من قبلي ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17074 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي كان إذا توضأ عرك عارضيه بعض العرك ، ثم يشبك يديه في لحيته من تحتها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17075 عن ابن جريج قال :(@)(@@) | 30 ( قلت لنافع : أين كان ابن عمر رضي الله عنهما PageV20P345 يجعل الإناء الذي يتوضأ فيه ؟ قال : إلى جنبه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17076 عن الديلمي ، أنبأنا أحمد بن نضر ، حدثنا أحمد بن نيال ، حدثنا الحسين بن عمر ، حدثنا محمد بن عبد الله الشافعي ، حدثنا محمد بن سليمان الباغندي ، حدثنا مقاتل ، حدثنا فضل بن عبيد ، عن سفيان الثوري ، عن عبيد الله العمري ، عن نافع ، عن ابن عمر رضي الله عنهما رفعه قال :(@)(@@) | 30 ( من قرأ آية الكرسي علاى أثر وضوئه ، أعطاه الله عز وجل ثواب أربعين عالما ، ورفع له أربعين درجة ، وزوجه أربعين حوراء )(@)(@@)(@@)(@@) $ 17077 عن بكر بن عبد الله المزني قال :(@)(@@) | 30 ( رأيت ابن عمر رضي الله عنهما بمنى يتوضأ ، ثم يخرج وهو حاف فيطأ ما يطأ ، ثم يدخل المسجد فيصلي ولا يتوضأ ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17078 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يتوضأ لكل صلاة ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17079 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ليدعين أناس يوم القيامة المنقوصين ، قيل : يا أبا عبد الرحمان وما المنقوصون ؟ قال : ينقص أحدهم صلاته في وضوئه والتفاته ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17080 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يكره أن يتوضأ في النحاس ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17081 عن عبد الله بن 
ms7231	 دينار :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان لا يتوضأ في الصفر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17082 عن عبد الله بن دينار قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما يغسل قدميه في طست من نحاس ، وكان يكره أن يشرب في قدح من صفر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17083 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( من مس ذكره فليتوضأ ) . ( عب ) . )(@)(@@) PageV20P346(@)(@@)(@@)(@@) $ 17084 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان ينام وهو جالس فلا يتوضأ ، وإذا نام مضطجعا أعاد الوضوء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17085 عن سالم أو نافع(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يتوضأ مما مست النار ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17086 عن نافع قال :(@)(@@) | 30 ( سمعت رجلا يحدث عن ابن عمر ، عن أبيه رضي الله عنهما أن النبي نهاى أن نستقبل القبلتين ببول أو غائط ) . ( ص ، ش ) . )(@)(@@)(@@)(@@) $ 17087 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله إذا أراد الحاجة برز حتى لا يرى أحدا ، وكان لا يرفع ثوبه حتى يدنو من الأرض ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17088 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( رأيت النبي جالسا يقضي حاجته متوجها نحو القبلة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17089 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ارتقيت فوق سطح لنا فرأيت رسول الله وهو في بيت حفصة رضي الله عنها يضرب الخلأ بين لبنتين ، وهو متوجه نحو بيت المقدس ) . ( عب ) . )(@)(@@)(@@)(@@) $ ( 17090 ) عن ابن عمر رضي الله عنهما قال : ' ظهرت على إجار في بيت حفصة رضي الله عنها في ساعة لم أكن أظن أحدا يخرج فيها ، فرأيت رسول الله صلى الله عليه وسلم على لبنتين لحاجة ، مستقبل بيت المقدس ' . ( ص ) .(@)(@@)(@@)(@@) $ 17091 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه كان يكره أن يتغوط علاى الطريق ، أو يصلي عليها ) . ( عب ) . )(@)(@@) PageV20P347(@)(@@)(@@)(@@) $ 17092 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن فأرة وقعت في زيت فقال : استسرجوا به وادهنوا به الأدم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17093 عن أبي سلمة ، عن عائشة ؛ وعن نافع ، عن ابن عمر :(@)(@@) | 30 ( أن عمر بن الخطاب 
ms7232	 رضي الله عنه سأل رسول الله عن الغسل من الجنابة : فيفرغ علاى يده اليمناى مرتين أو ثلاثا ، ثم يدخل يده اليمناى في الإناء فيصب بها علاى فرجه بيده اليسراى فيغسل ما هناك حتى ينقيه ، ثم يضع يده اليسراى علاى التراب إن شاء ، ثم يصب علاى يده اليسراى حتى ينقيها ، ثم يغسل يده ثلاثا ويستنشق ويمضمض ويغسل وجهه وذراعيه ثلاثا ثلاثا ، حتى إذا بلغ رأسه لم يمسحه ، وأفرغ عليه الماء ، فهاكذا كان غسل رسول الله فيما ذكر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17094 عن سالم قال :(@)(@@) | 30 ( كان أبي يغتسل ثم يتوضأ ، فأقول : أما يجزئك الغسل ؟ قال : أي وضوء أتم من الغسل للجنب ؟ ولاكني يخيل إلي أنه يخرج من ذكري الشيء فأمسه فأتوضأ لذالك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17095 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يقول : إذا لم تمس فرجك بعد أن تقضي غسلك ، فأي وضوء أسبغ من الغسل ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17096 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إني لأحب أن أسبقها إلاى الغسل فأغتسل ثم أتكرى بها حتى أدفأ ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17097 عن نافع قال :(@)(@@) | 30 ( سئل ابن عمر رضي الله عنهما عن الوضوء بعد الغسل ؟ فقال : أي وضوء أفضل ، وفي لفظ : أعم من الغسل ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 17098 عن عبد الله بن عمر رضي الله عنهما :(@)(@@) | 30 ( أن عمر سأل النبي : تصيبني الجنابة فأرقد ؟ قال : إذا أردت أن ترقد فتوضأ ) . ( ش ) . )(@)(@@)(@@)(@@) $ ( 17099 ) عن ابن عمر رضي الله عنهما قال : ' أن عمر سأل النبي صلى الله عليه وسلم هل ينام أحدنا أو يطعم وهو جنب ؟ قال : نعم ، يتوضأ وضوءه للصلاة ' ( عب ) . PageV20P348(@)(@@)(@@)(@@) $ 17100 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال عمر رضي الله عنه : يا رسول الله تصيبني الجنابة من الليل فكيف أصنع ؟ قال : اغسل ذكرك وتوضأ ثم ارقد ) . ( ط ) . )(@)(@@)(@@)(@@) $ 17101 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن عمر سأل رسول الله : أينام أحدنا وهو جنب ؟ قال : إذا أراد أن ينام فليتوضأ ويطعم إن شاء ) . ( العدني ) . )(@)(@@)(@@)(@@) $ 17102 عن ابن 
ms7233	 عمر رضي الله عنهما قال :(@)(@@) | 30 ( سئل رسول الله عن الماء يكون بأرض الفلاة ، وما ينوبه من الدواب والسباع ، فقال رسول الله : إذا بلغ الماء قلتين لم يحمل الخبث ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17103 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( الجنب إذا أراد أن يطعم أو ينام أو يعاود فليتوضأ ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17104 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا نتوضأ نحن والنساء معا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17105 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا نغتسل علاى عهد رسول الله نحن ونساؤنا من إناء واحد ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17106 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( رأيت الرجال والنساء يتوضؤون علاى عهد رسول الله من إناء واحد ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17107 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان الرجال والنساء جميعا يتوضؤون علاى عهد رسول الله من الميضأة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17108 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لا بأس بالوضوء من فضل شراب المرأة وفضل وضوئها ما لم تكن جنبا أو حائضا ، فإذا خلت به فلا تقربه ) . ( عب ) . )(@)(@@) PageV20P349(@)(@@)(@@)(@@) $ 17109 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يكره سؤر الحمار والكلب والهر أن يتوضأ بفضلهم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17110 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( رأيت رسول الله يتيمم بموضع يقال له : مربد الغنم ، ويراى بيوت المدينة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17111 عن عبد الله بن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله أمر بالمسح علاى الخفين يوما وليلة في الحضر ، وللمسافر ثلاثا ) . ( الخطيب في المتفق والمفترق ) . )(@)(@@)(@@)(@@) $ 17112 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا كان الجرح معصوبا فامسح حول العصابة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17113 عن واصل مولاى إبن عيينة ، عن رجل(@)(@@) | 30 سأل ابن عمر رضي الله عنهما عن امرأة تطاول بها دم الحيضة ، فأرادت أن تشرب دواء يقطع الدم عنها ؟ : ( فلم ير ابن عمر به بأسا ، ونعت ابن عمر ماء الأراك ) . ( عب ) . )(@)(@@)(@@)(@@) $ ( 17114 ) عن نافع : ' أن ابن عمر أرسل إلى عائشة رضي الله 
ms7234	 عنها يستفتيها في الحائض أيباشرها ؟ فقالت عائشة : نعم ، يجعل على سفلتها ثوبا ' . ( عب ) .(@)(@@)(@@)(@@) $ 17115 عن شقيق بن سلمة :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما طلق امرأته وهي حائض ، فذكر ذالك عمر رضي الله عنه للنبي ، فأمره أن يرتجعها ، وقال لا تعتد بتلك الحيضة ) . ( العدني ) . )(@)(@@)(@@)(@@) $ 17116 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه طلق امرأته وهي حائض ، فاستفتاى عمر رضي الله عنه رسول الله ، فقال : مر عبد الله فليراجعها ثم ليمسكها حتى تطهر ، ثم تحيض فتطهر ، فإن بدا له أن يطلقها فليطلقها طاهرا قبل أن يمسها فتلك العدة التي أمر الله أن يطلق لها النساء ) . ( مالك ، والشافعي ، عد ، حم ، وعبد بن حميد ، خ ، م ، د ، ن ، ه ، وابن جرير ، وابن منذر ، ع ، وابن مردوية ، هق ) . )(@)(@@) PageV20P350(@)(@@)(@@)(@@) $ 17117 عن مالك :(@)(@@) | 30 ( أنه بلغه دن عمر بن الخطاب ، وعبد الله بن عمر ، وعبد الله بن مسعود ، وسالم بن عبد الله ، والقاسم بن محمد ، وسليمان بن يسار ، وابن شهاب رضي الله عنهم كانوا يقولون : إذا حلف الرجل بطلاق المرأة قبل أن ينكحها ، ثم أثم ، إن ذالك لازم له إذا نكحها ) . ( مالك ) . )(@)(@@)(@@)(@@) $ 17118 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أيهما رق نقص الطلاق برقه والعدة بالمرأة ، يقول : إذا كانت الأمة تحت الحر طلاقها ثنتان ، وعدتها حيضتان ، وإن كانت حرة تحت عبد فطلاقها ثنتان ، وعدتها ثلاث حيض ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17119 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا أذن السيد لعبده أن يتزوج ، فإنه لا يجوز لامرأته طلاق إلا أن يطلقها العبد ، فإما أن يأخذ أمة غلامه أو أمة وليدته فلا جناح عليه ) . ( مالك ، عب ) . )(@)(@@)(@@)(@@) $ 17120 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لا تنتقل المبتوتة والمتوفى عنها من بيت زوجها حتى يحل أجلها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17121 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لا يصلح أن تبيت ليلة إذا كان عدة وفاة أو طلاق إلا في بيتها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17122 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لا تبيت المتوفى عنها 
ms7235	 بيتها ، ولا تطيب ، ولا تختضب ، ولا تكتحل ، ولا تمس طيبا ، ولا تلبس ثوبا مصبوغا إلا ثوب عصب تجلبب به ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17123 عن ابن عمر رضي الله عنهما(@)(@@) | 30 في الأمة تباع أو تعتق ؟ قال : ( تستبرأ بحيضة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17124 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا كانت الأءمة عذراء لم تستبرئها ) . ( عب ، وسنده صحيح ) . )(@)(@@) PageV20P351(@)(@@)(@@)(@@) $ 17125 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لعن الله المحلل والمحلل له ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17126 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن امرأة جاءت إلاى النبي فقالت : يا رسول الله سكنا دارا ونحن ذو وفر فاحتجنا وساءت ذات بيننا واختلفنا ، فقال : بيعوها أو ذروها وهي ذميمة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17127 عن محمد بن أبي قتلة :(@)(@@) | 30 ( أن رجلا كتب إلاى ابن عمر رضي الله عنهما يسأله عن العلم ؟ فكتب إليه ابن عمر : إنك كتبت تسألني عن العلم ؟ فالعلم أكبر من أن أكتب به إليك ، ولاكن إن استطعت أن تلقاى الله تعالاى : كاف اللسان عن أعراض المسلمين ، خفيف الظهر من دمائهم ، خميص البطن من أموالهم لازما لجماعتهم فافعل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17128 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( نهاى رسول الله عن بيع الولاء ، وعن هبته ) . ( هب ) . )(@)(@@)(@@)(@@) $ 17129 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رجلا أعتق شقصا له علاى مملوكه ، فضمنه النبي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17130 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه عرض علاى النبي يوم بدر فلم يقبله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17131 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( وقف رسول الله على القليب يوم بدر ، فقال : يا عتبة بن ربيعة ويا شيبة بن ربيعة ، ويا أبا جهل بن هشام يا فلان ، يا فلان قد وجدنا ما وعدنا ربنا حقا ، فهل وجدتم ما وعد ربكم حقا ؟ قالوا : أليسوا أمواتا ؟ قال : والذي نفسي بيده إنهم ليسمعون قولي الآن كما تسمعون ، ما أنتم بأسمع لما أقول منهم ) . ( ش ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 17132 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان طلحة صاحب 
ms7236	 راية PageV20P352 المشركين يوم بدر فقتله علي بن أبي طالب رضي الله عنه مبارزة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17133 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لما كان عام أحد ، ردني رسول الله في نفر ، منهم أوس بن عزابة ، وزيد بن ثابت ، ورافع بن خديج رضي الله عنه ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 17134 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال لي النبي : انطلق فقم علاى الطريق ، فلا يمر بك جريح إلا قلت : بسم الله ثم تفلت في جرحه وقلت : بسم الله شفاء الحي الحميد ، من كل حد وحديد ، وحجر تليد ، اللهم اشف ، إنه لا شافي إلا أنت فإنه لا يقيح ولا يدمي ) . ( الحسن بن سفيان وابن عساكر عن أبي كهيل الأزدي قال : أتاى رجل يوم أحد إلاى النبي فقال : إن الناس كثر فيهم الجراحات ، قال : فذكره ) . )(@)(@@)(@@)(@@) $ 17135 عن ابن عمر رضي الله عنهم :(@)(@@) | 30 ( أن النبي ناداى فيهم يوم انصرف عنهم الأحزاب ، ألا لا يصلين أحد العصر إلا في بني قريظة ، فأبطأ الناس ، فتخوفوا فوت وقت الصلاة فصلوا ، وقال آخرون : لا نصلي إلا حيث أمرنا رسول الله وإن فاتنا الوقت ، فما عنف رسول الله واحدا من الفريقين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17136 عن ابن عمر رضي الله عنهما ، عن رسول الله :(@)(@@) | 30 ( أنه دفع إلاى يهود خيبر نخل خيبر وأرضها علاى أن يعتملوها من أموالهم ، ولرسول الله شطرها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17137 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سمعت النبي وهو علاى درج الكعبة ، وهو يقول : الحمد لله الذي أنجز وعده ، ونصر عبده ، وهزم الأحزاب وحده ، ألا إن كل مأثرة كانت في الجاهلية ، فإنها تحت قدمي اليوم ، إلا ما كانت من سدانة البيت ، وسقاية الحاج ، ألا وإن ما بين العمد والخطإ ، القتل بالسوط PageV20P353 والحجر ، فيهما مائة بعير ، منها أربعون في بطونها أولادها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17138 عن ابن عمر رضي الله عنهما قال : $ 30 ( لما دخل رسول الله مكة ، جعل النساء يلطمن وجوه الخيل بالخمر ، فتبسم رسول الله إلاى أبي بكر رضي الله عنه فقال : كيف قال 
ms7237	 حسان ؟ فأنشده :(@)(@@) عدمنا خيلنا إن لم تردها %~% تثير النقع موعدها كداء(@)(@@) ينازعن الأعنة مصعدات %~% ويلطمهن بالخمر النساء(@)(@@) فقال رسول الله : ادخلوها من حيث قال حسان ، فدخل رسول الله من كداء ) . ( ابن جرير ) . ) $(@)(@@)(@@)(@@) $ 17139 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أمر النبي في غزوة مؤتة زيد بن حارثة وقال : إن قتل زيد فجعفر ، وإن قتل جعفر فعبد الله بن رواحة ، قال ابن عمر : وكنت معهم في تلك الغزوة ، فالتمسنا جعفرا رضي الله عنه فوجدنا فيما أقبل من جسمه بضعا وتسعين ، ما بين ضربة بسيف وطعنة برمح ورمية ) . ( طب ) . )(@)(@@)(@@)(@@) $ 17140 عن نافع قال :(@)(@@) | 30 ( قال ابن عمر رضي الله عنهما : أجرؤكم علاى جراثيم جهنم أجرؤكم علاى الحد ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17141 عن ميمون بن مهران :(@)(@@) | 30 ( أنه شهد ابن عمر رضي الله عنهما صلى علاى ولد زنا ، فقيل له : إن أبا هريرة رضي الله عنه لم يصل عليه وقال : هو شر الثلاثة ، فقال ابن عمر : هو خير الثلاثة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17142 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا رأيتم قريشا قد هدموا البيت ثم بنوه فزوقوه ، فإن استطعت أن تموت فمت ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17143 عن ابن عمر رضي الله عنهما وذكر الحرورية قال :(@)(@@) | 30 ( قال رسول الله : يمرقون من الإسلام كما يمرق السهم الرمية ) . ( ابن جرير ) . )(@)(@@) PageV20P354(@)(@@)(@@)(@@) $ 17144 عن نافع :(@)(@@) | 30 ( أن رجلا أتاى ابن عمر رضي الله عنهما فقال : يا ثبا عبد الرحمان ما الذي يحملك علاى أن تحج عاما وتعتمر عاما وتترك الجهاد في سبيل الله ، وقد علمت ما رغب الله فيه ؟ قال : يا ابن أخي بني الإسلام علاى خمسة : إيمان بالله ورسوله ، وصلاة الخمس ، وصيام شهر رمضان ، وأداء الزكاة ، وحج البيت ؛ فقال : يا أبا عبد الرحمان ألا تسمع ما ذكر الله في كتابه : { وإن طائفتان من المؤمنين اقتتلوا فأصلحوا بينهما فإن بغت إحداهما علاى الأخراى فقاتلوا التي تبغي حتى تفيء إلاى أمر الله } ، فما يمنعك أن تقاتل الفئة الباغية كما أمرك الله تعالاى في كتابه ؟ فقال : يا ابن أخي لأن 
ms7238	 أعتبر بهاذه الآية فلا أقاتل أحب إلي من أن أعتبر بالآية التي يقول الله فيها : { ومن يقتل مؤمنا متعمدا فجزاؤه جهنم خالدا فيها } ، فقال : ألا تراى أن الله يقول : { وقاتلوهم حتى لا تكون فتنة ويكون الدين كله لله } ، قال ابن عمر رضي الله عنهما : قد فعلنا ذالك علاى عهد رسول الله إذ كان أهل الإسلام قليلا ، وكان الرجل يفتن في دينه ، إما أن يقتلوه ، وإما أن يسترقوه ، حتى كثر أهل الإسلام فلم تكن فتنة ، قال : فما قولك في علي وعثمان ؟ قال : أما عثمان رضي الله عنه فكان الله قد عفا عنه وكرهتم أن تعفوا ، وأما علي رضي الله عنه فابن عم رسول الله وختنه ، وأشار بيده وهاذه ابنته حيث ترون ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17145 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ولد النبي مسرورا مختونا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17146 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( هجرت الرواح إلاى رسول PageV20P355 الله ، فجاء أبو الحسن ، فقال له رسول الله : ادن فلم يزل يدنيه حتى التقم أذنيه ، فبينما النبي يساره ، إذ رفع رأسه كالفزع ، قال : فدع بسيفه الباب ، فقال لعلي رضي الله عنه : اذهب فقده كما تقاد الشاة إلاى حالبها ، فإذا علي يدخل الحكم بن أبي العاص آخذا بأذنه ولها زنمة حتى أوقفه بين يدي النبي ، فلعنه نبي الله ثلاثا ، ثم قال : أحله ناحية حتى راح إليه قوم من المهاجرين والأنصار ، ثم دعا به فلعنه ، ثم قال : إن هاذا سيخالف كتاب الله وسنة نبيه ، وسيخرج من صلبه فتن يبلغ دخانها السماء فقال ناس من القوم : هو أقل وأذل من أن يكون هاذا منه ، قال : بلاى ، وبعضكم يومئذ شيعته ) . ( قط في الأفراد ، كر ، قال قط : تفرد به حسن بن قيس ، عن عطاء ، عن ابن عمر ) . )(@)(@@)(@@)(@@) $ 17147 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( بينا النبي جالس ، وعنده أبو بكر الصديق رضي الله عنه عليه عباءة قد خلها علاى صدره بخلال ، إذ نزل عليه جبريل فأقرأه من الله السلام وقال له : يا رسول 
ms7239	 الله ما لي أراى أبا بكر عليه عباءة قد خلها علاى صدره بخلال ؟ فقال : يا جبريل أنفق ماله علي قبل الفتح ، قال : فأقرئه من الله السلام ، وقل له : يقول لك ربك : أراض أنت عني في فقرك أم ساخط ؟ فبكاى أبو بكر وقال : علاى ربي أغضب أنا عن ربي راض أنا عن ربي راض ) . ( أبو نعيم في فضل الصحابة ) . )(@)(@@)(@@)(@@) $ 17148 عن حبيب بن أبي ثابت ، عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سئل رسول الله : من أحب الناس إليك ؟ قال : عائشة ، قيل : إنما نعني من الرجال ، قال : أبوها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17149 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 كبر عمر ، فسمع رسول الله PageV20P356 تكبيره ، فأطلع رأسه مغضبا ، فقال : أينابن أبي قحافة ؟ ) . ( الواقدي ، كر ) . )(@)(@@)(@@)(@@) $ 17150 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( اجتمعت قريش فقالوا : من يدخل علاى هاذا الصابىء فيرده عما هو عليه فيقتله ؟ فقال عمر بن الخطاب : أنا فأتاي العين رسول الله ، فقال : يا رسول الله إن عمر بن الخطاب يأتيك ، فكن منه علاى حذر فلما أن صلى رسول الله صلاة المغرب ، قرع عر الباب ، وقال : افتحي يا خديجة فلما أن دنت ، قالت : من هاذا ؟ قال : عمر : قالت : يا نبيي الله هاذا عمر ، فقال من عنده من المهاجرين وهم تسعة صيام وخديجة عاشرتهم : ألا نشتفي يا رسول الله فنضرب عنقه ؟ قال : لا ، ثم قال : اللهم أعز الدين بعمر بن الخطاب فلما دخل قال : ما تقول يا محمد قال : أقول أن تشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، وتؤمن بالجنة والنار والبعث بعد الموت ، فبايعه وقبل الإسلام ، وصبوا عليه من الماء حتى اغتسل ثم تعشى مع رسول الله ، وبات يصلى معه ، فلما أصبح اشتمل علاى سيفه ، ورسول الله يتلوه ، والمهاجرون خلفه ، حتى وقف علاى قريش وقد اجتمعوا ، فقال : أشهد أن لا إلاه إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله ، فمن شاء فليؤمن ، ومن شاء فليكفر ؛ فتفرقت 
ms7240	 حينئذ قريش عن مجالسها ) . ( كر ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 17151 عن ابن عمر رضي الله عنهما ، عن النبي :(@)(@@) | 30 ( أنه دخل المسجد بين أبي بكر وعمر رضي الله عنهما ، وقال : هاكذا ندخل الجنة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17152 عن ميمون بن مهران ، عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله أراد أن يرسل رجلا في حاجة مهمة ، وأبو بكر وعمر رضي الله عنهما عن يمينه وعن يساره ، فقال علي رضي الله عنه : ألا تبعث أحد هاذين ؟ قال : وكيف أبعث هاذين ، وهما من هاذا الدين بمنزلة السمع والبصر من الرأس ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17153 عن نافع قال :(@)(@@) | 30 ( قيل لعبد الله بن عمر رضي الله عنهما : إنك قد أحسنت الثناء علاى عبد الله بن مسعود رضي الله عنه ، فقال : وما يمنعني من ذالك ؟ PageV20P357 سمعت رسول الله يقول : خذوا القرآن من أربعة : من عبد الله بن مسعود ، وسالم مولاى أبي حذيفة ، ومن أبي بن كعب ، ومن معاذ بن جبل ، قال : ثم قال رسول الله : لقد هممت أن أبعثهم في الأمم كما بعث عيساى بن مريم عليه السلام الحواريين ، قالوا : يا رسول الله أفلا تبعث أبا بكر وعمر رضي الله عنهما فهما أعلم وأفضل ؟ فقال : إني لا غنى بي عنهما ، إنهما منى بمنزلة السمع والبصر ، وبمنزلة العينين من الرأس ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17154 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( آخى رسول الله بين أبي بكر وعمر رضي الله عنهما ، فبينما هو قاعد إذ طلع كل واحد مهما آخذ بيد صاحبه ، فقال رسول الله : هاذان سيدا كهول أهل الجنة من الاولين والآخرين إلا النبيين والمرسلين ؛ لا تخبرهما يا علي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17155 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( يؤتاى بأقوام يوم القيامة ، فيوقفون بين يدي الله تعالاى فيأمر بهم إلاى النار ، فإذا هم الزبانية تأخذهم وقربوا من النار ، وهم مالك أن يأخذهم قال الله تعالاى لملائكة الرحمة : ردوهم فيردونهم ، فيقفون بين يدي الله تعالاى طويلا ، فيقول : عبادي أمرت بكم إلاى النار بذنوب سلفت لكم واستوجبتم بها وقد 