ms466	 کزین پس %~% یک ماه خویشتن را بی‌برگ و ساز داری(@)(@@) 3 آخر چه سود کشتن تن را به زور چون تو %~% شامش رضا بجویی صبحش نیاز داری(@)(@@) 4 آنست سر روزه: کز هر بدی ببندی %~% گوشی که برگشودی چشمی که باز داری(@)(@@) 5 در آسمان معنی چون مهر برفروزی %~% گر دست برد صورت یک ماه باز داری(@)(@@) 6 از آستان صورت تا پیشگاه معنی %~% بیش از هزار منزل شیب و فراز داری(@)(@@) 7 دل را چو چار گوشه بر باغ و خانه کردی %~% چون در حضور بندی کی در نماز داری(@)(@@) 8 خود کی درست خیزی از زیر سکه دل %~% کز بهر یک قراضه دندان چو گاز داری(@)(@@) 9 نفسی که می‌تواند با عرشیان نشستن %~% حیف آیدم که : او را در بند آز داری(@)(@@) 10 کوتاه عمر باشد آن را که نیست نامی %~% گر نام نیک ورزی عمر دراز داری(@)(@@) 11 بی‌منتی برآور کار نیازمندان %~% گر زانکه هیچ کاری با بی‌نیاز داری(@)(@@) 12 چون اوحدی نگردی بی‌صدق یار هرگز %~% زیرا که یار بودن صدقست و رازداری PageV1P0924(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هرگز به جان فرا نرسی بی‌فروتنی %~% خواهی که او شوی تو جدا گرد از منی(@)(@@) 2 زنهار ! قصد کندن بیخ کسان مکن %~% زیرا که بیخ خویشتنست آنکه می‌کنی(@)(@@) 3 نیکی کن ای پسر تو که نیکی به روزگار %~% سوی تو بازگردد اگر در چه افگنی(@)(@@) 4 دل در جهان مبند که بی‌جرعه‌های زهر %~% کس شربتی نمی‌خورد از دست او هنی(@)(@@) 5 امروز کار کن که جوانی و زورمند %~% فردا کجا توان که شوی پیر و منحنی(@)(@@) 6 تا کی من و جمال من و ملک و مال من %~% چندین هزار من که شد از قطره‌ای منی(@)(@@) 7 سر برفراشتی که : به زور تهمتنم %~% ای زیردست آز چه سود از تهمتنی(@)(@@) 8 جز با دل شکسته ترا کار زار نیست %~% خود را نگاه دار که بر قلب می‌زنی(@)(@@) 9 کردی کلاه کژ 
ms467	 که : کمر بسته‌ام به سیم %~% ای سنگدل چه سیم که دربند آهنی(@)(@@) 10 گر نیک بنگریهمه زندان روح تست %~% چون کرم پیله بر تن خود هرچه می‌تنی(@)(@@) 11 گر مرهم تو بر دل مردم بمنتست %~% بردار مرهمت که نمک می‌پراگنی(@)(@@) 12 مشکل بزاید از تو بسی خیر از آنکه تو %~% چون مادر زمانه ز نیکی سترونی(@)(@@) 13 از پند گفتن تو چه فرقست تا به نیش %~% از بهر آنکه تیز ترا ز فرق سوزنی(@)(@@) 14 تا برزنی به کیسه بازاریان یکی %~% روز دراز بر سر بازار و برزنی(@)(@@) 15 از بهر لقمه‌ای که نهندت به کام در %~% دیدم که : زخم‌دارتر از قعر هارونی(@)(@@) 16 دانی حساب گندم خود جوبه جو ولی %~% «الحمد» را درست ندانی ز کودنی(@)(@@) 17 نادان بجز حکایت دنیا نمی‌کند %~% ناچار خود حکایت دنیا کند دنی(@)(@@) 18 ای اوحدی کسی بجزو نیست در جهان %~% درویش باش تا غم کارت خورد غنی PageV1P0925(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر بدینصورت که هستی صرف خواهد شد جوانی %~% راستی بر باد خواهی داد نقد زندگانی(@)(@@) 2 کی بری ره سوی معنی چون تو از کوتاه چشمی %~% صورتی را هرکجا بینی درو حیران بمانی(@)(@@) 3 راه دشوارست و منزل دور و دزدان در کمین‌گه %~% گوش کن: تا درنبازی مایه بازارگانی(@)(@@) 4 واعظت گولست و میدانم که: از ره دور گردی %~% رهبرت غولست و میدانم که: در وادی بمانی(@)(@@) 5 کرده‌ای با خود حساب آنکه: چون مالم فزون شد %~% در مراد دل بمانم شاد و آخر هم نمانی(@)(@@) 6 این رباطی در ره سیلست و ما در وی مسافر %~% برگذار سیلها منزل مساز ای کاروانی(@)(@@) 7 هرکه در دنیا به رنج آمد ز بهر راحت تن %~% زندگانی می‌دهد بر باد بهر زندگانی(@)(@@) 8 جاودان کس را نشان باقی نخواهد ماند هرگز %~% جهد آن کن تا: مگر نامت بماند جاودانی(@)(@@) 9 لذت حلوای ایمان کی فرو آید به حلقت %~% چون ترا دراعه شش تویست و پیراهن 
ms468	 دوگانی(@)(@@) 10 دیگران را چون به راه آری که خود را یاوه کردی %~% هرکه را شب خواب میگیرد چه داند پاسبانی(@)(@@) 11 یا مراد خویش باید جست یا کام رفیقان %~% کار خود یکسو نه ار دربند کار دیگرانی(@)(@@) 12 سالها بوسیده‌اند از صدق خاک آستانها %~% آن کشان امروز می‌بینم که خاک آستانی(@)(@@) 13 مرد را گفت و قدم باید تو خود یکباره گفتی %~% خلق را در سر زبان باید تو خود یکسر زبانی(@)(@@) 14 صوت و حرف از بهر آن آموختی تا قول گویی %~% بحر و وزن از بهر آن انگیختی تا شعر خوانی(@)(@@) 15 بی‌زر اندر خانه ننشانی شبی کس را و عمری %~% هست تا در ملک ایزد می‌نشینی رایگانی(@)(@@) 16 نام خود عاشق نهادی چیست این افسردگیها %~% عاشقان را سینه آتش‌خانه باید دیده‌خانی(@)(@@) 17 پهلوانی نیست قلب دوستان بر هم شکستن %~% به که قلب دشمنان هم بشکنی گر پهلوانی(@)(@@) 18 زیر دستان را مهل کز ظالمی اندیشه باشد %~% گله را از گرگ صحرایی نگهدار ار شبانی(@)(@@) 19 مال مار تست و تو روز و شب اندر جمع آری %~% یار بار تست و تو سال و مه اندر بند آنی(@)(@@) 20 زر فریبنده استخواهی مغربی خواهی یمینی %~% برق سوزنده است خواهی مشرقی خواهی یمانی(@)(@@) 21 گر ز قهر ایزدت خوفست چون دست تو باشد %~% جهد کن تا : بر تو شهوت را نباشد قهرمانی(@)(@@) 22 از رفیقان گفتن و از نیکبختان کار بستن %~% آنچه دانستم بگفتم با تو آن دیگر تو دانی(@)(@@) 23 سوختم در آتش فکرت روان خویش عمری %~% تا تو میگویی که : شعرش همچو آبست از روانی(@)(@@) 24 کردگارا روز عمر خویشتن بر باد دادم %~% گاه احسانست و وقت لطف و روز مهربانی(@)(@@) 25 در دو عالم نیست مقصودی مرا جز دیدن تو %~% شاید ار امیدواری را به امیدی رسانی(@)(@@) 26 گر نکوکاران رخ چون ارغوان آرند پیشت %~% من نمی‌آرم بغیر از اشکهای ارغوانی(@)(@@) 27 شورش بسیار کردم 
ms469	 زانکه وقت عرض نامه %~% بر تو آمرزیدن بسیار می‌بردم گمانی(@)(@@) 28 آب دریای معاصی تا رکابم بود دایم %~% چون ز بی‌آبی همی با باد کردم هم عنانی(@)(@@) 29 گرچه جان در پای یاران کرده‌ام از راه صورت %~% کس نکرد آهنگ جانم غیر از آن یاران جانی(@)(@@) 30 آتش دوزخ به آب چشم من کمتر نشیند %~% کز چنین آبی نیاید قوت آتش‌نشانی(@)(@@) 31 ناتوان افتاده‌ایم از اصل خلقت هم تو ما را %~% دستگیری کن به لطف خویشتن چون میتوانی(@)(@@) 32 گر برانی بندگانیم ار بخوانی پادشاهی %~% حکم حکم تست و ما راضی به هر حکمی که رانی(@)(@@) 33 یارب اندر حال پیری دست گیرم سوی رحمت %~% کز جوانی کردم این آشفتگی آه از جوانی!(@)(@@) 34 ای مسافر چون به ملک و منزل خود بازگردی %~% گفتهای اوحدی می‌بر ز بهر ارمغانی PageV1P0926(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 جهان به دست تو دادند تا ثواب کنی %~% خطا ز سر بنهی روی در صواب کنی(@)(@@) 2 فلک چو نامه فرستد ز مشکلی به جهان %~% به فکر خویشتن آن نامه را جواب کنی(@)(@@) 3 شود به عهد تو بسیار فتنه‌ها بیدار %~% چو عشق بازی و سیکی خوری و خواب کنی(@)(@@) 4 مهل خراب جهان را به دست ظلم که زود %~% تو هم خراب شوی گر جهان خراب کنی(@)(@@) 5 چو دور دولت تست ای امیر ملک بکوش %~% که نام نیک درین دولت اکتساب کنی(@)(@@) 6 بدانکه: نام شبانی نیاید از تو درست %~% که گله را همه در عهده ذئاب کنی(@)(@@) 7 شود چو قصه عود و رباب قصه تو %~% چو دل بدعد دهی گوش بر رباب کنی(@)(@@) 8 به قتل دشمن خود گر شتاب نیست ترا %~% یقین شناس که: بر قتل خود شتاب کنی(@)(@@) 9 روا مدار که: از بهر پهلوی بریان %~% هزار سینه به سیخ جفا کباب کنی(@)(@@) 10 قراضهای زر بیوگان مسکینست %~% قلادها که تو در گردن کلاب کنی(@)(@@) 11 میان دوزخ و خلق تو بس 
ms470	 تفاوت چیست %~% چو خلق را همه از خلق خود عذاب کنی(@)(@@) 12 ترا از آنچه که چون گل در آتشست کسی %~% که جای خویشتن اندر گل و گلاب کنی(@)(@@) 13 نگاه کن: که گر اینها که میکنی با خلق %~% کنند با تو زمانی چه اضطراب کنی(@)(@@) 14 به جانب تو نهان بس خطابهاست ز غیب %~% ولی تو گوش نداری که بر خطاب کنی(@)(@@) 15 چو پیر گشتی و پیری رسول رفتن تست %~% چه اعتماد بر این خیمه و طناب کنی(@)(@@) 16 به پیش آب جهان خانه‌ایست بی‌بنیاد %~% نه محکمست عمارت که پیش آب کنی(@)(@@) 17 ز سر جوان نتوانی شد ار چه در پیری %~% ز مشک سوده سر خویش را خضاب کنی(@)(@@) 18 به قول اوحدی ار ذره‌ای برآری سر %~% ز روشنی رخ خود را چو آفتاب کنی PageV1P0927(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 اگر حقایق معنی به گوش جان شنوی %~% حدیث بی‌لب و گفتار بی‌زبان شنوی(@)(@@) 2 دلت جگر بگرفتست ورنه راز سپهر %~% ز ذره ذره گیتی زمان زمان شنوی(@)(@@) 3 ز ناقلان زمین پند گوش کن باری %~% چو آن حضور نداری کز آسمان شنوی(@)(@@) 4 چو پای بسته این قبه گشته‌ای ناچار %~% درو هر آنچه بگویی سخن همان شنوی(@)(@@) 5 به اعتقاد تو بر فعل جز یقینی نیست %~% گرت به فعل بگویم به صد زبان شنوی(@)(@@) 6 حدیث با تو به اندازه تو باید گفت %~% که گر بلند کنم اندکی گران شنوی(@)(@@) 7 بو اعظان نکنی گوش غیر آن ساعت %~% که نام جنت و حلوای رایگان شنوی(@)(@@) 8 به بوی سود کنی ترک خانه ور نی تو %~% سفر کجا کنی ار قصه زیان شنوی(@)(@@) 9 حدیث پیر ریایی ز عارفی بررس %~% که آنچنانکه فراخور بود چنان شنوی(@)(@@) 10 اگر طریق هدایت روی تو شرط آنست %~% که هر حدیث که خواهی ز اهل آن شنوی(@)(@@) 11 و گر نه نان به بهای کلیچه باید خورد %~% چو وصف آن تو هم از صاحب 
