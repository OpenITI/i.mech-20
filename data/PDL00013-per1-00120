ms114	 نباشد اگر گونه جگر دارد(@)(@@) 6 از آنکه همچو حجر دارد آن نگارین دل %~% دلم پر آتش همچون دل حجر دارد(@)(@@) 7 به سرو ماند از آن باغ و بوستان طلبد %~% به ماه ماند از آن نهمت سفر دارد(@)(@@) 8 به غمزه گر بکشد از لبانش زنده کند %~% که غمزه و لب شیرین او گذر دارد(@)(@@) 9 بود چو نوشم اگر پاسخ چو زهر دهد %~% از آنکه بر لب شیرین او گذر دارد(@)(@@) 10 بتر بنالم هر شب همی و هر روزی %~% نکوتر است و مرا هر زمان بتر دارد(@)(@@) 11 عجب که سطری مهر و وفا نداند خواند %~% هزار نامه جنگ و جفا زبر دارد(@)(@@) 12 مرا دو دیده چو جویست و آن دو جویم را %~% خیال قدش پر سرو غاتفر دارد(@)(@@) 13 به چشم اندر گویی خیال او ملکی است %~% کز آب دیده من لشکر و حشر دارد(@)(@@) 14 اگر نه ترسان می باشد از طلیعه هجر %~% چرا حشر به شب تیره بیشتر دارد(@)(@@) 15 بتا نگارا بر هجر دستیار مباش %~% از آنکه هجر سر شور و رای شر دارد(@)(@@) 16 نکرد یارد هجر تو بر تنم بیداد %~% که یاد کرد شهنشاه دادگر دارد(@)(@@) 17 امیر غازی محمود سیف دولت کو %~% شجاعت علی و سیرت عمر دارد(@)(@@) 18 خجسته دولت او را یکی درخت شناس %~% که عدل شاخ و هنر برگ وجود بر دارد(@)(@@) 19 قضا ز رویش همواره پیشرو گیرد %~% قدر ز رایش پیوسته راهبر دارد(@)(@@) 20 ز رای اوست نفاذی که در قضا باشد %~% ز وهم اوست مضائی که این قدر دارد(@)(@@) 21 خدایگانا آنی که ملک و عدل و سخا %~% ز رای و طبع و کفت زین و زیب و فر دارد(@)(@@) 22 ز عدل تست که نرگس به تیره شب در دشت %~% نهاده بر سر پیوسته طشت زر دارد(@)(@@) 23 تو را طبیعت جود است به ز جود بسی %~% که جود نام در آفاق 
ms115	 مشتهر دارد(@)(@@) 24 اگر چه بحر به نعمت ز ابر هست فزون %~% کمینه چیز صدفها پر درر دارد(@)(@@) 25 بسی بلندتر آمد ز بحر رقت ابر %~% که بحر ندهد و او بدهد آنچه بر دارد(@)(@@) 26 چو آن خمیده کمان از گوزن دارد شاخ %~% چو آن خدنگ نزار از عقاب پر دارد(@)(@@) 27 همی عقاب و گوزن از نهیب تیر و کمانت %~% به کوه و بیشه در آرام و مستقر دارد(@)(@@) 28 عدوت بر سر خویش از حسامت ایمن نیست %~% از آن دو دست همی بر میان سر دارد(@)(@@) 29 نه سمع دارد در رزم دشمنت نه بصر %~% نه وقت تاختن از عزم تو خبر دارد(@)(@@) 30 از آنکه آتش تیغ و صهیل مرکب تو %~% دو چشم حاسد کور و دو گوش کر دارد(@)(@@) 31 بساز رزم عدو را که از برای تو را %~% قضا گرفته به کف نامه ظفر دارد(@)(@@) 32 شها ملوک جهان طاقت تو کی دارند %~% شغال ماده کجا زور شیر نر دارد(@)(@@) 33 نه هر که شاهش خوانند شاهی آید ازو %~% نه هر که ابر بود در هوا مطر دارد(@)(@@) 34 نه دست سرو چو هر دست کارگر باشد %~% نه چشم عبهر چون چشم ها بصر دارد(@)(@@) 35 نه هر که بست کمر راه سروری ورزد %~% نه هر که داشت زره نهمت خطر دارد(@)(@@) 36 نه آب همچو دلیران همی زره پوشد %~% نه کلک همچون نام آوران کمر دارد(@)(@@) 37 همیشه تا به زمین بر نسیم راه دهد %~% همیشه تا به فلک بر قمر ممر دارد(@)(@@) 38 ز بخت و دولت در لهو و در طرب بادی %~% که هر ولی را جود تو در بطر دارد PageV1P080(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 امیر غازی محمود رای میدان کرد %~% نشاط مرکب میمون و گوی و چوگان کرد(@)(@@) 2 زمین میدان بر اوج چرخ فخر آورد %~% چو شاه گیتی رای نشاط میدان کرد(@)(@@) 3 فلک ز ترس فراموش کرد دوران را 
ms116	 %~% چو اسب شاه در آوردگاه دوران کرد(@)(@@) 4 ز بیم آنکه رسد گوی شاه بر خورشید %~% به گرد تاری خورشید روی پنهان کرد(@)(@@) 5 چو دید گردون دوران شاه در میدان %~% همی نیارد آن روز هیچ دوران کرد(@)(@@) 6 چو هاله گاه شهنشاه اوج گردون بود %~% گذار گوی ز چوگان بر اوج کیوان کرد(@)(@@) 7 به سم مرکب روی سپهر تاری کرد %~% به زخم چوگان چشم ستاره حیران کرد(@)(@@) 8 چو دید چوگان مر شاه را چو غران شیر %~% به دستش اندر خود را چو مار پیچان کرد(@)(@@) 9 چو دید شاه چو پیچنده مار چوگان را %~% نشاط و رامش و شادی هزار چندان کرد(@)(@@) 10 اگر نه مرکب میمونش هست بادبزان %~% چرا به رفتن با باد عهد و پیمان کرد(@)(@@) 11 مگر نگین سلیمان به دست خسرو ماست %~% که چون سلیمان مرباد را به فرمان کرد(@)(@@) 12 چرا سلیمان خود نام مهر سیفی داشت %~% که باد چونان فرمانبری سلیمان کرد(@)(@@) 13 بسا کها که بر آن کوه شاه چوگان زد %~% به سم مرکب که پیکرش بیابان کرد(@)(@@) 14 بسا شها که به گشت او ز دوستی ملک %~% بسا امیر که با رأی شاه عصیان کرد(@)(@@) 15 به تیر شاه مر این را چو تیر بی پر کرد %~% به تیغ باز مر آن را چو تیغ بی جان کرد(@)(@@) 16 عجب مدار که محمود سیف دولت و دین %~% به بخت و دولت عالی چنین فراوان کرد(@)(@@) 17 در آنچه جست همه خشندی سلطان جست %~% هر آنچه کرد ز بهر رضای یزدان کرد(@)(@@) 18 ایا شهی که جهان را کف تو داد نسق %~% چنانکه رای تو مر ملک را به سامان کرد(@)(@@) 19 هر آن کسی که همی کینه جست با تو به دل %~% نه دیر زود که بخت بدش پشیمان کرد(@)(@@) 20 تو آن جوادی شاها که آز گیتی را %~% سخاوت تو بدست فنا گروگان کرد(@)(@@) 21 همیشه جایگهت بوستان 
ms117	 دولت باد %~% که دولت تو جهان را بسان بستان کرد PageV1P081(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ز بار نامه دولت بزرگی آمد سود %~% بدین بشارت فرخنده شاد باید بود(@)(@@) 2 نمونه ای ز جلالت به دهر پیدا شد %~% ستاره ای ز سعادت به خلق روی نمود(@)(@@) 3 به باغ دولت و اقبال شاخ شادی رست %~% که مملکت را زو بار و سایه بینی زود(@)(@@) 4 همی به رمز چه گویم صریح خواهم گفت %~% جهان ملک ملکی در جهان ملک افزود(@)(@@) 5 بر این سعادت لوهور خلعتی پوشید %~% ز کامرانی تا روز شادمانی بود(@)(@@) 6 ز بس نشاط که در طبع مردمان آویخت %~% بدین دو هفته به شبها یک آدمی نغنود(@)(@@) 7 به دوستکامی این باده ای بدان آورد %~% به شادمانی آن دسته ای ازین بربود(@)(@@) 8 نشست شاه به سور و همیشه سورش باد %~% بر مراد دل از کشته عزیز درود(@)(@@) 9 شد مصاف شکن شیرزاد شیر شکر %~% که جان کفر به پولاد هندوی پالود(@)(@@) 10 گهی به مرکب پوینده قعر بحر شکافت %~% گهی به رایت بر رفته اوج چرخ بسود(@)(@@) 11 به هر زمین که درآمد چو آب لشکر او %~% ز تاب آتش شمشیر او برآمد دود(@)(@@) 12 نمود خون عدو بر کشیده خنجر او %~% به گونه شفق سرخ بر سپهر کبود(@)(@@) 13 عریض جاهش پهنای هر دیار گرفت %~% بلند قدرش بالای هر فلک پیمود(@)(@@) 14 بدین نهاد که شوید همی جهان از کفر %~% نماند خواهد بومی ز هند کفرآلود(@)(@@) 15 چو شد سخاوت او بر زمانه مستولی %~% نیاز کرد جهان را به درد دل بدرود(@)(@@) 16 چو بر خزانه نبخشود و مالها بخشید %~% نماند کس که بر آن کس ببایدش بخشود(@)(@@) 17 بزرگ بارخدایا تو آن شهی که جهان %~% جز آن نکرد که شاهانه همتت فرمود(@)(@@) 18 فلک شناس نداند به راستیت شناخت %~% ملک ستای نداند به واجبیت ستود(@)(@@) 19 نه چشم گردون چون کرده تو صورت دید %~% نه گوش گیتی 
