ms1221	 جاع أن يأكل الميتة، وإذا عطش أن يشرب الخمر "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1408(@)(@@)(@@)(@@) | 8023 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله، ثنا ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، قول الله: " {غير باغ} [الأنعام: 145] ، يعني غير مستحله " وروي عن مقاتل بن حيان نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1408(@)(@@)(@@)(@@) | 8024 - (@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي: " {فمن اضطر غير باغ ولا عاد} [البقرة: 173] ، أما {باغ} [الأنعام: 145] فيبغي فيه شهوته "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8025 - (@)(@@) حدثنا عصام بن رواد، ثنا آدم، ثنا ضمرة، عن عثمان بن عطاء، عن أبيه: قوله: " {فمن اضطر غير باغ} [الأنعام: 145] ، قال: لا يشوي من الميتة ليشتهيه، ولا يأكل إلا المعلقة، ويحمل معه ما يبلغه الحلال، فإذا بلغه ألقاه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولا عاد} (@)(@@) [البقرة: 173](@)(@@) PageV05P1409(@)(@@)(@@)(@@) | 8026 - (@)(@@) ذكر عن محمد بن ربيعة، ثنا سلمة بن سابور، عن عطية، عن ابن عباس: قوله: " {فمن اضطر غير باغ ولا عاد} [البقرة: 173] ، قال: {غير باغ} [الأنعام: 145] في الميتة، {ولا عاد} [البقرة: 173] ، في أكله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1409(@)(@@)(@@)(@@) | 8027 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو خالد، عن الحجاج، عن القاسم، عن مجاهد: " {غير باغ ولا عاد} [البقرة: 173] ، قال: «العادي المخيف للسبيل» وروي عن سعيد بن جبير نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1409(@)(@@)(@@)(@@) | 8028 - (@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي: «أما العادي فيعتدي في أكله، يأكل حتى يشبع، ولكن منه قوته ما يمسك به نفسه حتى يبلغ حاجته»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8029 - (@)(@@) حدثنا أبو زرعة، ثنا الحسن بن عمرو بن عون الباهلي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، في قوله: " {فمن اضطر غير باغ ولا عاد} [البقرة: 173] ، في أكله، أن يتعدى الحلال إلى حرام وهو يجد عنه مندوحة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فإن ربك غفور رحيم} (@)(@@) [الأنعام: 145](@)(@@) PageV05P1409(@)(@@) قرأت على محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان: " {غفور رحيم} [البقرة: 173] ، فيما أكل في اضطرار، وبلغنا والله أعلم أنه لا يزيد على ثلاث لقم "(@)(@@) PageV05P1409(@)(@@)(@@)(@@) | 8031 - (@)(@@) حدثنا أبو زرعة، ثنا 
ms1222	 يحيى بن عبد الله، ثنا ابن لهيعة، حدثني عطاء، عن سعيد بن جبير: " {فإن ربك غفور} [الأنعام: 145] ، يعني لما أكل من الحرام {رحيم} [الأنعام: 145] ، يعني: رحيما به إذ أحل له الحرام في الاضطرار "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وعلى الذين هادوا} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1409(@)(@@)(@@)(@@) | 8032 - (@)(@@) حدثنا أبي، ثنا أحمد بن يونس، ثنا أبو عوانة، عن أبي بشر، عن مجاهد، قال: «تهودت اليهود يوم السبت»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {حرمنا كل ذي ظفر} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1410(@)(@@)(@@)(@@) | 8033 - (@)(@@) حدثنا أبو سعيد بن يحيى بن سعيد القطان، ثنا يحيى بن آدم، ثنا شريك، عن عطاء بن السائب، عن سعيد بن جبير، عن ابن عباس، قوله: " {وعلى الذين هادوا حرمنا كل ذي ظفر} [الأنعام: 146] ، قال: هو الذي ليس بمنفرد الأصابع، يعني ليس بمشقوق الأصابع، منها الإبل والنعام " وروي عن سعيد بن جبير، ومجاهد، وعكرمة، وقتادة، والضحاك، وعطاء الخراساني، ومقاتل بن حيان، وكذلك روي عن حنش الصنعاني وزاد فيه: والخنزير. وكذلك روي عن السدي، وقتادة وزاد فيه: والوز. وزاد سعيد بن جبير: والديك "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ومن البقر والغنم حرمنا عليهم شحومهما} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1410(@)(@@)(@@)(@@) | 8034 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي: قوله: " {ومن البقر والغنم حرمنا عليهم شحومهما} [الأنعام: 146] ، قال: حرمنا عليهم من الشحوم الثرب وشحم الكليتين، وكان اليهود يقولون: إنما حرمه إسرائيل، فنحن نحرمه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {إلا ما حملت ظهورهما} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1410(@)(@@)(@@)(@@) | 8035 - (@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس: قوله: " {إلا ما حملت ظهورهما} [الأنعام: 146] ، يعني ما علق بالظهر من الشحم " وروي عن الضحاك ومقاتل بن حيان نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1410(@)(@@)(@@)(@@) | 8036 - (@)(@@) حدثنا أبو سعيد الأشج، وأحمد بن سنان، قالا: ثنا أبو معاوية، عن ابن أبي خالد، عن أبي صالح: " {إلا ما حملت ظهورهما} [الأنعام: 146] ، قال: الألية " وروي عن السدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو الحوايا} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1410(@)(@@)(@@)(@@) | 8037 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة(@)(@@)(@@)(@@) | [ص: 1411](@)(@@) ، عن ابن 
ms1223	 عباس، قوله: " {أو الحوايا} [الأنعام: 146] هو المبعر " وروي عن سعيد بن جبير، وأبي صالح، ومجاهد، ومقاتل بن حيان، والسدي، وقتادة، وعطاء الخراساني نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1411(@)(@@)(@@)(@@) | 8038 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو أسامة، عن جويبر، عن الضحاك: " {أو الحوايا} [الأنعام: 146] ، قال: المباعر والمرابض "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8039 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ، ثنا ابن زيد، في قوله: " {أو الحوايا} [الأنعام: 146] ، قال: الحوايا المرابض التي تكون فيها الأمعاء، تكون وسطها، وهي بنات اللبن، وهي في كلام العرب تدعى المرابض "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1411(@)(@@)(@@)(@@) | 8040 - (@)(@@) أخبرنا أبو الأزهر أحمد بن الأزهر النيسابوري، فيما كتب إلي، ثنا وهب بن جرير، ثنا أبي، عن علي بن الحكم، عن الضحاك، أما قوله: " {أو الحوايا} [الأنعام: 146] فالبطون غير الثروب وروي عن مقاتل بن حيان مثل ذلك، وخالفه عبيد بن سلمان، عن الضحاك، فقال: يعني بالثروب: غير البطون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو ما اختلط بعظم} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1411(@)(@@)(@@)(@@) | 8041 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو معاوية، عن ابن أبي خالد، عن أبي صالح: " {أو ما اختلط بعظم} [الأنعام: 146] ، قال: الشحم " وروي عن السدي: نحو ذلك، وقال: ما كان من شحم على عظم. وروي عن مقاتل بن حيان نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8042 - (@)(@@) حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا أبو خالد، عن جويبر، عن الضحاك، " {أو ما اختلط بعظم} [الأنعام: 146] ، قال: ما ألزق بالعظم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ذلك جزيناهم} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1411(@)(@@)(@@)(@@) | 8043 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {ذلك جزيناهم ببغيهم} [الأنعام: 146] ، إنما حرم ذلك عليهم، عقوبة ببغيهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ببغيهم، وإنا لصادقون} (@)(@@) [الأنعام: 146](@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8044 - (@)(@@) قرأت على محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، في قوله: " {ذلك جزيناهم ببغيهم} [الأنعام: 146] ، يقول: باستحلالهم ما كان الله حرم عليهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فإن كذبوك} (@)(@@) [آل عمران: 184](@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8045 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {فإن كذبوك} 
ms1224	 [آل عمران: 184] ، قال: اليهود "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فقل ربكم ذو رحمة واسعة} [الأنعام: 147] الآية(@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8046 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قال: " كانت اليهود تقول: إنما حرمه إسرائيل، فنحن نحرمه. فذلك قوله: {فإن كذبوك فقل ربكم ذو رحمة واسعة ولا يرد بأسه عن القوم المجرمين} [الأنعام: 147] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {سيقول الذين أشركوا لو شاء الله ما أشركنا ولا آباؤنا} (@)(@@) [الأنعام: 148](@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8047 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس: " {لو شاء الله ما أشركنا} [الأنعام: 148] يقول الله تبارك وتعالى: لو شئت لجمعتكم على الهدى أجمعين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ولا حرمنا من شيء} (@)(@@) [الأنعام: 148](@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8048 - (@)(@@) حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {ولا حرمنا من شيء} [الأنعام: 148] ، قول قريش: {أن الله حرم هذا} [الأنعام: 150] : البحيرة، والسائبة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {كذلك كذب الذين من قبلهم} [الأنعام: 148] إلى آخر الآية(@)(@@) PageV05P1412(@)(@@)(@@)(@@) | 8049 - (@)(@@) حدثنا أبو عبد الله محمد بن حماد الطهراني، أنا عبد الرزاق، عن معمر، عن ابن طاوس، عن أبيه، أن رجلا قال لابن عباس: إن ناسا يقولون: ليس الشر بقدر. فقال(@)(@@)(@@)(@@) | [ص: 1413](@)(@@) ابن عباس: " فبيننا وبين أهل القدر هذه الآية: {سيقول الذين أشركوا لو شاء الله ما أشركنا ولا آباؤنا ولا حرمنا من شيء كذلك كذب الذين من قبلهم حتى ذاقوا بأسنا قل هل عندكم من علم فتخرجوه لنا؟ إن تتبعون إلا الظن وإن أنتم إلا تخرصون} إلى قوله: {فلو شاء لهداكم أجمعين} [الأنعام: 149] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {قل فلله الحجة البالغة} (@)(@@) [الأنعام: 149](@)(@@) PageV05P1413(@)(@@)(@@)(@@) | 8050 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الرحمن، ثنا عبد الله بن أبي جعفر، عن أبيه، عن الربيع، قال: «لا حجة لأحد عصى الله، ولكن لله الحجة البالغة على عباده»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فلو شاء لهداكم أجمعين} (@)(@@) [الأنعام: 149](@)(@@) PageV05P1413(@)(@@)(@@)(@@) | 8051 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس: قول الله تبارك وتعالى: «لو شئت لجمعتهم على 
ms1225	 الهدى أجمعين»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {قل هلم شهداءكم الذين يشهدون أن الله حرم هذا} (@)(@@) [الأنعام: 150](@)(@@) PageV05P1413(@)(@@)(@@)(@@) | 8052 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي، فيما كتب إلي، ثنا أحمد بن المفضل، ثنا أسباط، عن السدي: " {قل هلم شهداءكم} [الأنعام: 150] ، قال: أروني شهداءكم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {الذين يشهدون أن الله حرم هذا} (@)(@@) [الأنعام: 150](@)(@@) PageV05P1413(@)(@@)(@@)(@@) | 8053 - (@)(@@) حدثنا الحسين بن الحسن، ثنا إبراهيم بن عبد الله الهروي، أنا حجاج بن محمد، عن ابن جريج، عن مجاهد: " {الذين يشهدون أن الله، حرم هذا} [الأنعام: 150] : البحائر، والسيب "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8054 - (@)(@@) أخبرنا أحمد بن عثمان الأودي، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي: قوله: " {الذين يشهدون أن الله حرم هذا} [الأنعام: 150] فيما حرمت العرب، وقالوا: أمرنا الله به "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فإن شهدوا فلا تشهد معهم} (@)(@@) [الأنعام: 150](@)(@@) PageV05P1413(@)(@@)(@@)(@@) | 8055 - (@)(@@) وبه عن السدي، قال: " حرمت العرب، وقالوا: أمرنا الله به. قال الله لرسوله: {فإن شهدوا فلا تشهد معهم} [الأنعام: 150] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ولا تتبع أهواء الذين كذبوا بآياتنا} [الأنعام: 150] الآية قد تقدم تفسيره(@)(@@) PageV05P1414(@)(@@)(@@)(@@) | قوله تعالى: {قل تعالوا أتل ما حرم ربكم عليكم} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1414(@)(@@)(@@)(@@) | 8056 - (@)(@@) حدثنا الحسن بن عرفة العبدي، ثنا محمد بن فضيل، عن داود الأودي، عن عامر، عن علقمة، عن عبد الله، أنه قال: " من سره أن ينظر إلى وصية رسول الله صلى الله عليه وسلم التي عليها خاتمه، فليقرأ: {قل تعالوا أتل ما حرم ربكم عليكم} [الأنعام: 151] إلى قوله: {لعلكم تتقون} [الأنعام: 153] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8057 - (@)(@@) حدثنا أبو مقاتل بن محمد الرازي، ثنا وكيع، عن علي بن صالح، عن أبي إسحاق، عن عبد الله بن قيس، عن ابن عباس، قال: " هن الآيات المحكمات: {قل تعالوا أتل ما حرم ربكم عليكم} [الأنعام: 151] ثلاث آيات "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ألا تشركوا به شيئا} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1414(@)(@@)(@@)(@@) | 8058 - (@)(@@) حدثنا محمد بن عوف الحمصي، ثنا ابن أبي مريم، أنا نافع بن يزيد، حدثني سيار بن عبد الرحمن، عن يزيد بن قوذر، عن سلمة بن شريح، عن عبادة الصامت، قال: «أوصانا رسول الله صلى الله عليه وسلم بسبع خصال، ألا تشركوا بالله شيئا، وإن حرقتم وقطعتم وصلبتم» 
ms1226	(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وبالوالدين إحسانا} (@)(@@) [البقرة: 83](@)(@@) PageV05P1414(@)(@@) حدثنا أبو زرعة، ثنا صفوان، ثنا الوليد، أخبرنا بكير بن معروف، عن مقاتل بن حيان، في قول الله: " {وبالوالدين إحسانا} [البقرة: 83] ، قال: قولوا صدقا فيما أمركم به، وفيما أمركم به من حق الوالدين "(@)(@@) PageV05P1414(@)(@@)(@@)(@@) | قوله تعالى: {ولا تقتلوا أولادكم من إملاق، نحن نرزقكم وإياهم} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1414(@)(@@)(@@)(@@) | 8059 - (@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس: " {ولا تقتلوا أولادكم من إملاق} [الأنعام: 151] ، قال: الإملاق الفقر: قتلوا أولادهم خشية الفقر "(@)(@@) PageV00P000(@)(@@) أخبرنا موسى بن هارون الطوسي، فيما كتب إلي، ثنا الحسين بن محمد المروذي، ثنا شيبان بن عبد الرحمن، عن قتادة، قوله: " {ولا تقتلوا أولادكم من إملاق} [الأنعام: 151] ، قال: خشية الفاقة، وكان أهل الجاهلية يقتل أحدهم ابنته مخافة الفاقة عليها والسبي " وروي عن الضحاك، والسدي نحو ذلك(@)(@@) PageV05P1415(@)(@@)(@@)(@@) | قوله: {ولا تقربوا الفواحش} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1415(@)(@@)(@@)(@@) | 8061 - (@)(@@) حدثنا أبو زرعة الدمشقي، ثنا محمد بن بكار، ثنا سعيد بن بشير، عن قتادة، عن الحسن، عن عمران بن حصين، أن رسول الله صلى الله عليه وسلم قال: «أرأيتم الزاني والسارق وشارب الخمر، وما تقولون فيهم؟» ، قالوا: الله ورسوله أعلم. قال: «هن فواحش وفيهن عقوبة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8062 - (@)(@@) أخبرنا أبي، ثنا أبو طاهر، ثنا ابن وهب، ثنا ابن لهيعة، عن يزيد بن أبي حبيب، عن محمد بن عبيد، أن أبا حازم الرهاوي، حدثه أنه، سمع مولاه، يقول: كان رسول الله صلى الله عليه وسلم يقول: «مسألة الناس من الفواحش»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1415(@)(@@)(@@)(@@) | 8063 - (@)(@@) حدثنا أبي، ثنا محمد بن المصفى، ثنا محمد بن حرب، حدثني أبو سلمة يعني سليمان بن سليم، عن يحيى بن جابر، قال: «بلغني أن من الفواحش، التي نهى الله عنها في كتابه تزويج الرجل المرأة، فإذا نفضت له ولدها طلقها من غير ريبة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1415(@)(@@)(@@)(@@) | 8064 - (@)(@@) حدثنا العباس بن محمد الدوري، ثنا محمد بن بكار، ثنا أبو معشر، عن محمد بن قيس، في قول الله تعالى: " {ولا تقربوا الفواحش} [الأنعام: 151] ، قال: كانوا يمشون حول البيت عراة 
ms1227	 "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الرابع(@)(@@) PageV05P1415(@)(@@)(@@)(@@) | 8065 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني ابن لهيعة، عن عطاء بن دينار، عن سعيد بن جبير، في قوله: " {الفواحش} [الأنعام: 151] يعني: الزنا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله {ما ظهر منها} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8066 - (@)(@@) حدثنا أبي، ثنا أبو صالح كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {ولا تقربوا الفواحش ما ظهر منها وما بطن} [الأنعام: 151] ، قال: «كانوا في الجاهلية لا يرون بالزنا بأسا في السر، ويستقبحونه في العلانية، فحرم الله الزنا في السر والعلانية» وروي عن عطاء، عن عكرمة، وأبي صالح، وعلي بن حسين، وقتادة، والربيع بن أنس، والسدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8067 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو بكر بن أبي شيبة، ثنا محمد بن الحسن، ثنا إبراهيم بن طهمان، عن عطاء بن السائب، عن سعيد بن جبير، عن ابن عباس: " {الفواحش ما ظهر منها} [الأنعام: 151] ، قال: نكاح الأمهات والبنات " وروي عن سعيد بن جبير نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8068 - (@)(@@) حدثنا أبي، ثنا أبو غسان، ثنا قيس، عن خصيف، عن مجاهد: " أما {ما ظهر منها} [الأنعام: 151] ، فقوله: {ولا تنكحوا ما نكح آباؤكم} [النساء: 22] ، وقوله: {وأن تجمعوا بين الأختين} [النساء: 23] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الرابع(@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8069 - (@)(@@) ذكر عن روح بن عبادة، ثنا عثمان بن غياث، عن عكرمة: " {ما ظهر منها} [الأنعام: 151] : الظلم ظلم الناس "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الخامس(@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8070 - (@)(@@) حدثنا أبي، ثنا عمرو بن رافع، ثنا ابن المبارك، عن يونس، عن الزهري، في قوله: " {الفواحش ما ظهر منها} [الأنعام: 151] ، قال: العري، وكانوا يطوفون بالبيت عراة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وما بطن} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1416(@)(@@)(@@)(@@) | 8071 - (@)(@@) حدثنا أبي، ثنا إبراهيم بن موسى، أنا هشام بن يوسف، عن ابن جريج، حدثني عطاء، عن ابن عباس: " {الفواحش ما ظهر منها وما بطن} [الأنعام: 151] ، قال: ما بطن السر " وروي عن عكرمة، وقتادة، وعطاء الخرساني، والربيع بن أنس، والسدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8072 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو بكر بن أبي شيبة، ثنا محمد بن الحسن، ثنا إبراهيم بن طهمان، عن 
ms1228	 عطاء بن السائب، عن سعيد بن جبير، عن ابن عباس: " {الفواحش ما ظهر منها وما بطن} [الأنعام: 151] ، قال: ما بطن الزنا " وروي عن الزهري، ومجاهد، ومحمد بن قيس نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8073 - (@)(@@) حدثنا أبي، حدثني محمد بن سعيد بن الأصبهاني، عن عمرو بن ثابت، عن أبيه، عن علي بن حسين: " {ولا تقربوا الفواحش ما ظهر منها وما بطن} [الأنعام: 151] ، قال: ما بطن: نكاح امرأة الأب "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الرابع(@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8074 - (@)(@@) ذكر عن روح بن عبادة، ثنا عثمان بن غياث، عن عكرمة: " {وما بطن} [الأنعام: 151] من الفواحش: الزنا والسرقة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ولا تقتلوا النفس} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8075 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله تعالى: " {ولا تقتلوا النفس التي حرم الله إلا بالحق} [الأنعام: 151] ، يعني: نفس المؤمن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {التي حرم الله إلا بالحق} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8076 - (@)(@@) وبه عن سعيد بن جبير، في قول الله: " {ولا تقتلوا النفس التي حرم} [الأنعام: 151] ، قتلها {إلا بالحق} [الأنعام: 151] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ذلكم وصاكم به لعلكم تعقلون} (@)(@@) [الأنعام: 151](@)(@@) PageV05P1417(@)(@@)(@@)(@@) | 8077 - (@)(@@) حدثنا أحمد بن سنان الواسطي، ثنا يزيد بن هارون، أنا سفيان بن حسين، عن الزهري، عن أبي إدريس الخولاني، عن عبادة بن الصامت، قال رسول الله صلى الله عليه وسلم: " أيكم يبايعني على هؤلاء الآيات الثلاث؟ ثم تلا: {قل تعالوا أتل ما حرم ربكم عليكم ألا تشركوا به شيئا وبالوالدين إحسانا ولا تقتلوا أولادكم من إملاق(@)(@@)(@@)(@@) | [ص: 1418](@)(@@) نحن نرزقكم وإياهم ولا تقربوا الفواحش ما ظهر منها وما بطن ولا تقتلوا النفس التي حرم الله إلا بالحق ذلكم وصاكم به لعلكم تعقلون} [الأنعام: 151] "، حتى فرغ من ثلاث آيات، ثم قال: «ومن وفى بهن آجره الله، ومن انتقص منهن شيئا فأدركه الله في الدنيا، كانت عقوبة، ومن أخره إلى الآخرة، كان أمره إلى الله، إن شاء أخذه، وإن شاء عفا عنه»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8078 - (@)(@@) أخبرنا محمد بن سعد، فيما كتب إلي، حدثني أبي، حدثني عمي، عن أبيه، عن جده، عن 
ms1229	 ابن عباس، قال: " وصية الله: دين الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولا تقربوا مال اليتيم} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1418(@)(@@)(@@)(@@) | 8079 - (@)(@@) حدثنا حجاج بن حمزة، ثنا يحيى بن آدم، ثنا إسرائيل، عن عطاء بن السائب، عن سعيد بن جبير، عن ابن عباس، قال: " لما نزلت: {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] عزلوا أموال اليتامى، حتى جعل الطعام يفسد واللحم ينتن، فذكروا ذلك للنبي صلى الله عليه وسلم فنزلت: {وإن تخالطوهم فإخوانكم، والله يعلم المفسد من المصلح} [البقرة: 220] ، قال: «فخالطوهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8080 - (@)(@@) حدثني محمد بن حماد الطهراني، ثنا حفص بن عمر العدني، ثنا الحكم بن أبان، عن عكرمة، في قوله: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: ليس لولي اليتيم أن يلبس قلنسوة ولا عمامة من ماله، ولكن يده مع يده "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1418(@)(@@)(@@)(@@) | 8081 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا حفص، عن فضيل بن مرزوق، عن عطية: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: طلب التجارة فيه والربح فيه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8082 - (@)(@@) حدثنا علي بن الحسن، ثنا عبد الله بن عامر بن زرارة، ثنا شريك، عن أبي إسحاق، في قوله: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: لا يشتري منه شيئا، أحسبه الوصي "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {إلا بالتي هي أحسن} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1418(@)(@@)(@@)(@@) | 8083 - (@)(@@) حدثنا محمد بن إسماعيل الأحمسي، ثنا وكيع، عن فضيل بن مرزوق، عن(@)(@@)(@@)(@@) | [ص: 1419](@)(@@) سليط، عن الضحاك: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: يبتغي اليتيم في ماله " وروي عن السدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8084 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، أنا أصبغ، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: {التي هي أحسن} [الأنعام: 152] أن يأكل بالمعروف إن افتقر، وإن استغنى فلا يأكل. قال الله: {ومن كان غنيا فليستعفف، ومن كان فقيرا فليأكل بالمعروف} [النساء: 6] . فسئل عن الكسوة، فقال: لم يذكر الله كسوة، وإنما ذكر الأكل "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8085 - (@)(@@) حدثنا أبي، ثنا أبو غسان، ثنا حسن 
ms1230	 بن صالح، في هذه الآية: " {ولا تقربوا مال اليتيم إلا بالتي هي أحسن} [الأنعام: 152] ، قال: يبتغي له من فضل الله، ولا يكون للذي يبتغي له فيه من شيء "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {حتى يبلغ أشده} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1419(@)(@@)(@@)(@@) | 8086 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن إدريس، عن عبد الله بن عثمان بن خثيم، عن مجاهد، عن ابن عباس: " {أشده} [الأنعام: 152] ، قال: ثلاث وثلاثون " وروي عن مجاهد، وقتادة نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1419(@)(@@)(@@)(@@) | 8087 - (@)(@@) حدثنا المنذر بن شاذان، ثنا زكريا بن عدي، أنا هشيم، عن منصور، عن الحسن: " {أشده} [الأنعام: 152] ، قال: أربعون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1419(@)(@@)(@@)(@@) | 8088 - (@)(@@) حدثنا أبي، ثنا عمرو بن رافع، أنبأ هشيم، عن مجالد، عن الشعبي، أنه قال " الأشد: الحلم إذا كتبت له الحسنات وكتبت عليه السيئات " وروي عن ربيعة، وزيد بن أسلم، ومالك، قالوا: الحلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1419(@)(@@)(@@)(@@) | 8089 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني عبد الله بن لهيعة(@)(@@)(@@)(@@) | [ص: 1420](@)(@@) ، حدثني عطاء بن دينار، عن سعيد بن جبير: قوله: " {حتى يبلغ أشده} [الأنعام: 152] ، قال: ثماني عشرة سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الخامس(@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8090 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {حتى يبلغ أشده} [الأنعام: 152] ، أما أشده فثلاثون سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه السادس(@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8091 - (@)(@@) حدثني أبو عبد الله محمد بن حماد الطهراني، أنا حفص بن عمر، ثنا الحكم بن أبان، عن عكرمة، في قوله: " {أشده} [الأنعام: 152] ، قال: خمس وعشرون سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه السابع(@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8092 - (@)(@@) ذكر عن أبي معشر، عن محمد بن قيس، قوله: " {أشده} [الأنعام: 152] خمس عشرة سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وأوفوا الكيل والميزان بالقسط} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8093 - (@)(@@) حدثنا أبو زرعة، ثنا منجاب بن الحارث، أنا بشر بن عمارة، عن أبي روق، عن الضحاك، عن ابن عباس، في قول الله: " {بالقسط} [الأنعام: 152] ، قال: يعني بالعدل "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {لا نكلف نفسا إلا وسعها} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8094 - (@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، في قوله: " {لا نكلف نفسا إلا 
ms1231	 وسعها} [الأنعام: 152] ، قال: هم المؤمنون، وسع الله عليهم أمر دينهم فقال: {ما جعل عليكم في الدين من حرج} [الحج: 78] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {إلا وسعها} (@)(@@) [البقرة: 233](@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8095 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {إلا وسعها} [البقرة: 233] يعني: إلا طاقتها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1420(@)(@@)(@@)(@@) | 8096 - (@)(@@) حدثنا أبي، ثنا محمود بن غيلان، ثنا عبدان بن عثمان بن جبلة، ثنا عباد بن العوام، عن إسماعيل بن أبي خالد، عن عامر الشعبي: " {لا نكلف نفسا إلا وسعها} [الأنعام: 152] : إلا ما عملت لها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1421(@)(@@)(@@)(@@) | 8097 - (@)(@@) حدثنا أبي، ثنا الحسين بن الزبرقان، ثنا فضيل بن عياض، عن سفيان، في قوله: " {لا نكلف نفسا إلا وسعها} [الأنعام: 152] ، قال: أداء الفرائض "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وإذا قلتم فاعدلوا} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1421(@)(@@)(@@)(@@) | 8098 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {وإذا قلتم فاعدلوا} [الأنعام: 152] ، قال: قولوا الحق "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولو كان ذا قربى} (@)(@@) [المائدة: 106](@)(@@) PageV05P1421(@)(@@)(@@)(@@) | 8099 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، قوله: " {وإذا قلتم فاعدلوا ولو كان ذا قربى} [الأنعام: 152] ، يعني: ولو كان قرابتك فقل فيه الحق "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وبعهد الله أوفوا} (@)(@@) [الأنعام: 152](@)(@@) PageV05P1421(@)(@@)(@@)(@@) | 8100 - (@)(@@) وبه عن سعيد بن جبير، في قول الله تعالى: " {وبعهد الله أوفوا} [الأنعام: 152] ، وقوله في النحل: {وأوفوا بعهد الله إذا عاهدتم} [النحل: 91] ، وقوله: {ولا تنقضوا الأيمان بعد توكيدها} [النحل: 91] ، يعني: بعد تغليظها وتشديدها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ذلكم وصاكم به} [الأنعام: 151] قد تقدم تفسيره(@)(@@) PageV05P1421(@)(@@)(@@)(@@) | قوله تبارك وتعالى: {وأن هذا صراطي مستقيما فاتبعوه} (@)(@@) [الأنعام: 153](@)(@@) PageV05P1421(@)(@@)(@@)(@@) | 8101 - (@)(@@) حدثنا أبو سعيد، ثنا أبو خالد الأحمر، قال: سمعت مجالدا، يذكره عن الشعبي، عن جابر بن عبد الله، قال: " كنا عند رسول الله صلى الله عليه وسلم فخط خطا، وخط خطين عن يمينه، وخط خطين عن يساره، ثم وضع في الخط الأوسط، فقال: «هذا سبيل الله» ، ثم تلا هذه الآية: {وأن هذا صراطي مستقيما فاتبعوه ولا 
ms1232	 تتبعوا السبل} [الأنعام: 153] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ولا تتبعوا السبل} (@)(@@) [الأنعام: 153](@)(@@) PageV05P1422(@)(@@)(@@)(@@) | 8102 - (@)(@@) حدثنا أبو هارون محمد بن خالد الخزاز، ثنا عبد الله بن الجهم، ثنا عمرو بن أبي قيس، عن عاصم، عن أبي وائل، عن عبد الله بن مسعود، قال: " خط رسول الله صلى الله عليه وسلم خطا، ثم خط يمينا وشمالا، ثم قرأ النبي صلى الله عليه وسلم: {وأن هذا صراطي مستقيما فاتبعوه} [الأنعام: 153] ، فقال: هذه السبل مشترك، وليس من هذه سبيل إلا وعليه شيطان يدعو إليه، ثم قرأ النبي صلى الله عليه وسلم: {وأن هذا صراطي مستقيما فاتبعوه ولا تتبعوا السبل فتفرق بكم عن سبيله} [الأنعام: 153] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8103 - (@)(@@) أخبرنا محمد بن سعد، فيما كتب إلي، حدثني أبي، حدثني عمي، عن أبيه، عن عطية، عن ابن عباس، قوله: " {ولا تتبعوا السبل فتفرق بكم عن سبيله} [الأنعام: 153] ، يقول: لا تتبعوا الضلالات "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8104 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو أسامة، عن شبل، عن ابن أبي نجيح، عن مجاهد، في قوله: " {ولا تتبعوا السبل فتفرق بكم عن سبيله} [الأنعام: 153] ، قال: البدع والشبهات "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فتفرق بكم عن سبيله} (@)(@@) [الأنعام: 153](@)(@@) PageV05P1422(@)(@@)(@@)(@@) | 8105 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {ولا تتبعوا السبل} [الأنعام: 153] فتفرق بكم عن سبيله، قال: نهاهم أن يتبعوا السبل سوى الإسلام، فتتفرق بهم عن سبيله، عن الإسلام "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ذلكم وصاكم به لعلكم تتقون} (@)(@@) [الأنعام: 153](@)(@@) PageV05P1422(@)(@@)(@@)(@@) | 8106 - (@)(@@) حدثنا عصام بن العسقلاني، بها على شط البحر، ثنا آدم، ثنا أبو صفوان القاسم بن يزيد بن عوانة، عن يحيى أبي النضر، ثنا جويبر، عن الضحاك، في قوله: " {لعلكم تتقون} [البقرة: 21] ، يقول: لعلكم تتقون النار بالصلوات الخمس "(@)(@@) PageV00P000(@)(@@) أخبرنا عمرو بن ثور القيساري، فيما كتب إلي، ثنا الفرياني، ثنا سفيان، عن ابن أبي نجيح، عن مجاهد: " {لعلكم تتقون} [الأنعام: 153] ، قال: لعلكم تطيعوه "(@)(@@) PageV05P1422(@)(@@)(@@)(@@) | قوله تعالى: {ثم آتينا موسى الكتاب} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1422(@)(@@)(@@)(@@) | 8108 - (@)(@@) حدثنا أبي، ثنا عبد الله بن رجاء، أنبأ عمران أبو العوام القطان، عن قتادة، عن أبي المليح، 
ms1233	 عن واثلة، أن النبي صلى الله عليه وسلم، قال: «وأنزل التوراة لست مضين من رمضان»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8109 - (@)(@@) حدثنا علي بن الحسن الهسنجاني، ثنا ابن أبي مريم، ثنا المفضل بن فضالة، حدثني أبو صخر: " {ثم آتينا موسى الكتاب تماما على الذي أحسن} [الأنعام: 154] ، قال: الله هو الذي أحسن، آتى محمدا الكتاب من عنده، تماما لما قد كان من إحسانه إليه، يقول: {ثم آتينا موسى الكتاب تماما} [الأنعام: 154] على أن الذي أتم ذلك له، فالله الذي أحسن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {تماما} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1423(@)(@@)(@@)(@@) | 8110 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {ثم آتينا موسى الكتاب تماما على الذي أحسن} [الأنعام: 154] ، قال: تماما من الله عز وجل وإحسانه الذي أحسن إليهم وهداهم للإسلام آتاهم ذلك الكتاب، تماما لنعمه عليهم وإحسانه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {على الذي أحسن} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1423(@)(@@)(@@)(@@) | 8111 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {تماما على الذي أحسن} [الأنعام: 154] ، قال: على المؤمنين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8112 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا معمر، عن قتادة، في قوله: " {ثم آتينا موسى الكتاب تماما على الذي أحسن} [الأنعام: 154] ، قال: من أحسن في الدنيا تمم الله ذلك له في الآخرة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8113 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الرحمن، ثنا عبد الله بن أبي جعفر، عن أبيه، عن الربيع: وأما قوله: " {تماما على الذي أحسن} [الأنعام: 154] ، يقول: أحسن فيما أعطاه الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وتفصيلا} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1423(@)(@@)(@@)(@@) | 8114 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس بن الوليد، ثنا يزيد، عن سعيد، عن قتادة، قوله: " {وتفصيلا لكل شيء} [الأنعام: 154] أي: تبيانا لكل شيء، وفيه حلاله وحرامه "(@)(@@) PageV00P000(@)(@@) ذكر عن عبد الرحمن بن عمر رستة، ثنا ابن مهدي، عن محمد بن مسلم، عن خصيف، عن مجاهد: «لما ألقى موسى الألواح بقي الهدى والرحمة، وذهب التفصيل»(@)(@@) PageV05P1424(@)(@@)(@@)(@@) | قوله تعالى: {لكل شيء} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8116 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد: قوله: 
ms1234	 " {لكل شيء} [الأنعام: 154] ، قال: ما أمروا به وما نهوا عنه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهدى} (@)(@@) [البقرة: 97](@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8117 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا الثوري، عن بيان، عن الشعبي، في قوله: " {هدى} [الأنعام: 154] ، قال: من الضلالة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8118 - (@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي: وأما قوله: " {هدى} [الأنعام: 154] ، قال: نور "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8119 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {هدى} [الأنعام: 154] ، قال: تبيان "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ورحمة لعلهم بلقاء ربهم يؤمنون} (@)(@@) [الأنعام: 154](@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8120 - (@)(@@) حدثنا عصام بن رواد، ثنا آدم، ثنا أبو جعفر الرازي، عن الربيع، عن أبي العالية، في قوله: " {ورحمة} [الأنعام: 154] ، قال: القرآن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهذا كتاب أنزلناه مبارك} (@)(@@) [الأنعام: 92](@)(@@) PageV05P1424(@)(@@)(@@)(@@) | 8121 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو عمير، ثنا مهدي بن إبراهيم الرملي، عن مالك بن أنس، عن ربيعة، قال: «إن الله تبارك وتعالى أنزل القرآن وترك فيه موضعا للسنة، وسن رسول الله صلى الله عليه وسلم السنة وترك فيها موضعا للرأي»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8122 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس بن الوليد، ثنا ابن زريع، عن سعيد، عن قتادة، قوله: " {وهذا كتاب أنزلناه مبارك} [الأنعام: 92] : وهو القرآن الذي أنزله الله على محمد صلى الله عليه وسلم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فاتبعوه} (@)(@@) [الأنعام: 153](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8123 - (@)(@@) وبه عن قتادة، قوله: " {فاتبعوه} [الأنعام: 155] يقول: فاتبعوا حلاله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {واتقوا لعلكم ترحمون} (@)(@@) [الأنعام: 155](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8124 - (@)(@@) أخبرنا موسى بن هارون الطوسي، فيما كتب إلي، ثنا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة، قوله: " {واتقوا} [الأنعام: 155] يقول: واتقوا ما حرم، وهو هذا القرآن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أن تقولوا} (@)(@@) [البقرة: 235](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8125 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {أن تقولوا إنما أنزل الكتاب على طائفتين من قبلنا} [الأنعام: 156] : اليهود، والنصارى. خاف أن تقوله قريش "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إنما أنزل الكتاب على طائفتين من قبلنا} (@)(@@) [الأنعام: 156](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8126 - (@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن 
ms1235	 علي بن أبي طلحة، عن ابن عباس، قوله: " {أن تقولوا إنما أنزل الكتاب على طائفتين من قبلنا} [الأنعام: 156] وهم اليهود، والنصارى "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وإن كنا عن دراستهم لغافلين} (@)(@@) [الأنعام: 156](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8127 - (@)(@@) وبه عن ابن عباس، قوله: " {وإن كنا عن دراستهم، لغافلين} [الأنعام: 156] ، يقول: إن كنا عن تلاوته لغافلين " وروي عن السدي، نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8128 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، ثنا عبد الرحمن بن زيد بن أسلم، في قوله: " {وإن كنا عن دراستهم لغافلين} [الأنعام: 156] ، قال: الدراسة: القراءة والعلم. وقرأ {ودرسوا ما فيه} [الأعراف: 169] ، قال: علموا ما فيه، لم يأتوه بجهالة. وقرأ: {وليقولوا درست} [الأنعام: 105] علمت "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لغافلين} (@)(@@) [الأنعام: 156](@)(@@) PageV05P1425(@)(@@)(@@)(@@) | 8129 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {وإن كنا عن دراستهم، لغافلين} [الأنعام: 156] ، قال: إن كنا عن قراءتهم لغافلين، لا نعلم ما هي "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو تقولوا لو أنا أنزل علينا الكتاب} (@)(@@) [الأنعام: 157](@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8130 - (@)(@@) وبه عن السدي، قوله: " {لو أنا أنزل علينا الكتاب} [الأنعام: 157] ، قال: اليهود، والنصارى "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لكنا أهدى منهم} (@)(@@) [الأنعام: 157](@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8131 - (@)(@@) وبه عن السدي، قوله: " {لكنا أهدى منهم} [الأنعام: 157] ، قال: " حين قلتم: لو جاءنا الكتاب لكنا أهدى منهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8132 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {أو تقولوا لو أنا أنزل، علينا الكتاب لكنا أهدى منهم} [الأنعام: 157] ، «وهذا قول كفار العرب»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فقد جاءكم بينة من ربكم} [الأنعام: 157] الآية(@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8133 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {فقد جاءكم بينة من ربكم} [الأنعام: 157] ، يقول: قد جاءكم بينة لسان عربي مبين، حين لم تعرفوا دراسة الطائفتين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وصدف عنها} (@)(@@) [الأنعام: 157](@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8134 - (@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {وصدف عنها} [الأنعام: 157] ، يقول: أعرض عنها " وروي عن مجاهد، والسدي، وعطاء الخراساني نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: 
ms1236	 {سنجزي الذين يصدفون عن آياتنا سوء العذاب} [الأنعام: 157] الآية(@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8135 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {سنجزي الذين يصدفون عن آياتنا،} [الأنعام: 157] : يعرضون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {هل ينظرون إلا أن تأتيهم الملائكة} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1426(@)(@@)(@@)(@@) | 8136 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو بكر بن أبي شيبة، وعثمان، قالا: ثنا معاوية بن هشام، ثنا سفيان الثوري، عن الأعمش، عن مسلم، عن مسروق، عن عبد الله: " {هل ينظرون إلا أن تأتيهم الملائكة} [الأنعام: 158] ، قال: «عند الموت» وروي عن مجاهد، والسدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1427(@)(@@)(@@)(@@) | 8137 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا معمر، عن قتادة، قوله: " {إلا أن تأتيهم الملائكة} [الأنعام: 158] ، قال: بالموت " وروي عن مجاهد، والسدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1427(@)(@@)(@@)(@@) | 8138 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا معمر، عن قتادة، قوله: " {إلا أن تأتيهم الملائكة} [الأنعام: 158] ، قال: بالموت " وروي عن الحسن، ومقاتل بن حيان نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو يأتي ربك} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1427(@)(@@)(@@)(@@) | 8139 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا معمر، عن قتادة: " {أو يأتي ربك} [الأنعام: 158] ، قال: يوم القيامة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8140 - (@)(@@) قرأت على محمد بن الفضل، ثنا محمد بن علي، أنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {هل ينظرون إلا أن تأتيهم الملائكة أو يأتي ربك} [الأنعام: 158] ، قال: يوم القيامة، في ظلل من الغمام "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو يأتي بعض آيات ربك} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1427(@)(@@) حدثنا أبي، ثنا ابن الطباع، ثنا وكيع، عن ابن أبي ليلى، عن عطية، عن أبي سعيد الخدري، عن النبي صلى الله عليه وسلم، في قوله: " {يوم يأتي بعض آيات ربك لا ينفع نفسا إيمانها} [الأنعام: 158] ، قال: طلوع الشمس من مغربها "(@)(@@) PageV05P1427(@)(@@)(@@)(@@) | 8142 - (@)(@@) حدثنا أبي، ثنا عيسى بن جعفر، ثنا سفيان، عن منصور، عن أبي الضحى، عن مسروق، عن عبد الله، في قوله: " {أو يأتي بعض آيات ربك} [الأنعام: 158] ، قال: طلوع الشمس والقمر كالبعيرين القرينين من مغربها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لا ينفع نفسا إيمانها} 
ms1237	 (@)(@@) [الأنعام: 158](@)(@@) PageV05P1427(@)(@@)(@@)(@@) | 8143 - (@)(@@) حدثنا أحمد بن سنان، ثنا يزيد بن هارون، أنا سفيان بن الحسين، عن الحكم، عن إبراهيم التيمي، عن أبيه، عن أبي ذر، قال: " كنت مع رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) | [ص: 1428](@)(@@) على حمار وعليه برذعة وقطيفة. قال: وذاك عند غروب الشمس، فقال: «يا أبا ذر، أتدري أين تغيب هذه؟» قلت: الله ورسوله أعلم. قال: تخر لربها ساجدة تحت العرش، فإذا حان خروجها أذن لها فتخرج، فتطلع، فإذا أراد أن يطلعها من حيث تغرب حبسها، فتقول: يا رب، إن مسيري بعيد. فيقول لها: اطلعي من حيث غربت. فذلك حين {لا ينفع نفسا إيمانها لم تكن آمنت من قبل} [الأنعام: 158] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8144 - (@)(@@) حدثنا أبو خلاد سليمان بن خلاد، ثنا يحيى بن أبي كثير، ثنا نافع بن عمر، عن ابن أبي مليكة، قال: " جلسنا إلى عبد الله بن عمرو بن العاص، فقال: " يوم {لا ينفع نفسا إيمانها لم تكن آمنت من قبل أو كسبت في إيمانها خيرا} [الأنعام: 158] : أن تطلع الشمس من مغربها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لم تكن آمنت من قبل} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1428(@)(@@)(@@)(@@) | 8145 - (@)(@@) أخبرنا محمد بن سعد العوفي، فيما كتب إلي، ثنا أبي، ثنا عمي، عن أبيه، عن عطية، عن ابن عباس، قوله: " {يوم يأتي بعض آيات ربك لا ينفع نفسا إيمانها لم تكن آمنت من قبل} [الأنعام: 158] ، فهو آية، لا ينفع مشركا إيمانه عند الآيات، وينفع أهل الإيمان عند الآيات إن كانوا اكتسبوا خيرا قبل ذلك. قال ابن عباس: خرج رسول الله صلى الله عليه وسلم عشية من العشيات، فقال لهم: يا عباد الله، توبوا إلى الله بقراب، فإنكم توشكون أن تروا الشمس من قبل المغرب، فإذا فعلت ذلك حبست التوبة، وطوي العمل، وختم الإيمان. فقال الناس: هل لذلك من آية يا رسول الله؟ فقال: آية تلكم الليلة أن تطول كقدر ثلاث ليال، فيستيقظ الذين يخشون ربهم فيصلون له، ثم يقضون صلاتهم، والليل كأنه لم ينقص، فيضطجعون، حتى إذا استيقظوا والليل مكانه، فإذا رأوا ذلك خافوا أن يكون ذلك بين يدي أمر 
ms1238	 عظيم، فإذا أصبحوا فطال عليهم طلوع الشمس، فبينا هم ينتظرونها إذ طلعت عليهم من قبل المغرب، فإذا فعلت ذلك لم ينفع نفسا إيمانها لم تكن آمنت من قبل "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أو كسبت في إيمانها خيرا} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1428(@)(@@)(@@)(@@) | 8146 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا(@)(@@)(@@)(@@) | [ص: 1429](@)(@@) أسباط، عن السدي، قوله: " {أو كسبت في إيمانها خيرا} [الأنعام: 158] "، يقول: كسبت في تصديقها «خيرا» عملا صالحا، هؤلاء أهل القبلة، وإن كانت مصدقة لم تعمل قبل ذلك خيرا فعملت بعد أن رأت الآية، لم يقبل منها. وإن عملت قبل الآية خيرا، ثم عملت بعد الآية خيرا قبل منها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8147 - (@)(@@) قرأت على محمد بن الفضل، ثنا محمد بن علي، أنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {أو كسبت في إيمانها خيرا} [الأنعام: 158] ، يعني: المسلم الذي لم يعمل في إيمانه خيرا وكان قبل الآية مقيما على الكبائر "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {خيرا} (@)(@@) [البقرة: 158](@)(@@) PageV05P1429(@)(@@)(@@)(@@) | 8148 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {خيرا} [البقرة: 158] ، قال: عملا صالحا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {قل انتظروا إنا منتظرون} (@)(@@) [الأنعام: 158](@)(@@) PageV05P1429(@)(@@)(@@)(@@) | 8149 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الرحمن، ثنا عبد الله بن أبي جعفر، عن أبيه، عن الربيع، يعني قوله: " {قل انتظروا إنا منتظرون} [الأنعام: 158] ، خوفهم عذابه وعقوبته ونقمته "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {إن الذين فرقوا دينهم} (@)(@@) [الأنعام: 159](@)(@@) PageV05P1429(@)(@@)(@@)(@@) | 8150 - (@)(@@) حدثنا أبو بدر عباد بن الوليد الغبري، ثنا محمد بن عباد الهنائي، ثنا حميد بن مهران المالكي الخراط، قال: سألت أبا غالب، عن هذه الآية: " {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] إلى آخر الآية. حدثني أبو أمامة عن رسول الله صلى الله عليه وسلم، أنهم الخوارج "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8151 - (@)(@@) حدثنا محمد بن عبد الله بن المبارك المخرمي، ثنا عبد الرحمن بن مهدي، ثنا سفيان، عن ليث، عن طاوس، عن أبي هريرة، في قوله: " {إن الذين فرقوا دينهم} [الأنعام: 159] ، قال: هم من هذه الأمة، أو في هذه الأمة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه 
ms1239	 الثاني(@)(@@) PageV05P1429(@)(@@)(@@)(@@) | 8152 - (@)(@@) حدثنا أبي، ثنا علي بن محمد الطنافسي، ثنا يحيى بن آدم، ثنا زهير، ثنا أبو إسحاق، حدثني عمرو بن مرة، أنه سمع عليا، قرأ عنده رجل التي في الأنعام: " {فرقوا دينهم} [الأنعام: 159] ، فقال علي: لا ما فرقوا دينهم ولكنهم فارقوا دينهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1430(@)(@@)(@@)(@@) | 8153 - (@)(@@) أخبرنا محمد بن سعد، فيما كتب إلي، ثنا أبي، حدثني عمي، عن أبيه، عن عطية، عن ابن عباس، قوله: " {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] وذلك أن اليهود والنصارى اختلفوا قبل أن يبعث محمد صلى الله عليه وسلم، فتفرقوا، فلما بعث محمد أنزل عليه: {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8154 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، أنا معمر، عن قتادة، قوله: " {إن الذين فرقوا دينهم} [الأنعام: 159] ، قال: هم اليهود والنصارى "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1430(@)(@@)(@@)(@@) | 8155 - (@)(@@) أخبرنا أبو سعيد بن يحيى بن سعيد القطان، ثنا حسين الجعفي، عن شبيان، عن قتادة، قوله: " {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] ، قال: اليهود "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8156 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {إن الذين فرقوا دينهم} [الأنعام: 159] ، قال: تركوا دينهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وكانوا شيعا} (@)(@@) [الأنعام: 159](@)(@@) PageV05P1430(@)(@@)(@@)(@@) | 8157 - (@)(@@) حدثنا أبي، ثنا محمد بن المصفى، ثنا بقية، ثنا شعبة، عن مجالد، عن الشعبي، عن شريح، عن عمر، رضي الله عنه أن رسول الله صلى الله عليه وسلم، قال لعائشة: " يا عائشة {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] ، هم أصحاب الأهواء والبدع «،» يا عائشة: إن لكل صاحب ذنب توبة إلا أصحاب البدع ليست لهم توبة، فهم مني براء، وأنا منهم بريء "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8158 - (@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، في قوله: {إن الذين فرقوا دينهم وكانوا شيعا} [الأنعام: 159] ، قال: أمر الله المؤمنين بالجماعة، ونهاهم عن الاختلاف والفرقة، وأخبرهم: إنما هلك من كان قبلهم بالمراء والخصومات في دين الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8159 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم 
ms1240	 الأودي، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {وكانوا شيعا} [الأنعام: 159] ، قال: فرقاء "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لست منهم في شيء} (@)(@@) [الأنعام: 159](@)(@@) PageV05P1431(@)(@@)(@@)(@@) | 8160 - (@)(@@) حدثنا أحمد بن منصور الرمادي، ثنا شجاع بن الوليد، ثنا عمرو بن قيس الملائي، عن مرة الطيب: " ليتق امرؤ ألا يكون من رسول الله صلى الله عليه وسلم في شيء. ثم قرأ هذه الآية: {إن الذين فرقوا دينهم وكانوا شيعا لست منهم في شيء} [الأنعام: 159] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8161 - (@)(@@) حدثنا أبي، ثنا سهل بن عثمان، ثنا عبد الله بن إدريس، عن مالك بن مغول، عن علي بن الأقمر، عن أبي الأحوص، قال: قرأ: " {إن الذين فرقوا دينهم وكانوا شيعا لست منهم في شيء} [الأنعام: 159] ، قال: ثم يقول: برئ منهم نبيهم صلى الله عليه وسلم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8162 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي، فيما كتب إلي، ثنا أحمد بن المفضل، ثنا أسباط، عن السدي، قوله: " {لست منهم في شيء} [الأنعام: 159] ، يقول: لم يؤمر بقتالهم، ثم نسخت فأمر بقتالهم في سورة براءة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إنما أمرهم إلى الله} (@)(@@) [الأنعام: 159](@)(@@) PageV05P1431(@)(@@)(@@)(@@) | 8163 - (@)(@@) وبه عن السدي، قوله: " {إنما أمرهم إلى الله} [الأنعام: 159] هؤلاء اليهود والنصارى "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {من جاء بالحسنة} (@)(@@) [الأنعام: 160](@)(@@) PageV05P1431(@)(@@) حدثنا عمرو الأودي، ثنا وكيع، عن سفيان، عن الأعمش، عن شمر بن عطية، عن رجل، من التيم، عن أبي ذر، قال: " قلت يا رسول الله: لا إله إلا الله، من الحسنات؟ قال: «هي من أحسن الحسنات»(@)(@@) PageV05P1431(@)(@@)(@@)(@@) | 8165 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن فضيل، عن الحسن بن عبيد الله، عن جامع بن شداد، عن الأسود بن هلال، عن عبد الله بن مسعود، في قوله: " {من جاء بالحسنة} [الأنعام: 160] ، قال: لا إله إلا الله " وروي عن ابن عباس، وأبي هريرة، وعلي بن الحسين، وسعيد بن جبير، والحسن، وعطاء، ومجاهد، وأبي صالح ذكوان، ومحمد بن كعب القرظي، والنخعي، والضحاك، والزهري، وعكرمة، وزيد بن أسلم، وقتادة نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فله عشر أمثالها} (@)(@@) [الأنعام: 160](@)(@@) PageV05P1431(@)(@@)(@@)(@@) | 8166 - (@)(@@) حدثنا أحمد بن سنان، ثنا أبو معاوية، عن عاصم الأحول، 