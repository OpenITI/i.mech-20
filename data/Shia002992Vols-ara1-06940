ms6938	 عبد الله بن الحسين بن زيد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام وروى عنه محمد ابن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 194.(@)(@@) * وروى عن عثمان بن عيسى، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1842 (الإستبصار:(@)(@@) ج 3، ح 873).(@)(@@) * وروى عن عمرو بن عثمان، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 778، و 1194، و ج 3، ح 192.(@)(@@) * وروى عن فيض، وروى عنه الحسن بن علي.(@)(@@) التهذيب: ج 8، ح 896 (الإستبصار:(@)(@@) ج 3، ح 65 و ح 897 (الإستبصار:(@)(@@) ج 4، ح 63).(@)(@@) * وروى عن معاوية بن عمار، وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، في ضمن ح 339.(@)(@@) * وروى عن ميسر، وروى عنه الحسن بن علي بن فضال.(@)(@@) التهذيب: ج 7، ح 322.(@)(@@) * وروى عن نوح بن شعيب الخراساني، وروى عنه محمد بن أحمد بن PageV22P305(@)(@@) يحيى.(@)(@@) التهذيب: ج 1، ح 697 (الإستبصار:(@)(@@) ج 1، ح 96).(@)(@@) * وروى عن النوفلي، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 8، ح 851، و ج 9، ح 666، و ج 10، ح 608.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 6، ح 426.(@)(@@) * وروى عن بعض أصحاب أمير المؤمنين عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 4، ب 8، ح 14.(@)(@@) * وروى عن بعض أصحابنا، عن الصادق عليه السلام، وروى عنه محمد ابن أحمد بن يحيى.(@)(@@) التهذيب: ج 8، ح 1002.(@)(@@) * وروى عن الثقة من أصحاب أمير المؤمنين عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 4، ب 79، ح 3.(@)(@@) * وروى عمن يثق به من أصحاب أمير المؤمنين عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 4، ب 5، ح 7.(@)(@@) (أبو إسحاق السبيعي) * روى عن الحارث، وروى عنه سفيان بن سعيد.(@)(@@) التهذيب: ج 9، ح 1174.(@)(@@) * وروى عن الحارث الأعور، وروى عنه أبو وكيع.(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 6، و ج 5، ك 3، ب 6، ح 2. والتهذيب: ج 7، ح 1616.(@)(@@) وروى عنه الحسن بن عمارة.(@)(@@) التهذيب: ج 9، ح 1172 (الإستبصار:(@)(@@) ج 4، ح 644).(@)(@@) وروى عمرو بن ثابت، عن رجل سماه، عنه.(@)(@@) الكافي: ج 1، ك 3، ب 22، ح 7.(@)(@@) * وروى عن عمرو بن 
ms6939	 خالد، وروى عنه إسرائيل بن يونس.(@)(@@) التهذيب: ج 1، ح 977.(@)(@@) * وروى عن بعض أصحاب أمير المؤمنين عليه السلام ممن يثق به عنه عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 4، ب 80، ح 13.(@)(@@) * وروى مرفوعا عن رسول الله صلى الله عليه وآله وسلم، وروى عنه غرة بن PageV22P306(@)(@@) دينار الرقي.(@)(@@) الكافي: ج 2، ك 1، ب 53، ح 2.(@)(@@) * وروى عمن حدثه عن أمير المؤمنين عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 2، ب 1، ح 4.(@)(@@) * وروى عمن حدثه ممن يثق به عن أمير المؤمنين عليه السلام، وروى عنه أبو حمزة.(@)(@@) الكافي: ج 1، ك 2، ب 3، ح 1.(@)(@@) (أبو إسماعيل السراج) * روى عن أبي عبد الله عليه السلام، وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الكافي: ج 3، ك 3، ب 80، ح 1.(@)(@@) * وروى عن أبي عمران، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 6، ك 8، ب 17، ح 12.(@)(@@) * وروى عن ابن مسكان، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 2، ك 1، ب 94، ح 2، و ج 3، ك 4، ب 2، ح 15، و ب 95، ح 7، و ج 4، ك 3، ب 217، ح 12، و ج 6، ك 8، ب 3، ح 2. والتهذيب: ج 3، ح 971.(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الكافي: ج 2، ك 2، ب 55، ح 1.(@)(@@) * وروى عن بشر بن جعفر، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 1، ك 4، ب 37، ح 5.(@)(@@) * وروى عن حبيب الخثعمي، وروى عنه محمد بن إسماعيل.(@)(@@) التهذيب: ج 2، ح 1444.(@)(@@) * وروى عن الحسين بن المختار، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 19.(@)(@@) * وروى عن حفص بن عمر، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 5، ك 2، ب 63، ح 6.(@)(@@) * وروى عن سكين بن عمار، وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الكافي: ج 4، ك 3، ب 129، ح 7.(@)(@@) والتهذيب: ج 5، ح 391 (الإستبصار:(@)(@@) ج 2، ح 773).(@)(@@) * وروى عن علي بن أبي حمزة، وروى عنه عبد الله بن عثمان.(@)(@@) التهذيب: ج 3، ح 970.(@)(@@) * وروى عن علي بن شجرة، وروى عنه محمد بن إسماعيل. PageV22P307(@)(@@) الكافي: ج 3، ك 4، ب 32، ح 24.(@)(@@) والتهذيب: ج 2، ح 429.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 
