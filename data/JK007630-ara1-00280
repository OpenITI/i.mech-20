ms261	 بسالف ما قد أصرا % % 52(@)(@@) % ترى للندامة في صفحتي % % ه سطرا مبينا وللذل سطرا % % 53(@)(@@) % لعمري لئن صوحت دوحة % لقد أعقبت غصنا منك نضرا % % 54(@)(@@) % وسيع الظلال على قومه % شهي الجنى ناعما مسبكرا % % 55(@)(@@) % رباطا لشملهم أن يشذ % ودعما لسقفهم أن يخرا % % 56(@)(@@) % بك انتظم العقد من بعد ما % % تهاوى فعطل جيدا ونحرا % % 57(@)(@@) % ضممت قواصيهم بعدما % % تعاطوا عصا البين صدعا وقسرا % % 58(@)(@@) % وكنت لهم كأبيك الكريم % حنو الرءوم وعطفا وبرا % % 59(@)(@@) % فلم يهو طود وأنت الكثيب % ولا مات زيد إذا كنت عمرا % % 60(@)(@@) % أطافوا بناديك واستحلبوك % فأحسنت حوطا وأغزرت درا % % PageV01P780 61(@)(@@) % وما ضرهم أنهم يعدمو % % ن غيثا وقد وجدوا منك أثرى % % 62(@)(@@) % مخايل كنت توسمتها % % قديما وعيفتها فيك زجرا % % 63(@)(@@) % وأيقن صدري أني أراك % لأهلك وجها وللناس صدرا % % 64(@)(@@) % بما كنت أبعدهم همة % وآمتنهم في الملمات أسرا % % 65(@)(@@) % وأضيقهم عذرة في السؤال % وأوسعهم ليلة القر قدرا % % 66(@)(@@) % وأجلى إذا الشبهات اختلط % % ن رأيا وأمضى لسانا وأجرى % % 67(@)(@@) % أمور إذا اجتمعت للفتى % % أراد به الله في العز أمرا % % 68(@)(@@) % سد اليوم ابناء عبد الرحيم % فأنت غدا سيد الناس طرا % % 69(@)(@@) % وثق ببشائر تملى علي % فما كذبت لي في الخير بشرى % % 70(@)(@@) % أنا ابن الوفاء الذي تعلمو % % ن لم أنو نكثا أو أطو غمرا % % PageV01P781 71(@)(@@) % قسيمكم إذا أساء الزمان % كما كان قاسمكم حين سرا % % 72(@)(@@) % حليا على عطل المهرجا % % ن يعصفن تاجا ويرصفن شذرا % % 73(@)(@@) % فإن تك وقتا أخلت بكم % فرب انقطاع ما كان هجرا % % 74(@)(@@) % ولولا تلاعب أيدي النوى % % بكم ما أغبت ثناء وشكرا % % PageV01P782 البحر : - 1(@)(@@) % متى رفعت لها بالغور نار % وقر بذي الأراك بها قرار % 2(@)(@@) % فكل دم أراق السير فيها % % بحكم السير مطلول جبار % 3(@)(@@) % فهل بالطالعين بنا الثنايا % % انوق ليل نظرته نهار % 4(@)(@@) % لعلك ان ترى عيناك قبلي % % مواقد والزفير لها شرار % 5(@)(@@) % وبعض المصطلين وإن نآني % % وأوحدني أخو ثقة وجار % 6(@)(@@) % يريد عواذلي عنه التفاتي % % بآية شط أو بعد المزار % 7(@)(@@) % وما عصب النوى عيني عليه 
ms262	 % بأول ما طوى القمر السرار % 8(@)(@@) % أمنتك يا فراق ورب يوم % حذرت لو أنه نفع الحذار % 9(@)(@@) % أخذت فلم تدع شيئا عليه % يخاف أسى ولا يرجى اصطبار % 10(@)(@@) % حبيب خنتني فيه ودار % وللناس الأحبة والديار % PageV01P783 11(@)(@@) % أمرتجع ويا نفسي عليه % برامة ذلك العيش المعار % 12(@)(@@) % وثوب شبيبة ما فاض حتى % % تقلص منه وانشمر الإزار % 13(@)(@@) % لكل سليبة بدل وفوت % لما سلب المسائح العذار % 14(@)(@@) % ظلام هب فيه وليتها لم % % تلح هذي الأدلة والمنار % 15(@)(@@) % ورب سمير ليل ود ألا % يضيء على جوانبه النهار % 16(@)(@@) % ألا يا صاحبي حرقي نجاء % يفوتكما بي اليوم الوقار % 17(@)(@@) % خذاني حيث لا النظر استراق % لريبته ولا النجوى سرار % 18(@)(@@) % وزما بالمطامع أنف غيري % % فبي عنها وإن خدعت نفار % 19(@)(@@) % كفى بالحرص عيبا أن أولي % % جداه منى وغايته انتظار % 20(@)(@@) % وما أنسى بآمل طوال % تناولهن أيام قصار % PageV01P784 21(@)(@@) % يقول المرء ما يهوى ويرجو % % ويفعل فعله الفلك المدار % 22(@)(@@) % وأن ظمئت ركاب أو أجيعت % فأفرع شعرها الوبر المطار % 23(@)(@@) % فخير من مراعيها بذل % عضاض بالحناجر واجترار % % 24(@)(@@) % وإلا فابغيا شرف المعالي % % بها إن كان للظلم انسفار % 25(@)(@@) % وضما بالخطير غريبتيها % % فثم العز يمنع والجوار % 26(@)(@@) % وماء فاضل عنها وبقل % تبزل في كمائمه البكار % 27(@)(@@) % ردا المجد التليد بها وعوذا % % بأغلب حبل ذمته مغار % 28(@)(@@) % ببحر ندى يفيض وبدر ناد % وإن رغم البدور أو البحار % 29(@)(@@) % جواد لا يزل به عثار % وجار لا يشق له غبار % 30(@)(@@) % تمنى الناس أصغر همتيه % فماتت دونها الهمم الكبار % PageV01P785 31(@)(@@) % وطار به فأنعله الثريا % % فؤاد لا يطير به الحذار % 32(@)(@@) % ونفس حرة لا يزدهيها % % حلى الدنيا وزخرفها المعار % 33(@)(@@) % يبيت الحق أصدق حاجتيها % % وكسب العز أطيب ما يمار % 34(@)(@@) % إذا التفتت إلى الدنيا عيون % فلفتتها إباء واحتقار % 35(@)(@@) % من الوافين أحلاما وعهدا % % إذا هفت الحبا ووهى الذمار % 36(@)(@@) % كرام لا يرون العسر فقرا % % وفي العرض الغنى والافتقار % 37(@)(@@) % إذا عزوا بأرض أوطنوها % % وإن ضيموا بها ركبوا فساروا % % 38(@)(@@) % كفوا بدلالة الكافي عليهم 
ms263	 % بحرص ما أدعى لهم الفخار % 39(@)(@@) % مضوا سلفا وجاء يزيد مجدا % % كما أوفى على السحب القطار % 40(@)(@@) % توحد من بني الدنيا ركوب % صعائبها إذا كره الخطار % PageV01P786 41(@)(@@) % سعى فحوى الكمال وهم قعود % وأنجد يطلب الدنيا وغاروا % % 42(@)(@@) % وأشرف شيمة ظلف وأمر % يطاع وعفة معها اقتدار % 43(@)(@@) % وعف فبات يحلبهن مذقا % % وأخلاف الزمان له غزار % 44(@)(@@) % حميت الملك مقتبلا وكهلا % % يخاف من الدنية أو يغار % 45(@)(@@) % ولم تدخل غريبا خارجيا % له بسواه نهض وانتصار % 46(@)(@@) % وقومت الأمور وهن ميل % لها في كف جابرها انكسار % 47(@)(@@) % وكل دعي فضل مستطب % له بالعجز شغل واعتذار % 48(@)(@@) % وسعت الناس إحسانا وعطفا % % كأنك رأفة بهم ظؤار % 49(@)(@@) % وصرت حلى الملوك وأي كف % لهم مدت فأنت لها سوار % 50(@)(@@) % تشير بك العلا نصحا عليهم % إذا ما خان رأي مستشار % PageV01P787 51(@)(@@) % بك انتصرت يدي وعلا لساني % % وصمم ناظري وبه ازورار % 52(@)(@@) % وكنت أطيع مضطرا زماني % % فأصبح لي على الزمن الخيار % 53(@)(@@) % برعيك في حق الفضل صحت % قناة كلها وصم وعار % 54(@)(@@) % وجدت فعدت بعد جفوف عودي % % وفي أغصان أيكتي اخضرار % 55(@)(@@) % عرفت توحدي فغرست مني % % غصونا ذا الثناء لها ثمار % 56(@)(@@) % محاسن لا يراها في إلا % بصير كيف ينتقد النضار % 57(@)(@@) % وردت نداك عذبا لم يكدر % % له حوض ولم تنزف غمار % 58(@)(@@) % على الإعسار تعطيني كثيرا % % ويعطى الناس ما بلغ اليسار % 59(@)(@@) % ومن آيات جودك أن غنينا % % به وإلى القليل بك افتقار % 60(@)(@@) % فعش يبلغك ما تجزى القوافي % % وما يسدى بهن وما ينار % PageV01P788 61(@)(@@) % بكل غريبة المعنى علوق % إذا قرت فليس لها نفار % 62(@)(@@) % تسير بعرضك المجلو فيها % % مسير الشمس مهلتها بدار % 63(@)(@@) % لها في الجو رافعة صعود % وفي مهوى الرياح لها انحدار % 64(@)(@@) % كأن فتيق منشرها يمان % تنفس في حقائبه العطار % 65(@)(@@) % يسوق المهرجان إليك منها % % عرائس والنشيد لها نثار % 66(@)(@@) % مبشرة بأن الله عين % عليك من الردى الجاري وجار % 67(@)(@@) % وأنك خالد لا الليل يفني % % مداك من البقاء ولا النهار % PageV01P789 البحر : - 1(@)(@@) % ما ليلتي على 
ms264	 أقر % إلا البكاء والسهر % % 2(@)(@@) % بت أظن الصبح بال % % عادة مما ينسفر % % 3(@)(@@) % أرقب من نجومها % % زوال أمر مستقر % 4(@)(@@) % رواكد كأنما % % أفلاكهن لم تدر % 5(@)(@@) % وكلما قلت انطوى % % شطر من الليل انتشر % 6(@)(@@) % أسألها أين الكرى % % أين النهار المنتظر % 7(@)(@@) % وكل شيء عندها % % إلا الرقاد والسحر % 8(@)(@@) % من مخبري فما أرى % % هل دام ليل فاستمر % 9(@)(@@) % وغابت الشمس نعم % فكيف خلد القمر % 10(@)(@@) % أين الألى طرحهم % مطارح البين الحذر % PageV01P790 11(@)(@@) % غابوا وما غابت لهم % دار ولا جد سفر % 12(@)(@@) % لكن عيون الكاشحي % % ن الشرز منها والخرز % 13(@)(@@) % ما برحت لا نظرت % تمنعنا حتى النظر % 14(@)(@@) % تطلعوا نار الجوى % % في القلب كيف تستعر % 15(@)(@@) % وما الذي تبعثه % على الجوانح الذكر % 16(@)(@@) % وأي نار للفؤا % % د فيهم عند البصر % 17(@)(@@) % غني بهيفاء الرفا % % ق والكؤوس لم تدر % 18(@)(@@) % فكل صاح انتشى % % وكل نشوان سكر % 19(@)(@@) % كأنما قلبي لها % % في صدر كل من حضر % 20(@)(@@) % فظلت أبكي مثلما % % أشرب أدمعا حمر % PageV01P791 21(@)(@@) % كأن ماء قدحي % من بين جفني عصر % 22(@)(@@) % قال الرسول عتبت % هيفاء قلت ما الخبر % 23(@)(@@) % قال تقول ملنا % % قلت الملول من غدر % 24(@)(@@) % لا والذي لو شاء أن % ينصفني منها قدر % 25(@)(@@) % ما خدعت بغيرها % % عيني على حسن الصور % 26(@)(@@) % بلى ولا أنكره % وليس بالأمر النكر % 27(@)(@@) % لقد رأيت البان من % ذي العلمين والسمر % 28(@)(@@) % تضربه ريح الصبا % % فيستوي وينأطر % 29(@)(@@) % فملت تشبيها بها % % آخذ ضما وأذر % 30(@)(@@) % فإن رأت ذلك ذن % % با إنني لمعتذر % PageV01P792 31(@)(@@) % يا يوم دب بيننا % % أمر الفراق ما أمر % 32(@)(@@) % ما كنت في الأيام إلا % عارضا ينطف شر % 33(@)(@@) % قد عيفتك الطير لي % % لكن قلبي ما زجر % 34(@)(@@) % ولائم مدت له % حبائل اللوم فجر % 35(@)(@@) % رأى هنات فنهى % % غير مطاع وأمر % 36(@)(@@) % قال فرد صاغرا % % أغزل مع الكبر % 37(@)(@@) % وأيما علاقة % بين الغرام والعمر % 38(@)(@@) % وأين إطراب النفو % % س مع أصابيغ الشعر % 39(@)(@@) % رب شباب ليله % يصبح تنعاه الأزر % 40(@)(@@) % وشيب رأس ذنبه % في 
ms265	 الحظوات مغتفر % PageV01P793 41(@)(@@) % حلفت بالشعث الوفو % % د زمرا على زمر % 42(@)(@@) % يرون ظلما باردا % بلثم ذلك الحجر % 43(@)(@@) % ومن دعا ومن سعى % % واستن سبعا وجمر % 44(@)(@@) % وسوقهم مثل الحصو % % ن مردت إلا المذر % 45(@)(@@) % توامكا ممطورة % أعشابها وقت المطر % 46(@)(@@) % جاءوا بها مجتهدي % % ن تفتلى وتختبر % 47(@)(@@) % لكل مهد نسكه % أنفس ما ليه نحر % 48(@)(@@) % أن بني عبد الرحي % % م نعم كنز المدخر % 49(@)(@@) % وخير من سدت به % يوم الملمات الثغر % 50(@)(@@) % المطعمون الهبر وال % % عام عبوس مقشعر % PageV01P794 51(@)(@@) % وصبية الحي تدا % % ري الإبل عن فضل الجزر % 52(@)(@@) % والريح لا تلوى بأك % % سار البيوت والجدر % 53(@)(@@) % وتحسب الفائز من % % ها ملقم البطن الحجر % 54(@)(@@) % والمانعين الجار لو % % زحزح عنهم لم يجر % 55(@)(@@) % حتى يعز فيهم % عز تميم في مضر % 56(@)(@@) % من بعد ما صاح به ال % % موت استمت فلا وزر % 57(@)(@@) % والواهبون بسط الر % زق عليهم أو قدر % 58(@)(@@) % لا يحسبون معطيا % أعطى إذا لم يفتقر % 59(@)(@@) % لهم حياض الجود وال % % سودد فعما وغزر % 60(@)(@@) % تخلى لهم جماتها % % وبعد للناس السؤر % PageV01P795 61(@)(@@) % أبناء مجد نقلو % % ه أثرا بعد أثر % 62(@)(@@) % رواية يسندها % % باقيهم عمن غبر % 63(@)(@@) % ينصر عنها القول بال % % فعل فيسلم الخبر % 64(@)(@@) % طابوا حياة مثلما % % طابوا عظاما وحفر % 65(@)(@@) % تساهموا أفق العلا % % تساهم الشهب الزهر % 66(@)(@@) % كأنهم في أوجه ال % % دنيا البهيمات غرر % 67(@)(@@) % فانتظموا نظم القنا % % إلا الوصوم والخور % 68(@)(@@) % من هبة الله إلى % % سابور فخر مستمر % 69(@)(@@) % قس خبري عنهم إلى % % أبي المعالي واعتبر % 70(@)(@@) % تر العروق الزاكيا % % ت من شفافات الثمر % PageV01P796 71(@)(@@) % المشترى الحمد الربيح % لايبالي ما خسر % 72(@)(@@) % والطلق حتى ما تبي % % ن عسرة من اليسر % 73(@)(@@) % تكرع من أخلاقه % في سلسل عذب الغدر % 74(@)(@@) % لم يبق راووق الصبا % % قذى به ولا كدر % 75(@)(@@) % ثم فحلت أربعي % % ين عشرة من العمر % 76(@)(@@) % وفات أحلام الكهو % % ل وهو في سن الغمر % 77(@)(@@) % وأبصر اليوم غدا % فلم يرد إلا صدر % 78(@)(@@) % لا ضامه الخوف ولا % % أطغاه 
ms266	 في الأمن البطر % 79(@)(@@) % على نداه باعث % من نفسه لا يقتسر % 80(@)(@@) % إذا أحس فترة % لج عليها ونفر % PageV01P797 81(@)(@@) % لا يخلف الظن ولا % % يلقى الحقوق بالعذر % 82(@)(@@) % علقت من ودك بال % % مستحصف المثنى المرر % 83(@)(@@) % أملس لا تسحله % بالغدر كف المنتسر % 84(@)(@@) % وكنت من حيث اقترح % % ت وأبي قوم أخر % 85(@)(@@) % تعطي على الحفة ما % % يعطون والضرع درر % 86(@)(@@) % والخير من مالك لي % % وإن وفى وإن كثر % 87(@)(@@) % محبة ما فوزت % نفسي منها في غرر % 88(@)(@@) % فما أطير بأخ % محلقا ما لم تطر % 89(@)(@@) % ولا ينزى كبدي % % إذا وصلت من هجر % 90(@)(@@) % فابق على وغر الحسو % % د نجوة من الغير % PageV01P798 91(@)(@@) % ترعاك عين الله لي % % من شر أعين البشر % 92(@)(@@) % ما ذيل النيروز في % % ثوب الرياض وخطر % 93(@)(@@) % وكر عام مقبل % وابق إلى أن لا يكر % 94(@)(@@) % واسمع لها تهدي إلى ال % % عرض الغنى وهي فقر % 95(@)(@@) % تضوع في الناس بها % % نوافج لسن السرر % 96(@)(@@) % سلمت الريح لها % % شرط الرواح والبكر % 97(@)(@@) % كما تمطت بالخزا % % مى لك أرواح السحر % 98(@)(@@) % قهي بكم معقولة % وهي شرود لا تقر % 99(@)(@@) % إذا بنات شاعر % أنثن أو كن عقر % 100(@)(@@) % فكل بنت ولدت % في مدحكم مني ذكر % PageV01P799 101(@)(@@) % ترى حسودي حاضرا % ينشد وهو يحتضر % 102(@)(@@) % تعجيله عن نفسه % سابقة أمر القدر % 103(@)(@@) % يصغي لها ووده % لو كان من قبل وقر % PageV01P800 البحر : - 1(@)(@@) % تمد بالآذان والمناخر % لحاجر ومن لها بحاجر % 2(@)(@@) % تغرها منه أحاديث الصبا % % ولا معات في السحاب الباكر % 3(@)(@@) % وأعين موكلات بالحمى % % من مستقيم اللحظ أو مخازر % 4(@)(@@) % تود لو أن ثراه عوض % من دمعها يستاف بالمحاجر % 5(@)(@@) % أرض بها السابغ من ربيعها % % وشوقها المكنون في الضمائر % 6(@)(@@) % مشارب تخر تحت سوقها % % وعشب يضفو على المشافر % 7(@)(@@) % وحيث دبت وربت فصالها % % وبركت تفحص بالكراكر % 8(@)(@@) % وأمنت ساربة سروحها % % شلة كل مطارد مغاور % 9(@)(@@) % تمنعها سيوف بكر أن ترى % % بؤسا وتحميها رياح عامر % 10(@)(@@) % فهل لها وهل لمن تحمله % من عائف بحاجر أو زاجر 
ms267	 % PageV01P801 11(@)(@@) % سارت يمينا والغرام شأمة % ياسر بها يابن رواح ياسر % 12(@)(@@) % فإنها من حبها نجدا ترى % % بكثب الغور شفار الجازر % 13(@)(@@) % وبالحمى أفئدة من شجوها % % خالية سالمة الضمائر % 14(@)(@@) % وأعين تحسبها قريرة % نائمة عن أعين سواهر % 15(@)(@@) % يرمين كل ساهر بمزعج % وكل مجبور الحشا بكاسر % 16(@)(@@) % كفلهن السقم بقلوبنا % % فكل قلب في ضمان ناظر % 17(@)(@@) % ياليت شعري والمنى تعلة % هل بمنى لعهدنا من ذاكر % 18(@)(@@) % أم هل على بعد النوى إلى التي % % لها الهوى من راكب مخاطر % 19(@)(@@) % لعله يحمل من سلامنا % % نخبة زاد الرجل المسافر % 20(@)(@@) % ألوكة خفت ومن ورائها % % بلابل تعقر بالأباعر % PageV01P802 21(@)(@@) % إذا رأيت الشمس في أترابها % % فاحبس وقل عني غير صاغر % 22(@)(@@) % الله يا ذات اللمى في أدمع % قوائر وأدمع فواتر % 23(@)(@@) % وفي عهود كتبها مبلولة % وهي لديك في النسي الداثر % 24(@)(@@) % فإن من دينكم في يعرب % أن تأنفوا من الذمام الفاجر % 25(@)(@@) % وفي الضيوف الغرباء عندكم % قلب يضام ماله من ناصر % 26(@)(@@) % فقربوا صحبته واحتفظوا % % فيه بحق البائع المهاجر % 27(@)(@@) % إما قرى النادي الكريم أو فر % % دوه على أربابه بالخاطر % 28(@)(@@) % أكل كف ظفرت لئيمة % وكل عقد في بنان غادر % 29(@)(@@) % من لك بالناس ولا ناس هم % إلا كلام المحرج المكاشر % 30(@)(@@) % نفسك صن ليس أخوك غيرها % % فقالل الناس ولا تكاثر % PageV01P803 31(@)(@@) % واعلم بأن عزها قنوعها % % برزقها الميسور في المعاسر % 32(@)(@@) % وإن وصلت أو سألت فأخا % صح على التجريب والمخابر % 33(@)(@@) % أخا ترى لوجهه قبل الجدا % % أسرة تلقاك بالبشائر % 34(@)(@@) % مثل ابن أيوب وأين مثله % مثل للأشباه والنظائر % 35(@)(@@) % من طينة المجد التي فروعها % % تنبيك عن طهارة العناصر % 36(@)(@@) % الطيبين أنفسا باقية % وأرمسا في ظلم الحفائر % 37(@)(@@) % يدلك المجد على الأوائل ال % % ماضين منهم بعلا الأواخر % 38(@)(@@) % داسوا ثرى المجد القديم ومشوا % % خطرا على خد الزمان الغابر % 39(@)(@@) % وأنطقوا بالخرس من أقلامهم % ألسنة الدسوت والمنابر % 40(@)(@@) % كل كريم لاسمه في مجدها % % مالأسانيد الحديث السائر % PageV01P804 41(@)(@@) % ولابنه من بعده ما يرث ال % % شبول في الغاب عن 
ms268	 القساور % 42(@)(@@) % شهادة صدقها محمد % صدق الربى عن الغمام الماطر % 43(@)(@@) % قام فأدى ثم مر زائدا % % تجاوز الذراع شبر الشابر % 44(@)(@@) % قضى له قاضي السماح والندى % % يوم تحور حجة المفاخر % 45(@)(@@) % قضية شقت على الهضبة من % رضوى وأزرت بالفرات الزاخر % 46(@)(@@) % رأى الكمال حلة فاحتلها % % وربعها مقو بغير عامر % 47(@)(@@) % ونهض الفضل له في مزلق % مسنم يكسر بالعوابر % 48(@)(@@) % جرى ففات والعلا من خلفه % تقول قاصر من خطاك قاصر % 49(@)(@@) % حتى أرانا العجز في قولهم % طالب شأو المجد غير ظافر % 50(@)(@@) % لله أنت من جمال ظاهر % وخلق صافي الغدير طاهر % PageV01P805 51(@)(@@) % وعدة ليوم لا يغني أخا ال % % حاجة إلا أنفس الذخائر % 52(@)(@@) % عهد كملموم الصفاة متعب % جانبها لن يبتغى لفاطر % 53(@)(@@) % وخلة لا يهتدي لنقضها % % على الزمان ناقض المرائر % 54(@)(@@) % أحرزمن كنت وراء ظهره % حصنا له من جولة الدوائر % 55(@)(@@) % يحسدك الناس وأي عاجز % لم تدوه شقاوة بقادر % 56(@)(@@) % وإنني مع بغض كل حاسد % أقضي لحسادك بالمعاذر % 57(@)(@@) % يفديك كل ساكت مدامج % بغلة وبائح مظاهر % 58(@)(@@) % وشامت إن رفعت لعينه % صيفية من السحاب العابر % 59(@)(@@) % جهامة يفتح فاه نحوها % % يحسبها جهلا من المواطر % 60(@)(@@) % يسره العاجل من أظلالها % % وهي غدا مهتوكة الستائر % PageV01P806 61(@)(@@) % وربما عادت بذي حواصب % عليه واجتاحت وذي صراصر % 62(@)(@@) % كمن جنى البغي على أمثاله % من غامط نعماء كم وكافر % 63(@)(@@) % وأنتم في معزل من شرها % % وجانب من النجاء وافر % 64(@)(@@) % عوائد لله فيكم ضمنت % لم الشتيتوجبور الكاسر % 65(@)(@@) % كم مثلها قد غلط الدهر بها % % ثمت لاذ منكم بغافر % 66(@)(@@) % دجت ولكن أقشعت عنء أنفس % سواكن وأعين قرائر % 67(@)(@@) % وكم تعيفت لكم سفورها % % من قبل أن يبرز وجه السافر % 68(@)(@@) % فلم تكذب فيكم زاجرتي % % قط ولا خيب يمن طائري % % 69(@)(@@) % فانتظروها ويدي رهن بها % % فربما كانت كرجع الناظر % 70(@)(@@) % بك استجاب الدهر لي ودعوتي % % تجول من حول سمع واقر % PageV01P807 71(@)(@@) % وأبصر الحظ الطريق فاهتدى % % إلي وهو أبله البصائر % 72(@)(@@) % حصنت وجهي وحقنت ماءه % فليس مذ حقنته بقاطر % 73 
ms269	(@)(@@) % ولم تدع لي منذ أولدت المنى % % مشقة إلى لقاح العاقر % 74(@)(@@) % كم أرب كنت إليه سببي % % فتلته بمحصد المرائر % 75(@)(@@) % وخلة أعضلني شفاؤها % % شفيتني من دائها المخامر % 76(@)(@@) % ملكتني ملك الوفاء بيد % تطلب بعضي فتحوز سائري % % 77(@)(@@) % فصار يرضيني بما ترضاه لي % % منذ عرفت نافعي من ضائري % % 78(@)(@@) % فلا تخف فيك الليالي جانبي % % بقاصد السهم ولا بغائر % 79(@)(@@) % ولا يزل عزك لي ذخيرة % لأول من عيشتي وآخر % 80(@)(@@) % مالاح صبح بضحى أضاء لي % % وشوق الوارد ري الصادر % PageV01P808 81(@)(@@) % وحسر النيروز من قناعه % طلعته على الربيع الناضر % 82(@)(@@) % وزاركم يرفل في وشائع % من حلل الروض وفي حبائر % 83(@)(@@) % بكل عذراء لها في خدرها % % صرامة ما للهصور الخادر % 84(@)(@@) % حاطمة تنحى على معاشر % وتحفة تهدى إلى معاشر % 85(@)(@@) % إقذاعها على عداكم ولكم % منها يد الراضي ولفظ الشاكر % 86(@)(@@) % تطرب للحادي إذا غنى بها % % فيكم وتستقصر ليل السامر % 87(@)(@@) % كأنهم لم يسمعوا من قبلكم % في ماجد مقالة من شاعر % PageV01P809 البحر : - 1(@)(@@) % ألا يا خليلي المجتبى من خزيمة % هل أنت أمين إن أمنت على سري % % 2(@)(@@) % وهل أنت عني إن أمنت مبلغ % ألوكة عتب ضاق عن حملها صدري % % 3(@)(@@) % نشدتك بالشعث الدوافع من منى % خلاطا كما خبرت عن ليلة القدر % 4(@)(@@) % وبالأسود الملثوم قد ضغطوا به % جنوبهم والمشعرين وبالحجر % 5(@)(@@) % أكنت بسمعى أو أظنك سامعا % % بأعجب من ابيات قومك في أمري % % 6(@)(@@) % يغار على الأموال في كل حلة % وفتيان عوف قد أغاروا على شعري % % 7(@)(@@) % سلائب لي منهوبة في رحالهم % ينادين بالخيبات من حلق الأسر % 8(@)(@@) % مطارح للركبان يقتسمونها % % تناقلها الأفواه مصرا إلى مصر % 9(@)(@@) % يغنى بها الحادي ويشدو لشربهم % بها المطرب الشادي ويثنى بها المطري % % 10(@)(@@) % كرائم قد أهديتهن تبرعا % لكل فتى لم يرع لي حرمة الصهر % PageV01P810 11(@)(@@) % هم خطبوها راغبين وسودوا % % عليها نفيسات من البذل والوفر % 12(@)(@@) % وكانت على قوم ملوك سواهم % تكون مع الجوزاء أو عنق النسر % 13(@)(@@) % ممنعة أن تستباح بخدعة % ووعد بروق وتساق على قسر % 14(@)(@@) % فلما غدت مجنوبة 
ms270	 في حبالهم % تواصوا عليها بالخيانة والغدر % 15(@)(@@) % كأنهم شلوا بها سرح مهمل % نفاه الرعاة بين بابل والعقر % 16(@)(@@) % فعرج علليهم ثم قل لمفرج % % أترغب في مدحي وتزهد في شكري % % 17(@)(@@) % أترضى بأن أضوى وكفك مخصب % عشيب وأطوى من يديك على النحر % 18(@)(@@) % وتظلم آمالي عليك ومطلبي % % ووجهك من تحت اللثام أخو البدر % 19(@)(@@) % وقد سارت الأخبار أنك خيرهم % قرى يوم يبكي الضيف من عضة القر % 20(@)(@@) % وأعقرهم للبزل والعام أشهب % وأوسعهم خطا لأثفيةالقدر % PageV01P811 21(@)(@@) % تجود فتعطي في الغنى قدرة الغني % % وتجبر أكسار الفقير على الفقر % 22(@)(@@) % فما بال بكر حرة بعثت بها % % إليك القوافي من عوان ومن بكر % 23(@)(@@) % شغفت بها ثم أنصرفت ملالة % بوجهك فيها عن جزائي وعن ذكري % % 24(@)(@@) % وأمهرتموها وارتجعتم صداقها % % فهل تستحلون النكاح بلا مهر % 25(@)(@@) % فأين السماح المزيدي وما ابتنى % % أبوكم وبقي من علاء ومن فخر % 26(@)(@@) % وما لم تزالوا تنفقون على العلا % % وتعطون من مال ومن نعم دثر % 27(@)(@@) % أعيذكم من أن يقال عليكم % ثوى معه جود الجماعة في القبر % 28(@)(@@) % وحاشاكم من أن تخيس بضائعي % % لديكم بما تنمي البضائع للتجر % 29(@)(@@) % وقد ملأت فيكم أوابدي الملا % % وسارت حداء العيس أو طعم السفر % 30(@)(@@) % وعندي فيكم ما يسوء عداكم % ويبقي لكم ما سركم آخر الدهر % PageV01P812 31(@)(@@) % فإن تقتنوها بالجميل بنت لكم % حصونا على الأحساب من أنفس الذخر % 32(@)(@@) % وإن تغصبوها تمس في غير حيكم % تشكى اضطرارا أو تكلم عن عذر % 33(@)(@@) % أيا نجم عوف يا مفرج كربها % % أما آن لي أن يخجل المطل من صبري % % 34(@)(@@) % حملت التقاضي عنكم مهلة لكم % فأنظرتكم في العسر فاقضوا مع اليسر % 35(@)(@@) % وقل يا رسولي مبلغا سفراءهم % جميعا وخص العبدري أبا نصر % 36(@)(@@) % أفي الحق أن سومت بيني وبينكم % خيول الأماني ثم تقعد عن نصري % % 37(@)(@@) % وأغريتني حتى إذا ما ولجتها % % تأخرت عني والعقاب على المغري % % 38(@)(@@) % أما تذكر العهد الذي كان بيننا % % بلى تتناساه وأنت على ذكر % 39(@)(@@) % تنامون عن حقي وتلغون مدحتي % % وأنتم حملتم ثقل ذاك 
ms271	 على ظهري % % 40(@)(@@) % فقم يا أبا نصر قيام ابن حرة % بنصر صديق أنت أوقعته حر % PageV01P813 41(@)(@@) % وعد برسولي يحمل الغرم وافرا % وفز بثنائي فهو أسنى من الوفر % 42(@)(@@) % وقل للأمير ابن الأمير نصيحة % تربص بخيري واحترس من أذى شري % % PageV01P814 البحر : - 1(@)(@@) % هون بالليل عليها الغررا % % أن العلا مقيدات بالسرى % % 2(@)(@@) % فركبت بسوقها رءوسها % % حتى تخيلنا الحجول الغررا % % 3(@)(@@) % تحسبها عجرفة وورها % فيما ترى خابطة ليست ترى % % 4(@)(@@) % تنضى النهار شملة جونية % وتلبس الليل رداء أخضرا % % 5(@)(@@) % ترى بما تجهض من سخالها % % لحما مضيغا ودماء هدرا % % 6(@)(@@) % علمها النوم على رباطها % % ذليلة أن تستطيب السهرا % % 7(@)(@@) % كل ابن ذات أربع تحسبه % ذات جناحين إذا تمطرا % % 8(@)(@@) % ينتشر الأرض فلا يردعه % % كيف طواها عنقا أو حضرا % % 9(@)(@@) % يرى الظلام بشهابي قابس % لا يستميحان النجوم خبرا % % 10(@)(@@) % تكارها شمس الضحى وأقسما % % على الدجى لا يصحبان القمرا % % PageV01P815 11(@)(@@) % إن غاب شخص مقلتيه أبصرت % أذناه هل خبرت سمعا بصرا % % 12(@)(@@) % يلهب قرع السوط منه مرجلا % يجيش صدرا ويجيش منخرا % % 13(@)(@@) % يعطي الشكيم ساءه أو سره % لحيا أبيا أو عذارا أصعرا % % 14(@)(@@) % يظما فلا يشرع مسبوقا على % % صافية ولو تكون الكوثرا % % 15(@)(@@) % عاف البقايا أنه منتتج % في معشر لا يشربون السؤرا % % 16(@)(@@) % يأنف من ماء الزكي أنه % في الأرض أو تسقي السماء المطرا % % 17(@)(@@) % كالنجم في نهاره وليله % إما ارتفاعا سار أو منحدرا % % 18(@)(@@) % ذلك دأب ربه ودأبه % ما استقدما فشاورا التأخرا % % 19(@)(@@) % إذا أصابا وطرا من العلا % % فذاك أو فيبلغان العذرا % % 20(@)(@@) % لله مفطور على سودده % إذا رأى العجز غمارا شمرا % % PageV01P816 21(@)(@@) % يصرف عن بيت الهوان وجهه % وإن ضفت أفياؤه وخضرا % % 22(@)(@@) % يريه صدر اليوم ما في غده % رأي إذا الرأي أصر أبصرا % % 23(@)(@@) % يأوي إلى بديهة في عزمه % تطلعه قبل الورود الصدرا % % 24(@)(@@) % تنصره الوثبة في أوانها % % إذا الهوينى خانت المنتظرا % % 25(@)(@@) % لا يعلق الأعداء في أتباعه % بعينه فيعظمون الأثرا % % 26(@)(@@) % وكل من قصر عن عدوه % أعظمه ضرورة لا خيرا % % 27(@)(@@) % كالليث يقلى وهو 
ms272	 يطرى أو كما % % نافق أعداء وزير الوزرا % % 28(@)(@@) % قادحهم ففازهم أروع ما % % قامر في العلياء إلا قمرا % % 29(@)(@@) % مقلب جانبه وحظه % من السعود سفرا أو حضرا % % 30(@)(@@) % تواصت الأقدار أن تمضي على % % تدبيره جارية كما جرى % % PageV01P817 31(@)(@@) % وغيره والنقص حظ غيره % إن أحمد الآراء ذم القدرا % % 32(@)(@@) % عض العدا أظافرا من بعده % تدمى ولم ترزق عليها الظفرا % % 33(@)(@@) % ولم يكن من شرف الدين لمن % يندم إلا أن يعض الحجرا % % 34(@)(@@) % ولا لدار فاتها ودولة % منه سوى أن أقويا وأقفرا % % 35(@)(@@) % أبصرها بلهاء جاهلية % ذات فسوق لا تخاف النذرا % % 36(@)(@@) % مجنونة الوداد إما عاهدت % لم يك إلا الغدر والتغيرا % % 37(@)(@@) % أشهى خليليها إليها خلة % من كان أدمى همة وأحقرا % % 38(@)(@@) % تكيل بالجور إذا ناصفها % % وتنبذ العرف تراه منكرا % % 39(@)(@@) % نافرة من ذي اليمين إذا % % قودها حتى تطيع الأبترا % % 40(@)(@@) % فردها بالعتب رد ناقد % غالط فيها النفس حتى استبصرا % % PageV01P818 41(@)(@@) % ألقى على غاربها حبالها % % من بعد ما متعها وأمهرا % % 42(@)(@@) % على أوان شوهت وعنست % وسلبت جمالها والخفرا % % 43(@)(@@) % تناحلوها شرها وزاحموا % % عجزا شفير جرفها المهورا % % 44(@)(@@) % فطرفوا منها بشلو ميت % وأكثروا فيه الجدال والمرا % % 45(@)(@@) % مر وولاهم رزايا سرحها % % يدبرون منه أمرا مدبرا % % 46(@)(@@) % يا ليت شعر الملك من عذيره % بعدك مما جر عجز السفرا % % 47(@)(@@) % ودولة أسلمها عميدها % % كيف يظن كسرها أن يجبرا % % 48(@)(@@) % وهل لها أن تستوي قائمة % ما لم تجدك الناعم المقدرا % % 49(@)(@@) % وكيف يرجى عند ذؤبان الغضا % % في الغيل أن تحمي حمى أسد الشرى % % 50(@)(@@) % خطوتها مستقدما أمامها % % لما رأيت خطوها إلى ورا % % PageV01P819 51(@)(@@) % نجاك منها أن ترى مهتصرا % بغمرة حاشاك أو مقتسرا % % 52(@)(@@) % يد علت عن أن يكون فوقها % % يد ونفس لا تطيع الأمرا % % 53(@)(@@) % ونخوة سيماء فارسية % شماء لا تعطى الخزام منخرا % % 54(@)(@@) % أفدتها كفاية جامعة % منها وظلا فوقها منتشرا % % 55(@)(@@) % فهي إذا ذكرت مع خطابها % % تقول كل الصيد في جوف الفرا % % 56(@)(@@) % غدا تلظى تشتكي أوامها % % إلى الفرات وهي تسقى الكدرا % % 57(@)(@@) % واضعة جبينها لموسم 
ms273	 الذ % ل وخديها جميعا للثرى % % 58(@)(@@) % قد غمز الأغمار في صعدتها % % فهي تداعى خطلا وخورا % % 59(@)(@@) % حتى تلوذ تستغيث ربها % % منك وترجو ذنبها أن يغفرا % % 60(@)(@@) % ويأخذ الدهر بناصيتها % % سوقا فيأتيك بها معتذرا % % PageV01P820 61(@)(@@) % قد أدبته لكم جهلاته % فيكم وإن جرب قوما أخرا % % 62(@)(@@) % جريا على العادة في استصراخه % بعفوكم إذا هفا أو عثرا % % 63(@)(@@) % فاستقبلوا منها مريرا قد حلا % % لمجتنيكم وسقيما قد برا % % 64(@)(@@) % أصلحتم ببعدكم فسادها % % والجرح لا يدمل حتى يسبرا % % 65(@)(@@) % وكل محبوب إذا الوصل طغى % % يوما به فظنه أن يهجرا % % 66(@)(@@) % وزارة كم قد قدحت زندها % % فيكم وكم قمت بها مبشرا % % 67(@)(@@) % فلم تكذب قط لي عائفة % فيها ولا خيب فأل زجرا % % 68(@)(@@) % قد ثبت المعجز لي في صدقها % % من طول ما صح وتكررا % % 69(@)(@@) % كالوحي لو أني خلقت ملكا % طرت به لكن خلقت بشرا % % 70(@)(@@) % فانتظروها إنما ميعادها % % غد ويا قرب غد منتظرا % % PageV01P821 71(@)(@@) % فعندها يبرد حر أضلع % يوقد شوقي بينهن شررا % % 72(@)(@@) % وعندها يحلو بعيني وفمي % % ما قد أمر الماء عذبا والكرى % % 73(@)(@@) % ويكمد الحاسد والشامت بي % % بفرط ما قد أكلاني أشرا % % 74(@)(@@) % كاشفني بعدكم بغله % من كان يخشى جانبي مستترا % % 75(@)(@@) % وكل جبس يده ووجهه % من حجر يلقم مني حجرا % % 76(@)(@@) % واجه بالعصيان في أمركم % والدهر لا يعصيكم لو أمرا % % 77(@)(@@) % كنت له ذريعة إليكم % وكنتم بالعلج مني أبصرا % % 78(@)(@@) % فجنبوني عفوكم عنه غدا % أكن لكم منه ولي منتصرا % % 79(@)(@@) % يا عشب أرضي وسماء روضتي % % ودار أمني يوم أرعى الحذرا % % 80(@)(@@) % ومن إذا عري من ظلهم % ظهري فقد ألقيت شلوا بالعرا % % PageV01P822 81(@)(@@) % قد أكلتنا بعدكم فاغرة % أنيابها قبل العضاض جزرا % % 82(@)(@@) % لم يتأس بنتاج إذا أتت % ضيف ولم توقد لها نار القرى % % 83(@)(@@) % تعترق العظم كما تسترط الل % % حم وجلت أن تحص الوبرا % % 84(@)(@@) % فنظرا وإن نأت داركم % وأرشدوا لمن يقول نظرا % % 85(@)(@@) % يا فرحة يوم أرى رايتكم % تلاوذ الريح تؤم العسكرا % % 86(@)(@@) % ونشر أيديكم وأعراضكم % بالزاب يلقاني وشاطى عكبرا % % 87(@)(@@) % والأمر فيكم 
ms274	 ؛ لا يطاع لقب % زور ولا يراقب اسم مفترى % % 88(@)(@@) % لا غرو إن كفيتها مستوزرا % % بالأمس أن تكفيها مؤمرا % % 89(@)(@@) % آملها وكيف لا يأمل أن % يراك شمسا من رآك قمرا % % 90(@)(@@) % أنا الذي لو سجد النجم لكم % ما كنت مرتابا ولا مستنكرا % % PageV01P823 91(@)(@@) % ولو مسحتم زحلا ببوعكم % رجوت بعد لعلاكم مظهرا % % 92(@)(@@) % أقذيت أبصار العدا بمدحكم % فساوروني أحوصا وأخزرا % % 93(@)(@@) % ولم أراع فيكم تقية % من كبد غيظت وصدر أوغرا % % 94(@)(@@) % على سبيلي في موالاتكم % أمر فردا لا أخاف الخطرا % % 95(@)(@@) % وقاطنات سائرات معكم % تتبعكم محلة وسفرا % % 96(@)(@@) % تشتاق منكم عامري أوطانها % % ومن ثوت فيهم فقضت عمرا % % 97(@)(@@) % لا تعدمون رسمها مرددا % عليكم وقسمها موفرا % % 98(@)(@@) % ماكر يوم المهرجان وطرا % وصام ذو شهادة وأفطرا % % 99(@)(@@) % قلت فأغضبت الملوك فيكم % وأنتم بي تغضبون الشعرا % % PageV01P824 البحر : - 1(@)(@@) % أدمعك أم عارض ممطر % أم النفس ذائبة تقطر % 2(@)(@@) % دعوا بالرحيل فمستذهل % أضل البكاء ومستعبر % 3(@)(@@) % وقالوا الوداع على رامة % فقلت لهم رامة المحشر % 4(@)(@@) % وأرسلت عيني بالأنعمين % لتبصر لو أنها تبصر % 5(@)(@@) % فما حملت خبرا يستطا % % ب إلا الذي كذب الخبر % 6(@)(@@) % وعنفني منذر خاليا % % ألفت وفورقت يا منذر % 7(@)(@@) % وقالوا تحمل ولو ساعة % فقلت لهم مدتي أقصر % 8(@)(@@) % ولكن تطالل بعين النصيح % لعلك مستشرفا تنظر % 9(@)(@@) % أجنب الغضا يقبلون الركا % % ب أم عرعرا قال بل عرعر % 10(@)(@@) % فلا تذكرون لقلبي السلو % إن كان ذاك كما يذكر % PageV01P825 11(@)(@@) % سقى الله ما كرمت مزنة % وما وضعت حامل معصر % 12(@)(@@) % وحنت فدرت على أرضها % % سماء تبوح بما تضمر % 13(@)(@@) % ملاعبنا بالحمى والز % ن أعمى وليل الصبا مقمر % 14(@)(@@) % وعصر البطالة مثل الربيع % حيا أبيض وثرى أخضر % 15(@)(@@) % وظبية جار إذا شاء زا % % ر لا تستريب ولا تحذر % 16(@)(@@) % إذا لذت اليوم عنا انطوت % وثقنا بأخرى غدا تنشر % 17(@)(@@) % وفي الحي كل هلالية % هلال السماء بها يكفر % 18(@)(@@) % تذل على عزها للهوى % % وتسبى وأنصارها حضر % 19(@)(@@) % تسيل الأسنة من دونها % % ونحن على سرها نظهر % 20(@)(@@) % فذاك وهذا لو أن 
ms275	 الزمان % إناء إذا راق لا يكدر % PageV01P826 21(@)(@@) % تلون في صبغ أيامه % تلون ما نسجت عبقر % 22(@)(@@) % فيوم تعرفه غفلة % ويوم تجنبه منكر % 23(@)(@@) % يجد ويبلى فطورا غريب % وطورا يسد الذي يعور % 24(@)(@@) % وحاجة نفس سفير الرجا % % ء يورد فيها ولا يصدر % 25(@)(@@) % تكون شجى دون أن تنقضي % % وباب القضاء بها أعسر % 26(@)(@@) % بردت لساني أن أشتكي % % أذاها وصدري بها يزفر % 27(@)(@@) % وعهد رعيت وذي ملة % وصلت من الحق ما يهجر % 28(@)(@@) % أردت بقيته فانعطفت % عليه وجانبه أزور % 29(@)(@@) % سها فتناسى حقوقي علي % % ه وهو على سهوه يذكر % 30(@)(@@) % أبالحق تهدمني بالجفاء % وأقطار عرضك بي تعمر % PageV01P827 31(@)(@@) % وتشرب ظلمي مستعذبا % وظلمي ممر الجنا ممقر % 32(@)(@@) % سأضرب عنك صدور المطي % وفي الأرض مغنى ومستمطر % 33(@)(@@) % نوازع تقمح ورد الهوان % % فتطمح تسهل أو توعر % 34(@)(@@) % وأن لها في رجال الحفاظ % مرادا إلى مثله تزجر % 35(@)(@@) % وفوق ثنايا العلا أعين % يهش إليها ويستبشر % 36(@)(@@) % وفي جو عجل إذا أعتمت % وضلت نجوم هدى تزهر % 37(@)(@@) % وأفنية تقبض الوافدين % إذا رفعت بينهم كبروا % % 38(@)(@@) % يفيء لهم ظلها بالهجير % وتأرج طيبا إذا أسحروا % % 39(@)(@@) % متى ترد الماء بالزابيين % وترعى صريفين أو تعبر % 40(@)(@@) % تخض في جميم يعم السنام % % وينصفه العنق المسفر % PageV01P828 41(@)(@@) % وتكرع منبسطات الرقا % % ب لا يرد الناس أو تصدر % 42(@)(@@) % ولراكبيها القرى والحمى % % ورفد يطيب كما يكثر % 43(@)(@@) % ومعقورة واجبات الجنوب % صفايا وفهاقة تهدر % 44(@)(@@) % فزاحم بها الليل حتى تكون % لها الصادعات له الفجر % 45(@)(@@) % مواقر بالحاج تبطن حي % % ث تطرح أثقالها الأظهر % 46(@)(@@) % فلا يعطفنك عن همة % هممت بها بارح يزجر % 47(@)(@@) % فلا الجد يدفعه أعضب % ولا الحظ يصرفه أعور % 48(@)(@@) % ولا أنت رام بها جانبا % يشط ولا نية تشطر % 49(@)(@@) % وعند أبي القاسم المكرما % % ت تنمي وأغصانها تزهر % 50(@)(@@) % كريم يرى أنه بالملا % % م يقذع أو بالغنى يفقر % PageV01P829 51(@)(@@) % إذا استأثر الله بالمنفسات % من المال فهو بها مؤثر % 52(@)(@@) % يهين الحياة بحب الفناء % وكفاه في حسب يغمر % 53(@)(@@) % ويعطى عطاء ابن عيسى ابنه 
ms276	 % وما بين بحريهما أبحر % 54(@)(@@) % فهذا يجود على فقره % وذاك على جوده موسر % 55(@)(@@) % ففي الضيم عنه فؤاد أصم % إذا قطر الصخر لا يقطر % 56(@)(@@) % وأنف يجيش به منخراه % % إذا سد في آخر منخر % 57(@)(@@) % ونفس إذا العيش كان اثنتين % % علا تقتنى وغنى يؤثر % 58(@)(@@) % مضت في سبيل الأشق الأعز % ولم يصبها الأروح الأصغر % 59(@)(@@) % ويوم من الدم ساعاته % قميص النهر به أحمر % 60(@)(@@) % تبطنه خائضا نقعه % يقلص عن ساقه المئزر % PageV01P830 61(@)(@@) % حمية من لا تنام الترا % % ت خلف حشاه ولا تهدر % 62(@)(@@) % وضوضاء قطر بالمفحمي % % ن ظهر مطيتها الأزعر % 63(@)(@@) % تخلصها فمه فانجلت % كمافارق الصدف الجوهر % 64(@)(@@) % فوتر مضاع به يستقاد % وفضل مذار به ينصر % 65(@)(@@) % إذا قال فاعقد خيوط التميم % % عليك فألفاظه تسحر % 66(@)(@@) % ويا تارك الخمر لا تأته % فإن خلائقه تسكر % 67(@)(@@) % يريك بظاهره غادة % تزم حياء وتستخفر % 68(@)(@@) % وفي فهمه لك نضناضة % خدور وفي درعه قسور % 69(@)(@@) % تعطر من طيبه المجد عنه % وعن قومه الأطيب الأطهر % 70(@)(@@) % ملوك قديمهم كالحديث % % وبالفرع يعرف ما العنصر % PageV01P831 71(@)(@@) % وما أخلفوا أن يحلي الزما % % ن منهم أمير ومستوزر % 72(@)(@@) % وقاض ينفذ أحكامه % إذا أمر الناس لا يؤمر % 73(@)(@@) % هم لعشيرتهم كالسما % % ء كل الذي تحتها يصغر % 74(@)(@@) % لهم كأس نشوتها بالعشي % وخيل الصباح إذا استذعروا % % 75(@)(@@) % وفيهم مرابعها والصف % % ي والقدح إن علي الميسر % 76(@)(@@) % وما سار من ذكرها في السماح % % فهم ريشوه وهم طيروا % % 77(@)(@@) % مضوا سلف المجد واستعمروا % % ديار العلا سعى من أخروا % % 78(@)(@@) % وقد علموا بابنهم يوم را % % ش أن رمائمهم تنشر % 79(@)(@@) % وما هبة الله إلا المدا % % م من مثل كرمهم تعصر % 80(@)(@@) % فلا عصم سوددهم بالقنا % % يحل ولا عودهم يقشر % PageV01P832 81(@)(@@) % ومنتحل سمة الفاضلي % % ن والفضل من شكله ينفر % 82(@)(@@) % تقلد فيما ادعى غيره % هوى وهو في اللؤم مستبصر % 83(@)(@@) % رآك كملت فظن الكمال % لكل فتى رامه يقدر % 84(@)(@@) % ولم يدر أن الحجا متعب % ولا أن حب العلا مفقر % 85(@)(@@) % حلت نومة العجز في عينه 
ms277	 % فلم يدر ما فضل من يسهر % 86(@)(@@) % لك الخير فاسمع فإن الحدي % % ث يقتص ثم له منشر % 87(@)(@@) % يهب شرارا ويمشي على الس % روح فتلهب أو تسعر % 88(@)(@@) % ولا ترعني سمع خالي الضلو % % ع مما أجن وما أظهر % 89(@)(@@) % فغيرك من لا أبالي بما % % شكوت أيسمع أو يوقر % 90(@)(@@) % وغير حياضك مالاأحوم % عليه ولو أنه الكوثر % PageV01P833 91(@)(@@) % إلام تحرم شعري بكم % يضيع وذمته تخفر % 92(@)(@@) % ويمطل ديني ودين الوفا % % ء تاركه عندكم يكفر % 93(@)(@@) % وللمطل والصبر وقت يحد % فكم تمطلون وكم أصبر % 94(@)(@@) % ألم تعلموا أنني ما بقي % % ت أنظركم ثم لا أنظر % 95(@)(@@) % أذم زماني وبي حاجة % إلى القول شاهدها يحضر % 96(@)(@@) % وأرسل من رسن الإقتضاء % أوانا أعرض أو أذكر % 97(@)(@@) % فلا بالشكاية مما أبو % % ح أحظى ولا بالذي أستر % 98(@)(@@) % وقد كنت أشكو وأيامكم % جعاد وعامكم أغبر % 99(@)(@@) % وأعذر والخال فيما أرو % % م عن قدر همتكم تقصر % 100(@)(@@) % فكيف وقد أمطرت أرضكم % وأفعم واديكم أعذر % PageV01P834 101(@)(@@) % وأمر البلاد ورزق العباد % % إليكم وعن مثلكم يصدر % 102(@)(@@) % قدرتم فمنوا فكم ليلة % سهرت إلى الله أن تقدروا % % 103(@)(@@) % فما في الحمية أن يمنع ال % % ملىء وذو حقه معسر % 104(@)(@@) % دعوناكم من وراء التي % % لسان البليغ بها يحصر % 105(@)(@@) % وعن خلة باطن داؤها % % تجمل بالصمت أو تستر % 106(@)(@@) % مكحلة خشن مسها % % إلى أكلنا فمها يغفر % 107(@)(@@) % يعز على المجد والمكرما % % ت أنا بأنيابها نعقر % 108(@)(@@) % ونحن من الدهر بل منكم % بما سد خلتنا أجدر % 109(@)(@@) % شموس ببغداد منكم تضيء % % ونحن بأقسامنا نعثر % 110(@)(@@) % وبالجزع فالمنحنى من دجيل % سحاب على غيرنا يهمر % PageV01P835 111(@)(@@) % ونحن نظن بأيامكم % % كما ظن بالثمر المؤبر % 112(@)(@@) % فهل فيكم وبلى فيكم % فتى يصرخ الفضل أو ينصر % 113(@)(@@) % فيذكر من حقنا ما نسي % % ومثل أواصرنا يذكر % PageV01P836 البحر : - 1(@)(@@) % رق لبغداد القضاء والقدر % وعطف الدهر عليها وأمر % 2(@)(@@) % وامتعض المجد لها من طول ما % % حاق بها الضيم فثار وانتصر % 3(@)(@@) % وضحك المزن إلى ربوعها % % والعام قد قطب فيها وكشر % 4(@)(@@) % فهي 
ms278	 ومن يحمله ترابها % % عازبة راحت ومنهاض جبر % 5(@)(@@) % عاد الحيا إلى الثرى فربه % وفتق الصبح الظلام ففجر % 6(@)(@@) % ونطقت خرس العلا فأبصرت % عمياؤها وسمعت وهي وقر % 7(@)(@@) % فليهنها ما أثمر الصبر لها % % والصبر في إمراره حلو الثمر % 8(@)(@@) % قصرك يا خابطة الليل بنا % % لا بد لليل الطويل من سحر % 9(@)(@@) % تنفسي مبصرة وانفرجي % % فطالما غم دجاك واعتكر % 10(@)(@@) % هذا الوزير وأخوه فأسفري % % قد ردت الشمس عليك والقمر % PageV01P837 11(@)(@@) % نجمان ما غابا لسعي ماجد % في الأفق إلا طلعا مع الظفر % 12(@)(@@) % وجاريان سابق بنفسه % إلى المدى ولاحق على الأثر % 13(@)(@@) % تشابها والكف مثل أختها % % والزند مثل الزند مرخا وعشر % 14(@)(@@) % متى تطل من شرف الدين يد % تجد كمال الملك عن أخرى حسر % 15(@)(@@) % كلتا اليمنين قياس للعلا % % ذا ذرع الأفق بها وذا شبر % 16(@)(@@) % ومن ير ذا وردا وذاك قربا % له يقل ذا العشب من ذاك المطر % 17(@)(@@) % دوحة مجد صعبت عيدانها % % على العدا أن تختلى وتهتصر % 18(@)(@@) % سقى الندى عبد الرحيم ساقها % % وحاط أيوب عليها وحظر % 19(@)(@@) % وحملت مثقلة فأثمرت % مذكرة فولدت كل ذكر % 20(@)(@@) % قوم أقاموا الدهر وهو عاثر % حتى مشى يختال عنهم وخطر % PageV01P838 21(@)(@@) % وأدركوا أيامهم بهيمة % مغفلة شياتها حص الشعر % 22(@)(@@) % فاعتلقوا جباهها وسوقها % % وطلعوا من الحجول والغرر % 23(@)(@@) % كل غلام إن عفا وإن سطا % % أمن بين الخافقين أو ذعر % 24(@)(@@) % أروع لا تجري الخطوب إن نهى % % خوفا ولا يقضي القضاء إن أمر % 25(@)(@@) % نال السماء مدرجا في قمطه % وفات كل قارح وما اثغر % 26(@)(@@) % لم يأخذ السودد حظا غلطا % ولا العلا مغتصبا أو مقتسر % 27(@)(@@) % ما سار في كتيبة إلا حمى % % وما متطى وسادة إلا وزر % 28(@)(@@) % قد صدع الله بكم معجزة % في الأرض ليست في محلات البشر % 29(@)(@@) % فأرشد المستبصرين بكم % لو كان يغني القلب أو يغني البصر % 30(@)(@@) % وأعلم الملك المدار أنه % بغير قطب منكم لا يستقر % PageV01P839 31(@)(@@) % وأنه حبل وليتم فتله % فكيفما أبرمه الناس انتسر % 32(@)(@@) % أما كفاه إن كفاه واعظ % بيان ما 
ms279	 جرب منكم واختبر % 33(@)(@@) % وكيف لمت وهي في أيديكم % طينته وانحل في أيد أخر % 34(@)(@@) % كم غار من بعد الغرور مدة % بغيركم أما يغار من يغر % 35(@)(@@) % بلى على ذاك قد بان له % فرقان ما بين الرجال فظهر % 36(@)(@@) % ونصحته نفسه لنفسه % فشاور الحزم وأحسن النظر % 37(@)(@@) % فقابلوا هفوته بحلمكم % فمثلكم إن كان ذنب من غفر % 38(@)(@@) % واستدركوا بسعيكم حفيظة % من أمره ما شعب العجز وجر % 39(@)(@@) % فهو الذي در على إيمانكم % قدما له خلف الصلاح وغزر % 40(@)(@@) % وإن غنيتم لغنى أنفسكم % عن رغبة فهو إليكم مفتقر % PageV01P840 41(@)(@@) % إن العراق اليوم أنتم قطبه % لولاكم مدبرين لم يدر % 42(@)(@@) % قد حبست عليكم سروجه % من غاب في حماتكم ومن حضر % 43(@)(@@) % أنتم غذا ضيم سيوف نصره % وأنتم ربيعه إذا اقشعر % 44(@)(@@) % إذا قربتم ضحكت عراصه % وابيض وجه العدل فيها وسفر % 45(@)(@@) % وإن نأيتم كان في انتظاركم % كأنكم فيه الإمام المنتظر % 46(@)(@@) % فعالجوا أدواءه بطبكم % قد حفر الجرح الذي كان عقر % 47(@)(@@) % لم يبق إلا رمق فابتدروا % % إمساكه والغوث إن لم يبتدر % 48(@)(@@) % يا قاتل الجدب انتصر وقد بغى % % بعدك عام المحل فينا وفجر % 49(@)(@@) % كم تمطر الشهباء عنك بالحيا % % قد صرحت كحل وصابت بقر % 50(@)(@@) % أمدد بيمناك على مجد عفا % % خصبا وجدد رسم جود قد دثر % PageV01P841 51(@)(@@) % أقدم على السعد إلى الصدر الذي % % أوحشته فانهض بورد وصدر % 52(@)(@@) % واضف على الدولة ظلا سابغا % تسحبه سحبك هداب الأزر % 53(@)(@@) % دع كبد الغيظ على أعدائها % % ودع لأوليائها حز الأشر % 54(@)(@@) % قد أكلت أكفها نواجد % يوم لك الأمر استقام واستقر % 55(@)(@@) % ودويت بما أشرت وطوت % أفئدة بك بالسوء تأتمر % 56(@)(@@) % منهم فربعوا من ظلع % على رضا باد وسخط مستتر % 57(@)(@@) % فلا يزل وأنت حي خالد % نأيهم حتى يسدون الحفر % 58(@)(@@) % ولا تنل ملكك إلا شللا % يد الزمان وتصاريف الغير % 59(@)(@@) % اذكر وصف كيف ترى بشائري % % في مجدكم إن الكريم من ذكر % 60(@)(@@) % حدث بآياتي وقل بمعجزي % % وخبري عن كل غيب مستتر % PageV01P842 61(@)(@@) % هذا الذي جرت 
ms280	 به عيافتي % % لكم وطيري ذو اليمين إذ زجر % 62(@)(@@) % وكيف لا تصدق فيكم نذري % % وأن في مديحكم أبو النذر % 63(@)(@@) % ومدد العيشة لي من فضلكم % وحظكم حظي من خير وشر % 64(@)(@@) % قد عرق الزمان لحمي بعدكم % ببعدكم وأحرق العظم وذر % 65(@)(@@) % ولم يدع لي غمزه جارحة % إلا وفيها غمز ناب وظفر % 66(@)(@@) % تنبذني في حبكم نواظر % وألسن منبذة النضو المعر % 67(@)(@@) % أرجو نداهم ضلة وعطفهم % كما رجت قحطان ودا في مضر % 68(@)(@@) % أرجع عن زيارتي في يسرهم % إلى محل عامر من العسر % 69(@)(@@) % فافتقدوا شلوا لكم بقاؤه % ومنكم إن فات أو مر يمر % 70(@)(@@) % لسانكم وكل من ينطقكم % سواه معقول اللسان أو مجر % PageV01P843 71(@)(@@) % قد بلغ المفصل مني جازري % % فالله في أن يحز ماجزر % 72(@)(@@) % لم تبق في بعدكم بقية % يرجى لها رفد غد وينتظر % 73(@)(@@) % فاقضوا ديون جودكم في خلتي % % فقد قضى شعري فيكم ما نذر % PageV01P844 البحر : - 1(@)(@@) % الليل فالأرض لليث الشرى % % عرس يبغي راحة أو سرى % % 2(@)(@@) % فتارة مفترشا غابة % وتارة مفترسا مصحرا % % 3(@)(@@) % والظفر الحلو له إن عفا % % عمدا وإن نيب أو ظفرا % % 4(@)(@@) % مر على هزة ألباده % يكبر أن يؤمر أو يزجرا % % 5(@)(@@) % يرى من العزة في نفسه % مالم يكن ما حض نصح يرى % % 6(@)(@@) % أغلب لم يخلق ركوب المطا % % سهلا ولم يقصر لخزم البرى % % 7(@)(@@) % فما تريد اليد من مقود % يرجع عنها باعها أبترا % % 8(@)(@@) % لله رام سهمه رأيه % إذا رأى شاكلة فكرا % % 9(@)(@@) % يطيع من عزمته مقدما % ما غلس النهضة أو بكرا % % 10(@)(@@) % تنصره الوثبة من أن يرى % % مستصرخ الخلسة مستنصرا % % PageV01P845 11(@)(@@) % لا تجذب الأوطان منه ولا % % يخدعه للضيم طيب الكرى % % 12(@)(@@) % يأنس بالنعمة ما ساندت % جنبا منسيعا وحمى أعسرا % % 13(@)(@@) % فإن مشت في جوها ذلة % رابك مذعورا ومستنفرا % % 14(@)(@@) % ليم على غشمته فاتك % هلا ارتأى فيها وهلا امترى % % 15(@)(@@) % وقيل لو علل مستأمنا % والداء إن موطل يوما سرى % % 16(@)(@@) % وكم جنى الريث على حازم % فود لو قدم ما أخرا % % 17(@)(@@) % يا فارس الغراء 