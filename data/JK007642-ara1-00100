ms81	(@)(@@) % إصلاحهم أعيا العقول لأنهم % % خلقت مفاسدهم لغير صلاح % % 20(@)(@@) % من كل مرتكب الشنيع ولم يكد % % يثنيه عنه اذا لهاه اللاحي % % PageV01P260 21(@)(@@) % أهدي بطرق المخزيات من القطا % % واضل ممن آمنوا بسجاح % % PageV01P261 البحر : وافر تام 1(@)(@@) % ذكرت ولست في الذكرى بناس % % ليالي بتهن مبيت حاس % % 2(@)(@@) % بناد تزدهيك به انتظاما % مقابلة الاسرة بالكراسى % % 3(@)(@@) % به اجتمعت غطارفة كرام % % أبوا شيم التخالف والشماس % % 4(@)(@@) % يطوف عليهم رشأ رخيم % % يغازل مقلتيه فم النعاس % % 5(@)(@@) % براح فيك تبتعث ارتياحا % وتنسف طود همك وهو راس % % 6(@)(@@) % يشب لمزجها بالماء وقد % تكاد تهم منه إلى اقتباس % % 7(@)(@@) % تميت هموم شاربها سرورا % % فتدفنهن في حفر التناسى % % 8(@)(@@) % وصاح وجه الندماء كأسا % إليه فقال لست لها بحاس % % 9(@)(@@) % وغالى في الآباء فما رسوه % % فلان أبيه بعد المراس % % 10(@)(@@) % فقال وقد مشت فيه ودبت % % دبيب الماء في ورق الغراس % % PageV01P262 11(@)(@@) % لعمرك ان الصهباء معنى % % دقيقا ليس يعرف بالقياس % % PageV01P263 البحر : وافر تام 1(@)(@@) % كأن الشمس باخرة مخور % % تجد السير في بحر الفضاء % % 2(@)(@@) % ستغرق بعد حين باصطدام % % يمزق جرمها أو بانطفاء % % PageV01P264 البحر : كامل تام 1(@)(@@) % الدهر بين في كتاب شهادة % بالنور فوق جبينه مكتوب % 2(@)(@@) % إن السماحة والشجاعة والعلى % % جمعت لعمري في أبي عبعوب % % 3(@)(@@) % شهم تولع بالعطاء بنانه % % مثل الرياح تولعت بهبوب % % 4(@)(@@) % اسد نمته لآل قيس في لبعلى % % آباء مجد ليس بالمكذوب % % 5(@)(@@) % ورث المكارم عن أبيه ولم يزل % % يسمو بصارم عزمه المرهوب % % 6(@)(@@) % ما زال يوقد كل يوم في الورى % % نارين نار قرى ونار حروب % % 7(@)(@@) % يهدي جموع المدلجين لسيبه % % في الليل ضوء لهيبها المشبوب % % 8(@)(@@) % خلقت من الحسب الصميم اكفه % % لعنان سابقة وكشف كروب % % 9(@)(@@) % حمدت وقائعه السيوف بكفه % % والخيل كل مطهم يعبوب % % 10(@)(@@) % إن شن فوق ظهورهن إغارة % % ترك العدو بلوعة المحروب % % PageV01P265 11(@)(@@) % يلقي الفوارس والسكينة درعه % % ويخوض غمر الموت غير هيوب % % 12(@)(@@) % فخر الكرام على المكارم والندى % % قامت دعائم بيته المضروب % % 13(@)(@@) % للجود مغلوبا تراه ولم يكن % % للجيش في الغزوات بالمغلوب % % 14(@)(@@) % يتفقد الأضياف ملء 
ms82	 دياره % % عند الصباح وعند كل غروب % % 15(@)(@@) % كالعبد يخضع للضيوف وانه % % في القوم أكبر سيد معصوب % % 16(@)(@@) % عم الارامل واليتامى سيبه % % فغدت تعيش بماله الموهوب % % 17(@)(@@) % خلق الكريم ابن الكرام محمد % % لسرور محزون وجبر قلوب % % 18(@)(@@) % تالله لو كان الكرام بلاغة % % كان الكريم المعجز الاسلوب % % PageV01P266 البحر : وافر تام 1(@)(@@) % أقم في الأرض صرحا من ضياء % % بحيث يمس كرسي السماء % 2(@)(@@) % وبعد فجسم العرفان شخصا % % تردى المجد فضفاض الرداء % % 3(@)(@@) % وفي يسراه ضع لوح المعالي % % وما وفي الثناء عليك مئن % % 4(@)(@@) % وأجلسه على الكرسي يمحو % % ويثبت ما يشاء من العلاء % % 5(@)(@@) % وقف وارفع اليه الطرف وانظر % % 6(@)(@@) % ألا يا كعبة الفضلاء يا من % % فضائله عظمن بلا انتهاء % % 7(@)(@@) % أهم بأن أحيط بهن وصفا % % ومن لي بالإحاطة بالفضاء % % 8(@)(@@) % وأقدم أن أتم علاك مدحا % فيرجعني علاك إلى الوراء % % 9(@)(@@) % وما وفى الثناء عليك مثن % لأنك فوق توفية الثناء % % 10(@)(@@) % وما اتقدت ذكاء بما يداني % % ذكاءك يا امام الاذكياء % % PageV01P267 11(@)(@@) % ولو كانت أشعتها تحاكي % % شعاعك ماانكسرن من الهواء % % 12(@)(@@) % بفكرك دوحة العرفان تنمو % % كذا الادواح تنمو بالضياء % % 13(@)(@@) % واقسم لو تكون من الذراري % % لكنت الشمس في كبد السماء % % 14(@)(@@) % ولولا الصبح يطلع كل يوم % % لقلت الصبح انت بلا مراء % % PageV01P268 البحر : بسيط تام 1(@)(@@) % اليك ما شاهدت عيني من العجب % % في مسرح ماح بين الجد واللعب % 2(@)(@@) % خافوا به أن تقوم الأسد واثبة % % حتى بنوا حاجزا فيه من الخشب % % 3(@)(@@) % وحصنوه من الاعلى بمشتبك % % من الحبال جديل غير منقضب % % 4(@)(@@) % به الأسود تمطى في مرابضها % % والنمر يخطر بين الخوف والغضب % % 5(@)(@@) % والذئب يبصر جدى المعز مقتربا % منه فيرجع عنه غير مقترب % % 6(@)(@@) % اما الكلاب فجاءت وهي كاسية % % يرقصن منتصبا في إثر منتصب % % 7(@)(@@) % قامت على أرجل تمشي معلمة % % مشي المليحة في ابرادها القشب % % 8(@)(@@) % تخشى مؤدبها والصولجان له % % في الكف فرقعة كالرعد في السحب % % 9(@)(@@) % ترنو إليه بعين الخوف فاعلة % % ما كان يصدر من أمر ومن طلب % % 10(@)(@@) % خضعن للسوط حتى إن أعقدها % % لو 
ms83	 يأمر السوط يغدو مرسل الذنب % % PageV01P269 11(@)(@@) % وكانت الاسد تجرى في اطاعتها % % مجرى الكلاب بحكم الخوف والرهب % % 12(@)(@@) % كأنما الليث لم يخلق أخا ظفر % % محدد الناب قذافا إلى العطب % % 13(@)(@@) % شاهدته مشهدا بدعا علمت به % % أن الغرائز لم تطبع على الشغب % % 14(@)(@@) % وان ليث البرايا الشرى ما صيغ مفترسا % لكن احالته فراسا يد السغب % % 15(@)(@@) % وكم من الناس من راح مندفعا % بدافع الجوع نحو القتل والسلب % % 16(@)(@@) % وان تربية الانسان يرجعه % % اكسيرها وهو من ترب إلى الذهب % % 17(@)(@@) % هذا إذا حسنت أما إذا قبحت % % فالمندلي بها يمسي من الحطب % % 18(@)(@@) % فكل ما هو في الانسان مكتسب % % فلا تقل شئ غير مكتسب % % 19(@)(@@) % انى ارى اسوأ الآباء تربية % % للابن أحرى بأن يدعى أعق أب % % 20(@)(@@) % والمرء كالنبت ينمو حسب تربته % % وليس ينبت نبع منبت الغرب % % PageV01P270 21(@)(@@) % من عاش في الوسط الزاكي زكا خلقا % حتى علا في المعالى ارفع الرتب % % 22(@)(@@) % فاحرص على أدب تحيا النفوس به % % فانما قيمة الانسان بالادب % % PageV01P271 البحر : طويل 1(@)(@@) % ترى مقلتي ما ليس تملكه يدي % % وما زلت اسعى منفض الكف محوجا % % 2(@)(@@) % ارى باب رزقي من بعيد مفتحا % فآتية ولاجا فألفيه مرتجا % % 3(@)(@@) % وأيأس احيانا وارجو فلم اكن % % لأملك من شيء سوى اليأس والرجا % % PageV01P272 البحر : طويل 1(@)(@@) % أرى عيشنا تأبى المنون امتداده % % كأنا على كيس المنون نعيش % % 2(@)(@@) % وما زال وجه الأرض يوسعه الردى % % لطاما وهاتيك القبور خدوش % % 3(@)(@@) % كأن انقلاب الأرض ماء كأننا % % على الماء من ريح الحياة نقوش % % 4(@)(@@) % لحا الله دنيا كل يوم بأهلها % % تهد حصون اوتثل عروش % % 5(@)(@@) % تروح سهام العيش فيها طوائشا % وللموت سهم لا يكاد يطيش % % 6(@)(@@) % نمد إلى قطف المنى وهي جمة % % من العمر كفا لا تكاد تنوش % % 7(@)(@@) % ونرجو ومن سيف الردى في رجائنا % % جراحات بأس مالهن أروش % % 8(@)(@@) % وأجمل بوجه العيش لو لم يكن به % % حنانيك من ظفر الخطوب مريش % % 9(@)(@@) % لعمرك ان الدهر تغلي خطوبه % % وان عويل الصارخين نشيش % % 10(@)(@@) % وما الدهر الا للخلائق منضج % % له مرجل بالحادثات 
ms84	 يجيش % % PageV01P273 11(@)(@@) % كأن جيوش الموت رافقة بنا % % نجيف بأدواء الحياة مريش % % 12(@)(@@) % ومن نظر الدنيا بعين اعتباره % % تساوت مهود عنده ونعوش % % PageV01P274 البحر : وافر تام 1(@)(@@) % كأن حياتنا جبل مطل % % على مهواته وهي الممات % % 2(@)(@@) % مشينا فوقه عميا فظلت % % تهاوى نحو هوته المشاة % % 3(@)(@@) % كأن فضاء هذا الكون مجر % % تموج فيه هذي الكائنات % % 4(@)(@@) % تبين تارة وتغيب اخرى % % فشأناها التفرق والشتات % % PageV01P275 البحر : كامل تام 1(@)(@@) % رقت بوصف جمالك الاقوال % % ورأتك فافتتنتبك العذال % % 2(@)(@@) % وهب الآله بك الجمال تجملا % حتى كأنك للجمال جمال % % 3(@)(@@) % كل العيون إذا برزت شواخص % % كيما تراك وغضهن محال % % 4(@)(@@) % وإذا الخلي رآك عاد بمهجة % للوجد مخترق بها ومجال % 5(@)(@@) % كم قد سفرت ففي القلوب قوله % % لما رأوك وفي العقول خيال % % 6(@)(@@) % فرموك بالأبصار وهي كليلة % % من نور وجهك نورهن مذال % % 7(@)(@@) % ربطوا الأكف على ضلوع تحتها % % بين النواظر والقلوب جدال % % 8(@)(@@) % لو كنت في ايام يوسف لم تكن % % بجمال يوسف تضرب الامثال % % 9(@)(@@) % ولطعت دون الأكف قلوبها % % شوقا إليك مع النساء رجال % % 10(@)(@@) % كم قد يجور على جفونك سقمها % % كسرا وتجهد خصرك الأكفال % % PageV01P276 11(@)(@@) % عجبا لطرفك رهو أضعف ما أرى % % يرنو فترهب فتكه الأبطال % % PageV01P277 البحر : بسيط تام 1(@)(@@) % قامت تميس بأعطاف وأوراك % رقصا على نغمات المقول الحاكي % % 2(@)(@@) % حوراء جاءت وكل في مسرته % % لاه وراحت وكل طرفه باك % % 3(@)(@@) % شكوت من خصرها ضعفا وقلت لها % % مليكة الحسن هل عطف على الشاكي % % 5(@)(@@) % فاستضحكت وهي تجني الورد قائلة % ما احسن الورد قلت الورد خالك % % 6(@)(@@) % وقلت : أهوى فقالت بالدلال : ومن % % تهوى ؟ فقلت لها إياك إياك % % 7(@)(@@) % واستحلفتني على قلبي فقلت لها : % يهواك إي وجلال الحسن يهواك % % 8(@)(@@) % سحر بعينيك يستهوي القوب وما % % ينفك في هتك عباد ونساك % % 9(@)(@@) % ياربة الحسن هلا تعطفين على % % من بات سهران مشغولا بذكراك % % 10(@)(@@) % ما أطيب العيش في الدنيا لو اتصلت % % أسباب دنياي مع أسباب دنياك % % 11(@)(@@) % الحسن يفتن والألحاظ فاتكة % % واحيرتى بين فتان وفتاك % % PageV01P278 12(@)(@@) % تهفو بقلبي اشواقي فامسكه % % لما أراك وهل 
ms85	 يشفيه إمساكي % % 13(@)(@@) % إني وعندي بكنه الحسن معرفة % % ما راقني قط من شئ كمرآك % % 14(@)(@@) % أمسى غرامك يجري في عروق دمي % % كالكهرباء التي تجري بأسلاك % % PageV01P279 البحر : متقارب تام 1(@)(@@) % تصور حدائق في بهجة % % ترة ق وفي نضرة تعجب % % 2(@)(@@) % ترقرق فيها مياه العلوم % جداول تجري ولا تنضب % % 3(@)(@@) % وهب عليها نسيم الفنون % % يروح ويغدو بها يلعب % % 4(@)(@@) % فأضحت وأرض كمالاتها % % بنبت الحقائق تعشوشب % % 5(@)(@@) % وأمست وإن ثمار العلاء % % لأشجار عرفانها تنسب % % 6(@)(@@) % وطار الفخار بأرجائها % % بلابل تغريدها مطرب % % 7(@)(@@) % فللمجد وجه طليق بها % % 8(@)(@@) % غذاء النفوس وطب العقول % % وحفظ الجشوم بها يطلب % % 9(@)(@@) % فتلك اذا ما تصورتها % % جليا لعمري هي المكتب % % PageV01P280 البحر : طويل 1(@)(@@) % سيوف لحاظ أم قسي حواجب % % تريش إلى قلبي سهام المعاطب % 2(@)(@@) % ورب كعاب أقبلت في غلائل % % وقد لاح لي منها حلي الترائب % % 3(@)(@@) % لها جيد ظبى واعتدال وشيحة % % وعين مهاة وائتلاق الكواكب % % 4(@)(@@) % ولا عيب فيها غير أن أولى الهوى % % ينادونها في الحسن بنت العجائب % % 5(@)(@@) % نضت عن محياها النقاب عشية % % فاسفر صبح الحسن من كل جانب % % 6(@)(@@) % ومذ نشرب سود الذوائب أولجت % % نهار محياها بليل الذوائب % % 7(@)(@@) % تناسب فيها الحسن حتى رأيتها % % تفوق الدمى في حسن ذاك التناسب % % 8(@)(@@) % مفترة الاجفان تدمى بلحظها % % قلوب أسود مدميات الكتائب % % 9(@)(@@) % فلم انسها والله يوم تعرضت % % لنا بين هاتيك الظباء السوارب % % 10(@)(@@) % وما كنت أدري ما الصبابة قبلها % % ولا همت يوما في الحسان الكواعب % % PageV01P281 11(@)(@@) % فأصبحت فيها ذا غرام ولوعة % % ووجد وتهيام وهم مواظب % % 12(@)(@@) % وما الصبر إلا غائب غير حاضر % % وما الشوق إلا حاضر غير غائب % % PageV01P282 البحر : طويل 1(@)(@@) % تحر إذا صادقت من رده محض % % يصان لديه المال والدين والعرض % % 2(@)(@@) % فكل خليل منئ عن خليله % % كما عن شئون القلب قد انبأ النبض % % 3(@)(@@) % وبالصدق عامل من تحب من الورى % % والا فذاك الحب آخره بغض % % 4(@)(@@) % وسامح صديقا قد أساء بفعله % % ثلاثا عسى عن ذلك الفعل ينفض % % 5(@)(@@) % وبعد ثلاث دعه غير مسامح % % فرفض الذي دامت إساءته 
ms86	 فرض % % 6(@)(@@) % وقو اساس الود بالصدق فالذي % % على جرف هار يؤسس ينقض % % 7(@)(@@) % وإن ومضت للخل منك سحابة % % فلا يك منها خلبا ذلك الومض % % PageV01P283 البحر : وافر تام 1(@)(@@) % نهيتك عن هواك فما انتهيت % ولكن قد فعلت كما اشتهيت % 2(@)(@@) % فيا نفسي عن الشهوات كفي % فأنت عليك يا نفسي جنيت % 3(@)(@@) % وما امارة بالسوء يوما % سعت في المنكرات كما سعيت % % 4(@)(@@) % إذا ما حلبة الحسنات جاءت % % رأيتك أنت صاحبة السكيت % % 5(@)(@@) % فان اسدى الآله عليك عفوا % والا يا فجار فقد هويت % % PageV01P284 البحر : بسيط تام 1(@)(@@) % وصاحب قد دعانا ان نلم به % % مستأنسين بضرب العود والوتر % % 2(@)(@@) % في ليلة كان فيها الحر متقدا % % ترمي جهنمه الاجسام بالشرر % % 3(@)(@@) % وكان ذلك في دار يضيق بها % % صدر الأغار يدمن ضيق ومن صغر % % 4(@)(@@) % كأنها مفحص تأوى القطاة له % % أو حجر ضب بارض صلبة الحجر % % 5(@)(@@) % فما عهدت طروبا قبل زورتها % % تلقاه من نغمات العود في ضجر % % 6(@)(@@) % ومطربات الأغاني وهي واقعة % % في غير موقعها ضرب من الكدر % % PageV01P285 البحر : طويل 1(@)(@@) % إلى كم تصب الدمع عيني وتسكب % % وحتام نار البين في القلب تلهب % 2(@)(@@) % أبيت ولي وجد يشب ضرامه % % ودمع له في عارضي تصبب % % 3(@)(@@) % وهل لمشوق خانه الصبر عنكم % % سوى دمعه فهو الدواء المجرب % % 4(@)(@@) % ألا إن يوما جرد البين سيفه % % على به يوم شديد عصبصب % % 5(@)(@@) % فياليت شعري هل أفوز برؤيتي % % محيا له كل المحاسن تنسب % % 6(@)(@@) % وعينيك لا أسلوك أو يصبح السها % % وشمس الضحى في ضوئه تتحجب % % 7(@)(@@) % فإني كما شاء الهوى بك مغرم % % وانت كما شاء الجمال محبب % % 8(@)(@@) % وأذكركم للشمس عند طلوعها % % ويعزب عني الصبر أيان تغرب % % 8(@)(@@) % احن إلى رؤياكم كلما سرى % % نسيم وأبكي كلما لاح كوكب % % 9(@)(@@) % لقد بان صبري يوم ببنيك إذ قضى % % به صرف دهر لم يزل يتقلب % % PageV01P286 10(@)(@@) % تبصر خليلي في الزمان فهل ترى % % صفا فيه من وقع الشوائب يتحلب % % PageV01P287 البحر : بسيط تام 1(@)(@@) % إياك والبصرة المضنى توطنها % % فلا تمرن فيها غير مظطعن % % 2(@)(@@) % لا 
ms87	 تعجبنك بالأشجار خضرتها % % حسنا فما هي الا خضرة الدمن % % 3(@)(@@) % ما ان اقام صحيح في مساكنها % % إلا وسافر عنه صحة البدن % 4(@)(@@) % ماء زعاق وجو قاتم وهوى % % نتن وشدة حر غير مؤتمن % % 5(@)(@@) % انظر تجد كل اهليها كأنهم % % من السقام استحقوا الدرج في الكفن % % 6(@)(@@) % صفر الوجوه قد امتصت دماءهم ال % % حمى وقد حرمتهم لذة الوسن % % PageV01P288 البحر : بسيط تام 1(@)(@@) % يلقى النزيل بوجه قد من حجر % % لولا العبوسة لم يفرق من الوثن % % 2(@)(@@) % أفيك يا غمر يلقى الشعر مأمله % % يا خيبة الشعر بل يا ضيعة اللسن % % 3(@)(@@) % مالي أراك على الكرسي منتفخا % إن كان فيك احتباس الريح فاحتقن % % PageV01P289 البحر : بسيط تام 1(@)(@@) % قد كاد بالحر هذا اليوم يصهرنا % % اذ قد بدا فيه للرمضاء تسعير % % 2(@)(@@) % كأنما الشمس جاعت فهي من سغب % % تشوي الجسوم لها والأرض تنور % % PageV01P290 البحر : كامل تام 1(@)(@@) % لله يوم جاء يلسع برده % % فكأن ذرات الهواء عقارب % 2(@)(@@) % لم تلق شيئا فيه ليس بجامد % % الا احتمال فيه فذائب % % PageV01P291 البحر : كامل تام 1(@)(@@) % انظر إلى تلك المعلقة التي % % سترت ظلام الليل بالأضواء % 2(@)(@@) % قطع من البلور محدقة بها % % يحكين شكل أصابع الحسناء % % 3(@)(@@) % فكأنها بدر تلألأ في الدجى % % وكأنهن كواكب الجوزاء % % 4(@)(@@) % بل قد يمثلها الخيال كأنها % % قمر احيط بهالة بيضاء % % PageV01P292 البحر : بسيط تام 1(@)(@@) % قد يطفح اللؤم حتى ان صاحبه % % ينسى الحياء فيغدو يدعي الكراما % % 2(@)(@@) % ان الجهالة ان كانت قذى بصر % % رأى الضلال هدى واستسمن الورما % % 3(@)(@@) % ما للغواة ارعواء عن غوايتهم % % إن لم يك السيف يعلو منهم القمما % % 4(@)(@@) % كم من أراذل أطغتها سفاهتها % % حتى ادعت وهي أذناب لها الشمما % % 5(@)(@@) % ان عدت الوحش ما كانت ولا بقرا % % أو عدت الطير ما كانت ولا رخما % % 6(@)(@@) % والناس كالناس في خلق وبينهم % في الخلق بون فذا أرض وذاك سما % % 7(@)(@@) % مثل الحديد وما امتازت حقيقته % % والقين يطبع منه السيف والجلما % % PageV01P293 البحر : طويل 1(@)(@@) % اعرني لسانا ايها الشعر للشكر % % وان تطق شكرا فلا كنت من شعر % % 2(@)(@@) % وجئني 
ms88	 بنور الشمس والبدر كي أرى % % بمعناك نور الشمس يشرق والبدر % % 3(@)(@@) % وحم حول أزهار الرياض تطيبا % % بها مثلما حام الفراش على الزهر % % 4(@)(@@) % وقم في مقام الشكر وانشر لواءه % برأس عمود خذه من غرة الفجر % % 5(@)(@@) % فإن لبيروت حقوقا جليلة % % على فنب يا شعر عني في الشكر % % 6(@)(@@) % فإني ببيروت أقمت لياليا % % وربك لم أحسب سواهن من عمري % % 7(@)(@@) % وقضيت أياما إذا ما ذكرتها % % غفرت الذنوب الماضيات من الدهر % % 8(@)(@@) % لئن تك في بغداد يا دهر مذنبا % على ففي بيروت كم لك من عذر % % 9(@)(@@) % قرأت بها درس المكارم معجبا % % بكل كبير النفس ذي خلق حر % % 10(@)(@@) % فكنت بها من باذخ العز في الذرى % % ومن سروات القوم في أنجم زهر % % PageV01P294 11(@)(@@) % وداعا وداعا ايها القوم انني % % مفارقكم لا عن صدود ولا هجر % % 12(@)(@@) % لئن ازف الترحال عنكم فان بي % % إليكم لأشواقا أحر من الجمر % % 13(@)(@@) % اودعكم والشوق بالصبر فاتك % % كفتك الملوك المستبدين بالأمر % % 14(@)(@@) % أحبكم قلبي اعترافا بفضلكم % % وانكر في يوم النوى حكمة الصبر % % 15(@)(@@) % ولا غرو ان اكرمتم الضيف شيمة % توارثتموها عن جدود لكم غر % % 16(@)(@@) % ألستم من العرب الألى طار صيتهم % % إلى حيث يبقى تحته طائر النسر % % 17(@)(@@) % اعاريب نهاضون في طلب العلى % % غطاريف سباقون في حلبة الفخر % % 18(@)(@@) % سأذكركم ذكر المحب حبيبه % % وأشكركم شكر الجدوب ندى القطر % % 19(@)(@@) % فلا تحرموني من رضاكم فإنني % % اليكم اليكم ما حييت لذو فقر % % PageV01P295 البحر : كامل تام 1(@)(@@) % اللؤم داء في النفوس عياء % % لم يشف منه سوى الحمام دواء % 2(@)(@@) % لو كان في الدأماء كل عيوبه % % بل بعضهن لأنتن الدأماء % % 3(@)(@@) % ولو أن في كرة الهوا طباعة % % فسدت فمات بنتنها الأحياء % % 4(@)(@@) % ألقت عليه يد الزمان مخازيا % % منها تلوح بوجهه الفحشاء % % 5(@)(@@) % وجه أقام الدهر فيه من الخنا % % سمة فعاد وليس فيه حياء % % 6(@)(@@) % يا ماشيا يختال في غلوائه(@)(@@) % أطرق كرى ) ما هذه الخيلاء % % 7(@)(@@) % هب غفلة الجهلاء عنك طويلة % % أفليس تعلم خزيك العقلاء % % PageV01P296 البحر : وافر تام 1(@)(@@) % تجنب من سقيم الرأي 
ms89	 قربا % ولا تغتر بالبدن الصحيح % % 2(@)(@@) % ولا ترض الصديق لحسن خلق % % إذا ما كان ذا خلق قبيح % % 3(@)(@@) % وذى سفه اكب على المخازى % % وما قبل النصيحة من نصيح % % 4(@)(@@) % زوج المخزيات لديه حتى % % تباع اليه بالثمن الربيح % % 5(@)(@@) % أطاف بغيه وأباح شتمي % % وكان الشتم أجدر بالمبيح % % 6(@)(@@) % وأغراه الضلال فكان مني % % كما كانم اليهود من المسيح % % 7(@)(@@) % فمت في نار غيظك مستشيطا % فلست من الهجاء بمستريح % % 8(@)(@@) % سأضرم فيك يا لكع الأهاجي % % كنيران تشب تجاه ريح % % 9(@)(@@) % تجمعت المخازى فيك حتى % % يعد الهجو فيك من المديح % % PageV01P297 البحر : وافر تام 1(@)(@@) % بدت في مسرح رحب البلاطبدت في مسرح رحب البلاط % بقضبان مشبكة محاط % 2(@)(@@) % فجالت من ضفائرها بتاج % % وماست غير ضافية الزياط % % 3(@)(@@) % ولا انسى تورد وجنتيها % % وقد برزي تميس على البساط % % 4(@)(@@) % فقلنا وهي تخطر في وقار % % مليك الحسن يخطر في البلاط % % 5(@)(@@) % وقد سجدت لها الأنظار لما % % أرتنا الحسر يرفل في القباطي % % 6(@)(@@) % وكبرنا المهمين حين راحت % % تصول على الضياغم بالسياط % % 7(@)(@@) % سقت أعصابنا خدرا وطارت % % مرفرفة باجنحة النشاط % % 8(@)(@@) % مشت مشى الحمامة فوق سلك % % تهول عليه أن تخطو الخواطي % % 9(@)(@@) % وبارت فوقه خفقان قلبي % % بحالتيارتفاع وانحطاط % % 10(@)(@@) % فخلناها وقد خلبت نهانا % % تعلمنا الجواز على الصراط % % PageV01P298 16(@)(@@) % % أرتنا الحسر يرفل في القباطي % % PageV01P299 
