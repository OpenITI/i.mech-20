ms7621	 على الهجرة ، قال : لا هجرة بعد الفتح ، ول اكن جهاد ونية ) ( ش ) . )(@)(@@)(@@)(@@) |||| 702 ( مسند يعلى بن مرة العامري رضي الله عنه )(@)(@@)(@@)(@@) $ 19025 عن يعلى بن مرة العامري رضي الله عنه قال :(@)(@@) | 30 ( جاء حسن وحسين رضي الله عنهما يسعيان إلى رسول الله فأخذ أحدهما فضمه إلى إبطه ، وأخذ الآخر فضمه إلى إبطه الآخر ، وقال : ه اذان ريحانتاي من الدنيا ، من أحبني فليحبهما ، ثم قال : الولد مبخلة مجبنة مجهلة ) ( كر ، وقال : الصواب يعلى بن مرة ابن شهاب ) ، ( كر ، والرامهرمزي في الأمثال ) . )(@)(@@)(@@)(@@) $ 19026 عن يعلى بن مرة رضي الله عنه قال :(@)(@@) | 30 ( خرجت مع رسول الله PageV21P256 إلى طعام دعوا له ، فإذا حسين مع الغلمان يلعب في الطريق ، فاسميل القوم ، ثم بسط يده ، فطفق الصبي يغدو ه اهنا مرة وه اهنا مرة ، وجعل رسول الله يضاحكه ، حتى أخذه رسول الله ، فجعل إحدى يديه تحت ذقنه ، والأخرى تحت قفاه ، ثم رفع رأسه ، فوضع فاه على فيه فقبله ، فقال : حسين مني وأنا من حسين ، أحب الله من أحب حسينا ، حسين سبط من الأسباط ) ( ش ) . )(@)(@@)(@@)(@@) $ 19027 عن يعلى بن مرة رضي الله عنه قال :(@)(@@) | 30 ( جاء الحسن والحسين رضي الله عنهما يسعيان إلى رسول الله ، فجاء أحدهما قبل الآخر ، فجعل يده في رقبته ، ثم ضمه إلى إبطه ، ثم جاء الآخر فجعل يده الأخرى في رقبته ، ثم ضمه إلى إبطه ، ثم قبل ه اذا ، ثم قبل ه اذا ، ثم قال : إني أحبهما فأحبهما ، ثم قال : أيها الناس إن الولد مبخلة مجبنة مجهلة ) ( كر ) . )(@)(@@)(@@)(@@) $ 19028 عن يعلى بن مرة العامري رضي الله عنه قال :(@)(@@) | 30 ( جاء حسن وحسين رضي الله عنه يسعيان إلى رسول الله ، فضمهما إليه وقال : إن الولد مبخلة مجبنة ) ( ش ، والرامهرمزي في الأمثال ) . )(@)(@@)(@@)(@@) |||| 703 ( يعلى بن الأشدق رضي الله عنه )(@)(@@) $(@)(@@)(@@)(@@) $ 19029 عن يعلى بن الأشدق رضي الله عنه قال :(@)(@@) | 30 ( أدركت عدة من أصحاب رسول الله ممن صدق على عهد رسول الله ، منهم رقاد بن ربيعة العقيلي ، قال : أخذ منا رسول الله من الغنم من 
ms7622	 المائة شاة ، فإن زادت فشاتان ) ( طب ) . )(@)(@@)(@@)(@@) $ 19030 عن يعلى بن الأشدق ، عن عمه عبد الله بن جراد رضي الله عنه قال :(@)(@@) | 30 ( قال لي رسول الله : كم إبلك ؟ قلت : ثلاثون قال : إن ثلاثين خير من PageV21P257 المائة ، قلت : إنا لنتحدث أن المائة أفضل وأطيب ، قال : هي مفرقة مفتنة ، وكل مفرح مفتن ) الرامهرزي في الأمثال . )(@)(@@)(@@)(@@) $ 19031 أخبرنا أبو بكر بن محمد بن الحسين بن علي ابن إبراهيم ، حدثنا القاضي أبو الحسين محمد بن علي بن محمد المهتدي ، حدثنا أبو الفتح يوسف بن عمرو بن مسرور القواس إملاء ، قال : قرىء على أبي العباس أحمد بن عيسى السكين البلدي وأنا أسمع ، قيل له : حدثكم هاشم يعني ابن القاسم الحراني ، حدثنا يعلى بن الأشدق ، عن عمه عبد الله بن جراد ، قال :(@)(@@) | 30 قال رسول الله : كم إبلك ؟ قال : قلت : ثلاثون ، قال : إن ثلاثين خير من مائة ، قلت : ي اا رسول الله إنا لنرى أن المائة أكثر من ثلاثين ، وهي أحب إلينا ، قال : إن ربها بها معجب ، وإنه لا يؤدي حقها ، إن المائة مفرحة مفتنة ، وكل مفرح مفتن ) ( كر ) . )(@)(@@)(@@)(@@) |||| 704 ( مسند يوسف بن عبد الله بن سلام رضي الله عنه )(@)(@@) $(@)(@@)(@@)(@@) $ 19032 عن عمرو بن عبد العزيز ، عن يوسف بن عبد الله بن سلام رضي الله عنه قال :(@)(@@) | 30 ( كان النبي إذا جلس يتحدث يكثر أن يرفع بصره إلى السماء ) ( ك ) . )(@)(@@)(@@)(@@) $ 19033 عن يوسف بن عبد الله بن سلام رضي الله عنه قال :(@)(@@) | 30 ( حدثتني خولة بنت مالك بن ثعلبة ، وكانت تحت أوس بن الصامت أخي عبادة بن الصامت أن رسول الله أعان زوجها حين ظاهر منها بفرق من تمر ، وأعانته هي بفرق آخر ، فذلك ستون صاعا ، قالت : ثم قال النبي : تصدق به ، وقال لها : ارجعي إلى ابن عمك واتقى الله فيه ) أبو نعيم . )(@)(@@)(@@)(@@) $ 19034 عن يوسف بن عبد الله بن سلام رضي الله عنه قال :(@)(@@) | 30 ( إن رجلا من أهل الشام نزل بيهودي من أهل يثرب ، فأنزله وأكرمه ، فقال الشامي : إني لا أدري PageV21P258 ما أجازيك بما 
ms7623	 صنعت إلي إلا أني أكرمك بحديث أحدثكه فاحفظه مني : إنه خارج بأرض العرب نبي ، فإن أدركته فاتبعه ، فإن أنت لم تفعل فليكن بينك وبينه ولث عهد ، قال : فلما خرج رسول الله ، جاء اليهودي إلى رسول الله ، فقال : إنك رسول الله ؟ فقال له رسول الله : فاتبعني ، فقال اليهودي : لا أدع ديني ول اكن لي ألف نخلة ، فلك منها مائة وسق أؤديه ، كل عام إليك وأنا آمن على أهلي ومالي ، فاكتب لي بذلك ، فكتب له رسول الله ، قال يوسف : فهو ذا : ما يؤخذ منه غيره حتى الساعة مائة وسق ، ما يزاد عليه ) ( كر ) . )(@)(@@)(@@)(@@) |||| 705 ( مسانيد رجال من الصحابة لم يسموا رضي الله عنهم )(@)(@@)(@@)(@@) $ 19035 عن رجل من جهينة قال :(@)(@@) | 30 ( قلت ي اا رسول الله متى أصلي العشاء ؟ قال : إذا ملأ الليل كل واد فصل ) ( ض ) . )(@)(@@)(@@)(@@) $ 19036 عن رجل من جهينة قال :(@)(@@) | 30 ( سألت رسول الله متى أصلي العشاء ؟ قال : إذا ملأ الليل بطن كل واد ) ( ش ) . )(@)(@@)(@@)(@@) $ 19037 - عن رجل من الأنصار : ' أن رجلا قال : ألا أريكم كيف كان وضوء | رسول الله صلى الله عليه وسلم ؟ قالوا : بلى ، فدعا بماء ، فمضمض ثلاثا ، واستنشق ثلاثا ، وغسل | وجهه ثلاثا ، وذراعيه ثلاثا ، ومسح برأسه ، وغسل قدميه ، ثم قال : واعلموا أن | الأذنين من الرأس ، ثم قال : تحريت أو توخيت لكم وضوء رسول الله صلى الله عليه وسلم ' ( ش ، | والعدني ، خط ) . |(@)(@@)(@@)(@@) $ 19038 - عن رجل من الصحابة : ' قال رسول الله صلى الله عليه وسلم : أنذرتكم المسيح ، | وهو ممسوح العين اليسرى ، تسير معه جبال الخبز ، وأنهار الماء ، علامته : يمكث | PageV21P259 | في الأرض أربعين صباحا ، يبلغ سلطانه كل منهل ، لا يأتي أربعة مساجد : | الكعبة ، ومسجد الرسول ، والمسجد الأقصى ، والطور ، ومهما كان من ذلك | فاعلموا أن الله عز وجل ليس بأعور ، يسلط على رجل فيقتله ثم يحييه ، ولا يسلط | على غيره ' ( حم ) . |(@)(@@)(@@)(@@) $ 19039 - عن رجل من الأنصار قال : ' قال النبي صلى الله عليه وسلم : أنذرتكم المسيح ، | أنذرتكم المسيح الدجال ! إنه لم يكن نبي قبل إلا قد أنذر أمته ، وإنه فيكم جعد آدم 
ms7624	 ، | ممسوح العين اليسرى ، معه جنة ونار ، وجبل من خبز ، ونهر من ماء ، تمطر السماء ، | ولا ينبت الشجر ، يسلط على نفس مؤمنة ، فيميتها ثم يحييها ، يكون في الأرض | أربعين صباحا ، لا يبقى منهل إلا أتاه ، لا يدخل المساجد الأربعة : مكة ، والمدينة ، | وبيت المقدس ، والطور ، فما شبه عليكم من شأنه فاعلموا أن الله تعالى ليس | بأعور ' ( البغوي ) . |(@)(@@)(@@)(@@) $ 19040 - عن يحيى بن أبي إسحاق : أنه سمع أنس بن مالك رضي الله عنه | سئل عن المسح على الخفين ؟ فقال : امسح عليهما فقالوا له : أسمعته من | رسول الله صلى الله عليه وسلم ؟ قال : لا ، ولكن سمعته ممن له سهم من أصحابنا ' . ( ش ) . |(@)(@@)(@@)(@@) $ 19041 - عن عبد العزيز بن رفيع ، عن رجل من أهل المدينة من الأنصار ، | عن النبي صلى الله عليه وسلم : ' أنه سمع خفق نعلي وهو ساجد ، فلما فرغ من صلاته قال : من ذا | الذي سمعت خفق نعليه ؟ قال : أنا يا رسول الله ! قال : فما صنعت ؟ قال : | وجدتك ساجدا فسجدت ، فقال : هكذا فاصنعوا ولا تعتدوا بها ، من وجدني راكعا | أو قائما أو ساجدا فليكن معي على حالي التي أنا عليها ' . ( ش ، وهو صحيح ) . |(@)(@@)(@@)(@@) $ 19042 - عن الزهري ، عن رجل أظنه من أبناء النقباء ، عن أبيه قال : ' كنا | نصلي المغرب مع رسول الله صلى الله عليه وسلم ثم نرجع إلى رحالنا ، وأحدنا ينظر مواقع النبل ' | ( ش ) . |(@)(@@)(@@)(@@) $ 19043 - عن عبد الرحمن بن الأسود ، عن رجل من أصحاب محمد صلى الله عليه وسلم : | PageV21P260 | ' أن رجلا قال : علمكم صاحبكم كل شيء ، حتى يوشك أن يعلمكم أن تأتوا الغائط | والبول ، قال : وذلك قد أمرنا أن لا نستقبل القبلة بغائط ولا بول ، وأن نستنجي بثلاثة | أحجار ، وأمرنا أن لا نستنجي بروث ولا برجيع ولا يستنجي أحدنا بيمينه ' ( عب ) . |(@)(@@)(@@)(@@) $ 19044 - عن الأشهب ، عن رجل من مزينة : ' أن رسول الله صلى الله عليه وسلم رأى على | عمر رضي الله عنه ثوبا غسيلا ، فقال : جديد ثوبك أم غسيل ؟ قال : غسيل | يا رسول الله ! فقال رسول الله صلى الله عليه وسلم : البس جديدا ، وعش حميدا ، وتوف 
ms7625	 شهيدا | يعطك الله تعالى قرة عين في الدنيا والآخرة ' ( ش ) . |(@)(@@)(@@)(@@) $ 19045 - عن عبد الملك بن أبي سليمان ، عن رجل من أصحاب البصرة | قال : ' أتي النبي صلى الله عليه وسلم بهدية وعائشة رضي الله عنه قائمة تصلي ، فأعجبه أن تأكل | معه ، فقال : يا عائشة ! اجمعي وأوجزي ، قولي : اللهم ! إني أسألك من الخير | كله ، عاجله وآجله ؛ وأعوذ بك من الشر كله ، عاجله وآجله ، وما قضيت من قضاء | فبارك لي فيه ، واجعل عاقبته إلى خير ' . |(@)(@@)(@@)(@@) $ 19046 - عن أبي عبد الرحمن السلمي رضي الله عنه قال : ' حدثنا من كان | يقرئنا من أصحاب رسول الله صلى الله عليه وسلم : أنهم كانوا يقرأون من رسول الله صلى الله عليه وسلم عشر | آيات ، ولا يأخذون في العشر الأخرى حتى يعلموا ما في هذه من العلم والعمل ، | فعلمنا العلم والعمل ' ( ش ) . |(@)(@@)(@@)(@@) $ 19047 - عن الحسن رضي الله عنه قال : ' أخبرني من رأى رسول الله صلى الله عليه وسلم بال | قاعدا ، ففرج حتى ظننت أن دركه سبقك ' ( عب ، ش ، ض ) . |(@)(@@)(@@)(@@) $ 19048 - عن أبي روح ، عن رجل من أصحاب محمد قال : ' صلى | النبي صلى الله عليه وسلم صلاة الفجر فقرأ ب ^ ( الروم ) ^ فألبس عليه فيها ، فلما انصرف قال : | ما بال أقوام يصلون الصلاة معنا بغير طهور ، من صلى معنا فليحسن وضوءه - وفي | لفظ : إنما يؤذينا سوء طهوركم ' ( عب ) . | PageV21P261 |(@)(@@)(@@)(@@) $ 19049 - عن أبي الشيخ الهنائي : ' أن معاوية رضي الله عنه قال لنفر من | أصحاب رسول الله صلى الله عليه وسلم : تعلمون أن نبي الله صلى الله عليه وسلم نهى عن سروج النمور أن يركب | عليها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19050 - عن الحسن رضي الله عنه : ' أن رجلا حدثهم أن رسول الله صلى الله عليه وسلم كان | يتوضأ بمد من ماء ، ويغتسل بصاع ' ( عب ، ش ) . |(@)(@@)(@@)(@@) $ 19051 - عن زهير بن الأرقم قال : ' بينا الحسن بن علي رضي الله عنهما | يخطب ، إذ قام رجل من الأزد آدم طوال فقال : لقد رأيت رسول الله صلى الله عليه وسلم واضعه في | حبوته ، يقول : من أحبني فليحبه ، فليبلغ الشاهد الغائب ' ( ش ، حم 
ms7626	 ، | وابن منده ، ك ، كر ) . |(@)(@@)(@@)(@@) $ 19052 - عن الزهري ، عن رجل من الأنصار ، عن أبيه قال : ' رأيت | رسول الله صلى الله عليه وسلم أكل من كتف شاة ، ثم قام إلى الصلاة ولم يتوضأ ' ( عب ) . |(@)(@@)(@@)(@@) $ 19053 - عن عطاء قال : ' أخبرني رجل أن أبا ذر رضي الله عنه أصاب أهله ، | فلم يكن معه ماء فمسح وجهه ويديه ، ثم وقع في نفسه شيء ، فذهب إلى النبي صلى الله عليه وسلم ، | وهو منه على مسيرة ثلاث ، فوجد الناس قد صلوا الصبح ، فسأل عن النبي صلى الله عليه وسلم ، فإذا | هو يتبرز للخلاء ، فاتبعه ، فالتفت النبي صلى الله عليه وسلم فرآه ، فأهوى النبي صلى الله عليه وسلم بيديه | إلى الأرض ، فوضعهما ثم نفضهما ثم مسح بهما وجهه ويديه ' ( عب ) . |(@)(@@)(@@)(@@) $ 19054 - عن أبي صالح الزيات ، عن رجل : ' أن النبي صلى الله عليه وسلم نادى رجلا من | الأنصار ، فخرج إليه ، فانطلقا قبل قباء ، فمرا بمرية ، فاغتسل الأنصاري ، فسأله | النبي صلى الله عليه وسلم ، فقال : فلما دعوتني وأنا على امرأتي ، فقال النبي صلى الله عليه وسلم : إذا أقحط أحدكم | أو أكسل فإنما يكفي منه الوضوء ' . ( عب ) . |(@)(@@)(@@)(@@) $ 19055 - عن محمد بن عباد ، عن جعفر ، عن شيخ منهم قال : ' رأيت | النبي صلى الله عليه وسلم يصلي في نعليه ، وأشار إلى المقام ' ( عب ) . |(@)(@@)(@@)(@@) $ 19056 - عن أبي صالح ، عن رجل من أصحاب النبي صلى الله عليه وسلم قال : ' أتى | PageV21P262 | جبريل النبي صلى الله عليه وسلم فقال : بشر خديجة رضي الله عنها ببيت في الجنة من قصب | لا صخب فيه ولا نصب ' ( ش ) . |(@)(@@)(@@)(@@) $ 19057 - عن أبي سلمة بن عبد الرحمن ، عن رجل من أهل الصفة قال : | ' دعاني رسول الله صلى الله عليه وسلم ورهطا معي من أهل الصفة ، فتعشينا عنده ، ثم قال : إن | شئتم رقدتم ههنا ، وإن شئتم في المسجد ، فقلنا : في المسجد ، فكنا ننام في | المسجد ' ( عب ) . |(@)(@@)(@@)(@@) $ 19058 - عن يحيى بن أبي كثير : ' أن رجلا لما قال المؤذن : حي على | الصلاة ، حي على الفلاح ، قال : لا حول ولا قوة إلا بالله ، قال : هكذا سمعنا 
ms7627	 | نبيكم صلى الله عليه وسلم يقول ' ( عب ) . |(@)(@@)(@@)(@@) $ 19059 - عن عمر بن أوس : أن رجلا من ثقيف أخبره أنه سمع مؤذن | النبي صلى الله عليه وسلم في ليلة مطيرة يقول : حي على الصلاة ، حي على الفلاح ، صلوا في | رحالكم ' ( عب ) . |(@)(@@)(@@)(@@) $ 19060 - عن أبي عميرة بن أنس رضي الله عنه قال : ' حدثني عمومة لي من | الأنصار من أصحاب النبي صلى الله عليه وسلم قالوا : كان رسول الله صلى الله عليه وسلم يقول : ما شهدهما منافق - | يعني : الفجر والعشاء ' ( عب ، ش ، ض ) . |(@)(@@)(@@)(@@) $ 19061 - عن شبيب بن روح ، عن رجل من أصحاب محمد صلى الله عليه وسلم قال : | ' صلى النبي صلى الله عليه وسلم صلاة الفجر ، فقرأ ' سورة الروم ' فالتبس فيها ، فلما انصرف ، | قال : ما بال أقوام يصلون معنا بغير طهور ، ومن صلى معنا فليحسن طهوره ، فإنما | يلبس علينا القرآن أولئك ' ( عب ) . |(@)(@@)(@@)(@@) $ 19062 - عن أسماء بن الحكم الفزاري قال : ' سألت رجلا من أصحاب | النبي صلى الله عليه وسلم عن البصاق في المسجد ؟ قال : هي خطيئة وكفارتها دفنها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19063 - عن مجاهد قال : ' سمعت رجلا من أصحاب النبي صلى الله عليه وسلم لا أعلمه | إلا ممن شهد بدرا ، قال لابنه : أدركت الصلاة معنا ؟ قال : نعم ، قال : أدركت | PageV21P263 | التكبيرة الأولى ؟ قال : لا ، قال : ما فاتك منها خير من مائة ناقة كلها سوداء العين ' | ( عب ) . |(@)(@@)(@@)(@@) $ 19064 - عن زادان قال : ' حدثني رجل من الأنصار قال : سمعت | رسول الله صلى الله عليه وسلم يقول في دبر كل صلاة : اللهم اغفر لي وتب علي إنك أنت التواب | الغفور - مائة مرة - ' ( ش ، وهو صحيح ) . |(@)(@@)(@@)(@@) $ 19065 - عن ابن جريج قال : ' أخبرني عبد الكريم ، عن رجل قال : | أخبرني بعض أهل النبي صلى الله عليه وسلم أنه كان يقول : اللهم صل على محمد ، وعلى أهل | بيته ، وأزواجه ، وذريته ، كما صليت على إبراهيم ، وعلى آل إبراهيم ، إنك حميد | مجيد ، وبارك على محمد ، وعلى أهل بيته ، وأزواجه ، وذريته ، كما باركت على | إبراهيم ، وعلى آل إبراهيم ، إنك حميد مجيد ' ( عب ، صحيح ) . |(@)(@@)(@@)(@@) $ 19066 - عن عمر بن عبد الرحمن 
ms7628	 بن عوف رضي الله عنه : ' أن رجالا من | أصحاب النبي صلى الله عليه وسلم قالوا : إن رجلا من الأنصار جاء إلى النبي صلى الله عليه وسلم يوم الفتح ، | والنبي صلى الله عليه وسلم في مجلس قريب من المقام ، فسلم على النبي صلى الله عليه وسلم ، فقال : | يا نبي الله ! إني نذرت إن فتح الله تعالى للنبي صلى الله عليه وسلم وللمؤمنين مكة لأصلين في بيت | المقدس ، وإني وجدت رجلا من أهل الشام ههنا في قريش حقيرا مقبلا معي | ومدبرا ، فقال النبي صلى الله عليه وسلم : ههنا فصل ، فعاد الرجل يقول هذا ثلاث مرات ، كل ذلك | يقول النبي صلى الله عليه وسلم : ههنا فصل ، ثم قال الرابعة مقالته ، فقال النبي صلى الله عليه وسلم : فاذهب فصل | فيه ؛ فوالذي بعث محمدا بالحق ! لو صليت ههنا لمقضي ذلك عنك صلاة في بيت | المقدس ' ( عب ، وقال ابن جريج : أخبرت أن ذلك الشريد بن شريد ) . |(@)(@@)(@@)(@@) $ 19067 - عن الشعبي ، عن رجل من بني المصطلق قال : ' بعثني قومي بنو | المصطلق إلى رسول الله صلى الله عليه وسلم إلى من تدفع صدقاتهم بعده ؟ فأتيته فقال : إلى | أبي بكر ، فلقيت عليا فأخبرته ، فقال : ارجع فاسأله إلى من يدفعونها بعد أبي بكر ؟ | فسألته فقال : ادفعوها إلى عمر بعده ، فأخبرت عليا فقال : ارجع إليه فاسأله : | PageV21P264 | إلى من يدفعونها بعد عمر ، فسألته فقال : ادفعوها إلى عثمان بعده ، فأخبرت عليا | فقال : ارجع إليه فاسأله : إلى من يدفعونها بعد عثمان ؟ فقلت : إني لأستحيي أن | أرجع إلى رسول الله صلى الله عليه وسلم بعد ' ( نعيم بن حماد في الفتن ) . |(@)(@@)(@@)(@@) $ 19068 - عن الزهري : ' أن لحي رجل من الأنصار من بني حارثة أخبره أن | ناسا من أصحاب رسول الله صلى الله عليه وسلم أتوا رسول الله صلى الله عليه وسلم فقالوا : يا رسول الله ! أرأيت | أشياء نجدها في صدورنا من وسوسة الشيطان ، لأن يقع أحدنا من عند الثريا أحب إلينا | من أن يتكلم بها ، فقال رسول الله صلى الله عليه وسلم : قد وجدتم ؟ ! ذلك صريح الإيمان ، إن 
ms7629	 | الشيطان يريد العبد فيما دون ذلك ، فإذا عصم منه وقع فيما هناك ' ( محمد بن | عثمان الأذرعي في كتاب الوسوسة ) . |(@)(@@)(@@)(@@) $ 19069 - عن أبي عمير بن أنس رضي الله عنه قال : ' حدثني عمومتي من | الأنصار من أصحاب النبي صلى الله عليه وسلم قال : أغمي علينا هلال شوال فأصبحنا صياما ، فجاء | ركب من آخر النهار ، فشهدوا عند النبي صلى الله عليه وسلم أنهم رأوا الهلال بالأمس ، فأمر النبي صلى الله عليه وسلم | أن يفطروا ، وأن يخرجوا إلى عيدهم من الغد ' ( ش ) . |(@)(@@)(@@)(@@) $ 19070 - عن كليب رضي الله عنه قال : ' كنا في المغازي لا يؤمر علينا | إلا أصحاب رسول الله صلى الله عليه وسلم ، فقام بفارس علينا رجل من مزينة من أصحاب | النبي صلى الله عليه وسلم ، فغلت علينا المسان حتى كنا نشتري المسن بالجذعتين والثلاث ، فقام فينا | هذا الرجل فقال : إن هذا اليوم أدركنا ، فغلت علينا المسان ، حتى كنا نشتري | المسن بالجذعتين والثلاث ، فقام فينا رسول الله صلى الله عليه وسلم فقال : إن المسن يوفي فيما يوفي | منه الثني ' . |(@)(@@)(@@)(@@) $ 19071 - عن كليب ، عن رجل من مزينة : ' أن النبي صلى الله عليه وسلم ضحى في | السفر ' . |(@)(@@)(@@)(@@) $ 19072 - عن أسيد رضي الله عنه ، عن رجل من مزينة أنه قال : ' أتيت | رسول الله صلى الله عليه وسلم يوما أريد أن أسأله ، فوجدت عنده رجلا يريد أن يسأله فأعرض عنه | PageV21P265 | رسول الله صلى الله عليه وسلم مرتين أو ثلاثا ، ثم قال : من كان له أوقية ثم سأل فقد سأل إلحافا ، | قلت : أليس لي فلانة ، فهي خير من ثمن أوقية ، فلا أسأله شيئا ، فأعطاني رجل من | الأنصار ناضحا له أخذته مع ناقتي ، وأعطاني شيئا من تمر ، فما زلت بخير حتى | الساعة ' ( أبو نعيم ) . |(@)(@@)(@@)(@@) $ 19073 - عن عبد الله بن رباح الأنصاري ، عن رجل من الأنصار من أصحاب | النبي صلى الله عليه وسلم : ' أن النبي صلى الله عليه وسلم صلى العصر فقام رجل يصلي بعدها ، فأخذ عمر بن | الخطاب رضي الله عنه بردائه وقال : اجلس ، إنما هلك أهل الكتاب قبلكم ، بأنه 
ms7630	 | لم يكن لصلاتهم فضل ، فقال النبي صلى الله عليه وسلم : صدق ابن الخطاب ' ( عب ) . |(@)(@@)(@@)(@@) $ 19074 - عن أبي قلابة ، عن رجل من عذرة : ' أن رجلا منهم أعتق عند موته | غلاما له ، لم يكن له مال غيره ، فرفع ذلك إلى النبي صلى الله عليه وسلم ، فأعتق ثلثه ، وأمره أن | يسعى في الثلثين ' ( عب ) . |(@)(@@)(@@)(@@) $ 19075 - عن عبيد الله بن عبد الله بن عتبة رضي الله عنه ، عن رجل من | الأنصار : ' جاء بأمة سوداء إلى النبي صلى الله عليه وسلم ، فقال : يا رسول الله ! إن علي رقبة | مؤمنة ، فإن ترى هذه مؤمنة أعتقتها ، فقال لها النبي صلى الله عليه وسلم : أتشهدين أن لا إله | إلا الله ؟ قالت : نعم ، قال : أتشهدين أني رسول الله صلى الله عليه وسلم ؟ قالت : نعم ، قال : | أتؤمنين بالبعث بعد الموت ؟ قالت : نعم ، قال : أعتقها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19076 - عن عمرو بن أوس رضي الله عنه ، عن رجل من الأنصار : ' أن | امرأة هلكت وأمرته أن يعتق عنها رقبة مؤمنة ، فجاء إلى النبي صلى الله عليه وسلم فذكر ذلك له وقال | لا أملك إلا جارية سوداء أعجمية لا تدري ما الصلاة ؟ فقال النبي صلى الله عليه وسلم : ائتني بها ، | فجاء بها ، فقال لها : أين الله ؟ قالت : في السماء ، قال : فمن أنا : قالت : | رسول الله ، قال : أعتقها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19077 - عن عقبة بن أوس السدوسي رضي الله عنه ، عن رجل من أصحاب | النبي صلى الله عليه وسلم قال : ' لما قدم النبي صلى الله عليه وسلم مكة قال : لا إله إلا الله وحده ، صدق وعده ، | PageV21P266 | ونصر عبده ، وهزم الأحزاب وحده ، ألا وإن كل مأثرة بالجاهلية تحت قدمي هاتين | ألا سدانة البيت ، وسقاية الحاج ، ألا إن دية كل قتيل بالسوط والعصا مائة ، منها | أربعون في بطونها أولادها ' ( عب ) . |(@)(@@)(@@)(@@) $ 19078 - عن أبي سلمة بن عبد الرحمن ، وسليمان بن يسار | رضي الله عنهما ، عن رجال من أصحاب النبي صلى الله عليه وسلم : ' قال النبي صلى الله عليه وسلم : لعلكم | تقرأون والإمام يقرأ - مرتين أو ثلاثا - ؟ قالوا : نعم يا رسول الله 
ms7631	 ! إنا لنفعل ، قال : | فلا تفعلوا إلا أن يقرأ أحدكم بفاتحة الكتاب ' . |(@)(@@)(@@)(@@) $ 19079 - عن الحكم رضي الله عنه ، عن رجل من بني سليم : أنه سمع | رسول الله صلى الله عليه وسلم يسجد في ( حم ) بالآية . . . الآية ' . |(@)(@@)(@@)(@@) $ 19080 - عن رجل من الأنصار : ' أن النبي صلى الله عليه وسلم أقرها على ما كانت عليه في | الجاهلية ، وقضى بها بين ناس من الأنصار في قتيل ادعوه على اليهود ، قال : | وأخبرني ابن شهاب عن نبيه رسول الله صلى الله عليه وسلم ، فيها أن يكون على المدعى عليه وعلى | أوليائه ، يحلف منهم خمسون رجلا إذا لم تكن بينة يؤخذ بها ، فإن نكل منهم رجل | واحد ردت قسامتهم ووليها المدعون فحلفوا بمثل ذلك ، فإن حلف منهم خمسون ، | وإن نقضت قسامتهم أو رد منهم أحد لم يعطوا الدية ' . |(@)(@@)(@@)(@@) $ 19081 - عن عبد الله بن سمعان قال : ' أخبرني أبو بكر بن محمد بن | عمرو بن حزم ، عن رهط من الأنصار ، أن عبد الله بن سهل الأنصاري | رضي الله عنه قتل بخيبر ، وهو أول من كانت فيه القسامة في الإسلام ، خرج | هو ومحيصة إلى خيبر ، فتفرقا لحاجتهما ، فقتل عبد الله بن سهل ، فقدم محيصة ، | فانطلق هو وأخوه حويصة وعبد الرحمن بن سهل أخو المقتول إلى النبي صلى الله عليه وسلم ، فأراد | عبد الرحمن أن يتكلم لمكانه من أخيه ، فقال رسول الله صلى الله عليه وسلم : كبر الأكبر ، فتكلم | محيصة وحويصة فقالا : يا رسول الله ! إنا وجدنا عبد الله بن سهل مقتولا في قليب | من قلب خيبر ، فلا ندري من قتله ؟ ونحن نظن أن يهود ، قال النبي صلى الله عليه وسلم : أتحلفون | PageV21P267 | خمسين على خمسين رجلا أن يهود قتلته ، فتستحقون بذلك ؟ قالوا : يا رسول الله ! | كيف نحلف على أمر كان عنا غائبا فلم نحضره ؟ فلما نكلوا قال : فتحلف لكم يهود | فتبرئكم ، خمسين رجلا منهم على خمسين يمينا : أنهم براء من قتل صاحبكم ، | قالوا : يا رسول الله ! كيف نرضى بأيمان يهود وهم كفار ؟ فعقله رسول الله صلى الله عليه وسلم من | عنده بمائة 
ms7632	 من الإبل ، قال أبو بكر : فأخبرني سهل بن أبي حثمة الأنصاري قال : لقد | رأيت ذلك العقل ودى به النبي صلى الله عليه وسلم عبد الله بن سهل ، وركصتني منها فريضة ' | ( عب ) . |(@)(@@)(@@)(@@) $ 19082 - عن عبد الله ابن أبي بكر بن حفص ، عن عمر بن سعد : ' أن | معاوية رضي الله عنه صلى بالمدينة للناس العتمة ، فلم يقرأ : ( بسم الله الرحمن | الرحيم ) ، ولم يكبر بعض هذا التكبير الذي يكبر الناس ، فلما انصرف ، ناداه من | سمع ذلك من المهاجرين والأنصار ، فقال : يا معاوية ! أسرقت الصلاة ، أم نسيت ؟ | أين ^ ( بسم الله الرحمن الرحيم ) ^ ، والله أكبر حين يهوي ساجدا ؟ فلم يعد معاوية | لذلك بعد ' ( عب ) . |(@)(@@)(@@)(@@) $ 19083 - عن النعمان بن سالم رضي الله عنه ، عن رجل قال : ' دخل علينا | رسول الله صلى الله عليه وسلم - ونحن في قبة المسجد - ، فأخذ بعمود القبة ، فأخذ يحدثنا ، إذ جاءه | رجل فساره - ما أدري ما ساره ، فقال النبي صلى الله عليه وسلم : اذهبوا به فاقتلوه ، فلما قفى الرجل | دعاه وقال : لعله يقول : لا إله إلا الله ، قال : أجل ، قال النبي صلى الله عليه وسلم : اذهب فقل | لهم يرسلوه ، فإني أوحي إلي أن أقاتل الناس حتى يقولوا : لا إله إلا الله ، فإذا | قالوا : لا إله إلا الله ، حرمت دماؤهم وأموالهم إلا بالحق وحسابهم على الله ' | ( عب ) . |(@)(@@)(@@)(@@) $ 19084 - عن ابن جريج رضي الله عنه قال : ' حدثني من أصدق أن سبيعة | سألت النبي صلى الله عليه وسلم بعدما وضعت بخمس عشرة ' . ( عب ) . | PageV21P268 |(@)(@@)(@@)(@@) $ 19085 - أنبأنا معمر ، عن عاصم ، عن الشعبي ، وعن قتادة رضي الله عنه | أيضا : ' أن رجلا أتى ابن مسعود رضي الله عنه فسأله عن امرأة توفي عنها زوجها ، | ولم يدخل بها ، ولم يفرض لها ، فقال له ابن مسعود : سل الناس ، فإن الناس | كثير ، فقال الرجل : والله لو مكثت حولا ما سألت غيرك ، فرده ابن مسعود شهرا | ثم قام فتوضأ ، ثم ركع ركعتين ، ثم قال : اللهم ما كان من صواب فمنك ، وما كان | من خطأ فمني ، ثم قال : أرى لها صداق أجري نسائها ، ولها 
ms7633	 الميراث مع ذلك | وعليها العدة ، فقام رجل من أشجع ، فقال : أشهد لقضيت فيها بقضاء | رسول الله صلى الله عليه وسلم ، تزوج ببنته واشق كانت تحت هلال بن أمية ، فقال ابن مسعود : هل | سمع هذا معك أحد ؟ فقال : نعم ، فأتى بنفر من قومه فشهدوا بذلك ، فما رأوا | ابن مسعود رضي الله عنه فرح بشيء ما فرح بذلك حين وافق قضاء رسول الله صلى الله عليه وسلم ، | أنبأنا معمر ، عن جعفر برقان ، عن الحكم قال : فبلغ ذلك عليا رضي الله عنه فقال : | لا تصدق الأعراب على رسول الله صلى الله عليه وسلم ' . |(@)(@@)(@@)(@@) $ 19086 - عن عبد الله بن عبيد بن عمير رضي الله عنه قال : ' كتبت إلى رجل | من بني زريق ، من أهل المدينة ، يسأل لي عن ابن الملاعنة من يرثه ؟ فكتب إلي : | أنه سأل ، فاجتمعوا على النبي صلى الله عليه وسلم ، فقضى به للأم ، وجعلها بمنزلة أبيه وأمه ' . | ( عب ) . |(@)(@@)(@@)(@@) $ 19087 - عن عروة رضي الله عنه قال : ' لقد أخبرني رجل أن رجلا غرس في | أرض رجل من الأنصار نخلا ، فاختصما إلى النبي صلى الله عليه وسلم ، فقضى للأنصاري بأرضه ، | وقضى على الآخر أن ينزع نخله ، قال : فلقد رأيته يضرب في أصولها بالفؤس ، | وإنها لتحيل ' ( عم ، أبو عبيد في الغريب ، والعسكري في الأمثال ) ( عب ) . |(@)(@@)(@@)(@@) $ 19088 - حدثنا أبو الأزهر ، حدثنا أيوب بن خالد الخزاعي ، حدثنا | الأوزاعي ، حدثنا ثابت بن عمير قال : حدثني ربيعة بن أبي عبد الرحمن ، حدثني | رجل من الأنصار ، حدثني أبي : ' أنه سمع رسول الله صلى الله عليه وسلم سئل عن اللقطة ؟ فقال : | PageV21P269 | عرفها سنة ثم احفظ عفاصها ووكاءها ، ثم استنفقها - أو قال : أصب بها حاجتك ' | ( عد ، كر ، وقال كر : ابن الشرقي : هذا الإسناد عندي خطأ ووهم ، إنما هو | ربيعة بن أبي عبد الرحمن ، عن زيد مولى المنبعث ، عن زيد بن خالد الجهني ، عن | النبي صلى الله عليه وسلم كما رواه مالك وابن عيينة وسليمان بن بلال ، وإسماعيل بن جعفر وحماد بن | سلمة ، وعمرو بن الحارث وغيرهم ، عن ربيعة ، وقال كر : كذا وقع 
ms7634	 ، وإنما هو باب | ابن عمير ) . |(@)(@@)(@@)(@@) $ 19089 - عن يوسف بن ماهك رضي الله عنه ، عن رجل : ' أن | رسول الله صلى الله عليه وسلم قال لحكيم بن حزام رضي الله عنه : لا تبع ما ليس عندك ' ( عب ) . |(@)(@@)(@@)(@@) $ 19090 - عن الأحنف بن قيس رضي الله عنه قال : ' بينا أنا أطوف بالبيت في | زمن عثمان رضي الله عنه : إذ لقيني رجل من بني ليث - وفي لفظ : من بني سليم - ، | فقال : ألا أبشرك ؟ قلت : بلى ، قال : أتذكر إذ بعثني رسول الله صلى الله عليه وسلم إلى قومك بني | سعد أدعوهم إلى الإسلام ، فجعلت أخبرهم وأعرض عليهم الإسلام وأدعوهم إليه | فقلت أنت : إنك لتدعونا إلى خير وتأمر به ، وإنه ليدعو إلى الخير ، والله ما قال | إلا خيرا ، وما أسمع إلا حسنا ، فإني رجعت فأخبرت النبي صلى الله عليه وسلم بمقالتك ، فقال : | اللهم اغفر للأحنف ، قال : فما شيء أرجى عندي من ذلك - يعني دعوة النبي صلى الله عليه وسلم - ' | ( حم ، ويعقوب وابن سفيان وابن منده ، كر ) . |(@)(@@)(@@)(@@) $ 19091 - عن الأحنف رضي الله عنه : ' أنه قدم على عمر بن الخطاب | رضي الله عنه بفتح يسير ، فقال رجل من المهاجرين : يا أمير المؤمنين ! إن هذا - | يعني : الأحنف - الذي كف عنا بني مرة حين بعثنا رسول الله صلى الله عليه وسلم في صدقاتهم ، وقد | كانوا هرابا ، قال الأحنف : فحبسني عمر عنده سنة ، يأتيني في كل يوم وليلة ، | فلا يأتيه عني إلا ما يحب ، فلما كان رأس السنة دعاني فقال : يا أحنف ! هل تدري | ممن حبستك عندي ؟ قال : لا ، قال : إن رسول الله صلى الله عليه وسلم حذرنا كل منافق عليم ، | فخشيت أن تكون منهم ، فاحمد الله تعالى يا أحنف ! ' ( أبو نعيم ) . | PageV21P270 |(@)(@@)(@@)(@@) $ 19092 - عن الحارث بن بدل النصري رضي الله عنه ، عن رجل من قومه ، | شهد ذلك يوم حنين مع عمرو بن سفيان الثقفي قال : ' انهزم المسلمون في حنين ، | فلم يبق مع رسول الله صلى الله عليه وسلم إلا العباس بن عبد المطلب ، وأبو سفيان بن الحارث | رضي الله عنه ، قال : فقبض 
ms7635	 رسول الله صلى الله عليه وسلم قبضة من الحصا ، فرمى بها وجوههم ، | فانهزمنا ، فما خيل إلينا إلا في كل حجر أو شجرة فارس يطلبنا قال الثقفي : فأعجزت | على قومي حتى دخلت الطائف ' . |(@)(@@)(@@)(@@) $ 19093 - عن عمر بن عبد العزيز رضي الله عنه قال : ' سمعت بالمدينة | والناس بها يومئذ كثير ، من مشيخة المهاجرين والأنصار أن حوائط النبي صلى الله عليه وسلم - يعني | السبعة التي وقف من أموال مخيريق فموالي لمحمد صلى الله عليه وسلم يضعها حيث أراه الله | تعالى ، وقيل يوم أحد ، فقال رسول الله صلى الله عليه وسلم : مخيريق خير يهود ، ثم دعى عمر بتمر . | منها فأتي بتمر في طبق ، فقال : كتب إلي أبو بكر بن حزم أن يخبرني أن هذا التمر | من العرق الذي كان على عهد رسول الله صلى الله عليه وسلم ، وكان رسول الله صلى الله عليه وسلم يأكل منها ' . |(@)(@@)(@@)(@@) $ 19094 - عن أبي الهيثم ، عمن أخبره : أنه سمع أبا سفيان بن حرب مازح | النبي صلى الله عليه وسلم في بيت ابنته أم حبيبة ويقول : والله إن هو إلا أن تركتك ، فتركتك العرب إن | انتطحت فيك ، وقالوا : جماء ولا ذات قرن ، ورسول الله صلى الله عليه وسلم يضحك ويقول : أنت | تقول ذلك يا أبا حنظلة ' ( الزبير بن بكار ) . |(@)(@@)(@@)(@@) $ 19095 - عن عبد الرحمن بن السلماني قال : ' سمعت رجلا من أصحاب | رسول الله صلى الله عليه وسلم يقول : سمعت رسول الله صلى الله عليه وسلم يقول : من تاب إلى الله تعالى قبل | أن يموت بيوم قبل الله تعالى منه ، فحدثتها رجلا آخر من أصحاب رسول الله صلى الله عليه وسلم | فقال : أنت سمعته ؟ قال : نعم ، قال : فأشهد لقد سمعت رسول الله صلى الله عليه وسلم يقول : من | تاب إلى الله تعالى قبل أن يموت بنصف يوم قبل الله تعالى منه ، قال : فحدثتها رجلا | من أصحاب رسول الله صلى الله عليه وسلم آخر ، فقال : أنت سمعته ؟ فقلت : نعم ، قال : فأشهد | لسمعت رسول الله صلى الله عليه وسلم يقول : من تاب إلى الله 
ms7636	 تعالى قبل أن يموت بضحوة ، | PageV21P271 | قبل الله تعالى منه ، قال : فحدثتها رجلا من أصحاب رسول الله صلى الله عليه وسلم آخر ، فقال : | أنت سمعته ؟ قلت : نعم ، قال : فأشهد لسمعت رسول الله صلى الله عليه وسلم يقول : من تاب | إلى الله تعالى قبل أن يغرغر بنفسه قبل الله تعالى منه ' ( حم ، وابن زنجويه ) . |(@)(@@)(@@)(@@) $ 19096 - عن الزهري ، أخبرني عمرو بن أبي سفيان الثقفي رضي الله عنه : | ' أنه أخبره رجل من الأنصار ، عن بعض أصحاب محمد صلى الله عليه وسلم قال : ذكر | رسول الله صلى الله عليه وسلم الدجال ، فقال : يأتي سياج المدينة وهو محرم عليها أن يدخلها | بغاتها ، فتنتفض المدينة بأهلها نفضة أو نفضتين ، وهي الزلزلة ، فيخرج إليه منها | كل منافق ومنافقة ، ثم يولي الدجال قبل الشام ، ثم يأتي إلى بعض جبال الشام | فيحاصرهم ، وبقية المسلمين يومئذ معتصمون بذروة جبل من جبال الشام ، | فيحاصرهم الدجال بازلا بأصله ، حتى إذا طال عليهم البلاء ، قال رجل من المسلمين | يا معشر المسلمين ! حتى متى أنتم هكذا وعدو الله نازل بأصل جبلكم هذا ؟ هل | أنتم إلا بين إحدى الحسنيين ، بين أن يستشهدكم الله ، أو أن يظهركم ، لتبايعون | على الموت بيعة يعلم الله تعالى بها الصدق من أنفسهم ، ثم تأخذهم ظلمة لا يبصر | امرؤ فيها كفه ، فينزل ابن مريم فينحسر على أبصارهم وبين أظهرهم رجل عليه | لأمته ، فيقولون : من أنت يا عبد الله ؟ فيقول : أنا عبد الله ورسوله وروحه وكلمته | عيسى بن مريم ، اختاروا إحدى ثلاث : بين أن يبعث الله تعالى على الدجال وعلى | جنوده عذابا من السماء ، أو يخسف بهم الأرض ، أو يسلط عليهم سلاحكم ويكف | سلاحهم عنكم ، فيقولون : هذه يا رسول الله ! أشفى لصدورنا ونفوسنا ، فيومئذ | يرى اليهودي العظيم الأكول الشروب لا يفل عدة سيفه من الرعدة ، فينزلون إليهم | فيسلطون عليهم ، ويذوب الدجال حين يرى ابن مريم كما يذوب الرصاص حتى يأتيه | أو يدركه عيسى فيقتله ' . |(@)(@@)(@@)(@@) $ 19097 - عن يزيد بن عبد الله بن الشخير رضي الله عنه قال : ' كنا جلوسا | بهذا المربد بالبصرة ، فجاء أعرابي 
ms7637	 معه قطعة من أديم ، أو قطعة من جراب ، | PageV21P272 | فقال : هذا كتاب كتبه النبي صلى الله عليه وسلم ، فأخذته فقرأته على القوم ، فإذا فيه : ' بسم الله | الرحمن الرحيم من محمد رسول الله صلى الله عليه وسلم لبني زهير بن أقيش ، إنكم إن أقمتم الصلاة | وآتيتم الزكاة ، وأعطيتم من المغانم الخمس ، وسهم النبي صلى الله عليه وسلم والصفي فإنكم آمنون | بأمان الله تعالى وأمان رسوله ' ، قلت : فما سمعت رسول الله صلى الله عليه وسلم يقول شيئا ؟ قال : | سمعته يقول : صوم شهر الصبر ، وصوم ثلاثة أيام من كل شهر يذهبن وحر الصدر ' . | ( ش ) . |(@)(@@)(@@)(@@) $ 19098 - عن يحيى بن سعد الأنصاري ، عن يزيد مولى المنبعث ، عن | أصحاب رسول الله صلى الله عليه وسلم : ' أن رجلا جاء إلى رسول الله صلى الله عليه وسلم فقال : يا رسول الله صلى الله عليه وسلم ! | كيف ترى في اللقطة ؟ فقال : اعرف عددها ووكاءها ، ثم عرفها سنة ، فإن جاء | صاحبها وإلا فاستنفقها ، تكون عندك وديعة ، قال : فضالة الغنم ، قال : خذها ، | إنما هي لك ، أو لأخيك ، أو للذئب ، وتعرفها ، قال : فضالة الإبل ؟ قال : دعها ، | فإن معها سقاءها وحذاءها ، ترد الماء ، وتأكل الشجر حتى يقوم صاحبها ' ( كر ) . |(@)(@@)(@@)(@@) $ 19099 - عن حميد بن عبد الرحمن قال : ' لقيت رجلا صحب رسول الله صلى الله عليه وسلم | أربع سنين كما صحبه أبو هريرة رضي الله عنه قال : نهانا رسول الله صلى الله عليه وسلم أن يتمشط | أحدنا كل يوم ، وأن يبول في مغتسله ، وأن يغتسل الرجل بفضل المرأة ، أو المرأة | بفضل الرجل ، وقال : ليغترفا جميعا ' ( ض ) . |(@)(@@)(@@)(@@) $ 19100 - عن نافع قال : ' سمعت رجلا يحدث ابن عمر عن أبيه | رضي الله عنه : أن النبي صلى الله عليه وسلم نهى أن نستقبل القبلة ببول أو غائط ' ( ض ، ش ) . |(@)(@@)(@@)(@@) $ 19101 - حدثنا خالد بن مخلد ، حدثنا مالك بن أنس ، عن عبد الله بن | أبي بكر رضي الله عنه ، عن رجل قال : ' هشمت البيضة على رسول الله صلى الله عليه وسلم يوم | أحد ، وكسرت رباعيته ، وجرح في وجهه ، ودووي بحصير محرق ، وكان 
ms7638	 علي بن | PageV21P273 | أبي طالب رضي الله عنه ينقل إليه الماء في الجحفة ' ( ش ) . |(@)(@@)(@@)(@@) $ 19102 - عن الزهري رضي الله عنه قال : ' حدثني من لا أتهم من الأنصار | أن رسول الله صلى الله عليه وسلم كان إذا توضأ أو تنخم ابتدروا نخامته ، فمسحوا بها وجوههم | وجلودهم ، فقال رسول الله صلى الله عليه وسلم : لم تفعلون هذا ؟ قالوا : نلتمس بها البركة ، فقال | رسول الله صلى الله عليه وسلم : من أحب أن يحبه الله ورسوله ، فليصدق الحديث ، وليؤد الأمانة ، | ولا يؤذ جاره ' ( هب ) . |(@)(@@)(@@)(@@) $ 19103 - عن المهلب بن أبي صفرة رضي الله عنه قال : ' سألت أصحاب | رسول الله صلى الله عليه وسلم لم قلتم في عثمان رضي الله عنه : أعلاها فوقا ؟ قالوا : لأنه لم يتزوج | رجل من الأولين والآخرين ابنتي نبي غيره ' ( كر ) . |(@)(@@)(@@)(@@) $ 19104 - عن زكريا بن أبي زائدة قال : ' كنت مع أبي إسحاق فيما بين مكة | والمدينة ، فسايرنا رجل من خزاعة فقال له أبو إسحاق : كيف قال رسول الله صلى الله عليه وسلم | رعدت هذه السحابة بنصر بني كعب ؟ فقال الخزاعي : لقد تنصلت بنصر بني كعب ، | ثم أخرج إلينا رسالة رسول الله صلى الله عليه وسلم إلى خزاعة ونائبها يومئذ ، كان فيها : ' بسم الله | الرحمن الرحيم ، من محمد رسول الله إلى بديل وبسر وسروات بني عمرو ، فإني | أحمد إليكم الله الذي لا إله إلا هو : أما بعد ذلك ، فإني لم آثم بالكم ، ولم أضع | في جنبكم ، وإن أكرم أهل تهامة عندي أنتم ، وأقربه رحما ، ومن تبعكم من | المطيبين ، وإني قد أخذت لمن هاجر منكم مثل ما أخذت لنفسي ، ولو هاجر بأرضه | غير ساكن مكة إلا معتمرا أو حاجا ، وإني لم أضع فيكم إن أسلمتم ، وإنكم غير | خائفين من قبلي ولا محصرين ، أما بعد ! فإنه قد أسلم علقمة بن علاثة وابن هودة ، | وهاجرا وبايعا على من اتبعهما من عكرمة ، وأخذا لمن اتبعهما ما أخذا لأنفسهما ، | وإن بعضنا من بعض في الحلال والحرام ، وإني والله ما كذبتكم ، وليحبكم | ربكم ، قال : وبلغني عن الزهري قال : هؤلاء خزاعة 
ms7639	 وهم من أهلي ، قال : فكتب | إليهم النبي صلى الله عليه وسلم وهو يومئذ نزول بين عرفات ومكة ، لم يسلموا حيث كتب إليهم ، وقد | كانوا خلفاء النبي صلى الله عليه وسلم ' ( ش ) . | PageV21P274 |(@)(@@)(@@)(@@) $ 19105 - عن مرة ، عن رجل من أصحاب النبيش صلى الله عليه وسلم قال : ' قام فينا | رسول الله صلى الله عليه وسلم على ناقة حمراء مخطومة فقال : أتدرون : أي يومكم هذا . أتدرون | أي شهركم هذا ؟ أتدرون أي بلدكم هذا ؟ قال : فإن دماءكم وأموالكم عليكم حرام | كحرمة يومكم هذا ، في شهركم هذا ، في بلدكم هذا ' ( ش ) . |(@)(@@)(@@)(@@) $ 19106 - عن مرة ، عن رجل من أصحاب النبي صلى الله عليه وسلم قال : ' قام فينا | رسول الله صلى الله عليه وسلم فقال : إني فرطكم على الحوض أنتظركم ، ومكاثر بكم الأمم ، | فلا تسودوا وجهي ' ( ش ) . |(@)(@@)(@@)(@@) $ 19107 - عن أبي الطفيل رضي الله عنه ، عن رجل من أصحاب النبي صلى الله عليه وسلم | قال : ' يخرج الدجال على حمار ، رجس على رجس ' ( ش ) . |(@)(@@)(@@)(@@) $ 19108 - عن سليمان بن عبد الرحمن بن سوار ، عن عبد الله بن سوادة | القشيري رضي الله عنه ، عن رجل من أهل البادية ، عن أبيه ، وكان أبوه أسيرا عند | النبي صلى الله عليه وسلم يقول : ' سمعت رسول الله صلى الله عليه وسلم يقول : كل صلاة لا يقرأ فيها فاتحة الكتاب | فهي خداج لم تقبل ' ( هق ، في القراءة ) . |(@)(@@)(@@)(@@) $ 19109 - عن عبد الوارث ، عن عبد الله بن سوادة القشيري عن رجل من أهل | البادية ، عن أبيه - وكان أبوه أسيرا عند رسول الله صلى الله عليه وسلم - يقول : ' سمعت محمدا صلى الله عليه وسلم | قال لأصحابه : أتقرأون خلفي القرآن ؟ فقالوا : يا رسول الله ! نهذه هذا ، قال : | لا تقرأوا إلا بفاتحة الكتاب ' ( هق ، في القراءة ) . |(@)(@@)(@@)(@@) $ 19110 - عن واصل بن مرزوق الذهلي ، حدثني رجل من بني مخوم يكنى | أبا شبل ، عن جده ، وكان من أصحاب النبي صلى الله عليه وسلم : ' أن النبي صلى الله عليه وسلم قال : يا معاذ ! | كم تذكر كل يوم ؟ أتذكر عشرة آلاف مرة ؟ فقال : كل ذلك أفعل ، قال 
ms7640	 : ألا أدلك | على كلمات هن أهون عليك وأكثر من عشرة آلاف وعشرة آلاف ؟ أن تقول : لا إله | إلا الله عدد كلماته ، لا إله إلا الله عدد خلقه ، لا إله إلا الله زنة عرشه ، لا إله | إلا الله ملء سماواته ، لا إله إلا الله مثل ذلك معه ، والله أكبر مثل ذلك معه ، | PageV21P275 | والحمد لله مثل ذلك معه ، لا يحصيه ملك ولا غيره ' ( ابن النجار ) . |(@)(@@)(@@)(@@) $ 19111 - عن عطاء بن عبيد بن عمير قال : ' أخبرني من أصدق - فظننت أنه | يريد عائشة رضي الله عنها - قال : ' إن الشمس كسفت على عهد النبي صلى الله عليه وسلم ، فقام | بالناس قياما طويلا ، يقوم ثم يركع ، ثم يقوم ثم يركع ، فركع ركعتين ، في كل ركعة | ثلاث ركعات ، ويقول إذا ركع : الله أكبر ، وإذا رفع رأسه قال : سمع الله لمن | حمده ، فلم ينصرف حتى انجلت الشمس ، وحتى أن رجالا ليغشى عليهم ، حتى أن | يخال الماء ينصب عليهم من طول القيام ، ثم قام ، فحمد الله وأثنى عليه ، | ثم قال : إن الشمس والقمر لا يكسفان لموت أحد ولا لحياته ، ولكنهما آيتان من | آيات الله تعالى يخوف الله بهما عباده ، فإذا انكسفا فافزعوا إلى ذكر الله حتى | ينجليا ، قال عطاء : وسمعت غير عبيد بن عمير رضي الله عنه يقول : قال النبي صلى الله عليه وسلم : | عرضت علي الجنة والنار في مقامه ذلك ، حتى تأخر وراءه وتأخر الناس ، وركب | بعضهم وهو يقول : أي رب ! وأنا فيهم ، فلما انصرف قال : إني عرضت علي النار ، | فأبصرت فيها عمرو بن لحي يجر قصبه في النار ، كان يسرق الحاج بمحجنه ، وكان | يقول : يا رب ! إني لا أسرق ، إنما يسرق محجني ، وصاحبة الهرة ، امرأة ربطتها | فلم تطعمها ولم تسقها ولم ترسلها تشرب وتأكل حتى ماتت ، ثم عاد يمشي ، حتى | إذا عاد إلى مصلاه فتناول فقال : عرضت علي الجنة لو أخذت منها قطفا لأريتكموه ' | ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 19112 - عن عباد بن منصور رضي الله عنه قال : ' كان رجل منا يقال له | كالش بن ربيعة ، يشبه النبي صلى الله عليه 