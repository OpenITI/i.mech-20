ms232	 صحبة وعنه شبيب س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 459- (@)(@@) الاغر أبو مسلم عنأبي هريرة وأبي سعيد معتقيه وعنه أبو إسحاق وجماعة م 4(@)(@@)(@@)(@@) | 460- (@)(@@) الاغر الرقاشي عن عطية وعنه يحيى بن يمان ق(@)(@@)(@@)(@@) | 461- (@)(@@) أفلت بن خليفة عن جسرة ودهيمة وعنه سفيان وأبو بكر بن عياش صدوق د س(@)(@@)(@@)(@@) | 462- (@)(@@) أفلح بن حميد الانصاري عن القاسم وجماعة وعنه أبو نعيم والقعنبي صدوق توفي 158(@)(@@) خ م د س ق(@)(@@)(@@)(@@) | 463- (@)(@@) أفلح بن سعيد القبائي عن محمد بن كعب وجماعة وعنه زيد بن الحباب والعقدي صدوق توفي 156 م س(@)(@@)(@@)(@@) | 464- (@)(@@) أفلح عن مولاه أبي أيوب وزيد وعنه بن سيرين وجماعة قتل بالحرة م(@)(@@)(@@)(@@) | 0- (@)(@@) أفلح الهمداني عن بن زرير وعنه عبد العزيز والاصح أبو الأفلح س(@)(@@)(@@)(@@) | 465- (@)(@@) أقرع مؤذن عمر عنه عبد الله بن شقيق د(@)(@@)(@@)(@@) | 466- (@)(@@) أمية بن بسطام عن بن عمه يزيد بن زريع ومعتمر وعنه البخاري ومسلم وأبو يعلى وخلق ثقة مات 231 خ م س(@)(@@)(@@)(@@) | 467- (@)(@@) أمية بن خالد أخو هدبة عن شعبة وطبقته وعنه بندار وطائفة ثقة توفي 201 م ت س(@)(@@)(@@)(@@) | 468- (@)(@@) أمية بن صفوان بن أمية بن خلف عن أبيه وكلدة بن حنبل وعنه بن أخيه عمرو وعبد العزيز بن رفيع د ت س(@)(@@)(@@)(@@) | 469- (@)(@@) أمية بن صفوان عن جده وغيره وعنه بن عيينة وعدة م س ق(@)(@@)(@@)(@@) | 470- (@)(@@) أمية بن عبد الله بن خالد بن أسيد المكي عن بن عمر وعنه الزهري وجماعة ثقة ولي خراسان مات سنة نيف وثمانين س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 0- (@)(@@) أمية بن القاسم عن حفص بن غياث وعنه سلمة بن شبيب ت(@)(@@)(@@)(@@) | 471- (@)(@@) أمية بن مخشي له صحبة وعنه مثنى د س(@)(@@)(@@)(@@) | 472- (@)(@@) أمية بن هند عن أبي أمامة بن سهل وعدة وعنه سعيد بن أبي هلال وغيره س ق(@)(@@)(@@)(@@) | 473- (@)(@@) أمية عن أبي مجلز وعنه سليمان التيمي د(@)(@@)(@@)(@@) | 0- (@)(@@) أنس بن أبي أنس عن بن أبي العمياء وعنه عبد ربه بن سعيد الاظهر أنه عمران بن أبي أنس دس ق(@)(@@)(@@)(@@) | 474- (@)(@@) أنس بن حكيم عن أبي هريرة وعنه الحسن وابن جدعان د ق(@)(@@)(@@)(@@) | 475- (@)(@@) أنس بن سيرين عن بن عباس وجندب وعنه 
ms233	 شعبة والحمادان وعدة مات 12 ع(@)(@@)(@@)(@@) | 476- (@)(@@) أنس بن عياض أبو ضمرة عن سهيل وربيعة وعنه أحمد وأحمد بن صالح وأمم ثقة سمح بعلمه جدا عاش ستا وتسعين توفي سنة مائتين ع(@)(@@)(@@)(@@) | 477- (@)(@@) أنس بنمالك الصحابي وله عن عدة من الصحابة وعنه خلق جاوز المائة مات 93 ع(@)(@@)(@@)(@@) | 478- (@)(@@) أنس بن مالك الكعبي أبو أمية له صحبة نزل البصرة وعنه أبو قلابة وآخر 4(@)(@@)(@@)(@@) | 479- (@)(@@) أنس القيسي عن بن عباس وعنه بنت عمه أسماء س(@)(@@)(@@)(@@) | 480- (@)(@@) أنيس بن أبي يحيى الاسلمي عن أبيه وإسحاق بن سالم وعنه ابنا أخيه إبراهيم وعبد الله ويحيى القطان ثقة مات 146 د ت(@)(@@)(@@)(@@) | 481- (@)(@@) أهبان بن أوس الاسلمي صلى القبلتين وعنه مجزأة خ(@)(@@)(@@)(@@) | 482- (@)(@@) أهبان بن صيفي أبو مسلم الغفاري له صحبة وعنه بنته عديسة وزهدم ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 483- (@)(@@) أهبان الغفاري عن أبي ذر وعنه حميد بن عبد الرحمن س(@)(@@)(@@)(@@) | 484- (@)(@@) أوس بن أوس الثقفي صحابي له مسجد بدرب القلي وعنه أبو أسماء الرحبي وجماعة 4(@)(@@)(@@)(@@) | 485- (@)(@@) أوس بن أبي أوس الثقفي صحابي عنه ابنه عمرو وجماعة د س ق(@)(@@)(@@)(@@) | 486- (@)(@@) أوس بن أبي أوسعن أبي هريرة وعنه بن جدعان ت ق(@)(@@)(@@)(@@) | 487- (@)(@@) أوس بن الصامت أخو عبادة بدري أرسل عنه عطاء د(@)(@@)(@@)(@@) | 488- (@)(@@) أوس بن ضمعج عن سلمان وجماعة وعنه إسماعيل بن رجاء وأبو إسحاق وعدة توفي 74 م 4(@)(@@)(@@)(@@) | 489- (@)(@@) أوس بن عبد الله أبو الجوزاء الربعي البصري عن عائشة وصفوان بن عسال وعدة وعنه قتادة وأبو الاشهب وعدة ثقة قتل يوم الجماجم ع(@)(@@)(@@)(@@) | 490- (@)(@@) أوسط البجلي عن أبي بكر وعمر وعنه سليم بن عامر وجماعة شيخ ق(@)(@@)(@@)(@@) | 491- (@)(@@) أوفى بن دلهم العدوي عن معاذة وعدة وعنه عوف وهشام بن حسان ثقة ت(@)(@@)(@@)(@@) | 492- (@)(@@) أويس بن أبي أويس عن أنس وعنه الزهري وقيل صوابه بن أبي أنس س(@)(@@)(@@)(@@) | 493- (@)(@@) إياد بن لقيط السدوسي عن البراء وأبي رمثة وعنه مسعر والثوري ثقة م دت س(@)(@@)(@@)(@@) | 0- (@)(@@) إياس بن ثعلبة هو أبو أمامة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 494- (@)(@@) إياس بن الحارث عن جده معقيب وعنه أبو مكين نوح د س(@)(@@)(@@)(