ms21	 %~% مبادابرام‌ تمهید تغافل گردد ایما را PageV1P0035(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 گذشت‌از چرخ و بگرفت‌آبله چشم‌ثریا را %~% هوایت تاکجا ازپا نشان له ما را(@)(@@) 2 تأمل تا چه درگوش افکند پیمانه ما را %~% نوایی هست درخاطرشک ‌رنگ مینا را(@)(@@) 3 ندارد شور امکان جز به‌کنج فقر آسودن %~% اگر ساحل شوی در آب‌گوهرگیر دریا را(@)(@@) 4 درین‌دریا ز بس فرش است‌اجزای‌شکست من %~% به‌هرسومی‌روم چون موج برخود می‌نهم پا را(@)(@@) 5 به تدبیر دگر نتوان ز داغ‌کلفت آسودن %~% مگرآبی زند خاکستر ما آتش ما را(@)(@@) 6 به‌حال خویشتن نگذاشت دل راشوخی آهم %~% هوایی‌کرد رقص‌گردباد اجزای صحرا را(@)(@@) 7 درین ویرانه همچشم نگاهم‌کز سبکروحی %~% درون خانه‌ام وز خویش خالی کرده‌ام جا را(@)(@@) 8 بهشتی از دل هر ذره در پروز می‌آید %~% اگر در خاک ریزد حسرتم رنگ تمنا را(@)(@@) 9 مبادا ناله ربط داغهای دل زند ببرهم %~% مشوران ای جنون این شعله زنجیر درپا را(@)(@@) 10 تجاهل چون حباب‌از فهم‌هستی مفت جمعیت %~% تو می‌آیی برون زنهار مشکاف این معما را(@)(@@) 11 به هرسو چشم واکردم نگه وقف خطاکردم %~% نمی‌دانم چه پیش آمد من غفلت تقاضا را(@)(@@) 12 همین درد است برگ عشرت خونین‌دلان بیدل %~% هجوم‌گریه مست خنده دارد طبع مینا را PageV1P0036(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 کسی چه شکرکند دولت تمنا را %~% به عالمی‌که تویی ناله می‌کشد ما را(@)(@@) 2 ندرد انجمن یأس ما شراب دگر %~% هم از شکست مگرپرکنیم مینا را(@)(@@) 3 به عالمی‌که حلاوت نشانه ننگ است %~% دو نیم چون نشود دل ز غصه خرما را(@)(@@) 4 هنوز اره دندان موج در نظر است %~% گوهر به دامن راحت چسان‌کشد پا را(@)(@@) 5 درشت‌خو چه خیال است نرم‌گو باشد %~% شرارخیزی محض است طبع خارا را(@)(@@) 6 سلامت آینه اعتبار امکان نیست %~% شکسته‌اند به صد موج رنگ دریا را(@)(@@) 7 صفای دل به‌کدورت مده ز فکر دویی %~% که عکس‌ تنگ برآیینه کند جا را(@)(@@) 8 برون لفظ محال است جلوه معنی %~% همان زکسوت‌اسما طلب مسما را(@)(@@) 9 
ms22	 رسیده‌ایم ز اسما به فهم معنی خویش %~% گرفته‌ایم ز عنقا سراغ عنقا را(@)(@@) 10 هزار معنی پیچیده در تغافل تست %~% به ابروی تو چه نسبت‌زبان‌گویا را(@)(@@) 11 سبکروان به هوایت چنان ز خود رفتند %~% که چون نفس نرساندند برزمین پا را(@)(@@) 12 همیشه تشنه لب خون ما بود بیدل‌ %~% چوشیشه هرکه به دست آورد دل ما را PageV1P0037(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 موج پوشید روی دریا را %~% پرده اسم شد مسما را(@)(@@) 2 نیست بی‌بال اسم پروازش %~% کس ندید آشیان عنقا را(@)(@@) 3 عصمت حسن یوسفی زد چاک %~% پرده طاقت زلیخا را(@)(@@) 4 می‌کشد پنبه هرسحرخورشید %~% تا دهد جلوه داغ دلها را(@)(@@) 5 جاده هرسوگشاده است آغوش %~% که دریده‌ست جیب صحرا را(@)(@@) 6 شعله دل ز چشم تر ننشست %~% ابر ننشاند جوش دریا را(@)(@@) 7 آگهی می‌زند چوآیینه %~% مهر بر لب زبان‌گویا را(@)(@@) 8 قفل‌گنج زر است خاموشی %~% از صدف پرس این معما را(@)(@@) 9 بیدل ار واقفی ز سر یقین %~% ترک‌کن قصه من وما را PageV1P0038(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 نزیبد پرده فانوس دیگر شمع سودا را %~% مگردرآب چون یاقوت‌گیرند آتش ما را(@)(@@) 2 دل آسوده ما شور امکان در قفس دارد %~% گهر دزدیده‌است اینجاعنان موج‌دریا را(@)(@@) 3 بهشت عافیت رنگ جهان آبرو باشی %~% درآغوش نفس‌گر خون‌کنی عرض تمنا را(@)(@@) 4 غبار احتیاج آنجاکه دامان طلب‌گیرد %~% روان است آبرو هرگه به رفتارآوری پا را(@)(@@) 5 به‌عرض بیخودیهاگرم‌کن هنگامه مشرب %~% که می‌نامیده‌اند اینجا شکست رنگ مینا را(@)(@@) 6 فروغ این شبستان جز رم برقی نمی‌باشد %~% چراغان‌کرده‌اند از چشم آهوکوه و صحرا را(@)(@@) 7 دراین‌محفل‌پریشان‌جلوه‌است آن‌حسن یکتایی %~% شکستی‌کوکه پردازی دهد آیینه ما را(@)(@@) 8 سبکتازاست شوق امامن آن سنگ زمینگیرم %~% که‌دررنگ شرراز خویش خالی می‌کنم جا را(@)(@@) 9 به‌داغ بی‌نگاهی رفت‌ازین محفل چراغ من %~% شکست آیینه رنگی‌که‌گم‌کردم تماشا را(@)(@@) 10 هوس چون نارسا شد نسیه نقدحال می‌گردد %~% امل را رشته‌کوته ساز و عقباگیر دنیا را(@)(@@) 11 ز شور بی‌نشانی‌ بی‌نشانی شد نشان بیدل %~% که‌گم‌گشتن زگم‌گشتن 
ms23	 برون آورد عنقا را PageV1P0039(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 نسیم شانه‌کند زلف موج دریا را %~% غبار سرمه دهد چشم‌کوه و صحرا را(@)(@@) 2 ز زخم اره دندان موج ایمن نیست %~% گهر به دامن راحت چسان‌کشد پا را(@)(@@) 3 لبش به حلقه آغوش خط بدان ماند %~% که خضرتنگ به برمی‌کشد مسیحا را(@)(@@) 4 عدمسرای دلم کنج عزلتی دارد %~% که راه نیست در او وهم بال عنقا را(@)(@@) 5 حدیث نرم نمی‌آید از زبان درشت %~% شرار خیز بود طبع سنگ خارا را(@)(@@) 6 همیشه‌تشنه‌لب‌خون مابودبیدل %~% چوشیشه هرکه به دست آورد دل ما را PageV1P0040(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 نفس آشفته می‌دارد چوگل جمعیت ما را %~% پریشان می‌نویسدکلک موج احوال دریا را(@)(@@) 2 در این وادی‌که می‌بایدگذشت از هرچه پیش آید %~% خوش‌آن رهروکه در دامان دی پیچید فردا را(@)(@@) 3 ز درد مطلب نایاب تاکی‌گریه سرکردن %~% تمنا آخر از خجلت عرق‌کرد اشک رسوا را(@)(@@) 4 به‌این فرصت مشو شیرازه بندنسخه هستی %~% سحر هم در عدم خواهد فراهم‌کرد اجزا را(@)(@@) 5 گداز درد الفت فیض اکسیر دگر دارد %~% ز خون‌گشتن توان در دل‌گرفتن جمله‌اعضا را(@)(@@) 6 یه جای ناله می‌خیزد غبار خاکسارانت %~% صداگردی‌ست یکسر ساغر نقش قدمها را(@)(@@) 7 به آگاهی چه امکانست‌گردد حمع خوددا‌ری %~% که باهر موج می‌بایدگذشت از خویش دریارا(@)(@@) 8 دراین‌گلشن‌چوگل‌یک پرزدن‌رخصت‌نمی‌باشد %~% مگر از رنگ یابی نسخه بال افشانی ما را(@)(@@) 9 فلک تکلیف جاهت‌گرکند فال حماقت زن %~% که غیر ازگاو نتواندکشیدن بار دنیا را(@)(@@) 10 چرا مجنون ما را درپریشانی وطن نبود %~% که‌از چشم غزالان‌خانه‌بردوش است صحرا‌را(@)(@@) 11 نزاکتهاست در آغوش میناخانه حیرت %~% مژه برهم مزن تا نشکنی رنگ تماشا را(@)(@@) 12 سیه روزی فروغ تیره‌بختان بس بود بیدل %~% ز دود خویش باشد سرمه چشم داغ دلها را PageV1P0041(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 نگاه وحشی لیلی چه افسون‌کرد صحرا را %~% که‌نقش پای آهو چشم‌مجنون‌کرد صحرارا(@)(@@) 2 دل از داغ محبت‌گر به این دیوانگی بالد %~% همان‌یک‌لاله‌خواهدطشت‌پرخون‌کرد‌صحرارا(@)(@@) 3 بهار تازه‌رویی حسن فردوسی دگر دارد %~% گشاد جبهه رشک ربع 
ms24	 مسکون‌کرد صحرا را(@)(@@) 4 به پستی در نمانی‌گر به آسودن نپردازی %~% غبارپرفشان هم دوش‌گردون‌کرد صحرا را(@)(@@) 5 دماغ اهل مشرب با فضولی برنمی‌آید %~% هجوم این عمارتها دگرگون‌کرد صحرا را(@)(@@) 6 ز خودداری ندانستیم قدر عیش آزادی %~% دل غافل به‌کنج خانه مدفون‌کرد صحرا را(@)(@@) 7 ندانم گردباد از مکتب فکرکه می‌آید %~% که‌این یک مصرع پیچیده موزون‌کردصحرارا(@)(@@) 8 به قدر وسعت است آماده استعداد ننگی هم %~% بلندی ننگ چین بردامن افزون‌کرد صحرارا(@)(@@) 9 غبارم را ندانم در چه عالم افکند یارب %~% غم آزادیی‌کز شهر بیرون‌کرد صحرا را(@)(@@) 10 به‌کشتی از دل مأیوس باید بگذرم بیدل %~% شکست‌این‌آبله‌چندان‌که‌جیحون‌کردصحرا را PageV1P0042(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 دوروزی فرصت آموزد درود مصطفا ما را %~% که پیش از مرگ در دنیا بیامرزد خدا ما را(@)(@@) 2 درتن صحراکجا با خویش فتد اتفاق ما %~% که وهم بی‌سر وپایی برد از خود جدا ما را(@)(@@) 3 به‌گردشخانه چرخیم حیران دانه چندی %~% غبارما مگربیرون برد زین‌آسیا ما را(@)(@@) 4 اگر امروز دل با خاک را‌ه مرتضی جوشد %~% کند محشورفردا فضل حق با اصفیا ما را(@)(@@) 5 به حرف و صوت ممکن نیست ازعالم برون جستن %~% چه سازدکس‌ زگنبد برنمی‌آرد صدا ما را(@)(@@) 6 زسعی دست وپا آیینه مقصد نشد روشن %~% کجایی ای ز خود رفتن توچیزی وانما ما را(@)(@@) 7 غبار ما به صحرای عدم بال دگر می‌زد %~% فضولی درکجا انداخت یارب ازکجا ما را(@)(@@) 8 کباب خوان جنت لذت خون جگر دارد %~% قضا چندی به ذوق ین غذا داد اشتها ما را(@)(@@) 9 کف خاک نفس بال وپریم‌ ازضبط ما بگذر %~% به‌گردون می‌برد چون صبح‌از خوداین هوا مارا(@)(@@) 10 جنونها داشتیم اما حجاب فقر پیش آمد %~% ز ضبط ناله‌کرد آگاه نی در بوربا ما را(@)(@@) 11 نقس‌واری مگر در دل خزد امید آسودن %~% که زبرآسمان پیدا نشد جا هیچ‌جا ما را(@)(@@) 12 دل افسرده از ما غیر بیکاری نمی‌خواهد %~% حنا بسته‌ست این یک قطره خون سر تا به پا ما را(@)(@@) 13 
ms25	 ز دل امید الفت بود با هسر ناامیدیها %~% به این بیگانه هم‌گاهی نکردند آشنا ما را(@)(@@) 14 به عریانی‌کسی آگه نبود از حال ما بیدل %~% چه‌رسوایی‌که آمد پیش در زیر قبا ما را PageV1P0043(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 به خاک تیره آخر خودسریها می‌برد ما را %~% چو آتش‌گردن‌افرازی ته پا می‌برد ما را(@)(@@) 2 غبار حسرت ما هیچ ننشست اززمینگیری %~% که‌هرکس می‌رود چون‌سایه از جامی‌برد مارا(@)(@@) 3 ندارد غارت ما ناتوانان آنقدرکوشش %~% غباریم وتپیدن ازکف ما می‌برد ما را(@)(@@) 4 به‌گلزاری‌که شبنم هم امید رنگ بو دارد %~% نگاه هرزه جولان بی‌تمنا می‌برد ما را(@)(@@) 5 گر از دیر وارستیم شوق‌عبه پیش آمد %~% تک وپوی نفس یارب‌کجاها می‌برد ما را(@)(@@) 6 به یستیهای آهنگ هلب خفته‌ست مفراجی %~% نفس‌گر واگذارد تا مسیحا می‌برد ما را(@)(@@) 7 در آغوش خزان ما دو عالم رنگ می‌بازد %~% ز خود رفتن به‌چندین جلوه یک‌جا می‌برد مارا(@)(@@) 8 گسستن نیست آسان ربط الفتهای این محفل %~% چو شمع آتش عنانی رشته برپامی‌برد ما را(@)(@@) 9 دکان‌آرایی هستی‌گر این خجلت‌کند سامان %~% عرق تا خاک گردیذن به دریا می‌برد ما را(@)(@@) 10 اگر عبرت ره تحقیق مطلب سرکند بیدل %~% همین یک پیش پا دیدن به عقبا می‌برد ما را PageV1P0044(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 ز بزم وصل‌ خواهشهای بیجا می‌برد ما را %~% چوگوهر موج ما بیرون دریا می‌برد ما را(@)(@@) 2 ندارد شمع ما را صرفه سیر محفل امکان %~% نگه تا می‌رود ازخود به یغما می‌برد ما را(@)(@@) 3 چو فریاد جرس ماییم جولان پریشانی %~% به‌هر راهی‌که‌خواهد بی‌خودیها می‌برد ما را(@)(@@) 4 جنون می‌ریزد از ما رنگ آتشخانه عالم %~% به هرجا مشت خاری شد تقاضا می‌برد ما را(@)(@@) 5 چوکار نارسای عاجزان با اینهمه پستی %~% به جز دست دعا دیگرکه بالا می‌برد ما را(@)(@@) 6 همان چون سایه ما و سجده شکرجبین سایی %~% که تا آن آستان بی‌زحمت پا می‌برد ما را(@)(@@) 7 ز وحشت شعله ما مژده خاکستری دارد %~% پرافشانی به طوف بال 
ms26	 عنقا می‌برد ما را(@)(@@) 8 ندارد نشئه آزادی ما ساغر دیگر %~% غبار دامن‌افشاندن به صحرا می‌برد ما را(@)(@@) 9 مدارایی به یاران می‌کند تمکین ما ورنه %~% شکست‌رنگ از این محفل چومینا می‌برد ما را(@)(@@) 10 نه‌گلشن را زما رنگی نه صحرا را زماگردی %~% به هرجا می‌برد شوق تو بی‌ما می‌برد ما را(@)(@@) 11 گداز درد توفان‌کرد دست از ما بشو بیدل %~% نبرد این سیل اگر امروز فردا می‌برد ما را PageV1P0045(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 جنون‌کی قدردان‌کوه و هامون می‌کند ما را %~% همان فرزانگی روزی دومجنون می‌کند ما را(@)(@@) 2 نفس هر دم‌زدن صدصبح محشر فتنه می‌خندد %~% هوای باغ موهومی چه افسون می‌کند ما را(@)(@@) 3 کسی یا رب مبادا پایمال رشک همچشمی %~% حنا چندان که بوسد دست او خون می‌کند ما را(@)(@@) 4 چو صبح آنجاکه خاک آستانش در خیال آید %~% همه گر رنگ می‌گردم‌که‌گردون می‌کند ما را(@)(@@) 5 تماشای غرور دیگران هم عالمی دارد %~% به‌روی زر نشست سکه‌ قارون می‌کند ما را(@)(@@) 6 حساب چون و چند اعتبار دفتر هستی %~% به‌جزصفرهوس برما چه افزون می‌کند ما را(@)(@@) 7 حباب ما اگر زین بحر باشد جرعه هوشش %~% که تکلیف شراب از جام واژون می‌کند ما را(@)(@@) 8 فنا از لوح امکان نقش هستی حک‌کند ورنه %~% عبارت هرچه باشد ننگ‌مضمون می‌کند مارا(@)(@@) 9 همه گر آفتاب آییم در دورانگه عشرت %~% کسوفی هست‌کاخر در می افیون می‌کندمارا(@)(@@) 10 ز ساز سرو و بید این چمن و آواز می‌آید %~% که آه از بی‌بری نبودکه موزون می‌کند ما را(@)(@@) 11 شبستان معاصی صبح رحمت آرزو دارد %~% همین رخت سیه محتاج صابون می‌کند مارا(@)(@@) 12 کسی تا چند بیدل کلفت تعمیر بردارد %~% فشار بام و در از خانه بیرون می‌کند ما را PageV1P0046(@)(@@)(@@)(@@) || [genre: Gh](@)(@@) 1 در عالمی‌که با خود رنگی نبود ما را %~% بودیم هرچه بودیم او وانمود ما را(@)(@@) 2 مرآت معنی ما چون سایه داشت زنگی %~% خورشید التفاتش از ما زدود ما را(@)(@@) 3 
