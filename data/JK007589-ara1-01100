ms1096	 والقوام % % 137(@)(@@) % يروقك أو يروعك لابظلم % % كما يتلون السيف الحسام % % 138(@)(@@) % يضاحك تارة ويكون أخرى % % بحيث تهزه قصر وهام % % 139(@)(@@) % فآونة لصفحته انبلاج % وآونة لشفرته اصطلام % % 140(@)(@@) % أخو قلم صروف الدهر منه % % ففيه العيش والموت الزؤام % % PageV01P4188 141(@)(@@) % كتابته مناقفة العوالي % % وليست ما يرقشه القلام % % 142(@)(@@) % ضئيل شأنه شأن نبيل % يطوع لأمره الجيش اللهام % 143(@)(@@) % به تبدو الصوارم حين تخفى % % وتخفى حين تبدو والخدام % % 144(@)(@@) % إذا سكنات صاحبه أملت % على حركاته سكن الأنام % % 145(@)(@@) % أخو ثقة إذا الأقلام أضحت % بني حمان عمهم الزكام % % 146(@)(@@) % أمين في معابيه أمون % سليم الأنف ليس به زكام % % 147(@)(@@) % تمج الفيء والمعروف مجا % % وللأقلام حطم وانتقام % % 148(@)(@@) % بكف فتى له نفع وضر % وإنعام يؤمل وانتقام % 149(@)(@@) % يقلبه برأي لاتجزا % % ولايخبو لقدحته ضرام % % 150(@)(@@) % وزير للوزير يرى فيغني % % إذا طرقت مجلحة جلام % % PageV01P4189 151(@)(@@) % له عزم إذا نفذ ارتياء % وإمضاء إذا وقع اعتزام % % 152(@)(@@) % فما لعزيمة منه انفلال % ولا لضريمة منه اقتحام % % 153(@)(@@) % ولا في عقدة منه انحلال % ولا في عروة منه انفصام % % 154(@)(@@) % متى ما انشام في غيب صواب % نعاه ابن الحسين فلا انشيام % % 155(@)(@@) % يبيت أبو الحسين يرى أمورا % لها في سدفة الغيب اكتمام % % 156(@)(@@) % يراه أبو الحسين وإن توارى % % كبرت فغيرك الغر الغلام % 157(@)(@@) % ص وغير قناعك الجعد السخام % وأمسى ماء وجهك غاض عنه % % 158(@)(@@) % فماء شؤونك الفيض السجام % % وأصبحت الظباء مجانبات % 159(@)(@@) % جنابك مالها فيه بغام % وقد يألفنني ومعي سهامي % % 160(@)(@@) % فما هذا النفار ولاسهام % % أأوحشها وقد نصلت نبالي % % PageV01P4190 161(@)(@@) % وأونسها وفي نبلي الحمام % % ليالي لاتزال لدي صرعى % % 162(@)(@@) % لرشقي في مقاتلها احتكام % % ألا جاد الحيا تلكم ظباء % 163(@)(@@) % تزينها المقاصر لا الخيام % % عتقن فهن من قرب ملاح % 164(@)(@@) % ورقن فهن من بعد فخام % % إلى الله الشكاة من اللواتي % % 165(@)(@@) % مساكنها الرصافة لا الرجام % % بحيث تجبح الهدي قذما % % 166(@)(@@) % وهاشم الأكارم لا هشام % % مريضات الجفون لغير داء % 167(@)(@@) % لمن لابسنه الداء العقام % % سقام عيونهن سقام قلبي % % 168(@)(@@) % وقد يهدي السقام لك السقام % % أعاذلتي وحبلي 
ms1097	 قد تداعى % % 169(@)(@@) % وللحبل اتصال وانجذام % كأن مناعمي حلم تقضى % % 170(@)(@@) % وأسراري مع الخلل احتلام % % كسيت البيض أخلاقا رماما % % PageV01P4191 171(@)(@@) % فوصل البيض أخلاق رمام % % فلا يتشتتن عليك رأي % 172(@)(@@) % فما للبيض والبيض التئام % % بليت سوى المشيب غدا جديدا % % 173(@)(@@) % علي الفد منه والتؤام % وكنت كروضة للعين أضحت % 174(@)(@@) % وما من نورها إلا النغام % % وعبست الحسان إلى مشيبي % % 175(@)(@@) % فما لثغورها برق يشام % % وما يرجى من البيض ابتسام % 176(@)(@@) % لمن أمسى لمفرقه ابتسام % % كأن محاسني لم تضح يوما % % 177(@)(@@) % وفي لحظاتهن لها اقتسام % % كأني لمأر اللمحات نحوي % % 178(@)(@@) % وفي اللمحات لثم والتزام % % لئن ودعت جهلي غير قولي % % 179(@)(@@) % ألا سقيت معاهدنا القدام % لقد يهتزلي غصن رطيب % 180(@)(@@) % وقد يرتج لي دعص ركام % % ويسقيني شفاء النفس ثغر % PageV01P4192 181(@)(@@) % ويسقيني شفاء الوجد جام % % ويسمعني رقاة الهم شدوا % % 182(@)(@@) % تغادر كل يوم وهو رام % سماع إن أردت إدام عيش % % 183(@)(@@) % فذاك من السماع له إدام % % عجيب كالحبيب له هنات % 184(@)(@@) % بها يشفى الجوى وبها يهام % % بأخضر جاده طل ووبل % 185(@)(@@) % وما جرمته بينهما الرهام % % غواد لاتفرط أو سوار % 186(@)(@@) % روائم لا يزال لها رزام % % فوردته وشقرته احمرار % 187(@)(@@) % وحمرته وخضرته ادهمام % تقسم أمره شجر وروض % 188(@)(@@) % عليه من زواهره فدام % كساه الغيث كسوته فأضحى % % 189(@)(@@) % له منها ائتزار واعتمام % % يظل وللرياح به اصطخاب % % 190(@)(@@) % وللعجم الفصاح به اختصام % % وللقضب اللدان به اعتناق % PageV01P4193 191(@)(@@) % وللأنوار فيهن التئام % % تراه إذا تجاوب طائراه % 192(@)(@@) % تجاوب عثعثا فيه زنام % حمام الأيك يسعده هزار % 193(@)(@@) % فدى المكاء ذينك والسمام % % وأخلاط من الغردات شتى % % 194(@)(@@) % حواسر أو عليهن الكمام % % ألا لا عيش لي إلا زهيدا % % 195(@)(@@) % ودون لثام من أهوى لثام % % وكم نادمت راح الروح فاه % 196(@)(@@) % ولكن خانني ذاك الندام % % كأني لم أبت أسقى رضابا % 197(@)(@@) % يموت به ويحيا المستهام % % تعللنيه واضحة الثنايا % % 198(@)(@@) % كأن لقاءها حولا لمام % % تنفس كالشمول ضحى شمال % 199(@)(@@) % إذا ما فض عن فمها الختام % % وتسقيك الذي يشفي ويدوي % % 200(@)(@@) % ففي الأحشاء برد واضطرام % وقالوا 
ms1098	 لو أدار الراح كانت % % PageV01P4194 201(@)(@@) % له عوضا وفارقه الهيام % فقلت مدام أفواه الغواني % % 202(@)(@@) % مدام لا يعادله مدام % عزاؤك عن شباب نال منه % % 203(@)(@@) % رمان فيه لين واعتزام % % فقبلك قام أقوام قعود % 204(@)(@@) % لريب الدهر أوقعد القيام % % وما ينفك يلقى الكره فيه % 205(@)(@@) % فئام قد تقدمه فئام % % إذا أدار على بني حام وسام % 206(@)(@@) % كؤوسا مرة حام وسام % % نهار شكله في اللون سام % 207(@)(@@) % وليل شكله في اللون حام % % وهذا الدهر أطوار تراها % % 208(@)(@@) % وفيها الشهد يجنى والسمام % % فأعوام كأن العام يوم % 209(@)(@@) % وأيام كأن اليوم عام % % كدأب النحل أري أو حمات % 210(@)(@@) % ودأب النخل شوك أو جرام % % ولاتجزع فصرف الدهر كلم % PageV01P4195 211(@)(@@) % وتعفية وإن دميت كلام % % سيسليك الشبيبة أريحي % 212(@)(@@) % بجود يديه أورقت السلام % % يحل من المكارم والمعالي % % 213(@)(@@) % بحيث الرأس منها والسنام % % له ذكر إليها مستراح % 214(@)(@@) % وناحية إليها مستنام % % مدبر دولة وقوام ملك % 215(@)(@@) % كهمتك المدبر والقوام % % يروقك أو يروعك لابظلم % % 216(@)(@@) % كما يتلون السيف الحسام % % يضاحك تارة ويكون أخرى % % 217(@)(@@) % بحيث تهزه قصر وهام % % فآونة لصفحته انبلاج % 218(@)(@@) % وآونة لشفرته اصطلام % % أخو قلم صروف الدهر منه % % 219(@)(@@) % ففيه العيش والموت الزؤام % % كتابته مناقفة العوالي % % 220(@)(@@) % وليست ما يرقشه القلام % % ضئيل شأنه شأن نبيل % PageV01P4196 221(@)(@@) % يطوع لأمره الجيش اللهام % به تبدو الصوارم حين تخفى % % 222(@)(@@) % وتخفى حين تبدو والخدام % % إذا سكنات صاحبه أملت % 223(@)(@@) % على حركاته سكن الأنام % % أخو ثقة إذا الأقلام أضحت % 224(@)(@@) % بني حمان عمهم الزكام % % أمين في معابيه أمون % 225(@)(@@) % سليم الأنف ليس به زكام % % تمج الفيء والمعروف مجا % % 226(@)(@@) % وللأقلام حطم وانتقام % % بكف فتى له نفع وضر % 227(@)(@@) % وإنعام يؤمل وانتقام % يقلبه برأي لاتجزا % % 228(@)(@@) % ولايخبو لقدحته ضرام % % وزير للوزير يرى فيغني % % 229(@)(@@) % إذا طرقت مجلحة جلام % % له عزم إذا نفذ ارتياء % 230(@)(@@) % وإمضاء إذا وقع اعتزام % % فما لعزيمة منه انفلال % PageV01P4197 231(@)(@@) % ولا لضريمة منه اقتحام % % ولا في عقدة منه انحلال % 232(@)(@@) % ولا في عروة منه انفصام % % متى ما انشام في غيب صواب 
ms1099	 % 233(@)(@@) % نعاه ابن الحسين فلا انشيام % % يبيت أبو الحسين يرى أمورا % 234(@)(@@) % لها في سدفة الغيب اكتمام % % يراه أبو الحسين وإن توارى % % 235(@)(@@) % بعين لا تكل ولاتنام % % ولولا حمله الأثقالأضحت % % 236(@)(@@) % ظهور معاشر ولها انحطام % % ولكن قد تحملها ضليع % 237(@)(@@) % له في الخطب حزم واحتزام % % محمد بن أحمد بن يحيى % % 238(@)(@@) % لأنف عدو نعمته الرغام % % وغرس الأصبغي كفاك غرسا % % 239(@)(@@) % إذا غرس الهشيم أو الحطام % % تخيره الوزير وزير صدق % 240(@)(@@) % وللوزراء خبط واعتيام % % فرأفته بنا فوق التمني % % PageV01P4198 241(@)(@@) % إذا كثر التغطرس والعرام % % ونائله لنا فلنا اقتراع % 242(@)(@@) % على نفحاته ولنا استهام % % ولاعات يصول على ضعيف % 243(@)(@@) % صيال الفيل هاج به اغتلام % % نساس ولانجاس وكم عداء % 244(@)(@@) % غدا لمآثم منه الندام % % وقد نحدى كما تحدى المطايا % % 245(@)(@@) % وقد نرعى كما ترعى البهام % % فتى ضامت يداه الدهر حتى % % 246(@)(@@) % تعز به المضيم فما يضام % % يزيدك كلما أغليت حمدا % % 247(@)(@@) % به ربحا وفيه لك انهضام % كذا أخلاق مبتاعي المعالي % % 248(@)(@@) % ترفع كلما رفع استيام % % يجود فجوده كرم ودين % 249(@)(@@) % بعض الجود بذخ أو وئام % % تناهب ماله شرق وغرب % 250(@)(@@) % ولما يعفه يمن وشام % % فأصبح والثناء عليه فرض % PageV01P4199 251(@)(@@) % على هذا الورى حتم لزام % % جديرا أن يحوز الحمد عفوا % 252(@)(@@) % إذا ماعز من حمد مرام % % بمال لا يشد عليه عقد % 253(@)(@@) % وجاه لا يحل له حزام % % أقامهما لملتمس جداه % 254(@)(@@) % كريم للكرام به ائتمام % % تقاسم وجهه ويداه منه % % 255(@)(@@) % محاسن لا يعفيها القتام % % فأقسام المكارم في يديه % 256(@)(@@) % وللوجه الوضاءة والقسام % فليست تشرق الآفاق إلا % % 257(@)(@@) % إذا طلعت محاسنه الوسام % % رأى الضليل قصد هداه فيه % % 258(@)(@@) % وأسهب في ممادحه العبام % % مكارمه إذا ذكرت جبال % 259(@)(@@) % وكم قوم مكارمهم رضام % % تعودت المحامد والعطايا % % 260(@)(@@) % أنامل منه نائلها انسجام % % فليس لها عن الحمد انفراج % PageV01P4200 261(@)(@@) % وليس لها على المال انضمام % % لبدأته حيا ومتى عرضنا % % 262(@)(@@) % لعودته فليس لها جهام % % يبادر أن يصل المال حتى % % 263(@)(@@) % كأن المال يملكه لحام % % وليس يصل صفو التبر لكن % % 264(@)(@@) % له 
ms1100	 في ماله حد هذام % % وليس أمام نائله عبوس % 265(@)(@@) % وليس وراءه منه ندام % % يساقطه الندى حتى تراه % 266(@)(@@) % وليس لجانب منه ادعام % % ويمسكه الحجا حتى تراه % % 267(@)(@@) % ومافي جانب منه انثلام % % لذلك لاتزال له عطايا % % 268(@)(@@) % لهن على مؤمله ازدحام % % كما ليست تزال له دواة % 269(@)(@@) % لداه في مهالكها ارتطام % % وبادي الجهل جاوده فقلنا % % 270(@)(@@) % متى استعلى على النخل البشام % % وساهي العقل ناجده فقلنا % % PageV01P4201 271(@)(@@) % متى أربى على النبع الثمام % % أما وأبي الحسين فداه قوم % 272(@)(@@) % لهم نعم وأكثرهم نعام % % لمولني إلى أن قال أهلي % % 273(@)(@@) % أأحلام يخيلها منام % % وقومني إلى أن قام عودي % % 274(@)(@@) % فما في متنه أود يقام % % برأي لست أبرح منه أضحى % % 275(@)(@@) % وجود لا أزال له أغام % % نفت جهلي نهاه وشيبتني % % 276(@)(@@) % لهاه فها أنا الكهل الغلام % % فدته النفس من بان كريم % % 277(@)(@@) % مبانيه المكارم لا الرخام % % بني لي همتي حتى تعالت % 278(@)(@@) % وكانت مرة وهي اهتمام % % أسائلتي حججت البيت إني % % 279(@)(@@) % حججت فتى المروءة يا أدام % % حججت أبا الحسين وكان حجي % % 280(@)(@@) % إليه لا يذم ولا يذام % % أقبل كفه وأعل منها % % PageV01P4202 281(@)(@@) % ندى يشفى به مني الأوام % % فلي من بطن راحته ارتواء % % 282(@)(@@) % ولي في ظهر راحته استلام % % ظللت بمأمن منه حريز % 283(@)(@@) % يخيل أنه البيت الحرام % % وزمزم والحطيم لدي منه % % 284(@)(@@) % هنالك والمشاعر والمقام % % مقام تنشد الأمداح تترى % % 285(@)(@@) % ويرعى الحق فيه والذمام % % وكم نضو أناخ بها إليه % % 286(@)(@@) % تضيفها المجادب والسآم % % أتته تجوب عرض الأرض جوبا % 287(@)(@@) % إليه لها خبيب وارتئام % % إذا قطعت من الموماة مرتا % 288(@)(@@) % من الأمرات ليس به علام % % ولليعفور في الكز انغماس % 289(@)(@@) % وللحرباء في الضح اصطخام % % تطاير عن مناسمها حصاه % 290(@)(@@) % وسافر عن مشافرها اللغام % % على ثقة بأن سترى وترعى % % PageV01P4203 291(@)(@@) % ربيعا للطليح به مسام % % وأن ستفيء تامكة الأعالي % % 292(@)(@@) % كأن سنامها الرعن الخشام % % فوافت لا ربيع الحول لكن % % 293(@)(@@) % ربيع الدهر ليس له انصرام % % مراد معيشة ومعان علم % % 294(@)(@@) % يدل على فضيلته الزحام % % معان في موارده شفاء 