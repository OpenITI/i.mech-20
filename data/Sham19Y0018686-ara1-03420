ms3401	 الأولون}(@)(@@) تكذيبا للبعث واستبعادا له، فقال الله تعالى لنبيه - صلى الله عليه وسلم -:(@)(@)(@@)(@@)(@@) || AUTO 49(@)(@)(@@) - {قل} يا محمد لهم {إن الأولين} من آبائكم (¬2) {والآخرين} منكم(@)(@)(@@)(@@)(@@) || AUTO 50(@)(@)(@@) - {لمجموعون إلى ميقات يوم معلوم(@)(@)(@@)(@@)(@@) || AUTO (50)(@)(@)(@@) } أي: ميعاد، القيامة(@)(@)(@@)(@@)(@@) || AUTO 51(@)(@)(@@) - ثم يقال لهم: {ثم إنكم أيها الضالون} عن الهدى (¬3) {المكذبون} بالبعث(@)(@)(@@)(@@)(@@) || AUTO 52(@)(@)(@@) - {لآكلون من شجر من زقوم(@)(@)(@@)(@@)(@@) || AUTO (52)(@)(@)(@@) } وهو شجر كريه الطعم والمنظر(@)(@@) وهي التي ذكرت في سورة الصافات (¬4).(@)(@)PageV25P491(@)(@)(@@)(@@)(@@) || CHECK 54(@)(@)(@@)(@@)(@@) || AUTO 53(@)(@)(@@) - {فمالئون منها} يعني: من الشجرة (¬1) {البطون(@)(@)(@@)(@@)(@@) || AUTO (53)(@)(@)(@@) فشاربون عليه}(@)(@@) أي: على الأكل، وقيل: على الشجر، لأنه يذكر ويؤنث {من الحميم} من الماء الذي قد اشتد غليانه (¬2) وهو صديد أهل النار (¬3).(@)(@)(@@)(@@)(@@) || AUTO 55(@)(@)(@@) - {فشاربون شرب الهيم(@)(@)(@@)(@@)(@@) || AUTO (55)(@)(@)(@@) } قراءة نافع، وشيبة، وأبو جعفر، والأعرج(@)(@@) والزهري، وطلحة، والأعمش، ويحيى، وعاصم، وحمزة، وأيوب، وسلام {شرب} بضم الشين (¬4) واختاره أبو حاتم، وقرأ الباقون بفتحها (¬5) واختاره أبو عبيد (¬6).(@)(@)PageV25P492(@)(@)(@@) وروى الكسائي (¬1) عن يحيى بن سعيد (¬2) عن ابن جريج (¬3) أنه قال: ذكرت لجعفر بن محمد (¬4) قراءة أصحاب عبد الله (¬5) بالفتح، قال نعم، أما بلغك أن النبي - صلى الله عليه وسلم - بعث بديل بن ورقا" (¬6) - رضي الله عنه - إلى أهل منى في أيام التشريق فقال: "أيها الناس لا تصوموا فإنها أيام أكل وشرب وبعال" (¬7).(@)(@)PageV25P493(@)(@)(@@) بفتح الشين (¬1) وهما لغتان جيدتان.(@)(@@) تقول العرب: شربت شربا وشربا وشربا بضمتين (¬2).(@)(@@) قال أبو زيد الأنصاري: سمعت العرب تقول: بفتح الشين وضمها وكسرها، والفتح هو المصدر الصحيح، لأن كل مصدر من ذوات الثلاثة فأصله فعل، ألا ترى أنك ترده إلى المرة الواحدة، فتقول: فعلة نحو شربة، وبالضم الاسم ويؤدي عن المصدر (¬3)، و {الهيم}: الإبل العطاش (¬4) وقال عكرمة، وقتادة: هو داء يأخذ الإبل، لا يروى معه ولا يزال يشرب حتى يهلك (¬5) يقال لذلك: الداء PageV25P494(@)(@@) الهيام (¬1)، وجمل أهيم، وناقة هيماء وإبل هيم (¬2).(@)(@@) قال لبيد:(@)(@@) أجزت إلى معارفها بشعث (¬3) ... وأطلاح (¬4) من العيدي (¬5) هيم (¬6)(@)(@@) وقال الضحاك وابن عيينة وابن كيسان: الهيم الأرض السهلة، ذات الرمل (¬7).(@)(@)(@@)(@@)(@@) || AUTO 56(@)(@)(@@) - {هذا نزلهم} أي: رزقهم وغذاؤهم وما أعد لهم (¬8).(@)(@)PageV25P495(@)(@)(@@) {يوم الدين} 
ms3402	 أي: يوم الجزاء (¬1)، وقرأ ابن أبي إسحاق والجحدري وعباس: (نزلهم) بإسكان الزاي (¬2).(@)(@)(@@)(@@)(@@) || AUTO 57(@)(@)(@@) - {نحن خلقناكم فلولا} أي: فهلا (¬3).(@)(@@) {تصدقون} بالبعث كما تعلمون إن الله خالقكم (¬4).(@)(@)(@@)(@@)(@@) || AUTO 58(@)(@)(@@) - قوله عز وجل: {أفرأيتم ما تمنون(@)(@)(@@)(@@)(@@) || AUTO (58)(@)(@)(@@) }(@)(@@) ما تصبون في الأرحام من المني (¬5) وقرأ أبو السمال، ومحمد بن PageV25P496(@)(@@) السميفع وأشهب العقيلي: (ما تمنون) بفتح التاء، وهما لغتان (¬1).(@)(@)(@@)(@@)(@@) || AUTO 59(@)(@)(@@) - {أأنتم تخلقونه} أي: تصورون منه الإنسان (¬2).(@)(@@) {أم نحن الخالقون} المقدرون المصورون (¬3).(@)(@)(@@)(@@)(@@) || AUTO 60(@)(@)(@@) - {نحن قدرنا}(@)(@@) قرأ مجاهد، وحميد، وابن محيصن، وابن كثير (قدرنا) مخففا (¬4)، وشدد الباقون، أي: {نحن قدرنا} (¬5).(@)(@)PageV25P497(@)(@)(@@) {بينكم الموت} فمنكم من يعيش إلى أن يبلغ الهرم، ومنكم من يموت شابا وصبيا وصغيرا (¬1)، وعن الضحاك ساوى بين أهل السماء وأهل الأرض (¬2).(@)(@@) وقيل: كتبنا على مقدار سواء لا زيادة فيه ولا نقصان (¬3).(@)(@@) {وما نحن بمسبوقين} بمغلوبين عن إهلاككم وإبدالكم بأمثالكم (¬4) فذلك قوله:(@)(@)(@@)(@@)(@@) || AUTO 61(@)(@)(@@) - {على أن نبدل أمثالكم وننشئكم} ونخلقكم.(@)(@@) {في ما لا تعلمون} من الصور (¬5).(@)(@@) قال مجاهد: في أي خلق نشاء، يقول: نغير خلقكم كيف نشاء (¬6) PageV25P498(@)(@@) وقيل: نبعثكم في وقت لا تعلمون به (¬1).(@)(@@) وقال سعيد بن المسيب: في قوله: {في ما لا تعلمون} يعني: في حواصل طير سود، تكون ببرهوت (¬2) كأنها الخطاطيف (¬3) وبرهوت واد باليمن (¬4).(@)(@@) وقال الحسن: {وننشئكم في ما لا تعلمون (61)} أي: نبدل صفاتكم، ونجعلكم قردة وخنازير كما فعلنا بمن كان قبلكم (¬5).(@)(@@) وقال السدي: ونخلقكم في سوء خلقكم (¬6).(@)(@@) وقيل: هذا على النشأة الثانية يقول: نعيدكم في الآخرة لا تعلمون كيفية ذلك (¬7).(@)(@)PageV25P499(@)(@)(@@)(@@)(@@) || AUTO 62(@)(@)(@@) - {ولقد علمتم النشأة الأولى} خلق آدم (¬1).(@)(@@) وقيل: النشأة الأولى الخلقة الأولى، نطفة ثم علقة ثم مضغة، ولم تكونوا شيئا (¬2).(@)(@@) {فلولا} أي: فهلا (¬3) {تذكرون}.(@)(@@) قراءة العامة: {النشأة} بالقصر (¬4).(@)(@@) وقرأ الحسن، ومجاهد، وابن كثير، وحميد، وابن محيصن، وأبو عمرو، والجحدري {النشأة} بالمد (¬5)، وقد تقدم هذا.(@)(@@) وقوله: {فلولا تذكرون} أي: فهلا تتدبرون وتتفكرون أني قادر على إعادتكم كما كنت قادرا على إبدائكم (¬6).(@)(@@) وقال الحسين بن الفضل في هذا الوجه: وهذه وإن كانت غير مردودة فالذي عندي في هذه الآية: {وننشئكم في 
ms3403	 ما لا تعلمون (61)} PageV25P500(@)(@@) من كيفية ذلك، {ولقد علمتم النشأة الأولى} أي: نخلقكم للبعث بعد الموت من حيث لا تعلمون كيف شئت، وذلك أنكم علمتم النشأة الأولى كيف كانت في بطون الأمهات، إنا أنشأناكم وقدرناكم وصورناكم ونقلناكم من حالة إلى حالة، فليست النشأة الأخرى بأعجب من الأولى، وفيه دليل على صحة القياس، لأنه علمهم الاستدلال بالنشأة الأولى على النشأة الأخرى (¬1).(@)(@)(@@)(@@)(@@) || AUTO 63(@)(@)(@@) - قوله عز وجل: {أفرأيتم ما تحرثون(@)(@)(@@)(@@)(@@) || AUTO (63)(@)(@)(@@) }(@)(@@) أي: تثيرون الأرض وتعملون فيها وتطرحون من البذر (¬2).(@)(@)(@@)(@@)(@@) || AUTO 64(@)(@)(@@) - {أأنتم تزرعونه} أي: تنبتونه (¬3).(@)(@@) {أم نحن الزارعون} أي: المنبتون له (¬4).(@)(@@) [3013] أخبرنا الحسين بن محمد بن الحسين (¬5)، قال: حدثنا عمر (¬6) بن محمد بن علي، الزيات، حدثنا أبو عبد الله أحمد PageV25P501(@)(@@) ابن عبد الرحمن بن مرزوق (¬1)، قال: حدثنا مسلم بن أبي مسلم الجرمي (¬2)، قال: حدثنا مخلد بن الحسين (¬3)، عن هشام بن حسان (¬4)، عن محمد ابن سيرين (¬5)، عن أبي هريرة - رضي الله عنه - عن النبي - صلى الله عليه وسلم - قال: "لا يقولن أحدكم: زرعت وليقل: حرثت؛ فإن الزارع الله"، قال أبو هريرة - رضي الله عنه -: ألم تسمعوا قول الله عز وجل: {أفرأيتم ما تحرثون (63) أأنتم تزرعونه أم نحن الزارعون (64)} (¬6).(@)(@)(@@)(@@)(@@) || AUTO 65(@)(@)(@@) - {لو نشاء لجعلناه حطاما} هشيما لا ينتفع به في مطعم ولا غذاء (¬7).(@)(@)PageV25P502(@)(@)(@@) وقال مرة الهمداني: نبتا لا قمح فيه (¬1) (فظلتم) قراءة العامة بفتح الظاء، وقرأ عبد الله (فظلتم) بكسرها (¬2)، والأصل: ظللتم، فحذف إحدى اللامين تخفيفا (¬3) فمن فتح فعلى الأصل، ومن كسر فعلى نقل حركة اللام المحذوفة إلى الظاء (¬4).(@)(@@) {تفكهون} قال يمان: تندمون على نفقاتكم (¬5).(@)(@@) دليله: {فأصبح يقلب كفيه على ما أنفق فيها} (¬6)، وقال قتادة: تتعجبون مما نزل بكم (¬7).(@)(@)PageV25P503(@)(@)(@@) وقال عكرمة: أي: تتلاومون (¬1).(@)(@@) وقال الحسن: تندمون على ما سلف منكم من معصية الله التي أوجب عقوبتكم حتى نالكم في زرعكم ما نالكم (¬2).(@)(@@) وقال ابن يخلد: تعجبون (¬3).(@)(@@) وقال ابن كيسان: تحزنون وهو من الأضداد (¬4).(@)(@@) تقول العرب: تفكهت، أي؛ تنعمت، وتفهكت، أي: تحزنت (¬5).(@)(@)PageV25P504(@)(@)(@@) وقال الفراء: تفكهون وتفكنون (¬1)، والحد (¬2) والنون لغة عكل (¬3).(@)(@@) وقيل: التفكه: التكلم فيما لا يعنيك، 
ms3404	 ومنه قيل للمزاح فكاهة (¬4).(@)(@)(@@)(@@)(@@) || AUTO 66(@)(@)(@@) - {إنا لمغرمون(@)(@)(@@)(@@)(@@) || AUTO (66)(@)(@)(@@) }(@)(@@) قرأ المفضل وأبو بكر (أإنا) بهمزتين على الاستفهام (¬5)، ورواه عاصم عن زر بن حبيش. وقرأ الباقون بهمزة واحدة على الخبر، أي: ويقولون: {إنا لمغرمون} (¬6).(@)(@)PageV25P505(@)(@)(@@) وقال مجاهد، وعكرمة، وقتادة: لمولع بنا (¬1).(@)(@@) وقال ابن عباس وقتادة أيضا: لمعذبون (¬2) قالا: والغرام العذاب (¬3)، وروى ابن أبي نجيح عن مجاهد أيضا: لملقون بالشر (¬4).(@)(@@) وقال مقاتل بن حيان: مهلكون (¬5).(@)(@@) وقال الضحاك وابن كيسان: يقولون غرمنا أموالنا وذهب زرعنا وصار ما أنفقنا غرما علينا (¬6).(@)(@)PageV25P506(@)(@)(@@) وقال مرة الهمداني: محاسبون (¬1).(@)(@)(@@)(@@)(@@) || AUTO 67(@)(@)(@@) - {بل نحن محرومون(@)(@)(@@)(@@)(@@) || AUTO (67)(@)(@)(@@) }(@)(@@) أي: محدودون ممنوعون معناه رزقنا محارفون (¬2) والمحروم ضد المرزوق (¬3)، وعن أنس - رضي الله عنه - أن النبي - صلى الله عليه وسلم - مر بأرض للأنصار فقال: "ما يمنعكم من الحرث بها" قالوا: الجذوبة، قال: "فلا تفعلوا فإن الله يقول: أنا الزارع إن شئت زرعت بالماء وإن شئت زرعت بالريح، وإن شئت زرعت بالبذر". ثم تلا: {أفرأيتم ما تحرثون (63) أأنتم تزرعونه أم نحن الزارعون (64)} (¬4).(@)(@)(@@)(@@)(@@) || AUTO 68(@)(@)(@@) - قوله عز وجل: {أفرأيتم الماء الذي تشربون(@)(@)(@@)(@@)(@@) || AUTO (68)(@)(@)(@@) } يعني: المطر (¬5).(@)(@)(@@)(@@)(@@) || AUTO 69(@)(@)(@@) - {أأنتم أنزلتموه من المزن} يعني: السحاب، واحدها مرنة (¬6).(@)(@)PageV25P507(@)(@)(@@) قال الشاعر:(@)(@@) فنحن كماء المزن ما في نصابنا ... كهام (¬1) ولا فينا يعد بخيل (¬2)(@)(@@) {أم نحن المنزلون} الماء من السحاب (¬3).(@)(@)(@@)(@@)(@@) || AUTO 70(@)(@)(@@) - {لو نشاء جعلناه أجاجا} (¬4).(@)(@@) قال ابن عباس - رضي الله عنهما -: شديد الملوحة (¬5).(@)(@@) وقال الحسن: مرا زعاقا (¬6).(@)(@@) {فلولا} أي: فهلا. {تشكرون} الذي صنع ذلك بكم (¬7).(@)(@)PageV25P508(@)(@)(@@)(@@)(@@) || AUTO 71(@)(@)(@@) - قوله عز وجل: {أفرأيتم النار التي تورون(@)(@)(@@)(@@)(@@) || AUTO (71)(@)(@)(@@) }(@)(@@) أي: تقدحون وتستخرجون من زندكم (¬1) يقال: أوريت النار إذا قدحتها، وورى الزند يري: إذا انقدح منه النار (¬2).(@)(@)(@@)(@@)(@@) || AUTO 72(@)(@)(@@) - {أأنتم أنشأتم} خلقتم.(@)(@@) {شجرتها} التي تقدح منها النار وهي المرخ (¬3) والعفار (¬4) (¬5).(@)(@@) {أم نحن المنشئون} المخترعون الخالقون (¬6).(@)(@)(@@)(@@)(@@) || AUTO 73(@)(@)(@@) - {نحن جعلناها} يعني: نار الدنيا (¬7).(@)(@)PageV25P509(@)(@)(@@) {تذكرة} للنار الكبرى (¬1).(@)(@@) وعن أبي هريرة - رضي الله عنه - أن النبي - صلى الله عليه وسلم - قال: "ناركم هذه التي يوقد بنو آدم جزء من سبعين جزءا من نار جهنم"، فقالوا: يا رسول الله - صلى 
ms3405	 الله عليه وسلم -: إن كانت لكافية، قال: "فإنها فضلت عليها بتسعة وستين جزءا كلهن مثل حرها" (¬2).(@)(@@) {ومتاعا} بلغة ومنفعة (¬3).(@)(@@) {للمقوين} للمسافرين (¬4)، سموا بذلك لنزولهم في الأرض PageV25P510(@)(@@) القواء (¬1) وهي: القفر الخالية البعيدة من العمران والأهلين (¬2)، يقال: أقوت الدار إذا خلت من سكانها (¬3).(@)(@@) قال الشاعر:(@)(@@) أقوى وأقفر من نعم وغيره ... هوج الرياح بها بي التراب موار (¬4) (¬5)(@)(@@) وقال آخر:(@)(@@) يادار مية بالعلياء فالسند ... أقوت وطال عليها سالف الأبد (¬6) PageV25P511(@)(@@) وقال عنترة:(@)(@@) حييت من طلل تقادم عهده ... أقوى وأقفر بعد أم الهيثم (¬1)(@)(@@) قاله أكثر المفسرين (¬2).(@)(@@) وقال مجاهد: (للمقوين) للمستمتعين بها من الناس أجمعين المسافرين والحاضرين يستضاء بها في الظلمة، ويصطلي بها في البرد، وينتفع بها في الطبخ والخبز (¬3) والاصطلاء والإضاءة، ويتذكر بها نار جهنم فيستجار بالله منها (¬4).(@)(@@) وقال ابن زيد: للجائعين (¬5).(@)(@)PageV25P512(@)(@)(@@) يقول العرب: ما أقويت منذ كذا وكذا أي: ما أكلت شيئا (¬1).(@)(@@) وقال الربيع والسدي: للمنزلين المقترين (¬2) المرملين الذين لا زاد معهم، يعني: نارا يوقدون فيختبزون بها، وهي رواية العوفي عن ابن عباس - رضي الله عنهما - (¬3).(@)(@@) وقال قطرب: المقوي من الأضداد، يكون بمعنى الفقر، وبمعنى الغنى (¬4) يقال: أقوى الرجل إذا لم يكن معه زاد، وأقوى إذا قويت دوابه وكثر ماله (¬5).(@)(@@) وقيل: الذين ذهبت أزوادهم (¬6).(@)(@)(@@)(@@)(@@) || AUTO 74(@)(@)(@@) - {فسبح باسم ربك العظيم}(@)(@@) أي: نزه ربك وبرئه مما يقول هؤلاء فيه تعالى (¬7).(@)(@)PageV25P513(@)(@)(@@)(@@)(@@) || AUTO 75(@)(@)(@@) - قوله -عز وجل-: {فلا أقسم}(@)(@@) أي: فأقسم (¬1) و (لا) صلة قاله أكثر المفسرين (¬2)، وتصديقه قراءة عيسى بن عمر، وحميد (فلأقسم) على التحقيق (¬3)، وقال بعض أهل العربية: (لا) نفي معناه: ليس الأمر كما يقول هؤلاء، ثم أستأنف القسم، فقال: أقسم (¬4) {بمواقع النجوم} قال ابن عباس - رضي الله عنهما -: هي نجوم القرآن لأنه نزل على رسول الله - صلى الله عليه وسلم - نجوما (¬5).(@)(@@) وقال قتادة: يعني بمساقط النجوم ومغايبها (¬6).(@)(@)PageV25P514(@)(@)(@@) وقال عطاء بن أبي رباح: منازلها (¬1).(@)(@@) وقال الحسن: انكدراها وانتثارها يوم القيامة (¬2).(@)(@@) قرأ عبد الله بن مسعود - رضي الله عنه - وإبراهيم والأعمش ويحيى وحمزة والكسائي وخلف وابن محيصن وحميد وابن أبي إسحاق، ورويس عن يعقوب: {بموقع} على التوحيد 
ms3406	 (¬3)، وقرأ الباقون: {بمواقع النجوم} على الجمع (¬4)، وهو اختيار أبي عبيد وأبي حاتم فمن وحد فلأن ذلك يؤدي عن الجمع، ومن جمع فلأنه أشيع وأليق، PageV25P515(@)(@@) بما جاء فيه عن المفسرين (¬1).(@)(@)(@@)(@@)(@@) || AUTO 76(@)(@)(@@) - {وإنه لقسم} لحلف.(@)(@@) {لو تعلمون عظيم} كبير لو علمتم قدر ما أقسم الله به (¬2).(@)(@)(@@)(@@)(@@) || AUTO 77(@)(@)(@@) - {إنه} هذا الكتاب وهو جواب القسم (¬3).(@)(@@) {لقرآن كريم} حسن مكرم عزيز (¬4).(@)(@@) وقال عبد العزيز بن يحيى الكناني: غير مخلوق (¬5).(@)(@@) وقيل: سمي كريما، لأن يسره يغلب عسره (¬6).(@)(@)(@@)(@@)(@@) || AUTO 78(@)(@)(@@) - {في كتاب مكنون}(@)(@@) مصون عند الله -عز وجل- (¬7) محفوظ عن الشياطين وعن جميع ما يشين (¬8).(@)(@)PageV25P516(@)(@)(@@) وقال أبو حرزة: مكنون محفوظ عن الباطل (¬1).(@)(@@) وعن ابن عباس - رضي الله عنهما -: هو كتاب في السماء (¬2).(@)(@@) وقيل: هو اللوح المحفوظ (¬3).(@)(@)(@@)(@@)(@@) || AUTO 79(@)(@)(@@) - {لا يمسه} لا يمس ذلك الكتاب (¬4).(@)(@@) {إلا المطهرون} من الذنوب (¬5)، وهم الملائكة (¬6).(@)(@)PageV25P517(@)(@)(@@) [3014] أخبرنا عبد الله بن حامد بن محمد الأصبهاني (¬1) قراءة عليه في شهور سنة ثمان وثمانين وثلاثمائة، قال: أخبرنا أبو حامد أحمد بن محمد بن الحسن بن الشرقي (¬2)، قال: حدثنا محمد بن الحسين بن طرخان (¬3)، قال: حدثنا سعيد بن منصور (¬4)، قال: حدثنا أبو الأحوص (¬5)، عن عاصم الأحول (¬6)، عن أنس - رضي الله عنه - في قوله تعالى {لا يمسه إلا المطهرون} قال: الملائكة (¬7).(@)(@@) [3015] وأخبرنا أبو بكر بن عبدوس (¬8)، قال: حدثنا أبو الحسن بن محفوظ (¬9)، قال: حدثنا عبد الله بن هاشم (¬10)، PageV25P518(@)(@@) قال: حدثنا عبد الرحمن (¬1)، عن سفيان (¬2)، عن الربيع (¬3)، عن سعيد بن جبير (¬4) {لا يمسه إلا المطهرون} قال: الملائكة الذين في السماء (¬5).(@)(@@) وقال أبو العالية وابن زيد: ليسوا أنتم أصحاب الذنوب، وإنما هم الذين طهروا من الذنوب؛ كالرسل من الملائكة، والرسل من بني آدم، فجبريل النازل به مطهر -عليه السلام-، والرسل الذين يجيئهم بذلك مطهرون (¬6).(@)(@@) وقال ابن عباس - رضي الله عنهما -: لا يمسه إلا المطهرون من الشرك (¬7).(@)(@)PageV25P519(@)(@)(@@) وقال عكرمة: هم حملة التوراة والإنجيل (¬1).(@)(@@) قال قتادة: لا يمسه إلا المطهرون عند الله تعالى، فأما في الدنيا فيمسه الكافر النجس والمنافق النجس (¬2).(@)(@@) وروى حيان عن الكلبي: هم السفرة الكرام البررة (¬3).(@)(@@) وقال محمد 
ms3407	 بن فضيل: عنه لا يقرؤه إلا الموحدون (¬4).(@)(@@) وقال عكرمة: كان ابن عباس - رضي الله عنهما - ينهى أن يمكن أحد من اليهود والنصارى من قراءة القرآن (¬5).(@)(@@) وقال الفراء: لا يجد طعمه ونفعه إلا من آمن به (¬6).(@)(@@) وقال الحسين بن الفضل: لا يعرف تفسيره وتأويله إلا من طهره الله من الشرك والنفاق (¬7).(@)(@@) وقال أبو بكر الوراق: لا يوفق للعمل به إلا السعداء (¬8).(@)(@)PageV25P520(@)(@)(@@) وقال أبو العباس بن عطاء: لا يفهم حقائق القرآن ودقائقه إلا من طهر سره عند الأبرار من الأقذار (¬1).(@)(@@) وقال الجنيد: هم الذين طهر سرهم عما سوى الله (¬2).(@)(@@) وقيل: لا يمسه إلا المطهرون من الأحداث والجنايات والنجاسات (¬3) وردوا الهاء في قوله: {لا يمسه} إلى القرآن (¬4).(@)(@@) وقالوا: أراد بالقرآن: المصحف، وسماه قرآنا على قرب الجوار والاتساع (¬5).(@)(@@) كما روي في الخبر الصحيح، أن رسول الله - صلى الله عليه وسلم - نهى أن يسافر بالقرآن إلى أرض العدو مخافة أن تناله أيديهم (¬6).(@)(@@) وظاهر الآية نفي، ومعناها نهي، كقوله تعالى {والمطلقات يتربصن PageV25P521(@)(@@) بأنفسهن} (¬1) ونحو هذا، واستدلوا بهذه الآية على منع الجنب والحائض والمحدث من مس المصحف وحمله، وقالوا: لا يجوز لأحد حمل المصحف ولا مسه حتى يكون على صفة تجوز له الصلاة.(@)(@@) وإلى هذا ذهب جمهور الفقهاء (¬2)، وقاله على وسعد بن أبي وقاص، وسعيد بن زيد، وابن مسعود - رضي الله عنهم -، وعطاء والزهري، ومالك، والشافعي رحمهم الله، إلا أن أبا حنيفة رحمه الله لم يمنع من حمله بعلاقة أو مسه بحائل، والاختيار أنه ممنوع منه، لأنه إذا حمله بجلده فإنما حمله بحائل ومع هذا يمنع منه (¬3).(@)(@@) وذهب الحكم، وحماد، وداود بن علي إلى أنه لا بأس يحمل المصحف ومسه على أي صفة كانت، سواء كان طاهرا أو غير طاهر مؤمنا كان أو كافرا (¬4)، إلا أن داود قال: لا يجوز للمشرك حمل المصحف (¬5).(@)(@@) والدليل على أنه لا يحمل المصحف ولا يمسه إلا طاهر: ما روى PageV25P522(@)(@@) أبو بكر بن محمد بن عمرو بن حزم (¬1)، عن أبيه (¬2) عن جده (¬3) أن النبي - صلى الله عليه وسلم - لما بعثه إلى اليمن 
ms3408	 كتب في كتابه: أن لا يمس المصحف ولا يحمله إلا طاهر (¬4).(@)(@)PageV25P523(@)(@)(@@) وروى سالم بن عبد الله بن عمر عن أبيه أن النبي - صلى الله عليه وسلم - قال: "لا تمس القرآن إلا وأنت طاهر" (¬1)، ولأنه إجماع الصحابة - رضي الله عنهم -.(@)(@@) روي أن عليا - رضي الله عنه - سئل: أيمس المحدث المصحف؟ فقال: لا (¬2)، وروي أن مصعب بن سعد بن أبي وقاص كان يقرأ من المصحف فأدخل يده فحل ذكره، فأخذ أبوه المصحف من يده، وقال: قم فتوضأ ثم خذه (¬3)، ولا مخالف لهما في الصحابة.(@)(@)PageV25P524(@)(@)(@@) وقال عطاء: {لا يمسه إلا المطهرون} قال: لا يقلب الورق من المصحف إلا المتوضئ (¬1).(@)(@@) واستدل المبيحون بكتاب رسول الله - صلى الله عليه وسلم - إلى قيصر وفيه: بسم الله الرحمن الرحيم {قل ياأهل الكتاب تعالوا إلى كلمة سواء بيننا وبينكم ألا نعبد إلا الله} [آل عمران: 64] الآية.(@)(@@) واختار الفقهاء ذلك إذا دعت ضرورة إليه وحمله عذر عليه فلا حجة فيه (¬2)، وأما مس الصبيان إياه فلأصحابنا فيه وجهان:(@)(@@) أحدهما: أنهم يمنعون منه كالبالغين اعتبارا لهم.(@)(@@) والثاني: لا يمنعون لمعنيين.(@)(@@) أحدهما: أن الصبي لو منع من ذلك أدى أن لا يتلقن القرآن ولا يتعلمه ولا يحفظه، لأن وقف تعلمه وحفظه حال الصغر.(@)(@@) والثاني: أن الصبي وإن كانت له طهارة فليست بكاملة؛ لأن النية لا تصح منه، وإذا جاز أن يحمله على طهر غير كامل جاز أن يحمله محدثا (¬3) والله أعلم.(@)(@)(@@)(@@)(@@) || AUTO 80(@)(@)(@@) - قوله -عز وجل-: {تنزيل} أي: منزل.(@)(@@) {من رب العالمين} فسمي المنزل: تنزيلا على اتساع اللغة، كما PageV25P525(@)(@@) تقول المقدور: قدر، والمخلوق خلق (¬1)، وهذا الدرهم ضرب الأمير (¬2)، ووزن سبعة دراهم ونحوها ..(@)(@@) وقيل: {تنزيل} صفة لقوله: {لقرآن كريم}.(@)(@@) قيل: هو تنزيل (¬3).(@)(@)(@@)(@@)(@@) || AUTO 81(@)(@)(@@) - {أفبهذا الحديث} يعني: القرآن (¬4).(@)(@@) {أنتم مدهنون}. قال ابن عباس - رضي الله عنهما - وعطاء: مكذبون (¬5).(@)(@@) وقال مقاتل بن سليمان، وقتادة: كافرون (¬6)، ونظيره: {ودوا لو تدهن فيدهنون} (¬7).(@)(@)PageV25P526(@)(@)(@@) قال ابن كيسان: المدهن الذي لا يفعل ما يحق عليه ويدفعه بالعلل (¬1).(@)(@@) وقال المؤرج؛ المدهن المنافق الذي يلين جانبه ليخفي كفره (¬2).(@)(@@) وأدهن وداهن واحد، 
ms3409	 وأصله من الدهن (¬3).(@)(@@) وقال مجاهد: يريدون أن تمالئوهم فيه، وتركنوا إليهم (¬4).(@)(@@) وقال بعض أئمة اللغويين: مدهنون، تاركون للحزم في قبول القرآن والتهاون بأمره، ومداهنة العدو وملاينته فيما يجب من مغالظته، وأصله من اللين والضعف (¬5).(@)(@@) قال أبو قيس بن الأسلت: الحزم والقوة خير من الإدهان والعهد والهاع (¬6).(@)(@)PageV25P527(@)(@)(@@)(@@)(@@) || AUTO 82(@)(@)(@@) - {وتجعلون رزقكم} أي: حظكم ونصيبكم من القرآن (¬1).(@)(@@) {أنكم تكذبون}.(@)(@@) قال الحسن: في هذه الآية خسر عبد لا يكون حظه من كتاب الله تعالى إلا التكذيب به (¬2).(@)(@@) وقال آخرون: هذا في الاستسقاء بالأنواء (¬3).(@)(@@) قال عطاء: كانوا يمطرون فيقولون مطرنا بنوء كذا، وصدق نوء كذا (¬4).(@)(@@) [3016] أنبأني عبد الله بن حامد (¬5)، قال: حدثنا محمد بن الحسين (¬6)، قال: حدثنا أحمد بن يوسف (¬7)، قال: حدثنا النضر بن PageV25P528(@)(@@) محمد (¬1)، قال: حدثنا عكرمة (¬2)، قال: حدثنا أبو زميل (¬3)، قال: حدثنا ابن عباس - رضي الله عنهما - قال: مطر الناس على عهد النبي - صلى الله عليه وسلم - فقال النبي - صلى الله عليه وسلم -: "أصبح من الناس شاكر، ومنهم كافر، فمنهم من يقول: هذه رحمة وضعها الله حيث شاء، ومنهم من يقول: صدق نوء كذا وكذا" قال: فنزلت هذه الآية: {فلا أقسم بمواقع النجوم} إلى قوله: {وتجعلون رزقكم أنكم تكذبون} (¬4).(@)(@@) وشرح قول ابن عباس - رضي الله عنهما - في سبب نزول هذه الآية، ما روي عنه أن النبي - صلى الله عليه وسلم - خرج في سفر فأصابهم العطش وليس معهم ماء، فذكروا ذلك للنبي - صلى الله عليه وسلم - فقال: "أرأيتم إن دعوت الله لكم فسقيتم فلعلكم تقولون: سقينا هذا المطر بنوء كذا وكذا" فقالوا: يا رسول الله: ما PageV25P529(@)(@@) هذا بحين الأنواء، قال: فصلى ركعتين ودعا ربه، فهاجت ريح ثم هاجت سحابة، فمطرنا حتى سالت الأودية، وملؤوا الأسقية، ثم ركب النبي - صلى الله عليه وسلم - فمر ومعه عصابة من أصحابه برجل يغترف بقدح له، وهو يقول: سقينا بنوء كذا وكذا، ولم يقل هذا من رزق الله، فأنزل الله -عز وجل-: {وتجعلون رزقكم} (¬1) أي: شكركم الله على رزقه إياكم أنكم تكذبون بالنعمة (¬2)، ويقولون: سقينا بنوء كذا وكذا، 
ms3410	 وهذا كقول القائل: جعلت إحساني إليك إساءة منك إلي، وجعلت شكر إكرامي لك أنك اتخذتني عدوا (¬3)، فمجاز الآية: وتجعلون شكر رزقكم، فحذف المضاف وأقام المضاف إليه مقامه، كقوله تعالى: {واسأل القرية} (¬4) ونحوها (¬5).(@)(@@) قال الشاعر:(@)(@@) فكأن شكر القوم عند المنى ... كي الصحيحات وفقء الأعين (¬6) PageV25P530(@)(@@) دليل هذا التأويل:(@)(@@) [3017] ما أخبرني عبد الله بن حامد (¬1)، قال: أخبرنا عمر بن الحسين (¬2)، قال: حدثنا أحمد (¬3)، قال: حدثنا أبي (¬4)، قال: حدثنا الحصين (¬5)، عن هارون بن سعد (¬6)، عن عبد الأعلى (¬7)، عن أبي عبد الرحمن (¬8)، عن علي - رضي الله عنه - أن رسول الله - صلى الله عليه وسلم - قرأ: (وتجعلون شكركم أنكم تكذبون) (¬9).(@)(@)PageV25P531(@)(@)(@@) وعن الهيثم بن عدي أنه قال: إن من لغة أزد شنوءة، ما رزق فلان؟ أي: ما شكر (¬1).(@)(@@) وعن أبي هريرة - رضي الله عنه - قال: قال رسول الله - صلى الله عليه وسلم -: "قال الله -عز وجل-: ما أنعمت على عبادي من نعمة إلا أصبح فريق منهم بها كافرين"، قالوا: وكيف يا رسول الله؟ قال: "ينزل الله الغيث، فيقولون بعضهم: مطرنا بنوء كذا، وصدق كوكب كذا" (¬2).(@)(@@) وروى أبو هريرة وزيد بن خالد الجهني - رضي الله عنهما - قالا: صلى بنا رسول الله - صلى الله عليه وسلم - صلاة الصبح بالحديبية (¬3) في أثر سماء كانت من الليل، ثم التفت إلينا، فقال: "أتدرون ماذا قال ربكم"؟ قلنا: الله ورسوله PageV25P532(@)(@@) أعلم، قال: "قال الله تعالى: أصبح من عبادي مؤمن بي، وكافر، فمن قال: مطرنا بنوء كذا فذلك كافر بي ومؤمن بالكوكب، ومن قال: مطرنا بفضل الله ورحمته فذلك مؤمن بي وكافر بالكوكب" (¬1).(@)(@@) [3018] وأنبأني عقيل (¬2)، قال: حدثنا المعافى بن المبتلى (¬3)، قال: أخبرنا محمد بن جرير (¬4)، قال: حدثني بشر بن يونس (¬5)، قال: حدثنا سفيان (¬6)، عن محمد بن إسحاق (¬7)، عن محمد بن إبراهيم بن الحارث التيمي (¬8)، عن أبي سلمة (¬9)، عن أبي هريرة - رضي الله عنه - أن رسول الله - صلى الله عليه وسلم - قال: "إن الله - سبحانه وتعالى - ليصبح عباده بالنعمة، أو PageV25P533(@)(@@) يمسيهم بها فيصبح قوم كافرين يقولون: مطرنا بنوء كذا وكذا" (¬1).(@)(@@) [3018/ 2] قال محمد (¬2): فذكرت هذا الحديث 
ms3411	 لسعيد بن المسيب (¬3)، فقال: ونحن قد سمعنا من أبي هريرة، قد أخبرني من شهد عمر بن الخطاب - رضي الله عنه -وهو يستسقي، فلما استسقى التفت إلى العباس - رضي الله عنه - فقال: يا عم رسول الله كم بقي من نوء الثريا؟ فقال: العلماء يزعمون أنها تعترض في الأفق سبعا بعد سقوطها، قال: فما مضت سابعة حتى مطروا، فقال عمر - رضي الله عنه -: الحمد لله هذا بفضل الله ورحمته (¬4).(@)(@@) [3019] أخبرنا عبد الله بن حامد (¬5)، قال: أنبأنا محمد بن PageV25P534(@)(@@) خالد (¬1)، قال: حدثنا داود بن سليمان (¬2)، قال: حدثنا عبد بن حميد (¬3)، قال: حدثنا هاشم بن القاسم (¬4)، قال: حدثنا محمد بن طلحة (¬5)، عن طلحة بن عبد الله بن محيريز (¬6)، قال: دعا سليمان بن عبد الملك (¬7) فقال له: لو تعلمت علم النجوم، فازددت إلى علمك، فقال: قال رسول الله - صلى الله عليه وسلم -: "إن أخوف ما أخاف على أمتي ثلاث: إيمان بالنجوم، وتكذيب بالقدر، وحيف بالأئمة" (¬8).(@)(@@) وقرأ المفضل عن عاصم، ويحيى بن وثاب: (إنكم تكذبون) بفتح التاء مخففا، وشدد الباقون من التكذيب (¬9).(@)(@)PageV25P535(@)(@)(@@) ثم خاطبهم خطاب التحذير والترهيب، فقال:(@)(@)(@@)(@@)(@@) || AUTO 83(@)(@)(@@) - {فلولا} فهلا.(@)(@@) {إذا بلغت} يعني: الروح (¬1) {الحلقوم} عند خروجها من الجسد (¬2) فاختزل النفس لدلالة الكلام عليه كقول الشاعر:(@)(@@) أماوي ما يغني الثرى عن الفتى ... إذا حشرجت يوما وضاق به الصدر (¬3)(@)(@@) يعني إذا بلغت إلى اللبة (¬4) عند الموت وفي الحديث: "إن ملك الموت له أعوان يقطعون العروق، ويجمعون الروح شيئا فشيئا حتى ينتهي بها إلى الحلقوم، فيتوفاها ملك الموت" (¬5).(@)(@)(@@)(@@)(@@) || AUTO 84(@)(@)(@@) - قوله -عز وجل-: {وأنتم حينئذ تنظرون} إلى أمري وسلطاني (¬6).(@)(@@) قال ابن عباس - رضي الله عنهما -: يريد من حضر الميت من أهله ينظرون إليه PageV25P536(@)(@@) متى تخرج نفسه (¬1).(@)(@@) قال الفراء: وذلك معروف من كلام العرب أن يخاطبوا الجماعة بالفعل كأنهم أهله وأصحابه المراد به بعضهم غائبا كان أو شاهدا، فيقولون: أقتلتم فلانا، والقاتل منهم واحد، ويقال لأهل المسجد إذا آذوا رجلا: اتقوا الله فإنكم تؤذون المسلمين (¬2).(@)(@)(@@)(@@)(@@) || AUTO 85(@)(@)(@@) - {ونحن أقرب إليه منكم}(@)(@@) بالقدرة والعلم ولا قدرة لكم على 
ms3412	 دفع شيء عنه (¬3).(@)(@@) قال عامر بن عبد قيس: ما نظرت إلى شيء إلا رأيت الله تعالى أقرب إلي منه (¬4).(@)(@@) وقيل: أراد ورسلنا الذين يتولون قبض روحه أقرب إليه منكم (¬5).(@)(@@) {ولكن لا تبصرون} أي: لا ترونهم.(@)(@)(@@)(@@)(@@) || AUTO 86(@)(@)(@@) - {فلولا} فهلا.(@)(@)PageV25P537(@)(@)(@@) {إن كنتم غير مدينين} مملوكين أذلاء، من قولك: دنت له بالطاعة (¬1).(@)(@@) وقيل: غير مجزيين (¬2) ولا محاسبين (¬3).(@)(@)(@@)(@@)(@@) || AUTO 87(@)(@)(@@) - {ترجعونها} ترجعون الروح إلى الجسد (¬4).(@)(@@) {إن كنتم صادقين} ولن ترجعوها، فبطل زعمكم أنكم غير مملوكين ولا محاسبين (¬5)، فإن قيل: أين جواب قوله: {فلولا إذا بلغت الحلقوم} وقوله: {فلولا إن كنتم} فالجواب عنه ما قال الفراء: أنهما أجيبا بجواب واحد وهو قوله: {ترجعونها} وربما PageV25P538(@)(@@) أعادت العرب الحرفين ومعناهما واحد فهذا من ذاك، ومنه قوله -عز وجل-: {فإما يأتينكم مني هدى فمن تبع هداي فلا خوف عليهم ولا هم يحزنون} (¬1) أجيبا بجواب واحد وهما شرطان (¬2)، ومنه قوله: {لا تحسبن الذين يفرحون بما أتوا} (¬3) (فلا تحسبنهم).(@)(@@) وقيل: في هذه الآية تقديم وتأخير مجازها: {فلولا إن كنتم غير مدينين (86) {ترجعونها} تردون نفس هذا الميت إلى جسده إذا بلغت الحلقوم إن كنتم صادقين (¬4).(@)(@@) ثم ذكر تبارك وتعالى طبقات الخلق عند الموت وحين البعث وبين درجاتهم فقال:(@)(@)(@@)(@@)(@@) || AUTO 88(@)(@)(@@) - {فأما إن كان} هذا المتوفى (¬5) {من المقربين} وهم السابقون (¬6).(@)(@)(@@)(@@)(@@) || AUTO 89(@)(@)(@@) - {فروح} PageV25P539(@)(@@) قرأ الحسن، وقتادة، ونصر بن عاصم، والجحدري، ورويس، وزيد عن يعقوب: {فروح} بضم الراء (¬1) على معنى أن روحه تخرج في الريحان (¬2) قاله الحسن، وقال قتادة: الروح الرحمة (¬3).(@)(@@) وقال نصر بن عاصم: الروح الحياة (¬4)، أي يقال لهم: حياة وريحان، وذكر أنها قراءة النبي - صلى الله عليه وسلم - (¬5).(@)(@@) [3020] أخبرنا محمد بن نعيم (¬6)، قال: حدثنا الحسين بن أيوب (¬7)، قال: أخبرنا علي بن عبد العزيز (¬8)، قال: أنبأنا أبو عبيد (¬9)، قال:(@)(@)PageV25P540(@)(@)(@@) حدثنا مروان بن معاوية (¬1)، عن أبي حماد الخراساني (¬2)، عن بديل بن ميسرة (¬3)، عن عبد الله بن شقيق (¬4)، عن عائشة - رضي الله عنها - قالت: كان رسول الله - صلى الله عليه وسلم - يقرأ هذا الحرف: (فروح) بضم الراء (¬5).(@)(@@) [3021] وبإسناده عن أبي عبيد (¬6)، قال: حدثنا 
ms3413	 حجاج (¬7)، عن هارون بن موسى المعلم (¬8)، قال: أخبرني بديل بن ميسرة (¬9)، عن PageV25P541(@)(@@) عبد الله بن شقيق (¬1)، عن عائشة - رضي الله عنها - أنها سمعت رسول الله - صلى الله عليه وسلم - يقرأ: (فروح) بضم الراء (¬2).(@)(@@) وقرأ الآخرون بفتح الراء.(@)(@@) واختلفوا في معناه (¬3) فقال ابن عباس - رضي الله عنهما - ومجاهد: فراحة (¬4).(@)(@@) وقال سعيد بن جبير: الروح الفرج (¬5).(@)(@)PageV25P542(@)(@)(@@) وقال أبو حرزة: الروح الراحة من الدنيا (¬1). وقال الضحاك: هي مغفرة ورحمة (¬2).(@)(@@) {وريحان} قال ابن عباس - رضي الله عنهما -: مستراح (¬3)، وقال مجاهد، وسعيد ابن جبير: رزق (¬4).(@)(@@) وقال مقاتل: هو الرزق بلسان حمير (¬5)، يقال: خرجت أطلب ريحان الله، أي: رزقه (¬6).(@)(@)PageV25P543(@)(@)(@@) قال النمر بن تولب:(@)(@@) سلام الله وريحانه ... ورحمته وسماء درر (¬1)(@)(@@) وقال الربيع بن خثيم: فروح عند الموت وريحان نحي له في الآخرة (¬2). وقال الآخرون: هو الريحان المعروف الذي يشم (¬3) قاله الحسن، وقتادة.(@)(@@) وقال أبو العالية: لا يفارق أحدا من المقربين روحه في الدنيا حتى يؤتى بغصن ريحان من ريحان الجنة، فيشمه ثم يقبض روحه (¬4).(@)(@@) وقيل: فروح في القبر، أي: طيب نسيم (¬5)، وريحان ورزق (¬6).(@)(@)PageV25P544(@)(@)(@@) وأصل ريحان روحان؛ لأنه من الواو إلا أنه خفف مثل: ميت وهين ولين وضيق فطرح تثقيله للألف والنون الزائدتين اللتين لحقتاه ورفع على معنى فله روح (¬1).(@)(@@) وقال أبو زيد يقال: انشق الفجر عن ريحانه إذا انشق عن نسيمه، والنسيم كل رائحة طيبة (¬2).(@)(@@) قال الخليل: الريحان أطراف كل بقلة طيبة إذا خرج عليها أوائل النور (¬3).(@)(@@) وقال غيره: الريحان فيعلان من الريح والريح والروح واحد (¬4)، وإنما صارت الواو ياء في الريح، لأن الحرف الذي قبله مكسور (¬5).(@)(@@) وقال أبو بكر الوراق: الروح النجاة من النار، والريحان دخول دار القرار (¬6).(@)(@@) وقال الترمذي: الروح الراحة في القبر، والريحان دخول الجنة (¬7).(@)(@@) وقال بسام بن عبد الله: الروح السلامة، والريحان الكرامة (¬8).(@)(@)PageV25P545(@)(@)(@@) وقال سعد: الروح معانقة الأبكار، والريحان مرافقة الأبرار (¬1).(@)(@@) وقال الخزاز: الروح كشف الغطاء والريحان الروتة (¬2) واللقاء (¬3)، وقيل: الروح الراحة والريحان النجاة من الآفة (¬4)، وقيل: الروح الموت شهيدا والريحان ندا السعادة، وقيل: الروح كشف الكروب والريحان غفران الذنوب، وقيل: الروح الثبات 
ms3414	 على الإيمان والريحان نيل الأمن والأمان، وقيل: الروح فضله والريحان وصله، وقيل: الروح تخفيف الحساب والريحان تضعيف الثواب، وقيل: الروح عفو بلا عقاب والريحان رزق بلا حساب، وقيل: فروح للسابقين وريحان للمقتصدين وجنة للظالمين، وقيل: الروح لأرواحهم والريحان لقلوبهم (¬5).(@)(@@) {وجنت نعيم} لأبدانهم والحق لأسرارهم (¬6).(@)(@)(@@)(@@)(@@) || AUTO 90(@)(@)(@@) - قوله -عز وجل-: {وأما إن كان} هذا المتوفى (¬7) {من أصحاب اليمين}.(@)(@)PageV25P546(@)(@)(@@)(@@)(@@) || AUTO 91(@)(@)(@@) - {فسلام}(@)(@@) رفع بتقدير حذف الصفة على معنى فلك سلام وهو سلام (¬1). {لك} يا محمد {من أصحاب اليمين} فلا تهتم لهم، فإنهم مسلمون من عذاب الله (¬2).(@)(@@) وقيل: فسلام لك أيها الإنسان الذي من أصحاب اليمين، من عذاب الله (¬3). وقيل: معناه يقال له: سلام لك أنك من أصحاب اليمين، وحذفت أنك (¬4).(@)(@@) وقال الفراء: فذلك مسلم لك أنك من أصحاب اليمين.(@)(@@) وقيل: مسلم لك أنهم من أصحاب اليمين.(@)(@@) وقيل: مسلم عليك أنهم من أصحاب اليمين (¬5).(@)(@@) وقال قتادة: يسلم عليك ملائكة الله (¬6).(@)(@)PageV25P547(@)(@)(@@) وقال الزجاج: فسلام لك يا محمد، أي: أنك ترى فيهم ما تحب من السلامة وقد علمت ما أعد لهم من الجزاء (¬1) بقوله: {في سدر مخضود} الآيات.(@)(@@) وقيل: هو بمعنى قولهم: ناهيك به شرفا، وحسبك كرما، أي: لا تطلب زيادة على سلامتهم جلالة وعظم منزلة، وقيل: معناه سلمت أيها العبد مما تكره فإنك من أصحاب اليمين (¬2).(@)(@)(@@)(@@)(@@) || AUTO 92(@)(@)(@@) - قوله -عز وجل-: {وأما إن كان من المكذبين} بالبعث.(@)(@@) {الضالين} عن الهدى وهم أصحاب المشأمة (¬3).(@)(@)(@@)(@@)(@@) || AUTO 93(@)(@)(@@) - {فنزل} أي: عذاب.(@)(@@) {من حميم} مثناه الحرارة.(@)(@)(@@)(@@)(@@) || AUTO 94(@)(@)(@@) - {وتصلية جحيم} إدخال في النار (¬4)،(@)(@@) وقيل: إقامة في الجحيم ومقاساة لأنواع العذاب فيها (¬5).(@)(@)PageV25P548(@)(@)(@@)(@@)(@@) || AUTO 95(@)(@)(@@) - {إن هذا}(@)(@@) الذي وصفت في هذه الصورة، وقيل: إن هذا القرآن {لهو حق اليقين} الذي لا شك فيه، وقيل: أي الحق اليقين، وجاز إضافة الحق إلى اليقين وهما واحد لاختلاف لفظهما (¬1).(@)(@@) قال المبرد: هو كقولك: عين اليقين ومحض اليقين (¬2).(@)(@@) وقال الزجاج: المعنى: ليقين حق اليقين.(@)(@@) وقال قتادة: في هذه الآية أن الله تعالى ليس بتارك أحدا من الناس حتى يقفه على اليقين من هذا القرآن، 
ms3415	 فأما المؤمن فأيقن في الدنيا فينفعه ذلك يوم القيامة، وأما الكافر فأيقن يوم القيامة حين لا ينفعه اليقين (¬3).(@)(@)(@@)(@@)(@@) || AUTO 96(@)(@)(@@) - {فسبح باسم ربك العظيم}(@)(@@) أي: فصل بذكر ربك وبأمره (¬4).(@)(@@) وقيل: فاذكر اسم ربك العظيم وسبحه (¬5).(@)(@)PageV25P549(@)(@)(@@) وقيل: ونزه اسم الله من السوء (¬1).(@)(@@) [3022] وأخبرنا ابن فنجويه (¬2)، قال: أخبرنا ابن شنبة (¬3)، قال: حدثنا حمزة بن محمد الكاتب (¬4)، قال: حدثنا نعيم بن حماد (¬5)، قال: حدثنا عبد الله بن المبارك (¬6)، عن موسى بن أيوب الغافقي (¬7)، عن عمه (¬8) -وهو إياس بن عامر- عن عقبة بن عامر الجهني (¬9) - رضي الله عنه - قال: لما نزلت: {فسبح باسم ربك العظيم} قال النبي - صلى الله عليه وسلم - "اجعلوها في ركوعكم". ولما نزلت {سبح اسم ربك الأعلى} [الأعلى: 1] قال النبي - صلى الله عليه وسلم -: "اجعلوها في سجودكم" (¬10).(@)(@)PageV25P550(@)(@)(@@) . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .(@)(@)PageV25P551(@)(@)(@@) الكشف والبيان عن تفسير القرآن(@)(@)(@@) تأليف(@)(@@) أبي إسحاق أحمد بن إبراهيم الثعلبي المتوفى سنة 427 ه(@)(@)(@@) أشرف على إخراجه(@)(@@) د/ صلاح باعثمان - د/ حسن الغزالي - أ. د/ زيد مهارش - أ. د/ أمين باشه(@)(@)(@@) [المجلد السادس والعشرون](@)(@@) [سورة الحديد إلى آخر الطلاق](@)(@)(@@) تحقيق(@)(@@) د/ هبة الله بنت صادق أبو عرب(@)(@@) د/ محمد بن علي الغامدي PageV26P001(@)(@@) السيرة الذاتية للمحقق(@)(@@) د/ هبة الله بنت صادق بن سعيد هاشم أبو عرب(@)(@@) أستاذ مساعد متعاونة بجامعة أم القرى - كلية الدعوة وأصول الدين.(@)(@@) حصلت على درجة الدكتوراه عام 1430 ه في تخصص التفسير وعلوم القرآن من جامعة أم القرى - كلية الدعوة وأصول الدين، وعنوان رسالة الدكتوراه (ترجيحات أبي حيان الأندلسي من أول سورة طه إلى الآية 77 من سورة المؤمنون جمعا ودراسة وموازنة وتعليق).(@)(@)(@@) بعض من المناصب الإدارية التي شغلتها:(@)(@@) متعاقدة مع كلية خدمة المجتمع والتعليم المستمر - جامعة أم القرى.(@)(@)(@@) عضوية الهيئات العلمية منها:(@)(@@) عضو الجمعية العلمية السعودية للقرآن الكريم وعلومه.(@)(@)(@@) لها مؤلفات منشورة أهمها:(@)(@@) 1 - دراسة مقارنة في تفسير آيات الخمر في القرآن الكريم.(@)(@@) 2 - شبهات المستشرقين حول الوحي الإلهي دوافعها ودفعها.(@)(@@) * * *(@)(@)(@@) السيرة الذاتية للمحقق(@)(@@) د/ محمد بن علي الغامدي(@)(@@) أستاذ مشارك بجامعة أم القرى - كلية الشريعة - مركز الدراسات الإسلامية 
ms3416	(@)(@@) حصل على درجة الدكتوراه في تخصص التفسير وعلوم القرآن من جامعة أم درمان الإسلامية بالسودان - كلية أصول الدين - قسم التفسير وعلوم القرآن.(@)(@@) كما حصل على درجة الدكتوراه في تخصص التفسير وعلوم القرآن من جامعة أم القرى - كلية الدعوة وأصول الدين - قسم الكتاب.(@)(@@) [تمام السيرة في المجلد التالي](@)(@@) * * *(@)(@)PageV26P002(@)(@)(@@) الكشف والبيان عن تفسير القرآن(@)(@@) [26] PageV26P003(@)(@@) جميع الحقوق محفوظة(@)(@@) رقم الإيداع بدار الكتب 15255/ 2013(@)(@)(@@) الطبعة الأولى(@)(@@) 1436 ه - 2015 م(@)(@)(@@) دار التفسير(@)(@@) جدة - المملكة العربية السعودية(@)(@@) شارع محمود نصيف - حي الأندلس(@)(@@) ص. ب: 122497 - جدة: 21332(@)(@@) تلفاكس: 6688823 - 012(@)(@)PageV26P004(@)(@)(@@)(@@)(@@) | AUTO 57 - سورة الحديد PageV26P005(@)(@@) سورة الحديد(@)(@@) مدنية (¬1) وهي عشرون وتسع آيات في الكوفي والبصري (¬2) وثمان في جميع العدد غيرهما.(@)(@@) اختلفوا في اثنين، عد الكوفي: {من قبله العذاب} وعد البصري: {وآتيناه الإنجيل} [المائدة: 46] (¬3).(@)(@@) وعدد كلمها خمسمائة وأربع وأربعون كلمة.(@)(@@) وعدد حروفها ألفان وأربعمائة وسبعة وسبعون حرفا (¬4).(@)(@@) [3023] أخبرنا الحسين بن محمد المقرئ (¬5)، قال: حدثنا أبو عمرو عبد الله بن محمد الحافظ (¬6)، قال أبو بكر بن أبي عاصم PageV26P007(@)(@@) النبيل (¬1)، قال: حدثنا الحوطي (¬2)، قال: حدثنا بقية (¬3) (عن بحير) (¬4) ابن سعد (¬5)، عن خالد بن معدان (¬6)، عن أبي بلال (¬7)، عن العرباض ابن سارية (¬8) - رضي الله عنه - أن رسول الله - صلى الله عليه وسلم - كان يقرأ بالمسبحات قبل أن يرقد ويقول: "إن فيهن آية أفضل من ألف آية" (¬9) يعني:(@)(@)PageV26P008(@)(@)(@@) بالمسبحات الحديد والحشر والصف والجمعة والتغابن.(@)(@@) [3024] أخبرنا الإمام أبو علي الحسن بن محمد بن الحسن المقرئ (¬1)، قال: حدثنا الإمام أبو بكر الإسماعيلي (¬2)، وأبو الشيخ الأصبهاني الحافظ (¬3)، قالا: حدثنا أبو إسحاق إبراهيم بن شريك (¬4)، قال: حدثنا أحمد بن يونس اليربوعي (¬5)، قال: حدثنا PageV26P009(@)(@@) سلام بن سليم المدائني (¬1)، قال: حدثنا هارون بن كثير (¬2)، قال: حدثنا زيد بن أسلم (¬3)، عن أبيه (¬4)، عن أبي أمامة (¬5)، عن أبي بن كعب -رضي الله عنه-قال: قال رسول الله -صلى الله عليه وسلم- "من قرأ سورة الحديد كتب من الذين آمنوا بالله ورسوله" (¬6).(@)(@)PageV26P010(@)(@)(@@) {بسم الله الرحمن الرحيم}(@)(@)(@@)(@@)(@@) || AUTO 1(@)(@)(@@) - قوله عز وجل- {سبح لله ما في السماوات والأرض}(@)(@@) أي: مجد الله ونزهه من السوء 
ms3417	 (¬(@)(@)(@@)(@@)(@@) || AUTO 1)(@)(@)(@@) .(@)(@@) وعن ابن عباس -رضي الله عنهما-: صلى لله {ما في السماوات} ممن خلق، وهم الملائكة (¬2) {والأرض} من شيء فيه روح أو لا روح فيه (¬3).(@)(@@) {وهو العزيز} الغالب (¬4).(@)(@@) {الحكيم} في أمره وقضائه في خلقه (¬5).(@)(@@) وعن ابن إسحاق: الحكيم في حجته وإعذاره إلى عباده (¬6).(@)(@)PageV26P011(@)(@)(@@) {له ملك السماوات والأرض} لا يملكها غيره، وقيل: أراد خزائن المطر والنبات وسائر الرزق (¬1).(@)(@)(@@)(@@)(@@) || AUTO 2(@)(@)(@@) - {يحيي} الموتى يوم القيامة (¬(@)(@)(@@)(@@)(@@) || AUTO 2)(@)(@)(@@) .(@)(@@) {ويميت} الأحياء في الدنيا (¬(@)(@)(@@)(@@)(@@) || AUTO 3)(@)(@)(@@) ، وقيل: يحيي النطف وهي موات، ويميت الأحياء (¬4).(@)(@@) وموضع: {يحيي ويميت} رفع على معنى هو يحيي ويميت (¬5) ويجوز أن يكون نصبا بمعنى له ملك السموات والأرض محييا ومميتا (¬6).(@)(@@) {وهو على كل شيء قدير} لا يعجزه شيء (¬7).(@)(@)(@@)(@@)(@@) || AUTO 3(@)(@)(@@) - قوله -عز وجل-: {هو الأول}(@)(@@) قبل كل شيء بلا حد ولا ابتداء كان هو ولا شيء موجود (¬8).(@)(@)PageV26P012(@)(@)(@@) {والآخر} بعد فناء كل شيء بلا انتهاء (¬1).(@)(@@) {والظاهر} الغالب العالي على كل شيء (¬2)، وقيل: هو العالم بما ظهر (¬3).(@)(@@) {والباطن} العالم بكل شيء فلا أحد أعلم منه (¬4).(@)(@@) وقيل: هو العالم بما يكون مما بطن علمه عن الخلق (¬5) هذا معنى قول ابن عباس-رضي الله عنهما -كما تقول: فلان يبطن أمر فلان، أي: يعلم دخلة أمره (¬6).(@)(@@) وقال ابن عمر -رضي الله عنهما-: الأول: بالخلق، والآخر بالرزق والظاهر بالإحياء والباطن بالإماتة (¬7).(@)(@@) وقال مجاهد: هو الذي أول الأول، وأخر الآخر، وأظهر الظاهر وأبطن الباطن (¬8).(@)(@)PageV26P013(@)(@)(@@) وقال مقاتل بن حيان: هو الأول بلا تأويل أحد، والآخر بلا تأخير أحد، والظاهر بلا إظهار أحد، والباطن بلا إبطان أحد (¬1).(@)(@@) وقال يمان: هو الأول القديم، والآخر الرحيم، والظاهر الحليم والباطن العليم (¬2).(@)(@@) وقيل: الظاهر الغالب من قوله تعالى: {فأصبحوا ظاهرين} (¬3).(@)(@@) والباطن المستولي على السرائر، وقيل: الظاهر القائم بما ظهر وبطن، والباطن القاهر لما ظهر وبطن (¬4).(@)(@@) وقيل: الظاهر فوق كل شيء، والباطن القريب من كل شيء (¬5).(@)(@@) وقال محمد بن الفضل: الأول ببره، والآخر بعفوه، والظاهر بإحسانه، والباطن بستره (¬6).(@)(@@) وقال أبو بكر الوراق: هو الأول بالأزلية، والآخر بالأبدية، والظاهر بالأحدية، والباطن بالصمدية.(@)(@@) وقال عبد العزيز بن يحيى: الواوات مقحمة، أي: 
ms3418	 هو الأول الآخر الظاهر الباطن، لأن من كان من الخلق أولا لا يكون آخرا ومن كان ظاهرا لم يكن باطنا (¬7).(@)(@)PageV26P014(@)(@)(@@) وقال الحسين بن الفضل: هو الأول بلا ابتداء، والآخر بلا انتهاء، والظاهر بلا اقتراب، والباطن بلا احتجاب (¬1).(@)(@@) وقال القناد: {الأول} السابق إلى فعل الخير، والمتقدم على كل محسن إلى فعل الإحسان، و {الآخر} الباقي بعد فقد الخلق والخاتم بفعل الإحسان، و {الظاهر} الغالب القاهر لكل أحد، ومن غلب على شيء فقد ظهر عليه، و {الباطن} الذي يعلم الظواهر ويطلع على السرائر، والظاهر أيضا الذي ظهر للعقول بالإعلام، وظهر للأرواح باليقين، وإن خفي عن أعين الناظرين، والباطن الذي عرف المغيبات وأشرف على المستترات، والباطن أيضا الذي خفي على الظواهر فلم يدرك إلا بالسرائر (¬2).(@)(@@) وقال السدي: هو الأول ببره؛ إذ عرفك بتوحيده، والآخر بجوده، إذ عرفك التوبة على ما جنيت، والظاهر بتوفيقه؛ إذ وفقك للسجود له، والباطن بستره إذا عصيته يستر عليك (¬3).(@)(@@) وقال ابن عطاء: الأول: بكشف أحوال الدنيا حتى لا ترغبوا فيها، والآخر بكشف أحوال العقبى حتى لا تشكوا فيها، الظاهر على قلوب أوليائه حتى تعرفوه، والباطن على قلوب أعدائه حتى ينكروه (¬4).(@)(@)PageV26P015(@)(@)(@@) وقيل: الأول قبل كل معلوم، والآخر بعد كل مختوم، والظاهر فوق كل مرسوم، والباطن الذي أحاط بكل مكتوم (¬1).(@)(@@) وقيل: الأول بإحاطة علمه بذنوبنا قبل وجودها، والآخر بسترها علينا في عقبانا، والظاهر بحفظه إيانا في دنيانا، والباطن بتصفية أسرارنا، وتنقية أذكارنا.(@)(@@) وقيل: الأول بالتكوين؛ بيانه {إنما قولنا لشيء إذا أردناه أن نقول له كن فيكون (40)}.(@)(@@) والآخر بالتلقين والتثبيت بيانه: {يثبت الله الذين آمنوا بالقول الثابت} الآية.(@)(@@) والظاهر بالتبيين بيانه {يريد الله ليبين لكم}، والباطن بالتزيين بيانه {وزينه في قلوبكم} (¬2).(@)(@@) وقال محمد بن علي الترمذي: الأول: بالتأليف، والآخر بالكتليف، ، والظاهر بالتصريف، والباطن بالتعريف (¬3).(@)(@@) وقال الجنيد: هو الأول بشرح القلوب، والآخر بغفران الذنوب، والظاهر بكشف الكروب، والباطن بعلم الغيوب (¬4).(@)(@@) وسأل عمر -رضي الله عنه- كعبا عن هذه الآية، فقال: معناها أن علمه PageV26P016(@)(@@) بالأول كعلمه بالآخر، وعلمه بالباطن كعلمه بالظاهر، وعلمه بالظاهر كعلمه بالباطن 
ms3419	 (¬1).(@)(@@) وقيل: هو الأول بالهيبة والسلطان، والآخر بالرحمة والإحسان، والظاهر بالحجة والبرهان، والباطن بالعصمة والامتنان.(@)(@@) وقيل: هو الأول بالعطاء، والآخر بالجزاء، والظاهر بالثناء، والباطن بالوفاء.(@)(@@) وقيل: هو الأول بالبر والكرم، والآخر بتحلة القسم، والظاهر بإسباغ النعم، والباطن بدفع النقم.(@)(@@) وقيل: هو الأول بالهداية، والآخر بالكفاية، والظاهر بالولاية، والباطن بالرعاية.(@)(@@) وقيل: هو الأول بالإنعام، والآخر بالإتمام، والظاهر بالإكرام، والباطن بالإلهام.(@)(@@) وقيل: هو الأول بتسمية الأسماء، والآخر بتكملة النعماء، والظاهر بتسوية الأعضاء، والباطن بدفع اللأواء (¬2).(@)(@@) وقيل: هو الأول بإنشاء الخلائق، والآخر بإفناء الطرائق، والظاهر بإظهار الحقائق، والباطن بعلم الدقائق (¬3).(@)(@@) وقال سري السقطي: لم يدع للخلق نفسا بعدما أخبر عن نفسه أنه PageV26P017(@)(@@) الأول والآخر والظاهر والباطن (¬1).(@)(@@) [3025] وسمعت أبا عبد الرحمن السلمي (¬2)، يقول: سمعت أبا بكر الرازى (¬3) يقول: سمعت الشبلي (¬4)، يقول في هذه الآية: الأشياء متساقطة، فإني أول آخر ظاهر باطن (¬5).(@)(@@) [3026] أخبرنا شعيب بن محمد (¬6)، قال: أخبرنا مكي بن عبدان (¬7)، قال: أنبأنا أحمد بن الأزهر (¬8) (¬9)، قال: حدثنا روح بن عبادة (¬10)، عن سعيد (¬11)، عن قتادة (¬12)، قال: ذكر لنا أن نبي الله -صلى الله عليه وسلم- بينا هو جالس في أصحابه إذ أتى عليهم سحاب، فقال: "هل PageV26P018(@)(@@) تدرون ما هذا؟ " قالوا: الله ورسوله أعلم، قال: "هذا العنان هذا زوايا الأرض، يسوقه الله -عز وجل- إلى قوم لا يعرفونه ولا يشكرونه ولا يدعونه ولا يدرونه" ثم قال: "هل تدرون ما فوق ذلك؟ "، قالوا: الله ورسوله أعلم، قال: "سماء الدنيا أتدرون ما هي؟ " قالوا: الله ورسوله أعلم، قال: "فإنها الرقيع موج مكفوف، وسقف محفوظ، قال: فهل تدرون كم بينكم وبينها؟ " قالوا: الله ورسوله أعلم؟ قال: "بينكم وبينها مسيرة خمسمائة عام، قال: فهل تدرون ما فوق ذلك؟ " قالوا: الله ورسوله أعلم، قال: "فإن فوقها سماء أخرى بينهما مسيرة خمسمائة عام" حتى عد سبع سموات بين كل سماءين مسيرة خمسمائة عام، ثم قال: "هل تدرون ما فوق ذلك؟ " قالوا: الله ورسوله أعلم، قال: "كان فوقها العرش وبينه وبين السماء السابعة كما بين سماءين"، ثم قال: "أتدرون ما تحتكم؟ " قالوا: الله ورسوله أعلم، قال: 
ms3420	 "فإنها الأرض، فهل تدرون ما تحتها؟ "قالوا: الله ورسوله أعلم، قال: "أرض أخرى وبينهما مسيرة خمسمائة سنة" حتى عد كذلك سبع أرضين، ثم قال: "والذي نفسي بيده لو دليتم أحدكم بحبل إلى الأرض السابعة لهبط على الله تعالى"، ثم قرأ: {هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم (3)} (¬1) PageV26P019(@)(@@) ومعنى إحاطته تعالى بالسموات إحاطة علم وقدرة وخلق وملك.(@)(@@) [3027] أخبرنا عبد الله بن حامد الوزان (¬1)، قال: حدثنا مكي بن عبدان (¬2)، قال: حدثنا أحمد بن منصور المروزي (¬3)، قال: حدثنا على ابن الحسن (¬4)، قال: حدثنا أبو حمزة (¬5)، عن الأعمش (¬6)، عن أبي PageV26P020(@)(@@) صالح (¬1)، عن أبي هريرة -رضي الله عنه- قال: دخلت فاطمة بنت رسول الله -صلى الله عليه وسلم- على النبي -صلى الله عليه وسلم-، فسألته خادما، وشكت إليه ما تلقى من الرحى، فقال: "ما ألفتيه عندنا، ألا أدلك على ما هو خير لك من ذلك تقولين: اللهم رب السموات السبع ورب العرش العظيم، ربنا ورب كل شيء منزل التوراة والإنجيل والفرقان، فالق الحب والنوى، أعوذ بك من شر كل شيء أنت آخذ بناصيته، أنت الأول فليس قبلك شيء، وأنت الآخر فليس بعدك شيء، وأنت الظاهر فليس فوقك شيء، وأنت الباطن فليس دونك شيء، أقض عنا الدين، وأغننا من الفقر" (¬2).(@)(@@) {وهو بكل شيء عليم} مما كان ومما يكون لا يخفى عليه شيء (¬3).(@)(@)PageV26P021(@)(@)(@@)(@@)(@@) || AUTO 4(@)(@)(@@) - {هو الذي خلق السماوات والأرض في ستة أيام}(@)(@@) من أول يوم الأحد إلى آخر يوم الجمعة.(@)(@@) {ثم استوى على العرش} أي: قصد لخلقه (¬1) قاله مجاهد.(@)(@@) [3028] أخبرنا ابن فنجويه (¬2)، قال: حدثنا عمر بن الخطاب (¬3)، قال: حدثنا عبد الله بن الفضل (¬(@)(@)(@@)(@@)(@@) || AUTO 4)(@)(@)(@@) ، قال: حدثنا أحمد بن وردان (¬5) قال: حدثنا علي بن الحسن (¬6) بن شقيق (¬7)، قال: قلت لعبد الله بن المبارك (¬8) كيف نعرف ربنا -عز وجل-؟(@)(@@) قال: في السماء السابعة على عرشه، ولا نقول كما قالت الجهمية هنا في الأرض (¬9).(@)(@@) وقد ذكرنا معنى الاستواء، وحققنا الكلام فيه فأغنى عن الإعادة.(@)(@)PageV26P022(@)(@)(@@) {يعلم ما يلج} يدخل (¬1) {في الأرض} من مطر وغيره (¬2) {وما يخرج منها} من نبات وغيره 