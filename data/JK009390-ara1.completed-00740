ms721	 السماء والأرض ، فلو كان عندي ما أتقوى به وأقوي المسلمين أو بأيديهم ما يتقوون به ، ما انطلقت سرية إلا كنت صاحبها ، ولاكن ليس ذالك بيدي ولا بأيديهم ، ولو خرجت ما بقي أحد فيه خير إلا انطلق معي وذالك يشق علي PageV02P469 وعليهم ، فلوددت أني أغزو فاقتل ، ثم أحيا ثم أغزو فاقتل ثم أحيا ثم أغزو فاقتل ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6687 ) قال النبي :(@)(@@) | 30 ( إن الله أعتقه حين ملكته ، يعني أخاه ) )(@)(@@) ( قط هق ) وضعفاه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6688 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أعطى أمتي ثلاثا لم يعط أحدا قبلهم : السلام وهي تحية أهل الجنة ، وصفوف الملائكة ، وآمين ، إلا ما كان من موسى وهاارون ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6689 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أعطى ملكا من الملائكة أسماع الخلق فهو قائم على قبري إلى يوم القيامة لا يصلي علي أحد صلاة إلا سماه باسمه واسم أبيه وقال : يا أحمد صلى عليك فلان ابن فلان ، وقد ضمن لي ربي تبارك وتعالى أن أرد عليه بكل صلاة عشرا ) )(@)(@@) ابن النجار عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6690 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أعطاني سبعين ألفا من أمتي يدخلون الجنة بغير حساب ، قال عمر : فهلا استزدته ؟ فقال : فأعطاني مع كل واحد من السبعين ألفا سبعين ، قال : فهلا استزدته ؟ قال : قد استزدته فأعطاني هاكذا ، وفتح يديه ) )(@)(@@) الحكيم ( طب ) عن عبد الرحمن بن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6691 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أعطاني حظا لم يعط أحد قبلي : سميت أحمد ، ونصرت بالرعب ، وجعلت لي الأرض مسجدا وطهورا ، وأحلت لي الغنائم ) )(@)(@@) الحكيم عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6692 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أكرم هاذه الأمة بالعصائب والألوية ، وما زرتم مساجدكم ولا قبوركم بشيء أحب من البياض ) )(@)(@@) أبو عبد الله محمد بن وضاح PageV02P470 في فضل لباس العمائم عن خالد بن معدان مرسلا .(@)(@@)(@@)(@@) $ ( 6693 ) قال النبي :(@)(@@) | 30 ( إن 
ms722	 الله عز وجل أمرني أن أقرأ القرآن على حرف ، فقلت : رب خفف عن أمتي ، فقال : اقرأه على حرفين وأمرني أن أقرأه على سبعة أحرف من سبعة أبواب من الجنة ، كلها شاف كاف ) )(@)(@@) ابن جرير عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6694 ) قال النبي :(@)(@@) | 30 ( إن الله أمرني أن أعلمكم ما جهلتم مما علمني في يومي هاذا ، فإنه قال : إن كل مال نحلته عبادي فهو لهم حلال ، وإني خلقت عبادي حنفاء كلهم فأتتهم الشياطين فاجتالتهم عن دينهم وحرمت عليهم ما أحللت لهم ، وأمرتهم أن لا يشركوا بي ما لم أنزل به سلطانا ، وإن الله نظر إلى أهل الأرض فمقتهم عربهم وعجمهم إلا بقايا من أهل الكتاب ، وإن الله أمرني أن أغزو أحرق قريشا ، فقلت : يا رب إنهم إذن يبلغوا رأسي حتى يدعوه خبزة ، فقال : إنما بعثتك لأبتليك وأبتلي بك ، وقد أنزلت عليك كتابا لا يغسله الماء ، تقرؤه في المنام واليقظة ، فاعزهم بعزك ، وأنفق ينفق عليك ، وابعث جيشا نمدك بخمسة أمثالهم ، وقاتل بمن أطاعك من عصاك ) )(@)(@@) ( طب ) عن عياض بن حمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6695 ) قال النبي :(@)(@@) | 30 ( إن الله بعثني نبيا مرحمة وملحمة ولم يبعثني تاجرا ولا زراعا ، وإن شرار هاذه الأمة التجار والزراع إلا من شح على دينه ) )(@)(@@) ابن جرير عن الضحاك مرسلا .(@)(@@)(@@)(@@) $ ( 6696 ) قال النبي :(@)(@@) | 30 ( إن الله باهى الملائكة عشية عرفة بعمر بن الخطاب ) )(@)(@@) ( عد ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6697 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل بعث جبريل إلى إبراهيم فقال له : PageV02P471 يا إبراهيم إني لم أتخذك خليلا ، إنك أعبد عبادي ، ولاكن اطلعت في قلوب المؤمنين فلم أجد قلبا أسخى من قلبك ) )(@)(@@) أبو الشيخ في الثواب عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6698 ) قال النبي :(@)(@@) | 30 ( إن الله بعثني إليكم فقلتم : كذبت ، وقال أبو بكر : صدق ، وواساني بنفسه وماله ، فهل أنتم تاركو لي صاحبي ، فهل أنتم تاركو لي صاحبي ) )(@)(@@) ( خ ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6699 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل بعثني 
ms723	 رحمة للعالمين وهدى للعالمين وأمرني ربي عز وجل بمحق المعازف والمزامير والأوثان والصلب وأمر الجاهلية ، وحلف ربي عز وجل بعزته : لا يشرب عبد من عبادي جرعة من خمر إلا سقيته من الصديد مثلها يوم القيامة مغفورا له أو معذبا ، ولا يسقيها صبيا صغيرا ضعيفا مسلما إلا سقيته من الصديد مثلها يوم القيامة مغفورا له أو معذبا ، ولا يتركها من مخافتي إلا سقيته من حضرة القدس يوم القيامة ، ولا يحل بيعهن ولا شراؤهن ولا تعليمهن ولا تجارة فيهن وثمنهن حرام يعني الضاربات ) )(@)(@@) ( ط حم طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6700 ) قال النبي :(@)(@@) | 30 ( إن الله بعثني رحمة للناس كافة ، فأدوا عني رحمكم الله ولا تختلفوا كما اختلف الحواريون على عيسى فإنه دعاهم إلى مثل ما أدعوكم إليه ، فأما من بعد مكانه فكرهه ، فشكى عيسى بن مريم ذالك إلى الله تعالى فأصبحوا وكل رجل منهم يتكلم بلسان القوم الذين وجه إليهم ، فقال لهم عيسى : هاذا أمر قد عزم الله لكم عليه فامضوا فافعلوا ) )(@)(@@) ( طب ) عن المسور بن مخرمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6701 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل بعثني بالهدى ودين الحق ، ولم PageV02P472 يجعلني زراعا ولا تاجرا ولا صخابا بالأسواق وجعل رزقي في رمحي ) )(@)(@@) الديلمي عن عبد الرحمن بن عتبة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6702 ) قال النبي :(@)(@@) | 30 ( إن الله تجاوز عن أمتي ثلاثة : الخطأ والنسيان وما أكرهوا عليه ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6703 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى تجاوز لأمتي عن النسيان وما أكرهوا عليه ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6704 ) قال النبي :(@)(@@) | 30 ( إن الله تطاول عليكم في يومكم هاذا فوهب مسيئكم لمحسنكم ) )(@)(@@) البغوي عن عبد الرحمان بن عبد الله بن زيد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6705 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل تطول على أهل عرفات فباهى بهم الملائكة فقال : انظروا يا ملائكتي إلى عبادي شعثا غبرا أقبلوا يضربون إلي من كل فج عميق ، أشهدكم أني قد أجبت دعوتهم ، وشفعت 
ms724	 رغبتهم ، ووهبت مسيئهم لمحسنهم وأعطيت محسنهم جميع ما سألني غير التبعات التي بينهم حتى إذا أفاض القوم من عرفات أتوا جمعا فوقفوا ، قال : انظروا يا ملائكتي إلى عبادي عاودوني في المسألة ، أشهدكم أني قد أجبت دعوتهم ، وشفعت رغبتهم ، ووهبت مسيئهم لمحسنهم ، وأعطيت محسنهم جميع ما سأل ، وتحملت عنهم التبعات التي بينهم ) )(@)(@@) الخطيب في المتفق والمفترق عن أنس رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 6706 ) قال النبي :(@)(@@) | 30 ( إن الله جعل لكل شيء آفة تفسده ، وأعظم آفة تصيب أمتي حبهم الدنيا ، وجمعهم الدينار والدرهم ، يا أبا هريرة لا خير في كثير ممن جمعها إلا من سلطه الله على هلكتها في الحق ) )(@)(@@) ( الرافعي ) عن أبي هريرة ( الديلمي ) عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6707 ) قال النبي :(@)(@@) | 30 ( إن الله جعل الحق في قلب عمر وعلى لسانه ) )(@)(@@) ابن عساكر عن أبي بكر الصديق رضي الله عنه .(@)(@@) PageV02P473(@)(@@)(@@)(@@) $ ( 6708 ) قال النبي :(@)(@@) | 30 ( إن الله جعل الحق في قلب عمر وعلى لسانه ) )(@)(@@) الشاشي ( كر ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6709 ) قال النبي :(@)(@@) | 30 ( إن الله جعل السكينة على لسان عمر وقلبه يقول بها ) )(@)(@@) ( كر ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6710 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل جعل هاذا الحي من لخم ، وجذام مغوثة بالشام بالظهر والضرع كما جعل يوسف بمصر مغوثة لأهلها ) )(@)(@@) ( طب ) عن عبد الله بن سويد الإلهاني عن أبيه .(@)(@@)(@@)(@@) $ ( 6711 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل جعل حسنات ابن آدم بعشر أمثالها إلى سبعمائة ضعف ، قال الله تعالى : إلا الصوم ، والصوم لي وأنا أجزي به ، إن للصائم فرحتين : فرحة حين يفطر ، وفرحة يوم القيامة ، ولخلوف فم الصائم أطيب عند الله من ريح المسك ) )(@)(@@) ( حم ) و الخطيب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6712 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جعل النجوم أمانا لأهل السماء ، فإذا طمست اقترب لأهل السماء ما يوعدون ، وإن الله تعالى جعل أصحابي أمانا لامتي ، فإذا هلك أصحابي اقترب لأمتي ما يوعدون ) )(@)(@@) ( طب ) عن عبد الله بن المستورد رضي الله عنه 
ms725	 .(@)(@@)(@@)(@@) $ ( 6713 ) قال النبي :(@)(@@) | 30 ( إن الله جعل لجعفر جناحين مضرجين بالدر يطير بهما مع الملائكة ) )(@)(@@) ( ك ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6714 ) قال النبي :(@)(@@) | 30 ( إن الله جعل بالمغرب بابا ، مسيرة عرضه سبعين عاما للتوبة ، لا يغلق ما لم تطلع الشمس من مغربها قبله وذالك قوله : يوم يأتي PageV02P474 بعض آبات ربك لا ينفع نفسا إيمانها ) )(@)(@@) ابن زنجويه عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6715 ) قال النبي :(@)(@@) | 30 ( إن الله جعلني عبدا كريما ولم يجعلني جبارا عصيا عنيدا ، كلوا من جوانبها ودعوا ذروتها يبارك فيها ، خذوا ، فوالذي نفس محمد بيده لتفتحن عليكم أرض فارس والروم حتى يكثر الطعام فلا يذكر عليه اسم الله عز وجل ) )(@)(@@) ( هق ) عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6716 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جميل يحب الجمال ويحب أن يرى أثر نعمته على عبده ، الكبر من سفه الحق وغمص الناس أعمالهم ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما أن أبا ريحانة قال : يا رسول الله إني لاحب الجمال حتى في نعلي وعلاقة سوطي أفمن الكبر ذالك ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 6717 ) قال النبي :(@)(@@) | 30 ( إن الله جميل يحب الجمال ، الكبر بطر الحق وغمط الناس ) )(@)(@@) ( م ت ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6718 ) قال النبي :(@)(@@) | 30 ( إن الله جميل يحب الجمال وإنما الكبر من جهل الحق وغمص الناس بعيبه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6719 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جميل يحب الجمال ويحب إذا أنعم على عبده نعمة أن يرى أثرها عليه ، ويبغض البؤس والتباؤس ، ولاكن الكبر أن تسفه الحق وتبغض الخلق ) )(@)(@@) ( هناد ) عن يحيى بن جعدة مرسلا .(@)(@@)(@@)(@@) $ ( 6720 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى جواد يحب الجود ويحب معالي الأخلاق ، ويكره سفسافها ، وإن من إكرام جلال الله إكرام ثلاثة : إكرام ذي الشيبة في الإسلام ، والحامل للقرآن غير الجافي عنه ولا الغالي والإمام المقسط ) )(@)(@@) PageV02P475 ( هناد ) والخرائطي في مكارم الأخلاق عن طلحة بن عبد الله بن كرز مرسلا .(@)(@@)(@@)(@@) $ ( 6721 ) قال النبي 
ms726	 :(@)(@@) | 30 ( إن الله حيي حليم ستير ، فإذا اغتسل أحدكم فليستتر ولو بجذم حائط ) )(@)(@@) ابن عساكر عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6722 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حرم الخمر وثمنها ، وحرم الميتة وثمنها ، وحرم الخنزير وثمنه ) )(@)(@@) ( د حل هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6723 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حرم النار على من شهد أن لا إلاه إلا الله وأني رسول الله ) )(@)(@@) عبد بن حميد عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6724 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حرم عليكم الخمر والميسر والكوبة ، وكل مسكر حرام ) )(@)(@@) ( د ) و ابن أبي الدنيا في ذم الملاهي ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6725 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حرم الجنة على كل مراء ، ليس البر في حسن اللباس والزي ، ولاكن البر السكينة والوقار ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6726 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حرم الجنة على جسد غذي بحرام ) )(@)(@@) عبد بن حميد ( ع ) عن أبي بكر رضي الله عنه وهو ضعيف .(@)(@@)(@@)(@@) $ ( 6727 ) قال النبي :(@)(@@) | 30 ( إن الله حرم على لساني ما بين لابتي المدينة ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6728 ) قال النبي :(@)(@@) | 30 ( إن الله حين خلق الخلق كتب بيده على نفسه : أن رحمتي تغلب غضبي ) )(@)(@@) ( ت ) حسن صحيح عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6729 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حيي كريم ليستحيي أن يبسط عبده PageV02P476 يديه إليه ثم يردهما صفرين ليس فيهما شيء ) )(@)(@@) ( حل ) و ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6730 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى حيا محمدا وأمته بغير هاذه التحية ، بالتسليم بعضها على بعض ) )(@)(@@) أبو نعيم والديلمي عن عبد الجبار بن الحارث بن مالك رضي الله عنه قال : وفدت على رسول الله فحييته بتحية العرب فقلت : أنعم صباحا قال : فذكره .(@)(@@)(@@)(@@) $ ( 6731 ) قال النبي :(@)(@@) | 30 ( إن الله حيي يحب الحياء ، وستير يحب الستر ، فإذا اغتسل 
ms727	 أحدكم فليتوارى ) )(@)(@@) عبد الرزاق عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 6732 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق آدم ثم أخذ الخلق من ظهره ثم قال : هاؤلاء إلى الجنة ولا أبالي ، وهاؤلاء إلى النار ولا أبالي ، قيل : يا رسول الله على ماذا نعمل ؟ قال : على مواقع القدر ) )(@)(@@) ( حم ) و ابن سعد والحكيم ( ك ) عن عبد الرحمان بن قتادة السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6733 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق خلقه في ظلمة ثم ألقى عليهم من نوره ، فمن أصابه من ذالك النور اهتدى ، ومن أخطأه ضل ، فلذالك أقول : جف القلم على علم الله ) )(@)(@@) ( حم ت ) حسن و ابن جرير ( طب ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6734 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق طائرا في الزمن الأول يقال له العنقاء ، فكثر نسله ببلاد الحجاز فكانت تخطف الصبيان فشكوا ذالك لخالد بن سنان وهو نبي ظهر بعد عيسى من بني عبس ، فدعا عليها أن يقطع نسلها فبقيت صورتها ) )(@)(@@) في السبط المسعودي في مروج الذهب عن ابن عباس رضي الله عنهما .(@)(@@) PageV02P477(@)(@@)(@@)(@@) $ ( 6735 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق الجنة وخلق لها أهلا بعشائرهم وقبائلهم لا يزاد فيهم ولا ينقص منهم ، وخلق النار وخلق لها أهلا بعشائرهم وقبائلهم لا يزاد فيهم ولا ينقص منهم ، اعملوا فكل امرىء ميسر لما خلق له ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6736 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق مائة رحمة كل رحمة ملء ما بين السماء والأرض ، قسم منها رحمة بين رحمة بين الخلائق بها تعطف الوالدة على ولدها ، وبها تشرب الوحح والطير الماء ، وبها تتراحم الخلائق ، فإذا كان يوم القيامة قصرها على المتقين وزادهم تسعا وتسعين ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6737 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق ألف أمة ، ستمائة منها في البحر ، وأربعمائة في البر ، فأول هاذه الأمم هلاكا الجراد ، فإذا هلك الجراد تتابعت الأمم مثل نظام السلك إذا انقطع ) )(@)(@@) الحكيم ( ع ) وابو الشيخ في العظمة ( هب 
ms728	 ) وضعفه عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6738 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق مائة رحمة ، فرحمة بين خلقه يتراحمون بها ، وادخر لأوليائه تسعة وتسعين ) )(@)(@@) ( طب ) عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6739 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق يوم خلق السماوات والأرض مائة رحمة ، كل رحمة طباقها طباق السماوات والأرض ، فقسم رحمة بين الخلائق ، وأخر تسعة وتسعين رحمة لنفسه ، فإذا كان يوم القيامة رد هاذه الرحمة فصارت مائة رحمة يرحم بها عباده ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6740 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل خلق السماوات سبعا واختار العلى منها فأسكنها من شاء من خلقه ، ثم خلق الخلق فاختار من خلقه بني آدم ، واختار PageV02P478 من بني آدم العرب ، واختار من مضر قريشا ، واختار من قريش بني هاشم ، واختارني من بني هاشم ، فأنا خيار إلى خيار ، فمن أحب العرب فبحبي أحبهم ، ومن أبغض العرب فببغضي أبغضهم ) )(@)(@@) ( عد هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6741 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل خلق النهار اثنتي عشرة ساعة ، وأعد لكل ساعة منها ركعتين تدرأ عنك ذنب تلك الساعة ) )(@)(@@) الديلمي عن طريق عبد الملك بن هارون ابن عنترة عن أبيه عن جده عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6742 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خلق ثلاثة أشياء بيده : خلق آدم بيده ، وكتب التوراة بيده ، وغرس الفردوس بيده ) )(@)(@@) ( قط ) في الصفات وقال : وعزتي لا يسكنها مدمن خمر ولا ديوث ، قالوا : يا رسول الله ما الديوث ؟ قال : من يقر السوء إلى أهله ) )(@)(@@) | ال| خرائطي في مساوىء الأخلاق عن عبد الله بن الحارث بن نوفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6743 ) قال النبي :(@)(@@) | 30 ( إن الله خلق مائة رحمة فبث بين خلقه رحمة واحدة فهم يتراحمون بها ، وادخر عنده لأوليائه تسعة وتسعين ) )(@)(@@) تمام وابن عساكر عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6744 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل خلق الدنيا منذ خلقها فلم ينظر إليها بعد إلا 
ms729	 مكان المتعبدين منها ، وليس بناظر إليها إلى يوم ينفخ في الصور ويأذن في هلاكها مقتا لها ولم يؤثرها على الآخرة ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6745 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى خمر طينة آدم أربعين صباحا بلياليها ثم ضرب بيده اليمنى وكلتا يديه ، يمين فقطع قطعة ، ثم خلطها عنها يخرج المؤمن من الكافر ، والكافر من المؤمن ) )(@)(@@) ابن مردويه عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6746 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل خمر طينة آدم أربعين يوما وليلة ثم أخذها بعده ثم قال : هاكذا قطعها بيده فخرج في يمينه كل نفس طيبة ، وخرج PageV02P479 في يده الأخرى كل نفس خبيثة ، ثم شبك بين أصابعه حتى خلطها فلذالك يخرج الحي من الميت ، والميت من الحي ، والمؤمن من الكافر ، والكافر من المؤمن ) )(@)(@@) الديلمي من طريق أبي عثمان النهدي عن ابن مسعود وسلمان رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6747 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل خيرني بين أن يغفر لنصف أمتي أو شفاعتي فاخترت شفاعتي ورجوت أن تكون أعم لامتي ، ولولا الذي سبقني إليه العبد الصالح لعجلت دعوتي ، إن الله لما فرج عن إسحاق كرب الذبح قيل له : يا إسحاق سل تعطه ، قال : أما والله لأتعجلنها قبل نزغات الشيطان ، اللهم من مات لا يشرك بك شيئا وأحسن فاغفر له وأدخله الجنة ) )(@)(@@) ( طب كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6748 ) قال النبي :(@)(@@) | 30 ( إن الله خير عبدا بين الدنيا وبين ما عنده فاختار ذالك العبد ما عند الله ، فبكى أبو بكر ، فقال : يا أبا بكر لا تبك ؟ إن أمن الناس علي في صحبته وماله أبو بكر ، ولو كنت متخذا خليلا غير ربي لاتخذت أبا بكر خليلا ، ولاكن أخوة الإسلام ومودته ، لا يبقين في المسجد باب إلا سد إلا باب أبي بكر ) )(@)(@@) ( حم خ م ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6749 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ذبح ما في البحر لبني آدم ) )(@)(@@) ( قط ) أبو نعيم في المعرفة عن شريح الحجازي 
ms730	 رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 6750 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى رضي لكم ثلاثا وكره لكم ثلاثا ورضي لكم أن تعبدوه ولا تشركوا به شيئا ، وأن تعتصموا بحبل الله جميعا ولا تفرقوا ، وتسمعوا وتطيعوا لمن ولاه الله أمركم ، ويكره لكم قيل وقال ، وكثرة السؤال ، وإضاعة المال ) )(@)(@@) البغوي عن أبي جعديه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6751 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل رفع لي الدنيا فأنا أنظر فيها ، وإلى PageV02P480 ما هو كائن فيها إلى يوم القيامة كما أنظر إلى كفي هاذه جليان من الله جلاه لنبيه كما جلى للنبيين من قبله ) )(@)(@@) نعيم بن حماد في الفتن عن ابن عمر رضي الله عنهما وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 6752 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى رفيق يحب الرفق فإذا سافرتم في الخصب فأمكنوا الركاب أسنتها ولا تجاوزوا بها المنازل ، وإذا سرتم في الجدب فانجوا ، وعليكم بالدلجة ، فإن الأرض تطوى بالليل ما لا تطوى بالنهار ، وإياكم والتعريس بالطريق ، فإنه طريق الدواب ومأوى الحيات ) )(@)(@@) ( طب ) عن خالد بن معدان عن أبيه .(@)(@@)(@@)(@@) $ ( 6753 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل رفيق يحب الرفق ، فإذا سافرتم في الخصب فأمكنواالركاب أسنتها ولا تجاوزوا بها المنازل ، وإذا سرتم في الجدب فانجوا وعليكم بالدلجة فإن الأرض تطوى بالليل ، وإذا تغولت بكم الغيلان فبادروا بالأذان ، وإياكم والصلاة على جواد الطريق فإنها ممر السباع ومأوى الحيات ) )(@)(@@) ابن السني في عمل يوم وليلة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6754 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل رفيق يحب الرفق في الأمر كله ، ويحب كل قلب خاشع حزين رحيم ، يعلم الناس الخير ويدعو إلى طاعة الله ، ويبغض كل قلب قاس لاه ينام الليل كله ولا يذكر الله تعالى فلا يدري يرد الله روحه أم لا ؟ ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6755 ) قال النبي :(@)(@@) | 30 ( إن الله رفيق ما لا يعين على العنف ) )(@)(@@) ( طب ) و ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6756 ) قال النبي :(@)(@@) | 30 ( إن الله زادكم صلاة فصلوها فيما بين صلاة 
ms731	 العشاء PageV02P481 إلى صلاة الفجر ، والوتر الوتر ) )(@)(@@) ( حم ) و ابن قانع والباوردي ( طب ض ) عن أبي بصرة الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6757 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل زادكم صلاة هي خير لكم من حمر النعم الوتر وهي لكم فيما بين صلاة العشاء إلى طلوع الفجر ) )(@)(@@) محمد بن نصر ( طب حل ) عن أبي الخير عن عمرو بن العاص وعقبة بن عامر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 6758 ) قال النبي :(@)(@@) | 30 ( إن الله زادكم صلاة إلى صلاتكم فحافظوا عليها وهي الوتر ) )(@)(@@) ( عب ش ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6759 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل زادكم صلاة إلى صلاتكم هي خير من حمر النعم ألا وهي الركعتان قبل صلاة الفجر ) )(@)(@@) ( هق كر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6760 ) قال النبي :(@)(@@) | 30 ( إن الله سيفتح عليكم بعدي مصر فاستوصوا بقبطها خيرا ، فإن لكم منهم صهرا وذمة ) )(@)(@@) ابن يونس في تاريخه ( كر ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6761 ) قال النبي :(@)(@@) | 30 ( إن الله سيهدي قلبك ويثبت لسانك ، فإذا جلس بين يديك الخصمان فلا تقضين حتى تسمع من الآخر كما سمعت من الأول فإنه أحرى أن يتبين لك القضاء ) )(@)(@@) ( د هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6762 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ضرب ما يخرج من ابن آدم مثلا للدنيا ) )(@)(@@) ( حم ) والبغوي ( طب هب ) عن الضحاك بن سفيان الكلابي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6763 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل عند لسان كل قائل فليتق الله امرؤ علم ما يقول ، وفي لفظ : فليتق الله عبد ولينظر ما يقول ) )(@)(@@) ابن المبارك ( حم ) في الزهد والحكيم ( حل هب ) والخطيب عن عمر بن ذر عن أبيه مرسلا الحكيم عنه عن PageV02P482 سعيد بن جبير عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6764 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل عهد إلي أن لا يأتيني أحد من أمتي بلا إلاه إلا الله لا يخلط بها شيئا إلا أوجبت له الجنة ، قالوا : يا رسول الله ، وما 
ms732	 الذي يخلط بلا إلاه إلا الله ، قال : حرصا على الدنيا وجمعا لها ومنعا لها ، يقولون قول الأنبياء ، ويعملون أعمال الجبابرة ) )(@)(@@) الحكيم عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6765 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى غافر إلا لمن أبى قيل : يا رسول الله ومن يأبى ؟ قال : من لا يستغفر ) )(@)(@@) ابن شاهين والديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6766 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى غني عن نذر أختك لتحج راكبة وتهدي بدنة ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6767 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى غرس جنة عدن بيده وزخرفها وأمر الملائكة فشقت فيها الأنهار فتدلت فيها الثمار ، فلما نظر إلى زهرتها وحسنها قال : وعزتي وجلالي وارتفاعي فوق عرشي لا يجاورني فيك بخيل ) )(@)(@@) ابن النجار والخطيب في كتاب البخلاء عن ابن بن عباس رضي الله عنهما وهو ضعيف .(@)(@@)(@@)(@@) $ ( 6768 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل غني عن نذر أختك ، فلتركب ولتهد بدنة ) )(@)(@@) ( حم طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6769 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى غير معذبك ولا ولدك ) )(@)(@@) قاله لفاطمة ( طب ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6770 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى فرض صيام رمضان وسننت لكم قيامه ، فمن صامه وقامه إيمانا واحتسابا خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) ( حم ن ) PageV02P483 عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6771 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل فرض فرائض فلا تضيعوها ، وحد حدودا فلا تعتدوها ، وحرم أشياء فلا تقربوها ، وترك أشياء غير نسيان رحمة لكم فلا تبحثوا عنها ) )(@)(@@) ( طب حل هق ) عن أبي ثعلبة الخشني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6772 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قد افترض فرائض فلا تضيعوها ، وحد حدودا فلا تعتدوها ، وسكت عن كثير من غير نسيان فلا تكلفوها رحمة لكم فاقبلوها ) )(@)(@@) ( طس ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6773 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قال : من انتدب خارجا في سبيلي غازيا ابتغاء وجهي وتصديق وعيدي وإيمانا 
ms733	 برسلي فهو ضامن على الله عز وجل ، إما يتوفاه في الجيي بأي حتف شاء فيدخله الجنة ، وإما يسبح في ضمان الله وإن طالت غيبته حتى يرده إلى أهله مع ما نال من آجر وغنيمة ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6774 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يوم خلق آدم قبض من صلبه قبضة فوقع كل طيب في يمينه وكل خبيث في يده الأخرى فقال : هاؤلاء أصحاب اليمين ولا أبالي ، وهاؤلاء أصحاب الشمال ولا أبالي هاؤلاء أصحاب النار ، ثم أعادهم في صلب آدم يتناسلون على ذالك الآن ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6775 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قبض بيمينه قبضة وأخرى باليد الأخرى ، قال : هاذه لهاذه ، وهاذه لهاذه ولا أبالي ) )(@)(@@) ( حم ) عن أبي عبد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6776 ) قال النبي :(@)(@@) | 30 ( إن الله قد جعل لكل ذي حق حقه ، ألا لا وصية PageV02P484 لوارث ، والولد للفراش وللعاهر الحجر ، ألا لا يتولين رجل غير مواليه ، ولا يدعي إلى غير أبيه ، فمن فعل ذالك فعليه لعنة الله متتابعة إلى يوم القيامة ، ألا لا تنفق امرأة من بيت زوجها إلا باذن زوجها ، ألا إن العارية مؤداة ، والمنحة مردودة ، والدين مقضي ، والزعيم غارم ) )(@)(@@) ( الحسن بن سفيان ) ( هق ) وابن عساكر عن أنس رضي الله عنه وروى ( ه ) بعضه .(@)(@@)(@@)(@@) $ ( 6777 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد تطول في جمعكم هاذا فوهب مسيئكم لمحسنكم ، وأعطى محسنكم ما سأل ، فادفعوا على بركة الله ، إن الله باهى ملائكته بأهل عرفة عامة ، وباهى بعمر بن الخطاب خاصة ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6778 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قد أوجب لها بهما الجنة أو أعتقها بهما من النار ) )(@)(@@) ( حم م ) عن عائشة رضي الله عنها قالت : جاءتني مسكينة تحمل ابنتين لها فأطعمتها ثلاث تمرات فأعطت كل واحدة منهما تمرة ورفعت إلى فيها تمرة لتأكلها ، فاستطعمتها ابنتاها ، فشقت التمرة بينهما ، فذكرت ذالك لرسول الله قال : فذكره .(@)(@@)(@@)(@@) $ ( 6779 ) قال النبي 
ms734	 :(@)(@@) | 30 ( إن الله قد أعطى كل ذي حق حقه ، ألا إن الله قد فرض فرائض ، وسن سننا ، وحد حدودا ، وأحل حلالا ، وحرم حراما ، وشرع الدين فجعله سهلا سمحا واسعا ولم يجعله ضيقا ، ألا إنه لا إيمان لمن لا أمانة له ، ولا دين لمن لا عهد له ، ومن نكث ذمته طلبه ، ومن نكث ذمتي خاصمته ، ومن خاصمته فلجت عليه ، ومن نكث ذمتي لم ينل شفاعتي ، ولم يرد على الحوض ، ألا إن الله لم يرخص في القتل إلا ثلاثة : مرتد بعد إيمان ، أو زان بعد PageV02P485 إحصان ، أو قاتل نفس فيقتل بقتله ، ألا هل بلغت ؟ ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6780 ) قال النبي :(@)(@@) | 30 ( إن الله قد كفى وأحسن يا أم سليم ) )(@)(@@) ( ط حم م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6781 ) قال النبي :(@)(@@) | 30 ( إن الله تبارك وتعالى قد أبدلكم بهما خيرا منهما ، يوم الفطر ويوم النحر ) )(@)(@@) ( حم د ن ع ك ض ) عن أنس قال : قدم النبي المدينة ولهم يومان يلعبون فيهما قال : فذكره ( حم ) .(@)(@@)(@@)(@@) $ ( 6782 ) قال النبي :(@)(@@) | 30 ( إن الله قد أبدلكم بيومين هاذين خيرا منهما : الفطر والنحر ، أما يوم الفطر فصلاة وصدقة وأما يوم الأضحى فصلاة و| نس ك ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6783 ) قال النبي :(@)(@@) | 30 ( إن الله قد أعطى كل ذي حق حقه ، فلا وصية لوارث ) )(@)(@@) ( ن ) عن عمرو بن خارجة رضي الله عنه ( ه قط ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6784 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قد زادكم صلاة وهي الوتر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6785 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قد حيا محمدا وأمته بغير هاذه التحية ، بالتسليم بعضها على بعض ) )(@)(@@) أبو نعيم والديلمي عن عبد الجبار بن الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6786 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قد وكل بالرحم ملكا فيقول : أي رب نطفة ، أي رب علقة ، أي رب مضغة ، فإذا أراد الله تعالى أن يقضي خلقا ، PageV02P486 قال : أي رب 
ms735	 شقي أو سعيد ؟ ذكر أو أنثى ؟ فما الرزق ؟ فما الأجل ؟ فيكتب كذالك في بطن أمه ) )(@)(@@) ( ط حم خ م ) و أبو عوانة عن عبيد الله بن أبي بكر عن أنس بن مالك عن جده ( م ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6787 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قسم الحياء عشرة أجزاء فجعل في النساء تسعة ، وفي الرجال واحدا ، ولولا ذالك لتساقطن تحت ذكوركم كما تتساقط البهائم تحت ذكورها ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6788 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم ، وإن الله عز وجل يعطي الدنيا من يحب ومن لا يحب ، ولا يعطي الدين إلا من أحب ، فمن أعطاه الله الدين فقد أحبه ، والذي نفسي بيده ، لا يسلم عبد حتى يسلم قلبه ولسانه ، ولا يؤمن حتى يأمن جاره بوائقه قيل : وما بوائقه يا نبي الله ؟ قال : غشمه وظلمه ، ولا يكسب عبد مالا من حرام فينفق منه فيبارك له فيه ، ولا يتصدق به فيقبل منه ، ولا يتركه خلف ظهره إلا كان زاده إلى النار ، إن الله عز وجل لا يمحو السيء بالسيء ولاكنه يمحو السيء بالحسن ، إن الخبيث لا يمحو الخبيث ) )(@)(@@) و العسكري في الأمثال ( حم ك هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6789 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى قسم الخلق قسمين فجعلني في خيرهما قسما فذالك قوله تعالى : أصحاب اليمين وأصحاب الشمال ، وأنا من أصحاب اليمين ، وأنا من خير أصحاب اليمين ، ثم جعل القسمين بيوتا فجعلني في خيرهما بيتا فذالك قوله تعالى : أصحاب الميمنة ما أصحاب الميمنة ، وأصحاب المشأمة ما أصحاب المشأمة والسابقون السابقون فأنا من خير السابقين ، ثم جعل البيوت قبائل فجعلني في خيرها قبيلة ، فذالك قوله تعالى : شعوبا وقبائل ، فأنا أتقى ولد آدم وأكرمهم على الله عز وجل ولا فخر ، ثم جعل القبائل بيوتا فجعلني في خيرها بيتا فذالك قوله تعالى : إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرا ) )(@)(@@) الحكيم ( طب ) وابن 
ms736	 مردويه وأبو نعيم ( هق ) معا في الدلائل عن PageV02P487 ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6790 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم ، وإن الله يعطي المال من يحب ومن لا يحب ، ولا يعطي الإيمان إلا من يحب ، فإذا أحب عبدا أعطاه الإيمان ، فمن ظن في المال أنه ينفعه وهاب الليل أن يكابده وخاف العدو أن يجاهده فليكثر من سبحان الله والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، فإنهن مقدمات ومنجيات ومعقبات وهن الباقيات الصالحات ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6791 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كان عرشه على الماء ، وإنه خلق القلم فكتب ما هو كائن من خلقه ، ثم إن ذالك الكتاب سبح الله ومجده ألف عام قبل أن يبدأ بخلق شيء من الخلق ) )(@)(@@) أبو الشيخ في العظمة عن جبير بن نفير مرسلا .(@)(@@)(@@)(@@) $ ( 6792 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل كتب عليكم الحج ، قال رجل : في كل عام ؟ قال : ويحك ماذا يؤمنك أن أقول نعم ، والله لو قلت نعم لوجبت ، ولو وجبت لتركتم ، ولو تركتم لكفرتم ، ألا إنه إنما أهلك الذين قبلكم إئمة الحرج ، والله لو أني أحللت لكم جميع ما في الأرض من شيء ، وحرمت عليكم مثل خف بعير لوقعتم فيه ) )(@)(@@) ابن جرير ( طب ) وابن مردويه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6793 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كتب كتابا قبل أن يخلق السماوات والأرض ، وهو عنده فوق العرش ، والخلق منتهون إلى ما في ذالك الكتاب ) )(@)(@@) ابن مردويه والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6794 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل كره لكم قيل وقال ، وكثرة السؤال ، وإضاعة المال ، ومنعا وهات ، وعقوق الأمهات ، ووأد البنات ) )(@)(@@) ( طب ) عن عمار بن ياسر والمغيرة بن شعبة معا ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6795 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كره لكم ثلاثا : اللغو عند قراءة PageV02P488 القرآن ، والتخضر في الصلاة ، ورفع الأصوات بالدعاء وعند الدعاء ) )(@)(@@) الديلمي عن 
ms737	 جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6796 ) قال النبي :(@)(@@) | 30 ( إن الله كره لكم ثلاثا : عقوق الأمهات ، ووأد البنات ، ومنعا وهات ) )(@)(@@) ( طب ) عن عبد الله بن مغفل ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6797 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى كره لكم ثلاثا : قيل وقال ، وكثرة السؤال ، وإضاعة المال ) )(@)(@@) ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6798 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليس عرصة جنة الفردوس بيده ثم بناها لبنة من ذهب مصفى ، ولبنة من مسك مذرى ، وغرس فيها من جيد الفاكهة ، وطيب الريحان ، وفجر فيها أنهارها ، ثم أوفى ربنا على عرشه فنظر إليها فقال : وعزتي لا يدخلك مدمن الخمر ، ولا مصر على زنى ) )(@)(@@) أبو نعيم في المعرفة عن سلامة وقال : لا تصح له صحبة .(@)(@@)(@@)(@@) $ ( 6799 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لعن الخمر وعاصرها والمعتصر والجالب والمجلوب إليه والبائع والمشتري والساقي والشارب ، وحرم ثمنها على المسلمين ) )(@)(@@) الخطيب وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6800 ) قال النبي :(@)(@@) | 30 ( إن الله لغني عن مشيها ، مروها فلتركب ) )(@)(@@) ( ت ) حسن عن أنس رضي الله عنه قال : نذرت امرأة أن تمشي إلى بيت الله فسئل النبي عن ذالك فقال فذكره ( حم ) عن عامر الجهني ( ت ) عن نس ( وهق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6801 ) قال النبي :(@)(@@) | 30 ( إن الله غني عن تعذيب هاذا نفسه ، مره فليركب ) )(@)(@@) PageV02P489 ( حم خ م د ت ن ) و ابن حزيمة ( حب ) عن أنس رضي الله عنه قال : مر رسول الله بشيح يهادي بين اثنين فقال : ما بال هاذا ؟ قالوا : نذر أن يمشي قال فذكره . ( وهق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6802 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لم يبعث نبيا إلا حذر أمته الدجال ، وإني آخر الأنبياء ، وأنتم آخر الأمم ، وهو خارج فيكم لا محالة ، فإن يخرج وأنا بين ظهرانيكم فأنا حجيج كل مسلم ، وإن يخرج فيكم بعدي فكل امرىء حجيج نفسه ، والله خليفتي على كل مسلم ، إنه يخرج من خلة بين 
ms738	 العراق والشام عاث يمينا وعاث شمالا ، يا عباد الله اثبتوا فإنه يبدأ يقول : أنا نبي ولا نبي بعدي ، وإنه مكتوب بين عينيه كافر يقرؤه كل مؤمن ، فمن لقيه منكم فليتفل في وجهه وليقرأ بفواتح سورة أصحاب الكهف ، وإنه يسلط على نفس من بني آدم فيقتلها ثم يحييها ، وإنه لا يعدو ذالك ولا يسلط على نفس غيرها ، وإن من فتنته أن معه جنة ونارا ، فناره جنة وجنته نار ، فمن ابتلي بناره فليغمض عينيه وليستعن بالله تكون بردا وسلاما كما كانت النار بردا وسلاما على إبراهيم ، وإن أيامه أربعون يوما ، يوم كسنة ، ويوم كشهر ، ويوم كجمعة ، ويوم كالأيام ، وآخر أيامه كالسراب ، يصبح الرجل عند باب المدينة فيمسي قبل أن يبلغ بابها الآخر ، قالوا : وكيف نصلي يا رسول الله في تلك الأيام القصار ؟ قال : تقدرون فيها كما تقدرون في الأيام الطوال ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6803 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لم يخلق بيده إلا ثلاثة أشياء وقال لسائر الأسياء كن فكان ، خلق الله القلم وآدم والفردوس بيده وقال ها : وعزتي وجلالي لا يجاورني فيك بخيل ، ولا يشم ريجك ديوث ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6804 ) قال النبي :(@)(@@) | 30 ( إن الله لم يفترض شيئا أفضل من التوحيد والصلاة ، ولو كان شيء أفضل منه لافترضه على ملائكته ، منهم راكع ومنهم ساجد ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@) PageV02P490(@)(@@)(@@)(@@) $ ( 6805 ) قال النبي :(@)(@@) | 30 ( إن الله لم يكتببعلى الليل صياما ، فمن صام فليتعن ولا أجر له ) )(@)(@@) البغوي وابن قانع والشيرازي في الألقاب عن أبي سعيد الخير الأنماري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6806 ) قال النبي :(@)(@@) | 30 ( إن الله لم يبعث نبيا إلا وله حواريون فيمكث بين أظهرهم ما شاء الله أن يعمل فيهم بكتاب الله وسنة نبيه ، فإذا انقرضوا كان من بعدهم أمراء يركبون رؤوس المنابر يقولون ما تعرفون ويعملون ما تنكرون ، فإذا رأيتم أولائك فحق على كل مؤمن أن يجاهدهم بيده ، فإن لم يستطع فبلسانه ، فإن لم يستطع بلسانه فبقلبه ، ليس وراء 
ms739	 ذالك إسلام ) )(@)(@@) ابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6807 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لم يبعث نبيا قبلي إلا كان في أمته من بعده مرجئة وقدرية يشوشون عليه أمر أمته من بعده ، ألا إن الله عز وجل قد لعن المرجئة والقدرية على لسان سبعين نبيا ، ألا وإن أمتي هاذه لأمة مرحومة لا عذاب عليها في الآخرة ، وإنما عذابها في الدنيا ، إلا صنفين من أمتي لا يدخلون الجنة : المرجئة والقدرية ) )(@)(@@) ابن عساكر عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6808 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لم يلعن قوما قط فمسخهم ، فكان لهم نسل حين يهلكهم ولاكن هاذا خلق كان ، فلما غضب الله على اليهود مسخهم فجعلهم مثلهم ) )(@)(@@) ( حم طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6809 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لم يكل قسمها إلى ملك مقرب ولا نبي مرسل حتى جزأها على ثمانية أجزاء فإن كنت جزءا منها أعطيتك ، وإن كنت غنيا عنها فإنما هي صداع في الرأس وداء في البطن ) )(@)(@@) ابن سعد في الصغير رضي الله عنه .(@)(@@) PageV02P491(@)(@@)(@@)(@@) $ ( 6810 ) قال النبي :(@)(@@) | 30 ( إن الله لما خلق الدنيا أعرض عنها فلم ينظر إليها من هوانها عليه ) )(@)(@@) ابن عساكر عن أبي بكر الداهري عن جعفر بن محمد عن أبيه عن علي بن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 6811 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لما خلق الجنة وغرسها جعل غرسها سبحان الله والحمد لله ولا إلاه إلا الله والله أكبر ولا حول ولا قوة إلا بالله ، ثم قال لها : قد أفلح المؤمنون ، تكلمي يا جنتي ، قالت : أنت الله لا إلاه إلا أنت الحي القيوم قد سعد من دخلني ، قال الله عز وجل : بعزتي حلفت وعلوي على خلقي لا يدخلك مصر على الزنى ، ولا مدمن خمر ، ولا قتات ، وهو النمام ) )(@)(@@) الشيرازي في الألقاب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6812 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لما خلق الخلق كتب بيده على نفسه : إن رحمتي تغلب غضبي ) )(@)(@@) ( حم خ م ه ) عن 
ms740	 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6813 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لما ذرأ لجهنم من ذرأ كان ولد الزنى فيما ذرأ لجهنم ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6814 ) قال النبي :(@)(@@) | 30 ( إن الله لن يعجزني في أمتي أن يؤخرها نصف يوم خمسمائة عام ) )(@)(@@) ( د حل ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6815 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليأذن للرجل يكون حسن الصوت يتغنى بالقرآن ) )(@)(@@) ( عب ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6816 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليبغض البليغ الذي يتخلل بلسانه كما تتخلل الباقرة ) )(@)(@@) ( حم د ن ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6817 ) قال النبي :(@)(@@) | 30 ( إن الله ليصدق عبده إذا قال : لا إلاه إلا الله ، وإذا PageV02P492 قال : لا حول ولا قوة إلا بالله لم تمسه النار ) )(@)(@@) ( ك ) في تاريخه و إسماعيل بن عبد الغافر الفارسي في الأربعين والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6818 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليضحك إلى الرجل إذا مد يده بالصدقة ، ومن ضحك الله إليه غفر له ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6819 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليغضب فتسبح الملائكة لغضبه ، فإذا نظر إلى حملة القرآن تملأ رضي ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6820 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليغضب لفاطمة ويرضى لرضاها ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6821 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليغضب للسائل الصدوق كما يغضب لنفسه ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6822 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليقبل التوبة من عبده ما دام الروح في جسده ولم يبق من أجله إلا عشير فواق ، قيل لأبي هريرة : ما عشير فواق ؟ قال : طرف لمحة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6823 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليكره الرجل الرفيع الصوت ، ويحب الرجل الخفيض الصوت ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6824 ) قال النبي :(@)(@@) | 30 