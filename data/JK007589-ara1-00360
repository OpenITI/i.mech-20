ms341	 لسيد أمة % وأكلأ ذي عين لسرح مسودها % % 36(@)(@@) % كفى كل ما تكفي الكفاة ملوكها % % بنجح مساعيها ويمن جدودها % % 37(@)(@@) % فقد أخمد النيران بعد استعارها % % وقد أوقد الأنوار بعد خمودها % % 38(@)(@@) % ويكفيه إن خان الشهادة خائن % بما استشهدت آثاره من شهودها % % 39(@)(@@) % أتانا ودنيانا عجوز فأصبحت % به ناهدا في عنفوان نهودها % % 40(@)(@@) % فقد قيدت عنا المخاوف كلها % % وقد أطلقت آمالنا من قيودها % % PageV01P1254 41(@)(@@) % بذي شيم يصبيك حسن وجوهها % % ولين مثانيها وجدل قدودها % % 42(@)(@@) % حمانا وأرعانا حمى كل ثروة % وأبدلنا بيض الليالي بسودها % % 43(@)(@@) % فأضحى ولو تسطيع كل قبيلة % وقت نعله مس الثرى بخدودها % % 44(@)(@@) % تألف وحشي القلوب بلطفه % فأضحى معاديها له كودودها % % 45(@)(@@) % وفى وعفا عن كل صاحب هفوة % وكابد ما دون العلا من كؤودها % % 46(@)(@@) % بنفس أبت إلا ثبات عقودها % % لمن عاقدتهوانحلال حقودها % % 47(@)(@@) % ألا تلكم النفس التي تم فضلها % % فما نستزيد الله غير خلودها % % 48(@)(@@) % وإن عدت الأحساب يوما فإنما % % يعد من الأحساب رمل زرودها % % 49(@)(@@) % مفاخر عن آبائه وبنفسه % % نفوذ حصى الإحصاء قبل نفودها % % 50(@)(@@) % تدارك إسماعيل للعرب العلا % فعادت لإسماعيلها ولهودها % % PageV01P1255 51(@)(@@) % فتى من بني شيبان في مشمخرة % شديد على الراقي رقي صعودها % % 52(@)(@@) % نمته من العليا جبال صقورها % % وحفت جنابيه غياض أسودها % % 53(@)(@@) % فتى لعطاياه وفود تؤمها % % فإن قعدوا كانت وفود وفودها % % 54(@)(@@) % إذا بدء ما أعطى أنام عفاته % سرى عوده مستيقظا لرقودها % % 55(@)(@@) % ولما رحلت العيس نحو فنائه % % ضمنت عليه عتقها من قتودها % % 56(@)(@@) % أمنت على نعمائه ريب دهره % % ولم لا وذاك العرف بعض جنودها % % PageV01P1256 البحر : - 1(@)(@@) % ما كل أمر أضاع المرء فرصته % % في اليوم بالمتلافى في غداة غد % 2(@)(@@) % هل يخلف الحر وعدا خلفه خطر % % يخاف منه هلاك الروح والجسد % 3(@)(@@) % جاز المطال بأشياء ولم أره % يجوز بالغوثوالملهوففي كبد % 4(@)(@@) % لنمت عنيوبات الدهر في رصد % وليس يقرن ذو نوم بذي رصد % PageV01P1257 البحر : - 1(@)(@@) % حبيب أراني الله يوم فراقه % غويت وما أبصرت في حبه رشدي % % 2(@)(@@) % رققت له من قبحه المحض رقة % ألانت له قلبي 
ms342	 فقادت له ودي % % 3(@)(@@) % فتاه بوجه يطرف العين قبحه % له صورة كالشمس في الأعين الرمد % 4(@)(@@) % ولا عجب أن كان من كان مثله % تشبه بالمعشوق في التية والصد % 5(@)(@@) % إذا لم يكن قردا تماما حكاية % % وقبحا فلم تكمل له صورة القرد % PageV01P1258 البحر : - 1(@)(@@) % يا عجبا من خالد % في صبره وجلده % % 2(@)(@@) % قاتله الله فما % % أبعده من رشده % % 3(@)(@@) % يولج في زوجته % أير سواه بيده % 4(@)(@@) % يحلب تيسا مثله % % في قعب أم ولده % 5(@)(@@) % بكف سوءبتكت % ذراعها من عضده % 6(@)(@@) % يبركها في بيته % على حشايا مهده % 7(@)(@@) % يقبض بالخمس على % % أير غلام بيده % % 8(@)(@@) % وينتحي في عرسه % بعدة من عدده % % 9(@)(@@) % أير غلام أيره % % أعظم ما في جسده % 10(@)(@@) % يضرب بالحوق إذا % % أنعظ أعلى كبده % PageV01P1259 11(@)(@@) % يعمله في عرسه % ليلته إلى غده % 12(@)(@@) % ولو رأى ذا غيرة % في بيته أو بلده % 13(@)(@@) % أرعد أو تحسبه % ذا جنة من رعده % 14(@)(@@) % من ذا يضاهي خالدا % في حلمه وجلده % PageV01P1260 البحر : - 1(@)(@@) % كم بغور الشآم غادرت منهم % غائرا موفيا على أهل نجد % 2(@)(@@) % يلعب الدستبند فردا وإن كا % % ن له شاغل عن الدستبند % PageV01P1261 البحر : - 1(@)(@@) % بلوت طعوم الناس حتى لو أنني % % وجدتهم أحلى مذاقا من الشهد % 2(@)(@@) % لقد آن أن أسلاهم وأملهم % فكيف وما لاقيت منهم أخا رشد % 3(@)(@@) % وكيف وقد جربت من طبقاتهم % % تجاريب تدعو النفس فيهم إلى الزهد % PageV01P1262 البحر : - 1(@)(@@) % يابن الوزيرين سمعا من أخي طلب % بين الرجاء وبين اليأس مكدود % 2(@)(@@) % لا تبخلن على من لست كافيه % بأن تقولتزحزح غير مطرود % 3(@)(@@) % فإن خشيت هجائي فاخش حينئذ % من كل شيء محال الكون مفقود % 4(@)(@@) % واللهلا قلت فيكم ماأكيد به % % نفسي وكنت في سربال محسود % 5(@)(@@) % ولا أفضت بحرف في ملامكم % يا آل وهب طوال البيض والسود % 6(@)(@@) % إني لأعلم أني لا أفوتكم % على مطايا سليمان بن داود % 7(@)(@@) % ولو أمنتكم أمني يدي وفمي % % لما نشدتم وفائي غير موجود % 8(@)(@@) % لكم على منطقي سلطان مرتقب % أضحى يؤيده سلطان مودود % % 9(@)(@@) % فما وفائي 
ms343	 بمدخول لكم أبدا % لكنه كوفاء العرق للعود % 10(@)(@@) % سد السداد فمي عما يريبكم % لكن فم الحال مني غير مسدود % PageV01P1263 11(@)(@@) % وفي ضميري نصح لست أغمده % عنكموما نصح ذي نصح بمغمود % 12(@)(@@) % حالي تصيح بما أوليت معلنة % وكل ما تدعيه غير مردود % 13(@)(@@) % وقصتي معكم نار على علم % لا فطنة بطنت في قلب جلمود % 14(@)(@@) % فكيف يخفى وأخفي ما جرى لكم % علي من طول ظلم غير معدود % 15(@)(@@) % وألسن الناس شتى لست أملكها % % إذا رأوا محسنا في حال مصفود % 16(@)(@@) % من يبذل العذر في مثلي لمثلكم % أو يذخر النصح عن لهفان مجهود % 17(@)(@@) % بل من يرى فضل مسكين على ملك % فلا يقول مقالا غير محمود % 18(@)(@@) % كم آنف لكم من أن ترى مدحي % % منقودةوجداك غير منقود % 19(@)(@@) % كلي هجاءوقتلي لا يحل لكم % فما يداويكم مني سوى الجود % 20(@)(@@) % ورب ذم أتى من غير مجترم % ورب قذف جرى من غير محدود % PageV01P1264 21(@)(@@) % صدقتكموجواب الصدق يلزمكم % وما جواب أخي صدق بمردود % 22(@)(@@) % فأحسنوا بي كإحسان الإله بكم % مليتم حظ محقوق ومجدود % 23(@)(@@) % أجدوا جدا غير منكود لأشكره % % أو صرحوا لي بيأس غير منكود % 24(@)(@@) % وبينوا لي أمري إنني معكم % في سرمد من ظلام الشك ممدود % 25(@)(@@) % وما انصرافي عنكم إن حرمتكم % إلا انصراف شقي غير مسعود % 26(@)(@@) % مدفع حين يغشى الناس مجتنب % مخيب حين يبغي الخير محدود % 27(@)(@@) % ومن قبلتم فمقبول لكم أبدا % ومن أبيتم فبلو غير معهود % 28(@)(@@) % إن كان حيا أباه كل مضطرب % أو كان ميتا أباه كل ملحود % 29(@)(@@) % لكن في اليأس لي عفوا وعافية % % واليأس رفد لعاف غير مرفود % 30(@)(@@) % بل ليس في البأس خير أو يزينه % في عين طالب خير مطل موعود % PageV01P1265 31(@)(@@) % بل لا أغرك من خيمي ولا شيمي % % أني لجلد صبور غير مهدود % 32(@)(@@) % قل ماتشاء فإني منه معتصم % بمدمج من حبال العز ممسود % 33(@)(@@) % لا والذي قدمت عندي صنائعه % % لابت إلا على صبر ومجلود % 34(@)(@@) % ما أنت رزقي ولا عمري وعافيتي % % فاجهد بصرمكإني غير معمود 
ms344	 % 35(@)(@@) % من ردني غير مصفود فإن له % % عندي عفافا وعزما غير مصفود % 36(@)(@@) % في راحة اليأس لي من بغيتي عوض % وحسبي الله مدعى كل منجود % 37(@)(@@) % لن أرى اليأس نعيا حين يؤيسني % % من سيب كفك بل بشرى بمولود % 38(@)(@@) % ولست أول صاد صده قدر % فذيد عن ورد صافي الماء مورود % 39(@)(@@) % وقبل برك بي ما برني ملك % لا تملكون عليه حل معقود % 40(@)(@@) % مازال يضمن رزقي منذ أنشأني % % بفضله وهو حي غير مأمود % PageV01P1266 41(@)(@@) % هذا على أن سخطي لا يخلفني % % عن مشهد من مآل الخير مشهود % 42(@)(@@) % وما أحار على أني تحيرني % % أطباق ليل كثيف السد منضود % 43(@)(@@) % أشياء منك تحراني لتورطني % % والحزم يعدل بي عن كل أخدود % 44(@)(@@) % مشككات تعنيني وتتعبني % % ما زال دائي منها داء مفئود % 45(@)(@@) % منع ومنح وإصغار وتكرمة % وشد عقد وطورا نقض مشدود % 46(@)(@@) % فإنما أنا في لبس وذبذبة % وخوف جان بمر النقم مرصود % 47(@)(@@) % حتى كأني وما أسلفت سيئة % مطالب تحت حقد منك محقود % PageV01P1267 البحر : - 1(@)(@@) % يعان المستعين بك البعيد % وحظي من معونتك الزهيد % 2(@)(@@) % وما ذنبي إليك سوى جوار % قريب مثلما قرب الوريد % 3(@)(@@) % وود بين شيخينا قديم % % على الأيام معقده وكيد % 4(@)(@@) % وقربى نحلتي أدب ورأي % بأبعد منهما قرب البعيد % 5(@)(@@) % وأني لم يزل أملي قديما % عقيدك ما تقدمه عقيد % 6(@)(@@) % سبقت به إليك لدن كلانا % % وليد أو يضارعه الوليد % 7(@)(@@) % وكان القلب يؤنس منك رشدا % وليس بكاتم الرشد الرشيد % 8(@)(@@) % ويشهد أن ستسمو للمعالي % % فتبلغها فما كذب الشهيد % 9(@)(@@) % فمالك حاد عرف يديك عني % % وما للعرف عن مثلي محيد % 10(@)(@@) % ومالي لا أزال لديك أحبى % % حباءيجتوى منه المزيد % PageV01P1268 11(@)(@@) % دهاني من جفائك ما دهاني % % ولم يك للزمان به وعيد % 12(@)(@@) % عذرتك لو عرفتك خارجيا % طريف المجد ليس له تليد % 13(@)(@@) % فقلت رأى قديمي فيه نقض % فلست أحبه ما عاد عيد % 14(@)(@@) % فكيف ولست تعلمني عليما % بنقص في قديمك يا سعيد % 15(@)(@@) % ألست المرء والده حميد % وحسبك من سناء لا أزيد % 16 
ms345	(@)(@@) % ألست ابن الذين غنوا قديما % هم الأحرار والناس العبيد % 17(@)(@@) % أتحسبني زهاك الحظ عندي % % فحشو جوانحي حسد شديد % 18(@)(@@) % وما حسدي وشأنك غير شأني % % أيحسد صائدا ما لا يصيد % 19(@)(@@) % وكيف وما وقعت أمام ظني % % وكيف وما حظيت كما أريد % 20(@)(@@) % لئن أرضاك هذا الحظ حظا % فإني مستريث مستزيد % PageV01P1269 21(@)(@@) % ألم تر أن نعمى الله شنت % عليك فطالها شخص مديد % 22(@)(@@) % أفد ما شئت من جاه ومال % فأنت لدي تزهي ما تفيد % 23(@)(@@) % أيزهي شخص مثلك عند مثلي % % أبا عثمان سربال جديد % 24(@)(@@) % وليس ابن المقفع في نقير % لديك إذا عددت ولا يزيد % 25(@)(@@) % ولا كلثوم المجموع فيه % % إلى الخطب الرسائل والقصيد % 26(@)(@@) % ولا عبد الحميد وإن زهاه % % تقادم عهدهشهد الحميد % 27(@)(@@) % فكيف أراك تقصر عن منال % وأنت الفرد في الناس الوحيد % 28(@)(@@) % يراك بمثل تلك العين أعشى % % وحاشا من له بصر حديد % 29(@)(@@) % وبعدفقد ترى استغلاق أمري % % وطول حرانه ما يستقيد % % 30(@)(@@) % وعندك إن أردت النفع نفع % وعندي ضعفه شكر عتيد % PageV01P1270 31(@)(@@) % فهب لي محضرا يشفي ويكفي % % إذا أبدأت فيه لا تعيد % % 32(@)(@@) % تهز به الأمير فليس يغني % % عن الهز السريجي الرديد % 33(@)(@@) % أترضى أن حرمت وفاز غيري % % بآمال لها طلع نضيد % 34(@)(@@) % وأنت لكل مكرمة عماد % أجل ولكل ذي كرم عميد % PageV01P1271 البحر : - 1(@)(@@) % إن أسرق الشعراء شعرهم % فجزاء ماسرقوا من المجد % 2(@)(@@) % سرقوك مجدك وهو ومدخر % من قبل أن تلقى إلى المهد % 3(@)(@@) % وكسوه قوما لا يليق بهم % من ماجد وسط ومن وغد % 4(@)(@@) % فرددت حقك غير معتذر % منه إلى حر ولا عبد % PageV01P1272 البحر : - 1(@)(@@) % م يمن الله طلعة المولودص وحبا أهله بطول السعود % % فهم الضامنون حين توالى % % 2(@)(@@) % منسيات العهود حفظ العهود % % والألى إن رعوا حلوبة مجد % 3(@)(@@) % لأولي الأمر لم تكن بجدود % % فليقل قائل لذي الصدر المي % 4(@)(@@) % مون منهم في أمره والورود % % أمتع الله ذو المواهب بالمو % 5(@)(@@) % هوب غير المخسس المنكود % بدر طلق وشمس دجن من الأم % % 6(@)(@@) % لاك جاءا بكوكب مسعود % وافد زار 
ms346	 مستماحي وفود % % 7(@)(@@) % ومرتجى منه مستماح وفود % سله الله للخطوب من الغي % % 8(@)(@@) % ب كسل المهند المغمود % فيه عرف وفيه نكر معدا % % 9(@)(@@) % ن لأهل النهى وأهل المرود % وكمين الحريق في العود مخفى % 10(@)(@@) % وحقين الرحيق في العنقود % نجلته بيضاء من ملكات الر % PageV01P1273 11(@)(@@) % وم تدعى لقيصر معبود % ليلة الأربعاء وهو من الأي % 12(@)(@@) % ام يوم ما شئت من محمود % مأنحسا على ثمود وعاد % 13(@)(@@) % وسعودا لصالح ولهود % فالذي فيه إن نظرنا من الشر % 14(@)(@@) % لعاد بكفرها وثمود % ولنا خيره وذروة منجا % % 15(@)(@@) % ه لأنا أضداد أهل العنود % وهو يوم المظفرين بني العب % 16(@)(@@) % اس سقيا لظله الممدود % يوم صدق بنت يد الله فيه % % 17(@)(@@) % ملكهم فوق رأسه الموطود % وطلوع المولود فيه بشير % 18(@)(@@) % بسرور لأهله مولود % عاقد أمرهم بأمر بني العب % 19(@)(@@) % اس عقدا من محكمات العقود % مفصح فأله يخبر عن أز % 20(@)(@@) % ر بأزر من شكله مشدود % آل وهب فوزا لكم بسليما % % PageV01P1274 21(@)(@@) % ن وكبتا للحاسد المفئود % قد بدا في فراسة الفارس الطا % % 22(@)(@@) % لع يمن دعواه ذات شهود % وكذا أنتم لكم أمرات % 23(@)(@@) % يتكلمن عنكم في المهود % طلعت منه غرة كسنا الفج % 24(@)(@@) % روسيما كالمخلص المنقود % ثم سماه باسمه سيد السا % % 25(@)(@@) % دات غير المدافع المجحود % وقضى الله أن يكون سميا % 26(@)(@@) % وكنيا لجده المجدود % لسليمانوهو في آل وهب % 27(@)(@@) % كسليمان في بني داود % وقع أسم من السلامة والسل % 28(@)(@@) % م عليه وقوع لا مقصود % بل حدته إليه حادية الح % % 29(@)(@@) % ظ حداء أبن قفرة بقعود % يا لك أبنا ووالدين وجدي % 30(@)(@@) % ن يرون الجبال في أخدود % لحقوا بالكواكب الزهروالعي % PageV01P1275 31(@)(@@) % يوق نائي المنال من هبود % خير جرثومة وأنضر فرع % 32(@)(@@) % بين هذي وذاك أنجب عود % ذلك العود قاسم كرم العو % % 33(@)(@@) % د ومرسى العروق غير الصلود % فهو يهتز فوق منصبه المم % 34(@)(@@) % هد في ظل فرعه اليمئود % ولهذا المولود تال من الحر % 35(@)(@@) % ةإن الركوع فحوى السجود % وكأن قد أتى الحسين بشيرا % 36(@)(@@) % باتصال الفتوح بعد 
