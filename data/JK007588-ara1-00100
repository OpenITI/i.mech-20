ms81	 تحمله ثبير % دعا ويلا وأتبعها ثبورا % % 29(@)(@@) % يذكرني سديد الملك وجدا % وكنت لمثله أبدا ذكورا % % 30(@)(@@) % فما أطفأت من نار لهيبا % إلى أن عدت تذكيها سعيرا % % PageV01P268 31(@)(@@) % وما طال المدى فيسوغ عذر % بأن يكبو الجواد وأن يخورا % % 32(@)(@@) % قصرت مداه حتى كاد يوما % به أن يسبق الناعي البشيرا % % 33(@)(@@) % ولم يكس الفتى كمدا طويلا % كمفقود نضى عمرا قصيرا % % 34(@)(@@) % ولم أجد الكبير الرزء إلا % سليل علا فجعت به صغيرا % % 35(@)(@@) % على أن الكرام تعد ليثا % هصورا منهم الرشأ الغريرا % % 36(@)(@@) % ترى أيامهم أعوام قوم % وساعات الفتى منهم شهورا % % 37(@)(@@) % فلا يبعد حبيب بان عنا % % وإن كان البعاد به جديرا % % 38(@)(@@) % وكيف دنو من طوت الليالي % % كما تطوي على الظن الضميرا % % 39(@)(@@) % فيا راميه عن قوس المنايا % % أصبت بواحد عددا كثيرا % % 40(@)(@@) % ويا راجيه يجعله ظهيرا % نبا بك حادث قطع الظهورا % % PageV01P269 41(@)(@@) % ويا حاثي التراب عليه مهلا % كسفت بهاءه ذاك البهيرا % % 42(@)(@@) % فلو أني استطعت حملت عنه % ثقيل الترب والخطب الكبيرا % % 43(@)(@@) % أصون جماله وأجل منه % جبين البدر أن يمسي عفيرا % % 44(@)(@@) % بنفسي نازح بالغيب دان % يجاور معشرا حضورا % % 45(@)(@@) % أقام بحيث لا يهوى مقاما % ولا يبغي إلى جهة مسيرا % % 46(@)(@@) % ولا هجرا يود ولا وصالا % ولا بردا يحس ولا هجيرا % % 47(@)(@@) % أقول سقى محلته غمام % يمر بها مرارا لا مرورا % % 48(@)(@@) % وروض ساحتيه كأن وشيا % يحل بها وديباجا نشيرا % % 49(@)(@@) % إذا خطر النسيم عليه أهدى % % إلى زواره أرجا عطيرا % % 50(@)(@@) % وما أربي له في ماء مزن % وقد ودعت منه حيا مطيرا % % PageV01P270 51(@)(@@) % ولولا عادة السقيا بغيث % إذا لسقيته الدر النثيرا % % 52(@)(@@) % وقل لقدره مني وقلت % له زهر الكواكب أن تغورا % % 53(@)(@@) % أحن إلى الصعيد كأن فيه % شفاي إذا مررت به حسيرا % % 54(@)(@@) % وأستاف الثرى مذ حل فيه % وألصقه الترائب والنحورا % % 55(@)(@@) % ولولا قبره ما كنت يوما % لألثمه وأعتنق القبورا % % 56(@)(@@) % عليك بأدمع آلين ألا % يغضن ولو أفضن دما غزيرا % % 57(@)(@@) % يزرنك مسعدات منجدات % رواحا بالتفجع أو بكورا % % 58(@)(@@) % فأولى من 
ms82	 يقاسمك الأسى في % % خطوبك من تقاسمه السرورا % % 59(@)(@@) % ولا تعلق بصبر بعد بدر % ذممنا الصبر عنه والصبورا % % 60(@)(@@) % وإن قالوا استرد الدهر منه % معارا كيف تمنعه المعيرا % % PageV01P271 61(@)(@@) % فلم أعطاكه نجما خفيا % وعاد لأخذه قمرا منيرا % % 62(@)(@@) % أبا الذواد ما كبد أذيبت % بشافية ولا قلب أطيرا % % 63(@)(@@) % فهل لك أن تراقب فيه يوما % يوفى الصابرون به الأجورا % % 64(@)(@@) % ولولا أن أخاف الله من أن % يراني بعد إيمان كفورا % % 65(@)(@@) % لما عزيت قلبك عن حبيب % وكنت بأن أحرقه بصيرا % % 66(@)(@@) % ولم نعهدك في سراء حال % ولا ضرائها إلا شكورا % % 67(@)(@@) % فصبرا للملم وإن أصبنا % % جناح الصبر منهاضا كسيرا % % 68(@)(@@) % ألم تعلم وكان أبوك ممن % إذا خطب العلى أغلى المهورا % % 69(@)(@@) % بأنكم أطب بكل أمر % إذا ما ضيع الناس الأمورا % % 70(@)(@@) % وأي الخطب ينقص من علاكم % وأي النزف ينتزح البحورا % % PageV01P272 71(@)(@@) % وأي عواصف الأرواح يوما % تهب فتفلق الطود الوقورا % % 72(@)(@@) % وإنك شائد وأخوك مجدا % سيخلد ذكره حسنا أثيرا % % 73(@)(@@) % إذا وقيتما من كل خطب % فما نبغي على زمن ظهيرا % % 74(@)(@@) % وما القمران إذ سعدا وتما % % بأبهر منكما في الفضل نورا % % 75(@)(@@) % أراني لا أسوم الصبر قلبي % % فأدركه يسيرا أو عسيرا % % 76(@)(@@) % كأني مبتغ لكما شبيها % به أو مدع لكما نظيرا % % 77(@)(@@) % فلا أخلى الزمان لكم محلا % ولا عدمت سماؤكم البدورا % % PageV01P273 البحر : كامل تام 1(@)(@@) % مهلا بني الصوفي إنكم % ليعد دون حصاتكم جبلي % % 2(@)(@@) % لو تصفون صفاء نعمتكم % ما احتاج بحركم إلى وشلي % % 3(@)(@@) % لا يشهرن علي سيفكم % سيفا به في الحق لم يصل % 4(@)(@@) % إن الكريم المحض سؤدده % من لم تضق بوفائه حيلي % % 5(@)(@@) % والماجد المرجو نائله % من لم يخب في وده أملي % % 6(@)(@@) % بئس الجزاء جزيتم رجلا % لم يخف موضعه على رجل % 7(@)(@@) % دبت عقاربكم إلي وقد % تهوي إلى أقدامكم قبلي % % PageV01P274 البحر : خفيف تام 1(@)(@@) % كم سما لي بحسن رأيك جد % وصفا لي بفيض كفك ورد % 2(@)(@@) % وتوالت علي منك أياد % كتولي الحيا يروح ويغدو % % 3(@)(@@) % فاجئات فليس يعدم بذل % من 
ms83	 نداها وليس يوجد وعد % 4(@)(@@) % ثقة الملك ليس في الحكم جور % منك يوما وليس في الجود قصد % 5(@)(@@) % رب بر في إثره منك بر % بعد رفد في طيه منك رفد % 6(@)(@@) % كل يوم جود أتي ومعرو % % ف فتي ونائل مستجد % 7(@)(@@) % كل أيام حبك الجود وصل % مستر والحب وصل وصد % 8(@)(@@) % كرم لا أبيت إلا ولي من % ه على ما اقترحت زاد معد % 9(@)(@@) % أعجز الحمد والثناء فلم ين % % هض ثناء به ولا قام حمد % 10(@)(@@) % ومن العجز أن شكري نسيء % كل وقت وأن برك نقد % PageV01P275 11(@)(@@) % أين عذري إذا استزدتك جودا % لم يدع خلة لدي تسد % 12(@)(@@) % غير أني أدعو نداك إلى يو % م به زاد في عبيدك عبد % 13(@)(@@) % ولعمري ما كان يخرج نجل % عن قبيل أبوه فيهم يعد % 14(@)(@@) % ولأنت الأولى بعبدك مني % % كل مطولى بعبده مستبد % PageV01P276 البحر : كامل تام 1(@)(@@) % لو كنت شاهد عبرتي يوم النقا % % لمنعت قلبك بعدها أن يعشقا % % 2(@)(@@) % ولكنت أول نازع من خطتي % % يده ولو كنت المحب المشفقا % % 3(@)(@@) % وعذرت في أن لا اطيق تجلدا % وعجبت من أن لا أذوب تحرقا % % 4(@)(@@) % ناشدت حادي نوقهم في مدنف % أبكى الحداة بكاؤه والأينقا % % 5(@)(@@) % ومنحتهم جفنا إذا نهنهته % رقأت جفون الثاكلات وما رقا % % 6(@)(@@) % يا عمرو أي عظيم خطب لم يكن % خطب الفراق أشد منه وأوبقا % % 7(@)(@@) % كلني إلى عنف الصدود فربما % % كان الصدود من النوى بي أرفقا % % 8(@)(@@) % قد سال حتى قد أسال سواده % طرفي فخالط دمعه المترقرقا % % 9(@)(@@) % واستبق للأطلال فضلة أدمع % أفنيتهن قطيعة وتفرقا % % 10(@)(@@) % أو فاستمح لي من خلي سلوة % إن كان ذو الإثراء يسعف مملقا % % PageV01P277 11(@)(@@) % إن الظباء غداة رامة لم تدع % إلا حشى قلقا وقلبا شيقا % % 12(@)(@@) % سنحت فما منحت وكم من عارض % قد مر مجتازا عليك وما سقا % % 13(@)(@@) % غيد نصبت لصيدهن حبائلا % % يعلقنهن فكنت فيها أعلقا % % 14(@)(@@) % ولكم نهيت الليث أغلب باسلا % عن أن يرود الظبي أتلع أرشقا % % 15(@)(@@) % فإذا القضاء على المضاء مركب % وإذا الشقاء 
ms84	 موكل بأخي الشقا % % 16(@)(@@) % ولقد سريت إذا السماء تخالها % % بردا براكدة النجوم مشبرقا % % 17(@)(@@) % والليل مثل السيل لولا لجة % تغشى الربى بأعم منه وأعمقا % % 18(@)(@@) % ومشمرين تدرعوا ثوب الدجى % % فأجد لبسهم الزماع وأخلقا % % 19(@)(@@) % عاطيتهم كأس السرى في ليلة % أمن الظلام بفجرها أن يشرقا % % 20(@)(@@) % حتى إذا حسر الصباح كأنه % وجه الوجيه تبلجا وتألقا % % PageV01P278 21(@)(@@) % حطوا رحال العيس منه بخير من % هزوا إليه رقابها والأسؤقا % % 22(@)(@@) % بأغر يجلو للوفود جبينه % شمسا تكون لها المعالي مشرقا % % 23(@)(@@) % نزلوا فما وصلوه مهجورا ولا % % فتحوا إلى نعماه بابا مغلقا % % 24(@)(@@) % إن زرته فتوق فيض بنانه % إن البحار ملية إن تغرقا % % 25(@)(@@) % وإذا أبو الذواد حاطك ذائدا % فقد أخذت من الليالي موثقا % % 26(@)(@@) % يشتد ممنوعا ويكرم قادرا % ويطول محقوقا ويصفح محنقا % 27(@)(@@) % لو أن من يروي حديث سماحه % يرويه عن صوب الحيا ما صدقا % % 28(@)(@@) % صحب الزمان وكان يبسا ذاويا % فسقاه بالمعروف حتى أورقا % % 29(@)(@@) % لا تذكرن له المكارم والعلى % % فتهيج صبا أو تشوق مشوقا % % 30(@)(@@) % عشق المحامد وهي عاشقة له % وكذاك ما برح الجمال معشقا % % PageV01P279 31(@)(@@) % يجري على سنن المكارم فعله % خلقا إذا كان الفعال تخلقا % % 32(@)(@@) % لا يمنح الإحسان إلا شاملا % خير الحيا ما عم منه وطبقا % % 33(@)(@@) % كتم الصنائع فاستشاع ثناؤها % % من ذا يصد الصبح عن أن يشرقا % % 34(@)(@@) % قد حالف العزم الحميد فلم يخف % خطبا يحاول فتقه أن يرتقا % % 35(@)(@@) % ورمى إلى الغرض البعيد فلم يبت % أبدا بغير المكرمات مؤرقا % % 36(@)(@@) % سامي المرام شريفه إن تدعه % لا تدعه للخطب إلا مقلقا % % 37(@)(@@) % إن جاد في بشر توهم عارضا % أو حل في نفر تراءوا فيلقا % % 38(@)(@@) % تلقاه في هيجاء كل ملمة % بطلا إذا شهد الكريهة حققا % % 39(@)(@@) % كالمشرفي العضب إلا أنه % أمضى شبا منه وأبهر رونقا % % 40(@)(@@) % جارى عنان الفضل في أمد العلى % % أدنى وأقرب شأوه أن يسبقا % % PageV01P280 41(@)(@@) % لا يدرك الجارون غاية مجده % من يستطيع إلى السماء تسلقا % % 42(@)(@@) % هيهات يمنع ذاك حق أخلق % لا يحسن العيوق فيه تحلقا % % 43 
ms85	(@)(@@) % ومن التأخر أن يقدم واطىء % قدما على دحض أزل وأزلقا % % 44(@)(@@) % ما كل منقبة يحاول نيلها % % تحوى ولا كل المنازل ترتقا % % 45(@)(@@) % يا سيد الرؤساء أي مطاول % أن يستطيع بك اللحاق فيلحقا % % 46(@)(@@) % ماذا يحاوله المغامر بعدما % % وجد المجال إلى قراعك ضيقا % % 47(@)(@@) % إن الرياسة لا تليق بغير من % مذ كان كان بثديها متمطقا % % 48(@)(@@) % بغنائها متكفلا وبفضلها % % متوحدا وبملكها متحققا % % 49(@)(@@) % كم فيك مجتمعا من الحسنات ما % % يعيي ويعجز في الورى متفرقا % % 50(@)(@@) % ولبيتك الفخر الذي لو أنه % سامى السماك لكان منه أسمقا % % PageV01P281 51(@)(@@) % من كان يفخر أنه من أسرة % كرمت ويضرب في الكرام معرقا % % 52(@)(@@) % فليأتنا بأب كمثل أبيك في ال % % علياء أو جد كجدك في التقا % % 53(@)(@@) % أما دمشق فقد حوت بك عزة % كرمت بها عن أن تكون الأبلقا % % 54(@)(@@) % حصنتها بسداد رأيك ضاربا % سورا عليها من علاك وخندقا % % 55(@)(@@) % وحميت حوزتها بهمة أوحد % ما زال ميمون الفعال موفقا % % 56(@)(@@) % أمطرتها من فيض عدلك أنعما % لا تعدم الرواد روضا مونقا % % 57(@)(@@) % إن أظلمت كنت الضحاء المجتلى % % أو أجدبت كنت الربيع المغدقا % % 58(@)(@@) % وأنا الذي أضحى أسير عوارف % لك لا يود أسيرها أن يطلقا % % 59(@)(@@) % أوفى وأشرف ما يؤمل آمل % أن لا يرى من رق جودك معتقا % % 60(@)(@@) % أجممت جودك ف ستفاض سماحة % وإذا حبست السيل زاد تدفقا % % PageV01P282 61(@)(@@) % وحميت آمالي سواك وعاطل % من كان من من اللئام مطوقا % % 62(@)(@@) % لم يبق سيب نداك موضع نائل % فهق الغدير وحقه أن يفهقا % % 63(@)(@@) % ولئن مننت فواجب لك في الندى % % إما نزعت بسهمه أن يغرقا % % 64(@)(@@) % أثني عليك بحق حمدك صادقا % حسب المعالي أن تقول فتصدقا % % 65(@)(@@) % ولكم يد لك لا يؤدى حقها % % ما خب ركب بالفجاج وأعنقا % % 66(@)(@@) % أعيت ثناي وأوجبت شكري لسا % % لفها فأفحمني نداك وأنطقا % % 67(@)(@@) % خذها كما حياك نور خميلة % خطر النسيم به ضحى فتفتقا % % 68(@)(@@) % تأبى على الكتمان غير تضوع % من ذا يصد المسك عن أن يعبقا % % 69(@)(@@) % عذراء لا تجلو الثناء عليك إط % راء 
ms86	 ولا تصف الولاء تملقا % % 70(@)(@@) % تحيي حبيبا والوليد وتجتبي % % لخلود فخرك أخطلا وفرزدقا % % PageV01P283 71(@)(@@) % وكأن تغريد الغريض مرجعا % فيها وعاني الرحيق معتقا % % 72(@)(@@) % وكأن أيام الصبابة رقة % فيها ومفترق النوى والملتقا % % 73(@)(@@) % وقد استشاد لك الثناء فما ترى % % إلا بليغا بامتداحك مفلقا % % 74(@)(@@) % فمتى تغنى الركب يوما أو حدا % % لم يعد مدحك مشئما أو معرقا % % 75(@)(@@) % والدر يشرف قيمة ويزيده % شرفا إذا ما كان درا منتقا % % 76(@)(@@) % من بات يسأل ربه أمنية % فالله أسأل أن يطيل لك البقا % % PageV01P284 البحر : متقارب تام 1(@)(@@) % أطاعك فيما تروم القدر % وأسفر عما تحب السفر % 2(@)(@@) % وأسعدك الله بالورد منه % وأحمد باليمن منك الصدر % 3(@)(@@) % يزيد مسيرك ذا عزة % كما ازداد ب لسير نور القمر % 4(@)(@@) % دعاك الهمام لنيل المرام % فكنت الحسام الحميد الأثر % 5(@)(@@) % رأى ثقة الملك عونا له % فبات على ثقة بالظفر % 6(@)(@@) % ولم يدع ذو خطر للملم % من الأمر إلا العظيم الخطر % 7(@)(@@) % بقاؤك أشرف ما يرتجى % % وأوبك أبهج ما ينتظر % PageV01P285 البحر : متقارب تام 1(@)(@@) % وما الشهر والدهر إلا بأن بقاؤك أوفى اقتراح الأماني % % وعزك أشرف حظ التهاني % % 2(@)(@@) % وحمدك أفضل نطق اللبيب % ومدحك أصدق سحر البيان % 3(@)(@@) % وما الشهر والدهر إلا بأن % تفوز بسعدهما يسعدان % 4(@)(@@) % بمجدك يا ثالث النيرين % وثاني الحيا يفخر النيران % 5(@)(@@) % فلا تجهلنك زهر النجوم % فإنك منها على البعد دان % 6(@)(@@) % فيا سيد الرؤساء الذي % % ن سادوا وسيد أهل الزمان % 7(@)(@@) % ويا خير من ولد المنجبون % وأكرمهم شائدا بعد بان % 8(@)(@@) % دعاني نداك فكم نعمة % تقلبت في ظلها مذ دعاني % % 9(@)(@@) % إذا ما سألت أفاد الغنى % % وإن لم أسل جادني وابتداني % % 10(@)(@@) % وإن أنا أغببته زائرا % تعهدني تائقا واقتضاني % % PageV01P286 11(@)(@@) % مواهب تنتج قبل المخا % % ض جودا وتثمر قبل الأوان % 12(@)(@@) % فمالي تطاولني حاجة % عناني من شأنها ما عناني % % 13(@)(@@) % وكيف يحلئني من شفى % % أوامي ويهملني من رعاني % % 14(@)(@@) % وكم بات يخذلني من أعا % % ن فضلي ويسلمني من حماني % % 15(@)(@@) % وما كنت آمل أني لدي % % ك ألجا إلى 
ms87	 غفلة أو توان % 16(@)(@@) % ولو شئت إذ رابني ما يريب % هززتك هز الحسام اليماني % % 17(@)(@@) % أدل عليك وأشكو إلي % ك نبوة حظ شديد الحران % 18(@)(@@) % ويطمعني فيك أن الثنا % % ء ما زال منك مكين المكان % 19(@)(@@) % بقيت لإحسانك المرتجى % % بقاء المدائح فيك الحسان % 20(@)(@@) % وعشت لراجيك في النائبا % % ت فلا لعاد وفكا لعان % PageV01P287 21(@)(@@) % فكم لك من نعمة ضخمة % لدي ومن بغير امتنان % 22(@)(@@) % أراك أمانا من الحادثات % فلا زلت من صرفها في أمان % 23(@)(@@) % وشد لك الأزر رب حباك % بنجلين نسل الأغر الهجان % 24(@)(@@) % إلى أن ترى قمرا طالعا % على الخلق يحجمه الفرقدان % PageV01P288 البحر : وافر تام 1(@)(@@) % ألم أك للقوافي الغر خدنا % وقرنا لن يرام ولن يرازا % % 2(@)(@@) % أبيت أروضها طورا وطورا % أذللها صعابا أو عزازا % % 3(@)(@@) % تكاد تئن من ألم إذا ما % % ثقاف الفكر عاصرها لزازا % % 4(@)(@@) % ألست إلى الندى أنمى اعتزاء % ألم أك بالندى أحمى اعتزازا % % 5(@)(@@) % ألم تثمر يد المعروف عندي % % وقد طابت غراسا أو غرازا % % 6(@)(@@) % فكيف يجوز أن أعدوا صنيعا % عدا حد السماح به وجازا % % 7(@)(@@) % وكم من جاهد قد رام عفوي % % فما بلغت حقيقته المجازا % % 8(@)(@@) % يروم بعجزه الإعجاز جهلا % وكيف يصيد بالكروان بازا % % 9(@)(@@) % سأبسط في الثناء لسان صدق % يطول به ارتجالا وارتجازا % % 10(@)(@@) % يعب عبابه بحرا خضما % ويبتك حده عضبا جرازا % % PageV01P289 11(@)(@@) % لعلي أن يفوز بسعد مدحي % % فتى سعد الزمان به وفازا % % 12(@)(@@) % فأجزي سيد الرساء نعمى % % له عندي وجلت أن تجازا % % 13(@)(@@) % ومن لي أن أقوم لها بشكر % وأن أغري بما أعد النجازا % % 14(@)(@@) % عنتني لا الثناء لها مطيقا % ولا كفرانها لي مستجازا % % 15(@)(@@) % رأى بيني وبين الدهر حربا % أكابدها نزالا أو برازا % % 16(@)(@@) % تتوق إلى الغمود البيض فيها % % وتشتاق الرماح بها الركازا % % 17(@)(@@) % فأصلت من مكارمه حساما % يجب غوارب النوب حتزازا % % 18(@)(@@) % حمى وهمى فعذت ولذت منه % بأكرم من أجار ومن أجازا % % 19(@)(@@) % وإني مذ تحدتني الليالي % % لمنحاز إلى الكرم انحيازا % % 20(@)(@@) % إلى متوحد بالحمد فات ال % % كرام به 
ms88	 اختصاصا وامتيازا % % PageV01P290 21(@)(@@) % أعمهم إذا كرموا سماحا % وأثقلهم إذا حلموا مرازا % % 22(@)(@@) % علي أن يطاول أو يسامى % % أبي أن يماثل أو يوازا % % 23(@)(@@) % أقل الناس بالمال احتفالا % وأكثرهم على المجد احترازا % % 24(@)(@@) % تهون طريق سائله إليه % وإن عز احتجابا واحتجازا % % 25(@)(@@) % فتى لم يستكن للدهر يوما % ولم تضق الخطوب به التزازا % % 26(@)(@@) % ولم يك جوده فلتات غر % أبادر فرصة منها انتهازا % % 27(@)(@@) % صليب حين تعجمه الليالي % % وغير النبع ينغمز انغمازا % % 28(@)(@@) % يغالبها اقتدارا واقتسارا % ويسلبها ابتذالا وابتزازا % % 29(@)(@@) % على تقذي العيون من الأعادي % % وتنبت في قلوبهم الحزازا % % 30(@)(@@) % أبا الذواد كم لي من مقام % لديك وكم أفاد وكم أفازا % % PageV01P291 31(@)(@@) % أغير على نداك وكان حقا % % لجودك أن يغاور أو يغازا % % 32(@)(@@) % وما لسوام وفرك منك حام % فيأمن سرحه مني اختزازا % % 33(@)(@@) % عممت الشام صوب حيا فلما % % تروى الشام ناهضت الحجازا % % 34(@)(@@) % أتيح له وقيض منك غيث % حوى خصب الزمان به وحازا % % 35(@)(@@) % فأمطره الندى لا ماء مزن % وأنبته الغنى لا الخازبازا % % 36(@)(@@) % سقى بطحاء مكة فالمصلى % % وروض سهل طيبة والعزازا % % 37(@)(@@) % وكنت إذا وطئت تراب أرض % ربا بنداك واهتز اهتزازا % % 38(@)(@@) % إذا لم تروها ألأنواء قصدا % كفاها أن تمر بها اجتيازا % % 39(@)(@@) % رأى الحجاج يوم حججت بدرا % وبحرا لن يغام ولن يجازا % % 40(@)(@@) % سقوا ورعوا بجودك لا ستقاء % أيا جم السماح ولا احتيازا % % PageV01P292 41(@)(@@) % أجزتهم المخافة لم يرابوا % % بها ريبا ومثلك من أجازا % % 42(@)(@@) % وأرهب ما يكون السيف حدا % إذا ما فارق السيف الجهازا % % 43(@)(@@) % وكم لك حجة لم تدع فيها % % إلى الوخد لمضبرة الكنازا % % 44(@)(@@) % صنائع كم رفعت بها منارا % لفخر واتخذت بها مفازا % % 45(@)(@@) % وما جاراك في فضل فخار % فلم تجتز مدى الفضل اجتيازا % % 46(@)(@@) % ولا ساماك في علياء إلا % وفزت بها انفرادا وانفرازا % % 47(@)(@@) % لبست من الفضائل ثوب فخر % ولكن كنت أنت له الطرازا % % PageV01P293 البحر : خفيف تام 1(@)(@@) % أنت للمسلمين حصن وحرز % ولراجي نداك ذخر وكنز % 2(@)(@@) % أبدا ما تزال عطفا عليهم % ودفاعا عنهم تحج وتغزو % % 3 
ms89	(@)(@@) % أصبحت هذه الرعية من عد % لك في ظل نعمة لا تبز % 4(@)(@@) % سكنت معقلا من الأمن لا تز % عج يوما به ولا تستفز % 5(@)(@@) % ما لها من مزيل خطب ولا كا % % شف كرب سواك حين تلز % 6(@)(@@) % فهي من بعد حمدها الله لا يس % مع منها بغير حمدك رز % 7(@)(@@) % لا ترى إن دعت إلى الله أولى % % من دعاء تبقى به وتعز % 8(@)(@@) % ومع الرأفة التي ألفت من % ك ففي اللين شدة ومهز % 9(@)(@@) % رضتها لم تجر مقيما لميل % ربما صدع المثقف غمز % 10(@)(@@) % كيف يبطي عنك الثناء وقد أس % رع جود يحدوه حث وحفز % PageV01P294 11(@)(@@) % غرق السائلين والنجد غور % وحمى العائذين والوهد نشز % 12(@)(@@) % لا كجود يعيي ويعنف إدلا % % ء إلى جفره العميق ونهز % 13(@)(@@) % ما رأيناك نابيا عن مرام % مذ هززناك والحسام يهز % 14(@)(@@) % لا ولا غيرتك عن طيب أعرا % % قك هذي الخطوب والبز بز % 15(@)(@@) % فمن المرتجى للهفة حر % بات في صدره من الهم وخز % 16(@)(@@) % يتحامى الشكوى إذا أعلن النج % وى وحسب الكريم لمح ورمز % 17(@)(@@) % قد نحت عظمي الخطوب ففيه % بين جلدي والنحض حز وجز % 18(@)(@@) % كيف يغضي على النوائب مغض % ولأنيابهن نهش ونكز % 19(@)(@@) % في زمان به الرئيس وجيه ال % % دولة الأوحد الأجل الأعز % 20(@)(@@) % الذي بيننا وبين الليالي % % أبدا من نداه حسم وحجز % PageV01P295 21(@)(@@) % يا هماما ما شانه قط لؤم % يا غماما ما شابه قط رجز % 22(@)(@@) % أنت أحميت مشربي وهو مطرو % % ق وأغزرت مطلبي وهو نز % 23(@)(@@) % أنت أنهضتني وقد خرق الخط % ب فلم يغن فيه ركل وهمز % 24(@)(@@) % أنت ألبستني ملابس نعمى % % خشن عندهن خز وقز % 25(@)(@@) % قد هجرت الورى إليك ولم أظ % لم ومدحي سواك للمدح وهز % 26(@)(@@) % لا تقل الركاب رحلي ولا يح % مل رجلي إلا لقصدك غرز % 27(@)(@@) % مشيها القهقرى إليهم وإن أم % تك يوما فالمشي وثب وجمز % 28(@)(@@) % وإذا البحر عن لي وهو طام % فقعودي مع الصدى عنه عجز % 29(@)(@@) % ليس أيامك المنيرة للأي % % ام إلا حلى 
ms90	 تزين وطرز % 30(@)(@@) % أنت أعلى من كل ما ينسب النا % % سب من سؤدد إليك ويعزو % % PageV01P296 البحر : وافر تام 1(@)(@@) % أمين الملك حسبك من أمين % وقيت نوائب الزمن الخؤون % 2(@)(@@) % ليهن الملك أنك بت منه % بمنزلة الخدين من الخدين % 3(@)(@@) % ولوتحبا بقدرك كنت منه % مكان التاج من أعلى الجبين % 4(@)(@@) % سموت بهمتي عزم وحزم % وطلت بشيمتي كرم ودين % 5(@)(@@) % فما تنفك من فضل عميم % على العافي ومن فضل مبين % 6(@)(@@) % كأنك مطلق الحدين ماض % أفاضت ماءه أيدي القيون % 7(@)(@@) % صفاء خلائق وبهاء خلق % فسعدا للقلوب وللعيون % 8(@)(@@) % كأيام الصبا حسنت ورقت % وأيام الصبابة والشجون % 9(@)(@@) % ظننت بك الجميل فكنت أهلا % لتصديقي وتصديق الظنون % 10(@)(@@) % وما شيمت سحاب نداك إلا % سحبت ذلاذل الحمد المصون % PageV01P297 11(@)(@@) % فما بالي جفيت وكنت ممن % إليه الشوق مجلوب الحنين % 12(@)(@@) % أبعد تعلقي بك مستعيذا % وأخذي منك بالحبل المتين % 13(@)(@@) % يرشح للعلى من ليس مثلي % % ويدعى للغنى من كان دوني % % 14(@)(@@) % أرى عيدان قوم غير عودي % % من الأثمار مثقلة الغصون % 15(@)(@@) % ومالي لا أذم إليك دهري % % إذا المتأخرون تقدموني % % 16(@)(@@) % وما إن قلت ذا حسدا لحر % أفاق الدهر فيه من الجنون % 17(@)(@@) % ولكن العموم من الغوادي % % أحق بشيمة الغيث الهتون % 18(@)(@@) % لقد قبض الزمان يدي وأعيت % علي رياضة الحظ الحرون % 19(@)(@@) % وما استصرخت فيض نداك حتى % % عناني منه بالحرب الزبون % 20(@)(@@) % بقيت لروح مكروب لهيف % دعاك وفك مأسور رهين % PageV01P298 21(@)(@@) % وعشت محسد الأيام تسمو % % إلى العلياء منقطع القرين % PageV01P299 البحر : خفيف تام 1(@)(@@) % أسعد الله بالمسير وأعطى أسعد الله بالمسير وأعطى % % فيه عزم الوزير نجحا ونصرا % % 2(@)(@@) % وحباه المراد فيه وأسنى % % منه ذكرا يبقى وأعلاه قدرا % % 3(@)(@@) % غير نكر أن تدرك الحظ فيه % كم هلال قد عاد بالسير بدرا % % PageV01P300 البحر : طويل 1(@)(@@) % أما وعتاق العيس لو وجدت وجدي % % لقيد أيدي الواخدات عن الوخد % 2(@)(@@) % إذا علمت أن الوجى ليس كالجوى % % وحبب ما ينضي إليها الذي يردي % % 3(@)(@@) % دعاها نسيم البان والرند بالحمى % % وهيهات منها منبت البان والرند % 4(@)(@@) % يطير 
ms91	 بها لبا على القرب والنوى % % ويحملها شوقا على الجور والقصد % 5(@)(@@) % ولولا الهوى لم ترض بالجزع حاجرا % ولم تهجر الغمر النمير إلى الثمد % 6(@)(@@) % أجدك ما تنفك بالغور ناشدا % فؤادا بنجد يا لقلبك من نجد % 7(@)(@@) % وإني لتصميني سهام ادكاركم % وإن كان رامي الشوق مني على بعد % 8(@)(@@) % تمادي غرام ليس يجري إلى مدى % وفرط سقام لا يقيم على حد % 9(@)(@@) % وما أنس لا أنس الحمى وأهلة % تضل ومن حق الأهلة أن تهدي % % 10(@)(@@) % زمان إخال الجهل فيه من النهى % % وحب أعد الغي فيه من الرشد % PageV01P301 11(@)(@@) % غنين وما نولن نيلا سوى الجوى % % وبن ما زودن زادا سوا الوجد % 12(@)(@@) % عواطف يعيي عطفها كل رائض % ضعائف يوهي ضعفها قوة الجلد % 13(@)(@@) % إذا نظرت بزت قلوبا أعزة % وإن خطرت هزت قدود قنا ملد % 14(@)(@@) % غوالب فتك لم يصلن بقوة % طوالب ثأر لم يبتن على حقد % 15(@)(@@) % من المصبيات المحييات بدلها % % على خطإ والقاتلات على عمد % 16(@)(@@) % فودعن بل أودعن قلبي حزازة % وخلفن فرد الشوق بالعلم الفرد % 17(@)(@@) % خليلي ما أحلى الحياة لو نها % % لطاعمها لم تخلط الصاب بالشهد % 18(@)(@@) % لقد حالت الأيام عن حال عهدها % % ومن لي بأيام تدوم على العهد % 19(@)(@@) % سلبن جمالي من شباب وثروة % ووفرن حظي من فراق ومن صد % 20(@)(@@) % وأنحين حتى ما تركن بواريا % على العظم من نحض لبار ولا جلد % PageV01P302 21(@)(@@) % وما شاقني أن لست مستعديا على % % نوائبها إلا لقلة من يعدي % % 22(@)(@@) % ولا بد أن أدعو لدفع خطوبها % % كريما فإن كان ابن سعد فيا سعدي % % 23(@)(@@) % فما عن كمال الدين في الأرض مذهب % لحر أجاجته الخطوب ولا عبد % 24(@)(@@) % وإن عتصامي بالوزير وظله % يد للندى ما مثلها من يد عندي % % 25(@)(@@) % وأي مرام أبتغي بعد جوده % كفى الغيث من يجدى عليه ومن يجدي % % 26(@)(@@) % وها أنا قد ألقيت رحلي بربعه % إلى السؤدد العادي والكرم العد % 27(@)(@@) % إلى هضبة شماء عزت على الذرى % % وفي جنة حصداء جلت عن السرد % 28(@)(@@) % إلى أوحد أهدي له الحمد 
ms92	 وحده % بحق ولا يهدي إلي الغنى وحدي % % 29(@)(@@) % أقل عطاياه التوقل في العلى % % وأدنى سجاياه التفرد بالمجد % 30(@)(@@) % مبيد العدى قهرا وليس بمعتد % ومحيي الورى بذلا وليس بمعتد % PageV01P303 31(@)(@@) % أعز حمى من فاز منه بذمة % وأوفى غنى من بات منه على وعد % 32(@)(@@) % فتى همه ما كان للبر والتقى % % ومغنمه ما كان للأجر والحمد % 33(@)(@@) % من الناقدين العاقدين عن الخنا % % مآزرهم والسالمين على النقد % 34(@)(@@) % مجاورهم في الخوف للجار معقل % ووفدهم في المحل منتجع الوفد % 35(@)(@@) % إذا الغيث أكدى أنشأت مكرماتهم % مواطر غيث لا يغب ولا يكدي % % 36(@)(@@) % وإن زمن الورد انقضى كان عندهم % مواهب يلغى عندها زمن الورد % 37(@)(@@) % لهم من ذوي التيجان كل مخلد % على فقده ، إن الثناء من الخلد % 38(@)(@@) % ومجد حماهم طاهر أن يقصروا % % به عن أب حاز المكارم أو جد % 39(@)(@@) % أغر إذا أعطى أفاد وإن سطا % % أباد وإن أبدى أعاد الذي يبدي % % 40(@)(@@) % منيف على هام المسامي كأنما % % أطل من النشز العلي على وهد % PageV01P304 41(@)(@@) % يريك اهتزازا في الأسرة فخرها % % به و ختيالا في المطهمة الجرد % 42(@)(@@) % وتعزى إليه المكرمات وليس لل % كواكب أن تنفى عن القمر السعد % 43(@)(@@) % جدير بأن يبدي له عفو رأيه % خفية ما يعيي الرجال مع الجهد % 44(@)(@@) % وأن يسع الأمر الذي حرجت به % % مذاهب خطي القنا وظبى الهند % 45(@)(@@) % جلوت القذى عن ناظر الدين بعد ما % % أتاك بعين الشمس في الأعين الرمد % 46(@)(@@) % وكنت ثقافا للزمان فلم تزل % تقوم منه كل أعوج منأد % 47(@)(@@) % فلم تخل سرحا ذل راعيه من حمى % % ولم تخل ثغرا قل حاميه من سد % 48(@)(@@) % أخائذ دين بات يمنك كافلا % له يوم أمضيت عتزامك بالرد % 49(@)(@@) % وليس ببدع منك حد صريمة % ثنت نوب الأيام مفلولة الحد % 50(@)(@@) % وفي أي خطب لم تكن قاضب الشبا % % وفي أي فضل لم تكن ثاقب الزند % PageV01P305 51(@)(@@) % كأنك مجبور على الفضل وحده % فمالك من أن تدرك الفضل من بد % 52(@)(@@) % إليك زففنا كل حسناء لو عدت % علاك لعادت غير ملثومة 
ms93	 الخد % 53(@)(@@) % من الحاليات العاليات مناصبا % تماثل من قبلي وتفضل من بعدي % % 54(@)(@@) % تظن مقيمات وهن سوائر % مخيمة تسري معلقة تخدي % % 55(@)(@@) % رواء وسجف الغيم ليس بمسبل % ضواح وجيب الليل ليس بمنقد % 56(@)(@@) % تمت بآمال إليك كأنها % % رقاب صواد يعتركن على ورد % 57(@)(@@) % وما زلت لباسا من الحمد فخره % ولكن غير السيف يفخر بالغمد % 58(@)(@@) % إذا زين الحسناء عقد بجيدها % % فأحسن منه زينة موضع العقد % 59(@)(@@) % أتيتك للعليا فإن كنت منعما % فبالعزة القعساء لا العيشة الرغد % 60(@)(@@) % إذا نائل لم يحبني الفخر نيله % فإن انقطاع الرفد فيه من الرفد % PageV01P306 البحر : متقارب تام 1(@)(@@) % أتطمع في الود من زاهد % وأين الخلي من الواجد % 2(@)(@@) % وكم قلق لك من ساكن % على سهر لك من راقد % 3(@)(@@) % عناني الغرام بحب السقا % % م شوقا إلى ذلك العائد % 4(@)(@@) % وقد كنت جلدا بي القيا % % د لو أن غير الهوى قائدي % % 5(@)(@@) % ومالي في الدهر من حامد % إذا لم أعذ بعلى حامد % 6(@)(@@) % هو البدر يشرق للمستنير % هو البحر يزخر للوارد % 7(@)(@@) % تجمع فيه خلال الكرام % وقد يجمع الفضل في واحد % 8(@)(@@) % فتى يحجب الفضل عن طالبيه % ولا يحجب الرفد عن قاصد % 9(@)(@@) % يدل على جوده بشره % وقد يعرف الروض بالرائد % 10(@)(@@) % وينطق عن بأسه سيفه % بشيطان فتك له مارد % PageV01P307 11(@)(@@) % ومن يك مولاه هذا المجيد % يكن فوق كل فتى ماجد % PageV01P308 البحر : بسيط تام 1(@)(@@) % يا أيها النجم ما وفيته لقبا % وأنت بدر ومنك البدر يعتذر % 2(@)(@@) % أخوك شمس على الأيام طالعة % فكيف ينكر خلق أنك القمر % PageV01P309 البحر : بسيط تام 1(@)(@@) % لله يوم سقانا اللهو والمطر % به وأحمد منا الورد والصدر % 2(@)(@@) % يوم كفانا من اللذات أن به % لم تطلع الشمس حتى زارنا القمر % 3(@)(@@) % في قامة الغصن إلا أنه رشأ % في طلعة البدر إلا أنه بشر % 4(@)(@@) % زيارة ليت يومي لا يكون له % فيها عشاء وليلي ما له سحر % PageV01P310 البحر : وافر تام 1(@)(@@) % بنفسي من تضيء به الدياجي % % ويظلم حين يبتسم النهار % 2(@)(@@) % ومن أملي 
ms94	 لزورته غرور % ومن نومي لفرقته غرار % 3(@)(@@) % يكدر وصله والود صاف % ويبعد كلما قرب المزار % 4(@)(@@) % وأحلى ما ظفرت به وصال % إذا هو لم يشنه الانتظار % PageV01P311 البحر : كامل تام 1(@)(@@) % لاح الهلال كما تعوج مرهفا % والكوكبان فأعجبا بل أطرفا % % 2(@)(@@) % متتابعين تتابع الكعبين في % % رمح أقيم الصدر منه وثقفا % % 3(@)(@@) % فكأنه وقد استقاما فوقه % كف تخالف أكرتين تلقفا % % PageV01P312 البحر : كامل تام 1(@)(@@) % لاح الهلال فما يكاد يرى % % سقما كصب شفه الخبل % 2(@)(@@) % كالفتر أو كالحجل قد فتحت % منه الكعاب لتدخل الرجل % 3(@)(@@) % والزهرةا لزهراء تقدمه % في الجو وهو وراءها يتلو % % 4(@)(@@) % كالتقوس فوق سهمها فبدا % % متألقا في رأسه النصل % PageV01P313 البحر : مجزوء الكامل 1(@)(@@) % دار يدور بها السرور % أبدا ويسكنها الحبور % 2(@)(@@) % ما إن تخل بمجلس % فيه البدور أو البحور % 3(@)(@@) % تحدو الكؤوس سقاتها % % وكأنها فلك يدور % PageV01P314 البحر : طويل 1(@)(@@) % جرى النهر من شوق إلى ماحل الثرى % % وأجريت دمعا شاقه المنزل القفر % 2(@)(@@) % فلو كنت يوم البين شاهد عبرتي % % وعبرته لم تدر أيهما النهر % 3(@)(@@) % فيا نهر ثورا قد أثرت من الهوى % % دفينا أجنته الجوانح والصدر % 4(@)(@@) % فلو كان لي صبر كففت مدمعي % % ولكن من يشتاق ليس له صبر % PageV01P315 البحر : مجزوء الكامل 1(@)(@@) % ثمر كأن به الذي % % بي من جوى فيه اصفرار % 2(@)(@@) % أبقى الهوى أثرا به % والسكر يتبعه الخمار % PageV01P316 البحر : وافر تام 1(@)(@@) % خيار حين تنسبه خيار % لريحان السرور به اخضرار % 2(@)(@@) % كأن نسيمه أنفاس حب % فليس لمغرم عنه اصطبار % PageV01P317 البحر : رجز تام 1(@)(@@) % أقول واليوم بهيم خطبه % مسود أوضاح الضحى دغوشها % % 2(@)(@@) % يظلم في عيني لا من ظلمة % بل من هموم جمة غطوشها % % 3(@)(@@) % والنرد كالنلورد في مجالها % % أو كالمجوس ضمها ما شوشها % % 4(@)(@@) % كأنها دساكر للشرب أو % عساكر جائشة جيوشها % % 5(@)(@@) % وللفصوص جولة وصولة % تحير الألباب أو تطيشها % % 6(@)(@@) % قاتلها الله فلا بنوجها % % ترفع بي رأسا ولا ششوها % % 7(@)(@@) % أرسلها بيضا إذا أرسلتها % % كأنها قد محيت نقوشها % % 8(@)(@@) % كأنني أقرأ منها أسطرا % من الزبور درست رقوشها % % 9(@)(@@) % كأن 
ms95	 نكرا أن أبيت ليلة % مقمورها غيري أو مقموشها % % 10(@)(@@) % تطيع قوما عمهم نصوحها % % وخصني من بينهم غشوشها % % PageV01P318 11(@)(@@) % يجيبهم متى دعوا أخرسها % % وإن يقولوا يستمع أطروشها % % 12(@)(@@) % مذبذبين دأبهم غيظي فما % % تسلم منهم عيشة أعيشها % % 13(@)(@@) % كأن روحي بينهم أيكية % راحت وكف أجدل تنوشها % % 14(@)(@@) % يبتك منها لحمها وتارة % تكاد تنجو فيطار ريشها % % 15(@)(@@) % إذا حتبى أبو المرجا فيهم % % PageV01P319 البحر : طويل 1(@)(@@) % أراني من روعات بينك نازلا % على حركات ما لهن سكون % 2(@)(@@) % ومن عجب أن الأسى غير قاتلي % % عليك وأن الصبر عنك يهون % PageV01P320 البحر : كامل تام 1(@)(@@) % لم يبق عندي ما يباع بحبة لم يبق عندي ما يباع بحبة % وكفاك مني منظر عن مخبر % 2(@)(@@) % إلا بقية ماء وجه صنتها % % عن أن تباع وأين أين المشتري % % PageV01P321 البحر : مديد تام 1(@)(@@) % ما على العذال من سقمي % % أبجسمي ذاك أم بهم % 2(@)(@@) % لائمي في الحب ويحك لو % ذقت طعم الحب لم تلم % 3(@)(@@) % هل تريح الجفن من سهر % أم تداوي القلب من ألم % PageV01P322 البحر : كامل تام 1(@)(@@) % يا دهر قد عديت عنك طلابي % % ومللت من أري لديك وصاب % % 2(@)(@@) % ورأيت صرفك بالكرام موكلا % فعرفت وجه غرامه بعقابي % % 3(@)(@@) % ما فوق جورك من مزيد بعدما % % عندي فذرني يا زمان لما بي % % 4(@)(@@) % أتظن أنك ضائري بأشد من % عدم الشباب وفرقة الأحباب % 5(@)(@@) % لا والذي جعل الغنى بأبي المنى % % سهلا مطالبه على الطلاب % 6(@)(@@) % بأغر تسكر صحبه أخلاقه % والخمر جائرة على الألباب % 7(@)(@@) % خضل أنامله متى أستسقه % فالغيث غيثي والسحاب سحابي % % 8(@)(@@) % أنا أوحد الشعراء ف حب قرائحي % % بك رتبة يا أوحد الكتاب % 9(@)(@@) % إني خلعت عليك برد مدائحي % % ولو استطعت خلعت برد شبابي % % PageV01P323 البحر : طويل 1(@)(@@) % أصون لساني والجنان يذال % وأقصر بثي والشجون طوال % 2(@)(@@) % وأحبس عن قوم عنان قصائدي % % وقد أمكن الطرف الجواد مجال % 3(@)(@@) % تذم الليالي إن تعذر مطلب % وأولى لعمري أن تذم رجال % 4(@)(@@) % وما ألزم الأيام ذنب معاشر % لدرهم قبل الرضاع فصال % 5(@)(@@) % وآل غنى جم هم البحر 
ms96	 ثروة % ولكنهم عند النوائب آل % 6(@)(@@) % لو ن بلالا جاءهم بمحمد % لعاد وما في فيه منه بلال % 7(@)(@@) % خليلي ما كل العسير بمعجز % مرامي ولا كل اليسير ينال % 8(@)(@@) % وليس أخو الحاجات من بات راضيا % بعجز على الأقدار فيه يحال % 9(@)(@@) % تقلبت في ثوبي رخاء وشدة % كذلك أحوال الزمان سجال % 10(@)(@@) % وقد وسمتني الأربعون بمرها % % وحالت بشيبي للشبيبة حال % PageV01P324 11(@)(@@) % فليت الذي أرجو من العمر بعدها % % يطيب به عيش وينعم بال % 12(@)(@@) % يقول أناس كيف يعزك الغنى % % ومثلك يكفيه الفعال مقال % 13(@)(@@) % وما عندهم أن السؤال مذلة % ونقص وما قدر الحياة سؤال % 14(@)(@@) % ترفعت إلا عن ندى ابن محسن % وخير الندى ما كان فيه جمال % 15(@)(@@) % وعند وجيه الدولة ابن رشيدها % % ولا بد لي من دولة فخمة % 16(@)(@@) % وأخلاق غيث كلما جئت صاديا % وردت بهن العيش وهو زلال % 17(@)(@@) % وبشر إلى الزوار في كل لزبة % به تلقح الآمال وهي حيال % 18(@)(@@) % تدانت به الغايات وهي بعيدة % وخفت به الحاجات وهي ثقال % 19(@)(@@) % وما البشر إلا رائد بعده الحيا % % 20(@)(@@) % متى أرج إسمعيل للعز والغنى % % فما هو إلا عصمة وثمال % PageV01P325 21(@)(@@) % فتى ظافرت هماته عزماته % كما ظافرت سمر الصعاد نصال % 22(@)(@@) % هو البدر إلا أنه لا يغبه % على طول أوقات الزمان كمال % 23(@)(@@) % من القوم ذاد الناس عن نيل مجدهم % قراع لهم دون العلى ونضال % 24(@)(@@) % نبال المساعي ، ما تزال ثوابتا % لهم في قلوب الحاسدين نبال % 25(@)(@@) % إذا قاولوا بالأحوذية أفحموا % % وإن طاولوا بالمشرفية طالوا % % 26(@)(@@) % أولئك أنصار النبي ورهطه % إذا عد فخر باهر وجلال % 27(@)(@@) % أأزعم أن لا مال لي بعد هذه % وجودك ذخر للمقل ومال % 28(@)(@@) % ومن سار يستقري نداك إلى الغنى % % فليس بمخشي عليه ضلال % 29(@)(@@) % وما جوهر الأشياء والخلق خافيا % إذا ما طباع ميزت وخلال % 30(@)(@@) % لفضل ما بين السيوف مضاؤها % % وفضل ما بين الرجال فعال % PageV01P326 31(@)(@@) % % ولكنه المعشوق فيه دلال % 32(@)(@@) % وعندي ثناء لا يمل كما انثنى % % إلى عاشق بعد الصدود وصال % 33(@)(@@) % يزان به عرض 
ms97	 الفتى وهو ماجد % كما زان متن المشرفي صقال % 34(@)(@@) % % بها من صروف النائبات أدال % 35(@)(@@) % ومن نعمة خضراء عندك غضة % يمد عليها للنعيم ظلال % 36(@)(@@) % فلا يسترث ميعاد مجدك جاهل % فما عند مجد الأسعدين مطال % 37(@)(@@) % فإن نجوم الليل في حندس الدجى % % يرين بطيئات وهن عجال % 38(@)(@@) % وهل للورى إلا عليك معول % وهل للعلى إلا إليك مآل % 39(@)(@@) % فما المجد إلا للكرام ممالك % ولا الناس إلا للكفاة عيال % 40(@)(@@) % إذا ما القوافي بشرتك بمطلب % وفى لك منها بالحقائق فال % PageV01P327 البحر : كامل تام 1(@)(@@) % أدنى اشتياقي أن أبيت عليلا % % وأقل وجدي أن أذوب نحولا % % 2(@)(@@) % كم أكتم الشوق المبرح والهوى % % وكفى بدمعي والسقام دليلا % % 3(@)(@@) % فاليوم قد أمضى الصدود تلددي % % وأعاد حد تجلدي مفلولا % % 4(@)(@@) % أشكو فينصدع الصفا لي رقة % لو كان يرحم قاتل مقتولا % % 5(@)(@@) % وأذل من كمد وفرط صبابة % والحب ما ترك العزيز ذليلا % % 6(@)(@@) % يا ليتني إذ خان من أحببته % يوما وجدت إلى السلو سبيلا % % 7(@)(@@) % ما لي شغلت بحب من لا ينثني % % كلفا بغير محبه مشغولا % % 8(@)(@@) % ما لي أرى برد الشراب معرضا % فأذاد عنه وما شفيت غليلا % % 9(@)(@@) % من مسعدي من عاذلي من راحمي % % من ذا يعين متيما مخبولا % % 10(@)(@@) % يا عاذلي أرأيت مغلوب الحشا % % يعصي الصبابة أو يطيع عذولا % % PageV01P328 11(@)(@@) % لو كنت تعلم ما لقيت من الهوى % % لوجدتني للنائبات حمولا % % 12(@)(@@) % ما لي على صرف الحوادث مسعد % إلا رجاء سماح إسماعيلا % % 13(@)(@@) % الماجد الغمر الأبي الأوحد ال % % بر الوفي الباذل المأمولا % % 14(@)(@@) % من لا يرى أن الجواد بماله % من لا يكون على العلاء بخيلا % % 15(@)(@@) % الجاعل الفعل الجميل ذريعة % إبدا إلى حمد الورى ووسيلا % % 16(@)(@@) % من لا يعد البحر نهلة شارب % يوما ولا الخطب الجليل جليلا % % 17(@)(@@) % قد نال من شرف الفعال ذخيرة % تبقى إذا كاد الزمان يزولا % % 18(@)(@@) % و ستخلص الحمد الجزيل لنفسه % فحواه واتخذ السماح خليلا % % 19(@)(@@) % ما إن تراه الدهر إلا قائلا % للمكرمات الباهرات فعولا % % 20(@)(@@) % إن سيل عند الجود كان غمامة 
ms98	 % أو عد يوم البأس كان قبيلا % % PageV01P329 21(@)(@@) % همما تطول بحزمه وعزائما % % بتكا كما اخترط الكماة نصولا % % 22(@)(@@) % ومناقبا لا يأتلين طوالعا % أبدا إذا هوت النجوم أفولا % % 23(@)(@@) % وإلى وجيه الدولة ابن رشيدها % % حمدا كنائله الجزيل جزيلا % % 24(@)(@@) % من معشر كانوا لأمات العلى % % أبدا فحولا أنجبت وبعولا % % 25(@)(@@) % الباهرين فضائلا والغامري % % ن نوافلا والطيبين أصولا % % 26(@)(@@) % ي بن المحسن طال ما أحسنت بي % % كرما يبيت من الزمان مديلا % % 27(@)(@@) % إن كان يقصر عنك ثوب مدائحي % % فلقد يكون على سواك طويلا % % 28(@)(@@) % من ذا يقوم بشكر ما أوليته % حملتني منا علي ثقيلا % % 29(@)(@@) % فلأشكرنك ما تغنى تائق % طرب وما دعت الحمام هديلا % % 30(@)(@@) % ولأمنحنك من ثنائي مقولا % ما كان قبلك في الزمان مقولا % % PageV01P330 31(@)(@@) % لا تسقني إلا بكفك إنما % % خير السحائب ما يبيت همولا % % 32(@)(@@) % قد آمنتك المكرمات الغر أن % أمسي لغيرك عافيا ونزيلا % % 33(@)(@@) % حاشا لنائلك الذي عودتني % % من أن أرى لك مشبها ومثيلا % % 34(@)(@@) % هب لي نصيبا من شمائلك التي % % لو كن مشروبا لكن شمولا % % 35(@)(@@) % و سلم على الأيام تكبت حاسدا % وتذل أعداء وتبلغ سولا % % PageV01P331 البحر : متقارب تام 1(@)(@@) % أسوم الجباب فلا خزها % % أطيق ابتياعا ولا صوفها % % 2(@)(@@) % وكيف السبيل إلى جبة % لمن ليس يملك تصحيفها % % PageV01P332 البحر : متقارب تام 1(@)(@@) % فإن أمكنت بأيادي المكين % فما زلت أعرف معروفها % % 2(@)(@@) % وكم برز الروض في حلة % تولت يد الغيث تفويفها % % PageV01P333 البحر : متقارب تام 1(@)(@@) % أبا حسن أنت أهل الجميل % فهل لك هل لك في مكرمه % 2(@)(@@) % يفيد بها الحمد من نفسه % متيمة بالعلى مغرمه % 3(@)(@@) % وما زلت ترفل في برده % وتلبس أثوابه المعلمه % 4(@)(@@) % ثناء يعز الورى جحده % كما عزك المسك أن تكتمه % 5(@)(@@) % ومن كان يبغي لديك النوال % فلست بباغ سوى مقلمه % 6(@)(@@) % ترى وهي مسمنة ظاهرا % ولكنها باطنا مسقمه % 7(@)(@@) % كأن حشاها فؤاد الخل % ي لم يصل نار الهوى المضرمه % 8(@)(@@) % إذا أهديت وهي صفر رأي % ت صورة متأقة مفعمه % 9(@)(@@) % وإن جدت فيها بأقلامها % % جمعت الذوابل في ملحمه 
ms99	 % 10(@)(@@) % فكم ثم من زاعبي تخال % مكان المداد به لهذمه % PageV01P334 11(@)(@@) % إذا ما طعنت به مطلبا % سفكت بغير جناح دمه % 12(@)(@@) % كمثل الكنانة يوم النضا % % ل أودعها نابل أسهمه % 13(@)(@@) % مضمنة آلة للسم % و تثري بها الهمة المعدمه % 14(@)(@@) % إذا فتحت أبرزت أنصلا % كما فغر الليث يوما فمه % 15(@)(@@) % لك الفضل في صنعها إنها % % بلطفك ملمومة محكمه % 16(@)(@@) % ينم به ماكستها يدا % % ك من معجز الوشي والنمنمه % 17(@)(@@) % كأن عليها لأخلاقك ال % % حسان من الظرف أبهى سمه % 18(@)(@@) % سرى بك علمك مسرى البدور % فقصر من قال ما أعلمه % 19(@)(@@) % وأكد عقدك أن الجمي % % ل ليس لبانه أن يهدمه % 20(@)(@@) % ووفد ثناء بعثنا إلي % % إليك يشتاق أهل النهى مقدمه % PageV01P335 21(@)(@@) % جمعت صفاتك في سلكه % لمن وجد الدر أن ينظمه % PageV01P336 البحر : بسيط تام 1(@)(@@) % مليت بدرا تناه وضرغاما % % تحوي به للعدى كبتا وإرغاما % % 2(@)(@@) % سماه مجدك بهراما لأن له % سعدا يطاول كيوانا وبهراما % % 3(@)(@@) % قد عاد من نوره الإظلام وهو ضحى % من بعد ما غادر الإصباح إظلاما % % 4(@)(@@) % بشراك أنك ما تنفك تلبسه الن % عمى وتلبس إجلالا وإعظاما % % 5(@)(@@) % يا أكرم الناس آباء وأشرفهم % عند التفاخر أخوالا وأعماما % % 6(@)(@@) % أطلعت بالشام من بهرام بدر دجى % أضحى العراق عليه يحسد الشاما % % 7(@)(@@) % ف سعد به دائم النعماء معتليا % على الزمان وخير العيش ما داما % % PageV01P337 البحر : متقارب تام 1(@)(@@) % دعاني الأمير فلبيته % ولم لا ألبيك يا خير داع % 2(@)(@@) % فوافيت أزهر رحب الذراع % شديد المصاع شريف المساعي % % 3(@)(@@) % كريم الفعال غريب النوال % غريم نضال العدى والقراع % 4(@)(@@) % وقد كنت أنتجع الأكرمين % فقل في كريم حداه انتجاعي % % 5(@)(@@) % أشمس الأنام ومولى الكرام % % وترب الغمام ورب الزماع % 6(@)(@@) % سأشكر ما دمت في العالمين % مكارم أحسن فيك صطناعي % % 7(@)(@@) % أطيل الثناء على ماجد % أطال على نوب الدهر باعي % % PageV01P338 البحر : رمل تام 1(@)(@@) % أترى أبصره مثلي القدح % فغدا زند حشاه يقتدح % 2(@)(@@) % و نثنى منكسرا من وجده % بكسير الطرف كالظبي سنح % 3(@)(@@) % قمر يسعد لو يشبهه % قمر الليل 
ms100	 إذا جنح % 4(@)(@@) % لبس الحسن كشمس الدولة ال % % ملك إذ يلبس معشوق المدح % PageV01P339 البحر : طويل 1(@)(@@) % أروح وقلبي عنك ليس برائح % وذكرك باقي الشوق بين الجوانح % 2(@)(@@) % وحسبي شمس الدولة الملك غاية % من الفخر أن تهدى إليك مدائحي % % 3(@)(@@) % وقد كان شعري يفضح الشعر كله % فأمسى بما تولي سماحك فاضحي % % PageV01P340 البحر : بسيط تام 1(@)(@@) % قل للعميد عميد الملك إن له % عزما يؤمل للدنيا وللدين % 2(@)(@@) % يا خير من شعف الحمد الجزيل له % قلبا بغير المعالي غير مفتون % 3(@)(@@) % ما بال بابك مفتوحا لداخله % ولست ألقاه إلا مغلقا دوني % % 4(@)(@@) % إني أعوذ بعطف منك أعرفه % ما زال يقتل أعدائي ويحييني % % 5(@)(@@) % من أن يكون الذي بيني وبينهم % شيئا سوى الحظ يدنيهم ويقصيني % % PageV01P341 البحر : طويل 1(@)(@@) % وكنت إذا ما رابني الدهر مرة % وقد ولد الدهر الكرام فأنجبا % % 2(@)(@@) % دعوت كريما ف ستجاب لدعوتي % % أغر إذا ما راده الظن أخصبا % % 3(@)(@@) % إذا كنت راجي نعمة من مؤمل % فحسبي أن أرجو العميد المهذبا % % 4(@)(@@) % عسى جوده المأمول ينتاش هالكا % أسير زمان بالخطوب معذبا % % 5(@)(@@) % أرى الدهر لا يزداد إلا فظاظة % علي ولا أزداد إلا تعتبا % % 6(@)(@@) % فكن لبني الأحرار حصنا ومعقلا % إذا خانهم صرف الزمان وخيبا % % 7(@)(@@) % سواك يعاب المادحون بنيله % وغيرك من آبى لجدواه مطلبا % % PageV01P342 البحر : متقارب تام 1(@)(@@) % أيا ناهض الملك أي الثناء % يقوم بشكرك أو ينهض % 2(@)(@@) % ومن ذا يراك فيدعو سوا % % ك يوما لخطب إذا يرمض % 3(@)(@@) % وكيف ولما تزل للندى % % محبا إذا كثر المبغض % 4(@)(@@) % فتعطف إن صد عنه اللئام % وتقبل بالود إن أعرضوا % % 5(@)(@@) % دعاني بشرك قبل النوال % وأثرى به الأمل المنفض % 6(@)(@@) % وأحرى الحيا أن يروي الثرى % % حيا بات بارقه يومض % 7(@)(@@) % وأطعمني في نداك الجزيل % خلائق يشفى بها الممرض % 8(@)(@@) % ووجهك والفعل إذ يشرقان % كأنهما عرضك الأبيض % 9(@)(@@) % فإما وهبت فنعم الوهوب % وإلا فكالواهب المقرض % PageV01P343 البحر : خفيف تام 1(@)(@@) % عشت للمجد أطول الأعمار % بالغا فيه أفضل الإيثار % 2(@)(@@) % وشفاك الإله من كل داء % ووقاك المخوف من 