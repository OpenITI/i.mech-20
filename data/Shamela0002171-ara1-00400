ms381	 بندار وعثمان بن طالوت وعدة قال بن معين وغيره ليس بشئ وحسن الترمذي له ت س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2575- (@)(@@) عباد بن منصور الناجي عن أبي رجاء العطاردي وعكرمة وعنه القطان وروح وطائفة(@)(@@) ضعيف وقال النسائي ليس بالقوي 4(@)(@@)(@@)(@@) | 2576- (@)(@@) عباد بن موسى الختلي عن إبراهيم بن سعد وهشيم وعنه مسلم وأبو داود والبخاري والنسائي بواسطة وأبو يعلى وثق مات 229 خ م د س(@)(@@)(@@)(@@) | 2577- (@)(@@) عباد بن ميسرة المنقري المؤدب عن الحسن وغيره وعنه وكيع وأبو داود ضعفه أحمد وكان عابدا ليس بالقوي س(@)(@@)(@@)(@@) | 2578- (@)(@@) عباد بن نسيب القيسي أبوالوضئ مشهور بالكنية وعنه جميل بن مرة وبديل بن ميسرة وثق د ق(@)(@@)(@@)(@@) | 2579- (@)(@@) عباد بن الوليد أبو بدر الغبري عن أبي داود وأبي عاصم وعنه بن ماجة وابن مخلد وابن أبي حاتم وثق توفي 262 ق(@)(@@)(@@)(@@) | 2580- (@)(@@) عباد بن أبي يزيد أو بن يزيد الكوفي عن علي وعنه السدي ت(@)(@@)(@@)(@@) | 2581- (@)(@@) عباد بن يعقوب الرواجني شيعي جلد عن الوليد بن أبي ثور وشريك وعدة وعنه البخاري(@)(@@) PageV00P000(@)(@@) مقرونا والترمذي وابن ماجة وابن خزيمة وابن صاعد وخلق وثقه أبو حاتم توفي 25 خ ت ق(@)(@@)(@@)(@@) | 2582- (@)(@@) عباد بن يوسف الكندي أبو عثمان الحمصي عن أرطاة بن المنذر وصفوان بن عمرو وعنه عمرو بن عثمان وأبو يوسف الصيدلاني صدوق يغرب مات 206 ق(@)(@@)(@@)(@@) | 2583- (@)(@@) عباد السماك عن الثوري حكى عنه قبيصة د(@)(@@)(@@)(@@) | 2584- (@)(@@) عبادة بن الصامت أبو الوليد الخزرجي من بني عمرو بن عوف بدري نقيب عنه أبو إدريس وجبير بن نفير وهو أحد من جمع القرآن وكان طويلا جسيما جميلا مات بالرملة 34 وله اثنان وسبعون عاما ع(@)(@@)(@@)(@@) | 2585- (@)(@@) عبادة بن عمر بن أبي ثابت عن عكرمة بن عمار وغيره وعنه محمد بن مسكين وعبد الله بن محمد الرومي س(@)(@@)(@@)(@@) | 2586- (@)(@@) عبادة بن مسلم الفزاري أبويحيى عن الحسن وطائفة وعنه أبو عاصم وروح صحح الترمذي له 4(@)(@@)(@@)(@@) | 2587- (@)(@@) عبادة بن نسي الكندي أبو عمر قاضي طبرية عن أبي الدرداء وخباب وخلق وعنه هشام(@)(@@) PageV00P000(@)(@@) بن الغاز وبرد بن سنان ثقة كبير القدر مات 118 وأظن رواياته عن 
ms382	 الكبار منقطعة 4(@)(@@)(@@)(@@) | 2588- (@)(@@) عبادة بن الوليد بن عبادة بن الصامت عن أبيه وعن جده وعائشة وعنه يحيى بن سعيد وابن عجلان ثقة خ م د س ق(@)(@@)(@@)(@@) | 2589- (@)(@@) عبادة بن يوسف وقيل عباد عن أبي بردة وعنه إسماعيل بن إبراهيم بن مهاجر لم يصح خبره ت(@)(@@)(@@)(@@) | 2590- (@)(@@) عباس بن جعفر أبو محمد بن أبي طالب أخو يحيى عن شبابة ويحيى بن أبي بكير وعنه بن ماجة وابن مخلد وعدة توفي 258 ق(@)(@@)(@@)(@@) | 2591- (@)(@@) عباس بن جليد الحجري عن بن عمر وعبد الله بن الحارث بن جزء وعنه حميد بن هانئ وبكر بن عمرو ثقة د ت(@)(@@)(@@)(@@) | 2592- (@)(@@) عباس بن حسين القنطري عن أبي أسامة وطبقته وعنه البخاري وموسى بن هارون توفي 240 خ(@)(@@)(@@)(@@) | 2593- (@)(@@) عباس بن ذريح الكلبي عن شريح وكميل بن زياد وعنه مسعر وشريك صدوق د س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2594- (@)(@@) عباس بن رزمة حكى عنه محمد بن عبد الله بن قهزاد مق(@)(@@)(@@)(@@) | 2595- (@)(@@) عباس بن سالم بن جميل اللخمي عن أبي إدريس وأبي سلام ممطور وعنه محمد بن مهاجر وأخوه عمرو وثق د ت ق(@)(@@)(@@)(@@) | 2596- (@)(@@) عباس بن سهل بن سعد الساعدي عن أبيه وسعيد بن زيد وعنه فليح وعبد الرحمن بن الغسيل مات في حدود عشرين ومائة مع قتادة خ م د ت ق(@)(@@)(@@)(@@) | 2597- (@)(@@) عباس بن عبد الله أبو الحارث الاسدي الانطاكي عن القعنبي وطبقته وعنه النسائي وأبو عوانة والعقيلي صدوق س(@)(@@)(@@)(@@) | 2598- (@)(@@) عباس بن عبد الله الترقفي عن الفريابي ورواد بن الجراح وعنه بن ماجة والمحاملي(@)(@@) والصفار ثقة متعبد توفي 267 ق(@)(@@)(@@)(@@) | 2599- (@)(@@) عباس بن عبد الله بن معبد بن العباس عن أبيه وعكرمة وعنه بن عيينة والداروردي ليس به بأس د(@)(@@)(@@)(@@) | 2600- (@)(@@) عباس بن عبد الرحمن بن مينا الاشجعي عن جودان وابن عباس وعنه بن جريج وابن إسحاق صالح ق(@)(@@)(@@)(@@) | 2601- (@)(@@) عباس بن عبد العظيم أبو الفضل العنبري من حفاظ البصرة سمع القطان وعبد الرزاق وعنه مسلم والاربعة والبخاري تعليقا وابن خزيمة مات 246 م 4(@)(@@)(@@)(@@) | 2602- (@)(@@) العباس عم النبي صلى الله عليه وسلم أسن منه بثلاث سنين عنه 
ms383	 بنوه عبد الله وعبيد الله وكثير ونافع بن جبير توفي 33 وقيل 32 ع(@)(@@)(@@)(@@) | 2603- (@)(@@) عباس بن عبيد الله بن عبد الله بن عباس عن عمه مرسل وعن خالد بن يزيد وعنه أيوب وابن جريج ثقة د س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2604- (@)(@@) عباس بن عثمان بن شافع عن عمر بن محمد بن الحنفية وعنه ابنه محمد ق(@)(@@)(@@)(@@) | 2605- (@)(@@) عباس بن عثمان البجلي الدمشقي عن إسماعيل بن عياش والوليد وعنه بن ماجة والحسن بن سفيان ثقة توفي 239 ق(@)(@@)(@@)(@@) | 2606- (@)(@@) عباس بن الفرج أبو الفضل الرياشي كان أبوه مولى رجل اسمه رياش بصري علامة في العربية والشعر أخذ عن أبي عبيدة وأبي داود وعنه أبو داود قوله وابن دريد وأبو روق ثقة قتلته الزنج 257 د(@)(@@)(@@)(@@) | 2607- (@)(@@) عباس بن فروخ الجريري بصري عن أبي عثمان النهدي وعمرو بن شعيب وعنه شعبة والحمادان ثقة ع(@)(@@)(@@)(@@) | 2608- (@)(@@) العباس بن الفضل الانصاري الموصلي المقرئ عن يونس وخالد الحذاء وعنه إبراهيم بن عبد الله الهروي وزكريا بن حمويه ولي قضاء الموصل واه توفي 186 ق(@)(@@)(@@)(@@) | 2609- (@)(@@) عباس بن محمد الدوري أبو الفضل مولى بني هاشم عن حسين الجعفي وأبي داود وعنه الاربعة والاصم وابن البختري ثقة حافظ توفي 4 271(@)(@@)(@@)(@@) | 2610- (@)(@@) عباس بن مرداس السلمي شريف مطاع من المؤلفة شهد الفتح في تسعمائة من قومه عنه ابنه كنانة وعبد الرحمن بن أنس د ق(@)(@@)(@@)(@@) | 2611- (@)(@@) العباس بن الوليد الدمشقي الخلال عن الوليد بن مسلم وابن سميع وعنه بن ماجة وعبدان وابن أبي داود صويلح توفي 248 ق(@)(@@)(@@)(@@) | 2612- (@)(@@) عباس بن الوليد بن مزيد العذري عن أبيه وشعيب بن إسحاق وابن شابور وعنه أبو داود(@)(@@) PageV00P000(@)(@@) والنسائي والاصم وخيثمة صدوق صاحب ليل بلغ المائة مات 270 د س(@)(@@)(@@)(@@) | 2613- (@)(@@) عباس بن الوليد بن نصر النرسي بن عم عبد الاعلى سمع الحمادين وعنه البخاري ومسلم وأبو يعلى صدوق تكلم فيه مات 238 خ م س(@)(@@)(@@)(@@) | 2614- (@)(@@) عباس بن يزيد البحراني أبو الفضل قاضي همذان عن غندر وابن عيينة وعنه بن ماجة وابن مخلد وابن أبي حاتم صدوق توفي 258 ق(@)(@@)(@@)(@@) | 2615- (@)(@@) عباس الجشمي عن 
ms384	 عثمان وأبي هريرة وعنه قتادة والجريري وثق د ت ق(@)(@@)(@@)(@@) | 2616- (@)(@@) عباءة بن كليب الليثي أبو غسان الكوفي عن داود الطائي ومبارك بن فضالة وعنه أبو كريب وابن عفان قال أبو حاتم صدوق في حديثه إنكار ق(@)(@@)(@@)(@@) | 2617- (@)(@@) عباية بن رفاعة بن رافع بن خديج عن جده وابن عمر وعنه أبو حيان التيمي وليث بن أبي سليم ثقة ع(@)(@@)(@@)(@@) | 2618- (@)(@@) عبثر بن القاسم أبو زبيد الزبيدي عن حصين وسليمان التيمي وعنه هناد ومسدد وقتيبة توفي 178 ع(@)(@@)(@@)(@@) | 2619- (@)(@@) عبد الله بن إبراهيم بن عمر الصنعاني عن أبيه وعمومته وعنه أحمد والرمادي صالح الحديث د س(@)(@@)(@@)(@@) | 2620- (@)(@@) عبد الله بن إبراهيم الغفاري المدني عن إبراهيم بن مهاجر ومالك وعنه أبو قلابة الرقاشي والكديمي متهم عدم د ت(@)(@@) *- عبد الله بن إبراهيم بن قارظ وقيل إبراهيم بن عبد الله عن أبي هريرة وعنه عمر بن عبد العزيز م س 156(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2621- (@)(@@) عبد الله بن أبي قاضي خوارزم عن أحمد بن يونس وسعيد بن منصور حافظ مكثر عنه البخاري في الضعفاء له وأبو العباس بن حمدان شيخ البرقاني وقال البخاري في الصحيح حدثنا عبد الله حدثنا سليمان بن عبد الرحمن فهو هذا وقيل بن حماد الآملي خ(@)(@@)(@@)(@@) | 2622- (@)(@@) عبد الله بن الاجلح الكندي عن أبيه ومنصور وعنه أبو كريب والاشج ثقة ت ق(@)(@@)(@@)(@@) | 2623- (@)(@@) عبد الله بن أحمد بن بشير بن ذكوان مقرئ دمشق عن بقية والوليد وقرأ على أيوب بن تميم وعنه أبو داود وابن ماجة ومحمد بن الفيض قال أبو حاتم صدوق مات 242 د ق(@)(@@)(@@)(@@) | 2624- (@)(@@) عبد الله بن أحمد بن عبد الله بن يونس أبو حصين اليربوعي عن عبثر وأبيه وعنه الترمذي والنسائي وابن صاعد ثقة توفي 248 ت س(@)(@@)(@@)(@@) | 2625- (@)(@@) عبد الله بن أحمد بن محمد بن حنبل الحافظ أبو عبد الرحمن الشيباني عن أبيه وشيبان والهيثم بن خارجة وعنه النسائي والطبراني وأبو بكر الشافعي ولد سنة 213 ومات في جمادي الآخرة 29 س(@)(@@)(@@)(@@) | 2626- (@)(@@) عبد الله بن أبي أحمد بن جحش الاسدي عن أبيه وعلي وعنه ابنه بكر 
ms385	 أو بكير وعبد الله بن الاشج وقيل لقي عمر د(@)(@@)(@@)(@@) | 2627- (@)(@@) عبد الله بن إدريس بن يزيد الاودي أبو محمد أحد الاعلام عن أبيه وعمه داود وحصين وهشام بن عروة وعنه أحمد وإسحاق والعطاردي قال أحمد كان نسيج وحده توفي 192 ع(@)(@@)(@@)(@@) | 2628- (@)(@@) عبد الله بن الارقم بن عبد يغوث الزهري من الطلقاء كتب الوحي وولي بيت المال لعمر وعثمان بلا أجر روى عنه أسلم وعروة 4(@)(@@)(@@)(@@) | 2629- (@)(@@) عبد الله بن إسحاق الناقد أبو جعفر عن يزيد بن هارون وروح وعنه بن ماجة وابن أبي داود ثقة ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2630- (@)(@@) عبد الله بن إسحاق الجوهري المستملي لقبه بدعة عن أبي عاصم النبيل وعبد الله بن رجاء(@)(@@) وعنه الاربعة وعبد الله بن عروة توفي 4 257(@)(@@)(@@)(@@) | 2631- (@)(@@) عبد الله بن إسماعيل الكوفي عن ليث ومجالد وعنه أبو كريب مجهول ت ق(@)(@@)(@@)(@@) | 2632- (@)(@@) عبد الله بن أقرم أبو معبد الخزاعي له ولابيه صحبة عنه ابنه عبيد الله ت س ق(@)(@@)(@@)(@@) | 2633- (@)(@@) عبد الله بن أبي أمامة الانصاري عن أبيه وغيره وعنه صالح بن كيسان وابن إسحاق وثق د ق(@)(@@)(@@)(@@) | 2634- (@)(@@) عبد الله بن إنسان الطائفي عن عروة لم يصح خبره في صيد وج قاله البخاري د(@)(@@)(@@)(@@) | 2635- (@)(@@) عبد الله بن أنيس الجهني حليف الانصار عقبي بطل شجاع عنه بنوه وجابر وبسر بن سعيد توفي 54 م 4(@)(@@)(@@)(@@) | 2636- (@)(@@) عبد الله بن أنيس الانصاري لعله الاول عنه ابنه عيسى د ت(@)(@@)(@@)(@@) | 2637- (@)(@@) عبد الله بن أوس الخزاعي عن بريدة وعنه إسماعيل بن سليمان الكحال وثق د ت(@)(@@)(@@)(@@) | 2638- (@)(@@) عبد الله بن أبي أوفى الاسلمي له صحبة كأبيه عنه عمرو بن مرة وإسماعيل بن أبي خالد توفي بالكوفة 86 ع(@)(@@)(@@)(@@) | 2639- (@)(@@) عبد الله بن باباه وقيل بأبيه وقيل بابي المكي عن جبير بن مطعم وأبي هريرة وعنه أبو الزبير وقتادة ثقة م 4(@)(@@)(@@)(@@) | 2640- (@)(@@) عبد الله بن بحير بن ريسان المرادي الصنعاني كنيته أبو وائل عن هانئ مولى عثمان(@)(@@) PageV00P000(@)(@@) وعدة وعنه هشام بن يوسف وعبد الرزاق وثق وليس بذاك د ت ق(@)(@@)(@@)(@@) | 2641- (@)(@@) عبد الله بن بدر بن عميرة اليمامي 
ms386	 عن بن عباس وطلق بن علي وعنه سبطه ملازم بن عمرو وعكرمة بن عمار وأيوب بن عتبة ثقة 4(@)(@@)(@@)(@@) | 2642- (@)(@@) عبد الله بن بديل المكي عن عمرو بن دينار والزهري وعنه ابنه مهدي وزيد بن الحباب صويلح الحديث له ما ينكر د س(@)(@@)(@@)(@@) | 2643- (@)(@@) عبد الله بن براد بن يوسف بن أبي بردة بن أبي موسى أبو عامر الكوفي عن بن إدريس وابن فضيل وعنه مسلم ومطين والحسن بن سفيان ثقة توفي 234 م(@)(@@)(@@)(@@) | 2644- (@)(@@) عبد الله بن بريدة قاضي مرو وعالمها عن أبيه وعمران بن حصين وعائشة وعنه مالك بن مغول وحسين بن واقد وأبو هلال ثقة ولد عام اليرموك وعاش مائة توفي 115 ع(@)(@@)(@@)(@@) | 2645- (@)(@@) عبد الله بن بسر المازني صحابي نزل حمص عنه حريز بن عثمان وحسان بن نوح عاش أربعا وتسعين سنة مات 88 ع(@)(@@)(@@)(@@) | 2646- (@)(@@) عبد الله بن بسر الحبراني الحمصي عن عبد الله بن بسر وأبي أمامة وعنه إسماعيل بن عياش وإسماعيل بن زكريا وعدة نزل البصرة ضعفه يحيى القطان ت ق(@)(@@)(@@)(@@) | 2647- (@)(@@) عبد الله بن بشر قاضي الرقة عن أبي إسحاق ويحيى بن أبي كثير وعنه عبد السلام بن حرب ومعمر الرقي ثقة س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2648- (@)(@@) عبد الله بن بشر الخثعمي الكاتب عن أبي زرعة البجلي وعروة البارقي وعنه شعبة والسفيانان ثقة س ق(@)(@@)(@@)(@@) | 2649- (@)(@@) عبد الله بن أبي بصير العبدي عن أبيه عن أبي وعن أبي أيضا وعنه أبو إسحاق يجهل وقد وثق د س ق(@)(@@)(@@)(@@) | 2650- (@)(@@) عبد الله بن بكر السهمي أبو وهب حافظ ثقة عن حميد وابن عون وبهز وعنه محمد بن الفرج وابن ملاعب والحارث بن أبي أسامة مات 208 ع(@)(@@)(@@)(@@) | 2651- (@)(@@) عبد الله بن بكر بن عبد الله المزني عن أبيه وابن سيرين وعنه مهدي وعفان صدوق د س ق(@)(@@)(@@)(@@) | 2652- (@)(@@) عبد الله بن أبي بكر بن زيد عن مسلم بن أبي سهل وعنه موسى بن يعقوب وثق ولا يعرف ت(@)(@@)(@@)(@@) | 2653- (@)(@@) عبد الله بن أبي بكر بن عبد الرحمن عن أبيه وغيره وعنه الزهري ومحمد بن عبد الله الشعيثي 
ms387	 س ق(@)(@@)(@@)(@@) | 2654- (@)(@@) عبد الله بن أبي بكر بن محمد بن عمرو بن حزم عن أبيه وأنس وعمرة وعنه فليح والسفيانان وابن علية حجة مات 135 ع(@)(@@)(@@)(@@) | 2655- (@)(@@) عبد الله بن أبي بلال الخزاعي عن العرباض وعبد الله بن بسر وعنه خالد بن معدان وثق د ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2656- (@)(@@) عبد الله بن ثابت المروزي عن صخر بن عبد الله وعنه أبوتميلة يحيى بن واضح لا يعرف د(@)(@@)(@@)(@@) | 2657- (@)(@@) عبد الله بن ثعلبة بن صعير العذري له صحبة إن شاء الله له عن عمر وعنه الزهري وسعد بن إبراهيم توفي 87 خ د س(@)(@@)(@@)(@@) | 2658- (@)(@@) عبد الله بن ثعلبة الحضرمي عن عبد الرحمن بن حجيرة وعنه أبو شريح وثق س(@)(@@)(@@)(@@) | 2659- (@)(@@) عبد الله بن جابر عن مجاهد وأبي الشعثاء وعنه الثوري وحكام بن سلم ثقة د ت(@)(@@)(@@)(@@) | 2660- (@)(@@) عبد الله بن جبر بن عتيك أن النبي صلى الله عليه وسلم عاد أباه وعنه ولده عبد الله س ق(@)(@@)(@@)(@@) | 2661- (@)(@@) عبد الله بن أبي الجدعاء له صحبة وهو غير بن أبي الحمساء عنه عبد الله بن شقيق ت ق(@)(@@)(@@)(@@) | 2662- (@)(@@) عبد الله بن الجراح التميمي القهستاني الحافظ عن مالك وشريك وعنه أبو داود وابن ماجة وأبو العباس السراج ثقة مات 237 د ق(@)(@@)(@@)(@@) | 2663- (@)(@@) عبد الله بن جرهد الاسلمي عن أبيه وعنه عبد الله بن محمد بن عقيل مستور ت(@)(@@)(@@)(@@) | 2664- (@)(@@) عبد الله بن أبي الجعد أخو سالم عن ثوبان وغيره وعنه عبد الله بن عيسى وثق س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2665- (@)(@@) عبد الله بن جعفر بن أبي طالب أول من ولد من المهاجرين بالحبشة له صحبة وكان كأبيه في الكرم والسخاء عنه سعد بن إبراهيم وابن عقيل مات سنة ثمانين ع(@)(@@)(@@)(@@) | 2666- (@)(@@) عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة الزهري عن أم بكر وهي عمة أبيه وسعد بن فاطمه، مريم، نرگس، خر وگاو وبى تربيت، عنتر، بى شعور احمق، خوك كثيف إبراهيم وعنه عبد الرحمن بن مهدي والقعنبي صدوق مفت بالمدينة مات 17 م 4(@)(@@)(@@)(@@) | 2667- (@)(@@) عبد الله بن جعفر الرقي عن عبيد 
ms388	 الله بن عمرو وأبي المليح وابن المبارك وعنه الدارمي وأبو شعيب الحراني ثقة حافظ مات 22 ع(@)(@@)(@@)(@@) | 2668- (@)(@@) عبد الله بن جعفر بن نجيح أبو جعفر المديني والد الحافظ علي عن عبد الله بن دينار وزيد بن أسلم وعنه ابنه وقتيبة ضعفوه توفي 178 ت ق(@)(@@)(@@)(@@) | 2669- (@)(@@) عبد الله بن الوزير جعفر بن يحيى البرمكي عن بن عيينة ووكيع وعنه مسلم وأبو داود والفريابي صدوق م د(@)(@@)(@@)(@@) | 2670- (@)(@@) عبد الله بن أبي جعفر الرازي عن أبيه وابن جريج وعنه إبراهيم بن موسى الفراء وزنيج وثق وفيه شئ د(@)(@@)(@@)(@@) | 2671- (@)(@@) عبد الله بن الجهم الرازي عن بن المبارك وجرير وعمرو بن أبي قيس وعنه يوسف بن موسى وجماعة صدوق د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2672- (@)(@@) عبد الله بن حاجب بن عامر بن المنتفق العقيلي عن عمه لقيط وعنه دلهم د(@)(@@)(@@)(@@) | 2673- (@)(@@) عبد الله بن الحارث بن جزء الزبيدي صحابي شهد فتح مصر وكان آخر من تبقى بها من الصحابة عنه يزيد بن أبي حبيب وعبيد الله بن المغيرة مات 86 د ت ق(@)(@@)(@@)(@@) | 2674- (@)(@@) عبد الله بن الحارث المخزومي المكي عن ثور بن يزيد وابن جريج وعنه أحمد وابن راهويه ثقة م 4(@)(@@)(@@)(@@) | 2675- (@)(@@) عبد الله بن الحارث بن نوفل الهاشمي لقبه ببه عن عمر وعثمان وعنه بنوه والزهري وأبو إسحاق مات هاربا من الحجاج 84 ع(@)(@@)(@@)(@@) | 2676- (@)(@@) عبد الله بن الحارث البصري عن عائشة وأبي هريرة وعنه أيوب وخالد الحذاء وثقوه ع(@)(@@)(@@)(@@) | 2677- (@)(@@) عبد الله بن الحارث مصري عن غرفة بن الحارث الكندي وعنه حرملة بن عمران وثق د(@)(@@)(@@)(@@) | 2678- (@)(@@) عبد الله بن الحارث الزبيدي الكوفي المكتب عن بن مسعود وجندب بن عبد الله وعنه عمرو بن مرة وحميد الاعرج وأبو سنان ضرار ثقة م 4(@)(@@)(@@)(@@) | 2679- (@)(@@) عبد الله بن حبشي أبو قتيلة الخثعمي صحابي عنه عبيد بن عمير وسعيد بن محمد بن جبير صحت الرواية إليه د س(@)(@@)(@@)(@@) | 2680- (@)(@@) عبد الله بن حبيب بن أبي ثابت عن أبيه وطاوس وعدة وعنه قبيصة والفريابي وجماعة ثقة م(@)(@@)(@@)(@@) | 2681- (@)(@@) عبد الله بن حبيب بن ربيعة الامام أبو عبد الرحمن 
ms389	 السلمي مقرئ الكوفة عن عمر وعثمان وعنه عاصم بن أبي النجود وأبو إسحاق أقرأ الناس دهرا مات 73 تقريبا ع(@)(@@)(@@)(@@) | 2682- (@)(@@) عبد الله بن حذافة السهمي من السابقين الاوليين عنه أبو وائل وسليمان بن يسار مات زمن عثمان س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2683- (@)(@@) عبد الله بن حسان التميمي العنبري عن حبان بن عاصم العنبري وجدتيه صفية ودحيبة وعنه عفان والحوضي ثقة د ت(@)(@@)(@@)(@@) | 2684- (@)(@@) عبد الله بن حسن بن حسن بن علي بن أبي طالب عن أبيه وأمه فاطمة بنت الحسين وعنه مالك وابن علية ثقة مات 145 قبل مقتل ابنية بأشهر 4(@)(@@)(@@)(@@) | 2685- (@)(@@) عبد الله بن الحسين بن عطاء بن يسار عن صفوان بن سليم وسهيل بن أبي صالح وعنه محمد بن فليح وحاتم بن إسماعيل ضعفه أبو زرعة وهو مقل ق(@)(@@)(@@)(@@) | 2686- (@)(@@) عبد الله بن الحسين الازدي أبو حريز قاضي سجستان عن قيس بن أبي حازم والشعبي وعنه فضيل بن ميسرة وابن أبي عروبة مختلف فيه وقد وثق وقال بن عدي عامة ما يرويه لا يتابعه عليه أحد وجاء عنه أنه يؤمن بالرجعة رجعة علي فالله أعلم 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2687- (@)(@@) عبد الله بن حفص بن عمر بن سعد بن أبي وقاص أبو بكر الزهري المدني عن أبيه وأنس بن مالك وابن عمر وعنه شعبة وأبو غسان محمد بن مطرف وثقه النسائي وهو بكنيته أشهر ع(@)(@@)(@@)(@@) | 2688- (@)(@@) عبد الله بن حفص الارطباني البصري أبو حفص عن ثابت وعاصم الجحدري وعنه حبان بن هلال ونصر بن علي الجهضمي قال أحمد بن حنبل ما أرى به بأسا وأما أبو خيثمة فقال وأحد يسمع حديث الارطباني ت(@)(@@)(@@)(@@) | 2689- (@)(@@) عبد الله بن حفص عن يعلى بن مرة في النهي عن الخلوق للمحرم وعنه عطاء بن السائب فاختلف عليه في الحديث س(@)(@@)(@@)(@@) | 2690- (@)(@@) عبد الله بن الحكم بن أبي زياد القطواني الكوفي عن بن عيينة ووكيع وعنه أبو داود والترمذي وابن ماجة وابن خزيمة ومحمد بن جرير الطبري صدوق مشهور مات بالكوفة سنة 255 د ت ق(@)(@@)(@@)(@@) | 2691- (@)(@@) عبد الله بن حماد الآملي الحافظ أبو عبد الرحمن الاموي 
ms390	 بالفتح من أهل بلد أمو سمع القعنبي وسعيد بن أبي مريم والطبقة فروى البخاري عن عبد الله عن يحيى بن معين فقيل هو هو وقيل هو عبد الله بن أبي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2692- (@)(@@) عبد الله بن حمران الاموي مولاهم البصري عن بن عون وعوف الاعرابي وعدة وعنه بن حنبل والذهلي والكديمي وثق مات 206 م د س(@)(@@)(@@)(@@) | 2693- (@)(@@) عبد الله بن أبي الحمساء العامري صحابي حديثه في انتظاره عليه السلام إلى ثالث يوم روى عنه شقيق والد عبد الله د(@)(@@)(@@)(@@) | 2694- (@)(@@) عبد الله بن حنطب والد المطلب قيل له صحبة عنه ابنه قال الترمذي هذا مرسل يعني حديثه هذان السمع والبصر ت(@)(@@)(@@)(@@) | 2695- (@)(@@) عبد الله بن حنظلة بن أبي عامر الاوسي ولد غسيل الملائكة يوم أحد له حديث عنه بن أبي مليكة وضمضم بن جوس وعباس بن سهل أصيب يوم الحرة في سبعة بنين د(@)(@@)(@@)(@@) | 2696- (@)(@@) عبد الله بن حنين مولى العباس أو علي عن علي وأبي أيوب وعدة وعنه ابنه إبراهيم وخالد بن معدان ونافع وطائفة آخرهم أسامة بن زيد الليثي مات زمن يزيد بن عبد الملك ع(@)(@@)(@@)(@@) | 2697- (@)(@@) عبد الله بن حوالة الازدي صحابي له ثلاثة أحاديث عنه مكحول وربيعة بن يزيد وعدة قال الواقدي مات سنة ثمان وخمسين د(@)(@@)(@@)(@@) | 2698- (@)(@@) عبد الله بن خازم بن أسماء الامير البطل السلمي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2699- (@)(@@) عبد الله بن خالد بن سعيد بن أبي مريم التيمي مولاهم المدني عن أبيه وعنه يحيى بن محمد الجاري ومحمد بن يحيى الكناني د(@)(@@)(@@)(@@) | 2700- (@)(@@) عبد الله بن خباب بن الارت التميمي سبي خباب فبيع بمكة ولاؤه لخزاعة سمع أباه وأبيا وعنه عبد الرحمن بن أبزي الصحابي وعبد الله بن الحارث بن نوفل وجماعة قتلته الحرورية(@)(@@) فقاتلهم علي لذلك ت س(@)(@@)(@@)(@@) | 2701- (@)(@@) عبد الله بن خباب الانصاري مولاهم عن أبي سعيد وعنه بكير بن الاشج وابن إسحاق وعدة وثقه أبو حاتم ع(@)(@@)(@@)(@@) | 2702- (@)(@@) عبد الله بن خبيب الجهني صحابي عنه ابناه معاذ وعبد الله 4(@)(@@)(@@)(@@) | 2703- (@)(@@) عبد الله بن خراش أبو جعفر وأخو شهاب عن عمه العوام بن حوشب وعدة وعنه 
ms391	 بشر بن الحكم والاشج وأحمد بن المقدام ضعفوه قال بن عدي عامة ما يرويه غير محفوظ ق(@)(@@)(@@)(@@) | 2704- (@)(@@) عبد الله بن خليفة ويقال خليفة بن عبد الله عن عبادة بن الصامت وعائذ بن عمرو وعنه بسطام بن مسلم وشعبة س(@)(@@)(@@)(@@) | 2705- (@)(@@) عبد الله بن الخليل أبو الخليل عن عمر بن الخطاب وعلي بن أبي طالب وعنه الشعبي وأبو إسحاق السبيعي والاعمش ثقة 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2706- (@)(@@) عبد الله بن داود الخريبي الامام أبو عبد الرحمن الهمداني الكوفي عن هشام بن عروة والاعمش وثور وطبقتهم وعنه بندار محمد بن بشار ومحمد بن يحيى الذهلي وبشر بن موسى ثقة حجة صالح توفي 213 خ 4(@)(@@)(@@)(@@) | 2707- (@)(@@) عبد الله بن داود الواسطي التمار عن بن جريج والليث وعدة وعنه محمد بن المثنى وهارون بن سليمان الاصبهاني وعدة قال البخاري فيه نظر ومشاه غيره ت(@)(@@)(@@)(@@) | 2708- (@)(@@) عبد الله بن دينار المدني عن مولاه بن عمر وأنس وعدة وعنه موسى بن عقبة ومالك والسفيانان وخلق مات سنة 127 ع(@)(@@)(@@)(@@) | 2709- (@)(@@) عبد الله بن دينار الحمصي عن كثير بن العلاء صاحب لابي هريرة وعن مكحول وعدة وعنه معاوية بن صالح وإسماعيل بن عياش وطائفة قال أبو حاتم الرازي ليس بالقوي ق(@)(@@)(@@)(@@) | 2710- (@)(@@) عبد الله بن ذكوان أبو عبد الرحمن هو الامام أبو الزناد المدني مولى بني أمية وذكوان هو أخو أبي لؤلؤة قاتل عمر رضي الله تعالى عنه عن أنس وعمر بن سلمة ولم يره فيما قيل وسعيد بن المسيب والاعرج وعدة وعنه مالك والليث والسفيانان ثقة ثبت مات فجأة في رمضان سنة(@)(@@) 131 ع(@)(@@)(@@)(@@) | 2711- (@)(@@) عبد الله بن راشد الحميري الزوفي عن عبد الله بن أبي مرة في الوتر وعنه يزيد بن أبي حبيب وخالد بن يزيد د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2712- (@)(@@) عبد الله بن رافع المخزومي مولاهم عن مولاته أم سلمة وأبي هريرة وعنه المقبري ومحمد بن إسحاق وعدة وثقوه م 4(@)(@@)(@@)(@@) | 2713- (@)(@@) عبد الله بن رباح أبو خالد الانصاري عن أبي بن كعب وعمار وطائفة وعنه قتادة وثابت وخالد الحذاء وطائفة وثقوه م 4(@)(@@) *- عبد الله 
ms392	 بن الربيع هو بن محمد سيأتي إن شاء الله س 2952(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2714- (@)(@@) عبد الله بن ربيعة بن يزيد الدمشقي عن أبي إدريس الخولاني وعنه محمد بن سعد وليس ذا بولد للقصير ت(@)(@@)(@@)(@@) | 2715- (@)(@@) عبد الله بن أبي ربيعة المخزومي صحابي ولي الجند للنبي صلى الله عليه وسلم فبقي إلى أن قدم لنصرة عثمان فوقع فمات وقد تسلف منه النبي صلى الله عليه وسلم في نوبة حنين ثلاثين ألفا س ق(@)(@@)(@@)(@@) | 2716- (@)(@@) عبد الله بن ربيعة بن فرقد السلمي مختلف في صحبته وله عن بن مسعود وعدة وعنه عبد الرحمن بن أبي ليلى ونسيبه منصور بن المعتمر د س(@)(@@)(@@)(@@) | 2717- (@)(@@) عبد الله بن رجاء الغداني البصري عن هشام بن أبي عبد الله الدستوائي وشعبة بن الحجاج(@)(@@) PageV00P000(@)(@@) وطائفة وعنه البخاري وأبو مسلم الكجي وأبو خليفة قال أبو حاتم ثقة رضا مات 22 خ س(@)(@@)(@@)(@@) | 2718- (@)(@@) عبد الله بن رجاء المكي عن أيوب السختياني وجعفر بن محمد وعدة وعنه أحمد وإسحاق ويحيى بن معين ووثقه مات قبيل بن عيينة م د س ق(@)(@@)(@@)(@@) | 2719- (@)(@@) عبد الله بن رواحة الانصاري الامير بدري نقيب استشهد بمؤتة عنه أنس بن مالك وابن عباس وأرسل عنه جماعة خ س ق(@)(@@)(@@)(@@) | 2720- (@)(@@) عبد الله بن الزبير بن العوام أبو بكر وأبو خبيب أمير المؤمنين روى عنه أخوه عروة وابنه عامر وخلق وكان نهاية في الشجاعة غاية في العبادة استخلف سنة 64 ومات شهيدا في حصر الحجاج له بالبيت العتيق سنة ثلاث وسبعين ع(@)(@@)(@@)(@@) | 2721- (@)(@@) عبد الله بن الزبير أبو بكر الحميدي القرشي المكي الفقيه أحد الاعلام وصاحب بن عيينة سمع مسلما الزنجي وإبراهيم بن سعد وعبد الله بن المؤمل وعنه البخاري وأبو زرعة وأبو حاتم وخلق قال الفسوي ما لقيت أنصح للاسلام وأهله منه مات 219 خ د ت س(@)(@@)(@@)(@@) | 2722- (@)(@@) عبد الله بن الزبير الباهلي بصري عن ثابت البناني وأيوب وعنه نصر بن علي وجماعة ليس بالحافظ قال أبو حاتم مجهول ق(@)(@@)(@@)(@@) | 2723- (@)(@@) عبد الله بن زرير الغافقي عن عمر وعلي وعنه أبو الخير مرثد بن عبد 
ms393	 الله وبكر بن سوادة وعدة وثق مات سنة إحدى وثمانين د س ق(@)(@@)(@@)(@@) | 2724- (@)(@@) عبد الله بن زغب الايادي عن عبد الله بن حوالة وعنه ضمرة بن حبيب ليس بمشهور د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2725- (@)(@@) عبد الله بن أبي زكريا الخزاعي فقيه الشام عن أم الدرداء ورجاء بن حيوة وأرسل عن سلمان الفارسي والكبار كعادة الشاميين وعنه الاوزاعي وسعيد بن عبد العزيز وعدة قال الاوزاعي لم يكن بالشام رجل يفضل عليه وقال الواقدي كان يعدل بعمر بن عبد العزيز مات 117 د(@)(@@)(@@)(@@) | 2726- (@)(@@) عبد الله بن زمعة بن الاسود القرشي أخو سودة أم المؤمنين كان يأذن على النبي صلى الله عليه وسلم عنه عروة وجماعة ع(@)(@@)(@@)(@@) | 2727- (@)(@@) عبد الله بن زياد بن سمعان المدني الفقيه أحد المتروكين في الحديث عن مجاهد والاعرج وعنه بن وهب وعبد الرزاق وعدة كذبه مالك ق(@)(@@)(@@)(@@) | 2728- (@)(@@) عبد الله بن زياد أبو مريم الاسدي عن علي وابن مسعود وعنه أبو حصين وأشعث بن أبي(@)(@@) الشعثاء خ ت(@)(@@)(@@)(@@) | 2729- (@)(@@) عبد الله بن زياد عن بن جدعان وعنه هريم بن عثمان وآخر ق(@)(@@)(@@)(@@) | 2730- (@)(@@) عبد الله بن زياد عن أبي عبيدة عن أمه وعنه محمد بن بكر البرساني ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2731- (@)(@@) عبد الله بن زيد بن أسلم عن أبيه وعنه عبد الرحمن بن مهدي وقتيبة وعدة وثقه أحمد وضعفه غيره ت س(@)(@@)(@@)(@@) | 2732- (@)(@@) عبد الله بن زيد بن عاصم الانصاري له ولابويه صحبة ولاخيه خبيب الذي قطعه مسيلمة وهم بن عيينة فقال أري الاذان بل ذا حكى الوضوء وعنه سعيد بن المسيب وجماعة قتل يوم الحرة سنة 63 ع(@)(@@)(@@)(@@) | 2733- (@)(@@) عبد الله بن زيد بن ثعلبة بن عبد ربه الانصاري الذي أري الاذان عنه ابنه محمد وابن المسيب أيضا توفي 4 32(@)(@@)(@@)(@@) | 2734- (@)(@@) عبد الله بن زيد أبو قلابة الجرمي من أئمة التابعين حديثه عن عمر وأبي هريرة وعائشة(@)(@@) PageV00P000(@)(@@) ومعاوية وسمرة في سنن النسائي وتلك مراسيل وعن ثابت بن الضحاك ومالك بن الحويرث وأنس وذلك في الصحاح وعنه قتادة ويحيى بن أبي كثير وأيوب وخلق هرب من القضاء فسكن داريا توفي 104 
ms394	 وقيل 107 ع(@)(@@)(@@)(@@) | 2735- (@)(@@) عبد الله بن زيد الازرق عن عقبة بن عامر وعنه أبو سلام ممطور كان قاصا ت ق(@)(@@) *- عبد الله بن زيد أبوبن يزيد عن نيار سيأتي قعبد الله بن زيد أبوبن يزيد عن نيار سيأتي ق 3025(@)(@@)(@@)(@@) | 2736- (@)(@@) عبد الله بن سالم الاشعري الحمصي أبو يوسف عن محمد بن زياد الالهاني والزبيدي وعنه أبو مسهر والهيثم بن خارجة قال يحيى بن حسان ما رأيت بالشام مثله قلت صدوق فيه نصب توفي 179 د س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2737- (@)(@@) عبد الله بن سالم الزبيدي الكوفي القزاز المفلوج عن وكيع وطبقته وعنه أبو داود وابن ماجة وأبو يعلى الموصلي ثقة عابد توفي 235 د ق(@)(@@)(@@)(@@) | 2738- (@)(@@) عبد الله بن السائب بن أبي السائب صيفي بن عابد المخزومي مقرئ مكة له صحبة قرأ على أبي بن كعب روى عنه مجاهد وعطاء توفي قبل بن الزبير م 4(@)(@@)(@@)(@@) | 2739- (@)(@@) عبد الله بن السائب بن يزيد الكندي عن أبيه وعنه بن أبي ذئب ثقة توفي 126 د ت(@)(@@)(@@)(@@) | 2740- (@)(@@) عبد الله بن السائب الكوفي عن عبد الله بن معقل وزاذان وعنه الاعمش والثوري ثقة م س(@)(@@)(@@)(@@) | 2741- (@)(@@) عبد الله بن سخبرة أبو معمر الازدي الكوفي عن علي وعبد الله بن مسعود وعنه إبراهيم النخعي ومجاهد صدوق ع(@)(@@)(@@)(@@) | 2742- (@)(@@) عبد الله بن سخبرة عن أبيه وعنه أبو داود نفيع ت(@)(@@)(@@)(@@) | 2743- (@)(@@) عبد الله بن سراقة عن أبي عبيدة بن الجراح وعنه عبد الله بن شقيق حسن له الترمذي يقال(@)(@@) PageV00P000(@)(@@) له صحبة د ت(@)(@@)(@@)(@@) | 2744- (@)(@@) عبد الله بن سرجس المزني البصري صحابي متأخر عنه قتادة وعاصم الاحول م 4(@)(@@)(@@)(@@) | 2745- (@)(@@) عبد الله بن السري الانطاكي الزاهد صحب شعيب بن حرب وروى عن صالح المري وابن أبي الزناد وعنه عباس الدوري وأحمد بن خليد الحلبي صدوق ق(@)(@@) *- عبد الله بن سعد بن إبراهيم بن سعد قيل إن البخاري روى عنه(@)(@@)(@@)(@@) | 2746- (@)(@@) عبد الله بن سعد بن عثمان الدشتكي نزل الري عن أبيه وهشام بن حسان وعنه ابنه عبد الرحمن ومحمد بن حميد وعمرو بن رافع وثق د ت س 
ms395	(@)(@@)(@@)(@@) | 2747- (@)(@@) عبد الله بن سعد الدمشقي من التابعين يروي عن عبد الرحمن الصنابحي وعن عبادة بن نسي وعنه أبو عمرو الاوزاعي د(@)(@@)(@@)(@@) | 2748- (@)(@@) عبد الله بن سعد الانصاري الحرامي صحابي من أمراء يوم القادسية عنه حرام بن حكيم وخالد بن معدان نزل الشام د ت ق(@)(@@)(@@)(@@) | 2749- (@)(@@) عبد الله بن السعدي العامري صحابي نزل الشام وعنه حويطب بن عبد العزى وابن محيريز(@)(@@) PageV00P000(@)(@@) وأبو إدريس الخولاني توفي 57 خ م د س(@)(@@)(@@)(@@) | 2750- (@)(@@) عبد الله بن سعيد بن جبير عن أبيه وعنه أبو إسحاق وأيوب السختياني كان ثقة خيارا مات شابا خ م ت س(@)(@@)(@@)(@@) | 2751- (@)(@@) عبد الله بن سعيد الحافظ أبو سعيد الكندي الكوفي الاشج عن هشيم والمطلب بن زياد وعنه الستة وابن أبي حاتم قال أبو حاتم ثقة إمام أهل زمانه وقال الشطوي ما رأيت أحفظ منه توفي 257 ع(@)(@@)(@@)(@@) | 2752- (@)(@@) عبد الله بن سعيد المقبري المدني عن أبيه وجده أبي سعيد وعنه أخوه سعد وابن فضيل واه ت ق(@)(@@)(@@)(@@) | 2753- (@)(@@) عبد الله بن سعيد بن عبد الملك بن مروان أبو صفوان الاموي نزيل مكة عن أبيه وثور بن يزيد ومجالد وعنه أحمد وأبو خيثمة ثقة مات بعد المائتين خ م د ت س(@)(@@)(@@)(@@) | 2754- (@)(@@) عبد الله بن سعيد بن أبي هند أبو بكر الفزاري عن أبيه وسعيد بن المسيب وعنه يحيى القطان وابن المبارك ومكي صدوق ع(@)(@@)(@@)(@@) | 2755- (@)(@@) عبد الله بن أبي السفر الهمداني عن أبيه والشعبي وعنه شعبة وسفيان ثقة قديم خ م د س ق(@)(@@)(@@)(@@) | 2756- (@)(@@) عبد الله بن سفيان بن عبد الله الطائفي عن أبيه وعنه يعلى بن عطاء س(@)(@@)(@@)(@@) | 2757- (@)(@@) عبد الله بن سفيان المخزومي عن عبد الله بن السائب وعنه عمر بن عبد العزيز ومحمد بن عباد بن جعفر م د س ق(@)(@@)(@@)(@@) | 2758- (@)(@@) عبد الله بن أبي سفيان مولى بن أبي أحمد عن أبيه وعدي الجذامي وعنه بن إسحاق وإبراهيم بن أبي يحيى وعدة وثق د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2759- (@)(@@) عبد الله بن سلمان عن أبيه الاغر وعنه بن خثيم وصفوان بن سليم وثق م(@)(@@)(@@)(@@) | 2760- (@)(@@) عبد الله بن 
ms396	 سلمة المرادي عن عمر ومعاذ وعبد الله بن مسعود وعنه أبو إسحاق وأبو الزبير(@)(@@) صويلح قال بن عدي أرجو أنه لا بأس به وقال البخاري لا يتابع في حديثه 4(@)(@@)(@@)(@@) | 2761- (@)(@@) عبد الله بن أبي سلمة الماجشون مدني ثقة من موالي آل المنكدر عن عائشة وابن عمر وخلق وعنه ابنه عبد العزيز وابن الهاد ومحمد بن إسحاق توفي 106 م د س(@)(@@)(@@)(@@) | 2762- (@)(@@) عبد الله بن سليط عن أبيه وأم المؤمنين ميمونة وعنه أبو المليح الرقي وغيره س(@)(@@)(@@)(@@) | 2763- (@)(@@) عبد الله بن سليم الرقي عن عبيد الله بن عمرو وأبي المليح وعنه أيوب الوزان ومحمد بن جبلة مات 213 س(@)(@@)(@@)(@@) | 2764- (@)(@@) عبد الله بن سليمان بن جنادة عن أبيه وعنه بشر بن رافع قال البخاري فيه نظر د ت ق(@)(@@)(@@)(@@) | 2765- (@)(@@) عبد الله بن سليمان بن زرعة المعافري عن نافع وكعب بن علقمة وعنه الليث بن سعد وضمام توفي 136 د س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2766- (@)(@@) عبد الله بن سليمان الاسلمي القبائي عن سالم بن عبد الله وغيره وعنه القعنبي وخالد بن مخلد صدوق د ق(@)(@@)(@@)(@@) | 2767- (@)(@@) عبد الله بن سليمان النوفلي عن محمد بن علي والزهري وعنه هشام بن يوسف بس ت(@)(@@)(@@)(@@) | 2768- (@)(@@) عبد الله بن أبي سليمان عن أبي هريرة وجبير بن مطعم وعنه خزرج وهشام بن زياد وحماد بن سلمة شيخ د(@)(@@)(@@)(@@) | 2769- (@)(@@) عبد الله بن سنان المزني صحابي عنه ابنه علقمة بن عبد الله د ت ق(@)(@@)(@@)(@@) | 2770- (@)(@@) عبد الله بن سوادة بن حنظلة القشيري عن أبيه وغيره وعنه إسماعيل بن علية وعبد الوارث ثقة م 4(@)(@@)(@@)(@@) | 2771- (@)(@@) عبد الله بن سوار العنبري البصري القاضي عن أبيه وعبد الله بن بكر السهمي وعنه أبو زرعة وأبو خليفة الجمحي ثقة مات 228 س(@)(@@)(@@)(@@) | 2772- (@)(@@) عبد الله بن سلام الحبر شهد له النبي صلى الله عليه وسلم بالجنة عنه ولده يوسف وأبو سلمة بن عبد الرحمن وأبو بردة توفي 43 ع(@)(@@)(@@)(@@) | 2773- (@)(@@) عبد الله بن شبرمة الضبي قاضي الكوفة وفقيهها عن أنس بن مالك وأبي الطفيل وأبي وائل وعنه عبد الله بن المبارك وعبد 
ms397	 الوارث التنوري وطائفة وثقه أحمد وأبو حاتم توفي 144 خت م د س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2774- (@)(@@) عبد الله بن الشخير العامري صحابي نزل البصرة حدث عنه بنوه مطرف ويزيد وهانئ وهو من بني كعب م 4(@)(@@)(@@)(@@) | 2775- (@)(@@) عبد الله بن شداد بن الهاد الليثي عن أبيه وعمر ومعاذ وعنه منصور والحكم ثقة قتل يوم دجيل 82 ع(@)(@@)(@@)(@@) | 2776- (@)(@@) عبد الله بن شداد المديني الاعرج عن أبي عذرة وعنه حماد بن سلمة والثوري 4(@)(@@)(@@)(@@) | 2777- (@)(@@) عبد الله بن شقيق العقيلي البصري عن عمر وأبي ذر والكبار وعنه قتادة وأيوب قال أحمد ثقة يحمل على علي م 4(@)(@@)(@@)(@@) | 2778- (@)(@@) عبد الله بن شهاب الخولاني عن عمر وعائشة وعنه الشعبي وشبيب بن غرقدة م(@)(@@)(@@)(@@) | 2779- (@)(@@) عبد الله بن شوذب البلخي نزل الشام عن الحسن ومحمد ومكحول وعنه بن المبارك(@)(@@) PageV00P000(@)(@@) وضمرة وثقه جماعة كان إذا رئي ذكرت الملائكة توفي 4 156(@)(@@)(@@)(@@) | 2780- (@)(@@) عبد الله بن صالح أبو صالح الجهني مولاهم المصري كاتب الليث عن معاوية بن صالح وموسى بن علي وعنه البخاري وابن معين وبكر بن سهل وكان صاحب حديث فيه لين قال أبو زرعة حسن الحديث لم يكن ممن يكذب وقال الفضل الشعراني ما رأيته إلا يحدث أو يسبح وقال بن عدي هو عندي مستقيم الحديث له أغاليط وكذبه جزرة عاش ستا وثمانين سنة توفي 223 خ د ت ق(@)(@@)(@@)(@@) | 2781- (@)(@@) عبد الله بن صالح بن مسلم العجلي الكوفي قرأ على حمزة وروى عن أسباط بن نصر وشبيب بن شيبة لم يصح للبخاري عنه شئ وعنه أبو حاتم وإبراهيم الحربي(@)(@@)(@@)(@@) | 2782- (@)(@@) عبد الله بن أبي صالح السمان عن أبيه وسعيد بن جبير وعنه بن أبي ذئب وهشيم مختلف في توثيقه وحديثه حسن م د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2783- (@)(@@) عبد الله بن الصامت عن عمه أبي ذر وعنه أبوعمران الجوني وحميد بن هلال ثقة وقال أبو حاتم يكتب حديثه خت م 4(@)(@@)(@@)(@@) | 2784- (@)(@@) عبد الله بن الصباح البصري العطار عن هشيم ومعتمر وعنه من عدا بن ماجة وابن خزيمة وابن صاعد توفي 25 خ م د ت 
ms398	 س(@)(@@)(@@)(@@) | 2785- (@)(@@) الله عز وجلعبد الله بن صبيح عن بن سيرين وعنه شعبة وأبو هلال قال أبو حاتم شيخ س(@)(@@) *- عبد الله بن أبي صعصعة عن أبيه شيخ لمالك صوابه عبد الرحمن بن عبد الله بن عبد الرحمن خت 3236(@)(@@)(@@)(@@) | 2786- (@)(@@) عبد الله بن صفوان بن أمية أبو صفوان أحد الاشراف عن أبيه وعمر وعنه الزهري وعمرو بن دينار قدم ألفي شاة لمعاوية لما حج قتل مع بن الزبير م س ق(@)(@@)(@@)(@@) | 2787- (@)(@@) عبد الله بن صهبان أبو العنبس الكوفي عن عطية وعنه بن فضيل وجماعة ليس بذاك ت(@)(@@)(@@)(@@) | 2788- (@)(@@) عبد الله بن ضمرة السلولي عن أبي الدرداء وأبي هريرة وعنه مجاهد وأبو الزبير ت ق(@)(@@)(@@)(@@) | 2789- (@)(@@) عبد الله بن طاوس عن أبيه وعكرمة وعنه معمر والسفيانان توفي 132 ع(@)(@@)(@@)(@@) | 2790- (@)(@@) عبد الله بن طريف أبو خزيمة عن عبد الكريم الجزري وربيعة وعنه بن وهب س(@)(@@)(@@)(@@) | 2791- (@)(@@) عبد الله بن أبي طلحة أخو أنس لامه حنكه النبي صلى الله عليه وسلم وسماه سمع أباه وعنه ابناه إسحاق وعبد الله وأبو طوالة ثقة م س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2792- (@)(@@) عبد الله بن ظالم المازني عن سعيد بن زيد وعنه هلال بن يساف وسماك وثق 4(@)(@@)(@@)(@@) | 2793- (@)(@@) عبد الله بن عاصم الحماني عن حماد بن زيد ومحمد بن راشد وعنه تمتام وابن الضريس قال أبو حاتم صدوق ق(@)(@@)(@@)(@@) | 2794- (@)(@@) عبد الله بن عامر بن براد الاشعري أبو عامر الكوفي عن بن إدريس وأبي أسامة وعنه بن(@)(@@) ماجة وأبو يعلى ق(@)(@@)(@@)(@@) | 2795- (@)(@@) عبد الله بن عامر بن ربيعة العنزي المدني له عن النبي صلى الله عليه وسلم وعن عمر وعنه الزهري ويحيى بن سعيد عاش ثمانين سنة مات 85 ع(@)(@@)(@@)(@@) | 2796- (@)(@@) عبد الله بن عامر بن زرارة الحضرمي عن شريك وعلي بن مسهر وعنه مسلم وأبو داود وابن ماجة وأبو يعلى والحسن بن سفيان ثقة توفي 237 م د ق(@)(@@)(@@)(@@) | 2797- (@)(@@) عبد الله بن عامر اليحصبي مقرئ الشام عن فضالة بن عبيد ومعاوية وعنه الزبيدي وعبد الرحمن بن يزيد بن جابر عاش 97 وتوفي 118 م ت(@)(@@)(@@)(@@) | 2798- (@)(@@) عبد الله 
ms399	 بن عامر الاسلمي المدني القارئ عن الاعرج والمقبري وعنه بن وهب وأبو نعيم ضعيف ق(@)(@@)(@@)(@@) | 2799- (@)(@@) عبد الله بن عامر عن الزبير بن العوام وعنه أبو عثمان النهدي لعله العنزي ق(@)(@@) *- عبد الله بن عامر عن عمر وعنه أبو مجلز سعبد الله بن عامر عن عمر وعنه أبو مجلز س 2541(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2800- (@)(@@) عبد الله بن عباس ترجمان القرآن عنه سعيد بن جبير ومجاهد وأبو جمرة الضبعي توفي بالطائف 68 ع(@)(@@)(@@)(@@) | 2801- (@)(@@) عبد الله بن عبد الله بن الاسود الحارثي عن حصين ومجالد وعنه أبو سعيد الاشج وغيره شيخ ت(@)(@@)(@@)(@@) | 2802- (@)(@@) عبد الله بن عبد الله بن الاصم العامري عن عمه يزيد بن الاصم وعنه السفيانان ومروان بن معاوية ثقة م(@)(@@)(@@)(@@) | 2803- (@)(@@) عبد الله بن عبد الله بن أويس الاصبحي أبو أويس عن شرحبيل بن سعد وضمرة بن سعيد والزهري وعنه ابناه أبو بكر وإسماعيل ومنصور بن أبي مزاحم قال بن معين وغيره صالح وليس بذاك توفي 167 م 4(@)(@@)(@@)(@@) | 2804- (@)(@@) عبد الله بن عبد الله بن جابر بن عتيك عن أبيه وابن عمر وعنه شعبة ومالك ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2805- (@)(@@) عبد الله بن عبد الله بن الحارث بن نوفل عن أبيه وابن عباس وعنه الزهري وجماعة توفي 99 خ م د س(@)(@@)(@@)(@@) | 2806- (@)(@@) عبد الله بن عبد الله بن أبي طلحة الانصاري عن أبيه وعمه أنس وعنه سعيد بن عبد الرحمن الجمحي ومحمد بن موسى الفطري ثقة توفي 134 م س(@)(@@)(@@)(@@) | 2807- (@)(@@) عبد الله بن عبد الله بن عثمان بن حكيم بن حزام عن عياض بن عبد الله وغيره وعنه يزيد بن أبي حبيب وابن إسحاق د س(@)(@@)(@@)(@@) | 2808- (@)(@@) عبد الله بن عبد الله بن عمر بن الخطاب عن أبيه وأبي هريرة وعنه الزهري وعبد الرحمن بن القاسم وطائفة صدوق خ م د ت س(@)(@@)(@@)(@@) | 2809- (@)(@@) عبد الله بن عبد الله الرازي قاضي الري عن جابر بن سمرة وعبد الرحمن بن أبي ليلى وعنه الاعمش وفطر ثقة د ت ق(@)(@@)(@@)(@@) | 2810- (@)(@@) عبد الله بن عبد الله الاموي عن بن جريج وعثمان بن الاسود عنه 
ms400	 يعقوب بن كاسب ق(@)(@@)(@@)(@@) | 2811- (@)(@@) عبد الله بن عبد الاسد أبو سلمة المخزومي بن عمة النبي صلى الله عليه وسلم برة بدري توفي بعد وقعة بدر عنه أهله أم سلمة ت ق(@)(@@)(@@)(@@) | 2812- (@)(@@) عبد الله بن عبد الجبار الخبائري أبو القاسم الحمصي عن إسماعيل بن عياش وجميع بن ثوب وعنه محمد بن عوف والفريابي ثقة توفي 235 د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2813- (@)(@@) عبد الله بن عبد الحكم الفقيه أبو محمد المصري عن مالك والليث وعنه بنوه ومقدام الرعيني وثقه أبو زرعة وقال بن واره كان شيخ مصر توفي 214 س(@)(@@)(@@)(@@) | 2814- (@)(@@) عبد الله بن عبد الرحمن بن أبزي الخزاعي مولاهم عن أبيه وعنه منصور وأجلح الكندي وعدة وثق د س(@)(@@)(@@)(@@) | 2815- (@)(@@) عبد الله بن عبد الرحمن بن أزهر المدني عن أبيه وعنه الزهري وجعفر بن ربيعة د(@)(@@)(@@)(@@) | 2816- (@)(@@) عبد الله بن عبد الرحمن بن أبي بكر الصديق عن أبيه وخالته أم سلمة وعنه ابنه طلحة(@)(@@) والقاسم ثقة خ م س ق(@)(@@)(@@)(@@) | 2817- (@)(@@) عبد الله بن عبد الرحمن بن ثابت بن الصامت عن أبيه وعنه إبراهيم بن إسماعيل ق(@)(@@)(@@)(@@) | 2818- (@)(@@) عبد الله بن عبد الرحمن بن الحارث بن أبي ذباب عن أبي هريرة وسهل بن سعد وعنه مجاهد مع تقدمه ومالك ثقة د ت س(@)(@@)(@@)(@@) | 2819- (@)(@@) عبد الله بن عبد الرحمن بن الحباب عن بن أنيس وعنه موسى بن جبير وثق حب ق(@)(@@)(@@)(@@) | 2820- (@)(@@) عبد الله بن عبد الرحمن بن أبي حسين القرشي النوفلي عن أبي الطفيل وأبي بكر بن حزم وعنه شعبة ومالك وأمم ع(@)(@@)(@@)(@@) | 2821- (@)(@@) عبد الله بن عبد الرحمن بن أبي صعصعة المازني عن أبي سعيد وعنه ابناه عبد الرحمن ومحمد ثقة خ د س ق(@)(@@)(@@)(@@) | 2822- (@)(@@) عبد الله بن عبد الرحمن بن الفضل أبو محمد الدارمي الحافظ عالم سمرقند عن يزيد والنضر بن شميل وعنه مسلم وأبو داود والترمذي وعمر البجيري والفريابي قال أبو حاتم هو إمام أهل زمانه ولد 181 ومات 255 م د ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2823- (@)(@@) عبد الله بن عبد الرحمن بن معمر أبو طوالة النجاري قاضي المدينة عن أنس وابن المسيب 