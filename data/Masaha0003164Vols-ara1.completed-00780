ms761	 بالقاهرة 762 ونسب إليه عدة من التصانيف المذكورة.(@)(@)(@@)(@@)(@@) $ إينجو:(@)(@)(@@) -أبو إسحاق اينجو الشيرازي.(@)(@)PageV05P022(@)(@)(@@)(@@)(@@) || «ب»(@)(@)(@@)(@@)(@@) $ بابويه (ابن... ) :(@)(@)(@@) -محمد بن محمد الرازي قطب الدين...(@)(@)(@@)(@@)(@@) $ پادشاه (ابن... ) (1) :(@)(@)(@@) -حيدر بن علي بن حيدر الآملي.(@)(@)(@@)(@@)(@@) $ پادشاه (ابن... ) : -عبد المطلب...(@)(@)(@@)(@@)(@@) $ پادشاه (ابن... ) : -ناصر الدين بن عبد المطلب...(@)(@)(@@)(@@)(@@) $ البحراني: (2) -احمد بن عبد الله بن سعيد بن المتوج.(@)(@)(@@)(@@)(@@) $ البحراني: -احمد بن عبد الله بن محمد بن علي بن الحسن بن المتوج.(@)(@)(@@)(@@)(@@) $ البحراني: -اسماعيل بن ابراهيم بن عطية.(@)(@)(@@)(@@)(@@) $ البحراني: -شهاب...(@)(@)(@@)(@@)(@@) $ البحراني: -عبد الله بن سعيد بن المتوج...(@)(@)(@@)(@@)(@@) $ البحراني: -عبد الله بن محمد بن علي بن الحسن بن المتوج.(@)(@)PageV05P023(@)(@)(@@)(@@)(@@) $ البخاري:(@)(@)(@@) -محمد بن علي الناموسي.(@)(@)(@@)(@@)(@@) $ بدر الدين:(@)(@)(@@) -الحسن بن ايوب.(@)(@)(@@)(@@)(@@) $ بدر الدين: -الحسن بن محمد بن علي بن زهرة.(@)(@)(@@)(@@)(@@) $ بدر الدين: -محمد بن ابراهيم بن محمد بن علي.(@)(@)(@@)(@@)(@@) $ بدر الدين: -محمد بن علي بن حمزة بن علي بن الحسن.(@)(@)(@@)(@@)(@@) $ بدر الدين: -محمود بن محمد بن علي بن يوسف الطبري.(@)(@)(@@)(@@)(@@) $ بدر الدين الناوندي(@)(@)(@@) (-النهاوندي) قال في وصفه تلميذه محمد بن شمس الدين الروبال المؤيدي الآتي بعد قراءته «نهج البلاغة» عليه في 731 ما لفظه:(@)(@)(@@) [ملك الأئمة والعلماء زبدة الأفاضل والفقهاء أفضل من في زمانه في العلم والتقوى وأكمل من في أوانه في الزهد والتقوى وسائر ما به يهتدى وبه الدين يقوى، بدر الدين الناوندي أدام الله نور بدور بركته على رؤوس الخلائق ولا زالت مجامعه مفضلة وفضائله مجموعة موفرة ولا زال كما قيل مصونا من البلوى معافا من الأذى موقا صروف الدهر ما طلع الفجر].(@)(@)(@@) وقد كتب ذلك بخطه التلميذ المذكور بعد إتمام قراءة «نهج البلاغة» على شيخه صاحب الترجمة في مدرسة «فقيه آباد» في يوم الأحد 1-ج 1-731.(@)(@)(@@) والنسخة التي عليها خط محمد بن شمس الدين الروبال المؤيدي كتابتها 682 بخط محمد بن علي بن الحسين بن علي بن اسحاق السرانشاهوري، وقد ظفر بهذه النسخة عبد الباقي بن محمد كاظم الجيلاني الرودسري. واستنسخ عنها نسخة بخط يده في 1091 ثم قابل نسخته مع الأصل وصححها في 1092 ونقل هو في نسخته 
ms762	 هذه: عين ما كان في الأصل على ما مر. ونسخة خط المولى عبد الباقي موجودة عند السيد علي بن محمد الشبر بالنجف، ويأتي في ترجمة محمد بن شمس الدين ما استفاده من حواشي الشيخ الفقيه احمد بن الحسن الناوندي المذكور في (الأنوار: 4) وتعليقاته على «نهج البلاغة» .(@)(@)PageV05P024(@)(@)(@@)(@@)(@@) $ البديع (ابن... ) :(@)(@)(@@) -علي بن محمد البندهي.(@)(@)(@@)(@@)(@@) $ بزرك (مير... ) :(@)(@)(@@) -كمال الدين بن قوام الدين.(@)(@)(@@)(@@)(@@) $ البصري:(@)(@)(@@) -ابراهيم بن محمد...(@)(@)(@@)(@@)(@@) $ البصري: -عامر بن عامر...(@)(@)(@@)(@@)(@@) $ البغدادي:(@)(@)(@@) -احمد بن يوسف بن أبي بكر.(@)(@)(@@)(@@)(@@) $ البغدادي: -الحسن بن علي بن الحسن بن محمد بن عبد الله.(@)(@)(@@)(@@)(@@) $ البغدادي: -سليمان عبد القوي.(@)(@)(@@)(@@)(@@) $ البغدادي: -عبد الرزاق بن احمد بن محمد (ابن الفوطي) .(@)(@)(@@)(@@)(@@) $ البغدادي: -محمد بن الحسن بن محمد بن أبي الرضا.(@)(@)(@@)(@@)(@@) $ أبو بكر التايبادي:(@)(@)(@@) -علي التايبادي.(@)(@)(@@)(@@)(@@) $ البناكتي (1) :(@)(@)(@@) -داود بن محمد بن داود فخر الدين.(@)(@)(@@)(@@)(@@) $ البندهي (2) :(@)(@)(@@) -علي بن محمد...(@)(@)PageV05P025(@)(@)(@@)(@@)(@@) $ البوشنجي (1) :(@)(@)(@@) -علي التايبادي أبو بكر.(@)(@)(@@)(@@)(@@) $ البويهي:(@)(@)(@@) -محمد بن محمد الرازي قطب الدين.(@)(@)(@@)(@@)(@@) $ بهاء الدين:(@)(@)(@@) -داود بن أبي الفتوح.(@)(@)(@@)(@@)(@@) $ بهاء الدين: -علي بن عبد الحميد الحسيني...(@)(@)(@@)(@@)(@@) $ بهاء الدين: -علي بن عبد الكريم بن عبد الحميد...(@)(@)(@@)(@@)(@@) $ بهاء الدين: -علي بن عبد الكريم بن علي بن محمد.(@)(@)(@@)(@@)(@@) $ بهاء الدين: -محمد بن الحسن بن اسفنديار.(@)(@)(@@)(@@)(@@) $ البيابانكي (2) :(@)(@)(@@) -أحمد بن محمد بن أحمد بن محمد...(@)(@)(@@)(@@)(@@) $ البيهقي (3) :(@)(@)(@@) -حيدر بن علي بن محمد بن ابراهيم.(@)(@)(@@)(@@)(@@) $ البيهقي: -محمد بن يوسف بن محمد بن يوسف الوحيدي.(@)(@)PageV05P026(@)(@)(@@)(@@)(@@) || «ت»(@)(@)(@@)(@@)(@@) $ تاج الدين:(@)(@)(@@) -ابو سعيد بن الحسين بن محمد بن أحمد.(@)(@)(@@)(@@)(@@) $ تاج الدين: -ابو الفتح بن حسين بن أبي بكر.(@)(@)(@@)(@@)(@@) $ تاج الدين: -الحسن بن الحسين السرابشنوي.(@)(@)(@@)(@@)(@@) $ تاج الدين: -الحسن بن راشد.(@)(@)(@@)(@@)(@@) $ تاج الدين: -عبد علي بن نجدة.(@)(@)(@@)(@@)(@@) $ تاج الدين: -علي عبد الله بن أبي الحسن بن أبي بكر.(@)(@)(@@)(@@)(@@) $ تاج الدين: -علي الحسن بن علي الطبري.(@)(@)(@@)(@@)(@@) $ تاج الدين: -محمد بن الحسين بن علي بن زيد الاوهجي.(@)(@)(@@)(@@)(@@) $ تاج الدين: -محمد علي بن عيسى.(@)(@)(@@)(@@)(@@) $ تاج الدين: -محمد بن القاسم بن الحسين بن القاسم.(@)(@)(@@)(@@)(@@) $ تاج الدين: -محمد بن محفوظ بن وشاح.(@)(@)(@@)(@@)(@@) $ تاج الدين: -محمود بن محمد بن عبد الواحد الرازي.(@)(@)(@@)(@@)(@@) $ تاج الدين: -المرتضى..(@)(@)(@@)(@@)(@@) $ تاج 
ms763	 الدين: -نصرة بن صادق بن المجتبى.(@)(@)PageV05P027(@)(@)(@@)(@@)(@@) $ التايبادي (1) :(@)(@)(@@) -علي...(@)(@)(@@)(@@)(@@) $ التبريزي (2) :(@)(@)(@@) -الحسن بن علي بن الحسن بن محمد بن عبد الله.(@)(@)(@@)(@@)(@@) $ التبريزي: -الحسن بن محمد الراعي.(@)(@)(@@)(@@)(@@) $ التبريزي: -علي بن عبد الله بن أبي الحسن بن أبي بكر.(@)(@)(@@)(@@)(@@) $ تركه:(@)(@)(@@) محمد بن حبيب الله.(@)(@)(@@)(@@)(@@) $ تقي الدين:(@)(@)(@@) -ابراهيم بن الحسين بن علي.(@)(@)(@@)(@@)(@@) $ تقي الدين: -ابراهيم بن محمد البصري.(@)(@)(@@)(@@)(@@) $ تقي الدين: -ابراهيم بن محمد بن سالم.(@)(@)(@@)(@@)(@@) $ تقي الدين: -الحسن بن علي بن داود.(@)(@)(@@)(@@)(@@) $ تقي الدين: -الحسن بن نجم الدين العلوي العبيدلي.(@)(@)PageV05P028(@)(@)(@@)(@@)(@@) || «ج»(@)(@)(@@)(@@)(@@) $ الجباعي (الجبعي) (1) :(@)(@)(@@) -صالح بن شرف العاملي.(@)(@)(@@)(@@)(@@) $ الجرجاني (2) :(@)(@)(@@) -ابو المحاسن...(@)(@)(@@)(@@)(@@) $ الجرجاني: -سعيد بن جعفر بن رستم...(@)(@)(@@)(@@)(@@) $ الجرجاني: -علي...(@)(@)(@@)(@@)(@@) $ الجرجاني: -محمد بن علي بن محمد...(@)(@)(@@)(@@)(@@) $ الجزائري:(@)(@)(@@) -ناصر الدين بن عبد المطلب بن پادشاه.(@)(@)(@@)(@@)(@@) $ الجزري (3) :(@)(@)(@@) -عبد المطلب بن پادشاه.(@)(@)PageV05P029(@)(@)(@@)(@@)(@@) $ الجزيري (1) :(@)(@)(@@) -عبد الرحمان بن علي بن أبي الحسن.(@)(@)(@@)(@@)(@@) $ الجزيني:(@)(@)(@@) -محمد بن مكي بن محمد بن حامد الشهيد.(@)(@)(@@)(@@)(@@) $ جعفر بن علي بن صاحب دار الصخر.(@)(@)(@@) جلال الدين الحسيني من مشايخ تاج الدين بن معية الديباجي (م 776) قال في اجازته للشهيد، كما نقل عنه في «إجازة صاحب المعالم» (ذ 1: 172) عن خط المجيز، هكذا:(@)(@)(@@) السيد الجليل السعيد جلال الدين جعفر بن صاحب دار الصخر الحسيني. وكذا في (الأمل 2: 52) . وفي أوائل «عوالي اللآلي» ذكر حديث المعمر السنبسي بأسناد أحمد بن فهد الحلي عن السيد جلال الدين عبد الله بن شرفشاه عن الشيخ نصير الدين علي بن محمد بن علي القاشي عن السيد جلال الدين بن دار الصخر عن نجم الدين أبي القاسم جعفر بن سعيد إلى آخر السند. أقول:(@)(@)(@@) توفي نصير الدين القاشي الراوي عن صاحب الترجمة 755. وجاء في اجازة تاج الدين بن معية لشمس الدين أبي المعالي الموسوي: السيد علاء الدين جعفر ابن علي بن صاحب دار الصحة (كذا) .(@)(@)(@@)(@@)(@@) $ جعفر بن علي بن يوسف بن عروة.(@)(@)(@@) الشيخ الأمين زين الدين الحلي من مشايخ تاج الدين محمد بن القاسم بن معية الديباجي (م 776) كما صرح به في اجازته للشهيد المنقولة في «اجازة صاحب المعالم» (ذ 1: 172) و«الأمل 2: 53» وجاء في نسخة من اجازته لشمس 
ms764	 الدين محمد بن أحمد ابن أبي المعالي الموسوي: جعفر بن علي بن عرفة وليس بصحيح. وليس هو أخا السيد احمد بن علي بن عرفة المذكور في (ص 8-9) الموصوف بالسيد في تلك الإجازة ولعل التعبير بالشيخ زين الدين في الاجازة لدفع توهم السيادة.(@)(@)PageV05P030(@)(@)(@@)(@@)(@@) $ جعفر بن محمد بن عدنان.(@)(@)(@@) نقيب الأشراف امين الدين بن شيخ الشيعة محيي الدين الحسيني قال ابن كثير في حوادث سنة 711 من «البداية والنهاية» :(@)(@)(@@) وفي يوم الأربعاء 17-ع 1 ولي الشريف نقيب الأشراف أمين الدين جعفر بن محمد بن محيي الدين عدنان، نظر الدواوين عوضا عن شهاب الدين الواسطي.(@)(@)(@@) وقال في «الشذرات» : توفي في حياة أبيه في 714 فولي النقابة بعده ولده شرف الدين عدنان وخلع عليه بطرحة وهو شاب طري. حكى هذه الترجمة في «شذرات الذهب-6: 33» عن كتاب «العبر» لشمس الدين محمد بن أحمد الذهبي (م 748) . ويأتي ترجمة حسن بن محمد بن عدنان، وعدنان بن جعفر بن محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ الجعفري:(@)(@)(@@) -مهنا بن سنان بن عبد الوهاب.(@)(@)(@@)(@@)(@@) $ جلال الدين:(@)(@)(@@) -ابراهيم بن عبد المطلب بن علي.(@)(@)(@@)(@@)(@@) $ جلال الدين: -احمد بن أبي علي.(@)(@)(@@)(@@)(@@) $ جلال الدين: -جعفر بن علي بن صاحب دار الصخر.(@)(@)(@@)(@@)(@@) $ جلال الدين: -الحسن بن احمد بن محمد بن جعفر.(@)(@)(@@)(@@)(@@) $ جلال الدين: -الحسن بن نما.(@)(@)(@@)(@@)(@@) $ جلال الدين: -عبد الله بن حرام.(@)(@)(@@)(@@)(@@) $ جلال الدين: -عبد الله بن شرفشاه.(@)(@)(@@)(@@)(@@) $ جلال الدين: -القاسم بن الحسين بن القاسم.(@)(@)(@@)(@@)(@@) $ جلال الدين: -محمد بن محمد بن احمد الكوفي.(@)(@)PageV05P031(@)(@)(@@)(@@)(@@) $ الجلدكي:(@)(@)(@@) -ايدمر بن علي...(@)(@)(@@)(@@)(@@) $ جليل بن اسماعيل.(@)(@)(@@) من الشيوخ العلماء الذين أدركهم الشهيد وكتب بخطه تواريخ وفياتهم ضمن تواريخ جملة من مشايخه، فذكر أنه توفي الشيخ جليل بن اسماعيل 13-ع 1-747. وعن خطه نقل الجبعي في مجموعته كما جاء في «البحار» .(@)(@)(@@)(@@)(@@) $ جمال الدين:(@)(@)(@@) -أحمد بن ابراهيم بن الحسين الكرواني.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن بلكو.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن الحسين الواهاني.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن عبد الله بن محمد بن علي بن الحسن بن المتوج.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن علي بن محمد بن أحمد بن 
ms765	 علي الأعرج.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن محمد بن أحمد الكاموني.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن محمد بن الحداد.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أحمد بن محمد بن أبي عبد الله.(@)(@)(@@)(@@)(@@) $ جمال الدين: -أبو اسحاق اينجو.(@)(@)(@@)(@@)(@@) $ جمال الدين: -اسكندر الاسترابادي.(@)(@)(@@)(@@)(@@) $ جمال الدين: -الحسن بن يوسف بن علي بن محمد بن المطهر.(@)(@)(@@)(@@)(@@) $ جمال الدين: -عبد الله بن محمد بن أحمد بن الحسين.(@)(@)(@@)(@@)(@@) $ جمال الدين: -عبد الله بن محمد الحسيني العريضي.(@)(@)(@@)(@@)(@@) $ جمال الدين: -علي بن الحسين بن حماد الليثي كمال الدين.(@)(@)(@@)(@@)(@@) $ جمال الدين: -علي بن يحيى بن حماد.(@)(@)(@@)(@@)(@@) $ جمال الدين: -محمد بن عبد المطلب بن محمد بن علي.(@)(@)PageV05P032(@)(@)(@@)(@@)(@@) $ جمال الدين: -مكي بن محمد بن حامد بن أحمد.(@)(@)(@@)(@@)(@@) $ جمال الدين: -ياقوت المستعصمي.(@)(@)(@@)(@@)(@@) $ جمال الدين: -يوسف بن ناصر بن محمد بن حماد.(@)(@)(@@)(@@)(@@) $ جمال الدين بن حماد.(@)(@)(@@) جاء في «البحار» عن مجموعة شمس الدين الجبعي نقلا عن خط الشهيد أنه توفي الشيخ العلامة جمال الدين بن حماد 727.(@)(@)(@@) أقوله: لعله علي بن يحيى بن حماد من مشايخ تاج الدين بن معية استاذ الشهيد (م 776) . كما يأتي.(@)(@)(@@)(@@)(@@) $ الجويني (1) :(@)(@)(@@) -ابراهيم بن محمد بن محمد بن حمويه.(@)(@)PageV05P033(@)(@)(@@)(@@)(@@) || «ح»(@)(@)(@@)(@@)(@@) $ الحائري (1) :(@)(@)(@@) -إبراهيم بن سيبي.(@)(@)(@@)(@@)(@@) $ الحائري: -علي بن الحسن...(@)(@)(@@)(@@)(@@) $ الحائري: -علي بن الحسن بن محمد الخازن.(@)(@)(@@)(@@)(@@) $ الحائري: -علي بن خازن...(@)(@)(@@)(@@)(@@) $ الحائري: -علي بن عبد الجليل...(@)(@)(@@)(@@)(@@) $ الحائري: -محمد بن محمد بن احمد الكوفي.(@)(@)(@@)(@@)(@@) $ الحاجى-الحاج:(@)(@)(@@) -حيدر بن علي بن محمد بن إبراهيم.(@)(@)(@@)(@@)(@@) $ الحاجى-الحاج: -علي بن الحسن بن احمد بن مظاهر.(@)(@)(@@)(@@)(@@) $ الحاجى-الحاج: -محمود نظام الدين.(@)(@)(@@)(@@)(@@) $ الحافظ:(@)(@)(@@) -الحسن بن علي بن الحسن بن محمد بن عبد الله.(@)(@)(@@)(@@)(@@) $ الحافظ: -عبد الرزاق بن احمد بن محمد (ابن الفوطي) .(@)(@)(@@)(@@)(@@) $ الحافظ: -علي بن محمد بن علي الطبري.(@)(@)(@@)(@@)(@@) $ الحافظ: -محمد... الشيرازي.(@)(@)PageV05P034(@)(@)(@@)(@@)(@@) $ أبو حامد بن أحمد.(@)(@)(@@) لعله الشيخ أبو حامد من تلاميذ العلامة الحلي الذي كتب بخطه «غاية السؤل وإيضاح السبل في شرح منتهى السؤل والأمل» للحلي في حياته 711. والنسخة موجودة في (الرضوية) من وقف السيد محمد الرضوي في 925.(@)(@)(@@)(@@)(@@) $ الحجة (ابن... ) (الحاجة. الخواجة) :(@)(@)(@@) -صالح بن شرف العاملي.(@)(@)(@@)(@@)(@@) $ الحداد الحلي (ابن... ) :(@)(@)(@@) -احمد بن محمد بن الحداد.(@)(@)(@@)(@@)(@@) $ الحداد الحلي 
ms766	 (ابن... ) : -موسى بن جعفر بن عيسى بن مبارك الحداد.(@)(@)(@@)(@@)(@@) $ حديد (ابن... ) :(@)(@)(@@) -محمد بن الحسين بن حديد.(@)(@)(@@)(@@)(@@) $ الحراني (1) :(@)(@)(@@) -علي بن محمد بن علي بن محمد.(@)(@)(@@)(@@)(@@) $ الحسام (ابن... ) :(@)(@)(@@) -الحسن بن محمد بن ابراهيم...(@)(@)(@@)(@@)(@@) $ الحسام (ابن... ) : -محمد بن ابراهيم...(@)(@)(@@)(@@)(@@) $ الحسن.(@)(@)(@@) الشيخ الصالح أبو محمد الحسن، صاحب كتاب «المعراج»(@)(@)PageV05P035(@) المذكور في (ذ 21: 225) نقل عنه حسن بن سليمان الحلي (م بعد 802) في كتاب «المختصر» بهذه الأوصاف. جملة من الأحاديث باسناد المؤلف إلى الصدوق (م 381) وهو عن مشايخه ومنهم الحسن بن متيل القمي، لا أن صاحب «المعراج» يروي عن الحسن بن متيل بلا واسطة كما فهمه صاحب «الرياض» ونقل المجلسي في باب المعراج من سادس «البحار» بعض تلك الأحاديث. فالظاهر أنه من هذه المائة أو قبله بقليل، أي أواخر السابعة.(@)(@)(@@)(@@)(@@) $ الحسن بن احمد بن محمد بن جعفر بن هبة الله بن نما.(@)(@)(@@) هو الشيخ جلال الدين أبو محمد الحسن بن نظام الدين بن نجيب الدين أبي ابراهيم محمد بن جعفر بن الرئيس العفيف أبي البقاء هبة الله بن نما بن علي بن حمدون الربعي ولاء الحلي أصلا. هو من مشايخ الشهيد محمد بن مكي (م 786) يروي عنه بلا واسطة في ع 2-752 كما في بعض أسانيد «الأربعين» وكما صرح به الشهيد الثاني في «شرح الدراية» ومثل به للرواية عن أربعة آباء لأنه يروي عن أبيه أحمد عن أبيه نجيب الدين محمد عن أبيه جعفر عن أبيه أبي البقاء عن الحسين بن طحال عن أبي علي بن الطوسي عن الطوسي وفي «اجازة الشهيد للحسين بن عبد الصمد» انه يروي صاحب الترجمة عن نجيب الدين يحيى بن سعيد كما في بعض أسانيد «الأربعين» للشهيد أيضا وتوفي يحيى بن سعيد 690 (انوار:(@)(@)(@@) 204) . هذا وقد ذكر والد المترجم له في (انوار: 8-9) وعمه فيها (ص 31) وجداه ابن نما في (الثقا: 45 و334) .(@)(@)(@@)(@@)(@@) $ الحسن بن أحمد بن مظاهر الحلي.(@)(@)(@@) الشيخ عز الدين الحلي. والد الشيخ زين الدين علي بن الحسن، المجاز من فخر المحققين في 741 و755.(@)(@)(@@) وصفه الفخر في «الإجازة 
ms767	 الثانية» لولده زين الدين علي المذكور، بالشيخ الإمام الفقيه العالم السعيد عز الدين حسن بن مظاهر، وفي الإجازة الأولى التي كتبها على نسخة «القواعد» والمؤرخة 741 وصفه بالفقيه العالم السعيد(@)(@)PageV05P036(@) المرحوم عز الدين حسن بن أحمد بن مظاهر. ومنه يظهر وفاته في التاريخ.(@)(@)(@@) ويأتي ولده علي مؤلف «المسائل المظاهرية» أو «الحواشي الفخرية» .(@)(@)(@@)(@@)(@@) $ الحسن بن اسحاق بن ابراهيم(@)(@)(@@) بن عباس الموصلي. هو ثامن الاثني عشر الذين قرأوا على علي بن عيسى الأربلي كتابه «كشف الغمة» في 691 وذكر تفاصيله مجد الدين فضل بن يحيى الطيبي فيما كتبه بخطه على نسخة من «كشف الغمة» مقروة على المؤلف وذكر اسماء الاثني عشر السامعين عنه، وذكر أن صاحب الترجمة سمع جميع الكتاب. راجع (ذ 1: 218-219 و18: 48) وراجع احمد بن محمد بن علي الاربلي في ص 12.(@)(@)(@@)(@@)(@@) $ الحسن ابن ابن الأكرم الحسيني.(@)(@)(@@) كتب بخطه الانهاء في 757 على نسخة «الشرائع» التي بخط محمد بن اسماعيل الهرقلي لتلميذه الذي قرأه عليه.(@)(@)(@@) وليس فيه اسم المجاز ولا يقرؤ اسم والده الموجود بين كلمتي الحسن والأكرم فراجعه. وقد انتقلت النسخة إلى السيد ضياء شكارة أوان كونه قائمقام النجف.(@)(@)(@@)(@@)(@@) $ الحسن بن أيوب.(@)(@)(@@) بدر الدين (أو عز الدين او فخر الدين) الشهير بابن نجم الدين الاطراوي العاملي، الراوي عن عميد الدين عبد المطلب الأعرجي الحسيني (م 754) وعن أخيه الأصغر منه ضياء الدين عبد الله وعن فخر المحققين ابن الحلي (م 771) وعن الشيخ الشهيد 786. ويروي عنه شمس الدين محمد العريضي العاملي، وجعفر بن الحسام العيناثي كما يظهر من «إجازة ابن خاتون لحسين بن شدقم» (ذ 1: 258) . وبعض إجازات شرف الدين علي الشولستاني و«إجازة حسين النيسابوري لنوروز علي التبريزي» . وما جاء في «إجازة الشهيد الثاني» من توصيف ابن نجم الدين بالأعرجي الحسيني بدل الاطراوي العاملي فهو من إسقاط الناسخ الواسطة (ما بين نجم الدين إلى عبد المطلب) فيما مر من الترجمة. ثم تبع الشيخ الحر في «الأمل 2: 63» الشهيد فوصفه(@)(@)PageV05P037(@) بالاعرجي الحسيني، فظنه حليا وذكره في القسم الثاني الخاص بغير العامليين، مع أن الرجل من 
ms768	 قرية اطري من قرى جبل عامل. وتنبه للاسقاط صاحب «الرياض» . و«مسائل ابن نجم» موجودة (ذ 20: 331 و333) .(@)(@)(@@) ويروي الشهيد الثاني عن حفيد صاحب الترجمة وهو الحسن بن جعفر بن فخر الدين الحسن بن ايوب.(@)(@)(@@)(@@)(@@) $ الحسن بن ابي الحسن بن محمد.(@)(@)(@@) ابو محمد الديلمي صاحب «ارشاد القلوب» (ذ 1: 517) و«غرر الأخبار» و«أعلام الدين» المذكورين أيضا في الذريعة. قال في «الغرر» بعد ذكر ما جرى على المسلمين من حكومة بني أمية ثم بني العباس: ان اختلاف ملوك المسلمين ضعفهم وقوى الكفار...(@)(@)(@@) فللكفار اليوم دون المائة سنة قد أباحوا المسلمين قتلا ونهبا. وبما انه بعيد عن الصليبيين فيظهر أنه يقصد سقوط بغداد بيد المغول في 656 وينقل في «الارشاد» عن «الألفين» للعلامة الحلي (م 726) وعن «مجموعة ورام» .(@)(@)(@@) وعنوانه في «الرياض» بابي محمد الحسن بن أبي الحسن بن محمد، مصرحا بأن محمدا جده. ولكن في «الأمل» و«البحار» : الحسن بن محمد الديلمي.(@)(@)(@@) وبالجملة هو غير الحسن بن أبي الحسن الديلمي المفسر الذي نقل الكراجكي (م 449) عن تفسيره في «كنز الفوائد» .(@)(@)(@@)(@@)(@@) $ الحسن بن الحسين بن الحسن.(@)(@)(@@) تاج الدين السرابشنوي الكاشاني مولدا ومسكنا، من تلاميذ العلامة الحلي كما صرح به فيما كتبه من الاجازة لولده زين الدين علي بن تاج الدين الحسن، في ظهر «القواعد» للعلامة الحلي في 20-ع 1-763 كتبها له بكاشان (ذ 1: 170-171) وكتب أيضا إجازة لبعض تلاميذه في الحلة زمن كونه بها في 19 ذي الحجة 728. وقد مزق بعض الألفاظ منها، فلا يقرؤ من ألقاب المجاز إلا المولى المعظم ملك الصلحاء سيد الزهاد والعباد فيظهر أن اجازته لولده كانت في أواخر عمره في كاشان والاجازة الاولى في الحلة بعد وفاة شيخه العلامة الحلي بأقل من(@)(@)PageV05P038(@) سنتين. وهذه الاجازة كتبها بخطه على ظهر «نهج البلاغة» الذي كثبه السيد نجم الدين ابو عبد الله الحسين بن اردشير بن محمد الطبري في 677 و667 والنسخة عند (السماوي) بالنجف. وفي هذه الإجازة كتب «سراوشنوى» بدل «سرابشنوي» . والشيخ محمد بن أبي جمهور في اول «الغوالي» وكذلك السيد عطاء الله بن 
ms769	 اسحاق (ذ 1: 170-171) عبرا عن ولده المجاز منه بشرف الدين علي. لكن والده في الإجازة لقبه بزين الدين. وقال صاحب «الرياض» رأيت إجازة العلامة الحلي لصاحب الترجمة (ذ 1: 177) بخطه على ظهر (... ) وفي النسخة بياض فكأنه ما وفق لنقل صورة الإجازة. ويأتي الحسن بن محمد السرابشنوي المجاز من الحلي أيضا.(@)(@)(@@)(@@)(@@) $ الحسن بن الحسين بن الحسن بن معانق.(@)(@)(@@) قال في «الرياض» : شيخ فاضل عالم فقيه كان من تلاميذ العلامة الحلي. رأيت نسخة من «خلاصة الأقوال» بخط هذا الشيخ كتابتها 707 في حياة أستاذه المؤلف. انتهى.(@)(@)(@@)(@@)(@@) $ الحسن بن الحسين.(@)(@)(@@) أبو سعيد المعبر عن نفسه في جملة من تصانيفه بالحسن الشيعي السبزواري. كان معاصر فخر المحققين بن الحلي. قال صاحب «الرياض» : رأيت بخطه «تكملة السعادات في كيفية العبادات» الفارسي تأليف ابي المحاصن الجرجاني وقد فرغ من تأليفه 702 كتبه صاحب الترجمة بخطه في 747. ثم ذكر ما رآه من تصانيفه منها «راحة الأرواح ومونس الأشباح» الذي فرغ من تأليفه 753 باسم السلطان نظام الدين يحيى (ذ 10: 55) و«بهجة المباهج» (ذ 3: 163) و«مصابيح القلوب» (ذ 21: 90) و«غاية المرام» (ذ 16: 21) و«ترجمة كشف الغمة» (ذ 4: 130) .(@)(@)(@@)(@@)(@@) $ الحسن بن حمزة الهاشمي.(@)(@)(@@) قال في «الرياض» كان من أجلة علمائنا.(@)(@)(@@) وينقل عنه السيد حيدر الآملي في «الكشكول فيما جرى على آل الرسول» الذي ألفه 735 وظني أنه من مشايخه ويروي عنه بلا واسطة انتهى.(@)(@)PageV05P039(@)(@)(@@)(@@)(@@) $ الحسن بن داود الرجالي:(@)(@)(@@) الحسن بن علي بن داود.(@)(@)(@@)(@@)(@@) $ الحسن بن راشد.(@)(@)(@@) العالم الفاضل الجليل تاج الدين الحلي من طبقة تلاميذ العلامة الحلي والمعاصر للشيخ محمد بن علي بن محمد الجرجاني الغروي تلميذ العلامة الحلي وشارح كتابه «مبادي الوصول» . قال في «الرياض» :(@)(@)(@@) [رأيت مجموعة من مؤلفات هذا الفاضل الجرجاني المذكور وكانت كلها بخط المؤلف وفيها قصيدة في مدح أمير المؤمنين (ع) من منظومات الشيخ حسن بن راشد هذا، وقد كتب في صدر القصيدة بهذه العبارة: للمولى الشيخ الإمام الأعظم البحر الهمام الأعلم جامع فضيلتي المعقول والمنقول مستخرج مسائل الفروع من الأصول، شيخ مشايخ الفقهاء المجتهدين وخاتمهم ورئيس الأئمة المتكلمين وعالمهم مولانا 
ms770	 تاج الملة والحق والدين الحسن بن راشد اسبغ الله تعالى عليه ظلاله وأدام عليه فضله وفضائله موشحا نسيبا. وفي أخره يمدح أمير المؤمنين (ع) ]انتهى عنوان القصيدة كما كتبه الجرجاني بخطه ونقله عن خطه في «الرياض» ويظهر جلالة قدر الرجل من الأوصاف التي وصفه بها في حال حياته معاصره الجليل الذي هو في غاية الجلالة. كما يأتي في المائة التاسعة الحسن بن راشد الحلي أو البحراني الذي هو من تلاميذ الفاضل المقداد، وله «الجمانة البهية» في نظم ألفية الشهيد، وهو غير صاحب الترجمة ومتأخر عنه جزما ومعاصر لابن فهد الذي توفي 841. ولعله صاحب القصيدة الطويلة في مدح صاحب الزمان (ع) التي شرحها المولى علي بن عبد الله العلياري التبريزي (م 1327) وسمى الشرح «رياض المقاصد في شرح قصيدة حسن بن راشد» كما ذكره ميرزا حسن ولد الشارح العلياري وقال إن للقصيدة خاتمة فيها أحوال الناظم فليرجع إليها. ولهذه القصيدة شرح آخر اسمه «غرر الفوائد في شرح قصيدة حسن بن راشد» للشيخ حسن بن محمد حسين بن عبد المطلب التبريزي المولود 1306.(@)(@)(@@)(@@)(@@) $ الحسن بن سليمان بن محمد عز الدين أبو محمد الحلي العاملي.(@)(@)(@@) هو ثاني(@)(@)PageV05P040(@) الستة المجازين باجازة واحدة من الشهيد محمد بن مكي تاريخها 12 شعبان 757 (ذ 1: 247) . وقد مر أول المجازين أحمد بن ابراهيم بن الحسين الكرواني في (ص 4) . ويأتي ثالثهم الحسين بن علي عز الدين.(@)(@)(@@)(@@)(@@) $ الحسن السمناني(@)(@)(@@) ، الشيخ عز الدين. قال في «الرياض» إنه كان من أجلة العلماء المقاربين لعهد العلامة الحلي (م 726) . نقل ذلك عن «رجال النيلي» وهو لعلي بن عبد الكريم بن عبد الحميد الذي تممه جمال الدين ابن الأعرج (ذ: 10: 157) .(@)(@)(@@)(@@)(@@) $ الحسن بن شرفشاه:(@)(@)(@@) الحسن بن محمد بن شرفشاه.(@)(@)(@@)(@@)(@@) $ الحسن بن عبد الله بن محمد بن علي.(@)(@)(@@) رضي الدين أبو سعيد ابن ضياء الدين ابن أبي الفوارس الأعرج الحسيني، من مشايخ زين الدين علي بن الحسن ابن محمد الأسترابادي (م حدود 838) . كان والده السيد ضياء الدين عبد الله ابن أخت العلامة الحلي، وقد وصفه في أول «الغوالي» بالسيد 
ms771	 المرتضى الأعظم والامام المعظم سلالة آل طه وياسين أبي سعيد الحسن الخ. وذكر أنه يروي عن فخر المحققين عن والد الحلي. ويأتي أخوه عبد الوهاب في التاسعة.(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن إبراهيم المزيدي(@)(@)(@@) من تلاميذ العلامة الحلي. وقد كتب من تصانيف أستاذه في حياته «تسليك النفس إلى حظيرة الأنس» في الكلام في 707 وعلى النسخة خطوط المؤلف الحلي وهي موجودة في (الغروية) تاريخها زوال الثلاثاء 16 شوال 707 مصرحا بأنه كتبه لنفسه.(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن الحسن بن زهرة الحلبي.(@)(@)(@@) قال العسقلاني إنه كان نقيب الأشراف بحلب واثنى عليه ابن حبيب ومات 711 وقد جاوز السبعين،(@)(@)PageV05P041(@) وهو أخو حمزة والد علاء الدين. انتهى ما في «الدرر الكامنة 2: 104» وعنه نقل في «الرياض» . أقول: هو غير علاء الدين المجاز من العلامة الحلي بل هو علاء الدين بن علي بن حمزة (م 755) كما سيأتي.(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن الحسن الطبري.(@)(@)(@@) الشيخ نجم الدين بن شمس الدين.(@)(@)(@@) هو والد ضياء الدين هارون الآتي الذي أجازه العلامة الحلي في 701 وقال في إجازته بعد ذكر ضياء الدين هارون: إنه ابن المولى الإمام العالم الفاضل الزاهد العابد الورع شيخ الطائفة ركن الإسلام وعماد المؤمنين نجم الدين الحسن ابن السعيد شمس الدين علي بن الحسن الطبري ويظهر أنه كان حيا في تاريخ الاجازة. أقول: مر في «الأنوار: 41» عماد الدين الحسن بن علي صاحب «كامل البهائي» و«أسرار الأئمة» الذي ألفه في كبره وضعف بصره في 698 ولعله صاحب الترجمة وقد بقي إلى زمن تاريخ إجازة العلامة لولده في 701 وان كان بعيدا وخاصة مع فرض صحة تاريخ سماعه في 603 عن مفت يزيدي باصفهان، كما ذكرناه في (ذ 17: 253) .(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن الحسن بن محمد بن عبد الله.(@)(@)(@@) الشيخ الحافظ أبو علي التبريزي البغدادي. قرىء عليه «الغيبة» للنعماني في 720 فكتب هو القراءة على ظهر النسخة الموجودة في (الرضوية) .(@)(@)(@@)(@@)(@@) $ الحسن بن علي الخانقاهي.(@)(@)(@@) العالم الفاضل معاصر الشهيد. كتب بخطه «تحرير القواعد» للعلامة الحلي الذي ألفه 697. وليس في النسخة 
ms772	 تاريخ الكتابة ولكن عليها اجازات مؤرخات، كلها بعنوان الانهاء المضمر، مثل: أنهاه أيده الله وإحداها من محمد بن محمد بن علي الآملي في 752 والأخرى من الشريف أبي عبد الله محمد بن محمد بن زهرة الحسيني في 757. والثالثة من شمس الدين محمد بن أحمد بن أبي المعالي العلوي في 757. والظاهر أن مرجع ضمير الانهاآت هو الكاتب سيما إنهاء ابن زهرة، لأنه كتب الكاتب بخطه في آخر الكتاب بعد ذكر اسمه: اللهم اعف لصاحبه وكاتبه وناظره،(@)(@)PageV05P042(@) فكتب ابن زهرة الانهاء تحت كلمة صاحبه وكاتبه. والنسخة رأيتها في مكتبة (هبة الدين الشهرستاني) .(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن داود.(@)(@)(@@) تقي الدين الحلي. صاحب «الرجال» المعروف باسمه. الذي فرغ منه في ذي الحجة 707 كان من تلاميذ المحقق الحلي. ولد في 5 ج 2-647 كما صرح به في ترجمة نفسه. وعدد من تصانيفه في الأصول والفروع والعربية وغيرها نحوا من ثلاثين كتابا نظما ونثرا. وهو أول من استعمل الرموز لمصادر كتابه. ذكرته في «مصفى المقال-ص 126» و(ذ 10: 84-85) .(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن سالم بن الحسن بن يوسف.(@)(@)(@@) رأيت تملكه للجزء السادس والسابع من «المبسوط» من الطلاق إلى الديات وتاريخ تملكه رمضان 743 وفرغ كاتبه 613 وقوبل في مدينة الرسول 614 والنسخة عند الشيخ محمد بن علي بن حسين قلي الهمداني بالنجف.(@)(@)(@@)(@@)(@@) $ الحسن بن علي الفارسي.(@)(@)(@@) كمال الدين (665-718) تتلمذ على القطب الشيرازي محمود بن مسعود م 710 عند ما كان مشغولا بتأليف «التحفة السعدية» في شرح القانون. وألف «تنقيح المناظر لأولي الأبصار والبصائر» (ذ 4: 467) المطبوع بحيدر آباد في مجلدين، بإشارة من استاذه القطب المذكور. ويأتي في ترجمة علي بن عبد الله بن أبي الحسن أنه درس الحساب والهندسة على فيلسوف الوقت كمال الدين حسن الشيرازي.(@)(@)(@@)(@@)(@@) $ الحسن بن علي المازندراني(@)(@)(@@) فخر الدين الموسوي نزيل الحلة. ورد عليه الفاضل الصالح زين الدين علي بن فاضل المازندراني في 11 شوال-699 وحدث في داره لجمع من الحاضرين ومنهم الفضل بن يحيى الطيبي وجمع من العلماء الزائرين له حكاية «الجزيرة الخضراء» 
ms773	 كما ذكره الطيبي (ذ 5: 105) .(@)(@)PageV05P043(@)(@)(@@)(@@)(@@) $ الحسن بن أبي الفتح ابن الدهان.(@)(@)(@@) عز الدين الحسيني، المعاصر لتاج الدين محمد بن القاسم بن معية (م 776) . قال في «الإجازة للشهيد» : وممن صاحبته واستفدت منه فرويت عنه وروى عني هو السيد الجليل الفقيه العالم عز الدين الحسن إلى آخر الترجمة. وفي آخر إجازته للشهيد استجاز منه أيضا كما سيأتي في ترجمة ابن معية. فصاحب الترجمة في طبقة الشهيد يروي ابن معية عنهما ويرويان عنه.(@)(@)(@@)(@@)(@@) $ الحسن الفتوني (الأفتوني) العاملي النباطي.(@)(@)(@@) كان شيخنا فاضلا صالحا معاصرا للشهيد. كذا ذكره في «أمل الآمل) وقال في «الرياض» بعد نقل كلام صاحب «الأمل» : قد رأيت خطه على ظهر نسخة «مسائل ابن مكي» أعني الشهيد المذكور، وكان خطه متوسطا. انتهى. أقول: يأتي أن «مسائل ابن مكي» هو تأليف الشيخ الشهيد (786) . ويأتي في القرن 12 ابو الحسن الفتوني صاحب «ضياء العالمين» ، «معراج الكمال» الذي هو جد صاحب الجواهر.(@)(@)(@@)(@@)(@@) $ الحسن الكاشي.(@)(@)(@@) قال في «الرياض» : فاضل عالم محقق مدقق شاعر منشىء ماهر. وهو ومعاصره العلامة الحلي والمحقق الكركي سواء في نشر المذهب. وله حق عظيم على الناس في الهداية إلى الحق والدعوة إلى المذهب ولذلك يعاديه العامة. وكان في عصر الشاه خدابنده (م 726) وجاء إلى السلطانية التي بناها خدابنده وهناك توفي وزرت قبره بها. أقول: وفي الكاظمية قرب مزار السيد المرتضى قبر يعرف بقبر حسن الكاشي صاحب «هفت بند» «العقود السبعة» (ذ: 15: 303) هدمت اخيرا (ذ 2: 391) وذكر دولتشاه ان أصله من كاشان ولد بآمل (ذ 9: 899) .(@)(@)(@@)(@@)(@@) $ الحسن الكرماني الكيمياوي الزاهد.(@)(@)(@@) وقد يوصف بزاهد غريب هاجر في 723 من إيران إلى الهند واتصل بالسلطان محمد بن تغلق شاه وألف له في(@)(@)PageV05P044(@)(@)(@@) 726 «مفتاح الرموز» (ذ 21: 331) وبعد سنين ألف له «مقلاد الكنوز» كلاهما فارسيان في الكيميا. ويظهر من صلواته على الأئمة حسن حاله.(@)(@)(@@)(@@)(@@) $ الحسن بن كعش الحسيني.(@)(@)(@@) قال في «الرياض» عالم نبيل جليل فاضل من أصحابنا وله كتاب جمع فيه الأخبار العديدة الجليلة. ذكره الحسن بن سليمان تلميذ الشهيد في كتاب «المختصر» وينقل عنه الأخبار الكثيرة. وفي بعض 
ms774	 مواضعه يقول السيد المرحوم، والظاهر أنه من المتأخرين. أقول:(@)(@)(@@) يعني المتأخرين عن العلامة الحلي.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد الآوي:(@)(@)(@@) الحسن بن محمد بن محمد الآوي.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن ابراهيم بن الحسام.(@)(@)(@@) الشيخ عز الدين بن شمس الدين الدمشقي ترجمه في «الأمل 1: 66» وذكر صورة اجازة فخر المحققين له في 753 على ظهر «القواعد» للعلامة الحلي فقال: (قرأ علي مولانا الشيخ الأعظم الإمام المعظم شيخ الطائفة مولانا الحاج عز الحق والدين الحسن بن الشيخ الامام السعيد شمس الدين محمد بن ابراهيم بن الحسام الدمشقي) ويظهر منه أن والده الآتي أيضا من العلماء.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن ابراهيم(@)(@)(@@) بن محمد بن علي بن الحسن بن أبي المحاسن زهرة. عز الدين أبو محمد بن بدر الدين الحلبي. هو خامس المجازين بالاجازة الكبيرة (ذ 1: 176) المعروفة «اجازة بني زهرة» ملقبا له بعز الدين حسن، ولكن في «الأمل 2: 76» و«الرياض» لقباه بجمال الدين. وقد اشترك معه في الاجازة عمه علي ثم ابن عمه الحسين بن علي ثم والده محمد ثم أخوه أحمد (ص 9) .(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن أبي بكر(@)(@)(@@) بن أبي القاسم الهمداني السعيد الشهيد الدمشقي السكاكيني. قال ابن كثير في حوادث 744: وفي صبيحة يوم الاثنين(@)(@)PageV05P045(@)(@)(@@) 21 ج 1 قتل بسوق الخيل الحسن بن الشيخ السكاكيني. وترجمه العسقلاني في «الدرر الكامنة 2: 119» وذكر فضله وفضل أبيه، وقال إن صاحب الترجمة قتل بضرب عنقه بسوق الخيل في دمشق بعد ثبوت رفضه وتكفيره للشيخين عند القاضي شرف الدين المالكي وذلك في 11-ج 1-744.(@)(@)(@@) ويأتي ترجمة والده الشيعي بتصريح العسقلاني واليافعي في «مرآة الجنان» والذي كتب نسخة من «الطرائف» لابن طاوس وسبب عمله هذا مشكلة له بعد موته وقد توفي 721 ويأتي قول ابن كثير: [وقتل ابنه قايماز على قذفه]. واليافعي إنما ذكر الوالد دون الولد الشهيد صبرا بيد عباد الشيخين.(@)(@)(@@) هذا ومن الصدف أن المترجم له استشهد في 744 ثم استشهد بعده في 755 بنفس المحل ونفس التهمة علي بن الفضل بن محمد من تلاميذ العلامة الحلي، ثم استشهد بها الشهيد 
ms775	 الأول محمد بن مكي كما سيأتي.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن أبي جامع العاملي.(@)(@)(@@) كان فاضلا فقيها صالحا صدوقا معاصرا للشهيد السعيد. كذا في «الرياض» عن «الأمل» ولذلك قال إنه مقدم على أحمد بن محمد بن أبي جامع المجاز من الكركي في 928. ولكن في المطبوعة من «الأمل 1: 67» قيد الشهيد بالثاني وعليه فلا يبعد أن يكون المترجم له أخا للمجاز عن الكركي لأن الشهيد الثاني قتل 966.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن الحسن بن محمد(@)(@)(@@) بن علي بن الحسن بن زهرة الحسيني الحلبي. شمس الدين بن بدر الدين نقيب الاشراف بحلب. كان أمير طبل خانه ثم عزل ومات 766. ارخه ابن حبيب. كذا ذكر في «الدرر الكامنة 2: 120» . ويأتي جده نقيب الأشراف المقتول غيلة في 732 (ص 48) .(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن الحسين.(@)(@)(@@) نظام الدين النيشابوري الطوسي القمي، المعروف بالنظام الأعرج. ألف «شرح تحرير المجسطي» في 704 بإشارة من(@)(@)PageV05P046(@) قطب الدين الشيرازي محمود بن مسعود (م 710) (ذ 13: 142) وباسم خواجه سعد الدين الساوجي وزير اليجايتوكما في «مجالس المؤمنين» و«توضيح التذكرة» ألفه لعلي بن محمود اليزدي في 711 (ذ 4: 492) و«غرائب القرآن» (ذ 16: 31) الذي ألفه 728 كما نقل عن خط المؤلف في نسخة كتابتها 990 موجودة عند حسين النواب بطهران (1) . و«شرح الشافية» في الصرف. ونقل عن «شرح الفقيه» للمجلسي الأول انه استدل على تشيع المترجم له علاوة عن اسمه واسم جده وبيئته القمية، بأنه كان ينتصر لآراء الخواجه نصير الدين الطوسي الفلسفية. وذكر في «كشف الظنون» جملة من مقدمات كتابه «غرائب القرآن» فيها قوله: «واجتهدت فيها كل الاجتهاد... » .(@)(@)(@@)(@@)(@@) $ الحسن بن محمد الديلمي.(@)(@)(@@) أبو محمد. كما في «الأمل» و«البحار» .(@)(@)(@@) مر بعنوان الحسن بن أبي الحسن بن محمد. وصرح في «الرياض» بأن محمدا جده.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد الرامي.(@)(@)(@@) هو ملك الشعراء شرف الدين المتخلص «شرف» و«رامي» التبريزي (م 9: 795) مؤلف «حدائق الحقائق» (ذ 6: 284) و«انيس العشاق» (ذ 9: 511) و«بابا كوهي ودختر ملك» . ورأيت لأدا جاجرمي (ذ 9: 62-63) «منتخب رسالة الصنايع الشعرية» لرامي هذا فرغ منه 1177.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن شرفشاه.(@)(@)(@@) ركن الدين ابو الفضائل العلوي 
ms776	 الاسترابادي. شارح «الكافية» الحاجبية بثلاثة شروح كبير ووسيط ووجيز.(@)(@)PageV05P047(@)(@)(@@) ترجمه السيوطي في «بغية الوعاة» ونقل عن ذيل «تاريخ بغداد» أنه كان بمراغة تلميذا ملازما للخواجه نصير الطوسي. وبعد وفاة الطوسي (672) استوطن الموصل وصار مدرسا للمدرسة النورية والناظر في اوقافها. وكان يجيد تدريس الفلسفة، وكتب «الحواشي على التجريد» وغيره إلى أن توفي 14 صفر 715. ثم حكى وفور جلالته عن «طبقات الشافعية» للأسنوي ووفاته في 718. وعن الصفدي ان له أيضا «شرح الشافية» في الصرف وعاش بضعا وسبعين سنة. وفي «كشف الظنون» ذكر شروحه الثلاثة على «الكافية» وسمى الوسيط منها «الوافية» وقال توفي 717. وفي «الرياض» ذكر الخلاف في تشيعه قال ولذلك ترجمته في كلا القسمين وفصلته في القسم الثاني اقول: آراؤه الفلسفية وكتبه في الحكمة والمنطق وتقربه من الشاه خدابنده المتجاهر بالتشيع يؤيد تشيعه. وله «المسائل العشرون الحكمية والمنطقية» سئلها عن أستاذه النصير الطوسي، فأجاب هو عنها وهي موجودة.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن عدنان.(@)(@)(@@) الشريف زين الدين أبو علي نقيب الأشراف. كان فاضلا بارعا فصيحا متكلما، يعرف طريقة الاعتزال ويباحث الإمامية، ويناظر على ذلك بحضرة القضاة وغيرهم. وقد باشر قبل وفاته بقليل نظر الجامع ونظر ديوان الأفرم. توفي يوم الخامس من ذي القعدة 708 عن خمس وخمسين سنة ودفن بتربتهم، بباب الصغير. هكذا ترجمه ابن كثير في حوادث 708. ومر جعفر بن محمد بن عدنان، ويأتي ولده عدنان ابن جعفر.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن علي(@)(@)(@@) بن زهرة بدر الدين الحسيني الحلبي. قال العسقلاني في «الدرر الكامنة 2: 123» إنه نقيب الأشراف وناظر المارستان بحلب وقتل غيلة في المحرم 732. أقول: هو عم علاء الدين علي بن حمزة بن علي المتوفى 755 وهو غير علاء الدين علي أخ بدر الدين محمد إبنا ابراهيم بن محمد المجازين مع ولديهما عن العلامة الحلي في 723 بالإجازة الكبيرة لخمسة من بني زهرة. ومر حفيده الحسن بن محمد بن الحسن في (ص 46) .(@)(@)PageV05P048(@)(@)(@@)(@@)(@@) $ الحسن بن محمد ابن أبي المجد(@)(@)(@@) سراج الدين بن بهاء الدين السرابشنوي، من تلاميذ العلامة الحلي المجاز منه في سلخ 
ms777	 ج 1-715 (ذ 1: 177) وصفه فيها: بالشيخ الإمام الأوحد العالم الفقيه العامل الكامل العلامة أفضل المتأخرين سراج الملة والحق والدين الحسن ابن الصدر السعيد بهاء الدين محمد بن أبي المجد السرابشنوي أدام الله افضاله وأعز إقباله، كتبها له بعد قراءة الجزء الأول من الخلاصة. والنسخة في خزانة سيدنا (الصدر) وكتب مثله أيضا في آخر القسم الثاني في 715. ومر الشيخ تاج الدين الحسن بن الحسين السرابشنوي المجاز من الحلي أيضا.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن محمد بن الحسن.(@)(@)(@@) الخواجه أصيل الدين بن الخواجه نصير الدين الطوسي (م 672) . ولي مناصب أخيه الخواجه صدر الدين علي بعد وفاته وقدم الشام مع غازان خان الذي ملك 695 ومات 703، فحكم في أوقاف دمشق، ورجع مع غازان خان وولي نيابة بغداد مدة، ثم عزل وصودر وأهين. كذا ذكره الصفدي في «الوافي بالوفيات ص 183» وهذا شأن المغول مع وزرائهم. مر أخوه فخر الدين أحمد في (الانوار: 12) والآخر صدر الدين علي فيها ص 114. قال الفوطي: وفي أيام اوليجايتوكان الحسن على رصد مراغة فلقب بالمنجم باشي الخاص للبلاط. وفي 719 في وزارة تاج الدين علي شاه انتزع منه الأوقاف وحاسبه الوزير فخر الدين أبو الفضل أحمد بن الحسن الآملي التبريزي. وقال أيضا عقب أصيل الدين ولدا اسمه ضياء الدين يوسف وهو الذي نظم أوحد الدين المراغي باسمه مثنوي «دهنامه» (ذ 8: 284) وكان للأصيل بنت تزوجها أبو الفتح كيخسرو ابن أبي المجد البرهاني القزويني. وقال العسقلاني في «الدرر الكامنة 1: 417» :(@)(@)(@@) ان اصيل بن الشيخ نصير الدين محمد بن محمد الطوسي مات في صفر 715.(@)(@)(@@) وسيأتي ان ابن الطقطقي ألف باسمه «المشجر الأصيلي» (ذ 21: 43) .(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن محمد(@)(@)(@@) بن محمد بن محمد بن زيد بن الداعي بن زيد بن(@)(@)PageV05P049(@) علي بن الحسين بن الحسن البخ كمال الدين الرضي الآوي الافطسي الحسيني.(@)(@)(@@) توفي جده رضي الدين محمد ابن الزاهد فخر الدين محمد بن رضي الدين محمد بن زيد المصاحب لرضي الدين ابن طاوس (انوار: 116-118) في 654.(@)(@)(@@) وصرح في «عمدة الطالب» بان المترجم له ابن فخر الدين 
ms778	 محمد بن رضي الدين محمد الزاهد. فعلى هذا يكون آباؤه المحمدون أربعة. وذكر ان ولده يسمى مجد الدين حسين والد تاج الدين حسن قاضي القضاة المتوفى 747. وصاحب الترجمة من مشائخ تاج الدين محمد بن قاسم بن معية (م 776) كما ذكره في «الاجازة للشهيد» المنقولة صورتها في «إجازة صاحب المعالم» ولكن في «البحار» في إجازته لشمس الدين محمد بن أحمد بن أبي المعالي، جاء ذكره بعنوان: كمال الدين الرضي بن محمد بن محمد، وكأنه أسقط الكاتب لفظ الحسن في المنقول عنه في «البحار» او في نسخة البحار المطبوعة. وفي «الروضات» جاء: المرتضى، بدل: الرضي، وزين الدين بدل زيد.(@)(@)(@@) وأن جده الأعلى يلقب بزين الفريد وأن صاحب الترجمة يروي عن الخواجه نصير الطوسي والعلامة الحلي. ويأتي تاج الدين أبو الفضل محمد بن مجد الدين حسين بن علي بن زيد ابن الداعي الآوي الشهيد 711.(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن مكي.(@)(@)(@@) الشيخ المنصور بن الشهيد الاول. ترجمه الشيخ سليمان ظاهر في ذيل ترجمة الشهيد ضمن مقالة له في مجلة المجمع العلمي العربي 5: 9: ص 278.(@)(@)(@@)(@@)(@@) $ الحسن بن المرتضى بن الحسن.(@)(@)(@@) فخر الدين بن علاء الدين الحسيني.(@)(@)(@@) ألف باسمه «تزكية الأرواح عن موانع الافلاح» المنتزع من «الاخلاق الناصري» للخواجه نصير الطوسي (ذ 4: 171) لا يعرف المؤلف، لكن كتابة النسخة 764، ووصف في أولها صاحب الترجمة بأوصاف كثيرة تركناها، منها قوله: الملك الأعظم المرتضى العالم العادل الحاكم الفاصل السيد(@)(@)PageV05P050(@) فخر الدين الحسن إلخ. والظاهر أنه أدرك هذه المائة. توجد النسخة في مجموعة في مكتبة السيد محمد باقر (حفيد اليزدي) في النجف.(@)(@)(@@)(@@)(@@) $ الحسن بن المطهر.(@)(@)(@@) كتب لنفسه «شرح شمس الدين الأصفهاني» على «الطوالع» للبيضاوي في الكلام. وقال في آخره ما لفظه: «كتبه لنفسه العبد الفقير إلى رحمة ربه الغني حسن بن المطهر في مجالس آخرها آخر نهار الأحد خامس صفر 768» . رأيت النسخة في الخزانة (الغروية) وقد وقفت من متروكة جلال الدين عبد الله بن شرفشاه الحسيني لتلك الخزانة في 10 شعبان 810 وعلى النسخة تملكه.(@)(@)(@@)(@@)(@@) $ الحسن بن معية الديباجي.(@)(@)(@@) نصير الدين الحلي. 
ms779	 قال في «عمدة الطالب» إنه كان نائبا في الفتوة عن تاج الدين محمد بن القاسم بن معية (م 776) . مال إليه الناس وامتثل أمره العام والخاص إلى أن جرحه قطاع الطريق في سفرته لزيارة النجف، فحمل إليها وتوفي بها.(@)(@)(@@)(@@)(@@) $ الحسن بن نجم الدين الأطراوي.(@)(@)(@@) تلميذ فخر المحققين (م 771) والشهيد (786) مر بعنوان الحسن بن أيوب (ص 37-38) ويعرف بابن نجم الأطراوي.(@)(@)(@@) الحسن بن نجم الدين العلوي العبيدلي. تقي الدين العاملي. قال في «الرياض» : كان من أجلة العلماء المتصلين بعصر العلامة الحلي كما يظهر من رجال علي بن عبد الحميد (ذ 10: 136 و157) .(@)(@)(@@)(@@)(@@) $ الحسن بن نما.(@)(@)(@@) كما جاء في بعض الإجازات. وهو جلال الدين أبو محمد ابن نما مر بعنوان الحسن بن أحمد بن محمد بن جعفر بن هبة الله (ص 36) .(@)(@)(@@)(@@)(@@) $ الحسن بن أبي الهيجاء.(@)(@)(@@) الشيخ عز الدين أبو علي الأربلي يروي عن علي ابن عيسى الأربلي كتاب «كشف الغمة» وله منه «اجازة» رأيتها بخط(@)(@)PageV05P051(@) بعض علمائنا. كذا في «الأمل 2: 61» ونقل صاحب «الرياض» عن «الأمل» : عز الدين الحسن بن أبي علي الهيجاء. أقول: الظاهر أن مراده من الإجازة ما ذكرته في (ذ 1: 218-219 و18: 48) فالرجل هو أبو الحسن علي بن ابي الهيجاء كما يأتي.(@)(@)(@@)(@@)(@@) $ الحسن بن يوسف بن علي بن محمد بن المطهر.(@)(@)(@@) جمال الدين أبو منصور الحسن بن سديد الدين يوسف المعروف بالعلامة الحلي. ولد في النصف الأخير من ليلة الجمعة 27 رمضان 648 كما كتبه في «المسائل المهنائية» . وتوفي ليلة السبت 21 (12 خ. ل. ) محرم 726. بلغ أسماء تصانيفه نحوا من ألف عنوان كما حكي في «رجال أبي علي» في ترجمة العلامة عن بعض شراح «التجريد» . قرأ على والده سديد الدين (أنوار: 209) ثم على خاله المحقق الحلي (أنوار: 30) وتعلم الفلسفة والرياضيات على الخواجه نصير الطوسي (أنوار: 168-170) وابن ميثم (أنوار: 187) وعلى علي ابن طاوس وأحمد ابن طاوس (أنوار: 13 و116) ويروي عن كثير من أعلام الخاصة والعامة غيرهم. فمن الخاصة نجيب الدين يحيى بن سعيد ابن عم المحقق الحلي، وحسين ابن 
ms780	 علي بن سليمان البحراني، ومفيد الدين محمد بن علي بن الجهم الأسدي.(@)(@)(@@) ويظهر من إجازة ابراهيم القطيفي للأمير معز الدين ابن الامير تقي الدين، رواية العلامة الحلي عن نجيب الدين محمد بن نما، ولكن استبعدها صاحب «الرياض» وهو في محله لأنه من مشائخ والده وعلي بن طاوس وغيرهما، كما يبعد روايته عن أحمد بن يوسف العريضي الذي هو من مشائخ والده. ومن العامة نجم الدين علي بن عمر الكاتبي (دبيران) القزويني، ومنهم: برهان الدين أبو الفضل محمد بن محمد بن محمد النسفي (م 686) وعز الدين الفاروقي الواسطي وتقي الدين عبد الله بن جعفر بن علي بن الصباغ الكوفي الحنفي وشمس الدين محمد بن محمد الكشي الشافعي. ذكر هؤلاء في أواخر «إجازة صاحب المعالم» .(@)(@)(@@) ومنهم: حسن بن محمد الصنعاني مؤلف «التكملة والذيل والصلة لتاج اللغة(@)(@)PageV05P052(@) وصحاح العربية» فالحلي يروي هذا الكتاب عن مؤلفه كما ذكره الفيروزآبادي في بعض إجازاته ونقلنا كلامه في ترجمة فخر المحققين محمد ابن الحسن بن يوسف.(@)(@)(@@) وأما تلاميذه، فكثير ممن ترجمته في هذه المائة كانوا من تلاميذه والمجازين منه أو المعاصرين المستفيدين من علومه فليرجع إلى تلك التراجم، حتى يحصل الجزم بصدق ما قيل من أنه كان في عصره في الحلة أربعماية مجتهد. وأجل تلاميذه المنتهي إليه سلسلة الإجازات هو ولده فخر المحققين محمد وابنا اخت العلامة السيد عميد الدين والسيد ضياء الدين، ولهما أعقاب علماء أجلاء. ولفخر المحققين ولدان عالمان ظهير الدين محمد وأبو المظفر يحيى.(@)(@)(@@) ويأتي أخو العلامة الحلي رضي الدين علي بن سديد الدين صاحب «العدد القوية» وولده قوام الدين محمد بن علي من مشائخ محمد بن القاسم بن معية.(@)(@)(@@) وفي عصره استبصر السلطان خدابنده وتشيع وضرب النقود باسم الأئمة عام 708 فتخلص الأمة الإسلامية من بدعة «الخلافة» التي قامت بموت النبي (ص) . فانفصلت السلطة السياسية عن الإمامة الروحية وأعطيت بعض الحريات الدينية التي كان العباسيون يضنون بها. فلو اقتنع العباسيون قبل ذلك بالسلطة السياسية وخلوا عن الامامة الروحية لأهلها فلعلها لم يحصل ما 