ms561	 تقدم ومحمد بن زياد أيضا تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 287 البسطامي بفتح الباء وسكون السين المهملة وفتح الطاء نسبة إلى بلدة بسطام من بلاد فارس وبالكسر اسم رجل كذا جعلهما السمعاني ترجمتين PageV02P288 وأنكر ابن الأثير ذلك وقال الجميع مكسور لأنه اسم عجمي عرف بكسر الباء نسبة عبد الرحمن بن أبي بكر ومنصور بن أحمد بن محمد تقدما(@)(@@)(@@)(@@) $DIC_NIS$ 288 البسكاسي بفتح الباء الموحدة والكاف وألف بين السينين المهملتين نسبة إلى بسكاس قرية(@)(@@)(@@)(@@) $DIC_NIS$ 289 البسطاسي نسبة نبهان بن إسحاق بن معداس تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 290 البسكاني نسبة أحمد بن نصر بن منصور(@)(@@)(@@)(@@) $DIC_NIS$ 291 البشتنقاني بضم الباء الموحدة وسكون الشين المعجمة وفتح التاء المثناة من فوقها وكسر النون وفتح القاف وفى آخرها النون قرية على فرسخ من نيسابور يقال لها البشتنقان وهى من متنزهات نيسابور نسبة إسماعيل بن علي(@)(@@)(@@)(@@) $DIC_NIS$ 292 البصرواي نسبة إلى بصرى وهى بضم الباء وسكون الصاد المهملة وفتح الراء بعدها ألف ثم واو نسبة إبراهيم بن أحمد بن عقبة(@)(@@)(@@)(@@) $DIC_NIS$ 293 البصروي بضم الباء الموحدة وسكون الصاد وفتح الراء وفى آخرها الواو(@)(@@)(@@)(@@) $DIC_NIS$ 294 البصري نسبة إلى البصرة بناها عتبة بن غزوان فى خلافة عمر رضي الله(@)(@@)(@@)(@@) $DIC_NIS$ 295 البعلبكي بفتح الباء الموحدة واللام بينهما عين ساكنة وياء أخرى وفى آخرها الكاف نسبة إلى بعلبك وهى مدينة بالشام(@)(@@)(@@)(@@) $DIC_NIS$ 296 البغولني نسبة إلى بغولن فى ظن السمعاني أنها قرية من قرى نيسابور نسبة أحمد بن إبراهيم بن محمد أبي حامد الفقيه الزاهد(@)(@@)(@@)(@@) $DIC_NIS$ 297 البقالي بفتح الباء الموحدة وتشديد القاف وآخرها اللام ذكر السمعاني البقال وقال حرفة لمن يبيع الأشياء اليابسة من الفاكهة وذكر فى القنية فى الفهرست البقالي وعلم له بق ثم ذكر بعد ذلك شرح البقالي وعلم علامة شبق PageV02P289 ثم ذكر بعد ذلك صلاة البقالي وعلم له صبق قلت ويأتي لهذا النسبة زيادة فى الألقاب فى ترجمة زين المشائخ البقالي(@)(@@)(@@)(@@) $DIC_NIS$ 298 البكرأباذي بفتح الباء وسكون الكاف وفتح الراء والباء الموحدة فى آخرها ذال معجمة محلة معروفة 
ms562	 بجرجان يقال لها بكرأباذ وقد ينسب إليها البكراوي نسبة طاهر بن محمد الطاهري تقدم وكميل بن جعفر بن كميل الفقيه الجرجاني تقدم أيضا(@)(@@)(@@)(@@) $DIC_NIS$ 299 البكراوي بفتح الباء الموحدة وسكون الكاف وفتح الراء وفى آخرها الواو نسبة إلى أبي بكرة نفيع بن الحارث الصحابي جد بكار بن قتيبة تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 300 البكري بفتح الباء وسكون الكاف وفى آخرها الياء نسبة إلى أبي بكرة ونسبة إلى بكر بن وايل ونسبة إلى بكر بن كنانة ونسبة إلى بكر بن عوف(@)(@@)(@@)(@@) $DIC_NIS$ 301 البلخي بفتح الباء الموحدة وسكون اللام وفى آخرها الخاء المعجمة هذه النسبة إلى بلدة من بلاد خراسان يقال لها بلخ فتحها الأحنف بن قيس التميمي زمن عثمان بن عفان رضي الله عنه خرج منها عالم لا يحصى(@)(@@)(@@)(@@) $DIC_NIS$ 302 البندنيجي بفتح الباء الموحدة وسكون النون وفتح الدال المهملة وكسر النون وسكون الياء من تحتها نقطتان وفى آخرها الجيم نسبة إلى بندنيجن نسبة أحمد بن عبد الله بن أحمد بن عسكر(@)(@@)(@@)(@@) $DIC_NIS$ 303 البوزجاني بضم الباء الموحدة وسكون الزاي بعد الواو وفتح الجيم وفي آخرها النون هذه النسبة إلى بوزجان وهى بلدة بين هراة ونيسابور من بلاد PageV02P290 نيسابور نسبة أحمد بن محمد أيضا تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 304 البوزجندي نسبة محمود بن مسعود بن عبد الحميد قاضي القضاة أبو بكر الشعبي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 305 البلاساغوني وراء نهر سيحون نسبة محمد بن موسى(@)(@@)(@@)(@@) $DIC_NIS$ 306 البلالي بكسر الباء الموحدة واللام ألف المخففة وفى آخرها اللام المكسورة بياء نسبة إلى بلال مؤذن رسول الله صلى الله عليه وسلم نسبة أبي صالح بن يوسف قاضي خوارزم وأبي يوسف تقدم فى الكنى(@)(@@)(@@)(@@) $DIC_NIS$ 307 البويني نسبة جعفر بن محمد من طبقة أبي بكر محمد بن الفضل البخاري تقدم فى بابه وقد ذكر السمعاني البويبي بالباء الموحدة وبعدها الواو وياء ساكنة ثم باء موحدة نسبة إلى بويب اسم جد عيسى بن جلال(@)(@@)(@@)(@@) $DIC_NIS$ 308 البياري من أعمال قومس وقومس يقال لها بالفارسية كومس وهى من بسطام إلى سمنان 
ms563	 نسبة إبراهيم بن أحمد بن محمد وإسمعيل بن عبد الصادق وابنه ميمون بن إسماعيل تقدموا(@)(@@)(@@)(@@) $DIC_NIS$ 309 البياعي إمام كبير من مشائخ المعتزلة الملقب بكمال الأئمة نسبة إسماعيل ابن محمد ولم يذكرها السمعاني وذكرها الذهبي ولم يضبطها وإنما قال بعدها وبباء ونون خفيفة البناعي وذكر جماعة وهى أيضا نسبة إلى نور الأئمة ذكره فى القنية(@)(@@)(@@)(@@) $DIC_NIS$ 310 البيكندي من بلاد ما وراء النهر خربت على مرحلة من بخارى PageV02P291 إذا عبرت النهر كانت بلدة كثيرة العلماء(@)(@@)(@@)(@@) $DIC_NIS$ 311 البيهقي بفتح الباء الموحدة وسكون الياء آخر الحروف وبعدها الهاء وفى آخرها القاف هذه النسبة إلى بيهق وهى قرية مجتمعة بنواحي نيسابور على عشرين فرسخا منها نسبة إسماعيل بن الحسن وكانت قصبتها خسر وجرد فصارت سبذوار(@)(@@)(@@)(@@) $DIC_NIS$ 312 البيقلاوي نسبته محمد بن محمد بن أحمد(@)(@@)(@@)(@@) $DIC_NIS$ 313 البيلقي نسبة إسماعيل بن محمد بن سليمان تقدم(@)(@@)(@@)(@@) || حرف التاء المثناة من فوق(@)(@@)(@@)(@@) $DIC_NIS$ 214 التاجري نسبة علاء الدين مذكور فى القنية(@)(@@)(@@)(@@) $DIC_NIS$ 315 التاجي فى القنية وفي الجامع قال التاجي الأمة كالحرة فى حق النكاح حتى استحقت مطالبة الزوج بالقسم والوطي والنفقة(@)(@@)(@@)(@@) $DIC_NIS$ 316 التاذني بفتح التاء الفوقية والذال المعجمة وفى آخرها النون هذه النسبة إلى تاذن قرية من قرى بخارى نسبة محمد بن أيوب(@)(@@)(@@)(@@) $DIC_NIS$ 317 التباني نسبة إلى بيع التبن أحمد بن هارون أبو العباس قال السمعاني إمام أصحاب أبي حنيفة بنيسابور وتقدم(@)(@@)(@@)(@@) $DIC_NIS$ 318 الترجماني الملقب علاء الدين بن الإمام مات بجرجانة سنة خمس وأربعين PageV02P292 وست مائة قال السمعاني هذه النسبة إلى الجد وهى بفتح التاء وضم الجيم(@)(@@)(@@)(@@) $DIC_NIS$ 319 التركستاني أحمد بن مسعود بن علي وشيخنا هبة الله شجاع الدين تقدما(@)(@@)(@@)(@@) $DIC_NIS$ 320 التركماني هذه النسبة المشهورة اشتهر بها أهل بيت علماء أئمة فخر الدين عثمان وابناه أحمد وعلي تقدم كل واحد فى بابه وابن ابنه عبد العزيز بن علي وابن ابنه محمد بن أحمد تقدما(@)(@@)(@@)(@@) $DIC_NIS$ 321 التركي البلاد المعروفة بضم التاء المثناة من فوق واسكان الراء بعدها الكاف(@)(@@)(@@)(@@) $DIC_NIS$ 
ms564	 322 التروجاني نسبة يحيى بن علي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 223 التمرتاشي نسبة الملقب بظهير الدين الدين الخوارزمي أحمد بن إسماعيل وغيره ياتي في الألقاب(@)(@@)(@@)(@@) $DIC_NIS$ 324 التميمي بفتح التاء المثناة من فوق والياء المثناة من تحت بين الميمين المكسورتين قال السمعاني نسبة إلى تميم والمنتسب إليها جماعة من الصحابة رضي الله عنهم ومن بعدهم(@)(@@)(@@)(@@) $DIC_NIS$ 325 التنوخي بفتح التاء ثالث الحروف وضم النون المخففة وفى آخرها الخاء هذه النسبة إلى تنوخ وهى اسم لعدة قبائل اجتمعوا قديما بالبحرين وتحالفوا على التناصر فأقاموا هناك فسموا تنوخا والتنوخ الإقامة نسبة إبراهيم بن عبد الله بن جعفر تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 326 التوبني بضم التاء المثناة من فوق وفتح الباء الموحدة وفى آخرها النون هذه النسبة إلى توبن وهى قرية من قرى نسف نسبة أبي بكر محمد بن أحمد تقدم فى الكنى ونسبته بالتنوبني المذكور فى حرف الباء PageV02P293(@)(@@)(@@)(@@) || حرف الثاء المثلثة(@)(@@)(@@)(@@) $DIC_NIS$ 327 الثقفي بفتح الثاء المثلثة والقاف نسبة إلى ثقيف بن منبه بن بكر بن هوازن ابن عكرمة بن خصفة بن قيس عيلان(@)(@@)(@@)(@@) $DIC_NIS$ 328 الثلجي بفتح الثاء المثلثة وسكون اللام وفى آخرها الجيم قال ابن الكلبي بنو ثلج بن عمرو بن مالك بن عبد مناة بن هبل بن عبد الله بن كنانة بن قضاعة لهم عدد فيهم كثرة نسبة إلى الجد وإلى الثلج ومنهم أبو عبد الله محمد بن شجاع قلت اسمه محمد تقدم وذكره صاحب الهداية فى أول الجمعة هكذا نسبته وصحفه بعضهم بالباء والخاء وهو غلط والثلجي بالثاء والجيم محمد بن شجاع والبخلي بالباء والخاء المعجمة هو أبو المطيع الحكم بن عبد الله(@)(@@)(@@)(@@) $DIC_NIS$ 329 الثوري نسبة إلى ثور تميم نسبة سفيان بفتح الثاء المثلثة وفى آخرها الراء وللسمعاني فى هذه النسبة كلام واعترض عليه ابن الأثير وليس هذا موضعه(@)(@@)(@@)(@@) || حرف الجيم(@)(@@)(@@)(@@) $DIC_NIS$ 330 الجادكي محمد بن أحمد بن عبد الله تقدم ويقال له الخطيبي ويأتي فى الخطيبي(@)(@@)(@@)(@@) $DIC_NIS$ 331 الجبني بضم الجيم والباء الموحدة وفى آخرها النون المشددة نسبة إلى الجبن 
ms565	 قاله السمعاني وهو شيئ يعمل من اللبن نسبة إسحاق بن محمد بن أحمد(@)(@@)(@@)(@@) $DIC_NIS$ 332 الجذامي بضم الجيم وفتح الذال المعجمة وفى آخرها الميم هذه النسبة إلى جذام نسبة إبراهيم بن محمد بن إبراهيم وجذام قبيلة من اليمن والخذامي بكسر الخاء المعجمة وفتح الذال المهملة وفى آخرها ميم هذه النسبة إلى خذام وهو اسم وتشتبه بالجذامي نسبة إبراهيم بن محمد بن إبراهيم كذا ذكره ابن ماكولا تقدم وأخوه أبو بشر أيضا تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 333 الجرباذقاني بفتح الجيم وسكون الراء وفتح الباء الموحدة بعدها الألف PageV02P294 وسكون الذال المعجمة وفتح القاف وفى آخرها النون نسبة إلى بلدين أحدهما بين جرجان واسترأباد منها نصير تقدم والثانية بين أصبهان والكرخ(@)(@@)(@@)(@@) $DIC_NIS$ 334 الجرجاني بضم الجيم وسكون الراء وبالجيم والنون بعد الألف نسبة إلى جرجان فتحها يزيد بن المهلب(@)(@@)(@@)(@@) $DIC_NIS$ 335 الجرعي ويقال بالسين نسبة إلى قرية نسبة محمد بن أبي بكر بن المفتي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 336 الجرمي بكسر الجيم وسكون الراء نسبة إلى بلدة من بلاد خراسان يقال لها جرم قال السمعاني وزاد الذهبي وجرم من وراء النهر نسبة سعيد بن جندب تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 337 الجريري بضم الجيم وفتح الراء الأولى وسكون الياء المثناة من تحتها وبعدها راء أخرى نسبة إلى جرير بن عباد أخي الحرب بن ضبيعة بن قيس بن ثعلبة بن عكامة نسبة عبد الله بن محمد بن سعد الله تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 338 الجصيني بفتح الجيم وكسر الصاد المهملة المشددة وسكون الياء آخر الحروف وفى آخرها النون نسبة إلى جصين محلة بمرو واندرست وصارت مقبرة ودفن بها الصحابة رضي الله عنهم يقال له بنوكران قاله السمعاني قلت ونقل الحازمي عن أبي نعيم الحافظ أنه كان يقوله بكسر الجيم نسبة أحمد بن بكر بن سيف تقدم PageV02P295(@)(@@)(@@)(@@) $DIC_NIS$ 339 الجعبري عز الدين بن يوسف بن إسحاق تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 340 الجعفري بفتح الجيم وسكون العين المهملة وفتح الفاء وفى آخرها الراء نسبة علي بن الحسين بن محمد تقدم وهى نسبة إلى رجلين أحدهما جعفر بن 
ms566	 كلاب بن ربيعة بن عامر بن صعصعة والثاني إلى جعفر بن أبي طالب المعروف بالطيار وإليه ينسب صاحب الترجمة(@)(@@)(@@)(@@) $DIC_NIS$ 341 الجعفي بضم الجيم وسكون العين المهملة وفى آخرها الفاء هذه النسبة إلى قبيلة نسبة محمد بن عبد الله بن الحسين بن عبد الله تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 342 الجوددي محمد بن علي المذكور أبو جعفر تقدم لم يذكر السمعاني هذه النسبة(@)(@@)(@@)(@@) $DIC_NIS$ 343 الجوري بضم الجيم وفى آخرها الرا هذه النسبة إلى موضعين أحدهما جور من بلاد فارس والثانية جور محلة بنيسابور نسبة عمر بن أحمد بن موسى تقدم ومحمد بن محمد بن يحيى بن الحسن أيضا تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 344 الجويني بضم الجيم وفتح الواو وسكون الياء آخر الحروف وفى آخرها النون نسبة إلى جوين ناحية كبيرة من نواحي نيسابور نسبة القاسم بن محمد(@)(@@)(@@)(@@) $DIC_NIS$ 345 الجوزجاني هذه النسبة إلى مدينة بخراسان مما يلي بلخ يقال لها جوزجان ينسب إليها أبو سليمان موسى وغيره(@)(@@)(@@)(@@) $DIC_NIS$ 346 الجوهري قال السمعاني بفتح الجيم والهاء وبينهما واو ساكنة وفى آخرها الراء نسبة إلى بيع الجوهر نسبة علي بن الجعد أبو الحسن تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 347 الجلاباذي بضم الجيم محلة كبيرة بنيسابور يقال لها كلاباذ هو أحمد ابن محمد بن شعيب تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 348 الجلابي ذكره السمعاني بفتح الجيم وتشديد اللام ألف وفى آخرها الباء PageV02P296 الموحدة نسبة لمن يجلب الرقيق والدواب وإلى بعض أجداد المنتسب إليه ثم ذكر الجلابي بضم الجيم والباء فى مثل ما تقدم نسبة إلى الجلاب والجلابي صاحب كتاب الصلاة فى الأول(@)(@@)(@@)(@@) || حرف الحاء المهملة(@)(@@)(@@)(@@) $DIC_NIS$ 349 الحاتمي بفتح الحاء وكسر التاء المثناة من فوق وفى آخرها الميم نسبة إلى الجد نسبة ميمون بن أحمد بن الحسن تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 350 الحاجبي بفتح الحاء المهملة وكسر الجيم وبعدها باء موحدة نسبة إلى الجد نسبة جماعة منهم عبيد الله بن أحمد بن عساكر وميمون بن طاهر بن عبد الله(@)(@@)(@@)(@@) $DIC_NIS$ 351 الحارثي نسبة إلى قبايل نسبة أحمد بن محمد بن محمد وعبد الله بن محمد 
ms567	 بن يعقوب تقدما(@)(@@)(@@)(@@) $DIC_NIS$ 352 الحاضري بفتح الحاء المهملة وكسر الضاد المعجمة بعد الألف وفى آخرها الراء ذكر السمعاني أنها نسبة إلى الجد نسبة علي بن محمد صاحبنا(@)(@@)(@@)(@@) $DIC_NIS$ 353 الحامدي بفتح الحاء المهملة وبكسر الميم وفى آخرها الدال المهملة نسبة إلى الجد اسمه نصر بن أحمد بن محمد بن جعفر بن محمد بن حامد تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 354 الحجاجي بفتح الحاء المهملة وبألف بين الجيمين أولهما مشددة ذكر السمعاني أنها نسبة رجل ومكان فالمكان قرية من قرى بيهق نسبة إسماعيل بن محمد بن أحمد قلت تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 355 الحجي بكسر الحاء المهملة والجيم المشددة قال السمعاني النسبة إلى الحج وكما يقال فى سائر البلاد الحاج يقال فى خوارزم الحجي قلت نسبة أحمد بن محمد ابن عمران الكاتي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 356 الحدادي نسبة إلى عمل الحديد وهو محمد بن الحسين بن محمد بن موسى PageV02P297 ابن مهران الحاكم أبو الفضل وهى أيضا نسبة إلى قرية بدمشق(@)(@@)(@@)(@@) $DIC_NIS$ 357 الحزامي بكسر الحاء وبالزاي وبالميم بعد الألف نسبة إلى الجد وبالحاء PageV02P298 المفتوحة بعدها الراء نسبة إلى الجد أيضا ذكرهما السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 358 الحسكاني بضم الحاء والسين المهملة نسبة إلى الجد نسبة صاعد ومحمد ابنى عبد الله تقدم كل واحد من الأربعة فى بابه(@)(@@)(@@)(@@) $DIC_NIS$ 359 الحسيني بضم الحاء وفتح السين نسبة إلى الحسين بن علي وبفتح الحاء وكسر السين نسبة بطن من طي وهو حسين بن عمر بن طاهر الفارسي المنعوت بالنور ذكرهما السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 360 الحصكفي بفتح الحاء المهملة وسكون الصاد المهملة وفتح الكاف وفى آخرها الفاء نسبة إلى حصكفاء مدينة من ديار بكر نسبة موسى بن زكريا بن إبراهيم الإمام صدر الدين ومنهم محمود بن أحمد بن عبد السيد أبو المحامد(@)(@@)(@@)(@@) $DIC_NIS$ 361 الحصيري بفتح الحاء نسبة جماعة من أصحابنا تقدم ذكرهم لم يذكر السمعاني هذه النسبة وذكرها الذهبي وقال نسبة جماعة وهى نسبة إلى محلة ببخارى يعمل فيها الحصير(@)(@@)(@@)(@@) $DIC_NIS$ 362 الحطيني بكسر الحاء وتشديد الطاء وسكون الياء المثناة من تحتها 
ms568	 وفى آخرها النون هذه النسبة إلى حطين قرية بين أرسوف وقيسارية من ساحل الشام بها قبر شعيب عليه السلام نسبة نعمان بن الحسن بن يوسف قاضي القضاة معز الدين تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 363 الحفصي بفتح الحاء وسكون الفاء وفى آخرها الصاد المهملة نسبة إلى حفص وهى اسم للجد المنتسب إليه نسبة طاهر بن محمد بن عمران بن أبي العباس أبو المعالي تقدم PageV02P299(@)(@@)(@@)(@@) $DIC_NIS$ 464 الحلبي بفتح الحاء واللام وفى آخرها الياء نسبة إلى البلد المشهور بالشام(@)(@@)(@@)(@@) $DIC_NIS$ 365 الحلجي عمر أبو حازم أستاذ أبي الفضل عبد الرحمن بن محمد الكرماني تقدم فى آخر العمريين(@)(@@)(@@)(@@) $DIC_NIS$ 366 الحلواني بفتح الحاء المهملة وسكون اللام وبعدها واو ثم ألف ساكنة وفى آخرها النون هذه النسبة إلى عمل الحلوا أو بيعها نسبة عبد العزيز بن أحمد بن نصر بن صالح شمس الأئمة وذكر فى القنية الحلواني وعلم له علامة حل ثم ذكر بعده شمس الأئمة الحلواني وعلم له شح(@)(@@)(@@)(@@) $DIC_NIS$ 367 الحلوى نسبة إلى الحلة السيفية قاضيها عبد الله بن سلمان بن الحسين أبو الغنايم تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 368 الحليمي نجم الأئمة مذكور فى القنية والحليمي بفتح الحاء المهملة وكسر اللام وسكون الياء المثناة من تحتها وفى آخرها الميم نسبة إلى حليمة ظئر النبي صلى الله عليه وسلم وإلى الحسن بن محمد بن حليم بن إبراهيم بن ميمون الصائغ الحليمي المروزي نسبة إلى جده حليم وإبراهيم بن ميمون الصائغ هذا صاحب الإمام رحمه الله تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 369 الحكيمي بفتح الحاء وكسر الكاف بعدها ياء آخر الحروف ثم ميم نسبة محمد ابن أسعد بن محمد بن نصر عرف بإبن حكيم أبو المظفر يأتي فيمن عرف بإبن فلان قال السمعاني نسبة إلى الجد(@)(@@)(@@)(@@) $DIC_NIS$ 370 الحمامي بضم الحاء وبالألف بين الميمين قال السمعاني وهو اسم نسبة النسبة(@)(@@)(@@)(@@) $DIC_NIS$ 371 الحماني نسبة إلى حمان قبيلة من تميم نزلوا الكوفة PageV02P300(@)(@@)(@@)(@@) $DIC_NIS$ 372 الحموي نسبة إلى مدينة حماه من بلاد الشام(@)(@@)(@@)(@@) $DIC_NIS$ 373 الحنوي بفتح الحاء المهملة والنون وفى آخرها الواو 
ms569	 المكسورة هذه النسبة إلى مدينة حنا معروف من ديار بكر أبو عاصم القاضي الإمام تقدم فى الكنى(@)(@@)(@@)(@@) $DIC_NIS$ 374 الحوفي بفتح الحاء المهملة وسكون الواو وكسر الفاء هذه النسبة إلى حوف قال السمعاني وظني أنها قرية من قرى مصر نسبة خلف بن أحمد بن الفضل أبي القاسم تقدم قلت صدق ظنه(@)(@@)(@@)(@@) $DIC_NIS$ 375 الحيري بكسر الحاء وسكون الياء آخر الحروف وفى آخرها الراء نسبة إلى مدينة قديمة عند الكوفة وإلى محلة بنيسابور خرج منها خلق كثير نسبة يحيى بن عبد الرحيم بن يحيى أبي زكريا (@)(@@)(@@)(@@) || باب الخاء المعجمة (@)(@@)(@@)(@@) $DIC_NIS$ 376 الخارفي بفتح الخاء المعجمة وكسر الراء بعد الألف وفى آخرها فاء نسبة إلى خارف بطن من همدان نسبة عبد الله بن نمير أبي هشام الكوفي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 377 الخاصي نسبة يوسف بن أحمد والموفق بن محمد وغيرهما وهى نسبة إلى خاص قرية من قرى خوارزم لم يذكرها السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 378 الخالدي نسبة إلى الجد أبي نصر القاضي الإمام أستاذ أبي الحسن علي ابن عبد الله المعمراني تقدم فى الكنى(@)(@@)(@@)(@@) $DIC_NIS$ 379 الخانقاهي بفتح الخاء وبالألف والنون والقاف وفى آخرها هاء هذه النسبة إلى خانقاه وهى رباط الصوفية اشتهر بها عبد الله بن أبي الفتح من أهل مرغينان تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 380 الخبازي بفتح الخاء المعجمة والباء الموحدة المشددة والزاي المعجمة بعد PageV02P301 الألف ذكرها الذهبي وذكر السمعاني الخبازي قال وهى نسبة إلى الخبز وبيعه نسبة عمر بن محمد بن عمر الإمام جلال الدين تقدم الإمام المشهور ونسبة الجنيد تقدم أيضا(@)(@@)(@@)(@@) $DIC_NIS$ 381 الختلي إمام كبير رأيت له شرحا المختصر القدوري فى مجدلين أبدع فيه كان فى حدود الست مائة(@)(@@)(@@)(@@) $DIC_NIS$ 382 الختني بضم الخاء المعجمة وبالتاء ثالث الحروف وفى آخرها النون نسبة إلى ختن بلدة من بلاد الترك وراء نور كنددو وكاشغر(@)(@@)(@@)(@@) $DIC_NIS$ 383 الخجندي بضم الخاء المعجمة وفتح الجيم وسكون النون وفى آخرها دال مهملة نسبة إلى خجند وهى مدينة كبيرة على طرف سيحون من بلاد المشرق ويقال خجندة بزيادة الهاء 
ms570	(@)(@@)(@@)(@@) $DIC_NIS$ 384 الخرابي نسبة الملقب بركن بفتح الخاء والراء وفى آخرها باء موحدة نسبة إلى موضع ببغداد يعرف بخراب المعتصم ولم يذكرها الذهبي ولا السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 385 الخراساني بضم الخاء وفتح الراء بعد الألف سين مهملة وفى آخرها نون نسبة إلى خراسان PageV02P302(@)(@@)(@@)(@@) $DIC_NIS$ 386 الخربرتي بينها وبين ملطية مسيرة يومين نسبة أحمد بن أبي بكر(@)(@@)(@@)(@@) $DIC_NIS$ 387 الخرقاني بفتح الخاء المعجمة وسكون الراء وفتح القاف بعدها ألف وفى آخرها نون نسبة إلى خرقان قرية من قرى سمرقند نسبة مسعود بن محمود بن أحمد أبو أحمد(@)(@@)(@@)(@@) $DIC_NIS$ 388 الخرقي بفتح الخاء المعجمة والراء وفى آخرها قاف نسبة إلى خرق قرية من قرى مرو نسبة محمد بن عبيد الله بن الحسين تقدم وعبد الرحمن بن محمد بن عبد الله ابن الحسين أيضا تقدم ومحمد بن علي الراشدي الخرقي تقدم أيضا(@)(@@)(@@)(@@) $DIC_NIS$ 389 الخريبي بضم الخاء المعجمة وفتح الراء وسكون الياء آخر الحروف وفى آخرها باء موحدة نسبة إلى الخريبة محلة بالبصرة نسبة عبد الله بن داود تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 390 الخزاعي بضم الخاء المعجمة وفتح الزاي وبعد الألف عين مهملة نسبة إلى خزاعة(@)(@@)(@@)(@@) $DIC_NIS$ 391 الخشنامي نسبة عمر بن محمد بن عمر بن أحمد بن خشنام البخاري(@)(@@)(@@)(@@) $DIC_NIS$ 392 الخطابي نسبة أحمد بن كستفدي تقدم ولم يذكر السمعاني هذه النسبة(@)(@@)(@@)(@@) $DIC_NIS$ 393 الخطبي بضم الخاء وفتح الطاء نسبة محمد بن إسماعيل بن أحمد نسبة إلى الخطيب وانشائها كذا قاله السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 394 الخطيبي بفتح الخاء وكسر الطاء المهملة وبعدها ياء وياء موحدة هذه النسبة إلى الخطيب قال السمعاني ولعل بعض أجداد المنتسب كان خطيبا نسبة عبد الله بن محمد بن عبيد الله وإسحاق وعلي ابنى إبراهيم ومحمد بن أحمد بن عبد الله الخطيبي تقدما رحمهما الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 395 الخلخالي كذا رأيته مضبوطا ولم يذكره السمعاني ولا الذهبي له شرح مختصر القدوري PageV02P303(@)(@@)(@@)(@@) $DIC_NIS$ 396 الخلمي بضم الخاء المعجمة وسكون اللام وفى آخرها ميم نسبة إلى خلم وهى بلدة على عشرة فراسخ من بلخ 
ms571	 نسبة محمد بن محمد بن محمد شيخ الإسلام وعثمان بن أحمد بن محمد وابنه أحمد بن محمد تقدم كل منهم فى بابه(@)(@@)(@@)(@@) $DIC_NIS$ 397 الخلنجي نسبة إلى الخلنج بفتح الخاء المعجمة وفتح اللام وسكون النون وفى آخرها الجيم نسبة عبد الله بن محمد بن أبي يزيد تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 398 الخمركي بضم الخاء وسكون الميم وفتح الراء المهملة وفى آخرها الكاف نسبة إلى خمرك من بلاد الشاش نسبة المؤمل بن مسرور(@)(@@)(@@)(@@) $DIC_NIS$ 399 الخميني بضم الخاء وفتح الميم وسكون الياء المثناة من تحتها وفى آخرها نون نسبة إلى خمين قرية من قرى سمرقند نسبة محمد بن يوسف وابنه يوسف تقدما رحمهما الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 401 الخوارزمي نسبة إلى البلدة المشهورة فتحها قتيبة بن مسلم الباهلي نسبة محمد بن أحمد ويعرف بالبرقي بفتح الباء والراء وفى آخرها القاف قال السمعاني نسبة إلى برق وهو بيت كبير من خوارزم انتقلوا إلى بخارى وسكنوها وهو بالفارسية ولد الشاه لأنه كان يبيع الحملان قال ابن ماكولا هكذا ذكر لي ابن ابنه عبد الله بن أبي بكر البرقاني(@)(@@)(@@)(@@) $DIC_NIS$ 402 الخواري بضم الخاء وفتح الواو وبعدها الألف وبعد الألف راء نسبة إلى الجد ونسبة إلى خوار الري وهى نسبة عبد الجبار بن عبد الكريم تقدم ومحمد بن عبد الجليل أيضا تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 403 الخواقندي بضم الخاء والواو وبعدها الألف وفتح القاف وسكون النون وفى آخرها دال مهملة نسبة إلى خواقند قرية من قرى فرغانه(@)(@@)(@@)(@@) $DIC_NIS$ 404 الخوميني بضم الخاء وسكون الواو وكسر الميم وسكون الياء آخر PageV02P304 الحروف وفى آخرها نون هذه النسبة إلى خومين نسبة القاسم بن محمد تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 405 الخلاطي نسبة محمد بن عباد بن ملك داد الإمام صدر الدين تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 406 الخياطي علاء الأئمة ذكره فى القنية الملقب بشيخ الإسلام تفقه على أبي إسحاق الحافظ اسمه سديد بن محمد كذا ضبطه الذهبي وقال روى عن فخر المشائخ علي بن محمد العمراني وعنه نجم الدين حسين بن محمد البارعي(@)(@@)(@@)(@@) $DIC_NIS$ 407 الخيزاخزى بفتح 
ms572	 الخاء وسكون الياء باثنتين من تحتها وفتح الزاي وسكون الألف وفتح الخاء الثانية وكسر الزاي الثانية نسبة إلى قرية خيزاخز من قرى بخارى نسبة أحمد بن عبد الله ومحمد بن محمد بن أحمد بن عبدالله(@)(@@)(@@)(@@) $DIC_NIS$ 408 الخيلاني حمزة بن علي بن المحسن(@)(@@)(@@)(@@) $DIC_NIS$ 409 الخيني بكسر الخاء المعجمة وبعدها الياء الساكنة المنقوطة باثنتين من تحتها وفى آخرها النون هذه النسبة إلى خين قرية من قرى طرطوس نسبة مظفر بن منصور قلت هكذا رأيت بخطي فى النسخة التى كتبتها من السمعاني بكسر الخاء ورأيت فى نسخة قابلها النواوي على أصل المصنف بفتح الخاء(@)(@@)(@@)(@@) || حرف الدال المهملة(@)(@@)(@@)(@@) $DIC_NIS$ 410 الداسي بفتح الدال وبعد الألف سين مهملة نسبة إلى داسة جد الحسن بن أحمد بن عبد الله بن أحمد بن بكر بن محمد بن عبد الرازق بن داسة البصري أبو علي PageV02P305(@)(@@)(@@)(@@) $DIC_NIS$ 411 الدامغاني بفتح الدال وسكون الألف وفتح الميم والغين المعجمة وسكون الألف وبعدها نون نسبه إلى دامغان مدينة ببلاد قومس نسبة قاضي القضاة أبي عبد الله الدامغاني وجماعة من ذريته(@)(@@)(@@)(@@) $DIC_NIS$ 412 الداودي نسبة أبي القاسم تقدم فى الكنى نسبة إلى داود الظاهري ونسبة إلى الجد(@)(@@)(@@)(@@) $DIC_NIS$ 413 الداوري نسبة محمد بن أبي بكر بن أبي الليث لم يذكرها السمعاني ولا الذهبي فى حرف الدال(@)(@@)(@@)(@@) $DIC_NIS$ 414 الدبوسي بفتح الدال وضم الباء الموحدة وبعدها واو ساكنة وسين مهملة نسبة إلى دبوسة وهى بلدة بين بخارى وسمرقند نسبة عبد الله بن عمر بن عيسى تقدم ونسبة أبي نصر تقدم فى الكنى(@)(@@)(@@)(@@) $DIC_NIS$ 415 الدارقزي نسبة يحيى بن محاسن وينسب أيضا يحيى هذا بالسقلاطوني ويأتي فى حرف السين(@)(@@)(@@)(@@) $DIC_NIS$ 416 الدرواجكي نسبة فخر الإسلام أحمد بن الحسن بن أحمد أبو نصر تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 417 الدستجردي بفتح الدال وسكون السين المهملتين وكسر التاء المثناة من فوقها الجيم وسكون الواو وفى آخرها الدال المهملة هذه النسبة إلى دستجرد اسم لعدة قرى ثنتان بمرو وقريتان بطوس وآخر ببلخ قرية كبيرة نسبة محمد بن علي ابن 
ms573	 عبد الله تقدم وهو من قرية بلخ(@)(@@)(@@)(@@) $DIC_NIS$ 418 الدسكري بفتح الدال وسكون السين المهملتين وفتح الكاف وفى آخرها الراء نسبة إلى دسكرة وهى قريتان أحدهما من أعمال بغداد على طريق خراسان يقال لها دسكرة الملك والثانية قريبة من نهر الملك من أعمال بغداد أيضا PageV02P306(@)(@@)(@@)(@@) $DIC_NIS$ 419 الدلري هو العلامة الزاهد الكبير شمس الدين الخطيب أحد شيوخ سراج الدين عمر بن إسحاق بن أحمد أبو حفص وتفقه الخطيب على أبي القاسم التنوخي عن حميد الدين الضرير عن الكردري عن صاحب الهداية(@)(@@)(@@)(@@) $DIC_NIS$ 420 الدلي هو ملك العلماء بدلى تفقه عليه سراج الدين عمر بن إسحاق الهندي المذكور الثقفي آنفا والثقفي تفقه على أبي القاسم التنوخي عن حميد الدين الضرير عن الكردري عن صاحب الهداية رحمهم الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 421 الدماوندي ناحية بين الري وطبرستان لم يذكر السمعاني هذه النسبة فى أنسابه وذكرها فى معجم شيوخه وقال الدماوندي الباركثي أحمد بن الحسين ابن علي قلت وقد تقدم فى الباركثي وفى باب أحمد بن الحسن(@)(@@)(@@)(@@) $DIC_NIS$ 422 الدميري بفتح الدال وكسر الميم وسكون الياء المثناة من تحتها وفى آخرها راء قرية بمصر نسبة جعفر بن الحسن بن إبراهيم(@)(@@)(@@)(@@) $DIC_NIS$ 423 الدهاسي بفتح الدال والهاء وبعد الألف سين مهملة نسبة إلى دهاس نسبة محمد بن عمر بن عبد الصمد المطيعي البلخي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 424 الدهستاني بكسر الدال المهملة والهاء وسكون السين المهملة وفتح التاء PageV02P307 المثناة من فوق وبعد الألف نون نسبة إلى دهستان مدينة مشهورة عند مازندران بناها عبد الله بن طاهر نسبة علي بن القاسم الإمام شهاب الدين ومحمد بن عبد الله وغيرهما(@)(@@)(@@)(@@) $DIC_NIS$ 425 الدهلوي اسمه محمود بن محمد ويلقب سعد الدين شرح المنار لحافظ الدين بكتاب سماه افاضة الأنوار فى اضاءة أصول المنار لم يذكرها السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 426 الدوركي الإمام حسام الدين درس بالحسامية وناب فى الحكم وكان فاضلا أديبا وفى ظني أنه كان اسمه الحسن ين محمد بن مصطفى ابن زكريا بن خواجه بن حسن الصلغري تقدم فى حرف 
ms574	 الحاء وأبوه محمد الملقب فخر الدين تقدم فى حرف الميم ودورك من بلاد الروم(@)(@@)(@@)(@@) $DIC_NIS$ 427 الديرقاني نسبة رحمة الله بن عبد الرحمن تقدم ولم يذكرها السمعاني(@)(@@)(@@)(@@) $DIC_NIS$ 428 الديناري بكسر الدال وسكون الياء المثناة من تحتها وبعدها نون PageV02P308 وألف وفى آخرها راء نسبة إلى ثلاثة أشياء إلى الجد وإلى قرية وإلى الدينار نسبة عبد الجبار بن أحمد تقدم وعبد الكريم بن يوسف أيضا تقدم وقرية الدينار بالقرب من استرأباد(@)(@@)(@@)(@@) || حرف الذال المعجمة(@)(@@)(@@)(@@) $DIC_NIS$ 429 الذحينوي بفتح الذال المعجمة وكسر الخاء المعجمة وسكون الياء المثناة من تحتها وفتح النون وفى آخرها الواو وهذه النسبة إلى قرية ذخينوي من قرى سمرقند نسبة عبد الوهاب بن الأشعث أبي محمد(@)(@@)(@@)(@@) || حرف الراء المهملة(@)(@@)(@@)(@@) $DIC_NIS$ 430 الرازي نسبة إلى الري مدينة كبيرة مشهورة من بلاد الديلم بين قومس والجبال وألحقوا الزاي فى النسب نسبة جماعة ونسب إليها أيضا ملك العلماء بالهند وجيه الدين تفقه عليه سراج الدين عمر بن إسحاق وتفقه وجيه الدين على الإمام العلامة شرف الدين التنوخي وتفقه التنوخي على الإمام حميد الدين الضرير البخاري وتفقه حميد الدين على الكردري وتفقه الكردري على صاحب الهداية رحمهم الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 431 الراشدي نسبه إلى قرية من نواحي بغداد اسمهما الراشدية قلت بفتح الراء وسكون الألف وكسر الشين المعجمة وفى آخرها دال مهملة(@)(@@)(@@)(@@) $DIC_NIS$ 432 الرافقي بفتح الراء وكسر الفاء وفى آخرها القاف نسبة إلى الرافقة نسبة محمد بن أحمد بن عبد الله بن موسى أبو الحسن تقدم وهى بلدة على الفرات PageV02P309(@)(@@)(@@)(@@) $DIC_NIS$ 433 الرامسي يأتي فى الغازي رحمه الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 434 الرامشي بفتح الراء وضم الميم وفى آخرها الشين المعجمة نسبة إلى رامش من بخارى نسبة إلى الجد وإلى القرية ينسب إليها علي بن محمد بن علي صاحب الترجمة أي حميد الدين الضرير البخاري الإمام رحمه الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 435 الرحبي بفتح الراء وآخرها باء موحدة بينهما الحاء هذه النسبة إلى الرحبة بطن من حمير نسبة علي بن محمد بن أحمد أبي 
ms575	 القاسم الملقب بإبن السمناني رحمه الله(@)(@@)(@@)(@@) $DIC_NIS$ 436 الرستغفني بضم الراء وسكون السين المهملة وضم التاء ثالث الحروف وسكون الغين المعجمة وفى آخرها النون بعدها الفاء نسبة إلى رستغفن قرية من قرى سمرقند اسمه علي بن سعيد أبو الحسن ذكره بنسبته الخاصي وغيره من الأصحاب فى مسئلة حوض صغير يدخل الماء من جانب ويخرج من جانب إذا توضأ فيه إنسان وذكره الأصحاب ايضا فى كتب الأصول والخلاف بينه وبين أبي منصور الماتريدي معروف فى مسئلة المجتهد إذا أخطأ فى إصابة الحق يكون مخطيا فى الاجتهاد على كل حال أصاب الحق أو لم يصب وقد روى عن أبي حنيفة رضي الله عنه أنه قال كل مجتهد مصيب والحق عند الله واحد معناه أنه مصيب فى الطلب وإن أخطأ المطلوب وله الفوائد أيضا قال أبو الحسن رأيت الإمام المهدي أبا منصور الماتريدي معروف في مسئلة المجتهد إذا أخطأ في إصابة الحق يكون مخطيا في الاجتهاد على كل حال اصاب الحق أو لم يصب وقد روي عن أبي حنيفة رضي الله عنه انه قال كل مجتهد مصيب والحق عند الله واحد معناه انه مصيب في الطلب وان اخطأ المطلوب وله الفوائد أيضا قال أبو الحسن رأيت الامام المهدي أبا منصور الماتريدي فى المنام فقال يا أبا الحسن ألم تر أن الله غفر لامرأة لم تصل قط فقلت بماذا قال باستماع الآذان وإجابة المؤذن(@)(@@)(@@)(@@) $DIC_NIS$ 437 الرسمني بفتح الراء وسكون السين المهلمة وفتح العين المهملة وفى آخرها النون نسبة إلى مدينة رأس عبن نسبة عبد الرزاق بن رزق الله تقدم PageV02P310(@)(@@)(@@)(@@) $DIC_NIS$ 438 الراشداني نسبة إلى رشدان بكسر الراء وسكون الشين المعجمة وفتح الدال المهملة من بلاد فرغانة نسبة جماعة رحمهم الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 439 الرشيدي بفتح الراء وكسر الشين المعجمة وسكون الياء المثناة من تحتها وفى آخرها دال مهملة هذه النسبة إلى شيئين أحدهما إلى بلدة بمصر على ساحل البحر والثاني إلى الرشيد أمير المؤمنين نسبة عبد المعطي بن مسافر ابن يوسف أبو محمد 
ms576	 المفاعي تقدم ويأتي فى المفاعي أيضا رحمه الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 440 الرعيني بضم الراء وفتح العين بعدها التاء الساكنة آخر الحروف وفى آخرها النون نسبة إلى رعين من جبال اليمن نسبة محمد بن عبدون تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 441 الركابي السيد الشريف اسمه علي عرف بمزلقان تقدم فى آخر باب علي بن محمد بن الحسن وكان عنده ركاب النبي صلى الله عليه وسلم فنسب إليه(@)(@@)(@@)(@@) $DIC_NIS$ 442 الرمجاري بفتح الراء وسكون الميم وفتح الجيم وبعد الألف راء هذه النسبة إلى رمجار محلة كبيرة بنيسابور نسبة الحسن بن أيوب أبي علي النيسابوري تقدم رحمه الله تعالى(@)(@@)(@@)(@@) $DIC_NIS$ 443 الرملي نسبة إلى مدينة الرملة بن بلاد الطرف بالشام بفتح الراء وسكون الميم وفي آخرها لام(@)(@@)(@@)(@@) $DIC_NIS$ 444 الرنغدموي ذكره فى القنية ولم يذكر السمعاني هذه النسبة(@)(@@)(@@)(@@) $DIC_NIS$ 445 الرومي بضم الراء وسكون الواو وفى آخرها ميم نسبة إلى بلاد الروم(@)(@@)(@@)(@@) $DIC_NIS$ 446 الريغذموني بكسر الراء وسكون الياء آخر الحروف والغين المعجمة وفتح الذال المعجمة وضم الميم وسكون الواو وفى آخرها نون نسبة إلى ريغذمون وهى قرية من قرى بخارى نسبة أحمد بن عبد الرحمن بن إسحاق تقدم وتلقب بالقاضي PageV02P311 الجمال وابنه محمد وابن ابنه أحمد بن محمد تقدم كل واحد فى بابه أهل بيت علماء فضلاء(@)(@@)(@@)(@@) || حرف الزاي(@)(@@)(@@)(@@) $DIC_NIS$ 447 الزاهدي يأتي هذه النسبة فى الألقاب(@)(@@)(@@)(@@) $DIC_NIS$ 448 الزجاجي تقدم الكلام على هذه النسبة فى الكنى فى ترجمة أبي سهل(@)(@@)(@@)(@@) $DIC_NIS$ 449 الزرنجري بفتح الزاي والراء وسكون النون وفتح الجيم وفى آخرها راء نسبة إلى زرنجر وقيل زرنكر وهى قرية من قرى بخارى نسبة عمر بن بكر وابنه(@)(@@)(@@)(@@) $DIC_NIS$ 450 الزرنوجي النعمان بن إبراهيم تقدم والزرنوجي أيضا برهان الإسلام تلميذ صاحب الهداية يأتي فى الألقاب وهو فى طبقة النعمان بن إبراهيم الزرنوجي(@)(@@)(@@)(@@) $DIC_NIS$ 451 الزعفراني عرف بذلك الإمام ابن الإمام أحمد بن محمد بن أحمد بن محمد ابن عبدوس بفتح الزاي وسكون العين المهملة وفتح الفاء والراء المهملة نسبة إلى الزعفرانية قرية بقرب بغداد 
ms577	 وإلى بيع الزعفران وإلى قرية بين همدان واسترأباد إلى المذهب وهم الزعفرانية من البخارية ينسبون إلى رئيس لهم يقال له الزعفراني من مذهبه أن القرآن محدث(@)(@@)(@@)(@@) $DIC_NIS$ 457 الزفتاوي نسبة محمد بن عبد الرحمن الأعرج(@)(@@)(@@)(@@) $DIC_NIS$ 458 الزمخشري بفتح الزاي والميم وسكون الخاء المعجمة وفتح الشين المعجمة وفى آخرها الراء نسبة إلى زمخشر من بلاد خوارزم نسبة الإمام محمود بن عمر بن محمد PageV02P312(@)(@@)(@@)(@@) $DIC_NIS$ 454 الزببي نسبة أحمد بن عيسى تقدم نسبة إلى زيب قرية على ساحل بحر الروم قريب من عكا ولا أدري بالنون أو الباء كذا قال السمعاني قال ابن الأثير والصحيح أنها بالباء لا غير(@)(@@)(@@)(@@) $DIC_NIS$ 455 الزندخاني بفتح الزاي وسكون النون وفتح الدال المهملة والخاء المعجمة وفى آخرها نون هذه النسبة إلى زندخان وهى قرية بنواحي سرخس نسب إليها جماعة منهم نعمان بن عبد الجبار تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 456 الزندرامشي لم يذكر السمعاني هذه النسبة نسبة عمر بن حبيب بن علي أبو حفص القاضي جد صاحب الهداية(@)(@@)(@@)(@@) $DIC_NIS$ 457 الزندوردي بفتح الزاي وسكون النون وفتح الدال المهملة وفتح الواو وسكون الراء وفى آخرها دال مهملة نسبة إلى زندورد قرية ببغداد وبالذال المعجمة الأولة نهر كبير على باب أصبهان نسبة محمد بن عمر بن الحسين 2 تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 458 الزندويسني لم يذكر السمعاني هذه الترجمة قال الخاصي فى فتاواه وذكر فى روضة الزندويسني إذا أذن يعني الذمي فى وقت الصلاة يصير مسلما لأنه أتى بدليل الإسلام وإن لم يكن فى وقت الصلاة لا يصير مسلما لأنه فى غير أوانه ليس دليلا على الإسلام وله النظم ذكره فى القنية قلت واسمه علي بن يحيى(@)(@@)(@@)(@@) $DIC_NIS$ 459 الزواوي نسبة يحيى بن عبد المعطي بن عبد النور الملقب زين الدين تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 460 الزوزني بسكون الواو بين الزايين وفى آخرها النون نسبة إلى زوزن بلدة كبيرة بين هراة ونيسابور صاحب ملتقى البحار اسمه محمد بن محمود بن محمد أبو المفاخر السديدي وابنه عبد العزيز تقدما وأحمد بن محمد بن إبراهيم PageV02P313 تقدم 
ms578	 أيضا(@)(@@)(@@)(@@) $DIC_NIS$ 461 الزيات بفتح الزاي وتشديد الياء بعد الألف تاء باثنتين من فوقها نسبة إلى بيع الزيت(@)(@@)(@@)(@@) $DIC_NIS$ 462 الزيادي بكسر الزاي وفتح الياء وبعد الألف دال مهملة نسبة إلى الجد نسبة أسعد بن علي بن الموفق بن زياد أبي المحاسن تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 463 الزيركي نسبة محمد بن عبد الكريم بن عبد أبو البديع الإمام تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 464 الزينبي يفتح الزاي وسكون الياء وفتح النون وفى آخرها باء موحدة اشتهر بهذه النسبة شيخ الإسلام قاضي القضاة أحمد بن محمد بن صاعد بن محمد أبو نصر الدستوائي وطراد بن محمد أبو الفوارس نسبة إلى زينب بنت سليمان ابن علي بن عبد الله بن العباس رضي الله عنهما(@)(@@)(@@)(@@) || حرف السين المهملة(@)(@@)(@@)(@@) $DIC_NIS$ 465 السابري بفتح السين وسكون الألف وفتح الباء الموحدة وفى آخرها الراء نسبة إلى نوع من الثياب يقال لها السابري نسبة إسماعيل بن سبيع الحنفي الكوفي(@)(@@)(@@)(@@) $DIC_NIS$ 466 الساغرجي بفتح السين المهملة والغين المعجمة وسكون الراء فى آخرها الجيم وقد يقال بالصاد نسبة إلى ساغرج قرية من قرى السغد علي خمسة فراسخ من سمرقند(@)(@@)(@@)(@@) $DIC_NIS$ 467 الساوي نسبة عبيد الله بن محمد بن عبد الجليل أبو محمد بن أبي محمد بن أبي الفتح أبي سعيد القاضي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 468 السايلي الملقب سيف الأئمة الحافظ قال لا بأس بتجرد الزوجين وقت الجماع PageV02P314(@)(@@)(@@)(@@) $DIC_NIS$ 469 السبخي نسبة محمد بن أبي بكر بن عثمان بن محمد بن أحمد الصابوني البزدوي أبو طاهر الزاهد نسبة إلى السبخة وهى معروفة(@)(@@)(@@)(@@) $DIC_NIS$ 470 السبذموني نسبة عبد الله بن محمد بن يعقوب الحارث الحارثي تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 471 السبيعي نسبة إلى سبيع بطن من همدان بفتح السين المهملة وكسر الباء الموحدة بعدها ياء باثنتين من تحتها وفى آخرها عين مهملة(@)(@@)(@@)(@@) $DIC_NIS$ 472 السجاوندي محمد بن محمد بن عبد الرشيد أبو طاهر تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 473 السجزي بكسر السين المهملة وسكون الجيم وفى آخرها زاي هذه النسبة إلى سجستان على غير قياس وهى اقليم ومداين واسم قصبة زريح وهى 
ms579	 بين السند وكرمان قاله الذهبي(@)(@@)(@@)(@@) $DIC_NIS$ 474 السرخسي نسبة إلى مدينة سرخس من بلاد خراسان لم يقيدها ابن الأثير بأكثر من هذا فى ختصر السمعاني ورأيت بخط الشيخ تاج الدين بن مكتوم والأعرف فيها فتح الراء واسكان الخاء وقال أيضا باسكان الراء وفتح الخاء المعجمة وفى خط ابن مكتوم قال ابن الصلاح ولما دخلتها سمعت شيخها ومفتيها يذكر أنها بفتح الراء فارسية وباسكانها معربة وقال سمعت ذلك من المعتمدين الثقات والسين على كل حال مفتوحة ولم يصنع القاضي أبو بكر ابن العربي شيأ قلت كذا رأيت بخط ابن مكتوم أن السمعاني قيدها باسكان الراء وفتح الخاء المعجمة فلم يقيدها ابن الأثير فى مختصره فيحتمل أن الشيخ نقله من الأصل وهى نسبة شمس الأئمة محمد بن أحمد بن أبي سهل أبو بكر(@)(@@)(@@)(@@) $DIC_NIS$ 475 السرخكتي بضم السين وسكون الراء وفتح الخاء المعجمة والكاف وفى آخرها التاء ثالث الحروف هذه النسبة إلى سرخكت وهى قرية ثغر حسان بسمرقند ينسب إليها محمد بن عبد الله بن فاعل الإمام أبو بكر تقدم PageV02P315(@)(@@)(@@)(@@) $DIC_NIS$ 476 السرخكي بضم السين وسكون الراء وفتح الخاء المعجمة وفى آخرها كاف هذه النسبة إلى سرخك قرية على باب نيسابور ينسب إليها أحمد بن عبد الرحمن أبو أحمد النيسابوري(@)(@@)(@@)(@@) $DIC_NIS$ 477 السردري نسبة علي بن الحسن بن عبد الرحمن القاضي أبو الحسن البخاري تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 478 السرماري نسبة رمضان بن الحسن تقدم وأحمد بن عبد الله تقدم أيضا وهى بضم السين المهملة وسكون الراء وفتح الميم وسكون الألف وفى آخرها راء ثانية هذه النسبة إلى سرمار قرية من قرى بخارى(@)(@@)(@@)(@@) $DIC_NIS$ 479 السروجي بفتح السين المهملة والراء المهملة المضمومة والواو الساكنة والجيم نسبة إلى سروج مدينة بنواحي حران من بلاد الجزيرة نسبة أحمد بن إبراهيم بن عبد الغني أبو العباس قاضي القضاة بمصر تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 480 السعدي بفتح السين المهملة وسكون العين وفى آخرها الدال مهملتان نسبة إلى عدة قبائل(@)(@@)(@@)(@@) $DIC_NIS$ 481 السغدي بضم السين المهملة وسكون الغين المعجمة وفى آخرها 
ms580	 دال مهملة هذه النسبة إلى السغد وهى ناحية كثيرة المياه والأشجار من نواحي سمرقند ينسب إليها علي بن الحسين بن محمد القاضي أبو الحسين وغيره(@)(@@)(@@)(@@) $DIC_NIS$ 482 السغناقي نسبة الحسين بن علي بن الحجاج الملقب حسام الدين الإمام تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 483 السفسقي نسبة عمر بن محمد بن إسماعيل تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 484 السفسيني نسبة شعيب بن إبراهيم لم يذكرها السمعاني PageV02P316(@)(@@)(@@)(@@) $DIC_NIS$ 485 السفكردري قال الخاصي ذكر أبو حفص السفكردري فى مختصر غريب الرواية ولم يذكر السمعاني هذه النسبة فى كتابه(@)(@@)(@@)(@@) $DIC_NIS$ 486 السفلاطوني نسبة يحيى بن محاسن بن يحيى بن رفاعة أبو زكريا ويقال له الدراقزي المذكور فى حرف الدال(@)(@@)(@@)(@@) $DIC_NIS$ 487 السكاكي الإمام يوسف بن أبي بكر بن محمد أبو يعقوب الخوارزمي سراج الدين تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 488 السكري بضم السين المهملة وفتح الكاف المشددة وفى آخرها الراء نسبة إلى بيع السكر(@)(@@)(@@)(@@) $DIC_NIS$ 489 السكلكندي نسبة علي بن الحسين بن محمد البلخي تقدم(@)(@@) السكوني بفتح السين وضم الكاف وسكون الواو وفى آخرها نون بطن من كندة كذا قاله السمعاني وذكر ايضا السكنى بفتح السين والكاف وفى آخرها نون ينسب إلى الجد ويقال لهم السكون نسبة أحمد بن محمد بن عيسى بن يزيد بن السكن أبو جعفر السكنى تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 490 السلعري نسبة الحسن بن يلنكري بن عمر تقدم(@)(@@)(@@)(@@) $DIC_NIS$ 491 السلمقاني بفتح السين المهملة وسكون اللام وضم الميم وفتح القاف وبعد الألف نون هذه النسبة إلى سلمقان ويقال لها بالعجمية سلمكان من قرى سرخس(@)(@@)(@@)(@@) $DIC_NIS$ 492 السليمي بضم السين وفتح اللام نسبة إلى سليم بن منصور بن عكرمة بن جعفر بن قيس عيلان بن نصر قبيلة مشهورة والسلمي بفتح السين المهملة واللام نسبة إلى سلمة بطن من الأنصار وبفتح السين وسكون اللام نسبة إلى الجد وهو إبراهيم بن سلم أبو إسحاق تقدم وهو الشكاني ويأتي فى PageV02P317 حرف الشين(@)(@@)(@@)(@@) $DIC_NIS$ 493 السمتي بفتح السين وسكون الميم وفى آخرها تاء معجمة باثنتين من فوقها هذه النسبة إلى السمت والهيئة نسبة خالد بن يوسف 