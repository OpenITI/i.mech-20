ms41	 من الغرس % الذي عندك يا ذخري % % 24(@)(@@) % فقدما يا لك الخير % غرست الود في صدري % % 25(@)(@@) % وفي غرسك إن جدت % به معنى وفي صهري % % PageV01P203 البحر : مجزوء الكامل 1(@)(@@) % حلل الشبيبة مستعارة % فدع الصبا واهجر دياره % 2(@)(@@) % لا يشغلنك عن العلا % % خود تمنيك الز ياره % 3(@)(@@) % خود تطيب طيبها % % ويزيد ساعدها سواره % 4(@)(@@) % يحلو أوائل حبها % % ويشوب آخره مراره % 5(@)(@@) % ما عذر مثلك خالعا % في سكر لذته عذاره % 6(@)(@@) % من بعد ما شد الأش % د على تلابيه إزاره % 7(@)(@@) % من ساد في عصر الشبا % % ب غدت لسؤدده غفاره % 8(@)(@@) % مالفخر أن يغدو الفتى % % متشبعا ضخم الحراره % 9(@)(@@) % كلفا بشرب الراح مشغو % فا بغزلان الستاره % 10(@)(@@) % مهجورة عرصاته % لا تقرب الأضياف داره % PageV01P204 11(@)(@@) % الفخر أن يشجي الفتى % % أعداءه ويعز جاره % 12(@)(@@) % ويذب عن أعراضه % ويشب للطراق ناره % 13(@)(@@) % ويروح إما للإما % % رة سعيه أو للوزاره % 14(@)(@@) % فرد الكتابة والخطا % % بة والبلاغة والعباره % 15(@)(@@) % متيقظ العزمات يجتن % ب الكرى إلا غراره % 16(@)(@@) % فكأنه من حدة % ونفاد تدبير شرره % 17(@)(@@) % حتى يخاف ويرتجى % % ويرى له نشب وشاره % 18(@)(@@) % في موكب لجب كأ % % ن الليل ألبسه خماره % 19(@)(@@) % تزهى به عصب تنف % ض عن مناكبه غباره % 20(@)(@@) % ويطيل أبناء الرغا % % ئب في مشاكله انتظاره % PageV01P205 21(@)(@@) % فادأب لمجد حادث % أو سالف يعلي مناره % 22(@)(@@) % واعمر لنفسك في العلا % % حالا وكن حسن العماره % 23(@)(@@) % واقمر لها سوقا ينف % فقها وتاجرها تجاره % 24(@)(@@) % % أمرا يخاف الحر عاره % 25(@)(@@) % وإذا عدمت من المآ % % كل خيرها فكل الحجاره % PageV01P206 البحر : رجز تام 1(@)(@@) % وليلة فيها قصر % عشاؤها مع السحر % 2(@)(@@) % صافية من الكدر % تقضى ولم يقض الوطر % 3(@)(@@) % وحيا كلمح بالبصر % أو خطرة من الخطر % 4(@)(@@) % في مثلها التذ السهر % واستوطن الجنب الأبر % 5(@)(@@) % تمحو إساءات القدر % وتترك الدهر أغر % 6(@)(@@) % لهوت فيها مستتر % من طارق على خذر % 7(@)(@@) % حيران من فرط الذعر % إلا الدلال والخفر % 8(@)(@@) % ونفحة النشر العطر % أنسته حين استقر % 9(@)(@@) % هنيته ثم سفر % عن دعج وعن حور 
ms42	 % 10(@)(@@) % وعارض مثل القمر % يلوح في ليل الشعر % PageV01P207 11(@)(@@) % لا يستفي منه النظر % لو صوبوه لقطر % 12(@)(@@) % ومبسم عذب الأثر % فيه مع الطيب خصر % 13(@)(@@) % أذيب من خمر ودر % يا مرحبا حين حضر % 14(@)(@@) % فارتاح مشتاق وسر % سرور أرض بمطر % 15(@)(@@) % أو عين أعمى بنظر % أنكرت شيئا فاعتذر % 16(@)(@@) % ثم اعتذرت فشكر % ثم نشجت فزفر % 17(@)(@@) % ثم لثمت فنفر % نفر الظباء إن نهر % 18(@)(@@) % ثم تجاذبنا الأزر % فلا تسل عن الخبر % 19(@)(@@) % ثم تأنى فنفر % يا قرب ورد من عذر % 20(@)(@@) % ما إن دنا حتى سطر % ولا وفى حتى غدر % PageV01P208 21(@)(@@) % ولي إذا الهم عصر % وجاش بحر وزخر % 22(@)(@@) % عزم على الهوى ممر % وهمة ذات كبر % 23(@)(@@) % مع السماك والمجر % بمثلها أمري ممر % 24(@)(@@) % وسابح نهد طمر % لو سابق الريح ظهر % 25(@)(@@) % أو ساجل البرق فخر % أو كاثر البحر كثر % 26(@)(@@) % أو بادر السيل بدر % أو هم بالليل اعتكر % 27(@)(@@) % لولا الحجول والغرر % ومطلق الحد ذكر % 28(@)(@@) % عضب بمتنيه أثر % مد الفرند وزجر % 29(@)(@@) % فيه كما مد النهر % كما التقى نمل وذر % 30(@)(@@) % وكاسيات تنتظر % شتى الشيات كالحبر % PageV01P209 31(@)(@@) % هيم إلى الصيد ضمر % من كل مغوار أشر % 32(@)(@@) % يصم مأمول الظفر % غار على الوحش مكر % 33(@)(@@) % يعيرها ولا يغر % خلا فإن راعت كشر % 34(@)(@@) % مسجيا لما هصر % أخذ عزيز مقتدر % 35(@)(@@) % من غير أن يدمى الثغر % منه بنان أو ظفر % 36(@)(@@) % والصبح لما ينفجر % والبركات في البكر % 37(@)(@@) % في زمرة خير زمر % من نفر أي نفر % 38(@)(@@) % من آل ساسان صبر % على تصاريف الغير % 39(@)(@@) % قد جلبوا الدهر درر % وجربوا حلوا ومر % 40(@)(@@) % موافقين في الحضر % مساعدين في السفر % PageV01P210 41(@)(@@) % ألهاهم عن الوتر % وشدو غزلان الستر % 42(@)(@@) % نحو وشعر وخبر % ومسند من الأثر % 43(@)(@@) % ويوم فخر يدكر % فأنت منهم في غمر % 44(@)(@@) % يحيي ويغذي بالفكر % وملح من الفقر % 45(@)(@@) % يطير منهن الشرر % يا لك من قول خطر % 46(@)(@@) % كالعقد حل فانتشر % عروض قول مشتهر % 47(@)(@@) % سار لأدنى من شعر :(@)(@@) % وبلدة 
ms43	 فيها زور ) % PageV01P211 البحر : كامل أحذ 1(@)(@@) % باكر فهذي صبيحة قره % واليوم يوم سماؤه ثره % 2(@)(@@) % ثلج وشمس وصوب غادية % فالأرض من كل جانب غره % 3(@)(@@) % باتت وقيعانها زبرجدة % وأصبحت قد تحولت دره % 4(@)(@@) % كأنها الثلوج تضحكها % % تغار ممن أحبه ثغره % 5(@)(@@) % كأن في الجو أيديا نثرت % وردا علينا وأسرعت نثره % 6(@)(@@) % شابت فسرت بذاك وابتهجت % وكان عهد المشيب تكره % 7(@)(@@) % فاشرب على الثلج من مشعشعة % كأنها في إنائها جمره % 8(@)(@@) % قد جليت بالبياض بلدتنا % % فاجل علينا الكؤوس في الخمره % PageV01P212 البحر : كامل تام 1(@)(@@) % بيض لبسن حدادهن لمأتم % فلبسن منه الليل وق نهار % 2(@)(@@) % ولطمن منهن الخدود تأسيا % وسكبن دمعا كاللجين الجاري % % 3(@)(@@) % فكأنما تلك الخدود بنفسج % وكأنما تلك البنان دراري % % PageV01P213 البحر : كامل تام 1(@)(@@) % غدر الزمان وجار في أحكامه % والدهر عين الخائن الغدار % 2(@)(@@) % ورزيت أعلاقا علي كريمة % من قبل أن تقضى بها أوطاري % % 3(@)(@@) % وفجعت بالقمري فجعة ثاكل % فققدت منه أمتع السمار % 4(@)(@@) % لون العمامة لونه ومناسبق % % في خلقة الأقلام بالمنقار % 5(@)(@@) % ومطوق من صنع خلقة ربه % طوقين خلتهما من النوار % 6(@)(@@) % ولطالما استغنيت في غسق الدجا % % بهديلة من مطرب الأوتار % 7(@)(@@) % هزج الأصائل تستحث كؤوسنا % % وتقيمنا للفرض بالأسحار % 8(@)(@@) % لهفي على القمري لهفا دائما % يكوي الحشا بجوى كلذع النار % 9(@)(@@) % ولقد هجرت الصبر بعد فراقه % ولقد مزجت دما بدمع جار % 10(@)(@@) % ما كنت في الأطيار واحد مثله % % هيهات أودي سيد الأطيار % PageV01P214 البحر : وافر تام 1(@)(@@) % وصفر من بنات النحل تكسى % % بواطنها وأظهرها عواري % % 2(@)(@@) % عذارى يفتضضن من العوالي % % إذا افتضت من الظل العذاري % % 3(@)(@@) % وليست تنتج الأضواء حتى % % تلقح في ذوائبها بنار % 4(@)(@@) % كواكب لسن عنك بآفلات % إذا ما أشرقت شمس العقار % 5(@)(@@) % بعثت بها إلى ملك كريم % شريف الأصل محمود النجار % 6(@)(@@) % فأهديت الضياء بها إلى من % محاسنه تضيء لكل سار % PageV01P215 البحر : طويل 1(@)(@@) % عرضن فعرضن القلوب من الأذى % % لأسرع من كي القلوب من الجمر % 2(@)(@@) % كأن الشفاه اللعس منها خواتم % من التبر مختوم بهن على الدر 
ms44	 % PageV01P216 البحر : كامل تام 1(@)(@@) % من شك في فضل الكميت فبينه % فيه وبين يقينه المضمار % 2(@)(@@) % من منظر مستحسن محمودة % آثاره إذ تبتلى الأخبار % 3(@)(@@) % ماء تدفق طاعة وسلاسة % فإذا استدر الخضر منه فنار % 4(@)(@@) % فإذا عطفت به على بارودة % لترده فكأنه بركار % 5(@)(@@) % وصف الخلوق أديمه فكأنما % % أهدى الخلوق لجسمه عطار % 6(@)(@@) % قصرت قلادة نحره وعذاره % والرسغ وهي من العتيق قصار % 7(@)(@@) % فكأنما هاديه جزع مشرف % وكأنما للضب فيه وجار % 8(@)(@@) % يرد الضحاضح عير ثان سنبكا % ويرد خلفك طرفه فتحار % 9(@)(@@) % لو لم يكن للخيل نسبة خلقه % خالته من أشكالها الأطيار % PageV01P217 البحر : متقارب تام 1(@)(@@) % وجارية مثل شمس النهار % أو البدر بين النجوم الدراري % % 2(@)(@@) % أتتك تميس بقد القضيب % وترنو بعين مهاة القفار % 3(@)(@@) % وترفل في مصمت أبيض % تلون في خدها الجلنار % 4(@)(@@) % وتحمد عودا فصيح الجواب % يشارك أرواحنا في المجاري % % 5(@)(@@) % له عنق كذراع الفتاة % ودستانه بمكان السوار % 6(@)(@@) % فجادت عليه وجادت له % بعسف اليمين ولطف اليسار % 7(@)(@@) % فلا أمهلته ولا نهنهته % من الظهر حتى انقضاء النهار % 8(@)(@@) % فلما تغنت غناء الوداع % بكيت وقلت لبعض الجواري % % 9(@)(@@) % لئن عشت عند هزار الغناء % لقد مت عند هزار الإزار % PageV01P218 البحر : بسيط تام 1(@)(@@) % روح من الماء في جسم من الصفر % مؤلف بلطيف الحس والنظر % 2(@)(@@) % مستعبر لم يغب عن إلفه وطن % ولم يبت قط من ضغن على حذر % 3(@)(@@) % له على الظهر أجفان محجرة % ومقلة دمعها يجري على قدر % 4(@)(@@) % تنسى له حركات في أسافله % كأنها حركات الماء في الشجر % 5(@)(@@) % وفي أعاليه حسبان مفصلة % للناظرين بلا ذهن ولا فكر % 6(@)(@@) % إذا بدا دان في أحشائه فلك % خافي المسير وإن لم يبد لم يدر % 7(@)(@@) % مخير عن مواقيت يخبرنا % % عنها فيوجد منها صادق الخبر % 8(@)(@@) % تقضي به الخمس في وقت الوجوب وإن % عطى على الشمس شر الغيم والمطر % 9(@)(@@) % وإن سهرت ففي الأسباب تورقني % % عرفت مقدار ما ألقى من السهر % 10(@)(@@) % محدد كل ميقات تخيره % ذوو التخير للأسفار والخطر % PageV01P219 11(@)(@@) % ومخرج 
ms45	 لك بالأجزاء ألطفها % % من النهار وقوس الليل والسحر % 12(@)(@@) % نتيجة العلم والتفكير صورته % يا حبذا بدع الأفكار في الصور % PageV01P220 البحر : كامل تام 1(@)(@@) % قم قد أتى ضوء الصباح المسفر % ياصاح فاغتنم الهوى وتبكر % 2(@)(@@) % فالمم بتين لذ طعما واكتسى % % حسنا وقارب منظرا من مخبر % 3(@)(@@) % كالثلج بردا في اصفرار التبر في % % ريح العبير وفوق طعم السكر % 4(@)(@@) % لطفت معانيه لطافة عاشق % في لون مشتاق حليف تفكر % 5(@)(@@) % يحكي إذا ما صف في أطباقه % خيما ضربن من الحرير الأصفر % PageV01P221 البحر : رجز تام 1(@)(@@) % ململمات من كراة التبر % معتنقات لرقيق الخضر % 2(@)(@@) % بنكهة العطر وفوق العطر % أجود من نشق سلاف الخمر % 3(@)(@@) % مشتملات بثياب صفر % تزورنا في القصر بعد العصر % PageV01P222 البحر : سريع 1(@)(@@) % ما بال طفشيلك قد أخرت % عنا وما نعهد تأخيرا % % 2(@)(@@) % فهاتها في حليها تجتلى % % كالروض إذ صور تصويرا % % 3(@)(@@) % زخارف الوشي وألوانه % تبرا من الجوهر منشورا % 4(@)(@@) % والخرز الغض بأرجائها % % يحكي لنا فيه الدنانيرا % % 5(@)(@@) % وأخضر يضحك في أصفر % كأنما واجه مهجورا % % 6(@)(@@) % والبيض فيها نرجس نثره % في فضة قدر تقديرا % % 7(@)(@@) % خبيصة صفراء لكنها % % تحوي من النبت عقاقيرا % % PageV01P223 البحر : - 1(@)(@@) % ووصائف صفت على ذي أربع % مما عني بصنيع التجار % 2(@)(@@) % وسمت وسوم الريح في لياتها % % فتحيرت في حسنها الأبصار % 3(@)(@@) % فكأنما آذانهن صوالج % وكانما أقدامها أقمار % PageV01P224 البحر : منسرح 1(@)(@@) % كأنما النار والرماد وقد % كاد يواري من جسمها النورا % % 2(@)(@@) % ورد جنى القطاف تحسب قد % ذرت عليه الأكف كافورا % % PageV01P225 البحر : رجز تام 1(@)(@@) % دواء الثمل المخمور % رشف شراب شبم مقرور % 2(@)(@@) % رق كدمع العاشق المهجور % في قعر كيزان من الصخور % 3(@)(@@) % ترفع قضبانا من البلور % من نفس مثل جنى الكافور % PageV01P226 البحر : رجز تام 1(@)(@@) % وزائر زار وقد تعطرا % % أسر شهدا وأذاع عنبرا % % 2(@)(@@) % واستكثرت منه المهاة سكرا % ينفث في الآناف مسكا أذفرا % % 3(@)(@@) % ملتحفا للحر ثوبا أصفرا % % معمدا من الحرير أخضرا % % 4(@)(@@) % يحسبه الناظر إن تقررا % % دب الدبا بمنته فأثرا % % 5(@)(@@) % أبا علي فاحضرنه كي ترى % % واكتب علي إذا 
ms46	 كذبت محضرا % % PageV01P227 البحر : رجز تام 1(@)(@@) % ململمين فوق جرف هار % قد نحتا وشبهني في نجار % 2(@)(@@) % دارا كمثل الفلك الدوار % وأسبلا ذيلا من الغبار % 3(@)(@@) % فنحن في رفدهما المدرار % في نعم صافية الأقطار % PageV01P228 البحر : كامل تام 1(@)(@@) % مازلت في سكري أخمش كفها % % وذراعها بالقرص والآثار % 2(@)(@@) % حتى تركت أديمها وكأنما % % غرس البنفسج منه في الجمار % PageV01P229 البحر : سريع 1(@)(@@) % كأنما النارنج لما بدت % أغصانه في الورق الخضر % 2(@)(@@) % زمرد أبدي لنا أنجما % معجونة من خالص التبر % 3(@)(@@) % إذا تحيانا بها خلتنا % % نستنشق المسك من الجمر % PageV01P230 البحر : متقارب تام 1(@)(@@) % تأخرت حتى كددت الرسول % وحتى سئمت من الإنتظار % 2(@)(@@) % وأوحشت إخوانك المبعدين % وفجعتهم بشباب النهار % 3(@)(@@) % وأضرمت بالجوع احشاءهم % بنار تزيد على كل نار % 4(@)(@@) % فإن كنت تأمل إلا لحي % % فأنت وحقك عين الخمار % PageV01P231 البحر : خفيف تام 1(@)(@@) % داو خماري بكأس خمر % وأحي سكر الهوى بسكر % 2(@)(@@) % وروق المزج ذوب در % وشعشع الراح ذوب تبر % 3(@)(@@) % مدامة عتقت فجاءت % كلمع برق وضوء فجءر % 4(@)(@@) % رقت فكانت كماء ديني % % وماء وجهي وماء شعري % % 5(@)(@@) % لا تفن عمر الزمان إلا % ما بين قلاية وقمري % % 6(@)(@@) % يا دير مران كم غزال % فيك وكم جنة وزهر % 7(@)(@@) % فكم تطربت مستهاما % إليك إذ عيل فيك صبري % % 8(@)(@@) % وفي يميني شمال شمس % وفي شمالي يمين بدر % 9(@)(@@) % حكت أكف الرياح ليلا % بروضة خيط كل قطر % 10(@)(@@) % كأن دولابها محب % يحن والدمع منه يجري % % PageV01P232 11(@)(@@) % ثم تحلت ضحى وأبدت % عرائسا من حلى وزهر % 12(@)(@@) % فالنور والظل في رباه % ما بين نظم وبين نثر % 13(@)(@@) % كالدمع قد حار في خدود % من حمر وردية وصفر % 14(@)(@@) % ورب يوم قطعت فيه % عظيم قدر جليل ذكر % 15(@)(@@) % أحسن من يوم مهرجان % ويوم اضحى ويوم فطر % 16(@)(@@) % أتبعت إثم الهوى بإثم % فيه ووزر الصبا بوزر % 17(@)(@@) % بين شقيق صقيل خد % وأقحوان نقي ثغر % 18(@)(@@) % وابن دلال إذا تثنى % % رايت عذراء بنت خدر % 19(@)(@@) % يدير ألفاظه بحذق % فينا وألحاظه بسحر % 20(@)(@@) % فلست آبى ولو سقوني 
ms47	 % % على أغانيه نيل مصر % PageV01P233 21(@)(@@) % ما تركت لي المدام هما % يضيق عنه وسيع صدري % % 22(@)(@@) % إن هي إلا نجوم سعد % على أكف الأنام تجري % % PageV01P234 البحر : خفيف تام 1(@)(@@) % لا وعين تدير باللحظ خمرا % % بين أهل الهوى فتقتل سكرا % % 2(@)(@@) % لا أطعت السلو عنها ولا العا % % ذل فيها ولا تعاطيت صبرا % % 3(@)(@@) % صاح ما حيلتي حسبت طريق الح % ب سهلا فكان لاكان وعرا % % 4(@)(@@) % لا تلم في البكاء فالدمع لو لم % يجر في الخد كان في القلب جمرا % % 5(@)(@@) % وسحاب يجر في الروض ذيلي % % مطرف ذره على الأرض ذرا % % 6(@)(@@) % برقه لمحة ولكن له رع % % د بطيء يكسو المسامع وقرا % % 7(@)(@@) % كخلي منافق للذي يه % % واه يبكي جهرا ويضحك سرا % % 8(@)(@@) % قد سقتني المدام فيه فتاة % سحرتني وليس تحسن سحرا % % 9(@)(@@) % فإذا ما رأيتها تشرب الكأ % س أرتني شمسا تقتل بدرا % % PageV01P235 البحر : منسرح 1(@)(@@) % سقيا لليل قصرت مدته % % بدير مران مر مسكورا % % 2(@)(@@) % يوم أتيناه زائرين فصا % % دفنا به روضة وماخورا % % 3(@)(@@) % وبات بدر الدجا يشعشعها % % نورية تلبس الدجا نورا % % 4(@)(@@) % عادت على نفسها وقد برزت % فعاد جيب الحبيب مزرورا % % 5(@)(@@) % حتى رأيت الظلام يدرجه ال % % غرب وبرد الصباح منشورا % % 6(@)(@@) % واختلط الليل والنهار كما % % يخلط كف مسكا وكافورا % % PageV01P236 البحر : سريع 1(@)(@@) % لست على عذلك صبارا % % فلو تشا أقصرت إقصارا % % 2(@)(@@) % واها لأيام صبا فقدها % % أورثني هما وإكدارا % % 3(@)(@@) % أيام لا أصبح إلا فتى % قد صاحب الفتيان غيارا % % 4(@)(@@) % وكم وكم رحت إلى حانة % وكم وكم نبهت خمارا % % 5(@)(@@) % استغفر الله وكم ليلة % أحييتها لهوا وأوزارا % % 6(@)(@@) % عانقت في ظلماتها شادنا % بفترة الأجفان سحارا % % 7(@)(@@) % فقام يجلو جلنارية % تصير الأضواء أنوارا % % 8(@)(@@) % يعقد ما بين كثيب النقا % % وبين غصن البان زنارا % % 9(@)(@@) % فإن يكن ذاك الزمان انقضى % % وبدل الأحلاء أمرارا % % 10(@)(@@) % فالعيش طعمان لمن ذاقه % والدهر ما ينفك أطوارا % % PageV01P237 11(@)(@@) % وحبذا يوم بكرنابة % والفجر قد أسفر إسفارا % % 12(@)(@@) % وكلنا مبتهج ممتط % طرفا يفوت الطرف خطارا % % 13(@)(@@) % كأنه من عظم تركيبه % صوره 
ms48	 الجبار جبارا % % 14(@)(@@) % يخطو على صم إذا حنتها % % ألقت على الأحجار أحجارا % % 15(@)(@@) % كأننا في وقت إرساله % % نضرم في أعطافه نارا % % 16(@)(@@) % يخبب خبابا سلوقية % تفوت أوهاما وأبصارا % % 17(@)(@@) % من كل حسناء طرازية % تفوق الأرنب إحضارا % % 18(@)(@@) % يمد متنين امتدادا كما % % قرنت بالطومار طومارا % % 19(@)(@@) % كأنها صائمة أقسمت % أن تجعل الأرنب إفطارا % % 20(@)(@@) % وقد حملنا كل مستوفز % أده الحاذق واختارا % % PageV01P238 21(@)(@@) % يفتق حملاقين عن مقلة % يخالها الناظر دينارا % % 22(@)(@@) % صادقة تعمل لحظا إلى % % مقاتل الطائر نظارا % % 23(@)(@@) % مخاتل لكن له جلجل % لم يأل إعذارا وإنذارا % % 24(@)(@@) % كأنه شعلة نار إذا % % عاين فتخاء وحشنارا % % 25(@)(@@) % أو عربي فاتك ثائر % يخاف في تقصيره العارا % % 26(@)(@@) % فبينما تكفف من غربها % % وكلها تجذب استارا % % 27(@)(@@) % صار لنا برق فناج ولو % % كان يخاف الحين ما ثارا % % 28(@)(@@) % فلم يزل في عجب عاجب % يأخذ ما دب وما طارا % % 29(@)(@@) % فيا له يوما هرقنا به % % من دم ما صدناه انهارا % % 30(@)(@@) % ولى وأبقي ذكره بعده % لسائر الطراد أسمارا % % PageV01P239 31(@)(@@) % حتى إذا نحن قضينا به % من عذر اللذات أوطارا % % 32(@)(@@) % مرحا وقد سمط غلماننا % % خرائطا تحمل أوتارا % % 33(@)(@@) % إلى محل حل فيه الندى % % وصار فيه المجد مذ صارا % % 34(@)(@@) % دار كريم سيد أيد % بورك فيمن يسكن الدارا % % 35(@)(@@) % تلقاه فردا في الندى واحدا % وجحفلا في الحرب جرارا % % 36(@)(@@) % كأن في كفيه من جوده % وبأسه الجنة والنارا % % 37(@)(@@) % لو أن للأفلاك أخلاقه % كانت نجوم الليل أقمارا % % 38(@)(@@) % يستعبد الأحرار معروفه % والعرف يستعبد أحرارا % % 39(@)(@@) % يشرب شراوبة عتقت % في الدن أعصارا وأعصارا % % 40(@)(@@) % حتى رأينا الليل قد غربت % جوزاه بل والنجم قد غارا % % PageV01P240 41(@)(@@) % إب ق أبا القاسم واسلم فقد % جعلت للآداب مقدارا % % 42(@)(@@) % متعك الله بنعمائه % وزاد في عمرك أعمارا % % PageV01P241 البحر : مجزوء الكامل 1(@)(@@) % هو يوم شك يا ( عل % % ي ) وشره مذ كان يحذر % 2(@)(@@) % والجو حلته ممس % كة ومطرفه معنبر % 3(@)(@@) % والماء فضي القمي % % ص وطيلسان الأرض أخضر % 4(@)(@@) % نبت يصعد زهره % في الروض قطر ندي تحدر % 5 
ms49	(@)(@@) % وأخو الحجى لو كان هذا ال % % يوم من رمضان أفطر % 6(@)(@@) % ولنا فضيلات تكو % % ن ليومنا قوت يقدر % 7(@)(@@) % ومدامة صفراء أد % % رك عمرها ( كسرى ) و ( قيصر ) % 8(@)(@@) % فانشط لنا لنحث من % % كاساتنا ما كان أكبر % 9(@)(@@) % أو لا فإنك جاهل % إن قلت إنك سوف تعذر % PageV01P242 البحر : بسيط تام 1(@)(@@) % يا من أنامله كالعارض الساري % % وفعله أبدا عار من العار % 2(@)(@@) % أما ترى الثلج قد خاطت أنامله % % ثوبا يزر على الدنيا بأزرار % 3(@)(@@) % نار ، و لكنها ليست بمبدية % نورا ، و ماء ولكن ليس بالجاري % % 4(@)(@@) % والراح قد أوعزتنا في صبيحتنا % % بيعا ولو وزن دينار بدينار % PageV01P243 البحر : بسيط تام 1(@)(@@) % فديت زائرة في العيد واصلة % والهجر في غفلة عن ذلك الخبر % 2(@)(@@) % فلم يزل خدها ركنا أطوف به % والخال في صحنه يغني عن الحجر % PageV01P244 البحر : مخلع البسيط 1(@)(@@) % قم فاعقر الهم بالعقار % فالخمر درياقة الخمار % 2(@)(@@) % وهاتها يا غلام صرفا % حمراء مصفرة الخمار % 3(@)(@@) % صباح راح دجا عليه % % في فلك الدن قار % 4(@)(@@) % وجسم نور تراه يبدو % % كناظر في قميص نار % 5(@)(@@) % من كف كالظبي في رنو % وفي احوراءر وفي نفار % 6(@)(@@) % غصن قوام على كثيب % وليل شعر على نهار % 7(@)(@@) % في ورد خد له جني % ريحان صدغ له مدار % 8(@)(@@) % مذكر القد والتثني % % مؤنث الدل كالجواري % % 9(@)(@@) % إذا صقى بالصغار صبا % سقته عيناه بالكبار % 10(@)(@@) % لا عذر فيه لمن رآه % فلم يرح خالع العذار % PageV01P245 11(@)(@@) % شربت من راحه عقارا % ومن ثناياه كالعقار % 12(@)(@@) % حتى إذا الراح رنحته % ومسه السكر بانكسار % 13(@)(@@) % وخالطت ورد وجنتيه % فضاعفته بجلنار % 14(@)(@@) % بتنا وقد ضمنا إزار % لله ما حل في الإزار % 15(@)(@@) % ظن ما شئت بي فإني % % أتيت ما شئت من خسار % PageV01P246 البحر : كامل تام 1(@)(@@) % وإلى نداك ركبتها لجية % % كرمت منابت ساحها والعرعر % 2(@)(@@) % سحاء منشأها ببحر مخضب % أبدا ومولدها ببر مقفر % 3(@)(@@) % إن جانبت قصد الهوى بمقدم % عطفته كف لها بمؤخر % 4(@)(@@) % وكأنها والفجر قد خلع الدجا % % للعين قطعة ظلة لم تسفر % 5 
ms50	(@)(@@) % طارت أمام تطاير بقوادم % منشورة وقوائم لم تنشر % PageV01P247 البحر : طويل 1(@)(@@) % وكنت أرى في النوم هجرك ساعة % % فأجفوا لذيذ النوم حولا تطيرا % % 2(@)(@@) % وتأمرني بالصبر والقلب كلما % % تقاضيته تقاضيت معسرا % % 3(@)(@@) % فلما رأيت الهجر من شأنك اغتدى % % غدير التصافي بيننا قد تكدرا % % PageV01P248 البحر : هزج 1(@)(@@) % أذابت قلبه الزفره % وأدمت خده العبره % 2(@)(@@) % وهل يطمع في الصبر % عميد باعه صبره % 3(@)(@@) % له شوق حجازي % وقلب من بني عذره % 4(@)(@@) % ونفس دفعتها غم % % رة الحب إلى غمره % 5(@)(@@) % بجهد نفرت عنه % إلى أن سكنت غمره % 6(@)(@@) % وظبي زارني سرا % وكانت بيضة القصره % 7(@)(@@) % له في كل أيام % إلى هجرانه هجره % 8(@)(@@) % إذا أضمرت في الحب % وفاء أضمر الغدره % 9(@)(@@) % أخي إن صروف الده % % ر في تصريفها عبرة % 10(@)(@@) % خطوب شيبت رأسي % % وما إن شبت من كبره % PageV01P249 11(@)(@@) % على أني نبي الشعر % % قد جئت على فتره % 12(@)(@@) % ولو أنصف حسادي % % رأوني فوقهم فطره % 13(@)(@@) % بغوا شأوي في الشعر % فما إن قطعوا شعره % 14(@)(@@) % إلى كم في فمي ماء % من الأحزان بالجمره % 15(@)(@@) % ولا بد على ما قيل % للسكن من نفره % 16(@)(@@) % وكم دوية قفر % جعلت أجرها حسرة % 17(@)(@@) % إلى أصيد عالي الذك % ر والهمة والقدره % 18(@)(@@) % مضيىء الوجه والأفع % % ال والشيمة والفكره % 19(@)(@@) % معرى الجسم من عار % أمين الرأي من عثره % 20(@)(@@) % شهاب ثاقب النور % حسام قاطع الشفره % PageV01P250 21(@)(@@) % عليه دون سيف الد % م من معروفه نثره % 22(@)(@@) % أهان المال للآمال % ل في القلة والكثره % 23(@)(@@) % خلال ما خلت من حا % % سد توبثه حسره % 24(@)(@@) % أغص الله منء يكر % ه ما قلت بمن يكره % 25(@)(@@) % أيا أندى فتى كفا % وأسرى سيد أسره % 26(@)(@@) % ويا من سلم الجود % على علياه بالإمره % 27(@)(@@) % لقد صمت على الحق % وأفطرت على الفطره % % 28(@)(@@) % وأحرزت لعمر الل % ه أجر الحج والعمره % 29(@)(@@) % فأهدى العيد بالسعد % إلى قلبك ما سره % 30(@)(@@) % وأما بعد يا غيث % ندى مطرته الخبره % PageV01P251 31(@)(@@) % فعندي قينة كالبد % ر قد جذرتها بدره % 32(@)(@@) % وعجلت لها 
ms51	 المهر % لكي لا تنفر المهره % 33(@)(@@) % وقلنا في غداة العي % % د كوني عندنا بكره % 34(@)(@@) % وما يدفع ما خام % ر من هم سوى الخمره % 35(@)(@@) % وفي دارك لا زالت % عن الأسواء في ستره % 36(@)(@@) % مدام نورها نورا % % ن بالحمرة والصفرة % 37(@)(@@) % إذا طاف بها الشاد % ن ذو الأصداغ والطرره % % 38(@)(@@) % حسبت البدر قد طاف % على الأنجم بالزهره % 39(@)(@@) % ولا بد من الرسم % على أوفره عبره % 40(@)(@@) % وهل يروى امرؤ أعط % ش شهرا كاملا سكره % PageV01P252 41(@)(@@) % تشجيت لأني من % % ك في أمن من السخره % 42(@)(@@) % وعش واجتلها حينا % فقد جانبك العذره % 43(@)(@@) % لئن هذبها الفكر % لقد أفرغها صبره % 44(@)(@@) % كما ينحدر السيل % من الشاهق بالصخره % PageV01P253 البحر : بسيط تام 1(@)(@@) % أرى وصالك لا يصفو لآمله % والهجر تتبعه ركضا على الأثر % 2(@)(@@) % كالقوس اسسقسرب سهيمها إذا عطفت % عليه أبعدها من منزع الوتر % PageV01P254 البحر : منسرح 1(@)(@@) % قام بالنفس في هوى قمر % وباع وصل البدور بالبدر % 2(@)(@@) % وافتض أبكار لهوه طربا % بين عشايا المدام والبكر % 3(@)(@@) % لا يوم كاليوم أبرزته لنا % % رياضه في مشهر الحبر % 4(@)(@@) % يوم بهيم الزمان يخطر من % % جماله في الحجول والغرر % 5(@)(@@) % مسرة كلها بلا خشين % ولذة صفوها بلا كدر % 6(@)(@@) % قد ضربت خيمة الغمام لنا % % وعرش جيش النسيم بالمطر % 7(@)(@@) % وعندنا عاتقان حمراء كالشم % % س وأخرى صفراء كالقمر % 8(@)(@@) % بكران هذي تعاب بالكبر ال % % بادي وهذي تعاب بالصغر % 9(@)(@@) % مدامة كأن من تقادمها % % عاصرها آدم أبو البشر % 10(@)(@@) % وبنت خدر تريك صورتها % % بدر الدجا في ردائها العطر % PageV01P255 11(@)(@@) % حنت على عودها وقد بزلت % ندامنا جمرة بلا شرر % 12(@)(@@) % يسعى علينا بها الوصائف قلد % % ن مجونا قلائد الزهر % 13(@)(@@) % قرطق منطق إذا جلين لنا % % معقربات الأصداغ والطرر % 14(@)(@@) % يا تاركا طيب يومه لغد % تبيع عين السرور بالأثر % 15(@)(@@) % إن وترت قلبك الهموم فما % % مثل انتصار بالناي والوتر % 16(@)(@@) % وشادن حبرت لواحظه % لحاظ عين الغزال بالحور % 17(@)(@@) % أجبرت في حبه لأعذره % فإن جفاني احتججت بالقدر % 18(@)(@@) % سألته زورة فجاد بها % % وكل هذا 
ms52	 بألسن النظر % 19(@)(@@) % فنلت سؤلي من رشف ريقته % ومنيتي من مآرب أخر % PageV01P256 البحر : مجزوء الكامل 1(@)(@@) % أهلا وسهلا بالهلال % بدا لعين المبصر % 2(@)(@@) % أو ما تراه يلوح في % % جو السماء الأخضر % 3(@)(@@) % كشعيرة من فضة % قد ركبت في خنجر % PageV01P257 البحر : وافر تام 1(@)(@@) % دموعي فيك أنواء غزار % وحبي لا يقر به قرار % 2(@)(@@) % وكل قتى علاه ثوب سقم % فذاك الثوب مني مستعار % PageV01P258 البحر : وافر تام 1(@)(@@) % ألا فاسترزق الرحمن خيرا % وسر بالكأس نحو اللهو سيرا % 2(@)(@@) % ولا تك آلفا إلا أديبا % وبستانا وماخورا وديرا % % 3(@)(@@) % ولا تغررك آمال طوال % تعود ندامة وتعود ضيرا % % 4(@)(@@) % فأيام الهموم مقصصات % وأيام السروء تطير طيرا % % PageV01P259 البحر : مجزوء الكامل 1(@)(@@) % أتلفت مالي في العقار % وخرجت فيها من عقاري % % 2(@)(@@) % حتى إذا كتب الكتا % % ب وجاءني رس التجار % 3(@)(@@) % قالوا الشهادة بالعشي % وتغيب في صدر النهار % 4(@)(@@) % فأجبتهم ردوا الكتا % % ب ولا تعنوا بانتظاري % % 5(@)(@@) % أو كنت اسمح بالعشي % % لما سمحت ببيع داري % % PageV01P260 البحر : طويل 1(@)(@@) % أثاب فأعداني إلى ظلمه الدهر % وأعقب ما واصله من ذمه الشكر % 2(@)(@@) % ويوم نعيم بالسرور قصرته % يقصر عنه قي لذاذته العمر % 3(@)(@@) % يلغت وأبلغت المنى فيه بالتي % % مشعشعة تهدي إلى الروح راحة % 4(@)(@@) % مشعشتة تهدي إلى الروح راحة % ويعبق منها في زجاجتها العطر % 5(@)(@@) % كأن عليها من حباب مزاجها % % لآلي نظام قد تضمنها نحر % 6(@)(@@) % تنولها مني ندامى كأنهم % كواكب أبراج توسطها بدر % 7(@)(@@) % ومسمعة تحنو على مترنم % له زجل عال وليس له سحر % 8(@)(@@) % أصول له يفضين من كل سامع % إلى حيث لا يفضي إلى مثله الخمر % 9(@)(@@) % إذا طوقته بالأنامل والتقى % % على جسمه من جسمها الصدر والنحر % 10(@)(@@) % بكى طربا واستضحك اللهو نحوه % % وفضت عرى الألباب واستلب الصبر % PageV01P261 11(@)(@@) % فبت صريع السكر اطيب بيتة % وما الحلم إلا أن يسفهك السكر % PageV01P262 البحر : منسرح 1(@)(@@) % كأنما الجمر والرماد وقد % % كاد يواري زناده النورا % % 2(@)(@@) % ورد جنى القطاف أحمر قد % % زرت عليه الأكف كافورا % % PageV01P263 البحر : طويل 1(@)(@@) % صليه فقد قطعته مذ 
ms53	 قطعته % وأقرحت جفنيه وأسهرت ناظره % 2(@)(@@) % إذا كنت تحييه وأنت قتلته % فأنت على مجرى الخطيئة قادره % PageV01P264 البحر : رمل تام 1(@)(@@) % حبك الزائر في وقت السحر % أسفر الصبح به حين سفر % 2(@)(@@) % قد بعثناه لكي يجلى به % واضح كالؤلؤ الرطب أغر % 3(@)(@@) % طاب منه العرف حتى خلته % كان من ريقك يسقى في السحر % 4(@)(@@) % ليتني المهدي ومروى عطشي % % برد أنيبك في كل سحر % 5(@)(@@) % وأما والله لو يعلم ما % % حظه منك لأثنى وشكر % PageV01P265 البحر : - 1(@)(@@) % ممنطق الخصر أجوف % جيده ضعف سائره % 2(@)(@@) % لفظه لفظ عاشق % يشتكي هجر هاجره % 3(@)(@@) % ذو لسانين فوقه % عدلا من مقادره % 4(@)(@@) % أنطقته يد امرىء % فاتر الطرف ساحره % 5(@)(@@) % فحكى عن ضميره % ما جرى في خواطره % PageV01P266 البحر : مجزوء الرمل 1(@)(@@) % حان أن تستحي الأس % % قام من جسمي وتخزى % % 2(@)(@@) % لم تدع لي منه ما في % % مثله لي متعزى % % 3(@)(@@) % حزت الأعضاء مني % % كلها بالسقم حزا % % 4(@)(@@) % ف أنا الجزء الذي من % % لطفه لا يتجزى % % PageV01P267 البحر : خفيف تام 1(@)(@@) % يا لقومي للزائر المجتاز % زار أحبابه على أوفاز % 2(@)(@@) % زار صبا يقظان ما زار في النو % % م فيا فرحتي له واهتزازي % % 3(@)(@@) % لم يكن بين أن دنا وتناءى % % عنك إلا مقدار خطفة باز % PageV01P268 البحر : مخلع البسيط 1(@)(@@) % كالغصن في روضة تميس % تصبو إلى حسنها النفوس % 2(@)(@@) % ما شاهدت والنساء عرسا % فشك في أنها العروس % 3(@)(@@) % تبسم عن واضح نؤور % تعبق من طيبه الكؤوس % 4(@)(@@) % يجمع فيه لمجتليه % در ومسك وخندريس % PageV01P269 البحر : مديد تام 1(@)(@@) % مقلة بالدمع منجبسه % وحشا بالوجد ملتبسه % 2(@)(@@) % وفؤاد شفه قمر % يترك الألباب مختلسه % 3(@)(@@) % دونه مولى يحجبه % ملظم أبوابه حرسه % 4(@)(@@) % حذرا منه على رشأ % % صاد قلب الليث فافترسه % 5(@)(@@) % غيرة من أن تجر إلى % % نفس في سيرها نفسه % 6(@)(@@) % ود من إفراط غيرته % و تكون الريح محتبسه % PageV01P270 البحر : خفيف تام 1(@)(@@) % يا بلائي من التي ختلتني % % بدلال به تصاد النفوس % 2(@)(@@) % كتمتني الهوى لتخدع قلبي % والهوى في ضميرها محسوس % 3(@)(@@) % تصرف اللحظ حين تبصر 
ms54	 نحوي % % وبأحشائها هوى ورسيس % 4(@)(@@) % وتراني فيضحك القلب منها % % جذلا بي وإن علاها عبوس % 5(@)(@@) % وإذا ما اقترحت صوتا عليها % % كايدتني بأنه محبوس % 6(@)(@@) % وهي لا تهتدي لهذا ولكن % هو مما افادها إبليس % PageV01P271 البحر : سريع 1(@)(@@) % قد قلت للكأس وابصرتها % % تلثمه : طوباك يا كاسها % % 2(@)(@@) % طوباك إذا أدنتك من ثغرها % % فاختلست رياك أنفاسها % % PageV01P272 البحر : منسرح 1(@)(@@) % طاف خيال الحبيب في الغلس % فبت منه بأعظم الأنس % 2(@)(@@) % طيف حبيب حفظت خلته % وأدركته ملالة فنسي % % 3(@)(@@) % قصر ليلي بطيب زورته % وكان ليلي أمد من نفسي % % PageV01P273 البحر : وافر تام 1(@)(@@) % أيا نشوان من خمر بفيه % متى تصحو وريقك خندريس % 2(@)(@@) % أرى بك ما أراه بذي انتشاء % ألح عليه بالكأس الجليس % 3(@)(@@) % تورد وجنة وفتور لحظ % تمرضه وأعطاف تميس % PageV01P274 البحر : طويل 1(@)(@@) % أخي لا تروعني فأصبو إلى أخ % سواك فتسلو بعض نفسك عن نفسي % % 2(@)(@@) % وكن عالما أني أغار على أخي % % وخلي كما أني أغار على عرسي % % 3(@)(@@) % ووفر علي اللحظ منك فإنني % % خصصتك باللحظ الموفر من إنسي % % PageV01P275 البحر : متقارب تام 1(@)(@@) % أبى الدهر إلا فعالا خسيسا % % وصرفا يبدل نعماء بوسا % % 2(@)(@@) % وكنت أرى منه وجها ضحوكا % فأبدلني منه وجها عبوسا % % 3(@)(@@) % وشيبني حادثات الزمان % وأحداثهن تشيب الرؤوسا % % 4(@)(@@) % ونازعني الدهر ثوب الشباب % فنازعني منه علقا نفيسا % % 5(@)(@@) % تعاتبني أن أطلت الجلوس % وعن عذر أن أطلت الجلوسا % % 6(@)(@@) % وقد يمكث السيف في غمده % مصونا ويستوطن الليث خيسا % % 7(@)(@@) % أأخدم من كان لي خادما % وأتبع من قد رآني رئيسا % % 8(@)(@@) % جفوت النديم إذن والمدام % وأصبحت بعدك أوذي الجليسا % % 9(@)(@@) % كأني لم أعد في مقنب % أفل بحد الخميس الخميسا % % 10(@)(@@) % واقتنص الوحش في بيدها % % بمضمرة تجتذبن المروسا % % PageV01P276 11(@)(@@) % تروح الظباء بأشخاصها % % فتقبض قبل الرؤوس النفوسا % % 12(@)(@@) % كأن الكؤوس بايديهم % نجوم سماء تلاقي شموسا % % 13(@)(@@) % ولم أدر الكأس في فتية % تباكرها قهوة خندريسا % % 14(@)(@@) % ويا رب يوم تمليته % % سرورا ببطناس أو بانقوسا % % 15(@)(@@) % ويا حبضا الدير دير البريح % تجيب النواقيس فيها القسوسا % % 16(@)(@@) % وهيفاء لو لم تمس 
ms55	 ما اهتدى % % قضيب الرياض إلى أن يميسا % % 17(@)(@@) % ولو برزت لنصارى المسيح % لدانوا لها طاعة دون عيسى % % 18(@)(@@) % إذا شئت أنطق في حجرها % % لسان فصيح يهيج الرسيسا % % 19(@)(@@) % وآمرة بركوب الفلاة % وأن أعمل الطير والعنتريسا % % 20(@)(@@) % رأتني قنعت ولم ألتمس % لقاء وجوه تطيل العبوسا % % PageV01P277 21(@)(@@) % دعين أمارس صرف الزمان % وألبس في كل حين لبوسا % % 22(@)(@@) % فإني رأيت فروع الكرام % يشبن إذا ما ابتدلن العروسا % % PageV01P278 البحر : منسرح 1(@)(@@) % أما ترى مصر كيف قد جمعت % بها صنوف الرياض في مجلس % 2(@)(@@) % السوسن الغض والبنفسج وال % % ورد وصفر البهار والنرجس % 3(@)(@@) % كأنها الجنة التي جمعت % ما تشتهيه العيون والأنفس % 4(@)(@@) % كأنما الأرض ألبست حللا % من فاخر العبقري والسندس % 5(@)(@@) % وقد أحاطت بها شقائقها % % كأنها من عقائق أكؤس % 6(@)(@@) % فاشرب على الزهر من معتقة % بحلية شيروية المفلس % 7(@)(@@) % وصل على سورة الهموم بها % % مع النديم الظريف والمؤنس % 8(@)(@@) % لا تخش إن أفلستك فاقرة % والظرف لا يترك الفتى مفلس % PageV01P279 البحر : كامل تام 1(@)(@@) % صحت مقادر ضربها وغيابها % % وحسابها وتوازنت في الأنفس % 2(@)(@@) % فكأن أشكال المثلث إنما % % يؤخذن عنها ليس عن إقليدس % PageV01P280 البحر : مجزوء الرمل 1(@)(@@) % لي من سر بني العب % اس خل ورئيس % 2(@)(@@) % شهد المجد عليه % % أنه علق نفيس % % 3(@)(@@) % يهب الأسلاب والما % % ل على الشكر حبيس % 4(@)(@@) % وإذا جالسته لم % تدر من منا الجليس % PageV01P281 البحر : منسرح 1(@)(@@) % تراه في الصدر من خساسته % كأنه في أواخر المجلس % 2(@)(@@) % لا يفهم القول والخطاب ولا % % يفهمه فهو أبكم أخرس % 3(@)(@@) % يحكم في مصر والشام وقد % % كان كثيرا لمثله يحرس % PageV01P282 البحر : مجزوء الكامل 1(@)(@@) % تزداد فيك مصيبتي % % خطرا إذا نهنهت نفسي % % 2(@)(@@) % فأرى الأسى مني علي % % ك اليوم أعظم منه امس % 3(@)(@@) % فأظل فيك مخالفا % أهل التعزي والتأسي % % 4(@)(@@) % لا تبعدن أبي الشفي % % ق وإن غدوت رهين رمس % 5(@)(@@) % وسقى ضريحك وابل % يضحي بعقوته ويمسي % % 6(@)(@@) % ولقد غدت دنياي بع % % دك وحشة من بعد أنس % 7(@)(@@) % وعشيت في ظلم الخطو % % ب وكنت مصباحي وشمسي % % 8(@)(@@) % وتركتني عرضا 
ms56	 لنب % ل الحادثات وكنت ترسي % % 9(@)(@@) % فتمكنت أنياب ري % ب الدهر من عضي ونهسي % % PageV01P283 البحر : كامل تام 1(@)(@@) % قد جاءنا الورق الذي وفرته % والظبي والسرج المحلى والفرس % 2(@)(@@) % والبغلة الشقراء والخلع التي % % كانت كعرضك ليس فيه من دنس % 3(@)(@@) % في ريحها أرج يفوح كأنه % من عود محتدك الكريم المغترس % 4(@)(@@) % والعضب يلمع في الظلام كأنه % من نور وجهك أو ذكائك مقتبس % 5(@)(@@) % لكن أبت لي أن أروح وأغتدي % % كلا على الإخوان أخلاق شمس % 6(@)(@@) % لا أستلذ العيش لم أدأب له % طلبا وسعيا في الهواجر والغلس % 7(@)(@@) % وأرى حراما أن يواتني الغنى % % حتى يحاول بالعناء ويلتمس % 8(@)(@@) % فاصرف نوالك عن أخيك موفرا % فالليث ليس يسيغ إلا ما افترس % PageV01P284 البحر : مجزوء الرمل 1(@)(@@) % يا نديمي أطلق الكأ % س فما للكأس حبس % 2(@)(@@) % قهوة تعطيكها قب % % ل طلوع الشمس شمس % 3(@)(@@) % هي كالمريخ لكن % هي سعد وهو نحس % PageV01P285 البحر : خفيف تام 1(@)(@@) % وقعتني ما بين حزن وبؤس % وثنت بعد ضحكة بعبوس % 2(@)(@@) % إذ رأتني مشطت عاجا بعاج % وهي الإبنوس بالإبنوس % PageV01P286 البحر : دو بيت 1(@)(@@) % ونديم مخالف لا يشاء الذي أشا % % هو في الصحو لي أخ وعدو إذا انتشا % % 2(@)(@@) % اقترحت العشاء يوما عليه فأدهشا % % ساعة ثم قال لي العشا يورث العشا % % PageV01P287 البحر : طويل 1(@)(@@) % وما زال يبري أعظم الجسم حبها % % وينقصها حتى لطفن عن النقص % 2(@)(@@) % وقد ذبت حتى صرت إن أنا زرتها % % أمنت عليها أن يرى أهلها شخصي % % PageV01P288 البحر : وافر تام 1(@)(@@) % غدا وغدا تورد وجنتيه % لعين محبه يصف الرياضا % % 2(@)(@@) % على خديه ماء عسجدي % إذا نظر الرقيب إليه غاضا % % 3(@)(@@) % يؤمل جنة الفردوس قوم % وآمل منه شما أوعضاضا % % 4(@)(@@) % غزال كلما ازددت اقترابا % إليه زاد بعدا وانقباضا % % 5(@)(@@) % كتمت هواه حتى فاض دمعي % % فصيره حديثا مستفاضا % % PageV01P289 البحر : رجز تام 1(@)(@@) % مااعتاد عيني غمضها % % مذ أنت عني معرض % 2(@)(@@) % لم يبق إلا كبد % حرى وقلب ممرض % 3(@)(@@) % ومهجة عليلة % جثمانها منتقض % 4(@)(@@) % ما فيه من جارحة % إلا وفيها مرض % 5(@)(@@) % كنت حياة 
ms57	 لي وما % لي من حياتي عوض % PageV01P290 البحر : - 1(@)(@@) % ما لذة اكمل في طيها % % من قبلة في إثرها عضه % 2(@)(@@) % كأنما تأثيرها لمعة % من قصب أجري علي فضة % 3(@)(@@) % خلستها بالكره من شادن % يعشق منه بعضه بعضه % PageV01P291 البحر : مجزوء الكامل 1(@)(@@) % بأبي أنت تب % اغضت وما كنت بغيضا % % 2(@)(@@) % جاءني منك جواب % كان للعهد نقضا % % 3(@)(@@) % أنت لم تمرض ولكن % أحسب الود مريضا % 4(@)(@@) % ولقد فاتك لهو % لست عنه مستعيضا % % 5(@)(@@) % ومدام شاكلت في ال % % كأس ياقوتا فضيضا % % 6(@)(@@) % وغناء من غريض % فاق في الحسن الغريضا % % 7(@)(@@) % لو رأت عيناك من % صاحبه طرفا غضيضا % % 8(@)(@@) % وثنايا واضحات % كنبات الدر بيضا % % 9(@)(@@) % كدت من شدة شوق % وافتنان أن تبيضا % % 10(@)(@@) % ولو أن الجد واتا % % ك لأسرعت النهوضا % % PageV01P292 البحر : رجز تام 1(@)(@@) % يا عوضا من فائت % لم يحتسب منه عوض % 2(@)(@@) % يا صحة في دفعة % صرت إليها من مرض % 3(@)(@@) % يا دعة وراحة % من تعب ومن مضض % 4(@)(@@) % يا فرحة الرامي إذا % % أصاب بالسهم الغرض % 5(@)(@@) % يا خفة الظهر إذا % % ألقي عنه المفترض % 6(@)(@@) % يا موقع النوم على % % بعيد عهد بالغمض % 7(@)(@@) % يا جوهر الحسن الذي % % سواه في الحسن عرض % 8(@)(@@) % إذا تذكرتك يا % % من خان عهدي ونقض % 9(@)(@@) % ظننت أن بازيا % على فؤادي قد قبض % PageV01P293 البحر : رجز تام 1(@)(@@) % غيث أتانا مؤذن بخفض % متصل الوبل حثيث الركض % 2(@)(@@) % يقضي بحكم الله فيما يقضي % % كالجيش يتلو بعضه لبعض % 3(@)(@@) % يضحك من برق خفي الومض % كالكف في انبساطها والقبض % 4(@)(@@) % دنا فخلناه فويق الأرض % متصلا بطولها والعرض % 5(@)(@@) % ألفا إلى ألف بسير يقضي % % ثم همى كاللؤلؤ المرفض % 6(@)(@@) % فالأرض تجلى بالنبات الغض % في حليها المحمر والمبيض % 7(@)(@@) % من سوسن أحوى ورود غض % مثل خدود نقشت بالعض % 8(@)(@@) % وأقحوان كاللجين المحض % ونرجس ذاكي النسيم بض % 9(@)(@@) % مثل العيون رفقت بالغمض % ترنو ويغشاها الكرى فتغضي % % PageV01P294 البحر : مخلع البسيط 1(@)(@@) % أمر عيش وحال خفض % وحل هم وبان غمض % 2(@)(@@) % ومضني حادث دهاني % % وطارق الحادثات مض % 3(@)(@@) % وخانني 
ms58	 الدهر من ثقاتي % % فبان بعض وخان بعض % 4(@)(@@) % وأسرعت فيهم المنايا % % وسر خيل المنون ركض % 5(@)(@@) % واسترجعت منهم الليالي % % قروضها والحياة قرض % 6(@)(@@) % وعضني منهم بناب % والدهر مود لمن يعض % 7(@)(@@) % ونقضت منهم شروطا % لم يك فيما يخاف نقض % 8(@)(@@) % بدور عز تضمنتها % % بعد بروج السماء أرض % 9(@)(@@) % كأن كل امرىء عليه % % درهم اسهم تقض % 10(@)(@@) % عاشوا كرام الفعال وعيش ال % % ورى في المحول خفض % PageV01P295 11(@)(@@) % تدحض عنهم به خطوب % ليس لأذاهن دحض % 12(@)(@@) % كم غصن في التراب منهم % جنته أيدي المنون غض % 13(@)(@@) % وخلفوا محتدا وعزا % محضا وبعض الكرام محض % 14(@)(@@) % لم يصن البخل قط مالا % لهم ولا يستذل عرض % 15(@)(@@) % أودى فأودت لهم مقال % ومات بسط لهم وقبض % 16(@)(@@) % والصبر إلا إذا افتقدنا % % مثلهم سنة وفرض % PageV01P296 البحر : طويل 1(@)(@@) % تعطف علينا أيها الغصن الغض % أما منك شم يستفاد ولا عض % 2(@)(@@) % جناك جنى فيه شفاء وصحة % ولكن لنا لحظك السقم المحض % 3(@)(@@) % تركت طبيبي حائرا باكيا على % % نحولي بعين ما يسامحها غمض % 4(@)(@@) % وأعجب مني ان أطيق جوابه % وقد كان يخفى في مجسته النبض % 5(@)(@@) % بدت موهنا في درعة اللون تحته % % غلائل نور حشوها برد بض % 6(@)(@@) % وماست كميس الخيزران وألقت % بأحسن مسود بدا فيه مبيض % 7(@)(@@) % وقد نقضت عهد الصباء كأنها % % أناس هواهم في عهودهم النقض % 8(@)(@@) % وقد أكسبتني نعمة الله بغضهم % فلا زالت النعمى ولا برح البغض % 9(@)(@@) % وكنت إذا ما عابني ذو نباهة % يسابق بغض من فؤاد له مض % 10(@)(@@) % أبى لي مجدي أن أساجل مثله % وحاسا سماء أن يشاكلها أرض % PageV01P297 11(@)(@@) % وما لي أخشى حاسدا ومعاندا % وليس له بسط علي ولا قبض % 12(@)(@@) % نبالي أقلامي وسيفي مقولي % % به الدهر أبكار البلاغة أفتض % 13(@)(@@) % يريك وجوه المكرمات ضواحكا % ويوضح مسود الأمور فيبيض % 14(@)(@@) % وكم خفق الأمر الذي هو باطل % وكم دحض الحق الذي ماله دحض % 15(@)(@@) % وأكرمت أعراضي بمالي فصنتها % % ومن جاد لم يدنس له أبدا عرض % 16(@)(@@) % وحملت اسرار الصديق أخي الصفا % % فودك باق 
ms59	 لا يحول ولا ينضو % % 17(@)(@@) % منينا بمن نغضي لهم من عثارهم % وهمهم فينا التيقظ لا الغض % 18(@)(@@) % وأنت امرؤ تصفو إذا كدر الورى % % وتحلو إذا ما شاب ودهم حمض % 19(@)(@@) % متى يشق خل بالتغير من أخ % خؤون فحظي من مودتك الخفض % PageV01P298 البحر : وافر تام 1(@)(@@) % أراك تضن بالجاه العريض % ففيم تجود بالعر المريض % 2(@)(@@) % تبارزني وعرضك من رصاص % فكم يبقى على نار العريض % 3(@)(@@) % وتومض عن بروق الوعد لكن % عدمت الغيث في عقب الوميض % 4(@)(@@) % وأذكر حاجتي فتعي وتغضي % % فلا متعت بالطرف الغضيض % 5(@)(@@) % فكيف تطيق نافلة المعالي % % ونفسك ليس تنهض بالفروض % 6(@)(@@) % إذا لم ترج في حال ارتفاع % ندمت إذا نزلت إلى الحضيض % PageV01P299 البحر : طويل 1(@)(@@) % ألا رب ليل أرعى نجومه % فلم أغمض فيه ولا الليل غمضا % % 2(@)(@@) % كأن الثريا راحة تشبر الدجا % % ليعلم طال الليل أم لي تعرضا % % 3(@)(@@) % فأعجب لليل بين شرق ومغرب % يقاس بشبر كيف يرجى له انقضا % % PageV01P300 البحر : مجزوء الكامل 1(@)(@@) % غيم مدامعه تفيض % وثيابه سود وبيض % 2(@)(@@) % يبكي فيضحك من طوي % % ل بكائه الروض الأريض % 3(@)(@@) % ولدي إخوان قرا % % ئحهم بحور لا تفيض % 4(@)(@@) % والراح قد عزت على الشعرا % % ء مذ ذل القريض % 5(@)(@@) % وعليك عول في الندا % % مى راح ليس له نهوض % 6(@)(@@) % ولأنت مرجاه المرجى % % عنده الجاه العريض % 7(@)(@@) % فامنن بها حمراء يحس % % د طيبها المسك الرضيض % 8(@)(@@) % واعلم بأن صنا % % ئع لمعروف أكثرها فروض % PageV01P301 البحر : متقارب تام 1(@)(@@) % وقالوا عليك بوسط الأمور % فقلت لهم أكره الأوسطا % % 2(@)(@@) % إذا لم أكن في ذرى شامخ % ولا في حضيض وطي الوطا % % 3(@)(@@) % وحاولت في مرتقى هائل % توسطه خفت أن أسقطا % % 4(@)(@@) % وخير من العير المسبطر % إذا أعوز السبق قصر الخطا % % 5(@)(@@) % كما المنع حين يفوت الكثير % أحسن من مستقل العطا % % PageV01P302 البحر : متقارب تام 1(@)(@@) % تعز أبا بكر المرتجى % % عن الأهل والعصبة القائطه % 2(@)(@@) % وما ظلم الموت في حكمه % فايدي المنايا له لاقطه % 3(@)(@@) % ولكن بقؤك أرضى النفو % % س ولكن لميتتهم ساخطه % 4(@)(@@) % فإن يك 
ms60	 عقد هوى بغتة % فإن الذيبقي الواسطة % PageV01P303 البحر : خفيف تام 1(@)(@@) % ما تغطي قراطق ومروظ % ما تحلي مخانق وشموط % 2(@)(@@) % غادة طفلة مذكرة العي % % ن وفيها مآرب وشروط % 3(@)(@@) % لا تنال الأكف منها ولكن % كل عين تزني بها وتلوط % 4(@)(@@) % ولها في صحيفة الخد منها % % نون صدغ بشامة منقوط % PageV01P304 البحر : رجز تام 1(@)(@@) % شطت لليلى باللوى % % دار فكانت لا تشط % 2(@)(@@) % ولطال ما عشنا معا % كل بكل مغتبظ % 3(@)(@@) % أيام لا تسومنا الأ % يام في العيش شطط % % 4(@)(@@) % والغصن غض والشبا % % ب شعره جعد قطط % 5(@)(@@) % وكوكب السرور في % % استقامة لم ينهبط % 6(@)(@@) % والدهر لم ينشط لما % % كان من الغدر بسط % 7(@)(@@) % ذاك وقد أغدو ولي % % في الغدوات مغتبط % 8(@)(@@) % والليل كالشعر بدا % % فيه من الشيب وخط % 9(@)(@@) % والنجم كالقرط وهي % % عند العناق فسقط % 10(@)(@@) % والصبح كالقس بدا % % من فتق مسحبه الشمط % PageV01P305 11(@)(@@) % في فتية عز لهم % % بالمجد باع منبسط % 12(@)(@@) % لا زللا يخشى الجلي % % س منهم ولا سقط % 13(@)(@@) % ولا حجابا دونه % حواجب القوم نمط % 14(@)(@@) % كالأسد باسا في الوغى % % والغيث أن عم القحط % 15(@)(@@) % والدهر والزهر معا % شعرا وألفاظا وخط % 16(@)(@@) % تنفسح الآمال في % % أمثالهم وتنتشط % 17(@)(@@) % ما منهم عيبلإ سوى إلا % % فهمء كأسنان المشط % 18(@)(@@) % نرى حديث الشرب يطو % % ى بينهم على البسط % 19(@)(@@) % وإن هفا خل تلا % % فوا وأقالوه الغلط % 20(@)(@@) % وعن يساري من سيو % % ف الهند ذا شطب سبط % PageV01P306 21(@)(@@) % كأن برقا لامعا % في جفنه إذا اخترط % 22(@)(@@) % كأنه من مرح % صاعد فيه وانهبط % 23(@)(@@) % ماض ترى في متنه % حسن ما يكتب في ال % % 24(@)(@@) % كأنما ديف به % سم الضئيلات الرقط % 25(@)(@@) % يقد إن عملته % طولا وإن عارض قط % 26(@)(@@) % وتحت سرجي سابح % أجرد نهد ذو معط % 27(@)(@@) % يقصر عنه الريح في % % إعناقه وما انبسط % 28(@)(@@) % يراه مستقبله % أوفى على الطود الأمط % 29(@)(@@) % حتى إذا استدبره % ظل يراه منهبط % 30(@)(@@) % كأن متنيه إذا % % ريع بشخص فاختلط % PageV01P307 31(@)(@@) % % قرطاس من شكل وخط % 32(@)(@@) % فحبذا مستصحبا % وذاك وهذا 