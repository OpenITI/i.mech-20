ms21	 سمحا بذاك مبينا % % PageV01P086 البحر : - 1(@)(@@) % نحن بنينا طائفا حصينا % % PageV01P087 البحر : خفيف تام 1(@)(@@) % قل لعبد العزى أخي وشقيقي % % وبني هاشم جميعا عزينا % % 2(@)(@@) % وصديقي أبي عمارة والإخ % % وان طرا ، وأسرتي أجمعينا % % 3(@)(@@) % فاعلموا أنني له ناصر % ومجر بصولتي الخاذلينا % % 4(@)(@@) % فانصروه للرحم والنسب الأد % نى ، وكونوا له يدا مصلتينا % % PageV01P088 البحر : خفيف تام 1(@)(@@) % ليت شعري مسافر بن أبي عم % رو وليت يقولها المحزون % 2(@)(@@) % أي شيء دهاك أوغال مرآ % % ك وهل أقدمت عليه المنون ؟ % 3(@)(@@) % أنا حاميك مثل آبائي الزه % % لآبائك التي لا تهون % 4(@)(@@) % ميت صدق على هبالة أمسي % % ت ومن دون ملتقاك الحجون % 5(@)(@@) % رجع الركب سالمين جميعا % وخليلي في مرمس مدفون % 6(@)(@@) % بورك الميت الغريب كما بو % % رك نضج الرمان والزيتون % 7(@)(@@) % مدرة يدفع الخصوم بأيد % وبوجه يزينه العرنين % 8(@)(@@) % كم خليل يزينه وابن عم % وحميم قضت عليه المنون % 9(@)(@@) % فتعزيت بالتأسي وبالصب % ر وإني بصاحبي لضنين % 10(@)(@@) % كنت لي عدة وفوقك لافو % % فقد صرت ليس دونك دون % PageV01P089 11(@)(@@) % كان منك اليقين ليس بشاف % كيف إذ رجمتك عندي الظنون ؟ % 12(@)(@@) % كنت مولى وصاحبا صادق الخب % رة حقا وخلة لا تخون % 13(@)(@@) % فعليك السلام مني كثيرا % أنفدت ماءها عليك الشؤون % % PageV01P090 البحر : بسيط تام 1(@)(@@) % أمن تذكر دهر غير مأمون % أصبحت مكتئبا تبكي كمحزون ؟ % 2(@)(@@) % أم من تذكر أقوام ذوي سفه % يغشون بالظلم من يدعو إلى الدين ؟ % 3(@)(@@) % لا ينتهون عن الفحشاء ما أمروا % % والغدر فيهم سبيل غير مأمون % 4(@)(@@) % ألا يرون أذل الله جمعهمو % % أنا غضبنا لعثمان بن مظعون ؟ % 5(@)(@@) % إذ يلطمون ولا يخشون مقلته % طعنا دراكا وضربا غير مرهون % 6(@)(@@) % فسوف نجزيهمو إن لم يمت عجلا % كيلا بكيل جزاء غير مغبون % 7(@)(@@) % أو ينتهون عن الأمر الذي وقفوا % % فيه ويرضون منا بعد بالدون % 8(@)(@@) % ونمنع الضيم من يبغي مضامتنا % % بكل مطرد في الكف مسنون % 9(@)(@@) % ومرهفات كأن الملح خالطها % % يشفى بها الداء من هام المجانين % 10(@)(@@) % حتى تقر رجال لا حلوم لها % % بعد الصعوبة بالإسماح واللين % PageV01P091 11 
