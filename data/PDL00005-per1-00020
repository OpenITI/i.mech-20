ms7	 ازو %~% که ثنا زو گرفت فر و بها(@)(@@) 21 او کند فرق نیک را از بد %~% او شناسد صواب را ز خطا(@)(@@) 22 خاطر من مگر بمدحت او %~% ندهد بر مدیح خلق رضا(@)(@@) 23 گرچه دورم بتن ز خدمت او %~% نکنم بی بهانه رسم رها(@)(@@) 24 هر زمان مدحتی فرستم نو %~% ای رساننده زود باش هلا(@)(@@) 25 ای سزاوارتر بمدح و ثناست %~% جهد کن تا رسد سزا بسزا(@)(@@) 26 ای ستوده خوی ستوده سخن %~% ای بلند اختر بلند عطا(@)(@@) 27 گر بخدمت نیامدم بر تو %~% عذر کی تازه رخ نمود مرا(@)(@@) 28 تا ز درگاه تو جدا گشتم %~% هر زمانی مرا غمیست جدا(@)(@@) 29 فرقت پرده تو گشت مرا %~% پرده ای بر دو دیده بینا(@)(@@) 30 من به مدح و دعا ز دستم چنگ %~% گر بسنده کنی بمدح و دعا(@)(@@) 31 تا نمازست مایه مؤمن %~% تا صلیبست قبله ترسا(@)(@@) 32 شادمان باش و بختیار و عزیز %~% جاودان کامران و کامروا PageV1P050(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوست دارم کودک سیمین بربیجاده لب %~% هر کجا زیشان یکی بینی مرا آنجا طلب(@)(@@) 2 خاصه باروی سپید و پاک چون تابنده روز %~% خاصه باموی سیاه و تیره چون تاریک شب(@)(@@) 3 هر که را زینگونه باشد ماهرویی مشکموی %~% نیست معذور از بیاساید زمانی از طرب(@)(@@) 4 تا ستاده ست از دو چشمش بر نباید داشت چشم %~% تانشسته ست از دو لعلش بر نشاید داشت لب(@)(@@) 5 گر مرا زین کودک بت روی دادستی خدای %~% بر لب او بوسه ها میدادمی دادن عجب(@)(@@) 6 ای خوشا زین پیشتر کاندر سرایم زین صفت %~% کودکان بودند سیمین سینه و زرین سلب(@)(@@) 7 با سرینهای سپید و گرد چون تل سمن %~% با میانهای نزار و زار چون تار قصب(@)(@@) 8 از دلارامی و نغزی چون غزلهای شهید %~% وز دلاویزی و خوبی چون ترانه بوطلب(@)(@@) 9 گر تهی شد زین بتان اکنون سرایم باک نیست %~% دل پرست از آفرین خسرو خسرونسب 
ms8	(@)(@@) 10 پادشه زاده محمد خسرو پیروز بخت %~% سر فراز تاجداران عجم و آن عرب(@)(@@) 11 خسروان را گر نسب نیکوترین چیزی بود %~% هم نسب دارد ملک زاده بملک و هم حسب(@)(@@) 12 ای قرین آورده اندر فضل بر خوی ملک %~% ای هزینه کرده ملک و مال برنام و نسب(@)(@@) 13 پیش از این هر شاهی و هر خسروی فرزند را %~% از پی فرهنگ شاگرد فلان کردی لقب(@)(@@) 14 بهمن آنگه روستم را چند گه شاگرد شد %~% تا خصالش بیخلل گشت و فعالش منتخب(@)(@@) 15 همچنان کیخسرو واسفندیار گرد را %~% رستم دستان همی آموخت فرهنگ و ادب(@)(@@) 16 تو هم از خردی بدانستی همه فرهنگها %~% ناکشیده ذل شاگردی ونادیده تعب(@)(@@) 17 تو دلی داری چو دریا و کفی داری چو ابر %~% زان همی پاشی جواهر زین همی باری ذهب(@)(@@) 18 در هنر شاگرد خویشی چون نکوتر بنگری %~% فضلهای خویشتن را هم تو بودستی سبب(@)(@@) 19 هم خداوند سخایی هم خداوند سخن %~% هم خداوند حسامی هم خداوند حسب(@)(@@) 20 جز ملک محمود را هر خسروی را خسروی %~% هیچ خسرو رانیاید زین که من گفتم غضب(@)(@@) 21 پادشاهی چون تونی از پادشاهان جهان %~% پادشاهی را به تست ای پادشه زاده نسب(@)(@@) 22 فر شاهی چون تو داری لاجرم شاهی تر است %~% من چه دانم کردن ار پیداستی خار از رطب(@)(@@) 23 عامل بصره بنام تو همی خواهد خراج %~% خاطب بغداد بر نامت همی خواند خطب(@)(@@) 24 گرت فرمان آید از سلطان که خالی کن عراق %~% گردن گردنکشانرا نرم گردان چون عصب(@)(@@) 25 نامه فتح تو از شام آید و دیگر ز مصر %~% منزلی زان تو حلوان باشد و دیگر حلب(@)(@@) 26 خانه بی طاعتان از تیغ تو گردد خراب %~% گنجهای مغربی از دست تو گردد خرب(@)(@@) 27 ور بر این سوی دگر فرمان دهد شمشیر تو %~% فرد گرداند ز خانان تا که چین از فرب(@)(@@) 28 همچنان چون طبع تو بر راد مردی 
ms9	 شیفته است %~% تیغ تو بر کشتن و خون ریختن دارد سغب(@)(@@) 29 اندر آن صحرا که شیران دو لشکر صف کشند %~% و آسمان از بر همی خواند برایشان «اقترب »(@)(@@) 30 چشمه روشن نبیند دیده از گرد سپاه %~% بانگ تندر نشنود گوش از غو کوس و چلپ(@)(@@) 31 گشته از تیر خدنگ اندر کف مردان بجنگ %~% درقها چون کاغذ آماج سلطان پر ثقب(@)(@@) 32 سیل خون اندر میانشان رفته و برخاسته %~% بر سر خون همچنان بیجاده گنبدهاحبب(@)(@@) 33 تیغها چون ارغوان و رویها چون شنبلید %~% آن ز خون خلق و این از بیم تاراج و نهب(@)(@@) 34 چون همای رایت تو روی بنماید ز دور %~% زان دو لشکر در زمان بنشیند آشوب و شغب(@)(@@) 35 نامجویانشان بجای نام بپسندند ننگ %~% پیشدستانشان همی پیشی کنند اندر هرب(@)(@@) 36 رزمگه زیشان چنان گردد که پنداری بود %~% هیبت تو بادو ایشان کاه و آن صحرا خشب(@)(@@) 37 جامه نادوخته پوشد هم از روز نخست %~% هر کسی کو را گرفت از هیبت تیغ توتب(@)(@@) 38 ای محمد سیرت و نامت محمد هر که او %~% از محمد بازگردد بازگشت از دین رب(@)(@@) 39 دشمنان تو شریک دشمنان ایزدند %~% بر تو یک یک راز گیتی بر گرفتن «قدوجب »(@)(@@) 40 از قیاس نام تو مر بد سکالان ترا %~% گاه بوجهل لعین خوانیم و گاهی بولهب(@)(@@) 41 گرد بوجهل آنکسی گردد که نندیشد ز جهل %~% بولهب را بر خود آن خواند که بپسندد لهب(@)(@@) 42 گر کسی گوید: من و تو آسمان گوید بدو %~% تو چو او باشی اگر باشد روا که همچو حب(@)(@@) 43 من یقین دانم همی گر چه رجب را فضلهاست %~% یکشب ازماه مبارک به که سی روز از رجب(@)(@@) 44 ای تمامی طالع سعد تو ناکرده پدید %~% دشمنانت چون ستاره بر فلک زیر ذنب(@)(@@) 45 زانکه زین پس تو بزخم هندی و تاب کمند %~% کرد خواهی گردن هر بدسکالی را ادب(@)(@@) 46 بدسکال تو زه 
ms10	 پیراهن از بیم مسد %~% باز نشناسد همی در گردن خویش از کنب(@)(@@) 47 تا چو بنویسی بصورت هر یکی چون هم بوند %~% شیر و شیر و دیر و دیر و زیر و زیر و حب و حب(@)(@@) 48 تا نسازد کامل اندر دایره با منسرح %~% تا نباشد وافر اندر دایره با مقتضب(@)(@@) 49 شادمان باش ای کریم و در کریمی بی ریا %~% پادشا باش ای جواد و در جوادی بی ریب(@)(@@) 50 دشمنان و حاسدان و بدسکالان ترا %~% مرگ اندر بیکسی و زندگانی در تعب PageV1P051(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا ببردی از دل و از چشم من آرام و خواب %~% گه ز دل در آتش تیزم گه از چشم اندر آب(@)(@@) 2 عشق تو باچار چیزم یار دارد هشت چیز %~% مرمرا هر ساعتی زین غم جگر گردد کباب(@)(@@) 3 با رخم زر و زریر و با دلم گرم و زحیر %~% با دو چشمم آب و خون و با تنم رنج و عذاب(@)(@@) 4 وین عجایب تر که چون این هشت با من یار کرد %~% هشت چیز از من ببرد و هشت چیز تنگیاب(@)(@@) 5 راحت وآرام روح ورامش و تسکین دل %~% نزهت ودیدار چشم و زینت و فرشباب(@)(@@) 6 در رگ و اندر تن و اندر دل و در چشم من %~% خواب و صبر و روح و خونم را بر افتاد انقلاب(@)(@@) 7 رنج دارد جای خون و درد دارد جای روح %~% عشق دارد جای صبر و آب دارد جای خواب(@)(@@) 8 این تنم از هجر تو چون برگ بید اندر خزان %~% این دلم در عشق تو چون توزی اندر ماهتاب(@)(@@) 9 روی تو بسترد و بربود و بیفکند و ببرد %~% چارچیز از چارچیز و هر یکی را کرد غاب(@)(@@) 10 خرمی از نوبهار و تازگی از سرخ گل %~% نیکویی از گرد ماه و روشنی از آفتاب(@)(@@) 11 چار چیز تو نباشد سال و مه بی هشت چیز %~% هر یکی زان 
ms11	 هشت دارد سوی دل بردن شتاب(@)(@@) 12 چشم تو بی خواب و سهر و روی تو بی سیم و گل %~% جعد توبی چین و پیچ و زلف تو بی بند و تاب(@)(@@) 13 تاب زلفین و خم جعد تو نشناسم همی %~% از خم و تاب کمند خسرو مالک رقاب(@)(@@) 14 میر ابواحمد محمد خسرو ایران زمین %~% کایزد او را چند چیز نیک داد از چند باب(@)(@@) 15 از هنر نام بلند و از شرف جاه عریض %~% از ادب لفظ بدیع و از خرد رای صواب(@)(@@) 16 با هنر دست سخی و با شرف روی نکو %~% با خرد خوی نکو با سخن فصل الخطاب(@)(@@) 17 هر گز او در چار وقت از چار چیز اندر نماند %~% عجز هرگز پیش یک نهمت نگشت او راحجاب(@)(@@) 18 وقت کردار از توان و وقت پیکار از عدو %~% وقت دیدار از صواب و وقت گفتار از جواب(@)(@@) 19 هشت چیز از او ببرد از هشت مایه هشت چیز %~% سال و ماه این هشت چیزش را همینست اکتساب(@)(@@) 20 حلم او سنگ زمین و طبع او لطف هوا %~% روی او دیدار ماه و کف او جود سحاب(@)(@@) 21 رسم او حسن بهار و لفظ او قدر شکر %~% خلق او بازار مشک و خوی او بوی گلاب(@)(@@) 22 در دیار گوزگانان اندرین عهد قریب %~% چار چیز نامور کرد از پی مزد و ثواب(@)(@@) 23 مسجد آدینه و عالی منار میمنه %~% سد رود شور بار و جوی آب نوسراب(@)(@@) 24 از پی خوبی و از بهر صلاح مردمان %~% کشت کرد اندر بیابان آب راند اندر سراب(@)(@@) 25 دولت و اقبال او بی حیلت و بی رنج و ذل %~% بوستان وسبزه کرد از سوخته دشتی خراب(@)(@@) 26 هشت چیزش را برابر یافتم با هشت چیز %~% هر یکی زان هشت سوی فضل او دارد مآب(@)(@@) 27 تیغ او را با قضا وتیر او را با قدر %~% دست او را با 
