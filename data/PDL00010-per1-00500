ms481	 کردت جهل و بد دل تا نیارد جانت هیچ %~% گرد مردان به نیرو گشتن از بی‌نیروی(@)(@@) 33 داروت علم است علم حق به سوی من ولیک %~% تو گریزنده و رمنده روز و شب زین داروی(@)(@@) 34 هر که بوی داروی من یابد از تو بی‌گمان %~% گویدت تو بر طریق ناصربن خسروی(@)(@@) 35 شعر حجت بایدت خواندن همی گرت آرزوست %~% نظم خوب و وزن عذب و لفظ خوش و معنوی PageV1P252(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای طمع کرده ز نادانی به عمر هرگزی %~% با فزونی و کمی مر هرگزی را کی سزی(@)(@@) 2 در میان آتشی و اندر میانت آتش است %~% آب را چندین همی از بیم آتش چون مزی(@)(@@) 3 گر همی خواهی که جاویدان بمانی ای پسر %~% در میان این دو آتش خویشتن را چون پزی(@)(@@) 4 در میان خز و بز مر خاک را پنهان که کرد %~% جز تو از خاکی سرشته و خفته بر خز و بزی(@)(@@) 5 از کجا اندر خزیده‌ستی بدین بی‌در حصار %~% همچنان یک روز از اینجا ناگهان بیرون خزی(@)(@@) 6 نیک بر رس تا برون زین دز چه باید مر تو را %~% آن به دست آور کنون کاندر میان این دزی(@)(@@) 7 همچنین دانم نخواهد ماند برگشت زمان %~% موی جعدت عنبری و روی خوبت قرمزی(@)(@@) 8 بی‌گمان شو زانکه یک روز ابر دهر بی‌وفا %~% برف بارد هم بر آن شاهسپرغم مرغزی(@)(@@) 9 هرمز و خسرو تهی رفتند از اینجا ای پسر %~% پس همان گیرم که تو خود خسروی یا هرمزی(@)(@@) 10 قدرت و ملک و صناعت خیره دعوی چون کنی %~% چون خود از ماندن در این مصنوع خانه عاجزی(@)(@@) 11 آنکه بر حکم و قضای حتم او برخاستند %~% زین سیاه و تیره مرکز زندگان مرکزی(@)(@@) 12 اندر این ناهر گزی از بهر آن آوردمان %~% تا بیلفنجیم از این‌جا مال و ملک هرگزی(@)(@@) 13 مادر توست این جهان بنگر کز این مادر همی %~% نیک‌بخت و جلد 
ms482	 زادی یا به نفرین و خزی(@)(@@) 14 چون نیلفنجی به طاعت عمر جاویدی همی %~% چون همی شادان بباشی گرت گویم «دیر زی»(@)(@@) 15 تن ز بهر طاعتت دادند عاصی چون شدی %~% گر نه‌ای بدبخت بر پستان مادر چون گزی(@)(@@) 16 عارضی با مال و ملک و تا رسی بر آب و نان %~% کشته‌ای در خاک نادانی درخت گربزی(@)(@@) 17 هم سپیداری به بی‌باری و هم بی‌سایگی %~% گر برستی بهتر آن باشد که هرگز نغرزی(@)(@@) 18 گر بزی را از تو پیدا گشت معنی زانکه تو %~% بی‌شبان درنده گرگی با شبان لاغر بزی(@)(@@) 19 علم و طاعت ورز تا مردم شوی امروز تو %~% ویحکا مانند مردم زیر دیبا و خزی(@)(@@) 20 پروز جان علم باشد علم جو از بهر آنک %~% جامه بی‌مقدار و قیمت گردد از بی‌پروزی(@)(@@) 21 مال و ملک و زور تن دایم نماند کاین همه %~% پیرزیهااند و بس بی‌قدر باشد پیرزی(@)(@@) 22 عاجزی گرگی است ای غافل که او مردم خورد %~% عاجز آئی بی‌گمان هرچند کاکنون معجزی(@)(@@) 23 دیر برناید تو را کاندر بیابان اوفتی %~% خانه اکنون کن پر از بر کاندر این بر بروزی(@)(@@) 24 پند حجت را بخوان و درس کن زیرا که هست %~% چون قران از محکمی وز نیکوی وز موجزی PageV1P253(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آمد و پیغام حجت گوش‌دار ای ناصبی %~% پاسخش ده گر توانی سر مخار ای ناصبی(@)(@@) 2 هرچه گوئی نغز حجت گوی لیکن قول نغز %~% کی پدید آید ز مغز پربخار ای ناصبی(@)(@@) 3 علم ناموزی و لشکرسازی از غوغا همی %~% چون چنینی بی‌فسار و بادسار ای ناصبی(@)(@@) 4 چند فخر آری بدین بسیاری جهال عام %~% نیستت این فخر ننگ است این و عار ای ناصبی(@)(@@) 5 همچنان کز صد هزاران خار یک خرما به است %~% نیز یک دانا به از نادان هزار ای ناصبی(@)(@@) 6 چشم دل هر چند کورستت به چشم دل ببین %~% بر درختان بیش و کم و برگ 
ms483	 و بار ای ناصبی(@)(@@) 7 امتی مر بوحنیفه و شافعی را از رسول %~% شرم ناید مر تو را زین زشت کار ای ناصبی(@)(@@) 8 %~% مصطفی بر گردن و اندر کنار ای ناصبی(@)(@@) 9 بوحنیفه و شافعی را بر حسین و بر حسن %~% چون گزیدی همچو بر شکر شخار ای ناصبی(@)(@@) 10 نور یزدان از محمد وز علی اولاد اوست %~% تو برونی با امامت زین قطار ای ناصبی(@)(@@) 11 چون ننازم بهر داماد و وصی و اولاد او %~% گر بنازی تو به یار و پیش‌کار ای ناصبی(@)(@@) 12 نیست جز بهر ابوبکر و عمر با من تو را %~% نه لجاج و نه مری نه خار خار ای ناصبی(@)(@@) 13 گر مرایشان را تو هریک یار پیغمبر نهی %~% من نگویم جز که حق و آشکار ای ناصبی(@)(@@) 14 %~% همچو او هر یک رسول کردگار ای ناصبی(@)(@@) 15 گرچه اندر رشته دری کشندش کی بود %~% سنگ هرگز یار در شاهوار ای ناصبی(@)(@@) 16 گرچه بر دیوار و بر در صورت مردم کنند %~% یار مردم باشد آن نیکونگار ای ناصبی(@)(@@) 17 ور حدیث غار گوئی نیست این افضل و نه فخر %~% حجت‌آور پیش من چربک میار ای ناصبی(@)(@@) 18 آنکه پیغمبر به زیر ساق عرش %~% از شرف شد نه ز خفتن شد به غار ای ناصبی(@)(@@) 19 زی تو گر یاران چهارند از ره دین سوی من %~% نیست جز حیدر امامی نه سه یار ای ناصبی(@)(@@) 20 زانکه ما هرچند دیوار است مزگت را چهار %~% قبله یک دیوار داریم از چهار ای ناصبی(@)(@@) 21 از پس پیغمبر آن باشد خلیفه کو بود %~% هم مبارز هم به علم اندر سوار ای ناصبی(@)(@@) 22 از علی علم و شجاعت سوی امت ظاهر است %~% روشن و معروف و پیدا چون نهار ای ناصبی(@)(@@) 23 زیر بار جهل مانده‌ستی ازیرا مر تو را %~% در مدینه علم و حکمت نیست بار ای ناصبی(@)(@@) 24 از علی مشکل نماند اندر 
ms484	 کتاب حق مرا %~% علم بوبکر و عمر پیش من آر ای ناصبی(@)(@@) 25 من ز دین در زیر بار و بارور خرما بنم %~% تو به زیر بیدی و بی‌بر چنار ای ناصبی(@)(@@) 26 راز ایزد با محمد بود و جز حیدر نبود %~% مر محمد را ز امت رازدار ای ناصبی(@)(@@) 27 گر ز پیغمبر بجز فرزند حیدر کس نماند %~% تا قیامت رازدار و یادگار ای ناصبی(@)(@@) 28 ای دریغا چونکه نامد سوی بوبکر و عمر %~% زاسمان صمصام تیز و ذوالفقار ای ناصبی(@)(@@) 29 روز خیبر چونکه بوبکر و عمر آن در نکند %~% تا علی کند آن قوی در زان حصار ای ناصبی(@)(@@) 30 عمر و بن معدی کرب را روز حرب %~% پیش پیغمبر گریز از کارزار ای ناصبی(@)(@@) 31 از پیمبر خیبری را خط آزادی که داد %~% جز علی کو بد وزیر و هوشیار ای ناصبی(@)(@@) 32 فخر بر دیگر جهودان خیبری را خط اوست %~% بنگر آنک گر نداری استوار ای ناصبی(@)(@@) 33 چون گریزی از علی کو شیر دین ایزد است %~% گر نگشته‌ستی به دین‌اندر حمار ای ناصبی(@)(@@) 34 چون پدید آمد به خندق برق تیغ ذوالفقار %~% گشت روی عمر و عنتر لاله‌زار ای ناصبی(@)(@@) 35 هر که مرد است از جهان دل با علی دارد مگر %~% تو که با مردان نباشی در شمارای ناصبی(@)(@@) 36 هنچنان آنگه برآورد از سر کافر علی %~% من بر آرم از سرت گرد و دمارای ناصبی(@)(@@) 37 شاد چون گشتی براندندم به قهر از بهر دین %~% از ضیاع خویش و از دار و عقارای ناصبی(@)(@@) 38 تا قرار من به یمگان است می‌دانم که نیست %~% جز به یمگان علم و حکمت را قرارای ناصبی(@)(@@) 39 زانکه در عالم علم گشته به نام آنکه اوست %~% خازن علم خدای کامگارای ناصبی(@)(@@) 40 آنکه تا او را ندانی می‌خوری و می‌چری %~% تو بجای ار ای ناصبی(@)(@@) 41 چون ز مشکلهات پرسم عورتت پیدا شود %~% بی‌ازاری بی‌ازاری 
ms485	 بی‌ازار ای ناصبی(@)(@@) 42 طبع خر داری تو حکمت را کسی بر طبع تو %~% بست نتواند به سیصد رش نوار ای ناصبی(@)(@@) 43 چون بیائی سوی من با مزه خرمائی همی %~% چند باشی بی‌مزه همچون خیار ای ناصبی(@)(@@) 44 تا قیامت بر مکافات فعال زشت تو %~% این قصیده بس تو را از من نثار ای ناصبی PageV1P254(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آن جنگی مرد شایگانی %~% معروف شده به پاسبانی(@)(@@) 2 در گردنش از عقیق تعویذ %~% بر سرش کلاه ارغوانی(@)(@@) 3 بر روی نکوش چشم رنگین %~% چون بر گل زرد خون چکانی(@)(@@) 4 بر پشت فگنده چون عروسان %~% زربفت ردای پرنیانی(@)(@@) 5 بسیار نکوتر از عروسان %~% مردی است به پیری و جوانی(@)(@@) 6 بی‌زن نخورد طعام هرگز %~% از بس لطف و ز مهربانی(@)(@@) 7 تا زنده همیشه چون سواری %~% با بانگ و نشاط و شادمانی(@)(@@) 8 واندر پس خویش دو علامت %~% کرده است به پای خسروانی(@)(@@) 9 آلوده به خون کلاه و طوقش %~% این است ز پردلی نشانی(@)(@@) 10 نه لشکری است این مبارز %~% بل حجرگی است و شایگانی(@)(@@) 11 از گوشه بام دوش رازی %~% با من بگشاد بس نهانی(@)(@@) 12 گفتا که «به شب چرا نخسپی %~% وز خواب و قرار چون رمانی(@)(@@) 13 یا چون نکنی طلب چو یاران %~% داد خود از این جهان فانی(@)(@@) 14 نوروز ببین که روی بستان %~% شسته است به آب زندگانی(@)(@@) 15 واراسته شد چون نقش مانی %~% آن خاک سیاه باستانی(@)(@@) 16 بر سر بنهاد بار دیگر %~% نو نرگس تاج اردوانی(@)(@@) 17 درویش و ضعیف شاخ بادام %~% کرده است کنار پر شیانی(@)(@@) 18 گیتی به مثل بهشت گشته است %~% هرچند که نیست جاودانی(@)(@@) 19 چون شاد نه‌ای چو مردمان تو %~% یا تو نه ز جنس مردمانی(@)(@@) 20 آن می‌طلبد همی و آن گل %~% چون تو نه چنین و نه چنانی(@)(@@) 21 چون کار تو کس ندید کاری %~% امروز تو نادرالزمانی(@)(@@) 22 تو زاهدی و سوی گروهی %~% بتر 
ms486	 ز جهود و زندخوانی(@)(@@) 23 بر دین حقی و سوی جاهل %~% بر سیرت و کیش هندوانی(@)(@@) 24 سودت نکند وفا چو دشمن %~% از تو به جفا برد گمانی(@)(@@) 25 سنگ است و سفال بردل او %~% گر بر سر او شکر فشانی(@)(@@) 26 زین رنج تو را رها نیارد %~% جز حکم و قضای آسمانی»(@)(@@) 27 گفتم که: به هر سخن که گفتی %~% زی مرد خرد ز راستانی(@)(@@) 28 خوابم نبرد همی که زیرا %~% شد راز فلک مرا عیانی(@)(@@) 29 بشنودم راز او چو ایزد %~% برداشت زگوش من گرانی(@)(@@) 30 گیتی بشنو که می چه گوید %~% با بی‌دهنی و بی‌زبانی(@)(@@) 31 گوید که «مخسپ خوش ازیرا %~% من منزلم و تو کاروانی»(@)(@@) 32 هرکو سخن جهان شنوده است %~% خوار است به سوی او اغانی(@)(@@) 33 غره چه شوی به دانش خویش %~% چون خط خدای بر نخوانی(@)(@@) 34 زیرا که دگر کسان بدانند %~% آن چیز که تو همی بدانی(@)(@@) 35 واکنون که شنودم از جهان من %~% آن نکته خوب رایگانی(@)(@@) 36 کی غره شود دل حزینم %~% زین پس به بهار بوستانی(@)(@@) 37 خوش باد شب کسی که او را %~% کرده است زمانه میزبانی(@)(@@) 38 من دین ندهم ز بهر دنیا %~% فرشم نه بکار و نه اوانی(@)(@@) 39 الفنجم خیر تا توانم %~% از بیم زمان ناتوانی(@)(@@) 40 ای آنکه همی به لعنت من %~% آواز بر آسمان رسانی(@)(@@) 41 از تو بکشم عقاب دنیا %~% از بهر ثواب آن جهانی(@)(@@) 42 دل خوش چه بوی بدانکه ناصر %~% مانده است غریب و مندخانی(@)(@@) 43 آگاه نه‌ای کز این تصرف %~% بر سود منم تو بر زیانی(@)(@@) 44 من همچو نبی به غارم و تو %~% چون دشمن او به خان و مانی(@)(@@) 45 روزی بچشی جزای فعلت %~% رنجی که همی مرا چشانی(@)(@@) 46 جائی که خطر ندارد آنجا %~% نه سیم زده نه زر کانی(@)(@@) 47 وانجا نرود مگر که طاعت %~% نه مهتری و نه با فلانی(@)(@@) 48 پیش آر قران 
ms487	 و بررس از من %~% از مشکل و شرحش و معانی(@)(@@) 49 بنکوه مرا اگر ندانم %~% به زانکه تو بی‌خرد برآنی(@)(@@) 50 لیکن تو نه‌ای به علم مشغول %~% مشغول به طاق و طیلسانی(@)(@@) 51 ای مسکین حجت خراسان %~% بر خوگ رمه مکن شبانی(@)(@@) 52 کی گیرد پند جاهل از تو %~% در شوره نهال چون نشانی PageV1P255(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دیوی است جهان پیر و غداری %~% که‌ش نیست به مکر و جادوی یاری(@)(@@) 2 باغی است پر از گل طری لیکن %~% بنهفته به زیر هر گلی خاری(@)(@@) 3 گر نیست مراد خستن دستت %~% زین باغ بسند کن به دیداری(@)(@@) 4 این بلعجبی است خوش کجا باشد %~% از بازی او مگر که نظاری(@)(@@) 5 زنهار مشو فتنه برو زیرا %~% حوری است ز دور و خوب گفتاری(@)(@@) 6 بشکست هزار بار پیمانت %~% آگه نشدی ز خوی او باری(@)(@@) 7 لیکن چو به دام خویش آوردت %~% گرگی است به فعل و زشت کفتاری(@)(@@) 8 صد سالت اگر ز مکر او گویم %~% خوانده نشود خطی ز طوماری(@)(@@) 9 روز و شب بیخ ما همی برد %~% غمری نرم است و گول طراری(@)(@@) 10 هر روز یکی لباس نو پوشد %~% از بهر فریب نو خریداری(@)(@@) 11 روزی سقطی شکار او باشد %~% روزی شاهی و نام برداری(@)(@@) 12 فرقی نکند میان نیک و بد %~% مستی نشناسد او ز هشیاری(@)(@@) 13 ماری است کزو کسی نخواهد رست %~% از خلق جهان بجمله دیاری(@)(@@) 14 زین پیش جز از وفای آزادان %~% کاریش نبود نه بباواری(@)(@@) 15 مر طغرل ترکمان و چغری را %~% با تخت نبود و با مهی کاری(@)(@@) 16 استاده بدی به بامیان شیری %~% بنشسته به عز در بشیر شاری(@)(@@) 17 بر هر طرفی نشسته هشیاری %~% گسترده به داد و عدل آثاری(@)(@@) 18 از فعل بد خسان این امت %~% ناگاه چنین بخاست آواری(@)(@@) 19 ابلیس لعین بدین زمین اندر %~% ذریت خویش دید بسیاری(@)(@@) 20 یک چند به زاهدی پدید آمد %~% بر صورت 
