ms4286	 محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 77، ح 2، و ب 99، ح 12، و ب 204، ح 2.(@)(@@) وروى عنه الحسن.(@)(@@) التهذيب: ج 2، ح 648 (الإستبصار:(@)(@@) ج 1، ح 1073، وفيه الحسن بن علي).(@)(@@) وروى عنه ابنه الحسن.(@)(@@) الكافي: ج 2، ك 1، ب 163، ح 16.(@)(@@) وروى عنه الحسين.(@)(@@) التهذيب: ج 5، ح 789 (الإستبصار:(@)(@@) ج 2، ح 984، و 1001، وفي الأول الحسين بن سعيد، وفي الثاني عبد الله ابن مسكان).(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 1385 (الإستبصار:(@)(@@) ج 1، ح 681)، و ج 5، ح 775 (الإستبصار: ج 2، ح 984، و 1001، وفي PageV13P363(@)(@@) الثاني الحسين عن علي بن النعمان عن عبد الله بن مسكان)، و 1182، 1310 (الإستبصار: ج 2، ح 728)، و ج 6، ح 477، و ج 7، ح 173، و 246، و 374 (الإستبصار: ج 3، ح 290)، و 455، و 473، و 533، و 937، و ج 8، ح 271 (الإستبصار: ج 3، ح 1089)، و 508 (الإستبصار: ج 3، ح 128)، و 790 (الإستبصار: ج 4، ح 11)، و 794 (الإستبصار: ج 4، ح 12)، و 817، و ج 9، ح 44 (الإستبصار: ج 4، ح 217)، و 270 (الإستبصار: ج 4، ح 303)، و ج 9، ح 943، و ج 10، ح 632، و 828 (الإستبصار: ج 4، ح 1059)، و 871، 889، (الإستبصار:(@)(@@) ج 4، ح 1076).(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) الكافي: ج 1، ك 4، ب 33، ح 5، و ج 2، ك 1، ب 97، ح 23، و ج 4، ك 3، ب 163، ح 6، و ج 5، ك 2، ب 103، ح 8، و ج 6، ك 5، ب 15، ح 10.(@)(@@) والتهذيب: ج 6، ح 1077 (الإستبصار:(@)(@@) ج 3، ح 179)، و ج 7، ح 593 (الإستبصار: ج 3، ح 179).(@)(@@) وروى عنه محمد البرقي.(@)(@@) الكافي: ج 1، ك 3، ب 1، ح 6.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الروضة: ح 19.(@)(@@) وروى عنه محمد بن محفوظ.(@)(@@) الكافي: ج 2، ك 1، ب 141، ح 7.(@)(@@) وروى عنه موسى بن عمر بن يزيد البصري.(@)(@@) التهذيب: ج 1، ح 1539).(@)(@@) * وروى عن إسحاق، وروى عنه الحسن بن علي.(@)(@@) التهذيب: ج 6، ح 999.(@)(@@) وروى عنه علي بن الحسن.(@)(@@) الكافي: ج 3، ك 5، ب 2، ح 15.(@)(@@) * وروى عن إسحاق بن عمار، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 146، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 68، ح 2، و ب 203، ح 3.(@)(@@) وروى عنه محمد بن إسماعيل.(@)(@@) التهذيب: 
ms4287	 ج 3، ح 670 (الإستبصار:(@)(@@) ج 1، ح 1572).(@)(@@) وروى عنه محمد بن علي.(@)(@@) التهذيب: ج 9، ح 1038.(@)(@@) * وروى عن إسماعيل بن جابر، PageV13P364(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 2، ب 20، ح 9.(@)(@@) وروى عن أيوب بن الحر، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 96، ح 1 * وروى عن ثابت بن أبي سعيد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 159، ح 3.(@)(@@) * وروى عن الحارث بن المغيرة النصري، وروى عنه علي بن حديد.(@)(@@) الكافي: ج 3، ك 4، ب 84، ح 15.(@)(@@) والتهذيب: ج 2، ح 5.(@)(@@) * وروى عن الحارث النصري، وروى أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 16.(@)(@@) * وروى عن الحسين بن أبي العلاء، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 4، ب 56، ح 11.(@)(@@) والتهذيب: ج 3، ح 782 (الإستبصار:(@)(@@) ج 1، ح 1400، وفيه يعقوب بن يزيد بدل أحمد بن محمد).(@)(@@) وروى عنه يعقوب بن يزيد.(@)(@@) التهذيب: ج 2، ح 731 (الإستبصار:(@)(@@) ج 1، ح 1400).(@)(@@) * وروى عن حمزة بن حمران، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 33، ح 9.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 65، ح 1.(@)(@@) * وروى عن داود بن الحصين، وروى عنه علي بن حديد، ومحمد بن الحسين ابن أبي الخطاب، ومحمد بن خالد، والهيثم بن أبي مسروق النهدي.(@)(@@) التهذيب: ج 6، ح 726 (الإستبصار:(@)(@@) ج 3، ح 98، وفيه علي بن حديد ومحمد ابن خالد فقط).(@)(@@) وروى عنه علي بن حديد، ومحمد بن خالد.(@)(@@) التهذيب: ج 6، ح 774 (الإستبصار:(@)(@@) ج 3، ح 81).(@)(@@) وروى عنه الهيثم بن أبي مسروق النهدي.(@)(@@) التهذيب: ج 6، ح 726.(@)(@@) * وروى عن داود بن فرقد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 3، ب 29، ح 5، و ك 4، ب 30، ح 4.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 105، ح 1.(@)(@@) وروى عنه الحسين بن سعيد. PageV13P365(@)(@@) الكافي: ج 4، ك 3، ب 139، ح 6.(@)(@@) والتهذيب: ج 1، ح 1428 (الإستبصار:(@)(@@) ج 1، ح 713).(@)(@@) * وروى عن زيد أبي أسامة، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 5.(@)(@@) * وروى عن سعيد الأعرج.(@)(@@) الفقيه: ج 2، ح 1502.(@)(@@) وروى 
