ms31	 دل من کامروا گشت و رواست %~% ازهمه ترکان چون ترک من امروز کجاست(@)(@@) 2 مشک با زلف سیاهش نه سیاهست و نه خوش %~% سرو با قد بلندش نه بلندست و نه راست(@)(@@) 3 همه نازیدن آن ماه بدیدار منست %~% همه کوشیدن آن ترک بمهر و بوفاست(@)(@@) 4 او سمن سینه و نوشین لب و شیرین سخنست %~% مشتری عارض و خورشید رخ و زهره لقاست(@)(@@) 5 روی او را من از ایزد بدعا خواسته ام %~% آنچنان روی ز ایزد بدعا باید خواست(@)(@@) 6 دل من خواست همی بر کف او دادم دل %~% ور بجای دل جان خواهد بدهم که سزاست(@)(@@) 7 اندرین عشق مرا نیز ملامت مکنید %~% کاین قضاییست بر این سر که ندانم چه قضاست(@)(@@) 8 مردمان گویند این دل شده کیست برو %~% که ز من دل شده این انده و اندیشه مراست(@)(@@) 9 در دلم هیچکسی دست نیابد ببدی %~% تا درو مدحت فرزند وزیر الوزراست(@)(@@) 10 خواجه سید حجاج علی بن الفضل %~% آنکه از بار خدایان جهان بی همتاست(@)(@@) 11 روز وشب درگه او خانه اهل هنرست %~% سال و مه مجلس او مسکن و جای ادباست(@)(@@) 12 بسخا مرده صد ساله همی زنده کند %~% این سخا معجز عیسی است همانا نه سخاست(@)(@@) 13 همچو بر شاخ درختان اثر باد بهار %~% اثرنعمت او بر همه گیتی پیداست(@)(@@) 14 همچنو ما همه از نعمت او بهره وریم %~% پس چو نیکو نگری نعمت او نعمت ماست(@)(@@) 15 مردمی زنده بدویست و سخا زنده بدو %~% وین دو چیزست که او را بجهان کام و هواست(@)(@@) 16 سال و مه در طلب نعمت و ناز خدمست %~% روز و شب در سخن زائر و تدبیر عطاست(@)(@@) 17 همه نازیدنش از دیدن زوار بود %~% وامق است او بمثل گوئی وزائر عذراست(@)(@@) 18 کهتری را بر او خدمت جاه و کرمست %~% خدمتی را بر او نعمت بسیار جزاست(@)(@@) 19 خدمت فرخ او باید ورزید امروز %~% هر که 
ms32	 را آرزوی نعمت و ناز فرداست(@)(@@) 20 مرد را خدمت یکروزه آن بارخدای %~% گرچه مسرف بودو مفرط صد ساله نواست(@)(@@) 21 مهتران سپهی عاشق مهرو درمند %~% بس درمهای درستست وبر این قول گواست(@)(@@) 22 دل خواجه است که هرگز نگراید بدرم %~% دل خواجه نه دلستی که همانا دریاست(@)(@@) 23 از پی عرض نگهداشتن و جاه عریض %~% خواسته بر دل او خوارتر از خاک و حصاست(@)(@@) 24 چونکه داور بود او داور بیغل و غشست %~% چونکه حاکم بود او حاکم بی روی و ریاست(@)(@@) 25 ضعفا را بهمه حالی یارست و خدای %~% یار آنست بهر وقت که یار ضعفاست(@)(@@) 26 هم ز بهر ضعفا مال خداوند بسا %~% بپذیرفت و بیفزود و برآورد و بکاست(@)(@@) 27 نامه یی کرد سوی خواجه سید که بفضل %~% شغل آن کار کفایت کن کان کار تراست(@)(@@) 28 هم دل خلق نگه دارد و هم مال امیر %~% کارفرمای چنین در مه آفاق کجاست(@)(@@) 29 رمضان آمد و دیوان مؤونت برداشت %~% خلق را گفت مرا شادی از ایام شماست(@)(@@) 30 مردمان اکنون دانند که چون باید خفت %~% مردمان اکنون دانندکه چون باید خاست(@)(@@) 31 لا جرم بر تن و بر جان امیر از همه خلق %~% روز تا روز به نیکی ز دگرگونه دعاست(@)(@@) 32 گر کسی گوید کافی تر و کامل تر ازو %~% هیچ مهتر بود این لفظ چنان دان که خطاست(@)(@@) 33 در جهان با نظر او نه بلاماند و نه غم %~% نظر نیکوی او نفی غم و دفع بلاست(@)(@@) 34 از حلیمی چو زمینست و به رادی چو فلک %~% از تمامی چو جهانست و بپاکی چو هواست(@)(@@) 35 تا فلکها را دورست و بروجست و نجوم %~% تا کواکب را سیرست و فروغست و ضیاست(@)(@@) 36 تا بسال اندر سه ماه بود فصل ربیع %~% نه مه دیگر صیفست و خریفست و شتاست(@)(@@) 37 مجلس و پیشگه از طلعت او فرد مباد %~% که ازو پیشگه و مجلس با 
ms33	 فر و بهاست(@)(@@) 38 شادمان باد و نصیبش ز جهان نعمت و ناز %~% نعمت و نازی کانرا نه زوال و نه فناست(@)(@@) 39 دیدن ماه نو و عید بدو فرخ باد %~% که همایون پی و فرخ رخ و فرخنده لقاست PageV1P063(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دل آن ترک نه اندر خور سیمین بر اوست %~% سخن او نه ز جنس لب چون شکر اوست(@)(@@) 2 با لب شیرین با من سخنان گوید تلخ %~% سخن تلخ نداند که نه اندر خور اوست(@)(@@) 3 نه باندازه کند کار و نگویم که مکن %~% چکنم پس که مرا جان جهان در بر اوست(@)(@@) 4 از همه خلق دل من سوی او دارد میل %~% بیهده نیست پس آن کبر که اندر سر اوست(@)(@@) 5 سرو را ماند کآورده گل سوری بار %~% بینی آن سرو که خندان گل سوری بر اوست(@)(@@) 6 مادرش گفت پسر زایم سرو و مه زاد %~% پس مرا این گله و مشغله با مادر اوست(@)(@@) 7 آن رخ چون گل بشکفته وبالای چو سرو %~% خواجه دیده ست همانا که رهش بردر اوست(@)(@@) 8 خواجه سیدبوبکر حصیری که خدای %~% هرچه داده ست بدو در خور او وز در اوست(@)(@@) 9 مهتر محتشمانست بحشمت نه بزاد %~% از همه محتشمان هر که بود کهتر اوست(@)(@@) 10 هر که از چاکری و خدمت او رنج برد %~% رنج نادیده جهان چاکر و خدمتگر اوست(@)(@@) 11 چاکری کردن او در شرف از میری به %~% ورنه چون چشم همه میران بر چاکر اوست(@)(@@) 12 دشمنی کردن با مرد چنو بیخردیست %~% خرد دشمن او در سخن مضمر اوست(@)(@@) 13 دشمن خواجه ببال و پر مغرور مباد %~% که هلاک و اجل مورچه بال و پر اوست(@)(@@) 14 هر مخالف که بدو قصد کند نیست شود %~% ور مثل سعد فلکها همه از اختر اوست(@)(@@) 15 آتشی دان تو خلافش را در سوزش و تف %~% که مثل چرخ اثیر از تف خاکستر اوست(@)(@@) 16 مهر فرزندی 
ms34	 بر خواجه فکنده ست جهان %~% زانکه چون مادرانده خوروانده براوست(@)(@@) 17 دشمن ار مهر طمع دارد ازو بیهدگیست %~% که جهان مادر او نیست که مادندر اوست(@)(@@) 18 کس در این گیتی با دشمن او دوست مباد %~% کاژدهاییست جهان دشمن خواجه خور اوست(@)(@@) 19 او کریمیست عطا بخش و کریمی که مدام %~% روزی خلق بدان دست ولی پرور اوست(@)(@@) 20 دل او وقت عطا دادن بحریست فراخ %~% که مه زود رو اندر طلب معبر اوست(@)(@@) 21 نتوان گفت که دریای دمان را دگرست %~% نتوان گفت که درهای دگر جز در اوست(@)(@@) 22 از کریمی دل او سیر شود هرگز نه %~% این سرشتیست که در خلقت و در گوهر اوست(@)(@@) 23 دست او همچو درختیست که چشم همه خلق %~% ببهار و بخزان برگل و برگ و بر اوست(@)(@@) 24 برتن هیچکس از هیچ ستمگر نبود %~% آن ستم کز کف بخشنده او برزر اوست(@)(@@) 25 گر بکف گیرد ساغر بخروش آید زر %~% آن خروش از کف او ناید کز ساغر اوست(@)(@@) 26 هر چه در گیتی از معنی خواهند گیست %~% نام او با صلت نیکو در دفتراوست(@)(@@) 27 این عطا دادن دایم خوی پیغمبر ماست %~% ای خنک آنکس کورا خوی پیغمبر اوست(@)(@@) 28 سببی باید تا فخر توان کرد بدان %~% رادی و فخرو بزرگی سبب مفخر اوست(@)(@@) 29 مخبری باید بر منظر پاکیزه گواه %~% مخبری در خور منظر بجهان مخبر اوست(@)(@@) 30 همه خوبی و نکویی بود او را ز خدای %~% وین رهی را که ستایشگر و مدحتگر اوست(@)(@@) 31 عید او فرخ و او شاد بفرخنده بتی %~% که گه استاده می اندر کف و گه در بر اوست PageV1P064(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 همی تا خسرو غازی خداوند جهان باشد %~% جهان چون ملکش آبادان و چون بختش جوان باشد(@)(@@) 2 چنان باشد جهان همواره تا شاه اندران باشد %~% ازیرا کو فرشته ست و فرشته در جنان باشد(@)(@@) 3 بهار از عارض خوبش همانا نسبتی 
ms35	 دارد %~% که ایدون دلگشا و دلپذیر و دلستان باشد(@)(@@) 4 بهار امسال پنداری که از بزمش برون آید %~% که خوب آید چنان چون مهر یکدل دوستان باشد(@)(@@) 5 گلستان بهرمان دارد همانا شیر خوارستی %~% لباس کودکان شیر خواره بهرمان باشد(@)(@@) 6 کنون کوه و بیابانرا نبات از عودتر باشد %~% کنون شاخ درختانرا لباس از پرنیان باشد(@)(@@) 7 کنون بلبل بشاخ سرو برتو راه خوان گردد %~% چرای آهوان هر ساعتی در گلستان باشد(@)(@@) 8 سحر گاهان هزار آوار ز گلبن ناله برگیرد %~% چو بیدل عاشقی کز عشق یار اندر فغان باشد(@)(@@) 9 درخت گل سپیده دم بهر بیننده بنماید %~% هر آنچ اندر دل پر خون او راز نهان باشد(@)(@@) 10 خجسته باد بر شاه این بهار و خرم و دایم %~% همه آن باد کو را جان و دل زان شادمان باشد(@)(@@) 11 شه لشکر شکن محمود کشور گیر کز بیمش %~% رخ اعدای دین دایم برنگ زعفران باشد(@)(@@) 12 برنگ زعفران باشد رخ اعدای دین زانکس %~% کجا تیغش ز خون حلقشان چون ارغوان باشد(@)(@@) 13 تنی کز طاعت اوسر بپیچد خیره سر باشد %~% سری کز خدمتش بی بهره باشد بر سنان باشد(@)(@@) 14 همه شاهان بزرگی زوهمی جویند و او زایزد %~% ازین باشدکه دایم بر هواها کامران باشد(@)(@@) 15 بجز دریا نخواندی کس کف گوهر فشانشرا %~% اگر نز بهر آن بوید که دریا را کران باشد(@)(@@) 16 همانا دست گوهر بار او جانست ورادی تن %~% بلی رادی باو زنده ست و تن زنده بجان باشد(@)(@@) 17 اگر بر چیز بخشیده ز بخشنده نشان بودی %~% نبینی هیچ دیناری کزو بی صد نشان باشد(@)(@@) 18 چهارم آسمان گویی ز رایش نسبتی دارد %~% که خورشید درخشان برچهارم آسمان باشد(@)(@@) 19 گران کوه از گران حلمش پدید آمد و گر نامد %~% چرا ماننده حلم گران سنگش گران باشد(@)(@@) 20 بنازد گوهر پولاد برهر گوهر و زیبد %~% بدان مفخر که از پولاد رمحش را سنان باشد(@)(@@) 21 
ms36	 ولی چون روی او بیند فزون سازد خدا عمرش %~% و گر چه زین جهان تا آن جهانش یکزمان باشد(@)(@@) 22 عدو چون تیغ او بیند بجان او را زیان آید %~% اگر چه چشمه حیوان عدو را در دهان باشد(@)(@@) 23 خدنگش تیز رو پیکی که از رفتن نیاساید %~% ولیکن منزلش تاباشد اندر استخوان باشد(@)(@@) 24 عدوی شاه مشرق را بسوزد هر زمانی دل %~% بسوزد آن دلی کآتش مر او را در میان باشد(@)(@@) 25 دل اعدای او سنگست از آنست اندرو آتش %~% نبینی کآتش سوزان بسنگ اندر نهان باشد(@)(@@) 26 دل اعداش از آن آتش که دارد سوخته گردد %~% ولیکن سنگ از آن آتش که دارد بی زیان باشد(@)(@@) 27 نباید جست جز مهرش کسی را کش خرد باشد %~% نباید خواند جز مدحش کسی را کش زبان باشد(@)(@@) 28 اگر چه شاعر بسیار دان آسان سخن گوید %~% جز اندر مدحت او آن سخنها ناروان باشد(@)(@@) 29 سخن آن خوبتر باشد که اندر مدح او باشد %~% گل آن بوینده تر باشد که اندر بوستان باشد(@)(@@) 30 مدیحش گوهرست و طبع مداحان مر آنرا کان %~% گرامی گوهر آن باشد که آنرا طبع کان باشد(@)(@@) 31 ندیده ست اندر اخبار ملوک او را قرین هرگز %~% کسی کو را حدیث از خسروان باستان باشد(@)(@@) 32 نه هر کس کو بملک اندر مکین باشد ملک باشد %~% نه نیلوفر بود هر گل که اندر آبدان باشد(@)(@@) 33 ملک باید که اندر رزمگه لشکر شکن باشد %~% ملک باید که اندر بزمگه گوهر فشان باشد(@)(@@) 34 ملک با راستی باید ملک با داد و دین باید %~% ملک باید که اندر هر طریقی نکته دان باشد(@)(@@) 35 ملک دین ورز باید چون نظام الدین که همواره %~% ز بهر دین بجنگ اندر دل هندوستان باشد(@)(@@) 36 ملک باید که چون محمود باشد تا گه دعوی %~% همه کردار او برهان و معنی و بیان باشد(@)(@@) 37 شکار گرگ کس کردست جز 
ms37	 محمود لاوالله %~% جز اورا با چنان کوهی کرا زور و توان باشد(@)(@@) 38 چگونه هول حیوانی چو بالاور ژیان پیلی %~% کجا پیلی ژیان زو تا جهان باشد جهان باشد(@)(@@) 39 نه با دست و برفتن همسر باد سبک باشد %~% نه پیلست و ببالا همبر پیل دمان باشد(@)(@@) 40 بکردار درخت سوخته شاخی به بینی بر %~% سیاه و سخت چونانچون دل نامهربان باشد(@)(@@) 41 به سیلی ماند ار مرسیل را یشک و سرو باشد %~% به کوهی ماند ار مرکوه را جان و روان باشد(@)(@@) 42 ز دشمن کین کشد گر دشمنش چرخ برین باشد %~% بخصم اندر رسد گر خصم او باد وزان باشد(@)(@@) 43 بتن بر پوست چون بینی ورا بر گستوان باشد %~% که دید آن جانور کورا بتن برگستوان باشد(@)(@@) 44 چه دانم گفت آن شه را که اندر صید گه اورا %~% کمینه صید کرگ وحشی و شیر ژیان باشد(@)(@@) 45 بیکروز اندرون سی کرگ بگرفت ویکایک را %~% بزیر زین کشید این در کدامین داستان باشد(@)(@@) 46 غلامانرا به کرگان بر نشاند و کس جز او دارد %~% غلامانی کشان کرگان وحشی زیر ران باشد(@)(@@) 47 شه نندا و رام و رای و گور از بیم شمشیرش %~% بر آن رایند کاندر گورشان خوشتر مکان باشد(@)(@@) 48 شهان هند را از تیغ او آن رستخیز آید %~% که فردا بر خدیو مصر و بر قومش همان باشد(@)(@@) 49 ز جنگ رام و جنگ رای و نندا نام کی جوید %~% کسی کز جنگها او را کمینه جنگ خان باشد(@)(@@) 50 چنانچون میزبان باشد همیشه خلق را جودش %~% همیشه فتح را شمشیر تیزش میزبان باشد(@)(@@) 51 حصاری کاندر آن مر خصم او را مسکنی دیدی %~% بویرانی و پستی چون حصار سیستان باشد(@)(@@) 52 عجب دارم از آنکس کونه محمودی بودزیرا %~% که محمود آن کسی باشد که از محمودیان باشد(@)(@@) 53 هر آنکس کو نه محمودیست مذمومی بود بیشک %~% که باشد آنکه زین جمله تواند بود 
ms38	 آن باشد(@)(@@) 54 همی تا جاودان را نام در تازی ابد باشد %~% ملک محمود را شاهی و شادی جاودان باشد(@)(@@) 55 همی تا خلق را از ملت تازی خبر باشد %~% امین ملت تازی ز هر بد در امان باشد(@)(@@) 56 همی تا در جهان از دولت عالی اثر باشد %~% یمین دولت عالی خداوند جهان باشد PageV1P065(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 یمین دولت شاه زمانه با دل شاد %~% بفال نیک کنون سوی خانه روی نهاد(@)(@@) 2 بتان شکسته و بتخانه ها فکنده ز پای %~% حصارهای قوی بر گشاده لاد از لاد(@)(@@) 3 هزار بتکده کنده قوی تر از هرمان %~% دویست شهر تهی کرده خوشتر از نوشاد(@)(@@) 4 گذارده کرده بیابانهای بی فرجام %~% سپه گذاشته از آبهای بی فرناد(@)(@@) 5 گذشته بابنه ز آنجا که مایه گیرد ابر %~% رسیده با سپه آنجا که ره نیابد باد(@)(@@) 6 ز ملک و ملکت چندین امیر یافته بهر %~% ز گنج بتکده سومنات یافته داد(@)(@@) 7 کنون دو چشم نهاده ست روز وشب گویی %~% به فتح نامه خسرو خلیفه بغداد(@)(@@) 8 خلیفه گوید کامسال همچو هر سالی %~% گشاده باشد چندین حصار و آمده شاد(@)(@@) 9 خبر نداردکامسال شهریار جهان %~% بنای کفر فکنده ست و کنده از بنیاد(@)(@@) 10 بقاش باد که از تیغ او و بازوی اوست %~% بنای کفر خراب و بنای دین آباد(@)(@@) 11 ز بهر قوت دین با ولایت پرویز %~% هزار بار بتن رنجکش تر از فرهاد(@)(@@) 12 ز بسکه رنج سفر بر تن شریف نهاد %~% همی ندانم کان تن تنست یا پولاد(@)(@@) 13 برابر یکی از معجزات موسی بود %~% در آب دریا لشکر کشیدن شه راد(@)(@@) 14 شه عجم را چون معجزه کرامتهاست %~% پدید گشت که آن از چه روی و از چه نهاد(@)(@@) 15 من از کرامت او یک حدیث یاد کنم %~% چنانکه بر دل تو دیرها بماند یاد(@)(@@) 16 به سومنات شد امسال و سومنات بکند %~% در این مراد بپیمود منزلی هشتاد(@)(@@) 17 
ms39	 بره ز دریا بگذشت و آب دریا را %~% چو آب جیحون بیقدر کرد و جسر گشاد(@)(@@) 18 در آن زمان که ز دریای بیکران بگذشت %~% بسی میان بیابان بیکرانه فتاد(@)(@@) 19 نه منزلی بود آنجا بمنزلی معروف %~% نه رهبری بود آنجا برهبری استاد(@)(@@) 20 بماند خیره و اندیشه کرد و با خود گفت %~% کزین ره آید فردا بدین سپه بیداد(@)(@@) 21 چنان نمود ملکرا که ره زدست چپست %~% برفت سوی چپ و گفت هر چه بادا باد(@)(@@) 22 در این تفکر مقدار یک دو میل براند %~% ز رفته باز پشیمان شد و فرو استاد(@)(@@) 23 ز دست راست یکی روشنی پدید آمد %~% چنانکه هر کس از آن روشنی نشانی داد(@)(@@) 24 همه بیابان زان روشنایی آگه شد %~% چو جان آذر خرداد ز آذر خرداد(@)(@@) 25 برفت بردم آن روشنی و از پی آن %~% بجستجوی سواران جلد بفرستاد(@)(@@) 26 بجهد و حیله در آن روشنی همی برسید %~% سوار جلد بر اسب جوان تازی زاد(@)(@@) 27 ملک همی شدو آن روشنائی اندر پیش %~% که روز نو شد و درهای روشنی بگشاد(@)(@@) 28 سرای پرده و جای سپه پدید آمد %~% دل سپاه شد از رنج تشنگی آزاد(@)(@@) 29 کرامتی نبود بیش ازین و سلطان را %~% چنین کرامت باشد نه هفت خود هفتاد(@)(@@) 30 همه کرامت از ایزد همی رسید بوی %~% بدان زمانکه کم از بیست ساله بود بزاد(@)(@@) 31 مگو مگوی که چون کیقباد یا چو جم است %~% حدیث او دگرست از حدیث جم و قباد(@)(@@) 32 چو زو حدیث کنی از شهان حدیث مکن %~% خطا بود که تخلص کنی همای به خاد(@)(@@) 33 همیشه تا نبود نسترن چون سیسنبر %~% چنانکه تا نبود شنبلید چون شمشاد(@)(@@) 34 همیشه تا که گل آبگون ز لاله لعل %~% پدید باشد و خیری ز سوسن آزاد(@)(@@) 35 یمین دولت محمود شهریار جهان %~% بشهر یاری و رادی و خسروی بزیاد(@)(@@) 36 سپهر با او پیوسته تازه روی و 
ms40	 مطیع %~% چنانکه مادر دختر پرست با داماد(@)(@@) 37 بهار تازه برو فر خجسته باد و بی او %~% زمانه را و جهانرا بهار تازه مباد PageV1P066(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چندانکه جهانست ملک شاه جهان باد %~% با دولت پاینده و با بخت جوان باد(@)(@@) 2 تا بود ملک شهر ده و شهرستان بود %~% همواره چنان شهر ده و شهرستان باد(@)(@@) 3 چونانکه ازو عالمی از بد به امانند %~% جان و تن او از همه بدها به امان باد(@)(@@) 4 شاهان جهان را ز نهیبش تن و جان نیست %~% جان و تن شاهانش فدای تن و جان باد(@)(@@) 5 آن کز تن او هرگز کم خواهد مویی %~% در حسرت و اندیشه چنان ایلک و خان باد(@)(@@) 6 تا خواسته با قارون در خاک نهانست %~% بدخواه و بد اندیشش در خاک نهان باد(@)(@@) 7 آنرا که بکین جستن او تیرو کمان خواست %~% بیرون شدش از گیتی با تیرو کمان باد(@)(@@) 8 در کینه او کینه گزاران جهان را %~% آنجا که همه سود بجویند زیان باد(@)(@@) 9 وانکس که نباشد بجهانداری او شاد %~% مقهور و نگونسار و نژند دو جهان باد(@)(@@) 10 دستش برسانیدن ارزاق ضمان شد %~% بختش بهمه خوبی و نیکیش ضمان باد(@)(@@) 11 هر کار که کرده ست ستوده ست چو نامش %~% هر کار کزین پس بکند نیز چنان باد(@)(@@) 12 آنجا که نهد روی به غزوه و بجز از غزو %~% با دولت و با لشکر انبوه و گران باد(@)(@@) 13 از دولت او هر چه گمان بود یقین شد %~% از دولت خصم آنچه یقین بود گمان باد(@)(@@) 14 وانکس که زبان کرد ببدگفتن او تیز %~% در دست اجل خشک لب و خشک زبان باد(@)(@@) 15 اندر سیر شاه چه بد تاند گفتن %~% بدگوی بد اندیش که خاکش بدهان باد(@)(@@) 16 دلشاد مباد آنکه بدو شاد نباشد %~% وانکس که بدو شاد بود شادروان باد(@)(@@) 17 در خانه بدخواه بنفرینش نو نو %~% هر روز دگر 