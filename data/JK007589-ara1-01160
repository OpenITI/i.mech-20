ms1149	 ذاكر خير عصري % ه طويل الحنين والتهيام % % 102(@)(@@) % لهف نفسي على الشباب الذي أض % حى خلفي وذكره قدامي % % 103(@)(@@) % لهف نفسي عليه أن صار حظي % % منه لهفا يعضني إبهامي % % 104(@)(@@) % لهف نفسي على الظباء اللواتي % % عاقني عن قنيصها إحرامي % % 105(@)(@@) % لهف نفسي على احتكامي على البي % % ض وإذعانهن عند احتكامي % % 106(@)(@@) % واقتحامي وللهوى عزمات % يقتحمن العقاب أي اقتحام % % 107(@)(@@) % ودفاعي خلال ذلك نفسي % % عن خلاط الحرام بالإلمام % % 108(@)(@@) % لهف نفسي على الشراب السرامي % ي وإعماله بطاس وجام % % 109(@)(@@) % وعزيف عليه من مسمعات % وحديث عليه من أخلام % % 110(@)(@@) % وفكاهات فتية هم إذا شئ % ت إدام للعيش خير إدام % % PageV01P4366 111(@)(@@) % أخفقت روحتي من الربرب العي % % ن وطاشت من الرمايا سهامي % % 112(@)(@@) % ولعهدي بهن قبل مشيبي % % ينتظمن القلوب أي انتظام % % 113(@)(@@) % وقضيت الرضاع من درة الكر % % م لتجريم أربعين تمام % % 114(@)(@@) % ولتجريم أربعين قديما % يتناهى الرضاع بابن المدام % % 115(@)(@@) % يا زمان الرضاع أرضعك المز % ن وأكدى على زمان الفطام % % 116(@)(@@) % دعوة إن تجب بسقيا وإلا % فسأسقيك بالدموع السجام % % 117(@)(@@) % جارتي إن أكن كبرت وأودى % % بعرامي اتقاء غب الأثام % % 118(@)(@@) % ودعتني النساء عما وقد كن % ت لديهن من بني الأعمام % % 119(@)(@@) % فلقد أغتدى يفيىء غصني % % خيلاء الشباب حي العرام % % 120(@)(@@) % تتراءاني الحسان العطابي % % ل جلاء القذى شفاء السقام % PageV01P4367 121(@)(@@) % ناظرات بأعين العين نحوي % % عاطفات سوالف الآرام % % 122(@)(@@) % ولقد أهبط الرياض بصحبي % % تتراءى عيونها بابتسام % % 123(@)(@@) % بكرة أو عشية يضحك الرو % ض ويبكي الحمام شجو الحمام % % 124(@)(@@) % تتعاطى بها الكؤوس رواء % واصلي طيبها بطيب ندام % % 125(@)(@@) % در در الصبا ودر مغاني ال % لهو لو أنها ديار مقام % % 126(@)(@@) % عدى عن ذكر ما مضى واستمرت % دون مأتاه مرة الأوذام % % 127(@)(@@) % وفلاة قطعتها بفلاة % كاللياح الملمع الأعلام % % 128(@)(@@) % بات في لجة الظلام فريدا % تحت أهوال رائح مرزام % 129(@)(@@) % مطرقا يبحث الروي عن الظم % آن عن عانك ركام هياه % % 130(@)(@@) % عطف الليل هيدبيه عليه % % وتداعت سماؤه بانهدام % % PageV01P4368 131(@)(@@) % يقق اللون كالملاءة إلا % لمعا فيشواه مثل الوشام % % 132(@)(@@) % ينتمي 
ms1150	 كله إلى آل سام % غير هاتيك فهي من آل حام % % 133(@)(@@) % تلك أو سفعة بخديه تهدي % % جدة في سراته كالعصام % % 134(@)(@@) % هنة قومت وعوج منها % % فتراها كأنها خط لام % % 135(@)(@@) % حطها في القرا وفي الذنب الزا % % ئل قسمين أعدل القسام % % 136(@)(@@) % ذو إهاب يضاحك البرق مالاراح شيبي علي مثل الثغام % وغدا عاذلي ألد الخصام % 137(@)(@@) % عزني في خطابه أن رآني % % صار بعضي ظهيره في ملامي % % 138(@)(@@) % ويحسب المفندي بمشيب % رد غرب الجماح رد اللجام % % 139(@)(@@) % قنع الرأس ثم لثم وجهي % % وكفى بالقناع دون اللثام % % 140(@)(@@) % حل رأسي فراعني أن في الشي % % ب نعي الصبا نذير الحمام % % PageV01P4369 141(@)(@@) % راعني شخصه وراع بشخصي % % مقر الإنس ساكنات الخيام % % 142(@)(@@) % فتناهين قاليات وصالي % % وتناهيت خائفا ما أمامي % % 143(@)(@@) % بل تناهيت مكرها بتناهي ال % % بيض عني وما انتهت أعرامي % % 144(@)(@@) % كالذي ذاده السقاة عن الماء % % ء ولم يشف ما به من أوام % 145(@)(@@) % حسرتي للشباب لابل من الشي % ب لقد طال مذ بدا تحوامي % % 146(@)(@@) % ذادني عن موارد لي كانت % شافيات من الغليل الهيام % % 147(@)(@@) % حرمت بالمشيب أشياء حلت % لي زمانا بإذن جعد سخام % % 148(@)(@@) % لم تحلل لمن أتاها ولكن % لم يكن دونها من الشيب حامي % % 149(@)(@@) % فأتى الآن دونها فهي اليو % م حرام علي كل الحرام % % 150(@)(@@) % سوأتي أن أطعت شيبي فيما % % لم أطع فيه حاكم الحكام % PageV01P4370 151(@)(@@) % وعظ الله والكتاب فصم % ممت وأقدمت أيما إقدام % % 152(@)(@@) % ونهى الشيب بعد ذاك فسلم % ت وأحجمت أيما إحجام % % 153(@)(@@) % صمت عن كل لذة لمشيبي % % أفلا كان للإله صيامي % % 154(@)(@@) % وإحيائي أن لا يكون من ال % % له حيائي من غيره واحتشامي % % 155(@)(@@) % إذ تعديت لا حياء من الل % له نهاني ولا اتقاء انتقام % % 156(@)(@@) % وتناهيت معظما لمشيبي % % ومشيبي أحق بالإعظام % % 157(@)(@@) % أفلا هبت ذا المهابة من قب % % ل وأكرمت وجه ذي الإكرام % % 158(@)(@@) % كاد هذا المتاب يعتد إجرا % % ما وبعض المتاب كالإجرام % % 159(@)(@@) % توبة مثل حوبة وقديما % أتبع الجهل زلة بارتطام % % 160(@)(@@) % دحضت حجة المنيب إلى الشي 
ms1151	 % ب وأنى لطالب بقوام % % PageV01P4371 161(@)(@@) % أي عذر لتائب لا إلى الل % % ه ولكن إلى شبيه الثغام % % 162(@)(@@) % إن عذرا من الذهاب إلى الل % % ه لعذر يغلو على المستام % % 163(@)(@@) % أإلى أرذلي جعلت متابي % % ضلة مثل ضلة الأنعام % 164(@)(@@) % بل إلى الله تبت لما ثناني % % بعناني وزاعني بزمامي % % 165(@)(@@) % راعني بالمشيب عما نهى عن % % ه بآي الكتاب ذي الإحكام % % 166(@)(@@) % كم بدا في الكتاب لي من ضياء % كان من قبل دونه كالقتام % % 167(@)(@@) % هتك الشيب ذلك الستر لي عن % % ه فزال العمى وراح التعامي % % 168(@)(@@) % وكلا الشيب والكتاب جميعا % واعظ زاجر عن الآثام % % 169(@)(@@) % غير أن الكتاب يكتب بالأق % لام والشيب ليس بالأقلام % 170(@)(@@) % بل بردع الحوادث المصمئلا % ت ومر الشهور والأعوام % % PageV01P4372 171(@)(@@) % لن ترى مثله كتابا مبينا % % لا بشكل له ولا إعجام % % 172(@)(@@) % خط غفل الحروف يقرؤه الأم % مي كالصبح غير ذي استعجام % % 173(@)(@@) % فيه للقارئين أي نذير % ببلى جدة ووشك اخترام % % 174(@)(@@) % عاذلي قد نزعت فانزع عن العذ % ل وإن كنت في صواب حذام % % 175(@)(@@) % قد رأيت الذي هويت فأرضي % ت وأرغمت فارض لي إرغامي % % 176(@)(@@) % حلأتني الخطوب عن شرع الله % % و فأصبحت حائما في الحيام % % 177(@)(@@) % وأبيها لقد حمت سائغات % باردات النطاف زرق الجمام % % 178(@)(@@) % لن تراني العيون أشرع فيها % % فدع اللوم وليدع اتهامي % % 179(@)(@@) % مت إلا حشاشة وادكارا % % مثل أحلام حالم النوام % % 180(@)(@@) % ومتى ما انقضت أجاري طرف % مات إلا صيامه في المصام % % PageV01P4373 181(@)(@@) % غير أني مع انتزاعي وإفلا % % عي ودفعي إلى نصيحي خطامي % % 182(@)(@@) % قائل قول ذاكر خير عصري % ه طويل الحنين والتهيام % % 183(@)(@@) % لهف نفسي على الشباب الذي أض % حى خلفي وذكره قدامي % % 184(@)(@@) % لهف نفسي عليه أن صار حظي % % منه لهفا يعضني إبهامي % % 185(@)(@@) % لهف نفسي على الظباء اللواتي % % عاقني عن قنيصها إحرامي % % 186(@)(@@) % لهف نفسي على احتكامي على البي % % ض وإذعانهن عند احتكامي % % 187(@)(@@) % واقتحامي وللهوى عزمات % يقتحمن العقاب أي اقتحام % % 188(@)(@@) % ودفاعي خلال ذلك نفسي % % عن خلاط الحرام بالإلمام % % 189(@)(@@) % لهف نفسي 
ms1152	 على الشراب السرامي % ي وإعماله بطاس وجام % % 190(@)(@@) % وعزيف عليه من مسمعات % وحديث عليه من أخلام % % PageV01P4374 191(@)(@@) % وفكاهات فتية هم إذا شئ % ت إدام للعيش خير إدام % % 192(@)(@@) % أخفقت روحتي من الربرب العي % % ن وطاشت من الرمايا سهامي % % 193(@)(@@) % ولعهدي بهن قبل مشيبي % % ينتظمن القلوب أي انتظام % % 194(@)(@@) % وقضيت الرضاع من درة الكر % % م لتجريم أربعين تمام % % 195(@)(@@) % ولتجريم أربعين قديما % يتناهى الرضاع بابن المدام % % 196(@)(@@) % يا زمان الرضاع أرضعك المز % ن وأكدى على زمان الفطام % % 197(@)(@@) % دعوة إن تجب بسقيا وإلا % فسأسقيك بالدموع السجام % % 198(@)(@@) % جارتي إن أكن كبرت وأودى % % بعرامي اتقاء غب الأثام % % 199(@)(@@) % ودعتني النساء عما وقد كن % ت لديهن من بني الأعمام % % 200(@)(@@) % فلقد أغتدى يفيىء غصني % % خيلاء الشباب حي العرام % % PageV01P4375 201(@)(@@) % تتراءاني الحسان العطابي % % ل جلاء القذى شفاء السقام % 202(@)(@@) % ناظرات بأعين العين نحوي % % عاطفات سوالف الآرام % % 203(@)(@@) % ولقد أهبط الرياض بصحبي % % تتراءى عيونها بابتسام % % 204(@)(@@) % بكرة أو عشية يضحك الرو % ض ويبكي الحمام شجو الحمام % % 205(@)(@@) % تتعاطى بها الكؤوس رواء % واصلي طيبها بطيب ندام % % 206(@)(@@) % در در الصبا ودر مغاني ال % لهو لو أنها ديار مقام % % 207(@)(@@) % عدى عن ذكر ما مضى واستمرت % دون مأتاه مرة الأوذام % % 208(@)(@@) % وفلاة قطعتها بفلاة % كاللياح الملمع الأعلام % % 209(@)(@@) % بات في لجة الظلام فريدا % تحت أهوال رائح مرزام % 210(@)(@@) % مطرقا يبحث الروي عن الظم % آن عن عانك ركام هيام % % PageV01P4376 211(@)(@@) % عطف الليل هيدبيه عليه % % وتداعت سماؤه بانهدام % % 212(@)(@@) % يقق اللون كالملاءة إلا % لمعا فيشواه مثل الوشام % % 213(@)(@@) % ينتمي كله إلى آل سام % غير هاتيك فهي من آل حام % % 214(@)(@@) % تلك أو سفعة بخديه تهدي % % جدة في سراته كالعصام % % 215(@)(@@) % هنة قومت وعوج منها % % فتراها كأنها خط لام % % 216(@)(@@) % حطها في القرا وفي الذنب الزا % % ئل قسمين أعدل القسام % % 217(@)(@@) % ذو إهاب يضاحك البرق مالا % % ح وطورا يضيء في الإظلام % % 218(@)(@@) % ضوعف الليل في الكثافة والطو % % ل عليه بمرحجن ركام % % 219(@)(@@) % وخريق تلفه في كناس % % عدملي بجانبيه حوامي % % 220 
