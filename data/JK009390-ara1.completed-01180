ms1166	 بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10239 ) قال النبي :(@)(@@) | 30 ( تحشرون يوم القيامة حفاة عراة غرلا ، وأول من يكسى إبراهيم الخليل ، يقول الله تعالى : اكسوا إبراهيم ليعلم الناس فضله ، ثم يكسى الناس على قدر الأعمال ) )(@)(@@) ابن السكن والاسماعيلي وابن منده وأبو نعيم عن طلق بن حبيب عن جده قال السكن ولعله والد معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10240 ) قال النبي :(@)(@@) | 30 ( تحشرون حفاة عراة غرلا ، قالت امرأة : أيبصر PageV04P070 بعضنا عورة بعض ؟ قال : يا فلانة لكل امرىء منهم يومئذ شأن يغنيه ) )(@)(@@) ( ت ) حسن صحيح ( ك ) عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10241 ) قال النبي : $ 30 ( تحشرون هاهنا حفاة مشاة وركبانا وعلى وجوهكم وتعرضون على الله ، وعلى أفواهكم الفدام وإن أول ما يعرب عن أحددكم فخذه ) ( ش طب ك ) عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الخاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10242 ) قال النبي :(@)(@@) | 30 ( تختموا بالعقيق فإنه مبارك ) )(@)(@@) ( عق ) و ابن لال في مكارم الأخلاق ( ك ) في تاريخه ( هب خط ) وابن عساكر ( فر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10243 ) قال النبي :(@)(@@) | 30 ( تختموا بالعقيق فإنه ينفي الفقر ( عد ) عن أ$ نس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10244 ) قال النبي :(@)(@@) | 30 ( تخرب المدينة قبل يوم القيامة بأربعين سنة ( فر ) عن ع$ وف بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10245 ) قال النبي :(@)(@@) | 30 ( تخرج الدابة فتسم الناس على خراطيمهم ثم يعمرون فيكم حتى يشتري الرجل الدابة فيقال ممن اشتريت ؟ فيقول : من الرجل المخطم ) )(@)(@@) ( حم ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10246 ) قال النبي :(@)(@@) | 30 ( تخرج الدابة ومعها خاتم سليمان وعصا موسى ، PageV04P071 فتجلوا وجه المؤمن بالعصا ، وتختم أنف الكافر بالخاتم ، حتى أن أهل الخوان ليجتمعون فيقول هاذا يا مؤمن ، ويقول هاذا يا كافر ) )(@)(@@) ( حم ت ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10247 ) قال النبي :(@)(@@) | 30 ( تخللوا فإنه نظافة ، والنظافة تدعو إلاى الإيمان ، والإيمان مع صاحبه في الجنة ) )(@)(@@) ( طس ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10248 ) قال النبي :(@)(@@) | 30 ( تخيروا لنطفكم فإن النساء 
ms1167	 يلدن أشباه إخوانهن وأخواتهن ) )(@)(@@) ( عد ) و ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10249 ) قال النبي :(@)(@@) | 30 ( تخيروا لنطفكم فأنكحوا الأكفاء وأنكحوا إليهم ) )(@)(@@) ( ه ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10250 ) قال النبي :(@)(@@) | 30 ( تخيروا لنطفكم واجتنبوا هاذا السواد فإنه لون مشوه ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10251 ) قال النبي :(@)(@@) | 30 ( تخرب الأرض قبل الشام ، بأربعين سنة ) )(@)(@@) ( كر ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10252 ) قال النبي :(@)(@@) | 30 ( تخرج يوم القيامة ثلة عر محجلون فيسدون الأفق ، نورهم مثل نور الشمس ، فينادي مناد النبي الأمي ، فيتحشحش لها كل نبي أمي ، فيقال : محمد وأمته فيدخلون الجنة ليس عليهم حساب ولا عذاب ، ثم تخرج ثلة أخرى غر محجلون نورهم مثل نور القمر ليلة البدر فيسدون الأفق ، فينادي مناد النبي الأمي ، فيتحشحش لها كل نبي أمي ، فيقال : محمد وأمته ، فيدخلون الجنة بغير حساب ولا عذاب ، ثم تخرج ثلة أخرى غر محجلون نورهم مثل أعظم كوكب PageV04P072 في السماء فيسد الأفق ، فينادي مناد النبي الأمي ، فيتحشحش لها كل نبي أمي ، فيقال : محمد وأمته ، فيدخلون الجنة بغير حساب ولا عذاب ، ثم يجيء ربك عز وجل ثم يوضع الميزان ويؤخذ في الحساب ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه وسنده جيد .(@)(@@)(@@)(@@) $ ( 10253 ) قال النبي :(@)(@@) | 30 ( تخرج النائحة يوم القيامة من قبرها شعثاء غبراء عليها درع من جرب ، وجلباب من لعنة ، واضعة يديها علاى رأسها تقول يا ويلتاه ، ومالك يقول : آمين ، ثم يكون من ذالك حظها النار ) )(@)(@@) ابن النجار عن مسلمة بن جعفر عن حسان بن حميد عن أنس رضي الله عنه قال في الميزان : مسلمة يجبل هو وشيخه ، وقال الأزدى ضعيف(@)(@@)(@@)(@@) $ ( 10254 ) قال النبي :(@)(@@) | 30 ( تخرج الرايات السود من من المشرق ؟ ) )(@)(@@) نعيم بن حماد في الفتن عن سعيد بن المسيب مرسلا(@)(@@)(@@)(@@) $ ( 10255 ) قال النبي :(@)(@@) | 30 ( تخصر بهذه حتى تلقاني بها يوم القيامة ، وأقل الناس المتخصرون ) )(@)(@@) ( حل ) عن عبد الله ابن أنيس أن رسول الله أعطاه مخصرة وقال : فذكره .(@)(@@)(@@)(@@) $ ( 10256 ) قال النبي 
ms1168	 :(@)(@@) | 30 ( تخرقوا حلوق أولادكم خذي قسطا هنديا وورسا فاسعطيه إياه ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10257 ) قال النبي :(@)(@@) | 30 ( تخرص كما تخرص النخل ثم تءودي زكاته زبيبا كما تءودي زكاة النخل تمرات ) )(@)(@@) حسن غريب عن عتاب بن أسيد أن النبى قال في زكاة الكروم فذكره .(@)(@@)(@@)(@@) $ ( 10258 ) قال النبي :(@)(@@) | 30 ( تخلل إنك أكلت لحم أخيك ) )(@)(@@) ( طب ) عن ابن مسعود PageV04P073 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10259 ) قال النبي :(@)(@@) | 30 ( تخللوا علاى إثر الطعام وتمضمضوا فإنه مصحة للناب والنواجذ ) )(@)(@@) الديلمي عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10260 ) قال النبي :(@)(@@) | 30 ( تخير فتختار أحسنهما خلقا كان معها في الدنيا فيكون زوجها في الجنة ، يا أم حبيبة ذهب حسن الخلق بخير الدنيا والآخرة ) )(@)(@@) عبد بن حميد وسموية ( طب ) والخرائطي في مكارم الأخلاق وابن لال عن أنس أن أم حبيبة قالت يا رسول الله المرأة يكون لها في الدنيا زوجان لأيهما تكون هفي الجنة ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 10261 ) قال النبي :(@)(@@) | 30 ( تخيروا لنطفكم ولا تضعوها إلا في الأكفاء ) )(@)(@@) الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10262 ) قال النبي :(@)(@@) | 30 ( تخيروا لنطفكم وانتخبوا المناكح ، وعليكم بذوات الأوراك فإنهن أنجب ) )(@)(@@) ( عد ) و الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10263 ) قال النبي :(@)(@@) | 30 ( تداركوا الغموم والهموم بالصدقات يكشف الله تعالى ضركم وينصركم على عدوكم ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10264 ) قال النبي :(@)(@@) | 30 ( تداووا بألبان البقر فإني أرجو أن يجعل الله فيها شفاء تأكل من كل الشجر ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10265 ) قال النبي :(@)(@@) | 30 ( تداووا عباد الله ، فإن الله تعالى لم يضع داء إلا PageV04P074 وضع له دواء غير داء واحد : الهرم ) )(@)(@@) ( حم 4 حب ك ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10266 ) قال النبي :(@)(@@) | 30 ( تداووا من ذات الجنب بالقسط البحري والزيت ) )(@)(@@) ( حم ك ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10267 ) قال النبي :(@)(@@) | 30 ( تدرون ما يقول الأسد في زئيره ؟ يقول : اللهم لا تسلطني على أحد 
ms1169	 من أهل المعروف ) )(@)(@@) ( طب ) في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10268 ) قال النبي :(@)(@@) | 30 ( تدمع العين ويحزن القلب ولا نقول إلا ما يرضي الرب والله إنا بفراقك يا إبراهيم لمحزونون ) )(@)(@@) ( حم م د ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10269 ) قال النبي :(@)(@@) | 30 ( تدمع العين ، ويحزن القلب ولا نقول ما يسخط الرب ، ولولا أنه وعد صادق ، وموعود جامع وأن الآخر منا يتبع الأول لوجدنا عليك يا إبراهيم وجدا أشد ما وجدنا ، وإنا بك يا إبراهيم لمحزونون ) )(@)(@@) ( ه ) عن أسماء بنت يزيد رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 10270 ) قال النبي :(@)(@@) | 30 ( تدنو الشمس يوم القيامة من الخلق حتى تكون منهم كمقدار ميل فيكون الناس على قدر أعمالهم في العرق ، فمنهم من يكون إلى كعبيه ، ومنهم من يلجمه إلى ركبتيه ، ومنهم من يكون إلى حقويه ، ومنهم من يلجمخه العرق إلجاما ) )(@)(@@) ( م ) عن المقداد بن الأسود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 10271 قال النبي :(@)(@@) | 30 ( تدور رحى الإسلام لخمس وثلاثين أو سبع وثلاثين ، فإن يهلكوا فسبيل من هلك ، وإن يقم لهم دينهم يقم لهم سبعين عاما بما مضى ) )(@)(@@) ( حم د ك ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV04P075(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10272 ) قال النبي :(@)(@@) | 30 ( تداووا فإن اللل لم ينزل داء إلا وقد أنزل له شفاء إلا السام والهرم ) )(@)(@@) ( حب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10273 ) قال النبي :(@)(@@) | 30 ( تداووا فإن الله عز وجل لم ينزل في الأرض داء إلا أنزل له شفاء ) )(@)(@@) أبو نعيم في الطب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10274 ) قال النبي :(@)(@@) | 30 ( تدخلونت الجنة مردا مكحلين دوفانين يعني الحمام أبناء ثلاثين على صورة يوسف وقلب أيوب ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10275 ) قال النبي :(@)(@@) | 30 ( تدرون ما بعد ما بين السماء والأرض ؟ إن بعد ما بينهما إما واحدة أو اثنين أو ثلاثة وسبعين سنة ، ثم السماء فوقها كذالك حتى عد سبع سماوات ثم فوق السابعة بحر بين أسفله وأعلاه مثل ما بين سماء 
ms1170	 إلى سماء ، ثم على ظهورهم العرش من أسفله وأعلاه مثل ما بين سماء إلى سماء ، ثم الله فوق ذالك ) )(@)(@@) ( د ه ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10276 ) قال النبي :(@)(@@) | 30 ( تدرون أي الصدقة خير ؟ فإن خير الصدقة أن تمنح أخاك الدرهم أو لبن الشاة ) )(@)(@@) ( حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10277 ) قال النبي :(@)(@@) | 30 ( تدرون ما يقول ربكم ؟ يقول : من صلى الصلاة لوقتها ، وحافظ عليها ولم يضعها استخفافا بحقها فله علي عهد أن أدخله الجنة ، ومن لم يصلها لوقتها ولم يحافظ عليها استخفافا بحقها فلا عهد له علي إن شئت PageV04P076 غفرت له وإن شئت عذبته ) )(@)(@@) ( طب حل ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10278 ) قال النبي :(@)(@@) | 30 ( تدرون من المؤمن ؟ المؤمن لا يموت حتى يملأ الله مسامه مما يحب ، هل تدرون من الفاجر ؟ الفاجر الذي لا يموت حتى يملأ الله مسامعه مما يكره ، ولو أن عبدا اتقى الله جوف بيت إلى سبعين على كل بيت باب من حديد ألبسه الله رداء عمله حتى يتحدث بها الناس ويزيدون ) )(@)(@@) ( ك ) في تاريخه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10279 ) قال النبي :(@)(@@) | 30 ( تدرون ما الباقيات الصالحات ؟ سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا حول ولا قوة إلا بالله ) )(@)(@@) أبو الشيخ في الثواب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10280 ) قال النبي :(@)(@@) | 30 ( تدري أين تذهب ؟ فإنها تذهب حتى تسجد تحت العرش فتستأذن فيؤذن لها ويوشك أن تسجد فلا يقبل منها ، وتستأذن فلا يؤذن لها ، يقال لها : ارجعي من حيث جئت فتطلع من مغربها ، فذالك قوله تعالى : والشمس تجري لمستقر لها ) )(@)(@@) ( خ ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10281 ) قال النبي :(@)(@@) | 30 ( تدرين ما ذالك الحساب ؟ إنه من نوقق الحساب خصم ، ذالك الممر بين يدي الله ) )(@)(@@) ( ك ) عن عائشة قالت : مر بي النبي وأنا أقول : اللهم حاسبني حسابا يسيرا قال : فذكره .(@)(@@)(@@)(@@) $ ( 10282 ) قال النبي :(@)(@@) | 30 ( تدرين على ما حسدونا ؟ يعني اليهود فإنهم حسدونا على القبلة 
ms1171	 التي هدينا لها وضلوا عنها ، وعلى الجمعة التي هدينا لها وضلوا عنها ، وعلى قولنا خلف الإمام آمين ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10283 ) قال النبي :(@)(@@) | 30 ( تدمع العين ويحزن القلب ولا يكون على المؤمن في ذالك شيء ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV04P077(@)(@@)(@@)(@@) $ ( 10284 ) قال النبي :(@)(@@) | 30 ( تدع الصلاة أيامها ثم تغتسل غسلا واحدا ثم تتوضا عند كل صلاة ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها قالت : سئل رسول الله عن المستحاضة قال : فذكره .(@)(@@)(@@)(@@) $ ( 10285 ) قال النبي :(@)(@@) | 30 ( تدنو الشمس يوم القيامة على قدر ميل ، ويزاد في حرها كذا وكذا تغلي منه الهوام كما تغلي القدور على الأثافي يعرفون منها على قدر خطاياهم ، منهم من يبلغ إلى كعبيه ، ومنهم من يبلغ إلى ساقيه ، ومنهم من يبلغ إلى وسطه ، ومنهم من يلجمه العرق ) )(@)(@@) ( حم طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10286 ) قال النبي :(@)(@@) | 30 ( تدنو الشمس من الأرض يوم القيامة فيعرق الناس ، فمن الناس من يبلغ عرقه كعبيه ، ومنهم من يبلغ إلى نصف الساق ، ومنهم من يبلغ إلى ركبتيه ، ومنهم من يبلغ العجز ، ومنهم من يبلغ الخاصرة ، ومنهم من يبلغ منكبيه ، ومنهم من يبلغ حقويه ، ومنهم من يلجمه ، ومنهم من يغمره ) )(@)(@@) ( حم طب ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10287 ) قال النبي :(@)(@@) | 30 ( تدنوا الشمس من الناس يوم القيامة حتى تكون من الناس على قدر ميلين ويزاد في حرها فيضجرهم فيكونون في العرق بقدر أعمالهم ، فمنهم من يأخذه العرق إلى كعبيه ، ومنهم من يأخذه إلى ركبتيه ، ومنهم من يأخذه إلى حقويه ، ومنهم من يلجمه إلجاما ) )(@)(@@) ( طب ) عن المقدام بن معدي كرب رضي الله عنه .(@)(@@) PageV04P078(@)(@@)(@@)(@@) ||| ( التاء مع الذال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10288 ) قال النبي :(@)(@@) | 30 ( تذهب الأرضون كلها يوم القيامة إلا المساجد فإنها ينضم بعضها إلى بعض ) )(@)(@@) ( طس عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10289 ) قال النبي :(@)(@@) | 30 ( تذهبون الخير فالخير حتى لا يبقى منكم إلا مثل هاذه ) )(@)(@@) ( تخ طب ك ) عن رويفع بن ثابت 
ms1172	 رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10290 ) قال النبي :(@)(@@) | 30 ( تربوا صحفكم أنجح لها إن التراب مبارك ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10291 ) قال النبي :(@)(@@) | 30 ( ترد علي أمتي الحوض وأنا أذود الناس عنه كما يذود الرجل إبل الرجل عن إبله ، قالوا : يا نبي الله تعرفنا ، قال : نعم ، لكم سيما ليست لأحد غيركم ، تردون علي غرا محجلين من آثار الوضوء ، وليصدن عني طائفة منكم فلا يصلون فأقول : يا رب هاؤلاء من أصحابي ، فيجيبني ملك فيقول : وهل تدري ما أحدثوا بعدك ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10292 ) قال النبي :(@)(@@) | 30 ( ترفع الأيدي : في الصلاة ، وإذا رؤي البيت ، وعلى الصفا والمروة ، وعشية عرفة ، وبجمع وعند الجمرتين ، وعلى الميت ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 10293 ) قال النبي :(@)(@@) | 30 ( ترفع البركة من البيت إذا كان فيه الكناسة ) )(@)(@@) ( فر ) PageV04P079 عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10294 ) قال النبي :(@)(@@) | 30 ( ترك الدنيا أمر من الصبر وأشد من حطم السيوف في سبيل الله عز وجل ) )(@)(@@) ( فر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10295 ) قال النبي :(@)(@@) | 30 ( ترك السلام على الضرير خيانة ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10296 ) قال النبي :(@)(@@) | 30 ( ترك الوصية عار في الدنيا ونار وشنار في الآخرة ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10297 ) قال النبي :(@)(@@) | 30 ( تركت فيكم شيئين لن تضلوا بعدهما : كتاب الله وسنتي ، ولن يتفرقا حتى يردا علي الحوض ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10298 ) قال النبي :(@)(@@) | 30 ( تراح رائحة الجنة من مسيرة خمسمائة سنة ، ولا يجد ريحها منان بعمله ، ولا عاق ، ولا مدمن خمر ) )(@)(@@) ( طس ) و الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10299 ) قال النبي :(@)(@@) | 30 ( ترب وجهك لله تعالى ) )(@)(@@) ( حم ) عن أم سلمة رضي الله عنها .(@)(@