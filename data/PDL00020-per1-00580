ms573	 دهن مصری %~% بجز سیر یا گندنائی نیابی(@)(@@) 81 گر این فصل بر کوه خوانی همانا %~% که جز بارک الله صدائی نیابی(@)(@@) 82 بهاری است خوش چون گل نخل بندان %~% که از زخم خارش عنائی نیابی PageV1P0620(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر به قدر سوزش دل چشم من بگریستی %~% بر دل من مرغ و ماهی تن به تن بگریستی(@)(@@) 2 صد هزاران دیده بایستی دل ریش مرا %~% تا به هر یک خویشتن بر خویشتن بگریستی(@)(@@) 3 دیده‌های بخت من بیدار بایستی کنون %~% تا بدیدی حال من بر حال من بگریستی(@)(@@) 4 آنچه از من شد گر از دست سلیمان گم شدی %~% بر سلیمان هم پری هم اهرمن بگریستی(@)(@@) 5 یاسمن خندان و خوش زان است کز من غافل است %~% یاس من گردیده بودی یاسمن بگریستی(@)(@@) 6 تنگدل مرغم گرم بر باب‌زن کردی فلک %~% بر من آتش رحم کردی باب زن بگریستی(@)(@@) 7 ای دریغا طبع خاقانی که وا ماند از سخن %~% کو سخن‌دان مهین تا بر سخن بگریستی(@)(@@) 8 مقتدای حکمت و صدر ز من کز بعد او %~% گر زمین را چشم بودی بر زمن بگریستی(@)(@@) 9 گوهری بود او که گردونش به نادانی شکست %~% جوهری کو تا بر این گوهر شکن بگریستی(@)(@@) 10 زاد سروی راد مردی بر چمن پژمرده شد %~% ابر طوفان بار کو تا بر چمن بگریستی(@)(@@) 11 شعریان از اوج رفعت در حضیض خاک شد %~% چرخ بایستی که بر شام و یمن بگریستی(@)(@@) 12 کو پیمبر تا همی سوک بحیرا داشتی %~% کو سکندر تا به مرگ برهمن بگریستی(@)(@@) 13 کو شکر نطقی که از رشک زبانش هر زمان %~% نحل از آب چشم بر آب دهن بگریستی(@)(@@) 14 کو صبا خلقی که از تشویر جاه و جود او %~% هم بهشت عدن و هم بحر عدن بگریستی(@)(@@) 15 کو فلک دستی که چون کلکش بهم کردی سخن %~% دختران نعش یک یک بر پرن بگریستی(@)(@@) 16 هر زمان از بیم نار الله 
ms574	 ز نرگس دان چشم %~% کوثری بر روی و موی چون سمن بگریستی(@)(@@) 17 پیش چشمش مرغ را کشتن که یارستی که او %~% گر بدیدی شمع در گردن زدن بگریستی(@)(@@) 18 آنت مومین دل که گر پیشش بکشتندی چراغ %~% طبع مومینش چو موم اندر لکن بگریستی(@)(@@) 19 کاشکی گردون طریق نوحه کردن داندی %~% تا بر اهل حکمت و ارباب فن بگریستی(@)(@@) 20 کاشکی خورشید را زین غم نبودی چشم درد %~% تا بر این چشم و چراغ انجمن بگریستی(@)(@@) 21 کاشکی خضر از سر خاکش دمی برخاستی %~% تا به خون دیده بر فضل و فطن بگریستی(@)(@@) 22 کاشکی آدم به رجعت در جهان باز آمدی %~% تا به مرگ این خلف بر مرد و زن بگریستی(@)(@@) 23 آتش و آب ار بدانندی که از گیتی که رفت %~% آتش از غم خون شدی آب از حزن بگریستی(@)(@@) 24 او همائی بود بی‌او قصر حکمت شد دمن %~% کو غراب البین کو تا بر دمن بگریستی(@)(@@) 25 اهل شروان چون نگریند از دریغ او که مرغ %~% گر شنیدی بر فراز نارون بگریستی PageV1P0621(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 صبح‌دم آب خضر نوش از لب جام گوهری %~% کز ظلمات بحر جست آینه سکندری(@)(@@) 2 شاهد طارم فلک رست ز دیو هفت سر %~% ریخت به هر دریچه‌ای آقچه زر شش سری(@)(@@) 3 غالیه‌سای آسمان سود بر آتشین صدف %~% از پی مغز خاکیان لخلخه‌های عنبری(@)(@@) 4 یوسف روز جلوه کرد از دم گرگ و می‌کند %~% یوسف گرگ مست ما دعوی روز پیکری(@)(@@) 5 گرچه صبوح فوت شد کوش که پیش از آفتاب %~% زان می آفتاب‌وش یاد صبوحیان خوری(@)(@@) 6 درده کیمیای جان ز آتش جام زیبقی %~% طلق حلال پروران طلق روان گوهری(@)(@@) 7 طفل مشیمه رزان بکر مشاطه خزان %~% حامله بهار از آن باد عقیم آذری(@)(@@) 8 چون ز دهان بلبله در گلوی قدح چکد %~% عطسه عنبرین دهد مغز چمانه از تری(@)(@@) 9 رفت قنینه در فواق از چه ز امتلای خون 
ms575	 %~% راست چو پشت نیشتر خون چکدش معصفری(@)(@@) 10 چنگی آفتاب روی از پی ارتفاع می %~% چنگ نهاده ربع‌وش بر بر و چهره برتری(@)(@@) 11 چون نگهش کنی کند در پس چنگ رخ نهان %~% تا شوی از بلای او شیفته بلا دری(@)(@@) 12 کرته فستقی فلک چاک زند چو فندقش %~% هر سر ده قواره را زهره کند به ساحری(@)(@@) 13 زهره ز رشک خون دل در بن ناخن آورد %~% چون سر ناخنش کند با رگ چنگ نشتری(@)(@@) 14 چشم سهیل و ناخنه ناخن آفتاب و نی %~% کاتش و قند او دهد با نی و باد یاوری(@)(@@) 15 چرخ سدابی از لبش دوش فقع گشاد و گفت %~% اینت نسیم مشک پاش اینت فقاع شکری(@)(@@) 16 سال نوست ساقیا نوبر سال ماتوئی %~% می که دهی سه ساله ده کو کهن و تو نوبری(@)(@@) 17 گاو سفالی اندر آر آتش موسی اندر او %~% تا چه کنند خاکیان گاو زرین سامری(@)(@@) 18 می به سفال خام نوش اینت چمانه طرب %~% لب به کلوخ خشک مال اینت شمامه طری(@)(@@) 19 تیغ فراسیاب چه خون سیاوشان کدام %~% در قدح گلین نگر عکس گلاب عبهری(@)(@@) 20 گنبد آبگینه‌گون نیست فرشته خوی و رو %~% سنگ بر آبگینه زن دیو دلی کن ای پری(@)(@@) 21 در قصب سه دامنی آستئی دو برفشان %~% پای طرب سبک بر آر ارچه ز می گران سری(@)(@@) 22 هفت طواف کعبه را هفت تنان بسنده‌اند %~% ما و سه پنج کعبتین داو به هفده آوری(@)(@@) 23 ما که و اختیار چه کاین شجره است آن ما %~% بد پسران خانه کن باد سران سرسری(@)(@@) 24 از پس کنیت سگی چیست به شهر نام ما %~% درد کش ملامتی سیم کش قلندری(@)(@@) 25 لیک به دولت ملک بر ملکوت می‌رود %~% بهر عروس طبع ما نامزد سخنوری(@)(@@) 26 خسرو کعبه آستان ملک طراز راستین %~% کرده طراز آستین از ردی پیمبری(@)(@@) 27 حیدر آسمان حسام احمد مشتری نگین %~% رایض رای اسمان 
ms576	 صیقل جاه مشتری(@)(@@) 28 در نفس مبارکش سفته راز احمدی %~% در سفن بلارکش معجز تیغ حیدری PageV1P0622(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ناگذران دل توئی کز طرب آشناتری %~% خاک توام به خشک جان تا به لب آتش تری(@)(@@) 2 خانه دل به چار حد وقف غم تو کرده‌ام %~% حد وفا همین بود جور ز حد چه می‌بری(@)(@@) 3 بر سرآتش هوا دیگ هوس همی پزم %~% گرچه به کاسه سرم بر سرم آب می‌خوری(@)(@@) 4 مایه عمر جو به جو با تو دو نیمه می‌کنم %~% جوجوم از چه می‌کنی چیست بهانه بی زری(@)(@@) 5 بر دل من نشان غم ماند چو داغ گاز ران %~% تا تو ز نیل رنگرز بر گل تر نشان گری(@)(@@) 6 نور تویی و سایه من چون گل و ابر از آن کنند %~% چشم تو و سرشک من رنگرزی و گازری(@)(@@) 7 بر دل خاقانی اگر داغ جفا نهی چه شد %~% او ز سکان کیست خود تا بردت به داوری(@)(@@) 8 از تو بهر تهی دوی دولت وصل کی رسد %~% خاصه که چون بقا و عز خاص شه مظفری PageV1P0623(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوش که صبح چاک زد صدره چرخ عنبری %~% خضر درآمد از درم صبح‌وش از منوری(@)(@@) 2 شعبه برق و روز نو غرتش از مبارکی %~% قله برف و صبح‌دم شیبتش از معطری(@)(@@) 3 بیضه مهر احمدی جبهتش از گشادگی %~% روضه قدس عیسوی نکهتش از معنبری(@)(@@) 4 دست و عصاش موسوی رکوه پرآب زندگی %~% گرم روان عشق را کرده به چشمه رهبری(@)(@@) 5 مه قدم و فلک ردا وز تف آفتاب و ره %~% چهره چو ماه منخسف یافته رنگ اسمری(@)(@@) 6 دید مرا گرفته لب آتش پارسی ز تب %~% نطق من آب تازیان برده به نکته دری(@)(@@) 7 گفت چه طرفه طالعی کز درخانه ششم %~% مهره به کف به هفت حال این همه در مششدری(@)(@@) 8 در یرقان چو نرگسی در خفقان چو لاله‌ای %~% نرگس چاک جامه‌ای لاله خاک بستری 
ms577	(@)(@@) 9 حلقه آن بریشمی کز بر چنگ برکشند %~% از پی آن چو ماه نو زار و نزار و لاغری(@)(@@) 10 چند نشانه غرض بودن و بی‌نشان شدن %~% جوهر نور نیستی سایه نور جوهری(@)(@@) 11 مثل عطاردی چرا چون مه نو نه مقبلی %~% طالع تو اسد چرا چون سرطان به مدبری(@)(@@) 12 کعبه آسمان حرم صدر شهنشه است و بس %~% خاص کبوترش توئی ار همه نسر طائری(@)(@@) 13 گر ز حجاز کعبه را رخصت آمدن بود %~% در حرم خدایگان کعبه کند مجاوری(@)(@@) 14 سایه ذو الجلال بین وز فلک این ندا شنو %~% اینت مجاهد هدی اینت مظفر فری PageV1P0624(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 موکب شاه اختران رفت به کاخ مشتری %~% شش مهه داده ده نهش قصر دوازده دری(@)(@@) 2 قعده نقره خنگ روز آمده در جنیبتش %~% ادهم شب فکنده سم کندرو از مشمری(@)(@@) 3 یافت نگین گم شده در بر ماهیی چو جم %~% بر سر کرسی شرف رفت ز چاه مضطری(@)(@@) 4 هیکل خاک را ز نور حرز نویسد آسمان %~% در حرکات از آن کند جدول جوی مسطری(@)(@@) 5 خاک در خدایگان گر به کف آوری در او %~% هشت بهشت و چار جوی از بر سدره بنگری(@)(@@) 6 غازی مصطفی رکاب آنکه عنان زنان رود %~% با قدم براق او فرق سپهر چنبری(@)(@@) 7 مفخر اول البشر مهدی آخر الزمان %~% وحی به جانش آمده آیت عدل گستری(@)(@@) 8 خسرو صاحب القران تاج فروق خسروان %~% جعفر دین به صادقی حیدر کین به صفدری(@)(@@) 9 دست بهشت صدر او دست قدر به خدمتش %~% گنبد طاقدیس را بسته نطاق چاکری(@)(@@) 10 گر عظمت نهد چو جم منظر نیم خایه را %~% خانه مورچه شود نه فلک از محقری(@)(@@) 11 گوهر ذوالفقار او گرنه علی است چون کند %~% بیشه ستان رزم را آتشی و غضنفری(@)(@@) 12 دلدل مشتری پیش جفته زد اندر آسمان %~% آه ز دل کشان زحل گفت قطعت ابهری(@)(@@) 13 شاه بر اسب پیل تن رخ فکند 
ms578	 پلنگ را %~% شیر فلک چو سگ بود تاش پیاده نشمری(@)(@@) 14 گرنه سگش بود فلک چون نمط پلنگ و مه %~% پر نقط بهق شود روی عروس خاوری(@)(@@) 15 از رحم عروس بخت این حرم جلال را %~% نوخلفان فتح بین وارث ملک پروری(@)(@@) 16 در بر تیغ حصر می زاده جنابه چون عنب %~% برده جناب از آسمان کرده همه دو پیکری(@)(@@) 17 کی به دو خیل نحس پی بر سپهش زند عدو %~% کی به دو زرق بسته سر هر سقطی شود سری(@)(@@) 18 لعبت مرده را که اصل از گچ زنده می‌کنند %~% از دل پیر عاشقان رخصت نیست دلبری(@)(@@) 19 سخت تغابنی بود حور حریر سینه را %~% لاف زنی خارپشت از صفت سمنبری(@)(@@) 20 ای چو هیولی فلک صدر تو از فنا تهی %~% وی چو طبیعت ملک ذات تو از خطا بری(@)(@@) 21 برده به رمح ماروش نیروی گاو آسمان %~% چون تف گرز گاوسر شوکت مار حمیری(@)(@@) 22 رمح تو راست هژده گز پرچم و آفتاب طاس %~% از بر ماه چارده سایه کند صنوبری(@)(@@) 23 حلقه ربای ماه نو نیزه توست لاجرم %~% نیزه کشت فلک سزد زآنکه سماک ازهری(@)(@@) 24 سر کمالت از بر است از بر عرش برشوی %~% نیست جهانت سدره‌ای از سر سدره بگذری(@)(@@) 25 زبده دور عالمی زآن چو نبی و مرتضی %~% بحر عقول را دری شهر علوم را دری(@)(@@) 26 نایب تنگری توئی کرده به تیغ هندوی %~% سنقر کفر پیشه را سن‌سن گوی ننگری(@)(@@) 27 هم جم و هم محمدی کرده به خدمت درت %~% روح و سروش آسمان هدهدی و کبوتری(@)(@@) 28 گر بر شعری یمن یمن مثال تو رسد %~% مسخ شود سهیل‌وار ار نکند مسخری(@)(@@) 29 از خط کاتب قدر بر سر حرف حکم تو %~% چرخ تو جزم نحویان حلقه شد از مدوری(@)(@@) 30 وز سر ناوک اجل صورت بخت خصم را %~% دیده چو میم کاتبان کور شد از مکدری(@)(@@) 31 خط دبیر تر بود خاک 
ms579	 کنند بر سرش %~% خصم تو شد چو آب ترخاک به سربر ازتری(@)(@@) 32 نیک شناسد آسمان آب تو ز آتش عدو %~% فرق کند محک دین بولهبی ز بوذری(@)(@@) 33 دمنه اسد کجا شود شاخ درمنه سنبله %~% قوت موم و آتشی فعل زقوم و کوثری(@)(@@) 34 تخت تو در مربعی عرشی و کعبه‌ای کند %~% شاه مثلثی از آن کاختر چرخ اخضری(@)(@@) 35 کرده به صدر کعبه در بهر مشام عرشیان %~% خاک درت مثلثی دخمه چرخ اخضری(@)(@@) 36 یک تنه صد هزار تن می‌نهمت چو آفتاب %~% ارچه به صد هزار یل بدر ستاره لشکری(@)(@@) 37 سلطنت و خلیفتی چون دو طرف نهاد حق %~% پس تو میان این و آن واسطه مخیری(@)(@@) 38 گر به قبول سلطنت قصد کنی به دار ملک %~% از سم کوه پیکران خاک عراق بسپری(@)(@@) 39 ور به مدینة السلام آوری از عراق رخ %~% دجله در آتشین عرق خون شود از مبتری(@)(@@) 40 ور ز عراق وقت را عزم غزای غز کنی %~% از سر چار حد دین شحنه کفر بر گری(@)(@@) 41 در عقبات راه دین بهر عقوبت غزان %~% تیغ تو دوزخی کند آب سنانت آذری(@)(@@) 42 بر سر دوزخت کند حور بهشت مالکی %~% دربر آتشت کند حوت فلک سمندری(@)(@@) 43 چون جم از اهرمن نگین باز ستانی از غزان %~% تاج سر ملک شهی خاتم دست سنجری(@)(@@) 44 باد صبا بر آب کر نقش قد افلح آورد %~% تا تو فلاح و فتح را بر شط مفلحان بری(@)(@@) 45 فرضه عسقلان و نیل از شط مفلحان دگر %~% هست خراس پارگین از سمت مزوری(@)(@@) 46 گرد معسکرت فلک ساخت حنوط اختران %~% زانکه نجوم ملک را شاه فلک معسکری(@)(@@) 47 گرد معسکرت فلک رخت فکند و خیمه زد %~% گفت به خدمت اندرم تا به سعادت اندری(@)(@@) 48 زیر طناب خیمه‌ات عرش خمیده رفت و گفت %~% ای خط جدول هدی حبل متین دیگری(@)(@@) 49 پور سبکتکین تویی دولت ایاز خدمتت %~% بنده به دور 
ms580	 دولتت رشک روان عنصری(@)(@@) 50 گرچه بدست پیش ازین در عرب و عجم روان %~% شعر شهید و رودکی نظم لبید و بحتری(@)(@@) 51 در صفت یگانگی آن صف چارگانه را %~% بنده سه ضربه می‌زند در دو زبان شاعری(@)(@@) 52 باد چو روز آن جهان خمسین الف سال تو %~% بیش ز مدت ابد ذات تو را معمری(@)(@@) 53 کرده منجم قدر حکم کز اخترت بود %~% فسخ لوای ظالمی خسف بنای کافری(@)(@@) 54 مالت و دست سائلان دستت و جام خسروی %~% بندت و پای سرکشان پایت و تخت سروری(@)(@@) 55 تخت تو تاج آسمان تاج تو فر ایزدی %~% حکم تو طوق گردنان طوق توزلف سعتری PageV1P0625(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 پیش که صبح بر درد شقه چتر عنبری %~% خیز مگر به برق می برقع صبح بر دری(@)(@@) 2 پیش که غمزه زن شود چشم ستاره سحر %~% بر صدف فلک رسان خنده جام گوهری(@)(@@) 3 برکش میخ غم ز دل پیش که صبح برکشد %~% این خشن هزار میخ از سر چرخ چنبری(@)(@@) 4 ساخت فرو کند ز اسب آینه بندد آسمان %~% صبح قبا زره زند ابر کند زره‌گری(@)(@@) 5 زآنکه برهنگی بود زیور تیغ صبح فش %~% صبح برهنه می‌کند بر تن چرخ زیوری(@)(@@) 6 گاه چو حال عاشقان صبح کند ملونی %~% گه چو حلی دلبران مرغ کند نواگری(@)(@@) 7 چون به صبوح بلبله قهقهه کرد و خنده‌نی %~% خنده کند نه قهقهه صبح چو نوگل طری(@)(@@) 8 روز به روزت از فلک نزل دو صبح می‌رسد %~% صبح سه گردد ار به کف جام صبوحی آوری(@)(@@) 9 نوبر صبح یک دم است اینت شگرف اگر دهی %~% داد دمی که می‌دهد صبح‌دمت به نوبری(@)(@@) 10 فرض صبوح عید را کز تو به خواب فوت شد %~% صدره اگر قضا کنی تا ز صبوح نشمری(@)(@@) 11 نیست ز نامده خبر وز دم رفته حاصلی %~% حاصل وقت را نگر تا دم رفته ننگری(@)(@@) 12 عمر پلی است رخنه‌سر حادثه سیل پل 