ms1381	 بال القرض أفضل من الصدقة ؟ قال : لأن السائل يسأل وعنده ، والمستقرض لا يستقرض إلا من حاجة ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12370 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي موسى رجلا آدم طوالا جعدا كأنه من رجال شنوءة ، ورأيت عيسى رجلا مربوع الخلق إلى الحمرة والبياض ، PageV04P393 سبط الرأس ، ورأيت مالكا خازن النار ، والدجال ) )(@)(@@) ( حم ق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12371 ) قال النبي :(@)(@@) | 30 ( رأيتني دخلت الجنة ، فإذا أنا بالرميصاء ، امرأة أبي طلحة ، وسمعت خشفا من أمامي فقلت : من هاذا يا جبريل ؟ قال : هاذا بلال ، ورأيت قصرا أبيض بفنائه جارية ، فقلت : لمن هاذا القصر ؟ قالوا : لعمر بن الخطاب ، فأردت أن أدخله فأنظر إليه ، فذكرت غيرتك ) )(@)(@@) ( حم ق ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12372 ) قال النبي :(@)(@@) | 30 ( رأس العقل بعد الإيمان بالله الحياء وحسن الخلق ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12373 ) قال النبي :(@)(@@) | 30 ( رأيت الدجال فيلمانيا أقمر هجانا ، إحدى عينيه قائمة كأنها كوكب دري ، كأن شعر رأسه أغصان شجرة ، ورأيت عيسى شابا أبيض جعد الرأس ، حديد البصر ، مبطن الخلق ، ورأيت موسى أشحم أدهم كثير الشعر ، شديد الخلق ، ونظرت إلى إبراهيم فلا أنظر إلى رب منه إلا نظرت إليه كأنه صاحبكم ، فقال جبريل : سلم على مالك ، فسلمت عليه ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12374 ) قال النبي :(@)(@@) | 30 ( رأيت إبراهيم وموسى وعيسى ببيت المقدس ، فرأيت موسى رجلا ضربا آدم بين الرجلين ، كأنه من رجال شنوءة ، ورأيت عيسى رجلا أحمر كأنما خرج من ديماس ، وأنا أشبه بني إبراهيم به ، وأتيت بإناء خمر PageV04P394 وإناء لبن ، فأخذت اللبن ، فقال جبريل : هديت الفطرة ، لو أخذت الخمر غوت أمتك ) )(@)(@@) ( ط ) عن سعيد بن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 12375 ) قال النبي :(@)(@@) | 30 ( رأيت النور الأعظم ، ولط دوني الحجاب رفرف الدر والياقوت ، فأوحى إلي ما شاء أن يوحي ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12376 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي حول العرش فريدة خضراء مكتوب فيها بقلم من نور 
ms1382	 أبيض لا إلاه إلا الله محمد رسول الله أبو بكر الصديق ) )(@)(@@) ( حب ) في الضعفاء ( قط ) في الأفراد عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12377 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي لما انتهيت إلى السماء السابعة ، نظرت فوقي فإذا أنا برعد وبرق وصواعق ، فأتيت على قوم بطونهم كالبيوت فيها الحيات ترى من خارج بطونهم ، فقلت : من هاؤلاء يا جبريل ؟ قال : هاؤلاء أكلة الربا ، فلما نزلت وانتهيت إلى السماء الدنيا نظرت أسفل مني ، فإذا أنا برهج ودخان وأصوات ، فقلت : ما هاذا يا جبريل ؟ قال : هاذه الشياطين يحومون على أعين بني آدم أن لا يتفكروا في ملكوت السماوات والأرض ، ولولا ذالك لرأوا العجائب ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12378 ) قال النبي :(@)(@@) | 30 ( رأيت جبريل منهبطا من السماء سادا عظم خلقه ما بين السماء والأرض ) )(@)(@@) أبو الشيخ في العظمة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12379 ) قال النبي :(@)(@@) | 30 ( رأيت جبريل عند السدرة وعليه ستمائة جناح ، ينتثر من ريشه تهاويل الدر والياقوت ) )(@)(@@) أبو الشيخ عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12380 ) قال النبي :(@)(@@) | 30 ( رأيت ربي في أحسن صورة فقال لي : يا محمد PageV04P395 أتدري فيم يختصم الملأ الأعلى ؟ فقلت : يا رب ، في الكفارات ، قال : وما الكفارات ؟ قلت : إبلاغ الوضوء أماكنه على الكراهات ، والمشي على الأقدام إلى الصلوات وانتظار الصلاة بعد الصلاة ) )(@)(@@) ( طب ) عن عبيد الله بن أبي رافع عن أبيه .(@)(@@)(@@)(@@) $ ( 12381 ) قال النبي :(@)(@@) | 30 ( رأيت ربي في صورة شاب له وفرة ) )(@)(@@) ( طب ) في السنة عن ابن عباس رضي الله عنهما ونقل عن أبي زرعة الرازي أنه قال : هو حديث صحيح ، قلت : وهو محمول على رؤية المنام ، وكلتا الحديث السابق كالآتي .(@)(@@)(@@)(@@) $ ( 12382 ) قال النبي :(@)(@@) | 30 ( رأيت ربي في المنام في صورة شاب موفر في الخضر ، عليه نعلان من ذهب ، وعلى وجه فراش من ذهب ) )(@)(@@) ( طب ) في السنة عن أم الطفيل امرأة أبي بن كعب رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12383 ) قال النبي :(@)(@@) | 30 ( رأيت ربي في حظيرة من الفردوس في صورة شاب عليه تاج يلتمع 
ms1383	 البصر ) )(@)(@@) ( طب ) في السنة عن معاذ بن عفراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12384 ) قال النبي :(@)(@@) | 30 ( رأيت كأني مردف كبشا ، وكأن ظبة سيفي انكسرت ، فأولت أني أقتل كبش القوم ، وأولت ظبة سيفي : قتل رجل من عترتي ) )(@)(@@) ( حم طب ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12385 ) قال النبي :(@)(@@) | 30 ( رأيت كأني وزنت بأربعين رجلا من أصحابي أنت فيهم فوزنتهم ) )(@)(@@) ابن فيل والروياني ( ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12386 ) قال النبي :(@)(@@) | 30 ( رأيت في المنام كأن أبا جهل أتاني فبايعني ، فلما PageV04P396 أسلم خالد قيل هو هاذا ، فقال : ليكونن غيره ، حتى أسلم عكرمة ) )(@)(@@) ( كر ) عن أبي بكر بن عبد الرحمان بن الحارث بن هشام مرسلا ( ك ) عنه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12387 ) قال النبي :(@)(@@) | 30 ( رأيت في النوم بني الحكم ينزون على منبري كما تنزو القردة ) )(@)(@@) ( ع هق ) في الدلائل عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12388 ) قال النبي :(@)(@@) | 30 ( رأيت كأني أتيت بكتلة تمر فعجمتها في فمي ، فوجدت فيها نواة فلفظتها ، فقال أبو بكر : هو جيشك الذي بعثت يسلمون ويغنمون فيلقون رجلا فينشدهم ذمتك فيه فيدعونه ثم يلقون رجلا فينشدهم ذمتك فيدعونه ، قال : كذالك قال الملك ) )(@)(@@) ( حم ) و الدارمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12389 ) قال النبي :(@)(@@) | 30 ( رأيت في الم نام أني أنزع بدلو بكرة على قليب ، فجاء أبو بكر فنزع ذنوبا أو ذنوبين ، وفي بعض نوعه ضعف ، والله يغفر له ، ثم أخذها عمر فاستحالت بيده غربا ، فلم أر عبقريا في الناس يفري فريه ، حتى ضرب الناس بعطن ) )(@)(@@) ( خ ت ) عن سالم عن أبيه .(@)(@@)(@@)(@@) $ ( 12390 ) قال النبي :(@)(@@) | 30 ( رأيت كأن دلوا دليت من السماء ، فجاء أبو بكر فأخذ بعراقيها فشرب ختى تضلع ، ثم جاء عثمان فأخذ بعراقيها فشرب حتى تضلع ، ثم جاء علي فأخذ بعراقيها فانقشعت منه وانتضح عليه ) )(@)(@@) ( حم طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12391 ) قال النبي :(@)(@@) | 30 ( رأيت فيما يرى النائم كأني أنزع أرضا ، وردت PageV04P397 علي غنم سود وغنم عفر ، فجاء أبو بكر فنزع ذنوبا أو 
ms1384	 ذنوبين وفيهما ضعف والله يغفر له ، ثم جاء عمر فنزع فاستحالت غربا فملأ الحوض وأروى الواردة ، فلم أر عبقريا أحسن نزعا من عمر ، فأولت أن السود العرب ، وأن العفر الع 2 جم ) )(@)(@@) ( حم طب ) عن أبي الطفيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12392 ) قال النبي :(@)(@@) | 30 ( رأيت في النوم أني أعطيت عسا مملوءا لبنا فشربت منه حتى تملأت حتى رأيته يجري في عروقي بين الجلد واللحم ، ففضلت فضلة فأعطيتها عمر بن الخطاب ، فأولوها قالوا : يا نبي الله هاذا علم أعطاكه الله فملئت منه ، ففضلت فضلة فأعطيتها عمر بن الخطاب ، قال : أصبتم ) )(@)(@@) ( طب ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12393 ) قال النبي :(@)(@@) | 30 ( رأيت في سيفي ذي الفقار فلا فأولته فلا يكون فيكم ، ورأيت أني مردف كبشا فأولته كبش الكتيبة ، ورأيت أني في درع حصينة فأولتها المدينة ، ورأيت بقرات ذبح فبقر ، والله خير فبقر ، والله خير ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12394 ) قال النبي :(@)(@@) | 30 ( رأيت كأني دخلت الجنة فرأيت لجعفر درجة فوق درجة زيد ، فقيل لي : تدري بم رفعت درجة جعفر ؟ قلت : لا ، قيل : لقرابة ما بينك وبينه ) )(@)(@@) ( ك ) وتعقب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12395 ) قال النبي :(@)(@@) | 30 ( رأيت غنما كثيرة سوداء دخلت فيها غنم كثيرة بيض ، قالوا : فما أولته يا رسول الله ؟ قال : العجم فيشركونكم في دينكم وأنسابكم ، لو كان الإيمان معلقا بالثريا لناله رجال من العجم ، وأسعدهم به الفارس ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV04P398(@)(@@)(@@)(@@) $ ( 12396 ) قال النبي :(@)(@@) | 30 ( رأيت قبيل الفجر كأني أعطيت المقاليد والموازين ، فأما المقاليد فهاذه المفاتيح ، وأما الموازين فهاذه التي يوزن بها ، فوضعت في كفة ووضعت أمتي في كفة فوزنت بهم فرجحت ، ثم جيء بأبي بكر فوزن فوزن بهم ، ثم جيء بعمر فوزن فوزن بهم ، ثم جيء بعثمان فوزن فوزن بهم ، ثم رفعت ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12397 ) قال النبي :(@)(@@) | 30 ( رأيت الليلة في المنام كأن ثلاثة من أصحابي وزنوا ، فوزن أبو بكر فوزن ، ثم وزن عمر 
ms1385	 فوزن ، ثم عثمان فنقص صاحبنا وهو صالح ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 12398 ) قال النبي :(@)(@@) | 30 ( رأيت في المنام امرأتين واحدة تتكلم والأخرى لا تتكلم ، كلتاهما من أهل الجنة ، فقلت لها : أنت تتكلمين وهاذه لا تتكلم ، فقالت : أما أنا فأوصيت ، وهاذه ماتت بلا وصية لا تتكلم إلى يوم القيامة ) )(@)(@@) الديلمي عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12399 ) قال النبي :(@)(@@) | 30 ( رأيت كأني أتيت بقدر فأكلت منها حتى تضلعت ، فما أريد أن آتي النساء ساعة إلا فعلت منذ أكلت منها ) )(@)(@@) ابن سعد عن الزهري مرسلا .(@)(@@)(@@)(@@) $ ( 12400 ) قال النبي :(@)(@@) | 30 ( رأيت الليلة أني جالس على عين من عيون الجنة يعني بئر غرس ) )(@)(@@) ابن سعد عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12401 ) قال النبي :(@)(@@) | 30 ( رأيت عمود الكتاب انتزع من تحت وسادتي فأتبعته بصري فإذا هو نور ساطع ، حتى ظننت أنه قد هوي به فعمد به إلى الشام ، ألا PageV04P399 وإني أولت أن الفتن إذا وقعت فإن الإيمان بالشام ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12402 ) قال النبي :(@)(@@) | 30 ( رأيت كأن رحمة وقعت بين بني سالم وبين بني بياضة ، قالوا : يا رسول الله أفتنتقل إلى موضعها ؟ قال : لا ، ولاكن اقبروا فيها موتاكم ) )(@)(@@) الباوردي عن إبراهيم بن عبد الله بن سعد بن خيثمة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 12403 ) قال النبي :(@)(@@) | 30 ( رأيت فيما يرى النائم كأن عتاب بن أسيد أتى باب الجنة فأخذ بحلقة الباب فقلقلها حتى فتح له فدخل ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12404 ) قال النبي :(@)(@@) | 30 ( رأيت جدود العرب ، فإذا جد بني عامر حمل آدم يأكل من أطراف الشجر ، ورأيت جد غطفان صخرة خضراء يتفجر منها الينابيع ، ورأيت جد بني تميم هضبة حمراء لا يضرها من وراءها ، فقال رجل من القوم : إنهم إنهم ، فقال : مه مه عنهم ، فإنهم عظام الهمام ، ثبت الأقدام ، أنصار الحق في آخر الزمان ) )(@)(@@) الديلمي عن عمرو العوفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12405 ) قال النبي :(@)(@@) | 30 ( رأيت كأن في يدي سوارين من ذهب فكرهتهما فنفختهما فذهبا : كسرى وقيصر 
ms1386	 ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12406 ) قال النبي :(@)(@@) | 30 ( رأيت عمود الكتاب انتزع من تحت وسادتي فذهب إلى الشام ، فأولته الملك ) )(@)(@@) ( كر ) وحسنه عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12407 ) قال النبي :(@)(@@) | 30 ( رأيت عمودا من نور انتزع من تحت رأسي ساطعا حتى استقر بالشاك ) )(@)(@@) ( كر ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12408 ) قال النبي :(@)(@@) | 30 ( رأيتني دخلت الجنة فإذا أنا بالرميضاء امرأة أبي PageV04P400 طلحة ، وسمعت خشفا أمامي ، فقلت : من هاذا يا جبريل ؟ قال : هاذا بلال ، ورأيت قصرا أبيض بفنائه جارية ، فقلت : لمن هاذا القصر ؟ قالوا : لعمر بن الخطاب ، فأردت أن أدخله فأنظر إليه فذكرت غيرتك ) )(@)(@@) ( حم خ م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12409 ) قال النبي :(@)(@@) | 30 ( رأيتني أنزع من بئر وعليها معزى ، ثم وردت علي ضأن كثيرة فأولتهم الأعاجم يدخلون في الإسلام ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12410 ) قال النبي :(@)(@@) | 30 ( رأيت جبريل منهبطا قد ملأ ما بين الخافقين ، عليه ثياب سندس معلق بها اللؤلؤ والياقوت ) )(@)(@@) أبو الشيخ في العظمة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12411 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي قصورا مستوية على الجنة ، قلت : يا جبريل لمن هاذا ؟ فقال : للكاظمين الغيظ والعافين عن الناس والله يحب المحسنين ) )(@)(@@) ابن لال والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12412 ) قال النبي :(@)(@@) | 30 ( رأيت الجنة والنار فلم أر مثل ما فيهما من الخير والشر ) )(@)(@@) ( هق ) في البعث عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12413 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي عمودا أبيض كأنه لؤلؤة تحمله الملائكة ، قلت : ما تحملون ؟ قالوا : عمود الإسلام أمرنا أن نضعه بالشام ، وبينا أنا نائم رأيت عمود الكتاب اختلس من تحت وسادتي فظننت أن الله تخلى عن أهل الأرض ، فأتبعته بصري فإذا هو نور ساطع بين يدي حتى وضع بالشام ) )(@)(@@) ( طب ) عن عبد الله بن حوالة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12414 ) قال النبي :(@)(@@) | 30 ( رأيت ليلة أسري بي رجلا يسبح في نهر يلقم PageV04P401 الحجارة ، فسألت من هاذا ؟ فقيل : هاذا آكل الربا ) )(@)(@@) ( هب ) عن سمرة رضي 
