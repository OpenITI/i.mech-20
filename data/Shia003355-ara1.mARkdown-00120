ms101	 أبا الفهد أنت في الدفعة الأولى أحسن حال منك في الدفعة الثانية. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الايضاح في النحو.(@)(@@)(@@)(@@) $BIO_MAN$ الأزدي(@)(@@) أبو القاسم عبد الله بن محمد الأزدي، من أهل البصرة. وله من الكتب، كتاب النطق.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الاختلاف).(@)(@@)(@@)(@@) $BIO_MAN$ الهروي(@)(@@) من العجم. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التصريف.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الشرح).(@)(@@)(@@)(@@) $BIO_MAN$ المصيصي(@)(@@) لا نعرف غير هذا. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشافي في اللغة.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الإفصاح).(@)(@@)(@@)(@@) $BIO_MAN$ (ابن) الوشاء(@)(@@) أبو الطيب محمد بن أحمد بن إسحاق الاعرابي الوشاء. أحد الأدباء الظرفاء وكان نحويا معلما لمكتب العامة.(@)(@@) والغالب على تصنيفه كتب الاخبار والشعر والمقطعات. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختصر في النحو.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جامع النحو. كتاب المقصور والممدود.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المذكر والمؤنث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خلق الانسان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خلق الفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المثلث. واما كتبه الأدبية الأخبارية:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار صاحب الزنج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الزاهر في الأنوار والزهر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحنين إلى الأوطان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حدود الطيف الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموشا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار المتظرفات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السلوان.(@)PageV00P093(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المذهب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الموشح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سلسلة الذهب.(@)(@@)(@@)(@@) $BIO_MAN$ ابن المراغي(@)(@@) أبو الفتح محمد بن جعفر الهمداني ثم الوادعي . وكان معلم عز الدولة أبى منصور وكان حافظا نحويا بليغا اخباريا في نهاية السرو والحرية. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البهجة، على مثال كتاب الكامل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الاستدراك لما أغفله الخليل).(@)(@@)(@@)(@@) $BIO_MAN$ المراغي(@)(@@) أبو بكر محمد بن علي من أهل المراغة. وكان ممتنعا أطال المقام بالموصل. واتصل بابى العباس دمخا .(@)(@@) وكان عالما دينا، قراء على الزجاج. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختصر النحو .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شرح شواهد سيبويه أو تفسيرها .(@)(@@)(@@)(@@) $BIO_MAN$ البكري(@)(@@) ويعرف بابى الفضل محمد بن أبي غسان البكري. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مختصر في النحو.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الفرق).(@)(@@)(@@)(@@) $BIO_MAN$ عرام(@)(@@) أبو الفضل العباس بن محمد. وكان رقيعا ويتعاطا بعد تسميته بالنحوي المنادمة. وله رسيلات تجرى مجرى الطنز واللهو إلى جماعة.(@)(@@)(@@)(@@) $BIO_MAN$ 
ms102	 الزجاج(@)(@@) معلم ولد ناصر الدولة. واسمه محمد بن الليث. رأيته بالموصل ولا أعرف له كتابا.(@)(@@)(@@)(@@) $BIO_MAN$ العوامي(@)(@@) أبو بكر محمد بن إبراهيم النحوي القاضي. صديقي وكان يعرف بالقاضي. وتوفى سنة.. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاصلاح والايضاح في النحو.(@)(@@)(@@)(@@) $BIO_MAN$ رجل يعرف بابن عبدوس(@)(@@) واسمه علي بن محمد بن عبدوس الكوفي، نحوي. وله من الكتب، كتاب ميزان الشعر بالعروض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البرهان في علل النحو.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب معاني الشعر.(@)(@@)(@@)(@@) $BIO_MAN$ الوفراوندي(@)(@@) واسمه يونس بن أحمد بن إبراهيم الوفراوندي، نحوي. وله من الكتب، كتاب الشافي في علل النحو كتاب الوافي في علم العروض.(@)(@@)(@@)(@@) $BIO_MAN$ الديمرتي(@)(@@) أبو محمد القاسم بن محمد، من أهل أصبهان من قرية يقال لها ديمرت. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تقويم(@)PageV00P094 الألسنة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العارض في الكامل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب تفسير الحماسة).(@)(@@)(@@)(@@) $BIO_MAN$ (أبو العباس)(@)(@@) (محمد بن خلف بن المرزبان. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحاوي في علوم القرآن، سبعة وعشرون جزءا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحماسة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار عبد الله بن جعفر بن أبي طالب عليهم السلام).(@)(@@)(@@)(@@) $BIO_MAN$ أبو الحسن (بن الوراق)(@)(@@) (واسمه) محمد بن عبد الله . وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب علل النحو .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الهداية، وهو شرح مختصر النحو لأبي عمر الجرمي .(@)(@@)(@@)(@@) $BIO_MAN$ أبو أحمد بن الحلاب(@)(@@) (لم يذكر له كتاب).(@)(@@)(@@)(@@) $BIO_MAN$ (ابن جنى) أبو الفتح(@)(@@) (وهو أبو الفتح) عثمان بن جنى (النحوي). (مولده قبل الثلاثين وثلثمائة. وتوفى يوم الجمعة من صفر سنة اثنتين وتسعين وثلثمائة (وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفسر وهو تفسير شعر أبى الطيب المتنبي كتاب التعاقب في العربية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التلقين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اللمع كتاب الفصل بين الكلام الخاص والعام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العروض والقوافي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمل أصول التصريف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الوقف والابتداء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الألفاظ من المهموز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المذكر والمؤنث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفسير مراثي الثلاثة والقصيدة الرائية للشريف الرضى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب معاني أبيات المتنبي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفرق بين الكلام الخاص والعام )(@)(@@)(@@)(@@) $BIO_MAN$ أبو عبد الله النمري(@)(@@) (ما ذكر 
ms103	 له مصنف).(@)(@@)(@@)(@@) $BIO_MAN$ (بردويه)(@)(@@) ((ما ذكر له مصنف).(@)(@@)(@@)(@@) ||| (الكتب القديمة في اخبار النحويين)(@)(@@)(@@)(@@) $DIC_BIB$ (اخبار النحويين للنجيرمي.(@)(@@)(@@)(@@) $DIC_BIB$ اخبار النحويين. لأبي سعيد السيرافي. (@)(@@)(@@)(@@) $DIC_BIB$ اخبار النحويين. للمرزباني.(@)(@@) المقتبس الكبير. (@)(@@)(@@)(@@) $DIC_BIB$ اخبار النحويين. لأبي بكر محمد بن عبد الملك التاريخي) ":(@)PageV00P095 (قال محمد بن إسحاق) هذا اخر ما صنفاه من مقالة النحويين واللغويين إلى يوم السبت مستهل شعبان سنة سبع وسبعين وثلثمائة (والحمد لله وصلى الله على محمد وآله. (ونسئل الله البقاء لمن صنفنا له ولنا في عافية وأمن وكفاية. وهو بمنه يفعل ذلك ويلهمنا رضاه ويعيننا على طاعته بكرمه وحسبنا الله ونعم الوكيل وصلى الله على خيرته من خلقه محمد وآله).(@)(@@)(@@)(@@) ||| تسمية الكتب المؤلفة في غريب الحديث(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لأبي عبيدة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. للأصمعي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث للنضر بن شميل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لقطرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لابن الاعرابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لابن عدنان.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب غريب الحديث لابن قادم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لأبي زيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لسلمه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لأبي عبيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث للأثرم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لفستقة صاحب الكرابيسي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث للحامض.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث لابن قتيبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اصلاح غلط أبى عبيد لابن قتيبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث لابن الأنباري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لابن دريد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لأبي الحسين القاضي بن أبي عمر.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب غريب الحديث لابن حبيب).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث لابن كيسان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب.(@)(@@) الحديث للجعد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. للحصري الفه عن أبي عمر الزاهد. (كتاب غريب الحديث لابن رستم الحربي).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث لابن درستويه (ولم يتمه).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. لأحمد بن الحسن الكندي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غريب الحديث. للسلمي.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب غريب القرآن، لعبد الله بن سلام الدينوري). (قال محمد بن إسحاق:(@)(@@) روى كتاب السلمي، وهو الحسين بن عياش السلمي، أبو عمر هلال بن العلا بن هلال الرقي 
ms104	 الباهلي ورواه عن هلال، أبو القاسم الحسين بن عبد الله بن مناذر الواسطي).(@)(@@)(@@)(@@) ||| تسمية الكتب المؤلفة في النوادر(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر. عن أبي عمرو العلاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر. لأبي عمرو الشيباني، ثلاث نسخ. كبيرة ووسطى وصغيرة كتاب نوادر أبى زيد .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الأصمعي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الكسائي، ثلاث نسخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر ابن الاعرابي رواها عنه اثنا عشر انسانا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الفراء (يحيى بن زياد). رواه سلمة وابن قادم والطوال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر اللحياني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى مسحل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى محمد اليزيدي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر (أبى) زياد الكلابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى شنبل العقيلي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر دهمح النصري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الأموي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الأثرم .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر الدبيريين عن ابن الاعرابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر بنى فقعس، عن ابن الاعرابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر ابن السكيت كتاب نوادر ابن المضرجي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى اليقظان، رأيته بخط ابن سعدان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر التوزي أبى محمد كتاب أبى اسحق الزجاج في النوادر(@)PageV00P096(@)(@@)(@@)(@@) ||| تسمية الكتب المؤلفة في الأنواء(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، للأصمعي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، لأبي محلم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء لقطرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، لابن الاعرابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، للمبرد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، لابن قتيبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء لأبي حنيفة الدينوري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء للزجاج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء لابن دريد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، للوهبي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، للمرثدي .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء لوكيع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء، لابن عمار.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الأنواء. لأبي غالب أحمد بن سليم الرازي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأنواء لمحمد بن حبيب).(@)(@@) (جب. على الهامش: عورض بالأصل المصنف العين وصح. والحمد لله رب العالمين).(@)PageV00P097(@)(@@)(@@)(@@) |PARATEXT|(@)(@@) الجزء الثالث من كتاب الفهرست في اخبار العلماء وأسماء ما صنفوه من الكتب تأليف محمد بن إسحاق بن محمد بن إسحاق النديم المعروف اسحق بابن أبى يعقوب الوراق المنقول من دستوره وبخطه فيه المقالة الثالثة (الكتابة مخطوطة) PageV00P099(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | المقالة الثالثة من كتاب الفهرست في اخبار الأخباريين والنسابين وأصحاب 
ms105	 الاحداث والآداب(@)(@@) وهي ثلاثة فنون(@)(@@) الفن الأول، في اخبار الأخباريين والنسابين وأصحاب السير والاحداث وأسماء كتبهم.(@)(@@) الفن الثاني، في اخبار الكتاب المترسلين وصناع الخراج وأسماء كتبهم.(@)(@@) الفن الثالث، في اخبار الأدباء والندماء والمغنيين والصفادمة والصفاعنة وأسماء كتبهم.(@)(@@)(@@)(@@) || الفن الأول [ في اخبار الأخباريين والنسابين وأصحاب السير والاحداث وأسماء كتبهم ](@)(@@) قال محمد بن إسحاق: قرأت بخط أبى الحسن ابن الكوفي، أول من الف في المثالب كتابا زياد بن أبيه. فإنه لما طعن عليه وعلى نسبه عمل ذلك (ودفعه) إلى ولده وقال استظهروا به على العرب فإنهم يكفون عنكم.(@)(@@) أسماء واخبار الصدر الأول ممن اخذ عنه المآثر والأنساب والاخبار(@)(@@)(@@)(@@) $BIO_MAN$ (دغفل النسابة)(@)(@@) من خط ابن البربري وهو الحجر بن الحارث الكسائي. ودغفل لقب. وقيل دغفل الذهلي وهو دغفل بن حنظلة السدوسي. أدرك النبي عليه السلام ولم يسمع منه. ووفد على معاوية واتاه قدامة بن ضرار القريعي، فنسبه دغفل حتى بلغ أباه الذي ولده فقال: وولد ضرار رجلين امام أحدهم فناسك واما الاخر فشاعر فأيهما أنت. فقال: انا الشاعر السفيه وقد أصبت في نسبي وكل أمري، فأخبرني متى أموت. فقال: ليس ذاك عندي.(@)(@@) وقتلت دغفل الشراة. ولا مصنف له.(@)(@@)(@@)(@@) $BIO_MAN$ النسابة البكري(@)(@@) وكان نصرانيا. وروى عنه رؤبة بن العجاج، ان للعلم آفة وهجنة ونكدا.(@)(@@)(@@)(@@) $BIO_MAN$ لسان الحمرة(@)(@@) واسمه وقاء بن الأشعر وكنيته أبو كلاب. وكان ناسبا وأشد الناس تيها وكبرا.(@)PageV00P101(@)(@@)(@@)(@@) $BIO_MAN$ عبيد بن شرية(@)(@@) الجرهمي، في زمان معاوية. وأدرك النبي عليه السلام ولم يسمع منه شيئا. ووفد على معاوية بن أبي سفيان، فسئله عن الأخبار المتقدمة وملوك العرب والعجم وسبب تبلبل الألسنة وامر افتراق الناس في البلاد. وكان استحضره من صنعاء اليمن، فأجابه بما أمر فامر معاوية ان يدون وينسب إلى عبيد بن شريه. عاش عبيد (بن شريه) إلى أيام عبد الملك بن مروان. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملوك واخبار الماضين.(@)(@@)~:section: اسم من روى عنه عبيد بن شرية(@)(@@) الكيس النمري وابنه زيد بن الكيس. اللسين الجرهمي. عبد ود الجرهمي. 
ms106	 (@)(@@)(@@)(@@) $BIO_MAN$ علاقة بن كرشم (@)(@@) الكلابي من بنى عامر بن كلاب. في أيام يزيد بن معاوية، عارف بأيام العرب وأحاديثها وهو أحد من اخذت عنه المآثر (وادخله يزيد بن معاوية في سماره. وله من الكتب،)(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال، نحو خمسين ورقة رأيته.(@)(@@)(@@)(@@) $BIO_MAN$ صحار العبدي(@)(@@) وكان خارجيا. وهو صحار بن العباس، أحد النسابين والخطباء في أيام معاوية بن أبي سفيان. وله مع دغفل اخبار. وكان صحار عثمانيا من عبد القيس (و) روى عن النبي حديثين أو ثلاثة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأمثال.(@)(@@)(@@)(@@) $BIO_MAN$ الشرقي بن القطامي(@)(@@) ويكنى أبا المثنى الكلبي، واسمه الوليد بن الحصين. أحد النسابين الرواة للاخبار والأنساب والدواوين.(@)(@@) ومن خط اليوسفي، وكان كذابا، روى عن الأصمعي انه قال حدثني بعض الرواة قال: قلت للشرقي ما كانت العرب تقرأ في صلاتها على موتاها. قال: لا أدري. فقلت له كانوا يقرأون شعر:(@)(@@) ما كنت وكواكا ولا ابن أونك رويدك حتى يبعث الخلق باعثه قال: فإذا (انا) به يوم الجمعة يحدث به في المقصورة. وللشرقي قصيدة في الغريب.(@)(@@)(@@)(@@) $BIO_MAN$ صالح الحنفي وابن الكوا(@)(@@) واسمه عبد الله بن عروض من بنى يشكر، كان ناسبا عالما. وكان من الشيعة من أصحاب علي عليه السلام.(@)(@@) قال: واحتجوا (لي) ان ابن الكوا كان ناسبا (وفيه) يقول المسكين الدارمي، هلم إلى بنى الكوا تقضوا بحكمهم بأنساب الرجال(@)(@@)(@@)(@@) $BIO_MAN$ الصغدي(@)(@@) واسمه صالح بن عمران. وانما سمى بالصغدي لآن أباه أطال المقام بالصغد. وكان عارفا باخبار النبي(@)PageV00P102 عليه السلام وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غزاة ذات الأباطيل.(@)(@@)(@@)(@@) $BIO_MAN$ مجالد بن سعيد(@)(@@) ابن عمير من همدان ويكنى أبا عمير. وكان الهيثم بن عدي يروى عنه ويكثر. وكان راوية للاخبار وقد سمع الحديث. وكان ضعيفا عند المحدثين. وتوفى سنة أربع وأربعين ومائة.(@)(@@)(@@)(@@) $BIO_MAN$ سعد القصير(@)(@@) مولى بنى أمية وكان ناسبا. وعنه اخذ العتبى اخبار أهله ومناقبهم وأشعارهم.(@)(@@)(@@)(@@) $BIO_MAN$ عيسى بن دأب(@)(@@) أبو اليد عيسى بن يزيد بن بكر بن دأب. وهو (من) كنانة من بنى الشداخ. وله عقب بالبصرة و 
ms107	 أخوه يحيى بن يزيد. وكان أبوهما أيضا عالما باخبار العرب وأشعارها وكان شاعرا. والأغلب على آل دأب الاخبار.(@)(@@)(@@)(@@) $BIO_MAN$ القرقبي(@)(@@) واسمه زهير بن ميمون الهمداني ويكنى أبا محمد. وكان نحويا قارئا. وسئل زهير أنى لكم النحو، فقال:(@)(@@) سمعناه من أصحاب أبي الأسود وأخذناه. وكان عالما بالأنساب والاخبار وأيام الناس. ومات سنة خمس و خمسين ومائة.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار عوانة(@)(@@) هو عوانة بن الحكم بن عياض بن وزر بن عبد الحارث الكلبي ويكنى أبا الحكم. من علماء الكوفيين راوية للاخبار عالم بالشعر والنسب وكان فصيحا ضريرا. قال عوانة فيما رواه عنه هشام بن الكلبي. قال:(@)(@@) خطبنا عتبة النهاش العجلي فقال: ما أحسن شيئا قاله الله جل وعلا في كتابه.(@)(@@) ليس حي على المنون بباق غير وجه المسبح الخلاق قال: فقمت إليه فقلت: الله عز وجل لم يقل هذا وانما قاله عدى بن زيد. فقال: والله ما ظننته الا من كتاب الله. ولنعم ما قاله عدى بن زيد، ثم نزل عن المنبر. وأتى بامرأة من الخوارج، فقال: يا عدوة الله ما خروجك على أمير المؤمنين ألم تسمعي إلى قول الله عز وجل، كتب القتل والقتال علينا وعلى الغانيات جر الذيول فقالت: يا عدو الله، حملني على الخروج جهلكم بكتاب الله وإضاعتكم لحق الله. وتوفى عوانة في سنة سبع وأربعين ومائة وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التاريخ.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سيرة معاوية وبنى أمية. ويقال ان هذا الكتاب لمنجاب بن الحارث والصحيح انه لعوانة. قرأت بخط أبى عبد الله بن مقلة، قال أبو العباس ثعلب: جمع ديوان العرب وأشعارها واخبارها وأنسابها ولغاتها، الوليد بن يزيد بن عبد الملك. ورد الديوان إلى حماد وجناد.(@)PageV00P103(@)(@@)(@@)(@@) $BIO_MAN$ اخبار حماد(@)(@@) أبو القاسم حماد بن سابور بن المبارك بن عبيد. وكان سابور يكنى أبا ليلى من سبى الديلم سباه ابن لعروة بن زيد الخيل (الطائي) ووهبه لابنته ليلى، فخدمها خمسين سنة ثم ماتت. فبيع بمائتي درهم فاشتراه عامر من مطر الشيباني واعتقه. و (قد) قيل إن اسم أبى ليلى ميسرة. 
ms108	 وكان حماد ربما لحن في الشئ (بعد الشئ وكان راوية للاخبار وللاشعار والأنساب) في أيام الوليد بن عبد الملك. وعاش إلى سنة ست وخمسين ومائة وفيها مات. وجالس المهدى وقال: كنت أنشد الوليد الشعر الجيد، فيطلب منى السفساف فأنشده فيطرب، فاعلم أن الامر مدبر. ثم أنشد المهدى، السفساف. فيطلب منى الجيد الفحل، فاعلم أن أمرهم مقبل. وكان مولد حماد سنة خمس وسبعين. (ومات) فرثاه محمد بن كناسة: - أبعدت من نومك الغرار فما جاوزت حيث انتهى بك القدر لو كان ينجي من الردى حذر نجاك مما أصابك الحذر يرحمك الله من أخ يا أبا القاسم ما في صفائه كدر فهكذا يفسد الزمان ويفنى العلم منه ويدرس الأثر ولم نر لحماد كتابا وإنما روى عنه الناس وصنفت الكتب بعده.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار جناد(@)(@@) أبو محمد جناد بن واصل الكوفي مولى بنى أسد. وقيل يكنى بأبي واصل ولم يكن له علم بالنحو، إلا أنه كان أعلم الناس بأشعار العرب وأيامها. وكان يلحن كثيرا. قرأت بخط (أبى الطيب) أخي الشافعي قال:(@)(@@) صار جناد وإسحاق بن الجصاص إلى أبى عرار العجلي الاعرابي وكان فصيحا. فقال له جناد: اسمع شيئا قلته (واجزه) فقال: قولا . فقال (جناد):(@)(@@) فان كنت لا تدرين ما الموت فانظري إلى دير هند كيف خطت مقابره فقال اسحق:(@)(@@) ترى عجبا فيما قضى الله فيهم رهائن حتف أوجبته مقادره فقال أبو عرار:(@)(@@) بيوت ترى أثقالها فوق أهلها ومجمع زور لا يكلم زائره(@)(@@)(@@)(@@) $BIO_MAN$ أبو إسحاق إبراهيم بن محمد بن الحارث بن اسما بن خارج الفزاري. وكان حبرا فاضلا غير أنه كان كثير الغلط في حديثه. وتوفى بالمصيصة سنة ثمان وثمانين ومائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السير في الاخبار والاحداث رواه(@)PageV00P104 عنه أبو عمرو معاوية بن عمرو الأزدي وتوفى أبو عمرو هذا، ببغداد سنة خمس عشرة ومائتين وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ (جب بغير الخط: - كتاب السير والجهاد. وما كان إلا ثقة وحجة).(@)(@@)(@@)(@@) $BIO_MAN$ اخبار ابن إسحاق(@)(@@) صاحب السير أبو عبد الله محمد بن إسحاق بن 
ms109	 بشار . مطعون عليه، غير مرضى الطريقة. يحكى أن أمير المدينة رقى إليه أن محمدا يغال النساء، فأمر باحضاره. وكانت له شعرة حسنة، فرقق رأسه وضربه أسواطا ونهاه عن الجلوس مؤخر المسجد . وكان حسن الوجه، يروى عن فاطمة بنت المنذر زوجة هشام بن عروة، فبلغ هشاما ذلك فأنكره وقال: متى دخل إليها ومتى سمع منها. ويقال كان يعمل له الاشعار ويؤتى بها ويسئل أن يدخلها في كتابه في السيرة فيفعل. فضمن كتابه من الاشعار ما صار به فضيحة عند رواة الشعر. وأخطأ في النسب الذي أورده في كتابه. وكان يحمل عن اليهود والنصارى ويسميهم في كتبه أهل العلم الأول. وأصحاب الحديث يضعفونه ويتهمونه. وتوفى سنة خمسين ومائة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخلفاء رواه عنه الأموي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السيرة والمبتداء والمغازي، رواه عنه إبراهيم بن سعد والنفيلي. واسم النفيلي محمد بن عبد الله بن نمير النفيلي.(@)(@@) وتوفى سنة أربع وثلاثين ومائتين بحران. ويكنى أبا عبد الرحمن.(@)(@@)(@@)(@@) $BIO_MAN$ نجيح المدني(@)(@@) أبو معشر. واسمه نجيح المدني، مولى. وكان مكاتبا لامرأة من بنى مخزوم وعتق، عارف بالاحداث و السير. وأحد المحدثين وتوفى أيام الهادي سنة (بغير الخط: سبعين). وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المغازي.(@)(@@)(@@)(@@) $BIO_MAN$ أبو مخنف(@)(@@) لوط بن يحيى بن سعيد بن مخنف بن سليم الأزدي. وكان مخنف بن سليم من أصحاب علي عليه السلام. و روى عن النبي (وصحبه) وتوفى.. وله من الكتب،(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الردة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فتوح الشام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فتوح العراق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجمل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أهل النهروان والخوارج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الغارات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخريت بن راشد و بنى ناجية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل علي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل حجر بن عدي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل محمد بن أبي بكر والأشتر و محمد بن أبي حذيفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشورى ومقتل عثمان.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المستورد بن علفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل الحسين عليه السلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وفاة معاوي